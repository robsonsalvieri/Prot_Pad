#include "fw-tlpp-core.th"
#include "totvs.ch"
#include "totvs.framework.structure.model.th"
#include "totvs.protheus.manufacturing.processinspection.test.valids.ch"

namespace totvs.protheus.manufacturing.processinspection

using namespace totvs.framework.structure.object
 

/*/{Protheus.doc} validateQP1Ensaio
Valida o codigo do ensaio informado no SmartX.
@type function
@author willian.ramalho
@since 23/07/2026
@param xValue, variant, Valor informado para o campo QP1_ENSAIO
@param cField, character, Nome do campo em validacao
@param aContextInfo, array, Informacoes adicionais do contexto SmartX
@return json, Resultado da validacao e mensagem para o usuario
/*/
Function validateQP1Ensaio(xValue, cField, aContextInfo)
    Local cMessage := STR0001 as character // STR0001 - "Nao foi possivel executar a validacao porque o contexto recebido e invalido."
    Local lValid   := .F.     as logical

    If ValType(xValue) == "C" .And. ValType(cField) == "C" .And. ValType(aContextInfo) == "A" .And. Upper(AllTrim(cField)) == "QP1_ENSAIO"
        If Upper(AllTrim(xValue)) == "LAUDO"
            cMessage := STR0002 // STR0002 - "O codigo de ensaio LAUDO e reservado e nao pode ser utilizado."
        ElseIf !ExistChav("QP1", xValue)
            cMessage := STR0003 // STR0003 - "O ensaio informado já está cadastrado."
        ElseIf !FreeForUse("QP1", xValue)
            cMessage := STR0004 // STR0004 - "O código de ensaio informado já esta em uso."
        Else
            lValid   := .T.
            cMessage := ""
        EndIf
    EndIf

Return buildValidationResult(lValid, cMessage)

/*/{Protheus.doc} validateQP1Carta
Valida o tipo de carta informado no SmartX.
@type function
@author willian.ramalho
@since 23/07/2026
@param xValue, variant, Valor informado para o campo QP1_CARTA
@param cField, character, Nome do campo em validacao
@param aContextInfo, array, Informacoes adicionais do contexto SmartX
@return json, Resultado da validacao e mensagem para o usuario
/*/
Function validateQP1Carta(xValue, cField, aContextInfo)
    Local cMessage := STR0005 as character // STR0005 - "Nao foi possivel executar a validacao porque o contexto recebido e invalido."
    Local lValid   := .F.     as logical

    If ValType(xValue) == "C" .And. ValType(cField) == "C" .And. ValType(aContextInfo) == "A" .And. Upper(AllTrim(cField)) == "QP1_CARTA"
        lValid := !Empty(xValue) .And. ExistCpo("SX5", "Q4" + xValue)

        If lValid
            cMessage := ""
        Else
            cMessage := STR0006 // STR0006 - "Informe um tipo de carta valido cadastrado na tabela Q4."
        EndIf
    EndIf

Return buildValidationResult(lValid, cMessage)

/*/{Protheus.doc} validateQP1Qtde
Valida a quantidade conforme o tipo de carta informado no SmartX.
@type function
@author willian.ramalho
@since 23/07/2026
@param xValue, variant, Valor informado para o campo QP1_QTDE
@param cField, character, Nome do campo em validacao
@param aContextInfo, array, Tipo de carta informado na primeira posicao
@return json, Resultado da validacao e mensagem para o usuario
/*/
Function validateQP1Qtde(xValue, cField, aContextInfo)
    Local cCarta   := ""      as character
    Local cMessage := STR0007 as character // STR0007 - "Nao foi possivel executar a validacao porque o contexto recebido e invalido." 
    Local lValid   := .F.     as logical

    If ValType(xValue) == "N" .And. ValType(cField) == "C" .And. ValType(aContextInfo) == "A" .And. Len(aContextInfo) >= 1 .And. ValType(aContextInfo[1]) == "C" .And. Upper(AllTrim(cField)) == "QP1_QTDE"
        cCarta := Upper(AllTrim(aContextInfo[1]))

        If cCarta == "HIS" .Or. cCarta == "XBR" .Or. cCarta == "XBS" .Or. cCarta == "XMR" .Or. cCarta == "IND"
            lValid := xValue >= 2 .And. xValue <= 10

            If !lValid
                cMessage := STR0008 // STR0008 - "A quantidade deve estar entre 2 e 10 para o tipo de carta informado."
            EndIf
        ElseIf cCarta == "NP" .Or. cCarta == "C"
            lValid := xValue > 0

            If !lValid
                cMessage := STR0009 // STR0009 - "A quantidade deve ser maior que zero para o tipo de carta informado."
            EndIf
        Else
            lValid := xValue == 0

            If !lValid
                cMessage := STR0010 // STR0010 - "A quantidade deve ser zero para o tipo de carta informado."
            EndIf
        EndIf

        If lValid
            cMessage := ""
        EndIf
    EndIf

Return buildValidationResult(lValid, cMessage)

/*/{Protheus.doc} validateQP1Metodo
Valida o metodo informado no SmartX.
@type function
@author willian.ramalho
@since 23/07/2026
@param xValue, variant, Valor informado para o campo QP1_METODO
@param cField, character, Nome do campo em validacao
@param aContextInfo, array, Informacoes adicionais do contexto SmartX
@return json, Resultado da validacao e mensagem para o usuario
/*/
Function validateQP1Metodo(xValue, cField, aContextInfo)
    Local cMessage := STR0011 as character // STR0011 - "Nao foi possivel executar a validacao porque o contexto recebido e invalido." 
    Local lValid   := .F.     as logical

    If ValType(xValue) == "C" .And. ValType(cField) == "C" .And. ValType(aContextInfo) == "A" .And. Upper(AllTrim(cField)) == "QP1_METODO"
        lValid := ExistCpo("QDH", xValue)

        If lValid
            cMessage := ""
        Else
            cMessage := STR0012 // STR0012 - "O metodo informado nao esta cadastrado."
        EndIf
    EndIf

Return buildValidationResult(lValid, cMessage)

/*/{Protheus.doc} validateQP2NaoCon
Valida a nao conformidade informada no cadastro de ensaios do SmartX.
@type function
@author willian.ramalho
@since 23/07/2026
@param xValue, variant, Valor informado para o campo QP2_NAOCON
@param cField, character, Nome do campo em validacao
@param aContextInfo, array, Informacoes adicionais do contexto SmartX
@return json, Resultado da validacao e mensagem para o usuario
/*/
Function validateQP2NaoCon(xValue, cField, aContextInfo)
    Local cMessage := STR0013 as character // STR0013 - "Nao foi possivel executar a validacao porque o contexto recebido e invalido."
    Local lValid   := .F.     as logical

    If ValType(xValue) == "C" .And. ValType(cField) == "C" .And. ValType(aContextInfo) == "A" .And. Upper(AllTrim(cField)) == "QP2_NAOCON"
        lValid := ExistCpo("SAG", xValue)

        If lValid
            cMessage := ""
        Else
            cMessage := STR0014 // STR0014 - "A nao conformidade informada nao esta cadastrada."
        EndIf
    EndIf

Return buildValidationResult(lValid, cMessage)

/*/{Protheus.doc} validateQP2Classe
Valida a classe de nao conformidade informada no cadastro de ensaios do SmartX.
@type function
@author willian.ramalho
@since 23/07/2026
@param xValue, variant, Valor informado para o campo QP2_CLASSE
@param cField, character, Nome do campo em validacao
@param aContextInfo, array, Informacoes adicionais do contexto SmartX
@return json, Resultado da validacao e mensagem para o usuario
/*/
Function validateQP2Classe(xValue, cField, aContextInfo)
    Local cMessage := STR0015 as character // STR0015 - "Nao foi possivel executar a validacao porque o contexto recebido e invalido."
    Local lValid   := .F.     as logical

    If ValType(xValue) == "C" .And. ValType(cField) == "C" .And. ValType(aContextInfo) == "A" .And. Upper(AllTrim(cField)) == "QP2_CLASSE"
        lValid := ExistCpo("QEE", xValue)

        If lValid
            cMessage := ""
        Else
            cMessage := STR0016 // STR0016 - "A classe de nao conformidade informada nao esta cadastrada."
        EndIf
