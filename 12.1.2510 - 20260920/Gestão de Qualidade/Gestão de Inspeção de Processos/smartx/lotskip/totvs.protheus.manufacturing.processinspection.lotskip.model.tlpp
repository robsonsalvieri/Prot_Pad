#include "fw-tlpp-core.th"
#include "totvs.ch"
#include "totvs.framework.structure.model.th"

namespace totvs.protheus.manufacturing.processinspection

using namespace totvs.framework.structure.object

/*/{Protheus.doc} LotSkipModel
Modelo da rotina Skip-Lote.
@type class
@author brunno.costa / rafael.kleestadt
@since 13/08/2026
/*/
@totvsFrameworkStructureModel(description="Skip-Lote")
class LotSkipModel from totvs.framework.structure.model.data
    public method new() as object
    public method setModel()
endclass

/*/{Protheus.doc} new
Construtor da classe.
@author brunno.costa / rafael.kleestadt
@since 13/08/2026
@version P12.1.2610
@return self, objeto, instancia da classe
/*/
method new() as object class LotSkipModel
    _Super:new(,,.T.)
return self

/*/{Protheus.doc} setModel
Define o modelo da rotina Skip-Lote.
@author brunno.costa / rafael.kleestadt
@since 13/08/2026
@version P12.1.2610
@return nil, nulo, sem retorno
/*/
method setModel() class LotSkipModel
    local oEvents as object
    local oObjQPF as object

    oObjQPF := ObjectFromMetadata():new("QPF")
    ::setObject(oObjQPF:getObject(), "QPF")

    oEvents := LotSkipEvents():new()
    ::setEvents(oEvents)
    oEvents:addNextSkipLotCodeInitializer(self)
    ::loadEventsFromMetadata()
return
