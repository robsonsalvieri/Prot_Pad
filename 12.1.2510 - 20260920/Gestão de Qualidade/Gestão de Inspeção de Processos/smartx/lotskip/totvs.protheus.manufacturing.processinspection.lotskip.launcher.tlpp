#include "fw-tlpp-core.th"
#include "totvs.ch"

using namespace totvs.framework.application.smartx

/*/{Protheus.doc} qipa130SX
Abre a nova interface da rotina Skip-Lote.
@type function
@author brunno.costa / rafael.kleestadt
@since 13/08/2026
@return variant, resultado da abertura da interface
/*/
Function qipa130SX()
    local lCompatibleVersion := GetRPORelease() >= "12.1.2610"
    local oLauncher := Nil

    If !lCompatibleVersion
        Return Nil
    EndIf
    oLauncher := launcher():new()
    AjCargaQPF()
    oLauncher:setInterface("totvs.protheus.manufacturing.processinspection.LotSkipInterface")
Return oLauncher:open()
