#include 'fw-tlpp-core.th'
#include "totvs.ch"
#include "totvs.framework.structure.model.th"

namespace totvs.protheus.manufacturing.incominginspection.model.lookup

using namespace totvs.framework.structure.object

/*/{Protheus.doc} qualityIndexLookup
Classe de lookup ÍNDICES DO IQF, que retorna os índices ativos da filial do usuário logado (QF1), com as colunas Índice e Descrição (QF1_INDICE e QF1_DESCRI).
@author rafael.kleestadt
@since 25/08/2026
@version P12.1.2610
/*/
@totvsFrameworkStructureModel(lookup=.T., country="ALL", description="Índices do IQF")
class qualityIndexLookup from totvs.framework.structure.model.data
    public method new() as object
    public method setModel()
endclass

/*/{Protheus.doc} new
construtor da classe.
@author rafael.kleestadt
@since 25/08/2026
@version P12.1.2610
@return self, objeto, instância da classe
/*/
method new() as object class qualityIndexLookup
    _Super:new(,,.T.)
return self

/*/{Protheus.doc} setModel
Define o modelo de dados do lookup ÍNDICES DO IQF, que retorna os índices ativos da filial do usuário logado (QF1), com as colunas Índice e Descrição (QF1_INDICE e QF1_DESCRI).
@author rafael.kleestadt
@since 25/08/2026
@version P12.1.2610
@return nil, nulo, sem retorno
/*/
method setModel() class qualityIndexLookup
    Local oArray  as Object
    Local oField  as Object
    Local oFinder as Object
    Local oHeader as Object
    Local oIndex  as Object

    oHeader := BuildFromCode():new("IND")

    oField := BuildFieldProperties():new("IND_INDICE")
    oField:setType("C")
    oField:setTitle(AllTrim(FWX3Titulo("QF1_INDICE"))) //Índice
    oField:setDescription(AllTrim(FWSX3Util():GetDescription("QF1_INDICE"))) //Índice do IQF
    oField:setSize(FWSX3Util():GetFieldStruct("QF1_INDICE")[3]) // tamanho do campo no dicionário
    oField:setOrder(1)
    oField:setRequired(.T.)
    oField:setUpperCase(.T.)
    oHeader:addFieldProperties(oField:getFieldProperties())

    oField := BuildFieldProperties():new("IND_DESCRI")
    oField:setType("C")
    oField:setTitle(AllTrim(FWX3Titulo("QF1_DESCRI"))) //Descrição
    oField:setDescription(AllTrim(FWSX3Util():GetDescription("QF1_DESCRI"))) //Descrição do índice do IQF
    oField:setSize(FWSX3Util():GetFieldStruct("QF1_DESCRI")[3]) // tamanho do campo no dicionário
    oField:setOrder(2)
    oHeader:addFieldProperties(oField:getFieldProperties())

    oHeader:setTitle(AllTrim(FWX3Titulo("QF1_INDICE"))) //Índice

    oIndex := BuildIndex():new("IND" + cEmpAnt + "0")
    oIndex:setOrder("1")
    oIndex:setKeyFields({"IND_INDICE"})
    oHeader:addIndexConstraint(oIndex:getIndex())

    oFinder := totvs.framework.structure.model.finder():new()
    oFinder:setFinder({"IND_INDICE", "IND_DESCRI"}, "", .T.)
    oHeader:addFinder(oFinder:getFinder())

    oHeader:setUniqueKeyConstraint("IND" + cEmpAnt + "0", {"IND_INDICE"})

    oArray := qualityIndexLookupDataArray():new()
    self:setObject(oHeader:getObject(), "IND",,,,,, oArray)
    self:setOrder({{"IND_INDICE", .F.}})
return

/*/{Protheus.doc} qualityIndexLookupDataArray
Classe de array de dados do lookup ÍNDICES DO IQF, que retorna os índices ativos da filial do usuário logado (QF1), com as colunas Índice e Descrição (QF1_INDICE e QF1_DESCRI).
@type class
@author rafael.kleestadt
@since 25/08/2026
@version P12.1.2610
/*/
class qualityIndexLookupDataArray
    public method new() as object
    public method getData() as array
endclass

/*/{Protheus.doc} new
construtor da classe.
@author rafael.kleestadt
@since 25/08/2026
@version P12.1.2610
@return self, objeto, instância da classe
/*/
method new() as object class qualityIndexLookupDataArray
return self

/*/{Protheus.doc} getData
Retorna os índices ativos da filial do usuário logado (QF1), com as colunas Índice e Descrição (QF1_INDICE e QF1_DESCRI).
@author rafael.kleestadt
@since 25/08/2026
@version P12.1.2610
@return aData, array, array de índices do IQF ativos da filial do usuário logado, com as colunas Índice e Descrição (QF1_INDICE e QF1_DESCRI).
/*/
method getData() as array class qualityIndexLookupDataArray
    Local aArea      := GetArea()               as array
    Local aBindParam := {}                      as array
    Local aData      := {}                      as array
    Local cAliasQry  := ""                      as character
    Local cDescri    := ""                      as character
    Local cFilQF1    := xFilial("QF1")          as character
    Local cIndice    := ""                      as character
    Local cQuery     := ""                      as character
    Local oQLTQueryM := QLTQueryManager():new() as object

    cQuery :=   " SELECT DISTINCT QF1_INDICE, QF1_DESCRI "
    cQuery +=     " FROM " + RetSqlName("QF1")
    cQuery +=    " WHERE QF1_FILIAL = ? "
    cQuery +=      " AND QF1_CALC   = ? "
    cQuery +=      " AND D_E_L_E_T_ = ? "
    cQuery += " ORDER BY QF1_INDICE "

    aAdd(aBindParam, {cFilQF1, "S"})
    aAdd(aBindParam, {'I',     "S"})
    aAdd(aBindParam, {' ',     "S"})

	cQuery    := oQLTQueryM:changeQuery(cQuery)
	cAliasQry := oQLTQueryM:executeQueryWithBind(cQuery, aBindParam, .F.)

    While (cAliasQry)->(!Eof())
        cIndice := AllTrim((cAliasQry)->QF1_INDICE)
        cDescri := AllTrim((cAliasQry)->QF1_DESCRI)

        If !Empty(cIndice)
            AAdd(aData, {cIndice, cDescri})
        EndIf

        (cAliasQry)->(dbSkip())
    EndDo

	(cAliasQry)->(DbCloseArea())

    RestArea(aArea)
return aData
