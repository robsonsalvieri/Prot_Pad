#include "fw-tlpp-core.th"
#include "totvs.ch"
#include "totvs.framework.structure.model.th"
#include "totvs.framework.model.events.th"
#include "totvs.protheus.manufacturing.incominginspection.countries.model.ch"

namespace totvs.protheus.manufacturing.incominginspection

using namespace totvs.framework.structure.object

/*/{Protheus.doc} CountriesModel
Modelo SmartX do cadastro de Paises (SYA), migrado do QIEA290.PRW.
@type class
@author brunno.costa
@since 03/08/2026
/*/
@totvsFrameworkStructureModel(description="Paises")
class CountriesModel from totvs.framework.structure.model.data
    public method new() as object
    public method setModel()
endclass

method new() as object class CountriesModel
    _Super:new(,,.T.)
return self

/*/{Protheus.doc} setModel
Monta o modelo de Paises (SYA). Unica entidade, sem sub-modelos --
QIEA290.PRW so usa AxCadastro("SYA",...) sem AddFields/AddGrid. O
bloqueio de exclusao por Fornecedor vinculado (A290Del) e reproduzido
em CountriesEvents:beforeDeleteInTransaction, nao aqui.
@type method
@author brunno.costa
@since 03/08/2026
/*/
method setModel() class CountriesModel
    local oEvents as object
    local oObject as object

    oObject := ObjectFromMetadata():new("SYA")
    ::setObject(oObject:getObject(), "SYA")

    oEvents := CountriesEvents():new()
    ::setEvents(oEvents)
    ::loadEventsFromMetadata()
return
