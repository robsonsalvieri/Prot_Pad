namespace totvs.protheus.manufacturing.incominginspection

using namespace totvs.framework.structure.interface

/*/{Protheus.doc} CountriesInterface
Interface SmartX do cadastro de Paises (SYA), migrado do QIEA290.PRW.
@type class
@author brunno.costa
@since 03/08/2026
/*/
@totvsFrameworkStructureInterface(description="Paises")
class CountriesInterface
    private data oInterface as object

    public method new() as object
    public method setInterface()
    public method getContract() as json
endclass

method new() as object class CountriesInterface
return self

/*/{Protheus.doc} setInterface
Monta a interface de Paises via layout automatico (buildStandardView).
QIEA290.PRW nao tem legenda, cor, acao customizada, relatorio ou atalho
F4 proprios -- MenuDef so tem o aRotina padrao do AxCadastro (Pesquisar/
Visualizar/Incluir/Alterar/Excluir), entao nao ha nada alem do CRUD
padrao a reproduzir aqui.
@type method
@author brunno.costa
@since 03/08/2026
/*/
method setInterface() class CountriesInterface
    local cModel := "totvs.protheus.manufacturing.incominginspection.CountriesModel" as character

    ::oInterface := BuildContract():new("countries")
    ::oInterface:setModelId(cModel, .T.)
    ::oInterface:setTitle(STR0001) //"Paises"
    ::oInterface:setVersion("1.0")
    ::oInterface:buildStandardView()
return

/*/{Protheus.doc} getContract
Retorna o contrato JSON da interface.
@type method
@author brunno.costa
@since 03/08/2026
@return json, Contrato da interface
/*/
method getContract() as json class CountriesInterface
return ::oInterface:getContract()
