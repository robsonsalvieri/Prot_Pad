#include "tlpp-core.th"
#include "totvs.ch"

using namespace totvs.framework.application.smartx

/*/{Protheus.doc} qiea290SX
Abre a nova interface do cadastro de Paises, migrada do QIEA290.PRW.
@type function
@author brunno.costa
@since 03/08/2026
@return variant, resultado da abertura da interface
/*/
Function qiea290SX()
    local lCompatibleVersion := GetRPORelease() >= "12.1.2610" as Logical
    local oLauncher := Nil as Object

    If !lCompatibleVersion
        Return Nil
    EndIf

    oLauncher := launcher():new()
    oLauncher:setInterface("totvs.protheus.manufacturing.incominginspection.CountriesInterface")
Return oLauncher:open()
