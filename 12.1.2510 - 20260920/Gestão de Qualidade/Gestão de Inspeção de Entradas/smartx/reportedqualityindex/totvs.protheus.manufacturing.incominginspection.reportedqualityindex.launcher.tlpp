#include "fw-tlpp-core.th"
#include "totvs.ch"

using namespace totvs.framework.application.smartx

/*/{Protheus.doc} qiea280SX
Abre a nova interface do Índice de Qualidade Informado na interface SmartX
@type function
@author brunno.costa / rafael.kleestadt
@since 19/08/2026
@return variant, resultado da abertura da interface
/*/
Function qiea280SX()
    local lCompatibleVersion := GetRPORelease() >= "12.1.2610" as Logical
    local oLauncher := Nil as Object

    If !lCompatibleVersion
        Return Nil
    EndIf

    oLauncher := launcher():new()
    oLauncher:setInterface("totvs.protheus.manufacturing.incominginspection.ReportedQualityIndexInterface")
Return oLauncher:open()
