#include "fw-tlpp-core.th"
#include "totvs.ch"
#include "totvs.framework.structure.model.th"

namespace totvs.protheus.manufacturing.incominginspection

/*/{Protheus.doc} ReportedQualityIndexModel
Modelo do Índice de Qualidade Informado.
@type class
@author brunno.costa / rafael.kleestadt
@since 19/08/2026
/*/
@totvsFrameworkStructureModel(lookup=.T., country="ALL", description="Índice de Qualidade")
class ReportedQualityIndexModel from totvs.framework.structure.model.data
    public method new() as object
    public method setModel()

    private method montaLookupFornecedor()
    private method montaLookupIndiceDoIQF()
endclass

/*/{Protheus.doc} new
Método construtor da classe.
@type method
@author brunno.costa / rafael.kleestadt
@since 19/08/2026
@return object, instância da classe
/*/
method new() as object class ReportedQualityIndexModel
    _Super:new(,,.T.)
return self

/*/{Protheus.doc} setModel
Monta o modelo do Índice de Qualidade Informado (QE0), entidade única
sem sub-modelos. Registra ReportedQualityIndexEvents para as
descrições derivadas de fornecedor/produto e substitui o lookup
automático de QE0_FORNEC (X3_F3 padrão SA2, chave A2_COD+A2_LOJA) pelo
lookup dedicado FORNECEDOR (chave só A2_COD) -- QE0 não tem campo de
loja, então o lookup automático monta a chave com loja em branco e
retorna 404 quando a loja real do fornecedor não é vazia.
@type method
@author brunno.costa / rafael.kleestadt
@since 19/08/2026
@return nil, nulo, sem retorno
/*/
method setModel() class ReportedQualityIndexModel
    Local oEvents as object
    Local oObject as object

    oObject := totvs.framework.structure.object.ObjectFromMetadata():new("QE0")
    Self:setObject(oObject:getObject(), "QE0")

    // Oculta o campo QE0_DESCFO que é derivado de QE0_FORNEC, pois o lookup dedicado FORNECEDOR retorna só A2_COD e não A2_LOJA, então a descrição derivada do fornecedor não pode ser montada corretamente. O campo QE0_DESCFO é mantido no modelo para manter a compatibilidade com o dicionário de dados, mas não é exibido na interface.
    self:setProperty("QE0_DESCFO", "hidden", .T., "QE0")

    Self:montaLookupFornecedor()
    Self:montaLookupIndiceDoIQF()

    oEvents := ReportedQualityIndexEvents():new()
    Self:setEvents(oEvents)
    oEvents:addDescriptionTriggers(Self)
return

/*/{Protheus.doc} montaLookupFornecedor
Substitui o lookup automático de QE0_FORNEC pelo modelo dedicado
FORNECEDOR (pasta smartx/lookups do módulo), chaveado só por A2_COD. Mantém as
colunas de busca e exibição da consulta SXB original (Código, Loja,
Nome, CNPJ/CPF); só FOR_COD é gravado em QE0_FORNEC, pois QE0 não tem
campo de loja para receber FOR_LOJA.
@type method
@author brunno.costa / rafael.kleestadt
@since 19/08/2026
@return nil, nulo, sem retorno
/*/
method montaLookupFornecedor() class ReportedQualityIndexModel
    Local oLookup as object

    oLookup := totvs.framework.structure.model.lookup():new()
    oLookup:setLookup("totvs.protheus.manufacturing.incominginspection.model.lookup.supplierLookup", "FOR_COD",,, {"FOR_COD", "FOR_LOJA", "FOR_NOME", "FOR_CNPJ"})

    Self:addLookup("QE0_FORNEC", "QE0", oLookup:getLookup())

return

/*/{Protheus.doc} montaLookupIndiceDoIQF
Substitui o lookup automático de QE0_INDICE pelo modelo dedicado ÍNDICES DO IQF (pasta smartx/lookups do módulo), 
chaveado só por QF1_INDICE. Mantém as colunas de busca e exibição da consulta SXB original (Índice e Descrição); 
só QF1_INDICE é gravado em QE0_INDICE, pois QE0 não tem campo de descrição para receber QF1_DESCRI.
@type method
@author rafael.kleestadt
@since 25/08/2026
@return nil, nulo, sem retorno
/*/
method montaLookupIndiceDoIQF() class ReportedQualityIndexModel
    Local oLookup as object

    oLookup := totvs.framework.structure.model.lookup():new()
    oLookup:setLookup("totvs.protheus.manufacturing.incominginspection.model.lookup.qualityIndexLookup", "IND_INDICE",,, {"IND_INDICE", "IND_DESCRI"})

    Self:addLookup("QE0_INDICE", "QE0", oLookup:getLookup())

return
