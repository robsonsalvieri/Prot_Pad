#include "fw-tlpp-core.th"
#include "totvs.ch"
#include "totvs.framework.structure.model.th"
#include "totvs.protheus.manufacturing.incominginspection.qualityfactortables.valids.ch"

namespace totvs.protheus.manufacturing.incominginspection

using namespace totvs.framework.structure.object

/*/{Protheus.doc} validateQEJUpperValueSmartX
Valida somente a faixa do limite superior (0-100 ou 999.99), conforme
o X3_VALID legado.
@type function
@author willian.ramalho
@since 25/08/2026
@param xValue, variant, Valor
@param cField, character, Campo
@param aCtxInfo, array, Codigo da tabela
@return json, Resultado
/*/
Function validateQEJUpperValueSmartX(xValue, cField, aCtxInfo)

    Local cTableCode := ""  as character
    Local lValid     := .F. as logical

    If ValType(xValue) == "N" .And. ValType(cField) == "C" .And. ValType(aCtxInfo) == "A" .And. Upper(AllTrim(cField)) == "QEJ_VLSUP" .And. Len(aCtxInfo) >= 1
        cTableCode := aCtxInfo[1]
        If ValType(cTableCode) == "C"
            lValid := (xValue >= 0.00 .And. xValue <= 100.00) .Or. xValue == 999.99
        EndIf
    EndIf

Return buildQEJResult(lValid, STR0001) // STR0001 - "Limite superior invalido."

/*/{Protheus.doc} validateQEJFactorSmartX
Valida somente formato (numerico e positivo) do fator, conforme
QA_VerNum/Positivo em A270VlFa. A checagem de duplicidade (Help
legado JAGRAVADO) foi movida para os eventos de QualityFactorsIAEvents/
QualityFactorsIQSEvents (beforeCreateInTransaction/beforeUpdateInTransaction),
pois exige desconsiderar o proprio registro na alteracao (QEJ_FATOR e a
propria chave do registro) -- um serverValidate de campo isolado nao tem
acesso confiavel ao recno do registro em edicao para essa exclusao.
@type function
@author willian.ramalho
@since 25/08/2026
@param xValue, variant, Valor
@param cField, character, Campo
@param aCtxInfo, array, Codigo da tabela
@return json, Resultado
/*/
Function validateQEJFactorSmartX(xValue, cField, aCtxInfo)

    Local cValue := ""  as character
    Local lValid := .F. as logical

    If ValType(cField) == "C" .And. ValType(aCtxInfo) == "A" .And. Upper(AllTrim(cField)) == "QEJ_FATOR"
        If ValType(xValue) == "C"
            cValue := xValue
        ElseIf ValType(xValue) == "N"
            cValue := AllTrim(Str(xValue))
        EndIf
        If !Empty(cValue)
            // QA_VerNum recebe cValue por referencia e pode normalizar o
            // separador decimal (virgula->ponto) para validar o formato,
            // mas esse valor normalizado NAO e propagado de volta ao
            // campo no contrato serverValidate (que so retorna
            // {return, notValidMessage}) -- diferente do legado, onde
            // M->QED_FATOR:=cVar atualizava o enchoice. Se o usuario
            // digitar com virgula, o campo gravado mantem a formatacao
            // originalmente digitada, nao a normalizada por QA_VerNum.
            If Positivo(Val(cValue))
                lValid := QA_VerNum(@cValue)
            Else
                lValid := .F.
            EndIf
        EndIf
    EndIf

Return buildQEJResult(lValid, STR0002) // STR0002 - "Fator deve ser numerico e positivo (Help legado QA_NUMINV)."

/*/{Protheus.doc} buildQEJResult
Monta o JSON de retorno padrao do contrato serverValidate do Smart X.
@type function
@author willian.ramalho
@since 25/08/2026
@param lValid, logical, Resultado da validacao
@param cMessage, character, Mensagem de falha (ignorada se lValid)
@return json, Contrato {return, notValidMessage}
/*/
Static Function buildQEJResult(lValid, cMessage)

    Local jResult as json

    If lValid
        cMessage := ""
    EndIf
    jResult := JsonObject():new()
    jResult["return"] := lValid
    jResult["notValidMessage"] := cMessage

Return jResult
