#include "fw-tlpp-core.th"
#include "totvs.ch"
#include "totvs.framework.structure.model.th"

namespace totvs.protheus.manufacturing.incominginspection

using namespace totvs.framework.structure.object

/*/{Protheus.doc} QualityFactorsIAModel
Modelo SmartX da tabela de Fatores I.A. (QEJ, QEJ_CODTAB="1"),
migrado do QIEA270.PRW (nOpcao=1).
@type class
@author willian.ramalho
@since 25/08/2026
/*/
@totvsFrameworkStructureModel(description="Fatores I.A.")
class QualityFactorsIAModel from totvs.framework.structure.model.data
    public method new() as object
    public method setModel()
endclass

method new() as object class QualityFactorsIAModel
    _Super:new(,,.T.)
return self

/*/{Protheus.doc} setModel
Filtra QEJ por QEJ_CODTAB="1" (Fatores I.A.), igual ao filtro
q270FilFat()/uCodTab="1" do legado (QIEA270 com nOpcao=1).
@type method
@author willian.ramalho
@since 25/08/2026
/*/
method setModel() class QualityFactorsIAModel
    Local oEvents as object
    Local oObject as object

    oObject := ObjectFromMetadata():new("QEJ", Nil, Nil, "QEJ_CODTAB eq '1'")
    ::setObject(oObject:getObject(), "QEJ")

    // Oculta QEJ_CODTAB no browse/formulario
    ::setProperty("QEJ_CODTAB", "hidden", .T., "QEJ")

    oEvents := QualityFactorsIAEvents():new()
    ::setEvents(oEvents)
return
