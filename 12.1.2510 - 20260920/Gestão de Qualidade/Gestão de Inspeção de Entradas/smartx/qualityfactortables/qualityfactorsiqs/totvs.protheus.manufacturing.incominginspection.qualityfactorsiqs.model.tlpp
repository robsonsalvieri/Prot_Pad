#include "fw-tlpp-core.th"
#include "totvs.ch"
#include "totvs.framework.structure.model.th"

namespace totvs.protheus.manufacturing.incominginspection

using namespace totvs.framework.structure.object

/*/{Protheus.doc} QualityFactorsIQSModel
Modelo SmartX da tabela de Fatores I.Q.S. (QEJ, QEJ_CODTAB="2"),
migrado do QIEA270.PRW (nOpcao=2) / QIEA271.PRW.
@type class
@author willian.ramalho
@since 25/08/2026
/*/
@totvsFrameworkStructureModel(description="Fatores I.Q.S.")
class QualityFactorsIQSModel from totvs.framework.structure.model.data
    public method new() as object
    public method setModel()
endclass

method new() as object class QualityFactorsIQSModel
    _Super:new(,,.T.)
return self

/*/{Protheus.doc} setModel
Filtra QEJ por QEJ_CODTAB="2" (Fatores I.Q.S.), igual ao filtro
q270FilFat()/uCodTab="2" do legado (QIEA270 com nOpcao=2 / QIEA271).
@type method
@author willian.ramalho
@since 25/08/2026
/*/
method setModel() class QualityFactorsIQSModel
    Local oEvents as object
    Local oObject as object

    oObject := ObjectFromMetadata():new("QEJ", Nil, Nil, "QEJ_CODTAB eq '2'")
    ::setObject(oObject:getObject(), "QEJ")

    // Oculta QEJ_CODTAB no browse/formulario
    ::setProperty("QEJ_CODTAB", "hidden", .T., "QEJ")

    oEvents := QualityFactorsIQSEvents():new()
    ::setEvents(oEvents)
return
