#include "fw-tlpp-core.th"
#include "totvs.ch"


using namespace totvs.framework.application.smartx

/*/{Protheus.doc} qiea271SX
Abre a tabela de Fatores I.Q.S. na interface SmartX.
@type function
@author willian.ramalho
@since 25/08/2026
@return variant, resultado da abertura da interface
/*/
Function qiea271SX()

    local lCompVer  := GetRPORelease() >= "12.1.2610"
    local oLauncher := Nil

    If !lCompVer
        Return Nil
    EndIf

    oLauncher := launcher():new()
    oLauncher:setInterface("totvs.protheus.manufacturing.incominginspection.QualityFactorsIQSInterface")

Return oLauncher:open()
