#include "fw-tlpp-core.th"
#include "totvs.ch"
#include "totvs.framework.model.events.th"
#include "totvs.protheus.manufacturing.incominginspection.nonconformities.events.ch"

namespace totvs.protheus.manufacturing.incominginspection

/*/{Protheus.doc} NonconformitiesEvents
Preserva os bloqueios de alteracao e exclusao da QIEA040.
@type class
@author willian.ramalho
@since 18/08/2026
/*/
class NonconformitiesEvents
    public method new() as object

    @beforeUpdateInTransaction()
    public method beforeUpdateInTransaction(oData, oModel, oError) as logical

    @beforeDeleteInTransaction()
    public method beforeDeleteInTransaction(oData, oModel, oError) as logical

    private method hasReference(cAlias, cCode)                      as logical
    private method validateGroup(cCode, aAliases, cMessage, oError) as logical
    private method validateReferences(oData, oError)                as logical
endclass

/*/{Protheus.doc} new
Metodo construtor da classe.
@type method
@author willian.ramalho
@since 18/08/2026
@return object, instancia da classe
/*/
method new() as object class NonconformitiesEvents
return self

/*/{Protheus.doc} beforeUpdateInTransaction
Impede alterar uma Não conformidade utilizada, conforme Q040TudOk/A040ValNco.
@type method
@author willian.ramalho
@since 18/08/2026
@param oData, object, Dados da operacao
@param oModel, object, Modelo SmartX
@param oError, object, Retorno de erro
@return logical, Permissao para alterar
/*/
method beforeUpdateInTransaction(oData as object, oModel as object, oError as object) as logical class NonconformitiesEvents
return self:validateReferences(oData, oError)

/*/{Protheus.doc} beforeDeleteInTransaction
Impede excluir uma Não conformidade utilizada, conforme Q040TudOk/A040ValNco.
@type method
@author willian.ramalho
@since 18/08/2026
@param oData, object, Dados da operacao
@param oModel, object, Modelo SmartX
@param oError, object, Retorno de erro
@return logical, Permissao para excluir
/*/
method beforeDeleteInTransaction(oData as object, oModel as object, oError as object) as logical class NonconformitiesEvents
return self:validateReferences(oData, oError)

/*/{Protheus.doc} validateReferences
Reproduz os 3 grupos de bloqueio de A040ValNco (Help A040DNCENS para
QE2/QP2, A040DNCPRO para QE9/QP9, A040DNCRES para QEU/QPU), cada um com
mensagem propria equivalente a original. Executa somente em
alteracao/exclusao (chamado so por beforeUpdate/beforeDeleteInTransaction).
@type method
@author willian.ramalho
@since 18/08/2026
@param oData, object, Dados da operacao
@param oError, object, Retorno de erro
@return logical, Ausencia de referencias que bloqueiam a operacao
/*/
method validateReferences(oData as object, oError as object) as logical class NonconformitiesEvents

    Local cCode  := oData:getFieldValue("SAG", "AG_NAOCON") as character
    Local lValid := .T.                                     as logical

    lValid := self:validateGroup(cCode, {"QE2", "QP2"}, STR0001, oError) // STR0001 - "Existe ensaio de Inspecao de Entradas ou Processos vinculado a esta Não conformidade."
    If lValid
        lValid := self:validateGroup(cCode, {"QE9", "QP9"}, STR0002, oError) // STR0002 - "Existe ensaio de produto de Inspecao de Entradas ou Processos vinculado a esta Não conformidade."
    EndIf
    If lValid
        lValid := self:validateGroup(cCode, {"QEU", "QPU"}, STR0003, oError) // STR0003 - "Existe resultado de Inspecao de Entradas ou Processos vinculado a esta Não conformidade."
    EndIf

return lValid

/*/{Protheus.doc} validateGroup
Verifica um grupo de aliases equivalentes (mesmo Help legado) e registra
o erro com a mensagem do grupo na primeira ocorrencia encontrada.
@type method
@author willian.ramalho
@since 18/08/2026
@param cCode, character, Codigo da Não conformidade (AG_NAOCON)
@param aAliases, array, Aliases do grupo (mesmo Help legado)
@param cMessage, character, Mensagem equivalente ao Help legado do grupo
@param oError, object, Retorno de erro
@return logical, Ausencia de referencia no grupo
/*/
method validateGroup(cCode as character, aAliases as array, cMessage as character, oError as object) as logical class NonconformitiesEvents

    Local nAlias := 0 as numeric

    For nAlias := 1 To Len(aAliases)
        If self:hasReference(aAliases[nAlias], cCode)
            oError:set(400, STR0004, cMessage) // STR0004 - "Não conformidade em uso"
            Return .F.
        EndIf
    Next nAlias

return .T.

/*/{Protheus.doc} hasReference
Verifica se existe referencia a Não conformidade no alias informado,
percorrendo as filiais da empresa quando a tabela e de acesso exclusivo
(FWModeAccess == "E"), igual a A040ValNco. Mantem o gate do legado: a
filial so e consultada quando coincide com xFilial("SAG") ou quando a
SAG e compartilhada (FWModeAccess("SAG") == "C").
@type method
@author willian.ramalho
@since 18/08/2026
@param cAlias, character, Alias consultado (QE2/QP2/QE9/QP9/QEU/QPU)
@param cCode, character, Codigo da Não conformidade (AG_NAOCON)
@return logical, Existe referencia no alias para alguma filial aplicavel
/*/
method hasReference(cAlias as character, cCode as character) as logical class NonconformitiesEvents

    Local aArea      := GetArea()                                                                        as array
    Local aBind      := {}                                                                               as array
    Local aBranches  := {}                                                                               as array
    Local cAliasQry  := ""                                                                               as character
    Local cBranch    := ""                                                                               as character
    Local cCampoFil  := cAlias + "_FILIAL"                                                               as character
    Local cFilSag    := xFilial("SAG")                                                                   as character
    Local cQuery     := ""                                                                               as character
    Local lFound     := .F.                                                                              as logical
    Local lSagShared := FWModeAccess("SAG") == "C"                                                       as logical
    Local nBranch                                                                                        as numeric

    If FWModeAccess(cAlias) == "E"
        aBranches := QA_RetFilEmp(SM0->M0_CODIGO)
    Else
        AAdd(aBranches, {Space(FWSizeFilial()), Space(FWSizeFilial()), Space(FWSizeFilial()), Space(FWSizeFilial())})
    EndIf

    For nBranch := 1 To Len(aBranches)
        cBranch := aBranches[nBranch, 2]
        If cBranch == cFilSag .Or. lSagShared

            cQuery := " SELECT 1 "
            cQuery += " FROM " + RetSQLName(cAlias)
            cQuery += " WHERE " + cCampoFil + " = ? "
            cQuery += " AND " + cAlias + "_NAOCON = ? "
            cQuery += " AND D_E_L_E_T_ = ? "

            aBind := {}
            AAdd(aBind, {cBranch, "S"})
            AAdd(aBind, {cCode,   "S"})
            AAdd(aBind, {" ",     "S"})

            cAliasQry := QLTQueryManager():executeQueryWithBind(cQuery, aBind, .T.)

            (cAliasQry)->(DbGoTop())

            If (cAliasQry)->(!Eof())
                lFound := .T.
                (cAliasQry)->(DbCloseArea())
                Exit
            EndIf

            (cAliasQry)->(DbCloseArea())

        EndIf
    Next nBranch

    RestArea(aArea)
return lFound
