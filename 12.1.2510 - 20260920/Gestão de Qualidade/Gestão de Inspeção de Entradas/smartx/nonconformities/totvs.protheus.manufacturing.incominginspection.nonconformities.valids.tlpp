#include "fw-tlpp-core.th"
#include "totvs.ch"
#include "totvs.framework.structure.model.th"
#include "totvs.protheus.manufacturing.incominginspection.nonconformities.valids.ch"

namespace totvs.protheus.manufacturing.incominginspection

using namespace totvs.framework.structure.object

/*/{Protheus.doc} validateSAGNonconformitySmartX
Valida a chave da Não Conformidades conforme o X3_VALID legado de
AG_NAOCON.
@type function
@author willian.ramalho
@since 26/08/2026
@param xValue, variant, Valor do campo
@param cField, character, Campo em validacao
@param aContextInfo, array, Contexto resolvido pelo cliente
@return json, Resultado da validacao
/*/
Function validateSAGNonconformitySmartX(xValue, cField, aContextInfo)

    Local aFiltros := {} as array
    Local lValid   := .T. as logical

    If ValType(xValue) == "C" .And. ValType(cField) == "C" .And. ;
        ValType(aContextInfo) == "A" .And. Upper(AllTrim(cField)) == "AG_NAOCON"

        aAdd(aFiltros, {" AG_NAOCON = ? ", {{xValue, "S"}}})
        If QLTQueryManager():dbSeek("SAG", "", aFiltros)
            lValid := .F.
        EndIf
    EndIf

Return buildSAGResult(lValid, STR0001) // STR0001 - "Não conformidade ja cadastrada ou invalida."

/*/{Protheus.doc} validateSAGClassSmartX
Valida a classe conforme o X3_VALID legado de AG_CLASSE.
@type function
@author willian.ramalho
@since 26/08/2026
@param xValue, variant, Valor do campo
@param cField, character, Campo em validacao
@param aContextInfo, array, Contexto resolvido pelo cliente
@return json, Resultado da validacao
/*/
Function validateSAGClassSmartX(xValue, cField, aContextInfo)

    Local lValid := .F. as logical

    If ValType(xValue) == "C" .And. ValType(cField) == "C" .And. ;
        ValType(aContextInfo) == "A" .And. Upper(AllTrim(cField)) == "AG_CLASSE"
        lValid := ExistCpo("QEE", xValue)
    EndIf

Return buildSAGResult(lValid, STR0002) // STR0002 - "Classe de Não conformidade nao cadastrada."

/*/{Protheus.doc} buildSAGResult
Monta o JSON de retorno padrao do contrato serverValidate do Smart X.
@type function
@author willian.ramalho
@since 26/08/2026
@param lValid, logical, Resultado da validacao
@param cMessage, character, Mensagem de falha (ignorada se lValid)
@return json, Contrato {return, notValidMessage}
/*/
Static Function buildSAGResult(lValid, cMessage)

    Local jResult as json

    If lValid
        cMessage := ""
    EndIf
    jResult := JsonObject():new()
    jResult["return"] := lValid
    jResult["notValidMessage"] := cMessage

Return jResult
