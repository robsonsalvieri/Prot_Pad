#include "tlpp-core.th"
#include "tlpp-rest.th"

//------------------------------------------------------------------------------
/*/{Protheus.doc} mntInsightsBathtubCurve
Função executada pela rota "mnt_insight/chart_u/bathtub_curve/:equipment"
Valida os parâmetros enviados e realiza o envio da carga de bens

@type Function

@author João Ricardo Santini Zandoná
@since 01/07/2025

@return Nil  
/*/ 
//------------------------------------------------------------------------------
@Get ( endpoint = 'mnt-insight/chart-u/bathtub-curve/:equipment' )
function mntInsightsBathtubCurve()

    Local oError
	Local bLastError
    Local aResponse  := { Nil ,200 }
    Local jPathParam := oRest:getPathParamsRequest()

	bLastError := ErrorBlock( { | oError | MntWSError( oError ), .F., Break( oError ) } )

    Begin Sequence

        If jPathParam:HasProperty( 'equipment' ) .And. !Empty( jPathParam[ 'equipment' ] )

            aResponse := fChart( oRest, jPathParam[ 'equipment' ] )
            
        EndIf

        oRest:SetStatusCode( aResponse[ 2 ] )
        oRest:SetResponse( aResponse[ 1 ] )

	End Sequence
    
    ErrorBlock( bLastError )

return

//------------------------------------------------------------------------------
/*/{Protheus.doc} fChart
Função responsável por montar o gráfico em banheira

@type Function

@author João Ricardo Santini Zandoná
@since 01/07/2025
@params oRest, objeto, que contém os parâmetros da requisição
@params cCodBem, caractere, Código do Bem a ser consultado

@return array, retorna na primeira posição o objeto Json com os dados do gráfico
                e na segunda posição o código de status HTTP
/*/ 
//------------------------------------------------------------------------------
static function fChart( oRest, cCodBem )

    Local dDataIni := ''
    Local dDataFim := ''
    Local aRegs    := {}
    Local oResponse

    dDataFim := Date()

    dDataIni := Posicione( 'ST9', 1, FWxFilial( 'ST9', cFilAnt ) + cCodBem, 'T9_DTCOMPR' )
    
    // A data inicio é igual a data de compra do bem, caso a data de compra seja mais de quatro anos atrás
    // a data inicial é setada em quatro anos
    If dDataIni < YearSub( dDataFim, 4 )

        dDataIni := YearSub( dDataFim, 4 )

    EndIf

    // Carga das Ordens de Serviço e Predições
    aRegs := fCargaOS( cCodBem, DTOS( dDataIni ), DTOS( dDataFim ) )

    // Montagem do retorno JSON
    oResponse := fMontaJson( aRegs[1], aRegs[2], dDataIni, dDataFim )
    oResponse[ 'equipment' ] := AllTrim( cCodBem )

return { oResponse, 200 }

//------------------------------------------------------------------------------
/*/{Protheus.doc} fMontaJson
Função responsável por montar o Json com os dados do Gráfico

@type Function

@author João Ricardo Santini Zandoná
@since 01/07/2025
@params aOs,      array, contém as ordens de serviço e seus custos
@params cPredict, caractere, Json ainda em formato String com as predições
@params dDataIni, data, Data inicial da consulta
@params dDataFim, data, Data final da consulta


@return oResponse, objeto, Json que contém os dados do gráfico com os custos e as predições
/*/ 
//------------------------------------------------------------------------------
static function fMontaJson( aOs, cPredict, dDataIni, dDataFim )

    Local nI := Year( dDataIni )
    Local nAnoFim := Year( dDataFim )
    Local nX := 1
    Local nY := 1
    Local nCusto := 0
    Local nQtd := 0
    Local cUltmData := ''
    Local aResponse := {}
    Local oResponse := JsonObject():New()
    Local oPredict  := JsonObject():New()

    // Ordenação do Array
    If Len( aOs ) > 1
    
        aSort( aOS, , , { | x, y | x[ 3 ] < y[ 3 ] } )
    
    Endif

    // Como nI é igual ao ano inicial o controle é feito usando o ano final
    While nI <= nAnoFim

        // O Loop deve se repetir para todos os meses de todos os anos ate o mes atual, dessa forma traz 0 caso não exista O.s.
        If nI == Year( dDataIni )
            
            nX := Month( dDataIni )

        Else
            
            nX := 1

        EndIf

        While ( nI < nAnoFim .And. nX <= 12 ) .Or. ( nI == nAnoFim .And. nX <= Month( Date() ) )

            nCusto := 0
            nQtd := 0

            // Para evitar passar pelo Array de O.s. completo sempre o aScan é usado para a posição inicial já ser o primeiro registro do Mes
            nY := aScan( aOs, { |x| SUBSTR( DTOS( x[ 2 ] ), 1, 4 ) + SUBSTR( DTOS( x[ 2 ] ), 5, 2 ) == cValToChar( nI ) + PADL( cValToChar( nX ), 2, '0' ) } )
            If nY > 0 
               
                While nY <= Len( aOs )

                    If Month( aOs[ nY, 2 ] ) == nX .And. Year( aOs[ nY, 2 ] ) == nI
                     
                        nCusto := nCusto + aOs[ nY, 1 ]
                        nQtd ++
                    
                    EndIf
                    
                    nY ++

                End
            
            EndIf

            aAdd( aResponse, JsonObject():new() )

            aResponse[ Len( aResponse ), 'year'  ] := cValToChar( nI )
            aResponse[ Len( aResponse ), 'month'  ] := PADL( cValToChar( nX ), 2, '0' )
            aResponse[ Len( aResponse ), 'cost'  ] := nCusto
            aResponse[ Len( aResponse ), 'failures'  ] := nQtd

            nX ++

        End

        nI ++

    End

    oPredict := JsonObject():New()

    // Inclui no retorno os meses futuros usando as predições
    If !Empty( cPredict )

        oPredict:FromJson( StrTran( SubStr( cPredict, 2, ( Len( cPredict ) - 2 ) ), '\','' ) )

        If !Empty( aResponse[ Len( aResponse ), 'year'] ) .And. !Empty( aResponse[ Len( aResponse ), 'month'] ) .And. ValType( oPredict[ 'cost' ] ) == 'A'

            cUltmData := aResponse[ Len( aResponse ), 'year' ] + aResponse[ Len( aResponse ), 'month' ] + '01'

            For nI := 1 To Len( oPredict[ 'cost' ] )
                
                cUltmData := DTOS(MonthSum( STOD(cUltmData), 1 ))

                aAdd( aResponse, JsonObject():new() )

                aResponse[ Len( aResponse ), 'year'  ] := cValToChar( Year( STOD( cUltmData ) ) )
                aResponse[ Len( aResponse ), 'month' ] := cValToChar( Month( STOD( cUltmData ) ) )
                aResponse[ Len( aResponse ), 'cost'  ] := oPredict[ 'cost', nI, 'predict' ]
                aResponse[ Len( aResponse ), 'failures' ] := oPredict[ 'failures', nI, 'predict' ]
                aResponse[ Len( aResponse ), 'confidence' ] := JsonObject():new()
                aResponse[ Len( aResponse ), 'confidence', 'cost' ] := JsonObject():new()
                aResponse[ Len( aResponse ), 'confidence', 'failures' ] := JsonObject():new()
                aResponse[ Len( aResponse ), 'confidence', 'cost', 'min' ] := oPredict[ 'cost', nI, 'min' ]
                aResponse[ Len( aResponse ), 'confidence', 'cost', 'max' ] := oPredict[ 'cost', nI, 'max' ]
                aResponse[ Len( aResponse ), 'confidence', 'failures', 'min' ] := oPredict[ 'failures', nI, 'min' ]
                aResponse[ Len( aResponse ), 'confidence', 'failures', 'max' ] := oPredict[ 'failures', nI, 'max' ]

            Next nI

        EndIf

    EndIf

    oResponse['values'] := aResponse

return oResponse

//------------------------------------------------------------------------------
/*/{Protheus.doc} fCargaOS
Função responsável por carregar todas as O.s. do Bem e seus custos 

@type Function

@author João Ricardo Santini Zandoná
@since 01/07/2025
@params cBem, caractere, Codigo do bem
@params cDtIni, caractere, Data inicial da consulta
@params cDtFim, caractere, Data final da consulta

@return array, retorna na primeira posição um array com as informações das Ordens de Serviço
                e na segunda posição um array contendo as predições
/*/ 
//------------------------------------------------------------------------------
static function fCargaOS( cBem, cDtIni, cDtFim )

    Local cQuery    := ''
    Local cAliasQry := GetNextAlias()
    Local aOS := {}
    Local cPredict   := ''

    cQuery := 'SELECT '
    cQuery +=   'CUSTO, '
    cQuery +=   'DTINI, '
    cQuery +=   'ORDEM, '

    cQuery += fSelectI21( cBem )

    cQuery += 'FROM ( '
    // Query 1 - Ordens de Serviço do Bem
    cQuery +=   'SELECT '
    cQuery +=     'SUM( STL.TL_CUSTO ) AS CUSTO, '
    cQuery +=     'MIN( STL.TL_DTINICI ) AS DTINI,
    cQuery +=     'STJ.TJ_ORDEM AS ORDEM '
    cQuery +=   'FROM ' + RetSqlName( 'STL' ) + ' STL '
    cQuery +=   'INNER JOIN ' + RetSqlName( 'STJ' ) + ' STJ ' + ' ON '
    cQuery +=     'STJ.TJ_FILIAL = ' + ValToSQL( FWxFilial( 'STJ' ) ) + ' '
    cQuery +=     'AND STJ.TJ_ORDEM = STL.TL_ORDEM '
    cQuery +=     "AND STJ.TJ_PLANO = '000000' "
    cQuery +=     'AND STJ.TJ_CODBEM = ' + ValToSql( cBem ) + ' '
    cQuery +=     "AND STJ.TJ_SITUACA = 'L' "
    cQuery +=     "AND STJ.D_E_L_E_T_ = ' ' "
    cQuery +=   'WHERE '
    cQuery +=     'STL.TL_FILIAL = ' + ValToSQL( FWxFilial( 'STL' ) ) + ' '
    cQuery +=     "AND STL.TL_PLANO = '000000' "
    cQuery +=     "AND STL.TL_SEQRELA <> '0' "
    cQuery +=     'AND STL.TL_DTINICI >= ' + ValToSQL( cDtIni ) + ' '
    cQuery +=     'AND STL.TL_DTINICI <= ' + ValToSQL( cDtFim ) + ' '
    cQuery +=     "AND STL.D_E_L_E_T_ = ' ' "
    cQuery +=   'GROUP BY STJ.TJ_ORDEM '

    cQuery += 'UNION ALL '

    // Query 2 - Ordens de Serviço dos Bens Filhos
    cQuery +=   'SELECT '
    cQuery +=     'SUM(STL.TL_CUSTO) AS CUSTO, '
    cQuery +=     'MIN(STL.TL_DTINICI) AS DTINI,'
    cQuery +=     'STJ.TJ_ORDEM AS ORDEM '
    cQuery +=   'FROM ' + RetSqlName( 'STL' ) + ' STL '
    cQuery +=   'INNER JOIN ' + RetSqlName( 'STJ' ) + ' STJ ' + ' ON '
    cQuery +=     'STJ.TJ_FILIAL = ' + ValToSQL( FWxFilial( 'STJ' ) ) + ' '
    cQuery +=     'AND STJ.TJ_ORDEM = STL.TL_ORDEM '
    cQuery +=     "AND STJ.TJ_PLANO = '000000' "
    cQuery +=     "AND STJ.D_E_L_E_T_ = ' ' "
    cQuery +=   'INNER JOIN ' + RetSqlName( 'STZ' ) + ' STZ ' + ' ON '
    cQuery +=     'STZ.TZ_FILIAL = ' + ValToSQL( FWxFilial( 'STZ' ) ) + ' '
    cQuery +=     'AND STZ.TZ_CODBEM = STJ.TJ_CODBEM '
    cQuery +=     'AND STZ.TZ_BEMPAI = ' + ValToSQL( cBem ) + ' '
    cQuery +=     'AND STZ.TZ_DATAMOV <= STL.TL_DTINICI '
    cQuery +=     'AND STZ.TZ_DATASAI >= STL.TL_DTINICI '
    cQuery +=     "AND STZ.D_E_L_E_T_ = ' ' "
    cQuery +=   'WHERE '
    cQuery +=     'STL.TL_FILIAL = ' + ValToSQL( FWxFilial( 'STL' ) ) + ' '
    cQuery +=     "AND STL.TL_PLANO = '000000' "
    cQuery +=     "AND STL.TL_SEQRELA <> '0' "
    cQuery +=     'AND STL.TL_DTINICI >= ' + ValToSQL( cDtIni ) + ' '
    cQuery +=     'AND STL.TL_DTINICI <= ' + ValToSQL( cDtFim ) + ' '
    cQuery +=     "AND STL.D_E_L_E_T_ = ' ' "
    cQuery +=   'GROUP BY STJ.TJ_ORDEM '
    
    cQuery += 'UNION ALL '
    
    // Query 3 - Ordens de Serviço no Histórico do Bem
    cQuery +=   'SELECT '
    cQuery +=     'SUM( STT.TT_CUSTO ) AS CUSTO, '
    cQuery +=     'MIN( STT.TT_DTINICI ) AS DTINI,
    cQuery +=     'STS.TS_ORDEM AS ORDEM '
    cQuery +=   'FROM ' + RetSqlName( 'STT' ) + ' STT '
    cQuery +=   'INNER JOIN ' + RetSqlName( 'STS' ) + ' STS ' + ' ON '
    cQuery +=     'STS.TS_FILIAL = ' + ValToSQL( FWxFilial( 'STS' ) ) + ' '
    cQuery +=     'AND STS.TS_ORDEM = STT.TT_ORDEM '
    cQuery +=     "AND STS.TS_PLANO = '000000' "
    cQuery +=     'AND STS.TS_CODBEM = ' + ValToSql( cBem ) + ' '
    cQuery +=     "AND STS.TS_SITUACA = 'L' "
    cQuery +=     "AND STS.D_E_L_E_T_ = ' ' "
    cQuery +=   'WHERE '
    cQuery +=     'STT.TT_FILIAL = ' + ValToSQL( FWxFilial( 'STT' ) ) + ' '
    cQuery +=     "AND STT.TT_PLANO = '000000' "
    cQuery +=     "AND STT.TT_SEQRELA <> '0' "
    cQuery +=     'AND STT.TT_DTINICI >= ' + ValToSQL( cDtIni ) + ' '
    cQuery +=     'AND STT.TT_DTINICI <= ' + ValToSQL( cDtFim ) + ' '
    cQuery +=     "AND STT.D_E_L_E_T_ = ' ' "
    cQuery +=   'GROUP BY STS.TS_ORDEM '

    cQuery += 'UNION ALL '

    // Query 4 - Ordens de Serviço no Histórico dos Bens Filhos
    cQuery +=   'SELECT '
    cQuery +=     'SUM(STT.TT_CUSTO) AS CUSTO, '
    cQuery +=     'MIN(STT.TT_DTINICI) AS DTINI,'
    cQuery +=     'STS.TS_ORDEM AS ORDEM '
    cQuery +=   'FROM ' + RetSqlName( 'STT' ) + ' STT '
    cQuery +=   'INNER JOIN ' + RetSqlName( 'STS' ) + ' STS ' + ' ON '
    cQuery +=     'STS.TS_FILIAL = ' + ValToSQL( FWxFilial( 'STS' ) ) + ' '
    cQuery +=     'AND STS.TS_ORDEM = STT.TT_ORDEM '
    cQuery +=     "AND STS.TS_PLANO = '000000' "
    cQuery +=     "AND STS.D_E_L_E_T_ = ' ' "
    cQuery +=   'INNER JOIN ' + RetSqlName( 'STZ' ) + ' STZ ' + ' ON '
    cQuery +=     'STZ.TZ_FILIAL = ' + ValToSQL( FWxFilial( 'STZ' ) ) + ' '
    cQuery +=     'AND STZ.TZ_CODBEM = STS.TS_CODBEM '
    cQuery +=     'AND STZ.TZ_BEMPAI = ' + ValToSQL( cBem ) + ' '
    cQuery +=     'AND STZ.TZ_DATAMOV <= STT.TT_DTINICI '
    cQuery +=     'AND STZ.TZ_DATASAI >= STT.TT_DTINICI '
    cQuery +=     "AND STZ.D_E_L_E_T_ = ' ' "
    cQuery +=   'WHERE '
    cQuery +=     'STT.TT_FILIAL = ' + ValToSQL( FWxFilial( 'STT' ) ) + ' '
    cQuery +=     "AND STT.TT_PLANO = '000000' "
    cQuery +=     "AND STT.TT_SEQRELA <> '0' "
    cQuery +=     'AND STT.TT_DTINICI >= ' + ValToSQL( cDtIni ) + ' '
    cQuery +=     'AND STT.TT_DTINICI <= ' + ValToSQL( cDtFim ) + ' '
    cQuery +=     "AND STT.D_E_L_E_T_ = ' ' "
    cQuery +=   'GROUP BY STS.TS_ORDEM '

    cQuery += ') AS Query '
    
    cQuery += 'ORDER BY ORDEM '

    cQuery := ChangeQuery( cQuery )
    dbUseArea( .T.,'TOPCONN',TcGenQry( , , cQuery ), cAliasQry, .T., .T. )

    dbSelectArea( cAliasQry )
    dbGoTop()
    While (cAliasQry)->( !Eof() )

	    aAdd( aOS, { (cAliasQry)->CUSTO, STOD( (cAliasQry)->DTINI ), (cAliasQry)->ORDEM } )
        cPredict := (cAliasQry)->PAYLOD

        dbSkip()

    End

    (cAliasQry)->(DbCloseArea())

return {aOS, cPredict}

//------------------------------------------------------------------------------
/*/{Protheus.doc} fSelectI21
Função responsável por montar a SubConsulta na tabela I21 para a query de Bens e
para a query do Gráfico considerando o banco de dados utilizado

@type Function

@author João Ricardo Santini Zandoná
@since 03/07/2025
@params cCodBem, caractere, Código do Bem a ser consultado
(Enviado apenas quando vai gerar o subselect para a query do Gráfico)

@return caractere, string contendo o subselect na I21  
/*/ 
//------------------------------------------------------------------------------
static function fSelectI21( cCodBem )

    Local cBanco := AllTrim( TCGetDB() )
    Local cQuery := ''

    default cCodBem := ''

    If cBanco == 'ORACLE'

        cQuery += "UTL_RAW.CAST_TO_VARCHAR2(DBMS_LOB.SUBSTR(
        cQuery += '(SELECT '
        cQuery +=  'I21.I21_PAYLOD '
        cQuery += 'FROM ' + RetSqlName( 'I21' ) + ' I21 '
        cQuery += 'WHERE '
        cQuery +=   'I21.I21_KEY = ' + ValToSQL( cEmpAnt + '|' + AllTrim( FWxFilial( 'ST9' ) ) + '|' + cCodBem ) + ' '

        cQuery +=   "AND I21.I21_INSIGT = 'BathtubCurve'"
        
        cQuery += "ORDER BY I21.I21_DTPROC DESC "
        cQuery +=   "OFFSET 0 ROWS FETCH NEXT 1 ROWS ONLY) "
        cQuery += ', 4000, 1)) AS PAYLOD '

    ElseIf cBanco == 'POSTGRES'

        cQuery += 'coalesce(CAST(ENCODE( '
        cQuery += '(SELECT '
        cQuery +=  'I21.I21_PAYLOD '
        cQuery += 'FROM ' + RetSqlName( 'I21' ) + ' I21 '
        cQuery += 'WHERE '
        cQuery +=   'I21.I21_KEY = ' + ValToSQL( cEmpAnt + '|' + AllTrim( FWxFilial( 'ST9' ) ) + '|' + cCodBem ) + ' '

        cQuery +=   "AND I21.I21_INSIGT = 'BathtubCurve'"

        cQuery += "ORDER BY I21.I21_DTPROC DESC "
        cQuery +=   "LIMIT 1) "
        cQuery += ", 'ESCAPE') AS VARCHAR(8000)), '') AS PAYLOD "

    Else

        cQuery += "ISNULL(CAST(CAST( "
        cQuery += '(SELECT TOP (1) '
        cQuery +=  'I21.I21_PAYLOD '
        cQuery += 'FROM ' + RetSqlName( 'I21' ) + ' I21 '
        cQuery += 'WHERE '
        cQuery +=   'I21.I21_KEY = ' + ValToSQL( cEmpAnt + '|' + AllTrim( FWxFilial( 'ST9' ) ) + '|' + cCodBem ) + ' '

        cQuery +=   "AND I21.I21_INSIGT = 'BathtubCurve'"
        
        cQuery += "ORDER BY I21.I21_DTPROC DESC) "
        cQuery += "AS VARBINARY(8000)) AS VARCHAR(8000)),'') AS PAYLOD "
    
    EndIf

return cQuery
