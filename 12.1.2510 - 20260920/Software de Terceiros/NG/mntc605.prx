//------------------------------------------------------------------------------
/*/{Protheus.doc} MNTCDEPE2
Monta um browse com as Dependencia da manutencao

@author Caue Girardi Petri  
@since 29/04/26
@return boolean
/*/
//------------------------------------------------------------------------------
Function MNTCDEPE2( aMenu )

    Local oBrowse
	Local cFilter := ''
	Local aArea   := GetArea()

	Private cCadastro := OemtoAnsi(STR0008) //"Dependencia da Manutencao"

	aRotina := aMenu

    RegToMemory( 'ST5', .F. )

	cFilter := ' STM->TM_FILIAL == FWxFilial("STM") .And. STM->TM_CODBEM == M->T5_CODBEM'
	cFilter += ' .And. STM->TM_SERVICO == M->T5_SERVICO .And. STM->TM_SEQRELA == M->T5_SEQRELA'
	cFilter += ' .And. STM->TM_TAREFA == M->T5_TAREFA '

	oBrowse:= FWMBrowse():New()
	oBrowse:SetAlias( "STM" )		  // Alias da tabela utilizada
	oBrowse:SetDescription( STR0008 ) //"Dependencia da Manutencao"
	oBrowse:SetFilterDefault( cFilter )
	oBrowse:Activate()

	DbSelectArea("STM")
	DbSetOrder(01)

	RestArea( aArea )

Return

