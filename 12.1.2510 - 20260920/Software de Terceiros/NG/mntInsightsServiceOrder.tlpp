#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "mntinsightsserviceorder.ch"

//------------------------------------------------------------------------------
/*/{Protheus.doc} mntInsightsServiceOrder
Função executada pela rota "mnt-insight/service-order"
Realiza a geração de O.s. Preventiva

@type Function

@author João Ricardo Santini Zandoná
@since 03/12/2025

@return Nil  
/*/ 
//------------------------------------------------------------------------------
@Post ( endpoint = 'mnt-insight/service-order' )
function mntInsightsServiceOrder()
    Local oError
	Local bLastError
    Local aResponse  := { Nil ,200 }
    Local jRespJson  := JsonObject():New()

	bLastError := ErrorBlock( { | oError | MntWSError( oError ), .F., Break( oError ) } )

    Begin Sequence
        
        aResponse := fGeraOs( oRest )
            
        jRespJson['message'] := DecodeUTF8( aResponse[ 1 ] )

        If jRespJson['message'] == Nil
            jRespJson['message'] := aResponse[ 1 ]
        EndIf

        oRest:SetStatusCode( aResponse[ 2 ] )
        oRest:SetResponse( jRespJson )
        
	End Sequence
    
    ErrorBlock( bLastError )
return

//------------------------------------------------------------------------------
/*/{Protheus.doc} fGeraOs
Realiza a geração da Ordem de Serviço e chama a alteração do status 
do paylod na I21

@type Function

@author João Ricardo Santini Zandoná
@since 03/12/2025
@param oRest, object, Objeto de requisição do REST

@return Array, contém duas posições na primeira uma mensagem de retorno e na segunda o código HTTP  
/*/ 
//------------------------------------------------------------------------------
static function fGeraOs( oRest )
    
    Local aResponse  := { Nil ,200 }
    Local oReq       := JsonObject():New()
    Local cReq       := oRest:getBodyRequest()
    Local cReqRet    := ''
    Local aGerOsRet  := {}

    cReqRet := oReq:FromJson( cReq )

    If !Empty( cReqRet )

        aResponse := { STR0001, 400 } // "Corpo da requisição inválido."

    Else

        If ValType( oReq['tf_codbem'] ) <> 'U' .And. ValType( oReq['tf_servico'] ) <> 'U' .And. ValType( oReq['tf_seqrela'] ) <> 'U'

            aGerOsRet := NGGERAOS('P', dDataBase, Padr( oReq['tf_codbem'], FwTamSx3('TF_CODBEM')[1] ), Padr( oReq['tf_servico'], FwTamSx3('TF_SERVICO')[1] ), Padr( oReq['tf_seqrela'], FwTamSx3('TF_SEQRELA')[1] ), 'S', 'S', 'S' )

            If aGerOsRet[1, 1] == 'N'

                aResponse[1] := aGerOsRet[1, 2]
                aResponse[2] := 400
            
            Else

                mntChangeStatusI21( oReq['tf_codbem'], oReq['tf_servico'], oReq['tf_seqrela'], 'completed' )
                aResponse[1] := STR0002 + AllTrim( aGerOsRet[ 1, 3 ] ) + STR0003 // "Ordem de serviço "###" gerada com sucesso."

            EndIf

        Else

            aResponse := { STR0004, 400 } // "Parâmetros obrigatórios não informados."

        EndIf

    EndIf

return aResponse
