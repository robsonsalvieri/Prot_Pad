#include 'tlpp-core.th'
#include 'InsightDefs.ch'

REGISTER INSIGHT SuggestPreventives

//------------------------------------------------------------------------------
/*/{Protheus.doc} SuggestPreventives
Classe responsável por gravar os dados da I21

@type class

@author Tainã Cardoso
@since 01/07/2025

@return Nil  
/*/ 
//------------------------------------------------------------------------------
Class SuggestPreventives  from PinsConfig
    Public Method New() CONSTRUCTOR
    Public Method Config()
EndClass

//------------------------------------------------------------------------------
/*/{Protheus.doc} New
Método Construtor da classe

@type method

@author Tainã Cardoso
@since 01/07/2025

@return retorna o objeto instanciado  
/*/ 
//------------------------------------------------------------------------------
Method New() class SuggestPreventives
	_Super:New( 'SuggestPreventives', 'MNT' )
Return Self  

//------------------------------------------------------------------------------
/*/{Protheus.doc} Config
Realiza as configurações necessárias para o carregamento da I21

@type method

@author Tainã Cardoso
@since 01/07/2025
/*/ 
//------------------------------------------------------------------------------
Method Config() class SuggestPreventives
    
    ::SetHasKey( .T. )
	::SetHasFilter( .T. )
	::SetPriority( .T. )

    ::SetTagDateFrom("mdmCreated") //Data de criação
	::SetTagDateTo("expirationDate") //Data de expiração
    ::SetKey( "key" ) //Chave do insght Empresa|Filial|Serviço, exp: 'T1|D MG 01 |CORELE'

Return
