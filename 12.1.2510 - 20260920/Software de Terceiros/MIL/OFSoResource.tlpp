#include "tlpp-core.th"
#include "totvs.ch"
#INCLUDE "FWMVCDEF.CH"

//static lDebug := .f.

/*/{Protheus.doc} OFSoResource
	Classe com os dados de Bancos (Resource) para comunicação com o Blackbird

	@type function
	@author Guilherme Vieira
	@since 10/01/2022
/*/
class OFSoResource from VERegistroSql
	Public Method New()
	Public Method ToJsonApi()
	Public Method ToJson()
	Public Method GetRefId()
	Public Method Fill()
	Public Method FindByRecnoDel()
	
end class


/*/{Protheus.doc} New 
	Construtor basico

	@type function
	@author Guilherme Vieira
	@since 13/01/2022
/*/
method New() class OFSoResource

	_Super:New('VAI')

	::AddFields({"R_E_C_N_O_", "VAI_BBRFID","VAI_NOMTEC","VAI_CODTEC","VAI_FABUSR","VAI_DATDEM","VAI_CUSTHR"})

	//::AddFieldsData({"VAI_DATDEM"})

	::SetPKField("VAI_BBRFID")

	/*
	if lDebug
		Conout(" ")
		Conout( "OFSoResource:NEW " + Str(Procline(1),5) + " - " + ProcName(1) )
		Conout(" ")
	endif
	*/

return self


/*/{Protheus.doc} FindByRecnoDel
	Busca pelo recno

	@type function
	@author Guilherme Vieira
	@since 13/01/2022
/*/
Method FindByRecnoDel(nRecno) Class OFSoResource
	self:Select();
		:_From(self:cAlias);
		:AndEq('R_E_C_N_O_', nRecno)

	// busca primeiro registro
	oReg := self:First()

	// limpa a query interna
	self:Clear()

Return oReg

/*/{Protheus.doc} GetRefId
	Retorna o reference id para usar no SO

	@type function
	@author Guilherme Vieira
	@since 13/01/2022
/*/
Method GetRefId() Class OFSoResource
Return self:Get("VAI_BBRFID")

/*/{Protheus.doc} ToJson
	retorna um json object

	@type method
	@author Guilherme Vieira
	@since 02/07/2021
/*/
Method ToJson(cOperation) Class OFSoResource
Return self:ToJsonApi(cOperation)

/*/{Protheus.doc} ToJsonApi
	Retorna um JSON para enviar a API

	@type function
	@author Guilherme Vieira
	@since 13/01/2022
/*/
Method ToJsonApi(cOperation) Class OFSoResource
	local jJson := JsonObject():New()
	local jJsonResource := JsonObject():New()

	Local aSplitName := SplitName(self:Get("VAI_NOMTEC"))

	// resourceId          | required | string <= 100 characters                        | A ID for the resource.
	// locationReferenceId | required | string <= 100 characters                        | A unique identifier for the location to which this resource is related.
	// racfId              | required | string <= 100 characters                        | A RACFID for the resource.
	// firstName           | required | string <= 50 characters                         | The first name of the resource
	// lastName            | required | string <= 50 characters                         | The last name of the resource
	// cost                | required | number <decimal>                                | The cost for the resource.
	// resourceType        | required | Enum: "Technician" "Hourly" "Salesperson" "TBD" | The type for the resource.
	// active              | required | boolean                                         | An value indicating if the resource is active.
	// terminated          | required | boolean                                         | An value indicating if the resource is terminated.
	// terminatedDate      |          | string or null <date>                           | The time zone independent date of the resources termination.

	jJsonResource["referenceId"] := FGX_SetVlJson( "RS-" + self:Get("VAI_BBRFID"), .f.)
	jJsonResource["resourceId"] := FGX_SetVlJson( self:Get("VAI_CODTEC"), .f.)
	if cOperation == 'added' .or. cOperation == 'modified'
		jJsonResource["locationReferenceId"] := cEmpAnt + "-" + cFilAnt
		jJsonResource["racfid"]              := FGX_SetVlJson( self:Get("VAI_FABUSR") , .f.)
		jJsonResource["firstName"]           := FGX_SetVlJson( aSplitName[1] , .f.)
		jJsonResource["lastName"]            := FGX_SetVlJson( aSplitName[2] , .f.)
		jJsonResource["cost"]                := cvaltochar(self:Get("VAI_CUSTHR"))
		jJsonResource["resourceType"]        := "Technician"
		if empty(self:Get("VAI_DATDEM"))
			jJsonResource["active"]              := .T.
			jJsonResource["terminated"]          := .F.
			jJsonResource["terminatedDate"]      := Nil
		else
			jJsonResource["active"]              := .F.
			jJsonResource["terminated"]          := .T.
			jJsonResource["terminatedDate"]      := FGX_SetVlJson( iif( ! empty(self:Get("VAI_DATDEM")) , left(self:Get("VAI_DATDEM"),4) + "-" + substr(self:Get("VAI_DATDEM"),5,2) + "-" + right(self:Get("VAI_DATDEM"),2) + "T" + "00:00:00" + "Z", "" ) , .f. ) // "2020-01-01T00:00:00Z"
		endif

	Elseif cOperation == 'removed'
	 
		jJsonResource["resourceType"] := "Technician"	

	Endif
	jJson[cOperation] := {}
	aadd( jJson[cOperation] , jJsonResource )

Return jJson

/*/{Protheus.doc} SplitName
Quebra o nome para gravacao correta do Customer

@type function
@author Rubens Takahashi
@since 04/01/2022
/*/
Static Function SplitName(cFullName)

	local cFirstName := ""
	local cLastName := cFullName
	local nPos

	cFullName := allTrim(cFullName)
	cLastName := cFullName

	// Retira o Sobrenome
	nPos := AT(" ",cFullName)
	If nPos <> 0
		cLastName := Right(cFullName,Len(cFullName) - nPos)
		cFirstName := AllTrim(Left(cFullName,nPos))
	EndIf

Return {cFirstName, cLastName}
