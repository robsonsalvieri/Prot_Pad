Static Function MenuDef()
Local aRotina := { { STR0002 ,"axPesqui", 0 , 1},;
					{ STR0003 ,"AxVisual", 0 , 2},;   //VISUALIZAR
					{ STR0004 ,"OA270I", 0 , 3},;   //INCLUIR
					{ STR0005 ,"OA270A", 0 , 4},;  //ALTERAR
					{ STR0006 ,"OA270E", 0 , 5}}   //EXCLUIR
Return aRotina
