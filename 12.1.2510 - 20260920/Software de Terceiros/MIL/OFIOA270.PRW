Function OFIOA270()

local cAlias

Private aRotina := MenuDef()

Private cCadastro := STR0001  //"Cadastro de Pacotes de Serviços"

cAlias := "VSK"
dbSelectArea(cAlias)
dbSetOrder(1)

dbSelectArea(cAlias)
mBrowse( 6, 1, 22, 75, cAlias)


return


