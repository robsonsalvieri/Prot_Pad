#include 'totvs.ch'
#Include "FWMVCDEF.CH"
//#include "OFSworkOrderPartsUpdatedInFieldServiceInteractor.ch"

#DEFINE STR0001 "Invalid body data, please check makeReferenceId"
#DEFINE STR0002 "Invalid body data, work order segment does not exist."
#DEFINE STR0003 "Quantity cannot be changed."


/*/{Protheus.doc} OFSworkOrderPartsUpdatedInFieldServiceInteractor
	Classe que vai tratar a criacao de modelos no field service
	
	@type class
	@author Iury Soares Azevedo
	@since 09/06/2025
/*/
Class OFSworkOrderPartsUpdatedInFieldServiceInteractor 
	public data OFSoWorkOrder as object
	Public Method New() CONSTRUCTOR
	Public Method Process()
EndClass

/*/{Protheus.doc} New
	Construtor Simples

	@type method
	@author Iury Soares Azevedo
	@since 09/06/2025
/*/
Method New() Class OFSworkOrderPartsUpdatedInFieldServiceInteractor
	self:OFSoWorkOrder := OFSoWorkOrder():New()
Return SELF

/*/{Protheus.doc} Process
	processa a criacao
	@type method
	@author Iury Soares Azevedo
	@since 09/06/2025
/*/
Method Process(jSoRequestBody) Class OFSworkOrderPartsUpdatedInFieldServiceInteractor
	local jBody := jSoRequestBody:jBody
	local cReferenceID := "" as character
	local cSegmReferenceID := "" as character
	local jRet as json
	local cNumOSV := "" as character
	Local aResult as Array


	if jBody:HasProperty("data")
		cReferenceID := iif(jBody["data"]:HasProperty("woHeaderReferenceId"),jBody["data"]["woHeaderReferenceId"],"")
		cSegmReferenceID := iif(jBody["data"]:HasProperty("woSegmentReferenceId"),jBody["data"]["woSegmentReferenceId"],"")
	endif


	if empty(cReferenceID) .OR. ;
		! self:OFSoWorkOrder:existsWorkOrder(cReferenceID)
		
		jRet :=  OFSoRestErrorResponse():BadRequest("WorkOrderPartUpdatedInFieldService", 0, STR0001, "")	// "Invalid body data, work order does not exist."
		return jret
	endif

	if empty(cSegmReferenceID) .OR. ;
		! self:OFSoWorkOrder:existsWorkOrderSegment(cSegmReferenceID)
		
		jRet :=  OFSoRestErrorResponse():BadRequest("WorkOrderPartUpdatedInFieldService", 0, STR0002, "")	// "Invalid body data, work order segment does not exist."
		return jret
	endif

	cNumOSV := self:OFSoWorkOrder:getNumOSV()


	VO1->(dbSelectArea("VO1"))
	VO1->(dbSetOrder(1))

	VO1->(MsSeek(xFiliaL("VO1")+cNumOSV))
	
	VSJ->(dbSelectArea("VSJ"))
	VSJ->(dbSetOrder(1))

	VSJ->(MsSeek(xFiliaL("VSJ")+cNumOSV))

	SB2->(dbSelectArea("SB2"))
	SB2->(dbSetOrder(1))

	//Pergunta usada para trazer parametros de busca de estoque
	Pergunte("MTA260",.F.)

	aResult := UpdatePecas(self:OFSoWorkOrder:getSeqInc(), jBody["data"]["parts"])

	If aResult[1]
		jRet := OFSoResponseBody():New(200, jSoRequestBody, aResult[2])
	Else
		jRet := OFSoRestErrorResponse():BadRequest("WorkOrderPartUpdatedInFieldService", 0, aResult[2], "")
	EndIf
	
return jRet





Static Function UpdatePecas(cSeqInc, aParts)
	Local aRet := {.T.,""} as array
	Local oModel := FWLoadModel("OFIA486") as object
	// Local oVSJMaster := oModel:GetModel("VSJMASTER") as object
    Local oVSJDetail := oModel:GetModel("VSJDETAIL") as object
    Local aErro := {} as array
    Local cErro := "" as character
	Local nX as Numeric
	Local nPos as Numeric
	Local nQtdIni := 0 as numeric
	Local nQtdInicialProtheusAgrupada := 0 as numeric
	Local nQtdRequisitadaProtheusAgrupada := 0 as numeric
	Local nQtdDevolvidaProtheusAgrupada := 0 as numeric
	Local aGroup := {} as array



	//varivareis globais utilizadas no modelo
	Private INCLUI := .F. as logical
	Private ALTERA := .F. as logical
	Private aRotina := {} as array
	Private Digitado := Nil
	Private Garantia := Nil

	

    oModel:SetOperation(4)
    oModel:Activate()

	
	//Como nao e possivel atualizar linhas na vsj foi definido
	//que serao adicinadas novas linhas com o mesmo referenceID
	//dessa forma antes de efetuar ajustes e validacoes e importante agrupar
	//os valores por referenceid
	For nX := 1 to oVSJDetail:Length()
		oVSJDetail:GoLine(nX)
		nPos := aScan(aGroup,{|x| x[1] == oVSJDetail:GetValue("VSJ_BBRFID")})
		If nPos == 0
			aadd(aGroup,{;
				oVSJDetail:GetValue("VSJ_BBRFID"),;
				oVSJDetail:GetValue("VSJ_QTDINI"),;
				oVSJDetail:GetValue("VSJ_QTDREQ"),;
				oVSJDetail:GetValue("VSJ_QTDDEV"),; 
				{nX};
			})
		Else
			aGroup[nPos][2] += oVSJDetail:GetValue("VSJ_QTDINI")
			aGroup[nPos][3] += oVSJDetail:GetValue("VSJ_QTDREQ")
			aGroup[nPos][4] += oVSJDetail:GetValue("VSJ_QTDDEV")
			aadd(aGroup[nPos][5],nX)
		EndIf
	Next nX

	For nX := 1 to len(aParts)
		nPos := aScan(aGroup,{|x| x[1] == aParts[nX]["referenceId"]})
		nQtdIni := aParts[nX]["requestedQuantity"]
		nQtdInicialProtheusAgrupada := 0
		nQtdRequisitadaProtheusAgrupada := 0
		nQtdDevolvidaProtheusAgrupada := 0

		If nPos > 0
			nQtdInicialProtheusAgrupada := aGroup[nPos][2]
			nQtdRequisitadaProtheusAgrupada := aGroup[nPos][3]
			nQtdDevolvidaProtheusAgrupada := aGroup[nPos][4]

			nQtdIni -= nQtdInicialProtheusAgrupada
			If nQtdIni <= 0
				//Nao houve alteracao da quantidade, ou foi negativa e nao e permitido diminuir por enquanto devido a reserva ativa
				aRet[1] := .F.
				aRet[2] := STR0003 //"Quantity requested is less or iqual than the quantity available."
				Exit	
				
			EndIf
		EndIf
		
		oVSJDetail:AddLine()
		oVSJDetail:GoLine(oVSJDetail:Length())
		oVSJDetail:LoadValue("VSJ_ORIDAD","4")
		oVSJDetail:SetValue("VSJ_TIPTEM","C")
		oVSJDetail:SetValue("VSJ_CODITE",aParts[nX]["partNumber"])
		oVSJDetail:SetValue("VSJ_QTDINI",nQtdIni)
		oVSJDetail:LoadValue("VSJ_SEQINC",cSeqInc)
		//como a requisição veio do SO o registro deve nascer como integrado para evitar o loop infinito.
		//imporante manter essa atualização sempre no final
		oVSJDetail:LoadValue("VSJ_BBDINC", FGX_Timestamp())
		oVSJDetail:LoadValue("VSJ_BBSYNC", "1")
		oVSJDetail:LoadValue("VSJ_BBINTG", "1")
		oVSJDetail:LoadValue("VSJ_BBRFID", aParts[nX]["referenceId"])

		//prenche informacoes de retorno
		aParts[nX]["partType"] := "RegularPart"
		aParts[nX]["suppliedQuantity"] := Round(nQtdRequisitadaProtheusAgrupada-nQtdDevolvidaProtheusAgrupada,2)
		
		//SB1 ja esta posicionada
		SB2->(dbSetOrder(1))
		If SB2->(MsSeek(xFiliaL("SB2")+SB1->B1_COD+SB1->B1_LOCPAD))
			aParts[nX]["binQuantity"] := SaldoMov(nil, nil, nil, If(mv_par03 == 1, .F., Nil), nil, nil, nil, nil)
		Else
			aParts[nX]["binQuantity"] := 0
		EndIf
		aParts[nX]["binLocation"] := FGX_SetVlJson(SB1->B1_LOCPAD)

		aParts[nX]["unitCost"] := Round(oVSJDetail:GetValue("VSJ_VALCUS"),2)
		aParts[nX]["unitPrice"] := Round(oVSJDetail:GetValue("VSJ_VALPEC"),2)
		aParts[nX]["lineTotal"] := Round(nQtdIni * oVSJDetail:GetValue("VSJ_VALPEC"),2)
		aParts[nX]["description"] := FGX_SetVlJson(SB1->B1_DESC)
		aParts[nX]["serialNumber"] := FGX_SetVlJson(SB1->B1_CODBAR)
		aParts[nX]["invoiceNote"] := ""

	Next nX


	If aRet[1]
		If oModel:VldData() .AND. oModel:CommitData()
			aRet[1] := .T.
			aRet[2] := aParts
		Else
			aErro := oModel:GetErrorMessage()
			cErro := cValToChar(oModel:GetErrorMessage()[4]) + ' - '
			cErro += cValToChar(oModel:GetErrorMessage()[5]) + ' - '
			cErro += cValToChar(oModel:GetErrorMessage()[6])
			aRet[1] := .F.
			aRet[2] := cErro
		EndIf
	EndIf

    oModel:DeActivate()
Return aRet
