#include 'totvs.ch'
#Include "FWMVCDEF.CH"
//#include "OFSworkOrderSegmentCreatedInFieldServiceInteractor.ch"

#DEFINE STR0001 "Invalid body data:"
#DEFINE STR0002 "LocationReferenceId and partslocationReferenceId are diferent"
#DEFINE STR0003 "Customer not found."
#DEFINE STR0004 "Customer Bill not found."
#DEFINE STR0005 "Equipament not found."
#DEFINE STR0006 "Erro ao processar amarrações internas."
#DEFINE STR0007 "Order not found."
#DEFINE STR0008 "Order not found."
#DEFINE STR0009 "woHeaderReferenceId not found."


/*/{Protheus.doc} OFSworkOrderSegmentCreatedInFieldServiceInteractor
	Classe que vai tratar a criacao de modelos no field service
	
	@type class
	@author Iury Soares Azevedo
	@since 12/06/2025
/*/
Class OFSworkOrderSegmentCreatedInFieldServiceInteractor 
	Public Method New() CONSTRUCTOR
	Public Method Process()
EndClass

/*/{Protheus.doc} New
	Construtor Simples

	@type method
	@author Iury Soares Azevedo
	@since 13/06/2025
/*/
Method New() Class OFSworkOrderSegmentCreatedInFieldServiceInteractor
Return SELF

/*/{Protheus.doc} Process
	processa a criacao
	@type method
	@author Iury Soares Azevedo
	@since 13/06/2025
/*/
Method Process(jSoRequestBody) Class OFSworkOrderSegmentCreatedInFieldServiceInteractor
	local jBody := jSoRequestBody:jBody as Json
	local jRet as json
	Local aResult as array
	Local cPartsLocationReferenceId := "" as character
	Local cLocationReferenceId := "" as character
	Local lValid := .T. as logical
	Local aErroMsg := {} as array 
	Local cCustomerReferenceId := "" as character
	Local aCustomer := {"",""} as array
	Local cBillToReferenceId := "" as character
	Local cChassi := "" as character
	Local cEquipmentReferenceId := "" as character
	Local cReferenceID := "" as character
	Local cErroMsg := "" as character
	Local nX as numeric
	Local OFSoWorkOrder := OFSoWorkOrder():New() as object

	VO1->(dbSelectArea("VO1"))
	VO1->(dbSetOrder(1))

	VSJ->(dbSelectArea("VSJ"))
	VSJ->(dbSetOrder(1))

	if jBody:HasProperty("data") 
		cPartsLocationReferenceId := iif(jBody["data"]:HasProperty("partsLocationReferenceId"),jBody["data"]["partsLocationReferenceId"],"")
		cLocationReferenceId := iif(jBody["data"]:HasProperty("locationReferenceId"),jBody["data"]["locationReferenceId"],"")
		cCustomerReferenceId := iif(jBody["data"]:HasProperty("customerReferenceId"),Replace(jBody["data"]["customerReferenceId"],"CS-",""),"")
		cBillToReferenceId := iif(jBody["data"]:HasProperty("billToReferenceId"),Replace(jBody["data"]["billToReferenceId"],"CS-",""),"")
		cEquipmentReferenceId := iif(jBody["data"]:HasProperty("equipmentReferenceId"),Replace(jBody["data"]["equipmentReferenceId"],"EQ-",""),"")
		cReferenceID := iif(jBody["data"]:HasProperty("woHeaderReferenceId"),jBody["data"]["woHeaderReferenceId"],"")

	endif
	
	If Empty(cReferenceID)
		lValid := .F.
		aadd(aErroMsg,STR0009) // "woHeaderReferenceId not found."
	EndIf

	If cPartsLocationReferenceId != cLocationReferenceId
		lValid := .F.
		aadd(aErroMsg,STR0002) // "LocationReferenceId and partslocationReferenceId are diferent"
	EndIf


	VK7->(dbSelectArea("VK7"))
	VK7->(dbSetOrder(3))

	SA1->(dbSelectArea("SA1"))
	SA1->(dbSetOrder(1))

	If !VK7->(MsSeek(xFilial("VK7")+cCustomerReferenceId));
		.OR. !SA1->(MsSeek(xFilial("SA1")+VK7->VK7_A1COD+VK7->VK7_A1LOJA))
		lValid := .F.
		aadd(aErroMsg,STR0003) // "Customer not found."
	Else
		aCustomer[1] := SA1->A1_COD
		aCustomer[2] := SA1->A1_LOJA
	EndIf

	If Empty(cBillToReferenceId)
		cBillToReferenceId := cCustomerReferenceId
	EndIf

	If cCustomerReferenceId != cBillToReferenceId
		If !VK7->(MsSeek(xFilial("VK7")+cBillToReferenceId));
			.OR. !SA1->(MsSeek(xFilial("SA1")+VK7->VK7_A1COD+VK7->VK7_A1LOJA))
			lValid := .F.
			aadd(aErroMsg,STR0004) // "Customer Bill not found."
		Else
			aCustomer[1] := SA1->A1_COD
			aCustomer[2] := SA1->A1_LOJA
		EndIf
	EndIf

	cChassi := GetChassi(cEquipmentReferenceId)

	If Empty(cChassi)
		lValid := .F.
		aadd(aErroMsg,STR0005) // "Equipament not found."
	EndIf

	If lValid
		Begin Transaction
			If OFSoWorkOrder:existsWorkOrder(cReferenceID)
				If VO1->(MsSeek(xFilial("VO1")+OFSoWorkOrder:getNumOSV()))
					aResult := {.T.,VO1->VO1_NUMOSV}
				Else
					aResult := {.f.,STR0007} //"Order not found."
				EndIf
			Else
				aResult = InsertOS(cChassi, aCustomer, jBody["data"])
			EndIf

			If aResult[1]
				OFSoWorkOrder:SaveByJson(jBody,VO1->VO1_FILIAL,VO1->VO1_NUMOSV,VO1->VO1_CHASSI)
			EndIf
		
		End Transaction

		If aResult[1]
			jRet := OFSoWorkOrder:ToJson()
			jRet := OFSoResponseBody():New(200, jSoRequestBody, jRet)
		Else
			jRet := OFSoRestErrorResponse():BadRequest("WorkOrderSegmentCreatedInFieldService", 0, aResult[2], "")

		EndIf
	Else
		cErroMsg := STR0001 + " " //"Invalid body data:"

		For nX := 1 to len(aErroMsg)
			cErroMsg += aErroMsg[nX] + "; "
		Next nX
		jRet :=  OFSoRestErrorResponse():BadRequest("WorkOrderSegmentCreatedInFieldService", 0, cErroMsg, "")	

	EndIf

	
	
	
return jRet

/*/{Protheus.doc} InsertOS
	Efetua o cadastro das da OS
	@type function
	@author Iury Soares Azevedo
	@since 26/06/2025
/*/

Static Function InsertOS(cChassi, aCustomer, jData)
	Local aRet := {.T.,Nil} as array
	Local oModel := FWLoadModel("OFIA003") as object
	Local oVO1 := oModel:GetModel("MODEL_VO1") as object
	Local aErro := {} as array
	Local cErro := "" as character
	Local cTime as character
	
	Private lVO1DATATE := .F.
	Private lVO1HORTRI := ( VO1->(FieldPos("VO1_HORTRI")) <> 0 )


	oModel:SetOperation(MODEL_OPERATION_INSERT)
	oModel:Activate()

	
	oVO1:SetValue("VO1_DATENT",dDataBase + 1)
	oVO1:SetValue("VO1_GETKEY",cChassi)

	oVO1:SetValue("VO1_FATPAR",aCustomer[1])
	oVO1:SetValue("VO1_LOJA",aCustomer[2])

	oVO1:SetValue("VO1_DATENT",dDataBase+1)

	cTime := Time()
	oVO1:SetValue("VO1_HORENT",val(left(cTime,2)+substr(cTime,4,2)))

	oVO1:SetValue("VO1_OBSERV",jData["complaintNotes"])
	
	oVO1:SetValue("VO1_FUNABE","000003") //TODO: falta definição sobre esse campo

	// oVO1:SetValue("VO1_BBDINC", FGX_Timestamp())
	// oVO1:SetValue("VO1_BBSYNC", "1")
	// oVO1:SetValue("VO1_BBINTG", "1")

	If oModel:VldData() .AND. oModel:CommitData()
		aRet[1] := .T.
		aRet[2] := VO1->VO1_NUMOSV
	Else
		aErro := oModel:GetErrorMessage()
		cErro := cValToChar(oModel:GetErrorMessage()[4]) + ' - '
		cErro += cValToChar(oModel:GetErrorMessage()[5]) + ' - '
		cErro += cValToChar(oModel:GetErrorMessage()[6])
		aRet[1] := .F.
		aRet[2] := cErro
	EndIf

	oModel:DeActivate()
Return aRet



//Busca o chassi com bose no  campo VV1_BBREFID
Static Function GetChassi(cBBRFID)
	Local cRet := "" as character
	Local cAlias := GetNextAlias() as character

	BeginSql alias cAlias
		SELECT 
			VV1_CHASSI
		FROM
			%Table:VV1% VV1
		WHERE
			VV1.%notDel%
			AND VV1_FILIAL = %xFilial:VV1%
			AND VV1_BBRFID = %Exp:cBBRFID%
	EndSql

	If (cAlias)->(!EOF())
		cRet := (cAlias)->VV1_CHASSI
	EndIf

	(cAlias)->(dbCloseArea())

Return cRet

