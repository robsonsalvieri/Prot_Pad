	//private data oConfig
	private data cLocContract

	Public Method New() Constructor
	Public Method ToJsonApi()
	Public Method toJson()
//	Public Method GetId()
	Public Method GetRefId()
EndClass

/*/{Protheus.doc} New
	Construtor

	@type method
	@author Rubens Takalashi
	@since 11/06/2025
/*/
Method New(cLocContract) Class OFSoLocationContract
	//::oConfig := oConfig
	::cLocContract := cLocContract
Return SELF

