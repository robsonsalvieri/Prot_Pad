Method GetRefId() Class OFSoLocationContract
//Return ::cCodigoEmpresa + "-" + ::cCodigoFilial
Return ::cLocContract

Method ToJson() Class OFSoLocationContract
Return self:ToJsonApi()

Method ToJsonApi() Class OFSoLocationContract
	Local jJson := JsonObject():New()
	Local nX
	Local oConfig
	local oLocation

	oConfig := OFSoConfig():New()
	oConfig := oConfig:GetConfig()

	for nX := 1 to Len(oConfig["FILIAIS"])

		if oConfig["FILIAIS"][nX]["CONTRATO"] <> ::cLocContract
			loop
		endif

		oLocation := OFSoLocation():New(oConfig["FILIAIS"][nX]["EMPRESA"], oConfig["FILIAIS"][nX]["FILIAL"])

		VKB->(dbSetOrder(1))

		aInfFilial := FWSM0Util():GetSM0Data( ;
			oConfig["FILIAIS"][nX]["EMPRESA"],;
			oConfig["FILIAIS"][nX]["FILIAL"],;
			{ "M0_FILIAL" } )
			
		jJson["LocationReferenceId"]  := oLocation:GetReferenceId()
		jJson["referenceId"]          := alltrim(oConfig["FILIAIS"][nX]["CONTRATO"])
		jJson["name"]                 := allTrim(aInfFilial[1,2])
		jJson["description"]          := allTrim(aInfFilial[1,2])
		jJson["accountNumber"]        := alltrim(oConfig["FILIAIS"][nX]["CONTRATO"])
		if VKB->(dbSeek(xFilial("VKB") + oConfig["FILIAIS"][nX]["FRANCHISE"]))
			jJson["franchiseReferenceId"] := "FR-" + VKB->VKB_REFID
		endif
		jJson["mainAccount"]          := iif(oConfig["FILIAIS"][nX]["MAINACC"] == "1" , "true", "false")
		jJson["unitCode"]             := Nil
		jJson["orgIdentifier"]        := Nil
		Exit
	Next nX

Return jJson

