#include "tlpp-core.th"
#include 'totvs.ch'

/*/{Protheus.doc} OFSoWorkOrderPartsLockInDbsMessage
	Classe que representa uma mensagem da entidade Resource mensagem ChangedInDbs
	
	@type class
	@author Iury Soares Azevedo
	@since 10/06/2025
/*/
Class OFSoWorkOrderPartsLockInDbsMessage

	public data cName
	public data oSoRequest
	data aWOParts
	data cMessageId
	data cMsgVX5
	data cOriId
	data cOperation
	data OFSoWorkOrder

	public Method New() CONSTRUCTOR
	public Method Send()
	public Method GetBody()
	public Method GetHeader()
	public Method Delay()
	public method GetMessageId()
	

EndClass

/*/{Protheus.doc} New
	Construtor Simples

	@type method
	@author Iury Soares Azevedo
	@since 10/06/2025
/*/
Method New(OFSoWorkOrder) Class OFSoWorkOrderPartsLockInDbsMessage

	::cName := "WorkOrderPartsLockRequestInDbs"
	::oSoRequest := OFSoRequest():New(self)

	::oSoRequest:Set("VK5_ORITAB", "VSJ")
	::oSoRequest:Set("VK5_MESSAG", "30")

	::OFSoWorkOrder := OFSoWorkOrder
	
Return SELF



/*/{Protheus.doc} GetBody
	Retorna o body para a mensagem

	@type method
	@author Iury Soares Azevedo
	@since 10/06/2025
/*/
Method GetBody() Class OFSoWorkOrderPartsLockInDbsMessage
	Local jBody as json
	Local cHora := IncTime(Time(), 0, 15, 0) as character

	//Aqui traz o cabecalho da OS para formato json
	jBody := self:OFSoWorkOrder:ToJson(.F.)


	jBody["requestingUser"] := RetCodUsr()
	jBody["requestingSystem"] := "DBS"
	
	//todo: 15 minutos fixos aqui verificar se vai transformar em parametro
	jBody["expiresOn"] := FWTimeStamp(6,Date(),cHora)

	oReqBody := OFSoRequestBody():New()
	oReqBody:SetData(jBody)
	oReqBody:SetName(self:cName)

Return oReqBody

/*/{Protheus.doc} GetHeader
	Retorna o header da mensagem

	@type method
	@author Iury Soares Azevedo
	@since 10/06/2025
/*/

Method GetHeader() Class OFSoWorkOrderPartsLockInDbsMessage
Return self:oSoRequest:GetHeader()

/*/{Protheus.doc} Send
	Envia mensagem para SO

	@type method
	@author Iury Soares Azevedo
	@since 10/06/2025
/*/
Method Send() Class OFSoWorkOrderPartsLockInDbsMessage
	local oComm := OFSoCommunication():New()
	self:oSoRequest:SetBody(self:GetBody())
	self:oSoRequest:Save()
	jResp := oComm:SendMessage(self, self:oSoRequest)
	
	if jResp["code"] != oComm:nCodigoFalhaComunicacao
		self:OFSoWorkOrder:Lock(jResp["data"]["lockId"], jResp["data"]["lockKey"], jResp["data"]["expiresOn"])
	endif

	//if jResp["code"] == oComm:nCodigoFalhaComunicacao
	//	self:Delay() // atrasa para tentar mais tarde
	//endif
Return jResp

/*/{Protheus.doc} Delay
	atrasa a mensagem por falha de comunicação

	@type method
	@author Iury Soares Azevedo
	@since 10/06/2025
/*/
Method Delay() Class OFSoWorkOrderPartsLockInDbsMessage
	Local oMsg := OFDMSExitMessage():New()
	local oJson := JsonObject():New()
	self:oSoRequest:Save()
	oJson['header'] := self:oSoRequest:GetHeader():ToJson()
	oJson['body'] := self:oSoRequest:GetBody():ToJson()
	oMsg:Set("VK6_PAYLOA", oJson:toJson())
	oMsg:Set("VK6_MSGNAM", OFDMSMessageConstants():WorkOrderPartsLockRequestInDbsMessageName())
	oMsg:Set("VK6_CODVK5", self:oSoRequest:GetId())
	oMsg:SetAtrasada()
Return oMsg:Save()


/*/{Protheus.doc} GetMessageId
	Retorna o nome da mensagem para ser enviada ao SO

	@type method
	@author Francisco Carvalho
	@since 18/11/2025
/*/
Method GetMessageId() Class OFSoWorkOrderPartsLockInDbsMessage
	if valtype(self:cMessageId) == "U"
		self:cMessageId := "work-order-" + FWUUIDV4(.T.)
	endif
return self:cMessageId