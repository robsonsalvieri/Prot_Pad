#include "tlpp-core.th"
#include "totvs.ch"
#INCLUDE "FWMVCDEF.CH"


/*/{Protheus.doc} OFSoService
	Classe com os dados de Serviços (Service) para comunicação com o Blackbird
	@type function
	@author Iury Soares Azevedo
	@since 16/10/2025
/*/
class OFSoService from VERegistroSql
	Public Method New()
	Public Method ToJson()
	Public Method GetRefId()
	Public Method Fill()
	Public Method FindByRecnoDel()
	Public Method DocVersion()
end class


/*/{Protheus.doc} New 
	Construtor basico
	@type function
	@author Iury Soares Azevedo
	@since 16/10/2025
/*/
method New() class OFSoService
	_Super:New('VO6')

	::AddFields({"R_E_C_N_O_", "VO6_BBRFID", "VO6_DESABR","VO6_DESSER" })

	::SetPKField("VO6_BBRFID")

return self


/*/{Protheus.doc} FindByRecnoDel
	Busca pelo recno

	@type function
	@author Iury Soares Azevedo
	@since 16/10/2025
/*/
Method FindByRecnoDel(nRecno) Class OFSoService
	self:Select();
		:_From(self:cAlias);
		:AndEq('R_E_C_N_O_', nRecno)

	// busca primeiro registro
	oReg := self:First()

	// limpa a query interna
	self:Clear()
Return oReg

/*/{Protheus.doc} GetRefId
	Retorna o reference id para usar no SO

	@type function
	@author Iury Soares Azevedo
	@since 16/10/2025
/*/
Method GetRefId() Class OFSoService
Return self:Get("VO6_REFID")


/*/{Protheus.doc} ToJson
	Retorna um JSON para enviar a API
	@type function
	@author Iury Soares Azevedo
	@since 16/10/2025
/*/
Method ToJson(cOperation) Class OFSoService
	local jJson := JsonObject():New()
	
	jJson["referenceId"] := self:Get("VO6_BBRFID")
	jJson["name"] := self:Get("VO6_DESABR")
	jJson["description"] := self:Get("VO6_DESSER")
	jJson["type"] := "Sundry"
	jJson["group"] := "E01"
	jJson["company"] := "John Deere"
	jJson["location"] := "L01"
	jJson["department"] := "Shoes"
	jJson["accountNumber"] := "1234"
	jJson["subAccountNumber"] := "5678"
	jJson["taxCategory"] := "AlwayTax"
	jJson["taxRegionReferenceId"] := "TR-REF-ID-001"
	jJson["regulatoryUnitsReferenceId"] := "RU-REF-ID-001"
	jJson["satCodeReferenceId"] := "SAT-REF-ID-001
	
Return jJson

/*/{Protheus.doc} DocVersion
	Versão da documentação utlizada na integracao
	@type method
	@author Iury Soares Azevedo
	@since 27/08/2025
/*/
Method DocVersion() class OFSoService
Return "1.0.13"
