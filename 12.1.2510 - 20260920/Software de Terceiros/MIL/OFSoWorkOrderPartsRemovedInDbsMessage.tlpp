#include "tlpp-core.th"
#include 'totvs.ch'


/*/{Protheus.doc} OFSoWorkOrderPartsRemovedInDbsMessage
	Classe que representa uma mensagem da entidade Parts mensagem RemovedInDbs
	
	@type class
	@author Iury Soares Azevedo
	@since 24/11/2025
/*/
Class OFSoWorkOrderPartsRemovedInDbsMessage

	public data cName
	public data oSoRequest
	data aWOParts
	data cMessageId
	data cMsgVX5
	data cOriId
	data cOperation
	data OFSoWorkOrder

	public Method New() CONSTRUCTOR
	public Method GetMessageId()
	public Method Send()
	public Method GetBody()
	public Method GetHeader()
	public Method Delay()

EndClass


/*/{Protheus.doc} New
	Construtor Simples

	@type method
	@author Iury Soares Azevedo
	@since 24/11/2025
/*/
Method New(aWOParts, OFSoWorkOrder) Class OFSoWorkOrderPartsRemovedInDbsMessage

	::cName := "WorkOrderPartsRemovedInDbs"
	::oSoRequest := OFSoRequest():New(self)

	::oSoRequest:Set("VK5_ORITAB", "VSJ")
	::oSoRequest:Set("VK5_MESSAG", "30")

	::aWOParts := aWOParts
	::OFSoWorkOrder := OFSoWorkOrder

Return SELF





/*/{Protheus.doc} GetMessageId
	Retorna o nome da mensagem para ser enviada ao SO

	@type method
	@author Iury Soares Azevedo
	@since 24/11/2025
/*/
Method GetMessageId() Class OFSoWorkOrderPartsRemovedInDbsMessage
	if valtype(self:cMessageId) == "U"
		self:cMessageId := "work-order-" + FWUUIDV4(.T.)
	endif
return self:cMessageId


/*/{Protheus.doc} GetBody
	Retorna o body para a mensagem

	@type method
	@author Iury Soares Azevedo
	@since 24/11/2025
/*/
Method GetBody() Class OFSoWorkOrderPartsRemovedInDbsMessage
	Local jBody as json
	Local nX as Numeric
	Local aJSParts := {} as array

	//Aqui traz o cabecalho da OS para formato json
	jBody := self:OFSoWorkOrder:ToJson(.F.)

	//transforma array de objetos OFSoWorkOrderParts em array de json
	For nX := 1 to len(self:aWOParts)
		aadd(aJSParts,self:aWOParts[nX]:ToJsonApi())
	Next nX

	jBody["parts"] := aJSParts

	oReqBody := OFSoRequestBody():New()
	oReqBody:SetData(jBody)
	oReqBody:SetName(self:cName)

Return oReqBody


/*/{Protheus.doc} GetHeader
	Retorna o header da mensagem

	@type method
	@author Iury Soares Azevedo
	@since 24/11/2025
/*/


Method GetHeader() Class OFSoWorkOrderPartsRemovedInDbsMessage
Return self:oSoRequest:GetHeader()


/*/{Protheus.doc} Send
	Envia mensagem para SO

	@type method
	@author Iury Soares Azevedo
	@since 24/11/2025
/*/
Method Send() Class OFSoWorkOrderPartsRemovedInDbsMessage
	local oComm := OFSoCommunication():New()
	self:oSoRequest:SetBody(self:GetBody())
	self:oSoRequest:Save()
	jResp := oComm:SendMessage(self, self:oSoRequest)
	//if jResp["code"] == oComm:nCodigoFalhaComunicacao
	//	self:Delay() // atrasa para tentar mais tarde
	//endif
Return


/*/{Protheus.doc} Delay
	atrasa a mensagem por falha de comunicação

	@type method
	@author Iury Soares Azevedo
	@since 24/11/2025
/*/
Method Delay() Class OFSoWorkOrderPartsRemovedInDbsMessage
	Local oMsg := OFDMSExitMessage():New()
	local oJson := JsonObject():New()
	self:oSoRequest:Save()
	oJson['header'] := self:oSoRequest:GetHeader():ToJson()
	oJson['body'] := self:oSoRequest:GetBody():ToJson()
	oMsg:Set("VK6_PAYLOA", oJson:toJson())
	oMsg:Set("VK6_MSGNAM", OFDMSMessageConstants():WorkOrderPartsSuppliedInDbsMessageName())
	oMsg:Set("VK6_CODVK5", self:oSoRequest:GetId())
	oMsg:SetAtrasada()
Return oMsg:Save()
