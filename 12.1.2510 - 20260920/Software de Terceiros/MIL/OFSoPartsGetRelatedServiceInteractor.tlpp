#include 'totvs.ch'
#Include "FWMVCDEF.CH"
//#include "OFSoPartsGetRelatedServiceInteractor.ch"

#DEFINE STR0001 "Invalid body data, please check makeReferenceId"


/*/{Protheus.doc} OFSoPartsGetRelatedInteractor
	Classe que vai tratar a criacao de modelos no field service
	
	@type class
	@author Vinicius Gati
	@since 29/09/2022
/*/
Class OFSoPartsGetRelatedInteractor 
	Public Method New() CONSTRUCTOR
	Public Method Process()
EndClass

/*/{Protheus.doc} New
	Construtor Simples

	@type method
	@author Vinicius Gati
	@since 29/09/2022
/*/
Method New() Class OFSoPartsGetRelatedInteractor
Return SELF

/*/{Protheus.doc} Process
	processa a criacao
	@type method
	@author Vinicius Gati
	@since 29/09/2022
/*/
Method Process(jSoRequestBody) Class OFSoPartsGetRelatedInteractor
	local jBody := jSoRequestBody:jBody
	local cPartNumber := ""
	local jRet as json

	if jBody:HasProperty("data") .AND. jBody["data"]:HasProperty("partNumber")
		cPartNumber := jBody["data"]["partNumber"]
	endif

	SB1->(dbSelectArea("SB1"))
	SB1->(dbSetOrder(1))
	
	SB2->(dbSelectArea("SB2"))
	SB2->(dbSetOrder(2))

	//Pergunta usada para trazer parametros de busca de estoque
	Pergunte("MTA260",.F.)

	if empty(cPartNumber) .OR. !SB1->(MsSeek(xFilial("SB1")+cPartNumber))
		jRet :=  OFSoRestErrorResponse():BadRequest("PartsGetRelated", 0, STR0001, "")	// "Invalid body data, please check makeReferenceId"
	Else
		jRet := OFSoResponseBody():New(200, jSoRequestBody, GetData(cPartNumber))
	endif
	
return jRet


/*/{Protheus.doc} GtData
	Efetua a construcao do json de retorno
	@type method
	@author Iury Soares Azevedo
	@since 15/05/2025
/*/
Static Function GetData(cPartNumber)
	local jRet := JsonObject():New() as json
	Local cAlias := GetNextAlias() as character

	Private oLocation := OFSoLocation():New(cEmpAnt, cFilAnt) as object
	Private oFSoFranchise := oFSoFranchise():New() as object

	BeginSql Alias cAlias
		SELECT
			B1_COD, B1_DESC, B1_GRUPO, B1_PRV1,  SB2.R_E_C_N_O_ B2RECNO
		FROM
			%Table:SB1% SB1
		LEFT JOIN 
			%Table:SB2% SB2 
		ON 
			SB2.%NotDel%
			AND SB2.B2_FILIAL = %xfilial:SB2% 
			AND SB2.B2_COD = SB1.B1_COD 
			AND SB2.B2_LOCAL = SB1.B1_LOCPAD
		WHERE
			SB1.%notDel%
			AND B1_FILIAL = %xfilial:SB1%
			AND B1_COD = %Exp:cPartNumber%
	EndSql

	jRet := ProForJson(cAlias)
	
	(cAlias)->(DbCloseArea())

	jRet["related"] := GetRelated(cPartNumber)
	jRet["alternate"] := GetAternate(cPartNumber)
	jRet["substitute"] := GetSubstitute(cPartNumber)

Return jRet

/*/{Protheus.doc} GetRelated
	Busca os itens relacionados
	@type method
	@author Iury Soares Azevedo
	@since 15/05/2025
/*/
Static Function GetRelated(cPartNumber)
	local aRet := {} as array
	local cAlias := GetNextAlias() as character
	local jItem as json

	BeginSql Alias cAlias
		SELECT
			B1_COD, B1_DESC, B1_GRUPO, B1_PRV1, SB2.R_E_C_N_O_ B2RECNO
		FROM
			%Table:VPD% VPD
		JOIN
			%Table:SB1% SB1
		ON
			SB1.%notDel%
			AND B1_FILIAL = %xfilial:SB1%
			AND B1_COD = VPD_CODREL
		LEFT JOIN 
			%Table:SB2% SB2 
		ON 
			SB2.%NotDel%
			AND SB2.B2_FILIAL = %xfilial:SB2% 
			AND SB2.B2_COD = SB1.B1_COD 
			AND SB2.B2_LOCAL = SB1.B1_LOCPAD
		WHERE
			VPD.%notDel%
			AND VPD_FILIAL = %xfilial:VPD%
			AND VPD_COD = %Exp:cPartNumber%
	EndSql	

	While (cAlias)->(!EOF())
		jItem := ProForJson(cAlias)
		jItem["quantityPerPrimary"] := 0
		jItem["isMandatory"] := .t.

		aadd(aRet,jItem)
		(cAlias)->(dbSkip())
	EndDo

	(cAlias)->(DbCloseArea())
Return aRet

/*/{Protheus.doc} GetAternate
	Busca os itens alternativos
	@type method
	@author Iury Soares Azevedo
	@since 15/05/2025
/*/
Static Function GetAternate(cPartNumber)
	local aRet := {} as Array
	local cAlias := GetNextAlias() as character
	local jItem as json

	BeginSql Alias cAlias
		SELECT
			B1_COD, B1_DESC, B1_GRUPO, B1_PRV1, SB2.R_E_C_N_O_ B2RECNO
		FROM
			%Table:VB1% VB1
		JOIN
			%Table:SB1% SB1
		ON
			SB1.%notDel%
			AND B1_FILIAL = %xfilial:SB1%
			AND B1_COD = VB1_KEYALT
		LEFT JOIN 
			%Table:SB2% SB2 
		ON 
			SB2.%NotDel%
			AND SB2.B2_FILIAL = %xfilial:SB2% 
			AND SB2.B2_COD = SB1.B1_COD 
			AND SB2.B2_LOCAL = SB1.B1_LOCPAD
		WHERE
			VB1.%notDel%
			AND VB1_FILIAL = %xfilial:VB1%
			AND VB1_COD = %Exp:cPartNumber%
	EndSql	

	While (cAlias)->(!EOF())
		jItem := ProForJson(cAlias)
		jItem["quantityPerPrimary"] := 0

		aadd(aRet,jItem)
		(cAlias)->(dbSkip())
	EndDo

	(cAlias)->(DbCloseArea())
Return aRet
/*/{Protheus.doc} GetSubstitute
	Busca os itens substitutos
	@type method
	@author Iury Soares Azevedo
	@since 15/05/2025
/*/
Static Function GetSubstitute(cPartNumber)
	local aRet := {} as Array
	local cAlias := GetNextAlias() as character
	local jItem as json

	BeginSql Alias cAlias
		SELECT
			B1_COD, B1_DESC, B1_GRUPO, B1_PRV1, SB2.R_E_C_N_O_ B2RECNO
		FROM
			%Table:VE9% VE9
		JOIN
			%Table:SB1% SB1
		ON
			SB1.%notDel%
			AND B1_FILIAL = %xfilial:SB1%
			AND B1_COD = VE9_ITENOV
		LEFT JOIN 
			%Table:SB2% SB2 
		ON 
			SB2.%NotDel%
			AND SB2.B2_FILIAL = %xfilial:SB2% 
			AND SB2.B2_COD = SB1.B1_COD 
			AND SB2.B2_LOCAL = SB1.B1_LOCPAD
		WHERE
			VE9.%notDel%
			AND VE9_FILIAL = %xfilial:VE9%
			AND VE9_ITEANT = %Exp:cPartNumber%
	EndSql	

	While (cAlias)->(!EOF())
		jItem := ProForJson(cAlias)
		jItem["quantityPerPrimary"] := 0
		jItem["isMultiSub"] := .t.

		aadd(aRet,jItem)

		(cAlias)->(dbSkip())
	EndDo

	(cAlias)->(DbCloseArea())
Return aRet

/*/{Protheus.doc} ProForJson
	Converte o projeto para json
	@type method
	@author Iury Soares Azevedo
	@since 15/05/2025
/*/
Static Function ProForJson(cAlias)
	local jRet := JsonObject():New() as json
	Local nSB2Recno := &(cAlias + "->B2RECNO")


	jRet["partNumber"] := Alltrim(&(cAlias + "->B1_COD"))
	jRet["description"] := Alltrim(&(cAlias + "->B1_DESC"))
	jRet["itemType"] := "Part"
	jRet["partType"] := "RegularPart"
	jRet["locationReferenceId"] := oLocation:GetReferenceId()
	jRet["locationName"] := oLocation:GetName()
	
	oFSoFranchise := oFSoFranchise:FindByGroup(&(cAlias + "->B1_GRUPO"))
	
	If !Empty(oFSoFranchise) .AND. !Empty(oFSoFranchise:Get('VKB_REFID'))
		jRet["franchiseReferenceId"] := "FR-" + oFSoFranchise:Get('VKB_REFID')
		jRet["franchiseName"] := oFSoFranchise:Get('VKB_NOME')
	EndIf
	
	jRet["vendorReferenceId"] := Nil //""
	jRet["vendorName"] := Nil
	
	if nSB2Recno > 0
		SB2->(dbGoTo(nSB2Recno))
		jRet["binQuantity"] := SaldoMov(nil, nil, nil, If(mv_par03 == 1, .F., Nil), nil, nil, nil, nil)
	Else
		jRet["binQuantity"] := 0
	endif

	jRet["sellPrice"] := &(cAlias + "->B1_PRV1")
Return jRet

