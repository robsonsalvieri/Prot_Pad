#include "tlpp-core.th"
#include "totvs.ch"
#INCLUDE "FWMVCDEF.CH"

/*/{Protheus.doc} OFSoWorkOrderPartReturn
	Classe com os dados de Peças Devolvidas para comunicação com o Blackbird

	@type function
	@author Francisco Carvalho
	@since 18/07/2025
/*/
class OFSoWorkOrderPartReturn from VERegistroSql

	Public Method New()
	Public Method ToJsonApi()
	Public Method ToJson()
	Public Method FindByRecnoDel()
	Public Method GetRefId()

end class


/*/{Protheus.doc} New 
	Construtor basico

	@type function
	@author Francisco Carvalho
	@since 18/07/2025
/*/
method New() class OFSoWorkOrderPartReturn

	_Super:New('VO3')

	::AddFields({"R_E_C_N_O_","VO3_NUMDOC","VO3_CODITE,VO3_BBRFID"})
	::Join("VO2", "VO2", "VO2.VO2_FILIAL = VO3.VO3_FILIAL AND VO2.VO2_NUMOSV = VO3.VO3_NUMOSV AND VO2.VO2_NOSNUM = VO3.VO3_NOSNUM AND VO2.VO2_DEVOLU = '0' AND VO2.D_E_L_E_T_ = ' '")

return self


/*/{Protheus.doc} FindByRecnoDel
	Busca pelo recno

	@type function
	@author Francisco Carvalho
	@since 18/07/2025
/*/
Method FindByRecnoDel(nRecno) Class OFSoWorkOrderPartReturn
	self:Select();
		:_From(self:cAlias);
		:AndEq('R_E_C_N_O_', nRecno)

	// busca primeiro registro
	oReg := self:First()

	// limpa a query interna
	self:Clear()
Return oReg



/*/{Protheus.doc} ToJson
	Retorna um json object

	@type method
	@author Francisco Carvalho
	@since 18/07/2025
/*/
Method ToJson() Class OFSoWorkOrderPartReturn
Return self:ToJsonApi()


/*/{Protheus.doc} ToJsonApi
	Retorna um JSON para enviar a API

	@type Class
	@author Francisco Carvalho
	@since 18/07/2025
/*/
Method ToJsonApi() Class OFSoWorkOrderPartReturn
	Local jRet := JsonObject():New() as json

	jRet["partReturnReferenceId"] := FGX_SetVlJson( self:Get("VO3_BBRFID"), .f.)
	jRet["status"] := "Complete"

Return jRet

