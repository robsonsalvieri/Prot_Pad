#include "tlpp-core.th"
#include 'totvs.ch'


/*/{Protheus.doc} OFSoWorkOrderPartReturnUpdatedInDbsMessage
	Classe que representa uma mensagem da entidade Parts mensagem ReturnUpdatedInDbs
	
	@type class
	@author Francisco Carvalho
	@since 16/07/2025
/*/
Class OFSoWorkOrderPartReturnUpdatedInDbsMessage

	public data cName
	public data oSoRequest
	data oWOParts
	data cMessageId
	data cMsgVX5
	data cOriId
	data cOperation

	public Method New() CONSTRUCTOR
	public Method GetMessageId()
	public Method SetWOParts()
	public Method Send()
	public Method GetBody()
	public Method GetHeader()
	public Method Delay()

EndClass


/*/{Protheus.doc} New
	Construtor Simples

	@type method
	@author Francisco Carvalho
	@since 16/07/2025
/*/
Method New(oWOParts) Class OFSoWorkOrderPartReturnUpdatedInDbsMessage

	::cName := "WorkOrderPartReturnUpdatedInDbs"
	::oSoRequest := OFSoRequest():New(self)

	::oSoRequest:Set("VK5_ORITAB", "VSJ")
	::oSoRequest:Set("VK5_MESSAG", "30")

	if valtype(oWOParts) != "U"
		::SetWOParts(oWOParts)
	endif

Return SELF


/*/{Protheus.doc} SetWOParts
	Seta a WorkOrder que gerará o body da mensagem

	@type method
	@author Francisco Carvalho
	@since 16/07/2025
/*/
Method SetWOParts(oWOParts as object) Class OFSoWorkOrderPartReturnUpdatedInDbsMessage
	self:oWOParts := oWOParts
	self:oSoRequest:SetBody(self:GetBody())

	self:oSoRequest:Set("VK5_ORIKEY", self:oWOParts:Get("VSJ_BBRFID"))

Return .t.


/*/{Protheus.doc} GetMessageId
	Retorna o nome da mensagem para ser enviada ao SO

	@type method
	@author Francisco Carvalho
	@since 16/07/2025
/*/
Method GetMessageId() Class OFSoWorkOrderPartReturnUpdatedInDbsMessage
	if valtype(self:cMessageId) == "U"
		self:cMessageId := "work-order-" + FWUUIDV4(.T.)
	endif
return self:cMessageId


/*/{Protheus.doc} GetBody
	Retorna o body para a mensagem

	@type method
	@author Francisco Carvalho
	@since 16/07/2025
/*/
Method GetBody() Class OFSoWorkOrderPartReturnUpdatedInDbsMessage

	Local oReqBody := OFSoRequestBody():New()
	
	oReqBody:SetData(self:oWOParts:toJson())
	oReqBody:SetName(self:cName)

Return oReqBody


/*/{Protheus.doc} GetHeader
	Retorna o header da mensagem

	@type method
	@author Francisco Carvalho
	@since 16/07/2025
/*/


Method GetHeader() Class OFSoWorkOrderPartReturnUpdatedInDbsMessage
Return self:oSoRequest:GetHeader()


/*/{Protheus.doc} Send
	Envia mensagem para SO

	@type method
	@author Francisco Carvalho
	@since 16/07/2025
/*/
Method Send() Class OFSoWorkOrderPartReturnUpdatedInDbsMessage
	local oComm := OFSoCommunication():New()
	self:oSoRequest:SetBody(self:GetBody())
	self:oSoRequest:Save()
	jResp := oComm:SendMessage(self, self:oSoRequest)
	//if jResp["code"] == oComm:nCodigoFalhaComunicacao
	//	self:Delay() // atrasa para tentar mais tarde
	//endif
Return


/*/{Protheus.doc} Delay
	atrasa a mensagem por falha de comunicação

	@type method
	@author Francisco Carvalho
	@since 16/07/2025
/*/
Method Delay() Class OFSoWorkOrderPartReturnUpdatedInDbsMessage
	Local oMsg := OFDMSExitMessage():New()
	local oJson := JsonObject():New()
	self:oSoRequest:Save()
	oJson['header'] := self:oSoRequest:GetHeader():ToJson()
	oJson['body'] := self:oSoRequest:GetBody():ToJson()
	oMsg:Set("VK6_PAYLOA", oJson:toJson())
	oMsg:Set("VK6_MSGNAM", OFDMSMessageConstants():WorkOrderPartReturnUpdatedInDbsMessageName())
	oMsg:Set("VK6_CODVK5", self:oSoRequest:GetId())
	oMsg:SetAtrasada()
Return oMsg:Save()
