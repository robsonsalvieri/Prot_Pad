#include "tlpp-core.th"
#include 'totvs.ch'

/*/{Protheus.doc} OFSoLocationContractCreatedInDbsMessage
	Classe que representa uma mensagem da entidade Contact mensagem CreatedInDbs
	
	@type class
	@author Vinicius Gati
	@since 09/08/2021
/*/
Class OFSoLocationContractCreatedInDbsMessage
	public data cName
	public data oSoRequest

	data oSoLocationContract
	data cMessageId
	data cMsgVX5
	data cOriId

	public Method New() CONSTRUCTOR
	public Method GetMessageId()
	public Method SetLocationContract()
	public Method Send()
	public Method GetBody()
	public Method GetHeader()
	public Method Delay()
EndClass

/*/{Protheus.doc} New
	Construtor Simples

	@type method
	@author Vinicius Gati
	@since 09/08/2021
/*/
Method New(oLocContract) Class OFSoLocationContractCreatedInDbsMessage
	::cName := "LocationContractCreatedInDbs"
	::oSoRequest := OFSoRequest():New(self)

	::oSoRequest:Set("VK5_ORITAB", "SM0")
	::oSoRequest:Set("VK5_MESSAG", "29")

	if valtype(oLocContract) != "U"
		::SetLocationContract(oLocContract)
	endif
Return SELF

/*/{Protheus.doc} SetLocationContract
	Seta o Contact que gerará o body da mensagem

	@type method
	@author Vinicius Gati
	@since 10/08/2021
/*/
Method SetLocationContract(oSoLocationContract) Class OFSoLocationContractCreatedInDbsMessage
	self:oSoLocationContract := oSoLocationContract
	self:oSoRequest:SetBody(self:GetBody())

	self:oSoRequest:Set("VK5_ORIKEY", self:oSoLocationContract:GetRefId())

Return .t.

/*/{Protheus.doc} GetMessageId
	Retorna o nome da mensagem para ser enviada ao SO onde necessário

	@type method
	@author Vinicius Gati
	@since 09/08/2021
/*/
Method GetMessageId() Class OFSoLocationContractCreatedInDbsMessage
	if valtype(self:cMessageId) == "U"
		self:cMessageId := "location-contract" + FWUUIDV4(.t.)
	endif
return self:cMessageId

/*/{Protheus.doc} GetBody
	Retorna o body para a mensagem

	@type method
	@author Vinicius Gati
	@since 12/08/2021
/*/
Method GetBody() Class OFSoLocationContractCreatedInDbsMessage
	oReqBody := OFSoRequestBody():New()
	oReqBody:SetData(self:oSoLocationContract:toJson())
	oReqBody:SetName(self:cName)
Return oReqBody

/*/{Protheus.doc} GetHeader
	Retorna o header da mensagem

	@type method
	@author Vinicius Gati
	@since 12/08/2021
/*/
Method GetHeader() Class OFSoLocationContractCreatedInDbsMessage
Return self:oSoRequest:GetHeader()

/*/{Protheus.doc} Send
	Envia mensagem para SO

	@type method
	@author Vinicius Gati
	@since 12/08/2021
/*/
Method Send() Class OFSoLocationContractCreatedInDbsMessage
	local oComm := OFSoCommunication():New()
	self:oSoRequest:SetBody(self:GetBody())
	self:oSoRequest:Save()

	jResp := oComm:SendMessage(self, self:oSoRequest)
	
Return 

/*/{Protheus.doc} Delay
	atrasa a mensagem por falha de comunicação

	@type method
	@author Vinicius Gati
	@since 19/10/2021
/*/
Method Delay() Class OFSoLocationContractCreatedInDbsMessage
	Local oMsg := OFDMSExitMessage():New()
	local oJson := JsonObject():New()
	self:oSoRequest:Save()
	oJson['header'] := self:oSoRequest:GetHeader():ToJson()
	oJson['body'] := self:oSoRequest:GetBody():ToJson()
	oMsg:Set("VK6_PAYLOA", oJson:toJson())
	oMsg:Set("VK6_MSGNAM", OFDMSMessageConstants():LocationContractCreatedInDbsMessageName())
	oMsg:Set("VK6_CODVK5", self:oSoRequest:GetId())
	oMsg:SetAtrasada()
Return oMsg:Save()
