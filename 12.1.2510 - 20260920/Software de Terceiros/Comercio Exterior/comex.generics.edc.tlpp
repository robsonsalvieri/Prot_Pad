/*/{Protheus.doc} GetDescAtoGenerico
   Função que retorna a descrição do tipo de ato concessório

   @type  Function
   @author user
   @since 08/07/2026
   @version version
   @param param_name, param_type, param_descr
   @return return_var, return_type, return_description
   @example
   (examples)
   @see (links_or_references)
/*/
function GetDescAtoGenerico(cTipoAto as character) as character
    local cDescAto as character

    default cTipoAto := ED0->ED0_TIPOAC

    cDescAto := ""
    do case
        case cTipoAto == "01"
            cDescAto := STR0001 // "Comum"
        case cTipoAto == "02"
            cDescAto := STR0002 // "Intermediário"
        case cTipoAto == "03"
            cDescAto := STR0003 // "Solidário"
        case cTipoAto == "04"
            cDescAto := STR0004 // "Embarcação"
        case cTipoAto == "05"
            cDescAto := STR0005 // "Fornecimento no Mercado Interno"
        case cTipoAto == "06"
            cDescAto := STR0006 // "Genérico"
        case cTipoAto == "07"
            cDescAto := STR0007 // "Genérico/Intermediário"
        case cTipoAto == "08"
            cDescAto := STR0008 // "Genérico/Embarcação"
        case cTipoAto == "09"
            cDescAto := STR0009 // "Genérico/Fornec. Mercado Interno"
    endcase

return cDescAto

/*/{Protheus.doc} IsAtoGenerico
   Função que retornar se tipo de ato concessório é genérico ou não

   @type  Function
   @author user
   @since 08/07/2026
   @version version
   @param param_name, param_type, param_descr
   @return return_var, return_type, return_description
   @example
   (examples)
   @see (links_or_references)
/*/
function IsAtoGenerico(cTipoAto as character) as logical
    local lAtoGenerico as logical

    default cTipoAto := ED0->ED0_TIPOAC

    // "06" - "Genérico"
    // "07" - "Genérico/Intermediário" - Não foi adicionado - work item 5580940 - DTRADE-12758 (criado essa opção no Pacote: 017530 - Tipo de Ato Concessório / Issue: DTRADE-12691)
    // "08" - "Genérico/Embarcação"
    // "09" - "Genérico/Fornec. Mercado Interno" - Não foi adicionado - work item 5580940 - DTRADE-12758
    lAtoGenerico := cTipoAto == "06" .or. cTipoAto == "08"

return lAtoGenerico
