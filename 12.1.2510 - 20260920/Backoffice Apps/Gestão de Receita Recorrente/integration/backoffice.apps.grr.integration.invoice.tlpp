#include "totvs.ch"
#include "tlpp-rest.th"
#include "tlpp-core.th"

namespace totvs.protheus.backoffice.apps.grr.integration.invoice

static _isGrActive := Nil
static _existsIsGRRPaymentFunction := Nil
static _existsGRRA050Function := Nil
static _existsGRRI050Function := Nil
static _existsGRRI050AFunction := Nil

//------------------------------------------------------------------
/*/{Protheus.doc} InvoiceIntegration
    @description Classe com implementações de processamento para outros módulos.
    @author claudio.yoshio@totvs.com.br
    @since 11/02/2026
    @version 12.1.2510
*/
//------------------------------------------------------------------
class InvoiceIntegration
    static method process()
    static method getInvoiceInstallmentsBySalesOrder(cSalesOrderBranch as character, cSalesOrderNumber as character) as json
endClass

//------------------------------------------------------------------
/*/{Protheus.doc} process
    @description Realiza o processamento da integração da invoice
    @type method
    @author claudio.yoshio@totvs.com.br
	@since 11/02/2026
    @version 12.1.2510
/*/
//------------------------------------------------------------------
method process() class InvoiceIntegration
    if _isGrActive == Nil
        _isGrActive := (getRpoRelease() >= "12.1.2410" .or. findFunction( "GRRIsActive" )) .and. GRRIsActive()
    endIf

    if _existsIsGRRPaymentFunction == Nil
        _existsIsGRRPaymentFunction := getRpoRelease() >= "12.1.2410" .or. findFunction( "IsGRRPayment" )
    endIf

    if _existsGRRA050Function == Nil
        _existsGRRA050Function := getRpoRelease() >= "12.1.2410" .or. findFunction( "GRRA050" )
    endIf

    if _existsGRRI050Function == Nil
        _existsGRRI050Function := getRpoRelease() >= "12.1.2410" .or. findFunction( "GRRI050" )
    endIf

    if _existsGRRI050AFunction == Nil
        _existsGRRI050AFunction := getRpoRelease() >= "12.1.2410" .or. findFunction( "GRRI050A" )
    endIf
    
    if _isGrActive .and. _existsIsGRRPaymentFunction .and. IsGRRPayment(SC5->C5_CONDPAG)
        // Fluxo para pedidos gerados direto pelo Faturamento
        if empty(SC5->C5_MDCONTR)
            // Cria a relação entre o pedido e o plano GR
            If _existsGRRA050Function
                GRRA050({ xFilial( "SC5" ), "SC5", "MATA410", SC5->C5_NUM, xFilial( "HRD" ), M->HRD_CODE, M->HRD_PAYMET })
            EndIf

            // Envia o pedido de criação da subscrição na plataforma
            If SC5->C5_LIBEROK == 'S' .and. _existsGRRI050Function
                GRRI050({ SC5->C5_FILIAL, SC5->C5_NUM })
            EndIf

        // Fluxo para pedidos gerados pelo Contrato ( GCT )
        elseif SC5->C5_LIBEROK == 'S' .and. _existsGRRI050AFunction
            GRRI050A({ SC5->C5_FILIAL, SC5->C5_MDCONTR, '', SC5->C5_MDPLANI, SC5->C5_MDNUMED, SC5->C5_NUM })
        endIf
    endIf
return

//------------------------------------------------------------------
/*/{Protheus.doc} getInvoiceInstallmentsBySalesOrder
    @description Busca os títulos através dos dados do Pedido de Venda
    @type method
    @author claudio.yoshio@totvs.com.br
	@since 13/05/2026
    @version 12.1.2410
/*/
//-------------------------------------------------------------------
method getInvoiceInstallmentsBySalesOrder(cSalesOrderBranch as character, cSalesOrderNumber as character) as json class InvoiceIntegration
    local aArea := getArea() as array
    local cQuery as character
    local cAlias as character
    local jInstallment := JsonObject():new() as json
    local nParamOrder := 1 as numeric
    local oExecInstallment as object

    cQuery := "SELECT E1_FILIAL, E1_PREFIXO, E1_NUM, E1_PARCELA, E1_TIPO, E1_VALOR, E1_VENCTO, FK7_IDDOC "
    cQuery += "FROM " + RetSQLName( "SE1" ) + " SE1 "
    
    cQuery += "INNER JOIN " + RetSQLName( "SC5" ) + " SC5 "
    cQuery += "ON SC5.C5_FILIAL = ? "
    cQuery += "AND SC5.C5_NUM = SE1.E1_PEDIDO "
    cQuery += "AND SC5.C5_LIBEROK = ? "
    cQuery += "AND SC5.D_E_L_E_T_= ? "
    
    cQuery += "INNER JOIN " + RetSQLName( "SF2" ) + " SF2 "
    cQuery += "ON SF2.F2_FILIAL = ? "
    cQuery += "AND SF2.F2_DOC = SC5.C5_NOTA  "
    cQuery += "AND SF2.F2_SERIE = SC5.C5_SERIE "
    cQuery += "AND SF2.D_E_L_E_T_= ? "
    
    cQuery += "INNER JOIN " + RetSQLName( "FK7" ) + " FK7 "
    cQuery += "ON FK7.FK7_FILIAL = SE1.E1_FILIAL "
    cQuery += "AND FK7.FK7_ALIAS = ? "
    cQuery += "AND FK7.FK7_PREFIX = SE1.E1_PREFIXO "
    cQuery += "AND FK7.FK7_NUM = SE1.E1_NUM "
    cQuery += "AND FK7.FK7_PARCEL = SE1.E1_PARCELA "
    cQuery += "AND FK7.FK7_TIPO = SE1.E1_TIPO "
    cQuery += "AND FK7.D_E_L_E_T_ = ? "

    cQuery += "WHERE SE1.E1_FILIAL = ? "
    cQuery += "AND SE1.E1_PEDIDO = ? "
    cQuery += "AND SE1.D_E_L_E_T_= ? "

    oExecInstallment := FWExecStatement():new(changeQuery(cQuery))

    oExecInstallment:setString(nParamOrder++, cSalesOrderBranch)
    oExecInstallment:setString(nParamOrder++, "S")
    oExecInstallment:setString(nParamOrder++, " ")
    oExecInstallment:setString(nParamOrder++, xFilial("SF2"))
    oExecInstallment:setString(nParamOrder++, " ")
    oExecInstallment:setString(nParamOrder++, "SE1")
    oExecInstallment:setString(nParamOrder++, " ")
    oExecInstallment:setString(nParamOrder++, xFilial("SE1"))
    oExecInstallment:setString(nParamOrder++, cSalesOrderNumber)
    oExecInstallment:setString(nParamOrder++, " ")
    cAlias := oExecInstallment:openAlias()

    if (cAlias)->(!eof())
        jInstallment['branch'] := (cAlias)->E1_FILIAL
        jInstallment['prefix'] := (cAlias)->E1_PREFIXO
        jInstallment['number'] := (cAlias)->E1_NUM
        jInstallment['installment'] := (cAlias)->E1_PARCELA
        jInstallment['type'] := (cAlias)->E1_TIPO
        jInstallment['amount'] := (cAlias)->E1_VALOR
        jInstallment['dueDate'] := (cAlias)->E1_VENCTO
        jInstallment['idDoc'] := (cAlias)->FK7_IDDOC
    endIf

    (cAlias)->(dbCloseArea())

    restArea(aArea)
    
    aSize(aArea, 0)
    aArea := Nil
return jInstallment
