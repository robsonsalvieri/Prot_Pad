//------------------------------------------------------------------
/*/{Protheus.doc} process
Método responsável pelo processamento da Tool

@type   method
@author Abner Fogaça de Oliveira
@since  04/05/2026
@param  jPayLoad, json, Objeto JSON contendo os parâmetros de entrada da Tool
@return json, Objeto JSON contendo o resultado do processamento da Tool
@obs: Exemplo de uso: Analise o caso 000033 do cliente 00000200
/*/
//-------------------------------------------------------------------
method process(jPayLoad as json) as json class atualizafilaauditor
Local jResp          := JsonObject():New() as Json
Local aArea          as array
Local aError         := {} as array
Local cErrorMsg      as character
Local crequestid     as character
Local cresult_audit  as character
Local lHasOccurrence as logical
Local oModel         as object

	If jPayLoad:hasProperty("request_id") .And. jPayLoad:hasProperty("result_audit") .And. FWAliasInDic("OIE")
		aArea         := GetArea()
		crequestid    := AllTrim(jPayLoad["request_id"])
		cresult_audit := jPayLoad["result_audit"]:toJson() // Serializa o JSON para string, mantendo a formatação original, incluindo emojis e caracteres especiais.
		
		dbSelectArea("OIE")
		OIE->(dbSetOrder(3)) // OIE_FILIAL + OIE_TRACE

		If OIE->(dbSeek(xFilial("OIE") + crequestid))
			oModel := FWLoadModel("totvs.protheus.legal.requisicaoAgente.JURA320")
			oModel:SetOperation(4)
			oModel:Activate()

			If oModel:GetValue("OIEMASTER", "OIE_STATUS") == "1"// 1=Pendente;2=Concluído
				oModel:SetValue("OIEMASTER", "OIE_STATUS", "2")
				oModel:SetValue("OIEMASTER", "OIE_CONTEN", IIf(Valtype(DecodeUTF8(SanitizeUTF8Emoji(cresult_audit))) == "C", DecodeUTF8(SanitizeUTF8Emoji(cresult_audit)), SanitizeUTF8Emoji(cresult_audit))) // Armazena o resultado do agente auditor, decodificando a string UTF-8 para CP-1252 removendo possíveis emojis e caracteres especials.
				If jPayLoad:hasProperty("has_occurrence")
					lHasOccurrence := jPayLoad["has_occurrence"] == .T.
					oModel:SetValue("OIEMASTER", "OIE_SITUAC", IIf(lHasOccurrence, "1", "2")) // 1=Com inconsistência; 2=Sem inconsistência
				EndIf
				If oModel:VldData() .And. oModel:CommitData()
					jResp["result"] := JConvUTF8(STR0002) // "Registro atualizado na fila."
				Else
					aError := oModel:GetErrorMessage()
					cErrorMsg := IIf(Len(aError) >= 6, aError[6], "")
					jResp["error"] := JsonObject():new()
					jResp["error"]["message"] := STR0003 + cErrorMsg // "Nao foi possivel alterar a fila.Erro: "
				EndIf
			Else
				jResp["result"] := JConvUTF8(STR0004) // "O registro na fila já foi processado."
			Endif

			oModel:DeActivate()
			oModel:Destroy()
		Else
			jResp["error"] := JsonObject():new()
			jResp["error"]["message"] := STR0005 // "Registro nao foi localizado na fila."
		EndIf
		RestArea(aArea)
	Else
		jResp["error"] := JsonObject():new()
		jResp["error"]["message"] := STR0006 // "request_id nao informado ou tabela OIE nao encontrada."
	EndIf

Return jResp

//------------------------------------------------------------------
/*/{Protheus.doc} SanitizeUTF8Emoji
Remove sequências UTF-8 de 4 bytes (emojis e caracteres fora do BMP Unicode)
da string antes de chamar DecodeUTF8, que suporta apenas até 3 bytes por caractere.

@type   staticfunction
@author Abner Fogaça de Oliveira
@since  04/05/2026
@param  cStr, character, String UTF-8 a ser sanitizada
@return character, String sem sequências de 4 bytes
/*/
//------------------------------------------------------------------
Static Function SanitizeUTF8Emoji(cStr as character) as character
Local cResult  := "" as character
Local nI       := 1  as integer
Local nByte    := 0  as integer
Local nLen     := 0  as integer

	nLen := Len(cStr)

	While nI <= nLen
		nByte := Asc(SubStr(cStr, nI, 1))
		If nByte >= 240 // Sequência de 4 bytes (emoji: U+10000 a U+10FFFF) — descarta
			nI := nI + 4
		ElseIf nByte >= 224 // Sequência de 3 bytes
			cResult := cResult + SubStr(cStr, nI, 3)
			nI := nI + 3
		ElseIf nByte >= 192 // Sequência de 2 bytes
			cResult := cResult + SubStr(cStr, nI, 2)
			nI := nI + 2
		Else // Byte ASCII (1 byte)
			cResult := cResult + SubStr(cStr, nI, 1)
			nI := nI + 1
		EndIf
	EndDo

Return cResult
