//------------------------------------------------------------------
/*/{Protheus.doc} getPayLoadSchema
Método responsável por informar o schema de entrada da Tool

@type   method
@author Abner Fogaça de Oliveira
@since  04/05/2026
@return json, Objeto JSON contendo o schema de entrada da Tool
/*/
//-------------------------------------------------------------------
method getPayLoadSchema() as json class atualizafilaauditor
Local jSchema := JsonObject():new()

	jSchema:FromJson(;
		'{'                                                                                                          +;
		'  "type" : "object",'                                                                                       +;
		'  "required" : [ "request_id", "has_occurrence", "result_audit", "context" ],'                              +;
		'  "properties" : {'                                                                                         +;
		'    "context" : {'                                                                                          +;
		'      "type" : "string",'                                                                                   +;
		'      "description" : "Contexto de empresa e filial a ser considerado no ERP."'                             +;
		'    },'                                                                                                     +;
		'    "request_id" : {'                                                                                       +;
		'      "type" : "string",'                                                                                   +;
		'      "description" : "ID da requisição que está sendo tratada."'                                           +;
		'    },'                                                                                                     +;
		'    "result_audit" : {'                                                                                     +;
		'      "type" : "object",'                                                                                   +;
		'      "required" : [ "status", "message", "results" ],'                                                     +;
		'      "properties" : {'                                                                                     +;
		'        "status" : {'                                                                                       +;
		'          "enum" : [ "OK", "FAIL" ],'                                                                       +;
		'          "type" : "string",'                                                                               +;
		'          "description" : "Status da validação do auditor"'                                                 +;
		'        },'                                                                                                 +;
		'        "message" : {'                                                                                      +;
		'          "type" : "string",'                                                                               +;
		'          "description" : "Resumo geral dos problemas encontrados em no máximo 2 linhas, ou confirmação de que nenhuma inconsistência foi identificada."' +;
		'        },'                                                                                                 +;
		'        "results" : {'                                                                                      +;
		'          "type" : "array",'                                                                                +;
		'          "items" : {'                                                                                      +;
		'            "type" : "object",'                                                                             +;
		'            "required" : [ "id", "rule", "desc", "reason" ],'                                               +;
		'            "properties" : {'                                                                               +;
		'              "id" : {'                                                                                     +;
		'                "type" : "string",'                                                                         +;
		'                "description" : "ID exato da regra violada (ex: R01, R03, U01)."'                           +;
		'              },'                                                                                           +;
		'              "desc" : {'                                                                                   +;
		'                "type" : "string",'                                                                         +;
		'                "description" : "Descrição/explicação formal da regra violada."'                             +;
		'              },'                                                                                           +;
		'              "rule" : {'                                                                                   +;
		'                "type" : "string",'                                                                         +;
		'                "description" : "Título da regra violada."'                                                 +;
		'              },'                                                                                           +;
		'              "reason" : {'                                                                                 +;
		'                "type" : "string",'                                                                         +;
		'                "description" : "Motivo do diagnóstico, especificando detalhadamente os campos e valores que causaram a infração."' +;
		'              }'                                                                                            +;
		'            }'                                                                                              +;
		'          },'                                                                                               +;
		'          "description" : "Lista de regras e violações encontradas."'                                       +;
		'        }'                                                                                                  +;
		'      },'                                                                                                   +;
		'      "description" : "Conteúdo do agente auditor de casos para ser atualizado na fila."'                   +;
		'    },'                                                                                                     +;
		'    "has_occurrence" : {'                                                                                   +;
		'      "type" : "boolean",'                                                                                   +;
		'      "description" : "Se \"true\" indica que o registro analisado possui inconsistência."'                 +;
		'    }'                                                                                                      +;
        '}' )

Return jSchema

//------------------------------------------------------------------
/*/{Protheus.doc} getReturnSchema
Método responsável por informar como será o schema de retorno da Tool

@type   method
@author Abner Fogaça de Oliveira
@since  04/05/2026
@return json, Objeto JSON contendo o schema de retorno da Tool
/*/
//-------------------------------------------------------------------
method getReturnSchema() as json class atualizafilaauditor
Local jSchema := JsonObject():new()

	jSchema:FromJson(;
		'{'                     +;
		'"type" : "object",'    +;
		'"required" : [ "result" ],' +;
		'"properties" : {' +;
		'	"result" : {' +;
		'	"type" : "string",' +;
		'	"description" : "Mensagem confirmando que o Protheus recebeu e processou a requisição com sucesso ou não"' +;
		'	}' +;
	'}')

return jSchema

