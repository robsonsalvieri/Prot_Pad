        '                "key" : {'                                                                       +;
        '                  "type" : "string",'                                                            +;
        '                  "description" : "Chave do registro concatenada estritamente conforme a key_structure (ex: filial + codigo)."' +;
        '                },'                                                                              +;
        '                "fields" : {'                                                                    +;
        '                  "type" : "array",'                                                             +;
        '                  "items" : {'                                                                   +;
        '                    "type" : "object",'                                                          +;
        '                    "required" : [ "field", "value" ],'                                          +;
        '                    "properties" : {'                                                            +;
        '                      "field" : {'                                                               +;
