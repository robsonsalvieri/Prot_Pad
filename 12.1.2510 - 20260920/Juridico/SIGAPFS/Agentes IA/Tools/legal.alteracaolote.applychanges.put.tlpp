    jSchema:FromJson(;
        '{'                                                                                              +;
        '  "type" : "object",'                                                                           +;
        '  "required" : [ "title", "changes" ],'                                                         +;
        '  "properties" : {'                                                                              +;
        '    "title" : {'                                                                                 +;
        '      "type" : "string",'                                                                        +;
