Metodo responsavel por informar como sera o schema de retorno da Tool

@return json, Schema de retorno da tool
/*/
//-------------------------------------------------------------------
method getReturnSchema() as json class apply_changes
	Local jSchema := JsonObject():new()

    jSchema:FromJson(;
        '{'                                                                                                          +;
        '  "type" : "object",'                                                                                       +;
        '  "required" : [ "resultado", "job_id" ],'                                                                  +;
        '  "properties" : {'                                                                                          +;
        '    "job_id" : {'                                                                                            +;
