#include "protheus.ch"
#include "fwmcptool.th"
#include "fwmvcdef.ch"
#include "topconn.ch"

namespace totvs.protheus.legal.alteracaolote

@FWToolMCP(action="put", erpRelease="12.1.2510", routine="applychanges", option=2, module="SIGAPFS", operation=4)
class apply_changes implements FWMCPTool
    public method new() as object
    public method getDescription() as character
    public method getNotes() as character
    public method getPayLoadSchema() as json
    public method getReturnSchema() as json
	public method getMetrics() as array
    public method process(jPayLoad as json) as json
endclass

method new() as object class apply_changes
return self

//------------------------------------------------------------------
/*/{Protheus.doc} getDescription
Informa a descrição da tool

@return character, descrição da tool
/*/
//-------------------------------------------------------------------
method getDescription() as character class apply_changes
return "Tool generica para alteracoes dinamicas em massa via MVC no padrao MCP."

//------------------------------------------------------------------
/*/{Protheus.doc} getNotes
Informa as notas adicionais sobre a tool

@return character, notas sobre a tool
/*/
//-------------------------------------------------------------------
method getNotes() as character class apply_changes
return "Envie o array 'changes' contendo os 'items' e um 'title'. A execucao grava na O17 com laudo detalhado."

//------------------------------------------------------------------
