        '                        "type" : "string",'                                                      +;
        '                        "description" : "O novo valor a ser injetado no campo."'                 +;
        '                      }'                                                                         +;
        '                    }'                                                                           +;
        '                  }'                                                                             +;
        '                }'                                                                               +;
        '              }'                                                                                 +;
        '            },'                                                                                  +;
        '            "description" : "Lista de registros e campos a serem processados."'                  +;
        '          },'                                                                                    +;
        '          "model" : {'                                                                           +;
        '            "type" : "string",'                                                                  +;
        '            "description" : "Codigo da rotina no ERP (Ex: JURA148)."'                           +;
        '          },'                                                                                    +;
        '          "table" : {'                                                                           +;
        '            "type" : "string",'                                                                  +;
        '            "description" : "Codigo da tabela vinculada ao submodelo (Ex: AC8)."'               +;
        '          },'                                                                                    +;
        '          "submodel" : {'                                                                        +;
        '            "type" : "string",'                                                                  +;
        '            "description" : "Submodelo MVC da rotina (Ex: AC8DETAIL)."'                         +;
        '          },'                                                                                    +;
        '          "maintable" : {'                                                                       +;
        '            "type" : "string",'                                                                  +;
        '            "description" : "Tabela principal da rotina (Ex: SA1)."'                            +;
        '          }'                                                                                     +;
        '        }'                                                                                       +;
        '      },'                                                                                        +;
        '      "description" : "Lista de blocos de alteracao agrupados por rotina."'                     +;
        '    }'                                                                                           +;
        '  }'                                                                                             +;
        '}' )

return jSchema

//------------------------------------------------------------------
/*/{Protheus.doc} process
Metodo responsavel pelo processamento da Tool.

Recebe o payload de entrada com as alteracoes a serem realizadas e
retorna um objeto com o resultado do processamento.

@param jPayLoad  payload de entrada com as alteracoes
@return jResp    objeto com o resultado do processamento

@obs: Exemplo de uso: Altere o campo Revisado para sim no timesheet 000000054189

@author Pedro Mazzari Ramos
@since 08/06/2026
/*/
//-------------------------------------------------------------------
method process(jPayLoad as json) as json class apply_changes
	Local jResp       := JsonObject():new()
	Local cPayloadStr := ""
	Local cEmp        := cEmpAnt
	Local cFil        := cFilAnt
	Local cTitle      := ""
	Local cNextJobId  := ""
	Local cToken      := totvs.framework.users.rpc.getAuthToken()
	Local oJsonRel    as Object

	If !(jPayLoad:hasProperty("title") .And. !Empty(jPayLoad["title"]));
	 .Or. !(jPayLoad:hasProperty("changes")  .And. !Empty(jPayLoad["changes"]))
		jResp["error"] := JsonObject():new()
		jResp["error"]["code"]    := "Propriedades inválidas"
		jResp["error"]["message"] := "As propriedades obrigatórias não foram informadas no payload de entrada."
		Return jResp
	EndIf

	If jPayLoad:hasProperty("title")
		cTitle := jPayLoad["title"]
	EndIf

	cPayloadStr := jPayLoad:toJson()
 
	oJsonRel := J288JsonRel()
	oJsonRel['O17_CODUSR'] := __cUserID
	oJsonRel['O17_TIPO']   := "3"
	oJsonRel['O17_FILE']   := DecodeUTF8(SubStr(cTitle, 1, 50))
	oJsonRel['O17_DESC']   := "Preparando processamento..."
	oJsonRel['O17_BODY']   := DecodeUTF8(cPayloadStr)
	oJsonRel['O17_STATUS'] := "3"
	oJsonRel['O17_MAX']    := 0
	oJsonRel['O17_MIN']    := 0
	oJsonRel['O17_PERC']   := 0
	J288GestRel(oJsonRel)

	cNextJobId := AllTrim(oJsonRel['O17_CODIGO'])

	jResp["resultado"] := "Processamento em lote iniciado. Job registrado com sucesso."
	jResp["job_id"]    := cNextJobId

	If jPayLoad:hasProperty("isautomation") .And. jPayLoad["isautomation"]
		totvs.protheus.legal.alteracaolote.JAltGenJob(cEmp, cFil, cToken, cPayloadStr, cNextJobId)
	Else
		StartJob("totvs.protheus.legal.alteracaolote.JAltGenJob", GetEnvServer(), .F., cEmp, cFil, cToken, cPayloadStr, cNextJobId)
	EndIf

return jResp

//------------------------------------------------------------------
/*/{Protheus.doc} JAltGenJob
Job para processar as alteracoes em massa via MVC, rodando em background.
Recebe o payload com as alteracoes a serem feitas, percorre o array de 
changes e para cada item, busca o registro correspondente via DBSeek,
instancia o MVC, seta os campos e valores, valida e commita a transacao.
As alteracoes e o resultado de cada item processado (sucesso ou falha com mensagem de erro) 
sao registrados em um log que é gravado no campo O17_BODY para consulta posterior.

@param cEmpAnt         Codigo da empresa (RPO) para setar no ambiente do Job
@param cFilAnt         Codigo da filial (RPO) para setar no ambiente do Job
@param cToken          Token de autenticacao do usuario para setar no ambiente do Job
@param cPayloadStr     Payload em formato string contendo as alteracoes a serem processadas
@param cExistingJobId  ID do Job (O17_CODIGO) criado na etapa anterior para atualizar o status e o log de processamento

@author Pedro Mazzari Ramos e Abner Fogaca de Oliveira
@since 05/06/2026
/*/
//-------------------------------------------------------------------
Function JAltGenJob(cEmpAnt, cFilAnt, cToken, cPayloadStr, cExistingJobId)
	Local cCurrentRoutine  := ""
	Local cOldRoutine      := ""
	Local cTable           := ""
	Local cMainTable       := ""
	Local cSubModel        := ""
	Local cErrorMsg        := ""
	Local cKey             := ""
	Local cFieldType       := ""
	Local aError           := {}
	Local aArea            := {}
	Local aAreaAlias       := {}
	Local aChanges         := {}
	Local aItems           := {}
	Local aFields          := {}
	Local jChange          := {}
	Local jItem            := {}
	Local jField           := {}
	Local aResults         := {}
	Local lRet             := .T. as logical
	Local lAutomato        as logical
	Local lAuthToken       := GetRPORelease() >= "12.1.2510"
	Local nField           as numeric
	Local nChange          as numeric
	Local nItem            as numeric
	Local nSuccess         as numeric
	Local nFailed          as numeric
	Local nO17Recno        as numeric
	Local nAttempt         as numeric
	Local nFieldLength     as numeric
	Local nMaxAttempts     := 5 as numeric
	Local nIntervalSeconds := 10 as numeric
	Local nDecimal         as numeric
	Local nRecnoSeek       as numeric
	Local jPayLoad         := JsonObject():new()
	Local jLogItem         as Json
	Local jFinalReport     as Json
	Local cJsonFinal       as Json
	Local oMaster          as Object

	jPayLoad:FromJson(cPayloadStr)
	lAutomato := jPayLoad:hasProperty("isautomation") .And. jPayLoad["isautomation"]
	
	If !lAutomato
		RPCSetType(3)
		RPCSetEnv(cEmpAnt, cFilAnt, , , , "JAltGenJob")
	EndIf
	
	oMaster := Nil

	If lAuthToken .And. !Empty(cToken)
		totvs.framework.users.rpc.authByToken(cToken)
	EndIf
	
	aChanges := jPayLoad["changes"]

	// Busca o RECNO do registro que a thread pai ja criou usando o CODIGO garantido
	nO17Recno := GetO17RecnoByJobId(cExistingJobId)

	DbSelectArea("O17")
	O17->(DbGoto(nO17Recno))
	
	For nChange := 1 To Len(aChanges)
		jChange         := aChanges[nChange]
		cCurrentRoutine := AllTrim(jChange["model"])
		cTable          := AllTrim(jChange["table"])
		cMainTable      := AllTrim(jChange["maintable"])
		cSubModel       := AllTrim(jChange["submodel"])
		aItems          := jChange["items"]
		
		If !Empty(cMainTable)
			aArea := (cMainTable)->(GetArea())
		EndIf
		aAreaAlias := (cTable)->(GetArea())
		
		For nItem := 1 To Len(aItems)
			jItem    := aItems[nItem]
			cKey     := jItem["key"]
			jLogItem := JsonObject():new()
			
			(cTable)->(DbSetOrder(1)) // X2_UNICO da tabela do submodelo.

			If lRet := (cTable)->(DBSeek(cKey)) // Pesquisa o registro na tabela na tabela do submodelo que será alterado.
				If !Empty(cMainTable) .And. !Empty(cTable) .And. cMainTable != cTable
					(cMainTable)->(DbSetOrder(1)) // X2_UNICO da tabela principal
					If !(lRet := (cMainTable)->(DBSeek(cKey))) // Pesquisa o mesmo registro na tabela principal para garantir que existe e evitar erros de integridade referencial.
						cErrorMsg := "Registro não foi localizado na tabela principal."
					EndIf
				EndIf
			Else
				cErrorMsg := "Chave não foi localizada no Protheus."
			EndIf

			If oMaster != Nil .And. nChange > 1 .And. !Empty(cOldRoutine) .And. !Empty(cCurrentRoutine) .And. cOldRoutine != cCurrentRoutine // Destrói o objeto do MVC quando for mudar de rotina ou tiver processado o ultimo item do ultimo change para liberar memoria.
				oMaster:Destroy()
				FreeObj(oMaster)
			EndIf
			
			If lRet
				nRecnoSeek := (cMainTable)->(Recno()) // Sempre guarda o RECNO do registro pois algumas rotinas MVC estavam desposicionando o registro.
			EndIf
			
			If lRet .And. oMaster == Nil
				oMaster := FWLoadModel(cCurrentRoutine)
			EndIf
			
			If lRet .And. oMaster != Nil
				oMaster:SetOperation(4)
				If !oMaster:IsActive()
					oMaster:Activate()
				EndIf
				
				If (cMainTable)->(Recno()) != nRecnoSeek // Garante que o registro correto da tabela principal está selecionado antes de setar os valores do submodelo.
					(cMainTable)->(DbGoto(nRecnoSeek))
				EndIf

				aFields := jItem["fields"]
			
				For nField := 1 To Len(aFields)
					jField       := aFields[nField]
					cFieldType   := GetSx3Cache(jField["field"], "X3_TIPO")
					nFieldLength := GetSx3Cache(jField["field"], "X3_TAMANHO")

					If lRet .And. !Empty(jField["field"]) .And. !Empty(jField["value"])
						If cFieldType == "C" .And. Valtype(jField["value"]) == "C"
							jField["value"] := IIf(Valtype(DecodeUTF8(jField["value"])) == "C", DecodeUTF8(PadR(AllTrim(jField["value"]), nFieldLength)), PadR(AllTrim(jField["value"]), nFieldLength))
						ElseIf cFieldType == "M" .And. Valtype(jField["value"]) == "C"
							jField["value"] := IIf(Valtype(DecodeUTF8(jField["value"])) == "C", DecodeUTF8(AllTrim(jField["value"])), AllTrim(jField["value"]))
						ElseIf cFieldType == "D" .And. Valtype(jField["value"]) == "C"
							jField["value"] := CtoD(jField["value"])
						ElseIf cFieldType == "N"
							nDecimal        := GetSx3Cache(jField["field"], "X3_DECIMAL")
							If Valtype(jField["value"]) == "C" .And. Val(jField["value"]) = 0 .And. Len(AllTrim(jField["value"])) > 0
								lRet      := .F.
								cErrorMsg := "Valor atribuido difere da estrutura do campo (" + Alltrim(GetSx3Cache(jField["field"], "X3_TITULO")) + ")"
								Exit
							Else
								jField["value"] := IIf(Valtype(jField["value"]) == "C", Val(jField["value"]), jField["value"])
								jField["value"] := Round(jField["value"], nDecimal)
							EndIf
						EndIf
						lRet := oMaster:SetValue(cSubModel, jField["field"], jField["value"])
					ElseIf Empty(jField["field"]) .Or. Empty(jField["value"])
						lRet      := .F.
						cErrorMsg := "Campo ou valor não informado para este registro"
					EndIf
					
					If !lRet
						Exit
					EndIf
				Next nField
			Else
				If Empty(cErrorMsg)
					cErrorMsg := DecodeUTF8(I18n("Falha carregar MVC: #1", {cSubModel}))
				EndIf
			EndIf
			
			If lRet
				If lRet := oMaster:VldData()
					lRet := (cMainTable)->(DbRLock((cMainTable)->(Recno()))) // Verifica se o registro está bloqueado para edição antes de commitar a transação.
					nAttempt := 0
					While nAttempt < nMaxAttempts .And. !lRet // Tenta lockar o registro até 5 vezes
						nAttempt++
						lRet := (cMainTable)->(DbRLock((cMainTable)->(Recno())))
						
						If !lRet .And. nAttempt < nMaxAttempts
							Sleep(nIntervalSeconds * 1000) // Converte para milissegundos
						EndIf
					EndDo
					
					If !lRet .And. Empty(cErrorMsg)
						cErrorMsg := "O registro está bloqueado por outra sessão."
					EndIf
				EndIf
				If lRet
					oMaster:CommitData()
					(cMainTable)->(DBRUnlock((cMainTable)->(Recno()))) // Libera o lock do registro após o commit.
				EndIf
			EndIf

			If oMaster != Nil .And. !lRet .And. Empty(cErrorMsg) // Trecho necesário para obter a mensagem de erro quando SetValue ou VldData retornar .F.
				aError    := oMaster:GetErrorMessage()
				cErrorMsg := IIf(ValType(aError)=="A" .And. Len(aError)>=6, AllTrim(aError[6]), "")
			EndIf
			
			jLogItem["key"] := cKey
			
			If lRet
				jLogItem["status"]  := .T.
				jLogItem["message"] := "Registro processado com sucesso."
				nSuccess++
			Else
				jLogItem["status"]  := .F.
				jLogItem["message"] := cErrorMsg
				nFailed++
			EndIf
			
			AAdd(aResults, jLogItem)

			If oMaster != Nil
				oMaster:DeActivate()
			EndIf

			If nO17Recno > 0
				If RecLock("O17", .F.)
					O17->O17_DESC := "Processando registros."
					O17->O17_MIN  := nItem
					O17->O17_MAX  := Len(aItems)
					O17->O17_PERC := Round((nItem / Len(aItems)) * 100, 2)
					O17->(MsUnlock())
				EndIf
			EndIf
		Next nItem
		
		cOldRoutine := Upper(AllTrim(aChanges[nChange]["model"]))
		
		RestArea(aAreaAlias)
		If !Empty(cMainTable)
			RestArea(aArea)
		EndIf
	Next nChange
	
	If oMaster != Nil // Destrói o objeto do MVC para cenários que a chamada foi apenas em uma única rotina.
		oMaster:Destroy()
		FreeObj(oMaster)
	EndIf
	
	If nO17Recno > 0
		O17->(DbGoto(nO17Recno))
		jFinalReport := JsonObject():new()
		jFinalReport["summary"] := JsonObject():new()
		jFinalReport["summary"]["success"] := nSuccess
		jFinalReport["summary"]["failed"]  := nFailed
		jFinalReport["results"]            := aResults
		cJsonFinal := jFinalReport:ToJson()
		If RecLock("O17", .F.)
			O17->O17_STATUS := IIf(nFailed == 0, "2", "1")
			O17->O17_PERC   := 100
			O17->O17_DESC   := IIf(nFailed == 0, "Processamento finalizado.", "Concluido com falhas.")
			O17->O17_BODY   := cJsonFinal
			O17->(MsUnlock())
		EndIf
		FreeObj(jFinalReport)
	EndIf
	
	If !lAutomato
		RPCClearEnv()
	EndIf

Return Nil

//------------------------------------------------------------------
/*/{Protheus.doc} GetO17RecnoByJobId
Busca o RECNO do registro O17 a partir do codigo do Job.

Utiliza query SQL parametrizada com JQueryPSPr para localizar o registro 
na tabela O17 pelo campo O17_CODIGO e retorna o numero de registro (RECNO) encontrado.

@param cJobId   Codigo do Job (O17_CODIGO) para localizar o registro
@return nRecno  RECNO do registro O17 encontrado, ou 0 se nao localizar

@author Abner Fogaca de Oliveira
@since 23/06/2026
@see JAltGenJob()
/*/
//-------------------------------------------------------------------
Static function GetO17RecnoByJobId(cJobId as character) as numeric
Local cQuery     as character
Local cQryO17Als as character
Local nO17Recno  as numeric
Local nTamO17COD as numeric
Local aParams    := {} as array

	If !Empty(cJobId)
		nO17Recno  := 0
		nTamO17COD := TamSx3("O17_CODIGO")[1]
		
		cQuery := "SELECT R_E_C_N_O_ AS MYRECNO"
		cQuery +=  " FROM " + RetSqlName("O17")
		cQuery += " WHERE O17_FILIAL = ?"
		Aadd(aParams, xFilial("O17"))
		cQuery +=   " AND O17_CODIGO = ?"
		Aadd(aParams, PadL(cJobId, nTamO17COD, "0"))
		cQuery +=   " AND D_E_L_E_T_ = ?"
		Aadd(aParams, " ")

		cQryO17Als := MPSysOpenQuery(cQuery,,,, aParams)
		
		If !(cQryO17Als)->(Eof())
			nO17Recno := (cQryO17Als)->MYRECNO
		EndIf

		If Select(cQryO17Als) > 0
			(cQryO17Als)->(DbCloseArea())
		EndIf
		aSize(aParams, 0)
	EndIf

Return nO17Recno
