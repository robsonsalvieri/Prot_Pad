        '      "description" : "O ID gerado (O17_CODIGO) para acompanhar a tarefa."'                                 +;
        '    },'                                                                                                      +;
        '    "resultado" : {'                                                                                         +;
        '      "type" : "string",'                                                                                    +;
        '      "description" : "Mensagem de sucesso confirmando o inicio do processamento assincrono."'              +;
        '    }'                                                                                                       +;
        '  }'                                                                                                         +;
        '}' )

return jSchema

