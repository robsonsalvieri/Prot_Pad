        '        "properties" : {'                                                                        +;
        '          "items" : {'                                                                           +;
        '            "type" : "array",'                                                                   +;
        '            "items" : {'                                                                         +;
        '              "type" : "object",'                                                                +;
        '              "required" : [ "key", "fields" ],'                                                 +;
