#include "protheus.ch"
#include "fwmcptool.th"
 
namespace totvs.protheus.legal.alteracaolote
 
@FWToolMCP(action="get", erpRelease="12.1.2510", routine="listsubmodels", option=2, module="SIGAPFS")
class list_submodels implements FWMCPTool
    public method new() as object
    public method getDescription() as character
    public method getNotes() as character
    public method getPayLoadSchema() as json
    public method getReturnSchema() as json
	public method getMetrics() as array
    public method process(jPayLoad as json) as json
endclass

method new() as object class list_submodels
return self
 
method getDescription() as character class list_submodels
return "Retorna os submodelos (CID e CDESCRIPTION) de uma rotina MVC do Protheus."
 
method getNotes() as character class list_submodels
return "Informe o nome da rotina MVC (ex: JURA070) para listar seus submodelos com ID e descricao."

//------------------------------------------------------------------
/*/{Protheus.doc} getPayLoadSchema
Metodo responsavel por informar o schema de entrada da Tool
/*/
//-------------------------------------------------------------------
method getPayLoadSchema() as json class list_submodels
	Local jSchema := totvs.framework.mcp.tools.getJsonSchema()

    jSchema["properties"]["models"] := {;
            "type": "array",;
            "description": "Um ou mais IDs de rotina",;
            "minItems": 1,;
            "items": {;
                "type": "string",;
                "description": "ID da rotina. Ex: JURA070";
            };
    }

    jSchema["required"] := {"models"}

return jSchema

//------------------------------------------------------------------
/*/{Protheus.doc} getReturnSchema
Metodo responsavel por informar como sera o schema de retorno da Tool
/*/
//-------------------------------------------------------------------
method getReturnSchema() as json class list_submodels
	Local jSchema := totvs.framework.mcp.tools.getJsonSchema()

	jSchema["properties"]["results"] := {;
		"type": "array",;
		"description": "Lista de rotinas e seus respectivos submodelos encontrados com sucesso.",;
		"items": {;
			"type": "object",;
			"required": {"model", "submodels"},;
			"properties": {;
				"model": {;
					"type": "string",;
					"description": "ID da rotina. Ex: JURA070";
				},;
				"submodels": {;
					"type": "array",;
					"items": {;
						"type": "object",;
						"required": {"id", "title", "type"},;
						"properties": {;
							"id": {"type": "string"},;
							"title": {"type": "string"},;
							"type": {"type": "string"};
						};
					};
				};
			};
		};
	}

return jSchema

//------------------------------------------------------------------
/*/{Protheus.doc} auditoriaregrascustomizadas::getMetrics
Retorna as métricas e metadados de execução da tool.
@type method
@author Abner Oliveira
@since 12/08/2026
@return array, Array com métricas da tool
/*/
//-------------------------------------------------------------------
method getMetrics() as array class list_submodels
    Local jMetrics := {}
return jMetrics

//------------------------------------------------------------------
/*/{Protheus.doc} process
Metodo responsavel pelo processamento da Tool.
Recebe o nome de uma rotina MVC, carrega o modelo via FWLoadModel,
percorre todos os submodelos e retorna o CID e CDESCRIPTION de cada um.

@param jPayLoad, payload de entrada com rotina
@return jResp,   objeto com o array de submodelos encontrados

@author Abner Fogaça de Oliveira
@since 08/06/2026
@obs: Exemplo de uso: Liste os submodelos da rotina JURA070
/*/
//-------------------------------------------------------------------
method process(jPayLoad as json) as json class list_submodels
	Local jResp      as json
	Local jSubModel  as json
	Local aSubModels as array
	Local oModel     as object
	Local nI         as numeric
	Local nJ         as numeric
	Local cRotina    as character

	jResp := JsonObject():new()

	If jPayLoad:hasProperty("models") .And. Valtype(jPayLoad["models"]) == "A"
		jResp["results"] := {}
		For nI := 1 To Len(jPayLoad["models"])
			cRotina := jPayLoad["models"][nI]
			If !Empty(cRotina)
				Aadd(jResp["results"], JsonObject():New())
				aTail(jResp["results"])["model"]     := ""
				aTail(jResp["results"])["submodels"] := {}
				oModel := FWLoadModel(cRotina)
				If ValType(oModel) == "O"
					aTail(jResp["results"])["model"] := oModel:GetId()
					aSubModels := oModel:GetAllSubModels()
					For nJ := 1 To Len(aSubModels)
						jSubModel          := JsonObject():new()
						jSubModel["id"]    := aSubModels[nJ]:GetId()
						jSubModel["title"] := aSubModels[nJ]:GetDescription()
						If Upper(GetClassName(aSubModels[nJ])) == "FWFORMGRIDMODEL"
							jSubModel["type"]  := "grid"
						Else
							jSubModel["type"]  := "fields"
						EndIf
						aAdd(aTail(jResp["results"])["submodels"], jSubModel)
					Next nJ
					oModel:Destroy()
				Else
					jResp["error"] := {"message": "Nao foi possivel carregar o modelo da rotina: " + cRotina}
				EndIf
			Else
				jResp["error"] := {"message": "O parametro rotina nao foi informado."}
			EndIf
		Next nI
	Else
		jResp["error"] := {"message": "O parametro rotina nao foi informado."}
	EndIf

Return jResp
