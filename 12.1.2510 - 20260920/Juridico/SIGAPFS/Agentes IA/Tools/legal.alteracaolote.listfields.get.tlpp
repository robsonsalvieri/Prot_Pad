#include "protheus.ch"
#include "fwmcptool.th"
#include "tlpp-core.th"
#include "tlpp-rest.th"

namespace totvs.protheus.legal.alteracaolote

@FWToolMCP(action="get", erpRelease="12.1.2510", routine="listfields", option=2, module="SIGAPFS")
class list_fields implements FWMCPTool
	public method new() as object
	public method getDescription() as character
	public method getNotes() as character
	public method getPayLoadSchema() as json
	public method getReturnSchema() as json
	public method getMetrics() as array
	public method process(jPayLoad as json) as json
endclass

method new() as object class list_fields
return self
//------------------------------------------------------------------
/*/{Protheus.doc} getDescription
Informa a descrição da tool

@return character, notas sobre a tool
/*/
//-------------------------------------------------------------------
method getDescription() as character class list_fields
return "Retorna a estrutura dos campos e help com base em uma rotina informada."
//------------------------------------------------------------------
/*/{Protheus.doc} getNotes
Informa as notas adicionais sobre a tool

@return character, notas sobre a tool
/*/
//-------------------------------------------------------------------
method getNotes() as character class list_fields
return "Informe o nome da rotina (ex: JURA070) para listar os campos e help."

//------------------------------------------------------------------
/*/{Protheus.doc} getPayLoadSchema
Metodo responsavel por informar o schema de entrada da Tool

@return jSchema, Schema de entrada da tool
/*/
//-------------------------------------------------------------------
method getPayLoadSchema() as json class list_fields
	Local jSchema := totvs.framework.mcp.tools.getJsonSchema()

	jSchema["properties"] := {;
		"model": { "type": "string", "description": "ID principal de uma rotina" },;
		"submodel": { "type": "string", "description": "ID do submodel. Ex: NVEMASTER" };
	}

	jSchema["required"] := {"model", "submodel"}

return jSchema

//------------------------------------------------------------------
/*/{Protheus.doc} getReturnSchema
Metodo responsavel por informar como sera o schema de retorno da Tool

@return jSchema, Schema de entrada da tool
/*/
//-------------------------------------------------------------------
method getReturnSchema() as json class list_fields
	Local jSchema := {;
		"type": "object",;
		"required": {"submodel", "table", "filial", "key_structure", "fields"},;
		"properties": {;
			"fields": {;
				"type": "array",;
				"items": {;
					"type": "object",;
					"properties": {;
						"id":          {"type": "string"},;
						"help":        {"type": "string"},;
						"size":        {"type": "integer"},;
						"type":        {"type": "string"},;
						"title":       {"type": "string"},;
						"decimal":     {"type": "integer"},;
						"options": {;
							"type": "array",;
							"items": {;
								"type": "object",;
								"properties": {;
									"value":   {"type": "string"},;
									"label": {"type": "string"};
								};
							};
						},;
						"canChange":   {"type": "boolean"},;
						"description": {"type": "string"};
					};
				};
			},;
			"filial":        {"type": "string"},;
			"submodel":      {"type": "string"},;
			"maintable":     {"type": "string"},;
			"table":         {"type": "string"},;
			"key_structure": {;
				"type": "array",;
				"items": {"type": "string"};
			};
		};
	}

return jSchema

//------------------------------------------------------------------
/*/{Protheus.doc} auditoriaregrascustomizadas::getMetrics
Retorna as métricas e metadados de execução da tool.
@type method
@author Abner Oliveira
@since 12/08/2026
@return array, Array com métricas da tool
/*/
//-------------------------------------------------------------------
method getMetrics() as array class list_fields
    Local jMetrics := {}
return jMetrics

//------------------------------------------------------------------
/*/{Protheus.doc} process
Metodo responsavel pelo processamento da Tool.
/*/
//-------------------------------------------------------------------
method process(jPayLoad as json) as json class list_fields
	Local jResp        as json
	Local jStruct      as json
	Local oModel       as object
	Local lProceed     := .F. as logical
	Local aSubModels   := {} as array
	Local nModel       as numeric

	jResp := JsonObject():new()

	If jPayLoad:hasProperty("model") .And. jPayLoad:hasProperty("submodel") .And. ;
		!Empty(jPayLoad["model"]) .And. !Empty(jPayLoad["submodel"])
        
		If FindFunction("JStructMdl")
			oModel := FwLoadModel(jPayLoad["model"])
			If ValType(oModel) == "O"
			
				aSubModels := oModel:GetAllSubModels()
				
				For nModel := 1 To Len(aSubModels)
					If Upper(jPayLoad["submodel"]) == Upper(aSubModels[nModel]:cId)
						lProceed := .T.
						Exit
					EndIf
				Next nModel
			
				oModel:Destroy()
				FwFreeObj(oModel)
				
				If lProceed
					jStruct := JStructMdl(jPayLoad["model"], /*cNomeCampo*/, .T., .T., .T.)
					If Valtype(jStruct) != "U"
						// Chamada do filtro passando a estrutura encontrada
						jResp := FilterStruct(jStruct, jPayLoad["submodel"])
					Else
						jResp["error"] := {"message": "A rotina informada não possui interface (ViewDef) ou não é MVC."}
					EndIf
				Else
					jResp["error"] := {"message": "O submodel informado não corresponde a rotina informada ou é inválido."}
				EndIf
			Else
				jResp["error"] := {"message": "A propriedade model é inválida."}
			EndIf
		Else
			jResp["error"] := {"message": "Função 'JStructMdl' não encontrada, verifique a data do fonte WSJurGenerico."}
		EndIf
	Else
		jResp["error"] := {"message": "Os parametros rotina nao foram informados."}
	EndIf

Return jResp

//------------------------------------------------------------------
/*/{Protheus.doc} FilterStruct
Filtra o JSON retornado por JStructMdl aplicando duas regras:
1 - Retorna apenas o item do array "struct" cujo "id" seja igual
	ao informado em cIdFilter.
2 - Para cada campo dentro de "fields", retorna apenas as
	propriedades especificadas em aFieldProps.

@param jResp       JSON completo retornado pela JStructMdl
@param cIdFilter   Id do struct a ser retornado (ex: "NVEMASTER")

@author Abner Fogaca de Oliveira | Pedro Mazzari Ramos
@since 10/06/2026
/*/
//-------------------------------------------------------------------
Static Function FilterStruct(jResp, cIdFilter) as json
	Local jFiltered   := JsonObject():new()
	Local jStruct     := Nil
	Local jField      := Nil
	Local jFieldFilt  := Nil
	Local aStruct     := {}
	Local aFields     := {}
	Local aFieldsFilt := {}
	Local nI          := 0
	Local nJ          := 0
	Local cTable      := ""
	Local cHelp       := ""

	Default cIdFilter := ""

	jFiltered["submodel"]      := ""
	jFiltered["maintable"]     := ""
	jFiltered["table"]         := ""
	jFiltered["filial"]        := ""
	jFiltered["key_structure"] := {}
	jFiltered["fields"]        := {}

	aStruct := jResp["struct"]

	For nI := 1 To Len(aStruct)
		jStruct := aStruct[nI]
		cTable  := jStruct["tableId"]

		If jStruct["id"] == cIdFilter
			aFields     := jStruct["fields"]
			aFieldsFilt := {}
			
			For nJ := 1 To Len(aFields)
				jField     := aFields[nJ]
				jFieldFilt := JsonObject():new()
				
				// Montagem do De-Para conforme output schema
				jFieldFilt["id"]          := jField["field"]
				jFieldFilt["size"]        := jField["size"]
				jFieldFilt["type"]        := jField["type"]
				jFieldFilt["title"]       := jField["description"]
				jFieldFilt["decimal"]     := jField["decimal"]
				jFieldFilt["options"]     := jField["options"]
				jFieldFilt["canChange"]   := jField["canChange"]
				jFieldFilt["description"] := jField["descComplet"]
				cHelp                     := jField["help"]
				
				If !Empty(cHelp)
					cHelp := StrTran(cHelp, Chr(13) + Chr(10), " ")
					cHelp := StrTran(cHelp, Chr(13), " ")
					cHelp := StrTran(cHelp, Chr(10), " ")
					cHelp := StrTran(cHelp, Chr(9), " ")
					cHelp := StrTran(cHelp, Chr(0), "")
					cHelp := cleanString(DecodeUTF8(cHelp))
					cHelp := AllTrim(cHelp)
				EndIf
				
				jFieldFilt["help"] := cHelp
				
				aAdd(aFieldsFilt, jFieldFilt)
			Next nJ
			
			jFiltered["submodel"] := jStruct["id"]
			If nI == 1
				jFiltered["maintable"] := cTable
				jFiltered["table"]     := cTable
			Else
				jFiltered["maintable"] := IIf(Len(aStruct) > 0, aStruct[1]["tableId"], "")
				jFiltered["table"]     := cTable
			EndIf
			jFiltered["filial"]        := xFilial(cTable)
			jFiltered["key_structure"] := StrToKArr(FWX2Unico(cTable), "+")
			jFiltered["fields"]        := aFieldsFilt
			Exit
		EndIf
	Next nI

Return jFiltered
