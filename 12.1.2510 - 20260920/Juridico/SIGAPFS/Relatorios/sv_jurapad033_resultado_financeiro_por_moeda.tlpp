#INCLUDE "JURAPAD033.CH"
#INCLUDE "protheus.ch"
#INCLUDE "totvs.ch"
#INCLUDE "msobject.ch"
#INCLUDE "totvs.framework.treports.integratedprovider.th"

namespace totvs.protheus.legal.sigapfs.jurapad033_resultado_financeiro_por_moeda.integratedprovider

@totvsFrameworkTReportsIntegratedProvider(active=.T.,;
	team='SIGAPFS',;
	tables='CTO,NS7,OHB,SED',;
	name='Resultado Financeiro por Moeda',;
	country='ALL',;
	initialRelease='12.1.2210')

//------------------------------------------------------------------------------------
class jurapad033_resultado_financeiro_por_moeda from totvs.framework.treports.integratedprovider.IntegratedProvider
public    method new()         as object
public    method getData()     as object
public    method getSchema()   as object

endclass

//------------------------------------------------------------------------------------
method new() class jurapad033_resultado_financeiro_por_moeda
	_Super:new()

	//Define a área
	self:appendArea(STR0035) // "Pré-Faturamento Serviços"

	//Define o nome do Objeto de Negócio
	self:setDisplayName(STR0028) // "Relatório de Resultado Financeiro"

	//Define a descrição do Objeto de Negócio
	self:setDescription(STR0037) // "Objeto de Negócio de Resultado Financeiro"

	self:setPergunte("JURAPAD033")

Return self

//------------------------------------------------------------------------------------
method getData(nPage as numeric, oFilter as object) as object class jurapad033_resultado_financeiro_por_moeda
Local jParams    := oFilter:getParameters()
Local aArea      := GetArea()
Local oJsDados   := JsonObject():new()
Local dDtInicio  := StoD(jParams['MV_PAR01'][1]+"01")
Local dDtFinal   := Lastday(dDtInicio)
Local cMoeda     := jParams['MV_PAR02'][1]
Local cFilOri    := JurGetDados( "NS7", 1, xFilial("NS7") + jParams['MV_PAR03'][1], "NS7_CFILIA" )
Local cRazao     := JurGetDados("NS7", 1, xFilial("NS7")+ jParams['MV_PAR03'][1], "NS7_RAZAO")
Local cSimMoed   := Alltrim(JurGetDados("CTO",1,xFILIAL("CTO")+cMoeda, "CTO_SIMB"))
Local lParamOk   := .T.
Local nValorAnt  := 0
Local nConta     := 0
Local nSub2Nivel := 0
Local nSub3Nivel := 0
Local aPosFinal  := {}
// Tabela temporaria auxiliar
Local oTpConta   := JurTpConta():New()
Local cTpContTmp := ""  //Alias da tabela temporaria de tipo de contas
Local oSumCntTmp := Nil //Objeto da tabela temporaria de totalização
Local cSomCntTmp := ""  //Alias da tabela temporaria de totalização

	/*
		MV_PAR01 - Ano-Mês de referência
		MV_PAR02 - Moeda
		MV_PAR03 - Escritório
	*/

	// Validação do preenchimento do Ano-Mês
	If lParamOk .And. Empty(Alltrim((jParams['MV_PAR01'][1])))
		self:setErrorStatus(400, STR0006, STR0007) // "O Ano-Mês é obrigatório." - "Informe um Ano-Mês válido."
		lParamOk := .F.
	EndIf

	// Validação da Moeda
	If lParamOk .And. !Empty(jParams['MV_PAR02'][1]) .And. Empty(JurGetDados("CTO", 1, xFilial("CTO") + jParams['MV_PAR02'][1], "CTO_MOEDA"))
		self:setErrorStatus(400, STR0008, STR0009) // "A Moeda é obrigatório." - "Informe uma Moeda válida."
		lParamOk := .F.
	EndIf

	// Validação do Escritório
	If lParamOk .And. !Empty(jParams['MV_PAR03'][1]) .And. Empty(JurGetDados("NS7", 1, xFilial("NS7") + jParams['MV_PAR03'][1], "NS7_COD"))
		self:setErrorStatus(400, STR0010, STR0011) // "O Escritório é obrigatório." - "Informe um Escritório válido."
		lParamOk := .F.
	EndIf

	If lParamOk
		// Monta a tabela temporaria auxiliar de Tipo de contas
		oTpConta:GeraTmp()
		cTpContTmp := oTpConta:GetTmpName()

		// Soma dos tipos de contas '2','3','4','6','8' e Transferência.
		oSumCntTmp  := JTmpSumTpC(cTpContTmp, dDtInicio, dDtFinal, cMoeda, cFilOri)
		cSomCntTmp  := oSumCntTmp:GetRealName()

		nValorAnt := JQryMovAnt(cTpContTmp, dDtInicio, cMoeda, cFilOri)

		oJsDados["SALDOMESANT"]     := nValorAnt
		oJsDados["TRANSFMOEDAS"]    := JRetSaldo('T', cSomCntTmp)
		oJsDados["RECEITAS"]        := JRetSaldo('3', cSomCntTmp)
		oJsDados["SAIDAS"]          := JRetSaldo('S', cSomCntTmp)
		oJsDados["CUSTODIRETO"]     := JRetSaldo('2', cSomCntTmp)
		oJsDados["DESPGERAISESCRI"] := JRetSaldo('8', cSomCntTmp)
		oJsDados["INVESTIMENTOS"]   := JRetSaldo('4', cSomCntTmp)
		oJsDados["OBRIGFISCAIS"]    := JRetSaldo('6', cSomCntTmp)
		oJsDados["SUBTOTSAIDAS"]    := JRetSaldo('S', cSomCntTmp)
		oJsDados["RESULTMES"]       := JRetSaldo('R', cSomCntTmp, nValorAnt)
		oJsDados["ESCRITORIO"]      := cRazao
		oJsDados["SIMBOLO"]         := cSimMoed
		oJsDados["Detalhes"]        := {}

		aPosFinal := JRetPosCx(cTpContTmp, dDtInicio, dDtFinal, cMoeda, cFilOri)

		For nConta := 1 To Len(aPosFinal)

			oJsDados["NIVEL2"] := {}

			If nConta <> 3 // Conta 3 não possui arrays multidimensionais
				For nSub2Nivel := 1 To Len(aPosFinal[nConta][3])

					oJsDados["NIVEL3"] := {}

					For nSub3Nivel := 1 To Len(aPosFinal[nConta][3][nSub2Nivel][3])
						aAdd(oJsDados["NIVEL3"], {"TPCONTA3" : aPosFinal[nConta][3][nSub2Nivel][3][nSub3Nivel][1],;
												  "VALOR3"   : aPosFinal[nConta][3][nSub2Nivel][3][nSub3Nivel][2]})
					Next nSub3Nivel

					aAdd(oJsDados["NIVEL2"], {"TPCONTA2" : aPosFinal[nConta][3][nSub2Nivel][1],;
											  "VALOR2"   : aPosFinal[nConta][3][nSub2Nivel][2],;
											  "NIVEL3"   : oJsDados["NIVEL3"]})

				Next nSub2Nivel
					
				aAdd(oJsDados["Detalhes"], {"TPCONTA" : aPosFinal[nConta][1],;
											"VALOR"   : aPosFinal[nConta][2],;
											"NIVEL2"  : oJsDados["NIVEL2"]})
			Else
				aAdd(oJsDados["Detalhes"], {"TPCONTA" : aPosFinal[nConta][1],;
											"VALOR"   : aPosFinal[nConta][2]})
			EndIf
		Next nConta

		self:oData:appendData(oJsDados)
		oTpConta:Destroy()
		oSumCntTmp:Delete()
	EndIf

	RestArea(aArea)
Return self:oData

//------------------------------------------------------------------------------------
method getSchema() as object Class jurapad033_resultado_financeiro_por_moeda
Local aNestedDet as array

	self:oSchema:addProperty("SALDOMESANT"    ,"SALDOMESANT"    , "number", STR0039) //"Saldo do Mês Anterior"
	self:oSchema:addProperty("TRANSFMOEDAS"   ,"TRANSFMOEDAS"   , "number", STR0040) //"Transf. entre Contas de Outras Moedas"
	self:oSchema:addProperty("RECEITAS"       ,"RECEITAS"       , "number", STR0041) //"Receitas"
	self:oSchema:addProperty("SAIDAS"         ,"SAIDAS"         , "number", STR0042) //"Saídas"
	self:oSchema:addProperty("CUSTODIRETO"    ,"CUSTODIRETO"    , "number", STR0055) //"Custo Direto"
	self:oSchema:addProperty("DESPGERAISESCRI","DESPGERAISESCRI", "number", STR0038) //"Desp. Gerais do Escritório"
	self:oSchema:addProperty("INVESTIMENTOS"  ,"INVESTIMENTOS"  , "number", STR0056) //"Investimentos"
	self:oSchema:addProperty("OBRIGFISCAIS"   ,"OBRIGFISCAIS"   , "number", STR0057) //"Obrigações Fiscais"
	self:oSchema:addProperty("SUBTOTSAIDAS"   ,"SUBTOTSAIDAS"   , "number", STR0023) //"Sub-total Saídas"
	self:oSchema:addProperty("RESULTMES"      ,"RESULTMES"      , "number", STR0043) //"Resultado do Mês"
	self:oSchema:addProperty("ESCRITORIO"     ,"ESCRITORIO"     , "string", STR0044) //"Escritório"
	self:oSchema:addProperty("SIMBOLO"        ,"SIMBOLO"        , "string", STR0045) //"Símbolo"
	aNestedDet := Array(0)
	//Posições do array = 1-Id | 2-Description | 3-Type | 4-DisplayName
	aAdd(aNestedDet, {"TPCONTA", "TPCONTA", "string", STR0046}) // "Conta/Natureza"
	aAdd(aNestedDet, {"VALOR"  , "VALOR"  , "number", STR0047}) // "Valor"
	aAdd(aNestedDet, {"NIVEL2" , "NIVEL2" , "array" , STR0048}) // "Contas/Naturezas Pai"
	self:oSchema:addNestedProperty("Detalhes", "Detalhes", STR0049,, aNestedDet) // Detalhes

	aNestedDet := Array(0)
	//Posições do array = 1-Id | 2-Description | 3-Type | 4-DisplayName
	aAdd(aNestedDet, {"TPCONTA2", "TPCONTA2", "string", STR0050}) // "Conta/Natureza Pai"
	aAdd(aNestedDet, {"VALOR2"  , "VALOR2"  , "number", STR0051}) // "Valor - Pai"
	aAdd(aNestedDet, {"NIVEL3"  , "NIVEL3"  , "array" , STR0052}) // "Contas/Naturezas Filho"
	self:transformInNested("NIVEL2", "", aNestedDet)

	aNestedDet := Array(0)
	//Posições do array = 1-Id | 2-Description | 3-Type | 4-DisplayName
	aAdd(aNestedDet, {"TPCONTA3", "TPCONTA3", "string", STR0053}) // "Conta/Natureza Filho"
	aAdd(aNestedDet, {"VALOR3"  , "VALOR3"  , "number", STR0054}) // "Valor - Filho"
	self:transformInNested("NIVEL3", "", aNestedDet)

Return self:oSchema

//-------------------------------------------------------------------
/*/{Protheus.doc} JTmpSumTpC()
Rotina para gerar a tabela temporária com a soma dos valores dos tipos de conta
'2','3','4','6','8' e transferência

@author João Pedro
@since 27/11/2025
@version 1.0
/*/
//-------------------------------------------------------------------
Static Function JTmpSumTpC(cTpContTmp, dDtInicio, dDtFinal, cMoeda, cFilOri)
Local cQuery    := ""
Local aStruct   := {}
Local aBind     := {}
Local oTmpTable := Nil
Local cInsert   := ""

	Aadd(aStruct, { "TP_CONTA", "C", 1 , 0 })
	Aadd(aStruct, { "VALOR"   , "N", 12, 2 })

	oTmpTable := FWTemporaryTable():New( GetNextAlias(), aStruct )
	oTmpTable:AddIndex("TP_CONTA",{"TP_CONTA"})
	oTmpTable:Create()

	cQuery := "?"
	Aadd(aBind, {JQrySumTpC(cTpContTmp, dDtInicio, dDtFinal, cMoeda, cFilOri), "U"})

	cQuery += " UNION ALL "
	cQuery += "?"
	Aadd(aBind, {JQryTransf(cTpContTmp, dDtInicio, dDtFinal, cMoeda, cFilOri), "U"})

	cQuery := JurTRepBin(cQuery, aBind)
	cQuery := ChangeQuery(cQuery, .F.)

	cInsert := " INSERT INTO "+ oTmpTable:GetRealName() +" ( "
	cInsert += " TP_CONTA, VALOR ) "
	cInsert += cQuery

	If (TCSQLExec(cInsert) < 0) //Usar TCSQLExec apenas na tabela temporária criada pelo FWTemporaryTable()
		JurLogMsg( TCSQLError() )
	EndIf

Return oTmpTable

//-------------------------------------------------------------------
/*/{Protheus.doc} JQrySumTpC()
Rotina para gerar a query com os filtros e as soma do relatório
para os tipos de contas '2','3','4','6','8'.

@author João Pedro
@since 27/11/2025
@version 1.0
/*/
//-------------------------------------------------------------------
Static Function JQrySumTpC(cTpContTmp, dDtInicio, dDtFinal, cMoeda, cFilOri)
Local cQuery := ""
Local aBind  := {}

	cQuery := " SELECT "
	cQuery +=       " OHBCONTA.TP_CONTA, "
	cQuery +=       " ISNULL(SUM(OHBCONTA.VALOR),0) VALOR "
	cQuery +=   " FROM ( "
	cQuery +=         " SELECT "
	cQuery +=              " TMP_ORI.TP_CONTA_ORI TP_CONTA, "
	cQuery +=              " TMP_ORI.OHB_VALOR * (SELECT SINAL FROM ? WHERE CODIGO = TMP_ORI.TP_CONTA_ORI AND TIPO = ?) VALOR "
	Aadd(aBind, {cTpContTmp, "U"})
	Aadd(aBind, {"O", "S"})

	cQuery +=           " FROM ( ?"
	Aadd(aBind, {JQryFilTpC(dDtInicio, dDtFinal, cMoeda, cFilOri), "U"})

	cQuery +=                " )TMP_ORI "
	cQuery +=  " UNION ALL "

	cQuery += " SELECT "
	cQuery +=      " TMP_DES.TP_CONTA_DES TP_CONTA, "
	cQuery +=      " TMP_DES.OHB_VALOR * (SELECT SINAL FROM ? WHERE CODIGO = TMP_DES.TP_CONTA_DES AND TIPO = ?) VALOR "
	Aadd(aBind, {cTpContTmp, "U"})
	Aadd(aBind, {"D", "S"})
	
	cQuery +=   " FROM ( ?"
	Aadd(aBind, {JQryFilTpC(dDtInicio, dDtFinal, cMoeda, cFilOri), "U"})

	cQuery +=    " )TMP_DES "
	cQuery += " ) OHBCONTA "
	cQuery += " GROUP BY OHBCONTA.TP_CONTA "

	cQuery := JurTRepBin(cQuery, aBind)

Return cQuery

//-------------------------------------------------------------------
/*/{Protheus.doc} JQryFilTpC()
Rotina para gerar a sub query com os filtros do relatório para os tipos de contas
'2','3','4','6','8'.

@author  João Pedro
@since   27/11/2025
@version 1.0
/*/
//-------------------------------------------------------------------
Static Function JQryFilTpC(dDtInicio, dDtFinal, cMoeda, cFilOri)
Local cQuery := ""
Local aBind  := {}

	cQuery += " SELECT "
	cQuery +=       " OHB.OHB_VALOR, "
	cQuery +=       " SEDO.ED_TPCOJR TP_CONTA_ORI, "
	cQuery +=       " SEDD.ED_TPCOJR TP_CONTA_DES "
	cQuery +=   " FROM " + RetSqlName("OHB") + " OHB "
	cQuery +=  " INNER JOIN " + RetSqlName("SED") + " SEDO "
	cQuery +=     " ON  SEDO.ED_FILIAL = ?"
	Aadd(aBind, {xFilial("SED"), "S"})
	
	cQuery +=    " AND SEDO.ED_CODIGO = OHB.OHB_NATORI "
	cQuery +=    " AND SEDO.D_E_L_E_T_ = ?"
	Aadd(aBind, {Space(1), "S"})

	cQuery +=  " INNER JOIN " + RetSqlName("SED") + " SEDD "
	cQuery +=      "ON SEDD.ED_FILIAL = ?"
	Aadd(aBind, {xFilial("SED"), "S"})

	cQuery +=     "AND SEDD.ED_CODIGO = OHB.OHB_NATDES "
	cQuery +=     "AND SEDD.D_E_L_E_T_ = ?"
	Aadd(aBind, {Space(1), "S"})

	cQuery +=  " WHERE OHB.OHB_FILORI = ? "
	Aadd(aBind, {cFilOri, "S"})

	cQuery +=   " AND OHB.OHB_CMOELC = ?"
	Aadd(aBind, {cMoeda, "S"})

	cQuery +=   " AND OHB.OHB_DTLANC >= ? AND OHB.OHB_DTLANC <= ? "
	Aadd(aBind, {DTOS(dDtInicio), "S"})
	Aadd(aBind, {DTOS(dDtFinal), "S"})

	cQuery +=   " AND OHB.D_E_L_E_T_ = ?"
	Aadd(aBind, {Space(1), "S"})

	cQuery := JurTRepBin(cQuery, aBind)

Return cQuery

//-------------------------------------------------------------------
/*/{Protheus.doc} JQryTransf()
Rotina para gerar a query de Transferências entre Naturezas de outras Moedas

@author João Pedro
@since 02/12/2025
@version 1.0
/*/
//-------------------------------------------------------------------

Static Function JQryTransf(cTpContTmp, dDtInicio, dDtFinal, cMoeda, cFilOri)
Local cQuery := ""
Local aBind  := {}

	cQuery := " SELECT "
	cQuery +=        " 'T' TP_CONTA, "
	cQuery +=        " ISNULL(SUM(SOMA.VALOR_TRANSF), 0) VALOR "
	cQuery +=   " FROM ( "
	cQuery += " SELECT "
	cQuery +=       " CASE "
	cQuery +=           " WHEN ? = OHB_FILTER.MOEDA_ORI  THEN (VALOR * (SELECT SINAL FROM ? WHERE CODIGO = OHB_FILTER.TP_CONTA_ORI AND TIPO = ?)) "
	Aadd(aBind, {cMoeda, "U"})
	Aadd(aBind, {cTpContTmp, "U"})
	Aadd(aBind, {"O", "S"})

	cQuery +=           " WHEN ? = OHB_FILTER.MOEDA_DES  THEN (VALOR * (SELECT SINAL FROM ? WHERE CODIGO = OHB_FILTER.TP_CONTA_DES AND TIPO = ?)) "
	Aadd(aBind, {cMoeda, "U"})
	Aadd(aBind, {cTpContTmp, "U"})
	Aadd(aBind, {"D", "S"})

	cQuery +=       " END VALOR_TRANSF "
	cQuery +=   " FROM ( "
	cQuery +=           " SELECT "
	cQuery +=                " CASE "
	cQuery +=                " WHEN ? = OHB.OHB_CMOEC  THEN OHB.OHB_VALORC "
	Aadd(aBind, {cMoeda, "U"})

	cQuery +=               " WHEN ? = OHB.OHB_CMOELC THEN OHB.OHB_VALOR "
	Aadd(aBind, {cMoeda, "U"})

	cQuery +=                "ELSE 0 "
	cQuery +=               " END VALOR, "
	cQuery +=               " SEDO.ED_CMOEJUR MOEDA_ORI, "
	cQuery +=               " SEDO.ED_TPCOJR  TP_CONTA_ORI, "
	cQuery +=               " SEDD.ED_CMOEJUR MOEDA_DES, "
	cQuery +=               " SEDD.ED_TPCOJR  TP_CONTA_DES "
	cQuery +=             " FROM " + RetSqlName('OHB') + " OHB "
	cQuery +=            " INNER JOIN " + RetSqlName('SED') + " SEDO "
	cQuery +=               " ON  SEDO.ED_FILIAL = ?"
	Aadd(aBind, {xFilial("SED"), "S"})

	cQuery +=              " AND SEDO.ED_CODIGO = OHB.OHB_NATORI "
	cQuery +=              " AND SEDO.D_E_L_E_T_ = ?"
	Aadd(aBind, {Space(1), "S"})

	cQuery +=            " INNER JOIN " + RetSqlName('SED') + " SEDD "
	cQuery +=               " ON  SEDD.ED_FILIAL = ?"
	Aadd(aBind, {xFilial("SED"), "S"})

	cQuery +=              " AND SEDD.ED_CODIGO = OHB.OHB_NATDES "
	cQuery +=              " AND SEDD.D_E_L_E_T_ = ?"
	Aadd(aBind, {Space(1), "S"})

	cQuery +=            " WHERE OHB.OHB_FILORI = ? "
	Aadd(aBind, {cFilOri, "S"})

	cQuery +=              " AND (OHB.OHB_CMOEC = ? OR OHB.OHB_CMOELC = ?) "
	Aadd(aBind, {cMoeda, "S"})
	Aadd(aBind, {cMoeda, "S"})

	cQuery +=              " AND OHB.OHB_DTLANC >= ? AND OHB.OHB_DTLANC <= ? "
	Aadd(aBind, {DTOS(dDtInicio), "S"})
	Aadd(aBind, {DTOS(dDtFinal), "S"})
	
	cQuery +=              " AND OHB.D_E_L_E_T_ = ?"
	Aadd(aBind, {Space(1), "S"})

	cQuery +=              " AND SEDO.ED_CMOEJUR <> SEDD.ED_CMOEJUR "
	cQuery +=              " AND (SEDO.ED_TPCOJR IN ? OR SEDD.ED_TPCOJR IN ?) "
	Aadd(aBind, {"('1', '7')", "U"})
	Aadd(aBind, {"('1', '7')", "U"})

	cQuery +=       " ) OHB_FILTER "
	cQuery += " ) SOMA "

	cQuery := JurTRepBin(cQuery, aBind)

Return cQuery

//-------------------------------------------------------------------
/*/{Protheus.doc} JQryMovAnt()
Rotina para pegar toda a movimentacoes do mes anterior

@author  João Pedro
@since   28/11/2025
@version 1.0
/*/
//-------------------------------------------------------------------
Static Function JQryMovAnt(cTpContTmp, dDtInicio, cMoeda, cFilOri)
Local aArea   := GetArea()
Local cQuery  := ""
Local cQryRes := GetNextAlias()
Local nValor  := 0
Local aBind   := {}

	cQuery := " SELECT"
	cQuery +=      " SUM("
	cQuery +=           " CASE"
	cQuery +=          " WHEN TOTAL.ED_TPCOJR = '1' THEN  TOTAL.VALOR"
	cQuery +=          " WHEN TOTAL.ED_TPCOJR = '7' THEN - TOTAL.VALOR"
	cQuery +=          " ELSE 0"
	cQuery +=           " END) VALOR"
	cQuery +=   " FROM ("
	cQuery +=          " SELECT SUM(TAB.VALOR) VALOR, TAB.ED_TPCOJR"
	cQuery +=            " FROM ("
	cQuery +=                   " SELECT SED.ED_TPCOJR, SED.ED_CODIGO, (OHB.OHB_VALOR * TPCONTA.SINAL) VALOR"
	cQuery +=                     " FROM " + RetSqlName("OHB") + " OHB"
	cQuery +=                    " INNER JOIN " + RetSqlName("SED") + " SED"
	cQuery +=                       " ON SED.ED_FILIAL = ?"
	Aadd(aBind, {xFilial("SED"), "S"})

	cQuery +=                      " AND SED.ED_CODIGO = OHB.OHB_NATORI"
	cQuery +=                      " AND SED.ED_TPCOJR IN ?"
	Aadd(aBind, {"('1','7')", "U"})

	cQuery +=                      " AND SED.ED_CCJURI IN ?"
	Aadd(aBind, {"(' ','1','2','3','4','5')", "U"})

	cQuery +=                      " AND SED.D_E_L_E_T_ = ?"
	Aadd(aBind, {Space(1), "S"})

	cQuery +=                    " INNER JOIN ? TPCONTA"
	Aadd(aBind, {cTpContTmp, "U"})

	cQuery +=                       " ON TPCONTA.CODIGO = SED.ED_TPCOJR"
	cQuery +=                      " AND TPCONTA.TIPO = ?"
	Aadd(aBind, {"O", "S"})

	cQuery +=                    " WHERE OHB.OHB_FILORI = ?"
	Aadd(aBind, {cFilOri, "S"})

	cQuery +=                      " AND OHB.OHB_CMOELC = ?"
	Aadd(aBind, {cMoeda, "S"})

	cQuery +=                      " AND OHB.OHB_DTLANC < ?"
	Aadd(aBind, {DTOS(dDtInicio), "S"})

	cQuery +=                      " AND OHB.D_E_L_E_T_ = ?"
	Aadd(aBind, {Space(1), "S"})

	cQuery +=  " UNION ALL"

	cQuery += " SELECT SED.ED_TPCOJR, SED.ED_CODIGO, (OHB.OHB_VALOR * TPCONTA.SINAL) VALOR"
	cQuery +=   " FROM " + RetSqlName("OHB") + " OHB"
	cQuery +=  " INNER JOIN " + RetSqlName("SED") + " SED"
	cQuery +=     " ON SED.ED_FILIAL = ?"
	Aadd(aBind, {xFilial("SED"), "S"})

	cQuery +=    " AND SED.ED_CODIGO = OHB.OHB_NATDES"
	cQuery +=    " AND SED.ED_TPCOJR IN ?"
	Aadd(aBind, {"('1','7')", "U"})

	cQuery +=    " AND SED.ED_CCJURI IN ?"
	Aadd(aBind, {"(' ','1','2','3','4','5')", "U"})

	cQuery +=    " AND SED.D_E_L_E_T_ = ?"
	Aadd(aBind, {Space(1), "S"})

	cQuery +=  " INNER JOIN ? TPCONTA"
	Aadd(aBind, {cTpContTmp, "U"})

	cQuery +=     " ON TPCONTA.CODIGO = SED.ED_TPCOJR"
	cQuery +=    " AND TPCONTA.TIPO = ?"
	Aadd(aBind, {"D", "S"})

	cQuery +=  " WHERE OHB.OHB_FILORI = ?"
	Aadd(aBind, {cFilOri, "S"})

	cQuery +=    " AND OHB.OHB_CMOELC = ?"
	Aadd(aBind, {cMoeda, "S"})

	cQuery +=    " AND OHB.OHB_DTLANC < ?"
	Aadd(aBind, {DTOS(dDtInicio), "S"})

	cQuery +=    " AND OHB.D_E_L_E_T_ = ?"
	Aadd(aBind, {Space(1), "S"})

	cQuery +=     " ) TAB"
	cQuery += " GROUP BY TAB.ED_TPCOJR) TOTAL"

	cQuery := JurTRepBin(cQuery, aBind)
	cQuery := ChangeQuery(cQuery)

	DbUseArea(.T., "TOPCONN", TcGenQry(,,cQuery), cQryRes, .T., .T.)

	If (cQryRes)->(!EOF())
		nValor  := (cQryRes)->VALOR
	EndIf

	(cQryRes)->(DbCloseArea())

	RestArea(aArea)

Return nValor

//-------------------------------------------------------------------
/*/{Protheus.doc} JRetSaldo()
Rotina para gerar a SubQuery saldo de naturezas por conta.

@Param cTpCont - Tipo de conta jurídica
				'T' - Transferências entre Naturezas de outras Moedas
				'S' - Sub-Total de SAIDAS
				'R' - Resultado do Mês
				'2' - Custo direto
				'3' - RECEITAS
				'4' - INVESTIMENTOS
				'6' - Obrigações Fiscais
				'8' - Despesas Gerais do Escritório:

@cSomCntTmp    - Nome da tabela temporária com os valores para totalizar.
@nValorAnt     - Valor total do mês anterior (usado para calcular o resultado do mês)
@return nValor - Valor do saldo de naturezas por mês.

@author  João Pedro
@since   28/11/2025
@version 1.0
/*/
//-------------------------------------------------------------------
Static Function JRetSaldo(cTpCont, cSomCntTmp, nValorAnt)
Local aArea   := GetArea()
Local cQuery  := ""
Local cQryRes := GetNextAlias()
Local nValor  := 0
Local aBind   := {}

Default nValorAnt := 0

	If cTpCont $ "2|3|4|6|8|T"
		cQuery := " SELECT VALOR FROM ? WHERE TP_CONTA = ?"
		Aadd(aBind, {cSomCntTmp, "U"})
		Aadd(aBind, {cTpCont, "S"})

	ElseIf cTpCont == 'S'
		cQuery := " SELECT (SUM(VALOR) * -1) VALOR FROM ? WHERE TP_CONTA IN ?" // Sub-Total de SAIDAS
		Aadd(aBind, {cSomCntTmp, "U"})
		Aadd(aBind, {"('2','8','4','6')", "U"})

	ElseIf cTpCont == 'R'
		cQuery := " SELECT ISNULL(SUM(RESULT.VALOR), 0) VALOR  FROM ("
		cQuery += " SELECT SUM(VALOR) VALOR FROM ? WHERE TP_CONTA IN ?" // Sub-Total Receita e Transferencias
		Aadd(aBind, {cSomCntTmp, "U"})
		Aadd(aBind, {"('3','T')", "U"})

		cQuery +=  " UNION ALL"
		cQuery += " SELECT (SUM(VALOR) * -1) VALOR FROM ? WHERE TP_CONTA IN ?" // Sub-Total de SAIDAS
		Aadd(aBind, {cSomCntTmp, "U"})
		Aadd(aBind, {"('2','8','4','6')", "U"})

		cQuery += " ) RESULT"  // Resultado do Mês
	EndIf

	cQuery := JurTRepBin(cQuery, aBind)
	cQuery := ChangeQuery(cQuery, .F.)

	DbUseArea(.T., "TOPCONN", TcGenQry(,,cQuery), cQryRes, .T., .T.)

	If (cQryRes)->(!EOF())
		nValor := (cQryRes)->VALOR
	EndIf

	(cQryRes)->(DbCloseArea())

	If cTpCont == 'R'
		nValor += nValorAnt 
	EndIf

	RestArea(aArea)

Return nValor

//-------------------------------------------------------------------
/*/{Protheus.doc} JRetPosCx()
Rotina para gerar os dados '1','7'. (posição final de caixa)

@Return aRet, Retorno com os valores totais de contas, natureza pai, e naturezas analisticas

aRet[1] "6. Banco/Caixas" (ED_TPCOJR = '1')
aRet[2] "7. Contas de Sócios/Profissionais" (ED_TPCOJR = '7')
aRet[3] "8. Resultado do Mês"

aRet[n][1], Código da natureza Sintética
aRet[n][2], Valor total da natureza Sintética
aRet[n][3], Array com as naturezas Analitica detalhadas

aRet[n][n][1], Código - Descrição da Natureza Analitica
aRet[n][n][2], Valor da Natureza Analitica

@author João Pedro
@since 01/12/2025
@version 1.0
/*/
//-------------------------------------------------------------------
Static Function JRetPosCx(cTpContTmp, dDtInicio, dDtFinal, cMoeda, cFilOri)
Local cQRY       := GetNextAlias()
Local aRet       := {}
Local nVlTotal   := 2
Local nSubArray  := 3
Local nPosPaiAtu := 0
Local nPosTpCont := 0
Local nSinal     := 1
Local cQuery     := ""
Local cNatFilNm  := ""
Local cNatPaiAtu := ""
Local cNatPaiNm  := ""
Local cContAtu   := ""
Local cContDesc  := ""
Local nTotal     := 0

cQuery := JQryPosCx(cTpContTmp, dDtInicio, dDtFinal, cMoeda, cFilOri)
cQuery := ChangeQuery(cQuery)
dbUseArea(.T.,"TOPCONN",TcGenQry(,,cQuery),cQRY,.T.,.T.)
(cQRY)->( dbGoTop() )

While !(cQRY)->(EOF())

	If cContAtu != (cQRY)->ED_TPCOJR
		cNatPaiAtu := ""
		nPosPaiAtu := 0
		cContAtu   := (cQRY)->ED_TPCOJR
		nPosTpCont += 1
		nSinal     := Iif(cContAtu == "7", -1, 1) //Conta de Profissional inverte o sinal
		cContDesc  := Iif(cContAtu == "7", STR0026, STR0025) //#"7. Contas de Sócios/Profissionais" ##"6. Banco/Caixas"

		Aadd(aRet, {cContDesc, 0, {} })
	EndIf

	If cNatPaiAtu != (cQRY)->COD_PAI
		nPosPaiAtu += 1
		cNatPaiAtu := (cQRY)->COD_PAI

		cNatPaiNm := Iif(!Empty((cQRY)->COD_PAI + (cQRY)->DESC_PAI), AllTrim(cNatPaiAtu) + " - " + AllTrim((cQRY)->DESC_PAI), " ")

		Aadd(aRet[nPosTpCont][nSubArray], {cNatPaiNm, 0, {} })

	EndIf

	cNatFilNm := AllTrim((cQRY)->ED_CODIGO) + " - " + AllTrim((cQRY)->ED_DESCRIC)

	Aadd(aRet[nPosTpCont][nSubArray][nPosPaiAtu][nSubArray], {cNatFilNm, (cQRY)->VALOR} )

	nTotal += (cQRY)->VALOR * nSinal

	aRet[nPosTpCont][nVlTotal] += (cQRY)->VALOR

	aRet[nPosTpCont][nSubArray][nPosPaiAtu][nVlTotal] += (cQRY)->VALOR

	(cQRY)->(dbSkip())
EndDo

Aadd(aRet, {STR0027, nTotal, {}}) //#"8. Resultado do Mês"

(cQRY)->(dbCloseArea())

Return aRet

//-------------------------------------------------------------------
/*/{Protheus.doc} JQryPosCx()
Rotina para gerar a query com os filtros do relatório para os tipos de contas
'1','7'. (posição final de caixa)

@author  João Pedro
@since   01/12/2025
@version 1.0
/*/
//-------------------------------------------------------------------
Static Function JQryPosCx(cTpContTmp, dDtInicio, dDtFinal, cMoeda, cFilOri)
Local cQuery := ""
Local aBind  := {}

	cQuery := " SELECT TAB.ED_TIPO, TAB.ED_TPCOJR, TAB.COD_PAI, TAB.DESC_PAI,TAB.ED_CODIGO, TAB.ED_DESCRIC, SUM(TAB.VALOR) VALOR"
	cQuery +=   " FROM ( SELECT"
	cQuery +=               " SED.ED_TIPO,"
	cQuery +=               " SED.ED_TPCOJR,"
	cQuery +=               " SEDPAI.ED_CODIGO COD_PAI,"
	cQuery +=               " SEDPAI.ED_DESCRIC DESC_PAI,"
	cQuery +=               " SED.ED_CODIGO,"
	cQuery +=               " SED.ED_DESCRIC,"
	cQuery +=               " OHB.OHB_VALOR * TPCONTA.SINAL VALOR"
	cQuery +=            " FROM " + RetSqlName("OHB") + " OHB"
	cQuery +=           " INNER JOIN " + RetSqlName("SED") + " SED"
	cQuery +=              " ON SED.ED_FILIAL = ?"
	Aadd(aBind, {xFilial("SED"), "S"})

	cQuery +=             " AND SED.ED_CODIGO = OHB.OHB_NATORI"
	cQuery +=             " AND SED.ED_TPCOJR IN ?"
	Aadd(aBind, {"('1','7')", "U"})

	cQuery +=             " AND SED.ED_CCJURI IN ?"
	Aadd(aBind, {"(' ','1','2','3','4','5')", "U"})

	cQuery +=             " AND SED.D_E_L_E_T_ = ?"
	Aadd(aBind, {Space(1), "S"})

	cQuery +=           " INNER JOIN ? TPCONTA"
	Aadd(aBind, {cTpContTmp, "U"})
	
	cQuery +=              " ON TPCONTA.CODIGO = SED.ED_TPCOJR"
	cQuery +=             " AND TPCONTA.TIPO = ?"
	Aadd(aBind, {"O", "S"})

	cQuery +=            " LEFT JOIN " + RetSqlName("SED") + " SEDPAI"
	cQuery +=              " ON SEDPAI.ED_FILIAL = ?"
	Aadd(aBind, {xFilial("SED"), "S"})

	cQuery +=             " AND SEDPAI.ED_CODIGO = SED.ED_PAI"
	cQuery +=             " AND SED.D_E_L_E_T_ = ?"
	Aadd(aBind, {Space(1), "S"})

	cQuery +=           " WHERE OHB.OHB_FILORI = ?"
	Aadd(aBind, {cFilOri, "S"})

	cQuery +=             " AND OHB.OHB_CMOELC = ?"
	Aadd(aBind, {cMoeda, "S"})
	
	cQuery +=             " AND OHB.OHB_DTLANC <= ?"
	Aadd(aBind, {DTOS(dDtFinal), "S"})

	cQuery +=             " AND OHB.D_E_L_E_T_ = ?"
	Aadd(aBind, {Space(1), "S"})

	cQuery +=  " UNION ALL"

	cQuery += " SELECT"
	cQuery +=      " SED.ED_TIPO,"
	cQuery +=      " SED.ED_TPCOJR,"
	cQuery +=      " SEDPAI.ED_CODIGO COD_PAI,"
	cQuery +=      " SEDPAI.ED_DESCRIC DESC_PAI,"
	cQuery +=      " SED.ED_CODIGO,"
	cQuery +=      " SED.ED_DESCRIC,"
	cQuery +=      " OHB.OHB_VALOR * TPCONTA.SINAL VALOR"
	cQuery +=   " FROM " + RetSqlName("OHB") + " OHB"
	cQuery +=  " INNER JOIN " + RetSqlName("SED") + " SED"
	cQuery +=     " ON SED.ED_FILIAL = ?"
	Aadd(aBind, {xFilial("SED"), "S"})

	cQuery +=    " AND SED.ED_CODIGO = OHB.OHB_NATDES"
	cQuery +=    " AND SED.ED_TPCOJR IN ?"
	Aadd(aBind, {"('1','7')", "U"})

	cQuery +=    " AND SED.ED_CCJURI IN ?"
	Aadd(aBind, {"(' ','1','2','3','4','5')", "U"})

	cQuery +=    " AND SED.D_E_L_E_T_ = ?"
	Aadd(aBind, {Space(1), "S"})

	cQuery +=  " INNER JOIN ? TPCONTA"
	Aadd(aBind, {cTpContTmp, "U"})

	cQuery +=     " ON TPCONTA.CODIGO = SED.ED_TPCOJR"
	cQuery +=    " AND TPCONTA.TIPO = ?"
	Aadd(aBind, {"D", "S"})

	cQuery +=   " LEFT JOIN " + RetSqlName("SED") + " SEDPAI"
	cQuery +=     " ON SEDPAI.ED_FILIAL = ?"
	Aadd(aBind, {xFilial("SED"), "S"})

	cQuery +=    " AND SEDPAI.ED_CODIGO = SED.ED_PAI"
	cQuery +=    " AND SED.D_E_L_E_T_ = ?"
	Aadd(aBind, {Space(1), "S"})

	cQuery +=  " WHERE OHB.OHB_FILORI = ?"
	Aadd(aBind, {cFilOri, "S"})

	cQuery +=    " AND OHB.OHB_CMOELC =  ?"
	Aadd(aBind, {cMoeda, "S"})

	cQuery +=    " AND OHB.OHB_DTLANC <= ?"
	Aadd(aBind, {DTOS(dDtFinal), "S"})

	cQuery +=    " AND OHB.D_E_L_E_T_ = ?"
	Aadd(aBind, {Space(1), "S"})

	cQuery +=        " ) TAB"
	cQuery += " GROUP BY TAB.ED_TIPO, TAB.ED_TPCOJR, TAB.COD_PAI, TAB.DESC_PAI,TAB.ED_CODIGO, TAB.ED_DESCRIC"
	cQuery += " ORDER BY TAB.ED_TPCOJR, TAB.ED_TIPO, TAB.COD_PAI"

	cQuery := JurTRepBin(cQuery, aBind)

Return cQuery
