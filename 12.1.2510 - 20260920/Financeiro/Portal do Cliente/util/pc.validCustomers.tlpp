#include 'tlpp-core.th'

namespace portal.cliente.util

//-------------------------------------------------------------------
/*/{Protheus.doc} validCustomers
Valida as chaves do array de clientes.

@params
customers:
[
	{
		"branchId": string,
		"storeId": string,
		"customerId": string,
		...
	}
]

@return boolean

@author richard.lopes
@since 18/11/2020
/*/
//-------------------------------------------------------------------
Function validCustomers(aCustomers As Array)
	Local nCount      As Numeric
	Local isValid     As Logical
	Local aPositions  As Array
	Local aKeys       As Array
	Local nSizeFil    := 0 As Numeric
	Local nSizeCod    := 0 As Numeric
	Local nSizeLoja   := 0 As Numeric

	aPositions := {}
	isValid    := .T.

	aAdd(aPositions, "branchId")
	aAdd(aPositions, "customerId")
	aAdd(aPositions, "storeId")

	nSizeFil    := TamSX3("A1_FILIAL")[1]
	nSizeCod    := TamSX3("A1_COD")[1]
	nSizeLoja   := TamSX3("A1_LOJA")[1]

	If Len(aCustomers) > 0
		For nCount := 1 To Len(aCustomers)
			aKeys := aCustomers[nCount]:GetNames()

			If aScan(aKeys, aPositions[1]) == 0 .Or.;
				aScan(aKeys, aPositions[2]) == 0 .Or.;
				aScan(aKeys, aPositions[3]) == 0
				isValid := .F.
				Exit
			EndIf

			If !safeId(aCustomers[nCount]["branchId"], nSizeFil) .Or.;
				!safeId(aCustomers[nCount]["customerId"], nSizeCod) .Or.;
				!safeId(aCustomers[nCount]["storeId"], nSizeLoja)
				isValid := .F.
				Exit
			EndIf

			If !safeBranches(aCustomers[nCount], aKeys)
				isValid := .F.
				Exit
			EndIf
		Next nCount
	Else
		isValid := .F.
	EndIf
Return isValid

//-------------------------------------------------------------------
/*/{Protheus.doc} safeId
Valida um identificador recebido no payload por tipo e tamanho.

@param xValue, Variant, Valor recebido no payload
@param nMaxSize, Numeric, Tamanho máximo obtido do dicionário

@return Logical, .T. quando o valor é seguro

@author vinicius.prado
@since 19/08/2026
/*/
//-------------------------------------------------------------------
Static Function safeId(xValue As Variant, nMaxSize As Numeric) As Logical
	Local lSafe := .T.

	If !Empty(xValue)
		lSafe := ValType(xValue) == "C" .And. Len(xValue) <= nMaxSize
	EndIf
	
Return lSafe

//-------------------------------------------------------------------
/*/{Protheus.doc} safeBranches
Valida o identificador totalId de cada filial do item, quando a chave
branches for informada. 

@param xItem, Variant, Item do array de clientes
@param aKeys, Array, Chaves presentes no item
@param nMaxSize, Numeric, Tamanho máximo do código completo de filial
@return Logical, .T. quando todos os totalId informados são seguros

@author vinicius.prado
@since 19/08/2026
/*/
//-------------------------------------------------------------------
Static Function safeBranches(xItem As Variant, aKeys As Array) As Logical
	Local nBranch   := 0 As Numeric
	Local xBranches As Variant
	Local lSafe := .T. as Logical

	If aScan(aKeys, "branches") <> 0
		xBranches := xItem["branches"]
		lSafe := .F.

		If ValType(xBranches) == "A"
			lSafe := .T.
			For nBranch := 1 To Len(xBranches)
				If aScan(xBranches[nBranch]:GetNames(), "totalId") > 0 .And.;
					!FWFilExist(cEmpAnt, xBranches[nBranch]["totalId"])
					Return .F.
				EndIf
			Next nBranch
		EndIf
	EndIf
Return lSafe
