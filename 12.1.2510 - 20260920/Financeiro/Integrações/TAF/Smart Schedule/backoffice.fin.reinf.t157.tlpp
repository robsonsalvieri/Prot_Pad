#include "msobject.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#Include "TOTVS.CH"

#define THIRD_PARTY_WORK '2'

namespace totvs.protheus.backoffice.fin.taf.smartschedule

//-------------------------------------------------------------------
/*/{Protheus.doc} DataBlockT157
    Classe responsável por selecionar e montar Json do Bloco T157 (Cadastro de Obras)
    @author guilhermed.santos@totvs.com.br
    @since 08/05/2025
    @version 12.1.2410
*/
//-------------------------------------------------------------------
class DataBlockT157
    protected data cIdDoc as character
    protected data jBlockT157 as json
    protected data lHasDataBlock as logical

    public method new(cIdDoc as character) as object
    public method loadT157Block()
    public method getHasDataBlock() as logical
    public method getT157Block() as json
    protected method setIdDoc(cIdDoc as character)
    protected method getT157Data() as json
    protected method setHasDataBlock(lHasDataBlock as logical)
endClass


//-------------------------------------------------------------------
/*{Protheus.doc} new
    Construtor
    @return object: self
    @author guilhermed.santos
    @since 08/05/2025
    @version 12.1.2410
*/
//-------------------------------------------------------------------
method new(cIdDoc as character) as object class DataBlockT157
        self:setIdDoc(cIdDoc)
        self:jBlockT157 := jsonObject():new()
        self:setHasDataBlock(.F.)
return self

//-------------------------------------------------------------------
/*{Protheus.doc} setIdDoc
    @description Define o conteúdo da propriedade cIdDoc.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 08/05/2025
    @return
*/
//-------------------------------------------------------------------
method setIdDoc(cIdDoc as character) class DataBlockT157
    self:cIdDoc := cIdDoc
return



//-------------------------------------------------------------------
/*{Protheus.doc} loadT157Block
    @description Responsável por acionar os métodos de buscas de registros e montar o json na propriedade self:jBlockT157.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 08/05/2025
    @return
*/
//-------------------------------------------------------------------
method loadT157Block() class DataBlockT157
    local aArea      := {} as array
    local aAreaFKF   := {} as array

    aArea    := getArea()
    aAreaFKF := FKF->(getArea())

    dbSelectArea('FKF')
    FKF->(dbSetOrder(1)) //FKF_FILIAL+FKF_IDDOC
    if FKF->(dbSeek(xFilial('FKF')+self:cIdDoc))
        self:jBlockT157["T157"] := self:getT157Data()
    endIf

    if self:jBlockT157:hasProperty("T157") .and. len(self:jBlockT157["T157"]:getNames()) > 0
        self:setHasDataBlock(.T.)
    endIf

    restArea(aAreaFKF)
    restArea(aArea)
return


//-------------------------------------------------------------------
/*{Protheus.doc} getT157Block
    @description Retorna a propriedade self:jBlockT157.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 08/05/2025
    @return
*/
//-------------------------------------------------------------------
method getT157Block() as json class DataBlockT157
return self:jBlockT157

//-------------------------------------------------------------------
/*{Protheus.doc} getT157Data
    @description Montagem do Json do bloco T157.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 08/05/2025
    @return
*/
//-------------------------------------------------------------------
method getT157Data() as json class DataBlockT157
    local jT157 := jsonObject():new() as json
    local cWorkType := "2" as character
    local aAreaSON   := {} as array

    aAreaSON := SON->(getArea())

	dbSelectArea("SON")
	SON->(DBSetOrder(1))  //ON_FILIAL, ON_CODIGO
	if SON->(dbSeek( xFilial("SON") + FKF->FKF_CNO))
        if SON->ON_TPOBRA == THIRD_PARTY_WORK
            cWorkType := '1'
        endIf
        jT157['TP_INSCRICAO'] := SON->ON_TPINSCR
        jT157['NR_INSC_ESTAB'] := SON->ON_CNO
        jT157['IND_OBRA'] := SON->ON_IDOBRA
        jT157['IND_TERCEIRO'] := cWorkType
        jT157['INDCPRB'] := SON->ON_INDCPRB
        jT157['DESCRICAO'] := substr(SON->ON_DESC,1,30)
	endIF

    restArea(aAreaSON)

return jT157

//-------------------------------------------------------------------
/*{Protheus.doc} setHasDataBlock
    @description Define o conteúdo da propriedade self:lHasDataBlock.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 08/05/2025
    @return
*/
//-------------------------------------------------------------------
method setHasDataBlock(lHasDataBlock) class DataBlockT157
    self:lHasDataBlock := lHasDataBlock
return

//-------------------------------------------------------------------
/*{Protheus.doc} getHasDataBlock
    @description Retorna o conteúdo da propriedade self:lHasDataBlock.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 08/05/2025
    @return
*/
//-------------------------------------------------------------------
method getHasDataBlock() as logical class DataBlockT157
return self:lHasDataBlock
