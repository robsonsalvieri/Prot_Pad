#include "totvs.ch"
#include "msobject.ch"
#include "tlpp-rest.th"
#include "tlpp-core.th"
#include "totvs.framework.treports.integratedprovider.th"
#include "backoffice.sv.fin.generalaccountspayablestatus.ch"

namespace totvs.protheus.backoffice.fin.smartView.integratedProvider

@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGAFIN", tables="SE2,FK2,FK6,SC7", name="Posição Geral do Contas a Pagar", country="ALL")

//-------------------------------------------------------------------
/*/{Protheus.doc} GeneralAccountsPayableStatusReportSmartViewBusinessObject
Classe para criação do Objeto de Negócio para geração do Posição Geral do Contas a Pagar

@author Fábio Andrade
@since 26/05/2023
@version 1.0
*/
//-------------------------------------------------------------------
class GeneralAccountsPayableStatusReportSmartViewBusinessObject from totvs.protheus.backoffice.fin.smartView.integratedProvider.FinIntegratedProvider
    public method new() as object
    public method getData() as object
    public method mySetSchema()

    protected data lConvertCurrencyRate as logical

    protected data oQueryTitulos as object
    protected data oQueryBaixas as object
    protected data oQueryCompras as object
    protected data oQueryCompraMes as object

    protected data dDueDateFrom as date
    protected data dDueDateTo as date
    protected data dPostingDateFrom as date
    protected data dPostingDateTo as date  
    protected data cPrefixFrom as character
    protected data cPrefixTo as character
    protected data nCurrency as numeric
    protected data nListPosting as numeric
    protected data jRelationSE2SC7 as json
    protected data cChequeTypes as character

    protected method getListOfBills() 
    protected method getListOfPosting() 
    protected method getListOfPurchaseOrders()
    protected method getListOfPurchasesInMonth()
    
    protected method setDataListOfBills() as object
    protected method setDataListOfPosting() as object
    protected method setDataListOfPurchaseOrders() as object
    protected method setDataListOfPurchasesInMonth() as object

    protected method loadParameters()
    protected method loadDefaultParameters()
    protected method initializeBusinessObject() 
    protected method changeCanFilter()
    protected method filterWithRelationOfSC7() as character

    protected method getAgingCode() as numeric
    protected method getAgingText() as character
    protected method getTypeOfBillCode() as numeric
    protected method getTypeOfBillText() as character
    protected method getCategoryText() as character
    protected method getPurchaseTypeCode() as numeric
    protected method getPurchaseTypeText() as character
    protected method getTypeSeparator() as character
    protected method getNotInTypeTitle()
endclass

//-------------------------------------------------------------------
/*{Protheus.doc} new
Método de instância da classe

@return object: self

@author Fábio Andrade
@since 26/05/2023
@version 1.0
*/
//-------------------------------------------------------------------
method new() class GeneralAccountsPayableStatusReportSmartViewBusinessObject
    _Super:new()

    self:setCompleteData(.F.)
    self:initializeBusinessObject()
    self:setMainTable("SE2")
    self:setBranchFilter(.T., .T.)
return self

//-------------------------------------------------------------------
/*{Protheus.doc} initializeBusinessObject
    @author matheus.monteiro@totvs.com.br
    @since 02/01/2024
    @version 12.1.2310
*/
//-------------------------------------------------------------------
method initializeBusinessObject() class GeneralAccountsPayableStatusReportSmartViewBusinessObject
    self:setDisplayName(STR0002) //"Posição Geral do Contas a Pagar"
    self:setDescription(STR0003) //"Posição Geral do Contas a Pagar - Listagem de títulos por categoria e aging."
    self:setPergunte("FINR330")  
    
    If Type("MVCHEQUES") == "C"
        self:cChequeTypes := MVCHEQUES
    ElseIf Type("MVCHEQUE") == "C"
        self:cChequeTypes := MVCHEQUE
    Else
        self:cChequeTypes := ""
    EndIf
return


//-------------------------------------------------------------------
/*{Protheus.doc} getData
Retorna os dados do objeto de negócio

@param nPage, numérico, indica a página atual do relatório
@param oFilter, objeto, contém o filtro do TReports

@return object: self:oData

@author Fábio Andrade
@since 26/05/2023
@version 1.0
*/
//-------------------------------------------------------------------
method getData(nPage as numeric, oFilter as object) as object class GeneralAccountsPayableStatusReportSmartViewBusinessObject
    if !self:validEnvironment()
        return self:oData
    endIf

    self:setFilter(oFilter)
    self:setMVPAR()
    self:loadParameters()
    self:loadFilterBranches( { "SE2", "SC7" } )
    self:loadMainTableSelectedBranches()
    self:loadBranchNames()
    self:loadLGPDFields()

    //Carrega o bloco de compras no mes. Precisa de um dataset proprio porque
    //o bloco de titulos a pagar restringe saldo e vencimento, e as compras do
    //mes consideram tambem titulos ja quitados.
    self:getListOfPurchasesInMonth()
    self:cAlias := self:oQueryCompraMes:openAlias(/*cAlias*/, self:cLifeTime, self:cTimeout)
    self:setDataListOfPurchasesInMonth()
    (self:cAlias)->( DBCloseArea() )

    //Carrega o bloco de títulos a pagar
    self:getListOfBills()
    self:cAlias := self:oQueryTitulos:openAlias(/*cAlias*/, self:cLifeTime, self:cTimeout)
    self:setDataListOfBills()    
    (self:cAlias)->( DBCloseArea() )

    //Carrega o bloco de baixas
    self:getListOfPosting()
    self:cAlias := self:oQueryBaixas:openAlias(/*cAlias*/, self:cLifeTime, self:cTimeout)
    self:setDataListOfPosting()
    (self:cAlias)->( DBCloseArea() )

    //Carrega o bloco de pedidos de compras
    self:getListOfPurchaseOrders()
    self:cAlias := self:oQueryCompras:openAlias(/*cAlias*/, self:cLifeTime, self:cTimeout)
    self:setDataListOfPurchaseOrders()
    (self:cAlias)->( DBCloseArea() )
return self:oData

//-------------------------------------------------------------------
/*{Protheus.doc} getSchema
Retorna a estrutura dos campos e conjunto de parametros

@return object: self:oSchema

@author Fábio Andrade
@since 26/05/2023
@version 1.0
*/
//-------------------------------------------------------------------
method mySetSchema() class GeneralAccountsPayableStatusReportSmartViewBusinessObject
    Local aFieldsSE2 := {} as array
    Local aFieldsSED := {} as array
    Local aFieldsFK2 := {} as array

    aFieldsSE2 := { "E2_FILIAL", "E2_PREFIXO", "E2_PARCELA", "E2_TIPO", "E2_NATUREZ",;
        "E2_FORNECE", "E2_LOJA", "E2_NOMFOR", "E2_EMISSAO", "E2_BAIXA" }
    aFieldsSED := { "ED_DESCRIC" }
    aFieldsFK2 := { "FK2_VALOR" }

    self:jRelationSE2SC7 := {"E2_FILIAL":"C7_FILIAL","E2_FORNECE":"C7_FORNECE","E2_LOJA":"C7_LOJA","E2_EMISSAO":"C7_EMISSAO"}

    self:oSchema:aliasToSchema("SE2", aFieldsSE2)
    self:oSchema:aliasToSchema("SED", aFieldsSED)
    self:oSchema:aliasToSchema("FK2", aFieldsFK2)

    self:finAddProperty("TITULO_PEDIDO"  , STR0004, "string")   //"Nro. Título/Ped. Compras"
    self:finAddProperty("VENCIMENTO"     , STR0005, "date")     //"Vencto Tit./Prev. Entrega"
    self:finAddProperty("VALOR_TITPED"   , STR0006, "number")   //"Vlr. Titulo/Total Compras"
    self:finAddProperty("SALDO"          , STR0007, "number")   //"Vlr. em Aberto"
    self:finAddProperty("TIPOCOMPRA"     , STR0008, "string")   //"Tipo de Compra"
    self:finAddProperty("TIPOTITULO"     , STR0009, "string")   //"Tipo de Título"
    self:finAddProperty("CATEG_TITULO"   , STR0010, "string")   //"Classificação"
    self:finAddProperty("AGING_TITULO"   , STR0011, "string")   //"Aging do Título"
    self:finAddProperty("VALOR_CORRECAO" , STR0043, "number")   //"Valor de Correção"
    self:finAddProperty("VALOR_ACESSORIO", STR0044, "number")   //"Valor Acessório"
    self:finAddProperty("JUROS"          , FWX3Titulo("E2_JUROS")  , "number")
    self:finAddProperty("MULTA"          , FWX3Titulo("E2_MULTA")  , "number")
    self:finAddProperty("DESCONTO"       , FWX3Titulo("E2_DECRESC"), "number")

    //Codigos estaveis de identificacao dos blocos do relatorio legado FINR330. Nao dependem de idioma nem de localizacao.
	//Devem ser usados no design do Smart View no lugar dos campos de texto correspondentes.
    self:finAddProperty("COD_ORIGEM"     , STR0045, "number")   //"Cod. Origem do Registro"
    self:finAddProperty("COD_BLOCO"      , STR0046, "number")   //"Cod. Bloco do Relatorio"
    self:finAddProperty("COD_AGING"      , STR0047, "number")   //"Cod. Aging"
    self:finAddProperty("COD_TIPOTITULO" , STR0048, "number")   //"Cod. Tipo de Titulo"
    self:finAddProperty("COD_TIPOCOMPRA" , STR0049, "number")   //"Cod. Tipo de Compra"
    self:finAddProperty("COMPRA_MES"     , STR0050, "number")   //"Compras no Mês"
    self:finAddProperty("DIAS_PRAZO"     , STR0051, "number")   //"Dias de Prazo"

    FwFreeArray(aFieldsSE2)
    FwFreeArray(aFieldsSED)
    FwFreeArray(aFieldsFK2)

    self:changeCanFilter()

return self:oSchema

//-------------------------------------------------------------------
/*{Protheus.doc} getListOfBills
Retorna a query a ser executada na função getData

@return character: cQuery

@author Fábio Andrade
@since 26/05/2023
@version 1.0
*/
//-------------------------------------------------------------------
method getListOfBills()  class GeneralAccountsPayableStatusReportSmartViewBusinessObject
    Local cQuery  := "" as character
    Local nParamOrder := 1 as numeric
    local aTipoNotIn := {} as array

    //Obtem array para uso no setIn com os tipos de titulos
    self:getNotInTypeTitle(MVPROVIS, @aTipoNotIn)
    self:getNotInTypeTitle(MVABATIM, @aTipoNotIn)

    //Define a query do Objeto de Negócio
    cQuery := "SELECT "
    cQuery += "E2_FILIAL, E2_PREFIXO, E2_NUM, E2_PARCELA, E2_TIPO, "
    cQuery += "E2_NATUREZ, ED_DESCRIC, E2_FORNECE, E2_LOJA, E2_NOMFOR, "
    cQuery += "E2_EMISSAO, E2_VENCREA, E2_BAIXA, E2_VALOR, E2_SALDO, "
    cQuery += "E2_TXMOEDA, E2_MOEDA "
    
    cQuery += "FROM " + RetSQLName("SE2") + " SE2 "
    cQuery += "INNER JOIN " + RetSQLName("SED") + " SED ON " + FWJoinFilial("SED","SE2") + " AND "
    cQuery += " SED.ED_CODIGO = SE2.E2_NATUREZ AND "
    cQuery += " SED.D_E_L_E_T_ = ? "
    cQuery += "WHERE "
    if self:lEmptyMultiBranches
        cQuery += " SE2.E2_FILIAL = ? AND "
    else
        cQuery += " SE2.E2_FILIAL IN (?) AND "
    endIf
    cQuery += " SE2.E2_VENCREA BETWEEN ? AND ? AND "
    cQuery += " SE2.E2_PREFIXO BETWEEN ? AND ? AND "

    //Um NOT IN por constante: o separador dos tipos varia por localizacao
    //e agrupar tudo em um unico FormatIn corromperia a lista.
    cQuery += " SE2.E2_TIPO NOT IN (?) AND "

    cQuery += " SE2.E2_SALDO > ? AND "

    If !self:lConvertCurrencyRate
        cQuery += " SE2.E2_MOEDA = ? AND "
    EndIf

    cQuery += " SE2.D_E_L_E_T_ = ? "

    cQuery += " ? "

    cQuery += " ORDER BY ? "

    cQuery := ChangeQuery(cQuery)

    self:oQueryTitulos:= FWExecStatement():New(cQuery)

    self:oQueryTitulos:SetString(nParamOrder++, " ")
    if self:lEmptyMultiBranches
        self:oQueryTitulos:SetString(nParamOrder++, self:oFilterBranches["SE2"][1])
    else
        self:oQueryTitulos:SetIn(nParamOrder++, self:oFilterBranches["SE2"][1])
    endIf
    self:oQueryTitulos:SetDate(nParamOrder++, self:dDueDateFrom)
    self:oQueryTitulos:SetDate(nParamOrder++, self:dDueDateTo)
    self:oQueryTitulos:SetString(nParamOrder++, self:cPrefixFrom)
    self:oQueryTitulos:SetString(nParamOrder++, self:cPrefixTo)

    self:oQueryTitulos:SetIn(nParamOrder++, aTipoNotIn)

    self:oQueryTitulos:SetNumeric(nParamOrder++, 0)

    If !self:lConvertCurrencyRate
        self:oQueryTitulos:SetNumeric(nParamOrder++,self:nCurrency)
    EndIf

    self:oQueryTitulos:SetString(nParamOrder++," ")
    self:oQueryTitulos:SetUnsafe(nParamOrder++, self:getFilterToSQL())
    self:oQueryTitulos:SetUnsafe(nParamOrder++,  SqlOrder(SE2->(IndexKey( 1 ))))

Return 

//-------------------------------------------------------------------
/*{Protheus.doc} getListOfPosting
Retorna a query a ser executada na função getData

@return character: cQuery

@author Fábio Andrade
@since 26/05/2023
@version 1.0
*/
//-------------------------------------------------------------------
method getListOfPosting() class GeneralAccountsPayableStatusReportSmartViewBusinessObject
    Local cQuery      := "" as character
    Local nParamOrder := 1 as numeric

    cQuery := "SELECT "
	cQuery += " E2_FILIAL, E2_PREFIXO, E2_NUM, E2_PARCELA, E2_TIPO, E2_NATUREZ, "
	cQuery += " E2_FORNECE, E2_LOJA, E2_NOMFOR, E2_EMISSAO, E2_VENCREA, E2_BAIXA, "  
	cQuery += " E2_VALOR, E2_SALDO, ED_DESCRIC, FK2_TPDOC, FK2_TXMOED, FK2_MOTBX, "
	cQuery += " FK2_VALOR, FK2_VLMOE2, FK2_DATA, FK2_MOEDA, E2_MOEDA, E2_TXMOEDA " 
    cQuery += " ,(SELECT COALESCE(SUM(CASE WHEN FK6.FK6_TPDOC NOT IN ('DC', 'D2') THEN FK6.FK6_VALMOV ELSE -FK6.FK6_VALMOV END), 0) "
	cQuery += " 	FROM " + RetSQLName("FK6") + " FK6 "
	cQuery += " 	WHERE " + FWJoinFilial("FK6","FK2")
	cQuery += " 	AND FK6.FK6_IDORIG = FK2.FK2_IDFK2 "
	cQuery += " 	AND FK6.FK6_TABORI = ? "
	cQuery += " 	AND FK6.FK6_TPDOC IN (?) "
	cQuery += " 	AND FK6.D_E_L_E_T_ = ? ) AS VALOR_CORRECAO, "
    cQuery += " (SELECT COALESCE(SUM(FK6.FK6_VALMOV), 0) "
	cQuery += " 	FROM " + RetSQLName("FK6") + " FK6 "
	cQuery += " 	WHERE " + FWJoinFilial("FK6","FK2")
	cQuery += " 	AND FK6.FK6_IDORIG = FK2.FK2_IDFK2 "
	cQuery += " 	AND FK6.FK6_TABORI = ? "
	cQuery += " 	AND FK6.FK6_TPDOC = ? "
	cQuery += " 	AND FK6.D_E_L_E_T_ = ? ) AS VALOR_ACESSORIO "
    cQuery += " ,(SELECT COALESCE(SUM(FK6.FK6_VALMOV), 0) "
	cQuery += " 	FROM " + RetSQLName("FK6") + " FK6 "
	cQuery += " 	WHERE " + FWJoinFilial("FK6","FK2")
	cQuery += " 	AND FK6.FK6_IDORIG = FK2.FK2_IDFK2 "
	cQuery += " 	AND FK6.FK6_TABORI = ? "
	cQuery += " 	AND FK6.FK6_TPDOC = ? "
	cQuery += " 	AND FK6.D_E_L_E_T_ = ? ) AS JUROS "
    cQuery += " ,(SELECT COALESCE(SUM(FK6.FK6_VALMOV), 0) "
	cQuery += " 	FROM " + RetSQLName("FK6") + " FK6 "
	cQuery += " 	WHERE " + FWJoinFilial("FK6","FK2")
	cQuery += " 	AND FK6.FK6_IDORIG = FK2.FK2_IDFK2 "
	cQuery += " 	AND FK6.FK6_TABORI = ? "
	cQuery += " 	AND FK6.FK6_TPDOC IN (?) "
	cQuery += " 	AND FK6.D_E_L_E_T_ = ? ) AS MULTA "
    cQuery += " ,(SELECT COALESCE(SUM(FK6.FK6_VALMOV), 0) "
	cQuery += " 	FROM " + RetSQLName("FK6") + " FK6 "
	cQuery += " 	WHERE " + FWJoinFilial("FK6","FK2")
	cQuery += " 	AND FK6.FK6_IDORIG = FK2.FK2_IDFK2 "
	cQuery += " 	AND FK6.FK6_TABORI = ? "
	cQuery += " 	AND FK6.FK6_TPDOC IN (?) "
	cQuery += " 	AND FK6.D_E_L_E_T_ = ? ) AS DESCONTO "
    cQuery += " FROM " + RetSQLName("SE2") + " SE2 "
	cQuery += " INNER JOIN " + RetSQLName("SED") + " SED ON " + FWJoinFilial("SED","SE2") + " AND "
	cQuery += "  SED.ED_CODIGO = E2_NATUREZ AND "
	cQuery += "  SED.D_E_L_E_T_ = ? "
	cQuery += " INNER JOIN " + RetSQLName("FK7") + " FK7 ON " 
    cQuery += "  FK7.FK7_ALIAS = ? AND "
	cQuery += "  FK7.FK7_FILTIT = SE2.E2_FILIAL AND "
	cQuery += "  FK7.FK7_PREFIX = SE2.E2_PREFIXO AND "
    cQuery += "  FK7.FK7_NUM = SE2.E2_NUM AND "
	cQuery += "  FK7.FK7_PARCEL = SE2.E2_PARCELA AND "
	cQuery += "  FK7.FK7_TIPO = SE2.E2_TIPO AND "
	cQuery += "  FK7.FK7_CLIFOR = SE2.E2_FORNECE AND "
	cQuery += "  FK7.FK7_LOJA = SE2.E2_LOJA AND "
	cQuery += "  FK7.D_E_L_E_T_ = ? AND "
    cQuery += "  " + FWJoinFilial("FK7","SE2")
	cQuery += " INNER JOIN " + RetSQLName("FK2") + " FK2 ON " + FWJoinFilial("FK2","FK7") + " AND "
	cQuery += " FK2.FK2_IDDOC = FK7.FK7_IDDOC AND "
    cQuery += " FK2.FK2_MOTBX NOT IN(?) AND "

    If self:nListPosting == 2
        cQuery += " FK2.FK2_DTDIGI BETWEEN ? AND ? AND "
    Elseif self:nListPosting == 3
        cQuery += " FK2.FK2_DTDISP BETWEEN ? AND ? AND "
    Else
        cQuery += " FK2.FK2_DATA BETWEEN ? AND ? AND "
    EndIf
	
    cQuery += " FK2.FK2_RECPAG = ? AND "
	cQuery += " FK2.D_E_L_E_T_ = ? AND "
	cQuery += " NOT EXISTS( "
	cQuery += "  SELECT FK2EST.FK2_IDDOC FROM " + RetSQLName("FK2") +  "  FK2EST "
	cQuery += "  WHERE FK2EST.FK2_IDDOC = FK2.FK2_IDDOC "
    cQuery += "   AND FK2EST.FK2_SEQ = FK2.FK2_SEQ "
	cQuery += "   AND FK2EST.FK2_TPDOC = ? " 
	cQuery += "   AND FK2EST.D_E_L_E_T_ = ? ) "

	cQuery += "WHERE "
	if self:lEmptyMultiBranches
        cQuery += " SE2.E2_FILIAL = ? AND "
    else
        cQuery += " SE2.E2_FILIAL IN (?) AND "
    endIf
    cQuery += " SE2.E2_PREFIXO BETWEEN ? AND ? AND "

    If !self:lConvertCurrencyRate
        cQuery += " SE2.E2_MOEDA = ? AND "
    EndIf

    cQuery += " SE2.D_E_L_E_T_ = ? "

    cQuery += " ? "

    cQuery += " ORDER BY ? "

    cQuery := ChangeQuery(cQuery)

    self:oQueryBaixas:= FWExecStatement():New(cQuery)

    //SubQuery VALOR_CORRECAO
    self:oQueryBaixas:SetString(nParamOrder++, 'FK2')
    self:oQueryBaixas:SetIn(nParamOrder++, {'CM', 'VM','C2'})
    self:oQueryBaixas:SetString(nParamOrder++, " ")
    //SubQuery VALOR_ACESSORIO
    self:oQueryBaixas:SetString(nParamOrder++, 'FK2')
    self:oQueryBaixas:SetString(nParamOrder++, 'VA')
    self:oQueryBaixas:SetString(nParamOrder++, " ")
    //SubQuery JUROS
    self:oQueryBaixas:SetString(nParamOrder++, 'FK2')
    self:oQueryBaixas:SetString(nParamOrder++, 'JR')
    self:oQueryBaixas:SetString(nParamOrder++, " ")
    //SubQuery MULTA
    self:oQueryBaixas:SetString(nParamOrder++, 'FK2')
    self:oQueryBaixas:SetIn(nParamOrder++, {'MT', 'M2'})
    self:oQueryBaixas:SetString(nParamOrder++, " ")
    //SubQuery DESCONTO
    self:oQueryBaixas:SetString(nParamOrder++, 'FK2')
    self:oQueryBaixas:SetIn(nParamOrder++, {'D2', 'DC'})
    self:oQueryBaixas:SetString(nParamOrder++, " ")

    self:oQueryBaixas:SetString(nParamOrder++, " ")
    self:oQueryBaixas:SetString(nParamOrder++, 'SE2')
    self:oQueryBaixas:SetString(nParamOrder++, " ")
    //Os dois SetDate de faixa sao incondicionais porque o If/Elseif/Else da
    //coluna de data emite o BETWEEN em todos os ramos. Nao condicione um lado
    //sem o outro, e nao remova o Else: o statement amarra parametro por posicao
    //e o descasamento desloca todos os binds seguintes.
    self:oQueryBaixas:SetIn(nParamOrder++, {'DSD', 'FAT', 'LIQ', 'STP'})
    self:oQueryBaixas:SetDate(nParamOrder++, self:dPostingDateFrom)
    self:oQueryBaixas:SetDate(nParamOrder++, self:dPostingDateTo)
    self:oQueryBaixas:SetString(nParamOrder++, 'P')
    self:oQueryBaixas:SetString(nParamOrder++, " ")
    self:oQueryBaixas:SetString(nParamOrder++, 'ES')
    self:oQueryBaixas:SetString(nParamOrder++, " ")

    if self:lEmptyMultiBranches
        self:oQueryBaixas:SetString(nParamOrder++, self:oFilterBranches["SE2"][1])
    else
        self:oQueryBaixas:SetIn(nParamOrder++, self:oFilterBranches["SE2"][1])
    endIf
    
    self:oQueryBaixas:SetString(nParamOrder++,self:cPrefixFrom)
    self:oQueryBaixas:SetString(nParamOrder++,self:cPrefixTo)

    if !self:lConvertCurrencyRate
        self:oQueryBaixas:SetNumeric(nParamOrder++,self:nCurrency)
    endIf

    self:oQueryBaixas:SetString(nParamOrder++," ")
    self:oQueryBaixas:SetUnsafe(nParamOrder++, self:getFilterToSQL())
    self:oQueryBaixas:SetUnsafe(nParamOrder++, SqlOrder(SE2->(IndexKey( 1 ))))

Return

//-------------------------------------------------------------------
/*{Protheus.doc} getListOfPurchaseOrders
Retorna a query a ser executada na função getData

@return character: cQuery

@author Fábio Andrade
@since 26/05/2023
@version 1.0
*/
//-------------------------------------------------------------------
method getListOfPurchaseOrders() class GeneralAccountsPayableStatusReportSmartViewBusinessObject
    Local cQuery  := "" as character
    Local nParamOrder := 1 as numeric

    //Define a query do Objeto de Negócio
    cQuery := "SELECT "
	cQuery += " C7_FILIAL E2_FILIAL, C7_ITEM, C7_NUM, C7_TES, C7_QUJE, C7_QUANT, C7_PRECO, C7_TOTAL, "
	cQuery += " C7_FORNECE, C7_LOJA, A2_NOME, C7_EMISSAO, C7_DATPRF, C7_MOEDA, C7_TXMOEDA "

    cQuery += " FROM " + RetSQLName("SC7") + " SC7 "
	cQuery += " INNER JOIN " + RetSQLName("SA2") + " SA2 ON " + FWJoinFilial("SA2","SC7") + " AND "
	cQuery += " SA2.A2_COD = SC7.C7_FORNECE AND "
	cQuery += " SA2.A2_LOJA = SC7.C7_LOJA AND "
	cQuery += " SA2.D_E_L_E_T_ = ? "
	cQuery += "INNER JOIN " + RetSQLName("SF4") + " SF4 ON " + FWJoinFilial("SF4","SC7") + " AND "
	cQuery += " SF4.F4_CODIGO = SC7.C7_TES AND "
    cQuery += " SF4.F4_DUPLIC = ? AND "
	cQuery += " SF4.D_E_L_E_T_ = ? "
    cQuery += "WHERE "
    if self:lEmptyMultiBranches
        cQuery += " SC7.C7_FILIAL = ? AND "
    else
        cQuery += " SC7.C7_FILIAL IN (?) AND "
    endIf
	cQuery += " SC7.C7_QUJE < SC7.C7_QUANT AND "
	cQuery += " SC7.C7_RESIDUO <> ? AND "

    If !self:lConvertCurrencyRate
        cQuery += " SC7.C7_MOEDA = ? AND "
    EndIf
    
    cQuery += " SC7.D_E_L_E_T_ = ? "

    cQuery += " ? "

    cQuery := ChangeQuery(cQuery)

    self:oQueryCompras:= FWExecStatement():New(cQuery)

    self:oQueryCompras:SetString(nParamOrder++," ")
    self:oQueryCompras:SetString(nParamOrder++, 'S')
    self:oQueryCompras:SetString(nParamOrder++, " ")
    
    if self:lEmptyMultiBranches
        self:oQueryCompras:SetString(nParamOrder++, self:oFilterBranches["SC7"][1])
    else
        self:oQueryCompras:SetIn(nParamOrder++, self:oFilterBranches["SC7"][1])
    endIf

    self:oQueryCompras:SetString(nParamOrder++, 'S')
    
    if !self:lConvertCurrencyRate
        self:oQueryCompras:SetNumeric(nParamOrder++,self:nCurrency)
    endIf

    self:oQueryCompras:SetString(nParamOrder++," ")
    self:oQueryCompras:SetUnsafe(nParamOrder++, self:filterWithRelationOfSC7())

Return 

//-------------------------------------------------------------------
/*{Protheus.doc} getListOfPurchasesInMonth
Monta a query do bloco COMPRAS (no mes), equivalente ao acumulador
aCompras do FINR330 (Fa330Calc).

O universo e diferente do bloco de titulos a pagar: o legado considera
todo titulo emitido no mes corrente da data base, independente de saldo
e de vencimento, e por isso o bloco exige um dataset proprio. As regras
reproduzidas sao:

- emissao entre o primeiro dia do mes da data base e a propria data base
  (o legado combina Month/Year da emissao com o filtro E2_EMISSAO <= dDataBase);
- prefixo dentro da faixa dos parametros;
- tipos provisorio e abatimento descartados (MVPROVIS, MVABATIM);
- adiantamento e nota de debito descartados (MVPAGANT, MV_CPNEG), pois no
  legado o teste !(E2_TIPO $ MV_CPNEG+"/"+MVPAGANT) impede a acumulacao;
- titulos ja aglutinados em fatura descartados;
- titulos desdobrados descartados (baixa com motivo DSD).

@author raphael.ramos
@since 11/09/2026
@version 12.1.2510
*/
//-------------------------------------------------------------------
method getListOfPurchasesInMonth() class GeneralAccountsPayableStatusReportSmartViewBusinessObject
    Local cQuery      := "" as character
    Local nParamOrder := 1  as numeric
    Local dFirstDay   := FirstDate(dDataBase) as date
    local aTitNotIn   := {} as array

    //Obtem array para uso no setIn com os tipos de titulos
    self:getNotInTypeTitle(MVPROVIS, @aTitNotIn)
    self:getNotInTypeTitle(MVABATIM, @aTitNotIn)
    self:getNotInTypeTitle(MVPAGANT, @aTitNotIn)
    self:getNotInTypeTitle(MV_CPNEG, @aTitNotIn)

    cQuery := "SELECT "
    cQuery += " SE2.E2_FILIAL, SE2.E2_PREFIXO, SE2.E2_NUM, SE2.E2_PARCELA, SE2.E2_TIPO, "
    cQuery += " SE2.E2_NATUREZ, SE2.E2_FORNECE, SE2.E2_LOJA, SE2.E2_NOMFOR, "
    cQuery += " SE2.E2_EMISSAO, SE2.E2_VENCREA, SE2.E2_VALOR, SE2.E2_MOEDA, SE2.E2_TXMOEDA, "
    cQuery += " SED.ED_DESCRIC "
    cQuery += "FROM " + RetSQLName("SE2") + " SE2 "

    //No legado a natureza nao restringe as compras do mes, entao um cadastro de natureza ausente nao pode eliminar o titulo.
    cQuery += "LEFT JOIN " + RetSQLName("SED") + " SED ON " + FWJoinFilial("SED","SE2") + " AND "
    cQuery += " SED.ED_CODIGO = SE2.E2_NATUREZ AND "
    cQuery += " SED.D_E_L_E_T_ = ? "
    cQuery += "WHERE "
    if self:lEmptyMultiBranches
        cQuery += " SE2.E2_FILIAL = ? AND "
    else
        cQuery += " SE2.E2_FILIAL IN (?) AND "
    endIf
    cQuery += " SE2.E2_EMISSAO BETWEEN ? AND ? AND "
    cQuery += " SE2.E2_PREFIXO BETWEEN ? AND ? AND "

    //Um NOT IN por constante: o separador dos tipos varia por localizacao
    //e agrupar tudo em um unico FormatIn corromperia a lista.
    cQuery += " SE2.E2_TIPO NOT IN (?) AND "

    If !self:lConvertCurrencyRate
        cQuery += " SE2.E2_MOEDA = ? AND "
    EndIf

    //Titulo aglutinado em fatura ja emitida nao compoe as compras do mes. E2_DTFATUR em branco e tratado como fatura ainda nao emitida.
    cQuery += " ( SE2.E2_FATURA = ? OR SE2.E2_FATURA LIKE ? OR "
    cQuery += "   SE2.E2_DTFATUR = ? OR SE2.E2_DTFATUR > ? ) AND "

    //Titulo desdobrado e expurgado. O legado subtrai o valor dos acumuladores
    //quando localiza baixa com motivo DSD; excluir o registro produz o mesmo
    //total e evita o desvio do legado, que abate o valor sempre da linha
    //"A Vista" mesmo quando o titulo e a prazo.
    cQuery += " NOT EXISTS ( "
    cQuery += "  SELECT 1 FROM " + RetSQLName("FK7") + " FK7 "
    cQuery += "  INNER JOIN " + RetSQLName("FK2") + " FK2 ON " + FWJoinFilial("FK2","FK7") + " AND "
    cQuery += "   FK2.FK2_IDDOC = FK7.FK7_IDDOC AND "
    cQuery += "   FK2.FK2_MOTBX = ? AND "
    cQuery += "   FK2.FK2_RECPAG = ? AND "
    cQuery += "   FK2.D_E_L_E_T_ = ? "
    cQuery += "  WHERE FK7.FK7_ALIAS = ? AND "
    cQuery += "   FK7.FK7_FILTIT = SE2.E2_FILIAL AND "
    cQuery += "   FK7.FK7_PREFIX = SE2.E2_PREFIXO AND "
    cQuery += "   FK7.FK7_NUM = SE2.E2_NUM AND "
    cQuery += "   FK7.FK7_PARCEL = SE2.E2_PARCELA AND "
    cQuery += "   FK7.FK7_TIPO = SE2.E2_TIPO AND "
    cQuery += "   FK7.FK7_CLIFOR = SE2.E2_FORNECE AND "
    cQuery += "   FK7.FK7_LOJA = SE2.E2_LOJA AND "
    cQuery += "   FK7.D_E_L_E_T_ = ? AND "
    cQuery += "   " + FWJoinFilial("FK7","SE2")
    cQuery += " ) AND "

    cQuery += " SE2.D_E_L_E_T_ = ? "

    cQuery += " ? "

    cQuery := ChangeQuery(cQuery)

    self:oQueryCompraMes := FWExecStatement():New(cQuery)

    self:oQueryCompraMes:SetString(nParamOrder++, " ")

    if self:lEmptyMultiBranches
        self:oQueryCompraMes:SetString(nParamOrder++, self:oFilterBranches["SE2"][1])
    else
        self:oQueryCompraMes:SetIn(nParamOrder++, self:oFilterBranches["SE2"][1])
    endIf

    self:oQueryCompraMes:SetDate(nParamOrder++, dFirstDay)
    self:oQueryCompraMes:SetDate(nParamOrder++, dDataBase)
    self:oQueryCompraMes:SetString(nParamOrder++, self:cPrefixFrom)
    self:oQueryCompraMes:SetString(nParamOrder++, self:cPrefixTo)

    self:oQueryCompraMes:SetIn(nParamOrder++, aTitNotIn)

    If !self:lConvertCurrencyRate
        self:oQueryCompraMes:SetNumeric(nParamOrder++, self:nCurrency)
    EndIf

    self:oQueryCompraMes:SetString(nParamOrder++, " ")
    self:oQueryCompraMes:SetString(nParamOrder++, "NOTFAT%")
    self:oQueryCompraMes:SetString(nParamOrder++, " ")
    self:oQueryCompraMes:SetDate(nParamOrder++, dDataBase)

    //Subquery de desdobramento
    self:oQueryCompraMes:SetString(nParamOrder++, "DSD")
    self:oQueryCompraMes:SetString(nParamOrder++, "P")
    self:oQueryCompraMes:SetString(nParamOrder++, " ")
    self:oQueryCompraMes:SetString(nParamOrder++, "SE2")
    self:oQueryCompraMes:SetString(nParamOrder++, " ")

    self:oQueryCompraMes:SetString(nParamOrder++, " ")
    self:oQueryCompraMes:SetUnsafe(nParamOrder++, self:getFilterToSQL())

Return 

//-------------------------------------------------------------------
/*{Protheus.doc} setDataListOfPurchasesInMonth
Adiciona no objeto de negocios as linhas do bloco COMPRAS (no mes).

O valor da compra vai exclusivamente na propriedade COMPRA_MES, e nao
em VALOR_TITPED/SALDO, para que os totalizadores ja existentes no design
(valor do titulo e valor em aberto) continuem com o mesmo resultado apos
a entrada deste bloco. A quebra "A Vista" x "A Prazo" fica em DIAS_PRAZO
e em COD_TIPOCOMPRA.

@return object: self:oData

@author raphael.ramos
@since 11/09/2026
@version 12.1.2510
*/
//-------------------------------------------------------------------
method setDataListOfPurchasesInMonth() as object class GeneralAccountsPayableStatusReportSmartViewBusinessObject
    Local cCategoria  := "" as character
    Local cTipoCompra := "" as character
    Local nCodTpCompr := 0  as numeric
    Local nDiasPrazo  := 0  as numeric
    Local nCompraMes  := 0  as numeric
    Local nDecs       := MsDecimais(MV_PAR04) as numeric

    //Posiciona no registro inicial
    (self:cAlias)->(DBGoTop())

    cCategoria := self:getCategoryText(1) //COMPRAS (no mes)

    While !(self:cAlias)->(Eof())

        //Prazo da compra
        nDiasPrazo  := StoD((self:cAlias)->E2_VENCREA) - StoD((self:cAlias)->E2_EMISSAO)
        nCodTpCompr := self:getPurchaseTypeCode(nDiasPrazo)
        cTipoCompra := self:getPurchaseTypeText(nCodTpCompr)

        nCompraMes := xMoeda((self:cAlias)->E2_VALOR,(self:cAlias)->E2_MOEDA,MV_PAR04,;
            (self:cAlias)->E2_EMISSAO,nDecs+1,(self:cAlias)->E2_TXMOEDA)

        self:jData := {"E2_FILIAL":     AllTrim((self:cAlias)->E2_FILIAL),;
            "E2_FORNECE":   AllTrim((self:cAlias)->E2_FORNECE),;
            "E2_LOJA":      AllTrim((self:cAlias)->E2_LOJA),;
            "E2_NOMFOR":    AllTrim((self:cAlias)->E2_NOMFOR),;
            "E2_PREFIXO":   AllTrim((self:cAlias)->E2_PREFIXO),;
            "TITULO_PEDIDO":AllTrim((self:cAlias)->E2_NUM),;
            "E2_PARCELA":   AllTrim((self:cAlias)->E2_PARCELA),;
            "E2_TIPO":      AllTrim((self:cAlias)->E2_TIPO),;
            "E2_EMISSAO":   (self:varToTimeStamp((self:cAlias)->E2_EMISSAO )),;
            "VENCIMENTO":   (self:varToTimeStamp((self:cAlias)->E2_VENCREA )),;
            "E2_BAIXA":     Nil,;
            "VALOR_TITPED":   0,;
            "SALDO":          0,;
            "FK2_VALOR":      0,;
            "E2_NATUREZ":   MascNat((self:cAlias)->E2_NATUREZ),;
            "ED_DESCRIC":   AllTrim((self:cAlias)->ED_DESCRIC),;
            "TIPOCOMPRA":   cTipoCompra,;
            "TIPOTITULO":   "-",;
            "CATEG_TITULO": cCategoria,;
            "AGING_TITULO": "-",;
            "COD_ORIGEM":     4,;
            "COD_BLOCO":      1,;
            "COD_AGING":      0,;
            "COD_TIPOTITULO": 0,;
            "COD_TIPOCOMPRA": nCodTpCompr,;
            "COMPRA_MES":     nCompraMes,;
            "DIAS_PRAZO":     nDiasPrazo,;
            "JUROS":          0,;
            "MULTA":          0,;
            "DESCONTO":       0,;
            "VALOR_CORRECAO":0,;
            "VALOR_ACESSORIO":0;
            }

        self:processAndAppend()

        (self:cAlias)->( dbSkip() )

    EndDo
Return self:oData

//-------------------------------------------------------------------
/*{Protheus.doc} setDataListOfBills
Adiciona dados dos títulos em aberto no objeto de negócios

@return character: cQuery

@author Fábio Andrade
@since 26/05/2023
@version 1.0
*/
//-------------------------------------------------------------------
method setDataListOfBills() as object class GeneralAccountsPayableStatusReportSmartViewBusinessObject
    Local cTipoCompra := "" as character
    Local cTipoTitulo := "" as character
    Local cCategoria  := "" as character
    Local cAgingPagar := "" as character
    Local nDias       := 0  as numeric
    Local nSaldo      := 0  as numeric
    Local nValor      := 0  as numeric
    Local nCodBloco   := 0  as numeric
    Local nCodAging   := 0  as numeric
    Local nCodTipoTit := 0  as numeric
    Local nCodTpCompr := 0  as numeric
    Local nDiasPrazo  := 0  as numeric
    Local nDecs 	  := MsDecimais(MV_PAR04) as numeric

     //Posiciona no registro inicial
    (self:cAlias)->(DBGoTop())

    While !(self:cAlias)->(Eof())
        //Reinicializa a classificacao a cada registro.
        nDias       := 0
        nCodBloco   := 0
        nCodAging   := 0
        nCodTipoTit := 0
        cCategoria  := ""
        cTipoTitulo := "-"
        cAgingPagar := "-"

        //Tipo de Compra
        nDiasPrazo  := StoD((self:cAlias)->E2_VENCREA) - StoD((self:cAlias)->E2_EMISSAO)
        nCodTpCompr := self:getPurchaseTypeCode(nDiasPrazo)
        cTipoCompra := self:getPurchaseTypeText(nCodTpCompr)

        //Categoria do titulo
        If (self:cAlias)->E2_SALDO > 0
            If dDatabase <= StoD((self:cAlias)->E2_VENCREA) .OR. (self:cAlias)->E2_TIPO $ MVPAGANT
                nCodBloco := 3 //TITULOS A VENCER
                nDias := (StoD((self:cAlias)->E2_VENCREA) - dDatabase)
            Else
                nCodBloco := 4 //TITULOS VENCIDOS
                nDias := (dDatabase - StoD((self:cAlias)->E2_VENCREA))
            EndIf
            cCategoria := self:getCategoryText(nCodBloco)

            //Tipo do Titulo
            nCodTipoTit := self:getTypeOfBillCode((self:cAlias)->E2_TIPO, (self:cAlias)->E2_EMISSAO)
            cTipoTitulo := self:getTypeOfBillText(nCodTipoTit)

            //Classificação de Aging
            nCodAging   := self:getAgingCode(nDias)
            cAgingPagar := self:getAgingText(nCodAging)

        EndIf

        nValor := xMoeda((self:cAlias)->E2_VALOR,(self:cAlias)->E2_MOEDA,MV_PAR04,(self:cAlias)->E2_EMISSAO,nDecs+1,(self:cAlias)->E2_TXMOEDA)
        nSaldo := xMoeda((self:cAlias)->E2_SALDO,(self:cAlias)->E2_MOEDA,MV_PAR04,(self:cAlias)->E2_EMISSAO,nDecs+1,(self:cAlias)->E2_TXMOEDA)

        If (self:cAlias)->E2_TIPO $ (MVPAGANT + "|" + MV_CPNEG)
            nValor := nValor*-1
            nSaldo := nSaldo*-1
        EndIf

        self:jData := {"E2_FILIAL":     AllTrim((self:cAlias)->E2_FILIAL),;
            "E2_FORNECE":   AllTrim((self:cAlias)->E2_FORNECE),;
            "E2_LOJA":      AllTrim((self:cAlias)->E2_LOJA),;
            "E2_NOMFOR":    AllTrim((self:cAlias)->E2_NOMFOR),;
            "E2_PREFIXO":   AllTrim((self:cAlias)->E2_PREFIXO),;
            "TITULO_PEDIDO":AllTrim((self:cAlias)->E2_NUM),;
            "E2_PARCELA":   AllTrim((self:cAlias)->E2_PARCELA),;
            "E2_TIPO":      AllTrim((self:cAlias)->E2_TIPO),;
            "E2_EMISSAO":   (self:varToTimeStamp((self:cAlias)->E2_EMISSAO )),;
            "VENCIMENTO":   (self:varToTimeStamp((self:cAlias)->E2_VENCREA )),;
            "E2_BAIXA":     Nil,;
            "VALOR_TITPED":     nValor,;
            "SALDO":     nSaldo,;
            "FK2_VALOR":    0,;
            "E2_NATUREZ":   MascNat((self:cAlias)->E2_NATUREZ),;
            "ED_DESCRIC":   AllTrim((self:cAlias)->ED_DESCRIC),;
            "TIPOCOMPRA":   cTipoCompra,;
            "TIPOTITULO":   cTipoTitulo,;
            "CATEG_TITULO": cCategoria,;
            "AGING_TITULO": cAgingPagar,;
            "COD_ORIGEM":     1,;
            "COD_BLOCO":      nCodBloco,;
            "COD_AGING":      nCodAging,;
            "COD_TIPOTITULO": nCodTipoTit,;
            "COD_TIPOCOMPRA": nCodTpCompr,;
            "COMPRA_MES":     0,;
            "DIAS_PRAZO":     nDiasPrazo,;
            "JUROS":          0,;
            "MULTA":          0,;
            "DESCONTO":       0,;
            "VALOR_CORRECAO":0,;
            "VALOR_ACESSORIO":0;
            }

        self:processAndAppend()

        (self:cAlias)->( dbSkip() )

    EndDo
Return self:oData


//-------------------------------------------------------------------
/*{Protheus.doc} setDataListOfPosting
Adiciona dados das baixas no objeto de negócios

@return character: cQuery

@author Fábio Andrade
@since 30/05/2023
@version 1.0
*/
//-------------------------------------------------------------------
method setDataListOfPosting() as object class GeneralAccountsPayableStatusReportSmartViewBusinessObject
    Local cTipoCompra := "" as character
    Local cTipoTitulo := "" as character
    Local cCategoria  := "" as character
    Local cAgingPagar := "" as character
    Local nSaldo      := 0  as numeric
    Local nValor      := 0  as numeric
    Local nBaixa      := 0  as numeric
    Local nCodTpCompr := 0  as numeric
    Local nCodTipoTit := 0  as numeric
    Local nDecs 	  := MsDecimais(MV_PAR04) as numeric
    Local nMoeda      := 0  as numeric
    Local nTxMoeda    := 0  as numeric

   
     //Posiciona no registro inicial
    (self:cAlias)->(DBGoTop())

    cCategoria := self:getCategoryText(2) //VALORES BAIXADOS

    While !(self:cAlias)->(Eof())

        //Tipo de Compra
        nCodTpCompr := self:getPurchaseTypeCode(StoD((self:cAlias)->E2_VENCREA) - StoD((self:cAlias)->E2_EMISSAO))
        cTipoCompra := self:getPurchaseTypeText(nCodTpCompr)

        //Tipo do Titulo. Nas baixas a data de emissao nao restringe a
        //classificacao, ao contrario do bloco POR TIPO DE TITULO.
        nCodTipoTit := self:getTypeOfBillCode((self:cAlias)->E2_TIPO, (self:cAlias)->E2_EMISSAO, .F.)
        cTipoTitulo := self:getTypeOfBillText(nCodTipoTit)

        cAgingPagar := "-"

        nMoeda := Val(AllTrim((self:cAlias)->FK2_MOEDA))
        If (self:cAlias)->E2_TXMOEDA == 0
            nTxMoeda := RecMoeda((self:cAlias)->E2_EMISSAO, (self:cAlias)->E2_MOEDA)
        Else 
            nTxMoeda := (self:cAlias)->E2_TXMOEDA
        EndIf

        If nMoeda == (self:cAlias)->E2_MOEDA
           nTxMoeda := (self:cAlias)->FK2_TXMOED
        EndIf

        nValor := xMoeda((self:cAlias)->E2_VALOR,(self:cAlias)->E2_MOEDA,MV_PAR04,(self:cAlias)->E2_EMISSAO,nDecs+1,nTxMoeda)
        nSaldo := xMoeda((self:cAlias)->E2_SALDO,(self:cAlias)->E2_MOEDA,MV_PAR04,(self:cAlias)->E2_EMISSAO,nDecs+1,nTxMoeda)
        nBaixa := xMoeda((self:cAlias)->FK2_VALOR,nMoeda,MV_PAR04,(self:cAlias)->FK2_DATA ,nDecs+1,(self:cAlias)->FK2_TXMOED)

        If (self:cAlias)->E2_TIPO $ (MVPAGANT + "|" + MV_CPNEG)
            nValor := nValor*-1
            nSaldo := nSaldo*-1
            nBaixa := nBaixa*-1
        EndIf

        self:jData := {"E2_FILIAL":     AllTrim((self:cAlias)->E2_FILIAL),;
            "E2_FORNECE":     AllTrim((self:cAlias)->E2_FORNECE),;
            "E2_LOJA":        AllTrim((self:cAlias)->E2_LOJA),;
            "E2_NOMFOR":      AllTrim((self:cAlias)->E2_NOMFOR),;
            "E2_PREFIXO":     AllTrim((self:cAlias)->E2_PREFIXO),;
            "TITULO_PEDIDO":         AllTrim((self:cAlias)->E2_NUM),;
            "E2_PARCELA":     AllTrim((self:cAlias)->E2_PARCELA),;
            "E2_TIPO":        AllTrim((self:cAlias)->E2_TIPO),;
            "E2_EMISSAO":     (self:varToTimeStamp((self:cAlias)->E2_EMISSAO )),;
            "VENCIMENTO":     (self:varToTimeStamp((self:cAlias)->E2_VENCREA )),;
            "E2_BAIXA":       (self:varToTimeStamp((self:cAlias)->FK2_DATA )),;
            "VALOR_TITPED":       nValor,;
            "SALDO":       nSaldo,;
            "FK2_VALOR":      nBaixa,;
            "E2_NATUREZ":     MascNat((self:cAlias)->E2_NATUREZ),;
            "ED_DESCRIC":     AllTrim((self:cAlias)->ED_DESCRIC),;
            "TIPOCOMPRA":     cTipoCompra,;
            "TIPOTITULO":     cTipoTitulo,;
            "CATEG_TITULO":   cCategoria,;
            "AGING_TITULO":   cAgingPagar,;
            "COD_ORIGEM":     2,;
            "COD_BLOCO":      2,;
            "COD_AGING":      0,;
            "COD_TIPOTITULO": nCodTipoTit,;
            "COD_TIPOCOMPRA": nCodTpCompr,;
            "COMPRA_MES":     0,;
            "DIAS_PRAZO":     0,;
            "JUROS":          (self:cAlias)->JUROS,;
            "MULTA":          (self:cAlias)->MULTA,;
            "DESCONTO":       (self:cAlias)->DESCONTO,;
            "VALOR_CORRECAO": (self:cAlias)->VALOR_CORRECAO,;
            "VALOR_ACESSORIO":(self:cAlias)->VALOR_ACESSORIO;
            }

        self:processAndAppend()

        (self:cAlias)->( dbSkip() )
    EndDo
Return self:oData


//-------------------------------------------------------------------
/*{Protheus.doc} setDataListOfPurchaseOrders
Adiciona dados dos pedidos de compras no objeto de negócios

@return character: cQuery

@author Fábio Andrade
@since 30/05/2023
@version 1.0

*/
//-------------------------------------------------------------------
method setDataListOfPurchaseOrders() as object class GeneralAccountsPayableStatusReportSmartViewBusinessObject
    Local cTipoCompra := "" as character
    Local cTipoTitulo := "" as character
    Local cCategoria  := "" as character
    Local cAgingPagar := "" as character
    Local nDias       := 0  as numeric
    Local nVlrSaldo   := 0  as numeric
    Local nSaldo      := 0  as numeric
    Local nValor      := 0  as numeric
    Local nCodBloco   := 0  as numeric
    Local nCodAging   := 0  as numeric
    Local nCodTpCompr := 0  as numeric
    Local nDecs 	  := MsDecimais(MV_PAR04) as numeric

    //Posiciona no registro inicial
    (self:cAlias)->(DBGoTop())

    //Tipo de Compra
    nCodTpCompr := 3 //Pedido de Compra
    cTipoCompra := self:getPurchaseTypeText(nCodTpCompr)

    While !(self:cAlias)->(Eof())

        //Categoria do titulo
        If StoD((self:cAlias)->C7_DATPRF) < dDataBase
            nCodBloco := 6 //PEDIDOS DE COMPRA ATRASADOS
            nDias := dDataBase - StoD((self:cAlias)->C7_DATPRF)
        Else
            nCodBloco := 7 //PEDIDOS DE COMPRA ADIANTADOS
            nDias := StoD((self:cAlias)->C7_DATPRF) - dDataBase
        EndIf
        cCategoria := self:getCategoryText(nCodBloco)

        //Classificação de Aging
        nCodAging   := self:getAgingCode(nDias)
        cAgingPagar := self:getAgingText(nCodAging)

        //Situacao do atendimento do pedido
        If (self:cAlias)->C7_QUJE > 0
            cTipoTitulo := STR0041 //"Parcialmente atendido"
        Else
            cTipoTitulo := STR0042 //"Não atendido"
        EndIf

        nVlrSaldo := ((self:cAlias)->C7_QUANT - (self:cAlias)->C7_QUJE) * (self:cAlias)->C7_PRECO

        
        nValor := xMoeda((self:cAlias)->C7_TOTAL,(self:cAlias)->C7_MOEDA,MV_PAR04,(self:cAlias)->C7_EMISSAO,nDecs+1,(self:cAlias)->C7_TXMOEDA)
        nSaldo := xMoeda(nVlrSaldo         ,(self:cAlias)->C7_MOEDA,MV_PAR04,(self:cAlias)->C7_EMISSAO,nDecs+1,(self:cAlias)->C7_TXMOEDA)
        

        self:jData := {"E2_FILIAL":     AllTrim((self:cAlias)->E2_FILIAL),;
            "E2_FORNECE":   AllTrim((self:cAlias)->C7_FORNECE),;
            "E2_LOJA":      AllTrim((self:cAlias)->C7_LOJA),;
            "E2_NOMFOR":    AllTrim((self:cAlias)->A2_NOME),;
            "E2_PREFIXO":   "",;
            "TITULO_PEDIDO":       AllTrim((self:cAlias)->C7_NUM) + "-" + AllTrim((self:cAlias)->C7_ITEM),;
            "E2_PARCELA":   "",;
            "E2_TIPO":      "",;
            "E2_EMISSAO": (self:varToTimeStamp((self:cAlias)->C7_EMISSAO)) ,;
            "VENCIMENTO":   (self:varToTimeStamp((self:cAlias)->C7_DATPRF)),;
            "E2_BAIXA":     Nil,;
            "VALOR_TITPED":     nValor,;
            "SALDO":     nSaldo,;
            "FK2_VALOR":    0,;
            "E2_NATUREZ":   "",;
            "ED_DESCRIC":   "",;
            "TIPOCOMPRA":   cTipoCompra,;
            "TIPOTITULO":   cTipoTitulo,;
            "CATEG_TITULO": cCategoria,;
            "AGING_TITULO": cAgingPagar,;
            "COD_ORIGEM":     3,;
            "COD_BLOCO":      nCodBloco,;
            "COD_AGING":      nCodAging,;
            "COD_TIPOTITULO": 0,;
            "COD_TIPOCOMPRA": nCodTpCompr,;
            "COMPRA_MES":     0,;
            "DIAS_PRAZO":     0,;
            "JUROS":          0,;
            "MULTA":          0,;
            "DESCONTO":       0,;
            "VALOR_CORRECAO":0,;
            "VALOR_ACESSORIO":0;
            }

        self:processAndAppend()

        (self:cAlias)->( dbSkip() )
    EndDo

Return self:oData

//-------------------------------------------------------------------
/*/{Protheus.doc} loadDefaultParameters
    Inicializa as propriedades de parâmetros do objeto de negócio
    para não correr riscos de error.log.
    Será implementado no objeto de negócio.
    @author guilherme.sordi@totvs.com.br
    @since 08/11/2023
    @version 12.1.2310
*/
//-------------------------------------------------------------------
method loadDefaultParameters() class GeneralAccountsPayableStatusReportSmartViewBusinessObject
    self:nListPosting := 1
    self:dPostingDateFrom := cToD("  /  /    ")
    self:dPostingDateTo := cToD("  /  /    ")
    self:nCurrency := 1
    self:lConvertCurrencyRate := .F.
    self:cPrefixFrom := ""
    self:cPrefixTo := ""
    self:dDueDateFrom := cToD("  /  /    ")
    self:dDueDateTo := cToD("  /  /    ")
return

//-------------------------------------------------------------------
/*{Protheus.doc} loadParameters
@author Fábio Henrique Andrade
@since 16/06/2023
@version 12.1.2210
*/
//-------------------------------------------------------------------
method loadParameters() class GeneralAccountsPayableStatusReportSmartViewBusinessObject   
    if self:oCurrentFilter <> Nil
        self:nListPosting := MV_PAR01
        self:dPostingDateFrom := MV_PAR02
        self:dPostingDateTo := MV_PAR03
        self:nCurrency := MV_PAR04
        self:lConvertCurrencyRate := MV_PAR05 == 1
        self:cPrefixFrom := MV_PAR06
        self:cPrefixTo := MV_PAR07
        self:dDueDateFrom := MV_PAR08
        self:dDueDateTo := MV_PAR09
    endIf
return

//-------------------------------------------------------------------
/*{Protheus.doc} changeCanFilter
@author guilhermed.santos
@since 10/01/2024
@version 12.1.2310
*/
//-------------------------------------------------------------------
method changeCanFilter() class GeneralAccountsPayableStatusReportSmartViewBusinessObject
    local aSchemaProperties := {} as array
    local cProperty         := "" as character
    local nX                := 1  as numeric

    aSchemaProperties := self:oSchema:getProperties()
    
    for nX := 1 to Len(aSchemaProperties)
        cProperty := aSchemaProperties[nX]:getName()
        if !self:jRelationSE2SC7:hasProperty(cProperty)
            self:setCanFilter(cProperty,.F.)
        endIf
    next nX
return

//-------------------------------------------------------------------
/*{Protheus.doc} filterWithRelationOfSC7
@author guilhermed.santos
@since  10/01/2024
@version 12.1.2310
*/
//-------------------------------------------------------------------
method filterWithRelationOfSC7() as character class GeneralAccountsPayableStatusReportSmartViewBusinessObject
    local aRelationProperties   := {} as array
    local cFilter               := "" as character
    local nX                    := 1  as numeric

    cFilter := self:getFilterToSQL()

    if empty(cFilter)
        return cFilter
    endIf

    aRelationProperties := self:jRelationSE2SC7:GetNames()
    
    for nX := 1 to Len(aRelationProperties)
        cFilter := replace(cFilter,aRelationProperties[nX],self:jRelationSE2SC7:GetJSonObject(aRelationProperties[nX]))
    next nX

return cFilter

//-------------------------------------------------------------------
/*{Protheus.doc} getAgingCode
Retorna o codigo da faixa de aging a partir da quantidade de dias. 
Deve ser usado para identificar as linhas de aging no design do Smart View.

@param nDias, numeric, dias a vencer ou em atraso

@return numeric: 0 = nao se aplica, 1 = ate 15, 2 = 16 a 30, 3 = 31 a 60, 4 = 61 a 90, 5 = acima de 90

@author raphael.ramos
@since 10/09/2026
@version 12.1.2510
*/
//-------------------------------------------------------------------
method getAgingCode(nDias as numeric) as numeric class GeneralAccountsPayableStatusReportSmartViewBusinessObject
    Local nCodAging := 0 as numeric

    Default nDias := 0

    If nDias <= 15
        nCodAging := 1
    ElseIf nDias > 15 .And. nDias <= 30
        nCodAging := 2
    ElseIf nDias > 30 .And. nDias <= 60
        nCodAging := 3
    ElseIf nDias > 60 .And. nDias <= 90
        nCodAging := 4
    Else
        nCodAging := 5
    EndIf

Return nCodAging

//-------------------------------------------------------------------
/*{Protheus.doc} getAgingText
Retorna a descricao da faixa de aging a partir do codigo retornado
por getAgingCode. Derivar o texto do codigo garante que os dois nunca fiquem divergentes.

@param nCodAging, numeric, codigo da faixa de aging

@return character: descricao traduzida da faixa

@author raphael.ramos
@since 10/09/2026
@version 12.1.2510
*/
//-------------------------------------------------------------------
method getAgingText(nCodAging as numeric) as character class GeneralAccountsPayableStatusReportSmartViewBusinessObject
    Local cAgingText := "-" as character

    Default nCodAging := 0

    Do Case
        Case nCodAging == 1
            cAgingText := STR0022 //Ate 15 Dias
        Case nCodAging == 2
            cAgingText := STR0023 //De 16 a 30 Dias
        Case nCodAging == 3
            cAgingText := STR0024 //De 31 a 60 Dias
        Case nCodAging == 4
            cAgingText := STR0025 //De 61 a 90 Dias
        Case nCodAging == 5
            cAgingText := STR0026 //Acima de 90 Dias
    EndCase

Return cAgingText

//-------------------------------------------------------------------
/*{Protheus.doc} getTypeOfBillCode
Retorna o codigo do tipo de titulo. A classificacao depende das
constantes de localizacao (MVDUPLIC, MVNOTAFIS, MVTAXA, MVPAGANT,
MV_CPNEG), que variam por pais, mas o codigo devolvido e sempre o
mesmo, o que permite montar o bloco POR TIPO DE TITULO no design.
Os codigos 3 (cheque pre-datado) e 4 (carne de pagamento) estao
reservados e ainda nao sao produzidos por este metodo.

@param cTipo, character, conteudo de E2_TIPO
@param cEmissao, character, conteudo de E2_EMISSAO no formato AAAAMMDD

@return numeric: 
	0 = nao se aplica, 
	1 = duplicata, 
	2 = nota fiscal, 
	5 = imposto, 
	6 = pagamento antecipado, 
	7 = nota de debito, 
	8 = outros

@author raphael.ramos
@since 10/09/2026
@version 12.1.2510
*/
//-------------------------------------------------------------------
method getTypeOfBillCode(cTipo as character, cEmissao as character, lCheckIssueDate as logical) as numeric class GeneralAccountsPayableStatusReportSmartViewBusinessObject
    Local nCodTipoTit := 0 as numeric

    Default cTipo := ""
    Default cEmissao := ""
    Default lCheckIssueDate := .T.

    If lCheckIssueDate .And. StoD(cEmissao) > dDatabase
        Return nCodTipoTit
    EndIf

    Do Case
        Case cTipo $ MVDUPLIC
            nCodTipoTit := 1
        Case cTipo $ MVNOTAFIS
            nCodTipoTit := 2
        Case !Empty(self:cChequeTypes) .And. cTipo $ self:cChequeTypes
            nCodTipoTit := 3
        Case AllTrim(cTipo) == "CN"
            nCodTipoTit := 4
        Case cTipo $ MVTAXA
            nCodTipoTit := 5
        Case cTipo $ MVPAGANT
            nCodTipoTit := 6
        Case cTipo $ MV_CPNEG
            nCodTipoTit := 7
        OtherWise
            nCodTipoTit := 8
    EndCase

Return nCodTipoTit

//-------------------------------------------------------------------
/*{Protheus.doc} getTypeOfBillText
Retorna a descricao do tipo de titulo a partir do codigo retornado por getTypeOfBillCode.

@param nCodTipoTit, numeric, codigo do tipo de titulo

@return character: descricao traduzida do tipo de titulo

@author raphael.ramos
@since 10/09/2026
@version 12.1.2510
*/
//-------------------------------------------------------------------
method getTypeOfBillText(nCodTipoTit as numeric) as character class GeneralAccountsPayableStatusReportSmartViewBusinessObject
    Local cTipoTitulo := "-" as character

    Default nCodTipoTit := 0

    Do Case
        Case nCodTipoTit == 1
            cTipoTitulo := STR0014 //Duplicatas
        Case nCodTipoTit == 2
            cTipoTitulo := STR0015 //Notas fiscais
        Case nCodTipoTit == 3
            cTipoTitulo := STR0016 //Cheques Pre-Datados
        Case nCodTipoTit == 4
            cTipoTitulo := STR0017 //Carne de Pagamento
        Case nCodTipoTit == 5
            cTipoTitulo := STR0018 //Impostos
        Case nCodTipoTit == 6
            cTipoTitulo := STR0019 //Pagamento antecipado
        Case nCodTipoTit == 7
            cTipoTitulo := STR0020 //Nota de Debito
        Case nCodTipoTit == 8
            cTipoTitulo := STR0021 //Outros
    EndCase

Return cTipoTitulo

//-------------------------------------------------------------------
/*{Protheus.doc} getCategoryText
Retorna a descricao da categoria a partir do codigo do bloco.
A numeracao do bloco segue a ordem das secoes do relatorio legado
FINR330, para que ordenar pelo codigo reproduza a ordem impressa.

@param nCodBloco, numeric, codigo do bloco do relatorio

@return character: descricao traduzida da categoria

@author raphael.ramos
@since 10/09/2026
@version 12.1.2510
*/
//-------------------------------------------------------------------
method getCategoryText(nCodBloco as numeric) as character class GeneralAccountsPayableStatusReportSmartViewBusinessObject
    Local cCategoria := "" as character

    Default nCodBloco := 0

    Do Case
        Case nCodBloco == 1
            //TODO Trocar a descricao literal por constante STR antes de publicar.
            cCategoria := STR0050 //"Compras no Mês"
        Case nCodBloco == 2
            cCategoria := STR0027 //VALORES BAIXADOS
        Case nCodBloco == 3
            cCategoria := STR0012 //TITULOS A VENCER
        Case nCodBloco == 4
            cCategoria := STR0013 //TITULOS VENCIDOS
        Case nCodBloco == 6
            cCategoria := STR0039 //PEDIDOS DE COMPRA ATRASADOS
        Case nCodBloco == 7
            cCategoria := STR0040 //PEDIDOS DE COMPRA ADIANTADOS
    EndCase

Return cCategoria

//-------------------------------------------------------------------
/*{Protheus.doc} getPurchaseTypeCode
Retorna o codigo do tipo de compra a partir do prazo em dias entre a emissao e o vencimento do titulo.

@param nDiasPrazo, numeric, dias entre emissao e vencimento

@return numeric: 
	1 = a vista, 
	2 = a prazo

@author raphael.ramos
@since 10/09/2026
@version 12.1.2510
*/
//-------------------------------------------------------------------
method getPurchaseTypeCode(nDiasPrazo as numeric) as numeric class GeneralAccountsPayableStatusReportSmartViewBusinessObject
    Local nCodTpCompr := 0 as numeric

    Default nDiasPrazo := 0

    If nDiasPrazo <= 1
        nCodTpCompr := 1
    Else
        nCodTpCompr := 2
    EndIf

Return nCodTpCompr

//-------------------------------------------------------------------
/*{Protheus.doc} getPurchaseTypeText
Retorna a descricao do tipo de compra a partir do codigo.
O codigo 3 identifica os registros originados de pedido de compra.

@param nCodTpCompr, numeric, codigo do tipo de compra

@return character: descricao traduzida do tipo de compra

@author raphael.ramos
@since 10/09/2026
@version 12.1.2510
*/
//-------------------------------------------------------------------
method getPurchaseTypeText(nCodTpCompr as numeric) as character class GeneralAccountsPayableStatusReportSmartViewBusinessObject
    Local cTipoCompra := "" as character

    Default nCodTpCompr := 0

    Do Case
        Case nCodTpCompr == 1
            cTipoCompra := STR0028 //A vista
        Case nCodTpCompr == 2
            cTipoCompra := STR0029 //A prazo
        Case nCodTpCompr == 3
            cTipoCompra := STR0038 //Pedido de Compra
    EndCase

Return cTipoCompra


//-------------------------------------------------------------------
/*{Protheus.doc} getTypeSeparator
Retorna o separador usado na constante de tipos de titulo informada.
As constantes de localizacao (MVPROVIS, MVABATIM, MVPAGANT, MV_CPNEG)
podem trazer mais de um tipo separado por "|" ou por ",", e o FormatIn
precisa receber o separador correto para montar a lista do IN.

@param cTypes, character, conteudo da constante de tipos

@return character: "|" quando a constante usa pipe, "," caso contrario

@author raphael.ramos
@since 11/09/2026
@version 12.1.2510
*/
//-------------------------------------------------------------------
method getTypeSeparator(cTypes as character) as character class GeneralAccountsPayableStatusReportSmartViewBusinessObject
    Local cSeparator := "," as character

    Default cTypes := ""

    If "|" $ cTypes
        cSeparator := "|"
    EndIf

Return cSeparator

//-----------------------------------------------------------------
/*{Protheus.doc} getNotInTypeTitle
    Realiza a separação do coneteudo informado do parametro cVarParam com base no tipo de separador retornado da
    função getTypeSeparator

    @param cVarParam, Character, conteudo do parametro a ser separado
    @param aParamDest, Array, Array que recebrá o conteudo informado no cVarparam após a separação

    @author raphael.ramos
    @since 21/09/2026
    @version 12.1.2510
*/
//-----------------------------------------------------------------
method getNotInTypeTitle(cVarParam as character, aParamDest as array) class GeneralAccountsPayableStatusReportSmartViewBusinessObject

    local aParamOri     := {}   as array

    default cVarParam   := ""
    default aParamDest  := {}

    If ValType(cVarParam) == "C" .AND. !Empty(cVarParam)
        aParamOri := StrTokArr2(cVarParam, self:getTypeSeparator(cVarParam))

        If Len(aParamOri) > 0
            AEval(aParamOri, {|x| AAdd(aParamDest, x)})
        EndIf
    EndIf

return
