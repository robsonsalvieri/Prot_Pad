#include "tlpp-core.th"
#include "Totvs.ch"

NAMESPACE totvs.protheus.backoffice.techfin.util

/*/{Protheus.doc} GcadTstOccurrences
    Controle de ocorrências sobre eventos

    @type       Class
    @author     Totvs
    @since      3/27/2026
    @version    P12.1.2510  
/*/
Class GcadTstOccurrences

    data jData       as json
    data cProdTF     as character
    data cLog        as character
    data cIdDoc      as character
    
    public method new()  constructor    
    public method TSTsetProduct()
    public method TSTsetLog()
    public method TSTsetIdDoc()    
    public method TSTRegister()
    private method TSTLoadOccurreces()
    
end class


/*/{Protheus.doc} GcadTstOccurrences::New
    Método construtor da classe    
    @type   method
    @author Squad TechFin
    @since  3/27/2026
/*/
method new() class GcadTstOccurrences
    ::cProdTF   := ""
    ::cLog      := ""
    ::cIdDoc    := ""
    ::jData     := JsonObject():new()    
return Self

/*/{Protheus.doc} GcadTstOccurrences::TSTsetProduct
    Define o produto Techfin
    @type method
    @author Squad TechFin
    @since  3/27/2026
/*/
method TSTsetProduct( cProdTF as character ) class GcadTstOccurrences
    ::cProdTF := cProdTF
    ::TSTLoadOccurreces()
return

/*/{Protheus.doc} GcadTstOccurrences::TSTsetLog
    Define um Log detalhado da ocorrência 
    @type method
    @author Squad TechFin
    @since  3/27/2026
/*/
method TSTsetLog( cLog as character ) class GcadTstOccurrences
    ::cLog := cLog
return

/*/{Protheus.doc} GcadTstOccurrences::TSTsetIdDoc
    Define o IdDoc do título
    @type method
    @author Squad TechFin
    @since  3/27/2026
/*/
method TSTsetIdDoc( cIdDoc as character ) class GcadTstOccurrences
    ::cIdDoc := cIdDoc
return

/*/{Protheus.doc} GcadTstOccurrences::TSTLoadOccurreces
    Carrega lista de ocorrências
    @type   method
    @author Squad TechFin
    @since  3/27/2026
/*/
method TSTLoadOccurreces() class GcadTstOccurrences    
    Local cContent:="" as character
    
    Do Case         
        //Duplicata Escritural
        Case ::cProdTF == "5" 
            BeginContent Var cContent    
            {
            "001": {"description": "Título enviado para escrituração",       "origin": "1"},
            "002": {"description": "Escriturado com sucesso",                "origin": "2"},
            "003": {"description": "Falha na escrituração do título",        "origin": "2"},
            "004": {"description": "Solicitado bloqueio na escrituradora",   "origin": "1"},
            "005": {"description": "Solicitado desbloqueio na escrituradora","origin": "1"},
            "006": {"description": "Bloqueio realizado",                     "origin": "2"},
            "007": {"description": "Bloqueio não realizado",                 "origin": "2"},
            "008": {"description": "Desbloqueio realizado",                  "origin": "2"},
            "009": {"description": "Desbloqueio não realizado",              "origin": "2"},
            "010": {"description": "Solicitada alteração de dados do título","origin": "1"},
            "011": {"description": "Alteração de dados processada.",         "origin": "2"},
            "012": {"description": "Alteração de dados não realizada.",      "origin": "2"}
            }
            EndContent

        //Garantias
        Case ::cProdTF == "6" 
            BeginContent Var cContent    
            {
            "001": {"description": "Titulo enviado para Garantia",  "origin": "1"},
            "002": {"description": "Titulo aceito como Garantia",   "origin": "2"},
            "003": {"description": "Titulo Rejeitado",              "origin": "2"}
            }
            EndContent
    EndCase

    ::jData:fromJson(cContent)
return

/*/{Protheus.doc} GcadTstOccurrences::TSTRegister
    Gravação da ocorrência.

    @type method
    @author Squad TechFin
    @since  3/27/2026
/*/
method TSTRegister( cCodOccurrence as character) class GcadTstOccurrences

    local aArea         := {} as array
    local cOrigin       := "" as character
    local cDescription  := "" as character

    aArea           := FwGetArea()
    cOrigin         := "1"//ERP
    cDescription    := "Ocorrência "+cCodOccurrence+" não identificada."

    //-------------------------------------------------------------------------
    //Aguardando include par usar dessa forma... (não remover)
    //cDescription    := i18n(STR0001, {cCodOccurrence})//Ocorrência XXX não identificada.        

    If ::jData:hasProperty(cCodOccurrence)
        cOrigin      := ::jData[cCodOccurrence]["origin"]
        cDescription := ::jData[cCodOccurrence]["description"]        
    EndIF

    dbSelectArea('ARQ')
    RecLock('ARQ', .T.)
    ARQ_FILIAL := FwxFilial()
    ARQ_IDDOC  := ::cIdDoc
    ARQ_PRODTF := ::cProdTF
    ARQ_ORIGEM := cOrigin
    ARQ_DATA   := Date()
    ARQ_HORA   := Substr(Time(),1,5)
    ARQ_DESC   := cDescription
    ARQ_LOG    := ::cLog
    msUnLock()

    /*
    --------------------------------------------------------------------------------------------------------------
    // Se decidirmos que vai atualizar aquele campo no browse pricipal "Ocorrencia", conforme o ultimo
    evento de erro, cria um método aqui tipo assim:
    Method UpdMainOcurrence(.T.)
        lUpdMainOcurrence := .T.
    Return
    Ai no método que grava a ARQ, passamos a agravar também o campo da ARP
    Necessário mapear os processos que atualizam esse campo (nao são todos).

    */    
    
    FwRestArea(aArea)
    FwFreeArray(aArea)
return
