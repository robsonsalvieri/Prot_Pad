
#include "tlpp-core.th"
#include "totvs.ch"

namespace totvs.protheus.retail.smartschedule.LjExecSmartSchedule
/*/{Protheus.doc} VerificaStatus
Verifica se o Smart Schedule está ativo e se a rotina informada possui agendamento ativo cadastrado.
Utilizada como guarda de execução no início de rotinas agendadas para evitar que sejam disparadas
manualmente enquanto já existir um agendamento ativo no Smart Schedule.
@type function
@author Caio Okamoto
@since 19/08/2026
@version 12.1.2610
@param cRotina, character, Nome da rotina a ser verificada nos agendamentos ativos do Smart Schedule.
@return logical, .T. se o Smart Schedule está ativo e há agendamento ativo para a rotina informada (execução manual deve ser bloqueada). .F. se o Smart Schedule está inativo ou não há agendamento ativo para a rotina (execução manual permitida).
@obs Recomenda-se chamar esta função no início da rotina principal quando invocada pelo menu, bloqueando a execução caso retorne .T. e exibindo mensagem orientativa ao usuário.
/*/
Function VerificaStatus(cRotina as character)
Local oSchedInfo  	:= Nil  as object
Local aActiveSch 	:= {}   as array
Local lRet 	        := .F.  as logical

oSchedInfo := totvs.framework.schedule.information.ScheduleInformation():New()

If oSchedInfo:getSmartScheduleIsRunning()
    LjGrvLog(Nil, "VerificaStatus | Smart Schedule ativo. Verificando agendamento para: " + cRotina)
    aActiveSch := oSchedInfo:getSchedulesByRoutine(cRotina,, "0")

    If Len(aActiveSch) > 0
        lRet  := .T.
        LjGrvLog(Nil, "VerificaStatus | Agendamento ativo encontrado para: " + cRotina )
    Else 
        LjGrvLog(Nil, "VerificaStatus | Nenhum agendamento ativo encontrado para: " + cRotina )
    EndIf
Else
    LjGrvLog(Nil, "VerificaStatus | Smart Schedule inativo. Execucao manual para: " + cRotina)
EndIf 

Return lRet


