#include "tlpp-core.th"
#include "totvs.ch"
#include "fwmcptool.th"
#include "retail.ranking.recording.post.ch"

namespace totvs.protheus.retail.ranking.recording

//------------------------------------------------------------------
/*/{Protheus.doc} GetRankingInsightSellers
Tool para consulta de ranking e insight de vendedores

@author Nilson Sacchi Junior
@since  03/08/2026
@version 1.0
/*/
//-------------------------------------------------------------------
@FWToolMCP(action="post", erpRelease="12.1.2410", routine="LOJA9000", option=2, module="SIGALOJA")
class GravaRankingInsights implements FWMCPTool
    public method new() as object
    public method getDescription() as character
    public method getNotes() as character
    public method getPayLoadSchema() as json
    public method process(jPayLoad as json) as json
    public method getReturnSchema() as json
    public method getMetrics() as array
end class

//------------------------------------------------------------------
/*/{Protheus.doc} new
Construtor da classe

@author Nilson Sacchi Junior
@since  03/08/2026
@version 1.0
/*/
//-------------------------------------------------------------------
method new() as object class GravaRankingInsights
return self

//------------------------------------------------------------------
/*/{Protheus.doc} getDescription
Informa a descricao da tool

@return cDesc, character, Descricao da tool

@author Nilson Sacchi Junior
@since  03/08/2026
@version 1.0
/*/
//-------------------------------------------------------------------
method getDescription() as character class GravaRankingInsights
return STR0001 // "Tool para gravação de ranking e insight de vendedores"

//------------------------------------------------------------------
/*/{Protheus.doc} getNotes
Informa notas adicionais sobre a tool

@return cNotes, character, Notas sobre a tool

@author Nilson Sacchi Junior
@since  03/08/2026
@version 1.0
/*/
//-------------------------------------------------------------------
method getNotes() as character class GravaRankingInsights
return STR0002 // "Retorna o status da gravação do ranking"

//------------------------------------------------------------------
/*/{Protheus.doc} getPayLoadSchema
Retorna o schema de entrada da tool

@return jSchema, json, Schema de entrada da tool

@author Nilson Sacchi Junior
@since  03/08/2026
@version 1.0
/*/
//-------------------------------------------------------------------
method getPayLoadSchema() as json class GravaRankingInsights
    local jSchema as json

    jSchema := totvs.framework.mcp.tools.getJsonSchema()
    jSchema["type"] := "object"
    jSchema["required"] := { "dados" }
    jSchema["properties"] := { "dados": { "type": "string" } }
return jSchema

//------------------------------------------------------------------
/*/{Protheus.doc} getReturnSchema
Retorna o schema de retorno da tool

@return jSchema, json, Schema de retorno da tool

@author Nilson Sacchi Junior
@since  03/08/2026
@version 1.0
/*/
//-------------------------------------------------------------------
method getReturnSchema() as json class GravaRankingInsights
    local jSchema as json

    jSchema := totvs.framework.mcp.tools.getJsonSchema()
    jSchema["properties"] := { "status": { "type": "string" } }
    jSchema["required"] := { "status" }

return jSchema

//------------------------------------------------------------------
/*/{Protheus.doc} process
Metodo de processamento da tool

@param jPayLoad, json, Parametros de entrada da tool
@return jResp, json, Resposta da tool

@author Nilson Sacchi Junior
@since  03/08/2026
@version 1.0
/*/
//-------------------------------------------------------------------
method process(jPayLoad as json) as json class GravaRankingInsights
    local jDados         as json
    local jResp          as json
    local jRet           as json
    Local lRet           as logical
    Local xJsonParse     as Variant
    Local oGravarRanking as object
    Local oJsonMessage   as object

    jResp := JsonObject():new()
    jResp["status"]  := STR0003 // "Não foi possivel gravar no banco"
    
    if jPayLoad:hasProperty("dados")
        oJsonMessage    := JsonObject():new()

        jDados := jPayLoad["dados"]
        xJsonParse      := oJsonMessage:fromJson( jDados )
        
        If Empty(xJsonParse)

            jDados := StrTran(jDados, "%Exp:cMessageId%", FWUUIDV4(.T.))

            If !Empty(oJsonMessage["data"]["data"]["tenantInsights"][1]["insights"]["LOJA"]["chave"])
                jDados := StrTran(jDados, "%Exp:cTransactionId%", MD5(oJsonMessage["data"]["data"]["tenantInsights"][1]["insights"]["LOJA"]["chave"])) 
            
                oGravarRanking := RnkInsPost():New()
                lRet           := oGravarRanking:Gravar(jDados)

                If lRet
                    jResp["status"]  := STR0004 // "Ranking gravado com sucesso"
                Endif
            Else
                jResp["status"]  := STR0005 // "Chave não encontrada"
            Endif
        Else
            jResp["status"]  := STR0006 //"Payload inválido, json inválido"
        Endif
    endif

    freeObj(oGravarRanking)
    freeObj(oJsonMessage)
    freeObj(jRet)

return jResp

//------------------------------------------------------------------
/*/{Protheus.doc} getMetrics
Retorna as métricas de consumo da Tool, definir com produto para como retornar
 
@return array, consumo da Tool
 
@author Nilson Sacchi Junior
@since  08/09/2026
@version 1.0
/*/
//-------------------------------------------------------------------
method getMetrics() as array class GravaRankingInsights
local aMetrics as array
 
aMetrics := {}
 
aAdd(aMetrics, {"name": "vendedor", "value": 1} )
aAdd(aMetrics, {"name": "insight", "value": 2} )
 
return aMetrics
