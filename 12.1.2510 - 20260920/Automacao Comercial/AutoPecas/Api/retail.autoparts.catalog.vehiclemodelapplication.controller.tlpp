#include "totvs.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "fwmvcdef.ch"
#include "retail.autoparts.catalog.vehiclemodelapplication.controller.ch"

//               Nome do parametro no JSON     , Campo no SX3   , Tipo
Static aFields :=   { ;
                    {"vehicleModelUuid"        , "MF0_UIDMOD"   , "C"    },;
                    {"productBranch"           , "MF0_FILPRO"   , "C"    },;
                    {"productCode"             , "MF0_CODPRO"   , "C"    },;
                    {"systemSetCode"           , "MF0_CNJSIS"   , "C"    };
                    } as Array

namespace totvs.protheus.retail.autoparts.catalog.vehiclemodelapplication.controller

/*/{Protheus.doc} RetailAutopartsCatalogVehicleModelApplicationController
    API relacionada a aplicacao de produto ao modelo de veiculo do catalogo de autopecas
    @type    class
    @author  eduardo.FLima
    @since   23/06/2026
/*/
Class RetailAutopartsCatalogVehicleModelApplicationController

    public Method New() as Object

    private Method PositionMF0ByKey(cVehicleModelUuid as Character, cProductBranch as Character, cProductCode as Character, cSystemSetCode as Character) as Logical
    private Method FindVehicleModelApplication(cVehicleModelUuid as Character, cProductCode as Character, cSystemSetCode as Character) as Array
    private Method CountVehicleModelApplication() as Numeric

    @Get("/api/retail/v1/retailAutopartsCatalogVehicleModelApplication/getDataForVehicleModelApplication", description="Consulta as aplicacoes de produto ao modelo de veiculo do catalogo de autopecas, podendo filtrar por uuid do modelo, codigo do produto e codigo do conjunto sistema")
    public Method getDataForVehicleModelApplication() as Logical

    @Get("/api/retail/v1/retailAutopartsCatalogVehicleModelApplication/getCountDataForVehicleModelApplication", description="Consulta a quantidade total de aplicacoes de produto ao modelo de veiculo do catalogo de autopecas")
    public Method getCountDataForVehicleModelApplication() as Logical

    @Post("/api/retail/v1/retailAutopartsCatalogVehicleModelApplication/postDataForVehicleModelApplication", description="Cadastra uma nova aplicacao de produto ao modelo de veiculo para o catalogo de autopecas")
    public Method postDataForVehicleModelApplication() as Logical

    @Put("/api/retail/v1/retailAutopartsCatalogVehicleModelApplication/putDataForVehicleModelApplication/:vehicleModelUuid", description="Altera uma aplicacao de produto ao modelo de veiculo existente no catalogo de autopecas")
    public Method putDataForVehicleModelApplication() as Logical

    @Delete("/api/retail/v1/retailAutopartsCatalogVehicleModelApplication/deleteDataForVehicleModelApplication/:vehicleModelUuid", description="Deleta uma aplicacao de produto ao modelo de veiculo do catalogo de autopecas")
    public Method deleteDataForVehicleModelApplication() as Logical

EndClass

/*/{Protheus.doc} New
    Metodo construtor
    @type   method
    @author eduardo.FLima
    @since  23/06/2026
    @return Object, Objeto instanciado da classe RetailAutopartsCatalogVehicleModelApplicationController
/*/
Method New() as Object Class RetailAutopartsCatalogVehicleModelApplicationController
Return Self

/*/{Protheus.doc} getDataForVehicleModelApplication
    Retorna as aplicacoes de produto ao modelo de veiculo do catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   23/06/2026
    @version p12
    @return  logical, .T. indicando se a execucao foi bem sucedida
/*/
Method getDataForVehicleModelApplication() as Logical Class RetailAutopartsCatalogVehicleModelApplicationController
    Local oJsonRespo        := JsonObject():New() as Object
    Local oJParametr        := oRest:getQueryRequest() as Object
    Local aItens            := {} as Array
    Local cVehicleModelUuid := "" as Character
    Local cProductCode      := "" as Character
    Local cSystemSetCode    := "" as Character
    Local lSeek             := .T. as Logical

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    If oJParametr:hasProperty('vehicleModelUuid')
        cVehicleModelUuid := oJParametr['vehicleModelUuid']
        lSeek := Lj6000VUid(cVehicleModelUuid) // Valida se o UUID informado e valido
    EndIf
    If oJParametr:hasProperty('productCode')
        cProductCode := oJParametr['productCode']
    EndIf
    If oJParametr:hasProperty('systemSetCode')
        cSystemSetCode := oJParametr['systemSetCode']
    EndIf

    If lSeek // Se o UUID informado for valido, realiza a busca caso nao o retorno sera vazio
        aItens := Self:FindVehicleModelApplication(cVehicleModelUuid, cProductCode, cSystemSetCode)
    EndIf

    If Len(aItens) > 0
        oJsonRespo["items"] := aItens
        oRest:setStatusCode(200)  // HTTP 200 = Sucesso
    Else
        oJsonRespo["items"]   := {}
        oJsonRespo["message"] := STR0001 //"Dados não encontrados para o filtro informado"
        oRest:setStatusCode(404)  // HTTP 404 = Not Found
    EndIf

    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

Return .T.

/*/{Protheus.doc} getCountDataForVehicleModelApplication
    Retorna a quantidade total de aplicacoes validas de produto ao modelo de veiculo
    @type    method
    @author  eduardo.FLima
    @since   23/06/2026
    @version p12
    @return  logical, .T. indicando se a execucao foi bem sucedida
/*/
Method getCountDataForVehicleModelApplication() as Logical Class RetailAutopartsCatalogVehicleModelApplicationController
    Local oJsonRespo    := JsonObject():New() as Object
    Local nTotal        := 0 as Numeric

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    nTotal := Self:CountVehicleModelApplication()

    oJsonRespo["total"] := nTotal
    oRest:setStatusCode(200)

    oRest:setResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)

Return .T.

/*/{Protheus.doc} postDataForVehicleModelApplication
    Cadastro de aplicacao de produto ao modelo de veiculo do catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   23/06/2026
    @version p12
    @return  logical, .T. indicando se a execucao foi bem sucedida
/*/
Method postDataForVehicleModelApplication() as Logical Class RetailAutopartsCatalogVehicleModelApplicationController
    Local oJsBody       := JsonObject():New() as Object
    Local oJsonRespo    := JsonObject():New() as Object
    Local oModel        := Nil as Object
    Local oModelMF0     := Nil as Object
    Local lGravouOK     := .F. as Logical
    Local aErros        := {} as Array
    Local lDadosOK      := .T. as Logical
    Local cParamName    := "" as Character
    Local cFieldName    := "" as Character
    Local lAnyParInf    := .F. as Logical
    Local nX            := 0 as Numeric

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    oJsBody:fromJson(oRest:GetBodyRequest())

    If lDadosOK
        // ==========================================
        // Aplica default de filial do produto
        // ==========================================

        // ==========================================
        // Carrega o Model MVC
        // ==========================================
        oModel := FWLoadModel("LOJA6060")
        oModel:SetOperation(MODEL_OPERATION_INSERT)
        oModel:Activate()

        // ------------------------------------------
        // Obtem o SubModel da Tabela MF0
        // ------------------------------------------
        oModelMF0 := oModel:GetModel("MF0MASTER")

        // ==========================================
        // Preenche os Campos do Model
        // ==========================================
        For nX := 1 To Len(aFields)
            cParamName := aFields[nX][1]
            cFieldName := aFields[nX][2]

            If oJsBody[cParamName] != Nil
                oModelMF0:SetValue(cFieldName, oJsBody[cParamName])
                lAnyParInf := .T.
            EndIf
        Next nX

        If !lAnyParInf
            oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
            oJsonRespo['message'] := STR0002 //"Nenhum parâmetro de aplicação informado para cadastro"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        // ==========================================
        // Valida e Grava os Dados
        // ==========================================
        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        Else
            lGravouOK := .F.
        EndIf

        If lGravouOK
            dbSelectArea("MF0")
            oRest:setStatusCode(201)  // HTTP 201 = Created
            oJsonRespo['success'] := .T.
            oJsonRespo['message'] := STR0003 + AllTrim(MF0->MF0_UIDMOD) + STR0004 //"Aplicação " ### " cadastrada com sucesso"
            For nX := 1 To Len(aFields)
                cParamName := aFields[nX][1]
                cFieldName := aFields[nX][2]
                oJsonRespo[cParamName] := AllTrim(MF0->(FieldGet(FieldPos(cFieldName))))
            Next nX
        Else
            oRest:setStatusCode(400)  // HTTP 400 = Bad Request
            aErros := oModel:GetErrorMessage()

            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := IIf(!Empty(aErros[6]), aErros[6], STR0006) //"Erro ao cadastrar aplicação"
            oJsonRespo['field']   := IIf(!Empty(aErros[4]), aErros[4], "")
            oJsonRespo['errorId'] := IIf(!Empty(aErros[5]), aErros[5], "")
            oJsonRespo['solution']:= IIf(!Empty(aErros[7]), aErros[7], "")
        EndIf
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    // ==========================================
    // Libera Recursos da Memoria
    // ==========================================
    If ValType(oModel) <> "U"
        oModelMF0:DeActivate()
        oModel:DeActivate()
        FreeObj(oModelMF0)
        FreeObj(oModel)
    EndIf

    FreeObj(oJsBody)
    FreeObj(oJsonRespo)

Return .T.

/*/{Protheus.doc} putDataForVehicleModelApplication
    Altera cadastro de aplicacao de produto ao modelo de veiculo do catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   23/06/2026
    @version p12
    @return  logical, .T. indicando se a execucao foi bem sucedida
/*/
Method putDataForVehicleModelApplication() as Logical Class RetailAutopartsCatalogVehicleModelApplicationController
    Local oJsonRespo        := JsonObject():New() as Object
    Local oJPathParam       := oRest:getPathParamsRequest() as Object
    Local oJsBody           := JsonObject():New() as Object
    Local oJParametr        := oRest:getQueryRequest() as Object
    Local lFound            := .F. as Logical
    Local cVehicleModelUuid := "" as Character
    Local cProductBranch    := "" as Character
    Local cProductCode      := "" as Character
    Local cSystemSetCode    := "" as Character
    Local aArea             := GetArea() as Array
    Local oModel            := Nil as Object
    Local oModelMF0         := Nil as Object
    Local lGravouOK         := .F. as Logical
    Local aErros            := {} as Array
    Local nX                := 0 as Numeric
    Local cParamName        := "" as Character
    Local cFieldName        := "" as Character
    Local lAnyParInf        := .F. as Logical
    Local lDadosOK          := .T. as Logical

    dbSelectArea("MF0")

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    oJsBody:fromJson(oRest:GetBodyRequest())

    // Obtem vehicleModelUuid do path param
    If oJPathParam:hasProperty('vehicleModelUuid')
        cVehicleModelUuid := oJPathParam['vehicleModelUuid']
    EndIf

    If oJParametr:hasProperty('productBranch')
        cProductBranch := oJParametr['productBranch']
    EndIf
    If oJParametr:hasProperty('productCode')
        cProductCode := oJParametr['productCode']
    EndIf
    If oJParametr:hasProperty('systemSetCode')
        cSystemSetCode := oJParametr['systemSetCode']
    EndIf

    // ==========================================
    // Validacao: vehicleModelUuid Obrigatorio
    // ==========================================
    If Empty(cVehicleModelUuid)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['message'] := STR0007 //"Parâmetro 'vehicleModelUuid' é obrigatório"
        lDadosOK := .F.
    EndIf

    If lDadosOK
        // Aplica default de filial do produto para posicionamento
        cProductBranch := IIf(Empty(cProductBranch), xFilial("SB1"), cProductBranch)

        lFound := Self:PositionMF0ByKey(cVehicleModelUuid, cProductBranch, cProductCode, cSystemSetCode)

        // ------------------------------------------
        // Se nao encontrou retorna erro 404
        // ------------------------------------------
        If !lFound
            oRest:setStatusCode(404)  // HTTP 404 = Not Found
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0008 + AllTrim(cVehicleModelUuid) + STR0009 //"Registro " ### " não encontrado para os parâmetros informados"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK

        // ==========================================
        // Carrega o Model MVC para Alteracao
        // ==========================================
        oModel := FWLoadModel("LOJA6060")
        oModel:SetOperation(MODEL_OPERATION_UPDATE)
        oModel:Activate()

        // ------------------------------------------
        // Obtem o SubModel da Tabela MF0
        // ------------------------------------------
        oModelMF0 := oModel:GetModel("MF0MASTER")

        // ==========================================
        // Preenche os Campos do Model
        // ==========================================
        For nX := 1 To Len(aFields)
            cParamName := aFields[nX][1]
            cFieldName := aFields[nX][2]

            If oJsBody[cParamName] != Nil
                oModelMF0:SetValue(cFieldName, oJsBody[cParamName])
                lAnyParInf := .T.
            EndIf
        Next nX

        If !lAnyParInf
            oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
            oJsonRespo['message'] := STR0010 //"Nenhum parâmetro de aplicação informado para alteração"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        // ==========================================
        // Valida e Grava as Alteracoes
        // ==========================================
        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        Else
            lGravouOK := .F.
        EndIf

        If lGravouOK
            dbSelectArea("MF0")
            oRest:setStatusCode(200)  // HTTP 200 = OK
            oJsonRespo['success'] := .T.
            oJsonRespo['message'] := STR0003 + AllTrim(cVehicleModelUuid) + STR0005 //"Aplicacao " ### " atualizada com sucesso"
            For nX := 1 To Len(aFields)
                cParamName := aFields[nX][1]
                cFieldName := aFields[nX][2]
                oJsonRespo[cParamName] := AllTrim(MF0->(FieldGet(FieldPos(cFieldName))))
            Next nX
        Else
            oRest:setStatusCode(400)  // HTTP 400 = Bad Request
            aErros := oModel:GetErrorMessage()

            oJsonRespo['success']  := .F.
            oJsonRespo['field']    := IIf(!Empty(aErros[4]), aErros[4], "")
            oJsonRespo['message']  := IIf(!Empty(aErros[6]), aErros[6], STR0011) //"Erro ao atualizar aplicação"
            oJsonRespo['solution'] := IIf(!Empty(aErros[7]), aErros[7], "")
        EndIf
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    // ==========================================
    // Libera Recursos da Memoria
    // ==========================================
    If ValType(oModel) <> "U"
        oModelMF0:DeActivate()
        oModel:DeActivate()
        FreeObj(oModelMF0)
        FreeObj(oModel)
    EndIf

    FreeObj(oJsBody)
    FreeObj(oJsonRespo)
    FreeObj(oJPathParam)

    RestArea(aArea)

Return .T.

/*/{Protheus.doc} deleteDataForVehicleModelApplication
    Deleta aplicacao de produto ao modelo de veiculo do catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   23/06/2026
    @version p12
    @return  logical, .T. indicando se a execucao foi bem sucedida
/*/
Method deleteDataForVehicleModelApplication() as Logical Class RetailAutopartsCatalogVehicleModelApplicationController
    Local oJsonRespo        := JsonObject():New() as Object
    Local oJPathParam       := oRest:getPathParamsRequest() as Object
    Local oJQueryParam      := oRest:getQueryRequest() as Object
    Local lFound            := .F. as Logical
    Local cVehicleModelUuid := "" as Character
    Local cProductBranch    := "" as Character
    Local cProductCode      := "" as Character
    Local cSystemSetCode    := "" as Character
    Local aArea             := GetArea() as Array
    Local oModel            := Nil as Object
    Local lGravouOK         := .F. as Logical
    Local lDadosOK          := .T. as Logical
    Local aErros            := {} as Array

    dbSelectArea("MF0")

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Obtem vehicleModelUuid do path param
    If oJPathParam:hasProperty('vehicleModelUuid')
        cVehicleModelUuid := oJPathParam['vehicleModelUuid']
    EndIf

    // Obtem campos complementares da chave via query param
    If oJQueryParam:hasProperty('productBranch')
        cProductBranch := oJQueryParam['productBranch']
    EndIf
    If oJQueryParam:hasProperty('productCode')
        cProductCode := oJQueryParam['productCode']
    EndIf
    If oJQueryParam:hasProperty('systemSetCode')
        cSystemSetCode := oJQueryParam['systemSetCode']
    EndIf

    // ==========================================
    // Validacao: vehicleModelUuid Obrigatorio
    // ==========================================
    If Empty(cVehicleModelUuid)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['message'] := STR0007 //"Parâmetro 'vehicleModelUuid' é obrigatório"
        lDadosOK := .F.
    EndIf

    If lDadosOK
        // Aplica default de filial do produto
        cProductBranch := IIf(Empty(cProductBranch), xFilial("SB1"), cProductBranch)

        lFound := Self:PositionMF0ByKey(cVehicleModelUuid, cProductBranch, cProductCode, cSystemSetCode)

        // ------------------------------------------
        // Se nao encontrou retorna erro 404
        // ------------------------------------------
        If !lFound
            oRest:setStatusCode(404)  // HTTP 404 = Not Found
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0008 + AllTrim(cVehicleModelUuid) + STR0009 //"Registro " ### " não encontrado para os parâmetros informados"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        // ==========================================
        // Carrega o Model MVC para Delete
        // ==========================================
        oModel := FWLoadModel("LOJA6060")
        oModel:SetOperation(MODEL_OPERATION_DELETE)
        oModel:Activate()

        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        EndIf

        // Resposta default: erro (padrao defensivo)
        oRest:setStatusCode(400)  // HTTP 400 = Bad Request
        oJsonRespo['success'] := .F.
        aErros := oModel:GetErrorMessage()
        oJsonRespo['message']  := IIf(!Empty(aErros[6]), aErros[6], STR0012) //"Erro ao deletar aplicação"
        oJsonRespo['field']    := IIf(!Empty(aErros[4]), aErros[4], "")
        oJsonRespo['solution'] := IIf(!Empty(aErros[7]), aErros[7], "")

        If lGravouOK
            oRest:setStatusCode(200)  // HTTP 200 = OK
            oJsonRespo['success'] := .T.
            oJsonRespo['message'] := STR0003 + AllTrim(cVehicleModelUuid) + STR0013 //"Aplicacao " ### " deletada com sucesso"
            // Remove campos de erro caso tenha sucesso na delecao
            oJsonRespo:delName("field")
            oJsonRespo:delName("solution")
        EndIf

        // ==========================================
        // Libera Recursos da Memoria
        // ==========================================
        oModel:DeActivate()
        FreeObj(oModel)
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJPathParam)
    FreeObj(oJQueryParam)

    RestArea(aArea)

Return .T.

/*/{Protheus.doc} PositionMF0ByKey
    Posiciona a tabela MF0 pela chave unica sem dependencia de indice SIX
    @type    method
    @author  eduardo.FLima
    @since   23/06/2026
    @param   cVehicleModelUuid , Character , UUID do modelo de veiculo (MF0_UIDMOD)
    @param   cProductBranch    , Character , Filial do produto (MF0_FILPRO)
    @param   cProductCode      , Character , Codigo do produto (MF0_CODPRO)
    @param   cSystemSetCode    , Character , Codigo do conjunto sistema (MF0_CNJSIS)
    @return  lFound            , Logical   , .T. se encontrou e posicionou
/*/
Method PositionMF0ByKey(cVehicleModelUuid as Character, cProductBranch as Character, cProductCode as Character, cSystemSetCode as Character) as Logical Class RetailAutopartsCatalogVehicleModelApplicationController
    Local lFound        := .F. as Logical
    Local oQueryQry     := Nil as Object
    Local cQry          := "" as Character
    Local cAliasQry     := "" as Character
    Local nSeq          := 1 as Numeric
    Local nRecno        := 0 as Numeric

    Default cVehicleModelUuid := ""
    Default cProductBranch    := ""
    Default cProductCode      := ""
    Default cSystemSetCode    := ""

    If !Empty(AllTrim(cVehicleModelUuid)) .and. Lj6000VUid(cVehicleModelUuid) //. Valida se o UUID informado e valido
        cQry := " SELECT MF0.R_E_C_N_O_ AS RECNO "
        cQry += " FROM " + RetSqlName("MF0") + " MF0 "
        cQry += " WHERE "
        cQry += " MF0.MF0_FILIAL = ? "
        cQry += " AND MF0.MF0_UIDMOD = ? "
        cQry += " AND MF0.MF0_FILPRO = ? "
        cQry += " AND MF0.MF0_CODPRO = ? "
        cQry += " AND MF0.MF0_CNJSIS = ? "
        cQry += " AND MF0.D_E_L_E_T_ = ? "
        cQry := ChangeQuery(cQry)

        oQueryQry := FwExecStatement():New(cQry)

        oQueryQry:SetString(nSeq++, xFilial("MF0"))
        oQueryQry:SetString(nSeq++, PadR(cVehicleModelUuid, TamSx3("MF0_UIDMOD")[1]))
        oQueryQry:SetString(nSeq++, PadR(cProductBranch,    TamSx3("MF0_FILPRO")[1]))
        oQueryQry:SetString(nSeq++, PadR(cProductCode,      TamSx3("MF0_CODPRO")[1]))
        oQueryQry:SetString(nSeq++, PadR(cSystemSetCode,    TamSx3("MF0_CNJSIS")[1]))
        oQueryQry:SetString(nSeq++, Space(1))

        cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

        If (cAliasQry)->(!EOF())
            nRecno := (cAliasQry)->RECNO
        EndIf

        (cAliasQry)->(dbCloseArea())
        oQueryQry:Destroy()
        oQueryQry := Nil

        If nRecno > 0
            dbSelectArea("MF0")
            MF0->(dbGoTo(nRecno))
            lFound := !MF0->(EOF()) .And. nRecno == MF0->(Recno())
        EndIf
    EndIf

Return lFound

/*/{Protheus.doc} FindVehicleModelApplication
    Consulta aplicacoes de produto ao modelo de veiculo do catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   23/06/2026
    @version p12
    @param   cVehicleModelUuid , Character , filtro pelo UUID do modelo de veiculo (busca exata)
    @param   cProductCode      , Character , filtro pelo codigo do produto (busca exata)
    @param   cSystemSetCode    , Character , filtro pelo codigo do conjunto sistema (busca exata)
    @return  Array     , array de itens encontrados
/*/
Method FindVehicleModelApplication(cVehicleModelUuid as Character, cProductCode as Character, cSystemSetCode as Character) as Array Class RetailAutopartsCatalogVehicleModelApplicationController
    Local oQueryQry     := Nil as Object
    Local jItem         := Nil as Object
    Local aItens        := {} as Array
    Local cQry          := "" as Character
    Local cAliasQry     := "" as Character
    Local nSeq          := 1 as Numeric
    Local aArea         := GetArea() as Array

    Default cVehicleModelUuid := ""
    Default cProductCode      := ""
    Default cSystemSetCode    := ""

    dbSelectArea("MF0")

    cQry := " SELECT MF0.MF0_FILIAL, MF0.MF0_UIDMOD, MF0.MF0_FILPRO, "
    cQry += " MF0.MF0_CODPRO, MF0.MF0_CNJSIS, "
    cQry += " MEC.MEC_MODELO AS DESMOD, "
    cQry += " SB1.B1_DESC AS DESPRD, "
    cQry += " MI2.MI2_DESCRI AS DESCNJ "
    cQry += " FROM " + RetSqlName("MF0") + " MF0 "
    cQry += " LEFT JOIN " + RetSqlName("MEC") + " MEC ON MEC.MEC_FILIAL = ? AND MEC.MEC_MSUID = MF0.MF0_UIDMOD AND MEC.D_E_L_E_T_ = ? "
    cQry += " LEFT JOIN " + RetSqlName("SB1") + " SB1 ON SB1.B1_FILIAL = MF0.MF0_FILPRO AND SB1.B1_COD = MF0.MF0_CODPRO AND SB1.D_E_L_E_T_ = ? "
    cQry += " LEFT JOIN " + RetSqlName("MI2") + " MI2 ON MI2.MI2_FILIAL = ? AND MI2.MI2_CODCON = MF0.MF0_CNJSIS AND MI2.D_E_L_E_T_ = ? "
    cQry += " WHERE "
    cQry += " MF0.MF0_FILIAL = ? "

    If !Empty(cVehicleModelUuid)
        cQry += " AND MF0.MF0_UIDMOD = ? "
    EndIf

    If !Empty(cProductCode)
        cQry += " AND MF0.MF0_CODPRO = ? "
    EndIf

    If !Empty(cSystemSetCode)
        cQry += " AND MF0.MF0_CNJSIS = ? "
    EndIf

    cQry += " AND MF0.D_E_L_E_T_ = ? "
    cQry += " ORDER BY MF0.MF0_UIDMOD, MF0.MF0_CODPRO "
    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)

    // Parametros dos LEFT JOINs (filial + D_E_L_E_T_)
    oQueryQry:SetString(nSeq++, xFilial("MEC"))  // MEC.MEC_FILIAL
    oQueryQry:SetString(nSeq++, Space(1))          // MEC.D_E_L_E_T_
    oQueryQry:SetString(nSeq++, Space(1))          // SB1.D_E_L_E_T_
    oQueryQry:SetString(nSeq++, xFilial("MI2"))   // MI2.MI2_FILIAL
    oQueryQry:SetString(nSeq++, Space(1))          // MI2.D_E_L_E_T_

    // Parametro do WHERE principal
    oQueryQry:SetString(nSeq++, xFilial("MF0"))

    If !Empty(cVehicleModelUuid)
        oQueryQry:SetString(nSeq++, PadR(cVehicleModelUuid, TamSx3("MF0_UIDMOD")[1]))
    EndIf

    If !Empty(cProductCode)
        oQueryQry:SetString(nSeq++, PadR(cProductCode, TamSx3("MF0_CODPRO")[1]))
    EndIf

    If !Empty(cSystemSetCode)
        oQueryQry:SetString(nSeq++, PadR(cSystemSetCode, TamSx3("MF0_CNJSIS")[1]))
    EndIf

    oQueryQry:SetString(nSeq++, Space(1))  // MF0.D_E_L_E_T_

    cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

    While (cAliasQry)->(!EOF())
        jItem := JsonObject():New()
        jItem["branch"]           := rTrim((cAliasQry)->MF0_FILIAL)
        jItem["vehicleModelUuid"] := rTrim((cAliasQry)->MF0_UIDMOD)
        jItem["vehicleModelDesc"] := rTrim((cAliasQry)->DESMOD)
        jItem["productBranch"]    := rTrim((cAliasQry)->MF0_FILPRO)
        jItem["productCode"]      := rTrim((cAliasQry)->MF0_CODPRO)
        jItem["productDesc"]      := rTrim((cAliasQry)->DESPRD)
        jItem["systemSetCode"]    := rTrim((cAliasQry)->MF0_CNJSIS)
        jItem["systemSetDesc"]    := rTrim((cAliasQry)->DESCNJ)
        aAdd(aItens, jItem)
        jItem := Nil
        (cAliasQry)->(dbSkip())
    EndDo

    (cAliasQry)->(dbCloseArea())
    oQueryQry:Destroy()
    oQueryQry := Nil

    RestArea(aArea)

Return(aItens)

/*/{Protheus.doc} CountVehicleModelApplication
    Consulta a quantidade total de aplicacoes validas de produto ao modelo de veiculo
    @type    method
    @author  eduardo.FLima
    @since   23/06/2026
    @version p12
    @return  nTotal      , Numeric   , quantidade total de registros validos
/*/
Method CountVehicleModelApplication() as Numeric Class RetailAutopartsCatalogVehicleModelApplicationController
    Local oQueryQry     as Object
    Local cQry          as Character
    Local cAliasQry     as Character
    Local nSeq          as Numeric
    Local nTotal        as Numeric
    Local aArea         as Array

    oQueryQry   := Nil
    nSeq        := 1
    nTotal      := 0
    aArea       := GetArea()

    dbSelectArea("MF0")

    cQry := " SELECT COUNT(1) AS TOTAL "
    cQry += " FROM " + RetSqlName("MF0") + " MF0 "
    cQry += " WHERE "
    cQry += " MF0.MF0_FILIAL = ? "
    cQry += " AND MF0.D_E_L_E_T_ = ? "
    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)

    oQueryQry:SetString(nSeq++, xFilial("MF0"))
    oQueryQry:SetString(nSeq++, Space(1))

    cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

    If (cAliasQry)->(!EOF())
        nTotal := (cAliasQry)->TOTAL
    EndIf

    (cAliasQry)->(dbCloseArea())

    RestArea(aArea)

    oQueryQry:Destroy()

Return nTotal
