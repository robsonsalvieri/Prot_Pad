#include "totvs.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "retail.autoparts.catalog.sx5.controller.ch"

namespace totvs.protheus.retail.autoparts.catalog.sx5.controller

/*/{Protheus.doc} RetailAutopartsCatalogSx5Controller
    API de consulta a dominios genericos via tabela SX5 do catalogo de autopecas
    @type   class
    @author Bruno Almeida
    @since  24/06/2026
/*/
Class RetailAutopartsCatalogSx5Controller

    private Method FindSx5(cTabela as Character, cChave as Character, cDescri as Character) as Array

    public Method New()

    @Get("/api/retail/v1/retailAutopartsCatalogSx5/getDataForSx5", description="Consulta dominios genericos da tabela SX5 do catalogo de autopecas.")
    public Method getDataForSx5()

EndClass

/*/{Protheus.doc} New
    Metodo construtor
    @type   method
    @author Bruno Almeida
    @since  24/06/2026
/*/
Method New() Class RetailAutopartsCatalogSx5Controller
Return Self

/*/{Protheus.doc} getDataForSx5
    Retorna os itens de um dominio generico da tabela SX5
    @type    method
    @author  Bruno Almeida
    @since   24/06/2026
    @version p12
    @return  .T., Logical, sempre retorna verdadeiro
/*/
Method getDataForSx5() Class RetailAutopartsCatalogSx5Controller
    Local oJsonRespo    as Object
    Local oJParametr    as Object
    Local aItens        as Array
    Local cTabela       as Character
    Local cChave        as Character
    Local cDescri       as Character

    oJsonRespo  := JsonObject():New()
    aItens      := {}
    cTabela     := ""
    cChave      := ""
    cDescri     := ""

    oJParametr := oRest:getQueryRequest()

    oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

    If oJParametr['table'] == Nil .Or. Empty(oJParametr['table'])
        oJsonRespo["success"] := .F.
        oJsonRespo["items"]   := {}
        oJsonRespo["message"] := STR0001 //"Parâmetro 'tabela' é obrigatório"
        oRest:setStatusCode(400)
    Else
        cTabela := AllTrim(oJParametr['table'])

        If oJParametr['key'] != Nil .And. !Empty(oJParametr['key'])
            cChave := AllTrim(oJParametr['key'])
        EndIf

        If oJParametr['descri'] != Nil .And. !Empty(oJParametr['descri'])
            cDescri := AllTrim(oJParametr['descri'])
            cDescri := DecodeUTF8(cDescri, "cp1252")
        EndIf

        aItens := Self:FindSx5(cTabela, cChave, cDescri)

        If Len(aItens) > 0
            oJsonRespo["success"] := .T.
            oJsonRespo["items"]   := aItens
            oRest:setStatusCode(200)
        Else
            oJsonRespo["success"] := .F.
            oJsonRespo["items"]   := {}
            oJsonRespo["message"] := STR0002 //"Dados não encontrados para o filtro informado"
            oRest:setStatusCode(404)
        EndIf
    EndIf

    oRest:setResponse(EncodeUTF8(oJsonRespo:toJson()))

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

Return .T.

/*/{Protheus.doc} FindSx5
    Consulta itens de um dominio generico na tabela SX5
    @type    method
    @author  Bruno Almeida
    @since   24/06/2026
    @version p12
    @param   cTabela , Character , identificador do dominio (X5_TABELA) - obrigatorio
    @param   cChave  , Character , filtro por chave exata (X5_CHAVE) - opcional
    @param   cDescri , Character , filtro parcial por descricao (X5_DESCRI) - opcional
    @return  aItens  , Array     , array de itens encontrados
/*/
Method FindSx5(cTabela as Character, cChave as Character, cDescri as Character) as Array Class RetailAutopartsCatalogSx5Controller
    Local oQueryQry     as Object
    Local jItem         as Object
    Local aItens        as Array
    Local cQry          as Character
    Local cAliasQry     as Character
    Local nSeq          as Numeric
    Local aArea         as Array

    Default cTabela := ""
    Default cChave  := ""
    Default cDescri := ""

    oQueryQry   := Nil
    jItem       := Nil
    nSeq        := 1
    aItens      := {}
    aArea       := GetArea()

    cQry := " SELECT SX5.X5_FILIAL, SX5.X5_TABELA, SX5.X5_CHAVE, SX5.X5_DESCRI "
    cQry += " FROM " + RetSqlName("SX5") + " SX5 "
    cQry += " WHERE "
    cQry += " SX5.X5_FILIAL = ? "
    cQry += " AND SX5.X5_TABELA = ? "

    If !Empty(cChave)
        cQry += " AND SX5.X5_CHAVE = ? "
    ElseIf !Empty(cDescri)
        cQry += " AND Upper(SX5.X5_DESCRI) LIKE ? "
    EndIf

    cQry += " AND SX5.D_E_L_E_T_ = ? "
    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)

    oQueryQry:SetString(nSeq++, xFilial("SX5"))
    oQueryQry:SetString(nSeq++, cTabela)

    If !Empty(cChave)
        oQueryQry:SetString(nSeq++, cChave)
    ElseIf !Empty(cDescri)
        oQueryQry:SetString(nSeq++, "%" + Upper(cDescri) + "%")
    EndIf

    oQueryQry:SetString(nSeq++, Space(1))

    cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

    While (cAliasQry)->(!EOF())
        jItem := JsonObject():New()
        jItem["tabela"]    := AllTrim((cAliasQry)->X5_TABELA)
        jItem["chave"]     := AllTrim((cAliasQry)->X5_CHAVE)
        jItem["descricao"] := AllTrim((cAliasQry)->X5_DESCRI)
        aAdd(aItens, jItem)
        jItem := Nil
        (cAliasQry)->(dbSkip())
    EndDo

    (cAliasQry)->(dbCloseArea())

    oQueryQry:Destroy()
    oQueryQry := Nil

    RestArea(aArea)

Return(aItens)
