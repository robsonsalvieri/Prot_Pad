#include "totvs.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "retail.autoparts.catalog.category.controller.ch"

namespace totvs.protheus.retail.autoparts.catalog.category.controller

/*/{Protheus.doc} RetailAutopartsCatalogCategoryController
    API relacionadas as categorias do catalogo de autopecas (tabela ACU)
    @type   class
    @author eduardo.flima
    @since 30/06/2026
    @version p12
/*/
Class RetailAutopartsCatalogCategoryController


    private Method FindCategory(cAlias as Character, jPaginati as Json) as Json
    private Method ExecQuery(cCode as Character, cDescription as Character, cParentCode as Character, lTotal as Logical, jPaginati as Json) as Character

    public Method New()

    @Get("/api/retail/v1/retailAutopartsCatalogCategory/getDataForCategory", description="Consulta as categorias do catalogo de auto pecas.")
    public Method getDataForCategory()

EndClass

/*/{Protheus.doc} New
    Metodo construtor
    @type   method
    @author eduardo.flima
    @since  30/06/2026
    @version p12
    @return Object , instancia da classe
/*/
Method New() Class RetailAutopartsCatalogCategoryController
Return self

/*/{Protheus.doc} getDataForCategory
    Retorna as categorias do catalogo de auto pecas
    @type    method
    @author  eduardo.flima
    @since   30/06/2026
    @version p12
    @return  logical, retorno padrao .T.
/*/
Method getDataForCategory() Class RetailAutopartsCatalogCategoryController
    Local oJsonRespo    as Object
    Local oJParametr    as Object
    Local aItens        as Array
    Local cCode         as Character
    Local cDescription  as Character
    Local cParentCode   as Character
    Local nPage         as Numeric
    Local nPageSize     as Numeric
    Local cAliasQry     as Character
    Local aArea         as Array
    Local lHasNext      as Logical
    Local jItem         as Json
    Local jPaginati     as Json

    aArea       := GetArea()
    oJsonRespo  := JsonObject():New()
    jPaginati   := JsonObject():New()
    aItens      := {}
    oJParametr  := oRest:getQueryRequest()
    lHasNext    := .F.

    jPaginati["nStart"] := 0
    jPaginati["nEnd"]   := 0

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    If oJParametr['code'] == Nil .Or. Empty(oJParametr['code'])
        cCode := ""
    Else
        cCode := oJParametr['code']
    EndIf

    If oJParametr['description'] == Nil .Or. Empty(oJParametr['description'])
        cDescription := ""
    Else
        cDescription := oJParametr['description']
    EndIf

    If oJParametr['parentCode'] == Nil .Or. Empty(oJParametr['parentCode'])
        cParentCode := ""
    Else
        cParentCode := oJParametr['parentCode']
    EndIf

    If oJParametr['page'] == Nil .Or. Empty(oJParametr['page'])
        nPage := 1
    Else
        nPage := Val(oJParametr['page'])
    EndIf

    If oJParametr['pagesize'] == Nil .Or. Empty(oJParametr['pagesize'])
        nPageSize := 20
    Else
        nPageSize := Val(oJParametr['pagesize'])
    EndIf

    jPaginati["nStart"] := (nPage - 1) * nPageSize + 1

    //-- O +1 é necessário para corrigir o cálculo da linha final, pois a função ROW_NUMBER() inicia a contagem em 1
    jPaginati["nEnd"] := nPage * nPageSize + 1

    cAliasQry := Self:ExecQuery(cCode, cDescription, cParentCode, .F., jPaginati)

    If !Empty(cAliasQry)
        jItem := Self:FindCategory(cAliasQry, jPaginati)
        aItens := jItem["items"]
        lHasNext := jItem["hasnext"]
        (cAliasQry)->(dbCloseArea())
    EndIf

    If Len(aItens) > 0
        cAliasQry := ""
        cAliasQry := Self:ExecQuery(cCode, cDescription, cParentCode, .T., jPaginati)

        oJsonRespo["items"]                      := aItens
        oJsonRespo["pagination"]                 := JsonObject():New()
        oJsonRespo["pagination"]["page"]         := nPage
        oJsonRespo["pagination"]["pagesize"]     := nPageSize
        oJsonRespo["pagination"]["totalitems"]   := (cAliasQry)->TOTAL
        oJsonRespo["pagination"]["totalpages"]   := Int(((cAliasQry)->TOTAL + nPageSize - 1) / nPageSize)
        oJsonRespo["pagination"]["nextpage"]     := lHasNext
        oJsonRespo["pagination"]["previouspage"] := nPage > 1

        (cAliasQry)->(dbCloseArea())

        oRest:setStatusCode(200)
    Else
        oJsonRespo["items"]   := {}
        oJsonRespo["message"] := STR0001 //"Dados não encontrados para o filtro informado"
        oRest:setStatusCode(404)
    EndIf

    oRest:setResponse(oJsonRespo:toJson())

    RestArea(aArea)
    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

Return .T.

/*/{Protheus.doc} FindCategory
    Mapeia os registros do alias temporario para array JSON
    @type    method
    @author  eduardo.flima
    @since   30/06/2026
    @version p12
    @param   cAliasQry, Character, alias temporario retornado por ExecQuery
    @param   jPaginati, Json, objeto JSON com os parametros de paginacao
    @return  Json, objeto contendo o array "items" com os registros encontrados e o indicador "hasnext" de proxima pagina
/*/
Method FindCategory(cAliasQry as Character, jPaginati as Json) as Json Class RetailAutopartsCatalogCategoryController
    Local jItem     as Object
    Local aItens    as Array
    Local jReturn   as Json

    aItens := {}
    jReturn := JsonObject():New()
    jReturn["items"] := {}
    jReturn["hasnext"] := .F.

    While (cAliasQry)->(!EOF())

        If (cAliasQry)->LINHA > (jPaginati["nEnd"] - 1)
            jReturn["hasnext"] := .T.
            Exit
        EndIf

        jItem := JsonObject():New()
        jItem["branch"]      := AllTrim((cAliasQry)->ACU_FILIAL)
        jItem["code"]        := AllTrim((cAliasQry)->ACU_COD)
        jItem["parentCode"]  := AllTrim((cAliasQry)->ACU_CODPAI)
        jItem["description"] := AllTrim((cAliasQry)->ACU_DESC)

        aAdd(aItens, jItem)
        jItem := Nil
        (cAliasQry)->(dbSkip())
    EndDo
    jReturn["items"] := aItens


Return(jReturn)

/*/{Protheus.doc} ExecQuery
    Consulta categorias da tabela ACU
    @type    method
    @author  eduardo.flima
    @since   30/06/2026
    @version p12
    @param   cCode       , Character, filtro pelo codigo da categoria
    @param   cDescription, Character, filtro pela descricao da categoria
    @param   cParentCode , Character, filtro pelo codigo da categoria pai
    @param   lTotal      , Logical,   indica se deve retornar o total de itens
    @param   jPaginati   , Json,      objeto JSON com os parametros de paginacao
    @return  Character, alias temporario com os itens encontrados
/*/
Method ExecQuery(cCode as Character, cDescription as Character, cParentCode as Character, lTotal as Logical, jPaginati as Json) as Character Class RetailAutopartsCatalogCategoryController
    Local cTable    as Character
    Local cQry      as Character
    Local oQueryQry as Object
    Local nSeq      as Numeric

    Default lTotal := .F.

    nSeq := 1

    If !lTotal
        cQry := " SELECT * FROM ("
        cQry += " SELECT ROW_NUMBER() OVER(ORDER BY ACU.ACU_COD ASC) AS LINHA, ACU_FILIAL, ACU_COD, ACU_CODPAI, ACU_DESC "
    Else
        cQry := " SELECT COUNT(ACU.ACU_COD) AS TOTAL "
    EndIf

    cQry += "   FROM " + RetSqlName("ACU") + " ACU "
    cQry += "  WHERE ACU.ACU_FILIAL = ? "

    If !Empty(cCode)
        cQry += " AND ACU.ACU_COD = ? "
    EndIf

    If !Empty(cDescription)
        cQry += " AND UPPER(ACU.ACU_DESC) LIKE ? "
    EndIf

    If !Empty(cParentCode)
        cQry += " AND ACU.ACU_CODPAI = ? "
    EndIf

    cQry += " AND ACU.D_E_L_E_T_ = ? "

    If !lTotal
        cQry += ") TAB"
        cQry += " WHERE LINHA BETWEEN ? AND ?"
    EndIf

    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)

    oQueryQry:SetString(nSeq++, FWxFilial("ACU"))

    If !Empty(cCode)
        oQueryQry:SetString(nSeq++, cCode)
    EndIf

    If !Empty(cDescription)
        //-- Ajuste para evitar problemas com acentos na consulta
        cDescription := DecodeUTF8(cDescription, "cp1252")
        oQueryQry:SetString(nSeq++, "%" + Upper(cDescription) + "%")
    EndIf

    If !Empty(cParentCode)
        oQueryQry:SetString(nSeq++, cParentCode)
    EndIf

    oQueryQry:SetString(nSeq++, Space(1))

    If !lTotal
        oQueryQry:SetNumeric(nSeq++, jPaginati["nStart"])
        oQueryQry:SetNumeric(nSeq++, jPaginati["nEnd"])
    EndIf

    cTable := oQueryQry:OpenAlias(GetNextAlias())

    oQueryQry:Destroy()
    oQueryQry := Nil

Return cTable
