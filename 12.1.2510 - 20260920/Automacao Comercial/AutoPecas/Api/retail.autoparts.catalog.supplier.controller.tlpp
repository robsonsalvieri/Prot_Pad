#include "totvs.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "retail.autoparts.catalog.supplier.controller.ch"

namespace totvs.protheus.retail.autoparts.catalog.supplier.controller

/*/{Protheus.doc} RetailAutopartsCatalogSupplierController
    API relacionadas a fornecedores do catalogo de autopecas
    @type   class
    @author Bruno Almeida
    @since  04/06/2026
    @version P12
/*/
Class RetailAutopartsCatalogSupplierController

    private data lHasNext   as Logical
    private data nStart     as Numeric
    private data nEnd       as Numeric

    private Method FindSupplier(cAlias as Character) as Array
    private Method ExecQuerySupplier(cBranch as Character, cCode as Character, cStore as Character, cName as Character, cCnpjCpf as Character, lTotal as Logical) as Character

    public Method New()

    @Get("/api/retail/v1/retailAutopartsCatalogSupplier/getDataForSupplier", description="Consulta os fornecedores do catalogo de auto pecas.")
    public Method getDataForSupplier()

EndClass

/*/{Protheus.doc} New
    Metodo construtor
    @type   method
    @author Bruno Almeida
    @since  04/06/2026
    @version P12
    @return  Object, Objeto da classe
/*/
Method New() Class RetailAutopartsCatalogSupplierController
    Self:lHasNext   := .F.
    Self:nStart     := 0
    Self:nEnd       := 0
Return Self

/*/{Protheus.doc} getDataForSupplier
    Retorna os fornecedores do catalogo de auto pecas
    @type    method
    @author  Bruno Almeida
    @since   04/06/2026
    @version P12
    @return  logical, retorno padrão .T.
/*/
Method getDataForSupplier() Class RetailAutopartsCatalogSupplierController
    Local oJsonRespo    as Object
    Local oJParametr    as Object
    Local aItens        as Array
    Local cBranch       as Character
    Local cCode         as Character
    Local cStore        as Character
    Local cName         as Character
    Local cCnpjCpf      as Character
    Local nPage         as Numeric
    Local nPageSize     as Numeric
    Local cAliasQry     as Character

    oJsonRespo  := JsonObject():New()
    aItens      := {}
    oJParametr  := oRest:getQueryRequest()

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    If oJParametr['branch'] == Nil .Or. Empty(oJParametr['branch'])
        cBranch := ""
    Else
        cBranch := oJParametr['branch']
    EndIf

    If oJParametr['code'] == Nil .Or. Empty(oJParametr['code'])
        cCode := ""
    Else
        cCode := oJParametr['code']
    EndIf

    If oJParametr['store'] == Nil .Or. Empty(oJParametr['store'])
        cStore := ""
    Else
        cStore := oJParametr['store']
    EndIf

    If oJParametr['name'] == Nil .Or. Empty(oJParametr['name'])
        cName := ""
    Else
        cName := oJParametr['name']
    EndIf

    If oJParametr['cnpjCpf'] == Nil .Or. Empty(oJParametr['cnpjCpf'])
        cCnpjCpf := ""
    Else
        cCnpjCpf := oJParametr['cnpjCpf']
    EndIf

    If oJParametr['page'] == Nil .Or. Empty(oJParametr['page'])
        nPage := 1
    Else
        nPage := Val(oJParametr['page'])
    EndIf

    If oJParametr['pagesize'] == Nil .Or. Empty(oJParametr['pagesize'])
        nPageSize := 20
    Else
        nPageSize := Val(oJParametr['pagesize'])
    EndIf

    Self:nStart := (nPage - 1) * nPageSize + 1

    //-- O +1 é necessário para corrigir o cálculo da linha final, pois a função ROW_NUMBER() inicia a contagem em 1
    Self:nEnd := nPage * nPageSize + 1

    cAliasQry := Self:ExecQuerySupplier(cBranch, cCode, cStore, cName, cCnpjCpf, .F.)

    If !Empty(cAliasQry)
        aItens := Self:FindSupplier(cAliasQry)
    EndIf

    If Len(aItens) > 0
        cAliasQry := Self:ExecQuerySupplier(cBranch, cCode, cStore, cName, cCnpjCpf, .T.)

        oJsonRespo["items"]                      := aItens
        oJsonRespo["pagination"]                 := JsonObject():New()
        oJsonRespo["pagination"]["page"]         := nPage
        oJsonRespo["pagination"]["pagesize"]     := nPageSize
        oJsonRespo["pagination"]["totalitems"]   := (cAliasQry)->TOTAL
        oJsonRespo["pagination"]["totalpages"]   := Int(((cAliasQry)->TOTAL + nPageSize - 1) / nPageSize)
        oJsonRespo["pagination"]["nextpage"]     := Self:lHasNext
        oJsonRespo["pagination"]["previouspage"] := nPage > 1

        (cAliasQry)->(dbCloseArea())

        oRest:setStatusCode(200)
    Else
        oJsonRespo["items"]    := {}
        oJsonRespo["message"] := STR0001 //"Dados não encontrados para o filtro informado"
        oRest:setStatusCode(404)
    EndIf

    oRest:setResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

Return .T.


/*/{Protheus.doc} FindSupplier
    Itera o alias de fornecedores e monta o array de itens
    @type    method
    @author  Bruno Almeida
    @since   04/06/2026
    @version P12
    @param   cAliasQry, Character , alias temporario com resultado da query
    @return  aItens   , Array     , array de itens encontrados
/*/
Method FindSupplier(cAliasQry as Character) as Array Class RetailAutopartsCatalogSupplierController
    Local jItem         as Object
    Local aItens        as Array

    aItens := {}

    While (cAliasQry)->(!EOF())

        If (cAliasQry)->LINHA > (Self:nEnd - 1)
            Self:lHasNext := .T.
            Exit
        EndIf

        jItem := JsonObject():New()
        jItem["branch"]   := AllTrim((cAliasQry)->A2_FILIAL)
        jItem["code"]     := AllTrim((cAliasQry)->A2_COD)
        jItem["store"]    := AllTrim((cAliasQry)->A2_LOJA)
        jItem["name"]     := AllTrim((cAliasQry)->A2_NOME)
        jItem["shortname"]:= AllTrim((cAliasQry)->A2_NREDUZ)
        jItem["cnpjCpf"]  := AllTrim((cAliasQry)->A2_CGC)
        aAdd(aItens, jItem)
        jItem := Nil
        (cAliasQry)->(dbSkip())
    EndDo

    (cAliasQry)->(dbCloseArea())

Return(aItens)

/*/{Protheus.doc} ExecQuerySupplier
    Executa a query de consulta de fornecedores do catalogo de auto pecas
    @type    method
    @author  Bruno Almeida
    @since   04/06/2026
    @version p12
    @param   cBranch , Character , filtro pela filial
    @param   cCode   , Character , filtro pelo codigo do fornecedor
    @param   cStore  , Character , filtro pela loja
    @param   cName   , Character , filtro pelo nome do fornecedor
    @param   cCnpjCpf, Character , filtro pelo CNPJ/CPF do fornecedor
    @param   lTotal  , Logical   , indica se deve retornar o total de itens
    @return  cTable  , Character , alias temporario com os itens encontrados
/*/
Method ExecQuerySupplier(cBranch as Character, cCode as Character, cStore as Character, cName as Character, cCnpjCpf as character, lTotal as Logical) as Character Class RetailAutopartsCatalogSupplierController
    Local cTable    as Character
    Local cQry      as Character
    Local oQueryQry as Object
    Local nSeq      as Numeric

    Default lTotal := .F.

    nSeq := 1

    If !lTotal
        cQry := " SELECT * FROM ("
        cQry += " SELECT ROW_NUMBER() OVER(ORDER BY A2_NOME ASC) AS LINHA, A2_FILIAL, A2_COD, A2_LOJA, A2_NOME, A2_NREDUZ, A2_CGC "
    Else
        cQry := " SELECT COUNT(A2_COD) AS TOTAL "
    EndIf

    cQry += " FROM " + RetSqlName("SA2")
    cQry += " WHERE "

    cQry += " A2_FILIAL = ? AND "

    If !Empty(cCode) .and. !Empty(cStore)
        cQry += " A2_COD = ? AND A2_LOJA = ? AND "
    Else
        If !Empty(cName)
            cQry += " (UPPER(A2_NOME) LIKE ? OR UPPER(A2_NREDUZ) LIKE ?) AND "
        EndIf
        If !Empty(cCnpjCpf)
            //Busca pelo CNPJ/CPF do fornecedor, caso seja informado
            cQry += " UPPER(A2_CGC) LIKE ? AND "
        EndIf
    EndIf

    cQry += " D_E_L_E_T_ = ? "

    If !lTotal
        cQry += ") TAB"
        cQry += " WHERE LINHA BETWEEN ? AND ?"
    EndIf

    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)

    If Empty(cBranch)
        cBranch := FWxFilial("SA2")
    EndIf

    oQueryQry:SetString(nSeq++, cBranch)

    If !Empty(cCode) .and. !Empty(cStore)
        oQueryQry:SetString(nSeq++, cCode)
        oQueryQry:SetString(nSeq++, cStore)
    Else
        If !Empty(cName)
            //-- Ajuste para evitar problemas com acentos na consulta
            cName := DecodeUTF8(cName, "cp1252")
            oQueryQry:SetString(nSeq++, "%" + Upper(cName) + "%")
            oQueryQry:SetString(nSeq++, "%" + Upper(cName) + "%")
        EndIf
        If !Empty(cCnpjCpf)
            oQueryQry:SetString(nSeq++, "%" + Upper(cCnpjCpf) + "%")
        EndIf
    EndIf

    oQueryQry:SetString(nSeq++, Space(1))

    If !lTotal
        oQueryQry:SetNumeric(nSeq++, Self:nStart)
        oQueryQry:SetNumeric(nSeq++, Self:nEnd)
    EndIf

    cTable := oQueryQry:OpenAlias(GetNextAlias())

    oQueryQry:Destroy()
    oQueryQry := Nil

Return cTable
