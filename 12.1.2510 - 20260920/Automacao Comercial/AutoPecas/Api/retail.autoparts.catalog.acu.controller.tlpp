#include "tlpp-core.th"
#include "totvs.ch"
#include "tlpp-rest.th"

namespace totvs.protheus.retail.autoparts.catalog.acu.controller

/*/{Protheus.doc} RetailAutopartsCatalogAcuController
    API de consulta de Categorias Mercadologicas (ACU) para o Catalogo Geral
    @type   class
    @author fabio.favaretto
    @since  24/07/2026
    @version P12
/*/
Class RetailAutopartsCatalogAcuController

    private Method FindCategories(cDesc as Character, cCodPai as Character) as Array

    public Method New()

    @Get("/api/acu", description="Consulta categorias mercadologicas disponiveis (ACU). Filtros opcionais: desc, codpai")
    public Method getDataForAcu()

EndClass

/*/{Protheus.doc} New
    Metodo construtor
    @type   method
    @author fabio.favaretto
    @since  24/07/2026
    @version P12
/*/
Method New() Class RetailAutopartsCatalogAcuController
Return Self

/*/{Protheus.doc} getDataForAcu
    Retorna categorias mercadologicas da ACU
    @type    method
    @author  fabio.favaretto
    @since   24/07/2026
    @version P12
    @return  Logical
/*/
Method getDataForAcu() Class RetailAutopartsCatalogAcuController
    Local oJsonRespo as Object
    Local oJParametr as Object
    Local aItens     as Array
    Local cDesc      as Character
    Local cCodPai    as Character

    oJsonRespo := JsonObject():New()
    aItens     := {}
    oJParametr := oRest:getQueryRequest()
    cDesc      := ""
    cCodPai    := ""

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    If oJParametr:hasProperty("desc") .And. !Empty(oJParametr["desc"])
        cDesc := oJParametr["desc"]
    EndIf

    If oJParametr:hasProperty("codpai") .And. !Empty(oJParametr["codpai"])
        cCodPai := oJParametr["codpai"]
    EndIf

    aItens := Self:FindCategories(cDesc, cCodPai)

    oJsonRespo["items"] := aItens
    oRest:setStatusCode(200)
    oRest:setResponse(oJsonRespo:toJson())

    oJsonRespo := Nil
    oJParametr := Nil

Return .T.

/*/{Protheus.doc} FindCategories
    Consulta categorias na ACU com filtros opcionais
    @type    method
    @author  fabio.favaretto
    @since   24/07/2026
    @version P12
    @param   cDesc   , Character, filtro parcial por descricao
    @param   cCodPai , Character, filtro por categoria pai
    @return  Array
/*/
Method FindCategories(cDesc as Character, cCodPai as Character) as Array Class RetailAutopartsCatalogAcuController
    Local oQueryQry as Object
    Local jItem     as Object
    Local aItens    as Array
    Local cQry      as Character
    Local cAliasQry as Character
    Local nSeq      as Numeric
    Local aArea     as Array
    Local cCodPaiOut as Character

    Default cDesc   := ""
    Default cCodPai := ""

    aItens := {}
    nSeq   := 1
    aArea  := GetArea()

    cQry := " SELECT ACU.ACU_FILIAL, ACU.ACU_COD, ACU.ACU_DESC, ACU.ACU_CODPAI "
    cQry += " FROM " + RetSqlName("ACU") + " ACU "
    cQry += " WHERE ACU.ACU_FILIAL = ? "

    If !Empty(cDesc)
        cQry += " AND UPPER(ACU.ACU_DESC) LIKE ? "
    EndIf

    If !Empty(cCodPai)
        cQry += " AND ACU.ACU_CODPAI = ? "
    EndIf

    cQry += " AND ACU.D_E_L_E_T_ = ? "
    cQry += " ORDER BY ACU.ACU_COD "
    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)
    oQueryQry:SetString(nSeq++, xFilial("ACU"))

    If !Empty(cDesc)
        cDesc := DecodeUTF8(cDesc, "cp1252")
        oQueryQry:SetString(nSeq++, "%" + Upper(cDesc) + "%")
    EndIf

    If !Empty(cCodPai)
        oQueryQry:SetString(nSeq++, PadR(cCodPai, TamSx3("ACU_CODPAI")[1]))
    EndIf

    oQueryQry:SetString(nSeq++, Space(1))

    cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

    While (cAliasQry)->(!EOF())
        jItem := JsonObject():New()
        jItem["filial"] := AllTrim((cAliasQry)->ACU_FILIAL)
        jItem["cod"]    := AllTrim((cAliasQry)->ACU_COD)
        jItem["desc"]   := AllTrim((cAliasQry)->ACU_DESC)

        cCodPaiOut := AllTrim((cAliasQry)->ACU_CODPAI)
        If Empty(cCodPaiOut)
            jItem["codpai"] := Nil
        Else
            jItem["codpai"] := cCodPaiOut
        EndIf

        aAdd(aItens, jItem)
        jItem := Nil
        (cAliasQry)->(DbSkip())
    EndDo

    (cAliasQry)->(DbCloseArea())
    oQueryQry:Destroy()
    oQueryQry := Nil

    RestArea(aArea)

Return aItens
