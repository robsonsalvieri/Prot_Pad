#INCLUDE 'PROTHEUS.CH'
#INCLUDE 'tlpp-core.th'
#INCLUDE 'tlpp-rest.th'
#INCLUDE 'FWMVCDEF.CH'
#INCLUDE 'retail.autoparts.catalog.axlemodel.controller.ch'

namespace totvs.protheus.retail.autoparts.catalog.axlemodel.controller


/*/{Protheus.doc} retailAutopartsCatalogAxleModelController
    API relacionada ao Modelo de Eixo de dados do catalogo de autopecas
    @type    class
    @author  Alberto Deviciente
    @since   21/06/2026
    @version P12
/*/
Class retailAutopartsCatalogAxleModelController
    public Method New()
    private method FindAxleModel(cBranch as Character, cCode as Character,cName as Character) as Array

    @Get("/api/retail/v1/retailAutopartsCatalogAxleModel/getDataForAxleModel", description="Consulta o modelo de eixo do catalogo de autopecas")
    public Method getDataForAxleModel()

    @Post("/api/retail/v1/retailAutopartsCatalogAxleModel/postDataForAxleModel", description="Cadastra um novo modelo de eixo para o catalogo de autopecas")
    public Method postDataForAxleModel()

    @Put("/api/retail/v1/retailAutopartsCatalogAxleModel/putDataForAxleModel", description="Altera um modelo de eixo existente no catalogo de autopecas")
    public Method putDataForAxleModel()

    @Delete("/api/retail/v1/retailAutopartsCatalogAxleModel/deleteDataForAxleModel/:code", description="Deleta um modelo de eixo do catalogo de autopecas")
    public Method deleteDataForAxleModel()

EndClass

/*/{Protheus.doc} New
    Método   construtor
    @type    method
    @author  Alberto Deviciente
    @since   21/06/2026
    @version P12
    @return  Object, Objeto da classe
/*/
Method New() Class retailAutopartsCatalogAxleModelController
Return Self

/*/{Protheus.doc} getDataForAxleModel
    Retorna os Modelos de Eixo do catalogo de auto peças
    @type    method
    @author  Alberto Deviciente
    @since   21/06/2026
    @version P12
    @return  Logical, True (.T.)
/*/
Method getDataForAxleModel() Class retailAutopartsCatalogAxleModelController
    Local oJsonRespo    as Object
    Local oJParametr    as Object
    Local aArea         as Array
    Local aItens        as Array                  
    Local cBranch       as Character
    Local cCode         as Character
    Local cName         as Character
    Local nI            as Numeric

    oJsonRespo      := JsonObject():New()
    oJParametr      := Nil
    aArea           := GetArea()
    aItens          := {}
    cBranch         := xFilial("MG2")
    cCode           := ""
    cName           := ""
    nI              := 0

    DbSelectArea("MG2")

    oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

    // Obtém os dados enviados na Requisição (Via Query Params)
    oJParametr := oRest:getQueryRequest()

    // Obtém os parâmetros informados na requisição via URI (query param)
	If oJParametr:hasProperty('code')
		cCode := oJParametr['code']
	EndIf
    If oJParametr:hasProperty('name')
        cName := oJParametr['name']
    EndIf

    aItens := self:FindAxleModel(cBranch, cCode, cName)    
    
    If !empty(aItens)
        oJsonRespo["items"] := aItens
        oRest:setStatusCode(200)  // HTTP 200 = Sucesso
    Else
        oJsonRespo["items"] := {}
        oJsonRespo["message"] := EncodeUTF8(STR0001, "cp1252") //"Dado não encontrado para o filtro informado"
        oRest:setStatusCode(404)  // HTTP 404 = Not Found
    EndIf

    oRest:setResponse(oJsonRespo:toJson())

    // ==========================================
    // Libera Recursos da Memoria
    // ==========================================
    FwFreeObj(oJsonRespo)
    FwFreeObj(oJParametr)

    //Libera o objeto da memória em cada posição do array
    For nI := 1 To Len(aItens)
        FwFreeObj(aItens[nI])
    Next nI
    aItens := {}

    RestArea(aArea)

Return .T.

/*/{Protheus.doc} postDataForAxleModel
    Cadastra Modelo de Eixo do catalogo de autopecas
    @type    method
    @author  Alberto Deviciente
    @since   21/06/2026
    @version P12
    @return  Logical, True (.T.)
/*/
method postDataForAxleModel()  Class retailAutopartsCatalogAxleModelController
    Local oJsBody       as Object
    Local oJsonRespo    as Object
    Local oModel        as Object
    Local oModelMG2     as Object
    Local aArea         as Array
    Local cName         as Character
    Local lGravouOK     as Logical
    Local aErros        as Array
    Local lDadosOK      as Logical
    Local cJsonUtf8     := "" as Character
    Local cJsonCP1252   := "" as Character

    oJsBody       := JsonObject():New()
    oJsonRespo    := JsonObject():New()
    oModel        := Nil
    oModelMG2     := Nil
    aArea         := GetArea()
    cName         := ""
    lGravouOK     := .F.
    aErros        := {}
    lDadosOK      := .T.

    DbSelectArea("MG2")

    oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

    // Obtém os dados enviados na Requisição (Via Body Params)
    cJsonUtf8   := oRest:GetBodyRequest()
    cJsonCP1252 := DecodeUTF8(cJsonUtf8, "cp1252")  // Converte UTF-8 para CP1252
    oJsBody:fromJson(cJsonCP1252)

    // Obtém os dados enviados na Requisição (Body)
    If oJsBody:hasProperty('name')
        cName := oJsBody['name']
    EndIf

    // ==========================================
    // Validacao nome Obrigatorio
    // ==========================================
    If Empty(cName)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := EncodeUTF8(STR0002, "cp1252") + "'name'" //"Parâmetro obrigatório não informado: " ### "'name'"
        lDadosOK := .F.
    EndIf
    
    If lDadosOK
        // ==========================================
        // Carrega o Model MVC
        // ==========================================
        oModel := FWLoadModel("LOJA6070")  // Carrega o modelo de dados
        oModel:SetOperation(MODEL_OPERATION_INSERT)  // Define operação de inclusão
        oModel:Activate()  // Ativa o modelo
        
        // ------------------------------------------
        // Obtém o SubModel da Tabela MG2 (Modelo de Eixo)
        // ------------------------------------------
        oModelMG2 := oModel:GetModel("MG2MASTER")
        
        // ==========================================
        // Preenche os Campos do Model
        // ==========================================
        oModelMG2:SetValue("MG2_NOME", cName)
        
        // ==========================================
        // Valida e Grava os Dados
        // ==========================================
        
        // ------------------------------------------
        // Etapa 1: Validação dos Dados
        // ------------------------------------------
        If oModel:VldData()
            // ------------------------------------------
            // Etapa 2: Tentativa de Gravação (Commit)
            // ------------------------------------------
            lGravouOK := oModel:CommitData()
        Else
            // Validação falhou
            lGravouOK := .F.
        EndIf
        
        // ==========================================
        // Prepara a Resposta
        // ==========================================
        If lGravouOK
            oRest:setStatusCode(201)  // HTTP 201 = Created
            oJsonRespo['success']   := .T.
            oJsonRespo['message']   := EncodeUTF8(STR0003 + MG2->MG2_CODMOD + STR0004, "cp1252") //"Modelo de Eixo " ### " cadastrado com sucesso"
            oJsonRespo['branch']    := EncodeUTF8(AllTrim(MG2->MG2_FILIAL), "cp1252")
            oJsonRespo['code']      := EncodeUTF8(MG2->MG2_CODMOD, "cp1252")
            oJsonRespo['name']      := EncodeUTF8(AllTrim(MG2->MG2_NOME), "cp1252")
        Else
            // ------------------------------------------
            // ERRO: Falha na Validação ou Gravação
            // ------------------------------------------
            oRest:setStatusCode(400)  // HTTP 400 = Bad Request
            
            // Captura os erros do Model
            aErros := oModel:GetErrorMessage()
            
            /*
            Estrutura do Array aErros:
            [1] = Id do formulário de origem
            [2] = Id do campo de origem
            [3] = Id do formulário de erro
            [4] = Id do campo de erro
            [5] = Id do erro
            [6] = Mensagem do erro
            [7] = Mensagem da solução
            [8] = Valor atribuído
            [9] = Valor anterior
            */
            
            oJsonRespo['success']   := .F.
            oJsonRespo['message']   := EncodeUTF8(STR0005, "cp1252") //"Erro ao cadastrar"
            If Len(aErros) >= 7
                If !Empty(aErros[6])
                    oJsonRespo['message']   := EncodeUTF8(aErros[6], "cp1252")
                EndIf
                // Adiciona detalhes do erro se disponi­veis
                If !Empty(aErros[4])
                    oJsonRespo['field']     := EncodeUTF8(aErros[4], "cp1252")
                EndIf
            EndIf
        EndIf
        
        // ==========================================
        // Libera Recursos da Memória
        // ==========================================
        oModel:DeActivate()     // Desativa o Model
        FwFreeObj(oModel)       // Libera objeto da memória

    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())
        
    // ==========================================
    // Libera Recursos da Memória
    // ==========================================
    FwFreeObj(oJsBody)
    FwFreeObj(oJsonRespo)

    RestArea(aArea)

Return .T.

/*/{Protheus.doc} putDataForAxleModel
    Altera Modelo de Eixo do Catálogo de auto peças
    @type    method
    @author  Alberto Deviciente
    @since   21/06/2026
    @version P12
    @return  Logical, True (.T.)
/*/
method putDataForAxleModel()  Class retailAutopartsCatalogAxleModelController
    Local oJsonRespo    as Object
    Local oJsBody       as Object
    Local oJParametr    as Object
    Local lFound        as Logical
    Local aArea         as Array
    Local cBranch       as Character
    Local cCode         as Character
    Local cName         as Character
    Local oModel        as Object
    Local oModelMG2     as Object
    Local lGravouOK     as Logical
    Local aErros        as Array
    Local lDadosOK      as Logical
    Local cJsonUtf8     := "" as Character
    Local cJsonCP1252   := "" as Character

    oJsonRespo    := JsonObject():New()
    oJsBody       := JsonObject():New()
    oJParametr    := Nil
    lFound        := .F.
    aArea         := GetArea()
    cBranch       := xFilial("MG2")
    cCode         := ""
    cName         := ""
    oModel        := Nil
    oModelMG2     := Nil
    lGravouOK     := .F.
    aErros        := {}
    lDadosOK      := .T.

    oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

    // Obtém os dados enviados na Requisição (Via Query Params). Para localizar o registro a ser alterado.
    oJParametr  := oRest:getQueryRequest()

    // Obtém os dados enviados na Requisição (Via Body Params). Dados a serem atualizados
    cJsonUtf8   := oRest:GetBodyRequest()
    cJsonCP1252 := DecodeUTF8(cJsonUtf8, "cp1252")  // Converte UTF-8 para CP1252
    oJsBody:fromJson(cJsonCP1252)

    // Obtém os parâmetros informados na requisição via URI (query param). Para localizar o registro a ser alterado.
	If oJParametr:hasProperty('code')
		cCode := oJParametr['code']
	EndIf

    // Obtém os dados enviados na Requisição (Body). Dados a serem atualizados
    If oJsBody:hasProperty('name')
        cName := oJsBody['name']
    EndIf

    // ==========================================
    // Validacao codigo Obrigatorio
    // ==========================================
    If Empty(cCode)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := EncodeUTF8(STR0002, "cp1252") + "'code'" //"Parâmetro obrigatório não informado: " ### "'code'"
        lDadosOK := .F.
    EndIf

    If lDadosOK .And. Empty(cName)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := EncodeUTF8(STR0002, "cp1252") + "'name'" //"Parâmetro obrigatório não informado: " ### "'name'"
        lDadosOK := .F.
    EndIf

    If lDadosOK
        dbSelectArea('MG2')
        MG2->(dbSetOrder(1)) //MG2_FILIAL+MG2_CODMOD
        
        lFound := MG2->(dbSeek(cBranch + PadR(cCode,TamSx3("MG2_CODMOD")[1])))
        
        // ------------------------------------------
        // Se não encontrou retorna erro 404
        // ------------------------------------------
        If !lFound
            oRest:setStatusCode(404)  // HTTP 404 = Not Found
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := EncodeUTF8(STR0001, "cp1252") //"Dado não encontrado para o filtro informado"
            lDadosOK := .F.
        EndIf
    EndIf
    
    If lDadosOK
        // ==========================================
        // Carrega o Model MVC para Alteração
        // ==========================================
        oModel := FWLoadModel("LOJA6070")  // Carrega o modelo de dados
        oModel:SetOperation(MODEL_OPERATION_UPDATE)  // Define operação de ALTERAÇÃO
        oModel:Activate()  // Ativa o modelo
        
        // ------------------------------------------
        // Obtém o SubModel da Tabela MG2
        // ------------------------------------------
        oModelMG2 := oModel:GetModel("MG2MASTER")
        
        // ==========================================
        // Atualiza os Campos Informados
        // (Apenas os campos que foram enviados)
        // ==========================================
        oModelMG2:SetValue("MG2_NOME", cName)
        
        // ==========================================
        // Valida e Grava as Alterações
        // ==========================================
        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        Else
            lGravouOK := .F.
        EndIf
        
        If lGravouOK
            oRest:setStatusCode(200)  // HTTP 200 = OK
            oJsonRespo['success'] := .T.
            oJsonRespo['message'] := EncodeUTF8(STR0003 + MG2->MG2_CODMOD + STR0006, "cp1252") //"Modelo de Eixo " ### " atualizado com sucesso"
            oJsonRespo['branch']  := EncodeUTF8(AllTrim(MG2->MG2_FILIAL), "cp1252")
            oJsonRespo['code']    := EncodeUTF8(MG2->MG2_CODMOD, "cp1252")
            oJsonRespo['name']    := EncodeUTF8(AllTrim(MG2->MG2_NOME), "cp1252")
        Else
            oRest:setStatusCode(400)  // HTTP 400 = Bad Request
            
            // Captura os erros do Model
            aErros := oModel:GetErrorMessage()
            
            /*
            Estrutura do Array aErros:
            [1] = Id do formulário de origem
            [2] = Id do campo de origem
            [3] = Id do formulário de erro
            [4] = Id do campo de erro
            [5] = Id do erro
            [6] = Mensagem do erro
            [7] = Mensagem da solução
            [8] = Valor atribuído
            [9] = Valor anterior
            */
            
            oJsonRespo['success']   := .F.
            oJsonRespo['message']   := EncodeUTF8(STR0007, "cp1252") //"Erro ao atualizar"

            If Len(aErros) >= 7
                If !Empty(aErros[6])
                    oJsonRespo['message']   := EncodeUTF8(aErros[6], "cp1252")
                EndIf
                // Adiciona detalhes do erro se disponi­veis
                If !Empty(aErros[4])
                    oJsonRespo['field']     := EncodeUTF8(aErros[4], "cp1252")
                EndIf
            EndIf
        EndIf
        
        // ==========================================
        // Libera Recursos da Memória
        // ==========================================
        oModel:DeActivate()     // Desativa o Model
        FwFreeObj(oModel)       // Libera objeto da memória
        
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())
        
    // ==========================================
    // Libera Recursos da Memória
    // ==========================================
    FwFreeObj(oJsBody)
    FwFreeObj(oJsonRespo)
    FwFreeObj(oJParametr)

    RestArea(aArea)

Return .T.

/*/{Protheus.doc} deleteDataForAxleModel
    Deleta Modelo de Eixo do Catálogo de auto peças
    @type    method
    @author  Alberto Deviciente
    @since   21/06/2026
    @version P12
    @return  Logical, True (.T.)
/*/
method deleteDataForAxleModel()  Class retailAutopartsCatalogAxleModelController
    Local oJsonRespo    as Object
    Local oJParametr    as Object
    Local lFound        as Logical
    Local cBranch       as Character
    Local aArea         as Array
    Local oModel        as Object
    Local lGravouOK     as Logical
    Local lDadosOK      as Logical
    Local cCode         as Character

    oJsonRespo    := JsonObject():New()
    oJParametr    := Nil
    lFound        := .F.
    cBranch       := xFilial("MG2")
    aArea         := GetArea()
    oModel        := Nil
    lGravouOK     := .F.
    lDadosOK      := .T.
    cCode         := ""

    // Obtém os dados enviados na requisição (Via Path Parameters)
    oJParametr  := oRest:getPathParamsRequest()
    
    oRest:setKeyHeaderResponse("Content-Type", "application/json")
    
    // Obtém os parâmetros informados na requisição via URI (path param)
	If oJParametr:hasProperty('code')
		cCode := oJParametr['code']
	EndIf

    If Empty(cCode)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := EncodeUTF8(STR0002, "cp1252") + "'code'" //"Parâmetro obrigatório não informado: " ### "'code'"
        lDadosOK := .F.
    EndIf

    If lDadosOK
        dbSelectArea('MG2')
        MG2->(dbSetOrder(1)) //MG2_FILIAL+MG2_CODMOD
        
        lFound := MG2->(dbSeek(cBranch + PadR(cCode,TamSx3("MG2_CODMOD")[1])))

        // ------------------------------------------
        // Se nao encontrou retorna erro 404
        // ------------------------------------------
        If !lFound
            oRest:setStatusCode(404)  // HTTP 404 = Not Found
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := EncodeUTF8(STR0001, "cp1252") //"Dado não encontrado para o filtro informado"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        // ==========================================
        // Carrega o Model MVC para Alteracao
        // ==========================================
        oModel := FWLoadModel("LOJA6070")  // Carrega o modelo de dados
        oModel:SetOperation(MODEL_OPERATION_DELETE)  // Define operação de EXCLUSÃO
        oModel:Activate()  // Ativa o modelo

        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        EndIf

        // ----------------------------------------------------------------------------------------------------
        // Resposta default: erro (padrao defensivo). 
        // Caso a exclusão não ocorra por algum motivo, a resposta já estará configurada para retornar o erro.
        // ----------------------------------------------------------------------------------------------------
        oRest:setStatusCode(400)  // HTTP 400 = Bad Request
        oJsonRespo['success'] := .F.
        oJsonRespo['message']  := EncodeUTF8(STR0009, "cp1252") //"Erro ao tentar deletar"

        If lGravouOK
            oRest:setStatusCode(200)  // HTTP 200 = OK
            oJsonRespo['success'] := .T.
            oJsonRespo['message'] := EncodeUTF8(STR0003 + AllTrim(cCode) + STR0008, "cp1252") //"Modelo de Eixo " ### " deletado com sucesso"
        EndIf
        
        // ==========================================
        // Libera Recursos da Memoria
        // ==========================================
        oModel:DeActivate()     // Desativa o Model
        FwFreeObj(oModel)       // Libera objeto da memoria

    EndIf
    
    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    // ==========================================
    // Libera Recursos da Memoria
    // ==========================================
    FwFreeObj(oJsonRespo)
    FwFreeObj(oJParametr)

    RestArea(aArea)

Return .T.

/*/{Protheus.doc} FindAxleModel
    Consulta Modelo de Eixo do Catálogo de auto peças
    @type    method
    @author  Alberto Deviciente
    @since   21/06/2026
    @version P12
    @param  cBranch , Character , filial a ser filtrada
    @param  cCode   , Character , codigo a ser filtrado
    @param  cName   , Character , nome a ser filtrado
    @return aItens  , Array     , array de itens com os dados encontrados
/*/
method FindAxleModel(cBranch as Character, cCode as Character, cName as Character) as Array Class retailAutopartsCatalogAxleModelController
    Local oQueryQry		as Object
    Local aItens        as Array
	Local cQry			as Character
	Local nSeq			as Numeric
    Local cAliasQry     as Character
    Local jItem         as Object

    Default cBranch     := xFilial("MG2")
    Default cCode       := ""
    Default cName       := ""

	nSeq		:= 1
    aItens      := {}

	cQry	:= " SELECT MG2.MG2_FILIAL, MG2.MG2_CODMOD, MG2.MG2_NOME"
	cQry	+= " FROM "+ RetSqlName("MG2") +" MG2 "
	cQry	+= " WHERE "
	cQry	+= " MG2.MG2_FILIAL = ? "
    If !Empty(cCode)
        cQry	+= " AND MG2.MG2_CODMOD = ? "
    EndIf
    If !Empty(cName)
        cQry += " AND UPPER(MG2.MG2_NOME) LIKE ? "
    EndIf
    cQry	+= " AND MG2.D_E_L_E_T_ = ? "
	cQry 	:= ChangeQuery(cQry)
	oQueryQry := FwExecStatement():New(cQry)
    oQueryQry:SetString(nSeq++,		cBranch)
    If !Empty(cCode)
        oQueryQry:SetString(nSeq++, PadR(cCode, TamSx3("MG2_CODMOD")[1]))
    EndIf
    If !Empty(cName)
        oQueryQry:SetString(nSeq++, "%" + Upper(cName) + "%")
    EndIf
	oQueryQry:SetString(nSeq++,		Space(1))
	
	cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

	While (cAliasQry)->( !EOF() )
        jItem := JsonObject():New()
        jItem["branch"] := EncodeUTF8(AllTrim((cAliasQry)->MG2_FILIAL), "cp1252")
        jItem["code"]   := EncodeUTF8(AllTrim((cAliasQry)->MG2_CODMOD), "cp1252")
        jItem["name"]   := EncodeUTF8(AllTrim((cAliasQry)->MG2_NOME), "cp1252")
        // Adiciona o item no array de itens
        aAdd(aItens, jItem)
        jItem := Nil
        (cAliasQry)->(dbSkip())
	EndDo

	(cAliasQry)->(dbCloseArea())
    oQueryQry:Destroy()
    oQueryQry := Nil

Return(aItens)
