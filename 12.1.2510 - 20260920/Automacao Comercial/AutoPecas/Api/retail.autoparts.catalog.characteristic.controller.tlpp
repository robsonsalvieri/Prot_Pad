#include "totvs.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "retail.autoparts.catalog.characteristic.controller.ch"

namespace totvs.protheus.retail.autoparts.catalog.characteristic.controller

/*/{Protheus.doc} RetailAutopartsCatalogCharacteristicController
    API relacionadas as caracteristicas de produto do catalogo de autopecas (tabela D4V)
    @type   class
    @author eduardo.flima
    @since  29/06/2026
/*/
Class RetailAutopartsCatalogCharacteristicController

    private data lHasNext   as Logical
    private data nStart     as Numeric
    private data nEnd       as Numeric

    private Method FindCharacteristic(cAlias as Character) as Array
    private Method ExecQuery(cCode as Character, cName as Character, cType as Character, lTotal as Logical) as Character

    public Method New()

    @Get("/api/retail/v1/retailAutopartsCatalogCharacteristic/getDataForCharacteristic", description="Consulta as caracteristicas de produto do catalogo de auto pecas.")
    public Method getDataForCharacteristic()

EndClass

/*/{Protheus.doc} New
    Metodo construtor
    @type   method
    @author eduardo.flima
    @since  29/06/2026
/*/
Method New() Class RetailAutopartsCatalogCharacteristicController
    self:lHasNext := .F.
Return self

/*/{Protheus.doc} getDataForCharacteristic
    Retorna as caracteristicas de produto do catalogo de auto pecas
    @type    method
    @author  eduardo.flima
    @since   29/06/2026
    @version p12
    @return  logical, retorno padrão .T.
/*/
Method getDataForCharacteristic() Class RetailAutopartsCatalogCharacteristicController
    Local oJsonRespo    as Object
    Local oJParametr    as Object
    Local aItens        as Array
    Local cCode         as Character
    Local cName         as Character
    Local cType         as Character
    Local nPage         as Numeric
    Local nPageSize     as Numeric
    Local cAliasQry     as Character
    Local aArea         as Array

    aArea       := GetArea()
    oJsonRespo  := JsonObject():New()
    aItens      := {}
    oJParametr  := oRest:getQueryRequest()

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    If oJParametr['code'] == Nil .Or. Empty(oJParametr['code'])
        cCode := ""
    Else
        cCode := oJParametr['code']
    EndIf

    If oJParametr['name'] == Nil .Or. Empty(oJParametr['name'])
        cName := ""
    Else
        cName := oJParametr['name']
    EndIf

    If oJParametr['type'] == Nil .Or. Empty(oJParametr['type'])
        cType := ""
    Else
        cType := oJParametr['type']
    EndIf

    If oJParametr['page'] == Nil .Or. Empty(oJParametr['page'])
        nPage := 1
    Else
        nPage := Val(oJParametr['page'])
    EndIf

    If oJParametr['pagesize'] == Nil .Or. Empty(oJParametr['pagesize'])
        nPageSize := 20
    Else
        nPageSize := Val(oJParametr['pagesize'])
    EndIf

    Self:nStart := (nPage - 1) * nPageSize + 1

    //-- O +1 é necessário para corrigir o cálculo da linha final, pois a função ROW_NUMBER() inicia a contagem em 1
    Self:nEnd := nPage * nPageSize + 1

    cAliasQry := Self:ExecQuery(cCode, cName, cType, .F.)

    If !Empty(cAliasQry)
        aItens := Self:FindCharacteristic(cAliasQry)
    EndIf
    (cAliasQry)->(dbCloseArea())
    
    If Len(aItens) > 0
        cAliasQry := ""
        cAliasQry := Self:ExecQuery(cCode, cName, cType, .T.)

        oJsonRespo["items"]                      := aItens
        oJsonRespo["pagination"]                 := JsonObject():New()
        oJsonRespo["pagination"]["page"]         := nPage
        oJsonRespo["pagination"]["pagesize"]     := nPageSize
        oJsonRespo["pagination"]["totalitems"]   := (cAliasQry)->TOTAL
        oJsonRespo["pagination"]["totalpages"]   := Int(((cAliasQry)->TOTAL + nPageSize - 1) / nPageSize)
        oJsonRespo["pagination"]["nextpage"]     := self:lHasNext
        oJsonRespo["pagination"]["previouspage"] := nPage > 1

        (cAliasQry)->(dbCloseArea())

        oRest:setStatusCode(200)
    Else
        oJsonRespo["items"]   := {}
        oJsonRespo["message"] := STR0001 //"Dados não encontrados para o filtro informado"
        oRest:setStatusCode(404)
    EndIf

    oRest:setResponse(oJsonRespo:toJson())

    RestArea(aArea)
    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

Return .T.

/*/{Protheus.doc} FindCharacteristic
    Mapeia os registros do alias temporario para array JSON
    @type    method
    @author  eduardo.flima
    @since   29/06/2026
    @version p12
    @param   cAlias, Character, alias temporario retornado por ExecQuery
    @return  Array,  Array,     array de itens encontrados
/*/
Method FindCharacteristic(cAliasQry as Character) as Array Class RetailAutopartsCatalogCharacteristicController
    Local jItem     as Object
    Local aItens    as Array

    aItens := {}

    While (cAliasQry)->(!EOF())

        If (cAliasQry)->LINHA > (Self:nEnd - 1)
            Self:lHasNext := .T.
            Exit
        EndIf

        jItem := JsonObject():New()
        jItem["branch"] := AllTrim((cAliasQry)->D4V_FILIAL)
        jItem["code"]   := AllTrim((cAliasQry)->D4V_COD)
        jItem["name"]   := AllTrim((cAliasQry)->D4V_NOME)
        jItem["type"]   := AllTrim((cAliasQry)->D4V_TIPO)

        aAdd(aItens, jItem)
        jItem := Nil
        (cAliasQry)->(dbSkip())
    EndDo


Return(aItens)

/*/{Protheus.doc} ExecQuery
    Consulta caracteristicas de produto da tabela D4V
    @type    method
    @author  eduardo.flima
    @since   29/06/2026
    @version p12
    @param   cCode  , Character, filtro pelo codigo da caracteristica
    @param   cName  , Character, filtro pelo nome da caracteristica
    @param   cType  , Character, filtro pelo tipo da caracteristica
    @param   lTotal , Logical,   indica se deve retornar o total de itens
    @return  Character, alias temporario com os itens encontrados
/*/
Method ExecQuery(cCode as Character, cName as Character, cType as Character, lTotal as Logical) as Character Class RetailAutopartsCatalogCharacteristicController
    Local cTable    as Character
    Local cQry      as Character
    Local oQueryQry as Object
    Local nSeq      as Numeric

    Default lTotal := .F.

    nSeq := 1


    If !lTotal
        cQry := " SELECT * FROM ("
        cQry += " SELECT ROW_NUMBER() OVER(ORDER BY D4V.D4V_COD ASC) AS LINHA, D4V_FILIAL, D4V_COD, D4V_NOME, D4V_TIPO "
    Else
        cQry := " SELECT COUNT(D4V.D4V_COD) AS TOTAL "
    EndIf

    cQry += "   FROM " + RetSqlName("D4V") + " D4V "
    cQry += "  WHERE D4V.D4V_FILIAL = ? "

    If !Empty(cCode)
        cQry += " AND D4V.D4V_COD = ? "
    EndIf

    If !Empty(cName)
        cQry += " AND UPPER(D4V.D4V_NOME) LIKE ? "
    EndIf

    If !Empty(cType)
        cQry += " AND D4V.D4V_TIPO = ? "
    EndIf

    cQry += " AND D4V.D_E_L_E_T_ = ? "

    If !lTotal
        cQry += ") TAB"
        cQry += " WHERE LINHA BETWEEN ? AND ?"
    EndIf

    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)

    oQueryQry:SetString(nSeq++, FWxFilial("D4V"))

    If !Empty(cCode)
        oQueryQry:SetString(nSeq++, cCode)
    EndIf

    If !Empty(cName)
        //-- Ajuste para evitar problemas com acentos na consulta
        cName := DecodeUTF8(cName, "cp1252")
        oQueryQry:SetString(nSeq++, "%" + Upper(cName) + "%")
    EndIf

    If !Empty(cType)
        oQueryQry:SetString(nSeq++, cType)
    EndIf

    oQueryQry:SetString(nSeq++, Space(1))

    If !lTotal
        oQueryQry:SetNumeric(nSeq++, Self:nStart)
        oQueryQry:SetNumeric(nSeq++, Self:nEnd)
    EndIf

    cTable := oQueryQry:OpenAlias(GetNextAlias())

    oQueryQry:Destroy()
    oQueryQry := Nil

Return cTable
