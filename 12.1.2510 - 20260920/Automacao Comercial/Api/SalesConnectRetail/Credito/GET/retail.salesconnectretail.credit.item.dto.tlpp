#include "totvs.ch"
#include "tlpp-core.th"

namespace totvs.protheus.retail.salesconnectretail.dto

/*/{Protheus.doc} SalesConnectRetailCreditItemDto
DTO de um item (titulo de credito SE1) na resposta do GET .../credit/.
@author Thalys Augusto Alves Juvenal
@since  31/07/2026
@version 1.0
@type class
/*/
Class SalesConnectRetailCreditItemDto
    Public Data nId            as Numeric
    Public Data cBranch        as Character
    Public Data cCustomerCode  as Character
    Public Data cCustomerStore as Character
    Public Data cPrefix        as Character
    Public Data cNumber        as Character
    Public Data cInstallment   as Character
    Public Data cType          as Character
    Public Data cTaxId         as Character
    Public Data nBalance       as Numeric
    Public Data cDueDate       as Character

    Public Method New(nId as Numeric, cBranch as Character, cCustomerCode as Character, cCustomerStore as Character, cPrefix as Character, cNumber as Character, cInstallment as Character, cType as Character, cTaxId as Character, nBalance as Numeric, cDueDate as Character) as Object
    Public Method toJsonObject() as Json
EndClass

/*/{Protheus.doc} New
Construtor do item de credito (1 titulo SE1). Parametro ausente assume default.
@param nId,            numeric,   ID do titulo = R_E_C_N_O_ da SE1
@param cBranch,        character, filial de origem do titulo (E1_FILIAL)
@param cCustomerCode,  character, codigo do cliente (E1_CLIENTE / A1_COD)
@param cCustomerStore, character, loja do cliente (E1_LOJA / A1_LOJA)
@param cPrefix,        character, prefixo (E1_PREFIXO)
@param cNumber,        character, numero do titulo (E1_NUM)
@param cInstallment,   character, parcela (E1_PARCELA)
@param cType,          character, tipo de credito (E1_TIPO: NCC|RA)
@param cTaxId,         character, CPF/CNPJ do cliente
@param nBalance,       numeric,   saldo disponivel (E1_SALDO)
@param cDueDate,       character, vencimento real ISO "YYYY-MM-DD" (E1_VENCREA)
@return object, Self
@type method
/*/
Method New(nId as Numeric, cBranch as Character, cCustomerCode as Character, cCustomerStore as Character, cPrefix as Character, cNumber as Character, cInstallment as Character, cType as Character, cTaxId as Character, nBalance as Numeric, cDueDate as Character) as Object Class SalesConnectRetailCreditItemDto
    Default nId            := 0
    Default cBranch        := ""
    Default cCustomerCode  := ""
    Default cCustomerStore := ""
    Default cPrefix        := ""
    Default cNumber        := ""
    Default cInstallment   := ""
    Default cType          := ""
    Default cTaxId         := ""
    Default nBalance       := 0
    Default cDueDate       := ""

    ::nId            := nId
    ::cBranch        := cBranch
    ::cCustomerCode  := cCustomerCode
    ::cCustomerStore := cCustomerStore
    ::cPrefix        := cPrefix
    ::cNumber        := cNumber
    ::cInstallment   := cInstallment
    ::cType          := cType
    ::cTaxId         := cTaxId
    ::nBalance       := nBalance
    ::cDueDate       := cDueDate
Return Self

/*/{Protheus.doc} toJsonObject
Monta o JsonObject do item (sem serializar), para o envelope agregar direto.
@return object, JsonObject com id/branch/customerCode/customerStore/prefix/number/installment/type/taxId/balance/dueDate
@type method
/*/
Method toJsonObject() as Json Class SalesConnectRetailCreditItemDto
    Local oJson := JsonObject():New() as Json
    oJson["id"]            := ::nId
    oJson["branch"]        := ::cBranch
    oJson["customerCode"]  := ::cCustomerCode
    oJson["customerStore"] := ::cCustomerStore
    oJson["prefix"]        := ::cPrefix
    oJson["number"]        := ::cNumber
    oJson["installment"]   := ::cInstallment
    oJson["type"]          := ::cType
    oJson["taxId"]         := ::cTaxId
    oJson["balance"]       := ::nBalance
    oJson["dueDate"]       := ::cDueDate
Return oJson
