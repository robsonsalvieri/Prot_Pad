#include "totvs.ch"
#include "tlpp-core.th"
#include "retail.salesconnectretail.credit.query.dto.ch"

namespace totvs.protheus.retail.salesconnectretail.dto

/*/{Protheus.doc} SalesConnectRetailCreditQueryDto
DTO dos parametros de consulta (query string) do GET /api/retail/v1/SalesConnectRetail/credit/.
@author Thalys Augusto Alves Juvenal
@since  31/07/2026
@version 1.0
@type class
/*/
Class SalesConnectRetailCreditQueryDto
    Public Data cTaxId    as Character
    Public Data cType     as Character
    Public Data nPage     as Numeric
    Public Data nPageSize as Numeric

    Public Method New() as Object
    Public Method fromJson(cJson as Character) as Object
    Public Method hasTaxId() as Logical
    Protected Method QStr(oJson as Json, cKey as Character) as Character
    Protected Method OnlyDigits(cVal as Character) as Character
EndClass

/*/{Protheus.doc} QStr
Le um texto do JsonObject tolerando chave AUSENTE: neste build o GetJsonText de
uma chave inexistente retorna a string "null" - normaliza para "" (+ AllTrim).
@param oJson, json, JsonObject (tipo J)
@param cKey,  character, chave a ler
@return character, valor (ou "")
@type method
/*/
Method QStr(oJson as Json, cKey as Character) as Character Class SalesConnectRetailCreditQueryDto
    Local cVal := oJson:GetJsonText(cKey)
    If ValType(cVal) != "C" .Or. cVal == "null"
        cVal := ""
    EndIf
    cVal := AllTrim(cVal)
Return cVal

/*/{Protheus.doc} OnlyDigits
Mantem apenas digitos 0-9 (remove mascara de CPF/CNPJ: pontos, tracos, barras).
Sem isso, um taxId formatado nao casa com A1_CGC (armazenado so com digitos).
@param cVal, character, valor cru
@return character, apenas os digitos
@type method
/*/
Method OnlyDigits(cVal as Character) as Character Class SalesConnectRetailCreditQueryDto
    Local cRet := "" as Character
    Local nI   as Numeric
    Local cCh  as Character
    For nI := 1 To Len(cVal)
        cCh := SubStr(cVal, nI, 1)
        If cCh >= "0" .And. cCh <= "9"
            cRet += cCh
        EndIf
    Next nI
Return cRet

/*/{Protheus.doc} New
Construtor: taxId/type vazios, paginacao default (page 1, pageSize 20).
@return object, Self
@type method
/*/
Method New() as Object Class SalesConnectRetailCreditQueryDto
    ::cTaxId    := ""
    ::cType     := ""
    ::nPage     := 1
    ::nPageSize := 20
Return Self

/*/{Protheus.doc} fromJson
Desserializa a query string (JSON) preenchendo taxId/type/paginacao. type e
normalizado para maiusculo (NCC/RA).
@param cJson, character, query string serializada como JSON
@return object, Self
@type method
/*/
Method fromJson(cJson as Character) as Object Class SalesConnectRetailCreditQueryDto
    Local oJson as Json
    Local cRaw  as Character

    oJson := JsonObject():New()
    oJson:fromJson(cJson)
    ::cTaxId := ::OnlyDigits(::QStr(oJson, "taxId"))
    ::cType  := Upper(::QStr(oJson, "type"))
    cRaw := ::QStr(oJson, "page")
    ::nPage := If(Empty(cRaw), 1, Val(cRaw))
    cRaw := ::QStr(oJson, "pageSize")
    ::nPageSize := If(Empty(cRaw), 20, Val(cRaw))
    FWFreeObj(oJson)
Return Self

/*/{Protheus.doc} hasTaxId
Indica se o filtro obrigatorio taxId (CPF/CNPJ) foi informado.
@return logical, .T. se taxId nao vazio
@type method
/*/
Method hasTaxId() as Logical Class SalesConnectRetailCreditQueryDto
    Local lRet := .F. as Logical
    lRet := !Empty(::cTaxId)
Return lRet
