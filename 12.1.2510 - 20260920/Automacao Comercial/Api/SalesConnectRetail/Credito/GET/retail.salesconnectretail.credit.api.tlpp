#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "retail.salesconnectretail.credit.api.ch"

namespace totvs.protheus.retail.salesconnectretail

using namespace totvs.protheus.retail.salesconnectretail.obj

/*/{Protheus.doc} GetVendaVarejoCredito
API GET de consulta de creditos NCC/RA do cliente (SE1) via IPaaS (DVARPV-7981).
Recebe CPF/CNPJ (taxId) e devolve a lista paginada de creditos em aberto (saldo>0),
com id (R_E_C_N_O_) + chave de negocio, para o PDV aplicar no fluxo de troca/devolucao.

Function thin: extrai o header X-PASS-KEY e delega TODO o processamento a
SalesConnectRetailCreditObj (autentica, valida, consulta SE1<->SA1, monta o envelope).

Autenticacao em duas camadas: framework REST do ERP (usuario/senha) + X-PASS-KEY
(token fixo da API). Empresa/filial posicionadas pelo header tenantId da plataforma.

Endpoint: GET /api/retail/v1/SalesConnectRetail/credit/
Headers:
  - tenantId    : <grupoEmpresas>,<filial>   (padrao plataforma - obrigatorio)
  - X-PASS-KEY  : <token>                     (token API adicional)
Query Params:
  - taxId    : CPF/CNPJ do consumidor (obrigatorio)
  - type     : NCC | RA (opcional; default ambos)
  - page     : pagina (default 1, minimo 1)
  - pageSize : itens por pagina (default 20, maximo 100)
Respostas:
  - 200 OK -> { items[], hasNext, remainingRecords, total, totalBalance }
  - 400    -> 0007 taxId ausente | 0008 paginacao invalida
  - 401    -> 0002 X-PASS-KEY invalido/ausente
  - 404    -> 0009 cliente nao encontrado
  - 500    -> 0099 erro catastrofico

@author  Thalys Augusto Alves Juvenal
@since   31/07/2026
@version 1.0
@history DVARPV-7981 - Consulta de Saldo NCC (Credito de Cliente)
@type function
@return Nil, a resposta e enviada via oRest (setStatusCode/setResponse)
/*/
@Get("/api/retail/v1/SalesConnectRetail/credit/")
Function GetVendaVarejoCredito()
    Local jParams    as Json
    Local oObj       as Object
    Local cAuth      as Character
    Local cQueryJson as Character

    jParams := oRest:getQueryRequest()

    cAuth      := oRest:getHeaderRequest("X-PASS-KEY")
    cQueryJson := jParams:toJson()

    LjGrvLog("/api/retail/v1/SalesConnectRetail/credit/", "Query recebida:", cQueryJson)

    oObj := SalesConnectRetailCreditObj():New(cAuth, cQueryJson)
    oObj:Process()

    oRest:setStatusCode(oObj:nHttpStatus)
    oRest:setKeyHeaderResponse('Content-Type', 'application/json; charset=utf-8')
    oRest:setResponse( FWHttpEncode(oObj:cReturn) )

    LjGrvLog("/api/retail/v1/SalesConnectRetail/credit/", "Status: " + cValToChar(oObj:nHttpStatus), oObj:cUuid)
    FWFreeObj(oObj)
Return
