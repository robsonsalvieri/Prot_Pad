#include "totvs.ch"
#include "tlpp-core.th"

namespace totvs.protheus.retail.salesconnectretail.dto

/*/{Protheus.doc} SalesConnectRetailCreditWriteOffResponseDto
DTO do envelope de sucesso (HTTP 200) do POST .../credit/writeoff/ - a compensacao
de uma venda.
@author Thalys Augusto Alves Juvenal
@since  07/08/2026
@version 2.0
@type class
/*/
Class SalesConnectRetailCreditWriteOffResponseDto
    Public Data cSaleDocument as Character
    Public Data cCreditTitle  as Character
    Public Data nChange       as Numeric
    Public Data aCredits      as Array
    Public Data cUuid         as Character

    Public Method New(cSaleDoc as Character, cCreditTitle as Character, nChange as Numeric, aCredits as Array, cUuid as Character) as Object
    Public Method toJson() as Character
EndClass

/*/{Protheus.doc} New
Construtor. aCredits nao-Array vira {}.
@type method
@author Thalys Augusto Alves Juvenal
@since  07/08/2026
@param cSaleDoc, character, documento da venda (L1_NUM) que usou o credito
@param cCreditTitle, character, identificacao do titulo CR gerado (best-effort)
@param nChange, numeric, troco gerado em novo credito NCC (changeNccGenerated)
@param aCredits, array, creditos baixados (SalesConnectRetailCreditWriteOffItemDto)
@param cUuid, character, identificador unico da chamada (rastreabilidade)
@return object, Self
/*/
Method New(cSaleDoc as Character, cCreditTitle as Character, nChange as Numeric, aCredits as Array, cUuid as Character) as Object Class SalesConnectRetailCreditWriteOffResponseDto
    If ValType(aCredits) != "A"
        aCredits := {}
    EndIf
    ::cSaleDocument := cSaleDoc
    ::cCreditTitle  := cCreditTitle
    ::nChange       := nChange
    ::aCredits      := aCredits
    ::cUuid         := cUuid
Return Self

/*/{Protheus.doc} toJson
Serializa o envelope: status/saleDocument/creditTitle/changeNccGenerated/credits[]/uuid.
@type method
@author Thalys Augusto Alves Juvenal
@since  07/08/2026
@return character, JSON do envelope de sucesso
/*/
Method toJson() as Character Class SalesConnectRetailCreditWriteOffResponseDto
    Local oJson    as Json
    Local aResults := {} as Array
    Local nI       as Numeric
    Local cRet     as Character

    oJson := JsonObject():New()
    For nI := 1 To Len(::aCredits)
        AAdd(aResults, ::aCredits[nI]:toJsonObject())
    Next nI
    oJson["status"]             := "Success"
    oJson["saleDocument"]       := ::cSaleDocument
    oJson["creditTitle"]        := ::cCreditTitle
    oJson["changeNccGenerated"] := ::nChange
    oJson["credits"]            := aResults
    oJson["uuid"]               := ::cUuid
    cRet := oJson:toJson()
    FWFreeObj(oJson)
Return cRet
