#include "totvs.ch"
#include "tlpp-core.th"
#include "retail.salesconnectretail.request.dto.ch"

namespace totvs.protheus.retail.salesconnectretail.dto

/*/{Protheus.doc} SalesConnectRetailRequestDto
DTO do payload JSON (1 cupom) para POST /api/retail/v1/SalesConnectRetail/.
@author Thalys Augusto Alves Juvenal
@since  18/05/2026
@version 1.0
@type class
/*/
Class SalesConnectRetailRequestDto
    Public Data cCodFil            as Character
    Public Data nModeloFiscal      as Numeric
    Public Data cXmlSefazBase64    as Character
    Public Data cCodigoCliente     as Character
    Public Data cLojaCliente       as Character
    Public Data cCpfCnpjConsumidor as Character
    Public Data cVendaData         as Character
    Public Data cSerieNota         as Character
    Public Data cChaveAcesso       as Character
    Public Data oOperador          as Object
    Public Data oVendaCustodiaXml  as Object
    Public Data aPagamentos        as Array
    Public Data aCamposExtraSL1   as Array   // extraAttributes.Fields -> {{cFieldName, xFieldValue}, ...}
    Public Data aCamposExtraItens as Array   // itemExtraAttributes    -> {{nItem, {{cFieldName, xFieldValue}, ...}}, ...}

    Public Method New() as Object
    Public Method fromJson(cJson as Character) as Object
    Protected Method LeFields(oHolder) as Array
EndClass

/*/{Protheus.doc} New
Construtor: inicializa as colecoes (pagamentos e atributos de item) vazias.
@type method
@author Thalys Augusto Alves Juvenal
@since  18/05/2026
@return object, Self
/*/
Method New() as Object Class SalesConnectRetailRequestDto
    ::aPagamentos       := {}
    ::aCamposExtraSL1   := {}
    ::aCamposExtraItens := {}
Return Self

/*/{Protheus.doc} fromJson
Desserializa o JSON do cupom nos campos do DTO. Lanca erro (Throw) em JSON
invalido, capturavel pelo Try/Catch do chamador (SalesConnectRetailObj:ParseRequest).
@type method
@author Thalys Augusto Alves Juvenal
@since  18/05/2026
@param cJson, character, payload JSON cru do cupom
@return object, Self
/*/
Method fromJson(cJson as Character) as Object Class SalesConnectRetailRequestDto
    Local oJson       as Object
    Local aItensExtra as Array
    Local oEntrada    as Object
    Local nItemEx     := 0 as Numeric
    Local nIdx        := 0 as Numeric

    oJson := JsonObject():New()
    oJson:fromJson(cJson)
    // branch NAO e mais lido do body (DVARPV-6451): a filial vem do header
    // tenantId. O campo branch existe apenas no response (results[].branch).
    ::nModeloFiscal      := Val(oJson:GetJsonText("fiscalModel"))
    ::cXmlSefazBase64    := oJson:GetJsonText("xmlSefazBase64")
    ::cCodigoCliente     := oJson:GetJsonText("customerCode")
    ::cLojaCliente       := oJson:GetJsonText("customerStore")
    ::cCpfCnpjConsumidor := oJson:GetJsonText("consumerTaxId")
    ::cVendaData         := oJson:GetJsonText("saleDate")
    ::cSerieNota         := oJson:GetJsonText("documentSeries")
    ::cChaveAcesso       := oJson:GetJsonText("accessKey")
    ::oOperador          := oJson["operator"]
    ::oVendaCustodiaXml  := oJson["authorization"]
    ::aPagamentos        := oJson["payments"]
    // extraAttributes.Fields (SL1) e itemExtraAttributes[].Fields (SL2): campos
    // graveis genericos {FieldName, FieldValue}. Pareamento de item pela chave "Item".
    ::aCamposExtraSL1   := ::LeFields(oJson["extraAttributes"])
    ::aCamposExtraItens := {}
    If ValType(oJson["itemExtraAttributes"]) == "A"
        aItensExtra := oJson["itemExtraAttributes"]
        For nIdx := 1 To Len(aItensExtra)
            oEntrada := aItensExtra[nIdx]
            If ValType(oEntrada) == "J"
                nItemEx := 0
                If ValType(oEntrada["Item"]) == "N"
                    nItemEx := oEntrada["Item"]
                ElseIf ValType(oEntrada["Item"]) == "C"
                    nItemEx := Val(oEntrada["Item"])
                EndIf
                AAdd(::aCamposExtraItens, { nItemEx, ::LeFields(oEntrada) })
            EndIf
        Next nIdx
    EndIf
Return Self

/*/{Protheus.doc} LeFields
Le a lista "Fields" de um holder (o objeto extraAttributes, ou uma entrada de
itemExtraAttributes) e retorna {{cFieldName, xFieldValue}, ...}. FieldName e
normalizado (AllTrim/Upper); FieldValue mantem o tipo nativo do JSON (C/N).
Ignora entradas sem FieldName ou sem FieldValue.
@type   method
@author Thalys Augusto Alves Juvenal
@since  26/06/2026
@param  oHolder, object, objeto JSON que contem a chave "Fields" (array)
@return array, lista de pares {cFieldName, xFieldValue}
/*/
Method LeFields(oHolder) as Array Class SalesConnectRetailRequestDto
    Local aRet    := {} as Array
    Local aFields as Array
    Local oField  as Object
    Local nI      := 0 as Numeric

    If ValType(oHolder) == "J" .And. ValType(oHolder["Fields"]) == "A"
        aFields := oHolder["Fields"]
        For nI := 1 To Len(aFields)
            oField := aFields[nI]
            If ValType(oField) == "J" .And. ;
               ValType(oField["FieldName"]) == "C" .And. ;
               !Empty(AllTrim(oField["FieldName"])) .And. ;
               ValType(oField["FieldValue"]) != "U"
                AAdd(aRet, { AllTrim(Upper(oField["FieldName"])), oField["FieldValue"] })
            EndIf
        Next nI
    EndIf
Return aRet
