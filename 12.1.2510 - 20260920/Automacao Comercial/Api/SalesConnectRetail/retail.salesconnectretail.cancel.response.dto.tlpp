#include "totvs.ch"
#include "tlpp-core.th"

namespace totvs.protheus.retail.salesconnectretail.dto

/*/{Protheus.doc} SalesConnectRetailCancelResponseDto
DTO de resposta JSON de sucesso (HTTP 200) para POST
/api/retail/v1/SalesConnectRetail/cancel/ (DVARPV-6460).
Estrutura JSON: { branch, documentNumber, status, message }.
@author Thalys Augusto Alves Juvenal
@since  22/06/2026
@version 1.0
@type class
/*/
Class SalesConnectRetailCancelResponseDto
    Public Data cBranch         as Character
    Public Data cDocumentNumber as Character
    Public Data cStatus         as Character
    Public Data cMessage        as Character

    Public Method New(cBranch as Character, cDocumentNumber as Character, cStatus as Character, cMessage as Character) as Object
    Public Method toJson() as Character
EndClass

/*/{Protheus.doc} New
Construtor do DTO de resposta de cancelamento. Parametro ausente (Nil) assume ""
via Default.
@type   method
@author Thalys Augusto Alves Juvenal
@since  22/06/2026
@param  cBranch,         character, filial da venda (L1_FILIAL)
@param  cDocumentNumber, character, numero do documento (L1_DOC)
@param  cStatus,         character, situacao do cancelamento (ex: "Cancelled")
@param  cMessage,        character, mensagem complementar
@return object, Self
/*/
Method New(cBranch as Character, cDocumentNumber as Character, cStatus as Character, cMessage as Character) as Object Class SalesConnectRetailCancelResponseDto
    Default cBranch         := ""
    Default cDocumentNumber := ""
    Default cStatus         := ""
    Default cMessage        := ""

    ::cBranch         := cBranch
    ::cDocumentNumber := cDocumentNumber
    ::cStatus         := cStatus
    ::cMessage        := cMessage
Return Self

/*/{Protheus.doc} toJson
Serializa o response em JSON: { branch, documentNumber, status, message }.
@type   method
@author Thalys Augusto Alves Juvenal
@since  22/06/2026
@return character, JSON do response
/*/
Method toJson() as Character Class SalesConnectRetailCancelResponseDto
    Local oJson as Json
    Local cRet  as Character

    oJson := JsonObject():New()
    oJson["branch"]         := ::cBranch
    oJson["documentNumber"] := ::cDocumentNumber
    oJson["status"]         := ::cStatus
    oJson["message"]        := ::cMessage
    cRet := oJson:toJson()
    FWFreeObj(oJson)        // libera o JsonObject antes de retornar (evita leak por request)
Return cRet
