#INCLUDE "TLPP-CORE.TH"
#INCLUDE "TLPP-REST.TH"

namespace totvs.protheus.retail.rmi.api.ljclienteapi

using namespace totvs.protheus.retail.rmi.api.ljclienteobj


/*/{Protheus.doc} 
API para Integração de Clientes, mediante Payload
@type function
@author Carlos Chigres
@/api/retail/v1/cliente/salva
@since 29/05/2026
/*/
@Post("/api/retail/v1/cliente/salva")
Function ljcliente(jParams as Json,cBody as Character)

    Local cReturn   := ""
    Local oCliente  := Nil

    oCliente := clienteobj():New(oRest, jParams, cBody)
    
    oCliente:Get()    
    cReturn := oCliente:getReturn()    
    LjGrvLog("/api/retail/v1/cliente/salva","Return: ",cReturn)

    IIf(Empty(cReturn),Eval({|| oRest:setStatusCode(500), cReturn := "Ops! A consulta não retornou um json válido. Por favor, verifique os logs do Protheus (Console, LogLoja) para analisar o ocorrido."}),) 
        
    oRest:setResponse(cReturn)   

Return
