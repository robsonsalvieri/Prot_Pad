#include "totvs.ch"
#include "tlpp-core.th"

//-------------------------------------------------------------------
// DVARPV-6462 - Deteccao da venda de origem API (SalesConnectRetail) no GravaBatch.
// Funcoes globais (sem namespace) chamadas pela PSmartHub (RmiXFunA) e pelo
// GravaBatch (LOJXFUNC). A venda API NAO usa MHQ; e identificada por
// L1_ORIGEM="N" + L1_UMOV conferindo com o MD5 recomputado dos campos-chave.
//-------------------------------------------------------------------

/*/{Protheus.doc} LjApiUMov
Recomputa o hash MD5 (tipo 2 / hexadecimal) da venda recebida via API de vendas
varejo, a partir da SL1 posicionada, na MESMA composicao usada pela API no POST:
MD5( Empresa(FwCodEmp) + Filial(xFilial "SL1") + Numero da Nota(L1_DOC) + Serie(L1_SERIE) ).
NAO inclui L1_NUM (gerado na gravacao; nao existe no POST).
@type    Function
@return  character, hash MD5 (32 chars hex) ou "" se a SL1 nao estiver posicionada
/*/
Function LjApiUMov() as Character
Local cHash := ""

If !Empty(SL1->L1_FILIAL)
    cHash := MD5( AllTrim(cValToChar(FwCodEmp()))       + ;
                  AllTrim(cValToChar(xFilial("SL1")))   + ;
                  AllTrim(cValToChar(SL1->L1_DOC))      + ;
                  AllTrim(cValToChar(SL1->L1_SERIE))    , 2 )
EndIf

Return cHash

/*/{Protheus.doc} LjIsVendaApi
Indica se a venda (SL1 posicionada) tem origem na API de vendas varejo:
L1_ORIGEM="N" e o L1_UMOV confere com o MD5 recomputado (LjApiUMov).
@type    Function
@param   cUUID, character, valor do L1_UMOV a conferir (default SL1->L1_UMOV)
@return  logical, .T. se for venda de origem API
/*/
Function LjIsVendaApi(cUUID) as Logical
Local lRet := .F.

Default cUUID := SL1->L1_UMOV

lRet := ( AllTrim(SL1->L1_ORIGEM) == "N" .And. ;
          !Empty(AllTrim(cUUID))          .And. ;
          AllTrim(cUUID) == LjApiUMov() )

Return lRet

/*/{Protheus.doc} LjOrigemVenda
Retorna a origem da venda (SL1 posicionada) para o GravaBatch decidir o caminho
de comparacao fiscal: "PSH" (Protheus Smart Hub, via MHQ), "API" (API de vendas
varejo) ou "" (demais origens).
@type    Function
@return  character, "PSH" | "API" | ""
/*/
Function LjOrigemVenda() as Character
Local cOrig := ""

If FwAliasInDic("MHQ") .And. ;
   !Empty(Posicione("MHQ", 7, xFilial("MHQ") + PadR(SL1->L1_UMOV, TamSX3("MHQ_UUID")[1]), "MHQ_UUID"))
    cOrig := "PSH"
ElseIf LjIsVendaApi()
    cOrig := "API"
EndIf

Return cOrig
