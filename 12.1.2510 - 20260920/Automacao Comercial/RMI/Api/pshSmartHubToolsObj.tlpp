#INCLUDE "TOTVS.CH"

namespace totvs.protheus.retail.rmi.api.pshsmarthubtoolsobj

//-------------------------------------------------------------------
/*/{Protheus.doc} Classe PshSmartHubTools
    Classe para tratamento da API de Carga Dados no Varejo
*/
//-------------------------------------------------------------------
Class PshSmartHubTools From LojRestObj20

	Public Method new()             as Object
    Public Method getReturn()       as Character
    Public Method getQtd()          as Integer
    Public Method get()             as Variant

    Protected Method setFields()    as Variant
    Protected Method validation()   as Variant
    Protected Method execAuto()     as Variant

    Private Method getTabProcesso(cProcesso as Character) as Array
    Private Method getStCarga(nRecno as Integer) as Character
    Private Method getProgCarga(cProcesso as Character)
    Private Method iniciaCarga()   as Variant    

    Data cFilComp   as Character

EndClass

//-------------------------------------------------------------------
/*/{Protheus.doc} new
Método construtor da Classe

@param oWsRestObj - Objeto WSRESTFUL da API

@author  Everson S P Junior
@since   12/12/2023
@version 1.0
*/
//-------------------------------------------------------------------
Method New(oWsRestObj As Object) as Object Class PshSmartHubTools

    Self:cFilComp := ""

    _Super:New(oWsRestObj, /*jParans*/, /*cBody*/)

    //self:setSelect("MHP")

Return self

//-------------------------------------------------------------------
/*/{Protheus.doc} setFields
Carrega os campos que serão retornados

@author  Everson S P Junior
@since   12/12/2023
@version 1.0
*/
//-------------------------------------------------------------------
Method setFields() as Variant Class PshSmartHubTools

   HmAdd(self:oFields, {"PROCESSO"             ,"MHP_CPROCE"    , "MHP_CPROCE"                       , "processo"               , "N"           , ""}               , 1, 3)
   HmAdd(self:oFields, {"QTDREGISTROS"         , ""             , "Self:GetQtd()"                    , "qtdRegistros"           , "C"           , ""}               , 1, 3)
   HmAdd(self:oFields, {"FILIALDESTINO"        ,""              , "self:jparans['filialSelecionada']", "filialSelecionada"      , "N"           , ""}               , 1, 3)
   HmAdd(self:oFields, {"COMPARTILHAMENTO"     ,""              , "self:cFilComp"                    , "compartilhamento"       , "N"           , ""}               , 1, 3)
   HmAdd(self:oFields, {"HORACARGA"            ,""              , "FwTimeStamp(3)"                   , "horacarga"              , "C"           , ""}               , 1, 3)
   HmAdd(self:oFields, {"SCHEMA"               ,"MHP_SCHEMA"    , "IIF(!Empty((Self:cAliasQuery)->MHP_SCHEMA),.T.,.F.)"                                     , "schemaValid"     , "C"           , ""}               , 1, 3)
   HmAdd(self:oFields, {"DATACORTE"            ,"MIN_ULTPUB"    , "IIF(ValType((Self:cAliasQuery)->MIN_ULTPUB) == 'C', (Self:cAliasQuery)->MIN_ULTPUB, '')" , "dataCorte"       , "C"           , ""}               , 1, 3)   
   HmAdd(self:oFields, {"STATUSCARGA"          ,"MIN_CARGA"     , "IIF(ValType((Self:cAliasQuery)->MIN_CARGA) == 'C', (Self:cAliasQuery)->MIN_CARGA, '')"   , "statusCarga"     , "C"           , ""}               , 1, 3)
   HmAdd(self:oFields, {"DTULTCARGA"           ,"MIN_DTINIC"    , "IIF(ValType((Self:cAliasQuery)->MIN_DTINIC) == 'C', (Self:cAliasQuery)->MIN_DTINIC, '')" , "dataUltCarga"    , "C"           , ""}               , 1, 3)
   HmAdd(self:oFields, {"RESULTCARGA"          ,"MIN_CARGA"     , "self:getStCarga(IIF(ValType((Self:cAliasQuery)->MINREC) == 'N', (Self:cAliasQuery)->MINREC, 0))"           , "resultCarga"   , "C", ""}          , 1, 3)
   HmAdd(self:oFields, {"IDCARGA"              ,"MIN_CARGA"     , "self:getStCarga(IIF(ValType((Self:cAliasQuery)->MINREC) == 'N', (Self:cAliasQuery)->MINREC, 0),'idCarga')" , "idCarga" , "C", ""}                , 1, 3)
   HmAdd(self:oFields, {"DETALHESERRO"         ,"MIN_CARGA"     , "self:getStCarga(IIF(ValType((Self:cAliasQuery)->MINREC) == 'N', (Self:cAliasQuery)->MINREC, 0),'detalhesErro')" , "detalhesErro" , "C", ""}                , 1, 3) 
   HmAdd(self:oFields, {"ENVIO"                ,"MIN_CARGA"     , "self:getStCarga(IIF(ValType((Self:cAliasQuery)->MINREC) == 'N', (Self:cAliasQuery)->MINREC, 0),'envio')" , "envio" , "C", ""}                , 1, 3) 
   HmAdd(self:oFields, {"PROGRESSO"            ,"MIN_CARGA"     , "IIf((Self:cAliasQuery)->MIN_CARGA == '2',self:getProgCarga((Self:cAliasQuery)->MHP_CPROCE,0),0)" , "progresso" , "N", ""}                , 1, 3) 
   HmAdd(self:oFields, {"DESCPROGRE"           ,"MIN_CARGA"     , "IIf((Self:cAliasQuery)->MIN_CARGA == '2',self:getProgCarga((Self:cAliasQuery)->MHP_CPROCE,1),'')" , "descricaoProgresso" , "C", ""}                , 1, 3) 


Return Nil

//-------------------------------------------------------------------
/*/{Protheus.doc} Validation
Metodo para validações executado no momento do get
1
@author  Everson S P Junior
@since   14/09/2022
@version 1.0
*/
//-------------------------------------------------------------------
Method Validation(cOrigem as Character) as Variant Class PshSmartHubTools

    _Super:Validation()

    If self:lSuccess

        If cOrigem == "GET" .And. !('/api/retail/v1/pshsmarthubtools/iniciacarga' $ self:oWsRestObj:URN)

            if !self:jParans:hasProperty("filialSelecionada") .or. Empty( self:jparans['filialSelecionada'] )

                self:lSuccess   := .F.
                self:cError     := I18n("Ops! #1 não enviado(s) ou inválido(s).", {"filialSelecionada"} )  //"Ops! #1 não enviado(s) ou inválido(s)."
            ElseIf MIN->(FieldPos("MIN_CARGA")) == 0 .or. MHP->(FieldPos("MHP_SCHEMA")) == 0
                self:lSuccess   := .F.
                self:cError     := "O dicionário de dados está incompatível com a carga inicial. Aplique o pacote de expedição contínua do varejo mais recente."                
            ElseIf Posicione("MIH", 1, xFilial("MIH") + PadR("CADASTRO DE LOJA",TamSx3("MIH_TIPCAD")[1]) + LjAuxPosic('CADASTRO DE LOJA', "IDFilialProtheus", self:jparans['filialSelecionada'],"MIH_ID"), "MIH_ATIVO") == "2"   
                
                self:lSuccess   := .F.
                self:cError     := "Filial não está ativa no cadastro auxiliar de LOJA. Verifique !"
            ElseIf Empty( LjRetComp(self:jparans['filialSelecionada'], 'CADASTRO DE LOJA') )
            
                self:lSuccess   := .F.
                self:cError     := "Filial não configurada para envio de dados! Verifique o cadastro auxiliar de COMPARTILHAMENTO"

            EndIf

        ElseIf cOrigem == "POST"

            self:iniciaCarga()

        EndIf
    EndIf  

Return Nil

Method get() as Variant Class PshSmartHubTools

    Local cSGBD := UPPER(Alltrim(TcGetDb()))
    
    self:cSelect    := " SELECT MHP.MHP_CPROCE, MHP.MHP_CONFIG, CASE WHEN MHP.MHP_SCHEMA IS NULL OR RTRIM(CAST(SUBSTRING(MHP.MHP_SCHEMA, 1, 100) AS VARCHAR(100))) IS NULL OR RTRIM(CAST(SUBSTRING(MHP.MHP_SCHEMA, 1, 100) AS VARCHAR(100))) = '' THEN 0 ELSE 1 END MHP_SCHEMA, MIN.MIN_ULTPUB, MIN.MIN_CARGA, MIN.MIN_DTINIC , MIN.R_E_C_N_O_ MINREC FROM "+ RetSqlName("MHP") + " MHP "
    self:cSelect    += " LEFT JOIN "+ RetSqlName("MIN") + " MIN ON "
    self:cSelect    += " MIN.MIN_CPROCE = MHP.MHP_CPROCE AND MIN.MIN_FILIAL = '" + xFilial("MIN") + "' AND "
    self:cSelect    += " '" + self:jparans['filialSelecionada'] + "' LIKE RTRIM(MIN.MIN_FILPUB) "+IIF(cSGBD == 'MSSQL',"+","||")+" '%' AND MIN.D_E_L_E_T_ = ' ' "
    
    self:cWhere     := " WHERE MHP.MHP_TIPO = '1'"
    self:cWhere     += " AND MHP.MHP_CASSIN = 'PDVSYNC'"
    self:cWhere     += " AND MHP.D_E_L_E_T_ = ' ' "
    
    _Super:get()

Return Nil


//-------------------------------------------------------------------
/*/{Protheus.doc} GetReturn
Retorna json com resultado da consulta

@author  Everson S P Junior
@since   12/12/2023
@version 1.0
*/
//-------------------------------------------------------------------
Method getReturn() as Character Class PshSmartHubTools

    Local jRetorno  as Object 
    Local cRetorno  as Character

    jRetorno:= JsonObject():New()
    jRetorno:FromJson( _Super:GetReturn() )
    
    cRetorno := EncodeUtf8( jRetorno:toJson() )

    LjGrvLog("PshSmartHubTools", "Retorno da API de PshSmartHubTools", cRetorno)

    FwFreeObj(jRetorno)

Return cRetorno

//-------------------------------------------------------------------
/*/{Protheus.doc} GetQtd
Retorna a quantidade de registros da consulta

@author  Everson S P Junior
@since   12/12/2023
@version 1.0
*/
//-------------------------------------------------------------------
Method GetQtd() as Integer Class PshSmartHubTools
    Local cQuery := ""
    Local cTabela := GetNextAlias()
    Local cCampo  := ""
    Local nRet   := 0  
    Local cFiltro := ""     
    Local cTab    := ""
    Local aProcesso := {}

    Self:cFilComp := ""
    
    aProcesso := self:getTabProcesso((Self:cAliasQuery)->MHP_CPROCE)
    
    If Len(aProcesso) > 0
        cTab := aProcesso[1]
        cFiltro := aProcesso[2]
        
        cCampo := PrefixoCpo(cTab) + "_FILIAL"
        Self:cFilComp     := xFilial(cTab, self:jparans['filialSelecionada'])

        If !Empty(cTab) .And. !Empty(retSqlName(cTab))
            cQuery := "SELECT Count(" + cCampo +") as QTD "
            cQuery += " FROM "+retSqlName(cTab)+" "
            cQuery += " WHERE  "+cCampo+" = '" + Self:cFilComp + "'"
            cQuery += " AND D_E_L_E_T_ = ' ' "
            cQuery += IIF(empty(cFiltro), "" , " AND "+cFiltro)

            LjGrvLog("PshSmartHubTools", "Método GetQtd - Query executada -> " + cQuery)

            DbUseArea(.T., "TOPCONN", TcGenQry( , , cQuery), cTabela, .T., .F.)
            nRet := (cTabela)->QTD
            (cTabela)->( DbCloseArea())
        EndIf
    EndIf

Return nRet

//-------------------------------------------------------------------
/*/{Protheus.doc} getTabProcesso
Retorna os dados (Tabela e Filtro) configurados para o Processo (MHN)

@param cProcesso - Codigo do processo para busca
@author  Everson S P Junior
@since   27/07/2026
@version 1.0
*/
//-------------------------------------------------------------------
Method getTabProcesso(cProcesso as Character) as Array Class PshSmartHubTools
    Local cQuery := ""
    Local cTabela := GetNextAlias()
    Local aRet := {}
    Local cFiltro := ""

    cQuery := "Select MHN_TABELA,MHN_FILTRO from "+retSqlName("MHN")+" MHN "
    cQuery += " Where MHN_COD = '" + PadR(cProcesso,TamSX3("MHN_COD")[1]) + "'"
    cQuery += " AND MHN.D_E_L_E_T_ = ' ' "
    cQuery += " AND MHN.MHN_TABELA != '"+Space(TAMSX3('MHN_TABELA')[1])+"' "
    
    LjGrvLog("PshSmartHubTools", "Método getTabProcesso - Query executada -> " + cQuery)

    DbUseArea(.T., "TOPCONN", TcGenQry( , , cQuery), cTabela, .T., .F.)

    If !(cTabela)->(Eof())
        
        cFiltro := IIF(SubStr((cTabela)->MHN_FILTRO, 1, 1) == "&",&( AllTrim( SubStr((cTabela)->MHN_FILTRO, 2) ) ),(cTabela)->MHN_FILTRO)
        
        AAdd(aRet, (cTabela)->MHN_TABELA)
        AAdd(aRet, cFiltro)
    EndIf

    (cTabela)->( DbCloseArea() )

Return aRet
//-------------------------------------------------------------------
/*/{Protheus.doc} iniciaCarga
Inicia o processo de carga de dados

@author  Everson S P Junior
@since   12/12/2023
@version 1.0
*/
//-------------------------------------------------------------------
Method iniciaCarga() as Variant Class PshSmartHubTools
Local nx      := 1
Local lExist  := .F.

DbSelectArea("MIN")
MIN->(DbSetOrder(1)) // -- MIN_FILIAL+MIN_CPROCE+MIN_FILPUB



For nX := 1 To Len(self:jBody)
    
    aProcesso := self:getTabProcesso(self:jBody[nX]["processo"])
    cTab := aProcesso[1]
    
    lExist := MIN->(Dbseek(xFilial("MIN") + PadR(self:jBody[nX]["processo"],TamSX3("MIN_CPROCE")[1]) + PadR(xFilial(cTab,self:jBody[nX]["filialSelecionada"]),TamSX3("MIN_FILPUB")[1])  ))
    If lExist .AND. MIN->MIN_CARGA == "1"
        self:lSuccess := .F.
        self:cError   += I18n("Processo #1 está em andamento de Carga. Não Pode ser selecionado novamente", {MIN->MIN_CPROCE})+CRLF //"Processo "+MIN->MIN_CPROCE+" já existe e está em andamento."
    EndIf
Next

Return


//
//-------------------------------------------------------------------
/*/{Protheus.doc} execAuto
executa a gravação dos dados de forma automática, 

@author  Everson S P Junior
@since   12/12/2023
@version 1.0
*/
//-------------------------------------------------------------------
Method execAuto() as Variant Class PshSmartHubTools
Local lInclui    := .F.
Local nX         := 1
Local aAreas     := GetArea()
Local aAreasMHP  := MHP->(GetArea("MHP"))
Local aAreasMIN  := MIN->(GetArea("MIN"))
Local nMINProce := 0
Local nMINFilpub := 0
Local nMHPCassin := 0
Local nMHPProce := 0
Local cLayfil    := ''
Local cTab        := ''


DbSelectArea("MIN")
MIN->(DbSetOrder(1)) // -- MIN_FILIAL+MIN_CPROCE+MIN_FILPUB

DbSelectArea("MHP")
MHP->(DbSetOrder(1))

//Pegar o tamanho antes do loopr
nMINProce := TamSX3("MIN_CPROCE")[1]
nMINFilpub := TamSX3("MIN_FILPUB")[1]
nMHPCassin := TamSX3("MHP_CASSIN")[1]
nMHPProce := TamSX3("MHP_CPROCE")[1]

For nX := 1 To Len(self:jBody)


    aProcesso := self:getTabProcesso(self:jBody[nX]["processo"])
    cTab := aProcesso[1]
    lInclui := !MIN->(Dbseek(xFilial("MIN") + PadR(self:jBody[nX]["processo"],nMINProce) + PadR(xFilial(cTab,self:jBody[nX]["filialSelecionada"]),nMINFilpub)  ))

    RecLock("MIN", lInclui)
        REPLACE MIN->MIN_FILIAL WITH xFilial("MIN")
        REPLACE MIN->MIN_CPROCE WITH self:jBody[nX]["processo"]
        REPLACE MIN->MIN_ULTREC WITH ""
        REPLACE MIN->MIN_ULTPUB WITH ""         
        REPLACE MIN->MIN_FILPUB WITH PadR(xFilial(cTab,self:jBody[nX]["filialSelecionada"]),nMINFilpub)
        REPLACE MIN->MIN_QTDTOT WITH self:jBody[nX]["qtdRegistros"]
        REPLACE MIN->MIN_LJDEST WITH self:jBody[nX]["filialSelecionada"]
        REPLACE MIN->MIN_DTINIC	WITH FwTimeStamp(3)
        REPLACE MIN->MIN_DTFIMC	WITH ""
        REPLACE MIN->MIN_CARGA	WITH "1"

    MIN->(MsUnLock())
    
    If MHP->(Dbseek( xFilial("MHP") + PadR("PDVSYNC",nMHPCassin) + PadR(self:jBody[nX]["processo"],nMHPProce) +"1" ))
        cLayfil := IIF(PadR(MIN->MIN_LJDEST,nMINFilpub)+';' $ MHP->MHP_LAYFIL,MHP->MHP_LAYFIL,Alltrim(MHP->MHP_LAYFIL)+PadR(MIN->MIN_LJDEST,nMINFilpub)+';')
        cLayfil := IIF(!Empty(MHP->MHP_LAYFIL) .AND. Alltrim(self:jBody[nX]["filialSelecionada"]) == 'COMPARTILHADA',MHP->MHP_LAYFIL,cLayfil)
        RecLock("MHP", .F.)
            REPLACE MHP->MHP_ATIVO WITH '1'
            REPLACE MHP->MHP_LAYFIL WITH cLayfil
        MHP->(MsUnLock())
    EndIf
Next


RestArea(aAreas)
RestArea(aAreasMHP)
RestArea(aAreasMIN)
Return

//-------------------------------------------------------------------
/*/{Protheus.doc} getStCarga
Retorna o status do extrator gravado em JSON no campo MIN_ULTREC

@param nRecno - Type: Integer, Numero do recno na tabela MIN
@return cStatus - Retorna o conteudo do status gravado, string

@author Evandro Pattaro
@since 14/08/2026
@version 1.0
*/
//-------------------------------------------------------------------
Method getStCarga(nRecno as Integer,cAtt as Character) as Character Class PshSmartHubTools
    Local aArea    := GetArea()
    Local aAreaMIN := MIN->(GetArea())
    Local xRet     := Nil
    Local cJson    := ""
    Local oJson    as Object

    Default cAtt := "status"

    If nRecno > 0
        MIN->(DbGoto(nRecno))
        cJson := MIN->MIN_ULTREC
        
        If !Empty(cJson)
            oJson := JsonObject():New()
            oJson:FromJson(cJson)
            
            If ValType(oJson) == "J"
                If oJson:HasProperty("extractor")
                    If ValType(oJson["extractor"]) == "J" .And. oJson["extractor"]:HasProperty(cAtt)
                        xRet := oJson["extractor"][cAtt]
                    EndIf
                EndIf
            EndIf
            
            FreeObj(oJson)
        EndIf
    EndIf
    
    If Empty(xRet)
        xRet := ""
    EndIf

    RestArea(aAreaMIN)
    RestArea(aArea)

Return xRet

//-------------------------------------------------------------------
/*/{Protheus.doc} getProgCarga
Retorna o progresso da carga do processo informado

@param cProcesso, character, Identificação do processo
@return nRet, numeric, Percentual de conclusão da carga
*/
//-------------------------------------------------------------------
Method getProgCarga(cProcesso as Character, nStatus as Numeric) Class PshSmartHubTools    

    Local xRet := Nil
    Local aProg := {}
    Local cGlbProg := "PSHExtProg"

    /* nStatus = 0 - Retorna o percentual de progresso da carga do processo informado
       nStatus = 1 - Retorna o status da carga do processo informado () */

    Default nStatus := 0

    If nStatus == 0
        xRet := 0
    Else
        xRet := ""
    EndIf 

    If GetGlbVars(cGlbProg, aProg)
        If !Empty(aProg) .And. UPPER(Alltrim(aProg[1])) == UPPER(Alltrim(cProcesso)) .And. aProg[2] > 0

            If nStatus == 0
                xRet := Round((aProg[3] / aProg[2]) * 100, 0)
            Else
                xRet := aProg[4]
            EndIf    

        EndIf    
    EndIf
    FwFreeArray(aProg)
Return xRet
