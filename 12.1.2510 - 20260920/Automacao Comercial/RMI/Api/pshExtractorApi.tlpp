#include "tlpp-core.th"
#include "totvs.ch"
#include "tlpp-rest.th"

namespace totvs.protheus.retail.rmi.classes.extractor.pshextractorapi

using namespace totvs.protheus.retail.rmi.classes.extractor.pshextractorobj

//-------------------------------------------------------------------
/*/{Protheus.doc} iniciaCarga
@description API REST para carga inicial do PSH Extractor
@type function

@author evandro.pattaro
@since 30/07/2026
/*/
//-------------------------------------------------------------------
@Post("/api/retail/v1/pshextractor/iniciacarga")
User Function iniciaCarga() as Logical
    Local oExtractorObj := pshExtractorObj():new(oRest)
    Local cRetorno      := ""

    oExtractorObj:post()

    cRetorno := oExtractorObj:getReturn()

    FwFreeObj(oExtractorObj)

Return oRest:setResponse(cRetorno)
