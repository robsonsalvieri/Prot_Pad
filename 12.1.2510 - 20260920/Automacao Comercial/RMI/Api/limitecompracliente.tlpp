#INCLUDE "TLPP-CORE.TH"
#INCLUDE "TLPP-REST.TH"

namespace totvs.protheus.retail.rmi.api.limitecompracliente

using namespace totvs.protheus.retail.rmi.api.limitecompraclienteObj
using namespace totvs.protheus.retail.rmi.api.limitecompraclientedetailObj

//-------------------------------------------------------------------
/*/{Protheus.doc}
    API para consulta de limite de compra do cliente no Varejo 
/*/
//-------------------------------------------------------------------

/* ----------------------------------------- */
@Get("api/retail/v1/limitecompracliente/:idRetaguardaLoja")
Function Pshlimcomcli()

Local olimite       := nil 

olimite := LimiteCompraCliente():New( oRest )  
olimite:Get()

Return oRest:setResponse( olimite:getReturn() )
//-------------------------------------------------------------------
/*/{Protheus.doc}
    API para consulta de limite de compra do cliente no Varejo - Detalhada
/*/
//-------------------------------------------------------------------

/* ----------------------------------------- */
@Get("api/retail/v1/limitecompraclientedetail/:idRetaguardaLoja")
Function PshComdetail()

Local olimite       := nil 

olimite := LimiteCompraClientedetail():New( oRest )  
olimite:Get()

Return oRest:setResponse( olimite:getReturn() )
