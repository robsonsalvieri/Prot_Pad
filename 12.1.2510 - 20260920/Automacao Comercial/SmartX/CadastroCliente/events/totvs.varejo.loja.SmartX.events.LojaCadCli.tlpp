#Include "fw-tlpp-core.th"
#Include "protheus.ch"
#Include "totvs.framework.model.events.th"
#Include "TopConn.ch"
#Include "totvs.varejo.loja.smartx.events.lojacadcli.ch"


namespace totvs.varejo.loja.SmartX.events

Class LojaCadCliEvents from totvs.framework.model.events

    public method new() as object

    @beforeCreateInTransaction()
    public method beforeCreateInTransaction(oData, oModel, oError) as logical

    private method validateFields(oData, oError) as logical

EndClass

/*/{Protheus.doc} new
Construtor da classe de eventos LojaCadCliEvents.
@type  Method
@author caio.okamoto
@since 24/06/2026
@return oObj, Object, Instância da classe
/*/
Method new() as object class LojaCadCliEvents
Return self

/*/{Protheus.doc} beforeCreateInTransaction
Evento executado antes da inclusão do cliente dentro de uma transação.
Invoca a validação de campos obrigatórios e de formato.
Retornar .F. impede a gravação e exibe a mensagem de erro configurada em oError.
@type  Method
@param oData, Object, Dados do registro SA1
@param oModel, Object, Instância do modelo
@param oError, Object, Objeto de erro para preenchimento em caso de falha
@return lOk, Logical, .T. para permitir a inclusão, .F. para bloquear
/*/
Method beforeCreateInTransaction(oData, oModel, oError) as logical class LojaCadCliEvents
Return ::validateFields(oData, oError)


/*/{Protheus.doc} validateFields
Valida campos  e formatos do cadastro de cliente (SA1) antes da gravacao.
@type  Method
@param oData, Object, Dados do registro SA1
@param oError, Object, Objeto de erro para preenchimento em caso de falha
@return lOk, Logical, .T. se todas as validacoes passaram, .F. caso contrario
/*/
Method validateFields(oData, oError) as logical class LojaCadCliEvents
    Local cCod      := "" as Character
    Local lOk       := .T. as Logical

    cCod  := AllTrim(oData:getFieldValue("SA1", "A1_COD"))

    // Código do cliente é obrigatório-incluido pq SmartX falha de vez em quando ao validar campos obrigatórios
    If Empty(cCod)
        oError:set(400, STR0001, STR0002) //Campo obrigatorio, O campo Código (A1_COD) nao pode estar vazio.
        lOk := .F.
    EndIf

Return lOk

