#include "tlpp-core.th"
#include "tlpp-rest.th"

namespace totvs.protheus.health.plan.ans.protocol.manager

using namespace totvs.protheus.health.plan.api.util

/*/{Protheus.doc} AnsProtocolManagerController
Controlador responsável por expor os endpoints da API de protocolos ANS.
@type class
@version 12.1.2610  
@since 25/06/2026
@author vinicius.queiros
/*/
class AnsProtocolManagerController from BaseController

    public method new() constructor

    @GET("/totvsHealthPlans/ansProtocols/v1/protocols")
    public method getAnsProtocols()

    @GET("/totvsHealthPlans/ansProtocols/v1/protocols/summary")
    public method getAnsSummaryProtocols()

    @GET("/totvsHealthPlans/ansProtocols/v1/protocols/:protocolId/details")
    public method getAnsProtocolDetails()

endclass

/*/{Protheus.doc} new
Construtor da classe AnsProtocolManagerController.
@type method
@version 12.1.2610
@since 25/06/2026
@author vinicius.queiros
@return object, instância da classe AnsProtocolManagerController
/*/
method new() class AnsProtocolManagerController

    _Super:new()

return self

/*/{Protheus.doc} getAnsProtocols
Endpoint responsável por retornar os protocolos ANS.
@type method
@version 12.1.2610
@since 25/06/2026
@author vinicius.queiros
/*/
method getAnsProtocols() class AnsProtocolManagerController

    local oService as object
    local jQueryParams := oRest:getQueryRequest() as json

    // Controller apenas orquestra entrada/saída HTTP; regra fica no service/adapter.
    oService := AnsProtocolManagerService():new()
    oService:setQueryParams(jQueryParams)

    if oService:getAnsProtocols()
        oRest:setResponse(oService:getJsonResult())
    endif

	// Status HTTP sempre vem do service para manter contrato consistente em sucesso/erro.
	oRest:setStatusCode(oService:getStatusCode())

    // Mantém response JSON explícito em todos os cenários.
    oRest:setKeyHeaderResponse("Content-Type", "application/json")
    oService:destroy()
    
    freeObj(oService)
    freeObj(jQueryParams)

return

/*/{Protheus.doc} getAnsSummaryProtocols
Endpoint responsável por retornar o resumo dos protocolos ANS.
@type method
@version 12.1.2610
@since 23/07/2026
@author vinicius.queiros
/*/
method getAnsSummaryProtocols() class AnsProtocolManagerController

    local oService as object
    local jQueryParams := oRest:getQueryRequest() as json

    // Mesmo pipeline do endpoint de lista, mudando apenas o caso de uso do service.
    oService := AnsProtocolManagerService():new()
    oService:setQueryParams(jQueryParams)

    if oService:getAnsSummaryProtocols()
        oRest:setResponse(oService:getJsonResult())
    endif

	// Reaproveita o mesmo contrato de status do endpoint de listagem.
	oRest:setStatusCode(oService:getStatusCode())

    oRest:setKeyHeaderResponse("Content-Type", "application/json")
    oService:destroy()
    
    freeObj(oService)
    freeObj(jQueryParams)

return

/*/{Protheus.doc} getAnsProtocolDetails
Endpoint responsável por retornar o detalhamento de um protocolo ANS específico.
@type method
@version 12.1.2610
@since 19/08/2026
@author vinicius.queiros
/*/
method getAnsProtocolDetails() class AnsProtocolManagerController

    local oService as object
    local jPathParams := oRest:getPathParamsRequest() as json
    local aRequiredParams := {"protocolId"} as array

    oService := AnsProtocolManagerService():new()

    // Valida parâmetros obrigatórios e delega a regra de negócio ao service.
    if self:validateRequiredParams(jPathParams, aRequiredParams)
        if oService:getAnsProtocolDetails(jPathParams["protocolId"])
            oRest:setResponse(oService:getJsonResult())
        else
            oRest:setFault(oService:getJsonResult())
		endif

        oRest:setStatusCode(oService:getStatusCode())
    endif

    oRest:setKeyHeaderResponse("Content-Type", "application/json")
    oService:destroy()

    freeObj(oService)
    freeObj(jPathParams)
    fwFreeArray(aRequiredParams)

return
