        self:setAttributeJson({"attribute": "requesterEmail", "value": B5J->B5J_EMAIL, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "origin", "value": B5J->B5J_ORISOL, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "observation", "value": B5J->B5J_OBSERV, "type": "M"}, @jDetails)

        self:setAttributeJson({"attribute": "cancellationDetails", "value": jDetails, "type": "J"})
