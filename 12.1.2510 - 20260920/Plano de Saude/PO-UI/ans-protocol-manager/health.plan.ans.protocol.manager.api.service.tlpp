        self:setAttributeJson({"attribute": "attachmentType", "value": B4A->B4A_TIPANE, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "status", "value": B4A->B4A_STATUS, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "authorizationNumber", "value": B4A->(B4A_OPEMOV + B4A_ANOAUT + B4A_MESAUT + B4A_NUMAUT), "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "referenceAuthorization", "value": B4A->B4A_GUIREF, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "authorizationPassword", "value": B4A->B4A_SENHA, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "authorizationDate", "value": B4A->B4A_DATPRO, "type": "D"}, @jDetails)
        self:setAttributeJson({"attribute": "requestDate", "value": B4A->B4A_DATSOL, "type": "D"}, @jDetails)
        self:setAttributeJson({"attribute": "professionalName", "value": B4A->B4A_NOMSOL, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "professionalPhone", "value": B4A->B4A_TELSOL, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "professionalEmail", "value": B4A->B4A_EMASOL, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "observation", "value": B4A->B4A_OBSERV, "type": "C"}, @jDetails)

        self:setAttributeJson({"attribute": "attachmentDetails", "value": jDetails, "type": "J"})
    endif
  
    freeObj(jDetails)

return .T.

/*/{Protheus.doc} setExtensionDetails
Monta o bloco de detalhes de prorrogação do protocolo ANS.
