        self:setAttributeJson({"attribute": "authorizationNumber", "value": B4Q->(B4Q_OPEMOV + B4Q_ANOAUT + B4Q_MESAUT + B4Q_NUMAUT), "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "referenceAuthorizationNumber", "value": B4Q->B4Q_GUIREF, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "authorizationPassword", "value": B4Q->B4Q_SENHA, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "provider", "value": B4Q->B4Q_CODRDA, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "providerName", "value": B4Q->B4Q_NOMRDA, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "professionalName", "value": B4Q->B4Q_NOMSOL, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "professionalCouncil", "value": B4Q->B4Q_SIGLA, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "professionalCouncilNumber", "value": B4Q->B4Q_REGSOL, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "stateAbbreviation", "value": B4Q->B4Q_ESTSOL, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "clinicalIndication", "value": B4Q->B4Q_INDCLI, "type": "M"}, @jDetails)
        self:setAttributeJson({"attribute": "justificationObs", "value": B4Q->B4Q_JUSOBS, "type": "M"}, @jDetails)
        self:setAttributeJson({"attribute": "underAudit", "value": B4Q->B4Q_AUDITO, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "isCanceled", "value": B4Q->B4Q_CANCEL, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "cancellationDate", "value": B4Q->B4Q_CANDAT, "type": "D"}, @jDetails)
        self:setAttributeJson({"attribute": "cancellationReason", "value": B4Q->B4Q_CANEDI, "type": "C"}, @jDetails)

        self:setAttributeJson({"attribute": "extensionDetails", "value": jDetails, "type": "J"})
    endif
   
    freeObj(jDetails)

return .T.

/*/{Protheus.doc} setRefundDetails
Monta o bloco de detalhes de reembolso do protocolo ANS.
@type method
@version 12.1.2610
@since 20/08/2026
@author vinicius.queiros
@return logical, true se os detalhes de reembolso foram adicionados com sucesso, false caso contrário
/*/
method setRefundDetails() as logical class AnsProtocolManagerService

    local jDetails := JsonObject():new() as object
    local cReimbursementNumber := "" as character 

    BOW->(dbSetOrder(1))
    if BOW->(dbSeek(xFilial("BOW") + self:cProtocol))
        if !empty(BOW->BOW_NUMAUT)
            cReimbursementNumber := BOW->(BOW_OPEMOV + BOW_MESAUT + BOW_ANOAUT + BOW_NUMAUT)
        endif

        // Serializa os dados de reembolso em objeto filho do payload principal.
        self:setAttributeJson({"attribute": "status", "value": BOW->BOW_STATUS, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "reimbursementOrigin", "value": BOW->BOW_ORIGEM, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "unReferencedIdentifier", "value": BOW->BOW_CODREF, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "unReferencedName", "value": BOW->BOW_NOMREF, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "reimbursementNumber", "value": cReimbursementNumber, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "requestedAmount", "value": BOW->BOW_VLRAPR, "type": "N"}, @jDetails)
        self:setAttributeJson({"attribute": "reimbursedAmount", "value": BOW->BOW_VLRREE, "type": "N"}, @jDetails)
        self:setAttributeJson({"attribute": "cancellationDate", "value": BOW->BOW_DTCANC, "type": "D"}, @jDetails)
        self:setAttributeJson({"attribute": "paymentObservation", "value": BOW->BOW_PGMTO, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "email", "value": BOW->BOW_EMAIL, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "phone", "value": BOW->BOW_TELCON, "type": "C"}, @jDetails)

        self:setAttributeJson({"attribute": "refundDetails", "value": jDetails, "type": "J"})
    endif
 
    freeObj(jDetails)

return .T.

