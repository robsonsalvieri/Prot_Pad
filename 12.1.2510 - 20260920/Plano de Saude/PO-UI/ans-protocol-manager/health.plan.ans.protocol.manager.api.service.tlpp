/*/
method setAttachmentDetails() as logical class AnsProtocolManagerService

    local jDetails := JsonObject():new() as object
 
    B4A->(dbSetOrder(1))
    if B4A->(dbSeek(xFilial("B4A") + B00->B00_NUMGUI))
