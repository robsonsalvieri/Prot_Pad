return .T.

/*/{Protheus.doc} setMaintenanceDetails
Monta o bloco de detalhes de manutenção cadastral do protocolo ANS.
@type method
@version 12.1.2610
@since 20/08/2026
@author vinicius.queiros
@return logical, true se os detalhes de manutenção foram adicionados com sucesso, false caso contrário
/*/
method setMaintenanceDetails() as logical class AnsProtocolManagerService

    local jDetails := JsonObject():new() as object
    local cSubcontractName := "" as character

    BBA->(dbSetOrder(4))
    if BBA->(dbSeek(xFilial("BBA") + self:cProtocol))
        if !empty(BBA->BBA_SUBCON)
            cSubcontractName := posicione("BQC", 1, xFilial("BQC") + BBA->(BBA_CODINT + BBA_CODEMP + BBA_CONEMP + BBA_VERCON + BBA_SUBCON + BBA_VERSUB), "BQC_DESCRI")
        endif

        // Serializa os dados de manutenção cadastral em objeto filho do payload principal.
        self:setAttributeJson({"attribute": "requestType", "value": BBA->BBA_TIPSOL, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "status", "value": BBA->BBA_STATUS, "type": "C"}, @jDetails)  
        self:setAttributeJson({"attribute": "maintenanceType", "value": BBA->BBA_TIPMAN, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "isApproved", "value": BBA->BBA_APROVA, "type": "L"}, @jDetails)
        self:setAttributeJson({"attribute": "companyCode", "value": BBA->BBA_CODEMP, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "companyName", "value": posicione("BG9", 1, xFilial("BG9") + BBA->(BBA_CODINT + BBA_CODEMP), "BG9_DESCRI"), "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "contractCode", "value": BBA->BBA_CONEMP, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "contractVersionCode", "value": BBA->BBA_VERCON, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "subcontractCode", "value": BBA->BBA_SUBCON, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "subcontractVersionCode", "value": BBA->BBA_VERSUB, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "subcontractName", "value": cSubcontractName, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "planCode", "value": BBA->BBA_CODPRO, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "planVersionCode", "value": BBA->BBA_VERSAO, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "planName", "value": posicione("BI3", 1, xFilial("BI3") + BBA->(BBA_CODINT + BBA_CODPRO + BBA_VERSAO), "BI3_DESCRI"), "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "observation", "value": BBA->BBA_OBSERV, "type": "C"}, @jDetails)

        self:setAttributeJson({"attribute": "maintenanceDetails", "value": jDetails, "type": "J"})
    endif

    freeObj(jDetails)

return .T.

/*/{Protheus.doc} setCallCenterDetails
Monta o bloco de detalhes de atendimento de call center do protocolo ANS.
@type method
@version 12.1.2610
@since 20/08/2026
@author vinicius.queiros
@return logical, true se os detalhes de call center foram adicionados com sucesso, false caso contrário
/*/
method setCallCenterDetails() as logical class AnsProtocolManagerService

    local jDetails := JsonObject():new() as object
 
    self:setAttributeJson({"attribute": "callCenterDetails", "value": jDetails, "type": "J"})

    freeObj(jDetails)

return .T.

/*/{Protheus.doc} getSlaStatus
Calcula o status do SLA do protocolo ANS com base no status atual, data limite e horário de criação.
@type static function
@version 12.1.2610
@since 24/08/2026
@author vinicius.queiros
@param cStatus, character, Status atual do protocolo ANS
@param dLimitDate, date, Data limite para atendimento do protocolo
@param cCreationTime, character, Horário de criação do protocolo no formato HHMM
@return character, Código do status de SLA calculado
/*/
static function getSlaStatus(cStatus as character, dLimitDate as date, cCreationTime as character) as character

    local cSlaStatus as character
    local dCurrentDate := dDataBase as date
    local cCurrentTime := substr(time(), 1, 2) + substr(time(), 4, 2) as character
    
    // Ordem das condições é relevante: fechado/cancelado e pendente de informação
    // prevalecem sobre regras de vencimento.
    do case
        case cStatus == PROT_STATUS_CLOSED .or. cStatus == PROT_STATUS_CANCELED
            cSlaStatus := SLA_STATUS_COMPLETED

        case cStatus == PROT_STATUS_PENDING_INFO
            cSlaStatus := SLA_STATUS_PAUSED

        case dLimitDate < dCurrentDate
            cSlaStatus := SLA_STATUS_OVERDUE

        case dLimitDate == dCurrentDate .and. cCreationTime < cCurrentTime
            cSlaStatus := SLA_STATUS_OVERDUE

        case dLimitDate == dCurrentDate
            cSlaStatus := SLA_STATUS_DUE_TODAY

        otherwise
            cSlaStatus := SLA_STATUS_ON_TIME
    endcase

return cSlaStatus
