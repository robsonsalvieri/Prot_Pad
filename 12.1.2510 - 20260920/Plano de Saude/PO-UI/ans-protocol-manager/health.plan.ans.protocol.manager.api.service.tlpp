#include "tlpp-core.th"
#include "health.plan.ans.protocol.manager.api.service.ch"

#define STATUS_CODE_OK 200
#define STATUS_CODE_BAD_REQUEST 400
#define STATUS_CODE_NOT_FOUND 404

#define PROT_STATUS_OPEN "1" // Aberto
#define PROT_STATUS_CLOSED "2" // Fechado
#define PROT_STATUS_IN_ANALYSIS "3" // Em Análise
#define PROT_STATUS_PENDING_INFO "4" // Pendente de Informação
#define PROT_STATUS_CANCELED "5" // Cancelado

#define SLA_STATUS_ON_TIME "1" // No Prazo
#define SLA_STATUS_DUE_TODAY "2" // A Vencer Hoje
#define SLA_STATUS_OVERDUE "3" // Vencido / Atrasado
#define SLA_STATUS_PAUSED "4" // Pausado
#define SLA_STATUS_COMPLETED "5" // Concluido

#define PROT_ORIGIN_AUTHORIZATION "1" // Autorização (Prestador/Operadora)
#define PROT_ORIGIN_SOL_AUTHORIZATION "2" // Sol. Autorização (Beneficiário - Portal/App)
#define PROT_ORIGIN_ATTACHMENT "3" // Anexo Clínico (Quimio/Radio/OPME)
#define PROT_ORIGIN_EXTENSION "4" // Prorrogação (Diárias Internação)
#define PROT_ORIGIN_REFUND "5" // Reembolso
#define PROT_ORIGIN_CANCELLATION "6" // Cancelamento do Plano
#define PROT_ORIGIN_MAINTENANCE "7" // Manutenção Cadastral
#define PROT_ORIGIN_CALL_CENTER "8" // Call Center

namespace totvs.protheus.health.plan.ans.protocol.manager

using namespace totvs.protheus.health.plans.api.util

/*/{Protheus.doc} AnsProtocolManagerService
Serviço responsável por realizar a comunicação entre o controller e o adapter da API de protocolos ANS
@type class
@version 12.1.2610
@since 25/06/2026
@author vinicius.queiros
/*/
class AnsProtocolManagerService from BaseService

    private data cProtocol as character

    public method new() constructor
    public method getAnsProtocols() as logical
    public method getAnsSummaryProtocols() as logical
    public method getAnsProtocolDetails(cProtocolId as character) as logical
    // Cada origem de protocolo possui um montador dedicado de detalhes.
    private method setProtocolDetails() as logical
    private method setAuthorizationDetails() as logical
    private method setSolAuthorizationDetails() as logical
    private method setAttachmentDetails() as logical
    private method setExtensionDetails() as logical
    private method setRefundDetails() as logical
    private method setCancellationDetails() as logical
    private method setMaintenanceDetails() as logical
    private method setCallCenterDetails() as logical
   
endclass

/*/{Protheus.doc} new
Construtor da classe AnsProtocolManagerService.
@type method
@version 12.1.2610
@since 25/06/2026
@author vinicius.queiros
@return object, instância da classe AnsProtocolManagerService
/*/
method new() class AnsProtocolManagerService

    _Super:new()
    
return self

/*/{Protheus.doc} getAnsProtocols
Processa a requisição para retornar os protocolos ANS.
@type method
@version 12.1.2610
@since 25/06/2026
@author vinicius.queiros
@return logical, true se a operação foi bem sucedida, false caso contrário
/*/
method getAnsProtocols() as logical class AnsProtocolManagerService

    local lResult := .F. as logical
    local oAdapter as object

    // Service centraliza o contrato de retorno HTTP (status + payload) da operação.
    oAdapter := AnsProtocolManagerAdapter():new()
    oAdapter:setQueryParams(self:jParams)

    lResult := oAdapter:getAnsProtocols()

    if lResult
		self:nCodeStatus := STATUS_CODE_OK
		self:jResult := oAdapter:getJsonResult()
	endIf

    oAdapter:destroy()
	freeObj(oAdapter)

return lResult

/*/{Protheus.doc} getAnsSummaryProtocols
Processa a requisição para retornar o resumo dos protocolos ANS.
@type method
@version 12.1.2610
@since 23/07/2026
@author vinicius.queiros
@return logical, true se a operação foi bem sucedida, false caso contrário
/*/
method getAnsSummaryProtocols() as logical class AnsProtocolManagerService

    local lResult := .F. as logical
    local oAdapter as object

    // Reaproveita filtros da listagem, mas retorna somente agregados de SLA.
    oAdapter := AnsProtocolManagerAdapter():new()
    oAdapter:setQueryParams(self:jParams)

    lResult := oAdapter:getAnsSummaryProtocols()

    if lResult
        self:nCodeStatus := STATUS_CODE_OK
        self:jResult := oAdapter:getJsonResult(.T.)
    endIf

    oAdapter:destroy()
    freeObj(oAdapter)
    
return lResult

/*/{Protheus.doc} getAnsProtocolDetails
Processa a requisição para retornar o detalhamento de um protocolo ANS específico.
@type method
@version 12.1.2610
@since 19/08/2026
@author vinicius.queiros
@param cProtocolId, character, Código identificador do protocolo ANS
@return logical, true se o protocolo foi localizado e processado, false caso contrário
/*/
method getAnsProtocolDetails(cProtocolId as character) as logical class AnsProtocolManagerService

    local lResult := .T. as logical
    local cOrigin as character

    B00->(dbSetOrder(1))
    if B00->(dbSeek(xFilial("B00") + cProtocolId))
        self:cProtocol := cProtocolId
        cOrigin := alltrim(B00->B00_ORIPRO)

        // Dispatch por origem para isolar regras específicas de cada fluxo.
        do case
            case cOrigin == PROT_ORIGIN_AUTHORIZATION
                lResult := self:setAuthorizationDetails()
            
            case cOrigin == PROT_ORIGIN_SOL_AUTHORIZATION
                lResult := self:setSolAuthorizationDetails()

            case cOrigin == PROT_ORIGIN_ATTACHMENT
                lResult := self:setAttachmentDetails()

            case cOrigin == PROT_ORIGIN_EXTENSION
                lResult := self:setExtensionDetails()

            case cOrigin == PROT_ORIGIN_REFUND
                lResult := self:setRefundDetails()

            case cOrigin == PROT_ORIGIN_CANCELLATION
                lResult := self:setCancellationDetails()

            case cOrigin == PROT_ORIGIN_MAINTENANCE
                lResult := self:setMaintenanceDetails()

            case cOrigin == PROT_ORIGIN_CALL_CENTER
                lResult := self:setCallCenterDetails()

            otherwise
                // STR0003: "Origem do protocolo ANS não reconhecida."
                // STR0004: "O protocolo informado possui uma origem que não é reconhecida pelo sistema. Verifique o identificador enviado e tente novamente."
                self:setError("", STR0003, STR0004, STATUS_CODE_BAD_REQUEST)       
                lResult := .F. 
        endcase

        if lResult    
            self:setProtocolDetails()   
            self:nCodeStatus := STATUS_CODE_OK
        endif
    else
        // STR0001: "Protocolo ANS não encontrado."
        // STR0002: "Nenhum registro foi localizado na tabela B00 para o protocolo informado. Verifique o identificador enviado e tente novamente."
        self:setError("", STR0001, STR0002, STATUS_CODE_NOT_FOUND)
        lResult := .F.
    endif

return lResult

/*/{Protheus.doc} setProtocolDetails
Monta os atributos gerais do protocolo ANS no payload de resposta.
@type method
@version 12.1.2610
@since 24/08/2026
@author vinicius.queiros
@return logical, true se os atributos gerais do protocolo forem adicionados com sucesso
/*/
method setProtocolDetails() as logical class AnsProtocolManagerService

    local jDetails := JsonObject():new() as object

    // Manter este mapeamento alinhado com ansProtocolFieldsMap() no adapter.
    self:setAttributeJson({"attribute": "protocolId", "value": B00->B00_COD, "type": "C"}, @jDetails)       
    self:setAttributeJson({"attribute": "subscriberId", "value": B00->B00_MATRIC, "type": "C"}, @jDetails)
    self:setAttributeJson({"attribute": "beneficiaryName", "value": B00->B00_CONTAT, "type": "C"}, @jDetails)
    self:setAttributeJson({"attribute": "creationDate", "value": B00->B00_DTPROT, "type": "D"}, @jDetails)
    self:setAttributeJson({"attribute": "creationTime", "value": B00->B00_HRPROT, "type": "C"}, @jDetails)
    self:setAttributeJson({"attribute": "limitDate", "value": B00->B00_DATLIM, "type": "D"}, @jDetails)
    self:setAttributeJson({"attribute": "deadlineDays", "value": B00->B00_PRZDIA, "type": "C"}, @jDetails)
    self:setAttributeJson({"attribute": "deadlineCode", "value": B00->B00_CODPRZ, "type": "C"}, @jDetails)
    self:setAttributeJson({"attribute": "deadlineDescription", "value": posicione("B6Y", 1, xFilial("B6Y") + B00->B00_CODPRZ, "B6Y_DESCRI"), "type": "C"}, @jDetails)
    self:setAttributeJson({"attribute": "closingDate", "value": B00->B00_DTENCE, "type": "D"}, @jDetails)
    self:setAttributeJson({"attribute": "closingTime", "value": B00->B00_HRENCE, "type": "C"}, @jDetails)
    self:setAttributeJson({"attribute": "status", "value": B00->B00_STATUS, "type": "C"}, @jDetails)
    self:setAttributeJson({"attribute": "slaStatus", "value": getSlaStatus(B00->B00_STATUS, B00->B00_DATLIM, B00->B00_HRPROT), "type": "C"}, @jDetails)
    self:setAttributeJson({"attribute": "origin", "value": B00->B00_ORIPRO, "type": "C"}, @jDetails)

    self:setAttributeJson({"attribute": "protocol", "value": jDetails, "type": "J"})

    freeObj(jDetails)

return .T.

/*/{Protheus.doc} setAuthorizationDetails
Monta o bloco de detalhes de autorização do protocolo ANS.
@type method
@version 12.1.2610
@since 20/08/2026
@author vinicius.queiros
@return logical, true se os detalhes de autorização foram adicionados com sucesso, false caso contrário
/*/
method setAuthorizationDetails() as logical class AnsProtocolManagerService

    local jDetails := JsonObject():new() as object
    local jHospitalization := JsonObject():new() as object
 
    BEA->(dbSetOrder(1))
    if BEA->(dbSeek(xFilial("BEA") + B00->B00_NUMGUI))
        // Serializa os dados de autorização em objeto filho do payload principal.
        self:setAttributeJson({"attribute": "status", "value": BEA->BEA_STATUS, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "authorizationNumber", "value": BEA->(BEA_OPEMOV + BEA_ANOAUT + BEA_MESAUT + BEA_NUMAUT), "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "authorizationPassword", "value": BEA->BEA_SENHA, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "passwordExpirationDate", "value": BEA->BEA_VALSEN, "type": "D"}, @jDetails)
        self:setAttributeJson({"attribute": "authorizationType", "value": BEA->BEA_TIPO, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "provider", "value": BEA->BEA_CODRDA, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "providerName", "value": BEA->BEA_NOMRDA, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "professionalName", "value": BEA->BEA_NOMSOL, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "professionalCouncil", "value": BEA->BEA_SIGLA, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "professionalCouncilNumber", "value": BEA->BEA_REGSOL, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "stateAbbreviation", "value": BEA->BEA_ESTSOL, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "cid", "value": BEA->BEA_CID, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "cidDescription", "value": BEA->BEA_DESCID, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "clinicalIndication", "value": BEA->BEA_INDCLI, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "underAudit", "value": BEA->BEA_AUDITO, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "isCanceled", "value": BEA->BEA_CANCEL, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "cancellationDate", "value": BEA->BEA_CANDAT, "type": "D"}, @jDetails)
        self:setAttributeJson({"attribute": "cancellationReason", "value": BEA->BEA_CANEDI, "type": "C"}, @jDetails)

        if BEA->BEA_TIPO == "3" // Internação
            BE4->(dbSetOrder(2))
		    if BE4->(dbSeek(xFilial("BE4") + B00->B00_NUMGUI))
                // Para internação, senha e dados de permanência vêm da BE4.
                self:setAttributeJson({"attribute": "authorizationPassword", "value": BE4->BE4_SENHA, "type": "C"}, @jDetails)
                self:setAttributeJson({"attribute": "passwordExpirationDate", "value": BE4->BE4_DATVAL, "type": "D"}, @jDetails)
                self:setAttributeJson({"attribute": "admissionDate", "value": BE4->BE4_DATPRO, "type": "D"}, @jHospitalization)
                self:setAttributeJson({"attribute": "admissionTime", "value": BE4->BE4_HORPRO, "type": "C"}, @jHospitalization)
                self:setAttributeJson({"attribute": "dischargeDate", "value": BE4->BE4_DTALTA, "type": "D"}, @jHospitalization)
                self:setAttributeJson({"attribute": "dischargeTime", "value": BE4->BE4_HRALTA, "type": "C"}, @jHospitalization)
                self:setAttributeJson({"attribute": "stayDays", "value": plsDiasInt(), "type": "N"}, @jHospitalization)

                self:setAttributeJson({"attribute": "hospitalizationDetails", "value": jHospitalization, "type": "J"}, @jDetails)  
            endif
        endif

        self:setAttributeJson({"attribute": "authorizationDetails", "value": jDetails, "type": "J"})
    endif

    freeObj(jDetails)
    freeObj(jHospitalization)

return .T.

/*/{Protheus.doc} setSolAuthorizationDetails
Monta o bloco de detalhes da solicitação de autorização do protocolo ANS.
@type method
@version 12.1.2610
@since 20/08/2026
@author vinicius.queiros
@return logical, true se os detalhes da solicitação de autorização foram adicionados com sucesso, false caso contrário
/*/
method setSolAuthorizationDetails() as logical class AnsProtocolManagerService

    local jDetails := JsonObject():new() as object

    BKU->(dbSetOrder(1))
    if BKU->(dbSeek(xFilial("BKU") + self:cProtocol))
        // Serializa os dados de solicitação de autorização em objeto filho do payload principal.
        self:setAttributeJson({"attribute": "professionalName", "value": BKU->BKU_NOMSOL, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "professionalCouncil", "value": BKU->BKU_SIGLA, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "professionalCouncilNumber", "value": BKU->BKU_REGSOL, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "stateAbbreviation", "value": BKU->BKU_UF, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "status", "value": BKU->BKU_STATUS, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "denialReason", "value": BKU->BKU_NEGDES, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "authorizationNumber", "value": BKU->BKU_NUMAUT, "type": "C"}, @jDetails)
        self:setAttributeJson({"attribute": "authorizationType", "value": BKU->BKU_TIPO, "type": "C"}, @jDetails)

        self:setAttributeJson({"attribute": "solAuthorizationDetails", "value": jDetails, "type": "J"})
    endif

    freeObj(jDetails)

return .T.

/*/{Protheus.doc} setAttachmentDetails
Monta o bloco de detalhes de anexo clínico do protocolo ANS.
