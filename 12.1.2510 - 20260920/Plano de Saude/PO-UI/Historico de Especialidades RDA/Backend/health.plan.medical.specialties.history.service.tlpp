#Include "tlpp-core.th"
#Include "totvs.ch"

Class SpecialtyHistoryAuditService
    
    private data aOriginColumnBase as array

    public method new() as Object
    public method setOriginalSpecialtyColumns(aStoredColumns as Array) as Variant
    public method getOriginalSpecialtyColumns() as Array
    public method buildSpecialtyHistoryPendingItems(aBuildHeaders as Array, aBuildRows as Array, cBuildMember as Character, cBuildContract as Character, cBuildLocation as Character) as Array
    public method saveSpecialtyHistoryPendingItems(aSavingItems as Array) as Variant
    public method findreuse(aSavingItems as Array, cMember as Character, cContract as Character, cLocation as Character) as Array
    public method deleteSpecialtyHistoryEntries(cDeleteMember as Character, cDeleteContract as Character, cDeleteLocation as Character, cDeleteSpecialty as Character) as Variant

    public method buildMonitoredSpecialtyFields(aMonitorHeaders as Array) as Array
    public method appendEntryPointFieldMappings(aAppendFields as Array, aAppendHeaders as Array) as Array
    public method validateEntryPointFieldUsage(cValidFieldName as Character, cValidFieldType as Character, aValidHeaders as Array) as Logical
    public method resolveEntryPointFieldType(cResolveFieldName as Character, cResolveFieldType as Character) as Character
    public method composeSpecialtyHistoryPendingItems(aComposeOriginal as Array, aComposeCurrent as Array, aComposeFields as Array, cComposeMember as Character, cComposeContract as Character, cComposeLocation as Character) as Array
    public method extractCurrentRowFieldValue(aExtractRowData as Array, aExtractFields as Array, cExtractFieldName as Character) as Variant
    public method fltrows(aHeaders as Array, aRows as Array, cContract as Character, cLocation as Character) as Array
    public method hashistcd(cMember as Character, cContract as Character, cLocation as Character, cSpecialty as Character) as Logical
    public method hasRelevantValueForHistory(cRelevantTypeId as Character, cRelevantValueTx as Character) as Logical
    public method loadbax(aHeaders as Array, cMember as Character, cContract as Character, cLocation as Character) as Array
    public method normalizeValueForHistoryStorage(cNormalizeField as Character, cNormalizeType as Character, xNormalizeSource as Variant) as Character
    public method buildSpecialtyCompositeKey(cCompositeSpec as Character, cCompositeSubs as Character) as Character
    public method resolveAuditUserIdentifier() as Character
    public method assignBlvFieldStorageValue(cAssignFieldNm as Character, xAssignPayload as Variant) as Variant
    public method createHistoryPendingPayload(cPayloadMember as Character, cPayloadCntrct as Character, cPayloadLocati as Character, cPayloadCurrSp as Character, cPayloadCurrSb as Character, cPayloadNewSpc as Character, cPayloadNewSub as Character, cPayloadEvtTyp as Character, cPayloadFieldN as Character, cPayloadFieldT as Character, cPayloadPrevVl as Character, cPayloadCurrVl as Character, cPayloadEvtNum as Character, nPayloadSeqNo as Numeric) as Variant
    public method getProcessedEntryIndicator(xTrackerReadr as Variant, nTrackerIndex as Numeric) as Logical
    public method setProcessedEntryIndicator(xTrackerWrite as Variant, nWriterIndex as Numeric, lWriterUsage as Logical) as Variant
EndClass

////////////////////////////////////////////////////////////////////
/*/{Protheus.doc} new
Inicializa a classe.
@since 01/04/2026
@return Self, objeto, Retorna a propria instancia inicializada.
/*/
Method new() as Object Class SpecialtyHistoryAuditService
    
    self:aOriginColumnBase := {}
Return Self

////////////////////////////////////////////////////////////////////
/*/{Protheus.doc} setOriginalSpecialtyColumns
Armazena a base original de colunas para comparacao.
@since 01/04/2026
@param aStoredColumns, array, Source specialty columns.
@return Nil, indefinido, Nao retorna valor.
/*/
Method setOriginalSpecialtyColumns(aStoredColumns as Array) as Variant Class SpecialtyHistoryAuditService
   
    self:aOriginColumnBase := aClone(aStoredColumns)
Return Nil

////////////////////////////////////////////////////////////////////
/*/{Protheus.doc} getOriginalSpecialtyColumns
Retorna a base original de colunas armazenada.
@since 01/04/2026
@return aOrg, array, Retorna a base original armazenada.
/*/
Method getOriginalSpecialtyColumns() as Array Class SpecialtyHistoryAuditService
Return aClone(self:aOriginColumnBase)

////////////////////////////////////////////////////////////////////
/*/{Protheus.doc} buildSpecialtyHistoryPendingItems
Monta a lista de pendencias do historico com base no browse informado.
@since 01/04/2026
@param aBuildHeaders, array, Header fields from the grid.
@param aBuildRows, array, Current specialty rows.
@param cBuildMember, caractere, Member identifier code.
@param cBuildContract, caractere, Contract identifier code.
@param cBuildLocation, caractere, Location identifier code.
@return aPend, array, Retorna as pendencias identificadas.
/*/
Method buildSpecialtyHistoryPendingItems(aBuildHeaders as Array, aBuildRows as Array, cBuildMember as Character, cBuildContract as Character, cBuildLocation as Character) as Array Class SpecialtyHistoryAuditService
    
    Local aPend := {}
    Local aCurr := {}
    Local aFlds := {}
    Local aOrg  := {}

    Default cBuildMember   := ""
    Default cBuildContract := ""
    Default cBuildLocation := ""

    aFlds := self:buildMonitoredSpecialtyFields(aBuildHeaders)
    aCurr := self:fltrows(aBuildHeaders,aBuildRows,cBuildContract,cBuildLocation)
    aOrg  := self:loadbax(aBuildHeaders,cBuildMember,cBuildContract,cBuildLocation)

    If Len(aOrg) == 0
        aOrg := self:fltrows(aBuildHeaders,self:getOriginalSpecialtyColumns(),cBuildContract,cBuildLocation)
    EndIf

    If Len(aFlds) == 0
        Return aPend
    EndIf

    aPend := self:composeSpecialtyHistoryPendingItems(aOrg, aCurr, aFlds, cBuildMember, cBuildContract, cBuildLocation)

Return aPend

////////////////////////////////////////////////////////////////////
/*/{Protheus.doc} saveSpecialtyHistoryPendingItems
Grava os registros pendentes no historico BLV.
@since 01/04/2026
@param aSavingItems, array, Pending history items.
@return Nil, indefinido, Nao retorna valor.
/*/
Method saveSpecialtyHistoryPendingItems(aSavingItems as Array) as Variant Class SpecialtyHistoryAuditService
    
    Local aArea    := GetArea()
    Local nI       := 0
    Local dData    := dDataBase
    Local cHora    := Time()
    Local cUser    := self:resolveAuditUserIdentifier()
    Local oPend    := JsonObject():New()
    Local nLnAPend := Len(aSavingItems)

    If Empty(aSavingItems) .Or. Len(aSavingItems) == 0 .Or. BLV->(FieldPos("BLV_CODIGO")) == 0 .Or. ;
       BLV->(FieldPos("BLV_CODINT")) == 0 .Or. BLV->(FieldPos("BLV_CODLOC")) == 0
        Return Nil
    EndIf

    For nI := 1 To nLnAPend
        
        oPend := aSavingItems[nI]

        BLV->(RecLock("BLV",.T.))
            BLV->(self:assignBlvFieldStorageValue("BLV_FILIAL",xFilial("BLV")))
            BLV->(self:assignBlvFieldStorageValue("BLV_CODIGO",oPend["codigo"]))
            BLV->(self:assignBlvFieldStorageValue("BLV_CODINT",oPend["codint"]))
            BLV->(self:assignBlvFieldStorageValue("BLV_CODLOC",oPend["codloc"]))
            BLV->(self:assignBlvFieldStorageValue("BLV_CESPAT",oPend["cespat"]))
            BLV->(self:assignBlvFieldStorageValue("BLV_CESPNO",oPend["cespno"]))
            BLV->(self:assignBlvFieldStorageValue("BLV_TPEVTO",oPend["tpevto"]))
            BLV->(self:assignBlvFieldStorageValue("BLV_CAMPO" ,oPend["campo" ]))
            BLV->(self:assignBlvFieldStorageValue("BLV_TPCAM" ,oPend["tpcam" ]))
            BLV->(self:assignBlvFieldStorageValue("BLV_VALANT",Left(oPend["valant"],120)))
            BLV->(self:assignBlvFieldStorageValue("BLV_VALNOV",Left(oPend["valnov"],120)))
            BLV->(self:assignBlvFieldStorageValue("BLV_EVENTO",oPend["evento"]))
            BLV->(self:assignBlvFieldStorageValue("BLV_SEQ"   ,oPend["seq"]))
            BLV->(self:assignBlvFieldStorageValue("BLV_USUARI",cUser))
            BLV->(self:assignBlvFieldStorageValue("BLV_DATALT",dData))
            BLV->(self:assignBlvFieldStorageValue("BLV_HORALT",cHora))
            BLV->(self:assignBlvFieldStorageValue("BLV_ROTINA","PLSA365"))
        BLV->(MsUnlock())
    Next

    RestArea(aArea)

Return Nil

////////////////////////////////////////////////////////////////////
/*/{Protheus.doc} findreuse
Identifica codigos reaproveitados que ja possuem historico na BLV.
@since 06/04/2026
@param aSavingItems, array, Pending history items.
@param cMember, caractere, Member identifier code.
@param cContract, caractere, Contract identifier code.
@param cLocation, caractere, Location identifier code.
@return aReuse, array, Retorna os codigos que exigem confirmacao e limpeza.
/*/
Method findreuse(aSavingItems as Array, cMember as Character, cContract as Character, cLocation as Character) as Array Class SpecialtyHistoryAuditService

    Local aReuse      := {}
    Local cCandidate  := ""
    Local cCurrentSp  := ""
    Local cEventType  := ""
    Local nI          := 0
    Local oPend       := JsonObject():New()
    Local nLnSaving   := Len(aSavingItems)

    Default aSavingItems := {}
    Default cMember      := ""
    Default cContract    := ""
    Default cLocation    := ""

    If ValType(aSavingItems) <> "A" .Or. Empty(cMember) .Or. Empty(cContract) .Or. Empty(cLocation)
        Return aReuse
    EndIf

    For nI := 1 To nLnSaving
        oPend := aSavingItems[nI]

        If !(ValType(oPend) $ "OJ")
            Loop
        EndIf

        cEventType := AllTrim(oPend["tpevto"])
        cCandidate := ""
        cCurrentSp := AllTrim(oPend["cespat"])

        Do Case
            Case cEventType == "1" .Or. cEventType == "I"
                cCandidate := AllTrim(oPend["cespno"])

            Case (cEventType == "2" .Or. cEventType == "A") .And. AllTrim(oPend["cespno"]) <> cCurrentSp
                cCandidate := AllTrim(oPend["cespno"])
        EndCase

        If Empty(cCandidate) .Or. Ascan(aReuse,cCandidate) > 0
            Loop
        EndIf

        If self:hashistcd(cMember,cContract,cLocation,cCandidate)
            AAdd(aReuse,cCandidate)
        EndIf
    Next

Return aReuse

////////////////////////////////////////////////////////////////////
/*/{Protheus.doc} deleteSpecialtyHistoryEntries
Remove registros da BLV relacionados a especialidade informada.
@since 01/04/2026
@param cDeleteMember, caractere, Member identifier code.
@param cDeleteContract, caractere, Contract identifier code.
@param cDeleteLocation, caractere, Location identifier code.
@param cDeleteSpecialty, caractere, Specialty identifier code.
@return Nil, indefinido, Nao retorna valor.
/*/
Method deleteSpecialtyHistoryEntries(cDeleteMember as Character, cDeleteContract as Character, cDeleteLocation as Character, cDeleteSpecialty as Character) as Variant Class SpecialtyHistoryAuditService
   
    Local aArea     := GetArea()
    Local cAliasQry := ""
    Local cSql      := ""
    Local cSpec     := ""
    Local lCloseBlv := Select("BLV") == 0
    Local nRecno    := 0
    Local oStmt     := Nil

    Default cDeleteMember   := ""
    Default cDeleteContract := ""
    Default cDeleteLocation := ""
    Default cDeleteSpecialty := ""

    If Empty(cDeleteMember) .Or. Empty(cDeleteContract) .Or. Empty(cDeleteLocation) .Or. Empty(cDeleteSpecialty)
        Return Nil
    EndIf

    cDeleteMember    := AllTrim(cDeleteMember)
    cDeleteContract  := AllTrim(cDeleteContract)
    cDeleteLocation  := AllTrim(cDeleteLocation)
    cDeleteSpecialty := AllTrim(cDeleteSpecialty)
    cSpec            := cDeleteSpecialty

    If BLV->(FieldPos("BLV_CODIGO")) == 0 .Or. BLV->(FieldPos("BLV_CODINT")) == 0 .Or. BLV->(FieldPos("BLV_CODLOC")) == 0
 
        RestArea(aArea)
        Return Nil
    EndIf

    oStmt := FWExecStatement():New()

    cSql += " SELECT R_E_C_N_O_ BLVRECNO "
    cSql += " FROM " + RetSqlName("BLV")
    cSql += " WHERE BLV_FILIAL = ? "
    cSql += " AND BLV_CODIGO   = ? "
    cSql += " AND BLV_CODINT   = ? "
    cSql += " AND BLV_CODLOC   = ? "
    cSql += " AND ((BLV_CESPAT = ?) OR (BLV_CESPNO = ?)) "
    cSql += " AND D_E_L_E_T_   = ? "

    oStmt:SetQuery(cSql)
    oStmt:SetString(1, xFilial("BLV"))
    oStmt:SetString(2, cDeleteMember)
    oStmt:SetString(3, cDeleteContract)
    oStmt:SetString(4, cDeleteLocation)
    oStmt:SetString(5, cSpec)
    oStmt:SetString(6, cSpec)
    oStmt:SetString(7, " ")

    cAliasQry := oStmt:OpenAlias()

    If !Empty(cAliasQry)
        While !(cAliasQry)->(Eof())
            nRecno := (cAliasQry)->BLVRECNO

            If nRecno > 0
                BLV->(DbGoto(nRecno))
                BLV->(RecLock("BLV",.F.))
                BLV->(DbDelete())
                BLV->(MsUnlock())
            EndIf

            (cAliasQry)->(DbSkip())
        EndDo

        (cAliasQry)->(DbCloseArea())
    EndIf

    oStmt:Destroy()
    RestArea(aArea)

Return Nil

////////////////////////////////////////////////////////////////////
/*/{Protheus.doc} hashistcd
Verifica se a especialidade informada ja possui historico na BLV.
@since 06/04/2026
@param cMember, caractere, Member identifier code.
@param cContract, caractere, Contract identifier code.
@param cLocation, caractere, Location identifier code.
@param cSpecialty, caractere, Specialty identifier code.
@return lHasHist, logico, Retorna se existe historico previo para o codigo.
/*/
Method hashistcd(cMember as Character, cContract as Character, cLocation as Character, cSpecialty as Character) as Logical Class SpecialtyHistoryAuditService

    Local aArea     := GetArea()
    Local cSql      := ""
    Local cSpec     := ""
    Local cAliasQry := ""
    Local lHasHist  := .F.
    Local oStmt     := Nil

    Default cMember    := ""
    Default cContract  := ""
    Default cLocation  := ""
    Default cSpecialty := ""

    If Empty(cMember) .Or. Empty(cContract) .Or. Empty(cLocation) .Or. Empty(cSpecialty)
        Return lHasHist
    EndIf

    cMember    := AllTrim(cMember)
    cContract  := AllTrim(cContract)
    cLocation  := AllTrim(cLocation)
    cSpecialty := AllTrim(cSpecialty)
    cSpec      := cSpecialty

    oStmt := FWExecStatement():New()

    cSql += " SELECT BLV_CESPAT "
    cSql += " FROM " + RetSqlName("BLV")
    cSql += " WHERE BLV_FILIAL = ? "
    cSql += " AND BLV_CODIGO   = ? "
    cSql += " AND BLV_CODINT   = ? "
    cSql += " AND BLV_CODLOC   = ? "
    cSql += " AND ((BLV_CESPAT = ?) OR (BLV_CESPNO = ?)) "
    cSql += " AND D_E_L_E_T_   = ? "

    oStmt:SetQuery(cSql)
    oStmt:SetString(1, xFilial("BLV"))
    oStmt:SetString(2, cMember)
    oStmt:SetString(3, cContract)
    oStmt:SetString(4, cLocation)
    oStmt:SetString(5, cSpec)
    oStmt:SetString(6, cSpec)
    oStmt:SetString(7, " ")

    cAliasQry := oStmt:OpenAlias()

    If !Empty(cAliasQry)
        lHasHist := !(cAliasQry)->(Eof())
        (cAliasQry)->(DbCloseArea())
    EndIf

    oStmt:Destroy()

    RestArea(aArea)

Return lHasHist

////////////////////////////////////////////////////////////////////
/*/{Protheus.doc} fltrows
Filtra as linhas da grade para a operadora e local informados.
@since 06/04/2026
@param aHeaders, array, Header fields from the grid.
@param aRows, array, Source rows from the grid.
@param cContract, caractere, Contract identifier code.
@param cLocation, caractere, Location identifier code.
@return aFil, array, Retorna as linhas filtradas.
/*/
Method fltrows(aHeaders as Array, aRows as Array, cContract as Character, cLocation as Character) as Array Class SpecialtyHistoryAuditService

    Local aFil    := {}
    Local aRow    := {}
    Local nI      := 0
    Local nPosInt := 0
    Local nPosLoc := 0
    Local nLnRows := Len(aRows)

    Default aHeaders   := {}
    Default aRows      := {}
    Default cContract  := ""
    Default cLocation  := ""

    nPosInt := GdFieldPos("BAX_CODINT",aHeaders)
    nPosLoc := GdFieldPos("BAX_CODLOC",aHeaders)

    If nPosInt <= 0 .Or. nPosLoc <= 0
        Return aRows
    EndIf

    For nI := 1 To nLnRows
        aRow := aRows[nI]

        If ValType(aRow) <> "A" .Or. Len(aRow) == 0
            Loop
        EndIf

        If AllTrim(aRow[nPosInt]) == AllTrim(cContract) .And. AllTrim(aRow[nPosLoc]) == AllTrim(cLocation)
            AAdd(aFil,aRow)
        EndIf
    Next

Return aFil

////////////////////////////////////////////////////////////////////
/*/{Protheus.doc} loadbax
Carrega o estado atual da BAX gravada para comparacao do historico.
@since 06/04/2026
@param aHeaders, array, Header fields from the grid.
@param cMember, caractere, Member identifier code.
@param cContract, caractere, Contract identifier code.
@param cLocation, caractere, Location identifier code.
@return aRows, array, Retorna as linhas atuais gravadas na BAX.
/*/
Method loadbax(aHeaders as Array, cMember as Character, cContract as Character, cLocation as Character) as Array Class SpecialtyHistoryAuditService

    Local aArea     := GetArea()
    Local aRow      := {}
    Local aRows     := {}
    Local cField    := ""
    Local nI        := 0
    Local nPosFld   := 0
    Local nRowSize  := Len(aHeaders) + 1
    Local nLnHdrs   := Len(aHeaders)

    Default aHeaders   := {}
    Default cMember    := ""
    Default cContract  := ""
    Default cLocation  := ""

    If ValType(aHeaders) <> "A" .Or. Empty(cMember) .Or. Empty(cContract) .Or. Empty(cLocation)
        Return aRows
    EndIf

    BAX->(DbSetOrder(1))

    If BAX->(MsSeek(xFilial("BAX") + AllTrim(cMember)))

        While !BAX->(Eof()) .And. BAX->(BAX_FILIAL + BAX_CODIGO) == xFilial("BAX") + AllTrim(cMember)

            If AllTrim(BAX->BAX_CODINT) == AllTrim(cContract) .And. AllTrim(BAX->BAX_CODLOC) == AllTrim(cLocation)
                
                aRow := Array(nRowSize)
                AFill(aRow,"")
                aRow[nRowSize] := .F.

                For nI := 1 To nLnHdrs
                    
                    cField  := Upper(AllTrim(aHeaders[nI][2]))
                    nPosFld := BAX->(FieldPos(cField))

                    If nPosFld > 0
                        aRow[nI] := BAX->(FieldGet(nPosFld))
                    EndIf
                Next

                AAdd(aRows,aRow)
            EndIf

            BAX->(DbSkip())
        EndDo
    EndIf

    RestArea(aArea)

Return aRows

////////////////////////////////////////////////////////////////////
/*/{Protheus.doc} buildMonitoredSpecialtyFields
Monta a lista de campos monitorados para o historico BLV.
@since 01/04/2026
@param aMonitorHeaders, array, Header fields from the grid.
@return aFlds, array, Retorna os campos monitorados no historico.
/*/
Method buildMonitoredSpecialtyFields(aMonitorHeaders as Array) as Array Class SpecialtyHistoryAuditService
    
    Local aBase   := {}
    Local aFlds   := {}
    Local nI      := 0
    Local nPos    := 0
    Local nLnBase := 0

    AAdd(aBase,{"BAX_CODESP","C"})
    AAdd(aBase,{"BAX_CODSUB","C"})
    AAdd(aBase,{"BAX_DATINC","D"})
    AAdd(aBase,{"BAX_DATBLO","D"})
    AAdd(aBase,{"BAX_GUIMED","C"})
    AAdd(aBase,{"BAX_VALCH","N"})
    AAdd(aBase,{"BAX_VIGDE","D"})
    AAdd(aBase,{"BAX_FORMUL","C"})
    AAdd(aBase,{"BAX_EXPRES","C"})
    AAdd(aBase,{"BAX_CONESP","C"})
    AAdd(aBase,{"BAX_LIMATM","C"})
    AAdd(aBase,{"BAX_ORDPES","C"})
    AAdd(aBase,{"BAX_ESPPRI","C"})
    AAdd(aBase,{"BAX_BANDA","N"})
    AAdd(aBase,{"BAX_UCO","N"})
    AAdd(aBase,{"BAX_CODREA","C"})
    AAdd(aBase,{"BAX_RECREA","N"})
    AAdd(aBase,{"BAX_AUPREV","C"})
    AAdd(aBase,{"BAX_LIDIAR","C"})

    aBase := self:appendEntryPointFieldMappings(aBase,aMonitorHeaders)

    nLnBase := Len(aBase)

    For nI := 1 To nLnBase
        
        nPos := GdFieldPos(aBase[nI][1],aMonitorHeaders)
        
        If nPos > 0
            AAdd(aFlds,{aBase[nI][1],aBase[nI][2],nPos})
        EndIf
    Next

Return aFlds

////////////////////////////////////////////////////////////////////
/*/{Protheus.doc} appendEntryPointFieldMappings
Inclui campos adicionais vindos do ponto de entrada na lista monitorada.
@since 01/04/2026
@param aAppendFields, array, Base field mappings.
@param aAppendHeaders, array, Header fields from the grid.
@return aMappedFields, array, Retorna a lista base com os campos adicionais validos.
/*/
Method appendEntryPointFieldMappings(aAppendFields as Array, aAppendHeaders as Array) as Array Class SpecialtyHistoryAuditService
   
    Local aRet       := {}
    Local aItem      := {}
    Local cCampo     := ""
    Local cTipo      := ""
    Local nI         := 0
    Local nLnRetMapp := 0

    Default aAppendFields  := {}
    Default aAppendHeaders := {}

    /*
        Ponto de entrada: PL365BLV
        Objetivo:
            Permitir incluir campos adicionais da tabela BAX na geracao do historico BLV.

        Chamada:
            ExecBlock("PL365BLV", .F., .F., { aClone(aAppendFields), aAppendHeaders })

        Parametros do ponto de entrada:
            PARAMIXB[1] = Array com os campos padroes monitorados no formato { {cCampo, cTipo}, ... }
            PARAMIXB[2] = Header da GetDados de especialidades (oBrowse:aHeader)

        Retorno esperado:
            Array com os campos adicionais que devem entrar no historico.
            Cada item pode ser:
                {"BAX_CAMPO", "C"}
            ou apenas:
                "BAX_CAMPO"

        Regras:
            - o campo deve existir no SX3;
            - o campo deve estar presente no header da GetDados para ser comparado na gravacao;
            - tipos aceitos: C, D e N;
            - campos duplicados sao ignorados.

        Exemplo de implementacao do ponto de entrada:

            Function PL365BLV()
                Local aRet := {}

                AAdd(aRet, {"BAX_CAMPEX", "C"})
                AAdd(aRet, {"BAX_DATEX", "D"})
                AAdd(aRet, {"BAX_VLEXT", "N"})

            Return aRet
    */

    If ExistBlock("PL365BLV")
        
        aRet := ExecBlock("PL365BLV", .F., .F., { aClone(aAppendFields), aAppendHeaders })

        nLnRetMapp := Len(aRet)

        For nI := 1 To nLnRetMapp
            
            aItem  := aRet[nI]
            cCampo := ""
            cTipo  := ""

            If ValType(aItem) == "C"
                cCampo := Upper(AllTrim(aItem))
            
            ElseIf ValType(aItem) == "A" .And. Len(aItem) > 0
                cCampo := Upper(AllTrim(aItem[1]))

                If Len(aItem) > 1 .And. ValType(aItem[2]) == "C"
                    cTipo := Upper(AllTrim(aItem[2]))
                EndIf
            EndIf

            cTipo := self:resolveEntryPointFieldType(cCampo,cTipo)

            If !self:validateEntryPointFieldUsage(cCampo,cTipo,aAppendHeaders)
                Loop
            EndIf

            If Ascan(aAppendFields,{|aFld| aFld[1] == cCampo}) > 0
                Loop
            EndIf

            AAdd(aAppendFields,{cCampo,cTipo})
        Next
    EndIf

Return aAppendFields

////////////////////////////////////////////////////////////////////
/*/{Protheus.doc} validateEntryPointFieldUsage
Valida se o campo adicional pode ser usado no historico.
@since 01/04/2026
@param cValidFieldName, caractere, Field identifier name.
@param cValidFieldType, caractere, Field data type code.
@param aValidHeaders, array, Header fields from the grid.
@return lRet, logico, Retorna se o campo adicional pode ser processado.
/*/
Method validateEntryPointFieldUsage(cValidFieldName as Character, cValidFieldType as Character, aValidHeaders as Array) as Logical Class SpecialtyHistoryAuditService
    
    Local aTam := {}

    Default cValidFieldName := ""
    Default cValidFieldType := ""
    Default aValidHeaders   := {}

    If Empty(cValidFieldName) .Or. Left(cValidFieldName,4) <> "BAX_"
        Return .F.
    EndIf

    If !(cValidFieldType $ "CDN")
        Return .F.
    EndIf

    aTam := TamSX3(cValidFieldName)

Return .T.

////////////////////////////////////////////////////////////////////
/*/{Protheus.doc} resolveEntryPointFieldType
Determina o tipo do campo adicional monitorado.
@since 01/04/2026
@param cResolveFieldName, caractere, Field identifier name.
@param cResolveFieldType, caractere, Field data type code.
@return cFieldDataType, caractere, Retorna o tipo do campo monitorado.
/*/
Method resolveEntryPointFieldType(cResolveFieldName as Character, cResolveFieldType as Character) as Character Class SpecialtyHistoryAuditService
    
    Default cResolveFieldName := ""
    Default cResolveFieldType := ""

    cResolveFieldType := Upper(AllTrim(cResolveFieldType))

    If Empty(cResolveFieldName)
        Return ""
    EndIf

    If Empty(cResolveFieldType)
        cResolveFieldType := Upper(AllTrim(GetSX3Cache(cResolveFieldName,"X3_TIPO")))
    EndIf

    If Empty(cResolveFieldType)
        cResolveFieldType := Upper(AllTrim(FWSX3Util():GetFieldType(cResolveFieldName)))
    EndIf

Return cResolveFieldType

////////////////////////////////////////////////////////////////////
/*/{Protheus.doc} composeSpecialtyHistoryPendingItems
Compara os dados originais e atuais e gera as pendencias do historico.
@since 01/04/2026
@param aComposeOriginal, array, Original specialty rows.
@param aComposeCurrent, array, Current specialty rows.
@param aComposeFields, array, Monitored field definitions.
@param cComposeMember, caractere, Member identifier code.
@param cComposeContract, caractere, Contract identifier code.
@param cComposeLocation, caractere, Location identifier code.
@return aPend, array, Retorna as pendencias geradas para gravacao.
/*/
Method composeSpecialtyHistoryPendingItems(aComposeOriginal as Array, aComposeCurrent as Array, aComposeFields as Array, cComposeMember as Character, cComposeContract as Character, cComposeLocation as Character) as Array Class SpecialtyHistoryAuditService
    
    Local cBaseEvt  := Dtos(dDataBase) + StrTran(Time(),":","")
    Local cEvento   := ""
    Local cValAnt   := ""
    Local cValNov   := ""
    Local cCodEspAt := ""
    Local cCodSubAt := ""
    Local cCodEspNo := ""
    Local cCodSubNo := ""
    Local cKeyOrg   := ""
    Local cKeyNow   := ""
    Local nEvt      := 0
    Local nSeq      := 0
    Local nI        := 0
    Local nJ        := 0
    Local nHit      := 0
    Local nMatch    := 0
    Local oOrgUse   := JsonObject():New()
    Local oNowUse   := JsonObject():New()
    Local aPend     := {}
    Local aOrgRow   := {}
    Local aNowRow   := {}
    Local lOrgOk    := .F.
    Local lNowOk    := .F.
    Local nLnOrg    := 0
    Local nLnNow    := 0
    Local nLMax     := 0
    Local nLnFlds   := 0

    Default aComposeOriginal := {}
    Default aComposeCurrent  := {}
    Default aComposeFields   := {}
    Default cComposeMember   := ""
    Default cComposeContract := ""
    Default cComposeLocation := ""

    nLnOrg  := Len(aComposeOriginal)
    nLnNow  := Len(aComposeCurrent)
    nLnFlds := Len(aComposeFields)

    For nI := 1 To nLnOrg
        
        aOrgRow := aComposeOriginal[nI]
        lOrgOk  := ValType(aOrgRow) == "A" .And. Len(aOrgRow) > 0 .And. !ATail(aOrgRow)

        If !lOrgOk
            Loop
        EndIf

        cKeyOrg := self:buildSpecialtyCompositeKey(self:extractCurrentRowFieldValue(aOrgRow,aComposeFields,"BAX_CODESP"),self:extractCurrentRowFieldValue(aOrgRow,aComposeFields,"BAX_CODSUB"))

        If Empty(cKeyOrg)
            Loop
        EndIf

        nHit   := 0
        nMatch := 0

        For nJ := 1 To nLnNow
            If self:getProcessedEntryIndicator(oNowUse,nJ)
                Loop
            EndIf

            aNowRow := aComposeCurrent[nJ]
            lNowOk  := ValType(aNowRow) == "A" .And. Len(aNowRow) > 0 .And. !ATail(aNowRow)

            If !lNowOk
                Loop
            EndIf

            cKeyNow := self:buildSpecialtyCompositeKey(self:extractCurrentRowFieldValue(aNowRow,aComposeFields,"BAX_CODESP"),self:extractCurrentRowFieldValue(aNowRow,aComposeFields,"BAX_CODSUB"))

            If cKeyNow == cKeyOrg
                nHit++
                nMatch := nJ
            EndIf
        Next

        If nHit == 1
            
            self:setProcessedEntryIndicator(oOrgUse,nI,.T.)
            self:setProcessedEntryIndicator(oNowUse,nMatch,.T.)
            
            aNowRow     := aComposeCurrent[nMatch]
            cCodEspAt   := self:extractCurrentRowFieldValue(aOrgRow,aComposeFields,"BAX_CODESP")
            cCodSubAt   := self:extractCurrentRowFieldValue(aOrgRow,aComposeFields,"BAX_CODSUB")
            cCodEspNo   := self:extractCurrentRowFieldValue(aNowRow,aComposeFields,"BAX_CODESP")
            cCodSubNo   := self:extractCurrentRowFieldValue(aNowRow,aComposeFields,"BAX_CODSUB")
            nSeq        := 0
            cEvento     := ""

            For nJ := 1 To nLnFlds
                cValAnt := self:normalizeValueForHistoryStorage(aComposeFields[nJ][1],aComposeFields[nJ][2],aOrgRow[aComposeFields[nJ][3]])
                cValNov := self:normalizeValueForHistoryStorage(aComposeFields[nJ][1],aComposeFields[nJ][2],aNowRow[aComposeFields[nJ][3]])

                If cValAnt == cValNov
                    Loop
                EndIf

                If Empty(cEvento)
                    nEvt++
                    cEvento := cBaseEvt + StrZero(nEvt,6)
                EndIf

                nSeq++
                AAdd(aPend,self:createHistoryPendingPayload( ;
                    cComposeMember, ;
                    cComposeContract, ;
                    cComposeLocation, ;
                    cCodEspAt, ;
                    cCodSubAt, ;
                    cCodEspNo, ;
                    cCodSubNo, ;
                    "A", ;
                    aComposeFields[nJ][1], ;
                    aComposeFields[nJ][2], ;
                    cValAnt, ;
                    cValNov, ;
                    cEvento, ;
                    nSeq ))
            Next
        EndIf
    Next

    nLMax := Max(nLnOrg, nLnNow)

    For nI := 1 To nLMax
        aOrgRow := {}
        aNowRow := {}
        lOrgOk  := .F.
        lNowOk  := .F.

        If nI <= nLnOrg
            aOrgRow := aComposeOriginal[nI]
            lOrgOk  := !self:getProcessedEntryIndicator(oOrgUse,nI) .And. ValType(aOrgRow) == "A" .And. Len(aOrgRow) > 0 .And. !ATail(aOrgRow)
        EndIf

        If nI <= nLnNow
            aNowRow := aComposeCurrent[nI]
            lNowOk  := !self:getProcessedEntryIndicator(oNowUse,nI) .And. ValType(aNowRow) == "A" .And. Len(aNowRow) > 0 .And. !ATail(aNowRow)
        EndIf

        If lOrgOk .And. lNowOk
            
            self:setProcessedEntryIndicator(oOrgUse,nI,.T.)
            self:setProcessedEntryIndicator(oNowUse,nI,.T.)

            cCodEspAt := self:extractCurrentRowFieldValue(aOrgRow,aComposeFields,"BAX_CODESP")
            cCodSubAt := self:extractCurrentRowFieldValue(aOrgRow,aComposeFields,"BAX_CODSUB")
            cCodEspNo := self:extractCurrentRowFieldValue(aNowRow,aComposeFields,"BAX_CODESP")
            cCodSubNo := self:extractCurrentRowFieldValue(aNowRow,aComposeFields,"BAX_CODSUB")
            nSeq      := 0
            cEvento   := ""

            For nJ := 1 To nLnFlds
                
                cValAnt := self:normalizeValueForHistoryStorage(aComposeFields[nJ][1],aComposeFields[nJ][2],aOrgRow[aComposeFields[nJ][3]])
                cValNov := self:normalizeValueForHistoryStorage(aComposeFields[nJ][1],aComposeFields[nJ][2],aNowRow[aComposeFields[nJ][3]])

                If cValAnt == cValNov
                    Loop
                EndIf

                If Empty(cEvento)
                    nEvt++
                    cEvento := cBaseEvt + StrZero(nEvt,6)
                EndIf

                nSeq++
                AAdd(aPend,self:createHistoryPendingPayload( ;
                    cComposeMember, ;
                    cComposeContract, ;
                    cComposeLocation, ;
                    cCodEspAt, ;
                    cCodSubAt, ;
                    cCodEspNo, ;
                    cCodSubNo, ;
                    "A", ;
                    aComposeFields[nJ][1], ;
                    aComposeFields[nJ][2], ;
                    cValAnt, ;
                    cValNov, ;
                    cEvento, ;
                    nSeq ))
            Next
        EndIf
    Next

    For nI := 1 To nLnNow

        If self:getProcessedEntryIndicator(oNowUse,nI)
            Loop
        EndIf

        aNowRow := aComposeCurrent[nI]
        lNowOk  := ValType(aNowRow) == "A" .And. Len(aNowRow) > 0 .And. !ATail(aNowRow)

        If !lNowOk
            Loop
        EndIf

        cCodEspNo := self:extractCurrentRowFieldValue(aNowRow,aComposeFields,"BAX_CODESP")
        cCodSubNo := self:extractCurrentRowFieldValue(aNowRow,aComposeFields,"BAX_CODSUB")
        nSeq      := 0
        cEvento   := ""

        For nJ := 1 To nLnFlds

            cValNov := self:normalizeValueForHistoryStorage(aComposeFields[nJ][1],aComposeFields[nJ][2],aNowRow[aComposeFields[nJ][3]])

            If !self:hasRelevantValueForHistory(aComposeFields[nJ][2],cValNov)
                Loop
            EndIf

            If Empty(cEvento)
                nEvt++
                cEvento := cBaseEvt + StrZero(nEvt,6)
            EndIf

            nSeq++
            AAdd(aPend,self:createHistoryPendingPayload( ;
                cComposeMember, ;
                cComposeContract, ;
                cComposeLocation, ;
                "", ;
                "", ;
                cCodEspNo, ;
                cCodSubNo, ;
                "I", ;
                aComposeFields[nJ][1], ;
                aComposeFields[nJ][2], ;
                "", ;
                cValNov, ;
                cEvento, ;
                nSeq ))
        Next
    Next

Return aPend

////////////////////////////////////////////////////////////////////
/*/{Protheus.doc} extractCurrentRowFieldValue
Retorna o valor de um campo em uma linha da grade.
@since 01/04/2026
@param aExtractRowData, array, Current specialty row.
@param aExtractFields, array, Monitored field definitions.
@param cExtractFieldName, caractere, Field identifier name.
@return xFieldValue, variavel, Retorna o valor do campo na linha.
/*/
Method extractCurrentRowFieldValue(aExtractRowData as Array, aExtractFields as Array, cExtractFieldName as Character) as Variant Class SpecialtyHistoryAuditService
    
    Local nPos := Ascan(aExtractFields,{|aItem| aItem[1] == cExtractFieldName})
    
    Default aExtractRowData  := {}
    Default aExtractFields   := {} 
    Default cExtractFieldName := ""


    If nPos > 0 .And. aExtractFields[nPos][3] <= Len(aExtractRowData)
        Return aExtractRowData[aExtractFields[nPos][3]]
    EndIf

Return

////////////////////////////////////////////////////////////////////
/*/{Protheus.doc} hasRelevantValueForHistory
Verifica se o valor informado deve ser considerado na comparacao.
@since 01/04/2026
@param cRelevantTypeId, caractere, Field data type code.
@param cRelevantValueTx, caractere, Stored value content.
@return lRet, logico, Retorna se o valor deve ser considerado.
/*/
Method hasRelevantValueForHistory(cRelevantTypeId as Character, cRelevantValueTx as Character) as Logical Class SpecialtyHistoryAuditService
    
    Default cRelevantTypeId := ""
    Default cRelevantValueTx := ""

    Do Case
        Case cRelevantTypeId == "C"
            Return !Empty(AllTrim(cRelevantValueTx))
        
        Case cRelevantTypeId == "D"
            Return !Empty(cRelevantValueTx)
        
        Case cRelevantTypeId == "N"
            Return !Empty(cRelevantValueTx) .And. Val(cRelevantValueTx) <> 0
    EndCase

Return .F.

////////////////////////////////////////////////////////////////////
/*/{Protheus.doc} normalizeValueForHistoryStorage
Normaliza o valor do campo para gravacao no historico.
@since 01/04/2026
@param cNormalizeField, caractere, Field identifier name.
@param cNormalizeType, caractere, Field data type code.
@param xNormalizeSource, variavel, Source field value.
@return cValor, caractere, Retorna o valor normalizado para persistencia.
/*/
Method normalizeValueForHistoryStorage(cNormalizeField as Character, cNormalizeType as Character, xNormalizeSource as Variant) as Character Class SpecialtyHistoryAuditService
   
    Local cValor := ""
    Local cData  := ""
    Local aTam   := {}

    Default cNormalizeField  := ""
    Default cNormalizeType   := ""
    Default xNormalizeSource := NIL

    Do Case
        Case cNormalizeType == "C"
            If ValType(xNormalizeSource) == "C"
                cValor := RTrim(xNormalizeSource)
            EndIf
        
        Case cNormalizeType == "D"
        
            If ValType(xNormalizeSource) == "D" .And. !Empty(xNormalizeSource)
                cValor := Dtos(xNormalizeSource)
        
            ElseIf ValType(xNormalizeSource) == "C"
                cData := AllTrim(xNormalizeSource)

                If !Empty(cData)
                    cData := StrTran(cData,"-","")
                    cData := StrTran(cData,"/","")

                    If Len(cData) == 8
        
                        If Val(SubStr(cData,1,4)) >= 1900
                            cValor := cData
                        Else
                            cValor := SubStr(cData,5,4) + SubStr(cData,3,2) + SubStr(cData,1,2)
                        EndIf
                    EndIf
                EndIf
            EndIf
        
        Case cNormalizeType == "N"
        
            If ValType(xNormalizeSource) == "N"
                aTam   := TamSX3(cNormalizeField)
                cValor := AllTrim(Str(xNormalizeSource,aTam[1],aTam[2]))
                cValor := StrTran(cValor,",",".")
            EndIf
    EndCase

Return Left(cValor,120)

////////////////////////////////////////////////////////////////////
/*/{Protheus.doc} buildSpecialtyCompositeKey
Monta a chave da especialidade e subespecialidade.
@since 01/04/2026
@param cCompositeSpec, caractere, Specialty identifier code.
@param cCompositeSubs, caractere, Subspecialty identifier code.
@return cKey, caractere, Retorna a chave da especialidade e subespecialidade.
/*/
Method buildSpecialtyCompositeKey(cCompositeSpec as Character, cCompositeSubs as Character) as Character Class SpecialtyHistoryAuditService
   
    Default cCompositeSpec := ""
    Default cCompositeSubs := ""

Return PadR(AllTrim(cCompositeSpec),3) + PadR(AllTrim(cCompositeSubs),3)

////////////////////////////////////////////////////////////////////
/*/{Protheus.doc} resolveAuditUserIdentifier
Retorna o usuario corrente para auditoria.
@since 01/04/2026
@return cUser, caractere, Retorna o codigo do usuario corrente.
/*/
Method resolveAuditUserIdentifier() as Character Class SpecialtyHistoryAuditService
    
    Local cUser := ""

    If Type("__cUserID") <> "U"
        cUser := AllTrim(&("__cUserID"))
    EndIf

Return Left(cUser,30)

////////////////////////////////////////////////////////////////////
/*/{Protheus.doc} assignBlvFieldStorageValue
Atribui um valor ao campo atual da BLV.
@since 01/04/2026
@param cAssignFieldNm, caractere, Field identifier name.
@param xAssignPayload, variavel, Assigned field value.
@return Nil, indefinido, Nao retorna valor.
/*/
Method assignBlvFieldStorageValue(cAssignFieldNm as Character, xAssignPayload as Variant) as Variant Class SpecialtyHistoryAuditService
    
    Local nPos := FieldPos(cAssignFieldNm)

    Default cAssignFieldNm := ""
    Default xAssignPayload := ""

    If nPos > 0
        FieldPut(nPos,xAssignPayload)
    EndIf

Return Nil

////////////////////////////////////////////////////////////////////
/*/{Protheus.doc} createHistoryPendingPayload
Cria o objeto de pendencia que sera gravado na BLV.
@since 01/04/2026
@param cPayloadMember, caractere, Member identifier code.
@param cPayloadCntrct, caractere, Contract identifier code.
@param cPayloadLocati, caractere, Location identifier code.
@param cPayloadCurrSp, caractere, Current specialty code.
@param cPayloadCurrSb, caractere, Current subspecialty code.
@param cPayloadNewSpc, caractere, New specialty code.
@param cPayloadNewSub, caractere, New subspecialty code.
@param cPayloadEvtTyp, caractere, Event type code.
@param cPayloadFieldN, caractere, Field identifier name.
@param cPayloadFieldT, caractere, Field data type code.
@param cPayloadPrevVl, caractere, Previous field value.
@param cPayloadCurrVl, caractere, Current field value.
@param cPayloadEvtNum, caractere, Event identifier code.
@param nPayloadSeqNo, numerico, Sequence item number.
@return xPendingPayload, variavel, Retorna o objeto com os dados da pendencia.
/*/
Method createHistoryPendingPayload(cPayloadMember as Character, cPayloadCntrct as Character, cPayloadLocati as Character, cPayloadCurrSp as Character, cPayloadCurrSb as Character, cPayloadNewSpc as Character, cPayloadNewSub as Character, ;
                                   cPayloadEvtTyp as Character, cPayloadFieldN as Character, cPayloadFieldT as Character, cPayloadPrevVl as Character, cPayloadCurrVl as Character, cPayloadEvtNum as Character, nPayloadSeqNo as Numeric) as Variant Class SpecialtyHistoryAuditService
    
    Local oPend     := JsonObject():New()
    Local cTipoEvt  := Upper(AllTrim(cPayloadEvtTyp))
    Local cTipoCamp := Upper(AllTrim(cPayloadFieldT))

    Default cPayloadMember := ""
    Default cPayloadCntrct := ""
    Default cPayloadLocati := ""
    Default cPayloadCurrSp := ""
    Default cPayloadCurrSb := ""
    Default cPayloadNewSpc := ""
    Default cPayloadNewSub := ""
    Default cPayloadEvtTyp := ""
    Default cPayloadFieldN := ""
    Default cPayloadFieldT := ""
    Default cPayloadPrevVl := ""
    Default cPayloadCurrVl := ""
    Default cPayloadEvtNum := ""
    Default nPayloadSeqNo  := 0

    Do Case
        Case cTipoEvt == "I" .Or. cTipoEvt == "1"
            cTipoEvt := "1"
        
        Case cTipoEvt == "A" .Or. cTipoEvt == "2"
            cTipoEvt := "2"
    EndCase

    Do Case
        Case cTipoCamp == "C" .Or. cTipoCamp == "1"
            cTipoCamp := "1"
        
        Case cTipoCamp == "D" .Or. cTipoCamp == "2"
            cTipoCamp := "2"
        
        Case cTipoCamp == "N" .Or. cTipoCamp == "3"
            cTipoCamp := "3"
    EndCase

    oPend["codigo"] := AllTrim(cPayloadMember)
    oPend["codint"] := cPayloadCntrct
    oPend["codloc"] := cPayloadLocati
    oPend["cespat"] := cPayloadCurrSp
    oPend["cespno"] := cPayloadNewSpc
    oPend["tpevto"] := cTipoEvt
    oPend["campo" ] := cPayloadFieldN
    oPend["tpcam" ] := cTipoCamp
    oPend["valant"] := cPayloadPrevVl
    oPend["valnov"] := cPayloadCurrVl
    oPend["evento"] := cPayloadEvtNum
    oPend["seq"   ] := nPayloadSeqNo

Return oPend

////////////////////////////////////////////////////////////////////
/*/{Protheus.doc} getProcessedEntryIndicator
Retorna o indicador de uso de um campo no array de controle.
@since 01/04/2026
@param xTrackerReadr, variavel, Usage tracker payload.
@param nTrackerIndex, numerico, Entry index number.
@return lEntryUsedFlag, logico, Retorna o indicador de uso do item informado.
/*/
Method getProcessedEntryIndicator(xTrackerReadr as Variant, nTrackerIndex as Numeric) as Logical Class SpecialtyHistoryAuditService
    
    Local cKey := StrZero(nTrackerIndex,6)
    Local aKeys := {}

    Default xTrackerReadr := NIL
    Default nTrackerIndex := 0

    If ValType(xTrackerReadr) $ "OJ"
        aKeys := xTrackerReadr:GetNames()
    EndIf

    If Ascan(aKeys,cKey) > 0
        Return xTrackerReadr[cKey]
    EndIf

Return .F.

////////////////////////////////////////////////////////////////////
/*/{Protheus.doc} setProcessedEntryIndicator
Atualiza o indicador de uso de um campo no array de controle.
@since 01/04/2026
@param xTrackerWrite, variavel, Usage tracker payload.
@param nWriterIndex, numerico, Entry index number.
@param lWriterUsage, logico, Entry usage flag.
@return Nil, indefinido, Nao retorna valor.
/*/
Method setProcessedEntryIndicator(xTrackerWrite as Variant, nWriterIndex as Numeric, lWriterUsage as Logical) as Variant Class SpecialtyHistoryAuditService

    Local cKey := StrZero(nWriterIndex,6)

    Default xTrackerWrite := NIL
    Default nWriterIndex := 0
    Default lWriterUsage := .F.

    xTrackerWrite[cKey] := lWriterUsage

Return Nil
