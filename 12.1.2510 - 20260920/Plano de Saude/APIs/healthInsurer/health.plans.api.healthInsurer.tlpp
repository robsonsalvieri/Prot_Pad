#Include "PROTHEUS.CH"
#Include "TOTVS.CH"
#Include 'tlpp-core.th'
#Include 'tlpp-rest.th'

//-------------------------------------------------------------------
/*/{Protheus.doc} PlsTaeWebhookReceiver
Endpoint REST para receber callbacks (webhooks) do TOTVS Assinatura 
Eletrônica. Quando o status de uma publicação muda (documento 
assinado, rejeitado, etc.), o TAE envia um POST para este endpoint.

Este endpoint deve estar acessível externamente (internet) para que
o TAE consiga enviar as notificações.

@author  Carolina Médici
@version P12
@since   29/06/2026
@see     PLSTotvsSign
/*/
//-------------------------------------------------------------------
@Get("/totvshealthplans/v1/healthInsurer")
Function PlsGetHealthInsurer()

    Local jResponse  as json  
    Local nStatus    := 200 as numeric
    Local lSuccess   := .T. as logical

    jResponse := JsonObject():new()

    oRest:appendKeyHeaderResponse("Content-Type", "application/json")
    BA0->(dbSetOrder(1))
    BA0->(MsSeek(xFilial("BA0") + PLSIntPad()))
   
    jResponse['codIde']:= alltrim(BA0->BA0_CODIDE)
    jResponse['codInt']:= alltrim(BA0->BA0_CODINT)
    jResponse["nome"]:= alltrim(BA0->BA0_NOMINT)
    jResponse["abrang"]:= alltrim(BA0->BA0_ABRANG)
    jResponse["susep"]:= alltrim(BA0->BA0_SUSEP)
    jResponse["endPoint"]:= alltrim(BA0->BA0_ENDPOI)
    jResponse["address"]:= alltrim(BA0->BA0_END) 
    jResponse["numberAddress"]:= alltrim(BA0->BA0_NUMEND) 
    jResponse["ZIPCode"]:= alltrim(BA0->BA0_CEP) 
    jResponse["district"]:= alltrim(BA0->BA0_BAIRRO) 
    jResponse["city"]:= alltrim(BA0->BA0_CIDADE)
    jResponse["state"]:= BA0->BA0_EST 
    jResponse["tissVersion"]:= alltrim(BA0->BA0_TISVER)        

    oRest:setStatusCode(nStatus)
    oRest:setResponse(jResponse:toJson())
    
    FreeObj(jResponse)
    jResponse := Nil
    delClassIntf()
Return
