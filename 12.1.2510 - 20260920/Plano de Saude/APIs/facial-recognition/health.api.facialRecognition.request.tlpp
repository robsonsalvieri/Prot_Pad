Method postAwsCompare() class HealthFacialRecognitionRequest
    local cAwsBody  := ""
    local oJsonRet  := jsonObject():new()
    local jAwsRet   := jsonObject():new()
    local oJsonIpaas:= jsonObject():new()
    local nSimilary := 0
    local lMatch    := .f.

    oJsonIpaas['SourceImage'] := jsonObject():new()
    oJsonIpaas['SourceImage']['Bytes'] := cvaltochar(self:jRequest['imagemReferencia'])
    
    oJsonIpaas['TargetImage'] := jsonObject():new()
    oJsonIpaas['TargetImage']['Bytes'] := cvaltochar(self:jRequest['imagemCapturada'])
    
    oJsonIpaas['SimilarityThreshold'] := val(cvaltochar(self:jRequest['similaridadeMinimaMatch']))

    cAwsBody := oJsonIpaas:toJson()

    self:aHeader := {}
    aadd(self:aHeader, "Content-Type: application/x-amz-json-1.1")
    aadd(self:aHeader, "X-Amz-Target: RekognitionService.CompareFaces")

    self:oFWRest := FWRest():New(cvaltochar(self:jRequest['awsUrl']))
    self:oFWRest:setPath('')
    self:oFWRest:setPostParams(cAwsBody)

    self:lSuccess := self:oFWRest:post(self:aHeader)
    
    self:nStatus  := val(cvaltochar(self:oFWRest:getHttpCode()))

    if self:lSuccess .And. self:nStatus == 200
        jAwsRet:FromJson(self:oFWRest:getResult())
        
        If ValType(jAwsRet) == "J" .And. len(jAwsRet['FaceMatches']) > 0
            nSimilary := jAwsRet['FaceMatches'][1]['Similarity']
            If nSimilary >= val(cvaltochar(self:jRequest['similaridadeMinimaMatch']))
                lMatch := .t.
            EndIf
        EndIf

        oJsonRet['match']      := lMatch
        oJsonRet['similarity'] := nSimilary
        oJsonRet['success']    := .t.
    endif

    self:cResponse := oJsonRet:toJson()

    FreeObj(oJsonIpaas)
    FreeObj(oJsonRet)
    FreeObj(jAwsRet)

Return self:lSuccess

Method CreateFaceLivenessSession() class HealthFacialRecognitionRequest
    local cAwsBody  := ""
    local aPreferences := {}
    local oJsonAws  := jsonObject():new()
    local oPreference  := jsonObject():new()

    oJsonAws['ClientRequestToken'] := cvaltochar(self:jRequest['subscriberId']) + strTran(time(),":","")

    oJsonAws['Settings'] := jsonObject():new()
    oJsonAws['Settings']['AuditImagesLimit'] := 0
    if !self:jRequest['mobile']
        oPreference['Type'] := 'FaceMovementChallenge'
        aadd(aPreferences, oPreference)
        oJsonAws['Settings']['ChallengePreferences'] := aPreferences
    endif
    cAwsBody := oJsonAws:toJson()

    self:aHeader := {}
    aadd(self:aHeader, "Content-Type: application/x-amz-json-1.1")
    aadd(self:aHeader, "X-Amz-Target: RekognitionService.CreateFaceLivenessSession")

    self:oFWRest := FWRest():New(cvaltochar(self:jRequest['awsUrl']))
    self:oFWRest:setPath('')
    self:oFWRest:setPostParams(cAwsBody)
    
    self:lSuccess := self:oFWRest:post(self:aHeader)
    self:nStatus  := val(cvaltochar(self:oFWRest:getHttpCode()))
    self:cResponse := self:oFWRest:getResult()

    if !self:lSuccess .Or. self:nStatus != 200
        self:cFaultDesc := 'Erro ao comunicar com a URL para criação de sessão Liveness.'
    endif

    FreeObj(oJsonAws)

Return self:lSuccess

Method GetFaceLivenessSessionCredentials() class HealthFacialRecognitionRequest
    local cStsBody   := ""
    local oJsonSts   := jsonObject():new()
    local jStsRet    := jsonObject():new()
    local oJsonRet   := jsonObject():new()
    local cStsUrl    := cvaltochar(self:jRequest['stsUrl'])
    local cRoleArn   := cvaltochar(self:jRequest['roleArn'])
    local cSession   := cvaltochar(self:jRequest['subscriberId'])

    if empty(cSession)
        cSession := "LivenessSTS"
    endif

    oJsonSts['Action']          := "AssumeRole"
    oJsonSts['Version']         := "2011-06-15"
    oJsonSts['DurationSeconds'] := "900"
    oJsonSts['RoleSessionName'] := cSession
    oJsonSts['RoleArn']         := cRoleArn

    cStsBody := oJsonSts:toJson()

    self:aHeader := {}
    aadd(self:aHeader, "Content-Type: application/json")

    self:oFWRest := FWRest():New(cStsUrl)
    self:oFWRest:setPath('')
    self:oFWRest:setPostParams(cStsBody)

    self:lSuccess := self:oFWRest:post(self:aHeader)
    self:nStatus  := val(cvaltochar(self:oFWRest:getHttpCode()))
    self:cResponse := self:oFWRest:getResult()

    if self:lSuccess .And. self:nStatus == 200
        jStsRet:FromJson(self:cResponse)

        if ValType(jStsRet['result']['AssumeRoleResponse']) == "J"

            oJsonRet['accessKeyId']     := cvaltochar(jStsRet['result']['AssumeRoleResponse']['AssumeRoleResult']['Credentials']['AccessKeyId'])
            oJsonRet['secretAccessKey'] := cvaltochar(jStsRet['result']['AssumeRoleResponse']['AssumeRoleResult']['Credentials']['SecretAccessKey'])
            oJsonRet['sessionToken']    := cvaltochar(jStsRet['result']['AssumeRoleResponse']['AssumeRoleResult']['Credentials']['SessionToken'])
            self:cResponse := oJsonRet:ToJson()
        endif
    endif

    FreeObj(oJsonSts)
    FreeObj(jStsRet)
    FreeObj(oJsonRet)

Return self:lSuccess

Method GetFaceLivenessSessionResult() class HealthFacialRecognitionRequest
    local cAwsBody    := ""
    local oJsonAws    := jsonObject():new()
    local jAwsRet     := jsonObject():new()
    local cSessionId  := cvaltochar(self:jRequest['sessionId'])
    local nMinScore   := val(cvaltochar(self:jRequest['similaridadeMinimaLiveness']))
    local nConfidence := 0

    oJsonAws['SessionId'] := cSessionId
    cAwsBody := oJsonAws:toJson()

    self:aHeader := {}
    aadd(self:aHeader, "Content-Type: application/x-amz-json-1.1")
    aadd(self:aHeader, "X-Amz-Target: RekognitionService.GetFaceLivenessSessionResults")

    self:oFWRest := FWRest():New(cvaltochar(self:jRequest['awsUrl']))
    self:oFWRest:setPath('')
    self:oFWRest:setPostParams(cAwsBody)

    self:lSuccess := self:oFWRest:post(self:aHeader)
    self:nStatus   := val(cvaltochar(self:oFWRest:getHttpCode()))
    self:cResponse := self:oFWRest:getResult()

    if self:lSuccess .And. self:nStatus == 200
        
        jAwsRet:FromJson(self:cResponse)

        if ValType(jAwsRet) == "J"
            if cvaltochar(jAwsRet['Status']) == "SUCCEEDED"
                
                nConfidence := jAwsRet['Confidence']

                if nConfidence < nMinScore
                    self:lSuccess   := .f.
                    self:nStatus    := 400
                    self:cFaultDesc := "Prova de vida reprovada. A confiança (" + cvaltochar(nConfidence) + ") foi menor que o mínimo exigido (" + cvaltochar(nMinScore) + ")."
                endif
            endif
        endif
    endif

    FreeObj(oJsonAws)
    FreeObj(jAwsRet)

Return self:lSuccess



// E1  GET /card/integration/mainimage (via webhook do iPaaS). Repassa os 29 campos do
// BioDoc e acrescenta livenessSupported + provider. Nenhum Authorization de BioDoc aqui 
// o Bearer e injetado pelo iPaaS (DEC-07). idCard vai no corpo porque o iPaaS monta a query
// string do BioDoc a partir dele.
Method getBiodocStatus() class HealthFacialRecognitionRequest
    local oJsonBody  := jsonObject():new()
    local jRet       := jsonObject():new()
    local lLivenessActive := .f.
    local cLivenessVersion:= ""

    oJsonBody['idCard'] := cvaltochar(self:jRequest['subscriberId'])

    self:aHeader := {}
    aadd(self:aHeader, "Content-Type: application/json")
    aadd(self:aHeader, "X-Biodoc-Target: BiodocService.GetMainImage")

    self:oFWRest := FWRest():New(cvaltochar(self:jRequest['endpointBiodoc']))
    self:oFWRest:setPath('')
    self:oFWRest:setPostParams(oJsonBody:toJson())
    self:oFWRest:SetTimeOut(30)

    self:lSuccess := self:oFWRest:post(self:aHeader)
    self:nStatus  := val(cvaltochar(self:oFWRest:getHttpCode()))
    self:cResponse:= self:oFWRest:getResult()

    if self:lSuccess .and. self:nStatus == 200
        jRet:fromJson(self:cResponse)

        // Tolerancia ao envelope do iPaaS: o fluxo de STS embrulha em 'result', o de
        // Rekognition nao. O fluxo do BioDoc pode vir de qualquer jeito (contract.md #2.1.1).
        if ValType(jRet) == "J" .and. ValType(jRet['result']) == "J"
            jRet := jRet['result']
        endif

        if ValType(jRet) == "J"
            lLivenessActive  := jRet['livenessActive'] == .t.
            cLivenessVersion := cvaltochar(jRet['livenessVersion'])

            jRet['livenessSupported'] := lLivenessActive .and. cLivenessVersion == "1.0"
            jRet['provider']          := "BIODOC"

            self:cResponse := jRet:toJson()
        endif
    else
        self:tratarErroBiodoc()
    endif

    FreeObj(oJsonBody)
    FreeObj(jRet)

Return self:lSuccess

// E2  POST /integrations/verify (via webhook do iPaaS). Repassa o payload do BioDoc e
// acrescenta similarity (percentage convertido para numero) + provider. Nao recalcula
// veredito  o criterio composto (DEC-02) e do frontend.
Method postBiodocVerify() class HealthFacialRecognitionRequest
    local oJsonBody  := jsonObject():new()
    local jRet       := jsonObject():new()
    local jResponse  := jsonObject():new()


    oJsonBody['id']    := cvaltochar(self:jRequest['subscriberId'])
    oJsonBody['image'] := cvaltochar(self:jRequest['image'])


    oJsonBody['detail'] := jsonObject():new()
    oJsonBody['detail']['origin'] := "HAT"


    self:aHeader := {}
    aadd(self:aHeader, "Content-Type: application/json")
    aadd(self:aHeader, "X-Biodoc-Target: BiodocService.Verify")


    self:oFWRest := FWRest():New(cvaltochar(self:jRequest['endpointBiodoc']))
    self:oFWRest:setPath('')
    self:oFWRest:setPostParams(oJsonBody:toJson())
    self:oFWRest:SetTimeOut(30)


    self:lSuccess := self:oFWRest:post(self:aHeader)
    self:nStatus  := val(cvaltochar(self:oFWRest:getHttpCode()))
    self:cResponse:= self:oFWRest:getResult()


    if self:lSuccess .and. self:nStatus == 200
        jResponse:fromJson(self:cResponse)

        if ValType(jResponse) == "J"
            if ValType(jResponse['result']['response']) == "J"
                jRet['success']    := jResponse['result']['response']['success']
                jRet['percentage'] := jResponse['result']['response']['percentage']
                jRet['message']    := jResponse['result']['response']['message']
            endif


            // percentage vem como string com '%' (ex: "100.00%") - converte para numero.
            jRet['similarity'] := val(strTran(cvaltochar(jRet['percentage']), '%', ''))
            jRet['provider']   := "BIODOC"


            self:cResponse := jRet:toJson()
        endif
    else
        self:tratarErroBiodoc()
    endif


    FreeObj(oJsonBody)
    FreeObj(jRet)


Return self:lSuccess

// Mapeia o erro do provedor/iPaaS para cFaultDesc + nStatus, distinguindo a camada que
// falhou (iPaaS x BioDoc), conforme contract.md #2.4. Envelope de erro do BioDoc e
// {error, code} - nao {message}.
Method tratarErroBiodoc() class HealthFacialRecognitionRequest
    local cErro     := ""
    local cCode     := ""
    local jErro     := jsonObject():new()

    jErro:fromJson(self:cResponse)
    if ValType(jErro) == "J"
        cErro := cvaltochar(jErro['error'])
        cCode := cvaltochar(jErro['error']['code'])
        self:nStatus := val(cvaltochar(jErro['status']))
    endif

    do case
    case self:nStatus == 401 .or. cCode == "ERR_MDW_INVALID_BEARER"
        self:cFaultDesc := 'Credencial do BioDoc invalida - verificar token e padding no iPaaS.'
        self:nStatus := 401
    otherwise
        self:cFaultDesc := 'Falha de comunicacao com o gateway (iPaaS/BioDoc).'
        self:nStatus := 502
    endcase

    self:lSuccess := .f.

    FreeObj(jErro)

Return

Method postBiodocRegister() class HealthFacialRecognitionRequest
    local oJsonBody  := jsonObject():new()
    local jRet       := jsonObject():new()

    BA1->(dbsetorder(2))
    BA1->(msseek(xfilial("BA1")+self:jRequest['subscriberId']))
    
    oJsonBody['id']    := cvaltochar(self:jRequest['subscriberId'])
    oJsonBody['name']  := alltrim(BA1->BA1_NOMUSR)
    oJsonBody['image'] := cvaltochar(self:jRequest['image'])
    
    oJsonBody['detail'] := jsonObject():new()
    oJsonBody['detail']['origin'] := "HAT"

    self:aHeader := {}
    aadd(self:aHeader, "Content-Type: application/json")
    aadd(self:aHeader, "X-Biodoc-Target: BiodocService.Register")

    self:oFWRest := FWRest():New(cvaltochar(self:jRequest['endpointBiodoc']))
    self:oFWRest:setPath('')
    self:oFWRest:setPostParams(oJsonBody:toJson())
    self:oFWRest:SetTimeOut(30)

    self:lSuccess := self:oFWRest:post(self:aHeader)
    self:nStatus  := val(cvaltochar(self:oFWRest:getHttpCode()))
    self:cResponse:= self:oFWRest:getResult()

    if self:lSuccess .and. self:nStatus == 200
        jRet:fromJson(self:cResponse)

        if ValType(jRet) == "J" .and. ValType(jRet['result']) == "J"
            jRet := jRet['result']
        endif

        if ValType(jRet) == "J"
            jRet['provider'] := "BIODOC"
            self:cResponse := jRet:toJson()
        endif
    else
        self:tratarErroBiodoc()
    endif

    FreeObj(oJsonBody)
    FreeObj(jRet)
Return self:lSuccess
