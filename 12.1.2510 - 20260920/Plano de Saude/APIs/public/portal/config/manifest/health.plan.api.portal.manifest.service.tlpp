#include "tlpp-core.th"
#include "health.plan.api.portal.manifest.service.ch"

#define STATUS_CODE_OK 200
#define STATUS_CODE_BAD_REQUEST 400

#define CONFIG_FILE_DIR "portais-saude\"

namespace totvs.protheus.health.plan.api.portal.config

using namespace totvs.protheus.health.plans.api.util

/*/{Protheus.doc} ManifestService
Classe responsável por gerenciar a lógica de carregamento e fornecimento do manifesto de configuração do portal de saúde.
@type class
@version 12.1.2610
@author vinicius.queiros
@since 03/03/2026
*/
class ManifestService from BaseService

    public method new() constructor
    public method destroy()
    public method getManifest() as logical

    private method loadConfigFile() as logical

endclass

/*/{Protheus.doc} new
Construtor da classe ManifestService. Inicializa a instância do serviço de manifesto.
@type method
@version 12.1.2610
@author vinicius.queiros
@since 03/03/2026
@return object, Instância inicializada do serviço
*/
method new() class ManifestService

    _Super:new()

return self

/*/{Protheus.doc} destroy
Destrutor da classe ManifestService. Libera recursos e finaliza a instância do serviço de manifesto.
@type method
@version 12.1.2610
@author vinicius.queiros
@since 03/03/2026
*/
method destroy() class ManifestService

    _Super:destroy()

return

/*/{Protheus.doc} getManifest
Executa a rotina para carregar o manifesto de configuração do portal de saúde.
@type method
@version 12.1.2610
@author vinicius.queiros
@since 03/03/2026
@return logical, Indica se o manifesto foi carregado com sucesso
*/
method getManifest() as logical class ManifestService

    local lSuccess := .F. as logical

    if self:loadConfigFile()
		self:nCodeStatus := STATUS_CODE_OK

        lSuccess := .T.
    endif
    
return lSuccess

/*/{Protheus.doc} loadConfigFile
Carrega o arquivo de configuração do portal de saúde e armazena o resultado na instância.
@type method
@version 12.1.2610
@author vinicius.queiros
@since 03/03/2026
@return logical, Indica se o arquivo de configuração foi carregado com sucesso
*/
method loadConfigFile() as logical class ManifestService

    local jConfig := JsonObject():new() as json
    local xError as variant
    local lResult := .F. as logical
    local cFileDir := CONFIG_FILE_DIR as character

    do case
        case self:jParams["typePortal"] == "company"
            cFileDir += "portal-empresa\"
       
        case self:jParams["typePortal"] == "beneficiary"
            cFileDir += "portal-beneficiario\"
    endcase

    xError := jConfig:fromJsonFile(cFileDir + "app-config.json")

    if valType(xError) == "U"
        self:jResult := jConfig
        lResult := .T.
    else
        // STR0001: "Erro ao carregar o arquivo de configuração" 
        // STR0002: "Falha ao tentar ler o arquivo de configuração"   
        self:setError("", STR0001, STR0002 + " '" + cFileDir + "app-config.json'. Erro: " + xError, STATUS_CODE_BAD_REQUEST)
    endif

    freeObj(jConfig)

return lResult
