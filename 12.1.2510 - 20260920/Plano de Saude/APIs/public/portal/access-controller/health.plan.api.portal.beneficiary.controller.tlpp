/*/{Protheus.doc} getBeneficiariesCard
Obtém os dados do cartão do beneficiário através da API.
@version 12.1.2510
@author luca.spiller
@since 05/11/2025
/*/
method getBeneficiariesCard() class BeneficiaryController

	local oController as object
	
	if self:validateRequiredParams(oRest:getPathParamsRequest(), {"subscriberId"})
		if self:validatePortalUserAccess() .and. self:hasAccessToBeneficiary(oRest:getPathParamsRequest()["subscriberId"])
			oController := totvs.protheus.health.plan.api.familycontract.BeneficiaryCardController():new()
			oController:apiGetCard()
		endif
	endif

	freeObj(oController)
	self:destroy()

return
