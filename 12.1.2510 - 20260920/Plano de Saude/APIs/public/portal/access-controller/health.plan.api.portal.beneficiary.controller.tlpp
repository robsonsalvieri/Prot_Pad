#include "tlpp-core.th"
#include "tlpp-rest.th"

namespace totvs.protheus.health.plan.api.portal.access

using namespace totvs.protheus.health.plan.api.util

/*/{Protheus.doc} BeneficiaryController
Classe responsável por gerenciar os acessos ao cadastro de beneficiários
@type class
@version 12.1.2510  
@author vinicius.queiros
@since 03/04/2025
*/
class BeneficiaryController from BaseController

	public method new() constructor

	@GET("/totvsHealthPlans/portal/v1/beneficiaries")
	public method apiGetBeneficiaries()

	@GET("/totvsHealthPlans/portal/v1/beneficiaries/:subscriberId/supplementaryHealth")
	public method apiGetSupplementary()

	@GET("/totvsHealthPlans/portal/v1/beneficiaries/:subscriberId/eligibility")
	public method apiGetElegibility()

	@GET("/totvsHealthPlans/portal/v1/beneficiaries/:subscriberId")
	public method apiGetBeneficiaryId()

	@GET("/totvsHealthPlans/portal/v1/beneficiaries/:subscriberId/financeStatement/base64")
	public method apiGetFinanceStatement()

	@GET("/totvsHealthPlans/portal/v1/beneficiaries/:subscriberId/incomeTax/base64")
	public method apiGetIncomeTax()

	@GET("/totvsHealthPlans/portal/v1/beneficiaries/:subscriberId/rescissionFine")
	public method apiGetRescissionFine()

	@GET("/totvsHealthPlans/portal/v1/beneficiaries/:subscriberId/utilizationStatement/base64")
	public method apiGetBenefUtilizationStatement()

	@GET("/totvsHealthPlans/portal/v1/beneficiaries/:subscriberId/annualStatementDebts/base64")
	public method apiGetAnnualStatementDebts()

	@GET("/totvsHealthPlans/portal/v1/beneficiaries/:subscriberId/card")
	public method getBeneficiariesCard()

endclass

/*/{Protheus.doc} new
Construtor da classe BeneficiaryController.
@type method
@version 12.1.2510
@author vinicius.queiros
@since 03/04/2025
@return self, instancia da classe BeneficiaryController.
*/
method new() class BeneficiaryController

	_Super:new()

return self

/*/{Protheus.doc} apiGetBeneficiaries
Obtém os beneficiários utilizando o serviço BeneficiaryService e configura a resposta da requisição.
@type method
@version 12.1.2510
@author vinicius.queiros
@since 03/04/2025
/*/
method apiGetBeneficiaries() class BeneficiaryController

	local oController as object

	if self:validatePortalUserAccess()
		oController := totvs.protheus.health.plans.api.familyContract.beneficiary.BeneficiaryController():new()
		oController:apiBeneficiaries()
	endif

	freeObj(oController)
	self:destroy()

return

/*/{Protheus.doc} apiGetSupplementary
Método responsável pela api que retorna Dados Pessoais
@type method
@version 12.1.2510
@author luca.spiller
@since 04/11/2025
/*/
method apiGetSupplementary() class BeneficiaryController

	local oController as object
	local aRequiredData as array

	aRequiredData := {"subscriberId"}

	if self:validateRequiredParams(oRest:getPathParamsRequest(), aRequiredData)
		if self:validatePortalUserAccess() .and. self:hasAccessToBeneficiary(oRest:getPathParamsRequest()["subscriberId"])
			oController := totvs.protheus.health.plans.api.familyContract.beneficiary.BeneficiaryController():new()
			oController:apiSupplementaryHealth()
		endif
	endif

	freeObj(oController)
	self:destroy()

return

