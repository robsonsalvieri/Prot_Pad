#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "health.plan.api.portal.authorization.controller.ch"

#define STATUS_CODE_NOT_FOUND 404

namespace totvs.protheus.health.plan.api.portal.access

using namespace totvs.protheus.health.plan.api.util

/*/{Protheus.doc} AuthorizationController
Classe controladora das APIs de Protocolo de Autorização
@type class
@version 12.1.2510
@author luca.spiller
@since 05/11/2025
/*/
class AuthorizationController from BaseController

	public method new() constructor
	public method destroy()

    @POST("/totvsHealthPlans/portal/v1/authorizations/protocols")
	public method apiPostAuthorizations()

    @GET("/totvsHealthPlans/portal/v1/authorizations/:subscriberId/protocols")
	public method apiGetAuthorizations()

    @GET("/totvsHealthPlans/portal/v1/authorizations/protocols/:protocolId/interactions")
	public method apiGetInteractionsProtocol()

	@POST("/totvsHealthPlans/portal/v1/authorizations/protocols/attachments") 
    Public Method apiPostProtocolsAttachment()

	private method validateAuthorizationAccess(jRequestData as json, aRequiredParams as array) as logical
	private method getAuthorizationSubscriberId(cProtocol as character) as character

endclass

/*/{Protheus.doc} new
Método construtor da classe
@type method
@version 12.1.2510
@author luca.spiller
@since 
/*/
method new() class AuthorizationController

	_Super:new()

return self

/*/{Protheus.doc} destroy
Libera os recursos utilizados pela classe AuthorizationController
@type method
@version 12.1.2510
@autor luca.spiller
@since 14/1/2025
/*/
method destroy() class AuthorizationController

	_Super:destroy()

return

/*/{Protheus.doc} apiPostAuthorizations
Método responsável por cadastrar um novo protocolo de autorização para o beneficiário
@type method
@version 12.1.2510
@author luca.spiller
@since 13/11/2025
/*/
method apiPostAuthorizations() class AuthorizationController

	local oController as object
	local aRequiredData as array

	aRequiredData := {"subscriberId"}

	if self:setBodyRequest(oRest:getBodyRequest()) .and. self:validateAuthorizationAccess(self:getBodyRequest(), aRequiredData)
		oController := totvs.protheus.health.plans.api.attendance.authorization.protocol.AuthorizationProtocolController():new()
		oController:apiPostAuthorizationProtocol()
	endif

	fwFreeArray(aRequiredData)
	freeObj(oController)
	self:destroy()

return

/*/{Protheus.doc} apiGetAuthorizations
Método responsável pela api que retorna as solicitações de autorizações
@type method
@version 12.1.2510
@author luca.spiller
@since 13/11/2025
/*/
method apiGetAuthorizations() class AuthorizationController

	local oController as object

	if self:validateAuthorizationAccess(oRest:getPathParamsRequest(), {"subscriberId"})
		oController := totvs.protheus.health.plans.api.attendance.authorization.protocol.AuthorizationProtocolController():new()
		oController:apiGetAuthorization()
	endif

	freeObj(oController)
	self:destroy()

return

/*/{Protheus.doc} apiGetInteractionsProtocol
Método responsável pela api que retorna as interações das solicitação de autorização
@type method
@version 12.1.2510
@author luca.spiller
@since 13/11/2025
/*/
method apiGetInteractionsProtocol() class AuthorizationController

	local oController as object

	if self:validateAuthorizationAccess(oRest:getPathParamsRequest(), {"protocolId"})
		oController := totvs.protheus.health.plans.api.attendance.authorization.protocol.AuthorizationProtocolController():new()
		oController:apiGetInteractions()
	endif

	freeObj(oController)
	self:destroy()

return

/*/{Protheus.doc} apiPostAuthorizations
Método responsável por cadastrar anexos na solicitação de autorização
@type method
@version 12.1.2510
@author luca.spiller
@since 13/11/2025
/*/
method apiPostProtocolsAttachment() class AuthorizationController

	local oController as object
	local aRequiredData as array

	aRequiredData := {"protocol"}

	if self:setBodyRequest(oRest:getBodyRequest()) .and. self:validateAuthorizationAccess(self:getBodyRequest(), aRequiredData)
		oController := totvs.protheus.health.plans.api.attendance.authorization.protocol.AuthorizationProtocolController():new()
		oController:apiPostProtocolsAttachment()
	endif

	fwFreeArray(aRequiredData)
	freeObj(oController)
	self:destroy()

return

/*/{Protheus.doc} validateAuthorizationAccess
Valida se os dados da requisição contêm as informações necessárias para acessar a funcionalidade de autorização.
@type method
@version 12.1.2510
@author luca.spiller
@since 14/11/2025
@param jRequestData, json, dados da requisição recebidos pela API
@param aRequiredParams, array, lista de parâmetros obrigatórios que devem estar presentes
@return logical, indica se os dados são válidos para acesso ao reembolso
/*/
method validateAuthorizationAccess(jRequestData as json, aRequiredParams as array) as logical class AuthorizationController

	local lHasAccess := .F. as logical
	local cSubscriberId as character

 	if self:validateRequiredParams(jRequestData, aRequiredParams)
		if jRequestData:hasProperty("subscriberId") .and. !empty(jRequestData["subscriberId"])
			cSubscriberId := jRequestData["subscriberId"]
		else
			if jRequestData:hasProperty("protocolId")
				cSubscriberId := self:getAuthorizationSubscriberId(jRequestData["protocolId"])
			else
				cSubscriberId := self:getAuthorizationSubscriberId(jRequestData["protocol"])
			endif
		endif

		if !empty(cSubscriberId) .and. self:validatePortalUserAccess()
			lHasAccess := self:hasAccessToBeneficiary(cSubscriberId)
		endif
	endif

return lHasAccess

/*/{Protheus.doc} getAuthorizationSubscriberId
Retorna o identificador do beneficiário associado à autorização informada.
@type method
@version 12.1.2510
@author luca.spiller
@since 14/11/2025
@param cProtocol, character, código do protocolo de reembolso
@return character, identificador do beneficiário vinculado ao protocolo
/*/
method getAuthorizationSubscriberId(cProtocol as character) as character class AuthorizationController

	local cSubscriberId as character
	local cQuery as character
	local nOrder := 1 as numeric
	local oExecStmt as object
	local cAlias as character

	cQuery += "SELECT ? "
	cQuery += " FROM ? BKU "
	cQuery += " WHERE BKU.BKU_FILIAL = ? AND "
	cQuery += "		BKU.BKU_NRPRO = ? AND "
	cQuery += "		BKU.D_E_L_E_T_ = ? "

	oExecStmt := FwExecStatement():new(cQuery)

	oExecStmt:setUnsafe(nOrder++, "BKU.BKU_MATUSR")
	oExecStmt:setUnsafe(nOrder++, retSqlName("BKU"))
	oExecStmt:setString(nOrder++, xFilial("BKU"))
	oExecStmt:setString(nOrder++, cProtocol)
	oExecStmt:setString(nOrder++, " ")

	cAlias := oExecStmt:openAlias()

	if !(cAlias)->(eof())
		cSubscriberId := alltrim((cAlias)->BKU_MATUSR)
	else
		self:nStatusCode := STATUS_CODE_NOT_FOUND
		self:jResult["code"] := self:nStatusCode
		self:jResult["message"] := STR0001 //Protocolo de autorizacao nao encontrado."
		self:jResult["detailedMessage"] := STR0002 //Nenhum protocolo foi localizado na tabela BKU. Verifique se o numero do protocolo esta correto e se ele foi previamente registrado."
		self:setResponseData()
	endif

	(cAlias)->(dbCloseArea())

	oExecStmt:destroy()
	freeObj(oExecStmt)

return cSubscriberId
