#include "tlpp-core.th"
#include "tlpp-rest.th"

namespace totvs.protheus.health.plan.api.portal.access

using namespace totvs.protheus.health.plan.api.util

/*/{Protheus.doc} MedicationController
Classe controladora das APIs de Medicamentos de Uso Continuo
@type class
@version 12.1.2510  
@author luca.spiller
@since 17/11/2025
*/
class MedicationController from BaseController

	public method new() constructor

    @POST("/totvsHealthPlans/portal/v1/continuousMedications")
    public method apiPostMedications()

	@GET("/totvsHealthPlans/portal/v1/continuousMedications")
	public method apiGetMedications()

endclass

/*/{Protheus.doc} new
Construtor da classe MedicationController.
@type method
@version 12.1.2510
@author luca.spiller
@since 17/11/2025
@return self, instancia da classe MedicationController.
*/
method new() class MedicationController

	_Super:new()

return self

/*/{Protheus.doc} apiPostMedications
Método responsável por cadastrar medicamentos de uso contínuo
@type method
@version 12.1.2510
@author luca.spiller
@since 17/11/2025
/*/
method apiPostMedications() class MedicationController

	local oController as object
    local aRequiredData as array
	local cBody := oRest:getBodyRequest() as character

    aRequiredData := {"subscriberId"}

    if self:setBodyRequest(cBody) .and. self:validateRequiredParams(self:getBodyRequest(), aRequiredData)
		if self:validatePortalUserAccess() .and. self:hasAccessToBeneficiary(self:jBodyRequest["subscriberId"])
			oController := totvs.protheus.health.plans.api.refundSetup.continuedMedication.ContinuedMedicationController():new()
			oController:apiPostContinuousMedications()
		endif
	endif

	fwFreeArray(aRequiredData)
	freeObj(oController)
	self:destroy()

return

/*/{Protheus.doc} apiGetMedications
Método responsável por pela a consulta  dos medicamentos de uso continuo do beneficiário
@type method
@version 12.1.2510
@author luca.spiller
@since 17/11/2025
/*/
method apiGetMedications() class MedicationController

	local oController as object
	local aRequiredData as array

	aRequiredData := {"subscriberId"}

	if self:validateRequiredParams(oRest:getQueryRequest(), aRequiredData)
		if self:validatePortalUserAccess() .and. self:hasAccessToBeneficiary(oRest:getQueryRequest()["subscriberId"])
			oController := totvs.protheus.health.plans.api.refundSetup.continuedMedication.ContinuedMedicationController():new()
			oController:apiGetContinuousMedications()
		endif
	endif

	freeObj(oController)
	self:destroy()

return
