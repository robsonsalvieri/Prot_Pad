#include "tlpp-core.th"
#include "tlpp-rest.th"

namespace totvs.protheus.health.plans.api.familyContract.beneficiary.finance

using namespace totvs.protheus.health.plan.api.util

/*/{Protheus.doc} FinanceController
Classe controladora da API de Extrato Financeiro
@type class
@author Guilherme Carreiro
@since 29/05/2023
@version Protheus 12
/*/
class FinanceController from BaseController

    public method new() constructor
    public method destroy()

    @GET("/totvsHealthPlans/familyContract/v1/beneficiaries/:subscriberId/financeStatement/base64")
    public method apiFinanceStatementBase64()

    @GET("/totvsHealthPlans/familyContract/v1/beneficiaries/financeStatements/base64")
    public method apiFinanceStatementsBase64()

endclass

/*/{Protheus.doc} new
Método construtor da classe
@type method
@author Guilherme Carreiro
@since 29/05/2023
@version Protheus 12
/*/
method new() class FinanceController

    _Super:new()

return self

/*/{Protheus.doc} destroy
Libera os recursos utilizados pela instância da classe `FinanceController`.
@type method
@version 12.1.2610
@author vinicius.queiros
@since 29/06/2026
/*/
method destroy() class FinanceController

    _Super:destroy()

return

/*/{Protheus.doc} apifinanceStatementBase64
Método responsável por retornar o Extrato Financeiro em base64
Url: /totvsHealthPlans/familyContract/v1/beneficiaries/:subscriberId/financeStatement
Verbo: GET
@type method
@author Guilherme Carreiro
@since 29/05/2023
@version Protheus 12
/*/
method apiFinanceStatementBase64() class FinanceController

    local jPath := oRest:getPathParamsRequest() as json
    local jQueryParams := oRest:getQueryRequest() as json
    local oService as object   

    oService := FinanceService():new()
    oService:setPathParams(jPath)
    oService:setQueryParams(jQueryParams)

    if oService:getFinanceStatementBase64()
        oRest:setResponse(oService:getJsonResult())
        oRest:setStatusCode(oService:getStatusCode())
    else
        oRest:setFault(oService:getJsonResult())
        oRest:setStatusCode(oService:getStatusCode())      
    endif

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    oService:destroy()
    self:destroy()

    freeObj(oService)
    freeObj(jPath)
    freeObj(jQueryParams)

Return

/*/{Protheus.doc} apifinanceStatementsBase64
Método responsável por retornar o Extrato Financeiro em formato Base64,
permitindo a filtragem dos dados por empresa ou por um intervalo de matrículas (beneficiários).
Url: /totvsHealthPlans/familyContract/v1/beneficiaries/financeStatements/base64
Verbo: GET
@type method
@author giovanna.charlo
@since 28/05/2026
@version 12.1.2510
/*/
method apiFinanceStatementsBase64() class FinanceController

    local jQueryParams := oRest:getQueryRequest() as json  
    local aRequiredData as array  
    local oService as object

    aRequiredData := {"healthInsurerCode", "companyCode", "contractCode", "contractVersion", "subcontractCode", "subcontractVersion",;
                      "month", "year", "expenseType"}
   
    if self:validateRequiredParams(jQueryParams, aRequiredData)
        oService := FinanceService():new()
        oService:setQueryParams(jQueryParams)

        if oService:getFinanceStatementsBase64()
            if self:sendFileToBase64Chunked(oService:cFileName, oService:cPathFile)
                oRest:setStatusCode(oService:getStatusCode())
            endif
        else
            oRest:setFault(oService:getJsonResult())
            oRest:setStatusCode(oService:getStatusCode())      
        endif

        oService:destroy()
    endif

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    self:destroy()

    freeObj(oService)
    freeObj(jQueryParams)
    fwFreeArray(aRequiredData)

Return
