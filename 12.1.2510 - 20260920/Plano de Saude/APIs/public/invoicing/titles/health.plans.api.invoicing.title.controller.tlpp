/*/
method apiBankSlipBase64() class TitleController

    local oService as object
    local jQueryParams := oRest:getQueryRequest() as json
    local jPath := oRest:getPathParamsRequest() as json
    local lSuccess := .F. as logical

    oService := TitleService():new()
    oService:setQueryParams(jQueryParams)
    oService:setPathParams(jPath)

    lSuccess := oService:getBankSlipBase64()

    self:setResponseData(oService:getStatusCode(), oService:getJsonResult(), lSuccess)

    oService:destroy()
	_Super:destroy()

    freeObj(oService)
    freeObj(jQueryParams)
