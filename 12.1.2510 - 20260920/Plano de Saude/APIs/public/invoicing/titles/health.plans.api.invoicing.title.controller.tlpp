/*/{Protheus.doc} apiTotalTitles
Retorna os totalizadores dos títulos financeiros, incluindo totais por status e valor
@type method
@version 12.1.2510
@author vinicius.queiros
@since 22/06/2025
/*/
method apiTotalTitles() class TitleController

    local oService := TitleService():new() as object
    local lSuccess := .F. as logical

    oService:setQueryParams(oRest:getQueryRequest())

    lSuccess := oService:getTitles(.T.)

    self:setResponseData(oService:getStatusCode(), oService:getJsonResult(), lSuccess)

	oService:destroy()
    _Super:destroy()

	freeObj(oService)

return

/*/{Protheus.doc} getCompositions
Retorna a lista de composições do título (detalhes).
@type method
@version 12.1.2610
@author vinicius.queiros
@since 24/11/2025
/*/
method getCompositions() class TitleController

    local oService := TitleService():new() as object
	local jPath := oRest:getPathParamsRequest() as json
    local lSuccess := .F. as logical

	if self:validateRequiredParams(jPath, {"titleId"})
		oService:setPathParams(jPath)
		oService:setQueryParams(oRest:getQueryRequest())

        lSuccess := oService:getCompositions()

        self:setResponseData(oService:getStatusCode(), oService:getJsonResult(), lSuccess)
	endif

    oService:destroy()
	_Super:destroy()	

	freeObj(oService)
	freeObj(jPath)

return
