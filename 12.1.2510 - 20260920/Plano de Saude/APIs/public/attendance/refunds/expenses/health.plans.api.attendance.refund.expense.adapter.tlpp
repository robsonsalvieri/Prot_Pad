#include "tlpp-core.th"

namespace totvs.protheus.health.plans.api.attendance.refund.expense

using namespace totvs.protheus.health.plans.api.util

/*/{Protheus.doc} ExpenseAdapter
Classe que monta a collection das despesas do protocolo de reembolso

@type class
@version Protheus 12.1.2310  
@author vinicius.queiros
@since 02/05/2023
/*/
class ExpenseAdapter from BaseAdapter

	public method new() Constructor
	public method getPageExpenses() as logical

	private method mapFieldsExpenses() as logical
	private method getQueryExpenses() as character
	private method getWhereExpenses() as character
	private method getOrderExpenses() as character

	private method getStatusAPIQuery() as character

endclass

/*/{Protheus.doc} new
Contrutor da classe

@type method
@version Protheus 12.1.2310  
@author vinicius.queiros
@since 02/05/2023
@return object, objecto da classe ExpenseAdapter
/*/
method new() class ExpenseAdapter

	_Super:new()

return self

/*/{Protheus.doc} getPageExpenses
Monta os dados (query, where, order e fields) para buscar as despesas do protocolo
de reembolo na base de dados

@type method
@version Protheus 12.1.2310  
@author vinicius.queiros
@since 02/05/2023
@return logical, se houve sucesso na montagem da pagina das despesas
/*/
method getPageExpenses() as logical class ExpenseAdapter

	local lSucess := .F. as logical
	local cQuery := self:getQueryExpenses() as character
	local cWhere := self:getWhereExpenses() as character
	local cOrder := self:getOrderExpenses() as character

	self:mapFieldsExpenses()

	If self:executeQueryAdapter(cQuery, cWhere, cOrder)
		lSucess := .T.
	endif

return lSucess

/*/{Protheus.doc} mapFieldsExpenses
Mapea os campos do json de retorno com os campos do Protheus (SX3)

@type method
@version Protheus 12.1.2310  
@author vinicius.queiros
@since 02/05/2023
@return logical, sempre será retornado verdadeiro
/*/
method mapFieldsExpenses() as logical class ExpenseAdapter

	// self:oAdapterBase:addMapFields("status", "B1N_IMGSTA", .T., .F., {"B1N_IMGSTA", "C", tamSX3("B1N_IMGSTA")[1], 0}, " CASE WHEN B1N.B1N_IMGSTA = 'ENABLE' THEN '1' ELSE '0' END ")
	self:oAdapterBase:addMapFields("status", "B1N_IMGSTA", .T., .F., {"B1N_IMGSTA", "C", tamSX3("B1N_IMGSTA")[1], 0}, self:getStatusAPIQuery())
	self:oAdapterBase:addMapFields("subscriber_id", "B1N_MATRIC", .T., .F., {"B1N_MATRIC", "C", tamSX3("B1N_MATRIC")[1], 0})
	self:oAdapterBase:addMapFields("beneficiary_name", "BA1_NOMUSR", .T., .F., {"BA1_NOMUSR", "C", tamSX3("BA1_NOMUSR")[1], 0})
	self:oAdapterBase:addMapFields("protocol", "B1N_PROTOC", .T., .F., {"B1N_PROTOC", "C", tamSX3("B1N_PROTOC")[1], 0})
	self:oAdapterBase:addMapFields("sequential", "B1N_SEQUEN", .T., .F., {"B1N_SEQUEN", "C", tamSX3("B1N_SEQUEN")[1], 0})
	self:oAdapterBase:addMapFields("procedure_class", "B1N_TIPSER", .T., .F., {"B1N_TIPSER", "C", tamSX3("B1N_TIPSER")[1], 0})
	self:oAdapterBase:addMapFields("class_description", "BJE_DESCRI", .T., .F., {"BJE_DESCRI", "C", tamSX3("BJE_DESCRI")[1], 0})
	self:oAdapterBase:addMapFields("table_code", "B1N_CODPAD", .T., .F., {"B1N_CODPAD", "C", tamSX3("B1N_CODPAD")[1], 0})
	self:oAdapterBase:addMapFields("procedure_code", "BR8_CODPSA", .T., .F., {"BR8_CODPSA", "C", tamSX3("BR8_CODPSA")[1], 0})
	self:oAdapterBase:addMapFields("procedure_description", "BR8_DESCRI", .T., .F., {"BR8_DESCRI", "C", tamSX3("BR8_DESCRI")[1], 0})
	self:oAdapterBase:addMapFields("continuous_use", "B1N_USOCON", .T., .F., {"B1N_USOCON", "C", tamSX3("B1N_USOCON")[1], 0})
	self:oAdapterBase:addMapFields("quantity", "B1N_QTDPRO", .T., .F., {"B1N_QTDPRO", "N", tamSX3("B1N_QTDPRO")[1], 0})
	self:oAdapterBase:addMapFields("expense_amount", "B1N_VLRAPR", .T., .F., {"B1N_VLRAPR", "N", tamSX3("B1N_VLRAPR")[1], 0})
	self:oAdapterBase:addMapFields("total_expense_amount", "B1N_VLRTOT", .T., .F., {"B1N_VLRTOT", "N", tamSX3("B1N_VLRTOT")[1], 0})
	self:oAdapterBase:addMapFields("refunded_amount", "B1N_VLRREE", .T., .F., {"B1N_VLRREE", "N", tamSX3("B1N_VLRREE")[1], 0})
	self:oAdapterBase:addMapFields("unreferenced_network_identifier", "B1N_CODREF", .T., .F., {"B1N_CODREF", "C", tamSX3("B1N_CODREF")[1], 0})
	self:oAdapterBase:addMapFields("unreferenced_network_name", "B1N_NOMREF", .T., .F., {"B1N_NOMREF", "C", tamSX3("B1N_NOMREF")[1], 0})
	self:oAdapterBase:addMapFields("state_abbreviation", "B1N_EST", .T., .F., {"B1N_EST", "C", tamSX3("B1N_EST")[1], 0})
	self:oAdapterBase:addMapFields("city_code", "B1N_CODMUN", .T., .F., {"B1N_CODMUN", "C", tamSX3("B1N_CODMUN")[1], 0})
	self:oAdapterBase:addMapFields("city_description", "BID_DESCRI", .T., .F., {"BID_DESCRI", "C", tamSX3("BID_DESCRI")[1], 0})
	self:oAdapterBase:addMapFields("document_code", "BBS_COD", .T., .F., {"BBS_COD", "C", tamSX3("BBS_COD")[1], 0})
	self:oAdapterBase:addMapFields("document_description", "B1N_TIPDOC", .T., .F., {"B1N_TIPDOC", "C", tamSX3("B1N_TIPDOC")[1], 0})
	self:oAdapterBase:addMapFields("document_number", "B1N_NUMDOC", .T., .F., {"B1N_NUMDOC", "C", tamSX3("B1N_NUMDOC")[1], 0})
	self:oAdapterBase:addMapFields("document_date", "B1N_DATDOC", .T., .F., {"B1N_DATDOC", "C", tamSX3("B1N_DATDOC")[1], 0}, self:getFormatDate("B1N_DATDOC"))
	self:oAdapterBase:addMapFields("execution_date", "B1N_DATPRO", .T., .F., {"B1N_DATPRO", "C", tamSX3("B1N_DATPRO")[1], 0}, self:getFormatDate("B1N_DATPRO"))
	self:oAdapterBase:addMapFields("denied_reason", "B14_MOTIVO", .T., .F., {"B14_MOTIVO", "C", tamSX3("B14_MOTIVO")[1], 0})
	// self:oAdapterBase:addMapFields("denied_reason", "B14_MOTIVO", .T., .F., {"B14_MOTIVO", "C", tamSX3("B14_MOTIVO")[1], 0}, self:getDeniedReasonAPIQuery())
	self:oAdapterBase:addMapFields("denied_date", "B14_DATA", .T., .F., {"B14_DATA", "C", tamSX3("B14_DATA")[1], 0}, self:getFormatDate("B14_DATA"))

return .T.

/*/{Protheus.doc} getQueryExpenses
Retorna corpo da query que busca as despesas do protocolo de reembolso

@type method
@version Protheus 12.1.2310  
@author vinicius.queiros
@since 03/05/2023
@return character, corpo da query das despesas
/*/
method getQueryExpenses() as character class ExpenseAdapter

	local cQuery as character
	local cDatabaseInUse := upper(TCGetDB())
	local cSubstrOperatorSQL := iif(cDatabaseInUse $ "ORACLE|DB2|POSTGRES|INFORMIX", "SUBSTR", "SUBSTRING") as character
	local aBindValues := {} as array

	cQuery := "SELECT #QueryFields# "
	cQuery += "FROM ? B1N "
	aAdd(aBindValues, {"set": "unsafe", "value": retSqlName("B1N")})

	// Beneficiário
	cQuery += " INNER JOIN ? BA1 "
	cQuery += "   ON BA1.BA1_FILIAL = ? "
	cQuery += "  AND BA1.BA1_CODINT = ? "
	cQuery += "  AND BA1.BA1_CODEMP = ? "
	cQuery += "  AND BA1.BA1_MATRIC = ? "
	cQuery += "  AND BA1.BA1_TIPREG = ? "
	cQuery += "  AND BA1.BA1_DIGITO = ? "
	cQuery += "  AND BA1.D_E_L_E_T_ = ? "
	aAdd(aBindValues, {"set": "unsafe", "value": retSqlName("BA1")})
	aAdd(aBindValues, {"set": "string", "value": xFilial("BA1")})
	aAdd(aBindValues, {"set": "unsafe", "value": cSubstrOperatorSQL+"(B1N.B1N_MATRIC, 1, 4)"})
	aAdd(aBindValues, {"set": "unsafe", "value": cSubstrOperatorSQL+"(B1N.B1N_MATRIC, 5, 4)"})
	aAdd(aBindValues, {"set": "unsafe", "value": cSubstrOperatorSQL+"(B1N.B1N_MATRIC, 9, 6)"})
	aAdd(aBindValues, {"set": "unsafe", "value": cSubstrOperatorSQL+"(B1N.B1N_MATRIC, 15, 2)"})
	aAdd(aBindValues, {"set": "unsafe", "value": cSubstrOperatorSQL+"(B1N.B1N_MATRIC, 17, 1)"})
	aAdd(aBindValues, {"set": "string", "value": ' '})

	// Procedimento
	cQuery += " INNER JOIN ? BR8 "
	cQuery += "   ON BR8.BR8_FILIAL = ? "
	cQuery += "  AND BR8.BR8_CODPAD = B1N.B1N_CODPAD "
	cQuery += "  AND BR8.BR8_CODPSA = B1N.B1N_CODPRO "
	cQuery += "  AND BR8.D_E_L_E_T_ = ? "
	aAdd(aBindValues, {"set": "unsafe", "value": retSqlName("BR8")})
	aAdd(aBindValues, {"set": "string", "value": xFilial("BR8")})
	aAdd(aBindValues, {"set": "string", "value": " "})

	// Documento
	cQuery += " LEFT JOIN ? BBS "
	cQuery += "   ON BBS.BBS_FILIAL = ? "
	cQuery += "  AND BBS.BBS_DESCRI = B1N.B1N_TIPDOC "
	cQuery += "  AND BBS.D_E_L_E_T_ = ? "
	aAdd(aBindValues, {"set": "unsafe", "value": retSqlName("BBS")})
	aAdd(aBindValues, {"set": "string", "value": xFilial("BBS")})
	aAdd(aBindValues, {"set": "string", "value": " "})

	// Classe
	cQuery += " LEFT JOIN ? BJE "
	cQuery += "   ON BJE.BJE_FILIAL = ? "
	cQuery += "  AND BJE.BJE_CODIGO = B1N.B1N_TIPSER "
	cQuery += "  AND BJE.D_E_L_E_T_ = ? "
	aAdd(aBindValues, {"set": "unsafe", "value": retSqlName("BJE")})
	aAdd(aBindValues, {"set": "string", "value": xFilial("BJE")})
	aAdd(aBindValues, {"set": "string", "value": " "})

	// Municipio
	cQuery += " LEFT JOIN ? BID "
	cQuery += "   ON BID.BID_FILIAL = ? "
	cQuery += "  AND BID.BID_CODMUN = B1N.B1N_CODMUN "
	cQuery += "  AND BID.D_E_L_E_T_ = ? "
	aAdd(aBindValues, {"set": "unsafe", "value": retSqlName("BID")})
	aAdd(aBindValues, {"set": "string", "value": xFilial("BID")})
	aAdd(aBindValues, {"set": "string", "value": " "})

	// Motivo Rejeição Protocolo Reembolso
	cQuery += " LEFT JOIN ? B14 "
	cQuery += "   ON B14.B14_FILIAL = ? "
	cQuery += "  AND B14_CDPROT = B1N_PROTOC "
	cQuery += "  AND B14_CODPRO = B1N_CODPRO "
	cQuery += "  AND B14_MATRIC = B1N_MATRIC "
	cQuery += "  AND B14_SEQUEN = B1N_SEQUEN "
	cQuery += "  AND B14.D_E_L_E_T_ = ? "
	aAdd(aBindValues, {"set": "unsafe", "value": retSqlName("B14")})
	aAdd(aBindValues, {"set": "string", "value": xFilial("B14")})
	aAdd(aBindValues, {"set": "string", "value": " "})

	// Protocolo de Reembolso
	cQuery += " LEFT JOIN ? BOW "
	cQuery += "   ON BOW.BOW_FILIAL = ? "
	cQuery += "  AND BOW_PROTOC = B1N_PROTOC "
	cQuery += "  AND BOW.D_E_L_E_T_ = ? "
	aAdd(aBindValues, {"set": "unsafe", "value": retSqlName("BOW")})
	aAdd(aBindValues, {"set": "string", "value": xFilial("BOW")})
	aAdd(aBindValues, {"set": "string", "value": " "})

	// // Cabeçalho do Reembolso
	// cQuery += " LEFT JOIN ? B44 "
	// cQuery += "   ON B44.B44_FILIAL = ? "
	// cQuery += "  AND B44_PROTOC = BOW_PROTOC "
	// cQuery += "  AND B44.D_E_L_E_T_ = ? "
	// aAdd(aBindValues, {"set": "unsafe", "value": retSqlName("B44")})
	// aAdd(aBindValues, {"set": "string", "value": xFilial("B44")})
	// aAdd(aBindValues, {"set": "string", "value": " "})

	// // Criticas do Reembolso
	// cQuery += " LEFT JOIN ? B46 "
	// cQuery += "   ON B46.B46_FILIAL = ? "
	// cQuery += "  AND B46_NUMAUT = B44_NUMAUT "
	// cQuery += "  AND B46.D_E_L_E_T_ = ? "
	// aAdd(aBindValues, {"set": "unsafe", "value": retSqlName("B46")})
	// aAdd(aBindValues, {"set": "string", "value": xFilial("B46")})
	// aAdd(aBindValues, {"set": "string", "value": " "})

	cQuery += " WHERE #QueryWhere#"

	cQuery := self:bindValuesToQuery(cQuery, aBindValues)

	fwFreeArray(aBindValues)

return cQuery

/*/{Protheus.doc} getWhereExpenses
Retorna a parte do where da query que busca as despesas do protocolo de reembolso

@type method
@version Protheus 12.1.2310  
@author vinicius.queiros
@since 03/05/2023
@return character, where da query das despesas do reembolso
/*/
method getWhereExpenses() as character class ExpenseAdapter

	local cWhere as character
	local aBindValues := {} as array

	cWhere := " B1N.B1N_FILIAL = ? "
	cWhere += " AND B1N.B1N_PROTOC = ? "
	cWhere += " AND B1N.D_E_L_E_T_ = ? "
	// cWhere += " AND B46.B46_CODGLO <> ? "
	aAdd(aBindValues, {"set": "string", "value": xFilial("B1N")})
	aAdd(aBindValues, {"set": "string", "value": self:jPath["protocol"]})
	aAdd(aBindValues, {"set": "string", "value": " "})
	// aAdd(aBindValues, {"set": "string", "value": " "})

	cWhere := self:bindValuesToQuery(cWhere, aBindValues)

	fwFreeArray(aBindValues)

return cWhere

/*/{Protheus.doc} getOrderExpenses
Retorna a parte do order da query que busca as despesas do reembolso

@type method
@version Protheus 12.1.2310  
@author vinicius.queiros
@since 03/05/2023
@return character, order da query das despesas do protocolo de reembolso
/*/
method getOrderExpenses() as character class ExpenseAdapter

	local cOrder as character

	cOrder := "B1N.B1N_SEQUEN"

return cOrder

/*/{Protheus.doc} getStatusAPIQuery
Retorna os status da api x Protheus para a query de busca dos protocolos

@type method
@version Protheus 12.1.2310  
@author vinicius.queiros
@since 26/04/2023
@return character, Campo status da query com os case de de/para
/*/
method getStatusAPIQuery() as character class ExpenseAdapter

	local cQuery as character

	cQuery += " CASE "
	cQuery += "		WHEN BOW.BOW_STATUS = '4' OR BOW.BOW_STATUS = '7' OR BOW.BOW_STATUS = '8' OR BOW.BOW_STATUS = 'D' THEN '0' " // Rejeitado
	cQuery += "		WHEN BOW.BOW_STATUS = '6' OR BOW.BOW_STATUS = 'C' THEN  " // Aprovado
	cQuery += "			CASE WHEN B1N.B1N_IMGSTA = 'ENABLE' THEN '1' ELSE '0' END  "
	cQuery += "		WHEN BOW.BOW_STATUS = 'A' OR BOW.BOW_STATUS = '0' OR BOW.BOW_STATUS = '1' OR BOW.BOW_STATUS = '2' OR BOW.BOW_STATUS = '3' OR BOW.BOW_STATUS = '5'" +;
						"OR BOW.BOW_STATUS = '9' OR BOW.BOW_STATUS = 'B' OR BOW.BOW_STATUS = 'E' THEN '2' " // Em análise
	cQuery += " ELSE '' "
	cQuery += " END "

return cQuery
