#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "health.plan.api.report.lossratio.controller.ch"

#define REQUIRED .T.
#define OPTIONAL .F.
#define TYPE_INDIVIDUAL "1"
#define TYPE_CORPORATE "2"
#define REPORT_FORMAT_SYNTHETIC "1"
#define REPORT_FORMAT_ANALYTICAL "2"
#define YES_OPTION "1"
#define NO_OPTION "2"
#define TRUE_OPTION "true"
#define FALSE_OPTION "false"
#define STATUS_CODE_OK 200
#define STATUS_CODE_SEE_OTHER 303
#define STATUS_CODE_NOT_FOUND 404

namespace totvs.protheus.health.plan.api.report

using namespace totvs.protheus.health.plan.api.util

/*/{Protheus.doc} LossRatioController
Controller responsável por receber a requisição do relatório de sinistralidade, validar o body e acionar a service de geração do arquivo.
@type class
@version 12.1.2610
@author vinicius.queiros
@since 05/06/2026
/*/
class LossRatioController from BaseController

    public method new() constructor
    public method destroy()

    @POST("/totvsHealthPlans/reports/utilization/v1/lossRatio")
    public method lossRatioReport()

    @GET("/totvsHealthPlans/reports/utilization/v1/lossRatio/:fileName")
    public method getLossRatioStatus()

    @GET("/totvsHealthPlans/reports/utilization/v1/lossRatio/:fileName/download")
    public method downloadLossRatioFile()

    private method buildRequestSchema() as array

endclass

/*/{Protheus.doc} new
Executa o construtor da classe `LossRatioController` e inicializa a herança da `BaseController`.
@type method
@version 12.1.2610
@author vinicius.queiros
@since 05/06/2026
@return object, instância da classe `LossRatioController`
/*/
method new() class LossRatioController

    _Super:new()

return self

/*/{Protheus.doc} destroy
Libera os recursos utilizados pela instância da classe `LossRatioController`.
@type method
@version 12.1.2610
@author vinicius.queiros
@since 05/06/2026
/*/
method destroy() class LossRatioController

    _Super:destroy()

return

/*/{Protheus.doc} lossRatioReport
Recebe o body da requisição, valida os campos informados e executa a geração do relatório de sinistralidade no formato síncrono (PDF) ou assíncrono (202 + Location) conforme o formato solicitado.
@type method
@version 12.1.2610
@author vinicius.queiros
@since 05/06/2026
@return nil, processamento da resposta HTTP realizado diretamente no objeto `oRest`
/*/
method lossRatioReport() class LossRatioController

    local oService as object
    local aRequestSchema := {} as array
    local jBody as json

    if self:setBodyRequest(oRest:getBodyRequest())
        jBody := self:getBodyRequest()

        aRequestSchema := self:buildRequestSchema()

        if self:validateRequestSchema(jBody, aRequestSchema)
            oService := LossRatioService():new()
            oService:setBody(jBody)
      
            if oService:lossRatioReport()
                if oService:lIsSynchronous
                    if oService:lBase64
                        oRest:setKeyHeaderResponse("Content-Type", "application/json")
                        oRest:setResponse(oService:getJsonResult())
                    else
                        oRest:setKeyHeaderResponse("Content-Disposition", "attachment; filename=" + oService:cFileName + "")
                        oRest:setKeyHeaderResponse("Content-Type", "application/pdf" )
                        oRest:setResponse(oService:cFilePdf)
                    endif
                else
                    oRest:setKeyHeaderResponse("Location", oRest:getFullURLRequest() + "/" + lower(oService:cFileName))
                endif
            else
                oRest:setFault(oService:getJsonResult())
                oRest:setKeyHeaderResponse("Content-Type", "application/json")
            endif

            oRest:setStatusCode(oService:getStatusCode())
            oService:destroy()
        endif
    endif

    self:destroy()

    freeObj(jBody)
    freeObj(oService)
    fwFreeArray(aRequestSchema)

return

/*/{Protheus.doc} getLossRatioStatus
Consulta o recurso temporário de status do processamento assíncrono do relatório de sinistralidade e retorna o estado atual (pending), redirecionamento para download (done) ou erro de token não encontrado.
@type method
@version 12.1.2610
@author vinicius.queiros
@since 07/06/2026
@return nil, processamento da resposta HTTP realizado diretamente no objeto `oRest`
/*/
method getLossRatioStatus() class LossRatioController

    local cFileName as character
    local cDirectory := lower(superGetMv("MV_RELT", .F., "")) as character
    local jPathParams := oRest:getPathParamsRequest() as json
    local jResponse as json
    Local jStatusFile := JsonObject():new() as json

    if self:validateRequiredParams(jPathParams, {"fileName"})  
        cFileName := jPathParams["fileName"]

        if valType(jStatusFile:fromJsonFile(cDirectory + cFileName + "-status.json")) == "U"
            if jStatusFile["status"] == "done"
                oRest:setKeyHeaderResponse("Location", oRest:getFullURLRequest() + "/download")
                oRest:setStatusCode(STATUS_CODE_SEE_OTHER)
            else
                oRest:setKeyHeaderResponse("Content-Type", "application/json")
                oRest:setResponse(jStatusFile:toJson())
                oRest:setStatusCode(STATUS_CODE_OK)     
            endif        
        else
            jResponse := {"code": STATUS_CODE_NOT_FOUND, "message": STR0019, "detailMessage": STR0020} // "Não localizamos uma solicitação de relatório para o identificador informado." ; "Recurso temporário de acompanhamento não encontrado: arquivo '<fileName>.status.json' inexistente para o token recebido."

            oRest:setFault(jResponse:toJson())
            oRest:setStatusCode(STATUS_CODE_NOT_FOUND)
            oRest:setKeyHeaderResponse("Content-Type", "application/json")
        endif
    endif

    self:destroy()

    freeObj(jPathParams)
    freeObj(jResponse)
    freeObj(jStatusFile)
    
return

/*/{Protheus.doc} downloadLossRatioFile
Realiza o download do arquivo PDF gerado pelo processamento assíncrono do relatório de sinistralidade a partir do identificador informado no path da requisição.
@type method
@version 12.1.2610
@author vinicius.queiros
@since 07/06/2026
@return nil, processamento da resposta HTTP realizado diretamente no objeto `oRest`
/*/
method downloadLossRatioFile() class LossRatioController

    local oService as object
    local cFileName as character
    local jPathParams := oRest:getPathParamsRequest() as json
 
    if self:validateRequiredParams(jPathParams, {"fileName"})  
        cFileName := jPathParams["fileName"]

        oService := LossRatioService():new()

        if oService:loadLossRatioPdfBinary(cFileName)
            oRest:setKeyHeaderResponse("Content-Disposition", "attachment; filename=" + oService:cFileName + "")
            oRest:setKeyHeaderResponse("Content-Type", "application/pdf" )
            oRest:setResponse(oService:cFilePdf)
        else
            oRest:setFault(oService:getJsonResult())
            oRest:setKeyHeaderResponse("Content-Type", "application/json")
        endif

        oRest:setStatusCode(oService:getStatusCode())
        oService:destroy()
    endif

    self:destroy()

    freeObj(jPathParams)
    
return

/*/{Protheus.doc} buildRequestSchema
Monta o schema de validação do body da requisição do relatório de sinistralidade com campos obrigatórios, opcionais e regras de formato.
@type method
@version 12.1.2610
@author vinicius.queiros
@since 05/06/2026
@return array, schema de validação do body da requisição
/*/
method buildRequestSchema() as array class LossRatioController

    local aSchema := {} as array

    aAdd(aSchema, {"name": "healthInsurerCode", "required": REQUIRED, "description": STR0001, "maxLength": tamSX3("BA3_CODINT")[1]}) // "Código da operadora"
    aAdd(aSchema, {"name": "companyCodeFrom", "required": REQUIRED, "description": STR0002, "maxLength": tamSX3("BA3_CODEMP")[1]}) // "Código da empresa inicial"
    aAdd(aSchema, {"name": "companyCodeTo", "required": REQUIRED, "description": STR0003, "maxLength": tamSX3("BA3_CODEMP")[1]}) // "Código da empresa final"
    aAdd(aSchema, {"name": "contractCodeFrom", "required": OPTIONAL, "description": STR0004, "maxLength": tamSX3("BA3_CONEMP")[1]}) // "Código do contrato inicial"
    aAdd(aSchema, {"name": "contractCodeTo", "required": OPTIONAL, "description": STR0005, "maxLength": tamSX3("BA3_CONEMP")[1]}) // "Código do contrato final"
    aAdd(aSchema, {"name": "contractVersionFrom", "required": OPTIONAL, "description": STR0006, "maxLength": tamSX3("BA3_VERCON")[1]}) // "Versão do contrato inicial"
    aAdd(aSchema, {"name": "contractVersionTo", "required": OPTIONAL, "description": STR0007, "maxLength": tamSX3("BA3_VERCON")[1]}) // "Versão do contrato final"
    aAdd(aSchema, {"name": "subcontractCodeFrom", "required": OPTIONAL, "description": STR0008, "maxLength": tamSX3("BA3_SUBCON")[1]}) // "Código do subcontrato inicial"
    aAdd(aSchema, {"name": "subcontractCodeTo", "required": OPTIONAL, "description": STR0009, "maxLength": tamSX3("BA3_SUBCON")[1]}) // "Código do subcontrato final"
    aAdd(aSchema, {"name": "subcontractVersionFrom", "required": OPTIONAL, "description": STR0010, "maxLength": tamSX3("BA3_VERSUB")[1]}) // "Versão do subcontrato inicial"
    aAdd(aSchema, {"name": "subcontractVersionTo", "required": OPTIONAL, "description": STR0011, "maxLength": tamSX3("BA3_VERSUB")[1]}) // "Versão do subcontrato final"
    aAdd(aSchema, {"name": "familyCodeFrom", "required": OPTIONAL, "description": STR0012, "maxLength": tamSX3("BA3_MATRIC")[1]}) // "Código da família inicial"
    aAdd(aSchema, {"name": "familyCodeTo", "required": OPTIONAL, "description": STR0013, "maxLength": tamSX3("BA3_MATRIC")[1]}) // "Código da família final"

    // O período deve ser informado no padrão AAAA-MM para compatibilizar com a validação e com a service.
    aAdd(aSchema, {"name": "startYearMonth", "required": REQUIRED, "description": STR0014, "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"}) // "Período inicial no formato AAAA-MM"
    aAdd(aSchema, {"name": "endYearMonth", "required": REQUIRED, "description": STR0015, "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"}) // "Período final no formato AAAA-MM"

    // Os campos abaixo utilizam valores enumerados compatíveis com a rotina padrão do relatório.
    aAdd(aSchema, {"name": "type", "required": REQUIRED, "description": STR0016, "enum": {TYPE_INDIVIDUAL, TYPE_CORPORATE}}) // "Tipo (1=Física, 2=Jurídica)"
    aAdd(aSchema, {"name": "reportFormat", "required": REQUIRED, "description": STR0017, "enum": {REPORT_FORMAT_SYNTHETIC, REPORT_FORMAT_ANALYTICAL}}) // "Formato do relatório (1=Sintético, 2=Analítico)"
    aAdd(aSchema, {"name": "rn309", "required": OPTIONAL, "description": STR0018, "enum": {YES_OPTION, NO_OPTION}}) // "Incluir RN309 (1=Sim, 2=Não)"
    aAdd(aSchema, {"name": "base64", "required": OPTIONAL, "description": STR0021, "enum": {TRUE_OPTION, FALSE_OPTION}}) // "Retornar arquivo em Base64 (true/false)"

return aSchema
