#Include "PROTHEUS.CH"
#Include "TOTVS.CH"
#Include 'tlpp-core.th'
#Include 'tlpp-rest.th'
#Include "FWLIBVERSION.CH"

//-------------------------------------------------------------------
/*/{Protheus.doc} HealthApiGlossedAppealReportService
.
@author  Sakai
@version P12
@since   02/02/2026
/*/
//-------------------------------------------------------------------
Class HealthApiGlossedAppealReportService

    data oRest as Object
    data oDao as Object
    data oJson as Object
    data aTabDup as Object
    data cObjRec as Character
    data cAliTrb as Character

    public method New(oRest,cSvcName) Constructor
    public method buscaProtocolo()
    public method processa()
    private method procProtoc()
    private method procGuiaEvento()
    private method setCabec(lGetJust)
    private method setGuide(lGetJust)
    private method setEvent(lGetJust)
    private method getJustifications(cAlias,cRecno)
    private method maskField(xValue,lData)

EndClass

Method New(oRest) Class HealthApiGlossedAppealReportService
    self:oRest := oRest
    self:oDao  := HealthApiGlossedAppealReportDao():New()
    self:oJson := JsonObject():new()
    self:cObjRec := ""
    self:cAliTrb := ""
    self:aTabDup := PlsBusTerDup(SuperGetMv("MV_TISSCAB", .F. ,"87"))
Return self

Method buscaProtocolo() Class HealthApiGlossedAppealReportService
Return self:oDao:buscaProtocolo(self:oRest:appealProtocol,self:oRest:healthProviderCode)

Method processa() Class HealthApiGlossedAppealReportService

    Local aRet := {}

    self:cObjRec := self:oDao:getObjRec()

    if self:cObjRec == "1" //Protocolo
        aRet := self:procProtoc()
    elseIf self:cObjRec == "2" .Or. self:cObjRec == "3" //Guia ou Evento
        aRet := self:procGuiaEvento()
    endIf

Return aRet

Method procProtoc() Class HealthApiGlossedAppealReportService
    
    Local nItems :=  0
    Local nStatus := 200
    Local aRet := {}
    Local lRet := .F.

    //Monta cabecalho
    self:setCabec(.T.)
    self:oJson["guides"] := {}

    self:cAliTrb := self:oDao:getAliasTemp()

    if self:oDao:getProtoc()

        lRet := .T.

        while !self:oDao:isEof()
            nItems ++
            aadd(self:oJson["guides"],self:setGuide(.F.))
            self:oJson["guides",nItems,"events"] := {}

            self:oDao:dbSkip()
        endDo
        self:oDao:closeQuery()

        aadd(aRet,self:oJson)
        aadd(aRet,nStatus)

    endIf

Return {lRet,aRet}

Method procGuiaEvento() Class HealthApiGlossedAppealReportService

    Local aRet := {}
    Local lRet := .F.
    Local nStatus := 200

    //Monta cabecalho
    self:setCabec(.F.)
    self:oJson["guides"] := {}
    
    //Adiciona guia
    self:cAliTrb := self:oDao:getAliasTemp()
    if self:oDao:getGuia()
        
        aadd(self:oJson["guides"],self:setGuide(iif(self:cObjRec=="2",.T.,.F.)))
        self:oDao:closeQuery()

        //Gera no de evento
        self:oJson["guides",1,"events"] := {}

        //Adiciona eventos
        self:cAliTrb := self:oDao:getAliasTemp()
        if self:oDao:getProcGuiaEvento()
            lRet := .T.
            while !self:oDao:isEof()
                aadd(self:oJson["guides",1,"events"],self:setEvent(iif(self:cObjRec=="3",.T.,.F.)))
                self:oDao:dbSkip()
            endDo
            self:oDao:closeQuery()
        endif    
    endIf

    aadd(aRet,self:oJson)
    aadd(aRet,nStatus)

Return {lRet,aRet}

//-------------------------------------------------------------------
/*/{Protheus.doc} Metodos montagem do JSON guia/items
.
@author  Sakai
@version P12
@since   02/02/2026
/*/
//-------------------------------------------------------------------
Method setCabec(lGetJust) Class HealthApiGlossedAppealReportService

    Local aRet := {}
    Default lGetJust := .F.

    self:oJson["appealProtocol"] := self:maskField(B4D->B4D_PROTOC)
    self:oJson["protocol"] := self:maskField(B4D->B4D_CODPEG)
    self:oJson["totalReconsideredValue"] := self:maskField(B4D->B4D_TOTREC)
    self:oJson["totalAcceptedValue"] := self:maskField(B4D->B4D_TOTACA)
    self:oJson["requestDate"] := self:maskField((B4D->B4D_DATSOL),.T.)
    self:oJson["analysisDate"] := self:maskField(B4D->B4D_DATREC,.T.)
    self:oJson["status"] := self:maskField(B4D->B4D_STATUS)
    self:oJson["appealObject"] := self:maskField(B4D->B4D_OBJREC)
    self:oJson["authType"] := self:maskField(B4D->B4D_TIPGUI)

    if lGetJust
        aRet = self:getJustifications('B4D',B4D->(Recno()))
        self:oJson["insurerJustification"] := self:maskField(aRet[1])
        self:oJson["providerJustification"] := self:maskField(aRet[2] + aRet[3])
    endif

Return

Method setGuide(lGetJust) Class HealthApiGlossedAppealReportService
    
    local oItem := JsonObject():new()
    Default lGetJust := .F.

    oItem["idOnHealthInsurer"] := (self:cAliTrb)->(GUIA)
    oItem["subscriberId"] := self:maskField((self:cAliTrb)->(MATRIC))
    oItem["subscriberName"] := self:maskField((self:cAliTrb)->(NOMUSR))
    oItem["authorizationDate"] := self:maskField((self:cAliTrb)->(DATPRO),.T.)
    oItem["guidePaidValue"] := self:maskField((self:cAliTrb)->(VLRPAG))
    oItem["guideGlossedValue"] := self:maskField((self:cAliTrb)->(VLRGLO))

    if lGetJust
        aRet = self:getJustifications('B4D',B4D->(Recno()))
        oItem["insurerJustification"] := self:maskField(aRet[1])
        oItem["providerJustification"] := self:maskField(aRet[2] + aRet[3])
    endif

Return oItem

Method setEvent(lGetJust) Class HealthApiGlossedAppealReportService

    local oEvent := JsonObject():new()
    local aGlosas := {}
    local cGlosas := ""
    local aRet := {}
    local nX := 0
    local cCodPad    := ""
    local cCodPro    := ""
    local cCodTabela := ""
    local cCodProc 	 := ""

    default lGetJust := .F.

    aGlosas := Pls498DesG("",(self:cAliTrb)->CODOPE,(self:cAliTrb)->CODLDP,;
                             (self:cAliTrb)->CODPEG,(self:cAliTrb)->NUMERO,;                              
                             (self:cAliTrb)->ORIMOV,(self:cAliTrb)->CODPAD,;
                             (self:cAliTrb)->CODPRO,(self:cAliTrb)->SEQUEN,3)

    for nX:=1 to len(aGlosas)
        cGlosas += iif(nX>1,", ","")
        cGlosas += alltrim(aGlosas[nX])
    next   
	
    cCodPad    := Alltrim((self:cAliTrb)->CODPAD)
    cCodPro    := Alltrim((self:cAliTrb)->CODPRO)
    cCodTabela := PLSGETVINC("BTU_CDTERM", "BR4", .F., "87",  cCodPad,.T.)
    cCodProc   := PLSGETVINC("BTU_CDTERM", "BR8", .F., cCodPad, cCodPad+cCodPro, .F. ,self:aTabDup, @cCodTabela, .t.)

    oEvent["eventCode"] := Alltrim(cCodProc)
    oEvent["eventDescription"] := self:maskField((self:cAliTrb)->DESPRO)
    oEvent["quantity"] := self:maskField((self:cAliTrb)->QTDPRO)
    oEvent["paidValue"] := self:maskField((self:cAliTrb)->VLRPAG)
    oEvent["glossedValue"] := self:maskField((self:cAliTrb)->VLRGLO)
    oEvent["reconsideredValue"] := self:maskField((self:cAliTrb)->VLRREC)
    oEvent["acceptedValue"] := self:maskField((self:cAliTrb)->VLRACA)
    oEvent["status"] := self:maskField((self:cAliTrb)->STATUS)
    oEvent["gloss"] := self:maskField(cGlosas)

    if lGetJust
        aRet := self:getJustifications('B4E',(self:cAliTrb)->RECNO)
        oEvent["insurerJustification"] := self:maskField(aRet[1])
        oEvent["providerJustification"] := self:maskField(aRet[2] + aRet[3])
    endIf

Return oEvent

method getJustifications(cAlias,cRecno) Class HealthApiGlossedAppealReportService

    local cInsurerJust    := ''
    local cProtocolJust   := ''
    local cFormNumberJust := ''
    local cProviderJust   := ''
    Local aRet := {"","",""}

    if cAlias == "B4D"
        B4D->(dbsetorder(1))
        B4D->(dbgoto(cRecno))
        cInsurerJust := B4D->B4D_JUSOPE
        cProtocolJust := B4D->B4D_JUSPRO
        cFormNumberJust := B4D->B4D_JUSGUI
        aRet := { cInsurerJust, cProtocolJust, cFormNumberJust }
    
    elseIf cAlias == "B4E"
        B4E->(dbsetorder(1))
        B4E->(dbgoto(cRecno))
        cInsurerJust := B4E->B4E_JUSOPE
        cProviderJust := B4E->B4E_JUSPRE
        aRet := { cInsurerJust, cProviderJust, "" }
    endif

Return aRet

method maskField(xValue,lData) class HealthApiGlossedAppealReportService

    local xRet := nil
    default lData := .F.
    
    if lData
        if (!empty(xValue))
            if ValType(xValue) == "D"
                xValue := Dtos(xValue)
            endIf
            xRet := xValue
            cAno := SubStr(xRet,1,4)
            cMes := SubStr(xRet,5,2)
            cDia := SubStr(xRet,7,2)
            xRet := cAno + "-" + cMes + "-" + cDia
        endIf

    elseIf ValType(xValue) == "C"
        xRet := Alltrim(xValue)
    
    elseIf ValType(xValue) == "N"
        xRet := xValue
    endif

Return xRet
