#Include "PROTHEUS.CH"
#Include "TOTVS.CH"
#Include 'tlpp-core.th'
#Include 'tlpp-rest.th'
#Include "FWLIBVERSION.CH"

//-------------------------------------------------------------------
/*/{Protheus.doc} HealthApiGlossedAppealReportDao
.
@author  Sakai
@version P12
@since   02/02/2026
/*/
//-------------------------------------------------------------------
Class HealthApiGlossedAppealReportDao from PLSDaoAux

    data cProtoc as Character
    data cObjRec as Character
    data cTipGui as Character

    public method New(oRest,cSvcName) Constructor
    public method buscaProtocolo(cProtoc,cCodRda)
    public method getObjRec()
    public method getProtoc()
    public method getGuia()
    public method getProcGuiaEvento()
    private method getGuiaCampos()

EndClass

Method New() Class HealthApiGlossedAppealReportDao
    _Super:New("")
    self:cProtoc := ""
    self:cObjRec := ""
Return self

Method buscaProtocolo(cProtoc,cCodRda) Class HealthApiGlossedAppealReportDao

    Local lRet := .F.

    self:cProtoc := cProtoc
    B4D->(DbSetOrder(8)) //B4D_FILIAL+B4D_PROTOC
    if B4D->(DbSeek(xFilial("B4D")+self:cProtoc)) .And. B4D->B4D_CODRDA == cCodRda
        lRet := .T.
        self:cObjRec := B4D->B4D_OBJREC
        self:cTipGui := B4D->B4D_TIPGUI
    endIf

Return lRet

method getObjRec() Class HealthApiGlossedAppealReportDao
return self:cObjRec

Method getProtoc() Class HealthApiGlossedAppealReportDao

    Local cSql   := ""
    Local lFound := .F.
    Local cAlias := iif(self:cTipGui == "05","BE4","BD5")
    Local aBind  := {}
    Local cSpace := Space(1)

    cSql += " SELECT "
    cSql += self:getGuiaCampos()
    cSql += " FROM " + RetSqlName("B4D") + " B4D "        
    cSql += " INNER JOIN " + RetSqlName(cAlias) + " " + cAlias
    cSql += "   ON "+cAlias+"_FILIAL = ? "
    cSql += "   AND "+cAlias+"_CODOPE = B4D_OPEMOV "
    cSql += "   AND "+cAlias+"_CODLDP = B4D_CODLDP "
    cSql += "   AND "+cAlias+"_CODPEG = B4D_CODPEG "
    cSql += "   AND "+cAlias+".D_E_L_E_T_ = ? "        
    cSql += " WHERE "
    cSql += "   B4D_FILIAL = ? "
    cSql += "   AND B4D_PROTOC = ? "
    cSql += "   AND B4D.D_E_L_E_T_ = ? "

    aadd(aBind,xFilial(cAlias))
    aadd(aBind,cSpace)
    aadd(aBind,xFilial("B4D"))
    aadd(aBind,self:cProtoc)
    aadd(aBind,cSpace) 

    self:setQuery(PLSConSQL(cSql))
	lFound := self:executaQuery(.T.,aBind)
    
Return lFound

Method getGuia() Class HealthApiGlossedAppealReportDao

    Local cSql   := ""
    Local lFound := .F.  
    Local cAlias := iif(self:cTipGui == "05","BE4","BD5")
    Local aBind  := {}
    Local cSpace := Space(1)

    cSql += " SELECT "
    cSql += self:getGuiaCampos()
    cSql += " FROM " + RetSqlName("B4D") + " B4D "
    cSql += " INNER JOIN " + RetSqlName(cAlias) + " " + cAlias
    cSql += "   ON "+cAlias+"_FILIAL = ? "
    cSql += "   AND "+cAlias+"_CODOPE = B4D_OPEMOV "
    cSql += "   AND "+cAlias+"_CODLDP = B4D_CODLDP "
    cSql += "   AND "+cAlias+"_CODPEG = B4D_CODPEG "
    cSql += "   AND "+cAlias+"_NUMERO = B4D_NUMAUT "
    cSql += "   AND "+cAlias+".D_E_L_E_T_ = ? "
    cSql += " WHERE "
    cSql += "   B4D_FILIAL = ? "
    cSql += "   AND B4D_PROTOC = ? "
    cSql += "   AND B4D.D_E_L_E_T_ = ? "

    aadd(aBind,xFilial(cAlias))
    aadd(aBind,cSpace)
    aadd(aBind,xFilial("B4D"))
    aadd(aBind,self:cProtoc)
    aadd(aBind,cSpace)

    self:setQuery(PLSConSQL(cSql))
    lFound := self:executaQuery(.T.,aBind)

Return lFound

Method getGuiaCampos() Class HealthApiGlossedAppealReportDao
    Local cSql := ''
    Local cConcat := Iif(AllTrim(TcGetDB()) $ "DB2/ORACLE/POSTGRES","||","+")
    Local cAlias := iif(self:cTipGui == "05","BE4","BD5")    

    cSql += cAlias+"_CODPEG "
    cSql +=   cConcat+cAlias+"_NUMERO AS GUIA, "
    cSql += cAlias+"_OPEUSR "
    cSql +=   cConcat+cAlias+"_CODEMP "
    cSql +=   cConcat+cAlias+"_MATRIC "
    cSql +=   cConcat+cAlias+"_TIPREG "
    cSql +=   cConcat+cAlias+"_DIGITO AS MATRIC, "
    cSql += cAlias+"_NOMUSR AS NOMUSR, "
    cSql += cAlias+"_VLRBPR AS VLRGUIA, "
    cSql += cAlias+"_VLRGLO AS VLRGLO, "
    cSql += cAlias+"_VLRPAG AS VLRPAG, "
    cSql += cAlias+"_DATPRO AS DATPRO "

Return cSql

Method getProcGuiaEvento() Class HealthApiGlossedAppealReportDao

    Local cSql := ""
    Local lFound := .F.
    Local aBind  := {}
    Local cSpace := Space(1)

    cSql += " SELECT "

    cSql += "  BD6_CODOPE AS CODOPE "
    cSql += " ,BD6_CODLDP AS CODLDP "
    cSql += " ,BD6_CODPEG AS CODPEG "
    cSql += " ,BD6_NUMERO AS NUMERO "
    cSql += " ,BD6_ORIMOV AS ORIMOV "
    cSql += " ,BD6_CODPAD AS CODPAD "
    cSql += " ,BD6_CODPRO AS CODPRO "
    cSql += " ,BD6_SEQUEN AS SEQUEN "

    cSql += " ,BD6_DESPRO AS DESPRO "
    cSql += " ,BD6_QTDPRO AS QTDPRO "
    cSql += " ,BD6_VLRPAG AS VLRPAG "
    cSql += " ,BD6_VLRGLO AS VLRGLO "

    cSql += " ,B4E_VLRREC AS VLRREC "
    cSql += " ,B4E_VLRACA AS VLRACA "
    cSql += " ,B4E_STATUS AS STATUS "
    cSql += " ,B4E.R_E_C_N_O_ AS RECNO "

    cSql += " FROM " + RetSqlName("B4D") + " B4D "
    cSql += " INNER JOIN " + RetSqlName("BD6") + " BD6 "
    cSql += " 	ON BD6_FILIAL = ? "
    cSql += " 	AND BD6_CODOPE = B4D_OPEMOV "
    cSql += " 	AND BD6_CODLDP = B4D_CODLDP "
    cSql += " 	AND BD6_CODPEG = B4D_CODPEG "
    cSql += " 	AND BD6_NUMERO = B4D_NUMAUT "
    cSql += " 	AND BD6.D_E_L_E_T_ = ? "
    
    cSql += iif(self:cObjRec=="3","INNER","LEFT") + " JOIN " + RetSqlName("B4E") + " B4E "
    cSql += " 	ON B4E_FILIAL = ? "
    cSql += " 	AND B4E_SEQB4D = B4D_SEQB4D "
    cSql += " 	AND B4E_SEQUEN = BD6_SEQUEN "
    cSql += " 	AND B4E_CODPEG = BD6_CODPEG "
    cSql += " 	AND B4E_NUMAUT = BD6_NUMERO "
    cSql += " 	AND B4E.D_E_L_E_T_ = ? "
    cSql += " WHERE "
    cSql += " 	B4D_FILIAL = ? "
    cSql += "   AND B4D_PROTOC = ? "
    cSql += " 	AND B4D.D_E_L_E_T_ = ? "

    aadd(aBind,xFilial("BD6"))
    aadd(aBind,cSpace)
    aadd(aBind,xFilial("B4E"))
    aadd(aBind,cSpace)
    aadd(aBind,xFilial("B4D"))
    aadd(aBind,self:cProtoc)
    aadd(aBind,cSpace)

    self:setQuery(PLSConSQL(cSql))
    lFound := self:executaQuery(.T.,aBind)

Return lFound
