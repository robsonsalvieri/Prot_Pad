#include "totvs.ch"
#include "msobject.ch"
#include "tlpp-core.th"

namespace totvs.protheus.backoffice.contracts.general

static oSe1 := NIL
static oSe2 := NIL

/*/{Protheus.doc} BillNumberCache
    @description Mantém o cache e a geração sequencial de números de títulos.
    @type class
    @author guilherme.sordi@totvs.com.br
    @since 08/06/2026
    @version 12.1.2510
*/

class BillNumberCache
	private data cVarName as character
	private data jNumbers as json
	
	public method new() as object
	public method nextBillNumber(cPrefix, lPurchase, cContractBranch) as character
	public method clearCache()

	private method saveCache()
	private method loadCache()
	private method getMax(cPrefix, lPurchase, cContractBranch) as character
	private method exists(cPrefix as character, lPurchase as logical, cTableBranch as character, cBillNumber as character) as logical
endClass

/*/{Protheus.doc} new
    @description Inicializa a instância da classe com seus valores padrão.
    @author guilherme.sordi@totvs.com.br
    @since 08/06/2026
    @version 12.1.2510
/*/

method new() as object class BillNumberCache
	self:cVarName := "CNTA311NXT"
	self:jNumbers := JsonObject():New()
return self

/*/{Protheus.doc} saveCache
    @description Persiste o cache atual de numeração em variável global.
    @author guilherme.sordi@totvs.com.br
    @since 08/06/2026
    @version 12.1.2510
/*/

method saveCache() class BillNumberCache
	PutGlbValue(self:cVarName, self:jNumbers:toJson())
return

/*/{Protheus.doc} loadCache
    @description Carrega o cache de numeração persistido em variável global.
    @author guilherme.sordi@totvs.com.br
    @since 08/06/2026
    @version 12.1.2510
/*/

method loadCache() class BillNumberCache
	local cJson := GetGlbValue(self:cVarName)
	self:jNumbers:fromJson("{}")
	
	if !Empty(cJson)
		self:jNumbers:fromJson(cJson)
	endIf
return

/*/{Protheus.doc} clearCache
    @description Limpa o cache de numeração mantido em memória e em variável global.
    @author guilherme.sordi@totvs.com.br
    @since 08/06/2026
    @version 12.1.2510
/*/

method clearCache() class BillNumberCache
	self:jNumbers:fromJson("{}")
	PutGlbValue(self:cVarName, "{}")
return

/*/{Protheus.doc} getMax
    @description Consulta o maior número de título existente para a chave informada.
    @author guilherme.sordi@totvs.com.br
    @since 08/06/2026
    @version 12.1.2510
/*/

method getMax(cPrefix as character, lPurchase as logical, cTableBranch as character) as character class BillNumberCache
	local cBillNumber as character
	local cQuery as character
	local oExec as object

	if lPurchase
		cQuery := "SELECT MAX(SE2.E2_NUM) as NUMTIT "
		cQuery += " FROM "+ RetSQLName("SE2") +" SE2 "
		cQuery += " WHERE SE2.E2_FILIAL  = ? "
		cQuery += "   AND SE2.E2_PREFIXO = ? "
		cQuery += "   AND SE2.D_E_L_E_T_ = ? "
	else
		cQuery := "SELECT MAX(SE1.E1_NUM) as NUMTIT "
		cQuery += "  FROM "+ RetSQLName("SE1") +" SE1 "
		cQuery += " WHERE SE1.E1_FILIAL  = ? "
		cQuery += "   AND SE1.E1_PREFIXO = ? "
		cQuery += "   AND SE1.D_E_L_E_T_ = ? "
	endIf

	cQuery := ChangeQuery(cQuery)
	oExec := FWExecStatement():New(cQuery)
	oExec:setString(1, cTableBranch)
	oExec:setString(2, cPrefix)
	oExec:setString(3, space(1))

	cBillNumber := oExec:ExecScalar("NUMTIT")
	
	fwFreeObj(oExec)
return cBillNumber

/*/{Protheus.doc} nextBillNumber
    @description Calcula e reserva o próximo número de título disponível no cache.
    @author guilherme.sordi@totvs.com.br
    @since 08/06/2026
    @version 12.1.2510
/*/

method nextBillNumber(cPrefix as character, lPurchase as logical, cContractBranch as character) as character class BillNumberCache
	local cBillNumber as character
	local cTable := if(lPurchase, "SE2", "SE1") as character
	local cBranch := if(lPurchase, FwXFilial("SE2", cContractBranch), FwXFilial("SE1", cContractBranch))
	local cKey := cTable + "_" + cBranch + "_" + cPrefix

	ThreadLock():lock("ContractsNextNumber", 100)
	
	self:loadCache()

	if self:jNumbers:hasProperty(cKey)
		cBillNumber := self:jNumbers[cKey]
		ConsoleLog():info("[BILL NUMBER] Cache hit for key " + cKey + ": " + cBillNumber)
	else
		cBillNumber := self:getMax(cPrefix, lPurchase, cBranch)
		ConsoleLog():info("[BILL NUMBER] Cache miss for key " + cKey + ": " + cBillNumber)
	endIf

	cBillNumber := soma1(cBillNumber)
	
	while self:exists(cPrefix, lPurchase, cBranch, cBillNumber)
		cBillNumber := soma1(cBillNumber)		
	endDo	
	
	self:jNumbers[cKey] := cBillNumber
	self:saveCache()

	ThreadLock():unlock("ContractsNextNumber")
return cBillNumber

/*/{Protheus.doc} exists
    @description Verifica se um número de título já existe na base para a chave informada.
    @author guilherme.sordi@totvs.com.br
    @since 08/06/2026
    @version 12.1.2510
/*/

method exists(cPrefix as character, lPurchase as logical, cTableBranch as character, cBillNumber as character) as logical class BillNumberCache
	local cQuery as character
	local lExists as logical
	local oExec as object

	if lPurchase
		if oSe2 == NIL
			cQuery := "SELECT COALESCE(COUNT(*),0) as COUNT_TIT "
			cQuery += " FROM "+ RetSQLName("SE2") +" SE2 "
			cQuery += " WHERE SE2.E2_FILIAL  = ? "
			cQuery += "   AND SE2.E2_PREFIXO = ? "
			cQuery += "   AND SE2.E2_NUM = ? "
			cQuery += "   AND SE2.D_E_L_E_T_ = ? "

			cQuery := changeQuery(cQuery)
			oSe2 := FWExecStatement():New(cQuery)
		endIf
		oExec := oSe2
	else
		if oSe1 == NIL
			cQuery := "SELECT COALESCE(COUNT(*),0) as COUNT_TIT "
			cQuery += "  FROM "+ RetSQLName("SE1") +" SE1 "
			cQuery += " WHERE SE1.E1_FILIAL  = ? "
			cQuery += "   AND SE1.E1_PREFIXO = ? "
			cQuery += "   AND SE1.E1_NUM = ? "
			cQuery += "   AND SE1.D_E_L_E_T_ = ? "

			cQuery := changeQuery(cQuery)
			oSe1 := FWExecStatement():New(cQuery)
		endIf
		oExec := oSe1
	endIf

	oExec:setString(1, cTableBranch)
	oExec:setString(2, cPrefix)
	oExec:setString(3, cBillNumber)
	oExec:setString(4, space(1))

	lExists := oExec:ExecScalar("COUNT_TIT") > 0

return lExists
