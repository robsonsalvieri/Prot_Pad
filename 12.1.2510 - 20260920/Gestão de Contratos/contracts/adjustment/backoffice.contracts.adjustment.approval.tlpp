#include "totvs.ch"
#include "tlpp-core.th"

namespace totvs.protheus.backoffice.contracts.adjustment
using namespace totvs.protheus.backoffice.contracts.general

//-------------------------------------------------------------------
/*/{Protheus.doc} ContractAdjustmentApproval
    @description Orquestra o fluxo otimizado de aprovacao de revisao de medicao para contratos.
        Coordena atualizacoes em lote de CND, CXN, CNE, CNZ, AC9 e SC7 atraves de UPDATE
        via FlowControl():execSql(), eliminando posicionamento registro a registro desnecessario.
    @type class
    @author claudio.yoshio@totvs.com.br
    @since 21/07/2026
    @version 12.1.2510
/*/
//-------------------------------------------------------------------
class ContractAdjustmentApproval
    private data cContractCode as character
    private data cCurrentRevision as character
    private data cTargetRevision as character
    private data cContractBranch as character
    
    public method new(cContractCode as character, cCurrentRevision as character, cTargetRevision as character, cContractBranch as character) as object
    public method execute()

    private method updateCndRevisionInBatch()
    private method updateRelatedTablesRevisionInBatch()
    private method updateKnowledgeBaseEntities()
    private method updatePurchaseOrderRevision()
endclass

//-------------------------------------------------------------------
/*/{Protheus.doc} new
    @description Construtor da classe ContractAdjustmentApproval. Recebe os dados
        do contrato/revisao e prepara o contexto para execucao em lote.
    @param cContractCode, character, codigo do contrato
    @param cCurrentRevision, character, revisao atual
    @param cTargetRevision, character, nova revisao
    @param cContractBranch, character, filial do contrato
    @return object, instancia da classe
    @author claudio.yoshio@totvs.com.br
    @since 21/07/2026
    @version 12.1.2510
/*/
//-------------------------------------------------------------------
method new(cContractCode as character, cCurrentRevision as character, cTargetRevision as character, cContractBranch as character) as object class ContractAdjustmentApproval
    self:cContractCode := cContractCode
    self:cContractBranch := cContractBranch
    self:cCurrentRevision := cCurrentRevision
    self:cTargetRevision := cTargetRevision
return self

//-------------------------------------------------------------------
/*/{Protheus.doc} execute
    @description Executa o fluxo em lote: UPDATE de CND, CXN, CNE, CNZ via FlowControl():execSql(),
        seguido de atualizacao de revisao do pedido de compra (SC7) e
        atualizacao de entidades na base de conhecimento registro a registro.
    @author claudio.yoshio@totvs.com.br
    @since 21/07/2026
    @version 12.1.2510
/*/
//-------------------------------------------------------------------
method execute() class ContractAdjustmentApproval
    self:updateCndRevisionInBatch()
    self:updateRelatedTablesRevisionInBatch()
    self:updatePurchaseOrderRevision()
    self:updateKnowledgeBaseEntities()
return

//-------------------------------------------------------------------
/*/{Protheus.doc} updateCndRevisionInBatch
    @description UPDATE em lote de CND_REVISA via FlowControl():execSql(), trocando a revisao
        antiga pela nova em todos os registros do contrato.
    @return logical, .T. se executou com sucesso
    @author claudio.yoshio@totvs.com.br
    @since 21/07/2026
    @version 12.1.2510
/*/
//-------------------------------------------------------------------
method updateCndRevisionInBatch() class ContractAdjustmentApproval
    local cUpdateCommand := "" as character
    local cNotDeleted := space(1) as character

    cUpdateCommand := "UPDATE " + retSqlName("CND")
    cUpdateCommand += " SET CND_REVISA = '" + self:cTargetRevision + "'"
    cUpdateCommand += " WHERE CND_CONTRA = '" + self:cContractCode + "'"
    cUpdateCommand += " AND CND_REVISA = '" + self:cCurrentRevision + "'"
    cUpdateCommand += " AND CND_FILCTR = '" + self:cContractBranch + "'"
    cUpdateCommand += " AND D_E_L_E_T_ = '" + cNotDeleted + "'"

    FlowControl():execSql(cUpdateCommand)
return

//-------------------------------------------------------------------
/*/{Protheus.doc} updateRelatedTablesRevisionInBatch
    @description UPDATE em lote de CXN_REVISA, CNE_REVISA, CNZ_REVISA via FlowControl():execSql().
        Usa WHERE EXISTS com subquery correlacionada na CND - sintaxe ANSI
        compativel com SQL Server, PostgreSQL e Oracle.
    @return logical, .T. se executou com sucesso
    @author claudio.yoshio@totvs.com.br
    @since 21/07/2026
    @version 12.1.2510
/*/
//-------------------------------------------------------------------
method updateRelatedTablesRevisionInBatch() class ContractAdjustmentApproval
    local cUpdateCommand := "" as character
    local aRelatedTableAliases := {"CXN", "CNE", "CNZ"} as array
    local nLenRelatedTables := len(aRelatedTableAliases) as numeric
    local nIndex := 0 as numeric
    local cCurrentAlias := "" as character
    local cPhysicalTableName := "" as character
    local cCndPhysicalTable := "" as character
    local cNotDeleted := space(1) as character

    cCndPhysicalTable := retSqlName("CND")

    for nIndex := 1 to nLenRelatedTables
        cCurrentAlias := aRelatedTableAliases[nIndex]
        cPhysicalTableName := retSqlName(cCurrentAlias)

        cUpdateCommand := "UPDATE " + cPhysicalTableName
        cUpdateCommand += " SET " + cCurrentAlias + "_REVISA = '" + self:cTargetRevision + "'"
        cUpdateCommand += " WHERE EXISTS ("
        cUpdateCommand += "     SELECT 1"
        cUpdateCommand += "     FROM " + cCndPhysicalTable + " CND"
        cUpdateCommand += "     WHERE CND.CND_NUMMED = " + cPhysicalTableName + "." + cCurrentAlias + "_NUMMED"
        cUpdateCommand += "       AND CND.CND_CONTRA = '" + self:cContractCode + "'"
        cUpdateCommand += "       AND CND.CND_REVISA = '" + self:cTargetRevision + "'"
        cUpdateCommand += "       AND CND.CND_FILCTR = '" + self:cContractBranch + "'"
        cUpdateCommand += "       AND CND.D_E_L_E_T_ = '" + cNotDeleted + "'"
        cUpdateCommand += " )"
        cUpdateCommand += " AND " + cCurrentAlias + "_FILIAL = '" + xFilial(cCurrentAlias) + "'"
        cUpdateCommand += " AND " + cCurrentAlias + "_CONTRA = '" + self:cContractCode + "'"
        cUpdateCommand += " AND " + cCurrentAlias + "_REVISA = '" + self:cCurrentRevision + "'"
        cUpdateCommand += " AND D_E_L_E_T_ = '" + cNotDeleted + "'"

        FlowControl():execSql(cUpdateCommand)
    next nIndex

return

//-------------------------------------------------------------------
/*/{Protheus.doc} updateKnowledgeBaseEntities
    @description Percorre os registros de CND atualizados e atualiza AC9 (base de
        conhecimento) via UPDATE por iteracao, usando igualdade exata em AC9_CODENT.
        Monta o identificador antigo e novo a partir dos campos da CND posicionada,
        sem uso de SUBSTRING ou LIKE.
    @return logical, .T. se executou com sucesso
    @author claudio.yoshio@totvs.com.br
    @since 22/07/2026
    @version 12.1.2510
/*/
//-------------------------------------------------------------------
method updateKnowledgeBaseEntities() class ContractAdjustmentApproval
    local cSelectQuery := "" as character
    local cUpdateCommand := "" as character
    local cQueryAlias := "" as character
    local cOldEntityCode := "" as character
    local cNewEntityCode := "" as character
    local oCndStatement as object
    local cNotDeleted := space(1) as character

    cSelectQuery := "SELECT CND_FILIAL, CND_CONTRA, CND_REVISA, CND_NUMMED"
    cSelectQuery += " FROM " + retSqlName("CND")
    cSelectQuery += " WHERE CND_FILCTR = ?"
    cSelectQuery += " AND CND_CONTRA = ?"
    cSelectQuery += " AND CND_REVISA = ?"
    cSelectQuery += " AND D_E_L_E_T_ = ?"

    cSelectQuery := ChangeQuery(cSelectQuery)
    oCndStatement := FWExecStatement():New(cSelectQuery)
    oCndStatement:SetString(1, self:cContractBranch)
    oCndStatement:SetString(2, self:cContractCode)
    oCndStatement:SetString(3, self:cTargetRevision)
    oCndStatement:SetString(4, cNotDeleted)
    cQueryAlias := oCndStatement:OpenAlias()

    while !(cQueryAlias)->(Eof())
        cOldEntityCode := (cQueryAlias)->CND_FILIAL + (cQueryAlias)->CND_CONTRA + self:cCurrentRevision + (cQueryAlias)->CND_NUMMED
        cNewEntityCode := (cQueryAlias)->CND_FILIAL + (cQueryAlias)->CND_CONTRA + (cQueryAlias)->CND_REVISA + (cQueryAlias)->CND_NUMMED

        if cOldEntityCode != cNewEntityCode
            cUpdateCommand := "UPDATE " + retSqlName("AC9")
            cUpdateCommand += " SET AC9_CODENT = '" + cNewEntityCode + "'"
            cUpdateCommand += " WHERE AC9_FILENT = '" + (cQueryAlias)->CND_FILIAL + "'"
            cUpdateCommand += " AND AC9_ENTIDA = 'CND'"
            cUpdateCommand += " AND AC9_CODENT = '" + cOldEntityCode + "'"
            cUpdateCommand += " AND D_E_L_E_T_ = '" + cNotDeleted + "'"

            FlowControl():execSql(cUpdateCommand)
        endIf

        (cQueryAlias)->(DbSkip())
    endDo

    (cQueryAlias)->(DbCloseArea())
    FwFreeObj(oCndStatement)
return

//-------------------------------------------------------------------
/*/{Protheus.doc} updatePurchaseOrderRevision
    @description Atualiza o numero da revisao do pedido de compra (SC7) gerado
        pela medicao na revisao de contratos. Equivalente a funcao CNA300RvPd,
        porem encapsulado como metodo da classe.
    @return logical, .T. se executou com sucesso
    @author claudio.yoshio@totvs.com.br
    @since 23/07/2026
    @version 12.1.2510
/*/
//-------------------------------------------------------------------
method updatePurchaseOrderRevision() class ContractAdjustmentApproval
    local cUpdateCommand := "" as character
    local cNotDeleted := space(1) as character

    cUpdateCommand := "UPDATE " + RetSqlName("SC7")
    cUpdateCommand += " SET C7_CONTREV = '" + self:cTargetRevision + "'"
    cUpdateCommand += " WHERE C7_FILIAL = '" + xFilial("CND", self:cContractBranch) + "'"
    cUpdateCommand += " AND C7_CONTRA = '" + self:cContractCode + "'"
    cUpdateCommand += " AND C7_CONTREV = '" + self:cCurrentRevision + "'"
    cUpdateCommand += " AND D_E_L_E_T_ = '" + cNotDeleted + "'"

    FlowControl():execSql(cUpdateCommand)
return
