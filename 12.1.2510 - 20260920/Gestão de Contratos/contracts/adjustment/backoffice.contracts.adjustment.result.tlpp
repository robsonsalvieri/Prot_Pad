#include "totvs.ch"
#include "msobject.ch"
#include "tlpp-core.th"

namespace totvs.protheus.backoffice.contracts.adjustment

//-------------------------------------------------------------------
/*/{Protheus.doc} ContractAdjustmentResult
	Stable result returned by the legacy adjustment boundary.
	It never exposes models, aliases, workareas, or legacy static state.
	    @since 11/05/2026
*/
//-------------------------------------------------------------------
class ContractAdjustmentResult
	public data lSuccess as logical
	public data cErrorCode as character
	public data cErrorMessage as character
	public data nAdjustedValue as numeric
	public data cExecutionId as character
	public data cWorkerId as character
	public data cAdjustmentNumber as character
	public data cBranch as character
	public data cContract as character
	public data cRevision as character
	public data cNewRevision as character
	public data jMessages as json
	public data jDetails as json

	public method new() as object
	public method markSuccess(cMessage as character) as object
	public method markError(cErrorCode as character, cErrorMessage as character) as object
	public method addMessage(cType as character, cCode as character, cMessage as character) as object
	public method setAdjustedValue(nAdjustedValue as numeric) as object
	public method setNewRevision(cNewRevision as character) as object
	public method copyTraceFromContext(oContext as object) as object
	public method fromJson(cJson as character) as object
	public method toJson() as character
	public method addDetail(cProperty as character, cValue as character) as object
	public method addJsonDetail(cProperty as character, xValue) as object

	private method resetMessages() as object
	private method buildMessage(cType as character, cCode as character, cMessage as character) as json
endClass

/*/{Protheus.doc} new
	@description Inicializa o resultado padrao da execucao de reajuste.
	@author guilherme.sordi@totvs.com.br
	@since 11/05/2026
	@version 12.1.2510
/*/
method new() as object class ContractAdjustmentResult
	self:lSuccess := .T.
	self:cErrorCode := ""
	self:cErrorMessage := ""
	self:nAdjustedValue := 0
	self:cExecutionId := ""
	self:cWorkerId := ""
	self:cAdjustmentNumber := ""
	self:cBranch := ""
	self:cContract := ""
	self:cRevision := ""
	self:cNewRevision := ""
	self:jDetails := JsonObject():New()
	self:resetMessages()
return self

/*/{Protheus.doc} markSuccess
	@description Marca o resultado como sucesso e registra mensagem informativa opcional.
	@author guilherme.sordi@totvs.com.br
	@since 11/05/2026
	@version 12.1.2510
/*/
method markSuccess(cMessage as character) as object class ContractAdjustmentResult
	self:lSuccess := .T.
	self:cErrorCode := ""
	self:cErrorMessage := ""

	if !Empty(cMessage)
		self:addMessage("INFO", "SUCCESS", cMessage)
	endIf
return self

/*/{Protheus.doc} markError
	@description Marca o resultado como erro e registra o codigo e a mensagem padronizados.
	@author guilherme.sordi@totvs.com.br
	@since 11/05/2026
	@version 12.1.2510
/*/
method markError(cErrorCode as character, cErrorMessage as character) as object class ContractAdjustmentResult
	self:lSuccess := .F.
	self:cErrorCode := AllTrim(cErrorCode)
	self:cErrorMessage := AllTrim(cErrorMessage)
	self:addMessage("ERROR", self:cErrorCode, self:cErrorMessage)
return self

/*/{Protheus.doc} addMessage
	@description Adiciona uma mensagem estruturada a lista interna do resultado.
	@author guilherme.sordi@totvs.com.br
	@since 11/05/2026
	@version 12.1.2510
/*/
method addMessage(cType as character, cCode as character, cMessage as character) as object class ContractAdjustmentResult
	aAdd(self:jMessages["items"], self:buildMessage(cType, cCode, cMessage))
return self

/*/{Protheus.doc} setAdjustedValue
	@description Define o valor reajustado consolidado no resultado.
	@author guilherme.sordi@totvs.com.br
	@since 11/05/2026
	@version 12.1.2510
/*/
method setAdjustedValue(nAdjustedValue as numeric) as object class ContractAdjustmentResult
	self:nAdjustedValue := nAdjustedValue
return self

/*/{Protheus.doc} setNewRevision
	@description Define a nova revisao gerada pelo processamento legado.
	@author guilherme.sordi@totvs.com.br
	@since 11/05/2026
	@version 12.1.2510
/*/
method setNewRevision(cNewRevision as character) as object class ContractAdjustmentResult
	self:cNewRevision := AllTrim(cNewRevision)
return self

/*/{Protheus.doc} copyTraceFromContext
	@description Copia para o resultado os identificadores de rastreabilidade do contexto.
	@author guilherme.sordi@totvs.com.br
	@since 11/05/2026
	@version 12.1.2510
/*/
method copyTraceFromContext(oContext as object) as object class ContractAdjustmentResult
	if oContext == NIL
		return self
	endIf

	self:cExecutionId := oContext:cExecutionId
	self:cWorkerId := oContext:cWorkerId
	self:cBranch := oContext:cBranch
	self:cContract := oContext:cContract
	self:cRevision := oContext:cRevision
	self:cAdjustmentNumber := oContext:cAdjustmentNumber
return self

/*/{Protheus.doc} addDetail
	@description Adiciona um detalhe textual complementar ao resultado.
	@author guilherme.sordi@totvs.com.br
	@since 11/05/2026
	@version 12.1.2510
/*/
method addDetail(cProperty as character, cValue as character) as object class ContractAdjustmentResult
	if !Empty(cProperty)
		self:jDetails[cProperty] := cValue
	endIf
return self

/*/{Protheus.doc} addJsonDetail
	@description Adiciona um detalhe estruturado em JSON ao resultado atual.
	@author guilherme.sordi@totvs.com.br
	@since 19/05/2026
	@version 12.1.2510
/*/
method addJsonDetail(cProperty as character, xValue as variant) as object class ContractAdjustmentResult
	if !Empty(cProperty)
		self:jDetails[cProperty] := xValue
	endIf
return self

/*/{Protheus.doc} fromJson
	@description Carrega no resultado os dados serializados em JSON.
	@author guilherme.sordi@totvs.com.br
	@since 23/05/2026
	@version 12.1.2510
/*/
method fromJson(cJson as character) as object class ContractAdjustmentResult
	local jSource := JsonObject():New() as json
	local cMessagesType := "" as character

	if Empty(cJson)
		return self
	endIf

	jSource:fromJson(cJson)

	if jSource:hasProperty("success")
		self:lSuccess := jSource["success"]
	endIf

	if jSource:hasProperty("errorCode")
		self:cErrorCode := cValToChar(jSource["errorCode"])
	endIf

	if jSource:hasProperty("errorMessage")
		self:cErrorMessage := cValToChar(jSource["errorMessage"])
	endIf

	if jSource:hasProperty("adjustedValue")
		self:nAdjustedValue := jSource["adjustedValue"]
	endIf

	if jSource:hasProperty("executionId")
		self:cExecutionId := cValToChar(jSource["executionId"])
	endIf

	if jSource:hasProperty("workerId")
		self:cWorkerId := cValToChar(jSource["workerId"])
	endIf

	if jSource:hasProperty("adjustmentNumber")
		self:cAdjustmentNumber := cValToChar(jSource["adjustmentNumber"])
	endIf

	if jSource:hasProperty("branch")
		self:cBranch := cValToChar(jSource["branch"])
	endIf

	if jSource:hasProperty("contract")
		self:cContract := cValToChar(jSource["contract"])
	endIf

	if jSource:hasProperty("revision")
		self:cRevision := cValToChar(jSource["revision"])
	endIf

	if jSource:hasProperty("newRevision")
		self:cNewRevision := cValToChar(jSource["newRevision"])
	endIf

	if jSource:hasProperty("details")
		self:jDetails := jSource["details"]
	endIf

	if jSource:hasProperty("messages")
		cMessagesType := ValType(jSource["messages"])
		if cMessagesType == "J" .or. cMessagesType == "O"
			self:jMessages := jSource["messages"]
		endIf
	endIf

	if self:jMessages == NIL .or. !self:jMessages:hasProperty("items")
		self:resetMessages()
	endIf

return self

/*/{Protheus.doc} toJson
	@description Serializa o resultado atual para um objeto JSON de saida.
	@author guilherme.sordi@totvs.com.br
	@since 11/05/2026
	@version 12.1.2510
/*/
method toJson() as character class ContractAdjustmentResult
	local jResult := JsonObject():New() as json

	jResult["success"] := self:lSuccess
	jResult["errorCode"] := self:cErrorCode
	jResult["errorMessage"] := self:cErrorMessage
	jResult["adjustedValue"] := self:nAdjustedValue
	jResult["executionId"] := self:cExecutionId
	jResult["workerId"] := self:cWorkerId
	jResult["adjustmentNumber"] := self:cAdjustmentNumber
	jResult["branch"] := self:cBranch
	jResult["contract"] := self:cContract
	jResult["revision"] := self:cRevision
	jResult["newRevision"] := self:cNewRevision
	jResult["details"] := self:jDetails
	jResult["messages"] := self:jMessages
return jResult:toJson()

/*/{Protheus.doc} resetMessages
	@description Reinicializa a estrutura interna de mensagens do resultado.
	@author guilherme.sordi@totvs.com.br
	@since 11/05/2026
	@version 12.1.2510
/*/
method resetMessages() as object class ContractAdjustmentResult
	self:jMessages := JsonObject():New()
	self:jMessages["items"] := {}
return self

/*/{Protheus.doc} buildMessage
	@description Monta um objeto JSON de mensagem estruturada para o resultado.
	@author guilherme.sordi@totvs.com.br
	@since 11/05/2026
	@version 12.1.2510
/*/
method buildMessage(cType as character, cCode as character, cMessage as character) as json class ContractAdjustmentResult
	local jMessage := JsonObject():New() as json

	jMessage["type"] := AllTrim(cType)
	jMessage["code"] := AllTrim(cCode)
	jMessage["message"] := AllTrim(cMessage)
return jMessage
