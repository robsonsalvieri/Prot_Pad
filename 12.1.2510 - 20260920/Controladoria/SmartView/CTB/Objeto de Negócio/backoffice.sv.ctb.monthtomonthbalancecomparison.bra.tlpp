//-------------------------------------------------------------------
/*/{Protheus.doc} CtCmpSldM
    Ser· usado para criar a temporaria
    
	@author wilton.santos
    @since 28/11/2023
    @version 12.1.2310
/*/
//-------------------------------------------------------------------
method CtCmpSldM(oFilter as object,cAlias as character,cEntid as character) as variant class MonthtoMonthBalanceComparisonSmartViewBusinessObject
Local aSaveArea 	:= GetArea()     		 as array
Local aChave        := {}     				 as array
Local cEntidIni		:= "" as character
Local cEntidFim		:= "" as character
Local cEntidIni1	:= "" as character
Local cEntidFim1	:= "" as character
Local cEntidIni2	:= "" as character
Local cEntidFim2	:= "" as character
Local nTRB			:= 1  as numeric
Local nCont			:= 0  as numeric
Local nX			:= 0  as numeric
Local aStruTMP		:= {}
Local nColunas	    := 0 as numeric
Local aTamVlr	 	:= TAMSX3("CT2_VALOR") as array 
Local cCampoQry     := "" 				   as character
Local cOrdQry     	:= "" 				   as character
Local cQuery 			  				   as character
Local nMes  			  				   as numeric
Local cQuerySldA          				   as character
Local cQuerySldB          				   as character
Local cQuerySldC          				   as character
Local cCampUSU      :=" " 				   as character
Local cFilUSU       :=" " 				   as character
Local cArqTmp       :=" " 				   as character

Local cSaldoA		:= ::cSaldoA  as character
Local cSaldoB       := ::cSaldoB  as character
Local cSaldoC		:= ::cSaldoC  as character

Local lSldA			:= .F. as logical
Local lSldB			:= .F. as logical
Local lSldC			:= .F. as logical

Local cAlias			   as character
local nParamOrder   := 1   as integer

Local aSaldos       := {}  as array	// usado pelos blocos Case "CT3"/"CTI" (T2/T3 - DSERCTR1-52515): pares {cPrefixo,cValorSaldo} dos saldos A/B/C ativos, na ordem, para MontaSubQrySaldoAgg
Local nSaldo        := 0   as integer	// usado pelos blocos Case "CT3"/"CTI" (T2/T3 - DSERCTR1-52515): indice de percurso de aSaldos ao montar as colunas de saida da subquery derivada SLDAGG
Local cSubQrySldAgg := "" as character	// usado pelos blocos Case "CT3"/"CTI" (T2/T3 - DSERCTR1-52515): texto "( SELECT ... ) SLDAGG" retornado por MontaSubQrySaldoAgg, concatenado no FROM
Local aChaveAgrup    := {}  as array	// usado pelo bloco Case "CTI" (T3 - DSERCTR1-52515): chave fisica de agrupamento (CQ7_CONTA/CQ7_CCUSTO/CQ7_ITEM/CQ7_CLVL) passada a MontaSubQrySaldoAgg
Local cColunas       := "" as character	// usado pelo bloco Case "CTU" (T8 - DSERCTR1-52515): lista de colunas SUM(CASE WHEN...) geradas por MontaColSaldoMes, usada para montar manualmente a subquery SLDAGG sobre CQ9 (MontaSubQrySaldoAgg nao aceita o filtro extra CQ9_IDENT)

Private cPlanoRef	:= ::aSetOfBook[11] as array
Private cVersao		:= ::aSetOfBook[12] as array


lSldA				:= !Empty(::cSaldoA) 
lSldB				:= !Empty(::cSaldoB) 
lSldC				:= !Empty(::cSaldoC) 
cEntid		       	:= Iif(cEntid == Nil,'',cEntid) 

//Tratamento para filtro de usuario  -WILTON
If Empty(cFilUSU)
	cFilUSU := ".T." 
EndIf

/// TRATAMENTO PARA OBTEN«√O DO SALDO DAS CONTAS ANALITICAS
Do Case
Case cAlias == "CT7"
	aChave	:= {"CONTA"}
	
	cCampUSU  := ""	
	
	// T7 (DSERCTR1-52515) - mesma tecnica do piloto CT3 (T2): substitui as subqueries
	// correlacionadas de CtQryComp por uma subquery derivada de pre-agregacao
	// (MontaSubQrySaldoAgg/MontaColSaldoMes, T1), concatenada dentro do FROM. Caso mais
	// simples de todos: uma unica entidade (CT1/Conta), sem cartesiano com outra tabela.
	
	// Monta aSaldos apenas com os saldos A/B/C efetivamente ativos, na ordem, para alimentar
	// MontaSubQrySaldoAgg (que por sua vez chama MontaColSaldoMes uma vez por saldo ativo)
	aSaldos := {}
	If lSldA
		aAdd(aSaldos,{"COLA",cSaldoA})
	EndIf
	If lSldB
		aAdd(aSaldos,{"COLB",cSaldoB})
	EndIf
	If lSldC
		aAdd(aSaldos,{"COLC",cSaldoC})
	EndIf
	
	// Subquery derivada de pre-agregacao sobre CQ1 (saldo por Conta), varredura unica do
	// periodo total, agrupada pela mesma chave usada hoje na correlacao (CQ1_CONTA).
	cSubQrySldAgg := self:MontaSubQrySaldoAgg("SLDAGG","CQ1",{"CQ1_CONTA"},::cMoeda,aSaldos,::aMeses,::lAcum,::lImpAntLP,::dDataLP,::dDataIni,::dDataFim,@nParamOrder)
	
	cQuery := "SELECT CT1_CONTA CONTA, CT1_RES CTARES, CT1_DESC"+::cMoeda+" DESCCTA, CT1_CLASSE TIPOCONTA, CT1_CTASUP CTASUP "
	cQuery += cCampUSU									//// ADICIONA OS CAMPOS NA QUERY
	
	// Colunas de saida vindas da subquery derivada SLDAGG: uma por mes/saldo ativo. Se
	// ::lVlrZerado (MV_PAR15==1) o JOIN abaixo sera LEFT, entao usa-se COALESCE para
	// reproduzir o comportamento atual de exibir 0,00 quando a Conta nao tiver saldo
	// lancado no periodo.
	For nMes := 1 to ::nLenMeses
		For nSaldo := 1 to Len(aSaldos)
			cQuery += ", "
			If ::lVlrZerado
				cQuery += "COALESCE(SLDAGG."+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))+",0) "+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))
			Else
				cQuery += "SLDAGG."+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))+" "+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))
			EndIf
		Next
	Next
	
	// FROM: mesma logica de CT3, mas com uma unica entidade -- nao ha cartesiano a evitar.
	//  - !::lVlrZerado (default): parte-se de SLDAGG e faz-se INNER JOIN com CT1 apenas
	//    para buscar as descricoes.
	//  - ::lVlrZerado (MV_PAR15==1): parte-se de CT1 e faz-se LEFT JOIN com SLDAGG, usando
	//    COALESCE (acima) para exibir 0,00 quando nao houver saldo casado.
	If ::lVlrZerado
		cQuery += " FROM "+RetSqlName("CT1")+" ARQ "
		cQuery += " LEFT JOIN "+cSubQrySldAgg+" ON SLDAGG.CQ1_CONTA = ARQ.CT1_CONTA "
	Else
		cQuery += " FROM "+cSubQrySldAgg
		cQuery += " INNER JOIN "+RetSqlName("CT1")+" ARQ ON ARQ.CT1_CONTA = SLDAGG.CQ1_CONTA "
	EndIf
	
	cQuery += " WHERE ARQ.CT1_FILIAL = ? "
				aAdd(self:aBind,{nParamOrder++,FwxFilial("CT1")})

	cQuery += " AND ARQ.CT1_CONTA BETWEEN ? AND ? "
				aAdd(self:aBind,{nParamOrder++,::cContaIni})
				aAdd(self:aBind,{nParamOrder++,::cContaFim})
	cQuery += " AND ARQ.CT1_CLASSE =  ? 	"
				aAdd(self:aBind,{nParamOrder++,'2'})
	
	If !Empty(::aSetOfBook[1])
		cQuery += " AND ARQ.CT1_BOOK LIKE ?"
		aAdd(self:aBind,{nParamOrder++,"%"+::aSetOfBook[1]+"%"})	
	Endif
	
	cQuery += " AND ARQ.D_E_L_E_T_ = ? "
	aAdd(self:aBind,{nParamOrder++,space(1)})
	
	// BUG #7 (DSERCTR1-52515): so aplica-se ao ramo !::lVlrZerado -- em ::lVlrZerado a
	// enumeracao de Contas sem saldo (COALESCE incluido) e o comportamento desejado.
	If !::lVlrZerado
		cQuery += " AND "+self:MontaCondSaldoNaoZero("SLDAGG",aSaldos,::nLenMeses)
	EndIf
	
Case cAlias == "CT3"
	// T2 (DSERCTR1-52515) - piloto: substitui as 52 subqueries correlacionadas de CtQryComp
	// por uma subquery derivada de pre-agregacao (MontaSubQrySaldoAgg/MontaColSaldoMes, T1),
	// concatenada dentro do FROM (nao mais como CTE/WITH - ChangeQuery() do Protheus rejeita
	// textualmente a palavra reservada WITH; ver Protheus.doc de MontaSubQrySaldoAgg) + JOIN
	// unico com o cartesiano de entidades CT1 x CTT, que permanece igual (ver RCA secao 7).
	aChave	:= {"CONTA","CUSTO"}
	
	cCampUSU  := ""										//// DECLARA VARIAVEL COM OS CAMPOS DO FILTRO DE USU?RIO
	
	// Monta aSaldos apenas com os saldos A/B/C efetivamente ativos, na ordem, para alimentar
	// MontaSubQrySaldoAgg (que por sua vez chama MontaColSaldoMes uma vez por saldo ativo)
	aSaldos := {}
	If lSldA
		aAdd(aSaldos,{"COLA",cSaldoA})
	EndIf
	If lSldB
		aAdd(aSaldos,{"COLB",cSaldoB})
	EndIf
	If lSldC
		aAdd(aSaldos,{"COLC",cSaldoC})
	EndIf
	
	// Subquery derivada de pre-agregacao sobre CQ3 (saldo Conta+C.Custo), varredura unica do
	// periodo total, agrupada pelas mesmas chaves usadas hoje na correlacao
	// (CQ3_CONTA/CQ3_CCUSTO). Gerada ANTES dos filtros do WHERE externo para que os "?" da
	// subquery fiquem primeiro no texto final e o bind posicional (self:aBind) siga a mesma
	// ordem -- o texto e concatenado dentro do FROM, nao mais como prefixo WITH da query.
	cSubQrySldAgg := self:MontaSubQrySaldoAgg("SLDAGG","CQ3",{"CQ3_CONTA","CQ3_CCUSTO"},::cMoeda,aSaldos,::aMeses,::lAcum,::lImpAntLP,::dDataLP,::dDataIni,::dDataFim,@nParamOrder)
	
	cQuery := "SELECT CT1_CONTA CONTA, CT1_RES CTARES, CT1_DESC"+::cMoeda+" DESCCTA, CT1_CLASSE TIPOCONTA, CT1_CTASUP CTASUP, "
	cQuery += " 	  CTT_CUSTO CUSTO,  CTT_RES CCRES, CTT_DESC"+::cMoeda+" DESCCC, CTT_CLASSE TIPOCC, CTT_CCSUP CCSUP "
	cQuery += cCampUSU									//// ADICIONA OS CAMPOS NA QUERY (cCampUSU, quando preenchida, ja vem com virgula/campo proprios)
	
	// Colunas de saida vindas da subquery derivada SLDAGG: uma por mes/saldo ativo (cada
	// iteracao ja inclui a virgula separadora antes da coluna - por isso a lista estatica
	// de colunas acima NAO termina em virgula). Se ::lVlrZerado (MV_PAR15==1)
	// o JOIN abaixo sera LEFT, entao usa-se COALESCE para reproduzir o comportamento atual de
	// exibir 0,00 quando a combinacao Conta+C.Custo nao tiver saldo lancado no periodo.
	For nMes := 1 to ::nLenMeses
		For nSaldo := 1 to Len(aSaldos)
			cQuery += ", "
			If ::lVlrZerado
				cQuery += "COALESCE(SLDAGG."+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))+",0) "+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))
			Else
				cQuery += "SLDAGG."+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))+" "+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))
			EndIf
		Next
	Next
	
	// FROM: os dois estados de MV_PAR15 (::lVlrZerado) exigem formas DIFERENTES de FROM, nao
	// apenas troca de INNER/LEFT sobre a mesma base -- para nao materializar um produto
	// cartesiano CT1 x CTT desnecessario no caso mais comum (default, sem zerados):
	//
	//  - !::lVlrZerado (default): so interessam combinacoes que JA TEM saldo, e essas estao
	//    inteiramente contidas em SLDAGG (pequena, agregada, filtrada). Por isso parte-se de
	//    SLDAGG e faz-se INNER JOIN com CT1/CTT apenas para buscar as descricoes -- nenhum
	//    cartesiano CT1 x CTT e produzido, o que elimina tambem esse produto (nao so as 52
	//    subqueries de saldo).
	//  - ::lVlrZerado (MV_PAR15==1): e preciso enumerar TODAS as combinacoes Conta x C.Custo do
	//    intervalo, mesmo sem saldo -- aqui o cartesiano e genuinamente necessario, por isso
	//    parte-se de CT1 CROSS JOIN CTT (ANSI explicito, sem a ambiguidade da virgula antiga
	//    misturada com JOIN) e faz-se LEFT JOIN com SLDAGG, usando COALESCE (acima) para exibir
	//    0,00 quando nao houver saldo casado.
	//
	// ON: os nomes de coluna de SLDAGG sao os mesmos nomes fisicos do SELECT/GROUP BY dela
	// (CQ3_CONTA/CQ3_CCUSTO, ver MontaSubQrySaldoAgg) -- a subquery NAO cria aliases
	// "CONTA"/"CUSTO" para as colunas de agrupamento, apenas para as colunas de saldo.
	If ::lVlrZerado
		cQuery += " FROM "+RetSqlName("CT1")+" ARQ CROSS JOIN "+RetSqlName("CTT")+" ARQ2 "
		cQuery += " LEFT JOIN "+cSubQrySldAgg+" ON SLDAGG.CQ3_CONTA = ARQ.CT1_CONTA AND SLDAGG.CQ3_CCUSTO = ARQ2.CTT_CUSTO "
	Else
		// BUG #7 (DSERCTR1-52515, pos-piloto): "existe em SLDAGG" NAO equivale a "tem saldo
		// diferente de zero" -- SLDAGG agrupa por qualquer lancamento no periodo, mesmo que
		// a soma mensal feche em zero (tipico de contas de apuracao/zeramento de resultado,
		// ex.: CTBA960A). O filtro abaixo (MontaCondSaldoNaoZero) reproduz o "<> 0" que o
		// legado aplicava via N subqueries correlacionadas -- ver Protheus.doc do metodo.
		cQuery += " FROM "+cSubQrySldAgg
		cQuery += " INNER JOIN "+RetSqlName("CT1")+" ARQ ON ARQ.CT1_CONTA = SLDAGG.CQ3_CONTA "
		cQuery += " INNER JOIN "+RetSqlName("CTT")+" ARQ2 ON ARQ2.CTT_CUSTO = SLDAGG.CQ3_CCUSTO "
	EndIf
	
	cQuery += " WHERE ARQ2.CTT_FILIAL = ? "
		aAdd(self:aBind,{nParamOrder++,FwxFilial("CTT")})

	cQuery += " AND ARQ2.CTT_CUSTO BETWEEN ? AND ? "
		aAdd(self:aBind,{nParamOrder++,::cCCIni})
		aAdd(self:aBind,{nParamOrder++,::cCCFim})

	cQuery += " AND ARQ2.CTT_CLASSE = ? 	"
		aAdd(self:aBind,{nParamOrder++,'2' })
	
	If !Empty(::aSetOfBook[1])
		cQuery += " AND ARQ2.CTT_BOOK LIKE ? 	"
		aAdd(self:aBind,{nParamOrder++,"%"+::aSetOfBook[1]+"%"})
	Endif
	
	cQuery += " AND ARQ.CT1_FILIAL = ?	"
		aAdd(self:aBind,{nParamOrder++,FwxFilial("CT1")})

	cQuery += " AND ARQ.CT1_CONTA BETWEEN ? AND ? "
		aAdd(self:aBind,{nParamOrder++,::cContaIni})
		aAdd(self:aBind,{nParamOrder++,::cContaFim})
	
	cQuery += " AND ARQ.CT1_CLASSE = ? 	"
		aAdd(self:aBind,{nParamOrder++,'2' })
	
	If !Empty(::aSetOfBook[1])
		cQuery += " AND ARQ.CT1_BOOK LIKE ? "
		aAdd(self:aBind,{nParamOrder++,"%"+::aSetOfBook[1]+"%"})
	Endif
	
	cQuery += " AND ARQ.D_E_L_E_T_ = ?  	"
	aAdd(self:aBind,{nParamOrder++,space(1)})
	
	cQuery += " AND ARQ2.D_E_L_E_T_ = ?  	"
	aAdd(self:aBind,{nParamOrder++,space(1)})
	
	// BUG #7 (DSERCTR1-52515): so aplica-se ao ramo !::lVlrZerado -- em ::lVlrZerado a
	// enumeracao de combinacoes sem saldo (COALESCE incluido) e o comportamento desejado.
	If !::lVlrZerado
		cQuery += " AND "+self:MontaCondSaldoNaoZero("SLDAGG",aSaldos,::nLenMeses)
	EndIf
	
Case cAlias == "CT4"
	// T4 (DSERCTR1-52515) - mesma tecnica do piloto T2 (case "CT3") e de T3 (case "CTI"):
	// substitui as subqueries correlacionadas de CtQryComp por UMA subquery derivada de
	// pre-agregacao (MontaSubQrySaldoAgg/MontaColSaldoMes) sobre CQ5, concatenada no FROM
	// (nunca CTE/WITH - ver Protheus.doc de MontaSubQrySaldoAgg). Conta+Item participam
	// sempre; C.Custo (CTT) e condicional a ::lUsaCusto, igual ao comportamento original
	// deste Case.
	If ::lUsaCusto
		aChave := {"CONTA","CUSTO","ITEM"}
	Else
		aChave := {"CONTA","ITEM"}
	EndIf
	
	cCampUSU  := ""										//// DECLARA VARIAVEL COM OS CAMPOS DO FILTRO DE USUùRIO
	
	// Monta aSaldos apenas com os saldos A/B/C efetivamente ativos, na ordem, para alimentar
	// MontaSubQrySaldoAgg (mesma variavel Local ja declarada no topo de CtCmpSldM)
	aSaldos := {}
	If lSldA
		aAdd(aSaldos,{"COLA",cSaldoA})
	EndIf
	If lSldB
		aAdd(aSaldos,{"COLB",cSaldoB})
	EndIf
	If lSldC
		aAdd(aSaldos,{"COLC",cSaldoC})
	EndIf
	
	// Chave de agrupamento da subquery agregada: colunas fisicas de CQ5, condicionais
	// exatamente como aChave (saida) acima - CONTA e ITEM sempre, CCUSTO conforme uso.
	aChaveAgrup := {"CQ5_CONTA"}
	If ::lUsaCusto
		AADD(aChaveAgrup,"CQ5_CCUSTO")
	EndIf
	AADD(aChaveAgrup,"CQ5_ITEM")
	
	// Subquery derivada de pre-agregacao sobre CQ5 (saldo Conta+Item, com C.Custo
	// condicional), varredura unica do periodo total, agrupada pelas chaves fisicas acima.
	cSubQrySldAgg := self:MontaSubQrySaldoAgg("SLDAGG","CQ5",aChaveAgrup,::cMoeda,aSaldos,::aMeses,::lAcum,::lImpAntLP,::dDataLP,::dDataIni,::dDataFim,@nParamOrder)
	
	cQuery := "SELECT CT1_CONTA CONTA, CT1_RES CTARES, CT1_DESC"+::cMoeda+" DESCCTA, CT1_CLASSE TIPOCONTA, CT1_CTASUP CTASUP, "
	If ::lUsaCusto
		cQuery += " 	  CTT_CUSTO CUSTO,  CTT_RES CCRES, CTT_DESC"+::cMoeda+" DESCCC, CTT_CLASSE TIPOCC, CTT_CCSUP CCSUP, "
	EndIf
	cQuery += " 	  CTD_ITEM ITEM, CTD_RES ITEMRES, CTD_DESC"+::cMoeda+" DESCITEM, CTD_CLASSE TIPOITEM, CTD_ITSUP ITSUP "
	cQuery += cCampUSU									//// ADICIONA OS CAMPOS NA QUERY (cCampUSU, quando preenchida, ja vem com virgula/campo proprios)
	
	// Colunas de saida vindas da subquery derivada SLDAGG: uma por mes/saldo ativo, mesmo
	// padrao de T2/T3 (COALESCE quando ::lVlrZerado, coluna direta no INNER JOIN caso
	// contrario).
	For nMes := 1 to ::nLenMeses
		For nSaldo := 1 to Len(aSaldos)
			cQuery += ", "
			If ::lVlrZerado
				cQuery += "COALESCE(SLDAGG."+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))+",0) "+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))
			Else
				cQuery += "SLDAGG."+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))+" "+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))
			EndIf
		Next
	Next
	
	// FROM: mesmos dois ramos por ::lVlrZerado de T2/T3 -- ::lVlrZerado precisa do
	// cartesiano completo das entidades ativas (CROSS JOIN + LEFT JOIN + COALESCE acima);
	// !::lVlrZerado parte da subquery agregada (ja filtrada/pequena) e busca as descricoes
	// via INNER JOIN, sem materializar cartesiano nenhum. CT1 (Conta) e CTD (Item)
	// participam sempre; CTT (C.Custo) entra conforme ::lUsaCusto, igual ao FROM original
	// deste Case.
	If ::lVlrZerado
		cQuery += " FROM "+RetSqlName("CT1")+" ARQ CROSS JOIN "+RetSqlName("CTD")+" ARQ3 "
		If ::lUsaCusto
			cQuery += " CROSS JOIN "+RetSqlName("CTT")+" ARQ2 "
		EndIf
		cQuery += " LEFT JOIN "+cSubQrySldAgg+" ON SLDAGG.CQ5_CONTA = ARQ.CT1_CONTA AND SLDAGG.CQ5_ITEM = ARQ3.CTD_ITEM "
		If ::lUsaCusto
			cQuery += " AND SLDAGG.CQ5_CCUSTO = ARQ2.CTT_CUSTO "
		EndIf
	Else
		// Bug #7 (DSERCTR1-52515): "existir em SLDAGG" NAO equivale a "ter saldo diferente de
		// zero" -- ver Protheus.doc de MontaCondSaldoNaoZero. Filtro aplicado no WHERE abaixo.
		cQuery += " FROM "+cSubQrySldAgg
		cQuery += " INNER JOIN "+RetSqlName("CT1")+" ARQ ON ARQ.CT1_CONTA = SLDAGG.CQ5_CONTA "
		cQuery += " INNER JOIN "+RetSqlName("CTD")+" ARQ3 ON ARQ3.CTD_ITEM = SLDAGG.CQ5_ITEM "
		If ::lUsaCusto
			cQuery += " INNER JOIN "+RetSqlName("CTT")+" ARQ2 ON ARQ2.CTT_CUSTO = SLDAGG.CQ5_CCUSTO "
		EndIf
	EndIf
	
	cQuery += " WHERE "
	
	If ::lUsaCusto
		cQuery += "     ARQ2.CTT_FILIAL = ? 	"
		aAdd(self:aBind,{nParamOrder++,FwxFilial("CTT")})
	
		cQuery += " AND ARQ2.CTT_CUSTO BETWEEN ? AND ? "
		aAdd(self:aBind,{nParamOrder++,::cCCIni})
		aAdd(self:aBind,{nParamOrder++,::cCCFim})

		cQuery += " AND ARQ2.CTT_CLASSE =  ? "
		aAdd(self:aBind,{nParamOrder++,'2'})
		
		If !Empty(::aSetOfBook[1])
			cQuery += " AND ARQ2.CTT_BOOK LIKE ? "
			aAdd(self:aBind,{nParamOrder++,"%"+::aSetOfBook[1]+"%"})
		Endif
		
		cQuery += " AND "
	
	EndIf
	
	cQuery += "     ARQ.CT1_FILIAL = ?	"
	aAdd(self:aBind,{nParamOrder++,FwxFilial("CT1")})
	
	cQuery += " AND ARQ.CT1_CONTA BETWEEN ? AND ? 	"
	aAdd(self:aBind,{nParamOrder++,::cContaIni})
	aAdd(self:aBind,{nParamOrder++,::cContaFim})
	
	cQuery += " AND ARQ.CT1_CLASSE = ?  	"
	aAdd(self:aBind,{nParamOrder++,'2'})
	
	If !Empty(::aSetOfBook[1])
		cQuery += " AND ARQ.CT1_BOOK LIKE ? "
		aAdd(self:aBind,{nParamOrder++,"%"+::aSetOfBook[1]+"%"})
	Endif
	
	cQuery += " AND ARQ3.CTD_FILIAL = ? "
	aAdd(self:aBind,{nParamOrder++,FwxFilial("CTD")})

	cQuery += " AND ARQ3.CTD_ITEM BETWEEN ? AND ?	"
	aAdd(self:aBind,{nParamOrder++,::cItemIni})
	aAdd(self:aBind,{nParamOrder++,::cItemFim})
	
	cQuery += " AND ARQ3.CTD_CLASSE = ?  	"
	aAdd(self:aBind,{nParamOrder++,'2'})
	
	If !Empty(::aSetOfBook[1])
		cQuery += " AND ARQ3.CTD_BOOK LIKE ? "
		aAdd(self:aBind,{nParamOrder++,"%"+::aSetOfBook[1]+"%"})
	Endif
	
	If ::lUsaCusto
		cQuery += " AND ARQ2.D_E_L_E_T_ = ?  	"
		aAdd(self:aBind,{nParamOrder++,space(1)})
	EndIf
	
	cQuery += " AND ARQ.D_E_L_E_T_ = ?  	"
	aAdd(self:aBind,{nParamOrder++,space(1)})
	
	cQuery += " AND ARQ3.D_E_L_E_T_ = ?  	"
	aAdd(self:aBind,{nParamOrder++,space(1)})
	
	// Bug #7 (DSERCTR1-52515): so aplica-se ao ramo !::lVlrZerado -- em ::lVlrZerado a
	// enumeracao de combinacoes sem saldo (COALESCE incluido) e o comportamento desejado.
	If !::lVlrZerado
		cQuery += " AND "+self:MontaCondSaldoNaoZero("SLDAGG",aSaldos,::nLenMeses)
	EndIf
	
Case cAlias == "CTI"
	// T3 (DSERCTR1-52515) - mesma tecnica do piloto T2 (case "CT3"): substitui as subqueries
	// correlacionadas de CtQryComp, hoje montadas mes a mes dentro do laco
	// "For nCont := 1 to ::nLenMeses", por UMA subquery derivada de pre-agregacao
	// (MontaSubQrySaldoAgg/MontaColSaldoMes) sobre CQ7, concatenada no FROM (nunca CTE/WITH
	// - ver Protheus.doc de MontaSubQrySaldoAgg). Este e o caso com mais tabelas de entidade
	// (Conta+C.Custo+Item+Classe de Valor), por isso CTT (C.Custo) e CTD (Item) permanecem
	// condicionais a ::lUsaCusto/::lUsaItem, enquanto CT1 (Conta) e CTH (Classe de Valor)
	// participam sempre - igual ao comportamento original deste Case.
	aChave := {"CONTA"}
	
	If ::lUsaCusto 
		AADD(aChave,"CUSTO") 
	EndIf

	If ::lUsaItem  
		AADD(aChave,"ITEM")   
	EndIf
			
	AADD(aChave,"CLVL") 
				
	cCampUSU  := "" //// DECLARA VARIAVEL COM OS CAMPOS DO FILTRO DE USUùRIO
	
	// Monta aSaldos apenas com os saldos A/B/C efetivamente ativos, na ordem, para alimentar
	// MontaSubQrySaldoAgg (mesma variavel Local ja declarada no topo de CtCmpSldM)
	aSaldos := {}
	If lSldA
		aAdd(aSaldos,{"COLA",cSaldoA})
	EndIf
	If lSldB
		aAdd(aSaldos,{"COLB",cSaldoB})
	EndIf
	If lSldC
		aAdd(aSaldos,{"COLC",cSaldoC})
	EndIf
	
	// Chave de agrupamento da subquery agregada: colunas fisicas de CQ7, condicionais
	// exatamente como aChave (saida) acima - CONTA e CLVL sempre, CCUSTO/ITEM conforme uso.
	aChaveAgrup := {"CQ7_CONTA"}
	If ::lUsaCusto
		AADD(aChaveAgrup,"CQ7_CCUSTO")
	EndIf
	If ::lUsaItem
		AADD(aChaveAgrup,"CQ7_ITEM")
	EndIf
	AADD(aChaveAgrup,"CQ7_CLVL")
	
	// Subquery derivada de pre-agregacao sobre CQ7 (saldo Conta+C.Custo+Item+Classe de
	// Valor), varredura unica do periodo total, agrupada pelas chaves fisicas acima.
	cSubQrySldAgg := self:MontaSubQrySaldoAgg("SLDAGG","CQ7",aChaveAgrup,::cMoeda,aSaldos,::aMeses,::lAcum,::lImpAntLP,::dDataLP,::dDataIni,::dDataFim,@nParamOrder)
	
	cQuery := "SELECT CT1_CONTA CONTA, CT1_RES CTARES, CT1_DESC"+::cMoeda+" DESCCTA, CT1_CLASSE TIPOCONTA, CT1_CTASUP CTASUP, "
	If ::lUsaCusto
		cQuery += " 	  CTT_CUSTO CUSTO,  CTT_RES CCRES, CTT_DESC"+::cMoeda+" DESCCC, CTT_CLASSE TIPOCC, CTT_CCSUP CCSUP, "
	EndIf
	If ::lUsaItem
		cQuery += " 	  CTD_ITEM ITEM, CTD_RES ITEMRES, CTD_DESC"+::cMoeda+" DESCITEM, CTD_CLASSE TIPOITEM, CTD_ITSUP ITSUP, "
	EndIf
	cQuery += " 	  CTH_CLVL CLVL, CTH_RES CLVLRES, CTH_DESC"+::cMoeda+" DESCCLVL, CTH_CLASSE TIPOCLVL, CTH_CLSUP CLSUP "
	cQuery += cCampUSU									//// ADICIONA OS CAMPOS NA QUERY (cCampUSU, quando preenchida, ja vem com virgula/campo proprios)
	
	// Laco "For nCont := 1 to ::nLenMeses" ELIMINADO: MontaSubQrySaldoAgg/MontaColSaldoMes ja
	// cobrem TODOS os meses em uma unica passada de agregacao (uma coluna COLx<mes> por
	// saldo ativo), dispensando a montagem mes a mes via CtQryComp.
	For nMes := 1 to ::nLenMeses
		For nSaldo := 1 to Len(aSaldos)
			cQuery += ", "
			If ::lVlrZerado
				cQuery += "COALESCE(SLDAGG."+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))+",0) "+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))
			Else
				cQuery += "SLDAGG."+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))+" "+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))
			EndIf
		Next
	Next
	
	// FROM: mesmos dois ramos por ::lVlrZerado do piloto T2 -- ::lVlrZerado precisa do
	// cartesiano completo das entidades ativas (CROSS JOIN + LEFT JOIN + COALESCE acima);
	// !::lVlrZerado parte da subquery agregada (ja filtrada/pequena) e busca as descricoes
	// via INNER JOIN, sem materializar cartesiano nenhum. CT1 (Conta) e CTH (Classe de
	// Valor) participam sempre; CTT (C.Custo) e CTD (Item) entram conforme
	// ::lUsaCusto/::lUsaItem, igual ao FROM original deste Case.
	If ::lVlrZerado
		cQuery += " FROM "+RetSqlName("CT1")+" ARQ CROSS JOIN "+RetSqlName("CTH")+" ARQ4 "
		If ::lUsaCusto
			cQuery += " CROSS JOIN "+RetSqlName("CTT")+" ARQ2 "
		EndIf
		If ::lUsaItem
			cQuery += " CROSS JOIN "+RetSqlName("CTD")+" ARQ3 "
		EndIf
		cQuery += " LEFT JOIN "+cSubQrySldAgg+" ON SLDAGG.CQ7_CONTA = ARQ.CT1_CONTA AND SLDAGG.CQ7_CLVL = ARQ4.CTH_CLVL "
		If ::lUsaCusto
			cQuery += " AND SLDAGG.CQ7_CCUSTO = ARQ2.CTT_CUSTO "
		EndIf
		If ::lUsaItem
			cQuery += " AND SLDAGG.CQ7_ITEM = ARQ3.CTD_ITEM "
		EndIf
	Else
		cQuery += " FROM "+cSubQrySldAgg
		cQuery += " INNER JOIN "+RetSqlName("CT1")+" ARQ ON ARQ.CT1_CONTA = SLDAGG.CQ7_CONTA "
		cQuery += " INNER JOIN "+RetSqlName("CTH")+" ARQ4 ON ARQ4.CTH_CLVL = SLDAGG.CQ7_CLVL "
		If ::lUsaCusto
			cQuery += " INNER JOIN "+RetSqlName("CTT")+" ARQ2 ON ARQ2.CTT_CUSTO = SLDAGG.CQ7_CCUSTO "
		EndIf
		If ::lUsaItem
			cQuery += " INNER JOIN "+RetSqlName("CTD")+" ARQ3 ON ARQ3.CTD_ITEM = SLDAGG.CQ7_ITEM "
		EndIf
	EndIf
	
	cQuery += " WHERE "
	
	If ::lUsaCusto
		cQuery += "     ARQ2.CTT_FILIAL = ?	"
		aAdd(self:aBind,{nParamOrder++,FwxFilial("CTT")})
	
		cQuery += " AND ARQ2.CTT_CUSTO BETWEEN ? AND ? "
		aAdd(self:aBind,{nParamOrder++,::cCCIni})
		aAdd(self:aBind,{nParamOrder++,::cCCFim})

		cQuery += " AND ARQ2.CTT_CLASSE = ?  	"
		aAdd(self:aBind,{nParamOrder++,'2'})
		
		If !Empty(::aSetOfBook[1])
			cQuery += " AND ARQ2.CTT_BOOK LIKE ? 	"
			aAdd(self:aBind,{nParamOrder++,"%"+::aSetOfBook[1]+"%"})
		Endif

		cQuery += " AND "
	EndIf
	
	cQuery += "     ARQ.CT1_FILIAL = ? "
	aAdd(self:aBind,{nParamOrder++,FwxFilial("CT1")})
	
	cQuery += " AND ARQ.CT1_CONTA BETWEEN ? AND ? "
	aAdd(self:aBind,{nParamOrder++,::cContaIni})
	aAdd(self:aBind,{nParamOrder++,::cContaFim})

	cQuery += " AND ARQ.CT1_CLASSE = ?  	"
	aAdd(self:aBind,{nParamOrder++,'2'})
	If !Empty(::aSetOfBook[1])
		cQuery += " AND ARQ.CT1_BOOK LIKE ? "
		aAdd(self:aBind,{nParamOrder++,"%"+::aSetOfBook[1]+"%"})
	Endif
	If ::lUsaItem
		cQuery += " AND ARQ3.CTD_FILIAL = ? 	"
		aAdd(self:aBind,{nParamOrder++,FwxFilial("CTD")})

		cQuery += " AND ARQ3.CTD_ITEM BETWEEN ? AND ? "
		aAdd(self:aBind,{nParamOrder++,::cItemIni})
		aAdd(self:aBind,{nParamOrder++,::cItemFim})

		cQuery += " AND ARQ3.CTD_CLASSE = ?  	"
		aAdd(self:aBind,{nParamOrder++,'2'})
		
		If !Empty(::aSetOfBook[1])
			cQuery += " AND ARQ3.CTD_BOOK LIKE ? "
			aAdd(self:aBind,{nParamOrder++,"%"+::aSetOfBook[1]+"%"})
		Endif

	EndIf
	cQuery += " AND ARQ4.CTH_FILIAL = ?  	"
	aAdd(self:aBind,{nParamOrder++,FwxFilial("CTH")})
	
	cQuery += " AND ARQ4.CTH_CLVL BETWEEN ? AND ?	"
	aAdd(self:aBind,{nParamOrder++,::cClVlIni})
	aAdd(self:aBind,{nParamOrder++,::cClVlFim})

	cQuery += " AND ARQ4.CTH_CLASSE = ?  	"
	aAdd(self:aBind,{nParamOrder++,'2'})

	If !Empty(::aSetOfBook[1])
		cQuery += " AND ARQ4.CTH_BOOK LIKE ? "
		aAdd(self:aBind,{nParamOrder++,"%"+::aSetOfBook[1]+"%"})
	Endif
	
	cQuery += " AND ARQ.D_E_L_E_T_ = ? 	"
	aAdd(self:aBind,{nParamOrder++,space(1)})

	cQuery += " AND ARQ4.D_E_L_E_T_ = ?  	"
	aAdd(self:aBind,{nParamOrder++,space(1)})

	If ::lUsaCusto
		cQuery += " AND ARQ2.D_E_L_E_T_ = ?  	"
		aAdd(self:aBind,{nParamOrder++,space(1)})
	EndIf
	
	If ::lUsaItem
		cQuery += " AND ARQ3.D_E_L_E_T_ = ?  	"
		aAdd(self:aBind,{nParamOrder++,space(1)})
	EndIf
	
	// BUG #7 (DSERCTR1-52515): so aplica-se ao ramo !::lVlrZerado -- em ::lVlrZerado a
	// enumeracao de combinacoes sem saldo (COALESCE incluido) e o comportamento desejado.
	If !::lVlrZerado
		cQuery += " AND "+self:MontaCondSaldoNaoZero("SLDAGG",aSaldos,::nLenMeses)
	EndIf
			
Case cAlias == "CTU"
			
	// Centro de Custo
	If cEntid == "CTT"
		cEntidIni	:= ::cCCIni
		cEntidFim	:= ::cCCFim
		cCampoQry   := "CTT_CUSTO CUSTO, CTT_RES CCRES, CTT_DESC"+::cMoeda+" DESCCC, CTT_CLASSE TIPOCC, CTT_CCSUP CCSUP"
		cOrdQry		:= "CTT_CUSTO"
		aChave      := {"CUSTO"}
		
		// Item Contabil
	ElseIf cEntid == "CTD"
		cEntidIni	:= ::cItemIni
		cEntidFim	:= ::cItemFim
		cCampoQry   := "CTD_ITEM ITEM, CTD_RES ITEMRES, CTD_DESC"+::cMoeda+" DESCITEM, CTD_CLASSE TIPOITEM, CTD_ITSUP ITSUP"
		cOrdQry		:= "CTD_ITEM"
		aChave      := {"ITEM"}
		
		// Classe de Valor
	ElseIf cEntid == "CTH"
		cEntidIni	:= ::cClVlIni
		cEntidFim	:= ::cClVlFim
		cCampoQry   := "CTH_CLVL CLVL, CTH_RES CLVLRES, CTH_DESC"+::cMoeda+" DESCCLVL, CTH_CLASSE TIPOCLVL, CTH_CLSUP CLSUP"
		cOrdQry		:= "CTH_CLVL"
		aChave      := {"CLVL"}
	EndIf
	cCampUSU  := ""										//// DECLARA VARIAVEL COM OS CAMPOS DO FILTRO DE USUùRIO
	
	// T8 (DSERCTR1-52515) - CTU e estruturalmente diferente dos demais casos: nao chama
	// CtQryComp, monta as subqueries correlacionadas inline contra CQ9 (unica tabela de
	// saldo para as 3 entidades unicas C.Custo/Item/Cl.Valor, discriminadas por
	// CQ9_IDENT = cEntid). MontaSubQrySaldoAgg (T1) NAO aceita esse filtro extra (so
	// filtra FILIAL/MOEDA/TPSALD/DATA/D_E_L_E_T_ e agrupa pela(s) chave(s) passada(s)) --
	// por isso a subquery agregada SLDAGG e montada aqui, manualmente, reaproveitando
	// apenas MontaColSaldoMes (que gera so a LISTA DE COLUNAS por mes, sem WHERE) e
	// seguindo EXATAMENTE a mesma estrutura textual de MontaSubQrySaldoAgg (sem WITH,
	// nomes fisicos de coluna, filtro de data condicional a lAcum) para nao reintroduzir
	// os bugs 1-5 corrigidos em T1/T2 (ver "Licoes aprendidas" em tasks.md).
	
	// Monta aSaldos apenas com os saldos A/B/C efetivamente ativos, na ordem, para
	// alimentar MontaColSaldoMes (uma chamada por saldo ativo, mesmo laco que
	// MontaSubQrySaldoAgg faz internamente)
	aSaldos := {}
	If lSldA
		aAdd(aSaldos,{"COLA",cSaldoA})
	EndIf
	If lSldB
		aAdd(aSaldos,{"COLB",cSaldoB})
	EndIf
	If lSldC
		aAdd(aSaldos,{"COLC",cSaldoC})
	EndIf
	
	// Lista de colunas SUM(CASE WHEN...) por saldo ativo, uma chamada de MontaColSaldoMes
	// por saldo -- mesma logica de data usada por MontaSubQrySaldoAgg (lAcum tratado por
	// mes dentro do proprio CASE WHEN, ver Protheus.doc de MontaColSaldoMes)
	cColunas := ""
	For nSaldo := 1 to Len(aSaldos)
		cColunas += self:MontaColSaldoMes("CQ9", ::aMeses, ::lAcum, ::lImpAntLP, ::dDataLP, aSaldos[nSaldo,1], aSaldos[nSaldo,2], @nParamOrder)
		If nSaldo < Len(aSaldos)
			cColunas += ", "
		EndIf
	Next
	
	// Subquery derivada de pre-agregacao sobre CQ9 (saldo da entidade unica corrente),
	// varredura unica do periodo total, agrupada por CQ9_CODIGO -- os "?" ficam na mesma
	// ordem em que aparecem no texto para que o bind posicional (self:aBind) siga corretamente.
	// CQ9_IDENT = cEntid discrimina qual das 3 entidades (CTT/CTD/CTH) esta sendo agregada;
	// esse filtro entra so aqui, uma unica vez, e nao em MontaSubQrySaldoAgg.
	cSubQrySldAgg := "( SELECT CQ9_CODIGO, "+cColunas+" "
	cSubQrySldAgg += "FROM "+RetSqlName("CQ9")+" CQ9 "
	cSubQrySldAgg += "WHERE CQ9_FILIAL = ? "
	aAdd(self:aBind,{nParamOrder++,FwxFilial("CQ9")})
	
	cSubQrySldAgg += "AND CQ9_MOEDA = ? "
	aAdd(self:aBind,{nParamOrder++,::cMoeda})
	
	cSubQrySldAgg += "AND CQ9_TPSALD IN ("
	For nSaldo := 1 to Len(aSaldos)
		cSubQrySldAgg += "?"
		aAdd(self:aBind,{nParamOrder++,aSaldos[nSaldo,2]})
		If nSaldo < Len(aSaldos)
			cSubQrySldAgg += ","
		EndIf
	Next
	cSubQrySldAgg += ") "
	
	cSubQrySldAgg += "AND CQ9_IDENT = ? "
	aAdd(self:aBind,{nParamOrder++,cEntid})
	
	// Mesma correcao de bug #5 (saldo acumulado) aplicada em MontaSubQrySaldoAgg: com
	// lAcum, o filtro externo usa somente o limite superior (fim do periodo), sem
	// BETWEEN, para nao descartar historico anterior ao inicio do periodo antes da
	// agregacao -- cada CASE WHEN por mes (MontaColSaldoMes) continua responsavel pelo
	// recorte correto de cada coluna.
	If ::lAcum
		cSubQrySldAgg += "AND CQ9_DATA <= ? "
		aAdd(self:aBind,{nParamOrder++,DTOS(::dDataFim)})
	Else
		cSubQrySldAgg += "AND CQ9_DATA BETWEEN ? AND ? "
		aAdd(self:aBind,{nParamOrder++,DTOS(::dDataIni)})
		aAdd(self:aBind,{nParamOrder++,DTOS(::dDataFim)})
	EndIf
	
	cSubQrySldAgg += "AND CQ9.D_E_L_E_T_ = ? "
	aAdd(self:aBind,{nParamOrder++,space(1)})
	
	cSubQrySldAgg += "GROUP BY CQ9_CODIGO "
	cSubQrySldAgg += ") SLDAGG "
	
	cQuery := "SELECT " + cCampoQry
	cQuery += cCampUSU									//// ADICIONA OS CAMPOS NA QUERY
	
	// Colunas de saida vindas da subquery derivada SLDAGG: uma por mes/saldo ativo. Se
	// ::lVlrZerado (MV_PAR15==1) o JOIN abaixo sera LEFT, entao usa-se COALESCE para
	// reproduzir o comportamento atual de exibir 0,00 quando a entidade nao tiver saldo
	// lancado no periodo. No ramo !::lVlrZerado o JOIN e INNER com a propria SLDAGG, e
	// SUM(CASE WHEN...) ja nao produz NULL (ver Protheus.doc de MontaColSaldoMes) -- por
	// isso o valor agregado e usado direto, sem ROUND nem COALESCE: o legado aplicava
	// ROUND(SUM(...),2) apenas dentro da subquery correlacionada do filtro "<> 0" (nunca
	// nas colunas de saida em si, que sempre usaram SUM(CREDIT)-SUM(DEBITO) sem ROUND -
	// ver blocos lSldB/lSldC originais acima), entao nao ha equivalencia a preservar aqui.
	For nMes := 1 to ::nLenMeses
		For nSaldo := 1 to Len(aSaldos)
			cQuery += ", "
			If ::lVlrZerado
				cQuery += "COALESCE(SLDAGG."+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))+",0) "+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))
			Else
				cQuery += "SLDAGG."+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))+" "+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))
			EndIf
		Next
	Next
	
	// FROM: entidade unica (CTT/CTD/CTH conforme cEntid, ja resolvida em
	// cCampoQry/cOrdQry/cEntidIni/cEntidFim acima) -- sem cartesiano a evitar, mesma
	// logica de CT7 (T7), mas contra a subquery agregada de CQ9 montada acima.
	//  - !::lVlrZerado (default): parte-se de SLDAGG e faz-se INNER JOIN com a entidade
	//    apenas para buscar as descricoes.
	//  - ::lVlrZerado (MV_PAR15==1): parte-se da entidade e faz-se LEFT JOIN com SLDAGG,
	//    usando COALESCE (acima) para exibir 0,00 quando nao houver saldo casado.
	If ::lVlrZerado
		cQuery += " FROM "+RetSqlName(cEntid)+" ARQ "
		cQuery += " LEFT JOIN "+cSubQrySldAgg+" ON SLDAGG.CQ9_CODIGO = ARQ."+cOrdQry+" "
	Else
		cQuery += " FROM "+cSubQrySldAgg
		cQuery += " INNER JOIN "+RetSqlName(cEntid)+" ARQ ON ARQ."+cOrdQry+" = SLDAGG.CQ9_CODIGO "
	EndIf
	
	cQuery += "	WHERE ARQ."+cEntid+"_FILIAL = ? "
	aAdd(self:aBind,{nParamOrder++,FwxFilial(cEntid)})

	cQuery += "	AND ARQ."+cOrdQry+" BETWEEN ? AND ? "
	aAdd(self:aBind,{nParamOrder++,cEntidIni})
	aAdd(self:aBind,{nParamOrder++,cEntidFim})
	
	cQuery += "	AND ARQ."+cEntid+"_CLASSE = ? "
	aAdd(self:aBind,{nParamOrder++,'2'})
			
	If !Empty(::aSetOfBook[1])
		cQuery += " AND ARQ."+cEntid+"_BOOK LIKE ? 	"
		aAdd(self:aBind,{nParamOrder++,"%"+::aSetOfBook[1]+"%"})
	Endif
	
	cQuery += " AND ARQ.D_E_L_E_T_ = ? "
	aAdd(self:aBind,{nParamOrder++,space(1)})

	// BUG #7 (DSERCTR1-52515): so aplica-se ao ramo !::lVlrZerado -- "existir em SLDAGG"
	// nao equivale a "ter saldo diferente de zero" tambem para CQ9 (mesma agregacao por
	// GROUP BY dos demais casos). Em ::lVlrZerado a enumeracao de entidades sem saldo
	// (COALESCE incluido) e o comportamento desejado, entao o filtro nao se aplica ali.
	If !::lVlrZerado
		cQuery += " AND "+self:MontaCondSaldoNaoZero("SLDAGG",aSaldos,::nLenMeses)
	EndIf
		
Case cAlias == "CTV"
	// T6 (DSERCTR1-52515): mesma tecnica do piloto CT3 (T2) - substitui as subqueries
	// correlacionadas de CtQryComp por uma subquery derivada de pre-agregacao
	// (MontaSubQrySaldoAgg/MontaColSaldoMes, T1) sobre CQ5, agrupada por CQ5_CCUSTO/CQ5_ITEM,
	// + JOIN unico com as entidades CTT/CTD (sem produto cartesiano no ramo default). Ver
	// Protheus.doc de MontaSubQrySaldoAgg/MontaCondSaldoNaoZero e "Licoes aprendidas em T1/T2"
	// em tasks.md (bug #7: existir em SLDAGG != ter saldo != 0).
			
	aChave      := {"CUSTO","ITEM"}
	
	cEntidIni1	:=	::cCCIni
	cEntidFim1	:=	::cCCFim
	cEntidIni2	:=	::cItemIni
	cEntidFim2	:=	::cItemFim
			
	cCampUSU  := "" //// DECLARA VARIAVEL COM OS CAMPOS DO FILTRO DE USUùRIO
	
	// Monta aSaldos apenas com os saldos A/B/C efetivamente ativos, na ordem, para alimentar
	// MontaSubQrySaldoAgg (mesmo padrao de CT3)
	aSaldos := {}
	If lSldA
		aAdd(aSaldos,{"COLA",cSaldoA})
	EndIf
	If lSldB
		aAdd(aSaldos,{"COLB",cSaldoB})
	EndIf
	If lSldC
		aAdd(aSaldos,{"COLC",cSaldoC})
	EndIf
	
	cSubQrySldAgg := self:MontaSubQrySaldoAgg("SLDAGG","CQ5",{"CQ5_CCUSTO","CQ5_ITEM"},::cMoeda,aSaldos,::aMeses,::lAcum,::lImpAntLP,::dDataLP,::dDataIni,::dDataFim,@nParamOrder)
	
	cQuery := " SELECT CTT_CUSTO CUSTO, CTT_RES CCRES, CTT_DESC"+::cMoeda+" DESCCC, CTT_CLASSE TIPOCC, CTT_CCSUP CCSUP, "
	cQuery += " 	    CTD_ITEM ITEM, CTD_RES ITEMRES, CTD_DESC"+::cMoeda+" DESCITEM, CTD_CLASSE TIPOITEM, CTD_ITSUP ITSUP "
	cQuery += cCampUSU									//// ADICIONA OS CAMPOS NA QUERY (cCampUSU, quando preenchida, ja vem com virgula/campo proprios)
	
	// Colunas de saida vindas da subquery derivada SLDAGG (uma por mes/saldo ativo). No ramo
	// ::lVlrZerado (MV_PAR15==1) o JOIN sera LEFT, entao usa-se COALESCE para exibir 0,00
	// quando a combinacao C.Custo+Item nao tiver saldo lancado no periodo.
	For nMes := 1 to ::nLenMeses
		For nSaldo := 1 to Len(aSaldos)
			cQuery += ", "
			If ::lVlrZerado
				cQuery += "COALESCE(SLDAGG."+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))+",0) "+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))
			Else
				cQuery += "SLDAGG."+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))+" "+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))
			EndIf
		Next
	Next
	
	// FROM: !::lVlrZerado parte da subquery agregada e faz INNER JOIN com as entidades (sem
	// cartesiano); ::lVlrZerado precisa enumerar todas as combinacoes C.Custo x Item, por isso
	// usa CROSS JOIN entre as entidades + LEFT JOIN com SLDAGG (COALESCE acima cobre a ausencia
	// de saldo). ON usa os nomes fisicos de coluna de SLDAGG (CQ5_CCUSTO/CQ5_ITEM).
	If ::lVlrZerado
		cQuery += " FROM "+RetSqlName("CTT")+" ARQ2 CROSS JOIN "+RetSqlName("CTD")+" ARQ3 "
		cQuery += " LEFT JOIN "+cSubQrySldAgg+" ON SLDAGG.CQ5_CCUSTO = ARQ2.CTT_CUSTO AND SLDAGG.CQ5_ITEM = ARQ3.CTD_ITEM "
	Else
		cQuery += " FROM "+cSubQrySldAgg
		cQuery += " INNER JOIN "+RetSqlName("CTT")+" ARQ2 ON ARQ2.CTT_CUSTO = SLDAGG.CQ5_CCUSTO "
		cQuery += " INNER JOIN "+RetSqlName("CTD")+" ARQ3 ON ARQ3.CTD_ITEM = SLDAGG.CQ5_ITEM "
	EndIf
	
	cQuery += " WHERE ARQ2.CTT_FILIAL = ? "
	aAdd(self:aBind,{nParamOrder++,FwxFilial("CTT")})

	cQuery += " AND ARQ2.CTT_CUSTO BETWEEN ? AND ? "
	aAdd(self:aBind,{nParamOrder++,::cCCIni})
	aAdd(self:aBind,{nParamOrder++,::cCCFim})
	
	cQuery += " AND ARQ2.CTT_CLASSE = ?  	"
	aAdd(self:aBind,{nParamOrder++,'2'})
	
	
	If !Empty(::aSetOfBook[1])
		cQuery += " AND ARQ2.CTT_BOOK LIKE ? "
		aAdd(self:aBind,{nParamOrder++,"%"+::aSetOfBook[1]+"%"})
	Endif
	
	cQuery += " AND ARQ3.CTD_FILIAL = ?	"
	aAdd(self:aBind,{nParamOrder++,FwxFilial("CTD")})

	cQuery += " AND ARQ3.CTD_ITEM BETWEEN ? AND ? 	"
	aAdd(self:aBind,{nParamOrder++,::cItemIni})
	aAdd(self:aBind,{nParamOrder++,::cItemFim})

	cQuery += " AND ARQ3.CTD_CLASSE = ?  	"
	aAdd(self:aBind,{nParamOrder++,'2'})
	
	If !Empty(::aSetOfBook[1])
		cQuery += " AND ARQ3.CTD_BOOK LIKE ? "
		aAdd(self:aBind,{nParamOrder++,"%"+::aSetOfBook[1]+"%"})
	Endif
	
	cQuery += " AND ARQ2.D_E_L_E_T_ = ?  	"
	aAdd(self:aBind,{nParamOrder++,space(1)})

	cQuery += " AND ARQ3.D_E_L_E_T_ = ?  	"
	aAdd(self:aBind,{nParamOrder++,space(1)})
			
	// Bug #7 (DSERCTR1-52515): so aplica-se ao ramo !::lVlrZerado -- em ::lVlrZerado a
	// enumeracao de combinacoes sem saldo (COALESCE incluido) e o comportamento desejado.
	If !::lVlrZerado
		cQuery += " AND "+self:MontaCondSaldoNaoZero("SLDAGG",aSaldos,::nLenMeses)
	EndIf
						
Case cAlias == "CTW"
	// T6 (DSERCTR1-52515): mesma tecnica do piloto CT3 (T2) - subquery derivada de
	// pre-agregacao (MontaSubQrySaldoAgg, T1) sobre CQ7, agrupada por CQ7_CCUSTO/CQ7_CLVL,
	// + JOIN unico com as entidades CTT/CTH. Ver Protheus.doc de MontaSubQrySaldoAgg/
	// MontaCondSaldoNaoZero e "Licoes aprendidas em T1/T2" em tasks.md (bug #7).
			
	aChave := {"CUSTO","CLVL"}	
	
	cCampUSU  := ""										//// DECLARA VARIAVEL COM OS CAMPOS DO FILTRO DE USUùRIO
	
	aSaldos := {}
	If lSldA
		aAdd(aSaldos,{"COLA",cSaldoA})
	EndIf
	If lSldB
		aAdd(aSaldos,{"COLB",cSaldoB})
	EndIf
	If lSldC
		aAdd(aSaldos,{"COLC",cSaldoC})
	EndIf
	
	cSubQrySldAgg := self:MontaSubQrySaldoAgg("SLDAGG","CQ7",{"CQ7_CCUSTO","CQ7_CLVL"},::cMoeda,aSaldos,::aMeses,::lAcum,::lImpAntLP,::dDataLP,::dDataIni,::dDataFim,@nParamOrder)
	
	cQuery := "SELECT CTT_CUSTO CUSTO, CTT_RES CCRES, CTT_DESC"+::cMoeda+" DESCCC, CTT_CLASSE TIPOCC, CTT_CCSUP CCSUP, "
	cQuery += "       CTH_CLVL CLVL, CTH_RES CLVLRES, CTH_DESC"+::cMoeda+" DESCCLVL, CTH_CLASSE TIPOCLVL, CTH_CLSUP CLSUP "
	cQuery += cCampUSU									//// ADICIONA OS CAMPOS NA QUERY (cCampUSU, quando preenchida, ja vem com virgula/campo proprios)
	
	// Colunas de saida vindas da subquery derivada SLDAGG (uma por mes/saldo ativo). No ramo
	// ::lVlrZerado (MV_PAR15==1) o JOIN sera LEFT, entao usa-se COALESCE para exibir 0,00
	// quando a combinacao C.Custo+Cl.Valor nao tiver saldo lancado no periodo.
	For nMes := 1 to ::nLenMeses
		For nSaldo := 1 to Len(aSaldos)
			cQuery += ", "
			If ::lVlrZerado
				cQuery += "COALESCE(SLDAGG."+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))+",0) "+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))
			Else
				cQuery += "SLDAGG."+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))+" "+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))
			EndIf
		Next
	Next
	
	// FROM: !::lVlrZerado parte da subquery agregada e faz INNER JOIN com as entidades (sem
	// cartesiano); ::lVlrZerado usa CROSS JOIN entre as entidades + LEFT JOIN com SLDAGG. ON
	// usa os nomes fisicos de coluna de SLDAGG (CQ7_CCUSTO/CQ7_CLVL).
	If ::lVlrZerado
		cQuery += " FROM "+RetSqlName("CTT")+" ARQ2 CROSS JOIN "+RetSqlName("CTH")+" ARQ4 "
		cQuery += " LEFT JOIN "+cSubQrySldAgg+" ON SLDAGG.CQ7_CCUSTO = ARQ2.CTT_CUSTO AND SLDAGG.CQ7_CLVL = ARQ4.CTH_CLVL "
	Else
		cQuery += " FROM "+cSubQrySldAgg
		cQuery += " INNER JOIN "+RetSqlName("CTT")+" ARQ2 ON ARQ2.CTT_CUSTO = SLDAGG.CQ7_CCUSTO "
		cQuery += " INNER JOIN "+RetSqlName("CTH")+" ARQ4 ON ARQ4.CTH_CLVL = SLDAGG.CQ7_CLVL "
	EndIf
	
	cQuery += " WHERE ARQ2.CTT_FILIAL = ? 	"
	aAdd(self:aBind,{nParamOrder++,FwxFilial("CTT")})
	
	cQuery += " AND ARQ2.CTT_CUSTO BETWEEN ? AND ? "
	aAdd(self:aBind,{nParamOrder++,::cCCIni})
	aAdd(self:aBind,{nParamOrder++,::cCCFim})
	
	cQuery += " AND ARQ2.CTT_CLASSE = ? 	"
	aAdd(self:aBind,{nParamOrder++,'2'})
			
	If !Empty(::aSetOfBook[1])
		cQuery += " AND ARQ2.CTT_BOOK LIKE ? "
		aAdd(self:aBind,{nParamOrder++,"%"+::aSetOfBook[1]+"%"})
	Endif
			
	cQuery += " AND ARQ4.CTH_FILIAL = ?	"
	aAdd(self:aBind,{nParamOrder++,FwxFilial("CTH")})

	cQuery += " AND ARQ4.CTH_CLVL BETWEEN ? AND ? "
	aAdd(self:aBind,{nParamOrder++,::cClVlIni})
	aAdd(self:aBind,{nParamOrder++,::cClVlFim})

	cQuery += " AND ARQ4.CTH_CLASSE = ?  	"
	aAdd(self:aBind,{nParamOrder++,'2'})
			
	If !Empty(::aSetOfBook[1])
		cQuery += " AND ARQ4.CTH_BOOK LIKE ? "
		aAdd(self:aBind,{nParamOrder++,"%"+::aSetOfBook[1]+"%"})
	Endif
			
	cQuery += " AND ARQ2.D_E_L_E_T_ = ?  	"
	aAdd(self:aBind,{nParamOrder++,space(1)})
	
	cQuery += " AND ARQ4.D_E_L_E_T_ = ?  	"
	aAdd(self:aBind,{nParamOrder++,space(1)})
			
	// Bug #7 (DSERCTR1-52515): so aplica-se ao ramo !::lVlrZerado.
	If !::lVlrZerado
		cQuery += " AND "+self:MontaCondSaldoNaoZero("SLDAGG",aSaldos,::nLenMeses)
	EndIf
			
Case cAlias == "CTX"
	// T6 (DSERCTR1-52515): mesma tecnica do piloto CT3 (T2) - subquery derivada de
	// pre-agregacao (MontaSubQrySaldoAgg, T1) sobre CQ7, agrupada por CQ7_ITEM/CQ7_CLVL,
	// + JOIN unico com as entidades CTD/CTH. Ver Protheus.doc de MontaSubQrySaldoAgg/
	// MontaCondSaldoNaoZero e "Licoes aprendidas em T1/T2" em tasks.md (bug #7).
			
	aChave := {"ITEM","CLVL"}
				
	cCampUSU  := ""										//// DECLARA VARIAVEL COM OS CAMPOS DO FILTRO DE USUùRIO
	
	aSaldos := {}
	If lSldA
		aAdd(aSaldos,{"COLA",cSaldoA})
	EndIf
	If lSldB
		aAdd(aSaldos,{"COLB",cSaldoB})
	EndIf
	If lSldC
		aAdd(aSaldos,{"COLC",cSaldoC})
	EndIf
	
	cSubQrySldAgg := self:MontaSubQrySaldoAgg("SLDAGG","CQ7",{"CQ7_ITEM","CQ7_CLVL"},::cMoeda,aSaldos,::aMeses,::lAcum,::lImpAntLP,::dDataLP,::dDataIni,::dDataFim,@nParamOrder)
	
	cQuery := "SELECT CTD_ITEM ITEM, CTD_RES ITEMRES, CTD_DESC"+::cMoeda+" DESCITEM, CTD_CLASSE TIPOITEM, CTD_ITSUP ITSUP, "
	cQuery += "       CTH_CLVL CLVL, CTH_RES CLVLRES, CTH_DESC"+::cMoeda+" DESCCLVL, CTH_CLASSE TIPOCLVL, CTH_CLSUP CLSUP "
	cQuery += cCampUSU									//// ADICIONA OS CAMPOS NA QUERY (cCampUSU, quando preenchida, ja vem com virgula/campo proprios)
	
	// Colunas de saida vindas da subquery derivada SLDAGG (uma por mes/saldo ativo). No ramo
	// ::lVlrZerado (MV_PAR15==1) o JOIN sera LEFT, entao usa-se COALESCE para exibir 0,00
	// quando a combinacao Item+Cl.Valor nao tiver saldo lancado no periodo.
	For nMes := 1 to ::nLenMeses
		For nSaldo := 1 to Len(aSaldos)
			cQuery += ", "
			If ::lVlrZerado
				cQuery += "COALESCE(SLDAGG."+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))+",0) "+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))
			Else
				cQuery += "SLDAGG."+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))+" "+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))
			EndIf
		Next
	Next
	
	// FROM: !::lVlrZerado parte da subquery agregada e faz INNER JOIN com as entidades (sem
	// cartesiano); ::lVlrZerado usa CROSS JOIN entre as entidades + LEFT JOIN com SLDAGG. ON
	// usa os nomes fisicos de coluna de SLDAGG (CQ7_ITEM/CQ7_CLVL).
	If ::lVlrZerado
		cQuery += " FROM "+RetSqlName("CTD")+" ARQ3 CROSS JOIN "+RetSqlName("CTH")+" ARQ4 "
		cQuery += " LEFT JOIN "+cSubQrySldAgg+" ON SLDAGG.CQ7_ITEM = ARQ3.CTD_ITEM AND SLDAGG.CQ7_CLVL = ARQ4.CTH_CLVL "
	Else
		cQuery += " FROM "+cSubQrySldAgg
		cQuery += " INNER JOIN "+RetSqlName("CTD")+" ARQ3 ON ARQ3.CTD_ITEM = SLDAGG.CQ7_ITEM "
		cQuery += " INNER JOIN "+RetSqlName("CTH")+" ARQ4 ON ARQ4.CTH_CLVL = SLDAGG.CQ7_CLVL "
	EndIf
	
	cQuery += " WHERE ARQ3.CTD_FILIAL = ?	"
	aAdd(self:aBind,{nParamOrder++,FwxFilial("CTD")})

	cQuery += " AND ARQ3.CTD_ITEM BETWEEN ? AND ?  	"
	aAdd(self:aBind,{nParamOrder++,::cItemIni})
	aAdd(self:aBind,{nParamOrder++,::cItemFim})

	cQuery += " AND ARQ3.CTD_CLASSE = ? 	"
	aAdd(self:aBind,{nParamOrder++,'2'})
			
	If !Empty(::aSetOfBook[1])
		cQuery += " AND ARQ3.CTD_BOOK LIKE ? "
		aAdd(self:aBind,{nParamOrder++,"%"+::aSetOfBook[1]+"%"})
	Endif
			
	cQuery += " AND ARQ4.CTH_FILIAL = ?  	"
	aAdd(self:aBind,{nParamOrder++,FwxFilial("CTH")})

	cQuery += " AND ARQ4.CTH_CLVL BETWEEN ? AND ?  	"
	aAdd(self:aBind,{nParamOrder++,::cClVlIni})
	aAdd(self:aBind,{nParamOrder++,::cClVlFim})

	cQuery += " AND ARQ4.CTH_CLASSE = ?  	"
	aAdd(self:aBind,{nParamOrder++,'2'})
			
	If !Empty(::aSetOfBook[1])
		cQuery += " AND ARQ4.CTH_BOOK LIKE ? "
		aAdd(self:aBind,{nParamOrder++,"%"+::aSetOfBook[1]+"%"})
	Endif
			
	cQuery += " AND ARQ3.D_E_L_E_T_ = ?  	"
	aAdd(self:aBind,{nParamOrder++,space(1)})

	cQuery += " AND ARQ4.D_E_L_E_T_ = ?  	"
	aAdd(self:aBind,{nParamOrder++,space(1)})
	
	// Bug #7 (DSERCTR1-52515): so aplica-se ao ramo !::lVlrZerado.
	If !::lVlrZerado
		cQuery += " AND "+self:MontaCondSaldoNaoZero("SLDAGG",aSaldos,::nLenMeses)
	EndIf
			
Case cAlias == "CTY"
	// T5 (DSERCTR1-52515) - propagacao da tecnica validada em T2/CT3: substitui as subqueries
	// correlacionadas de CtQryComp por uma subquery derivada de pre-agregacao
	// (MontaSubQrySaldoAgg/MontaColSaldoMes, T1), concatenada dentro do FROM (nao mais como
	// CTE/WITH - ChangeQuery() do Protheus rejeita textualmente a palavra reservada WITH; ver
	// Protheus.doc de MontaSubQrySaldoAgg). Chave de agrupamento fixa (C.Custo+Item+Cl.Valor,
	// sem entidade Conta e sem condicionais de lUsaCusto/lUsaItem, diferente de CTI/CT4).
	aChave := {"CUSTO","ITEM","CLVL"}
				
	cCampUSU  := ""										//// DECLARA VARIAVEL COM OS CAMPOS DO FILTRO DE USUùRIO
	
	// Monta aSaldos apenas com os saldos A/B/C efetivamente ativos, na ordem, para alimentar
	// MontaSubQrySaldoAgg (que por sua vez chama MontaColSaldoMes uma vez por saldo ativo)
	aSaldos := {}
	If lSldA
		aAdd(aSaldos,{"COLA",cSaldoA})
	EndIf
	If lSldB
		aAdd(aSaldos,{"COLB",cSaldoB})
	EndIf
	If lSldC
		aAdd(aSaldos,{"COLC",cSaldoC})
	EndIf
	
	// Subquery derivada de pre-agregacao sobre CQ7 (saldo C.Custo+Item+Cl.Valor), varredura
	// unica do periodo total, agrupada pelas mesmas chaves usadas hoje na correlacao
	// (CQ7_CCUSTO/CQ7_ITEM/CQ7_CLVL). Gerada ANTES dos filtros do WHERE externo para que os "?"
	// da subquery fiquem primeiro no texto final e o bind posicional (self:aBind) siga a mesma
	// ordem -- o texto e concatenado dentro do FROM, nao mais como prefixo WITH da query.
	cSubQrySldAgg := self:MontaSubQrySaldoAgg("SLDAGG","CQ7",{"CQ7_CCUSTO","CQ7_ITEM","CQ7_CLVL"},::cMoeda,aSaldos,::aMeses,::lAcum,::lImpAntLP,::dDataLP,::dDataIni,::dDataFim,@nParamOrder)
	
	cQuery := "SELECT CTH_CLVL CLVL, CTH_RES CLVLRES, CTH_DESC"+::cMoeda+" DESCCLVL, CTH_CLASSE TIPOCLVL, CTH_CLSUP CLSUP, "
	cQuery += " 	  CTT_CUSTO CUSTO,  CTT_RES CCRES, CTT_DESC"+::cMoeda+" DESCCC, CTT_CLASSE TIPOCC, CTT_CCSUP CCSUP, "
	cQuery += " 	  CTD_ITEM ITEM, CTD_RES ITEMRES, CTD_DESC"+::cMoeda+" DESCITEM, CTD_CLASSE TIPOITEM, CTD_ITSUP ITSUP "
	cQuery += cCampUSU									//// ADICIONA OS CAMPOS NA QUERY (cCampUSU, quando preenchida, ja vem com virgula/campo proprios)
	
	// Colunas de saida vindas da subquery derivada SLDAGG: uma por mes/saldo ativo (cada
	// iteracao ja inclui a virgula separadora antes da coluna - por isso a lista estatica de
	// colunas acima NAO termina em virgula). Se ::lVlrZerado (MV_PAR15==1) o JOIN abaixo sera
	// LEFT, entao usa-se COALESCE para reproduzir o comportamento atual de exibir 0,00 quando a
	// combinacao C.Custo+Item+Cl.Valor nao tiver saldo lancado no periodo.
	For nMes := 1 to ::nLenMeses
		For nSaldo := 1 to Len(aSaldos)
			cQuery += ", "
			If ::lVlrZerado
				cQuery += "COALESCE(SLDAGG."+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))+",0) "+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))
			Else
				cQuery += "SLDAGG."+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))+" "+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))
			EndIf
		Next
	Next
	
	// FROM: os dois estados de MV_PAR15 (::lVlrZerado) exigem formas DIFERENTES de FROM, nao
	// apenas troca de INNER/LEFT sobre a mesma base -- para nao materializar um produto
	// cartesiano CTT x CTD x CTH desnecessario no caso mais comum (default, sem zerados):
	//
	//  - !::lVlrZerado (default): so interessam combinacoes que JA TEM saldo, e essas estao
	//    inteiramente contidas em SLDAGG (pequena, agregada, filtrada). Por isso parte-se de
	//    SLDAGG e faz-se INNER JOIN com CTT/CTD/CTH apenas para buscar as descricoes -- nenhum
	//    cartesiano e produzido, o que elimina tambem esse produto (nao so as subqueries de
	//    saldo).
	//  - ::lVlrZerado (MV_PAR15==1): e preciso enumerar TODAS as combinacoes C.Custo x Item x
	//    Cl.Valor do intervalo, mesmo sem saldo -- aqui o cartesiano e genuinamente necessario,
	//    por isso parte-se de CTH CROSS JOIN CTT CROSS JOIN CTD (ANSI explicito, sem a
	//    ambiguidade da virgula antiga misturada com JOIN) e faz-se LEFT JOIN com SLDAGG, usando
	//    COALESCE (acima) para exibir 0,00 quando nao houver saldo casado.
	//
	// ON: os nomes de coluna de SLDAGG sao os mesmos nomes fisicos do SELECT/GROUP BY dela
	// (CQ7_CCUSTO/CQ7_ITEM/CQ7_CLVL, ver MontaSubQrySaldoAgg) -- a subquery NAO cria aliases
	// "CUSTO"/"ITEM"/"CLVL" para as colunas de agrupamento, apenas para as colunas de saldo.
	If ::lVlrZerado
		cQuery += " FROM "+RetSqlName("CTH")+" ARQ4 CROSS JOIN "+RetSqlName("CTT")+" ARQ2 CROSS JOIN "+RetSqlName("CTD")+" ARQ3 "
		cQuery += " LEFT JOIN "+cSubQrySldAgg+" ON SLDAGG.CQ7_CCUSTO = ARQ2.CTT_CUSTO AND SLDAGG.CQ7_ITEM = ARQ3.CTD_ITEM AND SLDAGG.CQ7_CLVL = ARQ4.CTH_CLVL "
	Else
		// BUG #7 (DSERCTR1-52515, licao aprendida em T2): "existe em SLDAGG" NAO equivale a
		// "tem saldo diferente de zero" -- SLDAGG agrupa por qualquer lancamento no periodo,
		// mesmo que a soma mensal feche em zero (tipico de contas de apuracao/zeramento de
		// resultado). O filtro abaixo (MontaCondSaldoNaoZero) reproduz o "<> 0" que o legado
		// aplicava via N subqueries correlacionadas -- ver Protheus.doc do metodo.
		cQuery += " FROM "+cSubQrySldAgg
		cQuery += " INNER JOIN "+RetSqlName("CTT")+" ARQ2 ON ARQ2.CTT_CUSTO = SLDAGG.CQ7_CCUSTO "
		cQuery += " INNER JOIN "+RetSqlName("CTD")+" ARQ3 ON ARQ3.CTD_ITEM = SLDAGG.CQ7_ITEM "
		cQuery += " INNER JOIN "+RetSqlName("CTH")+" ARQ4 ON ARQ4.CTH_CLVL = SLDAGG.CQ7_CLVL "
	EndIf
			
	cQuery += " WHERE ARQ2.CTT_FILIAL = ?  	"
	aAdd(self:aBind,{nParamOrder++,FwxFilial("CTT")})

	cQuery += " AND ARQ2.CTT_CUSTO BETWEEN ? AND ? "
	aAdd(self:aBind,{nParamOrder++,::cCCIni})
	aAdd(self:aBind,{nParamOrder++,::cCCFim})

	cQuery += " AND ARQ2.CTT_CLASSE = ?  	"
	aAdd(self:aBind,{nParamOrder++,'2'})
			
	If !Empty(::aSetOfBook[1])
		cQuery += " AND ARQ2.CTT_BOOK LIKE  ? 	"
		aAdd(self:aBind,{nParamOrder++,"%"+::aSetOfBook[1]+"%"})
	Endif
			
	cQuery += " AND ARQ3.CTD_FILIAL = ?  	"
	aAdd(self:aBind,{nParamOrder++,FwxFilial("CTD")})

	cQuery += " AND ARQ3.CTD_ITEM BETWEEN ? AND ?  	"
	aAdd(self:aBind,{nParamOrder++,::cItemIni})
	aAdd(self:aBind,{nParamOrder++,::cItemFim})

	cQuery += " AND ARQ3.CTD_CLASSE = ?  	"
	aAdd(self:aBind,{nParamOrder++,'2'})
			
	If !Empty(::aSetOfBook[1])
		cQuery += " AND ARQ3.CTD_BOOK LIKE ? "
		aAdd(self:aBind,{nParamOrder++,"%"+::aSetOfBook[1]+"%"})
	Endif
			
	cQuery += " AND ARQ4.CTH_FILIAL = ?  	"
	aAdd(self:aBind,{nParamOrder++,FwxFilial("CTH")})

	cQuery += " AND ARQ4.CTH_CLVL BETWEEN ? AND ? 	"
	aAdd(self:aBind,{nParamOrder++,::cClVlIni})
	aAdd(self:aBind,{nParamOrder++,::cClVlFim})

	cQuery += " AND ARQ4.CTH_CLASSE = ?  	"
	aAdd(self:aBind,{nParamOrder++,'2'})
			
	If !Empty(::aSetOfBook[1])
		cQuery += " AND ARQ4.CTH_BOOK LIKE ? "
		aAdd(self:aBind,{nParamOrder++,"%"+::aSetOfBook[1]+"%"})
	Endif
			
	cQuery += " AND ARQ4.D_E_L_E_T_ = ? "
	aAdd(self:aBind,{nParamOrder++,space(1)})

	cQuery += " AND ARQ2.D_E_L_E_T_ = ? "
	aAdd(self:aBind,{nParamOrder++,space(1)})

	cQuery += " AND ARQ3.D_E_L_E_T_ = ? "
	aAdd(self:aBind,{nParamOrder++,space(1)})
	
	// BUG #7 (DSERCTR1-52515): so aplica-se ao ramo !::lVlrZerado -- em ::lVlrZerado a
	// enumeracao de combinacoes sem saldo (COALESCE incluido) e o comportamento desejado.
	If !::lVlrZerado
		cQuery += " AND "+self:MontaCondSaldoNaoZero("SLDAGG",aSaldos,::nLenMeses)
	EndIf
			
EndCase
		
		If ! Empty( cQuery )
			cQuery := ChangeQuery(cQuery)
			
			self:oQuery := FWExecStatement():New(cQuery)

			//aBind[1] = numero da sequencia do Bind
			//aBind[2] = parametro substituido (todos est„o ou devem estar em string)
			For nX:=1 to len(self:aBind)
				self:oQuery:SetString(self:aBind[nX,1], self:aBind[nX,2])
			Next nX
			
			self:cAlias  := self:oQuery:OpenAlias()
			
			For nColunas := 1 to ::nLenMeses
				If lSldA
					TcSetField((::cAlias),"COLA"+Str(nColunas,Iif(nColunas>9,2,1)),"N",aTamVlr[1],aTamVlr[2])
				EndIf
				If lSldB
					TcSetField((::cAlias),"COLB"+Str(nColunas,Iif(nColunas>9,2,1)),"N",aTamVlr[1],aTamVlr[2])
				EndIf
				If lSldC
					TcSetField((::cAlias),"COLC"+Str(nColunas,Iif(nColunas>9,2,1)),"N",aTamVlr[1],aTamVlr[2])
				EndIf
			Next
		EndIf
		
		If !Empty(::aSetOfBook[5])				// Indica qual o Plano Gerencial Anexado
			aChave := {"CONTA"}
		Endif
		//preenchimento do array com os campos
		aCampos := self:criaTabTemp()

		::_oCTBR2951 := FWTemporaryTable():New( "cArqTmp" )  
		::_oCTBR2951:SetFields(aCampos) 
		::_oCTBR2951:AddIndex("1", aChave)

		If !Empty(::aSetOfBook[5])				// Indica qual o Plano Gerencial Anexado
			::_oCTBR2951:AddIndex("2", {"ORDEM"})
		Endif
					
		//-----------------------------
		//CriaÁ„o da tabela temporaria
		//-----------------------------
		::_oCTBR2951:Create()
		
		dbSelectArea("cArqTmp")
		
		If  Empty(::aSetOfBook[5])				/// S” H¡ QUERY SEM O PLANO GERENCIAL
			//// SE FOR DEFINI«√O TOP
			If Select((self:cAlias)) > 0		/// E O ALIAS TRBTMP ESTIVER ABERTO (INDICANDO QUE A QUERY FOI EXECUTADA)
				dbSelectArea((self:cAlias))
				aStruTMP := dbStruct()			/// OBTEM A ESTRUTURA DO TMP
				
				dbSelectArea((self:cAlias))
				dbGoTop()						/// POSICIONA NO 1∫ REGISTRO DO TMP
				
				While (self:cAlias)->(!Eof())			/// REPLICA OS DADOS DA QUERY (TRBTMP) PARA P/ O TEMPORARIO EM DISCO
					
					RecLock("cArqTMP",.T.)
					For nTRB := 1 to Len(aStruTMP)
						If Subs(aStruTmp[nTRB][1],1,4) $ "COLA/COLB/COLC" .And. ::nDivide > 1
							Field->&(aStruTMP[nTRB,1])	:= (((self:cAlias)->&(aStruTMP[nTRB,1])))/::nDivide
						Else
							Field->&(aStruTMP[nTRB,1]) := (self:cAlias)->&(aStruTMP[nTRB,1])
						EndIf
					Next
					cArqTMP->(MsUnlock())
					
					(self:cAlias)->(dbSkip())
				Enddo
				
				dbSelectArea((self:cAlias))
				(self:cAlias)->( DBCloseArea() )					/// FECHA O TRBTMP (RETORNADO DA QUERY)
			Endif
		EndIf
		
		dbSelectArea("cArqTmp")
		dbSetOrder(1)
		
RestArea(aSaveArea)

Return cArqTmp
//-------------------------------------------------------------------
/*/{Protheus.doc} CtQryComp
    
    Grava os dados na tabela temporaria
    @author wilton.santos
    @since 28/11/2023
    @version 12.1.2310
/*/
//-------------------------------------------------------------------
method CtQryComp(cArqBase as character,nFim as integer,cMoeda as character,cSaldo as character,lAcum as logical,;
				aMeses as array,lImpAntLP as logical,dDataLP as date,cFinal as character,nInicio as integer,;
				lUnico as logical, nParamOrder as integer) class MonthtoMonthBalanceComparisonSmartViewBusinessObject
Local nMes              as integer
Local lUsaCusto   as logical
Local lUsaItem as logical
Local cQuery   := "" as character
Local cAlias := "" as character

DEFAULT nInicio := 1   
DEFAULT lUnico := .F.  

If cArqBase == "CT1"
	dbSelectArea("CQ1")
	cAlias := "CQ1"
ElseIf cArqBase == "CTT"
	dbSelectArea("CQ3")
	cAlias := "CQ3"
ElseIf cArqBase == "CTD"
	dbSelectArea("CQ5")
	cAlias := "CQ5"
ElseIf cArqBase == "CTH"
	dbSelectArea("CQ7")
	cAlias := "CQ7"
ElseIf cArqBase == "CTV"// Custo+Item
	dbSelectArea("CQ5")
	cAlias := "CQ5"
ElseIf cArqBase == "CTW"// Custo+Classe
	dbSelectArea("CQ7")
	cAlias := "CQ7"
ElseIf cArqBase == "CTX"// Item+Classe
	dbSelectArea("CQ7")
	cAlias := "CQ7"
ElseIf cArqBase == "CTY"  // Custo+Item+Classe
	dbSelectArea("CQ7")
	cAlias := "CQ7"
EndIf

If cAlias $ "CQ7/CQ5"  // CTD = Conta+Custo+Item  ou  Conta+Item
	lUsaCusto := ::lUsaCusto
	If cAlias == "CQ7"  // Conta+CCusto+Item+Cl.Valor  ou  Conta+CCusto+Cl.Valor  ou  Conta+Item+Cl.Valor  ou  Conta+Cl.Valor
		lUsaItem := ::lUsaItem
	EndIf
EndIf

// Tabelas:
// ARQ  -> CT1
// ARQ2 -> CTT
// ARQ3 -> CTD
// ARQ4 -> CTH       
if (lUnico)
 nInicio:=nFim
EndIf 

For nMes := nInicio to nFim
	cQuery += "  	(SELECT COALESCE( SUM("+cAlias+"_CREDIT) - SUM("+cAlias+"_DEBITO), 0) "
	cQuery += " 		 	FROM "+RetSqlName(cAlias)+" "+cAlias
	cQuery += "   			WHERE "+cAlias+"_FILIAL = ? "
	cQuery += "   			AND "+cAlias+"_MOEDA = ? "
	cQuery += "   			AND "+cAlias+"_TPSALD = ? "

	aAdd(self:aBind,{nParamOrder++,FwxFilial(cAlias)})
	aAdd(self:aBind,{nParamOrder++,cMoeda})
	aAdd(self:aBind,{nParamOrder++,cSaldo})
   
   If cArqBase == "CT1"      // Conta
		cQuery += "  			AND CQ1_CONTA = ARQ.CT1_CONTA "

   ElseIf cArqBase == "CTT"   // Conta+Custo
		cQuery += "  			AND CQ3_CONTA = ARQ.CT1_CONTA "
		cQuery += "   			AND CQ3_CCUSTO = ARQ2.CTT_CUSTO "

   ElseIf cArqBase == "CTD"  // Conta+Custo+Item  ou  Conta+Item
		cQuery += "   			AND CQ5_ITEM = ARQ3.CTD_ITEM "
		If lUsaCusto
			cQuery += "   			AND CQ5_CCUSTO = ARQ2.CTT_CUSTO "
		EndIf
		cQuery += "  			AND CQ5_CONTA = ARQ.CT1_CONTA "

   ElseIf cArqBase == "CTH"  // Conta+CCusto+Item+Cl.Valor  ou  Conta+CCusto+Cl.Valor  ou  Conta+Item+Cl.Valor  ou  Conta+Cl.Valor
		cQuery += "   			AND CQ7_CLVL = ARQ4.CTH_CLVL "
		If lUsaItem
			cQuery += "   			AND CQ7_ITEM = ARQ3.CTD_ITEM "
		EndIf
  		If lUsaCusto
			cQuery += "   			AND CQ7_CCUSTO = ARQ2.CTT_CUSTO "
		EndIf
		cQuery += "  			AND CQ7_CONTA = ARQ.CT1_CONTA "

   ElseIf cArqBase == "CTV"  // Custo+Item
		cQuery += "   			AND CQ5_CCUSTO = ARQ2.CTT_CUSTO "
		cQuery += "  			AND CQ5_ITEM = ARQ3.CTD_ITEM "

	ElseIf cArqBase == "CTW"  // Custo+Classe
		cQuery += "   			AND CQ7_CCUSTO = ARQ2.CTT_CUSTO "
		cQuery += "  			AND CQ7_CLVL = ARQ4.CTH_CLVL "

	ElseIf cArqBase == "CTX"  // Item+Classe
		cQuery += "  			AND CQ7_ITEM = ARQ3.CTD_ITEM "
		cQuery += "   			AND CQ7_CLVL = ARQ4.CTH_CLVL "

	ElseIf cArqBase == "CTY"  // Custo+Item+Classe
		cQuery += "   			AND CQ7_CCUSTO = ARQ2.CTT_CUSTO "
		cQuery += "   			AND CQ7_ITEM = ARQ3.CTD_ITEM "
		cQuery += "   			AND CQ7_CLVL = ARQ4.CTH_CLVL "
	EndIf
	
	If lAcum .and. (nMes == 1)
		cQuery += "   			AND "+cAlias+"_DATA <= ? "
		aAdd(self:aBind,{nParamOrder++,DTOS(aMeses[nMes,3])})
	Else 
		If lUnico
			cQuery += "   			AND "+cAlias+"_DATA BETWEEN ? AND ? "			
			aAdd(self:aBind,{nParamOrder++,DTOS(aMeses[1,2])})
			aAdd(self:aBind,{nParamOrder++,DTOS(aMeses[nMes,3])})
		Else
			cQuery += "   			AND "+cAlias+"_DATA BETWEEN ? AND ? "
			aAdd(self:aBind,{nParamOrder++,DTOS(aMeses[nMes,2])})
			aAdd(self:aBind,{nParamOrder++,DTOS(aMeses[nMes,3])})
		EndIf
	EndIf
	If lImpAntLP .And. dDataLP >= aMeses[nMes,2]
		cQuery += "	AND "+cAlias+"_LP <> ? "
		aAdd(self:aBind,{nParamOrder++,'Z'})
	Endif

	cQuery += "   			AND "+cAlias+".D_E_L_E_T_ = ?) " 	
	aAdd(self:aBind,{nParamOrder++,space(1)})

	cQuery += cFinal			/// NOME DA COLUNA "COL" OU CLAUSULA WHERE "<> 0"

	If Left(cFinal,3) == "COL"
		cQuery += ALLTRIM(STR(nMes))
		If nMes < nFim 
			cQuery += ", "
		EndIf
	Else
		If nMes < nFim 
			cQuery += " OR "
		EndIf	
	EndIf
Next

//bind

Return cQuery
//-------------------------------------------------------------------
/*/{Protheus.doc} MontaColSaldoMes

	Gera a lista de colunas agregadas (uma coluna por mes) para um unico
	saldo/alias, no formato "SUM(CASE WHEN <cond_data> [AND <alias>_LP <> ?]
	THEN <alias>_CREDIT - <alias>_DEBITO ELSE 0 END) AS <cPrefixo><nMes>",
	reproduzindo exatamente os mesmos ramos condicionais por mes hoje usados
	em CtQryComp (lAcum no primeiro mes, lImpAntLP/dDataLP avaliado por mes).

	Fundacao da task T1 (DSERCTR1-52515): esta e uma das duas pecas base da
	agregacao set-based que vai substituir a subquery escalar correlacionada
	de CtQryComp. Ainda nao e chamada por nenhum Case de CtCmpSldM.

	Simplificacao intencional: o parametro "lUnico" de CtQryComp NAO existe
	aqui. Ele so fazia sentido no caso CTI, onde nInicio=nFim=nCont (loop
	externo mes a mes) e forcava o inicio da faixa de data no primeiro mes
	do periodo (aMeses[1,2]) mesmo processando um unico mes por chamada.
	No desenho set-based, a subquery derivada de agregacao (MontaSubQrySaldoAgg) sempre varre
	o periodo completo em uma unica passada e cada coluna de mes usa sua
	propria condicao de data (aMeses[nMes,2]/aMeses[nMes,3]), tornando esse
	ajuste de faixa desnecessario.

	Nao ha COALESCE no THEN do CASE: SUM(CASE WHEN ... THEN <alias>_CREDIT -
	<alias>_DEBITO ELSE 0 END) ja retorna 0 quando nenhuma linha do mes casa
	com a condicao, entao o COALESCE que existe hoje em CtQryComp deixa de
	ser necessario aqui. Se quem consumir este metodo fizer um LEFT JOIN
	externo (ex.: chave de agrupamento sem nenhum saldo lancado no periodo),
	o tratamento de NULL da coluna agregada e responsabilidade de quem
	montar esse JOIN, nao deste metodo.

	CORRECAO (DSERCTR1-52515, achado 2026-09-09 via comparacao de dataset do caso CTI):
	o CASE WHEN de cada mes precisa filtrar tambem por "<alias>_TPSALD = ?" (o tipo de
	saldo especifico desta coluna, ex.: Saldo A = '1', Saldo B = '2'). Sem esse filtro, a
	subquery agregada externa (MontaSubQrySaldoAgg) so restringe TPSALD no WHERE geral com
	"IN (?,...)" -- aceitando QUALQUER um dos saldos ativos -- e como o GROUP BY e so pela
	chave de entidade (sem TPSALD), linhas de tipos de saldo diferentes (A e B/C) caem no
	MESMO grupo: cada coluna COLA<mes>/COLB<mes>/COLC<mes> soma exatamente as MESMAS linhas
	agregadas, sem isolar a qual saldo pertence. Resultado: valores do Saldo B "sangram"
	para o Saldo A (e vice-versa) e a distribuicao mensal muda, porque lancamentos de
	TPSALD diferentes sao somados juntos antes de o CASE WHEN conseguir separa-los por mes.
	O legado (CtQryComp) sempre teve "AND <alias>_TPSALD = ?" dentro de cada subquery
	correlacionada -- filtro que se perdeu na reescrita set-based e so foi detectado ao
	comparar o dataset real do caso CTI (3 saldos ativos, A/B/C com TPSALD distintos) contra
	o legado. Por isso o parametro cTpSaldo foi adicionado: cada chamada a este metodo (uma
	por saldo ativo, ver MontaSubQrySaldoAgg e o bloco CTU) passa o TPSALD daquele saldo
	especifico, isolando corretamente a agregacao por saldo.

    @type method
	@author TOTVS
	@since 10/09/2026
	@param cAlias, character, alias fisico da tabela de saldo (CQ1/CQ3/CQ5/CQ7)
	@param aMeses, array, matriz de meses do periodo {nMes,dDataIni,dDataFim}
	@param lAcum, logical, indica saldo acumulado (mes 1 usa faixa aberta "<= ?")
	@param lImpAntLP, logical, indica se deve filtrar lancamentos anteriores ao LP
	@param dDataLP, date, data limite do LP (Livro Pratico) para o filtro por mes
	@param cPrefixo, character, prefixo do alias de coluna gerado (ex.: "COLA")
	@param cTpSaldo, character, valor de <alias>_TPSALD deste saldo especifico (ex.: "1"
		para Saldo A) -- isola a agregacao deste saldo das demais colunas (ver correcao acima)
	@param nParamOrder, integer, ordem corrente do bind posicional (passado por
		referencia pelo chamador via @nParamOrder; self:aBind e populado na
		mesma ordem dos "?" gerados no texto retornado)
	@return character, texto com a lista de colunas separadas por virgula
/*/
//-------------------------------------------------------------------
method MontaColSaldoMes(cAlias as character, aMeses as array, lAcum as logical, lImpAntLP as logical, dDataLP as date, cPrefixo as character, cTpSaldo as character, nParamOrder as integer) as character class MonthtoMonthBalanceComparisonSmartViewBusinessObject
Local nMes      as integer
Local nTotMeses as integer
Local cCols     as character

cCols     := ""
nTotMeses := Len(aMeses)

For nMes := 1 to nTotMeses
	cCols += "SUM(CASE WHEN "

	// Isola este saldo especifico dos demais saldos ativos que compartilham a mesma
	// subquery agregada (ver correcao no Protheus.doc acima) -- sem este filtro, o
	// SUM(CASE WHEN...) soma indistintamente linhas de TPSALD diferentes.
	cCols += cAlias+"_TPSALD = ? AND "
	aAdd(self:aBind,{nParamOrder++,cTpSaldo})

	If lAcum .and. (nMes == 1)
		cCols += cAlias+"_DATA <= ? "
		aAdd(self:aBind,{nParamOrder++,DTOS(aMeses[nMes,3])})
	Else
		cCols += cAlias+"_DATA BETWEEN ? AND ? "
		aAdd(self:aBind,{nParamOrder++,DTOS(aMeses[nMes,2])})
		aAdd(self:aBind,{nParamOrder++,DTOS(aMeses[nMes,3])})
	EndIf

	If lImpAntLP .And. dDataLP >= aMeses[nMes,2]
		cCols += "AND "+cAlias+"_LP <> ? "
		aAdd(self:aBind,{nParamOrder++,'Z'})
	EndIf

	cCols += "THEN "+cAlias+"_CREDIT - "+cAlias+"_DEBITO ELSE 0 END) AS "+cPrefixo+ALLTRIM(STR(nMes))

	If nMes < nTotMeses
		cCols += ", "
	EndIf
Next

Return cCols
//-------------------------------------------------------------------
/*/{Protheus.doc} MontaSubQrySaldoAgg

	Monta o texto completo de uma subquery derivada no FROM ("( SELECT ... ) <alias>") que
	pre-agrega, em UMA UNICA passada por GROUP BY, os saldos mes a mes de um
	alias de saldo (CQ1/CQ3/CQ5/CQ7), reutilizando MontaColSaldoMes para
	gerar o bloco de colunas de cada saldo ativo (A/B/C).

	Fundacao da task T1 (DSERCTR1-52515): segunda peca base da agregacao
	set-based que vai substituir, em tasks futuras (T2-T8), a subquery
	escalar correlacionada de CtQryComp. Ainda nao e chamada por nenhum
	Case de CtCmpSldM.

	Os filtros CTAlias_FILIAL / CTAlias_MOEDA / CTAlias_TPSALD e
	CTAlias.D_E_L_E_T_, que hoje se repetem dentro de cada subquery por mes
	em CtQryComp, entram apenas UMA VEZ no WHERE deste CTE, pois a varredura
	da tabela fisica passa a ser unica para todos os meses e todos os
	saldos informados em aSaldos. O filtro de TPSALD usa "IN (?,...)" com a
	quantidade de binds ajustada ao numero de saldos realmente ativos (nao
	gera binds fixos para saldos vazios).

    @type method
	@author TOTVS
	@since 10/09/2026
	@param cAliasCte, character, nome do CTE gerado (ex.: "SLDAGG")
	@param cAlias, character, alias fisico da tabela de saldo (CQ1/CQ3/CQ5/CQ7)
	@param aChaveAgrup, array, lista de nomes de coluna fisica para SELECT/GROUP BY
	@param cMoeda, character, moeda usada no filtro <alias>_MOEDA
	@param aSaldos, array, lista de pares {cPrefixo,cValorSaldo} apenas dos
		saldos ativos (ex.: {{"COLA","1"},{"COLB","2"}})
	@param aMeses, array, matriz de meses do periodo {nMes,dDataIni,dDataFim}
	@param lAcum, logical, indica saldo acumulado (mes 1 usa faixa aberta)
	@param lImpAntLP, logical, indica se deve filtrar lancamentos anteriores ao LP
	@param dDataLP, date, data limite do LP para o filtro por mes
	@param dDataIniPeriodo, date, inicio da faixa total do periodo (filtro do WHERE)
	@param dDataFimPeriodo, date, fim da faixa total do periodo (filtro do WHERE)
	@param nParamOrder, integer, ordem corrente do bind posicional (passado por
		referencia pelo chamador via @nParamOrder; self:aBind e populado na
		mesma ordem dos "?" gerados no texto retornado)
	@return character, texto da subquery derivada "( SELECT ... GROUP BY ... ) <cAliasCte>",
		para ser concatenado diretamente no FROM do chamador (ver nota de compatibilidade
		abaixo)

	NOTA DE COMPATIBILIDADE (correcao pos-T2, DSERCTR1-52515): a primeira versao deste
	metodo gerava um CTE ("WITH <alias> AS (...)"). A funcao ChangeQuery() do Protheus
	(APLIB070.PRW) rejeita textualmente qualquer query que contenha a palavra reservada
	WITH fora de contexto valido para ela, com o erro "A funcao ChangeQuery nao pode ser
	utilizada para queries com a palavra reservada WITH" -- e ChangeQuery e obrigatoria
	no fluxo (self:CtCmpSldM chama ChangeQuery(cQuery) antes de FWExecStatement) para
	obter compatibilidade ANSI entre Oracle/SQL Server/PostgreSQL. Por isso este metodo
	passou a gerar uma SUBQUERY DERIVADA no FROM ("( SELECT ... ) <alias>"), forma
	SQL padrao suportada pelos tres bancos e livre da palavra WITH -- o chamador deve
	concatenar o texto retornado dentro do FROM (ex.: "FROM CT1 ARQ, CTT ARQ2, "+cSubqry),
	nao mais como prefixo da query inteira.
/*/
//-------------------------------------------------------------------
method MontaSubQrySaldoAgg(cAliasCte as character, cAlias as character, aChaveAgrup as array, cMoeda as character, aSaldos as array, aMeses as array, lAcum as logical, lImpAntLP as logical, dDataLP as date, dDataIniPeriodo as date, dDataFimPeriodo as date, nParamOrder as integer) as character class MonthtoMonthBalanceComparisonSmartViewBusinessObject
Local nChave      as integer
Local nSaldo      as integer
Local cChaves     as character
Local cColunas    as character
Local cCteTexto   as character

cChaves  := ""
cColunas := ""

For nChave := 1 to Len(aChaveAgrup)
	cChaves += aChaveAgrup[nChave]
	If nChave < Len(aChaveAgrup)
		cChaves += ", "
	EndIf
Next

For nSaldo := 1 to Len(aSaldos)
	cColunas += self:MontaColSaldoMes(cAlias, aMeses, lAcum, lImpAntLP, dDataLP, aSaldos[nSaldo,1], aSaldos[nSaldo,2], @nParamOrder)
	If nSaldo < Len(aSaldos)
		cColunas += ", "
	EndIf
Next

// Subquery derivada no FROM (ANSI, sem a palavra reservada WITH) -- ver nota de
// compatibilidade no Protheus.doc acima. O chamador concatena este texto dentro do
// proprio FROM da query externa, seguido do alias cAliasCte.
cCteTexto := "( SELECT "+cChaves+", "+cColunas+" "
cCteTexto += "FROM "+RetSqlName(cAlias)+" "+cAlias+" "
cCteTexto += "WHERE "+cAlias+"_FILIAL = ? "
aAdd(self:aBind,{nParamOrder++,FwxFilial(cAlias)})

cCteTexto += "AND "+cAlias+"_MOEDA = ? "
aAdd(self:aBind,{nParamOrder++,cMoeda})

cCteTexto += "AND "+cAlias+"_TPSALD IN ("
For nSaldo := 1 to Len(aSaldos)
	cCteTexto += "?"
	aAdd(self:aBind,{nParamOrder++,aSaldos[nSaldo,2]})
	If nSaldo < Len(aSaldos)
		cCteTexto += ","
	EndIf
Next
cCteTexto += ") "

// CORRECAO (pos-piloto T2, DSERCTR1-52515): quando lAcum (MV_PAR16==2, saldo acumulado),
// a coluna do mes 1 usa "<alias>_DATA <= <fim do mes 1>" SEM limite inferior (ver
// MontaColSaldoMes) -- ela precisa somar todo o historico anterior ao periodo, nao so o
// que esta dentro de aMeses. Se este WHERE externo aplicasse sempre
// "<alias>_DATA BETWEEN dDataIniPeriodo AND dDataFimPeriodo", o historico anterior a
// dDataIniPeriodo seria descartado ANTES da agregacao, subestimando (ou zerando) o saldo
// acumulado e fazendo combinacoes que so tinham saldo historico desaparecerem do INNER
// JOIN externo -- bug reproduzido e confirmado no banco: com lAcum=.T., filtrar por
// BETWEEN reduziu de 62 para 8 combinacoes Conta+Custo com saldo != 0 no mes 1. Por isso,
// quando lAcum, o filtro externo usa apenas o limite superior (fim do periodo); os meses
// que NAO sao o mes 1 continuam corretamente restritos pelo proprio CASE WHEN de cada
// coluna (MontaColSaldoMes), e o mes 1 (lAcum .and. nMes==1) tambem so usa "<= data".
If lAcum
	cCteTexto += "AND "+cAlias+"_DATA <= ? "
	aAdd(self:aBind,{nParamOrder++,DTOS(dDataFimPeriodo)})
Else
	cCteTexto += "AND "+cAlias+"_DATA BETWEEN ? AND ? "
	aAdd(self:aBind,{nParamOrder++,DTOS(dDataIniPeriodo)})
	aAdd(self:aBind,{nParamOrder++,DTOS(dDataFimPeriodo)})
EndIf

cCteTexto += "AND "+cAlias+".D_E_L_E_T_ = ? "
aAdd(self:aBind,{nParamOrder++,space(1)})

cCteTexto += "GROUP BY "+cChaves+" "
cCteTexto += ") "+cAliasCte+" "

Return cCteTexto
//-------------------------------------------------------------------
/*/{Protheus.doc} MontaCondSaldoNaoZero

	Monta a condicao "( <cAliasCte>.<cPrefixo>1 <> 0 OR <cAliasCte>.<cPrefixo>2 <> 0 OR ... )"
	que reproduz, sobre as colunas JA agregadas pela subquery derivada de MontaSubQrySaldoAgg,
	o mesmo filtro que o CtQryComp legado aplicava com N subqueries correlacionadas
	"(SELECT ... ) <> 0" encadeadas por OR (uma por mes, repetida por saldo A/B/C).

	Bug #7 (DSERCTR1-52515, achado apos T2 marcado como piloto): o ramo !::lVlrZerado
	(Saldos Zerados = Nao, o default) faz apenas INNER JOIN com a subquery agregada,
	presumindo que "a combinacao existe em SLDAGG" e equivalente a "a combinacao tem saldo
	diferente de zero em algum mes". Essa premissa e FALSA: SLDAGG agrupa por
	FILIAL/MOEDA/TPSALD/DATA e existe uma linha agrupada sempre que houver QUALQUER
	lancamento de CQ3/CQ5/CQ7/CQ9 casando os filtros no periodo -- mesmo que a soma
	(CREDITO - DEBITO) de cada mes feche exatamente em zero. Contas de apuracao de
	resultado/zeramento (ex.: lancamentos de transferencia que se cancelam dentro do
	mesmo mes) sao o caso tipico: aparecem em SLDAGG com todas as colunas de saldo
	zeradas, e o INNER JOIN sem este filtro as deixa entrar no resultado -- diferente do
	legado, que so inclui a linha se pelo menos um "<> 0" for verdadeiro.

	Este metodo NAO reintroduz subqueries correlacionadas: opera sobre as colunas de
	saida de SLDAGG, que ja estao agregadas em uma unica linha por chave de agrupamento,
	entao o custo e apenas uma comparacao aritmetica por coluna, sem nova leitura da
	tabela fisica de saldo.

	Uso obrigatorio em TODO Case que montar o ramo !::lVlrZerado com INNER JOIN direto na
	subquery agregada (ver "Licoes aprendidas em T1/T2" e o Done when de T3-T8 em
	tasks.md) -- nao apenas no piloto CT3. No ramo ::lVlrZerado (CROSS JOIN + LEFT JOIN),
	este filtro NAO se aplica: ali a enumeracao de combinacoes sem saldo e intencional.

    @type method
	@author kiro.assistido
	@since 08/09/2026
	@param cAliasCte, character, nome do alias da subquery derivada (ex.: "SLDAGG")
	@param aSaldos, array, lista de pares {cPrefixo,cValorSaldo} dos saldos A/B/C ativos
		(mesma lista passada a MontaSubQrySaldoAgg) -- usa-se apenas aSaldos[n,1] (o
		prefixo de coluna, ex.: "COLA")
	@param nTotMeses, integer, quantidade de meses do periodo (Len(aMeses))
	@return character, texto "( <cAliasCte>.<prefixo><mes> <> 0 OR ... )" com todas as
		combinacoes de saldo ativo x mes separadas por OR
/*/
//-------------------------------------------------------------------
method MontaCondSaldoNaoZero(cAliasCte as character, aSaldos as array, nTotMeses as integer) as character class MonthtoMonthBalanceComparisonSmartViewBusinessObject
Local nSaldo   as integer
Local nMes     as integer
Local cCond    as character
Local lPrimeiro as logical

cCond     := " ( "
lPrimeiro := .T.

For nSaldo := 1 to Len(aSaldos)
	For nMes := 1 to nTotMeses
		If !lPrimeiro
			cCond += " OR "
		EndIf
		cCond += cAliasCte+"."+aSaldos[nSaldo,1]+ALLTRIM(STR(nMes))+" <> 0 "
		lPrimeiro := .F.
	Next
Next

cCond += " ) "

Return cCond
//-------------------------------------------------------------------
/*/{Protheus.doc} CtbPeriodos
    Ajusta o parametro nDivide vindo do objeto de negocio
    @author gustavo.campos
    @since 30/08/2023
    @version 12.1.2210
/*/ 
//-------------------------------------------------------------------
method compvld(nDivide as Numeric) class MonthtoMonthBalanceComparisonSmartViewBusinessObject
    
    If nDivide == 2			// Divide por cem
	   ::nDivide := 100
    ElseIf nDivide == 3		// Divide por mil
	   ::nDivide := 1000
    ElseIf nDivide == 4		// Divide por milhao
	   ::nDivide := 1000000
	Else
	   ::nDivide := 1	   
    EndIf

return
//-------------------------------------------------------------------
/*/{Protheus.doc} setDados
    Trata a query
    @author wilton.santos
    @since 28/12/2023
    @version 12.1.2310
/*/ 
//-------------------------------------------------------------------
method setDados(oFilter) as object class MonthtoMonthBalanceComparisonSmartViewBusinessObject
Local cMascCta              as character
Local cMascCus              as character
Local cMascIte              as character
Local cMascClv              as character
Local cConta                as character
Local cCusto                as character
Local cItem                 as character
Local cClvl                 as character
Local cSepara  			    as character
Local cPicture  			as character
Local nTotLinhaA	:= 0 	as numeric 
Local nTotLinhaB	:= 0 	as numeric 
Local nTotLinhaC	:= 0 	as numeric 
Local cDescSLA		:="" 	as character 
Local cDescSLB		:="" 	as character 
Local cDescSLC		:="" 	as character 
Local lTemSLDA				as logical
Local lTemSLDB				as logical
Local lTemSldC				as logical
//Tratamento para impress„o
//-----------------------------------------------------------------------
cDescSLA	:= ALLTRIM(Tabela("SL", ::cSaldoA, .F.))
cDescSLB	:= ALLTRIM(Tabela("SL", ::cSaldoB, .F.))
cDescSLC	:= ALLTRIM(Tabela("SL", ::cSaldoC, .F.))

lTemSLDA	:= !Empty(::cSaldoA)
lTemSLDB	:= !Empty(::cSaldoB)
lTemSldC	:= !Empty(::cSaldoC)

cPicture    := Iif(Empty(::aSetOfBook[4]),"@E 9,999,999,999.99","")

//coletando cada maskara
cMascCta   := IIF(Empty(::aSetOfBook[2]),SuperGetMv("MV_MASCARA"),RetMasCtb(::aSetOfBook[2],@cSepara))//Mascara da Conta
cMascCus   := IIF(Empty(::aSetOfBook[6]),SuperGetMv("MV_MASCCUS"),RetMasCtb(::aSetOfBook[6],@cSepara))//Mascara do Centro de Custo
cMascIte   := IIF(Empty(::aSetOfBook[7]),SuperGetMv("MV_MASCCTD"),RetMasCtb(::aSetOfBook[7],@cSepara))//Mascara do Item Contabil  
cMascClv   := IIF(Empty(::aSetOfBook[8]),SuperGetMv("MV_MASCCTH"),RetMasCtb(::aSetOfBook[8],@cSepara))//Mascara da Classe Valor

If Select("cArqTmp") > 0

	dbSelectArea("cArqTmp")
	cArqTmp->(DBGoTop())
	While !cArqTmp->(Eof())
		
		cConta := EntidadeCTB(cArqTMP->CONTA ,0,0,Nil/*Tamanho*/,.F.,cMascCta,""/*Separador*/,"CT1",,,,.F.)
		cCusto := EntidadeCTB(cArqTMP->CUSTO ,0,0,Nil/*Tamanho*/,.F.,cMascCus,""/*Separador*/,"CTT",,,,.F.)
		cItem  := EntidadeCTB(cArqTMP->ITEM  ,0,0,Nil/*Tamanho*/,.F.,cMascIte,""/*Separador*/,"CTD",,,,.F.)
		cClvl  := EntidadeCTB(cArqTMP->CLVL  ,0,0,Nil/*Tamanho*/,.F.,cMascClv,""/*Separador*/,"CTH",,,,.F.)
		
		//Calcula o Total das Linhas
		If lTemSldA
			nTotLinhaA	:= IIf (::lAcum,COLA12,COLA1+COLA2+COLA3+COLA4+COLA5+COLA6+COLA7+COLA8+COLA9+COLA10+COLA11+COLA12)
		EndiF
		If lTemSldB
			nTotLinhaB	:= IIf (::lAcum,COLB12,COLB1+COLB2+COLB3+COLB4+COLB5+COLB6+COLB7+COLB8+COLB9+COLB10+COLB11+COLB12)
		EndIf
		If lTemSldC
			nTotLinhaC	:= IIf (::lAcum,COLC12,COLC1+COLC2+COLC3+COLC4+COLC5+COLC6+COLC7+COLC8+COLC9+COLC10+COLC11+COLC12)
		EndIf

		//Novo objeto
		::jItens := JsonObject():new()

		::jItens["CONTA"	] := cConta	
		::jItens["CTASUP"	] := cArqTMP->CTASUP	
		::jItens["CTARES"	] := cArqTMP->CTARES	
		::jItens["DESCCTA"	] := cArqTMP->DESCCTA	
		::jItens["NORMAL"	] := cArqTMP->NORMAL	
		::jItens["TIPOCONTA"] := cArqTMP->TIPOCONTA
		::jItens["CUSTO"	] := cCusto	
		::jItens["CCSUP"	] := cArqTMP->CCSUP	
		::jItens["CCRES"	] := cArqTMP->CCRES	
		::jItens["DESCCC" 	] := cArqTMP->DESCCC 	
		::jItens["TIPOCC"  	] := cArqTMP->TIPOCC  	
		::jItens["ITEM"		] := cItem		
		::jItens["ITSUP"	] := cArqTMP->ITSUP	
		::jItens["ITEMRES" 	] := cArqTMP->ITEMRES 	
		::jItens["DESCITEM" ] := cArqTMP->DESCITEM 
		::jItens["TIPOITEM"	] := cArqTMP->TIPOITEM	
		::jItens["CLVL"		] := cClvl	
		::jItens["CLSUP"	] := cArqTMP->CLSUP	
		::jItens["CLVLRES"	] := cArqTMP->CLVLRES	
		::jItens["DESCCLVL" ] := cArqTMP->DESCCLVL 
		::jItens["TIPOCLVL"	] := cArqTMP->TIPOCLVL	
		::jItens["ORDEM"	] := cArqTMP->ORDEM	
		::jItens["GRUPO"	] := cArqTMP->GRUPO	
		::jItens["IDENTIFI"	] := cArqTMP->IDENTIFI	
		::jItens["ESTOUR"  	] := cArqTMP->ESTOUR  	
		::jItens["NIVEL1"	] := cArqTMP->NIVEL1	
		::jItens["COLA1"	] := cArqTMP->COLA1	
		::jItens["COLA2"   	] := cArqTMP->COLA2   	
		::jItens["COLA3"   	] := cArqTMP->COLA3   	
		::jItens["COLA4" 	] := cArqTMP->COLA4 	
		::jItens["COLA5" 	] := cArqTMP->COLA5 	
		::jItens["COLA6"  	] := cArqTMP->COLA6  	
		::jItens["COLA7"	] := cArqTMP->COLA7	
		::jItens["COLA8"   	] := cArqTMP->COLA8   	
		::jItens["COLA9"   	] := cArqTMP->COLA9   	
		::jItens["COLA10" 	] := cArqTMP->COLA10 	
		::jItens["COLA11" 	] := cArqTMP->COLA11 	
		::jItens["COLA12"  	] := cArqTMP->COLA12  	
		::jItens["COLB1"	] := cArqTMP->COLB1	
		::jItens["COLB2"   	] := cArqTMP->COLB2   	
		::jItens["COLB3"   	] := cArqTMP->COLB3   	
		::jItens["COLB4" 	] := cArqTMP->COLB4 	
		::jItens["COLB5" 	] := cArqTMP->COLB5 	
		::jItens["COLB6"   	] := cArqTMP->COLB6   	
		::jItens["COLB7"	] := cArqTMP->COLB7	
		::jItens["COLB8"   	] := cArqTMP->COLB8   	
		::jItens["COLB9"   	] := cArqTMP->COLB9   	
		::jItens["COLB10" 	] := cArqTMP->COLB10 	
		::jItens["COLB11" 	] := cArqTMP->COLB11 	
		::jItens["COLB12"  	] := cArqTMP->COLB12  	
		::jItens["COLC1"	] := cArqTMP->COLC1	
		::jItens["COLC2"   	] := cArqTMP->COLC2   	
		::jItens["COLC3"   	] := cArqTMP->COLC3   	
		::jItens["COLC4" 	] := cArqTMP->COLC4 	
		::jItens["COLC5" 	] := cArqTMP->COLC5 	
		::jItens["COLC6"   	] := cArqTMP->COLC6   	
		::jItens["COLC7"	] := cArqTMP->COLC7	
		::jItens["COLC8"   	] := cArqTMP->COLC8   	
		::jItens["COLC9"   	] := cArqTMP->COLC9   	
		::jItens["COLC10" 	] := cArqTMP->COLC10 	
		::jItens["COLC11" 	] := cArqTMP->COLC11 	
		::jItens["COLC12"  	] := cArqTMP->COLC12  	
		::jItens["TOTLA"  	] := nTotLinhaA  	
		::jItens["TOTLB"  	] := nTotLinhaB  	
		::jItens["TOTLC"  	] := nTotLinhaC  	
		::jItens["DESCSLDA"	] := cDescSLA  	
		::jItens["DESCSLDB"	] := cDescSLB  	
		::jItens["DESCSLDC"	] := cDescSLC  	

		self:processData()
		self:oData:appendData(::jItens)

		nTotLinhaA	:= 0
		nTotLinhaB	:= 0
		nTotLinhaC	:= 0

		cArqTMP->(DbSkip())
			
	ENDDO

EndIF
return self:oData
