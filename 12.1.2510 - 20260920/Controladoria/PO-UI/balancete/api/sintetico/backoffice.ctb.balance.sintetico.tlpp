#include "totvs.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "topconn.ch"

namespace totvs.protheus.backoffice.ctb.balance.sintetico

/*/{protheus.doc} getBalanceSintetico

Mtodo POST para retornar razao contbil
Usando REST Verso 2.0 com Annotation

@type function
@author Jader Berto
@since 16/04/2025
@version P12

/*/ 
@POST(endpoint="api/ctb/balance/sintetico", description="Balancete Sintético")
User Function getBalanceSintetico()
	Local jHeaderReq      := oRest:getHeaderRequest()  as object
	Local cError          := ""                         as character
	Local oJRes           := JsonObject():new()         as object
	Local jBody           := JsonObject():new()         as object
	Local oJConexao       := JsonObject():new()         as object
	Local cMsg            := ""                         as character
	Local lOK             := .F.                        as logical
	Local cEmpresa        := ""                         as character
	Local cFilIni         as character
	Local cFilFin         as character
	Local cDtIni          := ""                         as character
	Local cDtFin          := ""                         as character
	Local cCtaIni         as character
	Local cCtaFin         as character
	Local cCCstIni        as character
	Local cCCstFin        as character
	Local cItemIni        as character
	Local cItemFin        as character
	Local cClsIni         as character
	Local cClsFin         as character
	Local cEnt5Ini        as character
	Local cEnt5Fin        as character
	Local cEnt6Ini        as character
	Local cEnt6Fin        as character
	Local cEnt7Ini        as character
	Local cEnt7Fin        as character
	Local cEnt8Ini        as character
	Local cEnt8Fin        as character
	Local cEnt9Ini        as character
	Local cEnt9Fin        as character
	Local ctempCon        := "TRBCONN"                  as character
	Local cMoeda          as character
	Local cTPSaldo        as character
	Local nTamEnt         := 0                          as numeric

	cMsg  := ""
	lOk   := .T.
	cError := jBody:fromJson(oRest:GetBodyRequest())

	//Se tiver algum erro no Parse, encerra a execucao
	IF Empty(cError)
		jBody:GetJsonValue("empresa",       @cEmpresa)
		// filial
		nTamEnt    := TamSX3('CT2_FILIAL')[01]
		cFilIni    := Replicate(" ", nTamEnt)
		cFilFin    := Replicate("Z", nTamEnt)
		jBody:GetJsonValue("filialInicial", @cFilIni)
		jBody:GetJsonValue("filialFinal",   @cFilFin)
		cDtIni := iif(empty(jBody:GetJsonText("dataInicial")), DTOS(FirstDay(DATE())), DTOS(CTOD(jBody:GetJsonText("dataInicial"))))
		cDtFin := iif(empty(jBody:GetJsonText("dataFinal")),   DTOS(LastDay(DATE())),  DTOS(CTOD(jBody:GetJsonText("dataFinal"))))
		cMoeda   := "01"
		cTPSaldo := "1"
		jBody:GetJsonValue("moeda",   @cMoeda)
		jBody:GetJsonValue("tpsaldo", @cTPSaldo)

		// Inicializa variaveis de range com valores default baseados no tamanho do dicionario
		// A chamada GetJsonValue sobrescreve somente se a chave existir no JSON

		// conta contabil
		nTamEnt  := TamSX3('CT2_CREDIT')[01]
		cCtaIni  := Replicate(" ", nTamEnt)
		cCtaFin  := Replicate("Z", nTamEnt)
		jBody:GetJsonValue("contaInicial", @cCtaIni)
		jBody:GetJsonValue("contaFinal",   @cCtaFin)

		// centro de custo
		nTamEnt    := TamSX3('CT2_CCC')[01]
		cCCstIni   := Replicate(" ", nTamEnt)
		cCCstFin   := Replicate("Z", nTamEnt)
		jBody:GetJsonValue("cCustoInicial", @cCCstIni)
		jBody:GetJsonValue("cCustoFinal",   @cCCstFin)

		// item contabil
		nTamEnt  := TamSX3('CT2_ITEMC')[01]
		cItemIni := Replicate(" ", nTamEnt)
		cItemFin := Replicate("Z", nTamEnt)
		jBody:GetJsonValue("itemInicial", @cItemIni)
		jBody:GetJsonValue("itemFinal",   @cItemFin)

		// classe de valor
		nTamEnt  := TamSX3('CT2_CLVLCR')[01]
		cClsIni  := Replicate(" ", nTamEnt)
		cClsFin  := Replicate("Z", nTamEnt)
		jBody:GetJsonValue("classeInicial", @cClsIni)
		jBody:GetJsonValue("classeFinal",   @cClsFin)

		// entidades contabeis opcionais (so inicializa se o campo existir na tabela)
		If CT2->(FieldPos("CT2_EC05CR")) > 0
			nTamEnt   := TamSX3('CT2_EC05CR')[01]
			cEnt5Ini  := Replicate(" ", nTamEnt)
			cEnt5Fin  := Replicate("Z", nTamEnt)
			jBody:GetJsonValue("ent05Inicial", @cEnt5Ini)
			jBody:GetJsonValue("ent05Final",   @cEnt5Fin)
		EndIf
		If CT2->(FieldPos("CT2_EC06CR")) > 0
			nTamEnt   := TamSX3('CT2_EC06CR')[01]
			cEnt6Ini  := Replicate(" ", nTamEnt)
			cEnt6Fin  := Replicate("Z", nTamEnt)
			jBody:GetJsonValue("ent06Inicial", @cEnt6Ini)
			jBody:GetJsonValue("ent06Final",   @cEnt6Fin)
		EndIf
		If CT2->(FieldPos("CT2_EC07CR")) > 0
			nTamEnt   := TamSX3('CT2_EC07CR')[01]
			cEnt7Ini  := Replicate(" ", nTamEnt)
			cEnt7Fin  := Replicate("Z", nTamEnt)
			jBody:GetJsonValue("ent07Inicial", @cEnt7Ini)
			jBody:GetJsonValue("ent07Final",   @cEnt7Fin)
		EndIf
		If CT2->(FieldPos("CT2_EC08CR")) > 0
			nTamEnt   := TamSX3('CT2_EC08CR')[01]
			cEnt8Ini  := Replicate(" ", nTamEnt)
			cEnt8Fin  := Replicate("Z", nTamEnt)
			jBody:GetJsonValue("ent08Inicial", @cEnt8Ini)
			jBody:GetJsonValue("ent08Final",   @cEnt8Fin)
		EndIf
		If CT2->(FieldPos("CT2_EC09CR")) > 0
			nTamEnt   := TamSX3('CT2_EC09CR')[01]
			cEnt9Ini  := Replicate(" ", nTamEnt)
			cEnt9Fin  := Replicate("Z", nTamEnt)
			jBody:GetJsonValue("ent09Inicial", @cEnt9Ini)
			jBody:GetJsonValue("ent09Final",   @cEnt9Fin)
		EndIf

		If jHeaderReq != Nil
			oJConexao := movimContS(@ctempCon,cFilIni,cFilFin,cDtIni,cDtFin,cCtaIni,cCtaFin,cCCstIni,cCCstFin,cItemIni,cItemFin,cClsIni,cClsFin,cEnt5Ini,cEnt5Fin,cEnt6Ini,cEnt6Fin,cEnt7Ini,cEnt7Fin,cEnt8Ini,cEnt8Fin,cEnt9Ini,cEnt9Fin,cMoeda,cTPSaldo)
			If oJConexao["sucesso"]
				oJRes["itens"] := {}
				While (ctempCon)->(!EOF())
					AAdd(oJRes["itens"], { "FILIAL": (ctempCon)->FILIAL,;
										"MOEDA": Alltrim((ctempCon)->MOEDA),;
										"CONTA": Alltrim((ctempCon)->CONTA),;
										"CENTRO_CUSTO": Alltrim((ctempCon)->CENTRO_CUSTO),;
										"ITEM_CONTABIL": Alltrim((ctempCon)->ITEM_CONTABIL),;
										"CLASSE_VALOR": Alltrim((ctempCon)->CLASSE_VALOR),;
										"ENT05": Alltrim((ctempCon)->ENT05),;
										"ENT06": Alltrim((ctempCon)->ENT06),;
										"ENT07": Alltrim((ctempCon)->ENT07),;
										"ENT08": Alltrim((ctempCon)->ENT08),;
										"ENT09": Alltrim((ctempCon)->ENT09),;
										"SALDO": (ctempCon)->SALDO,;
										"DELETADO": (ctempCon)->DELETADO})
				(ctempCon)->(DbSkip())
				End

				(ctempCon)->(DBCLOSEAREA())
				oRest:appendKeyHeaderResponse("Content-Type","application/json")
				oRest:setStatusCode(oJConexao["codigo"])
				oRest:setResponse(oJRes:toJson())
			EndIf
		EndIf
	Else
		oRest:appendKeyHeaderResponse("Content-Type","application/json")
		oRest:setStatusCode(500)
		oRest:setResponse('{"msg":"Parse Json ERROR."}')
	Endif

Return
