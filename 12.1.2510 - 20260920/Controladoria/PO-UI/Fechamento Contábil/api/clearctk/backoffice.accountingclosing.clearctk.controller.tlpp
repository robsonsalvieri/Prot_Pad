#include "tlpp-core.th"
#include "BACKOFFICE.ACCOUNTINGCLOSING.CLEARCTK.CONTROLLER.CH"

namespace totvs.protheus.backoffice.accountingclosing.clearctk
using namespace totvs.protheus.backoffice.accountingclosing.util

//-------------------------------------------------------------------
/*/{Protheus.doc} ClearCTK
Classe principal de controle, onde será inicializado o EndPoint

@type class
@author Totvs
@since 17/06/2026
/*/
//-------------------------------------------------------------------
class ClearCTK
    public method new()

    @POST("/api/fc/ClearCTK")
    public method postClearCTK()
endclass

//-------------------------------------------------------------------
/*/{Protheus.doc} new
Método construtor

@type method
@author Totvs
@since 17/06/2026
@return object, Instância da classe ClearCTK
/*/
//-------------------------------------------------------------------
method new() class ClearCTK
return

//-------------------------------------------------------------------
/*/{Protheus.doc} postClearCTK
Método que inicia a chamada para limpeza da CTK

@type method
@author Totvs
@since 17/06/2026
@return logical, Indica se a operação foi bem-sucedida
/*/
//-------------------------------------------------------------------
method postClearCTK() class ClearCTK
    Local oService      As Object
    Local cChaveRes     As Character
    Local cResponse     As Character
    Local cBody         As Character
    Local lReturn       As Logical
    Local cTpSald       As Character
    Local cCodCurr      As Character
    Local aBlockedCTG   As Array
    Local aRetClear     As Array
    Local jBody         As Json

    //Inicializa variaveis
    oService    := ClearCTKService():getInstance()    
    lReturn     := .F.
    cChaveRes   := "message"
    cResponse   := ""
    cBody       := oRest:getBodyRequest() 
    jBody       := JsonObject():new()
    aBlockedCTG := {}
    aRetClear := {}
    
    If ValType(cBody) == "C"
        uRet := jBody:fromJson( cBody )
        If ValType(uRet) == "U"

            If jBody:hasProperty("balanceType") .And. ValType(jBody["balanceType"]) == "C"
                cTpSald := jBody["balanceType"]
            EndIf
            If jBody:hasProperty("currency") .And. ValType(jBody["currency"]) == "C"
                cCodCurr := jBody["currency"]
            EndIf
            If jBody:hasProperty("items") .And. ValType(jBody["items"]) == "A" .And. Len(jBody["items"]) > 0
                aBlockedCTG := jBody["items"]
            EndIf

            //Validação dos parâmetros obrigatórios
            If ( !Empty(cTpSald) .And. !Empty(cCodCurr) .And. Len(aBlockedCTG) > 0 )

                //Chama o serviço
                aRetClear := oService:postClearCTK(cTpSald, cCodCurr, aBlockedCTG)
                If (Len(aRetClear) > 0  .And. ValType(aRetClear[1]) == "L" .And. aRetClear[1] .And. ValType(aRetClear[2]) == "N")
                    //Gravar CV8
                    cResponse := STR0001 //"Ocorreu um erro inesperado ao gravar a quantidade de registros expurgados"
                    lReturn := oService:saveLogCV8(aRetClear[2])
                    If lReturn
                        cResponse := "" //Se não ocorreram erros, apagar mensagens de erros.
                    EndIf
                EndIf
            Else      
                cResponse := STR0003 //"Ocorreu um erro inesperado. Não foram enviados todos os parâmetros para a API"
            EndIf
        EndIf
    EndIf

    fcSetResponse(lReturn, cChaveRes, cResponse, lReturn)

return
