@author Totvs
@since 17/06/2026
@return object, Instância da classe ClearCTKProtheusData
/*/
//-------------------------------------------------------------------
method getData() class ClearCTKProtheusData As Object
    static __oActiveData As Object

    If ValType(__oActiveData) == "U"
        __oActiveData := ClearCTKProtheusData():new()
    EndIf
return __oActiveData

//-------------------------------------------------------------------
/*/{Protheus.doc} postClearCTK
Método responsável pelo processamento da limpeza da tabela CTK

@type method
@author Totvs
@since 17/06/2026
@param cTpSald, character, Tipo de saldo
@param cCodCurr, character, Código da moeda
@param aBlockedCTG, array, Array de JSON com calendários bloqueados
@return array, Array de retorno [lSucesso, nTotalDeleted]
/*/
//-------------------------------------------------------------------
method postClearCTK(cTpSald as Character, cCodCurr as Character, aBlockedCTG as Array) class ClearCTKProtheusData
    Local lResponse     as Logical
    Local lContinue     as Logical
    Local aGroupedPer   as Array
    Local aIntervals    as Array
    Local aRetClear     as Array
    Local nI            as Numeric
    Local nJ            as Numeric
    Local cMsg          as Character
    Local nTotalDeleted as Numeric

    lResponse     := .F.
    lContinue     := .T.
    cMsg          := ""
    nTotalDeleted := 0
    aRetClear     := {.F., 0}

    // Agrupa periodos por filial, calendario e ano
    aGroupedPer := groupPeriodsByKey(aBlockedCTG)

    // Para cada grupo (filial + calendario + ano)
    For nI := 1 To Len(aGroupedPer)
        
        If lContinue

            // Identifica intervalos sequenciais de periodos
            aIntervals := identifySequentialIntervals(aGroupedPer[nI]["periods"])
            
            // Para cada intervalo identificado
            For nJ := 1 To Len(aIntervals)

                If lContinue
                
                    // Executa o DELETE na CTK para o intervalo de datas
                    lContinue := executeCTKDelete(;
                        aGroupedPer[nI]["branch"],;
                        aIntervals[nJ]["startDate"],;
                        aIntervals[nJ]["endDate"],;
                        cTpSald,;
                        cCodCurr,;
                        @nTotalDeleted;
                    )
                    If lContinue
                        aRetClear[1] := .T.
                        aRetClear[2] := nTotalDeleted //Atualiza com o total
                    EndIf
                EndIf
            Next nJ
        EndIf
    Next nI

    aRetClear[1] := lContinue
    
Return aRetClear

//-------------------------------------------------------------------
/*/{Protheus.doc} saveLogCV8
Método responsável pelo salvamento de log na tabela CV8

@type method
@author Totvs
@since 17/06/2026
@param nTotalDeleted, numeric, Quantidade total de registros deletados
@return logical, .T. se sucesso, .F. caso contrário
/*/
//-------------------------------------------------------------------
method saveLogCV8(nTotalDeleted as Numeric) class ClearCTKProtheusData
    Local lRet      as Logical
    Local cIdCV8    as Character

    lRet := .F.

    If !Empty(CV8->(IndexKey(5))) 
        cIdCV8:= GetSXENum("CV8","CV8_IDMOV",,5)	
        ConfirmSX8()
        
        GravaCV8("6", "CTBA960", STR0001 + cValToChar(nTotalDeleted), "", "", "", , cIdCV8) //"Quantidade de registros expurgados da tabela CTK: "
        lRet := .T.
    EndIf

Return lRet
