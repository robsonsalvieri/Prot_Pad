/*/
Static Function MenuDef()

	Local aRotina 		As Array
	Local lPageAction	As Logical

	lPageAction := .T.
	aRotina 	:= {{ OemtoAnsi(STR0001), "AxPesqui"        , 0 , 1 			     },; // "Pesquisar"
                	{ OemtoAnsi(STR0002), "VIEWDEF.ATFA012 ", 0 , 2 				 },; // "Visualizar"
                	{ OemtoAnsi(STR0003), "AF140Cus"        , 0 , 4,,,,,,lPageAction } } // "Alt.C.Custo"

Return(aRotina)
