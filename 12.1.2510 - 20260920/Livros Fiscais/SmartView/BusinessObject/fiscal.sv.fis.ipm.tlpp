#include "protheus.ch"
#include "msobject.ch"
#include "totvs.framework.treports.integratedprovider.th"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "fiscal.sv.fis.ipm.ch"
 

namespace totvs.protheus.fiscal.fis.treportsintegratedprovider
@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGAFIS", tables="CKI", name="MunicipalityParticipationIndexBusinessObject", country="BRA", initialRelease="12.1.2310")
 

//-------------------------------------------------------------------
/*/{Protheus.doc} MunicipalityParticipationIndexBusinessObject
Classe para criação do Objeto de Negócio

@author Wesley Matos
@since 12/08/2025
@version 1.0
*/
//-------------------------------------------------------------------  
class MunicipalityParticipationIndexBusinessObject from totvs.framework.treports.integratedprovider.IntegratedProvider
    public method new() as object
    public method getData() as object
    public method getSchema() as object 
    private method execQuery()  as character

endclass


//-------------------------------------------------------------------
/*/{Protheus.doc} new
Método de instância da Classe

@author	 Wesley Matos 
@since	 12/08/2025
@version 1.0
/*/ 
//-------------------------------------------------------------------
method new() as object class MunicipalityParticipationIndexBusinessObject

_Super:new()
self:appendArea(STR0001) //"Livros Fiscais"
self:setDisplayName(STR0002) //"IPM - Índice de Participação dos Municípios"
self:setDescription(STR0003) //"Objeto de negócio que fornece a visão de dados para o IPM"

if !::setPergunte("FISTRIPM01")
    FwLogMsg(STR0004,,STR0004,,,,STR0005,,,)//"WARN"##"SmartView"##"Grupo de perguntas nao encontrado"
endIf

return self


//-------------------------------------------------------------------
/*/{Protheus.doc} getData
Retorna os dados do objeto de negócio. 

@author	 Wesley Matos
@since	 12/08/2025
@version 1.0
/*/
//-------------------------------------------------------------------
method getData(nPage as numeric, oFilter as object) as object class MunicipalityParticipationIndexBusinessObject

Local cAlias    := ""   as character
Local oPrepare  := nil  as object
Local cDataEnt  := ""   as character
Local cDataEmi  := ""   as character
Local cCodPar   := ""   as character
Local cPartic   := ""   as character

cAlias := self:execQuery(oPrepare, oFilter)

while !(cAlias)->(eof())

    cDataEnt := totvs.framework.treports.date.stringToTimeStamp((cAlias)->DT_ENTRADA)
    cDataEmi := totvs.framework.treports.date.stringToTimeStamp((cAlias)->DT_EMISSAO)

    if !Empty((cAlias)->CLIENTE)
        cCodPar := (cAlias)->COD_CLIENTE
        cPartic := (cAlias)->CLIENTE
    else
        cCodPar := (cAlias)->COD_FORNECEDOR
        cPartic := (cAlias)->FORNECEDOR
    endIf

    self:oData:appendData({ ;
                "CKI_FILIAL": (cAlias)->FILIAL ,;
                "CKI_UFDOC" : (cAlias)->UF_DOCUMENTO ,;
                "CKI_CODIPM": (cAlias)->COD_IPM ,;
                "CKI_FILDOC": (cAlias)->FIL_DOCCUMENTO ,;
                "CKI_CODMUN": (cAlias)->COD_MUNICIPIO ,;
                "CKI_REGAPU": (cAlias)->REG_APURACAO ,;
                "CKI_CODTRI": (cAlias)->COD_TRIBUTO ,;
                "CKI_NF"    : (cAlias)->NF ,;
                "CKI_SERIE" : (cAlias)->SERIE ,;
                "CKI_TPMOV" : (cAlias)->TIPO_MOVIMENTO ,;
                "CKI_ITEM"  : (cAlias)->ITEM ,;
                "CKI_UFNOTA": (cAlias)->UF_NF ,;
                "CKI_DTENT" : cDataEnt ,;
                "CKI_DTEMIS": cDataEmi ,;
                "CKI_CODPAR": cCodPar  ,;
                "CKI_PARTIC": cPartic  ,;
                "CKI_LOJA"  : (cAlias)->LOJA ,;
                "CKI_UFPART": (cAlias)->UF_PARTICIPANTE ,;
                "CKI_MUNPAR": (cAlias)->MUN_PARTICIPANTE ,;
                "CKI_UFORIG": (cAlias)->UF_ORIGEM ,;
                "CKI_MUNORI": (cAlias)->MUN_ORIGEM ,;
                "CKI_UFDEST": (cAlias)->UF_DESTINO ,;
                "CKI_MUNDES": (cAlias)->MUN_DESTINO ,;
                "CKI_VLCONT": (cAlias)->VL_CONTABIL ,;
                "CKI_VLTOT" : (cAlias)->VL_TOTAL ,;
                "CKI_BSECAL": (cAlias)->BASE_CALC ,;
                "CKI_ALIQ"  : (cAlias)->ALIQUOTA ,;
                "CKI_VLTRIB": (cAlias)->VL_TRIBUTO,;
                "CKI_REGCAL": (cAlias)->REGRA_CALCULO_UTILIZADA;
        })

    (cAlias)->(dbskip())

enddo

(cAlias)->(DbCloseArea())
freeObj(oPrepare)

return self:oData


//-------------------------------------------------------------------
/*{Protheus.doc} execQuery
Execução da query com paginação.

@param oPrepare, objeto, preparação da query
@param oFilter, objeto, contém o filtro do SmartView
 
@return string

@author Wesley Matos
@since 12/08/2025
@version 1.0
*/
//-------------------------------------------------------------------
Method execQuery(oPrepare as object, oFilter as object) as character class MunicipalityParticipationIndexBusinessObject

Local cQuery   := "" as character
Local aBind    := {} as array
Local nI       := 0  as numeric
Local cId      := "" as character
Local cFilApu  := "" as character

Default oPrepare := Nil
Default oFilter  := Nil

cId      := oFilter:getParameters()["MV_PAR01"][1]
cFilApu  := oFilter:getParameters()["MV_PAR02"][1]

cQuery += " SELECT "
cQuery += "	CKI.CKI_FILIAL	FILIAL "
cQuery += "	,CKI.CKI_UFDOC	UF_DOCUMENTO "
cQuery += "	,CKI.CKI_CODIPM COD_IPM "
cQuery += "	,CKI.CKI_FILDOC FIL_DOCCUMENTO "
cQuery += "	,CKI.CKI_CODMUN COD_MUNICIPIO "
cQuery += "	,CKI.CKI_REGAPU REG_APURACAO "
cQuery += "	,CKI.CKI_CODTRI COD_TRIBUTO "
cQuery += "	,CKI.CKI_NF     NF "
cQuery += "	,CKI.CKI_SERIE  SERIE "
cQuery += "	,CKI.CKI_TPMOV  TIPO_MOVIMENTO "
cQuery += "	,CKI.CKI_ITEM   ITEM "
cQuery += "	,CKI.CKI_DTENT  DT_ENTRADA "
cQuery += "	,CKI.CKI_DTEMIS DT_EMISSAO "
cQuery += "	,CKI.CKI_UFNOTA UF_NF "
cQuery += "	,CKI.CKI_LOJA   LOJA "
cQuery += "	,CKI.CKI_UFPART UF_PARTICIPANTE "
cQuery += "	,CKI.CKI_MUNPAR MUN_PARTICIPANTE "
cQuery += "	,CKI.CKI_UFORIG UF_ORIGEM "
cQuery += "	,CKI.CKI_MUNORI MUN_ORIGEM "
cQuery += "	,CKI.CKI_UFDEST UF_DESTINO "
cQuery += "	,CKI.CKI_MUNDES MUN_DESTINO "
cQuery += "	,CKI.CKI_VLCONT VL_CONTABIL "
cQuery += "	,CKI.CKI_VLTOT  VL_TOTAL "
cQuery += "	,CKI.CKI_BSECAL BASE_CALC "
cQuery += "	,CKI.CKI_ALIQ   ALIQUOTA "
cQuery += "	,CKI.CKI_VLTRIB VL_TRIBUTO "
cQuery += "	,CKI.CKI_CLIENT CLIENTE "
cQuery += "	,CKI.CKI_FORNEC FORNECEDOR "
cQuery += "	,CKI.CKI_CODCLI COD_CLIENTE "
cQuery += "	,CKI.CKI_CODFOR COD_FORNECEDOR "
cQuery += "	,CKI.CKI_REGCAL REGRA_CALCULO_UTILIZADA "

cQuery += " FROM " + RetSqlName("CKI") + " CKI "
cQuery += " WHERE "

cQuery += " CKI.CKI_FILIAL = ?
aAdd(aBind, cFilApu )

cQuery += " AND CKI.CKI_IDDETA = ?
aAdd(aBind, cId )

cQuery += " AND D_E_L_E_T_ = ? 
aAdd(aBind,Space(1))

cQuery := ChangeQuery(cQuery)
oPrepare := FwExecStatement():New(cQuery)

for nI := 1 to len(aBind)
    oPrepare:setString( nI, aBind[nI] )
next nI

cAlias := GetNextAlias()
oPrepare:OpenAlias(cAlias)

return cAlias

