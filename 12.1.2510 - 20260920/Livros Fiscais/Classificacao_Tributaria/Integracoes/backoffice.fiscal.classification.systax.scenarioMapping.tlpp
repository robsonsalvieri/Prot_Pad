@since 18/05/2026
@param lDictUpdated, logical, .F. para simular dicionario desatualizado; .T. para restaurar
/*/
Method setDictUpdated(lDictUpdated as logical) Class FISScenarioMappingSystax
    self:lDictUpdated := lDictUpdated
Return

