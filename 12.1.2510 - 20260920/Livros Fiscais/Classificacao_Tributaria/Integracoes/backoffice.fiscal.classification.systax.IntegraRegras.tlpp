#include 'tlpp-core.th'
#include 'tlpp-rest.th'
#include "classificadorfiscal.ch"

Namespace totvs.protheus.backoffice.fiscal.Classifier

//----------------------------------------------------------------------------------------------------
/*/{Protheus.doc} GetRegrasSystax
Classe que contém os Gets para serem utilizados na tela de Retorno das Regras Systax

@author  Thiago Moreira
@since   06.04.2023
@version 1.0
/*/
//-----------------------------------------------------------------------------------------------------
Class IntegraRegras

    data cMockServer as character
    data cEndPointLegado as character
    data cEndPointReforma as character
    
    public method new() constructor

    @GET("/GetRegrasSystax")    
    public method getRegrasSystax()

End Class

//-------------------------------------------------------------------
/*/{Protheus.doc} New()
Método construtor da classe

@author  Thiago Moreira
@since   06.04.2023
@version 1.0
/*/
//-------------------------------------------------------------------
method new() class IntegraRegras
return

//-------------------------------------------------------------------
/*/{Protheus.doc} getRegrasSystax()
Método para retornar as regras da Systax

        
@author  Thiago Moreira
@since   06.04.2023
@version 1.0
/*/
//-------------------------------------------------------------------
method getRegrasSystax() class IntegraRegras

    Local jRet as json
    Local jRetRegrasLegado as json
    Local jRetRegrasReforma as json
    Local jRetScenarioMapping as json
    Local oRetRegraLegado as object
    Local oRetRegraReforma as object
    Local oScenarioMapping as object
    Local jQueryParams as json
    Local jHeaderResponse as json
    Local lSuccess as logical
    Local lDicionarioRT as logical
    Local lTemCampoCjiTipo := .F. as logical
    Local lTemIndiceCji    := .F. as logical
    Local lTemAliasCi5     := .F. as logical
    Local lTemCampoCjgRt   := .F. as logical
    Local lTemCampoCjbRt   := .F. as logical
    Local cMessage := STR0317 as character  // "Erro ao buscar novas regras."

    jQueryParams := oRest:GetQueryRequest()

	If ( jQueryParams:HasProperty('mockserver') )
		self:cMockServer := jQueryParams['mockserver']

        If ( jQueryParams:HasProperty('endpointLegado') )
            self:cEndPointLegado := jQueryParams['endpointLegado']
        EndIf

        If ( jQueryParams:HasProperty('endpointReforma') )
            self:cEndPointReforma := jQueryParams['endpointReforma']
        EndIf

        If ( jQueryParams:HasProperty('database') )
            dDataBase := SToD(jQueryParams['database'])
        EndIf
    EndIf

	jHeaderResponse := JsonObject():New()
	jHeaderResponse['Content-Type'] := 'application/json;charset=cp1252'
	oRest:SetHeaderResponse(jHeaderResponse)
    FreeObj(jHeaderResponse)

    // Regras do legado
    oRetRegraLegado := FISRetornaRegra():New()
    jRetRegrasLegado := oRetRegraLegado:FISRetornaRegra(,,,,self:cMockServer,self:cEndPointLegado)
    FreeObj(oRetRegraLegado)
    oRetRegraLegado := Nil

    // Gravação do De-Para de Ids de cenários
    lTemCampoCjiTipo := FISExtCmp("12.1.2510", .T., "CJI", "CJI_TIPO")
    lTemIndiceCji    := FwSIXUtil():ExistIndex("CJI", "3")
    lTemAliasCi5     := FwAliasInDic("CI5")
    lTemCampoCjgRt   := FISExtCmp("12.1.2510", .T., "CJG", "CJG_IDCENR")
    lTemCampoCjbRt   := FISExtCmp("12.1.2510", .T., "CJB", "CJB_IDCENR")

    lDicionarioRT := lTemCampoCjiTipo .And. lTemIndiceCji .And. ;
        lTemAliasCi5 .And. lTemCampoCjgRt .And. lTemCampoCjbRt

    If lDicionarioRT
        oScenarioMapping := FISScenarioMappingSystax():new()
        jRetScenarioMapping := {"success": .T., "message": STR0339} // Mapeamento de IDs de cenarios realizado com sucesso
        If !oScenarioMapping:loadScenarioMapping()
            jRetScenarioMapping := {"success": .F., "message": oScenarioMapping:getError()}
        EndIf
        oScenarioMapping:destroy()
        FreeObj(oScenarioMapping)
        oScenarioMapping := Nil

        // Regras da reforma tributária
        oRetRegraReforma := FisTaxReformRulesGetter():new(self:cMockServer,self:cEndPointReforma)
        jRetRegrasReforma := oRetRegraReforma:get()
        oRetRegraReforma:destroy()
        FreeObj(oRetRegraReforma)
        oRetRegraReforma := Nil
    EndIf

    If lDicionarioRT
        If jRetRegrasLegado["success"] .and. jRetRegrasReforma["success"]
            lSuccess := .T.
            cMessage := STR0208 // "Novas regras recebidas com sucesso."
        EndIf
    Else
        If jRetRegrasLegado["success"]
            lSuccess := .T.
            cMessage := STR0208 // "Novas regras recebidas com sucesso."
        EndIf
    EndIf
    
    jRet := {;
        "success": lSuccess,;
        "message": cMessage,;
        "regrasLegado": jRetRegrasLegado;
    }

    If lDicionarioRT
        jRet["cenarioMapping"] := jRetScenarioMapping
        jRet["regrasReforma"] := jRetRegrasReforma
    EndIf

Return oRest:setResponse(jRet)
