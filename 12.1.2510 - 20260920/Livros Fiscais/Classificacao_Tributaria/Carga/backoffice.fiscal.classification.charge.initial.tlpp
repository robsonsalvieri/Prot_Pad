    EndIf

    self:oStatementCJH:SetString( 1, xFilial("CJH") )
    self:oStatementCJH:SetString( 2, cCod )
    self:oStatementCJH:SetString( 3, cTipo )
    self:oStatementCJH:SetString( 4, ' ' )

Return self:oStatementCJH:OpenAlias(GetNextAlias())

//-------------------------------------------------------------------
