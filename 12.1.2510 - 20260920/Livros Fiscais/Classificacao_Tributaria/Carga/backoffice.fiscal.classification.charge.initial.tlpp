Return

//-------------------------------------------------------------------
/*/{Protheus.doc} GravaRegistroCJF
Método que realiza a gravação de registro na tabela CJF -
Cad. Nat. Oper. Classif.

@author  Juliano Fernandes
@since   03/12/2023
@version 1.0
/*/
//-------------------------------------------------------------------
METHOD GravaRegistroCJF(cCod, cTipo, cCFOP) CLASS FISImportCarga

    DbSelectArea("CJF")

    RecLock("CJF", .T.)

    CJF->CJF_FILIAL := xFilial("CJF")
    CJF->CJF_COD    := cCod
    CJF->CJF_TIPO   := cTipo
    CJF->CJF_CFOP   := cCFOP

    CJF->(MsUnlock())

    CJF->(DbCloseArea())

Return

//-------------------------------------------------------------------
/*/{Protheus.doc} FISImportCarga::ImportCenariosValidadosSystax
Grava Cenários Validados Systax na Tabela CI8

@author  Fábio Mendonça
@since   13/08/2026
@version 1.0
@param   aCenariosValidosSystax, array, Array com os cenários validados systax: {TipMov, NatOpe, Finalidade, SegOri, SegDes}
@param   oBulkInj, object, Opcional. Objeto compativel com FwBulk usado na carga. Quando nao informado, e criado um FwBulk real. Permite simular falhas de AddData/Close em teste unitario
@return  lRet, logical, .T. quando a carga em lote foi concluída com sucesso

@see     https://tdn.totvs.com/display/public/framework/FWBulk
/*/
//-------------------------------------------------------------------
METHOD ImportCenariosValidadosSystax(aCenariosValidosSystax as array, oBulkInj as object) CLASS FISImportCarga
    Local nE          as integer
    Local nTotal      as integer
    Local lRet        := .T. as logical
    Local cMsg        := "" as character
    Local cFilCI8     as character
    Local oBulk       as object
    Local cTipMov     as character
    Local cNatOpe     as character
    Local cFinali     as character
    Local cSegOri     as character
    Local cSegDes     as character
    Local cKey        as character
    Local oChaves     as json

    nTotal     := Len(aCenariosValidosSystax)

    cFilCI8 := xFilial("CI8")

    // Idempotencia: carrega em memoria (uma unica consulta) as chaves ja existentes na CI8
    oChaves := ::CarregaChavesCI8()

    If ( oBulkInj == Nil )
        oBulk := FwBulk():New(RetSqlName("CI8"), 500)
    Else
        oBulk := oBulkInj
    EndIf

    oBulk:SetFields({ {"CI8_FILIAL"},;
                      {"CI8_TIPMOV"},;
                      {"CI8_NATOPE"},;
                      {"CI8_FINALI"},;
                      {"CI8_SEGORI"},;
                      {"CI8_SEGDES"} })

    For nE := 1 To nTotal

        cTipMov := AllTrim(aCenariosValidosSystax[nE][1])
        cNatOpe := AllTrim(aCenariosValidosSystax[nE][2])
        cFinali := AllTrim(aCenariosValidosSystax[nE][3])
        cSegOri := AllTrim(aCenariosValidosSystax[nE][4])
        cSegDes := AllTrim(aCenariosValidosSystax[nE][5])

        // Monta a chave do cenario e pula os que ja existem na CI8 (idempotencia)
        cKey := cTipMov + "|" + cNatOpe + "|" + cFinali + "|" + cSegOri + "|" + cSegDes
        If oChaves:HasProperty(cKey)
            Loop
        EndIf

        lRet := oBulk:AddData({ cFilCI8, cTipMov, cNatOpe, cFinali, cSegOri, cSegDes })

        If  !lRet
            cMsg := oBulk:GetError()
            FWLogMsg("DEBUG", "ImportCenarios", "FISImportCarga", FunName(), "CLASSIFICADOR", "1", ;
                "Falha ao inserir cenario na CI8 via FwBulk: " + cMsg)
            Exit
        EndIf

        // Marca a chave para evitar duplicidade tambem dentro do proprio array
        oChaves[cKey] := .T.

    Next nE

    If lRet
        lRet := oBulk:Close()

        If !lRet
            cMsg := oBulk:GetError()
            FWLogMsg("DEBUG", "ImportCenarios", "FISImportCarga", FunName(), "CLASSIFICADOR", "1", ;
                "Falha ao finalizar carga da CI8 via FwBulk: " + cMsg)
        EndIf
    EndIf

    oBulk:Destroy()

    FwFreeObj(oChaves)
Return lRet

//-------------------------------------------------------------------
/*/{Protheus.doc} FISImportCarga::CarregaChavesCI8
Carrega em memoria, em uma unica consulta, as chaves dos cenarios ja
existentes na CI8 (TipMov|NatOpe|Finali|SegOri|SegDes) da filial corrente.
Utilizado para conferir idempotencia ao FwBulk na carga em lote.

@author  Fábio Mendonça
@since   13/08/2026
@version 1.0
@return  oChaves, json, objeto com as chaves existentes

@see https://tdn.totvs.com/display/public/framework/FWExecStatement
/*/
//-------------------------------------------------------------------
METHOD CarregaChavesCI8() CLASS FISImportCarga
    Local oChaves := JsonObject():New() as json
    Local oStmt   as object
    Local cAlias  as character
    Local cQry    := "" as character
    Local cKey    := "" as character

    cQry := "SELECT CI8_TIPMOV, CI8_NATOPE, CI8_FINALI, CI8_SEGORI, CI8_SEGDES "
    cQry += "FROM " + RetSqlName("CI8") + " CI8 "
    cQry += "WHERE CI8_FILIAL = ? "
    cQry += " AND D_E_L_E_T_ = ' ' "

    oStmt := FWExecStatement():New( ChangeQuery(cQry) )
    oStmt:SetString( 1, xFilial("CI8") )
    cAlias := oStmt:OpenAlias(GetNextAlias())

    FWLogMsg("DEBUG",, "systax", FunName(),,, oStmt:getFixQuery())

    While !(cAlias)->(EoF())
        cKey := AllTrim((cAlias)->CI8_TIPMOV) + "|" + ;
                AllTrim((cAlias)->CI8_NATOPE) + "|" + ;
                AllTrim((cAlias)->CI8_FINALI) + "|" + ;
                AllTrim((cAlias)->CI8_SEGORI) + "|" + ;
                AllTrim((cAlias)->CI8_SEGDES)

        oChaves[cKey] := .T.

        (cAlias)->(DbSkip())
    EndDo

    (cAlias)->(DbCloseArea())

    oStmt:destroy()
    FwFreeObj(oStmt)
Return oChaves

//-------------------------------------------------------------------
/*/{Protheus.doc} RemoveEnquad
Método que realiza a remoção de enquadramentos da tabela CJK

@author  Juliano Fernandes
@since   11/02/2025
@version 1.0
@param   aRemove, array, Array com os enquadramentos a serem removidos
/*/
//-------------------------------------------------------------------
method RemoveEnquad(aRemove as array) class FISImportCarga

    local i as numeric
    local cCodigo as character
    local cTipo as character
    local nTamCodigo := 0 as numeric
    local nTamTipo := 0 as numeric

    nTamCodigo := FWSX3Util():GetFieldStruct('CJK_CODIGO')[3]
    nTamTipo   := FWSX3Util():GetFieldStruct('CJK_TIPO')[3]

    DbSelectArea('CJK')
    CJK->(DbSetOrder(1))

    for i := 1 to Len(aRemove)
        cCodigo := PadR(aRemove[i][1], nTamCodigo)
        cTipo   := PadR(aRemove[i][3], nTamTipo)

        if ( CJK->(MsSeek(FWxFilial('CJK') + cCodigo + cTipo)) )

            CJK->(RecLock('CJK', .F.))
            CJK->(DbDelete())
            CJK->(MsUnLock())

        endif
    next i

    CJK->(DbCloseArea())

return
