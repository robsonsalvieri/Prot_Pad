#INCLUDE "PROTHEUS.CH"
#INCLUDE "TOPCONN.CH"
#Include 'BACKOFFICE.FISCAL.FISA847.CH'



#DEFINE _BUFFER     	 16384
#DEFINE _SEPARADOR		CHR(59) // ;
#DEFINE _SEPARADORDEC 	CHR(44) //,

#DEFINE _POSFCHPUB  1
#define	_POSINIVIG  2
#DEFINE _POSFINVIG  3
#DEFINE _POSCGC     4
#DEFINE _POSTIPO    5
#DEFINE _POSALTA    6
#DEFINE _POSMARCAL  7
#DEFINE _POSALICP   8
#DEFINE _POSALICR   9
#DEFINE _POSGRPPER 10
#DEFINE _POSGRPRET 11
#DEFINE _POSRAZON  12
#DEFINE _IMP  		"IBK"
#DEFINE _IMPRet		"IBR"
#DEFINE _PROV  		"SF"

Static cMes      := StrZero(Month(dDataBase),2)
Static cMesIni	 := StrZero(Month(dDataBase),2)
Static cAnoIni	 := StrZero(Year(dDataBase),4)
Static lPer	     := .T.
Static lReten    := .F.
Static cFile     := ""
Static dDataIni  := CTOD("\\")
Static dDataFim  := CTOD("\\")
Static lFor      := .F.
Static lCli      := .F.
Static lImp      := .F.
Static cAliasPdr := GetNextAlias()
Static cSA1      := ""
Static cSA2      := ""
Static oQryExFech:= Nil
Static oChk1		:= Nil
Static oChk2		:= Nil
Static oBulkSFH		:= Nil
Static nTamNome		:= GetSX3Cache("FH_NOME","X3_TAMANHO")

/*/{Protheus.doc} FISA847
    Lanza la pantalla para introducir información del padron a cargar
    @type  Function
    @author adrian.perez
    @since 09/02/2026
  	@param cFileSel , character, Archivo a ser utilizado para carga del padrón (Uso para automatizados)
    @param cTipoSel, character, Selección del clientes o proveedores (Uso para automatizados) - Opción de aCombo
    @param cMesSel , character, Mes de carga del padrón (Uso para automatizados)
    @param cAnoSel , character, Año de carga del padrón (Uso para automatizados)
    @param lPerSel , logical  , Indica si el padrón realiza la actualización para percepciones (Uso para automatizados)
    @param lRetSel , logical  , Indica si el padrón realiza la actualización para percepciones (Uso para automatizados)
	@return nil
    /*/  

Function FISA847(cFileSel, cTipoSel, cMesSel, cAnoSel, lPerSel,lRetSel)

	Local cCombo	:= ""
	Local aCombo	:= {}
	Local oDlg		:= Nil
	Local oFld		:= Nil
	Local oCombo	:= Nil
	Local lAutomato := IsBlind()

	DEFAULT cFileSel	:= ""
	DEFAULT cTipoSel:= ""
	DEFAULT cMesSel	:= ""
	DEFAULT cAnoSel	:= ""
	DEFAULT lPerSel	:= .F.
	Default lRetSel := .F.

	aAdd( aCombo, STR0002 ) //"1- Proveedor"
	aAdd( aCombo, STR0003 ) //"2- Cliente"
	aAdd( aCombo, STR0004 ) //"3- Ambos  "

If !lAutomato
	DEFINE MSDIALOG oDlg TITLE STR0005 FROM 0,0 TO 260,455 OF oDlg PIXEL // STR0005 'DGR 37-2025 - Santa Fe Percepción y Retención'

	@ 006,006 TO 040,175 LABEL STR0006 OF oDlg PIXEL //STR0006 "Info. Preliminar"

	@ 011,010 SAY STR0007 SIZE 065,008 PIXEL OF oFld // STR0007 "Registro"
	@ 025,010 COMBOBOX oCombo VAR cCombo ITEMS aCombo SIZE 65,8 PIXEL OF oFld ON CHANGE ValidChk(cCombo)

//+----------------------
//| Campos Check-Up
//+----------------------


	@ 010,115 CHECKBOX oChk1 VAR lPer PROMPT STR0009 SIZE 40,8 PIXEL OF oFld  ON CHANGE ValidChk(cCombo) //STR0009 'Percepción'
	@ 026,115 CHECKBOX oChk2 VAR lReten PROMPT STR0026 SIZE 40,8 PIXEL OF oFld  ON CHANGE ValidChk(cCombo)//STR0026 'Retención'
	

	@ 041,006 FOLDER oFld OF oDlg PROMPT STR0008 PIXEL SIZE 170,080 //STR0008 'Importación de archivo TXT'

//+----------------
//| Campos Folder 2
//+----------------
	@ 005,005 SAY STR0010 SIZE 150,008 PIXEL OF oFld:aDialogs[1] //STR0010 "Esta opción tiene como objetivo actualizar el registro"
	@ 015,005 SAY STR0012 SIZE 150,018 PIXEL OF oFld:aDialogs[1] //STR0012 "Proveedor / Cliente DGR 37-2025 - Santa Fe Percepción y Retención de acuerdo al archivo TXT"
	@ 035,005 SAY STR0013 SIZE 150,008 PIXEL OF oFld:aDialogs[1] //STR0013 "Puesto a disposición por el gobierno"

	@ 049,005 SAY STR0014  SIZE 150,008 PIXEL OF oFld:aDialogs[1] //STR0014 "Informe o periodo:"
	@ 047,055 MSGET cMesIni PICTURE "@E 99" VALID !Empty(cMesIni) SIZE  015,008 PIXEL OF oFld:aDialogs[1]
	@ 049,070 SAY " /" SIZE  150, 8 PIXEL OF oFld:aDialogs[1]
	@ 047,075 MSGET cAnoIni PICTURE "@E 9999" VALID !Empty(cAnoIni) SIZE 020,008 PIXEL OF oFld:aDialogs[1]

//+-------------------
//| Boton de MSDialog
//+-------------------
	@ 070,182 BUTTON STR0015 SIZE 036,016 PIXEL ACTION ImpArq(aCombo,cCombo)  //STR0015 "Importar"
	@ 090,182 BUTTON STR0016 SIZE 036,016 PIXEL ACTION oDlg:End() //STR0016 "salir"

	ACTIVATE MSDIALOG oDlg CENTER
Else
	cMesIni := cMesSel
	cAnoIni := cAnoSel
	lPer	:= lPerSel
	lReten  := lRetSel
	cFile   := cFileSel
	ImpArq(aCombo, cTipoSel)
EndIF
	FwFreeObj(oDlg)
	FwFreeObj(oFld)
	FwFreeObj(oCombo)
	FwFreeObj(oChk1)
	aSize(aCombo,0)

Return Nil



/*/{Protheus.doc} ImpArq
    Inicializa la importación del archivo
    @type  Function
    @author adrian.perez
    @since 09/02/2026
    @param  aCombo, array ,    combo cliente/proveedor amnos.
    @param  cCombo, character, opción seleccionado
    @return nil
    /*/  

Static Function ImpArq(aCombo, cCombo)

	Local   nPos        := 0
	Local 	lAutomato   := IsBlind()
	Local  	cStartPath 	:= GetSrvProfString("StartPath","")
	Local 	cExt		:= ""
	Local 	cNewFile	:= ""
	Local	lCopy		:= .F.

	Default aCombo		:= {}
	Default cCombo		:= ""

	cCombo := Substr(AllTrim(cCombo),1,1)
	nPos := aScan(aCombo,{|x| Substr(AllTrim(x),1,1) == cCombo})
	
	If nPos == 1 		// proveedor
		lFor := .T.
		lCli := .F.
	ElseIf nPos == 2 	// Cliente
		lCli := .T.
		lReten:=.F.
		lFor := .F.
	ElseIf nPos == 3 	// Ambos
		lFor := .T.
		lCli := .T.
		lReten:=.T.
		lPer :=.T.
	EndIf

	
	If !lAutomato
		cFile := FGetFile()
		cStartPath := StrTran(cStartPath,"/","\")
		If !(Right(cStartPath,1)=="\")
			cStartPath += "\"
		EndIf
		If !Empty(cFile) 	
			If !(cFile $ cStartPath)
				If ":" $ cFile
					SplitPath(cFile,/*cDrive*/,/*cPath*/, @cNewFile,@cExt)
					If CpyT2S(cFile, cStartPath,.T.)
						lCopy:=.T.
						cFile := cStartPath + cNewFile + cExt
					ENDIF
				Endif
			EndIf
		EndIF
	EndIf
	If Empty(cFile)
		MsgStop(STR0024) //STR0024 "Seleccione un archivo e intente nuevamente."
		Return Nil
	EndIf

	If !File(cFile)
		MsgStop(STR0024) //STR0024 "Seleccione un archivo e intente nuevamente."
		Return Nil
	EndIf
	If VldArch() .and. (lPer .OR. lReten)
		If !lAutomato
			MsAguarde({|| Import(cFile)} ,STR0017,STR0019 ,.T.) //"STR0017 Leyendo archivo, espere... STR0018 'Actualización de registros'
		Else
			Import(cFile)
		EndIf
	EndIf

	If lCopy
		FERASE(cFile)
	EndIf

	If (lImp ) .and. !lAutomato
		MsgAlert(STR0021,"") //STR0021 '¡Datos importados!'
		lImp:=.F.
		oQryExFech:Destroy()
		oQryExFech:=Nil
	EndIf
Return Nil


/*/{Protheus.doc} FGetFile
    Pantalla para seleccionar archivo
    @type  Function
    @author adrian.perez
    @since 09/02/2026
    @return cRet,character, directorio del archivo seleccionado.
    /*/  

Static Function FGetFile()
	Local oDlg01 := Nil
	Local oGet01 := Nil
	Local oBtn01 := Nil
	Local oBtn02 := Nil
	Local oBtn03 := Nil
	Local cRet := Space(50)

	oDlg01 := MSDialog():New(000,000,100,500,STR0022,,,,,,,,,.T.)//STR0022 "Selecionar archivo"

	oGet01 := TGet():New(010,010,{|u| If(PCount()>0,cRet:=u,cRet)},oDlg01,215,10,,,,,,,,.T.,,,,,,,,,,"cRet")
	oBtn01 := TBtnBmp2():New(017,458,025,028,"folder6","folder6",,,{|| FGetDir(oGet01)},oDlg01,STR0022,,.T.)// STR0022 "Selecionar archivo"

	oBtn02 := SButton():New(035,185,1,{|| oDlg01:End() }         ,oDlg01,.T.,,)
	oBtn03 := SButton():New(035,215,2,{|| cRet:="",oDlg01:End() },oDlg01,.T.,,)

	oDlg01:Activate(,,,.T.,,,)

	FwFreeObj(oDlg01)
	FwFreeObj(oGet01)
	FwFreeObj(oBtn01)
	FwFreeObj(oBtn02)
	FwFreeObj(oBtn03)

Return cRet


/*/{Protheus.doc} FGetDir
    Pantalla para buscar y seleccionar el archivo en los directorios
    locais/servidor/unidades mapeadas.
    @type  Function
    @author adrian.perez
    @since 09/02/2026
    @param  oTGet, object, TGet que ira receber o local e o arquivo
    @return nil
    /*/  
Static Function FGetDir(oTGet)

	Local cDir := ""

	DEFAULT oTGet := Nil

	cDir := cGetFile(,STR0022,,,.T.,GETF_LOCALFLOPPY+GETF_LOCALHARD+GETF_NETWORKDRIVE)//STR0022 "Selecionar archivo"
	If !Empty(cDir)
		oTGet:cText := cDir
		oTGet:Refresh()
	Endif
	oTGet:SetFocus()

Return Nil


/*/{Protheus.doc} VldArch
    Validacion del archivo
    @type  Function
    @author adrian.perez
    @since 09/02/2026    
    @return logical, .F. si genera error
    /*/  

Static Function VldArch()

	Local cErro		:= STR0023 //STR0023 'Ocurrió un error al procesar un registro seleccionado. Verifique si el contenido está correcto e intente nuevamente.'
	Local cSolucao 	:= STR0024 //STR0024 "Seleccione un registro e intente nuevamente."
	Local cTitulo	:= STR0001 //STR0001 "Atención"
	Local oFile		:= Nil
	Local cLine		:=""
	
	oFile := FWFileReader():New(cFile)
	if (oFile:Open())
		If oFile:hasLine()
			cLine:=oFile:GetLine()
			If !(_SEPARADOR $ (cLine)) .OR. LEN(StrTokArr2(cLine,_SEPARADOR)[2]) <>8 .OR. LEN(StrTokArr2(cLine,_SEPARADOR)[3]) <>8 .OR. !(_SEPARADORDEC $ StrTokArr2(cLine,_SEPARADOR)[8]  )  .OR. !(_SEPARADORDEC $ StrTokArr2(cLine,_SEPARADOR)[9]  ) 
				xMagHelpFis(cTitulo,cErro,cSolucao)
				Return .F.
			EndIf
			IF SubStr(StrTokArr2(cLine,_SEPARADOR)[_POSINIVIG],3,2)!=cMesIni .OR. cAnoIni !=SubStr(StrTokArr2(cLine,_SEPARADOR)[_POSINIVIG],5,4)
				xMagHelpFis(cTitulo,STR0028, STR0028) //STR0028 "Periodo no coincide entre padrón e informado"  //STR0029 "Verifique periodo"
				Return .F.
			EndIF
		EndIf
	EndIf
	dDataIni := CTOD("01/"+cMesIni+"/"+cAnoIni)
	dDataFim := LastDay(dDataIni)
	oFile:Close()
	FwFreeObj(oFile)

Return .T.


/*/{Protheus.doc} Import
    Función para realizar la importación del archivo.
    @type  Function
    @author adrian.perez
    @since 02/09/2026
    @param  cFile, character, archivo a ser importado
    @return lReturn,logical, Indica si se completo el proceso.
    /*/  

Static Function Import(cFile)

	Local lReturn   	:= .T.
	Local lAutomato 	:= IsBlind()

	DEFAULT cFile		:= ""

	If F845LeePad(cFile)
		If !lAutomato
			Processa({|| lReturn := GeraTemp(cFile)})
		Else
			lReturn := GeraTemp(cFile)
		EndIf
	EndIf

Return lReturn


/*/{Protheus.doc} GeraTemp
    Función para realizar la busqueda de todos los proveedores y clientes para verificar si existe en el archivo TXT de importación.
    @type  Function
    @author adrian.perez
    @since 09/02/2026
    @param  cArqProc , character, archivo a ser importado
    @return  lReturn,	logical  , retorna .T. si la importación no tuvo errores.
    /*/  

Static Function GeraTemp(cArqProc)
	
	Local cQuery	 := ""
	Local cCGCEmp	 := FWArrFilAtu()[18] // SM0->M0_CGC
	Local lReturn    := .T.
	Local nParamA1   := 1
	Local nParamA2   := 1
	Local oQryExecA1 := Nil
	Local oQryExecA2 := Nil
	Local nTotal	 := 0

	Default cArqProc := ""

	If lCli .and. lPer
		cQuery := ""
		cQuery := "SELECT A1.A1_COD, A1.A1_LOJA, A1.A1_CGC, A1.A1_NOME"
		cQuery += "FROM                         "+RetSqlName("SA1")+" A1 "
		cQuery += " WHERE A1.A1_FILIAL        = ?    "
		cQuery += "   AND A1.A1_CGC          <> ?    "
		cQuery += "   AND A1.D_E_L_E_T_       = ?    "
		cQuery += " ORDER BY A1.A1_CGC  ASC          "
		cQuery := ChangeQuery(cQuery)
		oQryExecA1 := FwExecStatement():New(cQuery)
		oQryExecA1:SetString(nParamA1++, xFilial("SA1"))
		oQryExecA1:SetString(nParamA1++, Space(1))
		oQryExecA1:SetString(nParamA1++, Space(1))
		cSA1 := oQryExecA1:OpenAlias()
	
	EndIf

	If lFor .and. (lPer .or. lReten)
		cQuery := ""
		cQuery := "SELECT A2.A2_COD, A2.A2_LOJA, A2.A2_CGC, A2.A2_NOME"
		cQuery += "FROM                           "+RetSqlName("SA2")+" A2 "
		cQuery += " WHERE A2.A2_FILIAL          = ?    "
		cQuery += "   AND A2.A2_CGC            <> ?    "
		cQuery += "   AND A2.D_E_L_E_T_         = ?    "
		cQuery := ChangeQuery(cQuery)
		oQryExecA2 := FwExecStatement():New(cQuery)
		oQryExecA2:SetString(nParamA2++, xFilial("SA2"))
		oQryExecA2:SetString(nParamA2++, Space(1))
		oQryExecA2:SetString(nParamA2++, Space(1))
		cSA2 := oQryExecA2:OpenAlias()
		
	EndIf


	nTotal := F845TotReg(lCli, lFor, lPer, lReten)
	ProcRegua(nTotal)
	oBulkSFH := FwBulk():New(RetSqlName("SFH"),1000)
	oBulkSFH:setFields({{"FH_FILIAL"}, {"FH_AGENTE"}, {"FH_ZONFIS"}, {"FH_FORNECE"},{"FH_CLIENTE"}, {"FH_LOJA"}, {"FH_NOME"}, {"FH_IMPOSTO"}, {"FH_PERCIBI"}, {"FH_ISENTO"}, {"FH_APERIB"}, {"FH_ALIQ"}, {"FH_PERCENT"}, {"FH_TIPO"}, {"FH_INIVIGE"}, {"FH_FIMVIGE"}, {"FH_COEFMUL"}, {"FH_SITUACA"}})

	If lFor .and. lPer
		(cSA2)->(dbGoTop())
	
		If (cAliasPdr)->(MsSeek(cCGCEmp))
			fProvPer(.T.,(VAL((cAliasPdr)->ALICPERC)))
		Else
			fProvPer(.F.,0)
		EndIf
	EndIf
	If lCli .and. lPer
		oQryExFech:=NIL
		(cSA1)->(dbGoTop())
	
		While (cSA1)->(!EOF())
			IncProc(STR0018)  //"Procesando archivo..."
			If (cAliasPdr)->(MsSeek((cSA1)->A1_CGC))
				fCliPer(.T.,(VAL((cAliasPdr)->ALICPERC)))
			Else
				fCliPer(.F.,0)
			EndIf
			(cSA1)->(dbSkip())
		Enddo
	EndIf
	If lFor .and.  lReten
		oQryExFech:=NIL
		(cSA2)->(dbGoTop())
		While (cSA2)->(!EOF())
			IncProc(STR0018)  //"Procesando archivo..."
			If (cAliasPdr)->(MsSeek((cSA2)->A2_CGC))
				fProvRet(.T.,VAL((cAliasPdr)->ALICRETE))
			Else
				fProvRet(.F.,0)
			EndIf
			(cSA2)->(dbSkip())
		EndDo
	Endif
	
	SFH->(dbCloseArea())
	(cAliasPdr)->(dbCloseArea())
		
	//Se limpia el buffer para evitar que queden registros sin procesar en caso de que la cantidad de registros del archivo no sea múltiplo de la cantidad definida en el bulk.
	oBulkSFH:Flush()
	oBulkSFH:Close()
	oBulkSFH:Destroy()
	FwFreeObj(oBulkSFH)
	oBulkSFH := nil
		
	If lCli .and. lPer
		(cSA1)->(dbCloseArea())
		oQryExecA1:Destroy()
		oQryExecA1:=Nil
	EndIf
	If lFor .and. (lPer .or. lReten)
		(cSA2)->(dbCloseArea())
		oQryExecA2:Destroy()
		oQryExecA2:=Nil
	EndIf
	
Return(lReturn)



/*/{Protheus.doc} CreaTabla
    Función para realizar la geracion de la tabla temporal del padron con todos los datos del archivo TXT de importación.
    @type  Function
    @author adrian.perez
    @since 10/02/2026
    @param  cArqProc,	character, archivo a ser importado
    @return lRetu,		 logical, 	retorna .T. si la importación no tuvo errores.
    /*/  

Static Function CreaTabla(cArqProc)
	Local aInforma    := {} // Array auxiliar com as informacoes da linha lida no arquivo XLS
	Local cMsg        := STR0017 //STR0018 'Leyendo archivo, espere...'
	Local aStru     := {}
	Local lRetu       := .T.
	Local nTotArq     := 0
	Local nProcArq    := 0
	Local nPerProc    := 0
	Local oFile       := Nil
	Local oBulk       := Nil
	Local lCanUseBulk := .F.
	Local cIndex      := ""
	Local nTamRazonS  := 60

	DEFAULT cArqProc := ""

	AADD(aStru,{ "FCHPUB"  ,  "C",  8,  0})
	AADD(aStru,{ "INIVIGE" ,  "C",  8,  0})
	AADD(aStru,{ "FINVIGE" ,  "C",  8,  0})
	AADD(aStru,{ "CUIT"    ,  "C",  14, 0})
	AADD(aStru,{ "TIPOINS" ,  "C",  1,  0})
	AADD(aStru,{ "MARCALTA",  "C",  1,  0})
	AADD(aStru,{ "MARCALIC",  "C",  1,  0})
	AADD(aStru,{ "ALICPERC",  "C",  6,  0})
	AADD(aStru,{ "ALICRETE",  "C",  6,  0})
	AADD(aStru,{ "GRPPERC" ,  "C",  6,  0})
	AADD(aStru,{ "GRPRETE" ,  "C",  6,  0})
	AADD(aStru,{ "RAZONSOC",  "C",  60, 0})

		If Select(cAliasPdr) <> 0
			(cAliasPdr)->(dbCloseArea())
		EndIf
		If TCCanOpen(cAliasPdr)
			If !TCDelFile(cAliasPdr)
				MsgAlert( STR0027 + TCSqlError() ) //STR0027 Error de borrado de tabla padrón.
				lRetu := .F.
			EndIf
		EndIf

		FWDBCreate(cAliasPdr, aStru , 'TOPCONN' , .T.)
		
		oFile := FWFileReader():New(cArqProc)
		oFile:Open()
		nTotArq := oFile:getFileSize()
		oBulk := FwBulk():New(cAliasPdr,600)
		lCanUseBulk := FwBulk():CanBulk() // Este método não depende da classe FWBulk ser inicializada por NEW
		If lCanUseBulk
			oBulk:SetFields(aStru)
			ProcRegua(100)
			while (oFile:hasLine())
				aInforma := StrTokArr2(oFile:GetLine(),_SEPARADOR)
				If Len(aInforma) == 12
				
					cIniVige := SubStr(aInforma[_POSINIVIG] , 5, 4) + SubStr(aInforma[_POSINIVIG] , 3, 2) + SubStr(aInforma[_POSINIVIG] , 1, 2)
					cFinVige := SubStr(aInforma[_POSFINVIG] , 5, 4) + SubStr(aInforma[_POSFINVIG] , 3, 2) + SubStr(aInforma[_POSFINVIG] , 1, 2)
					
					aInforma[_POSRAZON] := Replace(PadR(aInforma[_POSRAZON], nTamRazonS),'"',"")
					oBulk:AddData({;
						aInforma[_POSFCHPUB],; 
						cIniVige,;
						cFinVige,;
						aInforma[_POSCGC],;
						aInforma[_POSTIPO],; 
						aInforma[_POSALTA],; 
						aInforma[_POSMARCAL],;
						Replace(aInforma[_POSALICP], _SEPARADORDEC, '.'),;
						Replace(aInforma[_POSALICR], _SEPARADORDEC, '.'),;
						aInforma[_POSGRPPER],;
						aInforma[_POSGRPRET],;
						aInforma[_POSRAZON]})

						///
						aSize(aInforma,0)
						nProcArq := oFile:getBytesRead()
						nProcArq := NoRound((nProcArq*100)/nTotArq,0)
						If nProcArq > nPerProc
							nPerProc := nProcArq
							IncProc(cMsg + str(nProcArq) + "%")
						EndIf
				EndIf

			EndDo
			oBulk:Flush()
			oBulk:Close()
			oBulk:Destroy()
			oBulk := nil
		EndIf
		
		If Select(cAliasPdr) == 0
			DbUseArea(.T.,"TOPCONN",cAliasPdr,cAliasPdr,.T.)
			cIndex := cAliasPdr+"1"
			If ( !MsFile(cAliasPdr,cIndex, "TOPCONN") )
				DbCreateIndex(cIndex,"CUIT",{|| "CUIT" })
			EndIf
			Set Index to (cIndex)
		EndIf
		oFile:Close()	
		FwFreeObj(oFile)
		aSize(aInforma,0)
		aSize(aStru,0)

Return lRetu



/*/{Protheus.doc} fCliPer
    Función para realizar la buscqueda de verificaciones y actualizacion de los registros en la tabla SFH para clientes.
    @type  Function
    @author adrian.perez
    @since 10/02/2026
    @param  lPadron, logical  , indica si el CUIT del Cliente existe en el archivo TXT de importación.
    @param  nAliq, 	 numeric  , valor de la alicuota
    @return nil
    /*/  

Static Function fCliPer(lPadron,nAliq)
	Local lSfhPadr := .F.
	Local lGenera 	:= .F.
	Local nRecFim 	:= 0
	Local cIsento	:="N"
    Local nPercent	:=0
	Local cPERCIBI	:="S"
	Local cAPERIB	:="S"

	DEFAULT lPadron := .F.
	DEFAULT nAliq := 0

	If lCli .and. lPer
		If nAliq==0
		  cIsento:="S"
		  nPercent:=100
	      cPERCIBI:="N"
	      cAPERIB:="N"
		EndIF
		nRecFim :=  MayorFech((cSA1)->A1_COD,(cSA1)->A1_LOJA,_IMP,_PROV,.T.)
		IF nRecFim>0
			SFH->(DbGoTo(nRecFim))
			
			IF !lPadron
				If SFH->FH_FIMVIGE > dDataIni .Or. Empty(SFH->FH_FIMVIGE)
						RecLock("SFH", .F.)
						SFH->FH_FIMVIGE := dDataIni
						SFH->(MsUnlock())
				EndIf
			else
				lSfhPadr := .T.
			EndIF
		Endif
		If lPadron
			
			If lSfhPadr
				If nAliq <> SFH->FH_ALIQ
					lGenera  := .T.
				EndIf
				If !lGenera
					RecLock("SFH", .F.)
					SFH->FH_FIMVIGE := dDataFim
					SFH->(MsUnlock())
				Else
					RecLock("SFH", .F.)
					SFH->FH_FIMVIGE := DaySub(dDataIni,1)
					SFH->(MsUnlock())
					
					NewSFH(SFH->FH_AGENTE,SFH->FH_CLIENTE,SFH->FH_TIPO,SFH->FH_LOJA,SFH->FH_PERCIBI,SFH->FH_APERIB,SFH->FH_ZONFIS,SFH->FH_IMPOSTO,nAliq,SFH->FH_PERCENT,SFH->FH_COEFMUL,cIsento,SFH->FH_SITUACA,"SA1",(cSA1)->A1_NOME)
				EndIf
			Else// no esta en SFH
				NewSFH("N",(cSA1)->A1_COD,"I",(cSA1)->A1_LOJA,cPERCIBI,cAPERIB,_PROV,_IMP,nAliq,nPercent,0,cIsento,"1","SA1",(cSA1)->A1_NOME) 
			EndIf
			
		EndIf // fin Padron
		lGenera := .F.
		lSfh := .F.
		lImp := .T.
	EndIf // fin cli & per

Return Nil

/*/{Protheus.doc} NewSFH
    Función para realizar la creacion de nuevos registros en la tabla SFH.
    @type  Function
    @author adiran.perez
    @since 11/02/2026
    @param  cAgente , character, indica si es agente.
    @param  cCOD    , character, codigo del proveedor o cliente.
	@param  cTipo   , character, indica el tipo.
    @param  cLoja   , character, indica la surcursal.
	@param  cPercIBI, character, indica si paga impuesto en esta zona.
    @param  cAPERIB , character, indica si paga IB.
	@param  cZonaFis, character, indica la zona.
    @param  cImpost , character, indica el impuesto.
	@param  nAliq   , numeric, indica el valor de la alicuota.
    @param  nPercent, numeric, incida la porcentaje de exencion
    @param  nCoefMul, numeric, indica el valor de la alicuota.
	@param  cIsento,  character, indica si es exento
	@param  nSituaca, numeric; indica el valor de la situación de acuerdo a la SFH
    @param  cTable  , character, indica la tabla si es A1 o A2, cliente o proveedor.
    @param  cNome   , character, indica el nombre del proveedor o cliente.
    @return nil
    /*/  

Static Function NewSFH(cAgente,cCOD,cTipo,cLoja,cPercIBI,cAPERIB,cZonaFis,cImpost,nAliq,nPercent,nCoefMul,cIsento,cSituaca,cTable,cNome)
Local cCodSA2 := " "
Local cCodSA1 := " "
	DEFAULT cAgente := ""
	DEFAULT cCOD    := ""
	DEFAULT cTipo   := ""
	DEFAULT cLoja   := ""
	DEFAULT cPercIBI := ""
	DEFAULT cAPERIB  := ""
	DEFAULT cZonaFis := ""
	DEFAULT cImpost  := ""
	DEFAULT nAliq    := 0
	DEFAULT nPercent := 0
	DEFAULT nCoefMul := 0
	DEFAULT cIsento	 := ""
	Default cSituaca :=""
	DEFAULT cTable   := ""
	DEFAULT cNome    := ""

	If cTable == "SA2"
		cCodSA2 := cCOD
	Else
		cCodSA1 := cCOD
	EndIf
	cNome := PadR(cNome, nTamNome)

	oBulkSFH:addData({xFilial("SFH"),cAgente,cZonaFis,cCodSA2,cCodSA1,cLoja,cNome,cImpost,cPercIBI,cIsento,cAPERIB,nAliq,nPercent,cTipo,dDataIni,dDataFim,nCoefMul,cSituaca})

Return Nil

/*/{Protheus.doc} MayorFech
    Función para realizar la busqueda del registro en la tabla SFH de mayor fecha fin vigencia.
    @type  Function
    @author adrian.perez
    @since 11/02/2026
    @param  cCod     , character, codigo del proveedor o cliente.
    @param  cLoja    , character, indica la surcursal.
	@param  cImpuesto, character, indica el impuesto.
	@param  lForCli   , logical  , indica si la busqueda es para proveedor o cliente.
    @return nAux      ,numeric  , retorna el recno del registro de mayor fecha fin vigencia.
    /*/  

Static Function MayorFech(cCod,cLoja,cImpuesto,cProv,lForCli)

	Local cQuery    := ""
	Local nParam	:=1
	Local nAux		:=0
	DEFAULT cCod      := ""
	DEFAULT cLoja     := ""
	DEFAULT cImpuesto := ""
	DEFAULT cProv	  := ""
	DEFAULT lForCli   := .F.

	IF cCod!="".AND. cLoja!="" .AND. cImpuesto!="" .AND. cProv !=""
		IF oQryExFech==NIL
			cQuery := ""
			cQuery := "SELECT  FH_FIMVIGE AS FECHA,R_E_C_N_O_ AS NUM,FH_INIVIGE AS INI"
			cQuery += " FROM                     "+ RetSqlName("SFH")+ " SFH"
			cQuery += "  WHERE FH_FILIAL       = ? "
			If lForCli
				cQuery += "    AND FH_CLIENTE  = ? "
			Else
				cQuery += "    AND FH_FORNECE  = ? "
			EndIf
			cQuery += "    AND FH_LOJA         = ? "
			cQuery += "    AND FH_IMPOSTO      = ? "
			cQuery += "    AND FH_ZONFIS       = ? "
			cQuery += "    AND D_E_L_E_T_      = ? "

			cQuery += " ORDER BY "//FH_FIMVIGE DESC, FH_INIVIGE DESC"
			cQuery += " CASE "
			cQuery += " When FH_FIMVIGE = '' THEN '99999999' "
			cQuery += " Else FH_FIMVIGE "
			cQuery += " End DESC, "
			cQuery += " FH_INIVIGE DESC "

			cQuery := ChangeQuery(cQuery)
			oQryExFech := FwExecStatement():New(cQuery)
		EndIf

		
		oQryExFech:SetString(nParam++, xFilial("SFH"))
		oQryExFech:SetString(nParam++, cCod)
		oQryExFech:SetString(nParam++, cLoja)
		oQryExFech:SetString(nParam++, cImpuesto)
		oQryExFech:SetString(nParam++, cProv)
		oQryExFech:SetString(nParam++, Space(1))
		nAux:=oQryExFech:ExecScalar('NUM') 

 	EndIF
Return nAux

/*/{Protheus.doc} fProvPer
    Función para realizar la busqueda, verificaciones y actualizacion de los registros en la tabla SFH para proveedores.
    @type  Function
    @author adrian.perez
    @since 12/02/2026
    @param  lPadron , logical  , indica si el CUIT de la empresa protheus existe en el archivo TXT de importación.
    @param  nAliq, numeric, valor de la alicuota
    @return nil
    /*/  

Static Function fProvPer(lPadron,nAliq)
	Local lSfhPadr	:= .F.
	Local lGenera := .F.
	Local nRecFim := 0
    Local cIsento:=""

	DEFAULT lPadron := .F.
	DEFAULT nAliq := 0

	If lFor .and. lPer
		
		
		Do While (cSA2)->(!EOF())
			IncProc(STR0018)  //"Procesando archivo..."
			nRecFim := MayorFech((cSA2)->A2_COD,(cSA2)->A2_LOJA,_IMP,_PROV,.F.)

			IF nRecFim>0
				SFH->(DbGoTo(nRecFim))
				IF !lPadron
					If SFH->FH_FIMVIGE > dDataIni .Or. Empty(SFH->FH_FIMVIGE)
							RecLock("SFH", .F.)
							SFH->FH_FIMVIGE := dDataIni
							SFH->(MsUnlock())
					EndIf
					
				else
					lSfhPadr := .T.
				EndIF
			Endif

			If lPadron
				If nAliq==0
					cIsento:="S"
				EndIF
				
				If lSfhPadr
					If nAliq <> SFH->FH_ALIQ
						lGenera  := .T.
					EndIf
					If !lGenera
						RecLock("SFH", .F.)
						SFH->FH_FIMVIGE := dDataFim
						SFH->(MsUnlock())
					Else
						RecLock("SFH", .F.)
						SFH->FH_FIMVIGE := DaySub(dDataIni,1)
						SFH->(MsUnlock())
						NewSFH(SFH->FH_AGENTE,SFH->FH_FORNECE,SFH->FH_TIPO,SFH->FH_LOJA,SFH->FH_PERCIBI,SFH->FH_APERIB,SFH->FH_ZONFIS,SFH->FH_IMPOSTO,nAliq,SFH->FH_PERCENT,SFH->FH_COEFMUL,cIsento,SFH->FH_SITUACA,"SA2",(cSA2)->A2_NOME)
					EndIf
				EndIf
				lGenera     := .F.
				lSfhPadr 		:= .F.
				
				
			EndIf // fin cuit empresa
			(cSA2)->(dbSkip())
		EndDo
		lGenera     := .F.
		lSfhPadr 	:= .F.
		lImp := .T.
	EndIf // fin prove

Return Nil


/*/{Protheus.doc} fProvRet
    Función para realizar la busqueda, verificaciones y actualizacion de los registros en la tabla SFH para proveedores.
    @type  Function
    @author adrian.perez
    @since 13/02/2026
    @param  lPadron , logical  , indica si el CUIT de la empresa protheus existe en el archivo TXT de importación.
    @param  nAliq, numeric, valor de la alicuota
    @return nil
    /*/  

Static Function fProvRet(lPadron,nAliq)

Local lSfhPadr := .F.
Local lGenera 	:= .F.
Local nRecFim 	:= 0
Local cIsento	:="N"
Local nPercent	:=0
Local cPERCIBI	:="S"
Local cAPERIB	:="S"

	DEFAULT lPadron := .F.
	DEFAULT nAliq := 0

	If lFor .and. lReten
		If nAliq==0
		  cIsento:="S"
		  nPercent:=100
	      cPERCIBI:="N"
	      cAPERIB:="N"
		EndIF
		nRecFim :=  MayorFech((cSA2)->A2_COD,(cSA2)->A2_LOJA,_IMPRet,_PROV,.F.)
		IF nRecFim>0
			SFH->(DbGoTo(nRecFim))
			
			IF !lPadron
				If SFH->FH_FIMVIGE > dDataIni .Or. Empty(SFH->FH_FIMVIGE)
						RecLock("SFH", .F.)
						SFH->FH_FIMVIGE := dDataIni
						SFH->(MsUnlock())
				EndIf
			else
				lSfhPadr := .T.
			EndIF
		Endif
		If lPadron
			
			If lSfhPadr
				If nAliq <> SFH->FH_ALIQ
					lGenera  := .T.
				EndIf
				If !lGenera
					RecLock("SFH", .F.)
					SFH->FH_FIMVIGE := dDataFim
					SFH->(MsUnlock())
				Else
					RecLock("SFH", .F.)
					SFH->FH_FIMVIGE := DaySub(dDataIni,1)
					SFH->(MsUnlock())
					
					NewSFH(SFH->FH_AGENTE,SFH->FH_FORNECE,SFH->FH_TIPO,SFH->FH_LOJA,SFH->FH_PERCIBI,SFH->FH_APERIB,SFH->FH_ZONFIS,SFH->FH_IMPOSTO,nAliq,SFH->FH_PERCENT,SFH->FH_COEFMUL,cIsento,SFH->FH_SITUACA,"SA2",(cSA2)->A2_NOME)
				EndIf
			Else// no esta en SFH
				NewSFH("S",(cSA2)->A2_COD,"I",(cSA2)->A2_LOJA,cPERCIBI,cAPERIB,_PROV,_IMPRet,nAliq,nPercent,0,cIsento,"1","SA2",(cSA2)->A2_NOME) 
			EndIf
			
		EndIf // fin Padron
		lGenera  := .F.
		lSfhPadr := .F.
		lImp := .T.
	EndIf 

Return Nil

/*/{Protheus.doc} ValidChk
    Función para validar si se habilita la retención o no 
    @type  Function
    @author adrian.perez
    @since 18/02/2026
    @param  cCombo,   character, opcion seleccionada del combo "1- Proveedor","2- Cliente" o "3- Ambos  "
    @return lAux ,	logical, indica si debe habilitar o no el check de la retención
    /*/  

Static function ValidChk(cCombo)
Local lAux := .T.

If  (lReten == .T. .OR. lPer == .T. ) .and. (Subs(cCombo,1,1) $ "2" )
	lReten :=.F.
	lAux:=.F.
EndIf

oChk1:Refresh()
oChk2:Refresh()

Return lAux

/*/{Protheus.doc} F845LeePad
    Función para realizar la geracion de la tabla temporal del padron con todos los datos del archivo TXT de importación.
	Función intermedida para poder realizar el uso de la función Processa y mostrar correctamente el avance.
    @type  Function
    @author raul.medina
    @since 10/04/2026
    @param  cArqProc,	character, archivo a ser importado
    @return lArqValido,		 logical, 	retorna .T. si la importación no tuvo errores.
    /*/  
Static Function F845LeePad(cArqProc)
Local lArqValido	:= .F.	
Local lAutomato 	:= IsBlind()

Default cArqProc := ""

	If File(cArqProc)
		If !lAutomato
			Processa({|| lArqValido := CreaTabla(cArqProc)})
		Else
			lArqValido := CreaTabla(cArqProc)
		EndIf
	EndIf

Return lArqValido

/*/{Protheus.doc} F845TotReg
    Función para obtener el total de registros a ser procesados en la importación, para poder mostrar el avance correcto en la barra de progreso.
    @type  Function
    @author raul.medina
    @since 09/04/2026
    @param  
	lCli, logical, indica si se debe contabilizar los clientes.
	lFor, logical, indica si se debe contabilizar los proveedores.
	lPer, logical, indica si se debe contabilizar los impuestos de percepción.
	lReten, logical, indica si se debe contabilizar los impuestos de retención.
    @return 
	nTotal, numeric, total de registros a ser procesados en la importación.
    /*/  
Static Function F845TotReg(lCli, lFor, lPer, lReten)
Local nTotal	 := 0
Local nReg 		 := 0
Local cQuery	 := ""
Local nParamA1   := 1
Local nParamA2   := 1
Local oQryExec	 := Nil

Default lCli 	:= .F.
Default lFor 	:= .F.
Default lPer 	:= .F.
Default lReten	:= .F.

	If lCli .and. lPer
		cQuery := ""
		cQuery := "SELECT COUNT(*) TOTAL"
		cQuery += "FROM                         "+RetSqlName("SA1")+" A1 "
		cQuery += " WHERE A1.A1_FILIAL        = ?    "
		cQuery += "   AND A1.A1_CGC          <> ?    "
		cQuery += "   AND A1.D_E_L_E_T_       = ?    "
		cQuery := ChangeQuery(cQuery)
		oQryExec := FwExecStatement():New(cQuery)
		oQryExec:SetString(nParamA1++, xFilial("SA1"))
		oQryExec:SetString(nParamA1++, ' ')
		oQryExec:SetString(nParamA1++, ' ')
		nReg := oQryExec:ExecScalar('TOTAL')
		oQryExec:Destroy()
		oQryExec := nil 
		nTotal += nReg
	EndIf


	If lFor .and. (lPer .or. lReten)
		cQuery := ""
		cQuery := "SELECT COUNT(*) TOTAL"
		cQuery += "FROM                           "+RetSqlName("SA2")+" A2 "
		cQuery += " WHERE A2.A2_FILIAL          = ?    "
		cQuery += "   AND A2.A2_CGC            <> ?    "
		cQuery += "   AND A2.D_E_L_E_T_         = ?    "
		cQuery := ChangeQuery(cQuery)
		oQryExec := FwExecStatement():New(cQuery)
		oQryExec:SetString(nParamA2++, xFilial("SA2"))
		oQryExec:SetString(nParamA2++, ' ')
		oQryExec:SetString(nParamA2++, ' ')
		nReg := oQryExec:ExecScalar('TOTAL')
		oQryExec:Destroy()
		oQryExec := nil 
		nTotal += nReg
		If lPer .and. lReten
			nTotal += nReg
		EndIf
	EndIf

Return nTotal
