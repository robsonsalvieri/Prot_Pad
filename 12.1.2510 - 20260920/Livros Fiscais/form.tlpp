
#Include 'Totvs.ch'
#Include 'Protheus.ch'
#Include 'FWMVCDef.ch'


// Esta função você consegue chamar pelo SmartClient (U_TESTAIMPORT)
User Function TESTAIMPORT()
	// Se a função precisa de ambiente (empresa/filial), garanta que está logado
	RpcSetType(3)
	RpcSetEnv("T1", "XIFIS26") // Ajuste para sua Empresa/Filial de teste

	ConOut("Iniciando teste da LoadFileWizardImportTrib...")

	// Chama a sua função estática
	tribunt()

	ConOut("Teste finalizado.")
Return




Static Function tribunt()
	Local oModel    := nil as Object
	Local oFile     := nil as Object
	Local cXml      := "C:\P2410\teste1.xml"
	Local cConteudo := "" as Character
	local cXmlEsperado := "" as Character
    local lok


	oFile := FWFileReader():New(cXml)
	if oFile:Open()
		cConteudo := oFile:FullRead()
		oFile:Close()
	else
		FwAlertError("Não foi possível abrir o arquivo: " + cXml, "Erro de Arquivo")
		Return
	Endif

	// Verifica se o conteúdo foi carregado
	if Empty(cConteudo)
		FwAlertError("O conteúdo do arquivo XML está vazio.", "Erro de Leitura")
		Return
	endif

	oModel := FwLoadModel("FISA164")
	oModel:SetOperation(MODEL_OPERATION_INSERT)

	cXmlEsperado := oModel:GetXMLData(.F., MODEL_OPERATION_INSERT, .F., .F., .F., .F., .T.)
	MemoWrite("C:\P2410\Protheus\layout_correto.xml", cXmlEsperado)

	if oModel:Activate()

		oModel:LoadXMLData(cConteudo, .T.) //indica se o modelo foi carregado com sucesso

			If oModel:VldData() .And. oModel:CommitData()
               lOk := .T.
            Else
               lOk := .F.
               aError := oModel:GetErrorMessage()
               SetSoapFault(aError[MODEL_MSGERR_IDFORM]+":"+;
                           aError[MODEL_MSGERR_IDFIELD]+":"+;
                           aError[MODEL_MSGERR_IDFORMERR]+":"+;
                           aError[MODEL_MSGERR_IDFIELDERR]+":"+;
                           aError[MODEL_MSGERR_ID],;
                           aError[MODEL_MSGERR_MESSAGE]+"/"+aError[MODEL_MSGERR_SOLUCTION])
               lRetorno := .F.
            EndIf
    EndIf    

Return
