#INCLUDE "tlpp-core.th"
#INCLUDE "tlpp-rest.th"
#INCLUDE "totvs.ch"
#INCLUDE "FISA318.CH"

/*/{Protheus.doc} TITVisionMunicipalTaxes
    Endpoint REST para processar a requisição da API de Tributos Municipais.
    @type  Function
    @author Caique Carlos
    @since 03/12/2025
    @version 1.0
    @param branches, character, Código das filiais separadas por vírgula (via query parameter)
    @param periodStart, character, Data inicial do período no formato YYYY-MM-DD (via query parameter)
    @param periodEnd, character, Data final do período no formato YYYY-MM-DD (via query parameter)
    @param page, character, Número da página para paginação (opcional, via query parameter)
    @param pageSize, character, Quantidade de registros por página (opcional, via query parameter)
    @return Nil, nulo, Resposta enviada via framework oRest
    @example
        GET /api/fiscal/tax-monitor/v1/financial/municipal/tributes-by-municipality?branches=D MG 01,D RJ 02&periodStart=2024-01-01&periodEnd=2024-12-31&page=1&pageSize=10
/*/
@get(endpoint='/api/fiscal/tax-monitor/v1/financial/municipal/tributes-by-municipality', description='API Visão de Tributos Municipais')
Function TITVisionMunicipalTaxes()
    Local oJsResponse := JsonObject():new()      as json
    Local oQryStr     := oRest:getQueryRequest() as json
    Local aRequiredProperties                    as array

    aRequiredProperties	:= {;
        {'branches',400,;   //PROPERTY //ERROR_CODE
        STR0069,;           //"O parâmetro 'branches' é obrigatório e não foi informado."
        STR0070},;          //"Informar Código de Filiais separadas por vírgula."
        {'periodStart',400,;
        STR0071,;           //"Nenhuma Data foi informada no parâmetro 'periodStart'."
        STR0072},;          //"Informar a data desejada para o período"
        {'periodEnd',400,;
        STR0073,;           //"Nenhuma Data foi informada no parâmetro 'periodEnd'."
        STR0072};           //"Informar a data desejada para o período"
    }

    If FISA318F6HasApiRequiredProperties(aRequiredProperties, oQryStr, @oJsResponse) 
        oJsResponse := GetVisionMunicipalTaxes(oQryStr['branches'], oQryStr['periodStart'], oQryStr['periodEnd'], oQryStr['page'], oQryStr['pageSize'])   
    EndIf  

    oRest:setKeyHeaderResponse('Content-Type', 'application/json')
    oRest:setResponse(oJsResponse)

    FwFreeArray(aRequiredProperties) 
    FWFreeObj(oJsResponse)
    FWFreeObj(oQryStr)
Return 

/*/{Protheus.doc} GetVisionMunicipalTaxes
    Função para obter os dados de tributos municipais com agrupamento e paginação.
    @type  Function
    @author Caique Carlos
    @since 03/12/2025
    @version 1.0
    @param cBranches, character, Código das filiais separadas por vírgula
    @param cPeriodStart, character, Data inicial do período no formato YYYY-MM-DD
    @param cPeriodEnd, character, Data final do período no formato YYYY-MM-DD
    @param cPage, character, Número da página para paginação (opcional, default "1")
    @param cPageSize, character, Quantidade de registros por página (opcional, default "10")
    @return cJsonResponse, character, Dados processados em formato JSON string
    @example
        Local cJson := GetVisionMunicipalTaxes("D MG 01,D RJ 02", "2024-01-01", "2024-12-31", "1", "10")
    @see
/*/
Function GetVisionMunicipalTaxes(cBranches as character, cPeriodStart as character, cPeriodEnd as character, cPage as character, cPageSize as character)
    Local oJsonResp   := JsonObject():New() as json
    Local oIndexMap   := JsonObject():New() as json
    Local cAlias      := GetNextAlias()     as character
    Local cAlias2     := GetNextAlias()     as character
    Local cUniqueKey  := ""                 as character
    Local cMonthYear  := ""                 as character
    Local nPage       := 0                  as numeric
    Local nPageSize   := 0                  as numeric
    Local nItemPos    := 1                  as numeric
    Local nNewPos     := 0                  as numeric
    Local nDetailPos  := 0                  as numeric
    Local nPageAux    := 0                  as numeric
    Local aJsonDetail := {}                 as array

    Default cPage     := '1'
    Default cPageSize := '10'

    nPage     := Val(cPage)
    nPageSize := Val(cPageSize)

    GetResumeVisionMunicipalTaxes(@cAlias, cBranches, cPeriodStart, cPeriodEnd, nPage, nPageSize)

    If (cAlias)->(!EoF())
        oJsonResp["items"]   := {}

        While (cAlias)->(!Eof()) .And. nPageAux < nPageSize
            cUniqueKey :=   AllTrim((cAlias)->FILIAL)  + "|" + SubStr((cAlias)->DATA_EMISSAO,5,2) + SubStr((cAlias)->DATA_EMISSAO,1,4) + "|" + ;
                            AllTrim((cAlias)->TRIBUTO) + "|" + AllTrim((cAlias)->PREFEITURA)

            If oIndexMap:HasProperty(cUniqueKey)
                nItemPos := oIndexMap[cUniqueKey]

                oJsonResp["items"][nItemPos]["totalRetained"] += (cAlias)->RETIDO
                oJsonResp["items"][nItemPos]["amountPaid"]    += (cAlias)->VALOR_PAGO  
                oJsonResp["items"][nItemPos]["amountPayable"] += (cAlias)->VALOR_PAGAR
            Else
                aAdd( oJsonResp["items"], JsonObject():New() )

                cMonthYear            := SubStr((cAlias)->DATA_EMISSAO,5,2) + "/" + SubStr((cAlias)->DATA_EMISSAO,1,4) // MM/YYYY
                nNewPos               := Len(oJsonResp["items"])
                oIndexMap[cUniqueKey] := nNewPos
                
                oJsonResp["items"][nNewPos]["branch"]        := AllTrim((cAlias)->FILIAL)
                oJsonResp["items"][nNewPos]["monthYear"]     := cMonthYear
                oJsonResp["items"][nNewPos]["tribute"]       := AllTrim((cAlias)->TRIBUTO)
                oJsonResp["items"][nNewPos]["cityHall"]      := AllTrim((cAlias)->PREFEITURA)
                oJsonResp["items"][nNewPos]["totalRetained"] := (cAlias)->RETIDO
                oJsonResp["items"][nNewPos]["amountPaid"]    := (cAlias)->VALOR_PAGO
                oJsonResp["items"][nNewPos]["amountPayable"] := (cAlias)->VALOR_PAGAR

                GetDetailVisionMunicipalTaxes(@cAlias2, AllTrim((cAlias)->FILIAL), cPeriodStart, cPeriodEnd, AllTrim((cAlias)->TRIBUTO), AllTrim((cAlias)->PREFEITURA), (cAlias)->DATA_EMISSAO)

                aJsonDetail := {}
                If (cAlias2)->(!Eof())
                    While (cAlias2)->(!EoF())
                        AAdd(aJsonDetail, JsonObject():New())
                        nDetailPos := Len(aJsonDetail)

                        aJsonDetail[nDetailPos]["documentNumber"] := AllTrim((cAlias2)->TITULO)
                        aJsonDetail[nDetailPos]["installment"]    := AllTrim((cAlias2)->PARCELA)
                        aJsonDetail[nDetailPos]["documentType"]   := AllTrim((cAlias2)->TIPO)
                        aJsonDetail[nDetailPos]["prefix"]         := AllTrim((cAlias2)->PREFIXO)
                        aJsonDetail[nDetailPos]["issueDate"]      := SubStr((cAlias2)->EMISSAO,1,4) + "-" + SubStr((cAlias2)->EMISSAO,5,2) + "-" + SubStr((cAlias2)->EMISSAO,7,2)
                        aJsonDetail[nDetailPos]["dueDate"]        := SubStr((cAlias2)->VENCIMENTO,1,4) + "-" + SubStr((cAlias2)->VENCIMENTO,5,2) + "-" + SubStr((cAlias2)->VENCIMENTO,7,2)
                        aJsonDetail[nDetailPos]["totalValue"]     := (cAlias2)->VAL_TOTAL
                        aJsonDetail[nDetailPos]["balance"]        := (cAlias2)->SALDO
                        aJsonDetail[nDetailPos]["participant"]    := AllTrim((cAlias2)->PARTICIPANTE)
                        aJsonDetail[nDetailPos]["store"]          := AllTrim((cAlias2)->LOJA)

                        (cAlias2)->(DbSkip())
                    EndDo

                    oJsonResp["items"][nNewPos]["detail"] := aClone(aJsonDetail)
                    aSize(aJsonDetail, 0)
                EndIf
            EndIf

            nPageAux++
            (cAlias)->(DbSkip())

        EndDo
        (cAlias2)->(DbCloseArea())
        oJsonResp["hasNext"] := !(cAlias)->(Eof())
    Else
        oJsonResp["items"]   := {}
        oJsonResp["hasNext"] := .F.
    EndIf

    (cAlias)->(DbCloseArea())
    FWFreeObj(oIndexMap)
    FwFreeArray(aJsonDetail)
Return oJsonResp:toJson()

/*/{Protheus.doc} GetResumeVisionMunicipalTaxes
    Função para obter o resultado sintético da consulta de tributos municipais com paginação.
    @type  Static Function
    @author Caique Carlos
    @since 03/12/2025
    @version 1.0
    @param cAlias, character, Alias do cursor para manipulação dos dados retornados
    @param cBranches, character, Código das filiais separadas por vírgula
    @param cPeriodStart, character, Data inicial do período no formato YYYY-MM-DD
    @param cPeriodEnd, character, Data final do período no formato YYYY-MM-DD
    @param nPage, numeric, Número da página para paginação dos resultados
    @param nPageSize, numeric, Quantidade de registros por página
    @return Nil, nulo, Dados retornados via alias temporário
    @example
        GetResumeVisionMunicipalTaxes(@cAlias, "D MG 01,D RJ 02", "2024-01-01", "2024-12-31", 1, 10)
    @see
/*/
Static Function GetResumeVisionMunicipalTaxes(cAlias as character, cBranches as character, cPeriodStart as character, cPeriodEnd as character, nPage as numeric, nPageSize as numeric)
    Local oQryResume := FWExecStatement():New() as object
    Local nBind      := 1                       as numeric
    Local cQuery     := ""                      as character

    cQuery += "SELECT "
    cQuery +=   "CIW_FILIAL AS FILIAL, "
    cQuery +=   "CIW_EMISSA AS DATA_EMISSAO, "
    cQuery +=   "SUM(CIW_VALOR) AS RETIDO, "
    cQuery +=   "SUM(CIW_SALDO) AS VALOR_PAGAR, "
    cQuery +=   "SUM((CIW_VALOR - CIW_SALDO)) AS VALOR_PAGO, "
    cQuery +=   "CIW_ESTADO AS PREFEITURA, "
    cQuery +=   "CIW_NATURE AS TRIBUTO "
    cQuery += "FROM ? CIW "
    cQuery += " WHERE CIW_FILIAL IN (?) "                        // Filiais (D MG 01,D RJ 02)
    cQuery +=    "AND CIW_ESFERA = ? "                           // 3 (MUNICIPAL)
    cQuery +=    "AND CIW_EMISSA BETWEEN ? AND ? "               // Período (20240101 a 20241231)
    cQuery +=    "AND D_E_L_E_T_ = ? "                           // Registro ativo
    cQuery += "GROUP BY CIW_FILIAL, CIW_EMISSA, CIW_ESTADO, CIW_NATURE "
    cQuery += "ORDER BY CIW_FILIAL, CIW_EMISSA "
    cQuery += "OFFSET ( ? * ? ) ROWS "                           // ( 1 - 1 ) * 10
    cQuery += "FETCH NEXT ? ROWS ONLY "                          // 10 + 1   

    oQryResume:SetQuery(ChangeQuery(cQuery))

    oQryResume:SetUnsafe(nBind++, FIS319SqlName("CIW"))
    oQryResume:SetIn(nBind++, StrTokArr(cBranches, "," ))
    oQryResume:SetString(nBind++, "3")
    oQryResume:SetString(nBind++, StrTran(cPeriodStart, "-", ""))
    oQryResume:SetString(nBind++, StrTran(cPeriodEnd, "-", ""))
    oQryResume:SetString(nBind++, " ")
    oQryResume:setNumeric(nBind++, nPage - 1)
    oQryResume:setNumeric(nBind++, nPageSize)
    oQryResume:setNumeric(nBind++, nPageSize + 1)

    oQryResume:cBaseQuery := oQryResume:GetFixQuery()
    cAlias := oQryResume:OpenAlias()

    FwFreeObj(oQryResume)
Return

/*/{Protheus.doc} GetDetailVisionMunicipalTaxes
    Função para obter os detalhes de tributos municipais por filial, prefeitura e período específico.
    @type  Static Function
    @author Caique Carlos
    @since 03/12/2025
    @version 1.0
    @param cAlias2, character, Alias do cursor para os dados de detalhe
    @param cBranch, character, Código da filial específica
    @param cPeriodStart, character, Data inicial do período no formato YYYY-MM-DD
    @param cPeriodEnd, character, Data final do período no formato YYYY-MM-DD
    @param cTribute, character, Código do tributo (PIS, COFINS, ISS, etc)
    @param cCityHall, character, Código da prefeitura/estado
    @param cEmissao, character, Data de emissão base para filtro mensal no formato YYYYMMDD
    @return Nil, nulo, Dados retornados via alias temporário
    @example
        GetDetailVisionMunicipalTaxes(@cAlias2, "D MG 01", "2024-01-01", "2024-12-31", "PIS", "MG", "20240115")
    @see
/*/
Static Function GetDetailVisionMunicipalTaxes(cAlias2 as character, cBranch as character, cPeriodStart as character, cPeriodEnd as character, cTribute as character, cCityHall as character, cEmissao as character)
    Local oQryDetail := FWExecStatement():New() as object
    Local nBind      := 1                       as numeric
    Local cQuery     := ""                      as character

    cQuery += "SELECT "
    cQuery +=   "CIW_NUMERO TITULO, "
    cQuery +=   "CIW_PARCEL PARCELA, "
    cQuery +=   "CIW_TIPO TIPO, "
    cQuery +=   "CIW_PREFIX PREFIXO, "
    cQuery +=   "CIW_EMISSA EMISSAO, "
    cQuery +=   "CIW_VENCTO VENCIMENTO, "
    cQuery +=   "CIW_VALOR VAL_TOTAL, "
    cQuery +=   "CIW_SALDO SALDO, "
    cQuery +=   "CIW_PARTIC PARTICIPANTE, "
    cQuery +=   "CIW_LOJA LOJA "
    cQuery += "FROM ? CIW "
    cQuery += "WHERE CIW_FILIAL = ? "                                            // Filial (D MG 01)   
    cQuery +=   "AND CIW_ESFERA = ? "                                            // 3 (MUNICIPAL)
    cQuery +=   "AND CIW_EMISSA BETWEEN ? AND ? "                                // Período (20240101 a 20241231)
    cQuery +=   "AND CIW_NATURE = ? "                                            // Tributo (PIS)
    cQuery +=   "AND CIW_ESTADO = ? "                                            // Prefeitura (MG)
    cQuery +=   "AND CIW_EMISSA >= ? "                                           // 20240101
    cQuery +=   "AND CIW_EMISSA <= ? "                                           // 20240131
    cQuery +=   "AND CIW.D_E_L_E_T_ = ? "
    cQuery += "ORDER BY CIW_EMISSA"

    oQryDetail:SetQuery(ChangeQuery(cQuery))

    oQryDetail:SetUnsafe(nBind++, FIS319SqlName("CIW"))
    oQryDetail:SetString(nBind++, cBranch)
    oQryDetail:SetString(nBind++, "3")
    oQryDetail:SetString(nBind++, StrTran(cPeriodStart, "-", ""))                       // Filtro da API (Respeita o filtro do usuario caso deseje um especiffico)
    oQryDetail:SetString(nBind++, StrTran(cPeriodEnd, "-", ""))                         // Filtro da API
    oQryDetail:SetString(nBind++, cTribute)
    oQryDetail:SetString(nBind++, cCityHall)
    oQryDetail:SetString(nBind++, SubStr(cEmissao,1,4) + SubStr(cEmissao,5,2) + "01")   // Data baseada na emissão do titulo (Garante que só retorne as ocorrência deste mês)
    oQryDetail:SetString(nBind++, SubStr(cEmissao,1,4) + SubStr(cEmissao,5,2) + "31")   // Data baseada na emissão do titulo
    oQryDetail:SetString(nBind++, " ")

    oQryDetail:cBaseQuery := oQryDetail:GetFixQuery()
    cAlias2 := oQryDetail:OpenAlias()

    FwFreeObj(oQryDetail)
Return
