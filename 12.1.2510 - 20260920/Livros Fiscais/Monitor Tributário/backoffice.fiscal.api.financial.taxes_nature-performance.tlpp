#INCLUDE "tlpp-core.th"
#INCLUDE "tlpp-rest.th"
#INCLUDE "totvs.ch"
#INCLUDE "FISA318.CH"

/*/{Protheus.doc} TITFinancialTaxesNaturePerformance
    Endpoint REST para processar a requisição da API de Visão de tributos x Nartureza de rendimentos.
    @type  Function
    @author Caique Carlos
    @since 03/12/2025
    @version 1.0
    @param jurisdiction, character, Esfera de governo (state, federal, municipal) (via path parameter)
    @param branches, character, Código das filiais separadas por vírgula (via query parameter)
    @param periodStart, character, Data inicial do período no formato YYYY-MM-DD (via query parameter)
    @param periodEnd, character, Data final do período no formato YYYY-MM-DD (via query parameter)
    @param page, character, Número da página para paginação (opcional, via query parameter)
    @param pageSize, character, Quantidade de registros por página (opcional, via query parameter)
    @return Nil, nulo, Resposta enviada via framework oRest
    @example
        GET /api/fiscal/tax-monitor/v1/financial/:jurisdiction/nature-performance?branches=D MG 01,D RJ 02&periodStart=2024-01-01&periodEnd=2024-12-31&page=1&pageSize=10
/*/
@get(endpoint='/api/fiscal/tax-monitor/v1/financial/:jurisdiction/nature-performance', description='API Financeira - Visão de Tributos x Natureza de Rendimentos')
Function TITFinancialTaxesNaturePerformance()
    Local oJsResponse := JsonObject():new()                as json
    Local oQryStr     := oRest:getQueryRequest()           as json
    Local aRequiredProperties                              as array
    Local jPath                                            as json
    Local aPathParams := {"state","federal","municipal"}  as array

    jPath := oRest:getPathParamsRequest()

    If  (jPath:HasProperty('jurisdiction')  .and. (aScan(aPathParams, Lower(jPath["jurisdiction"])) > 0)) 

        aRequiredProperties	:= {;
            {'branches',400,;   //PROPERTY //ERROR_CODE
            STR0069,;           //"O parâmetro 'branches' é obrigatório e não foi informado."
            STR0070},;          //"Informar Código de Filiais separadas por vírgula."
            {'periodStart',400,;
            STR0071,;           //"Nenhuma Data foi informada no parâmetro 'periodStart'."
            STR0072},;          //"Informar a data desejada para o período"
            {'periodEnd',400,;
            STR0073,;           //"Nenhuma Data foi informada no parâmetro 'periodEnd'."
            STR0072};           //"Informar a data desejada para o período"
        }

        If FISA318F6HasApiRequiredProperties(aRequiredProperties, oQryStr, @oJsResponse) 
            oJsResponse := GetJsonFinancialTaxesNaturePerformance(;
                                                    oQryStr['branches'], oQryStr['periodStart'], oQryStr['periodEnd'],;
                                                    Lower(jPath["jurisdiction"]), oQryStr['page'], oQryStr['pageSize'];
                                                    )  
        EndIf

        oRest:setKeyHeaderResponse('Content-Type', 'application/json')
        oRest:setResponse(oJsResponse)
    EndIf

    FwFreeArray(aRequiredProperties)
    FWFreeObj(jPath)
    FWFreeObj(oJsResponse)
    FWFreeObj(oQryStr)
Return

/*/{Protheus.doc} GetJsonFinancialTaxesNaturePerformance
    Função para obter os dados de tributos x natureza de rendimentos e montar json de resposta.
    @type  Function
    @author Caique Carlos
    @since 08/01/2026
    @version 1.0
    @param cBranches, character, Código das filiais separadas por vírgula
    @param cPeriodStart, character, Data inicial do período no formato YYYY-MM-DD
    @param cPeriodEnd, character, Data final do período no formato YYYY-MM-DD
    @param cJurisdiction, character, Esfera de governo (state, federal, municipal)
    @param cPage, character, Número da página para paginação
    @param cPageSize, character, Quantidade de registros por página
    @return cJsonResponse, character, Dados processados em formato JSON string
    @example
        GetJsonFinancialTaxesNaturePerformance("D MG 01,D RJ 02", "2024-01-01", "2024-12-31", "federal", "1", "10")
/*/
Function GetJsonFinancialTaxesNaturePerformance(cBranches as character, cPeriodStart as character, cPeriodEnd as character, cJurisdiction as character,cPage as character, cPageSize as character) as json
    Local oJsResult   := JsonObject():New() as json
    Local oIndexMap   := JsonObject():New() as json
    Local oDetail     := Nil
    Local cAlias      := GetNextAlias()     as character
    Local cUniqueKey  := ""                 as character
    Local nPage       := 0                  as numeric
    Local nPageSize   := 0                  as numeric
    Local nPageAux    := 0                  as numeric
    Local nItemPos    := 0                  as numeric

    Default cPage         := "1"
    Default cPageSize     := "10"
    Default cJurisdiction := "federal"

    nPage     := Val(cPage)
    nPageSize := Val(cPageSize)

    GetTaxesValues(@cAlias, cBranches, cPeriodStart, cPeriodEnd, nPage, nPageSize, MapJurisdiction(cJurisdiction))

    If (cAlias)->(!EoF())
        oJsResult["items"] := {}

        While (cAlias)->(!Eof()) .and. nPageAux < nPageSize
            cMonthYear := SubStr((cAlias)->EMISSAO,5,2) + "/" + SubStr((cAlias)->EMISSAO,1,4)

            cUniqueKey := CustomKeyGroup(cAlias, cMonthYear)

            If oIndexMap:HasProperty(cUniqueKey)
                nItemPos := oIndexMap[cUniqueKey]

                oJsResult["items"][nItemPos]["withheldTotal"] += (cAlias)->VALOR_TITULO
                oJsResult["items"][nItemPos]["valuePaid"]     += (cAlias)->VALOR_PAGO
                oJsResult["items"][nItemPos]["valueToPay"]    += (cAlias)->VALOR_PAGAR

                oDetail := DoDetailedJsonResponse(cAlias, cMonthYear)
                AAdd(oJsResult["items"][nItemPos]["detail"], oDetail)

            Else
                aAdd( oJsResult["items"], JsonObject():New() )

                nNewPos               := Len(oJsResult["items"])
                oIndexMap[cUniqueKey] := nNewPos

                oJsResult["items"][nNewPos]["branch"]        := AllTrim((cAlias)->FILIAL)
                oJsResult["items"][nNewPos]["monthYear"]     := cMonthYear
                oJsResult["items"][nNewPos]["tax"]           := AllTrim((cAlias)->TRIBUTO)
                oJsResult["items"][nNewPos]["nature"]        := AllTrim((cAlias)->NATUREZA)
                oJsResult["items"][nNewPos]["description"]   := AllTrim((cAlias)->DESCRI)
                oJsResult["items"][nNewPos]["withheldTotal"] := (cAlias)->VALOR_TITULO
                oJsResult["items"][nNewPos]["valuePaid"]     := (cAlias)->VALOR_PAGO
                oJsResult["items"][nNewPos]["valueToPay"]    := (cAlias)->VALOR_PAGAR
                oJsResult["items"][nNewPos]["detail"]        := {}

                oDetail:= DoDetailedJsonResponse(cAlias, cMonthYear)
                AAdd(oJsResult["items"][nNewPos]["detail"], oDetail)
            EndIf

            nPageAux++
            (cAlias)->(DbSkip())
        EndDo
        oJsResult["hasNext"] := (cAlias)->(!Eof())
    Else
        oJsResult["items"]   := {}
        oJsResult["hasNext"] := .F.
    EndIf

    FwFreeObj(oIndexMap)
    (cAlias)->(DbCloseArea())
Return oJsResult:toJson()

/*/{Protheus.doc} GetTaxesValues
    Função que monta e executa query para obter o resultado Tributos x Natureza.
    @type  Static Function
    @author Caique Carlos
    @since 12/01/2026
    @version 1.0
    @param cAlias, character, Alias utilizado para a área de trabalho do banco de dados
    @param cBranches, character, Código das filiais separadas por vírgula
    @param cPeriodStart, character, Data inicial do período no formato YYYY-MM-DD
    @param cPeriodEnd, character, Data final do período no formato YYYY-MM-DD
    @param nPage, numeric, Número da página para paginação
    @param nPageSize, numeric, Quantidade de registros por página
    @param cJurisdiction, character, Esfera de governo (state, federal, municipal)
    @return Nil
    @example
        GetTaxesValues(@cAlias, "D MG 01,D RJ 02", "2024-01-01", "2024-12-31", 1, 10, "1")
/*/
Static Function GetTaxesValues(cAlias as character, cBranches as character, cPeriodStart as character, cPeriodEnd as character, nPage as numeric, nPageSize as numeric, cJurisdiction as character)
    Local oQryTaxes      := FWExecStatement():New()    as object
    Local nBind          := 1                          as numeric
    Local cQuery         := ""                         as character

    cQuery += "SELECT "
    cQuery +=   "CIW.CIW_FILIAL FILIAL, "
    cQuery +=   "CIW.CIW_EMISSA EMISSAO, "
    cQuery +=   "CIW.CIW_NATURE TRIBUTO, "
    cQuery +=   "CIW.CIW_NATREN NATUREZA, "
    cQuery +=   "FKX.FKX_DESCR DESCRI, "

    // Detalhamento dos títulos
    cQuery +=   "CIW.CIW_NUMERO TITULO, "
    cQuery +=   "CIW.CIW_TIPO TIPO, "
    cQuery +=   "CIW.CIW_PREFIX PREFIXO, "
    cQuery +=   "CIW.CIW_VALOR VALOR_TITULO, "
    cQuery +=   "SUM(CIW.CIW_VALOR) - SUM(CIW.CIW_SALDO) VALOR_PAGO, "
    cQuery +=   "SUM(CASE WHEN CIW.CIW_SALDO > 0 THEN CIW.CIW_SALDO ELSE 0 END) VALOR_PAGAR, "
    cQuery +=   "(CASE WHEN CIW.CIW_SALDO > 0 THEN 'EM ABERTO' ELSE 'PAGO' END) SITUACAO "

    cQuery += "FROM ? CIW "                                                    // CIWT10
    cQuery += "INNER JOIN " + RetSqlName("FKX") + " FKX "                      // FKWT10
    cQuery +=   "ON FKX.FKX_CODIGO = CIW.CIW_NATREN "                          // FwJoinFilial(FKX, CIW)
    cQuery += "WHERE CIW.CIW_FILIAL IN ( ? ) "                                 // D MG 01,D RJ 02
    cQuery +=   "AND CIW.CIW_EMISSA BETWEEN ? AND ? "                          // 2024-01-01 AND 2024-12-31
    cQuery +=   "AND CIW.CIW_VALOR > ? "                                       // 0
    cQuery +=   "AND CIW.CIW_ESFERA = ? "                                      // '1' - Federal
    cQuery +=   "AND CIW.CIW_NATREN <> ? "                                     // ' '
    cQuery +=   "AND CIW.D_E_L_E_T_ = ? "                                      // ' '
    cQuery +=   "AND FKX.D_E_L_E_T_ = ? "                                      // ' '
    cQuery += "GROUP BY CIW.CIW_FILIAL, CIW.CIW_EMISSA, CIW.CIW_NATURE, CIW.CIW_NATREN, "
    cQuery +=   "FKX.FKX_DESCR, CIW.CIW_NUMERO, CIW.CIW_TIPO, CIW.CIW_PREFIX, CIW.CIW_SALDO, CIW.CIW_VALOR "
    cQuery += "ORDER BY CIW.CIW_FILIAL, CIW.CIW_EMISSA "
    cQuery += "OFFSET ( ? * ? ) ROWS "                                         // (1 - 1) * 10
    cQuery += "FETCH NEXT ? ROWS ONLY"                                         // 11

    oQryTaxes:SetQuery(ChangeQuery(cQuery))

    oQryTaxes:SetUnsafe(nBind++, FIS319SqlName("CIW"))
    oQryTaxes:SetIn(nBind++, StrTokArr(cBranches, "," ))
    oQryTaxes:SetString(nBind++, StrTran(cPeriodStart, "-", ""))
    oQryTaxes:SetString(nBind++, StrTran(cPeriodEnd, "-", ""))
    oQryTaxes:SetNumeric(nBind++, 0)
    oQryTaxes:SetString(nBind++, cJurisdiction)
    oQryTaxes:SetString(nBind++, " ")
    oQryTaxes:SetString(nBind++, " ")
    oQryTaxes:SetString(nBind++, " ")
    oQryTaxes:SetNumeric(nBind++, nPage - 1)
    oQryTaxes:SetNumeric(nBind++, nPageSize)
    oQryTaxes:SetNumeric(nBind++, nPageSize + 1)

    oQryTaxes:cBaseQuery := oQryTaxes:GetFixQuery()
    cAlias := oQryTaxes:OpenAlias()

    FwFreeObj(oQryTaxes)
Return Nil

/*/ {Protheus.doc} MapJurisdiction
    Mapeia a jurisdição informada na path para o código utilizado na base de dados
    Função utilizada pra mapear os valores de jurisdição com isso evita linhas de condicionais
    @type    Static Function
    @author  Caique Carlos
    @since   03/12/2025
    @version 1.0
    @param   cJurisdiction, character, Jurisdição informada no path ("state","federal","municipal")
    @return  character, Código da jurisdição ('1'|'2'|'3')
    @example MapJurisdiction("state")
    @see     https://tdn.totvs.com/display/public/FRAMJOI/JSONObject%3AgetJSONObject
/*/
Static Function MapJurisdiction(cJurisdiction as character) as character
    Local cMap      := '{"federal": "1", "state": "2", "municipal": "3"}' as character
    Local cMapValue := ""                                                 as character
    Local jMap      := JsonObject():New()                                 as json

    jMap:FromJson(cMap)

    cMapValue := jMap:GetJsonObject(cJurisdiction)

    FwFreeObj(jMap)
Return cMapValue

/*/{Protheus.doc} DoDetailedJsonResponse
    Função para montar o detalhamento dos títulos em formato JSON.
    @type  Static Function
    @author Caique Carlos
    @since 14/01/2026
    @version 1.0
    @param cAlias, character, Alias do registro para detalhamento
    @param cMonthYear, character, Competência no formato "YYYY-MM"
    @return json, Objeto JSON com o detalhamento dos títulos
    @example
        DoDetailedJsonResponse(cAlias, "01/2025")
/*/
Static Function DoDetailedJsonResponse(cAlias as character, cMonthYear as character) as json
    Local oDetail := JsonObject():New() as json

    oDetail["competence"]  := cMonthYear
    oDetail["issueDate"]   := SubStr((cAlias)->EMISSAO,1,4) + "-" + SubStr((cAlias)->EMISSAO,5,2) + "-" + SubStr((cAlias)->EMISSAO,7,2)
    oDetail["titleNumber"] := AllTrim((cAlias)->TITULO)
    oDetail["type"]        := AllTrim((cAlias)->TIPO)
    oDetail["prefix"]      := AllTrim((cAlias)->PREFIXO)
    oDetail["total"]       := (cAlias)->VALOR_TITULO
    oDetail["balance"]     := (cAlias)->VALOR_PAGAR
    oDetail["status"]      := AllTrim((cAlias)->SITUACAO)
Return oDetail

/*/{Protheus.doc} CustomKeyGroup
    Função para montar a chave única de agrupamento.
    @type  Static Function
    @author Caique Carlos
    @since 14/01/2026
    @version 1.0
    @param cAlias, character, Alias do registro para detalhamento
    @param cMonthYear, character, Competência no formato "MM/YYYY"
    @return character, Chave única de agrupamento
    @example
        CustomKeyGroup(cAlias, "01/2025")
/*/
Static Function CustomKeyGroup(cAlias as character, cMonthYear as character) as character
Return (AllTrim((cAlias)->FILIAL) + "|" + cMonthYear + "|" + AllTrim((cAlias)->TRIBUTO) + "|" + AllTrim((cAlias)->NATUREZA))
