#include 'tlpp-core.th'
#include 'backoffice.fiscal.configurador.profiles.product.controller.ch'

#define HTTP_CODE_OK 200 // (OK): Requisição bem-sucedida.
#define HTTP_CODE_CREATED 201 // (Created): Recurso criado com sucesso.
#define HTTP_CODE_BAD_REQUEST 400 // (Bad Request): Requisição inválida ou malformada.
#define HTTP_CODE_NOT_FOUND 404 // (Not Found): Recurso não encontrado.
#define HTTP_CODE_INTERNAL_SERVER_ERROR 500 // (Internal Server Error): Erro interno do servidor.

#define BASE_URL '/api/fiscal/tax-configurator/v1/product-profile'

namespace totvs.protheus.backoffice.fiscal.configurador.profiles.productprofile.controller
using namespace totvs.protheus.backoffice.fiscal.configurador.profiles.productprofile.service
using namespace totvs.protheus.backoffice.fiscal.lib
using namespace totvs.protheus.backoffice.fiscal.configurador.profiles.profileoptimizer

/*/{Protheus.doc} ProductProfileController
Controller para gerenciamento dos endpoints de perfil de produto.
@type class
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
/*/
class ProductProfileController

    private data oExceptions as object
    private data oService as object
    private data oProfileOptimizer as object
    private data jBodyRequest as json
    private data jPathParamsRequest as json
    private data jQueryParamsRequest as json
    private data nStatusCode as numeric
    private data jResponse as json
    private data aMissingFields as array

    public method new() constructor

    @post(endpoint = BASE_URL, description = 'Realiza a inclusão de um perfil de produto')
    public method createProduct()

    @put(endpoint = BASE_URL + '/:code', description = 'Realiza a atualização de um perfil de produto')
    public method updateProduct()

    @delete(endpoint = BASE_URL + '/:code', description = 'Realiza a exclusão de um perfil de produto')
    public method deleteProduct()

    @get(endpoint = BASE_URL, description = 'Realiza a consulta de todos os perfis de produto')
    public method findAllProduct()

    @get(endpoint = BASE_URL + '/:code', description = 'Realiza a consulta de um perfil de produto')
    public method findOneProduct()

    @post(;
        endpoint = BASE_URL + '/products/search/count',;
        description = 'Realiza a busca da quantidade de produtos conforme o tipo e filtros informados.')
    public method searchProductsCount()

    @post(;
        endpoint = BASE_URL + '/products/search/list',;
        description = 'Realiza a busca da lista de produtos conforme o tipo e filtros informados.')
    public method searchProductsList()

    private method validateRequest(xData as variant, aRequiredKeys as array, lAllowEmpty as logical) as logical
    private method validateUpdateRequest(aRequest as array, aKeysValidate as array) as logical
    private method validateUpdateFiltersRequest(aRequest as array) as logical
    private method isValidAction(cAction as character) as logical
    private method setErrorResponse(cMessage as character, oError as object)
    private method destroy()

endclass

/*/{Protheus.doc} ProductProfileController:new()
Construtor da classe ProductProfileController.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
@return object, Instância da classe ProductProfileController
/*/
method new() class ProductProfileController

    oRest:updateKeyHeaderResponse('Content-Type','application/json; charset=utf-8')

    self:oExceptions := FisExceptions():new()
    self:oProfileOptimizer := ProfileOptimizer():new()
    self:oService := ProductProfileService():new(self:oExceptions, self:oProfileOptimizer)
    self:jBodyRequest := JsonObject():new()
    self:jPathParamsRequest := JsonObject():new()
    self:jQueryParamsRequest := JsonObject():new()
    self:jResponse := JsonObject():new()
    self:aMissingFields := array(0)
    self:nStatusCode := HTTP_CODE_INTERNAL_SERVER_ERROR

return self

/*/{Protheus.doc} ProductProfileController:createProduct()
Método para inclusão de um perfil de produto.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
/*/
method createProduct() class ProductProfileController

    local lValid := .F. as logical

    try
        self:jBodyRequest:fromJson(oRest:getBodyRequest())
        self:jQueryParamsRequest:fromJson(oRest:getQueryRequest():toJson())

        self:oProfileOptimizer:changeBranch(self:jQueryParamsRequest['branchCode'])

        lValid := self:validateRequest(self:jBodyRequest,{'code','description','products'})

        if !lValid
            throw self:oExceptions:badRequestException(STR0001) // 'Dados obrigatórios ausentes na requisição'
        endif

        self:jResponse := self:oService:createProduct(self:jBodyRequest)

        self:nStatusCode := HTTP_CODE_CREATED
    catch oError
        self:setErrorResponse(STR0002,oError) // 'Erro ao incluir perfil de produto'
    finally
        oRest:setStatusCode(self:nStatusCode)
        oRest:setResponse(self:jResponse:toJson())

        self:destroy()
    endtry

return

/*/{Protheus.doc} ProductProfileController:updateProduct()
Método para atualização de um perfil de produto.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
/*/
method updateProduct() class ProductProfileController

    local lValid := .F. as logical

    try
        self:jBodyRequest:fromJson(oRest:getBodyRequest())
        self:jPathParamsRequest:fromJson(oRest:getPathParamsRequest():toJson())
        self:jQueryParamsRequest:fromJson(oRest:getQueryRequest():toJson())

        self:oProfileOptimizer:changeBranch(self:jQueryParamsRequest['branchCode'])

        lValid := self:validateUpdateRequest(self:jBodyRequest['products'], {'code','key'}) .and. self:validateUpdateRequest(self:jBodyRequest['origins'], {'id','key'}) .and. self:validateUpdateFiltersRequest(self:jBodyRequest['filters'])

        if !lValid
            throw self:oExceptions:badRequestException(STR0001) // 'Dados obrigatórios ausentes na requisição'
        endif

        self:jResponse := self:oService:updateProduct(self:jPathParamsRequest['code'], self:jBodyRequest)

        self:nStatusCode := HTTP_CODE_OK
    catch oError
        self:setErrorResponse(STR0003,oError) // 'Erro ao atualizar perfil de produto'
    finally
        oRest:setStatusCode(self:nStatusCode)
        oRest:setResponse(self:jResponse:toJson())

        self:destroy()
    endtry

return

/*/{Protheus.doc} ProductProfileController:deleteProduct()
Método para exclusão de um perfil de produto.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
/*/
method deleteProduct() class ProductProfileController

    try
        self:jPathParamsRequest:fromJson(oRest:getPathParamsRequest():toJson())
        self:jQueryParamsRequest:fromJson(oRest:getQueryRequest():toJson())

        self:oProfileOptimizer:changeBranch(self:jQueryParamsRequest['branchCode'])

        self:jResponse := self:oService:deleteProduct(self:jPathParamsRequest['code'])

        self:nStatusCode := HTTP_CODE_OK
    catch oError
        self:setErrorResponse(STR0004,oError) // 'Erro ao excluir perfil de produto'
    finally
        oRest:setStatusCode(self:nStatusCode)
        oRest:setResponse(self:jResponse:toJson())

        self:destroy()
    endtry

return

/*/{Protheus.doc} ProductProfileController:findAllProduct()
Método para consulta de todos os perfis de produto.
@type method
@version 12.1.2510
@author Matheus Bispo
