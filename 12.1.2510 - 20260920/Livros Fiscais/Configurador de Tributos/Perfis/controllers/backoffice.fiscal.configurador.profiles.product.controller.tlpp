/*/{Protheus.doc} ProductProfileController::searchProductsCount
Método para busca da quantidade de Produtos de acordo com os filtros.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/11/2025
/*/
method searchProductsCount() class ProductProfileController

    local lValid as logical
    local nI as numeric
    local jFilterItems as json
    local lAllowEmpty := .F. as logical

    try
        self:jBodyRequest:fromJson(oRest:getBodyRequest())
        self:jQueryParamsRequest:fromJson(oRest:getQueryRequest():toJson())

        self:oProfileOptimizer:changeBranch(self:jQueryParamsRequest['branchCode'])

        lValid := self:validateRequest(self:jBodyRequest,{'items'},lAllowEmpty)
        if ( lValid )
            for nI := 1 to len(self:jBodyRequest['items'])
                jFilterItems := self:jBodyRequest['items'][nI]
                lAllowEmpty := .F.
                lValid := lValid .and. self:validateRequest(jFilterItems,{'key'},lAllowEmpty)
                lAllowEmpty := .T.
                lValid := lValid .and. self:validateRequest(jFilterItems,{'value'},lAllowEmpty)
            next nI
        endif

        if ( !lValid )
            throw self:oExceptions:badRequestException(STR0001) // 'Dados obrigatórios ausentes na requisição'
        endif

        self:jResponse := self:oService:searchProducts(self:jBodyRequest, 'count')

        self:nStatusCode := HTTP_CODE_OK
    catch oError
        self:setErrorResponse(STR0005, oError) //'Erro ao buscar produtos'
    finally
        oRest:setStatusCode(self:nStatusCode)
        oRest:setResponse(self:jResponse:toJson())

        self:oProfileOptimizer:restoreBranch()

        self:destroy()
    endtry

return

/*/{Protheus.doc} ProductProfileController::searchProductsList
Método para busca de Participantes de acordo com o tipo (Cliente ou Fornecedor) e os filtros.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/11/2025
/*/
method searchProductsList() class ProductProfileController

    local lValid as logical
    local nI as numeric
    local jFilterItems as json
    local lAllowEmpty := .T. as logical

    try
        self:jBodyRequest:fromJson(oRest:getBodyRequest())
        self:jQueryParamsRequest:fromJson(oRest:getQueryRequest():toJson())

        self:oProfileOptimizer:changeBranch(self:jQueryParamsRequest['branchCode'])

        lValid := self:validateRequest(self:jBodyRequest,{'items'},lAllowEmpty)
        if ( lValid )
            for nI := 1 to len(self:jBodyRequest['items'])
                jFilterItems := self:jBodyRequest['items'][nI]
                lAllowEmpty := .F.
                lValid := lValid .and. self:validateRequest(jFilterItems,{'key'},lAllowEmpty)
                lAllowEmpty := .T.
                lValid := lValid .and. self:validateRequest(jFilterItems,{'value'},lAllowEmpty)
            next nI
        endif

        if ( !lValid )
            throw self:oExceptions:badRequestException(STR0001) // 'Dados obrigatórios ausentes na requisição'
        endif

        self:jResponse := self:oService:searchProducts(self:jBodyRequest, 'list')

        self:nStatusCode := HTTP_CODE_OK
    catch oError
        self:setErrorResponse(STR0005, oError) //'Erro ao buscar produtos'
    finally
        oRest:setStatusCode(self:nStatusCode)
        oRest:setResponse(self:jResponse:toJson())

        self:oProfileOptimizer:restoreBranch()

        self:destroy()
    endtry

return

/*/{Protheus.doc} ProductProfileController:validateRequest()
Método para validação dos dados obrigatórios na requisição.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
@param xData, variant, Dados a serem validados (pode ser um objeto JSON ou um array de objetos JSON)
@param aRequiredKeys, array, Chaves obrigatórias que devem estar presentes nos dados
@param lAllowEmpty, logical, Indica se permite valores em branco
@return logical, Retorna .T. se os dados forem válidos, .F. caso contrário
/*/
method validateRequest(xData as variant, aRequiredKeys as array, lAllowEmpty as logical) as logical class ProductProfileController
    
    local jRequest := nil as json
    local aItems := {} as array
    local cField := '' as character
    local lValid := .T. as logical
    local nLenItems := 0 as numeric
    local nLenReqKeys := 0 as numeric
    local nI := 0 as numeric
    local nJ := 0 as numeric

    default lAllowEmpty := .F.

    if ( valType(xData) == 'J' )
        aItems := { xData }
    else
        aItems := xData
    endif

    nLenItems := len(aItems)
    nLenReqKeys := len(aRequiredKeys)

    for nI := 1 to nLenItems
        jRequest := aItems[nI]
        for nJ := 1 to nLenReqKeys
            cField := aRequiredKeys[nJ]
            if ( !jRequest:hasProperty(cField) .or. (valType(jRequest[cField]) != 'J' .and. empty(jRequest[cField]) .and. !lAllowEmpty) )
                lValid := .F.
                aadd(self:aMissingFields, cField)
            endif
        next nJ
    next nI

return lValid

/*/{Protheus.doc} ProductProfileController:setErrorResponse()
Método para definir a resposta de erro.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
@param cMessage, character, Mensagem de erro
@param oError, object, Objeto de erro capturado na exceção
/*/
method setErrorResponse(cMessage as character, oError as object) class ProductProfileController

    if ( oError:genCode == HTTP_CODE_BAD_REQUEST .or. ;
        oError:genCode == HTTP_CODE_NOT_FOUND )
        self:nStatusCode := oError:genCode
    endif

    self:jResponse['success'] := .F.
    self:jResponse['message'] := fwHttpEncode(cMessage)

    if ( !empty(oError:description) )
        if ( empty(cMessage) )
            self:jResponse['message'] := fwHttpEncode(oError:description)
        else
            self:jResponse['detailedMessage'] := fwHttpEncode(oError:description)
        endif
    endif

    if ( !empty(self:aMissingFields) )
        self:jResponse['missingFields'] := self:aMissingFields
    endif

return

/*/{Protheus.doc} ProductProfileController:validateUpdateRequest()
Método para validar os dados de atualização na requisição.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
@param aRequest, array, Dados do Requisição
@param aKeysValidate, array, Chaves que devem ser validados
@return lValid, logical, retorna se os dados da requisição foram passados corretamente
/*/
method validateUpdateRequest(aRequest as array, aKeysValidate as array) as logical class ProductProfileController
    local lValid := .T. as logical
    local nI := 0 as numeric

    for nI := 1 to len(aRequest)
        lValid := .F.

        if self:validateRequest(aRequest[nI],{'action'}) .and. self:isValidAction(aRequest[nI]['action'])
            lValid := self:validateRequest(aRequest[nI], aKeysValidate)
        endif

        if !lValid
            exit
        endif
    next nI  
return lValid

/*/{Protheus.doc} ProductProfileController:validateUpdateFiltersRequest()
Método para validar se as requisições de atualização de filtros estão corretas.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
@param aRequest, array, Dados do Requisição
@return lValid, logical, retorna se os dados da requisição foram passados corretamente
/*/
method validateUpdateFiltersRequest(aRequest as array) as logical class ProductProfileController
    local aKeys := {} as array
    local lValid := .T. as logical
    local nI := 0 as numeric
    local nJ := 0 as numeric

    for nI := 1 to len(aRequest)
        lValid := .F.

        if self:validateRequest(aRequest[nI],{'action'}) .and. self:isValidAction(aRequest[nI]['action'])
            if !( aRequest[nI]['action'] == 'none' )
                for nJ := 1 to len(aRequest[nI]['items'])
                    if self:isValidAction(aRequest[nI]['items'][nJ]['action'])
                        if aRequest[nI]['items'][nJ]['action'] == 'insert'
                            aKeys := {'key','value'}
                        else
                            aKeys := {'key','value','id'}
                        endif

                        lValid := self:validateRequest(aRequest[nI]['items'][nJ], aKeys)
                    endIf
                next nJ
            else
                lValid := .T.
            endIf
        endIf

        if !lValid
            exit
        endif
    next nI

    aSize(aKeys, 0)
return lValid

/*/{Protheus.doc} ProductProfileController:isValidAction()
Método para validar se a ação informada na requisição é válida.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
@param cAction, character, Ação passada na requisição
@return lValid, logical, retorna se os dados da requisição foram passados corretamente na chave action
/*/
method isValidAction(cAction as character) as logical class ProductProfileController
    local aActions := {'insert','update','delete','none'} as array
    local lValid := .F. as logical

    lValid := aScan(aActions,{|x| x == allTrim(lower(cAction))}) > 0

    aSize(aActions, 0)
return lValid

/*/{Protheus.doc} ProductProfileController:destroy()
Método destrutor da classe ProductProfileController.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
/*/
method destroy() class ProductProfileController

    self:oExceptions:destroy()
    fwFreeObj(self:oExceptions)

    self:oService:destroy()
    fwFreeObj(self:oService)

    self:oProfileOptimizer:destroy()
    fwFreeObj(self:oProfileOptimizer)

    fwFreeObj(self:jBodyRequest)
    self:jBodyRequest := nil

    fwFreeObj(self:jPathParamsRequest)
    self:jPathParamsRequest := nil

    fwFreeObj(self:jQueryParamsRequest)
    self:jQueryParamsRequest := nil

    fwFreeObj(self:jResponse)
    self:jResponse := nil

    fwFreeArray(self:aMissingFields)
    self:aMissingFields := nil

return
