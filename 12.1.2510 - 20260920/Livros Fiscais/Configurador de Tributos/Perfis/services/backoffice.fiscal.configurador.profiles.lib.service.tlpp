#include 'tlpp-core.th'
#include 'backoffice.fiscal.configurador.profiles.lib.service.ch'

namespace totvs.protheus.backoffice.fiscal.configurador.profiles.lib.service
using namespace totvs.protheus.backoffice.fiscal.configurador.profiles.lib.repository

/*/{Protheus.doc} ProfilesLibService
Service para gerenciamento das funcionalidades genéricas dos perfis
@type class
@version 12.1.2510
@author Juliano Fernandes
@since 20/11/2025
/*/
class ProfilesLibService

    private data oRepository as object
    private data oExceptions as object
    private data jResponse as json

    public method new() constructor

    public method getLookupData(cCode as character, jRequest as json) as json
    public method getParamSX6(cCode as character) as json

    public method destroy()

endclass

/*/{Protheus.doc} ProfilesLibService::new
Método construtor da classe ProfilesLibService.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 20/11/2025
@param oExceptions, object, Instância da classe de exceções
@return object, Instância da classe ProfilesLibService
/*/
method new(oExceptions as object) class ProfilesLibService

    self:oRepository := ProfilesLibRepository():new()
    self:oExceptions := oExceptions
    self:jResponse := JsonObject():new()

return self

/*/{Protheus.doc} ProfilesLibService::getLookupData
Método para busca de dados de consultas padrão.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 20/11/2025
@param cCode, character, Código da consulta padrão
@param jRequest, json, Objeto JSON com os parâmetros da requisição
@return json, Resposta da operação de consulta
/*/
method getLookupData(cCode as character, jRequest as json) as json class ProfilesLibService

    local cFilter as character
    local cKeys as character
    local cKeyField as character
    local cSearchType as character    
    local nPage := 1 as numeric
    local nPageSize := 10 as numeric
    local lHasNext as logical
    local aItems as array
    
    if ( !self:oRepository:findLookup(cCode) )
        throw self:oExceptions:notFoundException(STR0001) // 'Consulta padrão não localizada'
    endif

    if ( jRequest:hasProperty('filter') .and. jRequest['filter'] != nil )
        cFilter := upper(allTrim(jRequest['filter']))
    endif

    if ( jRequest:hasProperty('keys') .and. jRequest['keys'] != nil )
        cKeys := upper(allTrim(jRequest['keys']))
    endif

    if ( jRequest:hasProperty('keyField') .and. jRequest['keyField'] != nil )
        cKeyField := upper(allTrim(jRequest['keyField']))
    endif

    if ( jRequest:hasProperty('searchType') .and. jRequest['searchType'] != nil )
        cSearchType := upper(allTrim(jRequest['searchType']))
    endif

    if ( jRequest:hasProperty('page') .and. jRequest['page'] != nil )
        nPage := val(jRequest['page'])
    endif

    if ( jRequest:hasProperty('pageSize') .and. jRequest['pageSize'] != nil )
        nPageSize := val(jRequest['pageSize'])
    endif

    aItems := self:oRepository:getLookupData(cCode, cFilter, cKeys, cKeyField, cSearchType, nPage, nPageSize, @lHasNext)

    self:jResponse['items'] := aItems
    self:jResponse['hasNext'] := lHasNext

return self:jResponse

/*/{Protheus.doc} ProfilesLibService::getParamSX6
Método para obtenção de dados de parametros SX6
@type method
@version 12.1.2510
@author Matheus Bispo
@since 09/12/2025
@param cCode, character, Código do parametro
@return json, Resposta da operação de consulta
/*/
method getParamSX6(cCode as character) as json class ProfilesLibService
    local xParamValue as variant

    xParamValue := getMv(cCode)

    self:jResponse['param'] := cCode
    self:jResponse['type'] := valType(xParamValue)
    self:jResponse['value'] := xParamValue

return self:jResponse

/*/{Protheus.doc} ProfilesLibService::destroy
Método destrutor da classe ProfilesLibService.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
/*/
method destroy() class ProfilesLibService

    self:oRepository:destroy()
    fwFreeObj(self:oRepository)
    
    fwFreeObj(self:jResponse)
    self:jResponse := nil

return
