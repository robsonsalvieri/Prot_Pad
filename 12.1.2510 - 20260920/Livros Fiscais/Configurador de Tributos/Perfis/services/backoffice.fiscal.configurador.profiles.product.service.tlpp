#include 'tlpp-core.th'
#include 'fwmvcdef.ch'
#include 'backoffice.fiscal.configurador.profiles.product.service.ch'

namespace totvs.protheus.backoffice.fiscal.configurador.profiles.productprofile.service
using namespace totvs.protheus.backoffice.fiscal.configurador.profiles.productprofile.repository
using namespace totvs.protheus.backoffice.fiscal.lib

/*/{Protheus.doc} ProductProfileService
Service para gerenciamento dos perfis de produto.
@type class
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
/*/
class ProductProfileService

    private data oRepository as object
    private data oExceptions as object
    private data jResponse as json
    private data aFieldsFilters as array

    public method new() constructor

    public method createProduct(jRequest as json) as json

    public method updateProduct(cCode as character, jRequest as json) as json

    public method deleteProduct(cCode as character) as json

    public method findAllProduct(jRequest as json) as json

    public method findOneProduct(cCode as character) as json

    public method searchProducts(jRequest as json, cSearchType as character) as json

    private method validateFiltersProduct(aFilters as array) as logical

    public method destroy()

endclass

/*/{Protheus.doc} ProductProfileService:new()
Método construtor da classe ProductProfileService.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
@param oExceptions, object, Instância da classe de exceções
@return object, Instância da classe ProductProfileService
/*/
method new(oExceptions as object, oProfileOptimizer as object) class ProductProfileService
    self:oRepository := ProductProfileRepository():new()
    self:oExceptions := oExceptions
    self:jResponse := JsonObject():new()
    oProfileOptimizer:setTypes('','PRODUCT')
    self:aFieldsFilters := aClone(oProfileOptimizer:getFields()) //Clono o array para conseguir limpara o objeto, dessa forma sera criado uma nova referencia na memoria
return self

/*/{Protheus.doc} ProductProfileService:createProduct()
Método para inclusão de um perfil de produto.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
@param jRequest, json, Dados do perfil de produto a ser incluído
@return json, Resposta da operação de inclusão
/*/
method createProduct(jRequest as json) as json class ProductProfileService

    if ( self:oRepository:exists(jRequest['code']) )
        throw self:oExceptions:badRequestException(STR0001) // 'Perfil de produto já cadastrado'
    endif

    self:oRepository:startModel(MODEL_OPERATION_INSERT)
    self:oRepository:setHeaderValues(jRequest['code'], jRequest['description'])

    if ( jRequest:hasProperty('filters') .and. !empty(jRequest['filters']) .and. self:oRepository:hasFiltersModel() .and. self:validateFiltersProduct(jRequest['filters']) )
        self:oRepository:addFilters(jRequest['filters'][1]['items'], jRequest['code'])
    endif

    self:oRepository:addProducts(jRequest['products'], jRequest['code'])

    if ( jRequest:hasProperty('origins') .and. !empty(jRequest['origins']) )
        self:oRepository:addOrigins(jRequest['origins'], jRequest['id'])
    endIf

    if ( !self:oRepository:saveModel() )
        throw self:oExceptions:badRequestException(self:oRepository:getError())
    endif

    self:jResponse['success'] := .T.
    self:jResponse['message'] := fwHttpEncode(STR0002) // 'Perfil de produto incluído com sucesso'
    self:jResponse['productProfile'] := self:oRepository:getProductProfileData()

    self:oRepository:endModel()

return self:jResponse

/*/{Protheus.doc} ProductProfileService:updateProduct()
Método para atualização de um perfil de produto.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
@param cCode, character, Código do perfil de produto a ser atualizado
@param jRequest, json, Dados do perfil de produto a ser atualizado
@return json, Resposta da operação de atualização
/*/
method updateProduct(cCode as character, jRequest as json) as json class ProductProfileService
    
    if ( !self:oRepository:exists(cCode) )
        throw self:oExceptions:notFoundException(STR0003) // 'Perfil de produto não localizado'
    endif

    self:oRepository:startModel(MODEL_OPERATION_UPDATE)
    self:oRepository:setHeaderValues(cCode, jRequest['description'])

    if (jRequest:hasProperty('filters') .and. !empty(jRequest['filters'])  .and. self:oRepository:hasFiltersModel() .and. self:validateFiltersProduct(jRequest['filters']) .and. !self:oRepository:updateFilters(jRequest['filters'], cCode)) .or. ;
        (jRequest:hasProperty('products') .and. !empty(jRequest['products']) .and. !self:oRepository:updateProducts(jRequest['products'], cCode) .or. ;
         (jRequest:hasProperty('origins') .and. !empty(jRequest['origins']) .and. !self:oRepository:updateOrigins(jRequest['origins'], cCode)) .or. ;
         !self:oRepository:saveModel() )
        throw self:oExceptions:badRequestException(self:oRepository:getError())
    endif

    self:jResponse['success'] := .T.
    self:jResponse['message'] := fwHttpEncode(STR0004) // 'Perfil de produto atualizado com sucesso'
    self:jResponse['productProfile'] := self:oRepository:getProductProfileData()

    self:oRepository:endModel()

return self:jResponse

/*/{Protheus.doc} ProductProfileService:deleteProduct()
Método para exclusão de um perfil de produto.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
@param cCode, character, Código do perfil de produto a ser excluído
@return json, Resposta da operação de exclusão
/*/
method deleteProduct(cCode as character) as json class ProductProfileService

    if ( !self:oRepository:exists(cCode) )   
        throw self:oExceptions:notFoundException(STR0003) // 'Perfil de produto não localizado'
    endif

    self:oRepository:startModel(MODEL_OPERATION_DELETE)

    if ( !self:oRepository:saveModel() )
        throw self:oExceptions:badRequestException(self:oRepository:getError())
    endif

    self:jResponse['success'] := .T. 
    self:jResponse['message'] := fwHttpEncode(STR0005) // 'Perfil de produto excluído com sucesso'

    self:oRepository:endModel()

return self:jResponse

/*/{Protheus.doc} ProductProfileService:findAllProduct()
Método para consulta de todos os perfis de produto.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
@param jRequest, json, Dados da requisição
@return json, Resposta da operação de consulta
/*/
method findAllProduct(jRequest as json) as json class ProductProfileService

    local aproductProfiles as array
    local cFilter as character
    local nPage := 1 as numeric
    local nPageSize := 15 as numeric
    local lHasNext as logical
    local lEnableFilters as logical

    if ( jRequest:hasProperty('filter') .and. jRequest['filter'] != nil )
        cFilter := '%' + upper(allTrim(jRequest['filter'])) + '%'
    endif

    if ( jRequest:hasProperty('page') .and. jRequest['page'] != nil )
        nPage := val(jRequest['page'])
    endif

    if ( jRequest:hasProperty('pageSize') .and. jRequest['pageSize'] != nil )
        nPageSize := val(jRequest['pageSize'])
    endif

    aproductProfiles := self:oRepository:findAllProduct(cFilter, nPage, nPageSize, @lHasNext, @lEnableFilters)

    self:jResponse['success'] := .T.
    self:jResponse['message'] := fwHttpEncode(STR0006) // 'Registros localizados com sucesso'

    if ( len(aproductProfiles) == 0 )         
        throw self:oExceptions:notFoundException(STR0007) // 'Nenhum registro localizado'
    endif

    self:jResponse['productProfiles'] := aproductProfiles
    self:jResponse['hasNext'] := lHasNext
    self:jResponse['total'] := len(aproductProfiles)
    self:jResponse['page'] := nPage
    self:jResponse['pageSize'] := nPageSize
    self:jResponse['enableFilters'] := lEnableFilters

return self:jResponse

/*/{Protheus.doc} ProductProfileService:findOneProduct()
Método para consulta de um perfil de produto pelo código.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
@param cCode, character, Código do perfil de produto a ser consultado
@return json, Resposta da operação de consulta
/*/
method findOneProduct(cCode as character) as json class ProductProfileService

    if ( !self:oRepository:exists(cCode) ) 
        throw self:oExceptions:notFoundException(STR0007) // 'Nenhum registro localizado'
    endif

    self:oRepository:startModel(MODEL_OPERATION_VIEW)

    self:jResponse['success'] := .T.
    self:jResponse['message'] := fwHttpEncode(STR0008) // 'Registro localizado com sucesso'
    self:jResponse['productProfile'] := self:oRepository:getProductProfileData()

    self:oRepository:endModel()

return self:jResponse

/*/{Protheus.doc} ProductProfileService:validateFiltersProduct()
Faz a validação dos filtros evitando problemas de gravar campos não considerados na tabela
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
@param aFilters, array, filtros da requisicao
@return logical, retorna se esta valido ou não
/*/
method validateFiltersProduct(aFilters as array) as logical class ProductProfileService
    local cKey := "" as character
    local nI as numeric
    local nJ as numeric

    for nI := 1 to len(aFilters)
        for nJ := 1 to len(aFilters[nI]['items'])
            cKey := alltrim(aFilters[nI]['items'][nJ]['key'])

            if (( cKey != 'B1_COD_TO' .and. cKey != 'B1_COD_FR' )) .and. ! (aScan(self:aFieldsFilters, { |x| AllTrim(SubStr(x[2], 4)) == SubStr(cKey, 4) }))
                throw self:oExceptions:badRequestException(STR0009 + " " + cKey) // 'Foram informados campos invalidos para o filtro'
            endIf
        next nJ
    next nI

return .T.

/*/{Protheus.doc} ParticipantProfileService::searchProducts
Método para busca de Participantes de acordo com o tipo (Cliente ou Fornecedor) e os filtros.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/11/2025
@param jRequest, json, Dados da requisição
@param cSearchType, character, Tipo de busca (count (apenas contagem); list (listagem dos participantes))
@return json, Resposta da operação de consulta
/*/
method searchProducts(jRequest as json, cSearchType as character) as json class ProductProfileService

    local xReturn as variant
    local aProducts as array
    local aItems := jRequest['items'] as array
    local nPage := 1 as numeric
    local nPageSize := 15 as numeric
    local lHasNext as logical

    if ( jRequest:hasProperty('page') .and. jRequest['page'] != nil )
        nPage := jRequest['page']
    endif

    if ( jRequest:hasProperty('pageSize') .and. jRequest['pageSize'] != nil )
        nPageSize := jRequest['pageSize']
    endif    

    asort(aItems,,,{|x,y| x['key'] < y['key']}) // Ordena o array pela Chave (Key)
    
    xReturn := self:oRepository:searchProducts(aItems, cSearchType, nPage, nPageSize, @lHasNext)

    self:jResponse['success'] := .T.
    self:jResponse['message'] := fwHttpEncode(STR0006) // 'Registros localizados com sucesso'

    if ( cSearchType == 'count' )
        if ( xReturn == 0 )
            self:jResponse['message'] := fwHttpEncode(STR0007) // 'Nenhum registro localizado'
        endif

        self:jResponse['total'] := xReturn
    else
        aProducts := xReturn
        if ( len(aProducts) == 0 )
            self:jResponse['message'] := fwHttpEncode(STR0007) // 'Nenhum registro localizado'
        endif

        self:jResponse['products'] := aProducts
        self:jResponse['hasNext'] := lHasNext
        self:jResponse['total'] := len(aProducts)
        self:jResponse['page'] := nPage
        self:jResponse['pageSize'] := nPageSize
    endif

return self:jResponse

/*/{Protheus.doc} ProductProfileService:destroy()
Método destrutor da classe ProductProfileService.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
/*/
method destroy() class ProductProfileService

    self:oRepository:destroy()
    fwFreeObj(self:oRepository)
    
    fwFreeObj(self:jResponse)
    self:jResponse := nil

    fwFreeArray(self:aFieldsFilters)

return
