#INCLUDE "tlpp-core.th"
#INCLUDE "fiscal.configurador.tax.presumedcredit.registration.import.ch"
#INCLUDE "FILEIO.CH"

Namespace totvs.protheus.backoffice.fiscal.configurador.tax.presumedcredit.registration.import

Static nElemArq	:= 5 as numeric

//-------------------------------------------------------------------
/*/{Protheus.doc} ImpCredPresIbsCbs
Importacao da Tabela para o CST/ClassTrib do IBS e CBS 

@author Douglas Dourado
@since 11/09/2025
/*/
//-------------------------------------------------------------------
Function ImpCredPresIbsCbs(cArquivo as character) as logical

	Local cFile	:= ""  as character
	Local lRet  := .T. as logical

	Default cArquivo   := Nil

	ChangeFile(.T.,@cFile,cArquivo)

	If ! Empty(cFile)
		Processa({|| lRet := AtuCJN(cFile)},STR0001) //'Processando...'
	EndIf

Return lRet

//-------------------------------------------------------------------
/*/{Protheus.doc} AtuCJN
Importacao da Tabela de Crédito Presumido do IBS e CBS 

@author Douglas Dourado
@since 11/09/2025
@version 1.0
@parâmetros de entrada
cFile - arquivo .CSV que será utilizado para importar os dados
@return
lRet - Lógico, indicando se concluiu o processamento corretamente (.T.).
/*/
//-------------------------------------------------------------------
Static Function AtuCJN(cFile as character) as logical

	Local aCSVFile 	       := {}                 as array
	Local aFile            := {}                 as array
	Local aAux             := {}                 as array
	Local aCampos          := {}                 as array
	Local dDtIniV	       := CtoD("  /  /    ") as date
	Local dDtFimV	       := CtoD("  /  /    ") as date
	Local nRegs		       := 0                  as numeric
	Local nX 		       := 0                  as numeric
	Local nX2		       := 0                  as numeric
	Local nCont		       := 0                  as numeric
	Local nElemCodCredPres := 0                  as numeric
	Local nElemDtIni       := 0                  as numeric	
	Local nElemDtFim       := 0                  as numeric	
	Local lRet 		       := .F.                as logical
	Local lInclui	       := .F.                as logical
	Local lEmptyIni        := .F.                as logical
	Local lTemIniPad       := .F.                as logical
	Local lGrava           := .F.                as logical
	Local cTexto                                 as character

	// aCampos[x][1] := Campo na CJN
	// aCampos[x][2] := Campo no arquivo ".csv"
	// aCampos[x][3] := Se está ou não no For..Next de gravação dinamica
	// aCampos[x][4] := Se é um campo exigido no arquivo ".csv". Uma forma de validar o arquivo ".csv"
	// aCampos[x][5] := Elemento correspondente no array gerado na leitura do arquivo ".csv"
	// aCampos[x][6] := Se o campo existe ou não no dicionário. Será atualizado por ( CJN->(FieldPos(aCampos[nX][1])) > 0 )
	// aCampos[x][7] := Inicializador padrão do campo para gravar na inclusão ou alteração se o conteúdo estiver vazio.
    Aadd( aCampos , { 'CJN_CODCRE' , 'cCredPres'                , .F., .T., 0, .T., '' } )
    Aadd( aCampos , { 'CJN_DESCRI' , 'Descrição'			    , .T., .T., 0, .T., '' } )
    Aadd( aCampos , { 'CJN_LCTXT'  , 'LC 214/2025'              , .T., .T., 0, .T., '' } )
    Aadd( aCampos , { 'CJN_VIANF'  , 'Apropria via NF?'         , .T., .T., 0, .T., '' } )
    Aadd( aCampos , { 'CJN_VIAEVE' , 'Apropria via evento?'     , .T., .F., 0, .T., '' } )
    Aadd( aCampos , { 'CJN_DEDCRE' , 'ind_DeduzCredPres'        , .T., .F., 0, .T., '' } )
    Aadd( aCampos , { 'CJN_PRECBS' , 'ind_gCBSCredPres'         , .T., .F., 0, .T., '' } )
	Aadd( aCampos , { 'CJN_PREIBS' , 'ind_gIBSCredPres'         , .T., .F., 0, .T., '' } )
	Aadd( aCampos , { 'CJN_ALQCBS' , 'Alíquota CBS'             , .T., .F., 0, .T., '' } )
	Aadd( aCampos , { 'CJN_ALQIBS' , 'Alíquota IBS'             , .T., .F., 0, .T., '' } )
	Aadd( aCampos , { 'CJN_CCLASS' , 'cClass nota referenciada' , .T., .F., 0, .T., '' } )
    Aadd( aCampos , { 'CJN_DTINI'  , 'dIniVig'                  , .F., .F., 0, .T., '' } )
    Aadd( aCampos , { 'CJN_DTFIM'  , 'dFimVig'                  , .F., .F., 0, .T., '' } )
    Aadd( aCampos , { 'CJN_PALCBS' , 'pAliqCredPresCBS'         , .T., .F., 0, .F., '' } )

	If ValidCJN("CJN")

		DBSelectArea("CJN")

		For nX := 1 to Len(aCampos)

			If !aCampos[nX][6]
				aCampos[nX][6] := ( CJN->(FieldPos(aCampos[nX][1])) > 0 )
			EndIf

			If  aCampos[nX][6]
				aCampos[nX][7] := FWGetSX3Cache(aCampos[nX][1],'X3_RELACAO') // Inicializador Padrão
			EndIf
		Next

		//Transforma o arquivo CSV em array
		aCSVFile := LerCSV(cFile,@aCampos)

		For nX := 1 to Len(aCSVFile)

			aAux   := {}
			cTexto := ''

			For nX2 := 1 to Len(aCSVFile[nX]) // Trata o conteudo ...
				cTexto += aCSVFile[nX][nX2]
				If Left( cTexto , 1 ) <> '"' .Or. Right( cTexto , 1 ) == '"'
					Aadd( aAux,cTexto )
					cTexto := ''
				EndIf
			Next

			For nX2 := ( Len(aAux)+1 ) To Len(aCSVFile[1])
				Aadd( aAux,'' )
			Next

			Aadd( aFile,aAux )
		Next

		nRegs := Len(aFile)
		lRet  := (nRegs > 0)

		If lRet

			nElemCodCredPres := aScan(aCampos, {|x| x[1] == 'CJN_CODCRE'})
			nElemDtIni  := aScan(aCampos, {|x| x[1] == 'CJN_DTINI' })
			nElemDtFim  := aScan(aCampos, {|x| x[1] == 'CJN_DTFIM' })

			ProcRegua(nRegs)

			//Processa arquivo
			For nX := 2 to  Len(aFile)  // comeca em 2 porque 1a linha eh cabecalho

				cCodCredPres     := Alltrim(aFile[nX][ aCampos[nElemCodCredPres][nElemArq] ])
				
				If nElemDtIni > 0
					dDtIniV := CtoD(aFile[nX][ aCampos[nElemDtIni][nElemArq] ])
				EndIf
				
				If nElemDtFim > 0
					dDtFimV := CtoD(aFile[nX][ aCampos[nElemDtFim][nElemArq] ])
				EndIf
				
				lEmptyIni   := Empty(dDtIniV)

				If lEmptyIni
					dDtIniV := dDataBase
				EndIf

				IncProc(STR0005 + alltrim(str(nX)) + ' / ' + alltrim(str(nRegs)) + STR0006 + cFile)

				If !Empty(cCodCredPres)

					CJN->(DbSetOrder(1))
					lInclui := ( ! CJN->(dbSeek(xFilial("CJN") + cCodCredPres)) )
					RecLock('CJN',lInclui) // Se o codigo ja existe, sera uma atualizacao, senao, uma inclusao
					
					If lInclui
						CJN->CJN_FILIAL	:= xFilial("CJN")
						CJN->CJN_CODCRE	:= cCodCredPres
					Else
						If lEmptyIni .And. CJN->CJN_DTINI < dDtIniV
							dDtIniV := CJN->CJN_DTINI
						EndIf
					EndIf
					
					CJN->CJN_DTINI 	:= dDtIniV
					CJN->CJN_DTFIM 	:= dDtFimV
					
					For nCont := 1 To Len(aCampos) // Grava dinamicamente o restante dos campos
						If aCampos[nCont][3] .And. aCampos[nCont][nElemArq] > 0
							lGrava := .T.
							
							// Inicializador Padrão
							lTemIniPad := !Empty(aCampos[nCont][7])

							// Se tem Inicializador Padrão e o conteúdo a importar está vazio
							If lTemIniPad .And. Empty(aFile[nX][aCampos[nCont][nElemArq]])
								// Na inclusão ou se o campo estiver vazio, considera o Inicializador padrão, caso contrário mantém o conteúdo do campo
								If lInclui .Or. Empty(CJN->&(aCampos[nCont][1]))
									aFile[nX][aCampos[nCont][nElemArq]] := &(aCampos[nCont][7])
								Else
									lGrava := .F.
								EndIf
							EndIf
							
							If lGrava
								CJN->&(aCampos[nCont][1]) := Alltrim(aFile[nX][aCampos[nCont][nElemArq]])
							EndIf
						EndIf
					Next

					CJN->(MsUnlock())

				Endif
			Next
			MSGINFO(STR0007 , STR0003 )

		EndIf
	
		CJN->( dbCloseArea() )
	
	EndIf

	aCSVFile := aSize(aCSVFile,0)
	aCSVFile := Nil

	aFile := aSize(aFile,0)
	aFile := Nil

	aAux := aSize(aAux,0)
	aAux := Nil
	
	aCampos := aSize(aCampos,0)
	aCampos := Nil

Return lRet

//-------------------------------------------------------------------
/*/{Protheus.doc} ChangeFile
Apresentar tela de seleção do arquivo .csv para importação da Classificação Tributária do IBS/CBS

@author Douglas Dourado
@since 11/09/2025
@version 1.0
@parâmetros de entrada
lOpen - indica se é "open dialog" (.T.) ou "save dialog" (.F.)
cFile - variavel enviada por referência, que conterá o nome do arquivo para importação dos dados.
cFileChg - arquivo a ser processado (atender à automação). Abaixo segue descrição das opções do 6º parâmetro da função cGetFile(),
           o qual indica as opções de funcionamento:
		   GETF_LOCALHARD   : Apresenta a unidade de disco local 
		   GETF_NETWORKDRIVE: Apresenta as unidades de rede (mapeamento). Ao executar o SmartClient com um usuário diferente do  
		                      usuário logado na sessão no Windows, os drives de Rede não serão apresentados.
@return
nenhum
/*/
//-------------------------------------------------------------------
Static Function ChangeFile(lOpen as logical, cFile as character, cFileChg as character)

	Local cType      := OemToAnsi("CSV|")+'*.CSV' as character

	Default lOpen    := .T.
	Default cFileChg := cGetFile(cType, OemToAnsi(STR0003), 1,, lOpen, GETF_LOCALHARD + GETF_NETWORKDRIVE, .T.)

	If ! Empty(cFileChg)
		If "." $ cFileChg
			cFileChg := Substr(cFileChg,1,rat(".", cFileChg)-1)
		Endif

		cFileChg := alltrim(cFileChg)
		cFile    := Alltrim(cFileChg+Right(cType,4))
	Endif

Return


//-------------------------------------------------------------------
/*/{Protheus.doc} LerCSV
Abrir e ler o arquivo passado por parâmetro e retornar um arrary multidimensional, onde cada elemento
representa uma linha do arquivo e cada elemento possui uma dimensão com os campos

@author Douglas Dourado
@since 13/06/2025
@version 1.0
@parâmetros de entrada
cFileCSV - variavel enviada que conterá o nome do arquivo para leitura dos dados.
@return
aRet - array com as linhas do arquivo lido
/*/
//-------------------------------------------------------------------
Static Function LerCSV(cFileCSV as character ,aCampos as array) as array

	Local cMemo             as character
	Local cBuffer           as character
	Local cBufGet           as character
	Local cChrSepFil        as character
	Local cTarget           as character
	Local cReplace          as character
	Local aLinha            as array
	Local aRet       := {}  as array
	Local nTamArq           as numeric
	Local nBytes            as numeric
	Local nQtdBytes  := 512 as numeric
	Local nBcoHdl           as numeric
	Local nI                as numeric
	Local lArqOK     := .T. as logical

	Default aCampos := {}

	cChrSepFil := ";"
	cTarget    := cChrSepFil+cChrSepFil
	cReplace   := cChrSepFil + Space( 3 ) + cChrSepFil

	If ValidFileImport(cFileCSV,@nBcoHdl)

		nTamArq := FSEEK( nBcoHdl, 0, FS_END )

		FSEEK( nBcoHdl, 0, FS_SET )

		aRet	:= {}
		cBuffer := ""

		While lArqOK .And. nBytes < nTamArq

			FREAD( nBcoHdl, @cBufGet, nQtdBytes ) 
			cBuffer += cBufGet

			//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
			//³ Execute ate encontrar os caracteres de final de linha ³
			//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
			Do While lArqOK .And. ( nI := AT( CHR(13)+CHR(10), cBuffer ) ) > 0

				cMemo := SubStr( cBuffer, 1, nI+1 )

				If !Empty( SubStr( cMemo, 1, Len( cMemo ) - 2 ) )

					Do While AT( cTarget, cMemo ) > 0
						cMemo := StrTran( cMemo, cTarget, cReplace)
					EndDo

					If Len(aRet) == 0         // 1ª linha do arquivo (nomes dos campos)
						cMemo := UPPER(cMemo) // deixar em maiúscula
					EndIf

					aLinha := StrTokArr( StrTran( SubStr( cMemo, 1, Len( cMemo ) - 2 ), cTarget, cReplace), cChrSepFil )

					aAdd( aRet, aLinha )

					If Len(aRet) == 1 .And. Len(aCampos) > 0
						lArqOK := VerCampos(aRet[1],@aCampos)
					Endif

				EndIf

				cBuffer	:= SubStr( cBuffer, nI + 2 )

			EndDo

			nBytes += nQtdBytes
		EndDo
		fClose( nBcoHdl )

	EndIf

If ! lArqOK
	aRet := {}
	MSGStop(STR0009,STR0003)
EndIf

Return aRet

//-------------------------------------------------------------------
/*/{Protheus.doc} VerCampos
Fazer a relação dos campos da CJN com os campos do arquivo que está sendo lido, além de validar se o arquivo
é válido exigindo a existência de 4 campos específicos (códigos e descrição da Classificação Tributária)

@author Douglas Dourado
@since 04/07/2025
@version 1.0
@parâmetros de entrada
aRet - array com os campos na 1ª linha do arquivo
aCampos - campos da CJN e os respectivos campos do arquivo
@return
lRet - Lógico, indicando se o arquivo possui os campos exigidos
/*/
//-------------------------------------------------------------------
Static Function VerCampos(aRet as array, aCampos as array) as logical

Local nX          as numeric
Local lRet := .T. as logical

For nX := 1 To Len (aCampos)
	// Se o campo existe no dicionário
	If aCampos[nX][6]
		aCampos[nX][nElemArq] := aScan( aRet, UPPER(aCampos[nX][2]) )
	EndIf

	lRet := aCampos[nX][nElemArq] > 0 .Or. (! aCampos[nX][4])
	If ! lRet
		Exit
	EndIf
Next

Return lRet

//-------------------------------------------------------------------
/*/{Protheus.doc} ValidCJN
Verifica se o alias recebido existe no dicionário

@author Douglas Dourado
@since 18/06/2025
@version 1.0
@parâmetros de entrada
cAlias - alias da tabela para verificar se existe no dicionário
@return
lRet - Lógico, indicando se realizou o procedimento com sucesso
/*/
//-------------------------------------------------------------------
Function ValidCJN(cAlias as character) as logical

	Local lRet as logical

	lRet := AliasInDic(cAlias)

	If ! lRet
		MSGStop(STR0002,STR0003)
	EndIf

Return lRet

//-------------------------------------------------------------------
/*/{Protheus.doc} ValidFileImport
Verifica se o arquivo recebido pode ser aberto

@author Douglas Dourado
@since 18/06/2025
@version 1.0
@parâmetros de entrada
cArquivo - arquivo texto para ser aberto
nHandle - resultado da abertura do arquivo recebido. Deve ser passado por referência para ser fechado 
          na rotina que solicitou
@return
lRet - Lógico, indicando se realizou o procedimento com sucesso
/*/
//-------------------------------------------------------------------
Function ValidFileImport(cArquivo as character , nHandle as numeric) as logical

	Local lRet as logical

	Default nHandle := -1

	nHandle := FOpen(cArquivo,FO_READ+FO_COMPAT)
	lRet    := (nHandle >= 0)

	If ! lRet
		MSGStop(STR0004,STR0003) // O arquivo está vazio ou não pode ser aberto!
	EndIf

Return lRet
