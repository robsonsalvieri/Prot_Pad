#Include 'Protheus.ch'
#Include 'FWMBrowse.ch'
#Include 'FWMVCDef.ch'
#Include 'MessageGroupHistory.ch'
#Include 'tlpp-core.th'

Namespace totvs.protheus.backoffice.fiscal.configurador.messages.messagegrouphistory

Static cProgram := 'totvs.protheus.backoffice.fiscal.configurador.messages.messagegrouphistory.messageGroupHistory'

/*/{Protheus.doc} messageGroupHistory
Função que cria o cadastro de Histórico de Alterações do Grupo de Mensagens.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 24/04/2025
/*/
Function messageGroupHistory()

    Local oBrowse as object
    Local cFilter as character
    Local aColumns as array
    Local nIndex as numeric

    If ( AliasIndic('CK7') .And. AliasIndic('CK8') .And. AliasIndic('CK9') )
        cFilter := "CK7_FILIAL == '" + FWxFilial('CK7') + "'"
        cFilter	+= " .AND. CK7_CODIGO == '" + CK7->CK7_CODIGO + "'"

        aColumns := {}
        Aadd(aColumns,{STR0003,&("{|| IIf(CK7->CK7_ALTERA == '1','" + STR0004 + "','" + STR0005 + "')}"),"C","",1,1,0,.F.}) // 'Status' 'Alterado' 'Não alterado'
        Aadd(aColumns,{STR0006,&("{|| CK7->CK7_DTALT}"),"D","",1,8,0,.F.}) // 'Data de Alteração'
        Aadd(aColumns,{STR0007,&("{|| CK7->CK7_HRALT}"),"C","",1,8,0,.F.}) // 'Horário de Alteração'

        DbSelectArea('CK7')
        nIndex := CK7->(IndexOrd())

        // Utilizo terceiro índice para facilitar a visualização
        CK7->(DbSetOrder(3)) // CK7_FILIAL+CK7_CODIGO+DTOS(CK7_DTALT)+CK7_HRALT

        oBrowse := FWmBrowse():New()
        oBrowse:SetAlias('CK7')
        oBrowse:SetDescription(STR0001) // 'Histórico de alterações do Grupo de Mensagens'
        oBrowse:SetMenuDef(cProgram)
        oBrowse:DisableDetails()
        oBrowse:ForceQuitButton()
        oBrowse:SetFilterDefault(cFilter)
        oBrowse:SetFields(aColumns)
        oBrowse:Activate()

        CK7->(DbSetOrder(nIndex))
    Else
        Help('',1,'Help','Help',STR0002,1,0) // 'Dicionário desatualizado, verifique as atualizações do motor tributário fiscal.'
    EndIf

Return

/*/{Protheus.doc} menuDef
Função que cria o menu do Histórico de Alterações do Grupo de Mensagens.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 24/04/2025
@return array, Menu do Histórico de Alterações do Grupo de Mensagens.
/*/
Function menuDef() as array

    Local aMenu := {} as array

    ADD OPTION aMenu TITLE STR0008 ACTION 'viewdef.totvs.protheus.backoffice.fiscal.configurador.messages.messagegroup.messageGroup' OPERATION 2 ACCESS 0 // 'Visualizar'

Return aMenu
