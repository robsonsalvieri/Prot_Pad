#Include 'Protheus.ch'
#Include 'FWMBrowse.ch'
#Include 'FWMVCDef.ch'
#Include 'MessageGroup.ch'
#Include 'tlpp-core.th'

Namespace totvs.protheus.backoffice.fiscal.configurador.messages.messagegroup

Static cProgram := 'totvs.protheus.backoffice.fiscal.configurador.messages.messagegroup.messageGroup'

/*/{Protheus.doc} messageGroup
Função que cria o cadastro de Grupos de Mensagens.
@type function
@version 12.1.2410 
@author Juliano Fernandes
@since 24/04/2025
/*/
Function messageGroup()

	Local oBrowse as object

	If ( AliasIndic('CK7') .And. AliasIndic('CK8') .And. AliasIndic('CK9') ) .and. (CK8->(FieldPos("CK8_TIPO")) > 0)
		oBrowse := FWMBrowse():New()
		oBrowse:SetAlias('CK7')
		oBrowse:SetFilterDefault("CK7_ALTERA == '2'")
		oBrowse:SetDescription(STR0001) // 'Cadastro de Grupos de Mensagens'
		oBrowse:Activate()
	Else
		Help('',1,'Help','Help',STR0002,1,0) // 'Dicionário desatualizado, verifique as atualizações do motor tributário fiscal.'
	EndIf

Return

/*/{Protheus.doc} menuDef
Função que cria o menu dos Grupo de Mensagens.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 24/04/2025
@return array, Menu dos Grupos de Mensagens.
/*/
Function menuDef() as array

	Local aMenu := {} as array

	ADD OPTION aMenu TITLE STR0003 ACTION 'VIEWDEF.' + cProgram OPERATION 2 ACCESS 0 // 'Visualizar'
	ADD OPTION aMenu TITLE STR0004 ACTION 'VIEWDEF.' + cProgram OPERATION 3 ACCESS 0 // 'Incluir'
	ADD OPTION aMenu TITLE STR0005 ACTION 'VIEWDEF.' + cProgram OPERATION 4 ACCESS 0 // 'Alterar'
	ADD OPTION aMenu TITLE STR0006 ACTION 'VIEWDEF.' + cProgram OPERATION 5 ACCESS 0 // 'Excluir'
	ADD OPTION aMenu TITLE STR0007 ACTION 'VIEWDEF.' + cProgram OPERATION 9 ACCESS 0 // 'Copiar'
	ADD OPTION aMenu TITLE STR0008 ACTION 'totvs.protheus.backoffice.fiscal.configurador.messages.messagegrouphistory.messageGroupHistory' OPERATION 4 ACCESS 0 // 'Histórico de Alterações'

Return aMenu

/*/{Protheus.doc} modelDef
Função que cria o modelo de dados do cadastro de Grupos de Mensagens.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 24/04/2025
@return object, Modelo de dados do cadastro de Grupos de Mensagens.
/*/
Function modelDef() as object

	Local oModel as object
	Local oMessageGroupStruct as object
	Local oIdentifiersStruct as object
	Local oMessagesStruct as object

	// Cria o objeto do Modelo de Dados
	oModel := MPFormModel():New('MESSAGEGROUP',,,{|oModel| saveMessageGroup(oModel)})

	oMessageGroupStruct := FWFormStruct(1,'CK7')

	// Adiciona ao modelo uma estrutura de formulário de edição por campo
	oModel:AddFields('MESSAGEGROUP',,oMessageGroupStruct)

	oMessagesStruct	:= FWFormStruct(1,'CK9')

	oMessagesStruct:AddField(' ','UP','BT_UP','BT',1,0,{|| moveGridRow('up')},,,.F.,{|| getBitmap('up')},,,.T.,)
	oMessagesStruct:AddField(' ','DOWN','BT_DN','BT',1,0,{|| moveGridRow('down')},,,.F.,{|| getBitmap('down')},,,.T.,)

	oMessagesStruct:SetProperty('CK9_CODFIN',MODEL_FIELD_VALID,{|| validatePurposeCode(oModel)})
	oMessagesStruct:SetProperty('CK9_CODMSG',MODEL_FIELD_VALID,{|| validateMessageCode(oModel)})

	// Adicionando o grid das variações do tributo
	oModel:AddGrid('MESSAGES','MESSAGEGROUP',oMessagesStruct)

	// Define para não repetir a Finalidade e mensagem
	oModel:GetModel('MESSAGES'):SetUniqueLine({'CK9_CODFIN','CK9_CODMSG'})

	// Grid não pode ser vazio
	oModel:GetModel('MESSAGES'):SetOptional(.F.)

	oModel:SetRelation('MESSAGES',{{'CK9_FILIAL','FWxFilial("CK9")'},{'CK9_IDGRUP','CK7_ID'}},CK9->(IndexKey(2)))

	oIdentifiersStruct := FWFormStruct(1,'CK8')

	oIdentifiersStruct:SetProperty('CK8_CODIDE',MODEL_FIELD_VALID,{|| validateIdentifierCode(oModel)})
	oIdentifiersStruct:SetProperty('CK8_TIPO',MODEL_FIELD_VALID,{|| validateType(oModel)})

	// Adicionando o grid das variações do tributo
	oModel:AddGrid('IDENTIFIERS','MESSAGES',oIdentifiersStruct)

	// Define para não repetir o Identificador
	oModel:GetModel('IDENTIFIERS'):SetUniqueLine({'CK8_CODIDE'})

	// Grid não pode ser vazio
	oModel:GetModel('IDENTIFIERS'):SetOptional(.F.)

	oModel:SetRelation('IDENTIFIERS',{{'CK8_FILIAL','FWxFilial("CK8")'},{'CK8_IDGRUP','CK9_IDGRUP'},{'CK8_CODFIN','CK9_CODFIN'},{'CK8_CODMSG','CK9_CODMSG'}},CK8->(IndexKey(1)))

	oModel:SetPrimaryKey({'CK7_FILIAL','CK7_CODIGO','CK7_ALTERA','CK7_ID'})

	// Adiciona a descricao do Modelo de Dados
	oModel:SetDescription(STR0001) // 'Cadastro de Grupos de Mensagens'

Return oModel

/*/{Protheus.doc} viewDef
Função que cria a View do cadastro de Grupos de Mensagens.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 24/04/2025
@return object, View do cadastro de Grupos de Mensagens.
/*/
Function viewDef() as object

	Local oModel := FWLoadModel(cProgram) as object
	Local oView := FWFormView():New() as object
	Local oMessageGroupStruct as object
	Local oIdentifiersStruct as object
	Local oMessagesStruct as object

	// Define qual o Modelo de dados será utilizado
	oView:SetModel(oModel)

	oMessageGroupStruct := FWFormStruct(2,'CK7')

	// Remove campos da View
	oMessageGroupStruct:RemoveField('CK7_ALTERA')
	oMessageGroupStruct:RemoveField('CK7_DTALT')
	oMessageGroupStruct:RemoveField('CK7_HRALT')
	oMessageGroupStruct:RemoveField('CK7_ID')

	oMessageGroupStruct:SetProperty('CK7_CODIGO',MVC_VIEW_TITULO,STR0009) // 'Código do Grupo'
	oMessageGroupStruct:SetProperty('CK7_DESC',MVC_VIEW_TITULO,STR0010) // 'Descrição do Grupo'

	// Adiciona no nosso View um controle do tipo FormFields(antiga enchoice)
	oView:AddField('VIEW_MESSAGEGROUP',oMessageGroupStruct,'MESSAGEGROUP')

	oMessagesStruct := FWFormStruct(2,'CK9')

	// Remove o campo da View
	oMessagesStruct:RemoveField('CK9_IDGRUP')
	oMessagesStruct:RemoveField('CK9_CODIDE')

	oMessagesStruct:AddField('BT_UP','01','','',,'BT',,,,.T.,,,,,,.T.,,)
	oMessagesStruct:AddField('BT_DN','02','','',,'BT',,,,.T.,,,,,,.T.,,)	

	oMessagesStruct:SetProperty('BT_UP',MVC_VIEW_ORDEM,'01')
	oMessagesStruct:SetProperty('BT_DN',MVC_VIEW_ORDEM,'02')
	oMessagesStruct:SetProperty('CK9_SEQUEN',MVC_VIEW_ORDEM,'03')
	oMessagesStruct:SetProperty('CK9_SEQUEN',MVC_VIEW_CANCHANGE,.F.)
	oMessagesStruct:SetProperty('CK9_CODFIN',MVC_VIEW_ORDEM,'04')
	oMessagesStruct:SetProperty('CK9_CODFIN',MVC_VIEW_TITULO,STR0016) // 'Código da Finalidade'
	oMessagesStruct:SetProperty('CK9_DESFIN',MVC_VIEW_ORDEM,'05')
	oMessagesStruct:SetProperty('CK9_DESFIN',MVC_VIEW_TITULO,STR0017) // 'Descrição da Finalidade'
	oMessagesStruct:SetProperty('CK9_CODMSG',MVC_VIEW_ORDEM,'06')
	oMessagesStruct:SetProperty('CK9_CODMSG',MVC_VIEW_TITULO,STR0011) // 'Código da Mensagem'
	oMessagesStruct:SetProperty('CK9_DESMSG',MVC_VIEW_ORDEM,'07')
	oMessagesStruct:SetProperty('CK9_DESMSG',MVC_VIEW_TITULO,STR0012) // 'Descrição da Mensagem'

	oView:AddGrid('VIEW_MESSAGES',oMessagesStruct,'MESSAGES')

	oView:SetFieldAction('BT_UP',{|oView| oView:Refresh('MESSAGES')})
	oView:SetFieldAction('BT_DN',{|oView| oView:Refresh('MESSAGES')})

    //Define campos que terao Auto Incremento
	oView:AddIncrementField('VIEW_MESSAGES','CK9_SEQUEN')

	oIdentifiersStruct := FWFormStruct(2,'CK8')

	// Remove o campo da View
	oIdentifiersStruct:RemoveField('CK8_IDGRUP')
	oIdentifiersStruct:RemoveField('CK8_CODMSG')
	oIdentifiersStruct:RemoveField('CK8_CODFIN')

	oIdentifiersStruct:SetProperty('CK8_CODIDE',MVC_VIEW_ORDEM,'01')
	oIdentifiersStruct:SetProperty('CK8_CODIDE',MVC_VIEW_TITULO,STR0013) // 'Código do Identificador'
	oIdentifiersStruct:SetProperty('CK8_OBRACE',MVC_VIEW_ORDEM,'02')
	oIdentifiersStruct:SetProperty('CK8_FINALI',MVC_VIEW_ORDEM,'03')
	oIdentifiersStruct:SetProperty('CK8_DESIDE',MVC_VIEW_ORDEM,'04')
	oIdentifiersStruct:SetProperty('CK8_DESIDE',MVC_VIEW_TITULO,STR0014) // 'Descrição do Identificador'
	oIdentifiersStruct:SetProperty('CK8_IDIDEN',MVC_VIEW_ORDEM,'05')
	oIdentifiersStruct:SetProperty('CK8_TIPO',MVC_VIEW_ORDEM,'06')

	oView:AddGrid('VIEW_IDENTIFIERS',oIdentifiersStruct,'IDENTIFIERS')

	oView:EnableTitleView('VIEW_MESSAGEGROUP',STR0001) // 'Cadastro de Grupos de Mensagens'
	oView:EnableTitleView('VIEW_MESSAGES',STR0015) // 'Mensagens'
	oView:EnableTitleView('VIEW_IDENTIFIERS',STR0025) // 'Destinos da Mensagem'

	// Desabilitando opção de ordenação
	oView:SetViewProperty('*','ENABLENEWGRID')
	oView:SetViewProperty('*','GRIDNOORDER')

	oView:CreateHorizontalBox('MESSAGEGROUP',20)
	oView:CreateHorizontalBox('MESSAGES',40)
	oView:CreateHorizontalBox('IDENTIFIERS',40)

	oView:SetOwnerView('VIEW_MESSAGEGROUP','MESSAGEGROUP')
	oView:SetOwnerView('VIEW_MESSAGES','MESSAGES')
	oView:SetOwnerView('VIEW_IDENTIFIERS','IDENTIFIERS')

Return oView

/*/{Protheus.doc} saveMessageGroup
Função que salva o Grupos de Mensagens.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 24/04/2025
@param oModel, object, Modelo de dados do cadastro de Grupos de Mensagens.
@return logical, Retorna .T. se o cadastro foi salvo com sucesso
/*/
Static Function saveMessageGroup(oModel as object) as logical

	Local nOperation := oModel:GetOperation() as numeric

	Begin Transaction

		Do Case
			Case nOperation == MODEL_OPERATION_INSERT
				createMessageGroup(oModel)
			Case nOperation == MODEL_OPERATION_UPDATE
				updateMessageGroup(oModel)
			Case nOperation == MODEL_OPERATION_DELETE
				deleteMessageGroup(oModel)
		EndCase

	End Transaction

Return .T.

/*/{Protheus.doc} createMessageGroup
Função que cria o Grupos de Mensagens.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 24/04/2025
@param oModel, object, Modelo de dados do cadastro de Grupos de Mensagens.
/*/
Static Function createMessageGroup(oModel as object)

	Local oIdentifiers as object
	Local oMessages := oModel:GetModel('MESSAGES') as object
	Local cId := oModel:GetValue('MESSAGEGROUP','CK7_ID') as character
	Local nI as numeric
	Local nJ as numeric

	CK7->(Reclock('CK7',.T.))

	CK7->CK7_FILIAL := FWxFilial('CK7')
	CK7->CK7_ID := cId
	CK7->CK7_CODIGO := oModel:GetValue('MESSAGEGROUP','CK7_CODIGO')
	CK7->CK7_DESC := oModel:GetValue('MESSAGEGROUP','CK7_DESC')
	CK7->CK7_ALTERA := '2' // Indica que não sofreu alterações

	CK7->(MsUnlock())

	For nI := 1 To oMessages:Length()
		oMessages:GoLine(nI)

		If ( !oMessages:IsDeleted() )
			CK9->(Reclock('CK9',.T.))

			CK9->CK9_FILIAL := FWxFilial('CK9')
			CK9->CK9_SEQUEN := oMessages:GetValue('CK9_SEQUEN')
			CK9->CK9_IDGRUP := cId
			CK9->CK9_CODFIN := oMessages:GetValue('CK9_CODFIN')
			CK9->CK9_CODMSG := oMessages:GetValue('CK9_CODMSG')

			CK9->(MsUnlock())

			oIdentifiers := oModel:GetModel('IDENTIFIERS')

			For nJ := 1 To oIdentifiers:Length()
				oIdentifiers:GoLine(nJ)

				If ( !oIdentifiers:IsDeleted() )
					CK8->(Reclock('CK8',.T.))

					CK8->CK8_FILIAL := FWxFilial('CK8')
					CK8->CK8_IDGRUP := cId
					CK8->CK8_CODIDE := oIdentifiers:GetValue('CK8_CODIDE')
					CK8->CK8_TIPO := oIdentifiers:GetValue('CK8_TIPO')
					CK8->CK8_CODMSG := oIdentifiers:GetValue('CK8_CODMSG')
					CK8->CK8_CODFIN := oIdentifiers:GetValue('CK8_CODFIN')

					CK8->(MsUnlock())
				EndIf
			Next nJ
		EndIf
	Next nI

Return

/*/{Protheus.doc} updateMessageGroup
Função que atualiza o Grupos de Mensagens.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 24/04/2025
@param oModel, object, Modelo de dados do cadastro de Grupos de Mensagens.
/*/
Static Function updateMessageGroup(oModel as object)

	Local cId as character
	Local oIdentifiers as object
	Local oMessages as object
	Local nI as numeric
	Local nJ as numeric

	CK7->(Reclock('CK7',.F.))

	CK7->CK7_ALTERA := "1" // Indica que sofreu alterações
	CK7->CK7_DTALT := Date()
	CK7->CK7_HRALT := Time()

	CK7->(MsUnlock())

	cId := FWUUIDV4(.T.)
	oModel:SetValue('MESSAGEGROUP','CK7_ID',cId)

	oMessages := oModel:GetModel('MESSAGES')

	For nI := 1 To oMessages:Length()
		oMessages:GoLine(nI)

		If ( !oMessages:IsDeleted() )
			oMessages:SetValue('CK9_IDGRUP',cId)

			oIdentifiers := oModel:GetModel('IDENTIFIERS')

			For nJ := 1 To oIdentifiers:Length()
				oIdentifiers:GoLine(nJ)

				If ( !oIdentifiers:IsDeleted() )
					oIdentifiers:SetValue('CK8_IDGRUP',cId)
				EndIf
			Next nJ
		EndIf
	Next nI

	createMessageGroup(oModel)

Return

/*/{Protheus.doc} deleteMessageGroup
Função que exclui o Grupos de Mensagens.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 24/04/2025
@param oModel, object, Modelo de dados do cadastro de Grupos de Mensagens.
/*/
Static Function deleteMessageGroup(oModel as object)

	Local cId := oModel:GetValue('MESSAGEGROUP','CK7_ID') as character

	DbSelectArea('CK8')
	CK8->(DbSetOrder(1)) // CK8_FILIAL+CK8_IDGRUP+CK8_CODIDE+CK8_CODFIN+CK8_CODMSG
	While ( CK8->(MSSeek(FWxFilial('CK8') + cId)) )
		CK8->(Reclock('CK8',.F.))

		CK8->(DbDelete())

		CK8->(MsUnlock())
	EndDo

	DbSelectArea('CK9')
	CK9->(DbSetOrder(1)) // CK9_FILIAL+CK9_IDGRUP+CK9_CODIDE+CK9_CODFIN+CK9_CODMSG
	While ( CK9->(MSSeek(FWxFilial('CK9') + cId)) )
		CK9->(Reclock('CK9',.F.))

		CK9->(DbDelete())

		CK9->(MsUnlock())
	EndDo

	DbSelectArea('CK7')
	CK7->(DbSetOrder(2)) // CK7_FILIAL+CK7_ID
	If ( CK7->(MSSeek(FWxFilial('CK7') + cId)) )
		CK7->(Reclock('CK7',.F.))

		CK7->(DbDelete())

		CK7->(MsUnlock())
	EndIf

Return

/*/{Protheus.doc} validatePurposeCode
Função que valida o código da Finalidade.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 14/05/2025
@param oModel, object, Modelo de dados do cadastro de Grupos de Mensagens.
@return logical, Retorna .T. se o código da Finalidade for válido
/*/
Static Function validatePurposeCode(oModel as object) as logical

	Local oMessages := oModel:GetModel('MESSAGES') as object
	Local oIdentifiers := oModel:GetModel('IDENTIFIERS') as object
	Local cCode := oMessages:GetValue('CK9_CODFIN') as character
	Local cDescription := GetPurposeDescription(cCode) as character
	Local lValid := !Empty(cDescription) as logical
	Local nI as numeric

	If ( lValid )
		oMessages:SetValue('CK9_DESFIN',cDescription)

		For nI := 1 To oIdentifiers:Length()
			oIdentifiers:GoLine(nI)
			oIdentifiers:SetValue('CK8_CODFIN',cCode)
		Next nI
	EndIf

Return lValid

/*/{Protheus.doc} validateMessageCode
Função que valida o código da Mensagem.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 24/04/2025
@param oModel, object, Modelo de dados do cadastro de Grupos de Mensagens.
@return logical, Retorna .T. se o código da Mensagem for válido
/*/
Static Function validateMessageCode(oModel as object) as logical

	Local oMessages := oModel:GetModel('MESSAGES') as object
	Local oIdentifiers := oModel:GetModel('IDENTIFIERS') as object
	Local cCode := oMessages:GetValue('CK9_CODMSG') as character
	Local cDescription as character
	Local lValid := ExistCpo('CJ8',cCode,1) as logical
	Local nI as numeric

	If ( lValid )
		cDescription := Posicione('CJ8',1,FWxFilial('CJ8') + cCode,'CJ8_DESC')
		oMessages:SetValue('CK9_DESMSG',cDescription)

		For nI := 1 To oIdentifiers:Length()
			oIdentifiers:GoLine(nI)
			oIdentifiers:SetValue('CK8_CODMSG',cCode)
		Next nI
	EndIf

Return lValid

/*/{Protheus.doc} validateIdentifierCode
Função que valida o código do Identificador de Mensagem.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 24/04/2025
@param oModel, object, Modelo de dados do cadastro de Grupos de Mensagens.
@return logical, Retorna .T. se o código do Identificador de Mensagem for válido
/*/
Static Function validateIdentifierCode(oModel as object) as logical

	Local oIdentifiers := oModel:GetModel('IDENTIFIERS') as object
	Local cCode := oIdentifiers:GetValue('CK8_CODIDE') as character
	Local aCK6 := {} as array
	Local lValid := .T. as logical

	If ( !validatePurposeCode(oModel) .Or. !validateMessageCode(oModel) )
		lValid := .F.
		Help('',1,'Help','Help',STR0026,1,0) // 'Os dados da mensagem não foram informados.'
	EndIf

	If ( lValid )
		lValid := ExistCpo('CK6',cCode,1)
	EndIf

	If ( lValid )
		aCK6 := GetAdvFVal('CK6',{'CK6_DESC','CK6_OBRACE','CK6_FINALI','CK6_ID'},FWxFilial('CK6') + cCode,1)

		If ( Len(aCK6) > 0 )
			oIdentifiers:SetValue('CK8_DESIDE',aCK6[1])
			oIdentifiers:SetValue('CK8_OBRACE',aCK6[2])
			oIdentifiers:SetValue('CK8_FINALI',aCK6[3])
			oIdentifiers:SetValue('CK8_IDIDEN',aCK6[4])
			oIdentifiers:SetValue('CK8_CODMSG',FWFldGet("CK9_CODMSG"))
			oIdentifiers:SetValue('CK8_CODFIN',FWFldGet("CK9_CODFIN"))
		EndIf

		ASize(aCK6, 0)
		aCK6 := Nil
	EndIf

Return lValid

/*/{Protheus.doc} validateType
Função que valida o tipo do Identificador de Mensagem.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 16/07/2025
@param oModel, object, Modelo de dados do cadastro de Grupos de Mensagens.
@return logical, Retorna .T. se o tipo do Identificador de Mensagem for válido
/*/
Static Function validateType(oModel as object) as logical

	Local oIdentifiers := oModel:GetModel('IDENTIFIERS') as object
	Local cCode := oIdentifiers:GetValue('CK8_CODIDE') as character
	Local lValid := !Empty(cCode) as logical

	If ( !lValid )
		Help('',1,'Help','Help',STR0027,1,0) // 'O código do identificador não foi informado.'
	EndIf

Return lValid

/*/{Protheus.doc} purposeComboBoxOptions
Função que retorna as opções de Finalidade para o ComboBox.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 14/05/2025
@return character, Opções de Finalidade para o ComboBox
/*/
Function purposeComboBoxOptions() as character

	Local nI as numeric
	Local cOptions as character
	Local aOptions := getPurposeOptions() as array

	For nI := 1 To Len(aOptions)
		If ( !Empty(cOptions) )
			cOptions += ';'
		EndIf
		
		cOptions += aOptions[nI][1] + '=' + aOptions[nI][2]
	Next nI

Return cOptions

/*/{Protheus.doc} getPurposeOptions
Função que retorna as opções de Finalidade.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 14/05/2025
@return array, Opções de Finalidade
/*/
Static Function getPurposeOptions() as array

	Local aOptions := {} as array

	Aadd(aOptions,{'1',STR0019}) // 'Normal'
	Aadd(aOptions,{'2',STR0020}) // 'Devolução'
	Aadd(aOptions,{'3',STR0021}) // 'Beneficiamento'
	Aadd(aOptions,{'4',STR0022}) // 'Complemento ICMS'
	Aadd(aOptions,{'5',STR0023}) // 'Complemento IPI'
	Aadd(aOptions,{'6',STR0024}) // 'Complemento Preço'

Return aOptions

/*/{Protheus.doc} getPurposeDescription
Função que retorna a descrição da Finalidade.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 14/05/2025
@param cPurposeCode, character, Código da Finalidade
@return character, Descrição da Finalidade
/*/
Function getPurposeDescription(cPurposeCode as character) as character

	Local aOptions := getPurposeOptions() as array
	Local nPos as numeric
	Local cCode := AllTrim(cPurposeCode) as character
	Local cDescription as character

	nPos := AScan(aOptions,{|x| x[1] == cCode})

	If ( nPos > 0 )
		cDescription := aOptions[nPos][2]
	EndIf

Return cDescription

/*/{Protheus.doc} moveGridRow
Função responsável por trocar a linha do grid.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 26/06/2025
@param cDirection, character, Direção da troca de linha (up ou down)
@return logical, Retorna .T. se a troca de linha foi realizada com sucesso
/*/
Static Function moveGridRow(cDirection as character) as logical

	Local oModel := FwModelActive() as object
	Local oGrid := oModel:GetModel('MESSAGES') as object
	Local nLine := oGrid:GetLine() as numeric
	Local nTam := oGrid:Length() as numeric
	Local aRows := {} as array
	Local cOrd1 as character
	Local cOrd2 as character
	Local nTo as numeric

	// Se for para cima e a linha for maior que 1
	If ( cDirection == 'up' .And. nLine > 1 )
		nTo := nLine-1
	// Se for para baixo e nao for a ultima linha
	ElseIf ( cDirection == 'down' .And. nLine < nTam )
		nTo := nLine+1
	EndIf

	If ( nTo != 0 )
		aRows := FwSaveRows()

		cOrd1 := oGrid:GetValue('CK9_SEQUEN',nTo)
		cOrd2 := oGrid:GetValue('CK9_SEQUEN',nLine)

		oGrid:LineShift(nLine,nTo)

		oGrid:GoLine(nTo)
		oGrid:LoadValue('CK9_SEQUEN',cOrd1)
		oGrid:GoLine(nLine)
		oGrid:LoadValue('CK9_SEQUEN',cOrd2)

		FwRestRows(aRows)
	EndIf

	ASize(aRows,0)
	aRows := Nil

Return .T.

/*/{Protheus.doc} getBitmap
Função responsável por retornar o bitmap das setas.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 26/06/2025
@param cDirection, character, Opção da seta (up ou down)
@return character, Retorna o nome do bitmap da seta correspondente
/*/
Static Function getBitmap(cDirection as character) as character

	Local cBitmap := 'TriUp' as character

	If ( cDirection == 'down' )
		cBitmap := 'TriDown'
	EndIf

Return cBitmap
