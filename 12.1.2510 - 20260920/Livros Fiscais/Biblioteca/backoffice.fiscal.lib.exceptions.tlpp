#include 'tlpp-core.th'

#define HTTP_CODE_BAD_REQUEST 400 // (Bad Request): Requisição inválida ou malformada.
#define HTTP_CODE_NOT_FOUND 404 // (Not Found): Recurso não encontrado.

namespace totvs.protheus.backoffice.fiscal.lib

/*/{Protheus.doc} FisExceptions
Classe para tratamento de exceções específicas do módulo fiscal.
@type class
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
/*/
class FisExceptions

    private data oException as object

    public method new() constructor

    public method badRequestException(cMessage as character) as object
    
    public method notFoundException(cMessage as character) as object

    public method destroy()

endclass

/*/{Protheus.doc} FisExceptions::new
Método construtor da classe FisExceptions.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
@return object, Instância da classe FisExceptions
/*/
method new() class FisExceptions
return self

/*/{Protheus.doc} FisExceptions::badRequestException
Método para criar uma exceção de requisição inválida (400).
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
@param cMessage, character, Mensagem da exceção
@return object, Instância da classe ErrorClass com os dados da exceção
/*/
method badRequestException(cMessage as character) as object class FisExceptions

    default cMessage := ''

    self:oException := ErrorClass():new()
    self:oException:genCode := HTTP_CODE_BAD_REQUEST
    self:oException:description := cMessage

return self:oException

/*/{Protheus.doc} FisExceptions::notFoundException
Método para criar uma exceção de recurso não encontrado (404).
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
@param cMessage, character, Mensagem da exceção
@return object, Instância da classe ErrorClass com os dados da exceção
/*/
method notFoundException(cMessage as character) as object class FisExceptions

    default cMessage := ''

    self:oException := ErrorClass():new()
    self:oException:genCode := HTTP_CODE_NOT_FOUND
    self:oException:description := cMessage

return self:oException

/*/{Protheus.doc} FisExceptions::destroy
Método destrutor da classe FisExceptions.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
/*/
method destroy() class FisExceptions

    if ( valType(self:oException) == 'O' )
        fwFreeObj(self:oException)
    endif

return
