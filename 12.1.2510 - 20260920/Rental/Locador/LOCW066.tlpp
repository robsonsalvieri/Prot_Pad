#include "tlpp-core.th"
#include "totvs.ch"
#include "fileio.ch"

Namespace sigaloc.api.checklist

//-------------------------------------------------------------------
// GET /api/v1/checklist
// Descricao: Retorna a lista de Checklists (FQC), filtrando de forma
// opcional por codigo do checklist, projeto e/ou obra. Pelo menos um
// dos tres filtros deve ser informado.
//-------------------------------------------------------------------
/*/{Protheus.doc} LOCW066List
API que retorna a lista de Checklists (tabela FQC), filtrando de forma
opcional por codigo do checklist (codigoCheckList), projeto e/ou obra.
Pelo menos um dos tres filtros deve ser informado.
@type function
@author ITUP
@since 01/09/2026
@return lRet, logical, Sempre .T. - resposta HTTP tratada via oRest
/*/
@Get("/api/v1/checklist")
Function LOCW066() as Logical
Local jQuery      := oRest:getQueryRequest() as Json
Local jResp       := JsonObject():New() as Json
Local jData       := JsonObject():New() as Json
Local jItems      := {} as Array
Local cCodChe     := "" as Character
Local cProjeto    := "" as Character
Local cObra       := "" as Character
Local cWhere      := "" as Character
Local cQuery      := "" as Character
Local aBindParam  := {} as Array
Local cFonte      := "LOCW066.TLPP" as Character
Local aInfo       := {} as Array

	oRest:setKeyHeaderResponse("Content-Type", "application/json")

	aInfo := GetApoInfo(cFonte)

	If jQuery <> Nil
		If jQuery["codigoCheckList"] <> Nil
			cCodChe := AllTrim(cValToChar(jQuery["codigoCheckList"]))
		EndIf
		If jQuery["projeto"] <> Nil
			cProjeto := AllTrim(cValToChar(jQuery["projeto"]))
		EndIf
		If jQuery["obra"] <> Nil
			cObra := AllTrim(cValToChar(jQuery["obra"]))
		EndIf
	EndIf

	If Empty(cCodChe) .And. Empty(cProjeto) .And. Empty(cObra)
		Return oRest:setStatusResponse(400, LOCW066Err(400, "VALIDATION_ERROR", "Informe ao menos um filtro: codigoCheckList, projeto ou obra", aInfo))
	EndIf

	Try
		cWhere := "WHERE FQC.D_E_L_E_T_ = ' ' "
		cWhere += "AND FQC_FILIAL = '" + FWxFilial("FQC") + "' "

		If !Empty(cCodChe)
			cWhere += "AND FQC_CODCHE = ? "
			aAdd(aBindParam, PadR(cCodChe, TamSX3("FQC_CODCHE")[1]))
		EndIf

		If !Empty(cProjeto)
			cWhere += "AND FQC_PROJET = ? "
			aAdd(aBindParam, cProjeto)
		EndIf

		If !Empty(cObra)
			cWhere += "AND FQC_OBRA = ? "
			aAdd(aBindParam, cObra)
		EndIf

		cQuery := "SELECT FQC_CODCHE, FQC_CODBEM, FQC_PLACA, FQC_CODFOR, FQC_DESFOR, FQC_STATUS, "
		cQuery += "FQC_NOMCLI, FQC_PROJET, FQC_OBRA, FQC_DTINI, FQC_HRINI, FQC_DTFIM, FQC_HRFIM "
		cQuery += "FROM " + RetSqlName("FQC") + " FQC " + cWhere
		cQuery += "ORDER BY FQC_CODCHE "
		cQuery := ChangeQuery(cQuery)
		MPSysOpenQuery(cQuery, "TRB066D", , , aBindParam)

		TRB066D->(DbGoTop())
		While !TRB066D->(Eof())
			aAdd(jItems, LOCW066ListItem())
			TRB066D->(DbSkip())
		EndDo

		TRB066D->(DbCloseArea())

		jData["items"] := jItems

		jResp["status"]    := 200
		jResp["message"]   := "Recurso encontrado"
		jResp["data"]      := jData
	Catch oError
		FWLogMsg("ERROR", , "REST", "LOCW066List", , "01", oError:Description, 0, 0, {})
		Return oRest:setStatusResponse(500, LOCW066Err(500, "INTERNAL_ERROR", "Erro interno ao processar a listagem de checklists", aInfo))
	EndTry

Return oRest:setStatusResponse(200, jResp:toJson())

//-------------------------------------------------------------------
// GET /api/v1/checklist/:codche
// Descricao: Retorna o cabecalho do Checklist (FQC) e a lista de
// documentos do Banco de Conhecimento vinculados a esse registro.
// Aceita projeto e obra como filtros opcionais (query string): se
// informados, o checklist encontrado precisa bater com eles, senao
// retorna 404.
//-------------------------------------------------------------------
/*/{Protheus.doc} LOCW066Get
API que le o cabecalho do Checklist (tabela FQC) a partir do codigo
informado e retorna, junto dos dados do cabecalho, a lista de documentos
anexados no Banco de Conhecimento (AC9/ACB) vinculados a esse registro.
Aceita projeto e obra como filtros opcionais (query string) para
validar o checklist encontrado.
@type function
@author ITUP
@since 01/09/2026
@return lRet, logical, Sempre .T. - resposta HTTP tratada via oRest
/*/
@Get("/api/v1/checklist/:codche")
Function LOCW066Get() as Logical
Local jParams   := oRest:getPathParamsRequest() as Json
Local jQuery    := oRest:getQueryRequest() as Json
Local cCodChe   := "" as Character
Local cProjeto  := "" as Character
Local cObra     := "" as Character
Local jResp     := JsonObject():New() as Json
Local jData     := JsonObject():New() as Json
Local jDocs     := {} as Array
Local aAC9      := {} as Array
Local nI        := 0 as Numeric
Local cFonte    := "LOCW066.TLPP" as Character
Local aInfo     := {} as Array

	oRest:setKeyHeaderResponse("Content-Type", "application/json")

	aInfo   := GetApoInfo(cFonte)
	cCodChe := AllTrim(cValToChar(jParams["codche"]))

	If jQuery <> Nil
		If jQuery["projeto"] <> Nil
			cProjeto := AllTrim(cValToChar(jQuery["projeto"]))
		EndIf
		If jQuery["obra"] <> Nil
			cObra := AllTrim(cValToChar(jQuery["obra"]))
		EndIf
	EndIf

	If Empty(cCodChe)
		Return oRest:setStatusResponse(400, LOCW066Err(400, "VALIDATION_ERROR", "Codigo do checklist e obrigatorio", aInfo))
	EndIf

	cCodChe := PadR(cCodChe, TamSX3("FQC_CODCHE")[1])

	Try
		DbSelectArea("FQC")
		FQC->(DbSetOrder(1)) // FQC_FILIAL+FQC_CODCHE

		If !FQC->(DbSeek(FWxFilial("FQC") + cCodChe))
			Return oRest:setStatusResponse(404, LOCW066Err(404, "CHECKLIST_NOT_FOUND", "Checklist nao encontrado", aInfo))
		EndIf

		If !Empty(cProjeto) .And. AllTrim(FQC->FQC_PROJET) != cProjeto
			Return oRest:setStatusResponse(404, LOCW066Err(404, "CHECKLIST_NOT_FOUND", "Checklist nao encontrado para o projeto informado", aInfo))
		EndIf

		If !Empty(cObra) .And. AllTrim(FQC->FQC_OBRA) != cObra
			Return oRest:setStatusResponse(404, LOCW066Err(404, "CHECKLIST_NOT_FOUND", "Checklist nao encontrado para a obra informada", aInfo))
		EndIf

		jData["codigoCheckList"]     := AllTrim(FQC->FQC_CODCHE)
		jData["codigoBem"]           := AllTrim(FQC->FQC_CODBEM)
		jData["filialBem"]           := AllTrim(FQC->FQC_FILBEM)
		jData["placa"]               := AllTrim(FQC->FQC_PLACA)
		jData["codigoFormulario"]    := AllTrim(FQC->FQC_CODFOR)
		jData["descricaoFormulario"] := AllTrim(FQC->FQC_DESFOR)
		jData["sequencia"]           := AllTrim(FQC->FQC_SEQ)
		jData["status"]              := AllTrim(FQC->FQC_STATUS)
		jData["contador"]            := FQC->FQC_POSCON
		jData["modelo"]              := AllTrim(FQC->FQC_MODELO)
		jData["codigoCliente"]       := AllTrim(FQC->FQC_CODCLI)
		jData["lojaCliente"]         := AllTrim(FQC->FQC_LOJCLI)
		jData["nomeCliente"]         := AllTrim(FQC->FQC_NOMCLI)
		jData["projeto"]             := AllTrim(FQC->FQC_PROJET)
		jData["obra"]                := AllTrim(FQC->FQC_OBRA)
		jData["numeroAS"]            := AllTrim(FQC->FQC_AS)
		jData["estado"]              := AllTrim(FQC->FQC_ESTADO)
		jData["cidade"]              := AllTrim(FQC->FQC_CIDADE)
		jData["dataInicio"]          := DtoS(FQC->FQC_DTINI)
		jData["horaInicio"]          := AllTrim(FQC->FQC_HRINI)
		jData["dataFim"]             := DtoS(FQC->FQC_DTFIM)
		jData["horaFim"]             := AllTrim(FQC->FQC_HRFIM)
		jData["observacao"]          := AllTrim(FQC->FQC_OBS)

		aAC9 := LOCW066AC9(cCodChe)

		For nI := 1 To Len(aAC9)
			aAdd(jDocs, LOCW066DocJson(aAC9[nI][1], aAC9[nI][2], aAC9[nI][3]))
		Next nI

		jData["documentos"] := jDocs

		jResp["status"]     := 200
		jResp["message"]    := "Recurso encontrado"
		jResp["data"]       := jData
	Catch oError
		FWLogMsg("ERROR", , "REST", "LOCW066Get", , "01", oError:Description, 0, 0, {})
		Return oRest:setStatusResponse(500, LOCW066Err(500, "INTERNAL_ERROR", "Erro interno ao processar o checklist", aInfo))
	EndTry

Return oRest:setStatusResponse(200, jResp:toJson())

//-------------------------------------------------------------------
// GET /api/v1/checklist/:codche/documento/:codobj
// Descricao: Retorna o conteudo (base64) de um documento do Banco de
// Conhecimento vinculado ao cabecalho do Checklist informado. O
// documento pode ser um PDF, um TXT ou qualquer outro tipo de arquivo
// anexado ao registro.
//-------------------------------------------------------------------
/*/{Protheus.doc} LOCW066Doc
API que retorna o conteudo binario, codificado em base64, de um
documento especifico do Banco de Conhecimento (AC9/ACB) vinculado ao
cabecalho do Checklist informado - por exemplo o PDF (ou TXT) gerado
para o checklist.
@type function
@author ITUP
@since 01/09/2026
@return lRet, logical, Sempre .T. - resposta HTTP tratada via oRest
/*/
@Get("/api/v1/checklist/:codche/documento/:codobj")
Function LOCW066Doc() as Logical
Local jParams    := oRest:getPathParamsRequest() as Json
Local cCodChe    := "" as Character
Local cCodObj    := "" as Character
Local jResp      := JsonObject():New() as Json
Local jData      := JsonObject():New() as Json
Local cNomeArq   := "" as Character
Local cDescArq   := "" as Character
Local cTamanho   := "" as Character
Local cConteudo  := "" as Character
Local cFonte     := "LOCW066.TLPP" as Character
Local aInfo      := {} as Array

	oRest:setKeyHeaderResponse("Content-Type", "application/json")

	aInfo   := GetApoInfo(cFonte)
	cCodChe := AllTrim(cValToChar(jParams["codche"]))
	cCodObj := AllTrim(cValToChar(jParams["codobj"]))

	If Empty(cCodChe) .Or. Empty(cCodObj)
		Return oRest:setStatusResponse(400, LOCW066Err(400, "VALIDATION_ERROR", "Codigo do checklist e codigo do objeto sao obrigatorios", aInfo))
	EndIf

	cCodChe := PadR(cCodChe, TamSX3("FQC_CODCHE")[1])
	cCodObj := PadR(cCodObj, TamSX3("ACB_CODOBJ")[1])

	Try
		DbSelectArea("FQC")
		FQC->(DbSetOrder(1)) // FQC_FILIAL+FQC_CODCHE

		If !FQC->(DbSeek(FWxFilial("FQC") + cCodChe))
			Return oRest:setStatusResponse(404, LOCW066Err(404, "CHECKLIST_NOT_FOUND", "Checklist nao encontrado", aInfo))
		EndIf

		// Valida a posse do documento reproduzindo exatamente o padrao gravado
		// pela rotina de origem do Banco de Conhecimento do Checklist
		// (LOCW002.PRW / xGAppConhec) - ver LOCW066Pertence
		If !LOCW066Pertence(cCodChe, cCodObj)
			Return oRest:setStatusResponse(404, LOCW066Err(404, "DOCUMENT_NOT_FOUND", "Documento nao localizado para este checklist", aInfo))
		EndIf

		DbSelectArea("ACB")
		ACB->(DbSetOrder(1)) // ACB_FILIAL+ACB_CODOBJ

		If !ACB->(DbSeek(FWxFilial("ACB") + cCodObj))
			Return oRest:setStatusResponse(404, LOCW066Err(404, "OBJECT_NOT_FOUND", "Objeto nao localizado no Banco de Conhecimento", aInfo))
		EndIf

		cNomeArq := AllTrim(ACB->ACB_OBJETO)
		cDescArq := AllTrim(ACB->ACB_DESCRI)
		cTamanho := AllTrim(ACB->ACB_TAMANH)

		cConteudo := LOCW066Ler(cNomeArq)

		If Empty(cConteudo)
			Return oRest:setStatusResponse(500, LOCW066Err(500, "FILE_NOT_FOUND", "Arquivo fisico do documento nao localizado no storage", aInfo))
		EndIf

		jData["codigoCheckList"] := cCodChe
		jData["codigoObjeto"]    := cCodObj
		jData["nomeArquivo"]     := cNomeArq
		jData["descricao"]       := cDescArq
		jData["extensao"]        := Lower(LOCW066Ext(cNomeArq))
		jData["mimeType"]        := LOCW066Mime(cNomeArq)
		jData["tamanho"]         := cTamanho
		jData["conteudoBase64"]  := cConteudo

		jResp["status"]     := 200
		jResp["message"]    := "Recurso encontrado"
		jResp["data"]       := jData
	Catch oError
		FWLogMsg("ERROR", , "REST", "LOCW066Doc", , "01", oError:Description, 0, 0, {})
		Return oRest:setStatusResponse(500, LOCW066Err(500, "INTERNAL_ERROR", "Erro interno ao processar o documento", aInfo))
	EndTry

Return oRest:setStatusResponse(200, jResp:toJson())

//-------------------------------------------------------------------
// Funcoes auxiliares (Static) - uso exclusivo deste fonte
//-------------------------------------------------------------------

/*/{Protheus.doc} LOCW066ListItem
Monta o objeto Json de um item da listagem de Checklists a partir do
registro corrente do alias de consulta TRB066D (LOCW066List).
@type function
@author ITUP
@since 01/09/2026
@return jItem, json, Objeto Json com o resumo do Checklist
/*/
Static Function LOCW066ListItem() as Json
Local jItem := JsonObject():New() as Json

	jItem["codigoCheckList"]     := AllTrim(TRB066D->FQC_CODCHE)
	jItem["codigoBem"]           := AllTrim(TRB066D->FQC_CODBEM)
	jItem["placa"]               := AllTrim(TRB066D->FQC_PLACA)
	jItem["codigoFormulario"]    := AllTrim(TRB066D->FQC_CODFOR)
	jItem["descricaoFormulario"] := AllTrim(TRB066D->FQC_DESFOR)
	jItem["status"]              := AllTrim(TRB066D->FQC_STATUS)
	jItem["nomeCliente"]         := AllTrim(TRB066D->FQC_NOMCLI)
	jItem["projeto"]             := AllTrim(TRB066D->FQC_PROJET)
	jItem["obra"]                := AllTrim(TRB066D->FQC_OBRA)
	jItem["dataInicio"]          := DtoS(TRB066D->FQC_DTINI)
	jItem["horaInicio"]          := AllTrim(TRB066D->FQC_HRINI)
	jItem["dataFim"]             := DtoS(TRB066D->FQC_DTFIM)
	jItem["horaFim"]             := AllTrim(TRB066D->FQC_HRFIM)

Return jItem

/*/{Protheus.doc} LOCW066AC9
Localiza, no Banco de Conhecimento (AC9/ACB), os documentos vinculados
ao cabecalho do Checklist (entidade FQC) informado.
Espelha exatamente xGAppConhec (LOCW002.PRW:826-828): AC9_FILENT usa
FWxFilial(cTab), mas o prefixo dentro de AC9_CODENT usa xFilial("FPX")
(sem o wrapper FW) - independente do cTab recebido - por isso as duas
chamadas nao sao a mesma funcao, isso e proposital (mesmo padrao usado
em LOCR043.PRW para o AC9 da entidade FPX). AC9_CODENT nao tem
necessariamente a mesma largura do codigo do checklist (e um campo
generico do Banco de Conhecimento, usado por varias entidades) - por
isso a comparacao do loop usa prefixo (Left) em vez de igualdade exata
do valor inteiro do campo, que falharia sempre que sobrar espaco em
branco (padding) alem do prefixo montado aqui.
@type function
@author ITUP
@since 01/09/2026
@param cCodChe, character, Codigo do Checklist (FQC_CODCHE)
@return aDocs, array, Array de arrays {codigoObjeto, nomeArquivo, descricao}
/*/
Static Function LOCW066AC9(cCodChe as Character) as Array
Local aDocs      := {} as Array
Local cChaveEnt  := "FQC" + FWxFilial("FQC") as Character
Local cCodEntPre := xFilial("FPX") + AllTrim(cCodChe) as Character
Local aAreaAC9   := AC9->(GetArea()) as Array
Local aAreaACB   := ACB->(GetArea()) as Array

	DbSelectArea("AC9")
	AC9->(DbSetOrder(2)) // AC9_FILIAL+AC9_ENTIDA+AC9_FILENT+AC9_CODENT+AC9_CODOBJ

	If AC9->(DbSeek(FWxFilial("AC9") + cChaveEnt + cCodEntPre))
		While !AC9->(Eof()) .And. AC9->(AC9_FILIAL+AC9_ENTIDA+AC9_FILENT) == (FWxFilial("AC9") + cChaveEnt) ;
				.And. Left(AllTrim(AC9->AC9_CODENT), Len(cCodEntPre)) == cCodEntPre
			DbSelectArea("ACB")
			ACB->(DbSetOrder(1)) // ACB_FILIAL+ACB_CODOBJ
			If ACB->(DbSeek(FWxFilial("ACB") + AC9->AC9_CODOBJ))
				aAdd(aDocs, {AllTrim(AC9->AC9_CODOBJ), AllTrim(ACB->ACB_OBJETO), AllTrim(ACB->ACB_DESCRI)})
			EndIf
			DbSelectArea("AC9")
			AC9->(DbSkip())
		EndDo
	EndIf

	AC9->(RestArea(aAreaAC9))
	ACB->(RestArea(aAreaACB))

Return aDocs

/*/{Protheus.doc} LOCW066Pertence
Confirma se o objeto do Banco de Conhecimento informado (ACB_CODOBJ)
esta de fato vinculado ao cabecalho do Checklist informado (entidade
FQC), reproduzindo a mesma chave gravada por xGAppConhec (ver
LOCW066AC9). Usada pelo endpoint de download do documento para nao
liberar um objeto que pertenca a outro checklist/entidade.
@type function
@author ITUP
@since 01/09/2026
@param cCodChe, character, Codigo do Checklist (FQC_CODCHE)
@param cCodObj, character, Codigo do objeto no Banco de Conhecimento (ACB_CODOBJ)
@return lRet, logical, .T. se o objeto pertence a este checklist
/*/
Static Function LOCW066Pertence(cCodChe as Character, cCodObj as Character) as Logical
Local lRet        := .F. as Logical
Local cChaveEnt   := "FQC" + FWxFilial("FQC") as Character
Local cCodEntPre  := xFilial("FPX") + AllTrim(cCodChe) as Character
Local cCodObjTrim := AllTrim(cCodObj) as Character
Local aAreaAC9    := AC9->(GetArea()) as Array

	DbSelectArea("AC9")
	AC9->(DbSetOrder(2)) // AC9_FILIAL+AC9_ENTIDA+AC9_FILENT+AC9_CODENT+AC9_CODOBJ

	If AC9->(DbSeek(FWxFilial("AC9") + cChaveEnt + cCodEntPre))
		While !lRet .And. !AC9->(Eof()) .And. AC9->(AC9_FILIAL+AC9_ENTIDA+AC9_FILENT) == (FWxFilial("AC9") + cChaveEnt) ;
				.And. Left(AllTrim(AC9->AC9_CODENT), Len(cCodEntPre)) == cCodEntPre
			If AllTrim(AC9->AC9_CODOBJ) == cCodObjTrim
				lRet := .T.
			EndIf
			AC9->(DbSkip())
		EndDo
	EndIf

	AC9->(RestArea(aAreaAC9))

Return lRet

/*/{Protheus.doc} LOCW066DocJson
Monta o objeto Json com os metadados de um documento do Banco de
Conhecimento, incluindo o conteudo em base64, para uso na listagem
retornada pela API.
@type function
@author ITUP
@since 01/09/2026
@param cCodObj, character, Codigo do objeto (ACB_CODOBJ)
@param cNomeArq, character, Nome do arquivo (ACB_OBJETO)
@param cDescArq, character, Descricao do objeto (ACB_DESCRI)
@return jDoc, json, Objeto Json com os metadados e o conteudo base64 do documento
/*/
Static Function LOCW066DocJson(cCodObj as Character, cNomeArq as Character, cDescArq as Character) as Json
Local jDoc := JsonObject():New() as Json

	jDoc["codigoObjeto"]    := cCodObj
	jDoc["nomeArquivo"]     := cNomeArq
	jDoc["descricao"]       := cDescArq
	jDoc["extensao"]        := Lower(LOCW066Ext(cNomeArq))
	jDoc["mimeType"]        := LOCW066Mime(cNomeArq)
	jDoc["conteudoBase64"]  := LOCW066Ler(cNomeArq)

Return jDoc

/*/{Protheus.doc} LOCW066Ler
Le o conteudo fisico de um arquivo armazenado no Banco de Conhecimento
(storage em sistema de arquivos, no mesmo diretorio utilizado pela
rotina de gravacao do Checklist - LOCW002.PRW/xGAppArq) e retorna o
conteudo codificado em base64. A leitura usa FOpen/FRead/FClose (com o
tamanho exato obtido via ADir) em vez de MemoRead, pois MemoRead trata
o conteudo como texto/memo e corrompe/trunca arquivos binarios (PDF,
JPEG etc.) - mesmo padrao ja usado por FileToBs64 (LOCW023.PRW:203-235)
para o mesmo cenario (leitura de objeto do Banco de Conhecimento).
@type function
@author ITUP
@since 01/09/2026
@param cNomeArq, character, Nome do arquivo (ACB_OBJETO)
@return cConteudo, character, Conteudo do arquivo em base64, ou vazio se nao localizado
/*/
Static Function LOCW066Ler(cNomeArq as Character) as Character
Local cDirDoc   := AllTrim(GetMV("MV_DIRDOC")) as Character
Local cPathBco  := "" as Character
Local cConteudo := "" as Character

	If SubStr(cDirDoc, Len(cDirDoc), 1) != "\"
		cDirDoc += "\"
	EndIf

	cPathBco := cDirDoc + "co" + cEmpAnt + "\shared\"

	If File(cPathBco + cNomeArq)
		cConteudo := Encode64(MemoRead(cPathBco + cNomeArq))
	EndIf
Return cConteudo

/*/{Protheus.doc} LOCW066Ext
Retorna a extensao (sem o ponto) do nome de arquivo informado.
@type function
@author ITUP
@since 01/09/2026
@param cNomeArq, character, Nome do arquivo
@return cExt, character, Extensao do arquivo, sem o ponto
/*/
Static Function LOCW066Ext(cNomeArq as Character) as Character
Local nPos := RAt(".", cNomeArq) as Numeric
Local cExt := "" as Character

	If nPos > 0
		cExt := SubStr(cNomeArq, nPos + 1)
	EndIf

Return cExt

/*/{Protheus.doc} LOCW066Mime
Retorna o mime-type correspondente a extensao do nome de arquivo
informado (PDF, TXT, JPG/JPEG, PNG - demais tipos retornam
application/octet-stream).
@type function
@author ITUP
@since 01/09/2026
@param cNomeArq, character, Nome do arquivo
@return cMime, character, Mime-type correspondente
/*/
Static Function LOCW066Mime(cNomeArq as Character) as Character
Local cExt  := Upper(LOCW066Ext(cNomeArq)) as Character
Local cMime := "application/octet-stream" as Character

	Do Case
	Case cExt == "PDF"
		cMime := "application/pdf"
	Case cExt == "TXT"
		cMime := "text/plain"
	Case cExt == "JPG" .Or. cExt == "JPEG"
		cMime := "image/jpeg"
	Case cExt == "PNG"
		cMime := "image/png"
	EndCase

Return cMime

/*/{Protheus.doc} LOCW066Err
Monta a resposta Json padrao de erro da API, conforme o modelo de
tratativas de API do BoasPraticas.md (status, message, code).
@type function
@author ITUP
@since 01/09/2026
@param nStatus, numeric, Codigo HTTP do erro
@param cCode, character, Codigo semantico do erro
@param cMessage, character, Mensagem descritiva do erro
@param aInfo, array, Retorno de GetApoInfo(cFonte) - data/hora de compilacao
@return cJson, character, Resposta Json serializada
/*/
Static Function LOCW066Err(nStatus as Numeric, cCode as Character, cMessage as Character, aInfo as Array) as Character
Local jErr := JsonObject():New() as Json

	jErr["status"]  := nStatus
	jErr["message"] := cMessage
	jErr["code"]    := cCode

Return jErr:toJson()
