namespace totvs.protheus.rental.manutencao.integratedprovider

@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGALOC", tables="FPQ,SX5,FPU,CTT,SRA", name="Rental", country="ALL", initialRelease="12.1.2210")
class integraproc from totvs.framework.treports.integratedprovider.integratedprovider
public method new() as object
public method getData() as object
public method getSchema() as object 
endclass

/*/{PROTHEUS.DOC} integraproc
ITUP BUSINESS - TOTVS RENTAL
Declaração das classes
@AUTHOR LEONARDO PACHECO FUGA
@SINCE 25/11/2025
/*/

method new() class integraproc
	_Super:new()
	//Define a Área
	self:appendArea("Rental")

	//Define o nome do Objeto de Negócio
	self:setDisplayName("Relatorio de Integração e Processos")

	//Define a descrição do Objeto de Negócio
	self:setDescription("Relatorio de Integração e Processos")
return self

/*/{PROTHEUS.DOC} getData
ITUP BUSINESS - TOTVS RENTAL
Processamento do relatório
@AUTHOR LEONARDO PACHECO FUGA
@SINCE 25/11/2025
/*/

method getData(nPage as numeric, oFilter as object) as object class integraproc
local cQuery as character
Local aBind       := {}

	//Define a quantidade máxima por página (Default 100)
	self:setPageSize(20)

	jParams := oFilter:getParameters() //metodo para retorno do json dos parâmetros

	If type("jParams['01'][1]") <> "C" .or. file("\SYSTEM\LOCSV024.TXT")
		jParams['01'][1] := space(TamSx3("FPU_MAT")[1])
	EndIf
	If empty(jParams['01'][1])
		jParams['01'][1] := space(TamSx3("FPU_MAT")[1])
	EndIf

	If type("jParams['02'][1]") <> "C" .or. file("\SYSTEM\LOCSV024.TXT")
		jParams['02'][1] := space(TamSx3("FPU_MAT")[1])
	EndIf
	If empty(jParams['02'][1])
		jParams['02'][1] := space(TamSx3("FPU_MAT")[1])
	EndIf

	If type("jParams['03'][1]") <> "C" .or. file("\SYSTEM\LOCSV024.TXT")
		jParams['03'][1] := space(TamSx3("FPU_PROJ")[1])
	EndIf
	If empty(jParams['03'][1])
		jParams['03'][1] := space(TamSx3("FPU_PROJ")[1])
	EndIf

	If type("jParams['04'][1]") <> "C" .or. file("\SYSTEM\LOCSV024.TXT")
		jParams['04'][1] := space(TamSx3("FPU_PROJ")[1])
	EndIf
	If empty(jParams['04'][1])
		jParams['04'][1] := space(TamSx3("FPU_PROJ")[1])
	EndIf

	If type("jParams['05'][1]") <> "C" .or. file("\SYSTEM\LOCSV024.TXT")
		jParams['05'][1] := space(TamSx3("FPU_OBRA")[1])
	EndIf
	If empty(jParams['05'][1])
		jParams['05'][1] := space(TamSx3("FPU_OBRA")[1])
	EndIf

	If type("jParams['06'][1]") <> "C" .or. file("\SYSTEM\LOCSV024.TXT")
		jParams['06'][1] := space(TamSx3("FPU_OBRA")[1])
	EndIf
	If empty(jParams['06'][1])
		jParams['06'][1] := space(TamSx3("FPU_OBRA")[1])
	EndIf

	jParams['07'][1] := StrTran(SubStr(jParams["07"][1],1,10),"-","") // "20000101"
	If empty(jParams['07'][1])
		jParams['07'][1] := space(8)
	EndIf

	jParams['08'][1] := StrTran(SubStr(jParams["08"][1],1,10),"-","") // "20000101"
	If empty(jParams['08'][1])
		jParams['08'][1] := space(8)
	EndIf

//------------------------------------------------------------------------------------------------------
	cQuery := " SELECT "
	cQuery += " FPU.FPU_AS, FPU.FPU_OBRA, FPU.FPU_PROJ, FPU.FPU_MAT, FPU.FPU_NOME, FPU.FPU_DTINI, FPU.FPU_DTFIN, FPU.FPU_QTDDIA, FPU.FPU_DTLIM, FPU.FPU_VALID, "
	cQuery += " CASE "
	cQuery += " WHEN FPU.FPU_CRACHA = '1' THEN 'SIM' "
	cQuery += " WHEN FPU.FPU_CRACHA = '2' THEN 'NAO' "
	cQuery += " WHEN FPU.FPU_CRACHA = ' ' THEN 'NAO' "
	cQuery += " ELSE ' ' "
	cQuery += " END FPU_CRACHA, "
	cQuery += " CASE "
	cQuery += " WHEN FPU.FPU_DESIST = '1' THEN 'SIM' "
	cQuery += " WHEN FPU.FPU_DESIST = '2' THEN 'NAO' "
	cQuery += " ELSE ' ' "
	cQuery += " END FPU_DESIST, "
	cQuery += " FPU.FPU_CONTRO, FPU.FPU_CARGAH, FPU.FPU_CODCLI, SA1.A1_NOME, FPU.FPU_LOJCLI, "
	cQuery += " COALESCE(FPV.FPV_CODPRO, ' ') FPV_CODPRO, "
	cQuery += " COALESCE(FPV.FPV_DESCRI, ' ') FPV_DESCRI, "
	cQuery += " COALESCE(FPV.FPV_DTPREV, '        ') FPV_DTPREV, "
	cQuery += " COALESCE(FPV.FPV_DTREAL, '        ') FPV_DTREAL, " 
	cQuery += " COALESCE(FPV.FPV_CONTRO, ' ') FPV_CONTRO, "
	cQuery += " COALESCE(FPV.FPV_DATVLD, '        ') FPV_DATVLD, "
	cQuery += " COALESCE(FPV.FPV_CARGAH, 0) FPV_CARGAH "

	cQuery += " FROM "+RetSqlName("FPU")+" FPU "

	cQuery += " LEFT JOIN "+RetSqlName("FPV")+" FPV ON "
	cQuery += " FPV.FPV_FILIAL = '"+xFilial("FPV")+ "' AND "
	cQuery += " FPV.FPV_AS = FPU.FPU_AS AND "
	cQuery += " FPV.FPV_PROJ = FPU.FPU_PROJ AND "
	cQuery += " FPV.FPV_OBRA = FPU.FPU_OBRA AND "
	cQuery += " FPV.FPV_MAT = FPU.FPU_MAT AND "
	cQuery += " FPV.D_E_L_E_T_ = ' ' "

	cQuery += " LEFT JOIN "+RetSqlName("SA1")+" SA1 ON "
	cQuery += " SA1.A1_FILIAL = '"+xFilial("SA1")+ "' AND "
	cQuery += " SA1.A1_COD = FPU.FPU_CODCLI AND "
	cQuery += " SA1.A1_LOJA = FPU.FPU_LOJCLI AND "
	cQuery += " SA1.D_E_L_E_T_ = ' ' "

	cQuery += " WHERE "
	cQuery += " FPU.FPU_MAT >= ? AND "
	AAdd(aBind, {jParams['01'][1], "S"})
	cQuery += " FPU.FPU_MAT <= ? AND "
	AAdd(aBind, {jParams['02'][1], "S"})
	cQuery += " FPU.FPU_PROJ >= ? AND "
	AAdd(aBind, {jParams['03'][1], "S"})
	cQuery += " FPU.FPU_PROJ <= ? AND "
	AAdd(aBind, {jParams['04'][1], "S"})
	cQuery += " FPU.FPU_OBRA >= ? AND "
	AAdd(aBind, {jParams['05'][1], "S"})
	cQuery += " FPU.FPU_OBRA <= ? AND "
	AAdd(aBind, {jParams['06'][1], "S"})
	cQuery += " FPU.FPU_DTINI >= ? AND "
	AAdd(aBind, {jParams['07'][1], "S"})
	cQuery += " FPU.FPU_DTINI <= ? AND "
	AAdd(aBind, {jParams['08'][1], "S"})
	cQuery += "FPU.D_E_L_E_T_ = ' ' "
		  
	cQuery := CHANGEQUERY(cQuery)
	cQuery := JurTRepBin(cQuery, aBind)
	self:setOrder("FPU.FPU_PROJ, FPU.FPU_OBRA, FPU.FPU_AS")
	self:setQuery(cQuery)

return self:oData

/*/{PROTHEUS.DOC} getShema
ITUP BUSINESS - TOTVS RENTAL
Declaração dos parâmetros
@AUTHOR LEONARDO PACHECO FUGA
@SINCE 25/11/2025
/*/

method getSchema() as object class integraproc

	self:addProperty("Projeto",      "Projeto",             "string", "Projeto",             "FPU_PROJ")
	self:addProperty("Obra",         "Obra",                "string", "Obra",                "FPU_OBRA")
	self:addProperty("NrAS",         "Nr. A.S.",            "string", "Nr. A.S.",            "FPU_AS")
	self:addProperty("Matricula",    "Matricula",           "string", "Matricula",           "FPU_MAT")
	self:addProperty("NomeFunc",     "Nome do funcionario", "string", "Nome do funcionario", "FPU_NOME")
	self:addProperty("DtIntegraIni", "Dt. Integracao Ini.", "date",   "Dt. Integracao Ini.", "FPU_DTINI")
	self:addProperty("DtIntegraFim", "Dt. Integracao Fim.", "date",   "Dt. Integracao Fim.", "FPU_DTFIN")
	self:addProperty("QtdDiasInt",   "Qtd Dias Int",        "number", "Qtd Dias Int",        "FPU_QTDDIA")
	self:addProperty("DtLimInteg",   "Dt.Lim Integ",        "date",   "Dt.Lim Integ",        "FPU_DTLIM")
	self:addProperty("Validade",     "Validade",            "number", "Validade",            "FPU_VALID")
	self:addProperty("CrachaAtivo",  "Cracha Ativo",        "string", "Cracha Ativo",        "FPU_CRACHA")
	self:addProperty("Desistencia",  "Desistencia",         "string", "Desistencia",         "FPU_DESIST")
	self:addProperty("QtMatricula",  "Qt Matricula",        "string", "Qt Matricula",        "FPU_CONTRO")
	self:addProperty("CHoraria  ",   "C. Horaria",          "number", "C. Horaria",          "FPU_CARGAH")
	self:addProperty("CodCliente",   "Cod. Cliente",        "string", "Cod. Cliente",        "FPU_CODCLI")
	self:addProperty("NomeCliente",  "Nome Cliente",        "string", "Nome Cliente",        "A1_NOME")
	self:addProperty("Loja",         "Loja",                "string", "Loja",                "FPU_LOJCLI")
	self:addProperty("CodProcesso",  "Cod.Processo",        "string", "Cod.Processo",        "FPV_CODPRO")
	self:addProperty("DescProc",     "Desc. Processo",      "string", "Desc. Processo",      "FPV_DESCRI")
	self:addProperty("DtPrevista",   "Dt. Prevista",        "date",   "Dt. Prevista",        "FPV_DTPREV")
	self:addProperty("DtRealizada",  "Dt Realizada",        "date",   "Dt Realizada",        "FPV_DTREAL")
	self:addProperty("DtValidade ",  "Dt.Validade ",        "date",   "Dt.Validade ",        "FPV_DATVLD")

	self:addParameter("01", "Matricula de",            "string", .F., "", .F., .T., "SRA", "MV_PAR01")
	self:addParameter("02", "Matricula até",           "string", .F., "", .F., .T., "SRA", "MV_PAR02")
	self:addParameter("03", "Projeto de",              "string", .F., "", .F., .T., "FP0", "MV_PAR03")
	self:addParameter("04", "Projeto até",             "string", .F., "", .F., .T., "FP0", "MV_PAR04")
	self:addParameter("05", "Obra de",                 "string", .F., "", .F., .F., ""   , "MV_PAR05")
	self:addParameter("06", "Obra até",                "string", .F., "", .F., .F., ""   , "MV_PAR06")
	self:addParameter("07", "Dt Inicio da integ. de",  "date"  , .F., "", .F., .F., ""   , "MV_PAR07")
	self:addParameter("08", "Dt Inicio da integ. até", "date"  , .F., "", .F., .F., ""   , "MV_PAR08")

return self:oSchema
