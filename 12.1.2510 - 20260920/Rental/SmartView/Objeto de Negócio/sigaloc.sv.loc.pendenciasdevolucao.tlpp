#include "msobject.ch"
#include "TOTVS.ch"
#include "totvs.framework.treports.integratedprovider.th"

/*/{PROTHEUS.DOC} sigaloc.sv.loc.pendenciasdevolucao.tlpp
ITUP BUSINESS - TOTVS RENTAL
Relatorio de Lista de Pendencias de Devolucao
@AUTHOR Leonardo Pacheco Fuga
@SINCE 01/09/2026
/*/

namespace totvs.protheus.rental.manutencao.integratedprovider

@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGALOC", tables="FPA,SB1,FQ5,ST9,NNR,FP1,FQ3,FQX", name="Rental", country="ALL", initialRelease="12.1.2210")
class pendenciasdevolucao from totvs.framework.treports.integratedprovider.integratedprovider

public method new() as object
public method getData() as object
public method getSchema() as object
public method printPendencias() as logical

endclass

/*/{PROTHEUS.DOC} new
ITUP BUSINESS - TOTVS RENTAL
Construtor do objeto de negocio
@type method
@AUTHOR Leonardo Pacheco Fuga
@SINCE 01/09/2026
@return object, instancia de pendenciasdevolucao
/*/

method new() class pendenciasdevolucao
	_Super:new()

	self:appendArea("Rental")

	self:setDisplayName("Lista de Pendencias de Devolucao")

	self:setDescription("Lista de Pendencias de Devolucao")
return self

/*/{PROTHEUS.DOC} getData
ITUP BUSINESS - TOTVS RENTAL
Processamento do relatorio. Reaproveita os mesmos criterios de pendencia de devolucao
usados na tela de "A.S. Disponiveis" (funcao LOCA104BLd, em LOCA104B.PRW): itens
enviados (FPA_NFREM preenchido) e ainda nao devolvidos (FPA_NFRET vazio), que nao
estejam presos em outro romaneio (NOT EXISTS contra FQ3 e FQX).
@type method
@AUTHOR Leonardo Pacheco Fuga
@SINCE 01/09/2026
@param nPage, numeric, pagina de dados solicitada pelo motor Smart View
@param oFilter, object, filtro com os parametros informados na impressao (Projeto/Obra/Produto/Armazem)
@return object, dataset (self:oData) com os itens pendentes de devolucao
/*/

method getData(nPage as numeric, oFilter as object) as object class pendenciasdevolucao
Local cQuery as character
Local aBind       := {}

	self:setPageSize(20)

	jParams := oFilter:getParameters() //metodo para retorno do json dos parametros

	If type("jParams['01'][1]") <> "C" .or. file("\SYSTEM\LOCSV029.TXT")
		jParams['01'][1] := space(TamSx3("FPA_PROJET")[1])
	EndIf
	If empty(jParams['01'][1])
		jParams['01'][1] := space(TamSx3("FPA_PROJET")[1])
	EndIf

	If type("jParams['02'][1]") <> "C" .or. file("\SYSTEM\LOCSV029.TXT")
		jParams['02'][1] := space(TamSx3("FPA_OBRA")[1])
	EndIf
	If empty(jParams['02'][1])
		jParams['02'][1] := space(TamSx3("FPA_OBRA")[1])
	EndIf

	If type("jParams['03'][1]") <> "C" .or. file("\SYSTEM\LOCSV029.TXT")
		jParams['03'][1] := space(TamSx3("FPA_PRODUT")[1])
	EndIf
	If empty(jParams['03'][1])
		jParams['03'][1] := space(TamSx3("FPA_PRODUT")[1])
	EndIf

	If type("jParams['04'][1]") <> "C" .or. file("\SYSTEM\LOCSV029.TXT")
		jParams['04'][1] := Replicate("Z", TamSx3("FPA_PRODUT")[1])
	EndIf
	If empty(jParams['04'][1])
		jParams['04'][1] := Replicate("Z", TamSx3("FPA_PRODUT")[1])
	EndIf

	If type("jParams['05'][1]") <> "C" .or. file("\SYSTEM\LOCSV029.TXT")
		jParams['05'][1] := space(TamSx3("FPA_LOCAL")[1])
	EndIf
	If empty(jParams['05'][1])
		jParams['05'][1] := space(TamSx3("FPA_LOCAL")[1])
	EndIf

	If type("jParams['06'][1]") <> "C" .or. file("\SYSTEM\LOCSV029.TXT")
		jParams['06'][1] := Replicate("Z", TamSx3("FPA_LOCAL")[1])
	EndIf
	If empty(jParams['06'][1])
		jParams['06'][1] := Replicate("Z", TamSx3("FPA_LOCAL")[1])
	EndIf

	cQuery := "SELECT FPA.FPA_PROJET, FPA.FPA_OBRA, FPA.FPA_AS, FPA.FPA_PRODUT, SB1.B1_DESC, SB1.B1_UM, "
	cQuery += "FPA.FPA_QUANT, FPA.FPA_GRUA, ST9.T9_NOME, FPA.FPA_LOCAL, NNR.NNR_DESCRI, "
	cQuery += "FP1.FP1_CLIORI, FP1.FP1_LOJORI, FP1.FP1_NOMORI, FP1.FP1_ENDORI, FP1.FP1_MUNORI, FP1.FP1_CEPORI, "
	cQuery += "'  ' QTDE_RECEB, '  ' AVARIADOS "
	cQuery += "FROM "+RetSqlName("FPA")+" FPA "

	cQuery += "INNER JOIN "+RetSqlName("SB1")+" SB1 ON "
	cQuery += "SB1.B1_FILIAL = '"+xFilial("SB1")+"' AND "
	cQuery += "SB1.B1_COD = FPA.FPA_PRODUT AND "
	cQuery += "SB1.D_E_L_E_T_ = ' ' "

	cQuery += "INNER JOIN "+RetSqlName("FQ5")+" FQ5 ON "
	cQuery += "FQ5.FQ5_FILIAL = '"+xFilial("FQ5")+"' AND "
	cQuery += "FQ5.FQ5_AS = FPA.FPA_AS AND "
	cQuery += "FQ5.D_E_L_E_T_ = ' ' "

	cQuery += "LEFT JOIN "+RetSqlName("ST9")+" ST9 ON "
	cQuery += "ST9.T9_FILIAL = '"+xFilial("ST9")+"' AND "
	cQuery += "ST9.T9_CODBEM = FPA.FPA_GRUA AND "
	cQuery += "ST9.D_E_L_E_T_ = ' ' "

	cQuery += "LEFT JOIN "+RetSqlName("NNR")+" NNR ON "
	cQuery += "NNR.NNR_FILIAL = '"+xFilial("NNR")+"' AND "
	cQuery += "NNR.NNR_CODIGO = FPA.FPA_LOCAL AND "
	cQuery += "NNR.D_E_L_E_T_ = ' ' "

	cQuery += "LEFT JOIN "+RetSqlName("FP1")+" FP1 ON "
	cQuery += "FP1.FP1_FILIAL = '"+xFilial("FP1")+"' AND "
	cQuery += "FP1.FP1_PROJET = FPA.FPA_PROJET AND "
	cQuery += "FP1.FP1_OBRA = FPA.FPA_OBRA AND "
	cQuery += "FP1.D_E_L_E_T_ = ' ' "

	cQuery += "WHERE FPA.FPA_FILIAL = '"+xFilial("FPA")+"' AND "
	cQuery += "FPA.FPA_TIPOSE = 'L' AND "
	cQuery += "FPA.FPA_NFRET = ' ' AND "
	cQuery += "FPA.FPA_NFREM <> ' ' AND "
	cQuery += "FPA.FPA_PROJET = ? AND "
	AAdd(aBind, {jParams['01'][1], "S"})
	cQuery += "FPA.FPA_OBRA = ? AND "
	AAdd(aBind, {jParams['02'][1], "S"})
	cQuery += "FPA.FPA_PRODUT >= ? AND "
	AAdd(aBind, {jParams['03'][1], "S"})
	cQuery += "FPA.FPA_PRODUT <= ? AND "
	AAdd(aBind, {jParams['04'][1], "S"})
	cQuery += "FPA.FPA_LOCAL >= ? AND "
	AAdd(aBind, {jParams['05'][1], "S"})
	cQuery += "FPA.FPA_LOCAL <= ? AND "
	AAdd(aBind, {jParams['06'][1], "S"})
	cQuery += "FPA.D_E_L_E_T_ = ' ' "

	cQuery += "AND NOT EXISTS ( " // A.S. esta num Romaneio antigo
	cQuery += "SELECT FQ3_AS "
	cQuery += "FROM "+RetSqlName("FQ3")+" FQ3 "
	cQuery += "WHERE FQ3.FQ3_FILIAL = '"+xFilial("FQ3")+"' AND "
	cQuery += "FQ3.FQ3_AS = FPA.FPA_AS AND "
	cQuery += "FQ3.FQ3_NFREM = ' ' AND "
	cQuery += "FQ3.FQ3_NFRET = ' ' AND "
	cQuery += "FQ3.D_E_L_E_T_ = ' ') "

	cQuery += "AND NOT EXISTS ( " // A.S. esta num Romaneio novo e nao foi faturado
	cQuery += "SELECT FQX_AS "
	cQuery += "FROM "+RetSqlName("FQX")+" FQX "
	cQuery += "WHERE FQX.FQX_FILIAL = '"+xFilial("FQX")+"' AND "
	cQuery += "FQX.FQX_AS = FPA.FPA_AS AND "
	cQuery += "FQX.FQX_NFRET = ' ' AND "
	cQuery += "FQX.D_E_L_E_T_ = ' ') "

	cQuery := CHANGEQUERY(cQuery)
	cQuery := JurTRepBin(cQuery, aBind)
	self:setOrder("FPA.FPA_PRODUT")
	self:setQuery(cQuery)

return self:oData

/*/{PROTHEUS.DOC} getSchema
ITUP BUSINESS - TOTVS RENTAL
Declaracao das colunas (schema) e dos parametros de impressao
@type method
@AUTHOR Leonardo Pacheco Fuga
@SINCE 01/09/2026
@return object, schema (self:oSchema) do relatorio
/*/

method getSchema() as object class pendenciasdevolucao

	self:addProperty("Projeto",         "Projeto",             "string", "Projeto",             "FPA_PROJET")
	self:addProperty("Obra",            "Obra",                "string", "Obra",                "FPA_OBRA")
	self:addProperty("Cliente",         "Cliente",             "string", "Cliente",             "FP1_CLIORI")
	self:addProperty("Loja",            "Loja",                "string", "Loja",                "FP1_LOJORI")
	self:addProperty("NomeCliente",     "Nome do Cliente",     "string", "Nome do Cliente",     "FP1_NOMORI")
	self:addProperty("Endereco",        "Endereco",            "string", "Endereco",            "FP1_ENDORI")
	self:addProperty("Municipio",       "Municipio",           "string", "Municipio",           "FP1_MUNORI")
	self:addProperty("Cep",             "CEP",                 "string", "CEP",                 "FP1_CEPORI")
	self:addProperty("NumAS",           "A.S.",                "string", "A.S.",                "FPA_AS")
	self:addProperty("Produto",         "Produto",             "string", "Produto",              "FPA_PRODUT")
	self:addProperty("DescProdut",      "Desc. Produto",       "string", "Desc. Produto",       "B1_DESC")
	self:addProperty("UnidadeMedida",   "Unidade de medida",   "string", "Unidade de medida",   "B1_UM")
	self:addProperty("Quantidade",      "Qtd. Pendente",       "number", "Qtd. Pendente",       "FPA_QUANT")
	self:addProperty("Equipamento",     "Equipamento",         "string", "Equipamento",         "FPA_GRUA")
	self:addProperty("NomeEquipamento", "Nome Equip.",         "string", "Nome Equip.",         "T9_NOME")
	self:addProperty("Armazem",         "Armazem",             "string", "Armazem",             "FPA_LOCAL")
	self:addProperty("DescArmazem",     "Descricao Armazem",   "string", "Descricao Armazem",   "NNR_DESCRI")
	self:addProperty("QtdeRecebida",    "Quantidade Recebida", "string", "Quantidade Recebida", "QTDE_RECEB")
	self:addProperty("Avariados",       "Avariados",           "string", "Avariados",           "AVARIADOS")

	self:addParameter("01", "Projeto",     "string", .F., "", .F., .T., "FP0", "MV_PAR01")
	self:addParameter("02", "Obra",        "string", .F., "", .F., .F., "",    "MV_PAR02")
	self:addParameter("03", "Produto de",  "string", .F., "", .F., .T., "SB1", "MV_PAR03")
	self:addParameter("04", "Produto ate", "string", .F., "", .F., .T., "SB1", "MV_PAR04")
	self:addParameter("05", "Armazem de",  "string", .F., "", .F., .T., "NNR", "MV_PAR05")
	self:addParameter("06", "Armazem ate", "string", .F., "", .F., .T., "NNR", "MV_PAR06")

return self:oSchema

/*/{Protheus.doc} printPendencias
Gera a impressao da Lista de Pendencias de Devolucao para o Projeto+Obra informado
@type method
@author Leonardo Pacheco Fuga
@since 01/09/2026
@version 25.10
@param cProjeto, character, projeto em que o usuario esta posicionado (FQW_PROJET)
@param cObra, character, obra em que o usuario esta posicionado (FQW_OBRA)
@return logical, indica se a impressao foi executada com sucesso
*/
method printPendencias(cProjeto as character, cObra as character) as logical class pendenciasdevolucao
Local lSuccess := .F. as logical
Local jPrintInfo as json
Local cSmartViewId := "sigaloc.sv.loc.pendenciasdevolucao.default.rep"
Local aReportType := {"report", "data-grid", "pivot-table"} as array
Local cDefaultPath := GetTempPath() as character
Local oSmartView As Object
Local cMsg := "" As Character

	jPrintInfo := JsonObject():New()
	jPrintInfo['name'] := "ListaPendenciasDevolucao_" + FwTimeStamp()
	jPrintInfo['extension'] := "pdf"
	jPrintInfo['path'] := cDefaultPath

	oSmartView := totvs.framework.smartview.callSmartView():new(cSmartViewId,aReportType[1])
	oSmartView:setOpenFile(.T.)
	oSmartView:setNoInterface(.F.)
	oSmartView:setParam("01", cProjeto, "Disabled")
	oSmartView:setParam("02", cObra, "Disabled")
	oSmartView:setForceParams(.T.)
	oSmartView:setPrintInfo(jPrintInfo)
	lSuccess := oSmartView:executeSmartView(.T.)

	If !lSuccess .or. file("\SYSTEM\LOCSV029.TXT")
		cMsg := oSmartView:getError()
	EndIf

	oSmartView:Destroy()

	If oSmartView != Nil
		FreeObj(oSmartView)
	EndIf

return lSuccess
