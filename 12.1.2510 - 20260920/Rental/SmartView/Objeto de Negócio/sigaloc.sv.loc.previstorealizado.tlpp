namespace totvs.protheus.rental.manutencao.integratedprovider

@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGALOC", tables="FP0,FP1,FPA,CTT,FPY,STL,STJ,SB1,ST9", name="Rental", country="ALL", initialRelease="12.1.2210")
class previstorealizado from totvs.framework.treports.integratedprovider.integratedprovider
data oTempTable as object
public method new() as object
public method getData() as object
public method getSchema() as object 
public method printprevxreal() as logical
endclass

/*/{PROTHEUS.DOC} sigaloc.sv.loc.previstorealizado.tlpp
ITUP BUSINESS - TOTVS RENTAL
@TYPE Method new
@AUTHOR Frank Zwarg Fuga
@SINCE 02/09/2025
/*/

method new() class previstorealizado

	_Super:new()
	self:appendArea("Rental")
	self:setDisplayName("Previsto x Realizado")
	self:setDescription("Previsto x Realizado")

return self

/*/{PROTHEUS.DOC} sigaloc.sv.loc.previstorealizado.tlpp
ITUP BUSINESS - TOTVS RENTAL
@TYPE Method getData
Method para extrair os dados e dar o funcionamento da consulta
@AUTHOR Frank Zwarg Fuga
@SINCE 14/04/2025
/*/
method getData(nPage as numeric, oFilter as object) as object class previstorealizado
Local cQuery as character
Local cAlias as character
Local oExec as object

	//Define a quantidade máxima por página (Default 100)
	self:setPageSize(20)

	cQuery := " SELECT "
	cQuery += " ORDEMX, CONTRATO, SITUACAO, CODCLI, LOJCLI, NOMCLI, PEDCLI, DTIMP, NRPED, ABRCLI, PEDFIN, CIDCLI, REPRES, ENDCLI, "
	cQuery += " ESTCLI,	PAICLI,	TITULO, ORCVLR, REAVLR "

	cComando := " cQuery += "
    cComando += "'"
	cComando += " FROM PREVREL3 TMP "
    cComando += "'"
	&(cComando)

	oExec  := FwExecStatement():New(ChangeQuery(cQuery))

	cAlias := oExec:OpenAlias()

	(cAlias)->(DBCloseArea())
	self:setQuery(cQuery)//Pega a nova query formatada

	//Define o campo de ordenação da query
	self:setOrder("ORDEMX")

	cComando := 'MEMOWRITE("\SYSTEM\LOCADELP-"+alltrim(str(ThreadID()))+".TXT","PREVREL3")'
	&(cComando)
 
return self:oData

/*/{PROTHEUS.DOC} sigaloc.sv.loc.previstorealizado.tlpp
ITUP BUSINESS - TOTVS RENTAL
@TYPE Method getSchema
Method para definição dos campos de apresentação da consulta e definição dos parâmetros
@AUTHOR Frank Zwarg Fuga
@SINCE 15/04/2026
/*/
method getSchema() as object class previstorealizado

	self:addProperty("CONTRATO", "Contrato",          "string", "Contrato",          "CONTRATO")
	self:addProperty("SITUACAO", "Situação",          "string", "Situação",          "SITUACAO")
	self:addProperty("CODCLI",   "Código cliente",    "string", "Código cliente",    "CODCLI")
	self:addProperty("LOJCLI",   "Loja cliente",      "string", "Loja cliente",      "LOJCLI")
	self:addProperty("NOMCLI",   "Nome cliente",      "string", "Nome cliente",      "NOMCLI")
	self:addProperty("PEDCLI",   "Pedido cliente",    "string", "Pedido cliente",    "PEDCLI")
	self:addProperty("DTIMP",    "Dt.imp",            "string", "Dt.imp",            "DTIMP")
	self:addProperty("NRPED",    "Nr.pedido",         "string", "Nr.pedido",         "NRPED")
	self:addProperty("ABRCLI",   "Nome abreviado",    "string", "Nome abreviado",    "ABRCLI")
	self:addProperty("REPRES",   "Representante",     "string", "Representante",     "REPRES")
	self:addProperty("PEDFIN",   "Pedido financeiro", "string", "Pedido financeiro", "PEDFIN")
	self:addProperty("CIDCLI",   "Cidade",            "string", "Cidade",            "CIDCLI")
	self:addProperty("ESTCLI",   "UF",                "string", "UF",                "ESTCLI")
	self:addProperty("PAICLI",   "País",              "string", "País",              "PAICLI")
	self:addProperty("ENDCLI",   "Endereço",          "string", "Endereço",          "ENDCLI")
	self:addProperty("TITULO",   "Descrição",         "string", "Descrição",         "TITULO")
	self:addProperty("ORCVLR",   "Orçado",            "number", "Orçado",            "ORCVLR")
	self:addProperty("REAVLR",   "Real",              "number", "Real",              "REAVLR")
		
return self:oSchema

/*/{Protheus.doc} printprevxreal
Gera a impressão do Previsto x Realizado
@author Frank Zwarg Fuga
@since 16/04/2026
*/
method printprevxreal(cProjeto as character) as logical class previstorealizado
Local lSuccess := .F. as logical
Local cSmartViewId := "sigaloc.sv.loc.previstorealizado.default.rep"
Local aReportType := {"report", "data-grid", "pivot-table"} as array
Local oSmartView As Object
Local cMsg := "" As Character

    oSmartView := totvs.framework.smartview.callSmartView():new(cSmartViewId,aReportType[1])
	oSmartView:setOpenFile(.T.)
    oSmartView:setNoInterface(.F.)
    oSmartView:setParam("01", cProjeto, "Disabled")
    oSmartView:setForceParams(.T.)
    lSuccess := oSmartView:executeSmartView(.T.)

    If !lSuccess .or. file("\SYSTEM\LOCSV026.TXT")
        cMsg := oSmartView:getError()
    EndIf

    oSmartView:Destroy()

    If oSmartView != Nil   
        FreeObj(oSmartView)
    EndIf

return lSuccess

