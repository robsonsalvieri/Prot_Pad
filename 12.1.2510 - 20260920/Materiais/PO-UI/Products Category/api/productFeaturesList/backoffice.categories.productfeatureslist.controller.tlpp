#include "tlpp-core.th"
#include "backoffice.categories.productfeatureslist.controller.ch"

namespace totvs.protheus.backoffice.categories.productfeatureslist
using namespace totvs.protheus.backoffice.categories.util

//------------------------------------------------------------------------------
/*/{Protheus.doc} productFeaturesList
	API para consulta de Características por produtos (D4X)
	@type       class
	@author     cruz.rafael / Squad Retail
	@since      15/01/2026
	@version    12
/*/
//------------------------------------------------------------------------------
Class productFeaturesList
	Data jResponse  as Json
	Data nPage      as Numeric
	Data nPageSize  as Numeric
	Data oService   as Object

	Public Method new() as Object

	@GET("/api/categories/v1/productFeaturesList") // Retorna todas as caracteristicas dos produtos
	Public Method getPrdFeatures() as Logical

	@GET("/api/categories/v1/productFeaturesList/optionslist") // Retorna as listas de opções das caracteristicas dos produtos
	Public Method getFeatureList() as Logical

	@POST("/api/categories/v1/productFeaturesList/updateValues") // Atualiza valores das características de produtos
	Public Method postUpdatePrdFeatureValues() as Logical

endClass

//------------------------------------------------------------------------------
/*/{Protheus.doc} productFeaturesList::new() as Object
	Obtém uma nova instancia da classe productFeaturesList
	@type       method
	@return     object, retorna uma nova instancia da classe.
	@author     cruz.rafael / Squad Retail
	@since      15/01/2026
	@version    12
/*/
//------------------------------------------------------------------------------
Method new() as Object Class productFeaturesList
	::jResponse := JsonObject():new()
	::nPage     := 1
	::nPageSize := 10000
	::oService  := ProductFeaturesListService():getInstance()
return self

//------------------------------------------------------------------------------
/*/{Protheus.doc} productFeaturesList::getPrdFeatures() as Logical
	Obtem uma lista de características de produtos, possibilitando filtrar (QueryParam - FILTER) 
	os produtos e permitindo retornar todos	os campos ou somente os campos 
	especificados no QueryParam FIELDS.
	Observação: Ao utilizar o getPrdFeatures o campo DELETED não será retornado. 
	@type       method
	@return     logical, Verdadeiro
	@author     cruz.rafael / Squad Retail
	@since      15/01/2026
	@version    12
/*/
//------------------------------------------------------------------------------
Method getPrdFeatures() as Logical Class productFeaturesList
	Local aItems                                    as Array
	Local aURLFilter := GetFilterParam()            as Array
	Local cProductId := GetQueryParam("ProductId")  as Character
	Local cFields    := GetQueryParam('FIELDS')     as Character
	Local cSort      := GetQueryParam('SORT')       as Character

	oRest:setKeyHeaderResponse('content-type', 'application/json')

	GetPageAndPageSize(@::nPage, @::nPageSize)
	::jResponse:fromJson(::oService:getPrdFeatures(::nPage, ::nPageSize, aURLFilter, cFields, cSort, "", cProductId))
	aItems := ::jResponse:GetJsonObject( "items" )

	If (!Empty(aItems) .And. Len(aItems) > 0)
		oRest:setResponse(::jResponse)
		aSize(aItems, 0)
	Else
		SetRestFault(404, FWHttpEncode(STR0001)) // "Categoria não localizada"
	Endif

	aSize(aURLFilter, 0)
return .T.

//------------------------------------------------------------------------------
/*/{Protheus.doc} productFeaturesList::getFeatureList() as Logical
	Obtém uma lista de opções de características de produtos do tipo lista, 
	possibilitando filtrar (QueryParam - FILTER)
	@type       method
	@return     logical, Verdadeiro
	@author     cruz.rafael / Squad Retail
	@since      15/01/2026
	@version    12
/*/
//------------------------------------------------------------------------------
Method getFeatureList() as Logical Class productFeaturesList
	Local aItems                                    as Array
	Local aURLFilter := GetFilterParam()            as Array
	Local cFeatureId := GetQueryParam("FeatureId")  as Character
	Local cFields    := GetQueryParam('FIELDS')     as Character
	Local cSort      := GetQueryParam('SORT')       as Character

	oRest:setKeyHeaderResponse('content-type', 'application/json')

	GetPageAndPageSize(@::nPage, @::nPageSize)
	::jResponse:fromJson(::oService:getFeatureList(::nPage, ::nPageSize, aURLFilter, cFields, cSort, "", cFeatureId))
	aItems := ::jResponse:GetJsonObject( "items" )

	If (!Empty(aItems) .And. Len(aItems) > 0)
		oRest:setResponse(::jResponse)
		aSize(aItems, 0)
	Else
		SetRestFault(404, FWHttpEncode(STR0001)) // "Categoria não localizada"
	Endif

	aSize(aURLFilter, 0)
return .T.

//------------------------------------------------------------------------------
/*/{Protheus.doc} productFeaturesList::postUpdatePrdFeatureValues() as Logical
	Atualiza os valores das características de produtos (D4X_VALOR) baseado nos dados recebidos.
	Recebe um código de produto e um array com código e valor das características.
	@type       method
	@return     logical, Verdadeiro
	@author     Daniel Tonon / Squad Retail
	@since      16/03/2026
	@version    12
/*/
//------------------------------------------------------------------------------
Method postUpdatePrdFeatureValues() as Logical Class productFeaturesList
	Local cBody     as Character
	Local jBody     as Json

	oRest:setKeyHeaderResponse('content-type', 'application/json')

	cBody := oRest:GetBodyRequest()
	jBody := JsonObject():New()

	If jBody:fromJson(cBody) == Nil .And. (jBody:HasProperty("productId"))
		::jResponse := ::oService:postUpdatePrdFeatureValues(jBody)
		If ::jResponse:HasProperty("error")
			SetRestFault(400, FWHttpEncode(::jResponse["error"]))
		Else
			oRest:setResponse(::jResponse)
		EndIf
	EndIf
return .T.

