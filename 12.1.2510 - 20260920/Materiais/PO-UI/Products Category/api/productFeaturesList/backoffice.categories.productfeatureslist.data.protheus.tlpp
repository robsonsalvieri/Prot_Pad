namespace totvs.protheus.backoffice.categories.productfeatureslist
using namespace totvs.protheus.backoffice.categories.util

#DEFINE LABEL 1
#DEFINE VALUE 2

//------------------------------------------------------------------------------
/*/{Protheus.doc} ProductFeaturesListProtheusData
	Efetua a consulta de características de produtos do Protheus.

	@type       Class
	@author     cruz.rafael / Squad Retail
	@since      15/01/2026
	@version    12
/*/
//------------------------------------------------------------------------------
Class ProductFeaturesListProtheusData from FWAdapterBaseV2
	Public Data oHashFields	as Object

	Public Method new() as Object
	Public Method get()
	Public Method getList()
	Public Method rowToJson()
	Public Method postUpdatePrdFeatureValues() as Json

	protected data oMainExec as object

EndClass

//------------------------------------------------------------------------------
/*/{Protheus.doc} ProductFeaturesListProtheusData
	Construtor da classe ProductFeaturesListProtheusData

	@sample     ProductFeaturesListProtheusData():New(cVerb, .T.)
	@type       method
	@param      cVerb, Character, Verbo que será utilizado na requisição
	@author     cruz.rafael / Squad Retail
	@since      15/01/2026
	@version    12
/*/
//------------------------------------------------------------------------------
Method new(cVerb as Character) as Object Class ProductFeaturesListProtheusData
	_Super:New(cVerb, .T.)
	::oMainExec := Nil
Return Self

//------------------------------------------------------------------------------
/*/{Protheus.doc} get
	Efetua a consulta de características de Produtos (D4X).

	@sample     oFeatureData:Get(1, 10, {}, 'code, description', '-code', Nil)
	@type       method
	@param      nPage       , Numeric   , Número da página que será retornada
	@param      nPageSize   , Numeric   , Quantidade de registros por página
	@param      aURLFilter  , Array     , Lista de Filtros no padrão do FWAdapterBaseV2
	@param      cFields     , Character , Lista de campos que devem ser retornados
	@param      cSort       , Character , Ordernação do Response
	@param      cSearchText , Character , Texto de pesquisa
	@param      cProductId  , Character , Código do produto para filtro de características
	@author     cruz.rafael / Squad Retail
	@since      15/01/2026
	@version    12
/*/
//------------------------------------------------------------------------------
Method get(nPage as Numeric, nPageSize as Numeric, aURLFilter as Array, cFields as Character, cSort as Character,;
 cSearchText as Character, cProductId as Character) class ProductFeaturesListProtheusData
	Local aArea := FwGetArea()

	Default nPage       := 1
	Default nPageSize   := 10
	Default aURLFilter  := {}
	Default cFields     := ""
	Default cSort       := ""
	Default cSearchText := ""
	Default cProductId  := ""

	::setPage(nPage) // Define a página atual
	::setPageSize(nPageSize) // Define o tamanho da página
	::SetQuery(GetQueryD4X(::oMainExec)) // Define a query utilizada
	::SetWhere(GetFilterD4X(cProductId)) // Define o filtro utilizado
	::SetOrder("D4X_FILIAL", "D4X_PROD", "D4X_CARAC", "D4X_VALOR", "D4X_CATEGO") // Define a ordenação padrão

	::setIsCaseSensitive(.T.) // Define a consulta como case sensitive, para que o filtro de pesquisa funcione corretamente

	AddMapFieldsD4X(self)

	If !Empty(cSort)
		::SetOrderQuery(cSort) // Define a ordenação personalizada
	EndIf

	If ::Execute()
		::FillGetResponse() // Preenche o response com os dados retornados
	EndIf

	FwRestArea(aArea)
	aSize(aArea, 0)
Return Nil

//------------------------------------------------------------------------------
/*/{Protheus.doc} getList
	Efetua a consulta de lista de opções de caracteristicas do tipo lista (D4W).

	@sample     oFeatureData:getList(1, 10, {}, 'code, description', '-code', Nil)
	@type       method
	@param      nPage       , Numeric   , Número da página que será retornada
	@param      nPageSize   , Numeric   , Quantidade de registros por página
	@param      aURLFilter  , Array     , Lista de Filtros no padrão do FWAdapterBaseV2
	@param      cFields     , Character , Lista de campos que devem ser retornados
	@param      cSort       , Character , Ordernação do Response
	@param      cSearchText , Character , Texto de pesquisa
	@param      cFeatureId  , Character , Código da característica para filtro de lista de opções
	@author     cruz.rafael / Squad Retail
	@since      15/01/2026
	@version    12
/*/
//------------------------------------------------------------------------------
Method getList(nPage as Numeric, nPageSize as Numeric, aURLFilter as Array, cFields as Character, cSort as Character,;
cSearchText as Character, cFeatureId as Character) class ProductFeaturesListProtheusData
	Local aArea := FwGetArea()

	Default nPage       := 1
	Default nPageSize   := 10
	Default aURLFilter  := {}
	Default cFields     := ""
	Default cSort       := ""
	Default cSearchText := ""
	Default cFeatureId  := ""

	::setPage(nPage) // Define a página atual
	::setPageSize(nPageSize) // Define o tamanho da página
	::SetQuery(GetQueryD4W(::oMainExec)) // Define a query utilizada
	::SetWhere(GetFilterD4W(cFeatureId)) // Define o filtro utilizado
	::SetOrder("D4W_FILIAL", "D4W_CODATR", "D4W_VALOR") // Define a ordenação padrão

	::setIsCaseSensitive(.T.) // Define a consulta como case sensitive, para que o filtro de pesquisa funcione corretamente

	AddMapFieldsD4W(self)

	If !Empty(cSort)
		::SetOrderQuery(cSort) // Define a ordenação personalizada
	EndIf

	If !Empty(cFields)
		::SetFields(cFields) // Define os campos que serão retornados
	Endif

	If ::Execute()
		::FillGetResponse() // Preenche o response com os dados retornados
	EndIf

	FwRestArea(aArea)
	aSize(aArea, 0)
Return Nil

//------------------------------------------------------------------------------
/*/{Protheus.doc} RowToJson
	Converte o retorno da consulta SQL em JSON

	@sample     oCategoryData:RowToJson( cAlias, aFields, .F.)
	@type       method
	@param      cAlias , Character, Alias da Consulta
	@param      aFields, Array    , Campos (MapFields)
	@param      lEmpty , Logical  , Indica se o valor do campo deve ser retornado vazio
	@author     cruz.rafael / Squad Retail
	@since      15/01/2026
	@version    12
/*/
//------------------------------------------------------------------------------
METHOD rowToJson(cAlias as Character, aFields as Array, lEmpty as Logical) CLASS ProductFeaturesListProtheusData
	Local nLoop    as Integer
	Local cContent as Character

	Default cAlias  := ""
	Default aFields := {}
	Default lEmpty  := .T.

	// Adiciona o campo 'key' com o InternalId codificado em Base64
	If !Empty((cAlias)->internalId)
		Self:oJsonObj:setProp('key', Encode64((cAlias)->internalId), .F.) // Adiciona o campo key codificado em base64 no Json
	EndIf

	If FwIsInCallStack("getPrdFeatures") .And. !Empty((cAlias)->internalId)
		Self:oJsonObj:setProp('keySB1', Encode64((cAlias)->D4X_FILIAL + (cAlias)->D4X_PROD), .F.) // Adiciona o campo keySB1 codificado em base64 no Json
	EndIf

	// Processa os demais campos
	For nLoop := 1 to Len(aFields)
		cContent := ''
		If !lEmpty
			cContent := ::ValueToJson(aFields[nLoop, LABEL], (cAlias)->( &(aFields[nLoop, VALUE])))
		EndIf

		Self:oJsonObj:setProp(aFields[nLoop, LABEL], cContent, lEmpty)
	Next nLoop

Return Nil

//------------------------------------------------------------------------------
/*/{Protheus.doc} AddMapFieldsD4X
	Cria o Mapa de campos Protheus x API para as características.

	@sample     AddMapFieldsD4X( self )
	@type       Function
	@param      oSelf, Object, Objeto com herança da classe FWAdapterBaseV2
	@author     cruz.rafael / Squad Retail
	@since      15/01/2026
	@version    12
/*/
//------------------------------------------------------------------------------
Static Function AddMapFieldsD4X(oSelf as Object)
	Local aInternalId := GetInternalId( { "D4X_FILIAL", "D4X_PROD", "D4X_CARAC","D4X_VALOR","D4X_CATEGO"} )

	oSelf:AddMapFields("internalId" , "internalId", .T., .T., { "internalId", 'C', aInternalId[1], 0 }, aInternalId[2])
	oSelf:AddMapFields("branchId"   , "D4X_FILIAL", .T., .F., { "D4X_FILIAL", 'C', GetFieldLength("D4X_FILIAL"), 0 })
	oSelf:AddMapFields("productId"  , "D4X_PROD"  , .T., .T., { "D4X_PROD"  , 'C', GetFieldLength("D4X_PROD")  , 0 })
	oSelf:AddMapFields("featureId"  , "D4X_CARAC" , .T., .T., { "D4X_CARAC" , 'C', GetFieldLength("D4X_CARAC") , 0 })
	oSelf:AddMapFields("value"      , "D4X_VALOR" , .T., .F., { "D4X_VALOR" , 'C', GetFieldLength("D4X_VALOR") , 0 })
	oSelf:AddMapFields("category"   , "D4X_CATEGO", .T., .F., { "D4X_CATEGO", 'C', GetFieldLength("D4X_CATEGO"), 0 })
	oSelf:AddMapFields("selectType" , "D4V_TPSEL" , .T., .F., { "D4V_TPSEL" , 'C', GetFieldLength("D4V_TPSEL") , 0 })
	oSelf:AddMapFields("featureType", "D4V_TIPO"  , .T., .F., { "D4V_TIPO"  , 'C', GetFieldLength("D4V_TIPO")  , 0 })
	oSelf:AddMapFields("f3Consult"  , "D4V_F3"    , .T., .F., { "D4V_F3"    , 'C', GetFieldLength("D4V_F3")    , 0 })
	oSelf:AddMapFields("featureName", "D4V_NOME"  , .T., .F., { "D4V_NOME"  , 'C', GetFieldLength("D4V_NOME")  , 0 })

Return Nil

//------------------------------------------------------------------------------
/*/{Protheus.doc} AddMapFieldsD4W
	Cria o Mapa de campos Protheus x API para as características.

	@sample     AddMapFieldsD4W( self )
	@type       Function
	@param      oSelf, Object, Objeto com herança da classe FWAdapterBaseV2
	@author     cruz.rafael / Squad Retail
	@since      15/01/2026
	@version    12
/*/
//------------------------------------------------------------------------------
Static Function AddMapFieldsD4W(oSelf as Object)
	Local aInternalId := GetInternalId( { "D4W_FILIAL","D4W_CODATR","D4W_VALOR"} )

	oSelf:AddMapFields("internalId" , "internalId", .T., .T., { "internalId", 'C', aInternalId[1], 0 }, aInternalId[2])
	oSelf:AddMapFields("branchId"   , "D4W_FILIAL", .T., .F., { "D4W_FILIAL", 'C', GetFieldLength("D4W_FILIAL"), 0 })
	oSelf:AddMapFields("featureId"  , "D4W_CODATR", .T., .T., { "D4W_CODATR", 'C', GetFieldLength("D4W_CODATR"), 0 })
	oSelf:AddMapFields("value"      , "D4W_VALOR" , .T., .F., { "D4W_VALOR" , 'C', GetFieldLength("D4W_VALOR") , 0 })

Return Nil

//------------------------------------------------------------------------------
/*/{Protheus.doc} GetQueryD4W
	Obtém a Query utilizada para buscar as características de produtos

	@sample     GetQueryD4W()
	@type       Function
	@param      oMainExec, Object, Objeto de execução da query
	@return     cQuery, character, expressão SQL
	@author     cruz.rafael / Squad Retail
	@since      15/01/2026
	@version    12
/*/
//------------------------------------------------------------------------------
Static Function GetQueryD4W(oMainExec as object)
	Local cQuery as character
	Local nParam as Numeric

	Default oMainExec := NIL

	nParam := 1

	If oMainExec == NIL

		cQuery := " SELECT ?" // #1
		cQuery +=   " FROM " + RetSqlName('D4W') + " D4W"
		cQuery +=  " INNER JOIN " + RetSqlName("D4V") + " D4V"
		cQuery +=     " ON ?" // #2
		cQuery +=    " AND D4V.D4V_COD = D4W.D4W_CODATR"
		cQuery +=    " AND D4V.D_E_L_E_T_ = ?" // #3
		cQuery +=  " WHERE ?" // #4

		oMainExec := FWExecStatement():new(cQuery)

	EndIf

	oMainExec:setUnsafe(nParam++, "#QueryFields#") // #1
	oMainExec:setUnsafe(nParam++, FWJoinFilial("D4V", "D4W")) // #2
	oMainExec:setString(nParam++, space(1)) // #3
	oMainExec:setUnsafe(nParam++, "#QueryWhere#") // #4

	cQuery := oMainExec:getFixQuery()

Return cQuery

//------------------------------------------------------------------------------
/*/{Protheus.doc} GetQueryD4X
	Obtém a Query utilizada para buscar as características de produtos

	@sample     GetQueryACU()
	@type       Function
	@param      oMainExec, Object, Objeto de execução da query
	@return     cQuery, character, expressão SQL
	@author     cruz.rafael / Squad Retail
	@since      15/01/2026
	@version    12
/*/
//------------------------------------------------------------------------------
Static Function GetQueryD4X(oMainExec as object)
	Local cQuery as character
	Local nParam as numeric

	Default oMainExec := NIL

	nParam := 1

	If oMainExec == NIL
	
		cQuery := " SELECT ?" // #1
		cQuery +=   " FROM " + RetSqlName('D4X') + " D4X"
		cQuery +=  " INNER JOIN " + RetSqlName("D4V") + " D4V"
		cQuery +=     " ON ?" // #2
		cQuery +=    " AND D4V.D4V_COD = D4X.D4X_CARAC"
		cQuery +=    " AND D4V.D_E_L_E_T_ = ?" // #3
		cQuery +=  " WHERE ?" // #4

		oMainExec := FWExecStatement():new(cQuery)

	EndIf

	oMainExec:setUnsafe(nParam++, "#QueryFields#") // #1
	oMainExec:setUnsafe(nParam++, FWJoinFilial("D4V", "D4X")) // #2
	oMainExec:setString(nParam++, space(1)) // #3
	oMainExec:setUnsafe(nParam++, "#QueryWhere#") // #4

	cQuery := oMainExec:getFixQuery()

Return cQuery

//------------------------------------------------------------------------------
/*/{Protheus.doc} GetFilterD4X
	Obtem o filtro da D4X.

	@sample     GetFilterD4X()
	@type       Function
	@param      cSearchText , Character, Texto de pesquisa
	@param      cProductId  , Character, Código do produto para filtro de características
	@return     cWhere   , Character, Expressão utilizada na consulta
	@author     cruz.rafael / Squad Retail
	@since      15/01/2026
	@version    12
/*/
//------------------------------------------------------------------------------
Static Function GetFilterD4X(cProductId as Character) as Character
	Local cWhere as Character

	Default cProductId := ""

	cWhere :=     " D4X.D4X_FILIAL = '" + FwXFilial("D4X") + "'"
	cWhere += " AND D4X.D_E_L_E_T_ = ' ' "

	If !Empty(cProductId)
		cWhere += " AND D4X.D4X_PROD = '" + cProductId + "' "
	EndIf

return cWhere

//------------------------------------------------------------------------------
/*/{Protheus.doc} GetFilterD4W
	Obtem o filtro da D4W.

	@sample     GetFilterD4W()
	@type       Function
	@param      cFeatureID  , Character, Código da característica para filtro de características
	@return     cWhere   , Character, Expressão utilizada na consulta
	@author     cruz.rafael / Squad Retail
	@since      15/01/2026
	@version    12
/*/
//------------------------------------------------------------------------------
Static Function GetFilterD4W(cFeatureID as Character) as Character
	Local cWhere as Character

	Default cFeatureID := ""

	cWhere :=     " D4W.D4W_FILIAL = '" + FwXFilial("D4W") + "'"
	cWhere += " AND D4W.D_E_L_E_T_ = ' ' "
	If !Empty( cFeatureID )
		cFeatureID := Upper(AllTrim(cFeatureID))
		cWhere += " AND D4W.D4W_CODATR = '" + cFeatureID + "' "
	EndIf

return cWhere
//------------------------------------------------------------------------------
/*/{Protheus.doc} postUpdatePrdFeatureValues
	Atualiza valores das características de produtos (D4X_VALOR)

	@sample     oData:postUpdatePrdFeatureValues(jBody)
	@type       method
	@param      jBody, Json, JSON contendo productId/productCode e array com features
	@return     Json, resposta da operação
	@author     Daniel Tonon / Squad Retail
	@since      16/03/2026
	@version    12
/*/
//------------------------------------------------------------------------------
Method postUpdatePrdFeatureValues(jBody as Json) as Json Class ProductFeaturesListProtheusData
	Local jResponse   as Json
	Local cProductId  as Character
	Local aFeatures   as Array
	Local nLoop       as Numeric
	Local jFeature    as Json
	Local cFeatureId  as Character
	Local cValue      as Character
	Local cSelectType as Character
	Local cCategory   as Character
	Local lDeleted    as Logical
	Local aProcessed  as Array
	Local cFilD4X     as Character
	Local lIncluiD4X  as Logical
	Local aArea       as Array
	Local aAreaD4X    as Array
	Local nTamProd    as Numeric
	Local cTypeMsg    as Character

	Default jBody := JsonObject():new()

	jResponse  := JsonObject():new()
	cProductId := ""
	aFeatures  := {}
	nLoop      := 1
	jFeature   := JsonObject():new()
	cFeatureId := ""
	cValue     := ""
	cSelectType:= ""
	cCategory  := ""
	lDeleted   := .F.
	aProcessed := {}
	cFilD4X    := FwXFilial('D4X')
	lIncluiD4X := .T.
	aArea      := FwGetArea()
	aAreaD4X   := D4X->(FwGetArea())
	cTypeMsg   := ""

	nTamProd   := GetSx3Cache("B1_COD", "X3_TAMANHO")
	aFeatures  := jBody["features"]
	cProductId := PadR(jBody["productId"], nTamProd, " ")

	DbSelectArea("D4X")
	D4X->(DbSetOrder(1))

	For nLoop := 1 to Len(aFeatures)
		jFeature := aFeatures[nLoop]

		If jFeature:HasProperty("featureId") .And. jFeature:HasProperty("value")
			cFeatureId := jFeature["featureId"]
			cValue     := AllTrim(jFeature["value"])
			cSelectType:= AllTrim(jFeature["selectType"])
			cCategory  := AllTrim(jFeature["category"])

			// Se selectType = "2" e ainda não foi deletado, deleta registros existentes
			If cSelectType == "2" .And. !lDeleted
				D4X->(DbSeek(cFilD4X + cProductId + cFeatureId))
				While !D4X->(Eof()) .And. D4X->D4X_FILIAL == cFilD4X .And. ;
					D4X->D4X_PROD == cProductId
					D4X->(RecLock("D4X", .F.))
					D4X->(DbDelete())
					D4X->(MsUnlock())
					D4X->(DbSkip())
				EndDo
				lDeleted := .T.
			EndIf

			// Quando selectType = "2", inclui novo registro apenas primeira vez com valor vazio
			If cSelectType == "2"
				If Empty(cValue)
					If AScan(aProcessed, cFeatureId) == 0
						aAdd(aProcessed, cFeatureId)
						lIncluiD4X := .T.
					Else
						lIncluiD4X := .F.
					EndIf
				Else
					lIncluiD4X := .T.
				EndIf
				If lIncluiD4X
					D4X->(RecLock("D4X", .T.))
					D4X->D4X_FILIAL  := cFilD4X
					D4X->D4X_PROD    := cProductId
					D4X->D4X_CARAC   := cFeatureId
					D4X->D4X_VALOR   := cValue
					D4X->D4X_CATEGO  := cCategory
					D4X->(MsUnlock())
				EndIf
			Else
				// Para outros tipos, atualizar
				If D4X->(DbSeek(cFilD4X + cProductId + cFeatureId))
					D4X->(RecLock("D4X", .F.))
					D4X->D4X_VALOR := cValue
					D4X->(MsUnlock())
				EndIf
			EndIf
			cTypeMsg := "1" // Sucesso
		Else
			cTypeMsg := "2" // Erro
		EndIf

	Next nLoop

	If cTypeMsg == "1"
		jResponse["message"] := FWHttpEncode(STR0001) // "Características atualizadas com sucesso"
	ElseIf cTypeMsg == "2"
		jResponse["error"] := FWHttpEncode(STR0002) // "Erro ao valorar produto"
	EndIf

	FwRestArea(aAreaD4X)
	FwRestArea(aArea)
	FwFreeArray(aAreaD4X)
	FwFreeArray(aArea)

Return jResponse
