#include "tlpp-core.th"
#include "backoffice.categories.productfeatures.controller.ch"

namespace totvs.protheus.backoffice.categories.productfeatures
using namespace totvs.protheus.backoffice.categories.util

//------------------------------------------------------------------------------
/*/{Protheus.doc} productFeatures
	API para consulta de características de produtos (D4V/D4W)
	@type       class
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Class ProductFeatures
	Data jResponse  as Json
	Data nPage      as Numeric
	Data nPageSize  as Numeric
	Data oService   as Object

	Public Method new() as Object

	@Get("/api/categories/v1/productFeatures") // Listar todos as características de produtos
	Public Method getFeatures() as Logical

	@Get("/api/categories/v1/productFeaturesbySearch/:search") // Listar características de produtos por texto de pesquisa
	Public Method getFeaturesbySearch() as Logical

	@Get("/api/categories/v1/productFeaturesbyCategory") // Listar características de produtos de uma categoria
	Public Method getFeaturesbyCategory() as Logical

endClass

//------------------------------------------------------------------------------
/*/{Protheus.doc} productFeatures::new() as Object
	Obtém uma nova instancia da classe productFeatures
	@type       method
	@return     object, retorna uma nova instancia da classe.
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method new() as Object Class productFeatures
	::jResponse := JsonObject():new()
	::nPage     := 1
	::nPageSize := 10000
	::oService  := FeaturesService():getInstance()
return self

//------------------------------------------------------------------------------
/*/{Protheus.doc} productFeatures::getFeatures() as Logical
	Obtem uma lista de características de produtos, possibilitando filtrar (QueryParam - FILTER) 
	os produtos e permitindo retornar todos	os campos ou somente os campos 
	especificados no QueryParam FIELDS.
	Observação: Ao utilizar o getFeatures o campo DELETED não será retornado. 
	@type       method
	@return     logical, Verdadeiro
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getFeatures() as Logical Class productFeatures
	Local aItems                                 as Array
	Local aURLFilter := GetFilterParam()         as Array
	Local cFields    := GetQueryParam('FIELDS')  as Character
	Local cSort      := GetQueryParam('SORT')    as Character

	oRest:setKeyHeaderResponse('content-type', 'application/json')

	getPageAndPageSize(@::nPage, @::nPageSize)
	::jResponse:fromJson(::oService:getFeatures(::nPage, ::nPageSize, aURLFilter, cFields, cSort, ""))
	aItems := ::jResponse:GetJsonObject( "items" )

	If Empty( aURLFilter ) .Or. ( !Empty( aItems ) .And. Len( aItems ) > 0 )
		oRest:setResponse(::jResponse)
		aSize(aItems, 0)
	Else
		SetRestFault(404, FWHttpEncode(STR0001) ) // "Característica não localizada"
	Endif

	aSize(aURLFilter, 0)
return .T.

//------------------------------------------------------------------------------
/*/{Protheus.doc} productFeatures::getFeaturesbySearch() as Logical
	Obtem uma lista de características de produtos, possibilitando filtrar (QueryParam - FILTER) 
	os produtos e permitindo retornar todos os campos ou somente os campos 
	especificados no QueryParam FIELDS.
	Observação: Ao utilizar o getFeaturesbySearch o campo DELETED não será retornado. 
	@type       method
	@return     logical, Verdadeiro
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getFeaturesbySearch() as Logical Class productFeatures
	Local aItems                                 as Array
	Local aURLFilter := GetFilterParam()         as Array
	Local cFields    := GetQueryParam('FIELDS')  as Character
	Local cSort      := GetQueryParam('SORT')    as Character

	oRest:setKeyHeaderResponse('content-type', 'application/json')

	getPageAndPageSize(@::nPage, @::nPageSize)
	::jResponse:fromJson(::oService:getFeatures(::nPage, ::nPageSize, aURLFilter, cFields, cSort, GetPathParams("search")))
	aItems := ::jResponse:GetJsonObject( "items" )

	If Empty( aURLFilter ) .Or. ( !Empty( aItems ) .And. Len( aItems ) > 0 )
		oRest:setResponse(::jResponse)
		aSize(aItems, 0)
	Else
		SetRestFault(404, FWHttpEncode(STR0001) ) // "Característica não localizada"
	Endif

	aSize(aURLFilter, 0)
return .T.

//------------------------------------------------------------------------------
/*/{Protheus.doc} productFeatures::getFeaturesbyCategory() as Logical
	Obtem uma lista de características de produtos, possibilitando filtrar (QueryParam - FILTER) 
	os produtos e permitindo retornar todos os campos ou somente os campos 
	especificados no QueryParam FIELDS.
	Observação: Ao utilizar o getFeaturesbyCategory o campo DELETED não será retornado. 
	@type       method
	@return     logical, Verdadeiro
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getFeaturesbyCategory() as Logical Class productFeatures
	Local aItems                                               as Array
	Local aURLFilter   := GetFilterParam()                     as Array
	Local cFields      := GetQueryParam('FIELDS')              as Character
	Local cSort        := GetQueryParam('SORT')                as Character
	Local cCategory    := GetQueryParam('CATEGORY')            as Character
	Local cInheritedAt := GetQueryParam('INHERITEDATT')        as Character
	Local lInheritedAt := cInheritedAt <> "FALSE"              as Logical // Indica se deve retornar características herdadas
	Local lExistCat    := .F.                                  as Logical // Indica se a categoria existe
	Local aAreaACU     := ACU->(GetArea())                     as Array

	oRest:setKeyHeaderResponse('content-type', 'application/json')

	DbSelectArea("ACU")
	ACU->(DbSetOrder(1))
	If ACU->(DbSeek(xFilial("ACU") + cCategory ))
		lExistCat := .T.
	EndIf

	If lExistCat
		getPageAndPageSize(@::nPage, @::nPageSize)
		::jResponse:fromJson(::oService:getCategFeatures(::nPage, ::nPageSize, aURLFilter, cFields, cSort, "", cCategory, lInheritedAt))
		aItems := ::jResponse:GetJsonObject( "items" )

		If Empty( aURLFilter ) .Or. ( !Empty( aItems ) .And. Len( aItems ) > 0 )
			oRest:setResponse(::jResponse)
			aSize(aItems, 0)
		Else
			SetRestFault(404, FWHttpEncode(STR0001) ) // "Característica não localizada"
		Endif
	Else
		SetRestFault(404, FWHttpEncode(STR0001) ) // "Característica não localizada"
	EndIf

	RestArea(aAreaACU)

	aSize(aURLFilter, 0)
return .T.
