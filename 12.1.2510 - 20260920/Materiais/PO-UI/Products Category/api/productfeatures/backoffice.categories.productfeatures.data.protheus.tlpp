#include "tlpp-core.th"
#include "backoffice.categories.productfeatures.data.protheus.ch"

namespace totvs.protheus.backoffice.categories.productfeatures
using namespace totvs.protheus.backoffice.categories.util

#DEFINE LABEL 1
#DEFINE VALUE 2

//------------------------------------------------------------------------------
/*/{Protheus.doc} FeaturesProtheusData
	Efetua a consulta de atributos de produtos do Protheus.

	@type       Class
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Class FeaturesProtheusData from FWAdapterBaseV2

	Public Method new() as Object
	Public Method getFeatures()
	Public Method getCategFeatures()
	Public Method rowToJson()

	protected data oMainExec as object

EndClass

//------------------------------------------------------------------------------
/*/{Protheus.doc} new
	Construtor da classe FeaturesProtheusData

	@sample     FeaturesProtheusData():New("GET", .T.)
	@type       method
	@param      cVerbo, Character, Verbo que será utilizado na requisição
	@param      lList , Logical  , Se irá listar o Json
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method new() as Object Class FeaturesProtheusData
	_Super:New("GET", .T.)
Return Self

//------------------------------------------------------------------------------
/*/{Protheus.doc} getFeatures
	Efetua a consulta de atributos de Produtos (D4V).

	@sample     oFeatureData:Get(1, 10, {}, 'code, description', '-code', Nil)
	@type       method
	@param      nPage       , Numeric   , Número da página que será retornada
	@param      nPageSize   , Numeric   , Quantidade de registros por página
	@param      aURLFilter  , Array     , Lista de Filtros no padrão do FWAdapterBaseV2
	@param      cFields     , Character , Lista de campos que devem ser retornados
	@param      cSort       , Character , Ordernação do Response
	@param      cSearchText , Character , Texto de pesquisa
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getFeatures(nPage as Numeric, nPageSize as Numeric, aURLFilter as Array, cFields as Character, cSort as Character,;
 cSearchText as Character) class FeaturesProtheusData
	Local aArea := GetArea()

	Default nPage       := 1
	Default nPageSize   := 10
	Default aURLFilter  := {}
	Default cFields     := ""
	Default cSort       := ""
	Default cSearchText := ""

	::setPage( nPage ) // Define a página atual
	::setPageSize( nPageSize ) // Define o tamanho da página
	::setQuery( GetQueryD4V(::oMainExec) ) // Define a query utilizada
	::setWhere( GetFilterD4V(cSearchText) ) // Define o filtro utilizado
	::setOrder( "D4V_FILIAL, D4V_NOME" ) // Define a ordenação padrão

	::setIsCaseSensitive(.T.) // Define a consulta como case sensitive, para que o filtro de pesquisa funcione corretamente

	AddMapFieldsD4V( self )

	If !Empty( aURLFilter ) .And. Len( aURLFilter ) > 0
		::SetUrlFilter( aURLFilter ) // Define o filtro da URL
	Endif

	If !Empty( cSort )
		::SetOrderQuery( cSort ) // Define a ordenação personalizada
	EndIf

	If !Empty( cFields )
		::SetFields( cFields ) // Define os campos que serão retornados
	Endif

	If ::Execute()
		::FillGetResponse() // Preenche o response com os dados retornados
	EndIf

	RestArea( aArea )
	aSize( aArea, 0 )
Return Nil

//------------------------------------------------------------------------------
/*/{Protheus.doc} getCategFeatures
	Efetua a consulta de atributos de Produtos x Categorias (AQU).

	@sample     oFeatureData:Get(1, 10, {}, 'code, description', '-code', Nil)
	@type       method
	@param      nPage       , Numeric   , Número da página que será retornada
	@param      nPageSize   , Numeric   , Quantidade de registros por página
	@param      aURLFilter  , Array     , Lista de Filtros no padrão do FWAdapterBaseV2
	@param      cFields     , Character , Lista de campos que devem ser retornados
	@param      cSort       , Character , Ordernação do Response
	@param      cSearchText , Character , Texto de pesquisa
	@param      cCategory   , Character , Categoria para filtro de atributos
	@param      lInherited  , Logical   , Indica se deve trazer atributos herdados
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getCategFeatures(nPage as Numeric, nPageSize as Numeric, aURLFilter as Array, cFields as Character, cSort as Character,;
 cSearchText as Character, cCategory as Character, lInheritedAt as Logical) class FeaturesProtheusData
	Local aArea := GetArea()

	Default nPage        := 1
	Default nPageSize    := 10
	Default aURLFilter   := {}
	Default cFields      := ""
	Default cSort        := ""
	Default cSearchText  := ""
	Default cCategory    := ""
	Default lInheritedAt := .F.

	::setPage( nPage ) // Define a página atual
	::setPageSize( nPageSize ) // Define o tamanho da página
	::setQuery( GetQueryAQU(::oMainExec, cCategory)) // Define a query utilizada
	::setWhere( GetFilterAQU( cSearchText, cCategory, lInheritedAt)) // Define o filtro utilizado
	::setOrder( "AQU_FILIAL, AQU_CATEG, AQU_CARAC") // Define a ordenação padrão

	::setIsCaseSensitive(.T.) // Define a consulta como case sensitive, para que o filtro de pesquisa funcione corretamente

	AddMapFieldsAQU( self )

	If !Empty( aURLFilter ) .And. Len( aURLFilter ) > 0
		::SetUrlFilter( aURLFilter ) // Define o filtro da URL
	Endif

	If !Empty( cSort )
		::SetOrderQuery( cSort ) // Define a ordenação personalizada
	EndIf

	If !Empty( cFields )
		::SetFields( cFields ) // Define os campos que serão retornados
	Endif

	If ::Execute()
		::FillGetResponse() // Preenche o response com os dados retornados
	EndIf

	RestArea( aArea )
	aSize( aArea, 0 )
Return Nil

//------------------------------------------------------------------------------
/*/{Protheus.doc} rowToJson
	Converte o retorno da consulta SQL em JSON

	@sample     oCategoryData:RowToJson( cAlias, aFields, .F.)
	@type       method
	@param      cAlias , Character, Alias da Consulta
	@param      aFields, Array    , Campos (MapFields)
	@param      lEmpty , Logical  , Vazio.
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
METHOD rowToJson(cAlias as Character, aFields as Array, lEmpty as Logical) CLASS FeaturesProtheusData
	Local nLoop    as Integer
	Local cContent as Character

	Default cAlias  := ""
	Default aFields := {}
	Default lEmpty  := .F.

	If !Empty(cAlias)
		If !Empty((cAlias)->internalid)
			Self:oJsonObj:setProp('key', Encode64((cAlias)->internalid), .F.) // Adiciona o campo key codificado em base64 no Json
		EndIf
		For nLoop := 1 to Len( aFields )
			If lEmpty
				cContent := ''
			Else
				cContent := ::ValueToJson( aFields[nLoop, LABEL], (cAlias)->( &(aFields[nLoop, VALUE]) )  )
			EndIf
			Self:oJsonObj:setProp( aFields[nLoop, LABEL], cContent, lEmpty  )
		Next
	EndIf

Return Nil

//------------------------------------------------------------------------------
/*/{Protheus.doc} AddMapFieldsD4V
	Cria o Mapa de campos Protheus x API para os atributos.

	@sample     AddMapFieldsD4V( self )
	@type       Function
	@param      oSelf, Object, Objeto com herança da classe FWAdapterBaseV2
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Function AddMapFieldsD4V(oSelf as Object)
	Local aInternalId := GetInternalId( { "D4V_FILIAL", "D4V_COD" } )

	oSelf:AddMapFields("internalId"    , "internalId", .T., .T., { "internalId", 'C', aInternalId[1], 0 }, aInternalId[2])
	oSelf:AddMapFields("branchId"      , "D4V_FILIAL", .T., .F., { "D4V_FILIAL", 'C', GetFieldLength("D4V_FILIAL"), 0 })
	oSelf:AddMapFields("code"          , "D4V_COD"   , .T., .T., { "D4V_COD"   , 'C', GetFieldLength("D4V_COD")   , 0 })
	oSelf:AddMapFields("description"   , "D4V_NOME"  , .T., .T., { "D4V_NOME"  , 'C', GetFieldLength("D4V_NOME")  , 0 })
	oSelf:AddMapFields("typeFeature"   , "D4V_TIPO"  , .T., .F., { "D4V_TIPO"  , 'C', GetFieldLength("D4V_TIPO")  , 0 })
	oSelf:AddMapFields("typeOccurrence", "D4V_TPSEL" , .T., .F., { "D4V_TPSEL" , 'C', GetFieldLength("D4V_TPSEL") , 0 })
	oSelf:AddMapFields("f3"            , "D4V_F3"    , .T., .F., { "D4V_F3"    , 'C', GetFieldLength("D4V_F3")    , 0 })
	oSelf:AddMapFields("secction"      , "D4V_SECAO" , .T., .F., { "D4V_SECAO" , 'C', GetFieldLength("D4V_SECAO") , 0 })
Return Nil

//------------------------------------------------------------------------------
/*/{Protheus.doc} GetQueryD4V
	Obtém a Query utilizada para buscar os atributos de produtos

	@sample     GetQueryACU()
	@type       Function
	@param      oMainExec, Object, Objeto de execução da query
	@return     cQuery, character, expressão SQL
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Function GetQueryD4V(oMainExec as object) as Character
	Local cQuery as character
	Local nParam as Numeric

	Default oMainExec := NIL

	nParam := 1

	If oMainExec == NIL
	
		cQuery := " SELECT ?"
		cQuery +=   " FROM " + RetSqlName('D4V') + " D4V "
		cQuery +=  " WHERE ?"

		oMainExec := FWExecStatement():new(cQuery)
	
	EndIf

	oMainExec:setUnsafe(nParam++, "#QueryFields#")
	oMainExec:setUnsafe(nParam++, "#QueryWhere#")

	cQuery := oMainExec:getFixQuery()

Return cQuery

//------------------------------------------------------------------------------
/*/{Protheus.doc} GetFilterD4V
	Obtem o filtro da D4V utilizada no TOTVS Gestão de Vendas

	@sample     getFilterD4V()
	@type       Function
	@param      cSearchText , Character, Texto de pesquisa
	@return     cWhere   , Character, Expressão utilizada na consulta
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Function GetFilterD4V(cSearchText as Character) as Character
	Local cWhere as Character

	Default cSearchText := ""

	cWhere :=         " D4V.D4V_FILIAL = '" + FwXFilial("D4V") + "'"
	cWhere +=     " AND D4V.D_E_L_E_T_ = ' ' "
	If !Empty( cSearchText )
		cSearchText := Upper(AllTrim(cSearchText))
		cWhere += " AND ( UPPER(D4V.D4V_COD) LIKE '%" + cSearchText + "%' OR UPPER(D4V.D4V_NOME) LIKE '%" + cSearchText + "%')"
	EndIf

return cWhere

//------------------------------------------------------------------------------
/*/{Protheus.doc} AddMapFieldsAQU
	Cria o Mapa de campos Protheus x API para os atributos.

	@sample     AddMapFieldsAQU( self )
	@type       Function
	@param      oSelf, Object, Objeto com herança da classe FWAdapterBaseV2
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Function AddMapFieldsAQU(oSelf as Object)
	Local aInternalId := GetInternalId({"AQU_FILIAL", "AQU_CATEG", "AQU_CARAC"})

	oSelf:AddMapFields("internalId"    , "internalId", .T., .T., { "internalId"  , 'C', aInternalId[1]              , 0 }, aInternalId[2])
	oSelf:AddMapFields("branchId"      , "AQU_FILIAL", .T., .F., { "AQU_FILIAL"  , 'C', GetFieldLength("AQU_FILIAL"), 0 }, "ATRCAT.AQU_FILIAL")
	oSelf:AddMapFields("feature"       , "AQU_CARAC" , .T., .F., { "AQU_CARAC"   , 'C', GetFieldLength("AQU_CARAC") , 0 }, "ATRCAT.AQU_CARAC")
	oSelf:AddMapFields("descFeature"   , "D4V_NOME"  , .T., .F., { "D4V_NOME"    , 'C', GetFieldLength("D4V_NOME")  , 0 }, "ATRCAT.D4V_NOME")
	oSelf:AddMapFields("category"      , "ACU_COD"   , .T., .T., { "ACU_COD"     , 'C', GetFieldLength("ACU_COD")   , 0 }, "ATRCAT.ACU_COD")
	oSelf:AddMapFields("descCategory"  , "ACU_DESC"  , .T., .T., { "ACU_DESC"    , 'C', GetFieldLength("ACU_DESC")  , 0 }, "ATRCAT.ACU_DESC")
	oSelf:AddMapFields("typeAttribute" , "D4V_TIPO"  , .T., .F., { "D4V_TIPO"    , 'C', GetFieldLength("D4V_TIPO")  , 0 }, "ATRCAT.D4V_TIPO")
	oSelf:AddMapFields("typeOccurrence", "D4V_TPSEL" , .T., .F., { "D4V_TPSEL"   , 'C', GetFieldLength("D4V_TPSEL") , 0 }, "ATRCAT.D4V_TPSEL")
Return Nil

//------------------------------------------------------------------------------
/*/{Protheus.doc} GetQueryAQU
	Obtém a Query utilizada para buscar os atributos de produtos

	@sample     GetQueryAQU()
	@type       Function
	@param      oMainExec, Object, Objeto de execução da query
	@param      cCategory, Character, Categoria para filtro de atributos
	@return     cQuery, character, expressão SQL
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Function GetQueryAQU(oMainExec as object, cCategory as Character) as Character
	Local cQuery    as character
	Local nParam    as Numeric
	Local cParamSeg as Character
	Local cRaiz     as Character

	Default oMainExec := NIL
	Default cCategory := ""

	nParam := 1

	If oMainExec == NIL

		cRaiz     := Upper(STR0001) // "Raiz"
		cParamSeg := Upper(SuperGetMV("MV_CATSEGM", .F., STR0001)) // "Raiz"

		If !Empty(cParamSeg)
			cRaiz := cParamSeg
		EndIf

		cQuery := " SELECT ?" // #01
		cQuery +=   " FROM ( SELECT AQU.AQU_FILIAL,"
		cQuery +=                 " AQU.AQU_CATEG,"
		cQuery +=                 " AQU.AQU_CARAC,"
		cQuery +=                 " D4V.D4V_NOME,"
		cQuery +=                 " D4V.D4V_TIPO,"   // Tipo de Dado
        cQuery +=                 " D4V.D4V_TPSEL," // Tipo de Seleção
		cQuery +=                 " COALESCE((CASE WHEN ACU.ACU_COD = ? THEN ? ELSE ACU.ACU_COD END), ?) ACU_COD," // #02, #03, #04
		cQuery +=                 " COALESCE((CASE WHEN ACU.ACU_COD = ? THEN ? ELSE ACU.ACU_DESC END), ?) ACU_DESC" // #05, #06, #07
		cQuery +=            " FROM " + RetSqlName('AQU') + " AQU"
		cQuery +=            " LEFT JOIN " + RetSqlName('ACU') + " ACU"
		cQuery +=              " ON ?" // #08
		cQuery +=             " AND ACU.ACU_COD = AQU.AQU_CATEG"
		cQuery +=             " AND ACU.ACU_MSBLQL <> ?" // #09
		cQuery +=             " AND ACU.D_E_L_E_T_ = ?" // #10
		cQuery +=           " INNER JOIN " + RetSqlName('D4V') + " D4V"
		cQuery +=              " ON ?" // #11
		cQuery +=             " AND D4V.D4V_COD = AQU.AQU_CARAC"
		cQuery +=             " AND D4V.D_E_L_E_T_ = ?" // #12
		cQuery +=           " WHERE ?) ATRCAT" // #13

		cQuery := ChangeQuery(cQuery)

		oMainExec := FWExecStatement():new(cQuery)
	
	EndIf

	oMainExec:setUnsafe(nParam++, "#QueryFields#")            // #01
	oMainExec:setString(nParam++, cCategory)                  // #02
	oMainExec:setString(nParam++, Space(1))                   // #03
	oMainExec:setString(nParam++, cRaiz)                      // #04
	oMainExec:setString(nParam++, cCategory)                  // #05
	oMainExec:setString(nParam++, Space(1))                   // #06
	oMainExec:setString(nParam++, cRaiz)                      // #07
	oMainExec:setUnsafe(nParam++, FWJoinFilial("ACU", "AQU")) // #08
	oMainExec:setString(nParam++, "1")                        // #09
	oMainExec:setString(nParam++, Space(1))                   // #10
	oMainExec:setUnsafe(nParam++, FWJoinFilial("D4V", "AQU")) // #11
	oMainExec:setString(nParam++, Space(1))                   // #12
	oMainExec:setUnsafe(nParam++, "#QueryWhere#")             // #13

	cQuery := oMainExec:getFixQuery()

Return cQuery

//------------------------------------------------------------------------------
/*/{Protheus.doc} getFilterAQU
	Obtem o filtro da AQU utilizada no TOTVS Gestão de Vendas

	@sample     getFilterAQU()
	@type       Function
	@param      cSearchText , Character, Texto de pesquisa
	@param      cCategory   , Character, Categoria para filtro de atributos
	@param      lInheritedAt, Logical  , Indica se deve trazer atributos herdados
	@return     cWhere   , Character, Expressão utilizada na consulta
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Function GetFilterAQU(cSearchText as Character, cCategory as Character, lInheritedAt as Logical) as Character
	Local cWhere as Character

	Default cSearchText  := ""
	Default cCategory    := ""
	Default lInheritedAt := .F.

	cWhere :=         " AQU.AQU_FILIAL = '" + FwXFilial("AQU") + "'"
	If lInheritedAt
		cWhere +=     " AND AQU.AQU_CATEG IN (" + GetCategories(cCategory) + ")"
	Else
		cWhere +=     " AND AQU.AQU_CATEG = '" + cCategory + "'"
	EndIf
	cWhere +=     " AND AQU.D_E_L_E_T_ = ' ' "
	If !Empty( cSearchText )
		cSearchText := Upper(AllTrim(cSearchText))
		cWhere += " AND ( UPPER(AQU.AQU_CATEG) LIKE '%" + cSearchText + "%' OR UPPER(D4V.D4V_NOME) LIKE '%" + cSearchText + "%' OR"
		cWhere +=       " UPPER(AQU.AQU_CARAC) LIKE '%" + cSearchText + "%' OR UPPER(ACU.ACU_DESC) LIKE '%" + cSearchText + "%'"
		cWhere +=      ")"
	EndIf

return cWhere

//-------------------------------------------------------------------
/*/{Protheus.doc} GetCategories
	Monta uma string com as categorias (da que foi enviada até a raiz) para filtro

	@sample     GetCategories("0001")
	@type       Function
	@param      cCategory, Character, Categoria inicial
	@return     cCategories, Character, String com as categorias (da que foi enviada até a raiz) separadas por vírgula
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610

/*/
//-------------------------------------------------------------------
Static Function GetCategories(cCategory as Character) as Character
	Local cCategories As Character
	Local cFilialACU  As Character
	Local lRaiz       As Logical
	Local cEmptyCat   As Character

	Default cCategory := ""

	lRaiz       := .F.
	cFilialACU  := FwxFilial("ACU")
	cCategories := "'" + cCategory + "'"
	cEmptyCat   := Space(GetFieldLength("AQU_CATEG"))

	While !lRaiz
		// Busca o código pai da categoria atual
		cCategory := GetParentCat(cFilialACU, cCategory)

		If Empty(cCategory) // Se não houver categoria pai, será a raiz
			lRaiz     := .T.
			cCategory := cEmptyCat
		EndIf

		// Adiciona a categoria atual ao array
		cCategories += ", '" + cCategory + "'"
	EndDo

Return cCategories

//-------------------------------------------------------------------
/*/{Protheus.doc} GetParentCat
	Obtém o código da categoria pai da categoria informada

	@sample     GetCategories("0001")
	@type       Function
	@param      cFilialACU, Character, Filial do cadastro de categorias (ACU)
	@param      cCategory, Character, Categoria inicial
	@return     cParent, Character, Código da categoria pai
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610

/*/
//-------------------------------------------------------------------
Static Function GetParentCat(cFilialACU as Character, cCategory as Character) as Character
	Local cParent   As Character
	Local cQuery    As Character
	Local oQuery    As Object
	Local nParam    As Numeric
	Local cAliasPar As Character

	Default cFilialACU := FwxFilial("ACU")
	Default cCategory  := ""

	cParent   := ""
	cAliasPar := GetNextAlias()

	cQuery := " SELECT ACU.ACU_CODPAI"
	cQuery +=   " FROM " + RetSqlName("ACU") + " ACU"
	cQuery +=  " WHERE ACU.ACU_FILIAL = ?"  // #1
	cQuery +=    " AND ACU.ACU_COD = ?"     // #2
	cQuery +=    " AND ACU.ACU_MSBLQL <> ?" // #3
	cQuery +=    " AND ACU.D_E_L_E_T_ = ?"  // #4

	oQuery := FWExecStatement():New(cQuery)

	nParam := 1
	oQuery:SetString(nParam++, cFilialACU)  // #1
	oQuery:SetString(nParam++, cCategory)   // #2
	oQuery:SetString(nParam++, "1")         // #3
	oQuery:SetString(nParam++, Space(1))    // #4
	
	oQuery:OpenAlias(cAliasPar)

	If !(cAliasPar)->(EOF())
		cParent := (cAliasPar)->ACU_CODPAI
	EndIf

	(cAliasPar)->(DBCloseArea())

Return cParent
