#include "tlpp-core.th"
#include "backoffice.categories.productcategories.controller.ch"

namespace totvs.protheus.backoffice.categories.productcategories
using namespace totvs.protheus.backoffice.categories.util

//------------------------------------------------------------------------------
/*/{Protheus.doc} productCategories
	API para consulta de categorias de produtos (ACU)
	@type       class
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Class ProductCategories
	Data jResponse  as Json
	Data nPage      as Numeric
	Data nPageSize  as Numeric
	Data oService   as Object

	Public Method new() as Object

	@Get("/api/categories/v1/productCategories") // Listar Categorias de Produtos (árvore)
	Public Method getCategories() as Logical

	@Get("/api/categories/v1/productCategoriesbySearch/:search") // Listar Categorias de Produtos por Texto de Pesquisa
	Public Method getCategoriesbySearch() as Logical

	@Get("/api/categories/v1/inactivatedCategories") // Listar Categorias inativadas
	Public Method getInactivatedCategories() as Logical

	@Post("/api/categories/v1/activateCategories") // Ativar Categorias
	Public Method postActivateCategories() as Logical

	@Get("/api/categories/v1/productChildCategories/:category") // Listar Categorias de Produtos (árvore)
	Public Method getChildCategories() as Logical

	@Get("/api/categories/v1/rootName") // Renomear Categoria Raiz
	Public Method getRootName() as Logical

endClass

//------------------------------------------------------------------------------
/*/{Protheus.doc} productCategories::new() as Object
	Obtém uma nova instancia da classe productCategories
	@type       method
	@return     object, retorna uma nova instancia da classe.
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method new() as Object Class productCategories
	::jResponse := JsonObject():new()
	::nPage     := 1
	::nPageSize := 10000
	::oService  := CategoriesService():getInstance()
return self

//------------------------------------------------------------------------------
/*/{Protheus.doc} productCategories::getCategories() as Logical
	Obtem uma lista de categorias de produtos, possibilitando filtrar (QueryParam - FILTER) 
	os produtos e permitindo retornar todos	os campos ou somente os campos 
	especificados no QueryParam FIELDS.
	Observação: Ao utilizar o getCategories o campo DELETED não será retornado. 
	@type       method
	@return     logical, Verdadeiro
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getCategories() as Logical Class productCategories
	Local aItems                                 as Array
	Local aURLFilter := GetFilterParam()         as Array
	Local cFields    := GetQueryParam('FIELDS')  as Character
	Local cSort      := GetQueryParam('SORT')    as Character

	oRest:setKeyHeaderResponse('content-type', 'application/json')

	getPageAndPageSize(@::nPage, @::nPageSize)
	::jResponse:fromJson(::oService:getCategories(::nPage, ::nPageSize, aURLFilter, cFields, cSort))
	aItems := ::jResponse:GetJsonObject( "items" )

	If Empty( aURLFilter ) .Or. ( !Empty( aItems ) .And. Len( aItems ) > 0 )
		oRest:setResponse(::jResponse)
		aSize(aItems, 0)
	Else
		SetRestFault(404, FWHttpEncode(STR0001)) // "Categoria não localizada"
	Endif

	aSize(aURLFilter, 0)
return .T.

//------------------------------------------------------------------------------
/*/{Protheus.doc} productCategories::getCategoriesbySearch() as Logical
	Obtem uma lista de categorias de produtos, possibilitando filtrar (QueryParam - FILTER) 
	os produtos e permitindo retornar todos	os campos ou somente os campos 
	especificados no QueryParam FIELDS.

	@type       method
	@return     logical, Verdadeiro
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getCategoriesbySearch() as Logical Class productCategories
	Local aItems                                 as Array
	Local aURLFilter := GetFilterParam()         as Array
	Local cFields    := GetQueryParam('FIELDS')  as Character
	Local cSort      := GetQueryParam('SORT')    as Character

	oRest:setKeyHeaderResponse('content-type', 'application/json')

	getPageAndPageSize(@::nPage, @::nPageSize)
	::jResponse:fromJson(::oService:getCategories(::nPage, ::nPageSize, aURLFilter, cFields, cSort, GetPathParams("search")))
	aItems := ::jResponse:GetJsonObject( "items" )

	If Empty( aURLFilter ) .Or. ( !Empty( aItems ) .And. Len( aItems ) > 0 )
		oRest:setResponse(::jResponse)
		aSize(aItems, 0)
	Else
		SetRestFault(404, FWHttpEncode(STR0001)) // "Categoria não localizada"
	Endif

	aSize(aURLFilter, 0)
return .T.

//------------------------------------------------------------------------------
/*/{Protheus.doc} productCategories::getInactivatedCategories() as Logical
	Obtem uma lista de categorias inativadas, possibilitando filtrar (QueryParam - FILTER) 
	os produtos e permitindo retornar todos	os campos ou somente os campos 
	especificados no QueryParam FIELDS.

	@type       method
	@return     logical, Verdadeiro
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getInactivatedCategories() as Logical Class productCategories
	Local aItems                                 as Array
	Local aURLFilter := GetFilterParam()         as Array
	Local cFields    := GetQueryParam('FIELDS')  as Character
	Local cSort      := GetQueryParam('SORT')    as Character

	oRest:setKeyHeaderResponse('content-type', 'application/json')

	getPageAndPageSize(@::nPage, @::nPageSize)
	::jResponse:fromJson(::oService:getInactivatedCategories(::nPage, ::nPageSize, aURLFilter, cFields, cSort, ""))
	aItems := ::jResponse:GetJsonObject( "items" )

	If Empty( aURLFilter ) .Or. ( !Empty( aItems ) .And. Len( aItems ) > 0 )
		oRest:setResponse(::jResponse)
		aSize(aItems, 0)
	Else
		SetRestFault(404, FWHttpEncode(STR0001)) // "Categoria não localizada"
	EndIf

	aSize(aURLFilter, 0)
return .T.

//------------------------------------------------------------------------------
/*/{Protheus.doc} productCategories::postActivateCategories() as Logical
	Ativa uma ou mais categorias de produtos, podendo ativar também as categorias superiores.

	@type       method
	@return     logical, Verdadeiro
	@author     Jorge Martins / Squad Retail
	@since      12/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method postActivateCategories() as Logical Class productCategories
	Local cCategory    := GetQueryParam('CATEGORY')    as Character
	Local cActivateSup := GetQueryParam('ACTIVATESUP') as Character
	Local lActivateSup := cActivateSup <> "FALSE"      as Logical // Indica se deve ativar as categorias superiores

	oRest:setKeyHeaderResponse('content-type', 'application/json')

	::jResponse := ::oService:postActivateCategories(cCategory, lActivateSup)

	If ::jResponse:HasProperty("error")
		SetRestFault(404, FWHttpEncode(::jResponse["error"]))
	Else
		oRest:setResponse(::jResponse)
	EndIf

return .T.

//------------------------------------------------------------------------------
/*/{Protheus.doc} productCategories::getRootName() as Logical
	Obtem o nome da categoria "Raiz" definida no parâmetro MV_CATSEGM.

	@type       method
	@return     logical, Verdadeiro
	@author     Jorge Martins / Squad Retail
	@since      12/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getRootName() as Logical Class productCategories

	oRest:setKeyHeaderResponse('content-type', 'application/json')

	oRest:setResponse(::oService:getRootName())

return .T.

//------------------------------------------------------------------------------
/*/{Protheus.doc} productCategories::getChildCategories() as Logical
	Obtem uma lista de categorias filhas de uma categoria pai.

	@type       method
	@return     logical, Verdadeiro
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getChildCategories() as Logical Class productCategories
	Local cInactivated := GetQueryParam('INACTIVATED') as Character
	Local cActivated   := GetQueryParam('ACTIVATED')   as Character
	Local lInactivated := cInactivated == "TRUE"       as Logical // Indica se deve retornar categorias inativadas
	Local lActivated   := cActivated <> "FALSE"        as Logical // Indica se deve retornar categorias ativadas

	oRest:setKeyHeaderResponse('content-type', 'application/json')

	::jResponse := ::oService:getChildCategories(GetPathParams("category"), lActivated, lInactivated)

	If ::jResponse:HasProperty("error")
		SetRestFault(404, FWHttpEncode(::jResponse["error"]))
	Else
		oRest:setResponse(::jResponse)
	EndIf

return .T.
