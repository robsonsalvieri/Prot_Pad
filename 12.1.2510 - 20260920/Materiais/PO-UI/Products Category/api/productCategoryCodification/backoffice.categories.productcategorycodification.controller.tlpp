#include "tlpp-core.th"

namespace totvs.protheus.backoffice.categories.productcategorycodification
using namespace totvs.protheus.backoffice.categories.util

//------------------------------------------------------------------------------
/*/{Protheus.doc} ProductCategoryCodification
	API para gerenciar a configuração de codificação de produtos por categoria
	@type       class
	@author     Jorge Martins / Squad Retail
	@since      12/02/2026
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Class ProductCategoryCodification
	Data jResponse  as Json
	Data oService   as Object

	Public Method new() as Object

	@Get("/api/categories/v1/fieldSize/:field") // Buscar tamanho de campo
	Public Method getfieldSize() as Logical

	@Get("/api/categories/v1/parameters/:parameter") // Buscar parâmetro
	Public Method getParameter() as Logical

	@Put("/api/categories/v1/parameters/:parameter") // Altera parâmetro
	Public Method putParameter() as Logical

	@Put("/api/categories/v1/adjustEncoding") // Ajusta codificação de produto por categoria
	Public Method putAdjustEncoding() as Logical

endClass

//------------------------------------------------------------------------------
/*/{Protheus.doc} ProductCategoryCodification:new() as Object
	Obtém uma nova instancia da classe ProductCategoryCodification
	@type       method
	@return     object, retorna uma nova instancia da classe.
	@author     Jorge Martins / Squad Retail
	@since      12/02/2026
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method new() as Object Class ProductCategoryCodification
	::jResponse := JsonObject():new()
	::oService  := ProductCategoryCodificationService():getInstance()
return self

//------------------------------------------------------------------------------
/*/{Protheus.doc} getfieldSize as Logical
	Busca o tamanho do campo passado via parâmetro, 
	o parâmetro deve ser informado no formato Tabela_Campo (ex: B1_COD, RD0_NOME, etc)
	@type       method
	@return     logical, Verdadeiro
	@author     Jorge Martins / Squad Retail
	@since      12/02/2026
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getfieldSize() as Logical Class ProductCategoryCodification
	Local cField    as Character

	oRest:setKeyHeaderResponse('content-type', 'application/json; charset=utf-8')

	cField := oRest:GetPathParamsRequest()['field']

	::jResponse := ::oService:getFieldSize(cField)

	If ::jResponse:HasProperty("error")
		SetRestFault(400, FWHttpEncode(::jResponse["error"]))
	Else
		oRest:setResponse(::jResponse)
	EndIf

Return .T.

//------------------------------------------------------------------------------
/*/{Protheus.doc} getParameter as Logical
	Busca o valor do parâmetro passado via parâmetro
	@type       method
	@return     logical, Verdadeiro
	@author     Jorge Martins / Squad Retail
	@since      12/02/2026
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getParameter() as Logical Class ProductCategoryCodification
	Local cParameter as Character

	oRest:setKeyHeaderResponse('content-type', 'application/json; charset=utf-8')

	cParameter := oRest:getPathParamsRequest()['parameter']

	::jResponse := ::oService:getParameter(cParameter)

	If ::jResponse:HasProperty("error")
		SetRestFault(400, FWHttpEncode(::jResponse["error"]))
	Else
		oRest:setResponse(::jResponse)
	EndIf

Return .T.

//------------------------------------------------------------------------------
/*/{Protheus.doc} putParameter as Logical
	Altera o conteúdo do parâmetro passado via parâmetro
	@type       method
	@return     logical, Verdadeiro
	@author     Jorge Martins / Squad Retail
	@since      12/02/2026
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method putParameter() as Logical Class ProductCategoryCodification
	Local cParameter as Character
	Local xValuePar  as Variant

	oRest:setKeyHeaderResponse('content-type', 'application/json; charset=utf-8')

	cParameter := oRest:GetPathParamsRequest()['parameter']
	xValuePar  := GetQueryParam('VALUEPAR')

	::jResponse := ::oService:putParameter(cParameter, xValuePar)

	If ::jResponse:HasProperty("error")
		SetRestFault(400, FWHttpEncode(::jResponse["error"]))
	Else
		oRest:setResponse(::jResponse)
	EndIf

Return .T.

//------------------------------------------------------------------------------
/*/{Protheus.doc} putAdjustEncoding as Logical
	Ajusta a codificação de produto por categoria, realizando a atualização 
	do campo ACU_CDPROD para os registros da base.
	@type       method
	@return     logical, Verdadeiro
	@author     Jorge Martins / Squad Retail
	@since      18/02/2026
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method putAdjustEncoding() as Logical Class ProductCategoryCodification
	Local cParameter as Character
	Local xValuePar  as Variant

	oRest:setKeyHeaderResponse('content-type', 'application/json; charset=utf-8')

	::jResponse := ::oService:putAdjustEncoding(cParameter, xValuePar)

	If ::jResponse:HasProperty("error")
		SetRestFault(400, FWHttpEncode(::jResponse["error"]))
	Else
		oRest:setResponse(::jResponse)
	EndIf

Return .T.
