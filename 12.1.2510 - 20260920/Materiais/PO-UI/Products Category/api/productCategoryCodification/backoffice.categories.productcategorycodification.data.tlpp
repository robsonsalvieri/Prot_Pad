#INCLUDE "TOTVS.CH"
#INCLUDE "FWMVCDEF.CH"
#INCLUDE "tlpp-core.th"
#INCLUDE "backoffice.categories.productcategorycodification.data.ch"

namespace totvs.protheus.backoffice.categories.productcategorycodification
using namespace totvs.protheus.backoffice.categories.util

//------------------------------------------------------------------------------
/*/{Protheus.doc} ProductCategoryCodificationData
	Efetua a consulta de categorias de produtos do Protheus.

	@type       Class
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Class ProductCategoryCodificationData from FWAdapterBaseV2

	DATA aPrepared as Array

	Public Method new() as Object

	Public Method getFieldSize() as Json
	Public Method getParameter() as Json
	Public Method putParameter() as Json
	Public Method putAdjustEncoding() as Json
	Public Method getCategs() as Character
	Public Method ajustCategs() as Logical
	Public Method getQuery() as Object

EndClass

//------------------------------------------------------------------------------
/*/{Protheus.doc} new
	Construtor da classe ProductCategoryCodificationData

	@sample     ProductCategoryCodificationData():New("GET", .T.)
	@type       method
	@param      cVerbo, Character, Verbo que será utilizado na requisição
	@param      lList , Logical  , Se irá listar o Json
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method new() as Object Class ProductCategoryCodificationData
	::aPrepared := {}
	_Super:New("GET", .T.)
Return Self

//------------------------------------------------------------------------------
/*/{Protheus.doc} getFieldSize
	Busca o tamanho do campo passado via parâmetro, 
	o parâmetro deve ser informado no formato Tabela_Campo (ex: B1_COD, RD0_NOME, etc)
	@type       method
	@sample     oData:getFieldSize('B1_COD')
	@param      cField, Character, Nome do campo no formato Tabela_Campo.
	@return     jResponse, Json, Tamanho do campo consultado ou mensagem de erro.
	@author     Jorge Martins / Squad Retail
	@since      12/02/2026
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getFieldSize(cField as Character) as Json Class ProductCategoryCodificationData
	Local cTab      as Character
	Local jResponse as Json

	Default cField := ""

	jResponse := JsonObject():New()
	
	If !Empty(cField)
		cTab := PadL(Left(cField, AT("_", cField) - 1), 3, "S")
		If AliasInDic(cTab) .And. (cTab)->(Columnpos(cField)) > 0
			jResponse['fieldSize'] := GetSx3Cache(cField, "X3_TAMANHO")
		Else
			jResponse["error"] := I18n(STR0001, {cField}) // "Campo '#1' não encontrado no dicionário de dados."
		EndIf
	Else
		jResponse["error"] := STR0002 // "Campo não informado."
	EndIf

Return jResponse

//------------------------------------------------------------------------------
/*/{Protheus.doc} getParameter
	Efetua a consulta do conteúdo do parâmetro passado via parâmetro
	@type       method
	@sample     oData:getParameter('MV_EXAMPLE')
	@param      cParameter, Character, Nome do parâmetro a ser consultado.
	@return     jResponse, Json, Valor do parâmetro consultado ou mensagem de erro.
	@author     Jorge Martins / Squad Retail
	@since      12/02/2026
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getParameter(cParameter as Character) as Json Class ProductCategoryCodificationData
	Local jResponse  as Json
	Local xValParam  as Variant
	Local cValParam  as Character

	Default cParameter := ""

	jResponse := JsonObject():New()

	If !Empty(cParameter)
		If FWSX6Util():ExistsParam(cParameter) // Verifica se o parâmetro existe antes de tentar consultar
			xValParam := SuperGetMV(cParameter, .F., '')
			cValParam := cValToChar(xValParam) // Converte o valor do parâmetro para caractere para evitar problemas de serialização no Json, caso o valor seja numérico ou lógico
			jResponse[cParameter] := FWHttpEncode(cValParam)
		Else
			jResponse["error"] := STR0003 // "Parâmetro inválido."
		EndIf
	Else
		jResponse["error"] := STR0004 // "Parâmetro não informado."
	EndIf

Return jResponse

//------------------------------------------------------------------------------
/*/{Protheus.doc} putParameter
	Altera o conteúdo do parâmetro passado via parâmetro
	@type       method
	@sample     oData:putParameter('MV_EXAMPLE', 'New Value')
	@param      cParameter, Character, Nome do parâmetro a ser alterado.
	@param      xValuePar , Variant  , Novo valor do parâmetro.
	@return     jResponse, Json, Resultado da operação de alteração do parâmetro.
	@author     Jorge Martins / Squad Retail
	@since      12/02/2026
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method putParameter(cParameter as Character, xValuePar as Variant) as Json Class ProductCategoryCodificationData
	Local jResponse  as Json

	Default cParameter := ""
	Default xValuePar  := ""

	jResponse := JsonObject():New()

	If !Empty(cParameter)
		If FWSX6Util():ExistsParam(cParameter) // Verifica se o parâmetro existe antes de tentar alterar
			If !Empty(xValuePar)
				PutMv(cParameter, xValuePar) // Altera o conteúdo do parâmetro
				jResponse["code"]    := 201
				jResponse["message"] := FWHttpEncode(STR0005) // "Parâmetro atualizado com sucesso."
			Else
				jResponse["error"] := STR0006 // "Não foi informado o valor do parâmetro. Utilize o query param 'VALUEPAR' para informar o novo valor do parâmetro."
			EndIf
		Else
			jResponse["error"] := STR0003 // "Parâmetro inválido."
		EndIf
	Else
		jResponse["error"] := STR0004 // "Parâmetro não informado."
	EndIf

Return jResponse

//------------------------------------------------------------------------------
/*/{Protheus.doc} putAdjustEncoding
	Ajusta a codificação de produto por categoria, realizando a atualização 
	do campo ACU_CDPROD para os registros da base.

	@type       method
	@param      cCategoryCode, Character, Código da categoria para filtro das grades disponíveis
	@param      cGroupSearch , Character, Termo de busca para código ou descrição da grade
	@param      nPage        , Numeric, Número da página para paginação dos resultados
	@param      nPageSize    , Numeric, Quantidade de registros por página para paginação dos resultados
	@return     jResponse    , Json, Objeto JSON contendo a lista de grades disponíveis e informações de paginação
	@author     Jorge Martins / Squad Retail
	@since      18/12/2025
/*/
//------------------------------------------------------------------------------
Method putAdjustEncoding() as Json Class ProductCategoryCodificationData
	Local cAliasQry as Character
	Local jResponse as Json
	Local lRet      as Logical

	jResponse := JsonObject():New()

	cAliasQry  := ::getCategs() // Executa a query de obtenção das categorias para vinculo
	
	lRet := ::ajustCategs(cAliasQry) // Faz os ajustes na codificação de produto das categorias encontradas

	If lRet
		jResponse['message'] := FWHttpEncode(STR0007) // "Categorias atualizadas com sucesso."
	Else
		jResponse['error']   := FWHttpEncode(STR0008) // "Uma ou mais categorias não foram atualizadas pois estavam bloqueadas por outro usuário."
	EndIf

Return jResponse

//------------------------------------------------------------------------------
/*/{Protheus.doc} getCategs
	Obtém a query com a lista de categorias em ordem para preenchimento da codificação

	@sample     getCategs()
	@type       Method
	@return     cAliasQry, Character, Alias da query aberta
	@author     Jorge Martins / Squad Retail
	@since      18/02/2026
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getCategs() as character Class ProductCategoryCodificationData
	Local cQuery    as character
	Local nParam    as Numeric
	Local cAliasQry as Character
	Local oQueryCat as object

	cQuery :=   " SELECT ACU.R_E_C_N_O_ ACURECNO, ACU.ACU_CODPAI"
	cQuery +=     " FROM " + RetSqlName("ACU") + " ACU"
	cQuery +=    " WHERE ACU.ACU_FILIAL = ?" // #1
	cQuery +=      " AND ACU.D_E_L_E_T_ = ?" // #2
	cQuery +=    " ORDER BY ACU.ACU_CODPAI, ACU.R_E_C_N_O_"
	
	oQueryCat := ::getQuery(cQuery)

	nParam := 1
	oQueryCat:setString(nParam++, FWxFilial("ACU")) // #1
	oQueryCat:setString(nParam++, Space(1)) // #2

	cAliasQry := GetNextAlias()
	oQueryCat:OpenAlias(cAliasQry)

Return cAliasQry

//------------------------------------------------------------------------------
/*/{Protheus.doc} ajustCategs
	Realiza o ajuste da codificação de produto por categoria, 
	atualizando o campo ACU_CDPROD para os registros da base.

	@sample     ajustCategs("ACUTEMP")
	@type       Function
	@param      cAliasQry, Character, Alias da query aberta com a lista de categorias
	@return     lRet, Logical, .T. se todas as categorias foram atualizadas com sucesso 
	                           .F. se um ou mais registros não puderam ser atualizados por estarem bloqueados por outro usuário.
	@author     Jorge Martins / Squad Retail
	@since      18/02/2026
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method ajustCategs(cAliasQry as Character) as logical Class ProductCategoryCodificationData
	Local cCodPai    as Character
	Local nTamCdProd as Numeric
	Local lStart     as Logical
	Local aArea      as Array
	Local aAreaACU   as Array
	Local nRecnoACU  as Numeric
	Local lRet       as Logical

	Default cAliasQry := ""

	If !Empty(cAliasQry)
		aArea    := FWGetArea()
		aAreaACU := ACU->(FWGetArea())

		cCodPai    := ""
		lRet       := .T.
		lStart     := .T.
		nTamCdProd := GetSx3Cache("ACU_CDPROD", "X3_TAMANHO")

		While !(cAliasQry)->(Eof())
			
			// Verifica se a categoria pai atual é diferente da categoria anterior ou se é a primeira iteração, para então "zerar" o código
			If lStart .Or. AllTrim(cCodPai) <> AllTrim((cAliasQry)->ACU_CODPAI)
				cCdProd := StrZero(1, nTamCdProd) // "01"
				lStart  := .F.
			Else
				cCdProd := Soma1(cCdProd) // "02", "03", "NN" ...
			EndIf
			
			nRecnoACU := (cAliasQry)->ACURECNO

			ACU->(MsGoto(nRecnoACU))
			If ACU->(SimpleLock())
				If RecLock("ACU", .F.)
					ACU->ACU_CDPROD := cCdProd // Atualiza o código de produto da categoria
					ACU->(MsUnlock())
				EndIf
			Else
				lRet := .F.
			EndIf

			cCodPai := (cAliasQry)->ACU_CODPAI

			(cAliasQry)->(DbSkip())
		EndDo
	
		(cAliasQry)->(DbCloseArea())

		FwRestArea(aAreaACU)
		FwRestArea(aArea)
	EndIf

Return lRet

//------------------------------------------------------------------------------
/*/{Protheus.doc} getQuery
	Obtém a query preparada para execução.

	@sample     GetQuery(cQuery)
	@type       Method
	@param      cQuery, Character, Expressão SQL
	@return     oPrepared, Object, Objeto de query preparada
	@author     Jorge Martins / Squad Retail
	@since      17/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getQuery(cQuery as Character) as Object Class ProductCategoryCodificationData
	Local oPrepared    as Object
	Local nPosPrepared as Numeric
	Local cMD5         as Character
	
	Default cQuery := ""

	cMD5 := MD5(cQuery)
	If (nPosPrepared := Ascan(::aPrepared,{|x| x[2] == cMD5})) == 0
		cQuery := ChangeQuery(cQuery)
		Aadd(::aPrepared,{FwExecStatement():New(cQuery), cMD5})
		nPosPrepared := Len(::aPrepared)
	Endif

	oPrepared := ::aPrepared[nPosPrepared][1]

Return oPrepared
