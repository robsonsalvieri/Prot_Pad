#Include "tlpp-core.th"
#Include "totvs.ch"
#Include "backoffice.categories.importcategories.controller.ch"

namespace totvs.protheus.backoffice.categories.importcategories

//------------------------------------------------------------------------------
/*/{Protheus.doc} ImportCategoriesController
	API para importação de categorias de produtos via MILE (ACU)
	@type       class
	@author     Paulo Dias Oliveira / Squad Retail
	@since      16/11/2025
	@version    P12
/*/
//------------------------------------------------------------------------------
Class ImportCategoriesController
	Data oService as Object

	Public Method new() as Object

	@Get("/api/categories/v1/importTemplate")
	Public Method getTemplate() as Logical

	@Post("/api/categories/v1/importCategories")
	Public Method postImport() as Logical
EndClass

//------------------------------------------------------------------------------
/*/{Protheus.doc} ImportCategoriesController::new() as Object
	Obtém uma nova instancia da classe ImportCategoriesController
	@type       method
	@return     object, retorna uma nova instancia da classe
	@author     Paulo Dias Oliveira / Squad Retail
	@since      16/11/2025
	@version    P12
/*/
//------------------------------------------------------------------------------
Method new() as Object Class ImportCategoriesController
	::oService := ImportCategoriesService():New()
Return Self

//------------------------------------------------------------------------------
/*/{Protheus.doc} ImportCategoriesController::new() as Json
	Obtém o template de importação de categorias em formato JSON, contendo o arquivo CSV codificado em Base64
	@type       method
	@return     json, retorna um objeto Json contendo o nome do arquivo e o conteúdo em Base64 do template CSV
	@author     Paulo Dias Oliveira / Squad Retail
	@since      16/11/2025
	@version    P12
/*/
//------------------------------------------------------------------------------
Method getTemplate() as Logical Class ImportCategoriesController
	Local jResponse as Json

	oRest:setKeyHeaderResponse('content-type', 'application/json')

	jResponse := ::oService:getTemplate()
	oRest:setResponse(jResponse)
Return .T.

//------------------------------------------------------------------------------
/*/{Protheus.doc} ImportCategoriesController::new() as Logical
	Realiza a importação das categorias utilizando o MILE do Protheus, a partir de um arquivo CSV enviado via API e codificado em Base64 no corpo da requisição
	@type       method
	@return     logical, retorna verdadeiro se a importação foi bem sucedida, ou falso caso contrário
	@author     Paulo Dias Oliveira / Squad Retail
	@since      16/11/2025
	@version    P12
/*/
//------------------------------------------------------------------------------
Method postImport() as Logical Class ImportCategoriesController
	Local jResponse    as Json
	Local cBody        as Character
	Local xBodyRequest as Variant
	Local lContinue    as Logical

	lContinue := .T.

	// Obtem o corpo da requisição
	xBodyRequest := oRest:GetBodyRequest()

	cBody := ""

	// O FWTestHelper envia "application/json", o que faz o TLPP converter automaticamente para JsonObject ("J" ou "O")
	If ValType(xBodyRequest) == "C"
		cBody := xBodyRequest
	ElseIf ValType(xBodyRequest) == "J" .Or. ValType(xBodyRequest) == "O"
		cBody := xBodyRequest:ToJson()
	EndIf

	oRest:setKeyHeaderResponse('content-type', 'application/json')

	If Empty(cBody)
		// Utiliza a funcao nativa homologada SetRestFault para evitar crash 500
		SetRestFault(400, FWHttpEncode(STR0001)) // "Nenhum dado recebido na requisicao form-data."
		lContinue := .F.
	EndIf

	// Se continua
	If lContinue
		// Repassa o JSON para a camada de servico
		jResponse := ::oService:postImport(cBody)

		If jResponse:HasProperty("error")
			// Devolve o erro de negocio mapeado usando a funcao nativa
			SetRestFault(400, FWHttpEncode(jResponse["error"]))
		Else
			oRest:setResponse(jResponse)
		EndIf
	EndIf
Return .T.
