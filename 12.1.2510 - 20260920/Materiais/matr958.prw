Function Matr958()

Local cReport	:= "MATR958"	//Nome do Programa
Local cAlias	:= "SAH"		//Alias da tabela
Local cTitle	:= STR0001		//Unidades de Medida
Local cDesc		:= STR0002		//Este relatório apresenta uma relação das Unidades de Medida cadastradas.
Local lInd		:= .T.			//Retorna Indice SIX

//Validação de aviso/bloqueio do relatório em Release 12.1.2510 ou superiores
If ExistFunc("VldDescRel")
	If !VldDescRel()
		Return
	EndIf
EndIf

MPReport(cReport,cAlias,cTitle,cDesc,,lInd)

Return
