#include "BACKOFFICE.FAT.EDIWINSERVER.ch"
#include "tlpp-core.th"
#include "tlpp-object.th"
#Include "FileIO.ch"
#INCLUDE "FWLIBVERSION.CH"
#include 'FWMVCDEF.CH'

/*/{Protheus.doc} EdiWinPublishDoc
Función para realizar petición a web-services publishDocument
para publicar y timbrar documentos la portal EdiWin
@type function
@version 1.0
@author eduardo.manriquez
@since 3/27/2026
@param cRUTASMR, character, Ruta donde se encuentra el XML a enviar
@param cNameCFDI, character, Nombre del archivo XML a enviar
@param cRutaSRV, character, Ruta del servidor
@param cSerie, character, Serie del documento
@param cDoc, character, Número del documento
@param aParamEdi, array, Arreglo con la configuración para integración con portal Ediwin
@return nOpc, variable númerica para validar hubo algún error
               0 - Se realiza petición correctamente
               1 - Se generó un error en la petición
/*/
Function EdiWinPublishDoc(cRUTASMR as Character,cNameCFDI as Character,cRutaSRV as Character,cSerie as Character,cDoc as Character,aParamEdi as Array)
   Local cUrl        as Character
   Local cBoundary   as Character 
   Local cBody       as Character
   Local cFileData   as Character
   Local cResult     as Character
   Local aHeaders    as Array
   Local oFile       as Object
   Local oRest       as Object 
   Local cPath       as Character 
   Local cCarpetaZip as Character
   Local nOpc        as Numeric 
   Local cCRLF	      as Character 
   Local cFileEdi    as Character
   Local cStatus     as Character
   Local cUsr        as Character
   Local cPass       as Character
   Local cGrp        as Character
   Local cDom        as Character
   Local cRetDatPro  as Character
   Local cNameFile   as Character
   Local oJson       as Object
   Local nPosError   as Numeric

   Default cRUTASMR  := ""
   Default cNameCFDI := ""
   Default cRutaSRV  := ""
   Default cSerie    := ""
   Default cDoc      := ""
   Default aParamEdi := {}

   cBoundary   := "----WebKitFormBoundary7MA4YWxkTrZu0gW"
   cCarpetaZip := "ediwin.zip"
   cCRLF	      := (chr(13)+chr(10))
   aHeaders    := {}
   nOpc        := 1     
   oJson       := JsonObject():new()
   nPosError   := 0

   If Len(aParamEdi)> 0
      cUrl        := aParamEdi[1]
      cPath       := aParamEdi[2]
      cUsr        := aParamEdi[3]
      cPass       := aParamEdi[4]
      cGrp        := aParamEdi[5]
      cDom        := aParamEdi[6]
      cRetDatPro  := aParamEdi[7]

      cFileEdi := Alltrim(cSerie)+Alltrim(cDoc)+".xml"
      oRest    := FWRest():New(cUrl)
      oFile := FwFileReader():New(cRUTASMR+cNameCFDI)

      if (oFile:Open())
         cFileData := oFile:FullRead()
         oFile:Close()
      endif

      FreeObj(oFile)
      // ========================
      // Construcción del cuerpo multipart/form-data
      // ========================
      cBody += "--" + cBoundary + cCRLF
      cBody += 'Content-Disposition: form-data; name="user"' + cCRLF + cCRLF + cUsr + cCRLF
      cBody += "--" + cBoundary + cCRLF
      cBody += 'Content-Disposition: form-data; name="password"' + cCRLF + cCRLF + cPass + cCRLF
      cBody += "--" + cBoundary + cCRLF
      cBody += 'Content-Disposition: form-data; name="domain"' + cCRLF + cCRLF + cDom + cCRLF
      cBody += "--" + cBoundary + cCRLF
      cBody += 'Content-Disposition: form-data; name="publishType"' + cCRLF + cCRLF + "2" + cCRLF

      // Archivo adjunto (message)
      cBody += "--" + cBoundary + cCRLF
      cBody += 'Content-Disposition: form-data; name="message"; filename="'+cRUTASMR+cNameCFDI+'"' + cCRLF
      cBody += 'Content-Type: text/xml' + cCRLF + cCRLF
      cBody += cFileData + cCRLF

      // Campos restantes
      cBody += "--" + cBoundary + cCRLF + 'Content-Disposition: form-data; name="process"' + cCRLF + cCRLF + "" + cCRLF
      cBody += "--" + cBoundary + cCRLF + 'Content-Disposition: form-data; name="saveOriginalMessage"' + cCRLF + cCRLF + "true" + cCRLF
      cBody += "--" + cBoundary + cCRLF + 'Content-Disposition: form-data; name="sendDocument"' + cCRLF + cCRLF + "true" + cCRLF
      cBody += "--" + cBoundary + cCRLF + 'Content-Disposition: form-data; name="returnData"' + cCRLF + cCRLF + "true" + cCRLF
      cBody += "--" + cBoundary + cCRLF + 'Content-Disposition: form-data; name="returnDataType"' + cCRLF + cCRLF + "3" + cCRLF
      cBody += "--" + cBoundary + cCRLF + 'Content-Disposition: form-data; name="returnDataProcess"' + cCRLF + cCRLF + cRetDatPro + cCRLF
      cBody += "--" + cBoundary + cCRLF + 'Content-Disposition: form-data; name="profileParameters"' + cCRLF + cCRLF + "" + cCRLF
      cBody += "--" + cBoundary + cCRLF + 'Content-Disposition: form-data; name="group"' + cCRLF + cCRLF + cGrp + cCRLF
      cBody += "--" + cBoundary + "--"

      // ========================
      // Encabezados HTTP
      // ========================
      aAdd(aHeaders, 'Content-Type: multipart/form-data; boundary=' + cBoundary)
      AAdd(aHeaders, "charset: UTF-8")

      oRest:SetPath(cPath)
      oRest:SetPostParams(cBody)

      // ========================
      // Ejecución del POST
      // ========================
      oRest:Post(aHeaders)
      FwfreeArray(aHeaders)
      
      // ========================
      // Restauración de respuesta del web service
      // ========================
      cStatus := oRest:GetHttpCode()
      cResult := oRest:GetResult()
      FreeObj(oRest)

      If cStatus == "200"
         cNameFile:= cRUTASMR+cCarpetaZip
      Else
         cNameFile:= cRUTASMR+cNameCFDI+".out"
         // Validação da estrutura do Json retornado
			oJson:fromJson(cResult)
         If oJson:HasProperty("errorText") .And. ValType(oJson["errorText"]) == "C" 
            cResult := DecodeUtf8(oJson["errorText"])
            nPosError := AT('Tipo de error:', cResult)
            cResult:= Substr(cResult,nPosError, len(cResult))
         Else
            cResult := STR0011 // "Error al convertir respuesta de webservice"
         Endif
         FreeObj(oJson)
      Endif
      
      Ferase(cNameFile)
      nOpc := EdiGenFileOut(cNameFile,cStatus,cResult,cFileEdi,cRUTASMR,cNameCFDI)
   Endif

Return nOpc

/*/{Protheus.doc} EdiGenFileOut
Función que genera el archivo .out con la respuesta del Web-Service
@type function
@version 1.0
@author eduardo.manriquez
@since 3/27/2026
@param cNameFile, character, Archivo donde se guardara la respuesta del web-service
@param cStatus, character, Código de la respuesta del web-service
@param cResult, character, Cadena con la respuesta dle web-service
@param cFileEdi, character, Nombre del archivo XML que retorna el web-service
@param cRUTASMR, character, Ruta donde se creará el archivo .out
@param cNameCFDI, character, Nombre del archivo .out
@return nOpc, variable númerica para validar si se genero el archivo .out correctamente
               0 - Se generó correctamente
               1 - Error en la generación de archivo .out
/*/
Function EdiGenFileOut(cNameFile as Character,cStatus as Character,cResult as Character,cFileEdi as Character,cRUTASMR as Character,cNameCFDI as Character)
   Local cFileData   as Character
   Local oFile       as Object
   Local oFileWrite  as Object
   Local nOpc        as Numeric
   Local lFileOK     as Logical

   Default cNameFile := "" 
   Default cStatus   := ""
   Default cResult   := ""
   Default cFileEdi  := ""
   Default cRUTASMR  := ""
   Default cNameCFDI := ""

   nOpc       := 1
   oFileWrite := FwFileWriter():New(cNameFile,.T.)

   If oFileWrite:Create()
		lFileOK := oFileWrite:Write(cResult)
      If lFileOk
         oFileWrite:Close()
         if cStatus == "200"
            FUnZip(cNameFile, cRUTASMR)
            If File(cRUTASMR+cFileEdi)
               //Generar archivo .out
               oFile := FwFileReader():New(cRUTASMR+cFileEdi)
               if (oFile:Open())
                  cFileData := oFile:FullRead()
                  oFileWrite := FwFileWriter():New(cRUTASMR+cNameCFDI+".out",.T.)
                  If oFileWrite:Create()
                     If oFileWrite:Write(cFileData)
                        oFileWrite:Close()
                        nOpc:=0
                     Endif
                  Endif
                  oFile:Close()
                  oFile:Erase()
               endif
               FreeObj(oFile)
            Endif
         Else
            nOpc:= 0
         Endif
      Endif
   Endif
   FreeObj(oFileWrite)      

Return nOpc


/*/{Protheus.doc} EdiGetParams
Valida los parámetros para la integración con portal Ediwin
@type function
@version 1.0
@author eduardo.manriquez
@since 3/27/2026
@param nWs, numeric, variable para identificar el webservice para validar parámetros
                     1 - publishDocument
                     2 - getDocucuments
                     3 - getCustomData
@param aParamEdi, array, arreglo con el valor de los parámetros del webservice
@return lRet, variable lógica que valida si los parámetros estan correctamente configurados
               .T. - Configuración correcta
               .F. - Faltan parámetros por configurar
/*/
Function EdiGetParams(nWs as Numeric,aParamEdi as Array)
   Local cError      as Character
   Local cCRLF	      as Character
   Local cUsrError   as Character
   Local cPassError  as Character
   Local cPathError  as Character
   Local cGrpError   as Character
   Local cDomError   as Character
   Local cRetDPError as Character
   Local lRet        as Logical
   Local cUsr        as Character 
   Local cPass       as Character
   Local cUrl        as Character
   Local cPath       as Character
   Local cGrp        as Character
   Local cDom        as Character
   Local cRetDatPro  as Character

   Default nWs   := 0
   Default aParamEdi := {}
   
   lRet := .T.
   cCRLF := (chr(13)+chr(10))
   If nWs == 1
      cUsr       := SuperGetmv( "MV_PUBL_US" , .F. , "" )
      cPass      := SuperGetmv( "MV_PUBL_PA" , .F. , "" )
      cPath      := SuperGetmv( "MV_EDIPUBL" , .F. , "" )
      cGrp       := SuperGetmv( "MV_PUBL_GP" , .F. , "" )
      cDom       := SuperGetmv( "MV_PUBL_DM" , .F. , "" )
      cRetDatPro := SuperGetmv( "MV_PUBL_RD" , .F. , "" )
      cUsrError  := STR0001 //"MV_PUBL_US"
      cPassError := STR0002 //"MV_PUBL_PA"
      cPathError := STR0003 //"MV_EDIPUBL"
      cGrpError  := STR0004 //"MV_PUBL_GP"
      cDomError  := STR0005 //"MV_PUBL_DM"
      cRetDPError:= STR0006 //"MV_PUBL_RD"
   ElseIf nWs == 2
      cUsr       := SuperGetmv( "MV_GETC_US" , .F. , "" )
      cPass      := SuperGetmv( "MV_GETC_PA" , .F. , "" )
      cPath      := SuperGetmv( "MV_EDIGETC" , .F. , "" )
      cGrp       := SuperGetmv( "MV_GETC_GP" , .F. , "" )
      cDom       := SuperGetmv( "MV_GETC_DM" , .F. , "" )
      cRetDatPro := SuperGetmv( "MV_GETC_RD" , .F. , "" )
      cUsrError  := STR0012 //"MV_GETC_US"
      cPassError := STR0013 //"MV_GETC_PA"
      cPathError := STR0014 //"MV_EDIGETC"
      cGrpError  := STR0015 //"MV_GETC_GP"
      cDomError  := STR0016 //"MV_GETC_DM"
      cRetDPError:= STR0017 //"MV_GETC_RD"
   Elseif nWs == 3
      cUsr       := SuperGetmv( "MV_GETD_US" , .F. , "" )
      cPass      := SuperGetmv( "MV_GETD_PA" , .F. , "" )
      cPath      := SuperGetmv( "MV_EDIGETD" , .F. , "" )
      cGrp       := SuperGetmv( "MV_GETD_GP" , .F. , "" )
      cDom       := SuperGetmv( "MV_GETD_DM" , .F. , "" )
      cUsrError  := STR0044 //"MV_GETD_US"
      cPassError := STR0045 //"MV_GETD_PA"
      cPathError := STR0046 //"MV_EDIGETD"
      cGrpError  := STR0047 //"MV_GETD_GP"
      cDomError  := STR0048 //"MV_GETD_DM"
   Endif
   cUrl := SuperGetmv( "MV_EDIURL" , .F. , "" )
   
   if Empty(cUrl)
      cError += STR0007+cCRLF
   Endif
   if Empty(cUsr)
      cError += cUsrError+cCRLF
   Endif
   if Empty(cPass)
      cError += cPassError+cCRLF
   Endif
   if Empty(cPath)
      cError += cPathError+cCRLF
   Endif
   if Empty(cGrp)
      cError += cGrpError+cCRLF
   Endif
   if Empty(cDom)
      cError += cDomError+cCRLF
   Endif
   if Empty(cRetDatPro) .and. nWs < 3
      cError += cRetDPError+cCRLF
   Endif

   If !Empty(cError)
      cMsj := STR0008 +cCRLF+cCRLF+STR0009+cCRLF //"Se cuenta con la integración de Portal Ediwin con Protheus activa." + "Verificar que los siguientes parámetros se encuentren configurados:"
      HELP(' ',1,STR0010,,cMsj+cError,2,0,,,,,,)//"Configuración Integración EdiWin" 
      lRet:= .F.
   Else
      AAdd(aParamEdi,cUrl)
      AAdd(aParamEdi,cPath)
      AAdd(aParamEdi,cUsr)
      AAdd(aParamEdi,cPass)
      AAdd(aParamEdi,cGrp)
      AAdd(aParamEdi,cDom)
      AAdd(aParamEdi,cRetDatPro)
   Endif
Return lRet


/*/{Protheus.doc} EdiWinGetCustomData
Función para realizar petición a web-services getCustomData
para importar pedidos desde el portal EdiWin
@type function
@version 1.0
@author eduardo.manriquez
@since 4/28/2026
@param aParamEdi, array, Array con los valores de los parámetros del webservice 
@param cCliente, character, Código de cliente
@param cLoja, character, Tienda del cliente
/*/
Function EdiWinGetCustomData(aParamEdi,cCliente,cLoja)
   Local cURL        as Character
   Local cPath       as Character
   Local cUsr        as Character
   Local cPass       as Character
   Local cGrp        as Character
   Local cDom        as Character
   Local cRetDatPro  as Character  
   Local cBoundary   as Character
   Local cBody       as Character
   Local aHeaders    as Array
   Local oFileWrite  as Object  
   Local oRest       as Object
   Local oJson       as Object
	Local CRLF	      as Character  
   Local cFileEdi    as Character  
   Local cPathZip    as Character
   Local cParameters as Character  
   Local cRFC        as Character
   Local cFiltro     as Character
   Local lFileOK     as Logical
   Local cStatus     as Character
   Local cResult     as Character
   Default aParamEdi := {}
   Default cCliente  := ""
   Default cLoja     := ""


   cRFC := EdiGetRfc(cCliente,cLoja)
   if Len(aParamEdi) > 0 .and. !Empty(cRFC)
      cUrl        := aParamEdi[1]
      cPath       := aParamEdi[2]
      cUsr        := aParamEdi[3]
      cPass       := aParamEdi[4]
      cGrp        := aParamEdi[5]
      cDom        := aParamEdi[6]
      cRetDatPro  := aParamEdi[7]
      
      lFileOK     := .F. 
      cStatus     := ""
      cResult     := ""
      aHeaders    := {}
      cBoundary   := "----WebKitFormBoundary7MA4YWxkTrZu0gW"
      cPathZip := "\system\cfd\pedidosediwin"
      cFileEdi := "Pedidos.json"
      cFiltro := '{"name":"RFC","operator":"=","value":"'+cRFC+'"}'
      CRLF	      := (chr(13)+chr(10))
      oJson       := JsonObject():new()
      oRest       := FWRest():New(cUrl)

      If Pergunte("EDIWINPED",.T.)

         If !Empty(MV_PAR01) .AND. !Empty(MV_PAR02)
            cFiltro += ',{"name": "FECHAINICIO", "operator": "=", "value": "'+cValToChar(MV_PAR01)+'"}, {"name": "FECHAFIN", "operator": "=", "value":"'+cValToChar(MV_PAR02)+'"}'
         Endif
         cParameters := '['+cFiltro+']'
         // ========================
         // Construcción del cuerpo multipart/form-data
         // ========================
         cBody := "--" + cBoundary + CRLF
         cBody += 'Content-Disposition: form-data; name="user"' + CRLF + CRLF + cUsr + CRLF
         cBody += "--" + cBoundary + CRLF
         cBody += 'Content-Disposition: form-data; name="password"' + CRLF + CRLF + cPass + CRLF
         cBody += "--" + cBoundary + CRLF
         cBody += 'Content-Disposition: form-data; name="domain"' + CRLF + CRLF + cDom + CRLF
         cBody += "--" + cBoundary + CRLF
         cBody += 'Content-Disposition: form-data; name="publishType"' + CRLF + CRLF + "2" + CRLF

         // Campos restantes
         cBody += "--" + cBoundary + CRLF + 'Content-Disposition: form-data; name="process"' + CRLF + CRLF + cRetDatPro + CRLF
         cBody += "--" + cBoundary + CRLF + 'Content-Disposition: form-data; name="parameters"' + CRLF + CRLF + cParameters + CRLF
         cBody += "--" + cBoundary + CRLF + 'Content-Disposition: form-data; name="group"' + CRLF + CRLF + cGrp + CRLF
         cBody += "--" + cBoundary + "--"

         // ========================
         // Encabezados HTTP
         // ========================
         aAdd(aHeaders, 'Content-Type: multipart/form-data; boundary=' + cBoundary)
         AAdd(aHeaders, "charset: UTF-8")

         oRest:SetPath(cPath)
         oRest:SetPostParams(cBody)

         // ========================
         // Ejecución del POST
         // ========================
         oRest:Post(aHeaders)
         // ========================
         // Restauración de respuesta de archivo .zip
         // ========================
         cStatus := oRest:GetHttpCode()
         cResult := oRest:GetResult()
         FreeObj(oRest)

         If !(cStatus == "200")
            // Validação da estrutura do Json retornado
            oJson:fromJson(cResult)
            cResult := STR0011 // "Error al convertir respuesta de webservice"
            If ValType(oJson["errorText"]) == "C" 
               cResult := DecodeUtf8(oJson["errorText"])
            Endif
            HELP(' ',1,STR0018 ,,cResult,2,0,,,,,,"") // "Error petición web-service" - "Error al convertir respuesta de webservice"
         Else
            oFileWrite := FwFileWriter():New(cPathZip+".zip",.T.)

            If oFileWrite:Create()
               lFileOK := oFileWrite:Write(cResult)
               If lFileOk
                  oFileWrite:Close()
                  If !ExistDir(cPathZip) //Valida que exista directorio auxiliar para pedidos EdiWin
                     MakeDir(cPathZip)
                  EndIf
                  FUnZip(cPathZip+".zip", cPathZip)
                  If File(cPathZip+"\"+cFileEdi)
                     oJson:fromJsonFile(cPathZip+"\"+cFileEdi)
                  Endif
               Endif
            Endif

            FreeObj(oFileWrite)
            If oJson:hasProperty("pedidos") .and. ValType(oJson["pedidos"]) == "A"
               EdiCreateTela(oJson)
            Else
               HELP(' ',1,STR0026,, STR0027+cPathZip+"\"+cFileEdi,2,0,,,,,, {STR0028}) // "Error al procesar pedidos" - "Verifique que el archivo exista en la carpeta pedidosediwin, tenga permisos de lectura y que tenga el formato correcto."
            Endif

         Endif


         FreeObj(oJson)
         FwfreeArray(aHeaders)
         FwfreeArray(aParamEdi)
      Endif
   Endif

Return 


/*/{Protheus.doc} EdiCreateTela
Función que construye la pantalla para mostrar pedidos importados
@type function
@version 1.0
@author eduardo.manriquez
@since 4/25/2026
@param oJson, object, Objeto que contiene los pedidos importados
         {
         "pedidos":[
                     {
                     "numeroPedido":"",
                     "fechaPedido":""
                     }
                   ] 
         }
/*/
Function EdiCreateTela(oJson)
   Local nX          as Numeric
   Local bOK         as CodeBlock
   Local bCancel     as CodeBlock
   Local aArrayGrup  as Array
   Local aColumns    as Array
   Local lRet        as Logical
   Local cNumPed     as Character
   Local nPos        as Numeric
   Local lMvEdiPed   as Logical
   Local lCpoEdiPed  as Logical
   Local oModal      as Object
   Local oModalPanel as Object
   Local oBrowse     as Object
   Local oPanelGrid  as Object
   Local oColumn     as Object

   Default oJson     := JsonObject():new()

   aArrayGrup := {}
   aColumns   := {}
   lRet       := .F.
   nX         := 1
   lMvEdiPed  := SuperGetmv("MV_EDIPED",.F.,.F.)
   bOk         := {||lRet := .T., oModal:oOwner:End()}
   bCancel     := {||lRet := .F., oModal:oOwner:End()}
   lCpoEdiPed  := SC6->(ColumnPos("C6_EDIPED")) > 0

   oModal := FWDialogModal():New()
   oModal:SetFreeArea(300, 200)
   oModal:createDialog()
   oModal:SetEscClose(.T.)
   oModal:AddButton( OemToAnsi(STR0019), bOk, OemToAnsi(STR0019), , .T., .F., .T., {|| .T.}) //OK
   oModal:AddButton( OemToAnsi(STR0020), bCancel, OemToAnsi(STR0020), , .T., .F., .T., ) //Cancelar
   oModalPanel := oModal:GetPanelMain()
   oPanelGrid := TPanel():New(0, 0, "", oModalPanel, ,,,,, 0, 0)
   oPanelGrid:Align := CONTROL_ALIGN_ALLCLIENT
   If Len(oJson['pedidos']) > 0
      For nX := 1 To Len(oJson['pedidos'])
         nPos := aScan(aArrayGrup,{|x| (x)[1] == cValToChar(oJson['pedidos'][nX]['numeroPedido']) })
         If nPos == 0
            aAdd(aArrayGrup, {cValToChar(oJson['pedidos'][nX]['numeroPedido']),oJson['pedidos'][nX]['fechaPedido']})
         Endif
      Next
      oColumn := FWBrwColumn():New()
      oColumn:SetType("C")
      oColumn:SetData({|oBrowse| aArrayGrup[oBrowse:At(), 1] })
      oColumn:SetTitle(STR0021) // "Número de Pedido"
      oColumn:SetSize(15)
   
      aAdd(aColumns, oColumn)
      oColumn := FWBrwColumn():New()
      oColumn:SetType("C")
      oColumn:SetData({|oBrowse| aArrayGrup[oBrowse:At(), 2] })
      oColumn:SetTitle(STR0022) // "Fecha del Pedido"
      oColumn:SetSize(8)
   
      aAdd(aColumns, oColumn)
      oBrowse := FWBrowse():New(oPanelGrid)
      oBrowse:SetDescription(OemToAnsi(STR0023)) //"Pedidos Ediwin"
      oBrowse:SetDataArray()
      oBrowse:DisableFilter()
      oBrowse:DisableConfig()
      oBrowse:SetColumns(aColumns)
      oBrowse:SetArray(aArrayGrup)
      oBrowse:Activate()
      oModal:Activate()
      If lRet
         If Len(aArrayGrup) > 0
            cNumPed:= Alltrim(cValToChar(aArrayGrup[oBrowse:nAt][1]))
            If lMvEdiPed
               M->C5_NUM := cNumPed
            Endif
         EndIf
         If lCpoEdiPed
            lRet := EdiValPed(cNumPed)
         Endif
         If lRet
           	Processa({|| EdiReadFact(cNumPed) },STR0043) //"Procesando items del pedido"
         Endif
      Endif
   Else
      HELP(' ',1,STR0023 ,,STR0024,2,0,,,,,, {STR0025}) // "Pedidos Ediwin" - "No se encontraron pedidos en el portal de Ediwin en las fechas informadas" - "Verifique la fecha inicio y la fecha fin"
   Endif
   FreeObj(oModal)
   FreeObj(oBrowse)
   FreeObj(oColumn)
   FreeObj(oPanelGrid)
   FreeObj(oModalPanel)
   FwfreeArray(aColumns)
   FwfreeArray(aArrayGrup)
   bOk := Nil
   bCancel := Nil

Return 


/*/{Protheus.doc} EdiValPed
Función para validar que el pedido a ser importado ya se encuentra relacionado
a un pedido en protheus
@type function
@version 1.0 
@author eduardo.manriquez
@since 4/28/2026
@param cNumPed, character, param_description
@return lRet, retorna .T. cuando existe un pedido relacionado en protheus
/*/
Function EdiValPed(cNumPed)
   Local lRet     as Logical
   Local cQuery   as Character
   Local cFilSC6  as Character
   Local nOrd     as Numeric
   Local cAlias   as Character
   Local oQryExec as Object 
   
   cFilSC6  := xFilial("SC6")
   nOrd     := 1
   lRet     := .T.
   cAlias   := getNextAlias()
   cQuery   := "SELECT C6_NUM "
	cQuery   += "FROM "+RetSqlName("SC6")+" SC6 "
	cQuery   += "WHERE SC6.C6_FILIAL= ? AND "
	cQuery   += "SC6.C6_EDIPED= ? AND "
	cQuery   += "SC6.D_E_L_E_T_ = ? "
	cQuery   += "ORDER BY C6_NUM"

   oQryExec := FWExecStatement():New(cQuery)
	oQryExec:SetString(nOrd++, cFilSC6) //Filial 
	oQryExec:SetString(nOrd++, cNumPed) //Pedido Ediwin 
	oQryExec:SetString(nOrd++, ' ') //Delete SC6
		
   cAlias := oQryExec:OpenAlias()
	
   (cAlias)->(DbGoTop())

   While (cAlias)->(!Eof())
      lRet:= MsgYesNo(STR0039+cNumPed+STR0040+(cAlias)->C6_NUM+STR0041,STR0042) // "El pedido " -" ya se encuentra registrado en protheus con el número de pedido "- " ¿Desea realiza la importación nuevamente?" - "Importación de pedido"
      Exit
   Enddo
   oQryExec:Destroy()
   FreeObj(oQryExec)

Return lRet

/*/{Protheus.doc} EdiGetRfc
Función que retorna RFC del cliente informado en
encabezado de pedido
@type function
@version 1.0
@author eduardo.manriquez
@since 4/25/2026
@param cCliente, character, Código del cliente
@param cLoja, character, Tienda del cliente
@return cRfc, RFC del cliente
/*/
Function EdiGetRfc(cCliente,cLoja)
   Local cRfc    as Character
   Local cFilSA1 as Character
   Local aArea   as Character

   Default cCliente := ""
   Default cLoja := ""

   cRfc := ""
   aArea := GetArea()
   cFilSA1 := xFilial("SA1")

   DbSelectArea("SA1")
	SA1->(DbSetOrder(1)) //A1_FILIAL+A1_COD+A1_LOJA
	If SA1->(MsSeek(cFilSA1 + cCliente + cLoja))
      cRFC := Alltrim(SA1->A1_CGC)
   Endif
   SA1->(DbCloseArea())

   if Empty(cRFC)
      HELP(' ',1,STR0029,,STR0030,2,0,,,,,,)// "Información de Cliente" -  "Para realizar la importación de pedidos, el cliente debe contar con un RFC informado"
   Endif 

   RestArea(aArea)
   FwfreeArray(aArea)
   

Return cRfc

/*/{Protheus.doc} EdiReadFact
Función que lee el archivo .EDI del pedido seleccionado
para poder informar los items en el pedido en protheus.
El uso de esta función depende de activación de grupo de preguntas EDIWINPED
para poder usar las variables MV_PAR03 y MV_PAR04
@type function
@version 1.0
@author eduardo.manriquez
@since 4/25/2026
@param cNumPed, character, Número de Pedido seleccionado
/*/
Function EdiReadFact(cNumPed)
   Local cFilePath   as Character
   Local nX          as Numeric
   Local cFilSB1     as Character
   Local cUm         as Character
   Local cTes        as Character
   Local cLoc        as Character
   Local nPosItem    as Numeric
   Local nPosCodProd as Numeric
   Local nPosUm      as Numeric
   Local nPosCant    as Numeric
   Local nPosPrcUnit as Numeric
   Local nPosValTot  as Numeric
   Local nPosTes     as Numeric
   Local nPosLoc     as Numeric
   Local nPosEdiPed  as Numeric
   Local lCpoEdiPed  as Logical
   Local cFileEdi    as Character
   Local cLogError   as Character
   Local cCRLF	      as Character
   Local cFileData   as Character
   Local oFile       as Object
   Local oOrder      as Object

   Default cNumPed   := ""

   cFilePath := "\system\cfd\pedidosediwin\"
   cFileEdi := cNumPed + ".EDI"
   cFilSB1 := xFilial("SB1")
   cUm     := ""
   cTes    := MV_PAR03
   cLoc    := MV_PAR04
   cLogError    := ""
   cCRLF	    := (chr(13)+chr(10))
   
   If Type("aCols") == "A" .and. Type("aHeader") == "A"
      oFile := FwFileReader():New(cFilePath+cFileEdi)
      lCpoEdiPed  := SC6->(ColumnPos("C6_EDIPED")) > 0
      nPosItem    :=  aScan(aHeader,{|x| Alltrim((x)[2]) == "C6_ITEM"})
      nPosCodProd :=  aScan(aHeader,{|x| Alltrim((x)[2]) == "C6_PRODUTO"})
      nPosUm      :=  aScan(aHeader,{|x| Alltrim((x)[2]) == "C6_UM"})
      nPosCant    :=  aScan(aHeader,{|x| Alltrim((x)[2]) == "C6_QTDVEN"})
      nPosPrcUnit :=  aScan(aHeader,{|x| Alltrim((x)[2]) == "C6_PRCVEN"})
      nPosValTot  :=  aScan(aHeader,{|x| Alltrim((x)[2]) == "C6_VALOR"})
      nPosTes     :=  aScan(aHeader,{|x| Alltrim((x)[2]) == "C6_TES"})
      nPosLoc     :=  aScan(aHeader,{|x| Alltrim((x)[2]) == "C6_LOCAL"})

      if lCpoEdiPed
         nPosEdiPed := aScan(aHeader,{|x| Alltrim((x)[2]) == "C6_EDIPED"})
      Endif
      if (oFile:Open())
         cFileData := oFile:FullRead()
         oOrder := EdiParseJson(cFileData,cTes,cLoc)

         If oOrder:hasProperty('Items') .and. !(ValType(oOrder['Items']) == "U") .and. Len(oOrder['Items'])>0
            For nX := 1 To Len(oOrder['Items'])

               DbSelectArea("SB1")
               SB1->(DbSetOrder(1)) //A1_FILIAL+A1_COD+A1_LOJA
               If !(SB1->(MsSeek(cFilSB1 + oOrder['Items'][nX]['codigoProducto'])))
                  EdiCreateProduct(oOrder['Items'][nX],cLoc,@cLogError)
                  cUm := oOrder['Items'][nX]['unidadMedida']
               Else
                  cUm := SB1->B1_UM
                  cLoc:= SB1->B1_LOCPAD
               Endif
               SB1->(DbCloseArea())

               if nX > 1 .and. Len(aCols) < nX
                  AAdd(aCols,aClone(aCols[1]))
               Elseif nX == 1
                  aCols := {aClone(aCols[1])}
               Endif

               aCols[nX][nPosItem]:= oOrder['Items'][nX]['linea']             // Número Item
               aCols[nX][nPosCodProd]:= oOrder['Items'][nX]['codigoProducto'] // Código de producto
               aCols[nX][nPosUm]:= cUm                                        // Unidad Medida
               aCols[nX][nPosCant]:= oOrder['Items'][nX]['cantidad']          // Cantidad
               aCols[nX][nPosPrcUnit]:= oOrder['Items'][nX]['precioUnitario'] // Precio Unitario
               aCols[nX][nPosValTot]:= oOrder['Items'][nX]['valor']           // Valor
               aCols[nX][nPosLoc]:= cLoc                                    // Depósito
               aCols[nX][nPosTes]:= cTes                                    // Depósito
               if lCpoEdiPed
                  aCols[nX][nPosEdiPed]:= cNumPed                           // PedidoEdiwin
               Endif

            Next
         Else
            HELP(' ',1,STR0031,,STR0027+cFilePath+cFileEdi,2,0,,,,,,{STR0032})// "Falla al procesar el archivo" - "No se pudo procesar el archivo " - "Verifique que el archivo tenga el formato correcto."
         Endif
      Else
         HELP(' ',1,STR0031,,STR0027+cFileEdi,2,0,,,,,,{STR0033+cFilePath+STR0038})//"Falla al procesar el archivo" - "Verifique que el archivo exista en la ubicación " 
      Endif
      If !Empty(cLogError) .and. MsgYesNo(STR0035,STR0034) // "Productos no registrados" - "Algunos productos no pudieron ser registrados en protheus, ¿Desea visualizar los productos?"
         HELP(' ',1,STR0034,,STR0036+cCRLF+cLogError,2,0,,,,,,{STR0037})// "Los siguientes productos no fueron registrados en protheus:"-"Verifique que la unidad de medida se encuentre registrada en el catálogo de Unidades de medida"
      Endif
      FreeObj(oOrder)
      FreeObj(oFile)
   Endif

Return

/*/{Protheus.doc} EdiCreateProduct
Función para crear un producto importado que no existe en protheus
@type function
@version 1.0
@author eduardo.manriquez
@since 4/25/2026
@param oItem, object, Objeto Json que contiene la información del producto
@return cLogError, Mensaje de error que contiene los productos que no fueron registrados.
/*/
Function EdiCreateProduct(oItem,cLoc,cLogError)

   Local oModel	   as Object
   Local cCod			as Character 
   Local cDesc			as Character
   Local cUm         as Character
   Local cCRLF	      as Character 
   Default oItem     := Nil
   Default cLoc      := "01"
   Default cLogError := ""

   cCod  := PadR( oItem['codigoProducto'], FWSX3Util():GetFieldStruct('B1_COD' )[3])
   cDesc := PadR( oItem['codigoProducto'], FWSX3Util():GetFieldStruct('B1_DESC' )[3])
   cUm   := PadR( oItem['unidadMedida']  , FWSX3Util():GetFieldStruct('B1_UM' )[3])
   cCRLF	    := (chr(13)+chr(10))

   DbSelectArea("SAH")
   SAH->(DbSetOrder(1)) // AH_UNIMED   
   If !SAH->(DbSeek( xFilial("SAH") + cUm ))
      If Empty(cLogError)
         cLogError += Alltrim(cCod)
      Else
         cLogError += ", " + Alltrim(cCod)
      Endif
      
      Return cLogError
   EndIf
   oModel := FWLoadModel('MATA010')
   oModel:SetOperation(3)

   oModel:Activate()
   //Start SB1MASTER
   oModel:SetValue('SB1MASTER','B1_COD'   , cCod)
   oModel:SetValue('SB1MASTER','B1_DESC'  , cDesc)
   oModel:SetValue('SB1MASTER','B1_TIPO'  , "PA")
   oModel:SetValue('SB1MASTER','B1_UM'    , cUm)
   oModel:SetValue('SB1MASTER','B1_LOCPAD', cLoc)
   
   If oModel:VldData()
      oModel:CommitData()
   Endif
   
   oModel:DeActivate()
   oModel:Destroy()
   oModel:=Nil
   FreeObj(oModel)

Return

/*/{Protheus.doc} EdiParseJson
Función que realiza el tratamiento del contenido del archivo .EDI para
generar un objeto json con la información del pedido
@type function
@version 1.0 
@author eduardo.manriquez
@since 4/25/2026
@param cFileData, character, Cadena que contiene una cadena en formato .EDI
@param cTes, character, Tipo de entrada/salida que se utilizará para los productos importados
@param cLoc, character, Depósito que se utilizará para los productos importados
@return oOrder, Objeto Json con la información del pedido
              {
                  "Header": {
                    "numero": "",
                    "fechaEmision": "",
                    "cliente": "",
                    "proveedor": "",
                    "moneda": ""
                  },
                  "Items": [
                    {
                      "linea": "",
                      "codigoProducto": "",
                      "cantidad": 0,
                      "precioUnitario": 0,
                      "valor": 0,
                      "unidadMedida": "",
                      "tes": "",
                      "deposito": "",
                      "codigoProductoInt": "",
                      "codigoProductoProv": "",
                      "descripcion": ""
                    }
                  ],
                  "Summary": {
                    "total": 0,
                    "cantidadlineas": 0
                  }
               }
/*/
Function EdiParseJson(cFileData,cTes,cLoc)
   Local oOrder as Object
   Local oItem  as Object
   Local nItem  as Numeric
   Local nX     as Numeric
   Local cLine  as Character
   Local a      as Array
   Local aAux   as Array
   Local aLines as Array
   Local cItem  as Character

   nItem := 1
   nX    := 1
   cLine := ""
   a     := {}
   aAux  := {}
   aLines:= {}
   cItem := ""

   aLines := StrTokArr(cFileData, Chr(39))
   oOrder := JsonObject():New()
   oOrder["Header"]  := JsonObject():New()
   oOrder["Items"]   := {}
   oOrder["Summary"] := JsonObject():New()

   For nX:=1 To Len(aLines)

      cLine := STRTRAN(aLines[nX],Chr(10),"")
      If Empty(cLine)
         Loop
      EndIf

      Do Case

      // ================= HEADER =================

      Case Left(cLine,3) == "BGM"
         a := StrTokArr(cLine,"+")
         oOrder["Header"]["numero"] := a[3]

      Case Left(cLine,3) == "DTM"
         a := StrTokArr(cLine,"+")
         aAux := StrTokArr(a[2],":")
         oOrder["Header"]["fechaEmision"] := aAux[2]

      Case Left(cLine,3) == "NAD"
         a := StrTokArr(cLine,"+")
         If a[2] == "BY"
            oOrder["Header"]["cliente"] := a[3]
         ElseIf a[2] == "SF" .or. a[2] == "SU"
            oOrder["Header"]["proveedor"] := a[3]
         EndIf

      Case Left(cLine,3) == "CUX"
         a := StrTokArr(cLine,"+")
         oOrder["Header"]["moneda"] := StrTokArr(a[2],":")[2]

      // ================= ITENS =================

      Case Left(cLine,3) == "LIN"
         nItem++
         oItem := JsonObject():New()
         a := StrTokArr(cLine,"+")
         If Val(a[2])< 10
            cItem := "0"+a[2]
         Else
            cItem:= a[2]
         Endif
         oItem["linea"] := cItem
         oItem["codigoProducto"] := StrTokArr(a[3],":")[1]
         oItem["cantidad"]  := 0
         oItem["precioUnitario"] := 0
         oItem["valor"] := 0
         oItem["unidadMedida"] := "EA"
         AAdd(oOrder["Items"], oItem)

      Case Left(cLine,3) == "PIA"
         a := StrTokArr(cLine,"+")
         aAux := StrTokArr(a[3],":")
         If aAux[2] == "IN"
            oItem["codigoProductoInt"] := aAux[1]
         EndIf
         If Len(a) >= 4
            aAux := StrTokArr(a[4],":")
            If aAux[2] == "VN"
               oItem["codigoProductoProv"] := aAux[1]
            EndIf
         EndIf

      Case Left(cLine,3) == "IMD"
         a := StrTokArr(cLine,"+")
         aAux := StrTokArr(a[4],":")
         oItem["descripcion"] := aAux[1]

      Case Left(cLine,3) == "QTY"
         a := StrTokArr(cLine,"+")
         aAux := StrTokArr(a[2],":")
         oItem["cantidad"] := Val(aAux[2])
         If Len(aAux) >= 3
            oItem["unidadMedida"] := aAux[3]
         EndIf

      Case Left(cLine,3) == "PRI"
         a := StrTokArr(cLine,"+")
         oItem["precioUnitario"] := Val(StrTokArr(a[2],":")[2])

      Case Left(cLine,3) == "MOA"
         a := StrTokArr(cLine,"+")
         aAux := StrTokArr(a[2],":")
         If aAux[1] == "203"
            oItem["valor"] := Val(aAux[2])
         ElseIf aAux[1] == "86"
            oOrder["Summary"]["total"] := Val(aAux[2])
         EndIf

      Case Left(cLine,3) == "CNT"
         a := StrTokArr(cLine,"+")
         oOrder["Summary"]["cantidadlineas"] := Val(StrTokArr(a[2],":")[2])

      EndCase

   Next
   FreeObj(oItem)
   FwfreeArray(aLines)
   FwfreeArray(aAux)
   FwfreeArray(a)
Return oOrder


/*/{Protheus.doc} EdiWinGetDocuments
Función que inicia la petición al web-service getDocuments
@type function
@version 1.0 
@author eduardo.manriquez
@since 5/6/2026
@param cDoc, character, Número de documento
@param cSer, character, Serie de documento
@param cEsp, character, Especie del documento
@param cUuid, character, UUID del documento
@param dFecTimb, date, Fecha de timbrado del documento
/*/
Function EdiWinGetDocuments(cDoc,cSer,cEsp,cUuid,dFecTimb)
   Local aParamEdi   as Array
   Local lRet        as Logical
   Local cExportTp   as Character
   Local cDocProt    as Character
   Local cMsj        as Character
   Local cMsjError   as Character
   Local cMsjSol     as Character
   Local cFileParam  as Character
   Local cProcesa    as Character
   Local cCFDiSF1    as Character
   Local cCFDiSF2    as Character
   Default cDoc      := ""
   Default cSer      := ""
   Default cEsp      := ""
   Default cUuid     := ""
   Default dFecTimb  := CTOD("  /  /  ")

   cCFDiSF1 := SuperGetmv( "MV_CFDNAF1" , .F. , "" )
   cCFDiSF2 := SuperGetmv( "MV_CFDNAF2" , .F. , "" )
   cMsj     := ""
   cMsjError := ""
   cMsjSol   := ""
   cProcesa  := ""
   aParamEdi := {}
   lRet      := .T.
   cExportTp := ""
   cFileParam := Alltrim(cSer)+Alltrim(cDoc)

   If Alltrim(cEsp) == "NCC"
      cDocProt := &(cCFDiSF1)
   Else
      cDocProt := &(cCFDiSF2)
   Endif
   
   lRet := EdiGetParams(3,@aParamEdi)
   If lRet .and. Empty(cUuid) .and. Empty(dFecTimb)
      Help(' ',1,STR0049 ,,STR0050,2,0,,,,,, {STR0051}) // "Recuperación XML\PDF"- "El documento no se encuentra timbrado." - "Realizar el timbrado y publicación del documento en el portal Ediwin antes de intentar recuperar archivos."
      lRet := .F.
   Endif
   if lRet
      If Pergunte("EDIWINGETD",.T.)
         
         If MV_PAR01 == 1 .Or. MV_PAR01 == 3
            cExportTp := "2"
            cProcesa  := STR0052 // "Importando archivo XML"
         Elseif MV_PAR02 == 2
            cExportTp := "4"
            cProcesa  := STR0053 // "Importando archivo PDF"
         Endif

         Processa({||EdiCreateRest(aParamEdi,cExportTp,cDocProt,@cMsj,@cMsjError,@cMsjSol,cFileParam)},cProcesa)


         If MV_PAR01 == 3
            Processa({||EdiCreateRest(aParamEdi,"4",cDocProt,@cMsj,@cMsjError,@cMsjSol,cFileParam)},STR0053) // "Importando archivo PDF"
         Endif

         If !Empty(cMsj)
            Aviso(STR0049, cMsj, {STR0054}) // "Recuperación XML\PDF"- "OK"
         Endif

         If !Empty(cMsjError)
            Help(' ',1,STR0049 ,,cMsjError,2,0,,,,,, {cMsjSol}) // "Recuperación XML\PDF"
         Endif
      Endif
   Endif
   FwfreeArray(aParamEdi)
Return

/*/{Protheus.doc} EdiCreateRest
Función que realiza la petición al web-service getDocuments
@type function
@version 1.0
@author eduardo.manriquez
@since 5/6/2026
@param aParamEdi, array, Arreglo con la configuración para integración con portal Ediwin
@param cExportTp, character, Parámetro que indica el archivo a importar, "2" - XML, "4" - PDF
@param cDocProt, character, Nombre del archivo xml\pdf en protheus
@param cMsj, character, Mensaje para mostrar cuales archivos fueron importados y cuales no
@param cMsjError, character, Mensaje para mostrar los errores
@param cMsjSol, character, Mensaje para mostrar la solución del error
@param cFileParam, character, Nombre del archivo que se usa en el filtro de la petición al servicio web
/*/
Function EdiCreateRest(aParamEdi,cExportTp,cDocProt,cMsj,cMsjError,cMsjSol,cFileParam)
   Local cUrl        as Character
   Local cPath       as Character
   Local cUsr        as Character
   Local cPass       as Character
   Local cGrp        as Character
   Local cDom        as Character
   Local cBoundary   as Character
   Local cBody       as Character
   Local aHeaders    as Array
   Local oFileWrite  as Object  
   Local oRest       as Object
   Local oJson       as Object
	Local CRLF	      as Character  
   Local cFileEdi    as Character  
   Local cPathZip    as Character
   Local cParameters as Character  
   Local lFileOK     as Logical
   Local cStatus     as Character
   Local cResult     as Character
   Local cFileZip    as Character
   Local lRet        as Logical
   Default aParamEdi  := {}
   Default cExportTp  := ""
   Default cDocProt   := ""
   Default cMsj       := ""
   Default cMsjError  := ""
   Default cMsjSol    := ""
   Default cFileParam := ""

   cUrl        := aParamEdi[1]
   cPath       := aParamEdi[2]
   cUsr        := aParamEdi[3]
   cPass       := aParamEdi[4]
   cGrp        := aParamEdi[5]
   cDom        := aParamEdi[6]

   If cExportTp == "2"
      cFileEdi := "XML_COMPROBANTE_4_0.XML"
   Elseif cExportTp == "4"
      cFileEdi := "composer.pdf"
      cDocProt := RetFileName(cDocProt)+".pdf"
   Endif
   
   cFileZip    := "ediwingetdocs"
   lRet        := .T.
   lFileOK     := .F. 
   cStatus     := ""
   cResult     := ""
   aHeaders    := {}
   cBoundary   := "----WebKitFormBoundary7MA4YWxkTrZu0gW"
   cPathZip    := &(SuperGetmv( "MV_CFDDOCS" , .F. , "\cfd\facturas\" ))
   cParameters := '[{"name":"REFERENCIA","operator":"=","value":"'+cFileParam+'"},{"name": "ESTADO", "operator": "LIKE", "value": "COR"}]'
   CRLF	      := (chr(13)+chr(10))
   oRest       := FWRest():New(cUrl)
   oJson       := JsonObject():new()

   // ========================
   // Construcción del cuerpo multipart/form-data
   // ========================
   cBody := "--" + cBoundary + CRLF
   cBody += 'Content-Disposition: form-data; name="user"' + CRLF + CRLF + cUsr + CRLF
   cBody += "--" + cBoundary + CRLF
   cBody += 'Content-Disposition: form-data; name="password"' + CRLF + CRLF + cPass + CRLF
   cBody += "--" + cBoundary + CRLF
   cBody += 'Content-Disposition: form-data; name="domain"' + CRLF + CRLF + cDom + CRLF
   cBody += "--" + cBoundary + CRLF
   cBody += 'Content-Disposition: form-data; name="exportType"' + CRLF + CRLF + cExportTp + CRLF
   // Campos restantes
   cBody += "--" + cBoundary + CRLF + 'Content-Disposition: form-data; name="params"' + CRLF + CRLF + cParameters + CRLF
   cBody += "--" + cBoundary + CRLF + 'Content-Disposition: form-data; name="group"' + CRLF + CRLF + cGrp + CRLF
   cBody += "--" + cBoundary + "--"
   // ========================
   // Encabezados HTTP
   // ========================
   aAdd(aHeaders, 'Content-Type: multipart/form-data; boundary=' + cBoundary)
   AAdd(aHeaders, "charset: UTF-8")
   oRest:SetPath(cPath)
   oRest:SetPostParams(cBody)
   // ========================
   // Ejecución del POST
   // ========================
   oRest:Post(aHeaders)
   // ========================
   // Restauración de respuesta de archivo .zip
   // ========================
   cStatus := oRest:GetHttpCode()
   cResult := oRest:GetResult()
   FreeObj(oRest)

   If !(cStatus == "200")
      // Validação da estrutura do Json retornado
      oJson:fromJson(cResult)
      cMsjError := STR0011 // "Error al convertir respuesta de webservice"
      If ValType(oJson["errorText"]) == "C" 
         cMsjError := DecodeUtf8(oJson["errorText"])
      Endif
      cMsj += STR0055 + cDocProt + CRLF+ CRLF // "No se pudo importar el archivo"
   Else
      oFileWrite := FwFileWriter():New(cPathZip+cFileZip+".zip",.T.)
      If oFileWrite:Create()
         lFileOK := oFileWrite:Write(cResult)
         If lFileOk
            oFileWrite:Close()
            If File(cPathZip+cDocProt)
               lRet := MsgYesNo(STR0056+cDocProt+STR0057+cPathZip+CRLF+STR0058,"") // "El archivo "-" ya se encuentra en la carpeta" "¿Desea realizar la importación?
            Endif
            If lRet
               Ferase(cPathZip+cDocProt+".respaldo")
               Frename(cPathZip+cDocProt ,cPathZip+cDocProt+".respaldo")
               FUnZip(cPathZip+cFileZip+".zip", cPathZip)
               If Frename(cPathZip+cFileEdi ,cPathZip+cDocProt) <> -1
                  cMsj += STR0059+cDocProt +STR0060+CRLF+ CRLF // "Archivo " - "importado con éxito"
                  Ferase(cPathZip+cDocProt+".respaldo")
               Else
                  Frename(cPathZip+cDocProt+".respaldo",cPathZip+cDocProt)
                  cMsj += STR0061 + cDocProt + CRLF+ CRLF // "No se pudo importar el archivo
                  cMsjError := STR0062 // "Existen archivos que no pudieron ser importados"
                  cMsjSol:=CRLF+ STR0063+ CRLF+CRLF+; // "Verificar que los archivos se encuentre publicados en el portal."
                  STR0064 +cPathZip+STR0065+ CRLF+CRLF+ ; // "Verificar que el archivo edigetdocs.zip se haya generado en la carpeta "- " y contenga los archivos a importar."
                  STR0066+cPathZip+STR0067 // "Verificar que los archivos de la carpeta "-" tenga permisos de lectura y escritura."
               Endif
            Endif

         Endif
      Else
         cMsjError := STR0068 // "Error al intentar crear archivo ediwingetdocs.zip"
         cMsjSol   := STR0069+cPathZip+ STR0067 // "Verifique que la carpeta "-" tenga permisos de lectura y escritura"
      Endif
      FreeObj(oFileWrite)      
   Endif
   FreeObj(oJson)
   FwfreeArray(aHeaders)
Return
