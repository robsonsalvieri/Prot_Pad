#INCLUDE 'msobject.ch'
#INCLUDE 'totvs.framework.treports.integratedprovider.th'
#INCLUDE 'backoffice.sv.fat.LayoutIssuedDocuments.ch'

namespace custom.faturamento.LayoutIssuedDocuments.integratedprovider

//-------------------------------------------------------------------------------
/*{Protheus.doc} backoffice.sv.fat.LayoutIssuedDocuments
@description Classe para creación del Objeto de Negocio TReports
@author Marcelo Hruschka
@since 24/10/2024
@version 1.1
*/
//-------------------------------------------------------------------------------
@totvsFrameworkTReportsIntegratedProvider( active=.T., team='SIGAFAT', tables='SF2,SD2,SF1,SD1,SB1,SA1', name='Layout Issued Documents', country='MEX', initialRelease='12.1.2410', customTables='SF2,SD2,SF1,SD1,SB1,SA1' )
class LayoutIssuedDocumentsTReportsBusinessObject from totvs.framework.treports.integratedprovider.IntegratedProvider

	public Method new() as object
	public Method getData() as object
	public Method getSchema() as object

	protected data aFields as array
	protected data aStruct as array
	protected data jItems as json

endclass

//-------------------------------------------------------------------
/*{Protheus.doc} new
Método de instância da classe 
@Return object: self
@author Marcelo Hruschka
@since 24/05/2024
@version 1.0
*/
//-------------------------------------------------------------------
Method new() class LayoutIssuedDocumentsTReportsBusinessObject

	Local aCpos := {} as array

	_Super:new()

	//Define o nome do Objeto de Negócio
	self:setDisplayName( STR0001 )	// 'Layout Issued Documents'

	//Define a descrição do Objeto de Negócio
	self:setDescription( STR0001 )	// 'Layout Issued Documents'

	// Define a Área
	self:appendArea( STR0002 ) // 'Facturación'

	// Define se as perguntas terao lookup
	self:setIsLookUp( .T. )

	// Indica o pergunte que será utilizado no relatório
	If !self:setPergunte( 'FATSV504' )
		IIf(!self:setErrorStatus( 400, STR0003, STR0004 ),FwLogMsg( 'WARN',, 'Smart View',,,, STR0005,,, ),'') // 'Sin Preguntas' // '¡Verifique el grupo de preguntas dado!' // 'Código de error no válido, solo acepte códigos de error 4xx'
		FwLogMsg( 'WARN',, 'Smart View',,,, STR0006,,, ) // 'Grupo de preguntas no encontrado!'
	EndIf

	// campos que no existen en SX3
	aAdd( aCpos, { 'M0_CGC'     , 'M0_CGC'      , 'string'	, 'M0_CGC'      } )
	aAdd( aCpos, { 'M0_NOME'    , 'M0_NOME'     , 'string'	, 'M0_NOME'     } )
	aAdd( aCpos, { 'M0_NOMECOM' , 'M0_NOMECOM'  , 'string'	, 'M0_NOMECOM'  } )
	aAdd( aCpos, { 'M0_ENDCOB'  , 'M0_ENDCOB'   , 'string'	, 'M0_ENDCOB'   } )
	aAdd( aCpos, { 'M0_BAIRCOB' , 'M0_BAIRCOB'  , 'string'	, 'M0_BAIRCOB'  } )
	aAdd( aCpos, { 'M0_CIDCOB'  , 'M0_CIDCOB'   , 'string'	, 'M0_CIDCOB'   } )
	aAdd( aCpos, { 'M0_ESTCOB'  , 'M0_ESTCOB'   , 'string'	, 'M0_ESTCOB'   } )
	aAdd( aCpos, { 'M0_CEPCOB'  , 'M0_CEPCOB'   , 'string'	, 'M0_CEPCOB'   } )
	aAdd( aCpos, { 'M0_TEL'     , 'M0_TEL'      , 'string'	, 'M0_TEL'      } )
	aAdd( aCpos, { 'FECHATIM'   , 'FECHATIM'    , 'string'	, 'FECHATIM'    } )
	aAdd( aCpos, { 'CERSAT'     , 'CERSAT'      , 'string'	, 'CERSAT'      } )
	aAdd( aCpos, { 'SELLOSAT'   , 'SELLOSAT'    , 'string'	, 'SELLOSAT'    } )
	aAdd( aCpos, { 'UUID'       , 'UUID'        , 'string'	, 'UUID'        } )
	aAdd( aCpos, { 'SELLO'      , 'SELLO'       , 'string'	, 'SELLO'       } )
	aAdd( aCpos, { 'CADENA'     , 'CADENA'      , 'string'	, 'CADENA'      } )
	aAdd( aCpos, { 'REPORT'     , 'REPORT'      , 'string'	, 'REPORT'      } )
	aAdd( aCpos, { 'ALIQ1'      , 'ALIQ1'       , 'number'	, 'ALIQ1'      	} )
	aAdd( aCpos, { 'QRCODE'     , 'QRCODE'      , 'string'	, 'QRCODE'      } )
	aAdd( aCpos, { 'TOTAL'      , 'TOTAL'       , 'number'	, 'TOTAL'      	} )
	aAdd( aCpos, { 'EXTENSO'    , 'EXTENSO'     , 'string'	, 'EXTENSO'     } )

	// demais campos
	self:aFields := {'M0_NOME','M0_ENDCOB','M0_BAIRCOB','M0_CIDCOB','M0_ESTCOB','M0_CEPCOB','M0_CGC','M0_NOMECOM','M0_TEL','F1_DOC','F1_FORNECE','F1_LOJA','F1_EMISSAO','F1_STATUS','F1_HORA','F1_CERTFOL','F1_CERORI','A1_NOME','A1_END','A1_BAIRRO','A1_MUN','A1_EST','A1_CEP','A1_TEL','A1_CGC','D1_COD','D1_ITEM','D1_QUANT','D1_VUNIT','D1_TOTAL','D1_UM','F1_COND','E4_DESCRI','A1_ENDENT','F1_UUID','F1_FECTIMB','F1_USOCFDI','E4_MPAGSAT','F1_TPDOC','F1_FECANTF','F1_APROFOL','F1_VALADI','B1_DESC','F1_TIMBRE','FECHATIM','CERSAT','SELLOSAT','UUID','SELLO','CADENA','REPORT','F1_SERIE','F2_DOC','CK_NUM','EXTENSO','F1_FRETE','F1_SEGURO','F1_DESCONT','F1_DESPESA','F1_BASIMP1','F1_VALIMP1','ALIQ1','QRCODE','TOTAL','F1_MOEDA'}


	self:aStruct := getStrutObj( self:aFields, aCpos )

Return( self )

//-------------------------------------------------------------------
/*{Protheus.doc} getData
Retorna los datos del objeto de negócio
@param nPage, numérico, indica la pagina actual del relatório
@param oFilter, objeto, contiene el filtro del TReports
@return object: self:oData
@author Marcelo Hruschka
@since 24/05/2024
@version 1.0
*/
//------------------------------------------------------------------- 
Method getData( nPage as numeric, oFilter as object) as object class LayoutIssuedDocumentsTReportsBusinessObject

	// Declaracao de variaveis
	Local cQuery		as character
	Local cFiltro 		as character
	Local cExp 			as character

	Local nX			as numeric
	Local n1			as numeric
	Local nPosMon		as numeric
	Local nPosExp		as numeric
	Local nDecs 		as numeric

	Local jParams 		as json

	Local aPDFields		as array
	Local aFiltro		as array
	Local aCustomFields as array

	Local lObfuscated	as logical

	Local oExecA		as object
	Local cAliasA       as character
	Local cEspecie      as character

	Local cFechaTim 	as character
	Local cCerSAT 		as character
	Local cSelloSAT 	as character
	Local cUUID 		as character
	Local cSello 		as character
	Local cCadOrig 		as character

	Local cCertQR  		as character
	Local cTotalDocu 	as character
	Local cClientRFC 	as character
	Local cRFCEmisor 	as character
	Local cParamFile    as character

	Local cVeriCFD      as character

	//Local nSeq          as numeric
	Private cPathDocs	as character
	Private cFileName	as character

	cParamFile := IIf(AllTrim(cEspecie) $ "NF|NDC",&(SuperGetmv("MV_CFDNAF2", .F., "Lower(AllTrim(SF2->F2_ESPECIE)) + '_' + Lower(AllTrim(SF2->F2_SERIE)) + '_'  + Lower(AllTrim(SF2->F2_DOC)) + '.xml'")),;
			&(SuperGetmv("MV_CFDNAF1", .F., "Lower(AllTrim(SF1->F1_ESPECIE)) + '_' + Lower(AllTrim(SF1->F1_SERIE)) + '_'  + Lower(AllTrim(SF1->F1_DOC)) + '.xml'")))
	cVeriCFD  := AllTrim(SuperGetMV("MV_VERICFD", .F., ""))
	cPathDocs := &(SuperGetmv("MV_CFDDOCS", .F., "\cfd\facturas\")) // Ruta donde se encuentran las facturas.xml (servidor)

	cFiltro 			:= ''
	cExp 				:= ''
	cAliasA			    := ''

	nPosMon   		:= 0
	nPosExp 		:= 0
	nDecs 			:= 0
	nX 				:= 0
	n1				:= 0

	aPDFields		:= { }
	aFiltro			:= { }
	aCustomFields	:= { }

	// Verifica se existem campos sensiveis na lista de campos a serem retornados
	aPDFields := FwProtectedDataUtil():UsrAccessPDField( __cUserID, self:aFields )
	lObfuscated := Len( aPDFields ) != Len( self:aFields )

	// Coleta os dados dos parametros
	jParams := oFilter:getParameters( )

	// Coleta os campos personalizados pelo usuário
	aCustomFields := self:getCustomFields( )
	cCpoSF2 := getCpoUser( aCustomFields, 'SF1', 'F1', ',' )
	cCpoSD2 := getCpoUser( aCustomFields, 'SD1', 'D1', ',' )
	cCpoSF1 := getCpoUser( aCustomFields, 'SF1', 'F1', ',' )
	cCpoSD1 := getCpoUser( aCustomFields, 'SD1', 'D1', ',' )
	cCpoSA1 := getCpoUser( aCustomFields, 'SA1', 'A1', ',' )
	cCpoSB1 := getCpoUser( aCustomFields, 'SB1', 'B1', ',' )

	// Adiciona campo customizado na estrutura de campos
	For n1 := 1 To Len( aCustomFields )
		aAdd( self:aStruct, { aCustomFields[n1, 1], aCustomFields[n1, 4], aCustomFields[n1, 3], aCustomFields[n1, 2], aCustomFields[n1, 1] } )
		aAdd( self:aFields, aCustomFields[n1, 1] )
	Next

	If oFilter:hasFilter( )
		// Tratamento para conversão para moeda selecionada
		cFiltro := oFilter:getSQLExpression( )
		aFiltro := getParamToArr( cFiltro )
		// Ordena os parametros
		aSort( aFiltro,,, { |x, y| x[1] + x[3] < y[1] + y[3] } )
		// Define os dados para conversão de moedas
		nPosExp := aScan( aFiltro, { | x | AllTrim( x[1] ) == 'REPORT' } )
		If ( nPosExp > 0 )
			cExp := aFiltro[nPosExp, 3]
			// Exclui o elemento do Array
			aDel( aFiltro, nPosExp )
			// Redimensiona o Array
			aSize( aFiltro, ( Len( aFiltro ) - 1 ) )
		EndIf
	EndIf

	cEspecie := ""
	If "FAT" $ cExp  //Factura de Venta
		cEspecie := "NF"
	ElseIf "NDC" $ cExp //Nota de Debito
		cEspecie := "NDC"
	ElseIf "NCC" $ cExp //Nota de Credito
		cEspecie := "NCC"
	EndIf

	// Realiza a montagem da QUERY que será enviada para o banco de dados
	If "NCC" $ cExp
		cQuery := "SELECT "
		cQuery += " SM0.M0_NOME, SM0.M0_ENDCOB, SM0.M0_BAIRCOB, SM0.M0_CIDCOB, SM0.M0_ESTCOB, SM0.M0_CEPCOB, SM0.M0_CGC, SM0.M0_NOMECOM, SM0.M0_TEL,"
		cQuery += " SF1.F1_DOC, SF1.F1_FORNECE, SF1.F1_LOJA, SF1.F1_EMISSAO, '' F1_STATUS, SF1.F1_HORA, SF1.F1_SERIE,"
		cQuery += " SF1.F1_CERTFOL, SF1.F1_CERORI, SF1.F1_TIMBRE, SF1.F1_FECTIMB,"
		cQuery += " SA1.A1_NOME, SA1.A1_END, SA1.A1_BAIRRO, SA1.A1_MUN, SA1.A1_EST, SA1.A1_CEP, SA1.A1_TEL, SA1.A1_CGC,"
		cQuery += " SD1.D1_COD, SD1.D1_ITEM, SD1.D1_QUANT, SD1.D1_VUNIT, SD1.D1_TOTAL, SD1.D1_UM, SF1.R_E_C_N_O_ AS REG,"
		cQuery += " SF1.F1_COND, SE4.E4_DESCRI, SA1.A1_ENDENT, SF1.F1_UUID, SF1.F1_USOCFDI, SE4.E4_MPAGSAT, SF1.F1_TPDOC,"
		cQuery += " SF1.F1_FECANTF, SF1.F1_APROFOL, SF1.F1_VALADI, SF1.F1_ESPECIE, SF1.F1_TIPODOC, SF1.F1_DOC||SF1.F1_SERIE||SF1.F1_FILIAL||SF1.F1_FORNECE||SF1.F1_LOJA AS F2_DOC, SF1.F1_DOC||SF1.F1_SERIE||SF1.F1_FILIAL||SF1.F1_FORNECE||SF1.F1_LOJA AS CK_NUM,"
		cQuery += " ? AS REPORT, SF1.F1_FRETE, SF1.F1_SEGURO, SF1.F1_DESCONT, SF1.F1_DESPESA, SF1.F1_BASIMP1, SF1.F1_VALIMP1, SF1.F1_MOEDA,"
		cQuery += " SF1.F1_VALMERC+SF1.F1_VALIMP1-SF1.F1_DESCONT+SF1.F1_SEGURO+SF1.F1_DESPESA+SF1.F1_FRETE AS TOTCALC,"
		cQuery += " ? "
		cQuery += " ? "
		cQuery += " ? "
		cQuery += " ? "
		cQuery += " SB1.B1_DESC"
		cQuery += " FROM " + RetSqlName("SF1") + " SF1"
		cQuery += " LEFT JOIN SYS_COMPANY SM0 ON SM0.M0_CODIGO = ? AND SM0.M0_CODFIL = ? AND SM0.D_E_L_E_T_ =  ?"
		cQuery += " LEFT JOIN " + RetSqlName("SA1") + " SA1 ON SA1.A1_FILIAL = ? AND SA1.A1_COD = SF1.F1_FORNECE AND SA1.A1_LOJA = SF1.F1_LOJA AND SA1.D_E_L_E_T_ = ?"
		cQuery += " LEFT JOIN " + RetSqlName("SD1") + " SD1 ON SD1.D1_FILIAL = ? AND SD1.D1_DOC = SF1.F1_DOC AND SD1.D1_SERIE = SF1.F1_SERIE AND SD1.D_E_L_E_T_ = ?"
		cQuery += " LEFT JOIN " + RetSqlName("SB1") + " SB1 ON SB1.B1_FILIAL = ? AND SB1.B1_COD = SD1.D1_COD AND SB1.D_E_L_E_T_ = ?"
		cQuery += " LEFT JOIN " + RetSqlName("SE4") + " SE4 ON SE4.E4_FILIAL = ? AND SE4.E4_CODIGO = SF1.F1_COND AND SE4.D_E_L_E_T_ = ?"
		cQuery += " WHERE SF1.F1_FILIAL = ?"
		cQuery += " AND SF1.F1_DOC BETWEEN ? AND ?"
		cQuery += " AND SF1.F1_SERIE BETWEEN ? AND ?"
		cQuery += " AND SF1.F1_EMISSAO BETWEEN ? AND ?"
		cQuery += " AND SF1.F1_ESPECIE = ?"
		cQuery += " AND SF1.D_E_L_E_T_ = ?"
	Else
		cQuery := "SELECT "
		cQuery += " SM0.M0_NOME, SM0.M0_ENDCOB, SM0.M0_BAIRCOB, SM0.M0_CIDCOB, SM0.M0_ESTCOB, SM0.M0_CEPCOB, SM0.M0_CGC, SM0.M0_NOMECOM, SM0.M0_TEL,"
		cQuery += " SF2.F2_DOC F1_DOC, SF2.F2_CLIENTE F1_FORNECE, SF2.F2_LOJA F1_LOJA, SF2.F2_EMISSAO F1_EMISSAO, '' F1_STATUS, SF2.F2_HORA F1_HORA,"
		cQuery += " SF2.F2_CERTFOL F1_CERTFOL, SF2.F2_CERORI F1_CERORI, SF2.F2_TIMBRE F1_TIMBRE, SF2.F2_FECTIMB F1_FECTIMB,"
		cQuery += " SA1.A1_NOME, SA1.A1_END, SA1.A1_BAIRRO, SA1.A1_MUN, SA1.A1_EST, SA1.A1_CEP, SA1.A1_TEL, SA1.A1_CGC, SF2.F2_SERIE F1_SERIE,"
		cQuery += " SD2.D2_COD D1_COD, SD2.D2_ITEM D1_ITEM, SD2.D2_QUANT D1_QUANT, SD2.D2_PRCVEN D1_VUNIT, SD2.D2_TOTAL D1_TOTAL, SD2.D2_UM D1_UM, SF2.R_E_C_N_O_ AS REG,"
		cQuery += " SF2.F2_COND F1_COND, SE4.E4_DESCRI, SA1.A1_ENDENT, SF2.F2_UUID F1_UUID, SF2.F2_USOCFDI F1_USOCFDI, SE4.E4_MPAGSAT, SF2.F2_TPDOC F1_TPDOC,"
		cQuery += " SF2.F2_FECANTF F1_FECANTF, SF2.F2_APROFOL F1_APROFOL, SF2.F2_VALADI F1_VALADI, SF2.F2_ESPECIE F1_ESPECIE, SF2.F2_TIPODOC F1_TIPODOC, SF2.F2_DOC||SF2.F2_SERIE||SF2.F2_FILIAL||SF2.F2_CLIENTE||SF2.F2_LOJA AS F2_DOC, SF2.F2_DOC||SF2.F2_SERIE||SF2.F2_FILIAL||SF2.F2_CLIENTE||SF2.F2_LOJA AS CK_NUM,"
		cQuery += " ? AS REPORT, SF2.F2_FRETE F1_FRETE, SF2.F2_SEGURO F1_SEGURO, SF2.F2_DESCONT F1_DESCONT, SF2.F2_DESPESA F1_DESPESA, SF2.F2_BASIMP1 F1_BASIMP1, SF2.F2_VALIMP1 F1_VALIMP1, SF2.F2_MOEDA F1_MOEDA,"
		cQuery += " SF2.F2_VALMERC+SF2.F2_VALIMP1-SF2.F2_DESCONT+SF2.F2_SEGURO+SF2.F2_DESPESA+SF2.F2_FRETE AS TOTCALC,"
		cQuery += " ? "
		cQuery += " ? "
		cQuery += " ? "
		cQuery += " ? "
		cQuery += " SB1.B1_DESC"
		cQuery += " FROM " + RetSqlName("SF2") + " SF2"
		cQuery += " LEFT JOIN SYS_COMPANY SM0 ON SM0.M0_CODIGO = ? AND SM0.M0_CODFIL = ? AND SM0.D_E_L_E_T_ =  ?"
		cQuery += " LEFT JOIN " + RetSqlName("SA1") + " SA1 ON SA1.A1_FILIAL = ? AND SA1.A1_COD = SF2.F2_CLIENTE AND SA1.A1_LOJA = SF2.F2_LOJA AND SA1.D_E_L_E_T_ = ?"
		cQuery += " LEFT JOIN " + RetSqlName("SD2") + " SD2 ON SD2.D2_FILIAL = ? AND SD2.D2_DOC = SF2.F2_DOC AND SD2.D2_SERIE = SF2.F2_SERIE AND SD2.D_E_L_E_T_ = ?"
		cQuery += " LEFT JOIN " + RetSqlName("SB1") + " SB1 ON SB1.B1_FILIAL = ? AND SB1.B1_COD = SD2.D2_COD AND SB1.D_E_L_E_T_ = ?"
		cQuery += " LEFT JOIN " + RetSqlName("SE4") + " SE4 ON SE4.E4_FILIAL = ? AND SE4.E4_CODIGO = SF2.F2_COND AND SE4.D_E_L_E_T_ = ?"
		cQuery += " WHERE SF2.F2_FILIAL = ?"
		cQuery += " AND SF2.F2_DOC BETWEEN ? AND ?"
		cQuery += " AND SF2.F2_SERIE BETWEEN ? AND ?"
		cQuery += " AND SF2.F2_EMISSAO BETWEEN ? AND ?"
		cQuery += " AND SF2.F2_ESPECIE = ?"
		If "FAT" $ cExp
			cQuery += " AND SF2.F2_TIPODOC IN ( ? )"
		Endif
		cQuery += " AND SF2.D_E_L_E_T_ = ?"
	Endif
	// Agrega os filtros na QUERY
	For nX := 1 To Len( aFiltro )
		cQuery += " AND ? " + ' ' + " ? ? "
	Next

	cQuery := ChangeQuery(cQuery)
	oExecA := FwExecStatement():New( cQuery )


	nSeq := 0
	oExecA:SetString( nSeq += 1, cExp )
	If "NCC" $ cExp
		oExecA:SetUnSafe( nSeq += 1, cCpoSF1 )
		oExecA:SetUnSafe( nSeq += 1, cCpoSD1 )
	Else
		oExecA:SetUnSafe( nSeq += 1, cCpoSF2 )
		oExecA:SetUnSafe( nSeq += 1, cCpoSD2 )
	Endif
	oExecA:SetUnSafe( nSeq += 1, cCpoSA1 )
	oExecA:SetUnSafe( nSeq += 1, cCpoSB1 )
	oExecA:SetString( nSeq += 1, cEmpAnt )
	oExecA:SetString( nSeq += 1, cFilAnt )
	oExecA:SetString( nSeq += 1, ' ' )
	oExecA:SetString( nSeq += 1, xFilial("SA1") )
	oExecA:SetString( nSeq += 1, ' ' )
	oExecA:SetString( nSeq += 1, xFilial("SD2") )
	oExecA:SetString( nSeq += 1, ' ' )
	oExecA:SetString( nSeq += 1, xFilial("SB1") )
	oExecA:SetString( nSeq += 1, ' ' )
	oExecA:SetString( nSeq += 1, xFilial("SE4") )
	oExecA:SetString( nSeq += 1, ' ' )
	oExecA:SetString( nSeq += 1, xFilial("SF2") )
	oExecA:SetString( nSeq += 1, jParams['MV_PAR01'][1] )
	oExecA:SetString( nSeq += 1, jParams['MV_PAR02'][1] )
	oExecA:SetString( nSeq += 1, jParams['MV_PAR03'][1] )
	oExecA:SetString( nSeq += 1, jParams['MV_PAR04'][1] )
	oExecA:SetString( nSeq += 1, DtoS( FwDateTimeToLocal( jParams['MV_PAR05'][1] )[1] ) )
	oExecA:SetString( nSeq += 1, DtoS( FwDateTimeToLocal( jParams['MV_PAR06'][1] )[1] ) )
	oExecA:SetString( nSeq += 1, cEspecie )

	If "FAT" $ cExp
		oExecA:SetIn( ( nSeq += 1 ), { '01','21' } )
	Endif

	oExecA:SetString( nSeq += 1, ' ' )
	For nX := 1 To Len( aFiltro )
		oExecA:SetUnSafe ( nSeq += 1, aFiltro[nX, 1] )
		oExecA:SetUnSafe ( nSeq += 1, aFiltro[nX, 2] )
		oExecA:SetUnSafe ( nSeq += 1, aFiltro[nX, 3] )
	Next
	// Executa a QUERY e cria uma tabela temporaria com os dados retornados
	cAliasA := oExecA:OpenAlias( )

	// Alimenta o objeto de dados da classe para retornar ao SmartView
	While !( cAliasA )->( EOF( ) )

		// posicina no registro
		If "NCC" $ cExp
			DbSelectArea("SF1")
			DbGoTo(( cAliasA )->REG)
			cEspecie := SF1->F1_ESPECIE
		Else
			DbSelectArea("SF2")
			DbGoTo(( cAliasA )->REG)
			cEspecie := SF2->F2_ESPECIE
		Endif

		cParamEspD	:= ( cAliasA )->F1_ESPECIE	//Parametro para Especie de Documento
		cParamSerD	:= ( cAliasA )->F1_SERIE	//Parametro para Serie de Documento
		cParamDocD	:= ( cAliasA )->F1_DOC		//Parametro para Folio de Documento
		cParamTpoD	:= ( cAliasA )->F1_TIPODOC	//Parametro para Tipo de Documento
		cParamCliD	:= ( cAliasA )->F1_FORNECE	//Parametro para Cliente de Documento
		cParamLojD	:= ( cAliasA )->F1_LOJA		//Parametro para Tienda de Documento

		cFileName := RetFileName(cParamFile)

		// abre xm da nota
		oXml := MATR475Xml(cEspecie, AllTrim(cFileName) + ".xml") //Genera objeto a partir del XML del documento

		// Verificar si está timbrado para obtener Fecha / Certificado SAT / Sello SAT / UUID
		cFechaTim := ""
		cCerSAT := ""
		cSelloSAT := ""
		cUUID := ""
		cSello := ""
		cCadOrig := ""
		cCertQR  := ""
		cTotalDocu := ""
		cClientRFC := ""
		cRFCEmisor := ""
		If oXml <> Nil
			If XMLChildEx(oXml:_CFDI_COMPROBANTE, "_CFDI_COMPLEMENTO") <> Nil
				If XMLChildEx(oXml:_CFDI_COMPROBANTE:_CFDI_COMPLEMENTO, "_TFD_TIMBREFISCALDIGITAL") <> Nil
					cFechaTim := oXml:_CFDI_COMPROBANTE:_CFDI_COMPLEMENTO:_TFD_TIMBREFISCALDIGITAL:_FECHATIMBRADO:TEXT
					cCerSAT	:= oXml:_CFDI_COMPROBANTE:_CFDI_COMPLEMENTO:_TFD_TIMBREFISCALDIGITAL:_NOCERTIFICADOSAT:TEXT
					cSelloSAT := oXml:_CFDI_COMPROBANTE:_CFDI_COMPLEMENTO:_TFD_TIMBREFISCALDIGITAL:_SELLOSAT:TEXT
					cUUID := oXml:_CFDI_COMPROBANTE:_CFDI_COMPLEMENTO:_TFD_TIMBREFISCALDIGITAL:_UUID:TEXT
				EndIf
			EndIf

			If XMLChildEx(oXml:_CFDI_COMPROBANTE, "_CFDI_EMISOR") <> Nil
				cRFCEmisor := oXml:_CFDI_COMPROBANTE:_CFDI_EMISOR:_RFC:TEXT
			Endif

			If XMLChildEx(oXml:_CFDI_COMPROBANTE, "_CFDI_RECEPTOR") <> Nil
				cClientRFC := MTR475CarE(AllTrim(oXml:_CFDI_COMPROBANTE:_CFDI_RECEPTOR:_RFC:TEXT))
			EndIf

			If XMLChildEx(oXml:_CFDI_COMPROBANTE, "_TOTAL") <> Nil
				cTotalDocu := oXml:_CFDI_COMPROBANTE:_TOTAL:TEXT
			EndIf

			If XMLChildEx(oXml:_CFDI_COMPROBANTE, "_SELLO") <> Nil
				cSello := OemToAnsi(oXml:_CFDI_COMPROBANTE:_SELLO:TEXT)
			EndIf
			MTR475CadO(@cCadOrig, oXml) // Construir la cadena original
			cCertQR := cVeriCFD + "?id=" + AllTrim(cUUID) + "&re=" + cRFCEmisor + "&rr=" + cClientRFC + "&tt=" + cTotalDocu + "&fe=" + Right(cSello,8)

		Endif

		self:jItems := JsonObject():new( )
		For nX := 1 To Len( self:aStruct )
			If lObfuscated .And. ( aScan( aPDFields, self:aStruct[nX][5] ) == 0 )
				self:jItems[self:aStruct[nX][1]] := FwProtectedDataUtil():ValueAsteriskToAnonymize( ( cAliasA )->&( self:aStruct[nX][5] ) )
			ElseIf ( self:aStruct[nX][3] == 'date' )
				self:jItems[self:aStruct[nX][1]] := totvs.framework.treports.date.dateToTimeStamp( StoD( ( cAliasA )->&( self:aStruct[nX][5] ) ) )
			Else
				If ( self:aStruct[nX][5] == 'FECHATIM' )
					self:jItems[self:aStruct[nX][1]] := cFechaTim
				ElseIf ( self:aStruct[nX][5] == 'CERSAT' )
					self:jItems[self:aStruct[nX][1]] := cCerSAT
				ElseIf ( self:aStruct[nX][5] == 'SELLOSAT' )
					self:jItems[self:aStruct[nX][1]] := cSelloSAT
				ElseIf ( self:aStruct[nX][5] == 'UUID' )
					self:jItems[self:aStruct[nX][1]] := cUUID
				ElseIf ( self:aStruct[nX][5] == 'SELLO' )
					self:jItems[self:aStruct[nX][1]] := cSello
				ElseIf ( self:aStruct[nX][5] == 'CADENA' )
					self:jItems[self:aStruct[nX][1]] := cCadOrig
				ElseIf ( self:aStruct[nX][5] == "EXTENSO" )
					self:jItems[self:aStruct[nX][1]] := Extenso(( cAliasA )->(TOTCALC), .F., ( cAliasA )->(F1_MOEDA), '', '2', .T., .T. )
				ElseIf ( self:aStruct[nX][5] == 'ALIQ1' )
					self:jItems[self:aStruct[nX][1]] := ROUND(( cAliasA )->(F1_VALIMP1)*100/( cAliasA )->(F1_BASIMP1),2)
				ElseIf ( self:aStruct[nX][5] == 'QRCODE' )
					self:jItems[self:aStruct[nX][1]] := cCertQR
				ElseIf ( self:aStruct[nX][5] == 'TOTAL' )
					self:jItems[self:aStruct[nX][1]] := Val(cTotalDocu)					
				Else
					self:jItems[self:aStruct[nX][1]] := ( cAliasA )->&( self:aStruct[nX][5] )
				Endif
			Endif
		Next

		// Inclui os dados no objeto paea retorno ao SmartView
		self:oData:appendData( self:jItems )

		( cAliasA )->( DbSkip( ) )

	End
	( cAliasA )->( DbCloseArea( ) )

	oExecA:Destroy( )
	oExecA := Nil

Return( self:oData )

//-------------------------------------------------------------------
/*{Protheus.doc} getSchema
@description Retorna la estructura de los campos
@return object: self:oSchema
@author Marcelo Hruschka
@since 24/05/2024
@version 1.0
*/
//------------------------------------------------------------------- 
Method getSchema() as object class LayoutIssuedDocumentsTReportsBusinessObject

	Local nX as numeric

	// Adiciona as propriedades dos campos que serão retornados para o SMARTView
	For nX := 1 To Len( self:aStruct )
		self:addProperty( self:aStruct[nX][1], self:aStruct[nX][2], self:aStruct[nX][3], self:aStruct[nX][4], self:aStruct[nX][5] )
	Next

Return( self:oSchema )

//-------------------------------------------------------------------
/*{Protheus.doc} MTR475CadO
@description Retorna cadeia de certificado
@return object: NIL
@author Marcelo Hruschka
@since 21/12/2025
@version 1.0
*/
//------------------------------------------------------------------- 
Static Function MTR475CadO(cCadOrig, oXML)

	Local cFechaTim		:= ""
	Local cUUIDTim		:= ""
	Local cCerTim		:= ""
	Local cSelloCFDI	:= ""

	Default cCadOrig	:= ""
	Default oXml		:= Nil

	If XMLChildEx( oXML:_CFDI_COMPROBANTE, "_CFDI_COMPLEMENTO" ) <> Nil
		If XMLChildEx(oXml:_CFDI_COMPROBANTE:_CFDI_COMPLEMENTO, "_TFD_TIMBREFISCALDIGITAL") <> Nil
			cFechaTim 	:= oXML:_CFDI_COMPROBANTE:_CFDI_COMPLEMENTO:_TFD_TIMBREFISCALDIGITAL:_FECHATIMBRADO:TEXT
			cUUIDTim 	:= oXML:_CFDI_COMPROBANTE:_CFDI_COMPLEMENTO:_TFD_TIMBREFISCALDIGITAL:_UUID:TEXT
			cCerTim 	:= oXML:_CFDI_COMPROBANTE:_CFDI_COMPLEMENTO:_TFD_TIMBREFISCALDIGITAL:_NOCERTIFICADOSAT:TEXT
		EndIf
		cSelloCFDI	:= oXML:_CFDI_COMPROBANTE:_SELLO:TEXT

		cCadOrig := "||"
		cCadOrig += "1.0|" 				//	Version
		cCadOrig += cUUIDTim + "|"		// 	UUID
		cCadOrig += cFechaTim + "|"     // 	Fecha y hora de certificación
		cCadOrig += cSelloCFDI + "|"	// 	Sello digital del CFDI
		cCadOrig += cCerTim + "||"		//	Número de certificado
	EndIf

Return Nil

//-------------------------------------------------------------------
/*{Protheus.doc} MTR475CarE
@description ratamiento de caracteres especiales en Cadena Original. 
@return object: NIL
@author Marcelo Hruschka
@since 21/12/2025
@version 1.0
*/
//------------------------------------------------------------------- 
Static Function MTR475CarE(cCad)

	Local cRet			:= ""
	Local aTags			:= {"&amp;"	, "&quot;"	, "&lt;"	, "&gt;"	, "&#36;"	, "&#38;"	}
	Local aText			:= {"&"		, '"'		, "<"		, ">"		, "'"		, "&"		}
	Local nIteration	:= 0
	
	Default cCad	:= ""
	
	cRet := cCad
	
	For nIteration := 1 To Len(aTags)
		cRet := StrTran(cRet, aTags[nIteration], aText[nIteration])
	Next nIteration
			
	cRet := AllTrim(cRet)

Return cRet
