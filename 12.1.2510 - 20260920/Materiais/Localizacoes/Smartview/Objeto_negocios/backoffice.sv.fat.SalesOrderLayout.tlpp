#INCLUDE 'msobject.ch'
#INCLUDE 'totvs.framework.treports.integratedprovider.th'
#INCLUDE 'backoffice.sv.fat.SalesOrderLayout.ch'

namespace custom.faturamento.salesorderlayout.integratedprovider

//-------------------------------------------------------------------------------
/*{Protheus.doc} backoffice.sv.fat.salesorderlayout
@description Classe para creación del Objeto de Negocio TReports
@author Marcelo Hruschka
@since 24/10/2024
@version 1.1
*/
//-------------------------------------------------------------------------------
@totvsFrameworkTReportsIntegratedProvider( active=.T., team='SIGAFAT', tables='SCJ,SCK,SB1,SA1', name='Pedido de venta (formato)', country='ALL', initialRelease='12.1.2410', customTables='SF2,SD2,SB1,SA1' )
class salesorderlayoutTReportsBusinessObject from totvs.framework.treports.integratedprovider.IntegratedProvider

	public Method new() as object
	public Method getData() as object
	public Method getSchema() as object

	protected data aFields as array
	protected data aStruct as array
	protected data jItems as json

endclass

//-------------------------------------------------------------------
/*{Protheus.doc} new
Método de instância da classe 
@Return object: self
@author Marcelo Hruschka
@since 24/05/2024
@version 1.0
*/
//-------------------------------------------------------------------
Method new() class salesorderlayoutTReportsBusinessObject

	Local aCpos := {} as array

	_Super:new()

	//Define o nome do Objeto de Negócio
	self:setDisplayName( STR0001 )	// 'Pedido de venta (formato)'

	//Define a descrição do Objeto de Negócio
	self:setDescription( STR0001 )	// 'Pedido de venta (formato)'

	// Define a Área
	self:appendArea( STR0002 ) // 'Facturación'

	// Define se as perguntas terao lookup
	self:setIsLookUp( .T. )

	// Indica o pergunte que será utilizado no relatório
	If !self:setPergunte( 'FATSV505' )
		IIf(!self:setErrorStatus( 400, STR0003, STR0004 ),FwLogMsg( 'WARN',, 'Smart View',,,, STR0005,,, ),'') // 'Sin Preguntas' // '¡Verifique el grupo de preguntas dado!' // 'Código de error no válido, solo acepte códigos de error 4xx'
		FwLogMsg( 'WARN',, 'Smart View',,,, STR0006,,, ) // 'Grupo de preguntas no encontrado!'
	EndIf

	// campos que no existen en SX3
	aAdd( aCpos, { 'M0_CGC'     , 'M0_CGC'      , 'string'	, 'M0_CGC'      } )
	aAdd( aCpos, { 'M0_NOME'    , 'M0_NOME'     , 'string'	, 'M0_NOME'     } )
	aAdd( aCpos, { 'M0_NOMECOM' , 'M0_NOMECOM'  , 'string'	, 'M0_NOMECOM'  } )
	aAdd( aCpos, { 'M0_ENDCOB'  , 'M0_ENDCOB'   , 'string'	, 'M0_ENDCOB'   } )
	aAdd( aCpos, { 'M0_BAIRCOB' , 'M0_BAIRCOB'  , 'string'	, 'M0_BAIRCOB'  } )
	aAdd( aCpos, { 'M0_CIDCOB'  , 'M0_CIDCOB'   , 'string'	, 'M0_CIDCOB'   } )
	aAdd( aCpos, { 'M0_ESTCOB'  , 'M0_ESTCOB'   , 'string'	, 'M0_ESTCOB'   } )
	aAdd( aCpos, { 'M0_CEPCOB'  , 'M0_CEPCOB'   , 'string'	, 'M0_CEPCOB'   } )
	aAdd( aCpos, { 'M0_TEL'     , 'M0_TEL'      , 'string'	, 'M0_TEL'      } )
	aAdd( aCpos, { 'NOMEENT'    , 'NOMEENT'     , 'string'	, 'NOMEENT'     } )
	aAdd( aCpos, { 'ENTENT'     , 'ENTENT'      , 'string'	, 'ENTENT'      } )
	aAdd( aCpos, { 'BAIENT'     , 'BAIENT'      , 'string'	, 'BAIENT'      } )
	aAdd( aCpos, { 'MUNENT'     , 'MUNENT'      , 'string'	, 'MUNENT'      } )
	aAdd( aCpos, { 'ESTENT'     , 'ESTENT'      , 'string'	, 'ESTENT'      } )
	aAdd( aCpos, { 'CEPENT'     , 'CEPENT'      , 'string'	, 'CEPENT'      } )
	aAdd( aCpos, { 'TELENT'     , 'TELENT'      , 'string'	, 'TELENT'      } )
	aAdd( aCpos, { 'NREND'      , 'NREND'       , 'string'	, 'NREND'       } )
	aAdd( aCpos, { 'NRIEND'     , 'NRIEND'      , 'string'	, 'NRIEND'      } )
	aAdd( aCpos, { 'NRENT'      , 'NRENT'       , 'string'	, 'NRENT'       } )
	aAdd( aCpos, { 'NRIENT'     , 'NRIENT'      , 'string'	, 'NRIENT'      } )
	aAdd( aCpos, { 'EXTENSO'    , 'EXTENSO'     , 'string'	, 'EXTENSO'     } )
	aAdd( aCpos, { 'TOTAL '     , 'TOTAL'       , 'number'	, 'TOTAL'       } )

	// demais campos
	self:aFields := {'M0_NOME','M0_ENDCOB','M0_BAIRCOB','M0_CIDCOB','M0_ESTCOB','M0_CEPCOB','M0_CGC','M0_NOMECOM','M0_TEL','C5_NUM','C5_CLIENTE','C5_LOJACLI','C5_EMISSAO','C5_STATUS','A1_NOME','A1_END','A1_BAIRRO','A1_MUN','A1_ESTADO','A1_CEP','A1_TEL','A1_CGC','NOMEENT','ENTENT','BAIENT','MUNENT','ESTENT','CEPENT','TELENT','C6_PRODUTO','C6_ITEM','C6_QTDVEN','C6_PRCVEN','C6_VALOR','C6_ENTREG','C6_UM','C5_CONDPAG','E4_DESCRI','B1_DESC','C5_CLIENT','C5_LOJAENT','NREND','NRIEND','NRENT','NRIENT','YA_DESCR','EXTENSO','C6_DESCONT','C5_SEGURO','C5_FRETE','C5_DESPESA','TOTAL','CJ_NUM'}

	self:aStruct := getStrutObj( self:aFields, aCpos )

Return( self )

//-------------------------------------------------------------------
/*{Protheus.doc} getData
Retorna los datos del objeto de negócio
@param nPage, numérico, indica la pagina actual del relatório
@param oFilter, objeto, contiene el filtro del TReports
@return object: self:oData
@author Marcelo Hruschka
@since 24/05/2024
@version 1.0
*/
//------------------------------------------------------------------- 
Method getData( nPage as numeric, oFilter as object) as object class salesorderlayoutTReportsBusinessObject

	// Declaracao de variaveis
	Local cQuery		as character
	Local cFiltro 		as character
	Local cExp 			as character

	Local nX			as numeric
	Local n1			as numeric
	Local nPosMon		as numeric
	Local nPosExp		as numeric
	Local nDecs 		as numeric

	Local jParams 		as json

	Local aPDFields		as array
	Local aFiltro		as array
	Local aCustomFields as array

	Local lObfuscated	as logical

	Local oExecA		as object
	Local cAliasA       as character
	Local nSeq          as numeric
	Local nPNrEnd       as numeric
	Local nPNrIEnd      as numeric

	nPNrEnd  := SA1->(ColumnPos("A1_NR_END"))
	nPNrIEnd := SA1->(ColumnPos("A1_NROINT"))

	cFiltro 			:= ''
	cExp 				:= ''
	cAliasA			    := ''

	nPosMon   		:= 0
	nPosExp 		:= 0
	nDecs 			:= 0
	nX 				:= 0
	n1				:= 0

	aPDFields		:= { }
	aFiltro			:= { }
	aCustomFields	:= { }

	// Verifica se existem campos sensiveis na lista de campos a serem retornados
	aPDFields := FwProtectedDataUtil():UsrAccessPDField( __cUserID, self:aFields )
	lObfuscated := Len( aPDFields ) != Len( self:aFields )

	// Coleta os dados dos parametros
	jParams := oFilter:getParameters( )

	// Coleta os campos personalizados pelo usuário
	aCustomFields := self:getCustomFields( )
	cCpoSC5 := getCpoUser( aCustomFields, 'SC5', 'C5', ',' )
	cCpoSC6 := getCpoUser( aCustomFields, 'SC6', 'C6', ',' )
	cCpoSA1 := getCpoUser( aCustomFields, 'SA1', 'A1', ',' )
	cCpoSB1 := getCpoUser( aCustomFields, 'SB1', 'B1', ',' )

	// Adiciona campo customizado na estrutura de campos
	For n1 := 1 To Len( aCustomFields )
		aAdd( self:aStruct, { aCustomFields[n1, 1], aCustomFields[n1, 4], aCustomFields[n1, 3], aCustomFields[n1, 2], aCustomFields[n1, 1] } )
		aAdd( self:aFields, aCustomFields[n1, 1] )
	Next

	If oFilter:hasFilter( )
		// Tratamento para conversão para moeda selecionada
		cFiltro := oFilter:getSQLExpression( )
		aFiltro := getParamToArr( cFiltro )
		// Ordena os parametros
		aSort( aFiltro,,, { |x, y| x[1] + x[3] < y[1] + y[3] } )
	EndIf

	// Realiza a montagem da QUERY que será enviada para o banco de dados
	cQuery := "SELECT"
	cQuery += " SM0.M0_NOME, SM0.M0_ENDCOB, SM0.M0_BAIRCOB, SM0.M0_CIDCOB, SM0.M0_ESTCOB, SM0.M0_CEPCOB, SM0.M0_CGC, SM0.M0_NOMECOM, SM0.M0_TEL,"
	cQuery += " SC5.C5_NUM, SC5.C5_CLIENTE, SC5.C5_LOJACLI, SC5.C5_EMISSAO, SC5.C5_STATUS, SC5.C5_NUM AS CJ_NUM, "
	cQuery += " SA1.A1_NOME, SA1.A1_END, SA1.A1_BAIRRO, SA1.A1_MUN, SA1.A1_ESTADO, SA1.A1_CEP, SA1.A1_TEL, SA1.A1_CGC,"
	cQuery += " ENT.A1_NOME NOMEENT, ENT.A1_END ENTENT, ENT.A1_BAIRRO BAIENT, ENT.A1_MUN MUNENT, ENT.A1_ESTADO ESTENT, ENT.A1_CEP CEPENT, ENT.A1_TEL TELENT,"
	cQuery += " SC6.C6_PRODUTO, SC6.C6_ITEM, SC6.C6_QTDVEN, SC6.C6_PRCVEN, SC6.C6_VALOR, SC6.C6_VALDESC C6_DESCONT, SC6.C6_ENTREG, SC6.C6_UM,"
	cQuery += "  SC5.C5_CONDPAG, SE4.E4_DESCRI, '' EXTENSO,  YA_DESCR, C5_CLIENT, C5_LOJAENT,"
	cQuery += " SB1.B1_DESC, SC5.C5_SEGURO, SC5.C5_FRETE, SC5.C5_DESPESA, "
	If nPNrEnd > 0
		cQuery += " SA1.A1_NR_END NREND,"
		cQuery += " ENT.A1_NR_END NRENT,"
	else
	    cQuery += " '' NREND,"
		cQuery += " '' NRENT,"
	Endif
	If nPNrIEnd > 0 
		cQuery += " SA1.A1_NROINT NRIEND,"
		cQuery += " ENT.A1_NROINT NRIENT,"
	else
	    cQuery += " '' NRIEND,"
		cQuery += " '' NRIENT,"
	Endif	
	cQuery += " ? "
	cQuery += " ? "
	cQuery += " ? "
	cQuery += " ? "	
	cQuery += " ( SELECT SUM(C6_VALOR-C6_VALDESC)+C5_DESPESA+C5_FRETE+C5_SEGURO FROM " + RetSqlName("SC6") + " B WHERE B.C6_FILIAL = SC6.C6_FILIAL AND B.C6_NUM = SC6.C6_NUM AND B.D_E_L_E_T_ = ? ) AS TOTAL"
	cQuery += " FROM " + RetSqlName("SC5") + " SC5"
	cQuery += " LEFT JOIN SYS_COMPANY SM0 ON SM0.M0_CODIGO = ? AND SM0.M0_CODFIL = ? AND SM0.D_E_L_E_T_ =  ?"
	cQuery += " LEFT JOIN " + RetSqlName("SA1") + " SA1 ON SA1.A1_FILIAL = ? AND SA1.A1_COD = SC5.C5_CLIENTE AND SA1.A1_LOJA = SC5.C5_LOJACLI AND SA1.D_E_L_E_T_ = ?"
	cQuery += " LEFT JOIN " + RetSqlName("SA1") + " ENT ON ENT.A1_FILIAL = ? AND ENT.A1_COD = SC5.C5_CLIENT AND ENT.A1_LOJA = SC5.C5_LOJAENT AND ENT.D_E_L_E_T_ = ?"
	cQuery += " LEFT JOIN " + RetSqlName("SC6") + " SC6 ON SC6.C6_FILIAL = ? AND SC6.C6_NUM = SC5.C5_NUM AND SC6.D_E_L_E_T_ = ?"
	cQuery += " LEFT JOIN " + RetSqlName("SB1") + " SB1 ON SB1.B1_FILIAL = ? AND SB1.B1_COD = SC6.C6_PRODUTO AND SB1.D_E_L_E_T_ = ?"
	cQuery += " LEFT JOIN " + RetSqlName("SE4") + " SE4 ON SE4.E4_FILIAL = ? AND SE4.E4_CODIGO = SC5.C5_CONDPAG AND SE4.D_E_L_E_T_ = ?"
	cQuery += " LEFT JOIN " + RetSqlName("SYA") + " SYA ON SYA.YA_FILIAL = ? AND SYA.YA_CODGI = SA1.A1_PAIS AND SYA.D_E_L_E_T_ = ?"
	cQuery += " WHERE SC5.C5_NUM BETWEEN ? AND ?"
	cQuery += "   AND SC5.C5_CLIENTE BETWEEN ? AND ?"
	cQuery += "   AND SC5.C5_LOJACLI BETWEEN ? AND ?"
	cQuery += "   AND SC5.C5_EMISSAO BETWEEN ? AND ?"
	cQuery += "   AND SC5.D_E_L_E_T_ = ?"

	// Agrega os filtros na QUERY
	For nX := 1 To Len( aFiltro )
		cQuery += " AND ? " + ' ' + " ? ? "
	Next
	cQuery += " ORDER BY C5_NUM, C6_ITEM"	

	cQuery := ChangeQuery(cQuery)
	oExecA := FwExecStatement():New( cQuery )

	nSeq := 0
	oExecA:SetUnSafe( nSeq += 1, cCpoSC5 )
    oExecA:SetUnSafe( nSeq += 1, cCpoSC6 )
    oExecA:SetUnSafe( nSeq += 1, cCpoSA1 )
    oExecA:SetUnSafe( nSeq += 1, cCpoSB1 )	
    oExecA:SetString( nSeq += 1, ' ' )
	oExecA:SetString( nSeq += 1, cEmpAnt )
	oExecA:SetString( nSeq += 1, cFilAnt )
	oExecA:SetString( nSeq += 1, ' ' )
	oExecA:SetString( nSeq += 1, xFilial("SA1") )
	oExecA:SetString( nSeq += 1, ' ' )
	oExecA:SetString( nSeq += 1, xFilial("SA1") )
	oExecA:SetString( nSeq += 1, ' ' )
	oExecA:SetString( nSeq += 1, xFilial("SCK") )
	oExecA:SetString( nSeq += 1, ' ' )
	oExecA:SetString( nSeq += 1, xFilial("SB1") )
	oExecA:SetString( nSeq += 1, ' ' )
	oExecA:SetString( nSeq += 1, xFilial("SE4") )
	oExecA:SetString( nSeq += 1, ' ' )
	oExecA:SetString( nSeq += 1, xFilial("SYA") )
	oExecA:SetString( nSeq += 1, ' ' )
	oExecA:SetString( nSeq += 1, jParams['MV_PAR01'][1] )
	oExecA:SetString( nSeq += 1, jParams['MV_PAR02'][1] )
	oExecA:SetString( nSeq += 1, jParams['MV_PAR03'][1] )
	oExecA:SetString( nSeq += 1, jParams['MV_PAR04'][1] )
	oExecA:SetString( nSeq += 1, jParams['MV_PAR05'][1] )
	oExecA:SetString( nSeq += 1, jParams['MV_PAR06'][1] )
	oExecA:SetString( nSeq += 1, DtoS( FwDateTimeToLocal( jParams['MV_PAR07'][1] )[1] ) )
	oExecA:SetString( nSeq += 1, DtoS( FwDateTimeToLocal( jParams['MV_PAR08'][1] )[1] ) )
	oExecA:SetString( nSeq += 1, ' ' )
	For nX := 1 To Len( aFiltro )
		oExecA:SetUnSafe ( nSeq += 1, aFiltro[nX, 1] )
		oExecA:SetUnSafe ( nSeq += 1, aFiltro[nX, 2] )
		oExecA:SetUnSafe ( nSeq += 1, aFiltro[nX, 3] )
	Next
	// Executa a QUERY e cria uma tabela temporaria com os dados retornados
	cAliasA := oExecA:OpenAlias( )

	// Alimenta o objeto de dados da classe para retornar ao SmartView
	While !( cAliasA )->( EOF( ) )

		self:jItems := JsonObject():new( )
		For nX := 1 To Len( self:aStruct )
			If lObfuscated .And. ( aScan( aPDFields, self:aStruct[nX][5] ) == 0 )
				self:jItems[self:aStruct[nX][1]] := FwProtectedDataUtil():ValueAsteriskToAnonymize( ( cAliasA )->&( self:aStruct[nX][5] ) )
			ElseIf ( self:aStruct[nX][5] == "EXTENSO" )
				self:jItems[self:aStruct[nX][1]] := Extenso(( cAliasA )->TOTAL)
			ElseIf ( self:aStruct[nX][3] == 'date' )
				self:jItems[self:aStruct[nX][1]] := totvs.framework.treports.date.dateToTimeStamp( StoD( ( cAliasA )->&( self:aStruct[nX][5] ) ) )
			Else
				self:jItems[self:aStruct[nX][1]] := ( cAliasA )->&( self:aStruct[nX][5] )
			Endif
		Next

		// Inclui os dados no objeto paea retorno ao SmartView
		self:oData:appendData( self:jItems )

		( cAliasA )->( DbSkip( ) )

	End
	( cAliasA )->( DbCloseArea( ) )

	oExecA:Destroy( )
	oExecA := Nil

Return( self:oData )

//-------------------------------------------------------------------
/*{Protheus.doc} getSchema
@description Retorna la estructura de los campos
@return object: self:oSchema
@author Marcelo Hruschka
@since 24/05/2024
@version 1.0
*/
//------------------------------------------------------------------- 
Method getSchema() as object class salesorderlayoutTReportsBusinessObject

	Local nX as numeric

	// Adiciona as propriedades dos campos que serão retornados para o SMARTView
	For nX := 1 To Len( self:aStruct )
		self:addProperty( self:aStruct[nX][1], self:aStruct[nX][2], self:aStruct[nX][3], self:aStruct[nX][4], self:aStruct[nX][5] )
	Next

Return( self:oSchema )


