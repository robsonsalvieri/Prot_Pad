#Include 'tlpp-core.th'
#Include 'tlpp-rest.th'
#Include 'pc.invoices.mi.controller.ch'

Namespace portal.cliente.invoicesMI
Using Namespace gfin.util

/*/{Protheus.doc} getInvoiceNfeMI
	Retorna el PDF y XML de Documentos Fiscales de Mercado Internacional
	@type  Function
	@author raul.medina
	@since 04/2026
	@version 1.0
/*/
@get('/api/pc/v1/invoices/nfemi')
Function getInvoiceNfeMI()
	Local jQueryParams	:= oRest:getQueryRequest()		        as Json
	Local oService		:= InvoicesServiceMI():getInstance()	as Object
	Local jResponse		:= JsonObject():new()					as Json
	Local cSerie		:= ""									as Character
	Local cNumber		:= ""									as Character
	Local cCliente		:= ""									as Character
	Local cLoja			:= ""									as Character
	Local cEspecie		:= ""									as Character
	Local cTipoDoc		:= ""									as Character
	Local cBranch		:= ""									as Character

	if !totvs.framework.api.treports.wellKnow():isAuthOff()
		If jQueryParams:hasProperty("branch")
			cBranch   := jQueryParams["branch"]
		Endif
		If jQueryParams:hasProperty("serie")
			cSerie   := jQueryParams["serie"]
		Endif
		If jQueryParams:hasProperty("number") 
			cNumber  := jQueryParams["number"]
		Endif
		If jQueryParams:hasProperty("cliente")
			cCliente := jQueryParams["cliente"]
		Endif
		If jQueryParams:hasProperty("loja")
			cLoja    := jQueryParams["loja"]
		Endif
		DbSelectArea("SF2")
		SF2->(DbSetOrder(1))  //F2_FILIAL+F2_DOC+F2_SERIE+F2_CLIENTE+F2_LOJA+F2_FORMUL+F2_TIPO 

		If SF2->(MsSeek(cBranch + cNumber + cSerie + cCliente + cLoja))
			cEspecie := SF2->F2_ESPECIE
			cTipoDoc := SF2->F2_TIPODOC
		EndIf
		
		jResponse := oService:getXMLPDFMI(cSerie, cNumber, cCliente, cLoja, cEspecie, cTipoDoc)
		oRest:setResponse(jResponse)

		FwFreeObj(oService)
	EndIf	
Return
