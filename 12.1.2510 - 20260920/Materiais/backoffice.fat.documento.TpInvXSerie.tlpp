#include "protheus.ch"
#include "fwmvcdef.ch"
#include "BACKOFFICE.FAT.DOCUMENTO.TPINVXSERIE.CH"

Static __lNewInvo	:= Nil
Static __RpoRelease := GetRPORelease()
Static _cRetFat  	:= ""

//-----------------------------------------------------------------------------------------------------
//- esse parâmetro não deve ser documentado, pois 
//- é para a situação de uso em projetos pilotos
//-----------------------------------------------------------------------------------------------------
Static lNumInvo := SuperGetMV('MV_NUMINVO',.F.,.F.)

Namespace backoffice.fat.documento	

//------------------------------------------------------------------------------
//-  TpInvXSerie()
//- 	Função de cadastro de Espécies x Séries  
//- 	@type 		Function
//- 	@author		William Pianheri
//- 	@since 		20/12/2024
//------------------------------------------------------------------------------
Function TpInvXSerie()

Local oBrowse as object

oBrowse := FWLoadBrw("backoffice.fat.documento.TpInvXSerie")

ExistReg()

oBrowse:Activate()
oBrowse:DeActivate()
oBrowse:Destroy()
FreeObj(oBrowse)
oBrowse := nil

Return nil

//------------------------------------------------------------------------------
//-  BrowseDef()
//- 	Retorna o browse da rotina 
//- 	@type 		Function
//- 	@author		William Pianheri
//- 	@since 		20/12/2024
//-		@return		oBrowse Objeto do tipo FWMBrowse
//------------------------------------------------------------------------------
Function BrowseDef() as object
Local oBrowse as object

oBrowse := FWMBrowse():New()
oBrowse:SetAlias("AZZ")
oBrowse:SetDescription(STR0001) //Manutenção de Tipos de Documentos e Séries

Return oBrowse

//------------------------------------------------------------------------------
//-  ModelDef()
//- 	Retorna o modelo de dados para o cadastro de séreis, alias AZZ
//- 	@type 		Function
//- 	@author		William Pianheri
//- 	@since 		20/12/2024
//-		@return		oModel Objeto do tipo FwFormModel
//------------------------------------------------------------------------------
Function ModelDef() as object

Local oModel as object
Local oStruct as object

oModel := MPFormModel():New( "MODEL_AZZ", /*bPre*/ , {|oModel| TypeInvTOk(oModel)}, /*bCommit*/, /*bCancel*/ )
oStruct := FwFormStruct( 1, "AZZ", /*bFiltro*/ )
oModel:AddFields( "FIELDS_AZZ", /*Owner*/ , oStruct, /*bPre*/ , /*bPos*/ , /*bLoad*/ )
oModel:SetPrimaryKey( { 'AZZ_ESPECI','AZZ_SERIE'} )

Return oModel

//------------------------------------------------------------------------------
//-  ViewDef()
//- 	Retorna a view para o cadastro de séries, alias AZZ
//- 	@type 		Function
//- 	@author		William Pianheri
//- 	@since 		20/12/2024
//-		@return		oView Objeto do tipo FwFormView
//------------------------------------------------------------------------------
Function ViewDef() as object
local oView as object
local oStruct as object
local oModel as object

oView := FwFormView():New()
oModel := FwLoadModel("backoffice.fat.documento.TpInvXSerie")
oStruct := FwFormStruct( 2, "AZZ", /*bFiltro*/ )

oView:SetModel(oModel)
oView:AddField( "VIEW_AZZ", oStruct, "FIELDS_AZZ" )

return oView

//------------------------------------------------------------------------------
//-  MenuDef()
//- 	Retorna o array com a opções presentes na rotina
//- 	@type 		Function
//- 	@author		William Pianheri
//- 	@since 		20/12/2024
//-		@return		aRotina Array contendo as opções da rotina
//------------------------------------------------------------------------------
Function MenuDef() as array

Local aRotina := {} as array

ADD OPTION aRotina TITLE STR0002 	ACTION "PesqBrw" 							                    OPERATION 1							ACCESS 0 //"Pesquisar"
ADD OPTION aRotina TITLE STR0003 	ACTION "VIEWDEF.backoffice.fat.documento.TypeInvoice"	OPERATION MODEL_OPERATION_VIEW		ACCESS 0 //'Visualizar'
ADD OPTION aRotina TITLE STR0004 	ACTION "VIEWDEF.backoffice.fat.documento.TypeInvoice"	OPERATION MODEL_OPERATION_INSERT	ACCESS 0 //'Incluir'
ADD OPTION aRotina TITLE STR0005 	ACTION "VIEWDEF.backoffice.fat.documento.TypeInvoice"	OPERATION MODEL_OPERATION_UPDATE	ACCESS 0 //'Alterar'
ADD OPTION aRotina TITLE STR0006 	ACTION "VIEWDEF.backoffice.fat.documento.TypeInvoice"	OPERATION MODEL_OPERATION_DELETE	ACCESS 0 //'Excluir'

Return aRotina

//------------------------------------------------------------------------------
//-  TypeInvTOk()
//- 	Validação TUDOOK na gravação do registro
//- 	@type 		Function
//- 	@author		William Pianheri
//- 	@since 		20/12/2024
//-		@oMdlAZZ	Modelo a tabela AZZ
//-		@return		lRet Lógico indicando a validade da gravação
//------------------------------------------------------------------------------
Static Function TypeInvTOk(oMdlAZZ as Object) as logical

Local lRet As Logical

Default oMdlAZZ := Nil

lRet	:= .T.
If INCLUI .Or. ALTERA
    DbSelectArea("AZZ")
    AZZ->(DbSetOrder(3)) //AZZ_FILIAL+AZZ_DEFAUL+AZZ_SERIE+AZZ_PDV
    If (AZZ->(DbSeek(FwXFilial("AZZ")+'1'+FwFldGet("AZZ_SERIE"))) .Or. AZZ->(DbSeek(FwXFilial("AZZ")+'2'+FwFldGet("AZZ_SERIE"))));
        .And. oMdlAZZ:AALLSUBMODELS[1]:NDATAID <> AZZ->(RecNo()) //Se for o mesmo RECNO, se trata de uma alteração e não precisa validar
        Help(" ",1,STR0007,,STR0008,1,0) // Não é possível cadastrar a uma série já existente.
        lRet := .F. 
    EndIf
EndIf

If lRet .And. FwFldGet("AZZ_DOCFIS") == "1" .And. !backoffice.fat.documento.TypeInvVal(FwFldGet("AZZ_ESPECI"))
    Help("DOCFIS",1,STR0014,,STR0015,1,0,,,,,,{STR0016}) // Documento Fiscal -O documento foi selecionado como Fiscal- Escolha uma espécie valida
    lRet := .F.
EndIf

Return lRet

//------------------------------------------------------------------------------
//-  TypeInvVal()
//- 	Valid do campo AZZ_ESPECI
//- 	@type 		Function
//- 	@author		William Pianheri
//- 	@since 		20/12/2024
//-		@cType		Caracter indicando a espécie selecionada
//-		@return		lRet Lógico indicando se a espécie existe na RetTypeDoc()
//------------------------------------------------------------------------------
Function TypeInvVal(cType as character) as logical

Local lRet      As Logical
Local cEspecies As Character

Default cType := ""

lRet        := .F.
cEspecies   := backoffice.fiscal.escrita.documentos.RetTypeDoc(,4)

If Alltrim(cType) $ cEspecies
    lRet := .T.
EndIf

Return lRet
                                                        
//------------------------------------------------------------------------------
//-  UsaNewInvoice()
//- 	Função validadora do ambiente para o uso do novo 
//-		controle de numeração de notas
//- 	@type 		Function
//- 	@author		William Pianheri
//- 	@since 		20/12/2024
//-		@return		__lNewInvo Variável logica e estatica indicando 
//-					se o ambiente esta devidamente configurado
//------------------------------------------------------------------------------
Function UsaNewInvoice() as logical

If __lNewInvo == Nil
	
	If __RpoRelease >= '12.1.2510' .And. lNumInvo
	
		If !(AliasIndic('AZZ') .And. ; //- Verifica a existência das tabelas, campos e fontes necessarios
			SD9->(ColumnPos('D9_KEYNF')) > 0 .And. ;
			SD9->(ColumnPos('D9_STATUS')) > 0 .And. ;
			SD9->(ColumnPos('D9_MODELO')) > 0) .And. ;
			!tlpp.ffunc("backoffice.fiscal.escrita.documentos.RetTypeDoc") .And. ;
			!tlpp.ffunc("protheus.backoffice.fiscal.NewSerieNFd") .And. ;
			!tlpp.ffunc("backoffice.fat.documento.NumberInvoice")
			
			UserException(STR0009 + " " + STR0010) //"O uso do novo controle de numeração para documentos não está devidamente aplicado. Verifique se esta totalmente atualizado conforme documentação."
		
		EndIf
	
		__lNewInvo := .T.

	Else
	
		__lNewInvo := .F.
	
	EndIf
EndIf

Return(__lNewInvo)

//-------------------------------------------------------------------
/*/{Protheus.doc} ExistReg

    Verifica se deve realizar a carga da tabela AZZ com base no parâmetro
	MV_ESPECIE ou tabela genérica SN caso a tabela AZZ esteja vazia.

	@author     CRM/Faturamento
	@since      Março/2026
	@version    12.1.2510
	@return 	.T., Logical, O retorno da função sempre é verdadeiro.
/*/
//-------------------------------------------------------------------
Static Function ExistReg() As Logical
	Local aResult		As Array
	Local cEspecies		As Character
	Local cEspecPad		As Character
	Local cFilAZZ		As Character
	Local cSerie		As Character
	Local cTiposDoc		As Character
	Local lEspNfX5 		As Logical
	Local nPos			As Numeric
	Local nTamEspeci	As Numeric
	Local nX			As Numeric

	aResult := {}
	cEspecies := ""
	cEspecPad := backoffice.fiscal.escrita.documentos.RetTypeDoc(,4)
	cFilAZZ := FWxFilial("AZZ")
	cMsg := STR0012 //- Deseja realizar a carga de Série x Espécie a partir do parâmetro MV_ESPECIE?
	cSerie := ""
	cTiposDoc := ""
	lEspNfX5 := .F.
	nPos := 0
	nTamEspeci := 0
	nX := 0

	DbSelectArea("AZZ")
	AZZ->(DbGoTop())
	If AZZ->(EOF())
		lEspNfX5 := SuperGetMV("MV_ESPNFX5",.F.,.F.)
		If lEspNfX5
			cMsg := STR0013 //- "Deseja realizar a carga de Série x Espécie a partir do parâmetro MV_ESPECIE e da tabela genérica SN (Cadastro de Série/Espécie da NF de Saída)?"?
		EndIf

		If !IsBlind() .And. FWAlertYesNo(cMsg, STR0011) //- Carga Inicial de Série x Espécie
		
			//Verifica as espécies e séries do parâmetro MV_ESPECIE ou da
			//tabela SN da SX5 a partir da configuração do parâmetro MV_ESPNFX5 = .T.
			cTiposDoc := MaSerEspNF()

			aResult := StrTokArr(cTiposDoc, ";")
			nTamEspeci := TAMSX3("AZZ_ESPECI")[1]

			For nX:=1 to Len(aResult)
				nPos := At("=", aResult[nX])
				cSerie := Alltrim(Substr(aResult[nX], 1, nPos-1))
				cEspecies := Substr(aResult[nX], nPos+1, nTamEspeci)

				If cEspecies+"=" $ cEspecPad .And. !(AZZ->(MsSeek(cFilAZZ+PadR(cEspecies,nTamEspeci)+cSerie))) //Verifica se é a espécie é valida e se o cadastro já existe na AZZ
					RecLock("AZZ",.T.)
					AZZ->AZZ_FILIAL	:= cFilAZZ
					AZZ->AZZ_ESPECI	:= cEspecies
					AZZ->AZZ_SERIE	:= cSerie
					AZZ->AZZ_DEFAUL := "1"
					AZZ->(MsUnlock())
				EndIf
			Next
		EndIf
	EndIf

Return .T.

/*/{Protheus.doc} ReEspFat
    Consulta padrão FATESP que retorna a espécie conforme a consulta da 
	funcão backoffice.fiscal.escrita.documentos.RetTypeDoc(,4) do fiscal. 
    Transforma o combo box em consulta padrão.
    @type       function
    @author     CRM/Faturamento
    @since      22/06/2026
    @return     lContinua, Logical 
/*/
Function ReEspFat() as logical

    Local aEspecies     as array
    Local aPares        as array
    Local aColumns      as array
    Local cEspList      as character
    Local cPar          as character
    Local cCod          as character
    Local cDesc         as character
    Local nX            as numeric
    Local nPos          as numeric
    Local oDlg          as object
    Local oFwBrowse     as object
    Local lContinua     as logical

    aEspecies   := {} 
    aPares      := {}
    aColumns    := {}
    cEspList    := "" 
    cPar        := "" 
    cCod        := "" 
    cDesc       := "" 
    _cRetFat    := "" 
    nX          := 0
    nPos        := 0
    oDlg        := Nil
    oFwBrowse   := Nil
    lContinua   := .F.
          
    // Retorno bruto fiscal das informações como combobox
    cEspList  := backoffice.fiscal.escrita.documentos.RetTypeDoc(,4)

    // Separa as entradas pelo delimitador ";"
    aPares := StrTokArr(cEspList, ";")

    // Para cada entrada separa código e descrição na primeira ocorrencia de "="
    For nX := 1 To Len(aPares)

        cPar := Alltrim(aPares[nX])

        If !Empty(cPar)

            nPos := At("=", cPar)   // localiza apenas o primeiro "="

            If nPos > 0
                cCod  := Alltrim(SubStr(cPar, 1, nPos - 1))    // ex: "ACT"
                cDesc := Alltrim(SubStr(cPar, nPos + 1))        // ex: "Autorizacao de Carregamento e Transporte"

                If !Empty(cCod)
                    aAdd(aEspecies, {cCod, cDesc})                // array bidimensional
                EndIf
            EndIf

        EndIf
    Next 
 
    DEFINE MSDIALOG oDlg TITLE STR0017 FROM 0,0 TO 400,400 PIXEL //"Tipos Documentos Fiscais"
    oFwBrowse := FWFormBrowse():New(oDlg)
    oFwBrowse:SetDataArray()  //Define utilização de array
    oFwBrowse:SetArray(aEspecies)    //Indica o array utilizado para apresentação dos dados no Browse.
    aColumns := RetColumns( aEspecies )
    //Cria as colunas do array
    For nX := 1 To Len(aColumns )
        oFwBrowse:AddColumn( aColumns[nX] )
    Next
    oFwBrowse:SetOwner(oDlg)
    oFwBrowse:SetDescription(STR0017) // "Tipos Documentos Fiscais"
    oFwBrowse:SetDoubleClick({|| _cRetFat := If(oFwBrowse:At() > 0, Alltrim(aEspecies[oFwBrowse:At()][1]), ""), oDlg:End()})
    oFwBrowse:AddButton( OemTOAnsi(STR0018)	, {|| _cRetFat := If(oFwBrowse:At() > 0, Alltrim(aEspecies[oFwBrowse:At()][1]), ""), oDlg:End() } ,, 2 ) //"Confirmar"
    oFwBrowse:AddButton( OemTOAnsi(STR0019), {|| _cRetFat := "", oDlg:End() } ,, 2 ) //"Cancelar"
    oFwBrowse:DisableDetails()
    oFwBrowse:Activate()
    
    ACTIVATE MSDIALOG oDlg CENTERED
  
    If !Empty(_cRetFat)
        lContinua:=.T.
    EndIf

Return lContinua

/*/{Protheus.doc} 
    Retorna a construção das colunas que a consulta exibirá
    @type       function
    @author     CRM/Faturamento
    @since      22/06/2026
    @param      aItems, Array, Array bidimensional com código e descrição das espécies
    @return     aColumns, Array 
/*/
Static Function RetColumns(aItems) as array
    Local aColumns  := {}
    Default aItems  := {}
 
    aAdd(aColumns, {;
                        STR0020,;                        // [n][01] Título da coluna - "Espécie" 
                        {|oBrw| aItems[oBrw:At(), 1] },; // [n][02] Code-Block de carga dos dados
                        "C",;                            // [n][03] Tipo de dados
                        "@!",;                           // [n][04] Máscara
                        0,;                              // [n][05] Alinhamento (0=Centralizado, 1=Esquerda ou 2=Direita)
                        5,;                              // [n][06] Tamanho
                        0,;                              // [n][07] Decimal
                        .F.,;                            // [n][08] Indica se permite a edição
                        {|| },;                          // [n][09] Code-Block de vadlição da coluna após a edição
                        .F.,;                            // [n][10] Indica se exibe imagem
                        Nil,;                            // [n][11] Code-Block de execução do duplo clique
                        __ReadVar,;                      // [n][12] Variável a ser utilizada na edição (ReadVar)
                        {|| AlwaysTrue()},;              // [n][13] Code-Block de execução do clique no header
                        .F.,;                            // [n][14] Indica se a coluna está deletada
                        .F.,;                            // [n][15] Indica se a coluna será exibida nos detalhes do Browse
                        {},;                             // [n][16] Opções de carga dos dados (Ex: 1=Sim, 2=Não)
                        "ID1"})                          // [n][17] Id da coluna
 
    aAdd(aColumns, {;
                        STR0021,;                        // [n][01] Título da coluna - "Descrição"
                        {|oBrw| aItems[oBrw:At(), 2] },; // [n][02] Code-Block de carga dos dados
                        "C",;                            // [n][03] Tipo de dados
                        "@!",;                           // [n][04] Máscara
                        0,;                              // [n][05] Alinhamento (0=Centralizado, 1=Esquerda ou 2=Direita)
                        50,;                             // [n][06] Tamanho
                        0,;                              // [n][07] Decimal
                        .F.,;                            // [n][08] Indica se permite a edição
                        {|| },;                          // [n][09] Code-Block de vadlição da coluna após a edição
                        .F.,;                            // [n][10] Indica se exibe imagem
                        Nil,;                            // [n][11] Code-Block de execução do duplo clique
                        __ReadVar,;                      // [n][12] Variável a ser utilizada na edição (ReadVar)
                        {|| AlwaysTrue()},;              // [n][13] Code-Block de execução do clique no header
                        .F.,;                            // [n][14] Indica se a coluna está deletada
                        .F.,;                            // [n][15] Indica se a coluna será exibida nos detalhes do Browse
                        {},;                             // [n][16] Opções de carga dos dados (Ex: 1=Sim, 2=Não)
                        "ID2"})                          // [n][17] Id da coluna
 
Return aColumns
 
