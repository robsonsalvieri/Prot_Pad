#INCLUDE "PROTHEUS.CH"
#INCLUDE "FWLIBVERSION.CH"

//-------------------------------------------------------------------------------
/*/{Protheus.doc} FatCfgTrib()
Consulta se o cliente e produto posicionado, possui configurador de tributos.

Esta função só pode ser acionada depois que a MaFisIni foi inicializada e 
todos os itens foram carregados para a MATXFIS.

cTrib -> Código do tributo a ser consultado de acordo com o documento do 
fiscal: https://tdn.totvs.com/display/public/PROT/CFGTRIB+-+Configurador+de+Tributos

nItem -> Caso queira que retorne informação somente do item, informar qual item
deseja posicionar. 

lVldTrib -> Valida se o tributo consultado utiliza ou não configurador de tributos

@type       Function
@author     CRM/Faturamento
@since      Dezembro/2025
@version    12.1.2510
@return 	.T.
/*/
//-------------------------------------------------------------------------------
Function FatCfgTrib(cTrib, nItem, lVldTrib ) As Logical

Local aArea			:= GetArea()
Local oDados 	as json
Local oRetJ		as json
Local aItens 		:= {}
Local aTaxes		:= {}
Local cItem			:= ""
Local cRetorno 		:= ""
Local nI			:= 0
Local nX			:= 0
Local lRet			:= .F.
Local cCfgTax 		:= "dados_itens"
Local cPropTrib 	:= "ident_trib"

Default cTrib		:= ""
Default nItem		:= 0
Default lVldTrib	:= .F.

//Inicializa o processamento
oDados 		:= totvs.protheus.backoffice.fiscal.tciclass.TCIProcessing():New()

//Adiociona o item para a pesquisa
aItens 		:= {nItem}
oDados:setItems(aItens)

//Retorno como Json com a consulta
cRetorno 	:= oDados:GetDataItems()
oRetJ 		:= JsonObject():New()
oRetJ:fromJson(cRetorno)

//Verifica se possui erro no Json
If !oRetJ:hasproperty("erro")
	aItens := oRetJ[cCfgTax]:GetNames()

	//Filtra todos os itens encontrados
	For nI := 1 To Len(aItens)
		cItem := aItens[nI]
		
		//Carrega todos os códigos do tributos cadastrados
		If oRetJ[cCfgTax]:hasproperty(cItem)
			aTaxes := oRetJ[cCfgTax][cItem]:GetNames()
		EndIf
		
		//Verifica se o código do ID trib informado, existe
		For nX := 1 To Len(aTaxes)
			If !oRetJ[cCfgTax][cItem]:hasproperty("Aviso") .And. oRetJ[cCfgTax][cItem][aTaxes[nX]][cPropTrib] == cTrib
				lRet := .T.
				Exit
			EndIf
			//Verifica se foi validado o cfg de tributo ou não.
			lVldTrib := !oRetJ[cCfgTax][cItem]:hasproperty("Aviso")
		Next nX
	Next nI
EndIf

aSize(aItens, 0)
FwFreeArray(aItens)

aSize(aTaxes, 0)
FwFreeArray(aTaxes)

FwFreeObj(oRetJ)
oRetJ := Nil
RestArea(aArea)

Return lRet
