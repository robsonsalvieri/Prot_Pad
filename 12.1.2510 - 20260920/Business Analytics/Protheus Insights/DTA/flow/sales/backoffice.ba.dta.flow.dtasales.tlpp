#INCLUDE "totvs.ch"
#INCLUDE "tlpp-core.th"
#INCLUDE "Protheus.ch"
#INCLUDE "backoffice.ba.dta.flow.dtasales.ch"

Static __cFrom := "bot"

//-------------------------------------------------------------------------------------
/*/{Protheus.doc} toolSalesCounter
Tool de contador de quantidade de pedidos de vendas por status.

@param @aToolParams, Json, Parâmetros para utilização na tool.

@return oResponse, Json, Pedidos de vendas por status.

@author TOTVS BA
@since 03/11/2025
/*/
//----------------------------------------------------------------------------------
Function toolSalesCounter( aToolParams, cType )
	Local aArea         := GetArea() as array
	Local oQuery        := Nil       as object
	Local oResponse     := Nil       as object
	Local oItem         := Nil       as object
    Local oData        := Nil       as object
	Local cQuery        := ""        as character
	Local cNextAlias    := ""        as character
	Local cInitDate     := ""        as character
	Local cEndDate      := ""        as character
	Local cBranch       := ""        as character
	Local cProduct      := ""        as character
	Local lProduct      := .f.       as logical
	Local nI            := 1         as numeric

	Default aToolParams := {}
	Default cType       := "chart"

	If ValType( aToolParams ) == "J"
		cInitDate   := aToolParams[ "initDate" ]
		cEndDate    := aToolParams[ "endDate" ]
		cBranch     := aToolParams[ "branch" ]
		cProduct    := aToolParams[ "product" ]
		lProduct    := !Empty( cProduct )
	EndIf

	//Query Pedidos de Vendas
	cQuery := getQuerySales( "counter", , lProduct )
	cQuery := ChangeQuery( cQuery )

	oQuery := FwExecStatement():New( cQuery )
	// total de pedidos
	oQuery:setString( nI++, ' ' )
	oQuery:setString( nI++, FWxfilial( "SC5", cBranch ) )
	oQuery:setString( nI++, cInitDate )
	oQuery:setString( nI++, cEndDate )
	oQuery:setString( nI++, 'N' )
	oQuery:setString( nI++, ' ' )
	if lProduct
		oQuery:setString( nI++, cProduct )
	Endif
	// pedidos em aberto
	oQuery:setString( nI++, ' ' )
	oQuery:setString( nI++, FWxfilial( "SC5", cBranch ) )
	oQuery:setString( nI++, cInitDate )
	oQuery:setString( nI++, cEndDate )
	oQuery:setString( nI++, 'N' )
	oQuery:setString( nI++, ' ' )
	if lProduct
		oQuery:setString( nI++, cProduct )
	Endif
	// pedidos faturados
	oQuery:setString( nI++, cInitDate )
	oQuery:setString( nI++, cEndDate )
	oQuery:setString( nI++, 'N' )
	oQuery:setString( nI++, ' ' )
	oQuery:setString( nI++, ' ' )
	oQuery:setString( nI++, FWxfilial( "SC9", cBranch ) )
	oQuery:setString( nI++, ' ' )
	if lProduct
		oQuery:setString( nI++, cProduct )
	Endif
	// pedidos faturados parcialmente
	oQuery:setString( nI++, cInitDate )
	oQuery:setString( nI++, cEndDate )
	oQuery:setString( nI++, 'N' )
	oQuery:setString( nI++, ' ' )
	oQuery:setString( nI++, ' ' )
	oQuery:setString( nI++, FWxfilial( "SC9", cBranch ) )
	oQuery:setString( nI++, ' ' )
	if lProduct
		oQuery:setString( nI++, cProduct )
	Endif
	// pedidos liberados
	oQuery:setString( nI++, cInitDate )
	oQuery:setString( nI++, cEndDate )
	oQuery:setString( nI++, 'N' )
	oQuery:setString( nI++, ' ' )
	oQuery:setString( nI++, ' ' )
	oQuery:setString( nI++, FWxfilial( "SC9", cBranch ) )
	oQuery:setString( nI++, ' ' )
	if lProduct
		oQuery:setString( nI++, cProduct )
	Endif
	// pedidos bloqueados por regra
	oQuery:setString( nI++, ' ' )
	oQuery:setString( nI++, FWxfilial( "SC5", cBranch ) )
	oQuery:setString( nI++, cInitDate )
	oQuery:setString( nI++, cEndDate )
	oQuery:setString( nI++, 'N' )
	oQuery:setString( nI++, ' ' )
	if lProduct
		oQuery:setString( nI++, cProduct )
	Endif
	// pedidos bloqueados por verba
	oQuery:setString( nI++, ' ' )
	oQuery:setString( nI++, FWxfilial( "SC5", cBranch ) )
	oQuery:setString( nI++, cInitDate )
	oQuery:setString( nI++, cEndDate )
	oQuery:setString( nI++, 'N' )
	oQuery:setString( nI++, ' ' )
	if lProduct
		oQuery:setString( nI++, cProduct )
	Endif
	// pedidos bloqueados por credito
	oQuery:setString( nI++, cInitDate )
	oQuery:setString( nI++, cEndDate )
	oQuery:setString( nI++, 'N' )
	oQuery:setString( nI++, ' ' )
	oQuery:setString( nI++, ' ' )
	oQuery:setString( nI++, FWxfilial( "SC9", cBranch ) )
	oQuery:setString( nI++, ' ' )
	if lProduct
		oQuery:setString( nI++, cProduct )
	Endif
	// pedidos bloqueados por estoque
	oQuery:setString( nI++, cInitDate )
	oQuery:setString( nI++, cEndDate )
	oQuery:setString( nI++, 'N' )
	oQuery:setString( nI++, ' ' )
	oQuery:setString( nI++, ' ' )
	oQuery:setString( nI++, FWxfilial( "SC9", cBranch ) )
	oQuery:setString( nI++, ' ' )
	if lProduct
		oQuery:setString( nI++, cProduct )
	Endif
	// pedidos bloqueados credito e estoque
	oQuery:setString( nI++, cInitDate )
	oQuery:setString( nI++, cEndDate )
	oQuery:setString( nI++, 'N' )
	oQuery:setString( nI++, ' ' )
	oQuery:setString( nI++, ' ' )
	oQuery:setString( nI++, FWxfilial( "SC9", cBranch ) )
	oQuery:setString( nI++, ' ' )
	if lProduct
		oQuery:setString( nI++, cProduct )
	Endif

	cNextAlias := oQuery:OpenAlias()

	oResponse := JsonObject():new()
	oResponse[ "from" ]	 := __cFrom        // "bot"
	oResponse[ "type" ]	 := cType
    oResponse[ "text" ]	 := STR0001        // "Resumo de pedidos de vendas por status."

    oData := JsonObject():new()
    oData[ "type" ] := "pie"
    oData[ "data" ] := {}
	oResponse[ "chart" ] := oData

	While ( cNextAlias )->( !Eof() )

        oItem := JsonObject():New()
        oItem[ "label" ]    := AllTrim( ( cNextAlias )->PED_STATUS )
        oItem[ "value" ]    := ( cNextAlias )->QUANT
        AAdd( oResponse[ "chart" ][ "data" ], oItem )

		( cNextAlias )->( DbSkip() )
	EndDo
	( cNextAlias )->( DbCloseArea() )

	RestArea( aArea )

	FreeObj( oQuery )
    FreeObj( oItem )
    FreeObj( oData )
	FWFreeArray( aArea )
Return oResponse

//-------------------------------------------------------------------------------------
/*/{Protheus.doc} toolSalesDetail
Tool de detalhes de pedidos de vendas.

@param @aToolParams, Json, Parâmetros para utilização na tool.

@return oResponse, Json, Pedido de venda detalhado.

@author TOTVS BA
@since 03/11/2025
/*/
//----------------------------------------------------------------------------------
Function toolSalesDetail( aToolParams, cType )
    Local aArea         := GetArea() as array
    Local oQuery        := Nil       as object
    Local oResponse     := Nil       as object
    Local oItem         := Nil       as object
    Local oData        := Nil       as object
    Local cQuery        := ""        as character
    Local cNextAlias    := ""        as character
    Local cInitDate     := ""        as character
    Local cEndDate      := ""        as character
    Local cBranch       := ""        as character
    Local cStatus       := ""        as character
    Local cProduct      := ""        as character
    Local lProduct      := .F.       as logical
    Local nI            := 1         as numeric

    Default aToolParams := {}
    Default cType       := "bo-drilldown"

    If ValType( aToolParams ) == "J"
        cInitDate   := aToolParams[ "initDate" ]
        cEndDate    := aToolParams[ "endDate" ]
        cBranch     := aToolParams[ "branch" ]
        cStatus     := aToolParams[ "status" ]
        cProduct    := aToolParams[ "product" ]
        lProduct    := !Empty( cProduct )
    EndIf

    //Query Pedidos de Vendas
    cQuery := getQuerySales( "detail", cStatus, lProduct )
    cQuery := ChangeQuery( cQuery )

    oQuery := FwExecStatement():New( cQuery )
    
    If cStatus $ "TOTAL|ABERTOS|BLOQUEADO POR REGRA|BLOQUEADO POR VERBA"
        
        oQuery:setString( nI++, ' ' )
        oQuery:setString( nI++, FWxfilial( "SA1", cBranch ) )
        oQuery:setString( nI++, ' ' )
        oQuery:setString( nI++, FWxfilial( "SE4", cBranch ) )
        oQuery:setString( nI++, ' ' )
        oQuery:setString( nI++, FWxfilial( "DA0", cBranch ) )
        oQuery:setString( nI++, ' ' )
        oQuery:setString( nI++, FWxfilial( "SA3", cBranch ) )
        oQuery:setString( nI++, ' ' )
        oQuery:setString( nI++, FWxfilial( "SC5", cBranch ) )
        oQuery:setString( nI++, cInitDate )
        oQuery:setString( nI++, cEndDate )
        oQuery:setString( nI++, 'N' )
        oQuery:setString( nI++, ' ' )
        If lProduct
            oQuery:setString( nI++, cProduct )
        EndIf

    Else

        oQuery:setString( nI++, cInitDate )
        oQuery:setString( nI++, cEndDate )
        oQuery:setString( nI++, 'N' )
        oQuery:setString( nI++, ' ' )
        oQuery:setString( nI++, ' ' )
        oQuery:setString( nI++, FWxfilial( "SA1", cBranch ) )
        oQuery:setString( nI++, ' ' )
        oQuery:setString( nI++, FWxfilial( "SE4", cBranch ) )
        oQuery:setString( nI++, ' ' )
        oQuery:setString( nI++, FWxfilial( "DA0", cBranch ) )
        oQuery:setString( nI++, ' ' )
        oQuery:setString( nI++, FWxfilial( "SA3", cBranch ) )
        oQuery:setString( nI++, ' ' )
        oQuery:setString( nI++, FWxfilial( "SC9", cBranch ) )
        oQuery:setString( nI++, ' ' )
        If lProduct
            oQuery:setString( nI++, cProduct )
        EndIf
    EndIf

    cNextAlias := oQuery:OpenAlias()

    oResponse := JsonObject():new()
    oResponse[ "from" ]	:= __cFrom        // "bot"
	oResponse[ "type" ]	:= cType
    oResponse[ "text" ]	:= STR0002        // "Pedidos de vendas encontrados para os filtros selecionados."
    
    oData := JsonObject():new()
    oData[ "header" ] := {}
    oData[ "items" ] := {}
    oResponse[ "drillDownData" ] := oData

    AAdd( oResponse[ "drillDownData" ][ "header" ], { "property": "branch", "label": "Filial", "visible": true, "showFilter": true } )
    AAdd( oResponse[ "drillDownData" ][ "header" ], { "property": "order_number", "label": "Pedido", "visible": true, "showFilter": true } )
    AAdd( oResponse[ "drillDownData" ][ "header" ], { "property": "customer", "label": "Cliente", "visible": true, "showFilter": true } )
    AAdd( oResponse[ "drillDownData" ][ "header" ], { "property": "customer_name", "label": "Nome do Cliente", "visible": true, "showFilter": true } )
    AAdd( oResponse[ "drillDownData" ][ "header" ], { "property": "risk", "label": "Risco", "visible": true, "showFilter": true } )
    AAdd( oResponse[ "drillDownData" ][ "header" ], { "property": "credit_limit", "label": "Limite de Credito", "visible": true, "showFilter": true } )
    AAdd( oResponse[ "drillDownData" ][ "header" ], { "property": "credit_limit_fin", "label": "Limite de Credito Fin.", "visible": true, "showFilter": true } )
    AAdd( oResponse[ "drillDownData" ][ "header" ], { "property": "issue_date", "label": "Data de Emissao", "visible": true, "showFilter": true } )
    AAdd( oResponse[ "drillDownData" ][ "header" ], { "property": "payment_condition", "label": "Condicao de Pagamento", "visible": true, "showFilter": true } )
    AAdd( oResponse[ "drillDownData" ][ "header" ], { "property": "price_table", "label": "Tabela de Preco", "visible": true, "showFilter": true } )
    AAdd( oResponse[ "drillDownData" ][ "header" ], { "property": "sales_person", "label": "Vendedor", "visible": true, "showFilter": true } )
    AAdd( oResponse[ "drillDownData" ][ "header" ], { "property": "counter", "label": "Quant. Itens", "visible": true, "showFilter": true } )
    AAdd( oResponse[ "drillDownData" ][ "header" ], { "property": "total_value", "label": "Valor Pedido", "visible": true, "showFilter": true } )

    While ( cNextAlias )->( !Eof() )

        oItem := JsonObject():New()
        oItem[ "branch" ]               := ( cNextAlias )->BRANCH
        oItem[ "order_number" ]         := ( cNextAlias )->ORDER_NUMBER
        oItem[ "customer" ]             := ( cNextAlias )->CUSTOMER + "|" + AllTrim( ( cNextAlias )->CUSTOMER_STORE )
        oItem[ "customer_name" ]        := AllTrim( ( cNextAlias )->CUSTOMER_NAME )
        oItem[ "risk" ]                 := ( cNextAlias )->RISK
        oItem[ "credit_limit" ]         := Round( ( cNextAlias )->CREDIT_LIMIT, 2 )
        oItem[ "credit_limit_fin" ]     := Round( ( cNextAlias )->CREDIT_LIMIT_FIN, 2 )
        oItem[ "issue_date" ]           := ( cNextAlias )->ISSUE_DATE
        oItem[ "payment_condition" ]    := ( cNextAlias )->PAYMENT_CONDITION + " - " + AllTrim( ( cNextAlias )->PAYMENT_DESCRIPTION )
        oItem[ "price_table" ]          := AllTrim( ( cNextAlias )->PRICE_TABLE ) + " - " + AllTrim( ( cNextAlias )->PRICE_TABLE_DESCRIPTION )
        oItem[ "sales_person" ]         := AllTrim( ( cNextAlias )->SALES_PERSON ) + " - " + AllTrim( ( cNextAlias )->SALES_PERSON_NAME )
        oItem[ "counter" ]              := Round( ( cNextAlias )->COUNTER, 0 )
        oItem[ "total_value" ]          := Round( ( cNextAlias )->TOTAL_VALUE, 2 )
        AAdd( oResponse[ "drillDownData" ][ "items" ], oItem )

	    ( cNextAlias )->( DbSkip() )
	EndDo
    ( cNextAlias )->( DbCloseArea() )

    RestArea( aArea )

    FreeObj( oQuery )
    FreeObj( oItem )
    FreeObj( oData )
	FWFreeArray( aArea )
Return oResponse

//-------------------------------------------------------------------------------------
/*/{Protheus.doc} toolSalesDetail
Tool de detalhes de pedidos de vendas.

@param @aToolParams, Json, Parâmetros para utilização na tool.

@return oResponse, Json, Pedido de venda detalhado.

@author TOTVS BA
@since 03/11/2025
/*/
//----------------------------------------------------------------------------------
Function toolSalesDetailInfo( aToolParams, cType )
    Local aArea         := GetArea() as array
    Local oQuery        := Nil       as object
    Local oResponse     := Nil       as object
    Local oData         := Nil       as object
    Local oItem         := Nil       as object
    Local cQuery        := ""        as character
    Local cNextAlias    := ""        as character
    Local cBranch       := ""        as character
    Local nI            := 1         as numeric

    Default aToolParams := {}
    Default cType       := "bo-drilldown"

    If ValType( aToolParams ) == "J"
        cBranch     := aToolParams[ "branch" ]
        cNumber     := aToolParams[ "order_number" ]    
    EndIf

    //Query Pedidos de Vendas
    cQuery := getQuerySales( "detailInfo" )
    cQuery := ChangeQuery( cQuery )

    oQuery := FwExecStatement():New( cQuery )
    
    oQuery:setString( nI++, ' ' )
    oQuery:setString( nI++, FWxfilial( "SB2", cBranch ) )
    oQuery:setString( nI++, ' ' )
    oQuery:setString( nI++, FWxfilial( "SA1", cBranch ) )
    oQuery:setString( nI++, ' ' )
    oQuery:setString( nI++, FWxfilial( "SC5", cBranch ) )
    oQuery:setString( nI++, cNumber )
    oQuery:setString( nI++, 'N' )
    oQuery:setString( nI++, ' ' )

    cNextAlias := oQuery:OpenAlias()

    oResponse := JsonObject():new()
    oResponse[ "from" ]	:= __cFrom        // "bot"
	oResponse[ "type" ]	:= cType
    oResponse[ "text" ]	:= I18N( STR0003, { cNumber } )        // "Aqui estao os itens do pedido de vendas #1."
    
    oData := JsonObject():new()
    oData[ "header" ] := {}
    oData[ "items" ] := {}
    oResponse[ "drillDownData" ] := oData

    AAdd( oResponse[ "drillDownData" ][ "header" ], { "property": "branch", "label": "Filial", "visible": true, "showFilter": true } )
    AAdd( oResponse[ "drillDownData" ][ "header" ], { "property": "order_number", "label": "Pedido", "visible": true, "showFilter": true } )
    AAdd( oResponse[ "drillDownData" ][ "header" ], { "property": "customer", "label": "Cliente", "visible": true, "showFilter": true } )
    AAdd( oResponse[ "drillDownData" ][ "header" ], { "property": "customer_name", "label": "Nome do Cliente", "visible": true, "showFilter": true } )
    AAdd( oResponse[ "drillDownData" ][ "header" ], { "property": "item", "label": "Item", "visible": true, "showFilter": true } )
    AAdd( oResponse[ "drillDownData" ][ "header" ], { "property": "product", "label": "Produto", "visible": true, "showFilter": true } )
    AAdd( oResponse[ "drillDownData" ][ "header" ], { "property": "quantity", "label": "Quantidade", "visible": true, "showFilter": true } )
    AAdd( oResponse[ "drillDownData" ][ "header" ], { "property": "price", "label": "Preco", "visible": true, "showFilter": true } )
    AAdd( oResponse[ "drillDownData" ][ "header" ], { "property": "value_total", "label": "Valor Total", "visible": true, "showFilter": true } )
    AAdd( oResponse[ "drillDownData" ][ "header" ], { "property": "stock", "label": "Estoque", "visible": true, "showFilter": true } )

    While ( cNextAlias )->( !Eof() )
        
        oItem := JsonObject():New()
        oItem[ "branch" ]           := ( cNextAlias )->BRANCH
        oItem[ "order_number" ]     := ( cNextAlias )->ORDER_NUMBER
        oItem[ "customer" ]         := ( cNextAlias )->CUSTOMER +"|"+ ( cNextAlias )->CUSTOMER_STORE
        oItem[ "customer_name" ]    := AllTrim( ( cNextAlias )->CUSTOMER_NAME )
        oItem[ "item" ]             := ( cNextAlias )->ITEM
        oItem[ "product" ]          := AllTrim( ( cNextAlias )->PRODUCT ) +" - "+AllTrim( ( cNextAlias )->PRODUCT_DESCRIPTION )
        oItem[ "quantity" ]         := Round( ( cNextAlias )->QUANTITY, 2 )
        oItem[ "price" ]            := Round( ( cNextAlias )->PRICE, 2 )
        oItem[ "value_total" ]      := Round( ( cNextAlias )->VALUE_TOTAL, 2 )
        oItem[ "stock" ]            := Round( ( cNextAlias )->STOCK, 2 )
        AAdd( oResponse[ "drillDownData" ][ "items" ], oItem )

	    ( cNextAlias )->( DbSkip() )
	EndDo
    ( cNextAlias )->( DbCloseArea() )

    RestArea( aArea )

    FreeObj( oQuery )
    FreeObj( oItem )
    FreeObj( oData )
	FWFreeArray( aArea )
Return oResponse

//-------------------------------------------------------------------------------------
/*/{Protheus.doc} getQuerySales
Função responsável pela montagem da query para selecionar a quantidade de pedidos de vendas por status.

@return cQueryDTA, character, query de pedidos de venda.

@author TOTVS BA
@since 04/11/2025
/*/
//----------------------------------------------------------------------------------
Function getQuerySales( cQueryType, cStatus, lProduct )
    Local cQueryDTA := ""        as character
    Local cSelect   := ""        as character
    Local cInnerJoin:= ""        as character
    Local cGroupBy  := ""        as character

    Default cStatus := ""
    Default lProduct := .F.

    Do Case
    Case cQueryType == "counter"
        // --Consulta total de pedidos
        cQueryDTA += " SELECT "
        cQueryDTA += " 'TOTAL' AS PED_STATUS, COUNT(*) AS QUANT, ISNULL(SUM(C6_VALOR),0) AS VALOR "
        cQueryDTA += " FROM ( "
        cQueryDTA += " 	SELECT C5_FILIAL, C5_NUM, SUM(C6_VALOR) AS C6_VALOR "
        cQueryDTA += " 	FROM " + RetSqlName( "SC5" ) + " SC5 "
        cQueryDTA += " 	INNER JOIN " + RetSqlName( "SC6" ) + " SC6 "
        cQueryDTA += " 		ON SC6.C6_FILIAL = SC5.C5_FILIAL "
        cQueryDTA += " 		   AND SC6.C6_NUM = SC5.C5_NUM "
        cQueryDTA += " 		   AND SC6.C6_CLI = SC5.C5_CLIENTE "
        cQueryDTA += " 		   AND SC6.C6_LOJA = SC5.C5_LOJACLI "
        cQueryDTA += " 		   AND SC6.D_E_L_E_T_ = ? "
        cQueryDTA += " 	WHERE SC5.C5_FILIAL = ? "
        cQueryDTA += "  AND SC5.C5_EMISSAO BETWEEN ? AND ? "
        cQueryDTA += "  AND SC5.C5_TIPO = ? "
        cQueryDTA += "  AND SC5.D_E_L_E_T_ = ? "
        if lProduct
            cQueryDTA += "AND SC6.C6_PRODUTO = ?  "
        EndIf
        cQueryDTA += " 	GROUP BY C5_FILIAL, C5_NUM "
        cQueryDTA += " ) AUX "

        cQueryDTA += " UNION ALL "
		
        // --Consulta de pedidos em aberto
        cQueryDTA += " SELECT "
        cQueryDTA += " 	'ABERTOS' AS PED_STATUS, COUNT(C5_NUM) AS QUANT, ISNULL(SUM(C6_VALOR),0) AS VALOR "
        cQueryDTA += " FROM ( "
        cQueryDTA += " 	SELECT C5_FILIAL, C5_NUM, SUM(C6_VALOR) AS C6_VALOR "
        cQueryDTA += " 	FROM " + RetSqlName( "SC5" ) + " SC5 "
        cQueryDTA += " 	INNER JOIN " + RetSqlName( "SC6" ) + " SC6 "
        cQueryDTA += " 		ON SC6.C6_FILIAL = SC5.C5_FILIAL "
        cQueryDTA += " 		   AND SC6.C6_NUM = SC5.C5_NUM "
        cQueryDTA += " 		   AND SC6.C6_CLI = SC5.C5_CLIENTE "
        cQueryDTA += " 		   AND SC6.C6_LOJA = SC5.C5_LOJACLI "
        cQueryDTA += " 		   AND SC6.D_E_L_E_T_ = ? "
        cQueryDTA += " 	WHERE SC5.C5_FILIAL = ? "
        cQueryDTA += "  AND SC5.C5_EMISSAO BETWEEN ? AND ? "
        cQueryDTA += "  AND SC5.C5_TIPO = ? "
        cQueryDTA += " 	AND SC5.C5_LIBEROK = '' "
        cQueryDTA += " 	AND SC5.C5_NOTA = '' "
        cQueryDTA += " 	AND SC5.C5_BLQ = '' "
        cQueryDTA += "  AND SC5.D_E_L_E_T_ = ? "
        if lProduct
            cQueryDTA += "AND SC6.C6_PRODUTO = ?  "
        EndIf
        cQueryDTA += " 	GROUP BY C5_FILIAL, C5_NUM "
        cQueryDTA += " ) AUX "

        cQueryDTA += " UNION ALL "
		
        // --Consulta de pedidos faturados
        cQueryDTA += " SELECT  "
        cQueryDTA += " 	'FATURADOS' AS PED_STATUS, COUNT(C5_NUM) AS QUANT, ISNULL(SUM(C6_VALOR),0) AS VALOR "
        cQueryDTA += " FROM ( "
        cQueryDTA += " 	SELECT C5_FILIAL, C5_NUM, SUM(SC9.C9_QTDLIB * SC9.C9_PRCVEN) AS C6_VALOR "
        cQueryDTA += " 	FROM " + RetSqlName( "SC9" ) + " SC9 "
        cQueryDTA += " 	INNER JOIN " + RetSqlName( "SC5" ) + " SC5 "
        cQueryDTA += " 		ON SC5.C5_FILIAL = SC9.C9_FILIAL "
        cQueryDTA += " 		   AND SC5.C5_NUM = SC9.C9_PEDIDO "
        cQueryDTA += " 		   AND SC5.C5_EMISSAO BETWEEN ? AND ? "
        cQueryDTA += " 		   AND SC5.C5_TIPO = ? "
        cQueryDTA += " 		   AND (SC5.C5_NOTA <> '' OR SC5.C5_LIBEROK = 'E') AND SC5.C5_BLQ = '' "
        cQueryDTA += " 		   AND SC5.D_E_L_E_T_ = ? "
        cQueryDTA += " 	INNER JOIN " + RetSqlName( "SC6" ) + " SC6 "
        cQueryDTA += " 		ON SC6.C6_FILIAL = SC9.C9_FILIAL "
        cQueryDTA += " 		   AND SC6.C6_NUM = SC9.C9_PEDIDO "
        cQueryDTA += " 		   AND SC6.C6_ITEM = SC9.C9_ITEM "
        cQueryDTA += " 		   AND SC6.C6_PRODUTO = SC9.C9_PRODUTO "
        cQueryDTA += " 		   AND SC6.D_E_L_E_T_ = ? "
        cQueryDTA += " 	WHERE SC9.C9_FILIAL = ? "
        cQueryDTA += " 	AND SC9.D_E_L_E_T_ = ? "
        if lProduct
            cQueryDTA += "AND SC6.C6_PRODUTO = ?  "
        EndIf
        cQueryDTA += " 	GROUP BY C5_FILIAL, C5_NUM "
        cQueryDTA += " ) AUX "

        cQueryDTA += " UNION ALL "
		
        // --Consulta de pedidos faturados parcialmente
        cQueryDTA += " SELECT "
        cQueryDTA += " 	'FATURADOS PARCIAL' AS PED_STATUS, COUNT(C5_NUM) AS QUANT, ISNULL(SUM(C6_VALOR),0) AS VALOR "
        cQueryDTA += " FROM ( "
        cQueryDTA += " 	SELECT C5_FILIAL, C5_NUM, SUM(SC9.C9_QTDLIB * SC9.C9_PRCVEN) AS C6_VALOR "
        cQueryDTA += " 	FROM " + RetSqlName( "SC9" ) + " SC9 "
        cQueryDTA += " 	INNER JOIN " + RetSqlName( "SC5" ) + " SC5 "
        cQueryDTA += " 		ON SC5.C5_FILIAL = SC9.C9_FILIAL "
        cQueryDTA += " 		   AND SC5.C5_NUM = SC9.C9_PEDIDO "
        cQueryDTA += " 		   AND SC5.C5_EMISSAO BETWEEN ? AND ? "
        cQueryDTA += " 		   AND SC5.C5_TIPO = ? "
        cQueryDTA += " 		   AND SC5.C5_NOTA = '' AND SC5.C5_LIBEROK = '' AND SC5.C5_BLQ = '' "
        cQueryDTA += " 		   AND SC5.D_E_L_E_T_ = ? "
        cQueryDTA += " 	INNER JOIN " + RetSqlName( "SC6" ) + " SC6 "
        cQueryDTA += " 		ON SC6.C6_FILIAL = SC9.C9_FILIAL "
        cQueryDTA += " 		   AND SC6.C6_NUM = SC9.C9_PEDIDO "
        cQueryDTA += " 		   AND SC6.C6_ITEM = SC9.C9_ITEM "
        cQueryDTA += " 		   AND SC6.C6_PRODUTO = SC9.C9_PRODUTO "
        cQueryDTA += " 		   AND SC6.C6_QTDENT < SC6.C6_QTDVEN "
        cQueryDTA += " 		   AND SC6.C6_QTDENT > 0 "
        cQueryDTA += " 		   AND SC6.D_E_L_E_T_ = ? "
        cQueryDTA += " 	WHERE SC9.C9_FILIAL = ? "
        cQueryDTA += " 	AND SC9.D_E_L_E_T_ = ? "
        if lProduct
            cQueryDTA += "AND SC6.C6_PRODUTO = ?  "
        EndIf
        cQueryDTA += " 	GROUP BY C5_FILIAL, C5_NUM "
        cQueryDTA += " ) AUX "

        cQueryDTA += " UNION ALL "
		
        // --Consulta de pedidos liberados
        cQueryDTA += " SELECT "
        cQueryDTA += " 	'LIBERADOS' AS PED_STATUS, COUNT(C5_NUM) AS QUANT, ISNULL(SUM(C6_VALOR),0) AS VALOR "
        cQueryDTA += " FROM ( "
        cQueryDTA += " 	SELECT C5_FILIAL, C5_NUM, SUM(SC9.C9_QTDLIB * SC9.C9_PRCVEN) AS C6_VALOR "
        cQueryDTA += " 	FROM " + RetSqlName( "SC9" ) + " SC9 "
        cQueryDTA += " 	INNER JOIN " + RetSqlName( "SC5" ) + " SC5 "
        cQueryDTA += " 		ON SC5.C5_FILIAL = SC9.C9_FILIAL "
        cQueryDTA += " 		   AND SC5.C5_NUM = SC9.C9_PEDIDO "
        cQueryDTA += " 		   AND SC5.C5_EMISSAO BETWEEN ? AND ? "
        cQueryDTA += " 		   AND SC5.C5_TIPO = ? "
        cQueryDTA += " 		   AND SC5.C5_LIBEROK <> '' "
        cQueryDTA += " 		   AND SC5.C5_NOTA = '' "
        cQueryDTA += " 		   AND SC5.C5_BLQ = '' "
        cQueryDTA += " 		   AND SC5.D_E_L_E_T_ = ? "
        cQueryDTA += " 	INNER JOIN " + RetSqlName( "SC6" ) + " SC6 "
        cQueryDTA += " 		ON SC6.C6_FILIAL = SC9.C9_FILIAL "
        cQueryDTA += " 		   AND SC6.C6_NUM = SC9.C9_PEDIDO "
        cQueryDTA += " 		   AND SC6.C6_ITEM = SC9.C9_ITEM "
        cQueryDTA += " 		   AND SC6.C6_PRODUTO = SC9.C9_PRODUTO "
        cQueryDTA += " 		   AND SC6.D_E_L_E_T_ = ? "
        cQueryDTA += " 	WHERE SC9.C9_FILIAL = ? "
        cQueryDTA += " 	AND SC9.C9_BLCRED = ' ' "
        cQueryDTA += " 	AND SC9.C9_BLEST = ' ' "
        cQueryDTA += " 	AND SC9.C9_NFISCAL = ' ' "
        cQueryDTA += " 	AND SC9.D_E_L_E_T_ = ? "
        if lProduct
            cQueryDTA += "AND SC6.C6_PRODUTO = ?  "
        EndIf
        cQueryDTA += " 	GROUP BY C5_FILIAL, C5_NUM "
        cQueryDTA += " ) AUX "

        cQueryDTA += " UNION ALL "
		
        // --Consulta de pedidos bloqueados por regra
        cQueryDTA += " SELECT "
        cQueryDTA += " 	'BLOQUEADO POR REGRA' AS PED_STATUS, COUNT(C5_NUM) AS QUANT, ISNULL(SUM(C6_VALOR),0) AS VALOR "
        cQueryDTA += " FROM ( "
        cQueryDTA += " 	SELECT C5_FILIAL, C5_NUM, SUM(C6_VALOR) AS C6_VALOR "
        cQueryDTA += " 	FROM " + RetSqlName( "SC5" ) + " SC5 "
        cQueryDTA += " 	INNER JOIN " + RetSqlName( "SC6" ) + " SC6 "
        cQueryDTA += " 		ON SC6.C6_FILIAL = SC5.C5_FILIAL "
        cQueryDTA += " 		   AND SC6.C6_NUM = SC5.C5_NUM "
        cQueryDTA += " 		   AND SC6.C6_CLI = SC5.C5_CLIENTE "
        cQueryDTA += " 		   AND SC6.C6_LOJA = SC5.C5_LOJACLI "
        cQueryDTA += " 		   AND SC6.D_E_L_E_T_ = ? "
        cQueryDTA += " 	WHERE SC5.C5_FILIAL = ? "
        cQueryDTA += "  AND SC5.C5_EMISSAO BETWEEN ? AND ? "
        cQueryDTA += "  AND SC5.C5_TIPO = ? "
        cQueryDTA += " 	AND SC5.C5_BLQ = '1' "
        cQueryDTA += "  AND SC5.D_E_L_E_T_ = ? "
        if lProduct
            cQueryDTA += "AND SC6.C6_PRODUTO = ?  "
        EndIf
        cQueryDTA += " 	GROUP BY C5_FILIAL, C5_NUM "
        cQueryDTA += " ) AUX "

        cQueryDTA += " UNION ALL "
		
        // --Consulta de pedidos bloqueados por verba
        cQueryDTA += " SELECT "
        cQueryDTA += " 	'BLOQUEADO POR VERBA' AS PED_STATUS, COUNT(C5_NUM) AS QUANT, ISNULL(SUM(C6_VALOR),0) AS VALOR "
        cQueryDTA += " FROM ( "
        cQueryDTA += " 	SELECT C5_FILIAL, C5_NUM, SUM(C6_VALOR) AS C6_VALOR "
        cQueryDTA += " 	FROM " + RetSqlName( "SC5" ) + " SC5 "
        cQueryDTA += " 	INNER JOIN " + RetSqlName( "SC6" ) + " SC6 "
        cQueryDTA += " 		ON SC6.C6_FILIAL = SC5.C5_FILIAL "
        cQueryDTA += " 		   AND SC6.C6_NUM = SC5.C5_NUM "
        cQueryDTA += " 		   AND SC6.C6_CLI = SC5.C5_CLIENTE "
        cQueryDTA += " 		   AND SC6.C6_LOJA = SC5.C5_LOJACLI "
        cQueryDTA += " 		   AND SC6.D_E_L_E_T_ = ? "
        cQueryDTA += " 	WHERE SC5.C5_FILIAL = ? "
        cQueryDTA += "  AND SC5.C5_EMISSAO BETWEEN ? AND ? "
        cQueryDTA += "  AND SC5.C5_TIPO = ? "
        cQueryDTA += " 	AND SC5.C5_BLQ = '2' "
        cQueryDTA += "  AND SC5.D_E_L_E_T_ = ? "
        if lProduct
            cQueryDTA += "AND SC6.C6_PRODUTO = ?  "    
        EndIf
        cQueryDTA += " 	GROUP BY C5_FILIAL, C5_NUM "
        cQueryDTA += " ) AUX "

        cQueryDTA += " UNION ALL "
		
        // --Consulta de pedidos bloqueados por credito
        cQueryDTA += " SELECT "
        cQueryDTA += " 	'BLOQUEIO CREDITO' AS PED_STATUS, COUNT(C5_NUM) AS QUANT, ISNULL(SUM(C6_VALOR),0) AS VALOR "
        cQueryDTA += " FROM ( "
        cQueryDTA += " 	SELECT C5_FILIAL, C5_NUM, SUM(SC9.C9_QTDLIB * SC9.C9_PRCVEN) AS C6_VALOR "
        cQueryDTA += " 	FROM " + RetSqlName( "SC9" ) + " SC9 "
        cQueryDTA += " 	INNER JOIN " + RetSqlName( "SC5" ) + " SC5 "
        cQueryDTA += " 		ON SC5.C5_FILIAL = SC9.C9_FILIAL "
        cQueryDTA += " 		   AND SC5.C5_NUM = SC9.C9_PEDIDO "
        cQueryDTA += " 		   AND SC5.C5_EMISSAO BETWEEN ? AND ? "
        cQueryDTA += " 		   AND SC5.C5_TIPO = ? "
        cQueryDTA += " 		   AND SC5.D_E_L_E_T_ = ? "
        cQueryDTA += " 	INNER JOIN " + RetSqlName( "SC6" ) + " SC6 "
        cQueryDTA += " 		ON SC6.C6_FILIAL = SC9.C9_FILIAL "
        cQueryDTA += " 		   AND SC6.C6_NUM = SC9.C9_PEDIDO "
        cQueryDTA += " 		   AND SC6.C6_ITEM = SC9.C9_ITEM "
        cQueryDTA += " 		   AND SC6.C6_PRODUTO = SC9.C9_PRODUTO "
        cQueryDTA += " 		   AND SC6.D_E_L_E_T_ = ? "
        cQueryDTA += " 	WHERE SC9.C9_FILIAL = ? "
        cQueryDTA += " 	AND SC9.C9_BLCRED <> ' ' "
        cQueryDTA += " 	AND SC9.C9_BLCRED <> '10' "
        cQueryDTA += " 	AND SC9.C9_BLEST = ' ' "
        cQueryDTA += " 	AND SC9.D_E_L_E_T_ = ? "
        if lProduct
            cQueryDTA += "AND SC6.C6_PRODUTO = ?  "
        EndIf
        cQueryDTA += " 	GROUP BY C5_FILIAL, C5_NUM "
        cQueryDTA += " ) AUX "

        cQueryDTA += " UNION ALL "
        
		// --Consulta de pedidos bloqueados por estoque
        cQueryDTA += " SELECT  "
        cQueryDTA += " 	'BLOQUEIO ESTOQUE' AS PED_STATUS, COUNT(C5_NUM) AS QUANT, ISNULL(SUM(C6_VALOR),0) AS VALOR "
        cQueryDTA += " FROM ( "
        cQueryDTA += " 	SELECT C5_FILIAL, C5_NUM, SUM(SC9.C9_QTDLIB * SC9.C9_PRCVEN) AS C6_VALOR "
        cQueryDTA += " 	FROM " + RetSqlName( "SC9" ) + " SC9 "
        cQueryDTA += " 	INNER JOIN " + RetSqlName( "SC5" ) + " SC5 "
        cQueryDTA += " 		ON SC5.C5_FILIAL = SC9.C9_FILIAL "
        cQueryDTA += " 		   AND SC5.C5_NUM = SC9.C9_PEDIDO "
        cQueryDTA += " 		   AND SC5.C5_EMISSAO BETWEEN ? AND ? "
        cQueryDTA += " 		   AND SC5.C5_TIPO = ? "
        cQueryDTA += " 		   AND SC5.D_E_L_E_T_ = ? "
        cQueryDTA += " 	INNER JOIN " + RetSqlName( "SC6" ) + " SC6 "
        cQueryDTA += " 		ON SC6.C6_FILIAL = SC9.C9_FILIAL "
        cQueryDTA += " 		   AND SC6.C6_NUM = SC9.C9_PEDIDO "
        cQueryDTA += " 		   AND SC6.C6_ITEM = SC9.C9_ITEM "
        cQueryDTA += " 		   AND SC6.C6_PRODUTO = SC9.C9_PRODUTO "
        cQueryDTA += " 		   AND SC6.D_E_L_E_T_ = ? "
        cQueryDTA += " 	WHERE SC9.C9_FILIAL = ? "
        cQueryDTA += " 	AND SC9.C9_BLCRED = ' ' "
        cQueryDTA += " 	AND SC9.C9_BLEST <> ' ' "
        cQueryDTA += " 	AND SC9.C9_BLEST <> '10' "
        cQueryDTA += " 	AND SC9.D_E_L_E_T_ = ? "
        if lProduct
            cQueryDTA += "AND SC6.C6_PRODUTO = ?  "
        EndIf
        cQueryDTA += " 	GROUP BY C5_FILIAL, C5_NUM "
        cQueryDTA += " ) AUX "

        cQueryDTA += " UNION ALL "
		
        // --Consulta de pedidos bloqueados por credito e estoque
        cQueryDTA += " SELECT  "
        cQueryDTA += " 	'BLOQUEIO CREDITO E ESTOQUE' AS PED_STATUS, COUNT(C5_NUM) AS QUANT, ISNULL(SUM(C6_VALOR),0) AS VALOR "
        cQueryDTA += " FROM ( "
        cQueryDTA += " 	SELECT C5_FILIAL, C5_NUM, SUM(SC9.C9_QTDLIB * SC9.C9_PRCVEN) AS C6_VALOR "
        cQueryDTA += " 	FROM " + RetSqlName( "SC9" ) + " SC9 "
        cQueryDTA += " 	INNER JOIN " + RetSqlName( "SC5" ) + " SC5 "
        cQueryDTA += " 		ON SC5.C5_FILIAL = SC9.C9_FILIAL "
        cQueryDTA += " 		   AND SC5.C5_NUM = SC9.C9_PEDIDO "
        cQueryDTA += " 		   AND SC5.C5_EMISSAO BETWEEN ? AND ? "
        cQueryDTA += " 		   AND SC5.C5_TIPO = ? "
        cQueryDTA += " 		   AND SC5.D_E_L_E_T_ = ? "
        cQueryDTA += " 	INNER JOIN " + RetSqlName( "SC6" ) + " SC6 "
        cQueryDTA += " 		ON SC6.C6_FILIAL = SC9.C9_FILIAL "
        cQueryDTA += " 		   AND SC6.C6_NUM = SC9.C9_PEDIDO "
        cQueryDTA += " 		   AND SC6.C6_ITEM = SC9.C9_ITEM "
        cQueryDTA += " 		   AND SC6.C6_PRODUTO = SC9.C9_PRODUTO "
        cQueryDTA += " 		   AND SC6.D_E_L_E_T_ = ? "
        cQueryDTA += " 	WHERE SC9.C9_FILIAL = ? "
        cQueryDTA += " 	AND SC9.C9_BLCRED <> ' ' "
        cQueryDTA += " 	AND SC9.C9_BLCRED <> '10' "
        cQueryDTA += " 	AND SC9.C9_BLEST <> ' ' "
        cQueryDTA += " 	AND SC9.C9_BLEST <> '10' "
        cQueryDTA += " 	AND SC9.D_E_L_E_T_ = ? "
        if lProduct
            cQueryDTA += "AND SC6.C6_PRODUTO = ?  "
        EndIf
        cQueryDTA += " 	GROUP BY C5_FILIAL, C5_NUM "
        cQueryDTA += " ) AUX "

    Case cQueryType == "detail"

        // SELECT - campos em comum
        cSelect  := "C5_FILIAL AS BRANCH, "
        cSelect  += "C5_NUM AS ORDER_NUMBER, "
        cSelect  += "C5_CLIENTE AS CUSTOMER, "
        cSelect  += "C5_LOJACLI AS CUSTOMER_STORE, "
        cSelect  += "A1_NOME AS CUSTOMER_NAME, "
        cSelect  += "A1_RISCO AS RISK, "
        cSelect  += "A1_LC AS CREDIT_LIMIT, "
        cSelect  += "A1_LCFIN AS CREDIT_LIMIT_FIN, "
        cSelect  += "C5_EMISSAO AS ISSUE_DATE, "
        cSelect  += "C5_CONDPAG AS PAYMENT_CONDITION, "
        cSelect  += "E4_DESCRI AS PAYMENT_DESCRIPTION, "
        cSelect  += "C5_TABELA AS PRICE_TABLE, "
        cSelect  += "ISNULL(DA0_DESCRI,'') AS PRICE_TABLE_DESCRIPTION, "
        cSelect  += "C5_VEND1 AS SALES_PERSON, "
        cSelect  += "ISNULL(A3_NOME,'') AS SALES_PERSON_NAME, "
        cSelect  += "COUNT(C5_NUM) AS COUNTER, "
        If cStatus $ "TOTAL|ABERTOS|BLOQUEADO POR REGRA|BLOQUEADO POR VERBA"
            cSelect += "SUM(C6_VALOR) AS TOTAL_VALUE"
        Else
            cSelect += "SUM(SC9.C9_QTDLIB * SC9.C9_PRCVEN) AS TOTAL_VALUE"
        EndIf

        // JOIN com tabelas complementares
        cInnerJoin := " INNER JOIN "+ RetSqlName("SA1") +" SA1 "
        cInnerJoin += "     ON SA1.A1_FILIAL = ? "
        cInnerJoin += "        AND SA1.A1_COD = SC5.C5_CLIENTE "
        cInnerJoin += "        AND SA1.A1_LOJA = SC5.C5_LOJACLI "
        cInnerJoin += "        AND SA1.D_E_L_E_T_ = ? "
        cInnerJoin += " INNER JOIN "+ RetSqlName("SE4") +" SE4 "
        cInnerJoin += "     ON SE4.E4_FILIAL = ? "
        cInnerJoin += "        AND SE4.E4_CODIGO = SC5.C5_CONDPAG "
        cInnerJoin += "        AND SE4.D_E_L_E_T_ = ? "
        cInnerJoin += " LEFT JOIN "+ RetSqlName("DA0") +" DA0 "
        cInnerJoin += "     ON DA0.DA0_FILIAL = ? "
        cInnerJoin += "        AND DA0.DA0_CODTAB = SC5.C5_TABELA "
        cInnerJoin += "        AND DA0.D_E_L_E_T_ = ? "
        cInnerJoin += " LEFT JOIN "+ RetSqlName("SA3") +" SA3 "
        cInnerJoin += "     ON SA3.A3_FILIAL = ? "
        cInnerJoin += "        AND SA3.A3_COD = SC5.C5_VEND1 "
        cInnerJoin += "        AND SA3.D_E_L_E_T_ = ? "

        // GROUP BY - campos em comum
        cGroupBy := "GROUP BY C5_FILIAL, C5_NUM, C5_CLIENTE, C5_LOJACLI, A1_NOME, A1_RISCO, A1_LC, A1_LCFIN, "
        cGroupBy += "C5_CONDPAG, E4_DESCRI, C5_TABELA, DA0_DESCRI, C5_EMISSAO, C5_VEND1, A3_NOME"

        If cStatus == "TOTAL"

            cQueryDTA += " SELECT "+ cSelect
            cQueryDTA += " FROM " + RetSqlName( "SC5" ) + " SC5 "
            cQueryDTA += " INNER JOIN " + RetSqlName( "SC6" ) + " SC6 "
            cQueryDTA += "     ON SC6.C6_FILIAL = SC5.C5_FILIAL "
            cQueryDTA += "        AND SC6.C6_NUM = SC5.C5_NUM "
            cQueryDTA += "        AND SC6.C6_CLI = SC5.C5_CLIENTE "
            cQueryDTA += "        AND SC6.C6_LOJA = SC5.C5_LOJACLI "
            cQueryDTA += "        AND SC6.D_E_L_E_T_ = ? "
            cQueryDTA += cInnerJoin
            cQueryDTA += " WHERE SC5.C5_FILIAL = ? "
            cQueryDTA += " AND SC5.C5_EMISSAO BETWEEN ? AND ? "
            cQueryDTA += " AND SC5.C5_TIPO = ? "
            cQueryDTA += " AND SC5.D_E_L_E_T_ = ? "
            if lProduct
                cQueryDTA += "AND SC6.C6_PRODUTO = ?  "
            EndIf
            cQueryDTA += cGroupBy
        
        ElseIf cStatus == 'ABERTOS'

            cQueryDTA += " SELECT "+ cSelect
            cQueryDTA += " FROM " + RetSqlName( "SC5" ) + " SC5 "
            cQueryDTA += " INNER JOIN " + RetSqlName( "SC6" ) + " SC6 "
            cQueryDTA += "     ON SC6.C6_FILIAL = SC5.C5_FILIAL "
            cQueryDTA += "        AND SC6.C6_NUM = SC5.C5_NUM "
            cQueryDTA += "        AND SC6.C6_CLI = SC5.C5_CLIENTE "
            cQueryDTA += "        AND SC6.C6_LOJA = SC5.C5_LOJACLI "
            cQueryDTA += "        AND SC6.D_E_L_E_T_ = ? "
            cQueryDTA += cInnerJoin
            cQueryDTA += " WHERE SC5.C5_FILIAL = ? "
            cQueryDTA += " AND SC5.C5_EMISSAO BETWEEN ? AND ? "
            cQueryDTA += " AND SC5.C5_TIPO = ? "
            cQueryDTA += " AND SC5.C5_LIBEROK = '' "
            cQueryDTA += " AND SC5.C5_NOTA = '' "
            cQueryDTA += " AND SC5.C5_BLQ = '' "
            cQueryDTA += " AND SC5.D_E_L_E_T_ = ? "
            if lProduct
                cQueryDTA += "AND SC6.C6_PRODUTO = ?  "
            EndIf
            cQueryDTA += cGroupBy

        ElseIf cStatus == 'FATURADOS'

            cQueryDTA += " SELECT "+ cSelect
            cQueryDTA += " FROM " + RetSqlName( "SC9" ) + " SC9 "
            cQueryDTA += " INNER JOIN " + RetSqlName( "SC5" ) + " SC5 "
            cQueryDTA += "     ON SC5.C5_FILIAL = SC9.C9_FILIAL "
            cQueryDTA += "        AND SC5.C5_NUM = SC9.C9_PEDIDO "
            cQueryDTA += "        AND SC5.C5_EMISSAO BETWEEN ? AND ? "
            cQueryDTA += "        AND SC5.C5_TIPO = ? "
            cQueryDTA += "        AND (SC5.C5_NOTA <> '' OR SC5.C5_LIBEROK = 'E') AND SC5.C5_BLQ = '' "
            cQueryDTA += "        AND SC5.D_E_L_E_T_ = ? "
            cQueryDTA += " INNER JOIN " + RetSqlName( "SC6" ) + " SC6 "
            cQueryDTA += "     ON SC6.C6_FILIAL = SC9.C9_FILIAL "
            cQueryDTA += "        AND SC6.C6_NUM = SC9.C9_PEDIDO "
            cQueryDTA += "        AND SC6.C6_ITEM = SC9.C9_ITEM "
            cQueryDTA += "        AND SC6.C6_PRODUTO = SC9.C9_PRODUTO "
            cQueryDTA += "        AND SC6.D_E_L_E_T_ = ? "
            cQueryDTA += cInnerJoin
            cQueryDTA += " WHERE SC9.C9_FILIAL = ? "
            cQueryDTA += " AND SC9.D_E_L_E_T_ = ? "
            if lProduct
                cQueryDTA += "AND SC6.C6_PRODUTO = ?  "
            EndIf
            cQueryDTA += cGroupBy

        ElseIf cStatus == 'FATURADOS PARCIAL'

            cQueryDTA += " SELECT "+ cSelect
            cQueryDTA += " FROM " + RetSqlName( "SC9" ) + " SC9 "
            cQueryDTA += " INNER JOIN " + RetSqlName( "SC5" ) + " SC5 "
            cQueryDTA += "     ON SC5.C5_FILIAL = SC9.C9_FILIAL "
            cQueryDTA += "        AND SC5.C5_NUM = SC9.C9_PEDIDO "
            cQueryDTA += "        AND SC5.C5_EMISSAO BETWEEN ? AND ? "
            cQueryDTA += "        AND SC5.C5_TIPO = ? "
            cQueryDTA += "        AND SC5.C5_NOTA = '' AND SC5.C5_LIBEROK = '' AND SC5.C5_BLQ = '' "
            cQueryDTA += "        AND SC5.D_E_L_E_T_ = ? "
            cQueryDTA += " INNER JOIN " + RetSqlName( "SC6" ) + " SC6 "
            cQueryDTA += "     ON SC6.C6_FILIAL = SC9.C9_FILIAL "
            cQueryDTA += "        AND SC6.C6_NUM = SC9.C9_PEDIDO "
            cQueryDTA += "        AND SC6.C6_ITEM = SC9.C9_ITEM "
            cQueryDTA += "        AND SC6.C6_PRODUTO = SC9.C9_PRODUTO "
            cQueryDTA += "        AND SC6.C6_QTDENT < SC6.C6_QTDVEN "
            cQueryDTA += "        AND SC6.C6_QTDENT > 0 "
            cQueryDTA += "        AND SC6.D_E_L_E_T_ = ? "
            cQueryDTA += cInnerJoin
            cQueryDTA += " WHERE SC9.C9_FILIAL = ? "
            cQueryDTA += " AND SC9.D_E_L_E_T_ = ? "
            if lProduct
                cQueryDTA += "AND SC6.C6_PRODUTO = ?  "
            EndIf
            cQueryDTA += cGroupBy

        ElseIf cStatus == 'LIBERADOS'

            cQueryDTA += " SELECT "+ cSelect
            cQueryDTA += " FROM " + RetSqlName( "SC9" ) + " SC9 "
            cQueryDTA += " INNER JOIN " + RetSqlName( "SC5" ) + " SC5 "
            cQueryDTA += "     ON SC5.C5_FILIAL = SC9.C9_FILIAL "
            cQueryDTA += "        AND SC5.C5_NUM = SC9.C9_PEDIDO "
            cQueryDTA += "        AND SC5.C5_EMISSAO BETWEEN ? AND ? "
            cQueryDTA += "        AND SC5.C5_TIPO = ? "
            cQueryDTA += "        AND SC5.C5_LIBEROK <> '' "
            cQueryDTA += "        AND SC5.C5_NOTA = '' "
            cQueryDTA += "        AND SC5.C5_BLQ = '' "
            cQueryDTA += "        AND SC5.D_E_L_E_T_ = ? "
            cQueryDTA += " INNER JOIN " + RetSqlName( "SC6" ) + " SC6 "
            cQueryDTA += "     ON SC6.C6_FILIAL = SC9.C9_FILIAL "
            cQueryDTA += "        AND SC6.C6_NUM = SC9.C9_PEDIDO "
            cQueryDTA += "        AND SC6.C6_ITEM = SC9.C9_ITEM "
            cQueryDTA += "        AND SC6.C6_PRODUTO = SC9.C9_PRODUTO "
            cQueryDTA += "        AND SC6.D_E_L_E_T_ = ? "
            cQueryDTA += cInnerJoin
            cQueryDTA += " WHERE SC9.C9_FILIAL = ? "
            cQueryDTA += " AND SC9.C9_BLCRED = ' ' "
            cQueryDTA += " AND SC9.C9_BLEST = ' ' "
            cQueryDTA += " AND SC9.C9_NFISCAL = ' ' "
            cQueryDTA += " AND SC9.D_E_L_E_T_ = ? "
            if lProduct
                cQueryDTA += "AND SC6.C6_PRODUTO = ?  "
            EndIf
            cQueryDTA += cGroupBy

        ElseIf cStatus == 'BLOQUEADO POR REGRA'
        
            cQueryDTA += " SELECT "+ cSelect
            cQueryDTA += " FROM " + RetSqlName( "SC5" ) + " SC5 "
            cQueryDTA += " INNER JOIN " + RetSqlName( "SC6" ) + " SC6 "
            cQueryDTA += "     ON SC6.C6_FILIAL = SC5.C5_FILIAL "
            cQueryDTA += "        AND SC6.C6_NUM = SC5.C5_NUM "
            cQueryDTA += "        AND SC6.C6_CLI = SC5.C5_CLIENTE "
            cQueryDTA += "        AND SC6.C6_LOJA = SC5.C5_LOJACLI "
            cQueryDTA += "        AND SC6.D_E_L_E_T_ = ? "
            cQueryDTA += cInnerJoin
            cQueryDTA += " WHERE SC5.C5_FILIAL = ? "
            cQueryDTA += " AND SC5.C5_EMISSAO BETWEEN ? AND ? "
            cQueryDTA += " AND SC5.C5_TIPO = ? "
            cQueryDTA += " AND SC5.C5_BLQ = '1' "
            cQueryDTA += " AND SC5.D_E_L_E_T_ = ? "
            if lProduct
                cQueryDTA += "AND SC6.C6_PRODUTO = ?  "
            EndIf
            cQueryDTA += cGroupBy

        ElseIf cStatus == 'BLOQUEADO POR VERBA'
        
            cQueryDTA += " SELECT "+ cSelect
            cQueryDTA += " FROM " + RetSqlName( "SC5" ) + " SC5 "
            cQueryDTA += " INNER JOIN " + RetSqlName( "SC6" ) + " SC6 "
            cQueryDTA += "     ON SC6.C6_FILIAL = SC5.C5_FILIAL "
            cQueryDTA += "        AND SC6.C6_NUM = SC5.C5_NUM "
            cQueryDTA += "        AND SC6.C6_CLI = SC5.C5_CLIENTE "
            cQueryDTA += "        AND SC6.C6_LOJA = SC5.C5_LOJACLI "
            cQueryDTA += "        AND SC6.D_E_L_E_T_ = ? "
            cQueryDTA += cInnerJoin
            cQueryDTA += " WHERE SC5.C5_FILIAL = ? "
            cQueryDTA += " AND SC5.C5_EMISSAO BETWEEN ? AND ? "
            cQueryDTA += " AND SC5.C5_TIPO = ? "
            cQueryDTA += " AND SC5.C5_BLQ = '2' "
            cQueryDTA += " AND SC5.D_E_L_E_T_ = ? "
            if lProduct
                cQueryDTA += "AND SC6.C6_PRODUTO = ?  "
            EndIf
            cQueryDTA += cGroupBy

        ElseIf cStatus == 'BLOQUEIO CREDITO'

            cQueryDTA += " SELECT "+ cSelect
            cQueryDTA += " FROM " + RetSqlName( "SC9" ) + " SC9 "
            cQueryDTA += " INNER JOIN " + RetSqlName( "SC5" ) + " SC5 "
            cQueryDTA += "     ON SC5.C5_FILIAL = SC9.C9_FILIAL "
            cQueryDTA += "        AND SC5.C5_NUM = SC9.C9_PEDIDO "
            cQueryDTA += "        AND SC5.C5_EMISSAO BETWEEN ? AND ? "
            cQueryDTA += "        AND SC5.C5_TIPO = ? "
            cQueryDTA += "        AND SC5.D_E_L_E_T_ = ? "
            cQueryDTA += " INNER JOIN " + RetSqlName( "SC6" ) + " SC6 "
            cQueryDTA += "     ON SC6.C6_FILIAL = SC9.C9_FILIAL "
            cQueryDTA += "        AND SC6.C6_NUM = SC9.C9_PEDIDO "
            cQueryDTA += "        AND SC6.C6_ITEM = SC9.C9_ITEM "
            cQueryDTA += "        AND SC6.C6_PRODUTO = SC9.C9_PRODUTO "
            cQueryDTA += "        AND SC6.D_E_L_E_T_ = ? "
            cQueryDTA += cInnerJoin
            cQueryDTA += " WHERE SC9.C9_FILIAL = ? "
            cQueryDTA += " AND SC9.C9_BLCRED <> ' ' "
            cQueryDTA += " AND SC9.C9_BLCRED <> '10' "
            cQueryDTA += " AND SC9.C9_BLEST = ' ' "
            cQueryDTA += " AND SC9.D_E_L_E_T_ = ? "
            if lProduct
                cQueryDTA += "AND SC6.C6_PRODUTO = ?  "
            EndIf
            cQueryDTA += cGroupBy

        ElseIf cStatus == 'BLOQUEIO ESTOQUE'
        
            cQueryDTA += " SELECT "+ cSelect
            cQueryDTA += " FROM " + RetSqlName( "SC9" ) + " SC9 "
            cQueryDTA += " INNER JOIN " + RetSqlName( "SC5" ) + " SC5 "
            cQueryDTA += "     ON SC5.C5_FILIAL = SC9.C9_FILIAL "
            cQueryDTA += "        AND SC5.C5_NUM = SC9.C9_PEDIDO "
            cQueryDTA += "        AND SC5.C5_EMISSAO BETWEEN ? AND ? "
            cQueryDTA += "        AND SC5.C5_TIPO = ? "
            cQueryDTA += "        AND SC5.D_E_L_E_T_ = ? "
            cQueryDTA += " INNER JOIN " + RetSqlName( "SC6" ) + " SC6 "
            cQueryDTA += "     ON SC6.C6_FILIAL = SC9.C9_FILIAL "
            cQueryDTA += "        AND SC6.C6_NUM = SC9.C9_PEDIDO "
            cQueryDTA += "        AND SC6.C6_ITEM = SC9.C9_ITEM "
            cQueryDTA += "        AND SC6.C6_PRODUTO = SC9.C9_PRODUTO "
            cQueryDTA += "        AND SC6.D_E_L_E_T_ = ? "
            cQueryDTA += cInnerJoin
            cQueryDTA += " WHERE SC9.C9_FILIAL = ? "
            cQueryDTA += " AND SC9.C9_BLCRED = ' ' "
            cQueryDTA += " AND SC9.C9_BLEST <> ' ' "
            cQueryDTA += " AND SC9.C9_BLEST <> '10' "
            cQueryDTA += " AND SC9.D_E_L_E_T_ = ? "
            if lProduct
                cQueryDTA += "AND SC6.C6_PRODUTO = ?  "
            EndIf
            cQueryDTA += cGroupBy

        ElseIf cStatus == 'BLOQUEIO CREDITO E ESTOQUE'
        
            cQueryDTA += " SELECT "+ cSelect
            cQueryDTA += " FROM " + RetSqlName( "SC9" ) + " SC9 "
            cQueryDTA += " INNER JOIN " + RetSqlName( "SC5" ) + " SC5 "
            cQueryDTA += "     ON SC5.C5_FILIAL = SC9.C9_FILIAL "
            cQueryDTA += "        AND SC5.C5_NUM = SC9.C9_PEDIDO "
            cQueryDTA += "        AND SC5.C5_EMISSAO BETWEEN ? AND ? "
            cQueryDTA += "        AND SC5.C5_TIPO = ? "
            cQueryDTA += "        AND SC5.D_E_L_E_T_ = ? "
            cQueryDTA += " INNER JOIN " + RetSqlName( "SC6" ) + " SC6 "
            cQueryDTA += "     ON SC6.C6_FILIAL = SC9.C9_FILIAL "
            cQueryDTA += "        AND SC6.C6_NUM = SC9.C9_PEDIDO "
            cQueryDTA += "        AND SC6.C6_ITEM = SC9.C9_ITEM "
            cQueryDTA += "        AND SC6.C6_PRODUTO = SC9.C9_PRODUTO "
            cQueryDTA += "        AND SC6.D_E_L_E_T_ = ? "
            cQueryDTA += cInnerJoin
            cQueryDTA += " WHERE SC9.C9_FILIAL = ? "
            cQueryDTA += " AND SC9.C9_BLCRED <> ' ' "
            cQueryDTA += " AND SC9.C9_BLCRED <> '10' "
            cQueryDTA += " AND SC9.C9_BLEST <> ' ' "
            cQueryDTA += " AND SC9.C9_BLEST <> '10' "
            cQueryDTA += " AND SC9.D_E_L_E_T_ = ? "
            if lProduct
                cQueryDTA += "AND SC6.C6_PRODUTO = ?  "
            EndIf
            cQueryDTA += cGroupBy
            
        EndIf

    Case cQueryType == "detailInfo"

        // SELECT - campos em comum
        cSelect  := "C6_FILIAL AS BRANCH, "
        cSelect  += "C6_NUM AS ORDER_NUMBER, "
        cSelect  += "C5_CLIENTE AS CUSTOMER, "
        cSelect  += "C5_LOJACLI AS CUSTOMER_STORE, "
        cSelect  += "A1_NOME AS CUSTOMER_NAME, "
        cSelect  += "C6_ITEM AS ITEM, "
        cSelect  += "C6_PRODUTO AS PRODUCT, "
        cSelect  += "C6_DESCRI AS PRODUCT_DESCRIPTION, "
        cSelect  += "C6_QTDVEN AS QUANTITY, "
        cSelect  += "C6_PRCVEN AS PRICE, "
        cSelect  += "C6_VALOR AS VALUE_TOTAL, "
        cSelect  += "ISNULL(B2_QATU, 0) AS STOCK "

        cQueryDTA += " SELECT "+ cSelect
        cQueryDTA += " FROM " + RetSqlName( "SC5" ) + " SC5 "
        cQueryDTA += " INNER JOIN " + RetSqlName( "SC6" ) + " SC6 "
        cQueryDTA += " 	ON SC6.C6_FILIAL = SC5.C5_FILIAL "
        cQueryDTA += " 	   AND SC6.C6_NUM = SC5.C5_NUM "
        cQueryDTA += " 	   AND SC6.C6_CLI = SC5.C5_CLIENTE "
        cQueryDTA += " 	   AND SC6.C6_LOJA = SC5.C5_LOJACLI "
        cQueryDTA += " 	   AND SC6.D_E_L_E_T_ = ? "
        cQueryDTA += " LEFT JOIN "+ RetSqlName("SB2") +" SB2 "
        cQueryDTA += " 	ON SB2.B2_FILIAL = ? "
        cQueryDTA += " 	   AND SB2.B2_COD = C6_PRODUTO "
        cQueryDTA += " 	   AND SB2.B2_LOCAL = C6_LOCAL "
        cQueryDTA += " 	   AND SB2.D_E_L_E_T_ = ? "
        cQueryDTA += " INNER JOIN "+ RetSqlName("SA1") +" SA1 "
        cQueryDTA += " 	ON SA1.A1_FILIAL = ? "
        cQueryDTA += " 	   AND SA1.A1_COD = SC5.C5_CLIENTE "
        cQueryDTA += " 	   AND SA1.A1_LOJA = SC5.C5_LOJACLI "
        cQueryDTA += " 	   AND SA1.D_E_L_E_T_ = ? "
        cQueryDTA += " WHERE SC5.C5_FILIAL = ? "
        cQueryDTA += " AND SC5.C5_NUM = ? "
        cQueryDTA += " AND SC5.C5_TIPO = ? "
        cQueryDTA += " AND SC5.D_E_L_E_T_ = ? "

    EndCase

Return cQueryDTA
