#include 'tlpp-core.th'
#include 'InsightDefs.ch'
#INCLUDE "PINSC010.CH"

#DEFINE LEVEL1 "L1"
#DEFINE LEVEL2 "L2"
#DEFINE ALL_LEVEL "L1|L2"

REGISTER INSIGHT sales_recommendation

Class sales_recommendation from PinsConfig
	Public Method New() CONSTRUCTOR
	Public Method Config()
	Public Method Struct()
	Public Method FromToMock()
	Public Method GetPhysicalFields()
	Public Method GetExtraFilters()
	Public Method BuildContractLine( oJson, aFields, lMock, cNextAlias )
EndClass

Method New() class sales_recommendation
	_Super:New( 'sales_recommendation', 'FAT' )
Return Self

Method Config() class sales_recommendation
    ::SetHasKey( .T. )
	::SetHasFilter( .T. )
	::SetPriority( .T. )

	::SetTagDateFrom("mdmCreated")
	::SetTagDateTo("expirationDate")
    ::SetKey( "key" )
Return

//-------------------------------------------------------------------
/*/{Protheus.doc} Struct
Indica os campos que fazem parte da tabela temporária e como estas 
informações serão tratadas.

A estrutura a ser definida deve ter a seguinte estrutura:
	[1] - nome da propriedade na mensagem ( campo I21_PAYLOD )
	[2] - estrutura de campo da tabela temporária
		[1] - Nome da coluna
		[2] - tipo
		[3] - tamanho
		[4] - decimal
	[3] - Indica se a coluna pode ser usada no filtro de pesquisa
	[4] - Nome da coluna para apresentar no Front
	[5] - Indica a ordem apresentada no browse
	[6] - Indica que a propriedade da mensagem contém uma chave composta
	[7] - Nível do campo 

@author  Marcia Junko
@since   02/06/2025
/*/
//-------------------------------------------------------------------
Method Struct() class sales_recommendation
	Local aStruct := {} as Array

	//Campos Contrato
	aadd(aStruct, {"customer"                 , {"customer"   , "C",  50, 0}, .F., 		  , , , LEVEL2	  })
	aadd(aStruct, {"customer_name"            , {"cust_nam"   , "C", 254, 0}, .F., STR0004, , , ALL_LEVEL })				// "Cliente"
	aadd(aStruct, {"federal_id"               , {"federal_id" , "C",  20, 0}, .F., STR0005, , , LEVEL1	  })				// "CNPJ"
	aadd(aStruct, {"sales_person"             , {"sales_per"  , "C",  50, 0}, .F., 		  , , , LEVEL2	  })
	aadd(aStruct, {"sales_person_name"        , {"pers_name"  , "C", 254, 0}, .F., STR0011, , , LEVEL2	  })				// "Vendedor"
	aadd(aStruct, {"product"                  , {"product"	  , "C",  50, 0}, .F., 		  , , , LEVEL2	  })
	aadd(aStruct, {"product_description"      , {"descrip"	  , "C", 254, 0}, .F., STR0007, , , LEVEL2	  })				// "Produto"
	aadd(aStruct, {"product_group"            , {"prod_grp"   , "C",  50, 0}, .F., 		  , , , LEVEL2	  })
	aadd(aStruct, {"product_group_description", {"grp_desc"   , "C", 254, 0}, .F., 		  , , , LEVEL2	  })
	aadd(aStruct, {"product_type"             , {"tpe"		  , "C",  50, 0}, .F., 		  , , , LEVEL2	  })
	//aadd(aStruct, {"product_type_description" , {"tp_desc"	  , "C", 254, 0}, .F., 		  , , , LEVEL2	  })
	aadd(aStruct, {"quantity"                 , {"quantity"   , "N",  17, 2}, .F., STR0009, , , LEVEL2	  })				// "Qtd. Sugerida"
	aadd(aStruct, {"potential_value"          , {"pot_vl" 	  , "N",  17, 2}, .F., STR0008, , , LEVEL2	  })				// "Valor"
	aadd(aStruct, {"rating"                   , {"rating"     , "N",   8, 4}, .F., 		  , , , LEVEL2	  })
	aadd(aStruct, {"recommendation_type"      , {"type_rec"   , "C",   3, 0}, .F., STR0019, , , LEVEL2	  })				// "Tipo de Recomendação"
	//Campos Específicos FATURAMENTO
	aadd(aStruct, {"branch"                   , {"branch"	  , "C",  20, 0}, .F., STR0001, , , ALL_LEVEL })				// "Filial"
	aadd(aStruct, {"control_number"           , {"ctrl_numb"  , "C",  36, 0}, .F., 		  , , , LEVEL2	  })
	aadd(aStruct, {"recnoI21"                 , {"recnoI21"   , "N",   9, 0}, .F., 		  , , , LEVEL2	  })
	aadd(aStruct, {"stock_quantity"           , {"stck_qtt"   , "N",  17, 2}, .F., STR0010, , , LEVEL2	  })				// "Qtd. em Estoque"
	aadd(aStruct, {"msg_status"               , {"msg_status" , "C",   3, 0}, .F., 		  , , , ALL_LEVEL })
	// //Campos específicos da tabela temporária
	// aba DISPONIVEIS
	aadd(aStruct, { ""						  , {"cust_code"  , "C",  50, 0}, .F., STR0002, , , ALL_LEVEL })				// "Código do Cliente"
	aadd(aStruct, { ""						  , {"cust_store" , "C",  50, 0}, .F., STR0003, , , ALL_LEVEL })				// "Loja do Cliente"
	aadd(aStruct, { ""						  , {"key_cust"   , "C", 254, 0}, .F., STR0020, STRUCT_INVISIBLE, , LEVEL1 })	// "Chave"
	aadd(aStruct, { ""						  , {"prod_code"  , "C",  50, 0}, .F., STR0006, , , LEVEL2	  })				// "Código do Produto"
	aadd(aStruct, { ""						  , {"sales_code" , "C",  50, 0}, .F., STR0006, , , LEVEL2	  })
	// aba GERADAS
	aadd(aStruct, { ""						  , {"order_numb" , "C",  50, 0}, .F., STR0013 }) 			// "Nº. do Pedido"
	aadd(aStruct, { ""						  , {"dt_create"  , "C",  50, 0}, .F., STR0014 }) 			// "Data da Geração"
	aadd(aStruct, { ""						  , {"user_gen"   , "C",  50, 0}, .F., STR0015 }) 			// "Gerado por"
	// aba DESCARTADAS		
	aadd(aStruct, { ""						  , {"dt_discard" , "C",  50, 0}, .F., STR0016 }) 			// "Data do Descarte"
	aadd(aStruct, { ""						  , {"user_dsc"   , "C",  50, 0}, .F., STR0017 }) 			// "Descartado por"
	aadd(aStruct, { ""						  , {"reason"     , "C", 254, 0}, .F., STR0018 })			// "Motivo"
	// Campo utilizado para mockar o número do pedido no JSON de resultado
	aadd(aStruct, { ""                        , {"mock_order" , "C",  50, 0}, .F.,  	   }) 			// "Mock Order"
	// Campo MEMO deve ser o último na struct
	aadd(aStruct, {"msg_result"               , {"msg_result" , "M",  10, 0}, .F., 		  , , , LEVEL2	  })

	aStruct := PINSDebugFields( aStruct )

	_Super:SetStruct( aStruct )

Return

//-----------------------------------------------------------------------------------------------------
/*/{Protheus.doc} FromToMock
Função  que retorna o De/Para Mock estrutura antiga x nova 
	
@return aPropMock, Array, Propriedades estrutura antiga x nova que devem ser utilizadas no Mock
O Retorno do De/Para tem a seguinte estrutura:
[1] - nome da propriedade na estrutura antiga 
[2] - nome da propriedade na estrutura nova

@author Victor Vieira 
@since 02/06/2026
/*/
//-----------------------------------------------------------------------------------------------------
Method FromToMock() class sales_recommendation
	Local aPropMock	as Array
	
	aPropMock	:= {}
	
	aadd(aPropMock, {"cust_nam" 	, "customer_name"				})
	aadd(aPropMock, {"sales_per" 	, "sales_person"				})
	aadd(aPropMock, {"pers_name"	, "sales_person_name"			})	
	aadd(aPropMock, {"descrip"		, "product_description"			})
	aadd(aPropMock, {"prod_grp" 	, "product_group" 				})
	aadd(aPropMock, {"grp_desc"  	, "product_group_description"	})
	aadd(aPropMock, {"tpe"			, "product_type" 				})
	aadd(aPropMock, {"tp_desc"		, "product_type_description" 	})
	aadd(aPropMock, {"pot_vl"		, "potential_value" 			})
	aadd(aPropMock, {"type_rec"		, "recommendation_type" 		})
	aadd(aPropMock, {"ctrl_numb"	, "control_number" 				})
	aadd(aPropMock, {"stck_qtt"		, "stock_quantity"				})
	aadd(aPropMock, {"cust_code"	, ""							})
	aadd(aPropMock, {"cust_store"	, ""							})
	aadd(aPropMock, {"key_cust"		, ""							})	
	aadd(aPropMock, {"prod_code"	, ""							})	
	aadd(aPropMock, {"sales_code"	, ""							})	
	aadd(aPropMock, {"order_numb"	, ""							})	
	aadd(aPropMock, {"dt_create"	, ""							})	
	aadd(aPropMock, {"user_gen"		, ""							})	
	aadd(aPropMock, {"dt_discard"	, ""							})	
	aadd(aPropMock, {"user_dsc"		, ""							})	
	aadd(aPropMock, {"reason"		, ""							})	
			
Return aPropMock

//-------------------------------------------------------------------
/*/{Protheus.doc} GetPhysicalFields
Sobrescreve o método de PinsConfig - indica as colunas físicas da
tabela I21 que o sales_recommendation precisa expor na query de
leitura montada por PINSGetAlerts, consumidas por BuildContractLine.

Os alias usa nome da propriedade da struct com os alias que
GetSelectJSON gera para as posições de aFields cuja propriedade JSON
não existe no payload (branch, control_number, recnoI21, msg_status,
msg_result geram coluna '' AS <ALIAS> - mesmo alias que a coluna física).

@return array, Vetor de pares { <expressão SQL>, <alias da coluna> }.

@author  Lucas Lima
@since   03/08/2026
/*/
//-------------------------------------------------------------------
Method GetPhysicalFields() class sales_recommendation
	Local aFields := {}

	Aadd( aFields, { "I21_BRANCH"	 , "branch"		} )
	Aadd( aFields, { "I21_UIDINS"	 , "ctrl_numb"	} )
	Aadd( aFields, { "I21.R_E_C_N_O_", "recnoI21"	} )
	Aadd( aFields, { "' '"			 , "stck_qtt"	} )
	Aadd( aFields, { "I21_STATUS"	 , "msg_status" } )
	Aadd( aFields, { "I21_RESULT"	 , "msg_result"	} )

Return aFields

//-------------------------------------------------------------------
/*/{Protheus.doc} GetExtraFilters
Sobrescreve o método de PinsConfig - indica o filtro de vigência
que o sales_recommendation exige na query montada por PINSGetAlerts,
além dos filtros padrão (insight, módulo, filial, D_E_L_E_T_).

@return array, Vetor de pares { <predicado SQL com bind '?'>, <valor do bind> }.

@author  Lucas Lima
@since   03/08/2026
/*/
//-------------------------------------------------------------------
Method GetExtraFilters() class sales_recommendation
	Local aFilters := {}

	Aadd( aFilters, { "I21.I21_DTATE >= ?", DToS( Date() ) } )

Return aFilters

//-------------------------------------------------------------------
/*/{Protheus.doc} BuildContractLine
Sobrescreve o método de PinsConfig - monta as 33 colunas da tabela
temporária do sales_recommendation numa única passada, substituindo
por completo a Function PINSAlertLine pública (PINSAlerts.prw), cujo
modelo posicional (uma coluna por posição de aFields, lida diretamente
do alias/JSON) não comporta as colunas físicas e derivadas específicas
de Faturamento sem quebrar o alinhamento das 33 posições.

Regra de negócio alinhada a stock_out/demand_forecast nesta integração:
se o produto (customer/product code) não existir em SB1, a linha é
descartada (retorna {}) - antes o modo mock sempre gravava a linha
independente da existência em SB1.

@param oJson, objeto, JSON da linha de mock em memória (modo mock, lMock == .T.).
@param aFields, array, Campos do struct do insight (não usado diretamente aqui,
	mantido por assinatura do hook em PinsConfig).
@param lMock, lógico, Indica se a chamada é do fluxo de mock (.T.) ou produção (.F.).
@param cNextAlias, caracter, Alias da query aberta por PINSGetAlerts (modo produção),
	contendo as 15 colunas de contrato extraídas via SQL (GetSelectJSON) mais
	BRANCH e as 5 colunas de GetPhysicalFields (BRANCH, CTRL_NUMB, RECNOI21, MSG_STATUS, MSG_RESULT).

@return array, Vetor com os 33 valores na ordem de Method Struct(), ou {} se
	o produto não existir em SB1 (linha descartada).

@author  Lucas Lima
@since   03/08/2026
/*/
//-------------------------------------------------------------------
Method BuildContractLine( oJson, aFields, lMock, cNextAlias ) class sales_recommendation
	Local oResult       as Object
	Local aRet          := {} as Array
	Local aAux          := {} as Array
	Local cCustomerRaw  := "" as character
	Local cProductRaw   := "" as character
	Local cSalesPerRaw  := "" as character
	Local cBranchProd   := "" as character
	Local cProduct      := "" as character
	Local cResultJson   := "" as character
	Local nSaldo        := 0 as numeric
	Local nQuantity     := 0 as numeric
	Local nPotVl        := 0 as numeric
	Local nRating       := 0 as numeric

	Default lMock := .F.

	If lMock
		cCustomerRaw := AllTrim( DecodeUTF8( oJson[ 'customer' ] ) )
		cProductRaw  := AllTrim( DecodeUTF8( oJson[ 'product' ] ) )
		cSalesPerRaw := AllTrim( DecodeUTF8( oJson[ 'sales_person' ] ) )
	Else
		cCustomerRaw := AllTrim( DecodeUTF8( ( cNextAlias )->CUSTOMER ) )
		cProductRaw  := AllTrim( DecodeUTF8( ( cNextAlias )->PRODUCT ) )
		cSalesPerRaw := AllTrim( DecodeUTF8( ( cNextAlias )->SALES_PER ) )
	EndIf

	// Localiza o produto em SB1 - descarta a linha se nao existir no cadastro
	// (alinha o comportamento do sales com stock_out/demand_forecast nesta integracao)
	aAux        := StrTokArr2( cProductRaw, '|', .T. )
	cBranchProd := PadR( aAux[ 1 ], TamSX3( "B1_FILIAL" )[1] )
	cProduct    := PadR( aAux[ 2 ], TamSX3( "B1_COD" )[1] )

	If SB1->( MsSeek( cBranchProd + cProduct ) )

		If SB2->( MsSeek( FWxFilial( 'SB2' ) + SB1->B1_COD + SB1->B1_LOCPAD ) )
			nSaldo := SaldoSB2( , .F. )
		EndIf

		// Campos de contrato (posicoes 1-15)
		If lMock
			nQuantity := If( ValType( oJson[ 'quantity' ] ) == "N", oJson[ 'quantity' ], 0 )
			nPotVl    := If( ValType( oJson[ 'potential_value' ] ) == "N", oJson[ 'potential_value' ], 0 )
			nRating   := If( ValType( oJson[ 'rating' ] ) == "N", oJson[ 'rating' ], 0 )

			Aadd( aRet, cCustomerRaw )
			Aadd( aRet, AllTrim( DecodeUTF8( oJson[ 'customer_name' ] ) ) )
			Aadd( aRet, AllTrim( DecodeUTF8( oJson[ 'federal_id' ] ) ) )
			Aadd( aRet, cSalesPerRaw )
			Aadd( aRet, AllTrim( DecodeUTF8( oJson[ 'sales_person_name' ] ) ) )
			Aadd( aRet, cProductRaw )
			Aadd( aRet, AllTrim( DecodeUTF8( oJson[ 'product_description' ] ) ) )
			Aadd( aRet, AllTrim( DecodeUTF8( oJson[ 'product_group' ] ) ) )
			Aadd( aRet, AllTrim( DecodeUTF8( oJson[ 'product_group_description' ] ) ) )
			Aadd( aRet, AllTrim( DecodeUTF8( oJson[ 'product_type' ] ) ) )
			//Aadd( aRet, AllTrim( DecodeUTF8( oJson[ 'product_type_description' ] ) ) )
			Aadd( aRet, nQuantity )
			Aadd( aRet, nPotVl )
			Aadd( aRet, nRating )
			Aadd( aRet, AllTrim( DecodeUTF8( oJson[ 'recommendation_type' ] ) ) )
		Else
			Aadd( aRet, cCustomerRaw )
			Aadd( aRet, AllTrim( DecodeUTF8( ( cNextAlias )->CUST_NAM ) ) )
			Aadd( aRet, AllTrim( DecodeUTF8( ( cNextAlias )->FEDERAL_ID ) ) )
			Aadd( aRet, cSalesPerRaw )
			Aadd( aRet, AllTrim( DecodeUTF8( ( cNextAlias )->PERS_NAME ) ) )
			Aadd( aRet, cProductRaw )
			Aadd( aRet, AllTrim( DecodeUTF8( ( cNextAlias )->DESCRIP ) ) )
			Aadd( aRet, AllTrim( DecodeUTF8( ( cNextAlias )->PROD_GRP ) ) )
			Aadd( aRet, AllTrim( DecodeUTF8( ( cNextAlias )->GRP_DESC ) ) ) 
			Aadd( aRet, AllTrim( DecodeUTF8( ( cNextAlias )->TPE ) ) )
			//Aadd( aRet, AllTrim( DecodeUTF8( ( cNextAlias )->TP_DESC ) ) )
			Aadd( aRet, Val( ( cNextAlias )->QUANTITY ) )
			Aadd( aRet, Val( ( cNextAlias )->POT_VL ) )
			Aadd( aRet, Val( ( cNextAlias )->RATING ) )
			Aadd( aRet, AllTrim( DecodeUTF8( ( cNextAlias )->TYPE_REC ) ) )
		EndIf

		// Campos fisicos/FAT (posicoes 16-20)
		If lMock
			Aadd( aRet, AllTrim( oJson[ 'branch' ] ) )
			Aadd( aRet, FWUUIDV1( .T. ) )
			Aadd( aRet, 1 )
			Aadd( aRet, nSaldo )
			Aadd( aRet, '' )

			cResultJson  := '{}'		
		Else
			Aadd( aRet, AllTrim( ( cNextAlias )->BRANCH ) )
			Aadd( aRet, AllTrim( ( cNextAlias )->CTRL_NUMB ) )
			Aadd( aRet, ( cNextAlias )->RECNOI21 )
			Aadd( aRet, nSaldo )
			Aadd( aRet, AllTrim( ( cNextAlias )->MSG_STATUS ) )

			cResultJson  := AllTrim( DecodeUTF8( ( cNextAlias )->MSG_RESULT ) )
		EndIf

		// Derivados de chave composta (posicoes 21-25)
		aAux := StrTokArr2( cCustomerRaw, '|', .T. )
		Aadd( aRet, aAux[ 2 ] )		// codigo do cliente
		Aadd( aRet, aAux[ 3 ] )		// loja do cliente
		// chave breadcrumb
		Aadd( aRet, aAux[ 1 ] + " | " + aAux[ 2 ] + " | " + aAux[ 3 ] +;
					" - " + AllTrim( DecodeUTF8( If( lMock, oJson[ 'customer_name' ], ( cNextAlias )->CUST_NAM ) ) ) )
		Aadd( aRet, cProduct )		// produto 

		If !Empty( cSalesPerRaw )
			aAux := StrTokArr2( cSalesPerRaw, '|', .T. )
			Aadd( aRet, aAux[ 2 ] )
		Else
			Aadd( aRet, "" )
		EndIf

		// Derivados de I21_RESULT (posicoes 26-31)
		oResult := JsonObject():New()
		oResult:FromJson( cResultJson )

		AddResultInfo( @aRet, "orderNumber" , oResult )
		AddResultInfo( @aRet, "createdDate" , oResult )
		AddResultInfo( @aRet, "userName"	, oResult )
		AddResultInfo( @aRet, "discardDate" , oResult )
		AddResultInfo( @aRet, "userName"	, oResult )
		AddResultInfo( @aRet, "message"		, oResult )

		// mock_order (posicao 32)
		// memo MSG_RESULT/I21_RESULT (posicao 33)
		If lMock
			Aadd( aRet, AllTrim( oJson[ 'mock_order' ] ) )
			Aadd( aRet, cResultJson )
		Else
			Aadd( aRet, "" )
			Aadd( aRet, cResultJson )	// campo memo I21_RESULT localizado no final da struct
		EndIf

		FreeObj( oResult )
	EndIf

	FWFreeArray( aAux )
Return aRet

//-------------------------------------------------------------------
/*/{Protheus.doc} AddResultInfo
Função auxiliar de BuildExtraLine que alimenta uma posição do array
de retorno de acordo com a propriedade pesquisada no JSON de
I21_RESULT (oJsonResult). Replica localmente a lógica de SetResultInfo
(PINSC010.prw) pois functions Static não são visíveis entre fontes.

@param aLinTab, array, vetor com os valores que serão retornados por
	BuildExtraLine, onde cada posição representa uma coluna.
@param cPropertie, character, nome da propriedade do objeto JSON a ser pesquisado.
@param oJsonResult, json, objeto com o conteúdo do campo I21_RESULT.

@author  Lucas Lima
@since   03/08/2026
/*/
//-------------------------------------------------------------------
Static Function AddResultInfo( aLinTab, cPropertie, oJsonResult )
	Local cDate as Character
	Local cAux  as Character

	If oJsonResult:HasProperty( cPropertie ) .And. !Empty( oJsonResult[ cPropertie ] )
		If cPropertie $ "createdDate|discardDate"
			cAux := oJsonResult[ cPropertie ]
			cAux := StrTran( cAux, "/", "" )
			cDate := Dtoc( STod( cAux ) )
			Aadd( aLinTab, cDate )
		Else
			Aadd( aLinTab, oJsonResult[ cPropertie ] )
		EndIf
	Else
		Aadd( aLinTab, "" )
	EndIf
Return
