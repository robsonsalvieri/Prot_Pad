#include "totvs.ch"
#include "tlpp-core.th"
#include "BACKOFFICE.BA.INSIGHTS.INSIGHTSCHEDPROCESS.CH"

NAMESPACE totvs.protheus.backoffice.ba.insights

//------------------------------------------------------------------------------
/*/{Protheus.doc} InsightSchedProcess
Executa o processamento agendado de Insights não prioritários para um grupo de empresas.
@param aParams, array, Array de parâmetros: 
    [1] Empresa do agendamento
    [2] Grupo de empresas para execução do agendamento
    [3] Filial de execução do agendamento
    [4] Código do usuário que executou o agendamento
    [5] Código do job que executou o agendamento

@type function
@return lExec, Logical, indica se o processamento foi executado com sucesso
@author Squad BA
@since 18/10/2024
@obs Função utilizada pelo agendador de tarefas (Scheduler) do Protheus.
/*/
//------------------------------------------------------------------------------
Function InsightSchedProcess(aParams As Array)

    Local cCompanyGroup := ""   As Character
    Local cBranchExec := ""     As Character
    Local cQuery := ""          As Character
    Local cAliasQueue := ""     As Character
    Local cLockName := ""       As Character
    Local oException            As Object
    Local oInsightProcessor     As Object
    Local oStatement            As Object
    Local nStart := Seconds()   As Numeric
    Local lOpenEnv := .F.       As Logical
    Local nBranchSize := 0      As Numeric
    Local lLocked := .F.        As Logical
    
    oException := ErrorClass():New()
    
    // Estrutura do agendamento está desatualizado, por isso não será executado.
    If len( aParams ) < 5 .Or. ValType( aParams[2] ) != "C" .Or. Empty( aParams[2] )
        Return .F.
    EndIf
    
    Try
        cCompanyGroup := aParams[2]
        cBranchExec := aParams[3]
        cLockName := "INSIGHTSCHEDPROCESS_" + cCompanyGroup

        RpcSetType(3)
        lOpenEnv := RpcSetEnv(cCompanyGroup,cBranchExec,,, "FIN",, , /*lShowFinal*/, /*lAbend*/, /*lOpenSX*/, /*lConnect*/)
        
        If lOpenEnv .And. LockByName( cLockName, .T., .F. )
            lLocked := .T.

            FwLogMsg("INFO", Nil, "ProtheusInsights", "InsightSchedProcess", Nil, "", "InsightSchedProcess: " + STR0001, Nil, Seconds() - nStart,; //"Execução de insights agendados iniciado"
                {;
                    {"Message", "InsightSchedProcess: " + STR0001 },;   //"Execução de insights agendados iniciado"
                    {"CompanyGroup", cCompanyGroup};
                })


            If FWAliasInDic( "I19" ) .And. FWAliasInDic( "I20" ) .And. FWAliasInDic( "I21" )
                cAliasQueue := GetNextAlias() 
            	nBranchSize := FWSizeFilial()
            	
                cQuery := " SELECT I19.I19_UIDMSG " + ;
                    " FROM ? I19 " + ;
                    " INNER JOIN ? I20 " + ;
                        " ON I20.I20_FILIAL = ? " + ;
                        " AND I20.I20_INSIGT = I19.I19_INSIGT " + ;
                        " AND I20.I20_STATUS = ? " + ;
                        " AND I20.I20_PRIORI = ?" + ;
                        " AND I20.D_E_L_E_T_ = ? " + ;
                    " WHERE I19.I19_FILIAL = ? " + ;
                        " AND ( I19.I19_STPROC = ? OR I19.I19_DTSCHD = ? ) " + ;
                        " AND I19.D_E_L_E_T_ = ? " + ;
                    " ORDER BY I19.I19_DTRECV "

                cQuery := ChangeQuery( cQuery )
                oStatement := FwExecStatement():New( cQuery )
                oStatement:SetUnSafe( 1, RetSqlName( "I19" ))
                oStatement:SetUnSafe( 2, RetSqlName( "I20" ))
                oStatement:SetString( 3, Space( nBranchSize ) )
                oStatement:SetString( 4, '1' )
                oStatement:SetString( 5, 'F' )
                oStatement:SetString( 6, ' ' )
                oStatement:SetString( 7, Space( nBranchSize ) )
                oStatement:SetString( 8, 'SCH' )
                oStatement:SetString( 9, ' ' )
                oStatement:SetString( 10, ' ' )
                
                oStatement:OpenAlias( cAliasQueue )

                While  ( cAliasQueue )->( !EOF() ) 
                    
                    FwLogMsg("INFO", Nil, "ProtheusInsights", "InsightSchedProcess", Nil, "", "InsightSchedProcess: " + STR0002, Nil, Seconds() - nStart,;  //"Processamento do Insight iniciado"
                        {;
                            {"Message", "InsightSchedProcess: " + STR0002 },; //"Processamento de Insight iniciado"
                            {"MessageId", (cAliasQueue)->I19_UIDMSG};
                        })

                    oInsightProcessor := InsightsProcessor():New()
                    
                    oInsightProcessor:ProcessMessage((cAliasQueue)->I19_UIDMSG)
                    
                    FwLogMsg("INFO", Nil, "ProtheusInsights", "InsightSchedProcess", Nil, "", "InsightSchedProcess: " + STR0003 , Nil, Seconds() - nStart,;     //"Processamento do Insight finalizado"
                        {;
                            {"Message", "InsightSchedProcess: " + STR0003 },;   //"Processamento de Insight finalizado"
                            {"MessageId", (cAliasQueue)->I19_UIDMSG};
                        })

                    (cAliasQueue)->(DbSkip())
                    
                    FreeObj( oInsightProcessor )
                EndDo
            EndIf
        EndIf
    Catch oException
        FwLogMsg("ERROR", Nil, "ProtheusInsights", "InsightSchedProcess", Nil, "", "InsightSchedProcess: " + STR0004 , Nil, Seconds() - nStart,;     //"Processamento do insight abortado com exceção"
            {;
                {"Message", "InsightSchedProcess: " + STR0004 },;   //"Processamento do insight abortado com exceção"
                {"CompanyGroup", cCompanyGroup},;
                {"ErrorCode", oException:genCode},;
                {"ErrorMessage", oException:description};
            })

    Finally
        If !Empty( cAliasQueue ) .And. Select( cAliasQueue ) > 0
            ( cAliasQueue )->( DbCloseArea() )
        EndIf

        FwLogMsg("INFO", Nil, "ProtheusInsights", "InsightSchedProcess", Nil, "", "InsightSchedProcess: " + STR0005, Nil, Seconds() - nStart,;   //"Execução dos insights agendados finalizado"
            {;
                {"Message", "InsightSchedProcess: " + STR0005 },;   //"Execução dos insights agendados finalizado"
                {"CompanyGroup", cCompanyGroup};
            })

        If lLocked
            UnLockByName( cLockName, .T., .F. )
        EndIf

        If lOpenEnv
            RpcClearEnv()
        EndIf    

        If oStatement != Nil
            oStatement:Destroy()
        EndIf

        If oException != Nil
            FreeObj( oException )
        EndIf

    EndTry
    
Return
