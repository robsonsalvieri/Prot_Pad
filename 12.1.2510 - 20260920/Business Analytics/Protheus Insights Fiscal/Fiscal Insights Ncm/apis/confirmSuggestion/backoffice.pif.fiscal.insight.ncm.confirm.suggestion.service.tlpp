#include "tlpp-core.th"
#include "tlpp-rest.th"

namespace totvs.protheus.backoffice.pif.fiscal.insight.ncm
using namespace totvs.protheus.backoffice.pif.util


//------------------------------------------------------------------------------
/* {Protheus.doc} ConfirmSuggestionService
    Classe de serviços do ConfirmSuggestion

    @type Class
    @author Squad PIF
    @return Nil
/*/
//------------------------------------------------------------------------------
Class ConfirmSuggestionService 

    Public Method New() Constructor
    Public Method postConfirmSuggestion() As Json
    Public Method getAdjusteds() As Json    
EndClass

//------------------------------------------------------------------------------
/* {Protheus.doc} new
    Metodo construtor

    @type Method
    @author Squad PIF
    @return Object, retorna o objeto criado
*/
//------------------------------------------------------------------------------
Method New() Class ConfirmSuggestionService
Return Self

//------------------------------------------------------------------------------
/* {Protheus.doc} postConfirmSuggestion
    Responsável por chamar a confirmação da sugestão de NCM

    @type Method
    @author Squad PIF
    @return Json, retorna o objeto json contendo o resultado da confirmação da sugestão de NCM
*/
//------------------------------------------------------------------------------
Method postConfirmSuggestion(JBody As Json) As Json Class ConfirmSuggestionService

    Local jResponse                  As Json
    Local oConfirmSuggestionData     As Object

    jResponse := JsonObject():New()
    
    oConfirmSuggestionData := ConfirmSuggestionData():New()

    jResponse := oConfirmSuggestionData:postConfirmSuggestion(JBody)

    FWFreeObj(oConfirmSuggestionData)

Return jResponse

//------------------------------------------------------------------------------
/* {Protheus.doc} getAdjusteds
    Método responsável por consultar as sugestões aceitas de Ncm 
    
    @author Squad PIF
    @version 1.0
    @param nPage, Numeric, Número da página a ser retornada
    @param nPageSize, Numeric, Tamanho da página a ser retornada
    @param cFilter, Character, Filtro a ser aplicado na consulta
    @param cTempTable, Character, Alias da tabela temporária
    @return Json, retorna o objeto json com as sugestões confirmadas de NCM
*/
//------------------------------------------------------------------------------
Method getAdjusteds(nPage as Numeric, nPageSize as Numeric, cFilter as character, cTempTable as character) As Json Class ConfirmSuggestionService
    Local jResponse               := JsonObject():New()            As Json
    Local oConfirmSuggestionData  := ConfirmSuggestionData():New() As Object
    Local oError                  := ErrorClass():New()            As Object

    oConfirmSuggestionData:getAdjusteds(nPage, nPageSize, cFilter, cTempTable)

    oError:genCode     := oConfirmSuggestionData:getCode()
    oError:description := oConfirmSuggestionData:getMessage()

    jResponse := getBadRequestResponse({oError})

    If oConfirmSuggestionData:lOk
        jResponse:FromJson(oConfirmSuggestionData:getJSONResponse())
        jResponse :=  getSuccessReponse(oConfirmSuggestionData:formatAdjusteds(jResponse))
    EndIf

    oConfirmSuggestionData:DeActivate()
    FWFreeObj(oConfirmSuggestionData)

Return jResponse


