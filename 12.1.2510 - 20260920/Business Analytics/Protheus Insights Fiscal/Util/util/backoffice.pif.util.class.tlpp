#include "tlpp-core.th" 

namespace totvs.protheus.backoffice.pif.util

//-------------------------------------------------------------------
/*/{Protheus.doc} TestWebChannel
	Simula TWebChannel sem interface

    @type Class
    @author Squad PIF
    @return Nil
/*/
//-------------------------------------------------------------------
Class TestWebChannel
	Public Data cType      As Character
	Public Data cContent   As Character
    Public Data lAssertion As Logical

	Public Method New()
	Public Method AdvplToJs()
EndClass

//------------------------------------------------------------------------------
/* {Protheus.doc} New
    Metodo construtor

    @type Method
    @author Squad PIF
    @return Object, retorna o objeto criado
*/
//------------------------------------------------------------------------------
Method New() Class TestWebChannel
    ::cType      := ""
	::cContent   := ""
    ::lAssertion := .F.
Return Self

//------------------------------------------------------------------------------
/* {Protheus.doc} AdvplToJs
    Método responsável por simular o comportamento do método advpltoJs do TWebchannel

    @type Method
    @author Squad PIF
	@params cType, character, Tipo
    @params cContent, character, Conteúdo
    @return Nil
*/
//------------------------------------------------------------------------------
Method AdvplToJs(cType As Character, cContent As Character) Class TestWebChannel
    If !Empty( cType )
	    ::cType      := cType
	    ::cContent   := cContent
        ::lAssertion := .T.
    EndIf
Return Self

//-------------------------------------------------------------------
/*/{Protheus.doc} SimulGetDados
	Simula os atributos e métodos do MsNewGetDados

    @type Class
    @author Squad PIF
    @return Nil
/*/
//-------------------------------------------------------------------
Class SimulGetDados
    Public Data nAt     As Numeric
    Public Data aCols   As Numeric
    Public Data aHeader As Numeric
    Public Data oBrowse As Object

	Public Method New()
	Public Method Refresh()
EndClass

//------------------------------------------------------------------------------
/* {Protheus.doc} New
    Metodo construtor

    @type Method
    @author Squad PIF
    @return Object, retorna o objeto criado
*/
//------------------------------------------------------------------------------
Method New() Class SimulGetDados
    ::nAt     := 0
    ::aCols   := {}
    ::aHeader := {}
    ::oBrowse := SimulBrowse():New()
Return Self

//------------------------------------------------------------------------------
/* {Protheus.doc} Refresh
    Metodo responsável por simular o comportamento do método Refresh do MsGetDados

    @type Method
    @author Squad PIF
    @return Object, retorna o objeto criado
*/
//------------------------------------------------------------------------------
Method Refresh() Class SimulGetDados
Return Self


