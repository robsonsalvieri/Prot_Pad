#Include 'Totvs.ch'
#include 'tlpp-core.th'
#include 'backoffice.stock.averagecost.eai.ch'

using namespace totvs.protheus.backoffice.stock.iterativecost.processing.threads

namespace totvs.protheus.backoffice.stock.averagecost.eai

#Define THIS 'totvs.protheus.backoffice.stock.averagecost.eai.'

//-------------------------------------------------------------------
/*/{Protheus.doc} MAEnvInteg()
Envia para IntegDef
@author Leonardo Quintania
@since 01/05/2014
@version 1.0
@return NIL
/*/
//-------------------------------------------------------------------
Function MAEnvInteg(aFilsCalc As Array, dInicio As Date, dFim As Date, nApropri As Numeric)
	Local cQuery 	  As Character
	Local cAliasTemp  As Character
	Local cFilAtu     As Character
	Local cMsg        As Character
	Local oQuery      As Object
	Local oThrManager As Object
	Local nFil        As Integer
	Local nBind       As Integer
	Local nQtdItens   As Integer
	Local nQtdThr     As Integer
	Local nTamCC      As Integer
	Local cError      As Character
	Local lRet        As Logical
	Local lI330FSM    As Logical
	Local cUUID       As Character
    Local aThread     As Array

	nTamCC   := TamSx3('B1_CCCUSTO')[1] 
	lI330FSM := SuperGetMV("MV_I330FSM",.F.,.F.)
	cUUID    := FWUUIDV4(.T.)

	cMsg := STR0001 //"Iniciando integração do Adapter EAI MATA330"
	M330PrcLog("MENSAGEM", I18N(cMsg), I18N(cMsg))
	
	oThrManager := ThreadManager():New(2, "MATI330"+cEmpAnt, cUUID)

	lRet := oThrManager:Prepare()
    If !lRet
        //Gravar log e finalizar
        cMsg := STR0002 //"Falha ao preparar threads EAI MATA330"
	    M330PrcLog("MENSAGEM", I18N(cMsg), I18N(oThrManager:GetError()))
		UserException(oThrManager:GetError())
    EndIf

	If oQuery == Nil
		cQuery := " Select SB2.B2_FILIAL,"
		cQuery += " 	   SB2.B2_COD"
		cQuery += " From " + RetSqlName("SB2") + " SB2 "
		cQuery += " Inner Join " + RetSqlName("SB1") + " SB1 "
		cQuery += "      On SB1.B1_FILIAL  = ? "
		cQuery += "     And SB1.B1_COD     = SB2.B2_COD"
		cQuery += "     And SB1.B1_CCCUSTO = ? "
		cQuery += "     And SB1.B1_COD Not Like ? "
		cQuery += "     And SB1.D_E_L_E_T_ = ? "
		cQuery += "   Where SB2.B2_FILIAL  = ? "
		cQuery += "     And SB2.D_E_L_E_T_ = ? "
		//Parametro para filtrar produtos sem movimentação no período do recálculo
		If lI330FSM
			cQuery += " And (" 
			cQuery += "      Exists (Select 1 " 
			cQuery += "         From "+RetSqlName('SD1')+" SD1 "
			cQuery += "         Inner Join "+RetSqlName('SF4')+" SF4 "
			cQuery += "                 On SF4.F4_FILIAL  = ? "
			cQuery += "                And SF4.F4_CODIGO  = SD1.D1_TES "
			cQuery += "                And SF4.F4_ESTOQUE = ? "
			cQuery += "                And SF4.D_E_L_E_T_ = ? "
			//Indice 7 - D1_FILIAL+D1_COD+D1_LOCAL+DTOS(D1_DTDIGIT)+D1_NUMSEQ
			cQuery += "              Where SD1.D1_FILIAL = ? "
			cQuery += "                And SD1.D1_COD    = SB2.B2_COD "
			cQuery += "                And SD1.D1_LOCAL  = SB2.B2_LOCAL "
			cQuery += "                And SD1.D1_DTDIGIT Between ? And ? "
			cQuery += "                And SD1.D_E_L_E_T_ = ? "
			cQuery += "              ) "
			cQuery += "  Or  Exists (Select 1 " 
			cQuery += "         From "+RetSqlName('SD2')+" SD2 "
			cQuery += "         Inner Join "+RetSqlName('SF4')+" SF4 "
			cQuery += "                 On SF4.F4_FILIAL  = ? "
			cQuery += "                And SF4.F4_CODIGO  = SD2.D2_TES "
			cQuery += "                And SF4.F4_ESTOQUE = ? "
			cQuery += "                And SF4.D_E_L_E_T_ = ? "
			//Indice 6 - D2_FILIAL+D2_COD+D2_LOCAL+DTOS(D2_EMISSAO)+D2_NUMSEQ
			cQuery += "              Where SD2.D2_FILIAL = ? "
			cQuery += "                And SD2.D2_COD    = SB2.B2_COD "
			cQuery += "                And SD2.D2_LOCAL  = SB2.B2_LOCAL "
			cQuery += "                And SD2.D2_EMISSAO Between ? And ? "
			cQuery += "                And SD2.D_E_L_E_T_ = ? "
			cQuery += "              ) "
			cQuery += "  Or  Exists (Select 1 " 
			cQuery += "         From "+RetSqlName('SD3')+" SD3 "
			//Indice 6 - D3_FILIAL+DTOS(D3_EMISSAO)+D3_NUMSEQ+D3_CHAVE+D3_COD
			cQuery += "              Where SD3.D3_FILIAL  = ? "
			cQuery += "                And SD3.D3_EMISSAO Between ? And ? "
			cQuery += "                And SD3.D3_COD     = SB2.B2_COD "
			cQuery += "                And SD3.D3_ESTORNO = ? "
			cQuery += "                And SD3.D_E_L_E_T_ = ? "
			cQuery += "              ) "
			cQuery += " )"
		EndIf
		cQuery += " Group By SB2.B2_FILIAL, SB2.B2_COD "
		cQuery += " Order By SB2.B2_FILIAL, SB2.B2_COD "
		cQuery := ChangeQuery(cQuery)

		oQuery := FwExecStatement():New(cQuery)
	EndIf

	For nFil := 1 To Len(aFilsCalc)
		If !aFilsCalc[nFil, 1]
			Loop
		EndIf
		cFilAtu := aFilsCalc[nFil, 2]
		cMsg := STR0003 //"Filial: #1[D MG 01 ]# - Integrando EAI"
		cMsg := I18N(cMsg, {cFilAtu})
		M330PrcLog("MENSAGEM", cMsg, cMsg)		

		nBind := 1
		oQuery:SetString(nBind++, FWXFilial('SB1', cFilAtu)) //B1_FILIAL
		oQuery:SetString(nBind++, Space(nTamCC)) //B1_CCCUSTO
		oQuery:SetString(nBind++, 'MOD%') //B1_COD
		oQuery:SetString(nBind++, ' ') //SB1.D_E_L_E_T_
		oQuery:SetString(nBind++, FWXFilial('SB2', cFilAtu)) //B2_FILIAL
		oQuery:SetString(nBind++, ' ') //SB2.D_E_L_E_T_
		If lI330FSM
			oQuery:SetString(nBind++, FWXFilial('SF4', cFilAtu)) //F4_FILIAL
			oQuery:SetString(nBind++, 'S') //F4_ESTOQUE
			oQuery:SetString(nBind++, ' ') //SF4.D_E_L_E_T_
			oQuery:SetString(nBind++, FWXFilial('SD1', cFilAtu)) //D1_FILIAL
			oQuery:SetString(nBind++, DToS(dInicio)) //D1_DTDIGIT
			oQuery:SetString(nBind++, DToS(dFim)) //D1_DTDIGIT
			oQuery:SetString(nBind++, ' ') //SD1.D_E_L_E_T_

			oQuery:SetString(nBind++, FWXFilial('SF4', cFilAtu)) //F4_FILIAL
			oQuery:SetString(nBind++, 'S') //F4_ESTOQUE
			oQuery:SetString(nBind++, ' ') //SF4.D_E_L_E_T_
			oQuery:SetString(nBind++, FWXFilial('SD2', cFilAtu)) //D2_FILIAL
			oQuery:SetString(nBind++, DToS(dInicio)) //D2_EMISSAO
			oQuery:SetString(nBind++, DToS(dFim)) //D2_EMISSAO
			oQuery:SetString(nBind++, ' ') //SD2.D_E_L_E_T_

			oQuery:SetString(nBind++, FWXFilial('SD3', cFilAtu)) //D3_FILIAL
			oQuery:SetString(nBind++, DToS(dInicio)) //D3_EMISSAO
			oQuery:SetString(nBind++, DToS(dFim)) //D3_EMISSAO
			oQuery:SetString(nBind++, ' ') //D3_ESTORNO
			oQuery:SetString(nBind++, ' ') //SD3.D_E_L_E_T_
		EndIf

		cAliasTemp := oQuery:OpenAlias()

		nQtdItens := 0
		nQtdThr   := 0
		aThread   := {}
		While !(cAliasTemp)->(EOF())
			++nQtdThr
			++nQtdItens
			If nQtdThr <= 100
				AAdd(aThread, (cAliasTemp)->B2_COD)
			EndIf

			If nQtdThr == 100
				oThrManager:Execute(THIS+"M330DoEAI", {cFilAtu, DToS(dDataBase), nApropri, DToS(dFim), aThread})
				ASize(aThread, 0)
                aThread := {}
                nQtdThr := 0
			EndIf

			(cAliasTemp)->(dbSkip())
		EndDo

		If nQtdThr > 0
			oThrManager:Execute(THIS+"M330DoEAI", {cFilAtu, DToS(dDataBase), nApropri, DToS(dFim), aThread})
			ASize(aThread, 0)
			aThread := {}
			nQtdThr := 0
		EndIf

		cError := ""
        While Empty(cError)
            cError := oThrManager:CheckForErrors()

            If oThrManager:CheckIfDone()
                Exit
            EndIf
            Sleep(500)
        EndDo
		(cAliasTemp)->(DbCloseArea())

		If cError != ""
			oThrManager:Terminate()

			cMsg := STR0004 //"Erro no processamento da thread"
			M330PrcLog("MENSAGEM", I18N(cMsg), I18N(oThrManager:cError+oThrManager:cErrorStack+oThrManager:cErrorEnv))
			UserException(oThrManager:cError+oThrManager:cErrorStack+oThrManager:cErrorEnv)
		EndIf

		cMsg := STR0005 //"Filial: #1[D MG 01 ]# - Integrou EAI - #2[5493]# Produto(s)"
		cMsg := I18N(cMsg, {cFilAtu, CValToChar(nQtdItens)})
		M330PrcLog("MENSAGEM", cMsg, cMsg)
	Next
	cMsg := STR0006 //"Finalizando integração do Adapter EAI MATA330"
	M330PrcLog("MENSAGEM", I18N(cMsg), I18N(cMsg))

	oThrManager:Terminate()
	oThrManager:CleanUp(cUUID)

	oQuery:Destroy()
	oQuery := Nil

Return NIL

/*/{Protheus.doc} M330DoEAI
	Função de execução do EAI
	@type  Function
	@author user
	@since 05/08/2026
	@version version
	@param aParams, array, Array de parâmetros da thread principal
	@return Nil, Nil, Nil
	/*/
Function M330DoEAI(aParams As Array)
	Local cFilAtu   := aParams[1]
	Local cDataOri  := aParams[2]
	Local nMetApr   := aParams[3]
	Local cDtFinal  := aParams[4]
	Local aProdutos := aParams[5]
	Local cFilBkp   := cFilAnt
	Local nCod      := 0
	
	cFilAnt := cFilAtu // posiciona para uso no integdef e mati330 devido a query acima nunca será em branco
	dDataBase := SToD(cDataOri)

	//Parâmetros do recálculo recebidos como private
	Private nAprop330 := nMetApr
	Private dDtFim330 := SToD(cDtFinal)

	SB1->(dbSetOrder(1)) //B1_FILIAL+B1_COD
	SB2->(dbSetOrder(1)) //B2_FILIAL+B2_COD+B2_LOCAL
	SB5->(dbSetOrder(1)) //B5_FILIAL+B5_COD
	
	For nCod := 1 To Len(aProdutos)
		SB1->(MSSeek(xFilial('SB1')+aProdutos[nCod]))
		SB2->(MSSeek(xFilial('SB2')+aProdutos[nCod]))
		SB5->(MSSeek(xFilial('SB5')+aProdutos[nCod]))

		FwIntegDef("MATA330")
	Next

	cFilAnt := cFilBkp
Return
