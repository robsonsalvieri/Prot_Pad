#include "tlpp-core.th"
#include "tlpp-rest.th"
#include 'protheus.ch'
#INCLUDE "TOPCONN.ch"
#INCLUDE "TBICONN.CH"
#INCLUDE "FWEVENTVIEWCONSTS.CH"

namespace ac.acCalc.Repository

using namespace totvs.protheus.backoffice.stock.iterativecost.processing.mainprogram

Class acCalcRep from FWAdapterBaseV2
    public Method New()
    public Method eventRec330()
    public Method listBranches330()
    public Method logErrorProc()
    public Method version()
    public Method eventEst330()
    public Method getCalculationScript()
EndClass

Method new(cVerbo as Character, lList as Logical) class acCalcRep
    Default cVerbo  := 'GET'
    Default lList   := .T.

    _Super:new(cVerbo, lList)
return Self

/*/{Protheus.doc} eventRec330
    Metodo responsavel por iniciar processamento do MATA330 por job
    @type  Metodo
    @author André Maximo 
    @since  Novembro 26,2020
    @version 12.1.27
/*/
Method eventRec330(aListaFil,lCPParte,aParAuto,cId, cIdChild,cCompany,cBranch, cUserNamej, cAcUserId, lExecAuto,cDataBase, cCalcModel, aE330ParamZX) Class acCalcRep

local objJourneycEmp :=  acJourneyLog():New()
Local cProcess       := ""
Local oError := ErrorBlock({|e| ::logErrorProc(e:Description, e:ErrorStack, objJourneycEmp, aParAuto)})

Default cCalcModel   := "1"
Default aE330ParamZX := {}

Private lMsErroAuto     := .F.
Private lAutoErrNoFile  := .T.

If cCalcModel == "2"
    cProcess := "EST330"
Else
    cProcess := "MATA330"
EndIf

IniEnviron(cCompany,cBranch, cProcess,cDataBase)
IniVarEnAc(cAcUserId, cUserNameJ)

objJourneycEmp:cIdParent:= cId 
objJourneycEmp:cIdChild:= cIdChild 

objJourneycEmp:envValid(.T.)
objJourneycEmp:idMovD3X()
objJourneycEmp:setThreadId( Strzero(ThreadID(),15))

LockByName(cProcess + '_' +  cIdChild, .F. , .F.)

objJourneycEmp:insertTable(cId, cIdChild, cProcess, 'SETUP', cUserNamej)
Begin Sequence
    If cCalcModel == "2"
        ::eventEst330(objJourneycEmp, aE330ParamZX, lExecAuto)
    Else
        MATA330(.T.,aListaFil,!lCPParte, aParAuto,objJourneycEmp,.T., cUserNamej, lExecAuto)
    EndIf
End Sequence

UnLockByName(cProcess + '_' +  cIdChild, .F., .F.)
ErrorBlock(oError)

return

/*/{Protheus.doc} logErrorProc
    Metodo responsavel por gravar status de erro
    @type  Metodo
    @author pedro.missaglia 
    @since  Marco 01, 2023
    @version 12.1.22.10
/*/
method logErrorProc(errorMessage, errorStack,JourneyLog, aParAuto) class acCalcRep

Local cProcess := 'MATA330'
Default a330ParamZX := aClone(aParAuto)

If Empty(JourneyLog:cProcess)
    JourneyLog:cProcess := cProcess
Endif

JourneyLog:LogProAtu('ERRO', errorMessage, errorMessage + errorStack, cFilAnt, 'ER', a330ParamZX[1], cFilAnt, .T.)
UnLockByName(cProcess + '_' +  JourneyLog:cIdChild, .F., .F.)
userException(errorMessage)

return 

/*/{Protheus.doc} version
    Metodo responsavel por indicar a versao da classe
    @type  Metodo
    @author pedro.missaglia 
    @since  Marco 01, 2023
    @version 12.1.22.10
/*/
method version() class acCalcRep

return 100

/*/{Protheus.doc} eventEst330
    Inicia o processamento do recalculo do custo medio modelo II
    @type  Method
    @author Squad.Entradas
    @since 20/10/2025
    @version 1.0
    @param aE330ParamZX, array, perguntes do EST330
    @param objJourneycEmp, object, objeto de log da jornada
    @param lExecAuto, logical, indica execucao automatica da contabilizacao sem etapa de analise
    /*/
Method eventEst330(objJourneycEmp, aE330ParamZX, lExecAuto) class acCalcRep
    Local oJourney := JsonObject():New()

    oJourney["oJourneyLog"]    := objJourneycEmp
    oJourney["paramsSX1"]      := aE330ParamZX
    oJourney["autoAccounting"] := lExecAuto

    oItCost := IterativeCostMain():New(Nil, oJourney)
    oItCost:GetParamSX1()
    oItCost:GetParamSX6()
    oItCost:Run()

Return

/*/{Protheus.doc} getCalculationScript()
    Realiza a consulta no banco para retornar o GET da requisicao
    @type  Metodo
    @author Leonardo Kichitaro
    @since 09/10/2025
    @version 1.0
/*/
Method getCalculationScript(nPage as numeric, nPageSize as numeric) class acCalcRep
   	Local cQuery        as Character
    Local cWhere        as Character
    Local nBind         as Numeric
    Local cQueryTmp     as Character
    Local cAlTmp        as Character
    Local cCodAnt       as Character
    Local nX            as Numeric
    Local oQuery        as Object
    Local jsonResponse  as Object
    Local jbranches     as Json
    Local jAllBranches  as Json
    Local aFilial       := TamSx3('D4E_FILIAL')
    Local aCodigo       := TamSx3('D4E_CODIGO')
    Local aDescri       := TamSx3('D4E_DESC')
    Local aFilRet       := {}
    Local aRotFilExe    := {}

    jAllBranches := JsonObject():New()
    jAllBranches:FromJson('{"branches":[]}')

    aAllFiliais := FWAllFilial(FWCompany(),,cEmpAnt,.F.)

    For nX := 1 To Len(aAllFiliais)
        aFilRet := FwArrFilAtu( cEmpAnt, aAllFiliais[nX] )

        aAdd(jAllBranches["branches"], JsonObject():New())
        jAllBranches["branches"][Len(jAllBranches["branches"])]["$selected"]      := .T.
        jAllBranches["branches"][Len(jAllBranches["branches"])]["Cgc"]            := aFilRet[18]
        jAllBranches["branches"][Len(jAllBranches["branches"])]["Code"]           := aAllFiliais[nX]
        jAllBranches["branches"][Len(jAllBranches["branches"])]["Description"]    := aFilRet[07]
        jAllBranches["branches"][Len(jAllBranches["branches"])]["Tag"]            := .F.
    Next

    cQueryTmp := " SELECT D4E_FILIAL, D4E_CODIGO, D4E_DESC, D4E_FILEXE "
    cQueryTmp += " FROM "+RetSQLName("D4E")
    cQueryTmp += " WHERE "
    cQueryTmp += " D4E_FILIAL = ? And "
    cQueryTmp += " D_E_L_E_T_ = ? "
    cQueryTmp += " ORDER BY D4E_FILIAL, D4E_CODIGO, D4E_FILEXE "
    cQueryTmp := ChangeQuery(cQueryTmp)

    oQuery := FwExecStatement():New(cQueryTmp)
    nBind := 1
    oQuery:SetString(nBind++, FWXFilial('D4E'))
    oQuery:SetString(nBind++, ' ')

    cAlTmp := oQuery:OpenAlias()

    While !(cAlTmp)->(EoF())
        If Empty(cCodAnt) .Or. cCodAnt <> (cAlTmp)->D4E_CODIGO
            IF !Empty(cCodAnt)
                aAdd(aRotFilExe,{cCodAnt, jbranches})
            EndIf
            jbranches := JsonObject():New()
            jbranches:FromJson('{"branches":[]}')
        EndIf

        If (cAlTmp)->D4E_FILIAL <> (cAlTmp)->D4E_FILEXE
            aFilRet := FwArrFilAtu( cEmpAnt, (cAlTmp)->D4E_FILEXE )

            aAdd(jbranches["branches"], JsonObject():New())
            jbranches["branches"][Len(jbranches["branches"])]["$selected"]      := .T.
            jbranches["branches"][Len(jbranches["branches"])]["Cgc"]            := aFilRet[18]
            jbranches["branches"][Len(jbranches["branches"])]["Code"]           := (cAlTmp)->D4E_FILEXE
            jbranches["branches"][Len(jbranches["branches"])]["Description"]    := aFilRet[07]
            jbranches["branches"][Len(jbranches["branches"])]["Tag"]            := .F.
        ElseIf (cAlTmp)->D4E_FILIAL == (cAlTmp)->D4E_FILEXE
            jbranches["branches"] := jAllBranches["branches"]
        EndIf

        cCodAnt := (cAlTmp)->D4E_CODIGO

        (cAlTmp)->(DbSkip())
    EndDo
    (cAlTmp)->(DbCloseArea())

    IF !Empty(cCodAnt)
        aAdd(aRotFilExe,{cCodAnt, jbranches})
    EndIf

    oQuery:Destroy()
    FreeObj(oQuery)

    cQuery := " SELECT #QueryFields# "
	cQuery += " FROM " + RetSQLName("D4E") + " D4E  "
    cQuery += " WHERE #QueryWhere#  "
    cWhere := ""
    cWhere += " D4E.D4E_FILIAL = '"+FWXFilial('D4E')+"' AND "
    cWhere += " D4E.D_E_L_E_T_ = ' ' "
    cQuery += "GROUP BY D4E.D4E_FILIAL, D4E.D4E_CODIGO, D4E.D4E_DESC "

    ::AddMapFields('branch', 'D4E_FILIAL', .T., .T., { 'D4E_FILIAL' , aFilial[3], aFilial[1], aFilial[2]})
    ::AddMapFields('code', 'D4E_CODIGO', .T., .T., { 'D4E_CODIGO' , aCodigo[3], aCodigo[1], aCodigo[2]})
    ::AddMapFields('description', 'D4E_DESC', .T., .T., { 'D4E_DESC' , aDescri[3], aDescri[1], aDescri[2]})
    ::setPage(nPage)
    ::setPageSize(nPagesize)
    ::setQuery(cQuery)
    ::setWhere(cWhere)
    ::SetOrder("D4E_CODIGO")

    If ::Execute()
        ::FillGetResponse()
        jsonResponse := JsonScript(::GetJsonResponse(), aRotFilExe)
    EndIf

    fwFreeArray(aAllFiliais)
    fwFreeArray(aRotFilExe)
    FreeObj(jbranches)
    FreeObj(jAllBranches)

Return jsonResponse

/*/{Protheus.doc} JsonScript
    Atualiza campo branches no json de retorno
    @type Static Function
    @author Leonardo Kichitaro
    @since 09/10/2025
    @version 12.1.2610
    /*/
Static Function JsonScript(cBodyRequest, aRotFilExe)

    Local nX        as Numeric
    Local nPos      as Numeric
    Local jJson1    as Json
    Local cRetJson  as Character

    jJson1 := JsonObject():New()
    jJson1:FromJson(cBodyRequest)

    jAux := JsonObject():New()

    for nX := 1 to len(jJson1["items"])
        If (nPos := ASCan(aRotFilExe, {|x| AllTrim(x[1]) == jJson1["items"][nX]["code"]})) > 0
            jJson1["items"][nX]["branches"] := aRotFilExe[nPos][2]["branches"]
        EndIf
    next nX

    cRetJson := jJson1:ToJson()

    FreeObj(jJson1)

Return cRetJson
