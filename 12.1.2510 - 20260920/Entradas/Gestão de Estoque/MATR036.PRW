Function MATR036()


Local cReport	:= "MATR036"
Local cAlias	:= "SBM"
Local cTitle	:= OemToAnsi(STR0001)	//Titulo do Relatorio
Local cDesc		:= OemToAnsi(STR0002)	//Descricao do Relatorio
Local lInd		:= .T.					//Mostra os indices do SIX

//Validação de aviso/bloqueio do relatório em Release 12.1.2510 ou superiores
If ExistFunc("VldDescRel")
	If !VldDescRel()
		Return
	EndIf
EndIf

MPReport(cReport,cAlias,cTitle,cDesc,,lInd)

Return Nil
