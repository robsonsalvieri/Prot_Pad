#include "protheus.ch"

namespace backoffice.stock.averagecost.interbranchtransfer

// Inicialização de variáveis críticas
static __cLocalCQ := NIL
static __cLocTran := NIL
static __lCusRep  := NIL 
static __nTamDoc  := NIL
static __lM330CD1 := ExistBlock("M330CD1") 

// Variavel estatica para controle do Tax Engine
Static __lTrb1Gen := NIL

/*/{Protheus.doc} agregICMST
Aplica ICMS ST ao custo do produto do item da nota fiscal de entreda proveniente de uma transferencia entre filiais,
conforme TES e Tax Engine
@type function
@author reynaldo
@since 12.01.2026
@param aItCusto, array, Custos por moeda
@return logical, .T. se processado com sucesso
@obs Os registros das tabelas SD1 e SF4 devem estar posicionados
/*/
Function agregICMST(aItCusto)
Local nX       := 0
Local lAddST   := .F.
Local nVlrST   := 0
Local oTaxVal  := NIL
Local cRetJson := ""
Local cRet     := ""

	lAddST := (SF4->F4_TRFICST == "1")	
	If lAddST
		// Inicializacao lazy do Tax Engine
		If __lTrb1Gen == NIL
			__lTrb1Gen := .F.
			If FindFunction("backoffice.stock.calculationcost.HasRulesCust", .T.)
				__lTrb1Gen := FindClass("backoffice.stock.calculationcost.EntryCostCalculator")
			EndIf
		EndIf
    
		// Configuraçao da TES
		nVlrST := SD1->D1_ICMSRET

		// Tax Engine (se dispon?vel)
		If __lTrb1Gen .AND. !Empty(SD1->D1_IDTRIB)
        	If backoffice.stock.calculationcost.HasRulesCust()
				oTaxVal   := JsonObject():New()
				cRetJson  := backoffice.stock.calculationcost.CalculationNFETrbGen(SD1->D1_IDTRIB)
				cRet      := oTaxVal:FromJson(cRetJson)
            
				If ValType(cRet) <> "C" .And. oTaxVal:HasProperty('Tributos')
					For nX := 1 To Len(oTaxVal['Tributos'])
						If oTaxVal['Tributos'][nX]['idTOTVS'] == "000056" // ICMS ST
							If oTaxVal['Tributos'][nX]['Operacao'] == "1" // SOMA
								lAddST := .T.
								nVlrST := oTaxVal['Tributos'][nX]['Valor']
							EndIf
							Exit
						EndIf
					Next nX
				EndIf
            
				FreeObj(oTaxVal)
				oTaxVal := NIL
			EndIf
    	EndIf

		// Aplicação do ICMS ST
		If nVlrST > 0
			For nX := 1 To Len(aItCusto)
				If nX == 1
					aItCusto[nX] += nVlrST
				Else
					aItCusto[nX] += xMoeda(nVlrST, 1, nX, SD1->D1_DTDIGIT)
				EndIf
			Next nX
    	EndIf
	EndIf

Return .T.
