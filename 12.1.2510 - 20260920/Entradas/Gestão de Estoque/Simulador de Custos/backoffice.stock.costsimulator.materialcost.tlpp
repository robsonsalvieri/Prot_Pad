#INCLUDE "tlpp-core.th"
#INCLUDE "totvs.ch"
#INCLUDE "backoffice.stock.costsimulator.materialcost.ch"

/*/{Protheus.doc} MaterialCost
    Classe responsavel pelo calculo dos custos da estrutura do simulador
    @type Class
    @author Squad.Entradas
    @since 19/06/2026
    @version 1.0
    /*/
Class MaterialCost

    Public Data oModel
    Public Data oEvent

    Public Method New(oModel)
    Public Method calculate()
    Private Method getEvent()
    Private Method getFieldIndex(cModelID, cFieldName)

EndClass

/*/{Protheus.doc} New
    Método construtor da classe de calculo de custos
    @type Method
    @author Squad.Entradas
    @since 19/06/2026
    @version 1.0
    @param oModel, Object, Instância do model MVC do simulador de custos
    /*/
Method New(oModel) Class MaterialCost

    ::oModel := oModel
    ::oEvent := ::getEvent()
    
Return Self

/*/{Protheus.doc} ESTA101Cal
    Função de interface para disparar o calculo de custos da estrutura
    @type Function
    @author Squad.Entradas
    @since 19/06/2026
    @version 1.0
    /*/
Function ESTA101Cal(oView)
    Local oModel   := oView:GetModel()
    Local oMatCost := Nil
    
    ESTA101Sav(oModel)

    oMatCost := MaterialCost():New(oModel)
    FWMsgRun(Nil, {|| oMatCost:calculate() }, STR0001, STR0002) // "Simulador de Custos" "Calculando custo da estrutura. Aguarde..."
    
    ESTA101Pnl(.F.)

Return Nil

/*/{Protheus.doc} getEvent
    Método responsável por localizar o evento do model do simulador de custos
    garantindo o acesso aos caches em JSON
    @type Method
    @author Squad.Entradas
    @since 19/06/2026
    @version 1.0
    /*/
Method getEvent() Class MaterialCost
    Local nIndex  := 0 as Numeric
    Local oEvent  := Nil as Object
    Local oMdlPai := Nil as Object

    If ::oModel != Nil
        oMdlPai := ::oModel:GetModel()
    EndIf

    If oMdlPai != Nil .And. AttIsMemberOf(oMdlPai, "oEventHandler", .T.) .And. oMdlPai:oEventHandler != NIL
        For nIndex := 1 To Len(oMdlPai:oEventHandler:aEvents)
            If oMdlPai:oEventHandler:aEvents[nIndex]:cIdEvent == "ESTA101EVDEF"
                oEvent := oMdlPai:oEventHandler:aEvents[nIndex]
                Exit
            EndIf
        Next nIndex
    EndIf

Return oEvent

/*/{Protheus.doc} getFieldIndex
    Método para obter a posição de um campo no array do model
    @type Method
    @author Squad.Entradas
    @since 19/06/2026
    @version 1.0
    @return Numeric
    /*/
Method getFieldIndex(cModelID as Character, cFieldName as Character) Class MaterialCost
    Local aFields := ::oModel:GetModel(cModelID):GetStruct():GetFields() as Array
    Local nPos    := aScan(aFields, {|x| AllTrim(x[3]) == cFieldName}) as Numeric
Return nPos

/*/{Protheus.doc} calculate
    Método de calculo dos custos da estrutura
    @type Method
    @author Squad.Entradas
    @since 19/06/2026
    @version 1.0
    @return Boolean
    /*/
Method calculate() Class MaterialCost
    Local aBaseCalculo    := {} as Array
    Local aPais       := {} as Array
    Local cPai        := "" as Character
    Local aComponent  := {} as Array
    Local nI          := 0 as Numeric
    Local nJ          := 0 as Numeric
    Local nX          := 0 as Numeric
    
    Local nPosComp    := ::GetFieldIndex("D5BDETAIL", "D5B_COMP") as Numeric
    Local nPosNivInv  := ::GetFieldIndex("D5BDETAIL", "D5B_NIVINV") as Numeric
    Local nPosQuant   := ::GetFieldIndex("D5BDETAIL", "D5B_QUANT") as Numeric
    Local nPosPerda   := ::GetFieldIndex("D5BDETAIL", "D5B_PERDA") as Numeric
    Local nPosDelB    := ::GetFieldIndex("D5BDETAIL", "LINDEL") as Numeric
    
    Local nPosCstFim  := ::GetFieldIndex("D5DDETAIL", "D5D_CSTFIM") as Numeric
    Local nPosDelD    := ::GetFieldIndex("D5DDETAIL", "LINDEL") as Numeric
    
    Local nNiv        := 0 as Numeric
    Local nQuant      := 0 as Numeric
    Local nPerda      := 0 as Numeric
    Local cComp       := "" as Character
    
    Local oBaseD5B    := JsonObject():New() as Object
    Local oBaseD5D    := JsonObject():New() as Object
    Local oCustosCalculados := JsonObject():New() as Object
    Local aNamesCalc  := {} as Array
    Local nNewCost    := 0 as Numeric
    
    Local nCustoFilho := 0 as Numeric
    Local nCustoCalculado  := 0 as Numeric
    Local nCustoAtual := 0 as Numeric
    
    Local oView       := FWViewActive() as Object
    Local oModelD5D   := ::oModel:GetModel("D5DDETAIL") as Object
    Local cPaiTreeAtu := "" as Character

    // criaçao dos espelhos dos objetos json em cache
    aPais := ::oEvent:oCacheD5B:GetNames()
    For nI := 1 To Len(aPais)
        cPai := RTrim(aPais[nI])
        oBaseD5B[cPai] := {}
        For nJ := 1 To Len(::oEvent:oCacheD5B[cPai])
            AAdd(oBaseD5B[cPai], { ::oEvent:oCacheD5B[cPai][nJ][1], aClone(::oEvent:oCacheD5B[cPai][nJ][2]) })
        Next nJ
    Next nI

    aPais := ::oEvent:oCacheD5D:GetNames()
    For nI := 1 To Len(aPais)
        cPai := RTrim(aPais[nI])
        oBaseD5D[cPai] := {}
        For nJ := 1 To Len(::oEvent:oCacheD5D[cPai])
            AAdd(oBaseD5D[cPai], { ::oEvent:oCacheD5D[cPai][nJ][1], aClone(::oEvent:oCacheD5D[cPai][nJ][2]) })
        Next nJ
    Next nI

    // criaçao do array de calculo
    aPais := oBaseD5B:GetNames()
    For nI := 1 To Len(aPais)
        cPai := RTrim(aPais[nI])
        aComponent := oBaseD5B[cPai]
        
        For nJ := 1 To Len(aComponent)
            If nPosDelB > 0 .And. aComponent[nJ][2][nPosDelB] == .T. // Tratamento para componentes deletados
                Loop
            EndIf
            
            cComp  := RTrim(aComponent[nJ][2][nPosComp])
            nNiv   := Val(aComponent[nJ][2][nPosNivInv])
            nQuant := aComponent[nJ][2][nPosQuant]
            nPerda := IIf(nPosPerda > 0, aComponent[nJ][2][nPosPerda], 0)
            
            If !Empty(cComp) .And. nQuant > 0
                AAdd(aBaseCalculo, {cPai, cComp, nNiv, nQuant, nPerda})
            EndIf
        Next nJ
    Next nI

    // Ordenação do array
    aSort(aBaseCalculo, , , {|x, y| x[3] < y[3]})

    // inicializa os pais no objeto acumulador
    For nI := 1 To Len(aBaseCalculo)
        cPai := aBaseCalculo[nI][1]
        If !oCustosCalculados:HasProperty(cPai)
            oCustosCalculados[cPai] := 0
        EndIf
    Next nI

    // motor de calculo
    For nI := 1 To Len(aBaseCalculo)
        cPai   := RTrim(aBaseCalculo[nI][1])
        cComp  := RTrim(aBaseCalculo[nI][2])
        nQuant := aBaseCalculo[nI][4]
        nPerda := aBaseCalculo[nI][5]

        nCustoFilho := 0
        
        // Se o custo do filho já foi calculado pega do objeto
        If oCustosCalculados:HasProperty(cComp)
            nCustoFilho := oCustosCalculados[cComp]
        Else
            // custo do filho é o D5D_CSTFIM
            If oBaseD5D:HasProperty(cComp) .And. Len(oBaseD5D[cComp]) > 0
                If nPosDelD == 0 .Or. oBaseD5D[cComp][1][2][nPosDelD] == .F.
                    nCustoFilho := oBaseD5D[cComp][1][2][nPosCstFim]
                EndIf
            EndIf
        EndIf

        // Custo = Filho * Quantidade * (1 + (Perda/100))
        nCustoCalculado := nCustoFilho * nQuant * (1 + (nPerda / 100))

        // Acumula no produto Pai
        nCustoAtual := oCustosCalculados[cPai]
        oCustosCalculados[cPai] := nCustoAtual + nCustoCalculado
    Next nI

    // Grava os custos calculados no espelho de custo
    aNamesCalc := oCustosCalculados:GetNames()
    For nI := 1 To Len(aNamesCalc)
        cPai := aNamesCalc[nI]
        nNewCost := oCustosCalculados[cPai]

        If oBaseD5D:HasProperty(cPai) .And. Len(oBaseD5D[cPai]) > 0
            oBaseD5D[cPai][1][2][nPosCstFim] := nNewCost
        EndIf
    Next nI

    // substitui os json originais pelos processados
    aPais := oBaseD5D:GetNames()
    For nI := 1 To Len(aPais)
        cPai := aPais[nI]
        ::oEvent:oCacheD5D[cPai] := {}
        For nJ := 1 To Len(oBaseD5D[cPai])
            AAdd(::oEvent:oCacheD5D[cPai], { oBaseD5D[cPai][nJ][1], aClone(oBaseD5D[cPai][nJ][2]) })
        Next nJ
    Next nI

    // atualiza o model e dá refresh na tela
    If oView != Nil
        cPaiTreeAtu := RTrim(::oModel:GetModel("NO_MASTER"):GetValue("CCODPRO"))
        
        If oCustosCalculados:HasProperty(cPaiTreeAtu) .And. oModelD5D != Nil .And. oModelD5D:GetQtdLine() > 0
            oModelD5D:GoLine(1)
            
            // desbloqueia a grid de custo
            oModelD5D:SetNoUpdateLine(.F.)
            
            // carrega o novo custo calculado
            oModelD5D:LoadValue("D5D_CSTFIM", oCustosCalculados[cPaiTreeAtu])
            
            // restaura o bloqueio da grid de custo
            If ::oEvent:oCacheD5B:HasProperty(cPaiTreeAtu)
                For nX := 1 To Len(::oEvent:oCacheD5B[cPaiTreeAtu])
                    If !Empty(::oEvent:oCacheD5B[cPaiTreeAtu][nX][2][nPosComp]) .And. ::oEvent:oCacheD5B[cPaiTreeAtu][nX][2][nPosDelB] == .F.
                        oModelD5D:SetNoUpdateLine(.T.) // Devolve o bloqueio MVC
                        Exit
                    EndIf
                Next nX
            EndIf
        EndIf
        
        oView:Refresh("VIEW_D5D")
    EndIf

Return .T.
