#include "Totvs.ch"
#include "tlpp-core.th"

Namespace totvs.protheus.backoffice.stock.iterativecost.view.parts.initialstockbalance

/*/{Protheus.doc} ViewPartsInitialStockBalance
    View D4I - Saldos Iniciais em partes
    @author Squad Entradas
    @since 27/03/2025
    @version version
    /*/
Class ViewPartsInitialStockBalance //Implements IterativeCostView
    Public Method New()

    Static Method GetVersion()
    Static Method GetViewID()
    Public Method GetParams()
    Public Method GetQuery()
EndClass

/*/{Protheus.doc} New
    Instância
    @author Squad Entradas
    @since 27/03/2025
    /*/
Method New() Class ViewPartsInitialStockBalance
Return Self

/*/{Protheus.doc} GetVersion
    Versão da View
    @author Squad Entradas
    @since 27/03/2025
    /*/
Method GetVersion() Class ViewPartsInitialStockBalance
Return "0002"

/*/{Protheus.doc} GetViewID
    ID da View
    Não alterar após entrar em produção
    @author Squad Entradas
    @since 27/03/2025
    /*/
Method GetViewID() Class ViewPartsInitialStockBalance
Return "VWSB9CP"

/*/{Protheus.doc} GetParams
    Retorna Json contendo os codeblock executáveis para obter os parâmetros da View
    @author Squad Entradas
    @since 27/03/2025
    /*/
Method GetParams() Class ViewPartsInitialStockBalance
    Local jExec := JsonObject():New() As Json

    jExec["VWSB9CT_NOME"] := {|| Posicione('D4D',1,FWXFilial('D4D')+'VWSB9CT','D4D_VWNAME')}
    jExec["TAM_PARTE"]    := {|| TamSX3("D4I_PARTE")[1]}
    jExec["MV_MOEDACM"]   := {|| SuperGetMV("MV_MOEDACM", .F., '2345')}
Return jExec

/*/{Protheus.doc} GetQuery
    Retorna a query estruturada da instalação da View com base nos parâmetros informados
    @author Squad Entradas
    @since 27/03/2025
    /*/
Method GetQuery(cEmpAtu As Character, jParam As Json) Class ViewPartsInitialStockBalance
    Local cQuery  As Character
    Local cIDView As Character
    Local cNomFis As Character
    Local cDbType As Character
    Local cVersao As Character
    Local cOutros As Character
    Local cTamPar As Character
    Local cMoeda    As Character
    Local cMoedaStr As Character
    Local aMoedas   As Array
    Local nMoeda    As Integer
    
	cIDView := ::GetViewID()
    cNomFis := "VW_"+cIDView+"_"+cEmpAtu
    cDbType := TCGetDB()
    cVersao := ::GetVersion()
    cOutros := Replicate('9', jParam["TAM_PARTE"])
    cTamPar := cValToChar(jParam["TAM_PARTE"])
    aMoedas := {'1'}
    For nMoeda := 2 To 5
        If cValToChar(nMoeda) $ jParam["MV_MOEDACM"]
            AAdd(aMoedas, cValToChar(nMoeda))
        EndIf
    Next nMoeda

    cQuery := " Create View "+cNomFis+" As "
    For nMoeda := 1 To Len(aMoedas)
        cMoeda := aMoedas[nMoeda]
        cMoedaStr := StrZero(Val(cMoeda), 2)
	
	    cQuery += " Select "
	    If cDbType $ 'POSTGRES'
	        cQuery += " Char(4) "
	    EndIf
	    cQuery += "'"+cVersao+"' ASSINATURA, "
	    cQuery += " SB9.B9_FILIAL, SB9.B9_COD, SB9.B9_LOCAL, SB9.B9_DATA,  "
	    cQuery += " SB9.B9_QINI, SB9.B9_QISEGUM, "
	    cQuery += " Coalesce(D4I.D4I_PARTE, D4G.D4G_CODPAR, Cast('"+cOutros+"' As Char("+cTamPar+"))) D4I_PARTE, "
	    cQuery += " D4I.D4I_REVISA D4I_REVISA, "
        cQuery += " Coalesce(D4I.D4I_MOEDA, Cast('"+cMoedaStr+"' As Char(2))) D4I_MOEDA, "       
        cQuery += " Coalesce(D4I.D4I_UNITAR, SB9.B9_CM"+cMoeda+")  D4I_UNITAR, "
        cQuery += " Coalesce(D4I.D4I_TOTAL, SB9.B9_VINI"+cMoeda+") D4I_TOTAL "
	    cQuery += " From "+jParam["VWSB9CT_NOME"]+" SB9 "
	    cQuery += " Left Join "+RetSQLName('D4I')+" D4I On "
	    cQuery += " D4I.D4I_FILIAL = SB9.B9_FILIAL And "
	    cQuery += " D4I.D4I_COD    = SB9.B9_COD    And "
	    cQuery += " D4I.D4I_LOCAL  = SB9.B9_LOCAL  And "
	    cQuery += " D4I.D4I_DATA   = SB9.B9_DATA   And "
        cQuery += " D4I.D4I_MOEDA  = '"+cMoedaStr+"' And "
	    cQuery += " D4I.D_E_L_E_T_ = ' ' "
	    cQuery += " LEFT JOIN ( SELECT D4G.D4G_FILIAL, D4G.D4G_PRODUT, D4G.D4G_CODPAR, D4G.D_E_L_E_T_ "
	    cQuery += "             FROM " + RetSQLName("D4G") + " D4G "
	    cQuery += "             INNER JOIN " + RetSQLName("D4F") + " D4F "
	    cQuery += "                 ON  D4F.D4F_FILIAL = '" + FWXFilial("D4F") + "' "
	    cQuery += "                 AND D4F.D4F_REVIS  = D4G.D4G_REVIS "
	    cQuery += "                 AND D4F.D4F_CODPAR = D4G.D4G_CODPAR "
	    cQuery += "                 AND D4F.D4F_TIPO   = '1' "
	    cQuery += "                 AND D4F.D_E_L_E_T_ = ' ' "
	    cQuery += "             LEFT JOIN " + RetSQLName("D4G") + " D4GDUP "
	    cQuery += "                 ON  D4GDUP.D4G_FILIAL = D4G.D4G_FILIAL "
	    cQuery += "                 AND D4GDUP.D4G_REVIS  = D4G.D4G_REVIS "
	    cQuery += "                 AND D4GDUP.D4G_PRODUT = D4G.D4G_PRODUT "
	    cQuery += "                 AND D4GDUP.D4G_CODPAR <> D4G.D4G_CODPAR "
	    cQuery += "                 AND D4GDUP.D_E_L_E_T_ = ' ' "
	    cQuery += "             WHERE D4GDUP.D4G_CODPAR IS NULL ) D4G "
	    cQuery += "     ON  " + FwJoinFilial("D4G", "SB9", "D4G", "SB9")
	    cQuery += "     AND D4G.D4G_PRODUT = SB9.B9_COD "
	    cQuery += "     AND D4G.D_E_L_E_T_ = ' ' "

        If nMoeda != Len(aMoedas)
            cQuery += " Union All "
        EndIf
    Next nMoeda

Return cQuery
