#include "PROTHEUS.CH"
#include "backoffice.stock.iterativecost.wizard.costbreakdown.ch"

/*/{Protheus.doc} WizardNCP
    Wizard para atualização da regra do custo em partes
    @type Function
    @author Squad Entradas
    @since 16/09/2025
    @version 12.1.2510
/*/
Function WizardNCP()
    Local oStepWiz     as object
    Local oDlg         as object
    Local oPanel       as object
    Local lExecute     as logical
    
    Private nWidGen    := 380 as integer
    Private nHeiGen    := 20 as integer
    Private aPartes    := {} as array
    Private aRegraPE   := {} as array
    Private lArrChgd   as logical
    Private lCanPrep   := .T. as logical
    Private lCanProc   := .F. as logical
    Private lCanGenRpt := .F. as logical
    Private lEfetivar  as logical //Variável de controle do botão "Efetivar"
    Private lIsDone    := .F. as logical
    Private lUsaPE     as logical //Variável de controle do ponto de entrada MA330CP
    Private cIDExec    as character
    Private cOldRev    := E330RevAti() as character
    Private cTheme     := totvs.framework.css.getNewWebAppTheme() as character
    Private cNewRev    := Space(TamSX3("D4F_REVIS")[1]) as character
    Private cDtUlMes   := DtoS(SuperGetMV("MV_ULMES",.F.,SToD("19970101"))) as character
    Private oQueryD4I  as object
    Private oQueryD4O  as object
    Private oBrowse2   as object

    Private oSayPreProc  as object
    Private oSayPreProc2 as object
    Private oSayPreProc3 as object
    Private oSvgPreProc  as object
    Private oSvgReport   as object
    Private oSvgProcess  as object
    Private oSayReport   as object
    Private oSayReport2  as object
    Private oSayProcess  as object
    Private oSayProcess2 as object
    Private oStatus      as object
    Private oSvgStatus   as object

    lExecute  := FnVldCMod2()

    //-- Avaliar registro em uso por outro usuário
    If lExecute .And. LockByName("WIZARDCP"+cEmpAnt, .T., .F.)
        DEFINE DIALOG oDlg TITLE STR0001 PIXEL

        /* Define tamanho da Dialog que comportará o Wizard */
        oDlg:nWidth  := 800
        oDlg:nHeight := 640

        /* Define o tamanho do painel do Wizard */
        oPanel:= tPanel():New(0,0,"",oDlg,,,,,,300,300)
        oPanel:Align := CONTROL_ALIGN_ALLCLIENT

        /* Instancia a classe FWWizard */
        oStepWiz:= FWWizardControl():New(oPanel)
        oStepWiz:ActiveUISteps()

        /* Adiciona novos steps ao wizard */
        AddPages(@oStepWiz,@oDlg,oPanel)
        
        ACTIVATE DIALOG oDlg CENTER

        oStepWiz:Destroy()

        FWFreeArray(aPartes)
        FWFreeObj(oStepWiz)

        If ValType(oBrowse2) == "O"
            oBrowse2:Destroy()
            FWFreeObj(oBrowse2)
        EndIf

        If ValType(oQueryD4I) == "O"
            oQueryD4I:Destroy()
            FwFreeObj(oQueryD4I)
        EndIf

        UnlockByName("WIZARDCP"+cEmpAnt, .T., .F.)
    Else
        Help(' ', 1,"WizExcl",,STR0040, 1, 0 ) //"O Wizard do Custo em Partes está em processo de edição por outro usuário." 
    EndIf

Return

/*/{Protheus.doc} AddPages
    Cria novas páginas e define suas propriedades
    @type Function
    @author Squad Entradas
    @since 16/09/2025
    @version 12.1.2510
/*/
Static Function AddPages(oStepWiz,oDlg,oPanel)
    Local oPage1 as object
    Local oPage2 as object
    Local oPage3 as object

    // Pagina 1
    oPage1 := oStepWiz:AddStep("1")
    oPage1:SetStepDescription(STR0002) // "Introdução"
    oPage1:SetConstruction({|oPanel|CriaPage1(oPanel)})
    oPage1:SetNextAction({||NextPg01(oDlg)})
    oPage1:SetCancelAction({||oDlg:End()})
    
    // Pagina 2
    oPage2 := oStepWiz:AddStep("2",)
    oPage2:SetStepDescription(STR0003) // "Vínculo"
    oPage2:SetConstruction({|oPanel|CriaPage2(oPanel)})
    oPage2:SetNextAction({|oPanel|ValidaD4F(oPanel)})
    oPage2:SetCancelAction({|oPanel|ValidaD4F(oPanel,oDlg,.T.)})
    oPage2:SetPrevAction({||.T.})
    oPage2:SetPrevTitle(STR0004) // "Voltar"
    
    // Pagina 3
    oPage3 := oStepWiz:AddStep("3")
    oPage3:SetStepDescription(STR0039) // "Processamento"
    oPage3:SetConstruction({|oPanel|CriaPage3(oPanel,oDlg)})
    oPage3:SetPrevAction({||CanGoBack3()})
    oPage3:SetCancelAction({||CloseWiz(oDlg,.T.)})
    oPage3:SetNextAction({||CloseWiz(oDlg,.F.)})
    
    oStepWiz:Activate()
Return

/*/{Protheus.doc} CriaPage1
    Cria a página 01 do Wizard
    @type Function
    @author Squad Entradas
    @since 16/09/2025
    @version 12.1.2510
/*/
Static Function CriaPage1(oPanel)
    local oSay     as object
    local oSay1    as object
    local oGet     as object
    local oCheck   as object
    local oLayer1  as object
    local oWindow  as object
    local oFont    as object
    local lMA330CP := HasMA330CP() as logical

    oFont := TFont():New("Arial",,-14,,.T.)

    oLayer1 := FWLayer():new()
    oLayer1:Init(oPanel,.F.)

    // Adicionando linhas
    oLayer1:AddLine('LIN1',65,.F.)
    oLayer1:AddLine('LIN2',35,.F.)

    //Adicionando colunas nas linhas
    oLayer1:AddCollumn('COL1',100,.F.,'LIN2')

    oLayer1:AddWindow('COL1','WIN1',"",100,.F.,.F.,,'LIN2')
    oWindow := oLayer1:getWinPanel('COL1','WIN1','LIN2')

    oSay := TSay():New(10,10,{|| STR0010},oPanel,,,,,,.T.,,,nWidGen,nHeiGen,,,,,,.T.) // "Bem-Vindo ao Wizard do Custo em Partes!"
    oSay := TSay():New(30,10,{|| STR0006},oPanel,,,,,,.T.,,,nWidGen,nHeiGen,,,,,,.T.) // "Nesta rotina, é possível vincular todas as partes previamente cadastradas para a revisão vigente do custo em partes e definir as regras que permitirão identificar quais produtos devem ser considerados em cada uma das partes."
    oSay := TSay():New(57,10,{|| STR0007},oPanel,,,,,,.T.,,,nWidGen,nHeiGen,,,,,,.T.) // "Essa configuração é fundamental para garantir que os produtos sejam corretamente classificados dentro das partes correspondentes."
    oSay := TSay():New(77,10,{|| STR0009},oPanel,,,,,,.T.,,,nWidGen,nHeiGen,,,,,,.T.) // "Importante: Essa configuração é exclusiva para o Recálculo do Custo Médio Modelo II."
    oSay := TSay():New(97,10,{|| STR0018},oPanel,,,,,,.T.,,,nWidGen,nHeiGen,,,,,,.T.) // "Para começar, informe no campo abaixo uma revisão que esteja ativa ou em rascunho:" 
    oGet := TGet():New(107,10,{|u|If(PCount()==0,cNewRev,cNewRev := u ) },oPanel,050,012,,{|| VldRev()},,,,.F.,,.T.,,.F.,,.F.,.F.,,.F.,.F. ,,"cNewRev",,,,)
    oGet:cF3 := "D4F"

    If lMA330CP
        If cTheme == "SUNSET"
            oSay1  := TSay():New(137,10,{|| STR0051},oPanel,,oFont,,,,.T.,Rgb(200,16,46),,nWidGen,nHeiGen,,,,,,.T.) //"Importar regras (MA330CP)"
        Else
            oSay1  := TSay():New(137,10,{|| STR0051},oPanel,,oFont,,,,.T.,Rgb(51,169,255),,nWidGen,nHeiGen,,,,,,.T.) //"Importar regras (MA330CP)"
        EndIf
        oSay1  := TSay():New(157,10,{|| STR0052},oPanel,,,,,,.T.,,,nWidGen,nHeiGen,,,,,,.T.) //"Foi identificado que o ponto de entrada MA330CP está compilado e contém a regra utilizada atualmente no modelo antigo."
        oSay1  := TSay():New(167,10,{|| STR0053},oPanel,,,,,,.T.,,,nWidGen,nHeiGen,,,,,,.T.) // "Para facilitar a migração para o novo modelo, é possível importar essa regra selecionando o botão abaixo: "
        oCheck := TCheckBox():New(177,10,STR0054,{|| lUsaPE},oPanel,nWidGen,nHeiGen,,{|| VldImport()},,,,,,.T.,,,) //"Importar regra do ponto de entrada MA330CP"
    Else
        oLayer1:Hide()
    EndIf

Return
 
/*/{Protheus.doc} CriaPage2
    Cria a página 02 do Wizard
    @type Function
    @author Squad Entradas
    @since 16/09/2025
    @version 12.1.2510
/*/
Static Function CriaPage2(oPanel)
    Local oSay      as object
    Local oLayer2   as object
    Local oWindow2  as object

    // Cria Browse
    oLayer2 := FWLayer():new()
    oLayer2:Init(oPanel,.F.)

    // Adicionando linhas
	oLayer2:AddLine('LIN1',15,.F.)
    oLayer2:AddLine('LIN2',85,.F.)

	//Adicionando colunas nas linhas
	oLayer2:AddCollumn('COL1',100,.F.,'LIN1')
	oLayer2:AddCollumn('COL1',100,.F.,'LIN2')

    oLayer2:AddWindow('COL1','WIN1',"Partes",100,.F.,.F.,,'LIN2')
	oWindow2 := oLayer2:getWinPanel('COL1','WIN1','LIN2')

    oSay := TSay():New(10,10,{|| STR0019},oPanel,,,,,,.T.,,,nWidGen,nHeiGen,,,,,,.T.) // ""Nessa etapa, preencha no grid abaixo o campo 'Regra' em cada uma das linhas, informando a fórmula que definirá o vínculo dos produtos à parte correspondente:""

    oBrowse2 := FwFormBrowse():New()
    oBrowse2:DisableFilter()
    oBrowse2:DisableConfig()
    oBrowse2:DisableReport()
    oBrowse2:DisableSeek()
    oBrowse2:DisableSaveConfig()
    oBrowse2:SetDataArray()
	oBrowse2:SetArray(aPartes)
	oBrowse2:FwBrowse():lHeaderClick:=.F.
    oBrowse2:AddLegend({|| .T.}, "GREEN")
	oBrowse2:SetOwner(oWindow2)
    oBrowse2:SetColumns(AddColums())

	oBrowse2:Activate()

Return

/*/{Protheus.doc} AddColums
    Adiciona as colunas e define as propriedades do grid utilizado na pagina 02
    @type Function
    @author Squad Entradas
    @since 16/09/2025
    @version 12.1.2510
/*/
Static Function AddColums()
    local aColunas := {} as array
    local oColumn  as object
    local aCampos  := {{'D4F_REVIS','2'},{'D4F_CODPAR','3'},{'D4F_TITULO','4'},{'D4F_REGRA','6'}} as array
    local nX       as integer

    If lUsaPE
        aCampos[4][2] := '8'
    EndIf

    For nX := 1 to Len(aCampos)
        oColumn := FWBrwColumn():New()
        oColumn:SetData(&('{|| aPartes[oBrowse2:At()]['+aCampos[nX][2]+'] }'))
        oColumn:SetTitle(FWX3Titulo(aCampos[nX][1]))
        oColumn:SetType(FWSX3Util():GetFieldType(aCampos[nX][1]))
        oColumn:SetSize(FWSX3Util():GetFieldStruct(aCampos[nX][1])[3])
        oColumn:SetPicture(FWSX3Util():GetFieldStruct(aCampos[nX][1])[5])
        oColumn:SetAlign('LEFT')
        If nX == 4
            oColumn:SetDoubleClick({|| EditRegra()})
        EndIf
        AAdd(aColunas, oColumn)
    Next nX

Return aColunas

/*/{Protheus.doc} CriaPage3
    Cria a página 03 do Wizard
    @type Function
    @author Squad Entradas
    @since 16/09/2025
    @version 12.1.2510
/*/
Static Function CriaPage3(oPanel,oDlg)
    Local oMsgRun   as object
    Local oGetPreProc       as object
    Local oGet1     as object
    Local oGet2     as object
    Local oTFont    as object
    Local oTFont1   as object

    oTFont := TFont():New('Arial',,-12,.T.)
    oTFont:Bold := .T.

    oTFont1 := TFont():New('Arial',,-14,.T.)
    oTFont1:Bold := .T.

    //Pré-Processamento
    oSvgPreProc  := TSVG():New(10,10,oPanel,20,20,SvgWait())
    oSayPreProc  := TSay():New( 12,22,{|| STR0061 },oPanel,,oTFont,,,,.T.,,,nWidGen,nHeiGen,,,,,,.T.) // "Nesta etapa, será realizado o pré-processamento, no qual os produtos serão vinculados às partes correspondentes com base nas fórmulas informadas anteriormente."
    oSayPreProc2 := TSay():New( 20,10,{|| STR0020 },oPanel,,,,,,.T.,,,nWidGen,nHeiGen,,,,,,.T.) // "Nesta etapa, será realizado o pré-processamento, no qual os produtos serão vinculados às partes correspondentes com base nas fórmulas informadas anteriormente."
    oSayPreProc3 := TSay():New( 37,10,{|| STR0021 },oPanel,,,,,,.T.,,,nWidGen,nHeiGen,,,,,,.T.) // "Para iniciar o processamento, clique no botão 'Iniciar Pré-Processamento'."
    oGetPreProc  := TButton():New( 47, 10, STR0022,oPanel,{|| FWMsgRun(,{|oMsgRun|IniPreProc(oMsgRun)},STR0014,STR0030) },80,15,,,.F.,.T.,.F.,,.F.,{|| lCanPrep},,.F. ) // "Gerando a tabela de pré-processamento..."

    //Conferência via Smart View
    oSvgReport  := TSVG():New(75,10,oPanel,20,20)
    oSayReport  := TSay():New( 77,10,{|| STR0062 },oPanel,,oTFont,,,,.T.,CLR_GRAY,,nWidGen,nHeiGen,,,,,,.T.) // "Nesta etapa, será realizado o pré-processamento, no qual os produtos serão vinculados às partes correspondentes com base nas fórmulas informadas anteriormente."
    oSayReport2 := TSay():New( 87,10,{|| STR0063 },oPanel,,,,,,.T.,CLR_GRAY,,nWidGen,nHeiGen,,,,,,.T.) // "Após a conclusão do processamento, utilize o botão 'Gerar Conferência SV' para conferir os vínculos realizados no Smart View ou, se preferir, clique em 'Efetivar Processamento' para prosseguir com a efetivação, sem a necessidade de realizar a conferência previamente."
    oGet1       := TButton():New( 97, 10, STR0042,oPanel,{||GenReport()},80,15,,,.F.,.T.,.F.,,.F.,{|| lCanGenRpt},,.F. ) // "Gerar Conferência SV"

    //Efetivação
    oSvgProcess  := TSVG():New(125,10,oPanel,20,20)
    oSayProcess  := TSay():New( 127,10,{|| STR0043 },oPanel,,oTFont,,,,.T.,CLR_GRAY,,nWidGen,nHeiGen,,,,,,.T.) // "Nesta etapa, será realizado o pré-processamento, no qual os produtos serão vinculados às partes correspondentes com base nas fórmulas informadas anteriormente."
    oSayProcess2 := TSay():New( 137,10,{|| STR0064 },oPanel,,,,,,.T.,CLR_GRAY,,nWidGen,nHeiGen,,,,,,.T.) 
    oGet2        := TButton():New( 154, 10, STR0065,oPanel,{||PreProcess()},80,15,,,.F.,.T.,.F.,,.F.,{|| lEfetivar},,.F. ) // "Efetivar Processamento"

    //Status após processamento final
    oSvgStatus := TSVG():New( 178.5,287,oPanel,20,20)
    oStatus    := TSay():New( 180,300,{|| STR0035 },oPanel,,oTFont1,,,,.T.,,,nWidGen,nHeiGen,,,,,,.T.) // "Aguardando Pré-Processamento"
    oStatus:lVisible := .F.

Return

/*/{Protheus.doc} retPartes
    Retorna as partes da revisão selecionada
    @type Function
    @author Squad Entradas
    @since 16/09/2025
    @version 12.1.2510
/*/
Static Function RetPartes()
    local oQuery     as object
    local cQuery     as character
    local cAliasD4F  as character
    Local aRetPartes := {} as array

    cQuery := " SELECT D4F.D4F_FILIAL FILIAL, D4F.D4F_REVIS REVISAO, D4F.D4F_CODPAR CODPAR, "
    cQuery += " D4F.D4F_TITULO TITULO, D4F.D4F_STATUS STATUS, D4F.D4F_REGRA REGRA, D4F.D4F_TIPO TIPO, "
    cQuery += " D4F.D4F_REGRPE REGRPE "
    cQuery += " FROM "+RetSqlName("D4F")+" D4F "
    cQuery += " WHERE D4F.D4F_FILIAL = ? AND "
    cQuery += " D4F.D4F_REVIS = ? AND "
    cQuery += " D4F.D4F_CODPAR <> ? AND "
    cQuery += " D4F.D_E_L_E_T_ = ? "
    cQuery += " ORDER BY D4F.D4F_FILIAL,D4F.D4F_REVIS,D4F.D4F_CODPAR "

    cQuery := ChangeQuery(cQuery)

    oQuery := FWExecStatement():New(cQuery)

    oQuery:SetString(1,FWxFilial("D4F",cFilAnt))
    oQuery:SetString(2,cNewRev)
    oQuery:SetString(3,'99')
    oQuery:SetString(4,' ')

    cAliasD4F := oQuery:OpenAlias()

    // Adiciona as partes no array aPartes
    Do While (cAliasD4F)->(!Eof())
        AAdd(aRetPartes,{(cAliasD4F)->(FILIAL),(cAliasD4F)->(REVISAO),(cAliasD4F)->(CODPAR),(cAliasD4F)->(TITULO),;
        (cAliasD4F)->(STATUS),(cAliasD4F)->(REGRA),(cAliasD4F)->(TIPO),(cAliasD4F)->(REGRPE)})
        (cAliasD4F)->(DbSkip())
    EndDo

    (cAliasD4F)->(DbCloseArea())

    oQuery:Destroy()
	FwFreeObj(oQuery)

Return aRetPartes

/*/{Protheus.doc} ValidaD4F
    Valida se será iniciado o processamento de atualização na D4F
    @type Function
    @author Squad Entradas
    @since 16/09/2025
    @version 12.1.2510
/*/
Static Function ValidaD4F(oPanel,oDlg,lCancel)
    local oSay as object
    local lRet := .T. as logical
    local nPos as numeric

    Default lCancel := .F.

    If lCancel
        If lArrChgd
            If msgYesNo(STR0016) // "Uma ou mais regras foram alteradas. Deseja atualizar o cadastro da parte antes de sair?"
                FWMsgRun(oPanel, {|oSay| GravaD4F(oSay) }, STR0014, STR0015) //"Processando..." / "Atualizando a regra das partes do custo em partes..."
            EndIf
        EndIf
        oDlg:End()
    Else
        If lUsaPE
            nPos := aScan(aPartes,{|x| Alltrim(x[8]) == ""})
        Else
            nPos := aScan(aPartes,{|x| Alltrim(x[6]) == ""})
        EndIf
        
        If nPos > 0 
            MsgAlert(STR0012) // "Existem campos com a regra em branco."
            lRet := .F.
        Else 
            FWMsgRun(oPanel, {|oSay| GravaD4F(oSay) }, STR0014, STR0015) //"Processando..." / "Atualizando a regra das partes do custo em partes..."
            lArrChgd := .F.
        EndIf
    EndIf

Return lRet

/*/{Protheus.doc} GravaD4F
    Atualiza a regra na tabela D4F
    @type Function
    @author Squad Entradas
    @since 16/09/2025
    @version 12.1.2510
/*/
Static Function GravaD4F(oPanel)
    local nX as integer

    DbSelectArea("D4F")
    DbSetOrder(1)

    For nX := 1 to Len(aPartes)
        If DbSeek(aPartes[nX][1]+aPartes[nX][2]+aPartes[nX][3])
            If !lUsaPE
                If !(D4F->D4F_REGRA == aPartes[nX][6])
                    Reclock("D4F",.F.)
                    D4F->D4F_REGRA := aPartes[nx][6]
                    D4F->(MsUnlock())
                EndIf
            Else
                If !(D4F->D4F_REGRPE == aPartes[nX][8])
                    Reclock("D4F",.F.)
                    D4F->D4F_REGRPE := aPartes[nx][8]
                    D4F->(MsUnlock())
                EndIf
            EndIf
        EndIf
    Next nX
Return

/*/{Protheus.doc} EditRegra
    Edita a regra da parte
    @type Function
    @author Squad Entradas
    @since 16/09/2025
    @version 12.1.2510
/*/
Static Function EditRegra()
    local cRegra as character

    If !lUsaPE
        cRegra := BuildExpr('SB1',,,.T.,,,,,,,,,.F.)
        
        If !Empty(cRegra)
            If aScan(aPartes,{|x| Alltrim(x[6]) == AllTrim(cRegra)}) > 0
                MsgAlert(STR0017) // "Não são permitidas duas partes com a mesma regra."
            Else
                aPartes[oBrowse2:aT()][6] := cRegra
                lArrChgd := .T.
            EndIf
        EndIf
    Else
        MsgAlert(STR0055)
    EndIf

Return

/*/{Protheus.doc} IniPreProc
    Inicializa o pré-processamento
    @type Function
    @author Squad Entradas
    @since 25/09/2025
    @version 12.1.2510
/*/
Static Function IniPreProc(oMsgRun)
    Local lRet as logical

    //Grava os registros na D4P
    lRet := InsertD4P(oMsgRun)
    
    If lRet
        lCanPrep   := .F.
        lCanGenRpt := .T.
        lEfetivar  := .T.

        //Atualiza os componentes visuais da tela
        RefreshUI(1)
    EndIf

Return

/*/{Protheus.doc} HasD4GRec
    Retorna se existem registros na D4G para a revisão informada
    @type Function
    @author Squad Entradas
    @since 25/09/2025
    @version 12.1.2510
/*/
Static Function HasD4GRec()
    local cQuery as character
    local oQuery as object
    local lRet   as logical

    cQuery := " SELECT CASE WHEN "
    cQuery += " EXISTS ( "
    cQuery += " SELECT 1 "
    cQuery += " FROM "+RetSqlName("D4G")+" D4G "
    cQuery += " WHERE D4G.D4G_FILIAL = ? AND "
    cQuery += " D4G.D4G_REVIS = ? AND "
    cQuery += " D4G.D_E_L_E_T_ = ? )"
    cQuery += " THEN '1' ELSE '0' END RECNO "
    If AllTrim(TcGetDB()) == "ORACLE"
		cQuery += " FROM DUAL "
    EndIf

    oQuery := FWExecStatement():New(cQuery)

    oQuery:SetString(1,FWxFilial("D4G"))
    oQuery:SetString(2,cNewRev)
    oQuery:SetString(3,' ')

    lRet := oQuery:ExecScalar("RECNO") == "1"

    oQuery:Destroy()
	FwFreeObj(oQuery)

Return lRet

/*/{Protheus.doc} DeleteD4G
    Deleta os registros na D4G da revisão informada
    @type Function
    @author Squad Entradas
    @since 25/09/2025
    @version 12.1.2510
/*/
Static Function DeleteD4G()
    local cDelete   as character
    local cErro     as character

    //Limpa a tabela
    cDelete := " DELETE FROM "+RetSQLName("D4G")+" WHERE "
    cDelete += " D4G_REVIS = '"+cNewRev+"' "

    If TcSqlExec(cDelete) < 0
        cErro := TCSQLError()
        UserException(cErro)
    EndIf

Return

/*/{Protheus.doc} InsertD4P
    Insere registros na D4P
    @type Function
    @author Squad Entradas
    @since 25/09/2025
    @version 12.1.2510
/*/
Static Function InsertD4P(oMsgRun)
    Local oBulkD4P  as object
    Local lRet      := .T. as logical
    Local lCanBulk  as logical
    Local aFields   := {} as array
    Local aRegraCP  as array
    Local cAliTemp  as character
    Local cAlias    as character
    Local nContador as integer
    Local nTotalReg as integer
    Local nTotSB1   as integer
    Local nX        as integer

    // Inicializa as variáveis
    oBulkD4P := FWBulk():New(RetSqlName("D4P"), 500)
    lCanBulk := oBulkD4P:CanBulk()
    cIDExec  := WCPIniSxe("D4P","D4P_ID")
    nTotSB1  := SB1->(RecCount())

    // Define quais campos serão utilizados no FWBulk
    AAdd(aFields, {"D4P_FILIAL"})
    AAdd(aFields, {"D4P_ID"})
    AAdd(aFields, {"D4P_COD"}) 
    AAdd(aFields, {"D4P_OLDREV"})
    AAdd(aFields, {"D4P_OLDPRT"})
    AAdd(aFields, {"D4P_NEWREV"}) 
    AAdd(aFields, {"D4P_NEWPRT"})
    AAdd(aFields, {"D4P_DATEXE"})
    AAdd(aFields, {"D4P_HORA"})
    AAdd(aFields, {"D4P_REGRA"})
    oBulkD4P:SetFields(aFields)

    If lCanBulk
        // Insere registros na D4P para partes do tipo Insumo ou pelo ponto de entrada
        cAliTemp := InputD4P()
        If !Empty(cAliTemp)
            AddRecords(cAliTemp,oBulkD4P)
            (cAliTemp)->(DbCloseArea())
        EndIf

        // Insere registros na D4P para partes do tipo Gastos
        If !lUsaPE
            aRegraCP := GetParts(.F.)
            For nX := 1 to Len(aRegraCP)
                If aRegraCP[nX][2] == "99"
                    cAliTemp := ExpenseD4P(,.T.)
                Else
                    cAliTemp := ExpenseD4P(aRegraCP[nX],.F.)
                EndIf 
            
                If !Empty(cAliTemp)
                    AddRecords(cAliTemp,oBulkD4P)
                    (cAliTemp)->(DbCloseArea())
                EndIf
            Next nX
        Else
            cAlias := GenTempD4P(.F.)
            DbSelectArea("D4P")
            D4P->(DbSetOrder(2))

            DbSelectArea("SB1")
            SB1->(DbSetOrder(1))
            SB1->(DbGoTop())

            Do While (cAlias)->(!Eof())
                If SB1->(DbSeek((cAlias)->(FILIAL+PRODUT)))
                    ExecRule(@nContador,oMsgRun,(cAlias)->(RECNO))
                    SetMessage(@nContador,@nTotalReg,nTotSB1,oMsgRun,.T.)
                EndIf
                (cAlias)->(DbSkip())
            EndDo

            If Select(cAlias) > 0
                (cAlias)->(DbCloseArea())
            EndIf
        EndIf

        // Confirma numero sugerido para o Id de execução
        If GetSx8Len() > 0
            ConfirmSx8()
        EndIf
    EndIf

    oBulkD4P:Destroy()
    oBulkD4P := nil

Return lRet

/*/{Protheus.doc} InsertD4G
    Insere registros na D4G
    @type Function
    @author Squad Entradas
    @since 25/09/2025
    @version 12.1.2510
/*/
Static Function InsertD4G()
    Local oBulkD4G as object
    Local lCanBulk as logical
    Local aFields  as array
    Local aData    as array
    Local cAlias   as character

    oBulkD4G := FWBulk():New(RetSqlName("D4G"), 500)
    lCanBulk := oBulkD4G:CanBulk()
    cAlias   := GenTempD4P(.T.)
    
    If lCanBulk
        aFields := {}
        AAdd(aFields, {"D4G_FILIAL"})
        AAdd(aFields, {"D4G_REVIS"}) 
        AAdd(aFields, {"D4G_CODPAR"})
        AAdd(aFields, {"D4G_PRODUT"})
        oBulkD4G:SetFields(aFields)

        Do While !(cAlias)->(EoF())
            aData := {}
            AAdd(aData, (cAlias)->FILIAL)  //1 - FILIAL
            AAdd(aData, cNewRev)           //2 - REVISAO
            AAdd(aData, (cAlias)->CODPAR)  //3 - PARTE
            AAdd(aData, (cAlias)->PRODUT)  //4 - CODIGO
            If !oBulkD4G:AddData(aData)
                UserException("Erro inclusão D4G: "+oBulkD4G:GetError())
            EndIf
            (cAlias)->(DbSkip())
        EndDo

        If !oBulkD4G:Close()
            UserException("Erro inclusão D4G: "+oBulkD4G:GetError())
        EndIf
    EndIf

    If Select(cAlias) > 0
        (cAlias)->(DbCloseArea())
    EndIf

    oBulkD4G:Destroy()
    oBulkD4G := nil

Return

/*/{Protheus.doc} GetParts
    Converte a expressão do filtro para SQL
    @type Function
    @author Squad Entradas
    @since 16/09/2025
    @version 12.1.2510
/*/
Static Function GetParts(lInput)
    Local aRegraCP := {} as array
    Local nX       as integer
    
    If lInput
        For nX := 1 to Len(aPartes)
            If aPartes[nX][7] == "1"
                AAdd(aRegraCP,{aPartes[nX][6],aPartes[nX][3]})
            EndIf
        Next nX
    Else
        For nX := 1 to Len(aPartes)
            If aPartes[nX][7] == "2"
                AAdd(aRegraCP,{aPartes[nX][6],aPartes[nX][3]})
            EndIf
        Next nX
        AAdd(aRegraCP,{"","99"})
    EndIf

Return aRegraCP

/*/{Protheus.doc} InputD4P
    Retorna as novas partes para os produtos do tipo Insumo
    @type Function
    @author Squad Entradas
    @since 16/09/2025
    @version 12.1.2510
/*/
Static Function InputD4P()
    local aRegraCP  as array
    local oQueryD4P as object
    local cWith     as character
    local cQuery    as character
    local cIsNull   := MatIsNull() as character
    local cAliTemp  as character
    local nX        := 1 as integer
    local nY        as integer

    // Retorna as partes do tipo Insumo
    aRegraCP := GetParts(.T.)

    // Monta o CTE dos produtos vinculado a sua respectiva parte
    cWith := " WITH TEMPTABLE AS ( "
    cWith += " SELECT SB1.B1_FILIAL FILIAL,SB1.B1_COD COD, "
    If !lUsaPE
        If Len(aRegraCP) > 0
            cWith += " CASE "
            For nY := 1 to Len(aRegraCP)
                cWith += " WHEN "+aRegraCP[nY][1]+" THEN '"+aRegraCP[nY][2]+"' "
            Next nY
            cWith += " ELSE '99' END NEWPRT "
        Else
            cWith += " '99' NEWPRT "
        EndIf
    Else
        cWith += " ' ' NEWPRT "
    EndIf
    cWith += " FROM "+RetSqlName("SB1")+" SB1 "
    cWith += " WHERE "
    If !lUsaPE
        cWith += " SB1.B1_COD NOT LIKE ? AND "
        cWith += " SB1.B1_CCCUSTO = ? AND"
    EndIf
    cWith += " SB1.D_E_L_E_T_ = ? ) "

    // Monta o Select para inserir na D4P
    cQuery := " SELECT TMP.FILIAL,TMP.COD, "
    cQuery += cIsNull+"(D4FO.D4F_REVIS,' ') OLDREV, "
    cQuery += cIsNull+"(D4G.D4G_CODPAR,' ') OLDPRT, "
    If !lUsaPE
        cQuery += " D4FN.D4F_REVIS NEWREV, D4FN.D4F_REGRA REGRA, "
    Else
        cQuery += " '"+cNewRev+"' NEWREV, ' ' REGRA, "
    EndIf
    cQuery += " TMP.NEWPRT NEWPRT "
    cQuery += " FROM TEMPTABLE TMP "
    If !lUsaPE
        cQuery += " INNER JOIN "+RetSqlName("D4F")+" D4FN ON "
        cQuery += " D4FN.D4F_FILIAL = ? AND "
        cQuery += " D4FN.D4F_REVIS = ? AND "
        cQuery += " D4FN.D4F_CODPAR = TMP.NEWPRT AND "
        cQuery += " D4FN.D4F_TIPO = ? AND "
        cQuery += " D4FN.D_E_L_E_T_ = ? "
    EndIf
    cQuery += " LEFT JOIN "+RetSqlName("D4G")+" D4G ON "
    cQuery += " D4G.D4G_FILIAL = TMP.FILIAL AND "
    cQuery += " D4G.D4G_PRODUT = TMP.COD AND "
    cQuery += " D4G.D4G_REVIS = ? AND "
    cQuery += " D4G.D_E_L_E_T_ = ? "
    cQuery += " LEFT JOIN "+RetSqlName("D4F")+" D4FO ON "
    cQuery += " D4FO.D4F_FILIAL = ? AND "
    cQuery += " D4FO.D4F_REVIS = ? AND "
    cQuery += " D4FO.D4F_CODPAR = D4G.D4G_CODPAR AND "
    cQuery += " D4FO.D_E_L_E_T_ = ? "

    cQuery := ChangeQuery(cQuery)

    oQueryD4P := FWExecStatement():New(cWith+cQuery)
    
    If !lUsaPE
        oQueryD4P:SetString(nX++,"MOD%")
        oQueryD4P:SetString(nX++," ")
    EndIf
    oQueryD4P:SetString(nX++," ")
    If !lUsaPE
        oQueryD4P:SetString(nX++,FWxFilial("D4F"))
        oQueryD4P:SetString(nX++,cNewRev)
        oQueryD4P:SetString(nX++,"1")
        oQueryD4P:SetString(nX++,' ')
    EndIf
    oQueryD4P:SetString(nX++,cOldRev)
    oQueryD4P:SetString(nX++,' ')
    oQueryD4P:SetString(nX++,FWxFilial("D4F"))
    oQueryD4P:SetString(nX++,cOldRev)
    oQueryD4P:SetString(nX++,' ')

    cAliTemp := oQueryD4P:OpenAlias()

    oQueryD4P:Destroy()
	FwFreeObj(oQueryD4P)

Return cAliTemp

/*/{Protheus.doc} ExpenseD4P
    Retorna as novas partes para os produtos do tipo Gastos
    @type Function
    @author Squad Entradas
    @since 16/09/2025
    @version 12.1.2510
/*/
Static Function ExpenseD4P(aRegraCP,lLastPart)
    local oQueryD4P as object
    local cWith     as character
    local cQuery    as character
    local cIsNull   := MatIsNull() as character
    local cAliTemp  as character
    local nX        := 1 as integer

    // Monta o CTE dos produtos vinculado a sua respectiva parte
    cWith := " WITH TEMPTABLE AS ( "
    cWith += " SELECT SB1.B1_FILIAL FILIAL,SB1.B1_COD COD, "
    If !lLastPart
        cWith += " CASE WHEN "+aRegraCP[1]+" THEN '"+aRegraCP[2]+"' "
        cWith += " END NEWPRT "
    Else
        cWith += " '99' NEWPRT "
    EndIf
    cWith += " FROM "+RetSqlName("SB1")+" SB1 "
    cWith += " WHERE "
    cWith += " (SB1.B1_COD LIKE ? OR SB1.B1_CCCUSTO <> ?) AND "
    cWith += " SB1.D_E_L_E_T_ = ? )"

    // Monta o Select para inserir na D4P
    cQuery := " SELECT TMP.FILIAL,TMP.COD, "
    cQuery += cIsNull+"(D4FO.D4F_REVIS,' ') OLDREV, "
    cQuery += cIsNull+"(D4G.D4G_CODPAR,' ') OLDPRT, "
    cQuery += " D4FN.D4F_REVIS NEWREV,TMP.NEWPRT NEWPRT,D4FN.D4F_REGRA REGRA "
    cQuery += " FROM TEMPTABLE TMP "
    cQuery += " INNER JOIN "+RetSqlName("D4F")+" D4FN ON "
    cQuery += " D4FN.D4F_FILIAL = ? AND "
    cQuery += " D4FN.D4F_REVIS = ? AND "
    cQuery += " D4FN.D4F_CODPAR = TMP.NEWPRT AND "
    cQuery += " D4FN.D4F_TIPO = ? AND "
    cQuery += " D4FN.D_E_L_E_T_ = ? "
    cQuery += " LEFT JOIN "+RetSqlName("D4G")+" D4G ON "
    cQuery += " D4G.D4G_FILIAL = TMP.FILIAL AND "
    cQuery += " D4G.D4G_PRODUT = TMP.COD AND "
    cQuery += " D4G.D4G_REVIS = ? AND "
    cQuery += " D4G.D_E_L_E_T_ = ? "
    cQuery += " LEFT JOIN "+RetSqlName("D4F")+" D4FO ON "
    cQuery += " D4FO.D4F_FILIAL = ? AND "
    cQuery += " D4FO.D4F_REVIS = ? AND "
    cQuery += " D4FO.D4F_CODPAR = D4G.D4G_CODPAR AND "
    cQuery += " D4FO.D_E_L_E_T_ = ? "
    If lLastPart
        cQuery += " LEFT JOIN "+RetSqlName("D4P")+" D4P ON "
        cQuery += " D4P.D4P_FILIAL = TMP.FILIAL AND "
        cQuery += " D4P.D4P_ID = ? AND "
        cQuery += " D4P.D4P_COD = TMP.COD AND "
        cQuery += " D4P.D_E_L_E_T_ = ? "
        cQuery += " WHERE D4P.D4P_COD IS NULL "
    EndIf

    cQuery := ChangeQuery(cQuery)

    oQueryD4P := FWExecStatement():New(cWith+cQuery)
        
    oQueryD4P:SetString(nX++,"MOD%")
    oQueryD4P:SetString(nX++," ")
    oQueryD4P:SetString(nX++," ")
    oQueryD4P:SetString(nX++,FWxFilial("D4F"))
    oQueryD4P:SetString(nX++,cNewRev)
    If lLastPart
        oQueryD4P:SetString(nX++,"1")
    Else
        oQueryD4P:SetString(nX++,"2")
    EndIf
    oQueryD4P:SetString(nX++,' ')
    oQueryD4P:SetString(nX++,cOldRev)
    oQueryD4P:SetString(nX++,' ')
    oQueryD4P:SetString(nX++,FWxFilial("D4F"))
    oQueryD4P:SetString(nX++,cOldRev)
    oQueryD4P:SetString(nX++,' ')
    If lLastPart
        oQueryD4P:SetString(nX++,cIDExec)
        oQueryD4P:SetString(nX++,' ')
    EndIf

    cAliTemp := oQueryD4P:OpenAlias()

    oQueryD4P:Destroy()
	FwFreeObj(oQueryD4P)

Return cAliTemp

/*/{Protheus.doc} NextPg01
    Validações ao clicar em Avançar na primeira página
    @type Function
    @author Squad Entradas
    @since 16/09/2025
    @version 12.1.2510
/*/
Static Function NextPg01(oDlg)
    Local lRet := .T. as logical

    If Empty(cNewRev)
        MsgAlert(STR0027) //"Para avançar, informe uma revisão"
        lRet := .F.
    EndIf

    If lRet        
        // Retorna um array com as partes da revisão informada
        If Len(aPartes) == 0
            aPartes := RetPartes()
        EndIf

        If Valtype(oBrowse2) == "O"
            oBrowse2:SetArray(aPartes)
            oBrowse2:Refresh()
            oBrowse2:GoTop()
        EndIf
    EndIf

Return lRet

/*/{Protheus.doc} UpdStatD4F
    Atualiza o status das revisões na D4F
    @type Function
    @author Squad Entradas
    @since 16/09/2025
    @version 12.1.2510
/*/
Static Function UpdStatD4F()
    local cSeek   as character

    If !(cOldRev == cNewRev)
        // Desativa a revisão antiga
        cSeek := FWxFilial("D4F")+cOldRev
        DbSelectArea("D4F")
        D4F->(DbSetOrder(1))
        D4F->(DbSeek(cSeek))
        
        Do While D4F->(!Eof()) .And. D4F->D4F_FILIAL+D4F->D4F_REVIS == cSeek
            Reclock("D4F",.F.)
            D4F->D4F_STATUS := "2"
            D4F->(MsUnlock())
            D4F->(DbSkip())
        EndDo

        // Ativa a nova revisão
        cSeek := FWxFilial("D4F")+cNewRev
        D4F->(DbSeek(cSeek))
        
        Do While D4F->(!Eof()) .And. D4F->D4F_FILIAL+D4F->D4F_REVIS == cSeek
            Reclock("D4F",.F.)
            D4F->D4F_STATUS := "1"
            D4F->(MsUnlock())
            D4F->(DbSkip())
        EndDo
    EndIf
Return

/*/{Protheus.doc} SvgCheck
    Ícone de check positivo
    @type Function
    @author Squad Entradas
    @since 16/09/2025
    @version 12.1.2510
/*/
Static Function SvgCheck()
    Local cSVG as character

    cSVG := "<?xml version='1.0' encoding='UTF-8' standalone='no'?>"
    cSVG += "<svg viewBox='0 0 90 90' width='21' height='21' xmlns='http://www.w3.org/2000/svg'>"
    cSVG += "<g stroke='#62d462ff' stroke-width='2.3' fill='#62d462ff'> "
	cSVG += "<circle cx='45' cy='45' r='30'/> "
	cSVG += "</g> "
    cSVG += "<g transform='scale(1.8) translate(14,15)' fill='#fff'> "
  	cSVG += "<path d='M20.285 2l-11.285 11.567-5.286-5.011-3.714 3.716 9 8.728 15-15.285z'/> "
    cSVG += "</g>"
    cSVG += "</svg>"

Return cSVG

/*/{Protheus.doc} SvgWait
    XML do ícone de loading animado em SVG.
    @type Function
    @author Squad Entradas
    @since 16/09/2025
    @version 12.1.2510
/*/
Static Function SvgWait()

    Local cSVG As character

    cSVG := "<svg viewBox='0 0 90 90' width='21' height='21' version='1.1' xmlns='http://www.w3.org/2000/svg'>"
    If cTheme == "SUNSET"
        cSVG += "<circle fill='#C8102E' cx='45' cy='45' r='30'/>"
    Else
        cSVG += "<circle fill='#33A9FF' cx='45' cy='45' r='30'/>"
    EndIf
    cSVG += "<g transform='translate(45,45)'>"
    cSVG += "<circle fill='#FFF' cx='-12' cy='0' r='4' opacity='0'>"
    cSVG += "<animate attributeName='opacity' values='0;1;0' dur='1.2s' repeatCount='indefinite' begin='0s'/>"
    cSVG += " </circle>"
    cSVG += "<circle fill='#FFF' cx='0' cy='0' r='4' opacity='0'>"
    cSVG += "<animate attributeName='opacity' values='0;1;0' dur='1.2s' repeatCount='indefinite' begin='0.4s'/>"
    cSVG += "</circle>"
    cSVG += "<circle fill='#FFF' cx='12' cy='0' r='4' opacity='0'>"
    cSVG += "<animate attributeName='opacity' values='0;1;0' dur='1.2s' repeatCount='indefinite' begin='0.8s'/>"
    cSVG += "</circle>"
    cSVG += "</g>"
    cSVG += "</svg>"


Return cSVG

/*/{Protheus.doc} GenReport
    Geração do relatório de Conferência
    @type Function
    @author Squad Entradas
    @since 16/09/2025
    @version 12.1.2510
/*/
Static Function GenReport()
    Local lSuccess   := .T. as logical
    Local cPerg      := "ESTT042" as character
    Local oSmartView as object

    oSmartView := totvs.framework.smartview.callSmartView():new("backoffice.sv.est.costbreakdownprecheck")
    oSmartView:setForceParams(.T.)

    If FWSX1Util():ExistPergunte(cPerg)
        oSmartView:setParam("MV_PAR01",cIDExec,"Disabled")
        oSmartView:setParam("MV_PAR02",cOldRev,"Disabled")
        oSmartView:setParam("MV_PAR03",cNewRev,"Disabled")
    EndIf

    lSuccess := oSmartView:executeSmartView(.T.)

    If lSuccess
        RefreshUI(2)
        lCanProc   := .T.
    EndIf

    oSmartView:destroy()
    freeObj(oSmartView)

Return lSuccess

/*/{Protheus.doc} CloseWiz
    Função acionada ao clicar em Cancelar ou Concluir no step 3
    @type Function
    @author Squad Entradas
    @since 16/09/2025
    @version 12.1.2510
/*/
Static Function CloseWiz(oDlg,lCancel)
    Local lRet as logical

    If lCanGenRpt .Or. lCanProc
        If lCancel
            If msgYesNo(STR0032) //"Ao cancelar, será necessário refazer o pré-processamento. Deseja prosseguir com o cancelamento?" 
                oDlg:End()
            EndIf
        Else
            If msgYesNo(STR0060) //"Ao concluir, o processamento será cancelado. Deseja prosseguir?" 
                oDlg:End()
            EndIf
        EndIf
    Else
        oDlg:End()
    EndIf

Return lRet

/*/{Protheus.doc} PreProcess
    Função responsável pelas validações antes do ínicio da Efetivação
    @type Function
    @author Squad Entradas
    @since 16/09/2025
    @version 12.1.2510
/*/
Static Function PreProcess()
    Local lRet := .T. as logical

    If !lCanProc
        If !msgYesNo(STR0033) //"A conferência não foi realizada. Deseja prosseguir com a efetivação mesmo assim?"
            lRet := .F.
        EndIf
    EndIf

    If lRet
        If lCanGenRpt
            RefreshUI(3)
            lCanGenRpt := .F.
            lCanProc   := .F.
        EndIf
        //Efetiva o processamento
        FWMsgRun(,{|oMsgRun|RunProcess(oMsgRun)},STR0014,STR0034) //"Vinculando os produtos às partes..."
    EndIf

Return lRet

/*/{Protheus.doc} RunProcess
    Função responsável por efetivar o processamento
    @type Function
    @author Squad Entradas
    @since 16/09/2025
    @version 12.1.2510
/*/
Static Function RunProcess(oMsgRun)
    Local nPartes as integer

    //Deleta os registros na D4G para a revisão vigente (em caso de reprocessamento)
    If HasD4GRec()
        SetMessage(Nil,Nil,Nil,oMsgRun,.F.,STR0056)
        DeleteD4G()
    EndIf

    //Inclui os registros na D4G para a revisão vigente
    SetMessage(Nil,Nil,Nil,oMsgRun,.F.,STR0034)
    InsertD4G()
        
    //Quando utilizado ponto de entrada, importa os saldos para as novas tabelas
    If lUsaPE
        If HasD4IRec()
            SetMessage(Nil,Nil,Nil,oMsgRun,.F.,STR0057)
            DelBalCP()
        EndIf
        nPartes := Len(aPartes)+1

        //Inclui registros na tabela D4I
        SetMessage(Nil,Nil,Nil,oMsgRun,.F.,STR0058)
        InsertD4I(nPartes)

        //Inclui registros na tabela D4O
        SetMessage(Nil,Nil,Nil,oMsgRun,.F.,STR0059)
        InsertD4O(nPartes)
    EndIf

    //Atualiza o status das revisões
    UpdStatD4F()

    //Atualiza as variáveis de controle
    RefreshUI(4)
    lEfetivar  := .F.
    lIsDone    := .T.

Return

/*/{Protheus.doc} WCPIniSxe
    Função responsável por buscar a próxima numeração do campo D4P_ID
    @type Function
    @author Squad Entradas
    @since 16/09/2025
    @version 12.1.2510
/*/
Static Function WCPIniSxe(cTab, cCpo)
	Local cRet := GetSxeNum(cTab,cCpo)

	While .T.
		(cTab)->(dbSetOrder(2))
		If (cTab)->(dbSeek( FWxFilial(cTab) + cRet ))
			ConfirmSX8()
			cRet := GetSxeNum(cTab,cCpo)
			Loop
		Else
			Exit
		EndIf
	EndDo
Return cRet

/*/{Protheus.doc} GenTempD4P
    Gera uma temporária da D4P com base no ID para gravação na D4G.
    @type Function
    @author Squad Entradas
    @since 16/09/2025
    @version 12.1.2510
/*/
Static Function GenTempD4P(lGroupBy)
    Local oQuery as object
    Local cQuery as character
    Local cAlias as character

    cQuery := " SELECT D4P_FILIAL FILIAL,D4P_COD PRODUT,D4P_NEWPRT CODPAR "
    If !lGroupBy
        cQuery += " , D4P.R_E_C_N_O_ RECNO "
    EndIf
    cQuery += " FROM "+RetSQLName("D4P")+" D4P "
    cQuery += " WHERE D4P_ID = ? AND "
    cQuery += " D4P.D_E_L_E_T_ = ? "
    If lGroupBy
        cQuery += " GROUP BY D4P_FILIAL,D4P_COD,D4P_NEWPRT "
    EndIf
    cQuery := ChangeQuery(cQuery)

    oQuery := FWExecStatement():New(cQuery)

    oQuery:SetString(1,cIDExec)
    oQuery:SetString(2,' ')

    cAlias := oQuery:OpenAlias()

    oQuery:Destroy()
	FwFreeObj(oQuery)

Return cAlias

/*/{Protheus.doc} CanGoBack3
    Função que valida se o usuário pode voltar do step 3 para o 2.
    @type Function
    @author Squad Entradas
    @since 16/09/2025
    @version 12.1.2510
/*/
Static Function CanGoBack3()
    Local lRet := .T. as logical

    //Não permite Voltar quando está na etapa de conferência ou com processo finalizado
    If lCanGenRpt
        MsgAlert(STR0036) //"Após o pré-processamento, não é possível Voltar."
        lRet := .F.
    ElseIf lIsDone
        MsgAlert(STR0037) //"Após o término do processamento, não é possível Voltar."
        lRet := .F.
    EndIf

Return lRet

/*/{Protheus.doc} D4PIniPad
