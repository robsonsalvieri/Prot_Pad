Function D4PIniPad(cField)
Return " "

/*/{Protheus.doc} AddRecords
    Adiciona registros no objeto oBulk para inclusão via Insert
    @type Function
    @author Squad Entradas
    @since 16/09/2025
    @version 12.1.2510
/*/
Static Function AddRecords(cAliTemp,oBulkD4P)
    Local aData    as array
    Local nTamHora := TamSx3("D4P_HORA")[1] as integer

    Do While !(cAliTemp)->(EoF())
        aData := {}
        AAdd(aData, (cAliTemp)->FILIAL)         //1 - FILIAL
        AAdd(aData, cIDExec)                    //2 - ID
        AAdd(aData, (cAliTemp)->COD)            //3 - CODIGO
        AAdd(aData, (cAliTemp)->OLDREV)         //4 - REVISAO ANTERIOR
        AAdd(aData, (cAliTemp)->OLDPRT)         //5 - PARTE ANTERIOR
        AAdd(aData, cNewRev)                    //6 - NOVA REVISAO
        AAdd(aData, (cAliTemp)->NEWPRT)         //7 - NOVA PARTE
        AAdd(aData, DtoS(MsDate()))             //8 - DATA DA EXECUCAO
        AAdd(aData, SubStr(Time(),1,nTamHora))  //9 - HORA DA EXECUCAO 
        AAdd(aData, (cAliTemp)->REGRA)          //10 - REGRA
        If !oBulkD4P:AddData(aData)
            lRet := .F.
            UserException(STR0044+oBulkD4P:GetError()) //"Erro na inclusão de registros na tabela D4P: "
        EndIf
        (cAliTemp)->(DbSkip())
    EndDo

    If !oBulkD4P:Close()
        lRet := .F.
        UserException(STR0044+oBulkD4P:GetError()) //"Erro na inclusão de registros na tabela D4P: "
    EndIf

Return

/*/{Protheus.doc} CheckStock
    Valida se existem registros de fechamento para o custo em partes no período anterior
    que não foram importados do modelo antigo
    @type Function
    @author Squad Entradas
    @since 13/10/2025
    @version 12.1.2510
/*/
Static Function CheckStock()
    local cQuery as character
    local lRet   as logical

    // Busca a data do último fechamento
    cQuery := " SELECT COUNT(R_E_C_N_O_) RECNO "
    cQuery += " FROM "+RetSQLName('D4I')+" D4I "
    cQuery += " WHERE D4I.D4I_FILIAL = ? "
    cQuery += " AND D4I.D4I_DATA = ? "
    cQuery += " AND D4I.D4I_MANUAL <> ? "
    cQuery += " AND D4I.D_E_L_E_T_ = ? "
    cQuery := ChangeQuery(cQuery)
    
    oQuery := FwExecStatement():New(cQuery)

    oQuery:SetString(1, FWxFilial('D4I'))
    oQuery:SetString(2, cDtUlMes)
    oQuery:SetString(3, "I")
	oQuery:SetString(4, ' ')

    lRet := oQuery:ExecScalar('RECNO') > 0

    oQuery:Destroy()
	FwFreeObj(oQuery)

Return lRet

/*/{Protheus.doc} VldImport
    Valições ao marcar/desmarcar o checkbox de importação do PE
    @type Function
    @author Squad Entradas
    @since 13/10/2025
    @version 12.1.2510
/*/
Static Function VldImport()
    local nX as integer

    If !lUsaPE
        //Valida se foi informado o código da revisão
        If Empty(cNewRev)
            MsgAlert(STR0045) //"Por favor, informe o código da revisão"
            Return
        EndIf

        If !CheckStock()
            If Empty(aPartes)
                aPartes := RetPartes()
            EndIf
            If Len(aPartes) == Len(aRegraPE)
                For nX := 1 to Len(aPartes)
                    aPartes[nX][8] := aRegraPE[nX]
                Next nX
                lUsaPE := .T.
            Else
                MsgAlert(STR0046) //"O ponto de entrada possui uma quantidade de partes diferente da cadastrada na revisão."
            EndIf
        Else
            MsgAlert(STR0047) //"Não será possível prosseguir devido à existência de fechamentos de estoque nas tabelas de custo em partes no período anterior."
        EndIf

        If lUsaPE
            If ValType(oBrowse2) == "O"
                oBrowse2:aDefaultColumns[4]:bData := {|| aPartes[oBrowse2:At()][8] }
            EndIf
        EndIf
    Else
        If ValType(oBrowse2) == "O"
            oBrowse2:aDefaultColumns[4]:bData := {|| aPartes[oBrowse2:At()][6] }
        EndIf
        lUsaPE := .F.
    EndIf

Return

/*/{Protheus.doc} VldRev
    Valida a revisão informada
    @type Function
    @author Squad Entradas
    @since 13/10/2025
    @version 12.1.2510
/*/
Static Function VldRev()
    local lRet as logical
    local nX   as integer

    If !Empty(cNewRev)
        DbSelectArea("D4F")
        DbSetOrder(1)
        If DbSeek(FWxFilial("D4F")+cNewRev)
            If D4F->D4F_STATUS == "0" .Or. D4F->D4F_STATUS == "1"
                lRet := .T.
            Else
                MsgAlert(STR0028) //"A revisão informada não está em rascunho ou vigente" 
            EndIf
        Else
            MsgAlert(STR0029) //"A revisão informada não foi localizada" 
        EndIf
    Else
        lRet := .T.
    EndIf

    If lRet .And. !Empty(cNewRev)
        aPartes := RetPartes()
        If lUsaPE
            If Len(aPartes) == Len(aRegraPE)
                For nX := 1 to Len(aPartes)
                    aPartes[nX][8] := aRegraPE[nX]
                Next nX
            Else
                MsgAlert(STR0049) //"O ponto de entrada possui uma quantidade de partes diferente do que o cadastrado na revisão informada"
                lRet := .F.
            EndIf
        EndIf
    EndIf

Return lRet

/*/{Protheus.doc} ExecRule
    Executa a regra do ponto de entrada para identificar a parte do produto
    @type Function
    @author Squad Entradas
    @since 13/10/2025
    @version 12.1.2510
/*/
Static Function ExecRule(nContador,oMsgRun,nRecno)
    local nParte as integer
    local nX     as integer
    local cForm  as character
     
    For nX := 1 to Len(aPartes)
        cForm := AllTrim(aPartes[nX][8])
        If &cForm
            nParte := nX
            Exit
        EndIf
    Next nX

    D4P->(DbGoTo(nRecno))

    Reclock("D4P",.F.)
    If nParte == 0
        D4P->D4P_NEWPRT := '99'
    Else
        D4P->D4P_NEWPRT := aPartes[nParte][3]
        D4P->D4P_REGRA  := aPartes[nParte][8]
    EndIf
    D4P->(MsUnlock())
    nContador++

Return

/*/{Protheus.doc} SetMessage
    Atualiza a mensagem apresentada durante o vínculo dos produtos às partes
    @type Function
    @author Squad Entradas
    @since 13/10/2025
    @version 12.1.2510
/*/
Static Function SetMessage(nContador,nTotalReg,nTotSB1,oMsgRun,lContador,cMsg)

    If lContador
        If nContador == 100
            nTotalReg += 100
            oMsgRun:cCaption := STR0050+cValtOChar(nTotalReg)+ "/"+cValToChar(nTotSB1) //"Atribuindo produtos às partes definidas... Produtos: "
            nContador := 0
        EndIf
    Else
        oMsgRun:cCaption := cMsg
    EndIf
    ProcessMessages()

Return

/*/{Protheus.doc} InsertD4I
    Insere registros na D4I
    @type Function
    @author Squad Entradas
    @since 25/09/2025
    @version 12.1.2510
/*/
Static Function InsertD4I(nPartes)
    Local oBulkD4I as object
    Local lCanBulk as logical
    Local aFields  as array
    Local aData    as array
    Local cAlias   as character
    Local nX       as integer

    oBulkD4I := FWBulk():New(RetSqlName("D4I"), 500)
    lCanBulk := oBulkD4I:CanBulk()
    
    If lCanBulk
        aFields := {}
        AAdd(aFields, {"D4I_FILIAL"})
        AAdd(aFields, {"D4I_COD"}) 
        AAdd(aFields, {"D4I_LOCAL"})
        AAdd(aFields, {"D4I_DATA"})
        AAdd(aFields, {"D4I_REVISA"})
        AAdd(aFields, {"D4I_PARTE"})
        AAdd(aFields, {"D4I_MOEDA"})
        AAdd(aFields, {"D4I_UNITAR"})
        AAdd(aFields, {"D4I_TOTAL"})
        AAdd(aFields, {"D4I_MANUAL"})
        oBulkD4I:SetFields(aFields)

        For nX := 1 to nPartes
            If nX == nPartes
                cParte := StrZero(Len(aRegraPE)+1,2)
                cAlias := GenTempD4I(cParte)
                cParte := "99"
            Else
                cParte := aPartes[nX][3]
                cAlias := GenTempD4I(cParte)
            EndIf
            Do While !(cAlias)->(EoF())
                aData := {}
                AAdd(aData, (cAlias)->FILIAL)  //1 - FILIAL
                AAdd(aData, (cAlias)->COD)     //2 - CODIGO
                AAdd(aData, (cAlias)->ARMAZEM) //3 - LOCAL
                AAdd(aData, (cAlias)->DATA)    //4 - DATA
                AAdd(aData, cNewRev)           //5 - REVISAO
                AAdd(aData, cParte)            //6 - PARTE
                AAdd(aData, (cAlias)->MOEDA)   //7 - MOEDA
                AAdd(aData, (cAlias)->UNITAR)  //8 - VLR UNITARIO
                AAdd(aData, (cAlias)->TOTAL)   //9 - VLR TOTAL
                AAdd(aData, "I")               //10 - MANUAL
                If !oBulkD4I:AddData(aData)
                    UserException("Erro inclusão D4G: "+oBulkD4I:GetError())
                EndIf
                (cAlias)->(DbSkip())
            EndDo

            If !oBulkD4I:Close()
                UserException("Erro inclusão D4G: "+oBulkD4I:GetError())
            EndIf

            If Select(cAlias) > 0
                (cAlias)->(DbCloseArea())
            EndIf
        Next nX
    EndIf

    oBulkD4I:Destroy()
    oBulkD4I := nil

Return

/*/{Protheus.doc} GenTempD4I
    Gera uma temporária da D4P com base no ID para gravação na D4G.
    @type Function
    @author Squad Entradas
    @since 16/09/2025
    @version 12.1.2510
/*/
Static Function GenTempD4I(cParte)
    Local cQuery   as character
    Local cQueryD4I as character
    Local cAlias   as character
    Local nX       as integer
    Local nZ       := 1 as integer
    Local aMoedas  := {} as array
    Local cMoedaCM := SuperGetMV("MV_MOEDACM",.F.,'2345')

    //Adiciona as moedas adicionais no array aMoedas
    AAdd(aMoedas,"01")
    For nX := 2 To 5
        If cValToChar(nX) $ cMoedaCM
            AAdd(aMoedas,StrZero(nX,2))
        EndIf
    Next nX

    If oQueryD4I == Nil
        cQuery := " SELECT SB9.B9_FILIAL FILIAL, SB9.B9_COD COD, SB9.B9_LOCAL ARMAZEM, SB9.B9_DATA DATA, "
        cQuery += " ? MOEDA, SB9.B9_CPM?? UNITAR, SB9.B9_CP?? TOTAL "
        cQuery += " FROM "+RetSQLName("SB9")+" SB9 "
        cQuery += " WHERE SB9.B9_DATA = ? AND "
        cQuery += " SB9.D_E_L_E_T_ = ? "
        cQueryD4I := cQuery
        For nX := 2 to Len(aMoedas)
            cQueryD4I += " UNION ALL "+cQuery
        Next nX
        cQueryD4I := ChangeQuery(cQueryD4I)

        oQueryD4I := FWExecStatement():New(cQueryD4I)
    EndIf

    For nX := 1 to Len(aMoedas)
        oQueryD4I:SetString(nZ++,aMoedas[nX])
        oQueryD4I:SetUnsafe(nZ++,cParte)
        oQueryD4I:SetUnsafe(nZ++,aMoedas[nX])
        oQueryD4I:SetUnsafe(nZ++,cParte)
        oQueryD4I:SetUnsafe(nZ++,aMoedas[nX])
        oQueryD4I:SetString(nZ++,cDtUlMes)
        oQueryD4I:SetString(nZ++," ")
    Next nX

    cAlias := oQueryD4I:OpenAlias()

Return cAlias

/*/{Protheus.doc} InsertD4O
    Insere registros na D4O
    @type Function
    @author Squad Entradas
    @since 25/09/2025
    @version 12.1.2510
/*/
Static Function InsertD4O(nPartes)
    Local oBulkD4O as object
    Local lCanBulk as logical
    Local aFields  as array
    Local aData    as array
    Local cAlias   as character
    Local nX       as integer

    oBulkD4O := FWBulk():New(RetSqlName("D4O"), 500)
    lCanBulk := oBulkD4O:CanBulk()
    
    If lCanBulk
        aFields := {}
        AAdd(aFields, {"D4O_FILIAL"})
        AAdd(aFields, {"D4O_NUM"}) 
        AAdd(aFields, {"D4O_ITEM"})
        AAdd(aFields, {"D4O_SEQUEN"})
        AAdd(aFields, {"D4O_ITEMGR"})
        AAdd(aFields, {"D4O_OP"})
        AAdd(aFields, {"D4O_DATA"})
        AAdd(aFields, {"D4O_REVISA"})
        AAdd(aFields, {"D4O_PARTE"})
        AAdd(aFields, {"D4O_MOEDA"})
        AAdd(aFields, {"D4O_SLDINI"})
        AAdd(aFields, {"D4O_APRINI"})
        AAdd(aFields, {"D4O_MANUAL"})
        oBulkD4O:SetFields(aFields)

        For nX := 1 to nPartes
            If nX == nPartes
                cParte := StrZero(Len(aRegraPE)+1,2)
                cAlias := GenTempD4O(cParte)
                cParte := "99"
            Else
                cParte := aPartes[nX][3]
                cAlias := GenTempD4O(cParte)
            EndIf
            Do While !(cAlias)->(EoF())
                aData := {}
                AAdd(aData, (cAlias)->FILIAL)  //1 - FILIAL
                AAdd(aData, (cAlias)->NUM)     //2 - CODIGO
                AAdd(aData, (cAlias)->ITEM)    //3 - LOCAL
                AAdd(aData, (cAlias)->SEQUEN)  //4 - DATA
                AAdd(aData, (cAlias)->ITEMGRD) //5 - DATA
                AAdd(aData, (cAlias)->OP)      //6 - DATA
                AAdd(aData, cDtUlMes)          //7 - DATA
                AAdd(aData, cNewRev)           //8 - REVISAO
                AAdd(aData, cParte)            //9 - PARTE
                AAdd(aData, (cAlias)->MOEDA)   //10 - MOEDA
                AAdd(aData, (cAlias)->SLDINI)  //11 - VLR UNITARIO
                AAdd(aData, (cAlias)->APRINI)  //12 - VLR TOTAL
                AAdd(aData, "I")               //13 - MANUAL
                If !oBulkD4O:AddData(aData)
                    UserException("Erro inclusão D4O: "+oBulkD4O:GetError())
                EndIf
                (cAlias)->(DbSkip())
            EndDo

            If !oBulkD4O:Close()
                UserException("Erro inclusão D4O: "+oBulkD4O:GetError())
            EndIf

            If Select(cAlias) > 0
                (cAlias)->(DbCloseArea())
            EndIf
        Next nX
    EndIf

    oBulkD4O:Destroy()
    oBulkD4O := nil

Return

/*/{Protheus.doc} GenTempD4O
    Retorna as op's da SC2 que serão gravadas na D4O
    @type Function
    @author Squad Entradas
    @since 16/09/2025
    @version 12.1.2510
/*/
Static Function GenTempD4O(cParte)
    Local cQuery    as character
    Local cQueryD4I as character
    Local cAlias    as character
    Local nX        as integer
    Local nZ        := 1 as integer
    Local aMoedas   := {} as array
    Local cMoedaCM  := SuperGetMV("MV_MOEDACM",.F.,'2345')
    Local dDtUlmes  := SuperGetMV("MV_ULMES",.F.,SToD("19970101")) as date
    Local cDataIni  := DToS(CtoD("01/"+StrZero(Month(dDtUlmes),2,0)+"/"+StrZero(Year(dDtUlmes),4,0))) as character

    //Adiciona as moedas adicionais no array aMoedas
    AAdd(aMoedas,"01")
    For nX := 2 To 5
        If cValToChar(nX) $ cMoedaCM
            AAdd(aMoedas,StrZero(nX,2))
        EndIf
    Next nX

    If oQueryD4O == Nil
        cQuery := " SELECT SC2.C2_FILIAL FILIAL,SC2.C2_NUM NUM,SC2.C2_ITEM ITEM,SC2.C2_SEQUEN SEQUEN, "
        cQuery += " SC2.C2_ITEMGRD ITEMGRD,C2_NUM||C2_ITEM||C2_SEQUEN||C2_ITEMGRD OP,? MOEDA,SC2.C2_CPI?? SLDINI, "
        cQuery += " SC2.C2_API?? APRINI "
        cQuery += " FROM "+RetSQLName("SC2")+" SC2 "
        cQuery += " WHERE (SC2.C2_DATRF = ? OR (SC2.C2_DATRF >= ? AND SC2.C2_DATRF <= ?)) AND "
        cQuery += " SC2.D_E_L_E_T_ = ? "
        cQueryD4I := cQuery
        For nX := 2 to Len(aMoedas)
            cQueryD4I += " UNION ALL "+cQuery
        Next nX
        cQueryD4I := ChangeQuery(cQueryD4I)

        oQueryD4O := FWExecStatement():New(cQueryD4I)
    EndIf

    For nX := 1 to Len(aMoedas)
        oQueryD4O:SetString(nZ++,aMoedas[nX])
        oQueryD4O:SetUnsafe(nZ++,cParte)
        oQueryD4O:SetUnsafe(nZ++,aMoedas[nX])
        oQueryD4O:SetUnsafe(nZ++,cParte)
        oQueryD4O:SetUnsafe(nZ++,aMoedas[nX])
        oQueryD4O:SetString(nZ++,' ')
        oQueryD4O:SetString(nZ++,cDataIni)
        oQueryD4O:SetString(nZ++,cDtUlMes)
        oQueryD4O:SetString(nZ++," ")
    Next nX

    cAlias := oQueryD4O:OpenAlias()

Return cAlias

/*/{Protheus.doc} HasMA330CP
    Retorna se o ponto de entrada MA330CP está compilado, possui regras válidas
    e se os campos existem no dicionário
    @type Function
    @author Squad Entradas
    @since 23/10/2025
    @version 12.1.2510
/*/
Static Function HasMA330CP()
    Local lRet as logical

    //Avalia se utiliza o ponto de entrada MA330CP
    If ExistBlock("MA330CP")
        aRegraPE := ExecBlock("MA330CP",.F.,.F.)
        If ValType(aRegraPE) # "A"
            aRegraPE := {}
        EndIf
    EndIf

    If Len(aRegraPE) > 0
        lRet := MA330AvlCp(aRegraPE,{})
    EndIf

Return lRet

/*/{Protheus.doc} HasD4IRec
    Retorna se existem registros na D4I para o periodo importado pelo Wizard
    @type Function
    @author Squad Entradas
    @since 23/10/2025
    @version 12.1.2510
/*/
Static Function HasD4IRec()
    local cQuery as character
    local oQuery  as object
    local lRet    as logical

    cQuery := " SELECT CASE WHEN "
    cQuery += " EXISTS ( "
    cQuery += " SELECT 1 "
    cQuery += " FROM "+RetSqlName("D4I")+" D4I "
    cQuery += " WHERE D4I.D4I_MANUAL = ? AND "
    cQuery += " D4I.D_E_L_E_T_ = ? ) "
    cQuery += " THEN '1' ELSE '0' END RECNO "
    If AllTrim(TcGetDB()) == "ORACLE"
        cQuery += " FROM DUAL "
    EndIf

    oQuery := FWExecStatement():New(cQuery)

    oQuery:SetString(1,"I")
    oQuery:SetString(2,' ')

    lRet := oQuery:ExecScalar("RECNO") == "1"

    oQuery:Destroy()
	FwFreeObj(oQuery)

Return lRet

/*/{Protheus.doc} DelBalCP
    Deleta os registros na D4I e D4O para a revisão informada
    @type Function
    @author Squad Entradas
    @since 23/10/2025
    @version 12.1.2510
/*/
Static Function DelBalCP()
    local cDelete   as character
    local cErro     as character
    local nX        as integer
    local aTables   := {"D4I","D4O"}

    //Deleta os saldos iniciais das tabelas D4I e D40
    For nX := 1 to 2
        cDelete := " DELETE FROM "+RetSQLName(aTables[nX])+" WHERE "+aTables[nX]+"_MANUAL = 'I' "

        If TcSqlExec(cDelete) < 0
            cErro := TCSQLError()
            UserException(cErro)
        EndIf
    Next nX
Return

/*/{Protheus.doc} RefreshUI
    Atualiza os componentes visuais do step 3 a cada ação realizada
    @type Function
    @author Squad Entradas
    @since 24/10/2025
    @version 12.1.2510
/*/
Static Function RefreshUI(nOpc)

    If nOpc == 1
        oSvgPreProc:LoadSvg(SvgCheck())
        oSvgReport:LoadSvg(SvgWait())
        oSvgProcess:LoadSvg(SvgWait())
        If cTheme == "DARK"
            oSayReport:nClrText   := CLR_WHITE
            oSayReport2:nClrText  := CLR_WHITE
            oSayProcess:nClrText  := CLR_WHITE
            oSayProcess2:nClrText := CLR_WHITE
        Else
            oSayReport:nClrText   := CLR_BLACK
            oSayReport2:nClrText  := CLR_BLACK
            oSayProcess:nClrText  := CLR_BLACK
            oSayProcess2:nClrText := CLR_BLACK
        EndIf
        oSayPreProc2:nClrText := CLR_GRAY
        oSayPreProc3:nClrText := CLR_GRAY
        oSayPreProc:nClrText  := CLR_GRAY
        oSayReport:nLeft      := 44
        oSayProcess:nLeft     := 44
    ElseIf nOpc == 2
        oSvgReport:LoadSvg(SvgCheck())
        oSayReport:nClrText  := CLR_GRAY
        oSayReport2:nClrText := CLR_GRAY
    ElseIf nOpc == 3
        oSvgReport:LoadSvg(SvgCheck())
        oSayReport:nClrText  := CLR_GRAY
        oSayReport2:nClrText := CLR_GRAY
    Else
        oSvgProcess:LoadSvg(SvgCheck())
        oSayProcess:nClrText  := CLR_GRAY 
        oSayProcess2:nClrText := CLR_GRAY
        oStatus:lVisible      := .T.
        oSvgStatus:LoadSvg(SvgCheck())
    EndIf

Return
