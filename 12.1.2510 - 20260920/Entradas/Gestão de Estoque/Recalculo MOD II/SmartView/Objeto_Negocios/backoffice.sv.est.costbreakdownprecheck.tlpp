#include "msobject.ch"
#include "protheus.ch"
#include "backoffice.sv.est.costbreakdownprecheck.ch"
#include "totvs.framework.treports.integratedprovider.th"

#DEFINE SX1GRUPO 'ESTT042'

using namespace totvs.framework.treports.integratedprovider

namespace totvs.protheus.backoffice.est.costbreakdownprecheck.integratedprovider
  
@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGAEST", tables="D4P", customTables="D4P",name="Pré-Conferencia do Custo em Partes", country="ALL")
 
//-------------------------------------------------------------------
/*{Protheus.doc} CostBreakdownPreCheck
Classe para criação do Objeto de Negócio de Posição do Estoque
 
@author BackOffice
@since 04/2023
@version 1.0
*/
//-------------------------------------------------------------------  
Class CostBreakdownPreCheck From totvs.protheus.backoffice.est.smartView.integratedProvider.EstIntegratedProvider

	Public Method new()				as object
	Public Method getData()			as object

	Protected Method oNGetSchema()
	Protected data jItems		  as json
	Protected data cWhere		  as character
	Protected data aFieldsD4P	  as array
	Protected data lExistPergunte as logical	

EndClass
 
//-------------------------------------------------------------------
/*{Protheus.doc} new
Método de instância da classe
 
@return object: self
 
@author BackOffice
@since 04/2023
@version 1.0
*/
//-------------------------------------------------------------------   
Method new() Class CostBreakdownPreCheck

	Local lExecute	as logical

	_Super:new()

	//Define a Área
	self:appendArea(STR0001) //"Estoque/Custos"

	//Define o nome do Objeto de Negócio
	self:setDisplayName(STR0002) //"Pré-Conferência do Custo em Partes"
 
	//Define a descrição do Objeto de Negócio
	self:setDescription(STR0003) //"Emite uma relação dos vínculos que serão criados na efetivação do Wizard do Custo em Partes."

	//Indica o pergunte que será utilizado no relatório
	lExecute  := FnVldCMod2()
    self:lExistPergunte := (self:setPergunte( SX1GRUPO ) .And. lExecute)
	If !self:lExistPergunte
		self:setErrorStatus(400,STR0007,i18n(STR0008,{SX1GRUPO}))//O Grupo de perguntas #1 não existe		
		FWLogMsg('WARN', , 'SmartView', , , , i18n(STR0008,{SX1GRUPO}), , , )//O Grupo de perguntas #1 não existe
	EndIf
    
	//Indica que o LookUp será do tipo padrão LookUp
    self:setIsLookUp(.T.)

Return self

//-------------------------------------------------------------------
/*{Protheus.doc} getData
Retorna os dados do objeto de negócio
 
@param nPage, numérico, indica a página atual do relatório
@param oFilter, objeto, contém o filtro do TReports
 
@return object: self:oData
 
@author BackOffice
@since 04/2023
@version 1.0
*/
//-------------------------------------------------------------------   
Method getData( nPage as Numeric, oFilter as object) as object Class CostBreakdownPreCheck
	Local oQuery	as object
	Local cQuery	as character
	Local cFields	as character
	Local cAliasTmp	as character
	Local cCustom   as character
	Local nX	    as numeric
	Local nY		:= 1 as numeric
	Local aCustom   as array
	Local jParams   as json
	Local cIsNull	:= MatIsNull()

	//Valida o pergunte
	If !self:lExistPergunte	
		return self:oData
	Endif

	//Metodo para retorno do json dos parâmetros
    jParams  := oFilter:getParameters()

	//Se tiver custom
	cCustom := self:getSQLFields(.f.,nil,.t.)	
	If !empty(cCustom)	
		aCustom := StrTokArr(cCustom,',')
		For nX := 1 to len(aCustom)		
			aadd(self:aFieldsD4P,aCustom[nX])
		Next
	EndIf

	//Campos que farão parte do select da query
	cFields := StrTran(ArrTokStr(self:aFieldsD4P),"|",",")	

	cQuery := " SELECT "+cFields+","
	cQuery += " SB1.B1_DESC DESCRI,D4FN.D4F_TITULO TITULONOV,"
	cQuery += cIsNull+"(D4FO.D4F_TITULO,' ') TITULOANT "
	cQuery += " FROM "+RetSqlName("D4P")+" D4P "
	cQuery += " INNER JOIN "+RetSqlName("SB1")+" SB1 ON "
	cQuery += " SB1.B1_FILIAL = D4P.D4P_FILIAL AND "
	cQuery += " SB1.B1_COD = D4P.D4P_COD AND "
	cQuery += " SB1.D_E_L_E_T_ = ? "
	cQuery += " INNER JOIN "+RetSQLName("D4F")+" D4FN ON "
	cQuery += " D4FN.D4F_FILIAL = ? AND "
	cQuery += " D4FN.D4F_REVIS = D4P.D4P_NEWREV AND "
	cQuery += " D4FN.D4F_CODPAR = D4P.D4P_NEWPRT AND "
	cQuery += " D4FN.D_E_L_E_T_ = ? "
	cQuery += " LEFT JOIN "+RetSQLName("D4F")+" D4FO ON "
	cQuery += " D4FO.D4F_FILIAL = ? AND "
	cQuery += " D4FO.D4F_REVIS = D4P.D4P_OLDREV AND "
	cQuery += " D4FO.D4F_CODPAR = D4P.D4P_OLDPRT AND "
	cQuery += " D4FO.D_E_L_E_T_ = ? "
	cQuery += " WHERE D4P.D4P_FILIAL = ? AND "
	If !Empty(jParams["MV_PAR01"][1])
		cQuery += " D4P.D4P_ID = ? AND "
	EndIf
	cQuery += " D4P.D4P_OLDREV = ? AND "
	cQuery += " D4P.D4P_NEWREV = ? AND "
	cQuery += " D4P.D_E_L_E_T_ = ? "
	If oFilter:hasFilter()
		cQuery += " AND " + oFilter:getSQLExpression() 
	Endif

	//Os filtros serão setados na interface do novo TReports
	cQuery += self:cWhereFiltroSV
	cQuery += self:cWhere
	
	cQuery := ChangeQuery(cQuery)

	oQuery := FWExecStatement():New(cQuery)

	oQuery:SetString(nY++,' ')
	oQuery:SetString(nY++,FWxFilial("D4F",cFilAnt))
	oQuery:SetString(nY++,' ')
	oQuery:SetString(nY++,FWxFilial("D4F",cFilAnt))
	oQuery:SetString(nY++,' ')
	oQuery:SetString(nY++,FWxFilial("D4P",cFilAnt))
	If !Empty(jParams["MV_PAR01"][1])
		oQuery:SetString(nY++,jParams["MV_PAR01"][1])
	EndIf
	oQuery:SetString(nY++,jParams["MV_PAR02"][1])
	oQuery:SetString(nY++,jParams["MV_PAR03"][1])
	oQuery:SetString(nY++,' ')

	cAliasTmp := oQuery:OpenAlias()

	(cAliasTmp)->(dbGoTop())

	While !(cAliasTmp)->(Eof())
		self:jItems		:= JsonObject():New()

		self:jItems["DESCRICAO"] := (cAliasTmp)->(DESCRI)
		self:jItems["TITULOANT"] := (cAliasTmp)->(TITULOANT)
		self:jItems["TITULONOV"] := (cAliasTmp)->(TITULONOV)

		For nX := 1 To Len(self:aFieldsD4P)
			if FWSX3Util():GetFieldType(self:aFieldsD4P[nX]) == "D" //Campo tipo data tem um tratamento diferente para envio
				If !Empty( (cAliasTmp)->&(self:aFieldsD4P[nX]) )
					self:jItems[self:aFieldsD4P[nX]] := totvs.framework.treports.date.dateToTimeStamp(StoD((cAliasTmp)->&(self:aFieldsD4P[nX])))	
				EndIf
			Else
				self:jItems[self:aFieldsD4P[nX]] := (cAliasTmp)->&(self:aFieldsD4P[nX])
			EndIf
		Next nX

		self:processData()
		self:oData:appendData(self:jItems)

		(cAliasTmp)->(DBSkip())
	EndDo

	(cAliasTmp)->( DBCloseArea() )

	oQuery:Destroy()

return self:oData

//-------------------------------------------------------------------
/*{Protheus.doc} getSchema
Retorna a estrutura dos campos
 
@return object: self:oSchema
 
@author BackOffice
@since 04/2023
@version 1.0
*/
//-------------------------------------------------------------------   
Method oNGetSchema() Class CostBreakdownPreCheck

	self:aFieldsD4P := {"D4P_FILIAL","D4P_ID","D4P_COD","D4P_OLDREV","D4P_OLDPRT",;
					   "D4P_NEWREV","D4P_NEWPRT","D4P_DATEXE","D4P_HORA","D4P_REGRA"}
	
	self:AliasToSchema("D4P", self:aFieldsD4P)	

	self:addProperty( "DESCRICAO" , STR0004 , "string", STR0004 , "DESCRICAO") //"Descrição"
	self:addProperty( "TITULOANT" , STR0005 , "string", STR0005 , "TITULOANT") //"Título Anterior"
	self:addProperty( "TITULONOV" , STR0006 , "string", STR0006 , "TITULONOV") //"Novo Título"

	//Adicionado a pesquisa de filiais como não visível
	self:addParameter("SV_MULTBRANCH", STR0009, "string", .T.,,,,,,,,,,.F.) //Filiais

Return self:oSchema
