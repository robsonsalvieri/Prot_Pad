#include "msobject.ch"
#include "protheus.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "backoffice.sv.est.totalcostvspartcost.ch"
#include "totvs.framework.treports.integratedprovider.th"

#DEFINE SX1GRUPO 'ESTT044'

namespace totvs.protheus.backoffice.est.totalcostvspartcost.integratedprovider

using namespace totvs.framework.treports.integratedprovider

@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGAEST", tables="SB1,SB2,SB9,SD1,SD2,SD3", name="Custo Total x Partes", country="ALL")

//-------------------------------------------------------------------
/*{Protheus.doc} TotalcostVsPartcostSmartViewBusinessObject
Classe para criação do Objeto de Negócio de Custo Total x Partes
 
@author Leonardo Kichitaro
@since 11/2025
@version 1.0
*/
//-------------------------------------------------------------------  
Class TotalcostVsPartcostSmartViewBusinessObject From totvs.protheus.backoffice.est.smartView.integratedProvider.EstIntegratedProvider

	Public Method new()				as object
	Public Method getData()			as object

	Protected Method oNGetSchema()
	Protected data jItems		  as json
	Protected data cWhere		  as character
	Protected data aFields		  as array
	Protected data aFieldsTot	  as array
	Protected data aPartes		  as array
	Protected data lExistPergunte as logical
	Protected data cNameViewSB9	  as character
	Protected data cNameViewSD1	  as character

EndClass
 
//-------------------------------------------------------------------
/*{Protheus.doc} new
Método de instância da classe
 
@return object: self
 
@author Leonardo Kichitaro
@since 11/2025
@version 1.0
*/
//-------------------------------------------------------------------   
Method new() Class TotalcostVsPartcostSmartViewBusinessObject

	Local lExecute	as logical

	_Super:new()

	//Define a Área
	self:appendArea(STR0001) //"Estoque/Custos"

	//Define o nome do Objeto de Negócio
	self:setDisplayName(STR0002) //"Custo Total x Partes"
 
	//Define a descrição do Objeto de Negócio
	self:setDescription(STR0003) //"Emite uma relação dos custos totais x partes."

	//Indica o pergunte que será utilizado no relatório
	lExecute  := FnVldCMod2()
    self:lExistPergunte := (self:setPergunte( SX1GRUPO ) .And. lExecute)
	If !self:lExistPergunte
		self:setErrorStatus(400,STR0004,i18n(STR0005,{SX1GRUPO}))//O Grupo de perguntas #1 não existe
		FWLogMsg('WARN', , 'SmartView', , , , i18n(STR0005,{SX1GRUPO}), , , )//O Grupo de perguntas #1 não existe
	EndIf
    
	//Indica que o LookUp será do tipo padrão LookUp
    self:setIsLookUp(.T.)

Return self

//-------------------------------------------------------------------
/*{Protheus.doc} getData
Retorna os dados do objeto de negócio
 
@param nPage, numérico, indica a página atual do relatório
@param oFilter, objeto, contém o filtro do TReports
 
@return object: self:oData
 
@author Leonardo Kichitaro
@since 11/2025
@version 1.0
*/
//-------------------------------------------------------------------   
Method getData( nPage as Numeric, oFilter as object) as object Class TotalcostVsPartcostSmartViewBusinessObject

	Local oQuery							as object

	Local cQuery							as character
	Local cFields							as character
	Local cAliasTmp							as character
	Local cBkpFil							as character
	Local nX								as numeric
	Local nF								as numeric
	Local nY								as numeric
	Local nFil								as numeric
	Local nPrdParte							as numeric
	Local nCountPrd							as numeric
	Local jParams							as json

	Local dDateRef							as date
	Local cMoeda							as character

	//Valida o pergunte
	If !self:lExistPergunte	
		return self:oData
	Endif

	//Metodo para retorno do json dos parâmetros
    jParams := oFilter:getParameters()

    //Retorno da tela de multi filiais com as filiais selecionadas ou somente a filial corrente
    self:aFils := self:retFils(jParams['SV_MULTBRANCH'], oFilter)

	If jParams['MV_PAR09'][1] == 0
		cMoeda := '01'
	Else
		cMoeda := StrZero(jParams['MV_PAR09'][1], 2)
	EndIf

	If jParams['MV_PAR10'][1] == 2
		dDateRef := FwDateTimeToLocal( jParams['MV_PAR11'][1] )[1]
		dDateRef += 1
	Else
		dDateRef := (Date() + 1)
	EndIf

	//Query
	cFields := 'B2_FILIAL FILIAL, '
	cFields += 'B2_COD PRODUTO, '
	cFields += 'B1_TIPO TIPO, '
	cFields += 'B1_GRUPO GRUPO, '
	cFields += 'B1_DESC DESCRICAO, '
	cFields += 'B1_UM UM, '
	cFields += 'B2_LOCAL LOCALPROD '

	cQuery := "SELECT ? "
	cQuery += " FROM " + RetSQLName('SB2') + " SB2 "
	cQuery += " INNER JOIN "+RetSQLName('SB1')+" SB1 "
	cQuery += " ON SB1.B1_FILIAL = SB2.B2_FILIAL"
	cQuery += " AND SB1.B1_COD  = SB2.B2_COD"
	cQuery += " AND SB1.D_E_L_E_T_ = ?"
	cQuery += " WHERE SB2.B2_FILIAL = ?"
	cQuery += " AND SB2.B2_COD >= ? AND SB2.B2_COD <= ?"
	cQuery += " AND SB2.B2_LOCAL >= ? AND SB2.B2_LOCAL <= ?"
	cQuery += " AND SB1.B1_TIPO >= ? AND SB1.B1_TIPO <= ?"
	cQuery += " AND	SB1.B1_GRUPO >= ? AND SB1.B1_GRUPO <= ?"
	cQuery += " AND SB2.D_E_L_E_T_ = ?"
	cQuery += " ORDER BY B2_FILIAL, B2_COD, B2_LOCAL "

	cQuery := ChangeQuery(cQuery)

	//Montagem da query para execução
	oQuery := FwExecStatement():New(cQuery)

	cBkpFil := cFilAnt

	For nFil :=1 to len(self:aFils)
		cFilAnt := self:aFils[nFil]

		//Binding
		oQuery:SetUnsafe(1, cFields)
		oQuery:SetString(2, ' ')
		oQuery:SetString(3, FWxFilial("SB9"))
		oQuery:SetString(4, jParams['MV_PAR01'][1])
		oQuery:SetString(5, jParams['MV_PAR02'][1])
		oQuery:SetString(6, jParams['MV_PAR07'][1])
		oQuery:SetString(7, jParams['MV_PAR08'][1])
		oQuery:SetString(8, jParams['MV_PAR03'][1])
		oQuery:SetString(9, jParams['MV_PAR04'][1])
		oQuery:SetString(10, jParams['MV_PAR05'][1])
		oQuery:SetString(11, jParams['MV_PAR06'][1])
		oQuery:SetString(12, ' ')

		cAliasTmp := oQuery:OpenAlias()

		(cAliasTmp)->(dbGoTop())
		While !(cAliasTmp)->(Eof())

			aRetCust := Mod2CalcCP((cAliasTmp)->PRODUTO, (cAliasTmp)->LOCALPROD, dDateRef)

			If Len(aRetCust) > 0
				self:jItems		:= JsonObject():New()

				//aFields
				For nX := 1 To Len(self:aFields)
					self:jItems[self:aFields[nX]] := (cAliasTmp)->&(self:aFields[nX])
				Next nX

				//aFieldsTot
				nCountPrd := 1
				nPrdParte := Len(self:aFields)
				For nX := 1 To Len(aRetCust)
					If cMoeda == aRetCust[nX][18]
						self:jItems		:= JsonObject():New()

						//aFields
						For nF := 1 To nPrdParte
							If nCountPrd == 1
								self:jItems[self:aFields[nF]] := (cAliasTmp)->&(self:aFields[nF])
							ElseIf self:aFields[nF] $ "FILIAL|PRODUTO|TIPO|LOCALPROD"
								self:jItems[self:aFields[nF]] := (cAliasTmp)->&(self:aFields[nF])
							EndIf
						Next nF

						For nY := 1 To Len(self:aFieldsTot)
							If self:aFieldsTot[nY] == 'QUANTIDADE'
								self:jItems[self:aFieldsTot[nY]] := aRetCust[nX][4]
							ElseIf self:aFieldsTot[nY] == 'REVISAO'
								self:jItems[self:aFieldsTot[nY]] := aRetCust[nX][16]
							ElseIf self:aFieldsTot[nY] == 'PARTE'
								self:jItems[self:aFieldsTot[nY]] := aRetCust[nX][17]
							ElseIf self:aFieldsTot[nY] == 'CUSTOTOTAL'
								self:jItems[self:aFieldsTot[nY]] := aRetCust[nX][(jParams['MV_PAR09'][1]+5)]
							ElseIf self:aFieldsTot[nY] == 'TOTPARTE'
								self:jItems[self:aFieldsTot[nY]] := aRetCust[nX][20]
							ElseIf self:aFieldsTot[nY] == 'CUSTOUNIT'
								self:jItems[self:aFieldsTot[nY]] := (aRetCust[nX][(jParams['MV_PAR09'][1]+5)] / aRetCust[nX][4])
							ElseIf self:aFieldsTot[nY] == 'UNIPARTE'
								self:jItems[self:aFieldsTot[nY]] := aRetCust[nX][19]
							EndIf
						Next nY

						self:processData()
						self:oData:appendData(self:jItems)
					
						nCountPrd++
					EndIf
				Next nX
			EndIf

			(cAliasTmp)->(DBSkip())
		EndDo

		(cAliasTmp)->( DBCloseArea() )
	Next

	cFilAnt := cBkpFil

	oQuery:Destroy()

return self:oData

//-------------------------------------------------------------------
/*{Protheus.doc} getSchema
Retorna a estrutura dos campos
 
@return object: self:oSchema
 
@author Leonardo Kichitaro
@since 11/2025
@version 1.0
*/
//-------------------------------------------------------------------   
Method oNGetSchema() Class TotalcostVsPartcostSmartViewBusinessObject

	self:aFields := {"FILIAL", "PRODUTO", "TIPO", "GRUPO", "DESCRICAO", "UM", "LOCALPROD"}
	self:aFieldsTot := {"QUANTIDADE", "REVISAO", "PARTE", "CUSTOTOTAL", "TOTPARTE", "CUSTOUNIT", "UNIPARTE"}

	self:addProperty( "FILIAL"		, STR0006, "string", STR0006, "FILIAL")		//"Filial"
	self:addProperty( "PRODUTO"		, STR0007, "string", STR0007, "PRODUTO")	//"Produto"
	self:addProperty( "TIPO"		, STR0008, "string", STR0008, "TIPO")		//"Tipo"
	self:addProperty( "GRUPO"		, STR0009, "string", STR0009, "GRUPO")		//"Grupo"
	self:addProperty( "DESCRICAO"	, STR0010, "string", STR0010, "DESCRICAO")	//"Descrição"
	self:addProperty( "UM"			, STR0011, "string", STR0011, "UM")			//"Unidade"
	self:addProperty( "LOCALPROD"	, STR0012, "string", STR0012, "LOCALPROD")	//"Local"
	self:addProperty( "QUANTIDADE"	, STR0013, "number", STR0013, "QUANTIDADE")	//"Quantidade"
	self:addProperty( "REVISAO"		, STR0016, "string", STR0016, "REVISAO")	//"Revisão"
	self:addProperty( "PARTE"		, STR0017, "string", STR0017, "PARTE")	//"Parte"
	self:addProperty( "CUSTOTOTAL"	, STR0014, "number", STR0014, "CUSTOTOTAL")	//"Custo Total"
	self:addProperty( "TOTPARTE"	, STR0018, "number", STR0018, "TOTPARTE") //"Custo Total Parte"
	self:addProperty( "CUSTOUNIT"	, STR0015, "number", STR0015, "CUSTOUNIT")	//"Custo Unitário"
	self:addProperty( "UNIPARTE"	, STR0019, "number", STR0019, "UNIPARTE") //"Custo Unitário Parte"

Return
