#include "msobject.ch"
#include "protheus.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "backoffice.sv.est.kardexinparts.ch"
#include "totvs.framework.treports.integratedprovider.th"

#DEFINE SX1GRUPO 'ESTT047'

Static lListaDev := NIL
Static __oQueryD4F := Nil

namespace totvs.protheus.backoffice.est.KardexInParts.integratedprovider

using namespace totvs.framework.treports.integratedprovider
using namespace totvs.protheus.backoffice.stock.iterativecost.view.manager
using Namespace totvs.protheus.backoffice.stock.iterativecost.view.parts.incominginvoiceitems
using Namespace totvs.protheus.backoffice.stock.iterativecost.view.parts.outgoinginvoiceitems
using Namespace totvs.protheus.backoffice.stock.iterativecost.view.parts.internaltransactions

@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGAEST", tables="SB1,SB2,SB9,SD3", name="Kardex em Partes", country="ALL")

//-------------------------------------------------------------------
/*{Protheus.doc} KardexInPartsSmartViewBusinessObject
Classe para criação do Objeto de Negócio de Kardex em Partes
 
@author Leonardo Kichitaro
@since 01/2026
@version 1.0
*/
//-------------------------------------------------------------------  
Class KardexInPartsSmartViewBusinessObject From totvs.protheus.backoffice.est.smartView.integratedProvider.EstIntegratedProvider

	Public Method new()					as object
	Public Method getData()				as object

	Protected Method oNGetSchema()
	Protected data jItems		  		as json
	Protected data cWhere		  		as character
	Protected data aFields		  		as array
	Protected data lExistPergunte 		as logical
	Protected data cNameViewD1SDITCP	as character
	Protected data cNameViewD2SDITCP	as character
	Protected data cNameViewD3SDPRCP	as character

EndClass
 
//-------------------------------------------------------------------
/*{Protheus.doc} new
Método de instância da classe
 
@return object: self
 
@author Leonardo Kichitaro
@since 01/2026
@version 1.0
*/
//-------------------------------------------------------------------   
Method new() Class KardexInPartsSmartViewBusinessObject

	Local lExecute	as logical

	_Super:new()

	//Define a Área
	self:appendArea(STR0001) //"Estoque/Custos"

	//Define o nome do Objeto de Negócio
	self:setDisplayName(STR0002) //"Kardex em Partes"
 
	//Define a descrição do Objeto de Negócio
	self:setDescription(STR0003) //"Emite uma relação do kardex em partes."

	//Indica o pergunte que será utilizado no relatório
	lExecute  := FnVldCMod2()
    self:lExistPergunte := (self:setPergunte( SX1GRUPO ) .And. lExecute)
	If !self:lExistPergunte
		self:setErrorStatus(400,STR0004,i18n(STR0005,{SX1GRUPO}))//O Grupo de perguntas #1 não existe
		FWLogMsg('WARN', , 'SmartView', , , , i18n(STR0005,{SX1GRUPO}), , , )//O Grupo de perguntas #1 não existe
	EndIf

	//Indica que o LookUp será do tipo padrão LookUp
    self:setIsLookUp(.T.)

Return self

//-------------------------------------------------------------------
/*{Protheus.doc} getData
Retorna os dados do objeto de negócio
 
@param nPage, numérico, indica a página atual do relatório
@param oFilter, objeto, contém o filtro do TReports
 
@return object: self:oData
 
@author Leonardo Kichitaro
@since 01/2026
@version 1.0
*/
//-------------------------------------------------------------------   
Method getData( nPage as Numeric, oFilter as object) as object Class KardexInPartsSmartViewBusinessObject

	Local oQuery						as object

	Local oViews						as object
    Local oViewCpIncominginvoiceitems	as object
    Local oViewCpOutgoinginvoiceitems	as object
    Local oViewCpInternaltransactions	as object

	Local cQuery						as character
	Local cFieldsSD1					as character
	Local cFieldsSD2					as character
	Local cFieldsSD3					as character
	Local cFieldsSB1					as character
	Local cAliasTmp						as character
	Local cBkpFil						as character
	Local nX							as numeric
	Local nFil							as numeric
	Local jParams						as json
	Local cCpoCusD1						as character
	Local cMoeda						as character
	Local nMoeda						as numeric
	Local dData							as date
	Local cDataDe						as character
	Local cDataAte						as character
	Local cProdImp						as character
	Local cArmzPrd						as character
	Local nCusMedLn						as numeric
	Local aPartes						as array
	Local aPartesDet					as array
	Local aSalAtu						as array
	Local aAuxCus						as array
	Local lFirst						as logical
	Local cCCPVPJOP						as character

	//Valida o pergunte
	If !self:lExistPergunte	
		return self:oData
	Endif

	//Metodo para retorno do json dos parâmetros
    jParams := oFilter:getParameters()

    //Retorno da tela de multi filiais com as filiais selecionadas ou somente a filial corrente
    self:aFils := self:retFils(jParams['SV_MULTBRANCH'], oFilter)

	//Armazém informado
	If Empty(jParams['MV_PAR08'][1])
		cArmzPrd := '01'
	Else
		cArmzPrd := jParams['MV_PAR08'][1]
	EndIf

	//Moeda selecionada
	cCpoCusD1 := ''
	If jParams['MV_PAR10'][1] == 0
		cMoeda := '01'
		nMoeda := 1
	Else
		cMoeda := StrZero(jParams['MV_PAR10'][1], 2)
		nMoeda := jParams['MV_PAR10'][1]
		If jParams['MV_PAR10'][1] > 1
			cCpoCusD1 := StrZero(jParams['MV_PAR10'][1], 1)
		EndIf
	EndIf

	dData		:= FwDateTimeToLocal( jParams['MV_PAR05'][1] )[1]
	cDataDe  	:= dTos(FwDateTimeToLocal( jParams['MV_PAR05'][1] )[1])
	cDataAte 	:= dTos(FwDateTimeToLocal( jParams['MV_PAR06'][1] )[1])

	//Tratamento listar até 5 partes informadas no parâmetro
	
	If Len(jParams['MV_PAR15']) == 0
		aPartes := {'01'}
	Else
		aPartes := {}
		aAux := StrTokArr2(jParams['MV_PAR15'][1], ';', .F.)
		aSort(aAux)
		For nX := 1 To Len(aAux)
			If nX > 5
				Exit
			EndIf
			aAdd(aPartes, aAux[nX])
		Next
	EndIf
	aPartesDet := DetPartes(aPartes)

	// Codigo do produto importado - NAO DEVE SER LISTADO
	cProdImp := GetMV("MV_PRODIMP")

	oViews := ViewManager():New({cFilAnt})
	oViews:Install()

    oViewCpIncominginvoiceitems     := ViewIncomingInvoiceItemsParts():New({cFilAnt})
    oViewCpOutgoinginvoiceitems     := ViewOutgoingInvoiceItemsParts():New({cFilAnt})
    oViewCpInternaltransactions     := ViewInternalTransactionsParts():New({cFilAnt})

	self:cNameViewD1SDITCP := "VW_" + oViewCpIncominginvoiceitems:GetViewID() + "_" + cEmpAnt
	self:cNameViewD2SDITCP := "VW_" + oViewCpOutgoinginvoiceitems:GetViewID() + "_" + cEmpAnt
    self:cNameViewD3SDPRCP := "VW_" + oViewCpInternaltransactions:GetViewID() + "_" + cEmpAnt

	// Instala views
    If TCIsView(self:cNameViewD1SDITCP) .And. TCIsView(self:cNameViewD2SDITCP) .And. TCIsView(self:cNameViewD3SDPRCP)
		SB2->(dbSetOrder(1))

		//Query 1 - Notas de Entrada(SD1)
		cFieldsSD1 := "'SD1' ARQ, "
		cFieldsSD1 += "SB1.B1_COD PRODUTO, "
		cFieldsSD1 += "SB1.B1_TIPO TIPO, "
		cFieldsSD1 += "SB1.B1_UM UM, "
		cFieldsSD1 += "SB1.B1_GRUPO GRUPO, "
		cFieldsSD1 += "SB1.B1_DESC DESCRICAO, "
		cFieldsSD1 += "SB1.B1_POSIPI POSICAOIPI, "
		cFieldsSD1 += "SD1.D1_SEQCALC SEQCALC, "
		cFieldsSD1 += "SD1.D1_DTDIGIT DATA, "
		cFieldsSD1 += "SD1.D1_TES TES, "
		cFieldsSD1 += "SD1.D1_CF CF, "
		cFieldsSD1 += "SD1.D1_NUMSEQ SEQUENCIA, "
		cFieldsSD1 += "SD1.D1_DOC DOCUMENTO, "
		cFieldsSD1 += "SD1.D1_SERIE SERIE, "
		cFieldsSD1 += "SD1.D1_QUANT QUANTIDADE, "
		cFieldsSD1 += "SD1.D1_QTSEGUM QUANT2UM, "
		cFieldsSD1 += "SD1.D1_LOCAL ARMAZEM, "
		cFieldsSD1 += "' ' PROJETO, "
		cFieldsSD1 += "' ' OP, "
		cFieldsSD1 += "' ' CC, "
		cFieldsSD1 += "SD1.D1_FORNECE FORNECEDOR, "
		cFieldsSD1 += "SD1.D1_LOJA LOJA, "
		cFieldsSD1 += "' ' PEDIDO, "
		cFieldsSD1 += "SD1.D1_TIPO TIPONF, "
		cFieldsSD1 += "COALESCE(VWSD1.D4L_REVISA, CAST('    ' AS CHAR(4))) REVISAO, "
		cFieldsSD1 += "COALESCE(VWSD1.D4L_PARTE, CAST('99' AS CHAR(2))) PARTE, "
		cFieldsSD1 += "COALESCE(D4F.D4F_TITULO, CAST('                    ' AS CHAR(20))) TITULO, "
		cFieldsSD1 += "'"+cMoeda+"' MOEDA, "
		cFieldsSD1 += "COALESCE(VWSD1.D4L_TOTAL, 0) CUSTOP, "
		cFieldsSD1 += "' ' TRT, "
		cFieldsSD1 += "SD1.D1_LOTECTL LOTE, "
		cFieldsSD1 += "SD1.R_E_C_N_O_ NRECNO, "
		cFieldsSD1 += "SD1.D1_CUSTO"+cCpoCusD1+" CUSTO"

		cQuery := "SELECT ? "
		cQuery += " FROM "+RetSQLName('SB1')+" SB1 "
		cQuery += " INNER JOIN "+RetSQLName('SD1')+" SD1 "
		cQuery += "         ON SD1.D1_FILIAL = ? "
		cQuery += "		   AND SD1.D1_COD = SB1.B1_COD "
		cQuery += "		   AND SD1.D1_LOCAL = ? "
		cQuery += "		   AND SD1.D1_DTDIGIT >= ? "
		cQuery += "		   AND SD1.D1_DTDIGIT <= ? "
		cQuery += "		   AND SD1.D1_ORIGLAN <> ? "
		cQuery += "		   AND SD1.D_E_L_E_T_ = ? "
		cQuery += " INNER JOIN "+RetSQLName('SF4')+" SF4 "
		cQuery += "         ON SF4.F4_FILIAL = ? "
		cQuery += "		   AND SF4.F4_CODIGO = SD1.D1_TES "
		cQuery += "		   AND SF4.F4_ESTOQUE = ? "
		cQuery += "		   AND SF4.D_E_L_E_T_ = ? "
		cQuery += "  LEFT JOIN "+self:cNameViewD1SDITCP+" VWSD1 "
		cQuery += "         ON VWSD1.D1_FILIAL = SD1.D1_FILIAL "
		cQuery += "		 AND VWSD1.D1_COD = SD1.D1_COD "
		cQuery += "		 AND VWSD1.D1_LOCAL = SD1.D1_LOCAL "
		cQuery += "		 AND VWSD1.D1_DOC = SD1.D1_DOC "
		cQuery += "		 AND VWSD1.D1_SERIE = SD1.D1_SERIE "
		cQuery += "		 AND VWSD1.D1_FORNECE = SD1.D1_FORNECE "
		cQuery += "		 AND VWSD1.D1_LOJA = SD1.D1_LOJA "
		cQuery += "		 AND VWSD1.D1_ITEM = SD1.D1_ITEM "
		cQuery += "		 AND VWSD1.D1_NUMSEQ = SD1.D1_NUMSEQ "
		cQuery += "		 AND VWSD1.D4L_PARTE IN (?) "
		cQuery += "		 AND VWSD1.D4L_MOEDA = ? "
		cQuery += "  LEFT JOIN "+RetSQLName('D4F')+" D4F "
		cQuery += "         ON D4F.D4F_FILIAL = ? "
		cQuery += "        AND D4F.D4F_REVIS = VWSD1.D4L_REVISA "
		cQuery += "        AND D4F.D4F_CODPAR = VWSD1.D4L_PARTE "
		cQuery += "        AND D4F.D_E_L_E_T_ = ? "
		cQuery += " WHERE SB1.B1_FILIAL = ? "
		cQuery += "   AND SB1.B1_COD >= ? "
		cQuery += "   AND SB1.B1_COD <= ? "
		cQuery += "   AND SB1.B1_COD <> ? "
		cQuery += "   AND SB1.B1_TIPO >= ? "
		cQuery += "   AND SB1.B1_TIPO <= ? "
		cQuery += "   AND SB1.B1_GRUPO >= ? "
		cQuery += "   AND SB1.B1_GRUPO <= ? "
		cQuery += "   AND SB1.D_E_L_E_T_ = ? "

		//Query 2 - Notas de Saída(SD2)
		cFieldsSD2 := "'SD2', "
		cFieldsSD2 += "SB1.B1_COD, "
		cFieldsSD2 += "SB1.B1_TIPO, "
		cFieldsSD2 += "SB1.B1_UM, "
		cFieldsSD2 += "SB1.B1_GRUPO, "
		cFieldsSD2 += "SB1.B1_DESC, "
		cFieldsSD2 += "SB1.B1_POSIPI, "
		cFieldsSD2 += "SD2.D2_SEQCALC, "
		cFieldsSD2 += "SD2.D2_EMISSAO, "
		cFieldsSD2 += "SD2.D2_TES, "
		cFieldsSD2 += "SD2.D2_CF, "
		cFieldsSD2 += "SD2.D2_NUMSEQ, "
		cFieldsSD2 += "SD2.D2_DOC, "
		cFieldsSD2 += "SD2.D2_SERIE, "
		cFieldsSD2 += "SD2.D2_QUANT, "
		cFieldsSD2 += "SD2.D2_QTSEGUM, "
		cFieldsSD2 += "SD2.D2_LOCAL, "
		cFieldsSD2 += "' ', "
		cFieldsSD2 += "' ', "
		cFieldsSD2 += "' ', "
		cFieldsSD2 += "SD2.D2_CLIENTE, "
		cFieldsSD2 += "SD2.D2_LOJA, "
		cFieldsSD2 += "SD2.D2_PEDIDO, "
		cFieldsSD2 += "SD2.D2_TIPO, "
		cFieldsSD2 += "COALESCE(VWSD2.D4M_REVISA, CAST('    ' AS CHAR(4))), "
		cFieldsSD2 += "COALESCE(VWSD2.D4M_PARTE, CAST('99' AS CHAR(2))), "
		cFieldsSD2 += "COALESCE(D4F.D4F_TITULO, CAST('                    ' AS CHAR(20))), "
		cFieldsSD2 += "'"+cMoeda+"', "
		cFieldsSD2 += "COALESCE(VWSD2.D4M_TOTAL, 0), "
		cFieldsSD2 += "' ', "
		cFieldsSD2 += "SD2.D2_LOTECTL, "
		cFieldsSD2 += "SD2.R_E_C_N_O_ NRECNO, "
		cFieldsSD2 += "SD2.D2_CUSTO"+StrZero(nMoeda,1)+" "

		cQuery += " UNION "
		cQuery += "SELECT ? "
		cQuery += " FROM "+RetSQLName('SB1')+" SB1 "
		cQuery += "  INNER JOIN "+RetSQLName('SD2')+" SD2 "
		cQuery += "          ON SD2.D2_FILIAL = ? "
		cQuery += " 		AND SD2.D2_COD = SB1.B1_COD "
		cQuery += " 		AND SD2.D2_LOCAL = ? "
		cQuery += " 		AND SD2.D2_EMISSAO >= ? "
		cQuery += " 		AND SD2.D2_EMISSAO <= ? "
		cQuery += " 		AND SD2.D2_ORIGLAN <> ? "
		cQuery += " 		AND SD2.D_E_L_E_T_ = ? "
		cQuery += "  INNER JOIN "+RetSQLName('SF4')+" SF4 "
		cQuery += "          ON SF4.F4_FILIAL = ? "
		cQuery += " 		AND SF4.F4_CODIGO = SD2.D2_TES "
		cQuery += " 		AND SF4.F4_ESTOQUE = ? "
		cQuery += " 		AND SF4.D_E_L_E_T_= ? "
		cQuery += "   LEFT JOIN "+self:cNameViewD2SDITCP+" VWSD2 "
		cQuery += "          ON VWSD2.D2_FILIAL = SD2.D2_FILIAL "
		cQuery += " 		AND VWSD2.D2_COD = SD2.D2_COD "
		cQuery += " 		AND VWSD2.D2_LOCAL = SD2.D2_LOCAL "
		cQuery += " 		AND VWSD2.D2_DOC = SD2.D2_DOC "
		cQuery += " 		AND VWSD2.D2_SERIE = SD2.D2_SERIE "
		cQuery += " 		AND VWSD2.D2_CLIENTE = SD2.D2_CLIENTE "
		cQuery += " 		AND VWSD2.D2_LOJA = SD2.D2_LOJA "
		cQuery += " 		AND VWSD2.D2_ITEM = SD2.D2_ITEM "
		cQuery += "		 	AND VWSD2.D4M_PARTE IN (?) "
		cQuery += "		 	AND VWSD2.D4M_MOEDA = ? "
		cQuery += "   LEFT JOIN "+RetSQLName('D4F')+" D4F "
		cQuery += "          ON D4F.D4F_FILIAL = ? "
		cQuery += "         AND D4F.D4F_REVIS = VWSD2.D4M_REVISA "
		cQuery += "         AND D4F.D4F_CODPAR = VWSD2.D4M_PARTE "
		cQuery += "         AND D4F.D_E_L_E_T_ = ? "
		cQuery += " WHERE SB1.B1_FILIAL = ? "
		cQuery += "   AND SB1.B1_COD >= ? "
		cQuery += "   AND SB1.B1_COD <= ? "
		cQuery += "   AND SB1.B1_COD <> ? "
		cQuery += "   AND SB1.B1_TIPO >= ? "
		cQuery += "   AND SB1.B1_TIPO <= ? "
		cQuery += "   AND SB1.B1_GRUPO >= ? "
		cQuery += "   AND SB1.B1_GRUPO <= ? "
		cQuery += "   AND SB1.D_E_L_E_T_ = ? "

		//Query 3 - Movimentações Internas(SD3)
		cFieldsSD3 := "'SD3', "
		cFieldsSD3 += "SB1.B1_COD, "
		cFieldsSD3 += "SB1.B1_TIPO, "
		cFieldsSD3 += "SB1.B1_UM, "
		cFieldsSD3 += "SB1.B1_GRUPO, "
		cFieldsSD3 += "SB1.B1_DESC, "
		cFieldsSD3 += "SB1.B1_POSIPI, "
		cFieldsSD3 += "SD3.D3_SEQCALC, "
		cFieldsSD3 += "SD3.D3_EMISSAO, "
		cFieldsSD3 += "SD3.D3_TM, "
		cFieldsSD3 += "SD3.D3_CF, "
		cFieldsSD3 += "SD3.D3_NUMSEQ, "
		cFieldsSD3 += "SD3.D3_DOC, "
		cFieldsSD3 += "' ', "
		cFieldsSD3 += "SD3.D3_QUANT, "
		cFieldsSD3 += "SD3.D3_QTSEGUM, "
		cFieldsSD3 += "SD3.D3_LOCAL, "
		cFieldsSD3 += "SD3.D3_PROJPMS, "
		cFieldsSD3 += "SD3.D3_OP, "
		cFieldsSD3 += "SD3.D3_CC, "
		cFieldsSD3 += "' ', "
		cFieldsSD3 += "' ', "
		cFieldsSD3 += "' ', "
		cFieldsSD3 += "' ', "
		cFieldsSD3 += "COALESCE(VWSD3.D4N_REVISA, CAST('    ' AS CHAR(4))), "
		cFieldsSD3 += "COALESCE(VWSD3.D4N_PARTE, CAST('99' AS CHAR(2))), "
		cFieldsSD3 += "COALESCE(D4F.D4F_TITULO, CAST('                    ' AS CHAR(20))), "
		cFieldsSD3 += "'"+cMoeda+"', "
		cFieldsSD3 += "COALESCE(VWSD3.D4N_TOTAL, 0), "
		cFieldsSD3 += "SD3.D3_TRT, "
		cFieldsSD3 += "SD3.D3_LOTECTL, "
		cFieldsSD3 += "SD3.R_E_C_N_O_ NRECNO, "
		cFieldsSD3 += "SD3.D3_CUSTO"+StrZero(nMoeda,1)+" "

		cQuery += " UNION "
		cQuery += "SELECT ? "
		cQuery += " FROM "+RetSQLName('SB1')+" SB1 "
		cQuery += "  INNER JOIN "+RetSQLName('SD3')+" SD3 "
		cQuery += "          ON SD3.D3_FILIAL = ? "
		cQuery += " 		AND SD3.D3_COD = SB1.B1_COD "
		cQuery += " 		AND SD3.D3_LOCAL = ? "
		cQuery += " 		AND SD3.D3_EMISSAO >= ? "
		cQuery += " 		AND SD3.D3_EMISSAO <= ? "
		cQuery += " 		AND SD3.D3_ESTORNO <> ? "
		cQuery += " 		AND SD3.D_E_L_E_T_ = ? "
		cQuery += "   LEFT JOIN "+self:cNameViewD3SDPRCP+" VWSD3 "
		cQuery += "          ON VWSD3.D3_FILIAL = SD3.D3_FILIAL "
		cQuery += " 		AND VWSD3.D3_COD = SD3.D3_COD "
		cQuery += " 		AND VWSD3.D3_LOCAL = SD3.D3_LOCAL "
		cQuery += " 		AND VWSD3.D3_TM = SD3.D3_TM "
		cQuery += " 		AND VWSD3.D3_CF = SD3.D3_CF "
		cQuery += " 		AND VWSD3.D3_OP = SD3.D3_OP "
		cQuery += " 		AND VWSD3.D3_EMISSAO = SD3.D3_EMISSAO "
		cQuery += "		 	AND VWSD3.D4N_PARTE IN (?) "
		cQuery += "		 	AND VWSD3.D4N_MOEDA = ? "
		cQuery += "   LEFT JOIN "+RetSQLName('D4F')+" D4F "
		cQuery += "          ON D4F.D4F_FILIAL = ? "
		cQuery += "         AND D4F.D4F_REVIS = VWSD3.D4N_REVISA "
		cQuery += "         AND D4F.D4F_CODPAR = VWSD3.D4N_PARTE "
		cQuery += "         AND D4F.D_E_L_E_T_ = ? "
		cQuery += " WHERE SB1.B1_FILIAL = ? "
		cQuery += "   AND SB1.B1_COD >= ? "
		cQuery += "   AND SB1.B1_COD <= ? "
		cQuery += "   AND SB1.B1_COD <> ? "
		cQuery += "   AND SB1.B1_TIPO >= ? "
		cQuery += "   AND SB1.B1_TIPO <= ? "
		cQuery += "   AND SB1.B1_GRUPO >= ? "
		cQuery += "   AND SB1.B1_GRUPO <= ? "
		cQuery += "   AND SB1.D_E_L_E_T_ = ? "

		If jParams['MV_PAR07'][1] <> 2
			//Query 4 - Produtos(SB1)
			cFieldsSB1 := "'SB1', "
			cFieldsSB1 += "SB1EXS.B1_COD, "
			cFieldsSB1 += "SB1EXS.B1_TIPO, "
			cFieldsSB1 += "SB1EXS.B1_UM, "
			cFieldsSB1 += "SB1EXS.B1_GRUPO, "
			cFieldsSB1 += "SB1EXS.B1_DESC, "
			cFieldsSB1 += "SB1EXS.B1_POSIPI, "
			cFieldsSB1 += "'', "
			cFieldsSB1 += "'', "
			cFieldsSB1 += "'', "
			cFieldsSB1 += "'', "
			cFieldsSB1 += "'', "
			cFieldsSB1 += "'', "
			cFieldsSB1 += "'', "
			cFieldsSB1 += "0, "
			cFieldsSB1 += "0, "
			cFieldsSB1 += "'', "
			cFieldsSB1 += "'', "
			cFieldsSB1 += "'', "
			cFieldsSB1 += "'', "
			cFieldsSB1 += "'', "
			cFieldsSB1 += "'', "
			cFieldsSB1 += "'', "
			cFieldsSB1 += "'', "
			cFieldsSB1 += "'', "
			cFieldsSB1 += "'99', "
			cFieldsSB1 += "'                    ', "
			cFieldsSB1 += "'"+cMoeda+"', "
			cFieldsSB1 += "0, "
			cFieldsSB1 += "'', "
			cFieldsSB1 += "'', "
			cFieldsSB1 += "0, "
			cFieldsSB1 += "0 "

			cQuery += " UNION "
			cQuery += "SELECT ? "
			cQuery += " FROM "+RetSQLName('SB1')+" SB1EXS "
			cQuery += " WHERE SB1EXS.B1_FILIAL = ? "
			cQuery += "   AND SB1EXS.B1_COD >= ? "
			cQuery += "   AND SB1EXS.B1_COD <= ? "
			cQuery += "   AND SB1EXS.B1_COD <> ? "
			cQuery += "   AND SB1EXS.B1_TIPO >= ? "
			cQuery += "   AND SB1EXS.B1_TIPO <= ? "
			cQuery += "   AND SB1EXS.B1_GRUPO >= ? "
			cQuery += "   AND SB1EXS.B1_GRUPO <= ? "
			cQuery += "   AND SB1EXS.D_E_L_E_T_ = ? "
			cQuery += "   AND NOT EXISTS "
			cQuery += "     (SELECT 1 "
			cQuery += " 	  FROM "+RetSQLName('SB1')+" SB1 "
			cQuery += " 	   INNER JOIN "+RetSQLName('SD1')+" SD1 "
			cQuery += " 			   ON SD1.D1_FILIAL = ? "
			cQuery += " 			  AND SD1.D1_COD = SB1EXS.B1_COD "
			cQuery += " 			  AND SD1.D1_LOCAL = ? "
			cQuery += " 			  AND SD1.D1_DTDIGIT >= ? "
			cQuery += " 			  AND SD1.D1_DTDIGIT <= ? "
			cQuery += " 			  AND SD1.D1_ORIGLAN <> ? "
			cQuery += " 			  AND SD1.D_E_L_E_T_ = ? "
			cQuery += " 	   INNER JOIN "+RetSQLName('SF4')+" SF4 "
			cQuery += " 			   ON SF4.F4_FILIAL = ? "
			cQuery += " 			  AND SF4.F4_CODIGO = SD1.D1_TES "
			cQuery += " 			  AND SF4.F4_ESTOQUE = ? "
			cQuery += " 			  AND SF4.D_E_L_E_T_ = ? "
			cQuery += " 	  WHERE SB1.B1_FILIAL = ? "
			cQuery += " 	    AND SB1.B1_COD = SB1EXS.B1_COD "
			cQuery += " 	    AND SB1.B1_COD <> ? "
			cQuery += " 	    AND SB1.B1_TIPO >= ? "
			cQuery += " 	    AND SB1.B1_TIPO <= ? "
			cQuery += " 	    AND SB1.B1_GRUPO >= ? "
			cQuery += " 	    AND SB1.B1_GRUPO <= ? "
			cQuery += " 	    AND SB1.D_E_L_E_T_ = ?) "
			cQuery += "   AND NOT EXISTS "
			cQuery += "     (SELECT 1 "
			cQuery += " 	  FROM "+RetSQLName('SB1')+" SB1 "
			cQuery += " 	   INNER JOIN "+RetSQLName('SD2')+" SD2 "
			cQuery += " 			   ON SD2.D2_FILIAL = ? "
			cQuery += " 			  AND SD2.D2_COD = SB1.B1_COD "
			cQuery += " 			  AND SD2.D2_LOCAL = ? "
			cQuery += " 			  AND SD2.D2_EMISSAO >= ? "
			cQuery += " 			  AND SD2.D2_EMISSAO <= ? "
			cQuery += " 			  AND SD2.D2_ORIGLAN <> ? "
			cQuery += " 			  AND SD2.D_E_L_E_T_ = ? "
			cQuery += " 	   INNER JOIN "+RetSQLName('SF4')+" SF4 "
			cQuery += " 			   ON SF4.F4_FILIAL = ? "
			cQuery += " 			  AND SF4.F4_CODIGO = SD2.D2_TES "
			cQuery += " 			  AND SF4.F4_ESTOQUE = ? "
			cQuery += " 			  AND SF4.D_E_L_E_T_= ? "
			cQuery += " 	  WHERE SB1.B1_FILIAL = ? "
			cQuery += " 	    AND SB1.B1_COD = SB1EXS.B1_COD "
			cQuery += " 	    AND SB1.B1_COD <> ? "
			cQuery += " 	    AND SB1.B1_TIPO >= ? "
			cQuery += " 	    AND SB1.B1_TIPO <= ? "
			cQuery += " 	    AND SB1.B1_GRUPO >= ? "
			cQuery += " 	    AND SB1.B1_GRUPO <= ? "
			cQuery += " 	    AND SB1.D_E_L_E_T_ = ?) "
			cQuery += "   AND NOT EXISTS "
			cQuery += "     (SELECT 1 "
			cQuery += " 	  FROM "+RetSQLName('SB1')+" SB1 "
			cQuery += " 	   INNER JOIN "+RetSQLName('SD3')+" SD3 "
			cQuery += " 			   ON SD3.D3_FILIAL = ? "
			cQuery += " 			  AND SD3.D3_COD = SB1.B1_COD "
			cQuery += " 			  AND SD3.D3_LOCAL = ? "
			cQuery += " 			  AND SD3.D3_EMISSAO >= ? "
			cQuery += " 			  AND SD3.D3_EMISSAO <= ? "
			cQuery += " 			  AND SD3.D3_ESTORNO <> ? "
			cQuery += " 			  AND SD3.D_E_L_E_T_ = ? "
			cQuery += " 	  WHERE SB1.B1_FILIAL = ? "
			cQuery += " 	    AND SB1.B1_COD = SB1EXS.B1_COD "
			cQuery += " 	    AND SB1.B1_COD <> ? "
			cQuery += " 	    AND SB1.B1_TIPO >= ? "
			cQuery += " 	    AND SB1.B1_TIPO <= ? "
			cQuery += " 	    AND SB1.B1_GRUPO >= ? "
			cQuery += " 	    AND SB1.B1_GRUPO <= ? "
			cQuery += " 	    AND SB1.D_E_L_E_T_ = ?) "
		EndIf
		cQuery += " ORDER BY 2, 17, 31, 8, 12 "

		cQuery := ChangeQuery(cQuery)

		//Montagem da query para execução
		oQuery := FwExecStatement():New(cQuery)

		cBkpFil := cFilAnt

		For nFil :=1 to len(self:aFils)
			cFilAnt := self:aFils[nFil]

			//Binding - Query 1
			oQuery:SetUnsafe(1, cFieldsSD1)
			oQuery:SetString(2, FWxFilial("SD1"))
			oQuery:SetString(3, cArmzPrd)
			oQuery:SetString(4, cDataDe)
			oQuery:SetString(5, cDataAte)
			oQuery:SetString(6, 'LF')
			oQuery:SetString(7, ' ')
			oQuery:SetString(8, FWxFilial("SF4"))
			oQuery:SetString(9, 'S')
			oQuery:SetString(10, ' ')
			oQuery:SetIn(11, aPartes)
			oQuery:SetString(12, cMoeda)
			oQuery:SetString(13, FWxFilial("D4F"))
			oQuery:SetString(14, ' ')
			oQuery:SetString(15, FWxFilial("SB1"))
			oQuery:SetString(16, jParams['MV_PAR01'][1])
			oQuery:SetString(17, jParams['MV_PAR02'][1])
			oQuery:SetString(18, cProdImp)
			oQuery:SetString(19, jParams['MV_PAR03'][1])
			oQuery:SetString(20, jParams['MV_PAR04'][1])
			oQuery:SetString(21, jParams['MV_PAR13'][1])
			oQuery:SetString(22, jParams['MV_PAR14'][1])
			oQuery:SetString(23, ' ')

			//Binding - Query 2
			oQuery:SetUnsafe(24, cFieldsSD2)
			oQuery:SetString(25, FWxFilial("SD2"))
			oQuery:SetString(26, cArmzPrd)
			oQuery:SetString(27, cDataDe)
			oQuery:SetString(28, cDataAte)
			oQuery:SetString(29, 'LF')
			oQuery:SetString(30, ' ')
			oQuery:SetString(31, FWxFilial("SF4"))
			oQuery:SetString(32, 'S')
			oQuery:SetString(33, ' ')
			oQuery:SetIn(34, aPartes)
			oQuery:SetString(35, cMoeda)
			oQuery:SetString(36, FWxFilial("D4F"))
			oQuery:SetString(37, ' ')
			oQuery:SetString(38, FWxFilial("SB1"))
			oQuery:SetString(39, jParams['MV_PAR01'][1])
			oQuery:SetString(40, jParams['MV_PAR02'][1])
			oQuery:SetString(41, cProdImp)
			oQuery:SetString(42, jParams['MV_PAR03'][1])
			oQuery:SetString(43, jParams['MV_PAR04'][1])
			oQuery:SetString(44, jParams['MV_PAR13'][1])
			oQuery:SetString(45, jParams['MV_PAR14'][1])
			oQuery:SetString(46, ' ')

			//Binding - Query 3
			oQuery:SetUnsafe(47, cFieldsSD3)
			oQuery:SetString(48, FWxFilial("SD3"))
			oQuery:SetString(49, cArmzPrd)
			oQuery:SetString(50, cDataDe)
			oQuery:SetString(51, cDataAte)
			oQuery:SetString(52, 'S')
			oQuery:SetString(53, ' ')
			oQuery:SetIn(54, aPartes)
			oQuery:SetString(55, cMoeda)
			oQuery:SetString(56, FWxFilial("D4F"))
			oQuery:SetString(57, ' ')
			oQuery:SetString(58, FWxFilial("SB1"))
			oQuery:SetString(59, jParams['MV_PAR01'][1])
			oQuery:SetString(60, jParams['MV_PAR02'][1])
			oQuery:SetString(61, cProdImp)
			oQuery:SetString(62, jParams['MV_PAR03'][1])
			oQuery:SetString(63, jParams['MV_PAR04'][1])
			oQuery:SetString(64, jParams['MV_PAR13'][1])
			oQuery:SetString(65, jParams['MV_PAR14'][1])
			oQuery:SetString(66, ' ')

			If jParams['MV_PAR07'][1] <> 2
				//Binding - Query 4
				oQuery:SetUnsafe(67, cFieldsSB1)
				oQuery:SetString(68, FWxFilial("SB1"))
				oQuery:SetString(69, jParams['MV_PAR01'][1])
				oQuery:SetString(70, jParams['MV_PAR02'][1])
				oQuery:SetString(71, cProdImp)
				oQuery:SetString(72, jParams['MV_PAR03'][1])
				oQuery:SetString(73, jParams['MV_PAR04'][1])
				oQuery:SetString(74, jParams['MV_PAR13'][1])
				oQuery:SetString(75, jParams['MV_PAR14'][1])
				oQuery:SetString(76, ' ')
				oQuery:SetString(77, FWxFilial("SD1"))
				oQuery:SetString(78, cArmzPrd)
				oQuery:SetString(79, cDataDe)
				oQuery:SetString(80, cDataAte)
				oQuery:SetString(81, 'LF')
				oQuery:SetString(82, ' ')
				oQuery:SetString(83, FWxFilial("SF4"))
				oQuery:SetString(84, 'S')
				oQuery:SetString(85, ' ')
				oQuery:SetString(86, FWxFilial("SB1"))
				oQuery:SetString(87, cProdImp)
				oQuery:SetString(88, jParams['MV_PAR03'][1])
				oQuery:SetString(89, jParams['MV_PAR04'][1])
				oQuery:SetString(90, jParams['MV_PAR13'][1])
				oQuery:SetString(91, jParams['MV_PAR14'][1])
				oQuery:SetString(92, ' ')
				oQuery:SetString(93, FWxFilial("SD2"))
				oQuery:SetString(94, cArmzPrd)
				oQuery:SetString(95, cDataDe)
				oQuery:SetString(96, cDataAte)
				oQuery:SetString(97, 'LF')
				oQuery:SetString(98, ' ')
				oQuery:SetString(99, FWxFilial("SF4"))
				oQuery:SetString(100, 'S')
				oQuery:SetString(101, ' ')
				oQuery:SetString(102, FWxFilial("SB1"))
				oQuery:SetString(103, cProdImp)
				oQuery:SetString(104, jParams['MV_PAR03'][1])
				oQuery:SetString(105, jParams['MV_PAR04'][1])
				oQuery:SetString(106, jParams['MV_PAR13'][1])
				oQuery:SetString(107, jParams['MV_PAR14'][1])
				oQuery:SetString(108, ' ')
				oQuery:SetString(109, FWxFilial("SD3"))
				oQuery:SetString(110, cArmzPrd)
				oQuery:SetString(111, cDataDe)
				oQuery:SetString(112, cDataAte)
				oQuery:SetString(113, 'LF')
				oQuery:SetString(114, ' ')
				oQuery:SetString(115, FWxFilial("SB1"))
				oQuery:SetString(116, cProdImp)
				oQuery:SetString(117, jParams['MV_PAR03'][1])
				oQuery:SetString(118, jParams['MV_PAR04'][1])
				oQuery:SetString(119, jParams['MV_PAR13'][1])
				oQuery:SetString(120, jParams['MV_PAR14'][1])
				oQuery:SetString(121, ' ')
			EndIf

			cAliasTmp := oQuery:OpenAlias()

			(cAliasTmp)->(dbGoTop())
			While !(cAliasTmp)->(Eof())
				//Se nao encontrar no arquivo de saldos ,nao lista
				If !SB2->(dbSeek(FWxFilial("SB2")+(cAliasTmp)->PRODUTO+(cAliasTmp)->ARMAZEM))
					(cAliasTmp)->(dbSkip())
					Loop
				EndIf

				lFirst := .T. 
				cProdAnt := (cAliasTmp)->PRODUTO
				cLocalAnt := (cAliasTmp)->ARMAZEM

				aAuxCus := SldAtuProd((cAliasTmp)->PRODUTO, (cAliasTmp)->ARMAZEM, nMoeda, dData)
				aSalAtu := aAuxCus[2]

				While !(cAliasTmp)->(Eof()) .And. (cAliasTmp)->PRODUTO = cProdAnt .And. (cAliasTmp)->ARMAZEM == cLocalAnt
					cCCPVPJOP := ""
					nTipoMov := 0

					Do Case
						Case Alltrim((cAliasTmp)->ARQ) == "SD1"
							lDev := NotaDev("SD1", cAliasTmp)
							cCCPVPJOP := 'F-'+(cAliasTmp)->FORNECEDOR
							nTipoMov := 1
							If (cAliasTmp)->TES <= "500" .And. !lDev
								If (cAliasTmp)->TIPONF != "C"
									nCusMedLn := (cAliasTmp)->CUSTOP / (cAliasTmp)->QUANTIDADE
								EndIf
								
								aSalAtu[1] += (cAliasTmp)->QUANTIDADE
								aSalAtu[nMoeda+1] += (cAliasTmp)->CUSTOP
								aSalAtu[7] += (cAliasTmp)->QUANT2UM
							Else
								If (cAliasTmp)->TIPONF != "C"
									nCusMedLn := (cAliasTmp)->CUSTOP / (cAliasTmp)->QUANTIDADE
								EndIf

								If lDev
									aSalAtu[1] += (cAliasTmp)->QUANTIDADE
									aSalAtu[nMoeda+1] += (cAliasTmp)->CUSTOP
									aSalAtu[7] += (cAliasTmp)->QUANT2UM
								EndIf
							EndIf
						Case Alltrim((cAliasTmp)->ARQ) = "SD2"
							lDev := NotaDev("SD2", cAliasTmp)
							nTipoMov := 2
							If ((cAliasTmp)->TIPONF) == "B"
								cCCPVPJOP := 'F-'+(cAliasTmp)->FORNECEDOR
							Else
								cCCPVPJOP := 'C-'+(cAliasTmp)->FORNECEDOR
							EndIf
							If (cAliasTmp)->TES <= "500" .Or. lDev
								If lDev
									aSalAtu[1] 			-= (cAliasTmp)->QUANTIDADE
									aSalAtu[nMoeda+1]	-= (cAliasTmp)->CUSTOP
									aSalAtu[7]			-= (cAliasTmp)->QUANT2UM
								EndIf

								If (cAliasTmp)->TIPONF != "C"
									nCusMedLn := (cAliasTmp)->CUSTOP / (cAliasTmp)->QUANTIDADE
								EndIf
							Else
								If (cAliasTmp)->TIPONF != "C"
									nCusMedLn := (cAliasTmp)->CUSTOP / (cAliasTmp)->QUANTIDADE
								EndIf

								aSalAtu[1]			-= (cAliasTmp)->QUANTIDADE
								aSalAtu[nMoeda+1]	-= (cAliasTmp)->CUSTOP
								aSalAtu[7]			-= (cAliasTmp)->QUANT2UM
							EndIf
						Case Alltrim((cAliasTmp)->ARQ) == "SD3"
							If Empty((cAliasTmp)->OP) .And. Empty((cAliasTmp)->PROJETO)
								cCCPVPJOP := 'CC'+(cAliasTmp)->CC
							ElseIf !Empty((cAliasTmp)->PROJETO)
								cCCPVPJOP := 'PJ'+(cAliasTmp)->PROJETO
							ElseIf !Empty((cAliasTmp)->OP)
								cCCPVPJOP := 'OP'+(cAliasTmp)->OP
							EndIf
							If (cAliasTmp)->TES <= "500"
								nTipoMov := 1
								nCusMedLn := (cAliasTmp)->CUSTOP / (cAliasTmp)->QUANTIDADE

								aSalAtu[1]			+= (cAliasTmp)->QUANTIDADE
								aSalAtu[nMoeda+1]	+= (cAliasTmp)->CUSTOP
								aSalAtu[7]			+= (cAliasTmp)->QUANT2UM
							Else
								nTipoMov := 2
								nCusMedLn := (cAliasTmp)->CUSTOP / (cAliasTmp)->QUANTIDADE

								aSalAtu[1]			-= (cAliasTmp)->QUANTIDADE
								aSalAtu[nMoeda+1]	-= (cAliasTmp)->CUSTOP
								aSalAtu[7]			-= (cAliasTmp)->QUANT2UM
							EndIf
					EndCase

					self:jItems := JsonObject():New()
					For nX := 1 To Len(self:aFields)
						If self:aFields[nX] == "FILIAL"
							self:jItems[self:aFields[nX]] := cFilAnt
						ElseIf self:aFields[nX] == "QUANTINI"
							If lFirst
								self:jItems[self:aFields[nX]] := aAuxCus[2][1]
							EndIf
						ElseIf self:aFields[nX] == "CUSTOINI"
							If lFirst
								self:jItems[self:aFields[nX]] := aAuxCus[2][nMoeda+1]
							EndIF
						ElseIf self:aFields[nX] == "CUSTOMEDINI"
							If lFirst
								self:jItems[self:aFields[nX]] := aAuxCus[1]
							EndIf
						ElseIf self:aFields[nX] == "DATA"
							self:jItems[self:aFields[nX]] := FwTimeStamp(6,sToD((cAliasTmp)->&(self:aFields[nX])),"00:00:00")
						ElseIf self:aFields[nX] == "CCPVPJOP"
							self:jItems[self:aFields[nX]] := cCCPVPJOP
						ElseIf self:aFields[nX] == "TPMOVIMEN"
							If nTipoMov == 1
								self:jItems[self:aFields[nX]] := STR0006
							ElseIf nTipoMov == 2
								self:jItems[self:aFields[nX]] := STR0007
							EndIf
						ElseIf self:aFields[nX] == "CUSTOMED"
							self:jItems[self:aFields[nX]] := nCusMedLn
						Else
							self:jItems[self:aFields[nX]] := (cAliasTmp)->&(self:aFields[nX])
						EndIf
					Next nX

					//Custo acumulado do movimento
					self:jItems["QTDTOTAL"]		:= aSalAtu[1]
					self:jItems["CUSTOTOTAL"]	:= aSalAtu[nMoeda+1]
					self:jItems["CUSTOMEDTOT"]	:= (aSalAtu[nMoeda+1] / aSalAtu[1])

					//Inclui custo das partes nas colunas
					For nX := 1 To Len(aPartes)
						self:jItems["PARTE"+StrZero(nX, 1)] := aPartes[nX] + "-" + aPartesDet[nX][2]
						If (cAliasTmp)->PARTE == aPartes[nX]
							self:jItems["CUSTOP"+StrZero(nX, 1)] := (cAliasTmp)->CUSTOP
							self:jItems["CUSTOTOTALP"+StrZero(nX, 1)] := aSalAtu[nMoeda+1]
							self:jItems["CUSTOMEDP"+StrZero(nX, 1)] := (aSalAtu[nMoeda+1] / aSalAtu[1])
						Else
							self:jItems["CUSTOP"+StrZero(nX, 1)] := 0
							self:jItems["CUSTOTOTALP"+StrZero(nX, 1)] := 0
							self:jItems["CUSTOMEDP"+StrZero(nX, 1)] := 0
						EndIf
					Next

					self:processData()
					self:oData:appendData(self:jItems)

					lFirst := .F.

					(cAliasTmp)->(dbSkip())
				EndDo
			EndDo

			(cAliasTmp)->( DBCloseArea() )
		Next

		cFilAnt := cBkpFil

		oQuery:Destroy()
	EndIf

return self:oData

//-------------------------------------------------------------------
/*{Protheus.doc} getSchema
Retorna a estrutura dos campos
 
@return object: self:oSchema
 
@author Leonardo Kichitaro
@since 01/2026
@version 1.0
*/
//-------------------------------------------------------------------   
Method oNGetSchema() Class KardexInPartsSmartViewBusinessObject

	Local nX	as numeric

	self:aFields := {"FILIAL", "PRODUTO", "DESCRICAO", "UM", "TIPO", "GRUPO", "ARMAZEM", "POSICAOIPI", "QUANTINI", "CUSTOINI", "CUSTOMEDINI", "DATA", "TES", "CF", "CCPVPJOP", "TPMOVIMEN", "MOEDA", "QUANTIDADE", "CUSTO", "CUSTOMED"}

	self:addProperty( "FILIAL"		, STR0008, "string", STR0008, "FILIAL")		//"Filial"
	self:addProperty( "PRODUTO"		, STR0009, "string", STR0009, "PRODUTO")	//"Produto"
	self:addProperty( "DESCRICAO"	, STR0010, "string", STR0010, "DESCRICAO")	//"Descrição"
	self:addProperty( "UM"			, STR0011, "string", STR0011, "UM")			//"Unidade"
	self:addProperty( "TIPO"		, STR0012, "string", STR0012, "TIPO")		//"Tipo"
	self:addProperty( "GRUPO"		, STR0013, "string", STR0013, "GRUPO")		//"Grupo"
	self:addProperty( "ARMAZEM"		, STR0014, "string", STR0014, "ARMAZEM")	//"Local"
	self:addProperty( "POSICAOIPI"	, STR0015, "string", STR0015, "POSICAOIPI")	//"Posição IPI"
	self:addProperty( "QUANTINI"	, STR0016, "number", STR0016, "QUANTINI")	//"Qtde. Inicial"
	self:addProperty( "CUSTOINI"	, STR0017, "number", STR0017, "CUSTOINI")	//"Custo Movimento Inicial"
	self:addProperty( "CUSTOMEDINI"	, STR0018, "number", STR0018, "CUSTOMEDINI")//"Custo Médio Movimento Inicial"
	self:addProperty( "DATA"		, STR0019, "date"  , STR0019, "DATA")		//"Data"
	self:addProperty( "TES"			, STR0020, "string", STR0020, "TES")		//"TES"
	self:addProperty( "CF"			, STR0021, "string", STR0021, "CF")			//"C.F."
	self:addProperty( "CCPVPJOP"    , STR0022, "string", STR0022, "CCPVPJOP")	//"Cli, For, CC, PJ, OP ou OS"
	self:addProperty( "TPMOVIMEN"	, STR0023, "string", STR0023, "TPMOVIMEN")	//"Tipo do Movimento"
	self:addProperty( "MOEDA"		, STR0024, "string", STR0024, "MOEDA")		//"Moeda"
	self:addProperty( "QUANTIDADE"	, STR0025, "number", STR0025, "QUANTIDADE")	//"Qtde. Movimento"
	self:addProperty( "CUSTO"		, STR0026, "number", STR0026, "CUSTO")		//"Custo Movimento"
	self:addProperty( "CUSTOMED"	, STR0027, "number", STR0027, "CUSTOMED")	//"Custo Médio Movimento"
	self:addProperty( "QTDTOTAL"	, STR0028, "number", STR0028, "QTDTOTAL")	//"Quantidade Total"
	self:addProperty( "CUSTOTOTAL"	, STR0029, "number", STR0029, "CUSTOTOTAL")	//"Custo Total"
	self:addProperty( "CUSTOMEDTOT"	, STR0030, "number", STR0030, "CUSTOMEDTOT")//"Custo Médio Total"

	For nX := 1 To 5
		self:addProperty( "PARTE"+StrZero(nX, 1)		, "P"+StrZero(nX, 1), "string", "P"+StrZero(nX, 1), "PARTE"+StrZero(nX, 1))
		self:addProperty( "CUSTOP"+StrZero(nX, 1)		, STR0031+" P"+StrZero(nX, 1), "number", STR0031+" P"+StrZero(nX, 1), "CUSTOP"+StrZero(nX, 1))		//"Custo"
		self:addProperty( "CUSTOTOTALP"+StrZero(nX, 1)	, STR0032+" P"+StrZero(nX, 1), "number", STR0032+" P"+StrZero(nX, 1), "CUSTOTOTALP"+StrZero(nX, 1))	//"Custo Total"
		self:addProperty( "CUSTOMEDP"+StrZero(nX, 1)	, STR0033+" P"+StrZero(nX, 1), "number", STR0033+" P"+StrZero(nX, 1), "CUSTOMEDP"+StrZero(nX, 1))	//"Custo Médio"
	Next

Return

//-------------------------------------------------------------------
/*{Protheus.doc} SldAtuProd
Retorna informacoes do saldo inicial do item
 
@return array
 
@author Leonardo Kichitaro
@since 01/2026
@version 1.0
*/
//------------------------------------------------------------------- 
Static Function SldAtuProd(cProduto as character, cLocal as character, nMoeda as numeric, dData as date)

	Local aArea     := GetArea()
	Local nCusMed   := 0
	Local aSalAlmox := {}
	Local cCampo    := ""
	Local bBloco	:= { |nV,nX| Trim(nV)+IIf(Valtype(nX)='C',"",StrZero(nX,2)) }

	//Calcula o Saldo Inicial do Produto
	aSalAlmox := CalcEst(cProduto,cLocal,dData,,, .F. )

	//Calcula o Custo Medio do Produto
	SB2->(dbSeek(FWxFilial("SB2") + cProduto + cLocal))
	If aSalAlmox[1] > 0
		nCusmed := aSalAlmox[nMoeda+1]/aSalAlmox[1]
	ElseIf aSalAlmox[1] == 0 .and. aSalAlmox[nMoeda+1] == 0
		nCusMed := 0
	Else
		cCampo := Eval(bBloco,"B2_CM",nMoeda)
		IF  SB2->(Fieldpos(cCampo)) <> 0
			nCusmed := &(Eval(bBloco,"SB2->B2_CM",nMoeda))
		Else
			nCusmed := &("SB2->B2_CM"+cvaltochar(nMoeda))
		EndIf
	EndIf

	RestArea(aArea)

Return {nCusMed, aSalAlmox}

//-------------------------------------------------------------------
/*{Protheus.doc} NotaDev
Avalia se item pertence a uma nota de devolução
 
@return lógico
 
@author Leonardo Kichitaro
@since 01/2026
@version 1.0
*/
//------------------------------------------------------------------- 
Static Function NotaDev(cAlias,cAliasTmp)

	Local lRet := .F.
	Local cSeek := (cAliasTmp)->DOCUMENTO+(cAliasTmp)->SERIE+(cAliasTmp)->FORNECEDOR+(cAliasTmp)->LOJA

	// Identifica se lista dev. na mesma coluna
	lListaDev := If(ValType(lListaDev)#"L",GetMV("MV_LISTDEV"),lListaDev)

	If lListaDev .And. cAlias == "SD1"
		If SF1->(dbSeek(FWxFilial("SF1") + cSeek) .And. SF1->F1_TIPO == "D")
			lRet:=.T.
		EndIf
	ElseIf lListaDev .And. cAlias == "SD2"
		If SF2->(dbSeek(FWxFilial("SF2") + cSeek)) .And. SF2->F2_TIPO == "D"
			lRet:=.T.
		EndIf
	EndIf

Return lRet

//-------------------------------------------------------------------
/*{Protheus.doc} DetPartes
Busca as partes selecionadas e suas descrições
 
@return array
 
@author Leonardo Kichitaro
@since 01/2026
@version 1.0
*/
//------------------------------------------------------------------- 
Static Function DetPartes(aPartes)

	Local aRetPar	:= {}
	Local cQuery	:= ""
	Local cTmpD4F	:= ""
	Local nPos		:= 0

	If __oQueryD4F == Nil
		cQuery := "SELECT D4F_FILIAL, D4F_REVIS, D4F_CODPAR, D4F_TITULO, D4F_STATUS "
		cQuery += " FROM "+RetSQLName('D4F')+" D4F "
		cQuery += " WHERE D4F.D4F_FILIAL = ? "
		cQuery += "   AND D4F.D4F_CODPAR IN (?) "
		cQuery += "   AND D4F.D4F_STATUS <> ? "
		cQuery += "   AND D4F.D_E_L_E_T_ = ? "
		cQuery += " ORDER BY D4F_FILIAL, D4F_REVIS, D4F_CODPAR, D4F_STATUS "

		cQuery := ChangeQuery(cQuery)

		//Montagem da query para execução
		__oQueryD4F := FwExecStatement():New(cQuery)
	EndIf

	//Binding
	__oQueryD4F:SetString(1, FWxFilial("D4F"))
	__oQueryD4F:SetIn(2, aPartes)
	__oQueryD4F:SetString(3, '2')
	__oQueryD4F:SetString(4, ' ')

	cTmpD4F := __oQueryD4F:OpenAlias()

	(cTmpD4F)->(dbGoTop())
	While !(cTmpD4F)->(Eof())
		If (nPos := aScan(aRetPar,{|x| x[1] == (cTmpD4F)->D4F_CODPAR})) > 0
			If (cTmpD4F)->D4F_STATUS == '1'
				aRetPar[nPos][2] := (cTmpD4F)->D4F_TITULO
			EndIf
		Else
			aAdd(aRetPar, {(cTmpD4F)->D4F_CODPAR, (cTmpD4F)->D4F_TITULO})
		EndIf

		(cTmpD4F)->(dbSkip())
	EndDo
	(cTmpD4F)->(DBCloseArea())

Return aRetPar
