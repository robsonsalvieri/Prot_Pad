#include "msobject.ch"
#include "protheus.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "backoffice.sv.est.totalproductioncostvspartcost.ch"
#include "totvs.framework.treports.integratedprovider.th"

#DEFINE SX1GRUPO 'ESTT045'

namespace totvs.protheus.backoffice.est.totalproductioncostvspartcost.integratedprovider

using namespace totvs.framework.treports.integratedprovider
using namespace totvs.protheus.backoffice.stock.iterativecost.view.manager
using Namespace totvs.protheus.backoffice.stock.iterativecost.view.parts.internaltransactions

@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGAEST", tables="SB1,SB2,SB9,SD1,SD2,SD3", name="Custo Total Produção x Partes", country="ALL")

//-------------------------------------------------------------------
/*{Protheus.doc} TotalProductioncostVsPartcostSmartViewBusinessObject
Classe para criação do Objeto de Negócio de Custo Total Produção x Partes
 
@author Leonardo Kichitaro
@since 12/2025
@version 1.0
*/
//-------------------------------------------------------------------  
Class TotalProductioncostVsPartcostSmartViewBusinessObject From totvs.protheus.backoffice.est.smartView.integratedProvider.EstIntegratedProvider

	Public Method new()				as object
	Public Method getData()			as object

	Protected Method oNGetSchema()
	Protected data jItems		  as json
	Protected data cWhere		  as character
	Protected data aFields		  as array
	Protected data aFieldsParte	  as array
	Protected data lExistPergunte as logical
	Protected data cNameViewSB9	  as character
	Protected data cNameViewSD1	  as character

EndClass
 
//-------------------------------------------------------------------
/*{Protheus.doc} new
Método de instância da classe
 
@return object: self
 
@author Leonardo Kichitaro
@since 12/2025
@version 1.0
*/
//-------------------------------------------------------------------   
Method new() Class TotalProductioncostVsPartcostSmartViewBusinessObject

	Local lExecute	as logical

	_Super:new()

	//Define a Área
	self:appendArea(STR0001) //"Estoque/Custos"

	//Define o nome do Objeto de Negócio
	self:setDisplayName(STR0002) //"Custo Total Produção x Partes"
 
	//Define a descrição do Objeto de Negócio
	self:setDescription(STR0003) //"Emite uma relação dos custos totais produção x partes."

	//Indica o pergunte que será utilizado no relatório
	lExecute  := FnVldCMod2()
    self:lExistPergunte := (self:setPergunte( SX1GRUPO ) .And. lExecute)
	If !self:lExistPergunte
		self:setErrorStatus(400,STR0004,i18n(STR0005,{SX1GRUPO}))//O Grupo de perguntas #1 não existe
		FWLogMsg('WARN', , 'SmartView', , , , i18n(STR0005,{SX1GRUPO}), , , )//O Grupo de perguntas #1 não existe
	EndIf
    
	//Indica que o LookUp será do tipo padrão LookUp
    self:setIsLookUp(.T.)

Return self

//-------------------------------------------------------------------
/*{Protheus.doc} getData
Retorna os dados do objeto de negócio
 
@param nPage, numérico, indica a página atual do relatório
@param oFilter, objeto, contém o filtro do TReports
 
@return object: self:oData
 
@author Leonardo Kichitaro
@since 12/2025
@version 1.0
*/
//-------------------------------------------------------------------   
Method getData( nPage as Numeric, oFilter as object) as object Class TotalProductioncostVsPartcostSmartViewBusinessObject

	Local oQuery						as object
	Local oViews						as object
    Local oViewCpInternaltransactions	as object

	Local cQuery						as character
	Local cFields						as character
	Local cAliasTmp						as character
    Local cNameViewD3SDPRCP				as character
	Local cBkpFil						as character
	Local nX							as numeric
	Local nFil							as numeric
	Local jParams						as json
	Local cMoeda						as character
	Local dDataDe						as date
	Local dDataAte						as date

	//Valida o pergunte
	If !self:lExistPergunte	
		return self:oData
	Endif

	//Metodo para retorno do json dos parâmetros
    jParams := oFilter:getParameters()

    //Retorno da tela de multi filiais com as filiais selecionadas ou somente a filial corrente
    self:aFils := self:retFils(jParams['SV_MULTBRANCH'], oFilter)

	dDataDe := FwDateTimeToLocal( jParams['MV_PAR03'][1] )[1]
	dDataAte := FwDateTimeToLocal( jParams['MV_PAR04'][1] )[1]

	If jParams['MV_PAR05'][1] == 0
		cMoeda := '01'
	Else
		cMoeda := StrZero(jParams['MV_PAR05'][1], 2)
	EndIf

	oViews := ViewManager():New({cFilAnt})
	oViews:Install()

    oViewCpInternaltransactions := ViewInternalTransactionsParts():New({cFilAnt})

    cNameViewD3SDPRCP := "VW_" + oViewCpInternaltransactions:GetViewID() + "_" + cEmpAnt

	// Instala views
    If TCIsView(cNameViewD3SDPRCP)
		//Query View SD3/D4N
		cFields := 'D3_FILIAL FILIAL, '
		cFields += 'D3_OP ORDEMPROD, '
		cFields += 'D3_COD PRODUTO, '
		cFields += 'B1_DESC DESCRICAO, '
		cFields += 'D3_LOCAL LOCALPROD, '
		cFields += 'D3_EMISSAO DATA, '
		cFields += 'D3_QUANT QUANTIDADE, '
		cFields += 'D4N_MOEDA MOEDA, '
		cFields += 'D3_CUSTO' + SubStr(cMoeda,2,1) + ' CUSTOTOTAL, '
		cFields += 'D4N_REVISA REVISAO, '
		cFields += 'D4N_PARTE PARTE, '
		cFields += 'Coalesce(D4N_TOTAL,0) TOTPARTE, '
		cFields += 'D4F_TITULO DESCPARTE '

		cQuery := "SELECT ? "
		cQuery += " FROM " + cNameViewD3SDPRCP + " SD3 "
		cQuery += " INNER JOIN "+RetSQLName('SB1')+" SB1 "
		cQuery += " ON SB1.B1_FILIAL = ?"
		cQuery += " AND SB1.B1_COD  = SD3.D3_COD"
		cQuery += " AND SB1.D_E_L_E_T_ = ?"
		cQuery += " Left Join "+RetSQLName('D4F')+" D4F"
		cQuery += " ON D4F.D4F_FILIAL = ?"
		cQuery += " AND D4F.D4F_REVIS  = SD3.D4N_REVISA"
		cQuery += " AND D4F.D4F_CODPAR = SD3.D4N_PARTE"
		cQuery += " AND D4F.D_E_L_E_T_ = ?"
		cQuery += " WHERE SD3.D3_FILIAL = ?"
		cQuery += " AND SD3.D3_EMISSAO >= ? AND SD3.D3_EMISSAO <= ?"
		cQuery += " AND	SD3.D3_CF = ?"
		cQuery += " AND SD3.D3_COD >= ? AND SD3.D3_COD <= ?"
		cQuery += " AND	SD3.D4N_MOEDA = ?"
		cQuery += " ORDER BY SD3.D3_FILIAL, SD3.D3_COD, SD3.D3_LOCAL, SD3.D3_EMISSAO, SD3.D4N_PARTE "

		cQuery := ChangeQuery(cQuery)

		//Montagem da query para execução
		oQuery := FwExecStatement():New(cQuery)

		cBkpFil := cFilAnt

		For nFil :=1 to len(self:aFils)
			cFilAnt := self:aFils[nFil]

			//Binding
			oQuery:SetUnsafe(1, cFields)
			oQuery:SetString(2, FWxFilial("SB1"))
			oQuery:SetString(3, ' ')
			oQuery:SetString(4, FWxFilial("D4F"))
			oQuery:SetString(5, ' ')
			oQuery:SetString(6, FWxFilial("SD3"))
			oQuery:SetString(7, Dtos(dDataDe))
			oQuery:SetString(8, Dtos(dDataAte))
			oQuery:SetString(9, 'PR0')
			oQuery:SetString(10, jParams['MV_PAR01'][1])
			oQuery:SetString(11, jParams['MV_PAR02'][1])
			oQuery:SetString(12, cMoeda)

			cAliasTmp := oQuery:OpenAlias()

			(cAliasTmp)->(dbGoTop())
			While !(cAliasTmp)->(Eof())
				self:jItems := JsonObject():New()

				//aFields
				For nX := 1 To Len(self:aFields)
					If self:aFields[nX] == "DATA"
						self:jItems[self:aFields[nX]] := FwTimeStamp(6,sToD((cAliasTmp)->&(self:aFields[nX])),"00:00:00")
					Else
						self:jItems[self:aFields[nX]] := (cAliasTmp)->&(self:aFields[nX])
					EndIf
				Next nX

				//aFieldsParte
				For nX := 1 To Len(self:aFieldsParte)
					If self:aFieldsParte[nX] == 'PARTE'
						self:jItems[self:aFieldsParte[nX]] := AllTrim((cAliasTmp)->&(self:aFieldsParte[nX])) + " - " + (cAliasTmp)->DESCPARTE
					Else
						self:jItems[self:aFieldsParte[nX]] := (cAliasTmp)->&(self:aFieldsParte[nX])
					EndIf
				Next nX

				self:processData()
				self:oData:appendData(self:jItems)

				(cAliasTmp)->(DBSkip())
			EndDo

			(cAliasTmp)->( DBCloseArea() )
		Next

		cFilAnt := cBkpFil

		oQuery:Destroy()
	EndIf

return self:oData

//-------------------------------------------------------------------
/*{Protheus.doc} getSchema
Retorna a estrutura dos campos
 
@return object: self:oSchema
 
@author Leonardo Kichitaro
@since 12/2025
@version 1.0
*/
//-------------------------------------------------------------------   
Method oNGetSchema() Class TotalProductioncostVsPartcostSmartViewBusinessObject

	self:aFields		:= {"FILIAL", "ORDEMPROD", "PRODUTO", "DESCRICAO", "LOCALPROD", "DATA", "QUANTIDADE", "MOEDA", "CUSTOTOTAL"}
	self:aFieldsParte	:= {"REVISAO", "PARTE", "TOTPARTE"}

	self:addProperty( "FILIAL"		, STR0006, "string", STR0006, "FILIAL")		//"Filial"
	self:addProperty( "ORDEMPROD"	, STR0007, "string", STR0007, "ORDEMPROD")	//"Ordem de Produção"
	self:addProperty( "PRODUTO"		, STR0008, "string", STR0008, "PRODUTO")	//"Produto"
	self:addProperty( "DESCRICAO"	, STR0009, "string", STR0009, "DESCRICAO")	//"Descrição"
	self:addProperty( "LOCALPROD"	, STR0010, "string", STR0010, "LOCALPROD")	//"Local"
	self:addProperty( "DATA"		, STR0011, "date"  , STR0011, "DATA")		//"Data"
	self:addProperty( "QUANTIDADE"	, STR0012, "number", STR0012, "QUANTIDADE")	//"Quantidade"
	self:addProperty( "MOEDA"		, STR0013, "string", STR0013, "MOEDA")		//"Moeda"
	self:addProperty( "CUSTOTOTAL"	, STR0014, "number", STR0014, "CUSTOTOTAL")	//"Custo Total"
	self:addProperty( "REVISAO"		, STR0015, "string", STR0015, "REVISAO")	//"Revisão"
	self:addProperty( "PARTE"		, STR0016, "string", STR0016, "PARTE")		//"Parte"
	self:addProperty( "TOTPARTE"	, STR0017, "number", STR0017, "TOTPARTE") 	//"Custo Total Parte"

Return
