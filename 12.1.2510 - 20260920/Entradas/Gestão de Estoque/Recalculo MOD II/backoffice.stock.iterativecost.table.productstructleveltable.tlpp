#Include 'Totvs.ch'
#Include 'tlpp-core.th'

Using namespace totvs.protheus.backoffice.stock.iterativecost.table.manager
Using namespace totvs.protheus.backoffice.stock.iterativecost.table.balancebywarehouse
Using Namespace totvs.protheus.backoffice.stock.iterativecost.table.aglutinattedmovementtable
namespace totvs.protheus.backoffice.stock.iterativecost.table.productstructleveltable

/*/{Protheus.doc} ProductStructLevelTable
    Classe responsável por retornar a estrutura da tabela de estrutura e níveis de produto (TRH)
    @author Squad Entradas
    @since 05/09/2024
/*/
Class ProductStructLevelTable From TableManager

    Public Method New() 

    Static Method TableFields()
    Static Method TableIndexes()
    Static Method TableName()

    Public Method InsertSQL()
    Public Method StructQuery()
    Public Method NotStrQuery()
    Public Method CalcNivel()
    Public Method Nivel()
    Public Method LoopNivel()
    Public Method LoopGrupo()
    Public Method LoopProd()

    Public Data   oStrQry As Object
    Public Data   oNonStrQry As Object
    Public Data   oLoopNiv   As Object
    Public Data   oLoopGrp   As Object
    Public Data   oLoopPrd   As Object
    Public Data   cCusFil    As Character
    Public Data   lIntMNT    As Logical
    Public Data   lD3Servico As Logical

EndClass

/*/{Protheus.doc} New
    Instância da classe
    @author Squad Entradas
    @since 05/09/2024
/*/
Method New(aFil) Class ProductStructLevelTable
    ::oStrQry    := Nil
    ::oNonStrQry := Nil
    ::oLoopNiv   := Nil
    ::cCusFil    := SuperGetMv("MV_CUSFIL", .F., "A")
    ::lIntMNT    := .F.
    ::lD3Servico := .F.
	
    If ::cCusFil == 'E'
        _Super:New(aFil, 'E', 'C', 'C' )
    Else
        _Super:New(aFil, 'E', 'E', 'E')
    EndIf
	
    ::TableManager(::TableName(),::TableFields(),::TableIndexes())
Return Self

/*/{Protheus.doc} TableFields
    Campos da tabela
    @author Squad Entradas
    @since 05/09/2024
/*/
Method TableFields() Class ProductStructLevelTable
    Local aFields   := {} as array

    aAdd(aFields, {"FILPROC",   "C" , TamSX3('G1_FILIAL')[1],  0})
    aAdd(aFields, {"FILIAL",    "C" , TamSX3('G1_FILIAL')[1], 0})
    aAdd(aFields, {"COD",       "C" , TamSX3('D1_COD')[1],    0})
    aAdd(aFields, {"COMP",      "C" , TamSX3('D1_COD')[1],    0})
    aAdd(aFields, {"NIVEL",     "C" , 2, 0})
    aAdd(aFields, {"NIVINV",    "C" , 2, 0})
    aAdd(aFields, {"GRUPO",     "N" , 8, 0})
    
Return aFields

/*/{Protheus.doc} TableIndexes
    Índices da tabela de movimentação analítica
    @author Squad Entradas
    @since 05/09/2024
/*/
Method TableIndexes() Class ProductStructLevelTable
    Local aIndex := {} as array

    aAdd(aIndex, {ProductStructLevelTable():TableName()+'_01', 'FILPROC+FILIAL+COD+COMP'})
    aAdd(aIndex, {ProductStructLevelTable():TableName()+'_02', 'FILPROC+FILIAL+COMP+COD'})
    aAdd(aIndex, {ProductStructLevelTable():TableName()+'_03', 'FILPROC+FILIAL+NIVINV+GRUPO+COD'})

Return aIndex

/*/{Protheus.doc} TableName
    Retorna o nome da tabela de movimentação analítica
    @author Squad Entradas
    @since 05/09/2024
/*/
Method TableName() Class ProductStructLevelTable
    Local cAlias as character

    cAlias := "TSG1"+cEmpAnt+"SP"

Return cAlias

/*/{Protheus.doc} StructQuery
    Retorna a query da tabela
    @author Squad Entradas
    @since 05/09/2024
    @cFilProc - Filial onde iniciou a execução
    @dDtIni - Data inicial de processamento
    @dDtFim - Data final de processamento
    @cFilAtu - Filial atual
/*/
Method StructQuery(cFilProc,cFilAtu,dDtIni,dDtFim) Class ProductStructLevelTable
    Local cQuery       As Character
    Local aCampos      As Array
    Local cCampos      As Character
    Local nI           As Integer
    Local cTC2_NUM     As Character
    Local cTC2_ITEM    As Character
    Local cTC2_SEQUEN  As Character
    Local cTC2_ITEMGRD As Character
    Local cPC2_NUM     As Character
    Local cPC2_ITEM    As Character
    Local cPC2_SEQUEN  As Character
    Local cPC2_ITEMGRD As Character
    Local nTC2_OP      As Integer
    Local lD3Servico := !SuperGetMv("MV_WMSNEW",.F.,.F.) .And. SuperGetMV( 'MV_D3SERVI' ,.F., 'N' )== 'S'
    Local lIntMNT      As Logical
    Local cProdMNT     As Character
    Local aBind        As Array

    Default cFilAtu := cFilAnt

    //Inicializa as variáveis
    cTC2_NUM     := cValToChar(TamSx3('C2_NUM')[1])    
    cTC2_ITEM    := cValToChar(TamSx3('C2_ITEM')[1])    
    cTC2_SEQUEN  := cValToChar(TamSx3('C2_SEQUEN')[1])  
    cTC2_ITEMGRD := cValToChar(TamSx3('C2_ITEMGRD')[1]) 
    cPC2_NUM     := '1'
    cPC2_ITEM    := cValToChar(TamSx3('C2_NUM')[1]+1)    
    cPC2_SEQUEN  := cValToChar(TamSx3('C2_NUM')[1]+TamSx3('C2_ITEM')[1]+1)  
    cPC2_ITEMGRD := cValToChar(TamSx3('C2_NUM')[1]+TamSx3('C2_ITEM')[1]+TamSx3('C2_SEQUEN')[1]+1)  
    nTC2_OP      := TamSx3('C2_OP')[1]

    cLocCQ    := GetMvNNR('MV_CQ','98')
    cProdMNT  := PadR(SuperGetMv("MV_PRODMNT",.F.,"MANUTENCAO"), TamSX3("B1_COD")[1])

    SB1->(DbSetOrder(1))
    lIntMNT := SB1->(DbSeek(FWXFilial('SB1', cFilAtu)+cProdMNT))
    
    cCampos   := " "
    aCampos   := ::TableFields()
    For nI := 1 To Len(aCampos)
        cCampos += aCampos[nI, 1]
        If nI != Len(aCampos)
            cCampos += ", "
        EndIf
    Next nI

    If ::oStrQry == Nil .Or. lIntMNT <> ::lIntMNT .Or. lD3Servico <> ::lD3Servico
        ::lIntMNT    := lIntMNT
        ::lD3Servico := lD3Servico
        cQuery := " Select "
        If ::lPostgres
            cQuery += " Char("+cValToChar(FWSizeFilial())+") "
        EndIf
        cQuery += " '"+cFilProc+"' FILPROC,"
        If ::cCusFil == 'E'
	        If ::lPostgres
	            cQuery += " Char("+cValToChar(FWSizeFilial())+") "
	        EndIf
            cQuery += " '"+PadR(FWCompany(), FWSizeFilial())+"' FILIAL, "
        Else
            cQuery += " SD3.D3_FILIAL FILIAL,"
        EndIf
        cQuery += " SC2.C2_PRODUTO COD, "
        cQuery += " SD3.D3_COD COMP, "
        If ::lPostgres
            cQuery += " Char(2) "
        EndIf
        cQuery += " '01' NIVEL, "
        If ::lPostgres
            cQuery += " Char(2) "
        EndIf
        cQuery += " '99' NIVINV, "
        cQuery += " 0 GRUPO "
        cQuery += " From " +RetSQLName("SD3") +" SD3 "
        cQuery += " Join " +RetSQLName("SC2") +" SC2 "
        cQuery += " On  SC2.C2_FILIAL  = ? "
        cQuery += " And SC2.C2_NUM     = SubString(SD3.D3_OP, "+cPC2_NUM+",     "+cTC2_NUM+") "
        cQuery += " And SC2.C2_ITEM    = SubString(SD3.D3_OP, "+cPC2_ITEM+",    "+cTC2_ITEM+") "
        cQuery += " And SC2.C2_SEQUEN  = SubString(SD3.D3_OP, "+cPC2_SEQUEN+",  "+cTC2_SEQUEN+") "
        cQuery += " And SC2.C2_ITEMGRD = SubString(SD3.D3_OP, "+cPC2_ITEMGRD+", "+cTC2_ITEMGRD+") "
        //cQuery += " And SC2.C2_PRODUTO <> SD3.D3_COD "
        cQuery += " And SC2.D_E_L_E_T_ = ? "
        cQuery += " Left Outer Join "+::TableName()+" TSG1 On "
        cQuery += " TSG1.FILPROC = ? And "
        If ::cCusFil == 'E'
            cQuery += " TSG1.FILIAL  = ? And "
        Else
            cQuery += " TSG1.FILIAL  = SD3.D3_FILIAL  And "
        EndIf
        cQuery += " TSG1.COD     = SC2.C2_PRODUTO And " //Não deve repetir o par pai-filho
        cQuery += " TSG1.COMP    = SD3.D3_COD "
        cQuery += " Where "
        cQuery += " SD3.D3_FILIAL = ? "
        cQuery += " And SD3.D3_OP <> ? "
        cQuery += " And SubString(SD3.D3_CF,2,1) = ? "
        cQuery += " And SD3.D3_EMISSAO  >= ? "
        cQuery += " And SD3.D3_EMISSAO  <= ? "
        cQuery += " And SD3.D3_ESTORNO = ? "
        If lIntMNT
            cQuery += " AND SD3.D3_COD <> ? "
        EndIf 
        If !lD3Servico
            cQuery += " And (D3_SERVIC = ? OR D3_TM <= ? OR D3_LOCAL = ?) "
        EndIf
        cQuery += " And SD3.D_E_L_E_T_ = ? "
        cQuery += " And TSG1.COD Is Null "
        cQuery += " Group By "
        If ::cCusFil != 'E'
            cQuery += " SD3.D3_FILIAL,"
        EndIf
        cQuery += " SD3.D3_COD, "
        cQuery += " SC2.C2_PRODUTO "
        
        cQuery := ChangeQuery(cQuery)

        ::oStrQry := FWExecStatement():New(cQuery)
    EndIf

    aBind := {}
    AAdd(aBind, FWxFilial("SC2", cFilAtu)) //C2_FILIAL
    AAdd(aBind, ' ') //SC2.D_E_L_E_T_
    AAdd(aBind, cFilProc) //TSG1.FILPROC
    If ::cCusFil == 'E'
        AAdd(aBind, PadR(FWCompany(), FWSizeFilial())) //TSG1.FILIAL
    EndIf
    AAdd(aBind, FWxFilial("SD3", cFilAtu)) //D3_FILIAL
    AAdd(aBind, Space(nTC2_OP)) //D3_OP
    AAdd(aBind, 'E') //D3_CF
    AAdd(aBind, DToS(dDtIni)) //D3_EMISSAO
    AAdd(aBind, DToS(dDtFim)) //D3_EMISSAO
    AAdd(aBind, ' ') //D3_ESTORNO
    If lIntMNT
        AAdd(aBind, cProdMNT) //D3_COD
    EndIf
    If !lD3Servico
        AAdd(aBind, ' ') //D3_SERVIC
        AAdd(aBind, '500') //D3_TM
        AAdd(aBind, cLocCQ) //D3_LOCAL
    EndIf
    AAdd(aBind, ' ') //SD3.D_E_L_E_T_ 

    For nI := 1 To Len(aBind)
        ::oStrQry:SetString(nI, aBind[nI])
    Next nI

    cQuery := ::oStrQry:GetFixQuery()

    //Montagem da query com CTE (Commom Table Expression)
    cQuery := ::FormatCTE(cCampos, cQuery)

    FWFreeArray(aBind)
Return cQuery

/*/{Protheus.doc} NotStrQuery
    Prepara a query dos outros produtos que não tem componentes na estrutura
    @author Squad Entradas
    @since 19/09/2024
    /*/
Method NotStrQuery(cFilProc,cFilAtu,dDtIni,dDtFim) Class ProductStructLevelTable
    Local cQuery  := ""
    Local cCampos := ""
    Local aCampos := {}
    Local aBind   := {}
    Local nI      := 0

    cCampos   := " "
    aCampos   := ::TableFields()
    For nI := 1 To Len(aCampos)
        cCampos += aCampos[nI, 1]
        If nI != Len(aCampos)
            cCampos += ", "
        EndIf
    Next nI

    If ::oNonStrQry == Nil
        cQuery := " Select "
        If ::lPostgres
            cQuery += " Char("+cValToChar(FWSizeFilial())+") "
        EndIf
        cQuery += " '"+cFilProc+"' FILPROC, "
        If ::cCusFil == 'E'
            If ::lPostgres
                cQuery += " Char("+cValToChar(FWSizeFilial())+") "
            EndIf
            cQuery += " '"+PadR(FWCompany(), FWSizeFilial())+"' FILIAL, "
        Else
            cQuery += " TRK.FILIAL FILIAL,"
        EndIf
        cQuery += " TRK.COD, "
        If ::lPostgres
            cQuery += " Char("+cValToChar(Len(SB1->B1_COD))+") "
        EndIf
        cQuery += " '"+Space(Len(SB1->B1_COD))+"' COMP, "
        If ::lPostgres
            cQuery += " Char(2) "
        EndIf
        cQuery += " '01' NIVEL, "
        If ::lPostgres
            cQuery += " Char(2) "
        EndIf
        cQuery += " '99' NIVINV, "
        cQuery += " 0 GRUPO "
        cQuery += " From "+BalanceByWarehouse():TableName()+" TRK "
        cQuery += " Left Outer Join "+::TableName()+" TSG1 On "
        cQuery += " TSG1.FILPROC = TRK.FILPROC And "
        cQuery += " TSG1.FILIAL  = TRK.FILIAL  And "
        cQuery += " TSG1.COD     = TRK.COD  "
        cQuery += " Where "
        cQuery += " TRK.FILPROC = ? And "
        cQuery += " TRK.FILIAL  = ? And "
        cQuery += " TSG1.COD Is Null "
        cQuery += " Group By "
        cQuery += " TRK.FILPROC, TRK.FILIAL, TRK.COD "

        cQuery := ChangeQuery(cQuery)

        ::oNonStrQry := FWExecStatement():New(cQuery)
    EndIf

    AAdd(aBind, cFilProc)
    AAdd(aBind, cFilAtu)

    For nI := 1 To Len(aBind)
        ::oNonStrQry:SetString(nI, aBind[nI])
    Next nI

    cQuery := ::oNonStrQry:GetFixQuery()

    cQuery := ::FormatCTE(cCampos, cQuery)

    FWFreeArray(aBind)
Return cQuery

/*/{Protheus.doc} InsertSQL
    Faz a inserção dos dados
    @author Squad Entradas
    @since 05/09/2024
    @cFilProc - Filial onde iniciou a execução
    @dDtIni - Data inicial de processamento
    @dDtFim - Data final de processamento
/*/
Method insertSQL(cFilProc, dDtIni, dDtFim) Class ProductStructLevelTable
    Local nFil       := 0

    For nFil := 1 To Len(::aFilProc)
        cQuery := ::StructQuery(cFilProc, ::aFilProc[nFil, 1], dDtIni, dDtFim)
        ::RunQuery(cQuery)

        cQuery := ::NotStrQuery(cFilProc, ::aFilProc[nFil, 1], dDtIni, dDtFim)
        ::RunQuery(cQuery)

        If ::cCusFil != 'E'
        	::CalcNivel(cFilProc, ::aFilProc[nFil, 1])
        EndIf
    Next nFil
    If ::cCusFil == 'E'
        ::CalcNivel(cFilProc, ::aFilProc[1, 2])
    EndIf
Return

/*/{Protheus.doc} CalcNivel
    Método responsável pelo cálculo dos níveis de estrutura
    @author Squad Entradas
    @since 05/09/2024
    /*/

Method CalcNivel(cFilProc As Character, cFilAtu As Character) Class ProductStructLevelTable
    Local lRet    As Logical
    Local cAlSG1  As Character

    lRet := .T.
    cAlSG1 := ::TableName()
    ::UseArea(cAlSG1, ::TableIndexes())

    (cAlSG1)->(DbSetOrder(1)) //FILPROC+FILIAL+COD+COMP
    If (cAlSG1)->(DbSeek(cFilProc+cFilAtu))
        While !(cAlSG1)->(EoF()) .And. (cAlSG1)->(FILPROC+FILIAL) == cFilProc+cFilAtu
            If (cAlSG1)->NIVEL == '01'
                ::Nivel(cFilProc, cFilAtu, (cAlSG1)->COMP, (cAlSG1)->NIVEL)
            EndIf
            (cAlSG1)->(DbSkip())
        EndDo
    EndIf
Return lRet

/*/{Protheus.doc} Nivel
    Chamada em recursividade do cálculo de níveis
    @author user
    @since 06/09/2024
    /*/
Method Nivel(cFilProc As Character, cFilAtu As Character, cComp As Character, cNivel As Character) Class ProductStructLevelTable
    Local lRet    As Logical
    Local cAlSG1  As Character
    Local nRec    As Integer
    Local nIndex  As Integer

    lRet   := .T.
    cAlSG1 := ::TableName()
    nRec   := (cAlSG1)->(Recno())
    nIndex := (cAlSG1)->(IndexOrd())

    If (cAlSG1)->(DbSeek(cFilProc+cFilAtu+cComp))
        While !(cAlSG1)->(EoF()) .And. (cAlSG1)->(FILPROC+FILIAL+COD) == cFilProc+cFilAtu+cComp
            If Val(cNivel) >= 98
                lRet := .F.
            EndIf

            If lRet .And. Val(cNivel)+1 > Val((cAlSG1)->NIVEL)
                If RecLock(cAlSG1, .F.)
                    (cAlSG1)->NIVEL  := Strzero(Val(cNivel)+1, 2)
                    (cAlSG1)->NIVINV := Strzero(100-Val((cAlSG1)->NIVEL),2,0)
                    (cAlSG1)->(MsUnLock())

                    lRet := ::Nivel(cFilProc, cFilAtu, (cAlSG1)->COMP, (cAlSG1)->NIVEL)
                EndIf
            EndIf

            If !lRet 
                Exit
            EndIf
            (cAlSG1)->(DbSkip())
        EndDo
    EndIf

    (cAlSG1)->(DbGoto(nRec))
    (cAlSG1)->(DbSetOrder(nIndex))
Return lRet

/*/{Protheus.doc} LoopNivel
    Abre o alias usado no loop principal.
    O Alias deve ser fechado manualmente após o uso
    @author user
    @since 27/11/2024

    /*/
Method LoopNivel(cFilProc, cFilAtu) Class ProductStructLevelTable
    Local cQuery := ""
    Local cAlTmp := ""

    If ::oLoopNiv == Nil
        cQuery := " Select "
        cQuery += " NIV.FILPROC, "
        cQuery += " NIV.FILIAL, "
        cQuery += " NIV.NIVEL, "
        cQuery += " NIV.NIVINV "
        cQuery += " From "+::TableName()+" NIV "
        cQuery += " Inner Join "+AgglutinatedMovementTable():TableName()+" AGL "
        cQuery += " On "
        cQuery += " AGL.FILPROC = NIV.FILPROC And "
        cQuery += " AGL.FILIAL  = NIV.FILIAL  And "
        cQuery += " AGL.COD     = NIV.COD "
    	cQuery += " Where "
        cQuery += " NIV.FILPROC = ? And "
        cQuery += " NIV.FILIAL  = ? "
    	cQuery += " Group By " 
        cQuery += " NIV.FILPROC, "
        cQuery += " NIV.FILIAL, "
        cQuery += " NIV.NIVEL, "
        cQuery += " NIV.NIVINV "
    	cQuery += " Order By "
        cQuery += " NIV.FILPROC, "
        cQuery += " NIV.FILIAL, "
        cQuery += " NIV.NIVINV "

    	cQuery := ChangeQuery(cQuery)

        ::oLoopNiv := FWExecStatement():New(cQuery)
    EndIf
    ::oLoopNiv:SetString(1, cFilProc)
    ::oLoopNiv:SetString(2, cFilAtu)

    cAlTmp := ::oLoopNiv:OpenAlias()

Return cAlTmp

/*/{Protheus.doc} LoopGrp
    Abre o alias usado no loop principal.
    O Alias deve ser fechado manualmente após o uso
    @author user
    @since 27/11/2024

    /*/
Method LoopGrupo(cFilProc, cFilAtu, cNivel) Class ProductStructLevelTable
    Local cQuery := ""
    Local cAlTmp := ""

    If ::oLoopGrp == Nil
        cQuery := " Select NIV.GRUPO "
        cQuery += " From "+ProductStructLevelTable():TableName()+" NIV "
        cQuery += " Inner Join "+AgglutinatedMovementTable():TableName()+" AGL "
        cQuery += " On "
        cQuery += " AGL.FILPROC = NIV.FILPROC And "
        cQuery += " AGL.FILIAL  = NIV.FILIAL  And "
        cQuery += " AGL.COD     = NIV.COD "
        cQuery += " Where "
        cQuery += " NIV.FILPROC = ? And "
        cQuery += " NIV.FILIAL  = ? And "
        cQuery += " NIV.NIVINV  = ? "
        cQuery += " Group By "
        cQuery += " NIV.GRUPO "
        cQuery += " Order By "
        cQuery += " NIV.GRUPO "
        cQuery := ChangeQuery(cQuery)

        ::oLoopGrp := FWExecStatement():New(cQuery)
    EndIf

    ::oLoopGrp:SetString(1, cFilProc)
    ::oLoopGrp:SetString(2, cFilAtu)
    ::oLoopGrp:SetString(3, cNivel)

    cAlTmp := ::oLoopGrp:OpenAlias()

Return cAlTmp

/*/{Protheus.doc} LoopProd
    Abre o alias usado no loop principal.
    O Alias deve ser fechado manualmente após o uso
    @author user
    @since 27/11/2024

    /*/
Method LoopProd(cFilProc, cFilAtu, cNivel, nGrupo) Class ProductStructLevelTable
    Local cQuery := ""
    Local cAlTmp := ""

    If ::oLoopPrd == Nil
        cQuery := " Select count(1) NREC, COD FROM "
        cQuery += " ( Select "
        cQuery += " NIV.COD "
        cQuery += " From "+ProductStructLevelTable():TableName()+" NIV "
        cQuery += " Inner Join "+AgglutinatedMovementTable():TableName()+" AGL "
        cQuery += " On "
        cQuery += " AGL.FILPROC = NIV.FILPROC And "
        cQuery += " AGL.FILIAL  = NIV.FILIAL  And "
        cQuery += " AGL.COD     = NIV.COD "
        cQuery += " Where "
        cQuery += " NIV.FILPROC = ? And "
        cQuery += " NIV.FILIAL  = ? And "
        cQuery += " NIV.NIVINV  = ? And "
        cQuery += " NIV.GRUPO   = ? "
        cQuery += " Group By "
        cQuery += " NIV.COD ) LOOPPROD "
        cQuery += " Group By COD "
        cQuery += " Order By COD"
        cQuery := ChangeQuery(cQuery)

        ::oLoopPrd := FWExecStatement():New(cQuery)
    EndIf

    ::oLoopPrd:SetString(1, cFilProc)
    ::oLoopPrd:SetString(2, cFilAtu)
    ::oLoopPrd:SetString(3, cNivel)    
    ::oLoopPrd:SetNumeric(4, nGrupo)

    cAlTmp := ::oLoopPrd:OpenAlias()

Return cAlTmp
