#include 'Totvs.ch'
#include "tlpp-core.th"

using namespace totvs.protheus.backoffice.stock.iterativecost.table.manager
using namespace totvs.protheus.backoffice.stock.iterativecost.table.parts.analyticalmovementtable
using namespace totvs.protheus.backoffice.stock.iterativecost.table.balancebyproductionorder
using namespace totvs.protheus.backoffice.stock.iterativecost.table.analyticalmovementtable
using namespace totvs.protheus.backoffice.stock.iterativecost.table.parts.processingtable

namespace totvs.protheus.backoffice.stock.iterativecost.table.parts.balancebyproductionorderparts

/*/{Protheus.doc} BalanceByProductionOrderParts
    Classe responsável por retornar o saldo das ordens de produções em partes (TRMCP)
    @author Squad Entradas
    @since 23/10/2024
/*/
Class BalanceByProductionOrderParts From TableManager

    public method New()
    public method initializeBalancesFromPreviousPeriod()
    public method initializeBalancesFromMovements()
    public method openingBalancesToFinal()
    public method updateOPBalancePerProcessingLevel()
    public Method tableManager()

    static method tableFields()
    static method tableIndexes()
    static method tableName()

    public data oinitializeBalancesFromPreviousPeriod   as object
    public data oinitializeBalancesFromMovements        as object
    public data oUpdateOPPerProcessingLevel             as object
    public data oOpeningBalancesToFinal                 as object
    public data cFProc                                  as character
    public data oPartsReqCost                as object

    Public Data jParams       As Json
    Public Data cCusFil       As Character
    Public Data cTabMovAnl    As character
    Public Data cTabMovAnlCP  As character
    Public Data cTabProcCP    As character
    Public Data cTabOP        As character

endclass

/*/{Protheus.doc} New
    Instância da classe
    @author Squad Entradas
    @since 23/10/2024
/*/
Method new(aFil, cFProc, jParams, oPartsReqCost) Class BalanceByProductionOrderParts

    ::cFProc := cFProc
    ::oPartsReqCost := oPartsReqCost
    ::cTabMovAnl    := AnalyticalMovementTable():TableName()
    ::cTabMovAnlCP  := AnalyticalMovementPartsTable():TableName()
    ::cTabProcCP    := PartsProcessingTable():TableName()
    ::cTabOP        := BalanceByProductionOrder():TableName()
    ::jParams       := jParams
    ::cCusFil       := jParams["MV_CUSFIL"]

    _Super:New(aFil)

Return

/*/{Protheus.doc} tableManager
    Método responsável por criar/alterar a tabela
    @author Squad Entradas
    @since 23/10/2024
/*/
Method tableManager() Class BalanceByProductionOrderParts

    _Super:TableManager(::TableName(),::TableFields(),::TableIndexes())

Return

/*/{Protheus.doc} TableFields
    Campos da tabela de saldos por ordem de produção
    @author Squad Entradas
    @since 23/10/2024
/*/
Method tableFields() Class BalanceByProductionOrderParts
    Local aFields := {} as array
    Local nTamRec := 10 as numeric

    aAdd(aFields, {"RECPAI",    "N" , nTamRec,  0})
    aAdd(aFields, {"FILPROC",   "C" , TamSX3('B2_FILIAL')[1], 0})
    aAdd(aFields, {"FILIAL",    "C" , TamSX3('B2_FILIAL')[1], 0})
    aAdd(aFields, {"COD",       "C" , TamSX3('B2_COD')[1]   , 0})
    aAdd(aFields, {"OP",        "C" , TamSX3('D3_OP')[1]    , 0})
    aAdd(aFields, {"PARTE",     "C" , TamSX3('D4J_PARTE')[1]    , 0})
    aAdd(aFields, {"MOEDA",     "C" , TamSX3('D4I_MOEDA')[1]    , 0})
    aAdd(aFields, {"APRINI",    "N" , TamSX3('D4J_APRINI')[1], TamSX3('D4J_APRINI')[2]})
    aAdd(aFields, {"APRFIN",    "N" , TamSX3('D4J_APRFIN')[1], TamSX3('D4J_APRFIN')[2]})
    aAdd(aFields, {"TOTINI",    "N" , TamSX3('D4J_TOTINI')[1], TamSX3('D4J_TOTINI')[2]})
    aAdd(aFields, {"TOTFIN",    "N" , TamSX3('D4J_TOTFIN')[1], TamSX3('D4J_TOTFIN')[2]})

Return aFields

/*/{Protheus.doc} TableIndexes
    Índices da tabela de saldos por ordem de produção
    @author Squad Entradas
    @since 23/10/2024
/*/
Method tableIndexes() Class BalanceByProductionOrderParts
    Local aIndex := {}

    aAdd(aIndex, {BalanceByProductionOrderParts():TableName()+'_01', 'FILPROC+FILIAL+OP'})
    aAdd(aIndex, {BalanceByProductionOrderParts():TableName()+'_02', 'FILPROC+FILIAL+COD'})
    aAdd(aIndex, {BalanceByProductionOrderParts():TableName()+'_03', 'FILPROC+OP'})

Return aIndex

/*/{Protheus.doc} TableName
    Retorna o nome da tabela de saldos por ordem de produção
    @author Squad Entradas
    @since 23/10/2024
/*/
Method tableName() Class BalanceByProductionOrderParts
    Local cAlias as character

    cAlias := "TRMCP"+cEmpAnt+"SP"

Return cAlias

/*/{Protheus.doc} initializeBalancesFromPreviousPeriod
    Inicializa o custo em partes das ordens de produção
    @author Squad Entradas
    @since 07/04/2025
/*/
Method initializeBalancesFromPreviousPeriod(aFiliais,dDtIni,dDtFim) Class BalanceByProductionOrderParts
    local cCampos       as character
    local cQuery        as character
    Local nX            as integer

    cCampos := "RECPAI,FILPROC,FILIAL,COD,OP,PARTE,MOEDA,APRINI,TOTINI"

    //Grava na TRMCP a OP's com base nos saldos da D4O
    For nX := 1 to Len(aFiliais)
        cFilAtu := aFiliais[nX]
        If ::oInitializeBalancesFromPreviousPeriod == Nil
            cQuery := " SELECT MAX(TRM.R_E_C_N_O_) RECPAI,TRG.FILPROC FILPROC,TRG.FILIAL FILIAL,TRM.COD COD,"
            cQuery += " TRG.OP OP, "
            cQuery += " MAX(D4O.D4O_PARTE) PARTE, "
            cQuery += " MAX(D4O.D4O_MOEDA) MOEDA, "
            cQuery += " MAX(D4O.D4O_APRINI) APRINI,"
            cQuery += "	MAX(D4O.D4O_SLDINI) TOTINI "
            cQuery += " FROM " +::cTabMovAnl+ " TRG "
            cQuery += " INNER JOIN " + ::cTabOP + " TRM ON "
            cQuery += " TRM.FILIAL = TRG.FILIAL AND "
            cQuery += " TRM.FILPROC = TRG.FILPROC AND "
            cQuery += " TRM.OP = TRG.OP "
            cQuery += " INNER JOIN "+ RetSQLName('D4O') +" D4O ON "
            cQuery += " D4O.D4O_FILIAL = TRG.FILIAL AND "
            cQuery += " D4O.D4O_OP = TRG.OP AND "
            cQuery += " D4O.D4O_DATA = ? AND "
            cQuery += " D4O.D_E_L_E_T_ = ? "
            cQuery += " INNER JOIN "+RetSqlName("SC2")+" SC2 ON "
            cQuery += " SC2.C2_FILIAL = D4O.D4O_FILIAL AND "
            cQuery += " SC2.C2_NUM = D4O.D4O_NUM AND "
            cQuery += " SC2.C2_SEQUEN = D4O.D4O_SEQUEN AND "
            cQuery += " SC2.C2_ITEM = D4O.D4O_ITEM AND "
            cQuery += " SC2.C2_ITEMGRD = D4O.D4O_ITEMGR AND "
            cQuery += " (SC2.C2_DATRF = ? OR SC2.C2_DATRF <= ?) AND "
            cQuery += " SC2.D_E_L_E_T_ = ? "
            cQuery += " WHERE TRG.FILPROC = ? AND "
            cQuery += " TRG.FILIAL = ? AND "
            cQuery += " TRG.OP <> ? "
            cQuery += " GROUP BY TRG.FILPROC,TRG.FILIAL,TRM.COD, "
            cQuery += " D4O.D4O_PARTE,D4O.D4O_MOEDA,TRG.OP"

            cQuery := ChangeQuery(cQuery)

            ::oInitializeBalancesFromPreviousPeriod := FWExecStatement():New(cQuery)
        EndIf

        ::oInitializeBalancesFromPreviousPeriod:SetString(1,dToS(dDtIni))
        ::oInitializeBalancesFromPreviousPeriod:SetString(2,' ')
        ::oInitializeBalancesFromPreviousPeriod:SetString(3,' ')
        ::oInitializeBalancesFromPreviousPeriod:SetString(4,dToS(dDtFim))
        ::oInitializeBalancesFromPreviousPeriod:SetString(5,' ')
        ::oInitializeBalancesFromPreviousPeriod:SetString(6,::cFProc)
        ::oInitializeBalancesFromPreviousPeriod:SetString(7,cFilAtu)
        ::oInitializeBalancesFromPreviousPeriod:SetString(8,' ')

        //Retorna a query com a substituição dos binds
        cQuery := ::oInitializeBalancesFromPreviousPeriod:GetFixQuery()
        
        //Formata a query com CTE de Insert
        cQuery := ::FormatCTE(cCampos,cQuery)

        //Executa o CTE
        ::RunQuery(cQuery)
    Next nX

Return

/*/{Protheus.doc} initializeBalancesFromMovements
    Inicializa o custo em partes das ordens de produção
    @author Squad Entradas
    @since 07/04/2025
/*/
Method initializeBalancesFromMovements(aFiliais, cNivInv) Class BalanceByProductionOrderParts
    local cQuery        as character
    local aMatch        := {} as array
    local aCpoDest      := {} as array
    local aInsert       := {} as array
    local cFilAtu       as character
    local cMerge        as character
    local nX            as integer

    //Filtro
    AAdd(aMatch, {"RECPAI" , "RECPAI"})
    AAdd(aMatch, {"FILPROC", "FILPROC"})
    AAdd(aMatch, {"FILIAL" , "FILIAL"})
    AAdd(aMatch, {"COD"    , "COD"})
    AAdd(aMatch, {"OP"     , "OP"})
    AAdd(aMatch, {"PARTE"  , "PARTE"})
    AAdd(aMatch, {"MOEDA"  , "MOEDA"})

    //Expressões de insert
    AAdd(aCpoDest, "RECPAI")
    AAdd(aCpoDest, "FILPROC")
    AAdd(aCpoDest, "FILIAL")
    AAdd(aCpoDest, "COD")
    AAdd(aCpoDest, "OP")
    AAdd(aCpoDest, "PARTE")
    AAdd(aCpoDest, "MOEDA")

    AAdd(aInsert, "Origem.RECPAI")
    AAdd(aInsert, "Origem.FILPROC")
    AAdd(aInsert, "Origem.FILIAL")
    AAdd(aInsert, "Origem.COD")
    AAdd(aInsert, "Origem.OP")
    AAdd(aInsert, "Origem.PARTE")
    AAdd(aInsert, "Origem.MOEDA")

    //Grava na TRMCP a OP's com movimentações no período
    For nX := 1 to Len(aFiliais)
        cFilAtu := aFiliais[nX]
        If ::oInitializeBalancesFromMovements == Nil
            cQuery := " SELECT TRM.R_E_C_N_O_ RECPAI,TRG.FILPROC FILPROC,TRG.FILIAL FILIAL, "
            cQuery += " TRM.COD COD,TRG.OP OP,TRGCP.CODPAR PARTE, "
            cQuery += " TRGCP.MOEDA MOEDA,0 APRINI,0 TOTINI "
        cQuery += " FROM " +::cTabMovAnl+ " TRG "
        cQuery += " INNER JOIN " + ::cTabMovAnlCP+ " TRGCP ON "
            cQuery += " TRGCP.FILPROC = TRG.FILPROC AND "
            cQuery += " TRGCP.FILIAL = TRG.FILIAL AND "
            cQuery += " TRGCP.RECPAI = TRG.R_E_C_N_O_ "
        cQuery += " INNER JOIN " + ::cTabOP + " TRM ON "
            cQuery += " TRM.FILIAL = TRG.FILIAL AND "
            cQuery += " TRM.FILPROC = TRG.FILPROC AND "
            cQuery += " TRM.OP = TRG.OP "
            cQuery += " WHERE TRG.FILPROC = ? AND "
            cQuery += " TRG.FILIAL = ? AND "
            cQuery += " TRG.OP <> ? "
            cQuery += " GROUP BY TRM.R_E_C_N_O_,TRG.FILPROC,TRG.FILIAL,TRM.COD,"
            cQuery += " TRG.OP,TRGCP.CODPAR,TRGCP.MOEDA "

            cQuery := ChangeQuery(cQuery)

            ::oInitializeBalancesFromMovements := FWExecStatement():New(cQuery)
        EndIf

        ::oInitializeBalancesFromMovements:SetString(1,::cFProc)
        ::oInitializeBalancesFromMovements:SetString(2,cFilAtu)
        ::oInitializeBalancesFromMovements:SetString(3,' ')

        //Retorna a query com a substituição dos binds
        cQuery := ::oInitializeBalancesFromMovements:GetFixQuery()

        //Executa o CTE
        cMerge := ::MergeStatement(::TableName(), cQuery, aMatch, , aCpoDest, aInsert)

        ::RunQuery(cMerge)
    Next nX

    FWFreeArray(aMatch)
    FWFreeArray(aCpoDest)
    FWFreeArray(aInsert)

Return

/*/{Protheus.doc} openingBalancesToFinal
    Transfere os saldos iniciais para os saldos finais a cada iteração
    @author Squad Entradas
    @since 07/04/2025
/*/
Method openingBalancesToFinal(cFilAtu) Class BalanceByProductionOrderParts
    local cQuery       as character
    local cFieldsUpd   as character
    local cMatchFilter as character
        
    If ::oOpeningBalancesToFinal == Nil
        cQuery := " SELECT TRMCP.APRINI APRINI, TRMCP.TOTINI TOTINI, TRMCP.R_E_C_N_O_ RECNO "
        cQuery += " FROM "+::TableName()+" TRMCP "
        cQuery += " WHERE TRMCP.FILPROC = ? "
        If ::cCusFil != 'E'
            cQuery += " And TRMCP.FILIAL = ? "
        EndIf

        cQuery := ChangeQuery(cQuery)

        ::oOpeningBalancesToFinal := FWExecStatement():New(cQuery)
    EndIf 

    ::oOpeningBalancesToFinal:SetString(1,::cFProc)
    If ::cCusFil != 'E'
    	::oOpeningBalancesToFinal:SetString(2,cFilAtu)
    EndIf

    cQuery := ::oOpeningBalancesToFinal:GetFixQuery()

    cFieldsUpd := " APRFIN = TEMPTABLE.APRINI, TOTFIN = TEMPTABLE.TOTINI "

    cMatchFilter := ::TableName()+".R_E_C_N_O_ = TEMPTABLE.RECNO "

    cQuery := ::buildCteStatement(::TableName(),cFieldsUpd,cMatchFilter,cQuery)

    ::RunQuery(cQuery)

Return

/*/{Protheus.doc} updateOPBalancePerProcessingLevel
    Inicializa o custo em partes das ordens de produção
    @author Squad Entradas
    @since 07/04/2025
/*/
Method updateOPBalancePerProcessingLevel(cFilAtu, cNivInv) Class BalanceByProductionOrderParts
    local cQuery        as character
    local cMerge        as character
    local cTableName    := ::TableName()
    local cFieldsUpd    as character
    local cMatchFilter  as character
    Local nBind         as integer
    local aMatch        := {} as array
    local aUpdate       := {} as array
    local aCpoDest      := {} as array
    local aInsert       := {} as array

    //Grava o custo Requisitado para a OP 
    ::oPartsReqCost:ProductionPartsRequestCost(cFilAtu, cNivInv)

    //Filtro
    ASize(aMatch, 0)
    aMatch := {}
    AAdd(aMatch, {"TRMCPREC", "R_E_C_N_O_"})

    //Expressões de update
    ASize(aUpdate, 0)
    aUpdate := {}
    AAdd(aUpdate, "TOTFIN = Destino.TOTFIN + Origem.CUSTO")

    //Expressões de insert
    AAdd(aCpoDest, "RECPAI")
    AAdd(aCpoDest, "FILPROC")
    AAdd(aCpoDest, "FILIAL")
    AAdd(aCpoDest, "COD")
    AAdd(aCpoDest, "OP")
    AAdd(aCpoDest, "PARTE")
    AAdd(aCpoDest, "MOEDA")
    AAdd(aCpoDest, "TOTFIN")

    AAdd(aInsert, "Origem.RECPAI")
    AAdd(aInsert, "Origem.FILPROC")
    AAdd(aInsert, "Origem.FILIAL")
    AAdd(aInsert, "Origem.COD")
    AAdd(aInsert, "Origem.OP")
    AAdd(aInsert, "Origem.PARTE")
    AAdd(aInsert, "Origem.MOEDA")
    AAdd(aInsert, "Origem.CUSTO")

    If ::oUpdateOPPerProcessingLevel == Nil
        cQuery := " Select "
        cQuery += " TRMCP.R_E_C_N_O_ TRMCPREC, "
        cQuery += " TRM.R_E_C_N_O_ RECPAI, "
        cQuery += " TRM.FILPROC FILPROC, "
        cQuery += " TRM.FILIAL FILIAL, "
        cQuery += " TRM.COD COD, "
        cQuery += " MOV.OP OP, "
        cQuery += " MOVCP.CODPAR PARTE, "
        cQuery += " MOVCP.MOEDA MOEDA, "
        cQuery += " Sum( "
        cQuery += " Case "
        cQuery += "    When MOV.CF In ('RE5', 'PR0', 'PR1') "
        cQuery += "       Then 0 "
        cQuery += "    When MOV.TM >  '500' And MOV.CUSTOMEDIO = 'N' "
        cQuery += "       Then MOVCP.CUSTO "
        cQuery += "    When MOV.TM <= '500' And MOV.CUSTOMEDIO = 'N' "
        cQuery += "       Then -MOVCP.CUSTO "
        cQuery += "    When MOV.TM >  '500' And MOV.CUSTOMEDIO = 'S' "
        cQuery += "       Then MOV.QUANT * PROCP.CMPROC "
        cQuery += "    When MOV.TM <= '500' And MOV.CUSTOMEDIO = 'S' "
        cQuery += "       Then -(MOV.QUANT * PROCP.CMPROC) "
        cQuery += "    Else 0 "
        cQuery += " End) CUSTO "
        cQuery += " FROM " +::cTabMovAnl+ " MOV "
        cQuery += " INNER JOIN " +::cTabMovAnlCP+" MOVCP ON "
        cQuery += " MOVCP.FILPROC = MOV.FILPROC AND "
        cQuery += " MOVCP.FILIAL  = MOV.FILIAL  AND "
        cQuery += " MOVCP.RECPAI  = MOV.R_E_C_N_O_  "
        cQuery += " Inner join "+::cTabProcCP+" PROCP On "
        cQuery += " PROCP.FILPROC = MOV.FILPROC "
        If ::cCusFil != 'E'
            cQuery += "And PROCP.FILIAL  = MOV.FILIAL "
        EndIf
        cQuery += " And PROCP.COD = MOV.COD "
        If ::cCusFil == 'A'
            cQuery += "And PROCP.ARMAZEM = MOV.LOCARM "
        EndIf
        cQuery += " And PROCP.MOEDA  = MOVCP.MOEDA "
        cQuery += " And PROCP.CODPAR = MOVCP.CODPAR "
        cQuery += " Left JOIN "+cTableName+" TRMCP ON "
        cQuery += " TRMCP.FILIAL  = MOV.FILIAL   AND "
        cQuery += " TRMCP.FILPROC = MOV.FILPROC  AND "
        cQuery += " TRMCP.OP      = MOV.OP       AND "
        cQuery += " TRMCP.PARTE   = MOVCP.CODPAR AND "
        cQuery += " TRMCP.MOEDA   = MOVCP.MOEDA "
        cQuery += " Inner Join "+::cTabOP+" TRM On "
        cQuery += " TRM.FILPROC    = MOV.FILPROC And "
        cQuery += " TRM.FILIAL     = MOV.FILIAL  And "
        cQuery += " TRM.OP         = MOV.OP "
        cQuery += " WHERE "
        cQuery += " MOV.FILPROC = ? And "
        If ::cCusFil != 'E'
        	cQuery += " MOV.FILIAL  = ? And "
        EndIf
        cQuery += " MOV.ALIAS   = ? And "
        cQuery += " MOV.CF Not In (?, ?)"
        cQuery += " GROUP BY "
        cQuery += " TRMCP.R_E_C_N_O_, "
        cQuery += " TRM.R_E_C_N_O_, "
        cQuery += " TRM.FILPROC, "
        cQuery += " TRM.FILIAL, "
        cQuery += " TRM.COD, "
        cQuery += " MOV.OP, "
        cQuery += " MOVCP.CODPAR, "
        cQuery += " MOVCP.MOEDA "

        cQuery := ChangeQuery(cQuery)

        ::oUpdateOPPerProcessingLevel := FWExecStatement():New(cQuery)
    EndIf

    nBind := 1
    ::oUpdateOPPerProcessingLevel:SetString(nBind++,::cFProc)
    If ::cCusFil != 'E'
    	::oUpdateOPPerProcessingLevel:SetString(nBind++,cFilAtu)
    EndIf
    ::oUpdateOPPerProcessingLevel:SetString(nBind++,'SD3')
    ::oUpdateOPPerProcessingLevel:SetString(nBind++,'DE9')
    ::oUpdateOPPerProcessingLevel:SetString(nBind++,'RE9')

    cQuery := ::oUpdateOPPerProcessingLevel:GetFixQuery()

    cMerge := ::MergeStatement(cTableName, cQuery, aMatch, aUpdate, aCpoDest, aInsert)

    ::RunQuery(cMerge)
Return
