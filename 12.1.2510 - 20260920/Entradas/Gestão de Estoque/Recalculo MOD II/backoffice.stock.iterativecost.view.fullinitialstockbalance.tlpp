/*/{Protheus.doc} GetQuery
    Retorna a query estruturada da instalação da View com base nos parâmetros informados
    @author Leonardo Kichitaro
    @since 03/11/2025
    /*/
Method GetQuery(cEmpAtu As Character, jParam As Json) Class ViewFullInitialStockBalance
    Local cQuery  As Character
    Local cIDView As Character
    Local cNomFis As Character
    Local cDbType As Character
    Local cVersao As Character
    
	cIDView := ::GetViewID()
    cNomFis := "VW_"+cIDView+"_"+cEmpAtu
    cDbType := TCGetDB()
    cVersao := ::GetVersion()

    cQuery := " Create View "+cNomFis+" As "
    cQuery += " Select "
    If cDbType $ 'POSTGRES'
        cQuery += " Char(4) "
    EndIf
    cQuery += "'"+cVersao+"' ASSINATURA, "
    cQuery += " B9_FILIAL, B9_COD, B9_LOCAL, B9_DATA, B9_QINI, B9_QISEGUM, "
	cQuery += " B9_VINI1, B9_VINI2,	B9_VINI3, B9_VINI4, B9_VINI5, "
	cQuery += " B9_CM1,	  B9_CM2,   B9_CM3,   B9_CM4,   B9_CM5 "
    cQuery += " From "+RetSQLName('SB9')+" SB9 "
    cQuery += " Where "
    cQuery += " SB9.D_E_L_E_T_ = ' ' "
Return cQuery
