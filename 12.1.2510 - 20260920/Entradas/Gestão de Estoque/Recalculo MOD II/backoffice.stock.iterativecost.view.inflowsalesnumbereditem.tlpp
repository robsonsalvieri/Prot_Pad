/*/{Protheus.doc} GetQuery
    Retorna a query estruturada da instalação da View com base nos parâmetros informados
    @author g.moreira
    @since 22/07/2024
    /*/
Method GetQuery(cEmpAtu As Character, jParam As Json) Class ViewInvoiceSalesNumberedItem
    Local cQuery  As Character
    Local cIDView As Character
    Local cNomFis As Character
    Local cDbType As Character
    Local cVersao As Character
    Local cCollation As Character

	cIDView := ::GetViewID()
    cNomFis := "VW_"+cIDView+"_"+cEmpAtu
    cDbType := TCGetDB()
    cVersao := ::GetVersion()

	cCollation := "Latin1_General_100_bin" 

    If cDbType $ "ORACLE"
        cCollation := "ASCII7"
    ElseIf cDbType $ "POSTGRES"
        cCollation := '"C"'
    EndIf

    cQuery := " Create View "+cNomFis+" As "
    cQuery += " Select "
    If cDbType $ 'POSTGRES'
        cQuery += " Char(4) "
    EndIf
    cQuery += "'"+cVersao+"' ASSINATURA, "
    cQuery += " Row_Number() Over (Partition by  " 
    cQuery += " D2_FILIAL, D2_DOC, D2_SERIE, D2_CLIENTE, D2_LOJA "
    cQuery += " Order by D2_ITEM Collate "+cCollation+") D2_ITEMNR, "
    cQuery += " D2_FILIAL, D2_DOC, D2_SERIE, D2_CLIENTE, D2_LOJA, "
    cQuery += " D2_COD, D2_ITEM, D2_TES, R_E_C_N_O_, "
    cQuery += " D2_EMISSAO, D2_QUANT, D2_QTSEGUM, "
    cQuery += " D2_CUSTO1, D2_CUSTO2, D2_CUSTO3, D2_CUSTO4, D2_CUSTO5 "
    cQuery += " From (Select "
    cQuery += " D2_FILIAL, D2_DOC, D2_SERIE, D2_CLIENTE, D2_LOJA, "
    cQuery += " D2_COD, D2_ITEM, D2_TES, R_E_C_N_O_, "
    cQuery += " D2_EMISSAO, D2_QUANT, D2_QTSEGUM, "
    cQuery += " D2_CUSTO1, D2_CUSTO2, D2_CUSTO3, D2_CUSTO4, D2_CUSTO5 "
    cQuery += " From "+RetSQLName('SD2')+" " 
    cQuery += " Where D_E_L_E_T_ = ' '  ) A "
Return cQuery
