#include "Totvs.ch"
#include "tlpp-core.th"

using namespace totvs.protheus.backoffice.stock.iterativecost.table.manager
Using Namespace totvs.protheus.backoffice.stock.iterativecost.table.processingtable
Using namespace totvs.protheus.backoffice.stock.iterativecost.view.laborproduct
Using Namespace totvs.protheus.backoffice.stock.iterativecost.view.laborrequests
Using Namespace totvs.protheus.backoffice.stock.iterativecost.accounting.laborproductvalue
Using Namespace totvs.protheus.backoffice.stock.iterativecost.view.parts.laborrequests

Namespace totvs.protheus.backoffice.stock.iterativecost.table.parts.laborbycostcenterparts

/*/{Protheus.doc} LaborByCostCenterParts
    Quantidade por centro de custos
    @Type Class
    @author SquadEntradas
    @since 23/04/2025
    @version 1
    /*/
Class LaborByCostCenterParts From TableManager
    Public Method New()

    static method tableFields()
    static method tableIndexes()
    static method tableName()

    Public Method TableManager()
    Public Method InsLaborByCC()

    Public Data oQryIns As Object
    Public Data oQryDup As Object
    Public Data jParams As Json
EndClass

/*/{Protheus.doc} New
    Instância
    @Type Method
    @author SquadEntradas
    @since 23/04/2025
    /*/
Method New(aFil, jParams) Class LaborByCostCenterParts

    ::oQryIns := Nil
    ::jParams := jParams

    _Super:New(aFil)

Return Self

/*/{Protheus.doc} TableManager
    Criação da tabela no banco
    @Type Method
    @author Squad entradas
    @since 23/04/2025
    /*/
Method TableManager() Class LaborByCostCenterParts
    _Super:TableManager(::TableName(),::TableFields(),::TableIndexes())
Return 

/*/{Protheus.doc} TableFields
    Campos da tabela de saldos por armazém
    @author Squad Entradas
    @Type Method
    @since 23/04/2025
/*/
Method tableFields() Class LaborByCostCenterParts
    Local aFields := {}

    aAdd(aFields, {"FILPROC", "C" , TamSX3('B1_FILIAL')[1], 0})
    aAdd(aFields, {"FILIAL",  "C" , TamSX3('B1_FILIAL')[1], 0})
    aAdd(aFields, {"CCUSTO",  "C" , TamSX3('B1_CCCUSTO')[1], 0})
    aAdd(aFields, {"GCC",     "C" , TamSX3('B1_GCCUSTO')[1], 0})
    aAdd(aFields, {"ITEMC",   "C" , TamSX3('D4F_ITEMC')[1], 0})
    aAdd(aFields, {"CLVLR",   "C" , TamSX3('D4F_CLVLR')[1], 0})
    aAdd(aFields, {"CODPAR",   "C" , TamSX3('D4F_CODPAR')[1], 0})
    aAdd(aFields, {"MOEDA",   "C" , 2, 0})
    aAdd(aFields, {"QUANT",   "N" , TamSX3('B2_QFIM')[1], TamSX3('B2_QFIM')[2]})
    aAdd(aFields, {"CUSTO",    "N" , TamSX3('D3_CUSTO1')[1], TamSX3('D3_CUSTO1')[2]})
    
Return aFields

/*/{Protheus.doc} TableIndexes
    Índices da tabela de saldos por armazém
    @Type Method
    @author Squad Entradas
    @since 23/04/2025
/*/
Method tableIndexes() Class LaborByCostCenterParts
    Local aIndex := {}

    aAdd(aIndex, {LaborByCostCenterParts():TableName()+'_01', 'FILPROC+FILIAL+CCUSTO+GCC+ITEMC+CLVLR+CODPAR+MOEDA'})
    aAdd(aIndex, {LaborByCostCenterParts():TableName()+'_02', 'FILPROC+FILIAL+CODPAR+MOEDA'})

Return aIndex

/*/{Protheus.doc} TableName
    Retorna o nome da tabela de saldos por armazém
    @Type Method
    @author Squad Entradas
    @since 23/04/2025
/*/
Method tableName() Class LaborByCostCenterParts
    Local cAlias as character

    cAlias := "TRCCCP"+cEmpAnt+"SP"

Return cAlias

/*/{Protheus.doc} InsLaborByCC
    Realiza inserção na tabela
    @Type Method
    @author user
    @since 23/04/2025
    /*/
Method InsLaborByCC(cFilProc, dDtIni, dDtFim) Class LaborByCostCenterParts
    Local cSD3MOD        As Character
    Local cProcTable     As Character
    Local cQuery         As Character
    Local cFilAtu        As Character
    Local cMoeda         As Character
    Local cMoedaIns      As Character
    Local nMoeda         As Numeric
    Local nBind          As Numeric
    Local nFil           As Numeric
    Local aMatch   := {} As Array
    Local aUpdate  := {} As Array
    Local aCpoDest := {} As Array
    Local aInsert  := {} As Array
    Local cMerge   := "" As Character
    Local nTamRev        As Integer
    Local nTItemC        As Integer
    Local nTClVlr        As Integer
    
    cProcTable := ProcessingTable():TableName()
    cSD3MOD    := 'VW_'+ViewLaborRequestsParts():GetViewID()+'_'+cEmpAnt
    nTClVlr    := TamSX3("CT2_CLVLDB")[1]
    nTItemC    := TamSX3("CT2_ITEMD")[1]
    nTamRev    := TamSX3("D4F_REVIS")[1]

    //Obtém a quantidade por CCUSTO
    If ::oQryIns == Nil
        cQuery := " Select "
        cQuery += " Cast('"+cFilProc+"' As Char("+cValToChar(FWSizeFilial())+")) FILPROC, "
        cQuery += " SD3.D3_FILIAL FILIAL, "
        cQuery += " SD3.B1_CCCUSTO CCUSTO, "
        cQuery += " SD3.B1_GCCUSTO GCC, "
        cQuery += " SD3.D4F_ITEMC ITEMC, "
        cQuery += " SD3.D4F_CLVLR CLVLR, "
        cQuery += " SD3.D4G_CODPAR CODPAR, "
        cQuery += " Sum(SD3.D3_QUANT) QUANT "
        cQuery += " From "+cSD3MOD+" SD3 "
        cQuery += " Where "
        cQuery += " SD3.D3_FILIAL = ? And "
        cQuery += " SD3.D3_EMISSAO >= ? And "
        cQuery += " SD3.D3_EMISSAO <= ? And "
        cQuery += " (SD3.D4G_REVIS = ? Or SD3.D4G_REVIS = ? )"
        If  FWModeAccess("SB1", 1) != FWModeAccess("SD3", 1) .Or. ;
            FWModeAccess("SB1", 2) != FWModeAccess("SD3", 2) .Or. ;
            FWModeAccess("SB1", 3) != FWModeAccess("SD3", 3)
            cQuery += " And SD3.B1_FILIAL = ? "
        EndIf
        cQuery += " Group By "
        cQuery += " SD3.D3_FILIAL,  SD3.B1_CCCUSTO, "
        cQuery += " SD3.B1_GCCUSTO, SD3.D4F_ITEMC, SD3.D4F_CLVLR, SD3.D4G_CODPAR "
        cQuery := ChangeQuery(cQuery)

        ::oQryIns := FWExecStatement():New(cQuery)
    EndIf

    For nFil := 1 To Len(::aFilProc)
        cFilAtu := ::aFilProc[nFil, 1]

        For nMoeda := 1 To Len(::jParams["moedas"])
            cMoeda := ::jParams["moedas", nMoeda]
            cMoedaIns := StrZero(Val(cMoeda), 2)

            nBind := 1
            ::oQryIns:SetString(nBind++, FWXFilial('SD3', cFilAtu))
            ::oQryIns:SetString(nBind++, DToS(dDtIni))
            ::oQryIns:SetString(nBind++, DToS(dDtFim))
            ::oQryIns:SetString(nBind++, Space(nTamRev))
            ::oQryIns:SetString(nBind++, ::jParams["revisao_vigente"])
            If  FWModeAccess("SB1", 1) != FWModeAccess("SD3", 1) .Or. ;
                FWModeAccess("SB1", 2) != FWModeAccess("SD3", 2) .Or. ;
                FWModeAccess("SB1", 3) != FWModeAccess("SD3", 3)
                ::oQryIns:SetString(nBind++, FWXFilial('SB1', cFilAtu))
            EndIf

            cQuery := ::oQryIns:GetFixQuery()

            //Filtro
            ASize(aMatch, 0)
            aMatch := {}
            AAdd(aMatch, {"FILPROC", "FILPROC"})
            AAdd(aMatch, {"FILIAL", "FILIAL"})
            AAdd(aMatch, {"CCUSTO", "CCUSTO"})
            AAdd(aMatch, {"GCC", "GCC"})
            AAdd(aMatch, {"ITEMC", "ITEMC"})
            AAdd(aMatch, {"CLVLR", "CLVLR"})
            AAdd(aMatch, {"CODPAR", "CODPAR"})
            AAdd(aMatch, {"'"+cMoedaIns+"'", "MOEDA"})

            //Expressões de update
            ASize(aUpdate, 0)
            aUpdate := {}
            AAdd(aUpdate, "QUANT = Destino.QUANT + Origem.QUANT")
            
            //Expressões de insert
            ASize(aCpoDest, 0)
            aCpoDest := {}
            AAdd(aCpoDest, "FILPROC")
            AAdd(aCpoDest, "FILIAL")
            AAdd(aCpoDest, "CCUSTO")
            AAdd(aCpoDest, "GCC")
            AAdd(aCpoDest, "ITEMC")
            AAdd(aCpoDest, "CLVLR")
            AAdd(aCpoDest, "QUANT")
            AAdd(aCpoDest, "CODPAR")
            AAdd(aCpoDest, "MOEDA")
            
            ASize(aInsert, 0)
            aInsert := {}
            AAdd(aInsert, "Origem.FILPROC")
            AAdd(aInsert, "Origem.FILIAL")
            AAdd(aInsert, "Origem.CCUSTO")
            AAdd(aInsert, "Origem.GCC")
            AAdd(aInsert, "Origem.ITEMC")
            AAdd(aInsert, "Origem.CLVLR")
            AAdd(aInsert, "Origem.QUANT")
            AAdd(aInsert, "Origem.CODPAR")
            AAdd(aInsert, "'"+cMoedaIns+"'")

            cMerge := ::MergeStatement(::TableName(), cQuery, aMatch, aUpdate, aCpoDest, aInsert)

            ::RunQuery(cMerge)
        Next nMoeda
    Next nFil

    //Define a prioridade do item contábil sobre a classe valor
    //Se houver algum item contábil informado sem classe valor, gera uma linha
    //para cada combinação possível de item/classe valor
    If ::oQryDup == Nil
        cQuery := " Select A.FILPROC, A.FILIAL, A.CCUSTO, A.GCC, "
        cQuery += " A.ITEMC, B.CLVLR, 'ZZ' CODPAR, A.MOEDA "
        cQuery += " From "+::TableName()+" A "
        cQuery += " Inner Join "+::TableName()+" B On "
        cQuery += " B.FILPROC = A.FILPROC And "
        cQuery += " B.FILIAL  = A.FILIAL  And "
        cQuery += " B.CCUSTO  = A.CCUSTO  And "
        cQuery += " B.GCC     = A.GCC     And "
        cQuery += " B.CLVLR   <> ?        And "
        cQuery += " B.MOEDA   = A.MOEDA "
        cQuery += " Where "
        cQuery += " A.FILPROC = ? And "
        cQuery += " A.FILIAL  = ? And "
        cQuery += " A.ITEMC  <> ? And "
        cQuery += " A.CLVLR   = ? "
        cQuery += " Group By "
        cQuery += " A.FILPROC, A.FILIAL, A.CCUSTO, A.GCC, "
        cQuery += " A.ITEMC, B.CLVLR,  A.MOEDA"
        cQuery := ChangeQuery(cQuery)
    
        ::oQryDup := FWExecStatement():New(cQuery)
    EndIf

    For nFil := 1 To Len(::aFilProc)
        cFilAtu := ::aFilProc[nFil, 1]
        nBind := 1
        ::oQryDup:SetString(nBind++, Space(nTClVlr))
        ::oQryDup:SetString(nBind++, cFilProc)
        ::oQryDup:SetString(nBind++, cFilAtu)
        ::oQryDup:SetString(nBind++, Space(nTItemC))
        ::oQryDup:SetString(nBind++, Space(nTClVlr))

        cQuery := ::oQryDup:GetFixQuery()

        //Filtro
        ASize(aMatch, 0)
        aMatch := {}
        AAdd(aMatch, {"FILPROC", "FILPROC"})
        AAdd(aMatch, {"FILIAL", "FILIAL"})
        AAdd(aMatch, {"CCUSTO", "CCUSTO"})
        AAdd(aMatch, {"GCC", "GCC"})
        AAdd(aMatch, {"ITEMC", "ITEMC"})
        AAdd(aMatch, {"CLVLR", "CLVLR"})
        //AAdd(aMatch, {"CODPAR", "CODPAR"})
        AAdd(aMatch, {"MOEDA", "MOEDA"})

        //Expressões de update
        ASize(aUpdate, 0)
        aUpdate := {}
        AAdd(aUpdate, "QUANT = Destino.QUANT")
        
        //Expressões de insert
        ASize(aCpoDest, 0)
        aCpoDest := {}
        AAdd(aCpoDest, "FILPROC")
        AAdd(aCpoDest, "FILIAL")
        AAdd(aCpoDest, "CCUSTO")
        AAdd(aCpoDest, "GCC")
        AAdd(aCpoDest, "ITEMC")
        AAdd(aCpoDest, "CLVLR")
        //AAdd(aCpoDest, "QUANT")
        AAdd(aCpoDest, "CODPAR")
        AAdd(aCpoDest, "MOEDA")
        
        ASize(aInsert, 0)
        aInsert := {}
        AAdd(aInsert, "Origem.FILPROC")
        AAdd(aInsert, "Origem.FILIAL")
        AAdd(aInsert, "Origem.CCUSTO")
        AAdd(aInsert, "Origem.GCC")
        AAdd(aInsert, "Origem.ITEMC")
        AAdd(aInsert, "Origem.CLVLR")
        //AAdd(aInsert, "Origem.QUANT")
        AAdd(aInsert, "Origem.CODPAR")
        AAdd(aInsert, "Origem.MOEDA")

        cMerge := ::MergeStatement(::TableName(), cQuery, aMatch, aUpdate, aCpoDest, aInsert)

        ::RunQuery(cMerge)
    Next nFil
Return
