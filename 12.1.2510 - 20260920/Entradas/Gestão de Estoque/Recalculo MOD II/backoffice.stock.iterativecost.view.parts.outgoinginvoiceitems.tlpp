#include "tlpp-core.th"

Namespace totvs.protheus.backoffice.stock.iterativecost.view.parts.outgoinginvoiceitems

/*/{Protheus.doc} ViewOutgoingInvoiceItemsParts
    View SB1MODP - Itens NF saída - custo em partes
    @author Leonardo Kichitaro
    @Type Method
    @since 28/10/2025
    @version 1
    /*/
Class ViewOutgoingInvoiceItemsParts //Implements IterativeCostView
    Public Method New()

    Static Method GetVersion()
    Static Method GetViewID()
    Public Method GetParams()
    Public Method GetQuery()
EndClass

/*/{Protheus.doc} New
    Instância
    @author Leonardo Kichitaro
    @Type Method
    @since 28/10/2025
    /*/
Method New() Class ViewOutgoingInvoiceItemsParts

    Select('D4M')

Return Self

/*/{Protheus.doc} GetVersion
    Versão da View
    @author Leonardo Kichitaro
    @Type Method
    @since 28/10/2025
    /*/
Method GetVersion() Class ViewOutgoingInvoiceItemsParts
Return "0001"

/*/{Protheus.doc} GetViewID
    ID da View
    Não alterar após entrar em produção
    @author Leonardo Kichitaro
    @Type Method
    @since 28/10/2025
    /*/
Method GetViewID() Class ViewOutgoingInvoiceItemsParts
Return "VWD2SDITCP"

/*/{Protheus.doc} GetParams
    Retorna Json contendo os codeblock executáveis para obter os parâmetros da View
    @author Leonardo Kichitaro
    @Type Method
    @since 28/10/2025
    /*/
Method GetParams() Class ViewOutgoingInvoiceItemsParts
    Local jExec := JsonObject():New() As Json

    jExec["TAM_CODPAR"]  := {|| TamSX3('D4M_PARTE')[1]}
Return jExec

/*/{Protheus.doc} GetQuery
    Retorna a query estruturada da instalação da View com base nos parâmetros informados
    @author Leonardo Kichitaro
    @Type Method
    @since 28/10/2025
    /*/
Method GetQuery(cEmpAtu As Character, jParam As Json) Class ViewOutgoingInvoiceItemsParts

    Local cQuery  As Character
    Local cIDView As Character
    Local cNomFis As Character
    Local cDbType As Character
    Local cVersao As Character
    Local nTamPar := jParam["TAM_CODPAR"]
    Local cOutros := Replicate('9', nTamPar)
    Local cTamPar := cValToChar(nTamPar)

	cIDView := ::GetViewID()
    cNomFis := "VW_"+cIDView+"_"+cEmpAtu
    cDbType := TCGetDB()
    cVersao := ::GetVersion()

    cQuery := " Create View "+cNomFis+" As "
    cQuery += " Select "
    cQuery += " Cast('"+cVersao+"' As Char(4)) ASSINATURA, "
    cQuery += " D2_FILIAL, D2_DOC, D2_SERIE, D2_CLIENTE, D2_LOJA, "
    cQuery += " D2_EMISSAO, D2_COD, D2_LOCAL, D2_ITEM, D2_QUANT, D2_QTSEGUM, D2_TES, "
    cQuery += " D2_CUSTO1, D2_CUSTO2, D2_CUSTO3, D2_CUSTO4, D2_CUSTO5, SD2.R_E_C_N_O_, "
    cQuery += " D4M_FILIAL, D4M_REVISA, "
    cQuery += " Cast(Coalesce(D4M_PARTE, '"+cOutros+"') As Char("+cTamPar+")) D4M_PARTE, "
    cQuery += " D4M_MOEDA, D4M_TOTAL "
    cQuery += " From "+RetSQLName('SD2')+" SD2 "
    cQuery += " Inner Join "+RetSQLName('D4M')+" D4M On "
    cQuery += " D4M.D4M_FILIAL = SD2.D2_FILIAL And "
    cQuery += " D4M.D4M_DOC  = SD2.D2_DOC And "
    cQuery += " D4M.D4M_SERIE = SD2.D2_SERIE And "
    cQuery += " D4M.D4M_CLIENT  = SD2.D2_CLIENTE And "
    cQuery += " D4M.D4M_LOJA = SD2.D2_LOJA And "
    cQuery += " D4M.D4M_ITEM  = SD2.D2_ITEM And "
    cQuery += " D4M.D_E_L_E_T_ = ' ' " 

Return cQuery
