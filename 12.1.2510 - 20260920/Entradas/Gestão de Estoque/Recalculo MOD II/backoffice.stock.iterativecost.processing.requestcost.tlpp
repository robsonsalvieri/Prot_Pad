#Include 'Totvs.ch'
#include 'tlpp-core.th'

Using namespace totvs.protheus.backoffice.stock.iterativecost.table.manager
Using Namespace totvs.protheus.backoffice.stock.iterativecost.table.processingtable
using namespace totvs.protheus.backoffice.stock.iterativecost.table.analyticalmovementtable
using namespace totvs.protheus.backoffice.stock.iterativecost.table.aglutinattedmovementtable
Using namespace totvs.protheus.backoffice.stock.iterativecost.table.balancebyproductionorder
using namespace totvs.protheus.backoffice.stock.iterativecost.table.productstructleveltable
Using namespace totvs.protheus.backoffice.stock.iterativecost.view.acquisitioncost
Using Namespace totvs.protheus.backoffice.stock.iterativecost.view.transferinvoice
Using Namespace totvs.protheus.backoffice.stock.iterativecost.view.acquisitioncost
Using namespace totvs.protheus.backoffice.stock.iterativecost.view.transferinvoice

namespace totvs.protheus.backoffice.stock.iterativecost.processing.requestcost

/*/{Protheus.doc} RequestCost
    Classe responsável pela tabela que registra o custo dos movimentos de requisição das transferências internas, entre filiais, desmontagem e liberação de CQ.

    @type Class
    @author Squad Entradas
    @since 12/08/2025
/*/
Class RequestCost From TableManager

    public method New() 

    Public Method ProductionRequestCost()
    Public Method InternalTransferRequestCost()
    Public Method DisassembleRequestCost()
    Public Method BranchTransferRequestCost()

    Public Data cTabAnl As Character
    Public Data cTabAgl As Character
    Public Data cTabProc As Character
    Public Data cTabOp  As Character
    Public Data cTabNiv As Character
    Public data cVwTrf  As Character

    Public Data jVwAcquistCstParams       As Json
    Public Data cViewAcquisCst            As Character
    Public Data cCusFil                   As Character
    Public Data jParams                   As Json
    Public Data cFProc                    As Character

    Private Data oQryPR0Req As Object
    Private Data oQryRE4    As Object
    Private Data oQryRE7    As Object
    Private Data oQryTrFil  As Object

endclass

/*/{Protheus.doc} New
    Instância da classe

    @type method
    @author Squad Entradas
    @since 12/08/2025
/*/
Method New(cFilProc, aFil, jParams) Class RequestCost

    ::cCusFil    := jParams["MV_CUSFIL"]
    ::jParams    := jParams
    ::cTabAnl    := AnalyticalMovementTable():TableName()
    ::cTabAgl    := AgglutinatedMovementTable():TableName()
    ::cTabProc   := ProcessingTable():TableName()
    ::cTabOp     := BalanceByProductionOrder():TableName()
    ::cTabNiv    := ProductStructLevelTable():TableName()
    ::cVwTrf     := "VW_" + ViewTransferInvoice():GetViewID() + "_" + cEmpAnt
    ::cFProc     := cFilProc

    _Super:New(aFil)
Return


/*/{Protheus.doc} ProductionRequestCost
    Atualiza o custo dos movimentos requisitados para a OP
    @author Squad Entradas
    @since 12/08/2025
    @type method
    /*/
Method ProductionRequestCost(cFilAtu, cNivInv) Class RequestCost
    Local cQuery    as character
    Local nI, nBind
    Local cMoeda
    Local cUpdate
    Local cMatchFilter
    Local cCTE
    
    If ::oQryPR0Req == Nil
        cQuery := " Select "
        For nI := 1 To Len(::jParams["moedas"])
            cMoeda := ::jParams["moedas"][nI]
            cQuery += " Case "
            cQuery += "    When ANL.CUSTOMEDIO = 'S' Then "
            cQuery += "        ANL.QUANT * PRO.CMPROC"+cMoeda+" "
            cQuery += "    Else ANL.CUSTO"+cMoeda+" "
            cQuery += " End CSTRE"+cMoeda+", "
        Next nI
        cQuery += " ANL.R_E_C_N_O_ MOVREC "
        cQuery += " From "+::cTabNiv+" NIV "
        cQuery += " Inner Join "+::cTabOp+" SLDOP On "
        cQuery += " SLDOP.FILPROC = NIV.FILPROC AND "
        If ::cCusFil != 'E'
            cQuery += " SLDOP.FILIAL  = NIV.FILIAL  AND "
        EndIf
        cQuery += " SLDOP.COD     = NIV.COD "
        cQuery += " Inner Join "+::cTabAnl+" ANL On "
        cQuery += " ANL.FILPROC = SLDOP.FILPROC AND "
        If ::cCusFil != 'E'
            cQuery += " ANL.FILIAL  = SLDOP.FILIAL  AND "
        EndIf
        cQuery += " ANL.OP      = SLDOP.OP And "
        cQuery += " ANL.CF Not In ('PR0','PR1') "
        cQuery += " Inner Join "+::cTabProc+" PRO On "      
        cQuery +=     "    PRO.FILPROC = ANL.FILPROC "
        If ::cCusFil != 'E'
            cQuery +=     "AND PRO.FILIAL  = ANL.FILIAL "
        EndIf
        cQuery +=     "AND PRO.COD     = ANL.COD "
        If ::cCusFil == 'A'
            cQuery +=     "AND PRO.ARMAZEM = ANL.LOCARM "
        EndIf
        cQuery += " Where "
        cQuery += " NIV.FILPROC = ? And "
        cQuery += " NIV.FILIAL  = ? And "
        cQuery += " NIV.NIVINV  = ? "
        cQuery += " Group By "
        cQuery += " ANL.FILPROC, "
        cQuery += " ANL.FILIAL, "
        cQuery += " ANL.COD, "
        cQuery += " ANL.LOCARM, "
        cQuery += " ANL.CUSTOMEDIO, "
        cQuery += " ANL.QUANT, "
        For nI := 1 To Len(::jParams["moedas"])
            cMoeda := ::jParams["moedas"][nI]
            cQuery += " ANL.CUSTO"+cMoeda+", "
            cQuery += " PRO.CMPROC"+cMoeda+", "
        Next
        cQuery += " ANL.R_E_C_N_O_ "

        ::oQryPR0Req := FWExecStatement():New(cQuery)
    EndIf

    nBind := 1
    ::oQryPR0Req:SetString(nBind++, ::cFProc) //NIV.FILPROC
    If ::cCusFil == 'E'
        ::oQryPR0Req:SetString(nBind++, PadR(FWCompany(), FWSizeFilial()))
    Else
        ::oQryPR0Req:SetString(nBind++, cFilAtu) //NIV.FILIAL
    EndIf
    ::oQryPR0Req:SetString(nBind++, cNivInv) //NIV.NIVINV

    cQuery := ::oQryPR0Req:GetFixQuery()

    //Filtro
    cMatchFilter := ::cTabAnl+".R_E_C_N_O_ = TEMPTABLE.MOVREC "
    
    //Expressões de update
    cUpdate := ""
    For nI := 1 To Len(::jParams["moedas"])
        cMoeda := ::jParams["moedas"][nI]
        cUpdate += "CSTRE"+cMoeda+" = TEMPTABLE.CSTRE"+cMoeda+','
    Next nI
    cUpdate += "CALCREQ = 'S'"
        
    cCTE := ::buildCteStatement(::cTabAnl, cUpdate, cMatchFilter, cQuery)

    ::RunQuery(cCTE)
Return 

/*/{Protheus.doc} InternalTransferRequestCost
    Atualiza o custo dos movimentos de requisição de transferência interna
    @author Squad Entradas
    @since 07/01/2026
    @type method
    /*/
Method InternalTransferRequestCost(nRecDevAGL) Class RequestCost
    Local cQuery    as character
    Local nI
    Local cMoeda
    Local cUpdate
    Local cMatchFilter
    Local cCTE
   
    If ::oQryRE4 == Nil
        cQuery := " Select "
        For nI := 1 To Len(::jParams["moedas"])
            cMoeda := ::jParams["moedas"][nI]
            cQuery += "(PRO.CMPROC" + cMoeda + " * REQ.QUANT) CSTRE" + cMoeda + ", "
        Next nI
        cQuery += " REQ.R_E_C_N_O_ MOVREC "
        cQuery += " From " + ::cTabAgl + " AGL "
        cQuery += " Inner Join " + ::cTabAnl + " DEV " //FILPROC+IGNORE+CHVAGL+FILIAL+LOCARM+COD
        cQuery += "    On  DEV.FILPROC = AGL.FILPROC "
        cQuery += "   And  DEV.IGNORE  = ? "
        cQuery += "    And DEV.CHVAGL  = AGL.CHVAGL "
        If ::cCusFil != 'E'
            cQuery += "    And DEV.FILIAL  = AGL.FILIAL "
        EndIf
        If ::cCusFil == 'A'
            cQuery += " And DEV.LOCARM  = AGL.LOCARM "
        EndIf
        cQuery += "    And DEV.COD     = AGL.COD "        
        cQuery += "Inner Join " + ::cTabAnl + " REQ "
        cQuery += "    On  REQ.FILPROC = DEV.FILPROC "
        cQuery += "    And REQ.FILIAL  = DEV.FILIAL "
        cQuery += "    And REQ.CF      = ? "
        cQuery += "    And REQ.SEQ     = DEV.SEQ "
        cQuery += "Inner Join " + ::cTabProc + " PRO "
        cQuery += "    On  PRO.FILPROC = REQ.FILPROC "
        If ::cCusFil != 'E'
            cQuery += "    And PRO.FILIAL  = REQ.FILIAL "
        EndIf
        cQuery += "    And PRO.COD     = REQ.COD "
        If ::cCusFil == 'A'
            cQuery += " And PRO.ARMAZEM = REQ.LOCARM "
        EndIf
        cQuery += "Where AGL.R_E_C_N_O_ = ? "

        ::oQryRE4 := FWExecStatement():New(cQuery)
    EndIf

    ::oQryRE4:SetString(1, 'N') //DEV.IGNORE
    ::oQryRE4:SetString(2, 'RE4') //REQ.CF
    ::oQryRE4:SetNumeric(3, nRecDevAGL) //NIV.NIVINV

    cQuery := ::oQryRE4:GetFixQuery()

    //Filtro
    cMatchFilter := ::cTabAnl+".R_E_C_N_O_ = TEMPTABLE.MOVREC "
    
    //Expressões de update
    cUpdate := ""
    For nI := 1 To Len(::jParams["moedas"])
        cMoeda := ::jParams["moedas"][nI]
        cUpdate += "CSTRE"+cMoeda+" = TEMPTABLE.CSTRE"+cMoeda+','
    Next nI
    cUpdate += "CALCREQ = 'S'"
        
    cCTE := ::buildCteStatement(::cTabAnl, cUpdate, cMatchFilter, cQuery)

    ::RunQuery(cCTE)
Return 

/*/{Protheus.doc} DisassembleRequestCost
    Calcula o custo do movimento de requisição para desmontagem uma única vez por iteração, no momento do cálculo da primeira devolução
    @author Squad Entradas 
    @since 14/01/2026
    @Type Method
    /*/
Method DisassembleRequestCost(cFilAtu) Class RequestCost
     Local cQuery    as character
    Local nI
    Local cMoeda
    Local nBind
    Local cUpdate
    Local cMatchFilter
    Local cCTE

    //Busca qual o registro de requisição da desmontagem a partir da devolução   
    If ::oQryRE7 == Nil
        cQuery := " Select "
        For nI := 1 To Len(::jParams["moedas"])
            cMoeda := ::jParams["moedas"][nI]
            cQuery += "(PRO.CMPROC" + cMoeda + " * REQ.QUANT) CSTRE" + cMoeda + ", "
        Next nI
        cQuery += " REQ.R_E_C_N_O_ MOVREC "
        cQuery += " From " + ::cTabAnl + " REQ "
        cQuery += " Inner Join " + ::cTabProc + " PRO "
        cQuery += "    On  PRO.FILPROC = REQ.FILPROC "
        If ::cCusFil != 'E'
            cQuery += "    And PRO.FILIAL  = REQ.FILIAL "
        EndIf
        cQuery += "    And PRO.COD     = REQ.COD "
        If ::cCusFil == 'A'
            cQuery += " And PRO.ARMAZEM = REQ.LOCARM "
        EndIf
        cQuery += "  Where REQ.FILPROC = ? "
        If ::cCusFil != 'E'
            cQuery += "    And REQ.FILIAL  = ? "
        EndIf
        cQuery += "    And REQ.CF      = ? "

        ::oQryRE7 := FWExecStatement():New(cQuery)
    EndIf

    nBind := 1
    ::oQryRE7:SetString(nBind++, ::cFProc) //REQ.FILPROC
    If ::cCusFil != 'E'
        ::oQryRE7:SetString(nBind++, cFilAtu) //REQ.FILIAL
    EndIf
    ::oQryRE7:SetString(nBind++, 'RE7') //REQ.CF

    cQuery := ::oQryRE7:GetFixQuery()

    //Filtro
    cMatchFilter := ::cTabAnl+".R_E_C_N_O_ = TEMPTABLE.MOVREC "
    
    //Expressões de update
    cUpdate := ""
    For nI := 1 To Len(::jParams["moedas"])
        cMoeda := ::jParams["moedas"][nI]
        cUpdate += "CSTRE"+cMoeda+" = TEMPTABLE.CSTRE"+cMoeda+','
    Next nI
    cUpdate += "CALCREQ = 'S'"
        
    cCTE := ::buildCteStatement(::cTabAnl, cUpdate, cMatchFilter, cQuery)

    ::RunQuery(cCTE)
Return


/*/{Protheus.doc} BranchTransferRequestCost
    Atualiza o custo dos movimentos de requisição de transferência entre filiais
    @author Squad.Entradas
    @since 13/02/2026
    @version 1.0
    @param cFilAtu, character, Filial atual
    @param nRecDevAGL, numeric, Recno do dest. na AGL
    @param dDtIni, date, Data inicial do período
    @param dDtFim, date, Data final do período
    /*/
Method BranchTransferRequestCost(cFilAtu, nRecDestAGL, dDtIni, dDtFim) Class RequestCost
    Local cQuery  as character
    Local cMoeda  as character
    Local aBind   := {}
    Local nMoeda  as numeric
    Local nX      as numeric
    Local cUpdate
    Local cMatchFilter
    Local cCTE

    If ::oQryTrFil == Nil
        cQuery := "SELECT "
        For nMoeda := 1 To Len(::jParams["moedas"])
            cMoeda := ::jParams["moedas"][nMoeda]
            cQuery += "CASE "
            cQuery += "    WHEN ORIG.CUSTOMEDIO = 'S' "
            cQuery += "        THEN ORIG.QUANT * PROORIG.CMPROC"+cMoeda + " "
            cQuery += "    ELSE ORIG.CUSTO"+cMoeda + " "
            cQuery += "END CSTRE"+cMoeda + ", "
        Next nMoeda
        cQuery += " ORIG.R_E_C_N_O_ MOVREC "
        cQuery += "FROM " + ::cTabAgl + " AGL "
        cQuery += "INNER JOIN " + ::cTabAnl + " DEST "
        cQuery += "    ON  DEST.FILPROC = AGL.FILPROC "
        If ::cCusFil != "E"
            cQuery += "AND DEST.FILIAL  = AGL.FILIAL "
        EndIf
        cQuery += "    AND DEST.COD     = AGL.COD "
        If ::cCusFil == "A"
            cQuery += "AND DEST.LOCARM  = AGL.LOCARM "
        EndIf
        cQuery += "    AND DEST.CHVAGL  = AGL.CHVAGL "
        cQuery += "INNER JOIN " + ::cVwTrf + " TRF "
        cQuery += "    ON  TRF.RECDES = DEST.RECNO "
        cQuery += "    AND TRF.D2_EMISSAO >= ? "
        cQuery += "    AND TRF.D2_EMISSAO <= ? "
        cQuery += "INNER JOIN " + ::cTabAnl + " ORIG "
        cQuery += "    ON  ORIG.FILPROC = DEST.FILPROC "
        cQuery += "    AND ORIG.FILIAL  = TRF.FILORI "
        cQuery += "    AND ORIG.ALIAS   = ? "
        cQuery += "    AND ORIG.FILTRF  = ? "
        cQuery += "    AND ORIG.RECNO = TRF.RECORI "
        cQuery += "INNER JOIN " + ::cTabProc + " PROORIG "
        cQuery += "    ON  PROORIG.FILPROC = ORIG.FILPROC "
        If ::cCusFil != "E"
            cQuery += "AND PROORIG.FILIAL  = ORIG.FILIAL "
        EndIf
        cQuery += "    AND PROORIG.COD     = ORIG.COD "
        If ::cCusFil == "A"
            cQuery += "AND PROORIG.ARMAZEM = ORIG.LOCARM "
        EndIf
        cQuery += "WHERE AGL.R_E_C_N_O_ = ? "
        

        ::oQryTrFil := FWExecStatement():New(cQuery)
    EndIf

    aAdd(aBind, {dToS(dDtIni), "C"})
    aAdd(aBind, {dToS(dDtFim), "C"})
    aAdd(aBind, {"SD2", "C"})
    aAdd(aBind, {"1", "C"})
    aAdd(aBind, {nRecDestAGL, "N"})

    For nX := 1 To Len(aBind)
        If aBind[nX][2] == "C"
            ::oQryTrFil:SetString(nX, aBind[nX][1])
        ElseIf aBind[nX][2] == "N"
            ::oQryTrFil:SetNumeric(nX, aBind[nX][1])
        EndIf
    Next nX

    cQuery := ::oQryTrFil:GetFixQuery()

    //Filtro
    cMatchFilter := ::cTabAnl+".R_E_C_N_O_ = TEMPTABLE.MOVREC "

    //Expressões de update
    cUpdate := ""
    For nX := 1 To Len(::jParams["moedas"])
        cMoeda := ::jParams["moedas"][nX]
        cUpdate += "CSTRE"+cMoeda+" = TEMPTABLE.CSTRE"+cMoeda+','
    Next nX
    cUpdate += "CALCREQ = 'S'"

    cCTE := ::buildCteStatement(::cTabAnl, cUpdate, cMatchFilter, cQuery)

    ::RunQuery(cCTE)
Return
