Method GetViewID() Class ViewPartsAcquisitionCost
Return "VWSD1CP"

/*/{Protheus.doc} GetParams
    Retorna Json contendo os codeblock executáveis para obter os parâmetros da View
    @author Squad Entradas
    @type Method
    @since 28/03/2025
    /*/
Method GetParams() Class ViewPartsAcquisitionCost
    Local jExec := JsonObject():New() As Json

    jExec["D4G_EMPRESA"] := {|| FWModeAccess('D4G', 1)}
    jExec["D4G_UNIDADE"] := {|| FWModeAccess('D4G', 2)}
    jExec["D4G_FILIAL"]  := {|| FWModeAccess('D4G', 3)}
    jExec["VW_SD1_NOME"] := {|| Posicione('D4D',1,FWXFilial('D4D')+'VWSD1CT','D4D_VWNAME')}
    jExec["TAM_CODPAR"]  := {|| TamSX3('D4F_CODPAR')[1]}
    jExec["TAM_REVIS"]   := {|| TamSX3('D4G_REVIS')[1]}
    jExec["REVIS_DEFAULT"] := {|| Replicate('*', TamSX3('D4G_REVIS')[1])}

Return jExec

/*/{Protheus.doc} GetQuery
    Retorna a query estruturada da instalação da View com base nos parâmetros informados
    @author Squad Entradas
    @since 28/03/2025
    @type Method
    /*/
Method GetQuery(cEmpAtu As Character, jParam As Json) Class ViewPartsAcquisitionCost
    Local cQuery  As Character
    Local cIDView As Character
    Local cNomFis As Character
    Local cDbType As Character
    Local cVersao As Character
    Local nTamPar := jParam["TAM_CODPAR"]
    Local cOutros := Replicate('9', nTamPar)
    Local cTamPar := cValToChar(nTamPar)

	cIDView := ::GetViewID()
    cNomFis := "VW_"+cIDView+"_"+cEmpAtu
    cDbType := TCGetDB()
    cVersao := ::GetVersion()

    cQuery := " Create View "+cNomFis+" As "
    cQuery += " Select "
    cQuery += " Cast('"+cVersao+"' As Char(4)) ASSINATURA, "
    cQuery += " D1_FILIAL, D1_COD, D1_DTDIGIT, D1_LOCAL, D1_FORMUL, D1_ITEMGRD, "
    cQuery += " D1_DOC, D1_SERIE, D1_FORNECE, D1_LOJA, D1_ITEM, D1_NUMSEQ, "
    cQuery += " D1_CUSTO D1_CUSTO1, D1_CUSTO2, D1_CUSTO3, D1_CUSTO4, D1_CUSTO5, "
    cQuery += " D1_QUANT, D1_QTSEGUM, D1RECNO, F4_FILIAL, D4G_FILIAL, D4G_REVIS, "
    cQuery += " Cast(Coalesce(D4G_CODPAR, '"+cOutros+"') As Char("+cTamPar+")) D4G_CODPAR, "
    cQuery += " AFN_FILIAL, AFN_COD "
    cQuery += " From "+jParam["VW_SD1_NOME"]+" SD1 "
    cQuery += " Left Join "+RetSQLName('D4G')+" D4G On "
    //FwJoinFilial = "D4G.D4G_FILIAL = SD1.D1_FILIAL"
    cQuery += FwJoinFilial("D4G", "SD1", "D4G", "SD1")+ " And "
    cQuery += " D4G.D4G_PRODUT = SD1.D1_COD And "
    cQuery += " D4G.D_E_L_E_T_ = ' ' "
    cQuery += " Left Join "+RetSQLName('D4F')+" D4F On "
    cQuery += " D4F.D4F_FILIAL = '"+FWXFilial('D4F')+"' And " //D4F é compartilhada em todos os níveis
    cQuery += " D4F.D4F_REVIS  = D4G.D4G_REVIS And "
    cQuery += " D4F.D4F_CODPAR = D4G.D4G_CODPAR And "
    cQuery += " D4F.D4F_TIPO   = '1' And "
    cQuery += " D4F.D_E_L_E_T_ = ' ' "   
    
Return cQuery
