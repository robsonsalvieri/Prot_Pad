#Include 'Totvs.ch'
#include 'tlpp-core.th'

Using namespace totvs.protheus.backoffice.stock.iterativecost.table.manager
Using Namespace totvs.protheus.backoffice.stock.iterativecost.table.processingtable
using namespace totvs.protheus.backoffice.stock.iterativecost.table.analyticalmovementtable
using namespace totvs.protheus.backoffice.stock.iterativecost.table.aglutinattedmovementtable
Using namespace totvs.protheus.backoffice.stock.iterativecost.table.balancebyproductionorder
using namespace totvs.protheus.backoffice.stock.iterativecost.table.productstructleveltable
Using namespace totvs.protheus.backoffice.stock.iterativecost.view.acquisitioncost
Using Namespace totvs.protheus.backoffice.stock.iterativecost.view.transferinvoice
Using Namespace totvs.protheus.backoffice.stock.iterativecost.view.acquisitioncost
Using Namespace totvs.protheus.backoffice.stock.iterativecost.processing.requestcost
Using Namespace totvs.protheus.backoffice.stock.iterativecost.table.parts.agglutinatedMovementPartsTable
Using Namespace totvs.protheus.backoffice.stock.iterativecost.table.parts.analyticalmovementtable
Using Namespace totvs.protheus.backoffice.stock.iterativecost.table.parts.processingtable

namespace totvs.protheus.backoffice.stock.iterativecost.processing.parts.requestcost

/*/{Protheus.doc} PartsRequestCost
    Classe responsável pela tabela que registra o custo em partes dos movimentos de requisição das transferências internas, entre filiais, desmontagem e liberação de CQ.

    @type Class
    @author Squad Entradas
    @since 12/08/2025
/*/
Class PartsRequestCost From TableManager

    public method New() 

    Public Method ProductionPartsRequestCost()
    Public Method BranchTransferPartsRequestCost()
    Public Method InternalTransferPartsRequestCost()

    Public Data cTabAnl As Character
    Public Data cTabAgl As Character
    Public Data cTabPro As Character
    Public Data cTabOp  As Character
    Public Data cTabNiv As Character
    Public Data cTabAnlCP As Character
    Public Data cTabAglCP As Character
    Public Data cTabProCP As Character
    Public Data cVwTrf  As Character
    Public Data cOutros As Character

    Public Data jVwAcquistCstParams       As Json
    Public Data cViewAcquisCst            As Character
    Public Data cCusFil                   As Character
    Public Data jParams                   As Json
    Public Data cFProc                    As Character

    Private Data oQryPR0Req As Object
    Private Data oQryTrFil  As Object
    Private Data oQryRE4    As Object

endclass

/*/{Protheus.doc} New
    Instância da classe

    @type method
    @author Squad Entradas
    @since 12/08/2025
/*/
Method New(cFilProc, aFil, jParams) Class PartsRequestCost

    ::cCusFil   := jParams["MV_CUSFIL"]
    ::jParams   := jParams
    ::cTabAnl   := AnalyticalMovementTable():TableName()
    ::cTabAgl   := AgglutinatedMovementTable():TableName()
    ::cTabPro   := ProcessingTable():TableName()
    ::cTabOp    := BalanceByProductionOrder():TableName()
    ::cTabNiv   := ProductStructLevelTable():TableName()
    ::cTabAnlCP := AnalyticalMovementPartsTable():TableName()
    ::cTabAglCP := AgglutinatedMovementPartsTable():TableName()
    ::cTabProCP := PartsProcessingTable():TableName()
    ::cVwTrf    := "VW_" + ViewTransferInvoice():GetViewID() + "_" + cEmpAnt
    ::cOutros   := Replicate("9", TamSX3("D4F_CODPAR")[1])
    ::cFProc    := cFilProc

    _Super:New(aFil)
Return


/*/{Protheus.doc} ProductionPartsRequestCost
    Atualiza o custo dos movimentos requisitados para a OP
    @author Squad Entradas
    @since 12/08/2025
    @type method
    /*/
Method ProductionPartsRequestCost(cFilAtu, cNivInv) Class PartsRequestCost
    Local cQuery    as character
    Local aMatch    := {} as array
    Local aUpdate   := {} as array
    Local aInsert   := {} as array
    Local aCpoDest  := {} as array
    Local nBind           as integer
    Local cOutro          as character
    Local cMoeda          as character
    Local cMoedaIns       as character
    Local nI              as integer
    
    If ::oQryPR0Req == Nil
        cOutro := Replicate('9', TamSX3('D4G_CODPAR')[1])
        cQuery := " Select "
        cQuery += " ANL.FILPROC     FILPROC, "
        cQuery += " ANL.FILIAL      FILIAL, "
        cQuery += " ANL.R_E_C_N_O_  RECPAI, "
        cQuery += " Coalesce(PROCP.CODPAR, '"+cOutro+"') CODPAR, "
        cQuery += " Coalesce(PROCP.MOEDA, ?)              MOEDA, "
        cQuery += " Case "
        cQuery += "    When ANL.CUSTOMEDIO = 'S' Then "
        cQuery += "         ANL.QUANT * Coalesce(PROCP.CMPROC, 0) "
        cQuery += "    Else Coalesce(ANLCP.CUSTO, 0) "
        cQuery += " End CSTRECP, "
        cQuery += " ANLCP.R_E_C_N_O_ MOVREC "
        cQuery += " From "+::cTabNiv+" NIV "
        cQuery += " Inner Join "+::cTabOp+" SLDOP On "
        cQuery += " SLDOP.FILPROC = NIV.FILPROC AND "
        If ::cCusFil != 'E'
            cQuery += " SLDOP.FILIAL  = NIV.FILIAL  AND "
        EndIf
        cQuery += " SLDOP.COD     = NIV.COD "
        cQuery += " Inner Join "+::cTabAnl+" ANL On "
        cQuery += " ANL.FILPROC = SLDOP.FILPROC AND "
        If ::cCusFil != 'E'
            cQuery += " ANL.FILIAL  = SLDOP.FILIAL  AND "
        EndIf
        cQuery += " ANL.OP      = SLDOP.OP And "
        cQuery += " ANL.CF Not In ('PR0','PR1') "
        cQuery += " Left Join "+::cTabPro+" PRO On "      
        cQuery +=     "    PRO.FILPROC = ANL.FILPROC "
        If ::cCusFil != 'E'
            cQuery +=     "AND PRO.FILIAL  = ANL.FILIAL "
        EndIf
        cQuery +=     "AND PRO.COD     = ANL.COD "
        If ::cCusFil == 'A'
            cQuery +=     "AND PRO.ARMAZEM = ANL.LOCARM "
        EndIf
        cQuery += " Left Join "+::cTabProCP+" PROCP On "      
        cQuery +=     "    PROCP.FILPROC = ANL.FILPROC "
        If ::cCusFil != 'E'
            cQuery +=     "AND PROCP.FILIAL  = ANL.FILIAL "
        EndIf
        cQuery +=     "AND PROCP.COD     = ANL.COD "
        If ::cCusFil == 'A'
            cQuery +=     "AND PROCP.ARMAZEM = ANL.LOCARM "
        EndIf
        cQuery += " Left Join "+::cTabAnlCP+" ANLCP On "
        cQuery += "      ANLCP.RECPAI = ANL.R_E_C_N_O_ "
        cQuery += " And (ANLCP.CODPAR = PROCP.CODPAR Or PROCP.CODPAR is Null)  "
        cQuery += " And (ANLCP.MOEDA  = PROCP.MOEDA  Or PROCP.MOEDA  is Null) "
        cQuery += " Where "
        cQuery += " NIV.FILPROC = ? And "
        cQuery += " NIV.FILIAL  = ? And "
        cQuery += " NIV.NIVINV  = ? And "
        cQuery += " (PROCP.MOEDA = ? Or PROCP.MOEDA is Null)"
        cQuery += " Group By "
        cQuery += " ANLCP.R_E_C_N_O_, "
        cQuery += " ANLCP.CODPAR, "
        cQuery += " ANLCP.MOEDA, "
        cQuery += " ANLCP.CUSTO, "
        cQuery += " PROCP.CMPROC, "
        cQuery += " ANL.QUANT, "
        cQuery += " ANL.CUSTOMEDIO, "
        cQuery += " ANL.R_E_C_N_O_, "
        cQuery += " ANL.FILPROC, "
        cQuery += " ANL.FILIAL, "
        cQuery += " PROCP.CODPAR, "
        cQuery += " PROCP.MOEDA  "

        ::oQryPR0Req := FWExecStatement():New(cQuery)
    EndIf

    For nI := 1 To Len(::jParams["moedas"])
        cMoeda := ::jParams["moedas"][nI]
        cMoedaIns := StrZero(Val(cMoeda), 2)

    	nBind := 1
        ::oQryPR0Req:SetString(nBind++, cMoedaIns) //Coalesce(PROCP.MOEDA, ?)
	    ::oQryPR0Req:SetString(nBind++, ::cFProc) //NIV.FILPROC
	    If ::cCusFil == 'E'
	        ::oQryPR0Req:SetString(nBind++, PadR(FWCompany(), FWSizeFilial()))
	    Else
	        ::oQryPR0Req:SetString(nBind++, cFilAtu) //NIV.FILIAL
	    EndIf
	    ::oQryPR0Req:SetString(nBind++, cNivInv) //NIV.NIVINV
        ::oQryPR0Req:SetString(nBind++, cMoedaIns) //PROCP.MOEDA

	    cQuery := ::oQryPR0Req:GetFixQuery()
	
	    //Filtro
	    ASize(aMatch, 0)
	    aMatch := {}
	    AAdd(aMatch, {"MOVREC", "R_E_C_N_O_"})
	    
	    //Expressões de update
	    ASize(aUpdate, 0)
	    aUpdate := {}
	    AAdd(aUpdate, "CSTRECP = Origem.CSTRECP")
	        
	    //Expressões de insert
	    ASize(aCpoDest, 0)
	    aCpoDest := {}
	    AAdd(aCpoDest, "FILPROC")
	    AAdd(aCpoDest, "FILIAL")
	    AAdd(aCpoDest, "RECPAI")
	    AAdd(aCpoDest, "CODPAR")
	    AAdd(aCpoDest, "MOEDA")
	    AAdd(aCpoDest, "CSTRECP")
	    
	    ASize(aInsert, 0)
	    aInsert := {}
	    AAdd(aInsert, "Origem.FILPROC")
	    AAdd(aInsert, "Origem.FILIAL")
	    AAdd(aInsert, "Origem.RECPAI")
	    AAdd(aInsert, "Origem.CODPAR")
	    AAdd(aInsert, "Origem.MOEDA")
	    AAdd(aInsert, "Origem.CSTRECP")
	        
	    cMerge := ::MergeStatement(::cTabAnlCP, cQuery, aMatch, aUpdate, aCpoDest, aInsert)

    	::RunQuery(cMerge)
    Next
Return 

/*/{Protheus.doc} BranchTransferPartsRequestCost
    Atualiza o custo dos movimentos de requisição de transferência entre filiais com custo em partes.
    @author Squad.Entradas
    @type method
    @since 03/06/2026
    @version 1.0
    @param cFilAtu, character, Filial atual
    @param nRecDestAGL, numeric, Recno do dest. na AGL
    @param dDtIni, date, Data inicial do período
    @param dDtFim, date, Data final do período
    @param cMoeda, character, códido da moeda com apenas 1 digito
    @param cMoedaStr, character, código da moeda com 2 digitos
    /*/
Method BranchTransferPartsRequestCost(cFilAtu as character, nRecDestAGL as numeric, dDtIni as date, dDtFim as date, cMoeda as character, cMoedaStr as character) Class PartsRequestCost
    Local cQuery as character
    Local aMatch as array
    Local aUpdate as array
    Local aBind as array
    Local nX as numeric

    cQuery  := ""
    aMatch  := {} 
    aUpdate := {}
    aBind   := {}
    nX      := 0

    If ::oQryTrFil == Nil
        cQuery := "SELECT "
        cQuery += " ORIG.R_E_C_N_O_ RECPAI, "
        cQuery += " " + ::cCoalesce + "(PROCP.CODPAR, '" + ::cOutros + "') CODPAR, "
        cQuery += " ? MOEDA , "
        cQuery += " CASE "
        cQuery += "     WHEN "
        cQuery += "         ORIG.CUSTOMEDIO = 'S' "
        cQuery += "     THEN "
        cQuery += "         " + ::cCoalesce + "((ORIG.QUANT * PROCP.CMPROC), ORIG.CUSTO"+cMoeda + ") "
        cQuery += "     ELSE "
        cQuery += "         ORIG.CUSTO"+cMoeda "
        cQuery += " END CUSTO "
        cQuery += "FROM "
        cQuery += " " + ::cTabAgl + " AGL " // TRL??SP.
        cQuery += "INNER JOIN "
        cQuery += " " + ::cTabAnl + " DEST " // TRG??SP.
        cQuery += " ON "
        cQuery += " DEST.FILPROC = AGL.FILPROC "
        If ::cCusFil # 'E'
            cQuery += " AND DEST.FILIAL = AGL.FILIAL "
        EndIf
        cQuery += " AND DEST.CHVAGL = AGL.CHVAGL "
        cQuery += "INNER JOIN "
        cQuery += " " + ::cVwTrf + " TRF " // VW_VWTRFNF_??.
        cQuery += " ON "
        cQuery += " TRF.RECDES = DEST.RECNO "
        cQuery += " AND TRF.D2_EMISSAO >= ? "
        cQuery += " AND TRF.D2_EMISSAO <= ? "
        cQuery += "INNER JOIN "
        cQuery += " " + ::cTabAnl + " ORIG " // TRG??SP.
        cQuery += " ON "
        cQuery += " ORIG.FILPROC = DEST.FILPROC "
        cQuery += " AND ORIG.FILIAL = TRF.FILORI "
        cQuery += " AND ORIG.ALIAS = ? "
        cQuery += " AND ORIG.FILTRF = ? "
        cQuery += " AND ORIG.RECNO = TRF.RECORI "
        cQuery += "INNER JOIN "
        cQuery += " " + ::cTabProCP + " PROCP " // TRHCP??SP.
        cQuery += " ON "
        cQuery += " PROCP.FILPROC = ORIG.FILPROC "
        If ::cCusFil == 'E'
            cQuery += " AND PROCP.FILIAL = ? "
        Else
            cQuery += " AND PROCP.FILIAL  = ORIG.FILIAL "
        EndIf
        cQuery += " AND PROCP.COD     = ORIG.COD "
        If ::cCusFil == 'A'
            cQuery += " AND PROCP.ARMAZEM = ORIG.LOCARM "
        EndIf
        cQuery += " AND PROCP.MOEDA   = ? "
        cQuery += "WHERE "
        cQuery += " AGL.R_E_C_N_O_ = ? "
        If ::cCusFil == 'E'
            cQuery += " AND AGL.FILIAL  = ? "
        EndIf

        ::oQryTrFil := FWExecStatement():New(cQuery)
    EndIf

    aAdd(aBind, {cMoedaStr, "C"}) // MOEDA
    aAdd(aBind, {dToS(dDtIni), "C"}) // TRF.D2_EMISSAO
    aAdd(aBind, {dToS(dDtFim), "C"}) // TRF.D2_EMISSAO
    aAdd(aBind, {"SD2", "C"}) // ORIG.ALIAS
    aAdd(aBind, {"1", "C"}) // ORIG.FILTRF
    If ::cCusFil == "E"
        aAdd(aBind, {FWCodEmp(), "C"}) // PROCP.FILIAL
    EndIf
    aAdd(aBind, {cMoedaStr, "C"}) // PROCP.MOEDA
    aAdd(aBind, {nRecDestAGL, "N"}) // AGL.R_E_C_N_O_
    If ::cCusFil == "E"
        aAdd(aBind, {FWCodEmp(), "C"}) // AGL.FILIAL
    EndIf

    For nX := 1 To Len(aBind)
        If aBind[nX][2] == "C"
            ::oQryTrFil:SetString(nX, aBind[nX][1])
        ElseIf aBind[nX][2] == "N"
            ::oQryTrFil:SetNumeric(nX, aBind[nX][1])
        EndIf
    Next nX

    cQuery := ::oQryTrFil:GetFixQuery()

    // Filtro.
    aSize(aMatch, 0)
    aMatch := {}
    aAdd(aMatch, {"RECPAI", "RECPAI"})
    aAdd(aMatch, {"CODPAR", "CODPAR"})
    aAdd(aMatch, {"MOEDA", "MOEDA"})

    // Expressões de update.
    aSize(aUpdate, 0)
    aUpdate := {}
    aAdd(aUpdate, "CSTRECP = ORIGEM.CUSTO")

    cMerge := ::MergeStatement(::cTabAnlCP, cQuery, aMatch, aUpdate) // Atualiza a tabela TRGCP??SP.

    ::RunQuery(cMerge)

Return

/*/{Protheus.doc} InternalTransferPartsRequestCost
    Atualiza o custo dos movimentos de requisição de transferência interna com custo em partes.
    @author Squad Entradas
    @since 07/01/2026
    @type method
    @param nRecDevAGL, numeric, Recno do dest. na AGL
    @param cMoedaStr, character, código da moeda com 2 digitos
    /*/
Method InternalTransferPartsRequestCost(nRecDevAGL as numeric, cMoedaStr as character) Class PartsRequestCost
    Local cQuery as character
    Local cUpdate as character
    Local cMatchFilter as character
    Local cCTE as character
    Local nA as numeric

    nA := 1

    If ::oQryRE4 == Nil
        cQuery := "Select "
        cQuery += "PROCP.CODPAR CODPAR"
        cQuery += ",PROCP.MOEDA MOEDA"
        cQuery += ",(REQ.QUANT * PROCP.CMPROC) CUSTO"
        cQuery += ",REQ.R_E_C_N_O_ MOVREC"
        cQuery += " From " + ::cTabAgl + " AGL " // TRL??SP.
        cQuery += " Inner Join " + ::cTabAnl + " DEST " // TRG??SP.
        cQuery += "     On  DEST.FILPROC = AGL.FILPROC "
        If ::cCusFil # 'E'
            cQuery += "     And DEST.FILIAL = AGL.FILIAL "
        EndIf
        cQuery += "     And DEST.CHVAGL = AGL.CHVAGL "
        cQuery += " Inner Join " + ::cTabAnl + " REQ " // TRG??SP.
	    cQuery += "     On  REQ.FILPROC = DEST.FILPROC "
        cQuery += "     And REQ.FILIAL  = DEST.FILIAL "
        cQuery += "     And REQ.CF      = ? "
        cQuery += "     And REQ.SEQ     = DEST.SEQ "
        cQuery += " Inner Join " + ::cTabProCP + " PROCP " // TRHCP??SP.
        cQuery += "     On  PROCP.FILPROC = AGL.FILPROC "
        If ::cCusFil == 'E'
            cQuery += "     And PROCP.FILIAL = ? "
        Else
            cQuery += "     And PROCP.FILIAL  = AGL.FILIAL "
        EndIf
        cQuery += "     And PROCP.COD     = AGL.CODORI "
        If ::cCusFil == 'A'
            cQuery += "     And PROCP.ARMAZEM = AGL.LOCORI "
        EndIf
        cQuery += "     And PROCP.MOEDA   = ? "
        cQuery += "Where AGL.R_E_C_N_O_ = ? "
        If ::cCusFil == 'E'
            cQuery += "     And AGL.FILIAL  = ? "
        EndIf

        ::oQryRE4 := FWExecStatement():New(cQuery)
    EndIf

    ::oQryRE4:SetString(nA++, 'RE4') // REQ.CF
    If ::cCusFil == "E"
        ::oQryRE4:SetString(nA++, FWCodEmp()) // PROCP.FILIAL
    EndIf
    ::oQryRE4:SetString(nA++, cMoedaStr) // PROCP.MOEDA
    ::oQryRE4:SetNumeric(nA++, nRecDevAGL) // AGL.R_E_C_N_O_
    If ::cCusFil == "E"
        ::oQryRE4:SetString(nA++, FWCodEmp()) // AGL.FILIAL
    EndIf

    cQuery := ::oQryRE4:GetFixQuery()

    // Filtro.
    cMatchFilter := ::cTabAnlCP+".RECPAI = TEMPTABLE.MOVREC AND "
    cMatchFilter += ::cTabAnlCP+".CODPAR = TEMPTABLE.CODPAR AND "
    cMatchFilter += ::cTabAnlCP+".MOEDA = TEMPTABLE.MOEDA "
    
    // Expressões de update.
    cUpdate := "CSTRECP = TEMPTABLE.CUSTO"
    
    cCTE := ::buildCteStatement(::cTabAnlCP, cUpdate, cMatchFilter, cQuery) // TRGCP??SP.
    
    ::RunQuery(cCTE)
Return
