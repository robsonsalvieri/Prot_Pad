Namespace totvs.protheus.backoffice.stock.iterativecost.view.transfersupplier

/*/{Protheus.doc} ViewTransferSupplier
    View SA2xSM0 - Fornecedor da transferência
    @author g.moreira
    @since 24/07/2024
    @version version
    /*/
Class ViewTransferSupplier //Implements IterativeCostView
    Public Method New()

    Static Method GetVersion()
    Static Method GetViewID()
    Public Method GetParams()
    Public Method GetQuery()
EndClass

/*/{Protheus.doc} New
    Instância
    @author g.moreira
    @since 22/07/2024
    /*/
Method New() Class ViewTransferSupplier
Return Self

/*/{Protheus.doc} GetVersion
    Versão da View
    @author g.moreira
    @since 22/07/2024
    /*/
Method GetVersion() Class ViewTransferSupplier
Return "0001"

/*/{Protheus.doc} GetViewID
    ID da View
    Não alterar após entrar em produção
    @author g.moreira
    @since 22/07/2024
    /*/
Method GetViewID() Class ViewTransferSupplier
Return "VWSA2M0"

/*/{Protheus.doc} GetParams
    Retorna Json contendo os codeblock executáveis para obter os parâmetros da View
    @author g.moreira
    @since 22/07/2024
    /*/
Method GetParams() Class ViewTransferSupplier
    Local jExec := JsonObject():New() As Json

    jExec["MV_FILTRF"]  := {|| UsaFilTrf()}
    jExec["SizeFilial"] := {|| FWSizeFilial()}
    jExec["SizeInscr"]  := {|| TamSX3('A2_INSCR')[1]}
Return jExec

/*/{Protheus.doc} GetQuery
    Retorna a query estruturada da instalação da View com base nos parâmetros informados
    @author g.moreira
    @since 22/07/2024
    /*/
Method GetQuery(cEmpAtu, jParam) Class ViewTransferSupplier
    Local cQuery  As Character
    Local cIDView As Character
    Local cNomFis As Character
    Local cDbType As Character
    Local cVersao As Character
    Local cSubs   As Character
    Local cSize   As Character
    Local cSizeIns As Character
    
	cIDView := ::GetViewID()
    cNomFis := "VW_"+cIDView+"_"+cEmpAtu
    cDbType := TCGetDB()
    cVersao := ::GetVersion()
    cSize   := cValToChar(jParam["SizeFilial"])
    cSizeIns  := cValToChar(jParam["SizeInscr"])

    cQuery := " Create View "+cNomFis+" As "
    cQuery += " Select "
    If cDbType $ 'POSTGRES'
        cQuery += " Char(4) "
    EndIf
    cQuery += "'"+cVersao+"' ASSINATURA, "
    If !jParam["MV_FILTRF"]
        cSubs := " Cast( "
        If cDbType $ "ORACLE/POSTGRES"
            cSubs += "SubStr(M0_CODFIL, 1, "+cSize+")"
        Else
            cSubs += "SubString(M0_CODFIL, 1, "+cSize+")"
        EndIf
        cSubs += " As Char("+cSize+"))"
        cQuery += " A2_FILIAL, "+cSubs+" A2_FILTRF, A2_COD, A2_LOJA, A2_CGC, A2_INSCR "
        cQuery += " From SYS_COMPANY SM0 "
        cQuery += " Inner Join "+RetSQLName('SA2')+" SA2 "
        cQuery += " On "
        cQuery += " A2_CGC = M0_CGC "
        //Se duas filiais tem o mesmo CNPJ, faz o vínculo pela inscrição estadual
        cQuery += " And A2_INSCR = (Case "
		cQuery += " When (Select Count(M0_CODFIL) From SYS_COMPANY SM0B "
		cQuery += " Where SM0B.M0_CODIGO = '"+cEmpAnt+"' And   "
		cQuery += " SM0B.M0_CGC = SM0.M0_CGC ) > 1 "
		cQuery += " 	Then Cast(SM0.M0_INSC As Char("+cSizeIns+")) "
		cQuery += " Else "
		cQuery += " 	A2_INSCR "
	    cQuery += " End) "
        cQuery += " And SA2.D_E_L_E_T_ = ' ' "
        cQuery += " Where M0_CODIGO = '"+cEmpAnt+"' "
        cQuery += "   And SM0.D_E_L_E_T_ = ' ' "
    Else
        cQuery += " A2_FILIAL, A2_FILTRF, A2_COD, A2_LOJA, A2_CGC, A2_INSCR "
        cQuery += " From "+RetSQLName('SA2')+" SA2 "
        cQuery += " Where A2_FILTRF <> ' ' "
        cQuery += "   And D_E_L_E_T_ = ' ' "
    EndIf
Return cQuery
