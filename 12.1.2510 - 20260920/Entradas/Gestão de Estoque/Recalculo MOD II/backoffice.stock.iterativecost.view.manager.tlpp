/*/{Protheus.doc} ViewManager
    Classe para gestão das Views instaladas na tabela D4D
    @author Squad Entradas
    @Type Class
    @since 22/07/2024
    @version version
    /*/
Class ViewManager
    Public Data aFiliais As Array
    Public Data oQuery   As Object
    Public Data aViews   As Array
    Public Data lOracle  As Logical
    Public Data lPostgres As Logical
    Public Data lMSSQL    As Logical
    Public Data cErrorSQL As Character

    Public Method New()
    Public Method Install()
    Public Method InstView()
    Public Method DropView()
    Public Method ParamIsEqual()
    Public Method RunQuery()

EndClass

/*/{Protheus.doc} New
    Instância da classe
    @author Squad Entradas
    @type Method
    @since 22/07/2024
    @version 1.0
    @param aFiliais, Array, Array de filiais
    @return self, object, Instância da classe
    /*/
Method New(aFiliais As Array) Class ViewManager
    Local cQuery := "" As Character
    Local aViews := {} As Array

    ::lOracle := TCGetDB() $ 'ORACLE'
    ::lPostgres := TCGetDB() $ 'POSTGRES'
    ::lMSSQL    := TCGetDB() $ 'MSSQL'
 
    cQuery := " Select "
    If ::lMSSQL
        cQuery += " Top 1 "
    EndIf
    cQuery += " ASSINATURA From ? "
    If ::lOracle
        cQuery += " Where ROWNUM = 1 "
    EndIf
    If ::lPostgres
        cQuery += " Limit 1 "
    EndIf

    //Indicar a ordenação de instalação das views, de forma que views que dependem
    //de outras sejam adicionadas depois
    AAdd(aViews, ViewFullInitialStockBalance():New())
    AAdd(aViews, ViewInitialStockBalance():New())
    AAdd(aViews, ViewPartsInitialStockBalance():New())
    AAdd(aViews, ViewAcquisitionCost():New())
    AAdd(aViews, ViewPartsAcquisitionCost():New())
    AAdd(aViews, ViewInflowInvoiceNumberedItem():New())
    AAdd(aViews, ViewInvoiceSalesNumberedItem():New())
    AAdd(aViews, ViewTransferSupplier():New())
    AAdd(aViews, ViewTransferInvoice():New())
    AAdd(aViews, ViewLaborProduct():New())
    AAdd(aViews, ViewLaborRequests():New())
    AAdd(aViews, ViewLaborProductParts():New())
    AAdd(aViews, ViewLaborRequestsParts():New())

    AAdd(aViews, ViewInternalTransactionsParts():New())
    AAdd(aViews, ViewLastCloseByProduct():New())
    AAdd(aViews, ViewIncomingInvoiceItemsParts():New())
    AAdd(aViews, ViewOutgoingInvoiceItemsParts():New())
    AAdd(aViews, ViewComposeBalanceByProduct():New())

    ::oQuery   := FWExecStatement():New( cQuery )
    ::aFiliais := aFiliais
    ::aViews   := aViews
Return Self

/*/{Protheus.doc} Install
    Realiza a instalação da View, bem como a validação dos parâmetros
    @author Squad Entradas
    @since 22/07/2024
    @version 1.0
    @type Method
    @param cIDView, Character, ID da View
    @param bView, CodeBlock, Chamada da função que retorna query da View
    @param cVersao, Character,  Versão da View
    @param jExec, Json, Parâmetros da View, em bloco de código
    @return lRet
    /*/
Method Install() Class ViewManager
    Local nView

    If FnVldCMod2()
        //Dropa as views conforme necessidade
        //Dropa de trás para frente para evitar erros de dependência
        For nView := Len(::aViews) To 1 Step -1
            ::DropView(::aViews[nView])
        Next nView

        //Verifica e instala todas as views
        For nView := 1 To Len(::aViews)
            ::InstView(::aViews[nView])
        Next nView
    EndIf

Return

/*/{Protheus.doc} InstView
    Realiza a instalação da View, bem como a validação dos parâmetros
    @author Squad Entradas
    @since 22/07/2024
    @type Method
    @version 1.0
    @param cIDView, Character, ID da View
    @param bView, CodeBlock, Chamada da função que retorna query da View
    @param cVersao, Character,  Versão da View
    @param jExec, Json, Parâmetros da View, em bloco de código
    @return lRet
    /*/
Method InstView(oView) Class ViewManager
    Local aListParams := {}
    Local jParam      := JsonObject():New()
    Local lInstall    := .F.
    Local cIdReal     := ""
    Local cQuery      := ""
    Local nPar        := 0
    Local cPar        := 0
    Local cIDView     := oView:GetViewID()
    Local jExec       := oView:GetParams()

    D4D->(DBSetOrder(1)) //D4D_FILIAL+D4D_IDVIEW
    If D4D->(DbSeek(FWXFilial('D4D')+cIDView))
        cIdReal := AllTrim(D4D->D4D_VWNAME)
        If !TCIsView(cIdReal)
            lInstall := .T.
        EndIf
    Else
        lInstall := .T.
    EndIf

    If lInstall
        jParam:FromJson("{}")
        aListParams := jExec:GetNames()
        For nPar := 1 To Len(aListParams)  
            cPar := aListParams[nPar]
            jParam[cPar] := Eval(jExec[cPar], Self)
        Next nPar

        cQuery := oView:GetQuery(cEmpAnt, jParam)
        ::RunQuery(cQuery)

        If D4D->(DbSeek(FWXFilial('D4D')+cIDView))
            RecLock('D4D', .F.)
        Else
            RecLock('D4D', .T.)
            D4D->D4D_FILIAL := FWXFilial('D4D')
            D4D->D4D_IDVIEW := cIDView
        EndIf
        D4D->D4D_VWNAME := "VW_"+cIDView+"_"+cEmpAnt
        D4D->D4D_PARAM  := jParam:ToJson()
        D4D->(MsUnlock())
    EndIf

Return

/*/{Protheus.doc} DropView
    Verifica a necessidade de dropar a View e executa o drop
    @author Squad Entradas
    @since 22/07/2024
    @type Method
    @version 1.0
    @param aFiliais, Array, Array de filiais
    @return self, object, Instância da classe
    /*/
Method DropView(oView As Object) Class ViewManager
    Local cIDView     := oView:GetViewID()     As Character
    Local cVersao     := oView:GetVersion()    As Character
    Local jExec       := oView:GetParams()     As Json
    Local cIdReal     := ""                    As Character
    Local aListParams := {}                    As Array
    Local jParam      := JsonObject():New()    As Json
    Local cAssinatura := ""                    As Character
    Local nPar        := 0                     As Integer
    Local cPar        := ""                    As Character
    Local lDrop       := .F.                   As Logical
    Local cQuery      := ""                    As Character

    D4D->(DBSetOrder(1)) //D4D_FILIAL+D4D_IDVIEW
    If D4D->(DbSeek(FWXFilial('D4D')+cIDView))
        cIdReal := AllTrim(D4D->D4D_VWNAME)
        If TCIsView(cIdReal)
            ::oQuery:SetUnsafe(1, cIdReal)
            
            cQuery := ::oQuery:GetFixQuery()
            //Tenta executar a query
            If TCSQLExec(cQuery) >= 0
                cAssinatura := AllTrim(::oQuery:ExecScalar("ASSINATURA"))
            Else
                //Podem ocorrer erros de associação quando uma view depende de outra 
                //que foi dropada
                cAssinatura := ""
            EndIf
            lDrop := cAssinatura != cVersao
            If !lDrop
                jParam:FromJson(D4D->D4D_PARAM)
                aListParams := jParam:GetNames()
                aExec       := jExec:GetNames()

                lDrop := Len(aExec) != Len(aListParams)

                If !lDrop
                    For nPar := 1 To Len(aListParams)
                        If !jExec:HasProperty(aListParams[nPar])
                            lDrop := .T.
                            Exit
                        EndIf
                        cPar := aListParams[nPar]
                        If jParam[cPar] != Eval(jExec[cPar], Self)
                            lDrop := .T.
                            Exit
                        EndIf
                    Next nPar
                EndIf
            EndIf
        EndIf
    EndIf

    If lDrop
        cQuery := "Drop View "+cIdReal
        If TCGetDB() $ 'POSTGRES'
            cQuery += " Cascade "
        EndIf
        ::RunQuery(cQuery)
    EndIf

Return

/*/{Protheus.doc} ParamIgual
    Verifica se o conteúdo de um parâmetro SX6 é igual em todas as filiais marcadas
    @type Method
    @author Squad Entradas
    @since 04/07/2024
    @version 1
    @param aFiliais, Array, Array de filiais
    @param cMV, Character, Nome do parâmetro
    @param uDefault, Undefined, Valor default
    @return lIgual, Logical, Se é igual ou não
    @example
    (examples)
    @see (links_or_references)
/*/
Method ParamIsEqual(cMV, uDefault) Class ViewManager
    Local lIgual  := .T.
    Local uMV     := ''
    Local cFilBkp := cFilAnt
    Local nFil    := 0
    Local bGetMV  := {|| GetMV(cMV, .F., uDefault)}

    cFilAnt := ::aFiliais[1]
    uMV := GetMV(cMV, .F., uDefault)
    For nFil := 2 To Len(::aFiliais)
        cFilAnt := ::aFiliais[nFil]
        
        If uMV != Eval(bGetMV)
            lIgual := .F.
            Exit
        EndIf
    Next nFil

    cFilAnt := cFilBkp
Return lIgual

/*/{Protheus.doc} RunQuery
    Executa TCSQLExec Encapsulado
    @type Method
    @author Squad Entradas
    @since 18/09/2024
    /*/
Method RunQuery(cQuery)  Class ViewManager
    Local lRet := .T.

    If TcSqlExec(cQuery) < 0
        ::cErrorSQL := TCSQLError()
        lRet := .F.
        UserException("ViewManagerSQLError: "+::cErrorSQL)
    EndIf
Return lRet
