/*/{Protheus.doc} IterativeCostView
Interface das classes das views
/*/
/*
Interface IterativeCostView
    Public Method GetVersion()
    Public Method GetViewID()
    Public Method GetParams()
    Public Method GetQuery()
EndInterface
