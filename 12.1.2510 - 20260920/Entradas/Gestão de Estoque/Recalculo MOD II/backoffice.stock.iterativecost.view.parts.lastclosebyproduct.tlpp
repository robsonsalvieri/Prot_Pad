/*/{Protheus.doc} GetParams
    Retorna Json contendo os codeblock executáveis para obter os parâmetros da View
    @author Leonardo Kichitaro
    @Type Method
    @since 28/10/2025
    /*/
Method GetParams() Class ViewLastCloseByProduct
    Local jExec := JsonObject():New() As Json

    jExec["TAM_PARTE"]    := {|| TamSX3("D4I_PARTE")[1]}
Return jExec

/*/{Protheus.doc} GetQuery
    Retorna a query estruturada da instalação da View com base nos parâmetros informados
    @author Leonardo Kichitaro
    @Type Method
    @since 28/10/2025
    /*/
Method GetQuery(cEmpAtu As Character, jParam As Json) Class ViewLastCloseByProduct
    Local cQuery  As Character
    Local cIDView As Character
    Local cNomFis As Character
    Local cDbType As Character
    Local cVersao As Character
    Local cOutros As Character
    Local cTamPar As Character

	cIDView := ::GetViewID()
    cNomFis := "VW_"+cIDView+"_"+cEmpAtu
    cDbType := TCGetDB()
    cVersao := ::GetVersion()
    cOutros := Replicate('9', jParam["TAM_PARTE"])
    cTamPar := cValToChar(jParam["TAM_PARTE"])

    cQuery := " Create View "+cNomFis+" As "
    cQuery += " Select "
    If cDbType $ 'POSTGRES'
        cQuery += " Char(4) "
    EndIf
    cQuery += "'"+cVersao+"' ASSINATURA, "
    cQuery += " SB9.B9_FILIAL, SB9.B9_COD, SB9.B9_LOCAL, SB9.B9_DATA,  "
    cQuery += " SB9.B9_QINI, SB9.B9_QISEGUM, "
    cQuery += " SB9.B9_VINI1, SB9.B9_VINI2, SB9.B9_VINI3,  "
    cQuery += " SB9.B9_VINI4, SB9.B9_VINI5, "
	cQuery += " SB9.B9_CM1, SB9.B9_CM2, SB9.B9_CM3, SB9.B9_CM4, SB9.B9_CM5, "
    cQuery += " Coalesce(D4I.D4I_PARTE, Cast('"+cOutros+"' As Char("+cTamPar+"))) D4I_PARTE, "
    cQuery += " D4I.D4I_REVISA, "
    cQuery += " D4I.D4I_MOEDA, D4I.D4I_UNITAR, "
    cQuery += " D4I.D4I_TOTAL "
    cQuery += " From "+RetSQLName('SB9')+" SB9 "
    cQuery += " Left Join "+RetSQLName('D4I')+" D4I On "
    cQuery += " D4I.D4I_FILIAL = SB9.B9_FILIAL And "
    cQuery += " D4I.D4I_COD    = SB9.B9_COD    And "
    cQuery += " D4I.D4I_LOCAL  = SB9.B9_LOCAL  And "
    cQuery += " D4I.D4I_DATA   = SB9.B9_DATA   And "
    cQuery += " D4I.D_E_L_E_T_ = ' ' "
    cQuery += " Where SB9.D_E_L_E_T_ = ' ' " 

Return cQuery
