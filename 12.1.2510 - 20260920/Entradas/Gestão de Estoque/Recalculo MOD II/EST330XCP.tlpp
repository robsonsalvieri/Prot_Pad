#include 'tlpp-core.th'
#Include 'Totvs.ch'
#Include 'RWMake.ch'

Static __oQuerySB9 := Nil
Static __aQueryCP  := {}

using namespace totvs.framework.treports.integratedprovider
using namespace totvs.protheus.backoffice.stock.iterativecost.view.manager
using Namespace totvs.protheus.backoffice.stock.iterativecost.view.parts.lastclosebyproduct
using Namespace totvs.protheus.backoffice.stock.iterativecost.view.parts.internaltransactions
using Namespace totvs.protheus.backoffice.stock.iterativecost.view.parts.incominginvoiceitems
using Namespace totvs.protheus.backoffice.stock.iterativecost.view.parts.outgoinginvoiceitems

/*/{Protheus.doc} Mod2CalcCP
    Realiza a busca do custo em partes por produto

    @param cCod character       : Código do Produto
    @param cLocal character     : Armazém do Produto
    @param dData date           : Data de referência para cálculo do saldo do produto quando utiliza saldo por movimento
    @param cRoteiro character   : Código do roteiro - Caso queria apenas a informação do roteiro informado
    @param cParte character     : Codigo da parte - Caso queria apenas a informação da parte informada

    @return: Array com valores do custo em partes do produto

    @type  Function
    @author Leonardo Kichitaro
    @since 28/10/2025
/*/
Function Mod2CalcCP(cCod as character, cLocal as character, dData as date, cParte as character, cMoedaCP as character)

	Local oViews				            as object
    Local oQueryCP                          as object
    Local oViewCpLastclosebyproduct         as object
    Local oViewCpIncominginvoiceitems       as object
    Local oViewCpInternaltransactions       as object
    Local oViewCpOutgoinginvoiceitems       as object

    Local cQuery                            as character
    Local cAliasTmp                         as character
    Local cNameViewSB9CPCLOSE               as character
    Local cNameViewSD1CP                    as character
    Local cNameViewD3SDPRCP                 as character
    Local cNameViewD2SDITCP                 as character

    Local cMV_MOEDACM                       as character
    Local aMoedas                           as array
    Local nX                                as numeric
    Local nY                                := 1 as numeric
    Local dDtVai                            as date
    Local aRetCustCP                        as array
    Local cOutros                           as character
    Local cTamPar                           as character
    Local cRevisa                           as character
    Local cTitulo                           as character
    Local cTamTit                           as character
    Local cTamRev                           as character
    Local cMoeda                            as character
    Local cTamMoe                           as character
    Local lHasRec                           as logical

    Default dData   := dDataBase

    cOutros := Replicate('9', TamSX3('D4I_PARTE')[1])
    cTamPar := cValToChar(TamSX3('D4I_PARTE')[1])
    cTitulo := Replicate(' ', TamSX3('D4F_TITULO')[1])
    cTamTit := cValToChar(TamSX3('D4F_TITULO')[1])
    cRevisa := Replicate(' ', TamSX3('D4I_REVISA')[1])
    cTamRev := cValToChar(TamSX3('D4I_REVISA')[1])
    cMoeda  := Replicate(' ', TamSX3('D4I_MOEDA')[1])
    cTamMoe := cValToChar(TamSX3('D4I_MOEDA')[1])

    dDtVai := Ctod( "  /  /    ")
    dData := If(Empty(dData),Ctod( "01/01/80","ddmmyy" ),dData)

    aRetCustCP := {}

    aMoedas := {}
    aAdd(aMoedas, '01')

    cMV_MOEDACM := SuperGetMv('MV_MOEDACM',.F.,"2345")

    If !Empty(cMV_MOEDACM)
        For nX := 2 to 5
            If !(Str(nX,1,0) $ cMV_MOEDACM)
                Loop
            EndIf
            aAdd(aMoedas, StrZero(nX,2))
        Next nX
    EndIf

	oViews := ViewManager():New({cFilAnt})
	oViews:Install()

    oViewCpLastclosebyproduct       := ViewLastCloseByProduct():New({cFilAnt})
    oViewCpIncominginvoiceitems     := ViewIncomingInvoiceItemsParts():New({cFilAnt})
    oViewCpInternaltransactions     := ViewInternalTransactionsParts():New({cFilAnt})
    oViewCpOutgoinginvoiceitems     := ViewOutgoingInvoiceItemsParts():New({cFilAnt})

    cNameViewSB9CPCLOSE     := "VW_" + oViewCpLastclosebyproduct:GetViewID() + "_" + cEmpAnt
	cNameViewSD1CP          := "VW_" + oViewCpIncominginvoiceitems:GetViewID() + "_" + cEmpAnt
    cNameViewD3SDPRCP       := "VW_" + oViewCpInternaltransactions:GetViewID() + "_" + cEmpAnt
	cNameViewD2SDITCP       := "VW_" + oViewCpOutgoinginvoiceitems:GetViewID() + "_" + cEmpAnt

	// Instala views
    If TCIsView(cNameViewSB9CPCLOSE) .And. TCIsView(cNameViewSD1CP) .And. TCIsView(cNameViewD3SDPRCP) .And. TCIsView(cNameViewD2SDITCP)
		//Montagem da query para execução
        If __oQuerySB9 == Nil
            //Query do último fechamento
            cQuery := "SELECT * "
            cQuery += " FROM " + cNameViewSB9CPCLOSE + " SB9 "
            cQuery += " WHERE SB9.B9_FILIAL = ? "
            cQuery += " AND SB9.B9_COD = ? "
            cQuery += " AND SB9.B9_LOCAL = ? "
            cQuery += " ORDER BY B9_FILIAL, B9_COD, B9_LOCAL, B9_DATA "

            cQuery := ChangeQuery(cQuery)

            __oQuerySB9 := FwExecStatement():New(cQuery)
        EndIf
        //Binding
        __oQuerySB9:SetString(1, FWxFilial("SB9"))
        __oQuerySB9:SetString(2, cCod)
        __oQuerySB9:SetString(3, cLocal)

        cAliasTmp := __oQuerySB9:OpenAlias()
        lHasRec := .F.

        (cAliasTmp)->(dbGoTop())
        While !(cAliasTmp)->(Eof())
			If StoD((cAliasTmp)->B9_DATA) >= dData .and. lHasRec
				Exit
			Else
				dDtVai := StoD((cAliasTmp)->B9_DATA)
                lHasRec := .T.
			EndIf

            (cAliasTmp)->(DBSkip())
        EndDo
        If Empty(dDtVai)
            dDtVai := Ctod("  /  /    ")
        EndIf
        (cAliasTmp)->( DBCloseArea() )

        //Query para compor saldo do custo em partes atual por produto/armazém/parte/moeda quando existe fechamento dentro da data de referencia informada
        cQuery := " Select "
        cQuery += " D4I.B9_FILIAL, D4I.B9_COD, D4I.B9_LOCAL, D4I.B9_DATA,  "
        cQuery += " D4I.B9_QINI, D4I.B9_QISEGUM, "
        cQuery += " D4I.B9_VINI1, D4I.B9_VINI2, D4I.B9_VINI3,  "
        cQuery += " D4I.B9_VINI4, D4I.B9_VINI5, "
        cQuery += " D4I.B9_CM1, D4I.B9_CM2, D4I.B9_CM3, D4I.B9_CM4, D4I.B9_CM5, "
        cQuery += " Coalesce(D4I.D4I_PARTE, Cast('"+cOutros+"' As Char("+cTamPar+"))) D4I_PARTE, "
        cQuery += " Coalesce(D4F.D4F_TITULO, Cast('"+cTitulo+"' As Char("+cTamTit+"))) D4F_TITULO, "
        cQuery += " Coalesce(D4I.D4I_REVISA, Cast('"+cRevisa+"' As Char("+cTamRev+"))) D4I_REVISA, "
        cQuery += " Coalesce(D4I.D4I_MOEDA, Cast('"+cMoeda+"' As Char("+cTamMoe+"))) D4I_MOEDA, "
        cQuery += " Coalesce(D4I.D4I_UNITAR, 0) D4I_UNITAR, "
        cQuery += " COALESCE(D4I.D4I_TOTAL, 0) + COALESCE(D4L.TOTAL_L, 0) - COALESCE(D4M.TOTAL_M, 0) + COALESCE(D4N.TOTAL_N, 0) AS D4I_TOTAL "
        cQuery += " From "+cNameViewSB9CPCLOSE+" D4I "

        //Left Join com SD1
        cQuery += " Left Join "
        cQuery += "   (SELECT D1_FILIAL, "
        cQuery += "             D1_COD, "
        cQuery += "             D1_LOCAL, "
        cQuery += "             D4L_REVISA, "
        cQuery += "             D4L_PARTE, "
        cQuery += "             D4L_MOEDA, "
        cQuery += "             SUM(D4L_TOTAL) AS TOTAL_L "
        cQuery += "      FROM "+cNameViewSD1CP+" "
        cQuery += "   WHERE D1_DTDIGIT >= ? AND D1_DTDIGIT < ? "
        cQuery += "   GROUP BY D1_FILIAL, D1_COD, D1_LOCAL, D4L_REVISA, D4L_PARTE, D4L_MOEDA) D4L On "
        cQuery += " D4L.D1_FILIAL  = D4I.B9_FILIAL And "
        cQuery += " D4L.D1_COD     = D4I.B9_COD    And "
        cQuery += " D4L.D1_LOCAL   = D4I.B9_LOCAL  And "
        cQuery += " D4L.D4L_REVISA = D4I.D4I_REVISA And "
        cQuery += " D4L.D4L_PARTE  = D4I.D4I_PARTE  And "
        cQuery += " D4L.D4L_MOEDA  = D4I.D4I_MOEDA "

        //Left Join com SD2
        cQuery += " Left Join "
        cQuery += "  (SELECT D2_FILIAL, "
        cQuery += "          D2_COD, "
        cQuery += "          D2_LOCAL, "
        cQuery += "          D4M_REVISA, "
        cQuery += "          D4M_PARTE, "
        cQuery += "          D4M_MOEDA, "
        cQuery += "          SUM(D4M_TOTAL) AS TOTAL_M "
        cQuery += "   FROM "+cNameViewD2SDITCP+" "
        cQuery += "   WHERE D2_EMISSAO >= ? AND D2_EMISSAO < ? "
        cQuery += "   GROUP BY D2_FILIAL, D2_COD, D2_LOCAL, D4M_REVISA, D4M_PARTE,D4M_MOEDA) D4M ON "
        cQuery += " D4M.D2_FILIAL  = D4I.B9_FILIAL And "
        cQuery += " D4M.D2_COD     = D4I.B9_COD    And "
        cQuery += " D4M.D2_LOCAL   = D4I.B9_LOCAL  And "
        cQuery += " D4M.D4M_REVISA = D4I.D4I_REVISA And "
        cQuery += " D4M.D4M_PARTE  = D4I.D4I_PARTE  And "
        cQuery += " D4M.D4M_MOEDA  = D4I.D4I_MOEDA "

        //Left Join com SD3
        cQuery += " Left Join "
        cQuery += "  (SELECT D3_FILIAL, "
        cQuery += "          D3_COD, "
        cQuery += "          D3_LOCAL, "
        cQuery += "          D4N_REVISA, "
        cQuery += "          D4N_PARTE, "
        cQuery += "          D4N_MOEDA, "
        cQuery += "          SUM(CASE "
        cQuery += "                  WHEN D3_TM <= '500' THEN D4N_TOTAL "
        cQuery += "                  ELSE -D4N_TOTAL "
        cQuery += "              END) AS TOTAL_N "
        cQuery += "   FROM "+cNameViewD3SDPRCP+" "
        cQuery += "   WHERE D3_EMISSAO >= ? AND D3_EMISSAO < ? "
        cQuery += "   GROUP BY D3_FILIAL, D3_COD, D3_LOCAL, D4N_REVISA, D4N_PARTE, D4N_MOEDA) D4N ON "
        cQuery += " D4N.D3_FILIAL  = D4I.B9_FILIAL And "
        cQuery += " D4N.D3_COD     = D4I.B9_COD    And "
        cQuery += " D4N.D3_LOCAL   = D4I.B9_LOCAL  And "
        cQuery += " D4N.D4N_REVISA = D4I.D4I_REVISA And "
        cQuery += " D4N.D4N_PARTE  = D4I.D4I_PARTE  And "
        cQuery += " D4N.D4N_MOEDA  = D4I.D4I_MOEDA "

        //Left Join com D4F
        cQuery += " Left Join "+RetSQLName('D4F')+" D4F On "
        cQuery += " D4F.D4F_FILIAL = ? And " //D4F é compartilhada em todos os níveis
        cQuery += " D4F.D4F_REVIS  = D4I.D4I_REVISA And "
        cQuery += " D4F.D4F_CODPAR = D4I.D4I_PARTE And "
        cQuery += " D4F.D_E_L_E_T_ = ? "

        cQuery += " WHERE D4I.B9_FILIAL = ? And " 
        cQuery += " D4I.B9_COD = ? And " 
        cQuery += " D4I.B9_LOCAL = ? And " 
        cQuery += " D4I.B9_DATA = ? "
        If !Empty(cParte)
            cQuery += " And D4I.D4I_PARTE = ? "
        Endif
        If !Empty(cMoedaCP)
            cQuery += " And D4I.D4I_MOEDA = ? "
        Endif
        cQuery += " ORDER BY B9_FILIAL, B9_COD, B9_LOCAL, D4I_REVISA, D4I_PARTE, D4I_MOEDA"

        oQueryCP := saveMD5(cQuery)

        //Binding
        oQueryCP:SetString(nY++, DtoS((dDtVai+1)))
        oQueryCP:SetString(nY++, DtoS(dData))
        oQueryCP:SetString(nY++, DtoS((dDtVai+1)))
        oQueryCP:SetString(nY++, DtoS(dData))
        oQueryCP:SetString(nY++, DtoS((dDtVai+1)))
        oQueryCP:SetString(nY++, DtoS(dData))
        oQueryCP:SetString(nY++, FWXFilial('D4F'))
        oQueryCP:SetString(nY++, ' ')
        oQueryCP:SetString(nY++, FWxFilial("D4I"))
        oQueryCP:SetString(nY++, cCod)
        oQueryCP:SetString(nY++, cLocal)
        oQueryCP:SetString(nY++, DtoS(dDtVai))
        If !Empty(cParte)
            oQueryCP:SetString(nY++, cParte)
        EndIf
        If !Empty(cMoedaCP)
            oQueryCP:SetString(nY++, cMoedaCP)
        EndIf

        cAliasTmp := oQueryCP:OpenAlias()

        (cAliasTmp)->(dbGoTop())
        While !(cAliasTmp)->(Eof())
            aAdd(aRetCustCP, {  (cAliasTmp)->B9_COD,;
                                (cAliasTmp)->B9_LOCAL,;
                                StoD((cAliasTmp)->B9_DATA),;
                                (cAliasTmp)->B9_QINI,;
                                (cAliasTmp)->B9_QISEGUM,;
                                (cAliasTmp)->B9_VINI1,;
                                (cAliasTmp)->B9_VINI2,;
                                (cAliasTmp)->B9_VINI3,;
                                (cAliasTmp)->B9_VINI4,;
                                (cAliasTmp)->B9_VINI5,;
                                (cAliasTmp)->B9_CM1,;
                                (cAliasTmp)->B9_CM2,;
                                (cAliasTmp)->B9_CM3,;
                                (cAliasTmp)->B9_CM4,;
                                (cAliasTmp)->B9_CM5,;
                                (cAliasTmp)->D4I_REVISA,;
                                AllTrim((cAliasTmp)->D4I_PARTE) + '-' + (cAliasTmp)->D4F_TITULO,;
                                (cAliasTmp)->D4I_MOEDA,;
                                (cAliasTmp)->D4I_UNITAR,;
                                (cAliasTmp)->D4I_TOTAL})

            (cAliasTmp)->(DBSkip())
        EndDo
        (cAliasTmp)->( DBCloseArea() )
    EndIf

Return aRetCustCP

/*/{Protheus.doc} saveMD5
    Reaproveita a query para não repetir o changequery
    @type Function
    @author Squad Entradas
    @since 14/01/2025
/*/
Static Function saveMD5(cQuery)
	Local cMD5 as character
	Local nQry as integer
	
	cMD5 := MD5(cQuery)
	nQry := AScan(__aQueryCP, {|x| x[1] == cMD5})
	If nQry == 0
		AAdd(__aQueryCP, {cMD5, FwExecStatement():New()})
	
		nQry := Len(__aQueryCP)
		__aQueryCP[nQry, 2]:SetQuery(ChangeQuery(cQuery))
	EndIf

Return __aQueryCP[nQry, 2]
