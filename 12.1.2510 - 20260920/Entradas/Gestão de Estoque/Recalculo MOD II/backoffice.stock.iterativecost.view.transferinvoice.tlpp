#include "Totvs.ch"
#include "tlpp-core.th"

Namespace totvs.protheus.backoffice.stock.iterativecost.view.transferinvoice

/*/{Protheus.doc} ViewTransferInvoice
    View SD1xSD2 - Notas de transferência
    @author g.moreira
    @since 24/07/2024
    @version version
    /*/
Class ViewTransferInvoice //Implements IterativeCostView
    Public Method New()

    Static Method GetVersion()
    Static Method GetViewID()
    Public Method GetParams()
    Public Method GetQuery()
EndClass

/*/{Protheus.doc} New
    Instância
    @author g.moreira
    @since 22/07/2024
    /*/
Method New() Class ViewTransferInvoice
Return Self

/*/{Protheus.doc} GetVersion
    Versão da View
    @author g.moreira
    @since 22/07/2024
    /*/
Method GetVersion() Class ViewTransferInvoice
Return "0001"

/*/{Protheus.doc} GetViewID
    ID da View
    Não alterar após entrar em produção
    @author g.moreira
    @since 22/07/2024
    /*/
Method GetViewID() Class ViewTransferInvoice
Return "VWTRFNF"

/*/{Protheus.doc} GetParams
    Retorna Json contendo os codeblock executáveis para obter os parâmetros da View
    @author g.moreira
    @since 22/07/2024
    /*/
Method GetParams() Class ViewTransferInvoice
    Local jExec := JsonObject():New() As Json

    jExec["VWSD1IT_NOME"] := {|| Posicione('D4D',1,FWXFilial('D4D')+'VWSD1IT','D4D_VWNAME')}
    jExec["VWSD2IT_NOME"] := {|| Posicione('D4D',1,FWXFilial('D4D')+'VWSD2IT','D4D_VWNAME')}
    jExec["VWSA2M0_NOME"] := {|| Posicione('D4D',1,FWXFilial('D4D')+'VWSA2M0','D4D_VWNAME')}
    jExec["SF4_EMPRESA"]  := {|| FWModeAccess('SF4', 1)}
    jExec["SF4_UNIDADE"]  := {|| FWModeAccess('SF4', 2)}
    jExec["SF4_FILIAL"]   := {|| FWModeAccess('SF4', 3)}
Return jExec

/*/{Protheus.doc} GetQuery
    Retorna a query estruturada da instalação da View com base nos parâmetros informados
    @author g.moreira
    @since 22/07/2024
    /*/
Method GetQuery(cEmpAtu As Character, jParam As Json) Class ViewTransferInvoice
    Local cQuery  As Character
    Local cIDView As Character
    Local cNomFis As Character
    Local cDbType As Character
    Local cVersao As Character
    
	cIDView := ::GetViewID()
    cNomFis := "VW_"+cIDView+"_"+cEmpAtu
    cDbType := TCGetDB()
    cVersao := ::GetVersion()

    cQuery := " Create View "+cNomFis+" As "
    cQuery += " Select "
    If cDbType $ 'POSTGRES'
        cQuery += " Char(4) "
    EndIf
    cQuery += "'"+cVersao+"' ASSINATURA, "
    cQuery += " D2_FILIAL FILORI, "
    cQuery += " D2_DOC DOCORI, "
    cQuery += " D2_SERIE SERIEORI, "
    cQuery += " D2_COD CODORI, "
    cQuery += " D2_CLIENTE CLIORI, "
    cQuery += " D2_LOJA LOJAORI, "
    cQuery += " D2_ITEM ITEMORI, "
    cQuery += " SD2.R_E_C_N_O_ RECORI, "
    cQuery += " TS.F4_FILIAL FILTESORI,"
    cQuery += " D2_EMISSAO, D2_QUANT, D2_QTSEGUM,  "
    cQuery += " D2_CUSTO1, D2_CUSTO2, D2_CUSTO3, D2_CUSTO4, D2_CUSTO5, "
    cQuery += " D1_FILIAL FILDES, "
    cQuery += " D1_DOC DOCDES, "
    cQuery += " D1_SERIE SERIEDES, "
    cQuery += " D1_COD CODDES, "
    cQuery += " D1_FORNECE FORDES, "
    cQuery += " D1_LOJA LOJADES, "
    cQuery += " D1_ITEM ITEMDES, "
    cQuery += " SD1.R_E_C_N_O_ RECDES, "
    cQuery += " SA2.A2_FILIAL FILFORN, "
    cQuery += " TE.F4_FILIAL FILTESDES, "
    cQuery += " TE.F4_TRFICST TRFICST, "
    cQuery += " D1_DTDIGIT, D1_QUANT, D1_QTSEGUM, "
    cQuery += " D1_CUSTO, D1_CUSTO2, D1_CUSTO3, D1_CUSTO4, D1_CUSTO5, D1_ICMSRET "
    cQuery += " From "+jParam["VWSD1IT_NOME"]+" SD1 "
    cQuery += " Inner Join "+RetSQLName('SF4')+" TE On "
    If  jParam["SF4_EMPRESA"] == FWModeAccess("SD1", 1) .And. ;
        jParam["SF4_UNIDADE"] == FWModeAccess("SD1", 2) .And. ;
        jParam["SF4_FILIAL"]  == FWModeAccess("SD1", 3)
        cQuery += " TE.F4_FILIAL = SD1.D1_FILIAL And "
    EndIf
    cQuery += " TE.F4_CODIGO  = SD1.D1_TES And "
    cQuery += " TE.F4_ESTOQUE = 'S' And "
    cQuery += " TE.F4_TRANFIL = '1' And " 
    cQuery += " TE.D_E_L_E_T_ = ' ' "
    cQuery += " Inner Join "+jParam["VWSA2M0_NOME"]+" SA2 On "
    cQuery += FwJoinFilial("SA2", "SD1", "SA2", "SD1") + " And "
    cQuery += " A2_COD  = D1_FORNECE And "
    cQuery += " A2_LOJA = D1_LOJA "
    cQuery += " Inner Join "+jParam["VWSD2IT_NOME"]+" SD2 On "
    cQuery += " D2_FILIAL = SA2.A2_FILTRF And "
    cQuery += " D2_DOC    = D1_DOC And "
    cQuery += " D2_SERIE  = D1_SERIE And "
    cQuery += " D2_ITEMNR = D1_ITEMNR "
    cQuery += " Inner Join "+RetSQLName('SF4')+" TS On "
    If  jParam["SF4_EMPRESA"] == FWModeAccess("SD2", 1) .And. ;
        jParam["SF4_UNIDADE"] == FWModeAccess("SD2", 2) .And. ;
        jParam["SF4_FILIAL"]  == FWModeAccess("SD2", 3)
        cQuery += " TS.F4_FILIAL = SD2.D2_FILIAL And "
    EndIf
    cQuery += " TS.F4_CODIGO  = SD2.D2_TES And "
    cQuery += " TS.F4_ESTOQUE = 'S' And "
    cQuery += " TS.F4_TRANFIL = '1' " 

Return cQuery
