Function Matr960()
Local cReport	:= "MATR960"	//Nome do Programa
Local cAlias	:= "SB4"		//Alias da tabela
Local cTitle	:= STR0001		//Grade de Produtos 
Local cDesc		:= STR0002		//Este relatório apresenta uma relação das Grades de Produtos cadastradas.
Local lInd		:= .T.			//Retorna Indice SIX

//Validação de aviso/bloqueio do relatório em Release 12.1.2510 ou superiores
If ExistFunc("VldDescRel")
	If !VldDescRel()
		Return
	EndIf
EndIf

MPReport(cReport,cAlias,cTitle,cDesc,,lInd)
Return
