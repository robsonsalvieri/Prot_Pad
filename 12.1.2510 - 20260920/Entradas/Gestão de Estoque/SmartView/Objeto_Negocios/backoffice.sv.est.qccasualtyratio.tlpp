#include "msobject.ch"
#include "backoffice.sv.est.qccasualtyratio.ch"
#include "totvs.framework.treports.integratedprovider.th"

#define SX1GRUPO "ESTT028"

namespace totvs.protheus.backoffice.est.qccasualtyratio.integratedprovider
using namespace totvs.protheus.backoffice.est.smartView.integratedProvider

@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGAEST", tables="SB1", name="Relação de Baixas do CQ", country="ALL", customTables="ALL")

//-------------------------------------------------------------------
/*{Protheus.doc} QCCasualtyRatioSmartViewBusinessObject
Classe para criação do Objeto de Negócio

@author Vicente Gomes
@since 11/2023
@version 1.0
*/
//-------------------------------------------------------------------
Class QCCasualtyRatioSmartViewBusinessObject From totvs.protheus.backoffice.est.smartView.integratedProvider.EstIntegratedProvider

	Public Method new() as object
	Public Method getData() as object

	Protected Method oNGetSchema()

	Protected data lExistPergunte	as logical

EndClass

//-------------------------------------------------------------------
/*{Protheus.doc} QCCasualtyRatioSmartViewBusinessObject
Método de instância da classe

@return object: self
@author Vicente Gomes
@since 11/2023
@version 1.0
*/
//-------------------------------------------------------------------
Method new() Class QCCasualtyRatioSmartViewBusinessObject

	_Super:new()

	//Define a Área
	self:appendArea( STR0001 )// "Estoque/Custos"

	//Define o nome do Objeto de Negócio
	self:setDisplayName( STR0002 ) // "Relação de Baixas do CQ."

	//Define a descrição do Objeto de Negócio
	self:setDescription( STR0003 ) // "Este relatório realiza uma avaliação sobre as baixas realizadas no armazém"
	
	//Define o conjunto de perguntas e faz o teste se existe
	self:lExistPergunte := self:setPergunte( SX1GRUPO )
	If !self:lExistPergunte
		self:setErrorStatus(400,STR0005,i18n(STR0006,{SX1GRUPO}))//O Grupo de perguntas não existe		
		FWLogMsg('WARN', , 'SmartView', , , , i18n(STR0006,{SX1GRUPO}), , , )//O Grupo de perguntas não existe
	EndIf

	//Indica que o LookUp será do tipo padrão LookUp
	self:setIsLookUp(.T.)

Return self

//-------------------------------------------------------------------
/*{Protheus.doc} getData
Retorna os dados do objeto de negócio

@return object: self:oData
@author Vicente Gomes
@since 11/2023
@version 1.0
*/
//-------------------------------------------------------------------
Method getData( nPage as Numeric, oFilter as object) as object Class QCCasualtyRatioSmartViewBusinessObject

local aBind		:= {}	as array
local aFields	:= {}	as array
local aTipoD7	:= {}	as array
local cQuery			as character
local cAlias			as character
local cFilAux			as character
local cFilExec			as character
local cEmpExec			as character
local cFldName			as character
local cFldType			as character
local nBind				as numeric
local nPos				as numeric
local nX				as numeric
local jItems			as json
local jParam			as json
local oQuery    		as object

	//Valida o pergunte
	If !self:lExistPergunte
		return self:oData
	Endif

	// Define os valores da opção do campo D7_TIPO
	AADD(aTipoD7,{0,STR0010})	//"Qtd. Original"
	AADD(aTipoD7,{1,STR0011})	//"Liberado"
	AADD(aTipoD7,{2,STR0012})	//"Rejeitado"
	AADD(aTipoD7,{3,STR0013})	//"Devolucao Liberacao"
	AADD(aTipoD7,{4,STR0014})	//"Devolucao Rejeicao"
	AADD(aTipoD7,{6,STR0015})	//"Est. Liber."
	AADD(aTipoD7,{7,STR0016})	//"Est. Rej."
	AADD(aTipoD7,{8,STR0017})	//"Despesas Agregadas"
	AADD(aTipoD7,{9,STR0018})	//"Estorno Despesas"
	
	jParam := oFilter:getParameters() //metodo para retorno do json dos parâmetros

	//Retorno da tela de multi filiais com as filiais selecionadas ou somente a filial corrente
    self:aFils := self:retFils(jParam['SV_MULTBRANCH'], oFilter)

	aFields := self:getStructFields()

	cQuery := " SELECT "
	cQuery += self:getSqlFields()
	cQuery += ", SD7.D7_PRODUTO || ' - ' || SD7.D7_NUMERO AGRUPAM "
	cQuery += ",	(CASE WHEN SD7.D7_TIPO = 0 THEN SD7.D7_SALDO ELSE "
	cQuery += "		(CASE WHEN SD7.D7_TIPO = 1 OR SD7.D7_TIPO = 2 THEN (SD7.D7_QTDE * (-1)) ELSE SD7.D7_QTDE END) END) QUANTID "
	cQuery += " FROM " + RetSQLName("SD7") + " SD7 "
	cQuery += " INNER JOIN " + RetSqlName("SB1") + " SB1 ON "
	cQuery += FwJoinFilial("SB1","SD7")
	cQuery += " AND SB1.B1_COD = SD7.D7_PRODUTO "
	cQuery += " AND SB1.D_E_L_E_T_ = ? "
	cQuery += " WHERE SD7.D7_FILIAL IN (?) "
	cQuery += " AND SD7.D7_DOC BETWEEN ? AND ? "
	if !empty(jParam['MV_PAR03'][1]) .and. !empty(jParam['MV_PAR04'][1])
		cQuery += " AND SD7.D7_DATA BETWEEN ? AND ? "
	endif
    cQuery += " AND SD7.D7_FORNECE BETWEEN ? AND ? "

    if jParam['MV_PAR07'][1] == 1
		cQuery += " AND D7_LIBERA = ?"
	elseif jParam['MV_PAR07'][1] == 2
		cQuery += " AND D7_LIBERA = ?"
	else
		cQuery += " AND D7_LIBERA IN (?)"
	endif
    
    if jParam['MV_PAR08'][1] == 1
		cQuery += " AND D7_ESTORNO IN (?)"
	else
		cQuery += " AND D7_ESTORNO = ?"
	endif

	//Os filtros serão setados na interface do Smart View
	cQuery += self:cWhereFiltroSV
	cQuery += " AND SD7.D_E_L_E_T_ = ? "
	cQuery += " ORDER BY " + SqlOrder(SD7->(IndexKey(1)))

	cQuery := changeQuery(cQuery)

	AADD(aBind,{' ','S'})
	AADD(aBind,{self:aFils,'A'})
	AADD(aBind,{jParam['MV_PAR01'][1],'S'})
	AADD(aBind,{jParam['MV_PAR02'][1],'S'})

	if !empty(jParam['MV_PAR03'][1]) .and. !empty(jParam['MV_PAR04'][1])
		AADD(aBind,{FwDateTimeToLocal(jParam['MV_PAR03'][1])[1],'D'})
		AADD(aBind,{FwDateTimeToLocal(jParam['MV_PAR04'][1])[1],'D'})
	endif
	AADD(aBind,{jParam['MV_PAR05'][1],'S'})
	AADD(aBind,{jParam['MV_PAR06'][1],'S'})

	if jParam['MV_PAR07'][1] == 1
		AADD(aBind,{'S','S'})
	elseif jParam['MV_PAR07'][1] == 2
		AADD(aBind,{'N','S'})
	else
		AADD(aBind,{{' ','S','N'},'A'})
	endif

	if jParam['MV_PAR08'][1] == 1
		AADD(aBind,{{' ','S'},'A'})
	else
		AADD(aBind,{' ','S'})
	endif

	AADD(aBind,{' ','S'})

	oQuery := FwExecStatement():New(cQuery)
	
	nBind  := 1
	for nX := 1 To len(aBind)
		if aBind[nX,2] == "A"
			oQuery:setIn(nBind++,aBind[nX,1])
		elseif aBind[nX,2] == "D"
			oQuery:setDate(nBind++,aBind[nX,1])
		elseif aBind[nX,2] == "S"
			oQuery:setString(nBind++,aBind[nX,1])
		endif
	next nX
	
	cAlias := oQuery:OpenAlias()

	oQuery:Destroy()

	While !(cAlias)->(Eof())
		jItems := JsonObject():New()

		if cFilAux <> (cAlias)->D7_FILIAL
			cFilAux	 := (cAlias)->D7_FILIAL
			cEmpExec := self:getInfoEmp("M0_NOME"	, cFilAux)
			cFilExec := self:getInfoEmp("M0_FILIAL"	, cFilAux)
		endif

		for nX := 1 to len(aFields)

			cFldName := alltrim(aFields[nX]:getName())
			cFldType := alltrim(aFields[nX]:getType())

			if cFldName $ "EMPNOME|FILNOME"
				jItems[cFldName] := if(cFldName == "EMPNOME", cEmpExec, cFilExec)
			elseif cFldName == "DESCMOV"
				nPos := aScan(aTipoD7,{|x| x[1] == (cAlias)->D7_TIPO})
				jItems[cFldName] := if(nPos > 0, aTipoD7[nPos,2],"")
			elseif cFldType == "date"
				jItems[cFldName] := totvs.framework.treports.date.stringToTimeStamp((cAlias)->&(cFldName))
			else
				jItems[cFldName] := (cAlias)->&(cFldName)
			endif

		next nX

		self:processData()
		self:oData:appendData(jItems)

		(cAlias)->(DBSkip())
	EndDo

	(cAlias)->(DBCloseArea())

return self:oData

//-------------------------------------------------------------------
/*{Protheus.doc} oNGetSchema
Retorna a estrutura dos campos

@return object: self:oSchema
@author Vicente Gomes
@since 11/2023
@version 1.0
*/
//-------------------------------------------------------------------
Method oNGetSchema() Class QCCasualtyRatioSmartViewBusinessObject

local lCanFilter := .F. as logical		// Variável para controlar se habilita o filtro dos campos para utilização na consulta do banco de dados

	self:addProperty( "EMPNOME", STR0009 , "string" , STR0009 , "EMPNOME", , , , lCanFilter	) //"Nome Empresa"
	self:addProperty( "FILNOME", STR0008 , "string" , STR0008 , "FILNOME", , , , lCanFilter	) //"Nome Filial"
	self:addProperty( "DESCMOV", STR0019 , "string" , STR0019 , "DESCMOV", , , , lCanFilter	) //"Descr. Mov."
	self:addProperty( "QUANTID", STR0020 , "number" , STR0020 , "QUANTID", , , , lCanFilter	) //"Quantidade"
	self:addProperty( "AGRUPAM", STR0021 , "string" , STR0021 , "AGRUPAM", , , , lCanFilter	) //"Agrupamento"

	self:AliasToSchema("SD7", {"D7_FILIAL","D7_NUMERO","D7_PRODUTO","D7_LOCAL","D7_DOC","D7_ORIGLAN","D7_FORNECE","D7_DATA","D7_TIPO","D7_USUARIO","D7_LOCDEST","D7_LOTECTL","D7_NUMLOTE","D7_MOTREJE"})
	self:AliasToSchema("SB1", {"B1_DESC","B1_TIPO","B1_UM"})

return
