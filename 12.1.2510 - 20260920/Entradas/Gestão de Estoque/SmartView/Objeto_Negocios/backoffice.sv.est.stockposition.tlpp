#include "msobject.ch"
#include "protheus.ch"
#include "backoffice.sv.est.stockposition.ch"
#include "totvs.framework.treports.integratedprovider.th"
#DEFINE SX1GRUPO 'ESTT001'

using namespace totvs.framework.treports.integratedprovider

namespace totvs.protheus.backoffice.est.posicaoestoque.integratedprovider
  
@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGAEST", tables="SB1,SB2,SB9", customTables="SB1,SB2",name="Posicao do Estoque", country="ALL")
 
//-------------------------------------------------------------------
/*{Protheus.doc} PosicaoEstoqueSmartViewBusinessObject
Classe para criaÁ„o do Objeto de NegÛcio de PosiÁ„o do Estoque
 
@author BackOffice
@since 04/2023
@version 1.0
*/
//-------------------------------------------------------------------  
Class PosicaoEstoqueSmartViewBusinessObject From IntegratedProvider

	Public Method new()				as object
	Public Method getData()			as object
	Public Method getSchema()		as object

	Protected data jItems			as Json
	Protected data cWhere			as Character
	Protected data lExistPergunte	as logical
	Protected data aFields			as Array	
	Protected data cQuery			as character
    Protected data cWhereFiltroSV	as character
    Protected data cIsNullSV		as character

EndClass
 
//-------------------------------------------------------------------
/*{Protheus.doc} new
MÈtodo de inst‚ncia da classe
 
@return object: self
 
@author BackOffice
@since 04/2023
@version 1.0
*/
//-------------------------------------------------------------------   
Method new() Class PosicaoEstoqueSmartViewBusinessObject

	_Super:new()

	//Define a ¡rea
	self:appendArea(STR0001) //"Estoque/Custos"

	//Define o nome do Objeto de NegÛcio
	self:setDisplayName(STR0002) //"Posicao do Estoque"
 
	//Define a descriÁ„o do Objeto de NegÛcio
	self:setDescription(STR0003) //"Este relatorio emite a posicao dos saldos e empenhos de cada produto em estoque."

	//Indica o pergunte que ser· utilizado no relatÛrio
    self:lExistPergunte := self:setPergunte( SX1GRUPO )//ESTT013
	If !self:lExistPergunte
		self:setErrorStatus(400,STR0008,i18n(STR0009,{SX1GRUPO}))//O Grupo de perguntas #1 n„o existe		
		FWLogMsg('WARN', , 'SmartView', , , , i18n(STR0009,{SX1GRUPO}), , , )//O Grupo de perguntas #1 n„o existe
	EndIf
    
	//Indica que o LookUp ser· do tipo padr„o LookUp
    self:setIsLookUp(.T.)

Return self

//-------------------------------------------------------------------
/*{Protheus.doc} getData
Retorna os dados do objeto de negÛcio
 
@param nPage, numÈrico, indica a p·gina atual do relatÛrio
@param oFilter, objeto, contÈm o filtro do TReports
 
@return object: self:oData
 
@author BackOffice
@since 04/2023
@version 1.0
*/
//-------------------------------------------------------------------   
Method getData( nPage as Numeric, oFilter as object) as object Class PosicaoEstoqueSmartViewBusinessObject

	Local oQuery							as object

	Local jParams							as Json

	Local cQuery							as Character
	Local cFields							as Character
	Local cLocProc							as Character
	Local cAliasTmp							as Character
	Local cSb1Excl := FWModeAccess("SB1")	as Character
	Local cSb2Excl := FWModeAccess("SB2")	as Character
	Local cSb9Excl := FWModeAccess("SB9")	as Character
	Local cSd1Excl := FWModeAccess("SD1")	as Character
	Local cSd2Excl := FWModeAccess("SD2")	as Character
	Local cSd3Excl := FWModeAccess("SD3")	as Character
	Local cNnrExcl := FWModeAccess("NNR")	as Character
	Local cSccExcl := FWModeAccess("SCC")	as Character
	Local cSd8Excl := FWModeAccess("SD8")	as Character
	Local cMoeda							as Character
	Local cCustom							as Character
	Local cFilExec							as Character
	Local cEmpExec							as Character

	Local nQuant							as Numeric
	Local nValor							as Numeric
	Local nQuantR							as Numeric
	Local nValorR							as Numeric
	Local nQuantSeg							as Numeric
	Local nQuantR2							as Numeric
	Local nX								as Numeric
	Local nS								as Numeric
	Local nFields							as Numeric

	Local cDataRef							as Character

	Local lVeic								as Logical
	Local lNoRunCalc						as Logical
	Local lExstMVArmz						as Logical
	Local lD3Valido							as Logical
	Local lD3Estor							as Logical
	Local lUseFallback						as Logical
	Local lUseFifoFallback					as Logical

	Local aSaldo							as Array
	Local aCustom							as Array
	Local aStrings							as Array
	Local aFieldTypes						as Array

	//Valida o pergunte
	If !self:lExistPergunte	
		return self:oData
	Endif

	//Vari·vel com o nome do Grupo de Empresa
	cEmpExec  := AllTrim(FWEmpName(cEmpAnt))
	cFilExec := AllTrim(FWFilialName())

	//Se tiver custom
	cCustom := self:getSQLFields(.f.,nil,.t.)	
	if !empty(cCustom)	
		aCustom := StrTokArr(cCustom,',')
		For nX := 1 to len(aCustom)		
			aadd(self:aFields,aCustom[nX])
		Next
	EndIf

	//Campos que far„o parte do select da query
	cFields := StrTran(ArrTokStr(self:aFields),"|",",")	

	//--------------------------------------------------------------------------
	// Variaveis utilizadas para parametros no grupo de pergunta MTR260R2
	//--------------------------------------------------------------------------
	// MV_PAR01 - Da Filial
	// MV_PAR02 - Ate a Filial    
	// MV_PAR03 - Do Produto      
	// MV_PAR04 - Ate Poduto      
	// MV_PAR05 - Do Tipo
	// MV_PAR06 - Ate Tipo
	// MV_PAR07 - Do Grupo
	// MV_PAR08 - Ate Grupo
	// MV_PAR09 - Da Descricao    
	// MV_PAR10 - Ate Descricao   
	// MV_PAR11 - Codigo Item De  
	// MV_PAR12 - Codigo Item Ate 
	// MV_PAR13 - Imprime produtos: Todos /Positivos /Negativos
	// MV_PAR14 - Saldo Do Prod a Considerar: Atual / Fechamento / Movimento
	// MV_PAR15 - Data Referencia
	// MV_PAR16 - Qual Moeda
	// MV_PAR17 - Listar Pords C/ Saldo Zerado: (S)im (N)ao
	// MV_PAR18 - Imprimir o Valor: Custo / Custo Std / Ult Prc Compr
	// MV_PAR19 - Listar Prods C/ Valor Zerado: (S)im (N)ao

	//--------------------------------------------------------------------------
	//Pego os parametros
	jParams	:= oFilter:getParameters() //metodo para retorno do json dos par‚metros

	jParams['MV_PAR16'][1] := if(!empty(jParams['MV_PAR16'][1]), jParams['MV_PAR16'][1], 1)

    //Carrega as intruÁıes de filtro recebidas pelo Smart View
    self:cWhereFiltroSV := "AND "
	If !oFilter:hasFilter()
        self:cWhereFiltroSV := ""
    EndIf
	self:cWhereFiltroSV += oFilter:getSQLExpression()

	//Retorno da express„o 'NULL' verificando o banco de dados utilizado (ex: SQL = ISNULL)
	self:cIsNullSV := MatIsNull()

	//Seto variaveis
	cLocProc    := GetMvNNR( 'MV_LOCPROC' , '99' )
	lVeic		:= Upper(SuperGetMV( 'MV_VEICULO' ,.F., 'N' ) ) == "S"
	cDataRef	:= if(!empty(jParams['MV_PAR15'][1]), DTOS(FwDateTimeToLocal(jParams['MV_PAR15'][1])[1]), DTOS(dDataBase))
	cMoeda		:= Str(jParams['MV_PAR16'][1],1)

	//--------------------------------------------------------------------------
	// PERFORMANCE: Determina se o cùlculo de saldo por movimento pode ser feito
	// inteiramente em SQL (Fase 1) ou se precisa do fallback via CalcEst().
	// Fallback necessùrio quando: Entry Point D3VALIDO customizado pelo cliente
	//--------------------------------------------------------------------------
	lD3Valido  := ExistBlock('D3VALIDO')
	lD3Estor   := Upper(GetMV('MV_D3ESTOR', .F., 'N')) == 'S'
	lUseFallback := lD3Valido // Sù cai para fallback se o EP estiver ativo

	//--------------------------------------------------------------------------
	// PERFORMANCE: Determina se o cùlculo FIFO (MV_PAR14==5) pode ser feito
	// via subqueries SQL (SCC + SD8) ou se precisa do fallback via CalcEstFF().
	// Fallback necessùrio quando: IsFechFifo() == .F. (caminho SB9)
	//--------------------------------------------------------------------------
	lUseFifoFallback := !IsFechFifo()

	// Verifico se os filtros novos de Armazem De Ate ja existem na base - OEPSD - 04/02/2026
	lExstMVArmz	:=	( FWSX1Util():ExistItem( SX1GRUPO, "Do Armazem ?" ) ) .And. ( FWSX1Util():ExistItem( SX1GRUPO, "Ate Armazem ?" ) )

	aStrings := {}

	cQuery := " SELECT ? "
	aadd(aStrings,{cFields,"U"})

	If (jParams['MV_PAR14'][1] == 3)
		cQuery += ", " + self:cIsNullSV + "( SB9.B9_COD, ' ' ) B9_COD,  	"
		cQuery += self:cIsNullSV + "( SB9.B9_QINI,  0  ) B9_QINI,  "
		cQuery += self:cIsNullSV + "( SB9.B9_QISEGUM, 0  ) B9_QISEGUM,"
		cQuery += self:cIsNullSV + "( SB9.B9_VINI1, 0  ) B9_VINI1, "
		cQuery += self:cIsNullSV + "( SB9.B9_VINI2, 0  ) B9_VINI2, "
		cQuery += self:cIsNullSV + "( SB9.B9_VINI3, 0  ) B9_VINI3, "
		cQuery += self:cIsNullSV + "( SB9.B9_VINI4, 0  ) B9_VINI4, "
		cQuery += self:cIsNullSV + "( SB9.B9_VINI5, 0  ) B9_VINI5, "
		cQuery += "	( 	SELECT " + self:cIsNullSV + "( MAX( SD1.D1_COD ), ' ' ) D1_COD "
		cQuery += "	FROM "+ RetSQLName( 'SD1' ) +"  SD1 "
		cQuery += "	WHERE "		
		If cSd1Excl == "E"
			If cSb2Excl == "E"
				cQuery += " SD1.D1_FILIAL = SB2.B2_FILIAL "
			Else
				cQuery += " SD1.D1_FILIAL >= ? AND  SD1.D1_FILIAL <= ? "
				aadd(aStrings,{jParams['MV_PAR01'][1],"S"})
				aadd(aStrings,{jParams['MV_PAR02'][1],"S"})
			EndIf
		Else
			cQuery += " SD1.D1_FILIAL = ? "
			aadd(aStrings,{xFilial("SD1"),"S"})
		EndIf
		cQuery += "	AND SD1.D1_COD =  " + self:cIsNullSV + "( SB9.B9_COD, ' ' )  "
		cQuery += "	AND SD1.D1_LOCAL = " + self:cIsNullSV + "( SB9.B9_LOCAL, ' ' )"
		cQuery += "	AND SD1.D1_DTDIGIT >= " + self:cIsNullSV + "( SB9.B9_DATA, ' ' ) "
		cQuery += "	AND SD1.D1_DTDIGIT <= ? "
		aadd(aStrings, { cDataRef,"S"})
		cQuery += "	AND SD1.D_E_L_E_T_ = ?  "
		aadd(aStrings, { ' ',"S"})
		cQuery += "	) D1_COD,  "

		cQuery += "	( 	SELECT " + self:cIsNullSV + "( MAX( SD2.D2_COD ), ' ' ) D2_COD  "
		cQuery += "	FROM "+ RetSQLName( 'SD2' ) +"   SD2  "
		cQuery += "	WHERE "		
		If cSd2Excl == "E"
			If cSb2Excl == "E"
				cQuery += " SD2.D2_FILIAL = SB2.B2_FILIAL "
			Else
				cQuery += " SD2.D2_FILIAL >= ? "
				cQuery += " AND SD2.D2_FILIAL <= ? "
				aadd(aStrings,{jParams['MV_PAR01'][1],"S"})
				aadd(aStrings,{jParams['MV_PAR02'][1],"S"})
			EndIf
		Else
			cQuery += " SD2.D2_FILIAL = ? "
			aadd(aStrings,{xFilial("SD2"),"S"})
		EndIf
		cQuery += "	AND SD2.D2_COD =  " + self:cIsNullSV + "( SB9.B9_COD, ' ' ) "
		cQuery += "	AND SD2.D2_LOCAL =  " + self:cIsNullSV + "( SB9.B9_LOCAL, ' ' ) "
		cQuery += "	AND SD2.D2_EMISSAO BETWEEN  " + self:cIsNullSV + "( SB9.B9_DATA, ' ' ) AND ?  "
		aadd(aStrings, { cDataRef ,"S"})
		cQuery += "	AND SD2.D_E_L_E_T_ = ?  "
		aadd(aStrings, { ' ' ,"S"})
		cQuery += "	) D2_COD,  "
		cQuery += "	( 	SELECT  " + self:cIsNullSV + "( MAX( SD3.D3_COD ), ' ' )  "
		cQuery += "	FROM  "+ RetSQLName( 'SD3' ) +"   SD3  "
		cQuery += "	WHERE "		 
		If cSd3Excl == "E"
			If cSb2Excl == "E"
				cQuery += " SD3.D3_FILIAL = SB2.B2_FILIAL "
			Else
				cQuery += " SD3.D3_FILIAL >= ? AND  SD3.D3_FILIAL <= ? "
				aadd(aStrings,{jParams['MV_PAR01'][1],"S"})
				aadd(aStrings,{jParams['MV_PAR02'][1],"S"})
			EndIf
		Else
			cQuery += " SD3.D3_FILIAL = ? "
			aadd(aStrings,{xFilial("SD3"),"S"})
		EndIf
		cQuery += "				  AND SD3.D3_COD =  " + self:cIsNullSV + "( SB9.B9_COD, ' ' )  "
		cQuery += "	   			  AND SD3.D3_LOCAL =  " + self:cIsNullSV + "( SB9.B9_LOCAL, ' ' )  "
		cQuery += "	   			  AND SD3.D3_EMISSAO >=  " + self:cIsNullSV + "( SB9.B9_DATA, ' ' ) "
		cQuery += "	   			  AND SD3.D3_EMISSAO <=  ? "
		aadd(aStrings,{ cDataRef ,"S"})
		cQuery += " AND SD3.D_E_L_E_T_ = ?  "
		aadd(aStrings, { ' ' ,"S"})
		cQuery += ") D3_COD " 

		//----------------------------------------------------------------------
		// PERFORMANCE FASE 1: Subqueries de cùlculo de saldo por movimento
		// Incorpora a lùgica do CalcEst() diretamente no SQL, evitando N
		// chamadas individuais por produto. Calcula:
		// CALC_QUANT = B9_QINI + SUM(SD1.D1_QUANT) - SUM(SD2.D2_QUANT) +/- SUM(SD3)
		// CALC_QUANT2 = B9_QISEGUM + SUM(SD1.D1_QTSEGUM) - SUM(SD2.D2_QTSEGUM) +/- SUM(SD3)
		// CALC_VINI1..5 = custos por moeda
		//----------------------------------------------------------------------
		If !lUseFallback
			// --- Soma de Entradas (SD1) - quantidade e valores ---
			cQuery += ", " + self:cIsNullSV + "( ( "
			cQuery += " SELECT SUM(SD1E.D1_QUANT) "
			cQuery += " FROM " + RetSQLName('SD1') + " SD1E "
			cQuery += " INNER JOIN " + RetSQLName('SF4') + " SF4E "
			cQuery += " ON SF4E.F4_FILIAL = ? AND SF4E.F4_CODIGO = SD1E.D1_TES AND SF4E.F4_ESTOQUE = ? AND SF4E.D_E_L_E_T_ = ? "
			aadd(aStrings, {xFilial("SF4"), "S"})
			aadd(aStrings, {'S', "S"})
			aadd(aStrings, {' ', "S"})
			cQuery += " WHERE SD1E.D1_FILIAL = SB2.B2_FILIAL "
			cQuery += " AND SD1E.D1_COD = SB2.B2_COD "
			cQuery += " AND SD1E.D1_LOCAL = SB2.B2_LOCAL "
			cQuery += " AND SD1E.D1_DTDIGIT >= " + self:cIsNullSV + "( SB9.B9_DATA, ? ) "
			aadd(aStrings, {'19800101', "S"})
			cQuery += " AND SD1E.D1_DTDIGIT < ? "
			aadd(aStrings, {cDataRef, "S"})
			cQuery += " AND SD1E.D1_ORIGLAN <> ? "
			aadd(aStrings, {'LF', "S"})
			cQuery += " AND SD1E.D_E_L_E_T_ = ? "
			aadd(aStrings, {' ', "S"})
			cQuery += " ), 0) CALC_SD1_QUANT "

			// --- Soma de Entradas (SD1) - 2a unidade ---
			cQuery += ", " + self:cIsNullSV + "( ( "
			cQuery += " SELECT SUM(SD1F.D1_QTSEGUM) "
			cQuery += " FROM " + RetSQLName('SD1') + " SD1F "
			cQuery += " INNER JOIN " + RetSQLName('SF4') + " SF4F "
			cQuery += " ON SF4F.F4_FILIAL = ? AND SF4F.F4_CODIGO = SD1F.D1_TES AND SF4F.F4_ESTOQUE = ? AND SF4F.D_E_L_E_T_ = ? "
			aadd(aStrings, {xFilial("SF4"), "S"})
			aadd(aStrings, {'S', "S"})
			aadd(aStrings, {' ', "S"})
			cQuery += " WHERE SD1F.D1_FILIAL = SB2.B2_FILIAL "
			cQuery += " AND SD1F.D1_COD = SB2.B2_COD "
			cQuery += " AND SD1F.D1_LOCAL = SB2.B2_LOCAL "
			cQuery += " AND SD1F.D1_DTDIGIT >= " + self:cIsNullSV + "( SB9.B9_DATA, ? ) "
			aadd(aStrings, {'19800101', "S"})
			cQuery += " AND SD1F.D1_DTDIGIT < ? "
			aadd(aStrings, {cDataRef, "S"})
			cQuery += " AND SD1F.D1_ORIGLAN <> ? "
			aadd(aStrings, {'LF', "S"})
			cQuery += " AND SD1F.D_E_L_E_T_ = ? "
			aadd(aStrings, {' ', "S"})
			cQuery += " ), 0) CALC_SD1_QUANT2 "

			// --- Soma de Entradas (SD1) - custos por moeda 1..5 ---
			cQuery += ", " + self:cIsNullSV + "( ( "
			if jParams['MV_PAR16'][1] == 1
				cQuery += " SELECT SUM(SD1G.D1_CUSTO) "
			else
				cQuery += " SELECT SUM(SD1G.D1_CUSTO" + cMoeda + ") "
			endif
			cQuery += " FROM " + RetSQLName('SD1') + " SD1G "
			cQuery += " INNER JOIN " + RetSQLName('SF4') + " SF4G "
			cQuery += " ON SF4G.F4_FILIAL = ? AND SF4G.F4_CODIGO = SD1G.D1_TES AND SF4G.F4_ESTOQUE = ? AND SF4G.D_E_L_E_T_ = ? "
			aadd(aStrings, {xFilial("SF4"), "S"})
			aadd(aStrings, {'S', "S"})
			aadd(aStrings, {' ', "S"})
			cQuery += " WHERE SD1G.D1_FILIAL = SB2.B2_FILIAL "
			cQuery += " AND SD1G.D1_COD = SB2.B2_COD "
			cQuery += " AND SD1G.D1_LOCAL = SB2.B2_LOCAL "
			cQuery += " AND SD1G.D1_DTDIGIT >= " + self:cIsNullSV + "( SB9.B9_DATA, ? ) "
			aadd(aStrings, {'19800101', "S"})
			cQuery += " AND SD1G.D1_DTDIGIT < ? "
			aadd(aStrings, {cDataRef, "S"})
			cQuery += " AND SD1G.D1_ORIGLAN <> ? "
			aadd(aStrings, {'LF', "S"})
			cQuery += " AND SD1G.D_E_L_E_T_ = ? "
			aadd(aStrings, {' ', "S"})
			cQuery += " ), 0) CALC_SD1_VINI1 "

			// --- Subtraùùo de Saùdas (SD2) - quantidade ---
			cQuery += ", " + self:cIsNullSV + "( ( "
			cQuery += " SELECT SUM(SD2E.D2_QUANT) "
			cQuery += " FROM " + RetSQLName('SD2') + " SD2E "
			cQuery += " INNER JOIN " + RetSQLName('SF4') + " SF4H "
			cQuery += " ON SF4H.F4_FILIAL = ? AND SF4H.F4_CODIGO = SD2E.D2_TES AND SF4H.F4_ESTOQUE = ? AND SF4H.D_E_L_E_T_ = ? "
			aadd(aStrings, {xFilial("SF4"), "S"})
			aadd(aStrings, {'S', "S"})
			aadd(aStrings, {' ', "S"})
			cQuery += " WHERE SD2E.D2_FILIAL = SB2.B2_FILIAL "
			cQuery += " AND SD2E.D2_COD = SB2.B2_COD "
			cQuery += " AND SD2E.D2_LOCAL = SB2.B2_LOCAL "
			cQuery += " AND SD2E.D2_EMISSAO >= " + self:cIsNullSV + "( SB9.B9_DATA, ? ) "
			aadd(aStrings, {'19800101', "S"})
			cQuery += " AND SD2E.D2_EMISSAO < ? "
			aadd(aStrings, {cDataRef, "S"})
			cQuery += " AND SD2E.D2_ORIGLAN <> ? "
			aadd(aStrings, {'LF', "S"})
			cQuery += " AND SD2E.D_E_L_E_T_ = ? "
			aadd(aStrings, {' ', "S"})
			cQuery += " ), 0) CALC_SD2_QUANT "

			// --- Subtraùùo de Saùdas (SD2) - 2a unidade ---
			cQuery += ", " + self:cIsNullSV + "( ( "
			cQuery += " SELECT SUM(SD2F.D2_QTSEGUM) "
			cQuery += " FROM " + RetSQLName('SD2') + " SD2F "
			cQuery += " INNER JOIN " + RetSQLName('SF4') + " SF4I "
			cQuery += " ON SF4I.F4_FILIAL = ? AND SF4I.F4_CODIGO = SD2F.D2_TES AND SF4I.F4_ESTOQUE = ? AND SF4I.D_E_L_E_T_ = ? "
			aadd(aStrings, {xFilial("SF4"), "S"})
			aadd(aStrings, {'S', "S"})
			aadd(aStrings, {' ', "S"})
			cQuery += " WHERE SD2F.D2_FILIAL = SB2.B2_FILIAL "
			cQuery += " AND SD2F.D2_COD = SB2.B2_COD "
			cQuery += " AND SD2F.D2_LOCAL = SB2.B2_LOCAL "
			cQuery += " AND SD2F.D2_EMISSAO >= " + self:cIsNullSV + "( SB9.B9_DATA, ? ) "
			aadd(aStrings, {'19800101', "S"})
			cQuery += " AND SD2F.D2_EMISSAO < ? "
			aadd(aStrings, {cDataRef, "S"})
			cQuery += " AND SD2F.D2_ORIGLAN <> ? "
			aadd(aStrings, {'LF', "S"})
			cQuery += " AND SD2F.D_E_L_E_T_ = ? "
			aadd(aStrings, {' ', "S"})
			cQuery += " ), 0) CALC_SD2_QUANT2 "

			// --- Subtraùùo de Saùdas (SD2) - custo moeda 1 ---
			cQuery += ", " + self:cIsNullSV + "( ( "
			cQuery += " SELECT SUM(SD2G.D2_CUSTO" + cMoeda + ") "
			cQuery += " FROM " + RetSQLName('SD2') + " SD2G "
			cQuery += " INNER JOIN " + RetSQLName('SF4') + " SF4J "
			cQuery += " ON SF4J.F4_FILIAL = ? AND SF4J.F4_CODIGO = SD2G.D2_TES AND SF4J.F4_ESTOQUE = ? AND SF4J.D_E_L_E_T_ = ? "
			aadd(aStrings, {xFilial("SF4"), "S"})
			aadd(aStrings, {'S', "S"})
			aadd(aStrings, {' ', "S"})
			cQuery += " WHERE SD2G.D2_FILIAL = SB2.B2_FILIAL "
			cQuery += " AND SD2G.D2_COD = SB2.B2_COD "
			cQuery += " AND SD2G.D2_LOCAL = SB2.B2_LOCAL "
			cQuery += " AND SD2G.D2_EMISSAO >= " + self:cIsNullSV + "( SB9.B9_DATA, ? ) "
			aadd(aStrings, {'19800101', "S"})
			cQuery += " AND SD2G.D2_EMISSAO < ? "
			aadd(aStrings, {cDataRef, "S"})
			cQuery += " AND SD2G.D2_ORIGLAN <> ? "
			aadd(aStrings, {'LF', "S"})
			cQuery += " AND SD2G.D_E_L_E_T_ = ? "
			aadd(aStrings, {' ', "S"})
			cQuery += " ), 0) CALC_SD2_VINI1 "

			// --- Movimentos Internos (SD3) - quantidade lùquida (+entrada -saùda) ---
			cQuery += ", " + self:cIsNullSV + "( ( "
			cQuery += " SELECT SUM( CASE WHEN SD3E.D3_TM <= ? THEN SD3E.D3_QUANT ELSE -SD3E.D3_QUANT END ) "
			aadd(aStrings, {'500', "S"})
			cQuery += " FROM " + RetSQLName('SD3') + " SD3E "
			cQuery += " WHERE SD3E.D3_FILIAL = SB2.B2_FILIAL "
			cQuery += " AND SD3E.D3_COD = SB2.B2_COD "
			cQuery += " AND SD3E.D3_LOCAL = SB2.B2_LOCAL "
			cQuery += " AND SD3E.D3_EMISSAO >= " + self:cIsNullSV + "( SB9.B9_DATA, ? ) "
			aadd(aStrings, {'19800101', "S"})
			cQuery += " AND SD3E.D3_EMISSAO < ? "
			aadd(aStrings, {cDataRef, "S"})
			If !lD3Estor
				cQuery += " AND SD3E.D3_ESTORNO = ? "
				aadd(aStrings, {'', "S"})
			EndIf
			cQuery += " AND SD3E.D_E_L_E_T_ = ? "
			aadd(aStrings, {' ', "S"})
			cQuery += " ), 0) CALC_SD3_QUANT "

			// --- Movimentos Internos (SD3) - 2a unidade ---
			cQuery += ", " + self:cIsNullSV + "( ( "
			cQuery += " SELECT SUM( CASE WHEN SD3F.D3_TM <= ? THEN SD3F.D3_QTSEGUM ELSE -SD3F.D3_QTSEGUM END ) "
			aadd(aStrings, {'500', "S"})
			cQuery += " FROM " + RetSQLName('SD3') + " SD3F "
			cQuery += " WHERE SD3F.D3_FILIAL = SB2.B2_FILIAL "
			cQuery += " AND SD3F.D3_COD = SB2.B2_COD "
			cQuery += " AND SD3F.D3_LOCAL = SB2.B2_LOCAL "
			cQuery += " AND SD3F.D3_EMISSAO >= " + self:cIsNullSV + "( SB9.B9_DATA, ? ) "
			aadd(aStrings, {'19800101', "S"})
			cQuery += " AND SD3F.D3_EMISSAO < ? "
			aadd(aStrings, {cDataRef, "S"})
			If !lD3Estor
				cQuery += " AND SD3F.D3_ESTORNO = ? "
				aadd(aStrings, {'', "S"})
			EndIf
			cQuery += " AND SD3F.D_E_L_E_T_ = ? "
			aadd(aStrings, {' ', "S"})
			cQuery += " ), 0) CALC_SD3_QUANT2 "

			// --- Movimentos Internos (SD3) - custo moeda 1 ---
			cQuery += ", " + self:cIsNullSV + "( ( "
			cQuery += " SELECT SUM( CASE WHEN SD3G.D3_TM <= ? THEN SD3G.D3_CUSTO" + cMoeda + " ELSE -SD3G.D3_CUSTO" + cMoeda +" END ) "
			aadd(aStrings, {'500', "S"})
			cQuery += " FROM " + RetSQLName('SD3') + " SD3G "
			cQuery += " WHERE SD3G.D3_FILIAL = SB2.B2_FILIAL "
			cQuery += " AND SD3G.D3_COD = SB2.B2_COD "
			cQuery += " AND SD3G.D3_LOCAL = SB2.B2_LOCAL "
			cQuery += " AND SD3G.D3_EMISSAO >= " + self:cIsNullSV + "( SB9.B9_DATA, ? ) "
			aadd(aStrings, {'19800101', "S"})
			cQuery += " AND SD3G.D3_EMISSAO < ? "
			aadd(aStrings, {cDataRef, "S"})
			If !lD3Estor
				cQuery += " AND SD3G.D3_ESTORNO = ? "
				aadd(aStrings, {'', "S"})
			EndIf
			cQuery += " AND SD3G.D_E_L_E_T_ = ? "
			aadd(aStrings, {' ', "S"})
			cQuery += " ), 0) CALC_SD3_VINI1 "
		EndIf
	EndIf

	//--------------------------------------------------------------------------
	// PERFORMANCE FASE 2: Subqueries correlacionadas SD8 para cenario FIFO
	// (MV_PAR14==5). Incorpora a logica do SD8Query() da xCalcEstFF()
	// diretamente no SQL, evitando N chamadas individuais por produto.
	// Calcula movimentos FIFO entre CC_DATA+1 e cDataRef:
	// CALC_FF_QUANT  = SUM(D8_QUANT)
	// CALC_FF_QUANT2 = SUM(D8_QT2UM)
	// CALC_FF_VINI1  = SUM(D8_CUSTOn) conforme moeda selecionada
	//--------------------------------------------------------------------------
	If (jParams['MV_PAR14'][1] == 5 .And. !lUseFifoFallback)

		cQuery += " , " + self:cIsNullSV + "(SCC.CC_QFIM, 0) CC_QFIM "
		cQuery += " , " + self:cIsNullSV + "(SCC.CC_QFIM2UM, 0) CC_QFIM2UM "
		cQuery += " , " + self:cIsNullSV + "(SCC.CC_VFIMFF, 0) CC_VFIMFF "
		
		// --- Soma de movimentos FIFO (SD8) - quantidade ---
		cQuery += ", " + self:cIsNullSV + "( ( "
		cQuery += " SELECT SUM(SD8A.D8_QUANT) "
		cQuery += " FROM " + RetSQLName('SD8') + " SD8A "
		cQuery += " WHERE "
		If cSd8Excl == "E"
			cQuery += " SD8A.D8_FILIAL = SB2.B2_FILIAL "
		Else
			cQuery += " SD8A.D8_FILIAL = ? "
			aadd(aStrings, {xFilial("SD8"), "S"})
		EndIf
		cQuery += " AND SD8A.D8_PRODUTO = SB2.B2_COD "
		cQuery += " AND SD8A.D8_LOCAL = SB2.B2_LOCAL "
		cQuery += " AND SD8A.D8_DATA > " + self:cIsNullSV + "( SCC.CC_DATA, ? ) "
		aadd(aStrings, {'19800101', "S"})
		cQuery += " AND SD8A.D8_DATA <= ? "
		aadd(aStrings, {cDataRef, "S"})
		cQuery += " AND SD8A.D8_TM <= ? "
		aadd(aStrings, {'500', "S"})
		cQuery += " AND SD8A.D8_TIPONF <> ? "
		aadd(aStrings, {'E', "S"})
		cQuery += " AND SD8A.D_E_L_E_T_ = ? "
		aadd(aStrings, {' ', "S"})
		cQuery += " ), 0) CALC_FF_QUANT "

		// --- Soma de movimentos FIFO (SD8) - 2a unidade de medida ---
		cQuery += ", " + self:cIsNullSV + "( ( "
		cQuery += " SELECT SUM(SD8B.D8_QT2UM) "
		cQuery += " FROM " + RetSQLName('SD8') + " SD8B "
		cQuery += " WHERE "
		If cSd8Excl == "E"
			cQuery += " SD8B.D8_FILIAL = SB2.B2_FILIAL "
		Else
			cQuery += " SD8B.D8_FILIAL = ? "
			aadd(aStrings, {xFilial("SD8"), "S"})
		EndIf
		cQuery += " AND SD8B.D8_PRODUTO = SB2.B2_COD "
		cQuery += " AND SD8B.D8_LOCAL = SB2.B2_LOCAL "
		cQuery += " AND SD8B.D8_DATA > " + self:cIsNullSV + "( SCC.CC_DATA, ? ) "
		aadd(aStrings, {'19800101', "S"})
		cQuery += " AND SD8B.D8_DATA <= ? "
		aadd(aStrings, {cDataRef, "S"})
		cQuery += " AND SD8B.D8_TM <= ? "
		aadd(aStrings, {'500', "S"})
		cQuery += " AND SD8B.D8_TIPONF <> ? "
		aadd(aStrings, {'E', "S"})
		cQuery += " AND SD8B.D_E_L_E_T_ = ? "
		aadd(aStrings, {' ', "S"})
		cQuery += " ), 0) CALC_FF_QUANT2 "

		// --- Soma de movimentos FIFO (SD8) - custo por moeda selecionada ---
		cQuery += ", " + self:cIsNullSV + "( ( "
		cQuery += " SELECT SUM(SD8C.D8_CUSTO" + cMoeda + ") "
		cQuery += " FROM " + RetSQLName('SD8') + " SD8C "
		cQuery += " WHERE "
		If cSd8Excl == "E"
			cQuery += " SD8C.D8_FILIAL = SB2.B2_FILIAL "
		Else
			cQuery += " SD8C.D8_FILIAL = ? "
			aadd(aStrings, {xFilial("SD8"), "S"})
		EndIf
		cQuery += " AND SD8C.D8_PRODUTO = SB2.B2_COD "
		cQuery += " AND SD8C.D8_LOCAL = SB2.B2_LOCAL "
		cQuery += " AND SD8C.D8_DATA > " + self:cIsNullSV + "( SCC.CC_DATA, ? ) "
		aadd(aStrings, {'19800101', "S"})
		cQuery += " AND SD8C.D8_DATA <= ? "
		aadd(aStrings, {cDataRef, "S"})
		cQuery += " AND SD8C.D8_TM <= ? "
		aadd(aStrings, {'500', "S"})
		cQuery += " AND SD8C.D8_TIPONF <> ? "
		aadd(aStrings, {'E', "S"})
		cQuery += " AND SD8C.D_E_L_E_T_ = ? "
		aadd(aStrings, {' ', "S"})
		cQuery += " ), 0) CALC_FF_VINI1 "
	Endif

	cQuery += " FROM "+ RetSQLName( 'SB2' ) +" SB2 "
	cQuery += "	INNER JOIN "+ RetSQLName( 'SB1' ) +" SB1 "
	cQuery += "	ON ( "
	If cSb1Excl == "E"
		If cSb2Excl == "E"
			cQuery += " SB1.B1_FILIAL = SB2.B2_FILIAL AND SB1.B1_COD = SB2.B2_COD "
		Else
			cQuery += " SB1.B1_FILIAL >= ? AND SB1.B1_FILIAL <= ? AND SB1.B1_COD = SB2.B2_COD "
			aadd(aStrings,{jParams['MV_PAR01'][1],"S"})
			aadd(aStrings,{jParams['MV_PAR02'][1],"S"})
		EndIf
	Else
		cQuery += " SB1.B1_FILIAL = ? AND SB1.B1_COD = SB2.B2_COD "
		aadd(aStrings,{xFilial("SB1"),"S"})
	EndIf

	cQuery += " ) AND SB1.D_E_L_E_T_ = ? "
	aadd(aStrings, { ' ' ,"S"})
	cQuery += " INNER JOIN "+ RetSQLName( 'NNR' ) +" NNR "
	cQuery += " ON ( "
	If cNnrExcl == "E"
		If cSb2Excl == "E"
			cQuery += " NNR.NNR_FILIAL = SB2.B2_FILIAL AND NNR.NNR_CODIGO = SB2.B2_LOCAL "
		Else		
			cQuery += " NNR.NNR_FILIAL >= ? AND NNR.NNR_FILIAL <= ? AND NNR.NNR_CODIGO = SB2.B2_LOCAL "
			aadd(aStrings,{jParams['MV_PAR01'][1],"S"})
			aadd(aStrings,{jParams['MV_PAR02'][1],"S"})
		EndIf
	Else
		cQuery += " NNR.NNR_FILIAL = ? AND NNR.NNR_CODIGO = SB2.B2_LOCAL "
		aadd(aStrings,{xFilial("NNR"),"S"})
	EndIf		 
	cQuery += " ) AND NNR.D_E_L_E_T_ = ? "
	aadd(aStrings, { ' ' ,"S"})

	If (jParams['MV_PAR14'][1] == 3)
		cQuery += " LEFT OUTER JOIN (  "
		cQuery += " SELECT B9_FILIAL, B9_COD, B9_LOCAL, B9_DATA, B9_QINI, B9_VINI1, B9_QISEGUM, B9_VINI2, B9_VINI3, B9_VINI4, B9_VINI5 "
		cQuery += " FROM "+ RetSQLName( 'SB9' ) +" SB9A "
		cQuery += " WHERE SB9A.D_E_L_E_T_ = ? "
		aadd(aStrings, { ' ' ,"S"})
		If cSb9Excl == "E"
			cQuery += " AND SB9A.B9_FILIAL >= ? AND SB9A.B9_FILIAL <= ? "
			aadd(aStrings,{jParams['MV_PAR01'][1],"S"})
			aadd(aStrings,{jParams['MV_PAR02'][1],"S"})
		Else
			cQuery += " AND SB9A.B9_FILIAL = ? "
			aadd(aStrings,{xFilial("SB9"),"S"})
		EndIf

		cQuery += " AND SB9A.B9_DATA = (  "
		cQuery += " SELECT " + self:cIsNullSV + "( MAX( SB9B.B9_DATA ), ' ' )  "
		cQuery += " FROM "+ RetSQLName( 'SB9' ) +" SB9B  "
		cQuery += " WHERE SB9B.B9_FILIAL = SB9A.B9_FILIAL  "
		cQuery += " AND SB9B.B9_COD  = SB9A.B9_COD  "
		cQuery += " AND SB9B.B9_LOCAL = SB9A.B9_LOCAL"
		cQuery += " AND SB9B.B9_DATA <= ? "
		cQuery += " AND SB9B.D_E_L_E_T_ = ? ) ) "	
		cQuery += " SB9 ON ( SB9.B9_FILIAL = SB2.B2_FILIAL AND SB9.B9_COD = SB2.B2_COD AND SB9.B9_LOCAL = SB2.B2_LOCAL )  "
		aadd(aStrings, { cDataRef ,"S"})
		aadd(aStrings, { ' ' ,"S"})	
	EndIf

	//--------------------------------------------------------------------------
	// PERFORMANCE FASE 2: LEFT JOIN SCC para cenario FIFO (MV_PAR14==5)
	// Incorpora a logica do xCalcEstFF() - busca MAX(CC_DATA) <= cDataRef por
	// produto/local e soma CC_QFIM de todos os lotes nessa data (GROUP BY+SUM).
	// Elimina o seek+while individual da xCalcEstFF() para cada registro.
	//--------------------------------------------------------------------------
	If (jParams['MV_PAR14'][1] == 5 .And. !lUseFifoFallback)
		cQuery += " LEFT OUTER JOIN ( "
		cQuery += " SELECT SCCA.CC_FILIAL, SCCA.CC_PRODUTO, SCCA.CC_LOCAL, "
		cQuery += " SUM(SCCA.CC_QFIM) CC_QFIM, "
		cQuery += " SUM(SCCA.CC_VFIMFF" + cMoeda + ") CC_VFIMFF, "
		cQuery += " SUM(SCCA.CC_QFIM2UM) CC_QFIM2UM, "
		cQuery += " SCCA.CC_DATA "
		cQuery += " FROM " + RetSQLName('SCC') + " SCCA "
		cQuery += " WHERE SCCA.D_E_L_E_T_ = ? "
		aadd(aStrings, {' ', "S"})
		If cSccExcl == "E"
			cQuery += " AND SCCA.CC_FILIAL >= ? AND SCCA.CC_FILIAL <= ? "
			aadd(aStrings, {jParams['MV_PAR01'][1], "S"})
			aadd(aStrings, {jParams['MV_PAR02'][1], "S"})
		Else
			cQuery += " AND SCCA.CC_FILIAL = ? "
			aadd(aStrings, {xFilial("SCC"), "S"})
		EndIf
		cQuery += " AND SCCA.CC_DATA = ( "
		cQuery += " SELECT " + self:cIsNullSV + "( MAX( SCCB.CC_DATA ), ' ' ) "
		cQuery += " FROM " + RetSQLName('SCC') + " SCCB "
		cQuery += " WHERE SCCB.CC_FILIAL = SCCA.CC_FILIAL "
		cQuery += " AND SCCB.CC_PRODUTO = SCCA.CC_PRODUTO "
		cQuery += " AND SCCB.CC_LOCAL = SCCA.CC_LOCAL "
		cQuery += " AND SCCB.CC_DATA <= ? "
		aadd(aStrings, {cDataRef, "S"})
		cQuery += " AND SCCB.D_E_L_E_T_ = ? ) "
		aadd(aStrings, {' ', "S"})
		cQuery += " GROUP BY SCCA.CC_FILIAL, SCCA.CC_PRODUTO, SCCA.CC_LOCAL, SCCA.CC_DATA "
		cQuery += " ) SCC ON ( SCC.CC_FILIAL = SB2.B2_FILIAL AND SCC.CC_PRODUTO = SB2.B2_COD AND SCC.CC_LOCAL = SB2.B2_LOCAL ) "
	EndIf

	cQuery += " WHERE"
	If cSb2Excl == "E"
		cQuery += " SB2.B2_FILIAL >= ? AND  SB2.B2_FILIAL <= ? "
		aadd(aStrings,{jParams['MV_PAR01'][1],"S"})
		aadd(aStrings,{jParams['MV_PAR02'][1],"S"})
	Else
		cQuery += " SB2.B2_FILIAL = ? "
		aadd(aStrings,{FWxFilial("SB2"),"S"})
	EndIf	

	If lVeic
		cQuery += " AND SB1.B1_CODITE >= ? AND SB1.B1_CODITE <= ? "
		aadd(aStrings,{jParams['MV_PAR11'][1],"S"})
		aadd(aStrings,{jParams['MV_PAR12'][1],"S"})
	Else
		cQuery += " AND SB1.B1_COD >= ? AND SB1.B1_COD <= ? "
		aadd(aStrings,{jParams['MV_PAR03'][1],"S"})
		aadd(aStrings,{jParams['MV_PAR04'][1],"S"})
	EndIf

	cQuery += " AND SB1.B1_GRUPO >= ? AND SB1.B1_GRUPO <= ? "
	aadd(aStrings,{jParams['MV_PAR07'][1],"S"})
	aadd(aStrings,{jParams['MV_PAR08'][1],"S"})

	cQuery += " AND SB1.B1_TIPO  >= ? AND SB1.B1_TIPO  <= ? "
	aadd(aStrings,{jParams['MV_PAR05'][1],"S"})
	aadd(aStrings,{jParams['MV_PAR06'][1],"S"})

	cQuery += " AND SB1.B1_DESC >=  ? AND SB1.B1_DESC <= ? "
	aadd(aStrings,{DecodeUtf8(jParams['MV_PAR09'][1]),"S"})
	aadd(aStrings,{DecodeUtf8(jParams['MV_PAR10'][1]),"S"})


	//---------------------------------------------------------
	// MODIFICACAO DE PERFORMANCE: Adicionando condiÁıes de saldo
	// e valor zerado diretamente no WHERE da Query.
	//---------------------------------------------------------
	If jParams['MV_PAR14'][1] != 3 .And. jParams['MV_PAR14'][1] != 5 // Excecao para Movimento e Movimento FIFO
		If jParams['MV_PAR17'][1] == 2	// Filtro de Quantidade Zerada (MV_PAR17 == 2 -> N„o Listar)
			Do Case
				Case jParams['MV_PAR14'][1] == 1 // Atual
					cQuery += " AND SB2.B2_QATU <> ? "
					aadd(aStrings,{0,"N"})
				Case jParams['MV_PAR14'][1] == 2 .Or. jParams['MV_PAR14'][1] == 4 // Fechamento
					cQuery += " AND SB2.B2_QFIM <> ? "
					aadd(aStrings,{0,"N"})
			EndCase
		EndIf

		// Filtro de Valor Zerado (MV_PAR19 == 2 -> N„o Listar)
		// Apenas para valor de Custo (MV_PAR18 == 1), os demais exigem c·lculo de Moeda
		If jParams['MV_PAR19'][1] == 2 .And. jParams['MV_PAR18'][1] == 1
			Do Case
				Case jParams['MV_PAR14'][1] == 1 // Atual
					cQuery += " AND SB2.B2_VATU" + cMoeda + " <> ? "
					aadd(aStrings,{0,"N"})
				Case jParams['MV_PAR14'][1] == 2 // Fechamento
					cQuery += " AND SB2.B2_VFIM" + cMoeda + " <> ? "
					aadd(aStrings,{0,"N"})
				Case jParams['MV_PAR14'][1] == 4 // Fechamento FIFO
					cQuery += " AND SB2.B2_VFIMFF" + cMoeda + " <> ? "
					aadd(aStrings,{0,"N"})
			EndCase
		EndIf
	EndIf
	//---------------------------------------------------------

	If lExstMVArmz
		cQuery += " AND SB2.B2_LOCAL >= ? AND  SB2.B2_LOCAL <= ? "
		aadd(aStrings,{jParams['MV_PAR20'][1],"S"})
		aadd(aStrings,{jParams['MV_PAR21'][1],"S"})
	EndIf
	
	cQuery += self:cWhereFiltroSV
	cQuery += self:cWhere
	cQuery += " AND SB2.D_E_L_E_T_ = ? "
	aadd(aStrings, { ' ' ,"S"})
	cQuery += " ORDER BY B2_FILIAL, B2_COD, B2_LOCAL "
	cQuery := changeQuery(cQuery)

	oQuery := FwExecStatement():New(cQuery)

	//Binding
	For nS := 1 to len(aStrings)
		If aStrings[nS][2] == "U"
			oQuery:setUnsafe(nS,aStrings[nS][1])
		ElseIf aStrings[nS][2] == "S"
			oQuery:setString(nS,aStrings[nS][1])
		elseIf aStrings[nS][2] == "N"
			oQuery:setNumeric(nS,aStrings[nS][1])
		EndIf
	next nS	

	cAliasTmp := oQuery:OpenAlias()

	//--------------------------------------------------------------------------
	// PERFORMANCE: Prù-carrega o tipo de cada campo (D=data, outros) uma ùnica
	// vez antes do loop, evitando N x M chamadas a FWSX3Util():GetFieldType().
	//--------------------------------------------------------------------------
	nFields := Len(self:aFields)
	aFieldTypes := Array(nFields)
	For nX := 1 To nFields
		aFieldTypes[nX] := FWSX3Util():GetFieldType(self:aFields[nX])
	Next nX

	(cAliasTmp)->(dbGoTop())

	While !(cAliasTmp)->(Eof())

		nQuantSeg := 0
		nQuant := 0
		nValor := 0

		If (jParams['MV_PAR14'][1] == 3)
			lNoRunCalc := !Empty((cAliasTmp)->B9_COD) .And. Empty((cAliasTmp)->D1_COD) .And. Empty((cAliasTmp)->D2_COD) .And. Empty((cAliasTmp)->D3_COD) .And. (cAliasTmp)->B2_LOCAL <> cLocProc
		EndIf

		Do Case
			Case (jParams['MV_PAR14'][1] == 1)
				nQuant := (cAliasTmp)->B2_QATU
				nQuantSeg := ConvUM( (cAliasTmp)->B2_COD, (cAliasTmp)->B2_QATU, (cAliasTmp)->B2_QTSEGUM, 2 )

			Case (jParams['MV_PAR14'][1] == 2)
				nQuant := (cAliasTmp)->B2_QFIM
				nQuantSeg := ConvUM( (cAliasTmp)->B2_COD, (cAliasTmp)->B2_QFIM, (cAliasTmp)->B2_QFIM2, 2 )

			Case (jParams['MV_PAR14'][1] == 3)
				If lNoRunCalc
					nQuant := ( cAliasTmp )->B9_QINI
					nQuantSeg := (cAliasTmp)->B9_QISEGUM
				ElseIf !lUseFallback .And. (cAliasTmp)->B2_LOCAL <> cLocProc
					// PERFORMANCE FASE 1: Saldo calculado via SQL (subqueries)
					nQuant := (cAliasTmp)->B9_QINI + (cAliasTmp)->CALC_SD1_QUANT - (cAliasTmp)->CALC_SD2_QUANT + (cAliasTmp)->CALC_SD3_QUANT
					nQuantSeg := (cAliasTmp)->B9_QISEGUM + (cAliasTmp)->CALC_SD1_QUANT2 - (cAliasTmp)->CALC_SD2_QUANT2 + (cAliasTmp)->CALC_SD3_QUANT2
				Else
					// Fallback: Entry Point D3VALIDO ativo ou armazùm de processo
					nQuant := (aSaldo := CalcEst( (cAliasTmp)->B2_COD,(cAliasTmp)->B2_LOCAL,STOD(cDataRef)+1,(cAliasTmp)->B2_FILIAL ))[ 1 ]
					nQuantSeg := aSaldo[7]
				EndIf

			Case (jParams['MV_PAR14'][1] == 4)
				nQuant := (cAliasTmp)->B2_QFIM
				nQuantSeg := ConvUM( (cAliasTmp)->B2_COD, (cAliasTmp)->B2_QFIM, (cAliasTmp)->B2_QFIM2, 2 )

			Case (jParams['MV_PAR14'][1] == 5)
				If !lUseFifoFallback .And. (cAliasTmp)->B2_LOCAL <> cLocProc
					// PERFORMANCE FASE 2: Saldo FIFO calculado via SQL (LEFT JOIN SCC + subqueries SD8)
					nQuant := (cAliasTmp)->CC_QFIM + (cAliasTmp)->CALC_FF_QUANT
					nQuantSeg := (cAliasTmp)->CC_QFIM2UM + (cAliasTmp)->CALC_FF_QUANT2
				Else
					// Fallback: IsFechFifo()==.F. (caminho SB9) ou armazùm de processo
					nQuant := (aSaldo := CalcEstFF( (cAliasTmp)->B2_COD,(cAliasTmp)->B2_LOCAL,STOD(cDataRef)+1,(cAliasTmp)->B2_FILIAL ))[ 1 ]
					nQuantSeg := aSaldo[7]
				EndIf
		EndCase

		If (jParams['MV_PAR18'][1] == 1)
			Do Case
				Case (jParams['MV_PAR14'][1] == 1)
					nValor := (cAliasTmp)->(FieldGet( FieldPos( "B2_VATU"+cMoeda ) ))

				Case (jParams['MV_PAR14'][1] == 2)
					nValor := (cAliasTmp)->(FieldGet( FieldPos( "B2_VFIM"+cMoeda ) ))

				Case (jParams['MV_PAR14'][1] == 3)
					If lNoRunCalc
						nValor := (cAliasTmp)->( FieldGet( FieldPos( "B9_VINI"+cMoeda ) ))
					ElseIf !lUseFallback .And. (cAliasTmp)->B2_LOCAL <> cLocProc
						// PERFORMANCE FASE 1: Valor calculado via SQL (moeda 1)
						nValor := (cAliasTmp)->( FieldGet( FieldPos( "B9_VINI"+cMoeda ) )) + (cAliasTmp)->CALC_SD1_VINI1 - (cAliasTmp)->CALC_SD2_VINI1 + (cAliasTmp)->CALC_SD3_VINI1
					Else
						nValor := aSaldo[ 1+jParams['MV_PAR16'][1] ]
					EndIf

				Case (jParams['MV_PAR14'][1] == 4)
					nValor := (cAliasTmp)->(FieldGet( FieldPos( "B2_VFIMFF"+cMoeda ) ))

				Case (jParams['MV_PAR14'][1] == 5)
					If !lUseFifoFallback .And. (cAliasTmp)->B2_LOCAL <> cLocProc
						// PERFORMANCE FASE 2: Valor FIFO calculado via SQL (LEFT JOIN SCC + subquery SD8)
						nValor := (cAliasTmp)->(FieldGet( FieldPos( "CC_VFIMFF" ) )) + (cAliasTmp)->CALC_FF_VINI1
					Else
						// Fallback: IsFechFifo()==.F. (caminho SB9) ou armazùm de processo
						nValor := aSaldo[ 1+jParams['MV_PAR16'][1] ]
					EndIf

			EndCase
		Else
			// Converte valores para a moeda do relatorio (C.St. e U.Pr.Compra)
			Do Case
				Case (jParams['MV_PAR18'][1] == 2)
					nValor := nQuant * xMoeda( RetFldProd((cAliasTmp)->B1_COD,"B1_CUSTD",cAliasTmp),Val( (cAliasTmp)->B1_MCUSTD ),jParams['MV_PAR16'][1],STOD(cDataRef),4 )
				Case (jParams['MV_PAR18'][1] == 3)  // Ult.Pr.Compra sempre na Moeda 1
					nValor := nQuant * xMoeda( RetFldProd((cAliasTmp)->B1_COD,"B1_UPRC" ,cAliasTmp),1,jParams['MV_PAR16'][1],STOD(cDataRef),4 )
			EndCase
		EndIf

		nQuantR := (cAliasTmp)->B2_QEMP + AvalQtdPre("SB2",1,NIL,cAliasTmp) + (cAliasTmp)->B2_RESERVA + (cAliasTmp)->B2_QEMPSA + (cAliasTmp)->B2_QEMPPRJ
		nValorR := (QtdComp(nValor) / QtdComp(nQuant)) * QtdComp(nQuantR)

		//Segunda unidade de medida
		nQuantR2 := (cAliasTmp)->B2_QEMP2 + AvalQtdPre("SB2",1,.T.,cAliasTmp) + (cAliasTmp)->B2_RESERV2  + ConvUM( (cAliasTmp)->B2_COD, (cAliasTmp)->B2_QEMPSA, 0, 2)+(cAliasTmp)->B2_QEMPPR2

		//Verifica se È para Apresentar os Registros com Valores e Quantidades Zerados
		If ( jParams['MV_PAR17'][1] == 2 .And. QtdComp( nQuant ) == QtdComp( 0 ) ) .Or. ( jParams['MV_PAR19'][1] == 2 .And. QtdComp( nValor ) == QtdComp( 0 ) )
			(cAliasTmp)->(DBSkip())
			Loop
		EndIf

		//Verifica se È para Apresentar os Registros com Quantidades Positivas ou Negativas
		If (((jParams['MV_PAR13'][1] == 2) .And. (QtdComp( nQuant ) < QtdComp(0)) ) .Or. ( (jParams['MV_PAR13'][1] == 3) .And. (QtdComp( nQuant ) >= QtdComp(0)) ) )
			(cAliasTmp)->(DBSkip())
			Loop
		EndIf

		//APPENDS
		self:jItems := JsonObject():New()

		self:jItems["FILIAL"]	:= (cAliasTmp)->B2_FILIAL
		self:jItems["EMPNOME"]	:= cEmpExec
		self:jItems["FILNOME"]	:= cFilExec

		For nX := 1 To nFields
			if aFieldTypes[nX] == "D" //Campo tipo data tem um tratamento diferente para envio
				If !Empty( (cAliasTmp)->&(self:aFields[nX]) )
					self:jItems[self:aFields[nX]] := totvs.framework.treports.date.dateToTimeStamp(StoD((cAliasTmp)->&(self:aFields[nX])))	
				EndIf
			Else
				self:jItems[self:aFields[nX]] := (cAliasTmp)->&(self:aFields[nX])
			EndIf
		Next nX

		self:jItems[ "QUANT"  ] := nQuant
		self:jItems[ "QUANTD" ] := nQuant-nQuantR
		self:jItems[ "QTDEMP" ] := nQuantR
		self:jItems[ "VALIMP" ] := nValor
		self:jItems[ "VLREMP" ] := nValorR

		//Segunda unidade de medida
		self:jItems[ "QUANT2"  ] := nQuantSeg
		self:jItems[ "QUANTD2" ] := nQuantSeg-nQuantR2
		self:jItems[ "QTDEMP2" ] := nQuantR2

		self:processData()
		self:oData:appendData(self:jItems)

		(cAliasTmp)->(DBSkip())
	EndDo

	(cAliasTmp)->( DBCloseArea() )

	oQuery:Destroy()
	FWFreeArray(aStrings)

return self:oData

//-------------------------------------------------------------------
/*{Protheus.doc} getSchema
Retorna a estrutura dos campos
 
@return object: self:oSchema
 
@author BackOffice
@since 04/2023
@version 1.0
*/
//-------------------------------------------------------------------   
Method getSchema() as object Class PosicaoEstoqueSmartViewBusinessObject

Local aFldSB1 as Array
Local aFldSB2 as Array
Local aFldNNR as Array
Local aFldMoe as Array
Local cFields as Character		
	
	aFldMoe := {"B2_VATU1","B2_VFIM1","B2_CM1","B2_VFIMFF1","B2_VATU2","B2_VFIM2","B2_CM2","B2_VFIMFF2","B2_VATU3","B2_VFIM3","B2_CM3","B2_VFIMFF3","B2_VATU4","B2_VFIM4","B2_CM4","B2_VFIMFF4","B2_VATU5","B2_VFIM5","B2_CM5","B2_VFIMFF5","B2_QEMPPRE","B2_QEPRE2","B2_QTSEGUM","B2_QFIM2","B2_QEMP2","B2_RESERV2","B2_QEMPPR2"}
	aFldSB1 := {"B1_COD","B1_DESC","B1_TIPO","B1_UM","B1_GRUPO","B1_MCUSTD","B1_UPRC","B1_CUSTD","B1_CODITE"}

	If SB2->(FieldPos("B2_DMOV")) > 0
		aFldSB2 := {"B2_FILIAL","B2_COD","B2_QATU","B2_QFIM","B2_QEMP","B2_RESERVA","B2_QEMPSA","B2_QEMPPRJ","B2_DMOV","B2_LOCAL"}
	Else
		aFldSB2 := {"B2_FILIAL","B2_COD","B2_QATU","B2_QFIM","B2_QEMP","B2_RESERVA","B2_QEMPSA","B2_QEMPPRJ","B2_LOCAL"}
	EndIf
	
	aFldNNR := {"NNR_DESCRI"}
	
	self:AliasToSchema("SB1", aFldSB1)
	self:AliasToSchema("SB2", aFldSB2)
	self:AliasToSchema("SB2", aFldMoe)
	self:AliasToSchema("NNR", aFldNNR)
	
	cFields := ArrTokStr(aFldSB1)+"|"+ArrTokStr(aFldSB2)+"|"+ArrTokStr(aFldMoe)+"|"+ArrTokStr(aFldNNR)
	self:aFields := StrTokArr(cFields,"|")

	self:addProperty( "FILIAL"  , STR0010 	, "string", STR0010 , "FILIAL"	) //"Filial"
	self:addProperty( "EMPNOME" , STR0011 	, "string", STR0011 , "EMPNOME"	) //"Nome Empresa"
	self:addProperty( "FILNOME" , STR0012 	, "string", STR0012 , "FILNOME"	) //"Nome Filial"
	self:addProperty( "QUANT"	, STR0013	, "number", STR0013	,"QUANT"	) //"Saldo Atual do Prod."
	self:addProperty( "QUANTD"	, STR0004	, "number", STR0004	,"QUANTD"	) //"Saldo Disponivel"
	self:addProperty( "QTDEMP"	, STR0005	, "number", STR0005	,"QTDEMP"	) //"Qtd. em Empenho"
	self:addProperty( "VALIMP"	, STR0006	, "number", STR0006	,"VALIMP"	) //"Vlr. em Estoque"
	self:addProperty( "VLREMP"	, STR0007	, "number", STR0007	,"VLREMP"	) //"Vlr. em Empenho"

	//Campos para gravaÁ„o da segunda unidade de medida
	self:addProperty( "QUANT2"	, STR0014	, "number", STR0014	,"QUANT2"	) //"Saldo Atual 2a. U.M."
	self:addProperty( "QUANTD2"	, STR0015	, "number", STR0015	,"QUANTD2"	) //"Saldo Disponivel 2a. U.M."
	self:addProperty( "QTDEMP2"	, STR0016	, "number", STR0016	,"QTDEMP2"	) //"Qtd. em Empenho 2a. U.M."

Return self:oSchema
