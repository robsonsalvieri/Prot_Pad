			cQuery += " GROUP BY SD3.D3_FILIAL, SB1.B1_COD"+if(lVeic, ", SB1.B1_CODITE", "")+", SB1.B1_DESC, SB1.B1_TIPO, SB1.B1_UM, SB1.B1_GRUPO, SB1.B1_POSIPI, SD3.D3_EMISSAO"+if(cArmazem == Repl("*", nTamArm) .And. cArmazem <> Repl("#", nTamArm), "", ", SD3.D3_LOCAL")+","
			cQuery += " SD3.D3_TM, SD3.D3_CF, SD3.D3_DOC, SD3.D3_SEQCALC, SD3.D3_NUMSEQ, SD3.D3_OP, SD3.D3_PROJPMS, SD3.D3_CC, STJ.TJ_ORDEM, STJ.TJ_CCUSTO "
