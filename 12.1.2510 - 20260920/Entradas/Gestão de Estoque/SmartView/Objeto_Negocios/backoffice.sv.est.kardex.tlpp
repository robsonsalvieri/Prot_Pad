		endif
		
		if lD3Servi .And. IntDL()
			cQuery += " 	AND (	(SD3.D3_SERVIC = ?) "
			aAdd(aBind,{'   ',"S"})
			
			cQuery += "				OR "
			cQuery += "				(SD3.D3_SERVIC <> ? AND SD3.D3_TM <= ?) "
			aAdd(aBind,{'   ',"S"})
			aAdd(aBind,{'500',"S"})
			
			cQuery += "				OR "
			cQuery += "				(SD3.D3_SERVIC <> ? AND SD3.D3_TM > ? AND SD3.D3_LOCAL = ?) "
			aAdd(aBind,{'   ',"S"})
			aAdd(aBind,{'500',"S"})
			aAdd(aBind,{cMvCQ,"S"})
			cQuery += " 	) "
		endif
		
		cQuery += "     AND SD3.D_E_L_E_T_ = ? "
		aAdd(aBind,{' ',"S"})
		
		cQuery += " GROUP BY SD3.D3_FILIAL, SB1.B1_COD"+if(lVeic, ", SB1.B1_CODITE", "")+", SB1.B1_DESC, SB1.B1_TIPO, SB1.B1_UM, SB1.B1_GRUPO, SB1.B1_POSIPI, SD3.D3_EMISSAO"+if(cArmazem == Repl("*", nTamArm) .And. cArmazem <> Repl("#", nTamArm), "", ", SD3.D3_LOCAL")+","
		cQuery += " SD3.D3_TM, SD3.D3_CF, SD3.D3_DOC, SD3.D3_SEQCALC, SD3.D3_NUMSEQ, SD3.D3_OP, SD3.D3_PROJPMS, SD3.D3_CC, STJ.TJ_ORDEM, STJ.TJ_CCUSTO "

		if lLocProc .Or. lCusUnif 
			cQuery += " UNION ALL "

			cQuery += " SELECT "
			cQuery += " SD3.D3_FILIAL FILIAL "
			cQuery += " ," + if(lVeic, "SB1.B1_CODITE", "SB1.B1_COD") + " CODPROD"
			cQuery += " ,SB1.B1_DESC DESCPRO "
			cQuery += " ,SB1.B1_TIPO TIPO "
			cQuery += " ,SB1.B1_UM UNIDADE "
			cQuery += " ,SB1.B1_GRUPO GRUPO"
			cQuery += " ,SB1.B1_POSIPI NCM "
			cQuery += "	,SD3.D3_EMISSAO AS EMISSAO "
			cQuery += "	," + if(lLocProc .Or. cArmazem == Repl("*", nTamArm) .Or. cArmazem == Repl("#", nTamArm), "'"+cArmazem+"'", "SD3.D3_LOCAL") + " ARMAZEM "
			cQuery += "	,SD3.D3_TM TPMOVIM "
			cQuery += "	,(CASE WHEN SUBSTRING(SD3.D3_CF,3,1) = '3' THEN SD3.D3_CF || '*' ELSE SD3.D3_CF END) CF "
			cQuery += " ,SD3.D3_DOC NUMDOCTO "
			cQuery += " ,'' SERIE "
			cQuery += " ,SD3.D3_SEQCALC SEQCALC "
			cQuery += " ,SD3.D3_NUMSEQ NUMSEQ "
			cQuery += " ,(CASE WHEN SD3.D3_OP = ' ' AND SD3.D3_PROJPMS = ' ' THEN 'CC' || SD3.D3_CC "
			cQuery += " ELSE (CASE WHEN SD3.D3_PROJPMS <> ' ' THEN 'PJ' || SD3.D3_PROJPMS "
			cQuery += "	ELSE (CASE WHEN SD3.D3_OP <> ' ' AND SUBSTRING(SD3.D3_OP,7,2) <> 'OS' THEN 'OP' || SD3.D3_OP "
			cQuery += "	ELSE 'OS' || COALESCE(STJ.TJ_ORDEM,'') || COALESCE(STJ.TJ_CCUSTO,'') END) END) END) CCPVPJOP "
			cQuery += " ,0 QTDINIT "
			cQuery += " ,0 QTINI2UM "
			cQuery += " ,0 CUSINIT "
			cQuery += " ,0 CUSMINIC "
			cQuery += " ,0 SALDOATU "
			cQuery += " ,0 CUSTOTAL "
			cQuery += " ,SUM(CASE WHEN SD3.D3_TM > '500' THEN SD3.D3_QUANT ELSE 0 END) ENTQTD "
			cQuery += "	,SUM(CASE WHEN SD3.D3_TM > '500' THEN 0 ELSE (SD3.D3_QUANT * (-1)) END) SDAQTD "
			cQuery += "	,SUM(CASE WHEN SD3.D3_TM > '500' THEN SD3.D3_QTSEGUM ELSE 0 END) ENTQTS "
			cQuery += "	,SUM(CASE WHEN SD3.D3_TM > '500' THEN 0 ELSE (SD3.D3_QTSEGUM * (-1)) END) SDAQTS "
			cQuery += "	,SUM(CASE WHEN SD3.D3_TM > '500' THEN "+cFldCus+" ELSE 0 END) ENTCUST "
			cQuery += "	,SUM(CASE WHEN SD3.D3_TM > '500' THEN 0 ELSE "+cFldCus+" END) SDACUST "
			cQuery += " ,SUM(CASE WHEN SD3.D3_QUANT > 0 THEN ("+cFldCus+" / SD3.D3_QUANT) ELSE 0 END) CUSMOV "
			cQuery += " FROM " + RetSqlName("SD3") + " SD3 "
			
			cQuery += " INNER JOIN " + RetSqlName("SB1") + " SB1 "
			cQuery += " ON " + FwJoinFilial("SB1","SD3") 
			if cArqPrd <> "SBZ"
				cQuery += " AND SB1.B1_COD = SD3.D3_COD "
				cQuery += " AND SB1.B1_COD BETWEEN ? AND ? "
				aAdd(aBind,{jParam['MV_PAR01'][1],"S"})
				aAdd(aBind,{jParam['MV_PAR02'][1],"S"})
