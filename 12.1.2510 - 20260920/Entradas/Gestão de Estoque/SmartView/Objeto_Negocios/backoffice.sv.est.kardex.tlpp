		cQuery += if(jParam['MV_PAR11'][1] == 2 .And. lCusUnif, ', NUMSEQ', '')
		cQuery += if(Upper(jParam['MV_PAR09'][1]) == 'D', ', NUMDOCTO, SERIE', '')
		cQuery += if(Upper(jParam['MV_PAR09'][1]) == 'S' .And. jParam['MV_PAR11'][1] <> 1 .And. jParam['MV_PAR11'][1] <> 2 .And. !lCusUnif, ', NUMSEQ', '')
		
		cQuery := changeQuery(cQuery)

		nBind  := 1
		oQuery := FwExecStatement():New(cQuery)
		for nX := 1 To len(aBind)
			if aBind[nX,2] == "A"
				oQuery:setIn(nBind++,aBind[nX,1])
			elseif aBind[nX,2] == "D"
				oQuery:setDate(nBind++,aBind[nX,1])
			elseif aBind[nX,2] == "S"
				oQuery:setString(nBind++,aBind[nX,1])
			elseif aBind[nX,2] == "N"
				oQuery:setNumeric(nBind++,aBind[nX,1])
			endif
		next nX
		
		cAlias := oQuery:OpenAlias()

		oQuery:Destroy()

		cEmpNome := self:getInfoEmp("M0_NOME", aFils[nFil])
		cFilNome := self:getInfoEmp("M0_FILIAL", aFils[nFil])

		while (cAlias)->(!EOF())

			if cArmAux <> (cAlias)->(FILIAL+ARMAZEM) .and. (cAlias)->ARMAZEM <> Repl("*", nTamArm)
				cArmAux	 := (cAlias)->(FILIAL+ARMAZEM)
				cDescArm := GetAdvFVal("NNR","NNR_DESCRI", FWxFilial("NNR",aFils[nFil]) + (cAlias)->ARMAZEM, 1)
			endif

			jItems := JsonObject():New()

			// Etapa para obter o Saldo e Custo Inicial ou Atualização conforme movimentos
			if (cAlias)->TPMOVIM == 'S_INICIAL'
				nCusAtu := (cAlias)->CUSINIT
				nSldAtu := (cAlias)->QTDINIT
				nCusIni := if(nSldAtu <> 0, ( nCusAtu / nSldAtu ), 0)
				(cAlias)->(DbSkip())
				loop
			else
				for nX := 1 to len(aFields)

					cFldName := alltrim(aFields[nX]:getName())
					cFldType := alltrim(aFields[nX]:getType())

					if cFldName == "EMPNOME"
						jItems[cFldName] := cEmpNome
					elseif cFldName == "FILNOME"
						jItems[cFldName] := cFilNome
					elseif cFldName == "DESCARM"
						jItems[cFldName] := cDescArm
					elseif cFldType == "date"
						jItems[cFldName] := totvs.framework.treports.date.stringToTimeStamp((cAlias)->&(cFldName))
					else
						jItems[cFldName] := (cAlias)->&(cFldName)
					endif

				next nX

				if cProdAux <> (cAlias)->(FILIAL+CODPROD+ARMAZEM)
					cProdAux := (cAlias)->(FILIAL+CODPROD+ARMAZEM)
					jItems["CUSINIT"  ] := nCusAtu
					jItems["QTDINIT"  ] := nSldAtu
					jItems["CUSMINIC" ] := nCusIni
					jItems["CUSTOTAL" ] := nCusIni
				endif

				nSldAtu += jItems["ENTQTD"	] - if(jItems["SDAQTD" ] < 0, Abs(jItems["SDAQTD" ]), jItems["SDAQTD"])
				nCusAtu += jItems["ENTCUST" ] - if(jItems["SDACUST"] < 0, Abs(jItems["SDACUST"]), jItems["SDACUST"])

				jItems["SALDOATU"]	:= nSldAtu
				jItems["CUSTOTAL"] 	:= nCusAtu
			endif
			
			self:processData()
			self:appendData(jItems)
			(cAlias)->(DbSkip())
		enddo

		(cAlias)->(DbCloseArea())

	next nFil

return self:oData

/*/{Protheus.doc} onGetSchema
	Método para montar o schema do objeto de negócio
@author Everton Fregonezi Diniz
@since 28/08/2026
@version version
@param param_name, param_type, param_descr
@return return_var, return_type, return_description
/*/
method onGetSchema() class KardexTReportsBusinessObject

local lCanFilter := .F. as logical		// Variável para controlar se habilita o filtro dos campos para utilização na consulta do banco de dados

	self:addProperty("EMPNOME"	, STR0004, "string", STR0004, "EMPNOME"	, , , , lCanFilter	)	// "Nome da Empresa"
	self:addProperty("FILIAL"	, STR0024, "string", STR0024, "FILIAL"	, , , , lCanFilter	)	// "Filial"
    self:addProperty("FILNOME"	, STR0005, "string", STR0005, "FILNOME"	, , , , lCanFilter	)	// "Nome da Filial"
    self:addProperty("CODPROD"	, STR0029, "string", STR0029, "CODPROD"	, , , , lCanFilter	)	// "Produto"
	self:addProperty("DESCPRO"	, STR0047, "string", STR0047, "DESCPRO"	, , , , lCanFilter	)	// "Desc. Prod."
	self:addProperty("ARMAZEM"	, STR0028, "string", STR0028, "ARMAZEM"	, , , , lCanFilter	)	// "Armazém"
	self:addProperty("DESCARM"	, STR0006, "string", STR0006, "DESCARM"	, , , , lCanFilter	)	// "Descrição do Armazém"
	self:addProperty("TIPO"		, STR0048, "string", STR0048, "TIPO"	, , , , lCanFilter	)	// "Tipo Prod."
	self:addProperty("UNIDADE"	, STR0049, "string", STR0049, "UNIDADE"	, , , , lCanFilter	)	// "Unid. Med."
	self:addProperty("GRUPO"	, STR0050, "string", STR0050, "GRUPO"	, , , , lCanFilter	)	// "Grupo Prod."
	self:addProperty("NCM"		, STR0051, "string", STR0051, "NCM"		, , , , lCanFilter	)	// "NCM"
	self:addProperty("TPMOVIM"	, STR0008, "string", STR0008, "TPMOVIM"	, , , , lCanFilter	)	// "Tipo do Movimento"
	self:addProperty("EMISSAO"	, STR0031, "date"  , STR0031, "EMISSAO"	, , , , lCanFilter	)	// "Dt. Emissão"
	self:addProperty("CF"		, STR0033, "string", STR0033, "CF"		, , , , lCanFilter	)	// "Código fiscal"
	self:addProperty("NUMDOCTO"	, STR0035, "string", STR0035, "NUMDOCTO", , , , lCanFilter	)	// "Numero do Documento"
	self:addProperty("SERIE"	, STR0036, "string", STR0036, "SERIE"	, , , , lCanFilter	)	// "Numero de serie"
	self:addProperty("SEQCALC"	, STR0052, "string", STR0052, "SEQCALC"	, , , , lCanFilter	)	// "Sequencia de Cálculo"
	self:addProperty("NUMSEQ"	, STR0030, "string", STR0030, "NUMSEQ"	, , , , lCanFilter	)	// "Sequencia do movimento"
	self:addProperty("CCPVPJOP"	, STR0007, "string", STR0007, "CCPVPJOP", , , , lCanFilter	)	// "Cli, For, CC, PJ, OP ou OS"
	self:addProperty("ENTQTD"	, STR0013, "number", STR0013, "ENTQTD"	, , , , lCanFilter	)	// "Quantidade Entrada"
	self:addProperty("SDAQTD"	, STR0016, "number", STR0016, "SDAQTD"	, , , , lCanFilter	)	// "Quantidade Saída"
	self:addProperty("ENTQTS"	, STR0053, "number", STR0053, "ENTQTS"	, , , , lCanFilter	)	// "Quantidade Entrada 2UM"
	self:addProperty("SDAQTS"	, STR0054, "number", STR0054, "SDAQTS"	, , , , lCanFilter	)	// "Quantidade Saída 2UM"
	self:addProperty("ENTCUST"	, STR0014, "number", STR0014, "ENTCUST"	, , , , lCanFilter	)	// "Custo Entrada"
	self:addProperty("SDACUST"	, STR0017, "number", STR0017, "SDACUST"	, , , , lCanFilter	)	// "Custo Saída"
	self:addProperty("CUSMOV"	, STR0015, "number", STR0015, "CUSMOV"	, , , , lCanFilter	)	// "Custo Médio do Movimento"
	self:addProperty("QTDINIT"	, STR0009, "number", STR0009, "QTDINIT"	, , , , lCanFilter	)	// "Quantidade Inicial"
	self:addProperty("CUSINIT"	, STR0011, "number", STR0011, "CUSINIT"	, , , , lCanFilter	)	// "Custo Inicial"
	self:addProperty("CUSMINIC"	, STR0012, "number", STR0012, "CUSMINIC", , , , lCanFilter	)	// "Custo Médio Inicial"
	self:addProperty("SALDOATU"	, STR0026, "number", STR0026, "SALDOATU", , , , lCanFilter	)	// "Saldo Quantidade"
	self:addProperty("CUSTOTAL"	, STR0021, "number", STR0021, "CUSTOTAL", , , , lCanFilter	)	// "Saldo em valor acumulado"
	self:addProperty("QTINI2UM"	, STR0018, "number", STR0018, "QTINI2UM", , , , lCanFilter	)	// "Quantidade Inicial na 2UM"
	
return

/*/{Protheus.doc} validParam
	Mï¿½todo para avaliar se houve o preenchimento dos parâmetros
	do objeto de negócio para filtro.
@author Everton Fregonezi Diniz
@since 28/08/2026
@version version
@param param_name, param_type, param_descr
@return return_var, return_type, return_description
/*/
method validParam(oFilter as object) as logical class KardexTReportsBusinessObject

local cMsg	:= ""	as character
local lRet	:= .T.	as logical
local jParam		as json

	jParam := oFilter:getParameters()

	if empty(jParam['MV_PAR05'][1])
		cMsg += STR0055	// "Necessário informar a Data Inicial."
	elseif empty(jParam['MV_PAR06'][1])
		cMsg += STR0056	// "Necessário informar a Data Final."
	elseif empty(jParam['MV_PAR07'][1])
		cMsg += STR0057	// "Necessário informar se deseja visualizar produtos sem movimentação para o período."
	elseif empty(jParam['MV_PAR09'][1])
		cMsg += STR0058	// "Necessário informar a sequência de visualização dos resultados."
	elseif empty(jParam['MV_PAR10'][1])
		cMsg += STR0059	// "Necessário informar a Moeda."
	elseif empty(jParam['MV_PAR12'][1])
		cMsg += STR0060	// "Necessário informar se deseja visualizar movimentos de transferências."
	endif

	if !empty(cMsg)
		lRet := .F.
		self:setErrorStatus(400, STR0061, cMsg ) // "Atenção"
	endif

return lRet
