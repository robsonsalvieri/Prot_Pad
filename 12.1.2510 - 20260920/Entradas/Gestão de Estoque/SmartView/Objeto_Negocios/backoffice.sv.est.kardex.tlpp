#include "msobject.ch"
#include "backoffice.sv.est.kardex.ch"
#include "totvs.framework.treports.integratedprovider.th"

//Grupo de perguntas
#define SX1GRUPO "ESTT004"

namespace totvs.protheus.backoffice.est.kardex.integratedprovider

using namespace totvs.protheus.backoffice.est.smartView.integratedProvider

@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGAEST", tables="SB2,SB9,SD1,SD2,SD3", name="Kardex", country="ALL")

/*/{Protheus.doc} className
	Objeto de Negócio para listagem do Kardex Financeiro e Resumo de Movimentações
@author Everton Fregonezi Diniz
@since 28/08/2026
@version version
/*/
class KardexTReportsBusinessObject from totvs.protheus.backoffice.est.smartView.integratedProvider.EstIntegratedProvider

    public method new() as object
    public method getData() as object

	Protected Method onGetSchema()
	Protected Method validParam() as logical

	Protected data lExistPerg	as logical

endclass

/*/{Protheus.doc} new
	Método para instaciamento dos atributos da classe
@author Everton Fregonezi Diniz
@since 28/08/2026
@version version
@param param_name, param_type, param_descr
@return return_var, return_type, return_description
/*/
method new() class KardexTReportsBusinessObject

	 _Super:new()

    //Define a Área
    self:appendArea( STR0001 ) // Estoque/Custos
    
    //Define o nome do Objeto de Negócio
    self:setDisplayName( STR0002 ) // Kardex

	//Define a descrição do Objeto de Negócio
	self:setDescription( STR0003 ) // Emite uma relação com as movimentações dos produtos selecionados, ordenados por sequêcia, cálculo ou dia.

	//Indica o pergunte que será utilizado no relatório
	self:lExistPerg := self:setPergunte( SX1GRUPO )
	If !self:lExistPerg
		self:setErrorStatus(400,STR0023,i18n(STR0022,{SX1GRUPO})) // "Sem pergunte"
		FWLogMsg('WARN', , 'SmartView', , , , i18n(STR0022,{SX1GRUPO}), , , ) // "Grupo de perguntas #1[SX1GRUPO]# nao encontrado. Verifique na tabela SX1, o grupo de perguntas informado"
	EndIf

	//Indica que o LookUp será do tipo padrão LookUp
	self:setIsLookUp(.T.)
	
return self

/*/{Protheus.doc} getData
	Método para executar a consulta e preparação do json para envio 
	ao Smart View
@author Everton Fregonezi Diniz
@since 28/08/2026
@version version
@param param_name, param_type, param_descr
@return return_var, return_type, return_description
/*/
method getData(nPage as numeric, oFilter as object) as object class KardexTReportsBusinessObject

local aBind		as array
local aFields	as array
local aFils		as array
local cAlias	as character
local cArmazem	as character
local cArmAux	as character
local cDescArm	as character
local cFldCus	as character
local cFldName	as character
local cFldType	as character
local cArqPrd	as character
local cEmpNome	as character
local cFilNome	as character
local cLocProc	as character
local cMvCQ		as character
local cMoeda	as character
local cProdAux	as character
local cProdImp	as character
local cQuery	as character
local jItems	as json
local jParam	as json
local lCusFil	as logical
local lCusEmp	as logical
local lCusUnif	as logical
local lCusRep	as logical
local lD3Servi	as logical
local lEstorno	as logical
local lListaDev	as logical
local lLocProc	as logical
local lVeic		as logical
local lWmsNew	as logical
local nBind		as numeric
local nCusAtu	as numeric
local nCusIni	as numeric
local nFil		as numeric
local nSldAtu	as numeric
local nTamArm	as numeric
local nX		as numeric
local oQuery	as object

	/*
		01 - Do Produto ?
		02 - Ate o Produto ?
		03 - Do Tipo ?
		04 - Ate o Tipo ?
		05 - Do Periodo ?
		06 - Ate o Periodo ?
		07 - Lista Prods S/Movim ?: Sim | Não
		08 - Qual Armazem ?:
		09 - (D)oc/(S)equencia ?:
		10 - Qual a Moeda ?: 1a Moeda | 2a Moeda | 3a Moeda | 4a Moeda | 5a Moeda
		11 - Sequencia de Impressao ?: Digitação | Cálculo | Dia
		12 - Lista Transf Ender. ?: Sim | Não 
		13 - Do Grupo ?:
		14 - Ate o Grupo ?:
		15 - Seleciona Filiais ?: Todas Filiais | Filial Corrente
		16 - Qual Custo Imprimir ?: Médio | Reposição
	*/

	//Valida o pergunte
	if !self:lExistPerg
		return self:oData
	endif
	
	// valida o preenchimento de perguntes obrigatórios para o processamento
	if !self:validParam(oFilter)
		return self:oData
	endif

	// Obtém os valores dos parãmetros preenchidos pelo usuário
	jParam	:= oFilter:getParameters()

	// Converte o valor da moeda em caracter, para combinar com campos de custeio de acordo com a moeda selecionada
	cMoeda	:= alltrim(str(jParam['MV_PAR10'][1]))

	// Obtém o Tamanho do campo B2_LOCAL
	nTamArm	:= FWSX3Util():GetFieldStruct("B2_LOCAL")[3]
	cArmazem:= if( !empty(jParam['MV_PAR08'][1]), jParam['MV_PAR08'][1], Repl("*", nTamArm) )

	//Retorno da tela de multi filiais com as filiais selecionadas ou somente a filial corrente
	aFils	:= if(jParam['MV_PAR15'][1] == 1, self:retFils(jParam['SV_MULTBRANCH'], oFilter), {FWxFilial("SD1")})

	// Carrega os campos do schema do objeto de negócio
	aFields := self:getStructFields()

	For nFil := 1 to len(aFils)

		// Reseta os valores das variï¿½veis
		aBind	 := {}
		cArmAux	 := ""
		cDescArm := ""

		//Busca conteúdo dos parâmetros da SX6 na mudança de filial
		cLocProc	:= GetNewPar("MV_LOCPROC", "99" ,aFils[nFil] )
		cArqPrd		:= GetNewPar("MV_ARQPROD","SB1"	,aFils[nFil] )
		cProdImp	:= GetNewPar("MV_PRODIMP",""	,aFils[nFil] )
		cMvCQ		:= GetNewPar("MV_CQ"	 ,"98"	,aFils[nFil] )
		lVeic		:= GetNewPar("MV_VEICULO",.F.	,aFils[nFil] ) == "S"
		lCusFil		:= GetNewPar("MV_CUSFIL" ,"A"	,aFils[nFil] ) == "F" .And. jParam[ 'MV_PAR08' ][1] $ Repl("*",nTamArm)
		lCusEmp		:= GetNewPar("MV_CUSFIL" ,"A"	,aFils[nFil] ) == "E" .And. jParam[ 'MV_PAR08' ][1] $ Repl("#",nTamArm)
		lCusRep		:= GetNewPar("MV_CUSREP" ,.F.	,aFils[nFil] ) .And. MA330AvRep()
		lEstorno	:= GetNewPar("MV_D3ESTOR","N"	,aFils[nFil] ) == "N"
		lWmsNew		:= GetNewPar("MV_WMSNEW" ,.F.	,aFils[nFil] )
		lD3Servi	:= if(lWmsNew, .F., GetNewPar("MV_D3SERVI", "N", aFils[nFil]) == "N")
		lListaDev	:= GetNewPar("MV_LISTDEV",.F.	,aFils[nFil] )
		
		lLocProc	:= jParam['MV_PAR08'][1] == cLocProc
		lCusUnif	:= lCusFil .Or. lCusEmp

		if lCusFil
			cArmazem := Repl("*",nTamArm)
		elseif lCusEmp
			cArmazem := Repl("#",nTamArm)
		endif

		cQuery := " SELECT "
		cQuery += " SB2.B2_FILIAL FILIAL "
		cQuery += " ," + if(lVeic, "SB1.B1_CODITE", "SB1.B1_COD") + " CODPROD"
		cQuery += " ,SB1.B1_DESC DESCPRO "
		cQuery += " ,SB1.B1_TIPO TIPO "
		cQuery += " ,SB1.B1_UM UNIDADE "
		cQuery += " ,SB1.B1_GRUPO GRUPO"
		cQuery += " ,SB1.B1_POSIPI NCM "
		cQuery += "	,'' EMISSAO "
		cQuery += "	," + if(cArmazem == Repl("*", nTamArm) .Or. cArmazem == Repl("#", nTamArm), "'"+cArmazem+"'", "SB2.B2_LOCAL") + " ARMAZEM "
		cQuery += "	,'S_INICIAL' TPMOVIM "
		cQuery += "	,'' CF "
		cQuery += " ,'' NUMDOCTO "
		cQuery += " ,'' SERIE "
		cQuery += " ,'' SEQCALC "
		cQuery += " ,'' NUMSEQ "
		cQuery += " ,'' CCPVPJOP "
		
		cQuery += " ,COALESCE((	SELECT COALESCE(SUM(B9_QINI),0) "
		cQuery += "		FROM "+RetSqlName("SB9")+" SB9 "
		cQuery += "		WHERE " + FwJoinFilial("SB9","SB2")
		cQuery += "		AND SB9.B9_COD = SB1.B1_COD "
		cQuery += "		AND SB9.B9_LOCAL = SB2.B2_LOCAL "
		cQuery += "		AND SB9.B9_DATA = ( "
		cQuery += "		    SELECT MAX(SB9A.B9_DATA) "
		cQuery += "		    FROM "+RetSqlName("SB9")+" SB9A "
		cQuery += "		    WHERE SB9A.B9_FILIAL = SB9.B9_FILIAL "
		cQuery += "		        AND SB9A.B9_COD = SB9.B9_COD "
		cQuery += "		        AND SB9A.B9_LOCAL = SB9.B9_LOCAL "
		cQuery += "		        AND SB9A.B9_DATA < ? "
		aAdd(aBind,{FwDateTimeToLocal( jParam['MV_PAR05'][1] )[1],"D"})
		cQuery += "		        AND SB9A.D_E_L_E_T_ = ? "
		aAdd(aBind,{' ',"S"})
		cQuery += "		    ) "
		cQuery += "		AND SB9.D_E_L_E_T_ = ? "
		aAdd(aBind,{' ',"S"})
		cQuery += "		) + "
		cQuery += " 	(	SELECT COALESCE(SUM(D1_QUANT),0) "
		cQuery += "			FROM "+RetSqlName("SD1")+" SD1 "
		cQuery += " 	       INNER JOIN "+RetSqlName("SF4")+" SF4 "
		cQuery += " 	       ON SF4.F4_FILIAL = SD1.D1_FILIAL "
		cQuery += " 	       AND SF4.F4_CODIGO = SD1.D1_TES "
		cQuery += " 	       AND SF4.F4_ESTOQUE = ? "
		aAdd(aBind,{'S',"S"})
		cQuery += " 	       AND SF4.D_E_L_E_T_ = ? "
		aAdd(aBind,{' ',"S"})
		cQuery += "			WHERE SD1.D1_FILIAL = SB2.B2_FILIAL "
		cQuery += "			AND SD1.D1_COD = SB1.B1_COD "
		cQuery += "			AND SD1.D1_LOCAL = SB2.B2_LOCAL "
		cQuery += "			AND SD1.D1_DTDIGIT < ? "
		aAdd(aBind,{FwDateTimeToLocal( jParam['MV_PAR05'][1] )[1],"D"})
		cQuery += "			AND SD1.D1_ORIGLAN <> ? "
		aAdd(aBind,{'LF',"S"})
		cQuery += "			AND SD1.D_E_L_E_T_ = ? "
		aAdd(aBind,{' ',"S"})
		cQuery += " 	   ) - "
		cQuery += " 	(	SELECT COALESCE(SUM(D2_QUANT),0) "
		cQuery += " 	   	FROM "+RetSqlName("SD2")+" SD2 "
		cQuery += " 	       INNER JOIN "+RetSqlName("SF4")+" SF4 "
		cQuery += " 	       ON SF4.F4_FILIAL = SD2.D2_FILIAL "
		cQuery += " 	       AND SF4.F4_CODIGO = SD2.D2_TES "
		cQuery += " 	       AND SF4.F4_ESTOQUE = ? "
		aAdd(aBind,{'S',"S"})
		cQuery += " 	       AND SF4.D_E_L_E_T_ = ? "
		aAdd(aBind,{' ',"S"})
		cQuery += "			WHERE " + FwJoinFilial("SD2","SB2")
		cQuery += "			AND SD2.D2_COD = SB1.B1_COD "
		cQuery += "			AND SD2.D2_LOCAL = SB2.B2_LOCAL "
		cQuery += "			AND SD2.D2_EMISSAO < ? "
		aAdd(aBind,{FwDateTimeToLocal( jParam['MV_PAR05'][1] )[1],"D"})
		cQuery += "			AND SD2.D2_ORIGLAN <> ? "
		aAdd(aBind,{'LF',"S"})
		cQuery += "			AND SD2.D2_REMITO = ? "
		aAdd(aBind,{' ',"S"})
		cQuery += "			AND SD2.D2_TPDCENV IN (?) "
		aAdd(aBind,{{' ','A','1'},"A"})
		cQuery += "			AND SD2.D_E_L_E_T_ = ? "
		aAdd(aBind,{' ',"S"})
        cQuery += "		) + "
		cQuery += "     (	SELECT COALESCE(SUM(CASE WHEN SD3.D3_TM > '500' THEN (SD3.D3_QUANT * (-1)) ELSE SD3.D3_QUANT END),0) "
		cQuery += "			FROM "+RetSqlName("SD3")+" SD3 "
		cQuery += "			WHERE " + FwJoinFilial("SD3","SB2")
		cQuery += "			AND SD3.D3_COD = SB1.B1_COD "
		cQuery += "			AND SD3.D3_LOCAL = SB2.B2_LOCAL "
		cQuery += "			AND SD3.D3_EMISSAO < ? "
		aAdd(aBind,{FwDateTimeToLocal( jParam['MV_PAR05'][1] )[1],"D"})
		if lEstorno
			cQuery += "			AND SD3.D3_ESTORNO <> ? "
			aAdd(aBind,{'S',"S"})
		endif
		if lLocProc
			cQuery += "		) + "
			cQuery += "     (	SELECT COALESCE(SUM(CASE WHEN SD3.D3_TM > '500' THEN SD3.D3_QUANT ELSE (SD3.D3_QUANT * (-1)) END),0) "
			cQuery += "			FROM "+RetSqlName("SD3")+" SD3 "
			cQuery += "			WHERE " + FwJoinFilial("SD3","SB2")
			cQuery += "			AND SD3.D3_COD = SB1.B1_COD "
			cQuery += "			AND SD3.D3_LOCAL <> ? "
			aAdd(aBind,{cLocProc,"S"})
			cQuery += "			AND SUBSTRING(SD3.D3_CF, 3, 1) = ? "
			aAdd(aBind,{'3',"S"})
			cQuery += "			AND SD3.D3_EMISSAO < ? "
			aAdd(aBind,{FwDateTimeToLocal( jParam['MV_PAR05'][1] )[1],"D"})
			if lEstorno
				cQuery += "			AND SD3.D3_ESTORNO <> ? "
				aAdd(aBind,{'S',"S"})
			endif
		endif
		cQuery += "		), 0) QTDINIT "
		
		cQuery += " ,COALESCE((	SELECT COALESCE(SUM(B9_QISEGUM),0) "
		cQuery += "		FROM "+RetSqlName("SB9")+" SB9 "
		cQuery += "		WHERE " + FwJoinFilial("SB9","SB2")
		cQuery += "		AND SB9.B9_COD = SB1.B1_COD "
		cQuery += "		AND SB9.B9_LOCAL = SB2.B2_LOCAL "
		cQuery += "		AND SB9.B9_DATA = ( "
		cQuery += "		    SELECT MAX(SB9A.B9_DATA) "
		cQuery += "		    FROM "+RetSqlName("SB9")+" SB9A "
		cQuery += "		    WHERE SB9A.B9_FILIAL = SB9.B9_FILIAL "
		cQuery += "		        AND SB9A.B9_COD = SB9.B9_COD "
		cQuery += "		        AND SB9A.B9_LOCAL = SB9.B9_LOCAL "
		cQuery += "		        AND SB9A.B9_DATA < ? "
		aAdd(aBind,{FwDateTimeToLocal( jParam['MV_PAR05'][1] )[1],"D"})
		cQuery += "		        AND SB9A.D_E_L_E_T_ = ? "
		aAdd(aBind,{' ',"S"})
		cQuery += "		    ) "
		cQuery += "		AND SB9.D_E_L_E_T_ = ? "
		aAdd(aBind,{' ',"S"})
		cQuery += "		) + "
		cQuery += " 	(	SELECT COALESCE(SUM(D1_QTSEGUM),0) "
		cQuery += "			FROM "+RetSqlName("SD1")+" SD1 "
		cQuery += " 	       INNER JOIN "+RetSqlName("SF4")+" SF4 "
		cQuery += " 	       ON SF4.F4_FILIAL = SD1.D1_FILIAL "
		cQuery += " 	       AND SF4.F4_CODIGO = SD1.D1_TES "
		cQuery += " 	       AND SF4.F4_ESTOQUE = ? "
		aAdd(aBind,{'S',"S"})
		cQuery += " 	       AND SF4.D_E_L_E_T_ = ? "
		aAdd(aBind,{' ',"S"})
		cQuery += "			WHERE SD1.D1_FILIAL = SB2.B2_FILIAL "
		cQuery += "			AND SD1.D1_COD = SB1.B1_COD "
		cQuery += "			AND SD1.D1_LOCAL = SB2.B2_LOCAL "
		cQuery += "			AND SD1.D1_DTDIGIT < ? "
		aAdd(aBind,{FwDateTimeToLocal( jParam['MV_PAR05'][1] )[1],"D"})
		cQuery += "			AND SD1.D1_ORIGLAN <> ? "
		aAdd(aBind,{'LF',"S"})
		cQuery += "			AND SD1.D_E_L_E_T_ = ? "
		aAdd(aBind,{' ',"S"})
		cQuery += " 	   ) - "
		cQuery += " 	(	SELECT COALESCE(SUM(D2_QTSEGUM),0) "
		cQuery += " 	   	FROM "+RetSqlName("SD2")+" SD2 "
		cQuery += " 	       INNER JOIN "+RetSqlName("SF4")+" SF4 "
		cQuery += " 	       ON SF4.F4_FILIAL = SD2.D2_FILIAL "
		cQuery += " 	       AND SF4.F4_CODIGO = SD2.D2_TES "
		cQuery += " 	       AND SF4.F4_ESTOQUE = ? "
		aAdd(aBind,{'S',"S"})
		cQuery += " 	       AND SF4.D_E_L_E_T_ = ? "
		aAdd(aBind,{' ',"S"})
		cQuery += "			WHERE " + FwJoinFilial("SD2","SB2")
		cQuery += "			AND SD2.D2_COD = SB1.B1_COD "
		cQuery += "			AND SD2.D2_LOCAL = SB2.B2_LOCAL "
		cQuery += "			AND SD2.D2_EMISSAO < ? "
		aAdd(aBind,{FwDateTimeToLocal( jParam['MV_PAR05'][1] )[1],"D"})
		cQuery += "			AND SD2.D2_ORIGLAN <> ? "
		aAdd(aBind,{'LF',"S"})
		cQuery += "			AND SD2.D2_REMITO = ? "
		aAdd(aBind,{' ',"S"})
		cQuery += "			AND SD2.D2_TPDCENV IN (?) "
		aAdd(aBind,{{' ','A','1'},"A"})
		cQuery += "			AND SD2.D_E_L_E_T_ = ? "
		aAdd(aBind,{' ',"S"})
		cQuery += "		) + "
		cQuery += "     (	SELECT COALESCE(SUM(CASE WHEN SD3.D3_TM > '500' THEN (SD3.D3_QTSEGUM * (-1)) ELSE SD3.D3_QTSEGUM END),0) "
		cQuery += "			FROM "+RetSqlName("SD3")+" SD3 "
		cQuery += "			WHERE " + FwJoinFilial("SD3","SB2")
		cQuery += "			AND SD3.D3_COD = SB1.B1_COD "
		cQuery += "			AND SD3.D3_LOCAL = SB2.B2_LOCAL "
		cQuery += "			AND SD3.D3_EMISSAO < ? "
		aAdd(aBind,{FwDateTimeToLocal( jParam['MV_PAR05'][1] )[1],"D"})
		if lEstorno
			cQuery += "			AND SD3.D3_ESTORNO <> ? "
			aAdd(aBind,{'S',"S"})
		endif
		if lLocProc
			cQuery += "		) + "
			cQuery += "     (	SELECT COALESCE(SUM(CASE WHEN SD3.D3_TM > '500' THEN SD3.D3_QTSEGUM ELSE (SD3.D3_QTSEGUM * (-1)) END),0) "
			cQuery += "			FROM "+RetSqlName("SD3")+" SD3 "
			cQuery += "			WHERE " + FwJoinFilial("SD3","SB2")
			cQuery += "			AND SD3.D3_COD = SB1.B1_COD "
			cQuery += "			AND SD3.D3_LOCAL <> ? "
			aAdd(aBind,{cLocProc,"S"})
			cQuery += "			AND SUBSTRING(SD3.D3_CF, 3, 1) = ? "
			aAdd(aBind,{'3',"S"})
			cQuery += "			AND SD3.D3_EMISSAO < ? "
			aAdd(aBind,{FwDateTimeToLocal( jParam['MV_PAR05'][1] )[1],"D"})
			if lEstorno
				cQuery += "			AND SD3.D3_ESTORNO <> ? "
				aAdd(aBind,{'S',"S"})
			endif
		endif
		cQuery += "		), 0) QTINI2UM "
		
		cFldCus := if(jParam['MV_PAR16'][1] == 2 .And. lCusRep,"SB9.B9_CMRP","SB9.B9_VINI") + cMoeda
		cQuery += " ,COALESCE((	SELECT COALESCE(SUM("+cFldCus+"),0) "
		cQuery += "		FROM "+RetSqlName("SB9")+" SB9 "
		cQuery += "		WHERE " + FwJoinFilial("SB9","SB2")
		cQuery += "		AND SB9.B9_COD = SB1.B1_COD "
		cQuery += "		AND SB9.B9_LOCAL = SB2.B2_LOCAL "
		cQuery += "		AND SB9.B9_DATA = ( "
		cQuery += "		    SELECT MAX(SB9A.B9_DATA) "
		cQuery += "		    FROM "+RetSqlName("SB9")+" SB9A "
		cQuery += "		    WHERE SB9A.B9_FILIAL = SB9.B9_FILIAL "
		cQuery += "		        AND SB9A.B9_COD = SB9.B9_COD "
		cQuery += "		        AND SB9A.B9_LOCAL = SB9.B9_LOCAL "
		cQuery += "		        AND SB9A.B9_DATA < ? "
		aAdd(aBind,{FwDateTimeToLocal( jParam['MV_PAR05'][1] )[1],"D"})
		cQuery += "		        AND SB9A.D_E_L_E_T_ = ? "
		aAdd(aBind,{' ',"S"})
		cQuery += "		    ) "
		cQuery += "		AND SB9.D_E_L_E_T_ = ? "
		aAdd(aBind,{' ',"S"})
		cQuery += "		) + "
		
		cFldCus := if(jParam['MV_PAR16'][1] == 2 .And. lCusRep, "SD1.D1_CUSRP" + cMoeda, "SD1.D1_CUSTO" + if( jParam['MV_PAR10'][1] > 1, cMoeda,""))
		cQuery += " 	(	SELECT COALESCE(SUM("+cFldCus+"),0) "
		cQuery += "			FROM "+RetSqlName("SD1")+" SD1 "
		cQuery += " 	       INNER JOIN "+RetSqlName("SF4")+" SF4 "
		cQuery += " 	       ON SF4.F4_FILIAL = SD1.D1_FILIAL "
		cQuery += " 	       AND SF4.F4_CODIGO = SD1.D1_TES "
		cQuery += " 	       AND SF4.F4_ESTOQUE = ? "
		aAdd(aBind,{'S',"S"})
		cQuery += " 	       AND SF4.D_E_L_E_T_ = ? "
		aAdd(aBind,{' ',"S"})
		cQuery += "			WHERE SD1.D1_FILIAL = SB2.B2_FILIAL "
		cQuery += "			AND SD1.D1_COD = SB1.B1_COD "
		cQuery += "			AND SD1.D1_LOCAL = SB2.B2_LOCAL "
		cQuery += "			AND SD1.D1_DTDIGIT < ? "
		aAdd(aBind,{FwDateTimeToLocal( jParam['MV_PAR05'][1] )[1],"D"})
		cQuery += "			AND SD1.D1_ORIGLAN <> ? "
		aAdd(aBind,{'LF',"S"})
		cQuery += "			AND SD1.D_E_L_E_T_ = ? "
		aAdd(aBind,{' ',"S"})
		cQuery += " 	   ) - "

		cFldCus := if(jParam['MV_PAR16'][1] == 2 .And. lCusRep, "SD2.D2_CUSRP", "SD2.D2_CUSTO") + cMoeda
		cQuery += " 	(	SELECT COALESCE(SUM("+cFldCus+"),0) "
		cQuery += " 	   	FROM "+RetSqlName("SD2")+" SD2 "
		cQuery += " 	       INNER JOIN "+RetSqlName("SF4")+" SF4 "
		cQuery += " 	       ON SF4.F4_FILIAL = SD2.D2_FILIAL "
		cQuery += " 	       AND SF4.F4_CODIGO = SD2.D2_TES "
		cQuery += " 	       AND SF4.F4_ESTOQUE = ? "
		aAdd(aBind,{'S',"S"})
		cQuery += " 	       AND SF4.D_E_L_E_T_ = ? "
		aAdd(aBind,{' ',"S"})
		cQuery += "			WHERE " + FwJoinFilial("SD2","SB2")
		cQuery += "			AND SD2.D2_COD = SB1.B1_COD "
		cQuery += "			AND SD2.D2_LOCAL = SB2.B2_LOCAL "
		cQuery += "			AND SD2.D2_EMISSAO < ? "
		aAdd(aBind,{FwDateTimeToLocal( jParam['MV_PAR05'][1] )[1],"D"})
		cQuery += "			AND SD2.D2_ORIGLAN <> ? "
		aAdd(aBind,{'LF',"S"})
		cQuery += "			AND SD2.D2_REMITO = ? "
		aAdd(aBind,{' ',"S"})
		cQuery += "			AND SD2.D2_TPDCENV IN (?) "
		aAdd(aBind,{{' ','A','1'},"A"})
		cQuery += "			AND SD2.D_E_L_E_T_ = ? "
		aAdd(aBind,{' ',"S"})
        cQuery += "		) + "

		cFldCus := if(jParam['MV_PAR16'][1] == 2 .And. lCusRep, "SD3.D3_CUSRP", "SD3.D3_CUSTO") + cMoeda
		cQuery += "     (	SELECT COALESCE(SUM(CASE WHEN SD3.D3_TM > '500' THEN ("+cFldCus+" * (-1)) ELSE "+cFldCus+" END),0) "
		cQuery += "			FROM "+RetSqlName("SD3")+" SD3 "
		cQuery += "			WHERE " + FwJoinFilial("SD3","SB2")
		cQuery += "			AND SD3.D3_COD = SB1.B1_COD "
		cQuery += "			AND SD3.D3_LOCAL = SB2.B2_LOCAL "
		cQuery += "			AND SD3.D3_EMISSAO < ? "
		aAdd(aBind,{FwDateTimeToLocal( jParam['MV_PAR05'][1] )[1],"D"})
		if lEstorno
			cQuery += "			AND SD3.D3_ESTORNO <> ? "
			aAdd(aBind,{'S',"S"})
		endif
		if lLocProc
			cQuery += "		) + "
			cQuery += "     (	SELECT COALESCE(SUM(CASE WHEN SD3.D3_TM > '500' THEN "+cFldCus+" ELSE ("+cFldCus+" * (-1)) END),0) "
			cQuery += "			FROM "+RetSqlName("SD3")+" SD3 "
			cQuery += "			WHERE " + FwJoinFilial("SD3","SB2")
			cQuery += "			AND SD3.D3_COD = SB1.B1_COD "
			cQuery += "			AND SD3.D3_LOCAL <> ? "
			aAdd(aBind,{cLocProc,"S"})
			cQuery += "			AND SUBSTRING(SD3.D3_CF, 3, 1) = ? "
			aAdd(aBind,{'3',"S"})
			cQuery += "			AND SD3.D3_EMISSAO < ? "
			aAdd(aBind,{FwDateTimeToLocal( jParam['MV_PAR05'][1] )[1],"D"})
			if lEstorno
				cQuery += "			AND SD3.D3_ESTORNO <> ? "
				aAdd(aBind,{'S',"S"})
			endif
		endif
		cQuery += "		), 0) CUSINIT "
		cQuery += " ,0 CUSMINIC "
		cQuery += " ,0 SALDOATU "
		cQuery += " ,0 CUSTOTAL "
		cQuery += "	,0 ENTQTD "
		cQuery += " ,0 SDAQTD "
		cQuery += " ,0 ENTQTS "
		cQuery += " ,0 SDAQTS "
		cQuery += " ,0 ENTCUST "
		cQuery += " ,0 SDACUST "
		cQuery += " ,0 CUSMOV "
		cQuery += " FROM " + RetSqlName("SB2") + " SB2 "

		cQuery += " INNER JOIN " + RetSqlName("SB1") + " SB1 "
		cQuery += " ON " + FwJoinFilial("SB1","SB2") 
		if cArqPrd <> "SBZ"
			cQuery += " AND SB1.B1_COD = SB2.B2_COD "
			cQuery += " AND SB1.B1_COD BETWEEN ? AND ? "
			aAdd(aBind,{jParam['MV_PAR01'][1],"S"})
			aAdd(aBind,{jParam['MV_PAR02'][1],"S"})
		endif
		cQuery += " AND SB1.B1_TIPO BETWEEN ? AND ? "
		aAdd(aBind,{jParam['MV_PAR03'][1],"S"})
		aAdd(aBind,{jParam['MV_PAR04'][1],"S"})
		cQuery += " AND SB1.B1_GRUPO BETWEEN ? AND ? "    
		aAdd(aBind,{jParam['MV_PAR13'][1],"S"})
		aAdd(aBind,{jParam['MV_PAR14'][1],"S"})
		cQuery += " AND SB1.D_E_L_E_T_ = ? "
		aAdd(aBind,{' ',"S"})
		
		if cArqPrd == "SBZ"
			cQuery += " INNER JOIN " + RetSqlName("SBZ") + " SBZ "
			cQuery += " ON " + FwJoinFilial("SBZ","SB1") 
			cQuery += " AND SBZ.BZ_COD = SB1.B1_COD "
			cQuery += " AND SBZ.BZ_COD BETWEEN ? AND ? "
			aAdd(aBind,{jParam['MV_PAR01'][1],"S"})
			aAdd(aBind,{jParam['MV_PAR02'][1],"S"})
			cQuery += " AND SBZ.D_E_L_E_T_ = ? "
			aAdd(aBind,{' ',"S"})
		endif

		cQuery += " WHERE "
		cQuery += " 	SB2.B2_FILIAL = ? "
		aAdd(aBind,{aFils[nFil],"S"})
		cQuery += " 	AND SB2.B2_COD <> ? "
		aAdd(aBind,{cProdImp,"S"})

		if !lCusUnif .And. cArmazem <> Repl("*", nTamArm) .And. cArmazem <> Repl("#", nTamArm)
			cQuery += " 	AND SB2.B2_LOCAL = ? "
			aAdd(aBind,{cArmazem,"S"})
		endif
		
		cQuery += "     AND SB2.D_E_L_E_T_ = ? "
		aAdd(aBind,{' ',"S"})
		
		cQuery += " GROUP BY SB2.B2_FILIAL, SB1.B1_COD"+if(lVeic, ", SB1.B1_CODITE", "")+", SB1.B1_DESC, SB1.B1_TIPO, SB1.B1_UM, SB1.B1_GRUPO, SB1.B1_POSIPI, SB2.B2_LOCAL "

		cQuery += " UNION ALL "
		
		cFldCus := if(jParam['MV_PAR16'][1] == 2 .And. lCusRep, "SD1.D1_CUSRP" + cMoeda, "SD1.D1_CUSTO" + if( jParam['MV_PAR10'][1] > 1, cMoeda,""))
		cQuery += " SELECT "
		cQuery += " SD1.D1_FILIAL FILIAL "
		cQuery += " ," + if(lVeic, "SB1.B1_CODITE", "SB1.B1_COD") + " CODPROD"
		cQuery += " ,SB1.B1_DESC DESCPRO "
		cQuery += " ,SB1.B1_TIPO TIPO "
		cQuery += " ,SB1.B1_UM UNIDADE "
		cQuery += " ,SB1.B1_GRUPO GRUPO"
		cQuery += " ,SB1.B1_POSIPI NCM "
		cQuery += " ,SD1.D1_DTDIGIT EMISSAO "
		cQuery += "	," + if(cArmazem == Repl("*", nTamArm) .Or. cArmazem == Repl("#", nTamArm), "'"+cArmazem+"'", "SD1.D1_LOCAL") + " ARMAZEM "
		cQuery += " ,SD1.D1_TES TPMOVIM "
		cQuery += " ,SD1.D1_CF CF "
		cQuery += " ,SD1.D1_DOC NUMDOCTO "
		cQuery += " ,SD1.D1_SERIE SERIE "
		cQuery += " ,SD1.D1_SEQCALC SEQCALC "
		cQuery += " ,SD1.D1_NUMSEQ NUMSEQ "
		cQuery += "	,(CASE SD1.D1_TIPO WHEN 'D' THEN 'C-' ELSE 'F-' END) || SD1.D1_FORNECE CCPVPJOP "
		cQuery += " ,0 QTDINIT "
		cQuery += " ,0 QTINI2UM "
		cQuery += " ,0 CUSINIT "
		cQuery += " ,0 CUSMINIC "
		cQuery += " ,0 SALDOATU "
		cQuery += " ,0 CUSTOTAL "
		cQuery += " ,SUM(CASE SD1.D1_TIPO WHEN 'D' THEN 0 ELSE SD1.D1_QUANT END) ENTQTD "
		cQuery += "	,SUM(CASE SD1.D1_TIPO WHEN 'D' THEN (SD1.D1_QUANT * (-1)) ELSE 0 END) SDAQTD "
		cQuery += " ,SUM(CASE SD1.D1_TIPO WHEN 'D' THEN 0 ELSE SD1.D1_QTSEGUM END) ENTQTS "
		cQuery += " ,SUM(CASE SD1.D1_TIPO WHEN 'D' THEN (SD1.D1_QTSEGUM * (-1)) ELSE 0 END) SDAQTS "
		cQuery += " ,SUM(CASE SD1.D1_TIPO WHEN 'D' THEN 0 ELSE "+cFldCus+" END) ENTCUST "
		cQuery += " ,SUM(CASE SD1.D1_TIPO WHEN 'D' THEN ("+cFldCus+" * (-1)) ELSE 0 END) SDACUST "
		cQuery += "	,SUM(CASE WHEN SD1.D1_QUANT > 0 THEN ("+cFldCus+" / SD1.D1_QUANT) ELSE 0 END ) CUSMOV "
		cQuery += " FROM " + RetSqlName("SD1") + " SD1 "

		cQuery += " INNER JOIN " + RetSqlName("SB1") + " SB1 "
		cQuery += " ON " + FwJoinFilial("SB1","SD1") 
		if cArqPrd <> "SBZ"
			cQuery += " AND SB1.B1_COD = SD1.D1_COD "
			cQuery += " AND SB1.B1_COD BETWEEN ? AND ? "
			aAdd(aBind,{jParam['MV_PAR01'][1],"S"})
			aAdd(aBind,{jParam['MV_PAR02'][1],"S"})
		endif
		cQuery += " AND SB1.B1_TIPO BETWEEN ? AND ? "
		aAdd(aBind,{jParam['MV_PAR03'][1],"S"})
		aAdd(aBind,{jParam['MV_PAR04'][1],"S"})
		cQuery += " AND SB1.B1_GRUPO BETWEEN ? AND ? "    
		aAdd(aBind,{jParam['MV_PAR13'][1],"S"})
		aAdd(aBind,{jParam['MV_PAR14'][1],"S"})
		cQuery += " AND SB1.D_E_L_E_T_ = ? "
		aAdd(aBind,{' ',"S"})
		
		if cArqPrd == "SBZ"
			cQuery += " INNER JOIN " + RetSqlName("SBZ") + " SBZ "
			cQuery += " ON " + FwJoinFilial("SBZ","SB1") 
			cQuery += " AND SBZ.BZ_COD = SB1.B1_COD "
			cQuery += " AND SBZ.BZ_COD BETWEEN ? AND ? "
			aAdd(aBind,{jParam['MV_PAR01'][1],"S"})
			aAdd(aBind,{jParam['MV_PAR02'][1],"S"})
			cQuery += " AND SBZ.D_E_L_E_T_ = ? "
			aAdd(aBind,{' ',"S"})
		endif

		cQuery += " INNER JOIN " + RetSqlName("SF4") + " SF4 "
		cQuery += "     ON " + FwJoinFilial("SF4","SD1") 
		cQuery += " 	AND SF4.F4_CODIGO = SD1.D1_TES "
		cQuery += " 	AND SF4.F4_ESTOQUE = ? "
		aAdd(aBind,{"S","S"})
		cQuery += "     AND SF4.D_E_L_E_T_ = ? "
		aAdd(aBind,{' ',"S"})
		
		cQuery += " WHERE "
		cQuery += "     SD1.D1_FILIAL = ? "
		aAdd(aBind,{aFils[nFil],"S"})
		cQuery += " 	AND SD1.D1_COD <> ? "
		aAdd(aBind,{cProdImp,"S"})
		if !lCusUnif .And. cArmazem <> Repl("*", nTamArm) .And. cArmazem <> Repl("#", nTamArm)
			cQuery += " 	AND SD1.D1_LOCAL = ? "
			aAdd(aBind,{cArmazem,"S"})
		endif
		cQuery += " 	AND SD1.D1_DTDIGIT BETWEEN ? AND ? "
		aAdd(aBind,{FwDateTimeToLocal( jParam['MV_PAR05'][1] )[1],"D"})
		aAdd(aBind,{FwDateTimeToLocal( jParam['MV_PAR06'][1] )[1],"D"})
		if !lListaDev
			cQuery += " 	AND SD1.D1_TIPO <> ? "
			aAdd(aBind,{'D',"S"})
		endif
		cQuery += " 	AND SD1.D1_ORIGLAN != ? "
		aAdd(aBind,{'LF',"S"})
		cQuery += "     AND SD1.D_E_L_E_T_ = ? "
		aAdd(aBind,{' ',"S"})

		cQuery += " GROUP BY SD1.D1_FILIAL, SB1.B1_COD"+if(lVeic, ", SB1.B1_CODITE", "")+", SB1.B1_DESC, SB1.B1_TIPO, SB1.B1_UM, SB1.B1_GRUPO, SB1.B1_POSIPI, SD1.D1_DTDIGIT, SD1.D1_TIPO "
		cQuery += if(cArmazem == Repl("*", nTamArm) .And. cArmazem <> Repl("#", nTamArm), "", ", SD1.D1_LOCAL")+", SD1.D1_TES, SD1.D1_CF, SD1.D1_DOC, SD1.D1_SERIE, SD1.D1_SEQCALC, SD1.D1_NUMSEQ, SD1.D1_FORNECE"

		cQuery += " UNION ALL "

		cFldCus := if(jParam['MV_PAR16'][1] == 2 .And. lCusRep, "SD3.D3_CUSRP", "SD3.D3_CUSTO") + cMoeda
		cQuery += " SELECT "
		cQuery += " SD3.D3_FILIAL FILIAL "
		cQuery += " ," + if(lVeic, "SB1.B1_CODITE", "SB1.B1_COD") + " CODPROD"
		cQuery += " ,SB1.B1_DESC DESCPRO "
		cQuery += " ,SB1.B1_TIPO TIPO "
		cQuery += " ,SB1.B1_UM UNIDADE "
		cQuery += " ,SB1.B1_GRUPO GRUPO"
		cQuery += " ,SB1.B1_POSIPI NCM "
		cQuery += "	,SD3.D3_EMISSAO AS EMISSAO "
		cQuery += "	," + if(cArmazem == Repl("*", nTamArm) .Or. cArmazem == Repl("#", nTamArm), "'"+cArmazem+"'", "SD3.D3_LOCAL") + " ARMAZEM "
		cQuery += "	,SD3.D3_TM TPMOVIM "
		cQuery += "	,SD3.D3_CF CF "
		cQuery += " ,SD3.D3_DOC NUMDOCTO "
		cQuery += " ,'' SERIE "
		cQuery += " ,SD3.D3_SEQCALC SEQCALC "
		cQuery += " ,SD3.D3_NUMSEQ NUMSEQ "
		cQuery += " ,(CASE WHEN SD3.D3_OP = ' ' AND SD3.D3_PROJPMS = ' ' THEN 'CC' || SD3.D3_CC "
		cQuery += " ELSE (CASE WHEN SD3.D3_PROJPMS <> ' ' THEN 'PJ' || SD3.D3_PROJPMS "
		cQuery += "	ELSE (CASE WHEN SD3.D3_OP <> ' ' AND SUBSTRING(SD3.D3_OP,7,2) <> 'OS' THEN 'OP' || SD3.D3_OP "
		cQuery += "	ELSE 'OS' || COALESCE(STJ.TJ_ORDEM,'') || COALESCE(STJ.TJ_CCUSTO,'') END) END) END) CCPVPJOP "
		cQuery += " ,0 QTDINIT "
		cQuery += " ,0 QTINI2UM "
		cQuery += " ,0 CUSINIT "
		cQuery += " ,0 CUSMINIC "
		cQuery += " ,0 SALDOATU "
		cQuery += " ,0 CUSTOTAL "
		cQuery += " ,SUM(CASE WHEN SD3.D3_TM > '500' THEN 0 ELSE SD3.D3_QUANT END) ENTQTD "
		cQuery += "	,SUM(CASE WHEN SD3.D3_TM > '500' THEN SD3.D3_QUANT ELSE 0 END) SDAQTD "
		cQuery += "	,SUM(CASE WHEN SD3.D3_TM > '500' THEN 0 ELSE SD3.D3_QTSEGUM END) ENTQTS "
		cQuery += "	,SUM(CASE WHEN SD3.D3_TM > '500' THEN SD3.D3_QTSEGUM ELSE 0 END) SDAQTS "
		cQuery += "	,SUM(CASE WHEN SD3.D3_TM > '500' THEN 0 ELSE "+cFldCus+" END) ENTCUST "
		cQuery += "	,SUM(CASE WHEN SD3.D3_TM > '500' THEN "+cFldCus+" ELSE 0 END) SDACUST "
		cQuery += " ,SUM(CASE WHEN SD3.D3_QUANT > 0 THEN ("+cFldCus+" / SD3.D3_QUANT) ELSE 0 END) CUSMOV "
		cQuery += " FROM " + RetSqlName("SD3") + " SD3 "
		
		cQuery += " INNER JOIN " + RetSqlName("SB1") + " SB1 "
		cQuery += " ON " + FwJoinFilial("SB1","SD3") 
		if cArqPrd <> "SBZ"
			cQuery += " AND SB1.B1_COD = SD3.D3_COD "
			cQuery += " AND SB1.B1_COD BETWEEN ? AND ? "
			aAdd(aBind,{jParam['MV_PAR01'][1],"S"})
			aAdd(aBind,{jParam['MV_PAR02'][1],"S"})
		endif
		cQuery += " AND SB1.B1_TIPO BETWEEN ? AND ? "
		aAdd(aBind,{jParam['MV_PAR03'][1],"S"})
		aAdd(aBind,{jParam['MV_PAR04'][1],"S"})
		cQuery += " AND SB1.B1_GRUPO BETWEEN ? AND ? "    
		aAdd(aBind,{jParam['MV_PAR13'][1],"S"})
		aAdd(aBind,{jParam['MV_PAR14'][1],"S"})
		cQuery += " AND SB1.D_E_L_E_T_ = ? "
		aAdd(aBind,{' ',"S"})
		
		if cArqPrd == "SBZ"
			cQuery += " INNER JOIN " + RetSqlName("SBZ") + " SBZ "
			cQuery += " ON " + FwJoinFilial("SBZ","SB1") 
			cQuery += " AND SBZ.BZ_COD = SB1.B1_COD "
			cQuery += " AND SBZ.BZ_COD BETWEEN ? AND ? "
			aAdd(aBind,{jParam['MV_PAR01'][1],"S"})
			aAdd(aBind,{jParam['MV_PAR02'][1],"S"})
			cQuery += " AND SBZ.D_E_L_E_T_ = ? "
			aAdd(aBind,{' ',"S"})
		endif

		cQuery += " LEFT JOIN " +  RetSqlName("STJ") + " STJ "
		cQuery += " ON " + FwJoinFilial("STJ","SD3")
		cQuery += " AND STJ.TJ_ORDEM = SUBSTRING(SD3.D3_OP,1,6) "
		cQuery += " AND STJ.D_E_L_E_T_ = ? "
		aAdd(aBind,{' ',"S"})

		cQuery += " WHERE "
		cQuery += "     SD3.D3_FILIAL = ? "
		aAdd(aBind,{aFils[nFil],"S"})
		cQuery += " 	AND SD3.D3_COD <> ? "
		aAdd(aBind,{cProdImp,"S"})

		if !lCusUnif .And. cArmazem <> Repl("*", nTamArm) .And. cArmazem <> Repl("#", nTamArm)
			cQuery += " 	AND SD3.D3_LOCAL = ? "
			aAdd(aBind,{cArmazem,"S"})
		endif
		
		cQuery += " 	AND SD3.D3_EMISSAO BETWEEN ? AND ? "
		aAdd(aBind,{FwDateTimeToLocal( jParam['MV_PAR05'][1] )[1],"D"})
		aAdd(aBind,{FwDateTimeToLocal( jParam['MV_PAR06'][1] )[1],"D"})
		
		if jParam['MV_PAR12'][1] == 2
			cQuery += " 	AND SUBSTRING(SD3.D3_CF,3,1) <> ? "
