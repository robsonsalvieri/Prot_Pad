		cQuery += " SD2.D2_EMISSAO"+if(cArmazem == Repl("*", nTamArm) .And. cArmazem <> Repl("#", nTamArm), "", ", SD2.D2_LOCAL")+", SD2.D2_TES, SD2.D2_CF, SD2.D2_DOC, SD2.D2_SERIE, SD2.D2_SEQCALC, SD2.D2_NUMSEQ, SD2.D2_TIPO, SD2.D2_CLIENTE "

