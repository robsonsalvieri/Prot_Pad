#include "msobject.ch"
#include "totvs.ch"
#include "backoffice.sv.est.balanceinprocess.ch"
#include "totvs.framework.treports.integratedprovider.th"

#DEFINE SX1GRUPO "ESTT022"

using namespace totvs.protheus.backoffice.est.smartView.integratedProvider
namespace totvs.protheus.backoffice.est.balanceinprocess.integratedprovider

@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGAEST", tables="SB1,SD3",name="Saldo em Processo", country="ALL")

//-------------------------------------------------------------------
/*{Protheus.doc} balanceinprocessSmartViewBusinessObject
Classe para criação do Objeto de Negócio de Prodotos
 
@author  Michel Sander
@since   09/2023
@version 1.0
*/
//-------------------------------------------------------------------  
Class balanceinprocessSmartViewBusinessObject From totvs.protheus.backoffice.est.smartView.integratedProvider.EstIntegratedProvider

	Public Method new() as object
	Public Method getData() as object

	Protected Method oNGetSchema()
	Protected data aFields as array
	Protected data jItems  as json
	Protected data cWhere  as character
	Protected data lExistPergunte as Logical

EndClass

//-------------------------------------------------------------------
/*{Protheus.doc} new
Método de instância da classe
 
@return object: self
 
@author Michel Sander
@since  09/2023
@version 1.0
*/
//-------------------------------------------------------------------   
Method new() Class balanceinprocessSmartViewBusinessObject

	_Super:new()

	//Define a Área
	self:appendArea( STR0001 )			//#Estoque Custos

	//Define o nome do Objeto de Negócio
	self:setDisplayName( STR0002 )		//#Saldo em Processo

	//Define a descrição do Objeto de Negócio
	self:setDescription( STR0003 )		//#Tabela Dinâmica e Visão de Dados para demonstrar os saldos de produtos em processo.

	//Grupo de Perguntas
	self:lExistPergunte := self:SetPergunte(SX1GRUPO)
	If !self:lExistPergunte
		cMsgSX1 := OemToAnsi(I18N(STR0004,{SX1GRUPO})) //#Grupo de perguntas #1[SX1GRUPO]# nao encontrado. Verifique na tabela SX1, o grupo de perguntas informado
		self:setErrorStatus(400,STR0005,cMsgSX1)		//#Sem Pergunte
		FwLogMsg("WARN",, "SmartView ESTSV039",,,,cMsgSX1,,,)
	EndIf

	//Indica que o LookUp será do tipo padrão LookUp
	self:setIsLookUp(.T.)
	self:aFields := {}

Return self

//-------------------------------------------------------------------
/*{Protheus.doc} getData
Retorna os dados do objeto de negócio
 
@param nPage, numérico, indica a página atual do relatório
@param oFilter, objeto, contém o filtro do TReports
 
@return object: self:oData
 
@author Michel Sander
@since 09/2023
@version 1.0
*/
//-------------------------------------------------------------------   
Method getData( nPage as Numeric, oFilter as object) as object Class balanceinprocessSmartViewBusinessObject

	Local cQuery	   as Character
	Local cFields	   as Character
	Local cProdMNT 	   as Character
	Local cLocProc     as Character
	Local dDataRef     as Date
	Local cChaveAnt    as Character
	Local cChave 	   as Character
	Local cSB1Alias    as Character
	Local nQTotal      as Numeric
	Local nCusTotal    as Numeric 
	Local nFifTotal    as Numeric
	Local nCusFF 	   as Numeric
	Local nQtdMedia    as Numeric
	Local nQtNeces     as Numeric
	Local nQtde        as Numeric
	Local nCusto       as Numeric
	Local nCustFF      as Numeric
	Local nQtdAcum     as Numeric
	Local nProdPR0     as Numeric 
	Local nQtdOrigem   as Numeric
	Local nQtdProduz   as Numeric 
	Local nProporcao   as Numeric
	Local nFil         as Numeric
	Local nBind        as Numeric
	Local oQuery       as Object
	Local oFilCache    as Object
	Local oParCache    as Object
	Local jPar         as Json
	Local aSald 	   as Array
	Local aProd   	   as Array
	Local aProc   	   as Array
	Local jProdCache  as Json
	Local jReqCache   as Json
	Local jParams	   as Json
	Local lImprime     as Logical
	Local cBkpFil      as Character
	Local cFilExec     as Character
	Local cEmpExec     as Character
	Local cInFiliais   as Character
	Local lUseSetIn    as Logical
	Local aFiliais     as Array

	Local lMT460EP     as Logical 
	Local lM460PRC     as Logical 

	// Casas decimais para arredondamento dos campos de quantidade e valor (padrao MATR989):
	// o legado define a precisao dos campos via TcSetField(D3_QUANT/D3_CUSTO1) com as casas
	// da SX3. Como o jItems e enviado como JSON puro ao Smart View (sem a picture que o
	// TReport aplica na impressao), os valores sao arredondados aqui com Round() nas mesmas
	// casas decimais, evitando ruido de ponto flutuante. Resolvido UMA vez, fora do laco.
	Local nDecQtd      as Numeric
	Local nDecVal      as Numeric

	// Pre-cargas de saldo do armazem de processo (substituem CalcEst / CalcEstFF por produto)
	Local dDtSald      as Date
	Local lSldFallB    as Logical
	Local lFFFallB     as Logical
	Local lD3Estor     as Logical
	Local jSaldo       as Json
	Local jSldFF       as Json

	Private cAliasNew  as Character
	Private cNumOP 	   as Character
	Private cItemOP    as Character
	Private cSeqOP     as Character
	Private cItGrdOP   as Character
	Private cDatPrf    as Character
	Private cD3op      as Character

	If !self:lExistPergunte
		Return self:oData
	EndIf

	//Variaveis
	jParams   := oFilter:getParameters() //metodo para retorno do json dos parâmetros

    //Retorno da tela de multi filiais com as filiais selecionadas ou somente a filial corrente
    self:aFils := self:retFils(jParams['SV_MULTBRANCH'], oFilter)

	//Variáveis com o nome da Filial e Grupo de Empresa
	cFilExec := AllTrim(FWFilialName())
	cEmpExec := AllTrim(FWEmpName(cEmpAnt))
	dDataRef := If(!Empty(jParams['MV_PAR06'][1]), FwDateTimeToLocal(jParams['MV_PAR06'][1])[1], SuperGetMV("MV_ULMES",.F.,'19800101'))
	cFields	 := "D3_FILIAL," + self:getSqlFields(.F.) + ",D3_QUANT,D3_CUSTO1,D3_CUSFF1"
	cBkpFil  := cFilAnt

	// Casas decimais dos campos de quantidade (D3_QUANT) e valor (D3_CUSTO1) da SX3,
	// mesmas usadas pelo MATR989 no TcSetField. FIFTOTAL (D3_CUSFF1) usa as mesmas casas
	// de valor, como no legado (aD3Custo1). Leitura unica, fora dos lacos (CA1003).
	nDecQtd  := TamSX3("D3_QUANT")[2]
	nDecVal  := TamSX3("D3_CUSTO1")[2]

	// OTIMIZACAO: Processamento multi-filial em uma unica query (elimina o loop For por filial).
	// Monta a lista de filiais uma vez; usa setIn() quando <= 50 filiais, IN literal acima disso.
	aFiliais   := {}
	For nFil := 1 to len(self:aFils)
		aAdd(aFiliais, FWxFilial("SD3", self:aFils[nFil]))
	Next nFil
	lUseSetIn  := (Len(aFiliais) <= 50)
	// bpFilIn retorna a lista literal quando > 50 filiais; vazio quando usa setIn()
	cInFiliais := bpFilIn(aFiliais, lUseSetIn)

	// OTIMIZACAO: Cache de nome de filial (FILNOME) e parametros MV resolvidos por filial, usados por linha.
	// Os parametros MV_PRODMNT/MV_PRODPR0/MV_MT460EP/MV_M460PRC podem variar por filial,
	// por isso sao lidos por filial via bpGetParFil (SuperGetMV com filial) e cacheados,
	// evitando N+1 e sem chamada de API dentro do laco (CA1003).
	oFilCache := JsonObject():New()
	oParCache := JsonObject():New()
	For nFil := 1 to len(self:aFils)
		oFilCache[self:aFils[nFil]] := AllTrim(self:getInfoEmp("M0_FILIAL", self:aFils[nFil]))

		// Resolve os parametros de calculo da filial (leitura por filial via bpGetParFil,
		// sem chamada de API dentro do laco - CA1003).
		oParCache[self:aFils[nFil]] := bpGetParFil(self:aFils[nFil])
	Next nFil
	cFilAnt := cBkpFil

	nBind     := 1
	nQTotal   := 0
	nCusTotal := 0
	nFifTotal := 0
	nQtdAcum  := 0

	//Inicializa as variáveis Private
	bpIniVar()

	//Montagem da query - unica para todas as filiais
	cQuery := " SELECT ?,B1_TIPO,B1_UM,D3_TM,D3_PERDA,D3_RATEIO,D3_TRT,C2_QUANT,C2_PERDA,C2_PRODUTO "//1
	cQuery += " FROM " +RetSQLName("SD3")+ " SD3 "
	cQuery += " INNER JOIN " + RetSqlName("SB1") + " SB1 "
	cQuery += " ON " + FWJoinFilial("SB1","SD3")
	cQuery += " AND SB1.B1_COD = SD3.D3_COD "
	cQuery += " AND SB1.D_E_L_E_T_ = ? "//2
	cQuery += " INNER JOIN " + RetSqlName("SC2") + " SC2 "
	cQuery += " ON " + FWJoinFilial("SC2","SD3")
	cQuery += " AND SC2.C2_NUM     = ? "//3
	cQuery += " AND SC2.C2_ITEM    = ? "//4
	cQuery += " AND SC2.C2_SEQUEN  = ? "//5
	cQuery += " AND SC2.C2_ITEMGRD = ? "//6
	// Filtro C2_PRODUTO <> MV_PRODMNT tratado por linha no AdvPL (por filial), nao no SQL Parametro por filial. 
	cQuery += " AND (SC2.C2_DATRF  = ? " //7
	cQuery += " OR SC2.C2_DATRF    > ? ) " //8
	cQuery += " AND SC2.D_E_L_E_T_ = ? "//9
	If lUseSetIn
		// Usa placeholder para setIn() - mais seguro e performatico
		cQuery += " WHERE SD3.D3_FILIAL IN (?) "//10
	Else
		// Fallback: IN clause manual para > 50 filiais (nao consome placeholder)
		// CA2050:SUPPRESS - cInFiliais e construido de forma segura usando FWxFilial()
		cQuery += " WHERE SD3.D3_FILIAL IN (" + cInFiliais + ") "
	EndIf
	cQuery += " AND SD3.D3_COD   >= ? "//11
	cQuery += " AND SD3.D3_COD   <= ? "//12
	cQuery += " AND SD3.D3_LOCAL >= ? "//13
	cQuery += " AND SD3.D3_LOCAL <= ? "//14
	cQuery += " AND SD3.D3_EMISSAO <= ? "//15
	cQuery += " AND SD3.D3_CF NOT IN (?) "//16
	cQuery += " AND SD3.D3_ESTORNO = ? "//17
	cQuery += " AND SD3.D3_OP    <> ? " //18
	cQuery += " AND SD3.D_E_L_E_T_ = ? "//19

	//Os filtros serão setados na interface do novo TReports
	cQuery += self:cWhereFiltroSV
	cQuery += self:cWhere

	//Ordem de impressão dos Saldos
	If jParams["MV_PAR07"][1] == 1
		cQuery += " ORDER BY D3_FILIAL, D3_COD, D3_OP,D3_EMISSAO,SD3.R_E_C_N_O_"
	Else
		cQuery += " ORDER BY D3_FILIAL, D3_COD, D3_OP,D3_SEQCALC,SD3.R_E_C_N_O_"
	EndIf

	cQuery := ChangeQuery(cQuery)
	oQuery := FwExecStatement():New(cQuery)

	//Binding (a numeracao segue a ordem textual dos placeholders na query)
	// FWJoinFilial resolve o filtro de filial dos JOINs (SB1/SC2), dispensando os binds de filial.
	// O filtro C2_PRODUTO <> MV_PRODMNT saiu do SQL e e aplicado por linha no laco (por filial).
	oQuery:SetUnsafe(nBind++, cFields)                  //1  SELECT ?
	oQuery:SetString(nBind++, ' ')                      //2  SB1.D_E_L_E_T_
	oQuery:SetUnsafe(nBind++, cNumOP)                   //3  SC2.C2_NUM
	oQuery:SetUnsafe(nBind++, cItemOp)                  //4  SC2.C2_ITEM
	oQuery:SetUnsafe(nBind++, cSeqOP)                   //5  SC2.C2_SEQUEN
	oQuery:SetUnsafe(nBind++, cItGrdOP)                 //6  SC2.C2_ITEMGRD
	oQuery:SetString(nBind++, cDatPrf)                  //7  SC2.C2_DATRF =
	oQuery:SetString(nBind++, Dtos(dDataRef))           //8  SC2.C2_DATRF >
	oQuery:SetString(nBind++, ' ')                      //9  SC2.D_E_L_E_T_
	// Filtro de filial da SD3 (placeholder 10): setIn() quando <= 50 filiais; caso contrario ja esta no IN manual
	If lUseSetIn
		oQuery:SetIn(nBind++, aFiliais)                 //10 SD3.D3_FILIAL IN
	EndIf
	oQuery:SetString(nBind++, jParams["MV_PAR01"][1])   //11 SD3.D3_COD >=
	oQuery:SetString(nBind++, jParams["MV_PAR02"][1])   //12 SD3.D3_COD <=
	oQuery:SetString(nBind++, jParams["MV_PAR03"][1])   //13 SD3.D3_LOCAL >=
	oQuery:SetString(nBind++, jParams["MV_PAR04"][1])   //14 SD3.D3_LOCAL <=
	oQuery:SetString(nBind++, Dtos(dDataRef))           //15 SD3.D3_EMISSAO <=
	oQuery:SetIn(nBind++, {'ER0','ER1'})                //16 SD3.D3_CF NOT IN
	oQuery:SetString(nBind++, ' ')                      //17 SD3.D3_ESTORNO
	oQuery:SetString(nBind++, cD3op)                    //18 SD3.D3_OP <>
	oQuery:SetString(nBind++, ' ')                      //19 SD3.D_E_L_E_T_

	//Executa Query
	cAliasNew := oQuery:OpenAlias()

	//----------------------------------------------------------------
	// Pre-cargas em lote (elimina N+1 de getProd/checkReq/M460MdPrc).
	// Carregadas UMA vez para todas as filiais selecionadas.
	// jProdCache: SUM producao PR0/PR1 por D3_FILIAL+D3_OP (substitui getProd)
	// jReqCache : SUM D4_QTDEORI por D4_FILIAL+D3_OP+D3_COD+D3_LOCAL+D3_TRT
	//             (substitui checkReq e M460MdPrc)
	//----------------------------------------------------------------
	jProdCache := bpLoadProd(dDataRef, jParams, aFiliais)
	jReqCache  := bpLoadReq(jParams, dDataRef, aFiliais)

	While (cAliasNew)->(!Eof())
		//Zera variaveis		
		nQTotal    := 0
		nCusTotal  := 0
		nFifTotal  := 0
		nCusto     := 0
		nCustFF    := 0
		nQtdOrigem := 0
		nQtdProduz := 0
		nProporcao := 0

		// Parametros de calculo resolvidos por filial (do cache montado antes do laco)
		jPar := oParCache[(cAliasNew)->D3_FILIAL]

		// AllTrim aplicado uma vez por filial (nao por linha) - usado no filtro do produto de manutencao
		cProdMNT := AllTrim(jPar["MV_PRODMNT"])
		nProdPR0 := jPar["MV_PRODPR0"]
		lMT460EP := jPar["MV_MT460EP"]
		lM460PRC := jPar["MV_M460PRC"]

		// Fallback: resolve o nome caso a filial da linha nao esteja no cache
		cFilExec := oFilCache[(cAliasNew)->D3_FILIAL]
		cChave := (cAliasNew)->(D3_FILIAL+D3_COD+D3_OP)
		aProd  := bpGetProd(jProdCache,(cAliasNew)->D3_FILIAL,(cAliasNew)->D3_OP)

		//Considera Mão de Obra
		If jParams["MV_PAR05"][1] == 2
			If IsProdMod((cAliasNew)->D3_COD)					
				(cAliasNew)->(dbSkip())
				Loop					
			EndIf
		EndIf

		While (cAliasNew)->(!Eof()) .And. cChave == (cAliasNew)->(D3_FILIAL+D3_COD+D3_OP)
				// Filtro por filial: exclui OPs cujo produto e o de manutencao (antigo SC2.C2_PRODUTO <> MV_PRODMNT no JOIN).
				// Tratado aqui por linha pois MV_PRODMNT pode variar por filial e a query e unica.
				// cProdMNT ja vem com AllTrim aplicado (uma vez por filial)
				If AllTrim((cAliasNew)->C2_PRODUTO) == cProdMNT
					(cAliasNew)->(dbSkip())
					Loop
				EndIf
				if aProd[1] == 0 .and. SubStr(AllTrim((cAliasNew)->D3_CF),1,2) <> "PR"
					lImprime  := .t.
					nQtde 	  := (cAliasNew)->D3_QUANT
					nCusto 	  := (cAliasNew)->D3_CUSTO1
					nCustFF	  := (cAliasNew)->D3_CUSFF1
				else
					//MT460EP
					if lMT460EP
						If nProdPR0 == 1
							nProporcao := 0 
						ElseIf nProdPR0 == 2
							nProporcao := 1 - (aProd[3] / 100)
						ElseIf nProdPR0 == 3
							nQtdOrigem := (cAliasNew)->C2_QUANT - (cAliasNew)->C2_PERDA
							nQtdProduz := aProd[1] - aProd[2] 
							nProporcao := 1 - ( nQtdProduz / nQtdOrigem )
						EndIf
					EndIf
					
					// D3_FILIAL incluido na chave de reset: em query multi-filial, sem a filial os
					// acumuladores (nQTotal/nCusTotal/nFifTotal/nQtdAcum) vazariam entre filiais
					// com a mesma combinacao OP+COD+LOCAL+TRT.
					if cChaveAnt != (cAliasNew)->(D3_FILIAL+D3_OP+D3_COD+D3_LOCAL+D3_TRT)
						cChaveAnt := (cAliasNew)->(D3_FILIAL+D3_OP+D3_COD+D3_LOCAL+D3_TRT)
						nQTotal := 0
						nCusTotal:= 0
						nFifTotal := 0
						nQtde := 0
						nQtdAcum := 0
					EndIf

					aProc := bpGetReq(jReqCache,(cAliasNew)->D3_FILIAL,(cAliasNew)->D3_OP,(cAliasNew)->D3_COD,(cAliasNew)->D3_LOCAL,(cAliasNew)->D3_TRT,(cAliasNew)->C2_QUANT)

					If aProc[1]
						nQtdMedia := aProc[2]
					ElseIf ((cAliasNew)->C2_QUANT - (cAliasNew)->C2_PERDA) <> 0
						nQtdMedia := (cAliasNew)->D3_QUANT / ((cAliasNew)->C2_QUANT - (cAliasNew)->C2_PERDA)
					Else
						nQtdMedia := 0
					endIf
					lImprime := .f.
					
					if lMT460EP
						nQtNeces  := (aProd[1]+aProd[2]) * nQtdMedia
					else
						nQtNeces  := aProd[1] * nQtdMedia
					EndIf
					
					If SubStr(AllTrim((cAliasNew)->D3_CF),1,2) == "RE"
						if aProc[1]
							nQTotal   += (cAliasNew)->D3_QUANT
							nCusTotal += (cAliasNew)->D3_CUSTO1
							nFifTotal += (cAliasNew)->D3_CUSFF1						
						else
							nQTotal   := (cAliasNew)->D3_QUANT
							nCusTotal := (cAliasNew)->D3_CUSTO1
							nFifTotal := (cAliasNew)->D3_CUSFF1						
						EndIf
					else
						nQTotal   := -(cAliasNew)->D3_QUANT
						nCusTotal := -(cAliasNew)->D3_CUSTO1
						nFifTotal := -(cAliasNew)->D3_CUSFF1
					EndIf
					If SubStr(AllTrim((cAliasNew)->D3_CF),1,2) == "DE"	
						If lMT460EP .and. nProdPR0 == 1
							lImprime := .F.
						Else		  
							lImprime := .t.				
							nQtdAcum  += nQtde					
							nQtde 	  := -(cAliasNew)->D3_QUANT
							nCusto 	  := -(cAliasNew)->D3_CUSTO1
							nCustFF	  := -(cAliasNew)->D3_CUSFF1			
						EndIf
					elseif nQTotal > nQtNeces .and. SubStr(AllTrim((cAliasNew)->D3_CF),1,2) <> "PR"
						if lMT460EP .and. nProdPR0 == 1
							lImprime := .f.
						Else
							lImprime := .t.				
							nQtdAcum  += nQtde
							if aProc[1]
								nQtde      := nQTotal - (nQtNeces + nQtdAcum)
							else
								nQtde      := nQTotal - nQtNeces
							EndIf
							if lMT460EP
								nCusto     := nCusTotal * nProporcao
								nCustFF    := nFifTotal * nProporcao
							else
								nCusto     := (nCusTotal / nQTotal) * nQtde
								nCustFF    := (nFifTotal / nQTotal) * nQtde
							EndIf
						EndIf
					endIf				
				EndIf

				if lImprime 
					self:jItems := JsonObject():New()
					self:jItems["D3_COD"]     := (cAliasNew)->D3_COD
					self:jItems["B1_DESC"]    := (cAliasNew)->B1_DESC
					self:jItems["D3_UM"]      := (cAliasNew)->B1_UM
					self:jItems["D3_OP"]      := (cAliasNew)->D3_OP
					self:jItems["D3_LOCAL"]   := (cAliasNew)->D3_LOCAL
					self:jItems["D3_CF"]      := (cAliasNew)->D3_CF

					if (cAliasNew)->D3_TM > '500'
						self:jItems["QTDTOTAL"]   := Round(nQtde, nDecQtd)
						self:jItems["CUSTOTAL"]   := Round(nCusto, nDecVal)
						self:jItems["FIFTOTAL"]   := Round(nCustFF, nDecVal)
					else
						if lMT460EP
							self:jItems["QTDTOTAL"]   := Round(-nQtde, nDecQtd)
							self:jItems["CUSTOTAL"]   := Round(-nCusto, nDecVal)
							self:jItems["FIFTOTAL"]   := Round(-nCustFF, nDecVal)
						else
							self:jItems["QTDTOTAL"]   := Round(-abs(nQtde), nDecQtd)
							self:jItems["CUSTOTAL"]   := Round(-abs(nCusto), nDecVal)
							self:jItems["FIFTOTAL"]   := Round(-abs(nCustFF), nDecVal)
						EndIf
					EndIf				
					self:jItems["FILNOME"] := cFilExec
					self:jItems["EMPNOME"] := cEmpExec
					self:processData()
					self:oData:appendData(self:jItems)
				EndIf

			(cAliasNew)->(dbSkip())

		EndDo							

	EndDo

	(cAliasNew)->(DBCloseArea())

	// Libera os caches multi-filial e o objeto de query principal
	FWFreeObj(jProdCache)
	FWFreeObj(jReqCache)
	oQuery:Destroy()

	//Se for para exibir os itens do armazem de processo
	// Este bloco depende do contexto de filial corrente (armProc e as pre-cargas de
	// saldo usam FWxFilial), por isso itera por filial ajustando cFilAnt.
	If jParams["MV_PAR08"][1] == 1
		// Data de corte do saldo: exatamente a que era passada a CalcEst/CalcEstFF.
		dDtSald   := daySum(dDataRef, 1)
		// OTIMIZACAO: as N chamadas de CalcEst/CalcEstFF (uma por produto do armazem de
		// processo) foram substituidas por 2 queries por filial, que simulam em SQL o que
		// o MAT006.SQL / xCalcEst e o xCalcEstFF fazem produto a produto - ver bpLoadSald
		// e bpLoadSldFF. Os fallbacks abaixo preservam os cenarios nao reproduziveis em SQL.
		//
		// Fallback obrigatorio quando o Entry Point D3VALIDO esta ativo: a regra e
		// customizada por registro do SD3 e nao pode ser reproduzida em SQL (mesmo
		// criterio de backoffice.sv.est.stockposition e backoffice.sv.est.costComparison).
		lSldFallB := ExistBlock('D3VALIDO')
		// Fallback do FIFO quando o fechamento FIFO (SCC) nao esta em uso: nesse caso a
		// CalcEstFF resolve pelo caminho SB9 + SD8, fora do escopo da pre-carga.
		// A existencia de SCC/SD8 no dicionario tambem e verificada: sem elas o
		// RetSQLName da pre-carga levantaria erro em tempo de execucao. O 2o argumento
		// (lHelp) vai .F. de proposito: em objeto de negocio nao pode haver Help()/UI.
		lFFFallB  := !IsFechFifo() .Or. !FwAliasInDic("SCC", .F.) .Or. !FwAliasInDic("SD8", .F.)
		// MV_D3ESTOR = 'S' faz o calculo considerar tambem movimentos estornados
		lD3Estor  := Upper(GetMV('MV_D3ESTOR', .F., 'N')) == 'S'
		For nFil := 1 to len(self:aFils)
			cFilAnt  := self:aFils[nFil]
			// cFilAnt vem de self:aFils, a mesma lista que populou oParCache e oFilCache
			// no laco de pre-carga acima; logo as chaves estao sempre presentes e o
			// acesso e direto (sem fallback, que aqui seria codigo inalcancavel).
			jPar     := oParCache[cFilAnt]
			cLocProc := AllTrim(jPar["MV_LOCPROC"])
			lM460PRC := jPar["MV_M460PRC"]
			cFilExec := oFilCache[cFilAnt]
			// Pre-cargas em lote da filial corrente: 1 query cada, no lugar de 1 chamada
			// de CalcEst e 1 de CalcEstFF por produto. Em modo fallback os Json ficam
			// VAZIOS (nunca Nil - ver nota em bpGetSald) e os acessores bpGetSald /
			// bpGetSldFF chamam as funcoes originais, sinalizados por lSldFallB/lFFFallB.
			jSaldo := JsonObject():New()
			jSldFF := JsonObject():New()
			If !lSldFallB
				jSaldo := bpLoadSald(cLocProc, dDtSald, jParams, lD3Estor)
			EndIf
			If !lFFFallB
				jSldFF := bpLoadSldFF(cLocProc, dDtSald, jParams)
			EndIf
			cSB1Alias := armProc(jParams, lM460PRC)
			While (cSB1Alias)->(!Eof())	
				aSald := bpGetSald(jSaldo, lSldFallB, (cSB1Alias)->B1_COD, cLocProc, dDtSald)
				// Indice [1] mantido do codigo original: na CalcEstFF a posicao 1 e a
				// QUANTIDADE FIFO, nao o valor. Ver a nota em bpGetSldFF antes de alterar.
				nCusFF := bpGetSldFF(jSldFF, lFFFallB, (cSB1Alias)->B1_COD, cLocProc, dDtSald)[1]
				self:jItems := JsonObject():New()
				self:jItems["D3_COD"]   := (cSB1Alias)->B1_COD
				self:jItems["B1_DESC"]  := (cSB1Alias)->B1_DESC
				self:jItems["D3_UM"]    := (cSB1Alias)->B1_UM
				self:jItems["D3_OP"]    := ' '
				self:jItems["D3_LOCAL"] := cLocProc
				self:jItems["D3_CF"]    := ' '
				self:jItems["QTDTOTAL"] := Round(aSald[1], nDecQtd)
				self:jItems["CUSTOTAL"] := Round(aSald[2], nDecVal)
				self:jItems["FIFTOTAL"] := Round(nCusFF, nDecVal)
				self:jItems["FILNOME"]  := cFilExec
				self:jItems["EMPNOME"]  := cEmpExec
				self:processData()
				self:oData:appendData(self:jItems)
				(cSB1Alias)->(dbSkip())
			EndDo
			(cSB1Alias)->(DBCloseArea())
			// Libera as pre-cargas da filial antes de passar para a proxima
			// (sempre instanciadas, nunca Nil - dispensa guarda)
			FWFreeObj(jSaldo)
			FWFreeObj(jSldFF)
		Next nFil
	EndIf

	cFilAnt := cBkpFil
	FWFreeObj(oFilCache)
	FWFreeObj(oParCache)

Return self:oData

//-------------------------------------------------------------------
/*{Protheus.doc} getSchema
Retorna a estrutura dos campos
 
@return object: self:oSchema
 
@author Michel Sander
@since 09/2023
@version 1.0
*/
//-------------------------------------------------------------------   
Method oNGetSchema() Class balanceinprocessSmartViewBusinessObject

	Local aFieldsSD3 as Array
	Local aFieldsSB1 as Array

	aFieldsSD3 := {"D3_COD", "D3_OP", "D3_LOCAL", "D3_UM", "D3_CF" }
	aFieldsSB1 := {"B1_DESC"}

	self:AliasToSchema("SD3",aFieldsSD3)
	self:AliasToSchema("SB1",aFieldsSB1)

	self:oSchema:addProperty("QTDTOTAL"     , STR0006, "number", STR0006, "QTDTOTAL")		//#"Soma de Qtde  em Processo"
	self:oSchema:addProperty("CUSTOTAL"     , STR0007, "number", STR0007, "CUSTOTAL")		//#"Soma de Valor em Processo"
	self:oSchema:addProperty("FIFTOTAL"     , STR0008, "number", STR0008, "FIFTOTAL")		//#"Soma de Valor FIFO em Processo"
	self:oSchema:addProperty("FILNOME"       , STR0009, "string", STR0009, "FILNOME")
	self:oSchema:addProperty("EMPNOME"       , STR0010, "string", STR0010, "EMPNOME")

Return

/*/{Protheus.doc} bpFilIn
Monta a lista literal de filiais para clausula IN quando ha mais de 50 filiais
(setIn() do FwExecStatement suporta no maximo 50 itens). Retorna string vazia
quando lUseSetIn e verdadeiro (nesse caso usa-se o placeholder com setIn()).
As filiais ja vem no formato SQL (FWxFilial), portanto a lista e segura.
@param aFiliais , array  , filiais no formato SQL
@param lUseSetIn, logico , .T. quando <= 50 filiais (usa setIn, nao monta lista)
@return character, lista literal 'F1','F2',... ou "" quando usa setIn
@author Squad Entradas
@since 08/2026
/*/
Static Function bpFilIn(aFiliais as Array, lUseSetIn as Logical) as Character
	Local cIn := "" as Character
	Local nX  := 0 as Numeric

	If !lUseSetIn
		For nX := 1 to Len(aFiliais)
			If nX > 1
				cIn += ","
			EndIf
			// CA2050:SUPPRESS - lista construida com FWxFilial(), nao contem input de usuario
			cIn += "'" + aFiliais[nX] + "'"
		Next nX
	EndIf

Return cIn

/*/{Protheus.doc} bpGetParFil
Resolve os parametros de calculo de uma filial especifica e retorna em um Json.
A leitura e feita por filial usando o 4o argumento do SuperGetMV (filial), sem
alterar cFilAnt. Centraliza as chamadas de API fora dos lacos de filial (CA1003),
permitindo o cache por filial (oParCache) no metodo getData.
@param cFilRes, character, filial para a qual os parametros serao resolvidos
@return json, com as chaves MV_PRODMNT/MV_PRODPR0/MV_MT460EP/MV_M460PRC/MV_LOCPROC/MV_M460PRC
@author Squad Entradas
@since 08/2026
/*/
Static Function bpGetParFil(cFilRes as Character) as Json
	Local jPar := JsonObject():New() as Json

	jPar["MV_PRODMNT"] := SuperGetMv("MV_PRODMNT",.F., 'MANUTENCAO', cFilRes)
	jPar["MV_PRODPR0"] := SuperGetMv("MV_PRODPR0",.F., 1, cFilRes)
	jPar["MV_MT460EP"] := SuperGetMv("MV_MT460EP",.F., .F., cFilRes)
	jPar["MV_M460PRC"] := SuperGetMv("MV_M460PRC",.F., .F., cFilRes)
	jPar["MV_LOCPROC"] := SuperGetMv("MV_LOCPROC",.F., '', cFilRes)

Return jPar

/*/{Protheus.doc} bpIniVar
Inicializa as variaveis Private usadas na montagem da query principal de getData:
as expressoes de decomposicao de D3_OP (delegadas a bpSubStrOp) e os valores em branco
de comparacao cD3op (D3_OP) e cDatPrf (usado no bind de SC2.C2_DATRF).
As expressoes vao com a coluna NAO qualificada, pois na query principal a SD3 aparece
uma unica vez. Em statements com duas leituras de SD3, use bpSubStrOp com a coluna
qualificada - ver bpOpSubQry.
@type Static Function
@return nil, atribui as variaveis Private declaradas em getData
@author Squad Entradas
@since 06/04/2022
/*/
Static Function bpIniVar()
	Local nD3Op    := TamSX3("D3_OP")[1] as numeric
	Local nDatPrf  := TamSX3("C2_DATPRF")[1] as numeric
	Local jSubStr  := bpSubStrOp("D3_OP") as Json

	// Expressoes de decomposicao de D3_OP centralizadas em bpSubStrOp.
	// Aqui a coluna vai NAO qualificada, pois na query principal de getData a SD3
	// aparece uma unica vez. Em statements onde a SD3 aparece duas vezes (subquery de
	// bpOpSubQry) a coluna precisa ser qualificada - ver bpOpSubQry.
	cNumOP   := jSubStr["NUM"]
	cItemOP  := jSubStr["ITEM"]
	cSeqOP   := jSubStr["SEQUEN"]
	cItGrdOP := jSubStr["ITEMGRD"]

	cD3op    := space(nD3Op)
	cDatPrf  := space(nDatPrf)

	FWFreeObj(jSubStr)

Return

/*/{Protheus.doc} bpSubStrOp
Devolve as expressoes SQL que decompoem a coluna de Ordem de Producao (D3_OP) nos
campos C2_NUM / C2_ITEM / C2_SEQUEN / C2_ITEMGRD da SC2, respeitando o dialeto do
banco (SUBSTR em DB2/POSTGRES/ORACLE/INFORMIX, SUBSTRING nos demais).
Centraliza a logica antes duplicada em bpIniVar e permite QUALIFICAR a coluna, o que
e obrigatorio quando a mesma tabela aparece mais de uma vez no statement.
@type Static Function
@param cCol, character, coluna de origem ja qualificada (ex: "D3_OP" ou "SD3OP.D3_OP")
@return json, chaves NUM / ITEM / SEQUEN / ITEMGRD com as expressoes SQL
@author Squad Entradas
@since 09/2026
/*/
Static Function bpSubStrOp(cCol as Character) as Json
	Local jRet     := JsonObject():New() as Json
	Local nNumOP   := TamSX3("C2_NUM")[1] as numeric
	Local nItemOP  := TamSX3("C2_ITEM")[1] as numeric
	Local nSeqOP   := TamSX3("C2_SEQUEN")[1] as numeric
	Local nItGrdOP := TamSX3("C2_ITEMGRD")[1] as numeric
	Local cFunc    := "" as Character

	If TCGetDB() $ "DB2|POSTGRES|ORACLE|INFORMIX"
		cFunc := "SUBSTR"
	Else
		cFunc := "SUBSTRING"
	EndIf

	jRet["NUM"]     := cFunc + "(" + cCol + ",1," + cValToChar(nNumOP) + ")"
	jRet["ITEM"]    := cFunc + "(" + cCol + "," + cValToChar(nNumOP + 1) + "," + cValToChar(nItemOP) + ")"
	jRet["SEQUEN"]  := cFunc + "(" + cCol + "," + cValToChar(nNumOP + nItemOP + 1) + "," + cValToChar(nSeqOP) + ")"
	jRet["ITEMGRD"] := cFunc + "(" + cCol + "," + cValToChar(nNumOP + nItemOP + nSeqOP + 1) + "," + cValToChar(nItGrdOP) + ")"

Return jRet

/*/{Protheus.doc} bpOpSubQry
Devolve o SQL do conjunto de OPs elegiveis ao relatorio, replicando os predicados
RESTRITIVOS da query principal de getData - em especial o INNER JOIN com a SC2 e o
filtro C2_DATRF, que limita o relatorio as OPs ABERTAS na data de referencia.
Serve para restringir as pre-cargas bpLoadProd/bpLoadReq ao universo de OPs que o laco
principal realmente consulta. Sem esta restricao as pre-cargas varrem o historico
inteiro de SD3/SD4: em base real isso materializava 2.401.897 chaves para um relatorio
de 59 linhas (ver .specs/fixes/SPEC_ESTSV039/perf-analysis-posfix.md).

Alias SD3OP/SC2OP e coluna QUALIFICADA sao obrigatorios: em bpLoadProd esta subquery
convive com outra leitura de SD3 no mesmo statement, e D3_OP nao qualificada seria
ambigua.

Predicados da query principal DELIBERADAMENTE omitidos aqui:
- INNER JOIN SB1: so excluiria OP de produto sem cadastro em SB1 (inconsistencia de
  dados, nao filtro de negocio); nao compensa um terceiro join.
- cWhereFiltroSV / cWhere (filtros do usuario no TReports): dependem do contexto de
  montagem do TReports. A ausencia deixa o cache maior, nunca errado.
Em ambos os casos o cache permanece um SUPERCONJUNTO correto do que sera consultado.

Os binds correspondentes DEVEM ser aplicados por bpOpSubBind, na mesma ordem textual.
@type Static Function
@param lUseSetIn , logical  , .T. quando <= 50 filiais (usa setIn com placeholder)
@param cInFiliais, character, lista literal de filiais quando > 50 (vinda de bpFilIn)
@return character, texto SQL da subquery (sem os parenteses externos)
@author Squad Entradas
@since 09/2026
/*/
Static Function bpOpSubQry(lUseSetIn as Logical, cInFiliais as Character) as Character
	Local cSub    := "" as Character
	Local jSubStr := bpSubStrOp("SD3OP.D3_OP") as Json

	cSub := " SELECT DISTINCT SD3OP.D3_OP "
	cSub += " FROM " + RetSQLName('SD3') + " SD3OP "
	cSub += " INNER JOIN " + RetSQLName('SC2') + " SC2OP "
	cSub += " ON " + FWJoinFilial("SC2", "SD3", "SC2OP", "SD3OP")
	// CA2050:SUPPRESS - as expressoes vem de bpSubStrOp (TamSX3 + TCGetDB), sem input de usuario
	cSub += " AND SC2OP.C2_NUM     = " + jSubStr["NUM"]
	cSub += " AND SC2OP.C2_ITEM    = " + jSubStr["ITEM"]
	cSub += " AND SC2OP.C2_SEQUEN  = " + jSubStr["SEQUEN"]
	cSub += " AND SC2OP.C2_ITEMGRD = " + jSubStr["ITEMGRD"]
	cSub += " AND (SC2OP.C2_DATRF  = ? "    //1  OP sem data real de fim (aberta)
	cSub += " OR SC2OP.C2_DATRF    > ? ) "  //2  ou encerrada apos a data de referencia
	cSub += " AND SC2OP.D_E_L_E_T_ = ? "    //3
	If lUseSetIn
		cSub += " WHERE SD3OP.D3_FILIAL IN (?) "  //4
	Else
		// CA2050:SUPPRESS - cInFiliais e construido de forma segura usando FWxFilial()
		cSub += " WHERE SD3OP.D3_FILIAL IN (" + cInFiliais + ") "
	EndIf
	cSub += " AND SD3OP.D3_COD    >= ? "     //5
	cSub += " AND SD3OP.D3_COD    <= ? "     //6
	cSub += " AND SD3OP.D3_LOCAL  >= ? "     //7
	cSub += " AND SD3OP.D3_LOCAL  <= ? "     //8
	cSub += " AND SD3OP.D3_EMISSAO <= ? "    //9
	cSub += " AND SD3OP.D3_CF NOT IN (?) "   //10 estornos de requisicao
	cSub += " AND SD3OP.D3_ESTORNO = ? "     //11
	cSub += " AND SD3OP.D3_OP     <> ? "     //12 movimento sem OP
	cSub += " AND SD3OP.D_E_L_E_T_ = ? "     //13

	FWFreeObj(jSubStr)

Return cSub

/*/{Protheus.doc} bpOpSubBind
Aplica em oQuery os binds do SQL devolvido por bpOpSubQry, na ordem TEXTUAL dos '?'.
Mantida colada a bpOpSubQry de proposito: as duas devem ser alteradas juntas, pois
desalinhar a ordem dos binds e o erro mais provavel desta construcao.
@type Static Function
@param oQuery   , object   , statement em montagem
@param nBind    , numeric  , indice do proximo bind livre
@param aFiliais , array    , filiais em formato SQL (FWxFilial)
@param lUseSetIn, logical  , .T. quando <= 50 filiais
@param jParams  , json     , parametros do relatorio (MV_PAR01..04)
@param dDataRef , date     , data de referencia (MV_PAR06 ou MV_ULMES)
@return numeric, proximo indice de bind livre
@author Squad Entradas
@since 09/2026
/*/
Static Function bpOpSubBind(oQuery as Object, nBind as Numeric, aFiliais as Array, lUseSetIn as Logical, jParams as Json, dDataRef as Date) as Numeric

	oQuery:SetString(nBind++, Space(TamSX3("C2_DATRF")[1]))  //1  SC2.C2_DATRF =
	oQuery:SetString(nBind++, Dtos(dDataRef))                //2  SC2.C2_DATRF >
	oQuery:SetString(nBind++, ' ')                           //3  SC2.D_E_L_E_T_
	If lUseSetIn
		oQuery:SetIn(nBind++, aFiliais)                      //4  SD3OP.D3_FILIAL IN
	EndIf
	oQuery:SetString(nBind++, jParams["MV_PAR01"][1])        //5  SD3OP.D3_COD >=
	oQuery:SetString(nBind++, jParams["MV_PAR02"][1])        //6  SD3OP.D3_COD <=
	oQuery:SetString(nBind++, jParams["MV_PAR03"][1])        //7  SD3OP.D3_LOCAL >=
	oQuery:SetString(nBind++, jParams["MV_PAR04"][1])        //8  SD3OP.D3_LOCAL <=
	oQuery:SetString(nBind++, Dtos(dDataRef))                //9  SD3OP.D3_EMISSAO <=
	oQuery:SetIn(nBind++, {'ER0','ER1'})                     //10 SD3OP.D3_CF NOT IN
	oQuery:SetString(nBind++, ' ')                           //11 SD3OP.D3_ESTORNO
	oQuery:SetString(nBind++, Space(TamSX3("D3_OP")[1]))     //12 SD3OP.D3_OP <>
	oQuery:SetString(nBind++, ' ')                           //13 SD3OP.D_E_L_E_T_

Return nBind

/*/{Protheus.doc} armProc
Traz os produtos do armazem de processo
@param jParams , json, parametros do relatorio (MV_PAR01/02 para filtro de produto)
@param lM460PRC, logico, valor de MV_M460PRC resolvido no contexto da filial corrente do laco
@author Rodrigo Lombardi
@since 13/08/2024
@version 1.0
/*/
Static Function armProc(jParams, lM460PRC)
	Local oQuery as object
	Local cQuery as Character
	Local cSB1Alias as Character
	Local nX := 1  as Numeric

	cQuery := " SELECT B1_FILIAL, B1_COD, B1_DESC,B1_UM "
	cQuery += " FROM "+RetSQLName('SB1')+" SB1 "
	cQuery += " WHERE SB1.B1_FILIAL = ? "//1
	cQuery += " AND SB1.B1_COD >= ? "//2 
	cQuery += " AND SB1.B1_COD <= ? "//3
	//Considero somente os indiretos
	if !lM460PRC
		cQuery += "AND SB1.B1_APROPRI = ? "//4
	EndIf
	cQuery += " AND SB1.D_E_L_E_T_ = ? "//5

	cQuery := changeQuery(cQuery)
	oQuery := FwExecStatement():New(cQuery)
	oQuery:setString(nX++,FwXfilial('SB1'))//Filial
	oQuery:setString(nX++,jParams["MV_PAR01"][1])//Produto de
	oQuery:setString(nX++,jParams["MV_PAR02"][1])//Produto Ate
	if !lM460PRC
		oQuery:setString(nX++,'I')//Apenas o que for indireto
	EndIf
	oQuery:setString(nX++,' ')//D_E_L_E_T_ = ' '
	cSB1Alias := oQuery:OpenAlias()

Return cSB1Alias

/*/{Protheus.doc} bpLoadProd
Pre-carga em lote dos valores de producao (PR0/PR1) por FILIAL+OP, substituindo a
consulta getProd que era executada por OP dentro do laco (N+1).
Reproduz exatamente os filtros de getProd: D3_CF IN (PR0,PR1), D3_ESTORNO=' ',
D3_LOCAL entre MV_PAR03/04, D3_EMISSAO <= dDataRef, agora para todas as filiais
selecionadas de uma unica vez (IN de filiais).
@param dDataRef, data, data de referencia (MV_PAR06)
@param jParams , json, parametros do relatorio
@param aFiliais, array, filiais (formato SQL via FWxFilial) para o filtro IN
@return json, chave = D3_FILIAL|D3_OP, valor = array {QUANT, PERDA, RATEIO}
@author Squad Entradas
@since 08/2026
/*/
Static Function bpLoadProd(dDataRef, jParams, aFiliais)
	Local oQuery     as object
	Local cQuery     as Character
	Local cAlias     as Character
	Local jRet       := JsonObject():New() as Json
	Local nBind      := 1 as Numeric
	Local lUseSetIn  := (Len(aFiliais) <= 50) as Logical
	Local cInFiliais := bpFilIn(aFiliais, lUseSetIn) as Character

	cQuery := " SELECT D3_FILIAL, D3_OP, SUM(D3_QUANT) AS QUANT, SUM(D3_PERDA) AS PERDA, SUM(D3_RATEIO) AS RATEIO "
	cQuery += " FROM " + RetSQLName('SD3') + " SD3 "
	// setIn() so suporta ate 50 itens; acima disso usa IN literal (montado com FWxFilial, seguro)
	If lUseSetIn
		cQuery += " WHERE SD3.D3_FILIAL IN (?) "
	Else
		// CA2050:SUPPRESS - cInFiliais e construido de forma segura usando FWxFilial()
		cQuery += " WHERE SD3.D3_FILIAL IN (" + cInFiliais + ") "
	EndIf
	cQuery += " AND SD3.D3_LOCAL >= ? "
	cQuery += " AND SD3.D3_LOCAL <= ? "
	cQuery += " AND SD3.D3_ESTORNO = ? "
	cQuery += " AND SD3.D3_CF IN (?) "
	cQuery += " AND SD3.D3_EMISSAO <= ? "
	// Restringe as OPs abertas, replicando o JOIN com SC2 da query principal.
	// A subquery usa o alias SD3OP: a SD3 externa e a da subquery convivem neste statement,
	// por isso a coluna dentro da subquery precisa ser qualificada (ver bpOpSubQry).
	// NAO ha filtro de D3_COD aqui, e isso e INTENCIONAL: as linhas PR0/PR1 sao movimentos
	// do PRODUTO ACABADO da OP, nao do componente filtrado por MV_PAR01/02. Filtrar por
	// produto zeraria a producao das OPs e alteraria aProd[1], mudando o resultado do
	// relatorio. Foi por isso que o getProd original sempre foi chaveado somente por OP.
	// CA2050:SUPPRESS - bpOpSubQry devolve SQL parametrizado; os valores entram por bpOpSubBind
	cQuery += " AND SD3.D3_OP IN ( " + bpOpSubQry(lUseSetIn, cInFiliais) + " ) "
	cQuery += " AND SD3.D_E_L_E_T_ = ? "
	cQuery += " GROUP BY D3_FILIAL, D3_OP "
	cQuery := ChangeQuery(cQuery)

	// Binds na ordem TEXTUAL dos '?': filial, faixa de armazem, estorno, CF, emissao,
	// os 13 binds da subquery de OPs (bpOpSubBind) e por fim o D_E_L_E_T_ da SD3 externa.
	oQuery := FwExecStatement():New(cQuery)
	If lUseSetIn
		oQuery:setIn(nBind++, aFiliais)
	EndIf
	oQuery:setString(nBind++, jParams["MV_PAR03"][1])
	oQuery:setString(nBind++, jParams["MV_PAR04"][1])
	oQuery:setString(nBind++, ' ')
	oQuery:setIn(nBind++, {'PR1','PR0'})
	oQuery:setString(nBind++, DTOS(dDataRef))
	nBind := bpOpSubBind(oQuery, nBind, aFiliais, lUseSetIn, jParams, dDataRef)
	oQuery:setString(nBind++, ' ')

	cAlias := oQuery:OpenAlias()
	While (cAlias)->(!Eof())
		jRet[ AllTrim((cAlias)->D3_FILIAL) + "|" + AllTrim((cAlias)->D3_OP) ] := { (cAlias)->QUANT, (cAlias)->PERDA, (cAlias)->RATEIO }
		(cAlias)->(dbSkip())
	EndDo
	(cAlias)->(DBCloseArea())
	oQuery:Destroy()

Return jRet

/*/{Protheus.doc} bpGetProd
Consulta em memoria a pre-carga de producao. Mesmo retorno que o antigo getProd:
array {QUANT, PERDA, RATEIO}; zeros quando a OP nao tem producao PR0/PR1.
@param jProdCache, json, pre-carga de bpLoadProd
@param cFil      , caractere, filial da linha (D3_FILIAL)
@param cOp       , caractere, ordem de producao
@return array {QUANT, PERDA, RATEIO}
@author Squad Entradas
@since 08/2026
/*/
Static Function bpGetProd(jProdCache, cFil, cOp)
	Local cKey := AllTrim(cFil) + "|" + AllTrim(cOp) as Character
	Local aRet as Array
	If jProdCache <> Nil .And. jProdCache:hasProperty(cKey)
		aRet := jProdCache[cKey]
	Else
		aRet := {0, 0, 0}
	EndIf
Return aRet

/*/{Protheus.doc} bpLoadReq
Pre-carga em lote das requisicoes SD4 agregadas por FILIAL+OP+COD+LOCAL+TRT,
substituindo checkReq e M460MdPrc (que rodavam por registro/linha - N+1).
Restringe SD4 as OPs de producao das filiais selecionadas (subquery em SD3).
Guarda SUM(D4_QTDEORI) por chave, equivalente ao SUM de M460MdPrc (caminho rastro).
No caminho nao-rastro com >1 SD4 na mesma chave ha divergencia conhecida vs o legado
(que usava o ultimo registro, nao-deterministico) - ver nota em bpGetReq.
@param jParams , json, parametros do relatorio (MV_PAR01..04 para filtros)
@param dDataRef, date, data de referencia para filtro de emissao
@param aFiliais, array, filiais (formato SQL via FWxFilial) para o filtro IN
@return json, chave = D4_FILIAL|D4_OP|D4_COD|D4_LOCAL|D4_TRT, valor = SUM(D4_QTDEORI)
@author Squad Entradas
@since 08/2026
/*/
Static Function bpLoadReq(jParams as Json, dDataRef as Date, aFiliais as Array)
	Local oQuery     as object
	Local cQuery     as Character
	Local cAlias     as Character
	Local jRet       := JsonObject():New() as Json
	Local cKey       as Character
	Local nBind      := 1 as Numeric
	Local lUseSetIn  := (Len(aFiliais) <= 50) as Logical
	Local cInFiliais := bpFilIn(aFiliais, lUseSetIn) as Character
	Local cFilClause as Character

	// setIn() so suporta ate 50 itens; acima disso usa IN literal (montado com FWxFilial, seguro)
	// ATENCAO: cFilClause aplica-se APENAS a SD4 e e usado UMA unica vez. A clausula de filial
	// da subquery de OPs e montada por bpOpSubQry, com bind proprio em bpOpSubBind. Acrescentar
	// um segundo uso de cFilClause aqui criaria um '?' sem bind correspondente.
	If lUseSetIn
		cFilClause := " IN (?) "
	Else
		// CA2050:SUPPRESS - cInFiliais e construido de forma segura usando FWxFilial()
		cFilClause := " IN (" + cInFiliais + ") "
	EndIf

	// D4_COD / D4_LOCAL restringem a pre-carga as faixas de produto e armazem do relatorio:
	// bpGetReq monta a chave com D3_COD e D3_LOCAL, que na query principal estao
	// obrigatoriamente entre MV_PAR01/02 e MV_PAR03/04 - nenhuma chave fora dessas faixas
	// pode ser consultada. Alem de reduzir o volume, torna utilizavel o indice SD4 ordem 1
	// (D4_FILIAL+D4_COD+D4_OP+D4_TRT).
	// D4_OP IN (bpOpSubQry) restringe as OPs abertas, replicando o JOIN com SC2 da query
	// principal - era a ausencia disso que carregava o historico inteiro da SD4.
	cQuery := " SELECT D4_FILIAL, D4_OP, D4_COD, D4_LOCAL, D4_TRT, SUM(D4_QTDEORI) AS QTDEORI "
	cQuery += " FROM " + RetSQLName('SD4') + " SD4 "
	cQuery += " WHERE SD4.D4_FILIAL " + cFilClause
	cQuery += " AND SD4.D4_COD   >= ? "
	cQuery += " AND SD4.D4_COD   <= ? "
	cQuery += " AND SD4.D4_LOCAL >= ? "
	cQuery += " AND SD4.D4_LOCAL <= ? "
	// CA2050:SUPPRESS - bpOpSubQry devolve SQL parametrizado; os valores entram por bpOpSubBind
	cQuery += " AND SD4.D4_OP IN ( " + bpOpSubQry(lUseSetIn, cInFiliais) + " ) "
	cQuery += " AND SD4.D_E_L_E_T_ = ? "
	cQuery += " GROUP BY D4_FILIAL, D4_OP, D4_COD, D4_LOCAL, D4_TRT "
	cQuery := ChangeQuery(cQuery)

	// Binds na ordem TEXTUAL dos '?': filial da SD4, faixas de produto/armazem,
	// os 13 binds da subquery de OPs (bpOpSubBind) e por fim o D_E_L_E_T_ da SD4.
	oQuery := FwExecStatement():New(cQuery)
	If lUseSetIn
		oQuery:setIn(nBind++, aFiliais)                    // SD4 filiais
	EndIf
	oQuery:setString(nBind++, jParams["MV_PAR01"][1])      // D4_COD   >= Produto de
	oQuery:setString(nBind++, jParams["MV_PAR02"][1])      // D4_COD   <= Produto ate
	oQuery:setString(nBind++, jParams["MV_PAR03"][1])      // D4_LOCAL >= Local de
	oQuery:setString(nBind++, jParams["MV_PAR04"][1])      // D4_LOCAL <= Local ate
	nBind := bpOpSubBind(oQuery, nBind, aFiliais, lUseSetIn, jParams, dDataRef)
	oQuery:setString(nBind++, ' ')                         // SD4.D_E_L_E_T_
	cAlias := oQuery:OpenAlias()
	While (cAlias)->(!Eof())
		cKey := AllTrim((cAlias)->D4_FILIAL) + "|" + AllTrim((cAlias)->D4_OP) + "|" + AllTrim((cAlias)->D4_COD) + "|" + AllTrim((cAlias)->D4_LOCAL) + "|" + AllTrim((cAlias)->D4_TRT)
		jRet[cKey] := (cAlias)->QTDEORI
		(cAlias)->(dbSkip())
	EndDo
	(cAlias)->(DBCloseArea())
	oQuery:Destroy()

Return jRet

/*/{Protheus.doc} bpGetReq
Consulta em memoria a pre-carga de requisicoes. Retorna array {lProc, nQtMedia}.
lProc = existe requisicao para a chave; nQtMedia = SUM(D4_QTDEORI) / nQtd.
Paridade com o legado checkReq:
- Caminho RASTRO: identico ao M460MdPrc (que ja usava SUM(D4_QTDEORI)/nQtd por chave).
- Caminho NAO-RASTRO com multiplos SD4 na mesma chave: aqui usa SUM; o checkReq legado
  ficava com o D4_QTDEORI do ULTIMO registro lido (sem ORDER BY, portanto nao-deterministico).
  Optou-se por manter SUM por ser deterministico e conceitualmente coerente (qtde total
  requisitada). Divergencia so ocorre quando ha >1 SD4 sem rastro na mesma chave.
@param jReqCache, json, pre-carga de bpLoadReq
@param cFil, cOp, cCod, cLocal, cTrt, caracteres, chave da requisicao (filial + OP + produto + local + rastro)
@param nQtd, numerico, quantidade da OP (C2_QUANT)
@return array {lProc (logico), nQtMedia (numerico)}
@author Squad Entradas
@since 08/2026
/*/
Static Function bpGetReq(jReqCache, cFil, cOp, cCod, cLocal, cTrt, nQtd)
	Local aProc    := {} as Array
	Local lProc    := .F. as Logical
	Local nQtMedia := 0 as Numeric
	Local cKey     := AllTrim(cFil) + "|" + AllTrim(cOp) + "|" + AllTrim(cCod) + "|" + AllTrim(cLocal) + "|" + AllTrim(cTrt) as Character
	Local nQtdOri  := 0 as Numeric

	If jReqCache <> Nil .And. jReqCache:hasProperty(cKey)
		lProc   := .T.
		nQtdOri := jReqCache[cKey]
		If nQtd <> 0
			nQtMedia := nQtdOri / nQtd
		EndIf
	EndIf
	aAdd(aProc, lProc)
	aAdd(aProc, nQtMedia)

Return aProc

/*/{Protheus.doc} bpDtNorm
Devolve a expressao SQL que normaliza uma coluna de data de fechamento (B9_DATA da SB9
ou CC_DATA da SCC) quando ela esta VAZIA, tratando-a como '00000000' - a data mais
antiga possivel.

Por que isso e necessario: um registro de fechamento com a data em branco e valido e
DEVE ser considerado. No indice 1 do SB9 (B9_FILIAL+B9_COD+B9_LOCAL+DTOS(B9_DATA)) ele
ordena ANTES dos registros com data preenchida, portanto o xCalcEst o alcanca na
varredura, usa o seu B9_QINI/B9_VINI1 e calcula dDtVai := B9_DATA+1, que com data vazia
resulta em "desde o inicio" - ou seja, todos os movimentos entram no calculo.
Sem a normalizacao, em SQL a coluna em branco poderia ser ignorada pelo MAX() ou pelo
join de volta ao registro de detalhe, dependendo do banco/collation, e o saldo inicial
seria perdido. Mesmo tratamento adotado em backoffice.sv.est.inflowsandoutflows.

A expressao usa apenas literais fixos, portanto nao ha risco de injecao (CA2050).
@type Static Function
@param cCol, character, coluna qualificada (ex: "B9D.B9_DATA", "CCA.CC_DATA")
@return character, expressao SQL normalizada
@author Squad Entradas
@since 09/2026
/*/
Static Function bpDtNorm(cCol as Character) as Character
Return "( CASE WHEN " + cCol + " = ' ' THEN '00000000' ELSE " + cCol + " END )"

/*/{Protheus.doc} bpB9Piso
Devolve o SQL da tabela derivada que resolve, por PRODUTO, a data do ultimo fechamento
SB9 ANTERIOR a data de corte, no armazem de processo. Equivale ao ponto de partida do
saldo inicial do xCalcEst (o DbSeek no SB9 seguido do DbSkip(-1)) e alimenta tanto o
saldo inicial (leg 1 de bpLoadSald) quanto o piso dos movimentos (demais legs).

A filial e o armazem sao fixos no contexto de uso (uma filial por iteracao do laco e o
armazem de processo da filial), por isso a tabela derivada agrupa somente por produto.
A data e comparada pela expressao normalizada de bpDtNorm - ver a nota sobre B9_DATA
vazia naquela funcao.

Os binds correspondentes DEVEM ser aplicados por bpB9PisoBd, na mesma ordem textual.
@type Static Function
@param cAls, character, alias a usar para a SB9 nesta tabela derivada (deve ser unico
                        no statement, pois a SB9 aparece varias vezes)
@return character, texto SQL da tabela derivada (sem os parenteses externos)
@author Squad Entradas
@since 09/2026
/*/
Static Function bpB9Piso(cAls as Character) as Character
	Local cSub := "" as Character
	// CA2050:SUPPRESS - bpDtNorm devolve expressao com literais fixos, sem input de usuario
	Local cExp := bpDtNorm(cAls + ".B9_DATA") as Character

	cSub := " SELECT " + cAls + ".B9_COD, MAX(" + cExp + ") B9_DTMAX "
	cSub += " FROM " + RetSQLName("SB9") + " " + cAls + " "
	cSub += " WHERE " + cAls + ".B9_FILIAL = ? "   //1 filial
	cSub += "   AND " + cAls + ".B9_LOCAL  = ? "   //2 armazem de processo
	cSub += "   AND " + cAls + ".B9_COD   >= ? "   //3 produto de
	cSub += "   AND " + cAls + ".B9_COD   <= ? "   //4 produto ate
	cSub += "   AND " + cExp + " < ? "             //5 fechamento anterior a data de corte
	cSub += "   AND " + cAls + ".D_E_L_E_T_ = ? "  //6
	cSub += " GROUP BY " + cAls + ".B9_COD "

Return cSub

/*/{Protheus.doc} bpB9PisoBd
Aplica em oQuery os binds do SQL devolvido por bpB9Piso, na ordem TEXTUAL dos '?'.
Mantida colada a bpB9Piso de proposito: as duas devem ser alteradas juntas.
@type Static Function
@param oQuery , object   , statement em montagem
@param nBind  , numeric  , indice do proximo bind livre
@param cLocPad, character, armazem de processo ja ajustado ao tamanho do campo
@param jParams, json     , parametros do relatorio (MV_PAR01/02 = faixa de produto)
@param cData  , character, data de corte em formato AAAAMMDD
@return numeric, proximo indice de bind livre
@author Squad Entradas
@since 09/2026
/*/
Static Function bpB9PisoBd(oQuery as Object, nBind as Numeric, cLocPad as Character, jParams as Json, cData as Character) as Numeric

	oQuery:SetString(nBind++, FWxFilial("SB9"))        //1 B9_FILIAL
	oQuery:SetString(nBind++, cLocPad)                 //2 B9_LOCAL
	oQuery:SetString(nBind++, jParams["MV_PAR01"][1])  //3 B9_COD >=
	oQuery:SetString(nBind++, jParams["MV_PAR02"][1])  //4 B9_COD <=
	oQuery:SetString(nBind++, cData)                   //5 B9_DATA normalizada <
	oQuery:SetString(nBind++, ' ')                     //6 D_E_L_E_T_

Return nBind

/*/{Protheus.doc} bpSF5Whr
Devolve o predicado que reproduz a validacao de Tipo de Movimento do xCalcEst nas
varreduras do SD3: o movimento so entra no calculo se o D3_TM estiver cadastrado na SF5
OU for um dos TMs genericos '499' / '999' (que a rotina aceita sem cadastro).
Os binds correspondentes DEVEM ser aplicados por bpSF5Bd, na mesma ordem textual.
@type Static Function
@param cAls   , character, alias da SD3 a validar (ex: "SD3A")
@param cSubAls, character, alias a usar para a SF5 no EXISTS (unico no statement)
@return character, predicado SQL iniciando por " AND "
@author Squad Entradas
@since 09/2026
/*/
Static Function bpSF5Whr(cAls as Character, cSubAls as Character) as Character
	Local cWhr := "" as Character

	cWhr := "   AND ( " + cAls + ".D3_TM IN (?) "   //1 TMs genericos 499/999
	cWhr += "      OR EXISTS ( SELECT 1 FROM " + RetSQLName("SF5") + " " + cSubAls + " "
	cWhr += "                  WHERE " + cSubAls + ".F5_FILIAL = ? "   //2
	cWhr += "                    AND " + cSubAls + ".F5_CODIGO = " + cAls + ".D3_TM "
	cWhr += "                    AND " + cSubAls + ".D_E_L_E_T_ = ? ) ) "  //3

Return cWhr

/*/{Protheus.doc} bpSF5Bd
Aplica em oQuery os binds do predicado devolvido por bpSF5Whr, na ordem TEXTUAL dos '?'.
@type Static Function
@param oQuery, object , statement em montagem
@param nBind , numeric, indice do proximo bind livre
@return numeric, proximo indice de bind livre
@author Squad Entradas
@since 09/2026
/*/
Static Function bpSF5Bd(oQuery as Object, nBind as Numeric) as Numeric

	oQuery:SetIn(nBind++, {'499','999'})        //1 D3_TM genericos
	oQuery:SetString(nBind++, FWxFilial("SF5")) //2 F5_FILIAL
	oQuery:SetString(nBind++, ' ')              //3 D_E_L_E_T_

Return nBind

/*/{Protheus.doc} bpLoadSald
Pre-carga em lote do saldo de estoque (quantidade e custo na moeda 1) do ARMAZEM DE
PROCESSO para todos os produtos da faixa do relatorio, em UMA unica query - simulando
em SQL o que a stored procedure MAT006.SQL faz produto a produto quando chamada por
CalcEst(). Substitui as N chamadas de CalcEst() que rodavam dentro do laco de produtos
do armazem de processo (N+1).

FORMULA REPLICADA (xCalcEst, MATXFUNB.PRX - rotina AdvPL que o MAT006.SQL espelha):
  saldo = B9_QINI  do ultimo fechamento SB9 ANTERIOR a dData          (leg 1)
        + SUM(SD1) entradas com TES que movimenta estoque             (leg 2)
        - SUM(SD2) saidas   com TES que movimenta estoque             (leg 3)
        +/- SUM(SD3) do proprio armazem, sinal por D3_TM              (leg 4)
        +/- SUM(SD3) do BLOCO DO ARMAZEM DE PROCESSO                  (leg 5)
Cada parcela e uma leg de um UNION ALL, somada por produto no GROUP BY externo - cada
leg e varrida UMA vez e usa o indice natural da sua tabela.

BLOCO DO ARMAZEM DE PROCESSO (leg 5) - POR QUE O getSaldoSQL DO costComparison NAO
SERVE AQUI: quando o armazem consultado E o de processo (MV_LOCPROC) - que e sempre o
caso neste relatorio - o xCalcEst executa um bloco ADICIONAL que percorre o SD3 de
TODOS os armazens e considera as transferencias de/para processo (D3_CF com "E3" na 2a
e 3a posicao, isto e 'RE3' e 'DE3') cujo D3_LOCAL <> MV_LOCPROC: 'RE3' soma, 'DE3'
subtrai. Nem o Method getSaldoSQL de backoffice.sv.est.costComparison nem a Fase 1/2 de
backoffice.sv.est.stockposition implementam esse bloco - os dois EXCLUEM o armazem de
processo do caminho SQL e caem no fallback CalcEst justamente por isso. Reaproveitar
aquele metodo aqui produziria saldo errado para todas as linhas deste bloco; por isso
esta pre-carga foi escrita, e nao reutilizada.

PISO DOS MOVIMENTOS: os movimentos entram a partir do DIA SEGUINTE ao ultimo fechamento
("> B9_DATA" equivale ao "dDtVai := B9_DATA+1" do xCalcEst) e vao ate a vespera de
dData ("< dData", exclusivo, como no xCalcEst). Sem fechamento, o piso cai para
'00000000' e todos os movimentos entram. Ver bpDtNorm para o tratamento de B9_DATA vazia.

MOEDA: o relatorio usa exclusivamente a moeda 1 (CUSTOTAL alimentado por CalcEst[2]),
por isso as colunas de custo sao fixas em B9_VINI1 / D1_CUSTO / D2_CUSTO1 / D3_CUSTO1.

@param cLocPrc , character, armazem de processo (MV_LOCPROC da filial corrente)
@param dData   , date     , data de corte (exclusiva - a mesma passada a CalcEst)
@param jParams , json     , parametros do relatorio (MV_PAR01/02 = faixa de produto)
@param lD3Estor, logical  , MV_D3ESTOR = 'S' - considera movimentos estornados
@return json, chave = produto (AllTrim), valor = array {quantidade, custo moeda 1}
@author Squad Entradas
@since 09/2026
/*/
Static Function bpLoadSald(cLocPrc as Character, dData as Date, jParams as Json, lD3Estor as Logical) as Json
	Local oQuery     as Object
	Local cQuery     := "" as Character
	Local cAlias     := "" as Character
	Local jRet       := JsonObject():New() as Json
	Local nBind      := 1 as Numeric
	Local cIsNull    := MatIsNull() as Character
	Local cData      := DTOS(dData) as Character
	Local cLocPad    := PadR(cLocPrc, TamSX3("B9_LOCAL")[1]) as Character
	Local cDtFloor   := "00000000" as Character
	// Corte temporal do SD2: o xCalcEst usa D2_DTDIGIT quando UsaD2DTDIG() esta ativa,
	// caso contrario D2_EMISSAO. Ignorar isso e a origem de divergencia conhecida no
	// getSaldoSQL do costComparison (ver docs/rca/RCA-costComparison-getSaldoSQL).
	// A chamada e protegida por FindFunction porque UsaD2DTDIG nao existe em todas as
	// releases; ausente, vale o comportamento padrao (D2_EMISSAO).
	Local cD2Data    := "D2_EMISSAO" as Character

	If FindFunction("UsaD2DTDIG") .And. UsaD2DTDIG()
		cD2Data := "D2_DTDIGIT"
	EndIf

	// Montagem: cada parcela do xCalcEst e uma leg isolada (funcao propria, com a sua
	// funcao de bind colada a ela). A ordem das legs aqui DEVE ser a mesma da secao de
	// binds abaixo, pois o FwExecStatement casa os '?' pela ordem TEXTUAL.
	// CA2050:SUPPRESS - as funcoes de leg devolvem SQL parametrizado; valores entram nos binds
	cQuery := " SELECT T.COD, SUM(T.QTD) QTD, SUM(T.CST) CST FROM ( "
	cQuery += bpSldB9()                             // leg 1 - saldo inicial SB9
	cQuery += " UNION ALL " + bpSldD1(cIsNull)      // leg 2 - entradas SD1
	cQuery += " UNION ALL " + bpSldD2(cIsNull, cD2Data)     // leg 3 - saidas SD2
	cQuery += " UNION ALL " + bpSldD3(cIsNull, lD3Estor)    // leg 4 - movimentos SD3 do armazem
	cQuery += " UNION ALL " + bpSldPrc(cIsNull, lD3Estor)   // leg 5 - bloco do armazem de processo
	cQuery += " ) T GROUP BY T.COD "

	cQuery := ChangeQuery(cQuery)
	oQuery := FwExecStatement():New(cQuery)

	// Binds na ordem TEXTUAL dos '?' - a MESMA sequencia de legs da montagem acima.
	nBind := bpSldB9Bd(oQuery, nBind, cLocPad, jParams, cData)
	nBind := bpSldD1Bd(oQuery, nBind, cLocPad, jParams, cData, cDtFloor)
	nBind := bpSldD2Bd(oQuery, nBind, cLocPad, jParams, cData, cDtFloor)
	nBind := bpSldD3Bd(oQuery, nBind, cLocPad, jParams, cData, cDtFloor, lD3Estor)
	nBind := bpSldPrcBd(oQuery, nBind, cLocPad, jParams, cData, cDtFloor, lD3Estor)

	cAlias := oQuery:OpenAlias()
	While (cAlias)->(!Eof())
		jRet[ AllTrim((cAlias)->COD) ] := { (cAlias)->QTD, (cAlias)->CST }
	(cAlias)->(dbSkip())
	EndDo

	If !Empty(cAlias) .And. Select(cAlias) > 0
		(cAlias)->(DBCloseArea())
	EndIf
	oQuery:Destroy()

Return jRet

/*/{Protheus.doc} bpSldB9
LEG 1 de bpLoadSald - saldo inicial: a linha do ultimo fechamento SB9 ANTERIOR a data de
corte, no armazem de processo. A tabela derivada de bpB9Piso resolve a data (MAX
normalizado por bpDtNorm) e o INNER JOIN recupera o B9_QINI/B9_VINI1 daquela mesma linha,
sem reler todo o SB9.
Os binds correspondentes DEVEM ser aplicados por bpSldB9Bd, na mesma ordem textual.
@type function
@return character, texto SQL da leg (sem o UNION ALL)
@author Squad Entradas
@since 09/2026
/*/
Static Function bpSldB9() as Character
	Local cSql := "" as Character

	cSql := " SELECT B9DT.B9_COD COD, B9DT.B9_QINI QTD, B9DT.B9_VINI1 CST "
	cSql += " FROM " + RetSQLName("SB9") + " B9DT "
	// CA2050:SUPPRESS - bpB9Piso devolve SQL parametrizado; os valores entram por bpB9PisoBd
	cSql += " INNER JOIN ( " + bpB9Piso("B9PA") + " ) B9MA "
	cSql += "    ON B9MA.B9_COD = B9DT.B9_COD "
	// CA2050:SUPPRESS - bpDtNorm devolve expressao com literais fixos, sem input de usuario
	cSql += "   AND " + bpDtNorm("B9DT.B9_DATA") + " = B9MA.B9_DTMAX "
	cSql += " WHERE B9DT.B9_FILIAL = ? "
	cSql += "   AND B9DT.B9_LOCAL  = ? "
	cSql += "   AND B9DT.D_E_L_E_T_ = ? "

Return cSql

/*/{Protheus.doc} bpSldB9Bd
Aplica os binds da leg devolvida por bpSldB9, na ordem TEXTUAL dos '?'.
Mantida colada a bpSldB9 de proposito: as duas devem ser alteradas juntas.
@type function
@param oQuery , object   , statement em montagem
@param nBind  , numeric  , indice do proximo bind livre
@param cLocPad, character, armazem de processo ajustado ao tamanho do campo
@param jParams, json     , parametros do relatorio
@param cData  , character, data de corte em formato AAAAMMDD
@return numeric, proximo indice de bind livre
@author Squad Entradas
@since 09/2026
/*/
Static Function bpSldB9Bd(oQuery as Object, nBind as Numeric, cLocPad as Character, jParams as Json, cData as Character) as Numeric

	nBind := bpB9PisoBd(oQuery, nBind, cLocPad, jParams, cData)  // tabela derivada B9PA
	oQuery:SetString(nBind++, FWxFilial("SB9"))         // B9DT.B9_FILIAL
	oQuery:SetString(nBind++, cLocPad)                  // B9DT.B9_LOCAL
	oQuery:SetString(nBind++, ' ')                      // B9DT.D_E_L_E_T_

Return nBind

/*/{Protheus.doc} bpSldD1
LEG 2 de bpLoadSald - entradas (SD1) posteriores ao fechamento, somente com TES que
movimenta estoque (F4_ESTOQUE='S'), desprezando lancamentos do Livro Fiscal
(D1_ORIGLAN <> 'LF') e as NFs de credito de reducao de valores em formulario normal
(D1_TIPODOC='54' e D1_FORMUL<>'S'), conforme o xCalcEst.
Os binds correspondentes DEVEM ser aplicados por bpSldD1Bd, na mesma ordem textual.
@type function
@param cIsNull, character, funcao de nulo do banco (MatIsNull)
@return character, texto SQL da leg (sem o UNION ALL)
@author Squad Entradas
@since 09/2026
/*/
Static Function bpSldD1(cIsNull as Character) as Character
	Local cSql := "" as Character

	cSql := " SELECT SD1A.D1_COD COD, SUM(SD1A.D1_QUANT) QTD, SUM(SD1A.D1_CUSTO) CST "
	cSql += " FROM " + RetSQLName("SD1") + " SD1A "
	cSql += " INNER JOIN " + RetSQLName("SF4") + " SF4A "
	cSql += "    ON SF4A.F4_FILIAL = ? AND SF4A.F4_CODIGO = SD1A.D1_TES "
	cSql += "   AND SF4A.F4_ESTOQUE = ? AND SF4A.D_E_L_E_T_ = ? "
	// CA2050:SUPPRESS - bpB9Piso devolve SQL parametrizado; os valores entram por bpB9PisoBd
	cSql += " LEFT JOIN ( " + bpB9Piso("B9PB") + " ) B9MB ON B9MB.B9_COD = SD1A.D1_COD "
	cSql += " WHERE SD1A.D1_FILIAL = ? "
	cSql += "   AND SD1A.D1_LOCAL  = ? "
	cSql += "   AND SD1A.D1_COD   >= ? "
	cSql += "   AND SD1A.D1_COD   <= ? "
	cSql += "   AND SD1A.D1_DTDIGIT > " + cIsNull + "( B9MB.B9_DTMAX, ? ) "
	cSql += "   AND SD1A.D1_DTDIGIT < ? "
	cSql += "   AND SD1A.D1_ORIGLAN <> ? "
	// Exclui a NF de credito com complemento de reducao de valores (D1_TIPODOC='54'),
	// exceto formulario proprio (D1_FORMUL='S'), reproduzindo o skip por IsReverseFlow
	// que o xCalcEst faz no laco do SD1. D1_TIPODOC = D1_TIPO+D1_TPCOMPL, logo o teste
	// de '54' ja implica D1_TIPO='5' - nao e preciso repetir o filtro de tipo.
	cSql += "   AND ( SD1A.D1_TIPODOC <> ? OR SD1A.D1_FORMUL = ? ) "
	cSql += "   AND SD1A.D_E_L_E_T_ = ? "
	cSql += " GROUP BY SD1A.D1_COD "

Return cSql

/*/{Protheus.doc} bpSldD1Bd
Aplica os binds da leg devolvida por bpSldD1, na ordem TEXTUAL dos '?'.
Mantida colada a bpSldD1 de proposito: as duas devem ser alteradas juntas.
@type function
@param oQuery  , object   , statement em montagem
@param nBind   , numeric  , indice do proximo bind livre
@param cLocPad , character, armazem de processo ajustado ao tamanho do campo
@param jParams , json     , parametros do relatorio (MV_PAR01/02 = faixa de produto)
@param cData   , character, data de corte em formato AAAAMMDD
@param cDtFloor, character, piso usado quando nao ha fechamento SB9
@return numeric, proximo indice de bind livre
@author Squad Entradas
@since 09/2026
/*/
Static Function bpSldD1Bd(oQuery as Object, nBind as Numeric, cLocPad as Character, jParams as Json, cData as Character, cDtFloor as Character) as Numeric

	oQuery:SetString(nBind++, FWxFilial("SF4"))         // SF4A.F4_FILIAL
	oQuery:SetString(nBind++, 'S')                      // SF4A.F4_ESTOQUE - DEVE ser 'S' (movimenta estoque)
	oQuery:SetString(nBind++, ' ')                      // SF4A.D_E_L_E_T_
	nBind := bpB9PisoBd(oQuery, nBind, cLocPad, jParams, cData)  // tabela derivada B9PB
	oQuery:SetString(nBind++, FWxFilial("SD1"))         // SD1A.D1_FILIAL
	oQuery:SetString(nBind++, cLocPad)                  // SD1A.D1_LOCAL
	oQuery:SetString(nBind++, jParams["MV_PAR01"][1])   // SD1A.D1_COD >=
	oQuery:SetString(nBind++, jParams["MV_PAR02"][1])   // SD1A.D1_COD <=
	oQuery:SetString(nBind++, cDtFloor)                 // piso sem fechamento
	oQuery:SetString(nBind++, cData)                    // teto (exclusivo)
	oQuery:SetString(nBind++, 'LF')                     // SD1A.D1_ORIGLAN <>
	oQuery:SetString(nBind++, '54')                     // SD1A.D1_TIPODOC <> - NF de credito / reducao de valores
	oQuery:SetString(nBind++, 'S')                      // SD1A.D1_FORMUL = - excecao: formulario proprio
	oQuery:SetString(nBind++, ' ')                      // SD1A.D_E_L_E_T_

Return nBind

/*/{Protheus.doc} bpSldD2
LEG 3 de bpLoadSald - saidas (SD2) posteriores ao fechamento, com TES que movimenta
estoque. Entram com sinal NEGATIVO, pois o xCalcEst subtrai o SD2 do saldo.
A coluna de corte temporal vem por parametro (D2_DTDIGIT ou D2_EMISSAO) - ver a nota
sobre UsaD2DTDIG em bpLoadSald.
Os binds correspondentes DEVEM ser aplicados por bpSldD2Bd, na mesma ordem textual.
@type function
@param cIsNull, character, funcao de nulo do banco (MatIsNull)
@param cD2Data, character, coluna de corte temporal do SD2 resolvida por UsaD2DTDIG()
@return character, texto SQL da leg (sem o UNION ALL)
@author Squad Entradas
@since 09/2026
/*/
Static Function bpSldD2(cIsNull as Character, cD2Data as Character) as Character
	Local cSql := "" as Character

	cSql := " SELECT SD2A.D2_COD COD, -SUM(SD2A.D2_QUANT) QTD, -SUM(SD2A.D2_CUSTO1) CST "
	cSql += " FROM " + RetSQLName("SD2") + " SD2A "
	cSql += " INNER JOIN " + RetSQLName("SF4") + " SF4B "
	cSql += "    ON SF4B.F4_FILIAL = ? AND SF4B.F4_CODIGO = SD2A.D2_TES "
	cSql += "   AND SF4B.F4_ESTOQUE = ? AND SF4B.D_E_L_E_T_ = ? "
	// CA2050:SUPPRESS - bpB9Piso devolve SQL parametrizado; os valores entram por bpB9PisoBd
	cSql += " LEFT JOIN ( " + bpB9Piso("B9PC") + " ) B9MC ON B9MC.B9_COD = SD2A.D2_COD "
	cSql += " WHERE SD2A.D2_FILIAL = ? "
	cSql += "   AND SD2A.D2_LOCAL  = ? "
	cSql += "   AND SD2A.D2_COD   >= ? "
	cSql += "   AND SD2A.D2_COD   <= ? "
	// CA2050:SUPPRESS - cD2Data e um nome de coluna resolvido por UsaD2DTDIG(), sem input de usuario
	cSql += "   AND SD2A." + cD2Data + " > " + cIsNull + "( B9MC.B9_DTMAX, ? ) "
	cSql += "   AND SD2A." + cD2Data + " < ? "
	cSql += "   AND SD2A.D2_ORIGLAN <> ? "
	cSql += "   AND SD2A.D_E_L_E_T_ = ? "
	cSql += " GROUP BY SD2A.D2_COD "

Return cSql

/*/{Protheus.doc} bpSldD2Bd
Aplica os binds da leg devolvida por bpSldD2, na ordem TEXTUAL dos '?'.
Mantida colada a bpSldD2 de proposito: as duas devem ser alteradas juntas.
@type function
@param oQuery  , object   , statement em montagem
@param nBind   , numeric  , indice do proximo bind livre
@param cLocPad , character, armazem de processo ajustado ao tamanho do campo
@param jParams , json     , parametros do relatorio (MV_PAR01/02 = faixa de produto)
@param cData   , character, data de corte em formato AAAAMMDD
@param cDtFloor, character, piso usado quando nao ha fechamento SB9
@return numeric, proximo indice de bind livre
@author Squad Entradas
@since 09/2026
/*/
Static Function bpSldD2Bd(oQuery as Object, nBind as Numeric, cLocPad as Character, jParams as Json, cData as Character, cDtFloor as Character) as Numeric

	oQuery:SetString(nBind++, FWxFilial("SF4"))         // SF4B.F4_FILIAL
	oQuery:SetString(nBind++, 'S')                      // SF4B.F4_ESTOQUE - DEVE ser 'S' (movimenta estoque)
	oQuery:SetString(nBind++, ' ')                      // SF4B.D_E_L_E_T_
	nBind := bpB9PisoBd(oQuery, nBind, cLocPad, jParams, cData)  // tabela derivada B9PC
	oQuery:SetString(nBind++, FWxFilial("SD2"))         // SD2A.D2_FILIAL
	oQuery:SetString(nBind++, cLocPad)                  // SD2A.D2_LOCAL
	oQuery:SetString(nBind++, jParams["MV_PAR01"][1])   // SD2A.D2_COD >=
	oQuery:SetString(nBind++, jParams["MV_PAR02"][1])   // SD2A.D2_COD <=
	oQuery:SetString(nBind++, cDtFloor)                 // piso sem fechamento
	oQuery:SetString(nBind++, cData)                    // teto (exclusivo)
	oQuery:SetString(nBind++, 'LF')                     // SD2A.D2_ORIGLAN <>
	oQuery:SetString(nBind++, ' ')                      // SD2A.D_E_L_E_T_

Return nBind

/*/{Protheus.doc} bpSldD3
LEG 4 de bpLoadSald - movimentos internos (SD3) do PROPRIO armazem de processo.
O sinal segue o Tipo de Movimento, como no xCalcEst: D3_TM > '500' sai (negativo),
caso contrario entra (positivo). Aplica a validacao de TM na SF5 (bpSF5Whr) e, salvo
MV_D3ESTOR = 'S', despreza movimentos estornados.
Os binds correspondentes DEVEM ser aplicados por bpSldD3Bd, na mesma ordem textual.
@type function
@param cIsNull , character, funcao de nulo do banco (MatIsNull)
@param lD3Estor, logical  , MV_D3ESTOR = 'S' - considera movimentos estornados
@return character, texto SQL da leg (sem o UNION ALL)
@author Squad Entradas
@since 09/2026
/*/
Static Function bpSldD3(cIsNull as Character, lD3Estor as Logical) as Character
	Local cSql := "" as Character

	cSql := " SELECT SD3A.D3_COD COD "
	cSql += "      , SUM( CASE WHEN SD3A.D3_TM > ? THEN -SD3A.D3_QUANT  ELSE SD3A.D3_QUANT  END ) QTD "
	cSql += "      , SUM( CASE WHEN SD3A.D3_TM > ? THEN -SD3A.D3_CUSTO1 ELSE SD3A.D3_CUSTO1 END ) CST "
	cSql += " FROM " + RetSQLName("SD3") + " SD3A "
	// CA2050:SUPPRESS - bpB9Piso devolve SQL parametrizado; os valores entram por bpB9PisoBd
	cSql += " LEFT JOIN ( " + bpB9Piso("B9PD") + " ) B9MD ON B9MD.B9_COD = SD3A.D3_COD "
	cSql += " WHERE SD3A.D3_FILIAL = ? "
	cSql += "   AND SD3A.D3_LOCAL  = ? "
	cSql += "   AND SD3A.D3_COD   >= ? "
	cSql += "   AND SD3A.D3_COD   <= ? "
	cSql += "   AND SD3A.D3_EMISSAO > " + cIsNull + "( B9MD.B9_DTMAX, ? ) "
	cSql += "   AND SD3A.D3_EMISSAO < ? "
	If !lD3Estor
		cSql += "   AND SD3A.D3_ESTORNO <> ? "
	EndIf
	// CA2050:SUPPRESS - bpSF5Whr devolve SQL parametrizado; os valores entram por bpSF5Bd
	cSql += bpSF5Whr("SD3A", "SF5A")
	cSql += "   AND SD3A.D_E_L_E_T_ = ? "
	cSql += " GROUP BY SD3A.D3_COD "

Return cSql

/*/{Protheus.doc} bpSldD3Bd
Aplica os binds da leg devolvida por bpSldD3, na ordem TEXTUAL dos '?'.
Mantida colada a bpSldD3 de proposito: as duas devem ser alteradas juntas - em especial
o bind condicional de D3_ESTORNO, que existe apenas quando lD3Estor e .F.
@type function
@param oQuery  , object   , statement em montagem
@param nBind   , numeric  , indice do proximo bind livre
@param cLocPad , character, armazem de processo ajustado ao tamanho do campo
@param jParams , json     , parametros do relatorio (MV_PAR01/02 = faixa de produto)
@param cData   , character, data de corte em formato AAAAMMDD
@param cDtFloor, character, piso usado quando nao ha fechamento SB9
@param lD3Estor, logical  , MV_D3ESTOR = 'S' - considera movimentos estornados
@return numeric, proximo indice de bind livre
@author Squad Entradas
@since 09/2026
/*/
Static Function bpSldD3Bd(oQuery as Object, nBind as Numeric, cLocPad as Character, jParams as Json, cData as Character, cDtFloor as Character, lD3Estor as Logical) as Numeric

	oQuery:SetString(nBind++, '500')                    // CASE quantidade: D3_TM > '500'
	oQuery:SetString(nBind++, '500')                    // CASE custo     : D3_TM > '500'
	nBind := bpB9PisoBd(oQuery, nBind, cLocPad, jParams, cData)  // tabela derivada B9PD
	oQuery:SetString(nBind++, FWxFilial("SD3"))         // SD3A.D3_FILIAL
	oQuery:SetString(nBind++, cLocPad)                  // SD3A.D3_LOCAL
	oQuery:SetString(nBind++, jParams["MV_PAR01"][1])   // SD3A.D3_COD >=
	oQuery:SetString(nBind++, jParams["MV_PAR02"][1])   // SD3A.D3_COD <=
	oQuery:SetString(nBind++, cDtFloor)                 // piso sem fechamento
	oQuery:SetString(nBind++, cData)                    // teto (exclusivo)
	If !lD3Estor
		oQuery:SetString(nBind++, 'S')                  // SD3A.D3_ESTORNO <>
	EndIf
	nBind := bpSF5Bd(oQuery, nBind)                     // validacao de TM na SF5
	oQuery:SetString(nBind++, ' ')                      // SD3A.D_E_L_E_T_

Return nBind

/*/{Protheus.doc} bpSldPrc
LEG 5 de bpLoadSald - BLOCO DO ARMAZEM DE PROCESSO. Transferencias de/para processo
registradas em OUTROS armazens (D3_LOCAL <> MV_LOCPROC) com D3_CF 'RE3' (soma) ou 'DE3'
(subtrai). E o bloco que o xCalcEst executa SOMENTE quando o armazem consultado e o de
processo, e a razao pela qual o getSaldoSQL do costComparison nao pode ser reaproveitado
aqui - ver a nota completa no header de bpLoadSald.
Os binds correspondentes DEVEM ser aplicados por bpSldPrcBd, na mesma ordem textual.
@type function
@param cIsNull , character, funcao de nulo do banco (MatIsNull)
@param lD3Estor, logical  , MV_D3ESTOR = 'S' - considera movimentos estornados
@return character, texto SQL da leg (sem o UNION ALL)
@author Squad Entradas
@since 09/2026
/*/
Static Function bpSldPrc(cIsNull as Character, lD3Estor as Logical) as Character
	Local cSql := "" as Character

	cSql := " SELECT SD3B.D3_COD COD "
	cSql += "      , SUM( CASE WHEN SD3B.D3_CF = ? THEN SD3B.D3_QUANT  ELSE -SD3B.D3_QUANT  END ) QTD "
	cSql += "      , SUM( CASE WHEN SD3B.D3_CF = ? THEN SD3B.D3_CUSTO1 ELSE -SD3B.D3_CUSTO1 END ) CST "
	cSql += " FROM " + RetSQLName("SD3") + " SD3B "
	// CA2050:SUPPRESS - bpB9Piso devolve SQL parametrizado; os valores entram por bpB9PisoBd
	cSql += " LEFT JOIN ( " + bpB9Piso("B9PE") + " ) B9ME ON B9ME.B9_COD = SD3B.D3_COD "
	cSql += " WHERE SD3B.D3_FILIAL = ? "
	cSql += "   AND SD3B.D3_LOCAL <> ? "
	cSql += "   AND SD3B.D3_COD   >= ? "
	cSql += "   AND SD3B.D3_COD   <= ? "
	cSql += "   AND SD3B.D3_CF IN (?) "
	cSql += "   AND SD3B.D3_EMISSAO > " + cIsNull + "( B9ME.B9_DTMAX, ? ) "
	cSql += "   AND SD3B.D3_EMISSAO < ? "
	If !lD3Estor
		cSql += "   AND SD3B.D3_ESTORNO <> ? "
	EndIf
	// CA2050:SUPPRESS - bpSF5Whr devolve SQL parametrizado; os valores entram por bpSF5Bd
	cSql += bpSF5Whr("SD3B", "SF5B")
	cSql += "   AND SD3B.D_E_L_E_T_ = ? "
	cSql += " GROUP BY SD3B.D3_COD "

Return cSql

/*/{Protheus.doc} bpSldPrcBd
Aplica os binds da leg devolvida por bpSldPrc, na ordem TEXTUAL dos '?'.
Mantida colada a bpSldPrc de proposito: as duas devem ser alteradas juntas - em especial
o bind condicional de D3_ESTORNO, que existe apenas quando lD3Estor e .F.
@type function
@param oQuery  , object   , statement em montagem
@param nBind   , numeric  , indice do proximo bind livre
@param cLocPad , character, armazem de processo ajustado ao tamanho do campo
@param jParams , json     , parametros do relatorio (MV_PAR01/02 = faixa de produto)
@param cData   , character, data de corte em formato AAAAMMDD
@param cDtFloor, character, piso usado quando nao ha fechamento SB9
@param lD3Estor, logical  , MV_D3ESTOR = 'S' - considera movimentos estornados
@return numeric, proximo indice de bind livre
@author Squad Entradas
@since 09/2026
/*/
Static Function bpSldPrcBd(oQuery as Object, nBind as Numeric, cLocPad as Character, jParams as Json, cData as Character, cDtFloor as Character, lD3Estor as Logical) as Numeric

	oQuery:SetString(nBind++, 'RE3')                    // CASE quantidade: 'RE3' soma, 'DE3' subtrai
	oQuery:SetString(nBind++, 'RE3')                    // CASE custo     : 'RE3' soma, 'DE3' subtrai
	nBind := bpB9PisoBd(oQuery, nBind, cLocPad, jParams, cData)  // tabela derivada B9PE
	oQuery:SetString(nBind++, FWxFilial("SD3"))         // SD3B.D3_FILIAL
	oQuery:SetString(nBind++, cLocPad)                  // SD3B.D3_LOCAL <> armazem de processo
	oQuery:SetString(nBind++, jParams["MV_PAR01"][1])   // SD3B.D3_COD >=
	oQuery:SetString(nBind++, jParams["MV_PAR02"][1])   // SD3B.D3_COD <=
	oQuery:SetIn(nBind++, {'RE3','DE3'})                // SD3B.D3_CF IN
	oQuery:SetString(nBind++, cDtFloor)                 // piso sem fechamento
	oQuery:SetString(nBind++, cData)                    // teto (exclusivo)
	If !lD3Estor
		oQuery:SetString(nBind++, 'S')                  // SD3B.D3_ESTORNO <>
	EndIf
	nBind := bpSF5Bd(oQuery, nBind)                     // validacao de TM na SF5
	oQuery:SetString(nBind++, ' ')                      // SD3B.D_E_L_E_T_

Return nBind

/*/{Protheus.doc} bpGetSald
Consulta em memoria a pre-carga de saldo do armazem de processo. Devolve o mesmo par de
valores que o codigo consumia de CalcEst(): {quantidade, custo na moeda 1}.

Comportamento quando a chave nao existe: a pre-carga soma saldo inicial (SB9) e
movimentos (SD1/SD2/SD3); a ausencia do produto significa que nao ha fechamento nem
movimento no periodo, ou seja saldo ZERO - exatamente o que CalcEst() devolveria. Por
isso NAO se recorre a CalcEst() nesse caso, evitando reintroduzir o N+1.

O modo fallback e sinalizado pelo parametro lFallB, NAO por um jSaldo Nil: comparar um
objeto com Nil usando "==" levanta "type mismatch on ==" em runtime, e o Json tipado do
TLPP nao deve receber Nil. Em fallback jSaldo chega como Json vazio e a CalcEst()
original e chamada, preservando a regra customizada do cliente.

@param jSaldo , json     , pre-carga de bpLoadSald (vazia em modo fallback)
@param lFallB , logical  , .T. quando o Entry Point D3VALIDO esta ativo
@param cCod   , character, codigo do produto
@param cLocPrc, character, armazem de processo (usado apenas no fallback)
@param dData  , date     , data de corte (usada apenas no fallback)
@return array, {quantidade, custo moeda 1}
@author Squad Entradas
@since 09/2026
/*/
Static Function bpGetSald(jSaldo as Json, lFallB as Logical, cCod as Character, cLocPrc as Character, dData as Date) as Array
	Local aRet as Array
	Local cKey := AllTrim(cCod) as Character

	If lFallB
		// Fallback: Entry Point D3VALIDO ativo - a regra por registro do SD3 nao e
		// reproduzivel em SQL, portanto mantem-se o calculo original.
		aRet := CalcEst(cCod, cLocPrc, dData, Nil)
	ElseIf jSaldo:hasProperty(cKey)
		aRet := jSaldo[cKey]
	Else
		aRet := {0, 0}
	EndIf

Return aRet

/*/{Protheus.doc} bpCcPiso
Devolve o SQL da tabela derivada que resolve, por PRODUTO, a data do ultimo fechamento
FIFO (SCC) ATE a data de corte, no armazem de processo. Equivale ao ponto de partida do
saldo FIFO do xCalcEstFF (o DbSeek no SCC seguido do DbSkip(-1)) e alimenta tanto o
fechamento (leg 1 de bpLoadSldFF) quanto o piso dos movimentos SD8 (leg 2).

A filial e o armazem sao fixos no contexto de uso, por isso agrupa somente por produto.
A data e comparada pela expressao normalizada de bpDtNorm - CC_DATA vazia recebe o mesmo
tratamento de B9_DATA vazia, ver a nota naquela funcao.
Diferente do SB9, o corte aqui e INCLUSIVO (<=), como no xCalcEstFF.

Os binds correspondentes DEVEM ser aplicados por bpCcPisoBd, na mesma ordem textual.
@type Static Function
@param cAls, character, alias a usar para a SCC nesta tabela derivada (deve ser unico no
                        statement, pois a SCC aparece varias vezes)
@return character, texto SQL da tabela derivada (sem os parenteses externos)
@author Squad Entradas
@since 09/2026
/*/
Static Function bpCcPiso(cAls as Character) as Character
	Local cSub := "" as Character
	// CA2050:SUPPRESS - bpDtNorm devolve expressao com literais fixos, sem input de usuario
	Local cExp := bpDtNorm(cAls + ".CC_DATA") as Character

	cSub := " SELECT " + cAls + ".CC_PRODUTO, MAX(" + cExp + ") CC_DTMAX "
	cSub += " FROM " + RetSQLName("SCC") + " " + cAls + " "
	cSub += " WHERE " + cAls + ".CC_FILIAL = ? "    //1 filial
	cSub += "   AND " + cAls + ".CC_LOCAL  = ? "    //2 armazem de processo
	cSub += "   AND " + cAls + ".CC_PRODUTO >= ? "  //3 produto de
	cSub += "   AND " + cAls + ".CC_PRODUTO <= ? "  //4 produto ate
	cSub += "   AND " + cExp + " <= ? "             //5 fechamento ate a data de corte (inclusivo)
	cSub += "   AND " + cAls + ".D_E_L_E_T_ = ? "   //6
	cSub += " GROUP BY " + cAls + ".CC_PRODUTO "

Return cSub

/*/{Protheus.doc} bpCcPisoBd
Aplica em oQuery os binds do SQL devolvido por bpCcPiso, na ordem TEXTUAL dos '?'.
Mantida colada a bpCcPiso de proposito: as duas devem ser alteradas juntas.
@type Static Function
@param oQuery , object   , statement em montagem
@param nBind  , numeric  , indice do proximo bind livre
@param cLocPad, character, armazem de processo ja ajustado ao tamanho do campo
@param jParams, json     , parametros do relatorio (MV_PAR01/02 = faixa de produto)
@param cData  , character, data de corte em formato AAAAMMDD
@return numeric, proximo indice de bind livre
@author Squad Entradas
@since 09/2026
/*/
Static Function bpCcPisoBd(oQuery as Object, nBind as Numeric, cLocPad as Character, jParams as Json, cData as Character) as Numeric

	oQuery:SetString(nBind++, FWxFilial("SCC"))        //1 CC_FILIAL
	oQuery:SetString(nBind++, cLocPad)                 //2 CC_LOCAL
	oQuery:SetString(nBind++, jParams["MV_PAR01"][1])  //3 CC_PRODUTO >=
	oQuery:SetString(nBind++, jParams["MV_PAR02"][1])  //4 CC_PRODUTO <=
	oQuery:SetString(nBind++, cData)                   //5 CC_DATA normalizada <=
	oQuery:SetString(nBind++, ' ')                     //6 D_E_L_E_T_

Return nBind

/*/{Protheus.doc} bpLoadSldFF
Pre-carga em lote do saldo FIFO (quantidade e custo FIFO na moeda 1) do ARMAZEM DE
PROCESSO para todos os produtos da faixa do relatorio, em UMA unica query - simulando
em SQL o que CalcEstFF() faz produto a produto. Substitui as N chamadas de CalcEstFF()
que rodavam dentro do laco de produtos do armazem de processo (N+1).

CAMINHO REPLICADO: CalcEstFF() delega para xCalcEstFF() sempre que o fechamento FIFO
esta em uso (IsFechFifo()), e o xCalcEstFF compoe o saldo como:
  saldo FIFO = SUM(CC_QFIM / CC_VFIMFF1) do ultimo fechamento SCC com CC_DATA <= dData
             + SUM(D8_QUANT / D8_CUSTO1) dos movimentos SD8 posteriores a esse
               fechamento e ate dData, com D8_TM <= '500' e D8_TIPONF <> 'E'
As duas parcelas sao legs de um UNION ALL somadas por produto no GROUP BY externo.
O recorte do SD8 segue o padrao homologado da Fase 2 de backoffice.sv.est.stockposition.

PRODUTOS SEM REGISTRO NA SCC: sao exatamente os casos em que o xCalcEstFF desiste do
caminho SCC e recompoe o saldo pelo SB9 (B9_VINIFF*) chamando CalcEstFF com lForcaSB9.
Esses produtos NAO aparecem no retorno desta pre-carga (a leg do SD8 tem INNER JOIN com
o fechamento SCC), e bpGetSldFF recorre a CalcEstFF() apenas para eles - preservando o
resultado e reduzindo o N+1 ao residual.

Diferente de bpLoadSald, o teto de data aqui e INCLUSIVO (<= dData): essa assimetria
existe no padrao (xCalcEst usa "< dData" e xCalcEstFF "<= dData") e foi mantida para
nao alterar o valor apurado.

@param cLocPrc, character, armazem de processo (MV_LOCPROC da filial corrente)
@param dData  , date     , data de corte (inclusiva - a mesma passada a CalcEstFF)
@param jParams, json     , parametros do relatorio (MV_PAR01/02 = faixa de produto)
@return json, chave = produto (AllTrim), valor = array {quantidade FIFO, custo FIFO moeda 1}
@author Squad Entradas
@since 09/2026
/*/
Static Function bpLoadSldFF(cLocPrc as Character, dData as Date, jParams as Json) as Json
	Local oQuery   as Object
	Local cQuery   := "" as Character
	Local cAlias   := "" as Character
	Local jRet     := JsonObject():New() as Json
	Local nBind    := 1 as Numeric
	Local cIsNull  := MatIsNull() as Character
	Local cData    := DTOS(dData) as Character
	Local cLocPad  := PadR(cLocPrc, TamSX3("CC_LOCAL")[1]) as Character
	Local cDtFloor := "00000000" as Character
	// Montagem: uma leg por parcela do xCalcEstFF, cada uma com a sua funcao de bind
	// colada a ela. A ordem das legs aqui DEVE ser a mesma da secao de binds abaixo.
	// CA2050:SUPPRESS - as funcoes de leg devolvem SQL parametrizado; valores entram nos binds
	cQuery := " SELECT T.COD, SUM(T.QTD) QTD, SUM(T.CST) CST FROM ( "
	cQuery += bpFFScc()                              // leg 1 - fechamento FIFO (SCC)
	cQuery += " UNION ALL " + bpFFSd8(cIsNull)       // leg 2 - movimentos FIFO (SD8)
	cQuery += " ) T GROUP BY T.COD "

	cQuery := ChangeQuery(cQuery)
	oQuery := FwExecStatement():New(cQuery)

	// Binds na ordem TEXTUAL dos '?' - a MESMA sequencia de legs da montagem acima.
	nBind := bpFFSccBd(oQuery, nBind, cLocPad, jParams, cData)
	nBind := bpFFSd8Bd(oQuery, nBind, cLocPrc, cLocPad, jParams, cData, cDtFloor)

		cAlias := oQuery:OpenAlias()
		While (cAlias)->(!Eof())
			jRet[ AllTrim((cAlias)->COD) ] := { (cAlias)->QTD, (cAlias)->CST }
			(cAlias)->(dbSkip())
		EndDo

	If !Empty(cAlias) .And. Select(cAlias) > 0
		(cAlias)->(DBCloseArea())
	EndIf
	oQuery:Destroy()


Return jRet

/*/{Protheus.doc} bpFFScc
LEG 1 de bpLoadSldFF - fechamento FIFO (SCC) na data do ultimo fechamento ATE a data de
corte. Usa SUM porque pode haver mais de um lote FIFO na mesma data, exatamente como o
xCalcEstFF quando percorre o SCC sem lote informado.
Os binds correspondentes DEVEM ser aplicados por bpFFSccBd, na mesma ordem textual.
@type function
@return character, texto SQL da leg (sem o UNION ALL)
@author Squad Entradas
@since 09/2026
/*/
Static Function bpFFScc() as Character
	Local cSql := "" as Character

	cSql := " SELECT CCD.CC_PRODUTO COD, SUM(CCD.CC_QFIM) QTD, SUM(CCD.CC_VFIMFF1) CST "
	cSql += " FROM " + RetSQLName("SCC") + " CCD "
	// CA2050:SUPPRESS - bpCcPiso devolve SQL parametrizado; os valores entram por bpCcPisoBd
	cSql += " INNER JOIN ( " + bpCcPiso("CCPA") + " ) CCMA "
	cSql += "    ON CCMA.CC_PRODUTO = CCD.CC_PRODUTO "
	// CA2050:SUPPRESS - bpDtNorm devolve expressao com literais fixos, sem input de usuario
	cSql += "   AND " + bpDtNorm("CCD.CC_DATA") + " = CCMA.CC_DTMAX "
	cSql += " WHERE CCD.CC_FILIAL = ? "
	cSql += "   AND CCD.CC_LOCAL  = ? "
	cSql += "   AND CCD.D_E_L_E_T_ = ? "
	cSql += " GROUP BY CCD.CC_PRODUTO "

Return cSql

/*/{Protheus.doc} bpFFSccBd
Aplica os binds da leg devolvida por bpFFScc, na ordem TEXTUAL dos '?'.
Mantida colada a bpFFScc de proposito: as duas devem ser alteradas juntas.
@type function
@param oQuery , object   , statement em montagem
@param nBind  , numeric  , indice do proximo bind livre
@param cLocPad, character, armazem de processo ajustado ao tamanho de CC_LOCAL
@param jParams, json     , parametros do relatorio (MV_PAR01/02 = faixa de produto)
@param cData  , character, data de corte em formato AAAAMMDD
@return numeric, proximo indice de bind livre
@author Squad Entradas
@since 09/2026
/*/
Static Function bpFFSccBd(oQuery as Object, nBind as Numeric, cLocPad as Character, jParams as Json, cData as Character) as Numeric

	nBind := bpCcPisoBd(oQuery, nBind, cLocPad, jParams, cData)  // tabela derivada CCPA
	oQuery:SetString(nBind++, FWxFilial("SCC"))        // CCD.CC_FILIAL
	oQuery:SetString(nBind++, cLocPad)                 // CCD.CC_LOCAL
	oQuery:SetString(nBind++, ' ')                     // CCD.D_E_L_E_T_

Return nBind

/*/{Protheus.doc} bpFFSd8
LEG 2 de bpLoadSldFF - movimentos FIFO (SD8) entre o fechamento e a data de corte.
O INNER JOIN com a tabela derivada do SCC garante que apenas produtos COM fechamento
FIFO entrem; os demais ficam para o fallback de bpGetSldFF, que os devolve a CalcEstFF -
mesmo desvio que o xCalcEstFF faz ao recompor pelo SB9. O recorte (D8_TM <= '500',
D8_TIPONF <> 'E') segue o padrao homologado da Fase 2 de backoffice.sv.est.stockposition.
Os binds correspondentes DEVEM ser aplicados por bpFFSd8Bd, na mesma ordem textual.
@type function
@param cIsNull, character, funcao de nulo do banco (MatIsNull)
@return character, texto SQL da leg (sem o UNION ALL)
@author Squad Entradas
@since 09/2026
/*/
Static Function bpFFSd8(cIsNull as Character) as Character
	Local cSql := "" as Character

	cSql := " SELECT SD8A.D8_PRODUTO COD, SUM(SD8A.D8_QUANT) QTD, SUM(SD8A.D8_CUSTO1) CST "
	cSql += " FROM " + RetSQLName("SD8") + " SD8A "
	// CA2050:SUPPRESS - bpCcPiso devolve SQL parametrizado; os valores entram por bpCcPisoBd
	cSql += " INNER JOIN ( " + bpCcPiso("CCPB") + " ) CCMB ON CCMB.CC_PRODUTO = SD8A.D8_PRODUTO "
	cSql += " WHERE SD8A.D8_FILIAL = ? "
	cSql += "   AND SD8A.D8_LOCAL  = ? "
	cSql += "   AND SD8A.D8_PRODUTO >= ? "
	cSql += "   AND SD8A.D8_PRODUTO <= ? "
	cSql += "   AND SD8A.D8_DATA > " + cIsNull + "( CCMB.CC_DTMAX, ? ) "
	cSql += "   AND SD8A.D8_DATA <= ? "
	cSql += "   AND SD8A.D8_TM <= ? "
	cSql += "   AND SD8A.D8_TIPONF <> ? "
	cSql += "   AND SD8A.D_E_L_E_T_ = ? "
	cSql += " GROUP BY SD8A.D8_PRODUTO "

Return cSql

/*/{Protheus.doc} bpFFSd8Bd
Aplica os binds da leg devolvida por bpFFSd8, na ordem TEXTUAL dos '?'.
Mantida colada a bpFFSd8 de proposito: as duas devem ser alteradas juntas.
Recebe cLocPrc porque D8_LOCAL e ajustado pelo tamanho do proprio campo, nao pelo de
CC_LOCAL usado na tabela derivada do SCC.
@type function
@param oQuery  , object   , statement em montagem
@param nBind   , numeric  , indice do proximo bind livre
@param cLocPrc , character, armazem de processo sem ajuste de tamanho
@param cLocPad , character, armazem de processo ajustado ao tamanho de CC_LOCAL
@param jParams , json     , parametros do relatorio (MV_PAR01/02 = faixa de produto)
@param cData   , character, data de corte em formato AAAAMMDD
@param cDtFloor, character, piso usado quando nao ha fechamento FIFO
@return numeric, proximo indice de bind livre
@author Squad Entradas
@since 09/2026
/*/
Static Function bpFFSd8Bd(oQuery as Object, nBind as Numeric, cLocPrc as Character, cLocPad as Character, jParams as Json, cData as Character, cDtFloor as Character) as Numeric

	nBind := bpCcPisoBd(oQuery, nBind, cLocPad, jParams, cData)  // tabela derivada CCPB
	oQuery:SetString(nBind++, FWxFilial("SD8"))        // SD8A.D8_FILIAL
	oQuery:SetString(nBind++, PadR(cLocPrc, TamSX3("D8_LOCAL")[1]))  // SD8A.D8_LOCAL
	oQuery:SetString(nBind++, jParams["MV_PAR01"][1])  // SD8A.D8_PRODUTO >=
	oQuery:SetString(nBind++, jParams["MV_PAR02"][1])  // SD8A.D8_PRODUTO <=
	oQuery:SetString(nBind++, cDtFloor)                // piso sem fechamento FIFO
	oQuery:SetString(nBind++, cData)                   // teto (inclusivo)
	oQuery:SetString(nBind++, '500')                   // SD8A.D8_TM <=
	oQuery:SetString(nBind++, 'E')                     // SD8A.D8_TIPONF <>
	oQuery:SetString(nBind++, ' ')                     // SD8A.D_E_L_E_T_

Return nBind

/*/{Protheus.doc} bpGetSldFF
Consulta em memoria a pre-carga de saldo FIFO. Devolve um array com a MESMA ordem de
posicoes de CalcEstFF(): [1] quantidade, [2] custo FIFO na moeda 1.

ATENCAO - o consumidor usa o indice [1]: o codigo original alimentava a coluna
FIFTOTAL ("Soma de Valor FIFO em Processo") com CalcEstFF(...)[1], que na CalcEstFF e a
QUANTIDADE (o valor FIFO da moeda 1 esta em [2]). A ordem das posicoes foi preservada
aqui de proposito para NAO alterar o numero que o relatorio publica hoje. Se a intencao
for de fato publicar o valor, a correcao e trocar o indice para [2] no chamador - o que
muda o resultado do relatorio e portanto exige decisao de negocio.

Fallback: quando lFallB e .T. (fechamento FIFO desligado, IsFechFifo() == .F.) ou quando
o produto nao tem fechamento na SCC, chama-se CalcEstFF() - nos dois casos o xCalcEstFF
recomporia o saldo pelo caminho SB9, fora do escopo da pre-carga. O modo fallback vem
por parametro e nao por um jSldFF Nil - ver a mesma nota em bpGetSald.

@param jSldFF , json     , pre-carga de bpLoadSldFF (vazia em modo fallback)
@param lFallB , logical  , .T. quando IsFechFifo() e .F.
@param cCod   , character, codigo do produto
@param cLocPrc, character, armazem de processo
@param dData  , date     , data de corte
@return array, {quantidade FIFO, custo FIFO moeda 1}
@author Squad Entradas
@since 09/2026
/*/
Static Function bpGetSldFF(jSldFF as Json, lFallB as Logical, cCod as Character, cLocPrc as Character, dData as Date) as Array
	Local aRet as Array
	Local cKey := AllTrim(cCod) as Character

	If !lFallB .And. jSldFF:hasProperty(cKey)
		aRet := jSldFF[cKey]
	Else
		// Sem fechamento FIFO (SCC) para o produto, ou FIFO desligado: o padrao
		// recompoe o saldo pelo SB9 dentro da propria CalcEstFF.
		aRet := CalcEstFF(cCod, cLocPrc, dData, Nil)
	EndIf

Return aRet
