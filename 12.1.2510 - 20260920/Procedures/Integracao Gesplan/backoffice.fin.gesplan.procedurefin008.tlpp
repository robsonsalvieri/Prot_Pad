#include "msobject.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#Include "TOTVS.CH"

namespace totvs.protheus.backoffice.fin.gesplan

//-------------------------------------------------------------------
/*/{Protheus.doc} ProcedureFin008
    @description Classe específica de configuração da procedure Fin008 
    que compõe o pacote de procedures da integração Protheus x Gesplan.
    Responsável pelo processo "CRR - Contas a Receber Realizado"
    @author fabioh.andrade@totvs.com.br
    @since 15/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
class ProcedureFin008 from totvs.protheus.backoffice.fin.gesplan.FinGesplanProcedure
    public method new(cBuffer as character, cEnterPointType as character, cEnterpriseCode as character) as object

    protected method loadParserGeneralPre()
    protected method loadParserOracle()
    protected method loadParserSQLServer()
    protected method loadParserPostgres()
endClass

//-------------------------------------------------------------------
/*/{Protheus.doc} new
    @author fabioh.andrade@totvs.com.br
    @since 15/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method new(cBuffer as character, cEnterPointType as character, cEnterpriseCode as character) as object class ProcedureFin008
    _Super:new(cBuffer,cEnterPointType,cEnterpriseCode)
    self:cOriginFlexFields := "4"
    self:cTableFlexFields := "F7I"
return self


/*/{Protheus.doc} loadParserSQLServer
    @author fabioh.andrade@totvs.com.br
    @since 15/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method loadParserGeneralPre() class ProcedureFin008
    _Super:loadParserGeneralPre()
    if self:lIsPosCompile
        aAdd(self:jParseGeneralPre[self:cEnterPointType], { "'##ROW_NUMBER'", "ROW_NUMBER() OVER (PARTITION BY fk5.FK5_IDMOV, sev.EV_MSUID, sez.EZ_MSUID ORDER BY fk5.R_E_C_N_O_ DESC)" } )
        aAdd(self:jParseGeneralPre[self:cEnterPointType], { "'##ROW_NUMBER_FKA'", "ROW_NUMBER() OVER (PARTITION BY fk5.FK5_IDMOV, sev.EV_MSUID, sez.EZ_MSUID, fk1.FK1_IDFK1 ORDER BY fk5.R_E_C_N_O_ DESC)" } )
        aAdd(self:jParseGeneralPre[self:cEnterPointType], { "'##ROW_NUMBER_FWI'", "ROW_NUMBER() OVER (PARTITION BY stg_se1.E1_FILIAL,stg_se1.E1_PREFIXO,stg_se1.E1_NUM,stg_se1.E1_PARCELA,stg_se1.E1_TIPO, sev.EV_MSUID, sez.EZ_MSUID ORDER BY fwi.R_E_C_N_O_ DESC)" } )
        aAdd(self:jParseGeneralPre[self:cEnterPointType], { "CONVERT( datetime ,@F7I_EMIS1 ,127 )", "CONVERT( datetime ,@F7I_EMIS1 ,121 )" } )
    endIf
return 

//-------------------------------------------------------------------
/*/{Protheus.doc} loadParserOracle
    @author fabioh.andrade@totvs.com.br
    @since 15/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method loadParserOracle() class ProcedureFin008
    _Super:loadParserOracle()
    if self:lIsPosCompile
        aAdd( self:jParseDatabase[self:cEnterPointType], { "vcStamp  := (" , " " } )
        //Tratamento para carteira descontada
        aAdd( self:jParseDatabase[self:cEnterPointType], { "LOWER (TO_CHAR(HASHBYTES ('MD5' ," , "LOWER(STANDARD_HASH( " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "CONCAT (TRIM (IN_mdmTenantId ), protheus_pk , FWI_SEQ )),'YY.MM.DD'))" , "TRIM (IN_mdmTenantId ) || protheus_pk  || FWI_SEQ, 'MD5') )" } )
        
        aAdd( self:jParseDatabase[self:cEnterPointType], { "vfk5_S_T_A_M_P_ DATE" , "vfk5_S_T_A_M_P_ TIMESTAMP" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "vmaxStagingCounter DATE" , "vmaxStagingCounter TIMESTAMP" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_DATE(vdelTransactTime ,'YYYY-MM-DD HH24:MI:SS.FF3')" , "TO_TIMESTAMP(vdelTransactTime, 'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.FF3')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "= TO_CHAR(fk5.S_T_A_M_P_ ,'YYYY-MM-DD HH24:MI:SS.FF3')" , "= TO_CHAR(fk5.S_T_A_M_P_ ,'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.FF3')" } )                
        //Ajuste para o campo vcStamp
        aAdd( self:jParseDatabase[self:cEnterPointType], { "vcStamp  := (" , " " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "FROM F7J### F7J" , " INTO vcStamp FROM F7J### F7J " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "WHERE F7J.F7J_ALIAS  := 'CRR' );" , "WHERE F7J.F7J_ALIAS  = 'CRR' ;" } )
        //Ajuste para o campo vF7I_DSCMDB
        aAdd( self:jParseDatabase[self:cEnterPointType], { "vF7I_DSCMDB  := (" , " " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "SX6.X6_CONTEUD" , " SX6.X6_CONTEUD INTO vF7I_DSCMDB " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TRIM (SX6.X6_VAR ) :=" , "TRIM (SX6.X6_VAR ) = " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "AND SX6.D_E_L_E_T_  := ' ' )" , "AND SX6.D_E_L_E_T_  = ' '" } )     
        //Ajuste para o campo @cF7I_STAMP
        aAdd( self:jParseDatabase[self:cEnterPointType], { "FORMAT (TO_DATE(vcFk5_STAMP ,'YYYY-MM-DD HH24:MI:SS.FF3'), 'yyyy-MM-ddTHH:mm:ss.fff' );" , "vcFk5_STAMP;" } )
        //Ajuste para o campo @vmaxStagingCounter
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_DATE(vcStamp ,'YYYY-MM-DD HH24:MI:SS.FF3')" , "TO_TIMESTAMP(vcStamp, 'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.FF3')" } )                
        //Ajuste para o campo vcFk5_STAMP
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_CHAR(vfk5_S_T_A_M_P_ ,'YYYY-MM-DD HH24:MI:SS.FF3')" , "TO_CHAR(vfk5_S_T_A_M_P_, 'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.FF3')" } )                
        //Ajuste para o campo vF7I_DSCCCT
        aAdd( self:jParseDatabase[self:cEnterPointType], { "vF7I_DSCCCT  := (" , " " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "FROM CTT###" , "INTO vF7I_DSCCCT  FROM CTT### " } )
        //Ajuste para o campo vfilialCTT
        aAdd( self:jParseDatabase[self:cEnterPointType], { "WHERE CTT_FILIAL  := vfilialCTT  AND CTT_CUSTO  := vED_CCC  AND D_E_L_E_T_  := ' ' );" , "WHERE CTT_FILIAL  = vfilialCTT  AND CTT_CUSTO  = vED_CCC  AND D_E_L_E_T_  = ' ' ;" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "WHERE CTT_FILIAL  := vfilialCTT  AND CTT_CUSTO  := vE1_CCUSTO  AND D_E_L_E_T_  := ' ' );" , "WHERE CTT_FILIAL  = vfilialCTT  AND CTT_CUSTO  = vE1_CCUSTO  AND D_E_L_E_T_  = ' ' ;" } )            
        //tempo 
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_CHAR(MSDATEADD_33_## (HOUR , -1 , GETUTCDATE ),'YYYY-MM-DD HH24:MI:SS.FF3');", "TO_CHAR( SYSTIMESTAMP AT TIME ZONE 'UTC' - INTERVAL '1' HOUR,'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.FF3');" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_CHAR(MSDATEADD_33_## ('YEAR', -2 , SYSDATE ),'YYYYMMDD');", "TO_CHAR(ADD_MONTHS(SYSDATE, -24), 'YYYYMMDD');" } )
    endIf
return 

/*/{Protheus.doc} loadParserPostgres
    @author fabioh.andrade@totvs.com.br
    @since 15/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method loadParserPostgres() class ProcedureFin008
    _Super:loadParserPostgres()    

    if self:lIsPosCompile
        aAdd( self:jParseDatabase[self:cEnterPointType], {  "vcStamp  := (" , " " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "LOWER (TO_CHAR(HASHBYTES ('MD5' ," , "lower(md5(trim(in_mdmTenantId) || protheus_pk || FWI_SEQ)) as FK1_IDFK1" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "CONCAT (TRIM (IN_mdmTenantId )::bpchar , protheus_pk , FWI_SEQ )::bpchar ),'YY.MM.DD'))::bpchar  as FK1_IDFK1" , " " } )
    
        aAdd( self:jParseDatabase[self:cEnterPointType], { "vfk5_S_T_A_M_P_ DATE" , "vfk5_S_T_A_M_P_ TIMESTAMP" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "vmaxStagingCounter DATE" , "vmaxStagingCounter TIMESTAMP" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_DATE(vdelTransactTime ,'YYYY-MM-DD HH24:MI:SS.FF3')" , "TO_TIMESTAMP(vdelTransactTime, 'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.FF3')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "= TO_CHAR(fk5.S_T_A_M_P_ ,'YYYY-MM-DD HH24:MI:SS.FF3')" , "= TO_CHAR(fk5.S_T_A_M_P_ ,'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.FF3')" } )                
        //Ajuste para o campo vcStamp
        aAdd( self:jParseDatabase[self:cEnterPointType], { "vcStamp  := (" , " " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "FROM F7J### F7J" , " INTO vcStamp FROM F7J### F7J " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "WHERE F7J.F7J_ALIAS  := 'CRR' );" , "WHERE F7J.F7J_ALIAS  = 'CRR' ;" } )
        //Ajuste para o campo vF7I_DSCMDB
        aAdd( self:jParseDatabase[self:cEnterPointType], { "vF7I_DSCMDB  := (" , " " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "SX6.X6_CONTEUD" , " SX6.X6_CONTEUD INTO vF7I_DSCMDB " } )

        aAdd( self:jParseDatabase[self:cEnterPointType], { "WHERE TRIM (SX6.X6_VAR )::bpchar  := CONCAT( 'MV_MOEDA'" , "WHERE TRIM (SX6.X6_VAR )::bpchar  = CONCAT( 'MV_MOEDA'" } ) 
        aAdd( self:jParseDatabase[self:cEnterPointType], { " } ) )::bpchar )::bpchar  AND SX6.D_E_L_E_T_  := ' ' )" , " } ) )::bpchar )::bpchar  AND SX6.D_E_L_E_T_  = ' ' " } )   

        aAdd( self:jParseDatabase[self:cEnterPointType], { "FORMAT (TO_DATE(vcFk5_STAMP ,'YYYY-MM-DD HH24:MI:SS.FF3'), 'yyyy-MM-ddTHH:mm:ss.fff' );" , "vcFk5_STAMP;" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_DATE(vcStamp ,'YYYY-MM-DD HH24:MI:SS.FF3')", "vcStamp::timestamp" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_CHAR(vfk5_S_T_A_M_P_ ,'YYYY-MM-DD HH24:MI:SS.FF3')" ,  "TO_CHAR(vfk5_S_T_A_M_P_ ,'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.MS')" } )                
        aAdd( self:jParseDatabase[self:cEnterPointType], { "vF7I_DSCCCT  := (" , " " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "FROM CTT###" , "INTO vF7I_DSCCCT  FROM CTT### " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "WHERE CTT_FILIAL  := vfilialCTT  AND CTT_CUSTO  := vED_CCC  AND D_E_L_E_T_  := ' ' );" , "WHERE CTT_FILIAL  = vfilialCTT  AND CTT_CUSTO  = vED_CCC  AND D_E_L_E_T_  = ' ' ;" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_CHAR(MSDATEADD_33_## (HOUR , -1 , GETUTCDATE ),'YYYY-MM-DD HH24:MI:SS.FF3')", "TO_CHAR((CURRENT_TIMESTAMP AT TIME ZONE 'UTC' - interval '1 hour'), 'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.MS')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_CHAR(MSDATEADD_33_## ('YEAR', -2 , NOW() ),'YYYYMMDD')", "TO_CHAR(CURRENT_DATE - INTERVAL '2 years', 'YYYYMMDD')" } )
    endIf
return 

/*/{Protheus.doc} loadParserSQLServer
    @author fabioh.andrade@totvs.com.br
    @since 15/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method loadParserSQLServer() class ProcedureFin008
    _Super:loadParserSQLServer()
    if self:lIsPosCompile
        aAdd( self:jParseDatabase[self:cEnterPointType], { "and TRIM ( f7j.F7J_STAMP ) = CONVERT( Char( 25 ) ,fk5.S_T_A_M_P_ ,127 )" , "AND CONVERT( datetime ,f7j.F7J_STAMP ,127 ) = fk5.S_T_A_M_P_" } )
    endIf
return 
