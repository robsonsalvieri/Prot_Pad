#include "msobject.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#Include "TOTVS.CH"

namespace totvs.protheus.backoffice.fin.gesplan

//-------------------------------------------------------------------
/*/{Protheus.doc} ProcedureFin010
    @description Classe específica de configuração da procedure Fin010 
    que compõe o pacote de procedures da integração Protheus x Gesplan.
    Responsável pelo processo "MVB - Movimentos Bancários"
    @author fabioh.andrade@totvs.com.br
    @since 15/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
class ProcedureFin010 from totvs.protheus.backoffice.fin.gesplan.FinGesplanProcedure
    public method new(cBuffer as character, cEnterPointType as character, cEnterpriseCode as character) as object

    protected method loadParserGeneralPre()
    protected method loadParserOracle()
    protected method loadParserSQLServer()
    protected method loadParserPostgres()
endClass

//-------------------------------------------------------------------
/*/{Protheus.doc} new
    @author fabioh.andrade@totvs.com.br
    @since 15/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method new(cBuffer as character, cEnterPointType as character, cEnterpriseCode as character) as object class ProcedureFin010
    _Super:new(cBuffer,cEnterPointType,cEnterpriseCode)
    self:cOriginFlexFields := "5"
    self:cTableFlexFields := "F7N"
return self


/*/{Protheus.doc} loadParserSQLServer
    @author fabioh.andrade@totvs.com.br
    @since 15/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method loadParserGeneralPre() class ProcedureFin010
    _Super:loadParserGeneralPre()
    if self:lIsOnCompile
        aAdd(self:jParseGeneralPre[self:cEnterPointType], { "'F7N_DSCMDA'", cValTochar(LEN(X6Conteud())) })
    elseIf self:lIsPosCompile
        aAdd(self:jParseGeneralPre[self:cEnterPointType], { "CONVERT( datetime ,stg.FK5_DATA ,127 )", "CONVERT( datetime ,stg.FK5_DATA ,121 )" } )
    endIf
return 

//-------------------------------------------------------------------
/*/{Protheus.doc} loadParserOracle
    @author fabioh.andrade@totvs.com.br
    @since 15/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method loadParserOracle() class ProcedureFin010
    _Super:loadParserOracle()
    if self:lIsPosCompile
        aAdd( self:jParseDatabase[self:cEnterPointType], { "vcStamp  := (" , " " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "FROM F7J### F7J" , " INTO vcStamp FROM F7J### F7J " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "WHERE F7J.F7J_ALIAS  := 'MVB' )" , "WHERE F7J.F7J_ALIAS  = 'MVB' " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_CHAR(MSDATEADD_33_## (HOUR , -1 , GETUTCDATE ),'YYYY-MM-DD HH24:MI:SS.FF3');", "TO_CHAR( SYSTIMESTAMP AT TIME ZONE 'UTC' - INTERVAL '1' HOUR,'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.FF3');" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "MSDATEADD_33_## ('YEAR', -2 , SYSDATE ),'YYYYMMDD'", "ADD_MONTHS(SYSDATE, -24), 'YYYYMMDD'" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "FORMAT (TO_DATE(vF7N_DATA ), 'yyyy-MM-ddTHH:mm:ss.fff' )", "TO_CHAR(TO_TIMESTAMP(vF7N_DATA , 'YYYYMMDD'), 'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.FF3')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_DATE(vdelTransactTime ,'YYYY-MM-DD HH24:MI:SS.FF3')", "TO_TIMESTAMP(vdelTransactTime ,'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.FF3')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_DATE(vcStamp ,'YYYY-MM-DD HH24:MI:SS.FF3')", "TO_TIMESTAMP(vcStamp ,'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.FF3')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_DATE(stg.FK5_DATA ,'YYYY-MM-DD HH24:MI:SS.FF3')", "TO_TIMESTAMP(stg.FK5_DATA ,'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.FF3')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_CHAR(vS_T_A_M_P_FK5 ,'YYYY-MM-DD HH24:MI:SS.FF3')", "TO_CHAR(vS_T_A_M_P_FK5 ,'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.FF3')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_CHAR(stg.S_T_A_M_P_ ,'YYYY-MM-DD HH24:MI:SS.FF3')", "TO_CHAR(stg.S_T_A_M_P_ ,'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.FF3')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "vS_T_A_M_P_FK5 DATE", "vS_T_A_M_P_FK5 TIMESTAMP" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "vmaxStagingCounter DATE", "vmaxStagingCounter TIMESTAMP" } )

        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_DATE(''", "TO_TIMESTAMP('1900-01-01'" } )
    endIf
return 

/*/{Protheus.doc} loadParserPostgres
    @author fabioh.andrade@totvs.com.br
    @since 15/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method loadParserPostgres() class ProcedureFin010
    _Super:loadParserPostgres()    

    if self:lIsPosCompile
        aAdd( self:jParseDatabase[self:cEnterPointType], { "vcStamp  := (" , " " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "FROM F7J### F7J" , " INTO vcStamp FROM F7J### F7J " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "WHERE F7J.F7J_ALIAS  := 'MVB' )" , "WHERE F7J.F7J_ALIAS  = 'MVB' " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_CHAR(MSDATEADD_33_## (HOUR , -1 , GETUTCDATE ),'YYYY-MM-DD HH24:MI:SS.FF3')", "TO_CHAR((CURRENT_TIMESTAMP AT TIME ZONE 'UTC' - interval '1 hour'), 'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.MS')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_DATE('' ,'YYYY-MM-DD HH24:MI:SS.FF3')" , "TIMESTAMP '1900-01-01 00:00:00' " } )  //INIFILTER
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_CHAR(MSDATEADD_33_## ('YEAR', -2 , NOW() ),'YYYYMMDD')", "TO_CHAR(CURRENT_DATE - interval '2 years', 'YYYYMMDD')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_DATE(vdelTransactTime ,'YYYY-MM-DD HH24:MI:SS.FF3')", "vdelTransactTime::timestamp" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_DATE(vcStamp ,'YYYY-MM-DD HH24:MI:SS.FF3')", "vcStamp::timestamp" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "FORMAT (TO_DATE(vF7N_DATA ), 'yyyy-MM-ddTHH:mm:ss.fff' )", "TO_CHAR(TO_DATE(vF7N_DATA, 'YYYYMMDD')::timestamp, 'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.MS')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_DATE(stg.FK5_DATA ,'YYYY-MM-DD HH24:MI:SS.FF3')", "stg.fk5_data::timestamp" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_CHAR(vS_T_A_M_P_FK5 ,'YYYY-MM-DD HH24:MI:SS.FF3')", "TO_CHAR(vS_T_A_M_P_FK5 ,'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.MS')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_CHAR(stg.S_T_A_M_P_ ,'YYYY-MM-DD HH24:MI:SS.FF3')", "TO_CHAR(stg.S_T_A_M_P_ ,'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.MS')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "vS_T_A_M_P_FK5 DATE", "vS_T_A_M_P_FK5 TIMESTAMP" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "vmaxStagingCounter DATE", "vmaxStagingCounter TIMESTAMP" } )
    endIf
return 

/*/{Protheus.doc} loadParserSQLServer
    @author fabioh.andrade@totvs.com.br
    @since 15/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method loadParserSQLServer() class ProcedureFin010
    _Super:loadParserSQLServer()
    if self:lIsPosCompile
        aAdd( self:jParseDatabase[self:cEnterPointType], { "and TRIM ( f7j.F7J_STAMP ) = CONVERT( Char( 26 ) ,stg.S_T_A_M_P_ ,127 )" , "AND CONVERT( datetime ,f7j.F7J_STAMP ,127 ) = stg.S_T_A_M_P_" } )
    endIf
return 
