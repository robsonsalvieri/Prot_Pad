#include "protheus.ch"
#include "tlpp-core.th"
#include "tlpp-object.th"

namespace totvs.protheus.fiscal.taf.event

//-------------------------------------------------------------------------------------------
/*/{Protheus.doc} EventsItemsService
Classe responsavel por gerenciar a logica de negocio dos endpoints de items dos eventos de documentos fiscais

@type class
@version 1.0
@author Misael Ramos
@since 14/11/2025
/*/
//------------------------------------------------------------------------------
Class EventsItemsService

	protected data jResponse as json

	public  method New() 					as object
	public  method getEventsItemsService() 	as json
	private method getEventType() 			as character
	private method itemsOrFieldsJson() 		as logical
	private method addEmptyProperties() 	as array

EndClass

//------------------------------------------------------------------------------
/*/{Protheus.doc} EventsItemsService::New
Obtem uma nova instancia da classe EventsItemsService

@type method
@version 1.0
@author Misael Ramos
@since 14/11/2025
@return object, retorna uma nova instancia da classe
/*/
//------------------------------------------------------------------------------
Method New() as object Class EventsItemsService

	::jResponse := JsonObject():New()

Return Self

//------------------------------------------------------------------------------
/*/{Protheus.doc} EventsItemsService::getEventsItemsService
Metodo responsavel por obter os dados de items dos eventos de documentos fiscais

@type method
@version 1.0
@author Misael Ramos
@since 14/11/2025
@param cEvent, character, evento do documento fiscal
@param cChvnf, character, chave do documento fiscal
@param cItems, character, items do documento fiscal
@return json, retorna a resposta em formato JSON
/*/
//------------------------------------------------------------------------------
Method getEventsItemsService(cEvent as character, cChvnf as character, cItems as character) as json Class EventsItemsService

	Local oDataRet	 := Nil as object
	Local jItems 	 := Nil as json
	Local jGrid		 := Nil as json
	Local cTypeEvent := ""  as character
	Local cRetData	 := ""  as character
	Local aItems 	 := {}  as array

	cTypeEvent := ::GetEventType(cEvent)

	oDataRet := EventsItemsProtheusData():New("GET")
	oDataRet:setMapFields(cTypeEvent)
	oDataRet:getEventsItems(cTypeEvent, cEvent, cChvnf, cItems)

	If oDataRet:lOk

		cRetData := oDataRet:GetJSONResponse()
		jItems := JsonObject():New()
		jGrid  := JsonObject():New()

		jItems:FromJson(cRetData)
		aItems := jItems:GetJSonObject("items")
		aItems := ::AddEmptyProperties(aItems, cEvent)

		::jResponse["event"] := cEvent

		// Define estrutura do grid baseada no evento
		If ::ItemsOrFieldsJson(cEvent)
			jGrid["items"] := {}
			jGrid["fields"] := aItems
		Else
			jGrid["items"] := aItems
			jGrid["fields"] := {}
		EndIf

		::jResponse["grid"] := jGrid
		::jResponse["hasNext"] := .F.

	EndIf

	oDataRet:DeActivate()

	FreeObj(oDataRet)
	FreeObj(jItems)
	FreeObj(jGrid)

Return ::jResponse

//------------------------------------------------------------------------------
/*/{Protheus.doc} GetEventType
Funcao responsavel por obter o tipo do evento conforme o codigo do evento

@type method
@version 1.0
@author Misael Ramos
@since 14/11/2025
@param cEvent, character, codigo do evento
@return character, retorna o tipo do evento
/*/
//------------------------------------------------------------------------------
Method getEventType(cEvent as character) as character Class EventsItemsService

	Local cTypeEvent   := "" as character
	Local cEventRange1 := "112110" as character
	Local cEventRange2 := "112120, 112130, 112140, 211120, 211124, 211130, 211140" as character
	Local cEventRange3 := "211128, 212120, 212110" as character
	Local cEventRange4 := "211150" as character
	Local cEventRange5 := "211110" as character
	Local cEventRange6 := "112150" as character

	Do Case
		Case cEvent $ cEventRange1
			cTypeEvent := "EVENT_MODEL_1"
		Case cEvent $ cEventRange2
			cTypeEvent := "EVENT_MODEL_2"
		Case cEvent $ cEventRange3
			cTypeEvent := "EVENT_MODEL_3"
		Case cEvent $ cEventRange4
			cTypeEvent := "EVENT_MODEL_4"
		Case cEvent $ cEventRange5
			cTypeEvent := "EVENT_MODEL_5"
		Case cEvent $ cEventRange6
			cTypeEvent := "EVENT_MODEL_6"
	EndCase

Return cTypeEvent

//------------------------------------------------------------------------------
/*/{Protheus.doc} ItemsOrFieldsJson
Determina se o evento deve usar array items ou fields no Json de resposta

@type method
@version 1.0
@author Misael Ramos
@since 15/11/2025
@param cEvent, character, codigo do evento
@return logical, retorna .T. se deve usar items, .F. se deve usar fields
/*/
//------------------------------------------------------------------------------
Method itemsOrFieldsJson(cEvent as character) as logical Class EventsItemsService

	Local lUseFields := .F. as logical
	Local cUseFields := "112110, 112150, 211128, 212110, 212120" as character

	If cEvent $ cUseFields
		lUseFields := .T.
	Else
		lUseFields := .F.
	EndIf

Return lUseFields

//------------------------------------------------------------------------------
/*/{Protheus.doc} AddEmptyProperties
Adiciona propriedade vazia aos itens baseado no evento

@type method
@version 1.0
@author Misael Ramos
@since 15/11/2025
@param aItems, array, array de itens
@param cEvent, character, codigo do evento
@return array, retorna o array com propriedades vazias adicionadas
/*/
//------------------------------------------------------------------------------
Method addEmptyProperties(aItems as array, cEvent as character) as array Class EventsItemsService

	Local nItem		   := 0 as numeric
	Local cAddPropAcce := "211128, 212110, 212120" as character
	Local cAddPropDisc := "112110" as character
	Local cAddPropCred := "211110" as character

	Do Case
		Case cEvent $ cAddPropAcce
			For nItem := 1 To Len(aItems)
				aItems[nItem]["acceptanceIndicator"] := ""
			Next nItem
		Case cEvent $ cAddPropDisc
			For nItem := 1 To Len(aItems)
				aItems[nItem]["dischargeIndicator"] := ""
			Next nItem
		Case cEvent $ cAddPropCred
			For nItem := 1 To Len(aItems)
				aItems[nItem]["creditPercentageIbs"] := 0
				aItems[nItem]["creditPercentageCbs"] := 0
				aItems[nItem]["creditClassificationIbs"] := 0
				aItems[nItem]["creditClassificationCbs"] := 0
			Next nItem
	EndCase

Return aItems
