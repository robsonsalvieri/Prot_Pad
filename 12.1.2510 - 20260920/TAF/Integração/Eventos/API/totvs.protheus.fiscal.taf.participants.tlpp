#include 'tlpp-core.th'
#include 'tlpp-rest.th'
#include 'protheus.ch'

namespace totvs.protheus.fiscal.taf.event

//----------------------------------------------------------------
/*/{Protheus.doc} GetParticipants
Endpoint REST GET /api/taf/fiscal/v1/participants.
Retorna os participantes cadastrados na tabela C1H sem paginacao.

@type      function
@author    GitHub Copilot
@since     24/04/2026
@version   1.0
@return    cJson  Character  JSON de resposta: {items, hasNext} em sucesso
/*/
//----------------------------------------------------------------
@Get('/api/taf/fiscal/v1/participants')
Function GetParticipants() As Character

	Local oResp      As Object
	Local cJson      As Character

	oResp := QueryParticipants()
	cJson := oResp:ToJson()
	oRest:setStatusResponse(200, cJson)

	FwFreeObj(oResp)

Return

//----------------------------------------------------------------
/*/{Protheus.doc} QueryParticipants
Executa a consulta dos participantes na tabela C1H.
Utiliza FwExecStatement e ChangeQuery para portabilidade entre SGBDs.
Retorna codPar, cnpjPar e participant ordenados por C1H_CODPAR.

@type      static function
@author    GitHub Copilot
@since     24/04/2026
@version   1.0
@return    oResp      Object     JsonObject com items e hasNext
/*/
//----------------------------------------------------------------
Static Function QueryParticipants() As Object

	Local oQry       As Object
	Local oResp      As Object
	Local oItem      As Object
	Local cSQL       As Character
	Local cAlias     As Character

	oResp          := JsonObject():New()
	oResp['items'] := {}
	oResp['hasNext'] := .F.

	cSQL := "SELECT C1H.C1H_CODPAR, C1H.C1H_NOME, C1H.C1H_CNPJ, C1H.C1H_CPF " + ;
		"FROM " + RetSqlName('C1H') + " C1H " + ;
		"WHERE C1H.D_E_L_E_T_ = ? " + ;
		"AND C1H.C1H_FILIAL = ? " + ;
		"ORDER BY C1H.C1H_CODPAR "

	cSQL := ChangeQuery(cSQL)

	oQry := FwExecStatement():New(cSQL)
	oQry:SetString(1, Space(1))
	oQry:SetString(2, xFilial('C1H'))

	cAlias := oQry:OpenAlias()

	While !(cAlias)->(EOF())
		oItem := JsonObject():New()
		oItem['codPar']      := AllTrim((cAlias)->C1H_CODPAR)
		oItem['cnpjPar']     := GetParticipantDocument((cAlias)->C1H_CNPJ, (cAlias)->C1H_CPF)
		oItem['participant'] := AllTrim((cAlias)->C1H_NOME)

		aAdd(oResp['items'], oItem)

		(cAlias)->(DBSkip())
	EndDo

	(cAlias)->(DBCloseArea())
	FwFreeObj(oQry)

Return oResp

//----------------------------------------------------------------
/*/{Protheus.doc} GetParticipantDocument
Retorna o documento principal do participante. Quando C1H_CNPJ
estiver vazio, utiliza C1H_CPF como fallback.

@type      static function
@author    GitHub Copilot
@since     24/04/2026
@version   1.0
@param     cCnpj   Character  Valor do campo C1H_CNPJ
@param     cCpf    Character  Valor do campo C1H_CPF
@return    cDoc    Character  Documento principal do participante
/*/
//----------------------------------------------------------------
Static Function GetParticipantDocument(cCnpj As Character, cCpf As Character) As Character

	Local cDoc As Character

	cDoc := AllTrim(cCnpj)
	If Empty(cDoc)
		cDoc := AllTrim(cCpf)
	EndIf

Return cDoc
