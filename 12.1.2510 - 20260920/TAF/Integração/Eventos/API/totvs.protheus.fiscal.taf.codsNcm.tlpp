#INCLUDE 'tlpp-core.th'
#INCLUDE 'tlpp-rest.th'
#INCLUDE 'protheus.ch'

namespace totvs.protheus.fiscal.taf.event

//----------------------------------------------------------------
/*/{Protheus.doc} GetCodsNcm
Endpoint REST GET /api/taf/fiscal/v1/codsNcm.
Retorna os codigos de NCM cadastrados na tabela C0A sem paginacao.

@type      function
@author    GitHub Copilot
@since     24/04/2026
@version   1.0
@return    cJson  Character  JSON de resposta: {items, hasNext} em sucesso
/*/
//----------------------------------------------------------------
@Get('/api/taf/fiscal/v1/codsNcm')
Function GetCodsNcm() As Character

	Local oResp      As Object
	Local cJson      As Character

	oResp := QueryCodsNcm()
	cJson := oResp:ToJson()
	oRest:setStatusResponse(200, cJson)

	FwFreeObj(oResp)

Return

//----------------------------------------------------------------
/*/{Protheus.doc} QueryCodsNcm
Executa a consulta dos codigos de NCM na tabela C0A.
Utiliza FwExecStatement e ChangeQuery para portabilidade entre SGBDs.
Filtra apenas os NCM base com C0A_EXNCM em branco.

@type      static function
@author    GitHub Copilot
@since     24/04/2026
@version   1.0
@return    oResp      Object     JsonObject com items e hasNext
/*/
//----------------------------------------------------------------
Static Function QueryCodsNcm() As Object

	Local oQry       As Object
	Local oResp      As Object
	Local oItem      As Object
	Local cSQL       As Character
	Local cAlias     As Character

	oResp    := JsonObject():New()
	oResp['items'] := {}
	oResp['hasNext'] := .F.

	cSQL := "SELECT C0A.C0A_CODIGO, C0A.C0A_DESCRI " + ;
		"FROM " + RetSqlName('C0A') + " C0A " + ;
		"WHERE C0A.D_E_L_E_T_ = ? " + ;
		"AND C0A.C0A_FILIAL = ? " + ;
		"AND C0A.C0A_EXNCM = ? " + ;
		"ORDER BY C0A.C0A_CODIGO "

	cSQL := ChangeQuery(cSQL)

	oQry := FwExecStatement():New(cSQL)
	oQry:SetString(1, Space(1))
	oQry:SetString(2, xFilial('C0A'))
	oQry:SetString(3, Space(1))

	cAlias := oQry:OpenAlias()

	While !(cAlias)->(EOF())
		oItem := JsonObject():New()
		oItem['codNcm']    := AllTrim((cAlias)->C0A_CODIGO)
		oItem['descriNcm'] := AllTrim((cAlias)->C0A_DESCRI)

		aAdd(oResp['items'], oItem)

		(cAlias)->(DBSkip())
	EndDo

	(cAlias)->(DBCloseArea())
	FwFreeObj(oQry)

Return oResp
