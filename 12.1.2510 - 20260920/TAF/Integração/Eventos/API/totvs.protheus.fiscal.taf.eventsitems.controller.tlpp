#include "protheus.ch"
#include "tlpp-core.th"
#include "tlpp-object.th"
#include "tlpp-rest.th"
#include "totvs.protheus.fiscal.taf.eventsitems.ch"

namespace totvs.protheus.fiscal.taf.event

//------------------------------------------------------------------------------
/*/{Protheus.doc} EventsItems
Classe responsavel por gerenciar os endpoints de items dos eventos de documentos fiscais

@type class
@version 1.0
@author Misael Ramos
@since 14/11/2025
/*/
//------------------------------------------------------------------------------
Class EventsItems

    public data jResponse as json

    public method new() as object

    @Get("/api/taf/fiscal/v1/eventitems")
    public method getEventsItems()

EndClass

//------------------------------------------------------------------------------
/*/{Protheus.doc} EventsItems::new
Metodo construtor da classe EventsItems

@type method
@version 1.0
@author Misael Ramos
@since 14/11/2025
@return object, retorna a instancia da classe
/*/
//------------------------------------------------------------------------------
Method New() as Object Class EventsItems

    ::jResponse := JsonObject():New()

Return Self

//------------------------------------------------------------------------------
/*/{Protheus.doc} EventsItems::getEventsItems
Metodo responsavel por obter os items dos eventos de documentos fiscais

@type method
@version 1.0
@author Misael Ramos
@since 14/11/2025
@return json, retorna a resposta em formato JSON
/*/
//------------------------------------------------------------------------------
Method getEventsItems() Class EventsItems

	Local oService := EventsItemsService():New() as object
	Local jParam := Nil as Json

	jParam := oRest:getQueryRequest()

	If Empty(jParam['event'])
		::jResponse := SetRestFault(400, STR0001,,, STR0002) //#"O parametro 'event' é obrigatório e não foi informado." ##"Informar o parâmetro 'event'."
	ElseIf Empty(jParam['chvnf'])
		::jResponse := SetRestFault(400, STR0003,,, STR0004) //#"O parametro 'chvnf' é obrigatório e não foi informado." ##"Informar o parâmetro 'chvnf'."
	Else
		::jResponse := oService:getEventsItemsService(jParam['event'], jParam['chvnf'], jParam['items'])
	EndIf

	FreeObj(oService)

Return oRest:setResponse(::jResponse)
