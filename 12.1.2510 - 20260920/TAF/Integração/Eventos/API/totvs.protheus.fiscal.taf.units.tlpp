#INCLUDE 'tlpp-core.th'
#INCLUDE 'tlpp-rest.th'
/*-------------------------------------------------------------------
{Protheus.doc} TafUnitsMonEvents()

Monta o retorno dos metodos Get 
@author	Evandro Italo
@since  12/12/2025
-------------------------------------------------------------------*/

@GET(endpoint='/api/taf/fiscal/v1/units', description='Consulta Unidades de Medida')
Function TafUnitsMonEvents()

    Local oJsResponse as json

    oJsResponse := getTafUnitsMonEvents(Nil)
    oRest:setResponse( (oJsResponse ))
    FWFreeObj(oJsResponse)

Return

/*-------------------------------------------------------------------
{Protheus.doc} TafUnitsMonEventsById()
Consulta Unidades de Medida por código

@author	Evandro Italo
@since  12/12/2025
-------------------------------------------------------------------*/

@GET(endpoint='/api/taf/fiscal/v1/units/:codUnit', description='Consulta Unidades de Medida por código')
Function TafUnitsMonEventsById()

    Local oJsResponse as json
    Local cCodUnit      as character

    cCodUnit    := oRest:getPathParamsRequest()['codUnit']
    oJsResponse := getTafUnitsMonEvents(Upper(AllTrim(cCodUnit)))

    oRest:setResponse( (oJsResponse ))
    FWFreeObj(oJsResponse)

Return


/*-------------------------------------------------------------------
{Protheus.doc} getTafUnitsMonEvents()
Consulta Unidades de Medida monta a lista completa ou por código    
@author	Evandro Italo
@since  12/12/2025
-------------------------------------------------------------------*/
Static Function getTafUnitsMonEvents(cFilter as character)

    Local cQry            as character
    Local oJsResponse     as json
    Local oItem           as json
    Local oQry            as object
    Local cAliasQry       as character

    cQry            := ""
    cAliasQry       := getNextAlias()
    oJsResponse     := JsonObject():new()

    cQry := " select C1J.C1J_CODIGO, C1J.C1J_DESCRI "
    cQry += " FROM " + RetSqlName('C1J') + " C1J " 
    cQry += " WHERE C1J.D_E_L_E_T_ = ? "
    cQry += " AND C1J.C1J_FILIAL = ? "
    If (!Empty(cFilter))
        cQry += " AND C1J.C1J_CODIGO = ? "
    EndIf
    cQry += " ORDER BY C1J.C1J_CODIGO "

    cQry := ChangeQuery(cQry)

    oQry := FwExecStatement():New(cQry)

    oQry:SetString(1, '')
    oQry:SetString(2, xFilial('C1J'))
    If (!Empty(cFilter))
        oQry:SetString(3, cFilter)
    EndIf
    cAliasQry := oQry:OpenAlias()

    //Cria a propriedade items como array
    oJsResponse['items'] := {}

    While (cAliasQry)->(!EOF())

        oItem :=  JsonObject():New()
        oItem['codUnit'    ] := AllTrim((cAliasQry)->C1J_CODIGO)
        oItem['description'] := AllTrim((cAliasQry)->C1J_DESCRI)

        AADD(oJsResponse['items'], oItem)

        (cAliasQry)->(DbSkip())
        
    Enddo

    oJsResponse['hasNext'     ] := .F.
    
    (cAliasQry)->(DBCloseArea())

Return oJsResponse
