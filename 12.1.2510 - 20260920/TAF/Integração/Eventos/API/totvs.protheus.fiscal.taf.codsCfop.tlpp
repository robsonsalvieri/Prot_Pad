#INCLUDE 'tlpp-core.th'
#INCLUDE 'tlpp-rest.th'
#INCLUDE 'protheus.ch'

namespace totvs.protheus.fiscal.taf.event

//----------------------------------------------------------------
/*/{Protheus.doc} GetCodsCfop
Endpoint REST GET /api/taf/fiscal/v1/codsCfop.
Retorna os codigos de CFOP cadastrados na tabela C0Y sem paginacao.

@type      function
@author    GitHub Copilot
@since     23/04/2026
@version   1.0
@return    cJson  Character  JSON de resposta: {items, hasNext} em sucesso
/*/
//----------------------------------------------------------------
@Get('/api/taf/fiscal/v1/codsCfop')
Function GetCodsCfop() As Character

	Local oResp      As Object
	Local cJson      As Character

	oResp := QueryCodsCfop()
	cJson := oResp:ToJson()
	oRest:setStatusResponse(200, cJson)

	FwFreeObj(oResp)

Return

//----------------------------------------------------------------
/*/{Protheus.doc} QueryCodsCfop
Executa a consulta dos codigos de CFOP na tabela C0Y.
Utiliza FwExecStatement e ChangeQuery para portabilidade entre SGBDs.

@type      static function
@author    GitHub Copilot
@since     23/04/2026
@version   1.0
@return    oResp      Object     JsonObject com items e hasNext
/*/
//----------------------------------------------------------------
Static Function QueryCodsCfop() As Object

	Local oQry       As Object
	Local oResp      As Object
	Local oItem      As Object
	Local cSQL       As Character
	Local cAlias     As Character

	oResp    := JsonObject():New()
	oResp['items'] := {}
	oResp['hasNext'] := .F.

	cSQL := "SELECT C0Y.C0Y_CODIGO, C0Y.C0Y_DESCRI " + ;
		"FROM " + RetSqlName('C0Y') + " C0Y " + ;
		"WHERE C0Y.D_E_L_E_T_ = ? " + ;
		"AND C0Y.C0Y_FILIAL = ? " + ;
		"ORDER BY C0Y.C0Y_CODIGO "

	cSQL := ChangeQuery(cSQL)

	oQry := FwExecStatement():New(cSQL)
	oQry:SetString(1, Space(1))
	oQry:SetString(2, xFilial('C0Y'))

	cAlias := oQry:OpenAlias()

	While !(cAlias)->(EOF())
		oItem := JsonObject():New()
		oItem['codCfop']    := AllTrim((cAlias)->C0Y_CODIGO)
		oItem['descriCfop'] := AllTrim((cAlias)->C0Y_DESCRI)

		aAdd(oResp['items'], oItem)

		(cAlias)->(DBSkip())
	EndDo

	(cAlias)->(DBCloseArea())
	FwFreeObj(oQry)

Return oResp
