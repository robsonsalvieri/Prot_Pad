//---------------------------------------------------------------------
/*/{Protheus.doc} ProcessaIrrfRh
@type           Function
@description    Função de processamento de lote de IRRF vindo do RH.
                Realiza a orquestração da carga de dados:
                1. Prepara e valida variáveis de controle de lote e paginação;
                2. Normaliza o input JSON (Array ou Objeto) para estrutura de loop;
                3. Itera sobre os itens, sanitizando e convertendo para layout TAF;
                4. Controla buffer de memória, gravando parciais a cada 100 registros;
                5. Realiza a gravação final de resíduos e retorna status.
@author         Denis R. de Oliveira
@since          08/01/2026
@version        1.0

@param          oJsonData, Variant,   Payload recebido (Array de itens ou Objeto com propriedade 'items').
@param          cTicket,   Character, ID da Requisição (Ticket) para controle de estado/paginação.
@return         Logical,   .T. = Lote processado com sucesso (mesmo que vazio); .F. = Erro crítico de estrutura ou gravação.

@see            TAFItemToArrayDirf, ProcessaGrvDirf, SanitizaID
/*/
//---------------------------------------------------------------------
Function ProcessaIrrfRh( oJsonData as Variant, cTicket as Character ) as Logical

    //-------------------------------------------------------------------------
    // Declaração de Variáveis Locais
    //-------------------------------------------------------------------------
    Local lOk           as Logical      // Controle de sucesso da função
    Local lNovoBatch    as Logical      // Flag para indicar início de novo lote na gravação

    Local nQtdItens     as Numeric      // Total de itens no JSON recebido
    Local nX            as Numeric      // Contador de loop
    Local nTotalProc    as Numeric      // Totalizador de registros processados
    Local nBefore       as Numeric      // Controle de tamanho do array antes de processar item

    Local aItems        as Array        // Array normalizado contendo os objetos do JSON
    Local aDetailBatch  as Array        // Buffer de detalhes para gravação em lote
    Local aHeaderBatch  as Array        // Buffer de cabeçalhos para gravação em lote
    Local a1210Row      as Array        // Array de funcionários (a1210)
    Local aIncons       as Array        // Lista de inconsistências retornadas pela gravação

    Local cFil          as Character    // Filial corrente do processamento
    Local cUUID         as Character    // UUID gerado para o registro
    Local cVersao       as Character    // Versão do layout ou sistema
    Local cCpf          as Character    // CPF do trabalhador (extraído do JSON)
    Local cNome         as Character    // Nome do trabalhador (extraído do JSON)
    Local cPer          as Character    // Período de apuração (extraído do JSON)

    Local oItemFunc     as Variant      // Objeto temporário do item corrente no loop

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default cTicket := ""

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    lOk             := .T.
    lNovoBatch      := .T.

    nQtdItens       := 0
    nX              := 0
    nTotalProc      := 0
    nBefore         := 0

    aItems          := {}
    aDetailBatch    := {}
    aHeaderBatch    := {}
    a1210Row        := {}
    aIncons         := {}

    cFil            := xFilial( "T3P" )
    cUUID           := ""
    cVersao         := ""
    cCpf            := ""
    cNome           := ""
    cPer            := ""

    oItemFunc       := Nil

    // Verifica se o Ticket não está vazio
    If Empty( cTicket )
        TafConOut( "[ProcessaIrrfRh] [ERRO] cTicket nao informado. Abortando para evitar reuso indevido de estado." )
        Return .F.
    EndIf

    // Indica o inicio do processamnto da rotina
    TafConOut( "[ProcessaIrrfRh] >>> Inicio do lote. Ticket: " + cTicket )

    //-------------------------------------------------------------------------
    // Início do Bloco de Execução Segura
    //-------------------------------------------------------------------------
    // 1. Normalização do Input: Garante que aItems seja um Array processável
    If ValType( oJsonData ) == "A"
        aItems := oJsonData

    ElseIf ( ValType( oJsonData ) == "J" .Or. ValType( oJsonData ) == "O" )

        // Valida contrato do Objeto JSON
        If oJsonData:HasProperty( "items" ) .And. ValType( oJsonData["items"] ) == "A"
            aItems := oJsonData["items"]

            If Len( aItems ) == 0
                TafConOut( "[ProcessaIrrfRh] Pagina sem itens (items vazio). Ticket=" + cTicket )
                Return .T.
            EndIf

        Else
            TafConOut( "[ProcessaIrrfRh] Erro: JSON objeto sem 'items' (contrato inesperado)." )
            Return .F.
        EndIf

    Else
        TafConOut( "[ProcessaIrrfRh] Erro: Tipo de dado invalido recebido: " + ValType( oJsonData ) )
        Return .F.
    EndIf

    nQtdItens := Len( aItems )
    TafConOut( "[ProcessaIrrfRh] Itens no lote: " + cValToChar( nQtdItens ) )

    // Short-circuit: Se array vazio, retorna sucesso
    If nQtdItens == 0
        Return .T.
    EndIf

    // 2. Loop Principal de Processamento dos Itens
    For nX := 1 To nQtdItens

        oItemFunc := aItems[nX]

        // Extração de chaves principais para log e controle
        cPer  := SanitizaID( GetJsonPathDirf( oItemFunc, "period" ) )
        cCpf  := SanitizaID( GetJsonPathDirf( oItemFunc, "cpf" ) )
        cNome := SubStr( AllTrim( DecodeUTF8( GetJsonPathDirf( oItemFunc, "name" ) ) ), 1, 70 )

        nBefore := Len( aDetailBatch )

        // Geração de dados de controle internos
        cUUID   := FwUUIDv4()
        cVersao := xFunGetVer()

        // Conversão do JSON para Array TAF (De/Para)
        // A função TAFItemToArrayDirf popula aDetailBatch por referência
        If TAFItemToArrayDirf( oItemFunc, @aDetailBatch, cUUID, cVersao, cFil )

            // Só cria header se houve inserção no detalhe
            If Len( aDetailBatch ) > nBefore

                a1210Row := Array( 76 )
                a1210Row[ 1] := cFil
                a1210Row[ 2] := cUUID
                a1210Row[ 3] := cVersao
                a1210Row[ 4] := cCpf
                a1210Row[ 5] := cPer
                a1210Row[ 6] := cNome
                a1210Row[ 7] := "S-1210"
                a1210Row[76] := "2"
                AAdd( aHeaderBatch, a1210Row )

            EndIf

        Else
            TafConOut( "[ProcessaIrrfRh] Item ignorado/invalido: CPF=" + cCpf )
        EndIf

        // 3. Verificação de Buffer para Gravação Parcial (Batch Size = 100)
        If Len( aHeaderBatch ) >= 100

            // Efetiva a gravação do lote parcial
            ProcessaGrvDirf( aDetailBatch, aHeaderBatch, @aIncons, .T. )

            nTotalProc += Len( aHeaderBatch )

            // Limpa buffers para o próximo lote
            ASize( aDetailBatch, 0 )
            ASize( aHeaderBatch, 0 )
            aDetailBatch := {}
            aHeaderBatch := {}

        EndIf

    Next nX

    // 4. Gravação Final (Resíduos restantes no buffer)
    If lOk .And. Len( aHeaderBatch ) > 0

        If ProcessaGrvDirf( aDetailBatch, aHeaderBatch, @aIncons, lNovoBatch )

            nTotalProc += Len( aHeaderBatch )

        EndIf

    EndIf

    TafConOut( "[ProcessaIrrfRh] <<< FIM Lote. Processados: " + cValToChar( nTotalProc ) + " Status: " + cValToChar( lOk ) )

Return lOk

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFItemToArrayDirf
@type           Function
@description    Converte UM objeto JSON (Item da Lista de Funcionários) em linhas do array analítico.
                Realiza a extração de dados do objeto e orquestra a chamada dos processadores de aba.

@param          oJsonItem , Variant  , (Obrigatório) Objeto JSON contendo os dados de um único funcionário.
@param          aAnalitico, Array    , (Referência)  Buffer de gravação onde as linhas processadas serão adicionadas.
@param          cID       , Character, (Obrigatório) UUID gerado no loop principal para vincular este lote ao cabeçalho a1210.
@param          cVersao   , Character, Versão do layout/evento.
@param          cFil      , Character, Filial corrente (T3P) para gravação.

@return         Logical   , .T. = Item processado com sucesso; .F. = Item ignorado por falta de dados chave ou objeto nulo.

@author         Denis R. de Oliveira
@since          08/01/2026
@version        1.0

@see            ProcTributDirf, ProcDedDepDirf, ProcPenAliDirf, ProcPrevClDirf, ProcProcesDirf, 
                ProcPlaSauDirf, ProcDepSauDirf, ProcReemboDirf
/*/
//---------------------------------------------------------------------
Function TAFItemToArrayDirf( oJsonItem as Variant, aAnalitico as Array, cID as Character, cVersao as Character, cFil as Character ) as Logical
    
    //-------------------------------------------------------------------------
    // Declaração de Variáveis Locais
    //-------------------------------------------------------------------------
    Local cCodRec   as Character
    Local cCpf      as Character
    Local cCtxPai   as Character
    Local cNome     as Character
    Local cPeriodo  as Character

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default oJsonItem   := Nil
    Default aAnalitico  := {}
    Default cID         := ""
    Default cVersao     := ""
    Default cFil        := ""

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    cCodRec  := ""
    cCpf     := ""
    cCtxPai  := ""
    cNome    := ""
    cPeriodo := ""

    //-------------------------------------------------------------------------
    // 1. Validação de Contrato
    //-------------------------------------------------------------------------
    // Validação de Integridade Relacional
    // O ID é mandatório para vincular as tabelas filhas (Analítico) ao Pai (a1210)
    If Empty(cID)
        TafConOut("[TAFItemToArrayDirf] [ERRO] ID de vínculo (UUID) não informado. Processamento do item abortado.")
        Return .F.
    EndIf

    //-------------------------------------------------------------------------
    // 2. Extração de Dados (Performance: Acesso direto ao objeto em memória)
    //-------------------------------------------------------------------------
    // Utiliza GetJsonPathDirf para extração segura (trata nulos e formatação)
    cPeriodo := GetJsonPathDirf( oJsonItem, "period" )
    cPeriodo := SanitizaID( cPeriodo )
    cCpf     := GetJsonPathDirf( oJsonItem, "cpf" )
    cCpf     := SanitizaID( cCpf )
    cNome    := SubStr( AllTrim( DecodeUTF8( GetJsonPathDirf( oJsonItem, "name" ) ) ), 1, 70 )

    // Tenta buscar em infoComplem, se vazio, busca em infoComplemNoContract
    cCodRec := GetJsonPathDirf( oJsonItem, "infoComplem.revenueCode" )

    If Empty(cCodRec)
        cCodRec := GetJsonPathDirf( oJsonItem, "infoComplemNoContract.revenueCode" )
    EndIf

    If Empty(cCodRec) .And. ( ValType(oJsonItem) $ "JO" ) .And. oJsonItem:HasProperty("revenueCodes") ;
    .And. ValType(oJsonItem["revenueCodes"]) == "A" .And. Len(oJsonItem["revenueCodes"]) > 0
        cCodRec := cValToChar( oJsonItem["revenueCodes"][1] )
    EndIf

    cCodRec := SanitizaID( cCodRec )
    cCtxPai := TAFBuildCtxPai( oJsonItem, cPeriodo, cID )
    
    //-------------------------------------------------------------------------
    // 3. Validação de Regra de Negócio (Chaves Obrigatórias)
    //-------------------------------------------------------------------------
    // Período e CPF são chaves mínimas para qualquer registro fiscal
    If (Len(AllTrim(cPeriodo)) != 6 .Or. !(AllTrim(cPeriodo) == StrZero( Val(AllTrim(cPeriodo)), 6 )) .Or. Val(SubStr(AllTrim(cPeriodo),5,2)) < 1 .Or. Val(SubStr(AllTrim(cPeriodo),5,2)) > 12) .Or. ;
        (Len(AllTrim(cCpf)) != 11 .Or. !(AllTrim(cCpf) == StrZero( Val(AllTrim(cCpf)), 11 )))
        // Log de observabilidade para falha silenciosa
        TafConOut("[TAFItemToArrayDirf] [AVISO] Item ignorado por PERIODO/CPF inválido. Periodo: " + cPeriodo + " CPF: " + cCpf + " Nome: " + IIf(Empty(cNome),"",cNome))
        Return .F.
    EndIf
    
    //-------------------------------------------------------------------------
    // 4. Orquestração dos Processadores (Fluxo Lógico)
    //-------------------------------------------------------------------------   
    ProcTributDirf( oJsonItem, cPeriodo, cNome, cCpf, cCodRec, @aAnalitico, cID, cVersao, cFil ) // Aba 01 - Tributáveis
    ProcDedDepDirf( oJsonItem, cPeriodo, cNome, cCpf, cCodRec, @aAnalitico, cID, cVersao, cFil ) // Aba 02 - Deduções
    ProcPenAliDirf( oJsonItem, cPeriodo, cNome, cCpf, cCodRec, @aAnalitico, cID, cVersao, cFil ) // Aba 03 - Pensão
    ProcPrevClDirf( oJsonItem, cPeriodo, cNome, cCpf, cCodRec, @aAnalitico, cID, cVersao, cFil ) // Aba 04 - Previdência
    ProcProcesDirf( oJsonItem, cPeriodo, cNome, cCpf, cCodRec, @aAnalitico, cID, cVersao, cFil ) // Aba 05 - Processos
    ProcPlaSauDirf( oJsonItem, cPeriodo, cNome, cCpf, cCodRec, cCtxPai, @aAnalitico, cID, cVersao, cFil ) // Aba 06 - Saúde Titular
    ProcDepSauDirf( oJsonItem, cPeriodo, cNome, cCpf, cCodRec, cCtxPai, @aAnalitico, cID, cVersao, cFil ) // Aba 06 - Saúde Dep.
    ProcReemboDirf( oJsonItem, cPeriodo, cNome, cCpf, cCodRec, cCtxPai, @aAnalitico, cID, cVersao, cFil ) // Aba 06 - Reembolso

Return .T.

//---------------------------------------------------------------------
/*/{Protheus.doc} ProcTributDirf
@type           Function
@description    Processa a aba "TRIBUT" (01) - Valores Tributáveis Mensais.
                Extrai os dados do nó "monthlySummary" do JSON e popula as colunas
                correspondentes no array analítico (Espelho da T8R).

@param          oJson     , Json     , Objeto JSON raiz contendo os dados do payload.
@param          cPeriodo  , Character, Período de apuração (AAAAMM).
@param          cNome     , Character, Nome do trabalhador/beneficiário.
@param          cCpf      , Character, CPF do trabalhador/beneficiário.
@param          cCodRec   , Character, Código da Receita (DARF).
@param          aAnalitico, Array    , Array de retorno (Passado por Referência) que será populado.
@param          cID       , Character, UUID de vínculo com o registro pai (S-1210).
@param          cVersao   , Character, Versão do layout.
@param          cFil      , Character, Filial corrente.

@return         .T.

@author         Denis R. de Oliveira
@since          08/01/2026
@version        1.0
/*/
//---------------------------------------------------------------------
Function ProcTributDirf(oJson as Json, cPeriodo as Character, cNome as Character, cCpf as Character, cCodRec as Character, aAnalitico as Array, cID as Character, cVersao as Character, cFil as Character) as Logical
    
    //-------------------------------------------------------------------------
    // Declaração de Variáveis Locais
    //-------------------------------------------------------------------------
    Local nPos     as Numeric   // Posição (índice) da nova linha criada no array
    Local oSummary as Json      // Objeto JSON contendo o nó "monthlySummary"
    Local cRoot    as Character // Detecção Dinâmica da Raiz
    
    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default oJson      := Nil
    Default cPeriodo   := ""
    Default cNome      := ""
    Default cCpf       := ""
    Default cCodRec    := ""
    Default aAnalitico := {}
    Default cID        := ""
    Default cVersao    := ""
    Default cFil       := ""

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    nPos     := 0
    oSummary := Nil
    cRoot    := ""
    
    //-------------------------------------------------------------------------
    // Validação Estrutural do JSON
    //-------------------------------------------------------------------------
    // Detecção Dinâmica da Raiz
    If CheckPathDirf(oJson, "infoComplem", "monthlySummary")
        cRoot := "infoComplem"
    ElseIf CheckPathDirf(oJson, "infoComplemNoContract", "monthlySummary")
        cRoot := "infoComplemNoContract"
    Else
        // Se não existir em nenhum dos dois, aborta
        Return .F.
    EndIf
    
    // Extrai o nó de resumo mensal usando a raiz detectada
    oSummary := oJson[cRoot]["monthlySummary"]
    
    //-------------------------------------------------------------------------
    // Criação e Inicialização da Linha
    //-------------------------------------------------------------------------
    // Cria nova linha no array e recupera o índice
    nPos := CreateRowDirf(@aAnalitico)
    
    // Preenche as chaves primárias e identificadores (Filial, ID, CPF, Evento, etc.)
    // Aba: 01 (Tributáveis), Origem: 001
    FillBasicDirf(aAnalitico, nPos, cPeriodo, cNome, cCpf, cCodRec, "TRIBUT", "01", "001", cID, cVersao, cFil)
    
    //-------------------------------------------------------------------------
    // Mapeamento de Valores (JSON -> Array Analítico)
    //-------------------------------------------------------------------------
    // Utiliza GetNumValDirf para extração segura de valores numéricos (trata nulos e formatos string)
    
    // Rendimentos Tributáveis
    aAnalitico[nPos][ANALITICO_VLRRENDTRIB]      := GetNumValDirf(oSummary, "taxableIncome")
    aAnalitico[nPos][ANALITICO_VLRRENDTRIB13]    := GetNumValDirf(oSummary, "taxableIncome13")
    
    // Previdência Oficial
    aAnalitico[nPos][ANALITICO_VLRPREVOFICIAL]   := GetNumValDirf(oSummary, "officialPension")
    aAnalitico[nPos][ANALITICO_VLRPREVOFICIAL13] := GetNumValDirf(oSummary, "officialPension13")
    
    // Imposto Retido (IRRF)
    aAnalitico[nPos][ANALITICO_VLRCRMEN]         := GetNumValDirf(oSummary, "withheldIncomeTax")
    aAnalitico[nPos][ANALITICO_VLRCRMEN13]       := GetNumValDirf(oSummary, "withheldIncomeTax13")
    
    // Isenções (65 anos)
    aAnalitico[nPos][ANALITICO_VLRPARC65]        := GetNumValDirf(oSummary, "exemptPortionOver65")
    aAnalitico[nPos][ANALITICO_VLRPARC65DEC]     := GetNumValDirf(oSummary, "exemptPortionOver6513")
    
    // Verbas Indenizatórias e Outros
    aAnalitico[nPos][ANALITICO_VLRDIARIAS]       := GetNumValDirf(oSummary, "dailyAllowances")
    aAnalitico[nPos][ANALITICO_VLRAJDCUSTO]      := GetNumValDirf(oSummary, "costAid")
    aAnalitico[nPos][ANALITICO_VLRINDRESCTR]     := GetNumValDirf(oSummary, "terminationIndemnity")
    aAnalitico[nPos][ANALITICO_VLRABONOPEC]      := GetNumValDirf(oSummary, "vacationBonus")
    
    // Moléstia Grave
    aAnalitico[nPos][ANALITICO_VLRRENMOLGRV]     := GetNumValDirf(oSummary, "seriousIllness")
    aAnalitico[nPos][ANALITICO_VLRRENMOLGRV13]   := GetNumValDirf(oSummary, "seriousIllness13")
    
    // Auxílios e Bolsas
    aAnalitico[nPos][ANALITICO_VLRAUXMOR]        := GetNumValDirf(oSummary, "housingAllowance")
    aAnalitico[nPos][ANALITICO_VLRBOLMEDIC]      := GetNumValDirf(oSummary, "doctorScholarship")
    aAnalitico[nPos][ANALITICO_VLRBOLMEDIC13]    := GetNumValDirf(oSummary, "doctorScholarship13")
    
    // Outros Rendimentos Isentos/Não Tributáveis
    aAnalitico[nPos][ANALITICO_VLRJUROSMORA]     := GetNumValDirf(oSummary, "interestOnLatePayment")
    aAnalitico[nPos][ANALITICO_VLRINSEOUTROS]    := GetNumValDirf(oSummary, "taxExempt")
    
Return .T.

//---------------------------------------------------------------------
/*/{Protheus.doc} ProcDedDepDirf
@type           Function
@description    Processa a aba "DEDDEP" (02) - Deduções de Dependentes.
                Extrai o array "dependentDeductions" do JSON e itera sobre os itens,
                populando o array analítico (Espelho da T8R).

@param          oJson     , Json     , Objeto JSON raiz contendo os dados do payload.
@param          cPeriodo  , Character, Período de apuração (AAAAMM).
@param          cNome     , Character, Nome do trabalhador/beneficiário.
@param          cCpf      , Character, CPF do trabalhador/beneficiário.
@param          cCodRec   , Character, Código da Receita (DARF).
@param          aAnalitico, Array    , Array de retorno (Passado por Referência) que será populado.
@param          cID       , Character, UUID de vínculo com o registro pai (S-1210).
@param          cVersao   , Character, Versão do layout.
@param          cFil      , Character, Filial corrente.

@return         .T.

@author         Denis R. de Oliveira
@since          08/01/2026
@version        1.0
/*/
//---------------------------------------------------------------------
Function ProcDedDepDirf(oJson as Json, cPeriodo as Character, cNome as Character, cCpf as Character, cCodRec as Character, aAnalitico as Array, cID as Character, cVersao as Character, cFil as Character) as Logical
    
    //-------------------------------------------------------------------------
    // Declaração de Variáveis Locais
    //-------------------------------------------------------------------------
    Local aItems   as Array   // Array temporário para armazenar os itens extraídos do JSON
    Local nX       as Numeric // Contador para o loop de processamento
    Local nPos     as Numeric // Posição (índice) da nova linha criada no array analítico
    Local oItem    as Json    // Objeto JSON representando um item individual da lista
    
    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default oJson      := Nil
    Default cPeriodo   := ""
    Default cNome      := ""
    Default cCpf       := ""
    Default cCodRec    := ""
    Default aAnalitico := {}
    Default cID        := ""
    Default cVersao    := ""
    Default cFil       := ""

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    aItems := {}
    nX     := 0
    nPos   := 0
    oItem  := Nil

    //-------------------------------------------------------------------------
    // Extração e Validação dos Dados
    //-------------------------------------------------------------------------
    // Tenta extrair o array de deduções do caminho "infoComplem.dependentDeductions".
    // Se não encontrar ou não for um array válido, interrompe o processamento desta aba.
    If !GetArrayDirf(oJson, "infoComplem", "dependentDeductions", @aItems)
        If !GetArrayDirf(oJson, "infoComplemNoContract", "dependentDeductions", @aItems)
            Return .F.
        EndIf
    EndIf
    
    //-------------------------------------------------------------------------
    // Loop de Processamento dos Itens
    //-------------------------------------------------------------------------
    For nX := 1 To Len(aItems)
        
        oItem := aItems[nX]
        
        //---------------------------------------------------------------------
        // Criação e Inicialização da Linha
        //---------------------------------------------------------------------
        // Cria nova linha no array analítico e recupera o índice
        nPos := CreateRowDirf(@aAnalitico)
        
        // Preenche chaves primárias e identificadores
        // Aba: 02 (Deduções Dependentes), Sequência: Baseada no loop (nX)
        FillBasicDirf(aAnalitico, nPos, cPeriodo, cNome, cCpf, cCodRec, "DEDDEP", "02", StrZero(nX, 3), cID, cVersao, cFil)
        
        //---------------------------------------------------------------------
        // Mapeamento de Valores (JSON -> Array Analítico)
        //---------------------------------------------------------------------
        aAnalitico[nPos][ANALITICO_TPREND] := SubStr( AllTrim( DecodeUTF8( GetJsonPathDirf( oItem, "incomeType" ) ) ), 1, 50)
        aAnalitico[nPos][ANALITICO_CPFDEP] := SanitizaID( GetJsonPathDirf(oItem, "cpf") )
        aAnalitico[nPos][ANALITICO_VLRDED] := GetNumValDirf(oItem, "values")
    
    Next nX
    
Return .T.

//---------------------------------------------------------------------
/*/{Protheus.doc} ProcPenAliDirf
@type           Function
@description    Processa a aba "PENALI" (03) - Pensão Alimentícia.
                Extrai o array "alimony" do JSON e itera sobre os itens,
                populando o array analítico (Espelho da T8R).

@param          oJson     , Json     , Objeto JSON raiz contendo os dados do payload.
@param          cPeriodo  , Character, Período de apuração (AAAAMM).
@param          cNome     , Character, Nome do trabalhador/beneficiário.
@param          cCpf      , Character, CPF do trabalhador/beneficiário.
@param          cCodRec   , Character, Código da Receita (DARF).
@param          aAnalitico, Array    , Array de retorno (Passado por Referência) que será populado.
@param          cID       , Character, UUID de vínculo com o registro pai (S-1210).
@param          cVersao   , Character, Versão do layout.
@param          cFil      , Character, Filial corrente.

@return         .T.

@author         Denis R. de Oliveira
@since          08/01/2026
@version        1.0
/*/
//---------------------------------------------------------------------
Function ProcPenAliDirf(oJson as Json, cPeriodo as Character, cNome as Character, cCpf as Character, cCodRec as Character, aAnalitico as Array, cID as Character, cVersao as Character, cFil as Character) as Logical
    
    //-------------------------------------------------------------------------
    // Declaração de Variáveis Locais
    //-------------------------------------------------------------------------
    Local aItems   as Array   // Array temporário para armazenar os itens extraídos do JSON
    Local nX       as Numeric // Contador para o loop de processamento
    Local nPos     as Numeric // Posição (índice) da nova linha criada no array analítico
    Local oItem    as Json    // Objeto JSON representando um item individual da lista
    
    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default oJson      := Nil
    Default cPeriodo   := ""
    Default cNome      := ""
    Default cCpf       := ""
    Default cCodRec    := ""
    Default aAnalitico := {}
    Default cID        := ""
    Default cVersao    := ""
    Default cFil       := ""

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    aItems := {}
    nX     := 0
    nPos   := 0
    oItem  := Nil

    //-------------------------------------------------------------------------
    // Extração e Validação dos Dados
    //-------------------------------------------------------------------------
    // Tenta extrair o array de pensão alimentícia do caminho "infoComplem.alimony".
    // Se não encontrar ou não for um array válido, interrompe o processamento desta aba.
    If !GetArrayDirf(oJson, "infoComplem", "alimony", @aItems)
        If !GetArrayDirf(oJson, "infoComplemNoContract", "alimony", @aItems)
            Return .F.
        EndIf
    EndIf
    
    //-------------------------------------------------------------------------
    // Loop de Processamento dos Itens
    //-------------------------------------------------------------------------
    For nX := 1 To Len(aItems)
        
        oItem := aItems[nX]
        
        //---------------------------------------------------------------------
        // Criação e Inicialização da Linha
        //---------------------------------------------------------------------
        // Cria nova linha no array analítico e recupera o índice
        nPos := CreateRowDirf(@aAnalitico)
        
        // Preenche chaves primárias e identificadores
        // Aba: 03 (Pensão Alimentícia), Sequência: Baseada no loop (nX)
        FillBasicDirf(aAnalitico, nPos, cPeriodo, cNome, cCpf, cCodRec, "PENALI", "03", StrZero(nX, 3), cID, cVersao, cFil)
        
        //---------------------------------------------------------------------
        // Mapeamento de Valores (JSON -> Array Analítico)
        //---------------------------------------------------------------------
        aAnalitico[nPos][ANALITICO_TPRENDALIM] := SubStr( AllTrim( DecodeUTF8( GetJsonPathDirf( oItem, "incomeType" ) ) ), 1, 110 )
        aAnalitico[nPos][ANALITICO_CPFDEPALIM] := SanitizaID( GetJsonPathDirf(oItem, "cpf") )
        aAnalitico[nPos][ANALITICO_VLRDEDALIM] := GetNumValDirf(oItem, "values")
        
    Next nX
    
Return .T.

//---------------------------------------------------------------------
/*/{Protheus.doc} ProcPrevClDirf
@type           Function
@description    Processa a aba "PREVCL" (04) - Previdência Complementar.
                Extrai o array "privatePension" do JSON e itera sobre os itens,
                populando o array analítico (Espelho da T8R).

@param          oJson     , Json     , Objeto JSON raiz contendo os dados do payload.
@param          cPeriodo  , Character, Período de apuração (AAAAMM).
@param          cNome     , Character, Nome do trabalhador/beneficiário.
@param          cCpf      , Character, CPF do trabalhador/beneficiário.
@param          cCodRec   , Character, Código da Receita (DARF).
@param          aAnalitico, Array    , Array de retorno (Passado por Referência) que será populado.
@param          cID       , Character, UUID de vínculo com o registro pai (S-1210).
@param          cVersao   , Character, Versão do layout.
@param          cFil      , Character, Filial corrente.

@return         .T.

@author         Denis R. de Oliveira 
@since          08/01/2026
@version        1.0
/*/
//---------------------------------------------------------------------
Function ProcPrevClDirf(oJson as Json, cPeriodo as Character, cNome as Character, cCpf as Character, cCodRec as Character, aAnalitico as Array, cID as Character, cVersao as Character, cFil as Character) as Logical
    
    //-------------------------------------------------------------------------
    // Declaração de Variáveis Locais
    //-------------------------------------------------------------------------
    Local aItems   as Array   // Array temporário para armazenar os itens extraídos do JSON
    Local nX       as Numeric // Contador para o loop de processamento
    Local nPos     as Numeric // Posição (índice) da nova linha criada no array analítico
    Local oItem    as Json    // Objeto JSON representando um item individual da lista
    
    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default oJson      := Nil
    Default cPeriodo   := ""
    Default cNome      := ""
    Default cCpf       := ""
    Default cCodRec    := ""
    Default aAnalitico := {}
    Default cID        := ""
    Default cVersao    := ""
    Default cFil       := ""

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    aItems := {}
    nX     := 0
    nPos   := 0
    oItem  := Nil

    //-------------------------------------------------------------------------
    // Extração e Validação dos Dados
    //-------------------------------------------------------------------------
    // Tenta extrair o array de previdência privada do caminho "infoComplem.privatePension".
    // Se não encontrar ou não for um array válido, interrompe o processamento desta aba.
    If !GetArrayDirf(oJson, "infoComplem", "privatePension", @aItems)
        If !GetArrayDirf(oJson, "infoComplemNoContract", "privatePension", @aItems)
            Return .F.
        EndIf
    EndIf
    
    //-------------------------------------------------------------------------
    // Loop de Processamento dos Itens
    //-------------------------------------------------------------------------
    For nX := 1 To Len(aItems)
        
        oItem := aItems[nX]
        
        //---------------------------------------------------------------------
        // Criação e Inicialização da Linha
        //---------------------------------------------------------------------
        // Cria nova linha no array analítico e recupera o índice
        nPos := CreateRowDirf(@aAnalitico)
        
        // Preenche chaves primárias e identificadores
        // Aba: 04 (Previdência Complementar), Sequência: Baseada no loop (nX)
        FillBasicDirf(aAnalitico, nPos, cPeriodo, cNome, cCpf, cCodRec, "PREVCL", "04", StrZero(nX, 3), cID, cVersao, cFil)
        
        //---------------------------------------------------------------------
        // Mapeamento de Valores (JSON -> Array Analítico)
        //---------------------------------------------------------------------
        aAnalitico[nPos][ANALITICO_TPPREV]          := SubStr( AllTrim( DecodeUTF8( GetJsonPathDirf(oItem, "pensionType") ) ), 1, 60 )
        aAnalitico[nPos][ANALITICO_CNPJPREV]        := SanitizaID( GetJsonPathDirf(oItem, "cnpj") )
        aAnalitico[nPos][ANALITICO_VLRDEDPCPREV]    := GetNumValDirf(oItem, "values")
        aAnalitico[nPos][ANALITICO_VLRDEDPCPREV13]  := GetNumValDirf(oItem, "values13")
        aAnalitico[nPos][ANALITICO_VLRDEDFUNP]      := GetNumValDirf(oItem, "publicServantValue")
        aAnalitico[nPos][ANALITICO_VLRDEDFUNP13]    := GetNumValDirf(oItem, "publicServantValue13")
        
    Next nX
    
Return .T.

//---------------------------------------------------------------------
/*/{Protheus.doc} ProcProcesDirf
@type           Function
@description    Processa a estrutura hierárquica de Processos Judiciais (Aba 05).
                Navega pelos 4 níveis de dados:
                1. PROCRE: Cabeçalho do Processo
                2. PRCVAL: Valores Monetários e Indicadores
                3. PRCDED: Deduções Suspensas
                4. PRCBEN: Beneficiários de Pensão

@param          oJson     , Json     , Objeto JSON raiz contendo os dados do payload.
@param          cPeriodo  , Character, Período de apuração (AAAAMM).
@param          cNome     , Character, Nome do trabalhador/beneficiário.
@param          cCpf      , Character, CPF do trabalhador/beneficiário.
@param          cCodRec   , Character, Código da Receita (DARF).
@param          aAnalitico, Array    , Array de retorno (Passado por Referência) que será populado.
@param          cID       , Character, UUID de vínculo com o registro pai (S-1210).
@param          cVersao   , Character, Versão do layout.
@param          cFil      , Character, Filial corrente.

@return         .T.

@author         Denis R. de Oliveira
@since          08/01/2026
@version        1.0
/*/
//---------------------------------------------------------------------
Function ProcProcesDirf(oJson as Json, cPeriodo as Character, cNome as Character, cCpf as Character, cCodRec as Character, aAnalitico as Array, cID as Character, cVersao as Character, cFil as Character) as Logical
    
    //-------------------------------------------------------------------------
    // Declaração de Variáveis Locais
    //-------------------------------------------------------------------------
    Local aProc    as Array     // Nível 1: Lista de Processos
    Local aVal     as Array     // Nível 2: Lista de Valores
    Local aDed     as Array     // Nível 3: Lista de Deduções
    Local aBen     as Array     // Nível 4: Lista de Beneficiários

    Local nX       as Numeric   // Contador Nível 1
    Local nY       as Numeric   // Contador Nível 2
    Local nZ       as Numeric   // Contador Nível 3
    Local nW       as Numeric   // Contador Nível 4
    Local nSeqVal  as Numeric   // Contador Acumulativo
    Local nSeqDed  as Numeric   // Contador Acumulativo
    Local nSeqBen  as Numeric   // Contador Acumulativo

    Local nPos     as Numeric   // Índice do array analítico
    Local cNrProc  as Character // Sanitiza o número de processo
    Local cCodSusp as Character // Sanitiza o código de suspensão
    Local cTpProc  as Character // Sanitiza o tipo de processo
    Local cProcKey as Character // Chave canônica do cabeçalho do processo
    Local cValKey  as Character // Chave canônica dos valores do processo
    Local cDedKey  as Character // Chave canônica das deduções do processo
    Local cBenKey  as Character // Chave canônica dos beneficiários do processo
    Local cIndApu  as Character // Indicativo do período de apuração
    Local cIndDed  as Character // Indicativo da dedução
    Local cCnpjDed as Character // CNPJ do beneficiário da dedução
    Local cCpfBen  as Character // CPF do beneficiário da pensão

    Local oProc    as Json      // Objeto Processo
    Local oVal     as Json      // Objeto Valor
    Local oDed     as Json      // Objeto Dedução
    Local oBen     as Json      // Objeto Beneficiário
    
    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default oJson      := Nil
    Default cPeriodo   := ""
    Default cNome      := ""
    Default cCpf       := ""
    Default cCodRec    := ""
    Default aAnalitico := {}
    Default cID        := ""
    Default cVersao    := ""
    Default cFil       := ""

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    aProc   := {}
    aVal    := {}
    aDed    := {}
    aBen    := {}

    nX      := 0
    nY      := 0
    nZ      := 0
    nW      := 0
    nSeqVal := 0
    nSeqDed := 0
    nSeqBen := 0

    nPos    := 0
    cNrProc := ""
    cCodSusp:= ""
    cTpProc := ""
    cProcKey:= ""
    cValKey := ""
    cDedKey := ""
    cBenKey := ""
    cIndApu := ""
    cIndDed := ""
    cCnpjDed:= ""
    cCpfBen := ""

    oProc   := Nil
    oVal    := Nil 
    oDed    := Nil
    oBen    := Nil

    //-------------------------------------------------------------------------
    // Nível 1: Extração de Processos (legalProcessInfo)
    //-------------------------------------------------------------------------
    If !GetArrayDirf(oJson, "infoComplem", "legalProcessInfo", @aProc)
        If !GetArrayDirf(oJson, "infoComplemNoContract", "legalProcessInfo", @aProc)
            Return .F.
        EndIf
    EndIf
    
    For nX := 1 To Len(aProc)
        
        oProc   := aProc[nX]
        aVal    := {}

        // Extração e Sanitização realizada apenas uma vez
        cNrProc  := SanitizaID( GetJsonPathDirf(oProc, "processNumber") )
        cCodSusp := SanitizaID( GetJsonPathDirf(oProc, "suspensionCode") )
        cTpProc  := SubStr( AllTrim( SanitizaID( DecodeUTF8( GetJsonPathDirf(oProc, "processType") ) ) ), 1, 30 )
        cTpProc  := TAFRhTpProcCanon( cTpProc )
        cProcKey := AllTrim( cTpProc ) + "|" + AllTrim( cNrProc ) + "|" + AllTrim( cCodSusp )
        
        // --- Registro PROCRE (Cabeçalho do Processo) ---
        nPos := CreateRowDirf(@aAnalitico)
        FillBasicDirf(aAnalitico, nPos, cPeriodo, cNome, cCpf, cCodRec, "PROCRE", "05", StrZero(nX, 3), cID, cVersao, cFil)
        aAnalitico[nPos][ANALITICO_RELACAO] := cProcKey
        
        aAnalitico[nPos][ANALITICO_TPPROC]  := cTpProc
        aAnalitico[nPos][ANALITICO_NRPROC]  := cNrProc
        aAnalitico[nPos][ANALITICO_CODSUP]  := cCodSusp
        
        //---------------------------------------------------------------------
        // Nível 2: Valores do Processo (infoValores)
        //---------------------------------------------------------------------
        If GetArrayDirf(oProc, "", "infoValores", @aVal)
            
            For nY := 1 To Len(aVal)
                
                oVal := aVal[nY]

                // Incremento do controle
                nSeqVal++
                
                // --- Registro PRCVAL (Valores Monetários) ---
                nPos := CreateRowDirf(@aAnalitico)
                FillBasicDirf(aAnalitico, nPos, cPeriodo, cNome, cCpf, cCodRec, "PRCVAL", "5A", StrZero(nSeqVal, 3), cID, cVersao, cFil)
                cIndApu := SubStr( AllTrim( DecodeUTF8( GetJsonPathDirf(oVal, "taxPeriodIndicator") ) ), 1, 30 )
                cIndApu := TAFRhIndApuCanon( cIndApu )
                cValKey := cProcKey + "|" + StrTran( AllTrim( cIndApu ), "|", "" )

                aAnalitico[nPos][ANALITICO_RELACAO]   := cValKey
                aAnalitico[nPos][ANALITICO_TPPROC]    := cTpProc
                aAnalitico[nPos][ANALITICO_NRPROC]    := cNrProc
                aAnalitico[nPos][ANALITICO_CODSUP]    := cCodSusp
                aAnalitico[nPos][ANALITICO_PRCINDAPU] := cIndApu
                aAnalitico[nPos][ANALITICO_PRCVLRRET] := GetNumValDirf(oVal, "withholdingValue")
                aAnalitico[nPos][ANALITICO_PRCVLRJUD] := GetNumValDirf(oVal, "judicialDepositValue")
                aAnalitico[nPos][ANALITICO_PRCVLACAL] := GetNumValDirf(oVal, "calendarYearCompensationValue")
                aAnalitico[nPos][ANALITICO_PRCVLAANT] := GetNumValDirf(oVal, "previousYearsCompensationValue")
                aAnalitico[nPos][ANALITICO_PRCVLSUSP] := GetNumValDirf(oVal, "suspendedIncomeValue")
                
                //-------------------------------------------------------------
                // Nível 3: Deduções Suspensas (infoDedSusp)
                //-------------------------------------------------------------
                aDed := {}

                If GetArrayDirf(oVal, "", "infoDedSusp", @aDed)
                    
                    For nZ := 1 To Len(aDed)
                        
                        oDed := aDed[nZ]

                        // Incremento do controle
                        nSeqDed++
                        
                        // --- Registro PRCDED (Deduções) ---
                        nPos := CreateRowDirf(@aAnalitico)
                        FillBasicDirf(aAnalitico, nPos, cPeriodo, cNome, cCpf, cCodRec, "PRCDED", "5B", StrZero(nSeqDed, 3), cID, cVersao, cFil)
                        cIndDed  := SubStr( AllTrim( DecodeUTF8( GetJsonPathDirf(oDed, "deductionIndicative") ) ), 1, 80 )
                        cIndDed  := TAFRhTpDedCanon( cIndDed )
                        cCnpjDed := SanitizaID( GetJsonPathDirf(oDed, "cnpj") )
                        cDedKey  := cValKey + "|" + StrTran( AllTrim( cIndDed ), "|", "" ) + "|" + AllTrim( cCnpjDed )

                        aAnalitico[nPos][ANALITICO_RELACAO]      := cDedKey
                        aAnalitico[nPos][ANALITICO_TPPROC]       := cTpProc
                        aAnalitico[nPos][ANALITICO_NRPROC]       := cNrProc
                        aAnalitico[nPos][ANALITICO_CODSUP]       := cCodSusp
                        aAnalitico[nPos][ANALITICO_PRCINDAPU]    := cIndApu
                        aAnalitico[nPos][ANALITICO_PRCDEDTPDEDU] := cIndDed
                        aAnalitico[nPos][ANALITICO_PRCDEDINSCPL] := cCnpjDed
                        aAnalitico[nPos][ANALITICO_PRCDEDVLSUSP] := GetNumValDirf(oDed, "deductionValue")
                        aAnalitico[nPos][ANALITICO_PRCDEDVLFUNP] := GetNumValDirf(oDed, "contribFunpresp")
                        
                        //-----------------------------------------------------
                        // Nível 4: Beneficiários Pensão (infoBenefPen)
                        //-----------------------------------------------------
                        aBen := {}

                        If GetArrayDirf(oDed, "", "infoBenefPen", @aBen)
                            
                            For nW := 1 To Len(aBen)
                                
                                oBen := aBen[nW]

                                // Incremento do controle
                                nSeqBen++
                                
                                // --- Registro PRCBEN (Beneficiários) ---
                                nPos := CreateRowDirf(@aAnalitico)
                                FillBasicDirf(aAnalitico, nPos, cPeriodo, cNome, cCpf, cCodRec, "PRCBEN", "5C", StrZero(nSeqBen, 3), cID, cVersao, cFil)
                                cCpfBen := SanitizaID( GetJsonPathDirf(oBen, "cpf") )
                                cBenKey := cDedKey + "|" + AllTrim( cCpfBen )

                                aAnalitico[nPos][ANALITICO_RELACAO]      := cBenKey
                                aAnalitico[nPos][ANALITICO_TPPROC]       := cTpProc
                                aAnalitico[nPos][ANALITICO_NRPROC]       := cNrProc
                                aAnalitico[nPos][ANALITICO_CODSUP]       := cCodSusp
                                aAnalitico[nPos][ANALITICO_PRCINDAPU]    := cIndApu
                                aAnalitico[nPos][ANALITICO_PRCDEDTPDEDU] := cIndDed
                                aAnalitico[nPos][ANALITICO_PRCDEDINSCPL] := cCnpjDed
                                aAnalitico[nPos][ANALITICO_PRCBENCPFDEP] := cCpfBen
                                aAnalitico[nPos][ANALITICO_PRCBENVLSUSP] := GetNumValDirf(oBen, "vlrDepenSusp")
                                
                            Next nW
                            
                        EndIf
                        
                    Next nZ
                    
                EndIf
                
            Next nY
            
        EndIf
        
    Next nX
    
Return .T.

//---------------------------------------------------------------------
/*/{Protheus.doc} ProcPlaSauDirf
@type           Function
@description    Processa a aba "PLASAU" (06) - Titulares de Plano de Saúde.
                Extrai o array "holders" (Titulares) do caminho "infoComplemNoContract.healthPlan"
                e popula o array analítico (Espelho da T8R).

@param          oJson     , Json     , Objeto JSON raiz contendo os dados do payload.
@param          cPeriodo  , Character, Período de apuração (AAAAMM).
@param          cNome     , Character, Nome do trabalhador/beneficiário.
@param          cCpf      , Character, CPF do trabalhador/beneficiário.
@param          cCodRec   , Character, Código da Receita (DARF).
@param          cCtxPai   , Character, Contexto canônico do pai lógico (infoIRComplem).
@param          aAnalitico, Array    , Array de retorno (Passado por Referência) que será populado.
@param          cID       , Character, UUID de vínculo com o registro pai (S-1210).
@param          cVersao   , Character, Versão do layout.
@param          cFil      , Character, Filial corrente.

@return         .T.

@author         Denis R. de Oliveira
@since          08/01/2026
@version        1.0
/*/
//---------------------------------------------------------------------
Function ProcPlaSauDirf(oJson as Json, cPeriodo as Character, cNome as Character, cCpf as Character, cCodRec as Character, cCtxPai as Character, aAnalitico as Array, cID as Character, cVersao as Character, cFil as Character) as Logical
    
    //-------------------------------------------------------------------------
    // Declaração de Variáveis Locais
    //-------------------------------------------------------------------------
    Local aItems        as Array        // Array temporário para armazenar os titulares extraídos do JSON
    Local nX            as Numeric      // Contador para o loop de processamento
    Local nPos          as Numeric      // Posição (índice) da nova linha criada no array analítico
    Local oItem         as Json         // Objeto JSON representando um item (titular) da lista
    Local oHealthPlan   as Json         // Objeto JSON para extração dos dados
    Local cCnpjOp       as Character    // String usada para sanitização
    Local cRegAns       as Character
    
    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default oJson      := Nil
    Default cPeriodo   := ""
    Default cNome      := ""
    Default cCpf       := ""
    Default cCodRec    := ""
    Default cCtxPai    := ""
    Default aAnalitico := {}
    Default cID        := ""
    Default cVersao    := ""
    Default cFil       := ""

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    aItems      := {}
    nX          := 0
    nPos        := 0
    oItem       := Nil
    oHealthPlan := Nil
    cCnpjOp     := ""
    cRegAns     := ""

    //-------------------------------------------------------------------------
    // Validação Estrutural e Extração de Dados
    //-------------------------------------------------------------------------
    // 1. Tenta localizar o nó healthPlan na raiz de Vínculo (CLT)
    If CheckPathDirf(oJson, "infoComplem", "healthPlan")
        oHealthPlan := oJson["infoComplem"]["healthPlan"]
        
    // 2. Se não achou, tenta na raiz Sem Vínculo (Autônomo/TSVE)
    ElseIf CheckPathDirf(oJson, "infoComplemNoContract", "healthPlan")
        oHealthPlan := oJson["infoComplemNoContract"]["healthPlan"]
    
    // 3. Se não existe em nenhum lugar, encerra
    Else
        Return .F.
    EndIf
    
    // Tenta extrair o array de titulares ("holders") do objeto localizado
    If !GetArrayDirf(oHealthPlan, "", "holders", @aItems)
        Return .F.
    EndIf
    
    //-------------------------------------------------------------------------
    // Loop de Processamento dos Itens
    //-------------------------------------------------------------------------
    For nX := 1 To Len(aItems)
        
        oItem := aItems[nX]
        
        //---------------------------------------------------------------------
        // Criação e Inicialização da Linha
        //---------------------------------------------------------------------
        // Cria nova linha no array analítico e recupera o índice
        nPos := CreateRowDirf(@aAnalitico)
        
        // Preenche chaves primárias e identificadores
        // Aba: 06 (Plano de Saúde - Titular), Sequência: Baseada no loop (nX)
        FillBasicDirf(aAnalitico, nPos, cPeriodo, cNome, cCpf, cCodRec, "PLASAU", "06", StrZero(nX, 3), cID, cVersao, cFil)
        
        cCnpjOp := SanitizaID( GetJsonPathDirf(oItem, "cnpj") )
        
        //---------------------------------------------------------------------
        // Mapeamento de Valores (JSON -> Array Analítico)
        //---------------------------------------------------------------------
        cRegAns := SanitizaID( GetJsonPathDirf( oItem, "ansCode" ) )

        aAnalitico[nPos][ANALITICO_PLSAUDECNPJ]   := cCnpjOp
        aAnalitico[nPos][ANALITICO_PLSAUDEREGANS] := cRegAns
        aAnalitico[nPos][ANALITICO_PLSAUDEVLRTIT] := GetNumValDirf( oItem, "values" )
        aAnalitico[nPos][ANALITICO_RELACAO]       := TAFRelHealthHolder( cCtxPai, cCnpjOp, cRegAns )

        
    Next nX
    
Return .T.

//---------------------------------------------------------------------
/*/{Protheus.doc} ProcDepSauDirf
@type           Function
@description    Processa a aba "DEPSAU" (06) - Dependentes de Plano de Saúde.
                Itera sobre a lista de titulares ("holders") e, para cada um,
                processa a lista de dependentes ("dependents"), populando o array analítico.

@param          oJson     , Json     , Objeto JSON raiz contendo os dados do payload.
@param          cPeriodo  , Character, Período de apuração (AAAAMM).
@param          cNome     , Character, Nome do trabalhador/beneficiário.
@param          cCpf      , Character, CPF do trabalhador/beneficiário.
@param          cCodRec   , Character, Código da Receita (DARF).
@param          cCtxPai   , Character, Contexto canônico do pai lógico (infoIRComplem).
@param          aAnalitico, Array    , Array de retorno (Passado por Referência) que será populado.
@param          cID       , Character, UUID de vínculo com o registro pai (S-1210).
@param          cVersao   , Character, Versão do layout.
@param          cFil      , Character, Filial corrente.

@return         .T.

@author         Denis R. de Oliveira
@since          08/01/2026
@version        1.0
/*/
//---------------------------------------------------------------------
Function ProcDepSauDirf(oJson as Json, cPeriodo as Character, cNome as Character, cCpf as Character, cCodRec as Character, cCtxPai as Character, aAnalitico as Array, cID as Character, cVersao as Character, cFil as Character) as Logical
    
    //-------------------------------------------------------------------------
    // Declaração de Variáveis Locais
    //-------------------------------------------------------------------------
    Local aHolders      as Array        // Lista de titulares extraída do JSON
    Local aDeps         as Array        // Lista de dependentes extraída de cada titular
    Local nX            as Numeric      // Contador para o loop de titulares
    Local nY            as Numeric      // Contador para o loop de dependentes
    Local nSeqDep       as Numeric      // Contador Acumulativo
    Local nPos          as Numeric      // Posição (índice) da nova linha criada no array analítico
    Local cCpfDep       as Character    // String para sanatização
    Local cCnpjTit      as Character    // String para sanatização
    Local cRegAns       as Character    // String para chave
    Local oHolder       as Json         // Objeto JSON representando um titular
    Local oDep          as Json         // Objeto JSON representando um dependente
    Local oHealthPlan   as Json         // Objeto JSON para extração dos dados
    
    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default oJson      := Nil
    Default cPeriodo   := ""
    Default cNome      := ""
    Default cCpf       := ""
    Default cCodRec    := ""
    Default cCtxPai    := ""

    Default aAnalitico := {}
    Default cID        := ""
    Default cVersao    := ""
    Default cFil       := ""

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    aHolders    := {}
    aDeps       := {}
    nX          := 0
    nY          := 0
    nSeqDep     := 0
    nPos        := 0
    cCpfDep     := ""
    cCnpjTit    := ""
    cRegAns     := ""
    oHolder     := Nil
    oDep        := Nil
    oHealthPlan := Nil

    //-------------------------------------------------------------------------
    // Validação Estrutural e Extração de Dados
    //-------------------------------------------------------------------------
    // 1. Tenta localizar o nó healthPlan na raiz de Vínculo (CLT)
    If CheckPathDirf(oJson, "infoComplem", "healthPlan")
        oHealthPlan := oJson["infoComplem"]["healthPlan"]
        
    // 2. Se não achou, tenta na raiz Sem Vínculo (Autônomo/TSVE)
    ElseIf CheckPathDirf(oJson, "infoComplemNoContract", "healthPlan")
        oHealthPlan := oJson["infoComplemNoContract"]["healthPlan"]
        
    // 3. Se não existe em nenhum lugar, encerra
    Else
        Return .F.
    EndIf
    
    // Tenta extrair a lista de titulares ("holders") do objeto localizado.
    If !GetArrayDirf(oHealthPlan, "", "holders", @aHolders)
        Return .F.
    EndIf
    
    //-------------------------------------------------------------------------
    // Loop de Processamento (Titulares -> Dependentes)
    //-------------------------------------------------------------------------
    For nX := 1 To Len(aHolders)
        
        oHolder := aHolders[nX]
        aDeps   := {}
        
        // Tenta extrair a lista de dependentes do titular atual.
        // Se não houver dependentes, passa para o próximo titular.
        If GetArrayDirf(oHolder, "", "dependents", @aDeps)
            
            For nY := 1 To Len(aDeps)
                
                oDep    := aDeps[nY]

                // Incremento do controle
                nSeqDep++
                
                //-------------------------------------------------------------
                // Criação e Inicialização da Linha
                //-------------------------------------------------------------
                // Cria nova linha no array analítico e recupera o índice
                nPos := CreateRowDirf(@aAnalitico)
                
                // Preenche chaves primárias e identificadores
                // Aba: 06 (Plano de Saúde - Dependente), Sequência: Baseada no loop de dependentes (nY)
                FillBasicDirf(aAnalitico, nPos, cPeriodo, cNome, cCpf, cCodRec, "DEPSAU", "6A", StrZero(nSeqDep, 3), cID, cVersao, cFil)

                cCpfDep  := SanitizaID( GetJsonPathDirf(oDep, "cpf") )
                cCnpjTit := SanitizaID( GetJsonPathDirf(oHolder, "cnpj") )

                //-------------------------------------------------------------
                // Mapeamento de Valores (JSON -> Array Analítico)
                //-------------------------------------------------------------
                cRegAns := SanitizaID( GetJsonPathDirf( oHolder, "ansCode" ) )

                aAnalitico[nPos][ANALITICO_DEPSAUDECPF]    := cCpfDep
                aAnalitico[nPos][ANALITICO_DEPSAUDEVLRDEP] := GetNumValDirf( oDep, "values" )
                aAnalitico[nPos][ANALITICO_RELACAO]        := TAFRelHealthDep( cCtxPai, cCnpjTit, cRegAns, cCpfDep )
     
            Next nY
            
        EndIf
        
    Next nX
    
Return .T.

//---------------------------------------------------------------------
/*/{Protheus.doc} ProcReemboDirf
@type           Function
@description    Processa a aba de Reembolsos Médicos (06) - Estrutura hierárquica.
                Navega pelos 4 níveis de dados:
                1. REMMED: Cabeçalho do Reembolso
                2. REMTID: Detalhes do Titular
                3. REMDEP: Cabeçalho do Dependente
                4. DETDEP: Detalhes do Dependente

@param          oJson     , Json     , Objeto JSON raiz contendo os dados do payload.
@param          cPeriodo  , Character, Período de apuração (AAAAMM).
@param          cNome     , Character, Nome do trabalhador/beneficiário.
@param          cCpf      , Character, CPF do trabalhador/beneficiário.
@param          cCodRec   , Character, Código da Receita (DARF).
@param          cCtxPai   , Character, Contexto canônico do pai lógico (infoIRComplem).
@param          aAnalitico, Array    , Array de retorno (Passado por Referência) que será populado.
@param          cID       , Character, UUID de vínculo com o registro pai (S-1210).
@param          cVersao   , Character, Versão do layout.
@param          cFil      , Character, Filial corrente.

@return         .T.

@author         Denis R. de Oliveira
@since          08/01/2026
@version        1.0
/*/
//---------------------------------------------------------------------
Function ProcReemboDirf(oJson as Json, cPeriodo as Character, cNome as Character, cCpf as Character, cCodRec as Character, cCtxPai as Character, aAnalitico as Array, cID as Character, cVersao as Character, cFil as Character) as Logical
    
    //-------------------------------------------------------------------------
    // Declaração de Variáveis Locais
    //-------------------------------------------------------------------------
    Local aReimb    as Array     // Nível 1: Lista de Reembolsos
    Local aHolDet   as Array     // Nível 2: Lista de Detalhes do Titular
    Local aDepReimb as Array     // Nível 3: Lista de Reembolsos de Dependentes
    Local aDepDet   as Array     // Nível 4: Lista de Detalhes do Dependente

    Local cDepCpf   as Character // CPF de Dependente
    Local cIndRem   as Character
    Local cCnpjOp   as Character
    Local cRegAns   as Character
    Local cTpInsc   as Character
    Local cNrInsc   as Character
    Local cCabKey   as Character
    Local cSeqCab   as Character

    Local nX        as Numeric   // Contador Nível 1
    Local nY        as Numeric   // Contador Nível 2
    Local nZ        as Numeric   // Contador Nível 3
    Local nW        as Numeric   // Contador Nível 4
    Local nSeqTit   as Numeric   // Contador Acumulativo 
    Local nSeqDep   as Numeric   // Contador Acumulativo 
    Local nSeqDet   as Numeric   // Contador Acumulativo 
    Local nPos      as Numeric   // Índice do array analítico

    Local oReimb    as Json      // Objeto Reembolso
    Local oHolDet   as Json      // Objeto Detalhe Titular
    Local oDepReimb as Json      // Objeto Reembolso Dependente
    Local oDepDet   as Json      // Objeto Detalhe Dependente
    Local oMedReimb as Json      // Objeto para extração dos dados
    
    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default oJson      := Nil
    Default cPeriodo   := ""
    Default cNome      := ""
    Default cCpf       := ""
    Default cCodRec    := ""
    Default cCtxPai    := ""
    Default aAnalitico := {}
    Default cID        := ""
    Default cVersao    := ""
    Default cFil       := ""

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    aReimb    := {}
    aHolDet   := {}
    aDepReimb := {}
    aDepDet   := {}

    cDepCpf   := ""
    cIndRem   := ""
    cCnpjOp   := ""
    cRegAns   := ""
    cTpInsc   := ""
    cNrInsc   := ""
    cCabKey   := ""
    cSeqCab   := ""

    nX        := 0
    nY        := 0
    nZ        := 0
    nW        := 0
    nSeqTit   := 0
    nSeqDep   := 0
    nSeqDet   := 0
    nPos      := 0

    oReimb    := Nil
    oHolDet   := Nil
    oDepReimb := Nil
    oDepDet   := Nil
    oMedReimb := Nil

    //-------------------------------------------------------------------------
    // Validação Estrutural e Extração Nível 1 (Reembolsos)
    //-------------------------------------------------------------------------
    // 1. Tenta localizar o nó medicalReimbursement na raiz de Vínculo (CLT)
    If CheckPathDirf(oJson, "infoComplem", "medicalReimbursement")
        oMedReimb := oJson["infoComplem"]["medicalReimbursement"]
        
    // 2. Se não achou, tenta na raiz Sem Vínculo (Autônomo/TSVE)
    ElseIf CheckPathDirf(oJson, "infoComplemNoContract", "medicalReimbursement")
        oMedReimb := oJson["infoComplemNoContract"]["medicalReimbursement"]
        
    // 3. Se não existe em nenhum lugar, encerra
    Else
        Return .F.
    EndIf
    
    // Extrai a lista de reembolsos do objeto localizado
    If !GetArrayDirf(oMedReimb, "", "reimbursements", @aReimb)
        Return .F.
    EndIf
    
    //-------------------------------------------------------------------------
    // Loop Nível 1: Reembolsos (REMMED)
    //-------------------------------------------------------------------------
    For nX := 1 To Len(aReimb)
        
        oReimb := aReimb[nX]
        aHolDet:= {}
        
        // --- Registro REMMED (Cabeçalho Reembolso) ---
        nPos := CreateRowDirf(@aAnalitico)

        cSeqCab := StrZero( nX, 3 )
        FillBasicDirf( aAnalitico, nPos, cPeriodo, cNome, cCpf, cCodRec, "REMMED", "07", cSeqCab, cID, cVersao, cFil )

        cIndRem := Left( AllTrim( GetJsonPathDirf( oReimb, "originOfRefund" ) ), 1 )
        cIndRem := IIf( Empty( cIndRem ), "1", cIndRem )

        cCnpjOp := SanitizaID( GetJsonPathDirf( oReimb, "registrationNumber" ) )
        cRegAns := SanitizaID( GetJsonPathDirf( oReimb, "ansCode" ) )
        cCabKey := TAFRelReimbHeader( cCtxPai, cIndRem, cCnpjOp, cRegAns, cSeqCab )

        aAnalitico[nPos][ANALITICO_REMMEDINDREM] := SubStr( AllTrim( DecodeUTF8( GetJsonPathDirf( oReimb, "originOfRefund" ) ) ), 1, 110 )
        aAnalitico[nPos][ANALITICO_REMMEDCNPJOP] := cCnpjOp
        aAnalitico[nPos][ANALITICO_REMMEDREGANS] := cRegAns
        aAnalitico[nPos][ANALITICO_RELACAO]      := cCabKey
        
        //---------------------------------------------------------------------
        // Nível 2: Detalhes do Titular (holderDetail - REMTID)
        //---------------------------------------------------------------------
        If GetArrayDirf(oReimb, "", "holderDetail", @aHolDet)
            
            For nY := 1 To Len(aHolDet)
                
                oHolDet := aHolDet[nY]

                // Incremento do controle
                nSeqTit++
                
                // --- Registro REMTID (Titular Detalhe) ---
                nPos := CreateRowDirf(@aAnalitico)
                FillBasicDirf(aAnalitico, nPos, cPeriodo, cNome, cCpf, cCodRec, "REMTID", "7A", StrZero(nSeqTit, 3), cID, cVersao, cFil)
                cTpInsc := Left( AllTrim( GetJsonPathDirf( oHolDet, "registrationType" ) ), 1 )
                cNrInsc := SanitizaID( GetJsonPathDirf( oHolDet, "registrationNumber" ) )

                aAnalitico[nPos][ANALITICO_REMTIDTPINSC] := GetJsonPathDirf( oHolDet, "registrationType" )
                aAnalitico[nPos][ANALITICO_REMTIDNRINSC] := cNrInsc
                aAnalitico[nPos][ANALITICO_REMTIDVLREMB] := GetNumValDirf( oHolDet, "values" )
                aAnalitico[nPos][ANALITICO_REMTIDVLRANT] := GetNumValDirf( oHolDet, "previousValues" )
                aAnalitico[nPos][ANALITICO_RELACAO]      := cCabKey + "|TIT|" + cTpInsc + "|" + cNrInsc
                
            Next nY
            
        EndIf
        
        //---------------------------------------------------------------------
        // Nível 3: Reembolso Dependente (reimbursementDependent - REMDEP)
        //---------------------------------------------------------------------
        aDepReimb := {}

        If GetArrayDirf(oReimb, "", "reimbursementDependent", @aDepReimb)
            
            For nZ := 1 To Len(aDepReimb)
                
                oDepReimb := aDepReimb[nZ]

                // Incremento do controle
                nSeqDep++
                
                // --- Registro REMDEP (Dependente Cabeçalho) ---
                nPos := CreateRowDirf(@aAnalitico)
                FillBasicDirf(aAnalitico, nPos, cPeriodo, cNome, cCpf, cCodRec, "REMDEP", "7B", StrZero(nSeqDep, 3), cID, cVersao, cFil)
                cDepCpf := SanitizaID( GetJsonPathDirf( oDepReimb, "cpf" ) )

                aAnalitico[nPos][ANALITICO_REMDEPCPF] := cDepCpf
                aAnalitico[nPos][ANALITICO_RELACAO]   := cCabKey + "|D|" + cDepCpf
                
                //-------------------------------------------------------------
                // Nível 4: Detalhes do Dependente (dependentDetail - DETDEP)
                //-------------------------------------------------------------
                aDepDet := {}

                If GetArrayDirf(oDepReimb, "", "dependentDetail", @aDepDet)
                    
                    For nW := 1 To Len(aDepDet)
                        
                        oDepDet := aDepDet[nW]

                        // Incremento do controle
                        nSeqDet++
                        
                        // --- Registro DETDEP (Dependente Detalhe) ---
                        nPos := CreateRowDirf(@aAnalitico)
                        FillBasicDirf(aAnalitico, nPos, cPeriodo, cNome, cCpf, cCodRec, "DETDEP", "7C", StrZero(nSeqDet, 3), cID, cVersao, cFil)
                        cTpInsc := Left( AllTrim( GetJsonPathDirf( oDepDet, "registrationType" ) ), 1 )
                        cNrInsc := SanitizaID( GetJsonPathDirf( oDepDet, "registrationNumber" ) )

                        aAnalitico[nPos][ANALITICO_DETDEPTPINSC] := GetJsonPathDirf( oDepDet, "registrationType" )
                        aAnalitico[nPos][ANALITICO_DETDEPNRINSC] := cNrInsc
                        aAnalitico[nPos][ANALITICO_DETDEPVLREMB] := GetNumValDirf( oDepDet, "values" )
                        aAnalitico[nPos][ANALITICO_DETDEPVLRANT] := GetNumValDirf( oDepDet, "previousValues" )
                        aAnalitico[nPos][ANALITICO_RELACAO]      := cCabKey + "|D|" + cDepCpf + "|T|" + cTpInsc + "|" + cNrInsc
                        
                    Next nW
                    
                EndIf
                
            Next nZ
            
        EndIf
        
    Next nX
    
Return .T.

//---------------------------------------------------------------------
/*/{Protheus.doc} CreateRowDirf
@type           Function
@description    Cria uma nova linha no array analítico com tamanho fixo (77 posições).
                Inicializa todos os campos com valores apropriados ao tipo (String/Numeric),
                utilizando a função padronizada TAFInitArray para garantir integridade.

@param          aAnalitico, Array, Array principal passado por referência (Ref).

@return         Numeric, Índice (posição) da nova linha criada no array.

@author         Denis R. de Oliveira
@since          08/01/2026
@version        1.0
/*/
//---------------------------------------------------------------------
Function CreateRowDirf(aAnalitico as Array) as Numeric
    
    //-------------------------------------------------------------------------
    // Declaração de Variáveis Locais
    //-------------------------------------------------------------------------
    Local nNewPos as Numeric // Armazena o índice da nova linha criada
    
    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default aAnalitico := {}

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    nNewPos := 0

    //-------------------------------------------------------------------------
    // Criação e Inicialização da Nova Linha
    //-------------------------------------------------------------------------
    // Adiciona uma nova linha vazia (array de tamanho 77) ao array principal
    // O uso de Array(ANALITICO_SIZE) já aloca a memória necessária.
    aAdd(aAnalitico, Array(ANALITICO_SIZE))
    
    // Recupera o índice da linha recém-criada
    nNewPos := Len(aAnalitico)
    
    // Chama a função de inicialização padronizada para tipar cada campo corretamente.
    TAFInitArray( aAnalitico, nNewPos )
    
Return nNewPos

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFBuildCtxPai
@type           Static Function
@description    Monta o contexto canônico do pai lógico (infoIRComplem)
                para os registros de saúde e reembolso da origem 2.
                O contexto é mantido apenas na RELACAO, preservando o
                campo PERREF físico conforme o comportamento do PROD.
                Quando houver perAnt/perRefAjuste, gera prefixo ANT_;
                caso contrário, gera prefixo ATU_. Para garantir
                unicidade entre itens do lote, concatena o ID do item.

@param          oJsonItem, Variant  , Objeto JSON corrente do lote.
@param          cPeriodo , Character, Período de apuração (AAAAMM).
@param          cID      , Character, UUID de vínculo do item.
@return         cCtxPai  , Character, Token canônico do pai.

@author         Denis R. de Oliveira
@since          25/03/2026
@version        1.0
/*/
//---------------------------------------------------------------------
Static Function TAFBuildCtxPai( oJsonItem as Variant, cPeriodo as Character, cID as Character ) as Character

    //-------------------------------------------------------------------------
    // Declaração de Variáveis Locais
    //-------------------------------------------------------------------------
    Local cCtxPai   as Character
    Local cPath     as Character
    Local cPerRef   as Character
    Local cTokenID  as Character

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default oJsonItem := Nil
    Default cPeriodo  := ""
    Default cID       := ""

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    cCtxPai  := ""
    cPath    := ""
    cPerRef  := ""
    cTokenID := ""

    cPeriodo := SanitizaID( cPeriodo )

    //-------------------------------------------------------------------------
    // Processamento
    //-------------------------------------------------------------------------
    cPath := TAFInfoComplemPath( oJsonItem )

    If Empty( cPath )
        Return ""
    EndIf

    cPerRef  := SanitizaID( GetJsonPathDirf( oJsonItem, cPath + ".perAnt.perRefAjuste" ) )
    cTokenID := StrTran( AllTrim( cID ), "|", "" )

    If Empty( cPerRef )
        cCtxPai := "ATU_" + cPeriodo + "_I" + cTokenID
    Else
        cCtxPai := "ANT_" + cPerRef + "_I" + cTokenID
    EndIf

Return cCtxPai

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFInfoComplemPath
@type           Static Function
@description    Retorna o caminho raiz do bloco infoComplem aplicável
                ao item corrente do payload da origem 2.

@param          oJson , Variant  , Objeto JSON corrente.
@return         cPath, Character, Caminho raiz encontrado.

@author         Denis R. de Oliveira
@since          25/03/2026
@version        1.0
/*/
//---------------------------------------------------------------------
Function TAFInfoComplemPath( oJson as Variant ) as Character

    //-------------------------------------------------------------------------
    // Declaração de Variáveis Locais
    //-------------------------------------------------------------------------
    Local cPath as Character

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default oJson := Nil

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    cPath := ""

    //-------------------------------------------------------------------------
    // Processamento
    //-------------------------------------------------------------------------
    If CheckPathDirf( oJson, "infoComplem", "" )
        cPath := "infoComplem"
    ElseIf CheckPathDirf( oJson, "infoComplemNoContract", "" )
        cPath := "infoComplemNoContract"
    EndIf

Return cPath

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFRelHealthHolder
@type           Static Function
@description    Monta a RELACAO canônica do titular de plano de saúde,
                preservando compatibilidade com o formato antigo quando
                o contexto do pai não estiver disponível.

@param          cCtxPai, Character, Contexto canônico do pai.
@param          cCnpj  , Character, CNPJ da operadora.
@param          cAns   , Character, Código ANS.
@return         cRel   , Character, Chave relacional.

@author         Denis R. de Oliveira
@since          25/03/2026
@version        1.0
/*/
//---------------------------------------------------------------------
Function TAFRelHealthHolder( cCtxPai as Character, cCnpj as Character, cAns as Character ) as Character

    //-------------------------------------------------------------------------
    // Declaração de Variáveis Locais
    //-------------------------------------------------------------------------
    Local cCtx as Character
    Local cRel as Character

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default cCtxPai := ""
    Default cCnpj   := ""
    Default cAns    := ""

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    cCtx := AllTrim( cCtxPai )
    cRel := ""

    //-------------------------------------------------------------------------
    // Processamento
    //-------------------------------------------------------------------------
    cRel := IIf( Empty( cCtx ), "TIT|" + cCnpj + "|" + cAns, "P|" + cCtx + "|TIT|" + cCnpj + "|" + cAns )

Return cRel

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFRelHealthDep
@type           Static Function
@description    Monta a RELACAO canônica do dependente de plano de saúde,
                preservando compatibilidade com o formato antigo quando
                o contexto do pai não estiver disponível.

@param          cCtxPai, Character, Contexto canônico do pai.
@param          cCnpj  , Character, CNPJ da operadora.
@param          cAns   , Character, Código ANS.
@param          cCpf   , Character, CPF do dependente.
@return         cRel   , Character, Chave relacional.

@author         Denis R. de Oliveira
@since          25/03/2026
@version        1.0
/*/
//---------------------------------------------------------------------
Function TAFRelHealthDep( cCtxPai as Character, cCnpj as Character, cAns as Character, cCpf as Character ) as Character

    //-------------------------------------------------------------------------
    // Declaração de Variáveis Locais
    //-------------------------------------------------------------------------
    Local cCtx as Character
    Local cRel as Character

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default cCtxPai := ""
    Default cCnpj   := ""
    Default cAns    := ""
    Default cCpf    := ""

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    cCtx := AllTrim( cCtxPai )
    cRel := ""

    //-------------------------------------------------------------------------
    // Processamento
    //-------------------------------------------------------------------------
    cRel := IIf( Empty( cCtx ), "TIT|" + cCnpj + "|" + cAns + "|DEP|" + cCpf, "P|" + cCtx + "|TIT|" + cCnpj + "|" + cAns + "|DEP|" + cCpf )

Return cRel

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFRelReimbHeader
@type           Static Function
@description    Monta a RELACAO canônica do cabeçalho de reembolso,
                preservando compatibilidade com o formato antigo quando
                o contexto do pai não estiver disponível.

@param          cCtxPai, Character, Contexto canônico do pai.
@param          cIndRem, Character, Indicador da origem do reembolso.
@param          cCnpj  , Character, CNPJ da operadora.
@param          cAns   , Character, Código ANS.
@param          cSeqCab, Character, Sequência lógica do cabeçalho do reembolso.
@return         cRel   , Character, Chave relacional.

@author         Denis R. de Oliveira
@since          25/03/2026
@version        1.0
/*/
//---------------------------------------------------------------------
Function TAFRelReimbHeader( cCtxPai as Character, cIndRem as Character, cCnpj as Character, cAns as Character, cSeqCab as Character ) as Character

    //-------------------------------------------------------------------------
    // Declaração de Variáveis Locais
    //-------------------------------------------------------------------------
    Local cCtx as Character
    Local cRel as Character
    Local cSeq as Character

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default cCtxPai := ""
    Default cIndRem := ""
    Default cCnpj   := ""
    Default cAns    := ""
    Default cSeqCab := ""

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    cCtx := AllTrim( cCtxPai )
    cRel := ""
    cSeq := AllTrim( cSeqCab )
    cSeq := IIf( Empty( cSeq ), "000", cSeq )

    //-------------------------------------------------------------------------
    // Processamento
    //-------------------------------------------------------------------------
    cRel := IIf( Empty( cCtx ), "CAB|" + cIndRem + "|" + cCnpj + "|" + cAns + "|" + cSeq, "P|" + cCtx + "|CAB|" + cIndRem + "|" + cCnpj + "|" + cAns + "|" + cSeq )

Return cRel

//---------------------------------------------------------------------
/*/{Protheus.doc} FillBasicDirf
@type           Function
@description    Preenche os campos comuns (metadados e chaves) em uma linha do array analítico.
                Garante que Filial, ID único, Período, CPF, Nome e identificadores do evento
                estejam corretamente populados antes do preenchimento dos valores específicos.

@param          aAnalitico, Array    , Array principal (Referência) que contém a linha a ser preenchida.
@param          nPos      , Numeric  , Índice da linha atual no array aAnalitico.
@param          cPeriodo  , Character, Período de apuração (AAAAMM).
@param          cNome     , Character, Nome do trabalhador/beneficiário.
@param          cCpf      , Character, CPF do trabalhador/beneficiário.
@param          cCodRec   , Character, Código da Receita (DARF).
@param          cForAba   , Character, Identificador mnemônico da Aba (ex: TRIBUT, DEDDEP).
@param          cAba      , Character, Código numérico da Aba (ex: 01, 02).
@param          cSeq      , Character, Sequência do registro dentro do lote.
@param          cID       , Character, UUID de vínculo com o registro pai (S-1210).
@param          cVersao   , Character, Versão do layout.
@param          cFil      , Character, Filial corrente.

@return         .T.

@author         Denis R. de Oliveira
@since          08/01/2026
@version        1.0

@see            xFilial, FwUUIDv4
/*/
//---------------------------------------------------------------------
Function FillBasicDirf(aAnalitico as Array, nPos as Numeric, cPeriodo as Character, cNome as Character, cCpf as Character, cCodRec as Character, cForAba as Character, cAba as Character, cSeq as Character, cID as Character, cVersao as Character, cFil as Character) as Logical
       
    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default aAnalitico := {}
    Default nPos       := 0
    Default cPeriodo   := ""
    Default cNome      := ""
    Default cCpf       := ""
    Default cCodRec    := ""
    Default cForAba    := ""
    Default cAba       := ""
    Default cSeq       := ""
    Default cID        := ""
    Default cVersao    := ""
    Default cFil       := ""
   
    //-------------------------------------------------------------------------
    // Preenchimento do Array Analítico
    //-------------------------------------------------------------------------
    // Preenche as colunas de controle e identificação do registro.
    // Os índices (ANALITICO_*) são definidos via #DEFINE no início do fonte principal.
    aAnalitico[nPos][ANALITICO_FILIAL]     := cFil
    aAnalitico[nPos][ANALITICO_ID]         := cID
    aAnalitico[nPos][ANALITICO_VERSAO]     := cVersao
    aAnalitico[nPos][ANALITICO_PERAPU]     := cPeriodo
    aAnalitico[nPos][ANALITICO_CPF]        := cCpf
    aAnalitico[nPos][ANALITICO_NOME]       := cNome
    aAnalitico[nPos][ANALITICO_EVENTO]     := "S-1210"   // Evento fixo para este processamento
    aAnalitico[nPos][ANALITICO_CODRECEITA] := cCodRec
    aAnalitico[nPos][ANALITICO_SEQUENCIA]  := cSeq
    aAnalitico[nPos][ANALITICO_FORABA]     := cForAba
    aAnalitico[nPos][ANALITICO_ABA]        := cAba
    aAnalitico[nPos][ANALITICO_PERREF]     := ""
    aAnalitico[nPos][ANALITICO_ORIGEM]     := "2"        // Origem 2 = Folha
    
Return .T.

//---------------------------------------------------------------------
/*/{Protheus.doc} GetJsonPathDirf
@type           Function
@description    Recupera valor de JSON aninhado (ex: "Info.Code") de forma segura.
                Navega pela hierarquia do JSON usando "." como separador.
                Suporta retorno de tipos primitivos e objetos wrapper (com propriedade 'erpValue').

@param          oJson, Variant  , Objeto JSON raiz onde a busca será iniciada.
@param          cPath, Character, Caminho hierárquico da propriedade (ex: "infoComplem.revenueCode").

@return         Character, Valor encontrado convertido para string, ou "" se não existir ou for inválido.

@author         Denis R. de Oliveira
@since          08/01/2026
@version        1.0
/*/
//---------------------------------------------------------------------
Function GetJsonPathDirf(oJson as Variant, cPath as Character) as Character
    
    //-------------------------------------------------------------------------
    // Declaração de Variáveis Locais
    //-------------------------------------------------------------------------
    Local aParts   as Array     // Array com as partes do caminho (ex: {"info", "id"})
    Local xCurrent as Variant   // Referência ao nó atual (Variant pois muda de tipo)
    Local nX       as Numeric   // Contador do loop de navegação
    Local cKey     as Character // Nome da propriedade atual sendo acessada
    Local cRet     as Character // Valor de retorno final
    Local cType    as Character // Cache de tipo para validação rápida
    
    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default oJson := Nil
    Default cPath := ""

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    aParts   := StrTokArr(cPath, ".")
    xCurrent := oJson
    nX       := 0
    cKey     := ""
    cRet     := ""
    cType    := ""

    
    //-------------------------------------------------------------------------
    // Navegação Profunda pelo Caminho (Loop Blindado)
    //-------------------------------------------------------------------------
    For nX := 1 To Len(aParts)
        
        cKey  := aParts[nX]
        cType := ValType(xCurrent)
        
        // 1. Validação de Estrutura (Anti-Crash):
        // Antes de verificar propriedade, o nó atual PRECISA ser um Objeto.
        // Se for String/Numérico, não podemos descer mais.
        If cType != "J" .And. cType != "O"
            Return "" 
        EndIf
        
        // 2. Verifica existência da chave
        If !xCurrent:HasProperty(cKey)
            Return ""
        EndIf
        
        // 3. Avança para o próximo nível
        xCurrent := xCurrent[cKey]
        
        // 4. Validação de Integridade
        If xCurrent == Nil
            Return ""
        EndIf
        
    Next nX
    
    //-------------------------------------------------------------------------
    // Extração e Conversão do Valor Final
    //-------------------------------------------------------------------------
    cType := ValType(xCurrent)

    Do Case
        
        Case cType == "C"
            cRet := AllTrim(xCurrent)
            
        Case cType == "N"
            // StrTran garante conversão correta mesmo se ambiente usar vírgula
            cRet := StrTran( cValToChar(xCurrent), ",", "." )
        Case cType == "L"
            // Converte true/false do JSON para "T"/"F" (String limpa)
            cRet := Iif(xCurrent, "T", "F")       
        Case cType == "J" .Or. cType == "O"
            // Suporte a objeto Wrapper TAF (erpValue)
            If xCurrent:HasProperty("erpValue")
                cRet := cValToChar(xCurrent["erpValue"])
            Else
                // Objeto complexo sem valor direto -> Retorna vazio
                cRet := "" 
            EndIf
            
        Otherwise
            cRet := cValToChar(xCurrent)
            
    EndCase
    
Return cRet

//---------------------------------------------------------------------
/*/{Protheus.doc} GetNumValDirf
@type           Function
@description    Obtém valor numérico de propriedade JSON de forma robusta e performática.
                Blindada contra Null Pointer Exceptions e tipos inválidos.

@param          oJson, Json,    Objeto JSON principal a ser lido.
@param          cProp, Character, Nome da chave (propriedade) a ser buscada.

@return         Numeric,          Valor da propriedade encontrada ou 0 (zero) caso contrário.

@author         Denis R. de Oliveira
@since          08/01/2026
@version        1.0
/*/
//---------------------------------------------------------------------
Function GetNumValDirf(oJson as Json, cProp as Character) as Numeric
    
    //-------------------------------------------------------------------------
    // Declaração de Variáveis Locais
    //-------------------------------------------------------------------------
    Local nRet  as Numeric
    Local xVal  as Variant
    Local cType as Character
    Local cTemp as Character

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default oJson   := Nil
    Default cProp   := ""

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    nRet    := 0
    xVal    := Nil
    cType   := ""
    cTemp   := ""
    
    // ----------------------------------------------------------------
    // 1. Acesso Seguro à Propriedade
    // ----------------------------------------------------------------
    // Verifica a existência da chave antes de tentar ler
    If oJson:HasProperty(cProp)
        
        xVal  := oJson[cProp]
        cType := ValType(xVal) // Cache do tipo para otimização

        // ----------------------------------------------------------------
        // 2. Tratamento por Tipo de Dado (Switch Lógico)
        // ----------------------------------------------------------------      
        Do Case
            
            // CASO A: Já é numérico 
            Case cType == "N"
                nRet := xVal
            
            // CASO B: Objeto/Wrapper TAF (Estrutura Complexa)
            Case cType == "J" .Or. cType == "O"
                
                // Valida existência interna da chave "erpValue"
                If xVal:HasProperty("erpValue")
                    
                    // Verifica se o valor interno já é numérico ou precisa converter
                    If ValType(xVal["erpValue"]) == "N"
                        nRet := xVal["erpValue"]
                    Else
                        // Converte string para número e limpa espaços
                        cTemp := AllTrim( cValToChar(xVal["erpValue"]) )

                        // CENÁRIO 1: Existem PONTO e VÍRGULA na string (Ex: 1.200,50 ou 1,200.50)
                        If ("." $ cTemp) .And. ("," $ cTemp)
                            
                            // Quem está por último (mais à direita) é o Decimal
                            If RAt(",", cTemp) > RAt(".", cTemp)
                                // Formato BR (1.000,00) -> Tira ponto, troca vírgula
                                cTemp := StrTran(cTemp, ".", "") 
                                cTemp := StrTran(cTemp, ",", ".") 
                            Else
                                // Formato US (1,000.00) -> Tira vírgula, mantém ponto
                                cTemp := StrTran(cTemp, ",", "")
                            EndIf

                        // CENÁRIO 2: Existe APENAS VÍRGULA (Ex: "1,200" ou "1,50")
                        ElseIf ("," $ cTemp)
                            
                            // Heurística: Se tiver exatamente 3 casas decimais (Ex: "1,200"),
                            // assumimos padrão US (Milhar) para evitar erro de ler como 1.2
                            If ( Len(cTemp) - RAt(",", cTemp) ) == 3
                                cTemp := StrTran(cTemp, ",", "") // Remove milhar (1,200 -> 1200)
                            Else
                                cTemp := StrTran(cTemp, ",", ".") // Vira decimal (1,50 -> 1.50)
                            EndIf
                            
                        EndIf

                        // CENÁRIO 3: Se tiver apenas Ponto ou nenhum separador, o Val resolve nativamente.
                        nRet := Val(cTemp)
                    EndIf
                    
                EndIf
            
            // CASO C: String Numérica (Parse JSON simples)
            Case cType == "C"
                
                cTemp := AllTrim(xVal)
                
                // CENÁRIO 1: Existem PONTO e VÍRGULA na string
                If ("." $ cTemp) .And. ("," $ cTemp)
                    If RAt(",", cTemp) > RAt(".", cTemp)
                        cTemp := StrTran(cTemp, ".", "")
                        cTemp := StrTran(cTemp, ",", ".")
                    Else
                        cTemp := StrTran(cTemp, ",", "")
                    EndIf
                // CENÁRIO 2: Existe APENAS VÍRGULA
                ElseIf ("," $ cTemp)
                    If ( Len(cTemp) - RAt(",", cTemp) ) == 3
                        cTemp := StrTran(cTemp, ",", "")
                    Else
                        cTemp := StrTran(cTemp, ",", ".")
                    EndIf
                EndIf
                
                // Força formato Americano antes do Val() para garantir decimais
                cTemp := StrTran( cTemp, ",", "." ) 
                nRet  := Val(cTemp)
                
        EndCase
        
    EndIf
    
Return nRet

//---------------------------------------------------------------------
/*/{Protheus.doc} GetArrayDirf
@type           Function
@description    Extrai arrays do JSON de forma segura, performática e tipada.
                Realiza navegação em até 2 níveis (Prop1 -> Prop2).
                
@param          oJson , Object   , (Obrigatório) Objeto JSON pai.
@param          cProp1, Character, (Opcional) Propriedade de nível 1.
@param          cProp2, Character, (Obrigatório) Propriedade de nível 2 (Array alvo).
@param          aRet  , Array    , (Ref) Array onde os dados serão armazenados.

@return         Logical, .T. = Extraído com sucesso; .F. = Falha ou inexistente.

@author         Denis R. de Oliveira
@since          08/01/2026
@version        1.0
/*/
//---------------------------------------------------------------------
Function GetArrayDirf(oJson as Json, cProp1 as Character, cProp2 as Character, aRet as Array) as Logical
    
    //-------------------------------------------------------------------------
    // Declaração de Variáveis Locais
    //-------------------------------------------------------------------------
    Local oTarget as Json    // Referência móvel (Navegação)
    Local xChild  as Variant // Variável auxiliar para validação de tipo segura

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default oJson   := Nil
    Default cProp1  := ""
    Default cProp2  := ""
    Default aRet    := {}

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    oTarget := Nil
     
    //-------------------------------------------------------------------------
    // 1. Guard Clauses (Validação de Entrada e Tipagem)
    //-------------------------------------------------------------------------
    // Limpeza mandatória do retorno (por referência)
    aRet := {}

    // Setup Inicial
    oTarget := oJson

    //-------------------------------------------------------------------------
    // 2. Navegação Nível 1
    //-------------------------------------------------------------------------
    If !Empty(cProp1)
        
        // Verifica existência
        If !oTarget:HasProperty(cProp1)
            Return .F.
        EndIf
 
        // Não podemos atribuir diretamente oTarget := oTarget[cProp1] sem saber se é objeto.
        // Se for string/número, a próxima chamada de método quebrará o sistema.
        xChild := oTarget[cProp1]
        
        // Agora é seguro avançar o ponteiro
        oTarget := xChild
        
    EndIf
    
    //-------------------------------------------------------------------------
    // 3. Extração Nível 2
    //-------------------------------------------------------------------------
    // Verifica existência da propriedade final
    If !oTarget:HasProperty(cProp2)
        Return .F.
    EndIf
    
    // Verifica Tipagem Estrita do Conteúdo (Deve ser Array)
    If ValType(oTarget[cProp2]) == "A"
        aRet := oTarget[cProp2]
        Return .T.
    EndIf
    
Return .F.

//---------------------------------------------------------------------
/*/{Protheus.doc} CheckPathDirf
@type           Function
@description    Verifica se um caminho JSON existe (Nível 1 e, opcionalmente, Nível 2).
                Realiza validação de existência e tipo (garante que Nível 1 seja um Objeto JSON
                antes de tentar acessar Nível 2).

@param          oJson , Json     , Objeto JSON raiz a verificar.
@param          cProp1, Character, Nome da propriedade de nível 1.
@param          cProp2, Character, (Opcional) Nome da propriedade de nível 2.

@return         Logical, .T. se o caminho for válido e existir; .F. caso contrário.

@author         Denis R. de Oliveira
@since          08/01/2026
@version        1.0
/*/
//---------------------------------------------------------------------
Function CheckPathDirf(oJson as Json, cProp1 as Character, cProp2 as Character) as Logical
    
    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default oJson  := Nil
    Default cProp1 := ""
    Default cProp2 := ""

    //-------------------------------------------------------------------------
    // Validações de Nível 1
    //-------------------------------------------------------------------------
    // 1. Verifica se a propriedade de nível 1 existe
    If !oJson:HasProperty(cProp1)
        Return .F.
    EndIf

    //-------------------------------------------------------------------------
    // Validações de Nível 2
    //-------------------------------------------------------------------------
    If !Empty(cProp2)
        // Verifica se a propriedade de nível 2 existe dentro do objeto de nível 1
        If !oJson[cProp1]:HasProperty(cProp2)
            Return .F.
        EndIf
    EndIf
    
Return .T.

//---------------------------------------------------------------------
/*/{Protheus.doc} ProcessaGrvDirf
@type           Function
@description    Orquestra a gravação de um lote de dados no TAF com mecanismo de resiliência.

@param          aAnalitico, Array    , (Obrigatório) Lote de dados analíticos (Itens/Filhos) para gravação.
@param          a1210     , Array    , (Obrigatório) Dados de cabeçalho (Pais) sintetizados para controle de transação.
@param          aIncons   , Array    , (Referência)  Array que receberá a lista de erros APENAS em caso de falha definitiva.
@param          lNovo     , Logical  , Define se é uma nova tentativa de gravação (controle interno).

@return         Logical   , .T. = Sucesso na gravação; .F. = Falha após todas as tentativas.

@author         Denis R. de Oliveira 
@since          08/01/2026
@version        1.0
/*/
//---------------------------------------------------------------------
Function ProcessaGrvDirf( aAnalitico as Array, a1210 as Array, aIncons as Array, lNovo as Logical ) as Logical
    
     //-------------------------------------------------------------------------
    // Declaração de Variáveis Locais
    //-------------------------------------------------------------------------
    Local cAlias        as Character

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default aAnalitico  := {}
    Default a1210       := {}
    Default aIncons     := {}
    Default lNovo       := .F.

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    cAlias  := "T3P"

    // 1. Validação de Contrato
    If Len( aAnalitico ) == 0
        Return .T.
    EndIf

    If Len( a1210 ) == 0
        TafConOut( "[ProcessaGrvDirf] [ERRO] Array de cabecalho (a1210) vazio." )
        Return .F.
    EndIf
        
    // Chamada da função nativa
    TafGrvDIRF( aAnalitico, a1210, cAlias, , , lNovo )

Return .T.

//---------------------------------------------------------------------
/*/{Protheus.doc} SanitizaID
@type           Static Function
@description    Remove caracteres de formatação (ponto, traço, barra e espaços) de uma string.
                Utilizada para normalizar chaves como CPF, CNPJ, Processos e CEPs antes da gravação.
@author         Denis R. de Oliveira
@since          08/01/2026
@version        1.0

@param          cValor, Variant, A string original contendo formatação (Ex: "123.456.789-00").
@return         Character, A string limpa contendo apenas alfanuméricos (Ex: "12345678900").
/*/
//---------------------------------------------------------------------
Static Function SanitizaID( cValor as Variant ) as Character

    //-------------------------------------------------------------------------
    // Declaração de Variáveis
    //-------------------------------------------------------------------------
    Local cRet as Character

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default cValor := ""

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //------------------------------------------------------------------------
    // Garante que a entrada seja tratada como string e remove espaços laterais
    cRet := AllTrim( cValToChar( cValor ) )

    //-------------------------------------------------------------------------
    // Processamento (Sanitização)
    //-------------------------------------------------------------------------
    // Remove pontos (.)
    cRet := StrTran( cRet, ".", "" )
    
    // Remove traços (-)
    cRet := StrTran( cRet, "-", "" )
    
    // Remove barras (/)
    cRet := StrTran( cRet, "/", "" )
    
    // Remove espaços em branco internos (" ")
    cRet := StrTran( cRet, " ", "" )

Return cRet

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFInitArray
@type           Static Function
@description    Inicializa uma linha do array analítico com 77 posições fixas.
                Define explicitamente quais campos são Texto e quais são Numéricos
                para evitar erros de Type Mismatch na gravação.
@author         Denis R. de Oliveira
@since          29/01/2026
@version        1.0

@param          aAnalitico,  Array,   Array principal (passado por referência).
@param          nPosValores, Numeric, Índice da linha atual a ser inicializada.
@return         Nil
/*/
//---------------------------------------------------------------------
Static Function TAFInitArray( aAnalitico as Array, nPosValores as Numeric )

    Static aEmpty
    
    Default aAnalitico  := {}
    Default nPosValores := 0

    // Construcao do Esqueleto Basico (Executado apenas 1x por Thread)
    If ValType( aEmpty ) != "A"
        aEmpty := Array( 77 )
        AFill( aEmpty, 0 ) 
        
        // Ajusta as posicoes que obrigatoriamente sao Caracteres (String)
        aEmpty[1]  := ""; aEmpty[2]  := ""; aEmpty[3]  := ""; aEmpty[4]  := ""; aEmpty[5]  := ""
        aEmpty[6]  := ""; aEmpty[7]  := ""; aEmpty[8]  := ""; aEmpty[9]  := ""
        aEmpty[29] := ""; aEmpty[30] := ""; aEmpty[32] := ""; aEmpty[33] := ""; aEmpty[35] := ""; aEmpty[36] := ""
        aEmpty[41] := ""; aEmpty[42] := ""; aEmpty[43] := ""; aEmpty[44] := ""; aEmpty[50] := ""
        aEmpty[52] := ""; aEmpty[54] := ""; aEmpty[56] := ""; aEmpty[57] := ""; aEmpty[59] := ""
        aEmpty[61] := ""; aEmpty[62] := ""; aEmpty[63] := ""; aEmpty[64] := ""; aEmpty[65] := ""
        aEmpty[68] := ""; aEmpty[69] := ""; aEmpty[70] := ""
        aEmpty[73] := ""; aEmpty[74] := ""; aEmpty[75] := ""; aEmpty[76] := ""; aEmpty[77] := ""
    EndIf

    // Atribuicao por Clonagem de Memoria 
    If nPosValores > 0 .And. nPosValores <= Len( aAnalitico )
        aAnalitico[nPosValores] := AClone( aEmpty )
    EndIf

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFRhTpProcCanon
@type           Static Function
@description    Normaliza o tipo de processo da origem 2 para o mesmo
                formato textual utilizado nas origens 1 e 3.
@author         Denis R. de Oliveira
@since          26/03/2026
@version        1.0

@param          cTpProc, Character, Tipo de processo vindo do JSON.
@return         cTpProc, Character, Tipo de processo normalizado.
/*/
//---------------------------------------------------------------------
Static Function TAFRhTpProcCanon( cTpProc As Character ) As Character

    Default cTpProc := ""

    cTpProc := AllTrim( cTpProc )

    If cTpProc == "1"
        cTpProc := "1 - Administrativo"
    ElseIf cTpProc == "2"
        cTpProc := "2 - Judicial"
    EndIf

Return cTpProc

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFRhIndApuCanon
@type           Static Function
@description    Normaliza o indicativo de apuracao da origem 2 para o
                mesmo formato textual utilizado nas origens 1 e 3.
@author         Denis R. de Oliveira
@since          26/03/2026
@version        1.0

@param          cIndApu, Character, Indicativo vindo do JSON.
@return         cIndApu, Character, Indicativo normalizado.
/*/
//---------------------------------------------------------------------
Static Function TAFRhIndApuCanon( cIndApu As Character ) As Character

    Default cIndApu := ""

    cIndApu := AllTrim( cIndApu )

    If cIndApu == "1"
        cIndApu := "1 - Mensal"
    ElseIf cIndApu == "2"
        cIndApu := "2 - Anual (13° salário)"
    EndIf

Return cIndApu

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFRhTpDedCanon
@type           Function
@description    Normaliza o tipo de deducao da origem 2 para o mesmo
                formato textual utilizado nas origens 1 e 3.
@author         Denis R. de Oliveira
@since          26/03/2026
@version        1.0

@param          cTpDedu, Character, Tipo de deducao vindo do JSON.
@return         cTpDedu, Character, Tipo de deducao normalizado.
/*/
//---------------------------------------------------------------------
Function TAFRhTpDedCanon( cTpDedu As Character ) As Character

    Default cTpDedu := ""

    cTpDedu := AllTrim( cTpDedu )

    If cTpDedu == "1"
        cTpDedu := "1 - Previdência oficial"
    ElseIf cTpDedu == "2"
        cTpDedu := "2 - Previdência privada"
    ElseIf cTpDedu == "3"
        cTpDedu := "3 - Fundo de Aposentadoria Programada Individual - FAPI"
    ElseIf cTpDedu == "4"
        cTpDedu := "4 - Fundação de Previdência Complementar do Servidor Público - Funpresp"
    ElseIf cTpDedu == "5"
        cTpDedu := "5 - Pensão alimentícia"
    ElseIf cTpDedu == "7"
        cTpDedu := "7 - Dependentes"
    EndIf

Return cTpDedu
// EndFunction
