#INCLUDE "TLPP-CORE.TH"
#INCLUDE "PROTHEUS.CH"
#INCLUDE "TAFXFIN.CH"
#INCLUDE "FWMVCDEF.CH"

namespace totvs.protheus.fiscal.taf.financialintegration


/*/{Protheus.doc} GravaT162
@type			Function
@description	Função para os dados PAGAMENTOS A BENEFICIARIOS NAO IDENTIFICADOS / RETENÇÃO NO RECEBIMENTO
@author			Pâmela Bernardo
@since			17/03/2025
@version		1.0
/*/
Function GravaT162(jRetornoT162 as json, aDadosLog as array, cAliasTemp as character) as logical
	Local lGravadados := .T. as Logical
	Local nSubJsonT162AA:= 0 as Numeric
	Local nTotalT162:= 0 as Numeric
	Local nX:= 0 as Numeric
	Local nY:= 0 as Numeric
	Local cLog:= "" as character
	Local cIdSuspensao:= "" as character
	Local cNumeroProcesso:= "" as character
	Local cIdProcesso:= "" as character
	Local cIdParticipante:= "" as character
	Local cCNPJFonte:= "" as character
	Local cIDNaturezaRendimento	:= "" as character
	Local nOperacao:= MODEL_OPERATION_INSERT as Numeric
	Local oModel542		as object
	Local oModel_V4K	as object
	Local oModel_V9B	as object
	Local iTamanhoCoddoc	 := GetSX3Cache("V4K_CODDOC"	, "X3_TAMANHO") as integer
	Local cIDV4K := "" as character
	
	If Valtype(jRetornoT162) == "J" .and. Valtype(jRetornoT162["T162"]) == "A"
		nTotalT162 := Len(jRetornoT162["T162"])
		For nX:= 1 to nTotalT162
			cIDNaturezaRendimento := Posicione("V3O",1,xFilial("V3O")+jRetornoT162["T162"][nX]["NATUREZA_DO_RENDIMENTO"],"ALLTRIM(V3O_ID)")
			V14->(DbSetOrder(5))
			If V14->(DbSeek(xFilial("V14")+jRetornoT162["T162"][nX]["COD_PARTICIPANTE"]))
				cCNPJFonte := V14->V14_CNPJ
				cIdParticipante:= V14->V14_IDC1H
			EndIf

			cIDV4K := BuscaIDV4K(jRetornoT162["T162"][nX]["NATUREZ"], PadR(jRetornoT162["T162"][nX]["CODIGO_DOCUMENTO"],iTamanhoCoddoc), cIdParticipante)
			V4K->(dbSetOrder(1)) //V4K_FILIAL+V4K_ID
			If !Empty(cIDV4K) .and. V4K->(DbSeek(xFilial("V4K")+cIDV4K))
				nOperacao :=  MODEL_OPERATION_UPDATE
			Else
				nOperacao :=  MODEL_OPERATION_INSERT
			EndIf
			oModel542 := FWLoadModel("TAFA542")
			oModel542:SetOperation( nOperacao )
			oModel542:Activate()

			oModel_V4K:=oModel542:GetModel("MODEL_V4K")
			
			oModel_V4K:SetValue( "V4K_CODDOC", jRetornoT162["T162"][nX]["CODIGO_DOCUMENTO"])
			oModel_V4K:SetValue( "V4K_CODNAT", jRetornoT162["T162"][nX]["NATUREZA_DO_RENDIMENTO"])
			oModel_V4K:SetValue( "V4K_IDNATR", cIDNaturezaRendimento)
			oModel_V4K:SetValue( "V4K_DTPAG", jRetornoT162["T162"][nX]["DT_PAGAMENTO"])
			oModel_V4K:SetValue( "V4K_VLRLIQ", jRetornoT162["T162"][nX]["VLR_LIQ"])
			oModel_V4K:SetValue( "V4K_VLREAJ", jRetornoT162["T162"][nX]["VLR_REAJUSTADO"])
			oModel_V4K:SetValue( "V4K_VLRIR", jRetornoT162["T162"][nX]["VLR_IR"])
			oModel_V4K:SetValue( "V4K_DESCRI", jRetornoT162["T162"][nX]["DESCRICAO"])
			oModel_V4K:SetValue( "V4K_BASEIR", jRetornoT162["T162"][nX]["BASE_IR"])
			oModel_V4K:SetValue( "V4K_INDNAT", jRetornoT162["T162"][nX]["NATUREZ"])
			oModel_V4K:SetValue( "V4K_IDPART", cIdParticipante)
			oModel_V4K:SetValue( "V4K_CGCFON", cCNPJFonte)
			oModel_V4K:SetValue( "V4K_DTESCO", jRetornoT162["T162"][nX]["DTESCRCONT"])
			oModel_V4K:SetValue( "V4K_OBSERV", jRetornoT162["T162"][nX]["OBSERVACAO"])

			If ValType(jRetornoT162["T162"][nX]["T162AA"]) == "A"
				nSubJsonT162AA := Len(jRetornoT162["T162"][nX]["T162AA"])
				oModel_V9B:=oModel542:GetModel("MODEL_V9B")
				For nY:=1 to nSubJsonT162AA
					cIdSuspensao := Posicione("T5L",2,xFilial("T5L")+ jRetornoT162["T162"][nX]["T162AA"][nY]["COD_SUS"],"ALLTRIM(T5L_ID)" )
					cNumeroProcesso := jRetornoT162["T162"][nX]["T162AA"][nY]["NUM_PROC"]
					cIdProcesso := Posicione("C1G",1,xFilial("C1G")+cNumeroProcesso,"ALLTRIM(C1G_ID)" )
					oModel_V9B:SetValue( "V9B_TPPROC",jRetornoT162["T162"][nX]["T162AA"][nY]["TP_PROC"])
					oModel_V9B:SetValue( "V9B_NRPROC",cNumeroProcesso)
					oModel_V9B:LoadValue("V9B_IDPROC",cIdProcesso)
					oModel_V9B:SetValue( "V9B_CODSUS",jRetornoT162["T162"][nX]["T162AA"][nY]["COD_SUS"])
					oModel_V9B:SetValue( "V9B_IDSUSP",cIdSuspensao)
					oModel_V9B:SetValue( "V9B_BSUSIR",jRetornoT162["T162"][nX]["T162AA"][nY]["BASE_SUSPENSA"])
					oModel_V9B:SetValue( "V9B_VSUSIR",jRetornoT162["T162"][nX]["T162AA"][nY]["VAL_SUS"])
					oModel_V9B:SetValue( "V9B_VLRDEP",jRetornoT162["T162"][nX]["T162AA"][nY]["VAL_DEPOSITO_IR"])
				Next nY
			EndIf
				
			If oModel542:VldData()
				lGravadados := oModel542:CommitData()
				If lGravadados
					LEM->(DbSetOrder(1))
					If LEM->(DbSeek(xfilial("LEM")+(cAliasTemp)->TMP_ID))
						RecLock("LEM", .F.)
							LEM->LEM_INTEGR := "5"
						LEM->(MsUnLock())
					EndIf
				EndIf
			Else
				lGravadados := .F.
				cLog := cValToChar(oModel542:GetErrorMessage()[4]) + ' - '
				cLog += cValToChar(oModel542:GetErrorMessage()[5]) + ' - '
				cLog += cValToChar(oModel542:GetErrorMessage()[6])
				aDadosLog := {(cAliasTemp)->TMP_MOVORI, (cAliasTemp)->TMP_ID, FwX2Nome('V4K'), cLog, .T., '' }
				TAFConout(cLog,,, STR0002)
			Endif
		Next nX
	EndIf

Return lGravadados


/*/{Protheus.doc} BuscaIDV4K
@type			Function
@description	Função para buscar V4K_ID, em caso de alteração.
@author			Pâmela Bernardo
@since			04/11/2025
@version		1.0
/*/
Static Function BuscaIDV4K(cIdNat as character, cNumDoc as character, cIdPartic as character)

	Local cIDV4K := "" as character
	Local cQuery  := "" as character
	Local oQueryV4K as Object

	cQuery := " SELECT V4K_ID "
	cQuery += " FROM "+RetSQLName("V4K")+" V4K "
	cQuery += " WHERE "
	cQuery += " V4K_FILIAL = ? AND "
	cQuery += " V4K_INDNAT = ? AND "
	cQuery += " V4K_CODDOC = ? AND "
	cQuery += " V4K_IDPART = ? AND "
	cQuery += " V4K.D_E_L_E_T_ = ? "
	cQuery := ChangeQuery(cQuery)
	oQueryV4K := FwExecStatement():New(cQuery)


	oQueryV4K:setString(1, xFilial("V4K") )
	oQueryV4K:setString(2, cIdNat )
	oQueryV4K:setString(3, cNumDoc )
	oQueryV4K:setString(4, cIdPartic )
	oQueryV4K:setString(5, ' ' )
	cQuery := oQueryV4K:GetFixQuery()
	cIDV4K := MPSysExecScalar(cQuery, 'V4K_ID')


Return cIDV4K

