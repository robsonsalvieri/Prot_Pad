#INCLUDE "TLPP-CORE.TH"
#INCLUDE "PROTHEUS.CH"
#INCLUDE "TAFXFIN.CH"
#INCLUDE "FWMVCDEF.CH"

namespace totvs.protheus.fiscal.taf.financialintegration

/*/{Protheus.doc} GravaT001AB
@type			Function
@description	Função para gravar os registros Cadastro de processos referenciados
@author			Pâmela Bernardo
@since			17/03/2025
@version		1.0
/*/
Function GravaT001AB(jRetornoT001AB as json, aDadosLog as array, cAliasTemp as character) as logical
	Local lGravadados := .T. as Logical
	Local nTotalJson  := 0 as Numeric
	Local nSubJsonT001AO:= 0 as Numeric
	Local nX := 0 as Numeric
	Local nY := 0 as Numeric
	Local cLog:= "" as character
	Local cCodMun:= "" as character
	Local cNumeroProcesso:= "" as character
	Local cIdOrigemProcesso:= "" as character
	Local cDeposito:= "" as character
	Local nTamanhoNUMPRO := TAMSX3("C1G_NUMPRO")[1] as numeric
	Local nTamanhospace	:= 0 as numeric
	Local nOperacao:= MODEL_OPERATION_INSERT as Numeric
	Local oModel051		as object
	Local oModel_C1G	as object
	Local oModel_T5L	as object
	
	nTotalJson := Len(jRetornoT001AB:GetNames())
	For nX:=1 to nTotalJson
		If Valtype(jRetornoT001AB["T001AB"][nX]) == "J"

			If lGravadados
				cNumeroProcesso := jRetornoT001AB["T001AB"][nX]["NUM_PROC"]
				cIdOrigemProcesso := jRetornoT001AB["T001AB"][nX]["IND_PROC"]
				nTamanhospace := nTamanhoNUMPRO - LEN(jRetornoT001AB["T001AB"][nX]["NUM_PROC"])
				C1G->(dbSetOrder(1))
				If C1G->(DbSeek(xFilial("C1G")+cNumeroProcesso+Space(nTamanhospace)+cIdOrigemProcesso))
					nOperacao :=  MODEL_OPERATION_UPDATE 
				Else
					nOperacao :=  MODEL_OPERATION_INSERT
				EndIf
				oModel051 := FWLoadModel("TAFA051")
				oModel051:SetOperation( nOperacao ) //Alteração
				oModel051:Activate()

				oModel_C1G:=oModel051:GetModel("MODEL_C1G")
				If nOperacao ==  MODEL_OPERATION_INSERT
					oModel_C1G:SetValue( "C1G_NUMPRO", cNumeroProcesso )
					oModel_C1G:SetValue( "C1G_INDPRO", cIdOrigemProcesso )
					oModel_C1G:SetValue( "C1G_TPPROC", jRetornoT001AB["T001AB"][nX]["TP_PROC"] )
				EndIf
				oModel_C1G:SetValue( "C1G_DESCRI", jRetornoT001AB["T001AB"][nX]["DESCRI_RESUMIDA"])
				oModel_C1G:SetValue( "C1G_SECJUD", jRetornoT001AB["T001AB"][nX]["ID_SEC_JUD"] )
				oModel_C1G:SetValue( "C1G_VARA",   jRetornoT001AB["T001AB"][nX]["ID_VARA"])
				oModel_C1G:SetValue( "C1G_ACAJUD", Posicione("C18",1,xFilial("C18")+jRetornoT001AB["T001AB"][nX]["IND_NAT_ACAO_JUSTICA"] ,"C18_ID"))
				oModel_C1G:SetValue( "C1G_DECJUD", jRetornoT001AB["T001AB"][nX]["DESC_DEC_JUD"])
				oModel_C1G:SetValue( "C1G_DTSENT", StoD(jRetornoT001AB["T001AB"][nX]["DT_SENT_JUD"]) )
				oModel_C1G:SetValue( "C1G_INRCFE", Posicione("C19",1,xFilial("C19")+jRetornoT001AB["T001AB"][nX]["IND_NAT_ACAO_RECEITA"] ,"C19_ID") )
				oModel_C1G:SetValue( "C1G_DTADM",  StoD(jRetornoT001AB["T001AB"][nX]["DT_DEC_ADM"]) )
				oModel_C1G:SetValue( "C1G_INDAUT", jRetornoT001AB["T001AB"][nX]["INDAUTORIA"] )
				oModel_C1G:SetValue( "C1G_UFVARA", Posicione("C09",1,xFilial("C09")+jRetornoT001AB["T001AB"][nX]["UFVARA"],"C09_ID") )
				DbSelectArea("C07")
				C07->(DbSetOrder(5))
				If C07->(MsSeek(xFilial("C07")+jRetornoT001AB["T001AB"][nX]["CODMUNIC"]))
					cCodMun := C07->C07_ID
				EndIf
				oModel_C1G:SetValue( "C1G_CODMUN", cCodMun )
				oModel_C1G:LoadValue( "C1G_DTINI", jRetornoT001AB["T001AB"][nX]["INIVALID"])
				oModel_C1G:SetValue( "C1G_DTFIN",  jRetornoT001AB["T001AB"][nX]["FIMVALID"] )
				
				If ValType(jRetornoT001AB["T001AB"][nX]["T001AO"]) == "A"
					nSubJsonT001AO := Len(jRetornoT001AB["T001AB"][nX]["T001AO"])
					oModel_T5L:=oModel051:GetModel("MODEL_T5L")
					For nY:=1 to nSubJsonT001AO
						If nOperacao ==  MODEL_OPERATION_INSERT .or. ;
							!oModel_T5L:SeekLine( { {"T5L_CODSUS", jRetornoT001AB["T001AB"][nX]["T001AO"][nY]["COD_SUSP"] } } )
							If !oModel_T5L:IsEmpty()
								oModel_T5L:AddLine()
								oModel_T5L:GoLine( oModel_T5L:Length() )
							EndIf							
						EndIf
						oModel_T5L:SetValue( "T5L_CODSUS", jRetornoT001AB["T001AB"][nX]["T001AO"][nY]["COD_SUSP"] )
						oModel_T5L:SetValue( "T5L_INDDEC", Posicione("C8S",2,xFilial("C8S")+jRetornoT001AB["T001AB"][nX]["T001AO"][nY]["IND_SUSP"] ,"C8S_ID"))
						oModel_T5L:SetValue( "T5L_DTDEC",  StoD(jRetornoT001AB["T001AB"][nX]["T001AO"][nY]["DT_DECISAO"] ) )	
						cDeposito := If(jRetornoT001AB["T001AB"][nX]["T001AO"][nY]["IND_DEPOSITO"] =="S",'1','2')
						oModel_T5L:SetValue( "T5L_INDDEP",cDeposito)
					Next nY
				
				EndIf
				
				If oModel051:VldData()
					lGravadados := oModel051:CommitData()
				Else
					lGravadados := .F.
					cLog := cValToChar(oModel051:GetErrorMessage()[4]) + ' - '
					cLog += cValToChar(oModel051:GetErrorMessage()[5]) + ' - '
					cLog += cValToChar(oModel051:GetErrorMessage()[6])
					aDadosLog := {(cAliasTemp)->TMP_MOVORI, (cAliasTemp)->TMP_ID, FwX2Nome('C1G'), cLog, .T., '' }
					TAFConout(cLog,,, STR0002)
				Endif
			EndIf
		EndIf
	Next nX

Return lGravadados

