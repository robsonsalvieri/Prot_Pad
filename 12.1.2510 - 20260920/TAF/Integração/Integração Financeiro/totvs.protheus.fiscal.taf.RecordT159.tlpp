#INCLUDE "TLPP-CORE.TH"
#INCLUDE "PROTHEUS.CH"
#INCLUDE "TAFXFIN.CH"
#INCLUDE "FWMVCDEF.CH"

namespace totvs.protheus.fiscal.taf.financialintegration

/*/{Protheus.doc} GravaT159
@type			Function
@description	Função para os dados SOCIEDADE EM CONTA DE PARTICIPACAO
@author			Pâmela Bernardo
@since			17/03/2025
@version		1.0
/*/
Function GravaT159(jRetornoT159 as json, aDadosLog as array, cAliasTemp as character) as logical

	Local lGravadados := .T. as Logical
	Local nSubJsonT159AA := 0 as Numeric
	Local nY:= 0 as Numeric
	Local cLog:= "" as character
	Local cIdParticipante:= "" as character
	Local cCodigoParticipante	:= "" as character
	Local nOperacao	:= MODEL_OPERATION_INSERT as Numeric
	Local oModel536		as object
	Local oModel_V3X	as object
	Local oModel_V3Y	as object
	
	If Valtype(jRetornoT159) == "J"
		V3X->(dbSetOrder(2))
		If V3X->(DbSeek(xFilial("V3X")+jRetornoT159["CNPJ"]))
			nOperacao :=  MODEL_OPERATION_UPDATE 
		Else
			nOperacao :=  MODEL_OPERATION_INSERT
		EndIf
		oModel536 := FWLoadModel("TAFA536")
		oModel536:SetOperation( nOperacao ) //Alteração
		oModel536:Activate()

		oModel_V3X:=oModel536:GetModel("MODEL_V3X")
		If nOperacao ==  MODEL_OPERATION_INSERT 
			oModel_V3X:SetValue( "V3X_CNPJ", jRetornoT159["CNPJ"])
		EndIf
		oModel_V3X:SetValue( "V3X_NOME  ", Alltrim(jRetornoT159["NOME"]))
		oModel_V3X:SetValue( "V3X_INIPER", AllTrim(jRetornoT159["INIVALID"]))
		oModel_V3X:SetValue( "V3X_FINPER", AllTrim(jRetornoT159["FIMVALID"]))
		oModel_V3X:SetValue( "V3X_TPENTL", AllTrim(jRetornoT159["TPENTLIG"]))

		If ValType(jRetornoT159["T159AA"]) == "A"
			If ValType(jRetornoT159["T159AA"]) == "A"
				nSubJsonT159AA := Len(jRetornoT159["T159AA"])
				oModel_V3Y:=oModel536:GetModel("MODEL_V3Y")
				For nY:=1 to nSubJsonT159AA

					V14->(DbSetOrder(5))
					If V14->(DbSeek(xFilial("V14")+AllTrim(jRetornoT159["T159AA"][nY]["COD_PARTICIPANTE"])))
						cCodigoParticipante := V14->V14_CODPAR
						cIdParticipante:= V14->V14_IDC1H
					EndIf
				
					If nOperacao ==  MODEL_OPERATION_INSERT .or. !oModel_V3Y:SeekLine( { {"V3Y_IDPART", cIdParticipante } } )
						If !oModel_V3Y:IsEmpty()
							oModel_V3Y:AddLine()
							oModel_V3Y:GoLine( oModel_V3Y:Length() )
						EndIf
					EndIf
					oModel_V3Y:SetValue( "V3Y_IDPART",cIdParticipante)
					oModel_V3Y:SetValue( "V3Y_PERC",jRetornoT159["T159AA"][nY]["PERCENTUAL_PARTICIPACAO"])
					oModel_V3Y:LoadValue( "V3Y_PARTIC",cCodigoParticipante)
				Next nY
			EndIf
		EndIf
			
		If oModel536:VldData()
			lGravadados := oModel536:CommitData()
		Else
			lGravadados := .F.
			cLog := cValToChar(oModel536:GetErrorMessage()[4]) + ' - '
			cLog += cValToChar(oModel536:GetErrorMessage()[5]) + ' - '
			cLog += cValToChar(oModel536:GetErrorMessage()[6])
			aDadosLog := {(cAliasTemp)->TMP_MOVORI, (cAliasTemp)->TMP_ID, FwX2Nome('V3X'), cLog, .T., '' }
			TAFConout(cLog,,, STR0002)
		Endif
	EndIf

Return lGravadados
