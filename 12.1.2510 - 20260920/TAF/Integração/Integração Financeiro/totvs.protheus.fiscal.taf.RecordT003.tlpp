#INCLUDE "TLPP-CORE.TH"
#INCLUDE "PROTHEUS.CH"
#INCLUDE "TAFXFIN.CH"
#INCLUDE "TOPCONN.CH"
#INCLUDE "TBICONN.CH"
#INCLUDE "FWMVCDEF.CH"

namespace totvs.protheus.fiscal.taf.financialintegration

Static __oQueryV14 := Nil  as object


/*/{Protheus.doc} GravaT003
@type			Function
@description	Função para gravar os registros Cadastro de Participante
@author			Pâmela Bernardo
@since			17/03/2025
@version		1.0
/*/
Function GravaT003(jRetornoT003 as json, aDadosLog as array, cAliasTemp as character) as logical
	Local lGravadados := .T. as Logical
	Local lNovaV14 := .T. as Logical
	Local nTotalJson  := 0 as Numeric
	Local nX  		  := 0 as Numeric
	Local cIE		  := "" as character
	Local cInsMunicipal:= "" as character
	Local cCNPJ		  := "" as character
	Local cOrigem	  := "" as Character
	Local cIdC1H	  := "" as character
	Local cCodigoParticipante	  := "" as character
	Local aCampos := {} as array
		
	If Valtype(jRetornoT003) == "J" .And. Valtype(jRetornoT003["T003"]) == "A"
		nTotalJson :=Len(jRetornoT003["T003"])
		For nX:=1 to nTotalJson
			aCampos := {}
			If lGravadados
				cIE :=  AllTrim(SPEDConType(SPEDVldIE(jRetornoT003["T003"][nX]["IE"],, .F.)))
				cInsMunicipal := AllTrim(SPEDConType(SPEDVldIE(jRetornoT003["T003"][nX]["INSCR_MUNICIPAL"],, .F.)))
				If !Empty(AllTrim(jRetornoT003["T003"][nX]["CNPJ"] ))
					cCNPJ := AllTrim(jRetornoT003["T003"][nX]["CNPJ"] )
				ElseIf !Empty(AllTrim(jRetornoT003["T003"][nX]["CPF"] ))
					cCNPJ := AllTrim(jRetornoT003["T003"][nX]["CPF"] )
				EndIf
				If SubStr(jRetornoT003["T003"][nX]["COD_PART"], 1, 1) == "F"
					cOrigem := "SA2"
				Else 
					cOrigem := "SA1"
				EndIf

				aAdd(aCampos, cIdC1H) //1
				aAdd(aCampos, cCodigoParticipante) //2
				aAdd(aCampos, cIE) // 3
				aAdd(aCampos, cCNPJ) //4
				aAdd(aCampos, cInsMunicipal) //5
				aAdd(aCampos, AllTrim(jRetornoT003["T003"][nX]["CEP"]))//6
				aAdd(aCampos, AllTrim(jRetornoT003["T003"][nX]["UF"]))//7
				aAdd(aCampos, cOrigem)//8
				aAdd(aCampos, AllTrim(jRetornoT003["T003"][nX]["NOME"]))//9
				aAdd(aCampos, AllTrim(jRetornoT003["T003"][nX]["LOGRAD_EXT"]))//10
				aAdd(aCampos, AllTrim(jRetornoT003["T003"][nX]["TP_PESSOA"]))//11
				aAdd(aCampos, AllTrim(jRetornoT003["T003"][nX]["COD_MUN"]))//12
				aAdd(aCampos, AllTrim(jRetornoT003["T003"][nX]["NR_LOGRAD_EXT"]))//13
				aAdd(aCampos, AllTrim(jRetornoT003["T003"][nX]["COMPLEM_EXT"]))//14
				aAdd(aCampos, AllTrim(jRetornoT003["T003"][nX]["BAIRRO_EXT"]))//15
				aAdd(aCampos, AllTrim(jRetornoT003["T003"][nX]["COD_PAIS_EXT"]))//16
				aAdd(aCampos, AllTrim(jRetornoT003["T003"][nX]["NIF"]))//17
				aAdd(aCampos, AllTrim(jRetornoT003["T003"][nX]["COD_PART"]))//18
				
				lGravadados := ValidaDadosParticipante (aCampos,aDadosLog,cAliasTemp)
									
				If lGravadados .And. LockByName( AllTrim(cCNPJ), .T., .T. )
					lNovaV14:= ValidaV14(@aCampos)
					GravaV14(aCampos, lNovaV14)
					lGravadados := AtuPartic(.T., (cAliasTemp)->TMP_FILORI)
					If lNovaV14
						If !lGravadados
							RollBackSX8('C1H')
						Else
							ConfirmSX8('C1H')
						EndIf
					EndIf
				EndIf
			EndIf
		Next nX
	EndIf
Return lGravadados

/*/{Protheus.doc} GravaV14
@type			Function
@description	Função para gravar os registros na tabela V14
@author			Pâmela Bernardo
@since			17/03/2025
@version		1.0
/*/
Static Function GravaV14(aCampos as array, lNovaV14 as logical)

	RecLock("V14",lNovaV14)
		V14->V14_FILIAL := xFilial("V14")
		V14->V14_IDC1H  := aCampos[1]
		V14->V14_CODPAR := aCampos[2]
		V14->V14_IE     := aCampos[3]
		V14->V14_CNPJ   := aCampos[4]
		V14->V14_INSCMU := aCampos[5]
		V14->V14_CEP    := aCampos[6]
		V14->V14_UF   	:= aCampos[7]
		V14->V14_ORIG   := aCampos[8]
		V14->V14_INTEGR := "1"
		V14->V14_NOME   := aCampos[9]
		V14->V14_LOGEXT := aCampos[10]
		V14->V14_CODMUN := aCampos[12]
		V14->V14_NUMEXT := aCampos[13]
		V14->V14_COMEXT := aCampos[14]
		V14->V14_BAIEXT := aCampos[15]
		V14->V14_PAISEX := aCampos[16]
		V14->V14_NIF   	:= aCampos[17]
		If Len(aCampos) > 17
			V14->V14_CODFIN	:= aCampos[18]
		EndIf
	V14->(MsUnLock())

Return

/*/{Protheus.doc} ValidaV14
@type			Function
@description	Função que define se deverá ou não Gravar V14
@author			Pâmela Bernardo
@since			17/03/2025
@version		1.0
/*/
Function ValidaV14(aCampos as array ) as Logical

	Local lGravaV14   := .F. as Logical
	Local lNovaV14 	  := .T. as Logical
	Local iCNPJ		  := GetSX3Cache("V14_CNPJ"		, "X3_TAMANHO") as integer
	Local iIE		  := GetSX3Cache("V14_IE"		, "X3_TAMANHO") as integer
	Local iINSCM	  := GetSX3Cache("V14_INSCMU"	, "X3_TAMANHO") as integer
	Local iCODMUN	  := GetSX3Cache("V14_CODMUN"	, "X3_TAMANHO") as integer
	Local iCEP		  := GetSX3Cache("V14_CEP"		, "X3_TAMANHO") as integer
	Local iESTADO	  := GetSX3Cache("V14_UF"		, "X3_TAMANHO") as integer
	Local iCODPAR	  := GetSX3Cache("V14_CODPAR"	, "X3_TAMANHO") as integer
	
	If aCampos[11] == '3' //Fornecedor Estrangeiro
		lNovaV14 := !VerificaV14(aCampos)
		lGravaV14 := lNovaV14
	Else
		DbSelectArea("V14")
		V14->(DbSetOrder(1))
		If V14->(MsSeek(xFilial('V14') + PadR(aCampos[4], iCNPJ) + PadR(aCampos[3], iIE) + PadR(aCampos[5], iINSCM) + PadR(aCampos[12], iCODMUN) + PadR(aCampos[6], iCEP) + PadR(aCampos[7], iESTADO)))
			aCampos[1]  := V14->V14_IDC1H
			aCampos[2]  := V14->V14_CODPAR
			lNovaV14 	:= .F.
		EndIf
		lGravaV14 := !V14->(MsSeek(xFilial('V14') + PadR(aCampos[4], iCNPJ) + PadR(aCampos[3], iIE) + PadR(aCampos[5], iINSCM) + PadR(aCampos[12], iCODMUN) + PadR(aCampos[6], iCEP) + PadR(aCampos[7], iESTADO)+aCampos[8]))
	EndIf

	If lNovaV14
		If lGravaV14
			aCampos[1]  := FWUUIDv4(.T.)
			aCampos[2] 	:= Right(GetSX8Num("C1H", "C1H_CODPAR"), iCODPAR)
		EndIf
	EndIf

Return lGravaV14

/*/{Protheus.doc} VerificaV14
@type			Function
@description	Função que verifica se existe o fornecedor extrangeiro na tabela C1H
@author			Pâmela Bernardo
@since			17/03/2025
@version		1.0
/*/
Static Function VerificaV14 (aCampos as array) as Logical
	Local lExisteV14 := .T. as Logical
	Local iNIF		 := GetSX3Cache("V14_NIF"		, "X3_TAMANHO") as integer
	Local iPAISEX	 := GetSX3Cache("V14_PAISEX"	, "X3_TAMANHO") as integer
	Local iNOME		 := GetSX3Cache("V14_NOME"		, "X3_TAMANHO") as integer
	Local iBAIEXT	 := GetSX3Cache("V14_BAIEXT"	, "X3_TAMANHO") as integer
	Local iCOMEXT	 := GetSX3Cache("V14_COMEXT"	, "X3_TAMANHO") as integer
	Local iLOGEXT	 := GetSX3Cache("V14_LOGEXT"	, "X3_TAMANHO") as integer
	Local iNUMEXT	 := GetSX3Cache("V14_NUMEXT"	, "X3_TAMANHO") as integer
	Local cQuery 	 := "" as Character
	Local cChaveV14	 := "" as Character
	Local nOrder	 := 4  as Numeric
	Local iCont		 := 1   as integer
		
	If !Empty(aCampos[17])
		cChaveV14 := PadR(aCampos[17], iNIF)+aCampos[8]
		nOrder := 4
	Else
		If __oQueryV14 == Nil
			cQuery:= "SELECT V14.V14_IDC1H "
			cQuery+= " FROM ? V14 "
			cQuery+= " WHERE V14.V14_FILIAL = ? AND "
			cQuery+= " V14.V14_PAISEX = ? AND V14.V14_NOME = ? AND "
			cQuery+= " V14.V14_BAIEXT = ? AND V14.V14_COMEXT = ? AND "
			cQuery+= " V14.V14_LOGEXT = ? AND V14.V14_NUMEXT = ? AND "
			cQuery += " V14.V14_ORIG = ?  AND V14.D_E_L_E_T_ =  ? "
			cQuery := ChangeQuery(cQuery)
			__oQueryV14 := FwExecStatement():New(cQuery)
		EndIf

		If __oQueryV14 != Nil
			__oQueryV14:setUnSafe(iCont++, RetSQLName("V14"))
			__oQueryV14:setString(iCont++, xFilial('V14') )
			__oQueryV14:setString(iCont++, PadR(aCampos[16], iPAISEX)  )
			__oQueryV14:setString(iCont++, PadR(aCampos[9],  iNOME)  )
			__oQueryV14:setString(iCont++, PadR(aCampos[15], iBAIEXT)  )
			__oQueryV14:setString(iCont++, PadR(aCampos[14], iCOMEXT)  )
			__oQueryV14:setString(iCont++, PadR(aCampos[10], iLOGEXT)  )
			__oQueryV14:setString(iCont++, PadR(aCampos[13], iNUMEXT)  )
			__oQueryV14:setString(iCont++, aCampos[8]  )
			__oQueryV14:setString(iCont++, " " )

			 cChaveV14 := __oQueryV14:execScalar("V14_IDC1H")

			 If !Empty(cChaveV14)
			 	lExisteV14:= .T.
				nOrder := 2
			 EndIf
		EndIf
	EndIf

	If lExisteV14
		DbSelectArea("V14")
		V14->(DbSetOrder(nOrder))
		If V14->(MsSeek(xFilial('V14') + cChaveV14))
			aCampos[1]  := V14->V14_IDC1H
			aCampos[2]  := V14->V14_CODPAR
		Else
			lExisteV14 := .F.
		EndIf	
	EndIf

Return lExisteV14


/*/{Protheus.doc} ValidaDadosParticipante
@type			Function
@description	Função para validar os dados de participantes enviado no JSON
@author			Pâmela Bernardo
@since			17/03/2025
@version		1.0
/*/
Function ValidaDadosParticipante (aCampos as array,aDadosLog as array,cAliasTemp as character, cLog as Character ) as Logical
	Local lParticipante := .T. as logical
	
	Default cLog := "" 
	Default aDadosLog := {}
	Default cAliasTemp := ""


	If aCampos[11] != "3"
		Do Case
			Case Empty(aCampos[12])
				lParticipante := .F.
				cLog := STR0009 //"Não identificamos o codigo do Municipio do participante (C1H_CODMUN), por favor revise o cadastro."
			Case Empty(aCampos[4])
				lParticipante := .F.
				cLog := STR0011 //"Não identificamos o CPF/CNPJ, por favor revise o cadastro."
			Case Empty(aCampos[6])
				lParticipante := .F.
				cLog := STR0012 //"Não identificamos o CEP, por favor revise o cadastro."
		EndCase

	Else
		Do Case
			Case Empty(aCampos[10])
				lParticipante := .F.
				cLog := STR0013 //"Não identificamos o Logradouro do fornecedor estrangeiro, por favor revise o cadastro."
			Case Empty(aCampos[15])
				lParticipante := .F.
				cLog := STR0014 //"Não identificamos o Bairro do fornecedor estrangeiro, por favor revise o cadastro."
			Case Empty(aCampos[16])
				lParticipante := .F.
				cLog := STR0015 //"Não identificamos o Codigo do país do fornecedor estrangeiro, por favor revise o cadastro."
		EndCase
	EndIf

	If !lParticipante .And. !Empty(cAliasTemp)
		aDadosLog := {(cAliasTemp)->TMP_MOVORI, (cAliasTemp)->TMP_ID, FwX2Nome('C1H'), cLog, .T., '' }
		TAFConout(cLog,,, STR0002)
	EndIf

Return lParticipante
