Function Matr070()

Local cReport	:= "MATR070"   //Nome do Programa
Local cAlias	:= "SA6"	   //Alias da tabela
Local cTitle	:= STR0010     //"Listagem de Bancos"
Local cDesc		:= STR0011     //"Este relatório apresenta uma relação dos Bancos cadastrados."
Local lInd		:= .T.		   //Retorna Indice SIX

	//Validação de aviso/bloqueio do relatório em Release 12.1.2510 e superiores
	if ExistFunc("VldDescRel")
		if !VldDescRel()
			Return
		endIf
	endIf

	MPReport(cReport,cAlias,cTitle,cDesc,,lInd)	

Return
