Static Function ReTMemoAIB()

Local aStru := FWFormStruct(3,"AIB")[1]
Local nX
Local lRet	:= .F.

// Retorno da FWFormStruct = 3
//[01][03] ExpC:idField
//[01][04] ExpC:Tipo
//[01][14] ExpL:Campo virtual?

For nX := 1 To Len(aStru)
	If aStru[nX][4] == "M" .And. !(aStru[nX][14])
		lRet := .T.
	EndIf
Next nX

Return lRet
