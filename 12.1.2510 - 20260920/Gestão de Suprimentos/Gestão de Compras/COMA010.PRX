/*/
Function Com010Data()

Local lRet := .T.

If !Empty( M->AIA_DATDE ) .And. !Empty( M->AIA_DATATE ) .And. ( M->AIA_DATDE > M->AIA_DATATE )
	Help(" ",1,"DATA2INVAL")
	lRet := .F.
Endif

Return(lRet)

/*/
ÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜ
