@return character, descrição da tool
@author Bruno Costa
@since  17/08/2026
@version 1.0
/*/
//-------------------------------------------------------------------
method getDescription() as character class PutVacationRequest
return FwNoAccent(STR0001) //"Aprova ou reprova a solicitação de férias do funcionário." 
 
//------------------------------------------------------------------
/*/{Protheus.doc} getNotes
Informa as notas adicioanais sobre a tool

@return character, notas sobre a tool
@author Bruno Costa
@since  17/08/2026
@version 1.0
/*/
//-------------------------------------------------------------------
method getNotes() as character class PutVacationRequest
return FwNoAccent(STR0002) //"Utilize esta tool para aprovar ou reprovar as solicitações de férias."
 
//------------------------------------------------------------------
/*/{Protheus.doc} getMetrics
Retorna as métricas de uso

@return array, métricas de uso da Tool
@author Bruno Costa
@since  17/08/2026
@version 1.0
/*/
//-------------------------------------------------------------------
method getMetrics() as array class PutVacationRequest
return {}
 
//------------------------------------------------------------------
/*/{Protheus.doc} getPayLoadSchema
Retorna o schema (payload) de entrada da tool

@return jSchema, json, Schema de entrada da tool
@author Bruno Costa
@since  17/08/2026
@version 1.0
/*/
//-------------------------------------------------------------------
method getPayLoadSchema() as json class PutVacationRequest
local jSchema as json

jSchema := totvs.framework.mcp.tools.getJsonSchema()

jSchema["properties"] := { ;
    "idManager": { ;
        "type": "string" ;
    }, ;
    "justify": { ;
        "type": "string" ;
    }, ;
    "approved": { ;
        "type": "boolean" ;
    }, ;
    "requisitions": { ;
        "type": "array", ;
        "items": { ;
            "type": "object", ;
            "properties": { ;
                "id": { ;
                    "type": "string" ;
                }, ;
                "status": { ;
                    "type": "string" ;
                }, ;
                "type": { ;
                    "type": "string" ;
                }, ;
                "reason": { ;
                    "type": "string" ;
                } ;
            }, ;
            "required": { ;
                "id", ;
                "status", ;
                "type", ;
                "reason" ;
            } ;
        } ;
    } ;
}

jSchema["required"] := { ;
    "idManager", ;
    "justify", ;
    "approved", ;
    "requisitions" ;
}

return jSchema
 
//------------------------------------------------------------------
/*/{Protheus.doc} getReturnSchema
Retorna o schema (payload) de entrada da tool

@return jSchema, json, Schema de entrada da tool
@author Bruno Costa
@since  17/08/2026
@version 1.0
/*/
//-------------------------------------------------------------------
method getReturnSchema() as json class PutVacationRequest
local jSchema as json

jSchema := totvs.framework.mcp.tools.getJsonSchema()

jSchema["properties"] := { ;
    "ok":      { "type": "boolean" }, ;
    "message": { "type": "string"  }  ;
}

jSchema["required"] := { ;
    "ok", ;
    "message" ;
}

return jSchema
 
//------------------------------------------------------------------
/*/{Protheus.doc} process
Método de processamento da tool, onde será gerada a resposta

@param jPayLoad, json, Parâmetros de entrada da tool
@return jResp, json, Resposta da tool
@author Bruno Costa
@since  17/08/2026
@version 1.0
/*/
//-------------------------------------------------------------------
method process(jPayLoad as json) as json class PutVacationRequest
local jResp as json
local jReq as json
local aRequired as array
local akeyGestor as array
local aId as array
local aReqRequired as array
local aRequisitions as array
local cBody as character
local cProperty as character
local cRestFault as character
local cCodigo as character
local cKeyId as character
local lApproved as logical
local nI as numeric
local nJ as numeric

Static oStatement as object

jResp := JsonObject():new()

aRequired := { ;
        "idManager", ;
        "justify", ;
        "approved", ;
        "requisitions" ;
    }

For nI := 1 To Len(aRequired)
    cProperty := aRequired[nI]
    If !jPayLoad:hasProperty(cProperty)
        jResp["ok"]      := .F.
        jResp["message"] := EncodeUTF8(STR0003) + cProperty //"Propriedade obrigatória não informada: "
        Return jResp
    EndIf
Next nI

aRequisitions := jPayLoad["requisitions"]

If Len(aRequisitions) == 0
    jResp["ok"]      := .F.
    jResp["message"] := EncodeUTF8(STR0004) //"Nenhuma requisição foi informada."
    Return jResp
EndIf

aReqRequired := { ;
        "id", ;
        "status", ;
        "type", ;
        "reason" ;
    }

For nI := 1 To Len(aRequisitions)
    jReq := aRequisitions[nI]
    For nJ := 1 To Len(aReqRequired)
        cProperty := aReqRequired[nJ]
        If !jReq:hasProperty(cProperty)
            jResp["ok"]      := .F.
            jResp["message"] := EncodeUTF8(STR0005) + cValToChar(nI) + ": " + cProperty //"Propriedade obrigatória não informada na requisição " 
            Return jResp
        EndIf
    Next nJ
Next nI

lApproved := jPayLoad["approved"]

If !lApproved
    If Empty(AllTrim(jPayLoad["justify"]))
        jResp["ok"]      := .F.
        jResp["message"] := EncodeUTF8(STR0006) //"A justificativa deve ser informada quando a solicitação for rejeitada."
        Return jResp
    EndIf

    For nI := 1 To Len(aRequisitions)
        jReq := aRequisitions[nI]
        If Empty(AllTrim(jReq["reason"]))
            jResp["ok"]      := .F.
            jResp["message"] := EncodeUTF8(STR0007) + jReq["id"] + EncodeUTF8(STR0008) //"O motivo deve ser informado para a requisição XX quando a solicitação for rejeitada." 
            Return jResp
        EndIf
    Next nI
EndIf

If oStatement == Nil 
    oStatement := self:prepReqStmt()
EndIf 

akeyGestor := StrTokArr(jPayLoad["idManager"], "|")

For nI := 1 To Len(aRequisitions)
    aId     := StrTokArr(aRequisitions[nI]["id"], "|")
    cCodigo := self:getCodReq(aId, akeyGestor, oStatement)
    
    If Empty(cCodigo)
        jResp["ok"]      := .F.
        jResp["message"] := EncodeUTF8(STR0011) + aRequisitions[nI]["id"] //"Não foi encontrada uma solicitação de férias correspondente ao id: " 
        Return jResp
    EndIf

    aRequisitions[nI]["id"] := ;
        aId[1]  + "|" + ;
        aId[2]  + "|" + ;
        aId[3]  + "|" + ;
        cCodigo + "|" + ;
        aId[5]

Next nI

jPayLoad["requisitions"] := aRequisitions

cKeyId     := akeyGestor[3] + "|." + "|." + "|." + "|" + akeyGestor[2] 
cBody      := jPayLoad:ToJson()
cRestFault := fAvalAprRepr("cToken", cBody, Encode64(cKeyId), .F.)

jResp["ok"]      := Empty(cRestFault)
jResp["message"] := If(!Empty(cRestFault), EncodeUTF8(cRestFault), If(lApproved, EncodeUTF8(STR0009), EncodeUTF8(STR0010))) //"Solicitação de férias aprovada/reprovada com sucesso."

Return jResp

//------------------------------------------------------------------
/*/{Protheus.doc} prepReqStmt
Método para preparar a consulta de busca do código da solicitação de férias

@return oStFer, object, Statement preparado para execução
@author Bruno Costa
@since  18/08/2026
@version 1.0
/*/
//-------------------------------------------------------------------
method prepReqStmt() as object class PutVacationRequest
local cQuery as character

cQuery := " SELECT RH3.RH3_CODIGO "
cQuery += " FROM " + RetSqlName("RH3") + " RH3 "
cQuery += " WHERE RH3.RH3_FILIAL = ? "
cQuery += "   AND RH3.RH3_MAT    = ? "
cQuery += "   AND RH3.RH3_TIPO   = ? "
cQuery += "   AND RH3.RH3_EMPAPR = ? "
cQuery += "   AND RH3.RH3_FILAPR = ? "
cQuery += "   AND RH3.RH3_MATAPR = ? "
cQuery += "   AND RH3.RH3_STATUS = ? "
cQuery += "   AND RH3.D_E_L_E_T_ = ? "

cQuery += " AND EXISTS ( "
cQuery += "     SELECT 1 "
cQuery += "     FROM " + RetSqlName("RH4") + " RH4 "
cQuery += "     WHERE RH4.RH4_FILIAL = RH3.RH3_FILIAL "
cQuery += "       AND RH4.RH4_CODIGO = RH3.RH3_CODIGO "
cQuery += "       AND RTRIM(RH4.RH4_CAMPO) = 'R8_DATAINI' "
cQuery += "       AND RTRIM(RH4.RH4_VALNOV) = ? "
cQuery += "       AND RH4.D_E_L_E_T_ = ? "
cQuery += " ) "

cQuery += " AND EXISTS ( "
cQuery += "     SELECT 1 "
cQuery += "     FROM " + RetSqlName("RH4") + " RH4 "
cQuery += "     WHERE RH4.RH4_FILIAL = RH3.RH3_FILIAL "
cQuery += "       AND RH4.RH4_CODIGO = RH3.RH3_CODIGO "
cQuery += "       AND RTRIM(RH4.RH4_CAMPO) = 'RF_DATABAS' "
cQuery += "       AND RTRIM(RH4.RH4_VALNOV) = ? "
cQuery += "       AND RH4.D_E_L_E_T_ = ? "
cQuery += " ) "

cQuery := ChangeQuery(cQuery)

Return FWExecStatement():New(cQuery)

//------------------------------------------------------------------
/*/{Protheus.doc} getCodReq
Método para buscar o código da solicitação de férias

@param aId, array, Array com os dados da requisição
@param aManager, array, Array com os dados do gestor
@param oStatement, object, Statement preparado para execução
@return cCodigo, character, Código da solicitação de férias
@author Bruno Costa
@since  18/08/2026
/*/
//-------------------------------------------------------------------
method getCodReq(aId as array, aManager as array, oStatement as object) as character class PutVacationRequest
local cAlias as character
local cCodigo as character

//RH3
oStatement:SetString(1, aId[2])      // RH3_FILIAL
oStatement:SetString(2, aId[3])      // RH3_MAT
oStatement:SetString(3, "B")         // RH3_TIPO
oStatement:SetString(4, aManager[1]) // RH3_EMPAPR
oStatement:SetString(5, aManager[2]) // RH3_FILAPR
oStatement:SetString(6, aManager[3]) // RH3_MATAPR
oStatement:SetString(7, "1")         // RH3_STATUS
oStatement:SetString(8, " ")         // RH3.D_E_L_E_T_

//RH4
oStatement:SetString(9, Format8601(.T., aId[4]))  // RH4_CAMPO = R8_DATAINI
oStatement:SetString(10, " ")                     // RH4.D_E_L_E_T_
oStatement:SetString(11, Format8601(.T., aId[5])) // RH4_CAMPO = RF_DATABAS
oStatement:SetString(12, " ")                     // RH4.D_E_L_E_T_

cAlias := oStatement:OpenAlias()

If !(cAlias)->(Eof())
    cCodigo := (cAlias)->RH3_CODIGO
EndIf

(cAlias)->(DbCloseArea())

Return cCodigo
