#include "fwmcptool.th"
#include "tlpp-core.th"
#include "totvs.ch"
#include "protheus.sigagpe.putvacationrequest.put.ch"

namespace totvs.tools.sigagpe

//------------------------------------------------------------------
/*/{Protheus.doc} PutVacationRequest
Tool para Aprovar/reprovar solicitações de férias
 
@author Bruno Costa
@since  17/08/2026
@version 1.0
/*/
//-------------------------------------------------------------------
@FWToolMCP(action="put", erpRelease="12.1.2610", routine="GPEM030", option=2, module="SIGAGPE")
class PutVacationRequest implements FWMCPTool
	public method new() as object
	public method getDescription() as character
	public method getNotes() as character
	public method getPayLoadSchema() as json
	public method getReturnSchema() as json
	public method process(jPayLoad as json) as json
    public method getMetrics() as array 
    private method prepReqStmt() as object
    private method getCodReq() as character
endclass

//------------------------------------------------------------------
/*/{Protheus.doc} new
Construtor da classe

@author Bruno Costa
@since  17/08/2026
@version 1.0
/*/
//-------------------------------------------------------------------
method new() as object class PutVacationRequest
return self
 
