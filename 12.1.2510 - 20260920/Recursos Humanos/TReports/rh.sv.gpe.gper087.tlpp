//-------------------------------------------------------------------------------------------------
/*/{Protheus.doc}
    @Author    lidio.oliveira
    @Date      28/01/2026
    @Type      Static Function
    Função filtrar os registros da tabela RJE de acordo com os parâmetros informados
/*/
//-------------------------------------------------------------------------------------------------
Static Function fQryRJE(oQryTMP, cEvento, cInscrDe, cInscrAte, cCPFDe, cCPFAte, cAnoBase, cFiltro)

    Local cQuery        As Character
	Local cAliasReg     As Character
    Local nParamOrder   As Numeric

    Default oQryTMP    := Nil
	Default cEvento    := "S5002"
    Default cInscrDe   := ""
    Default cInscrAte  := "ZZZZZZZZZZZZZZ"
    Default cCPFDe     := ""
    Default cCPFAte    := "ZZZZZZZZZZZ"
    Default cAnoBase   := ""
    Default cFiltro    := ""

    cQuery        := ""
	cAliasReg     := GetNextAlias()
    nParamOrder   := 1

    If oQryTMP == Nil
        cQuery := "SELECT RJE.RJE_FIL, RJE.RJE_TPINSC, RJE.RJE_INSCR, RJE.RJE_EVENTO, RJE.RJE_INI, RJE_KEY, SUBSTRING(RJE_KEY, 8, 11) AS CPF, RJE.R_E_C_N_O_ "
        cQuery += "FROM " + RetSqlName('RJE') + " RJE "
        cQuery += "WHERE RJE.RJE_EVENTO = ? "                                   //cEvento
        cQuery +=   "AND SUBSTRING(RJE.RJE_INI, 1, 4) = ? "                     //cAnoBase
        cQuery +=	"AND RJE.RJE_INSCR BETWEEN ? AND ? "                        //cInscrDe e cInscrAte
        cQuery += 	"AND SUBSTRING(RJE.RJE_KEY, 8, 11) BETWEEN ? AND ? "        //cCPFDe e cCPFAte
        cQuery +=	"AND RJE.RJE_STATUS = ? "
        cQuery +=	"AND RJE.RJE_EXC = ? "
        cQuery += 	"AND RJE.D_E_L_E_T_ = ? "
        cQuery +=   " ? " 
        cQuery += "ORDER BY RJE_INSCR, SUBSTRING(RJE_KEY, 8, 11), SUBSTRING(RJE_KEY, 1, 7)"

        cQuery := ChangeQuery(cQuery)
        oQryTMP := FwExecStatement():New(cQuery)
    EndIf
    oQryTMP:SetString(nParamOrder++, cEvento)
    oQryTMP:SetString(nParamOrder++, cAnoBase) 
    oQryTMP:SetString(nParamOrder++, cInscrDe)
    oQryTMP:SetString(nParamOrder++, cInscrAte)
    oQryTMP:SetString(nParamOrder++, cCPFDe)
    oQryTMP:SetString(nParamOrder++, cCPFAte)
    oQryTMP:SetString(nParamOrder++, "4")             //RJE_STATIS
    oQryTMP:SetString(nParamOrder++, " ")             //RJE_EXC
    oQryTMP:SetString(nParamOrder++, " ")             //D_E_L_E_T_

    oQryTMP:SetUnsafe(nParamOrder++, cFiltro) 

    // Executa a query e retorna o alias criado
    cAliasReg := oQryTMP:OpenAlias()

Return cAliasReg


//-------------------------------------------------------------------------------------------------
/*/{Protheus.doc}
    @Author    lidio.oliveira
    @Date      28/01/2026
    @Type      Static Function
    Função filtrar os registros da tabela T2G de acordo com os parâmetros informados
/*/
//-------------------------------------------------------------------------------------------------
Static Function fQryT2G(oQryTMP, aFiliais, cCPFDe, cCPFAte, cAnoBase, cFiltro, lFiltraFil)

    Local cQuery        As Character
	Local cAliasReg     As Character
    Local nParamOrder   As Numeric

    Default oQryTMP    := Nil
    Default aFiliais   := {}
    Default cCPFDe     := ""
    Default cCPFAte    := "ZZZZZZZZZZZ"
    Default cAnoBase   := ""
    Default cFiltro    := ""
    Default lFiltraFil := .F.

    cQuery        := ""
	cAliasReg     := GetNextAlias()
    nParamOrder   := 1

    If oQryTMP == Nil
        cQuery := "SELECT T2G_FILIAL, T2G_CPFBEN, T2G_PERAPU, R_E_C_N_O_ "
        cQuery += "FROM " + RetSqlName('T2G') + " T2G "
        cQuery += "WHERE SUBSTRING(T2G.T2G_PERAPU, 1, 4) = ? "                  //cAnoBase
		cQuery += 	"AND T2G.T2G_CPFBEN BETWEEN ? AND ? "                       //cCPFDe e cCPFAte
        cQuery += "AND T2G.T2G_ATIVO = ? "                                      //1
        If lFiltraFil
            cQuery += "AND T2G.T2G_FILIAL IN (?) "                                 //aFiliais
        EndIf
        cQuery += "AND T2G.D_E_L_E_T_ = ? "
        cQuery += " ? "  
        cQuery += "ORDER BY T2G.T2G_FILIAL, T2G.T2G_CPFBEN, T2G.T2G_PERAPU"

        cQuery := ChangeQuery(cQuery)
        oQryTMP := FwExecStatement():New(cQuery)
    EndIf

    oQryTMP:SetString(nParamOrder++, cAnoBase) 
    oQryTMP:SetString(nParamOrder++, cCPFDe)
    oQryTMP:SetString(nParamOrder++, cCPFAte)
    oQryTMP:SetString(nParamOrder++, "1")             //T2G.T2G_ATIVO
    If lFiltraFil
        oQryTMP:SetIN(nParamOrder++, aFiliais)        //aFiliais
    EndIf
    oQryTMP:SetString(nParamOrder++, " ")             //D_E_L_E_T_

    oQryTMP:SetUnsafe(nParamOrder++, cFiltro) 

    // Executa a query e retorna o alias criado
    cAliasReg := oQryTMP:OpenAlias()

Return cAliasReg


