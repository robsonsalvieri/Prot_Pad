    Local aPenAlim      As Array
    Local aInfoBenef    As Array
    Local aPreviComp    As Array
    Local aInfoPC       As Array
    Local aPlanSaude    As Array
    Local aInfoPS       As Array
    Local jPlanSaude    As Array
    Local aInfoOPPS     As Array
    Local aInfoRM       As Array
    Local aInfoOPRM     As Array
    Local aIfBenefRM    As Array
    Local aDadosRM      As Array
    Local aReembMed     As Array
    Local aConApurMen   As Array
    Local aItApurMen    As Array
    Local lParseXML     As Logical
    Local cPerApur      As Character
    Local cMes          As Character
    Local cCabec        As Character
    Local cConApurMen   As Character 
    Local cCRMen        As Character
    Local cinfoIRCR     As Character
    Local cTpCR         As Character
    Local cdedDepen     As Character
    Local cpenAlim      As Character
    Local cprevidCompl  As Character
    Local cplanSaude    As Character
    Local cinfoDepSau   As Character
    Local cCNPJOpPS     As Character
    Local cRegANSPS     As Character
    Local cReembMed     As Character
    Local cCNPJOpRM     As Character
    Local cindOrgRM     As Character
    Local cRegANSRM     As Character
    Local cdetReembTit  As Character
    Local cinfoReembDep As Character
    Local cCPFDepRM     As Character
    Local cNOMEDepRM    As Character
    Local cdetReembDep  As Character
    Local nPosItem      As Numeric
    Local nPosCodRec    As Numeric
    Local nPosDep       As Numeric
    Local nConApurMen   As Numeric
    Local ninfoIRCR     As Numeric
    Local ndedDepen     As Numeric
    Local npenAlim      As Numeric
    Local nPosPA        As Numeric  
    Local nprevidCompl  As Numeric
    Local nPosPc        As Numeric
    Local nplanSaude    As Numeric
    Local nPosPS        As Numeric
    Local ninfoDepSau   As Numeric
    Local nReembMed     As Numeric
    Local ndetReembTit  As Numeric
    Local ninfoReembDep As Numeric
    Local ndetReembDep  As Numeric
    Local nPosBenefRM   As Numeric
    Local nX            As Numeric
    Local nPosApurMen   As Numeric
    Local nPosOPRM      As Numeric
    
    Default cXMLRet     := ""
    Default aItem       := {}
    Default cCodRec     := ""

    //Inicialização de variáveis
    oXml 			:= tXmlManager():New()
    jItem           := JsonObject():New()
    jValCR          := JsonObject():New()
    jInfoDep        := JsonObject():New()
    jInfoBenef      := JsonObject():New()
    jInfoPC         := JsonObject():New()
    jInfoPS         := JsonObject():New()
    jPlanSaude      := JsonObject():New()
    jInfoRM         := JsonObject():New()
    jIfBenefRM      := JsonObject():New()
    lParseXML       := oXml:Parse(fMidTrPath(cXMLRet,"eSocial"))
    aJitem          := {}
    aValCR          := {}
    aCodRecs        := {}
    aTotApurMen     := {}
    aDedDepen       := {}
    aInfoDep        := {}
    aItemDedDep     := {}
    aPenAlim        := {}
    aInfoBenef      := {}
    aPreviComp      := {}
    aInfoPC         := {}
    aPlanSaude      := {}
    aInfoPS         := {}
    aInfoOPPS       := {}
    aInfoRM         := {}
    aInfoOPRM       := {}
    aIfBenefRM      := {}
    aDadosRM        := {}
    aReembMed       := {}
    aConApurMen     := {}
    aItApurMen      := {}
    cCabec          := "/eSocial/evtIrrfBenef/"
    cPerApur        := ""
    cMes            := ""
    cCRMen          := ""
    cConApurMen     := ""
    cinfoIRCR       := ""
    cTpCR           := ""
    cdedDepen       := ""
    cpenAlim        := ""
    cprevidCompl    := ""
    cplanSaude      := ""
    cinfoDepSau     := ""
    cCNPJOpPS       := ""
    cRegANSPS       := ""
    cReembMed       := ""
    cCNPJOpRM       := ""
    cindOrgRM       := ""
    cRegANSRM       := ""
    cdetReembTit    := ""
    cinfoReembDep   := ""
    cCPFDepRM       := ""
    cNOMEDepRM      := ""
    cdetReembDep    := ""
    nPosItem        := 0
    nPosCodRec      := 0
    nPosDep         := 0
    nConApurMen     := 0
    ninfoIRCR       := 0
    ndedDepen       := 0
    npenAlim        := 0
    nPosPA          := 0
    nprevidCompl    := 0
    nPosPc          := 0
    nplanSaude      := 0
    nPosPS          := 0
    ninfoDepSau     := 0
    nReembMed       := 0
    ndetReembTit    := 0
    ninfoReembDep   := 0
    ndetReembDep    := 0
    nPosBenefRM     := 0
    nX              := 0
    nPosApurMen     := 0
    nPosOPRM        := 0

    If lParseXML
        cPerApur := StrTran(oXml:XPathGetNodeValue(cCabec + "ideEvento/perApur"), "-", "")
        cMes     := Lower(MesExtenso(Val(Substr(cPerApur, 5, 2))))

        //Carrega jItem para atualizar o mes de processamento
        If Len(aItem) > 0
            nPosItem := aScan(aItem, {|x| x["nrInsc"] + x["cpf"] == cCNPJEmp + cCPFTrab})
            If nPosItem > 0
                jItem       := aClone(aItem)[nPosItem]
                aCodRecs    := aClone(jItem["codRecs"])
            EndIf
        EndIf

        //Cria o item
        If !jItem:HasProperty("nrInsc") .Or. (jItem["nrInsc"] +  jItem["cpf"] <> cCNPJEmp + cCPFTrab)
            jItem["nrInsc"]         := cCNPJEmp
            jItem["nomePag"]        := cNomeEmp
            jItem["cpf"]            := cCPFTrab
            jItem["nomeFunc"]       := cNomeTrab
            jItem["codRecs"]        := {}
            jItem["planSaude"]      := {}
            jItem["infoReembMed"]   := {}
        EndIf

        nConApurMen := 1
        cConApurMen := cCabec + "ideTrabalhador/totInfoIR/consolidApurMen[" + cValToChar(nConApurMen) + "]"
        While oXml:XPathHasNode(cConApurMen)
            cCRMen  := oXml:XPathGetNodeValue(cConApurMen + "/CRMen")

            //Se houver filtro de código de receita, verifica se atende ao solicitado.
            If Empty(cCodRec) .Or. cCodRec == cCRMen
                //Carrega jValCR para atualizar o mes de processamento
                If nPosItem > 0
                    nPosCodRec  := aScan(aCodRecs, {|x| x["codReceita"] == cCRMen  + " "})
                    If nPosCodRec > 0
                        jValCR := aClone(aCodRecs)[nPosCodRec]
                    EndIf
                EndIf

                //Cria o item relacionado ao código de receita
                If !jValCR:HasProperty("codReceita") .Or. jValCR["codReceita"] <> cCRMen + " "
                    jValCR["codReceita"]      := cCRMen + " "
                    jValCR["descCodReceita"]  := jDescCR[cCRMen]
                    jValCR["tpRend"]          := {}
                    jValCR["dedDepen"]        := {}
                    jValCR["penAlim"]         := {}
                    jValCR["previdCompl"]     := {}
                EndIf

                //Obtém todos os filhos de consolidApurMen (tipos de rendimento)
                iF lMiddleware
                    aTotApurMen := oXML:XPathGetChildArray(cConApurMen)
                Else
                    aConApurMen := oXML:XPathGetChildArray(cConApurMen)
                    For nX := 1 To Len(aTpsRend)
                        nPosApurMen := aScan(aConApurMen, {|x| x[1] == aTpsRend[nX]})
                        If nPosApurMen > 0
                            aAdd(aTotApurMen, aClone(aConApurMen[nPosApurMen]))
                        Else
                            aAdd(aItApurMen, aTpsRend[nX])
                            aAdd(aItApurMen, "")
                            aAdd(aItApurMen, "0")

                            aAdd(aTotApurMen, aClone(aItApurMen))

                            aItApurMen := {}
                        EndIf
                    Next nX
                EndIf

                //Retorna os dados com os tipos de rendimento   
                jValCR["tpRend"] := fGetTpRend(aTotApurMen, cMes, jValCR["tpRend"])
                aAdd(aValCR, jValCR) 

                //Adiciona para retorno
                If nPosCodRec > 0
                    aCodRecs[nPosCodRec] := aClone(aValCR)[1]
                Else
                    aAdd(aCodRecs, aClone(aValCR)[1])
                EndIf
            EndIf

            FwFreeObj(jValCR)
            aTotApurMen := {}
            aConApurMen := {}
            aValCR      := {}
            jValCR      := JsonObject():New()

            nConApurMen++
            cConApurMen := cCabec + "ideTrabalhador/totInfoIR/consolidApurMen[" + cValToChar(nConApurMen) + "]"
        EndDo

        //Varre o infoIRCR com os dados de dedução de dependente, pensão alimentícia e previdência complementar
        ninfoIRCR := 1
        cinfoIRCR := cCabec + "ideTrabalhador/infoIRComplem/infoIRCR[" + cValToChar(ninfoIRCR) + "]"
        While oXml:XPathHasNode(cinfoIRCR)
            cTpCR := oXml:XPathGetNodeValue(cinfoIRCR + "/tpCR")

            //Se houver filtro de código de receita, verifica se atende ao solicitado.
            If Empty(cCodRec) .Or. cCodRec == cTpCR
                
                //Varre o dedDepen com os dados dedução
                ndedDepen := 1
                cdedDepen := cinfoIRCR + "/dedDepen[" + cValToChar(ndedDepen) + "]"                
                While oXml:XPathHasNode(cdedDepen)
                    nPosDep     := 0
                    nPosCodRec  := 0
                    
                    //Obtém todos os filhos de dedDepen
                    aAdd(aDedDepen, oXml:XPathGetNodeValue(cdedDepen + "/tpRend"))
                    aAdd(aDedDepen, oXml:XPathGetNodeValue(cdedDepen + "/cpfDep"))
                    aAdd(aDedDepen, oXml:XPathGetNodeValue(cdedDepen + "/vlrDedDep"))

                    //Verifica se o dependente já está incluído no array de itens
                    If Len(aCodRecs) > 0
                        nPosCodRec := aScan(aCodRecs, {|x| x["codReceita"] == cTpCR  + " "})
                        //Consulta se o dependente está no array
                        If nPosCodRec > 0
                            nPosDep := aScan(aCodRecs[nPosCodRec]["dedDepen"], {|x| x["DDcpfDep"] == aDedDepen[2]}) 
                            If nPosDep > 0
                                aInfoDep := aClone(aCodRecs[nPosCodRec]["dedDepen"])
                            EndIf
                        EndIf
                    EndIf

                    //Se não localizou o código de receita cria o registro
                    If nPosCodRec == 0
                        jValCR["codReceita"]      := cTpCR + " "
                        jValCR["descCodReceita"]  := jDescCR[cTpCR]
                        jValCR["tpRend"]          := {}
                        jValCR["dedDepen"]        := {}
                        jValCR["penAlim"]         := {}
                        jValCR["previdCompl"]     := {}

                        aAdd(aValCR, jValCR) 
                        aAdd(aCodRecs, aClone(aValCR)[1])

                        nPosCodRec := Len(aCodRecs)
                        
                        FwFreeObj(jValCR)
                        aValCR := {}
                        jValCR := JsonObject():New()
                    EndIf

                    //Cria cabeçalho do dependente
                    If nPosDep == 0
                        jInfoDep["DDcpfDep"]    := aDedDepen[2]
                        jInfoDep["DDnomeDep"]   := Iif(jListDep:HasProperty(aDedDepen[2]), jListDep[aDedDepen[2]], "** Nome não encontrado **")
                        jInfoDep["DDtpRend"]    := {}

                        aAdd(aInfoDep, jInfoDep)
                        aInfoDep[Len(aInfoDep)]["DDtpRend"] := fValDedDep(aDedDepen, cMes, aInfoDep, Len(aInfoDep))

                        aAdd(aCodRecs[nPosCodRec]["dedDepen"], aClone(aInfoDep)[1])
                    Else
                        aCodRecs[nPosCodRec]["dedDepen"][nPosDep]["DDtpRend"] := fValDedDep(aDedDepen, cMes, aInfoDep, nPosDep)
                    EndIf

                    aDedDepen   := {}
                    aInfoDep    := {}

                    FwFreeObj(jInfoDep)
                    jInfoDep := JsonObject():New()

                    ndedDepen++
                    cdedDepen := cinfoIRCR + "/dedDepen[" + cValToChar(ndedDepen) + "]"          
                EndDo

                //Varre o penAlim com os dados pensão alimentícia
                npenAlim := 1
                cpenAlim := cinfoIRCR + "/penAlim[" + cValToChar(npenAlim) + "]"                
                While oXml:XPathHasNode(cpenAlim)
                    nPosPA      := 0
                    nPosCodRec  := 0
                    
                    //Obtém todos os filhos de penAlim
                    aAdd(aPenAlim, oXml:XPathGetNodeValue(cpenAlim + "/tpRend"))
                    aAdd(aPenAlim, oXml:XPathGetNodeValue(cpenAlim + "/cpfDep"))
                    aAdd(aPenAlim, oXml:XPathGetNodeValue(cpenAlim + "/vlrDedPenAlim"))

                    //Verifica se o beneficiário já está incluído no array de itens
                    If Len(aCodRecs) > 0
                        nPosCodRec := aScan(aCodRecs, {|x| x["codReceita"] == cTpCR  + " "})
                        //Consulta se o beneficiário está no array
                        If nPosCodRec > 0
                            nPosPA := aScan(aCodRecs[nPosCodRec]["penAlim"], {|x| x["PAcpfDep"] == aPenAlim[2]}) 
                            If nPosPA > 0
                                aInfoBenef := aClone(aCodRecs[nPosCodRec]["penAlim"])
                            EndIf
                        EndIf
                    EndIf

                    //Se não localizou o código de receita cria o registro
                    If nPosCodRec == 0
                        jValCR["codReceita"]      := cTpCR + " "
                        jValCR["descCodReceita"]  := jDescCR[cTpCR]
                        jValCR["tpRend"]          := {}
                        jValCR["dedDepen"]        := {}
                        jValCR["penAlim"]         := {}
                        jValCR["previdCompl"]     := {}

                        aAdd(aValCR, jValCR) 
                        aAdd(aCodRecs, aClone(aValCR)[1])

                        nPosCodRec := Len(aCodRecs)
                        
                        FwFreeObj(jValCR)
                        aValCR := {}
                        jValCR := JsonObject():New()
                    EndIf

                    //Cria cabeçalho do beneficiário
                    If nPosPA == 0
                        jInfoBenef["PAcpfDep"]    := aPenAlim[2]
                        jInfoBenef["PAnomeDep"]   := Iif(jListDep:HasProperty(aPenAlim[2]), jListDep[aPenAlim[2]], "** Nome não encontrado **")
                        jInfoBenef["PAtpRend"]    := {}

                        aAdd(aInfoBenef, jInfoBenef)
                        aInfoBenef[Len(aInfoBenef)]["PAtpRend"] := fValPensA(aPenAlim, cMes, aInfoBenef, Len(aInfoBenef))

                        aAdd(aCodRecs[nPosCodRec]["penAlim"], aClone(aInfoBenef)[1])
                    Else
                        aCodRecs[nPosCodRec]["penAlim"][nPosPA]["PAtpRend"] := fValPensA(aPenAlim, cMes, aInfoBenef, nPosPA)
                    EndIf

                    aPenAlim    := {}
                    aInfoBenef  := {}

                    FwFreeObj(jInfoBenef)
                    jInfoBenef := JsonObject():New()

                    npenAlim++
                    cpenAlim := cinfoIRCR + "/penAlim[" + cValToChar(npenAlim) + "]"          
                EndDo

                //Varre o previdCompl com os dados previdência complementar
                nprevidCompl := 1
                cprevidCompl := cinfoIRCR + "/previdCompl[" + cValToChar(nprevidCompl) + "]"                
                While oXml:XPathHasNode(cprevidCompl)
                    nPosPc      := 0
                    nPosCodRec  := 0
                    
                    //Obtém todos os filhos de previdCompl
                    aAdd(aPreviComp, oXml:XPathGetNodeValue(cprevidCompl + "/tpPrev"))
                    aAdd(aPreviComp, oXml:XPathGetNodeValue(cprevidCompl + "/cnpjEntidPC"))
                    aAdd(aPreviComp, {0, "Dedução Mensal"})                                         // vlrDedPC
                    aAdd(aPreviComp, {0, "Dedução Mensal do 13º Salário"})                          // vlrDedPC13 
                    aAdd(aPreviComp, {0, "Contribuição Mensal Servidor Público"})                   // vlrPatrocFunp
                    aAdd(aPreviComp, {0, "Contribuição Mensal Servidor Público do 13º Salário"})    // vlrPatrocFunp13

                    //Atualiza os filhos se exisitiram os nós
                    Iif(oXml:XPathHasNode(cprevidCompl + "/vlrDedPC"), aPreviComp[3][1] := Val(oXml:XPathGetNodeValue(cprevidCompl + "/vlrDedPC")),)
                    Iif(oXml:XPathHasNode(cprevidCompl + "/vlrDedPC13"), aPreviComp[4][1] := Val(oXml:XPathGetNodeValue(cprevidCompl + "/vlrDedPC13")),)
                    Iif(oXml:XPathHasNode(cprevidCompl + "/vlrPatrocFunp"), aPreviComp[5][1] := Val(oXml:XPathGetNodeValue(cprevidCompl + "/vlrPatrocFunp")),)
                    Iif(oXml:XPathHasNode(cprevidCompl + "/vlrPatrocFunp13"), aPreviComp[6][1] := Val(oXml:XPathGetNodeValue(cprevidCompl + "/vlrPatrocFunp13")),)

                    //Verifica se a entidade de previdência complementar já está incluído no array de itens
                    If Len(aCodRecs) > 0
                        nPosCodRec := aScan(aCodRecs, {|x| x["codReceita"] == cTpCR  + " "})
                        //Consulta se a entidade de previdência complementar está no array
                        If nPosCodRec > 0
                            nPosPc := aScan(aCodRecs[nPosCodRec]["previdCompl"], {|x| x["PCtpPrev"] + x["PCcnpjEntidPC"] == aPreviComp[1] + aPreviComp[2]}) 
                            If nPosPc > 0
                                aInfoPC := aClone(aCodRecs[nPosCodRec]["previdCompl"])
                            EndIf
                        EndIf
                    EndIf

                    //Se não localizou o código de receita cria o registro
                    If nPosCodRec == 0
                        jValCR["codReceita"]      := cTpCR + " "
                        jValCR["descCodReceita"]  := jDescCR[cTpCR]
                        jValCR["tpRend"]          := {}
                        jValCR["dedDepen"]        := {}
                        jValCR["penAlim"]         := {}
                        jValCR["previdCompl"]     := {}

                        aAdd(aValCR, jValCR) 
                        aAdd(aCodRecs, aClone(aValCR)[1])

                        nPosCodRec := Len(aCodRecs)
                        
                        FwFreeObj(jValCR)
                        aValCR := {}
                        jValCR := JsonObject():New()
                    EndIf

                    //Cria cabeçalho do entidade de previdência complementar
                    If nPosPc == 0
                        jInfoPC["PCtpPrev"]         := aPreviComp[1]
                        jInfoPC["PCdescPrev"]       := jDescPrevC[aPreviComp[1]]
                        jInfoPC["PCcnpjEntidPC"]    := aPreviComp[2]
                        jInfoPC["PCvaloresPrev"]    := {}

                        aAdd(aInfoPC, jInfoPC)
                        aInfoPC[Len(aInfoPC)]["PCvaloresPrev"] := fValPreviC(aPreviComp, cMes, aInfoPC, Len(aInfoPC))

                        aAdd(aCodRecs[nPosCodRec]["previdCompl"], aClone(aInfoPC)[1])
                    Else
                        aCodRecs[nPosCodRec]["previdCompl"][nPosPc]["PCvaloresPrev"] := fValPreviC(aPreviComp, cMes, aInfoPC, nPosPc)
                    EndIf

                    //Reinicia variáveis
                    aPreviComp  := {}
                    aInfoPC     := {}
                    FwFreeObj(jInfoPC)
                    jInfoPC := JsonObject():New()

                    nprevidCompl++
                    cprevidCompl := cinfoIRCR + "/previdCompl[" + cValToChar(nprevidCompl) + "]"          
                EndDo
            EndIf

            ninfoIRCR++
            cinfoIRCR := cCabec + "ideTrabalhador/infoIRComplem/infoIRCR[" + cValToChar(ninfoIRCR) + "]"
        EndDo

        //Inclui os dados que possui código de receita
        jItem["codRecs"] := aClone(aCodRecs)     

        //Varre o planSaude com os dados de plano de saúde
        nplanSaude := 1
        cplanSaude := cCabec + "ideTrabalhador/infoIRComplem/planSaude[" + cValToChar(nplanSaude) + "]"        
        While oXml:XPathHasNode(cplanSaude)           
            nPosPS      := 0
            cRegANSPS   := ""
            cCNPJOpPS   := oXml:XPathGetNodeValue(cplanSaude + "/cnpjOper")
            
            //Prenche o registroANS se houver
            If oXml:XPathHasNode(cplanSaude + "/regANS")
                cRegANSPS := oXml:XPathGetNodeValue(cplanSaude + "/regANS")  + " "
            EndIf

            //Verifica se o operador já está no jitem
            If nPosItem > 0
                nPosPS := aScan(jItem["planSaude"], {|x| x["PScnpjOper"] + x["PSregANS"] == cCNPJOpPS + cRegANSPS}) 
                If Len(jItem["planSaude"]) > 0
                    aInfoPS := aClone(jItem["planSaude"])
                EndIf
            EndIf

            //Se não houver a chave de CNPJ + Reg ANS cria objeto com cabeçalho
            If nPosPS == 0
                jInfoPS["PScnpjOper"]        := cCNPJOpPS
                jInfoPS["PSregANS"]          := cRegANSPS
                jInfoPS["PSbeneficiarios"]   := {}

                aAdd(aInfoOPPS, jInfoPS)
                aAdd(aInfoPS, aClone(aInfoOPPS)[1])
            EndIf

            //Gera o Valor para o titular
            If Val(oXml:XPathGetNodeValue(cplanSaude + "/vlrSaudeTit")) > 0
                aAdd(aPlanSaude, jItem["nomeFunc"])
                aAdd(aPlanSaude, cCPFTrab)
                aAdd(aPlanSaude, Val(oXml:XPathGetNodeValue(cplanSaude + "/vlrSaudeTit")))

                If nPosPS == 0
                    aInfoPS[Len(aInfoPS)]["PSbeneficiarios"] := fValPlanSau(aPlanSaude, cMes, aClone(aInfoPS), Len(aInfoPS))
                Else
                    aInfoPS[nPosPS]["PSbeneficiarios"] := fValPlanSau(aPlanSaude, cMes, aClone(aInfoPS), nPosPS)
                EndIf
            EndIf

            //Varre as informações dos dependentes
            ninfoDepSau := 1
            cinfoDepSau := cplanSaude + "/infoDepSau[" + cValToChar(ninfoDepSau) + "]"
            While oXml:XPathHasNode(cinfoDepSau)
                aPlanSaude  := {}

                aAdd(aPlanSaude, Iif(jListDep:HasProperty(oXml:XPathGetNodeValue(cinfoDepSau + "/cpfDep")), jListDep[oXml:XPathGetNodeValue(cinfoDepSau + "/cpfDep")], "** Nome não encontrado **"))
                aAdd(aPlanSaude, oXml:XPathGetNodeValue(cinfoDepSau + "/cpfDep"))
                aAdd(aPlanSaude, Val(oXml:XPathGetNodeValue(cinfoDepSau + "/vlrSaudeDep")))

                If nPosPS == 0
                    aInfoPS[Len(aInfoPS)]["PSbeneficiarios"] := fValPlanSau(aPlanSaude, cMes, aClone(aInfoPS), Len(aInfoPS))
                Else
                    aInfoPS[nPosPS]["PSbeneficiarios"] := fValPlanSau(aPlanSaude, cMes, aClone(aInfoPS), nPosPS)
                EndIf

                ninfoDepSau++
                cinfoDepSau := cplanSaude + "/infoDepSau[" + cValToChar(ninfoDepSau) + "]"
            EndDo

            FwFreeObj(jInfoPS)
            jInfoPS := JsonObject():New()
            
            aInfoOPPS   := {}
            aPlanSaude  := {}

            jItem["planSaude"] := aClone(aInfoPS)

            nplanSaude++
            cplanSaude := cCabec + "ideTrabalhador/infoIRComplem/planSaude[" + cValToChar(nplanSaude) + "]"             
        EndDo           

        //Varre o infoReembMed com os dados de reembolso médico
        nReembMed := 1
        cReembMed := cCabec + "ideTrabalhador/infoIRComplem/infoReembMed[" + cValToChar(nReembMed) + "]"        
        While oXml:XPathHasNode(cReembMed)           
            nPosOPRM    := 0
            cRegANSRM   := ""
            cindOrgRM   := oXml:XPathGetNodeValue(cReembMed + "/indOrgReemb") + jIndOrgRM[oXml:XPathGetNodeValue(cReembMed + "/indOrgReemb")]
            
            //Prenche o CNPJ se houver
            If oXml:XPathHasNode(cReembMed + "/cnpjOper")
                cCNPJOpRM   := oXml:XPathGetNodeValue(cReembMed + "/cnpjOper")
            EndIf

            //Prenche o registro ANS se houver
            If oXml:XPathHasNode(cReembMed + "/regANS")
                cRegANSRM := oXml:XPathGetNodeValue(cReembMed + "/regANS")  + " "
            EndIf

            //Verifica se o operador já está no jitem
            If nPosItem > 0
                nPosOPRM := aScan(jItem["infoReembMed"], {|x| x["RMcnpjOper"] + x["RMregANS"] == cCNPJOpRM + cRegANSRM}) 
                If Len(jItem["infoReembMed"]) > 0 
                    aInfoRM := aClone(jItem["infoReembMed"])
                EndIf
            EndIf

            //Se não houver a chave de CNPJ + Reg ANS cria objeto com cabeçalho
            If nPosOPRM == 0
                jInfoRM["RMcnpjOper"]        := cCNPJOpRM
                jInfoRM["RMregANS"]          := cRegANSRM
                jInfoRM["RMindOrgReemb"]     := cindOrgRM
                jInfoRM["RMbeneficiarios"]   := {}

                jIfBenefRM["RMbeneficiario"]    := ""
                jIfBenefRM["RMcpfBenef"]        := ""
                jIfBenefRM["RMprestserv"]       := {}

                aAdd(aIfBenefRM, jIfBenefRM)

                aAdd(jInfoRM["RMbeneficiarios"], aClone(aIfBenefRM)[1])

                aAdd(aInfoOPRM, jInfoRM)
                aAdd(aInfoRM, aClone(aInfoOPRM)[1])

                FwFreeObj(jIfBenefRM)
                jIfBenefRM := JsonObject():New()

                aIfBenefRM := {}
            EndIf

            //Varre as informações de reembolso do titular
            ndetReembTit := 1
            cdetReembTit := cReembMed + "/detReembTit[" + cValToChar(ndetReembTit) + "]"
            While oXml:XPathHasNode(cdetReembTit)
                aReembMed  := {}
                
                aAdd(aReembMed, cCPFTrab)
                aAdd(aReembMed, jItem["nomeFunc"])
                aAdd(aReembMed, oXml:XPathGetNodeValue(cdetReembTit + "/tpInsc")) 
                aAdd(aReembMed, oXml:XPathGetNodeValue(cdetReembTit + "/nrInsc"))
                aAdd(aReembMed, {0, "Valor Ano Atual"})
                aAdd(aReembMed, {0, "Valor Anos Anteriores"})

                Iif(oXml:XPathHasNode(cdetReembTit + "/vlrReemb"), aReembMed[5][1] := Val(oXml:XPathGetNodeValue(cdetReembTit + "/vlrReemb")),)
                Iif(oXml:XPathHasNode(cdetReembTit + "/vlrReembAnt"), aReembMed[6][1] := Val(oXml:XPathGetNodeValue(cdetReembTit + "/vlrReembAnt")),)

                //Procura o titular nos dados de beneficiários e atualiza os valores
                If nPosOPRM == 0
                    nPosBenefRM := aScan(aInfoRM[Len(aInfoRM)]["RMbeneficiarios"], {|x| x["RMcpfBenef"] == cCPFTrab}  )
                    aInfoRM[Len(aInfoRM)]["RMbeneficiarios"] := fValReembM(aReembMed, cMes, aClone(aInfoRM[Len(aInfoRM)]["RMbeneficiarios"]), nPosBenefRM)
                Else
                    nPosBenefRM := aScan(aInfoRM[nPosOPRM]["RMbeneficiarios"], {|x| x["RMcpfBenef"] == cCPFTrab}  )
                    aInfoRM[nPosOPRM]["RMbeneficiarios"] := fValReembM(aReembMed, cMes, aClone(aInfoRM[nPosOPRM]["RMbeneficiarios"]), nPosBenefRM)
                EndIf

                //Atualiza o nPosOPRM
                nPosOPRM := aScan(aInfoRM, {|x| x["RMcnpjOper"] + x["RMregANS"] == cCNPJOpRM + cRegANSRM}) 

                ndetReembTit++
                cdetReembTit := cReembMed + "/infoDepSau[" + cValToChar(ndetReembTit) + "]"
            EndDo

            //Varre as informações de reembolso dos dependentes
            ninfoReembDep := 1
            cinfoReembDep := cReembMed + "/infoReembDep[" + cValToChar(ninfoReembDep) + "]"
            While oXml:XPathHasNode(cinfoReembDep)             
                nPosOPRM := aScan(aInfoRM, {|x| x["RMcnpjOper"] + x["RMregANS"] == cCNPJOpRM + cRegANSRM})

                cCPFDepRM   := oXml:XPathGetNodeValue(cinfoReembDep + "/cpfBenef")
                cNOMEDepRM  := Iif(jListDep:HasProperty(cCPFDepRM), jListDep[cCPFDepRM], "** Nome não encontrado **")

                ndetReembDep := 1
                cdetReembDep := cinfoReembDep + "/detReembDep[" + cValToChar(ndetReembDep) + "]"                
                While oXml:XPathHasNode(cdetReembDep)
                    aReembMed  := {}
                    
                    aAdd(aReembMed, cCPFDepRM)
                    aAdd(aReembMed, cNOMEDepRM)
                    aAdd(aReembMed, oXml:XPathGetNodeValue(cdetReembDep + "/tpInsc")) 
                    aAdd(aReembMed, oXml:XPathGetNodeValue(cdetReembDep + "/nrInsc"))
                    aAdd(aReembMed, {0, "Valor Ano Atual"})
                    aAdd(aReembMed, {0, "Valor Anos Anteriores"})

                    Iif(oXml:XPathHasNode(cdetReembDep + "/vlrReemb"), aReembMed[5][1] := Val(oXml:XPathGetNodeValue(cdetReembDep + "/vlrReemb")),)
                    Iif(oXml:XPathHasNode(cdetReembDep + "/vlrReembAnt"), aReembMed[6][1] := Val(oXml:XPathGetNodeValue(cdetReembDep + "/vlrReembAnt")),)

                    //Procura o dependente nos dados de beneficiários e atualiza os valores
                    nPosBenefRM := aScan(aInfoRM[nPosOPRM]["RMbeneficiarios"], {|x| x["RMcpfBenef"] == cCPFDepRM}  )

                    //Se não encontrou o benefíciário cria objeto para recebimento dos valores
                    If nPosBenefRM == 0
                        jIfBenefRM["RMbeneficiario"]    := ""
                        jIfBenefRM["RMcpfBenef"]        := ""
                        jIfBenefRM["RMprestserv"]       := {}

                        aAdd(aIfBenefRM, jIfBenefRM)
                        aAdd(aInfoRM[nPosOPRM]["RMbeneficiarios"], aClone(aIfBenefRM)[1] )

                        FwFreeObj(jIfBenefRM)
                        jIfBenefRM := JsonObject():New()

                        aIfBenefRM := {}
                    EndIf

                    //Atualiza os valores
                    aInfoRM[nPosOPRM]["RMbeneficiarios"] := fValReembM(aReembMed, cMes, aClone(aInfoRM[nPosOPRM]["RMbeneficiarios"]), nPosBenefRM)

                    //Atualiza o nPosOPRM
                    nPosOPRM := aScan(aInfoRM, {|x| x["RMcnpjOper"] + x["RMregANS"] == cCNPJOpRM + cRegANSRM})

                    ndetReembDep++
                    cdetReembDep := cinfoReembDep + "/detReembDep[" + cValToChar(ndetReembDep) + "]"         
                EndDo 

                ninfoReembDep++
                cinfoReembDep := cReembMed + "/infoReembDep[" + cValToChar(ninfoReembDep) + "]"
            EndDo

            FwFreeObj(jInfoRM)
            jInfoRM := JsonObject():New()
            
            aInfoOPRM   := {}
            aReembMed   := {}

            jItem["infoReembMed"] := aClone(aInfoRM)

            nReembMed++
            cReembMed := cCabec + "ideTrabalhador/infoIRComplem/infoReembMed[" + cValToChar(nReembMed) + "]"          
        EndDo 

        //Inclui objeto do item no array de objetos
        aAdd(aJitem, jItem)

        //Se objeto de itens não estiver no array de item adiciona
        //Caso contrário sobrepõe, pois foi ajustado.            
        If nPosItem == 0
            aAdd(aItem, aClone(aJitem)[1])
        Else
            aItem[nPosItem] := aClone(aJitem)[nPosItem]
        EndIF    
    EndIf
	
Return


//-------------------------------------------------------------------------------------------------
/*/{Protheus.doc}
    @Author    lidio.oliveira
    @Date      29/01/2026
    @Type      Static Function
    Retorna Array com os tipos de rendimento
/*/
//-------------------------------------------------------------------------------------------------
Static Function fGetTpRend(aTotApurMen, cMes, aItem)

    Local jRegistros    As Json
    Local jValores      As Json
    Local aRet          As Array
    Local nX            As Numeric
    Local nPosItem      As Numeric

    Default aTotApurMen := {}
    Default cMes        := ""
    Default aItem       := {}

    jRegistros  := JSONObject():New()
    jValores    := JSONObject():New()
    aRet        := {}
    nX          := 0
    nPosItem    := 0

    If Len(aItem) > 0
        aRet        := aClone(aItem)
    EndIf

    //Varre o array com os tipos de rendimento
    For nX := 1 To Len(aTotApurMen)
        If !(aTotApurMen[nX][1] $ "CRMen|descRendimento")
            //Identifica se deve atualizar o item para retorno
            If Len(aItem) > 0
                nPosItem    := aScan(aRet, {|x| x["TRdescRend"] == JTpsRend[aTotApurMen[nX][1]]})
            EndIf
            
            If Len(aItem) == 0
                //Se o tipo de rendimento não existir
                If !jRegistros:HasProperty(aTotApurMen[nX][1])
                    jValores := fCriaVlrObj("TR", {{"TRdescRend", JTpsRend[aTotApurMen[nX][1]]}})          
                    jRegistros[aTotApurMen[nX][1]] := {}          
                EndIf

                //Incrementa o valor para o período
                jValores["TR"+cMes]  += NoRound(Val(aTotApurMen[nX][3]), 2)   
                jValores["TRtotal"]  += NoRound(Val(aTotApurMen[nX][3]), 2)             

                //Adiciona o registro no arrray de retorno
                Aadd(jRegistros[aTotApurMen[nX][1]], jValores)
                Aadd(aRet, aClone(jRegistros[aTotApurMen[nX][1]])[1])
            Else
                nPosItem := aScan(aRet, {|x| x["TRdescRend"] == JTpsRend[aTotApurMen[nX][1]]})
                If nPosItem > 0
                    aRet[nPosItem]["TR"+cMes] += NoRound(Val(aTotApurMen[nX][3]), 2)
                    aRet[nPosItem]["TRtotal"] += NoRound(Val(aTotApurMen[nX][3]), 2) 
                EndIf
            EndIf
        EndIf
    Next nX

Return aRet


//-------------------------------------------------------------------------------------------------
/*/{Protheus.doc}
    @Author    lidio.oliveira
    @Date      29/01/2026
    @Type      Static Function
    Retorna objeto dos valores
/*/
//-------------------------------------------------------------------------------------------------
Static Function fCriaVlrObj(cPrefixo, aCampos)

    Local jRet     As Json
    Local nX       As Numeric

    Default cPrefixo    := ""
    Default aCampos     := {}

    jRet := JsonObject():New()

    //Cria itens adicionais recebidos em aCampos
    For nX := 1 To Len(aCampos) 
        jRet[aCampos[nX][1]]        := aCampos[nX][2]   
    Next nX

    jRet[cPrefixo + "janeiro"]      := 0
    jRet[cPrefixo + "fevereiro"]    := 0
    jRet[cPrefixo + "marco"]        := 0
    jRet[cPrefixo + "abril"]        := 0
    jRet[cPrefixo + "maio"]         := 0
    jRet[cPrefixo + "junho"]        := 0
    jRet[cPrefixo + "julho"]        := 0
    jRet[cPrefixo + "agosto"]       := 0
    jRet[cPrefixo + "setembro"]     := 0
    jRet[cPrefixo + "outubro"]      := 0
    jRet[cPrefixo + "novembro"]     := 0
    jRet[cPrefixo + "dezembro"]     := 0
    jRet[cPrefixo + "total"]        := 0

Return jRet


//-------------------------------------------------------------------------------------------------
/*/{Protheus.doc}
    @Author    lidio.oliveira
    @Date      29/01/2026
    @Type      Static Function
    Retorna Array com as deduções dependentes
/*/
//-------------------------------------------------------------------------------------------------
Static Function fValDedDep(aDedDepen, cMes, aInfoDep, nPosDep)

    Local jRegistros    As Json
    Local jValores      As Json
    Local jInfoDep      As Json
    Local aRet          As Array
    Local nX            As Numeric
    Local nPosItem      As Numeric
    Local nPosTpRend    As Numeric

    Default aDedDepen   := {}
    Default cMes        := ""
    Default aInfoDep    := {}//JsonObject():New()
    Default nPosDep     := 0

    jRegistros  := JsonObject():New()
    jValores    := JsonObject():New()
    jInfoDep    := JsonObject():New()
    aRet        := {}
    nX          := 0
    nPosItem    := 0
    nPosTpRend  := 0

    //Se o tipo de rendimento existir
    If Len(aInfoDep[nPosDep]["DDtpRend"]) > 0     
        nPosTpRend := aScan(aInfoDep[nPosDep]["DDtpRend"], {|x| x["DDdescRend"] == aDedDepen[1] + jDescRend[aDedDepen[1]] })

        //Se encontrar o dependente e o tipo de rendimento atualiza o valor
        If nPosTpRend > 0
            aInfoDep[nPosDep]["DDtpRend"][nPosTpRend]["DD"+cMes] += NoRound(Val(aDedDepen[3]), 2)
            aInfoDep[nPosDep]["DDtpRend"][nPosTpRend]["DDtotal"] += NoRound(Val(aDedDepen[3]), 2)

            aRet := aClone(aInfoDep[nPosDep]["DDtpRend"])
        Else
            aRet  := aClone(aInfoDep[nPosDep]["DDtpRend"])
            
            jValores := fCriaVlrObj("DD", {{"DDdescRend", aDedDepen[1] + jDescRend[aDedDepen[1]]}})   
            jRegistros[aDedDepen[1]] := {}

            //Incrementa o valor para o período
            jValores["DD"+cMes]  += NoRound(Val(aDedDepen[3]), 2)
            jValores["DDtotal"]  += NoRound(Val(aDedDepen[3]), 2)

            //Adiciona o registro no arrray de retorno
            Aadd(jRegistros[aDedDepen[1]], jValores)
            Aadd(aRet, aClone(jRegistros[aDedDepen[1]])[1])
        EndIf
    Else 
        jValores := fCriaVlrObj("DD", {{"DDdescRend", aDedDepen[1] + jDescRend[aDedDepen[1]]}})   
        jRegistros[aDedDepen[1]] := {}

        //Incrementa o valor para o período
        jValores["DD"+cMes]  += NoRound(Val(aDedDepen[3]), 2)
        jValores["DDtotal"]  += NoRound(Val(aDedDepen[3]), 2)

        //Adiciona o registro no arrray de retorno
        Aadd(jRegistros[aDedDepen[1]], jValores)
        Aadd(aRet, aClone(jRegistros[aDedDepen[1]])[1])  
    EndIf

    FwFreeObj(jRegistros)
    FwFreeObj(jValores)
    FwFreeObj(jInfoDep)       

Return aRet


//-------------------------------------------------------------------------------------------------
/*/{Protheus.doc}
    @Author    lidio.oliveira
    @Date      29/01/2026
    @Type      Static Function
    Retorna Array com os dados de pensão alimentícia
/*/
//-------------------------------------------------------------------------------------------------
Static Function fValPensA(aPenAlim, cMes, aInfoBenef, nPosBenef)

    Local jRegistros    As Json
    Local jValores      As Json
    Local aRet          As Array
    Local nPosTpRend    As Numeric

    Default aPenAlim    := {}
    Default cMes        := ""
    Default aInfoBenef  := {}//JsonObject():New()
    Default nPosBenef   := 0

    jRegistros  := JsonObject():New()
    jValores    := JsonObject():New()
    aRet        := {}
    nPosTpRend  := 0

    //Se o tipo de rendimento existir
    If Len(aInfoBenef[nPosBenef]["PAtpRend"]) > 0     
        nPosTpRend := aScan(aInfoBenef[nPosBenef]["PAtpRend"], {|x| x["PAdescRend"] == aPenAlim[1] + jDescRend[aPenAlim[1]] })

        //Se encontrar o dependente e o tipo de rendimento atualiza o valor
        If nPosTpRend > 0
            aInfoBenef[nPosBenef]["PAtpRend"][nPosTpRend]["PA"+cMes] += NoRound(Val(aPenAlim[3]), 2)
            aInfoBenef[nPosBenef]["PAtpRend"][nPosTpRend]["PAtotal"] += NoRound(Val(aPenAlim[3]), 2)

            aRet := aClone(aInfoBenef[nPosBenef]["PAtpRend"])
        Else
            aRet  := aClone(aInfoBenef[nPosBenef]["PAtpRend"])
            
            jValores := fCriaVlrObj("PA", {{"PAdescRend", aPenAlim[1] + jDescRend[aPenAlim[1]]}})   
            jRegistros[aPenAlim[1]] := {}

            //Incrementa o valor para o período
            jValores["PA"+cMes]  += NoRound(Val(aPenAlim[3]), 2)
            jValores["PAtotal"]  += NoRound(Val(aPenAlim[3]), 2)

            //Adiciona o registro no arrray de retorno
            aAdd(jRegistros[aPenAlim[1]], jValores)
            aAdd(aRet, aClone(jRegistros[aPenAlim[1]])[1])
        EndIf
    Else 
        jValores := fCriaVlrObj("PA", {{"PAdescRend", aPenAlim[1] + jDescRend[aPenAlim[1]]}})   
        jRegistros[aPenAlim[1]] := {}

        //Incrementa o valor para o período
        jValores["PA"+cMes]  += NoRound(Val(aPenAlim[3]), 2)
        jValores["PAtotal"]  += NoRound(Val(aPenAlim[3]), 2)

        //Adiciona o registro no arrray de retorno
        aAdd(jRegistros[aPenAlim[1]], jValores)
        aAdd(aRet, aClone(jRegistros[aPenAlim[1]])[1])  
    EndIf

    FwFreeObj(jRegistros)
    FwFreeObj(jValores)

Return aRet


//-------------------------------------------------------------------------------------------------
/*/{Protheus.doc}
    @Author    lidio.oliveira
    @Date      03/02/2026
    @Type      Static Function
    Retorna Array com os dados de previdência complementar
/*/
//-------------------------------------------------------------------------------------------------
Static Function fValPreviC(aPreviComp, cMes, aInfoPC, nPosPc)

    Local jRegistros    As Json
    Local jValores      As Json
    Local aRet          As Array
    Local nPosTpPrevC   As Numeric
    Local nX            As Numeric

    Default aPreviComp  := {}
    Default cMes        := ""
    Default aInfoPC     := {}//JsonObject():New()
    Default nPosPc      := 0

    jRegistros  := JsonObject():New()
    jValores    := JsonObject():New()
    aRet        := {}
    nPosTpPrevC := 0
    nX          := 0

    //Se o tipo de previdência existir
    If Len(aInfoPC[nPosPc]["PCvaloresPrev"]) > 0     
        For nX := 3 To Len(aPreviComp)
            If aPreviComp[nX][1] > 0
                nPosTpPrevC := aScan(aInfoPC[nPosPc]["PCvaloresPrev"], {|x| x["PCdescValor"] == aPreviComp[nX][2]})

                //Se encontrou o tipo de e cnpj da entendida de previdência complementar
                If nPosTpPrevC > 0
                    aInfoPC[nPosPc]["PCvaloresPrev"][nPosTpPrevC]["PC"+cMes] += NoRound(aPreviComp[nX][1], 2)
                    aInfoPC[nPosPc]["PCvaloresPrev"][nPosTpPrevC]["PCtotal"] += NoRound(aPreviComp[nX][1], 2)

                    aRet := aClone(aInfoPC[nPosPc]["PCvaloresPrev"])
                Else
                    aRet  := aClone(aInfoPC[nPosPc]["PCvaloresPrev"])
                    
                    jValores := fCriaVlrObj("PC", {{"PCdescValor", aPreviComp[nX][2]}}) 
                    jRegistros[aPreviComp[1]+aPreviComp[2]] := {}

                    //Incrementa o valor para o período
                    jValores["PC"+cMes]  += NoRound(aPreviComp[nX][1], 2)
                    jValores["PCtotal"]  += NoRound(aPreviComp[nX][1], 2)

                    //Adiciona o registro no arrray de retorno
                    aAdd(jRegistros[aPreviComp[1]+aPreviComp[2]], jValores)
                    aAdd(aRet, aClone(jRegistros[aPreviComp[1]+aPreviComp[2]])[1])
                    
                    FwFreeObj(jRegistros)
                    FwFreeObj(jValores)

                    jRegistros  := JsonObject():New()
                    jValores    := JsonObject():New()
                EndIf
            EndIf
        Next Nx
    Else 
        For nX := 3 To Len(aPreviComp)
            If aPreviComp[nX][1] > 0
                jValores := fCriaVlrObj("PC", {{"PCdescValor", aPreviComp[nX][2]}})
                jRegistros[aPreviComp[1]+aPreviComp[2]] := {}

                //Incrementa o valor para o período
                jValores["PC"+cMes]  += NoRound(aPreviComp[nX][1], 2)
                jValores["PCtotal"]  += NoRound(aPreviComp[nX][1], 2)

                //Adiciona o registro no arrray de retorno
                aAdd(jRegistros[aPreviComp[1]+aPreviComp[2]], jValores)
                aAdd(aRet, aClone(jRegistros[aPreviComp[1]+aPreviComp[2]])[1])

                FwFreeObj(jRegistros)
                FwFreeObj(jValores)

                jRegistros  := JsonObject():New()
                jValores    := JsonObject():New()                
            EndIf
        Next nX  
    EndIf

    FwFreeObj(jRegistros)
    FwFreeObj(jValores)

Return aRet


//-------------------------------------------------------------------------------------------------
/*/{Protheus.doc}
    @Author    lidio.oliveira
    @Date      03/02/2026
    @Type      Static Function
    Retorna Array com os dados de plano de saúde
/*/
//-------------------------------------------------------------------------------------------------
Static Function fValPlanSau(aPlanSaude, cMes, aInfoPS, nPosPS)

    Local jRegistros    As Json
    Local jValores      As Json
    Local aRet          As Array
    Local nPosBenefPS   As Numeric

    Default aPlanSaude  := {}
    Default cMes        := ""
    Default aInfoPS     := {}//JsonObject():New()
    Default nPosPS      := 0

    jRegistros  := JsonObject():New()
    jValores    := JsonObject():New()
    aRet        := {}
    nPosBenefPS := 0

    //Se houver dados de dependente/titular
    If Len(aInfoPS[nPosPS]["PSbeneficiarios"]) > 0     
        //Identifica pelo CPF se o registro existe
        nPosBenefPS := aScan(aInfoPS[nPosPS]["PSbeneficiarios"], {|x| x["PScpfBenef"] == aPlanSaude[2]})

        //Se encontrou o beneficiário
        If nPosBenefPS > 0
            aInfoPS[nPosPS]["PSbeneficiarios"][nPosBenefPS]["PS"+cMes] += NoRound(aPlanSaude[3], 2)
            aInfoPS[nPosPS]["PSbeneficiarios"][nPosBenefPS]["PStotal"] += NoRound(aPlanSaude[3], 2)

            aRet := aClone(aInfoPS[nPosPS]["PSbeneficiarios"])
        Else
            aRet  := aClone(aInfoPS[nPosPS]["PSbeneficiarios"])
            
            jValores := fCriaVlrObj("PS", {{"PSnomeBenef", aPlanSaude[1]}, {"PScpfBenef", aPlanSaude[2]}})
            jRegistros[aPlanSaude[2]] := {}

            //Incrementa o valor para o período
            jValores["PS"+cMes]  += NoRound(aPlanSaude[3], 2)
            jValores["PStotal"]  += NoRound(aPlanSaude[3], 2)

            //Adiciona o registro no arrray de retorno
            aAdd(jRegistros[aPlanSaude[2]], jValores)
            aAdd(aRet, aClone(jRegistros[aPlanSaude[2]])[1])   
        EndIf
    Else 
        jValores := fCriaVlrObj("PS", {{"PSnomeBenef", aPlanSaude[1]}, {"PScpfBenef", aPlanSaude[2]}})
        jRegistros[aPlanSaude[2]] := {}

        //Incrementa o valor para o período
        jValores["PS"+cMes]  += NoRound(aPlanSaude[3], 2)
        jValores["PStotal"]  += NoRound(aPlanSaude[3], 2)

        //Adiciona o registro no arrray de retorno
        aAdd(jRegistros[aPlanSaude[2]], jValores)
        aAdd(aRet, aClone(jRegistros[aPlanSaude[2]])[1])         
    EndIf

    FwFreeObj(jRegistros)
    FwFreeObj(jValores)

Return aRet


//-------------------------------------------------------------------------------------------------
/*/{Protheus.doc}
    @Author    lidio.oliveira
    @Date      03/02/2026
    @Type      Static Function
    Retorna Array com os dados de plano de saúde
/*/
//-------------------------------------------------------------------------------------------------
Static Function fValReembM(aReembMed, cMes, aBenefsRM, nPosBenefRM)

    Local jRegistros    As Json
    Local jValores      As Json
    Local jPrestserv    As Json
    Local aRet          As Array
    Local aPrestserv    As Array
    Local nPosBenefPS   As Numeric
    Local nPosPrest     As Numeric
    Local nPosTpVlr     As Numeric
    Local nPrest        As Numeric
    Local nX            As Numeric

    Default aReembMed   := {}
    Default cMes        := ""
    Default aBenefsRM   := {}
    Default nPosBenefRM := 0

    jRegistros  := JsonObject():New()
    jValores    := JsonObject():New()
    jPrestserv  := JsonObject():New()
    aPrestserv  := {}
    aRet        := {}
    nPosBenefPS := 0
    nPosPrest   := 0
    nPosTpVlr   := 0
    nPrest      := 0
    nX          := 0

    //Se não houver dados do beneficiário realiza a inclusão
    If nPosBenefRM == 0
        aBenefsRM[Len(aBenefsRM)]["RMbeneficiario"]  := aReembMed[2]
        aBenefsRM[Len(aBenefsRM)]["RMcpfBenef"]      := aReembMed[1]

        jPrestserv["RMtpinsc"]  := aReembMed[3]
        jPrestserv["RMnrinsc"]  := aReembMed[4]
        jPrestserv["RMvalores"] := {}

        nPosBenefRM := Len(aBenefsRM)

        //Cria o grupo de valores
        For nX := 5 To Len(aReembMed)
            If aReembMed[nX][1] > 0
                jValores := fCriaVlrObj("RM", {{"RMdescValor", aReembMed[nX][2]}})
                jRegistros[aReembMed[4]] := {}

                //Incrementa o valor para o período
                jValores["RM"+cMes]  += NoRound(aReembMed[nX][1], 2)
                jValores["RMtotal"]  += NoRound(aReembMed[nX][1], 2)

                //Adiciona o registro no array de valores do prestador de serviços
                aAdd(jRegistros[aReembMed[4]], jValores)
                aAdd(jPrestserv["RMvalores"], aClone(jRegistros[aReembMed[4]])[1]) 

                //Inclui no array do beneficiário
                aAdd(aPrestserv, jPrestserv)
                aAdd(aBenefsRM[nPosBenefRM]["RMprestserv"], aClone(aPrestserv)[1])

                //Zera variáveis
                FwFreeObj(jRegistros)
                FwFreeObj(jValores)

                jRegistros  := JsonObject():New()
                jValores    := JsonObject():New() 
            EndIf

            aPrestserv := {}
        Next nX
    Else 
        //Identifica se o prestador de serviço já está incluído
        nPosPrest := aScan(aBenefsRM[nPosBenefRM]["RMprestserv"], {|x| x["RMnrinsc"] == aReembMed[4]})
        
        For nX := 5 To Len(aReembMed)
            If aReembMed[nX][1] > 0
                //Vericar se o prestador está incluído
                If nPosPrest > 0
                    //Identifica se o tipo de valor já existe na array de valores
                    nPosTpVlr := aScan(aBenefsRM[nPosBenefRM]["RMprestserv"][nPosPrest]["RMvalores"], {|x| x["RMdescValor"] == aReembMed[nX][2]})
                    
                    If nPosTpVlr > 0
                        aBenefsRM[nPosBenefRM]["RMprestserv"][nPosPrest]["RMvalores"][nPosTpVlr]["RM"+cMes] += NoRound(aReembMed[nX][1], 2)
                        aBenefsRM[nPosBenefRM]["RMprestserv"][nPosPrest]["RMvalores"][nPosTpVlr]["RMtotal"] += NoRound(aReembMed[nX][1], 2)
                    EndIf
                EndIf

                //Caso não tenha encontrado o tipo ou prestador inclui os dados:
                If nPosTpVlr == 0    
                    //Cria o prestador se não localizou
                    If nPosPrest == 0
                        jPrestserv["RMtpinsc"]  := aReembMed[3]
                        jPrestserv["RMnrinsc"]  := aReembMed[4]
                        jPrestserv["RMvalores"] := {}
                    EndIf

                    jValores := fCriaVlrObj("RM", {{"RMdescValor", aReembMed[nX][2]}})
                    jRegistros[aReembMed[4]] := {}

                    //Incrementa o valor para o período
                    jValores["RM"+cMes]  += NoRound(aReembMed[nX][1], 2)
                    jValores["RMtotal"]  += NoRound(aReembMed[nX][1], 2)

                    //Adiciona o registro no array de valores do prestador de serviços
                    aAdd(jRegistros[aReembMed[4]], jValores)
                    aAdd(jPrestserv["RMvalores"], aClone(jRegistros[aReembMed[4]])[1]) 

                    aAdd(aPrestserv, jPrestserv)
                    aAdd(aBenefsRM[1]["RMprestserv"], aClone(aPrestserv)[1] )

                    //Zera variáveis
                    FwFreeObj(jRegistros)
                    FwFreeObj(jValores)

                    jRegistros  := JsonObject():New()
                    jValores    := JsonObject():New()
                    aPrestserv  := {}
                EndIf
            EndIf

            //Atualiza a posição do prestador
            nPosPrest := aScan(aBenefsRM[nPosBenefRM]["RMprestserv"], {|x| x["RMnrinsc"] == aReembMed[4]})
        Next nX
    EndIf

    aRet := aClone(aBenefsRM)

    FwFreeObj(jRegistros)
    FwFreeObj(jValores)

Return aRet


//-------------------------------------------------------------------------------------------------
/*/{Protheus.doc}
    @Author    lidio.oliveira
    @Date      03/02/2026
    @Type      Static Function
    Retorna objeto com os nomes dos dependentes
/*/
//-------------------------------------------------------------------------------------------------
Static Function fCarrDep(cCPFFunc)

    Local jRet          As Json
    Local cQuerySRB     As Character
    Local cQuerySRQ     As Character
    Local cQueryRHM     As Character
    Local cFilSRBSRA    As Character
    Local cFilSRQSRA    As Character
    Local cFilRHMSRA    As Character
	Local cAliasSRB     As Character
    Local cAliasSRQ     As Character
    Local cAliasRHM     As Character
    Local nParamOrder   As Numeric

    Default cCPFFunc := ""

    jRet        := JsonObject():New()
    cQuerySRB   := ""
    cQuerySRQ   := ""
    cQueryRHM   := ""
    cFilSRBSRA  := FWJoinFilial("SRB", "SRA")
    cFilSRQSRA  := FWJoinFilial("SRQ", "SRA")
    cFilRHMSRA  := FWJoinFilial("RHM", "SRA")
	cAliasSRB   := GetNextAlias()
    cAliasSRQ   := GetNextAlias()
    cAliasRHM   := GetNextAlias()
    nParamOrder := 1

    If oQrySRB == Nil
        cQuerySRB := "SELECT RB_CIC, RB_NOME "
        cQuerySRB += "FROM " + RetSqlName('SRB') + " SRB "
        cQuerySRB += "LEFT JOIN " + RetSqlName('SRA') + " SRA "
        cQuerySRB += " ON " + cFilSRBSRA + " "
        cQuerySRB += " AND SRB.RB_MAT = SRA.RA_MAT "
        cQuerySRB += "WHERE SRA.RA_CIC = ? "                  //cCPFFunc
        cQuerySRB += " AND SRB.D_E_L_E_T_ = ? "        
        cQuerySRB += " AND SRA.D_E_L_E_T_ = ? "
        cQuerySRB += "ORDER BY SRB.RB_FILIAL, SRB.RB_MAT "

        cQuerySRB  := ChangeQuery(cQuerySRB)
        oQrySRB := FwExecStatement():New(cQuerySRB)
    EndIf

    oQrySRB:SetString(nParamOrder++, cCPFFunc) 
    oQrySRB:SetString(nParamOrder++, " ")             //D_E_L_E_T_
    oQrySRB:SetString(nParamOrder++, " ")             //D_E_L_E_T_

    // Executa a query e retorna o alias criado
    cAliasSRB := oQrySRB:OpenAlias()

    //Carrega os dependentes
    While ((cAliasSRB)->(!Eof()))

        jRet[Alltrim((cAliasSRB)->RB_CIC)] := Alltrim((cAliasSRB)->RB_NOME)

        (cAliasSRB)->(dbSkip())
    EndDo

    (cAliasSRB)->(DBCloseArea())

    //Zera nParamOrder para a query dos beneficiários
    nParamOrder := 1

    If oQrySRQ == Nil
        cQuerySRQ := "SELECT RQ_CIC, RQ_NOME "
        cQuerySRQ += "FROM " + RetSqlName('SRQ') + " SRQ "
        cQuerySRQ += "LEFT JOIN " + RetSqlName('SRA') + " SRA "
        cQuerySRQ += " ON " + cFilSRQSRA + " "
        cQuerySRQ += " AND SRQ.RQ_MAT = SRA.RA_MAT "
        cQuerySRQ += "WHERE SRA.RA_CIC = ? "                  //cCPFFunc
        cQuerySRQ += " AND SRQ.RQ_SEQUENC = ? "
        cQuerySRQ += " AND SRQ.D_E_L_E_T_ = ? "        
        cQuerySRQ += " AND SRA.D_E_L_E_T_ = ? "
        cQuerySRQ += "ORDER BY SRQ.RQ_FILIAL, SRQ.RQ_MAT "

        cQuerySRQ  := ChangeQuery(cQuerySRQ)
        oQrySRQ := FwExecStatement():New(cQuerySRQ)
    EndIf

    oQrySRQ:SetString(nParamOrder++, cCPFFunc) 
    oQrySRQ:SetString(nParamOrder++, "01")
    oQrySRQ:SetString(nParamOrder++, " ")             //D_E_L_E_T_
    oQrySRQ:SetString(nParamOrder++, " ")             //D_E_L_E_T_

    // Executa a query e retorna o alias criado
    cAliasSRQ := oQrySRQ:OpenAlias()

    //Carrega os beneficiários
    While ((cAliasSRQ)->(!Eof()))
        
        If !(jRet:HasProperty((cAliasSRQ)->RQ_CIC))
            jRet[Alltrim((cAliasSRQ)->RQ_CIC)] := Alltrim((cAliasSRQ)->RQ_NOME)
        EndIf

        (cAliasSRQ)->(dbSkip())
    EndDo

    (cAliasSRQ)->(DBCloseArea())

    //Zera nParamOrder para a query dos agregados
    nParamOrder := 1

    If oQryRHM == Nil
        cAliasSRQ := "SELECT RHM_CPF, RHM_NOME "
        cAliasSRQ += "FROM " + RetSqlName('RHM') + " RHM "
        cAliasSRQ += "LEFT JOIN " + RetSqlName('SRA') + " SRA "
        cAliasSRQ += " ON " + cFilRHMSRA + " "
        cAliasSRQ += " AND RHM.RHM_MAT = SRA.RA_MAT "
        cAliasSRQ += "WHERE SRA.RA_CIC = ? "                  //cCPFFunc
        cAliasSRQ += " AND RHM.D_E_L_E_T_ = ? "        
        cAliasSRQ += " AND SRA.D_E_L_E_T_ = ? "
        cAliasSRQ += "ORDER BY RHM.RHM_FILIAL, RHM.RHM_MAT "

        cAliasSRQ  := ChangeQuery(cAliasSRQ)
        oQryRHM := FwExecStatement():New(cAliasSRQ)
    EndIf

    oQryRHM:SetString(nParamOrder++, cCPFFunc) 
    oQryRHM:SetString(nParamOrder++, " ")             //D_E_L_E_T_
    oQryRHM:SetString(nParamOrder++, " ")             //D_E_L_E_T_

    // Executa a query e retorna o alias criado
    cAliasRHM := oQryRHM:OpenAlias()

    //Carrega os agregados
    While ((cAliasRHM)->(!Eof()))

        If !(jRet:HasProperty((cAliasRHM)->RHM_CPF))
            jRet[Alltrim((cAliasRHM)->RHM_CPF)] := Alltrim((cAliasRHM)->RHM_NOME)
        EndIf

        (cAliasRHM)->(dbSkip())
    EndDo

    (cAliasRHM)->(DBCloseArea())

Return jRet


