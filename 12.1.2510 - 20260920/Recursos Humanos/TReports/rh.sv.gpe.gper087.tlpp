#Include "totvs.framework.treports.integratedprovider.th"
#Include "tlpp-core.th"
#Include "tlpp-rest.th"
#Include "rh.sv.gpe.gper087.ch"

namespace totvs.protheus.rh.treportsintegratedprovider

Static oQryTMP
Static oQrySRB
Static oQrySRQ
Static oQryRHM
Static oQryCPF
Static oQryRU5

//-------------------------------------------------------------------------------------------------
/*/{Protheus.doc}
    Classe do objeto de negócio da Conferência S-5002
    @type Class
    @version 12.1.2510
    @author lidio.oliveira
    @since 21/01/2026
/*/
//-------------------------------------------------------------------------------------------------
@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGAGPE", tables="RJE, T2G", name="Conferência S-5002 por Tipo de Rendimento e seus Dados Complementares", customTables = "", country="BRA", initialRelease="12.1.2310")
Class GPER087TReportsBusinessObject From totvs.framework.treports.integratedprovider.IntegratedProvider
    
    // Define os métodos da classe
    Public Method new()       As Object
    Public Method getData()   As Object
    Public Method getSchema() As Object

    @Get("/api/rh/smartview/v1/options/GPER087/:param")
EndClass


//-------------------------------------------------------------------------------------------------
/*/{Protheus.doc} GPER087TReportsBusinessObject:new()
    Instancia a classe do objeto de negócio.
    @type Method
    @version 12.1.2510
    @author lidio.oliveira
    @since 21/01/2026
    @return Object, Instância do objeto de negócio
/*/
//-------------------------------------------------------------------------------------------------
Method new() As Object Class GPER087TReportsBusinessObject

    // Chama o construtor da classe super
    _Super:new()

    // Define a área
    self:appendArea(STR0001) // "RH"

    // Define o nome e descrição do objeto de negócio
    self:setDisplayName(STR0002) // "Ficha S-5002 Por Trabalhador"
    self:setDescription(STR0003) // "Este objeto de negócio, retorna as informações do evento S-5002 por funcionário para o todo o ano base informado."

Return self


//-------------------------------------------------------------------------------------------------
/*/{Protheus.doc} GPER087TReportsBusinessObject:getData()
    Captura os dados do objeto de negócio.
    @type Method
    @version 12.1.2510
    @author lidio.oliveira
    @since 21/01/2026
    @return Object, Dados do objeto de negócio
/*/
//-------------------------------------------------------------------------------------------------
method getData(nPage as numeric, oFilter as object) as object class GPER087TReportsBusinessObject
    
    Local jParams       As JSON      // Parâmetros
    Local jInscFils     As Json      // Json com a raiz de cnpj de cada filial
    Local oResp         As Object
    Local lFiltraFil    As Logical
    Local lObfuscated   As Logical
    Local aInfo         As Array
    Local aFiliais      As Array
    Local aPDFields     As Array     // Campos que podem ser exibidos de acordo com a LGPD
    Local aAllFields    As Array     // Estrutura de todos os campos do ON
    Local aGrpThd       As Array
    Local aItGrpThd     AS Array
    Local cAliasReg     As Character
    Local cXML5002      As Character
    Local cFiltro       As Character // Filtro do objeto de negócio
    Local cInscrDe      As Character
    Local cInscrAte     As Character
    Local cCPFDe        As Character
    Local cCPFAte       As Character
    Local cAnoBase      As Character
    Local cCodRec       As Character
    Local cMatriz       As Character
    Local cRJEInscr     As Character
    Local cChvItem      As Character
    Local cT2GFIL       As Character
    Local cName         As Character // Nome real do campo
    Local cInscFil      As Character
    Local cTicket       As Character
    Local cAliasCPF     As Character
    Local cFilReg       As Character
    Local cCPFReg       As Character
    Local cPerReg       As Character
    Local cRecnoReg     As Character
    Local nX            As Numeric
    Local nFields       As Numeric
    Local nQtdItens     As Numeric
    Local nItem         As Numeric
    Local nQtdChv       As Numeric
    Local nQtdAppend    As Numeric
    Local nMvQtdThd     As Numeric
    Local nMinItThd     As Numeric
    Local nQtdThd       As Numeric //Quantidade de threadas que serão utilizadas no processamento
    Local nQtdIThd      As Numeric
    Local nContTot      As Numeric
    Local nCont         As Numeric

    Private lMiddleware As Logical
    Private JTpsRend    As Json
    Private jDescRend   As Json
    Private jDescCR     As Json
    Private jDescPrevC  As Json
    Private jListDep    As Json
    Private jIndOrgRM   As Json
    Private jLGPD       As Json      // Indica quais campos devem ser ofuscados
    Private aItem       As Array
    Private aSM0        As Array
    Private aTpsRend    As Array  
    Private cCNPJEmp    As Character
    Private cNomeEmp    As Character
    Private cCPFTrab    As Character
    Private cNomeTrab   As Character

    //Inicialização das variáveis
    lMiddleware := Iif( cPaisLoc == 'BRA' .And. Findfunction("fVerMW"), fVerMW(), .F. )
    lFiltraFil  := .F.
    lObfuscated := .F.
    cFiltro     := IIf(oFilter:hasFilter(), " AND " + oFilter:getSQLExpression(), "")
    jParams     := oFilter:getParameters()
    JTpsRend    := JsonObject():New()
    jDescRend   := JsonObject():New()
    jDescCR     := JsonObject():New()
    jDescPrevC  := JsonObject():New()
    jListDep    := JsonObject():New()
    jIndOrgRM   := JsonObject():New()
    jLGPD       := JSONObject():New()
    jInscFils   := JsonObject():New()
    oResp       := JsonObject():New()
    aItem       := {}
    aInfo       := {}
    aTpsRend    := {}
    aFiliais    := {}
    aPDFields   := {}
    aAllFields  := {}
    aSM0        := FWLoadSM0(.T.)
    aGrpThd     := {}
    aItGrpThd   := {}   
    cAliasReg   := ""
    cXML5002    := ""
    cInscrDe    := ""
    cInscrAte   := ""
    cCPFDe      := ""
    cCPFAte     := ""
    cAnoBase    := ""
    cCodRec     := ""
    cMatriz     := ""
    cRJEInscr   := ""
    cCNPJEmp    := ""
    cNomeEmp    := ""
    cCPFTrab    := ""
    cNomeTrab   := ""
    cChvItem    := ""
    cT2GFIL     := ""
    cName       := ""
    cInscFil    := ""
    cTicket     := ""
    cAliasCPF   := ""
    cFilReg     := ""
    cCPFReg     := ""
    cPerReg     := ""
    cRecnoReg   := ""
    nX          := 0
    nFields     := 0
    nQtdItens   := 0
    nItem       := 0
    nQtdChv     := 0
    nQtdAppend  := 0
    nMvQtdThd   := SuperGetMv("MV_087QTHD", , 0)    //Quantidade máxima de threads para processamento
    nMinItThd   := SuperGetMv("MV_087ITHD", , 120)  //Quantidade minima de itens por threads
    nQtdThd     := 0
    nQtdIThd    := 0
    nContTot    := 0
    nCont       := 0

    // Captura o valor dos parâmetros
    If (jParams != NIL)
        cInscrDe    := IIf(jParams:hasProperty("CNPJDe")        .and.   Len(jParams["CNPJDe"]) > 0        .and.   !Empty(jParams["CNPJDe"][1]),     jParams["CNPJDe"][1],       "")
        cInscrAte   := IIf(jParams:hasProperty("CNPJAte")       .and.   Len(jParams["CNPJAte"]) > 0       .and.   !Empty(jParams["CNPJAte"][1]),    jParams["CNPJAte"][1],      Replicate("Z", GetSX3Cache("RJE_INSCR", "X3_TAMANHO")))
        cCPFDe      := IIf(jParams:hasProperty("CPFDe")         .and.   Len(jParams["CPFDe"]) > 0         .and.   !Empty(jParams["CPFDe"][1]),      jParams["CPFDe"][1],        "")
        cCPFAte     := IIf(jParams:hasProperty("CPFAte")        .and.   Len(jParams["CPFAte"]) > 0        .and.   !Empty(jParams["CPFAte"][1]),     jParams["CPFAte"][1],       Replicate("Z", GetSX3Cache("RA_CIC", "X3_TAMANHO")))
        cAnoBase    := IIf(jParams:hasProperty("AnoBase")       .and.   Len(jParams["AnoBase"]) > 0       .and.   !Empty(jParams["AnoBase"][1]),    jParams["AnoBase"][1],      "")
        cCodRec     := IIf(jParams:hasProperty("CodReceita")    .and.   Len(jParams["CodReceita"]) > 0    .and.   !Empty(jParams["CodReceita"][1]), jParams["CodReceita"][1],   "")
    EndIf

    //Monta objeto com os tipos de rendimentos
    JTpsRend := fTpRend087()

    //Mantém array com os tipos rendimentos
    aTpsRend := JTpsRend:GetNames()

    //Monta objeto com a descrição de rendimento
    jDescRend := fDRend087()

    //Monta objeto com a descrição dos códigos de receita
    jDescCR := fDCodRec087()

    //Monta objeto com as descrições dos tipos de previdência complementar
    jDescPrevC := fDPrev087()

    //Monta objeto com as descrições com os indicativos de origem do reembolso
    jIndOrgRM := fDOrReem087()

	// Verifica se precisa fazer o tratamento para LGPD
    aPDFields   := FwProtectedDataUtil():UsrAccessPDField(__cUserID, self:getArrayFields())
    lObfuscated := Len(aPDFields) != Len(self:getArrayFields())
    aAllFields  := self:getStructFields()

    // Adiciona no JSON todos os campos como atributos e com o conteúdo sendo uma flag que indica se o campo deve ser ofuscado
    For nFields := 1 To Len(aAllFields)
        cName        := Trim(aAllFields[nFields]:getName())
        jLGPD[cName] := AScan(aPDFields, {|x| Trim(x) == cName}) <= 0
    Next nFields

    //Gera ticket RU4 e RU5 para acompanhar o progresso
    cTicket := GeraTicket(jParams:ToJson())

    //Caso o cliente utilize o middleware busca os dados do evento S-5002 na tabela RJE
    If lMiddleware
        DbSelectArea("RJE")
        cAliasReg := fQryRJE(oQryTMP, "S5002", cInscrDe, cInscrAte, cCPFDe, cCPFAte, cAnoBase, cFiltro)
        
        //Apura a quantidade de itens para serem processados
        DbSelectArea(cAliasReg)
        (cAliasReg)->(dbGoTop())
        If (cAliasReg)->( !Eof() )
            ( cAliasReg )->( DBEval( { || nQtdItens++ } ) )
        EndIf    
        
        //Se não houver itens atualiza percentual e indica finalização, caso contrário segue o processamento
        If nQtdItens == 0
            SetPerc(cTicket, 1, 1)
            SetFinish(cTicket)
        Else
            (cAliasReg)->(dbGoTop())
            If !(cAliasReg)->(Eof())
                //Varre todos os registros encontrados
                While !(cAliasReg)->(Eof())
                    nItem++
                    RJE->(dbGoTo((cAliasReg)->R_E_C_N_O_))

                    //Atualiza a chave do item da query
                    cChvItem    := (cAliasReg)->RJE_INSCR + (cAliasReg)->CPF
                    
                    //Recupera o arquivo XML do evento S-5002
                    cXML5002    := RJE->RJE_XML

                    //Varre o arquivo XML para gravação do jRegistros 
                    If !Empty(cXML5002)
                        //Identifica os dados da fonte pagadora
                        If cRJEInscr <> (cAliasReg)->RJE_INSCR
                            cMatriz := fVldMatriz((cAliasReg)->RJE_FIL, (cAliasReg)->RJE_INI)
                            
                            //Busca os dados da empresa nos moldes do informe de rendimento
                            fInfo(@aInfo, cMatriz)                    
                            If Len(aInfo) > 0
                                cCNPJEmp    := AllTrim(aInfo[8])
                                cNomeEmp    := AllTrim(aInfo[3])
                            EndIf
                            
                            cRJEInscr   := (cAliasReg)->RJE_INSCR
                        EndIf

                        //Carrega o nome do trabalhador
                        If cCPFTrab <> (cAliasReg)->CPF
                            cCPFTrab    := (cAliasReg)->CPF
                            cNomeTrab   := AllTrim(Posicione("SRA", 20, cCPFTrab, "RA_NSOCIAL")) 
                            If Empty(cNomeTrab) .And. !Empty(SRA->RA_NOMECMP)
                                cNomeTrab   := AllTrim(SRA->RA_NOMECMP)
                            Else
                                cNomeTrab   := AllTrim(SRA->RA_NOME)
                            EndIf
                        EndIf

                        //Carrega lista de dependentes do beneficiários
                        If Len(jListDep:GetNames()) == 0
                            jListDep := fCarrDep(cCPFTrab)
                        EndIf

                        cNomeTrab   := Iif(jLGPD["RA_MAT"], FwProtectedDataUtil():ValueAsteriskToAnonymize(cNomeTrab), cNomeTrab)
                        cCPFTrab    := Iif(jLGPD["RA_CIC"], FwProtectedDataUtil():ValueAsteriskToAnonymize(cCPFTrab), cCPFTrab) 

                        fProcXML(cXML5002, @aItem, cCodRec)
                    EndIf 

                    (cAliasReg)->(dbSkip())

                    //Zera e iniciai os objetos de retorno ao alterar o funcionário
                    If (cChvItem <> (cAliasReg)->RJE_INSCR + (cAliasReg)->CPF) .Or. (cAliasReg)->(Eof())
                        
                        //Adiciona os dados do primeiro funcionário
                        If !Empty(cChvItem) .Or. (cAliasReg)->(Eof())
                            For nX := 1 To Len(aItem)
                                self:appendData(aItem[nX])
                                //Chama a gravação do json na tabela RU5  
                                nQtdChv++
                                GrvItRes(aItem[nX]:ToJson(), StrZero(nQtdChv, 6), .F., "1", cCPFTrab, cTicket)   
                            Next nX
                            
                            //Zera o array de items pois já processou o funcionário
                            aItem       := {}
                            FwFreeObj(jListDep)
                            jListDep := JsonObject():New()
                        EndIf

                    EndIf

                    //Reinicia variáveis
                    cXML5002    := ""

                    //Incrementa o percentual de progresso
                    SetPerc( cTicket, nItem, nQtdItens )
                
                    //Indica a finalização do progresso
                    If nItem == nQtdItens
                        SetFinish(cTicket)
                    EndIf
                EndDo					
            EndIf
        EndIf
        (cAliasReg)->(DBCloseArea()) 
    Else
        //Se houver filtro de CNPJ carrega a lista de filiais
        If !Empty(cInscrDe) .Or. !Empty(cInscrAte)
            lFiltraFil := .T.
            For nX := 1 To Len(aSM0)
                If aSM0[nX][1] == cEmpAnt .And. Substr(aSM0[nX][18], 1, 8) >= Substr(cInscrDe, 1, 8)  .And. Substr(aSM0[nX][18], 1, 8) <= Substr(cInscrAte, 1, 8)
                    aAdd(aFiliais, aSM0[nX][2])
                    jInscFils[aSM0[nX][2]] := Substr(aSM0[nX][18], 1, 8)
                EndIf
            Next nX
        EndIf

        //Query agrupando os registros na T2G por CPF
        cAliasCPF := fT2GCPF(oQryCPF, aFiliais, cCPFDe, cCPFAte, cAnoBase, cFiltro, lFiltraFil)

        //Apura a quantidade de trabalhadores para serem processados e gravados na tabela RU5
        (cAliasCPF)->(DbGoTop())
        If (cAliasCPF)->( !Eof() )
            ( cAliasCPF )->( DBEval( { || nQtdAppend++ } ) ) 
        EndIf

        (cAliasCPF)->(DBCloseArea()) 

        //Busca os itens que devem ser processados (Eventos S-5002)
        DbSelectArea("T2G")
        cAliasReg := fQryT2G(oQryTMP, aFiliais, cCPFDe, cCPFAte, cAnoBase, cFiltro, lFiltraFil)

        //Apura a quantidade de itens para serem processados
        DbSelectArea(cAliasReg)
        (cAliasReg)->(dbGoTop())
        If (cAliasReg)->( !Eof() )
            ( cAliasReg )->( DBEval( { || nQtdItens++ } ) )
        EndIf 
     
        //Se não houver itens atualiza percentual e indica finalização, caso contrário segue o processamento
        If nQtdItens == 0
            SetPerc(cTicket, 1, 1)
            SetFinish(cTicket)
        Else
            (cAliasReg)->(dbGoTop())

            nMvQtdThd   := Min(20, nMvQtdThd)           //Não permite mais de 20 threads
            nMinItThd   := Max(120, nMinItThd)          //Não permite menos de 120 itens por threads

            //Identifica se será executado com multi Threads
            //MV_087QTHD -> Define a quantidade máxima de threads no processamento do relatório (Limitado a 20)
            //MV_087ITHD -> Define a quantidade minima de itens (Eventos S5002) por threads (última thread por ter uma quantidade menor - Minimo observado é 200).
            //Com os valores acima é realizado cálculo para identificar quantas threads abrir.
            If nMvQtdThd > 1 .And. nQtdItens >= nMinItThd
                nQtdThd     := Int(nQtdItens / nMinItThd)   //Encontra a quantidade de threads dividindo os itens (S5002) pelo MV_087QTHD (Ou O valor 20)
                nQtdThd     := Min(nQtdThd, nMvQtdThd)      //Valida que a quantidade de threads atenda ao mínimo de itens por thread
                nQtdIThd    := (nQtdItens / nQtdThd)        //Quantidade de itens por threads
            EndIf

            //Se a quantidade de threads for maior que 1 executa com multithreads 
            If nQtdThd > 1              
                //Varre a tabela para separar a execução em grupos
                While (cAliasReg)->(!Eof())
                    nContTot++
                    nCont++

                    //Dados do registro em processamento
                    cFilReg     := (cAliasReg)->T2G_FILIAL
                    cCPFReg     := (cAliasReg)->T2G_CPFBEN
                    cPerReg     := (cAliasReg)->T2G_PERAPU
                    cRecnoReg   := (cAliasReg)->R_E_C_N_O_

                    //Proximo registro
                    (cAliasReg)->(dbSkip())

                    //Se atingiu o limite do grupo, cria o array com os dados de processamento
                    //Se não, adiciona no item do grupo
                    If (cAliasReg)->(Eof()) .Or. ((nCont >= nQtdIThd .And. ((nQtdItens - nContTot) >= nMinItThd) .And. cCPFReg <> (cAliasReg)->T2G_CPFBEN))
                        aAdd(aItGrpThd, {cFilReg, cCPFReg, cPerReg, cRecnoReg, nContTot})
                        aAdd(aGrpThd, {nQtdAppend, aClone(aItGrpThd), cCodRec})
                        
                        //Zera variáveis pra o próximo grupo
                        aItGrpThd   := {}
                        nCont       := 0
                    Else
                        aAdd(aItGrpThd, {cFilReg, cCPFReg, cPerReg, cRecnoReg, nContTot})
                    EndIf
                EndDo

                //Chama a execução de cada Thread
                For nX := 1 To Len(aGrpThd)                  
                    StartJob("totvs.protheus.rh.treportsintegratedprovider.GPE087Thd", GetEnvServer(), .F., cEmpAnt, cFilAnt, __cUserId, aGrpThd[nX], cTicket, "GPE087Thd_" + cValToChar(nX), jInscFils, jLGPD)
                    Sleep(1000)	//Aguarda para abertura da thread
                Next nX

                DbSelectArea("RU5")
                DbSetOrder(3)//RU5_FILIAL+RU5_ID+RU5_CPF+RU5_TIPO+RU5_SEQ

                DbSelectArea("RU4")
                DbSetOrder(1)

                //Confirma se já terminou o processamento do relatório.
                For nX := 1 To 3600000
                    Sleep(5000) 
                    RU4->(dbGoTop())
                    If Posicione("RU4", 1, xFilial("RU4") + cTicket, "RU4_PERC") >= 100
                        SetFinish(cTicket)
                        Exit
                    Else
                        RU5->(DbGoTop())
                        If RU5->(dbSeek( xFilial("RU5") + cTicket))
                            While RU5->RU5_FILIAL + RU5->RU5_ID == xFilial("RU5") + cTicket
                                
                                If RU5->RU5_AVISO <> "1"
                                    oResp:FromJson( RU5->RU5_RESP )
                                    self:appendData(oResp)
                                    
                                    RecLock("RU5", .F.)
                                        RU5_AVISO := "1"
                                    RU5->(MsUnlock())
                                    Exit
                                EndIf
                                
                                RU5->(dbSkip())

                                FwFreeObj(oResp)
                                oResp := JsonObject():New()
                            EndDo

                            //Garante a contagem do relatório
                            AltPerRU4(cTicket, nQtdAppend)
                        EndIf                   
                    EndIf
                Next nX

                FwFreeObj(oResp)
                oResp := JsonObject():New()

                RU5->(DbGoTop())
                If RU5->(dbSeek( xFilial("RU5") + cTicket))
                    While RU5->RU5_FILIAL + RU5->RU5_ID == xFilial("RU5") + cTicket
                        
                        If RU5->RU5_AVISO <> "1"
                            oResp:FromJson( RU5->RU5_RESP )
                            self:appendData(oResp)
                            
                            RecLock("RU5", .F.)
                                RU5_AVISO := "1"
                            RU5->(MsUnlock())
                        EndIf

                        RU5->(dbSkip())

                        FwFreeObj(oResp)
                        oResp := JsonObject():New()
                    EndDo

                EndIf              
            Else
                //Varre todos os registros encontrados
                While !(cAliasReg)->(Eof())
                    nItem++
                    //Posiciona no registro da tabela T2G
                    ("T2G")->(DbGoTo((cAliasReg)->R_E_C_N_O_))

                    //Encontra a raiz de CNPJ da filial processada
                    If !Empty((cAliasReg)->T2G_FILIAL)
                        cInscFil := jInscFils[(cAliasReg)->T2G_FILIAL]
                    EndIf

                    //Atualiza a chave do item da query
                    cChvItem    := cInscFil + (cAliasReg)->T2G_CPFBEN

                    //Recupera o arquivo XML do evento S-5002
                    cXML5002 := TAF422Xml()

                    //Varre o arquivo XML para gravação do jRegistros 
                    If !Empty(cXML5002)
                        //Identifica os dados da fonte pagadora
                        If jInscFils[cT2GFIL] <> jInscFils[(cAliasReg)->T2G_FILIAL]
                            cMatriz := fVldMatriz((cAliasReg)->T2G_FILIAL, (cAliasReg)->T2G_PERAPU)
                            
                            //Busca os dados da empresa nos moldes do informe de rendimento
                            fInfo(@aInfo, cMatriz)                    
                            If Len(aInfo) > 0
                                cCNPJEmp    := AllTrim(aInfo[8])
                                cNomeEmp    := AllTrim(aInfo[3])
                            EndIf
                            
                            cT2GFIL := (cAliasReg)->T2G_FILIAL
                        EndIf

                        //Carrega o nome do trabalhador
                        If cCPFTrab <> (cAliasReg)->T2G_CPFBEN
                            cCPFTrab    := (cAliasReg)->T2G_CPFBEN
                            cNomeTrab   := AllTrim(Posicione("SRA", 20, cCPFTrab, "RA_NSOCIAL"))
                            If Empty(cNomeTrab) .And. !Empty(SRA->RA_NOMECMP)
                                cNomeTrab   := AllTrim(SRA->RA_NOMECMP)
                            Else
                                cNomeTrab   := AllTrim(SRA->RA_NOME)
                            EndIf
                        EndIf

                        //Carrega lista de dependentes do beneficiários
                        If Len(jListDep:GetNames()) == 0
                            jListDep := fCarrDep(cCPFTrab)
                        EndIf

                        cNomeTrab   := Iif(jLGPD["RA_MAT"], FwProtectedDataUtil():ValueAsteriskToAnonymize(cNomeTrab), cNomeTrab)
                        cCPFTrab    := Iif(jLGPD["RA_CIC"], FwProtectedDataUtil():ValueAsteriskToAnonymize(cCPFTrab), cCPFTrab) 

                        fProcXML(EncodeUTF8(cXML5002), @aItem, cCodRec)
                    EndIf

                    (cAliasReg)->(dbSkip())

                    //Atualiza a inscrição
                    If !Empty((cAliasReg)->T2G_FILIAL)
                        cInscFil := jInscFils[(cAliasReg)->T2G_FILIAL]
                    EndIf

                    //Zera e iniciai os objetos de retorno ao alterar o funcionário
                    If (cChvItem <> cInscFil + (cAliasReg)->T2G_CPFBEN) .Or. (cAliasReg)->(Eof())
                        
                        //Adiciona os dados do primeiro funcionário
                        If !Empty(cChvItem) .Or. (cAliasReg)->(Eof())
                            For nX := 1 To Len(aItem)
                                self:appendData(aItem[nX])
                                //Chama a gravação do json na tabela RU5  
                                nQtdChv++
                                GrvItRes(aItem[nX]:ToJson(), StrZero(nQtdChv, 6), .F., "1", cCPFTrab, cTicket)  
                            Next nX
                            
                            //Zera o array de items pois já processou o funcionário
                            aItem       := {}
                            FwFreeObj(jListDep)
                            jListDep := JsonObject():New()
                        EndIf
                
                    EndIf

                    //Reinicia variáveis
                    cXML5002    := ""

                    //Incrementa o percentual de progresso
                    SetPerc( cTicket, nItem, nQtdItens )
                
                    //Indica a finalização do progresso
                    If nItem == nQtdItens
                        SetFinish(cTicket)
                    EndIf
                EndDo
            EndIf
        EndIf

        (cAliasReg)->(DBCloseArea()) 
    EndIf

return self:oData


