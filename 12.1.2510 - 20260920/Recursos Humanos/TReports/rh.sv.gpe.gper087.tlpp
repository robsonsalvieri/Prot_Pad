/*/{Protheus.doc} GeraTicket
@type			function
@description	Cria e armazena ticket da requisição relatório.
@author			lidio.oliveira
@since			23/02/2026
@paramam		cReqJSon    -   Json da requisição
@return			cTicket		-	Ticket da requisição
/*/
//-------------------------------------------------------------------------------------------------
Static Function GeraTicket(cReqJSon)

    Local cTicket	As Character
    Local cServ		As Character
    Local cMetodo	As Character

    Default cReqJSon    := ""

    cTicket	:= FWuuId("rh.sv.gpe.gper087")
    cServ 	:= "totvs.protheus.rh.treportsintegratedprovider.gper087treportsbusinessobject"
    cMetodo	:= "POST"

    fGrvRU4(cTicket, cServ, cMetodo, Date(), StrTran( Time(), ":", "" ), "1", cReqJSon)

Return cTicket


//---------------------------------------------------------------------
/*/{Protheus.doc} SetPerc
@type			function
@description	Incrementa o percentual de processamento da requisição.
@author			lidio.oliveira
@since			23/02/2026
/*/
//---------------------------------------------------------------------
Static Function SetPerc(cTicket as Character, nItem as Numeric, nQtdRegs as Numeric, nPeso as Numeric)

    Local lRet		As Logical
    Local nPerc     As Numeric
    Local nPercHM   As Numeric
    Local nDif      As Numeric
    Local aAreaRU4  As Array

    Default cTicket     := ""
    Default nItem       := 1
    Default nQtdRegs    := 1
    Default nPeso       := 100 //-- 100 Significa que o processamento tem uma etapa, 50 duas etapas (%)

    lRet        := .F.
    nPerc       := 0
    PercHM      := 0
    nDif        := 0
    aAreaRU4    := RU4->(GetArea())

    If RU4->( dbSeek( xFilial( "RU4" ) + PadR( cTicket, TamSX3( "RU4_ID" )[1] ) ) )
        nPercHM := RU4->RU4_PERC
    EndIf

    nPerc := (Int( ( nItem / nQtdRegs ) * 100 ) * (nPeso/100))
    nDif := (nPerc - nPercHM)

    If nPerc > 0
        Iif(nPercHM >= nPeso, nPerc := (nPeso + nPerc), nPerc := (nPercHM + nDif))

        RecLock("RU4", .F.)
            RU4->RU4_PERC := Int( nPerc )
        RU4->(MsUnlock())
    EndIf

    If Len(aAreaRU4) > 0
        RestArea(aAreaRU4)
    EndIf

Return


//---------------------------------------------------------------------
/*/{Protheus.doc} SetFinish
@type			function
@description	Indica a finalização do processamento da requisição.
@author			lidio.oliveira
@since			23/02/2026
@param			cTicket	-	Identificador da Requisição
@param			aValues	-	Valores do relatório
/*/
//---------------------------------------------------------------------
Static Function SetFinish(cTicket As Character)

    Local aAreaRU4 As Array

    Default	cTicket := ""

    aAreaRU4 := {}

    aAreaRU4 :=	RU4->( GetArea() )
    RU4->(DbSetOrder(1))
    lNovo := RU4->( !dbSeek( xFilial( "RU4" ) + PadR( cTicket, TamSX3( "RU4_ID" )[1] ) ))

    If RU4->( RecLock("RU4", lNovo) )
        RU4->RU4_STATUS		:= "2"
        RU4->RU4_DTRESP		:= Date()
        RU4->RU4_HRRESP		:= StrTran( Time(), ":", "")
        RU4->(MsUnlock())
    EndIf

    If Len(aAreaRU4) > 0
        RestArea( aAreaRU4 )
    EndIf

Return


//---------------------------------------------------------------------
/*/{Protheus.doc} GrvItRes
@type			function
@description	Grava o item do resultado da requisição.
@author			lidio.oliveira
@since			23/02/2026
@param			cResp		-	Resposta da API
@param			cSeq		-	Sequencial
@param			lDiverg		-	Valor Folha e Governo Divergentes
@param			cTipo		-	1- Sintético 2 - Analítico
@param			cCPF		-	CPF do Funcionário
@param			cTicket		-	Ticket da requisição
@param			cNivel		-	Nível da Requisição
@param			cCodRec		-	Código de Receita
/*/
//---------------------------------------------------------------------
Static Function GrvItRes(cResp, cSeq, lDiverg, cTipo, cCPF, cTicket, cNivel, cCodRec)

    Local lNovo As Logical
    
    Default cResp       := ""       //Json de resposta
    Default cSeq        := ""       //Código de sequencia do Item
    Default lDiverg		:= .F.      //Indica se o item possui divergência
    Default cTipo       := ""       //Indica o tipo de resposta 1 - Sintético e 2 - Analítico
    Default cCPF		:= ""       //CPF dp funcionário caso o registro seja específico
    Default cTicket		:= ""       //Código do ticket de processamento
    Default cNivel  	:= ""       //Nível da Requisição 
    Default cCodRec 	:= ""       //Código de Receita

    lNovo := .T.     

	//RU5_FILIAL+RU5_ID+RU5_TIPO+RU5_SEQ+RU5_NIVEL
	RU5->(DbSetOrder(1))
    lNovo := RU5->( !dbSeek( xFilial("RU5") + cTicket + cTipo + cSeq + cNivel ))

    If RU5->( RecLock("RU5", lNovo) )
		RU5->RU5_ID			:= cTicket
		RU5->RU5_RESP		:= cResp
		RU5->RU5_SEQ		:= cSeq
		RU5->RU5_DIVERG		:= Iif(lDiverg, "1", "2" )
		RU5->RU5_TIPO		:= cTipo
		RU5->RU5_CPF		:= cCPF
		RU5->RU5_NIVEL      := cNivel
		RU5->(MsUnlock())
	EndIf

Return


//---------------------------------------------------------------------
/*/{Protheus.doc}
    @Author    lidio.oliveira
    @Date      20/02/2026
    @Type      Static Function
    Função filtrar os registros da tabela T2G agrupando por CPF de acordo com os parâmetros informados
/*/
//---------------------------------------------------------------------
Static Function fT2GCPF(oQryCPF, aFiliais, cCPFDe, cCPFAte, cAnoBase, cFiltro, lFiltraFil)

    Local cQuery        As Character
	Local cAliasReg     As Character
    Local nParamOrder   As Numeric

    Default oQryCPF    := Nil
    Default aFiliais   := {}
    Default cCPFDe     := ""
    Default cCPFAte    := "ZZZZZZZZZZZ"
    Default cAnoBase   := ""
    Default cFiltro    := ""
    Default lFiltraFil := .F.

    cQuery        := ""
	cAliasReg     := GetNextAlias()
    nParamOrder   := 1

    If oQryCPF == Nil
        cQuery := "SELECT SUBSTRING(M0_CGC, 1 , 8) AS M0_CGC, T2G.T2G_CPFBEN, COUNT(*) AS TOTALREG"
        cQuery += "FROM " + RetSqlName('T2G') + " T2G "
        cQuery += "INNER JOIN SYS_COMPANY SM0 ON SM0.M0_CODFIL = T2G.T2G_FILIAL " 
        cQuery += "WHERE SUBSTRING(T2G.T2G_PERAPU, 1, 4) = ? "                      //cAnoBase
		cQuery += "AND T2G.T2G_CPFBEN BETWEEN ? AND ? "                             //cCPFDe e cCPFAte
        cQuery += "AND T2G.T2G_ATIVO = ? "                                          //1
        If lFiltraFil
            cQuery += "AND T2G.T2G_FILIAL IN (?) "                                  //aFiliais
        EndIf
        cQuery += "AND SM0.M0_CODIGO = ? " 
        cQuery += "AND T2G.D_E_L_E_T_ = ? "
        cQuery += "AND SM0.D_E_L_E_T_ = ? "
        cQuery += " ? "  
        cQuery += "GROUP BY SUBSTRING(M0_CGC, 1 , 8), T2G.T2G_CPFBEN "
        cQuery += "ORDER BY SUBSTRING(M0_CGC, 1 , 8), T2G.T2G_CPFBEN "

        cQuery := ChangeQuery(cQuery)
        oQryCPF := FwExecStatement():New(cQuery)
    EndIf

    oQryCPF:SetString(nParamOrder++, cAnoBase) 
    oQryCPF:SetString(nParamOrder++, cCPFDe)
    oQryCPF:SetString(nParamOrder++, cCPFAte)
    oQryCPF:SetString(nParamOrder++, "1")             //T2G.T2G_ATIVO
    If lFiltraFil
        oQryCPF:SetIN(nParamOrder++, aFiliais)        //aFiliais
    EndIf
    oQryCPF:SetString(nParamOrder++, cEmpAnt)         //cEmpAnt
    oQryCPF:SetString(nParamOrder++, " ")             //D_E_L_E_T_
    oQryCPF:SetString(nParamOrder++, " ")             //D_E_L_E_T_

    oQryCPF:SetUnsafe(nParamOrder++, cFiltro) 

    // Executa a query e retorna o alias criado
    cAliasReg := oQryCPF:OpenAlias()

Return cAliasReg


//---------------------------------------------------------------------
/*/{Protheus.doc} GPE087Thd
@type			function
@description	Grava o item do resultado da requisição.
@author			lidio.oliveira
@since			23/02/2026
@param			aItensThd		-	array de itens para processamento
@param			cTicket		-	ticket para atualização do percentual
/*/
//---------------------------------------------------------------------
Function GPE087Thd(xEmp, xFil, xUser, aItensThd, cTicket, cNameThd, jInscFils, jLGPDReq)

    Local nX        := 0
	Local nY		:= 0
	Local nQtdChv	:= 0
    Local nQtdItens := 0
	Local nThread	:= 0
	Local cInscFil	:= ""
	Local cChvItem	:= ""
	Local cXML5002	:= ""
	Local cMatriz	:= ""
	Local cT2GFIL	:= ""
	Local cCodRec	:= ""
	Local cProxCPF	:= ""
    Local cUser		:= "__cUser"
    Local cId		:= "Id"
	Local aInfo		:= {}

    Private lMiddleware := .F.
    Private JTpsRend    := JsonObject():New()
    Private jDescRend   := JsonObject():New()
    Private jDescCR     := JsonObject():New()
    Private jDescPrevC  := JsonObject():New()
    Private jListDep    := JsonObject():New()
    Private jIndOrgRM   := JsonObject():New()
	Private jLGPD		:= JsonObject():New()
    Private aItem       := {}
    Private aSM0        := {}
    Private aTpsRend    := {}  
    Private cCNPJEmp    := ""
    Private cNomeEmp    := ""
    Private cCPFTrab    := ""
    Private cNomeTrab   := ""

    Default xEmp        := ""
    Default xFil        := ""
    Default xUser       := ""
    Default aItensThd   := {}
    Default cTicket     := ""
    Default cNameThd    := ""
	Default jInscFils	:= JsonObject():New()
	Default jLGPDReq	:= JsonObject():New()

    cUser   := "__cUser"

	//Prepara ambiente
	RPCSetType( 3 )
	RpcSetEnv( xEmp, xFil,,,'GPE')
	SetsDefault()
	IIf(Empty(cFilAnt), cFilAnt:= xFil,)

	&(cUser + cId) := xUser

    //Carrega objeto com os dados LGPD
	jLGPD := jLGPDReq

    //Monta objeto com os tipos de rendimentos
    JTpsRend := fTpRend087()

    //Mantém array com os tipos rendimentos
    aTpsRend := JTpsRend:GetNames()

    //Monta objeto com a descrição de rendimento
    jDescRend := fDRend087()

    //Monta objeto com a descrição dos códigos de receita
    jDescCR := fDCodRec087()

    //Monta objeto com as descrições dos tipos de previdência complementar
    jDescPrevC := fDPrev087()

    //Monta objeto com as descrições com os indicativos de origem do reembolso
    jIndOrgRM := fDOrReem087()

    //Processa o grupo
    If Len(aItensThd) > 0
        nQtdItens := aItensThd[1]
		cCodRec	  := aItensThd[3]
		nThread   := Val(Substr(cNameThd, At("_", cNameThd) + 1, 2))

        //Processa cada item do grupo
        For nX := 1 To Len(aItensThd[2])
			//Posiciona no registro da tabela T2G
			("T2G")->(DbGoTo(aItensThd[2][Nx][4]))

			//Encontra a raiz de CNPJ da filial processada
			If !Empty(aItensThd[2][Nx][1])
				cInscFil := jInscFils[aItensThd[2][Nx][1]]
			EndIf

			//Atualiza a chave do item da query
			cChvItem    := cInscFil + aItensThd[2][Nx][2]

			//Recupera o arquivo XML do evento S-5002
			cXML5002 := TAF422Xml()

			//Varre o arquivo XML para gravação do jRegistros 
			If !Empty(cXML5002)
				//Identifica os dados da fonte pagadora
				If jInscFils[cT2GFIL] <> jInscFils[aItensThd[2][Nx][1]]
					cMatriz := fVldMatriz(aItensThd[2][Nx][1], aItensThd[2][Nx][3])
					
					//Busca os dados da empresa nos moldes do informe de rendimento
					fInfo(@aInfo, cMatriz)                    
					If Len(aInfo) > 0
						cCNPJEmp    := AllTrim(aInfo[8])
						cNomeEmp    := AllTrim(aInfo[3])
					EndIf
					
					cT2GFIL := aItensThd[2][Nx][1]
				EndIf

				//Carrega o nome do trabalhador
				If cCPFTrab <> aItensThd[2][Nx][2]
					cCPFTrab    := aItensThd[2][Nx][2]
					cNomeTrab   := AllTrim(Posicione("SRA", 20, cCPFTrab, "RA_NSOCIAL"))
					If Empty(cNomeTrab) .And. !Empty(SRA->RA_NOMECMP)
						cNomeTrab   := AllTrim(SRA->RA_NOMECMP)
					Else
						cNomeTrab   := AllTrim(SRA->RA_NOME)
					EndIf
				EndIf

				//Carrega lista de dependentes do beneficiários
				If Len(jListDep:GetNames()) == 0
					jListDep := fCarrDep(cCPFTrab)
				EndIf

				cNomeTrab   := Iif(jLGPD["RA_MAT"], FwProtectedDataUtil():ValueAsteriskToAnonymize(cNomeTrab), cNomeTrab)
				cCPFTrab    := Iif(jLGPD["RA_CIC"], FwProtectedDataUtil():ValueAsteriskToAnonymize(cCPFTrab), cCPFTrab) 
				fProcXML(EncodeUTF8(cXML5002), @aItem, cCodRec)
			EndIf

			//Atualiza a inscrição
			If nX <> Len(aItensThd[2]) .And. nX + 1 <= Len(aItensThd[2])
                cInscFil := jInscFils[aItensThd[2][Nx + 1][1]]  
                cProxCPF := aItensThd[2][Nx + 1][2]
            EndIf
         
			If (cChvItem <> cInscFil + cProxCPF) .Or. nX == Len(aItensThd[2])
				
				//Adiciona os dados do primeiro funcionário
				If !Empty(cChvItem) .Or. nX == Len(aItensThd[2])
					For nY := 1 To Len(aItem)
						nQtdChv++
						GrvItRes(aItem[nY]:ToJson(), StrZero(nThread, 2) + StrZero(nQtdChv, 4), .F., "1", cCPFTrab, cTicket)
					Next nY
					
					//Zera o array de items pois já processou o funcionário
					aItem       := {}
					FwFreeObj(jListDep)
					jListDep := JsonObject():New()
				EndIf
		
			EndIf

			//Reinicia variáveis
			cXML5002    := ""

			//Altera o percentual de progresso
			AltPerRU4(cTicket, nQtdItens)
        Next nX
    EndIF

Return


//---------------------------------------------------------------------
/*/{Protheus.doc} AltPerRU4
@type			function
@description	Incrementa o percentual de processamento da requisição.
@author			lidio.oliveira
@since			23/02/2026
/*/
//---------------------------------------------------------------------
Static Function AltPerRU4(cTicket, nQtdRegs)

    Local nPerc     As Numeric
	Local nItensGrv	As Numeric
    Local aAreaRU4  As Array

    Default cTicket     := ""
    Default nQtdRegs    := 1

    nPerc       := 0
    aAreaRU4    := RU4->(GetArea())
	
	RU4->( dbSeek( xFilial( "RU4" ) + PadR( cTicket, TamSX3( "RU4_ID" )[1] ) ) )

	nItensGrv := fQtdRU5(cTicket)

    nPerc := Int( ( nItensGrv / nQtdRegs ) * 100 )

    If nPerc > 0
        RecLock("RU4", .F.)
            RU4->RU4_PERC := nPerc
        RU4->(MsUnlock())
    EndIf

    If Len(aAreaRU4) > 0
        RestArea(aAreaRU4)
    EndIf

Return


//---------------------------------------------------------------------
/*/{Protheus.doc} fQtdRU5
@type			function
@description	busca qts registros há na RU5
@author			lidio.oliveira
@since			23/02/2026
/*/
//---------------------------------------------------------------------
Static Function fQtdRU5(cTicket)

    Local cQuery 		As Character
	Local cAlias 		As Character
	Local nParamOrder	As Numeric
	Local nRet   		As Numeric

    Default cTicket     := ""

	cQuery 			:= ""
	cAlias 			:= GetNextAlias()
    nParamOrder   	:= 1
	nRet			:= 0

    If oQryRU5 == Nil
        cQuery := "SELECT COUNT(*) AS QTDREG"
        cQuery += "FROM " + RetSqlName('RU5') + " RU5 "
        cQuery += "WHERE RU5.RU5_FILIAL = ? "
		cQuery += "AND RU5.RU5_ID = ? "                      //TICKET
        cQuery += "AND RU5.D_E_L_E_T_ = ? "

        cQuery := ChangeQuery(cQuery)
        oQryRU5 := FwExecStatement():New(cQuery)
    EndIf

    oQryRU5:SetString(nParamOrder++, xFilial("RU5")) 
    oQryRU5:SetString(nParamOrder++, cTicket)
	oQryRU5:SetString(nParamOrder++, " ")

    // Executa a query e retorna o alias criado
    cAlias := oQryRU5:OpenAlias()

	If (cAlias)->(!EoF())
		nRet := (cAlias)->QTDREG
	EndIf

	(cAlias)->(dbCloseArea())

Return nRet
