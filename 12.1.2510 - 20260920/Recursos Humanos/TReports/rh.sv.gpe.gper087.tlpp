/*/{Protheus.doc} GPER087TReportsBusinessObject:getSchema()
    Define o schema do objeto de negócio.
    @type Method
    @version 12.1.2510
    @author lidio.oliveira
    @since 21/01/2026
    @return Object, Schema do objeto de negócio
/*/
//-------------------------------------------------------------------------------------------------
Method getSchema() As Object Class GPER087TReportsBusinessObject
    
    // Declaração das variáveis locais
    Local aFields   As Array // Campos das propriedades aninhadas
    Local aFields2  As Array // Campos das propriedades aninhadas
    Local aFields3  As Array // Campos das propriedades aninhadas
    Local aFields4  As Array // Campos das propriedades aninhadas

    // Inicialização das variáveis
    aFields     := {}
    aFields2    := {}
    aFields3    := {}
    aFields4    := {}

    // Define os parâmetros do relatório
    self:oSchema:addParameter("CNPJDe",         STR0004, "string", .F., NIL, NIL, NIL, NIL, NIL, STR0027) //  "CNPJ De" - "Informe um CNPJ para a realização de filtro. Importante: Será considerada a raiz do CNPJ informado, pois são realizadas buscas na filial matriz e nas demais filiais."
    self:oSchema:addParameter("CNPJAte",        STR0005, "string", .F., NIL, NIL, NIL, NIL, NIL, STR0027) //  "CNPJ Até" - "Informe um CPF para a realizaçao de filtro."
    self:oSchema:addParameter("CPFDe",          STR0008, "string", .F., NIL, NIL, NIL, NIL, NIL, STR0028) //  "CPF De" - "Informe um CPF para a realizaçao de filtro."
    self:oSchema:addParameter("CPFAte",         STR0009, "string", .F., NIL, NIL, NIL, NIL, NIL, STR0028) //  "CPF Até" - "Informe um CPF para a realizaçao de filtro."
    self:oSchema:addParameter("AnoBase",        STR0010, "string", .F., NIL, NIL, NIL, NIL, NIL, STR0029) //  "Ano Base" - "Informe o Ano Base para a realização de filtro. Importante: O modelo do relatório utiliza informações do evento S-5002 a partir do leiaute S-1.3, portanto utilize a partir do ano 2025."
    self:oSchema:addParameter("CodReceita",     STR0030, "string", .F., NIL, NIL, NIL, NIL, NIL, STR0031) //  "Código de Receita" - "Informe um código de receita para a realização de filtro."

