#Include "TOTVS.FRAMEWORK.TREPORTS.INTEGRATEDPROVIDER.th"
#Include "TLPP-CORE.th"
#Include "TLPP-REST.th"
#Include "rh.sv.gpe.GPER050a.ch"

Static lBasIRMAnt := .F.
Static aDataPgFer := {}
Static aPerFer    := {}

namespace totvs.protheus.rh.treportsintegratedprovider
using namespace totvs.framework.treports.integratedprovider

/*/{Protheus.doc} GPER050ATReportsBusinessObject:new()
    Classe do objeto de negócio do Relatório DIRF Mensal
    @type Class
    @version 12.1.2510
    @author karina.alves
    @since 01/10/2025
/*/
@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGAGPE", tables="SRA", name="DIRF Mensal", customTables = "SRA", country="ALL", initialRelease="12.1.2310")
Class GPER050ATReportsBusinessObject From IntegratedProvider
    // Define os métodos da classe
    Public Method new()       As Object
    Public Method getData()   As Object
    Public Method getSchema() As Object

    @Get("/api/rh/smartview/v1/options/GPER050A/:param")
    Public Method getComboBox() As Variant
EndClass

/*/{Protheus.doc} GPER050ATReportsBusinessObject:new()
    Instancia a classe do objeto de negócio.
    @type Method
    @version 12.1.2510
    @author karina.alves
    @since 01/10/2025
    @return Object, Instância do objeto de negócio
/*/
Method new() As Object Class GPER050ATReportsBusinessObject
    // Chama o construtor da classe super
    _Super:new()

    // Define a área
    self:appendArea(STR0001) // "RH"

    // Define o nome e descrição do objeto de negócio
    self:setDisplayName(STR0002) // "DIRF Mensal"
    self:setDescription(STR0003) // "Este objeto de negócio emite o Relatório DIRF Mensal."

Return self

/*/{Protheus.doc} GPER050ATReportsBusinessObject:getData()
    Captura os dados do objeto de negócio.
    @type Method
    @version 12.1.2410
    @author karina.alves
    @since 14/09/2025
    @return Object, Dados do objeto de negócio
/*/
Method getData(nPage As Numeric, oFilter As Object) As Object Class GPER050ATReportsBusinessObject
    // Declaração das variáveis locais
    Local cQuery                As Character // Query para busca dos registros
    Local cAlias                As Character // Alias do arquivo temporário
    Local cAlias2               As Character // Alias do arquivo temporário
    Local cCustomFields         As Character // Campos customizados no formato SQL
    Local cName                 As Character // Nome real do campo
    Local cSituacao             As Character // Situação
    Local cFiltro               As Character // Filtro do objeto de negócio
    Local cCategoria            As Character // Categoria
    Local cAcessaSRA            As Character // Valida acesso a SRA
    Local cAcessaSRE            As Character // Valida acesso a SRE
    Local cFilExec              As Character // Filial Execução
    Local cEmpExec              As Character // Empresa Execução
    Local cFilialAnt            As Character // Filial anterior
    Local jRegistros            As JSON      // Informações de uma linha do ON
    Local jLGPD                 As JSON      // Indica quais campos devem ser ofuscados
    Local jParams               As JSON      // Parâmetros
    Local oExec                 As Object    // Instância da classe FwExecStatement
    Local oExec2                As Object    // Instância da classe FwExecStatement
    Local nParamOrder           As Numeric   // Ordem dos bind parameters da query
    Local nAux                  As Numeric   // Contador auxiliar para percorrer vetores
    Local nFields               As Numeric   // Contador de campos
    Local cJoinCTT              As Character // Join da Query SRA com CTT
    Local aVerba                As Array     // Verbas
    Local lPulaReg              As Logical

    //Parâmetros
    Local cCCDe                 As Character // Parâmetro Centro de Custo De
    Local cCCAte                As Character // Parâmetro Centro de Custo Até
    Local cNomeDe               As Character // Parâmetro Nome De
    Local cNomeAte              As Character // Parâmetro Nome Até
    Local aCategorias           As Array     // Parâmetro Categorias
    Local aSituacoes            As Array     // Parâmetro Situações
    Local cAnalSint             As Character // Parâmetro Analítica/Sintética
    Private cFilialDe           As Character // Parâmetro Filial De
    Private cFilialAte          As Character // Parâmetro Filial Até
    Private cMatDe              As Character // Parâmetro Matrícula De
    Private cMatAte             As Character // Parâmetro Matrícula Até
    Private cDataDe             As Character // Parâmetro Data De
    Private cDataAte            As Character // Parâmetro Data Até
    Private cProc               As Character // Parâmetro Processo

    Private aFolBas[4]
    Private aAdiBas[4]
    Private aFerBas[4]
    Private a13Bas[4]
    Private aPLRBas[4]
    Private aFolIR[4]
    Private aAdiIR[4]
    Private aFerIR[4]
    Private a13IR[4]
    Private aPLRIR[4]
    Private aCodFol             As Array
    Private cAcessaSRG          As Character // Valida acesso a SRG
    Private cAcessaSRC          As Character // Valida acesso a SRC
    Private cAcessaSRR          As Character // Valida acesso a SRR
    Private lRecalcIR           As Logical
    Private dDtGerCplAb         As Date
    Private dDtPgtoSem	        As Date
    Private cValidFil           As Character // Filiais válidas
    Private aTransf             As Array     // Transferências do funcionário
    Private aPerAberto          As Array     // Períodos abertos
    Private aPerFechado         As Array     // Períodos Fechados
    Private cVerbaSql           As Character
    Private dDataDe             As Date
    Private dDataAte            As Date
    Private lBsSRR              As Logical
    Private lIrSRR              As Logical
    Private aCodLido            As Array
    Private nomeprog	        := "GpeR050"

    // Inicialização das variáveis
    cQuery              := ""
    cAlias              := ""
    cAlias2             := ""
    cFiltro             := IIf(oFilter:hasFilter(), " AND " + oFilter:getSQLExpression(), "")
    jParams             := oFilter:getParameters()
    jData               := JSONObject():New()
    jLGPD               := JSONObject():New()
    jRegistros          := JSONObject():New()
    oExec               := NIL
    oExec2              := NIL
    nParamOrder         := 1
    nAux                := 0
    nFields             := 1
    aPDFields           := {}
    cFilialDe           := ""
    cFilialAte          := ""
    cMatDe              := ""
    cMatAte             := ""
    cCCDe               := ""
    cCCAte              := ""
    cNomeDe             := ""
    cNomeAte            := ""
    cDataDe             := ""
    cDataAte            := ""
    cVerbaSql           := ""
    cAnalSint           := ""
    cProc               := ""
    cFilialAnt          := ""
    cJoinCTT            := FWJoinFilial("SRA", "CTT")
    aCategorias         := {}
    aSituacoes          := {}
    aAllFields          := {}
    lObfuscated         := .F.
    cValidFil           := fValidFil()
    cAcessaSRA          := &("{ || " + ChkRH("GPER050A","SRA","2") + "}")
    cAcessaSRC          := &("{ || " + ChkRH("GPER050A","SRC","2") + "}")
    cAcessaSRG          := &("{ || " + ChkRH("GPER050A","SRG","2") + "}")
    cAcessaSRR          := &("{ || " + ChkRH("GPER050A","SRR","2") + "}")
    cAcessaSRE          := &("{ || " + ChkRH("GPER050A","SRE","2") + "}")
    cFilExec            := AllTrim(FwFilialName())
    cEmpExec            := AllTrim(FwEmpName(cEmpAnt))
    aPerAberto          := {}
    aPerFechado         := {}
    aVerba              := {}
    aTransf             := {}
    aCodFol             := {}
    aCodLido            := {}
    dDataDe             := CtoD("//")
    dDataAte            := CtoD("//")
    lRecalcIR           := .F.
    dDtGerCplAb         := CtoD("//")
    dDtPgtoSem          := CtoD("//")
    lBsSRR              := .F.
    lIrSRR              := .F.
    lPulaReg            := .F.
    SetFunName("GPER050")

    // Verifica se precisa fazer o tratamento para LGPD
    aPDFields   := FwProtectedDataUtil():UsrAccessPDField(__cUserID, self:getArrayFields())
    lObfuscated := Len(aPDFields) != Len(self:getArrayFields())
    aAllFields  := self:getStructFields()

    // Adiciona no JSON todos os campos como atributos e com o conteúdo sendo uma flag que indica se o campo deve ser ofuscado
    For nFields := 1 To Len(aAllFields)
        cName        := Trim(aAllFields[nFields]:getName())
        jLGPD[cName] := AScan(aPDFields, {|x| Trim(x) == cName}) <= 0
    Next nFields

    // Captura o valor dos parâmetros
    If (jParams != NIL)
        cFilialDe   := IIf(jParams:hasProperty("FilialDe")       .and. Len(jParams["FilialDe"]) > 0      .and.!Empty(jParams["FilialDe"][1]),       jParams["FilialDe"][1],           "")
        cFilialAte  := IIf(jParams:hasProperty("FilialAte")      .and. Len(jParams["FilialAte"]) > 0     .and.!Empty(jParams["FilialAte"][1]),      jParams["FilialAte"][1],          Replicate("Z", GetSX3Cache("RA_FILIAL", "X3_TAMANHO")))
        cCCDe       := IIf(jParams:hasProperty("CCDe")           .and. Len(jParams["CCDe"]) > 0          .and.!Empty(jParams["CCDe"][1]),           jParams["CCDe"][1],               "")
        cCCAte      := IIf(jParams:hasProperty("CCAte")          .and. Len(jParams["CCAte"]) > 0         .and.!Empty(jParams["CCAte"][1]),          jParams["CCAte"][1],              Replicate("Z", GetSX3Cache("RA_CC", "X3_TAMANHO")))
        cMatDe      := IIf(jParams:hasProperty("MatriculaDe")    .and. Len(jParams["MatriculaDe"]) > 0   .and.!Empty(jParams["MatriculaDe"][1]),    jParams["MatriculaDe"][1],        "")
        cMatAte     := IIf(jParams:hasProperty("MatriculaAte")   .and. Len(jParams["MatriculaAte"]) > 0  .and.!Empty(jParams["MatriculaAte"][1]),   jParams["MatriculaAte"][1],       Replicate("Z", GetSX3Cache("RA_MAT", "X3_TAMANHO")))
        cNomeDe     := IIf(jParams:hasProperty("NomeDe")         .and. Len(jParams["NomeDe"]) > 0        .and.!Empty(jParams["NomeDe"][1]),         jParams["NomeDe"][1],             "")
        cNomeAte    := IIf(jParams:hasProperty("NomeAte")        .and. Len(jParams["NomeAte"]) > 0       .and.!Empty(jParams["NomeAte"][1]),        jParams["NomeAte"][1],            Replicate("Z", GetSX3Cache("RA_NOME", "X3_TAMANHO")))
        cDataDe     := IIf(jParams:hasProperty("DataDe")         .and. Len(jParams["DataDe"]) > 0        .and.!Empty(jParams["DataDe"][1]),         jParams["DataDe"][1],             "")
        cDataAte    := IIf(jParams:hasProperty("DataAte")        .and. Len(jParams["DataAte"]) > 0       .and.!Empty(jParams["DataAte"][1]),        jParams["DataAte"][1],            "")
        aCategorias := jParams["Categorias"]
        aSituacoes  := jParams["Situacoes"]
        cAnalSint   := IIf(jParams:hasProperty("AnalSint")      .and. Len(jParams["AnalSint"]) > 0     .and.!Empty(jParams["AnalSint"][1]),      jParams["AnalSint"][1],           "1") // 1 - Analítica e 2 - Sintética*/
        cOrdem      := IIf(jParams:hasProperty("Ordem")         .and. Len(jParams["Ordem"]) > 0        .and.!Empty(jParams["Ordem"][1]),         jParams["Ordem"][1],              "1") // 1 - Matrícula e 2 - Centro de Custo e 3 - Nome*/
        cProc       := IIf(jParams:hasProperty("Processo")      .and. Len(jParams["Processo"]) > 0     .and.!Empty(jParams["Processo"][1]),      jParams["Processo"][1],           "")
    EndIf

    aFill(aFolBas, 0)
	aFill(aAdiBas, 0)
	aFill(aFerBas, 0)
	aFill(a13Bas , 0)
	aFill(aPLRBas, 0)
	aFill(aFolIR , 0)
	aFill(aAdiIR , 0)
	aFill(aFerIR , 0)
	aFill(a13IR  , 0)
	aFill(aPLRIR , 0)

    // Trata as variáveis de data para ficarem no formato do banco
    cDataDe := StrTran(SubStr(cDataDe, 1, 10), "-", "")
    cDataAte := StrTran(SubStr(cDataAte, 1, 10), "-", "")

    dDataDe := STOD(cDataDe)
    dDataAte := STOD(cDataAte)

    If MesAno(dDataDe) <> MesAno(dDataAte)
        self:setErrorStatus(400, STR0025, STR0026) // "Aviso" | "As datas inicial e final devem estar dentro do mesmo mês e ano."
        FwLogMsg("WARN", NIL, "SmartView", NIL, NIL, NIL, STR0026)
        Return self:oData
    Endif

    // Passa as situações no vetor para uma string
    If (Len(aSituacoes) > 0)
        cSituacao := ""
        AEval(aSituacoes, {|x| cSituacao += IIf(x == NIL .or. Empty(x), " ", x)})
    EndIf

    // Passa as situações no vetor para uma string
    If (Len(aCategorias) > 0)
        cCategoria := ""
        AEval(aCategorias, {|x| cCategoria += IIf(x == NIL .or. Empty(x), " ", x)})
    EndIf

    // Percorre as categorias para tratar registro nulo ou em branco (caso não tratar dá erro no banco)
    For nAux := 1 To Len(aCategorias)
        aCategorias[nAux] := IIf(aCategorias[nAux] == NIL .or. Empty(aCategorias[nAux]), " ", aCategorias[nAux])
    Next nAux

    jRegistros["transferencias"] := {}
    jRegistros["funcionarios"] := {}

    BEGIN SEQUENCE
        //Busca por todos os contratos
        cQuery = "SELECT "
        cQuery +=     "SRA.RA_FILIAL, "
        cQuery +=     "SRA.RA_NOME, "
        cQuery +=     "SRA.RA_CC, "
        cQuery +=     "CTT.CTT_DESC01, "
        cQuery +=     "SRA.RA_PROCES, "
        cQuery +=     "SRA.RA_MAT "
        cQuery +=     "? "
        cQuery += "FROM "
        cQuery +=     RetSQLName("SRA") + " SRA "
        cQuery += " LEFT JOIN " + RetSQLName("CTT") + " CTT ON "
        cQuery +=       cJoinCTT
        cQuery +=       " AND CTT.CTT_CUSTO = SRA.RA_CC "
        cQuery +=       " AND CTT.D_E_L_E_T_ = ? "
        cQuery += "WHERE "
        cQuery +=     "SRA.RA_FILIAL       BETWEEN ? AND ? "
        cQuery +=     "AND SRA.RA_MAT      BETWEEN ? AND ? "
        cQuery +=     "AND SRA.RA_CC       BETWEEN ? AND ? "
        cQuery +=     "AND SRA.RA_NOME     BETWEEN ? AND ? "

        if Len(aSituacoes) > 0
            cQuery += "AND SRA.RA_SITFOLH IN (?)  "
        EndIf

        If Len(aCategorias) > 0
            cQuery += "AND SRA.RA_CATFUNC IN (?)  "
        EndIf

        If !Empty(cProc)
            cQuery += "AND SRA.RA_PROCES IN (?)  "
        EndIf

        cQuery +=     "AND SRA.D_E_L_E_T_ = ?  "

        cQuery +=       " ? "

        If cOrdem == '1' // Matrícula
            cQuery += "ORDER BY SRA.RA_FILIAL, RA_MAT "
        elseif cOrdem == '2' // Centro de Custo
            cQuery += "ORDER BY SRA.RA_FILIAL, RA_CC, RA_MAT "
        elseif cOrdem =='3' // Nome
            cQuery += "ORDER BY SRA.RA_FILIAL, RA_NOME, RA_MAT "
        EndIf

        cQuery := ChangeQuery(cQuery)
        oExec := FwExecStatement():New(cQuery)

        // Captura e define os campos personalizados das tabelas
        cCustomFields := GPESmartViewUtils():GetCustomFields(self:getCustomFields(), {"SRA"})
        oExec:SetUnsafe(nParamOrder++, IIf(!Empty(cCustomFields), "," + cCustomFields, ""))

        oExec:SetString(nParamOrder++, " ")

        // Filial
        oExec:SetString(nParamOrder++, cFilialDe)
        oExec:SetString(nParamOrder++, cFilialAte)

        // Matrícula
        oExec:SetString(nParamOrder++, cMatDe)
        oExec:SetString(nParamOrder++, cMatAte)

        //CC
        oExec:SetString(nParamOrder++, cCCDe)
        oExec:SetString(nParamOrder++, cCCAte)

        //Nome
        oExec:SetString(nParamOrder++, cNomeDe)
        oExec:SetString(nParamOrder++, cNomeAte)

        if Len(aSituacoes) > 0
            oExec:SetIN(nParamOrder++, aSituacoes)
        EndIf

        If Len(aCategorias) > 0
            oExec:SetIN(nParamOrder++, aCategorias)
        EndIf

        If !Empty(cProc)
            oExec:SetString(nParamOrder++, cProc)
        EndIf

        oExec:SetString(nParamOrder++, " ")

        oExec:SetUnsafe(nParamOrder++, cFiltro)

        cAlias := oExec:OpenAlias()

        // Percorre todos os registros
        While (!(cAlias)->(EOF()))
            If (Eval(cAcessaSRA) .and. (cAlias)->RA_FILIAL $ cValidFil)

                lBasIRMAnt := .F.
                dDtGerCplAb	:= CtoD("//")
                dDtPgtoSem	:= CtoD("//")

                aCodLido := {}
                aDataPgFer := {}

                //Reinicializa as Variáveis
                aFill(aFolBas, 0)
                aFill(aAdiBas, 0)
                aFill(aFerBas, 0)
                aFill(a13Bas , 0)
                aFill(aPLRBas, 0)
                aFill(aFolIR , 0)
                aFill(aAdiIR , 0)
                aFill(aFerIR , 0)
                aFill(a13IR  , 0)
                aFill(aPLRIR , 0)

                //Posiciona na SRA para que os filtros personalizados sejam executados.
                SRA->(DbSetOrder(1))
                SRA->(DbSeek((cAlias)->(RA_FILIAL + RA_MAT)))

                If Empty(aCodFol) .Or. cFilialAnt != (cAlias)->RA_FILIAL
                    cFilialAnt := (cAlias)->RA_FILIAL

                    //Carrega os períodos abertos e fechados de acordo com uma determinada competência
                    aPerAberto 	:= {}
                    aPerFechado := {}

                    fRetPerComp( Month2Str( dDataDe ), Year2Str(dDataDe ), xFilial('RCH', (cAlias)->RA_FILIAL), Nil, Nil, @aPerAberto, @aPerFechado,Nil,.T.,dDataDe,dDataAte)

                    //Carrega verbas a serem processadas, carrega apenas quando troca filia
                    If !RetVerPro(@aVerba, xFilial('SRV', (cAlias)->RA_FILIAL))
                        Exit
                    Endif
                endif

                /*Carrega as transferências do Funcionário*/
                fVerTransf( .F., aTransf , dDataDe, cEmpAnt, (cAlias)->RA_FILIAL, (cAlias)->RA_MAT )

                // Não processa SRC/SRD se o funcionário tem rescisão
                ProcRescisao(cAlias)

                //Processa movimento SRC / SRD
                ProcMovime(aPerAberto, aPerFechado, aVerba, cAlias)

                // Procura no SRH Funcionarios em Ferias
                ProcFerias(cAlias)

                lPulaReg := .F.

                //Verifica se total IR == 0
                If	FTotAcumuladores(4,4) == 0
                    lPulaReg :=  .T.
                Endif

                if !lPulaReg
                    AAdd(jRegistros["funcionarios"], {;
                        "Filial"       : Trim(Iif(jLGPD["RA_FILIAL"],   FwProtectedDataUtil():ValueAsteriskToAnonymize((cAlias)->RA_FILIAL),  (cAlias)->RA_FILIAL)) ,;
                        "Matricula"    : Trim(Iif(jLGPD["RA_MAT"],      FwProtectedDataUtil():ValueAsteriskToAnonymize((cAlias)->RA_MAT),     (cAlias)->RA_MAT)) ,;
                        "CC"           : Trim(Iif(jLGPD["RA_CC"],       FwProtectedDataUtil():ValueAsteriskToAnonymize((cAlias)->RA_CC),      (cAlias)->RA_CC)) ,;
                        "DescCC"       : Trim(Iif(jLGPD["CTT_DESC01"],  FwProtectedDataUtil():ValueAsteriskToAnonymize((cAlias)->CTT_DESC01), (cAlias)->CTT_DESC01)) ,;
                        "Nome"         : Trim(Iif(jLGPD["RA_NOME"],     FwProtectedDataUtil():ValueAsteriskToAnonymize((cAlias)->RA_NOME),    (cAlias)->RA_NOME)) ,;
                        "FolhaBs"      : aFolBas[4] ,;
                        "FolhaIR"      : aFolIR[4] ,;
                        "AdiBs"        : aAdiBas[4] ,;
                        "AdiIR"        : aAdiIR[4] ,;
                        "FerBs"        : aFerBas[4] ,;
                        "FerIR"        : aFerIR[4] ,;
                        "PLRBs"        : aPLRBas[4] ,;
                        "PLRIR"        : aPLRIR[4] ,;
                        "13Bs"         : a13Bas[4] ,;
                        "13IR"         : a13IR[4] ,;
                        "TotBs"        : aFolBas[4] + aAdiBas[4] + aFerBas[4] + aPLRBas[4] + a13Bas[4] ,;
                        "TotIR"        : aFolIR[4] + aAdiIR[4] + aFerIR[4] + aPLRIR[4] + a13IR[4];
                    })
                endif
            endif

            If (Eval(cAcessaSRE) .and. (cAlias)->RA_FILIAL $ cValidFil)
                nParamOrder := 1
                //Busca pelas transferências
                cQuery = "SELECT "
                cQuery +=     "SRE.RE_DATA "
                cQuery += "FROM "
                cQuery +=     RetSQLName("SRE") + " SRE "
                cQuery += "WHERE "
                cQuery +=     "(SRE.RE_FILIALD = ? AND SRE.RE_MATD = ?) "
                cQuery +=     "OR  (SRE.RE_FILIALP = ? AND  SRE.RE_MATP = ?) "
                cQuery +=     "AND (SRE.RE_DATA BETWEEN ? AND ?) "
                cQuery +=     "AND SRE.D_E_L_E_T_ = ?  "

                cQuery := ChangeQuery(cQuery)
                oExec2 := FwExecStatement():New(cQuery)

                oExec2:SetString(nParamOrder++, (cAlias)->RA_FILIAL)
                oExec2:SetString(nParamOrder++, (cAlias)->RA_MAT)
                oExec2:SetString(nParamOrder++, (cAlias)->RA_FILIAL)
                oExec2:SetString(nParamOrder++, (cAlias)->RA_MAT)
                oExec2:SetString(nParamOrder++, cDataDe)
                oExec2:SetString(nParamOrder++, cDataAte)
                oExec2:SetString(nParamOrder++, " ")

                cAlias2 := oExec2:OpenAlias()

                // Percorre todos os registros
                While (!(cAlias2)->(EOF()))
                    AAdd(jRegistros["transferencias"], {;
                        "FilTransf": (cAlias)->RA_FILIAL ,;
                        "MatTransf": (cAlias)->RA_MAT    ,;
                        "NomeTransf":(cAlias)->RA_NOME   ,;
                        "DataTransf": totvs.framework.treports.date.dateToTimeStamp(SToD((cAlias2)->RE_DATA)) ;
                    })

                    (cAlias2)->(DBSkip())
                enddo
            endif
            (cAlias)->(DBSkip())
        Enddo

        self:appendData({;
            "FilialExec"   : Trim(cFilExec) ,;
            "EmpresaExec"  : Trim(cEmpExec) ,;
            "funcionarios":               jRegistros["funcionarios"],;
            "transferencias":             jRegistros["transferencias"];
        })

    END SEQUENCE

    // Fecha a área da tabela temporária
    If !Empty(cAlias)
        (cAlias)->(DBCloseArea())
    Endif

    // Limpa os objetos da memória
    FwFreeObj(jLGPD)
	FwFreeObj(jParams)
    FwFreeObj(oExec)
    FwFreeArray(aAllFields)
    FwFreeArray(aPDFields)
    FwFreeArray(aCategorias)
    FwFreeArray(aSituacoes)
Return self:oData

/*/{Protheus.doc} GPER050ATReportsBusinessObject:getSchema()
    Define o schema do objeto de negócio.
    @type Method
    @version 12.1.2410
    @author karina.alves
    @since 14/09/2025
    @return Object, Schema do objeto de negócio
/*/
Method getSchema() As Object Class GPER050ATReportsBusinessObject
    // Declaração das variáveis locais
    Local aFields  As Array // Campos das propriedades aninhadas

    // Inicialização das variáveis
    aFields := {}

    // Define os parâmetros do relatório
    self:oSchema:addParameter("FilialDe",      STR0004 + ' ' + STR0005,     "string", .F., NIL, NIL, NIL, NIL, NIL, STR0004 + ' ' + STR0005) //  "Filial De"
    self:oSchema:addParameter("FilialAte",     STR0004 + ' ' + STR0006,     "string", .F., NIL, NIL, NIL, NIL, NIL, STR0004 + ' ' + STR0006) //  "Filial Até"
    self:oSchema:addParameter("CCDe",          STR0007 + ' ' + STR0005,     "string", .F., NIL, NIL, NIL, NIL, NIL, STR0007 + ' ' + STR0005) //  "Centro de Custo De"
    self:oSchema:addParameter("CCAte",         STR0007 + ' ' + STR0006,     "string", .F., NIL, NIL, NIL, NIL, NIL, STR0007 + ' ' + STR0006) //  "Centro de Custo Até"
    self:oSchema:addParameter("MatriculaDe",   STR0008 + ' ' + STR0005,     "string", .F., NIL, NIL, NIL, NIL, NIL, STR0008 + ' ' + STR0005) //  "Matrícula De"
    self:oSchema:addParameter("MatriculaAte",  STR0008 + ' ' + STR0006,     "string", .F., NIL, NIL, NIL, NIL, NIL, STR0008 + ' ' + STR0006) //  "Matrícula Até"
    self:oSchema:addParameter("NomeDe",        STR0009 + ' ' + STR0005,     "string", .F., NIL, NIL, NIL, NIL, NIL, STR0009 + ' ' + STR0005) //  "Nome De"
    self:oSchema:addParameter("NomeAte",       STR0009 + ' ' + STR0006,     "string", .F., NIL, NIL, NIL, NIL, NIL, STR0009 + ' ' + STR0006) //  "Nome Até"
    self:oSchema:addParameter("DataDe",        STR0010 + ' ' + STR0005,     "date",   .F., NIL, NIL, NIL, NIL, NIL, STR0010 + ' ' + STR0005) //  "Data De"
    self:oSchema:addParameter("DataAte",       STR0010 + ' ' + STR0006,     "date",   .F., NIL, NIL, NIL, NIL, NIL, STR0010 + ' ' + STR0006) //  "Data Até"
    self:oSchema:addParameter("Situacoes",     STR0011,                     "string", .T., NIL, NIL, NIL, NIL, NIL, STR0011)                 //  "Situações"
    self:oSchema:addParameter("Categorias",    STR0012,                     "string", .T., NIL, NIL, NIL, NIL, NIL, STR0012)                 //  "Categorias"
    self:oSchema:addParameter("AnalSint",      STR0013 + '/' + STR0014,     "string", .F., NIL, NIL, NIL, NIL, NIL, STR0013 + '/' + STR0014) //  "Analítica/Sintética"
    self:oSchema:addParameter("Ordem",         STR0027,                     "string", .F., NIL, NIL, NIL, NIL, NIL, STR0027)  //  "Ordem"
    self:oSchema:addParameter("Processo",      STR0031,                     "string", .F., NIL, NIL, NIL, NIL, NIL, STR0031)                 //  "Processo"


    // Define endpoints dos parâmetros de tipo lookup/combobox
    self:setCustomURL("FilialDe",        "/api/rh/smartview/v1/options/GPEParams/getBranches",       2)
    self:setCustomURL("FilialAte",       "/api/rh/smartview/v1/options/GPEParams/getBranches",       2)
    self:setCustomURL("CCDe",            "api/framework/v1/genericLookupService/smartview/CTT",      2)
    self:setCustomURL("CCAte",           "api/framework/v1/genericLookupService/smartview/CTT",      2)
    self:setCustomURL("MatriculaDe",     "/api/framework/v1/genericLookupService/smartview/SRA",     2)
    self:setCustomURL("MatriculaAte",    "/api/framework/v1/genericLookupService/smartview/SRA",     2)
    self:setCustomURL("Situacoes",       "/api/rh/smartview/v1/options/GPEParams/getSX5/31",         2)
    self:setCustomURL("Categorias",      "/api/rh/smartview/v1/options/GPEParams/getSX5/28",         2)
    self:setCustomURL("AnalSint",        "/api/rh/smartview/v1/options/GPER050A/AnalSint",           1)
    self:setCustomURL("Ordem",           "/api/rh/smartview/v1/options/GPER050A/Ordem",              1)
    self:setCustomURL("Processo",       "api/framework/v1/genericLookupService/smartview/RCJ",       2)

    // Adiciona as propriedades do objeto de negócio
    self:oSchema:addProperty("FilialExec",  STR0004 + ' ' + STR0015,    "string",  STR0004 + ' ' + STR0015,   "FilialExec",           NIL, NIL, NIL, .F.) // "Filial Execução"
    self:oSchema:addProperty("EmpresaExec", STR0016 + ' ' + STR0015,    "string",  STR0016 + ' ' + STR0015,   "EmpresaExec",          NIL, NIL, NIL, .F.) // "Empresa Execução"

    aFields := {}
    AAdd(aFields,{"Filial",       STR0004,                        "string", STR0004                }) // "Filial"
    AAdd(aFields,{"Matricula",    STR0008,                        "string", STR0008                }) // "Matrícula"
    AAdd(aFields,{"CC",           STR0007,                        "string", STR0007                }) // "Centro de Custo"
    AAdd(aFields,{"DescCC",       STR0017 + ' ' + STR0007,        "string", STR0017 + ' ' + STR0007}) // "Descrição Centro de Custo"
    AAdd(aFields,{"Nome",         STR0009,                        "string", STR0009                }) // "Nome"
    AAdd(aFields,{"FolhaBs",      STR0018 + ' ' + STR0019,        "number", STR0018 + ' ' + STR0019}) // "Folha Base"
    AAdd(aFields,{"FolhaIR",      STR0018 + ' ' + STR0020,        "number", STR0018 + ' ' + STR0020}) // "Folha IR"
    AAdd(aFields,{"AdiBs",        STR0021 + ' ' + STR0019,        "number", STR0021 + ' ' + STR0019}) // "Adiantamento Base"
    AAdd(aFields,{"AdiIR",        STR0021 + ' ' + STR0020,        "number", STR0021 + ' ' + STR0020}) // "Adiantamento IR"
    AAdd(aFields,{"FerBs",        STR0022 + ' ' + STR0019,        "number", STR0022 + ' ' + STR0019}) // "Férias Base"
    AAdd(aFields,{"FerIR",        STR0022 + ' ' + STR0020,        "number", STR0022 + ' ' + STR0020}) // "Férias IR"
    AAdd(aFields,{"PLRBs",        STR0023 + ' ' + STR0019,        "number", STR0023 + ' ' + STR0019}) // "PLR Base"
    AAdd(aFields,{"PLRIR",        STR0023 + ' ' + STR0020,        "number", STR0023 + ' ' + STR0020}) // "PLR IR"
    AAdd(aFields,{"13Bs",         '13 ' + STR0019,                "number", '13 ' + STR0019        }) // "13 Base"
    AAdd(aFields,{"13IR",         '13 ' + STR0020,                "number", '13 ' + STR0020        }) // "13 IR"
    AAdd(aFields,{"TotBs",        STR0024 + ' ' + STR0019,        "number", STR0024 + ' ' + STR0019}) // "Total Base"
    AAdd(aFields,{"TotIR",        STR0024 + ' ' + STR0020,        "number", STR0024 + ' ' + STR0020}) // "Total IR"
    self:addNestedProperty("funcionarios",      STR0029,     STR0029, NIL, aFields) // "funcionarios"


    aFields := {}
    AAdd(aFields, {"FilTransf",   STR0004 + ' ' + STR0028,    "string",  STR0004 + ' ' + STR0028}) // "Filial Transferência"
    AAdd(aFields, {"MatTransf",   STR0008 + ' ' + STR0028,    "string",  STR0008 + ' ' + STR0028}) // "Matrícula Transferência"
    AAdd(aFields, {"NomeTransf",  STR0009 + ' ' + STR0028,    "string",  STR0009 + ' ' + STR0028}) // "Nome Transferência"
    AAdd(aFields, {"DataTransf",  STR0010 + ' ' + STR0028,    "date",    STR0010 + ' ' + STR0028}) // "Data Transferência"
    self:addNestedProperty("transferencias",      STR0030,     STR0030, NIL, aFields) // "Transferencias"

Return self:oSchema

/*/{Protheus.doc} GPER050ATReportsBusinessObject::getComboBox
    Retorna os valores de ComboBox do parâmetro requisitado.
    @type Method
    @version 12.1.2510
    @author karina.alves
    @since 01/10/2025
    @return Variant, Retorno nulo pré-fixado
    @obs Path parameters: param (nome do parâmetro solicitado)
/*/
Method getComboBox() As Variant Class GPER050ATReportsBusinessObject
    // Declaração das variáveis locais
    Local jPath     As JSON    // Path parameters da requisição
    Local jResponse As JSON    // Resposta da requisição
    Local jItem     As JSON    // Item do valor do parâmetro
    Local nValues   As Numeric // Contador dos valores do parâmetro
    Local aValues   As Array   // Valores do parâmetro

    // Inicialização das variáveis
    jPath     := oRest:getPathParamsRequest()
    jResponse := JSONObject():New()
    jItem     := NIL
    nValues   := 0
    aValues   := {}

    // Captura os path parameters da requisição
    If (jPath != NIL)
        cParam := jPath["param"]
    EndIf

    // Cria o atributo data e nextPageUrl no JSON de resposta
    jResponse["data"]        := {}
    jResponse["nextPageUrl"] := NIL

    // Verifica qual parâmetro foi solicitado
    If (cParam == "AnalSint")
        AAdd(aValues, FwHTTPEncode(STR0013)) // "Analítica"
        AAdd(aValues, FwHTTPEncode(STR0014)) // "Sintética"
    ElseIf (cParam == "Ordem")
        AAdd(aValues, FwHTTPEncode(STR0008)) // "Matrícula"
        AAdd(aValues, FwHTTPEncode(STR0007)) // "Centro de Custo"
        AAdd(aValues, FwHTTPEncode(STR0009)) // "Nome"
    EndIf

    If (Len(aValues) > 0)
        // Percorre os valores adicionando cada item no JSON de resposta
        For nValues := 1 To Len(aValues)
            jItem := {;
                "key":   CValToChar(nValues),;
                "label": aValues[nValues];
            }
            AAdd(jResponse["data"], jItem)
        Next nValues
    EndIf

    // Define a resposta da requisição
    oRest:setResponse(jResponse)
    oRest:setStatusCode(200)
    oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")
    oRest:setKeyHeaderResponse("Accept-Encoding", "UTF-8")

    // Libera os objetos da memória
    FwFreeObj(jPath)
    FwFreeObj(jResponse)
    FwFreeObj(jItem)
    FwFreeArray(aValues)
Return NIL

/*/{Protheus.doc} GPER050ATReportsBusinessObject::fSoma
    Realiza a soma dos valores.
    @type Method
    @version 12.1.2510
    @author karina.alves
    @since 01/10/2025
    @return Variant, Retorno nulo pré-fixado
    @obs Path parameters: param (nome do parâmetro solicitado)
/*/
Static Function fSoma(cVetor,nVal,cCodVerba,dDataPagto,lSoma, cTipo2, cCCRat, cSemana, cRoteiro, cPer, cSeq )
    Local cChaveBusca	:= cCodVerba + DTOS(dDataPagto) + If( cTipo2 $ "G/R", "C", cTipo2) + cCCRat + cSemana + cRoteiro
    Local nFor			:= 0
    DEFAULT cPer		:= ""
    Default cSeq		:= ""

    cChaveBusca += cPer + cSeq

    lSoma := If(lSoma == Nil,.F.,lSoma)

    If ((aScan( aCodLido, cChaveBusca ) == 0 .Or. lRecalcIR) .AND. lSoma  ) .OR. ( !lSoma ) .OR. ( nVal < 0 )
        cVet := "a" + cVetor
        If ( lSoma )
            aAdd(aCodLido, cChaveBusca )
        EndIf

        For nFor = 1 To 4
            &(cVet)[nFor] += nVal
        Next nFor
    EndIf
Return(Nil)

/*/{Protheus.doc} GPER050ATReportsBusinessObject::ProcRescisao
    Valida Rescisões
    @type Method
    @version 12.1.2510
    @author karina.alves
    @since 01/10/2025
    @return Variant, Retorno nulo pré-fixado
    @obs Path parameters: param (nome do parâmetro solicitado)
/*/
Static Function ProcRescisao(cAliasSRA)
    Local cQuery      As Character
    Local oExec       As Object
    Local oExec2      As Object
    Local oExec3      As Object
    Local oRescAtu    As Object
    Local nParamOrder As Numeric
    Local nPosAbert   As Numeric
    Local nResOri     As Numeric
    Local nX          As Numeric
    Local nPosSRG     As Numeric
    Local cAlias      As Character
    Local cAlias2     As Character
    Local cAlias3     As Character
    Local cPd318      As Character
    Local cRotRes     As Character
    Local cRotFol     As Character
    Local cJoinSRR    As Character
    Local cDataIRMAnt As Character
    Local aAuxPer     As Array
    Local aRecnoSRG   As Array
    Local aRecnoSRGD  As Array
    Local dDtFol      As Date
    Local lResInt     As Logical

    cQuery      := ""
    oExec       := NIL
    oExec2      := NIL
    oExec3      := NIL
    oRescAtu    := NIL
    nParamOrder := 1
    nPosAbert   := 0
    nResOri     := 0
    nX          := 0
    cPd318      := ""
    cRotRes     := ""
    cRotFol     := ""
    cAlias      := ""
    cAlias2     := ""
    cAlias3     := ""
    cDataIRMAnt := ""
    aAuxPer     := {}
    aRecnoSRG   := {}
    aRecnoSRGD  := {}
    dDtFol      := Stod("//")
    lResInt     := .F.
    cJoinSRR    := ""
    nPosSRG     := 0
    lRecalcIR  := .T.

    //Montagem da query de busca que busca os valores
    cQuery += "SELECT "
    cQuery +=     "SRG.RG_FILIAL, "
    cQuery +=     "SRG.RG_MAT, "
    cQuery +=     "SRG.RG_PERIODO, "
    cQuery +=     "SRG.RG_PROCES, "
    cQuery +=     "SRG.RG_SEMANA, "
    cQuery +=     "SRG.RG_ROTEIR, "
    cQuery +=     "SRG.RG_DTGERAR, "
    cQuery +=     "SRG.RG_DATAHOM, "
    cQuery +=     "SRG.RG_DATADEM ""
    cQuery += "FROM "
    cQuery +=     RetSQLName("SRG") + " SRG "
    cQuery += "WHERE "
    cQuery +=     "SRG.RG_FILIAL =  ? "
    cQuery +=     "AND SRG.RG_MAT = ? "
    cQuery +=     "AND SRG.RG_EFETIVA =  ? "
    cQuery +=     "AND SRG.RG_DATAHOM  BETWEEN ? AND ? "
    cQuery +=     "AND SRG.D_E_L_E_T_ = ?  "

    cQuery := ChangeQuery(cQuery)
    oExec := FwExecStatement():New(cQuery)

    // Filial
    oExec:SetString(nParamOrder++, (cAliasSRA)->RA_FILIAL)

    // Matrícula
    oExec:SetString(nParamOrder++, (cAliasSRA)->RA_MAT)

    // Efetiva
    oExec:SetString(nParamOrder++, "S")

    //Data
    oExec:SetString(nParamOrder++, cDataDe)
    oExec:SetString(nParamOrder++, cDataAte)

    oExec:SetString(nParamOrder++, " ")

    cAlias := oExec:OpenAlias()

     // Percorre todos os registros
    While (!(cAlias)->(EOF()))
        If (Eval(cAcessaSRG) .and. (cAlias)->RG_FILIAL $ cValidFil)

            cPd318 := IIf(Len(aCodfol) > 0, aCodfol[318,1], '')
            cRotFol	:= IIf(cRotFol == "", fGetRotOrdinar(), cRotFol)
            cRotRes	:= IIf(cRotRes == "", fGetCalcRot("4"), cRotRes)

            // Se periodo foi integrado, não verifica os registros de Rescisao pois estes ja foram integrados a Folha
            fRetPerComp( SubStr( (cAlias)->RG_PERIODO, 5 ), SubStr( (cAlias)->RG_PERIODO, 1, 4) , xFilial('RCH', (cAliasSRA)->RA_FILIAL), (cAlias)->RG_PROCES, cRotRes, NIL , NIL , @aAuxPer)
            nPosAbert := aScan(aAuxPer,{|x| x[1] + x[2] + x[8] + x[7]  == (cAlias)->(RG_PERIODO + RG_SEMANA + RG_ROTEIR + RG_PROCES) })

            If nPosAbert > 0
                nParamOrder := 1
                cQuery = "SELECT "
                cQuery +=     "SRC.RC_FILIAL, "
                cQuery +=     "SRC.RC_DTREF "
                cQuery += "FROM "
                cQuery +=     RetSQLName("SRC") + " SRC "
                cQuery += "WHERE "
                cQuery +=     "SRC.RC_FILIAL =  ? "
                cQuery +=     "AND SRC.RC_MAT = ? "
                cQuery +=     "AND SRC.RC_PERIODO =  ? "
                cQuery +=     "AND SRC.RC_SEMANA =  ? "
                cQuery +=     "AND SRC.RC_ROTEIR =  ? "
                cQuery +=     "AND SRC.RC_PD =  ? "
                cQuery +=     "AND SRC.D_E_L_E_T_ = ?  "

                cQuery := ChangeQuery(cQuery)
                oExec2 := FwExecStatement():New(cQuery)

                oExec2:SetString(nParamOrder++, (cAliasSRA)->RA_FILIAL)
                oExec2:SetString(nParamOrder++, (cAliasSRA)->RA_MAT)
                oExec2:SetString(nParamOrder++, (cAlias)->RG_PERIODO)
                oExec2:SetString(nParamOrder++, (cAlias)->RG_SEMANA)
                oExec2:SetString(nParamOrder++, cRotFol)
                oExec2:SetString(nParamOrder++, cPd318)
                oExec2:SetString(nParamOrder++, "")

                cAlias2 := oExec2:OpenAlias()

                While (!(cAlias2)->(EOF()))
                    If (Eval(cAcessaSRC) .and. (cAlias2)->RC_FILIAL $ cValidFil)

                        dDtFol	:= (cAlias2)->RC_DTREF
                        If !Empty(dDtFol) .And. AnoMes(dDtFol) = AnoMes((cAlias)->RG_DATAHOM)
                            lResInt	:= .T.
                        EndIf

                    endif
                    (cAlias2)->(DBSkip())
                enddo
                (cAlias2)->( DBCloseArea() )

                if !lResInt
                    lResInt := IIF(!Empty(aAuxPer[nPosAbert][11]), .T., .F.)
                endif

                // Não considera rescisões que foram integradas pois estas estarão na SRC e registrados para roteiro FOL
                If  lResInt
                    // Verifica Se existe base de IR mês anterior, para garantir que a base de IR do relatório fique correta
                    dbSelectArea( "SRR" )
                    dbSetOrder(1)

                    If dbSeek((cAliasSRA)->(RA_FILIAL + RA_MAT) + "R" + (cAlias)->RG_DTGERAR + aCodFol[0106][1] )
                        If MesAno(SRR->RR_DATAPAG) == MesAno(STOD((cAlias)->RG_DATAHOM))
                            lBasIRMAnt 	:= .T.
                        EndIf
                        If MesAno(SRR->RR_DATAPAG) < MesAno(STOD((cAlias)->RG_DATAHOM))
                            // Carrego Data Geração da Complementar lida no Período de Impressão
                            // para busca das verbas na Original pois este conteúdo que é gravado em RR_DATA (fSubOri)
                            dDtGerCplAb	:= (cAlias)->RG_DTGERAR
                        EndIf
                    EndIf

                    (cAlias)->(dbSkip())
                    Loop
                EndIf
            Endif


            // Monta array com dados da rescisao
            aAdd(aRecnoSRG,{(cAlias)->(RG_FILIAL+RG_MAT), (cAlias)->RG_DTGERAR, (cAlias)->RG_DATAHOM, (cAlias)->RG_DATADEM, (cAlias)->(RECNO()), oRescAtu := JsonObject():new()})

            dbSelectArea( "SRR" )
            dbSetOrder(1)
            If dbSeek( (cAliasSRA)->RA_FILIAL+(cAliasSRA)->RA_MAT + "R" + (cAlias)->RG_DTGERAR)

                cJoinSRR := FWJoinFilial("SRR", "SRG")
                nParamOrder := 1

                 //Montagem da query de busca que busca os valores
                cQuery = "SELECT "
                cQuery +=     "SRR.RR_FILIAL, "
                cQuery +=     "SRR.RR_DATAPAG, "
                cQuery +=     "SRR.RR_DATA "
                cQuery += "FROM "
                cQuery +=     RetSQLName("SRR") + " SRR "
                cQuery += " INNER JOIN " + RetSQLName("SRG") + " SRG ON "
                cQuery +=       cJoinSRR
                cQuery +=       " AND SRG.RG_FILIAL = SRR.RR_FILIAL "
                cQuery +=       " AND SRG.RG_MAT = SRR.RR_MAT "
                cQuery +=       " AND SRG.RG_RESCDIS = ? "
                cQuery +=       " AND SRG.D_E_L_E_T_ = ? "
                cQuery += "WHERE "
                cQuery +=     "SRR.RR_FILIAL =  ? "
                cQuery +=     "AND SRR.RR_MAT = ? "
                cQuery +=     "AND SRR.RR_PERIODO =  ? "
                cQuery +=     "AND SRR.RR_ROTEIR =  ? "
                cQuery +=     "AND SRR.RR_DATA < ? "
                cQuery +=     "AND SRR.RR_PD = ? "
                cQuery +=     "AND SRR.D_E_L_E_T_ = ?  "

                cQuery := ChangeQuery(cQuery)
                oExec2 := FwExecStatement():New(cQuery)

                oExec2:SetString(nParamOrder++, '0')
                oExec2:SetString(nParamOrder++, " ")
                oExec2:SetString(nParamOrder++, SRR->RR_FILIAL)
                oExec2:SetString(nParamOrder++, SRR->RR_MAT)
                oExec2:SetString(nParamOrder++, SRR->RR_PERIODO)
                oExec2:SetString(nParamOrder++, SRR->RR_ROTEIR)
                oExec2:SetString(nParamOrder++, DTOS(SRR->RR_DATA))
                oExec2:SetString(nParamOrder++, aCodFol[0106][1])
                oExec2:SetString(nParamOrder++, " ")

                cAlias2 := oExec2:OpenAlias()

                If (!(cAlias2)->(EOF())) .And. (Eval(cAcessaSRR)) .And.((cAlias2)->RR_FILIAL $ cValidFil)
                    If Substr( (cAlias2)->RR_DATAPAG,1,6 ) <> MesAno(SRR->RR_DATAPAG)
                        lBasIRMAnt := .T.
                        cDataIRMAnt := (cAlias2)->RR_DATA
                    Endif
                endif
                (cAlias2)->( DBCloseArea() )

                nParamOrder := 1

                //Montagem da query de busca que busca os valores
                cQuery = "SELECT "
                cQuery +=     "SRR.RR_FILIAL, "
                cQuery +=     "SRR.RR_PD, "
                cQuery +=     "SRR.RR_VALOR, "
                cQuery +=     "SRR.RR_DATAPAG, "
                cQuery +=     "SRR.RR_TIPO2, "
                cQuery +=     "SRR.RR_CC, "
                cQuery +=     "SRR.RR_ITEM, "
                cQuery +=     "SRR.RR_CLVL, "
                cQuery +=     "SRR.RR_SEMANA, "
                cQuery +=     "SRR.RR_ROTEIR "
                cQuery += "FROM "
                cQuery +=     RetSQLName("SRR") + " SRR "
                cQuery += "WHERE "
                cQuery +=     "SRR.RR_FILIAL =  ? "
                cQuery +=     "AND SRR.RR_MAT = ? "
                cQuery +=     "AND SRR.RR_TIPO3 =  ? "
                cQuery +=     "AND SRR.RR_DATA =  ? "
                cQuery +=     "AND SRR.D_E_L_E_T_ = ?  "

                cQuery := ChangeQuery(cQuery)
                oExec3 := FwExecStatement():New(cQuery)

                oExec3:SetString(nParamOrder++, (cAliasSRA)->RA_FILIAL)
                oExec3:SetString(nParamOrder++, (cAliasSRA)->RA_MAT)
                oExec3:SetString(nParamOrder++, "R")
                oExec3:SetString(nParamOrder++, (cAlias)->RG_DTGERAR)
                oExec3:SetString(nParamOrder++, " ")

                cAlias3 := oExec3:OpenAlias()

                While (!(cAlias3)->(EOF()))
                    If (Eval(cAcessaSRR)) .And. ((cAlias3)->RR_FILIAL $ cValidFil)
                        //IR Folha
                        If (cAlias3)->RR_PD == aCodFol[0066][1]
                            fSoma("FOLIR", (cAlias3)->RR_VALOR, (cAlias3)->RR_PD, STOD((cAlias3)->RR_DATAPAG), .T., (cAlias3)->RR_TIPO2, (cAlias3)->RR_CC+(cAlias3)->RR_ITEM+(cAlias3)->RR_CLVL, (cAlias3)->RR_SEMANA, (cAlias3)->RR_ROTEIR )
                            If(lBasIRMAnt)
                                nResOri := fSubOri( cDataIRMAnt, aCodFol[0066][1])
                                IIF (nResOri>0, fSoma("FOLIR", nResOri*(-1), (cAlias3)->RR_PD, STOD((cAlias3)->RR_DATAPAG), .T., (cAlias3)->RR_TIPO2, (cAlias3)->RR_CC+(cAlias3)->RR_ITEM+(cAlias3)->RR_CLVL, (cAlias3)->RR_SEMANA, (cAlias3)->RR_ROTEIR ), '')
                            Endif
                            oRescAtu["FOLIR"] := aFolIr[4]
                        EndIf

                        //Base IR Folha
                        If (cAlias3)->RR_PD == aCodFol[0015][1] .And. !Empty(oRescAtu["FOLIR"])
                            fSoma("FOLBAS", (cAlias3)->RR_VALOR, (cAlias3)->RR_PD, STOD((cAlias3)->RR_DATAPAG), .T., (cAlias3)->RR_TIPO2, (cAlias3)->RR_CC+(cAlias3)->RR_ITEM+(cAlias3)->RR_CLVL, (cAlias3)->RR_SEMANA, (cAlias3)->RR_ROTEIR )
                            If(lBasIRMAnt)
                                nResOri := fSubOri( cDataIRMAnt, aCodFol[0015][1])
                                IIF (nResOri >0, fSoma("FOLBAS", nResOri*(-1), (cAlias3)->RR_PD, STOD((cAlias3)->RR_DATAPAG), .T., (cAlias3)->RR_TIPO2, (cAlias3)->RR_CC+(cAlias3)->RR_ITEM+(cAlias3)->RR_CLVL, (cAlias3)->RR_SEMANA, (cAlias3)->RR_ROTEIR ), '')
                            Endif
                        EndIf

                        // Base IR mês anterior
                        If (cAlias3)->RR_PD == aCodFol[0106][1] .And. MesAno((cAlias3)->RR_DATAPAG) == MesAno((cAlias)->RG_DATAHOM)
                            fSoma("FOLBAS", (cAlias3)->RR_VALOR * (-1), (cAlias3)->RR_PD, STOD((cAlias3)->RR_DATAPAG), .T., (cAlias3)->RR_TIPO2, (cAlias3)->RR_CC+(cAlias3)->RR_ITEM+(cAlias3)->RR_CLVL, (cAlias3)->RR_SEMANA, (cAlias3)->RR_ROTEIR )
                        EndIf

                        //IR Férias ou Dif.IR Ferias
                        If ((cAlias3)->RR_PD == aCodFol[0067][1] .Or. (cAlias3)->RR_PD == aCodFol[101,1]) .and. (cAlias3)->RR_DATAPAG == (cAlias)->RG_DATAHOM
                            fSoma("FERIR", (cAlias3)->RR_VALOR, (cAlias3)->RR_PD, STOD((cAlias3)->RR_DATAPAG), .T., (cAlias3)->RR_TIPO2, (cAlias3)->RR_CC+(cAlias3)->RR_ITEM+(cAlias3)->RR_CLVL, (cAlias3)->RR_SEMANA, (cAlias3)->RR_ROTEIR )
                        EndIf

                        //Base IR Férias ou Dif.Base IR Ferias
                        oRescAtu["FERIR"] := aFerIr[4]
                        If ((cAlias3)->RR_PD == aCodFol[0016][1] .Or. (cAlias3)->RR_PD == aCodFol[100,1] ) .And. !Empty(oRescAtu["FERIR"]) .and. (cAlias3)->RR_DATAPAG == (cAlias)->RG_DATAHOM
                            fSoma("FERBAS", (cAlias3)->RR_VALOR, (cAlias3)->RR_PD, STOD((cAlias3)->RR_DATAPAG), .T., (cAlias3)->RR_TIPO2, (cAlias3)->RR_CC+(cAlias3)->RR_ITEM+(cAlias3)->RR_CLVL, (cAlias3)->RR_SEMANA, (cAlias3)->RR_ROTEIR )
                        EndIf

                        //IR 13 Salário
                        If (cAlias3)->RR_PD == aCodFol[0071][1]
                            fSoma("13IR", (cAlias3)->RR_VALOR, (cAlias3)->RR_PD, STOD((cAlias3)->RR_DATAPAG), .T., (cAlias3)->RR_TIPO2, (cAlias3)->RR_CC+(cAlias3)->RR_ITEM+(cAlias3)->RR_CLVL, (cAlias3)->RR_SEMANA, (cAlias3)->RR_ROTEIR )
                            If(lBasIRMAnt)
                                nResOri := fSubOri( cDataIRMAnt, aCodFol[0071][1])
                                IIF (nResOri > 0, fSoma("13IR", nResOri*(-1), (cAlias3)->RR_PD, STOD((cAlias3)->RR_DATAPAG), .T., (cAlias3)->RR_TIPO2, (cAlias3)->RR_CC+(cAlias3)->RR_ITEM+(cAlias3)->RR_CLVL, (cAlias3)->RR_SEMANA, (cAlias3)->RR_ROTEIR ), '')
                            Endif
                        EndIf

                        //Base IR 13 Salário
                        oRescAtu["13IR"] := a13Ir[4]
                        If (cAlias3)->RR_PD == aCodFol[0027][1] .And. !Empty(oRescAtu["13IR"])
                            fSoma("13BAS", (cAlias3)->RR_VALOR, (cAlias3)->RR_PD, STOD((cAlias3)->RR_DATAPAG), .T., (cAlias3)->RR_TIPO2, (cAlias3)->RR_CC+(cAlias3)->RR_ITEM+(cAlias3)->RR_CLVL, (cAlias3)->RR_SEMANA, (cAlias3)->RR_ROTEIR )
                                If(lBasIRMAnt)
                                    nResOri := fSubOri( cDataIRMAnt, aCodFol[0027][1])
                                    IIF (nResOri >0, fSoma("13BAS", nResOri*(-1), (cAlias3)->RR_PD, STOD((cAlias3)->RR_DATAPAG), .T., (cAlias3)->RR_TIPO2, (cAlias3)->RR_CC+(cAlias3)->RR_ITEM+(cAlias3)->RR_CLVL, (cAlias3)->RR_SEMANA, (cAlias3)->RR_ROTEIR ), '')
                                Endif
                        EndIf
                    Endif

                    (cAlias3)->(dbSkip())
                enddo
                (cAlias3)->( DBCloseArea() )
            endif
        endif
        (cAlias)->(dbSkip())
    enddo
    (cAlias)->( DBCloseArea() )

    lRecalcIR := .F.

    //Define as rescisoes que devem ter o Ir abatido.
    For nX := 1 to Len(aRecnoSRG)
        dbSelectArea("SRG")
        dbGoTo(aRecnoSRG[nX][5])
        SRG->(dbSkip(-1))
        If	SRG->(RG_FILIAL+RG_MAT) == aRecnoSRG[nx][1] .And. MesAno(SRG->RG_DTGERAR) == MesAno(stod(aRecnoSRG[nX][2])) .And. MesAno(SRG->RG_DTGERAR) == MesAno(SRG->RG_DATADEM)  .And. !SRG->(BoF())
            aAdd(aRecnoSRGD, {SRG->(RG_FILIAL+RG_MAT), SRG->RG_DTGERAR, SRG->RG_DATAHOM, SRG->RG_DATADEM, SRG->(Recno())})
        EndIf
    Next nX

    //Ajusta os valores de ir de rescisoes complementares dentro do mes
    dbSelectArea( "SRR" )
    lRecalcIR := .F.
    For nX := 1 to Len(aRecnoSRGD)
        nPosSRG := aScan(aRecnoSRG, {|x| x[5] == aRecnoSRGD[nX,5]})
        oRescAtu := aRecnoSRG[nPosSRG ,6]

        //IR Folha
        If SRR->(dbSeek( aRecnoSRGD[nx,1] + "R" + DTOS(aRecnoSRGD[nx,2]) + aCodFol[66][1] ))
            lRecalcIR := .T.
            fSoma("FOLIR",SRR->RR_VALOR*(-1),SRR->RR_PD,SRR->RR_DATAPAG,.T.,SRR->RR_TIPO2, SRR->RR_CC+SRR->RR_ITEM+SRR->RR_CLVL, SRR->RR_SEMANA, SRR->RR_ROTEIR )
        Endif

        //Base IR Folha
        If SRR->(dbSeek( aRecnoSRGD[nx,1] + "R" + DTOS(aRecnoSRGD[nx,2]) + aCodFol[15][1] )) .And. !Empty(oRescAtu["FOLIR"])
            fSoma("FOLBAS",SRR->RR_VALOR*(-1),SRR->RR_PD,SRR->RR_DATAPAG,.T.,SRR->RR_TIPO2, SRR->RR_CC+SRR->RR_ITEM+SRR->RR_CLVL, SRR->RR_SEMANA, SRR->RR_ROTEIR )
        Endif

        //IR Ferias
        If SRR->(dbSeek( aRecnoSRGD[nx,1] + "R" + DTOS(aRecnoSRGD[nx,2]) + aCodFol[67][1] ))
            fSoma("FERIR",SRR->RR_VALOR*(-1),SRR->RR_PD,SRR->RR_DATAPAG,.T.,SRR->RR_TIPO2, SRR->RR_CC+SRR->RR_ITEM+SRR->RR_CLVL, SRR->RR_SEMANA, SRR->RR_ROTEIR )
        Endif

        //Dif.IR Ferias
        If SRR->(dbSeek( aRecnoSRGD[nx,1] + "R" + DTOS(aRecnoSRGD[nx,2]) + aCodFol[101][1] ))
            fSoma("FERIR",SRR->RR_VALOR*(-1),SRR->RR_PD,SRR->RR_DATAPAG,.T.,SRR->RR_TIPO2, SRR->RR_CC+SRR->RR_ITEM+SRR->RR_CLVL, SRR->RR_SEMANA, SRR->RR_ROTEIR )
        Endif

        //Base IR Ferias
        If SRR->(dbSeek( aRecnoSRGD[nx,1] + "R" + DTOS(aRecnoSRGD[nx,2]) + aCodFol[16][1] )) .And. !Empty(oRescAtu["FERIR"])
            fSoma("FERBAS",SRR->RR_VALOR*(-1),SRR->RR_PD,SRR->RR_DATAPAG,.T.,SRR->RR_TIPO2, SRR->RR_CC+SRR->RR_ITEM+SRR->RR_CLVL, SRR->RR_SEMANA, SRR->RR_ROTEIR )
        Endif

        //Dif.Base IR Ferias
        If SRR->(dbSeek( aRecnoSRGD[nx,1] + "R" + DTOS(aRecnoSRGD[nx,2]) + aCodFol[100][1] )) .And. !Empty(oRescAtu["FERIR"])
            fSoma("FERBAS",SRR->RR_VALOR*(-1),SRR->RR_PD,SRR->RR_DATAPAG,.T.,SRR->RR_TIPO2, SRR->RR_CC+SRR->RR_ITEM+SRR->RR_CLVL, SRR->RR_SEMANA, SRR->RR_ROTEIR )
        Endif

        //IR 13 Salario
        If SRR->(dbSeek( aRecnoSRGD[nx,1] + "R" + DTOS(aRecnoSRGD[nx,2]) + aCodFol[71][1] ))
            fSoma("13IR",SRR->RR_VALOR*(-1),SRR->RR_PD,SRR->RR_DATAPAG,.T.,SRR->RR_TIPO2, SRR->RR_CC+SRR->RR_ITEM+SRR->RR_CLVL, SRR->RR_SEMANA, SRR->RR_ROTEIR )
        Endif

        //Base IR 13 Salario
        If SRR->(dbSeek( aRecnoSRGD[nx,1] + "R" + DTOS(aRecnoSRGD[nx,2]) + aCodFol[27][1] )) .And. !Empty(oRescAtu["13IR"])
            fSoma("13BAS",SRR->RR_VALOR*(-1),SRR->RR_PD,SRR->RR_DATAPAG,.T.,SRR->RR_TIPO2, SRR->RR_CC+SRR->RR_ITEM+SRR->RR_CLVL, SRR->RR_SEMANA, SRR->RR_ROTEIR )
        Endif
    Next nX
Return ()

/*/{Protheus.doc} GPER050ATReportsBusinessObject::RetVerPro
    Retorna Verbas que serão usadas no processamento
    @type Method
    @version 12.1.2510
    @author karina.alves
    @since 01/10/2025
    @return Variant, Retorno nulo pré-fixado
    @obs Path parameters: param (nome do parâmetro solicitado)
/*/
Static Function RetVerPro(aVerba, cFilSRV)
    Local lRetorno := .F.

    If FP_CODFOL(@aCodFol, cFilSRV)
        aAdd(aVerba, {aCodFol[0010][1]}) //Base IR Adiantamento
        aAdd(aVerba, {aCodFol[0009][1]}) //IR Adiantamento
        aAdd(aVerba, {aCodFol[0015][1]}) //Base IR Folha
        aAdd(aVerba, {aCodFol[0016][1]}) //Base IR Ferias
        aAdd(aVerba, {aCodFol[0027][1]}) //Base IR 13a Salário
        aAdd(aVerba, {aCodFol[0066][1]}) //IR Folha
        aAdd(aVerba, {aCodFol[0067][1]}) //IR Ferias
        aAdd(aVerba, {aCodFol[0071][1]}) //IR 13a Salário
        aAdd(aVerba, {aCodFol[0100][1]}) //Dif. Base IR Férias
        aAdd(aVerba, {aCodFol[0101][1]}) //Dif. IR Ferias
        aAdd(aVerba, {aCodFol[0659][1]}) //Vlr Compensação de IR
        aAdd(aVerba, {aCodFol[0974][1]}) //Base IR RRA
        aAdd(aVerba, {aCodFol[0978][1]}) //IR RRA
        aAdd(aVerba, {aCodFol[0979][1]}) //Base IR 13o Salario RRA
        aAdd(aVerba, {aCodFol[0983][1]}) //IR RRA 13o Salario
        aAdd(aVerba, {aCodFol[0835][1]}) //Base IR PLR
        aAdd(aVerba, {aCodFol[0152][1]}) //IR PLR
        aAdd(aVerba, {aCodFol[0063][1]}) //Ded. Residuo IR pago >
        aAdd(aVerba, {aCodFol[0236][1]}) //Base Ir Ferias Outros Periodos
        aAdd(aVerba, {aCodFol[0237][1]}) // Ir Ferias Outros Periodos
        aAdd(aVerba, {aCodFol[0106][1]}) // Base IR mês anterior

        lRetorno := .T.
        cVerbaSql := fTrataVer(aVerba)
    Endif
Return(lRetorno)

/*/{Protheus.doc} GPER050ATReportsBusinessObject::fTrataVer
    Trata verbas
    @type Method
    @version 12.1.2510
    @author karina.alves
    @since 01/10/2025
    @return Variant, Retorno nulo pré-fixado
    @obs Path parameters: param (nome do parâmetro solicitado)
/*/
Static Function fTrataVer(aVerbas)
    Local cVerbas 	:= ""
    Local nI 		:= 1

    For nI := 1 To Len(aVerbas)
        If !Empty(aVerbas[nI][1]) .And. !(aVerbas[nI][1] $ cVerbas)
            cVerbas += "'" + aVerbas[nI][1] + "',"
        EndIf
    Next nI
    If !Empty(cVerbas)
        cVerbas := subStr(cVerbas,1,Len(cVerbas)-1)
    EndIf
Return cVerbas

/*/{Protheus.doc} GPER050ATReportsBusinessObject::fVerTransf
    Verbas de Transferência
    @type Method
    @version 12.1.2510
    @author karina.alves
    @since 01/10/2025
    @return Variant, Retorno nulo pré-fixado
    @obs Path parameters: param (nome do parâmetro solicitado)
/*/
Static Function fVerTransf(lZera, aAuxTransf, cCompet, cCodEmp, cCodFil, cCodMat )
    Static cChaveAnt:= '!!'

    Default lZera	:= .F.
    cChaveAnt := Nil

    If !lZera
        If cChaveAnt <> ( cCodEmp + cCodFil + cCodMat )
            cChaveAnt  := ( cCodEmp + cCodFil + cCodMat )
            aAuxTransf := {}
            fTransf(@aAuxTransf, , Nil, Nil, Nil, Nil, .F., .T.,,,,, cCodFil, cCodMat)
        Endif
    Endif
Return(.T.)


/*/{Protheus.doc} GPER050ATReportsBusinessObject::fSubOri
    Busca por valores da rescição original para os casos de impressão de rescisão complementar
    @type Method
    @version 12.1.2510
    @author karina.alves
    @since 01/10/2025
    @return Variant, Retorno nulo pré-fixado
    @obs Path parameters: param (nome do parâmetro solicitado)
/*/
Static Function fSubOri(cData,cVerba,nChamada)
    Local cQuery        as Character
    Local oExec         as Object
    Local cAlias        as Character
    Local nParamOrder   as Numeric
    Local nValor        as Numeric

    cQuery := ""
    oExec := NIL
    cAlias := ""
    nParamOrder := 1
    nValor    := 0

    Default nChamada	:= 1 // 1= ProcRescisao, 2=ProcMovime

    //Montagem da query de busca que busca os valores
    cQuery = "SELECT "
    cQuery +=     "SRR.RR_VALOR "
    cQuery += "FROM "
    cQuery +=     RetSQLName("SRR") + " SRR "
    cQuery += "WHERE "
    cQuery +=     "SRR.RR_FILIAL =  ? "
    cQuery +=     "AND SRR.RR_MAT = ? "
    cQuery +=     "AND SRR.RR_PERIODO =  ? "
    cQuery +=     "AND SRR.RR_ROTEIR = ? "
    cQuery +=     "AND SRR.RR_DATA = ? "
    cQuery +=     "AND SRR.RR_PD = ? "
    cQuery +=     "AND SRR.D_E_L_E_T_ = ?  "
    cQuery := ChangeQuery(cQuery)

    oExec := FwExecStatement():New(cQuery)

    // Filial
    oExec:SetString(nParamOrder++, SRR->RR_FILIAL)

    // Matrícula
    oExec:SetString(nParamOrder++, SRR->RR_MAT)

    // Período
    oExec:SetString(nParamOrder++, SRR->RR_PERIODO)

    // Roteiro
    oExec:SetString(nParamOrder++, SRR->RR_ROTEIR)

    //Data
    oExec:SetString(nParamOrder++, cData)

    //Verba
    oExec:SetString(nParamOrder++, cVerba)

    oExec:SetString(nParamOrder++, " ")

    cAlias := oExec:OpenAlias()

    If nChamada == 1
        If !(cAlias)->(Eof())
            nValor := (cAlias)->RR_VALOR
        Endif
    ElseIf nChamada = 2
        If !(cAlias)->(Eof())
            While (cAlias)->(!Eof())
                nValor += (cAlias)->RR_VALOR
            (cAlias)->(DbSkip())
            EndDo
        EndIf
    endif

    (cAlias)->(dbCloseArea())

Return(nValor)

/*/{Protheus.doc} GPER050ATReportsBusinessObject::ProcMovime
    Processa verbas nas tabelas SRC e SRD
    @type Method
    @version 12.1.2510
    @author karina.alves
    @since 01/10/2025
    @return Variant, Retorno nulo pré-fixado
    @obs Path parameters: param (nome do parâmetro solicitado)
/*/
Static Function ProcMovime(aPerAberto, aPerFechado, aVerba, cAliasSRA)
    Local nLenaTransf    As Numeric
    Local nTransf        As Numeric
    Local nX             As Numeric
    Local nVerba         As Numeric
    Local aVerbasFunc    As Array
    Local aVerbasTemp    As Array
    Local lContinua      As Logical

    Private cAuxFer      As Character
    Private cAuxBase     As Character

    nLenaTransf   := Len(aTransf)
    cProcesso     := (cAliasSRA)->RA_PROCES
    aVerbasFunc   := {}
    aVerbasTemp   := {}
    nTransf       := 0
    nX            := 0
    nVerba        := 0
    lContinua     := .T.
    cAuxFer       := ''
    cAuxBase      := ''

    If nLenaTransf > 0
        // Processa movimento SRC/SRD se possuir periodo nas referidas tabelas
        If (aScan(aPerAberto , {|x| x[7] == cProcesso }) != 0 .OR. aScan(aPerFechado, {|x| x[7] == cProcesso }) != 0)
            // Carrega todas verbas do funcionario para processamento. Parametros: Filial, Matricula, Centro de Custo, Roteiro, Verbas, Periodo Aberto, Periodo Fechado, Semana
            aVerbasFunc := RetornaVerbasFunc((cAliasSRA)->RA_FILIAL, (cAliasSRA)->RA_MAT, '','' , cVerbaSql, aPerAberto, aPerFechado , Nil, Nil , .T., Nil , Nil ,"C")
        EndIf

        For nTransf := 1 to nLenaTransf
            aVerbasTemp := {}
            // Para geracao de Titulo de IR, verifica se existe pgto efetuado no mes seguinte do calculo, caso tenha ocorrido transferencia de processo
            If !Empty(aTransf[nTransf, 14]) .And. (aTransf[nTransf, 14] <> aTransf[nTransf, 15]) .And. ChkDtPag(aTransf[nTransf, 14],cAliasSRA)
                cProcesso := aTransf[nTransf, 14]
                aVerbasTemp := RetornaVerbasFunc((cAliasSRA)->RA_FILIAL, (cAliasSRA)->RA_MAT, '','' , cVerbaSql, aPerAberto, aPerFechado , Nil, Nil , .T., Nil , Nil ,"C")
                cProcesso := (cAliasSRA)->RA_PROCES
            EndIf

            // Se Houve Transferencia, se ela esta no mes de período do relatório (dDataDe e dDataAte) e se houve troca de Processo
            If !Empty(aTransf[nTransf, 14]) .And. ( aTransf[nTransf, 07] > dDataAte .Or. (aTransf[nTransf, 07] >= dDataDe .And. aTransf[nTransf, 07] <= dDataAte) ) .And. ;
            (aTransf[nTransf, 14] != aTransf[nTransf, 15] .And. aTransf[nTransf, 14] != cProcesso)
                cProcesso   := aTransf[nTransf, 14]
                aVerbasTemp := RetornaVerbasFunc((cAliasSRA)->RA_FILIAL, (cAliasSRA)->RA_MAT, '','' , cVerbaSql, aPerAberto, aPerFechado , Nil, Nil , .T., Nil , Nil ,"C")
                cProcesso := (cAliasSRA)->RA_PROCES
            EndIf

            // Junta todas as verbas
            For nX := 1 To Len(aVerbasTemp)
                AADD(aVerbasFunc, aVerbasTemp[nX])
            Next nX
        Next nTransf
    else
        // Processa movimento SRC/SRD se possuir periodo
        If (aScan(aPerAberto , {|x| x[7] == cProcesso }) != 0 .OR. aScan(aPerFechado, {|x| x[7] == cProcesso }) != 0)
            // Carrega todas verbas do funcionario para processamento. Parâmetros: Filial, Matricula, Centro de Custo, Roteiro, Verbas, Periodo Aberto, Periodo Fechado, Semana
            aVerbasFunc := RetornaVerbasFunc((cAliasSRA)->RA_FILIAL, (cAliasSRA)->RA_MAT, '','' , cVerbaSql, aPerAberto, aPerFechado , Nil, Nil , Nil, Nil , Nil ,"C")
        EndIf
    endif

    If (!Empty(aCodFol[236][1]))
        lBsSRR := If(aScan(aVerbasFunc , {|x| x[3] == aCodFol[236][1] .And. x[11] == 'FER'}) > 0, .T., .F.)
    EndIf

    If (!Empty(aCodFol[237][1]))
        lIrSRR := If(aScan(aVerbasFunc , {|x| x[3] == aCodFol[237][1] .And. x[11] == 'FER'}) > 0, .T., .F.)
    EndIf

    If Len(aVerbasFunc) > 0
        ASORT(aVerbasFunc, , , { | x,y | x[10]+x[8]+Alltrim(Str(x[6])) > y[10]+y[8]+Alltrim(Str(y[6])) } )
    Endif

    For nVerba := 1 To Len(aVerbasFunc)
        // Verifica as transferencias para somar as verbas
        lContinua   := .T.
        If nLenaTransf > 0
            For nTransf := nLenaTransf To 1 Step -1
                If aVerbasFunc[nVerba][13] <= aTransf[nTransf, 07] .Or. (aVerbasFunc[nVerba][13] >= aTransf[nTransf, 07] .And.  MesAno(aVerbasFunc[nVerba][13]) < aVerbasFunc[nVerba][10] )
                    lContinua := (aTransf[nTransf, 08] + aTransf[nTransf, 09] ==  (cAliasSRA)->(RA_FILIAL+RA_MAT)).Or.(aTransf[nTransf, 05]   ==  (cAliasSRA)->(RA_FILIAL+RA_MAT))
                ElseIf aVerbasFunc[nVerba][13] >= aTransf[nTransf, 07]
                    //Tratamento para regime caixa com o pagamento no mesmo mês da transferência
                    If aVerbasFunc[nVerba][10] < AnoMes(aVerbasFunc[nVerba][13]) .And. AnoMes( aTransf[nTransf, 07] ) == AnoMes( aVerbasFunc[nVerba][13] )
                        lContinua := ( aVerbasFunc[nVerba][1] + aVerbasFunc[nVerba][2] ) == (cAliasSRA)->(RA_FILIAL+RA_MAT) .And. (cAliasSRA)->(RA_FILIAL+RA_MAT) == ( aTransf[nTransf, 2] )
                    ElseIf ( aTransf[nTransf, 8] + aTransf[nTransf, 9] )  == ( (cAliasSRA)->(RA_FILIAL+RA_MAT)) .And. aVerbasFunc[nVerba][1] == aTransf[nTransf, 8]
                        lContinua := .T.
                    Else
                        lContinua := ( aTransf[nTransf, 10] + aTransf[nTransf, 11] )  == ( (cAliasSRA)->(RA_FILIAL+RA_MAT))
                    EndIf
                EndIf

                // Quando o funcionário tem mais de uma transferencia dentro do mes, a busca começa da ultima até primeira. Se já encontrar a ultima sai do loop.
                If lContinua
                    Exit
                Endif
            Next nTransf
        Endif

        If ( dDataDe <= aVerbasFunc[nVerba][13] .And. dDataAte >= aVerbasFunc[nVerba][13] ) .And. lContinua
            // Adiantamento de Salario
            SmMovAdi(aVerbasFunc[nVerba])

            // Folha de Pagamento
            SmMovFol(aVerbasFunc[nVerba])

            // Férias
            SmMovFer(aVerbasFunc[nVerba])

            // 13 Salário
            SmMov13S(aVerbasFunc[nVerba],aVerbasFunc)

            // RRA
            SmMovRRA(aVerbasFunc[nVerba])
        endif
    Next nVerba
Return

/*/{Protheus.doc} GPER050ATReportsBusinessObject::SmMovAdi
    Soma verbas de adiantamento
    @type Method
    @version 12.1.2510
    @author karina.alves
    @since 01/10/2025
    @return Variant, Retorno nulo pré-fixado
    @obs Path parameters: param (nome do parâmetro solicitado)
/*/
Static Function SmMovAdi(aVerba)

    // IR do Adiantamento
    If aVerba[03]  == aCodFol[0009][1] //IR do Adiantamento (Cod.Base para demonst.Folha)
        fSoma("ADIIR", aVerba[07], aVerba[03], aVerba[13],.T.,aVerba[17], aVerba[12]+aVerba[21]+aVerba[22], aVerba[08], aVerba[11])
    EndIf

    // Base IR do Adiantamento
    If aVerba[03] == aCodFol[0010][1] .And. aAdiIr[4] > 0//Base do I.R. no Adiantamento
        fSoma("ADIBAS", aVerba[07], aVerba[03], aVerba[13],.T.,aVerba[17], aVerba[12]+aVerba[21]+aVerba[22], aVerba[08], aVerba[11])
    EndIf

Return()

/*/{Protheus.doc} GPER050ATReportsBusinessObject::SmMovFol
    Soma verbas de folha
    @type Method
    @version 12.1.2510
    @author karina.alves
    @since 01/10/2025
    @return Variant, Retorno nulo pré-fixado
    @obs Path parameters: param (nome do parâmetro solicitado)
/*/
Static Function SmMovFol(aVerba)

    Local nValor    := 0

    If aVerba[17] $ "C*I*G*R"
        //IR Folha
        If aVerba[03] == aCodFol[0066][1] //Desconto do Imposto de Renda
            fSoma("FOLIR" , aVerba[07] , aVerba[03], aVerba[13], .T., aVerba[17], aVerba[12]+aVerba[21]+aVerba[22], aVerba[08], aVerba[11],aVerba[10])
        EndIf

        //IR Compensacao pago a maior
        //Vlr Compesacao de IR
        IIf (aVerba[03] == aCodFol[0659][1], fSoma("FOLIR" , aVerba[07]*(-1), aVerba[03], aVerba[13], .T., aVerba[17], aVerba[12]+aVerba[21]+aVerba[22], aVerba[08], aVerba[11],aVerba[10]), '')

        //Base IR Folha
        If aVerba[03] == aCodFol[0015][1] .And. aFolIr[4] > 0  //Base Imposto de Renda
            dbSelectArea("SRA")
            dbSetOrder(1)
            dbSeek(SRA->(aVerba[01]+aVerba[02]))

            If SRA->RA_TIPOPGT == 'S'
                If Empty(dDtPgtoSem)  // Para semanalistas a Ordenação se inicia na última semana
                    dDtPgtoSem  := aVerba[13]
                    nValor      := aVerba[07]
                EndIf
            Else
                nValor	:=	aVerba[07]
            EndIf
            fSoma("FOLBAS", nValor     , aVerba[03], aVerba[13], .T., aVerba[17], aVerba[12]+aVerba[21]+aVerba[22], aVerba[08], aVerba[11])
        EndIf
    EndIf

    If aVerba[17] $ "C*I*G*F"
        // Base IR Mês Anterior
        If aVerba[03] == aCodFol[0106][1] .And. aVerba[11] <> "ADI"
            IIF (aFolIr[4] > 0 .And. lBasIRMAnt, fSoma("FOLBAS" , aVerba[07]*(-1), aVerba[03], aVerba[13], .T., aVerba[17], aVerba[12]+aVerba[21]+aVerba[22], aVerba[08], aVerba[11],aVerba[10]), '')
        EndIf

        // IR Mês Anterior
        IIF (aVerba[03] == aCodFol[0107][1], fSoma("FOLIR" , aVerba[07], aVerba[03], aVerba[13], .T., aVerba[17], aVerba[12]+aVerba[21]+aVerba[22], aVerba[08], aVerba[11],aVerba[10]), '')
    EndIf

    If aVerba[17] $ "A"
        //Ded. Residuo IR pago
        If aVerba[03] == aCodFol[0063][1] //Ded. Residuo IR pago
            fSoma("FOLIR" , aVerba[07]*(-1), aVerba[03], aVerba[13], .T., aVerba[17], aVerba[12]+aVerba[21]+aVerba[22], aVerba[08], aVerba[11],aVerba[10])
        EndIf
    Endif

    //Distribuicao de Lucros
    If aVerba[17] $ "C*I*G*A"
        //IR Distribuicao de Lucros
        If aVerba[03] == aCodFol[0152][1] //Imposto Renda da Verba Distribuicao de Lucro
            fSoma("PLRIR" , aVerba[07], aVerba[03], aVerba[13], .T., aVerba[17], aVerba[12]+aVerba[21]+aVerba[22], aVerba[08], aVerba[11],aVerba[10])
        EndIf

        //Base IR Distribuicao de Lucros
        If aVerba[03] == aCodFol[0835][1]  .And. aPLRIR[4] > 0 //Verba de Distribuicao de Lucro
            fSoma("PLRBAS", aVerba[07], aVerba[03], aVerba[13], .T., aVerba[17], aVerba[12]+aVerba[21]+aVerba[22], aVerba[08], aVerba[11],aVerba[10])
        EndIf
    EndIf
Return ()

/*/{Protheus.doc} GPER050ATReportsBusinessObject::Static Function SmMovFer
    Soma verbas de férias
    @type Method
    @version 12.1.2510
    @author karina.alves
    @since 01/10/2025
    @return Variant, Retorno nulo pré-fixado
    @obs Path parameters: param (nome do parâmetro solicitado)
/*/
Static Function SmMovFer(aVerba)

    IIF (Valtype(cAuxFer) <> "C", cAuxFer := "", '')
    IIF (Valtype(cAuxBase) <> "C", cAuxBase := "", '')

    // IR Ferias ou Dif. IR Ferias
    If ( aVerba[03] == aCodFol[067][1] .And. aVerba[17] $ "K*I*G*R*C" ) .Or. ; //Desconto do Imposto de Renda Ferias
       ( aVerba[03] == aCodFol[101][1] .And. aVerba[17] #  "R" ) .or.;		//Diferenca de I.R. Ferias
       ( aVerba[03] == aCodFol[237][1] .And. aVerba[17] $ "K*I*G*R" .And. lIrSRR)        //Ir Ferias Outros Periodos

        fSoma("FERIR" , aVerba[07], aVerba[03], aVerba[13], IIF(cAuxFer == aVerba[10], .T., .F.), aVerba[17], aVerba[12] + aVerba[21] + aVerba[22], aVerba[08], aVerba[11], , If(lIrSRR, "", aVerba[15]) )

        IIf (cAuxFer <> aVerba[10], AAdd(aPerFer,aVerba[10]), '')

        cAuxFer := aVerba[10]

        IIF (aScan(aDataPgFer, {|x| x == aVerba[13] }) == 0, AAdd(aDataPgFer,aVerba[13]), '')
    EndIf

    // Base IR Ferias ou Dif.Base IR Ferias
    If aFerIR[4] .And. ((( aVerba[03] == aCodFol[016][1] .And. aVerba[17] $ "K*I*G*R*C" ) .Or.;   			//Base Imposto de Renda Ferias
        ( aVerba[03] == aCodFol[100][1] .And. aVerba[17] #  "R" ))  .Or.;	  								//Diferenca de Base I.R. Ferias
        ( aVerba[03] == aCodFol[236][1] .And. aVerba[17] $ "K*I*G*R" .And. lBsSRR ))       					//Base Ir Ferias Outros Periodos

        fSoma("FERBAS", aVerba[07], aVerba[03], aVerba[13], IIF(cAuxBase == aVerba[10], .T., .F.), aVerba[17], aVerba[12]+aVerba[21]+aVerba[22], aVerba[08], aVerba[11], , If(lBsSRR, "", aVerba[15]) )

        IIF (cAuxBase <> aVerba[10], AAdd(aPerFer,aVerba[10]), '')

        cAuxBase := aVerba[10]

        IIF (aScan(aDataPgFer, {|x| x == aVerba[13] }) == 0,  Add(aDataPgFer,aVerba[13]), '')
    EndIf
Return()

/*/{Protheus.doc} GPER050ATReportsBusinessObject::Static Function SmMov13S
    Soma verbas de 13 Salário
    @type Method
    @version 12.1.2510
    @author karina.alves
    @since 01/10/2025
    @return Variant, Retorno nulo pré-fixado
    @obs Path parameters: param (nome do parâmetro solicitado)
/*/
Static Function SmMov13S(aVerba,aVerbasFunc)
   // Local nIr13     := 0
   // Local nPos      := 0
    Local nResOri   := 0

    DEFAULT aVerbasFunc := {}

    // IR 13 Salario
    If aVerba[03] == aCodFol[0071][1] //Imposto de Renda sobre 13o.Salario
        fSoma("13IR" ,aVerba[07], aVerba[03], aVerba[13], .T., aVerba[17], aVerba[12]+aVerba[21]+aVerba[22], aVerba[08], aVerba[11],aVerba[10])
        If !Empty(dDtGerCplAb)
            nResOri := fSubOri( dDtGerCplAb, aCodFol[0071][1], 2)
            IIF ((nResOri)>0, fSoma("13IR", nResOri*(-1), SRR->RR_PD, SRR->RR_DATAPAG, .T., SRR->RR_TIPO2, SRR->RR_CC+SRR->RR_ITEM+SRR->RR_CLVL, SRR->RR_SEMANA, SRR->RR_ROTEIR ), '')
        EndIf
    EndIf

    // Base IR 13 Salario
    If aVerba[03] == aCodFol[0027][1]  //Base I.R. no 13o.Salario
        nIr13 := a13Ir[4]
        If a13Ir[4] == 0
            // Verifico se não esta entre as verbas do funcionario e não carregou no array
            // devido a ordenação do código de verba que não deve ser comprometido pois não há garantia de como o cliente irá cadastrar
            If (nPos := aScan(aVerbasFunc, {|x| x[3] == aCodFol[0071][1]})) > 0
                nIr13 := aVerbasFunc[nPos][7]
            EndIf
        EndIf
        If nIr13 > 0
            fSoma("13BAS", aVerba[07], aVerba[03], aVerba[13], .T., aVerba[17], aVerba[12]+aVerba[21]+aVerba[22], aVerba[08], aVerba[11])
            If !Empty(dDtGerCplAb)
                nResOri := fSubOri( dDtGerCplAb, aCodFol[0027][1], 2)
                IIF (nResOri >0,  fSoma("13BAS", nResOri*(-1), SRR->RR_PD, SRR->RR_DATAPAG, .T., SRR->RR_TIPO2, SRR->RR_CC+SRR->RR_ITEM+SRR->RR_CLVL, SRR->RR_SEMANA, SRR->RR_ROTEIR ), '')
            EndIf
        EndIf
    EndIf
Return()

/*/{Protheus.doc} GPER050ATReportsBusinessObject::Static Function SmMovRRA
    Soma verbas de RRA
    @type Method
    @version 12.1.2510
    @author karina.alves
    @since 01/10/2025
    @return Variant, Retorno nulo pré-fixado
    @obs Path parameters: param (nome do parâmetro solicitado)
/*/
Static Function SmMovRRA(aVerba)

    // RRA - IR
    If aVerba[03] == aCodFol[0978][1] //IR RRA
        fSoma("FOLIR" ,aVerba[07], aVerba[03], aVerba[13], .T., aVerba[17], aVerba[12]+aVerba[21]+aVerba[22], aVerba[08], aVerba[11])
    EndIf

    // RRA - BASE IR
    If aVerba[03] == aCodFol[0974][1] //Base IR RRA
        fSoma("FOLBAS" ,aVerba[07], aVerba[03], aVerba[13], .T., aVerba[17], aVerba[12]+aVerba[21]+aVerba[22], aVerba[08], aVerba[11])
    EndIf

    // RRA - IR 13 Salario
    If aVerba[03] == aCodFol[0979][1] //Base IR 13o.RRA
        fSoma("13BAS" ,aVerba[07], aVerba[03], aVerba[13], .T., aVerba[17], aVerba[12]+aVerba[21]+aVerba[22], aVerba[08], aVerba[11])
    EndIf

    // RRA - IR 13 Salario
    If aVerba[03] == aCodFol[0983][1] //IR RRA 13o
        fSoma("13IR" ,aVerba[07], aVerba[03], aVerba[13], .T., aVerba[17], aVerba[12]+aVerba[21]+aVerba[22], aVerba[08], aVerba[11])
    EndIf

Return()

/*/{Protheus.doc} GPER050ATReportsBusinessObject::Static Function ProcFerias
    Procura na SRH funcionários em férias
    @type Method
    @version 12.1.2510
    @author karina.alves
    @since 01/10/2025
    @return Variant, Retorno nulo pré-fixado
    @obs Path parameters: param (nome do parâmetro solicitado)
/*/
Static Function ProcFerias(cAliasSRA)

    Local dDtBusFer     := CtoD("//")
    Local lSegRecibo    := .F.
    Local cDataRecib    := ""
    Local lExitLoop     := .F.
    Local nTransf       := 0
    Local nLenaTransf   := 0
    Local cChave        := (cAliasSRA)->(RA_FILIAL+RA_MAT)
    Local nUlt          := 0
    Local nI            := 0
    Local lProc         := .T.
    Local lRatCC        := .F.
    Local cAcessaSRH    := &("{ || " + ChkRH("GPER050A","SRH","2") + "}")
    Local cQuery        := ""
    Local oExec         := NIL
    Local nParamOrder   := 1
    Local cAlias        := ''
    Local lRet          := .F.

    // ChangeSet 577330 / Issue DRHGCH-10630
    // Antes dessa correção os dados nas tabelas SRH/SRR ficavam duplicados,
    // Após essa correção, os dados sempre assumem a filial destino
    // É necessário considerar a existência dos dois cenários na base do cliente
    If Len(aTransf) > 0
        nUlt    := 	Len(aTransf)
    EndIf

    //Montagem da query de busca que busca os valores
    cQuery = "SELECT "
    cQuery +=     "SRH.RH_FILIAL, "
    cQuery +=     "SRH.RH_MAT, "
    cQuery +=     "SRH.RH_DATAINI, "
    cQuery +=     "SRH.RH_DTRECIB, "
    cQuery +=     "SRH.RH_PERIODO "
    cQuery += "FROM "
    cQuery +=     RetSQLName("SRH") + " SRH "
    cQuery += "WHERE "
    cQuery +=     "SRH.RH_FILIAL =  ? "
    cQuery +=     "AND SRH.RH_MAT = ? "
    cQuery +=     "AND SRH.D_E_L_E_T_ = ?  "

    cQuery := ChangeQuery(cQuery)
    oExec := FwExecStatement():New(cQuery)

    oExec:SetString(nParamOrder++, (cAliasSRA)->RA_FILIAL)
    oExec:SetString(nParamOrder++, (cAliasSRA)->RA_MAT)
    oExec:SetString(nParamOrder++, " ")

    cAlias := oExec:OpenAlias()

    While (!(cAlias)->(EOF()))
        If (Eval(cAcessaSRH) .and. (cAlias)->RH_FILIAL $ cValidFil)

            dDtBusFer := fDtBusFer()

            If Type('dDtBusFer') # 'D'
                dDtBusFer := (cAlias)->RH_DATAINI
            EndIf

            If Len(aTransf) > 0
                dDtRecib	:= (cAlias)->RH_DTRECIB
                // Férias calculadas após a última Transferência
                If stod((cAlias)->RH_DTRECIB) > aTransf[nUlt][7]
                    lProc	:= .T.
                Else
                // Férias calculadas antes da última Transferência, Filial + Matrícula deverá ser igual Filial+Matrícula Destino
                    For nI:= 1 to Len(aTransf)
                    // Considera apenas transferências de Filial + Matrícula
                        If aTransf[nI][2] <> aTransf[nI][5] .Or. ((cAlias)->RH_DTRECIB <= Dtos(aTransf[nI][7]) .And. (MesAno(STOD((cAlias)->RH_DTRECIB)) == MesAno(dDataDe)))
                            If stod((cAlias)->RH_DTRECIB) <= aTransf[nI][7]  .And. ( (cAliasSRA)->(RA_FILIAL+RA_MAT) == aTransf[nI][8]+aTransf[nI][9] .Or.;
								( (cAlias)->RH_PERIODO == MesAno(aTransf[nI][7]) .And. (cAliasSRA)->(RA_FILIAL+RA_MAT) == aTransf[nI][10]+aTransf[nI][11] )) .And.;
                                (aTransf[nI][8] >= cFilialDe .And. aTransf[nI][8] <= cFilialAte)
                                lProc:= .T.
                            Else
                                lProc := .F.
                            EndIf
                        EndIf
                    Next nI
                EndIf
            EndIf
        endif

        If lProc
            // Verifica se verba IRRF Férias (0067) possui configuração para Rateio Centro de Custo
            // Caso possuir, dados de IRRF/Base Férias foram aglutinados na SRC e registrados
            // com a Data de Pagamento das últimas férias - carregada no array aDataPgFer
            lRatCC	:= Posicione("SRV",1,xFilial("SRV") + aCodfol[067,1],"RV_ENCARCC") == "S"
            lRet := If (lRatCC, .F., aScan(aDataPgFer, {|x| x == STOD((cAlias)->RH_DTRECIB) }) == 0) .Or. aScan(aPerFer, {|x| x == (cAlias)->RH_PERIODO }) == 0

            If ((cAlias)->RH_DTRECIB >= cDataDe .And. (cAlias)->RH_DTRECIB <= cDataAte ) .And. ( lRet)
                nLenaTransf	:= Len(aTransf)
                cDataRecib	:= (cAlias)->RH_DTRECIB
                lExitLoop	:= .F.

                For nTransf := nLenaTransf To 1 Step -1
                    If Dtos(aTransf[nTransf, 07]) >= cDataRecib .And. !lExitLoop
                        If !((aTransf[nTransf, 10] + aTransf[nTransf, 11]) == (cChave))
                            lExitLoop	:= .T.
                        Endif
                    EndIf
                Next nTransf

                // Verifica se desconsidera os movimentos de ferias devido aos dados serem resultado de uma tranferencia
                If lExitLoop
                    (cAlias)->(dbSkip())
                    Loop
                Endif

                dbSelectArea( "SRR" )
                dbSetOrder(1)
                If SRR->(dbSeek( cChave + "F" + dDtBusFer + aCodfol[067,1] ))
                    fSoma("FERIR", SRR->RR_VALOR, SRR->RR_PD, SRH->RH_DTRECIB, lSegRecibo, SRR->RR_TIPO2, SRR->RR_CC, SRR->RR_SEMANA, SRR->RR_ROTEIR )

                    If SRR->(dbSeek( cChave + "F" + dDtBusFer + aCodfol[101,1] ))
                        fSoma("FERIR", SRR->RR_VALOR, SRR->RR_PD, SRH->RH_DTRECIB, lSegRecibo, SRR->RR_TIPO2, SRR->RR_CC + SRR->RR_ITEM + SRR->RR_CLVL, SRR->RR_SEMANA, SRR->RR_ROTEIR )
                    EndIf

                    If SRR->(dbSeek( cChave + "F" + dDtBusFer + aCodfol[016,1] )) .And. aFerIr[4] > 0
                        fSoma("FERBAS", SRR->RR_VALOR, SRR->RR_PD, SRH->RH_DTRECIB, lSegRecibo, SRR->RR_TIPO2, SRR->RR_CC + SRR->RR_ITEM + SRR->RR_CLVL, SRR->RR_SEMANA, SRR->RR_ROTEIR )

                        If SRR->(dbSeek(cChave + "F" + dDtBusFer + aCodfol[100,1] ))
                            fSoma("FERBAS", SRR->RR_VALOR, SRR->RR_PD, SRH->RH_DTRECIB, lSegRecibo, SRR->RR_TIPO2, SRR->RR_CC + SRR->RR_ITEM + SRR->RR_CLVL, SRR->RR_SEMANA, SRR->RR_ROTEIR )
                        Endif
                    Endif

                    lSegRecibo := .T.
                Endif
            Endif
        EndIf

        (cAlias)->(dbSkip())
    enddo
Return()


/*/{Protheus.doc} GPER050ATReportsBusinessObject::Static Function ChkDtPag
    Checa data de pagamento
    @type Method
    @version 12.1.2510
    @author karina.alves
    @since 29/10/2025
    @return Variant, Retorno nulo pré-fixado
    @obs Path parameters: param (nome do parâmetro solicitado)
/*/

Static Function ChkDtPag(cProcAux, cAliasSRA)
    Local cQuery        as Character
    Local oExec         as Object
    Local cAlias        as Character
    Local nParamOrder   as Numeric
    Local lRet          as Logical

    cQuery := ""
    oExec := NIL
    cAlias := ""
    nParamOrder := 1
    lRet := .F.

    //Montagem da query de busca que busca os valores
    cQuery = "SELECT "
    cQuery +=     "SRD.R_E_C_N_O_ "
    cQuery += "FROM "
    cQuery +=     RetSQLName("SRD") + " SRD "
    cQuery += "WHERE "
    cQuery +=     "SRD.RD_FILIAL =  ? "
    cQuery +=     "AND SRD.RD_MAT = ? "
    cQuery +=     "AND SRD.RD_DATPGT BETWEEN ? AND ? "
    cQuery +=     "AND SRD.RD_PROCES = ? "
    cQuery +=     "AND SRD.RD_PD = ? "
    cQuery +=     "AND SRD.D_E_L_E_T_ = ?  "
    cQuery := ChangeQuery(cQuery)

    oExec := FwExecStatement():New(cQuery)

    oExec:SetString(nParamOrder++, (cAliasSRA)->RA_FILIAL)
    oExec:SetString(nParamOrder++, (cAliasSRA)->RA_MAT)
    oExec:SetString(nParamOrder++, cDataDe)
    oExec:SetString(nParamOrder++, cDataAte)
    oExec:SetString(nParamOrder++, cProcAux)
    oExec:SetString(nParamOrder++, aCodFol[66,1])
    oExec:SetString(nParamOrder++, " ")

    cAlias := oExec:OpenAlias()

    lRet := IIf((cAlias)->(!Eof()), .T., .F.)

    (cAlias)->(dbCloseArea())
Return lRet

/*/{Protheus.doc} GPER050ATReportsBusinessObject::Static Function FTotAcumuladores
    Totaliza os valores
    @type Method
    @version 12.1.2510
    @author karina.alves
    @since 11/11/2025
    @return Variant, Retorno nulo pré-fixado
    @obs Path parameters: param (nome do parâmetro solicitado)
/*/

Static Function FTotAcumuladores(nDe, nAte)
    Local nTotalBase := 0
    Local nTotalIr   := 0
    Local nTotal     := 0
    Local nFor       := 0

    For nFor := nDe To nAte
        nTotalBase += aFolBas[nFor]
        nTotalIr   += aAdiBas[nFor]
        nTotalIr   += aFerBas[nFor]
        nTotalIr   += a13Bas [nFor]
        nTotalIr   += aFolIR [nFor]
        nTotalIr   += aAdiIR [nFor]
        nTotalIr   += aFerIR [nFor]
        nTotalIr   += a13IR  [nFor]
        nTotalIr   += aPLRBas[nFor]
        nTotalIr   += aPLRIR [nFor]
    Next nFor

    If nTotalIr > 0
        nTotal := nTotalBase + nTotalIr
    EndIf

Return(nTotal)
