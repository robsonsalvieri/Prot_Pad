#include "protheus.ch"

/*/{Protheus.doc} GPEA551SX
Faz a chamada do aplicativo GPEA551 - Previdência Complementar
@author  guilherme.suttanni
@since   14/01/2026
/*/
function GPEA551SX()
    Local oLauncher as Object
    oLauncher := totvs.framework.application.smartx.launcher():new()
    oLauncher:setInterface("totvs.rh.previdenciacomplementar.interface.gpea551")
Return oLauncher:open()
