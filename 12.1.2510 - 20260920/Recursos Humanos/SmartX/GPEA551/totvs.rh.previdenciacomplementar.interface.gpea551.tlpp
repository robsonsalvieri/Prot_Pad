#include 'fw-tlpp-core.th'
#include "protheus.ch"
#include "totvs.framework.structure.interface.th"
#include "RH.PREVIDENCIACOMPLEMENTAR.INTERFACE.GPEA551.CH"

namespace totvs.rh.previdenciacomplementar.interface

@totvsFrameworkStructureInterface(lookup=.F., country="ALL", description="Cadastro de Previdencia Complementar")

class GPEA551
    private data oInterface     as object
    private data oDataNew       as object
    private data oDataEdit      as object
    private data oDataDetail    as object
    private data oDataView      as object

    public method new() as object
    public method setInterface()
    public method getContract() as json

EndClass

Method new() as object class GPEA551
Return self

Method setInterface() class GPEA551

    Local oElementsCabec    as object
    Local oElementsSMU      as object
    Local oAdvplAction      as object
    Local aElements         as array

    ::oInterface := totvs.framework.structure.interface.BuildContract():new("gpea551")
    ::oInterface:setTitle(STR0001) // Cadastro de Previdencia Complementar
    ::oInterface:setModelId("totvs.rh.previdenciacomplementar.model.gpea551", .t.)
    ::oInterface:setVersion("1.0")

    // CABECALHO - Matricula, Nome e Data de Admissao
    oElementsCabec := totvs.framework.structure.interface.BuildElementsFromCode():new()
    oElementsCabec:addElements({"RA_MAT", "RA_NOME", "RA_ADMISSA"}, .F.)

    // GRID - Previdencia Complementar (SMU)
    oElementsSMU := totvs.framework.structure.interface.BuildElementsFromCode():new()
    oElementsSMU:addElements({"SMU"}, .F.)

    // Mescla cabecalho + grid
    aElements := totvs.framework.structure.interface.BuildElementsFromCode():mergeElements(;
        oElementsCabec:getElements(),;
        oElementsSMU:getElements();
    )

    ::oDataNew := totvs.framework.structure.interface.BuildDataNew():new("gpea551New", "totvs.rh.previdenciacomplementar.model.gpea551")
    ::oDataNew:setTitle(STR0002) // Incluir Previdencia Complementar
    ::oDataNew:setElement(aElements)

    ::oDataEdit := totvs.framework.structure.interface.BuildDataEdit():new("gpea551Edit", "totvs.rh.previdenciacomplementar.model.gpea551")
    ::oDataEdit:setTitle(STR0003) // Alterar Previdencia Complementar
    ::oDataEdit:setElement(aElements)

    ::oDataDetail := totvs.framework.structure.interface.BuildDataDetail():new("gpea551Detail", "totvs.rh.previdenciacomplementar.model.gpea551")
    ::oDataDetail:setTitle(STR0004) // Visualizar Previdencia Complementar
    ::oDataDetail:setElement(aElements)

    // Ação de Geracao Automatica
    oAdvplAction := totvs.framework.structure.interface.BuildAdvplAction():new()
    oAdvplAction:setLabel(STR0005) // Geracao Automática
    oAdvplAction:setRoutine("GPEM551")
    oAdvplAction:setHasResponse(.F.)

    ::oDataView := totvs.framework.structure.interface.BuildDataView():new("gpea551View", "totvs.rh.previdenciacomplementar.model.gpea551")
    ::oDataView:setModelId("totvs.rh.previdenciacomplementar.model.gpea551")
    ::oDataView:setTitle(STR0001) // Cadastro de Previdencia Complementar
    ::oDataView:assignInvisibleFields()
    ::oDataView:hideStandardPageAction("newAction")
    ::oDataView:addPageAction(oAdvplAction:getAction())

    ::oInterface:setDataNew(::oDataNew:getDataNew(), .f.)
    ::oInterface:setDataEdit(::oDataEdit:getDataEdit(), .f.)
    ::oInterface:setDataDetail(::oDataDetail:getDataDetail(), .f.)
    ::oInterface:setDataView(::oDataView:getDataView())

return

Method getContract() as json class GPEA551
return ::oInterface:getContract()
