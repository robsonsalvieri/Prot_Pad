#Include "fw-tlpp-core.th"
#Include "protheus.ch"
#Include "totvs.framework.model.events.th"
#Include "RH.PREVIDENCIACOMPLEMENTAR.EVENTS.GPEA551.CH"

namespace totvs.rh.previdenciacomplementar.events

class GPEA551

    public method new() as object

    @beforeUpdateInTransaction()
    public method beforeUpdateInTransaction(oData, oModel, oError, oSuccess) as logical

    @beforeDeleteInTransaction()
    public method beforeDeleteInTransaction(oData, oModel, oError, oSuccess) as logical
EndClass

Method new() as object class GPEA551
Return self

method beforeUpdateInTransaction(oData as object, oModel as object, oError as object, oSuccess as object) as logical class GPEA551
Return gp551ValidaSMU(oData, oError, .T.)

method beforeDeleteInTransaction(oData as object, oModel as object, oError as object, oSuccess as object) as logical class GPEA551
Return .T.

/*/{Protheus.doc} gp551ValidaSMU
    Validacoes gerais da grid SMU
    Portado do Gp551LOk + Gp551ClsOk do GPEA551.PRW
    @author guilherme.suttanni
    @since 29/04/2026
    @param oData, object, Dados do modelo
    @param oError, object, Objeto de erro
    @param lIsUpdate, logical, .T. se operacao e UPDATE (valida linhas todas deletadas)
    @return lRet, logical, .T. se valido
/*/
Static Function gp551ValidaSMU(oData as object, oError as object, lIsUpdate as logical) as logical

    Local lRet          := .T.
    Local aSMU          := {}
    Local nX            := 0
    Local nY            := 0
    Local cCodFor       := ""
    Local cPerIni       := ""
    Local cPerFim       := ""
    Local cAnoMesIni    := ""
    Local cAnoMesFim    := ""
    Local cAnoMesIniCmp := ""
    Local cAnoMesFimCmp := ""
    Local nLinhasAtivas := 0
    Local oSMUData      := Nil

    Default lIsUpdate := .F.

    oSMUData := oData:GetData()
    aSMU := oSMUData["SMU"]

    // Bloqueia se todas as linhas foram deletadas
    If lIsUpdate
        nLinhasAtivas := 0
        For nX := 1 to Len(aSMU)
            If ValType(aSMU[nX]["lDeleted"]) != "L" .Or. !aSMU[nX]["lDeleted"]
                nLinhasAtivas++
            EndIf
        Next nX

        If nLinhasAtivas == 0
            oError:set(400, STR0001, STR0002) // Validacao Alteracao | NNao e possivel salvar sem nenhum registro na grade de Previdencia Complementar.
            Return .F.
        EndIf
    EndIf

    // Valida sobreposicao de periodos por fornecedor
    For nX := 1 to Len(aSMU)

        If ValType(aSMU[nX]["lDeleted"]) == "L" .And. aSMU[nX]["lDeleted"]
            Loop
        EndIf

        cCodFor := AllTrim(aSMU[nX]["MU_CODFOR"])
        cPerIni := AllTrim(aSMU[nX]["MU_PERINI"])
        cPerFim := AllTrim(aSMU[nX]["MU_PERFIM"])

        // Valida mes do periodo inicial (01-12)
        If Val(SubStr(cPerIni, 1, 2)) < 1 .Or. Val(SubStr(cPerIni, 1, 2)) > 12
            oError:set(400, STR0005, STR0006) // Validacao de Datas | : Mes invalido. Informe um valor entre 01 e 12 no Periodo Inicial ou Final.
            Return .F.
        EndIf

        // Valida mes do periodo final quando preenchido (01-12)
        If !Empty(cPerFim) .And. (Val(SubStr(cPerFim, 1, 2)) < 1 .Or. Val(SubStr(cPerFim, 1, 2)) > 12)
            oError:set(400, STR0005, STR0006) // Validacao de Datas | : Mes invalido. Informe um valor entre 01 e 12 no Periodo Inicial ou Final.
            Return .F.
        EndIf

        cAnoMesIni := SubStr(cPerIni, 4, 4) + SubStr(cPerIni, 1, 2)
        cAnoMesFim := If(Empty(cPerFim), "299912", SubStr(cPerFim, 4, 4) + SubStr(cPerFim, 1, 2))

        For nY := 1 to Len(aSMU)
            If nY == nX .Or. (ValType(aSMU[nY]["lDeleted"]) == "L" .And. aSMU[nY]["lDeleted"])
                Loop
            EndIf

            If AllTrim(aSMU[nY]["MU_CODFOR"]) != cCodFor
                Loop
            EndIf

            cAnoMesIniCmp := SubStr(AllTrim(aSMU[nY]["MU_PERINI"]), 4, 4) + SubStr(AllTrim(aSMU[nY]["MU_PERINI"]), 1, 2)
            cAnoMesFimCmp := If(Empty(AllTrim(aSMU[nY]["MU_PERFIM"])), "299912", ;
                                SubStr(AllTrim(aSMU[nY]["MU_PERFIM"]), 4, 4) + SubStr(AllTrim(aSMU[nY]["MU_PERFIM"]), 1, 2))

            If cAnoMesIniCmp <= cAnoMesFim .And. cAnoMesFimCmp >= cAnoMesIni
                oError:set(400, STR0003, "Linha " + AllTrim(Str(nX)) + STR0004) // Validacao de Periodos | : Periodo se sobrepoe para o mesmo fornecedor.
                lRet := .F.
                Exit
            EndIf
        Next nY

        If !lRet
            Exit
        EndIf
    Next nX

Return lRet
