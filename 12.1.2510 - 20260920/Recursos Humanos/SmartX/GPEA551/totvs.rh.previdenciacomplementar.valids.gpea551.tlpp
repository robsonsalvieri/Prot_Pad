#include 'fw-tlpp-core.th'
#include "protheus.ch"
#include "totvs.framework.model.events.th"
#include "RH.PREVIDENCIACOMPLEMENTAR.VALIDS.GPEA551.CH"

namespace totvs.rh.previdenciacomplementar.valids

/*/{Protheus.doc} vldPerFimSMU
    Valida o campo MU_PERFIM - Periodo Final deve ser >= Periodo Inicial
    Formato dos campos: MM/AAAA (picture @R 99/9999)
    @type  Function
    @author guilherme.suttanni
    @since 29/04/2026
    @version 1.0
    @param xValue, any, Valor do campo MU_PERFIM
    @param cField, character, Nome do campo sendo validado
    @param aContextInfo, array, [0] = MU_PERINI da linha atual
    @return jRet, json, Retorno Json
    @example {"type":"serverValidate","function":"totvs.rh.previdenciacomplementar.valids.vldPerFimSMU","contextInfo":["{{$selectedRow.MU_PERINI}}"]}
/*/
Function vldPerFimSMU(xValue as variant, cField as character, aContextInfo as array) as Json

    Local jRet      := JsonObject():new() as Json
    Local lRet      := .T.
    Local cPerFim   := AllTrim(xValue)
    Local cPerIni   := ""
    Local cAnoMesFim := ""
    Local cAnoMesIni := ""

    // Periodo final em branco e permitido (sem data fim = indefinido)
    If Empty(cPerFim)
        jRet['return']          := .T.
        jRet['notValidMessage'] := ""
        Return jRet
    EndIf

    If Len(aContextInfo) >= 1
        cPerIni := AllTrim(aContextInfo[1])
    EndIf

    If !Empty(cPerIni) .And. !Empty(cPerFim)
        // Converte MM/AAAA para AAAAMM para comparacao
        cAnoMesFim := SubStr(cPerFim, 4, 4) + SubStr(cPerFim, 1, 2)
        cAnoMesIni := SubStr(cPerIni, 4, 4) + SubStr(cPerIni, 1, 2)

        If cAnoMesFim < cAnoMesIni
            lRet := .F.
        EndIf
    EndIf

    jRet['return'] := lRet
    If !lRet
        jRet['notValidMessage'] := STR0001 // Periodo Final deve ser maior ou igual ao Periodo Inicial
    Else
        jRet['notValidMessage'] := ""
    EndIf

Return jRet
