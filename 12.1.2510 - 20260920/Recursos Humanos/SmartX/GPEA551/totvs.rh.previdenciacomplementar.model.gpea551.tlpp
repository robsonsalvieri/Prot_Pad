#include 'fw-tlpp-core.th'
#include "protheus.ch"
#include "totvs.framework.structure.model.th"
 
namespace totvs.rh.previdenciacomplementar.model
 
@totvsFrameworkStructureModel(lookup=.F., country="ALL", description="Cadastro de Previdencia Complementar")
 
class GPEA551 from totvs.framework.structure.model.data
    public method new() as object
    public method setModel()
EndClass

Method new() as object class GPEA551
    _Super:new(,,.T.)
Return self
 
method setModel() class GPEA551
    Local oSRA          As Object
    Local oSMU          As Object
    Local oLookupS073   As Object
   
    // CABECALHO - Funcionarios (SRA)
    oSRA := totvs.framework.structure.object.ObjectFromMetadata():new("SRA", ;
                                                                        {"RA_FILIAL", "RA_MAT", "RA_NOME", "RA_ADMISSA"}, ;
                                                                        {"RA_FILIAL", "RA_MAT"})
    self:setObject(oSRA:getObject(), "SRA", .T., .F., {"RA_FILIAL", "RA_MAT", "RA_NOME", "RA_ADMISSA"})
    
    // Campos SRA: filial oculta, demais somente leitura
    self:setProperty("RA_FILIAL",   "hidden",   .T., "SRA")
    self:setProperty("RA_MAT",      "readOnly", .T., "SRA")
    self:setProperty("RA_NOME",     "readOnly", .T., "SRA")
    self:setProperty("RA_ADMISSA",  "readOnly", .T., "SRA")

    // GRID - Previdencia Complementar (SMU)
    oSMU := totvs.framework.structure.object.ObjectFromMetadata():new("SMU", , {"MU_FILIAL", "MU_MAT", "MU_CODFOR", "MU_PERINI"})
    self:addArray(oSMU:getObject(), "SMU", {"MU_FILIAL", "MU_MAT"}, {"RA_FILIAL", "RA_MAT"}, "SRA")

    // Esconde chaves estrangeiras na grid
    self:setProperty("MU_FILIAL",  "hidden",   .T., "SMU")
    self:setProperty("MU_MAT",     "hidden",   .T., "SMU")

    // Campo preenchido automaticamente pelo trigger SX7 do fornecedor
    self:setProperty("MU_NOMEEMP", "readOnly", .T., "SMU")

    // Lookup personalizado do Fornecedor de Previdência (tabela RCC via S073)
    oLookupS073 := totvs.framework.structure.model.lookup():new()
    oLookupS073:setLookup("totvs.rh.previdenciacomplementar.model.lookup.S073", "XTX_COD",,, {"XTX_COD"})
    self:AddLookup("MU_CODFOR", "SMU", oLookupS073:getLookup())

    // Campos obrigatórios na gravação
    self:addRequired({"MU_CODFOR", "MU_PERINI"}, "SMU")

    // Vincula os eventos da rotina
    self:setEvents(totvs.rh.previdenciacomplementar.events.GPEA551():new())
    
return
