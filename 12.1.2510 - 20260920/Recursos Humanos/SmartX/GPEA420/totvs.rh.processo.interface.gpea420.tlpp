#include "tlpp-core.th"
#include "totvs.ch"
#include "totvs.framework.structure.interface.th"
#include "totvs.rh.processo.interface.gpea420.ch"

using namespace totvs.framework.structure.interface

namespace totvs.rh.processo.interface

@totvsFrameworkStructureInterface(lookup=.F., country="ALL", description="Cadastro de Processos")

/*/{Protheus.doc} GPEA420
Define a interface SmartX do cadastro de processos.
@type class
@author Guilherme Suttanni
@since 03/09/2026
/*/
class GPEA420
    private data oInterface  as object
    private data oDataNew    as object
    private data oDataEdit   as object
    private data oDataDetail as object
    private data oDataView   as object

    public method new() as object
    public method setInterface()
    public method getContract() as json
EndClass

/*/{Protheus.doc} GPEA420::new
Instancia a interface do cadastro de processos.
@type method
@author Guilherme Suttanni
@since 03/09/2026
@return object, Instancia da interface
/*/
Method new() as object class GPEA420
Return self

/*/{Protheus.doc} GPEA420::setInterface
Configura as operacoes, a consulta e as acoes da interface.
@type method
@author Guilherme Suttanni
@since 03/09/2026
/*/
Method setInterface() class GPEA420
    Local cModel       := "totvs.rh.processo.model.gpea420" as character
    Local oCoresOrigem := LabelColors():new() as object
    Local oReplicar    as object

    ::oInterface := BuildContract():new("gpea420")
    ::oInterface:setTitle(STR0001) // "Cadastro de Processos"
    ::oInterface:setModelId(cModel, .T.)
    ::oInterface:setVersion("1.0")

    ::oDataNew := BuildDataNew():new("gpea420New", cModel)
    ::oDataNew:setTitle(STR0002) // "Incluir Processo"

    ::oDataNew:addProperty("RCJ", "RCJ_ORIGEM", "hidden", .T.)

    ::oDataEdit := BuildDataEdit():new("gpea420Edit", cModel)
    ::oDataEdit:setTitle(STR0003) // "Alterar Processo"
    ::oDataEdit:addProperty("RCJ", "RCJ_CODIGO", "readOnly", .T.)
    ::oDataEdit:addProperty("RCJ", "RCJ_ORIGEM", "hidden", .T.)

    ::oDataDetail := BuildDataDetail():new("gpea420Detail", cModel)
    ::oDataDetail:setTitle(STR0004) // "Visualizar Processo"
    ::oDataDetail:addProperty("RCJ", "RCJ_ORIGEM", "hidden", .T.)

    ::oDataView := BuildDataView():new("gpea420View", cModel)
    ::oDataView:setModelId(cModel)
    ::oDataView:setTitle(STR0001) // "Cadastro de Processos"
    ::oDataView:assignInvisibleFields()
    oCoresOrigem:bindColor("1", STR0005, "blue1") // "Processo Exclusivo do Sistema"
    oCoresOrigem:bindColor("2", STR0006, "green1") // "Processo de Cliente"
    ::oDataView:setFieldAsLabel("RCJ", "RCJ_ORIGEM", oCoresOrigem:getObject(), .T.)

    If FindFunction("GPEM941")
        oReplicar := BuildAdvplAction():new()
        oReplicar:setLabel(STR0007) // "Replicar"
        oReplicar:setRoutine("totvs.rh.processo.events.gpea420Replicar")
        oReplicar:setHasResponse(.F.)
        ::oDataView:addPageAction(oReplicar:getAction())
    EndIf

    ::oInterface:setDataNew(::oDataNew:getDataNew())
    ::oInterface:setDataEdit(::oDataEdit:getDataEdit())
    ::oInterface:setDataDetail(::oDataDetail:getDataDetail())
    ::oInterface:setDataView(::oDataView:getDataView())
return

/*/{Protheus.doc} GPEA420::getContract
Retorna o contrato da interface SmartX.
@type method
@author Guilherme Suttanni
@since 03/09/2026
@return json, Contrato da interface
/*/
Method getContract() as json class GPEA420
Return ::oInterface:getContract()
