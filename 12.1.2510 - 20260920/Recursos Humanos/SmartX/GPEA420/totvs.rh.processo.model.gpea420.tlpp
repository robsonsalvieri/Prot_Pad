#include "tlpp-core.th"
#include "totvs.ch"
#include "totvs.framework.structure.interface.th"
#include "totvs.framework.structure.model.th"

using namespace totvs.framework.structure.interface
using namespace totvs.framework.structure.object
using namespace totvs.rh.processo.events

namespace totvs.rh.processo.model

@totvsFrameworkStructureModel(lookup=.F., country="ALL", description="Cadastro de Processos")

/*/{Protheus.doc} GPEA420
Define o modelo SmartX do cadastro de processos.
@type class
@author Guilherme Suttanni
@since 03/09/2026
/*/
class GPEA420 from totvs.framework.structure.model.data
    public method new() as object
    public method setModel()
EndClass

/*/{Protheus.doc} GPEA420::new
Instancia o modelo do cadastro de processos.
@type method
@author Guilherme Suttanni
@since 03/09/2026
@return object, Instancia do modelo
/*/
Method new() as object class GPEA420
    _Super:new(,,.T.)
Return self

/*/{Protheus.doc} GPEA420::setModel
Configura a entidade RCJ e seus eventos.
@type method
@author Guilherme Suttanni
@since 03/09/2026
/*/
method setModel() class GPEA420
    Local oAdvplAct   := BuildAdvplAction():new() as object
    Local oInitEvents := BuildEvents():new() as object
    Local oOrigem     := BuildTargetFieldStructure():new() as object
    Local oRCJ        as object
    Local oSetOrigem  := BuildSetFieldsAction():new() as object

    oRCJ := ObjectFromMetadata():new("RCJ", , {"RCJ_FILIAL", "RCJ_CODIGO"})
    self:setObject(oRCJ:getObject(), "RCJ")
    self:setProperty("RCJ_ORIGEM", "hidden", .F., "RCJ")
    self:setProperty("RCJ_TIVCV", "hidden", cPaisLoc == "PTG", "RCJ")

    oOrigem:setIdentifier("RCJ_ORIGEM")
    oOrigem:setValue("{{$response.RCJ_ORIGEM}}")
    oSetOrigem:setLabel("setProcessOrigin")
    oSetOrigem:setIdentifier("setProcessOrigin")
    oSetOrigem:addTargetField(oOrigem:getStructure())

    oAdvplAct:setLabel("getProcessOrigin")
    oAdvplAct:setRoutine("totvs.rh.processo.model.gpea420ProcessOriginInitializer")
    oAdvplAct:setHasResponse(.T.)
    oAdvplAct:setAction(oSetOrigem:getAction())

    oInitEvents:addOnLoad({"dataNew"}, , oAdvplAct:getAction())
    self:addInitializers(oInitEvents:getEvents())

    self:setEvents(GPEA420Events():new())
return

/*/{Protheus.doc} gpea420ProcessOriginInitializer
Retorna a origem utilizada na inclusao de processos pelo cliente.
@type Function
@author Guilherme Suttanni
@since 10/09/2026
@return character, JSON com a origem do processo
/*/
Function gpea420ProcessOriginInitializer()
    Local jResponse := JsonObject():new() as json

    jResponse["RCJ_ORIGEM"] := "2"
Return jResponse:ToJson()
