#include 'fw-tlpp-core.th'
#include "protheus.ch"
#include "totvs.framework.model.events.th"
#include "gpea934csx.ch"

namespace totvs.rh.entidadeseducativas.valids

/*/{Protheus.doc} gp934CvldIniRJSX
    Valida se o campo RJ6_INI está no formato AAAAMM e representa um período válido
    Formato dos campos: AAAAMM
    @type  Function
    @author karina.alves
    @since 28/05/2026
    @version 1.0
    @param xValue, any, Valor do campo RJ6_INI
    @param cField, character, Nome do campo sendo validado
    @param aContextInfo, array, [0] = RJ6_INI da linha atual
    @return jRet, json, Retorno Json
    @example {"type":"serverValidate","function":"totvs.rh.entidadeseducativas.valids.gp934CvldIniRJSX","contextInfo":[]}
/*/
Function gp934CvldIniRJSX(xValue as variant, cField as character, aContextInfo as array) as Json
    
    Local cDtIni := xValue
    Local lPerOk := .T.
    Local jRet   := JsonObject():new() as Json
    Local nAno	 := 0
    Local nMes	 := 0

	// Valida se o período está no formato AAAAMM
	If Valtype(cDtIni) == "C" .And. !Empty(cDtIni)
		nAno := Val(SubStr(cDtIni, 0, 4))
		nMes := Val(SubStr(cDtIni, 5, 2))
		If (nAno < 1900 .Or. nAno > 3000 ) .Or. (nMes < 1 .Or. nMes > 12 )
			lPerOk:= .F.
		EndIf
	Else
		lPerOk := .F.
	EndIf

    jRet['return'] := lPerOk

    If !lPerOk
        jRet['notValidMessage'] := STR0006 // STR0006 - "O campo RJ6_INI deve estar no formato AAAAMM e representar um período válido."
    Else
        jRet['notValidMessage'] := ""
    EndIf

Return jRet
