#include 'fw-tlpp-core.th'
#include "protheus.ch"
#include "totvs.framework.model.events.th"
#Include "totvs.rh.obrasproprias.valids.gpea934a.ch"

namespace totvs.rh.obrasproprias.valids

/*/{Protheus.doc} gp934aVldFAP
    @type  Function
    @author Caio Kretzer
    @since 21/05/2026
    @version 1.0
    @param xValue, any, Valor do campo a ser validado
    @param cField, character, Nome do campo sendo validado
    @param aContextInfo, array, Array de campos do modelo 
    @return jRet, json, Retorno Json
    @example {"type":"serverValidate", 
     "function":"totvs.rh.obrasproprias.valids.gp934aVldFAP",
     "contextInfo":[]}
/*/
Function gp934aVldFAP(xValue,cField,aContextInfo) as Json

    Local jRet      := JsonObject():new() as Json
    Local nValFAP   := xValue
    Local lRet      := .F.

    If nValFAP >= 0.5 .AND. nValFAP <= 2
        lRet := .T.
    Endif

    jRet['return'] := lRet
    If !lRet
        jRet['notValidMessage'] := STR0001 // "O valor informado não está dentro do intervalo permitido (0,5 a 2,0)"
    Else 
        jRet['notValidMessage'] := ""
    Endif

Return jRet

/*/{Protheus.doc} gp934avldIniRJSX
    Valida se o campo RJ4_INI está no formato AAAAMM e representa um período válido
    Formato dos campos: AAAAMM
    @type  Function
    @author caio.kretzer
    @since 06/07/2026
    @version 1.0
    @param xValue, any, Valor do campo RJ4_INI
    @param cField, character, Nome do campo sendo validado
    @param aContextInfo, array, [0] = RJ4_INI da linha atual
    @return jRet, json, Retorno Json
    @example {"function":"totvs.rh.obrasproprias.valids.gp934avldIniRJSX","contextInfo":["{{$selectedRow.RJ4_INI}}"],"type":"serverValidate"}
/*/
Function gp934avldIniRJSX(xValue as variant, cField as character, aContextInfo as array) as Json
    
    Local cDtIni := xValue
    Local lPerOk := .T.
    Local jRet   := JsonObject():new() as Json
    Local nAno	 := 0
    Local nMes	 := 0

	// Valida se o período está no formato AAAAMM
	If Valtype(cDtIni) == "C" .And. !Empty(cDtIni)
		nAno := Val(SubStr(cDtIni, 0, 4))
		nMes := Val(SubStr(cDtIni, 5, 2))
		If (nAno < 1900 .Or. nAno > 3000 ) .Or. (nMes < 1 .Or. nMes > 12 )
			lPerOk:= .F.
		EndIf
	Else
		lPerOk := .F.
	EndIf

    jRet['return'] := lPerOk

    If !lPerOk
        jRet['notValidMessage'] := STR0002 // "O campo RJ4_INI deve estar no formato AAAAMM e representar um período válido."
    Else
        jRet['notValidMessage'] := ""
    EndIf

Return jRet

/*/{Protheus.doc} gp934aVldRAT
    @type  Function
    @author Caio Kretzer
    @since 21/07/2026
    @version 1.0
    @param xValue, any, Valor do campo a ser validado
    @param cField, character, Nome do campo sendo validado
    @param aContextInfo, array, Array de campos do modelo 
    @return jRet, json, Retorno Json
    @example {"type":"serverValidate", 
     "function":"totvs.rh.obrasproprias.valids.gp934aVldRAT",
     "contextInfo":[]}
/*/
Function gp934aVldRAT(xValue,cField,aContextInfo) as Json

    Local jRet      := JsonObject():new() as Json
    Local nValFAP   := xValue
    Local lRet      := .F.

    If nValFAP >= 1 .AND. nValFAP <= 3
        lRet := .T.
    Endif

    jRet['return'] := lRet
    If !lRet
        jRet['notValidMessage'] := STR0003 // "O valor informado não está dentro do intervalo permitido (1 a 3)"
    Else 
        jRet['notValidMessage'] := ""
    Endif

Return jRet

/*/{Protheus.doc} gp934aVldCNPJR
    @type  Function
    @author Caio Kretzer
    @since 21/07/2026
    @version 1.0
    @param xValue, any, Valor do campo a ser validado
    @param cField, character, Nome do campo sendo validado
    @param aContextInfo, array, Array de campos do modelo 
    @return jRet, json, Retorno Json
    @example {"type":"serverValidate", 
     "function":"totvs.rh.obrasproprias.valids.gp934aVldCNPJR",
     "contextInfo":[]}
/*/
Function gp934aVldCNPJR(xValue,cField,aContextInfo) as Json

    Local jRet      := JsonObject():new() as Json
    Local cValCGC   := xValue
    Local lRet      := .F.

    lRet := Empty(cValCGC) .Or. CGC(cValCGC) 

    jRet['return'] := lRet
    If !lRet
        jRet['notValidMessage'] := STR0004 // "CNPJ inválido. Informe um CNPJ válido ou deixe o campo em branco."
    Else 
        jRet['notValidMessage'] := ""
    Endif

Return jRet
