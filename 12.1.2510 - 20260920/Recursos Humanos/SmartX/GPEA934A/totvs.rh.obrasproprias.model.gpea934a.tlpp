#include 'fw-tlpp-core.th'
#include "protheus.ch"
#include "totvs.framework.structure.model.th"

namespace totvs.rh.obrasproprias.model

@totvsFrameworkStructureModel(lookup=.F., country="ALL", description="Cadastro de Obras Próprias") // Cadastro de Obras Próprias

class GPEA934a from totvs.framework.structure.model.data
    public method new() as object
    public method setModel()
EndClass

/*/{Protheus.doc} new
Instância do objeto da classe
@author isabel.noguti
@since 04/12/2025
@version P12
@return object, objeto da classe
/*/
Method new() as object class GPEA934a
    _Super:new(,,.T.)
Return self

 /*/{Protheus.doc} setModel
Instância modelo
@author isabel.noguti
@since 04/12/2025
@version P12
@return object, objeto da classe
/*/
method setModel() class GPEA934a
    Local oRJ4	        As Object
    Local oEvents      As Object
    Local oLookupApr	As Object


    oRJ4 := totvs.framework.structure.object.ObjectFromMetadata():new( "RJ4", /*campos editaveis*/ , {"RJ4_FILIAL", "RJ4_INI", "RJ4_TPINSC", "RJ4_NINSCR"} ) // se nao passar campo editavel, aparece tudo
    self:setObject(oRJ4:getObject(), "RJ4")

	// Vincula lookup ao RJ4_APR: S1191 indicativo de contratacao de aprendiz
    oLookupApr := totvs.framework.structure.model.lookup():new()
    oLookupApr:setLookup("totvs.rh.obrasproprias.model.lookup.tpAprendiz", "XTX_CODIGO",,, {"XTX_CODIGO"})
    oFinder := totvs.framework.structure.model.finder():new()
    oFinder:setFinder({"XTX_CODIGO"})
    oLookupApr:setFinder(oFinder:getFinder())
    self:AddLookup("RJ4_APR", "RJ4", oLookupApr:getLookup())

    // Vincula lookup ao RJ4_PON: S1191 Registro de Ponto
    oLookupPon := totvs.framework.structure.model.lookup():new()
    oLookupPon:setLookup("totvs.rh.obrasproprias.model.lookup.regPonto", "XTX_CODIGO",,, {"XTX_CODIGO"})
    oFinder := totvs.framework.structure.model.finder():new()
    oFinder:setFinder({"XTX_CODIGO"})
    oLookupPon:setFinder(oFinder:getFinder())
    self:AddLookup("RJ4_PON", "RJ4", oLookupPon:getLookup())

	self:LoadEventsFromMetadata()

    // Força que a filial apareça na grid
    self:setProperty("RJ4_FILIAL",  "hidden",   .F., "RJ4")

    // Adiciona os eventos
    oEvents := totvs.rh.obrasproprias.events.GPEA934aEvents():new()
    self:setEvents( oEvents )

    FwFreeObj( oRJ4 )

return
