#Include "fw-tlpp-core.th"
#Include "protheus.ch"
#Include "totvs.framework.model.events.th"
#Include "TopConn.ch"
#Include "RestFul.ch"
#Include "Totvs.ch"
#Include "FWMVCDEF.ch"
#Include "totvs.rh.obrasproprias.events.gpea934a.ch"

Static lMiddleware  := SuperGetMv("MV_MID",, .F.)

namespace totvs.rh.obrasproprias.events

/*/ {Protheus.doc} GPEA934aEvents
    Eventos do cadastro de obras proprias - SmartX
    @author caio.kretzer
    @since 16/09/2025
/*/
class GPEA934aEvents
    public method new() as object

    @beforeCreateInTransaction()
    public method beforeCreateInTransaction(oData, oModel, oError) as logical

    @beforeUpdateInTransaction()
    public method beforeUpdateInTransaction(oData, oModel, oError) as logical

    @beforeDeleteInTransaction()
    public method beforeDeleteInTransaction(oData, oModel, oError) as logical
EndClass

Method new() as object class GPEA934aEvents
Return self

/*/ {Protheus.doc} beforeCreateInTransaction
    Evento executado antes da inclusão
    @author caio.kretzer
    @since 23/09/2025
    @param oData - Dados do registro
    @param oModel - Modelo de dados
    @param oError - Objeto de erro
    @return lRet - Se pode incluir
/*/
method beforeCreateInTransaction(oData as object, oModel as object, oError as object, oSuccess as object) as logical class GPEA934aEvents
    Local lRet          := .T.
    Local oDataRJ4      := oData:GetData()
    Local aLogResult    := {}
    Local aLogMsg       := {}

    // Executa validações gerais TudOk
    If !fExecutaValidacoesTudOk(oDataRJ4, 3, @aLogResult, @aLogMsg)
        fExibeLogMsg(aLogResult, oError, oSuccess, .T.)
        lRet := .F.
    ElseIf Len(aLogMsg) > 0
        fExibeLogMsg(aLogMsg, oError, oSuccess, .F.)
    EndIf
    

return lRet

/*/ {Protheus.doc} beforeUpdateInTransaction
    Evento executado antes do update/alteração
    @author caio.kretzer
    @since 19/09/2025
    @param oData - Dados do registro
    @param oModel - Modelo de dados
    @param oError - Objeto de erro
    @return lRet - Se pode alterar
/*/
method beforeUpdateInTransaction(oData as object, oModel as object, oError as object, oSuccess as object) as logical class GPEA934aEvents
    Local lRet          := .T.
    Local oDataRJ4      := oData:GetData()
    Local aLogResult    := {}
    Local aLogMsg       := {}

    // Executa validações gerais TudOk
    If !fExecutaValidacoesTudOk(oDataRJ4, 4, @aLogResult, @aLogMsg)
        fExibeLogMsg(aLogResult, oError, oSuccess, .T.)
        lRet := .F.
    ElseIf Len(aLogMsg) > 0
        fExibeLogMsg(aLogMsg, oError, oSuccess, .F.)
    EndIf

return lRet

/*/ {Protheus.doc} beforeDeleteInTransaction
    Evento executado antes da exclusão
    @author caio.kretzer
    @since 19/09/2025
    @param oData - Dados do registro
    @param oModel - Modelo de dados
    @param oError - Objeto de erro
    @return lRet - Se pode excluir
/*/
method beforeDeleteInTransaction(oData as object, oModel as object, oError as object, oSuccess as object) as logical class GPEA934aEvents
    Local lRet          := .T.
    Local oDataRJ4      := oData:GetData()
    Local aLogResult    := {}
    Local aLogMsg       := {}

    // Executa validações gerais TudOk
    If !fExecutaValidacoesTudOk(oDataRJ4, 5, @aLogResult, @aLogMsg)
        fExibeLogMsg(aLogResult, oError, oSuccess, .T.)
        lRet := .F.
    ElseIf Len(aLogMsg) > 0
        fExibeLogMsg(aLogMsg, oError, oSuccess, .F.)
    EndIf

return lRet


/*/ {Protheus.doc} fExecutaValidacoesTudOk
    Executa validações
    @author caio.kretzer
    @since 15/01/2025
    @param oDataRJ4 - Dados da verba
    @param nOperacao - Operação (3=Inclusão, 4=Alteração, 5=Exclusão)
    @param aLogError - Array de log erro
    @param aLogMsg - Array de log mensagem
    @return lRet - Se passou nas validações
/*/
Static Function fExecutaValidacoesTudOk(oDataRJ4, nOperacao, aLogError, aLogMsg)
    Local lRet          := .T.
    Local lNT15		    := .F.
	Local lCposRatFap	:= (oDataRJ4:HasProperty("RJ4_TPRAT") .And. oDataRJ4:HasProperty("RJ4_TPFAP"))

    If nOperacao != 5 //Se não for exclusão

        fVersEsoc("S1005", .F., Nil, Nil, Nil, Nil ,Nil, @lNT15)

        If oDataRJ4["RJ4_APR"] == "1" .AND. Empty(oDataRJ4["RJ4_PRC"])
            aAdd(aLogError, STR0001) // "Número do Processo (RJ4_PRC) deve ser informado quando o campo Contrata Aprendiz (RJ4_APR) estiver como '3'. Informar o Número do Processo (RJ4_PRC) que isenta a empresa na contratação do aprendiz"
            lRet := .F.	
        ElseIf !lNT15 .And. oDataRJ4["RJ4_APR"] $ "1/2" .AND. Empty(oDataRJ4["RJ4_EED"])
            aAdd(aLogError, STR0002 + " " + STR0003) // "Entidade Educativa (RJ4_EED) é obrigatório quando o campo Contrata Aprendiz (RJ4_APR) for igual a '1' ou '2'." + "Informar se o estabelecimento realiza a contratação de aprendiz por intermédio de entidade educativa sem fins lucrativos que tenha por objetivo a assistência ao adolescente e à educação profissional (art. 430, inciso II, CLT) ou por entidade de prática desportiva filiada ao Sistema Nacional do Desporto ou a Sistema de Desporto de Estado, do Distrito Federal ou de Município (art. 430, inciso III, CLT)."
            lRet := .F.	        
        EndIf

        If lRet .And. !lMiddleware
            If oDataRJ4['RJ4_TPINSC'] == '4' .And. Empty(oDataRJ4['RJ4_ISC'])
                aAdd(aLogError, STR0004) // "Caso a empresa seja uma construtora e o tomador do tipo 4, o campo campo 'Ind. Cont. Pat' deve ser preenchido."
            Endif
        Endif

        If lRet .And. lCposRatFap
            Do Case
                Case !Empty(oDataRJ4["RJ4_TPRAT"]) .And. (Empty(oDataRJ4["RJ4_NPRAT"]) .Or. Empty(oDataRJ4["RJ4_SURAT"]))
                    aAdd(aLogError, STR0005) // "Ao preencher algum campo referente ao Processo RAT, todos campos refente ao RAT devem ser preenchidos."
                    lRet := .F. 
                Case !Empty(oDataRJ4["RJ4_NPRAT"]) .And. (Empty(oDataRJ4["RJ4_TPRAT"]) .Or. Empty(oDataRJ4["RJ4_SURAT"])) 
                    aAdd(aLogError, STR0005) // "Ao preencher algum campo referente ao Processo RAT, todos campos refente ao RAT devem ser preenchidos."
                    lRet := .F.
                Case !Empty(oDataRJ4["RJ4_SURAT"]) .And. (Empty(oDataRJ4["RJ4_NPRAT"]) .Or. Empty(oDataRJ4["RJ4_TPRAT"])) 
                    aAdd(aLogError, STR0005) // "Ao preencher algum campo referente ao Processo RAT, todos campos refente ao RAT devem ser preenchidos."
                    lRet := .F.
                Case !Empty(oDataRJ4["RJ4_TPFAP"]) .And. (Empty(oDataRJ4["RJ4_NPFAP"]) .Or. Empty(oDataRJ4["RJ4_SUFAP"]))
                    aAdd(aLogError, STR0006) // "Ao preencher algum campo referente ao Processo FAP, todos campos refente ao FAP devem ser preenchidos."
                    lRet := .F.
                Case !Empty(oDataRJ4["RJ4_NPFAP"]) .And. (Empty(oDataRJ4["RJ4_TPFAP"]) .Or. Empty(oDataRJ4["RJ4_SUFAP"])) 
                    aAdd(aLogError, STR0006) // "Ao preencher algum campo referente ao Processo FAP, todos campos refente ao FAP devem ser preenchidos."
                    lRet := .F.
                Case !Empty(oDataRJ4["RJ4_SUFAP"]) .And. (Empty(oDataRJ4["RJ4_NPFAP"]) .Or. Empty(oDataRJ4["RJ4_TPFAP"])) 
                    aAdd(aLogError, STR0006) // "Ao preencher algum campo referente ao Processo FAP, todos campos refente ao FAP devem ser preenchidos."
                    lRet := .F.
            EndCase
        EndIf
    Endif

    If lRet
        lRet := fIntegra(nOperacao, oDataRJ4, @aLogError, @aLogMsg)
    Endif
    
Return lRet


/*/ {Protheus.doc} fExibeLogMsg
    Exibe log de erros das validações
    @author caio.kretzer
    @since 15/01/2025
    @param aLogMsg - Array com mensagens
    @param oError - Objeto de erro
    @param lIsError - Indica se é erro ou aviso
/*/
Static Function fExibeLogMsg(aLogMsg, oError, oSuccess, lIsError)
    Local cMsg := ""
    Local nI := 0

    If Len(aLogMsg) > 0

        For nI := 1 To Len(aLogMsg)
            cMsg += " • " + aLogMsg[nI]
            If nI < Len(aLogMsg)
                cMsg += "; "
            EndIf
        Next nI

        If lIsError
            oError:set(400, STR0007, cMsg) // "Erro(s) na validação dos dados:"
        Else
            oSuccess:set(200, STR0008, cMsg) // "Registro salvo com sucesso! Veja detalhes da validação da integração."
        EndIf
        
    EndIf
Return

Static Function fIntegra(nOperation, oDataRJ4, aLogError, aLogMsg)

    Local lRet       	:= .T.
    Local aArea      	:= GetArea()
    Local cStatus		:= ""	
    Local cAnoMesP  	:= "" 
    Local aErros		:= {}
    Local aInfoC		:= {}
    Local cMesAnoP		:= ""
    Local cChave		:= ""
    Local cTpInsc		:= ""
    Local cEFDAviso	    := If(cPaisLoc == 'BRA' .And. Findfunction("fEFDAviso"), fEFDAviso(), SuperGetMv("MV_EFDAVIS",, "0")) 
    Local cStatRJE		:= "-1"
    Local cTpInsc1      := ""
    Local lAdmPubl1     := .F.
    Local cNrInsc1	    := ""
    Local lVld1000		:= .T.
    Local cStat1005     := ""
    Local cVersEnvio	:= ""
    Local lAlt			:= .F.
    Local lContinua		:= .T.
    Local lNT15			:= .F.
    Local cMsgErro      := ""

    fVersEsoc("S1005", .F., Nil, Nil, @cVersEnvio, Nil ,Nil, @lNT15)
    	
	//Se a versão de envio for 9.00.00 (S-1.0) verifica se houve alteração em algum campo que gera o XML
	If cVersEnvio >= "9.0.00" .And. nOperation == 4
        DbSelectArea("RJ4")
        RJ4->(dbSetOrder(1))
		RJ4->(DbGoTop())
        RJ4->(dbSeek(oDataRJ4['RJ4_FILIAL']+oDataRJ4['RJ4_INI']+oDataRJ4['RJ4_TPINSC']+oDataRJ4['RJ4_NINSCR']))
		lAlt := fCpoAlt(oDataRJ4)
	EndIf
	
	If lAlt .Or. nOperation != 4 
		
        cTpInsc	:= oDataRJ4['RJ4_TPINSC']

        cAnoMesP:= oDataRJ4['RJ4_INI']
        
        cMesAnoP := SUBSTR(oDataRJ4['RJ4_INI'],5,2) + SUBSTR(oDataRJ4['RJ4_INI'],1,4)

        If lMiddleware
            lVld1000 := fVld1000( AnoMes(dDataBase), @cStatRJE )
            
            If lVld1000
            
                aInfoC   := fXMLInfos()
                        
                IF LEN(aInfoC) >= 4
                    cTpInsc1  := aInfoC[1]
                    lAdmPubl1 := aInfoC[4]
                    cNrInsc1  := aInfoC[2]
                ELSE
                    cTpInsc1  := ""
                    lAdmPubl1 := .F.
                    cNrInsc1  := "0"
                ENDIF
            
                cChave  := cTpInsc1 + PADR( Iif( !lAdmPubl1 .And. cTpInsc1 == "1", SubStr(cNrInsc1, 1, 8), cNrInsc1), 14 ) + "S1005" + Padr(xFilial("RJ4") + oDataRJ4['RJ4_NINSCR'], fTamRJEKey(), " ") + Substr(cMesAnoP,3,4)+ Substr(cMesAnoP,1,2)
                cStat1005 := "-1"
                GetInfRJE( 2,cChave,@cStat1005)
                cStatus := cStat1005
            Else
                lRet := .F.
                cMsgRJE := OemtoAnsi(STR0010) // "Problema com o Evento S-1000"
                do Case 
                    case cStatRJE == "-1" // nao encontrado na base de dados
                        cMsgRJE := OemtoAnsi(STR0011) // "Registro do evento S-1000 não localizado na base de dados"
                    case cStatRJE == "1" // nao enviado para o governo
                        cMsgRJE := OemtoAnsi(STR0012) // "Registro do evento S-1000 não transmitido para o governo"
                    case cStatRJE == "2" // enviado e aguardando retorno do governo
                        cMsgRJE := OemtoAnsi(STR0013) // "Registro do evento S-1000 aguardando retorno do governo"
                    case cStatRJE == "3" // enviado e retornado com erro 
                        cMsgRJE := OemtoAnsi(STR0014) // "Registro do evento S-1000 retornado com erro do governo"
                endcase

                // Se tornar impeditivo o prosseguimento devido a presenca de inconsistencias
                If cEFDAviso == "0"
                    aAdd(aLogMsg, cMsgRJE)
                    // Com o parametro preenchido com 0, salva mesmo se der erro na integração.
                    lRet := .T.
                    Return lRet
                ElseIf cEFDAviso == "1"
                    aAdd(aLogError, cMsgRJE)
                    Return lRet
                Endif	
            Endif
            If lVld1000 .And. Findfunction("fEmpCons") .And. fEmpCons()
                If cTpInsc == "4" .And.  Empty(oDataRJ4['RJ4_ISC'])
                    //"O campo 'Ind. Cont. Pat' é de preenchimento obrigatório quando o tipo do estabelecimento for Obra
                    cMsgRJE := OemToAnsi(STR0015) // "O campo 'Ind. Cont. Pat' é de preenchimento obrigatório quando o tipo do estabelecimento for Obra"
                    aAdd(aLogError, cMsgRJE)
                    lRet :=	.F. 
                    Return lRet
                Endif	
            Endif	
        Else
            //Valida a filial de envio
            If Findfunction("fVldFilEnv")
                lContinua := fVldFilEnv(,,,.F., @cMsgErro)

                If !lContinua
                    lRet := cEFDAviso $ "0|2"
                EndIf
                
                //Apresenta mensagem de inconsistência na filial de referência do TAF
                If !lRet .And. !Empty(cMsgErro) 
                    aAdd(aLogError, cMsgErro)
                EndIf
            EndIf

            //TPINSC + NRINSC +  DTINI
            cStatus := TAFGetStat( "S-1005", cTpInsc + ";" + oDataRJ4['RJ4_NINSCR'] + ";" + cMesAnoP)
        EndIf
        
        If lContinua
            IF cStatus == "4" // JA INTEGRADO COM Middleware

                if nOperation == 3 // inclusao
                    If lMiddleware
                        aErros := MontaXML(nOperation, oDataRJ4)
                    Else
                        aAdd(aLogMsg, OemToAnsi(STR0016)) // "O registro já existe no TAF, será incluído apenas na tabela RJ4"
                    EndIf
                    
                    If Len( aErros ) <= 0
                        If lMiddleware
                            aAdd(aLogMsg, OemToAnsi(STR0017)) // "Registro enviado para MIDDLEWARE"
                            lRet :=	.T.
                        Else
                            aAdd(aLogMsg, OemToAnsi(STR0018)) // "Registro enviado para TAF"
                            aAdd(aLogMsg, OemToAnsi(STR0019)) // "A Chave dos eventos de tabela é composta pelo código da tabela e a data de início da vigência. Importante observar que, se informar uma data que já exista no fechamento da folha, será necessário reabrir a folha de pagamento (evento S-1298) e retificar os eventos periódicos (S-1200 e S-1210).")
                            /*
                                A Chave dos eventos de tabela é composta pelo código da tabela e a data de início da vigência. 
                                Importante observar que, se informar uma data que já exista no fechamento da folha, 
                                será necessário reabrir a folha de pagamento (evento S-1298) e 
                                retificar os eventos periódicos (S-1200 e S-1210)
                            */
                            lRet :=	.F. 
                        EndIf
                    else
                        aAdd(aLogError, aErros[1])
                        lRet := .F.
                    EndIf
                    
                elseif nOperation == 4 // alteracao
                    
                    aErros := MontaXML(nOperation, oDataRJ4)
                    
                    If Len( aErros ) <= 0
                        If lMiddleware
                            aAdd(aLogMsg, OemToAnsi(STR0017)) // "Registro enviado para MIDDLEWARE"
                            lRet :=	.T.
                        Else
                            aAdd(aLogMsg, OemToAnsi(STR0018)) // "Registro enviado para TAF"
                            aAdd(aLogMsg, OemToAnsi(STR0019)) // "A Chave dos eventos de tabela é composta pelo código da tabela e a data de início da vigência. Importante observar que, se informar uma data que já exista no fechamento da folha, será necessário reabrir a folha de pagamento (evento S-1298) e retificar os eventos periódicos (S-1200 e S-1210).")
                            lRet :=	.F. 
                        EndIf
                    else
                        aAdd(aLogError, aErros[1])
                        lRet := .F.
                    EndIf
                elseif nOperation == 5 // exclusao
                    If !( cStatus $ " |1|3|-1" )
                        
                        aErros := MontaXML(nOperation, oDataRJ4)
                        
                        If Len( aErros ) <= 0
                            If lMiddleware
                                aAdd(aLogMsg, OemToAnsi(STR0017)) // "Registro enviado para MIDDLEWARE"
                            Else
                                aAdd(aLogMsg, OemToAnsi(STR0018)) // "Registro enviado para TAF"
                            EndIf
                            
                        Else
                            FeSoc2Err( aErros[1], @cMsgErro , Iif( aErros[1]!='000026',1,2 ) )
                            If lMiddleware
                                aAdd(aLogMsg, aErros[1])
                                lRet := .T.
                            Else
                                aAdd(aLogError, aErros[1] + " - " + cMsgErro)
                                lRet :=	.F.
                            EndIf
                            
                                                
                        EndIf
                    EndIf
                    //lRet :=	FWFormCommit(oModel)
                EndIf
            ELSE
                if nOperation == 3 .or. nOperation == 4 // inclusao ou alteracao 
                        
                    if cStatus == "-1"//Registro não encontrado  
                        nOperation := 3 // inclusao 
                    else 
                        nOperation := 4 //alteracao
                    Endif
                    
                    aErros := MontaXML(nOperation, oDataRJ4)
                
                    If Len( aErros ) <= 0
                        If lMiddleware
                            aAdd(aLogMsg, OemToAnsi(STR0017)) // "Registro enviado para MIDDLEWARE"
                            lRet :=	.T.
                        Else
                            aAdd(aLogMsg, OemToAnsi(STR0018)) // "Registro enviado para TAF"
                            lRet :=	.T.
                        EndIf
                    Else
                        FeSoc2Err( aErros[1], @cMsgErro , Iif( aErros[1]!='000026',1,2 ) )
                        If lMiddleware
                            aAdd(aLogError, aErros[1] + " - " + cMsgErro)
                            lRet := .F.
                        Else
                            aAdd(aLogError, aErros[1] + " - " + cMsgErro)
                            lRet :=	.F.
                        Endif
                    EndIf
                elseif nOperation == 5 // exclusao
                    
                    aErros := MontaXML(nOperation, oDataRJ4)
                    
                    If Len( aErros ) <= 0
                        If lMiddleware
                            aAdd(aLogMsg, OemToAnsi(STR0017)) // "Registro enviado para MIDDLEWARE"
                            lRet :=	.T.
                            
                        Else
                            aAdd(aLogMsg, OemToAnsi(STR0018)) // "Registro enviado para TAF"
                            lRet :=	.T.
                        EndIf
                    Else
                        FeSoc2Err( aErros[1], @cMsgErro , Iif( aErros[1]!='000026',1,2 ) )
                        If lMiddleware
                            aAdd(aLogError, aErros[1] + " - " + cMsgErro)
                            lRet := .F.
                        Else
                            aAdd(aLogError, aErros[1] + " - " + cMsgErro)
                            lRet :=	.F.
                        Endif
                    EndIf
                EndIf	
            EndIf
        EndIf
	EndIf

    RestArea( aArea )

Return lRet


Static Function MontaXML(nOperation, oDataRJ4)

    Local aEstObras		:= {}
    Local cCnae			:= ""
    Local cSubPat		:= "" 
    Local aErros		:= {}
    Local lRetTaf		:= .F.
    Local cMesAnoP		:= ""
    Local aTabS120		:= {}
    Local nPos1			:= 0
    Local aEstEd		:= {}
    Local lCposRatFap	:= (oDataRJ4:HasProperty("RJ4_TPRAT") .And. oDataRJ4:HasProperty("RJ4_TPFAP"))
    Local lCNPJR		:= RJ4->(ColumnPos("RJ4_CNPJR")) > 0
    Local cCNPJR		:= ""

    cTpInsc	:= oDataRJ4['RJ4_TPINSC']

    cCnae	:= oDataRJ4['RJ4_CNAE']

    cAnoMesP:= oDataRJ4['RJ4_INI']
    cMesAnoP := SUBSTR(oDataRJ4['RJ4_INI'],5,2) + SUBSTR(oDataRJ4['RJ4_INI'],1,4)
    If lCNPJR
        cCNPJR:= oDataRJ4['RJ4_CNPJR']
    Endif

    //Busca informacao SubPatronal
    cSubPat := ""

    If oDataRJ4['RJ4_TPINSC'] == "4"
        cSubPat := oDataRJ4['RJ4_ISC']
    EndIf

    If Len(aEstEd) == 0  // so deve carregar uma vez este array
        
        fCarrTab( @aTabS120, "S120",/*dDataRef*/,.T.,/*cAnoMes*/,/*lCarNew*/,cFilant)
        nPos1	:= Ascan(aTabS120,{|x| x[2] == cFilant })
        If nPos1 > 0
            If (Alltrim(aTabS120[nPos1,2]) == Alltrim(cFilant) .Or. Empty(aTabS120[nPos1, 2]) ).And. Empty(aTabS120[nPos1,6])
                Aadd(aEstEd, {aTabS120[nPos1,7], aTabS120[nPos1,2]} )
            Endif
        EndIf
    EndIf
		
	Aadd(aEstObras, {;  
        oDataRJ4["RJ4_FILIAL"]                      , ;	//01 Filial
        oDataRJ4["RJ4_TPINSC"]                      , ;	//02 TIPO2 / Tipo Inscrição
        oDataRJ4["RJ4_NINSCR"]                      , ;	//03 CEI2  / Num Inscrição
        ""											, ;	//04 FPAS
        ""											, ;	//05 Cod. Terceiro
        cCnae										, ;	//06 CNAE
        oDataRJ4["RJ4_RAT"]							, ;	//07 RAT
        oDataRJ4["RJ4_FAP"]							, ;	//08 FAP
        oDataRJ4["RJ4_FAP"] *  oDataRJ4["RJ4_RAT"]  , ;	//09 % Acidente de Trabalho
        oDataRJ4["RJ4_NINSCR"]						, ;	//10 Número da Inscrição (Utilizado para buscar a entidade educativa, na fCarrCTT)
        cSubPat										, ;	//11 Subst. Contrib. Patronal
        oDataRJ4["RJ4_PON"]							, ;	//12 Tipo de Ponto
        oDataRJ4["RJ4_APR"]							, ;	//13 Contrata Aprendiz
        oDataRJ4["RJ4_PRC"]							, ;	//14 Número do Processo Aprendiz
        oDataRJ4["RJ4_EED"]							, ;	//15 Tipo de Entidade Educativa
        oDataRJ4["RJ4_INI"]							, ;	//16 Mes Ano
        nOperation									, ;	//17 nOpc
        oDataRJ4["RJ4_INI"]	 						, ;	//18 Data Inicial(MMAAAA)
        Iif(lCposRatFap, oDataRJ4["RJ4_TPRAT"], "")	, ;	//19 Tipo do Processo (1-Administrativo, 2-Judicial)
        Iif(lCposRatFap, oDataRJ4["RJ4_NPRAT"], "")	, ;	//20 Número do Processo
        Iif(lCposRatFap, oDataRJ4["RJ4_SURAT"], "")	, ; //21 Código do Indicativo da Suspensão
        Iif(lCposRatFap, oDataRJ4["RJ4_TPFAP"], "")	, ;	//22 Tipo do Processo (1-Administrativo, 2-Judicial, 4-Processo FAP)
        Iif(lCposRatFap, oDataRJ4["RJ4_NPFAP"], "")	, ;	//23 Número do Processo
        Iif(lCposRatFap, oDataRJ4["RJ4_SUFAP"], "")	, ; //24 Código do Indicativo da Suspensão
        cCNPJR			                            , ; //25 CNPJ Responsavel
    }) 


	lRetTaf := fCarrCTT(aEstObras, cMesAnoP, aEstEd, @aErros, cFilant, nOperation, 1 )

Return aErros


/*/{Protheus.doc} fCpoAlt
Verifica se os campos de envio do evento na na versão S-1.0 foram alterados 
@since	16/01/2025
@autor	caio.kretzer
@version 12
/*/
Static Function fCpoAlt(oDataRJ4)

    Local lAlterou  := .F.	
    Local lCNPJR		:= RJ4->(ColumnPos("RJ4_CNPJR")) > 0
    Local aArea		:= GetArea()
    Local bCond     := {|x|(  RJ4->RJ4_INI <> oDataRJ4["RJ4_INI"] ) .Or.;
    ( RJ4->RJ4_TPINSC <> oDataRJ4["RJ4_TPINSC"] ) .Or.;
    ( RJ4->RJ4_NINSCR <> oDataRJ4["RJ4_NINSCR"] ) .Or.;
    ( RJ4->RJ4_CNAE <> oDataRJ4["RJ4_CNAE"] )  .Or.;
    ( RJ4->RJ4_RAT <> oDataRJ4["RJ4_RAT"] ) .Or.;
    ( RJ4->RJ4_FAP <> oDataRJ4["RJ4_FAP"] ) .Or.;
    ( RJ4->RJ4_PRC <> oDataRJ4["RJ4_PRC"] ) .Or.;
    ( RJ4->RJ4_EED <> oDataRJ4["RJ4_EED"] ) .Or.;
    ( RJ4->RJ4_TPRAT <> oDataRJ4["RJ4_TPRAT"] ) .Or.;
    ( RJ4->RJ4_NPRAT <> oDataRJ4["RJ4_NPRAT"] ) .Or.;
    ( RJ4->RJ4_SURAT <> oDataRJ4["RJ4_SURAT"] ) .Or.;
    ( RJ4->RJ4_TPFAP <> oDataRJ4["RJ4_TPFAP"] ) .Or.;
    ( RJ4->RJ4_NPFAP <> oDataRJ4["RJ4_NPFAP"] ) .Or.;
    ( RJ4->RJ4_SUFAP <> oDataRJ4["RJ4_SUFAP"] ) .Or.;
    ( If(lCNPJR, RJ4->RJ4_CNPJR <> oDataRJ4["RJ4_CNPJR"],.F.) )}

	If Eval( bCond )
		lAlterou := .T.
	Endif

	RestArea(aArea)

Return lAlterou
