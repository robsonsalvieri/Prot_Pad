#include 'fw-tlpp-core.th'
#include "protheus.ch"
#include "totvs.framework.structure.model.th"

namespace totvs.rh.lotacoes.model

@totvsFrameworkStructureModel(lookup=.F., country="ALL", description="Lotacoes eSocial")

class GPEA934 from totvs.framework.structure.model.data
    public method new() as object
    public method setModel()
EndClass

/*/{Protheus.doc} new
Instancia do objeto da classe
@author lidio.oliveira
@since 06/11/2025
@version P12
@return object, objeto da classe
/*/
Method new() as object class GPEA934
    _Super:new(,,.T.)
Return self

/*/{Protheus.doc} setModel
Define o modelo de dados da tabela RJ3 - Lotacoes eSocial.

@author lidio.oliveira
@since 06/11/2025
@version P12
/*/
method setModel() class GPEA934
    Local oRJ3        As Object
    Local oEvents     As Object
    Local oLookupS057 As Object

    oRJ3 := totvs.framework.structure.object.ObjectFromMetadata():new( "RJ3",, {"RJ3_FILIAL", "RJ3_INI", "RJ3_COD"} )
    self:setObject(oRJ3:getObject(), "RJ3")

    // Lookup campo RJ3_TPLOT -> Tabela S057 (Tipos de Lotacao)
    oLookupS057 := totvs.framework.structure.model.lookup():new()
    oLookupS057:setLookup("totvs.rh.lotacoes.model.lookup.S057", "XTX_CODIGO",,, {"XTX_CODIGO"})
    self:AddLookup("RJ3_TPLOT", "RJ3", oLookupS057:getLookup())

    // Vincula os eventos de negocio
    oEvents := totvs.rh.lotacoes.events.GPEA934Events():new()
    self:setEvents(oEvents)

return
