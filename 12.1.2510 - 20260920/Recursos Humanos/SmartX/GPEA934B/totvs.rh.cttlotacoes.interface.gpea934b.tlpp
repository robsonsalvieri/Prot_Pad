/*{Protheus.doc} setInterface
Método para construir interface 
@author raquel.andrade
@since 14/11/2025
*/
method setInterface() class gpea934b

    Local aElements          As Array

    ::oInterface := totvs.framework.structure.interface.BuildContract():new( "gpea934b" )
    ::oInterface:setTitle(STR0001) // "Relac. Centro de Custo X Lotações "
    ::oInterface:setModelId( "totvs.rh.cttlotacoes.model.gpea934b", .t.)
    ::oInterface:setVersion( "1.0" )

    ::oDataNew := totvs.framework.structure.interface.BuildDataNew():new("gpea934bNew", "totvs.rh.cttlotacoes.model.gpea934b")
    ::oDataNew:setTitle(STR0002) // "Incluir"
    ::oDataNew:addProperty("RJ5","RJ5_FILIAL", "hidden", .T.)
 
    ::oDataEdit := totvs.framework.structure.interface.BuildDataEdit():new("gpea934bEdit","totvs.rh.cttlotacoes.model.gpea934b")
    ::oDataEdit:setTitle(STR0003) // "Alterar"
    ::oDataEdit:addProperty("RJ5","RJ5_FILIAL", "hidden", .T.)

    ::oDataEdit:addProperty("RJ5", "RJ5_INI", "readOnly", "true")
    ::oDataEdit:addProperty("RJ5", "RJ5_CC",  "readOnly", "true")
    ::oDataEdit:addProperty("RJ5", "RJ5_COD", "readOnly", "true")

    ::oDataDetail := totvs.framework.structure.interface.BuildDataDetail():new("gpea934bDetail", "totvs.rh.cttlotacoes.model.gpea934b")
    ::oDataDetail:setTitle(STR0004) // "Visualizar"
    ::oDataDetail:addProperty("RJ5","RJ5_FILIAL", "hidden", .T.)

    ::oDataView := totvs.framework.structure.interface.BuildDataView():new("gpea934bView", "totvs.rh.cttlotacoes.model.gpea934b")
    ::oDataView:setModelId( "totvs.rh.cttlotacoes.model.gpea934b" )
    ::oDataView:setTitle(STR0001) // "Relac. Centro de Custo X Lotações"
    ::oDataView:assignInvisibleFields()

    aElements := ::buildElements()
    ::oDataNew:setElement(aElements)
    ::oDataEdit:setElement(aElements)
    ::oDataDetail:setElement(aElements)
    
    ::oInterface:setDataNew(::oDataNew:getDataNew(), .f.)
    ::oInterface:setDataEdit(::oDataEdit:getDataEdit(), .f.)
    ::oInterface:setDataDetail(::oDataDetail:getDataDetail(), .f.)
    ::oInterface:setDataView(::oDataView:getDataView())


return

/*/{Protheus.doc} buildElements
Monta e retorna o array de elementos com as seções do formuláriio
@type  Method
@author caio.kretzer
@since 19/05/2026
@version v1.0
@return aElements, Array, Array de elementos com as seções mescladas para uso em setElement()
/*/
method buildElements() as array class gpea934b
    Local oElmGeral         As Object
    Local oElmFilial        As Object
    Local oSecGeral         As Object
    Local oSecFilial        As Object
    Local aElements         As Array

    // --- Seção: Dados Gerais ---
    oElmGeral := totvs.framework.structure.interface.BuildElementsFromCode():new()
    oElmGeral:addElements({"RJ5_FILIAL", "RJ5_INI", "RJ5_CC", "RJ5_COD", "RJ5_TPIO", "RJ5_NIO"}, .F.)
    oSecGeral := totvs.framework.structure.interface.BuildSectionsFromCode():new()
    oSecGeral:addSections("Dados Gerais", oElmGeral:getElements())

    // --- Seção: Filial ---
    oElmFilial := totvs.framework.structure.interface.BuildElementsFromCode():new()
    oElmFilial:addElements({"RJ5_FILT"}, .F.)
    oSecFilial := totvs.framework.structure.interface.BuildSectionsFromCode():new()
    oSecFilial:addSections("Filial", oElmFilial:getElements())

    // --- Mescla todas as seções ---
    aElements := totvs.framework.structure.interface.BuildElementsFromCode():mergeElements(;
        {}, ;
        {oSecGeral:getSections(), oSecFilial:getSections()} )

Return aElements
 
