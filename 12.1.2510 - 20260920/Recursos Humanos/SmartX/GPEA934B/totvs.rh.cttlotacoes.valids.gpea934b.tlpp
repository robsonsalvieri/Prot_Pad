#include 'fw-tlpp-core.th'
#include "protheus.ch"
#include "totvs.framework.model.events.th"
#include "totvs.rh.cttlotacoes.valids.gpea934b.ch"

namespace totvs.rh.cttlotacoes.valids

/*/{Protheus.doc} gp934bvldIniRJSX
    Valida se o campo RJ5_INI está no formato AAAAMM e representa um período válido
    Formato dos campos: AAAAMM
    @type  Function
    @author caio.kretzer
    @since 06/07/2026
    @version 1.0
    @param xValue, any, Valor do campo RJ5_INI
    @param cField, character, Nome do campo sendo validado
    @param aContextInfo, array, [0] = RJ5_INI da linha atual
    @return jRet, json, Retorno Json
    @example {"function":"totvs.rh.cttlotacoes.valids.gp934bvldIniRJSX","contextInfo":["{{$selectedRow.RJ5_INI}}"],"type":"serverValidate"}
/*/
Function gp934bvldIniRJSX(xValue as variant, cField as character, aContextInfo as array) as Json
    
    Local cDtIni := xValue
    Local lPerOk := .T.
    Local jRet   := JsonObject():new() as Json
    Local nAno	 := 0
    Local nMes	 := 0

	// Valida se o período está no formato AAAAMM
	If Valtype(cDtIni) == "C" .And. !Empty(cDtIni)
		nAno := Val(SubStr(cDtIni, 0, 4))
		nMes := Val(SubStr(cDtIni, 5, 2))
		If (nAno < 1900 .Or. nAno > 3000 ) .Or. (nMes < 1 .Or. nMes > 12 )
			lPerOk:= .F.
		EndIf
	Else
		lPerOk := .F.
	EndIf

    jRet['return'] := lPerOk

    If !lPerOk
        jRet['notValidMessage'] := STR0001 // STR0001 - "O campo RJ5_INI deve estar no formato AAAAMM e representar um período válido."
    Else
        jRet['notValidMessage'] := ""
    EndIf

Return jRet
