#include 'fw-tlpp-core.th'
#include "protheus.ch"
#include "totvs.framework.structure.model.th"

namespace totvs.rh.menoraprendiz.model

@totvsFrameworkStructureModel(lookup=.F., country="BRA", description="Informacoes Complementares Menor Aprendiz")

class GPEA945 from totvs.framework.structure.model.data
    public method new() as object
    public method setModel()
EndClass

/*/{Protheus.doc} new
Instancia do objeto da classe
@type method
@author caio.kretzer
@since 12/08/2026
@version P12
@return object, objeto da classe
/*/
Method new() as object class GPEA945
    _Super:new(,,.T.)
Return self

/*/{Protheus.doc} setModel
Definicao do modelo de dados - Informacoes Complementares Menor Aprendiz
Cabecalho: SRA (Funcionarios) - somente leitura
Detalhe: RU2 (Inf. Complementares Menor Aprendiz) - campos editaveis
@type method
@author caio.kretzer
@since 12/08/2026
@version P12
/*/
method setModel() class GPEA945
    Local oSRA      As Object
    Local oRU2      As Object

    // CABECALHO - Funcionarios (SRA) - somente visualizacao
    oSRA := totvs.framework.structure.object.ObjectFromMetadata():new("SRA", ;
                                                                        {"RA_FILIAL", "RA_MAT", "RA_NOME", "RA_ADMISSA", "RA_CATEFD"}, ;
                                                                        {"RA_FILIAL", "RA_MAT"},;
                                                                        "RA_CATEFD eq '103'")
    self:setObject(oSRA:getObject(), "SRA", .T., .F., {"RA_FILIAL", "RA_MAT", "RA_NOME", "RA_ADMISSA", "RA_CATEFD"})

    // Campos SRA: filial oculta, demais somente leitura
    self:setProperty("RA_FILIAL",  "hidden",   .T., "SRA")
    self:setProperty("RA_MAT",     "readOnly", .T., "SRA")
    self:setProperty("RA_NOME",    "readOnly", .T., "SRA")
    self:setProperty("RA_ADMISSA", "readOnly", .T., "SRA")
    self:setProperty("RA_CATEFD",  "readOnly", .T., "SRA")

    // DETALHE - Informacoes Complementares Menor Aprendiz (RU2)
    oRU2 := totvs.framework.structure.object.ObjectFromMetadata():new("RU2", , {"RU2_FILIAL", "RU2_MAT"})
    self:addObject(oRU2:getObject(), "RU2", {"RU2_FILIAL", "RU2_MAT"}, {"RA_FILIAL", "RA_MAT"}, "SRA")

    // Esconde chaves estrangeiras no detalhe
    self:setProperty("RU2_FILIAL", "hidden", .T., "RU2")
    self:setProperty("RU2_MAT",    "hidden", .T., "RU2")

    self:LoadEventsFromMetadata()

    // Vincula eventos
    self:setEvents(totvs.rh.menoraprendiz.events.GPEA945Events():new())

    FwFreeObj(oSRA)
    FwFreeObj(oRU2)

return
