#include 'fw-tlpp-core.th'
#include "protheus.ch"
#include "totvs.framework.structure.interface.th"
#include "totvs.rh.sucessaovinculos.interface.gpea926.ch"

namespace totvs.rh.sucessaovinculos.interface

@totvsFrameworkStructureInterface(lookup=.F., country="ALL", description="Sucessao de Vinculos")

class GPEA926
    private data oInterface  as object
    private data oDataNew    as object
    private data oDataEdit   as object
    private data oDataDetail as object
    private data oDataView   as object

    public method new() as object
    public method setInterface()
    public method getContract() as json
EndClass

Method new() as object class GPEA926
Return self

method setInterface() class GPEA926
    Local oElementsCabec As Object
    Local oElementsRFZ   As Object
    Local aElements      As Array

    ::oInterface := totvs.framework.structure.interface.BuildContract():new("gpea926")
    ::oInterface:setTitle(STR0001) // "Sucessão de Vínculos"
    ::oInterface:setModelId("totvs.rh.sucessaovinculos.model.gpea926", .T.)
    ::oInterface:setVersion("1.0")

    // CABECALHO - Matricula, Nome e Data de Admissao (layout fixo, sem abas automaticas)
    oElementsCabec := totvs.framework.structure.interface.BuildElementsFromCode():new()
    oElementsCabec:addElements({"RA_MAT", "RA_NOME", "RA_ADMISSA"}, .F.)

    // GRID - Sucessao de Vinculos (RFZ). Eventos ficam no model.
    oElementsRFZ := totvs.framework.structure.interface.BuildElementsFromCode():new()
    oElementsRFZ:addElements({"RFZ"}, .F.)

    aElements := totvs.framework.structure.interface.BuildElementsFromCode():mergeElements(;
        oElementsCabec:getElements(),;
        oElementsRFZ:getElements();
    )

    ::oDataNew := totvs.framework.structure.interface.BuildDataNew():new("gpea926New", "totvs.rh.sucessaovinculos.model.gpea926")
    ::oDataNew:setTitle(STR0002) // "Incluir Sucessão de Vínculos"
    ::oDataNew:setElement(aElements)

    ::oDataEdit := totvs.framework.structure.interface.BuildDataEdit():new("gpea926Edit", "totvs.rh.sucessaovinculos.model.gpea926")
    ::oDataEdit:setTitle(STR0003) // "Alterar Sucessão de Vínculos"
    ::oDataEdit:setElement(aElements)

    ::oDataDetail := totvs.framework.structure.interface.BuildDataDetail():new("gpea926Detail", "totvs.rh.sucessaovinculos.model.gpea926")
    ::oDataDetail:setTitle(STR0004) // "Visualizar Sucessão de Vínculos"
    ::oDataDetail:setElement(aElements)

    ::oDataView := totvs.framework.structure.interface.BuildDataView():new("gpea926View", "totvs.rh.sucessaovinculos.model.gpea926")
    ::oDataView:setModelId("totvs.rh.sucessaovinculos.model.gpea926")
    ::oDataView:setTitle(STR0001) // "Sucessão de Vínculos"
    ::oDataView:assignInvisibleFields()
    ::oDataView:hideStandardPageAction("newAction")

    ::oInterface:setDataNew(::oDataNew:getDataNew(), .f.)
    ::oInterface:setDataEdit(::oDataEdit:getDataEdit(), .f.)
    ::oInterface:setDataDetail(::oDataDetail:getDataDetail(), .f.)
    ::oInterface:setDataView(::oDataView:getDataView())
return

method getContract() as json class GPEA926
return ::oInterface:getContract()
