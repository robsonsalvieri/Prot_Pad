#include 'fw-tlpp-core.th'
#include "protheus.ch"
#include "totvs.framework.structure.model.th"

namespace totvs.rh.sucessaovinculos.model

@totvsFrameworkStructureModel(lookup=.F., country="ALL", description="Sucessao de Vinculos")

class GPEA926 from totvs.framework.structure.model.data
    public method new() as object
    public method setModel()
EndClass

Method new() as object class GPEA926
    _Super:new(,,.T.)
Return self

method setModel() class GPEA926
    Local oSRA       As Object
    Local oRFZ       As Object
    Local oLookupCNPJ   As Object
    Local oLookupTpAdm  As Object
    Local oLookupS049   As Object
    Local aCamposSRA As Array

    aCamposSRA := {"RA_FILIAL", "RA_MAT", "RA_NOME", "RA_ADMISSA"}
    oSRA := totvs.framework.structure.object.ObjectFromMetadata():new("SRA", aCamposSRA, {"RA_FILIAL", "RA_MAT"})
    self:setObject(oSRA:getObject(), "SRA", .T., .F., {"RA_FILIAL", "RA_MAT", "RA_NOME", "RA_ADMISSA"})

    oRFZ := totvs.framework.structure.object.ObjectFromMetadata():new("RFZ", , {"RFZ_FILIAL", "RFZ_MAT", "RFZ_TPADM"})
    self:addArray(oRFZ:getObject(), "RFZ", {"RFZ_FILIAL", "RFZ_MAT"}, {"RA_FILIAL", "RA_MAT"}, "SRA")

    self:setProperty("RA_FILIAL",  "hidden",   .T., "SRA")
    self:setProperty("RA_MAT",     "readOnly", .T., "SRA")
    self:setProperty("RA_NOME",    "readOnly", .T., "SRA")
    self:setProperty("RA_ADMISSA", "readOnly", .T., "SRA")
    self:setProperty("RFZ_FILIAL", "hidden", .T., "RFZ")
    self:setProperty("RFZ_MAT",    "hidden", .T., "RFZ")

    oLookupCNPJ := totvs.framework.structure.model.lookup():new()
    oLookupCNPJ:setLookup("totvs.rh.sucessaovinculos.model.lookup.EMCNPJ", "XTX_CNPJ",,, {"XTX_CNPJ", "XTX_DESC"})
    self:AddLookup("RFZ_CNPJAN", "RFZ", oLookupCNPJ:getLookup())

    oLookupTpAdm := totvs.framework.structure.model.lookup():new()
    oLookupTpAdm:setLookup("totvs.rh.sucessaovinculos.model.lookup.TpAdm", "XTX_CODIGO",,, {"XTX_CODIGO", "XTX_DESC"})
    self:AddLookup("RFZ_TPADM", "RFZ", oLookupTpAdm:getLookup())

    oLookupS049 := totvs.framework.structure.model.lookup():new()
    oLookupS049:setLookup("totvs.rh.sucessaovinculos.model.lookup.S049", "XTX_CODIGO",,, {"XTX_CODIGO", "XTX_DESC"})
    self:AddLookup("RFZ_CATODS", "RFZ", oLookupS049:getLookup())
    self:AddLookup("RFZ_CATEG", "RFZ", oLookupS049:getLookup())

    self:setEvents(totvs.rh.sucessaovinculos.events.GPEA926():new())

    FwFreeObj(oSRA)
    FwFreeObj(oRFZ)
return
