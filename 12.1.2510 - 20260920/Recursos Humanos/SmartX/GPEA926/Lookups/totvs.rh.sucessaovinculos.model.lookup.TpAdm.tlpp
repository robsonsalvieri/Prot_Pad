#include 'fw-tlpp-core.th'
#include "protheus.ch"
#include "totvs.framework.structure.model.th"
#include "totvs.rh.sucessaovinculos.model.lookup.TpAdm.ch"

namespace totvs.rh.sucessaovinculos.model.lookup

@totvsFrameworkStructureModel(lookup=.T., country="ALL", description="Tipo de Admissao")

class TpAdm from totvs.framework.structure.model.data
    public method new() as object
    public method setModel()
EndClass

Method new() as object class TpAdm
    _Super:new(,,.T.)
Return self

method setModel() class TpAdm
    Local oHeader As Object
    Local oArray  As Object
    Local oField  As Object
    Local oIndex  As Object
    Local oFinder As Object

    oHeader := totvs.framework.structure.object.BuildFromCode():new("XTX")

    oField := totvs.framework.structure.object.BuildFieldProperties():new("XTX_CODIGO")
    oField:setType("C")
    oField:setTitle(STR0002) // "Código"
    oField:setDescription(STR0003) // "Código do tipo de admissão"
    oField:setSize(1)
    oField:setOrder(1)
    oField:setRequired(.T.)
    oField:setUpperCase(.T.)
    oHeader:addFieldProperties(oField:getFieldProperties())

    oField := totvs.framework.structure.object.BuildFieldProperties():new("XTX_DESC")
    oField:setType("C")
    oField:setTitle(STR0004) // "Descrição"
    oField:setDescription(STR0005) // "Descrição do tipo de admissão."
    oField:setSize(100)
    oField:setOrder(2)
    oField:setRequired(.T.)
    oHeader:addFieldProperties(oField:getFieldProperties())

    oHeader:setTitle(STR0001) // "Tipo de Admissão"

    oIndex := totvs.framework.structure.object.BuildIndex():new("XTX" + cEmpAnt + "0")
    oIndex:setOrder("1")
    oIndex:setKeyFields({"XTX_CODIGO"})
    oHeader:addIndexConstraint(oIndex:getIndex())

    oFinder := totvs.framework.structure.model.finder():new()
    oFinder:setFinder({"XTX_CODIGO"}, "", .T.)
    oHeader:addFinder(oFinder:getFinder())

    oHeader:setUniqueKeyConstraint("XTX" + cEmpAnt + "0", {"XTX_CODIGO"})

    oArray := TpAdmDataArray():new()
    self:setObject(oHeader:getObject(), "XTX",,,,,, oArray)
    self:setOrder({{"XTX_CODIGO", .F.}})
    self:LoadEventsFromMetadata()
return

class TpAdmDataArray
    public method new() as object
    public method getData() as array
EndClass

Method new() as object class TpAdmDataArray
Return self

method getData() as array class TpAdmDataArray
    Local aData As Array

    aData := {}
    AAdd(aData, {"1", STR0006}) // "1 = Admissão"
    AAdd(aData, {"2", STR0007}) // "2 = Transferência de empresa do mesmo grupo econômico"
    AAdd(aData, {"3", STR0008}) // "3 = Admissão por sucessão, incorporação, cisão ou fusão"
    AAdd(aData, {"4", STR0009}) // "4 = Trabalhador cedido"
    AAdd(aData, {"7", STR0010}) // "7 = Transferência quando a empresa sucedida é considerada inapta por inexistência de fato"
return aData
