#include 'fw-tlpp-core.th'
#include "protheus.ch"
#include "totvs.framework.structure.model.th"
#include "totvs.rh.sucessaovinculos.model.lookup.S049.ch"

namespace totvs.rh.sucessaovinculos.model.lookup

@totvsFrameworkStructureModel(lookup=.T., country="ALL", description="Tabela S049 - Categorias eSocial")

class S049 from totvs.framework.structure.model.data
    public method new() as object
    public method setModel()
EndClass

Method new() as object class S049
    _Super:new(,,.T.)
Return self

method setModel() class S049
    Local oHeader As Object
    Local oArray  As Object
    Local oField  As Object
    Local oIndex  As Object
    Local oFinder As Object

    oHeader := totvs.framework.structure.object.BuildFromCode():new("XTX")

    oField := totvs.framework.structure.object.BuildFieldProperties():new("XTX_CODIGO")
    oField:setType("C")
    oField:setTitle(STR0001) // "Cód. Categ. eSocial"
    oField:setDescription(STR0002) // "Cód. Categ. eSocial"
    oField:setSize(3)
    oField:setOrder(1)
    oField:setRequired(.T.)
    oField:setUpperCase(.T.)
    oHeader:addFieldProperties(oField:getFieldProperties())

    oField := totvs.framework.structure.object.BuildFieldProperties():new("XTX_DESC")
    oField:setType("C")
    oField:setTitle(STR0003) // "Desc. Categ. eSocial"
    oField:setDescription(STR0004) // "Desc. Categ. eSocial"
    oField:setSize(150)
    oField:setOrder(2)
    oField:setRequired(.T.)
    oHeader:addFieldProperties(oField:getFieldProperties())

    oHeader:setTitle(STR0005) // "S049 - Categorias eSocial"

    oIndex := totvs.framework.structure.object.BuildIndex():new("XTX" + cEmpAnt + "0")
    oIndex:setOrder("1")
    oIndex:setKeyFields({"XTX_CODIGO"})
    oHeader:addIndexConstraint(oIndex:getIndex())

    oFinder := totvs.framework.structure.model.finder():new()
    oFinder:setFinder({"XTX_CODIGO"}, "", .T.)
    oHeader:addFinder(oFinder:getFinder())

    oHeader:setUniqueKeyConstraint("XTX" + cEmpAnt + "0", {"XTX_CODIGO"})

    oArray := S049DataArray():new()
    self:setObject(oHeader:getObject(), "XTX",,,,,, oArray)
    self:setOrder({{"XTX_CODIGO", .F.}})
    self:LoadEventsFromMetadata()
return

class S049DataArray
    public method new() as object
    public method getData() as array
EndClass

Method new() as object class S049DataArray
Return self

method getData() as array class S049DataArray
    Local aData     As Array
    Local aCampos   As Array
    Local cAliasTmp As Character
    Local cConteudo As Character
    Local cCodigo   As Character
    Local cDesc     As Character
    Local cQuery    As Character
    Local oStmt     As Object
    Local nParam    As Numeric

    aData := {}
    cQuery := "SELECT RCC_CONTEU "
    cQuery += "FROM " + RetSqlName("RCC") + " RCC "
    cQuery += "WHERE RCC.RCC_FILIAL = ? "
    cQuery += "  AND RCC.RCC_CODIGO = ? "
    cQuery += "  AND RCC.D_E_L_E_T_ = ? "
    cQuery += "ORDER BY RCC_CONTEU "
    cQuery := ChangeQuery(cQuery)

    oStmt := FwExecStatement():New(cQuery)
    nParam := 1
    oStmt:SetString(nParam++, xFilial("RCC"))
    oStmt:SetString(nParam++, "S049")
    oStmt:SetString(nParam++, " ")

    cAliasTmp := oStmt:OpenAlias()

    While (cAliasTmp)->(!Eof())
        cConteudo := AllTrim((cAliasTmp)->RCC_CONTEU)
        aCampos := gp926ExtraiCamposRCC(cConteudo, "S049")
        cCodigo := gp926CampoRCC(aCampos, "CODIGO")
        cDesc   := gp926CampoRCC(aCampos, "DESCRICAO")

        If !Empty(cCodigo) .And. cCodigo <> "401"
            AAdd(aData, {cCodigo, cDesc})
        EndIf

        (cAliasTmp)->(dbSkip())
    EndDo

    (cAliasTmp)->(dbCloseArea())
return aData

Static Function gp926ExtraiCamposRCC(cConteudo as character, cTabela as character) as array
    Local aCampos    As Array
    Local aEstrutura As Array
    Local nI         As Numeric
    Local nPosIni    As Numeric
    Local cNomeCampo As Character
    Local cValor     As Character

    aCampos    := {}
    aEstrutura := gp926EstruturaRCC(cTabela)
    nPosIni    := 1

    For nI := 1 To Len(aEstrutura)
        cNomeCampo := aEstrutura[nI][1]
        cValor     := AllTrim(SubStr(cConteudo, nPosIni, aEstrutura[nI][2]))
        AAdd(aCampos, {cNomeCampo, cValor})
        nPosIni += aEstrutura[nI][2]
    Next nI
return aCampos

Static Function gp926EstruturaRCC(cTabela as character) as array
    Local aEstrutura As Array
    Local aArea      As Array
    Local cFilRCB    As Character

    aEstrutura := {}
    aArea      := GetArea()
    cFilRCB    := xFilial("RCB")

    dbSelectArea("RCB")
    RCB->(dbSetOrder(1))

    If RCB->(dbSeek(cFilRCB + cTabela))
        While RCB->(!Eof()) .And. RCB->RCB_FILIAL == cFilRCB .And. RCB->RCB_CODIGO == cTabela
            AAdd(aEstrutura, {AllTrim(RCB->RCB_CAMPOS), RCB->RCB_TAMAN})
            RCB->(dbSkip())
        EndDo
    EndIf

    RestArea(aArea)
return aEstrutura

Static Function gp926CampoRCC(aCampos as array, cCampo as character) as character
    Local cRet As Character
    Local nPos As Numeric

    cRet := ""
    nPos := AScan(aCampos, {|aItem| aItem[1] == cCampo})

    If nPos > 0
        cRet := aCampos[nPos][2]
    EndIf
return cRet
