#include "protheus.ch"
#include "tlpp-core.th"
#include "RHATSSendApplicantApprovedToErp.ch"

/*/{Protheus.doc} RHATSSendApplicantApprovedToErpMessageReader
Classe para gravação dos dados do Candidato  relacionados ao ATS para pré-cadastro de Funcionário
@author raquel.andrade
@since 03/12/2025
/*/
Class RHATSSendApplicantApprovedToErpMessageReader from LongNameClass

	public  data getError        as Character      // Mensagem de erro

	public  method New()
	public  method Read(oLinkMessage as object) 		as logical
	public  method getError()    				 		as character 

Endclass

/*/{Protheus.doc} ::new
Construtor da classe
@type method
@author raquel.andrade
@since 03/12/2025
@return object, Instância da classe
/*/
method New() Class RHATSSendApplicantApprovedToErpMessageReader
	
return self

/*/{Protheus.doc} ::GetError
Retorna erro
@type method
@author raquel.andrade
@since 03/12/2025
@return object, Instância da classe
/*/
method GetError() Class RHATSSendApplicantApprovedToErpMessageReader
return Self:getError


/*/{Protheus.doc} ::read
Responsável pela leitura e processamento da mensagem recebida do ATS
Processa a mensagem e inicia um job para gravação na tabela RUH - Integração ATS
@type method
@author raquel.andrade
@since 03/12/2025
@param oLinkMessage, object, Instância de FwTotvsLinkMesage contendo a mensagem a ser processada
@return logical, .T. se a mensagem foi processada com sucesso e pode ser removida da fila, .F. em caso de falha
/*/
method Read( oLinkMessage as object ) as logical Class RHATSSendApplicantApprovedToErpMessageReader
Local cEmpATS 		as character
Local cFilATS  		as character
Local cErrorMsg		as character
Local cMsg			as character
Local cLink			as character
Local lOkATS 		as logical
Local lExtCNPJ		as logical
Local jPayload      as json

	Conout(Replicate("=",75)) 
	Conout(OemToAnsi(STR0001)) //"Iniciando captura de dados de Candidatos do Totvs RH Atracao de Talentos"
	Conout(Replicate("=",75)) 

	jPayload := JsonObject():new()
	jPayload:FromJSON(oLinkMessage:RawMessage())
	jPayload := jPayload['data']

	// Obtém CNPJ - seja pelo jSon (cadastrado na Unidade pela Central do Recrutador)
	// ou pelo arquivo config.json
	lExtCNPJ    := fGetCNPJ(jPayload, @cEmpATS, @cFilATS,@cErrorMsg)

	// Manual Integração com Totvs RH Atração de Talentos
	cLink		:= "https://tdn.totvs.com/pages/releaseview.action?pageId=1012515566"

	If ValType(jPayload) == "J" .And. lExtCNPJ
		lOkATS := StartJob("fGPELoadATS", GetEnvServer(), .T., cEmpATS, cFilATS, jPayload	)
		If !lOkATS
			cErrorMsg	:= OemToAnsi(STR0003) +  OemToAnsi(STR0004) + cLink
			// "Para importar os dados e necessario possuir a tabela RUH no dicionario de dados."
			// "Verifique documentacao detalhada: https://tdn.totvs.com/pages/releaseview.action?pageId=1012515566"
		EndIf
	EndIf

	If !lOkATS		
		// "A mensagem recebida nao possui conteudo valido!"
		cMsg := If (!Empty(cErrorMsg), cErrorMsg , OemToAnsi(STR0005)) + OemToAnsi(STR0004) + cLink
		// Imprime mensagem no console
		Conout(cMsg) 
		// Retorna mensagem para Smartlink
		Self:getError := cMsg
	EndIf

	Conout(Replicate("=",75)) 
	Conout(OemToAnsi(STR0002)) //"Termino da captura de dados de Candidatos do Totvs RH Atracao de Talentos"
	Conout(Replicate("=",75))

	FwFreeObj(jPayload)

return lOkATS

/*/{Protheus.doc} fGPELoadATS
Realiza gravação dos dados do Candidato na tabela RUH - Integração ATS
@type function
@author raquel.andrade
@since 03/12/2025
/*/
Function fGPELoadATS(cEmpATS, cFilATS , jPayload ) 
Local lRet			:= .F.

Default	cEmpATS		:= cEmpAnt
Default cFilATS		:= cFilAnt
Default jPayload	:= JsonObject():new()

	RPCSetType(3)
	RPCSetEnv(cEmpATS, cFilATS,,,'GPE') 

	lRet	:= fGrvRUH(jPayload, cFilATS)

	RpcClearEnv()

return lRet

/*/{Protheus.doc} fGetCNPJ
Realiza gravação dos dados do Candidato na tabela RUH - Integração ATS
@type function
@author raquel.andrade
@since 03/12/2025
/*/
Function fGetCNPJ(jPayload, cEmpATS, cFilATS, cErrorMsg )
Local aAreaSM0  := SM0->( getArea() )
Local cCNPJ		:= ""
Local oJson 
Local lCNPJ		:= .F.
Local lEmp      := .F.
Local nI		:= 0

Default jPayload	:= JsonObject():new()
Default	cEmpATS		:= cEmpAnt
Default cFilATS		:= cFilAnt
Default cErrorMsg	:= ""

	oJson	:= JsonObject():new()
	oJson	:= jPayload['content']['JobOpportunity']

	// Captura CNPJ do jSon
	If oJson:hasProperty("Facilities") .And. ValType(oJson['Facilities']) == "A" .And. !Empty(oJson['Facilities'])
		For nI:= 1 to Len(oJson['Facilities'])
			If 	!lCNPJ .And. ValType(oJson['Facilities'][nI]['Cnpj']) == "C" .And. !Empty((oJson['Facilities'][nI]['Cnpj']))
				cCNPJ	:= oJson['Facilities'][nI]['Cnpj']
                cCNPJ	:= StrTran( cCNPJ, "-", "" ) 
                cCNPJ	:= StrTran( cCNPJ, "/", "" ) 
				cCNPJ	:= StrTran( cCNPJ, ".", "" ) 
				lCNPJ	:= .T.
			EndIf
		Next nI
	EndIf

	// Busca CNPJ no arquivo config.json no diretorio system/ats
	If Empty(cCNPJ)
		lEmp	:= fConfigATS(@cEmpATS,@cFilATS,@cErrorMsg)
	Else 
		//Busca Grupo de Empresa/Filial correspondente ao CNPJ
		SM0->(dbGoTop())
		While !SM0->(Eof()) .And. !lEmp
			If !Empty(cCNPJ)
				If AllTrim(SM0->M0_CGC) == AllTrim(cCNPJ)
					lEmp		:= .T.
					cEmpATS    	:= SM0->M0_CODIGO
                    cFilATS     := SM0->M0_CODFIL
				EndIf
			EndIf
			SM0->(DbSkip())
		EndDo
	EndIf

    RestArea( aAreaSM0 )

Return lEmp

/*/{Protheus.doc} function fGrvRUH
Grava dados na tabela RUH
@author raquel.andrade
@since 03/12/2025
/*/
Static Function fGrvRUH(jPayload , cFilATS)
Local cIntegrationId  	:= ""
Local cNome   			:= ""
Local cNomeUTF8			:= ""
Local cDtNasc  			:= ""
Local cEmail   			:= ""
Local cTitVag   		:= ""
Local cTpContr			:= ""
Local cMsg				:= ""
Local cMsgUTF8			:= ""
Local lTabRUH   		:= .F.
Local lRet				:= .F.

Default jPayload		:= JsonObject():new()
Default cFilATS			:= cFilAnt

	lTabRUH			:= ChkFile("RUH")

	If !lTabRUH
		lRet	:= .F.
	Else
		cIntegrationId 	:= jPayload['content']["IntegrationId"]
		
		// Nome do Candidato (campo obrigatório)
		cNomeUTF8 	:= jPayload['content']["FullName"]		
		cNome		:= DecodeUTF8(cNomeUTF8)
		cNome		:= SubStr(cNome,1, FWSX3Util():GetFieldStruct( "RUH_NOMCAD" )[3])

		// Data de Nascimento do Candidato (campo obrigatório)
		cDtNasc := jPayload['content']["Applicant"]["Birthday"]
		dDtNasc	:= sToD( StrTran( cDtNasc, "-", "" ) )

		// Email do Candidato (campo obrigatório)
		cEmail 	:= jPayload['content']["Applicant"]["Email"]
		cEmail	:= SubStr(cEmail,1, FWSX3Util():GetFieldStruct( "RUH_EMAIL" )[3])	
		
		// Título da Vaga
		If !Empty(jPayload['content']["JobOpportunity"]["Title"])
			cTitVag		:= SubStr(jPayload['content']["JobOpportunity"]["Title"],1, FWSX3Util():GetFieldStruct( "RUH_TITVAG" )[3])
		EndIf	

		// Tipo de Contratação da vaga
		If ValType(jPayload['content']["JobOpportunity"]["IsCLT"]) == "L"	
			If jPayload['content']["JobOpportunity"]["IsCLT"]
				cTpContr	:=	"1" // Regime de contratação CLT
			EndIf
		EndIf	

		If ValType(jPayload['content']["JobOpportunity"]["IsPJ"]) == "L"	
			If jPayload['content']["JobOpportunity"]["IsPJ"]
				cTpContr	:=	"2" // Regime de contratação Pessoa jurídica
			EndIf
		EndIf

		If ValType(jPayload['content']["JobOpportunity"]["IsInternship"]) == "L"	
			If jPayload['content']["JobOpportunity"]["IsInternship"]
				cTpContr	:=	"3" // Regime de contratação Estágio
			EndIf
		EndIf

		If ValType(jPayload['content']["JobOpportunity"]["IsFreelancer"]) == "L"	
			If jPayload['content']["JobOpportunity"]["IsFreelancer"]
				cTpContr	:=	"4" // Regime de contratação Freelancer
			EndIf
		EndIf

		If ValType(jPayload['content']["JobOpportunity"]["IsCooperated"]) == "L"	
			If jPayload['content']["JobOpportunity"]["IsCooperated"]
				cTpContr	:=	"5"	// Regime de contratação Cooperado
			EndIf
		EndIf

		cMsgUTF8	:= jPayload:toJSON()
		cMsg		:= DecodeUTF8(cMsgUTF8)

		Begin Transaction
			DbSelectArea("RUH")
			RUH->(DbSetOrder(1)) // RUH_FILIAL+RUH_IDINTE
			If !RUH->( DbSeek(FwxFilial("RUH")	+  cIntegrationId ) )
				RecLock("RUH", .T.)
				RUH->RUH_FILIAL	:= FwxFilial("RUH",cFilATS)	
				RUH->RUH_IDINTE	:= cIntegrationId 
				RUH->RUH_NOMCAD	:= cNome	
				RUH->RUH_NASC	:= dDtNasc	
				RUH->RUH_EMAIL	:= cEmail		
				RUH->RUH_TITVAG	:= cTitVag	
				RUH->RUH_MEMO 	:= cMsg
				RUH->RUH_DTINTE	:= Date() 
				RUH->RUH_HRINTE	:= Time()
				RUH->RUH_TPCONT	:= cTpContr
				RUH->RUH_STATUS	:= "1"

				//"Candidato:###Vaga:"
				Conout(OemToAnsi(STR0006)) // "Registros Importados:"
				Conout(OemToAnsi(STR0007) + cNome + " - " + OemToAnsi(STR0008) + cTitVag) // "Candidato: "###"Vaga: "
			EndIf		
			lRet	:= .T.
			RUH->(MsUnlock())
		End Transaction
	
	EndIf

Return lRet

/*/{Protheus.doc} function fConfigATS
Captura configuração do arquivo config.json
@author raquel.andrade
@since 03/12/2025
/*/
Function fConfigATS(cEmpATS, cFilATS, cErrorMsg)
Local cTxtRet       := ""
Local cStartPath    := ""
Local cNomeDir      := ""
Local cNomeArq      := ""
Local cJsonErro		:= ""
Local nHandle		:= 0
Local lRet          := .F.
Local lExiste		:= .F.
Local aEmp  		:= FwLoadSM0()

Default cEmpATS    	:= ""
Default cFilATS     := ""
Default cErrorMsg   := ""

    cStartPath	:= Upper( GetPvProfString( GetEnvServer() , "StartPath" , "" , GetAdv97() ) )
    cNomeDir 	:= cStartPath+"\ats"
    cNomeArq 	:= cNomeDir+"\config.json"	
    
    nHandle := fOpen(cNomeArq, 2)
    If !(Ferror() # 0 .Or. nHandle < 0)
        FSEEK(nHandle, 0, 0)        
        cTxtRet := MemoRead(cNomeArq)
        oJson	:= JsonObject():New()
		cJsonErro := oJson:FromJson(cTxtRet)
        If !(Empty(cJsonErro) .And. !Empty(ojSon["companyId"]) .And.  !Empty(ojSon["branchId"]))
            cErrorMsg	:= OemToAnsi(STR0009) // "Estrutura do arquivo config.json invalida." 
            lRet		:= .F.
        Else
            cEmpATS    	:= ojSon["companyId"]
            cFilATS     := ojSon["branchId"]
			lExiste 	:= aScan( aEmp , { | x | AllTrim( x[ 1 ] ) == cEmpATS .And. AllTrim( x[ 2 ] ) == AllTrim( cFilATS ) } ) > 0
			If !lExiste
				cErrorMsg	:= OemToAnsi(STR0010) // "Dados de Grupo de Empresa/Filial nao existem. Verificar configuracao o arquivo config.json."
				lRet		:= .F.
			Else
            	lRet		:= .T.
			EndIf
        EndIf
    Else
        cErrorMsg	:= OemToAnsi(STR0011) // "Nao foi possivel realizar a leitura do arquivo config.json. Verifique sua existencia e configuracao."  
        lRet		:= .F.   
    EndIf
    fClose(nHandle)

Return lRet
