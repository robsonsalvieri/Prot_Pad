#include "PROTHEUS.CH"
#include "totvs.ch"
#include "gpem950.ch"

//------------------------------------------------------------------
/*/{Protheus.doc} GPEM950
Validações para as tools de GET e POST de solicitação de férias

@param jPayLoad, json, Parâmetros de entrada das tools
@param lPost, logical, Parámetro que indica se a tool é do tipo POST ou GET
@return cRestFault, character, Resposta da validação, caso haja algum erro, retorna a mensagem de erro, caso contrário retorna vazio
@author Bruno Costa
@since  13/08/2026
@version 1.0
/*/
//-------------------------------------------------------------------
Function GPEM950(jPayLoad as json, lPost as logical) as character
local oVacationRequest as object
local oRequest as object
local aGetStruct := {} as array
local aEmployee := {} as array
local aVision := {} as array
local akeyGestor as array
local akeyFunc as array
local cMRrhKeyTree as character
local cBranchSolic as character
local cRestFault as character
local cBranchVld as character
local cMsgReturn as character
local cEmpGestor as character
local cApprover as character
local cDeptoApr as character
local cAliasRH4 as character
local cEmpSolic as character
local cMatSolic as character
local cVision  as character
local cMatSRA as character
local cRD0Cod as character
local cEmpApr as character
local cFilApr as character
local cIniVac as character
local cEndVac as character
local cIniPer as character
local cEndPer as character
local dDtFim as date
local nSupLevel := 99 as numeric
local nDiasAbn as numeric
local nDias as numeric
local lSUPAprove as logical
local lSolic13 as logical
local lGestor as logical
local lRet as logical

akeyGestor := StrTokArr(jPayLoad["idManager"], "|")
akeyFunc   := StrTokArr(jPayLoad["idEmployee"], "|")

cEmpGestor := akeyGestor[1]
cBranchVld := akeyGestor[2]
cMatSRA    := akeyGestor[3]

If (lRet := getPermission(cBranchVld, cMatSRA, akeyFunc[2], akeyFunc[3],, akeyFunc[1], "W_PWSA100A.APW"))
    cMatSolic    := cMatSRA
    cBranchSolic := cBranchVld
    cEmpSolic	 := akeyFunc[1]
    cBranchVld	 := akeyFunc[2]
    cMatSRA		 := akeyFunc[3]
EndIf 

If(!lRet, cRestFault := STR0001 + cBranchVld +"/" +cMatSRA, Nil) //"Usuário sem permissão para execução da requisição: "

If lRet
    lGestor    := .T.
    lRet       := .F.
    nDias      := jPayLoad["days"]
    nDiasAbn   := jPayLoad["vacationBonus"]
    cIniVac    := Format8601(.T., jPayLoad["initVacation"])
    dDtFim     := cToD(cIniVac) + nDias - 1
    cEndVac    := StrZero(Day(dDtFim), 2) + "/" + StrZero(Month(dDtFim), 2) + "/" + StrZero(Year(dDtFim), 4)
    cIniPer    := Format8601(.T., jPayLoad["initPeriod"])
    cEndPer    := Format8601(.T., jPayLoad["endPeriod"])
    lSolic13   := jPayLoad["christmasBonus"]
    cRestFault := GetDataForJob("27",;
            {cBranchVld, cMatSRA, cEmpSolic, nDias, nDiasAbn, cIniVac, cEndVac, lSolic13, cIniPer, cEndPer, Nil, lGestor},;
            cEmpSolic,;
            cEmpAnt)
        
    If !lPost .Or. !Empty(cRestFault)
        Return cRestFault 
    EndIf          

    lSUPAprove := SuperGetMv("MV_SUPTORH", NIL, .F.)

    //Busca dados do solicitante
    aEmployee := getSummary(cMatSRA, cBranchVld, cEmpSolic)

    //Busca visão para a solicitação de férias
    aVision := GetVisionAI8("W_PWSA100A.APW", cBranchVld, cEmpSolic)
    cVision := aVision[1][1]
    
    //Busca código do participante na RDZ
    cRD0Cod := getRD0(cEmpGestor, cBranchSolic, cMatSolic)

    //Busca estrutura organizacional do workflow
    cMRrhKeyTree := fMHRKeyTree(If(!Empty(cBranchSolic), cBranchSolic, cBranchVld) , If(!Empty(cMatSolic), cMatSolic, cMatSRA))
    aGetStruct   := APIGetStructure(cRD0Cod,;
        SUPERGETMV("MV_ORGCFG"),;
        cVision,;
        cBranchVld,;
        cMatSRA,;
        Nil,;
        Nil,;
        Nil,;
        "B",;
        If(!Empty(cBranchSolic), cBranchSolic, cBranchVld),;
            If(!Empty(cMatSolic), cMatSolic, cMatSRA),;
                Nil,;
                Nil,;
                Nil,;
                Nil,;
                .T.,;
                {cEmpAnt},;
                Nil,;
                Nil,;
                .T.)

    lRet := valType(aGetStruct[1]) == "L" .And. !aGetStruct[1]

    If(lRet, cRestFault := Alltrim(EncodeUTF8(aGetStruct[2]) + " - " + EncodeUTF8(aGetStruct[3])), Nil)
    
    If !lRet .And. Len(aGetStruct) >= 1 .And. !(Len(aGetStruct) == 3 .And. !aGetStruct[1]) .And. (!lGestor .Or. (lGestor .And. !lSUPAprove))
        cEmpApr   := aGetStruct[1]:ListOfEmployee[1]:SupEmpresa
        cFilApr   := aGetStruct[1]:ListOfEmployee[1]:SupFilial
        nSupLevel := aGetStruct[1]:ListOfEmployee[1]:LevelSup
        cApprover := aGetStruct[1]:ListOfEmployee[1]:SupRegistration
        cDeptoApr := aGetStruct[1]:ListOfEmployee[1]:DepartAprovador
    EndIf
        
    If Empty(cRestFault)
        lRet := .F.
        //Prepara objeto RH3 Request
        oRequest := WSClassNew("TRequest")
        oRequest:Origem               := EncodeUTF8(STR0002) //MEURH
        oRequest:Branch				  := cBranchVld
        oRequest:Registration		  := cMatSRA
        oRequest:StarterBranch		  := If( !Empty(cBranchSolic), cBranchSolic, cBranchVld )
        oRequest:StarterRegistration  := If( !Empty(cMatSolic)   , cMatSolic   , cMatSRA    )
        oRequest:Vision				  := cVision
        oRequest:Observation          := Alltrim(STR0003 + " - " + aEmployee[2] + " - " + dToC(Date()) + Space(1) + Time()) //Solicitação de Férias
        oRequest:EmpresaAPR           := cEmpApr
        oRequest:ApproverBranch       := cFilApr
        oRequest:ApproverRegistration := cApprover
        oRequest:ApproverLevel        := nSupLevel
        oRequest:DepartAPR            := cDeptoApr
        oRequest:Empresa              := cEmpSolic

        //Prepara objeto RH4 Vacation
        oVacationRequest := WSClassNew("TVacation")
        oVacationRequest:Branch                     := cBranchVld
        oVacationRequest:Registration               := cMatSRA
        oVacationRequest:Name                       := aEmployee[2]
        oVacationRequest:InitialDate                := cIniVac
        oVacationRequest:FinalDate                  := cEndVac
        oVacationRequest:Days                       := nDias
        oVacationRequest:PecuniaryDays              := nDiasAbn
        oVacationRequest:PecuniaryAllowance         := IIf(nDiasAbn > 0, ".T.", ".F.")
        oVacationRequest:ThirteenthSalary1stInstall := IIf(lSolic13, ".T.", ".F.")

        If (lRet := AddVacationRequest(oRequest, oVacationRequest, "MEURH", .T., @cMsgReturn))
            //complementa RH4 com os dados do período aquisito relacionado
            cAliasRH4 := GetNextAlias()
            BeginSQL ALIAS cAliasRH4
                SELECT COUNT(*) QTD  FROM %table:RH4% RH4
                WHERE RH4.RH4_CODIGO = %exp:oRequest:Code%
                AND RH4.RH4_FILIAL = %exp:oVacationRequest:Branch%
                AND RH4.%NotDel%
                EndSQL

            If (cAliasRH4)->(!Eof()) .And. (cAliasRH4)->QTD > 0
                DBSelectArea("RH4")
                Reclock("RH4", .T.)
                RH4->RH4_FILIAL	:= oVacationRequest:Branch
                RH4->RH4_CODIGO	:= oRequest:Code
                RH4->RH4_ITEM	:= (cAliasRH4)->QTD + 1
                RH4->RH4_CAMPO	:= "RF_DATABAS"
                RH4->RH4_VALNOV	:= cIniPer
                RH4->(MsUnlock())

                Reclock("RH4", .T.)
                RH4->RH4_FILIAL	:= oVacationRequest:Branch
                RH4->RH4_CODIGO	:= oRequest:Code
                RH4->RH4_ITEM	:= (cAliasRH4)->QTD + 2
                RH4->RH4_CAMPO	:= "RF_DATAFIM"
                RH4->RH4_VALNOV	:= cEndPer
                RH4->(MsUnlock())
            EndIf
            (cAliasRH4)->(dbCloseArea())
        EndIf 

        If(!lRet, cRestFault := cMsgReturn, Nil)

        FreeObj(oRequest)
        FreeObj(oVacationRequest)
    EndIf
EndIf 

Return cRestFault

//------------------------------------------------------------------
/*/{Protheus.doc} getRD0
Função que busca do código do participante na RDZ

@param cEmp, character, Empresa do solicitante
@param cFilSolic, character, Filial do solicitante
@param cMatSolic, character, Matrícula do solicitante
@return cCodRD0, character, Código do participante na RDZ
@author Bruno Costa
@since  13/08/2026
@version 1.0
/*/
//-------------------------------------------------------------------
Static Function getRD0(cEmp, cFilSolic, cMatSolic) as character
local aArea := GetArea() as array
local cCodRD0 as character

DbSelectArea("RDZ")
RDZ->(dbSetOrder(1)) //RDZ_FILIAL+RDZ_EMPENT+RDZ_FILENT+RDZ_ENTIDA+RDZ_CODENT+RDZ_CODRD0

If RDZ->(dbSeek(xFilial("RDZ", cFilSolic) + cEmp + cFilSolic + "SRA" + cFilSolic + cMatSolic))
	cCodRD0 := RDZ->RDZ_CODRD0
EndIf

RDZ->(DbCloseArea())

RestArea(aArea)

Return cCodRD0
