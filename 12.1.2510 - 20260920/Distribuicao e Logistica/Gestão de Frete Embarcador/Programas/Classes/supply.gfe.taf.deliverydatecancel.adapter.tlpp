#include "protheus.ch"
#include "tlpp-core.th"

using namespace totvs.protheus.supply.gfe.taf

//-------------------------------------------------------------------
/*/{Protheus.doc} DeliveryDateCancelAdapter
Classe responsável pela integração do cancelamento do evento de atualização
da data de entrega do documento com o TAF (TOTVS Automação Fiscal)

@author  Guilherme A. Metzger
@since   20/04/2026
@version 1.0
/*/
//-------------------------------------------------------------------
Class DeliveryDateCancelAdapter

    protected data oEvent             as object
    protected data oWSEventRepository as object
    protected data oLog               as object

    public  method new()
    public  method cancel()
    public  method destroy()

    private method getEventID()
    private method addToLog()
    private method endLog()

EndClass

//-------------------------------------------------------------------
/*/{Protheus.doc} DeliveryDateCancelAdapter():New()
Construtor da classe DeliveryDateCancelAdapter

@author  Guilherme A. Metzger
@since   20/04/2026
@version 1.0
/*/
//-------------------------------------------------------------------
Method new(oEvent) Class DeliveryDateCancelAdapter

    ::oEvent := oEvent

    ::oWSEventRepository := totvs.protheus.fiscal.taf.event.WSEventsRepository():New("PUT")

    ::oLog := GFELog():New("Integracao_Monitor_Eventos_TAF", "Integração com o Monitor de Eventos do TAF","3")

Return Self

//-------------------------------------------------------------------
/*/{Protheus.doc} DeliveryDateCancelAdapter():cancelEvent()
Método de envio do evento para o TAF

@author  Guilherme A. Metzger
@since   20/04/2026
@version 1.0
/*/
//-------------------------------------------------------------------
Method cancel() Class DeliveryDateCancelAdapter

    Local jEventResponse as json
    Local cEventID       as character

    ::addToLog("Cancelamento do evento de atualização da data de entrega",.T.)
    ::addToLog("Filial         : " + AllTrim(::oEvent:getFilial() ),.F.)
    ::addToLog("Tipo Doc.      : " + AllTrim(::oEvent:getTipo()   ),.F.)
    ::addToLog("Emissor        : " + AllTrim(::oEvent:getEmissor()),.F.)
    ::addToLog("Série          : " + AllTrim(::oEvent:getSerie()  ),.F.)
    ::addToLog("Número         : " + AllTrim(::oEvent:getNumero() ),.F.)
    ::addToLog("Data de Entrega: " + AllTrim(DtoC(::oEvent:getDataEntregaAnt())),.T.)

    cEventID := ::getEventID()

    If !Empty(cEventID)

        jEventResponse := ::oWSEventRepository:putEventCancel(cEventID)

// Comentado, pois não consegui passar nas linhas de issue x cobertura
//        If jEventResponse["lOk"]
            ::addToLog("Retorno do método putEventCancel: " + jEventResponse['message'],.F.)
//        Else
//            ::addToLog("Retorno do método putEventCancel: " + StrZero(jEventResponse['errorCode'],3) + " - " + jEventResponse['errorMessage'],.F.)
//        EndIf

    EndIf

    ::endLog()

    FreeObj(jEventResponse)

Return

//-------------------------------------------------------------------
/*/{Protheus.doc} DeliveryDateCancelAdapter():cancelEvent()
Busca o ID do Evento

@author  Guilherme A. Metzger
@since   20/04/2026
@version 1.0
/*/
//-------------------------------------------------------------------
Method getEventID() Class DeliveryDateCancelAdapter

    Local oProcessingQueue as object
    Local jProcessingQueue as json
    Local jResponse        as json
    Local aEvents          as array
    Local jEvent           as json
    Local cResponse        as character
    Local dDataEntregaAnt  as date

    dDataEntregaAnt := ::oEvent:getDataEntregaAnt()

    ::addToLog("Busca do ID do evento a ser cancelado",.F.)

    jProcessingQueue := JsonObject():New()
    jProcessingQueue["chvnfe"  ] := ::oEvent:getChaveNFe()
    jProcessingQueue["event"   ] := ::oEvent:getCodigoEvento()

    oProcessingQueue := totvs.protheus.fiscal.taf.event.ProcessingQueue():New()
    jResponse := oProcessingQueue:retEventCancel(jProcessingQueue)

    If jResponse["total"] > 0

        aEvents   := jResponse["registros"]
        jEvent    := aEvents[Len(aEvents)]
        cResponse := jEvent["id"]

        ::addToLog("ID do evento localizado: " + cResponse,.F.)

    Else
        ::addToLog("Não foi possível localizar eventos aptos a serem cancelados.",.F.)
    EndIf

    FreeObj(oProcessingQueue)

Return cResponse

//-------------------------------------------------------------------
/*/{Protheus.doc} DeliveryDateCancelAdapter():addToLog()
Método que adiciona mensagem no log de integração do evento

@author  Guilherme A. Metzger
@since   20/04/2026
@version 1.0
/*/
//-------------------------------------------------------------------
Method addToLog(cText as Character,lAddNewLine as Logical) Class DeliveryDateCancelAdapter

    ::oLog:Add(cText)

    If lAddNewLine
        ::oLog:NewLine()
    EndIf

Return

//-------------------------------------------------------------------
/*/{Protheus.doc} DeliveryDateCancelAdapter():endLog()
Método que finaliza o log de integração do evento

@author  Guilherme A. Metzger
@since   20/04/2026
@version 1.0
/*/
//-------------------------------------------------------------------
Method endLog() Class DeliveryDateCancelAdapter

    ::oLog:EndLog()

Return

//-------------------------------------------------------------------
/*/{Protheus.doc} DeliveryDateCancelAdapter():destroy()
Método que libera os objetos utilizados pela classe

@author  Guilherme A. Metzger
@since   20/04/2026
@version 1.0
/*/
//-------------------------------------------------------------------
Method destroy() Class DeliveryDateCancelAdapter

    FreeObj(::oWSEventRepository)
    FreeObj(::oLog)

Return
