#include "protheus.ch"
#include "tlpp-core.th"

using namespace totvs.protheus.supply.gfe.taf

//-------------------------------------------------------------------
/*/{Protheus.doc} DeliveryDateEventClass
Classe de que armazena os dados do evento de atualização
da data de entrega

@author  Guilherme A. Metzger
@since   30/03/2026
@version 1.0
/*/
//-------------------------------------------------------------------
Class DeliveryDateEventClass

    protected data cChaveNFe         as character
    protected data cTabela           as character
    protected data cRotina           as character
    protected data cCodigoEvento     as character
    protected data cUF               as character
    protected data dDataEntrega      as date
    protected data cFilialDocumento  as character
    protected data cTipo             as character
    protected data cEmissor          as character
    protected data cSerie            as character
    protected data cNumero           as character
    protected data dDataEntregaAnt   as date

    public method new()
    public method getChaveNFe()
    public method getTabela()
    public method getRotina()
    public method getCodigoEvento()
    public method getUF()
    public method getDataEntrega()
    public method getFilial()
    public method getTipo()
    public method getEmissor()
    public method getSerie()
    public method getNumero()
    public method getDataEntregaAnt()

EndClass

//-------------------------------------------------------------------
/*/{Protheus.doc} DeliveryDateEventClass():New()
Construtor da classe DeliveryDateEventClass

@author  Guilherme A. Metzger
@since   30/03/2026
@version 1.0
/*/
//-------------------------------------------------------------------
Method new(cChaveNFe,cTabela,cRotina,cCodigoEvento,cUF,dDataEntrega,cFilialDocumento,cTipo,cEmissor,cSerie,cNumero,dDataEntregaAnt) Class DeliveryDateEventClass

    ::cChaveNFe        := cChaveNFe
    ::cTabela          := cTabela
    ::cRotina          := cRotina
    ::cCodigoEvento    := cCodigoEvento
    ::cUF              := cUF
    ::dDataEntrega     := dDataEntrega
    ::cFilialDocumento := cFilialDocumento
    ::cTipo            := cTipo
    ::cEmissor         := cEmissor
    ::cSerie           := cSerie
    ::cNumero          := cNumero
    ::dDataEntregaAnt  := dDataEntregaAnt

Return Self

