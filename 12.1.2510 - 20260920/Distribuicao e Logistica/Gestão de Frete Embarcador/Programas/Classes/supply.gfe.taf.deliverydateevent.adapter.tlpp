#include "protheus.ch"
#include "tlpp-core.th"

using namespace totvs.protheus.supply.gfe.taf

//-------------------------------------------------------------------
/*/{Protheus.doc} DeliveryDateEventAdapter
Classe responsável pela integração do evento de atualização da data
de entrega do documento com o TAF (TOTVS Automação Fiscal)

@author  Guilherme A. Metzger
@since   30/03/2026
@version 1.0
/*/
//-------------------------------------------------------------------
Class DeliveryDateEventAdapter

    protected data oEvent             as object
    protected data oWSEventRepository as object
    protected data oLog               as object
    protected data jEventRequest      as json

    public  method new()
    public  method publish()
    public  method destroy()

    private method buildJson()
    private method addToLog()
    private method endLog()

EndClass

//-------------------------------------------------------------------
/*/{Protheus.doc} DeliveryDateEventAdapter():New()
Construtor da classe DeliveryDateEventAdapter

@author  Guilherme A. Metzger
@since   30/03/2026
@version 1.0
/*/
//-------------------------------------------------------------------
Method new(oEvent) Class DeliveryDateEventAdapter

    ::oEvent := oEvent

    ::oWSEventRepository := totvs.protheus.fiscal.taf.event.WSEventsRepository():New("POST")

    ::oLog := GFELog():New("Integracao_Monitor_Eventos_TAF", "Integração com o Monitor de Eventos do TAF","3")

    ::buildJson()

Return Self

//-------------------------------------------------------------------
/*/{Protheus.doc} DeliveryDateEventAdapter():buildJson()
Método que prepara o Json de integração do evento

@author  Guilherme A. Metzger
@since   30/03/2026
@version 1.0
/*/
//-------------------------------------------------------------------
Method buildJson() Class DeliveryDateEventAdapter

    Local dDataEntrega := ::oEvent:getDataEntrega()
    Local cAno         := StrZero(Year(dDataEntrega) ,4)
    Local cMes         := StrZero(Month(dDataEntrega),2)
    Local cDia         := StrZero(Day(dDataEntrega)  ,2)
    Local cDataEntrega := cAno + "-" + cMes + "-" + cDia

    ::jEventRequest := JsonObject():New()
    ::jEventRequest["chvnfe"       ] := ::oEvent:getChaveNFe()
    ::jEventRequest["originTable"  ] := ::oEvent:getTabela()
    ::jEventRequest["originRoutine"] := ::oEvent:getRotina()
    ::jEventRequest["event"        ] := JsonObject():New()
    ::jEventRequest["event"        ]["event" ] := ::oEvent:getCodigoEvento()
    ::jEventRequest["event"        ]["fields"] := JsonObject():New()
    ::jEventRequest["event"        ]["fields"]["stateAuthor"       ] := ::oEvent:getUF()
    ::jEventRequest["event"        ]["fields"]["deliveryDate"      ] := cDataEntrega
    ::jEventRequest["event"        ]["fields"]["dischargeIndicator"] := "1"
    ::jEventRequest["event"        ]["fields"]["authorType"        ] := "1"
    ::jEventRequest["event"        ]["items" ] := Array(0)

Return

//-------------------------------------------------------------------
/*/{Protheus.doc} DeliveryDateEventAdapter():publish()
Método de envio do evento para o TAF

@author  Guilherme A. Metzger
@since   30/03/2026
@version 1.0
/*/
//-------------------------------------------------------------------
Method publish() Class DeliveryDateEventAdapter

    Local jEventResponse as json

    ::addToLog("Evento de atualização da data de entrega"    ,.T.)
    ::addToLog("Filial   : " + AllTrim(::oEvent:getFilial() ),.F.)
    ::addToLog("Tipo Doc.: " + AllTrim(::oEvent:getTipo()   ),.F.)
    ::addToLog("Emissor  : " + AllTrim(::oEvent:getEmissor()),.F.)
    ::addToLog("Série    : " + AllTrim(::oEvent:getSerie()  ),.F.)
    ::addToLog("Número   : " + AllTrim(::oEvent:getNumero() ),.T.)

    jEventResponse := ::oWSEventRepository:postInsertEvents(::jEventRequest)

    If jEventResponse['code'] <> Nil
       ::addToLog("Retorno do método postInsertEvents: " + StrZero(jEventResponse['code'],3) + " - " + jEventResponse['message'],.F.)
    EndIf

    ::endLog()

    FreeObj(jEventResponse)

Return

//-------------------------------------------------------------------
/*/{Protheus.doc} DeliveryDateEventAdapter():addToLog()
Método que adiciona mensagem no log de integração do evento

@author  Guilherme A. Metzger
@since   30/03/2026
@version 1.0
/*/
//-------------------------------------------------------------------
Method addToLog(cText as Character,lAddNewLine as Logical) Class DeliveryDateEventAdapter

    ::oLog:Add(cText)

    If lAddNewLine
        ::oLog:NewLine()
    EndIf

Return

//-------------------------------------------------------------------
/*/{Protheus.doc} DeliveryDateEventAdapter():endLog()
Método que finaliza o log de integração do evento

@author  Guilherme A. Metzger
@since   30/03/2026
@version 1.0
/*/
//-------------------------------------------------------------------
Method endLog() Class DeliveryDateEventAdapter

    ::oLog:EndLog()

Return

//-------------------------------------------------------------------
/*/{Protheus.doc} DeliveryDateEventAdapter():destroy()
Método que libera os objetos utilizados pela classe

@author  Guilherme A. Metzger
@since   30/03/2026
@version 1.0
/*/
//-------------------------------------------------------------------
Method destroy() Class DeliveryDateEventAdapter

    FreeObj(::jEventRequest)
    FreeObj(::oWSEventRepository)
    FreeObj(::oLog)

Return
