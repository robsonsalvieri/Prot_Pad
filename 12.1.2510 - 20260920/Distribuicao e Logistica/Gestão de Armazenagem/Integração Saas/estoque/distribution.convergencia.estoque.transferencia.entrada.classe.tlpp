#Include "Totvs.ch"
#include "tlpp-core.th"

Static nTamSeqInt := TamSx3('DBZ_SEQINT')[1]

/*/{Protheus.doc} WMSSaasEstoqueTransferenciaEntrada
Classe de Estoque Transferencia Entrada (MATA261)
@type class
@author Equipe WMS Protheus
@since 18/02/2025
/*/
Class WMSSaasEstoqueTransferenciaEntrada From WMSSaasConvergencia
    Public Method new(cNumeroDocumento as character, dDataEmissao as date) as object
    Public Method parseItemConvergencia(cProduto as character, nQuantidade as numeric, cArmazem as character, cLote as character, dDataValidade as date, cNumSeq as character) as logical
    Public Method canBeUpdated() as logical
    Public Method loadByItem(cNumeroDocumento as character, cNumSeq as character, cLocal as character) as object
    Public Method loadOrNew(cNumeroDocumento as character, dDataEmissao as date) as object
    Public Method loadByChave(cNumeroDocumento as character) as object
    Public Method loadItemConvergenciaSaas(cIdDBZ as character, cLocal as character, cProduto as character, cLoteCtl as character) as logical
    Public Method somaItemConvergencia(nQuantidade as numeric) as object
    Public Method setLiberado() as object
    Public Method getSequence() as character
EndClass

/*/{Protheus.doc} loadOrNew
Faz o load ou instancia a convergencia
@author Fagner Ferraz
@since 25/02/2025
/*/
Method loadOrNew(cNumeroDocumento, dDataEmissao) as object Class WMSSaasEstoqueTransferenciaEntrada
local oLoad := self:loadByChave(cNumeroDocumento)
    
    If !Empty(oLoad:id)
        Return oLoad
    EndIf

Return self:new(cNumeroDocumento, dDataEmissao)

/*/{Protheus.doc} new
Instancia as propriedades da convergencia
@author Fagner Ferraz
@since 19/02/2025
/*/
Method new(cNumeroDocumento, dDataEmissao) as object Class WMSSaasEstoqueTransferenciaEntrada
    self:status              := self:getStatusCriado()
    self:tipoTransacao       := self:getTipoTransacaoEstoqueTransferenciaEntrada()
    self:numeroDocumento     := cNumeroDocumento
    self:dataCriacao         := FWTimeStamp(3, dDataBase, Time())
    self:dataEmissao         := dDataEmissao
    self:sequenciaIntegracao := ""
    self:mensagemIntegracao  := ""
    self:itensConvergencia   := {}
Return self

/*/{Protheus.doc} loadByChave
Faz o load da convergencia
@author Fagner Ferraz
@since 25/02/2025
/*/
Method loadByChave(cNumeroDocumento) as object Class WMSSaasEstoqueTransferenciaEntrada
Local cAliasDBZ := GetNextAlias()
    BeginSql Alias cAliasDBZ
		SELECT DBZ.DBZ_ID IDCONVERGENCIA
	    FROM %Table:DBZ% DBZ
		WHERE DBZ.DBZ_FILIAL = %Exp:xFilial("DBZ")%
		    AND DBZ.DBZ_TIPOTR = %Exp:WMSSaasConvergencia():getTipoTransacaoEstoqueTransferenciaEntrada()%
		    AND DBZ.DBZ_NUMDOC = %Exp:cNumeroDocumento%
		    AND DBZ.%NotDel%
	EndSql

    If (cAliasDBZ)->(!Eof())
        self:loadById((cAliasDBZ)->IDCONVERGENCIA)
    EndIf
    (cAliasDBZ)->(DbCloseArea())
Return self

/*/{Protheus.doc} parseItemConvergencia
Alimenta a propriedade itensConvergencia
@author Fagner Ferraz
@since 25/02/2025
/*/
Method parseItemConvergencia(cProduto, nQuantidade, cArmazem, cLote, dDataValidade, cNumSeq) as logical Class WMSSaasEstoqueTransferenciaEntrada
Local aArea  := GetArea() 
    
        AAdd(self:itensConvergencia, WMSSaasEstoqueItemTransferenciaEntrada():set(;
                self:numeroDocumento,; 
                cProduto,;
                nQuantidade,;
                cArmazem,;
                cLote,;
                dDataValidade,;
                cNumSeq;
                ))
   
    RestArea(aArea)
Return .T.

/*/{Protheus.doc} canBeUpdated
    Retorna se o estoque transferencia entrada pode ser alterado
    @author Equipe WMS Protheus
    @since 17/02/2025
    @return logico
/*/
Method canBeUpdated() as logical Class WMSSaasEstoqueTransferenciaEntrada
Return self:isCriado() .Or. self:isCancelado() .Or. self:isErroIntegracao()

/*/{Protheus.doc} loadByItem
    Busca pelo item da transferencia/DBY
    @author Equipe WMS Protheus
    @since 17/02/2025
    @param cNumeroDocumento, character, D3_NUMDOC/DBZ_NUMDOC
    @param cNumSeq, character, D3_NUMSEQ/DBY_NUMSEQ
    @return self, objeto, convergencia
/*/
Method loadByItem(cNumeroDocumento as character, cNumSeq as character, cLocal as character) as object Class WMSSaasEstoqueTransferenciaEntrada
Local cId := WMSSaasEstoqueItemTransferenciaEntrada():getIdByItem(cNumeroDocumento, cNumSeq, cLocal)

    If !Empty(cId)
        self:loadById(cId)
    Else
        return self:new()
    EndIf

Return self

/*/{Protheus.doc} loadItemConvergenciaSaas
    Busca item semelhante na DBY para impedir a criacao de itens duplicados
    @author Fagner Ferraz
    @since 14/12/2025
    @param cIdDBZ, character, id DBZ
    @param cLocal, character, local de estoque
    @param cProduto, character, produto
    @param cLoteCtl, character, lote
    @return logico
    /*/
Method loadItemConvergenciaSaas(cIdDBZ, cLocal, cProduto, cLoteCtl) as logical Class WMSSaasEstoqueTransferenciaEntrada
Local cAliasDBY := GetNextAlias()
Local aAreaDBY  := DBY->(GetArea())
Local lRet      := .F.

    If Rastro(cProduto)
        BeginSql Alias cAliasDBY
            SELECT DBY.R_E_C_N_O_ AS RECNO
            FROM %Table:DBY% DBY
            WHERE DBY_FILIAL = %xFilial:DBY%
            AND DBY.DBY_ID = %Exp:cIdDBZ%
            AND DBY.DBY_LOCAL = %Exp:cLocal%
            AND DBY.DBY_PRODUT = %Exp:cProduto%
            AND DBY.DBY_LOTE = %Exp:cLoteCtl%
            AND DBY.%NotDel%
        EndSql
    Else
        BeginSql Alias cAliasDBY
            SELECT DBY.R_E_C_N_O_ AS RECNO
            FROM %Table:DBY% DBY
            WHERE DBY_FILIAL = %xFilial:DBY%
            AND DBY.DBY_ID = %Exp:cIdDBZ%
            AND DBY.DBY_LOCAL = %Exp:cLocal%
            AND DBY.DBY_PRODUT = %Exp:cProduto%
            AND DBY.%NotDel%
        EndSql
    EndIf
    If (cAliasDBY)->(!Eof())
        DBY->( DbGoto( (cAliasDBY)->RECNO) )
        self:itensConvergencia := { WMSSaasItemConvergencia():load() } //--Grava como array para compatibilidade com o método saveItens da Convergencia
        lRet := .T.
    EndIf
    (cAliasDBY)->(DbCloseArea())

RestArea(aAreaDBY)    
Return lRet

/*/{Protheus.doc} somaItemConvergencia
    Soma quantidade do array de itens da convergencia
    @author Equipe WMS
    @since 04/12/2025
    @param nQuantidade, numeric, quantidade do item
    @return self, objeto, convergencia
    /*/
Method somaItemConvergencia(nQuantidade) as object Class WMSSaasEstoqueTransferenciaEntrada
    self:itensConvergencia[Len(self:itensConvergencia)]:QUANTIDADE += nQuantidade
Return self

/*/{Protheus.doc} setLiberado
    @author Fagner Ferraz
    @since 14/05/2026
    @version 1.0
    @return self, object, Objeto da convergencia
    /*/
Method setLiberado() Class WMSSaasEstoqueTransferenciaEntrada
    Begin Transaction
        If WMSSaasSeekDBZById(self:id) .And. RecLock("DBZ", .F.)
            DBZ->DBZ_STATUS := self:getStatusLiberado()
            DBZ->DBZ_SEQINT := self:getSequence()
            DBZ->(MsUnlock())

            self:load()
        EndIf
    End Transaction
Return self

/*/{Protheus.doc} getSequence
    @author Fagner Ferraz
    @since 14/05/2026
    @version 1.0
    @return cNewSeq, character, Nova sequencia da convergencia
    /*/
Method getSequence() Class WMSSaasEstoqueTransferenciaEntrada
Local cAliasDBZ := ""
Local cNewSeq   := ""
Local cSeqInt   := Space(nTamSeqInt)
    cAliasDBZ := GetNextAlias()
    BeginSql Alias cAliasDBZ
		SELECT MAX(DBZ.DBZ_SEQINT) MAXSEQINT
		  FROM %Table:DBZ% DBZ
		 WHERE DBZ.DBZ_FILIAL = %Exp:xFilial("DBZ")%
		   AND DBZ.DBZ_TIPOTR = %Exp:self:getTipoTransacaoEstoqueTransferenciaEntrada()%
		   AND DBZ.DBZ_NUMDOC = %Exp:self:numeroDocumento%
           AND DBZ.DBZ_SEQINT <> %Exp:cSeqInt%
		   AND DBZ.%NotDel%
	EndSql
	cNewSeq := Iif(!Empty((cAliasDBZ)->MAXSEQINT), Soma1(PadL((cAliasDBZ)->MAXSEQINT, self:getTamSeqInt(), "0" )), Soma1(PadL("0",self:getTamSeqInt(),"0")))

    (cAliasDBZ)->(DbCloseArea())
Return cNewSeq
