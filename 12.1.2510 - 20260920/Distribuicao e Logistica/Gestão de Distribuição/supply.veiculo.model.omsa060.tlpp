#include 'fw-tlpp-core.th'
#include 'protheus.ch'
#INCLUDE "OMSA060.CH"
#include 'totvs.framework.structure.model.th'

/*/-----------------------------------------------------------
{Protheus.doc} supply.veiculo.model.omsa060 
Classe de modelo do cadastro de veículos
Documentação técnica SMART X 
https://tdn.totvs.com/pages/releaseview.action?pageId=900448160

@author Rafael Souza
@since 11/02/2025
@version 1.0
-----------------------------------------------------------/*/ 

namespace totvs.protheus.supply.veiculo.model 

@totvsFrameworkStructureModel(lookup=.F., country="ALL", description = "Cadastro de Veículos" ) //"Cadastro de Veículos"


class OMSA060 from totvs.framework.structure.model.data 
    public method new() as object
    public method setModel() 
EndClass

/*/{Protheus.doc} new
Instância do objeto da classe
@type method
@author Rafael Souza
@since 11/02/2025
@version P12
/*/
method new() as object class OMSA060 
    _Super:new(,,.T.)
Return self 

/*/{Protheus.doc} setModel
Definição do modelo de dados
@type method
@author Rafael Souza
@since 11/02/2025
@version P12
/*/
method setModel() class OMSA060
    Local oDA3 as object // Veículos 
    Local oDAW as object // Rastreador X Veículo
    Local oDJ8 as object // Veiculos x Caracteristicas 
    Local oDMG as object // Veículos x TAG Pedágio
    Local oLBT as object // Templates
    Local cTMSRre   as character
    Local lTemplate as logical

    cTMSRre   := SuperGetMv("MV_TMSRRE" ,.F.,"") // 1=Calculo Frete, 2=Cotação, 3=Viagem, 4=Sol.Coleta, Em Branco= Nao Utiliza
    lTemplate := ExistTemplate("TDCEE011")                                      

    oDA3 := totvs.framework.structure.object.ObjectFromMetadata():new( "DA3",, {"DA3_FILIAL","DA3_COD"} ) // Carrega a entidade 
    self:setObject(oDA3:getObject(), "DA3") // Define a entidade principal do seu modelo.
    

    If nModulo == 43 //--Rastreador uso somente no SIGATMS
        oDAW := totvs.framework.structure.object.ObjectFromMetadata():new( "DAW",, {"DAW_FILIAL","DAW_CODVEI", "DAW_ITEM"} )
        self:addArray( oDAW:getObject(), "DAW", {"DAW_FILIAL", "DAW_CODVEI"}, {"DA3_FILIAL", "DA3_COD"}, "DA3")
        self:setProperty("DAW_CODVEI", "hidden", .T., "DAW") // Redefine uma propriedade permitida 
        //Autoincremento para o campo de Item.
        self:setProperty("DAW_ITEM", "autoinc", .t., "DAW")
        self:setProperty("DAW_ITEM", "autoincSequence", "000", "DAW")
        self:setProperty("DAW_ITEM", "format", "alphanumericSec", "DAW")
                
        If !Empty(cTMSRre) .And. cTMSRre <> "0" //--RRE 
            oDJ8 := totvs.framework.structure.object.ObjectFromMetadata():new( "DJ8",, {"DJ8_FILIAL","DJ8_CODVEI", "DJ8_ITEM"})
            self:addArray( oDJ8:getObject(), "DJ8", {"DJ8_FILIAL", "DJ8_CODVEI"}, {"DA3_FILIAL", "DA3_COD"}, "DA3")
            self:setProperty("DJ8_CODVEI", "hidden", .T., "DJ8")
            self:setProperty("DJ8_ITEM", "autoinc", .T., "DJ8")
            self:setProperty("DJ8_ITEM", "autoincSequence", "00", "DJ8")
            self:setProperty("DJ8_ITEM", "format", "alphanumericSec", "DJ8")
        EndIf

        oDMG := totvs.framework.structure.object.ObjectFromMetadata():new( "DMG",,{"DMG_FILIAL","DMG_CODVEI", "DMG_ITEM"})
        self:addArray( oDMG:getObject(), "DMG", {"DMG_FILIAL", "DMG_CODVEI"}, {"DA3_FILIAL", "DA3_COD"}, "DA3")
        self:setProperty("DMG_CODVEI", "hidden", .T., "DMG") 
        self:setProperty("DMG_ITEM", "autoinc", .T., "DMG")
        self:setProperty("DMG_ITEM", "autoincSequence", "000", "DMG")
        self:setProperty("DMG_ITEM", "format", "alphanumericSec", "DMG")

        //Seta as propriedades dos campos:
        self:setProperty("DA3_DATSTS", "defaultValue",FWDateTo8601(DDATABASE) , "DA3")
        self:setProperty("DA3_HORSTS", "defaultValue",Substr(Time(),1,2) + Substr(Time(),4,2)  , "DA3")
        self:setProperty("DA3_STATUS", "defaultValue", "1" , "DA3") //1=Nao DisponiveL
        self:setProperty("DA3_STATUS", "readOnly", .T. , "DA3") 
       
        //Adiciona campos como obrigatório
        self:addRequired({"DA3_PLACA", "DA3_FROVEI", "DA3_CODFOR", "DA3_LOJFOR"}, "DA3")
    Else 
        If lTemplate .AND. ExecTemplate("TDCEE011", .F., .F.) 
            oLBT := totvs.framework.structure.object.ObjectFromMetadata():new("LBT",,{"LBT_FILIAL","LBT_CODVEI"})
            self:addArray( oLBT:getObject(), "LBT", {"LBT_FILIAL", "LBT_CODVEI"}, {"DA3_FILIAL", "DA3_COD"}, "DA3")
            self:setProperty("LBT_CODVEI", "hidden", .T., "LBT") 
        EndIf
    EndIf   

    self:LoadEventsFromMetadata() //realiza os triggers e valids do dicionário de dados

    //Eventos:
    oEvents := totvs.protheus.supply.veiculo.events.OMSA060():new()
    self:setEvents(oEvents)
    
    FwFreeObj( oDA3 )
    FwFreeObj( oDAW )
    FwFreeObj( oDJ8 )
    FwFreeObj( oDMG )
    FwFreeObj( oLBT )

return 


