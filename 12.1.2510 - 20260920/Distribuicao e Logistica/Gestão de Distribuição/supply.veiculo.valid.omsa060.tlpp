#include 'fw-tlpp-core.th'
#include "protheus.ch"
#INCLUDE "OMSA060.CH"
#include "totvs.framework.structure.model.th"
 
namespace totvs.protheus.supply.veiculo.valid  

/*/-----------------------------------------------------------
{Protheus.doc} OmsX060Vld 
Valid SmartX

@author Rafael Souza
@since 09/04/2025
@version 1.0
-----------------------------------------------------------/*/ 
Function OmsX060Vld(xValue, cField as character, aContextInfo as array)
    local jRet      as json
    local cMntTms   as character
    local cSegAtiv  as character
    
    jRet        := JsonObject():new()
    cMntTms     := SuperGetMV('MV_NGMNTMS',,'N') //-- Ativa integracao TMS X MNT
    cSegAtiv    := SuperGetMv("MV_SATVGER",,"") 

    If cField == "DA3_CODFOR"
        DbSelectArea("SA2")
        SA2->(DbSetOrder(1))
        If SA2->(MsSeek(xFilial("SA2")+ xValue + aContextInfo[1] )) 
            If SA2->A2_MSBLQL == "1"
                jRet['return'] := .f.
                jRet['notValidMessage'] := STR0055 //"O código de fornecedor informado encontra-se bloqueado no cadastro de fornecedor."
            Else
                jRet['return'] := .t.
                jRet['notValidMessage'] := ""
            EndIf 
        EndIf
    EndIf

    If nModulo == 43 // TMS 
        If cField == 'DA3_CODBEM'
            If cMntTms == "S"
                DbSelectArea("DA3")
                DbSetOrder(5)
                If MsSeek(xFilial("DA3")+xValue)
                    jRet['return'] := .f.
                    jRet['notValidMessage'] := "OMSA06002 - "  + STR0056 //Código do Bem ja utilizado em outro veiculo. "
                Else
                    jRet['return'] := .t.
                    jRet['notValidMessage'] := ""
                EndIf

                //--Somente em alteração
                DbSelectArea("STF")
                DbSetOrder(1)
                If !Empty(xValue) .And. MsSeek(xFilial("STF")+AllTrim(xValue))
                    jRet['return'] := .f.
                    jRet['notValidMessage'] := "OMSA06003 - " + STR0057 // Existe ordem de serviço para o bem, não é permitido a alteração."
                Else
                    jRet['return'] := .t.
                    jRet['notValidMessage'] := ""
                EndIf

                DbSelectArea("STJ")
				DbSetOrder(2)
                If !Empty(xValue) .And. MsSeek(xFilial("STJ")+ "B" +AllTrim(xValue))
                    jRet['return'] := .f.
                    jRet['notValidMessage'] := "OMSA06003 - " + STR0057 // Existe ordem de serviço para o bem, não é permitido a alteração."
                ElseIf !Empty(xValue) .And. MsSeek(xFilial("STJ")+ "L" +AllTrim(xValue))
                    jRet['return'] := .f.
                    jRet['notValidMessage'] := "OMSA06003 - " + STR0057 // Existe ordem de serviço para o bem, não é permitido a alteração."
                Else
                    jRet['return'] := .t.
                    jRet['notValidMessage'] := ""
                EndIf 
            EndIf 
        EndIf

        If cField == "DJ8_CODCAR"
            If Posicione("DJ0",1,xFilial("DJ0")+xValue,"DJ0_TIPO") <> StrZero(1,Len(DJ0->DJ0_TIPO)) //Veiculos
                jRet['return'] := .f.
                jRet['notValidMessage'] := "OMSA06016 - " + STR0058 //Código de Caracteristica inválido para veículos." 
            Else
                jRet['return'] := .t.
                jRet['notValidMessage'] := ""
            EndIf
        EndIf

        If cField == "DAW_LOJRAS"
            SA2->(dbSetOrder(1))
            If SA2->( dbSeek( xFilial("SA2") + aContextInfo[1] + xValue ) )
                If SA2->A2_SATIV1 $ cSegAtiv
                    jRet['return'] := .t.
                    jRet['notValidMessage'] := ""
                Else
                    jRet['return'] := .f.
                    jRet['notValidMessage'] := "OMSA06009 - " + STR0039 //Fabricante escolhido nao é uma empresa  de rastreamento."
                EndIf 
            Else 
                jRet['return'] := .f.
                jRet['notValidMessage'] := "REGNOIS - " + STR0059 //Não existe registro relacionado a este código."
            EndIf 
        EndIf 
    EndIf   

Return jRet


