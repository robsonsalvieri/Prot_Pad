#include 'fw-tlpp-core.th'
#include 'protheus.ch'
#INCLUDE "OMSA060.CH"
#include 'totvs.framework.structure.Interface.th'

/*/-----------------------------------------------------------
{Protheus.doc} supply.veiculo.interface.omsa060 
Classe de interface do cadastro de veículos
Documentação técnica SMART X 
https://tdn.totvs.com/pages/releaseview.action?pageId=900448160

@author Rafael Souza
@since 11/02/2025
@version 1.0
-----------------------------------------------------------/*/ 

namespace totvs.protheus.supply.veiculo.interface

@totvsFrameworkStructureInterface(lookup = .F., country = "All", description = "Cadastro de Veículos" ) //"Cadastro de Veículos"

class OMSA060 
    private data oInterface     as object 
    private data oDataNew       as object    //implementa a ação de inclusão de um novo registro.
    private data oDataEdit      as object    //implementa as ações de alteração e exclusão.
    private data oDataDetail    as object    //implementa a ação de visualizar.
    private data oDataView      as object    //Implementa o Browse

    public method new() as object 
    public method setInterface()
    public method getContract() as json 

EndClass 

Method new() as object class OMSA060 

Return self 

/*/-----------------------------------------------------------
{Protheus.doc} setInterface - 
Método de definição dos componentes da interface

@author Rafael Souza
@since 11/02/2025
@version 1.0
-----------------------------------------------------------/*/ 
Method setInterface() class OMSA060 

    local oDA3          as object
    local oTabs         as object
    local oActionOpe    as object
    local oActionlib    as object
    local oActionblq    as object
    local oActionMessage as object
    local oColors       as object
    local aElementsDAW  as array
    local aElementsDJ8  as array
    local aElementsDMG  as array
    local aElementsLBT  as array 
    local cTMSRre       as character
    local lTMSOPdg      as logical
    local lRefreshView  as logical
    Local lTemplate     as logical


    If nModulo == 43 // TMS  
        aElementsDAW := {}
        aElementsDJ8 := {}
        aElementsDMG := {}

        cTMSRre   := SuperGetMv("MV_TMSRRE" ,.F.,"") // 1=Calculo Frete, 2=Cotação, 3=Viagem, 4=Sol.Coleta, Em Branco= Nao Utiliza
        lTMSOPdg  := SuperGetMV('MV_TMSOPDG',,'0') == '2' 

        oDA3 := totvs.framework.structure.interface.BuildTabsSection():new()
        
        AAdd(aElementsDAW, {"property":"DAW"} )
        AAdd(aElementsDMG, {"property":"DMG"} )
        If !Empty(cTMSRre) .And. cTMSRre <> "0" //--RRE
            AAdd(aElementsDJ8, {"property":"DJ8"} )
        EndIf 
        

        oTabs := totvs.framework.structure.interface.BuildTabsFromCode():new() 
        oTabs:addTab(STR0024, aElementsDAW) //"Rastreadores"
        oTabs:addTab(STR0043, aElementsDMG) //"Pagto Pedágio - TAG"
        If !Empty(cTMSRre) .And. cTMSRre <> "0" //--RRE 
            oTabs:addTab(STR0037, aElementsDJ8) //"Veiculos x Caracteristicas"
        EndIf 
        

        //Pega a mensagem de retorno da Ação do Botão. 
        oActionMessage := totvs.framework.structure.interface.BuildShowMessageAction():new()
        oActionMessage:setLabel( "_message" )
        oActionMessage:setIdentifier( "_message" )
        oActionMessage:setMessage( "{{$response.title}} {{$response.cMsg}}" )
        oActionMessage:setMessageType( "warning" )
        
        //Dados x Operadora
        If lTMSOPdg
            oActionOpe := totvs.framework.structure.interface.BuildAdvplAction():new()    
            oActionOpe:setLabel( STR0003 ) //"DadosXOperad."
            oActionOpe:setRoutine( "totvs.protheus.supply.veiculo.events.Om060AtOpe" )
            oActionOpe:setParams({"{{$selectedRow.DA3_COD}}"})
            oActionOpe:setHasResponse(.f.)
        EndIf 
    
        //Libera Veículo
        oActionlib := totvs.framework.structure.interface.BuildAdvplAction():new()    
        oActionlib:setLabel( STR0013 + " " + STR0014 ) //Desbloquear Veículo
        oActionlib:setRoutine( "totvs.protheus.supply.veiculo.events.Om060Blq" )
        oActionlib:setParams({"{{$selectedRow.DA3_COD}}", "L"})
        oActionlib:setHasResponse(.t.)
        oActionlib:setAction(oActionMessage:getAction())

        //Bloqueia veículo
        oActionblq := totvs.framework.structure.interface.BuildAdvplAction():new()    
        oActionblq:setLabel( STR0012 + " " + STR0014 ) //Bloquear Veículo
        oActionblq:setRoutine( "totvs.protheus.supply.veiculo.events.Om060Blq" )
        oActionblq:setParams({"{{$selectedRow.DA3_COD}}", "B"})
        oActionblq:setHasResponse(.t.)
        oActionblq:setAction(oActionMessage:getAction())
    Else
        lTemplate := ExistTemplate("TDCEE011")
        If lTemplate .And. ExecTemplate("TDCEE011", .F., .F.) 
            aElementsLBT := {}
            AAdd(aElementsLBT, {"property":"LBT"} )
            oTabs := totvs.framework.structure.interface.BuildTabsFromCode():new()
            oTabs:addTab( STR0042 , aElementsLBT ) //"Compartimentos" 
        EndIf 
    EndIf 

    ::oInterface := totvs.framework.structure.interface.BuildContract():new( "OMSA060")
    ::oInterface:setTitle(STR0001) //"Cadastro de Veículos"
    ::oInterface:setModelId( "totvs.protheus.supply.veiculo.model.omsa060" , .f./*leiaute automatico*/)

    //Inclusão de registro
    ::oDataNew := totvs.framework.structure.interface.BuildDataNew():new("omsa060New", "totvs.protheus.supply.veiculo.model.omsa060")
    ::oDataNew:setTitle(STR0019 + " " + STR0014 ) //"Incluir Veículo"
    If nModulo == 43
        ::oDataNew:setElement(totvs.framework.structure.interface.BuildElementsFromCode():mergeElements(oDA3:getByObject("totvs.protheus.supply.veiculo.model.omsa060","DA3"), {oTabs:getTabs()}))
    EndIf 
    
    //Alteração / Exclusão
    ::oDataEdit := totvs.framework.structure.interface.BuildDataEdit():new("omsa060Edit", "totvs.protheus.supply.veiculo.model.omsa060")
    ::oDataEdit:setTitle(STR0054 + " " + STR0014) //"Editar Veículo"
    If nModulo == 43
        ::oDataEdit:setElement(totvs.framework.structure.interface.BuildElementsFromCode():mergeElements(oDA3:getByObject("totvs.protheus.supply.veiculo.model.omsa060","DA3"), {oTabs:getTabs()}))
    EndIf

    //Visualizar
    ::oDataDetail := totvs.framework.structure.interface.BuildDataDetail():new("omsa060Detail", "totvs.protheus.supply.veiculo.model.omsa060")
    ::oDataDetail:setTitle(STR0018 + " " + STR0014) //"Visualizar Veículo"
    If nModulo == 43 
        ::oDataDetail:setElement(totvs.framework.structure.interface.BuildElementsFromCode():mergeElements(oDA3:getByObject("totvs.protheus.supply.veiculo.model.omsa060","DA3"), {oTabs:getTabs()}))
    EndIf 
    
    //Definindo a estrutura das legendas
    oColors := totvs.framework.structure.interface.LabelColors():new() 
    oColors:setColors({"red1","green2","yellow1"})

    //Browse
    ::oDataView := totvs.framework.structure.interface.BuildDataView():new("omsa060View", "totvs.protheus.supply.veiculo.model.omsa060")
    ::oDataView:setModelId( "totvs.protheus.supply.veiculo.model.omsa060" )
    ::oDataView:setTitle(STR0001) //"Cadastro de Veículos"
    ::oDataView:setFieldAsLabel("DA3","DA3_ATIVO") // Legenda do campo
    ::oDataView:setInvisibleFields( {"DAW", "DJ8", "DMG", "LBT"})
    If nModulo == 43
        lRefreshView := .T.
        ::oDataView:setFieldAsLabel("DA3","DA3_STATUS", oColors:getObject() )
        If lTMSOPdg
            ::oDataView:addTableAction(oActionOpe:getAction())
        EndIf 
        ::oDataView:addTableAction(oActionlib:getAction(), , , lRefreshView)
        ::oDataView:addTableAction(oActionblq:getAction(), , , lRefreshView)
    EndIf 
    ::oDataView:assignInvisibleFields()
   
    //Associação dos objetos criados ao objeto de interface
    ::oInterface:setDataNew(::oDataNew:getDataNew(), .f./*leiaute automatico*/)
    ::oInterface:setDataEdit(::oDataEdit:getDataEdit(), .f./*leiaute automatico*/)
    ::oInterface:setDataDetail(::oDataDetail:getDataDetail(), .f./*leiaute automatico*/)
    ::oInterface:setDataView(::oDataView:getDataView())

return

/*/-----------------------------------------------------------
{Protheus.doc} getContract - 
Método que retorna o contrato da interface

@author Rafael Souza
@since 11/02/2025
@version 1.0
-----------------------------------------------------------/*/ 
Method getContract() as json class OMSA060
return ::oInterface:getContract()

