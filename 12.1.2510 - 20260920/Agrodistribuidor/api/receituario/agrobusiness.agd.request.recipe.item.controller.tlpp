#include 'tlpp-core.th'
#include 'tlpp-rest.th'
#include 'TOTVS.CH'

#DEFINE PATH_URL '/api/agd/v2/solicitacao-receitas-itens'


namespace totvs.protheus.agrobusiness.agd  /*nameSpace - para ser importado em shortcurt*/


/*/{Protheus.doc} RequestRecipeItemController
Controller Receituarios
@version 12
@author carlos.augusto
@since 30/10/2025
/*/
class RequestRecipeItemController
  public Data nPage     As Integer
  public Data nPageSize As Integer

  public method new()

  @Get(PATH_URL)
  public method listar() as logical

endClass

/*/{Protheus.doc} new
Constructor
@version 12
@author carlos.augusto
@since 30/10/2025
@return variant, instância
/*/
method new() class RequestRecipeItemController
return self

/*/{Protheus.doc} listar
Recurso REST para listar receituario
@version 12
@author carlos.augusto
@since 30/10/2025
@return logical, true
/*/
method listar() as logical class RequestRecipeItemController
    Local oService As Object
    Local oRestService As Object
    Local oJsonQryParam := Nil

    oRestService := RestService():New()
    oService := RequestRecipeItemService():New()

    oRestService:getPageAndPageSize(@Self:nPage, @Self:nPageSize)
    oJsonQryParam := oRestService:getQueryParams()
     
    oService:listar(Self:nPage, Self:nPageSize, oJsonQryParam)

    oRestService:setAPIResponse(oRest, oService)

    FreeObj(oService)
    FreeObj(oRestService)
return .T.
