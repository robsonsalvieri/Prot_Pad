#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "totvs.ch"
#DEFINE PATH_URL '/api/agd/v2/environment-version'
#DEFINE PATH_URL_SRC '/api/agd/v2/environment-version/:fonte'

namespace totvs.protheus.agrobusiness.agd 



/*/{Protheus.doc} EnviromentVersionController
Api para retornar versão do rpo ou de algum fonte específico
@type class
@version 12
@author carlos.augusto
@since 30/01/2026
/*/
class EnviromentVersionController
    public Data nPage     as numeric
    public Data nPageSize as numeric

    public method New() constructor

    @Get(PATH_URL)
    public method getVersaoRPO()

    @Get(PATH_URL_SRC)
    public method getVersaoFonte()

endclass


/*/{Protheus.doc} New
Cria referencia
@type class
@version 12
@author carlos.augusto
@since 30/01/2026
/*/ 
method New() class EnviromentVersionController
return Self


/*/{Protheus.doc} getVersaoRPO
Retorna a versao do rpo Protheus
@type class
@version 12
@author carlos.augusto
@since 30/01/2026
/*/ 
method getVersaoRPO() class EnviromentVersionController
	Local oRestService As Object
	Local agdEnvVersionService As Object

	oRestService := RestService():New()

	agdEnvVersionService := EnvironmentVersionService():new()
	agdEnvVersionService:getVersaoRPO()

	oRestService:setAPIResponse(oRest, agdEnvVersionService)

	FreeObj(agdEnvVersionService)
	FreeObj(oRestService)
return .T.


/*/{Protheus.doc} getVersaoFonte
Retorna a versao de um fonte enviado
@type class
@version 12
@author carlos.augusto
@since 30/01/2026
/*/ 
method getVersaoFonte() class EnviromentVersionController
	Local oRestService As Object
	Local agdEnvVersionService As Object
	Local cFonte as Character
	Local oJsonPath

	oRestService := RestService():New()

	oJsonPath := oRest:getPathParamsRequest()

	If ValType(oJsonPath) == "J" .And. oJsonPath:hasProperty("fonte")
		cFonte := oJsonPath["fonte"]
	EndIf

	agdEnvVersionService := EnvironmentVersionService():new()
	agdEnvVersionService:getVersaoFonte(cFonte)

	oRestService:setAPIResponse(oRest, agdEnvVersionService)

	FreeObj(agdEnvVersionService)
	FreeObj(oRestService)
return .T.
