#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "totvs.ch"

// ROTAS (seguir padrão do projeto)
#DEFINE PATH_URL_MONITOR         '/api/agd/v2/tco/integracoes/monitor/:codigoFeature/'
#DEFINE PATH_URL_MONITOR_IPAAS   '/api/agd/v2/tco/integracoes/monitor/:codigoFeature/ipaas/'
#DEFINE PATH_URL_CONFIG_IPAAS    '/api/agd/v2/tco/integracoes/monitor/ipaas/configuracao/'
#DEFINE PATH_URL_CONFIG_IPAAS_STATUS '/api/agd/v2/tco/integracoes/monitor/ipaas/configuracao/status/'

namespace totvs.protheus.agrobusiness.agd 


/*/{Protheus.doc} agdTCOIntegracaoApi
API REST para Monitor de Integração das Features (AgroDistribuidor).
Descrição:
- Lista as requisições do schedule (tabela XX3) filtradas pelo código da feature (XX3_PROUTE).
@type class
@version 12
@author rodrigo.nsoledade
@since 24/10/2025
/*/
class TCOIntegrationController 
    public Data nPage     As Integer
    public Data nPageSize As Integer

    public method New() constructor

    // Endpoints REST
    @Get(PATH_URL_MONITOR)
    public method listar() as logical

    @Get(PATH_URL_MONITOR_IPAAS)
    public method listarIpaas() as logical

    @Post(PATH_URL_CONFIG_IPAAS)
    public method salvarConfiguracaoIpaas() as logical

    @Get(PATH_URL_CONFIG_IPAAS_STATUS)
    public method statusConfiguracaoIpaas() as logical

endclass

method New() class TCOIntegrationController
return Self

/*/{Protheus.doc} TCOIntegrationController::listar
Lista as requisições do Monitor de Integração (tabela XX3) filtradas por :codigo (XX3_PROUTE),
@type method
@version  P12
@author rodrigo.nsoledade
@since 24/10/2025
@return logical, .T. em caso de processamento
/*/
method listar() as logical class TCOIntegrationController
	Local oService As Object
	Local oRestService As Object
    local jPathParams   as json
    local cCodFeature   as Character

	oRestService := RestService():New()
	oService := TCOIntegrationMonitorService():New()

    jPathParams   := oRest:getPathParamsRequest()
    cCodFeature   := jPathParams['codigoFeature']

	oRestService:getPageAndPageSize(@Self:nPage, @Self:nPageSize)

	oService:listar(cCodFeature, Self:nPage, Self:nPageSize, oRestService:getQueryParams())

	oRestService:setAPIResponse(oRest, oService)

	FreeObj(oService)
	FreeObj(oRestService)
return .T.

/*/{Protheus.doc} TCOIntegrationController::listarIpaas
Realiza proxy da consulta de monitor para o iPaaS externo, autenticando via header apikey.
@type method
@version P12
@author rodrigo.nsoledade
@since 04/05/2026
@return logical, .T. em caso de processamento
/*/
method listarIpaas() as logical class TCOIntegrationController
    Local oRestService as Object
    Local oService     as Object
    Local jPathParams  as Json
    Local cCodFeature  as Character

    oRestService := RestService():New()
    oService := IpaasProxyService():New()
    
	oRestService:getPageAndPageSize(@Self:nPage, @Self:nPageSize)
    jPathParams := oRest:getPathParamsRequest()

    cCodFeature := ""
    if ValType(jPathParams) == "J" .and. jPathParams:hasProperty("codigoFeature")
        cCodFeature := jPathParams['codigoFeature']
    endif

    oService:getListMonitor(cCodFeature, oRestService:getQueryParams(), Self:nPage, Self:nPageSize)

    oRestService:setAPIResponse(oRest, oService)

    FreeObj(oService)
    FreeObj(oRestService)
return .T.

/*/{Protheus.doc} salvarConfiguracaoIpaas
Salva a configuração do iPaaS (tenant e apiKey) através de endpoint REST.
@type method
@version P12
@author jean.schulze
@since 24/06/2026
@return logical, .T. em caso de processamento
/*/
method salvarConfiguracaoIpaas() as logical class TCOIntegrationController
    Local oRestService as Object
    Local oService     as Object
    Local jConfig      as Json

    oRestService := RestService():New()
    oService := IpaasProxyService():New()
    jConfig := oRestService:getRequestBody(oRest)
   
    oService:saveConfiguration(jConfig)  

    oRestService:setAPIResponse(oRest, oService)

    FreeObj(oService)
    FreeObj(oRestService)
return .T.

/*/{Protheus.doc} statusConfiguracaoIpaas
Retorna o status da configuração do iPaaS (tenant e apiKey).
@type method
@version P12
@author jean.schulze
@since 24/06/2026
@return logical, .T. em caso de processamento
/*/
method statusConfiguracaoIpaas() as logical class TCOIntegrationController
    Local oRestService as Object
    Local oService     as Object
    Local jResponse    := JsonObject():New()

    oRestService := RestService():New()
    oService := IpaasProxyService():New()
    
    jResponse["hasConfiguration"] := oService:hasConfiguration()
    oRestService:setSuccess(oRest, jResponse)

    FreeObj(oService)
    FreeObj(oRestService)
return .T.
