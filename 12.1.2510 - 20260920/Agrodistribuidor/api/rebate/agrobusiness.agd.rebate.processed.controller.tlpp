#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "totvs.ch"

#DEFINE PATH_URL_IDENT_ROTA '/api/agd/v1/rebate/processado/:identificador/:rota'
#DEFINE PATH_URL_IDENT_FILIAL '/api/agd/v1/rebate/processado/:identificador/:rota/:filial'
#DEFINE PATH_URL_IDENT_DATA '/api/agd/v1/rebate/processado/:identificador/:rota/:filial/:dataIni/:dataFim'

namespace totvs.protheus.agrobusiness.agd


/*/{Protheus.doc} RebateProcessedController
Controller de dados processados de Rebate
@type class
@version 12
@author lindembergson.pacheco
@since 17/08/2026
/*/
class RebateProcessedController
	public Data nPage     As Integer
	public Data nPageSize As Integer

	public method New() constructor

	@Get(PATH_URL_IDENT_ROTA)
	@Get(PATH_URL_IDENT_FILIAL)
	@Get(PATH_URL_IDENT_DATA)

	public method getDadosProcessados() as logical

endClass

/*/{Protheus.doc} New
Constructor
@type method
@version 12
@author lindembergson.pacheco
@since 17/08/2026
@return variant, self
/*/
method New() class RebateProcessedController
return self


/*/{Protheus.doc} getDadosProcessados
Retorna os registros processados
@type method
@version 12
@author lindembergson.pacheco
@since 17/08/2026
/*/
method getDadosProcessados() as logical class RebateProcessedController

	local oRestService	as object
	local jPath			as json
	local jIdent		as character
	local jRota			as character
	local jFilial		as character
	local jDataIni		as character
	local jDataFim		as character
	local oService		as object

	oRestService	:= RestService():New()

	jPath   	:= oRest:getPathParamsRequest()
	jIdent 		:= jPath['identificador']
	jRota 		:= jPath['rota']
	jFilial 	:= jPath['filial']
	jDataIni	:= StrTran(jPath['dataIni'], "-", "") 
	jDataFim 	:= StrTran(jPath['dataFim'], "-", "")

	oService := RebateProcessedService():New()
	oService:getDadosProcessados(jIdent, jRota, jFilial, jDataIni, jDataFim)

	oRestService:setAPIResponse(oRest, oService)

	FWFreeObj(oService)
	FWFreeObj(oRestService)

return .t.
