#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "totvs.ch"

#DEFINE PATH_URL_FILIAIS '/api/agd/v1/rebate/por-fabricante/:fabricanteID/sendDistributor/:filial'
#DEFINE PATH_URL_NOTAS_FISCAIS '/api/agd/v1/rebate/por-fabricante/:fabricanteID/sendInvoice/:filial/:data_ini/:data_fim'
#DEFINE PATH_URL_INVOICES '/api/agd/v1/rebate/notas-fiscais'

namespace totvs.protheus.agrobusiness.agd


/*/{Protheus.doc} RebateController
Controller de Receitas Agronômicas Geradas
@type class
@version 12
@author jean.schulze
@since 26/11/2025
/*/
class RebateController
	public Data nPage     As Integer
	public Data nPageSize As Integer

	public method New() constructor

	@Get(PATH_URL_FILIAIS)
	public method getDadosFiliais() as logical

	@Get(PATH_URL_NOTAS_FISCAIS)
	public method getNotasFiscais() as logical

	@Get(PATH_URL_INVOICES)
	public method getInvoices() as logical

endClass

/*/{Protheus.doc} New
Constructor
@type method
@version 12
@author jean.schulze
@since 26/11/2025
@return variant, self
/*/
method New() class RebateController
return self

/*/{Protheus.doc} RebateController::getDadosFiliais
Busca todas as filiais e seus respectivos dados para a integração de rebate
@type method
@version P12
@author claudineia.reinert
@since 16/07/2026
/*/
method getDadosFiliais() as logical class RebateController
	Local oRebateBranchesService As Object
	Local oRestService           As Object
	Local oJsonPath              As Object
	Local cFabricanteID          := ""
	Local cCodiRev               := ""

	oRestService := RestService():New()
	oJsonPath := oRest:getPathParamsRequest()

	If ValType(oJsonPath) == "J"
		cFabricanteID := IIf(oJsonPath:HasProperty("fabricanteID"),oJsonPath["fabricanteID"],"")
		cCodiRev      := IIf(oJsonPath:HasProperty("filial"),oJsonPath["filial"],"")
	EndIf

	oRebateBranchesService := RebateBranchesService():New()
	oRebateBranchesService:listBranchData(cCodiRev,cFabricanteID)

	oRestService:setAPIResponse(oRest,oRebateBranchesService)

	FWFreeObj(oRebateBranchesService)
	FWFreeObj(oRestService)
Return .T.

/*/{Protheus.doc} RebateController::getNotasFiscais
Busca as notas fiscais de saída e devoluções para a integração de rebate
@type method
@version P12
@author claudineia.reinert
@since 20/07/2026
@return logical, true
/*/
method getNotasFiscais() as logical class RebateController
	Local oRebateInvoiceService As Object
	Local oRestService          As Object
	Local oJsonPath             As Object
	Local jQueryParams          As Object

	oRestService := RestService():New()
	oRestService:getPageAndPageSize(@Self:nPage, @Self:nPageSize)

	oJsonPath    := oRest:getPathParamsRequest()
	jQueryParams := oRestService:getQueryParams()
	
	If ValType(oJsonPath) == "J"
		If oJsonPath:HasProperty("fabricanteID")
			jQueryParams["fabricanteID"] := AllTrim(oJsonPath["fabricanteID"])
		EndIf
		If oJsonPath:HasProperty("filial")
			jQueryParams["codi_rev"] := AllTrim(oJsonPath["filial"])
		EndIf
		If oJsonPath:HasProperty("data_ini")			
			jQueryParams["data_ini"] := StrTran(SubStr(AllTrim(oJsonPath["data_ini"]), 1, 10), "-", "")
		EndIf
		If oJsonPath:HasProperty("data_fim")
			jQueryParams["data_fim"] := StrTran(SubStr(AllTrim(oJsonPath["data_fim"]), 1, 10), "-", "")
		EndIf
	EndIf

	oRebateInvoiceService := RebateInvoiceService():New()
	oRebateInvoiceService:findDataInvoice(Self:nPage, Self:nPageSize, jQueryParams)

	oRestService:setAPIResponse(oRest, oRebateInvoiceService)

	FreeObj(oRebateInvoiceService)
	FreeObj(oRestService)
return .T.


/*/{Protheus.doc} getInvoices
Busca as notas fiscais de saída utilizadas na integração de rebate para Syngenta
@type method
@version P12
@author gilson.venturi
@since 04/08/2026
@return logical, true
/*/
method getInvoices() as logical class RebateController
	Local oRebateInvoiceService As Object
	Local oRestService   As Object

	oRestService := RestService():New()
	if !oRestService:isFilialInformado()
		FWFreeObj(oRestService)
		return .T.
	endif

	oRestService:getPageAndPageSize(@Self:nPage, @Self:nPageSize)

	oRebateInvoiceService := RebateInvoiceService():New()
	oRebateInvoiceService:findBillingInvoiceData(Self:nPage, Self:nPageSize, oRestService:getQueryParams())

	oRestService:setAPIResponse(oRest, oRebateInvoiceService)

	FreeObj(oRebateInvoiceService)
	FreeObj(oRestService)
return .T.
