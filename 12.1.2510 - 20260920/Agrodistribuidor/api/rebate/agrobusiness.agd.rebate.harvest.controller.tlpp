#include 'tlpp-core.th'
#include 'tlpp-rest.th'
#include 'totvs.ch'

#define PATH_URL '/api/agd/v1/rebate/safras'

namespace totvs.protheus.agrobusiness.agd 

/*/{Protheus.doc} RebateHarvestController
Controller de Safras
@type class
@version 12
@author ronery.filho
@since 31/07/2026
/*/
class RebateHarvestController
	public data nPage     as integer
	public data nPageSize as integer

	public method new()

	@Get(PATH_URL)
	public method listar() as logical
endClass

/*/{Protheus.doc} RebateHarvestController::new
Construtor
@type method
@version 12
@author ronery.filho
@since 31/07/2026
@return object, self
/*/
method new() class RebateHarvestController
return self

/*/{Protheus.doc} RebateHarvestController::listar
Lista Safras (Tabela NJU)
@type method
@version 12
@author ronery.filho
@since 31/07/2026
@return logical, Always true
/*/
method listar() as logical class RebateHarvestController
	local oSafraService as object
	local oRestService      as object
	local jsonQueryParam    as json

	oRestService  	:= RestService():New()	
	if !oRestService:isFilialInformado()
        FWFreeObj(oRestService)
        return .T.
    endif
	oSafraService 	:= RebateHarvestService():New()

	oRestService:getPageAndPageSize(@::nPage, @::nPageSize)
	jsonQueryParam := oRestService:getQueryParams()

	oSafraService:listar(::nPage, ::nPageSize, jsonQueryParam)

	oRestService:setAPIResponse(oRest, oSafraService)

	FreeObj(oSafraService)
	FreeObj(oRestService)
return .t.
