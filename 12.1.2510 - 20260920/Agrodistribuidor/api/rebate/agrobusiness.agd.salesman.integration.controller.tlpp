#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "totvs.ch"

#DEFINE SALESMAN_INTEGRATION_PATH '/api/agd/v1/rebate/vendedores'

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} SalesmanIntegrationController
Controller responsável por disponibilizar a API REST de consulta de pedidos de venda e compra destinados a integração de rebate.
@type class
@author beatriz.dantas
@since 17/07/2026
@version p12
/*/
class SalesmanIntegrationController
    public data nPage     as integer
    public data nPageSize as integer 

    public method new() constructor 

    @Get(SALESMAN_INTEGRATION_PATH)
    public method listSalesman() as logical
endClass

/*/{Protheus.doc} new
Construtor da classe SalesmanIntegrationController.
@author beatriz.datns
@since 20/07/2026
@version p12
@return Object, Instância da classe SalesmanIntegrationController
/*/
method new() class SalesmanIntegrationController
return self

/*/{Protheus.doc} listSalesman
Processa a requisição GET da API de consulta de vendedores para integração de rebate.
@author beatriz.dantas
@since 20/07/2026
@version p12
@return Logical, Retorna .T. quando a requisição é processada com sucesso
/*/
method listSalesman() as logical class SalesmanIntegrationController
	Local oSMService   as object //salesman (vendedores)
	Local oRestService as object
	Local lRet 		   := .t.
	Local jQueryParams := Nil

	oRestService := RestService():New()
	oSMService	 := SalesmanIntegrationService():New()
	
	If oRestService:isFilialInformado()
		oRestService:getPageAndPageSize(@Self:nPage, @Self:nPageSize)
		jQueryParams := oRestService:getQueryParams() 

		oSMService:listSalesman(Self:nPage, Self:nPageSize, jQueryParams)

		oRestService:setAPIResponse(oRest, oSMService)
	EndIf

	FreeObj(oSMService)
	FreeObj(oRestService)
return lRet
