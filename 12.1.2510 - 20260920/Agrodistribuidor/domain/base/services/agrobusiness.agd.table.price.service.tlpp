#include "totvs.ch"
#include 'tlpp-core.th'
#include 'fwmvcdef.ch'
#include 'agrobusiness.agd.table.price.service.ch'

namespace totvs.protheus.agrobusiness.agd  

/*/{Protheus.doc} TablePriceService
Classe de servico para gerar tabela de preço atraves do Modulo AgroDistribuidor. (Tabelas DA0/DA1 - Rotina OMSA010)
@type class
@version 12
@author jc.maldonado
@since 05/02/2025
/*/
class TablePriceService FROM UtilsService
	private data cIdTabelaPreco                	as character
	private data cIdProgramaParidade           	as character
	private data oModelOMSA010                 	as object

	public method new()
	public method createFromProgramaParidade() 	as logical
	public method getIdTabelaPreco()           	as character
	public method getProdutosPorTabelaPreco()
	public method getProdutoPorTabela()
	public method updateValidadeFinal()        	as logical
	public method validTabelaPreco()           	as logical
	public method hasMultiplasMoedas()		   	as logical
	public method hasProdutoDuplicado()        	as logical
	public method hasVigenciasDivergentes()    	as logical

	private method isValidProgramaParidade()   	as logical
	private method setModelOMSA010()           
	private method loadModelDA0MASTER()
	private method loadModelDA1DETAIL()
	private method commitModelOMSA010()        	as logical
	private method getErrorExecAuto()          	as character


endClass

/*/{Protheus.doc} TablePriceService::new
Construtor
@type method
@version 12
@author jc.maldonado
@since 05/02/2025
/*/
method new() class TablePriceService
	_Super:new()
return self

/*/{Protheus.doc} TablePriceService::createFromProgramaParidade
Cria a tabela de preço a partir do programa de paridade.
@type method
@version 12
@author jc.maldonado
@since 05/02/2025
@param cIdProgramaParidade, character, codigo programa paridade
@return logical, resultado da operacao
/*/
method createFromProgramaParidade(cIdProgramaParidade as character) as logical class TablePriceService
	local aArea 		   := fwGetArea() as array
	local cModuloAnterior  := cModulo     as character
	local nModuloAnterior  := nModulo     as numeric

	::cIdProgramaParidade := cIdProgramaParidade
	::cIdTabelaPreco	  := ''

	if ::isValidProgramaParidade()
		cModulo := 'FAT' //Executa a rotina pelo modulo de Faturamento.
		nModulo := 5

		::setModelOMSA010()

		if ::oModelOMSA010:VldData()
			::commitModelOMSA010()
		else
			::setError(::oModelOMSA010:GetErrorMessage()[MODEL_MSGERR_MESSAGE])
		endIf

		cModulo := cModuloAnterior
		nModulo := nModuloAnterior
	
		::oModelOMSA010:DeActivate()
		::oModelOMSA010:Destroy()
		::oModelOMSA010 := Nil
	else
		::setError(STR0001) //"Programa de paridade invalido."
	endif

	fwRestArea(aArea)
return ::isSuccess()

/*/{Protheus.doc} TablePriceService::isValidProgramaParidade
Avalia se o programa de paridade definido é válido.
@type method
@version 12
@author jc.maldonado
@since 05/02/2025
@return logical, resultado da validação.
/*/
method isValidProgramaParidade() as logical class TablePriceService
	local lIsValid as logical

	dbSelectArea('NEG')
	NEG->(dbSetOrder(retOrder('NEG_FILIAL+NEG_CODIGO') ))

	dbSelectArea('NEH')
	NEH->(dbSetOrder(retOrder('NEH_FILIAL+NEH_CODIGO+NEH_CODPRO')))

	lIsValid :=  NEG->(DBSeek(FWxFilial('NEG') + ::cIdProgramaParidade));
		.And. Empty(NEG->(NEG_TABPRP));
		.And. NEH->(DBSeek(FWxFilial('NEH') + ::cIdProgramaParidade))
return lIsValid

/*/{Protheus.doc} TablePriceService::setModelOMSA010
Prepara o modelo de dados da tabela de preço.
@type method
@version 12
@author jc.maldonado
@since 05/02/2025
/*/
method setModelOMSA010() class TablePriceService
	::oModelOMSA010 := FWLoadModel('OMSA010')
	::oModelOMSA010:SetOperation(MODEL_OPERATION_INSERT)
	::oModelOMSA010:Activate()

	::cIdTabelaPreco := ::oModelOMSA010:GetValue('DA0MASTER','DA0_CODTAB')

	::loadModelDA0MASTER()

	::loadModelDA1DETAIL()
return 

/*/{Protheus.doc} TablePriceService::loadModelDA0MASTER
Carrega os dados do modelo DA0MASTER.
@type method
@version 12
@author jc.maldonado
@since 05/02/2025
/*/
method loadModelDA0MASTER() class TablePriceService
	local oModelDA0	:= ::oModelOMSA010:GetModel('DA0MASTER') as object

	oModelDA0:SetValue('DA0_CODTAB', ::cIdTabelaPreco                  )
	oModelDA0:SetValue('DA0_DESCRI', AvKey(NEG->NEG_DESC, 'DA0_DESCRI'))
	oModelDA0:SetValue('DA0_DATDE' , NEG->NEG_DATA                     )
	oModelDA0:SetValue('DA0_HORADE', AvKey(TIME(), 'DA0_HORADE')       )
	oModelDA0:SetValue('DA0_DATATE', NEG->NEG_VENCTO                   )
	oModelDA0:SetValue('DA0_HORATE', '23:59'                           )
	oModelDA0:SetValue('DA0_TPHORA', '1'                               ) // '1'=Unico
	oModelDA0:SetValue('DA0_ATIVO' , '1'                               ) // '1'=Ativo
return

/*/{Protheus.doc} TablePriceService::loadModelDA1DETAIL
Carrega os dados do modelo DA1DETAIL.
@type method
@version 12
@author jc.maldonado
@since 05/02/2025
/*/
method loadModelDA1DETAIL() class TablePriceService
	local oModelGridDA1 := ::oModelOMSA010:GetModel('DA1DETAIL') as object
	local cFilialDA1    := fwXfilial('DA1')	                     as character
	local cEstado       := Space(2)                              as character
	local nQtdLot       := CriaVar('DA1_QTDLOT')                 as numeric

	while ! NEH->(Eof()) .and. NEH->NEH_CODIGO == ::cIdProgramaParidade
		oModelGridDA1:AddLine()

		oModelGridDA1:LoadValue('DA1_FILIAL', cFilialDA1     )
		oModelGridDA1:LoadValue('DA1_CODPRO', NEH->NEH_CODPRO)
		oModelGridDA1:LoadValue('DA1_PRCVEN', NEH->NEH_PRC   )
		oModelGridDA1:LoadValue('DA1_VLRDES', 0              )
		oModelGridDA1:LoadValue('DA1_PERDES', 0              )
		oModelGridDA1:LoadValue('DA1_ATIVO' , '1'            ) // '1'=Sim
		oModelGridDA1:LoadValue('DA1_ESTADO', cEstado        )
		oModelGridDA1:LoadValue('DA1_TPOPER', '4'            ) // '4'=Todos
		oModelGridDA1:LoadValue('DA1_QTDLOT', nQtdLot        )
		oModelGridDA1:LoadValue('DA1_MOEDA' , NEG->NEG_MOEDRT)
		oModelGridDA1:LoadValue('DA1_DATVIG', NEG->NEG_DATA  )

		NEH->(dbSkip())
	endDo
return

/*/{Protheus.doc} TablePriceService::commitModelOMSA010
Realiza o commit do modelo de dados.
@type method
@version 12
@author jc.maldonado
@since 05/02/2025
/*/
method commitModelOMSA010() class TablePriceService
	if ::oModelOMSA010:CommitData()
		::setSuccess(::cIdTabelaPreco)
	endif
return

/*/{Protheus.doc} TablePriceService::getIdTabelaPreco
Retorna o codigo da tabela de preço.
@type method
@version 12
@author jc.maldonado
@since 05/02/2025
@return character, código da tabela de preço
/*/
method getIdTabelaPreco() as character class TablePriceService
return ::cIdTabelaPreco

/*/{Protheus.doc} TablePriceService::getProdutosPorTabelaPreco
retorna os produtos por tabela de preço
@type method
@version p12
@author scheronlini.martins
@since 06/08/2025
@param cTabela, character, codigo da tabela
@param oJsonParams, object, json com parametros
/*/
method getProdutosPorTabelaPreco(cTabela, oJsonParams, cMoeda, nPage, nPageSize) class TablePriceService
	local oRepo       as object

	oRepo := TablePriceRepository():New()
	// Filtros obrigatórios
	oJsonParams["codigoTabela"] := cTabela
	oJsonParams["order"]        := "descricao"
	oJsonParams["moeda"]      := cMoeda
	oJsonParams["ativo"]      := "1" // Somente ativos

	oRepo:find(nPage, nPageSize, oJsonParams)

	self:setFullResponse(oRepo)

	oRepo:DeActivate()
	FreeObj(oRepo)

return NIL

/*/{Protheus.doc} TablePriceService::getProdutoPorTabela
retorna o produto por tabela de preço
@type method
@version p12 
@author scheronlini.martins
@since 06/08/2025
@param cTabela, character, codigo da tabela
@param cProduto, character, codigo do produto
/*/
method getProdutoPorTabela(cTabela as character, cProduto as character, cMoeda as character) class TablePriceService
	local oRepo
	local aFieldsId

	oRepo := TablePriceRepository():New()
	aFieldsId := {;
		{"DA0_CODTAB", cTabela},;
		{"DA1_CODPRO", cProduto},;
		{"DA1_MOEDA", cMoeda};
		}

	oRepo:findById(aFieldsId)

	self:setFullResponse(oRepo)

	oRepo:DeActivate()
	FreeObj(oRepo)

return NIL

/*/{Protheus.doc} updateValidadeFinal
Atualiza a data de validade final da tabela de preços,
a partir das informações da negociação.
@type  method
@version 1.0
@author rodrigo.nsoledade
@since  04/02/2026
@param  cCodTab, character, código da tabela de preços
@param  dNovaData, date, nova data de validade
@return logical, indica se a atualização foi bem sucedida
/*/
Method updateValidadeFinal(cCodTab, dNovaData) Class TablePriceService
    Local oRepo := TablePriceRepository():New()
    Local lRet  := .F.

    lRet := oRepo:updateValidadeFinal(cCodTab, dNovaData)

Return lRet

/*/{Protheus.doc} validTabelaPreco
Valida se tabela de preço esta ativa e data de validade é maior ou igual a data atual.
@type  method
@version 1.0
@author rodrigo.nsoledade
@since  27/02/2026
@param  cFilTab, character, filial da tabela de preços
@param  cCodTab, character, código da tabela de preços
@return logical, indica se a tabela de preço é válida
/*/
Method validTabelaPreco(cCodTab, cFilTab) Class TablePriceService
	Local lRet  := .T.
	Local cQuery := ""
	Local cAliQry := GetNextAlias()
	Local oStatement := nil
	Local cDataBase := DTOS(DDATABASE)

	Default cFilTab := FwXfilial("DA0")	

	cQuery := " SELECT  DA0_CODTAB "
	cQuery += " FROM " + RetSqlName("DA0") + " DA0 "
	cQuery += " WHERE DA0_FILIAL = ? "
	cQuery += " AND DA0.D_E_L_E_T_ = ' ' "
	cQuery += " AND DA0_CODTAB = ? "
	cQuery += " AND ( "
	cQuery += " 	DA0_ATIVO = '2' OR ( DA0_DATATE != '' AND DA0_DATATE < ? ) "
	cQuery += " ) "	
	CQuery := ChangeQuery(cQuery)

	oStatement := FWPreparedStatement():New()
	oStatement:SetQuery(cQuery)
	oStatement:SetString(1, cFilTab)
	oStatement:SetString(2, cCodTab)
	oStatement:SetString(3, cDataBase)
	cQuery := oStatement:GetFixQuery()
	dbUseArea(.T., "TOPCONN", TCGenQry(,,cQuery), cAliQry, .T., .T.)
    
    (cAliQry)->(DBGoTop())
	If (cAliQry)->(!EoF()) //é inativa ou vencida
		lRet := .F.
	Endif
	(cAliQry)->(DbCloseArea())
	FreeObj(oStatement)
	
Return lRet

/*/{Protheus.doc} TablePriceService::hasMultiplasMoedas
Verifica se na tabela de preço tem mais de uma moeda informada
@type method
@version P12
@author claudineia.reinert
@since 17/03/2026
@return Logical, .T. ou False
/*/
Method hasMultiplasMoedas(cFilTab as character, cCodTab as character) as logical Class TablePriceService
	Local lRet := .F.
	Local cQuery := ""
	Local cAliQry := GetNextAlias()

	cQuery := " SELECT  DA1_CODTAB, COUNT(DISTINCT DA1_MOEDA) AS QT_MOEDAS "
	cQuery += " FROM " + RetSqlName("DA1") + " DA1 "
	cQuery += " WHERE DA1_FILIAL = ? "
	cQuery += " AND DA1_CODTAB = ? "
	cQuery += " AND DA1.D_E_L_E_T_ = ' ' "
	cQuery += " GROUP BY DA1_CODTAB "
	cQuery += " HAVING COUNT(DISTINCT DA1_MOEDA) > 1 "
	CQuery := ChangeQuery(cQuery)

	oStatement := FWPreparedStatement():New()
	oStatement:SetQuery(cQuery)
	oStatement:SetString(1, cFilTab)
	oStatement:SetString(2, cCodTab)
	cQuery := oStatement:GetFixQuery()
	dbUseArea(.T., "TOPCONN", TCGenQry(,,cQuery), cAliQry, .T., .T.)
    
    (cAliQry)->(DBGoTop())
	If !(cAliQry)->(EoF())
		lRet := .T.
	Endif
	(cAliQry)->(DbCloseArea())

Return lRet

/*/{Protheus.doc} TablePriceService::hasProdutoDuplicado
Verifica se na tabela de preço tem produto duplicado, informado mais de uma vez
@type method
@version P12 
@author claudineia.reinert
@since 17/03/2026
@param cFilTab, character, Filial da tabela de preço
@param cCodTab, character, Código da tabela de preço
@return Logical, .T. ou False
/*/
Method hasProdutoDuplicado(cFilTab as character, cCodTab as character) as logical Class TablePriceService
	Local lRet := .F.
	Local cQuery := ""
	Local cAliQry := GetNextAlias()
	Local oStatement := nil

	cQuery := " SELECT  DA1_CODTAB, DA1_CODPRO "
	cQuery += " FROM " + RetSqlName("DA1") + " DA1 "
	cQuery += " WHERE DA1_FILIAL = ? "
	cQuery += " AND DA1_CODTAB = ? "
	cQuery += " AND DA1.D_E_L_E_T_ = ' ' "
	cQuery += " GROUP BY DA1_CODTAB, DA1_CODPRO "
	cQuery += " HAVING COUNT(DA1_CODPRO) > 1 "
	CQuery := ChangeQuery(cQuery)

	oStatement := FWPreparedStatement():New()
	oStatement:SetQuery(cQuery)
	oStatement:SetString(1, cFilTab)
	oStatement:SetString(2, cCodTab)
	cQuery := oStatement:GetFixQuery()
	dbUseArea(.T., "TOPCONN", TCGenQry(,,cQuery), cAliQry, .T., .T.)
	
	(cAliQry)->(DBGoTop())
	If !(cAliQry)->(EoF())
		lRet := .T.
	Endif
	(cAliQry)->(DbCloseArea())

return lRet

/*/{Protheus.doc} hasVigenciasDivergentes
Verifica se na tabela de preço tem mais de uma vigência informada
@type method
@version P12
@author claudineia.reinert
@since 17/03/2026
@return Logical, .T. ou False
/*/
Method hasVigenciasDivergentes(cFilTab as character, cCodTab as character) as logical Class TablePriceService
	Local lRet := .F.
	Local cQuery := ""
	Local cAliQry := GetNextAlias()

	cQuery := " SELECT  DA0_CODTAB, COUNT(DISTINCT(DA1_DATVIG)) QTD_DATVIG "
	cQuery += " FROM " + RetSqlName("DA0") + " DA0 "
	cQuery += " INNER JOIN " + RetSqlName("DA1") + " DA1 "
	cQuery += 	" ON DA1_FILIAL = DA0_FILIAL AND DA1_CODTAB = DA0_CODTAB AND DA1.D_E_L_E_T_ = ' '  "
	cQuery += " WHERE DA1_FILIAL = ? "
	cQuery += " AND DA0_CODTAB = ? "
	cQuery += " AND DA0.D_E_L_E_T_ = ' ' "
	cQuery += " AND (DA0_DATDE != DA1_DATVIG ) "
	cQuery += " GROUP BY DA0_CODTAB "
	CQuery := ChangeQuery(cQuery)

	oStatement := FWPreparedStatement():New()
	oStatement:SetQuery(cQuery)
	oStatement:SetString(1, cFilTab)
	oStatement:SetString(2, cCodTab)
	cQuery := oStatement:GetFixQuery()
	dbUseArea(.T., "TOPCONN", TCGenQry(,,cQuery), cAliQry, .T., .T.)
    
    (cAliQry)->(DBGoTop())
	If (cAliQry)->(!EoF()) 
		lRet := .T.
	Endif
	(cAliQry)->(DbCloseArea())

Return lRet
