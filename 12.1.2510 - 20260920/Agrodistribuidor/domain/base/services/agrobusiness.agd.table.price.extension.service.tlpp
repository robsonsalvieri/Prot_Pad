#include "totvs.ch"
#include 'tlpp-core.th'
#include 'fwmvcdef.ch'
#include 'agrobusiness.agd.table.price.extension.service.ch'

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} TablePriceExtensionService
Classe de serviço referente a extensão da tabela de preço do agro distribuidor
@type class
@version 12
@author claudineia.reinert
@since 17/03/2026
/*/
class TablePriceExtensionService FROM UtilsService
	public method new()
	public method validateTablePrice() as logical
	public method canUpdateModelTablePrice() as logical
	
endClass

/*/{Protheus.doc} New
Construtor da classe
@type method
@version  P12
@author claudineia.reinert
@since 17/03/2026
/*/
method new() class TablePriceExtensionService
    _Super:new()
return Self

/*/{Protheus.doc} validateTablePrice
Validação da opção de menu Agrodistribuidor na tabela de preço.
Valida de se abre a tela de complemento da tabela de preço do agro distribuidor (NE8) 
@type method
@version  P12
@author claudineia.reinert
@since 17/03/2026
@param cFilTab, character, Filial da tabela de preço
@param cCodTab, character, Código da tabela de preço
@return logical, Indica se a tabela de preço é válida
/*/
method validateTablePrice(cFilTab as character, cCodTab as character) as logical class TablePriceExtensionService
	Local lRet := .T.
	Local oServTabPreco := TablePriceService():New()

	If !oServTabPreco:validTabelaPreco(cCodTab, cFilTab)//inativo
			Self:setError( STR0004 , 422 ) //"Tabela de preço inativa/vencida."
			Return .F.
	ElseIf oServTabPreco:hasMultiplasMoedas(cFilTab, cCodTab)
		//"A tabela de preços possui mais de uma moeda. Não é permitido utilizar moedas distintas na integração com o módulo TOTVS Agro Distribuidor (SIGAAGD)."//"Ajustar a tabela de preço.") 
		Self:setError(STR0001, 422, STR0002) 
		lRet := .F.
	ElseIf oServTabPreco:hasProdutoDuplicado(cFilTab, cCodTab)
		//"Tabela de preço com produto duplicado. Não é permitido utilizar tabela de preço com produto duplicado na integração com o módulo TOTVS Agro Distribuidor(SIGAAGD)." //"Ajustar a tabela de preço.") 
		Self:setError(STR0003, 422, STR0002) 
		lRet := .F.
	ElseIf oServTabPreco:hasVigenciasDivergentes(cFilTab, cCodTab)
		//"Tabela de preço com datas de vigencias divergentes. Não é permitido utilizar itens com datas de vigências divergentes na tabela de preço na integração com o módulo TOTVS Agro Distribuidor(SIGAAGD)." //"Ajustar a tabela de preço.") 
		Self:setError(STR0005,422,STR0002) 
		lRet := .F.
	EndIf
	FreeObj(oServTabPreco)

return lRet

/*/{Protheus.doc} canUpdateModelTablePrice
Valida se pode alterar a tabela de preço quando há vinculo com o agro distribuidor(NE8)
Valida todo o modelo de dados da rotina de tabela de preço (DA0/DA1) OMSA010, para verificar se atende as regras de negócio da integração com o agro distribuidor
@type method
@version 12
@author claudineia.reinert
@since 27/03/2026
@param oModel, object, modelo de dados da rotina de tabela de preço(DA0/DA1), OMSA010
@return logical, resultado da validação .T. para sucesso ou .F. para falha
/*/
Method canUpdateModelTablePrice(oModel) as logical class TablePriceExtensionService
	Local lRet 			:= .T.
	Local nX    	 	:= 0
	Local nLinha	 	:= 0
	Local oModelDA0	 	:= nil
	Local oModelDA1	 	:= nil
	Local dDataDe  		:= CTOD("//")
	Local aContrItem 	:= {} //array para controle de validação de item duplicado na tabela de preço
	Local nMoeda 		:= 0
	Local nPos 			:= 0
	Local aAreaDA1     	:= NIL
	
	If ( ValType(oModel) == "O" .and. oModel:IsActive() .and. oModel:GetOperation() == MODEL_OPERATION_UPDATE )
		If oModel:GetId() == "OMSA010"
			DBSelectArea("NE8")
			NE8->(DBSetOrder(1))
			If NE8->(MsSeek( FWxFilial("NE8") + oModel:GetModel("DA0MASTER"):GetValue("DA0_CODTAB"))) //tem vinculo NE8
				oModelDA0	 := oModel:GetModel("DA0MASTER")
				oModelDA1	 := oModel:GetModel("DA1DETAIL")
				dDataDe := oModelDA0:GetValue("DA0_DATDE")

				nLinha := oModelDA1:GetLine()
				For nX := 1 to oModelDA1:Length() //percorre linha a linha validando produto, moeda e vigencia
					oModelDA1:GoLine( nX )
					IF !oModelDA1:IsDeleted()	
						nMoeda := IIf(nMoeda = 0, oModelDA1:GetValue("DA1_MOEDA"), nMoeda) //guarda a moeda da primeira linha para comparar com as demais linhas
						//valida vigencia			
						If oModelDA1:GetValue("DA1_DATVIG") != dDataDe
							lRet := .F.
							Self:setError(STR0005,422,STR0002 + STR0006 + oModelDA1:GetValue("DA1_ITEM") ) 
							exit		
						EndIf
						//valida moeda
						If nMoeda != oModelDA1:GetValue("DA1_MOEDA")
							lRet := .F.
							Self:setError(STR0001,422,STR0002 + STR0006 + oModelDA1:GetValue("DA1_ITEM") ) 
							exit
						EndIf
						//valida produto
						nPos := AScan(aContrItem, oModelDA1:GetValue("DA1_CODPRO"))
						If nPos > 0
							lRet := .F.
							Self:setError(STR0003,422,STR0002 + STR0006 + oModelDA1:GetValue("DA1_ITEM") )
							exit
						EndIf
						AAdd(aContrItem, oModelDA1:GetValue("DA1_CODPRO"))
					endif
				Next nX
				oModelDA1:GoLine( nLinha )
			EndIf
		ElseIf oModel:GetId() == "OMSA010A" 
			//OMSA010A, faz alteração das tabelas de preço de um determinado produto, permitindo alterar ou incluir um registro para o produto, sendo DA0 o produto e DA1 por tabelas de preço
			oModelDA0	 := oModel:GetModel("DA0MASTER") //dados do produto
			oModelDA1	 := oModel:GetModel("DA1DETAIL") //dados da tabela de preço do produto
			dDataDe := nil

			DBSelectArea("NE8")
			NE8->(DBSetOrder(1))

			aAreaDA1 := DA1->(GetArea())

			DBSelectArea("DA1")
			DA1->(DBSetOrder(1))		
				
			nLinha := oModelDA1:GetLine()
			For nX := 1 to oModelDA1:Length() //percorre linha a linha
				oModelDA1:GoLine( nX )
				IF !oModelDA1:IsDeleted() 					
					//valida duplicidade do produto na tabela de preço, para o mesmo código de tabela de preço, não pode ter mais de um registro com o mesmo produto
					nPos := AScan(aContrItem, oModelDA1:GetValue("DA1_CODTAB"))
					If nPos > 0
						lRet := .F.
						Self:setError(STR0003,422,STR0002 + "(" + oModelDA1:GetValue("DA1_CODTAB") + ")" + " - Item: " + oModelDA1:GetValue("DA1_ITEM") )
						exit
					ElseIf NE8->(MsSeek( FWxFilial("NE8") + oModelDA1:GetValue("DA1_CODTAB"))) //tem vinculo NE8 - agrodistribuidor
						AAdd(aContrItem, oModelDA1:GetValue("DA1_CODTAB")) //adiciona para validação de duplicidade produto
						If DA1->(MsSeek( FWxFilial("DA1") + oModelDA1:GetValue("DA1_CODTAB") )) //posiciona no registro dos itens da tabela de preço		
							While (DA1->(!Eof())) .AND. DA1->DA1_CODTAB == oModelDA1:GetValue("DA1_CODTAB")
								IF DA1->DA1_CODPRO != oModelDA1:GetValue("DA1_CODPRO") .OR. DA1->DA1_ITEM != oModelDA1:GetValue("DA1_ITEM")
								//se tem registro com outro produto, valida vigencia e moeda, caso contrário, é a mesma linha do produto, pode alterar sem validar vigencia e moeda
									If oModelDA1:GetValue("DA1_DATVIG") != DA1->DA1_DATVIG //valida vigencia
										lRet := .F.
										Self:setError(STR0005,422,STR0002 + "(" + oModelDA1:GetValue("DA1_CODTAB") + ")" + STR0006 + oModelDA1:GetValue("DA1_ITEM") )
									ElseIf oModelDA1:GetValue("DA1_MOEDA") != DA1->DA1_MOEDA //valida moeda
										lRet := .F.
										Self:setError(STR0001,422,STR0002 + "(" + oModelDA1:GetValue("DA1_CODTAB") + ")" + STR0006 + oModelDA1:GetValue("DA1_ITEM") ) 
									EndIf		
									Exit //Sai do WHILE, pois já encontrou um registro com produto diferente, não precisa validar os demais registros da tabela de preço
								EndIf
								DA1->(DBSkip())
							EndDo	
							If !lRet
								exit //sai do laço FOR
							EndIf				
						EndIf				
					EndIf
				EndIf
			Next nX
			oModelDA1:GoLine( nLinha )
			RestArea(aAreaDA1)
		EndIf
	EndIf

return lRet
