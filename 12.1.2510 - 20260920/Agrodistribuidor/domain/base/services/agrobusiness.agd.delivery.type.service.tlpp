/*/{Protheus.doc} DeliveryTypeService::getDeliveryType
Listagem dos registros da tabela
@type method
@version 12
@author carlos.augusto
@since 11/05/2026
@param cFilialExt, character, filial externa para filtro
@param cClienteExt, character, cliente externo para filtro
/*/
method getDeliveryType(cFilialExt as character, cClienteExt as character) class DeliveryTypeService
	Local oDeliveryTypeRepo as object

	oDeliveryTypeRepo := DeliveryTypeRepository():New()
	oDeliveryTypeRepo:getDeliveryType(cFilialExt, cClienteExt)

	::setFullResponse(oDeliveryTypeRepo)

	FreeObj(oDeliveryTypeRepo)
return

