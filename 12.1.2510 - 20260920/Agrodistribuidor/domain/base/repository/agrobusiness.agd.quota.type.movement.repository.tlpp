#include 'totvs.ch'
#include 'tlpp-core.th'


namespace totvs.protheus.agrobusiness.agd  

/*/{Protheus.doc} QuotaTypeMovementRepository
Repositorio de Tipo de Movimento de Quota
@type class
@version 12
@author carlos.augusto
@since 11/05/2026
/*/
class QuotaTypeMovementRepository from UtilsRepository
	public Data cChaveIDRepository As Object //chave unica para updates

	public method new()
	public method getFields() as array
	public method getFilterById()
	public method getParametrosFinanceiro(cCodigo as character) as json
	public method getTipoMovimentoAdicional() as character
	public method isGeraFinanceiro() as logical
	public method isGeraFinanceiroPagar() as logical
	public method isGeraFinanceiroReceber() as logical
	public method isGeraMovimentoAdicional() as logical
	public method isBaixaAutomatica() as logical
	public method isAtivadorCooperado() as logical
	public method isPendentePagamento() as logical
endclass

/*/{Protheus.doc} new
Construtor
@type method
@version 12
@author carlos.augusto
@since 11/05/2026
@return object, self
/*/
method new(cCodigoTipo as character) class QuotaTypeMovementRepository
	Self:cChaveIDRepository := cCodigoTipo
	_Super:New('NF5', Self:getFields())
return self

/*/{Protheus.doc} getFields
Obtém os campos do repositório
@type method
@version 12
@author jc.maldonado
@since 15/01/2026
@return array, {{cCampoJson, cCampoProtheus, cTipoCampo, lMostraCampoConsulta}, ...}
/*/
method getFields() as array class QuotaTypeMovementRepository
	local aFields as array

	aFields := {;
		{'filial'      				, 'NF5_FILIAL' , 'C', .F.},;
		{'codigo'      				, 'NF5_CODIGO' , 'C', .T.},;
		{'tipo'        				, 'NF5_TIPO'   , 'C', .T.},;
		{'descricao'   				, 'NF5_DESCRI' , 'C', .T.},;
		{'acao'        				, 'NF5_OPEXEC' , 'C', .T.},;
		{'geraMovimentoAdicional'   , 'NF5_GMOVAD' , 'C', .T.},;
		{'codigoMovimentoAdicional' , 'NF5_CMOVAD' , 'C', .T.},;
		{'geraFinanceiro'           , 'NF5_GERFIN' , 'C', .T.},;
		{'prefixo'                  , 'NF5_PREFIX' , 'C', .T.},;
		{'tipoTitulo'               , 'NF5_TIPTIT' , 'C', .T.},;
		{'natureza'                 , 'NF5_NATURE' , 'C', .T.},;
		{'fluxoCaixa'               , 'NF5_FLUXOC' , 'C', .T.},;
		{'condicaoPagamento'        , 'NF5_CONDPG' , 'C', .T.},;
		{'baixaAutomatica'          , 'NF5_BAIXAU' , 'C', .T.}}
return aFields


/*/{Protheus.doc} getFilterById
Obtem Filtro para Get By ID
@type method
@version 12
@author carlos.augusto
@since 08/07/2026
@param cFilTpMov, character, filial do tipo de movimento
@param cCodTpMov, character, código do tipo de movimento
@return array, lista de filtro
/*/
Method getFilterById(cFilTpMov as character, cCodTpMov as character) Class QuotaTypeMovementRepository
	Local aFilterId := {}

	AAdd(aFilterId, {'NF5_FILIAL', cFilTpMov})
	AAdd(aFilterId, {'NF5_CODIGO', cCodTpMov})

return aFilterId

/*/{Protheus.doc} getParametrosFinanceiro
Obtém o filtro pelo ID
@type method
@version 12
@author jean.schulze
@since 7/8/2026
@param cCodigo, character, codigo do tipo de movimento
@return array, filtro pelo ID
/*/
Method getParametrosFinanceiro(cCodigo as character) as Json Class QuotaTypeMovementRepository
	Local aParametros := {}	
	
	dbselectArea("NF5")
	if NF5->(dbSeek(Self:cChaveIDRepository))

		aParametros :={;
			'geraMovimentoAdicional'   : NF5->NF5_GMOVAD,;
			'codigoMovimentoAdicional' : NF5->NF5_CMOVAD,;
			'prefixo'                  : NF5->NF5_PREFIX,;
			'tipoTitulo'               : NF5->NF5_TIPTIT,;
			'natureza'                 : NF5->NF5_NATURE,;
			'fluxoCaixa'               : iif(NF5->NF5_FLUXOC == "1", "S", "N"),;
			'tipoGeracaoFinanceiro'    : NF5->NF5_GERFIN,;
			'baixaAutomatica'          : NF5->NF5_BAIXAU,;
			'motivoBaixa'              : NF5->NF5_MOTBXA,;
			'condicaoPagamento'        : NF5->NF5_CONDPG;
		}

	endif
return aParametros

/*/{Protheus.doc} isGeraFinanceiro
Retorna se gera financeiro
@type method
@version 12
@author jean.schulze
@since 7/9/2026
@return logical, true se gera financeiro, false caso contrario
/*/
Method isGeraFinanceiro() as logical Class QuotaTypeMovementRepository
return !EMPTY(Self:cChaveIDRepository) .and. POSICIONE("NF5", 1, Self:cChaveIDRepository,"NF5_GERFIN") $ "2|3"

/*/{Protheus.doc} isGeraFinanceiroPagar
Retorna se gera financeiro a pagar
@type method
@version 12
@author jean.schulze
@since 7/9/2026
@return logical, true se gera financeiro a pagar, false caso contrario
/*/
Method isGeraFinanceiroPagar() as logical Class QuotaTypeMovementRepository
return !EMPTY(Self:cChaveIDRepository) .and. POSICIONE("NF5", 1, Self:cChaveIDRepository,"NF5_GERFIN") == "2"

/*/{Protheus.doc} isGeraFinanceiroReceber
Retorna se gera financeiro a receber
@type method
@version 12
@author jean.schulze
@since 7/9/2026
@return logical, true se gera financeiro a receber, false caso contrario
/*/
Method isGeraFinanceiroReceber() as logical Class QuotaTypeMovementRepository
return !EMPTY(Self:cChaveIDRepository) .and. POSICIONE("NF5", 1, Self:cChaveIDRepository,"NF5_GERFIN") == "3"

/*/{Protheus.doc} isGeraMovimentoAdicional
Retorna se gera movimento adicional
@type method
@version 12
@author jean.schulze
@since 7/20/2026
@return logical, true se gera movimento adicional, false caso contrario
/*/
Method isGeraMovimentoAdicional() as logical Class QuotaTypeMovementRepository
return !EMPTY(Self:cChaveIDRepository) .and. !EMPTY(POSICIONE("NF5", 1, Self:cChaveIDRepository,"NF5_CMOVAD")) .and. POSICIONE("NF5", 1, Self:cChaveIDRepository,"NF5_TIPO") <> "4" //4-Transferencia Saída

/*/{Protheus.doc} getTipoMovimentoAdicional
Obtém o código do movimento adicional
@type method
@version 12
@author jean.schulze
@since 7/23/2026
@return character, código do movimento adicional
/*/
Method getTipoMovimentoAdicional() as character Class QuotaTypeMovementRepository
return POSICIONE("NF5", 1, Self:cChaveIDRepository,"NF5_CMOVAD") 

/*/{Protheus.doc} isBaixaAutomatica
Retorna se  baixa é automática
@type method
@version 12
@author jean.schulze
@since 7/23/2026
@return logical, true se a baixa é automática, false caso contrario
/*/
Method isBaixaAutomatica() as logical Class QuotaTypeMovementRepository
return !EMPTY(Self:cChaveIDRepository) .and. POSICIONE("NF5", 1, Self:cChaveIDRepository,"NF5_BAIXAU") == "1"

/*/{Protheus.doc} isAtivadorCooperado
Retorna se o movimento é ativador de cooperado
@type method
@version 12
@author jean.schulze
@since 8/5/2026
@return logical, true se o movimento é ativador de cooperado, false caso contrario
/*/
Method isAtivadorCooperado() as logical Class QuotaTypeMovementRepository
return !EMPTY(Self:cChaveIDRepository) .and. POSICIONE("NF5", 1, Self:cChaveIDRepository,"NF5_TIPO") $ "1235" //1-SaldoERP, 2-Subscrição, 3-Integralizacao, 5-Transferencia Entrada

/*/{Protheus.doc} QuotaTypeMovementRepository::isPendentePagamento
Verifica se o movimento ira gerar um status de pendencia de pagamento 
quando 2=Subscrição ou 3=Integralização
@type method
@version 12
@author jc.maldonado
@since 01/09/2026
@return logical, verdadeiro/falso
/*/
Method isPendentePagamento() Class QuotaTypeMovementRepository
	If ! Empty(Self:cChaveIDRepository);
			.And. Self:isGeraFinanceiroReceber() ;
			.And. ! Self:isBaixaAutomatica() ;
			.And. POSICIONE("NF5", 1, Self:cChaveIDRepository, "NF5_TIPO") $ '2|3' // 2=Subscrição, 3=Integralização
		Return .T.
	EndIf
Return .F.
