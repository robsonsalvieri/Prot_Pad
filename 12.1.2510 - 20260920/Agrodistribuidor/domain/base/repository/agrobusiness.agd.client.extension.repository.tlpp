/*/{Protheus.doc} ClientExtensionRepository::getNextCoopMatricula
Retorna o proximo código de matrícula disponível para o cooperado
@type method
@version 12
@author jc.maldonado
@since 20/07/2026
@return character, Novo código disponível para Matrícula do Cooperado
/*/
method getNextCoopMatricula() as character class ClientExtensionRepository
	local nFieldSize       as numeric
	local cQuery           as character
	local aBindParam := {} as array
	local cNewCode         as character

	nFieldSize := FWSX3Util():GetFieldStruct('NEP_MATRIC')[3 /*nSize*/]

	cQuery += " SELECT"
	cQuery += " COALESCE(MAX(NEP_MATRIC), ?) AS NEP_MATRIC" ; aAdd(aBindParam, Space(nFieldSize))
	cQuery += " FROM "
	cQuery += retSQLname("NEP")
	cQuery += " WHERE"
	cQuery += "	 NEP_FILIAL = ?" ; aAdd(aBindParam, FWXFilial("NEP"))
	cQuery += "	 AND D_E_L_E_T_ = ' '"
	cQuery := ChangeQuery(cQuery)

	cNewCode := soma1(MPSysExecScalar(cQuery, 'NEP_MATRIC', aBindParam))
return cNewCode
