/*/
class ClientExtensionRepository from UtilsRepository
	public data cChaveIDRepository as character

	public method new()
	public method modelInsert()
	public method getNextCoopMatricula() as character

	private method getFields() as array
endclass

/*/{Protheus.doc} ClientExtensionRepository::new
Construtor
@type method
@version 12
@author jc.maldonado
@since 03/06/2026
@param cChaveIDRepository, character, 
@return object, Instância da classe
/*/
method new(cChaveIDRepository as character) class ClientExtensionRepository
	::cChaveIDRepository := cChaveIDRepository

	_Super:New('NEP', ::getFields(), nil, nil, 'AGDP060')
return Self

/*/{Protheus.doc} ClientExtensionRepository::getFields
Obtem os campos do repositório
@type method
@version 12
@author jc.maldonado
@since 03/06/2026
@return array, {{cCampoJson, cCampoProtheus, cTipoCampo, lMostraCampoConsulta}, ...}
/*/
method getFields() as array class ClientExtensionRepository
	local aFields as array

	aFields := {;
		{'filial'            , 'NEP_FILIAL', 'C', .F.},;
		{'codigoCliente'     , 'NEP_CODCLI', 'C', .T.},;
		{'lojaCliente'       , 'NEP_LOJCLI', 'C', .T.},;
		{'propriedadeRural'  , 'NEP_PRORUR', 'C', .T.},;
		{'car'               , 'NEP_CAR'   , 'C', .T.},;
		{'area'              , 'NEP_AREA'  , 'N', .T.},;
		{'codigoProprietario', 'NEP_CLIPRO', 'C', .T.},;
		{'lojaProprietario'  , 'NEP_LOJPRO', 'C', .T.},;
		{'latitude'          , 'NEP_LATIT' , 'C', .T.},;
		{'longitude'         , 'NEP_LONGI' , 'C', .T.},;
		{'altitude'          , 'NEP_ALTITU', 'C', .T.},;
		{'destino'           , 'NEP_DESTIN', 'C', .T.},;
		{'codigoFornecedor'	 , 'NEP_CODFOR', 'C', .T.},;
		{'lojaFornecedor'	 , 'NEP_LOJFOR', 'C', .T.};
		}
return aFields

