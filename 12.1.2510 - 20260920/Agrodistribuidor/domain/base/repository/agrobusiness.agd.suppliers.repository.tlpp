/*/{Protheus.doc} SuppliersRepository::getLastCode
Retorna o proximo código (A2_COD, A2_LOJA) disponível
@type method
@version 12
@author jc.maldonado
@since 22/06/2026
@return array, {cCodigo, cLoja}
/*/
method getNewCode() as array class SuppliersRepository
	local cQuery           as character
	local aBindParam := {} as array
	local cDefaultCode     as character
	local cNewStoreCode    as character
	local cNewCode         as character

	cDefaultCode  := Space(FWSX3Util():GetFieldStruct('A2_COD')[3 /*nSize*/])

	cQuery := " SELECT"
	cQuery += "	 COALESCE(MAX(A2_COD), ?) A2_COD" ; aAdd(aBindParam, cDefaultCode)
	cQuery += " FROM "
	cQuery += retSQLname("SA2")
	cQuery += " WHERE"
	cQuery += "	 A2_FILIAL = ?" ; aAdd(aBindParam, FWXFilial("SA2"))
	cQuery += "	 AND D_E_L_E_T_ = ' '"
	cQuery := ChangeQuery(cQuery)

	cNewCode      := Soma1(MPSysExecScalar(cQuery, 'A2_COD', aBindParam))
	cNewStoreCode := Soma1(Space(FWSX3Util():GetFieldStruct('A2_LOJA')[3 /*nSize*/]))
return {cNewCode, cNewStoreCode}
