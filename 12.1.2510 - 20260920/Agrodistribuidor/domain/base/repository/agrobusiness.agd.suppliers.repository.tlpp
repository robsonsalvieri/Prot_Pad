@since 22/06/2026
@return array, {{cCampoJson, cCampoProtheus, cTipoCampo, lMostraCampoConsulta}, ...}
/*/
method getFields() as array class SuppliersRepository
	local aFields as array

	aFields := {;
		{'filial'              ,'A2_FILIAL' , 'C', .F.},;
		{'codigoFornecedor'    ,'A2_COD'    , 'C', .T.},;
		{'codigoLojaFornecedor','A2_LOJA'   , 'C', .T.},;
		{'nome'                ,'A2_NOME'   , 'C', .T.},;
		{'nomeReduzido'        ,'A2_NREDUZ' , 'C', .T.},;
		{'endereco'            ,'A2_END'    , 'C', .T.},;
		{'bairro'              ,'A2_BAIRRO' , 'C', .T.},;
		{'estado'              ,'A2_EST'    , 'C', .T.},;
		{'codigoMunicipio'     ,'A2_COD_MUN', 'C', .T.},;
		{'descricaoMunicipio'  ,'A2_MUN'    , 'C', .T.},;
		{'cep'                 ,'A2_CEP'    , 'C', .T.},;
		{'tipo'                ,'A2_TIPO'   , 'C', .T.},;
		{'cgc'                 ,'A2_CGC'    , 'C', .T.},;
		{'pessoaFisica'        ,'A2_PFISICA', 'C', .T.},;
		{'inscricao'           ,'A2_INSCR'  , 'C', .T.},;
		{'ddd'                 ,'A2_DDD'    , 'C', .T.},;
		{'telefone'            ,'A2_TEL'    , 'C', .T.},;
		{'email'               ,'A2_EMAIL'  , 'C', .T.},;
		{'pais'                ,'A2_PAIS'   , 'C', .T.},;
		{'cliente'             ,'A2_CLIENTE', 'C', .T.},;
		{'lojaCliente'         ,'A2_LOJCLI'	, 'C', .T.};
		}
return aFields

