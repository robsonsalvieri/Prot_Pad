#include 'tlpp-core.th'
#include 'totvs.ch'

namespace totvs.protheus.agrobusiness.agd  

/*/{Protheus.doc} TBDCConfigurationRepository
Repositório de configuracao automaticas TBDC (Tabela NF9)
@type class
@version 12
@author lindembergson.pacheco
@since 01/09/2026
/*/
class TBDCConfigurationRepository from UtilsRepository
	public method new()

	private method getFields() as array
	public Method getFilterById()
endclass

/*/{Protheus.doc} TBDCConfigurationRepository::new
Construtor
@type method
@version 12
@author lindembergson.pacheco
@since 01/09/2026
@return object, Instância da classe
/*/
method new() class TBDCConfigurationRepository
	_Super:New('NF9', self:getFields())
return self

/*/{Protheus.doc} TBDCConfigurationRepository::getFields
Obtem os campos do repositório
@type method
@version 12
@author lindembergson.pacheco
@since 01/09/2026
@return array, {{cCampoJson, cCampoProtheus, cTipoCampo, lMostraCampoConsulta}, ...}
/*/
method getFields() as array class TBDCConfigurationRepository
	local aFields as array

	aFields := {;
		{'filial'			,'NF9_FILIAL', 'C', .F.},;
        {'codigoRegra'		,'NF9_CODREG', 'C', .T.},;
		{'descricao'		,'NF9_DESCRI', 'C', .T.},;
        {'tipoVenda'		,'NF9_TPVEND', 'C', .T.},;
		{'opInterestadual'	,'NF9_OPINTE', 'C', .T.},;
		{'codigoProduto'	,'NF9_CMDTY ', 'C', .T.},;
		{'tipoEntrada'		,'NF9_TESENT', 'C', .T.},;
		{'opEntrada'		,'NF9_OPENT ', 'C', .T.},;
		{'tabela'			,'NF9_TABELA', 'C', .T.},;
		{'natureza'			,'NF9_NATURE', 'C', .T.},;
		{'tipoSaida'		,'NF9_TESSAI', 'C', .T.},;
		{'opSaida'			,'NF9_OPSAI ', 'C', .T.};
		}
return aFields

/*/{Protheus.doc} getFilterById
Obtem Filtro para Get By ID
@type method
@version 12
@author lindembergson.pacheco
@since 01/09/2026
@param codigoRegra, character, codigo da configuracao
@return array, lista de filtro
/*/
Method getFilterById( codigoRegra as character) Class TBDCConfigurationRepository
	Local aFilterId := {}

	AAdd(aFilterId, {'NF9_CODREG', codigoRegra})

return aFilterId
