#include 'totvs.ch'
#include 'tlpp-core.th'
#include 'fwmvcdef.ch'
#include 'agrobusiness.agd.history.repository.ch'

namespace totvs.protheus.agrobusiness.agd  

/*/{Protheus.doc} HistoryRepository
Repositorio de Historicos (Tabela NE0)
@type class
@version 12
@author jc.maldonado
@since 20/05/2025
/*/
class HistoryRepository from UtilsRepository
	public method new()
	public method save() as logical

	private method getFields() as array
endclass

/*/{Protheus.doc} HistoryRepository::New
Construtor
@type method
@version 12
@author jc.maldonado
@since 20/05/2025
@return object, self
/*/
method new() class HistoryRepository
	_Super:new('NE0', ::getFields(), nil, nil, 'AGDXHIST')
return self

/*/{Protheus.doc} HistoryRepository::getFields
Retorna os campos que serao utilizados no AddMapFields da classe FWAdapterBaseV2
@type method
@version 12
@author jc.maldonado
@since 20/05/2025
@return array, {{cCampoJson, cCampoTabela, cTipoCampo, lJsonField|lFixed}, ...}
/*/
method getFields() as array class HistoryRepository
	local aFields as array

	aFields := {;
		{'filial'     , 'NE0_FILIAL', 'C', .T.},;
		{'tabela'     , 'NE0_TABLE' , 'C', .T.},;
		{'chave'      , 'NE0_CHAVE' , 'C', .T.},;
		{'acaoRotina' , 'NE0_ACAO'  , 'C', .T.},;
		{'observacao' , 'NE0_MSGOBS', 'M', .T.},;
		{'data'       , 'NE0_DATA'  , 'D', .T.},;
		{'hora'       , 'NE0_HORA'  , 'C', .T.},;
		{'nomeUsuario', 'NE0_NOMUSU', 'C', .T.};
		}
return aFields

/*/{Protheus.doc} HistoryRepository::salvarHistorico
Grava o histórico na tabela NE0
@type method
@version 12
@author jc.maldonado
@since 05/06/2025
@param cTabela, character, Alias da tabela
@param cChave, character, chave do registro
@param nOperation, numeric, Operação a ser registrada (MODEL_OPERATION_INSERT, MODEL_OPERATION_UPDATE, MODEL_OPERATION_DELETE)
@param cCodUsuario, character, (Opcional) código do usuário que está realizando a operação
@param cMsgMemo, character, (Opcional) mensagem de observação
@param cAcaoCustom, character, (Opcional) Ação customizada para o log
@return logical, resultado da operação
/*/
method save(cTabela as character, cChave as character, nOperation as integer, cCodUsuario as character, cMsgMemo as character, cAcaoCustom as character, nSeq as numeric) as logical class HistoryRepository
	local cAcao       as character
	local aFieldValue as array
	local cTime as character

	default cCodUsuario := RetCodUsr()
	default cMsgMemo    := criavar("NE0_MSGOBS")
	default cAcaoCustom := ""
	default nSeq := 0

	if ! ExisteSX2(cTabela)
		::setError(STR0001, 404)
		return .F.
	endif

	if empty(cChave)
		::setError(STR0002, 404)
		return .f.
	endif

	if nOperation == MODEL_OPERATION_INSERT
		cAcao := STR0003
	elseif nOperation == MODEL_OPERATION_UPDATE
		cAcao := STR0004
	elseif nOperation == MODEL_OPERATION_DELETE
		cAcao := STR0005
	else
		::setError(STR0006, 404)
		return .f.
	endif

	if !empty(cAcaoCustom)
		cAcao := cAcaoCustom
	endif

	if empty(cCodUsuario);
			.Or. ! UsrExist(cCodUsuario)
		::setError(STR0007, 404)
		return .f.
	endif

	aFieldValue := {}
	cTime := Time()
	If nSeq > 0
		cTime := substr(cTime, 1, len(cTime)-2) + StrZero(nSeq, 2)
	Endif
	
	aAdd(aFieldValue, {"NE0_TABLE" , cTabela                })
	aAdd(aFieldValue, {"NE0_CHAVE" , cChave                 })
	aAdd(aFieldValue, {"NE0_ACAO"  , cAcao                  })
	aAdd(aFieldValue, {"NE0_DATA"  , dDataBase              })
	aAdd(aFieldValue, {"NE0_HORA"  , cTime                  })
	aAdd(aFieldValue, {"NE0_NOMUSU", UsrRetName(cCodUsuario)})
	aAdd(aFieldValue, {"NE0_MSGOBS", cMsgMemo               })

	::buildModelInsert(aFieldValue)
return ::isSuccess()
