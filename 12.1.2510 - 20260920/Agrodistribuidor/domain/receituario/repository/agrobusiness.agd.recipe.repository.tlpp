/*/{Protheus.doc} getCodigoSolicitacaoByReceita
Retornar o código da solicitação vinculada a receita
@type method
@version P12
@author Gilson.Venturi
@since 05/12/2025
@param codReceita, character, Código da receita
@return Character, código da solicitação vinculada
/*/
Method getCodigoSolicitacaoByReceita(cdReceita) class RecipeRepository
return POSICIONE( "NEU", 5, FWxFilial('NEU') + cdReceita, "NEU_CODIGO" )


/*/{Protheus.doc} isNFeReceita
Verificar se há NF vinculada nareceita
@type method
@version P12
@author Gilson.Venturi
@since 05/12/2025
@param cdIdExterno, character, id unico
@return Logical, .T. se houver vínculo com NF-e, .F. caso contrário
/*/
Method isNFeReceita(cdIdExterno) class RecipeRepository
	cDocto := POSICIONE( "NE6", 2, FWxFilial('NE6') + cdIdExterno, "NE6_DOC" )
return !Empty(cDocto)


/*/{Protheus.doc} isReceitaVinculada
Verificar se receita está vinculada a solicitação válida. Status diferente de invalido
@type method
@version P12
@author Gilson.Venturi
@since 05/12/2025
@param cdIdExterno, character, id unico
@return Logical, .T. se houver vínculo com NF-e, .F. caso contrário
/*/
Method isReceitaVinculada(cdIdExterno) class RecipeRepository
	Local cQuery     As character
	Local oStmt      As object
	Local lRet       := .F.

	cQuery := " SELECT COUNT(*) AS QTDE "
	cQuery += "   FROM " + RetSqlName("NE6") + " NE6 "
	cQuery += "  INNER JOIN " + RetSqlName("NEU") + " NEU "
	cQuery += "     ON NEU.NEU_FILIAL = ? "
	cQuery += "    AND NEU.NEU_CODREC = NE6.NE6_CODREC "
	cQuery += "    AND NEU.D_E_L_E_T_ = '' "
	cQuery += "  INNER JOIN " + RetSqlName("NET") + " NET "
	cQuery += "     ON NET.NET_FILIAL = ? "
	cQuery += "    AND NET.NET_CODIGO = NEU.NEU_CODIGO "
	cQuery += "    AND NET.NET_STSSOL = '1' " //1-Confirmada
	cQuery += "    AND NET.D_E_L_E_T_ = '' "
	cQuery += "  WHERE NE6.NE6_FILIAL = ? "
	cQuery += "    AND NE6.NE6_CODEXT = ? "
	cQuery += "    AND NE6.D_E_L_E_T_ = '' "

	cQuery := ChangeQuery(cQuery)

	// Prepara os parâmetros
	oStmt:= FWPreparedStatement():New()
	oStmt:SetQuery(cQuery)
	oStmt:SetString(1, FWxFilial("NEU"))
	oStmt:SetString(2, FWxFilial("NET"))
	oStmt:SetString(3, FWxFilial("NE6"))
	oStmt:SetString(4, cdIdExterno)

	nQtd := MPSysExecScalar(oStmt:GetFixQuery(), "QTDE")
	if (nQtd > 0)
		lRet := .T.
	else
		lRet := .F.
	endif
return lRet

/*/{Protheus.doc} existByCodigoExterno
Existe receita com ID Externo informado
@type method
@version 12
@author jean.schulze
@since 3/5/2026
@param cdIdExterno, character, Id externo
@return variant, existe/não existe
/*/
Method existByCodigoExterno(cdIdExterno) class RecipeRepository
	Local cQuery     As character
	Local oStmt      As object
	Local lRet       := .F.

	cQuery := " SELECT COUNT(*) AS QTDE "
	cQuery += "   FROM " + RetSqlName("NE6") + " NE6 "
	cQuery += "  WHERE NE6.NE6_FILIAL = ? "
	cQuery += "    AND NE6.NE6_CODEXT = ? "
	cQuery += "    AND NE6.D_E_L_E_T_ = '' "

	cQuery := ChangeQuery(cQuery)

	// Prepara os parâmetros
	oStmt:= FWPreparedStatement():New()
	oStmt:SetQuery(cQuery)
	oStmt:SetString(1, FWxFilial("NE6"))
	oStmt:SetString(2, cdIdExterno)

	nQtd := MPSysExecScalar(oStmt:GetFixQuery(), "QTDE")

	if (nQtd > 0)
		lRet := .T.
	else
		lRet := .F.
	endif
return lRet

/*/{Protheus.doc} cancelarReceita
Cancelar Receita Agronômica e desvincular na Solicitação de Receita
@type method
@version P12
@author Gilson.Venturi
@since 05/12/2025
@param cdIdExterno, character, id unico
/*/
Method cancelarReceita(cdIdExterno) class RecipeRepository
	Local oBloqFatService  as object
	Local oModel120        as object
	Local oModel040        as object
	Local oNE6             as object
	Local oNET             as object
	Local oNEU             as object

	Local aAreaNE6 := NE6->(GetArea())
	Local aAreaNET := NET->(GetArea())
	Local aAreaNEU := NEU->(GetArea())

	Local nI      := 1
	Local cCodigo := ''
	Local lTemSC9 := .F.

	if Self:isReceitaVinculada(cdIdExterno)
		if Self:isNFeReceita(cdIdExterno)
			Self:setError(STR0002, 400) //"Não é possível cancelar a receita vinculada a uma NF-e válida"
		else

			dbSelectArea('NE6')
			NE6->(dbSetOrder(2)) //NE6_FILIAL+NE6_CODEXT
			NE6->(dbSeek(FWxFilial('NE6') + cdIdExterno))

			// Carrega o Model da rotina AGDA120 - Receita Agronômica
			oModel120 := FwLoadModel("AGDA120")
			oModel120:SetOperation(MODEL_OPERATION_UPDATE)
			oModel120:Activate()

			oNE6 := oModel120:GetModel("AGDA120_NE6")
			oNE6:SetValue("NE6_STATUS", '2') //2-Cancelada

			oModel120:VldData()
			oModel120:CommitData()
			//AGDGRAVAHIS(STR0006,"NET",FwXFilial("NET") + oNET:GetValue("NET_NUMPED") + oNET:GetValue("NET_CODIGO")  , STR0007,.F.,STR0008) //"Solicitação de Receituario" //"Cancelamento de Receita" //"Receita Cancelada"
			oModel120:DeActivate()
			oModel120:Destroy()
			oModel120 := NIL

			cCodigo := Self:getCodigoSolicitacaoByReceita(NE6->NE6_CODREC)

			dbSelectArea('NET')
			NET->(dbSetOrder(1))
			NET->(dbSeek( FWxFilial('NET')+ cCodigo))

			// Carrega o Model da rotina AGDA040 - Solicitação de Receita
			oModel040 := FwLoadModel("AGDA040")
			oModel040:SetOperation(MODEL_OPERATION_UPDATE)
			oModel040:Activate()

			oNET := oModel040:GetModel("AGDA040_NET")
			oNEU := oModel040:GetModel("AGDA040_NEU")

			AGDGRAVAHIS(STR0006,"NET",FwXFilial("NET") + oNET:GetValue("NET_NUMPED") + oNET:GetValue("NET_CODIGO")  , STR0007,.F.,STR0008) //"Solicitação de Receituario" //"Cancelamento de Receita" //"Receita Cancelada"

			oNET:SetValue("NET_STSREC", '2') // '2 - Receita Cancelada'

			For nI := 1 To oNEU:Length()
				oNEU:GoLine(nI)
				oNEU:SetValue("NEU_CODREC", '')
				oNEU:SetValue("NEU_SEQREC", '' )
			Next

			oModel040:VldData()
			oModel040:CommitData()
			oModel040:DeActivate()
			oModel040:Destroy()
			oModel040 := NIL

			// Efetua bloqueio de faturamento para os itens da receita
			oBloqFatService := SalesLockService():New()
			dbSelectArea('NEU')
			NEU->(dbSetOrder(1)) // NEU_FILIAL+NEU_CODIGO
			if NEU->(dbSeek( FWxFilial('NEU') + NET->NET_CODIGO))
				while NEU->(!EoF()) .and. NEU->(NEU_FILIAL + NEU_CODIGO) == FWxFilial('NEU') + NET->NET_CODIGO
					lTemSC9 := .T.
					oBloqFatService:gerarBloqueioReceita(NEU->NEU_NUMPED, NEU->NEU_ITEMPE, NEU->NEU_SEQLIB, NEU->NEU_PRODUT)
					NEU->(dbSkip())
				EndDo
			EndIf
			FreeObj(oBloqFatService)


			// Gerar cópia da Solicitação de Receita
			if (lTemSC9)
				oModel040 := FwLoadModel("AGDA040")
				oModel040:SetOperation(MODEL_OPERATION_INSERT)
				oModel040:Activate(.T.) // Ativa com cópia mantendo os dados atuais
				oNET := oModel040:GetModel("AGDA040_NET")
				oNET:SetValue("NET_STSREC", '0') // '0 - Pendente'
				oModel040:VldData()
				oModel040:CommitData()
				oModel040:DeActivate()
				oModel040:Destroy()
				oModel040 := NIL
			endif

		endif
	endif

	RestArea(aAreaNE6)
	RestArea(aAreaNET)
	RestArea(aAreaNEU)

Return Nil

/*/{Protheus.doc} listPurchaseInvoiceData
Listar notas de entrada
@type method
@version  P12
@author gilson.venturi
@since 30/03/2026
@param nPage, integer, Número da página
@param nPageSize, integer, Tamanho da página
@param oJsonQryParam, json, Parâmetros da query string
/*/
method listPurchaseInvoiceData(nPage, nPageSize, oJsonQryParam) class RecipeRepository
	Local aArea             As Array
	Local cIdNota           As Character
	Local dDtEmissao        := Nil
	Local dDtFinal          := Nil
	Local cDtIni            := "" As Character
	Local cDtFim            := "" As Character
	Local aDados            := {} As Array
	Local cFilSF1           := "" As Character
	Local cDocSF1           := "" As Character
	Local cSerSF1           := "" As Character
	Local cCliSF1           := "" As Character
	Local cLojSF1           := "" As Character
	Local cFiltroUFs        As Character
	Local cTipoNota         As Character
	Local jResponseJson     As json
	Local aItens            As Array
	Local nX                As Numeric
	Local aSM0Dados 		as Array
	Local oJFilial  		as Object

	Default nPage           := 1
	Default nPageSize       := 10


	// Lê os filtros recebidos na API
	If ValType(oJsonQryParam) == "J" .And. oJsonQryParam:hasProperty("idNota")
		cIdNota := AllTrim(oJsonQryParam["idNota"])
	EndIf

	If ValType(oJsonQryParam) == "J" .And. oJsonQryParam:hasProperty("dataEmissao")
		dDtEmissao := Fw8601ToDate(oJsonQryParam["dataEmissao"])
	EndIf

	If ValType(oJsonQryParam) == "J" .And. oJsonQryParam:hasProperty("dataFinal")
		dDtFinal := Fw8601ToDate(oJsonQryParam["dataFinal"])
	EndIf

	If !Empty(dDtEmissao)
		cDtIni := DtoS(dDtEmissao)
	EndIf

	If !Empty(dDtFinal)
		cDtFim := DtoS(dDtFinal)
	EndIf

	If ValType(oJsonQryParam) == "J" .And. oJsonQryParam:hasProperty("ufs") .and. !Empty(AllTrim(oJsonQryParam["ufs"]))
		cFiltroUFs := Self:formatFiltro(oJsonQryParam["ufs"])
	EndIf

	If ValType(oJsonQryParam) == "J" .And. oJsonQryParam:hasProperty("tipoNota") .and. !Empty(AllTrim(oJsonQryParam["tipoNota"]))
		cTipoNota := Self:formatFiltro(oJsonQryParam["tipoNota"])
	EndIf

	aArea := FwGetArea()

	If !Empty(cIdNota)
		aDados := StrTokArr(cIdNota, "|")
		If Len(aDados) >= 6
			cFilSF1 := AllTrim(aDados[2])
			cDocSF1 := AllTrim(aDados[3])
			cSerSF1 := AllTrim(aDados[4])
			cCliSF1 := AllTrim(aDados[5])
			cLojSF1 := AllTrim(aDados[6])
		Else
			cDocSF1 := AllTrim(cIdNota)
		EndIf
	EndIf

	Self:setPage(nPage)
	Self:setPageSize(nPageSize)

	Self:setFieldsConsulta(Self:getFieldsNotaEntr())
	Self:SetQuery(Self:getQueryDefault(,Self:queryListPurchase(cDtIni, cDtFim, cFilSF1, cDocSF1, cSerSF1, cCliSF1, cLojSF1,cFiltroUFs, cTipoNota)))
	Self:SetWhere("1=1")
	Self:SetUseSpaces(.F.)

	If Self:Execute()
		Self:FillGetResponse()
		if Self:lOk
			jResponseJson := Self:convertToJson(Self:getJSONResponse())
			If ValType(jResponseJson) == "J" .And. jResponseJson:HasProperty('items') .And. ValType(jResponseJson['items']) == "A"

				aItens := jResponseJson['items']

				aSM0Dados := FWSM0Util():GetSM0Data( cEmpAnt , cFilAnt , { "M0_CGC", "M0_NOMECOM", "M0_ENDENT", "M0_BAIRENT", "M0_CIDENT", "M0_ESTENT" } )
				oJFilial := JsonObject():New()
				oJFilial['cnpjEmissor']        := AllTrim(aSM0Dados[1][2])
				oJFilial['razaoSocialEmissor'] := AllTrim(aSM0Dados[2][2])
				oJFilial['enderecoEmissor']    := AllTrim(aSM0Dados[3][2])
				oJFilial['bairroEmissor']      := AllTrim(aSM0Dados[4][2])
				oJFilial['cidadeEmissor']      := AllTrim(aSM0Dados[5][2])
				oJFilial['ufEmissor']          := AllTrim(aSM0Dados[6][2])

				For nX := 1 To Len(aItens)
					aItens[nX]['itensNF'] := Self:itensByPurchaseInvoice(aItens[nX])
					aItens[nX]['emissor'] := oJFilial
				Next nX
				jResponseJson['items'] := aItens
			EndIf
			Self:setSuccess(jResponseJson)
		Endif
	EndIf

	FwRestArea(aArea)
	FwFreeArray(aArea)
	FreeObj(jResponseJson)

return nil

/*/{Protheus.doc} getFieldsNotaEntr
Retorna lista de campos para consulta de notas de entrada
@type method
@version P12
@author gilson.venturi
@since 30/03/2026
@return variant, return_array 
/*/
Method getFieldsNotaEntr() Class RecipeRepository
	Local aArrayFields := {}

	AAdd(aArrayFields, {'idNf'                     , 'IDNF',                 'C', .T.})
	AAdd(aArrayFields, {'chaveAcesso'              , 'F1_CHVNFE',            'C', .T.})
	AAdd(aArrayFields, {'numeroNf'                 , 'F1_DOC',               'C', .T.})
	AAdd(aArrayFields, {'serieNf'                  , 'F1_SERIE',             'C', .T.})
	AAdd(aArrayFields, {'dataEmissao'              , 'F1_EMISSAO',           'D', .T.})
	AAdd(aArrayFields, {'tipo'                     , 'F1_TIPO',              'C', .T.})
	AAdd(aArrayFields, {'cfop'        	           , 'CFOP',                 'C', .T.})
	AAdd(aArrayFields, {'valorNota'        	       , 'F1_VALBRUT',           'N', .T.})
	AAdd(aArrayFields, {'fornecedorCod'        	   , 'FORNECCOD',            'C', .T.})
	AAdd(aArrayFields, {'fornecedorLoja'       	   , 'FORNECLOJA',           'C', .T.})
	AAdd(aArrayFields, {'fornecedorNome'       	   , 'FORNECNOME',           'C', .T.})
	AAdd(aArrayFields, {'fornecedorCgc'        	   , 'FORNECCGC',            'C', .T.})
	AAdd(aArrayFields, {'fornecedorEndereco'   	   , 'FORNECENDERECO',       'C', .T.})
	AAdd(aArrayFields, {'fornecedorBairro'     	   , 'FORNECBAIRRO',         'C', .T.})
	AAdd(aArrayFields, {'fornecedorMunicipio'  	   , 'FORNECMUNICIPIO',      'C', .T.})
	AAdd(aArrayFields, {'fornecedorCodMunicipio'   , 'FORNECCODMUNICIPIO',   'C', .T.})
	AAdd(aArrayFields, {'fornecedorEstado'         , 'F1_EST',               'C', .T.})
	AAdd(aArrayFields, {'formProprio'              , 'F1_FORMUL',            'C', .T.})


Return aArrayFields

/*/{Protheus.doc} queryListPurchase
Montar query para listar notas de entrada
@type method
@version  P12
@author gilson.venturi
@since 30/03/2026
@param cDtIni, character, data inicial no formato YYYYMMDD
@param cDtFim, character, data final no formato YYYYMMDD
@param cFilSF1, character, filial da nota
@param cDocSF1, character, documento da nota
@param cSerSF1, character, série da nota
@param cCliSF1, character, cliente/fornecedor da nota
@param cLojSF1, character, loja da nota
@param cFiltroUfs, character, filtro para os estados da nota
@return character, Query SQL para listar notas de entrada
/*/
method queryListPurchase(cDtIni, cDtFim, cFilSF1, cDocSF1, cSerSF1, cCliSF1, cLojSF1, cFiltroUfs, cTipoNota) class RecipeRepository
	Local cQuery      as Character
	Local oStatement  as Object
	Local nParamPos   := 1


	cQuery := "SELECT CONCAT('" + FwGrpCompany() + "|',"
	cQuery += 	" CONCAT("
	cQuery += 		" CONCAT("
	cQuery += 			" CONCAT("
	cQuery += 				" CONCAT(TRIM(SF1.F1_FILIAL), '|'),"
	cQuery += 				" CONCAT(TRIM(SF1.F1_DOC), '|')),"
	cQuery += 				" CONCAT(TRIM(SF1.F1_SERIE), '|')),"
	cQuery += 				" CONCAT(TRIM(SF1.F1_FORNECE), CONCAT('|', TRIM(SF1.F1_LOJA))))"
	cQuery += " ) AS IDNF,"

	cQuery += " SF1.F1_CHVNFE, SF1.F1_DOC, SF1.F1_SERIE, SF1.F1_EMISSAO, SF1.F1_TIPO, SF1.F1_EST, SF1.F1_VALBRUT, SF1.F1_FORMUL,"
	cQuery += " CASE"
	cQuery += "     WHEN SF1.F1_TIPO IN ('D','B') THEN SA1.A1_COD"
	cQuery += "     ELSE SA2.A2_COD"
	cQuery += " END AS FORNECCOD,"
	cQuery += " CASE"
	cQuery += "     WHEN SF1.F1_TIPO IN ('D','B') THEN SA1.A1_LOJA"
	cQuery += "     ELSE SA2.A2_LOJA"
	cQuery += " END AS FORNECLOJA,"
	cQuery += " CASE"
	cQuery += "     WHEN SF1.F1_TIPO IN ('D','B') THEN SA1.A1_NOME"
	cQuery += "     ELSE SA2.A2_NOME"
	cQuery += " END AS FORNECNOME,"
	cQuery += " CASE"
	cQuery += "     WHEN SF1.F1_TIPO IN ('D','B') THEN SA1.A1_CGC"
	cQuery += "     ELSE SA2.A2_CGC"
	cQuery += " END AS FORNECCGC,"
	cQuery += " CASE"
	cQuery += "     WHEN SF1.F1_TIPO IN ('D','B') THEN SA1.A1_END"
	cQuery += "     ELSE SA2.A2_END"
	cQuery += " END AS FORNECENDERECO,"
	cQuery += " CASE"
	cQuery += "     WHEN SF1.F1_TIPO IN ('D','B') THEN SA1.A1_BAIRRO"
	cQuery += "     ELSE SA2.A2_BAIRRO"
	cQuery += " END AS FORNECBAIRRO,"
	cQuery += " CASE"
	cQuery += "     WHEN SF1.F1_TIPO IN ('D','B') THEN SA1.A1_MUN"
	cQuery += "     ELSE SA2.A2_MUN"
	cQuery += " END AS FORNECMUNICIPIO,"
	cQuery += " CASE"
	cQuery += "     WHEN SF1.F1_TIPO IN ('D','B') THEN SA1.A1_COD_MUN"
	cQuery += "     ELSE SA2.A2_COD_MUN"
	cQuery += " END AS FORNECCODMUNICIPIO,"
	cQuery += " CASE"
	cQuery += "     WHEN SF1.F1_TIPO IN ('D','B') THEN SA1.A1_EST"
	cQuery += "     ELSE SA2.A2_EST"
	cQuery += " END AS FORNECESTADO,"

	cQuery += " COALESCE((SELECT MAX(SF3.F3_CFO)"
	cQuery += "     FROM " + retSqlName('SF3') + " SF3"
	cQuery += "    WHERE SF3.F3_FILIAL  = '" + FWxFilial('SF3') + "'"
	cQuery += "      AND SF3.F3_CLIEFOR = SF1.F1_FORNECE"
	cQuery += "      AND SF3.F3_LOJA    = SF1.F1_LOJA"
	cQuery += "      AND SF3.F3_NFISCAL = SF1.F1_DOC"
	cQuery += "      AND SF3.F3_SERIE   = SF1.F1_SERIE"
	cQuery += "      AND SF3.F3_ENTRADA = SF1.F1_DTDIGIT"
	cQuery += "       AND SF3.F3_FORMUL= SF1.F1_FORMUL "
	cQuery += "      AND SF3.D_E_L_E_T_ = ''), '' ) AS CFOP"

	cQuery += " FROM " + retSqlName('SF1') + " SF1"

	cQuery += " LEFT JOIN " + retSqlName('SA1') + " SA1"
	cQuery += "    ON SA1.A1_FILIAL   = '" + FWxFilial('SA1') + "'"
	cQuery += "   AND SA1.A1_COD      = SF1.F1_FORNECE"
	cQuery += "   AND SA1.A1_LOJA     = SF1.F1_LOJA"
	cQuery += "   AND SA1.D_E_L_E_T_  = ''"

	cQuery += " LEFT JOIN " + retSqlName('SA2') + " SA2"
	cQuery += "    ON SA2.A2_FILIAL   = '" + FWxFilial('SA2') + "'"
	cQuery += "   AND SA2.A2_COD      = SF1.F1_FORNECE"
	cQuery += "   AND SA2.A2_LOJA     = SF1.F1_LOJA"
	cQuery += "   AND SA2.D_E_L_E_T_  = ''"

	cQuery += " WHERE SF1.F1_FILIAL    = '" + FWxFilial('SF1') + "'"
	cQuery += " AND SF1.F1_CHVNFE <> ' '"
	cQuery += " AND (((SF1.F1_FORMUL = ' ' OR SF1.F1_FORMUL = 'N') AND SF1.F1_STATUS = 'A') "
	cQuery += "  OR(SF1.F1_FORMUL = 'S' AND SF1.F1_FIMP = 'S' ))"
	cQuery += " AND SF1.D_E_L_E_T_     = ' '"

	If !Empty(cDtIni)
		cQuery += " AND SF1.F1_EMISSAO >= ? "
	EndIf

	If !Empty(cDtFim)
		cQuery += " AND SF1.F1_EMISSAO <= ? "
	EndIf

	If !Empty(cFiltroUfs)
		cQuery +=    " AND SF1.F1_EST IN ( ? )"
	EndIf

	If !Empty(cTipoNota)
		cQuery +=    " AND SF1.F1_TIPO IN ( ? )"
	EndIf

	If !Empty(cDocSF1)
		cQuery += " AND SF1.F1_FILIAL  = ? "
		cQuery += " AND SF1.F1_DOC     = ? "
		cQuery += " AND SF1.F1_SERIE   = ? "
		cQuery += " AND SF1.F1_FORNECE = ? "
		cQuery += " AND SF1.F1_LOJA    = ? "
	EndIf

	If FWAliasInDic("NF1")
		cQuery += " AND NOT EXISTS ("
		cQuery += "    SELECT 1"
		cQuery += "    FROM " + retSqlName('NF1') + " NF1"
		cQuery += "    WHERE NF1.NF1_FILIAL = '" + FWxFilial('NF1') + "'"
		cQuery += "      AND NF1.NF1_DOC    = SF1.F1_DOC"
		cQuery += "      AND NF1.NF1_SERIE  = SF1.F1_SERIE"
		cQuery += "      AND NF1.NF1_FORNEC = SF1.F1_FORNECE"
		cQuery += "      AND NF1.NF1_LOJA   = SF1.F1_LOJA"
		cQuery += "  )"
	EndIf

	cQuery += " AND EXISTS ("
	cQuery += "    SELECT 1"
	cQuery += "    FROM " + retSqlName('SD1') + " SD1"
	cQuery += "    INNER JOIN " + retSqlName('NCR') + " NCR"
	cQuery += "       ON (NCR.NCR_FILIAL  = '" + FWxFilial('NCR') + "'"
	cQuery += "       AND NCR.NCR_PROD    = SD1.D1_COD"
	cQuery += "       AND NCR.D_E_L_E_T_  = '')"
	cQuery += "   WHERE SD1.D1_FILIAL     = SF1.F1_FILIAL"
	cQuery += "     AND SD1.D1_DOC        = SF1.F1_DOC"
	cQuery += "     AND SD1.D1_SERIE      = SF1.F1_SERIE"
	cQuery += "     AND SD1.D1_FORNECE    = SF1.F1_FORNECE"
	cQuery += "     AND SD1.D1_LOJA       = SF1.F1_LOJA"
	cQuery += "     AND SD1.D_E_L_E_T_    = ''"
	cQuery += "     AND NCR.NCR_EMREC     = '1'"
	cQuery += "     AND NCR.NCR_MAPA      <> '')"

	cQuery := ChangeQuery(cQuery)

	oStatement := FWPreparedStatement():New()
	oStatement:SetQuery(cQuery)

	If !Empty(cDtIni)
		oStatement:SetString(nParamPos++, cDtIni)
	EndIf

	If !Empty(cDtFim)
		oStatement:SetString(nParamPos++, cDtFim)
	EndIf

	If !Empty(cFiltroUfs)
		oStatement:SetUnSafe(nParamPos++, cFiltroUfs)
	EndIf

	If !Empty(cTipoNota)
		oStatement:SetUnSafe(nParamPos++, cTipoNota)
	EndIf

	If !Empty(cDocSF1)
		If !Empty(cFilSF1)
			oStatement:SetString(nParamPos++, cFilSF1)
		Else
			oStatement:SetString(nParamPos++, FWxFilial('SF1'))
		EndIf
		oStatement:SetString(nParamPos++, cDocSF1)
		oStatement:SetString(nParamPos++, cSerSF1)
		oStatement:SetString(nParamPos++, cCliSF1)
		oStatement:SetString(nParamPos++, cLojSF1)
	EndIf

	cQuery := oStatement:GetFixQuery()


return cQuery

/*/{Protheus.doc} validarSolicitacaoReceita
Valida se a solicitação existe e se possui status permitido para vínculo da receita.
@type method
@version P12.1.2610
@author rodrigo.nsoledade
@since 20/03/2026
@param jPayload, json, payload recebido
@return logical, indica se a solicitação é válida
/*/
method validarSolicitacaoReceita(jPayload as json) as logical class RecipeRepository

	If ValType(jPayload) <> "J" .Or. ;
			!jPayload:HasProperty("solicitacao") .Or. ;
			Empty(AllTrim(jPayload["solicitacao"]))

		Self:setError(STR0001, 400) // "Registro Não Encontrado"
		Return .F.
	EndIf

	NET->(dbSetOrder(1))

	If !NET->(dbSeek(FWxFilial("NET") + jPayload["solicitacao"]))
		Self:setError(STR0001, 400) // "Registro Não Encontrado"
		Return .F.
	EndIf

	// Não permite vincular receita quando já emitida ou quando solicitação não está confirmada
	If NET->NET_STSREC == "1" .Or. NET->NET_STSSOL != "1"
		Self:setError(STR0003, 400) // "Solicitação possui Status que não permite vincular receita."
		Return .F.
	EndIf

Return .T.

/*/{Protheus.doc} fillModelReceita
Preenche os dados da receita agronômica no model AGDA120,
incluindo cabeçalho NE6 e itens NE7 agrupados por código MAPA.
@type method
@version P12.1.2610
@author rodrigo.nsoledade
@since 20/03/2026
@param oNE6, object, submodel do cabeçalho da receita
@param oNE7, object, submodel dos itens da receita
@param jPayload, json, payload recebido
@param aQuantMapaSolic, array, quantidades agrupadas por mapa
@return nil
/*/
method fillModelReceita(oNE6, oNE7, jPayload as json, aQuantMapaSolic as array) class RecipeRepository
	Local aDataHora as array
	Local nTamSeq   := TamSX3("NE7_SEQREC")[1]
	Local nI        := 1
	Local cSeq      := ""

	aDataHora := FwDateTimeToLocal(jPayload["dataEmissaoUTC"], SuperGetMv("MV_HVERAO", .F., .F.))

	// Cabeçalho da receita - NE6
	oNE6:SetValue("NE6_FILIAL", FWxFilial("NE6"))
	oNE6:SetValue("NE6_CLIENT", NET->NET_CLIENT)
	oNE6:SetValue("NE6_LOJA"  , NET->NET_LOJA)
	oNE6:SetValue("NE6_PEDORI", NET->NET_NUMPED)
	oNE6:SetValue("NE6_CULTUR", NET->NET_CULTRA)
	oNE6:SetValue("NE6_NUMREC", jPayload["codigoReceita"])
	oNE6:SetValue("NE6_CODEXT", jPayload["idReceitaExterno"])
	oNE6:SetValue("NE6_DTEMIS", aDataHora[1])
	oNE6:SetValue("NE6_HREMIS", aDataHora[2])
	oNE6:SetValue("NE6_URLREC", jPayload["urlReceita"])
	oNE6:SetValue("NE6_STATUS", "1") // 1 - Emitida
	oNE6:SetValue("NE6_OBS"   , jPayload["observacao"])

	// Itens da receita - NE7, uma linha por código MAPA
	If !Empty(aQuantMapaSolic)
		For nI := 1 To Len(aQuantMapaSolic)

			If nI > 1
				oNE7:AddLine()
			EndIf

			cSeq := StrZero(nI, nTamSeq)

			oNE7:SetValue("NE7_SEQREC", cSeq)
			oNE7:SetValue("NE7_MAPA"  , aQuantMapaSolic[nI][CODIGO_MAPA])
			oNE7:SetValue("NE7_QTDE"  , aQuantMapaSolic[nI][QUANTIDADE_SOLICITADA])
			oNE7:SetValue("NE7_QTDISP", 0)
		Next nI
	EndIf

Return Nil

/*/{Protheus.doc} destroyModel
Desativa, destrói e libera um model MVC com segurança.
@type method
@version P12.1.2610
@author rodrigo.nsoledade
@since 20/03/2026
@param oModel, object, model MVC a ser liberado
@return nil
/*/
method destroyModel(oModel as object) class RecipeRepository

	If oModel != Nil
		oModel:DeActivate()
		oModel:Destroy()
		FWFreeObj(oModel)
		oModel := Nil
	EndIf

Return Nil

/*/{Protheus.doc} itensByPurchaseInvoice
Obtem os itens da nota de entrada.
@type method
@version 1.0
@author felipe.savelar
@since 08/05/2026
@return array, estrutura de itens da nota
/*/
method itensByPurchaseInvoice(oNota) class RecipeRepository
	Local aItensNota  := {}
	Local cQuery      as Character
	Local oStatement  as Object
	Local nParamPos   := 1
	Local cAliSD1     as Character
	Local oItemNota   as Object
	Local aIdNf       as Array
	Local cFilSd1     as Character
	Local cDocSd1     as Character
	Local cSerSd1     as Character
	Local cFornSd1    as Character
	Local cLojSd1     as Character
	Local cInternalId as Character

	If ValType(oNota) != "J" .Or. !oNota:HasProperty('idNf') .Or. Empty(AllTrim(oNota['idNf']))
		Return aItensNota
	EndIf

	// Parse idNf: empresa|filial|doc|série|fornecedor|loja
	aIdNf := StrTokArr(AllTrim(oNota['idNf']), "|")
	If Len(aIdNf) < 6
		Return aItensNota
	EndIf

	cFilSd1   := AllTrim(aIdNf[2])
	cDocSd1   := AllTrim(aIdNf[3])
	cSerSd1   := AllTrim(aIdNf[4])
	cFornSd1  := AllTrim(aIdNf[5])
	cLojSd1   := AllTrim(aIdNf[6])

	cQuery := " SELECT SB1.B1_DESC, SD1.D1_ITEM, SD1.D1_QUANT, SD1.D1_UM, SD1.D1_LOTECTL, SD1.D1_TES, NCR.NCR_MAPA,SD1.D1_TES, "
	cQuery += " COALESCE(SB5.B5_QE1, '') AS B5_QE1, "
	cQuery += " COALESCE(SFT.FT_POSIPI, SB1.B1_POSIPI, '') AS FT_POSIPI, "
	cQuery += " SD1.D1_VUNIT, SD1.D1_TOTAL "
	cQuery += " FROM " + RetSqlName("SD1") + " SD1 "
	cQuery += " LEFT JOIN " + RetSqlName("SFT") + " SFT "
	cQuery += "    ON (SFT.FT_FILIAL   = ? "
	cQuery += "   AND SFT.FT_TIPOMOV   = 'E' "
	cQuery += "   AND SFT.FT_SERIE     = SD1.D1_SERIE "
	cQuery += "   AND SFT.FT_NFISCAL   = SD1.D1_DOC "
	cQuery += "   AND SFT.FT_CLIEFOR   = SD1.D1_FORNECE "
	cQuery += "   AND SFT.FT_LOJA      = SD1.D1_LOJA "
	cQuery += "   AND SFT.FT_ITEM      = SD1.D1_ITEM "
	cQuery += "   AND SFT.FT_PRODUTO   = SD1.D1_COD "
	cQuery += "   AND SFT.D_E_L_E_T_   = ' ') "
	cQuery += " INNER JOIN " + RetSqlName("SB1") + " SB1 "
	cQuery += "    ON (SB1.B1_FILIAL   = ? "
	cQuery += "   AND SB1.B1_COD       = SD1.D1_COD "
	cQuery += "   AND SB1.D_E_L_E_T_   = ' ') "
	cQuery += " INNER JOIN " + RetSqlName("NCR") + " NCR "
	cQuery += "    ON (NCR.NCR_FILIAL  = ? "
	cQuery += "   AND NCR.NCR_PROD     = SB1.B1_COD "
	cQuery += "   AND NCR.D_E_L_E_T_   = ' ') "
	cQuery += " LEFT JOIN " + RetSqlName("SB5") + " SB5 "
	cQuery += "    ON (SB5.B5_FILIAL   = ? "
	cQuery += "   AND SB5.B5_COD       = SB1.B1_COD "
	cQuery += "   AND SB5.D_E_L_E_T_   = ' ') "
	cQuery += " WHERE SD1.D1_FILIAL    = ? "
	cQuery += "   AND SD1.D1_DOC       = ? "
	cQuery += "   AND SD1.D1_SERIE     = ? "
	cQuery += "   AND SD1.D1_FORNECE   = ? "
	cQuery += "   AND SD1.D1_LOJA      = ? "
	cQuery += "   AND SD1.D_E_L_E_T_   = ' ' "
	cQuery += "   AND NCR.NCR_EMREC    = '1' "
	cQuery += "   AND NCR.NCR_MAPA     <> ' ' "
	cQuery += " ORDER BY SD1.D1_ITEM "

	cQuery := ChangeQuery(cQuery)

	oStatement := FWPreparedStatement():New()
	oStatement:SetQuery(cQuery)

	oStatement:SetString(nParamPos++, FWXfilial("SFT"))
	oStatement:SetString(nParamPos++, FWXfilial("SB1"))
	oStatement:SetString(nParamPos++, FWXfilial("NCR"))
	oStatement:SetString(nParamPos++, FWXfilial("SB5"))
	oStatement:SetString(nParamPos++, cFilSd1)
	oStatement:SetString(nParamPos++, cDocSd1)
	oStatement:SetString(nParamPos++, cSerSd1)
	oStatement:SetString(nParamPos++, cFornSd1)
	oStatement:SetString(nParamPos++, cLojSd1)

	cQuery := oStatement:GetFixQuery()

	cAliSD1 := GetNextAlias()
	dbUseArea(.T.,"TOPCONN",TCGenQry(,,cQuery),cAliSD1,.T.,.T.)

	While !(cAliSD1)->(Eof())
		oItemNota := JsonObject():New()


		oItemNota['numeroItem']       := AllTrim((cAliSD1)->D1_ITEM)
		oItemNota['nomeProduto']      := AllTrim((cAliSD1)->B1_DESC)
		oItemNota['ncmProduto']       := AllTrim((cAliSD1)->FT_POSIPI)
		oItemNota['quantidade']       := Val(cValToChar((cAliSD1)->D1_QUANT))
		oItemNota['unidadeMedida']    := AllTrim((cAliSD1)->D1_UM)
		oItemNota['numeroLote']       := AllTrim((cAliSD1)->D1_LOTECTL)
		oItemNota['quantidadeLote']   := Val(cValToChar((cAliSD1)->D1_QUANT))
		oItemNota['codProdutoIndea']  := AllTrim((cAliSD1)->NCR_MAPA)
		oItemNota['volumeEmbalagem']  := AllTrim(cValToChar((cAliSD1)->B5_QE1))
		oItemNota['precoUnitario']    := Val(cValToChar((cAliSD1)->D1_VUNIT))
		oItemNota['valorTotal']       := Val(cValToChar((cAliSD1)->D1_TOTAL))
		oItemNota['tes']       := AllTrim((cAliSD1)->D1_TES)

		cInternalId := cEmpAnt + "|" + cFilAnt + "|" + (cAliSD1)->D1_TES
		oItemNota['csTipoOperacao']   := Rtrim(CFGA070Ext("AGD-RECEITA", "SF4", "F4_CODIGO", cInternalId))

		aadd(aItensNota, oItemNota)
		(cAliSD1)->(DbSkip())
	EndDo
	(cAliSD1)->(DBCloseArea())

Return aItensNota

/*/{Protheus.doc} RecipeRepository::formatFiltro
Formata a String de parametros de busca para uso na query 
@type method
@version  P12
@author claudineia.reinert
@since 22/05/2026
@param cFiltro, character, String com as informacoes separadas por ";"
@return variant, String formatada para uso na query
/*/
method formatFiltro(cFiltro) class RecipeRepository
	Local aItems     := StrTokArr2(cFiltro, ";")
	Local cFiltroRet := ""
	Local nX         := 0

	for nX := 1 to Len(aItems)
		cFiltroRet += "'" + Upper(AllTrim(aItems[nX])) + "'"
		If nX > 0 .and. nX < Len(aItems)
			cFiltroRet += ","
		EndIf
	next nX
Return cFiltroRet

