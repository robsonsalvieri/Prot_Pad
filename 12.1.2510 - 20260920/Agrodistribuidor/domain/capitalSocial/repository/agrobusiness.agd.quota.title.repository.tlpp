#INCLUDE "totvs.ch"
#INCLUDE "tlpp-core.th"

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} QuotaTitleRepository
Repositório de Movimentações de Quotas - NF6
@type class
@version 12
@author rodrigo.nsoledade
@since 09/05/2025
/*/
class QuotaTitleRepository FROM UtilsRepository
	public Data cChaveIDRepository As Object //chave unica para updates

	public method New()
	public Method saveAllTitulos() 
	private method getFields() as Array

endclass

/*/{Protheus.doc} New
Constructor
@type method
@version 12
@author jean.schulze
@since 15/05/2025
@return variant, this
/*/
method New(pcChaveIDRepository as character) class QuotaTitleRepository
	Self:cChaveIDRepository := pcChaveIDRepository
	_Super:New('NF6', Self:getFields(), nil, nil, 'AGDA145')
return Self


/*/{Protheus.doc} getFields
Retorna a Lista de Campos do Repositorio
@type method
@version 12
@author rodrigo.nsoledade
@since 09/05/2025
@return array, lista de campos
/*/
method getFields() class QuotaTitleRepository
	Local aFields := {}


	AAdd(aFields, {"filial"        	    , "NF6_FILIAL" , "C", .T.})
	AAdd(aFields, {"codigoCooperado"    , "NF6_CODCOO" , "C", .T.})
	AAdd(aFields, {"lojaCooperado"    	, "NF6_LOJCOO" , "C", .T.})
	AAdd(aFields, {"idMovimento"    	, "NF6_IDMOV"  , "C", .T.})


Return aFields


/*/{Protheus.doc} saveAllTitulos
Insere lista de registro através do modelo
@type method
@version 12
@author lindembergson.pacheco
@since 22/06/2026
@param aFieldValue, array, {{'cField', 'xValue'}, ...}
/*/
method saveAllTitulos(jMovimento as json, aTitulos as array) class QuotaTitleRepository
	Local nX as numeric
	Local aFieldsSave as array
	
	For nX:= 1 to Len(aTitulos)
		aFieldsSave := {}
		AAdd(aFieldsSave, {"NF6_CODCOO", jMovimento["cooperado"]})
		AAdd(aFieldsSave, {"NF6_LOJCOO", jMovimento["loja"]})
		AAdd(aFieldsSave, {"NF6_IDMOV",  jMovimento["idMovimento"]})
		AAdd(aFieldsSave, {"NF6_PRETIT", aTitulos[nX]["prefixo"]})
		AAdd(aFieldsSave, {"NF6_NUMTIT", aTitulos[nX]["numeroTitulo"]})
		AAdd(aFieldsSave, {"NF6_PARTIT", aTitulos[nX]["parcela"]})
		AAdd(aFieldsSave, {"NF6_TIPTIT", aTitulos[nX]["tipoTitulo"]})
		AAdd(aFieldsSave, {"NF6_FILTIT", aTitulos[nX]["filial"]})
		AAdd(aFieldsSave, {"NF6_ORITIT", aTitulos[nX]["origem"]})

		if aTitulos[nX]:hasproperty("fornecedor") .and. aTitulos[nX]:hasproperty("loja")
			AAdd(aFieldsSave, {"NF6_FORNEC", aTitulos[nX]["fornecedor"]})
			AAdd(aFieldsSave, {"NF6_FORLOJ", aTitulos[nX]["loja"]})
		endif

		Self:buildModelInsert(aFieldsSave)

		if !Self:isSuccess()
			return
		endif
			
	Next nX
return
