#include 'tlpp-core.th'
#include 'totvs.ch'

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} AccountsPayableRepository
Repositório de contas a pagar
@type class
@version 12
@author jc.maldonado
@since 02/07/2026
/*/
class AccountsPayableRepository FROM UtilsService
	public method new()
	public method getFields() as array
	public method getNewBillNumber() as character
endclass

/*/{Protheus.doc} new
Construtor
@type method
@version 12
@author jc.maldonado
@since 02/07/2026
@return object, Instancia da classe
/*/
method new() class AccountsPayableRepository
	_Super:New('SE2', ::getFields())
return Self

/*/{Protheus.doc} getFields
Obtem os campos do repositório
@type method
@version 12
@author jc.maldonado
@since 02/07/2026
@return array, {{cCampoJson, cCampoProtheus, cTipoCampo, lMostraCampoConsulta}, ...}
/*/
method getFields() as array class AccountsPayableRepository
	local aFields as array

	aFields := {;
		{'filial'        , 'E2_FILIAL' , 'C', .F.},;
		{'prefixo'       , 'E2_PREFIXO', 'C', .T.},;
		{'numeroTitulo'  , 'E2_NUM'    , 'C', .T.},;
		{'parcela'       , 'E2_PARCELA', 'C', .T.},;
		{'tipo'          , 'E2_TIPO'   , 'C', .T.},;
		{'natureza'      , 'E2_NATUREZ', 'C', .T.},;
		{'fornecedor'    , 'E2_FORNECE', 'C', .T.},;
		{'loja'          , 'E2_LOJA'   , 'C', .T.},;
		{'emissao'       , 'E2_EMISSAO', 'C', .T.},;
		{'vencimento'    , 'E2_VENCTO' , 'D', .T.},;
		{'vencimentoReal', 'E2_VENCREA', 'D', .T.},;
		{'valorTitulo'   , 'E2_VALOR'  , 'N', .T.},;
		{'fluxoCaixa'    , 'E2_FLUXO'  , 'C', .T.};
		}
return aFields

/*/{Protheus.doc} getNewBillNumber
Obtem o proximo numero do titulo (E2_NUM) disponivel
@type method
@version 12
@author jc.maldonado
@since 02/07/2026
@param cPrefix, character, Codigo prefixo (E2_PREFIXO)
@return character, código
/*/
method getNewBillNumber(cPrefix as character) as character class AccountsPayableRepository
	local cQuery           as character
	local aBindParam := {} as array
	local cNewCode         as character

	default cPrefix := ""

	cQuery := " SELECT"
	cQuery += "	 COALESCE(MAX(E2_NUM), ?) E2_NUM" ; aAdd(aBindParam, CriaVar('E2_NUM'))
	cQuery += " FROM "
	cQuery += retSQLname("SE2")
	cQuery += " WHERE"
	cQuery += "	 E2_FILIAL = ?" ; aAdd(aBindParam, FWXFilial("SE2"))
	if ! empty(cPrefix)
		cQuery += "	 AND E2_PREFIXO = ?" ; aAdd(aBindParam, cPrefix)
	endIf
	cQuery += "	 AND D_E_L_E_T_ = ' '"
	cQuery := ChangeQuery(cQuery)

	cNewCode := Soma1(MPSysExecScalar(cQuery, 'E2_NUM', aBindParam))
return cNewCode
