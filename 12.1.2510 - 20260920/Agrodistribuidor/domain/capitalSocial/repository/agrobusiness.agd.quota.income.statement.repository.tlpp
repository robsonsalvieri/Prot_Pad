#Include "totvs.ch"
#Include "tlpp-core.th"
#Include "FWMVCDEF.CH"

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} QuotaIncomeStatementRepository
Repositório responsável pela persistência e consulta do histórico
de Informes de Rendimentos sobre Capital Social (NF0).
@type class
@version 12
@author rodrigo.nsoledade
@since 14/08/2026
/*/
Class QuotaIncomeStatementRepository From UtilsRepository

	Public Method New()
	Public Method saveWithReclock(aFieldsSaveComand As Array)
	Public Method hasHistory(cFilialDe,cFilialAte,cCoopDe,cCoopAte,cAnoRef,cMatricDe,cMatricAte) As Logical
	Public Method inactivate(cFilNF0,cCodCoop,cLojaCoop,cAnoRef) As Logical
	Public Method findReportData() 
	Public Method getFields() As Array

	Private Method findActiveRecnos(cFilNF0,cCodCoop,cLojaCoop,cAnoRef) As Array
	Private Method buildQueryReportData()

EndClass

/*/{Protheus.doc} New
Construtor do repositório de Informes de Rendimentos.
@type method
@version 12
@author rodrigo.nsoledade
@since 14/08/2026
@return object, instância da classe
/*/
Method New() Class QuotaIncomeStatementRepository
	_Super:New("NF0",Self:getFields(),Nil,Nil,"AGDA160")
Return Self

/*/{Protheus.doc} getFields
Retorna os campos utilizados pelo repositório NF0.
@type method
@version 12
@author rodrigo.nsoledade
@since 14/08/2026
@return array, campos do repositório
/*/
Method getFields() As Array Class QuotaIncomeStatementRepository
	Local aFields := {}

	AAdd(aFields,{"filial"          ,"NF0_FILIAL","C",.T.})
	AAdd(aFields,{"codigoCooperado" ,"NF0_CODCOO","C",.T.})
	AAdd(aFields,{"lojaCooperado"   ,"NF0_LOJCOO","C",.T.})
	AAdd(aFields,{"anoExercicio"    ,"NF0_ANOEXE","C",.T.})
	AAdd(aFields,{"dataGeracao"     ,"NF0_DTGERA","D",.T.})
	AAdd(aFields,{"horaGeracao"     ,"NF0_HRGERA","C",.T.})
	AAdd(aFields,{"anoCalendario"   ,"NF0_ANOCAL","C",.T.})
	AAdd(aFields,{"cnpjFonte"       ,"NF0_CNPJF" ,"C",.T.})
	AAdd(aFields,{"nomeFonte"       ,"NF0_NOMFON","C",.T.})
	AAdd(aFields,{"cpfBeneficiario" ,"NF0_CPFBEN","C",.T.})
	AAdd(aFields,{"nomeBeneficiario","NF0_NOMBEN","C",.T.})
	AAdd(aFields,{"valorLiquido"    ,"NF0_VALLIQ","N",.T.})
	AAdd(aFields,{"valorComplementar","NF0_VALCMP","N",.T.})
	AAdd(aFields,{"status"          ,"NF0_STATUS","C",.T.})
	AAdd(aFields,{"codigoContabilista","NF0_CODCTB","C",.T.})
	AAdd(aFields,{"nomeContabilista","NF0_NOMCTB","C",.T.})
	AAdd(aFields,{"matricula"       ,"NEP_MATRIC","C",.T.})
Return aFields

/*/{Protheus.doc} saveWithReclock
Insere um novo histórico de Informe de Rendimentos na NF0.
@type method
@version 12
@author rodrigo.nsoledade
@since 14/08/2026
@param aFieldsSaveComand, array, campos e valores para inclusão
/*/
Method saveWithReclock(aFieldsSaveComand As Array) Class QuotaIncomeStatementRepository
	Local nField		as Numeric

	dbSelectArea('NF0')
	NF0->(dbSetOrder(1)) 
	RecLock("NF0",.T.)
	For nField := 1 to len(aFieldsSaveComand)
		NF0->( &(aFieldsSaveComand[nField][1]) ) :=  aFieldsSaveComand[nField][2]
	Next
	NF0->(MsUnlock())

Return

/*/{Protheus.doc} hasHistory
Verifica se já existem históricos gerados para os filtros e exercício informados.
@type method
@version 12
@author rodrigo.nsoledade
@since 14/08/2026
@param cFilialDe, character, filial inicial
@param cFilialAte, character, filial final
@param cCoopDe, character, cooperado inicial
@param cCoopAte, character, cooperado final
@param cAnoRef, character, ano-calendário de referência
@param cMatricDe, character, matrícula inicial do cooperado
@param cMatricAte, character, matrícula final do cooperado
@return logical, indica existência de histórico
/*/
Method hasHistory(cFilialDe,cFilialAte,cCoopDe,cCoopAte,cAnoRef,cMatricDe,cMatricAte) As Logical Class QuotaIncomeStatementRepository
	Local cQuery     := ""
	Local cAnoExe    := StrZero(Val(cAnoRef) + 1,4)
	Local oStatement := FWPreparedStatement():New()
	Local nQty       := 0

	cQuery := " SELECT COUNT(*) AS QTDE"
	cQuery += " FROM " + RetSqlName("NF0") + " NF0"

	cQuery += " INNER JOIN " + RetSqlName("NEP") + " NEP"
	cQuery += " ON NEP.NEP_CODCLI = NF0.NF0_CODCOO"
	cQuery += " AND NEP.NEP_LOJCLI = NF0.NF0_LOJCOO"
	cQuery += " AND " + RetSqlCond("NEP")

	cQuery += " WHERE NF0.NF0_FILIAL BETWEEN ? AND ?"
	cQuery += " AND NF0.NF0_CODCOO BETWEEN ? AND ?"
	cQuery += " AND NF0.NF0_ANOEXE = ?"
	cQuery += " AND NEP.NEP_MATRIC BETWEEN ? AND ?"
	cQuery += " AND NF0.D_E_L_E_T_ = ' '"

	cQuery := ChangeQuery(cQuery)

	oStatement:SetQuery(cQuery)
	oStatement:SetString(1,FWxFilial("NF0",cFilialDe))
	oStatement:SetString(2,FWxFilial("NF0",cFilialAte))
	oStatement:SetString(3,cCoopDe)
	oStatement:SetString(4,cCoopAte)
	oStatement:SetString(5,cAnoExe)
	oStatement:SetString(6,cMatricDe)
	oStatement:SetString(7,cMatricAte)

	nQty := MPSysExecScalar(oStatement:GetFixQuery(),"QTDE")

	FWFreeObj(oStatement)
Return nQty > 0

/*/{Protheus.doc} findActiveRecnos
Retorna os RecNos ativos do histórico para um cooperado, loja e exercício.
@type method
@version 12
@author rodrigo.nsoledade
@since 14/08/2026
@param cFilNF0, character, filial
@param cCodCoop, character, código do cooperado
@param cLojaCoop, character, loja do cooperado
@param cAnoRef, character, ano-calendário
@return array, RecNos localizados
/*/
Method findActiveRecnos(cFilNF0,cCodCoop,cLojaCoop,cAnoRef) As Array Class QuotaIncomeStatementRepository
	Local aRecnos    := {}
	Local cAliasQry  := GetNextAlias()
	Local cAnoExe    := StrZero(Val(cAnoRef) + 1,4)
	Local cQuery     := ""
	Local oStatement := FWPreparedStatement():New()

	cQuery := " SELECT NF0.R_E_C_N_O_ AS RECNF0"
	cQuery += " FROM " + RetSqlName("NF0") + " NF0"
	cQuery += " WHERE NF0.NF0_FILIAL = ?"
	cQuery += " AND NF0.NF0_CODCOO = ?"
	cQuery += " AND NF0.NF0_LOJCOO = ?"
	cQuery += " AND NF0.NF0_ANOEXE = ?"
	cQuery += " AND NF0.NF0_STATUS = '1'"
	cQuery += " AND NF0.D_E_L_E_T_ = ' '"
	cQuery := ChangeQuery(cQuery)

	oStatement:SetQuery(cQuery)
	oStatement:SetString(1,FWxFilial("NF0",cFilNF0))
	oStatement:SetString(2,cCodCoop)
	oStatement:SetString(3,cLojaCoop)
	oStatement:SetString(4,cAnoExe)

	MPSysOpenQuery(oStatement:GetFixQuery(),cAliasQry)

	While !(cAliasQry)->(Eof())
		AAdd(aRecnos,(cAliasQry)->RECNF0)
		(cAliasQry)->(DbSkip())
	EndDo

	(cAliasQry)->(DbCloseArea())
	FWFreeObj(oStatement)
Return aRecnos

/*/{Protheus.doc} inactivate
Inativa os históricos ativos anteriormente gerados para o mesmo
cooperado, loja e exercício.
@type method
@version 12
@author rodrigo.nsoledade
@since 14/08/2026
@param cFilNF0, character, filial
@param cCodCoop, character, código do cooperado
@param cLojaCoop, character, loja do cooperado
@param cAnoRef, character, ano-calendário de referência
@return logical, indica sucesso da atualização
/*/
Method inactivate(cFilNF0,cCodCoop,cLojaCoop,cAnoRef) As Logical Class QuotaIncomeStatementRepository
	Local aAreaNF0  := NF0->(GetArea())
	Local aRecnos   := Self:findActiveRecnos(cFilNF0,cCodCoop,cLojaCoop,cAnoRef)
	Local cError    := ""
	Local lRet      := .T.
	Local nIndex    := 0
	Local oModel    := Nil
	Local oModelNF0 := Nil

	For nIndex := 1 To Len(aRecnos)
		DbSelectArea("NF0")
		NF0->(DbGoTo(aRecnos[nIndex]))

		oModel := FWLoadModel("AGDA160")
		oModel:SetOperation(MODEL_OPERATION_UPDATE)

		If oModel:Activate()
			oModelNF0 := oModel:GetModel("NF0MASTER")
			oModelNF0:SetValue("NF0_STATUS","2")

			If oModel:VldData()
				oModel:CommitData()
			Else
				cError := cValToChar(oModel:GetErrorMessage()[MODEL_MSGERR_MESSAGE])
				Self:setError(cError,500)
				lRet := .F.
			EndIf

			oModel:DeActivate()
		EndIf

		oModel:Destroy()
		FWFreeObj(oModel)
		oModel := Nil

		If !lRet
			Exit
		EndIf
	Next nIndex

	RestArea(aAreaNF0)
Return lRet

/*{Protheus.doc} findReportData
Pesquisa com query sem usar o utils
@param cWhereQry, string, WHERE pronta com os filtros do SmartView
@version 1.0
@author carlos.augusto
@since 21/08/2026
*/
method findReportData(cWhereQry) class QuotaIncomeStatementRepository
	Local cOrder      as Character
	Local cWhereParam as Character
	Local oJsonParam  := JsonObject():new()

	Self:setPage(1)
	Self:setPageSize(9999)

	cOrder 		:= Self:getOrderQueryParam(oJsonParam, Self:getFields())
	cWhereParam := Self:getWhereQueryParam(oJsonParam, Self:getFields())

	Self:setFieldsConsulta(Self:getFields())
	Self:SetQuery(Self:buildQueryReportData(cWhereQry))

	If Self:Execute()
		Self:FillGetResponse()
		If Self:lOk
			oJsonResp	:= Self:convertToJson(Self:getJSONResponse())
			Self:setSuccess(oJsonResp)
		EndIf
	EndIf

return nil

/*{Protheus.doc} buildQueryReportData
Retorna os dados do objeto de negócio
@param cWhereQry, string, WHERE pronta com os filtros do SmartView
@return object: self:oData
@version 1.0
@author carlos.augusto
@since 21/08/2026
*/
method buildQueryReportData(cWhereQry) class QuotaIncomeStatementRepository
	Local oStatement as Object
	Local cQuery        := ""

	cQuery += "SELECT MEUSCAMPOS "
	cQuery += 	" FROM " + RetSqlName("NF0") + " NF0"
	cQuery += 		" INNER JOIN " + RetSqlName("NEP") + " NEP"
	cQuery += 			" ON NEP.NEP_FILIAL = NF0.NF0_FILIAL"
	cQuery += 				" AND NEP.NEP_CODCLI = NF0.NF0_CODCOO"
	cQuery += 				" AND NEP.NEP_LOJCLI = NF0.NF0_LOJCOO"
	cQuery += 				" AND NEP.D_E_L_E_T_ = ' '"
	cQuery += 	" WHERE NF0.NF0_STATUS = '1' AND NF0.D_E_L_E_T_ = ' ' MEUFILTRO  "
	cQuery += 	cWhereQry

	cQuery := ChangeQuery(cQuery)

	cQuery := StrTran( cQuery, "MEUSCAMPOS", "#QueryFields#" ) 
	cQuery := StrTran( cQuery, "MEUFILTRO", "#QueryWhere#" )  //O changeQuery quebra esta contante QueryWhere

	oStatement := FWPreparedStatement():New()
	oStatement:SetQuery(cQuery)

	cQuery := oStatement:GetFixQuery()

return cQuery
