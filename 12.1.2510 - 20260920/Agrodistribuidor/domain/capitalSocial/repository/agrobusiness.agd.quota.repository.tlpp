namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} QuotaRepository
Repositório de Cotas de Cooperados - NF3
@type class
@version 12
@author lindembergson.pacheco
@since 06/07/2026
/*/
class QuotaRepository FROM UtilsRepository
	public method New()
	public Method update()
	public Method getFilterById()
	public Method getQueryContasCooperadosJuros() as Character
	public Method activateCooperatorQuota()
	public Method updateCooperatorQuotaStatusByMovement()
	public Method cooperatorBalance()
	public Method balanceReceivable()
	public Method validateCooperatorQuotaActivation()
	public Method activateCooperatorQuotaByAccountReceivable()
	public Method disableCooperatorQuota()
	public Method generateCooperatorQuotaByMovement()
	public Method createCooperatorQuota()
	public Method balanceForTerminatedCooperators()

	
	private Method getFields() as Array
endclass

/*/{Protheus.doc} New
Constructor
@type method
@version 12
@author lindembergson.pacheco
@since 06/07/2026
@return variant, this
/*/
method New() class QuotaRepository
	_Super:New('NF3', Self:getFields(), nil, nil, 'AGDA130')
return Self

/*/{Protheus.doc} getFields
Retorna a lista de campos do repositório
@type method
@version 12
@author lindembergson.pacheco
@since 06/07/2026
@return array, lista de campos
/*/
method getFields() class QuotaRepository
	Local aFields := {}

	AAdd(aFields, {"filial"              , "NF3_FILIAL" , "C", .T.})
	AAdd(aFields, {"codigoCooperado"     , "NF3_CODCOO" , "C", .T.})
	AAdd(aFields, {"lojaCooperado"       , "NF3_LOJCOO" , "C", .T.})
	AAdd(aFields, {"dataUltimoMovimento" , "NF3_DATMOV" , "D", .T.})
	AAdd(aFields, {"tipoMovimento"       , "NF3_TPOPER" , "C", .T.})
	AAdd(aFields, {"qtdCotas"            , "NF3_QTDCOT" , "N", .T.})
	AAdd(aFields, {"valorCotas"          , "NF3_VALCOT" , "N", .T.})
	AAdd(aFields, {"observacao"          , "NF3_OBS"    , "C", .F.})
	AAdd(aFields, {"dataCadastro"        , "NF3_DATCAD" , "D", .F.})
	AAdd(aFields, {"status"              , "NF3_STATUS" , "C", .T.})

return aFields


/*/{Protheus.doc} getFilterById
Obtem Filtro para Get By ID
@type method
@version 12
@author carlos.augusto
@since 14/07/2026
@param cFilCoop, character, filial do cooperado
@param cCodCoop, character, codigo do cooperado
@param cLojaCoop, character, loja do cooperado
@return array, lista de filtro
/*/
Method getFilterById(cFilCoop as character, cCodCoop as character, cLojaCoop as character) Class QuotaRepository
	Local aFilterId := {}

	AAdd(aFilterId, {'NF3_FILIAL', cFilCoop})
	AAdd(aFilterId, {'NF3_CODCOO', cCodCoop})
	AAdd(aFilterId, {'NF3_LOJCOO', cLojaCoop})

return aFilterId


/*/{Protheus.doc} createCooperatorQuota
Cria um novo registro de cota de cooperado
@type method
@version 12
@author carlos.augusto
@since 14/07/2026
@param aFields, array, lista de campos e valores
/*/
Method createCooperatorQuota(aFields as array) class QuotaRepository
	::buildModelInsert(aFields)
return nil


/*/{Protheus.doc} Update
Atualiza o repositório a partir dos campos e valores informados
@type method
@version 12
@author lindembergson.pacheco
@since 06/07/2026
@param aFieldsSave, array, Campos/valores a serem atualizados {{cCampo, xValor}, ...}
@param cChaveID, character, Chave do registro a ser atualizado
@param nOrderTable, numeric, Ordem da tabela
/*/
Method update(aFieldsSave as array, cChaveID as character, nOrderTable as integer) Class QuotaRepository
	Default nOrderTable := 1
	::updateRepository(aFieldsSave, cChaveID, nOrderTable)
Return


/*/{Protheus.doc} activateCooperatorQuota
Ativa o cooperado
@type method
@version 12
@author carlos.augusto
@since 14/07/2025
/*/
Method activateCooperatorQuota(cChaveId as character, nSldCots as numeric, nSldVlrCap as numeric) Class QuotaRepository
	local oHistoryService as object

	Self:updateRepository({{'NF3_STATUS', '1'}, {'NF3_DATATV', dDatabase}, {'NF3_QTDCOT', nSldCots}, {'NF3_VALCOT', nSldVlrCap} }, cChaveId)

	oHistoryService := HistoryService():new()
	oHistoryService:registrar("NF3", cChaveId, MODEL_OPERATION_UPDATE, nil, nil, STR0001 ) // "Conta do Cooperado Ativada"
	FreeObj(oHistoryService)
return nil


/*/{Protheus.doc} disableCooperatorQuota
Desativa o cooperado
@type method
@version 12
@author carlos.augusto
@since 14/07/2025
/*/
Method disableCooperatorQuota(cChaveId as character) Class QuotaRepository
	local oHistoryService as object

	Self:updateRepository({{'NF3_STATUS', '2'}, {'NF3_DATOFF', dDatabase}, {'NF3_VALOFF', Posicione("NF3",1,cChaveId,"NF3_VALCOT")}, {'NF3_QTDCOT', 0}, {'NF3_VALCOT', 0} }, cChaveId)

	oHistoryService := HistoryService():new()
	oHistoryService:registrar("NF3", cChaveId, MODEL_OPERATION_UPDATE, nil, nil, STR0002) // "Conta do Cooperado Inativada"
	FreeObj(oHistoryService)
return nil


/*/{Protheus.doc} generateCooperatorQuotaByMovement
Gera campos NF3 com base nos campos do movimento NF4
@type method
@version 12
@author carlos.augusto
@since 14/07/2025
/*/
Method generateCooperatorQuotaByMovement(cCodCliente as character, cLojClient as character, cTipMov as character, nQtdCota as numeric) Class QuotaRepository
	Local aArrayNF3 := {}
	
	AAdd(aArrayNF3, {"TMP_GERAUT", '1'}) //sempre primeiro campo a ser informado pois o campo TPOPER depende dessa info
	aAdd(aArrayNF3, {"NF3_CODCOO", cCodCliente})
    aAdd(aArrayNF3, {"NF3_LOJCOO", cLojClient})
    aAdd(aArrayNF3, {"NF3_DATMOV", dDataBase })
    aAdd(aArrayNF3, {"NF3_TPOPER", cTipMov})
    aAdd(aArrayNF3, {"NF3_QTDCOT", nQtdCota})
    aAdd(aArrayNF3, {"NF3_VALCOT", nQtdCota * SUPERGETMV("MV_AGD0011", .F., 1)})
    aAdd(aArrayNF3, {"NF3_FILIAL", FwXFilial("NF3")})
    aAdd(aArrayNF3, {"NF3_DATCAD", dDataBase})
    aAdd(aArrayNF3, {"NF3_STATUS", "2"})


    Self:createCooperatorQuota(aArrayNF3)

Return


/*/{Protheus.doc} updateCooperatorQuotaStatusByMovement
Atualiza status NF3 com base no saldo de cotas e valor financeiro do cooperado
@type method
@version 12
@author carlos.augusto
@since 14/07/2025
/*/
Method updateCooperatorQuotaStatusByMovement(cCodigoCooperado as character, cLojaCooperado as character, lForcaAtivacao as logical) Class QuotaRepository
	Local cChaveId		:= FWXFilial("NF3") + cCodigoCooperado + cLojaCooperado
	Local nSldVlrCap	:= 0
	Local nSldCots		:= 0
	Local aSaldos		:= {}
	Local lAtivo    	:= Posicione("NF3",1,cChaveId,"NF3_STATUS") $ '1'

	aSaldos := Self:cooperatorBalance(FWXFilial("NF3"), cCodigoCooperado, cLojaCooperado)

	If !Empty(aSaldos)
		nSldCots   := aSaldos[1]
		nSldVlrCap := aSaldos[2]

		If Round(nSldCots, 0) = 0 .and. lAtivo				
			Self:disableCooperatorQuota(cChaveId)
		ElseIf !lAtivo .and. nSldCots > 0 .and. lForcaAtivacao
			Self:activateCooperatorQuota(cChaveId, nSldCots, nSldVlrCap)
		else
			Self:updateRepository({{"NF3_QTDCOT", nSldCots}, {"NF3_VALCOT", nSldVlrCap}}, cChaveId)
		EndIf
		
	EndIf
Return


/*/{Protheus.doc} cooperatorBalance
Recupera saldo do cooperado (NF3) com base na movimentação (NF4)
@type method
@version 12
@author carlos.augusto
@since 14/07/2025
@param cFilialCoop, character, filial do cooperado
@param cCodigoCooperado, character, codigo do cooperado
@param cLojaCoop, character, loja do cooperado
@param dDataBase, date, data base para o calculo do saldo

/*/
method cooperatorBalance(cFilialCoop as Character, cCodigoCooperado as Character, cLojaCoop as Character, dDataBase as Date) class QuotaRepository
	Local aAreaAtual    := GetArea()
	Local cQuery        := ""
	Local cAliQry       := GetNextAlias()
	Local oStatement    := nil
	Local nSaldoCotas   := 0
	Local nSaldoVlrCap  := 0

	Default dDataBase   := Nil

	cQuery := " SELECT NF3.NF3_CODCOO,NF3.NF3_LOJCOO,"
    cQuery += " SUM(CASE"										      //-- Soma o saldo de QUANTIDADE DE COTAS.
    cQuery += 		" WHEN NF5.NF5_OPEXEC = '2' THEN NF4.NF4_QTDCOT"  //-- Se NF5_OPEXEC = '2' -> soma normalmente
    cQuery += 		" WHEN NF5.NF5_OPEXEC = '3' THEN -NF4.NF4_QTDCOT" //-- Se NF5_OPEXEC = '1' -> não entra na conta
    cQuery += 		" ELSE 0"
    cQuery += 		" END) AS SALDO_QTDCOT,"
    cQuery += " SUM(CASE"										      //-- Soma o saldo de  VALOR FINANCEIRO das cotas
    cQuery += 		" WHEN NF5.NF5_OPEXEC = '2' THEN NF4.NF4_VLRCAP"
    cQuery += 		" WHEN NF5.NF5_OPEXEC = '3' THEN -NF4.NF4_VLRCAP"
    cQuery += 		" ELSE 0"
    cQuery += 		" END) AS SALDO_VLRCAP"
    cQuery += " FROM "+ RetSqlName('NF3') +" NF3 "
    cQuery += " INNER JOIN "+ RetSqlName('NF4') +" NF4 "
    cQuery += 		" ON (NF3.NF3_CODCOO = NF4.NF4_CODCOO "
    cQuery += 		" AND NF3.NF3_LOJCOO = NF4.NF4_LOJCOO "
    cQuery += 		" AND NF4.NF4_FILIAL = ? ) "
    cQuery += " INNER JOIN "+ RetSqlName('NF5') +" NF5 "
    cQuery += 		" ON (NF4.NF4_TIPMOV = NF5.NF5_CODIGO "
    cQuery += 		" AND NF5.NF5_FILIAL = ? ) "
    cQuery += " WHERE NF3.NF3_FILIAL = ? "
	cQuery += 	" AND NF3.NF3_CODCOO = ? "
	cQuery += 	" AND NF3.NF3_LOJCOO = ? "

	if !Empty(dDataBase)
		cQuery +=   " AND NF4.NF4_DTMOV <= ? "
	endif

	cQuery += 	" AND NF4.NF4_STATUS = '1'"
	cQuery += 	" AND NF3.D_E_L_E_T_ = ' '"
	cQuery += 	" AND NF4.D_E_L_E_T_ = ' '"
	cQuery += 	" AND NF5.D_E_L_E_T_ = ' '"
    cQuery += " GROUP BY NF3.NF3_CODCOO,NF3.NF3_LOJCOO"
	cQuery := ChangeQuery( cQuery )

	oStatement := FWPreparedStatement():New()
	oStatement:SetQuery(cQuery)
	oStatement:SetString(1, FwXFilial("NF4"))
	oStatement:SetString(2, FwXFilial("NF5"))
	oStatement:SetString(3, FwXFilial("NF3"))
	oStatement:SetString(4, cCodigoCooperado)
	oStatement:SetString(5, cLojaCoop)

	if !Empty(dDataBase)
		oStatement:SetDate(6, dDataBase)
	endif
	cQuery := oStatement:GetFixQuery()
	dbUseArea(.T., "TOPCONN", TCGenQry(,,cQuery), cAliQry, .T., .T.)

	If !(cAliQry)->(Eof())
		nSaldoCotas    := (cAliQry)->SALDO_QTDCOT
		nSaldoVlrCap := (cAliQry)->SALDO_VLRCAP
	EndIf
	(cAliQry)->(dbCloseArea())

	RestArea(aAreaAtual)

Return {nSaldoCotas, nSaldoVlrCap}


/*/{Protheus.doc} activateCooperatorQuotaByAccountReceivable
Ativa um cooperado através da baixa completa dos títulos a receber
@type method
@version 12
@since 02/07/2025
@author carlos.augusto
@param cFilTit, character, filial do titulo
@param cPrefixo, character, prefixo do titulo
@param cNum, character, numero do titulo
@param cParcela, character, parcela do titulo
@param cTipo, character, tipo do titulo
@param cCodCli, character, codigo do cliente
@param cLojaCli, character, loja do cliente
@param cStatus, character, status do titulo
@return variant, nil
/*/
method activateCooperatorQuotaByAccountReceivable(cFilTit as character, cPrefixo as character, cNum as character, cParcela as character, cTipo as character, cCodCli as character, cLojaCli as character, cStatus as character) class QuotaRepository
	Local oMovimentoService       as object
	Local oTypeMovementRepository as object
	Local idMovTitulo := POSICIONE("NF6", 2, FwXFilial("NF6") + cCodCli + cLojaCli + cPrefixo + cNum + cParcela + cTipo,"NF6_IDMOV") 

	If Empty(idMovTitulo);
			.Or. cStatus != "B"; //B=Baixado
			.Or. Self:balanceReceivable(cFilTit, cPrefixo, cNum, cParcela, cTipo, cCodCli, cLojaCli) > 0
		Return
	EndIf

	//Todos titulos baixados
	cMovimento := POSICIONE("NF4", 1, FwXFilial("NF4") + cCodCli + cLojaCli + idMovTitulo,"NF4_TIPMOV")
	nValorCota := POSICIONE("NF4", 1, FwXFilial("NF4") + cCodCli + cLojaCli + idMovTitulo,"NF4_VALBRT")

	oTypeMovementRepository   := QuotaTypeMovementRepository():New(FwXFilial("NF5") + cMovimento)

	If oTypeMovementRepository:isGeraMovimentoAdicional()
		oMovimentoService := QuotaMovementService():New()
		oMovimentoService:gravarMovimento(FWxFilial('NF4'), cCodCli, cLojaCli, nValorCota, oTypeMovementRepository:getTipoMovimentoAdicional())
	EndIf

	Self:updateCooperatorQuotaStatusByMovement(cCodCli, cLojaCli, oTypeMovementRepository:isAtivadorCooperado())

	FreeObj(oTypeMovementRepository)
	FreeObj(oMovimentoService)
Return nil


/*/{Protheus.doc} balanceReceivable
Recupera saldo de titulos a receber (SE1) com base nas parcelas cadastradas a receber (NF6)
@type method
@version 12
@author carlos.augusto
@since 14/07/2025
/*/
method balanceReceivable(cFilTitulo as Character, cPrefixo as Character, cNumTitulo as Character, cParcela as Character, cTipoTitulo as Character, cCodCliente as Character, cLojaCliente as Character) class QuotaRepository
	Local aAreaAtual 	:= GetArea()
	Local cQuery		:= ""
	Local cAliQry 		:= GetNextAlias()
	Local oStatement 	:= nil
	Local nSaldoBaixar  := 0

	cQuery := " SELECT SE1.E1_SALDO"
	cQuery += " FROM " + RetSqlName('SE1') +" SE1 "
	cQuery += " WHERE SE1.E1_FILIAL  = ?"
	cQuery += 	" AND SE1.E1_PREFIXO = ?"
	cQuery += 	" AND SE1.E1_NUM     = ?"
	cQuery += 	" AND SE1.E1_TIPO    = ?"
	cQuery += 	" AND SE1.E1_CLIENTE = ?"
	cQuery += 	" AND SE1.E1_LOJA    = ?"
	cQuery += 	" AND SE1.D_E_L_E_T_ = ' '"
	cQuery += 	" AND SE1.E1_SALDO  <> 0"
	cQuery += 	" AND SE1.E1_PARCELA <> ?"
	cQuery += 	" AND EXISTS ("
	cQuery += 		" SELECT 1"
	cQuery += 		" FROM " + RetSqlName('NF6') +" NF6"
	cQuery += 		" WHERE NF6.NF6_FILTIT = SE1.E1_FILIAL"
	cQuery += 			" AND NF6.NF6_PRETIT = SE1.E1_PREFIXO"
	cQuery += 			" AND NF6.NF6_NUMTIT = SE1.E1_NUM"
	cQuery += 			" AND NF6.NF6_PARTIT = SE1.E1_PARCELA"
	cQuery += 			" AND NF6.NF6_TIPTIT = SE1.E1_TIPO"
	cQuery += 			" AND NF6.NF6_CODCOO = SE1.E1_CLIENTE"
	cQuery += 			" AND NF6.NF6_LOJCOO = SE1.E1_LOJA"
	cQuery += 			" AND NF6.NF6_ORITIT = '1'"
	cQuery += 			" AND NF6.D_E_L_E_T_ = ' ')"

	cQuery := ChangeQuery( cQuery )

	oStatement := FWPreparedStatement():New()
	oStatement:SetQuery(cQuery)
	oStatement:SetString(1, cFilTitulo)
	oStatement:SetString(2, cPrefixo)
	oStatement:SetString(3, cNumTitulo)
	oStatement:SetString(4, cTipoTitulo)
	oStatement:SetString(5, cCodCliente)
	oStatement:SetString(6, cLojaCliente)
	oStatement:SetString(7, cParcela)
	cQuery := oStatement:GetFixQuery()
	dbUseArea(.T., "TOPCONN", TCGenQry(,,cQuery), cAliQry, .T., .T.)

	If !(cAliQry)->(Eof())
		nSaldoBaixar    := (cAliQry)->E1_SALDO
	EndIf
	(cAliQry)->(dbCloseArea())

	RestArea(aAreaAtual)

Return nSaldoBaixar

/*/{Protheus.doc} getQueryContasCooperadosJuros
Retorna a query de contas de cooperados com cotas ativas e/ou demitidos, com base na filial e datas informadas
@type method
@version 12
@author jean.schulze
@since 7/22/2026
@param cFilCalc, character, filial
@param dDataLimiteAtivo, date, data limite para cooperados ativos
@param lDemitidos, logical, indica se deve incluir cooperados demitidos
@param dDataLimiteDemitidos, date, data limite para cooperados demitidos
@return character, query de contas de cooperados com cotas ativas e/ou demitidos
/*/
Method getQueryContasCooperadosJuros(cFilCalc as character, dDataLimiteAtivo as date, lDemitidos as logical, dDataLimiteDemitidos as date) as Character Class QuotaRepository
	Local cQuery  as character
	
	cQuery := " SELECT NF3_FILIAL, NF3_CODCOO, NF3_LOJCOO, NF3_VALCOT, NF3_VALOFF, NF3_DATATV, NF3_DATOFF, NF3_STATUS, NEP_CODFOR, NEP_LOJFOR"
	cQuery += " FROM " + RetSqlName("NF3") + " NF3 "
	cQuery += " INNER JOIN " + RetSqlName("NEP") + " NEP "
	//tratar filial
	cQuery += "   ON  NF3.NF3_CODCOO = NEP.NEP_CODCLI"
	cQuery += "   AND NF3.NF3_LOJCOO = NEP.NEP_LOJCLI"
	cQuery += "   AND NEP.D_E_L_E_T_ = ' ' "
	cQuery += " WHERE NF3.NF3_FILIAL = ? "
	cQuery += "   AND NF3.D_E_L_E_T_ = ' ' "

	if lDemitidos
		cQuery += " AND ((NF3_DATATV <= ? AND NF3.NF3_STATUS = '1') OR "
		cQuery += "      (NF3_DATOFF >= ? AND NF3.NF3_STATUS = '2')) " 
	else
		cQuery += " AND NF3_DATATV <= ? AND NF3.NF3_STATUS = '1' "
	endif
	cQuery 	 := ChangeQuery(cQuery)
	oFwPrepS := FWPreparedStatement():New()
	oFwPrepS:SetQuery(cQuery)
	oFwPrepS:SetString(1, cFilCalc)
	
	if lDemitidos		
		oFwPrepS:SetDate(2, dDataLimiteAtivo)
		oFwPrepS:SetDate(3, dDataLimiteDemitidos)
	else
		oFwPrepS:SetDate(2, dDataLimiteAtivo)
	endif	

return oFwPrepS:GetFixQuery()

/*/{Protheus.doc} balanceForTerminatedCooperators
Recupera saldo do cooperado (NF3) com base na movimentação (NF4) criados pelo Gera Demitidos
@type method
@version 12
@author gilson.venturi
@since 17/08/2006
@param cCodigoCooperado, character, codigo do cooperado
@param cLojaCooperado, character, loja do cooperado
@return numeric, retorna o saldo originado pela regra Gera Demitidos = Sim.
/*/
method balanceForTerminatedCooperators(cCodigoCooperado as Character, cLojaCoop as Character) class QuotaRepository
	Local aAreaAtual    := GetArea()
	Local cQuery        := ""
	Local cAliQry       := GetNextAlias()
	Local oStatement    := nil
	Local nSaldoVlrCap  := 0

	cQuery := " SELECT SUM(NF4.NF4_VLRCAP) AS SALDO_VLRCAP"	
	cQuery += "       FROM "+ RetSqlName('NF3') +" NF3 " //Cotas e Valores Cooperados
	cQuery += " INNER JOIN "+ RetSqlName('NF4') +" NF4 " //Movimentações Cotas Cooperados
    cQuery +=       "   ON NF4.NF4_FILIAL = ? "
    cQuery +=       "  AND NF4.NF4_CODCOO = NF3.NF3_CODCOO "
    cQuery +=       "  AND NF4.NF4_LOJCOO = NF3.NF3_LOJCOO "
	cQuery +=       "  AND NF4.NF4_STATUS = '1' " // Aprovado
	cQuery +=       "  AND NF4.NF4_OPTMOV = '7' " // Juros
	cQuery +=       "  AND NF4.D_E_L_E_T_ = ' ' "
	cQuery += " INNER JOIN "+ RetSqlName('NF7') +" NF7 " //Juros Capital Social
	cQuery +=       "   ON NF7.NF7_FILIAL = ? "
	cQuery +=       "  AND NF7.NF7_CODIGO = NF4.NF4_CODJUR "
	cQuery +=       "  AND NF7.NF7_GERDEM = '1' " // GeraDemitidos=Sim 
	cQuery +=       "  AND NF7.NF7_STATUS = '6' " // Aprovado
	cQuery +=       "  AND NF7.D_E_L_E_T_ = ' ' "
	cQuery += " WHERE NF3.NF3_FILIAL = ? "
	cQuery += "   AND NF3.NF3_CODCOO = ? "
	cQuery += "   AND NF3.NF3_LOJCOO = ? "
	cQuery += "   AND NF3.D_E_L_E_T_ = ' ' "
	cQuery += " GROUP BY NF3.NF3_CODCOO,NF3.NF3_LOJCOO"
	cQuery := ChangeQuery( cQuery )

	oStatement := FWPreparedStatement():New()
	oStatement:SetQuery(cQuery)
	oStatement:SetString(1, FwXFilial("NF4"))
	oStatement:SetString(2, FwXFilial("NF7"))
	oStatement:SetString(3, FwXFilial("NF3"))
	oStatement:SetString(4, cCodigoCooperado)
	oStatement:SetString(5, cLojaCoop)
	cQuery := oStatement:GetFixQuery()
	dbUseArea(.T., "TOPCONN", TCGenQry(,,cQuery), cAliQry, .T., .T.)

	If !(cAliQry)->(Eof())
		nSaldoVlrCap := (cAliQry)->SALDO_VLRCAP
	EndIf
	(cAliQry)->(dbCloseArea())

	RestArea(aAreaAtual)

Return nSaldoVlrCap
