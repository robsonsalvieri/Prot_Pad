#include "totvs.ch"
#include "tlpp-core.th"

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} QuotaService
Serviço responsável pela regra de negócio das cotas de cooperados (NF3).
@type class
@version 12
@author lindembergson.pacheco
@since 06/07/2026
/*/
class QuotaService FROM UtilsService
	public method New()
	public method alterar()
endclass

/*/{Protheus.doc} New
Inicializador da classe service
@type method
@version 12
@since 06/07/2026
@author lindembergson.pacheco
@return variant, self
/*/
method New() class QuotaService
	_Super:New()
return Self

/*/{Protheus.doc} alterar
Atualiza uma cota de cooperado na NF3
@type method
@version 12
@author lindembergson.pacheco
@since 06/07/2026
@param cChaveID, character, chave do registro a ser atualizado
@param aFieldsSaveComand, array, campos/valores para atualização {{cCampo, xValor}, ...}
@return variant, nil
/*/
method alterar(cChaveID as character, aFieldsSaveComand as array) class QuotaService
	Local oRepository as object

	oRepository := QuotaRepository():New()
	oRepository:update(aFieldsSaveComand, cChaveID)

	Self:setFullResponse(oRepository)

	oRepository:DeActivate()
	FreeObj(oRepository)
return Nil
