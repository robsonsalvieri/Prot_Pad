#include "totvs.ch"
#include 'tlpp-core.th'

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} TCOFromtoStorageService
Classe de serviços do TCO de-para Armazem
@type class
@version 12
@author lindembergson.pacheco
@since 24/04/2026
/*/
class TCOFromtoStorageService FROM UtilsService
	public method new()
	public method findStorage()
endClass

/*/{Protheus.doc} new
Construtor
@type method
@version 12
@author lindembergson.pacheco
@since 24/04/2026
@return object, Instancia da classe
/*/
method new() class TCOFromtoStorageService
	_Super:New()
return Self


/*/{Protheus.doc} findStorage
Buscar Por Id Unico
@type method
@version 12
@author lindembergson.pacheco
@since 24/04/2026
@param cFeature, character, id feature
@param jFilial, character, filial
@return variant, nil
/*/
method findStorage(cFeature, jFilial ) class TCOFromtoStorageService
	Local oRepository		As object

	oRepository := TCOFromtoStorageRepository():New()
	oRepository:findStorage(cFeature, jFilial)
	Self:setFullResponse(oRepository)

	oRepository:DeActivate()
	FreeObj(oRepository)
return nil
