/*/{Protheus.doc} getCheckAtivacao
Checagem de Ativação da Feature - Uso na seleção do WIZARD
@type method
@version 12
@author jean.schulze
@since 12/19/2025
@return variant, Array com os Erros/Impedimentos da Feature
/*/
Method getCheckAtivacao() Class TCOBarterDTO
	Local nX                                         as integer
	Local aMandatoryFields := ::getMandatoryFields() as array
	Local aErros := {}                               as array

	for nX := 1 to len(aMandatoryFields)
		if ! FWSX3Util():SeekX3File(aMandatoryFields[nX]['X3_CAMPO'])
			aadd(aErros, FeatUtilsService():setError(i18N(STR0025, {aMandatoryFields[nX]['X3_CAMPO']}), "FIELD")) //"O campo #1[CAMPO]# não foi encontrado"
			loop
		endIf

		if GetSX3Cache(aMandatoryFields[nX]['X3_CAMPO'], "X3_CONTEXT") != aMandatoryFields[nX]['X3_CONTEXT']
			aadd(aErros, FeatUtilsService():setError(i18n(STR0026, {aMandatoryFields[nX]['X3_CAMPO']}), "FIELD")) //"O campo #1[CAMPO]# não é virtual. Defina o campo como virtual."
		endIf

		if AllTrim(GetSX3Cache(aMandatoryFields[nX]['X3_CAMPO'], "X3_INIBRW")) != aMandatoryFields[nX]['X3_INIBRW']
			aadd(aErros, FeatUtilsService():setError(i18n(STR0027, {aMandatoryFields[nX]['X3_CAMPO'], aMandatoryFields[nX]['X3_INIBRW']}), "FIELD"))  //"O campo #1[CAMPO]# não está com inicializador correto. Informe a expressão #2[EXPRESSAO]# como inicializador do campo"
		endIf
	next nX

	FwFreeArray(aMandatoryFields)
Return aErros

