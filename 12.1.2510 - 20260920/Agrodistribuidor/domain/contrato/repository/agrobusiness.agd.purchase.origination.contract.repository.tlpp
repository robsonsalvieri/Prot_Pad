#include 'tlpp-core.th'
#include 'totvs.ch'

namespace totvs.protheus.agrobusiness.agd  

/*/{Protheus.doc} PurchaseContractRepository
Repositório de contratos de originação de compra (NJR)
@type class
@version 12
@author gilson.venturi
@since 18/05/2026
/*/
class PurchaseContractRepository from UtilsRepository
	public method new()

	private method getFields() as array
	private method getJoins()  as array
endclass

/*/{Protheus.doc} new
Construtor
@type method
@version 12
@author gilson.venturi
@since 18/05/2026
@return object, Instância da classe
/*/
method new() class PurchaseContractRepository
	_Super:New('NJR', self:getFields(), self:getJoins())
return self

/*/{Protheus.doc} getFields
Obtem os campos do repositório
@type method
@version 12
@author gilson.venturi
@since 18/05/2026
@return array, {{cCampoJson, cCampoProtheus, cTipoCampo, lMostraCampoConsulta}, ...}
/*/
method getFields() as array class PurchaseContractRepository
	local aFields as array

	aFields := {;
		{'filial'                  , 'NJR_FILIAL' , 'C', .F.},;
		{'codigoContrato'          , 'NJR_CODCTR' , 'C', .T.},;
		{'descricaoContrato'       , 'NJR_DESCRI' , 'C', .T.},;
		{'codigoEntidade'          , 'NJR_CODENT' , 'C', .T.},;
		{'lojaEntidade'            , 'NJR_LOJENT' , 'C', .T.},;
		{'nomeEntidade'            , 'NJ0_NOME'   , 'C', .T.},;
		{'data'                    , 'NJR_DATA'   , 'D', .T.},;
		{'safra'                   , 'NJR_CODSAF' , 'C', .T.},;
		{'codProduto'              , 'NJR_CODPRO' , 'C', .T.},;
		{'descricaoProduto'        , 'B1_DESC'    , 'C', .T.},;
		{'quantidade'              , 'NJR_QTDCTR' , 'N', .T.},;
		{'unidadeMedida'           , 'NJR_UM1PRO' , 'C', .T.},;
		{'valorUnitario'           , 'NJR_VLRUNI' , 'N', .T.},;
		{'valorTotal'              , 'NJR_VLRTOT' , 'N', .T.},;
		{'status'                  , 'NJR_STATUS' , 'C', .T.},;
		{'descricaoCondPagamento'  , 'E4_DESCRI'  , 'C', .T.},;
		{'tipoFrete'               , 'NJR_TPFRET' , 'C', .T.};
		}
return aFields

method getJoins() as array class PurchaseContractRepository
	local aJoins := {} as array

	aAdd(aJoins, {'INNER', 'SB1', Self:getWhereDefault('SB1.B1_COD = NJR.NJR_CODPRO', 'SB1')})
	aAdd(aJoins, {'INNER', 'SE4' , Self:getWhereDefault('SE4.E4_CODIGO = NJR.NJR_CONDPG', 'SE4')})
	aAdd(aJoins, {'INNER', 'NJ0', Self:getWhereDefault('NJ0.NJ0_CODENT = NJR.NJR_CODENT AND NJ0.NJ0_LOJENT = NJR.NJR_LOJENT', 'NJ0')})

return aJoins
 
