#include "totvs.ch"
#include 'tlpp-core.th'
#INCLUDE 'agrobusiness.agd.contract.acl.moviment.service.ch'

namespace totvs.protheus.agrobusiness.agd  

/*/{Protheus.doc} ContractACLMovimentService
Servico para ajuste da entidade de ACL dos Movimentos dos Contratos do Barter
@type class
@version 12
@author Gilson.Venturi
@since 27/01/2025
/*/
class ContractACLMovimentService FROM UtilsService
	public Data cIdTipoDocto      As Character
	public Data cChaveDocumento   As Character

	public method new()

	public method gerarMovimentosContrato()
	public method insertContractMovement()
	public method deleteByIdMovto()

	private method getDadosDocumentoEntrada()   as json
	private method getDadosDocumentoDevolucao() as json
	private method validarBodyMovimento(oBody as Json) as logical
	private method movimentExists(cIdMov as Character) as logical
	
endclass

/*/{Protheus.doc} new
Constructor
@type method
@version 12
@author Gilson.Venturi
@since 27/01/2025
@param pcIdTipoDocto, character, identificar tipo documento
@param pcIdDocumento, character, Chave documento
@return variant, instância
/*/   
method new(pcIdTipoDocto as Character, pcChaveDocumento as Character) class ContractACLMovimentService
	Self:cIdTipoDocto    := pcIdTipoDocto
	Self:cChaveDocumento := pcChaveDocumento
	_Super:New()
return Self

/*/{Protheus.doc} gerarMovimentosContrato
Gerar movimento no contrato referente ao vinculo dos documentos fiscais e romaneios de cargas 
ao contrato de compra de grãos X Negociação
@type method
@version 12
@author Gilson.Venturi
@since 27/01/2025
@return variant, nil
/*/
method gerarMovimentosContrato()  class ContractACLMovimentService
	Local oRepository   As object
	Local aMovimentosGerar := {}

	If Self:cIdTipoDocto == 'E'
		jDadosDocto :=  Self:getDadosDocumentoEntrada()
	elseif Self:cIdTipoDocto == 'D'
		jDadosDocto :=  Self:getDadosDocumentoDevolucao()
	endif

	//Retorna se nao houver contrato relacionado a nota
	if (jDadosDocto:GetJsonText('contrato') == 'null')
		return nil
	endif

	//Grava Movimento Contrato ACL
	AAdd(aMovimentosGerar, {'NEI_CODCTR' , jDadosDocto:GetJsonText('contrato')})
	AAdd(aMovimentosGerar, {'NEI_SEQ'    , jDadosDocto:GetJsonText('sequen')})
	AAdd(aMovimentosGerar, {'NEI_DOC'    , jDadosDocto:GetJsonText('docto')})
	AAdd(aMovimentosGerar, {'NEI_SERIE'  , jDadosDocto:GetJsonText('serie')})
	AAdd(aMovimentosGerar, {'NEI_FORNEC' , jDadosDocto:GetJsonText('fornec')})
	AAdd(aMovimentosGerar, {'NEI_LOJA'   , jDadosDocto:GetJsonText('loja')})
	AAdd(aMovimentosGerar, {'NEI_ITEM'   , jDadosDocto:GetJsonText('item')})
	AAdd(aMovimentosGerar, {'NEI_TIPO'   , jDadosDocto:GetJsonText('tipo')})
	AAdd(aMovimentosGerar, {'NEI_IDCTR'  , jDadosDocto:GetJsonText('identif')})
	AAdd(aMovimentosGerar, {'NEI_QUANT'  , val(jDadosDocto:GetJsonText('qtde'))})
	AAdd(aMovimentosGerar, {'NEI_VALOR'  , val(jDadosDocto:GetJsonText('valor'))})
	AAdd(aMovimentosGerar, {'NEI_IDMOV'  , jDadosDocto:GetJsonText('idMovimento')})

	oRepository:= ContractACLMovimentRepository():New()
	oRepository:save(aMovimentosGerar)

	if !oRepository:isSuccess()
		Self:setError(oRepository:getMessageError())
		oRepository:DeActivate()
		FreeObj(oRepository)
		return nil
	endif

	oRepository:DeActivate()
	FreeObj(oRepository)

	Self:setSuccess( STR0001 )

return nil

/*/{Protheus.doc} getDadosDocumentoEntrada
Retorna os dados do documento de entrada
@type method
@version 12
@author Gilson.Venturi
@since 29/01/2025
@return object, dados NF
/*/
method getDadosDocumentoEntrada() as json class ContractACLMovimentService
	Local oDados                := JsonObject():New()
	Local oIdService            := IdService():New()
	Local oContratoACLService   := ContractACLService():New()
	Local aArea                 := GetArea()
	Local aAreaSD1              := SD1->( GetArea() )
	Local aAreaNJM              := NJM->( GetArea() )
	Local cSequen               := STRZERO(0,TAMSX3("NEI_SEQ")[1])

	dbSelectArea( "SD1" )
	SD1->( dbSetOrder( 1 ) )
	SD1->(dbSeek(Self:cChaveDocumento))
	if Self:cChaveDocumento == SD1->(D1_FILIAL + D1_DOC + D1_SERIE + D1_FORNECE + D1_LOJA + D1_COD + D1_ITEM)

		oDados["docto"]   := SD1->( D1_DOC )
		oDados["serie"]   := SD1->( D1_SERIE )
		oDados["fornec"]  := SD1->( D1_FORNECE )
		oDados["loja"]    := SD1->( D1_LOJA )
		oDados['item']    := SD1->( D1_ITEM )
		oDados["tipo"]    := Iif(SD1->( D1_QUANT )==0,'3','1') //1-Entrada,2-Devolução,3-Complemento
		oDados["qtde"]    := SD1->( D1_QUANT )

		if !Empty(SD1->D1_CTROG)
			cIdContrato := oIdService:encode({xFilial("NJR"), SD1->(D1_CTROG)})
		else
			//Caso não tenha contrato vinculado, procura pela nota relacionada. ( Complemento/Devolução de Valor )
			cChaveDocumento := SD1->(D1_FILIAL + D1_NFORI + D1_SERIORI + D1_FORNECE + D1_LOJA + D1_COD + D1_ITEMORI)
			SD1->(dbSeek(cChaveDocumento))
			cIdContrato := oIdService:encode({xFilial("NJR"), SD1->(D1_CTROG)})
		endif
		cIdContrato := PadR(cIdContrato,TamSX3("NEI_IDCTR")[1])

		oContratoACLService:getContratoByCodigoExterno(cIdContrato)
		if oContratoACLService:isSuccess()

			dbSelectArea( "NEI" )
			dbSetOrder( 1 )
			If dbSeek( xFilial("NEI") + cIdContrato )
				While NEI->(!EoF()) .and. (xFilial('NEI')+cIdContrato == NEI->NEI_FILIAL+NEI->NEI_IDCTR)
					cSequen := NEI->NEI_SEQ
					NEI->(DBSkip(1))
				End
			endif

            /*Somente os campos necessários*/
			oDados["contrato"]    := SD1->( D1_CTROG )
			oDados["sequen"]      := Soma1(cSequen)
			oDados["identif"]     := cIdContrato

			dbSelectArea( "NJM" )
			dbSetOrder( 1 )
			If dbSeek( xFilial( "NJM" ) + SD1->( D1_CODROM ) + SD1->( D1_ITEROM ) )
				oDados["idMovimento"] := oIdService:encode({NJM->NJM_FILIAL, NJM->NJM_CODROM, NJM->NJM_ITEROM})
				oDados["valor"]       := NJM->( NJM_VLRTOT )
			EndIf

		endif

	endif

	RestArea( aAreaSD1 )
	RestArea( aAreaNJM )
	RestArea(aArea)

return oDados

/*/{Protheus.doc} getDadosDocumentoDevolucao
Retorna os dados do documento de entrada
@type method
@version 12
@author Gilson.Venturi
@since 29/01/2025
@return object, dados NF
/*/
method getDadosDocumentoDevolucao() as json class ContractACLMovimentService
	Local oDados                := JsonObject():New()
	Local oIdService            := IdService():New()
	Local oContratoACLService   := ContractACLService():New()
	Local aArea                 := GetArea()
	Local aAreaSD2              := SD2->( GetArea() )
	Local cSequen               := STRZERO(0,TAMSX3("NEI_SEQ")[1])

	dbSelectArea( "SD2" )
	SD2->( dbSetOrder( 3 ) )
	SD2->(dbSeek(Self:cChaveDocumento))
	if Self:cChaveDocumento == SD2->(D2_FILIAL + D2_DOC + D2_SERIE + D2_CLIENTE + D2_LOJA + D2_COD + D2_ITEM )

		dbSelectArea( "N8I" ) // Tab. de vinculo de itens do pv
		N8I-> ( dbSetOrder( 1 ))  //N8I_FILIAL+N8I_NUMPV+N8I_ITEMPV
		If msSeek( xFilial( "N8I" ) + SD2->( D2_PEDIDO ) + SD2->( D2_ITEMPV ) )
			dbSelectArea( "NJM" )
			dbSetOrder( 1 )
			If dbSeek( xFilial( "NJM" ) + N8I->N8I_CODROM + N8I->N8I_ITEROM )

				cIdContrato := oIdService:encode({xFilial("NJR"), NJM->(NJM_CODCTR)})
				cIdContrato := PadR(cIdContrato,TamSX3("NEI_IDCTR")[1])

				oContratoACLService:getContratoByCodigoExterno(cIdContrato)
				if oContratoACLService:isSuccess()

					dbSelectArea( "NEI" )
					dbSetOrder( 1 )
					If dbSeek( xFilial("NEI") + cIdContrato)
						While NEI->(!EoF()) .and. (xFilial('NEI')+cIdContrato == NEI->NEI_FILIAL+NEI->NEI_IDCTR)
							cSequen := NEI->NEI_SEQ
							NEI->(DBSkip(1))
						End
					End

                    /*Somente os campos necessários*/
					oDados["contrato"]    := NJM->( NJM_CODCTR )
					oDados["idMovimento"] := oIdService:encode({NJM->NJM_FILIAL, NJM->NJM_CODROM, NJM->NJM_ITEROM})
					oDados["valor"]       := NJM->( NJM_VLRTOT )
					oDados["sequen"]      := Soma1(cSequen)
					oDados["docto"]       := SD2->( D2_DOC )
					oDados["serie"]       := SD2->( D2_SERIE )
					oDados["fornec"]      := SD2->( D2_CLIENTE )
					oDados["loja"]        := SD2->( D2_LOJA )
					oDados['item']        := SD2->( D2_ITEM )
					oDados["tipo"]        := '2' //1-Entrada,2-Devolução,3-Complemento
					oDados["identif"]     := cIdContrato
					oDados["qtde"]        := (SD2->( D2_QUANT ) * -1)
				endif
			endif
		endif
	endif

	RestArea( aAreaSD2 )
	RestArea(aArea)

return oDados

/*/{Protheus.doc} insertContractMovement
Grava uma movimentação de contrato de compra na tabela NEI
a partir do JSON recebido pela API.
@type method
@version 1.1
@author rodrigo.nsoledade
@since 02/04/2026
@param jBody, jsonobject, corpo da requisição
@return variant, nil
/*/
method insertContractMovement(jBody as Json) class ContractACLMovimentService
	Local oRepository       As Object
	Local aMovimentosSalvar := {}
	Local cSeq              As Character
	Local nQuantidade       As Numeric
	Local nValorTotal       As Numeric
	
	// Validação básica
	If ValType(jBody) <> "J"
		Self:setError(STR0002, 400) //"Body da requisição inválido."
		Return nil
	EndIf

	// Validação de regras
	If !Self:validarBodyMovimento(jBody)
		Return nil
	EndIf

	oRepository := ContractACLMovimentRepository():New()

	// Próxima sequência do contrato
	cSeq := oRepository:nextSequencia(AllTrim(jBody["idNegocio"]))

	nQuantidade := Val(cValToChar(jBody["quantidade"]))
	nValorTotal := Val(cValToChar(jBody["valorTotal"]))

	// Monta o payload 
	AAdd(aMovimentosSalvar, {"NEI_FILIAL", FWxFilial("NEI")})
	AAdd(aMovimentosSalvar, {"NEI_IDCTR" , AllTrim(jBody["idNegocio"])})
	AAdd(aMovimentosSalvar, {"NEI_TIPO"  , AllTrim(jBody["tipo"])})
	AAdd(aMovimentosSalvar, {"NEI_SEQ"   , cSeq})
	AAdd(aMovimentosSalvar, {"NEI_DOC"   , AllTrim(jBody["documento"])})
	AAdd(aMovimentosSalvar, {"NEI_SERIE" , AllTrim(jBody["serie"])})
	AAdd(aMovimentosSalvar, {"NEI_FORNEC", AllTrim(jBody["fornecedor"])})
	AAdd(aMovimentosSalvar, {"NEI_LOJA"  , AllTrim(jBody["loja"])})
	AAdd(aMovimentosSalvar, {"NEI_ITEM"  , AllTrim(jBody["itemNF"])})
	AAdd(aMovimentosSalvar, {"NEI_QUANT" , nQuantidade})
	AAdd(aMovimentosSalvar, {"NEI_IDMOV" , AllTrim(jBody["idMovimento"])})
	AAdd(aMovimentosSalvar, {"NEI_VALOR" , nValorTotal})
	
	oRepository:save(aMovimentosSalvar)

	If !oRepository:isSuccess()
		Self:setError(oRepository:getMessageError(), 400)
		oRepository:DeActivate()
		FreeObj(oRepository)
		Return nil
	EndIf

	Self:setSuccess(STR0003) //"Movimentação de contrato gravada com sucesso."

	oRepository:DeActivate()
	FreeObj(oRepository)
Return nil

/*/{Protheus.doc} validarBodyMovimento
Valida os campos obrigatórios do body da API de movimento de contrato
utilizando estrutura dinâmica para reduzir duplicidade de código.
@type method
@version 1.2
@author rodrigo.nsoledade
@since 06/04/2026
@param oBody, jsonobject, conteúdo da requisição
@return logical, Verdadeiro
/*/
method validarBodyMovimento(oBody as Json) as logical class ContractACLMovimentService
	Local aCamposObrigatorios as Array
	Local nX                  as Numeric
	Local cCampo              as Character

	// Estrutura de campos obrigatórios
	aCamposObrigatorios := {;
		"idNegocio",;
		"tipo",;
		"idMovimento",;
		"quantidade",;
		"valorTotal",;
		"documento",;
		"serie",;
		"fornecedor",;
		"loja",;
		"itemNF";
	}

	// Loop de validação dos campos obrigatórios
	For nX := 1 To Len(aCamposObrigatorios)
		cCampo := aCamposObrigatorios[nX]

		If !oBody:HasProperty(cCampo) .Or. Empty(AllTrim(cValToChar(oBody[cCampo])))
			// Campo sempre no FINAL da mensagem (regra sua)
			Self:setError(STR0004 + cCampo, 400) //"Campo obrigatório não informado: "
			Return .F.
		EndIf
	Next

	// Validação de duplicidade do movimento
	If Self:movimentExists(AllTrim(oBody["idMovimento"]))
		Self:setError(STR0005, 400) //"Já existe movimentação para o idMovimento informado."
		Return .F.
	EndIf

Return .T.


/*/{Protheus.doc} movimentExists
Verifica se já existe movimento gravado com o mesmo UUID de movimento.
@type method
@version 1.0
@author rodrigo.nsoledade
@since 06/04/2026
@param cIdMov, character, UUID do movimento
@return logical, true quando já existir registro
/*/
method movimentExists(cIdMov as Character) as logical class ContractACLMovimentService
	Local cQuery      As Character
	Local oStatement  As Object
	Local nQtde       As Numeric

	cQuery := " SELECT COUNT(*) AS QTDE "
	cQuery += " FROM " + RetSqlName("NEI") + " NEI "
	cQuery += " WHERE NEI_FILIAL = ? "
	cQuery += "   AND NEI_IDMOV = ? "
	cQuery += "   AND NEI.D_E_L_E_T_ = ' ' "

	cQuery := ChangeQuery(cQuery)

	oStatement := FWPreparedStatement():New()
	oStatement:SetQuery(cQuery)
	oStatement:SetString(1, FWxFilial("NEI"))
	oStatement:SetString(2, cIdMov)

	cQuery := oStatement:GetFixQuery()
	nQtde  := MpSysExecScalar(cQuery, "QTDE")

Return (nQtde > 0)

/*/{Protheus.doc} deleteByIdMovto
Realiza a deleção do movimento do contrato
@type method
@version 12
@author gilson.venturi
@since 09/04/2025
@param cChave, character, idContrato + sequencia do movimento (NEI_FILIAL + NEI_CODCTR + NEI_SEQ)
/*/
method deleteByIdMovto(cChave as character) class ContractACLMovimentService
	local oRepository as object

	oRepository:= ContractACLMovimentRepository():New()
	oRepository:deleteByIdMovto(cChave)

	::setFullResponse(oRepository)

	oRepository:DeActivate()
	FWFreeObj(oRepository)
return
