#include "tlpp-core.th"
#include "totvs.ch"

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} FiscalMovementService
Classe de serviço responsavel pela regra de negócio da API de consulta de movimentações fiscais destinadas a integração de rebate.
@type class
@author beatriz.dantas
@since 04/08/2026
@version p12
/*/
class FiscalMovementService from UtilsService
	public method new()
	public method listarMovimentosFiscais()
endclass

/*/{Protheus.doc} new
Construtor da classe SalesPurchaseOrderRebateService.
@type method
@author beatriz.dantas
@since 17/07/2026
@version p12
@param nPage, param_type, param_descr
@param nPageSize, param_type, param_descr
@param jQueryParams, param_type, param_descr
@return Self, object, instância do repositório de movimentações fiscais
/*/
method new() class FiscalMovementService
	_Super:new()
return Self

/*/{Protheus.doc} listarMovimentosFiscais
Executa a consulta dos movimentos fiscais para integração de rebate.
@type method
@author beatriz.dantas
@since 04/08/2026
@version p12
@param nPage, param_type, param_descr
@param nPageSize, param_type, param_descr
@param jQueryParams, param_type, param_descr
@return return_var, nil, retorna nil caso o modulo SIGAAGD nao esteja ativo
/*/
method listarMovimentosFiscais(nPage, nPageSize, jQueryParams) class FiscalMovementService
	Local oRepository    as object 
	
    Default nPage        := 1
	Default nPageSize    := 10
	Default jQueryParams := nil

	If !(::isSIGAAGDactive())
		return nil
	EndIf

	oRepository := FiscalMovementRepository():new()
	oRepository:find(nPage,nPageSize,jQueryParams)

	Self:setFullResponse(oRepository)

	oRepository:DeActivate()
	FreeObj(oRepository)
Return nil
