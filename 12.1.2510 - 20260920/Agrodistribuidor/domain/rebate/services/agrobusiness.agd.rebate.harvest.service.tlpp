#include 'totvs.ch'
#include 'tlpp-core.th'

namespace totvs.protheus.agrobusiness.agd  

/*/{Protheus.doc} RebateHarvestService
Serviço de Safras
@type class
@version 12
@author ronery.filho
@since 31/07/2026
/*/
class RebateHarvestService from UtilsService
	public method new()
	public method listar()
endclass

/*/{Protheus.doc} RebateHarvestService::new
Construtor
@type method
@version 12
@author ronery.filho
@since 31/07/2026
@return object, self
/*/
method new() class RebateHarvestService
	_Super:New()
return self

/*/{Protheus.doc} RebateHarvestService::listar
Listagem dos registros da tabela
@type method
@version 12
@author ronery.filho
@since 31/07/2026
@param nPage, numeric, numero da pagina
@param nPageSize, numeric, tamanho da pagina
@param jQueryParam, json, query
/*/
method listar(nPage as numeric, nPageSize as numeric, jQueryParam as json) class RebateHarvestService
	local oSafraRepo as object
	
    default nPage       := 1
	default nPageSize   := 10
	default jQueryParam := nil

	If !Self:isSIGAAGDActive()
		return Nil
	endif

	oSafraRepo := RebateHarvestRepository():New()
	oSafraRepo:find(nPage, nPageSize, jQueryParam)

	::setFullResponse(oSafraRepo)

	FreeObj(oSafraRepo)
return
