#include 'totvs.ch'
#include 'tlpp-core.th'
#include 'agrobusiness.agd.rebate.sales.purchase.order.service.ch'

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} SalesPurchaseOrderRebateSevice
Classe de serviço responsavel pela regra de negócio da API de consulta de pedidos destinados a integração de rebate.
@type class
@author beatriz.dantas
@since 17/07/2026
@version p12
/*/
class SalesPurchaseOrderRebateSevice from UtilsService
	public method new()
	public method listarPedidos()
endClass

/*/{Protheus.doc} new
Construtor da classe SalesPurchaseOrderRebateService.
@type method
@author beatriz.dantas
@since 17/07/2026
@version p12
@param param_name, param_type, param_descr
@return return_var, return_type, return_description
/*/
method new() class SalesPurchaseOrderRebateSevice
	_Super:new()
return Self

/*/{Protheus.doc} listarPedidos
Executa a consulta dos pedidos de venda e compra para integração de rebate.
@type method
@author beatriz.dantas
@since 20/07/2026
@version p12
@param param_name, param_type, param_descr
@return return_var, return_type, return_description
/*/
method listarPedidos(nPage, nPageSize, jQueryParams) class SalesPurchaseOrderRebateSevice
	Local oRepository    as object 
	
    Default nPage        := 1
	Default nPageSize    := 10
	Default jQueryParams := nil

	If !(::isSIGAAGDactive())
		Self:setError(STR0001, 403) //"Módulo SIGAAGD não está ativo."
		return nil
	EndIf

	oRepository := SalesPurchaseOrderRebateRepository():New()
	oRepository:find(nPage,nPageSize,jQueryParams)

	Self:setFullResponse(oRepository)

	oRepository:DeActivate()
	FreeObj(oRepository)
Return nil
