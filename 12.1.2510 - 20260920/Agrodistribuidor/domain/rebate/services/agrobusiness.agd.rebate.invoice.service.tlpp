#include 'totvs.ch'
#include 'tlpp-core.th'

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} RebateInvoiceService
Service responsavel pela consulta consolidada das notas fiscais
utilizadas na integração de rebate.
@type class
@version 12
@author claudineia.reinert
@since 16/07/2026
/*/
class RebateInvoiceService from UtilsService
	public method new()
	public method findDataInvoice(nPage, nPageSize, jQueryParam)
	public method findBillingInvoiceData(nPage, nPageSize, jQueryParam)
endclass

/*/{Protheus.doc} RebateInvoiceService::new
Construtor
@type method
@version 12
@author claudineia.reinert
@since 16/07/2026
@return object, self
/*/
method new() class RebateInvoiceService
	_Super:New()
return self

/*/{Protheus.doc} RebateInvoiceService::findDataInvoice
Lista as notas fiscais de saída e entrada (devoluções)
@type method
@version 12
@author claudineia.reinert
@since 16/07/2026
@param nPage, numeric, numero da pagina
@param nPageSize, numeric, tamanho da pagina
@param jQueryParams, json, parametros da consulta
/*/
method findDataInvoice(nPage,nPageSize,jQueryParams) class RebateInvoiceService
	Local oOutboundRepository := RebateOutboundInvoiceRepository():New()
	Local oInboundRepository  := RebateInboundInvoiceRepository():New()
	Local oResponse           := Nil
	Local oInboundResponse    := Nil
	Local aItems              := {}

	If !Self:isSIGAAGDactive()
		Return Nil
	EndIf

	// Consulta as notas fiscais de saída e propaga o erro do repository.
	oOutboundRepository:findOutboundInvoices(nPage,nPageSize,jQueryParams)
	If !oOutboundRepository:isSuccess()
		Self:setFullResponse(oOutboundRepository)
		FWFreeObj(oInboundRepository)
		FWFreeObj(oOutboundRepository)
		Return Nil
	EndIf

	// Usa o envelope da saída como base, preservando os dados da paginação.
	oResponse := oOutboundRepository:getResponse()
	aItems := AClone(oResponse["items"])

	// Consulta as devoluções e adiciona cada item ao array, sem criar array aninhado.
	oInboundRepository:findInboundInvoices(nPage,nPageSize,jQueryParams)
	If !oInboundRepository:isSuccess()
		Self:setFullResponse(oInboundRepository)
		FWFreeObj(oInboundRepository)
		FWFreeObj(oOutboundRepository)
		Return Nil
	EndIf

	oInboundResponse := oInboundRepository:getResponse()
	AEval(oInboundResponse["items"],{|oItem| AAdd(aItems,oItem)})

	oResponse["items"] := aItems
	oResponse["total"] += oInboundResponse["total"]
	oResponse["remainingRecords"] += oInboundResponse["remainingRecords"]
	oResponse["hasNext"] := oResponse["hasNext"] .Or. oInboundResponse["hasNext"]

	Self:setSuccess(oResponse)

	FWFreeObj(oInboundRepository)
	FWFreeObj(oOutboundRepository)
Return Nil


/*/{Protheus.doc} findBillingInvoiceData
Lista as notas fiscais de saída e entrada (devoluções)
@type method
@version 12
@author gilson.venturi
@since 04/08/2026
@param nPage, numeric, numero da pagina
@param nPageSize, numeric, tamanho da pagina
@param jQueryParams, json, parametros da consulta
/*/
method findBillingInvoiceData(nPage,nPageSize,jQueryParams) class RebateInvoiceService
