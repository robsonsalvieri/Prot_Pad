#include 'totvs.ch'
#include 'tlpp-core.th'

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} RebateService
Service das filiais para o rebate
@type class
@version 12
@author claudineia.reinert
@since 16/07/2026
/*/
class RebateBranchesService from UtilsService
	public method new()
	public method listBranchData(cCodigoRevenda as Character, cFabricanteID as Character)
endclass

/*/{Protheus.doc} RebateBranchesService::new
Construtor
@type method
@version 12
@author claudineia.reinert
@since 16/07/2026
@return object, self
/*/
method new() class RebateBranchesService
	_Super:New()
return self

/*/{Protheus.doc} RebateBranchesService::listBranchData
Lista as filiais e seus respectivos dados para o rebate
@type method
@version 12
@author claudineia.reinert
@since 16/07/2026
@param cCodigoRevenda, character, código da revenda (filial) para filtrar a consulta
@param cFabricanteID, character, identificador do fabricante recebido na rota
/*/
method listBranchData(cCodigoRevenda as character,cFabricanteID as character) class RebateBranchesService
	local oRebateBranchesRepository as object

	if ! ::isSIGAAGDactive()
		return nil
	endIf

	oRebateBranchesRepository := RebateBranchesRepository():New()
	oRebateBranchesRepository:listBranchData(cCodigoRevenda, cFabricanteID)

	::setFullResponse(oRebateBranchesRepository)

	FWFreeObj(oRebateBranchesRepository)
return
