#Include "totvs.ch"
#Include "tlpp-core.th"

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} RebateOutboundInvoiceRepository
Repository responsavel pela consulta de notas fiscais de sai­da
para integraçao de rebate.
@type class
@version 1.0
@author rodrigo.nsoledade
@since 22/07/2026
/*/
Class RebateOutboundInvoiceRepository From UtilsRepository
	Private data cFilialUsada  As character

	Public Method New()
	Public Method findOutboundInvoices(nPage,nPageSize,jQueryParams)

	Private Method buildOutboundInvoiceQuery(jQueryParams) As Character
	Private Method getFields() As Array
	Private Method getItemFields() As Array
	Private Method formatResponse(jResponse) As Object

EndClass

/*/{Protheus.doc} New
Construtor da classe.
@type method
@version 1.0
@author rodrigo.nsoledade
@since 22/07/2026
@return object, instancia da classe
/*/
Method New() Class RebateOutboundInvoiceRepository
	Self:cFilialUsada := cFilAnt
	_Super:New("SF2")
Return Self

/*/{Protheus.doc} findOutboundInvoices
Consulta notas fiscais de sai­da conforme os filtros da requisição.
@type method
@version 1.0
@author rodrigo.nsoledade
@since 22/07/2026
@param nPage, numeric, numero da pagina
@param nPageSize, numeric, quantidade de registros por pagina
@param jQueryParams, json, parametros da query string
/*/
Method findOutboundInvoices(nPage,nPageSize,jQueryParams) Class RebateOutboundInvoiceRepository
	Local cOrder  := "F2_EMISSAO, F2_DOC, F2_SERIE"
	Local cQuery  := ""
	Local cWhere  := ""
	Local aFields := AClone(Self:getFields())
	Local jResponse As Object

	Default nPage := 1
	Default nPageSize := 10
	Default jQueryParams := Nil

	If jQueryParams != Nil .And. jQueryParams:HasProperty("codi_rev") .And. !Empty(jQueryParams["codi_rev"])
		Self:cFilialUsada := jQueryParams["codi_rev"]
		jQueryParams["codi_rev"] := FWxFilial('SF2',Self:cFilialUsada)
	EndIf

	nPageSize := Min(nPageSize,200)
	cQuery := Self:buildOutboundInvoiceQuery(jQueryParams)
	cOrder := Self:getOrderQueryParam(jQueryParams,Self:getFields())
	cWhere := Self:getWhereQueryParam(jQueryParams,Self:getFields())

	AEval(Self:getItemFields(),{|aField| AAdd(aFields,aField)})

	Self:setFieldsConsulta(aFields)
	Self:setPage(nPage)
	Self:setPageSize(nPageSize)
	Self:SetQuery(Self:getQueryDefault(,cQuery))
	Self:SetWhere(if(Empty(cWhere),"1=1",cWhere))
	self:SetUrlFilter(self:getFilterAdvancedQueryParam(jQueryParams))
	Self:SetUseSpaces(.F.)
	Self:SetOrder(cOrder)

	If Self:Execute()
		Self:FillGetResponse()

		If Self:lOk
			jResponse := Self:convertToJson(Self:getJSONResponse())
			Self:setSuccess(Self:formatResponse(jResponse))
		EndIf
	EndIf

Return Nil

/*/{Protheus.doc} buildOutboundInvoiceQuery
Monta a consulta das notas fiscais de saída.
@type method
@version 1.0
@author rodrigo.nsoledade
@since 22/07/2026
@param jQueryParams, json, filtros opcionais: codi_rev, data_ini (YYYYMMDD), data_fim (YYYYMMDD), fabricanteID
@return character, consulta SQL preparada
/*/
Method buildOutboundInvoiceQuery(jQueryParams) As Character Class RebateOutboundInvoiceRepository
	Local cQuery        := ""
	Local oStatement    := FWPreparedStatement():New()
	Local aBindParam    := {}
	Local nParamPos     := 1
	Local nX            := 0
	Local cDataIni      := ""
	Local cDataFim      := ""
	Local cFabricanteID := ""
	Local cFilialSF2    := ""

	Default jQueryParams := Nil

	If ValType(jQueryParams) == "J"
		If jQueryParams:HasProperty("data_ini")
			cDataIni := AllTrim(jQueryParams["data_ini"])
		EndIf

		If jQueryParams:HasProperty("data_fim")
			cDataFim := AllTrim(jQueryParams["data_fim"])
		EndIf

		If jQueryParams:HasProperty("fabricanteID")
			cFabricanteID := AllTrim(jQueryParams["fabricanteID"])
		EndIf
	EndIf

	cFilialSF2 := FWXFilial("SF2", Self:cFilialUsada)

	cQuery += " SELECT SF2.R_E_C_N_O_ AS RECNOSF2, "
	cQuery += "        SF2.D_E_L_E_T_, "
	cQuery += "        F2_FILIAL, "
	cQuery += "        CONCAT(NCR_FABCOD, CONCAT('.', NCR_FABLOJ)) AS FABRICANTE, "
	cQuery += "        F2_CHVNFE AS MODELODOCUMENTO, "
	cQuery += "        ' ' AS EMITENTEVENDA, "
	cQuery += "        F2_DOC, "
	cQuery += "        F2_SERIE, "
	cQuery += "        F2_CHVNFE, "

	cQuery += "        CASE F2_TIPO "
	cQuery += "             WHEN 'N' THEN '1 - NF-e Normal' "
	cQuery += "             WHEN 'C' THEN '2 - NF-e Complementar' "
	cQuery += "             WHEN 'I' THEN '2 - NF-e Complementar' "
	cQuery += "             WHEN 'P' THEN '2 - NF-e Complementar' "
	cQuery += "             WHEN 'D' THEN '4 - Devolução de Mercadoria' "
	cQuery += "             ELSE '1 - NF-e Normal' "
	cQuery += "        END AS F2_TIPO, "

	cQuery += "        F2_EMISSAO, "
	cQuery += "        (SELECT MAX(E1_VENCTO) "
	cQuery += "           FROM " + RetSqlName("SE1") + " SE1 "
	cQuery += "          WHERE SE1.D_E_L_E_T_ = ' ' "
	cQuery += "            AND E1_FILIAL = F2_FILIAL "
	cQuery += "            AND E1_NUM = F2_DOC "
	cQuery += "            AND E1_PREFIXO = F2_SERIE "
	cQuery += "            AND E1_CLIENTE = F2_CLIENTE "
	cQuery += "            AND E1_LOJA = F2_LOJA) AS DATAVENCIMENTO, "

	cQuery += "        CASE WHEN D2_NFORI = ' ' "
	cQuery += "             THEN D2_PEDIDO "
	cQuery += "             ELSE CONCAT(D2_NFORI, CONCAT('.', D2_SERIORI)) "
	cQuery += "        END AS ORIGEMVENDA, "

	cQuery += "        F2_COND, "
	cQuery += "        E4_COND, "
	cQuery += "        E4_DESCRI, "
	cQuery += "        'R' AS TIPOCONDICAO, "
	cQuery += "        CASE WHEN F2_MOEDA = '1' THEN NULL ELSE F2_MOEDA END AS INDEXADORMOEDA, "
	cQuery += "        NULL AS DESCINDEXADORMOEDA, "
	cQuery += "        NULL AS UMINDEXADORMOEDA, "
	cQuery += "        CASE WHEN F2_MOEDA = '1' THEN NULL ELSE F2_TXMOEDA END AS COTACAOINDEXADORMOEDA, "
	cQuery += "        F4_CODIGO, "
	cQuery += "        F4_TEXTO, "
	cQuery += "        F4_TIPO, "
	cQuery += "        F4_CF, "
	cQuery += "        CASE WHEN FT_DTCANC = ' ' THEN 'A' ELSE 'C' END AS STATUSNF, "
	cQuery += "        CONCAT(SA1.A1_COD, CONCAT('.', SA1.A1_LOJA)) AS CODIGOCLIENTE, "
	cQuery += "        SA1.A1_CGC, "
	cQuery += "        SA1.A1_INSCR, "
	cQuery += "        SA1.A1_NOME, "
	cQuery += "        SA1.A1_END, "
	cQuery += "        SA1.A1_EST, "
	cQuery += "        SA1.A1_BAIRRO, "
	cQuery += "        SA1.A1_COMPLEM, "
	cQuery += "        SA1.A1_CEP, "
	cQuery += "        SA1.A1_COD_MUN, "
	cQuery += "        SA1.A1_DDD, "
	cQuery += "        SA1.A1_TEL, "
	cQuery += "        SA1.A1_EMAIL, "
	cQuery += "        ' ' AS DATAULTIMAMOVIMENTACAODB, "
	cQuery += "        D2_COD, "
	cQuery += "        B1_DESC, "
	cQuery += "        D2_UM, "
	cQuery += "        B1_POSIPI, "
	cQuery += "        B1_CODBAR, "
	cQuery += "        D2_LOTECTL, "
	cQuery += "        NULL AS CODIGOPRODUTOFABRICANTE, "
	cQuery += "        NULL AS TRATAMENTO, "
	cQuery += "        CASE WHEN B5_SEMENTE = '1' THEN 'S' ELSE 'D' END AS SEMENTE, "
	cQuery += "        ISNULL(D2_VALICM,0) + ISNULL(D2_ICMSRET,0) + ISNULL(D2_ICMSCOM,0) + ISNULL(D2_DIFAL,0) + ISNULL(D2_VFCPDIF,0) + ISNULL(D2_VALIPI,0) AS VALORTRIBUTOS, "
	cQuery += "        NCR_CULTUR, "
	cQuery += "        NP3_DESCRI, "
	cQuery += "        ' ' AS CULTURARECEITUARIO, "
	cQuery += "        ' ' AS DESCCULTURARECEITUARIO, "
	cQuery += "        FT_TOTAL, "
	cQuery += "        D2_TOTAL, "
	cQuery += "        D2_QUANT, "
	cQuery += "        F2_VEND1, "
	cQuery += "        A3_NOME, "
	cQuery += "        A3_CGC, "
	cQuery += "        SA1ENTREGA.A1_CGC AS CGCDESTINATARIO, "
	cQuery += "        SA1ENTREGA.A1_END AS ENDERECOENTREGA, "
	cQuery += "        SA1ENTREGA.A1_BAIRRO AS BAIRROENTREGA, "
	cQuery += "        SA1ENTREGA.A1_COMPLEM AS COMPLEMENTOENTREGA, "
	cQuery += "        SA1ENTREGA.A1_CEP AS CEPENTREGA, "
	cQuery += "        SA1ENTREGA.A1_EST AS ESTADOENTREGA, "
	cQuery += "        SA1ENTREGA.A1_COD_MUN AS MUNICIPIOENTREGA, "
	cQuery += "        ' ' AS NASCIMENTOVENDEDOR, "
	cQuery += "        ' ' AS NPISVENDEDOR "

	cQuery += "   FROM " + RetSqlName("SF2") + " SF2 "

	cQuery += "  INNER JOIN " + RetSqlName("SD2") + " SD2 "
	cQuery += "     ON SD2.D_E_L_E_T_ = ' ' "
	cQuery += "    AND D2_FILIAL = F2_FILIAL "
	cQuery += "    AND D2_DOC = F2_DOC "
	cQuery += "    AND D2_SERIE = F2_SERIE "
	cQuery += "    AND D2_CLIENTE = F2_CLIENTE "
	cQuery += "    AND D2_LOJA = F2_LOJA "

	cQuery += "  INNER JOIN " + RetSqlName("SB1") + " SB1 "
	cQuery += "     ON SB1.D_E_L_E_T_ = ' ' "
	cQuery += "    AND B1_FILIAL = ? " ;AAdd(aBindParam, FWXFilial("SB1", Self:cFilialUsada))
	cQuery += "    AND B1_COD = D2_COD "

	cQuery += "  INNER JOIN " + RetSqlName("SA1") + " SA1 "
	cQuery += "     ON SA1.D_E_L_E_T_ = ' ' "
	cQuery += "    AND A1_FILIAL = ? " ;AAdd(aBindParam, FWXFilial("SA1", Self:cFilialUsada))
	cQuery += "    AND A1_COD = F2_CLIENTE "
	cQuery += "    AND A1_LOJA = F2_LOJA "

	cQuery += "  INNER JOIN " + RetSqlName("NCR") + " NCR "
	cQuery += "     ON NCR.D_E_L_E_T_ = ' ' "
	cQuery += "    AND NCR_FILIAL = B1_FILIAL "
	cQuery += "    AND NCR_PROD = D2_COD "

	cQuery += "  INNER JOIN " + RetSqlName("SA2") + " FAB "
	cQuery += "     ON FAB.D_E_L_E_T_ = ' ' "
	cQuery += "    AND FAB.A2_FILIAL = ? " ;AAdd(aBindParam, FWXFilial("SA2", Self:cFilialUsada))
	cQuery += "    AND FAB.A2_COD = NCR_FABCOD "
	cQuery += "    AND FAB.A2_LOJA = NCR_FABLOJ "	

	cQuery += "  INNER JOIN " + RetSqlName("SE4") + " SE4 "
	cQuery += "     ON SE4.D_E_L_E_T_ = ' ' "
	cQuery += "    AND E4_FILIAL = ? " ;AAdd(aBindParam, FWXFilial("SE4", Self:cFilialUsada))
	cQuery += "    AND E4_CODIGO = F2_COND "

	cQuery += "  INNER JOIN " + RetSqlName("SF4") + " SF4 "
	cQuery += "     ON SF4.D_E_L_E_T_ = ' ' "
	cQuery += "    AND F4_FILIAL = ? " ;AAdd(aBindParam, FWXFilial("SF4", Self:cFilialUsada))
	cQuery += "    AND F4_CODIGO = D2_TES "

	cQuery += "   LEFT JOIN " + RetSqlName("SFT") + " SFT "
	cQuery += "     ON SFT.D_E_L_E_T_ = ' ' "
	cQuery += "    AND FT_FILIAL = ? " ;AAdd(aBindParam, FWXFilial("SFT", Self:cFilialUsada))
	cQuery += "    AND FT_TIPOMOV = 'S' "
	cQuery += "    AND FT_SERIE = F2_SERIE "
	cQuery += "    AND FT_NFISCAL = F2_DOC "
	cQuery += "    AND FT_CLIEFOR = D2_CLIENTE "
	cQuery += "    AND FT_LOJA = D2_LOJA "
	cQuery += "    AND FT_ITEM = D2_ITEM "
	cQuery += "    AND FT_PRODUTO = D2_COD "

	cQuery += "   LEFT JOIN " + RetSqlName("SB5") + " SB5 "
	cQuery += "     ON SB5.D_E_L_E_T_ = ' ' "
	cQuery += "    AND B5_FILIAL = B1_FILIAL "
	cQuery += "    AND B5_COD = B1_COD "

	cQuery += "   LEFT JOIN " + RetSqlName("NP3") + " NP3 "
	cQuery += "     ON NP3.D_E_L_E_T_ = ' ' "
	cQuery += "    AND NP3_FILIAL = ? " ;AAdd(aBindParam, FWXFilial("NP3", Self:cFilialUsada))
	cQuery += "    AND NP3_CODIGO = NCR_CULTUR "

	cQuery += "   LEFT JOIN " + RetSqlName("SA3") + " SA3 "
	cQuery += "     ON SA3.D_E_L_E_T_ = ' ' "
	cQuery += "    AND A3_FILIAL = ? " ;AAdd(aBindParam, FWXFilial("SA3", Self:cFilialUsada))
	cQuery += "    AND A3_COD = F2_VEND1 "

	cQuery += "   LEFT JOIN " + RetSqlName("SA1") + " SA1ENTREGA "
	cQuery += "     ON SA1ENTREGA.D_E_L_E_T_ = ' ' "
	cQuery += "    AND SA1ENTREGA.A1_FILIAL = ? " ;AAdd(aBindParam, FWXFilial("SA1", Self:cFilialUsada))
	cQuery += "    AND SA1ENTREGA.A1_COD = F2_CLIENT "
	cQuery += "    AND SA1ENTREGA.A1_LOJA = F2_LOJENT "

	cQuery += "  WHERE SF2.D_E_L_E_T_ = ' ' "
	cQuery += "    AND F2_FILIAL = ? " ;AAdd(aBindParam, cFilialSF2)
	cQuery += "    AND F2_FIMP = 'S' "
	cQuery += "    AND F2_CHVNFE <> ' ' "

	If !Empty(cDataIni)
		cQuery += "    AND F2_EMISSAO >= ? "
		AAdd(aBindParam, cDataIni)
	EndIf

	If !Empty(cDataFim)
		cQuery += "    AND F2_EMISSAO <= ? "
		AAdd(aBindParam, cDataFim)
	EndIf

	If !Empty(cFabricanteID)
		cQuery += "    AND LTRIM(RTRIM(FAB.A2_COD)) = ? "
		AAdd(aBindParam, SubStr(AllTrim(cFabricanteID), 1, TAMSX3("A2_COD")[1]))
	EndIf

	oStatement:SetQuery(cQuery)

	For nX := 1 To Len(aBindParam)
		oStatement:SetString(nParamPos++, aBindParam[nX])
	Next nX

	cQuery := ChangeQuery(oStatement:GetFixQuery())

Return cQuery

/*/{Protheus.doc} getFields
Define os campos do cabeçalho da nota fiscal.
@type method
@author rodrigo.nsoledade
@return array, mapeamento dos campos
/*/
Method getFields() As Array Class RebateOutboundInvoiceRepository
	Local aFields := {}

	AAdd(aFields,{"codi_ven","RECNOSF2","N",.T.})
	AAdd(aFields,{"codi_rev","F2_FILIAL","C",.T.})
	AAdd(aFields,{"codi_fab","FABRICANTE","C",.T.})
	AAdd(aFields,{"modl_ven","MODELODOCUMENTO","C",.T.})
	AAdd(aFields,{"emit_ven","EMITENTEVENDA","C",.T.})
	AAdd(aFields,{"nume_ven","F2_DOC","C",.T.})
	AAdd(aFields,{"seri_ven","F2_SERIE","C",.T.})
	AAdd(aFields,{"chav_ven","F2_CHVNFE","C",.T.})
	AAdd(aFields,{"fina_ven","F2_TIPO","C",.T.})
	AAdd(aFields,{"data_ven","F2_EMISSAO","D",.T.})
	AAdd(aFields,{"datv_ven","DATAVENCIMENTO","D",.T.})
	AAdd(aFields,{"orig_ven","ORIGEMVENDA","C",.T.})
	AAdd(aFields,{"codi_con","F2_COND","C",.T.})
	AAdd(aFields,{"praz_con","E4_COND","C",.T.})
	AAdd(aFields,{"desc_con","E4_DESCRI","C",.T.})
	AAdd(aFields,{"tipo_con","TIPOCONDICAO","C",.T.})
	AAdd(aFields,{"inde_ven","INDEXADORMOEDA","C",.T.})
	AAdd(aFields,{"dind_ven","DESCINDEXADORMOEDA","C",.T.})
	AAdd(aFields,{"bund_ven","UMINDEXADORMOEDA","C",.T.})
	AAdd(aFields,{"cota_ven","COTACAOINDEXADORMOEDA","N",.T.})
	AAdd(aFields,{"oper_ven","F4_CODIGO","C",.T.})
	AAdd(aFields,{"desc_opr","F4_TEXTO","C",.T.})
	AAdd(aFields,{"sina_opr","F4_TIPO","C",.T.})
	AAdd(aFields,{"cfop_ven","F4_CF","C",.T.})
	AAdd(aFields,{"stat_ven","STATUSNF","C",.T.})

	AAdd(aFields,{"codi_cli","CODIGOCLIENTE","C",.T.})
	AAdd(aFields,{"cnpj_cli","A1_CGC","C",.T.})
	AAdd(aFields,{"insc_cli","A1_INSCR","C",.T.})
	AAdd(aFields,{"nome_cli","A1_NOME","C",.T.})
	AAdd(aFields,{"enco_cli","A1_END","C",.T.})
	AAdd(aFields,{"bair_cli","A1_BAIRRO","C",.T.})
	AAdd(aFields,{"comp_cli","A1_COMPLEM","C",.T.})
	AAdd(aFields,{"cepc_cli","A1_CEP","C",.T.})
	AAdd(aFields,{"muni_cli","A1_COD_MUN","C",.T.})
	AAdd(aFields,{"estd_cli","A1_EST","C",.T.})
	AAdd(aFields,{"ddd_cli","A1_DDD","C",.T.})
	AAdd(aFields,{"tele_cli","A1_TEL","C",.T.})
	AAdd(aFields,{"celu_cli","A1_TEL","C",.T.})
	AAdd(aFields,{"emai_cli","A1_EMAIL","C",.T.})
	AAdd(aFields,{"duma_cli","DATAULTIMAMOVIMENTACAODB","C",.T.})

	AAdd(aFields,{"codi_ved","F2_VEND1","C",.T.})
	AAdd(aFields,{"nome_ved","A3_NOME","C",.T.})
	AAdd(aFields,{"cpfc_ved","A3_CGC","C",.T.})
	AAdd(aFields,{"nasc_ved","NASCIMENTOVENDEDOR","D",.T.})
	AAdd(aFields,{"npis_ved","NPISVENDEDOR","C",.T.})

	AAdd(aFields,{"dest_ven","CGCDESTINATARIO","C",.T.})
	AAdd(aFields,{"enco_ivn","ENDERECOENTREGA","C",.T.})
	AAdd(aFields,{"bair_ivn","BAIRROENTREGA","C",.T.})
	AAdd(aFields,{"comp_ivn","COMPLEMENTOENTREGA","C",.T.})
	AAdd(aFields,{"cepc_ivn","CEPENTREGA","C",.T.})
	AAdd(aFields,{"muni_ivn","MUNICIPIOENTREGA","C",.T.})
	AAdd(aFields,{"estd_ivn","ESTADOENTREGA","C",.T.})
Return aFields

/*/{Protheus.doc} getItemFields
Define os campos dos itens da nota fiscal.
@type method
@author rodrigo.nsoledade
@return array, mapeamento dos campos
/*/
Method getItemFields() As Array Class RebateOutboundInvoiceRepository
	Local aFields := {}

	AAdd(aFields,{"codi_pro","D2_COD","C",.T.})
	AAdd(aFields,{"desc_pro","B1_DESC","C",.T.})
	AAdd(aFields,{"unid_pro","D2_UM","C",.T.})
	AAdd(aFields,{"ncmp_pro","B1_POSIPI","C",.T.})
	AAdd(aFields,{"barr_pro","B1_CODBAR","C",.T.})
	AAdd(aFields,{"cind_pro","CODIGOPRODUTOFABRICANTE","C",.T.})
	AAdd(aFields,{"lote_ivn","D2_LOTECTL","C",.T.})
	AAdd(aFields,{"fsem_pro","SEMENTE","C",.T.})
	AAdd(aFields,{"trat_pro","TRATAMENTO","C",.T.})
	AAdd(aFields,{"trib_ivn","VALORTRIBUTOS","N",.T.})
	AAdd(aFields,{"codi_cul","NCR_CULTUR","C",.T.})
	AAdd(aFields,{"desc_cul","NP3_DESCRI","C",.T.})
	AAdd(aFields,{"crec_ivn","CULTURARECEITUARIO","C",.T.})
	AAdd(aFields,{"drec_ivn","DESCCULTURARECEITUARIO","C",.T.})
	AAdd(aFields,{"pbru_ivn","FT_TOTAL","N",.T.})
	AAdd(aFields,{"pliq_ivn","D2_TOTAL","N",.T.})
	AAdd(aFields,{"qtde_ivn","D2_QUANT","N",.T.})
Return aFields

/*/{Protheus.doc} formatResponse
Formata campos derivados e aplica a proteção de dados pessoais.
@type method
@author rodrigo.nsoledade
@param jResponse, json, resposta da consulta
@return object, resposta formatada
/*/
Method formatResponse(jResponse) As Object Class RebateOutboundInvoiceRepository
	Local jItem  as Object
	Local aItems := {} as Array
	Local aProtectedFields as Array
	Local aAllowedFields as Array
	Local aProtectedMap as Array 
	Local aSM0Data := {}
	Local aJsonFields := {}
	Local nItem := 0
	Local nField := 0
	Local nJsonField := 0

	aItems := jResponse["items"]
	aProtectedFields := {"A1_CGC","A1_INSCR","A1_NOME","A1_END","A1_BAIRRO","A1_COMPLEM","A1_CEP","A1_TEL","A1_EMAIL"}
	aAllowedFields := FwProtectedDataUtil():UsrAccessPDField(__cUserID,aProtectedFields)
	aProtectedMap := {;
		{"A1_CGC"            ,{"cnpj_cli","emit_ven"}},;
		{"A1_INSCR"          ,{"insc_cli"}},;
		{"A1_NOME"           ,{"nome_cli"}},;
		{"A1_END"            ,{"enco_cli"}},;
		{"A1_BAIRRO"         ,{"bair_cli"}},;
		{"A1_COMPLEM"        ,{"comp_cli"}},;
		{"A1_CEP"            ,{"cepc_cli"}},;
		{"A1_TEL"            ,{"tele_cli","celu_cli"}},;
		{"A1_EMAIL"          ,{"emai_cli"}},;
		{"A1_CGC"            ,{"dest_ven"}},;
		{"A1_END"            ,{"enco_ivn"}},;
		{"A1_BAIRRO"         ,{"bair_ivn"}},;
		{"A1_COMPLEM"        ,{"comp_ivn"}},;
		{"A1_CEP"            ,{"cepc_ivn"}}}

	For nItem := 1 To Len(aItems)
		jItem := aItems[nItem]
		aSM0Data := FWSM0Util():GetSM0Data(cEmpAnt,jItem["codi_rev"],{"M0_CGC"})

		jItem["codi_ven"] := cValToChar(jItem["codi_ven"])
		jItem["modl_ven"] := SubStr(jItem["modl_ven"],21,2)
		jItem["emit_ven"] := IIf(Len(aSM0Data) > 0,AllTrim(aSM0Data[1][2]),"")
		jItem["nume_cli"] := TrataEnd(jItem["enco_cli"],"N")
		jItem["enco_cli"] := TrataEnd(jItem["enco_cli"],"L")
		jItem["nume_ivn"] := TrataEnd(jItem["enco_ivn"],"N")
		jItem["enco_ivn"] := TrataEnd(jItem["enco_ivn"],"L")
		jItem["muni_cli"] := Tms120CdUf(jItem["estd_cli"],"1") + AllTrim(jItem["muni_cli"])
		jItem["muni_ivn"] := Tms120CdUf(jItem["estd_ivn"],"1") + AllTrim(jItem["muni_ivn"])
		jItem["insc_cli"] := IIf(Empty(jItem["insc_cli"]),"ISENTO",jItem["insc_cli"])
		jItem["tele_cli"] := IIf(Empty(jItem["ddd_cli"]),AllTrim(jItem["tele_cli"]),"(" + AllTrim(jItem["ddd_cli"]) + ") " + AllTrim(jItem["tele_cli"]))
		jItem["celu_cli"] := IIf(Empty(jItem["ddd_cli"]),AllTrim(jItem["celu_cli"]),"(" + AllTrim(jItem["ddd_cli"]) + ") " + AllTrim(jItem["celu_cli"]))
		jItem:DelName("ddd_cli")

		For nField := 1 To Len(aProtectedMap)
			If AScan(aAllowedFields,aProtectedMap[nField][1]) == 0
				aJsonFields := aProtectedMap[nField][2]

				For nJsonField := 1 To Len(aJsonFields)
					If jItem:HasProperty(aJsonFields[nJsonField])
						jItem[aJsonFields[nJsonField]] := FwProtectedDataUtil():ValueAsteriskToAnonymize(jItem[aJsonFields[nJsonField]])
					EndIf
				Next nJsonField
			EndIf
		Next nField
	Next nItem

	jResponse["items"] := aItems
Return jResponse
