#include 'totvs.ch'
#include 'tlpp-core.th'

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} SalesPurchaseOrderRebateRepository
classe responsável por consultar os pedidos de venda e compra destinados a
integracao de rebate. Realiza a unificação das informações por meio de consultas
SQL, monta o layout de retorno conforme a especificação da integracao e aplica
anonimizacao de dados sensíveis quando configurada.
@type class
@author beatriz.dantas
@since 17/07/2026
@version p12
/*/
class SalesPurchaseOrderRebateRepository from UtilsRepository
	public method new()
	public method find()
	public method getFields() as array

	private method getQueryJoin() 				as array
	private method getUnionQuery() 				as character
	private method buildSalesOrderSelect() 		as character
	private method buildPurchaseOrderSelect() 	as character
	private method getManufacturerFilter() 		as character
	private method formatResponse(jResponse) 	as object 
	private method getSensitiveFieldsMap()		as array
	
	private data codigoFabricante as character
	private data cFilialUsada     as character
endclass

/*/{Protheus.doc} New
Inicializa a instância do repositório.
@type method
@author beatriz.dantas
@since 20/07/2026
@version p12
@return object, instÃ¢ncia da classe
/*/
method new() class SalesPurchaseOrderRebateRepository	
	self:codigoFabricante := ""
	self:cFilialUsada := cFilAnt
	_Super:new("SC7", self:getFields(), self:getQueryJoin(), self:getUnionQuery())
return self

/*/{Protheus.doc} find
Realiza a consulta paginada dos pedidos de venda e compra para integração de rebate.
@type method
@author beatriz.dantas
@since 20/07/2026
@version p12
@param nPage, numeric, Número da página a ser consultada.
@param nPageSize, numeric, Quantidade de registros por página.
@param jQueryParams, object, Objeto JSON contendo os filtros da consulta.
@return nil, nil, Resultado armazenado na resposta da classe.
/*/
method find(nPage,nPageSize,jQueryParams) class SalesPurchaseOrderRebateRepository
	Local aArea      as array
	Local cOrder     as character
	Local cWhere     as character
	Local cDataIni   as character
	Local cDataFim   as character
	Local cSep       as character
	Local jResponse  as object

	Default nPage        := 1
	Default nPageSize    := 10
	Default jQueryParams := Nil

	If self:lOk
		aArea  := FWGetArea()
		cOrder := self:getOrderQueryParam(jQueryParams,self:getFields())
		cWhere := self:getWhereQueryParam(jQueryParams,self:getFields())

		If ValType(jQueryParams) == "J"
			If jQueryParams:HasProperty("codiFab") .And. !Empty(jQueryParams["codiFab"])
				Self:codigoFabricante := AllTrim(jQueryParams["codiFab"])
			EndIf
			If jQueryParams:HasProperty("codi_rev") .And. !Empty(jQueryParams["codi_rev"])
				Self:cFilialUsada := jQueryParams["codi_rev"]
			EndIf
			If jQueryParams:hasProperty("data_ini") .And. !Empty(AllTrim(jQueryParams["data_ini"]))
				cDataIni := AllTrim(jQueryParams["data_ini"])
			EndIf
			If jQueryParams:hasProperty("data_fim") .And. !Empty(AllTrim(jQueryParams["data_fim"]))
				cDataFim := AllTrim(jQueryParams["data_fim"])
			EndIf
		EndIf

		If !Empty(cDataIni)
			cSep := Iif(Empty(cWhere), "", " AND ")
			cWhere += cSep + "DATA_PED >= '" + cDataIni + "'"
		EndIf
		If !Empty(cDataFim)
			cSep := Iif(Empty(cWhere), "", " AND ")
			cWhere += cSep + "DATA_PED <= '" + cDataFim + "'"
		EndIf

		self:setFieldsConsulta(self:getFields())
		self:setPage(nPage)
		self:setPageSize(nPageSize)
		self:SetQuery(self:getQueryDefault({},self:getUnionQuery()))
		Self:SetWhere(if(Empty(cWhere),"1=1",cWhere))
		self:SetUrlFilter(self:getFilterAdvancedQueryParam(jQueryParams))
		self:SetOrder(cOrder)

		If self:Execute()
			self:FillGetResponse()
			If self:lOk
				jResponse := self:convertToJson(self:getJSONResponse())
				self:setSuccess(self:formatResponse(jResponse))
			EndIf
		EndIf

		FWRestArea(aArea)
		FWFreeArray(aArea)
		FreeObj(jResponse)
	EndIf
Return Nil

