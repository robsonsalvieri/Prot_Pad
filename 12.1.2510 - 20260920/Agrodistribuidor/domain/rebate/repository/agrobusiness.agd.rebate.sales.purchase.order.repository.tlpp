/*/{Protheus.doc} getQueryJoin
Retorna os joins das consultas
@type method
@version 12
@author beatriz.dantas
@since 20/07/2026
@return array, {{cTipoJoin, cTabela, cCondicao}, ...}
/*/
method getQueryJoin() as array class SalesPurchaseOrderRebateRepository
return {}

/*/{Protheus.doc} getUnionQuery
Monta a consulta SQL principal unificando os pedidos de venda e compra.
@type method
@author beatriz.dantas
@since 20/07/2026
@version p12
@return character, query SQL completa
/*/
method getUnionQuery() As Character Class SalesPurchaseOrderRebateRepository
return self:buildSalesOrderSelect() + " UNION ALL " + self:buildPurchaseOrderSelect()

/*/{Protheus.doc} buildQueryVenda
Monta a consulta SQL responsavel por recuperar os pedidos de venda e suas informações relacionadas, como cliente, vendedor, produto e cultura.
@type method
@author beatriz.dantas
@since 20/07/2026
@version p12
@return cQrySalesOrder, character, Consulta SQL dos pedidos de venda.
/*/
method buildSalesOrderSelect() as character class SalesPurchaseOrderRebateRepository
	Local cQrySalesOrder := ""

	cQrySalesOrder := " SELECT "
	cQrySalesOrder += "        SC5.R_E_C_N_O_ AS CODI_PED, SC5.C5_FILIAL AS CODI_REV, "
	cQrySalesOrder += "        NCR.NCR_FABCOD AS CODI_FAB, SC5.C5_NUM AS NUME_PED, SC5.C5_SERIE AS SERI_PED, "
	cQrySalesOrder += "        SC5.C5_EMISSAO AS DATA_PED, CAST(NULL AS Date) AS DATV_PED, SC6.C6_DATFAT AS DATP_PED, "
	cQrySalesOrder += "        CASE "
	cQrySalesOrder += "            WHEN SC6.C6_QTDENT < SC6.C6_QTDVEN THEN 'A' "
	cQrySalesOrder += "            ELSE 'C' "
	cQrySalesOrder += "        END AS STAT_PED, "
	cQrySalesOrder += "        SC5.C5_CLIENTE AS COD_CLIRAW, SC5.C5_LOJACLI AS LOJ_CLIRAW, SA1.A1_CGC AS CNPJ_CLI, "
	cQrySalesOrder += "        SA1.A1_INSCR AS INSC_CLI, SA1.A1_NOME AS NOME_CLI, SA1.A1_END AS END_CLIRAW, "
	cQrySalesOrder += "        SA1.A1_BAIRRO AS BAIR_CLI, SA1.A1_COMPLEM AS COMP_CLI, SA1.A1_CEP AS CEPC_CLI, "
	cQrySalesOrder += "        SA1.A1_COD_MUN AS MUN_RAW, SA1.A1_EST AS EST_RAW, SC6.C6_PRODUTO AS CODI_PRO, "
	cQrySalesOrder += "        SB1.B1_DESC AS DESC_PRO, SB1.B1_POSIPI AS NCMP_PRO, SC6.C6_UM AS UNID_PRO, "
	cQrySalesOrder += "        SB1.B1_CODBAR AS BARR_PRO, Space(1) AS CIND_PRO, SC6.C6_LOTECTL AS LOTE_IVN, "
	cQrySalesOrder += "        0 AS TRIB_IVN, SC6.C6_CULTRA AS CODI_CUL, NP3.NP3_DESCRI AS DESC_CUL, "
	cQrySalesOrder += "        (SC6.C6_VALOR + SC6.C6_VALDESC) AS PBRU_PED, SC6.C6_VALOR AS PLIQ_PED, "
	cQrySalesOrder += "        SC6.C6_QTDVEN AS QTDE_PED, SC5.C5_VEND1 AS CODI_VED, SA3.A3_NOME AS NOME_VED, "
	cQrySalesOrder += "        SA3.A3_CGC AS CPFC_VED, 'V' AS FLG_TIPO "

	cQrySalesOrder += "   FROM " + RetSqlName("SC5") + " SC5 "

	cQrySalesOrder += "  INNER JOIN " + RetSqlName("SC6") + " SC6 "
	cQrySalesOrder += "     ON SC6.C6_FILIAL = SC5.C5_FILIAL "
	cQrySalesOrder += "    AND SC6.C6_NUM = SC5.C5_NUM "
	cQrySalesOrder += "    AND SC6.D_E_L_E_T_ = ' ' "

	cQrySalesOrder += "  INNER JOIN " + RetSqlName("SB1") + " SB1 "
	cQrySalesOrder += "     ON SB1.B1_COD = SC6.C6_PRODUTO "
	cQrySalesOrder += "    AND SB1.B1_FILIAL = '" + FWXFilial("SB1", Self:cFilialUsada) + "' "
	cQrySalesOrder += "    AND SB1.D_E_L_E_T_ = ' ' "

	cQrySalesOrder += "  INNER JOIN " + RetSqlName("NCR") + " NCR "
	cQrySalesOrder += "     ON NCR.NCR_PROD = SB1.B1_COD "
	cQrySalesOrder += "    AND NCR.NCR_FILIAL = SB1.B1_FILIAL "
	cQrySalesOrder += "    AND NCR.D_E_L_E_T_ = ' ' "

	cQrySalesOrder += "   LEFT JOIN " + RetSqlName("SA1") + " SA1 "
	cQrySalesOrder += "     ON SA1.A1_COD = SC5.C5_CLIENTE "
	cQrySalesOrder += "    AND SA1.A1_LOJA = SC5.C5_LOJACLI "
	cQrySalesOrder += "    AND SA1.A1_FILIAL = '" + FWXFilial("SA1", Self:cFilialUsada) + "' "
	cQrySalesOrder += "    AND SA1.D_E_L_E_T_ = ' ' "

	cQrySalesOrder += "   LEFT JOIN " + RetSqlName("SA3") + " SA3 "
	cQrySalesOrder += "     ON SA3.A3_COD = SC5.C5_VEND1 "
	cQrySalesOrder += "    AND SA3.A3_FILIAL = '" + FWXFilial("SA3", Self:cFilialUsada) + "' "
	cQrySalesOrder += "    AND SA3.D_E_L_E_T_ = ' ' "

	cQrySalesOrder += "   LEFT JOIN " + RetSqlName("NP3") + " NP3 "
	cQrySalesOrder += "     ON NP3.NP3_CODIGO = SC6.C6_CULTRA "
	cQrySalesOrder += "    AND NP3.NP3_FILIAL = '" + FWXFilial("NP3", Self:cFilialUsada) + "' "
	cQrySalesOrder += "    AND NP3.D_E_L_E_T_ = ' ' "

	cQrySalesOrder += "  WHERE SC5.D_E_L_E_T_ = ' ' "
	cQrySalesOrder += "    AND SC5.C5_FILIAL = '" + FWXFilial("SC5", Self:cFilialUsada) + "' "
	cQrySalesOrder += Self:getManufacturerFilter()

Return cQrySalesOrder

/*/{Protheus.doc} buildQueryCompra
Monta a consulta SQL responsavel por recuperar os pedidos de compra e suas informações relacionadas.
@type method
@author beatriz.dantas
@since 20/07/2026
@version p12
@return cQryPurchaseOrder, trecho SQL do lado "compra" do UNION
/*/
method buildPurchaseOrderSelect() as character class SalesPurchaseOrderRebateRepository
	Local cQryPurchaseOrder := ""

	cQryPurchaseOrder := " SELECT "
	cQryPurchaseOrder += "        SC7.R_E_C_N_O_ AS CODI_PED, SC7.C7_FILIAL AS CODI_REV, "
	cQryPurchaseOrder += "        NCR.NCR_FABCOD AS CODI_FAB, SC7.C7_NUM AS NUME_PED, CAST(NULL AS VARCHAR(3)) AS SERI_PED, "
	cQryPurchaseOrder += "        SC7.C7_EMISSAO AS DATA_PED, CAST(NULL AS Date) AS DATV_PED, CAST(NULL AS Date) AS DATP_PED, "
	cQryPurchaseOrder += "        CASE "
	cQryPurchaseOrder += "            WHEN SC7.C7_QUANT = SC7.C7_QUJE THEN 'A' "
	cQryPurchaseOrder += "            ELSE 'C' "
	cQryPurchaseOrder += "        END AS STAT_PED, "
	cQryPurchaseOrder += "        SC7.C7_FORNECE AS COD_CLIRAW, SC7.C7_LOJA AS LOJ_CLIRAW, SA2.A2_CGC AS CNPJ_CLI, "
	cQryPurchaseOrder += "        SA2.A2_INSCR AS INSC_CLI, SA2.A2_NOME AS NOME_CLI, SA2.A2_END AS END_CLIRAW, "
	cQryPurchaseOrder += "        SA2.A2_BAIRRO AS BAIR_CLI, SA2.A2_COMPLEM AS COMP_CLI, SA2.A2_CEP AS CEPC_CLI, "
	cQryPurchaseOrder += "        SA2.A2_COD_MUN AS MUN_RAW, SA2.A2_EST AS EST_RAW, SC7.C7_PRODUTO AS CODI_PRO, "
	cQryPurchaseOrder += "        SB1.B1_DESC AS DESC_PRO, SB1.B1_POSIPI AS NCMP_PRO, SC7.C7_UM AS UNID_PRO, "
	cQryPurchaseOrder += "        SB1.B1_CODBAR AS BARR_PRO, Space(1) AS CIND_PRO, Space(1) AS LOTE_IVN, "
	cQryPurchaseOrder += "        0 AS TRIB_IVN, Space(1) AS CODI_CUL, Space(1) AS DESC_CUL, "
	cQryPurchaseOrder += "        SC7.C7_TOTAL AS PBRU_PED, (SC7.C7_TOTAL - SC7.C7_VLDESC) AS PLIQ_PED, "
	cQryPurchaseOrder += "        SC7.C7_QUANT AS QTDE_PED, Space(1) AS CODI_VED, Space(1) AS NOME_VED, "
	cQryPurchaseOrder += "        Space(1) AS CPFC_VED, 'C' AS FLG_TIPO "

	cQryPurchaseOrder += "   FROM " + RetSqlName("SC7") + " SC7 "

	cQryPurchaseOrder += "  INNER JOIN " + RetSqlName("SB1") + " SB1 "
	cQryPurchaseOrder += "     ON SB1.B1_COD = SC7.C7_PRODUTO "
	cQryPurchaseOrder += "    AND SB1.B1_FILIAL = '" + FWXFilial("SB1", Self:cFilialUsada) + "' "
	cQryPurchaseOrder += "    AND SB1.D_E_L_E_T_ = ' ' "

	cQryPurchaseOrder += "  INNER JOIN " + RetSqlName("NCR") + " NCR "
	cQryPurchaseOrder += "     ON NCR.NCR_PROD = SB1.B1_COD "
	cQryPurchaseOrder += "    AND NCR.NCR_FILIAL = SB1.B1_FILIAL "
	cQryPurchaseOrder += "    AND NCR.D_E_L_E_T_ = ' ' "

	cQryPurchaseOrder += "   LEFT JOIN " + RetSqlName("SA2") + " SA2 "
	cQryPurchaseOrder += "     ON SA2.A2_COD = SC7.C7_FORNECE "
	cQryPurchaseOrder += "    AND SA2.A2_LOJA = SC7.C7_LOJA "
	cQryPurchaseOrder += "    AND SA2.A2_FILIAL = '" + FWXFilial("SA2", Self:cFilialUsada) + "' "
	cQryPurchaseOrder += "    AND SA2.D_E_L_E_T_ = ' ' "

	cQryPurchaseOrder += "  WHERE SC7.D_E_L_E_T_ = ' ' "
	cQryPurchaseOrder += "    AND SC7.C7_FILIAL = '" + FWXFilial("SC7", Self:cFilialUsada) + "' "
	cQryPurchaseOrder += Self:getManufacturerFilter()

Return cQryPurchaseOrder

/*/{Protheus.doc} getManufacturerFilter
Filtra os itens somente dos fabricantes/marcas contemplados pela integração (Bayer e Corteva), conforme o campo codi_fab (B1_PROC) da issue.
@type method
@author beatriz.dantas
@since 20/07/2026
@version p12
return character, trecho de WHERE com os fabricantes habilitados
/*/
method getManufacturerFilter() as character class SalesPurchaseOrderRebateRepository
	Local cFiltro := ""

	If !Empty(::codigoFabricante)
		cFiltro := " AND NCR.NCR_FABCOD IN ('" + StrTran(AllTrim(::codigoFabricante), ",", "','") + "') "
	EndIf
return cFiltro

/*/{Protheus.doc} getMapSensitiveFields
Complementa os campos derivados (concatenacao cliente/loja, codigo IBGE do municio, separação de endereco) e aplica a anonimização de dados pessoais.
@type method
@author beatriz.dantas
@since 20/07/2026
@param jResponse, json, resposta gerada pelo FWAdapterBaseV2
@return object, resposta tratada
/*/
method formatResponse(jResponse) As Object Class SalesPurchaseOrderRebateRepository
	Local aItems           := {}
	Local aProtectedFields := {}
	Local aAllowedFields   := {}
	Local aProtectedMap    := {}
	Local jItem            as object
	Local nItem            := 0
	Local nField           := 0

	aProtectedMap := self:getSensitiveFieldsMap() //retorna campos sensíveis para anonimização quando houver configuração.

	for nField := 1 To Len(aProtectedMap)
		AAdd(aProtectedFields,aProtectedMap[nField][1])
	next nField

	aItems := jResponse["items"]
	aAllowedFields := FwProtectedDataUtil():UsrAccessPDField(__cUserID,aProtectedFields)

	for nItem := 1 To Len(aItems)
		jItem := aItems[nItem]
		jItem["codi_cli"] := AllTrim(jItem["codi_cli"])+"."+AllTrim(jItem["loja_cli"])
		jItem["nume_cli"] := trataEnd(jItem["enco_cli"], "N")
		jItem["enco_cli"] := trataEnd(jItem["enco_cli"], "L")
		jItem["muni_cli"] := Tms120CdUf(jItem["estado_cli"])+AllTrim(jItem["muni_cli"])
		jItem["muni_ped"] := jItem["muni_cli"]

		If Empty(jItem["insc_cli"])
			jItem["insc_cli"] := "ISENTO"
		EndIf

		For nField := 1 To Len(aProtectedMap)
			If AScan(aAllowedFields,aProtectedMap[nField][1]) == 0
				If jItem:HasProperty(aProtectedMap[nField][2])
					jItem[aProtectedMap[nField][2]] := FwProtectedDataUtil():ValueAsteriskToAnonymize(jItem[aProtectedMap[nField][2]])
				EndIf
			EndIf
		next nField

		jItem:DelName("loja_cli")
		jItem:DelName("estado_cli")
		jItem:DelName("flg_tipo")
	next nItem

	jResponse["items"] := aItems
return jResponse

/*/{Protheus.doc} getSensitiveFieldsMap
Retorna o mapeamento entre os campos físicos do Protheus e os respectivos campos expostos pela API para utilização da Protected Data (XAM).
@type method
@author beatriz.dantas
@since 20/07/2026
@version p12
@return aMapFields, array, Mapeamento de campos sensíveis.
/*/
method getSensitiveFieldsMap() as array class SalesPurchaseOrderRebateRepository
	Local aMapFields := {}

	AAdd(aMapFields, {"A1_CGC"     , "cnpj_cli"})
	AAdd(aMapFields, {"A2_CGC"     , "cnpj_cli"})
	AAdd(aMapFields, {"A1_INSCR"   , "insc_cli"})
	AAdd(aMapFields, {"A2_INSCR"   , "insc_cli"})
	AAdd(aMapFields, {"A1_NOME"    , "nome_cli"})
	AAdd(aMapFields, {"A2_NOME"    , "nome_cli"})
	AAdd(aMapFields, {"A1_END"     , "enco_cli"})
	AAdd(aMapFields, {"A2_END"     , "enco_cli"})
	AAdd(aMapFields, {"A1_BAIRRO"  , "bair_cli"})
	AAdd(aMapFields, {"A2_BAIRRO"  , "bair_cli"})
	AAdd(aMapFields, {"A1_COMPLEM" , "comp_cli"})
	AAdd(aMapFields, {"A2_COMPLEM" , "comp_cli"})
	AAdd(aMapFields, {"A1_CEP"     , "cepc_cli"})
	AAdd(aMapFields, {"A2_CEP"     , "cepc_cli"})
	AAdd(aMapFields, {"A1_COD_MUN" , "muni_cli"})
	AAdd(aMapFields, {"A2_COD_MUN" , "muni_cli"})
	AAdd(aMapFields, {"A1_EST"     , "estado_cli"})
	AAdd(aMapFields, {"A2_EST"     , "estado_cli"})
	AAdd(aMapFields, {"A3_NOME"    , "nome_ved"})
	AAdd(aMapFields, {"A3_CGC"     , "cpfc_ved"})
return aMapFields
