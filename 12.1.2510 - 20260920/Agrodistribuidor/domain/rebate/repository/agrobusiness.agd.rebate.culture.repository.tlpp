/*/{Protheus.doc} RebateCultureRepository::getFields
Retorna os campos que serao utilizados no AddMapFields da classe FWAdapterBaseV2
@type method
@version 12
@author ronery.filho
@since 31/07/2026
@return array, {{cCampoJson, cCampoTabela, cTipoCampo, lJsonField|lFixed}, ...}
/*/
method getFields() as array class RebateCultureRepository
	local aFields as array

	aFields := {;
		{'filial'   		, 'NP3_FILIAL', 'C', .T.},;
		{'culturaCodigo'   	, 'NP3_CODIGO', 'C', .T.},;
		{'culturaDescricao' , 'NP3_DESCRI', 'C', .T.};
		}
return aFields
