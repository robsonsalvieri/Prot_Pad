#Include "totvs.ch"
#Include "tlpp-core.th"

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} RebateRepository
Repository das filiais para o rebate
@type class
@version 12
@author claudineia.reinert
@since 16/07/2026
/*/
class RebateBranchesRepository from UtilsRepository
	public method new()
	public method listBranchData(cCodigoRevenda as Character, cFabricanteID as Character)

endclass

/*/{Protheus.doc} RebateBranchesRepository::new
Construtor
@type method
@version 12
@author claudineia.reinert
@since 16/07/2026
@return object, self
/*/
method new() class RebateBranchesRepository
	_Super:New()
return self

/*/{Protheus.doc} RebateBranchesRepository::listBranchData
Lista todas as filiais e dados de cada filial para a integração do rebate
@type method
@version 12
@author claudineia.reinert
@since 16/07/2026
@param cCodigoRevenda, character, código da revenda (filial) para filtrar a consulta
@param cFabricanteID, character, identificador do fabricante recebido na rota
/*/
method listBranchData(cCodigoRevenda as Character, cFabricanteID as Character) class RebateBranchesRepository
	Local aFiliais  	as Array
	Local oJFilial		as Object
	Local nX  			as Numeric
	Local aSM0Dados		as Array
	Local aDadosRetorno := {}

	Default cCodigoRevenda := ""
	Default cFabricanteID := ""

	aFiliais := FWAllFilial(, , cEmpAnt, .F.) //retorna todas as filiais do grupo de empresas do usuário logado
	for nX := 1 to len(aFiliais)
		cFilAnt := aFiliais[nX]

		// Mantém o parâmetro de fabricante para compatibilidade do contrato da rota.
		If !Empty(cCodigoRevenda) .And. AllTrim(cFilAnt) <> AllTrim(cCodigoRevenda)
			Loop
		EndIf

		If FWFilialStatus(cEmpAnt , cFilAnt ) //se filial esta ativa
			//busca os dados de uma filial
			aSM0Dados := FWSM0Util():GetSM0Data( cEmpAnt , cFilAnt , { "M0_CODFIL", "M0_NOMECOM", "M0_NOME", "M0_CGC", "M0_CODMUN", "M0_ESTENT","M0_INSC", "M0_TEL" } )
			oJFilial := JsonObject():New()
			oJFilial['codi_rev']	:= AllTrim(aSM0Dados[1][2])
			oJFilial['raza_rev']	:= AllTrim(aSM0Dados[2][2])
			oJFilial['fant_rev']	:= AllTrim(aSM0Dados[3][2])
			oJFilial['cnpj_rev']	:= AllTrim(aSM0Dados[4][2])
			oJFilial['muni_rev']	:= AllTrim(aSM0Dados[5][2]) //+'.'+AllTrim(TMS120CdUf( aSM0Dados[6][2] ,"1"))
			oJFilial['insc_rev']	:= AllTrim(aSM0Dados[7][2])
			oJFilial['fone_rev']	:= AllTrim(aSM0Dados[8][2])
			aadd(aDadosRetorno, oJFilial)
		EndIf
	next nX

	jResponseJson := JsonObject():New()
	jResponseJson:set(aDadosRetorno)
	Self:setSuccess(jResponseJson)

	FreeObj(jResponseJson)

return nil

