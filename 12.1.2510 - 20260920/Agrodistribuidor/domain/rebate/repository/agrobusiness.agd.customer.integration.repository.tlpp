#Include "totvs.ch"
#Include "tlpp-core.th"

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} CustomerIntegrationRepository
Repositório responsável pela consulta de clientes para integração de rebate.
@type class
@version 1.0
@author rodrigo.nsoledade
@since 17/07/2026
/*/
Class CustomerIntegrationRepository From UtilsRepository
	Private data cFilialUsada  As character

	Public Method New()
	Public Method find(nPage,nPageSize,jQueryParams)
	Public Method getFields() As Array

	Private Method getQueryJoin() As Array
	Private Method formatResponse(jResponse) As Object
	Private Method getLastUpdate(cCodCli,cCodLoja) As Character
	Private Method getCategoryDescription(cCategory) As Character

EndClass

/*/{Protheus.doc} New
Construtor do repositório de integração de clientes.
@type method
@return object, instância da classe
/*/
Method New() Class CustomerIntegrationRepository
	Self:cFilialUsada := cFilAnt
	_Super:New("SA1",Self:getFields())
Return Self

/*/{Protheus.doc} find
Consulta paginada dos clientes para integração de rebate.
@type method
@author rodrigo.nsoledade
@since 17/07/2026
@param nPage, numeric, número da página
@param nPageSize, numeric, quantidade de registros por página
@param jQueryParams, json, parâmetros de filtro e ordenação
@return nil
/*/
Method find(nPage,nPageSize,jQueryParams) Class CustomerIntegrationRepository
	Local aArea As Array
	Local cOrder As Character
	Local cWhere As Character
	Local jResponse As Object

	Default nPage := 1
	Default nPageSize := 10
	Default jQueryParams := Nil

	If Self:lOk

		If jQueryParams != Nil .And. jQueryParams:HasProperty("codi_rev") .And. !Empty(jQueryParams["codi_rev"])
			Self:cFilialUsada := jQueryParams["codi_rev"]
			jQueryParams["codi_rev"] := FWxFilial('SA1', Self:cFilialUsada)//Conversao obrigatoria para atualizar filtro da filial usada na consulta
		EndIf

		aArea := FwGetArea()
		cOrder := Self:getOrderQueryParam(jQueryParams,Self:getFields())
		cWhere := Self:getWhereQueryParam(jQueryParams,Self:getFields())
		cWhere += Iif(!Empty(cWhere)," AND ","") + "SA1.A1_FILIAL = '"+FWxFilial('SA1', Self:cFilialUsada)+"' AND SA1.D_E_L_E_T_ = ' '"

		Self:setFieldsConsulta(Self:getFields())
		Self:setPage(nPage)
		Self:setPageSize(nPageSize)
		Self:SetQuery(Self:getQueryDefault(Self:getQueryJoin()))
		Self:SetWhere(cWhere)
		Self:SetUrlFilter(Self:getFilterAdvancedQueryParam(jQueryParams))
		Self:SetOrder(cOrder)

		If Self:Execute()
			Self:FillGetResponse()
			If Self:lOk
				jResponse := Self:convertToJson(Self:getJSONResponse())
				Self:setSuccess(Self:formatResponse(jResponse))
			EndIf
		EndIf

		FwRestArea(aArea)
		FwFreeArray(aArea)
		FreeObj(jResponse)
	EndIf
Return Nil

/*/{Protheus.doc} getFields
Retorna os campos disponibilizados pela API e seus respectivos campos Protheus.
@type method
@author rodrigo.nsoledade
@since 17/07/2026
@return array, campos do repositório
/*/
Method getFields() As Array Class CustomerIntegrationRepository
	Local aFields := {}

	AAdd(aFields,{"codi_rev"                 ,"A1_FILIAL" ,"C",.T.})
	AAdd(aFields,{"codi_cli"                 ,"A1_COD"    ,"C",.T.})
	AAdd(aFields,{"cnpj_cli"                 ,"A1_CGC"    ,"C",.T.})
	AAdd(aFields,{"insc_cli"                 ,"A1_INSCR"  ,"C",.T.})
	AAdd(aFields,{"nome_cli"                 ,"A1_NOME"   ,"C",.T.})
	AAdd(aFields,{"enco_cli"                 ,"A1_END"    ,"C",.T.})
	AAdd(aFields,{"nume_cli"                 ,"A1_END"    ,"C",.T.})
	AAdd(aFields,{"bair_cli"                 ,"A1_BAIRRO" ,"C",.T.})
	AAdd(aFields,{"comp_cli"                 ,"A1_COMPLEM","C",.T.})
	AAdd(aFields,{"cepc_cli"                 ,"A1_CEP"    ,"C",.T.})
	AAdd(aFields,{"muni_cli"                 ,"A1_COD_MUN","C",.T.})
	AAdd(aFields,{"ddd"                      ,"A1_DDD"    ,"C",.T.})
	AAdd(aFields,{"tele_cli"                 ,"A1_TEL"    ,"C",.T.})
	AAdd(aFields,{"celu_cli"                 ,"A1_TEL"    ,"C",.T.})
	AAdd(aFields,{"emai_cli"                 ,"A1_EMAIL"  ,"C",.T.})
	AAdd(aFields,{"duma_cli"                 ,"A1_USERLGA","C",.T.})
	AAdd(aFields,{"dnac_cli"                 ,"A1_DTNASC" ,"D",.T.})
	AAdd(aFields,{"CategoriaCodigo"          ,"A1_TIPO"   ,"C",.T.})
	AAdd(aFields,{"CategoriaDescricao"       ,"A1_TIPO"   ,"C",.T.})
	AAdd(aFields,{"ClientePrincipalCodigo"   ,"NEX_CODCLI","C",.T.})
	AAdd(aFields,{"ClientePrincipalDescricao","A1_NOME"   ,"C",.T.})
	AAdd(aFields,{"loja"                     ,"A1_LOJA"   ,"C",.T.})
	AAdd(aFields,{"estado"                   ,"A1_EST"    ,"C",.T.})

Return aFields

/*/{Protheus.doc} getQueryJoin
Retorna os relacionamentos necessários para a consulta dos clientes.
@type method
@author rodrigo.nsoledade
@since 17/07/2026
@return array, relacionamentos da consulta
/*/
Method getQueryJoin() As Array Class CustomerIntegrationRepository
	Local aJoins := {}
	Local cJoinNEX As Character

	cJoinNEX := "NEX.D_E_L_E_T_ = ' '"
	cJoinNEX += " AND NEX.NEX_FILIAL = '"+FWxFilial("NEX",Self:cFilialUsada)+"'"
	cJoinNEX += " AND NEX.NEX_CODCLI = SA1.A1_COD"
	cJoinNEX += " AND NEX.NEX_LOJCLI = SA1.A1_LOJA"
	cJoinNEX += " AND NEX.NEX_PRINCI = '1'"

	AAdd(aJoins,{"LEFT","NEX",cJoinNEX})
Return aJoins

/*/{Protheus.doc} formatResponse
Complementa os campos derivados e aplica a proteção dos dados pessoais.
@type method
@author rodrigo.nsoledade
@since 20/07/2026
@param jResponse, json, resposta gerada pelo FWAdapterBaseV2
@return object, resposta tratada
/*/
Method formatResponse(jResponse) As Object Class CustomerIntegrationRepository
	Local aItems := {}
	Local aProtectedFields := {}
	Local aAllowedFields := {}
	Local aProtectedMap := {}
	Local aJsonFields := {}
	Local jItem As Object
	Local nItem As Numeric
	Local nField As Numeric
	Local nJsonField As Numeric

	aProtectedMap := {;
		{"A1_CGC"    ,{"cnpj_cli"}},;
		{"A1_INSCR"  ,{"insc_cli"}},;
		{"A1_NOME"   ,{"nome_cli","ClientePrincipalDescricao"}},;
		{"A1_END"    ,{"enco_cli","nume_cli"}},;
		{"A1_BAIRRO" ,{"bair_cli"}},;
		{"A1_COMPLEM",{"comp_cli"}},;
		{"A1_CEP"    ,{"cepc_cli"}},;
		{"A1_TEL"    ,{"tele_cli"}},;
		{"A1_TEL"    ,{"celu_cli"}},;
		{"A1_EMAIL"  ,{"emai_cli"}},;
		{"A1_DTNASC" ,{"dnac_cli"}}}

	For nField := 1 To Len(aProtectedMap)
		AAdd(aProtectedFields,aProtectedMap[nField][1])
	Next nField

	aItems := jResponse["items"]
	aAllowedFields := FwProtectedDataUtil():UsrAccessPDField(__cUserID,aProtectedFields)

	For nItem := 1 To Len(aItems)

		jItem := aItems[nItem]
		jItem["duma_cli"] := Self:getLastUpdate(jItem["codi_cli"],jItem["loja"])
		jItem["codi_cli"] := AllTrim(jItem["codi_cli"])+"."+AllTrim(jItem["loja"])
		jItem["muni_cli"] := Tms120CdUf(jItem["estado"])+AllTrim(jItem["muni_cli"])
		jItem["nume_cli"] := trataEnd(jItem["enco_cli"], "N")
		jItem["enco_cli"] := trataEnd(jItem["enco_cli"], "L")
		jItem["tele_cli"] := IIf(Empty(jItem["ddd"]),jItem["tele_cli"], AllTrim(jItem["ddd"]) + Space(1) + AllTrim(jItem["tele_cli"]))
		jItem["celu_cli"] := jItem["tele_cli"]
		jItem["CategoriaDescricao"] := Self:getCategoryDescription(jItem["CategoriaCodigo"])
		
		If Empty(jItem["ClientePrincipalCodigo"])
			jItem["ClientePrincipalDescricao"] := ""
		EndIf

		For nField := 1 To Len(aProtectedMap)
			If AScan(aAllowedFields,aProtectedMap[nField][1]) == 0
				aJsonFields := aProtectedMap[nField][2]
				For nJsonField := 1 To Len(aJsonFields)
					If jItem:HasProperty(aJsonFields[nJsonField])
						jItem[aJsonFields[nJsonField]] := FwProtectedDataUtil():ValueAsteriskToAnonymize(jItem[aJsonFields[nJsonField]])
					EndIf
				Next nJsonField
			EndIf
		Next nField

		jItem:DelName("loja")
		jItem:DelName("estado")
		jItem:DelName("ddd")
	Next nItem

	jResponse["items"] := aItems
Return jResponse

/*/{Protheus.doc} getCategoryDescription
Retorna a descrição correspondente ao tipo do cliente.
@type method
@author rodrigo.nsoledade
@since 20/07/2026
@param cCategory, character, código da categoria
@return character, descrição da categoria
/*/
Method getCategoryDescription(cCategory) As Character Class CustomerIntegrationRepository
	Local cDescription := ""

	Do Case
	Case AllTrim(cCategory) == "L"
		cDescription := "Produtor Rural"
	Case AllTrim(cCategory) == "F"
		cDescription := "Consumidor Final"
	Case AllTrim(cCategory) == "R"
		cDescription := "Revendedor"
	Case AllTrim(cCategory) == "S"
		cDescription := "ICMS Solidário sem IPI na base"
	Case AllTrim(cCategory) == "X"
		cDescription := "Exportação"
	EndCase

Return cDescription

/*/{Protheus.doc} getLastUpdate
Retorna o usuário e a data da última alteração do cliente.
@type method
@author rodrigo.nsoledade
@since 20/07/2026
@param cCodCli, character, código do cliente
@param cCodLoja, character, loja do cliente
@return character, usuário e data da última alteração
/*/
Method getLastUpdate(cCodCli,cCodLoja) As Character Class CustomerIntegrationRepository
	Local aAreaSA1 := SA1->(FwGetArea())
	Local cLastUpd := ""
	Local cLogUser := ""

	DbSelectArea("SA1")
	SA1->(DbSetOrder(1))

	If SA1->(DbSeek(FWxFilial("SA1",Self:cFilialUsada) + PadR(cCodCli,TamSX3("A1_COD")[1]) + PadR(cCodLoja,TamSX3("A1_LOJA")[1])))

		cLastUpd := AllTrim(FWLeUserLg("A1_USERLGA",2))
		cLogUser := AllTrim(FWLeUserLg("A1_USERLGA",1))

		If !Empty(cLogUser)
			cLastUpd += IIf(Empty(cLastUpd),""," - ") + cLogUser
		EndIf

	EndIf

	FwRestArea(aAreaSA1)
	FwFreeArray(aAreaSA1)
Return cLastUpd
