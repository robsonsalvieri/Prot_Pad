#Include "totvs.ch"
#Include "tlpp-core.th"

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} RebateOutboundBillingInvoiceRepository
Repository responsavel pela consulta de notas fiscais de sai­da
para integraçao de rebate para syngenta.
@type class
@version 1.0
@author gilson.venturi
@since 04/08/2026
/*/
Class RebateOutboundBillingInvoiceRepository From UtilsRepository

	Public Method New()
	Public Method findOutboundBillingInvoices(nPage,nPageSize,jQueryParams)

	Private Method buildOutboundInvoiceQuery() As Character
	Private Method getFields() As Array
	Private Method formatResponse(jResponse) As Object

EndClass

/*/{Protheus.doc} New
Construtor da classe.
@type method
@version 1.0
@author gilson.venturi
@since 04/08/2026
@return object, instancia da classe
/*/
Method New() Class RebateOutboundBillingInvoiceRepository
	_Super:New("SF2")
Return Self

/*/{Protheus.doc} findOutboundBillingInvoices
Consulta notas fiscais de sai­da conforme os filtros da requisição.
@type method
@version 1.0
@author gilson.venturi
@since 04/08/2026
@param nPage, numeric, numero da pagina
@param nPageSize, numeric, quantidade de registros por pagina
@param jQueryParams, json, parametros da query string
/*/
Method findOutboundBillingInvoices(nPage,nPageSize,jQueryParams) Class RebateOutboundBillingInvoiceRepository

	Local cOrder := "F2_EMISSAO, F2_DOC, F2_SERIE"
	Local cQuery := ""
	Local jResponse As Object

	Default nPage := 1
	Default nPageSize := 10
	Default jQueryParams := Nil

	nPageSize := Min(nPageSize,200)
	cQuery := Self:buildOutboundInvoiceQuery()

	Self:setFieldsConsulta(Self:getFields())
	Self:setPage(nPage)
	Self:setPageSize(nPageSize)
	Self:SetQuery(Self:getQueryDefault(,cQuery))
	Self:SetWhere("1=1")
	self:SetUrlFilter(self:getFilterAdvancedQueryParam(jQueryParams))
	Self:SetUseSpaces(.F.)
	Self:SetOrder(cOrder)

	If Self:Execute()
		Self:FillGetResponse()

		If Self:lOk
			jResponse := Self:convertToJson(Self:getJSONResponse())
			Self:setSuccess(Self:formatResponse(jResponse))
		EndIf
	EndIf
Return Nil

/*/{Protheus.doc} buildOutboundInvoiceQuery
Monta a consulta das notas fiscais de saída.
@type method
@version 1.0
@author gilson.venturi
@since 04/08/2026
@return character, consulta SQL preparada
/*/
Method buildOutboundInvoiceQuery() As Character Class RebateOutboundBillingInvoiceRepository
	Local cQuery := ""
	Local oStatement := FWPreparedStatement():New()
	Local nParamPos := 1

	cQuery += " SELECT YEAR(F2_EMISSAO) AS ANONOTA, "
	cQuery += "        CASE WHEN FT_DTCANC = ' ' THEN 'A' ELSE 'C' END AS STATUSNF, "
	cQuery += "        A1_TIPO, "
	cQuery += "        D2_CF, "
	cQuery += "        F2_CHVNFE AS MODELODOCUMENTO, "
	cQuery += "        F2_CLIENTE, "
	cQuery += "        A1_CGC, "
	cQuery += "        NEX_CODCLI, "
	cQuery += "        F2_COND, "
	cQuery += "        C6_CULTRA, "
	cQuery += "        B2_CM1, "
	cQuery += "        B1_CUSTD, "
	cQuery += "        F2_EMISSAO, "
	cQuery += "        'S' AS AGROVIEW, "
	cQuery += "        CONCAT(NCR_FABCOD, CONCAT('.', NCR_FABLOJ)) AS FABRICANTE, "
	cQuery += "        '' AS FAMILIAPRODUTO, "
	cQuery += "        F2_FILIAL, "
	cQuery += "        A3_GEREN, "
	cQuery += "        B1_GRUPO, "
	cQuery += "        MONTH(F2_EMISSAO) AS MESNOTA, "
	cQuery += "        F2_DOC, "
	cQuery += "        C6_OPER, "
	cQuery += "        D2_PEDIDO, "
	cQuery += "        D2_COD, "
	cQuery += "        NJU_CODSAF, "
	cQuery += "        NJU_DTFIM, "
	cQuery += "        NJU_DTINI, "
	cQuery += "        F2_SERIE, "
	cQuery += "        'FATURAMENTO' AS SITFATUR, "
	cQuery += "        NF8_CODIGO, "
	cQuery += "        B1_TIPO, "
	cQuery += "        FT_TOTAL, "
	cQuery += "        D2_PRCVEN, "
	cQuery += "        F2_VEND1, "
	cQuery += "        D2_QUANT "
	cQuery += "   FROM " + RetSqlName("SF2") + " SF2 "

	cQuery += "  INNER JOIN " + RetSqlName("SD2") + " SD2 "
	cQuery += "     ON SD2.D_E_L_E_T_ = ' ' "
	cQuery += "    AND D2_FILIAL = F2_FILIAL "
	cQuery += "    AND D2_DOC = F2_DOC "
	cQuery += "    AND D2_SERIE = F2_SERIE "
	cQuery += "    AND D2_CLIENTE = F2_CLIENTE "
	cQuery += "    AND D2_LOJA = F2_LOJA "

	cQuery += "  INNER JOIN " + RetSqlName("SB1") + " SB1 "
	cQuery += "     ON SB1.D_E_L_E_T_ = ' ' "
	cQuery += "    AND B1_FILIAL = ? "
	cQuery += "    AND B1_COD = D2_COD "

	cQuery += "  INNER JOIN " + RetSqlName("SB2") + " SB2 "
	cQuery += "     ON SB2.D_E_L_E_T_ = ' ' "
	cQuery += "    AND B2_FILIAL = ? "
	cQuery += "    AND B2_COD = D2_COD "
	cQuery += "    AND B2_LOCAL = D2_LOCAL "

	cQuery += "  INNER JOIN " + RetSqlName("SA1") + " SA1 "
	cQuery += "     ON SA1.D_E_L_E_T_ = ' ' "
	cQuery += "    AND A1_FILIAL = ? "
	cQuery += "    AND A1_COD = F2_CLIENTE "
	cQuery += "    AND A1_LOJA = F2_LOJA "

	cQuery += "  INNER JOIN " + RetSqlName("NCR") + " NCR "
	cQuery += "     ON NCR.D_E_L_E_T_ = ' ' "
	cQuery += "    AND NCR_FILIAL = ? "
	cQuery += "    AND NCR_PROD = D2_COD "

	cQuery += "  INNER JOIN " + RetSqlName("SC5") + " SC5 "
	cQuery += "     ON SC5.D_E_L_E_T_ = ' ' "
	cQuery += "    AND C5_FILIAL = D2_FILIAL "
	cQuery += "    AND C5_NUM = D2_PEDIDO "

	cQuery += "  INNER JOIN " + RetSqlName("SC6") + " SC6 "
	cQuery += "     ON SC6.D_E_L_E_T_ = ' ' "
	cQuery += "    AND C6_FILIAL = D2_FILIAL "
	cQuery += "    AND C6_NUM = D2_PEDIDO "
	cQuery += "    AND C6_ITEM = D2_ITEMPV "

	cQuery += "   LEFT JOIN " + RetSqlName("NF8") + " NF8 "
	cQuery += "     ON NF8.D_E_L_E_T_ = ' ' "
	cQuery += "    AND NF8_FILIAL = ? "
	cQuery += "    AND NF8_GRPPRD = B1_GRUPO "

	cQuery += "   LEFT JOIN " + RetSqlName("NJU") + " NJU "
	cQuery += "     ON NJU.D_E_L_E_T_ = ' ' "
	cQuery += "    AND NJU_FILIAL = ? "
	cQuery += "    AND NJU_CODSAF = C5_CODSAF "

	cQuery += "   LEFT JOIN " + RetSqlName("NEX") + " NEX "
	cQuery += "     ON NEX.D_E_L_E_T_ = ' ' "
	cQuery += "    AND NEX_FILIAL = ? "
	cQuery += "    AND NEX_CODCLI = A1_COD "
	cQuery += "    AND NEX_LOJCLI = A1_LOJA "
	cQuery += "    AND NEX_PRINCI = '1' "

	cQuery += "   LEFT JOIN " + RetSqlName("SA3") + " SA3 "
	cQuery += "     ON SA3.D_E_L_E_T_ = ' ' "
	cQuery += "    AND A3_FILIAL = ? "
	cQuery += "    AND A3_COD = F2_VEND1 "

	cQuery += "   LEFT JOIN " + RetSqlName("SFT") + " SFT "
	cQuery += "     ON SFT.D_E_L_E_T_ = ' ' "
	cQuery += "    AND FT_FILIAL = ? "
	cQuery += "    AND FT_TIPOMOV = 'S' "
	cQuery += "    AND FT_SERIE = F2_SERIE "
	cQuery += "    AND FT_NFISCAL = F2_DOC "
	cQuery += "    AND FT_CLIEFOR = D2_CLIENTE "
	cQuery += "    AND FT_LOJA = D2_LOJA "
	cQuery += "    AND FT_ITEM = D2_ITEM "
	cQuery += "    AND FT_PRODUTO = D2_COD "
	
	cQuery += "  WHERE SF2.D_E_L_E_T_ = ' ' "
	cQuery += "    AND F2_FILIAL = ? "
	cQuery += "    AND F2_FIMP = 'S' "
	cQuery += "    AND F2_CHVNFE <> ' ' "

	oStatement:SetQuery(cQuery)
	oStatement:SetString(nParamPos++,FWXFilial("SB1"))
	oStatement:SetString(nParamPos++,FWXFilial("SB2"))
	oStatement:SetString(nParamPos++,FWXFilial("SA1"))
	oStatement:SetString(nParamPos++,FWXFilial("NCR"))
	oStatement:SetString(nParamPos++,FWXFilial("NF8"))
	oStatement:SetString(nParamPos++,FWXFilial("NJU"))
	oStatement:SetString(nParamPos++,FWXFilial("NEX"))
	oStatement:SetString(nParamPos++,FWXFilial("SA3"))
	oStatement:SetString(nParamPos++,FWXFilial("SFT"))
	oStatement:SetString(nParamPos++,FWXFilial("SF2"))

	cQuery := ChangeQuery(oStatement:GetFixQuery())
Return cQuery

/*/{Protheus.doc} getFields
Define os campos do cabeçalho da nota fiscal.
@type method
@author gilson.venturi
@since 04/08/2026
@return array, mapeamento dos campos
/*/
Method getFields() As Array Class RebateOutboundBillingInvoiceRepository
	Local aFields := {}

	AAdd(aFields,{"FaturamentoAno",              "ANONOTA",        "N", .T.})
	AAdd(aFields,{"FaturamentoCancelado",        "STATUSNF",       "C", .T.})
	AAdd(aFields,{"FaturamentoCategoriaCliente", "A1_TIPO",        "C", .T.})
	AAdd(aFields,{"FaturamentoCFOP",             "D2_CF",          "C", .T.})
	AAdd(aFields,{"FaturamentoChaveNF",          "MODELODOCUMENTO","C", .T.})
	AAdd(aFields,{"FaturamentoCliente",          "F2_CLIENTE",     "C", .T.})
	AAdd(aFields,{"FaturamentoClienteCPFCNPJ",   "A1_CGC",         "C", .T.})
	AAdd(aFields,{"FaturamentoClientePrincipal", "NEX_CODCLI",     "C", .T.})
	AAdd(aFields,{"FaturamentoCondicaoPagamento","F2_COND",        "C", .T.})
	AAdd(aFields,{"FaturamentoCultura",          "C6_CULTRA",      "C", .T.})
	AAdd(aFields,{"FaturamentoCustoMedio",       "B2_CM1",         "N", .T.})
	AAdd(aFields,{"FaturamentoCustoUnitario",    "B1_CUSTD",       "N", .T.})
	AAdd(aFields,{"FaturamentoData",             "F2_EMISSAO",     "D", .T.})
	AAdd(aFields,{"FaturamentoExibirAgroview",   "AGROVIEW",       "C", .T.})
	AAdd(aFields,{"FaturamentoFabricante",       "FABRICANTE",     "C", .T.})
	AAdd(aFields,{"FaturamentoFamilia",          "FAMILIAPRODUTO", "C", .T.})
	AAdd(aFields,{"FaturamentoFilial",           "F2_FILIAL",      "C", .T.})
	AAdd(aFields,{"FaturamentoGerente",          "A3_GEREN",       "C", .T.})
	AAdd(aFields,{"FaturamentoGrupo",            "B1_GRUPO",       "C", .T.})
	AAdd(aFields,{"FaturamentoMes",              "MESNOTA",        "N", .T.})
	AAdd(aFields,{"FaturamentoNumeroNF",         "F2_DOC",         "C", .T.})
	AAdd(aFields,{"FaturamentoOperacao",         "C6_OPER",        "C", .T.})
	AAdd(aFields,{"FaturamentoPedido",           "D2_PEDIDO",      "C", .T.})
	AAdd(aFields,{"FaturamentoProduto",          "D2_COD",         "C", .T.})
	AAdd(aFields,{"FaturamentoSafra",            "NJU_CODSAF",     "C", .T.})
	AAdd(aFields,{"FaturamentoSafraFim",         "NJU_DTFIM",      "D", .T.})
	AAdd(aFields,{"FaturamentoSafraInicio",      "NJU_DTINI",      "D", .T.})
	AAdd(aFields,{"FaturamentoSerieNF",          "F2_SERIE",       "C", .T.})
	AAdd(aFields,{"FaturamentoSituacao",         "SITFATUR",       "C", .T.})
	AAdd(aFields,{"FaturamentoSubgrupo",         "NF8_CODIGO",     "C", .T.})
	AAdd(aFields,{"FaturamentoTipoProduto",      "B1_TIPO",        "C", .T.})
	AAdd(aFields,{"FaturamentoValorBrutoItem",   "FT_TOTAL",       "N", .T.})
	AAdd(aFields,{"FaturamentoValorItem",        "D2_PRCVEN",      "N", .T.})
	AAdd(aFields,{"FaturamentoVendedor",         "F2_VEND1",       "C", .T.})
	AAdd(aFields,{"FaturamentoVolumeEmbalagem",  "D2_QUANT",       "N", .T.})
	AAdd(aFields,{"FaturamentoVolumeItem",       "D2_QUANT",       "N", .T.})

Return aFields

/*/{Protheus.doc} formatResponse
Formata campos derivados e aplica a proteção de dados pessoais.
@type method
@author gilson.venturi
@since 04/08/2026
@param jResponse, json, resposta da consulta
@return object, resposta formatada
/*/
Method formatResponse(jResponse) As Object Class RebateOutboundBillingInvoiceRepository
	Local jItem  as Object
	Local aItems := {} as Array
	Local aProtectedFields as Array
	Local aAllowedFields as Array
	Local aProtectedMap as Array 
	Local aSM0Data := {}
	Local aJsonFields := {}
	Local nItem := 0
	Local nField := 0
	Local nJsonField := 0

	aItems := jResponse["items"]
	aProtectedFields := {"A1_CGC"}
	aAllowedFields := FwProtectedDataUtil():UsrAccessPDField(__cUserID,aProtectedFields)
	aProtectedMap := {;
		{"A1_CGC" ,{"FaturamentoClienteCPFCNPJ","FaturamentoFilialCPFCNPJ"}}}

	For nItem := 1 To Len(aItems)
		jItem := aItems[nItem]
		aSM0Data := FWSM0Util():GetSM0Data(cEmpAnt,jItem["FaturamentoFilial"],{"M0_CODMUN"})
		jItem["FaturamentoMunicipioIBGE"] := IIf(Len(aSM0Data) > 0,AllTrim(aSM0Data[1][2]),"")

		For nField := 1 To Len(aProtectedMap)
			If AScan(aAllowedFields,aProtectedMap[nField][1]) == 0
				aJsonFields := aProtectedMap[nField][2]

				For nJsonField := 1 To Len(aJsonFields)
					If jItem:HasProperty(aJsonFields[nJsonField])
						jItem[aJsonFields[nJsonField]] := FwProtectedDataUtil():ValueAsteriskToAnonymize(jItem[aJsonFields[nJsonField]])
					EndIf
				Next nJsonField
			EndIf
		Next nField
	Next nItem

	jResponse["items"] := aItems
Return jResponse
