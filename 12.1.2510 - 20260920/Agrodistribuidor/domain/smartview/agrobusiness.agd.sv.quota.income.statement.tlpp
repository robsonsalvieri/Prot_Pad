#Include "agrobusiness.agd.sv.quota.income.statement.ch"
#include "protheus.ch"
#include "totvs.framework.treports.integratedprovider.th"

namespace totvs.protheus.agrobusiness.agd
@TotvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGAAGD", tables="NF0",customTables="NF0",name="Informe de Rendimentos Cooperado", country="BRA") //

/*/{Protheus.doc} QuotaIncomeStatementSmartViewBusinessObject:new()
Classe do objeto de negócio do Relatório de Informe de Rendimentos sobre Capital Social por Cooperado
@type Class
@version 1.0
@author carlos.augusto
@since 18/08/2026
/*/
Class QuotaIncomeStatementSmartViewBusinessObject From totvs.framework.treports.integratedprovider.IntegratedProvider

	Public Method new() 				as object
	Public Method getData() 			as object
	Public Method getSchema() 			as object

	Protected Method getType()			as character
	Protected Method getWhereFilter() 	as object
	Protected Method getFiliaisUsuarioFilter()
	Protected Method getAllFiliaisUsuario()
	Protected Method validarParametrosEntrada()

EndClass

/*{Protheus.doc} new
Método de instância da classe
@return object: self
@version 1.0
@author carlos.augusto
@since 18/08/2026
*/ 
Method new() Class QuotaIncomeStatementSmartViewBusinessObject

	_Super:new()

	//Define a Área
	self:appendArea( "AgroDistribuidor" ) //AgroDistribuidor

	//Define o nome do Objeto de Negócio
	self:setDisplayName( STR0001 ) //"Informe de Rendimentos Cooperado"

	//Define a descrição do Objeto de Negócio
	self:setDescription( STR0001 ) //"Informe de Rendimentos Cooperado"


Return self

/*{Protheus.doc} getData
Retorna os dados do objeto de negócio
@param nPage, numérico, indica a página atual do relatório
@param oFilter, objeto, contém o filtro do SmartView
@return object: self:oData
@version 1.0
@author carlos.augusto
@since 18/08/2026
*/
Method getData( nPage as Numeric, oFilter as object) as object Class QuotaIncomeStatementSmartViewBusinessObject
	Local nX			   := 0
	Local aItens		   := {}
	Local aFields 		   := {}
	Local oRepository      := Nil
	Local aAllowedFields   := FwProtectedDataUtil():UsrAccessPDField(__cUserID, {"NF0_CPFBEN","NF0_NOMBEN","CVB_NOME"})
	Local aProtectedMap    := {{"NF0_CPFBEN","cpfBeneficiario"},{"NF0_NOMBEN","nomeBeneficiario"},{"CVB_NOME","nomeContabilista"}}
	Local jItem			   := Nil
	Local cAtribAnonimizar := ""
	Local nField 		   := 0
	Local lParamOk   	   := .T.
	Local jParams    	   := oFilter:getParameters()
	Local aFiliais    	   := {}

	lParamOk := Self:validarParametrosEntrada(jParams)

	If lParamOk

		aFiliais  := Self:getFiliaisUsuarioFilter(jParams)
		If Empty(aFiliais)
			self:setErrorStatus(400,STR0012,STR0020) //"Parâmetros de entrada""O usuário não possui permissão de acesso no intervalo de filais informado."
		Else
			cWhereQry := Self:getWhereFilter(jParams, aFiliais)

			oRepository := QuotaIncomeStatementRepository():New()
			oRepository:findReportData(cWhereQry)
			aFields := oRepository:getFields()

			If oRepository:isSuccess() .And. Len(oRepository:getResponse()['items']) > 0

				aItens := oRepository:getResponse()['items']

				If Len(aItens) > 0

					For nX := 1 To Len(aItens)
						AEval(aFields, {|aField| ;
							IIf(aItens[nX]:HasProperty(aField[1]) .And. aField[3] == 'D', ;
							aItens[nX][aField[1]] := IIf(!Empty(aItens[nX][aField[1]]), ;
							totvs.framework.treports.date.dateToTimeStamp(StoD(strtran(aItens[nX][aField[1]],'-',''))), ; //tratando campo data vindo de API
						totvs.framework.treports.date.stringToTimeStamp(aItens[nX][aField[1]])), ;
							Nil) ;
							})

						jItem := aItens[nX]

						//Anonimiza os campos protegidos
						For nField := 1 To Len(aProtectedMap)
							If AScan(aAllowedFields,aProtectedMap[nField][1]) == 0
								cAtribAnonimizar := aProtectedMap[nField][2]
								If !Empty(jItem:GetJsonObject( cAtribAnonimizar )) 

									If jItem:HasProperty(cAtribAnonimizar)
										jItem[cAtribAnonimizar] := FwProtectedDataUtil():ValueAsteriskToAnonymize( jItem:GetJsonObject( cAtribAnonimizar )  )
									EndIf
								EndIf

							EndIf
						Next nField
						//Fim anonimização
					
						self:oData:appendData(aItens[nX])
					Next
				EndIf

				FreeObj(oRepository)
			Else
				self:setErrorStatus(400,STR0014,STR0015) //"Nenhum registro encontrado""Não foram encontrados registros para os parâmetros informados."
			EndIf
		EndIf

	EndIf

Return self:oData

/*{Protheus.doc} getSchema
Retorna a estrutura dos campos
@return object: self:oSchema
@version 1.0
@author carlos.augusto
@since 18/08/2026
*/
method getSchema() as object class QuotaIncomeStatementSmartViewBusinessObject
	Local oRepository As Object

	oRepository := QuotaIncomeStatementRepository():New()
	AEval(oRepository:getFields(),{|field| self:addProperty(field[1], field[1], self:getType(field[3]), field[1], field[2]) })

	self:addParameter("filialDe"                  , STR0002, "string", .F., "", .F., .T., "", "MV_PAR01", "", .F.) //"Filial de" 
	self:addParameter("filialAte"                 , STR0003, "string", .F., "", .F., .T., "", "MV_PAR02", "", .F.)  //"Filial até"
	self:addParameter("codigoCooperadoDe"         , STR0004, "string", .F., "", .F., .T., "", "MV_PAR03", "", .F.) //"Cooperado de"  
	self:addParameter("lojaCooperadoDe"           , STR0005, "string", .F., "", .F., .F., "", "MV_PAR04", "", .F.) //"Loja Cooperado de"
	self:addParameter("codigoCooperadoAte"        , STR0006, "string", .F., "", .F., .T., "", "MV_PAR05", "", .F.)  //"Cooperado até" 
	self:addParameter("lojaCooperadoAte"          , STR0007, "string", .F., "", .F., .F., "", "MV_PAR06", "", .F.)  //"Loja Cooperado até"     
	self:addParameter("matriculaDe"               , STR0008, "string", .F., "", .F., .F., "", "MV_PAR07", "", .F.) //"Matrícula de"
	self:addParameter("matriculaAte"              , STR0009, "string", .F., "", .F., .F., "", "MV_PAR08", "", .F.)  //"Matrícula até"
	self:addParameter("anoCalendario"             , STR0010, "string", .F., "", .F., .F., "", "MV_PAR09", "", .F.)	//"Ano Referência"
	self:addParameter("codigoContabilista"        , STR0011, "string", .F., "", .F., .T., "", "MV_PAR10", "", .F.) 	//"Contabilista Responsável"

	self:setCustomURL("filialDe"                  , "/api/framework/v1/genericLookupService/smartview/SM0"   , 2)
	self:setCustomURL("filialAte"                 , "/api/framework/v1/genericLookupService/smartview/SM0"   , 2)
	self:setCustomURL("codigoCooperadoDe"         , "/api/framework/v1/genericLookupService/smartview/NEPNF3", 2)
	self:setCustomURL("codigoCooperadoAte"        , "/api/framework/v1/genericLookupService/smartview/NEPNF3", 2)
	self:setCustomURL("codigoContabilista"   	  , "/api/framework/v1/genericLookupService/smartview/CVB"   , 2)

return self:oSchema


/*{Protheus.doc} validarParametrosEntrada
Valida os parâmetros de entrada
@param json: jParams
@return logical: lParamOk
@version 1.0
@author carlos.augusto
@since 18/08/2026
*/
Method validarParametrosEntrada(jParams as json) class QuotaIncomeStatementSmartViewBusinessObject
	Local lParamOk := .T.

	If Empty(jParams['anoCalendario'][1]) .Or.;
		(Empty(jParams['codigoCooperadoDe'][1])) .And.;
		 Empty(jParams['codigoCooperadoAte'][1]) .And.;
		 Empty(jParams['matriculaDe'][1]) .And.;
		 Empty(jParams['matriculaAte'][1])
		self:setErrorStatus(400,STR0012,STR0013)//"Parâmetros de entrada""Falha na criação do filtro. O ano-calendário é obrigatório. Informe também o cooperado ou a matrícula."
		lParamOk := .F.
	EndIf

	If lParamOk .And. Upper(RTrim(jParams['filialDe'][1])) > Upper(RTrim(jParams['filialAte'][1]))
		self:setErrorStatus(400,STR0012,STR0016)//"Intervalo de filiais inválido."
		lParamOk := .F.
	EndIf

	If lParamOk .And. Upper(RTrim(jParams['codigoCooperadoDe'][1])) > Upper(RTrim(jParams['codigoCooperadoAte'][1]))
		self:setErrorStatus(400,STR0012,STR0017)//"Intervalo do código do cooperado inválido."
		lParamOk := .F.
	EndIf

	If lParamOk .And. Upper(RTrim(jParams['lojaCooperadoDe'][1])) > Upper(RTrim(jParams['lojaCooperadoAte'][1]))
		self:setErrorStatus(400,STR0012,STR0018)//"Intervalo da loja do cooperado inválido."
		lParamOk := .F.
	EndIf

	If lParamOk .And. Upper(RTrim(jParams['matriculaDe'][1])) > Upper(RTrim(jParams['matriculaAte'][1]))
		self:setErrorStatus(400,STR0012,STR0019)//"Intervalo de matrículas inválido."
		lParamOk := .F.
	EndIf

Return lParamOk

/*{Protheus.doc} getWhereFilter
Gera a cláusula WHERE do filtro do SmartView para uso no repository
@param json: jParams
@return cWhereQry, character, where pronta com os filtros do SmartView
@version 1.0
@author carlos.augusto
@since 18/08/2026
*/
method getWhereFilter(oJsonIn, aFiliais) as object class QuotaIncomeStatementSmartViewBusinessObject
	Local cWhereQry  := ""
	
	If !Empty(oJsonIn["codigoContabilista"][1]) 
		cWhereQry   += " AND NF0_CODCTB = '" + oJsonIn["codigoContabilista"][1] + "'"
	EndIf

	If !Empty(oJsonIn["anoCalendario"][1]) 
		cWhereQry   += " AND NF0_ANOCAL = '" + oJsonIn["anoCalendario"][1] + "'"
	EndIf

	If (!Empty(oJsonIn["codigoCooperadoDe"][1]) .Or. !Empty(oJsonIn["codigoCooperadoAte"][1]))
		If oJsonIn["codigoCooperadoDe"][1] == oJsonIn["codigoCooperadoAte"][1]
			cWhereQry   += " AND NF0_CODCOO = '" + oJsonIn["codigoCooperadoDe"][1] + "'"
		Else
			If !Empty(oJsonIn["codigoCooperadoDe"][1])
				cWhereQry   += " AND NF0_CODCOO >= '" + oJsonIn["codigoCooperadoDe"][1] + "'"
			EndIf
			If !Empty(oJsonIn["codigoCooperadoAte"][1])
				cWhereQry   += " AND NF0_CODCOO <= '" + oJsonIn["codigoCooperadoAte"][1] + "'"
			EndIf
		EndIf
	EndIf

	If (!Empty(oJsonIn["lojaCooperadoDe"][1]) .Or. !Empty(oJsonIn["lojaCooperadoAte"][1]))
		If oJsonIn["lojaCooperadoDe"][1] == oJsonIn["lojaCooperadoAte"][1]
			cWhereQry   += " AND NF0_LOJCOO = '" + oJsonIn["lojaCooperadoDe"][1] + "'"
		Else
			If !Empty(oJsonIn["lojaCooperadoDe"][1])
				cWhereQry   += " AND NF0_LOJCOO >= '" + oJsonIn["lojaCooperadoDe"][1] + "'"
			EndIf
			If !Empty(oJsonIn["lojaCooperadoAte"][1])
				cWhereQry   += " AND NF0_LOJCOO <= '" + oJsonIn["lojaCooperadoAte"][1] + "'"
			EndIf
		EndIf
	EndIf

	If (!Empty(oJsonIn["matriculaDe"][1]) .Or. !Empty(oJsonIn["matriculaAte"][1]))
		If oJsonIn["matriculaDe"][1] == oJsonIn["matriculaAte"][1]
			cWhereQry   += " AND NEP_MATRIC = '" + oJsonIn["matriculaDe"][1] + "'"
		Else
			If !Empty(oJsonIn["matriculaDe"][1])
				cWhereQry   += " AND NEP_MATRIC >= '" + oJsonIn["matriculaDe"][1] + "'"
			EndIf
			If !Empty(oJsonIn["matriculaAte"][1])
				cWhereQry   += " AND NEP_MATRIC <= '" + oJsonIn["matriculaAte"][1] + "'"
			EndIf
		EndIf
	EndIf

	If !Empty(aFiliais)
		cWhereQry   += " AND NF0_FILIAL IN ('" + ArrTokStr(aFiliais, "','") + "')"
	EndIf

Return cWhereQry

/*/{Protheus.doc} getFiliaisUsuarioFilter
Retorna as filiais que o usuário logado podera filtrar baseado no range de filtros SmartView informado
@type method
@return variant, json
@param oJsonIn, object, json de parametros do SmartView
@version 1.0
@author carlos.augusto
@since 21/08/2026
/*/
method getFiliaisUsuarioFilter(oJsonIn) class QuotaIncomeStatementSmartViewBusinessObject
	Local aFilUser   := {}
	Local aFiliais   := {}
	Local nTamFilial := Len(FwCodFil())
	Local lAddFilial := .F.
	Local cFilCompar := ""
	Local nJ		 := 0
	Local cFilUserOk   := ""
	Local cFilParamDe  := ""
	Local cFilParamAte := ""

	aFilUser := Self:getAllFiliaisUsuario()

	If !Empty(aFilUser) .And. (FwModeAccess("NF0",1) + FwModeAccess("NF0",2) + FwModeAccess("NF0",3)) == "CCC" //Totalmente compartilhada nao filtra por filiais
		aAdd(aFiliais, Space(nTamFilial))
	ElseIf !Empty(aFilUser)
		For nJ := 1 To Len(aFilUser)
			cFilCompar := aFilUser[nJ]

			cFilUserOk   := FWxFilial("NF0", cFilCompar)
			lAddFilial := .T.

			If (!Empty(oJsonIn["filialDe"][1]) .Or. !Empty(oJsonIn["filialAte"][1]))
				cFilParamDe  := FWxFilial("NF0", PadR(RTrim(oJsonIn["filialDe"][1]), nTamFilial))
				cFilParamAte := FWxFilial("NF0", PadR(RTrim(oJsonIn["filialAte"][1]),nTamFilial))

				If !Empty(oJsonIn["filialDe"][1]) .And.  (cFilUserOk < cFilParamDe) //Limite inferior     
					lAddFilial := .F.
				EndIf
				If !Empty(oJsonIn["filialAte"][1]) .And. (cFilUserOk > cFilParamAte) //Limite valor max
					lAddFilial := .F.
				EndIf
			EndIf

			If lAddFilial .And. aScan(aFiliais, {|x| x == cFilUserOk}) == 0 //Adiciona a filial somente se não estiver na lista
				aAdd(aFiliais, cFilUserOk)   
			EndIf
		Next nJ
	EndIf

Return aFiliais

/*/{Protheus.doc} getAllFiliaisUsuario
Retorna apenas as filiais que o usuário logado tem acesso de acordo com o grupo de empresas logado
@type method
@return variant, json
@param oJsonIn, object, json de parametros do SmartView
@version 1.0
@author carlos.augusto
@since 21/08/2026
/*/
Method getAllFiliaisUsuario() class QuotaIncomeStatementSmartViewBusinessObject
	Local aArea		 := GetArea()
	Local cGrpEmp    := FwGrpCompany()
	Local nTamGrupo  := Len(cGrpEmp)
	Local nTamFilial := Len(FwCodFil())
	Local cUsrCod	 := RetCodUsr()
	Local aGrpFil	 := {}
	Local aGrpUsr	 := {}
	Local aFilUser	 := {}
	Local aAcesFil	 := {}
	Local aFilSM0    := {}
	Local nGrp		 := 0
	Local nX		 := 0
	Local nI 	     := 0
	Local cGRule	 := ""
	Local cGrpCompar := ""

	aGrpFil := FWUsrEmp(cUsrCod)
	cGRule	:= FWUsrGrpRule(cUsrCod)
	If (!Empty(aGrpFil) .And. aGrpFil[1] == "@@@@" .And. cGRule != "1") .Or. PswId() == "000000"
		aFilSM0 := FWLoadSM0()
		For nI := 1 To Len(aFilSM0)
			If cGrpEmp == aFilSM0[nI][1]
				Aadd(aFilUser, aFilSM0[nI][2])
			EndIf
		Next nI
	Else
		If cGRule != "1" //Regra baseada no usuario
			If !Empty(aGrpFil)
				For nX := 1 To Len(aGrpFil)
					cGrpCompar := SubStr(aGrpFil[nX],1,nTamGrupo)
					If cGrpEmp == cGrpCompar
						Aadd(aFilUser, SubStr(aGrpFil[nX],nTamGrupo+1,nTamFilial))
					EndIf
				Next nX
			EndIf
		EndIf

		If cGRule != "2" //Regra baseada no grupo de usuarios priorizado do usuario 
			aGrpUsr := UsrRetGrp(, cUsrCod)
			For nGrp := 1 To Len(aGrpUsr)
				aAcesFil := FWGrpEmp(aGrpUsr[nGrp])
				If !Empty(aAcesFil) .And. aAcesFil[1] == "@@@@"
					aFilSM0 := FWLoadSM0()
					For nI := 1 To Len(aFilSM0)
						If cGrpEmp == aFilSM0[nI][1]
							Aadd(aFilUser, aFilSM0[nI][2])
						EndIf
					Next nI
				Else
					If !Empty(aAcesFil)
						For nX := 1 To Len(aAcesFil)
							cGrpCompar := SubStr(aAcesFil[nX],1,nTamGrupo)
							If cGrpEmp == cGrpCompar
								Aadd(aFilUser, SubStr(aAcesFil[nX],nTamGrupo+1,nTamFilial))
							EndIf
						Next nX
					EndIf
				EndIf
			Next nGrp
		EndIf
	EndIf

	RestArea(aArea)

Return(aFilUser)

/*/{Protheus.doc} getType
Formatacao de filtro para uso no repository
@type method
@return variant, string de tipo no formato esparado para SmartView
@param cType, character, tipo de campo da SX3
@version 1.0
@author lindembergson.pacheco
@since 16/03/2026
/*/
method getType(cType) as character class QuotaIncomeStatementSmartViewBusinessObject

	Local cRet := ""

	if cType == "D"
		cRet := "date"
	elseif cType == "N"
		cRet := "number"
	else
		cRet := "string"
	endif

return cRet

