#include "tlpp-core.th"
#include "totvs.ch"
#include "fwmvcdef.ch"
#include "backoffice.techfin.contadigital.monitor.ch"

NAMESPACE totvs.protheus.backoffice.techfin.contadigital.monitor
USING NAMESPACE totvs.protheus.backoffice.techfin.util
USING NAMESPACE totvs.protheus.backoffice.techfin.contadigital.smartlink.ContaDigitalCashoutBillPaymentCreateRequestV1

#DEFINE MODEL_OPERATION_BORDERO      2
#DEFINE MODEL_OPERATION_PARAMETROS   5
#DEFINE MODEL_OPERATION_TRANSMITIR   6

// Variáveis estáticas
Static __cAliasBor := GetNextAlias() as Character

/*/{Protheus.doc} borderoMonitor
    Função principal do Conta +TECHFIN onde carrega o browse
    responsável pela apresentação do borderos vinculados no Conta +TECHFIN
    
    @type       Function
    @author     Squad TechFin
    @since      03/06/2026
    @version    P12.1.2510
    @return     oBrowse, object, Objeto do browse carregado
/*/
Function borderoMonitor() as Object
    Local nX            := 0  as numeric
    Local nTimerBrowse  := 0 as Numeric //Tempo de atualização da legenda do monitor em milissegundos 
    Local aFilter       := {} as Array
    Local aSeek         := {} as Array
    Local aColumns	    := {} as array
    Local oFwBrowse     := FWmBrowse():New()  as object
    Local bUpdLegMonitor as CodeBlock

    bUpdLegMonitor := {|| monitorborderoRefresh(),oFWBrowse:Refresh() } //Atualização da Legenda do Monitor, sem a necessidade de atualizar os dados da browse, apenas a legenda, onde será verificado se existe algum borderô com status diferente

    nTimerBrowse  := 10000 //default 10 segundos, futuramente pode ser parametrizado via getmv

    FWMsgRun(, {|| aColumns := monitorborderoGetstruct(1)[1]}, "", STR0010) //"! Estamos preparando tudo para você…"
    FWMsgRun(, {|| borderomonitorLoad(__cAliasBor)}, "", STR0010) //"! Estamos preparando tudo para você…" //

    oFwBrowse:SetAlias(__cAliasBor)
    oFwBrowse:SetMainProc("borderoMonitor")
    oFwBrowse:SetDescription(I18N(STR0001,{"Conta +TECHFIN"})) //"Monitor Conta +TECHFIN "
        
    oFwBrowse:SetMenuDef("totvs.protheus.backoffice.techfin.contadigital.monitor.borderoMonitor")

    oFwBrowse:SetTemporary(.T.)
    oFwBrowse:SetTimer(bUpdLegMonitor, nTimerBrowse )

    oFwBrowse:AddLegend("EA_STTFIN $ ' #1'" , "BR_BRANCO"   , STR0006,,.T.,"caption-tag-17") // 1 - Pendente de transmissão
    oFwBrowse:AddLegend("EA_STTFIN == 'T'"  , "BR_AZUL"     , STR0007,,.T.,"caption-tag-18") // T - Transmitido
   
    oFwBrowse:AddMarkColumns(;
        {||If((__cAliasBor)->EA_OK,'LBOK','LBNO')},;
         {||MonitorborderoMark(1),oFWBrowse:Refresh()},;
         {||MonitorborderoMark(2),oFWBrowse:Refresh()})

    For nX := 1 To Len(aColumns )
        oFwBrowse:AddColumn( aColumns[nX] )
        Aadd(aFilter,{aColumns[nX][17],aColumns[nX][1],aColumns[nX][3],aColumns[nX][6],aColumns[nX][7],aColumns[nX][4]})
    Next
    oFwBrowse:SetFieldFilter(aFilter)

    Aadd(aSeek,{ STR0011, {{STR0011,"C",TamSX3('EA_FILIAL')[2]+TamSX3('EA_NUMBOR')[2],0,"",,}} })
    Aadd(aSeek,{ STR0012, {{STR0012,"C",TamSX3('EA_FILIAL')[2]+TamSX3('EA_DATABOR')[2]+TamSX3('EA_NUMBOR')[2],0,"",,}} })
    Aadd(aSeek,{ STR0013, {{STR0013,"C",TamSX3('EA_PORTADO')[2]+TamSX3('EA_AGEDEP')[2]+TamSX3('EA_NUMCON')[2]+TamSX3('EA_DATABOR')[2]+TamSX3('EA_NUMBOR')[2],0,"",,}} })
    oFwBrowse:SetSeek(.T.,aSeek)
      
    oFwBrowse:Activate()
	
Return oFwBrowse

/*/{Protheus.doc} MenuDef
    Definição do menu (aRotina) do monitor do Conta +TECHFIN , contendo as
    opções de inclusão, visualização, solicitação de saque, alteração
    e exclusão de títulos.

    @type       Function
    @author     Squad TechFin
    @since      03/06/2026
    @version    1.0
    @return     aRotina, array, Array com as opções de menu
/*/
Function Menudef() as Array
    Local aRotina := {} as Array

	ADD OPTION aRotina TITLE STR0008 ACTION 'totvs.protheus.backoffice.techfin.contadigital.monitor.borderomonitorTransmitir'    OPERATION MODEL_OPERATION_TRANSMITIR    ACCESS 1 // 'Transmitir Bordero'
    ADD OPTION aRotina TITLE STR0016 ACTION 'VIEWDEF.totvs.protheus.backoffice.techfin.contadigital.monitor.borderoMonitor'      OPERATION MODEL_OPERATION_BORDERO	    ACCESS 2 // 'Visualizar'
    ADD OPTION aRotina TITLE STR0009 ACTION 'totvs.protheus.backoffice.techfin.contadigital.monitor.borderomonitorLoad'          OPERATION MODEL_OPERATION_PARAMETROS    ACCESS 3 // 'Parâmetros'

Return aRotina

/*/{Protheus.doc} ModelDef
    Definição do model (MVC) do monitor do Conta +TECHFIN. Cria a estrutura
    com a entidade mestre ART (título) e o grid de detalhe ARQ (histórico
    do título), definindo a chave primária ART_IDDOC.

    @type       Function
    @author     Squad TechFin
    @since      03/06/2026
    @version    1.0
    @return     oModel, object, Objeto do modelo de dados (MPFormModel)
/*/
Function ModelDef() as Object
    Local oModel    as Object
    Local oStruBOR  as Object
    Local oStruSEA  as Object
        
    FWMsgRun(, {|| oStruBOR := monitorborderoGetstruct(3)[2]}, "", STR0010) //"! Estamos preparando tudo para você…"
    oStruSEA  := FWFormStruct( 1, 'SEA')  
    oStruSEA:AddField(" "      ,"",'EA_LEG'     ,"BT"                   ,1                      ,0                      ,{|| .T.} , /*bWhen*/, , .F.,{||monitorborderoGetValues("EA_LEG")}/*bInit*/     , /*lKey*/, .F. /*lNoUpd*/, .T./*lVirtual*/)
    oStruSEA:AddField(" "      ,"",'EA_STADES'  ,"C"                    ,33                     ,0                      ,{|| .T.} , /*bWhen*/, , .F.,{||monitorborderoGetValues("EA_STADES")}/*bInit*/  , /*lKey*/, .F. /*lNoUpd*/, .T./*lVirtual*/)
    oStruSEA:AddField(" "      ,"",'EA_TIPO'    ,TamSx3("EA_TIPO")[3]   ,TamSx3("EA_TIPO")[1]   ,TamSx3("EA_TIPO")[2]   ,{|| .T.} , /*bWhen*/, , .F.,/*bInit*/                                          , /*lKey*/, .F. /*lNoUpd*/, .F./*lVirtual*/)
    oStruSEA:AddField(" "      ,"",'EA_FORNECE' ,TamSx3("EA_FORNECE")[3],TamSx3("EA_FORNECE")[1],TamSx3("EA_FORNECE")[2],{|| .T.} , /*bWhen*/, , .F.,/*bInit*/                                          , /*lKey*/, .F. /*lNoUpd*/, .F./*lVirtual*/)
    oStruSEA:AddField(" "      ,"",'EA_LOJA'    ,TamSx3("EA_LOJA")[3]   ,TamSx3("EA_LOJA")[1]   ,TamSx3("EA_LOJA")[2]   ,{|| .T.} , /*bWhen*/, , .F.,/*bInit*/                                          , /*lKey*/, .F. /*lNoUpd*/, .F./*lVirtual*/)
    oStruSEA:AddField(" "      ,"",'E2_NOMFOR'  ,TamSx3("E2_NOMFOR")[3] ,TamSx3("E2_NOMFOR")[1] ,TamSx3("E2_NOMFOR")[2] ,{|| .T.} , /*bWhen*/, , .F.,{||monitorborderoGetValues("E2_NOMFOR")}/*bInit*/  , /*lKey*/, .F. /*lNoUpd*/, .T./*lVirtual*/)
    oStruSEA:AddField(" "      ,"",'E2_EMIS1'   ,"C"                    ,10                     ,0                      ,{|| .T.} , /*bWhen*/, , .F.,{||monitorborderoGetValues("E2_EMIS1")}/*bInit*/   , /*lKey*/, .F. /*lNoUpd*/, .T./*lVirtual*/)
    oStruSEA:AddField(" "      ,"",'E2_VENCREA' ,"C"                    ,10                     ,0                      ,{|| .T.} , /*bWhen*/, , .F.,{||monitorborderoGetValues("E2_VENCREA")}/*bInit*/ , /*lKey*/, .F. /*lNoUpd*/, .T./*lVirtual*/)
    oStruSEA:AddField(" "      ,"",'E2_SALDO'   ,"C"                    ,20                     ,0                      ,{|| .T.} , /*bWhen*/, , .F.,{||monitorborderoGetValues("E2_SALDO")}/*bInit*/   , /*lKey*/, .F. /*lNoUpd*/, .T./*lVirtual*/)
    
    oModel := MPFormModel():New( 'borderoMonitor', /*bPreValidacao*/, /*bPosValidacao*/, /*bCommit*/, /*bCancel*/ )    
    oModel:AddFields( 'SEAMASTER', /*cOwner*/, oStruBOR)

    oModel:SetPrimaryKey({"EA_FILIAL","EA_NUMBOR"})
    oModel:AddGrid( 'SEADETAIL', 'SEAMASTER', oStruSEA, /*bLinePre*/, /*bLinePost*/, /*bPreVal*/, /*bPosVal*/, /*BLoad*/ )
    oModel:SetRelation( 'SEADETAIL', { { 'EA_FILIAL', __cAliasBor+'->EA_FILIAL' }, { 'EA_NUMBOR',  __cAliasBor+'->EA_NUMBOR' } }, SEA->( IndexKey( 1 ) ) )
    oModel:SetDescription(I18N(STR0014,{"Conta +TECHFIN"})) // //"Borderô - Conta +TECHFIN"
    
    oModel:GetModel( 'SEAMASTER' ):SetDescription( 'DADOS' )
    oModel:GetModel( 'SEADETAIL' ):SetDescription( 'TITULOS' )

Return oModel

/*/{Protheus.doc} ViewDef
    Definição da view (MVC) do monitor do Conta +TECHFIN. Monta o formulário
    de visualização do título (ART) e o grid de histórico (ARQ),
    organizando-os em boxes horizontais superior e inferior.

    @type       Function
    @author     Squad TechFin
    @since      03/06/2026
    @version    1.0
    @return     oView, object, Objeto da view (FWFormView)
/*/
Function ViewDef() as Object
    Local oView          as Object
    Local oModel         as Object
    Local oStruBOR       as Object
    Local oStruSEA       as Object
    Local aFieldsSEA     as array
    Local aStruSEA       as array
    Local nX := 0        as Numeric
    
    FWMsgRun(, {|| oStruBOR := monitorborderoGetstruct(4)[2]}, "", STR0010) //"! Estamos preparando tudo para você…"
    oStruSEA := FWFormStruct( 2, 'SEA')  
    aFieldsSEA := StrTokArr2("EA_FILIAL;EA_PREFIXO;EA_NUM;EA_PARCELA;EA_TIPO;EA_FORNECE;EA_LOJA;EA_TRANSF;EA_SITUACA;EA_COUNTE1",";")
    aStruSEA := aClone(oStruSEA:aFields)
    For nX := 1 to Len(aStruSEA) 
        If aScan(aFieldsSEA,aStruSEA[nX][1]) == 0
            oStruSEA:RemoveField(aStruSEA[nX][1])
        Endif
    Next
    oStruSEA:AddField("EA_LEG"      , "00", ' '                              , ' '                               , {}/*aHelp*/, "BT",'@BMP'/*cPicture*/,/*PictVar*/,/*cLookUp*/,.F./*lCanChange*/,/*cFolder*/,/*cGroup*/,/*aComboValues*/,/*nMaxLenCombo*/,/*cIniBrow*/, .T. /*lVirtual*/)
    oStruSEA:AddField("EA_STADES"   , "01", AllTrim(FwX3Titulo("EA_STTFIN")) , AllTrim(FwX3Titulo("EA_STTFIN"))  , {}/*aHelp*/, "C" ,''/*cPicture*/    ,/*PictVar*/,/*cLookUp*/,.F./*lCanChange*/,/*cFolder*/,/*cGroup*/,/*aComboValues*/,/*nMaxLenCombo*/,/*cIniBrow*/, .T. /*lVirtual*/)
    oStruSEA:AddField("EA_LOJA"     , "06", AllTrim(FwX3Titulo("EA_LOJA"))   , AllTrim(FwX3Titulo("EA_LOJA"))    , Nil        , "C", "@!"              , NIL       ,           ,.T.             , NIL        , NIL      , NIL            , NIL            , NIL        , .F.         ) 
    oStruSEA:AddField("EA_FORNECE"  , "07", AllTrim(FwX3Titulo("EA_FORNECE")), AllTrim(FwX3Titulo("EA_FORNECE")) , Nil        , "C", "@!"              , NIL       ,           ,.T.             , NIL        , NIL      , NIL            , NIL            , NIL        , .F.         ) 
    oStruSEA:AddField("EA_TIPO"     , "08", AllTrim(FwX3Titulo("EA_TIPO"))   , AllTrim(FwX3Titulo("EA_TIPO"))    , Nil        , "C", "@!"              , NIL       ,           ,.T.             , NIL        , NIL      , NIL            , NIL            , NIL        , .F.         ) 
    oStruSEA:AddField("E2_NOMFOR"   , "09", AllTrim(FwX3Titulo("E2_NOMFOR")) , AllTrim(FwX3Titulo("E2_NOMFOR"))  , Nil        , "C", "@!"              , NIL       ,           ,.T.             , NIL        , NIL      , NIL            , NIL            , NIL        , .F.         ) 
    oStruSEA:AddField("E2_EMIS1"    , "10", AllTrim(FwX3Titulo("E2_EMIS1"))  , AllTrim(FwX3Titulo("E2_EMIS1"))   , Nil        , "C", "@!"              , NIL       ,           ,.T.             , NIL        , NIL      , NIL            , NIL            , NIL        , .F.         ) 
    oStruSEA:AddField("E2_VENCREA"  , "11", AllTrim(FwX3Titulo("E2_VENCREA")), AllTrim(FwX3Titulo("E2_VENCREA")) , Nil        , "C", "@!"              , NIL       ,           ,.T.             , NIL        , NIL      , NIL            , NIL            , NIL        , .F.         ) 
    oStruSEA:AddField("E2_SALDO"    , "12", AllTrim(FwX3Titulo("E2_SALDO"))  , AllTrim(FwX3Titulo("E2_SALDO"))   , Nil        , "C", "@!"              , NIL       ,           ,.T.             , NIL        , NIL      , NIL            , NIL            , NIL        , .F.         ) 

    oModel := FWLoadModel( 'totvs.protheus.backoffice.techfin.contadigital.monitor.borderoMonitor' )
    oView := FWFormView():New()
    oView:SetModel( oModel )
    
    oView:AddField( 'VIEW_BOR', oStruBOR, 'SEAMASTER' )
    oView:AddGrid(  'VIEW_SEA', oStruSEA, 'SEADETAIL' )

    oView:CreateHorizontalBox( 'SUPERIOR', 30 )
    oView:CreateHorizontalBox( 'INFERIOR', 70 )
    oView:SetOwnerView( 'VIEW_BOR', 'SUPERIOR' )
    oView:SetOwnerView( 'VIEW_SEA', 'INFERIOR' )
    
    oView:AddIncrementField( 'VIEW_SEA', 'EA_ITEM' )
    oView:EnableTitleView('VIEW_SEA', STR0015 ) //"Títulos vinculados no Bordero"
    oView:SetViewProperty('VIEW_SEA', "GRIDSEEK" )
    oView:SetViewProperty("VIEW_SEA","GRIDDOUBLECLICK", {{|oGrid,cField,nLineGrid,nLineModel| monitorborderoDoubleClick(oGrid,cField,nLineGrid,nLineModel)}} )

    oView:ShowUpdateMsg(.F.)
    oView:SetCloseOnOk( {|| .T. } )

Return oView

/*/{Protheus.doc} borderomonitorLoad
    Efetua o load dos dados para o browse do monitor de borderôs. Realiza a consulta SQL 
    para buscar os dados da tabela SEA

    @type       Function
    @author     Squad TechFin
    @since      03/06/2026
    @version    1.0
    @param      cAliasBor, character, alias onde será carregado os dados para o monitor de borderôs
    @return     Nil
/*/
Function borderomonitorLoad(cAliasBor as Character)
    local cChaveSEA     := ""                   as character
    local cAliasQuery   := ""                   as character
    local cQuery        := ""                   as character
    local cStatusBrw    := ""                   as character
    local nX            := 0                    as numeric
    Local nTotTit       := 0                    as numeric
    local nBindParam    := 1                    as numeric
    local aCampos       := {}                   as array
    local aAreaSEA      := SEA->(FwGetArea())   as array
    local aIndex        := {}                   as array
    Local oExecQuery                            as Object
    Local oTemporaryTable                       as Object
    Default cAliasBor := __cAliasBor 

    Pergunte('TFIN003', .T.)
    aCampos := monitorborderoGetstruct(2)[1]
    If Select(cAliasBor) > 0 
        (cAliasBor)->(dbCloseArea())
    Endif
    oTemporaryTable := FWTemporaryTable():New(cAliasBor,aCampos)

    Aadd(aIndex, {"EA_FILIAL","EA_NUMBOR"})
    Aadd(aIndex, {"EA_FILIAL","EA_DATABOR","EA_NUMBOR"})
    Aadd(aIndex, {"EA_PORTADO","EA_AGEDEP","EA_NUMCON","EA_DATABOR","EA_NUMBOR"})
    For nX := 1 to len(aIndex)
        oTemporaryTable:AddIndex(cValToChar(nX), aIndex[nX])
    Next nX
    oTemporaryTable:Create()

    For nX := 1 to Len(aCampos)
        If ! Alltrim(aCampos[nX][1]) $ "EA_COUNTE1#EA_OK"
            If Empty(cQuery)
                cQuery += " SELECT "+"SEA."+aCampos[nX][1]
            Else
                cQuery += " ,SEA."+aCampos[nX][1]
            Endif    
        Endif   
    Next nX
    cQuery += " FROM " + RetSqlName("SEA") + " SEA "
    cQuery += "	INNER JOIN " + RetSqlName("SA6") + " SA6 ON " + FWJoinFilial("SA6", "SEA")
	cQuery += "	    AND SA6.A6_COD = SEA.EA_PORTADO "
	cQuery += "	    AND SA6.A6_AGENCIA = SEA.EA_AGEDEP "
	cQuery += "	    AND SA6.A6_NUMCON = SEA.EA_NUMCON " 
	cQuery += "	    AND SA6.A6_TFCNT = ? "
	cQuery += "	    AND SA6.D_E_L_E_T_ = ? "
    cQuery += " WHERE "
    cQuery += " SEA.EA_CART = ? "
    cQuery += " AND SEA.EA_FILIAL BETWEEN ? AND ? "
    cQuery += " AND SEA.EA_DATABOR BETWEEN ? AND ? "
    cQuery += " AND SEA.EA_NUMBOR BETWEEN ? AND ? "
    IF MV_PAR07 == 2
       cQuery += " AND SEA.EA_STTFIN IN ( ? , ? , ? ) "
    Endif
    cQuery += " AND SEA.D_E_L_E_T_= ? "
    cQuery += "Order By EA_FILIAL, EA_NUMBOR" 
    cQuery := ChangeQuery(cQuery)

    oExecQuery := FwExecStatement():New(cQuery)
    
    oExecQuery:SetString(nBindParam++, "1") //A6_TFCNT
    oExecQuery:SetString(nBindParam++, " ") //D_E_L_E_T_
    oExecQuery:SetString(nBindParam++, "P") //EA_CART
    oExecQuery:SetString(nBindParam++, MV_PAR01) //EA_FILIAL
    oExecQuery:SetString(nBindParam++, MV_PAR02) //EA_FILIAL
    oExecQuery:SetDate(nBindParam++, MV_PAR03) //EA_DATABOR
    oExecQuery:SetDate(nBindParam++, MV_PAR04) //EA_DATABOR
    oExecQuery:SetString(nBindParam++, MV_PAR05) //EA_NUMBOR
    oExecQuery:SetString(nBindParam++, MV_PAR06) //EA_NUMBOR 
    IF MV_PAR07 == 2
       oExecQuery:SetString(nBindParam++, " ") //EA_CART
       oExecQuery:SetString(nBindParam++, "1") //EA_CART
       oExecQuery:SetString(nBindParam++, "9") //EA_CART
    Endif
    oExecQuery:SetString(nBindParam++, " ") //SEA.D_E_L_E_T_

    cAliasQuery := oExecQuery:OpenAlias()
    TcSetField(cAliasQuery,"EA_DATABOR","D",8,0)

    While (cAliasQuery)->(!Eof())
        cChaveSEA := (cAliasQuery)->(EA_FILIAL+EA_NUMBOR)
        cStatusBrw := "1"
        RecLock(cAliasBor, .T.)
        For nX:=1 to Len(aCampos)
            If ! aCampos[nX][1] $ "EA_COUNTE1#EA_OK"
                (cAliasBor)->&(aCampos[nX][1]) := (cAliasQuery)->&(aCampos[nX][1])
            Endif    
        Next nX
        nTotTit := 0
        While (cAliasQuery)->(!Eof()) .AND. cChaveSEA ==  (cAliasQuery)->(EA_FILIAL+EA_NUMBOR)       
            If ! (cAliasQuery)->(EA_STTFIN) $ ' #1#9'
                cStatusBrw := 'T'
            Endif
            nTotTit++
            (cAliasQuery)->(dbSkip())
        Enddo    
        (cAliasBor)->EA_STTFIN := cStatusBrw
        (cAliasBor)->EA_COUNTE1 := nTotTit
        (cAliasBor)->EA_OK :=  .F.
        (cAliasBor)->(msUnLock())
    Enddo
    (cAliasQuery)->(dbCloseArea())
    (cAliasBor)->(DbSetOrder(1))
    (cAliasBor)->(DbGoTop())

    FwRestArea(aAreaSEA)
Return

/*/{Protheus.doc} borderomonitorTransmitir
    Função para reenviar borderô de pagamento valido para Techfin após a seleção do 
    usuário no monitor de borderôs

    @type       Function
    @author     Squad TechFin
    @since      03/06/2026
    @version    1.0
    @param      Nil
    @return     Nil
/*/
Function borderomonitorTransmitir() 
    Local aRecnosBor  as Array
    Local lEnvBor := .F. as Logical
    Local nRecPos   := (__cAliasBor)->(Recno()) as Numeric
    Local nDelayJob := 5000 as Numeric //Tempo de delay para execução do job em milissegundos de espera para executar o refresh na tela
    
    If MsgYesNo( Alltrim(UsrRetName(RetCodUsr()))+STR0017, STR0018 ) //", Deseja retransmitir os borderôs selecionados para a TECHFIN?"|"Confirmar retransmissão dos borderôs"
        SEA->(dbSetorder(1))
        (__cAliasBor)->(DbGoTop())
        While ! (__cAliasBor)->(EoF())
            If (__cAliasBor)->EA_OK
                lEnvBor := .T.
                IF SEA->(MsSeek((__cAliasBor)->(EA_FILIAL+EA_NUMBOR)))
                    aRecnosBor := {}
                    Do While ! SEA->(EoF()) .AND. (__cAliasBor)->(EA_FILIAL+EA_NUMBOR) == SEA->(EA_FILIAL+EA_NUMBOR)
                        Aadd(aRecnosBor,SEA->(Recno()))               
                        SEA->(DbSkip())
                    Enddo
                    FWMsgRun(, {|| borderoMonitorSend(aRecnosBor)}, "", STR0010) //"! Estamos preparando tudo para você…"
                Endif
                (__cAliasBor)->(RecLock(__cAliasBor,.F.)) 
                (__cAliasBor)->EA_OK  :=  .F.
                (__cAliasBor)->(MsUnlock())
            Endif
            (__cAliasBor)->(DbSkip())
        EndDo
        Sleep( nDelayJob ) //Tempo de delay para execução do job em milissegundos de espera para executar o refresh na tela
        monitorborderoRefresh()
        (__cAliasBor)->(DbGoTo(nRecPos))
        If ! lEnvBor 
            MsgInfo(STR0019,STR0020) //Selecione pelo menos um borderô válido para transmissão. |Seleção necessária
        Endif
    Endif    
Return

/*/{Protheus.doc} borderomonitorSend
    Função para reenviar borderô dos registros selecionados para Techfin após a 
    seleção do usuário no monitor de borderôs
    
    @type       Function
    @author     Squad TechFin
    @since      03/06/2026
    @version    1.0
    @param      aSEARecEnv, array, Array com os recnos dos registros da SEA a serem reenviados para Techfin
    @return     Nil
/*/
Function borderomonitorSend(aSEARecEnv as Array) 
    Local nX as Numeric
    For nX := 1 To Len(aSEARecEnv)
        SEA->(DbGoto(aSEARecEnv[nX]))
        If SEA->EA_STTFIN == '1' .OR. SEA->EA_STTFIN == '9' .OR. SEA->EA_STTFIN == ' '
            SEA->(RecLock("SEA",.F.)) 
            SEA->EA_STTFIN  := '1' 
            SEA->(MsUnlock())
            SetBillPayment(cEmpAnt, SEA->EA_FILIAL , SEA->EA_NUMBOR )
        Endif
    Next
    SEA->(DbGoto(aSEARecEnv[1]))
Return 

/*/{Protheus.doc} monitorborderoMark
    Função para marcar os registros no oFWBrowse após a seleção do 
    usuário no monitor de borderôs para transmissão 
    
    @type       Function
    @author     Squad TechFin
    @since      03/06/2026
    @version    1.0
    @param      nOpcMark, numeric, opção de marcação, onde 1 é para marcar os registros e 2 para desmarcar os registros
    @return     Nil
/*/
Function monitorborderoMark(nOpcMark as Numeric)
    Local  nRecPos   := (__cAliasBor)->(Recno()) as Numeric

    If nOpcMark == 2
        (__cAliasBor)->(DbGoTop())
    Endif    
    While ! (__cAliasBor)->(EoF()) .AND. (nOpcMark == 2 .OR. nRecPos == (__cAliasBor)->(Recno()))
        (__cAliasBor)->(RecLock(__cAliasBor,.F.))  
        If (__cAliasBor)->EA_STTFIN == '1'
            (__cAliasBor)->EA_OK  := ! (__cAliasBor)->EA_OK
        Else
            (__cAliasBor)->EA_OK  := .F.
        Endif    
        (__cAliasBor)->(MsUnlock())
        (__cAliasBor)->(DbSkip())
    EndDo
    (__cAliasBor)->(DbGoTo(nRecPos))
Return

/*/{Protheus.doc} monitorborderoRefresh
    Função para refresh dos registros no oFWBrowse após a transmissão do borderô para Techfin,
     onde será verificado o status dos registros e atualizado a legenda do monitor
    
    
    @type       Function
    @author     Squad TechFin
    @since      03/06/2026
    @version    1.0
    @param      Nil
    @return     Nil
/*/
Function monitorborderoRefresh() 
    Local  nRecPos   := (__cAliasBor)->(Recno()) as Numeric
    Local cEA_STTFIN := "" as Character 

    (__cAliasBor)->(DbGoTop())
    While ! (__cAliasBor)->(EoF()) 
        SEA->(dbSetorder(1))
        IF SEA->(MsSeek((__cAliasBor)->(EA_FILIAL+EA_NUMBOR)))
            cEA_STTFIN := "1" 
            Do While ! SEA->(EoF()) .AND. (__cAliasBor)->(EA_FILIAL+EA_NUMBOR) == SEA->(EA_FILIAL+EA_NUMBOR)
               If ! SEA->EA_STTFIN $ ' #1#9'
                    cEA_STTFIN := "T" 
                Endif
                SEA->(DbSkip())
            Enddo
            (__cAliasBor)->(RecLock(__cAliasBor,.F.)) 
            (__cAliasBor)->EA_STTFIN  := cEA_STTFIN
            (__cAliasBor)->(MsUnlock())
        Endif
        (__cAliasBor)->(DbSkip())
    EndDo
    (__cAliasBor)->(DbGoTo(nRecPos))
Return

/*/{Protheus.doc} monitorborderoGetstruct
   Função para gerar o array com estrutura utilizada nas funções de load dos dados do monitor de borderôs, onde 
   a origem 1 é para o browse e a origem 2 é para a view, onde cada uma possui campos e estruturas diferentes.
   A função também é utilizada para gerar a estrutura do model e da view do monitor de borderôs, onde 
   a origem 3 é para o model e a origem 4 é para a view, onde cada uma possui campos e estruturas diferentes.    
    
    @type       Function
    @author     Squad TechFin
    @since      03/06/2026
    @version    1.0
    @param      nOrigem, numeric, opção de origem da estrutura a ser gerada, onde 1 é para o browse, 2 para a view, 3 para o model e 4 para a view
    @return     aRetFields array, Array com a estrutura dos campos para a origem selecionada
    @return     oRetFields object, Objeto com a estrutura dos campos para a origem selecionada, utilizado para o model e view
/*/
Function monitorborderoGetstruct(nOrigem as Numeric) as array
    Local aRetFields := {}  as Array
    Local aFieldsSEA := StrTokArr2("EA_FILIAL;EA_NUMBOR;EA_DATABOR;EA_CART;EA_PORTADO;EA_AGEDEP;EA_NUMCON;EA_MODELO;EA_TIPOPAG",";") as array
    Local oRetFields        as Object
    Local nX := 0           as Numeric

    If nOrigem == 1  
        For nX := 1 to Len(aFieldsSEA) 
                aAdd(aRetFields, {;
                    getSX3Cache(aFieldsSEA[nX], "X3_TITULO")                ,; // [n][01] Título da coluna
                    &("{ || " + aFieldsSEA[nX] + " }")                     ,; // [n][02] Code-Block de carga dos dados
                    getSX3Cache(aFieldsSEA[nX], "X3_TIPO")	                ,; // [n][03] Tipo de dados
                    getSX3Cache(aFieldsSEA[nX], "X3_PICTURE")               ,; // [n][04] Máscara
                    Iif(getSX3Cache(aFieldsSEA[nX], "X3_TIPO") == "N",2,1)  ,; // [n][05] Alinhamento (0=Centralizado, 1=Esquerda ou 2=Direita)
                    getSX3Cache(aFieldsSEA[nX], "X3_TAMANHO")               ,; // [n][06] Tamanho
                    getSX3Cache(aFieldsSEA[nX], "X3_DECIMAL")               ,; // [n][07] Decimal
                    .T.                                                     ,; // [n][08] Indica se permite a edição
                    {||.T. }                                                   ,; // [n][09] Code-Block de validação da coluna após a edição
                    .F.                                                     ,; // [n][10] Indica se exibe imagem
                    Nil                                                     ,; // [n][11] Code-Block de execução do duplo clique
                    "__ReadVar"                                             ,; // [n][12] Variável a ser utilizada na edição (ReadVar)
                    {|| AlwaysTrue()}                                       ,; // [n][13] Code-Block de execução do clique no header
                    .F.                                                     ,; // [n][14] Indica se a coluna está deletada
                    .F.                                                     ,; // [n][15] Indica se a coluna será exibida nos detalhes do Browse
                    {}                                                      ,; // [n][16] Opções de carga dos dados (Ex: 1=Sim, 2=Não)
                    aFieldsSEA[nX]})                                           // [n][17] Id da coluna
        Next nX
        aAdd(aRetFields, {;
                    "Total de Titulos"      ,; // [n][01] Título da coluna
                    &("{ ||  EA_COUNTE1  }"),; // [n][02] Code-Block de carga dos dados
                    'N'	                    ,; // [n][03] Tipo de dados
                    "@E 999,999"            ,; // [n][04] Máscara
                    2                       ,; // [n][05] Alinhamento (0=Centralizado, 1=Esquerda ou 2=Direita)
                    7                       ,; // [n][06] Tamanho
                    0                       ,; // [n][07] Decimal
                    .T.                     ,; // [n][08] Indica se permite a edição
                    {||.T. }                ,; // [n][09] Code-Block de validação da coluna após a edição
                    .F.                     ,; // [n][10] Indica se exibe imagem
                    Nil                     ,; // [n][11] Code-Block de execução do duplo clique
                    "__ReadVar"             ,; // [n][12] Variável a ser utilizada na edição (ReadVar)
                    {|| AlwaysTrue()}       ,; // [n][13] Code-Block de execução do clique no header
                    .F.                     ,; // [n][14] Indica se a coluna está deletada
                    .F.                     ,; // [n][15] Indica se a coluna será exibida nos detalhes do Browse
                    {}                      ,; // [n][16] Opções de carga dos dados (Ex: 1=Sim, 2=Não)
                    'EA_COUNTE1'})             // [n][17] Id da coluna
    ElseIf nOrigem == 2
            AAdd(aRetFields, {"EA_OK", "L",1, 0 })
            For nX := 1 to Len(aFieldsSEA)
                AAdd(aRetFields, {aFieldsSEA[nX], getSX3Cache(aFieldsSEA[nX], "X3_TIPO")	, getSX3Cache(aFieldsSEA[nX], "X3_TAMANHO")	, getSX3Cache(aFieldsSEA[nX], "X3_DECIMAL")})
            Next nX
            AAdd(aRetFields, {"EA_COUNTE1", 'N' , 7, 0})
            AAdd(aRetFields, {"EA_STTFIN" , getSX3Cache("EA_STTFIN", "X3_TIPO"), getSX3Cache("EA_STTFIN", "X3_TAMANHO"), getSX3Cache("EA_STTFIN", "X3_DECIMAL")})
    ElseIf nOrigem == 3 
            oRetFields := FWFormModelStruct():New()
            oRetFields:AddTable(__cAliasBor,{" "},"SEAMASTER")
            For nX := 1 to Len(aFieldsSEA)
                oRetFields:AddField( ;                                                  
                                        getSX3Cache(aFieldsSEA[nX], "X3_TITULO") , ; 			// [01] C Titulo do campo
                                        getSX3Cache(aFieldsSEA[nX], "X3_DESCRIC")  , ; 			// [02] C ToolTip do campo
                                        aFieldsSEA[nX] , ;                                      // [03] C identificador (ID) do Field
                                        getSX3Cache(aFieldsSEA[nX], "X3_TIPO") , ;              // [04] C Tipo do campo
                                        getSX3Cache(aFieldsSEA[nX], "X3_TAMANHO")  , ;          // [05] N Tamanho do campo
                                        getSX3Cache(aFieldsSEA[nX], "X3_DECIMAL") , ;           // [06] N Decimal do campo
                                        NIL , ;                                                 // [07] B Code-block de validação do campo
                                        NIL , ;                                                 // [08] B Code-block de validação When do campo
                                        NIL , ;                                                 // [09] A Lista de valores permitido do campo
                                        NIL , ;                                                 // [10] L Indica se o campo tem preenchimento obrigatório
                                        Nil , ;  					                            // [11] B Code-block de inicializacao do campo
                                        NIL , ;                                                 // [12] L Indica se trata de um campo chave
                                        NIL , ;                                                 // [13] L Indica se o campo pode receber valor em uma operação de update.
                                        .T. )                                                   // [14] L Indica se o campo é virtual
            Next nX
            oRetFields:AddField( ;                                                  
                                    "Total de Titulos"  , ; 		 // [01] C Titulo do campo
                                    "Total de Titulos"  , ;   		 // [02] C ToolTip do campo
                                    "EA_COUNTE1"        , ;          // [03] C identificador (ID) do Field
                                    'N'                 , ;          // [04] C Tipo do campo
                                    7                   , ;          // [05] N Tamanho do campo
                                    0                   , ;          // [06] N Decimal do campo
                                    NIL , ;                          // [07] B Code-block de validação do campo
                                    NIL , ;                          // [08] B Code-block de validação When do campo
                                    NIL , ;                          // [09] A Lista de valores permitido do campo
                                    NIL , ;                          // [10] L Indica se o campo tem preenchimento obrigatório
                                    Nil , ;  					     // [11] B Code-block de inicializacao do campo
                                    NIL , ;                          // [12] L Indica se trata de um campo chave
                                    NIL , ;                          // [13] L Indica se o campo pode receber valor em uma operação de update.
                                    .T. )                            // [14] L Indica se o campo é virtual
    ElseIf  nOrigem == 4
            oRetFields := FWFormViewStruct():New()
            For nX := 1 to Len(aFieldsSEA)
                oRetFields:AddField( ;
                                aFieldsSEA[nX]                              , ; // [01] Campo
                                getSX3Cache(aFieldsSEA[nX], "X3_ORDEM")     , ; // [02] Ordem
                                getSX3Cache(aFieldsSEA[nX], "X3_TITULO")    , ; // [03] Titulo
                                getSX3Cache(aFieldsSEA[nX], "X3_DESCRIC")   , ; // [04] Descricao
                                NIL                                         , ; // [05] Help
                                getSX3Cache(aFieldsSEA[nX], "X3_TIPO")      , ; // [06] Tipo do campo   COMBO, Get ou CHECK
                                getSX3Cache(aFieldsSEA[nX], "X3_PICTURE")   , ; // [07] Picture
                                Nil                                         , ; // [08] PictVar
                                getSX3Cache(aFieldsSEA[nX], "X3_F3")        , ; // [09] F3
                                Nil                                         , ; // [10] Editavel
                                NIL                                         , ; // [11] Folder
                                NIL                                         , ; // [12] Group
                                NIL                                         , ; // [13] Lista Combo
                                NIL                                         , ; // [14] Tam Max Combo
                                NIL                                         , ; // [15] Inic. Browse
                                .T.                                           ) // [16] Virtual
            Next nX
            oRetFields:aFields[aScan(oRetFields:aFields,{|x|rTrim(x[1])=="EA_TIPOPAG"})][13]  := monitorborderoArrayCombo("59")
            oRetFields:aFields[aScan(oRetFields:aFields,{|x|rTrim(x[1])=="EA_MODELO"})][13]   := monitorborderoArrayCombo("58")

            oRetFields:AddField( ;
                            "EA_COUNTE1"       , ; // [01] Campo
                            '99'               , ; // [02] Ordem
                            "Total de Titulos" , ; // [03] Titulo
                            "Total de Titulos" , ; // [04] Descricao
                            NIL                , ; // [05] Help
                            'N'                , ; // [06] Tipo do campo   COMBO, Get ou CHECK
                            '@ 999,999'        , ; // [07] Picture
                            Nil                , ; // [08] PictVar
                            ''                 , ; // [09] F3
                            Nil                , ; // [10] Editavel
                            NIL                , ; // [11] Folder
                            NIL                , ; // [12] Group
                            NIL                , ; // [13] Lista Combo
                            NIL                , ; // [14] Tam Max Combo
                            NIL                , ; // [15] Inic. Browse
                            .T.                )   // [16] Virtual

    Endif
Return({aRetFields,oRetFields})

/*/{Protheus.doc} monitorborderoGetValues
   Função para retornar os valores para a visualização do monitor de borderôs, onde será verificado 
   o campo para retornar a informação correta.
    
    @type       Function
    @author     Squad TechFin
    @since      03/06/2026
    @version    1.0
    @param      cCampo, character, campo para verificação do valor a ser retornado para a visualização do monitor de borderôs
    @return     cRetValue, character, valor a ser retornado para a visualização do monitor de borderôs
/*/
Function monitorborderoGetValues(cCampo) as Character

    Local cRetValue     := ""          as Character
    Local cChaveSE2     := ""          as Character
    Local aArea     := GetArea()   as Array
    Local aSaveLine := FWSaveRows() as Array
    If cCampo == "EA_LEG"
        Do Case
            Case SEA->EA_STTFIN $ " #1"// 1 - Pendente de transmissão
                cRetValue := "BR_BRANCO"
            Case SEA->EA_STTFIN == "2" // 2 - Aguardando retorno Conta +TECHFIN
                cRetValue := "BR_VIOLETA"
            Case SEA->EA_STTFIN == "3" // 3 - Pendente de aprovação
                cRetValue := "BR_AMARELO"
            Case SEA->EA_STTFIN == "4" // 4 - Aprovado
                cRetValue := "BR_VERDE"
            Case SEA->EA_STTFIN == "5" // 5 - Rejeitado
                cRetValue := "BR_VERMELHO"
            Case SEA->EA_STTFIN == "6" // 6 - Expirado
                cRetValue := "BR_LARANJA"
            Case SEA->EA_STTFIN == "7" // 7 - Pago
                cRetValue := "BR_VERDE_ESCURO"
            Case SEA->EA_STTFIN == "8" // 8 - Agendamento Cancelado
                cRetValue := "BR_CINZA"
            Case SEA->EA_STTFIN == "0" // 0 - Aprovação Rejeitada
                cRetValue := "BR_MARROM"
            Case SEA->EA_STTFIN == "9" // 9 - Erro
                cRetValue := "BR_PINK"
        EndCase
    ElseIf cCampo == "EA_STADES"
        Do Case
            Case SEA->EA_STTFIN $ " #1"         // 1 - Pendente de transmissão
                cRetValue := STR0006
            Case SEA->EA_STTFIN == "2"         // 2 - Aguardando retorno Conta +TECHFIN
                cRetValue :=  I18N(STR0003,{"Conta +TECHFIN"})
            Case SEA->EA_STTFIN == "3" // 3 - Pendente de aprovação
                cRetValue := STR0002
            Case SEA->EA_STTFIN == "4" // 4 - Aprovado
                cRetValue := STR0005
            Case SEA->EA_STTFIN == "5" // 5 - Rejeitado
                cRetValue := STR0023
            Case SEA->EA_STTFIN == "6" // 6 - Expirado
                cRetValue := STR0024
            Case SEA->EA_STTFIN == "7" // 7 - Pago
                cRetValue := STR0025
            Case SEA->EA_STTFIN == "8" // 8 - Agendamento cancelado
                cRetValue := STR0027
            Case SEA->EA_STTFIN == "0" // 0 - Aprovação rejeitada
                cRetValue := STR0028
            Case SEA->EA_STTFIN == "9" // 9 - Erro
                cRetValue := STR0004
        EndCase

    ElseIf Substr(cCampo, 1, 3) == "E2_"
        SE2->(dbSetOrder(1))
        cChaveSE2 := SEA->EA_FILIAL + ;
                    SEA->EA_PREFIXO + ;
                    SEA->EA_NUM + ;
                    SEA->EA_PARCELA + ;
                    SEA->EA_TIPO + ;
                    SEA->EA_FORNECE + ;
                    SEA->EA_LOJA
        If SE2->(MsSeek(cChaveSE2))
            If getSX3Cache(cCampo, "X3_TIPO") == "D"
                cRetValue := DTOC(&("SE2->" + cCampo))
            ElseIf getSX3Cache(cCampo, "X3_TIPO") == "N"
                cRetValue := Transform(&("SE2->" + cCampo), getSX3Cache(cCampo, "X3_PICTURE"))
            Else
                cRetValue := &("SE2->" + cCampo)
            Endif    
        EndIf
    Endif
    FWRestRows(aSaveLine)
    RestArea(aArea)

Return AllTrim(cRetValue)

/*/{Protheus.doc} monitorborderoDoubleClick
    Função para duplo clique dos registros no oFWBrowse do monitor de borderôs, onde será verificado 
    o campo para executar a ação correta, onde se for o campo de legenda será exibido a legenda do monitor e se 
    for os campos da SEA será exibido a tela de visualização do título vinculado no borderô.

    @type       Static Function
    @author     Squad TechFin
    @since      03/06/2026
    @version    1.0
    @param     oGrid, object, objeto do grid onde foi realizado o duplo clique
    @param     cField, character, campo onde foi realizado o duplo clique
    @param     nLineGrid, numeric, linha do grid onde foi realizado o duplo clique
    @param     nLineModel, numeric, linha do model onde foi realizado o duplo clique    
    @return    Nil
/*/
Static Function monitorborderoDoubleClick(oGrid,cField,nLineGrid,nLineModel)
    Local aArea      := GetArea() as Array 
    Local aLegenda   := {}        as Array
    Local cChaveSE2  := ""        as Character

    If AllTrim(cField) $ "EA_LEG#EA_STADES#"
       Aadd(aLegenda, {"BR_BRANCO"       , STR0006}) //STR0006, "Pendente de transmissão"
       Aadd(aLegenda, {"BR_VIOLETA"      , I18N(STR0003,{"Conta +TECHFIN"})}) // 2 - Aguardando retorno Conta +TECHFIN
       Aadd(aLegenda, {"BR_AMARELO"      , STR0002}) // 3 - Pendente de aprovação
       Aadd(aLegenda, {"BR_VERDE"        , STR0005}) // 4 - Aprovado 
       Aadd(aLegenda, {"BR_VERMELHO"     , STR0023}) // 5 - Rejeitado
       Aadd(aLegenda, {"BR_LARANJA"      , STR0024}) // 6 - Expirado
       Aadd(aLegenda, {"BR_VERDE_ESCURO" , STR0025}) // 7 - Pago
       Aadd(aLegenda, {"BR_CINZA"        , STR0027}) // 8 - Agendamento cancelado
       Aadd(aLegenda, {"BR_MARROM"       , STR0028}) // 0 - Aprovação Rejeitada 
       Aadd(aLegenda, {"BR_PINK"         , STR0004}) // 9 - Erro

       BrwLegenda(I18N(STR0001,{"Conta +TECHFIN"}), STR0026, aLegenda ) 	//Legendas
    Else
        cChaveSE2 := oGrid:GetModel("VIEW_SEA"):getValue('EA_FILIAL',nLineGrid) + ;
                    oGrid:GetModel("VIEW_SEA"):getValue('EA_PREFIXO',nLineGrid) + ;
                    oGrid:GetModel("VIEW_SEA"):getValue('EA_NUM',nLineGrid) + ;
                    oGrid:GetModel("VIEW_SEA"):getValue('EA_PARCELA',nLineGrid) + ;
                    oGrid:GetModel("VIEW_SEA"):getValue('EA_TIPO',nLineGrid) + ;
                    oGrid:GetModel("VIEW_SEA"):getValue('EA_FORNECE',nLineGrid) + ;
                    oGrid:GetModel("VIEW_SEA"):getValue('EA_LOJA',nLineGrid)
        SE2->(dbSetOrder(1))
        If SE2->(MsSeek(cChaveSE2))
            FA050Visua("SE2",SE2->(Recno()),2)
        EndIf
    Endif
    RestArea(aArea)
Return 

/*/{Protheus.doc} monitorborderoArrayCombo
   Função para retornar um array com os valores para combo utilizado na view do monitor de borderôs, 
    onde é passado a chave de busca para retornar os valores corretos do combo.

    @type       Function
    @author     Squad TechFin
    @since      03/06/2026
    @version    1.0
    @param      cChave, character, chave de busca para retornar os valores corretos do combo     
    @return     ArrayRet, array, array com os valores para combo utilizado na view do monitor de borderôs
/*/
Function monitorborderoArrayCombo(cChave) as Array
	local nC as Numeric
	local aGetArray:= FWGetSX5(cChave)   as Array
	local ArrayRet := {} as Array

	for nC := 1 to len( aGetArray)
        aadd(ArrayRet, AllTrim(aGetArray[nC][3])+'-'+AllTrim(aGetArray[nC][4]))
	next
return ArrayRet
