#INCLUDE "PROTHEUS.CH"
#INCLUDE "BACKOFFICE.TECHFIN.CONTADIGITAL.CONCILIATIONRULES.CH"

Namespace totvs.protheus.backoffice.techfin.contadigital
Using Namespace totvs.protheus.backoffice.techfin.util

STATIC __lPosGrv  := NIL
STATIC __lPosCan  := NIL
//-------------------------------------------------------------------------------------------
/*/{Protheus.doc} conciliationRules
    Verificação e atulização das configurações Financeiras no Conciliador Backoffice

    @type  Function
    @author Andr� Schwartz
    @since 13/03/2026
    @version 12.1.2510
/*/
//-------------------------------------------------------------------------------------------
Function conciliationRules()
    If QLB->(FieldPos("QLB_VERSAO")) > 0 .and. QLB->(FieldPos("QLB_LEGEND")) > 0 
        updateQLB()
    EndIf
Return

Static Function updateQLB()

    Local cCodCfg   := ""                 as Character
    Local cVersion  := ""                 as Character
    Local jsonLoop  := JsonObject():New() as Json
    Local jsonSave  := JsonObject():New() as Json
    Local lFound    := .T.                as Logical
    Local nI        := 0                  as Numeric

    //Pós Gravação
    If __lPosGrv == NIL
        __lPosGrv := QLB->(FieldPos("QLB_POSGRV")) > 0
    Endif
    //Pós Cancelamento
    If __lPosCan == NIL
        __lPosCan := QLB->(FieldPos("QLB_POSCAN")) > 0
    Endif

    jsonLoop:FromJson(getJsonCfgInfo())  
    
    for nI := 1 to Len(jsonLoop["items"])

        cCodCfg := jsonLoop["items"][nI]["codcfg"]
        cVersion := getJsonVersion(cCodCfg)
        
        //Se a função checkUpdate retornar falso, não há necessidade de atualização
        If (checkUpdate(cCodCfg, cVersion, @lFound) )

            jsonSave["codcfg"]  := cCodCfg
            jsonSave["descfg"]  := jsonLoop["items"][nI]["descfg"]
            jsonSave["tabori"]  := jsonLoop["items"][nI]["tabori"]
            jsonSave["descor"]  := jsonLoop["items"][nI]["descor"]
            jsonSave["tabdes"]  := jsonLoop["items"][nI]["tabdes"]
            jsonSave["descde"]  := jsonLoop["items"][nI]["descde"]
            jsonSave["fields"]  := getJsonFields(cCodCfg) 
            jsonSave["filter"]  := getJsonFilters(cCodCfg)
            jsonSave["cidori"]  := getCIDFields(cCodCfg, /*lIDOrigem*/ .T.)
            jsonSave["ciddes"]  := getCIDFields(cCodCfg, /*lIDOrigem*/ .F.)
            jsonSave["regmat"]  := getJsonRegMatch(cCodCfg)
            jsonSave["total"]   := getJsonTotal(cCodCfg)
            jsonSave["version"] := cVersion

            If __lPosGrv
                jsonSave["posgrv"] := getPosGrv(cCodCfg, .T.)
            Endif

            If __lPosCan
                jsonSave["poscan"] := getPosGrv(cCodCfg, .F.)
            Endif

            //Gravar os dados na QLB
            saveJsonOnQLB(jsonSave, lFound)

        EndIf

        //Limpar o Json ao final do loop para receber os dados do próximo item
        jsonSave := JsonObject():New()

    next nI
Return

//-----------------------------------------------------------------------------------
/*/{Protheus.doc} getJsonCfgInfo
    Retorna as informações basicas da configuração

    @type  Function
    @author Andr� Schwartz
    @since 13/03/2026
    @version 12.1.2510

    @return cCfgInfo, Character, informações basicas da configuração

/*/
//-----------------------------------------------------------------------------------
Static Function getJsonCfgInfo() as Character
    Local cCfgInfo := "" as Character

    cCfgInfo := '{"items":['
    cCfgInfo +=     '{'
    cCfgInfo +=         '"codcfg": "0025",'
    cCfgInfo +=         '"descfg": "'+ STR0003 +'",' //"DDA Conta +Techfin x Contas a Pagar"
    cCfgInfo +=         '"tabori": "SE2",'
    cCfgInfo +=         '"descor": "'+ STR0004 +'",' //"Contas a Pagar"
    cCfgInfo +=         '"tabdes": "FIG",'
    cCfgInfo +=         '"descde": "'+ STR0005 +'"' //"DDA Conta +Techfin"
    cCfgInfo +=     '}'
    cCfgInfo += ']}'
    
Return cCfgInfo

//-----------------------------------------------------------------------------------
/*/{Protheus.doc} getJsonFields
    Retorna Json com os campos das tabelas de origem e destino utilizados
    na regra de Conciliação.

    @type  Function
    @author Andr� Schwartz
    @since 13/03/2026
    @version 12.1.2510

    @param  cCodCfg, Character, Código da configuração
    @return jFields , Json    , Campos da configuração

/*/
//-----------------------------------------------------------------------------------
Static Function getJsonFields(cCodCfg as Character) as Json

    Local cFields := "" as Character
    Local jFields := JsonObject():New() as Json

    If  cCodCfg $ "0025"
        cFields :=  '{'
        cFields +=      '"data_ori": ['
        cFields +=          '"E2_FILIAL",'
        cFields +=          '"E2_FORNECE",'
        cFields +=          '"E2_LOJA",'
        cFields +=          '"E2_NOMFOR",'
        cFields +=          '"E2_NUM",'
        cFields +=          '"E2_TIPO",'
        cFields +=          '"E2_VENCTO",'
        cFields +=          '"E2_VALOR",'
        cFields +=          '"E2_VALLIQ"'
        cFields +=      '],'
        cFields +=      '"data_des": ['
        cFields +=          '"FIG_FILIAL",'
        cFields +=          '"FIG_FORNEC",'
        cFields +=          '"FIG_LOJA",'
        cFields +=          '"FIG_NOMFOR",'
        cFields +=          '"FIG_TITULO",'
        cFields +=          '"FIG_TIPO",'
        cFields +=          '"FIG_VENCTO",'
        cFields +=          '"FIG_VALOR"'
        cFields +=      ']'
        cFields +=  '}' 
    EndIf


    jFields:FromJson(cFields)

Return jFields

//-----------------------------------------------------------------------------------
/*/{Protheus.doc} getJsonFilters
    Retorna Json contendo os filtros da regra
    
    @type  Function
    @author Andr� Schwartz
    @since 13/03/2026
    @version 12.1.2510
    @param  cCodCfg  ,Character, Código da configuração
    @return jFilters ,Json     , Campos da configuração

/*/
//-----------------------------------------------------------------------------------
Static Function getJsonFilters(cCodCfg as Character) as Json

    Local jFilters := JsonObject():New()
    Local jField   := JsonObject():New()

    If cCodCfg $ "0025"
        jFilters["tabori"] := {}
        
        jField["order"]     := "01"
        jField["field"]     := "E2_FILIAL"
        jField["operation"] := ">="
        aAdd(jFilters["tabori"], jField) 

        jField              := JsonObject():New()
        jField["order"]     := "02"
        jField["field"]     := "E2_FILIAL"
        jField["operation"] := "<="
        aAdd(jFilters["tabori"], jField) 

        jField              := JsonObject():New()
        jField["order"]     := "03"
        jField["field"]     := "E2_FORNECE"
        jField["operation"] := ">="
        aAdd(jFilters["tabori"], jField) 
        
        jField              := JsonObject():New()
        jField["order"]     := "04"
        jField["field"]     := "E2_FORNECE"
        jField["operation"] := "<="
        aAdd(jFilters["tabori"], jField) 

        jField              := JsonObject():New()
        jField["order"]     := "05"
        jField["field"]     := "E2_LOJA"
        jField["operation"] := ">="
        aAdd(jFilters["tabori"], jField) 

        jField              := JsonObject():New()
        jField["order"]     := "06"
        jField["field"]     := "E2_LOJA"
        jField["operation"] := "<="
        aAdd(jFilters["tabori"], jField) 

        jField              := JsonObject():New()
        jField["order"]     := "07"
        jField["field"]     := "E2_VENCTO"
        jField["operation"] := ">="
        aAdd(jFilters["tabori"], jField) 

        jField              := JsonObject():New()
        jField["order"]     := "08"
        jField["field"]     := "E2_VENCTO"
        jField["operation"] := "<="
        aAdd(jFilters["tabori"], jField) 

        jFilters["tabdes"] := {}

        jField              := JsonObject():New()
        jField["order"]     := "09"
        jField["field"]     := "FIG_FILIAL"
        jField["operation"] := ">="
        aAdd(jFilters["tabdes"], jField) 

        jField              := JsonObject():New()
        jField["order"]     := "10"
        jField["field"]     := "FIG_FILIAL"
        jField["operation"] := "<="
        aAdd(jFilters["tabdes"], jField) 

        jField              := JsonObject():New()
        jField["order"]     := "11"
        jField["field"]     := "FIG_FORNEC"
        jField["operation"] := ">="
        aAdd(jFilters["tabdes"], jField) 
        
        jField              := JsonObject():New()
        jField["order"]     := "12"
        jField["field"]     := "FIG_FORNEC"
        jField["operation"] := "<="
        aAdd(jFilters["tabdes"], jField) 

        jField              := JsonObject():New()
        jField["order"]     := "13"
        jField["field"]     := "FIG_LOJA"
        jField["operation"] := ">="
        aAdd(jFilters["tabdes"], jField) 

        jField              := JsonObject():New()
        jField["order"]     := "14"
        jField["field"]     := "FIG_LOJA"
        jField["operation"] := "<="
        aAdd(jFilters["tabdes"], jField) 

        jField              := JsonObject():New()
        jField["order"]     := "15"
        jField["field"]     := "FIG_VENCTO"
        jField["operation"] := ">="
        aAdd(jFilters["tabdes"], jField) 

        jField              := JsonObject():New()
        jField["order"]     := "16"
        jField["field"]     := "FIG_VENCTO"
        jField["operation"] := "<="
        aAdd(jFilters["tabdes"], jField) 
    EndIf

Return jFilters

