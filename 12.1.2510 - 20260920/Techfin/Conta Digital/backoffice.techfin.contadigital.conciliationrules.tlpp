/*/{Protheus.doc} getCIDFields
    Retorna os campos _MSUIDT de cada regra

    @type  Function
    @author Andr� Schwartz
    @since 13/03/2026
    @version 12.1.2510

    @param cCodCfg  ,Character, Código da configuração
    @param lIDOrigem,Logical  , Identifica se está buscando o ID 
                                da tabela Origem ou Destino
    
    @return cIdField ,Character, Campos de _MSUIDT da configuração
/*/
//-----------------------------------------------------------------------------------
Static Function getCIDFields(cCodCfg as Character, lIDOrigem as Logical) as Character

    Local cIdField := "" as Character

    If cCodCfg $ "0025"
        If lIDOrigem
            cIdField := "E2_MSUIDT"
        Else
            cIdField := "FIG_MSUIDT"
        EndIf
    EndIf

Return cIdField

//-----------------------------------------------------------------------------------
/*/{Protheus.doc} getJsonRegMatch
    Retorna Json contendo as regras de match da regra
    
    @type  Function
    @author Andr� Schwartz
    @since 13/03/2026
    @version 12.1.2510

    @param  cCodCfg   ,Character, Código da configuração
    @return jRegMatch ,Json     , Regras de Match

/*/
//-----------------------------------------------------------------------------------
Static Function getJsonRegMatch(cCodCfg as Character) as Json

    Local jRegMatch := JsonObject():New()
    Local cRegMatch := "" as Character
    
    If cCodCfg == "0025"
        cRegMatch :=    '{'
        cRegMatch +=        '"rules": ['
        cRegMatch +=           '{'
        cRegMatch +=                '"idrule": "001",'
        cRegMatch +=                '"name": "'+STR0010+'",' //"Confian�a muito alta"
        cRegMatch +=                '"idlegend": "A",'
        cRegMatch +=                '"rule": {'
        cRegMatch +=                    '"ori_fields": "E2_MSUIDT,E2_FILIAL,E2_FORNECE,E2_LOJA,E2_VENCTO,E2_VALOR, E2_NUM",'
        cRegMatch +=                    '"des_fields": "FIG_MSUIDT,FIG_FILIAL,FIG_FORNEC,FIG_LOJA,FIG_VENCTO,FIG_VALOR,FIG_TITULO",'
        cRegMatch +=                    '"condition": "E2_FILIAL = FIG_FILIAL AND E2_FORNECE = FIG_FORNEC AND E2_LOJA = FIG_LOJA AND E2_VENCTO = FIG_VENCTO AND E2_VALOR = FIG_VALOR AND TRIM(FIG_TITULO) = TRIM(E2_NUM) AND '
        cRegMatch +=                    ' SEQMATCH = '+"' '"+'",'
        cRegMatch +=                    '"max_match": 1'
        cRegMatch +=                '}'
        cRegMatch +=            '},'
        cRegMatch +=            '{'
        cRegMatch +=                '"idrule": "002",'
        cRegMatch +=                '"name": "'+STR0011+'",' //"Confian�a alta"
        cRegMatch +=                '"idlegend": "A",'
        cRegMatch +=                '"rule": {'
        cRegMatch +=                    '"ori_fields": "E2_MSUIDT,E2_FILIAL,E2_FORNECE,E2_LOJA,E2_VENCTO,E2_VALOR, E2_NUM",'
        cRegMatch +=                    '"des_fields": "FIG_MSUIDT,FIG_FILIAL,FIG_FORNEC,FIG_LOJA,FIG_VENCTO,FIG_VALOR,FIG_TITULO",'
        cRegMatch +=                    '"condition": "E2_FILIAL = FIG_FILIAL AND E2_FORNECE = FIG_FORNEC AND E2_LOJA = FIG_LOJA AND E2_VENCTO = FIG_VENCTO AND TRIM(FIG_TITULO) = TRIM(E2_NUM) AND E2_VALOR BETWEEN FIG_VALOR - (FIG_VALOR * 0.001) AND FIG_VALOR + (FIG_VALOR * 0.001) AND'
        cRegMatch +=                                  ' SEQMATCH = '+"' '"+'",'
        cRegMatch +=                    '"max_match": 1'
        cRegMatch +=               '}'
        cRegMatch +=            '},'
        cRegMatch +=            '{'
        cRegMatch +=                '"idrule": "003",'
        cRegMatch +=                '"name": "'+STR0012+'",' //"Confian�a m�dia"
        cRegMatch +=                '"idlegend": "AD",'
        cRegMatch +=                '"rule": {'
        cRegMatch +=                    '"ori_fields": "E2_MSUIDT,E2_FILIAL,E2_FORNECE,E2_LOJA,E2_VENCTO,E2_VALOR",'
        cRegMatch +=                    '"des_fields": "FIG_MSUIDT,FIG_FILIAL,FIG_FORNEC,FIG_LOJA,FIG_VENCTO,FIG_VALOR",'
        cRegMatch +=                    '"condition": "E2_FILIAL = FIG_FILIAL AND E2_FORNECE = FIG_FORNEC AND E2_LOJA = FIG_LOJA AND E2_VENCTO = FIG_VENCTO AND E2_VALOR = FIG_VALOR AND '
        cRegMatch +=                                  ' SEQMATCH = '+"' '"+'",'
        cRegMatch +=                    '"max_match": 1'
        cRegMatch +=               '}'
        cRegMatch +=            '},'
        cRegMatch +=            '{'
        cRegMatch +=                '"idrule": "004",'
        cRegMatch +=                '"name": "'+STR0013+'",' //"Confian�a baixa"
        cRegMatch +=                '"idlegend": "AD",'
        cRegMatch +=                '"rule": {'
        cRegMatch +=                    '"ori_fields": "E2_MSUIDT,E2_FILIAL,E2_FORNECE,E2_LOJA,E2_VENCTO,E2_VALOR",'
        cRegMatch +=                    '"des_fields": "FIG_MSUIDT,FIG_FILIAL,FIG_FORNEC,FIG_LOJA,FIG_VENCTO,FIG_VALOR",'
        cRegMatch +=                    '"condition": "E2_FILIAL = FIG_FILIAL AND E2_FORNECE = FIG_FORNEC AND E2_LOJA = FIG_LOJA AND E2_VENCTO = FIG_VENCTO AND E2_VALOR BETWEEN FIG_VALOR - (FIG_VALOR * 0.001) AND FIG_VALOR + (FIG_VALOR * 0.001) AND'
        cRegMatch +=                                  ' SEQMATCH = '+"' '"+'",'
        cRegMatch +=                    '"max_match": 1'
        cRegMatch +=               '}'
        cRegMatch +=            '}'
        cRegMatch +=         ']}'

    EndIf

    jRegMatch:FromJson(cRegMatch)

Return jRegMatch

//----------------------------------------------------------------------------------
/*/{Protheus.doc} getJsonTotal
    Montagem do Json referente as regras de totalização
    @type  Function
    @author Andr� Schwartz
    @since 13/03/2026
    @version 12.1.2510
    @param param_name, param_type, param_descr
    @return return_var, return_type, return_description
    @example
    (examples)
    @see (links_or_references)
/*/
//----------------------------------------------------------------------------------
Static Function getJsonTotal(cCodCfg as Character) as Json

    Local cTotal := "" as Character
    Local jTotal := JsonObject():New() as Json

    If cCodCfg $ "0025"
        cTotal := '{'
        cTotal +=    '"totalori": ['
        cTotal +=       '{'
        cTotal +=            '"label": "'+ STR0006 +'",' //"Valor Total Contas a Pagar"
    	cTotal +=            '"total":"E2_VALOR",'
        cTotal +=            '"valid":true,'
        cTotal +=            '"fields": "E2_VALOR"'
        cTotal +=        '}'
        cTotal +=    '],'
		cTotal +=    '"totaldes": ['
		cTotal +=        '{'
		cTotal +=           '"label": "'+ STR0007 +'",' //"Valor Total DDA Conta +Techfin"
		cTotal +=           '"total": "FIG_VALOR",'
        cTotal +=           '"valid":true,'
        cTotal +=           '"fields": "FIG_VALOR"'
        cTotal +=         '}'
        cTotal +=    ']'
        cTotal += '}'
    EndIf

    jTotal:FromJson(cTotal)

Return jTotal

//---------------------------------------------------------------------------
/*/{Protheus.doc} saveJsonOnQLB
    Gravação das regras na tabela QLB

    @type  Function
    @author Andr� Schwartz
    @since 13/03/2026
    @version 12.1.2510
    
    @param jsonSave    , Json   , Json contendo as regras a serem gravadas
    @param lJaExisteQLB, Logical, Indica se está incluindo ou alterando uma
                                    regra de conciliação
/*/
//---------------------------------------------------------------------------
Static Function saveJsonOnQLB(jsonSave as Json, lJaExisteQLB as Logical)
    Local jvalidFields  as Json

    jvalidFields := validFields(jsonSave["fields"])

    QLB->(dbSetOrder(1))
    If jvalidFields["update"]
        jvalidFields:DelName("update")

        RecLock("QLB", !lJaExisteQLB)
            QLB->QLB_FILIAL := xFilial("QLB")
            QLB->QLB_CODCFG := jsonSave["codcfg"]
            QLB->QLB_DESCFG := jsonSave["descfg"]
            QLB->QLB_TABORI := jsonSave["tabori"]
            QLB->QLB_TABDES := jsonSave["tabdes"]
            QLB->QLB_FIELDS := jvalidFields:toJson()
            QLB->QLB_FILTER := jsonSave["filter"]:toJson()
            QLB->QLB_CIDORI := jsonSave["cidori"]
            QLB->QLB_CIDDES := jsonSave["ciddes"]
            QLB->QLB_DESCOR := jsonSave["descor"]
            QLB->QLB_DESCDE := jsonSave["descde"]
            QLB->QLB_REGMAT := jsonSave["regmat"]:toJson()
            QLB->QLB_TOTAL  := jsonSave["total"]:toJson()
            QLB->QLB_VERSAO := jsonSave["version"]

            If __lPosGrv
                QLB->QLB_POSGRV := jsonSave["posgrv"]
            Endif

            If __lPosCan
                QLB->QLB_POSCAN := jsonSave["poscan"]
            Endif

        QLB->(MsUnlock())
    Endif

Return

/*{Protheus.doc} validFields
    Validacao da existência de campos para adicionar na QLB

    @author: Andr� Schwartz
    @since 13/03/2026
    @version 1.0
*/
Function validFields(jFields) as Json
    Local nI := 0 as Numeric
    Local nx := 0 as Numeric
    Local jReturn := JsonObject():new() as Json
    Local aFields := {} as Array
    Local aReturn := {} as Array

    If jFields <> Nil .And. ValType(jFields) == "J"
        aFields := jFields:GetNames()
        If aFields <> Nil .And. ValType(aFields) == "A"
            jReturn["update"] := .T.

            For nI := 1 To Len(aFields)			
                If jFields[aFields[nI]] <> Nil				
                    aReturn := {}
                    For nX := 1 To Len(jFields[aFields[nI]])
                        If ValType(jFields[aFields[nI]][nX]) == "C" .And. ;
                            ((Len(FWSX3Util():GetFieldStruct(jFields[aFields[nI]][nX])) > 0))
                            aAdd(aReturn, jFields[aFields[nI]][nX])
                        Else
                           jReturn["update"] := .F. 
                        Endif
                    Next nX
                    jReturn[aFields[nI]] := aClone(aReturn)
                EndIf
            Next nI
        EndIf	
    EndIf

    FwFreeArray(aFields)
    FwFreeArray(aReturn)
Return jReturn

//---------------------------------------------------------------------------
/*{Protheus.doc} getJsonVersion
Retorna a versão das configurações de conciliação

@author: Andr� Schwartz
@since 13/03/2026
@version 1.0
*/
//---------------------------------------------------------------------------
Static Function getJsonVersion(cCodCfg as Character) as Character
    
    Local cVersion := "" as Character
    
    If cCodCfg == "0025"
        cVersion := "20250704"
    EndIf

Return cVersion

/*{Protheus.doc} checkUpdate
    Verifica se há necessidade de atualizar a configuração
    @type  Static
    @author Andr� Schwartz
    @since 13/03/2026
    @version 12.1.2510
    @param 
        cCodCfg, Character, Codigo de configuração
        cVersion, Character, Codigo de versão
    @return 
        lRet, Logico, Se deve ou não atualizar
*/
Static Function checkUpdate(cCodCfg as Character, cVersion as Character, lFound as Logical) as Logical

    Local lRet      := .T. as Logical

    QLB->(dbSetOrder(1))
    lFound := (QLB->(MsSeek(xFilial("QLB")+cCodCfg)))

    //Se encontrar, confiro se a versão em QLB é menor que a versão do Json no fonte.
    If lFound
        // Se sim, devo atualizar a QLB
        If Empty(QLB->QLB_VERSAO) .Or. (QLB->QLB_VERSAO < cVersion)
            lRet := .T.
        Else
        //Se não, não devo atualizar
            lRet := .F.
        EndIf
    Else
        //Se não encontrar, deve atualizar (Incluir configuração)
        lRet := .T.
    EndIf

Return lRet

/*/{Protheus.doc} getPosGrv
    Retorna as rotinas de PosGrv e PosCan de cada regra

    @type  Function
    @author Andr� Schwartz
    @since 13/03/2026
    @version 12.1.2510

    @param cCodCfg ,Character, Código da configuração
    @param Logical ,Logical  , Identifica se está a rotina de PosGRV (.T.)
                                ou PosCan (.F.)
    
    @return cIdFunc ,Character, Função as ser executada no PosGrv ou PosCan
*/
Static Function getPosGrv(cCodCfg as Character, __lPosGrv as Logical) as Character

    Local cIdFunc := "" as Character

    If cCodCfg $ "0025"
        If __lPosGrv
            cIdFunc := "totvs.protheus.backoffice.techfin.contadigital.posGrvFIG"
        Else    
            cIdFunc := "totvs.protheus.backoffice.techfin.contadigital.canGrvFIG"
        EndIf
    EndIf
Return cIdFunc

/*/{Protheus.posGrvFIG
    Retorna as rotinas de PosGrv e PosCan de cada regra

    @type  Function
    @author Andr� Schwartz
    @since 13/03/2026
    @version 12.1.2510

    @param cCodCfg ,Character, C�digo da Configura��o
    @param cTagOri ,Character, Tabela de Teporaria
    @return .T.
*/
Function posGrvFIG(cCodCfg as Character, cTable as Character)
Local cTempQuery
Local aRegistro := {}                   as Array
Local nReg      := 0                    as Numeric
Local nI        := 0                    as Numeric
Local cAlias    := ""                   as Character
Local oStatment                         as object 
Local cTypeDB   := ""                   as character

cTypeDB := TcGetDB()

cTempQuery := "SELECT "
cTempQuery +=     "FIG.R_E_C_N_O_ AS FIGRECNO, "
cTempQuery +=     "TMP.RECONCILED, "
cTempQuery +=     "QLD.QLD_IDITEM, "
cTempQuery +=     "QLD.QLD_UNION "
cTempQuery += "FROM " + cTable + " TMP "
cTempQuery += "JOIN " + RetSQLName("QLD") + " QLD "
cTempQuery +=     "ON "
cTempQuery +=        "QLD.QLD_CODCON = TMP.CODCON "
cTempQuery +=        "AND QLD.QLD_SEQMAT = TMP.SEQMATCH "
cTempQuery +=        "AND QLD.QLD_CODCFG = '0025' "
cTempQuery +=        "AND QLD.QLD_UNION = 'SE2' "
cTempQuery += "JOIN " + RetSQLName("FIG") + " FIG "
cTempQuery +=     "ON FIG.D_E_L_E_T_ = ' ' "
cTempQuery +=     "AND FIG.FIG_CONCIL = '2' "

If cTypeDB == "POSTGRES" 
    cTempQuery += "AND CAST(FIG.FIG_MSUIDT AS VARCHAR(36)) = TRIM(TMP.FIG_MSUIDT) "
Else 
    cTempQuery += "AND FIG.FIG_MSUIDT = TRIM(TMP.FIG_MSUIDT) "
EndIf

cTempQuery += "WHERE TMP.IDDELETE = ' ' "

oStatment  := FwExecStatement():New(cTempQuery)

oStatment:setFields({'FIGRECNO', 'RECONCILED', 'QLD.QLD_IDITEM'}) 

cAlias    := oStatment:OpenAlias()
aRegistro := oStatment:getResultArray(cAlias, .F.)
nReg      := Len(aRegistro) 

Begin Transaction
    For nI := 1 to nReg
        FIG->(dbGoTo(aRegistro[nI][1]))
        RecLock("FIG", .F.)
        If AllTrim(aRegistro[nI][2]) == "S" .And. setPositionByUUID("SE2", AllTrim(aRegistro[nI][3]), "_MSUIDT")
            FIG->FIG_DTCONC := Date()
            FIG->FIG_CONCIL := "1"
            FIG->FIG_USCONC := __cUserId
            FIG->FIG_DDASE2 := SE2->(E2_FILIAL) +"|"+ SE2->(E2_PREFIXO) +"|"+ SE2->(E2_NUM) + "|" + SE2->(E2_PARCELA) + "|" + SE2->(E2_TIPO) + "|" + SE2->(E2_FORNECE) + "|" + SE2->(E2_LOJA) +"|"
        EndIf
        FIG->(MsUnlock())
    Next
End Transaction

FwFreeArray(aRegistro)
FwFreeObj(oStatment)

Return .T.

/*/{Protheus.doc} canGrvFIG
    Retorna as rotinas de PosGrv e PosCan de cada regra

    @type  Function
    @author Andr� Schwartz
    @since 13/03/2026
    @version 12.1.2510

    @param cCodCon ,Character, C�digo da Concilia��o
    @param cCodCfg ,Character, C�digo da Configura��o
    @param cRegMat ,Character, Identificador da regra de Match
    @param cSeqMat ,Character, Identificador da sequ�ncia de Match
    @param cTagOri ,Character, Tabela de Origem
    @param cUuid   ,Character, Identificador �nico do registro
    @param cError  ,Character, Mensagem de erro para log
    @param aIDs    ,Array    , Array de IDs para identificar os registros com match (opcional)
    @return .T.
*/
Function canGrvFIG(cCodCon as Character, cCodCfg as Character, cRegMatch as Character, cSeqMatch as Character, cTabOri as Character, cUuid as Character, cError as Character, aIDs as Array)
Local cTempQuery
Local aRegistro := {}                   as Array
Local nReg      := 0                    as Numeric
Local nI        := 0                    as Numeric
local nParam    := 1                    as numeric
Local cAlias    := ""                   as Character
Local oStatment                         as object 

Default aIDs := {}

If cCodCfg $ "0025"
    cTempQuery := "SELECT FIG.R_E_C_N_O_  "
    cTempQuery += "FROM "+RetSQLName("QLD")+" QLD "
    cTempQuery += "JOIN "+RetSQLName("FIG")+" FIG ON TRIM(QLD.QLD_IDITEM) = CAST(FIG.FIG_MSUIDT AS VARCHAR(36))"
    cTempQuery += "WHERE "
    cTempQuery += "QLD.QLD_CODCFG = ? "
    cTempQuery += "AND QLD.QLD_UNION = ? "
    cTempQuery += "AND QLD.QLD_CODCON = ? "
    
    If cRegMatch <> "" .and. cSeqMatch <> ""
        cTempQuery += "AND QLD.QLD_REGMAT = ? "
        cTempQuery += "AND QLD.QLD_SEQMAT = ? "
    EndIf
    
    If Len(aIDs) > 0
        cTempQuery += "AND QLD.QLD_IDITEM IN (?) "
    Endif

    cTempQuery += "AND QLD.D_E_L_E_T_ = ? "
    cTempQuery += "AND FIG.D_E_L_E_T_ = ? "

    oStatment  := FwExecStatement():New(cTempQuery)

    oStatment:setFields({'R_E_C_N_O_'})
    oStatment:SetString(nParam++, cCodCfg) //QLB.QLB_CODCFG
    oStatment:SetString(nParam++, "FIG")   //QLD.QLD_UNION
    oStatment:SetString(nParam++, cCodCon) //QLD.QLD_CODCON

    If cRegMatch <> "" .and. cSeqMatch <> ""
        oStatment:SetString(nParam++, cRegMatch) //QLD.QLD_REGMAT
        oStatment:SetString(nParam++, cSeqMatch) //QLD.QLD_SEQMAT
    EndIf

    If Len(aIDs) > 0
        oStatment:SetIn(nParam++, aIDs) //QLD.QLD_IDITEM
    Endif

    oStatment:SetString(nParam++, "") //QLD.D_E_L_E_T_
    oStatment:SetString(nParam++, "") //FIG.D_E_L_E_T_
    
    cAlias    := oStatment:OpenAlias()
    aRegistro := oStatment:getResultArray(cAlias, .F.)
    nReg      := Len(aRegistro) 

    Begin Transaction
        For nI := 1 to nReg
            FIG->(dbGoTo(aRegistro[nI][1]))
            RecLock("FIG", .F.)
                FIG->FIG_DTCONC := CTOD("  /  /    ")
                FIG->FIG_CONCIL := "2"
                FIG->FIG_USCONC := ""
                FIG->FIG_DDASE2 := ""
            FIG->(MsUnlock())
        Next
    End Transaction
EndIf

FwFreeArray(aRegistro)
FwFreeObj(oStatment)
Return .T.
