#include "tlpp-core.th"
#include "TBICONN.ch"
#include "backoffice.techfin.contadigital.contadigitalbankaccountcreaterequestv1.ch"

/*/{Protheus.doc} ContaDigitalBankAccountCreateRequestV1MessageReader
	Classe de Integração Novo Antecipa
	Cadastra conta digital no cadastro de bancos.
	@type class
	@author Squad TechFin
	@since 10/12/2025
/*/
class ContaDigitalBankAccountCreateRequestV1MessageReader
	data jMessage  as json
	data cMock     as character
	data lMock     as logical

	public method new() constructor
	public method read() as logical
	public method mock()
end class

/*/{Protheus.doc} ContaDigitalBankAccountCreateRequestV1MessageReader::New
	Método construtor da classe
	@type method
	@author squad TechFin
	@since 10/12/2025
/*/
method New() class ContaDigitalBankAccountCreateRequestV1MessageReader
	::jMessage  := JsonObject():new()
	::cMock     := ""
	::lMock     := .F.
return Self

/*/{Protheus.doc} ContaDigitalBankAccountCreateRequestV1MessageReader::mock
	Método para mockar a mensagem recebida para testes
	@type method
	@author Squad TechFin
	@since 10/12/2025
	@param cData, character, dados da mensagem a ser mockada
/*/
method mock(cData as character) class ContaDigitalBankAccountCreateRequestV1MessageReader
	::cMock := cData
	::lMock := .T.
return

/*/{Protheus.doc} ContaDigitalBankAccountCreateRequestV1MessageReader::read
	esponsável pela leitura e processamento da mensagem.
	@type method
	@author Squad TechFin
	@since 10/12/2025
	@param oLinkMessage, object, Instância de FwTotvsLinkMesage da mensagem
	@return logical, sucesso ou falha. Determina se deve ou não retirar a mensagem da fila.
/*/
method read(oLinkMessage as object) as Logical class ContaDigitalBankAccountCreateRequestV1MessageReader 
	local lSuccess      := .F.        as logical
	local cPayload      := ""         as character
	local aSM0          := {}         as array
	local cBranchCNPJ   := ""         as character
	local nPosFil       := 0          as numeric
	local cCompany      := ""         as character
	local cBranch       := ""         as character
	local aError        := {}         as array
	local oSmartUtil    := nil        as object
	local cType         := "ContaDigitalBankAccountCreateResponseV1" as character

	cPayload   :=  if(::lMock, ::cMock,  oLinkMessage:RawMessage())

	if ::jMessage:FromJSON(cPayload) == NIL

		cBranchCNPJ  := ::jMessage["data"]["companyCnpj"]
		aSM0         := FwLoadSM0()
		if (nPosFil := AScan(aSM0, { |x| x[18] $ cBranchCNPJ})) > 0
			cCompany := aSM0[nPosFil][1]
			cBranch  := aSM0[nPosFil][2]
			lSuccess := StartJob("addAccount", GetEnvServer(), .T., cCompany, cBranch, cPayload)
		else
			oSmartUtil := totvs.protheus.backoffice.techfin.util.SmartlinkUtil():New()
			oSmartUtil:sendProcessingResult("Received", cType, cPayload,,,.T.)
			oSmartUtil:addLogMSG("error", "TechFin branch", STR0001 + ": " + cBranchCNPJ) // Filial não localizada para o CNPJ
			oSmartUtil:sendProcessingResult("Error", cType, cPayload, "TechFin branch", STR0001 + ": " + cBranchCNPJ,.T.) // Filial não localizada para o CNPJ
			oSmartUtil:logResponse(cPayload, ::jMessage["data"]["idempotencyKey"])
			FwFreeObj(oSmartUtil)
		endIf
	endIf
	FwFreeObj(::jMessage)
	FwFreeArray(aSM0)
	FwFreeArray(aError)

Return lSuccess // .T. apaga a mensagem da fila do smartlink

/*/{Protheus.doc} ContaDigitalBankAccountCreateRequestV1MessageReader::addAccount
	esponsável pela criação do registro em SA6.
	@type method
	@author Squad TechFin
	@since 10/12/2025
	@param 
	@return logical, sucesso ou falha. Determina se deve ou não retirar a mensagem da fila.
/*/
Function addAccount(cCompany as character, cBranch as character, cPayload as character) as logical
	local aBankAuto     := {}                  as Array
	local nIndex        := 1                   as Numeric
	local aError        := {}                  as Array
	local cErrorContent := ""                  as Character
	local jData         := JsonObject():New()  as json
	local nOpc          := 3                   as Numeric //Inclusão
	local cChave        := ""                  as character
	local oSmartUtil    := totvs.protheus.backoffice.techfin.util.SmartlinkUtil():new() as Object
	local cType         := "ContaDigitalBankAccountCreateResponseV1"                    as character
	
	Private lMsErroAuto    := .F. as Logical
	Private lAutoErrNoFile := .T. as Logical
	Private lMsHelpAuto    := .T. as Logical

	jData:FromJSON(cPayload)
	RPCSetEnv(cCompany,cBranch)
	
	checkBcoOfi() 

	oSmartUtil:sendProcessingResult("Received", cType, cPayload,,,.T.)
	cChave := FWxFilial("SA6")
	cChave += PadR(jData["data"]["bankCodeCompe"], TamSX3('A6_COD')[1])
	cChave += PadR(jData["data"]["branch"]       , TamSX3('A6_AGENCIA')[1])
	cChave += PadR(jData["data"]["accountNumber"], TamSX3('A6_NUMCON')[1]) 
	SA6->(DbSetOrder(1))
	If SA6->(MsSeek((cChave)))
		nOpc := 4 //Alteração
	EndIf

	AAdd(aBankAuto, {'A6_FILIAL' , FWxFilial("SA6")                                                        , Nil})
	AAdd(aBankAuto, {'A6_COD'    , PadR(jData["data"]["bankCodeCompe"]          , TamSX3('A6_COD')[1])     , Nil})
	AAdd(aBankAuto, {'A6_AGENCIA', PadR(jData["data"]["branch"]                 , TamSX3('A6_AGENCIA')[1]) , Nil})
	AAdd(aBankAuto, {'A6_NUMCON' , PadR(jData["data"]["accountNumber"]          , TamSX3('A6_NUMCON')[1])  , Nil})
	AAdd(aBankAuto, {'A6_DVCTA'  , PadR(jData["data"]["accountNumberCheckDigit"], TamSX3('A6_DVCTA')[1])   , Nil})
	AAdd(aBankAuto, {'A6_NOME'   , PadR(jData["data"]["accountName"]            , TamSX3('A6_NOME')[1])    , Nil})
	AAdd(aBankAuto, {'A6_ISPB'   , PadR(jData["data"]["bankCodeIspb"]           , TamSX3('A6_ISPB')[1])    , Nil})
	AAdd(aBankAuto, {'A6_BCOOFI' , PadR(jData["data"]["bankCodeCompe"]          , TamSX3('A6_BCOOFI')[1])  , Nil})
	If SA6->(FieldPos("A6_TFCNT")) > 0
		AAdd(aBankAuto, {'A6_TFCNT'  , "1", Nil}) 
		AAdd(aBankAuto, {'A6_IDTECHF', PadR(jData["data"]["id"], TamSX3('A6_IDTECHF')[1]) , Nil})
	EndIf

	aBankAuto := FwVetByDic(aBankAuto, "SA6")
	MSExecAuto({|a,b| MATA070(a, b)}, aBankAuto, nOpc) 
	If(lMsErroAuto)
		aError := GetAutoGRLog()
		For nIndex := 1 To Len(aError)
			cErrorContent += aError[nIndex] + Chr(13) + Chr(10)
		Next nIndex
		oSmartUtil:addLogMSG("error", "ExecAuto MATA070 Error", cErrorContent)
		oSmartUtil:sendProcessingResult("Error", cType, cPayload, "ExecAuto MATA070 Error", cErrorContent,.T.)
	Else
		oSmartUtil:sendProcessingResult("Created", cType, cPayload,,,.T.)
	EndIf
	oSmartUtil:logResponse(cPayload, jData["data"]["idempotencyKey"])
	FwFreeObj(oSmartUtil)
	FwFreeArray(aBankAuto)
	FwFreeArray(aError)
	FwFreeObj(jData)
	RpcClearEnv()
return .T.

/*/{Protheus.doc} Function checkBcoOfi() 

	Responsável pela criação do registro da Celcoin na SX5.
	@type Function
	@author Squad TechFin 
	@since 09/04/2026
	@param 
	@return 
/*/
Function checkBcoOfi() 
	Local aBcoOfi := FWGetSX5("0N") as Array
	Local cTexto  := "Celcoin Instituição de Pagamento S.A." as Character

	If AScan(aBcoOfi, { |x| x[3] $ "509" }) == 0
		FwPutSX5("", "0N", "509", cTexto, cTexto, cTexto, cTexto)
	EndIf
	FwFreeArray(aBcoOfi)
Return
