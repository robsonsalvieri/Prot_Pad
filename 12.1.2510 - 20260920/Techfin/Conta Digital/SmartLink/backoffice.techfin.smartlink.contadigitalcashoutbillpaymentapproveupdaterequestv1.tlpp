#include "tlpp-core.th"
#include "TBICONN.ch"

/*/{Protheus.doc} ContaDigitalCashoutBillPaymentApproveUpdateRequestV1MessageReader
	Classe de Integração Conta Digital
	Atualização do status de aprovação do pagamento.
	@type class
	@author Squad TechFin
	@since 02/06/2026
/*/
class ContaDigitalCashoutBillPaymentApproveUpdateRequestV1MessageReader
	data jMessage  as json
	data cMock     as character
	data lMock     as logical

	public method new() constructor
	public method read(oLinkMessage as object) as logical
	public method mock(cData as character)
end class

/*/{Protheus.doc} ContaDigitalCashoutBillPaymentApproveUpdateRequestV1 MessageReader::New
	Método construtor da classe
	@type method
	@author squad TechFin
	@since 02/06/2026
/*/
method New() class ContaDigitalCashoutBillPaymentApproveUpdateRequestV1MessageReader
	::jMessage  := JsonObject():new()
	::cMock     := ""
	::lMock     := .F.
return Self

/*/{Protheus.doc} ContaDigitalCashoutBillPaymentApproveUpdateRequestV1MessageReader::mock
	Método para mockar a mensagem recebida para testes
	@type method
	@author Squad TechFin
	@since 02/06/2026
	@param cData, character, dados da mensagem a ser mockada
/*/
method mock(cData as character) class ContaDigitalCashoutBillPaymentApproveUpdateRequestV1MessageReader
	::cMock := cData
	::lMock := .T.
return

/*/{Protheus.doc} ContaDigitalCashoutBillPaymentApproveUpdateRequestV1 MessageReader::read
	Responsável pela leitura e processamento da mensagem.
	@type method
	@author Squad TechFin
	@since 02/06/2026
	@param oLinkMessage, object, Instância de FwTotvsLinkMesage da mensagem
	@return logical, sucesso ou falha. Determina se deve ou não retirar a mensagem da fila.
/*/
method read(oLinkMessage as object) as Logical class ContaDigitalCashoutBillPaymentApproveUpdateRequestV1MessageReader 
	local lSuccess      := .F.        as logical
	local cPayload      := ""         as character
	local aSM0          := {}         as array
    local aRequestId    := {}         as array
	local cCompany      := ""         as character
	local cBranch       := ""         as character
	local oSmartUtil    := nil        as object
	local cType         := "ContaDigitalCashoutBillPaymentApproveUpdateResponseV1" as character

	cPayload   :=  if(::lMock, ::cMock,  oLinkMessage:RawMessage())

	If ::jMessage:FromJSON(cPayload) == NIL

        aRequestId := StrToArray(::jMessage["data"]["erpId"],"|")
        aSM0 := FWLoadSM0()
        If Len(aRequestId) == 3 .And. AScan(aSM0, {|x| AllTrim(x[1]) == AllTrim(aRequestId[1]) .And. AllTrim(x[2]) == AllTrim(aRequestId[2]) }) > 0
            cCompany := aRequestId[1]
            cBranch  := aRequestId[2]
  			lSuccess := StartJob("cashOutBillApprove", GetEnvServer(), .T., cCompany, cBranch, cPayload)
		Else
			oSmartUtil := totvs.protheus.backoffice.techfin.util.SmartlinkUtil():New()
			oSmartUtil:sendProcessingResult("Received", cType, cPayload,,,.T.)
			oSmartUtil:addLogMSG("error", "TechFin branch", "Filial não localizada") 
			oSmartUtil:sendProcessingResult("Error", cType, cPayload, "TechFin branch", "Filial não localizada",.T.) 
			oSmartUtil:logResponse(cPayload, ::jMessage["data"]["id"])
			FwFreeObj(oSmartUtil)
		EndIf
	EndIf
	FwFreeArray(aSM0)
	FwFreeArray(aRequestId)

Return lSuccess // .T. apaga a mensagem da fila do smartlink

/*/{Protheus.doc} ContaDigitalCashoutBillPaymentApproveUpdateRequestV1MessageReader::cashOutBillApprove
	Responsável pela atualização do status e resposta da requisição.
	@type Function
	@author Squad TechFin
	@since 02/06/2026
	@param cCompany, character, código da empresa
	@param cBranch, character, código da filial
	@param cPayload, character, payload da mensagem
	@return logical, sucesso ou falha. Determina se deve ou não retirar a mensagem da fila.
/*/
Function cashOutBillApprove(cCompany as character, cBranch as character, cPayload as character) as logical
    local aRequestId    := {}                  as Array
	local cErrorCode    := ""                  as Character
    local cErrorContent := ""                  as Character
	local cStatSEA      := ""                  as Character
    local cIdSEA        := ""                  as character
    local jData         := JsonObject():New()  as json
	local oSmartUtil    := totvs.protheus.backoffice.techfin.util.SmartlinkUtil():new() as Object
	local cType         := "ContaDigitalCashoutBillPaymentApproveUpdateResponseV1"      as character

	jData:FromJSON(cPayload)
	RPCSetEnv(cCompany,cBranch)
	
	oSmartUtil:sendProcessingResult("Received", cType, cPayload,,,.T.)

	aRequestId := StrToArray(jData["data"]["erpId"],"|")
	cIdSEA := aRequestId[3]
	If totvs.protheus.backoffice.techfin.util.setPositionByUUID("SEA", cIdSEA)
		cStatSEA := Upper(Alltrim(jData["data"]["approvalStatus"]))
		Begin Transaction
			If RecLock("SEA",.F.)
				If cStatSEA == "PENDING"
					SEA->EA_STTFIN := "3"
				ElseIf cStatSEA == "APPROVED"
					SEA->EA_STTFIN := "4"
				ElseIf cStatSEA == "REJECTED"
					SEA->EA_STTFIN := "5"
				ElseIf cStatSEA == "EXPIRED"
					SEA->EA_STTFIN := "6"
				EndIf
				SEA->(MsUnLock())
			EndIf
		End Transaction
	Else
		cErrorCode    := "Bill Payment Error"
		cErrorContent := "Título não encontrado" 
	EndIf

    If cErrorContent != ""
        oSmartUtil:addLogMSG("error", cErrorCode, cErrorContent)
        oSmartUtil:sendProcessingResult("Error", cType, cPayload, cErrorCode, cErrorContent,.T.)
    Else
        oSmartUtil:sendProcessingResult("Created", cType, cPayload,,,.T.)
    EndIf
	oSmartUtil:logResponse(cPayload, jData["data"]["id"])

	FwFreeObj(oSmartUtil)
	FwFreeObj(jData)
	FwFreeArray(aRequestId)
	RpcClearEnv()
return .T.
