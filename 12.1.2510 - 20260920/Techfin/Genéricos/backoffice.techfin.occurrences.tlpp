#include "tlpp-core.th"
#include "totvs.ch"
#include "fwmvcdef.ch"

NAMESPACE totvs.protheus.backoffice.techfin.util

Static __cCodDuplicataEscritural := "5" as character
Static __cCodGarantiaDeDuplicata := "6" as character

/*/{Protheus.doc} TechfinOccurrences
    Controle de ocorrências sobre eventos

    @type       Class
    @author     Totvs
    @since      27/03/2026
    @version    P12.1.2510  
/*/
Class TechfinOccurrences

	data jData              as json
	data cProdTF            as character
    data cAliasTF           as character
	data cLog               as character
    data cLogBrowse         as character
	data cIdDoc             as character
	data cIdMov             as character
    data lUpdBrowse         as logical
	data aOccurrencesUpdate as array

	public method new()  constructor
	public method setProduct(cProdTF as character)
	public method setLog(cLog as character)
	public method setIdDoc(cIdDoc as character)
	public method setIdMov(cIdMov as character)
	public method Register(cCodOccurrence as character)
	public method makeBrowseUpdated(cLogBrowse as character)
    private method LoadOccurreces()
	public method setOccurrencesUpdate(jData as json)
	public method getOccurrencesUpdate(cField as character) as array
    public method getOccurrencesTF(cTypeTF as character) as character
	public method getStatusResponseCode(cIdDoc as character, cCodOccurrence as character, aResponseCode as array) as logical

end class


/*/{Protheus.doc} TechfinOccurrences::New
    Método construtor da classe.
    Inicializa todos os atributos da instância com valores vazios.

    @type   method
    @author Squad TechFin
    @since  27/03/2026
    @return object, Retorna a instância da classe.
/*/
method new() class TechfinOccurrences
	::cProdTF            := ""
    ::cAliasTF           := ""
	::cLog               := ""
    ::cLogBrowse         := ""
	::cIdDoc             := ""
	::cIdMov             := ""
    ::lUpdBrowse         := .F.
	::jData              := JsonObject():new()
	::aOccurrencesUpdate := {}
return Self

/*/{Protheus.doc} TechfinOccurrences::setProduct
    Define o produto TechFin e carrega as ocorrências correspondentes.

    @type   method
    @author Squad TechFin
    @since  27/03/2026
    @param  cProdTF, character, Código do produto TechFin.
/*/
method setProduct( cProdTF as character ) class TechfinOccurrences
	::cProdTF := cProdTF
	::LoadOccurreces()
return

/*/{Protheus.doc} TechfinOccurrences::setLog
    Define um log detalhado da ocorrência.

    @type   method
    @author Squad TechFin
    @since  27/03/2026
    @param  cLog, character, Texto do log a ser gravado.
/*/
method setLog( cLog as character ) class TechfinOccurrences
	::cLog := cLog
return

/*/{Protheus.doc} TechfinOccurrences::makeBrowseUpdated
    Define ou limpa o Log para o campo 'Motivo' do browse principal e seta para marcar que o browse deve ser atualizado.
    @type method
    @author Squad TechFin
    @since  27/03/2026
    @param cLogBrowse, character, mensagem a ser exibida (vazia para limpar)
/*/
method makeBrowseUpdated( cLogBrowse as character ) class TechfinOccurrences
    ::lUpdBrowse := .T.
    ::cLogBrowse := cLogBrowse
return

/*/{Protheus.doc} TechfinOccurrences::setIdDoc
    Define o identificador do documento (título).

    @type   method
    @author Squad TechFin
    @since  27/03/2026
    @param  cIdDoc, character, Identificador do documento.
/*/
method setIdDoc( cIdDoc as character ) class TechfinOccurrences
	::cIdDoc := cIdDoc
return

/*/{Protheus.doc} TechfinOccurrences::setIdMov
    Define o identificador do movimento/operação do ERP para rastreamento.

    @type   method
    @author Squad TechFin
    @since  27/03/2026
    @param  cIdMov, character, Identificador do movimento/operação do ERP.
/*/
method setIdMov( cIdMov as character ) class TechfinOccurrences
	::cIdMov := cIdMov
return

/*/{Protheus.doc} TechfinOccurrences::LoadOccurreces
    Carrega a lista de ocorrências do produto TechFin configurado.
    Suporta produtos como Duplicata Escritural e Garantia de Duplicata.

    @type   method
    @author Squad TechFin
    @since  25/06/2026
/*/
method LoadOccurreces() class TechfinOccurrences
	Local cContent:="" as character

	Do Case
		//Duplicata Escritural
		Case ::cProdTF == __cCodDuplicataEscritural
            ::cAliasTF := 'ARP'
            BeginContent Var cContent    
            {
                "001": {"description": "Título enviado para escrituração",       "origin": "1"},
                "002": {"description": "Escriturado com sucesso",                "origin": "2"},
                "003": {"description": "Falha na escrituração do título",        "origin": "2"},
                "004": {"description": "Solicitado bloqueio na escrituradora",   "origin": "1"},
                "005": {"description": "Solicitado desbloqueio na escrituradora","origin": "1"},                       
                "007": {"description": "Bloqueio realizado",                     "origin": "2"},
                "008": {"description": "Bloqueio não realizado",                 "origin": "2"},
                "009": {"description": "Desbloqueio realizado",                  "origin": "2"},
                "010": {"description": "Desbloqueio não realizado",              "origin": "2"},
                "011": {"description": "Alteração - Solicitada alteração de dados do título",           "origin": "1"},
                "012": {"description": "Alteração - Falha no envio da solicitação de alteração",        "origin": "1"},
                "013": {"description": "Alteração de dados processada.",                                "origin": "2"},
                "014": {"description": "Alteração de dados não realizada.",                             "origin": "2"},
                "015": {"description": "Cancelamento da escrituração - Solicitação enviada.",           "origin": "1"},
                "016": {"description": "Cancelamento da escrituração - Falha no envio da solicitação.", "origin": "1"},
                "017": {"description": "Cancelamento da escrituração efetuado.",                        "origin": "2"},
                "018": {"description": "Cancelamento da escrituração não efetuado.",                    "origin": "2"},
                "019": {"description": "Registro de baixa/atualização de saldo - Solicitação enviada.", "origin": "1"},
                "020": {"description": "Registro de baixa/atualização de saldo efetuada.",              "origin": "2"},
                "021": {"description": "Registro de baixa/atualização de saldo não efetuada.",          "origin": "2"},
                "022": {"description": "Alteração dos dados de pagamentos efetuada.",                   "origin": "2"},
                "023": {"description": "Alteração dos dados de pagamentos não efetuada.",               "origin": "2"}
            }
            EndContent

		//Garantias
        Case ::cProdTF == __cCodGarantiaDeDuplicata
            ::cAliasTF := 'ART' 
            //-- 'occurrenceTF' não pode repetir na estrutura do jSon, ja os campos de aFields podem variar de acordo com a ocorrência
            
            BeginContent Var cContent    
            {
                "001": {"occurrenceTF":""  ,"description": "Titulo enviado para Garantia."                                        , "origin": "1", "responseCode":["002","003"], "type": 0, "aFields":[]},
                "002": {"occurrenceTF":""  ,"description": "Titulo aceito como Garantia."                                         , "origin": "2", "responseCode":[]           , "type": 0, "aFields":[]},
                "003": {"occurrenceTF":""  ,"description": "Titulo Rejeitado."                                                    , "origin": "2", "responseCode":[]           , "type": 0, "aFields":[]},
                "004": {"occurrenceTF":""  ,"description": "Titulo Cancelado para Garantia"                                       , "origin": "1", "responseCode":[]           , "type": 0, "aFields":[]},
                "005": {"occurrenceTF":""  ,"description": "Alteração - Solicitação de alteração de dados do título."             , "origin": "1", "responseCode":["006","007"], "type": 0, "aFields":[]},
                "006": {"occurrenceTF":""  ,"description": "Alteração de dados processada."                                       , "origin": "2", "responseCode":[]           , "type": 0, "aFields":[]},
                "007": {"occurrenceTF":""  ,"description": "Alteração de dados não realizada."                                    , "origin": "2", "responseCode":[]           , "type": 0, "aFields":[]},
                "008": {"occurrenceTF":""  ,"description": "Registro de baixa/atualização de saldo efetuada."                     , "origin": "2", "responseCode":[]           , "type": 0, "aFields":[]},
                "009": {"occurrenceTF":""  ,"description": "Falha no registro de baixa/atualização de saldo."                     , "origin": "2", "responseCode":[]           , "type": 0, "aFields":[]},
                "010": {"occurrenceTF":""  ,"description": "Cancelamento da Garantia - Solicitação enviada."                      , "origin": "1", "responseCode":["011","012"], "type": 0, "aFields":[]},
                "011": {"occurrenceTF":""  ,"description": "Cancelamento da Garantia não autorizado."                             , "origin": "2", "responseCode":[]           , "type": 0, "aFields":[]},
                "012": {"occurrenceTF":""  ,"description": "Cancelamento da Garantia autorizado."                                 , "origin": "2", "responseCode":[]           , "type": 0, "aFields":[]},
                "A04": {"occurrenceTF":"04","description": "Alteração - Solicitação de alteração de abatimento do título."        , "origin": "1", "responseCode":["R04"]      , "type": 4, "aFields":["ART_VLABAT"]},
                "R04": {"occurrenceTF":"04","description": "Alteração de abatimento do título processada."                        , "origin": "2", "responseCode":[]           , "type": 4, "aFields":["ART_VLABAT"]},
                "A06": {"occurrenceTF":"06","description": "Alteração - Solicitação de alteração de vencimento do título."        , "origin": "1", "responseCode":["R06"]      , "type": 4, "aFields":["ART_VENNOV"]},
                "R06": {"occurrenceTF":"06","description": "Alteração de vencimento do título processada."                        , "origin": "2", "responseCode":[]           , "type": 4, "aFields":["ART_VENNOV"]},
                "A09": {"occurrenceTF":"09","description": "Alteração - Solicitação de alteração de protesto do título."          , "origin": "1", "responseCode":["R09"]      , "type": 4, "aFields":["ART_PROTES"]},
                "R09": {"occurrenceTF":"09","description": "Alteração de protesto do título processada."                          , "origin": "2", "responseCode":[]           , "type": 4, "aFields":["ART_PROTES"]},
                "A19": {"occurrenceTF":"19","description": "Alteração - Solicitação de alteração de dias para protesto do título.", "origin": "1", "responseCode":["R19"]      , "type": 4, "aFields":["ART_DIASPR"]},
                "R19": {"occurrenceTF":"19","description": "Alteração de dias para protesto do título processada."                , "origin": "2", "responseCode":[]           , "type": 4, "aFields":["ART_DIASPR"]},                
                "A31": {"occurrenceTF":"31","description": "Alteração cod. 31 - Solicitação de alteração de dados do título."     , "origin": "1", "responseCode":["R31"]      , "type": 4, "aFields":["ART_INSTRU","ART_MULTA","ART_VLDIA","ART_DESCON","ART_DTDESC","ART_ENVAV","ART_ENVDV"]},
                "R31": {"occurrenceTF":"31","description": "Alteração cod. 31 processada."                                        , "origin": "2", "responseCode":[]           , "type": 4, "aFields":["ART_INSTRU","ART_MULTA","ART_VLDIA","ART_DESCON","ART_DTDESC","ART_ENVAV","ART_ENVDV"]}
            }
            EndContent
    EndCase

	::jData:fromJson(cContent)
	::setOccurrencesUpdate(::jData)
return

/*/{Protheus.doc} TechfinOccurrences::setOccurrencesUpdate
    Popula a lista interna de ocorrências do tipo alteração (origin = "1" e type = MODEL_OPERATION_UPDATE)
    a partir do JSON de ocorrências carregado.

    @type   method
    @author Squad TechFin
    @since  27/03/2026
    @param  jData, json, JSON contendo todas as ocorrências do produto.
/*/
method setOccurrencesUpdate(jData as json) class TechfinOccurrences
	local aOccurrencesUpdate := {} as array
	local aNameProperties    := {} as array
	local nX                 := 0  as numeric
	local nTotal             := 0  as numeric

	aNameProperties := jData:getNames()
	nTotal          := Len(aNameProperties)
	For nX := 1 To nTotal
		If jData[aNameProperties[nX]]["origin"] == "1" .And. jData[aNameProperties[nX]]["type"] == MODEL_OPERATION_UPDATE
			aAdd(aOccurrencesUpdate, {aNameProperties[nX], jData[aNameProperties[nX]]["responseCode"], jData[aNameProperties[nX]]["aFields"], jData[aNameProperties[nX]]["occurrenceTF"]})
		EndIf
	Next nX

	::aOccurrencesUpdate := aClone(aOccurrencesUpdate)
Return

/*/{Protheus.doc} TechfinOccurrences::getOccurrencesUpdate
    Retorna a lista de ocorrências de atualização filtrada pelo campo informado.
    Caso nenhuma ocorrência possua o campo, retorna a lista completa.

    @type   method
    @author Squad TechFin
    @since  27/03/2026
    @param  cField, character, Nome do campo a ser localizado nas ocorrências de atualização.
    @return array, Lista de ocorrências de atualização. Cada elemento contém:
                   [1] Código da ocorrência, [2] Códigos de resposta, [3] Campos, [4] Código TechFin.
/*/
method getOccurrencesUpdate(cField as character) as array class TechfinOccurrences
	local nX                 := 0                            as numeric
	local nTotal             := Len(::aOccurrencesUpdate)    as numeric
	local aOccurrencesReturn := aClone(::aOccurrencesUpdate) as array

	For nX := 1 To nTotal
		If aScan(::aOccurrencesUpdate[nX][3], {|x| x == cField}) > 0
			aOccurrencesReturn := {}
			aAdd(aOccurrencesReturn, ::aOccurrencesUpdate[nX])
			Exit
		EndIf
	Next nX
return aOccurrencesReturn


/*/{Protheus.doc} TechfinOccurrences::getOccurrencesTF
    Retorna o responseCode para determinado tipo de ocorrência 
    @type   method
    @author Squad TechFin
    @since  27/03/2026
    @param  cTypeTF, character, codigo do tipoOcorrencia 
    @return cResponseCode, character, cdigo de ocorrencia de retorno                    
/*/
method getOccurrencesTF(cTypeTF as character) as character class TechfinOccurrences
	local nX                 := 0   as numeric
	local nTotal             := 0   as numeric
	local aNameProperties    := {}  as array
    local cResponseCode      := ''	as character

	aNameProperties := ::jData:getNames()
	nTotal          := Len(aNameProperties)
	For nX := 1 To nTotal
		If ::jData[aNameProperties[nX]]["origin"] == "1" .And. ::jData[aNameProperties[nX]]["occurrenceTF"] == cTypeTF
			cResponseCode := ::jData[aNameProperties[nX]]["responseCode"][1]
			Exit
		EndIf
	Next nX
return cResponseCode

/*/{Protheus.doc} TechfinOccurrences::getStatusResponseCode
    Verifica na tabela ARQ se já existe uma ocorrência de resposta (responseCode) posterior à
    ocorrência de solicitação (cCodOccurrence), determinando se a operação ainda está pendente.

    @type   method
    @author Squad TechFin
    @since  27/03/2026
    @param  cIdDoc,         character, Identificador do documento (ARQ_IDDOC).
    @param  cCodOccurrence, character, Código da ocorrência de solicitação a verificar.
    @param  aResponseCode,  array,     Lista de códigos de ocorrência que representam respostas válidas.
    @return logical, .T. se a operação está pendente (sem resposta) ou foi respondida com sucesso;
                     .F. se a própria ocorrência de solicitação já foi reenviada sem resposta.
/*/
method getStatusResponseCode(cIdDoc as character, cCodOccurrence as character, aResponseCode as array) as logical class TechfinOccurrences
	local lReturn := .T. as logical
	local nX      := 0   as numeric
	local nTotal  := 0   as numeric
	local cQuery  := ""  as character
	local aBind   := {}  as array
	local nBind   := 1   as numeric
	local cAlias  := ""  as character
	local oExec   := Nil as object

	nTotal := Len(aResponseCode)
	aAdd(aBind, cCodOccurrence)
	For nX := 1 To nTotal
		aAdd(aBind, aResponseCode[nX])
	Next

	cQuery := " SELECT ARQ_COD,ARQ_DATA,ARQ_HORA "
	cQuery += " FROM " + RetSqlName("ARQ")
	cQuery += " WHERE ARQ_FILIAL = ? "
	cQuery += " And ARQ_IDDOC = ? "
	cQuery += " And ARQ_PRODTF = ? "
	cQuery += " AND ARQ_COD IN (?) "
	cQuery += " And D_E_L_E_T_= ? "
	cQuery += " ORDER BY ARQ_DATA, ARQ_HORA, ARQ_COD "
    cQuery := ChangeQuery(cQuery)
	oExec := FwExecStatement():New(cQuery)

	oExec:SetString(nBind++, FwxFilial("ARQ")) //ARQ_FILIAL
	oExec:SetString(nBind++, cIdDoc) //ARQ_IDDOC
	oExec:SetString(nBind++, ::cProdTF) //ARQ_PRODTF
	oExec:SetIn(nBind++, aBind) //ARQ_COD
	oExec:SetString(nBind++, " ") //D_E_L_E_T_
	cAlias := oExec:OpenAlias()

	While !(cAlias)->(Eof())
		if (cAlias)->ARQ_COD == cCodOccurrence
			lReturn := .F.
		ElseIf aScan(aResponseCode, {|x| x == (cAlias)->ARQ_COD}) > 0
			lReturn := .T.
		EndIf
		(cAlias)->(DbSkip())
	EndDo

    (cAlias)->(DbCloseArea())
    oExec:Destroy()
Return lReturn

/*/{Protheus.doc} TechfinOccurrences::Register
    Grava uma ocorrência na tabela ARQ para o documento e produto TechFin configurados na instância.
    A origem e a descrição são obtidas automaticamente a partir do JSON de ocorrências carregado;
    caso o código não seja encontrado, utiliza origem "1" (ERP) e descrição genérica.

    @type   method
    @author Squad TechFin
    @since  27/03/2026
    @param  cCodOccurrence, character, Código da ocorrência a ser gravada.
/*/
method register( cCodOccurrence as character) class TechfinOccurrences

	local aArea         := {} as array
	local cOrigin       := "" as character
	local cDescription  := "" as character
    local cField        := "" as character
    local nPosField     := 0  as numeric

	aArea           := FwGetArea()
	cOrigin         := "1"//ERP
	cDescription    := "Ocorrência "+cCodOccurrence+" não identificada."

	//-------------------------------------------------------------------------
	//Aguardando include par usar dessa forma... (não remover)
	//cDescription    := i18n(STR0001, {cCodOccurrence})//Ocorrência XXX não identificada.

	If ::jData:hasProperty(cCodOccurrence)
		cOrigin      := ::jData[cCodOccurrence]["origin"]
		cDescription := ::jData[cCodOccurrence]["description"]
	EndIF

	dbSelectArea('ARQ')
	RecLock('ARQ', .T.)
        ARQ_FILIAL := FwxFilial("ARQ")
        ARQ_IDDOC  := ::cIdDoc
        ARQ_PRODTF := ::cProdTF
        ARQ_ORIGEM := cOrigin
        ARQ_DATA   := Date()
        ARQ_HORA   := Time()
        ARQ_COD    := cCodOccurrence
        ARQ_DESC   := cDescription
        ARQ_LOG    := ::cLog
        ARQ_IDMOV  := ::cIdMov
	ARQ->(msUnLock())

    If ::lUpdBrowse
        cField    := ::cAliasTF+"_MOTIVO"
        nPosField := (::cAliasTF)->(FieldPos(cField))

        dbSelectArea(::cAliasTF)
        dbSetOrder(1)
        If (::cAliasTF)->(msSeek(FwxFilial(::cAliasTF ) + ::cIdDoc))
            RecLock(::cAliasTF, .F.)                
                (::cAliasTF)->(FieldPut(nPosField, ::cLogBrowse))
            msUnLock()
        EndIF
    EndIf    

	FwRestArea(aArea)
	FwFreeArray(aArea)
return
