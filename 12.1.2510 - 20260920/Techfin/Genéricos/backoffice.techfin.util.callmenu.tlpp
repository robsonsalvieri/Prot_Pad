#include "tlpp-core.th"
#include "totvs.ch"
#include "backoffice.techfin.util.callmenu.ch"
#include "fwlibversion.ch"

NAMESPACE totvs.protheus.backoffice.techfin.util.callmenu

/*/{Protheus.doc} totvs.protheus.backoffice.techfin.util.callmenu
    Prepara SubRotinas para chamada dos produtos TechFin para varias rotinas 
    @type       Function
    @author     Squad TechFin
    @since      26/03/2026
    @version    P12.1.2510
/*/

/*/{Protheus.doc} menudefFina740
    Prepara aRotina para chamada da função FINA740 
    @type       Function
    @author     Squad TechFin
    @since      26/03/2026
    @version    P12.1.2510
	@return     aReturnARotina, array, Menu de produtos TechFin disponíveis na FINA740
/*/
Function menudefFina740() as Array
	local aRotAnt         := {}    as Array
	local aRotDupE        := {}    as Array

	local aReturnARotina  := {}    as Array
	local lRequirements	  := (FwLibVersion() >= "20240520" .And. cPaisLoc == "BRA") as Logical

	If lRequirements
		//-------------------------------------------------------
		//-- Antecipa
		Aadd( aRotAnt, {STR0001, "totvs.protheus.backoffice.techfin.util.callmenu.callantecipa(1)", 0, 2}) //Antecipar Títulos
		Aadd( aRotAnt, {STR0002, "totvs.protheus.backoffice.techfin.util.callmenu.callantecipa(3)", 0, 2}) //Aprovar Solicitações
		Aadd( aRotAnt, {STR0003, "totvs.protheus.backoffice.techfin.util.callmenu.callantecipa(2)", 0, 2}) //Consultar solicitações
		Aadd( aRotAnt, {STR0004, "totvs.protheus.backoffice.techfin.util.callmenu.callantecipa(5)", 0, 2}) //Pós faturamento
		Aadd( aRotAnt, {STR0005, "totvs.protheus.backoffice.techfin.util.callmenu.callantecipa(4)", 0, 2}) //Gerenciar Limites
		Aadd( aRotAnt, {STR0006, "totvs.protheus.backoffice.techfin.util.callmenu.callantecipa(6)", 0, 2}) //"Regras de elegibilidade"
		aadd(aReturnARotina,{'&Antecipa'			,aRotAnt ,0, 2}) //Antecipa

		//-------------------------------------------------------
		//-- Duplicata Escritural
		Aadd( aRotDupE, {STR0007, "totvs.protheus.backoffice.techfin.util.callmenu.callDuplicataescritural(1)", 0, 2}) //Configurações do Serviço
		Aadd( aRotDupE, {STR0008, "totvs.protheus.backoffice.techfin.util.callmenu.callDuplicataescritural(2)", 0, 2}) //Gestão de Duplicata
		aadd(aReturnARotina,{'&Duplicata Escritural', aRotDupE, 0, 2}) //'Duplicata Escritural'

		//-------------------------------------------------------
		//-- Garantias
		aadd(aReturnARotina,{'&Gestão de Garantias', "totvs.protheus.backoffice.techfin.util.callmenu.callgestaodegarantias" , 0, 2}) ////Gestão de Garantias
	Endif
Return aReturnARotina

/*/{Protheus.doc} menudefFina750
    Prepara aRotina para chamada da função FINA750 
    @type       Function
    @author     Squad TechFin
    @since      26/03/2026
    @version    P12.1.2510
	@return     aReturnARotina, array, Menu de produtos TechFin disponíveis na FINA750
/*/
Function menudefFina750() as Array
	local aRotMPrz		  := {}    as Array
	local aRotTFCD        := {}    as Array
	local aReturnARotina  := {}    as Array
	local lRequirements	  := (FwLibVersion() >= "20240520" .And. cPaisLoc == "BRA") as Logical

	If lRequirements
		//-------------------------------------------------------
		//-- "+Prazo &Techfin
		Aadd( aRotMPrz, {STR0013, "totvs.protheus.backoffice.techfin.util.callmenu.callmaisprazo(1)", 0, 2}) //Prorrogar boletos
		Aadd( aRotMPrz, {STR0014, "totvs.protheus.backoffice.techfin.util.callmenu.callmaisprazo(2)", 0, 2}) //Consultar solicitações
		Aadd( aRotMPrz, {STR0015, "totvs.protheus.backoffice.techfin.util.callmenu.callmaisprazo(3)", 0, 2}) //Aprovar solicitações
		Aadd( aRotMPrz, {STR0016, "totvs.protheus.backoffice.techfin.util.callmenu.callmaisprazo(4)", 0, 2}) //Regras de Elegibilidade
		Aadd( aRotMPrz, {STR0017, "totvs.protheus.backoffice.techfin.util.callmenu.callmaisprazo(5)", 0, 2}) //Gestão de fornecedores
		Aadd(aReturnARotina,{"+&Prazo Techfin"		,aRotMPrz ,0, 2}) //"+Prazo Techfin"

		//-------------------------------------------------------
		//-- Totvs Conta Digital
		Aadd( aRotTFCD, {I18N("Conta+ Techfin",{"Conta+ Techfin"}), "totvs.protheus.backoffice.techfin.util.callmenu.callcontadigital(1)", 0, 2}) //"Conta+ Techfin"
		Aadd( aRotTFCD, {I18N(STR0019,{"Conta+ Techfin"}), "totvs.protheus.backoffice.techfin.util.callmenu.callcontadigital(2)", 0, 2}) //"Monitor Conta+ Techfin"
		Aadd(aReturnARotina,{"&Conta+ Techfin", aRotTFCD, 0, 2}) //"Conta+ Techfin"

	Endif
Return aReturnARotina

/*/{Protheus.doc}callAntecipa
    Totvs Antecipa 
	Executa chamada das rotinas do Antecipa
	
	@type       Function
    @author     Squad TechFin
    @since      26/03/2026
    @version    P12.1.2510
	@param      nOpc, numeric, Opção do menu do produto Antecipa
	@return     Nil
/*/
Function callAntecipa(nOpc As Numeric)
	Local aArea := FwGetArea()   as Array
	Local aRotBkp as Array

	SaveInter()
	aRotBkp := aClone(aRotina)
	aRotina :=  {}

	If totvs.protheus.backoffice.techfin.util.IsActive('1',.T.) .AND. totvs.protheus.backoffice.techfin.util.antecipaDependencies(.T.)
		Do Case
		Case nOpc == 1
			totvs.protheus.backoffice.techfin.antecipa.solicitacao.Antecipate()
		Case nOpc == 2
			totvs.protheus.backoffice.techfin.antecipa.monitor.AntecipaRequests()
		Case nOpc == 3
			totvs.protheus.backoffice.techfin.util.approvalDialog("1")
		Case nOpc == 4
			totvs.protheus.backoffice.techfin.antecipa.limits.AntecipaLimits()
		Case nOpc == 5
			totvs.protheus.backoffice.techfin.antecipa.postbilling.monitorBilling()
		Case nOpc == 6
			totvs.protheus.backoffice.techfin.antecipa.eligibility.EligibilityRules()
		EndCase
	Endif

	RestInter()
	aRotina := aClone(aRotBkp)
	RestArea(aArea)
	FwFreeArray(aArea)

Return

/*/{Protheus.doc}callDuplicataescritural
    Totvs Duplicata Escritural
	Executa chamadas das rotinas para Duplicata Escritural
	
	@type       Function
    @author     Squad TechFin
    @since      26/03/2026
    @version    P12.1.2510
	@param      nOpc, numeric, Opção do menu de Duplicata Escritural
	@return     Nil
/*/
Function callDuplicataescritural(nOpc As Numeric)
	Local aArea := FwGetArea()   as Array
	Local aRotBkp as Array

	SaveInter()
	aRotBkp := aClone(aRotina)
	aRotina :=  {}

	If tlpp.ffunc("totvs.protheus.backoffice.techfin.util.duplicataescrituralDependencies")
		If totvs.protheus.backoffice.techfin.util.IsActive('5',.T.) .AND. totvs.protheus.backoffice.techfin.util.duplicataescrituralDependencies(.T.)
			Do Case
			Case nOpc == 1
				totvs.protheus.backoffice.techfin.duplicataescritural.config.wizard()
			Case nOpc == 2
				totvs.protheus.backoffice.techfin.duplicataescritural.monitor.duplicatasMonitor()
			EndCase
		endIf
	Else
		Help("",1,STR0010,,I18N(STR0011,{"Duplicata Escritural"}),1,0, NIL, NIL, NIL, NIL, NIL, {STR0012})//"Seu ambiente está desatualizado e algumas funcionalidades do #1 não estão disponíveis"#"Por gentileza entre em contato com o administrador."
	EndIf

	RestInter()
	aRotina := aClone(aRotBkp)
	RestArea(aArea)
	FwFreeArray(aArea)

Return

/*/{Protheus.doc}callGestaodegarantias
    Totvs Gestão de Garantias
	Executa chamadas das rotinas para Gestão de Garantias
	
	@type       Function
    @author     Squad TechFin
    @since      26/03/2026
    @version    P12.1.2510
	@return     Nil
/*/
Function callGestaodegarantias()
	Local aArea := FwGetArea()   as Array
	Local aRotBkp as Array

	SaveInter()
	aRotBkp := aClone(aRotina)
	aRotina :=  {}

	If tlpp.ffunc("totvs.protheus.backoffice.techfin.util.gestaodegarantiasDependencies")
		If totvs.protheus.backoffice.techfin.util.IsActive('6',.T.) .AND. totvs.protheus.backoffice.techfin.util.gestaodegarantiasDependencies(.T.)
			totvs.protheus.backoffice.techfin.garantias.monitor.garantiasMonitor()
		endIf
	Else
		Help("",1,STR0010,,I18N(STR0011,{"Gestão de Garantias"}),1,0, NIL, NIL, NIL, NIL, NIL, {STR0012})//"Seu ambiente está desatualizado e algumas funcionalidades do #1 não estão disponíveis"#"Por gentileza entre em contato com o administrador."
	EndIf

	RestInter()
	aRotina := aClone(aRotBkp)
	RestArea(aArea)
	FwFreeArray(aArea)
Return

/*/{Protheus.doc}callmaisprazo
    +Prazo &Techfin
	Executa chamada das rotinas do +Prazo &Techfin
	
	@type       Function
    @author     Squad TechFin
    @since      19/05/2026
    @version    P12.1.2510
	@param      nOpc, numeric, Opção do menu do +Prazo TechFin
	@return     Nil
/*/
Function callmaisprazo(nOpc As Numeric)
	Local aArea := FwGetArea()   as Array
	Local aRotBkp as Array

	SaveInter()
	aRotBkp := aClone(aRotina)
	aRotina :=  {}

	If totvs.protheus.backoffice.techfin.util.IsActive('2',.T.) .and. totvs.protheus.backoffice.techfin.util.maisPrazoDependencies(.T.)
		Do Case
		Case nOpc == 1
			totvs.protheus.backoffice.techfin.maisprazo.solicitacao.requestExtension()
		Case nOpc == 2
			totvs.protheus.backoffice.techfin.maisprazo.monitor.extensionMonitor()
		Case nOpc == 3
			totvs.protheus.backoffice.techfin.util.approvalDialog("2")
		Case nOpc == 4
			totvs.protheus.backoffice.techfin.maisprazo.eligibility.eligibilityRules()
		Case nOpc == 5
			totvs.protheus.backoffice.techfin.maisprazo.suppliers.suppliersMonitor()
		EndCase
	endIf

	RestInter()
	aRotina := aClone(aRotBkp)
	RestArea(aArea)
	FwFreeArray(aArea)

Return

/*/{Protheus.doc}callcontadigital
	Totvs Conta Digital
	Executa chamada das rotinas do Totvs Conta Digital
	
	@type       Function
	@author     Squad TechFin
	@since      19/05/2026
	@version    P12.1.2510
    @return     Nil
/*/
Function callcontadigital (nOpc as Numeric)
	Local aArea := FwGetArea()   as Array
	Local aRotBkp   as Array
	Local cLinkProd as Character

	SaveInter()
	aRotBkp := aClone(aRotina)
	aRotina :=  {}

	cLinkProd := FwTotvsAppsRegistry():GetServiceURL( "techfin-conta-digital-url", "1" )

	If tlpp.ffunc("totvs.protheus.backoffice.techfin.contadigital.monitor.borderoMonitor")

		Do Case
		Case nOpc == 1
			ShellExecute("open",cLinkProd,"","",1)
		Case nOpc == 2
			totvs.protheus.backoffice.techfin.contadigital.monitor.borderoMonitor()
		EndCase

	Else
		Help("",1,STR0010,,I18N(STR0011,{"Conta+ TECHFIN"}),1,0, NIL, NIL, NIL, NIL, NIL, {STR0012})//"Seu ambiente está desatualizado e algumas funcionalidades do #1 não estão disponíveis"#"Por gentileza entre em contato com o administrador."
	EndIf

	RestInter()
	aRotina := aClone(aRotBkp)
	RestArea(aArea)
	FwFreeArray(aArea)

Return
