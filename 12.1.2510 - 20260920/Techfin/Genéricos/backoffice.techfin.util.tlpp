/*/{Protheus.doc} convTimeStamp
	Efetua a formatação da expressão SQL para campos S_T_A_M_P_ de acordo com
	o banco de dados utilizado.
	@type		function
	@since		04/05/2026
	@version	12.1.2610
	@author		Squad Techfin
	@param		cTimeStamp  , Character, timestamp no formato YYYY-MM-DD"T"HH:MM.SS.MM"Z"
	@return		Character	, Expressão SQL formatada de acordo com o banco de dados utilizado.
/*/
//------------------------------------------------------------------------------------------------
Function convTimeStamp( cTimeStamp As Character ) As Character
	Local cQuery as Character
	If "MSSQL" $ TcGetDb()
		cQuery := " CONVERT(DATETIME, '" + cTimeStamp + "', 127) "
	Else
        cQuery := " TO_TIMESTAMP( '" + cTimeStamp +  "','" + 'YYYY-MM-DD"T"HH24:MI:SS"Z"'+ "') "
	EndIf
Return cQuery

