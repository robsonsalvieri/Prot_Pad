/*/{Protheus.doc} TFAdvPrExec
Função que avalia se está sendo executado um script ADVPR
@return boolean, Indica se está sendo executado por um script ADVPR.
@author  Squad Techfin
@since   14/05/2026
/*/
//-------------------------------------------------------------------------------------
Function TFAdvPrExec()
Return ( FWIsInCallStack("FWMYTESTRUNNER") .Or. FWIsInCallStack("CASIGAADV") .Or. FWIsInCallStack("CACOVERTEST") .Or. FWIsInCallStack("CAUNITTEST") .Or. FWIsInCallStack("AUTJOBRUNCT") .Or. IsInCallStack("EXECSUITE") .Or. IsInCallStack("EXECSUITEBLIND"))

/*/{Protheus.doc} TFDGetError
    Lista os erros da mensagem de retorno
    @type function
    @author Squad TechFin
    @since  3/28/2026
    @param jMsg, Json, Objeto com a lista de erros da msg
    @return aErros, array, array[1]=log detalhado (ARQ_LOG), array[2]=motivo para browse (ARP_MOTIVO)
/*/
Function TFGetError( jMsg as json , cPropriedadeErros as character , cPropriedadeCodigo as character, cPropriedadeMensagem as character) as array

    local nX        := 0    as numeric
    local nLen		:= 0    as numeric
    local cErro     := ""   as character
    local cMotBrw   := ""   as character
    local aErros    := {}   as array

    default cPropriedadeErros       := "erros"
    default cPropriedadeCodigo      := "codigo"
    default cPropriedadeMensagem    := "mensagem"

    //-- Se houver erros na mensagem, monta as strings
    If jMsg:hasProperty(cPropriedadeErros) .And. !Empty(jMsg[cPropriedadeErros])
        nLen := Len(jMsg[cPropriedadeErros])
        For nX:=1 to nLen
            If jMsg[cPropriedadeErros][nX]:hasProperty(cPropriedadeCodigo) .And. jMsg[cPropriedadeErros][nX]:hasProperty(cPropriedadeMensagem)
                cErro += jMsg[cPropriedadeErros][nX][cPropriedadeCodigo]+"-"+jMsg[cPropriedadeErros][nX][cPropriedadeMensagem]+CRLF // Erro para ARQ_LOG
                cMotBrw += Alltrim(jMsg[cPropriedadeErros][nX][cPropriedadeMensagem]) + " | " // Erro para ARP_MOTIVO
            EndIf
        Next nX
        
        //-- Remove U­ltimo separador
        cMotBrw := Left(cMotBrw, Len(cMotBrw)-3)
        
        //-- Padroniza o tamanho do motivo para o browse apenas com erro
        cMotBrw := PadR(cMotBrw, TamSx3("ARP_MOTIVO")[1])
    EndIf
    
    Aadd(aErros, cErro )
    Aadd(aErros, cMotBrw )

Return(aErros)


/*/{Protheus.doc} vldAlteracaoTituloTechfin
    Valida se permite que titulo seja alterado.
    
