    /*/
Function vldAlteracaoTituloTechfin() as logical
    local lReturn := .F. as logical

    lReturn := (FwIsInCallStack('AntPostBill') .Or.;                 //Valida se a chamada vem do Antecipa.
                FwIsInCallStack('TFGarProcessTitleOccurrence') .Or.; //Valida se a chamada vem do Garantias de Duplicatas.
                FwIsInCallStack('GarBxTit'))  


Return lReturn

/*/{Protheus.doc} helpAlteracaoTituloTechfin
    (long_description)
    @type  Function
    @author user
    @since 24/06/2026
    @version version
    @param cSituacao, character, Codigo da carteira que o titulo se encontra no financeiro 
    @param cProblema, character, Descrição da causa problema que sera apresentado ao usuário
    @param cSolucao , character, Descriçao da solução para causa problema que sera apresentada ao usuário.
/*/
Function helpAlteracaoTituloTechfin(cSituacao as character,cProblema as character, cSolucao as character) 
    Local cProduct := getWalletProduct(cSituacao) as character

    If val(cProduct) == val(PROD_TF_ANTECIPA) .And. totvs.protheus.backoffice.techfin.util.IsActive(PROD_TF_ANTECIPA)
		cProblema  := STR0032 + " Techfin. " /*"Ação não disponível para título em carteira Techfin."*/
		cSolucao   := STR0033 + " TOTVS Antecipa. " + STR0034 + " TOTVS Antecipa > " + STR0035 /*"Este título foi antecipado pelo TOTVS Antecipa. Acesse TOTVS Antecipa > Pós faturamento para opções permitidas. "*/    
    ElseIf val(cProduct) == val(PROD_TF_GARANTIAS) .And. totvs.protheus.backoffice.techfin.util.IsActive(PROD_TF_GARANTIAS)
		cProblema  := STR0032 + " Techfin. " /*"Ação não disponível para título em carteira Techfin."*/
		cSolucao   := STR0036 + " Techfin, " + STR0037 + " Techfin -> Gestão de Garantias " + STR0038 /*"Esse titulo esta em Garantia com a Techfin, acesse Produtos Techfin -> Gestão de Garantias  para mais opções. "*/    
    EndIf
Return 

/*/{Protheus.doc} getProduct
    Retorna codigo do produto Techfin que a carteria pertence. 

    @type  Function
    @author Squad Techfin
    @since 30/06/2026
    @version 1.0
    @param cSituacao, character, Codigo da situação da carteira.
    @return cProduct, character, Codigo do produto Techfin
/*/
Function getWalletProduct(cSituacao as character) as character
    Local nTamSX3  := TamSX3("E1_SITUACA")[1] as character
    Local cProduct := ""                      as character
    Local cCartAnt := ""                      as character 
    LOCAL cCartGar := ""                      as character

    cCartAnt := PadR(Alltrim(SuperGetMV("MV_CARTECF",.F.,"")) , nTamSX3) + "|"
    cCartAnt += PadR(Alltrim(SuperGetMV("MV_DEVTECF",.F.,"")) , nTamSX3) + "|"
    
    cCartGar := PadR(Alltrim(SuperGetMV("MV_TFGCART",.F.,"Y")), nTamSX3)

    If cSituacao $ cCartAnt
        cProduct := PROD_TF_ANTECIPA
    ElseIf cSituacao $ cCartGar
        cProduct := PROD_TF_GARANTIAS
    EndIf
Return cProduct

/*/{Protheus.doc} getWalletTF
    Retorna carteiras Techfin 
    
    @type  Function
    @author Squad Techfin
    @since 30/06/2026
    @version 1.0
    @param cTypeWallet, character, Tipo de carteira Techfin 1=Contas a Recber, 2=Contas a Pagar
    @return cWallet, character, Retorna os tipos validos para carteiras TechFin
/*/
Function getWalletTF(cTypeWallet as character) as character
    Local nTamSx3    := TamSX3("E1_SITUACA")[1]
    Local cCartTecF	 := PadR(Alltrim(SuperGetMV("MV_CARTECF",, "")), nTamSx3) as character 
	Local cDevTecF   := PadR(Alltrim(SuperGetMV("MV_DEVTECF",, "")), nTamSx3) as character
	Local cCartTFGar := PadR(Alltrim(SuperGetMV("MV_TFGCART",, "")), nTamSx3) as character
	local cWallet    := ""                                           as character

    If cTypeWallet == "1" //-- Carteiras Techfin Contas a Receber
        cWallet := cCartTecF + "|" + cDevTecF + "|" + cCartTFGar
    EndIf

Return cWallet

/*/{Protheus.doc} CalcSaldoAtual
    Calcula o saldo atual do título, considerando os abatimentos e descontos financeiros
    @type function
    @author Squad TechFin
    @since 24/10/2025
    @param cAls, character, alias do título a ser calculado
    @return numeric, saldo atual do título
*/

Function CalcSaldoAtual(cAls as character) as numeric
    Local nSaldoAtu     := 0 as numeric
    Local nAbatimento   := 0 as numeric

    nAbatimento := SomaAbat((cAls)->E1_PREFIXO, (cAls)->E1_NUM, (cAls)->E1_PARCELA, "R", (cAls)->E1_MOEDA, dDataBase, (cAls)->E1_CLIENTE, (cAls)->E1_LOJA)
    If  ((cAls)->E1_DESCFIN) > 0
        nSaldoAtu :=(((cAls)->E1_SALDO - nAbatimento) * (1 - ((cAls)->E1_DESCFIN)/100)) + (cAls)->E1_SDACRES - (cAls)->E1_SDDECRE
    Else
        nSaldoAtu := ((cAls)->E1_SALDO - nAbatimento) + (cAls)->E1_SDACRES - (cAls)->E1_SDDECRE
    EndIf
Return nSaldoAtu
