#include "TOTVS.ch"
#include "TBICONN.ch"

/*/{Protheus.doc} MaisPrazoOrganizationsListResponseV1MessageReader
	Classe de Integração Novo Antecipa
	Atualiza dados das Filiais habilitadas para operar Antecipação.
	@type class
	@author Vitor Duca
	@since 05/09/2025
/*/
class MaisPrazoOrganizationsListResponseV1MessageReader
	data aDataOrgs	as array
	data jMSGData  	as json
	data jMessage  	as json
	data cMock    	as character
    data lMock    	as logical

	public method new() constructor
	public method read(oLinkMessage as object) as logical
	public method mock()
	public method formatMessage()
	public method processMessage() as logical
end class

/*/{Protheus.doc} MaisPrazoOrganizationsListResponseV1MessageReader::New
	Método construtor da classe
	@type method
	@author Vitor Duca
	@since 05/09/2025
/*/
method New() class MaisPrazoOrganizationsListResponseV1MessageReader
	::aDataOrgs := {}
	::jMSGData  := JsonObject():new()
	::jMessage  := JsonObject():new()
	::cMock		:= ""
	::lMock		:= .F.
return Self

/*/{Protheus.doc} MaisPrazoOrganizationsListResponseV1MessageReader::mock
    Método para mockar a mensagem recebida para testes
    @type method
    @author Squad TechFin
    @since 8/22/2025
    @param cData, character, dados da mensagem a ser mockada
/*/
method mock(cData as character) class MaisPrazoOrganizationsListResponseV1MessageReader
    ::cMock := cData
    ::lMock := .T.
return

/*/{Protheus.doc} MaisPrazoOrganizationsListResponseV1MessageReader::read
	esponsável pela leitura e processamento da mensagem.
	@type method
	@author Vitor Duca
	@since 05/09/2025
	@param oLinkMessage, object, Instância de FwTotvsLinkMesage da mensagem
	@return logical, sucesso ou falha. Determina se deve ou não retirar a mensagem da fila.
/*/
method read(oLinkMessage as object) as logical class MaisPrazoOrganizationsListResponseV1MessageReader
	local lSuccess := .F. 	as logical
	local cMessage := ""	as character
	
	cMessage :=  if(::lMock, ::cMock,  oLinkMessage:RawMessage())

	if ::jMessage:FromJSON(cMessage) == NIL
		::jMSGData  := ::jMessage["data"]
		::formatMessage()
		lSuccess := ::processMessage()
	endIf

	FwFreeObj(::jMSGData)
	FwFreeObj(::jMessage)

Return lSuccess // .T. apaga a mensagem da fila do smartlink

/*/{Protheus.doc} MaisPrazoOrganizationsListResponseV1MessageReader::formatMessage
	Obtem as filiais e status da mensagem de resposta do Smartlink Antecipa e agrupa por Grupo de Empresa.
	@type method
	@author Vitor Duca
	@since 05/09/2025
/*/
method formatMessage() class MaisPrazoOrganizationsListResponseV1MessageReader
	local aSM0        := FWLoadSM0()		as array
	local nOrg        := 0					as numeric
	local nPosFil     := 0 					as numeric
	local cBranchCNPJ := ""					as character
	local nStatus     := 0					as numeric
	local jOrgData    						as json
	local jParameters := JsonObject():new()	as json
	local jTextMessage:= JsonObject():new()	as json 

	If ::jMSGData:hasProperty("customerParameters")
		jParameters["parameters"] := ::jMSGData["customerParameters"]
	Endif

	If ::jMSGData:hasProperty("customerConditionParameters")
		jParameters["conditionParameters"] := ::jMSGData["customerConditionParameters"]
	Endif

	If ::jMSGData:hasProperty("formattedParametersText")
		jTextMessage["message"] := ::jMSGData["formattedParametersText"]
	Endif

	if ::jMSGData:hasProperty('customers')
		for nOrg := 1 to len(::jMSGData["customers"])
			cBranchCNPJ := ::jMSGData["customers"][nOrg]["document"]
			nStatus     := ::jMSGData["customers"][nOrg]["customerStatus"]
			if (nPosFil := AScan(aSM0, { |x| x[18] $ cBranchCNPJ})) > 0
				jOrgData := JsonObject():new()
				jOrgData["ARA_GRPSM0"] := aSM0[nPosFil][1]
				jOrgData["ARA_FILSM0"] := aSM0[nPosFil][2]
				jOrgData["ARA_NOMFIL"] := aSM0[nPosFil][7]
				jOrgData["ARA_CNPJ"]   := cBranchCNPJ
				jOrgData["ARA_STATUS"] := nStatus
				
				//limites
				jOrgData["ARA_LTOTAL"] := ::jMSGData["customers"][nOrg]["limit"]["totalLimit"] // Lim. Total
				jOrgData["ARA_LDISP" ] := ::jMSGData["customers"][nOrg]["limit"]["availableLimit"] // Limite Disponível
				jOrgData["ARA_LUTIL" ] := ::jMSGData["customers"][nOrg]["limit"]["usedLimit"] // Limite Utilizado
				jOrgData["ARA_LRPREA"] := ::jMSGData["customers"][nOrg]["limit"]["reservedForBatchProcessingLimit"] // Limite Pré-Autorizado reservada

				//Taxas
				jOrgData["ARA_IOFA"] := ::jMSGData["customerConditionParameters"][1]["annualIof"] //IOF anual
				jOrgData["ARA_ADDIOF"] := ::jMSGData["customerConditionParameters"][1]["additionalIof"] //IOF Adicional

				//Parametros
				jOrgData["ARA_PARAMS"] := jParameters:toJson() //Parametros e condições
				jOrgData["ARA_FTXMSG"] := jTextMessage:ToJson() //Texto informativo das condições
				
				AADD(::aDataOrgs, {aSM0[nPosFil][1], aSM0[nPosFil][2], jOrgData:toJSON()})
			endIf
		next nOrg
	endIf
return

/*/{Protheus.doc} MaisPrazoOrganizationsListResponseV1MessageReader::processMessage
	Inicia o processamento das organizações obtidas da mensagem de resposta do Smartlink Antecipa.
	@type method
	@author Vitor Duca
	@since 05/09/2025
/*/
method processMessage() as logical class MaisPrazoOrganizationsListResponseV1MessageReader
	local nOrg     := 0		as numeric
	local cPayload := ""	as character
	local lSuccess := .T.	as logical

	cPayload := ::jMessage:ToJSON()
	for nOrg := 1 to len(::aDataOrgs)
		lSuccess := StartJob("TMPZ001ORG", GetEnvServer(), .T., ::aDataOrgs[nOrg][1], ::aDataOrgs[nOrg][2], ::aDataOrgs[nOrg][3], cPayload)
	next nOrg
return lSuccess

/*/{Protheus.doc} TMPZ001ORG
	Gravação da tabela ARA-Organization Techfin
	@type function
	@author Vitor Duca
	@since 05/09/2025
	@param cCompany, character, Grupo Empresa
	@param cBranch , character, Filial
	@param jData   , json     , dados da organização
	@param cPayload, character, mensagem recebida
/*/
Function TMPZ001ORG(cCompany as character, cBranch as character, cData as character, cPayload as character) as logical
	local lInsert := .F.  				as logical
	local jData	:= JsonObject():new()	as json
	local cUUID := ""					as character
	local cText := ""					as character

	RPCSetType(3)
	RPCSetEnv(cCompany, cBranch,,,'FIN') 

	jData:fromJson(cData)

	dbSelectArea('ARA')
	ARA->(dbSetOrder(1)) //ARA_FILIAL, ARA_CNPJ, ARA_PRODTF
	lInsert := !ARA->(dbSeek(FWxFilial('ARA') + jData["ARA_CNPJ"] + "2"))

	BEGIN TRANSACTION
		RecLock('ARA', lInsert)
			if lInsert
				ARA->ARA_FILIAL := FWxFilial('ARA')
				ARA->ARA_GRPSM0 := jData["ARA_GRPSM0"]
				ARA->ARA_FILSM0 := jData["ARA_FILSM0"]
				ARA->ARA_NOMFIL := jData["ARA_NOMFIL"]
				ARA->ARA_CNPJ   := jData["ARA_CNPJ"]
			endIf
			
			ARA->ARA_STATUS := cValToChar(jData["ARA_STATUS"]) // 0=Ativo; 1=Bloqueado Credito; 2=Bloqueado Atraso; 3=Cancelado; 4=Bloqueado outros

			//Limites
			ARA->ARA_LTOTAL := jData["ARA_LTOTAL"] // Lim. Total
			ARA->ARA_LDISP  := jData["ARA_LDISP"]  // Limite Disponível
			ARA->ARA_LUTIL  := jData["ARA_LUTIL"]  // Limite Utilizado
			ARA->ARA_LRPREA := jData["ARA_LRPREA"] // Limite Pré-Autorizado reservada

			//Taxas
			ARA->ARA_IOFA   := jData["ARA_IOFA"]
			ARA->ARA_ADDIOF := jData["ARA_ADDIOF"]

			//Parametros
			ARA->ARA_PARAMS := jData["ARA_PARAMS"] //Parametros

			cText := DecodeUTF8(jData["ARA_FTXMSG"])

			If Empty(cText)
				cText := jData["ARA_FTXMSG"]
			Endif

			ARA->ARA_FTXMSG := cText //Texto informativo

			ARA->ARA_PRODTF := '2'
		ARA->(MsUnlock())

		if ARA->(FieldPos("ARA_MSUID")) > 0
			cUUID := ARA->ARA_MSUID
		endIf

		totvs.protheus.backoffice.techfin.util.LogSmartLink(cPayload, "ARA", cUUID, "2", "Organization", "T")
	END TRANSACTION

	RpcClearEnv()
Return .T.
