#include "tlpp-core.th"
#include "protheus.ch"
#include "FwMvcDef.ch"
#include "backoffice.techfin.maisprazo.suppliers.ch"

NAMESPACE totvs.protheus.backoffice.techfin.maisprazo.suppliers
USING NAMESPACE totvs.protheus.backoffice.techfin.util

/*/{Protheus.doc} suppliersMonitor
    Monitor Gestão de Fornecedores Mais Prazo
    @type Function
    @author Vitor Duca
    @since 08/10/2025
    @version 1.0
/*/
Function suppliersMonitor() as Object
    Local oBrowse as Object

    If !IsActive("2", .T.) .or. GetHlpLGPD({"ARI_NOME","ARI_CGC"})
        Return
    EndIf

    oBrowse := FWLoadBrw("totvs.protheus.backoffice.techfin.maisprazo.suppliers.suppliersMonitor")

Return oBrowse

/*/{Protheus.doc} BrowseDef
    Definição do browse
    @type  Function
    @author Vitor Duca
    @since 08/10/2025
    @version 1.0
    @return oBrowse, Object, Objeto que referencia a browse que será criada
/*/
Function BrowseDef() as object
    local oBrowse := FWmBrowse():New()  as object

    oBrowse:SetAlias("ARI")
    oBrowse:SetMainProc("suppliersMonitor")
    oBrowse:SetDescription(STR0001) //"Cadastro de fornecedores"
    oBrowse:SetMenuDef("totvs.protheus.backoffice.techfin.maisprazo.suppliers.suppliersMonitor")
    oBrowse:AddLegend("ARI_STATUS == '1'", "GREEN", STR0002) //"Ativo"
    oBrowse:AddLegend("ARI_STATUS == '2'", "RED", STR0003) //"Inativo"
    oBrowse:AddLegend("ARI_STATUS == '0'", "WHITE", STR0004) //"Não cadastrado"
    oBrowse:AddLegend("ARI_STATUS == '3'", "BLACK", STR0005) //"Bloqueado"
    oBrowse:AddLegend("ARI_STATUS == '4'", "YELLOW", STR0012) //"Em análise"
    oBrowse:AddLegend("ARI_STATUS == '5'", "GRAY", STR0013) //"Não aprovado"
    oBrowse:Activate()    

Return oBrowse

/*/{Protheus.doc} MenuDef
    Definição do menu
    @type  Function
    @author Vitor Duca
    @since 08/10/2025
    @version version    
/*/
Function MenuDef() as Array
    Local aRotina := {} as Array

    ADD OPTION aRotina Title STR0006 Action "VIEWDEF.totvs.protheus.backoffice.techfin.maisprazo.suppliers.suppliersMonitor" OPERATION 3 ACCESS 0//"Incluir"
    ADD OPTION aRotina Title STR0007 Action "VIEWDEF.totvs.protheus.backoffice.techfin.maisprazo.suppliers.suppliersMonitor" OPERATION 2 ACCESS 0//"Visualizar"

Return aRotina


/*/{Protheus.doc} ModelDef
    Definição do modelo de dados
    @type  Function
    @author Vitor Duca
    @since 08/10/2025
    @version version    
/*/
Function ModelDef() as Object
    Local oModel                                as Object 
    Local oStruARI  := FWFormStruct( 1, 'ARI')  as Object
    Local oEvent    := suppliersMonitor():New() as Object

    oModel := MPFormModel():New('suppliersMonitor')
    oStruARI:SetProperty("ARI_STATUS", MODEL_FIELD_INIT, FWBuildFeature( STRUCT_FEATURE_INIPAD, '"4"'))

    oModel:AddFields('ARIMASTER', /*cOwner*/, oStruARI)
    oModel:SetPrimaryKey({"ARI_CODFOR"})
    oModel:SetDescription(STR0001) //"Cadastro de fornecedores"
    oModel:InstallEvent("suppliersMonitor", /*cOwner*/, oEvent)

    oModel:SetPost({|oModel|ARIPosValidModel(oModel)}, .F.)

Return oModel


/*/{Protheus.doc} ViewDef
    Definição da View
    
    @type  Function
    @author Vitor Duca
    @since 08/10/2025
    @version version    
/*/
Function ViewDef() as Object
    Local oModel                                as Object
    Local oView := FWFormView():New()           as Object
    Local oStruARI := FWFormStruct( 2, "ARI")   as Object

    oModel := FWLoadModel("totvs.protheus.backoffice.techfin.maisprazo.suppliers.suppliersMonitor")

    oStruARI:RemoveField("ARI_DATA")
    oStruARI:RemoveField("ARI_HORA")

    oView:SetModel( oModel )
    
    oView:AddField( 'VIEW_ARI', oStruARI, 'ARIMASTER' )

    oView:CreateHorizontalBox( 'SUPERIOR', 100 )
    oView:SetOwnerView( 'VIEW_ARI', 'SUPERIOR' )

Return oView

/*/{Protheus.doc} suppliersMonitor
    Classe responsavel por orquestrar os eventos do modelo de dados da rotina
    @author Vitor Duca
    @since 08/10/2025
    @version 1.0
/*/
Class suppliersMonitor from FWModelEvent
    Public Method new()
    Public Method InTTS(oModel as object)
EndClass

/*/{Protheus.doc} new
    Metodo construtor da classe
    @author Vitor Duca
    @since 08/10/2025
    @version 1.0
 /*/
Method new() Class suppliersMonitor
Return

/*/{Protheus.doc} InTTS
    Método que é chamado pelo MVC durante a gravacao do Model, no controle de transacao
    @author Vitor Duca
    @since 08/10/2025
    @version version
    @param oModel, Objeto, Modelo de dados da rotina
/*/
Method InTTS(oModel as object) Class suppliersMonitor
    Local cQueue   := "MaisPrazoCompanyConsultationRequestV1"   as character
    Local cOperation := "CompanyConsultation"                   as character
    Local cMSGID   := ""                                        as character
    Local oView    := FwViewActive()                            as object
    local jData := JsonObject():new()                           as json
    local oARI := oModel:GetModel('ARIMASTER')                  as object

    If oModel:GetOperation() == MODEL_OPERATION_INSERT .And. oModel:VldData()
                                       
        jData["document"] := FWSM0Util():GetSM0Data( cEmpAnt , cFilAnt, {"M0_CGC"})[1][2]
        jData["companies"] := {}
        Aadd(jData["companies"], {"companyDocumentNumber": oARI:getValue("ARI_CGC"), "companyName": Alltrim(oARI:getValue("ARI_NOME"))})

        cMSGId := totvs.protheus.backoffice.techfin.util.sendSmartLink(cQueue, "2", cOperation, jData:ToJson(), .T., ARI->ARI_MSUID, .T., "ARI")

        If oView <> NIL .and. oView:IsActive()
            oView:showInsertMsg(.F.)
        Endif

        If Empty(cMSGID)
            oModel:SetErrorMessage(,,,, "Smartlink", STR0008, STR0009) //"Problema de comunicação com o Smartlink"#"Verifique a configuração do SmartLink e tente novamente mais tarde"
            RollbackDelTran()
        Else
            FWAlertSuccess(STR0010, STR0011) //"Sua solicitação foi enviada para aprovação e você pode acompanhar o andamento em TOTVS Mais Prazo > Cadastro de fornecedores."#"Cadastro enviado para aprovação"
        Endif
    Endif
Return

/*/{Protheus.doc} ARIPosValidModel
    Pós-Validação do modelo
    @author Squad TechFin Integrações
    @since 16/12/2025
    @version version
    @param oModel, Objeto, Modelo de dados da rotina
/*/
Static Function ARIPosValidModel(oModel As Object) As Logical

Local lFindARICode := .T.                          As Logical
local oARI         := oModel:GetModel('ARIMASTER') As Object

If ARI->( MsSeek( FwXFilial("ARI") + oARI:getValue("ARI_CODFOR") + oARI:getValue("ARI_LOJA") + oARI:getValue("ARI_CGC") ) )
    lFindARICode := .F.
    oModel:SetErrorMessage(,,,, "SuppliersMonitor", STR0014) // "Cadastro existente no Gestão de Fornecedores"
EndIf

Return lFindARICode
