#include "tlpp-core.th"
#include "fwmvcdef.ch"
#include "totvs.ch"
#include "backoffice.techfin.duplicataescritural.escrituracao.ch"

NAMESPACE totvs.protheus.backoffice.techfin.duplicataescritural.escrituracao
USING NAMESPACE totvs.protheus.backoffice.techfin.util
USING NAMESPACE totvs.protheus.backoffice.techfin.duplicataescritural.config.dados
USING NAMESPACE totvs.protheus.backoffice.techfin.smartlink.dupesescrituracaoexecuterequest

Static __lCustomWhere := ExistBlock("TFDFILEM") as Logical

/*/{Protheus.doc} escriturar
    Cria dialog principal para o usuário solicitando escrituração de títulos
    @type  Function
    @author Squad TechFin
    @since 22/03/2026
    @version 1.0
    @param lAuto    , logical, Indica se é processo automático (Execauto)
    @param aRecnoSE1, array  , Array com os RECNO dos registros a serem processados
    @return lRet    , logical, Retorna o resultado do processamento
/*/
Function escriturar(lAuto as Logical, aRecnoSE1 as Array) as Logical
	local cAlias     := GetNextAlias() as Character
	local cMark      := "X"            as Character
	local aCoors     := {}             as Array
	local aHeaderRow := {}             as Array
	local aGridRow   := {}             as Array
	local aArea      := {}             as Array
	local lPixel     := .T.            as Logical
	local lRet       := .T.            as Logical
	local oDlg                         as Object
	local oMrkDuplicatas               as Object
	local oSize                        as Object

	DEFAULT lAuto := isBlind()

	aArea   := FwGetArea()
	aCoors  := FWGetDialogSize(oMainWnd)

	If Pergunte("TFIN005", !lAuto)
		If lAuto .And. Len(aRecnoSE1) > 0
			loadWriting(cAlias,, lAuto, aRecnoSE1,cMark)
			lRet := commitWriting(cAlias, cMark, oDlg, lAuto)
		Else
			//Faz o calculo automatico de dimensoes de objetos
			oSize := FwDefSize():New(.T.)
			oSize:lLateral := .F.
			oSize:lProp	:= .T. // Proporcional
			oSize:AddObject( "HEADER",  100, 15, .T., .T. ) // Totalmente dimensionavel
			oSize:AddObject( "GRID"  ,  100, 85, .T., .T. ) // Totalmente dimensionavel

			oSize:aMargins := { 2, 2, 1, 2 } // Espaco ao lado dos objetos 0, entre eles 3

			oSize:Process() // Dispara os calculos
			aHeaderRow := {oSize:GetDimension("HEADER","LININI"),;
				oSize:GetDimension("HEADER","COLINI"),;
				oSize:GetDimension("HEADER","LINEND"),;
				oSize:GetDimension("HEADER","COLEND"),;
				oSize:GetDimension("HEADER","XSIZE"),;
				oSize:GetDimension("HEADER","YSIZE")}

			aGridRow := {oSize:GetDimension("GRID","LININI"),;
				oSize:GetDimension("GRID","COLINI"),;
				oSize:GetDimension("GRID","LINEND"),;
				oSize:GetDimension("GRID","COLEND"),;
				oSize:GetDimension("GRID","XSIZE"),;
				oSize:GetDimension("GRID","YSIZE")}

			oDlg := MsDialog():New(oSize:aWindSize[1],oSize:aWindSize[2], oSize:aWindSize[3],oSize:aWindSize[4],"",,,,,,,,oMainWnd,lPixel)

			loadHeader(oDlg, aHeaderRow)

			oMrkDuplicatas := loadGrid(oDlg, aGridRow, cAlias, cMark, lAuto, aRecnoSE1)

			oMrkDuplicatas:Activate()

			oDlg:Activate(,,,.T.,,,{|| EnchoiceBar(oDlg, {|| lRet := commitWriting(cAlias, cMark, oDlg) }, {|| oDlg:End()}) } )

		EndIf
	EndIf

	FwRestArea(aArea)

	FwFreeArray(aArea)
	FwFreeArray(aCoors)
	FwFreeArray(aHeaderRow)
	FwFreeArray(aGridRow)
	FwFreeObj(oSize)
	FwFreeObj(oDlg)

Return lRet

/*/{Protheus.doc} loadHeader
    Cria elementos textuais no header da página de escrituração
    @type  Function
    @author Squad TechFin
    @since 23/03/2026
    @version 1.0
    @param oDlg      , object, Objeto dialog principal
    @param aHeaderRow, array , Array contendo dimensões do header
    @return NIL      , void  , Função sem retorno
/*/
Function loadHeader(oDlg as Object,aHeaderRow as Array)

	TSay():New(aHeaderRow[1] + 05, aHeaderRow[2] + 10, {|| "<b>" + STR0001 + "</b>" }, oDlg,, TFont():New(,,-22,,,), .F., .F., .F., .T., , , 300, 20,,,,,,.T.) //Solicitar escrituração de títulos
	TSay():New(aHeaderRow[1] + 25, aHeaderRow[2] + 10, {|| STR0002 }, oDlg,, TFont():New(,,-16,,,), .F., .F., .F., .T., , , 300, 20,,,,,,.T.) //"Selecione os títulos abaixo para enviar para escrituração manual."
	TSay():New(aHeaderRow[1] + 50, aHeaderRow[2] + 10, {|| "<b>" + STR0003 + "</b>" + STR0004 }, oDlg,, TFont():New(,,-14,,,), .F., .F., .F., .T., , , 500, 20,,,,,,.T.) //<b>Atenção</b> a escrituração só deve ser feita se o pagador [sacado] já tiver sido formalmente comunicado sobre a emissão destes títulos.

Return

/*/{Protheus.doc} loadGrid
    Carrega grid com títulos a receber elegíveis para escrituração
    @type  Function
    @author Squad TechFin
    @since 23/03/2026
    @version 1.0
    @param oDlg      , object   , Objeto dialog principal
    @param aGridRow  , array    , Array contendo dimensões da grid
    @param cAlias    , character, Alias da tabela temporária
    @param cMark     , character, Caractere para marcação de registros
    @param lAuto     , logical  , Indica se é processo automático
    @param aRecnoSE1 , array    , Array com RECNO dos registros a processar
    @return oMrkDuplicatas, object, Objeto FWMarkBrowse com grid de títulos
/*/
Function loadGrid(oDlg as Object, aGridRow as Array, cAlias as Character, cMark as Character, lAuto as Logical, aRecnoSE1 as Array) as Object
	local aFields    := {}  as Array
	local aColumn    := {}  as Array
	local aCpFiltro  := {}  as Array
	local jColumnsBrwSE1    as Json
	local jColumnsBrwSA1    as Json
	local oMrkDuplicatas    as Object
	local oPanel		    as Object
	

	aAdd(aCpFiltro, {"E1_PREFIXO" ,"Prefixo"   , "C", TamSX3("E1_PREFIXO")[1], TamSX3("E1_PREFIXO")[2], X3PICTURE("E1_PREFIXO")})
	aAdd(aCpFiltro, {"E1_NUM"     ,"Numero"    , "C", TamSX3("E1_NUM")[1]    , TamSX3("E1_NUM")[2]    , X3PICTURE("E1_NUM")})
	aAdd(aCpFiltro, {"E1_CLIENTE" ,"Cliente"   , "C", TamSX3("E1_CLIENTE")[1], TamSX3("E1_CLIENTE")[2], X3PICTURE("E1_CLIENTE")})
	aAdd(aCpFiltro, {"E1_VENCREA" ,"Vencimento", "D", TamSX3("E1_VENCREA")[1], TamSX3("E1_VENCREA")[2], X3PICTURE("E1_VENCREA")})

	loadWriting(cAlias,@aFields, lAuto, aRecnoSE1,cMark)

	aEval(aFields,{|x| aAdd(aColumn,x[1]) })
	jColumnsBrwSE1 := createColumnsBrowse(aColumn, "SE1")
	jColumnsBrwSA1 := createColumnsBrowse(aColumn, "SA1")

	aColumn := {}
	aEval(jColumnsBrwSE1["columns"],{|x| aAdd(aColumn,x)})
	aEval(jColumnsBrwSA1["columns"],{|x| aAdd(aColumn,x)})

	If !lAuto
		oPanel := tPanel():New(aGridRow[1],aGridRow[2],"",oDlg,,.T.,,,,aGridRow[5],aGridRow[6])

		oMrkDuplicatas := FWMarkBrowse():New()
		oMrkDuplicatas:SetOwner(oPanel)
		oMrkDuplicatas:SetAlias(cAlias)
		oMrkDuplicatas:SetFieldMark("MARK")
		oMrkDuplicatas:SetMark( cMark, cAlias, "MARK" )
		oMrkDuplicatas:bMark    := {|| }
		oMrkDuplicatas:bValid   := {|| .T.}
		oMrkDuplicatas:bAllMark := {|| }

		oMrkDuplicatas:SetMenuDef("")
		oMrkDuplicatas:SetDescription("")
		oMrkDuplicatas:SetTemporary(.T.)
		oMrkDuplicatas:SetUseFilter(.T.)

		oMrkDuplicatas:SetColumns(aColumn)
		oMrkDuplicatas:SetFieldFilter(aCpFiltro)

		oMrkDuplicatas:DisableReport("")
		oMrkDuplicatas:DisableConfig()
	EndIf

Return oMrkDuplicatas

/*/{Protheus.doc} loadWriting
    Carrega títulos a receber conforme parâmetros do usuário e que atendam os requisitos para Duplicata Escritural
    @type  function
    @author Squad TechFin
    @since 24/03/2026
    @version 1.0
    @param cAlias    , character, Alias da tabela temporária
    @param aFields   , array    , Campos utilizados no browse
    @param lAuto     , logical  , Indica se é processo automático
    @param aRecnoSE1 , array    , Array com RECNO dos registros a processar
    @param cMark     , character, Caractere para marcação de registros
    @return NIL      , void     , Função sem retorno
/*/
function loadWriting(cAlias as Character, aFields as Array, lAuto as Logical, aRecnoSE1 as Array, cMark as Character)

	local cQuery     := ""                     as character
	local cSelect    := ""                     as character
	local cWherePE   := ""                     as character
	local aAreaSE1   := SE1->(FwGetArea())     as array
	local aAreaSA1   := SA1->(FwGetArea())     as array
	local aAreaSF2   := SF2->(FwGetArea())     as array
	local aIndex     := {}                     as array
	local aTipos     := {}                     as array
	local nOrderTemp := 1                      as numeric
	local nBindParam := 1                      as numeric
	local nOpc      := 0   					   as Numeric
	local oModalOK        					   as Object
	local oExecTbl1                            as Object
	local oTitulos                             as Object
	local cVMvPar06  := ""                     as character
	


	Aadd(aIndex, {"E1_FILIAL","E1_CLIENTE","E1_LOJA"})
	Aadd(aIndex, {"E1_FILIAL","E1_VENCREA"})
	Aadd(aIndex, {"E1_FILIAL","E1_EMISSAO"})
	Aadd(aIndex, {"E1_FILIAL","E1_PREFIXO","E1_NUM"})

	lAuto := (lAuto .And. Len(aRecnoSE1) > 0)


	cQuery := " SELECT ? MARK,"
	cQuery += " E1_FILIAL,E1_PREFIXO,E1_NUM,E1_PARCELA,E1_TIPO,A1_NOME,A1_CGC,E1_VALOR,E1_EMISSAO,E1_VENCREA,E1_CLIENTE,E1_LOJA,E1_FILORIG,F2_CHVNFE,F2_CODNFE "
	cQuery += " ,SE1.R_E_C_N_O_ AS SE1_RECNO , SA1.R_E_C_N_O_ AS SA1_RECNO , SF2.R_E_C_N_O_ AS SF2_RECNO , SF3.R_E_C_N_O_ AS SF3_RECNO "
	cQuery += " FROM " + RetSqlName("SE1") + " SE1"

	cQuery += " JOIN " + RetSqlName("SA1") + " SA1 ON "
	cQuery += " SA1.A1_FILIAL = ?"
	cQuery += " AND SA1.A1_COD = SE1.E1_CLIENTE"
	cQuery += " AND SA1.A1_LOJA = SE1.E1_LOJA"
	cQuery += " AND SA1.D_E_L_E_T_ = ?"
	cQuery += " AND SA1.A1_CGC <> ? " // Desconsiderar A1_CGC vazio

	cQuery += " LEFT JOIN " + RetSqlName("SF2") + " SF2 ON"
	cQuery += " SF2.F2_FILIAL = ?"
	cQuery += " AND SF2.F2_DOC = SE1.E1_NUM"
	cQuery += " AND SF2.F2_SERIE = SE1.E1_SERIE"
	cQuery += " AND SF2.F2_CLIENTE = SE1.E1_CLIENTE"
	cQuery += " AND SF2.F2_LOJA = SE1.E1_LOJA"
	cQuery += " AND SF2.F2_PREFIXO = SE1.E1_PREFIXO"
	cQuery += " AND SF2.D_E_L_E_T_ = ?"
	cQuery += " AND CONCAT(SF2.F2_CHVNFE, SF2.F2_CODNFE) <> ? " // NF-e ou NFS-e autorizada
	cQuery += " LEFT JOIN " + RetSqlName("SF3") + " SF3 ON "
	cQuery += " SF3.F3_FILIAL = SF2.F2_FILIAL"
	cQuery += " AND SF3.F3_NFISCAL = SF2.F2_DOC"
	cQuery += " AND SF3.F3_SERIE = SF2.F2_SERIE"
	cQuery += " AND SF3.F3_CLIEFOR = SF2.F2_CLIENTE"
	cQuery += " AND SF3.F3_LOJA = SF2.F2_LOJA"
	cQuery += " AND SF3.D_E_L_E_T_ = ?"
	cQuery += " AND SF3.F3_CODRSEF IN (?) " // Apenas NF-e autorizadas
	cQuery += " AND CONCAT(SF3.F3_CHVNFE, SF3.F3_CODNFE) <> ? " // Chave da NF-e no vazia
	cQuery += " AND SF3.F3_IDENTFT = ?" // Identificador SFT

	cQuery += " WHERE "
	cQuery += " SE1.E1_FILORIG = ? "
	cQuery += " AND SE1.E1_CLIENTE >= ? "
	cQuery += " AND SE1.E1_CLIENTE <= ? "
	cQuery += " AND SE1.E1_VENCREA >= ? "
	cQuery += " AND SE1.E1_VENCREA <= ? "
	cQuery += " AND SE1.E1_EMISSAO >= ? "
	cQuery += " AND SE1.E1_SALDO > ? "
	cQuery += " AND SE1.E1_TIPO NOT IN (?) "
	cQuery += " AND SE1.E1_SITUACA = ? "//em carteira
	cQuery += " AND SE1.D_E_L_E_T_= ? "
	cQuery += " AND NOT EXISTS (SELECT 1 FROM " + RetSqlName("ARP") + " ARP "
	cQuery += " WHERE "
	cQuery += "     ARP.ARP_FILTIT = SE1.E1_FILORIG "
	cQuery += " AND ARP.ARP_PREFIX = SE1.E1_PREFIXO "
	cQuery += " AND ARP.ARP_NUMTIT = SE1.E1_NUM "
	cQuery += " AND ARP.ARP_PARCEL = SE1.E1_PARCELA "
	cQuery += " AND ARP.ARP_TIPO   = SE1.E1_TIPO "
	cQuery += " AND ARP.ARP_CLIENT = SE1.E1_CLIENTE "
	cQuery += " AND ARP.ARP_LOJA   = SE1.E1_LOJA "
	cQuery += " AND ARP.D_E_L_E_T_ = ? "
	cQuery += " AND ARP.ARP_STATUS IN (?) )"

	If lAuto
		cQuery += " AND SE1.R_E_C_N_O_ IN (?) "
	EndIf

	If __lCustomWhere
		cWherePE := execBlock("TFDFILEM")
		If ValType(cWherePE) == "C"
			cWherePE := Alltrim(cWherePE)
			If ValidaWherePE(cWherePE)
				If !(Upper(Left(cWherePE,3)) == "AND")
					cWherePE := "AND " + cWherePE
				EndIf
				cQuery += " " + cWherePE
			Else
				oModalOK := TechfinDialog():new()
				oModalOK:setTitle(STR0013) //"Atenção"
				oModalOK:setText(20, 10, STR0014 + cWherePE)  //"P.E. TFDFILEM retornou um fragmento SQL com conteúdo não permitido. O fragmento foi descartado: " + cWherePE"
				oModalOK:setButton(STR0011, {|| nOpc := 0, oModalOK:DeActivate() }) //"Fechar"
				oModalOK:openInfo(100, 250)
			EndIf
		EndIf
	EndIf

	cQuery := ChangeQuery(cQuery)
	oExecTbl1 := FwExecStatement():New(cQuery)

	aTipos := StrTokArr2(MVABATIM + "|" + MV_CRNEG + "|" + MVPROVIS + "|" + MVRECANT + "|" + MV_CPNEG + "|" + MVTAXA + "|" + MVTXA + "|" + MVINSS + "|", "|")

	If lAuto
		oExecTbl1:SetString(nBindParam++, cMark)       //MARK
	Else
		oExecTbl1:SetString(nBindParam++, " ")       //MARK
	EndIf
	oExecTbl1:SetString(nBindParam++, FwxFilial("SA1", MV_PAR01))       //A1_FILIAL
	oExecTbl1:SetString(nBindParam++, " ")                              //D_E_L_E_T_
	oExecTbl1:SetString(nBindParam++, " ")                              //A1_CGC
	oExecTbl1:SetString(nBindParam++, FwxFilial("SF2", MV_PAR01))       //F2_FILIAL
	oExecTbl1:SetString(nBindParam++, " ")                              //D_E_L_E_T_
	oExecTbl1:SetString(nBindParam++, " ")                              //F2_CHVNFE+F2_CODNFE (NF-e ou NFS-e) Filtro
	oExecTbl1:SetString(nBindParam++, " ")                              //D_E_L_E_T_
	oExecTbl1:SetIn(nBindParam++, {"100", "124", "150"})                //F3_CODRSEF
	oExecTbl1:SetString(nBindParam++, " ")                              //F3_CHVNFE
	oExecTbl1:SetString(nBindParam++, StrZero(1,TamSX3("F3_IDENTFT")[1]))//F3_IDENTFT
	oExecTbl1:SetString(nBindParam++, MV_PAR01)                         //E1_FILORIG
	oExecTbl1:SetString(nBindParam++, MV_PAR02)                         //E1_CLIENTE de
	oExecTbl1:SetString(nBindParam++, MV_PAR03)                         //E1_CLIENTE ate
	oExecTbl1:SetDate(nBindParam++, MV_PAR04)                           //vencimento de
	oExecTbl1:SetDate(nBindParam++, MV_PAR05)                           //vencimento ate
	oExecTbl1:SetString(nBindParam++, getDateConfig())                  //E1_EMISSAO
	oExecTbl1:SetNumeric(nBindParam++, 0)                               //E1_SALDO
	oExecTbl1:SetIn(nBindParam++, aTipos)                               //E1_TIPO
	oExecTbl1:SetString(nBindParam++, "0")                              //E1_SITUACA
	oExecTbl1:SetString(nBindParam++, " ")                              //D_E_L_E_T_
	oExecTbl1:SetString(nBindParam++, " ")                              //ARP.D_E_L_E_T_
	oExecTbl1:SetIn(nBindParam++, {"1","2","3","4"})                    //ARP_STATUS 1=Processando;2=Escriturado;3=Baixado;4=Baixa Parcial;5=Erro;6=Cancelado

	If lAuto .And. Len(aRecnoSE1) > 0
		oExecTbl1:SetIn(nBindParam++,aRecnoSE1)
	EndIf

	cSelect := oExecTbl1:getFixQuery()

	createTemporaryTable(oTitulos, @aFields, aIndex,cSelect,cAlias)

	cVMvPar06 := cValToChar(MV_PAR06)
	If !Empty(cVMvPar06)
		nOrderTemp := Val(cVMvPar06)
		If nOrderTemp < 1 .Or. nOrderTemp > Len(aIndex)
			nOrderTemp := 1
		EndIf
	EndIf

	(cAlias)->(dbSetOrder(nOrderTemp))

	FwRestArea(aAreaSE1)
	FwRestArea(aAreaSA1)
	FwRestArea(aAreaSF2)

	FwFreeArray(aAreaSE1)
	FwFreeArray(aAreaSA1)
	FwFreeArray(aAreaSF2)
	FwFreeObj(oExecTbl1)

Return


/*/{Protheus.doc} commitWriting
    Valida seleção de títulos e envia para escrituração na escrituradora
    @type  Function
    @author Squad TechFin
    @since 24/03/2026
    @version 1.0
    @param cAlias, character, Alias da tabela temporária
    @param cMark , character, Caractere para marcação de registros
    @param oDlg  , object   , Objeto dialog a ser encerrado
    @param lAuto , logical  , Indica se é processo automático
    @return lRet , logical  , Retorna .T. se enviou com sucesso
/*/
Function commitWriting(cAlias as Character,cMark as Character, oDlg as Object, lAuto as Logical) as Logical
	//local cError := ""  as Character
	LOCAL cChaveTit := ""  as Character
	LOCAL cChaveFK7 := ""  as Character
	local nOpc      := 0   as Numeric
	local nP        := 0   as Numeric
	local lRet      := .F. as Logical
	local aNFList   := {}  as Array //Array com os RECNO dos títulos vinculados a NF-e
	local aTitList  := {}  as Array //Array com os RECNO dos títulos sem vinculo com NF-e
	local oModalOK         as Object
	local oModalCommit     as Object

	oModalOK := TechfinDialog():new()
	oModalOK:setTitle(STR0005) //"Solicitar escrituração dos títulos"
	oModalOK:setText(20, 10, STR0006)  //"Ao confirmar, os títulos selecionados serão enviados para validação e registro na escrituradora.Deseja continuar?"
	oModalOK:setButton(STR0007, {|| nOpc := 1, oModalOK:DeActivate() }) //"Solicitar escrituração"
	oModalOK:setButton(STR0012, {|| nOpc := 0, oModalOK:DeActivate() }) //"Cancelar"
	oModalOK:openInfo(100, 250)

	If (nOpc == 1 .Or. lAuto) .And. Select(cAlias) > 0
		lRet := .T.
		(cAlias)->(DbGoTop())

		While !(cAlias)->(Eof())
			If (cAlias)->MARK == cMark
				cChaveTit := FWxFilial("SE1", (cAlias)->E1_FILORIG)+"|"+(cAlias)->E1_PREFIXO+"|"+(cAlias)->E1_NUM+"|"+(cAlias)->E1_PARCELA+"|"+(cAlias)->E1_TIPO+"|"+(cAlias)->E1_CLIENTE+"|"+(cAlias)->E1_LOJA
				cChaveFK7 := FINGrvFK7("SE1",cChaveTit)

				If (cAlias)->SF2_RECNO > 0 .And. !Empty((cAlias)->(F2_CHVNFE+F2_CODNFE))
					if (nP:=aScan(aNFList, { |x| x[1] == (cAlias)->SF2_RECNO }) ) == 0
						Aadd(aNFList, { (cAlias)->SF2_RECNO, {} } )
						Aadd(aNFList[Len(aNFList), 2], cChaveFK7 )
					Else
						Aadd(aNFList[nP, 2], cChaveFK7 )
					EndIf
				Else
					Aadd(aTitList, cChaveFK7)
				EndIF
			EndIf
			(cAlias)->(DbSkip())
		EndDo

		//-- Faz o envio da escrituração
		FWMsgRun(, {|| DupesDispatch(aNFList, aTitList)}, "", 'Processando escrituração...')


		oModalCommit := TechfinDialog():new()
		oModalCommit:setTitle("") //Solicitação enviada para análise!
		oModalCommit:setText(20, 10, STR0008)  //"Solicitação de escrituração enviada!"
		oModalCommit:setText(40, 10, STR0009)  //"Você pode acompanhar sua solicitação para este(s) título(s) em"
		oModalCommit:setText(50, 10, STR0010)  //"Gestão de duplicata escritural > Visualizar."
		oModalCommit:setButton(STR0011, {|| oModalCommit:DeActivate() }) //"Fechar"
		oModalCommit:openInfo(100, 250)
		FwFreeObj(oModalCommit)

	EndIf

	FwFreeObj(oModalOK)

Return lRet

/*/{Protheus.doc} DupesDispatch
    Chama execução da montagem do payload, gravação da ARP e envio da mensagem
    @type  Function
    @author Squad Techfin
    @since 09/04/2026
    @version 1.0
    @param aNFList, array, Ids FK7 de títulos com vinculo com Doc. Saída
    @param aTitList,array, Ids FK7 de títulos avulsos
/*/   
Function DupesDispatch(aNFList as array, aTitList as array)
	local nX         := 0  as numeric
	local nLen       := 0  as numeric
	local nRecnoSF2  := 0  as numeric
	local aFilterIds := {} as array
	local  lShowMsg  := .T. as logical
	local oDupes           as object

	//---------------------------------------------------------
	//-- Escrituração por Doc. de Saída
	nLen:=Len(aNFList)
	For nX:=1 to nLen

		nRecnoSF2 := aNFList[nX, 1]
		aFilterIds:= aClone( aNFList[nX, 2] )//Somente itens marcados

		oDupes := DupesEscrituracaoExecuteRequest():New()
		oDupes:SetMsgToFront(lShowMsg)
		oDupes:setIdInvoice(nRecnoSF2)
		oDupes:setFilterId(aFilterIds)
		oDupes:runByInvoice()
		lShowMsg := .F.
		oDupes:Destroy()
	Next


	//---------------------------------------------------------
	//-- Escrituração por título
	nLen:=Len(aTitList)
	For nX:=1 to nLen
		oDupes := DupesEscrituracaoExecuteRequest():New()
		oDupes:SetMsgToFront(lShowMsg)
		oDupes:addIdFK7( aTitList[nX] )
		oDupes:runByInstallment()
		lShowMsg := .F.
		oDupes:Destroy()
	Next

Return


/*/{Protheus.doc} ValidaWherePE
Valida se o fragmento SQL retornado pelo ponto de entrada TFDFILEM nao
contem tokens.
@type static function
@author Squad Techfin
@since 04/09/2026
@version 1.0
@param cWherePE, character, Fragmento de clausula WHERE devolvido pelo P.E. TFDFILEM
@return lValido, logical, .T. se o fragmento nao contem tokens proibidos, .F. caso contrario
/*/
Static Function ValidaWherePE(cWherePE as character) as logical

	Local aTokens as array
	Local cUpper  := "" as character
	Local lValido := .T. as logical
	Local nX      := 0  as numeric

	aTokens := {";", "--", "/*", "*/", "XP_CMDSHELL"}
	Aadd(aTokens, " EXEC ")
	Aadd(aTokens, " EXECUTE ")
	Aadd(aTokens, " DROP ")
	Aadd(aTokens, " DELETE ")
	Aadd(aTokens, " INSERT ")
	Aadd(aTokens, " UPDATE ")
	Aadd(aTokens, " ALTER ")
	Aadd(aTokens, " TRUNCATE ")
	Aadd(aTokens, " UNION ")
	Aadd(aTokens, " GRANT ")
	Aadd(aTokens, " REVOKE ")
	Aadd(aTokens, " WAITFOR ")
	Aadd(aTokens, " SELECT ")
	Aadd(aTokens, "# ")

	cUpper := Upper(" " + AllTrim(cWherePE) + " ")

	For nX := 1 To Len(aTokens)
		If aTokens[nX] $ cUpper
			lValido := .F.
			Exit
		EndIf
	Next nX

Return lValido
