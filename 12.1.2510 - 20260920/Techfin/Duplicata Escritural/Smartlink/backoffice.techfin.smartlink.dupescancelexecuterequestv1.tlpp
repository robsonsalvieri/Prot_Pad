#Include "tlpp-core.th"
#Include "totvs.ch"

NAMESPACE totvs.protheus.backoffice.techfin.smartlink.dupescancelexecuterequest
USING NAMESPACE totvs.protheus.backoffice.techfin.util

//----------------------------------------------------------------------
/*/{Protheus.doc} cancelaEscrituracaoTit
	Cancela a escrituração a a partir da exclusão de um título
	@type function
	@author Squad TechFin
	@since 10/04/2025
/*/
//----------------------------------------------------------------------

Function cancelaEscrituracaoTit( cChaveFK7 as character )
	local oCanc 			as object
	local aArea 	:= {} 	as array
	local cChaveTit := '' 	as character

	default cChaveFK7 := ''

    aArea := FwGetArea()

	If Empty(cChaveFK7)
  		cChaveTit := FWxFilial("SE1", SE1->E1_FILORIG)+"|"+SE1->E1_PREFIXO+"|"+SE1->E1_NUM+"|"+SE1->E1_PARCELA+"|"+SE1->E1_TIPO+"|"+SE1->E1_CLIENTE+"|"+SE1->E1_LOJA
    	cChaveFK7 := FinBuscaFK7(cChaveTit,"SE1")
	EndIf
	dbSelectArea('ARP')
	dbSetOrder(1)
	If dbSeek(FwxFilial('ARP')+cChaveFK7)
		oCanc := DupesCancelExecuteRequest():New()
		oCanc:setIdFK7(cChaveFK7)
		If !oCanc:sendCanc()
			FwLogMsg("ERROR",,"TECHFIN",FunName(),"","SendCancel", "Falha ao enviar cancelamento para FK7_IDDOC: " + cChaveFK7)
		EndIf
	EndIF

	FwRestArea(aArea)
    FwFreeArray(aArea)
	FwFreeObj(oCanc)
Return


//----------------------------------------------------------------------
/*/{Protheus.doc} DupesCancelExecuteRequest	
	Requisição de Cancelamento da escrituração do título
	@type class
	@author Squad TechFin
	@since 10/04/2025
/*/
//----------------------------------------------------------------------
class DupesCancelExecuteRequest      

	data cIdTitulo  		as character
	data lSetMsgToFront     as logical

	public method new() constructor
	public method setIdFK7()
	public method SetMsgToFront()
	public method sendCanc()
end class

//----------------------------------------------------------------------
/*/{Protheus.doc} DupesCancelExecuteRequest::New
	Método construtor da classe
	@type method
	@author Squad TechFin
	@since 10/04/2025
/*/
//----------------------------------------------------------------------
method New() class DupesCancelExecuteRequest
	::cIdTitulo 		:= ''
	::lSetMsgToFront    := .F.
return Self

//----------------------------------------------------------------------
/*/{Protheus.doc} DupesCancelExecuteRequest::setIdFK7
    FK7_IDDOC a ser processado
    @type method
    @author Squad TechFin
    @since  02/04/2026
/*/
//----------------------------------------------------------------------
Method setIdFK7(cIdFK7 as character) class DupesCancelExecuteRequest 
    ::cIdTitulo := cIdFK7
Return

//--------------------------------------------------------------------------------------------------
/*/{Protheus.doc} DupesCancelExecuteRequest::SetMsgToFront
    Indica se deve apresentar mensagens de erro
    @type method
    @author Squad TechFin
    @since  02/04/2026
    @version P12.1.2510
/*/
//--------------------------------------------------------------------------------------------------
Method SetMsgToFront(lSet as logical) class DupesCancelExecuteRequest
    ::lSetMsgToFront := lSet
Return

//----------------------------------------------------------------------
/*/{Protheus.doc} DupesCancelExecuteRequest::sendCanc
    Envia cancelamento
    @type method
    @author Squad TechFin
    @since  02/04/2026
/*/
//----------------------------------------------------------------------
Method sendCanc() class DupesCancelExecuteRequest 
	local oSmartUtil 			as object
	local oOcorrencia 			as object
	local lSuccess := .F. 		as logical
	local cOcorrencia := '' 	as character
	local jCancel 	:= JsonObject():new() 

	//-- Monta mensagem
	jCancel["cnpjSolicitante"]			:= FwSM0Util():GetSM0Data(cEmpAnt, cFilAnt, {"M0_CGC"})[1][2]
	jCancel["respondTo"]				:= "DupesCancelExecuteResponseV1"
	jCancel["duplicatasParaCancelar"]	:={}

	Aadd(jCancel["duplicatasParaCancelar"], JsonObject():new() )
	jCancel["duplicatasParaCancelar"][1]["erpInstallmentId"] := ::cIdTitulo	
	jCancel["duplicatasParaCancelar"][1]["motivo"]			 := 'OUTR'

	//-- Envia via smartlink
	oSmartUtil := totvs.protheus.backoffice.techfin.util.SmartLinkUtil():new()
    if ( lSuccess := oSmartUtil:send('DupesCancelExecuteRequestV1', jCancel:ToJson(), .T./*lReqID*/, ''/*cReqKey*/, ::lSetMsgToFront/*lHelp*/) )
		cOcorrencia := '015'
	Else
		cOcorrencia := '016'
	EndIf

	//-- Gera ocorrência no histórico da duplicata
	oOcorrencia:= TechfinOccurrences():New()
    oOcorrencia:setProduct("5")
    oOcorrencia:setIdDoc( ::cIdTitulo )
    oOcorrencia:Register(cOcorrencia)

	FwFreeObj(jCancel)
	FwFreeObj(oSmartUtil)
	FwFreeObj(oOcorrencia)
Return lSuccess
