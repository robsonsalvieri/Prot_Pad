#include "tlpp-core.th"
#include "totvs.ch"

USING NAMESPACE totvs.protheus.backoffice.techfin.duplicataescritural.lockunlock
USING NAMESPACE totvs.protheus.backoffice.techfin.util

static __cProdTF := "5" as character

/*/{Protheus.doc} DupesLockUnlockResponseV1MessageReader
    Classe de Integração Dupes Lock/Unlock
    Recebe os dados de bloqueio/desbloqueio de duplicatas a cada transação realizada.
    @type class
    @author squad.techfin 
    @since 02/10/2025
/*/
class DupesLockUnlockResponseV1MessageReader
    data jMSGData           as json
    data jMessage           as json
    data aEmpresaFil        as Array
    data cMock              as character
    data cData              as Character
    data lMock              as logical
    data aItensInvalidos    as Array
    data aItensProcessados  as Array
    
    public method new() constructor
    public method read(oLinkMessage as object) as logical
    public method setMock(cData as character) 
    public method formatMessage()
    public method processMessage() as logical
    public method loadMessage()    as logical
    
    public method setMsgData(jMsgData as Json)
    public method setItensInvalidos(aItens as Array)
    public method setItensProcessados(aItens as Array)
    
    public method getItensInvalidos()  as Array
    public method getItensProcessados() as Array

    private method setEmpFil(cErpRequestId as Character) 
    private method getEmpFil() as Array
    
end class

/*/{Protheus.doc} DupesLockUnlockResponseV1MessageReader::New
	Método construtor da classe
	@type method
	@author squad.techfin
	@since 02/10/2025
    @return object, Instância da classe
/*/
method New() class DupesLockUnlockResponseV1MessageReader
    ::jMSGData           := JsonObject():new()
    ::jMessage           := JsonObject():new()
    ::aEmpresaFil        := {}
    ::cMock              := ""
    ::cData              := ""
    ::lMock              := .F.
    ::aItensInvalidos    := {}
    ::aItensProcessados  := {}
return Self

/*/{Protheus.doc} DupesLockUnlockResponseV1MessageReader::setMock
    Método para mockar a mensagem recebida para testes
    @type method
    @author Squad TechFin
    @since 02/10/2025
    @param cData, character, dados da mensagem a ser mockada
    @return Nil
/*/
method setMock(cData as character) class DupesLockUnlockResponseV1MessageReader
    ::cMock := cData
    ::lMock := .T. 
return

/*/{Protheus.doc} DupesLockUnlockResponseV1MessageReader::read
	responsável pela leitura e processamento da mensagem.
	@type method
	@author squad.techfin
	@since 02/10/2025
	@param oLinkMessage, object, Instância de FwTotvsLinkMesage da mensagem
	@return logical, sucesso ou falha. Determina se deve ou não retirar a mensagem da fila.
/*/

method read(oLinkMessage as object) as logical class DupesLockUnlockResponseV1MessageReader
    local lSuccess := .F. as logical
    local cMessage := ""  as character

    If ::lMock
        cMessage := ::cMock
    Else
        cMessage := oLinkMessage:RawMessage()
    EndIf

    if ::jMessage:FromJSON(cMessage) == NIL
        ::setMsgData(::jMessage["data"])
        If ::loadMessage()
            ::formatMessage()
            lSuccess := ::processMessage()
        EndIf
    endIf

    FwFreeObj(::jMSGData)
    FwFreeObj(::jMessage)

Return lSuccess

/*/{Protheus.doc} DupesLockUnlockResponseV1MessageReader::setMsgData
	Define dados da variavel jMSGData
	@type method
	@author squad.techfin
	@since 02/10/2025
	@param jMsgData, Json, dados da mensagem a serem armazenados
	@return Nil
/*/
method setMsgData(jMsgData as Json)  class DupesLockUnlockResponseV1MessageReader
    ::jMSGData := jMsgData
Return 

/*/{Protheus.doc} DupesLockUnlockResponseV1MessageReader::loadMessage
	Realiza load (carga de dados).
	@type method
	@author squad.techfin
	@since 02/10/2025
    @return Logical, Verdadeiro - quado os dados estão dentro do layout para processsar ou Falso - quando não esta correto.
/*/
method loadMessage() as logical class DupesLockUnlockResponseV1MessageReader
    Local lRet := .F.

    If ::jMSGData:hasProperty("status") .And. ::jMSGData["status"] == "PROCESSADO"
        lRet := .T.
        
        If ::jMSGData:hasProperty("erpRequestId")
            ::setEmpFil(::jMSGData["erpRequestId"])
        EndIf
        If ::jMSGData:hasProperty("lista_itens_invalidos")
            ::setItensInvalidos(::jMSGData["lista_itens_invalidos"])
        EndIf
        If ::jMSGData:hasProperty("lista_itens_processados")
            ::setItensProcessados(::jMSGData["lista_itens_processados"])
        EndIf
    EndIf
Return lRet

/*/{Protheus.doc} DupesLockUnlockResponseV1MessageReader::formatMessage
	Realiza formatação dos dados para processamento.
	@type method
	@author squad.techfin
	@since 02/10/2025	
    @return Nil
/*/
method formatMessage() class DupesLockUnlockResponseV1MessageReader
    local jData := JsonObject():New() as json

    jData["invalidos"]    := ::getItensInvalidos()
    jData["processados"]  := ::getItensProcessados()

    ::cData := jData:ToJSON()
   
return

/*/{Protheus.doc} DupesLockUnlockResponseV1MessageReader::processMessage
	Inicia o processamento da mensagem enviada pelo Smartlink.
	@type method
	@author squad.techfin
	@since 02/10/2025
	@return logical, Verdadeiro se o processamento foi bem-sucedido, Falso caso contrário
/*/
method processMessage() as logical class DupesLockUnlockResponseV1MessageReader
    local cPayload := ""  as character
    local lSuccess := .F. as logical
    Local aSM0     := {}  as array

    aSM0     := ::getEmpFil()

    If Len(aSM0) > 0
        cPayload := ::jMessage:ToJSON()
        
        lSuccess := StartJob("TFDELckRes", GetEnvServer(), .T., aSM0[Len(aSM0)][1], aSM0[Len(aSM0)][2], ::cData, cPayload)
    EndIf    

return lSuccess

/*/{Protheus.doc} DupesLockUnlockResponseV1MessageReader::setEmpFil
	Valida dados empresa na SM0
	@type method
	@author squad.techfin
	@since 02/10/2025
	@param cErpRequestId, character, identificador de requisição da empresa
	@return Nil
/*/
method setEmpFil(cErpRequestId as Character)  class DupesLockUnlockResponseV1MessageReader
    Local aSM0      := FWLoadSM0()	as array
    Local nPosSM0   := 0            as numeric 
    Local aErpReqId := {}           as array

    aErpReqId := StrTOKArr2(cErpRequestId,"|")

    If Len(aErpReqId) >= 3 .And. (nPosSM0 := aScan(aSM0, {|x| (Alltrim(x[1]) == Alltrim(aErpReqId[1]) .And. Alltrim(x[2]) == Alltrim(aErpReqId[2]))})) > 0
        aAdd(::aEmpresaFil,{aSM0[nPosSM0][1],aSM0[nPosSM0][2],cErpRequestId})
    EndIf
 return 

/*/{Protheus.doc} DupesLockUnlockResponseV1MessageReader::getEmpFil
	Retorna dados da empresa SM0.
	@type method
	@author squad.techfin
	@since 02/10/2025
	@return array, Array com dados da empresa e filial
/*/
method getEmpFil()  class DupesLockUnlockResponseV1MessageReader
return ::aEmpresaFil

/*/{Protheus.doc} DupesLockUnlockResponseV1MessageReader::setItensInvalidos
	Define itens inválidos
	@type method
	@author squad.techfin
	@since 02/10/2025
	@param aItens, array, Array com itens inválidos
	@return Nil
/*/
method setItensInvalidos(aItens as Array) class DupesLockUnlockResponseV1MessageReader
    
    If ValType(aItens) == 'A' .And. Len(aItens) > 0
        ::aItensInvalidos :=  aItens
    EndIf
return

/*/{Protheus.doc} DupesLockUnlockResponseV1MessageReader::getItensInvalidos
	Retorna itens inválidos
	@type method
	@author squad.techfin
	@since 02/10/2025
	@return array, Array com itens inválidos processados
/*/
method getItensInvalidos() as Array class DupesLockUnlockResponseV1MessageReader
return ::aItensInvalidos

/*/{Protheus.doc} DupesLockUnlockResponseV1MessageReader::setItensProcessados
	Define itens processados
	@type method
	@author squad.techfin
	@since 02/10/2025
	@param aItens, array, Array com itens processados
	@return Nil
/*/
method setItensProcessados(aItens as Array) class DupesLockUnlockResponseV1MessageReader
    
    If ValType(aItens) == 'A' .And. Len(aItens) > 0
        ::aItensProcessados :=  aItens
    EndIf
return

/*/{Protheus.doc} DupesLockUnlockResponseV1MessageReader::getItensProcessados
	Retorna itens processados
	@type method
	@author squad.techfin
	@since 02/10/2025
	@return array, Array com itens processados com sucesso
/*/
method getItensProcessados() as Array class DupesLockUnlockResponseV1MessageReader
return ::aItensProcessados

/*/{Protheus.doc} TFDELckRes
    Realiza o processamento do retorno enviado pelo SmartLink, para atualizar status de bloqueio/desbloqueio de duplicatas no Protheus.
    @type function
    @author squad.techfin 
    @since 02/10/2025
    @param cCompany, character, Grupo Empresa
    @param cBranch , character, Filial
    @param cData   , character, dados da organização
    @param cPayload, character, mensagem recebida
    @return logical, Sempre .T. indicando processamento concluído
/*/
Function TFDELckRes(cCompany as character, cBranch as character, cData as character, cPayload as character) as logical
    Local cLog         := ""                 As Character
    Local lError       := .F.                As Logical
    Local lProcess     := .F.                As Logical
    Local aLogs        := {}                 As Array
    Local aErros       := {}                 As Array
    Local aInvalidos   := {}                 As Array
    Local aProcessados := {}                 As Array
    Local jData        := JsonObject():new() As json

    RPCSetType(3)
    RPCSetEnv(cCompany, cBranch,,,'FIN')

    jData:fromJson(cData)
    
    aInvalidos   := jData["invalidos"]
    aProcessados := jData["processados"]
    
    processIdsDoc(aProcessados, @aLogs, @aErros, "1",@lProcess,@lError)
    processIdsDoc(aInvalidos, @aLogs, @aErros, "2",@lProcess,@lError)
    
    If lProcess .Or. lError
        If lError 
            cLog  := formatLog(aErros)
            logSmartLink(cPayload, "ARP", /*cUUID*/, __cProdTF, "LockUnlockResponsev1", "T",,cLog)//cMessage, cAlias, cUUID, cProduct, cOperation, cOrigin, cIDReq, cLogNeg
        Else
            logSmartLink(cPayload, "ARP", /*cUUID*/, __cProdTF, "LockUnlockResponsev1", "T",,)//cMessage, cAlias, cUUID, cProduct, cOperation, cOrigin, cIDReq, cLogNeg
        EndIf
    EndIf
	    
    RpcClearEnv()

    FwFreeArray(aLogs)        
    FwFreeArray(aErros)       
    FwFreeArray(aProcessados) 
    FwFreeArray(aInvalidos)   
    FwFreeObj(jData)
Return .T.


/*/{Protheus.doc} processIdsDoc
    Processa uma lista de IDs de documentos (parcelas) da tabela ARP, validando registros e registrando ocorrências.
    Atualiza arrays de logs e erros conforme os registros sejam encontrados ou não na base de dados.
    @type function
    @author squad.techfin
    @since 08/05/2026
    @param aDados, array, Array contendo objetos com chave 'erpInstallmentId' a serem processados
    @param aLogs, array, Array de referência para armazenar registros processados com sucesso
    @param aErros, array, Array de referência para armazenar erros de processamento
    @param cTipo, character, Código do tipo de processamento (ex: '1' para processado, '2' para inválido)
    @param lProcess, logical, Indicador de processamento com sucesso
    @param lError, logical, Indicador de erro no processamento
    @return Nil
/*/
Static Function processIdsDoc(aDados as Array,aLogs as Array,aErros as Array, cTipo as Character, lProcess as Logical, lError as Logical) 
    Local nTotal       := 0 as Numeric
    Local nX           := 0 as Numeric
    Local oLockUnlock  := DupesLockUnlock():new() as Object
    
    nTotal := Len(aDados)
    oLockUnlock:setTipo(cTipo)
    
    For nX := 1 To nTotal
        If oLockUnlock:process(aDados[nX]["erpInstallmentId"])
            lProcess := .T.
            aAdd(aLogs, aDados[nX])
        Else
            lError := .T.
            aAdd(aErros, {"error", aDados[nX], oLockUnlock:getError()})
        EndIf
    Next
    
    oLockUnlock:Destroy()
Return
