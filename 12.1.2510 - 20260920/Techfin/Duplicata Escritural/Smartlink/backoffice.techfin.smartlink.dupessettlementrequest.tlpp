/*/{Protheus.doc} DupesSettlementRequest
	Classe para tratamentos de envio de baixas, a receber, de duplicatas escrituradas.

	@type class
	@author Squad Techfin
	@since 30/04/2026
	@version 1.0
/*/
Class DupesSettlementRequest
	Private Data aIdFK1 As Array
	Private Data cIdTituloFK7 As Character
	Private Data cCnpjSolicitante As Character
	Private Data cDocCliente As Character
	Private Data cMotivoBaixa As Character
	Private Data cFormaRecebimento As Character
	Private Data cPayload As Character
	Private Data cTipoSaldoBaixa As Character
	Private Data dDataBaixa As Date
	Private Data nValorBaixa As Numeric
	Private Data nSaldoTitulo As Numeric
			
	Public Method new() Constructor
	Public Method setIdDoc()
	Public Method setDtBaixa()
	Public Method setVlBaixa()
	Public Method setIdFk1()
	Public Method setMotBx()
	Public Method sendDupesSettlementRequestV1() As Logical
	Private Method loadDadosComplementares() As Logical
EndClass

/*/{Protheus.doc} new
	Método construtor da classe para tratamentos de envio de baixas, a receber, 
	de duplicatas escrituradas.

	@type Public Method
	@author Squad Techfin
	@since 30/04/2026
	@version 1.0
/*/
Method new() Class DupesSettlementRequest
	::aIdFK1 := {}	
	::cIdTituloFK7 := ""
	::cCnpjSolicitante := ""
	::cDocCliente := ""
	::cMotivoBaixa := ""
	::cFormaRecebimento := ""
	::cPayload := ""
	::cTipoSaldoBaixa := ""
	::dDataBaixa := CTOD("//")
	::nValorBaixa := 0
	::nSaldoTitulo := 0
Return Self

