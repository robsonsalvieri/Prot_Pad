/*/{Protheus.doc} loadDadosComplementares
	Método para carregar dados complementares nas propriedades da classe, para
	a geração do payload de integração.

	@return lCarregouDados, Indica se os dados foram carregados com sucesso.

	@type Private Method
	@author Squad Techfin
	@since 30/04/2026
	@version 1.0
/*/
Method loadDadosComplementares() As Logical Class DupesSettlementRequest 
	Local aAreaSE1 := {} As Array
	Local aAreaSA1 := {} As Array
	Local aAreaF7G := {} As Array
	Local cChaveSE1 := "" As Character
	Local cDocCliente := "" As Character
	Local cFormaRecebimento := "" As Character
	Local lCarregouDados := .F. As Logical
	Local lContinua := .F. As Logical
	Local nSaldoTitulo := 0 As Numeric
	
	aAreaSE1 := SE1->(FwGetArea())
	aAreaSA1 := SA1->(FwGetArea())
	aAreaF7G := F7G->(FwGetArea())
	
	//Carrega dados do título
	cChaveSE1 := FinFK7Key(, ::cIdTituloFK7)
	SE1->(dbSetOrder(1)) //E1_FILIAL+E1_PREFIXO+E1_NUM+E1_PARCELA+E1_TIPO
	If lContinua := SE1->(dbSeek(cChaveSE1))
		nSaldoTitulo := SaldoTit(SE1->E1_PREFIXO, SE1->E1_NUM, SE1->E1_PARCELA, SE1->E1_TIPO, ;
                                 SE1->E1_NATUREZ, "R", SE1->E1_CLIENTE, 1, ::dDataBaixa, ::dDataBaixa, ;
								 SE1->E1_LOJA, SE1->E1_FILIAL, SE1->E1_TXMOEDA)
	EndIf

	//Carrega dados do cliente
	If lContinua
		SA1->(dbSetOrder(1)) //A1_FILIAL+A1_COD+A1_LOJA
		If lContinua := SA1->(dbSeek(FWxFilial("SA1") + SE1->E1_CLIENTE + SE1->E1_LOJA))
			cDocCliente := SA1->A1_CGC
		EndIf
	EndIf

	//Carrega dados do motivo de baixa
	If lContinua
		F7G->(dbSetOrder(1)) //F7G_FILIAL+F7G_SIGLA
		If lContinua := F7G->(dbSeek(FWxFilial("F7G") + ::cMotivoBaixa))
			cFormaRecebimento := deParaFormaRec(AllTrim(F7G->F7G_FORMRC))
		EndIf
	EndIf

	If lContinua
		::cCnpjSolicitante := FwSM0Util():GetSM0Data(cEmpAnt, cFilAnt, {"M0_CGC"})[1][2]
		::nSaldoTitulo := nSaldoTitulo
		If nSaldoTitulo == 0
		    ::cTipoSaldoBaixa := "TOTL"
		Else
			::cTipoSaldoBaixa := "PRCL"
		EndIf
		::cDocCliente := cDocCliente
		::cFormaRecebimento := cFormaRecebimento

		lCarregouDados := .T.
	EndIf

	FwRestArea(aAreaSE1)
	FwRestArea(aAreaSA1)
	FwRestArea(aAreaF7G)
	FwFreeArray(aAreaSE1)
	FwFreeArray(aAreaSA1)
	FwFreeArray(aAreaF7G)
Return lCarregouDados

/*/{Protheus.doc} sendDupesSettlementRequestV1
	Método montar o payload e realizar o envio da entidade "DupesSettlementRequestV1" via Smartlink.

	@return lEnviou, Indica se o envio foi realizado com sucesso.

	@type Public Method
	@author Squad Techfin
	@since 30/04/2026
	@version 1.0
/*/
Method sendDupesSettlementRequestV1() As Logical class DupesSettlementRequest 
	Local cFilaEnvio := "" As Character
	Local cFilaRetorno := "" As Character
	Local jDadosBaixa := Nil As Json
	Local lEnviou := .F. As Logical
	Local lCarregouDados := .F. As Logical
	Local nX := 0 As Numeric
	local oSmartUtil := Nil As Object
	local oOcorrencia := NIl As Object

	cFilaEnvio := "DupesSettlementRequestV1"
	cFilaRetorno := "DupesSettlementResponseV1"
	
	lCarregouDados := ::loadDadosComplementares()
	
	If lCarregouDados
		jDadosBaixa := JsonObject():new()
		jDadosBaixa["cnpjSolicitante"] := ::cCnpjSolicitante
		jDadosBaixa["respondTo"] := cFilaRetorno

		jDadosBaixa["registros"] := Array(1)
		jDadosBaixa["registros"][1] := JsonObject():new()

		jDadosBaixa["registros"][1]["erpInstallmentId"] := ::cIdTituloFK7
		jDadosBaixa["registros"][1]["documento_beneficiario"] := ::cCnpjSolicitante
		jDadosBaixa["registros"][1]["tipo"] := ::cTipoSaldoBaixa
		jDadosBaixa["registros"][1]["valor_pagamento"] := ::nValorBaixa
		jDadosBaixa["registros"][1]["data_pagamento"] := Left(FwTimeStamp(3, ::dDataBaixa), 10)
		jDadosBaixa["registros"][1]["saldo_em_aberto"] := ::nSaldoTitulo
		jDadosBaixa["registros"][1]["pagador"] := ::cDocCliente
		jDadosBaixa["registros"][1]["tipo_instrumento"] := ::cFormaRecebimento

		::cPayload := jDadosBaixa:ToJson()

		// Envia via smartlink
		oSmartUtil := totvs.protheus.backoffice.techfin.util.SmartLinkUtil():new()
		If oSmartUtil:send(cFilaEnvio, ::cPayload, .T., "", .F.)
			lEnviou := .T.
		EndIf
	EndIf
	
	IF lEnviou
		// Gera ocorrência no histórico da duplicata
		oOcorrencia := TechfinOccurrences():New()
		oOcorrencia:setProduct("5") // 5 = Duplicata Escritural
		oOcorrencia:setIdDoc(::cIdTituloFK7)
		For nX := 1 To Len(::aIdFk1)
			oOcorrencia:setIdMov(::aIdFk1[nX])
			oOcorrencia:Register("019")
		Next nX
		
		FwFreeObj(oOcorrencia)
	EndIf

	FwFreeObj(jDadosBaixa)
	FwFreeObj(oSmartUtil)
Return lEnviou

/*/{Protheus.doc} alertaBaixa
	Função para verificar se o título, a ser baixado, já está escriturado e então 
	exibir um alerta de confirmação ao usuário.

	@return lConfirmaBaixa, Indica se o usuário confirmou seguir com a baixa.

	@type Function
	@author Squad Techfin
	@since 30/04/2026
	@version 1.0
/*/
Function alertaBaixa() As Logical
	Local aAreaFK7       := {}  As Array
	Local aAreaARP       := {}  As Array
	Local cChaveTitulo   := ""  As Character
	Local cIdDoc         := ""  As Character
	Local lConfirmaBaixa := .T. As Logical
	Local oTechfinDialog := NIl As Object

	If FwAliasInDic("ARP", .F.) .And. totvs.protheus.backoffice.techfin.util.IsActive("5", .F.)
		aAreaFK7     := FK7->(FwGetArea())
		cChaveTitulo := SE1->(E1_FILIAL + E1_PREFIXO + E1_NUM + E1_PARCELA + E1_TIPO + E1_CLIENTE + E1_LOJA)
		
		FK7->(dbSetOrder(3)) //FK7_FILIAL+FK7_ALIAS+FK7_FILTIT+FK7_PREFIX+FK7_NUM+FK7_PARCEL+FK7_TIPO+FK7_CLIFOR+FK7_LOJA
		If FK7->( dbSeek(FWxFilial("FK7") + "SE1" + cChaveTitulo) )
			cIdDoc   := FK7->FK7_IDDOC
			aAreaARP := ARP->(FwGetArea())
		
			ARP->(dbSetOrder(1))
			If ARP->( dbSeek(FWxFilial("ARP") + cIdDoc) )
				oTechfinDialog := totvs.protheus.backoffice.techfin.util.TechfinDialog():new()
				oTechfinDialog:setTitle(STR0001) //"Confirmar baixa do título?"
				oTechfinDialog:setText(10, 10, STR0002) //"Esta ação atualiza a situação do título junto à escrituradora."
				oTechfinDialog:setText(30, 10, "Titulo: " + SE1->E1_PREFIXO + SE1->E1_NUM + " - Parcela: " + SE1->E1_PARCELA + " escriturado em " + DTOC(ARP->ARP_DATA) )
				oTechfinDialog:setText(50, 10, STR0003) //"Importante: O registro enviado é definitivo. Mesmo que você reverta a baixa no sistema, não será possível desfazer a ação ou retornar o título ao valor original na escrituradora."
				
				lConfirmaBaixa := oTechfinDialog:openConfirm(130, 180)
			EndIf

			FwRestArea(aAreaARP)
			FwFreeArray(aAreaARP)
		EndIf

		FwRestArea(aAreaFK7)
		FwFreeArray(aAreaFK7)
	EndIf

Return lConfirmaBaixa

/*/{Protheus.doc} deParaFormaRec
	Função para fazer o de/para de forma de recebimento entre Protheus e Techfin.

	@param cFormaRecebimentoProt, Forma de recebimento do Protheus.
	@return cFormaRecebimentoTF, Forma de recebimento da Techfin.

	@type Function
	@author Squad Techfin
	@since 30/04/2026
	@version 1.0
/*/
Function deParaFormaRec(cFormaRecebimentoProt As Character) As Character
	Local cFormaRecebimentoTF := "" As Character

	If cFormaRecebimentoProt $ "PX|PE"
		cFormaRecebimentoTF := "PPIX"
	ElseIf cFormaRecebimentoProt == "BOL"
		cFormaRecebimentoTF := "BLTO"
	Else
		cFormaRecebimentoTF := "TRCR"
	EndIf

Return cFormaRecebimentoTF
