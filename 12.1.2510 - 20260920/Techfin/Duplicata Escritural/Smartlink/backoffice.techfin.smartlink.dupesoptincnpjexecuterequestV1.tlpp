#include "tlpp-core.th"
#include "totvs.ch"

namespace totvs.protheus.backoffice.techfin.smartlink.DupesOptInCnpjExecuteRequestV1
using namespace totvs.protheus.backoffice.techfin.duplicataescritural.config.dados
using namespace totvs.protheus.backoffice.techfin.util

/*/{Protheus.doc} DupesOptInCnpjExecuteRequestV1    
    Classe de Integração Duplicata Escritural
    Envia a Lista de financiadores confiáveis
    @type class
    @author Squad TechFin
    @since 26/06/2026
/*/
class DupesOptInCnpjExecuteRequestV1
    public method new() constructor
    public method send()
end class

/*/{Protheus.doc} DupesOptInCnpjExecuteRequestV1::New
    Método construtor da classe
    @type method
    @author Squad TechFin
    @since 3/28/2026
    
/*/
method new() class DupesOptInCnpjExecuteRequestV1
return Self

/*/{Protheus.doc} send
    Método responsável por enviar a mensagem 
    @type method
    @author Squad TechFin
    @since 10/04/2026
    @version 1.0
    @return lSuccess, logical, Indica se o envio foi bem sucedido
    /*/
Method send() class DupesOptInCnpjExecuteRequestV1
    local nX         := 0                                                           as numeric
    local oSmartUtil := Nil                                                         as object
    local cFila      := "DupesOptInCnpjExecuteRequestV1"                            as character
	local cCnpj      := FwSM0Util():GetSM0Data(cEmpAnt, cFilAnt, {"M0_CGC"})[1][2]  as character
    local jData      := jsonObject():new()                                          as json
    local jLote      := jsonObject():new()                                          as json    
    local jConfig    := JsonObject():new()                                          as json    

    jConfig:fromJson(getDefault())
    If jConfig["built"]             
        jData["respondTo"]       := "DupesOptInCnpjExecuteResponseV1"
        jData["cnpjSolicitante"] := cCnpj
        jData["lote"]            := {}
        
        jLote["documento_sacador"]          := cCnpj
        jLote["autoriza_todos"]             := .T.
        jLote["financiadores_especificos"]  := {}
        For nX := 1 to Len(jConfig["optInList"]) 
            If !Empty(jConfig["optInList"][nX]["cnpj"])
                aAdd(jLote["financiadores_especificos"], jConfig["optInList"][nX]["cnpj"])
            EndIF
        Next nX
        aAdd(jData["lote"], jLote)

        If Len(jLote["financiadores_especificos"]) > 0
            oSmartUtil := SmartlinkUtil():new()
            oSmartUtil:send(cFila, jData:toJson(), .T., , .T.)
            FwFreeObj(oSmartUtil)
        EndIf
    EndIF
    
	FwFreeObj(jData)
    FwFreeObj(jLote)
    FwFreeObj(jConfig)
Return
