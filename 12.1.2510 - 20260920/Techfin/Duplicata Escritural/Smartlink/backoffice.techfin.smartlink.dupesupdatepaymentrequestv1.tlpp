#Include "tlpp-core.th"
#Include "totvs.ch"

NAMESPACE totvs.protheus.backoffice.techfin.smartlink.dupesupdatepaymentrequest
USING NAMESPACE totvs.protheus.backoffice.techfin.util

Static __oSeqPix as object


//--------------------------------------------------------------------------------------------------
/*/{Protheus.doc} atualizaDadosPgto
	
	@type function
	@author Squad TechFin
	@since 10/04/2025
	@param nPaymentType, numeric, define o tipo de recebimento a ser registrado (1=Boleto, 2=Pix)
	@param cChaveFK7, character, FK7_IDDOC
	@param cTipoAtualizacao, character, tipo de atualizacao ('A' = Atualização, 'C' = Cancelamento)
	
/*/
//--------------------------------------------------------------------------------------------------
Function atualizaDadosPgto( nPaymentType as numeric, cChaveFK7 as character, cTipoAtualizacao as character, cCodBar as character )
	local oUpdData 			as object
	local aArea 	:= {} 	as array

	default cChaveFK7 := ''
	default cTipoAtualizacao := ''
	default cCodBar := ''
	aArea := FwGetArea()

	ARP->(dbSetOrder(1))
	If ARP->(msSeek(FwxFilial('ARP')+cChaveFK7)) .And. ARP->ARP_STATUS $ '2;4'//1=Processando;2=Escriturado;3=Baixado;4=Baixa Parcial;5=Erro;6=Cancelado
		oUpdData := DupesUpdatePaymentRequestV1():New()
		oUpdData:setPaymentType( nPaymentType )
		oUpdData:setIdFK7(cChaveFK7)
		If nPaymentType == 1 //Boleto
			oUpdData:setCodBar(cCodBar)
		EndIF
		If !Empty(cTipoAtualizacao)
			oUpdData:setTipoAtualizacao(cTipoAtualizacao)
		EndIF
		oUpdData:sendBankData()
		FwFreeObj(oUpdData)
	EndIF

	FwRestArea(aArea)
	FwFreeArray(aArea)
Return


//----------------------------------------------------------------------
/*/{Protheus.doc} DupesUpdatePaymentRequestV1	
	Requisição de atualização de dados de cobrança
	@type class
	@author Squad TechFin
	@since 10/04/2025
/*/
//----------------------------------------------------------------------
	class DupesUpdatePaymentRequestV1
		data cIdTitulo		as character
		data cCodBar		as character
		data nPaymentType	as numeric
		data cTipoAtualizacao	as character

		public method new() constructor
		public method sendBankData()
		public method setIdFK7()
		public method setCodBar()
		public method setPaymentType()
		public method setTipoAtualizacao()
	end class

//----------------------------------------------------------------------
/*/{Protheus.doc} DupesUpdatePaymentRequestV1::New
	Método construtor da classe
	@type method
	@author Squad TechFin
	@since 10/04/2025
/*/
//----------------------------------------------------------------------
method New() class DupesUpdatePaymentRequestV1
	::cIdTitulo		:= ''
	::cCodBar		:= ''
	::nPaymentType	:= 1
	::cTipoAtualizacao := "ASIP"
return Self

//----------------------------------------------------------------------
/*/{Protheus.doc} DupesUpdatePaymentRequestV1::setIdFK7
    FK7_IDDOC a ser processado
    @type method
    @author Squad TechFin
    @since  02/04/2026
	@param cIdFK7, character, FK7_IDDOC do título a ser verificado
/*/
//----------------------------------------------------------------------
Method setIdFK7(cIdFK7 as character) class DupesUpdatePaymentRequestV1
	::cIdTitulo := cIdFK7
Return

//----------------------------------------------------------------------
/*/{Protheus.doc} DupesUpdatePaymentRequestV1::setCodBar
    Codigo de Barra do boleto
    @type method
    @author Squad TechFin
    @since  02/04/2026
	@param cCodBar, character, Código de barras do boleto
/*/
//----------------------------------------------------------------------
Method setCodBar(cCodBar as character) class DupesUpdatePaymentRequestV1
	::cCodBar := cCodBar
Return

//----------------------------------------------------------------------
/*/{Protheus.doc} DupesUpdatePaymentRequestV1::setPaymentType
    Tipo de recebimento a ser registrado (1=Boleto, 2=Pix)
    @type method
    @author Squad TechFin
    @since  02/04/2026
	@param nPaymentType, numeric, Tipo de recebimento a ser registrado
/*/
//----------------------------------------------------------------------
Method setPaymentType(nPaymentType as numeric) class DupesUpdatePaymentRequestV1
	::nPaymentType := nPaymentType
Return

//----------------------------------------------------------------------
/*/{Protheus.doc} DupesUpdatePaymentRequestV1::setTipoAtualizacao
    Define o tipo de atualizacao a ser enviado ao SmartLink
    @type method
    @author Squad TechFin
    @since  06/05/2026
	@param cTipoAtualizacao, character, Tipo de atualização a ser enviado
/*/
//----------------------------------------------------------------------
Method setTipoAtualizacao(cTipoAtualizacao as character) class DupesUpdatePaymentRequestV1
	If cTipoAtualizacao == "C"
		::cTipoAtualizacao := "CNIP"
	ElseIf cTipoAtualizacao == "A"
		::cTipoAtualizacao := "ASIP"
	Endif
Return

//----------------------------------------------------------------------
/*/{Protheus.doc} DupesUpdatePaymentRequestV1::sendBankData    
    @type method
    @author Squad TechFin
    @since  02/04/2026
/*/
//----------------------------------------------------------------------
Method sendBankData() class DupesUpdatePaymentRequestV1

	local oSmartUtil 							        as object
	local oOcurrences    := TechfinOccurrences():new()  as object
	local cSeqPix		 := '' 					        as character
	local aTpChave 		 := {}					        as array
	local nPos			 := 0					        as numeric
	local jUpdate 		 := JsonObject():New()          as json
	local jTpInstrumento := JsonObject():New()          as json
	local cOcurrence 	 := "023"						as character
	local aAreaF71		 := {}							as array

	Aadd(aTpChave,{'01','CLLR'})//Telefone
	Aadd(aTpChave,{'02','EMAI'})//E-mail
	Aadd(aTpChave,{'03','CNPJ'})//CPF/CNPJ
	Aadd(aTpChave,{'04','CHAL'})//Chave Aleatória

	jUpdate["cnpjSolicitante"]	:= FwSM0Util():GetSM0Data(cEmpAnt, cFilAnt, {"M0_CGC"})[1][2]
	jUpdate["respondTo"]		:= "DupesUpdatePaymentResponseV1"
	jUpdate["tipo_atualizacao"] := ::cTipoAtualizacao

	jUpdate["dados_pagamento"] := {}
	Aadd(jUpdate["dados_pagamento"], JsonObject():New() )
	jUpdate["dados_pagamento"][1]["erpInstallmentId"] := ::cIdTitulo

	If ::nPaymentType == 1 //-- Boleto
		jTpInstrumento["tipo_instrumento"] := "BLTO"
		jTpInstrumento["instrumento"] := JsonObject():New()
		jTpInstrumento["instrumento"]["tipo_boleto"] 	:= "BLTS"
		jTpInstrumento["instrumento"]["codigo_barras"] 	:= ::cCodBar
		jTpInstrumento["instrumento"]["compe"] 			:= Substr(::cCodBar,1,3)
	Else//-- Pix
		If PixStatus(FWxFilial('F71'), ::cIdTitulo) $ "1;2;3;4;7"
			cSeqPix := GetSeqPix(::cIdTitulo)

			aAreaF71 := GetArea()
			dbSelectArea('F71')
			dbSetOrder(1)
			msSeek(FWxFilial("F71") + ::cIdTitulo + cSeqPix)
			If !Empty(F71_TPCHV) .And. !Empty(F71_CHVPIX)
				nPos := AScan(aTpChave, {|x| x[1] == F71_TPCHV})
				If nPos > 0
					jTpInstrumento["tipo_instrumento"] := "PPIX"
					jTpInstrumento["instrumento"] := JsonObject():New()
					jTpInstrumento["instrumento"]["tipo_chave_pix"] := aTpChave[nPos,2]
					jTpInstrumento["instrumento"]["chave_pix"] 		:= Alltrim(F71_CHVPIX)
					jTpInstrumento["instrumento"]["codigo_pix_copia_e_cola"] := Alltrim(F71_EMVPIX)//F71_EMVPIX pde ser vazia
				EndIF
			EndIF
			
			FwRestArea(aAreaF71)   
			FwFreeArray(aAreaF71)  
		EndIf
EndIf

	jUpdate["dados_pagamento"][1]["informacoes_pagamento"] := jTpInstrumento

	//-- Envia via smartlink
	oSmartUtil := SmartLinkUtil():new()
	If oSmartUtil:send('DupesUpdatePaymentRequestV1', jUpdate:ToJson(), .T./*lReqID*/, ''/*cReqKey*/, .F./*lHelp*/)
		cOcurrence := '022' //"Alteração dos dados de pagamentos efetuada."
	EndIf
	oOcurrences:setProduct('5') //Duplicata escritural
	oOcurrences:setIdDoc(::cIdTitulo)
	oOcurrences:register(cOcurrence) //Registro de dados de pagamento enviado com sucesso

	FwFreeObj(jUpdate)
	FwFreeObj(jTpInstrumento)
	FwFreeObj(oSmartUtil)
Return

//----------------------------------------------------------------------
/*/{Protheus.doc} GetSeqPix
	Pega identificação do ultimo registro do PIX
	@type function
	@author Squad TechFin
	@since 10/04/2025
	@param cIdTitulo, character, FK7_IDDOC do título a ser verificado
	@return cSeq, character, sequência do PIX
/*/
//----------------------------------------------------------------------
Static Function GetSeqPix(cIdTitulo as character) as character

	local cSeq := '' as character
	local cQuery := '' as character
	local nTamSeq := 0 as numeric

	nTamSeq := TamSX3("F71_SEQ")[1]

	If __oSeqPix == NIL
		cQuery := "SELECT MAX(F71_SEQ) MAXSEQ "
		cQuery += "FROM " + RetSqlName("F71") + " F71 "
		cQuery += "WHERE F71.F71_FILIAL= ? AND "
		cQuery += "F71.F71_IDDOC= ? AND "
		cQuery += "F71.D_E_L_E_T_ = ? "
		cQuery    := ChangeQuery(cQuery)
		__oSeqPix := FWExecStatement():New(cQuery)
	EndIf

	__oSeqPix:SetString(1, FWxFilial("F71"))
	__oSeqPix:SetString(2, cIdTitulo)
	__oSeqPix:SetString(3, " ")
	cSeq := Left(__oSeqPix:execScalar("MAXSEQ"), nTamSeq)

Return cSeq
