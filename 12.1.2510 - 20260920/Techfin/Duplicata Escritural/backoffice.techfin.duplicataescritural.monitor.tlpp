#include 'tlpp-core.th'
#include "totvs.ch"
#include 'FwMvcDef.ch'
#include 'backoffice.techfin.duplicataescritural.monitor.ch'

NAMESPACE totvs.protheus.backoffice.techfin.duplicataescritural.monitor
USING NAMESPACE totvs.protheus.backoffice.techfin.util
USING NAMESPACE totvs.protheus.backoffice.techfin.smartlink.DupeslockunlockrequestV1
USING NAMESPACE totvs.protheus.backoffice.techfin.smartlink.dupescancelexecuterequest

Static __oExecGrid as object

/*/{Protheus.doc} duplicatasMonitor
Gestão de Duplicata Escritural

@type       Function
@author     @author Squad TechFin
@since      13/03/2025
@version    P12.1.2510
/*/
Function duplicatasMonitor() as Object
    Local oBrowse as Object
    oBrowse := FWLoadBrw("totvs.protheus.backoffice.techfin.duplicataescritural.monitor.duplicatasMonitor")

Return oBrowse

/*/{Protheus.doc} BrowseDef
    Definição do browse
    
    @type Function
    @author Squad TechFin
    @since 13/03/2025
    @version 1.0
/*/
Function BrowseDef() as object
    local oBrowse   as object    

    oBrowse := FWmBrowse():New()
    oBrowse:SetAlias( 'ARP' )
    oBrowse:SetDescription( STR0001 )    //"Gestão de duplicata escritural"
    oBrowse:SetMainProc("FINA740")
    oBrowse:SetMenuDef( 'totvs.protheus.backoffice.techfin.duplicataescritural.monitor.duplicatasMonitor' )        
    oBrowse:AddLegend("ARP_STATUS=='1'","WHITE" , STR0002)//'Processando'
    oBrowse:AddLegend("ARP_STATUS=='2'","GREEN" , STR0003)//'Escriturado'
    oBrowse:AddLegend("ARP_STATUS=='3'","BLUE"  , STR0004)//'Baixado'
    oBrowse:AddLegend("ARP_STATUS=='4'","YELLOW", STR0005)//'Baixa Parcial'
    oBrowse:AddLegend("ARP_STATUS=='5'","RED"   , STR0006)//'Erro'
    oBrowse:AddLegend("ARP_STATUS=='6'","GRAY"  , STR0007)//'Cancelado'
    
    oBrowse:Activate()

Return oBrowse

/*/{Protheus.doc} MenuDef
    Definição do menu
    
    @type Function
    @author Squad TechFin
    @since 13/03/2025
    @version 1.0

/*/
Function MenuDef() as Array
    Local aRotina := {} as Array

    ADD OPTION aRotina TITLE STR0008 ACTION "totvs.protheus.backoffice.techfin.duplicataescritural.escrituracao.escriturar()"  OPERATION 3 ACCESS 0  //-- "Escriturar títulos"
    ADD OPTION aRotina TITLE STR0012 Action "VIEWDEF.totvs.protheus.backoffice.techfin.duplicataescritural.monitor.duplicatasMonitor" OPERATION 2 ACCESS 0//'Visualizar'
    ADD OPTION aRotina TITLE STR0009 ACTION "totvs.protheus.backoffice.techfin.duplicataescritural.monitor.loadLockUnlock()" OPERATION  4 ACCESS 0  //-- "Bloqueio/Desbloqueio"
    ADD OPTION aRotina TITLE STR0010 ACTION "totvs.protheus.backoffice.techfin.duplicataescritural.monitor.loadCancelDup()" OPERATION  4 ACCESS 0  //-- "Cancelar escrituração"    

Return aRotina

/*/{Protheus.doc} ModelDef
    Definição do model
    
    @type Function
    @author Squad TechFin
    @since 13/03/2025
    @version version    
/*/
Function ModelDef() as Object
    Local oModel                                as Object
    Local oStruARP  := FWFormStruct( 1, 'ARP')  as Object
    Local oStruARQ  := FWFormStruct( 1, 'ARQ')  as Object

    oModel := MPFormModel():New( 'duplicatasMonitor', /*bPreValidacao*/, /*bPosValidacao*/, /*bCommit*/, /*bCancel*/ )    

    oModel:AddFields( 'ARPMASTER', /*cOwner*/, oStruARP)    
    oModel:AddGrid( 'ARQDETAIL', 'ARPMASTER', oStruARQ, /*bLinePre*/, /*bLinePost*/, /*bPreVal*/, /*bPosVal*/, {|oModel| loadGrid(oModel)} )
    oModel:SetDescription( STR0013 )//'Detalhe da duplicata escritural'
    oModel:GetModel( 'ARQDETAIL' ):SetDescription( STR0014 )//'Histórico de eventos'
    oModel:SetPrimaryKey({"ARP_IDDOC"})

Return oModel

/*/{Protheus.doc} ViewDef
    Definição da View
    
    @type Function
    @author Squad TechFin
    @since 13/03/2025
    @version 1.0
/*/
Function ViewDef() as Object
    Local oView                                 as Object
    Local oModel                                as Object
    Local oStruARP := FWFormStruct( 2, 'ARP')   as Object
    Local oStruARQ := FWFormStruct( 2, 'ARQ')   as Object

    oModel := FWLoadModel( 'totvs.protheus.backoffice.techfin.duplicataescritural.monitor.duplicatasMonitor' )

    oView := FWFormView():New()
    oView:SetModel( oModel )
     
    oStruARQ:RemoveField('ARQ_PRODTF')
    oView:AddField( 'VIEW_ARP', oStruARP, 'ARPMASTER' )
    oView:AddGrid(  'VIEW_ARQ', oStruARQ, 'ARQDETAIL' )
    oView:SetViewProperty( 'ARQDETAIL', 'GRIDDOUBLECLICK', {{|| dbClickArqLog()}} )
    
    oView:CreateHorizontalBox( 'SUPERIOR', 50 )
    oView:CreateHorizontalBox( 'INFERIOR', 50 )
    oView:SetOwnerView( 'VIEW_ARP', 'SUPERIOR' )
    oView:SetOwnerView( 'VIEW_ARQ', 'INFERIOR' )
    
    oView:EnableTitleView('VIEW_ARQ', STR0014 )//'Histórico de eventos'    
    oView:ShowUpdateMsg(.F.)
    oView:SetCloseOnOk( {|| .T. } )

Return oView

/*/{Protheus.doc} loadGrid
Função para efetuar o load dos dados do grid
 
@author Squad TechFin
@since 13/03/2026
@version 1.0
@param oModel - Objeto do modelo de dados
@return aData - Array com os dados para exibição no grid
/*/
static function loadGrid(oModel)
    local cAlias    := ""                               as character    
    Local cQuery    := ""                               as character    
    local nBind     := 1                                as numeric
    local nLinha    := 0                                as numeric
    local aData     := {}                               as array
    local aStruQry  := {}                               as array
    local aArea     := FwGetArea()                      as array
    Local oModelCab	:= oModel:GetModel()                as object
    Local oModelGrid:= oModelCab:GetModel("ARQDETAIL")  as object

    if __oExecGrid == Nil
        cQuery := " SELECT ARQ_FILIAL, ARQ_IDDOC, ARQ_DATA, ARQ_HORA,ARQ_ORIGEM, ARQ_DESC, ARQ_LOG,ARQ_IDMOV , R_E_C_N_O_ RECNO"     
        cQuery += " FROM " + RetSqlName("ARQ")
        cQuery += " WHERE ARQ_FILIAL = ? "
        cQuery += " And ARQ_IDDOC = ? "
        cQuery += " And ARQ_PRODTF = ? "
        cQuery += " And D_E_L_E_T_= ? "
        cQuery += " ORDER BY ARQ_DATA DESC, ARQ_HORA DESC"
        
        __oExecGrid := FwExecStatement():New(cQuery)
    EndIf
    
    __oExecGrid:SetString(nBind++, FwxFilial("ARQ"))
    __oExecGrid:SetString(nBind++, ARP->ARP_IDDOC)
    __oExecGrid:SetString(nBind++, "5")
    __oExecGrid:SetString(nBind++, " ")
    
    cAlias := __oExecGrid:OpenAlias()

	aStruQry := (cAlias)->(DbStruct())	
	For nLinha := 1 To Len(aStruQry)		
	   	If GetSX3Cache(aStruQry[nLinha][1],"X3_TIPO") == "D" .Or. GetSX3Cache(aStruQry[nLinha][1],"X3_TIPO") == "N"
	        TCSetField( cAlias , aStruQry[nLinha][1], GetSX3Cache(aStruQry[nLinha][1],"X3_TIPO"), GetSX3Cache(aStruQry[nLinha][1],"X3_TAMANHO") , GetSX3Cache(aStruQry[nLinha][1],"X3_DECIMAL"))
	    Endif		
	Next nLinha	

    aData := FwLoadByAlias(oModelGrid, cAlias, 'ARQ', "RECNO",,.T.)

    (cAlias)->(DBCloseArea())
    FwRestArea(aArea)

Return aData

/*/{Protheus.doc} loadLockUnlock
    Envia solicitação de bloqueio ou desbloqueio.

    @type  Function
    @author Squad TechFin
    @since 08/04/2026
    @version 1.0

    @param lAuto,  logical, indica se a execução e automatica ou nao
    @param nRecno, numeric, numero do registro 
    @return lSuccess - Retorna verdadeiro se a solicitação foi enviada com sucesso, caso contrário retorna falso.
/*/
Function loadLockUnlock(lAuto as Logical,nRecno as Numeric) as Logical
    local cStatus      := ""                            as character
    local cTpLockUnLock:= ""                            as character
    local cIdDoc       := ""                            as character
    local cMsgTitle1   := ""                            as character
    local cMsgTitle2   := ""                            as character
    local cMsgText1    := ""                            as character
    local cMsgText2    := ""                            as character
    local cMsgTipo     := "Invalido"                    as character
    local cOcurrences  := ""                            as character
    local nPosStatus   := 0                             as numeric
    local nOpcao       := 0                             as numeric
    local lSuccess     := .F.                           as logical
    local aStatus      := {{"1", "BLOQ"},{"2", "DESB"}} as array
    local aAreaARP     := ARP->(GetArea())              as array
    local oModal       := TechfinDialog():new()         as object
    local oModalOk     := TechfinDialog():new()         as object
    local oLockUnLock  := Nil                           as object
    
    DEFAULT lAuto  := .F.   
    DEFAULT nRecno := 0

    If lAuto .And. nRecno > 0
        ARP->(DbGoTo(nRecno))
        nOpcao := 1
    EndIf
    
    cStatus      := ARP->ARP_STATUS
    cTpLockUnLock:= ARP->ARP_SITUAC
    cIdDoc       := ARP->ARP_IDDOC 
    
    cMsgTitle1:= STR0024 //"Solicitar "
    cMsgTitle2:= STR0025 //" do título para negociação"
    cMsgText1 := STR0026 //"Ao confirmar, será enviada uma solicitação de "
    cMsgText2 := STR0027 //" do título para uso em operações financeiras. Deseja continuar?"

    If cTpLockUnLock == "1"
        cTpLockUnLock := "2" // 2=Desbloqueado
        cMsgTipo      := "desbloqueio"
        cOcurrences   := "005" //Solicitado desbloqueio na escrituradora
    ElseIf cTpLockUnLock == "2"
        cTpLockUnLock := "1" // 1=Bloqueado
        cMsgTipo      := "bloqueio"
        cOcurrences   := "004" //Solicitado bloqueio na escrituradora
    EndIf

    oModal:setTitle(cMsgTitle1 + cMsgTipo + cMsgTitle2) 
    oModal:setSubTitle("")
    oModal:setText(20, 10,  cMsgText1 + cMsgTipo + cMsgText2)
    oModal:setButton(STR0029 + cMsgTipo, {|| nOpcao := 1, oModal:DeActivate() }) //"Solicitar "
    oModal:setButton(STR0028, {|| nOpcao := 0,oModal:DeActivate() }) //"Cancelar" 
    oModal:openInfo(100, 250)
    
    nPosStatus := aScan(aStatus, {|a| a[1] == cTpLockUnLock})

    If nPosStatus > 0 .And. nOpcao == 1 .And. cStatus $ "2|4"
        oLockUnLock := DupesLockUnlockRequestV1():new()
        oLockUnLock:setProduct("5") //Produto 5 = Duplicata escritural
        oLockUnLock:setIdDoc(cIdDoc)
        oLockUnLock:setOcurrences(cOcurrences)
        oLockUnLock:setStatus(aStatus[nPosStatus][2])
        if (lSuccess := oLockUnLock:send())
            oModalOk:setTitle("") 
            oModalOk:setSubTitle("")
            oModalOk:setText(20, 10, STR0030) //"Você pode acompanhar sua solicitação para este título em Getão de duplicata escritural > Visualizar."
            oModalOk:setButton(STR0031, {|| oModalOk:DeActivate() }) //"Fechar"
            oModalOk:openInfo(100, 250)
        EndIf
    EndIf

    FwRestArea(aAreaARP)
    FwFreeArray(aAreaARP)
    FwFreeArray(aStatus)
    FwFreeObj(oModal)
    FwFreeObj(oModalOk)
    FWFreeObj(oLockUnLock)
    
Return lSuccess

/*/{Protheus.doc} loadCancelDup
    Envia solicitação de cancelamento da escrituração

    @type  Function
    @author Squad TechFin
    @since 08/04/2026
    @version 1.0

    @param lAuto,  logical, indica se a execução e automatica ou nao
    @param nRecno, numeric, numero do registro 
    @return lSuccess - Retorna verdadeiro se a solicitação foi enviada com sucesso, caso contrário retorna falso.
/*/
Function loadCancelDup(lAuto as Logical,nRecno as Numeric) as Logical
    local nOpcao       := 0                             as numeric
    local lSuccess     := .F.                           as logical
    local cMsgText     := ""                            as character
    local aAreaARP     := ARP->(GetArea())              as array
    local oModal       := TechfinDialog():new()         as object
    local oModalOk     := TechfinDialog():new()         as object
    local oCancel      := Nil                           as object
    
    DEFAULT lAuto  := .F.   
    DEFAULT nRecno := 0

    If lAuto .And. nRecno > 0// Trecho para automação, igual foi feito no loadLockUnlock()
        ARP->(DbGoTo(nRecno))
        nOpcao := 1
    EndIf
           
    If !(ARP->ARP_STATUS $ "2|4")
        oModal:setTitle(STR0032) //"Solicitar cancelamento da escrituração" 
        oModal:setSubTitle("")
        oModal:setText(20, 10,  STR0033) //'Status do título não permite cancelamento.'
        oModal:setButton(STR0034, {|| oModal:DeActivate() }) //'Ok, entendi.'
        oModal:openInfo(100, 250)
    Else

        cMsgText := STR0035 //'Ao confirmar, será enviada uma solicitação para cancelar a escrituração do título na registradora. '
        cMsgText += STR0036 //"O título permanece ativo no Contas a Receber e continuará sendo cobrado normalmente. Deseja continuar?"    

        oModal:setTitle(STR0032) //"Solicitar cancelamento da escrituração"
        oModal:setSubTitle("")
        oModal:setText(20, 10,  cMsgText)
        oModal:setButton(STR0037, {|| nOpcao := 1, oModal:DeActivate() }) //"Solicitar cancelamento"
        oModal:setButton(STR0028, {|| oModal:DeActivate() }) //'Cancelar'
        oModal:openInfo(100, 250)
    
        If nOpcao == 1 .And. ARP->ARP_STATUS $ "2|4"
            
            oCancel := DupesCancelExecuteRequest():New()
            oCancel:setIdFK7( ARP->ARP_IDDOC )		
            oCancel:SetMsgToFront( .T. )

            if (lSuccess := oCancel:sendCanc())
                oModalOk:setTitle(STR0038) //"Solicitação de cancelamento enviada!"  
                oModalOk:setSubTitle("")
                oModalOk:setText(20, 10, STR0030) //"Você pode acompanhar sua solicitação para este título em Gestão de duplicata escritural > Visualizar."
                oModalOk:setButton(STR0031, {|| oModalOk:DeActivate() }) //"Fechar"
                oModalOk:openInfo(100, 250)
            EndIf
        EndIf
    EndIF

    FwRestArea(aAreaARP)
    FwFreeArray(aAreaARP)
    FwFreeObj(oModal)
    FwFreeObj(oModalOk)
    FWFreeObj(oCancel)
    
Return lSuccess

/*/{Protheus.doc} dbClickArqLog
Apresenta o conteudo do ARQ_LOG da ocorrencia selecionada.

@type  Function
@author Squad TechFin
@since 17/06/2026
@version 1.0
@return lSuccess - Retorna verdadeiro apos abrir o detalhe da ocorrencia.
/*/
static function dbClickArqLog()
    local cLog   := ""                as character
    local cTime  := ""                as character
    local oModal := nil               as object
    local oModel := FWModelActive()   as object

    cLog := oModel:GetValue( "ARQDETAIL", "ARQ_LOG" )
    If !Empty(cLog)
        cTime  := DToC(oModel:GetValue("ARQDETAIL","ARQ_DATA")) + ' - ' + oModel:GetValue("ARQDETAIL","ARQ_HORA")
        oModal := TechfinDialog():new()
        oModal:setTitle(STR0039 + cTime) //Histórico do Evento recebido em
        oModal:setText(20, 10, STR0040 + CRLF + cLog) //Log do evento:
        oModal:setButton( STR0031 , {|| oModal:DeActivate() } ) //Fechar
        oModal:openInfo()
    EndIf

Return .T.
