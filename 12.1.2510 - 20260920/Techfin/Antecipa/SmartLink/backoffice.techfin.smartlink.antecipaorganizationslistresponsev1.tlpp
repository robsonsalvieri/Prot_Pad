#include "tlpp-core.th"
#include "TBICONN.ch"

/*/{Protheus.doc} AntecipaOrganizationsListResponseV1MessageReader
	Classe de Integração Novo Antecipa
	Atualiza dados das Filiais habilitadas para operar Antecipação.
	@type class
	@author Squad TechFin
	@since 8/15/2025
/*/
class AntecipaOrganizationsListResponseV1MessageReader
	data aDataOrgs as array
	data jMSGData  as json
	data jMessage  as json
	data cMock     as character
	data lMock     as logical

	public method new() constructor
	public method read()
	public method mock()
	method formatOrg()
	method procOrgs()
end class

/*/{Protheus.doc} AntecipaOrganizationsListResponseV1MessageReader::New
	Método construtor da classe
	@type method
	@author Squad TechFin
	@since 8/15/2025
/*/
method New() class AntecipaOrganizationsListResponseV1MessageReader
	::aDataOrgs := {}
	::jMSGData  := JsonObject():new()
	::jMessage  := JsonObject():new()
	::cMock     := ""
	::lMock     := .F.
return Self

/*/{Protheus.doc} AntecipaOrganizationsListResponseV1MessageReader::mock
	Método para mockar a mensagem recebida para testes
	@type method
	@author Squad TechFin
	@since 9/11/2025
	@param cData, character, dados da mensagem a ser mockada
/*/
method mock(cData as character) class AntecipaOrganizationsListResponseV1MessageReader
	::cMock := cData
	::lMock := .T.
return

/*/{Protheus.doc} AntecipaOrganizationsListResponseV1MessageReader::read
	esponsável pela leitura e processamento da mensagem.
	@type method
	@author Squad TechFin
	@since 8/15/2025
	@param oLinkMessage, object, Instância de FwTotvsLinkMesage da mensagem
	@return logical, sucesso ou falha. Determina se deve ou não retirar a mensagem da fila.
/*/
method read(oLinkMessage as object) class AntecipaOrganizationsListResponseV1MessageReader
	local lSuccess  := .F. as logical
	local cPayload  := ""  as character
	local cDecoded  := ""  as character

	cPayload := if(::lMock, ::cMock,  oLinkMessage:RawMessage())
	cDecoded := DecodeUTF8(cPayload)
	
	if !Empty(cDecoded)
		cPayload := cDecoded
	endIf
	if ::jMessage:FromJSON(cPayload) == NIL
		::jMSGData  := ::jMessage["data"]
		::formatOrg()
		::procOrgs()
		lSuccess := .T.
	endIf
    FwFreeObj(::jMSGData)
	FwFreeObj(::jMessage)

Return lSuccess // .T. apaga a mensagem da fila do smartlink

/*/{Protheus.doc} AntecipaOrganizationsListResponseV1MessageReader::formatOrg
	Obtem as filiais e status da mensagem de resposta do Smartlink Antecipa e agrupa por Grupo de Empresa.
	@type method
	@author Squad TechFin
	@since 8/12/2025
/*/
method formatOrg() class AntecipaOrganizationsListResponseV1MessageReader
	local aSM0         := FWLoadSM0()        as array
	local nOrg         := 0                  as numeric
	local nPosFil      := 0                  as numeric
	local cBranchCNPJ  := ""                 as character
	local cStatus      := ""                 as character
	local jOrgData     := nil                as jSon
	local jTextMessage := JsonObject():new() as jSon

	if ::jMSGData:hasProperty('issuers')
		for nOrg := 1 to len(::jMSGData["issuers"])

			cBranchCNPJ  := ::jMSGData["issuers"][nOrg]["documentNumber"]
			cStatus      := cValtoChar(::jMSGData["issuers"][nOrg]["issuerStatus"])
			cFormatedMsg := ""

			If ::jMSGData:hasProperty("formattedParametersText")
				jTextMessage["message"] := ::jMSGData["formattedParametersText"]
			EndIf

			if (nPosFil := AScan(aSM0, { |x| x[18] $ cBranchCNPJ})) > 0
				jOrgData := JsonObject():new()
				jOrgData["ARA_GRPSM0"] := aSM0[nPosFil][1]
				jOrgData["ARA_FILSM0"] := aSM0[nPosFil][2]
				jOrgData["ARA_NOMFIL"] := aSM0[nPosFil][7]
				jOrgData["ARA_CNPJ"]   := cBranchCNPJ
				jOrgData["ARA_STATUS"] := cStatus
				//limites
				jOrgData["ARA_LGLOB" ] := ::jMSGData["limits"]["totalCoobligationLimit"]             // Limite Global do parceiro
				jOrgData["ARA_LTOTAL"] := ::jMSGData["limits"]["totalCoobligationLimit"]             // Lim. Total
				jOrgData["ARA_LDISP" ] := ::jMSGData["limits"]["availableCoobligationLimit"]         // Limite Disponível
				jOrgData["ARA_LUTIL" ] := ::jMSGData["limits"]["usedCoobligationLimit"]              // Limite Utilizado
				jOrgData["ARA_LVPREA"] := ::jMSGData["limits"]["preAuthorizedCoobligationLimit"]     // Limite Pré-Autorizado vigente
				jOrgData["ARA_LRPREA"] := ::jMSGData["limits"]["reservedForBatchProcessingLimit"]    // Limite Pré-Autorizado reservada
				jOrgData["ARA_LSACAD"] := ::jMSGData["limits"]["maxPerCustomerLimit"]                // Limite máximo do sacado
				// taxas
				jOrgData["ARA_TXANT"]  := ::jMSGData["taxes"]["advanceRate"]            // Taxa de Antecipação
				jOrgData["ARA_TXBON"]  := ::jMSGData["taxes"]["creditBonusRate"]        // Taxa de Bonificação
				jOrgData["ARA_TXPROR"] := ::jMSGData["taxes"]["extensionRate"]          // Taxa de Prorrogação
				jOrgData["ARA_TXDEV"]  := ::jMSGData["taxes"]["returnRate"]             // Taxa de Devolução
				jOrgData["ARA_TAC"]    := ::jMSGData["taxes"]["creditOpeningCostValue"] // Taxa abertura de crédito
				jOrgData["ARA_IOFM"]   := ::jMSGData["taxes"]["monthlyIofRate"]         // IOF mensal
				jOrgData["ARA_IOFD"]   := ::jMSGData["taxes"]["dailyIofRate"]           // IOF diário
				//mensagem
				jOrgData["ARA_FTXMSG"] := jTextMessage:ToJson()				            // Mensagem em texto formatado

				AADD(::aDataOrgs, {aSM0[nPosFil][1], aSM0[nPosFil][2], jOrgData:toJSON()}) //Grupo Empresa, Filial, Dados
			endIf
		next nOrg
	endIf
return

/*/{Protheus.doc} AntecipaOrganizationsListResponseV1MessageReader::procOrgs
	Inicia o processamento das organizações obtidas da mensagem de resposta do Smartlink Antecipa.
	@type method
	@author Squad TechFin
	@since 8/12/2025
/*/
method procOrgs() class AntecipaOrganizationsListResponseV1MessageReader
	local nOrg     := 0                   as numeric
	local cPayload := ::jMessage:ToJSON() as character

	for nOrg := 1 to len(::aDataOrgs)
		StartJob("TAOrgList", GetEnvServer(), .T., ;
			::aDataOrgs[nOrg][1] /*cCompany*/, ::aDataOrgs[nOrg][2] /*cBranch*/, ::aDataOrgs[nOrg][3], cPayload)
	next nOrg
return

/*/{Protheus.doc} TAOrgList
	Gravação da tabela ARA-Organization Techfin
	@type function
	@author Squad TechFin
	@since 8/12/2025
	@param cCompany, character, Grupo Empresa
	@param cBranch , character, Filial
	@param jData   , json     , dados da organização
	@param cPayload, character, mensagem recebida
/*/
Function TAOrgList(cCompany as character, cBranch as character, cData as character, cPayload as character)
	local lInsert    := .F.                as logical
	local jData      := JsonObject():new() as json
	local oSmartUtil := nil                as object

	RPCSetType(3)
	RPCSetEnv(cCompany, cBranch,,,'FIN') 
	
	jData:fromJson(cData)
	dbSelectArea('ARA')
	ARA->(dbSetOrder(1))
	lInsert := !ARA->(dbSeek(FWxFilial('ARA') + jData["ARA_CNPJ"] + "1")) //ARA_FILIAL, ARA_CNPJ, ARA_PRODTF
	BEGIN TRANSACTION
		RecLock('ARA', lInsert)
			if lInsert
				ARA->ARA_FILIAL := FWxFilial('ARA')
				ARA->ARA_GRPSM0 := jData["ARA_GRPSM0"]
				ARA->ARA_FILSM0 := jData["ARA_FILSM0"]
				ARA->ARA_NOMFIL := jData["ARA_NOMFIL"]
				ARA->ARA_CNPJ   := jData["ARA_CNPJ"]
			endIf
			ARA->ARA_STATUS := jData["ARA_STATUS"] // 0=Ativo; 1=Bloqueado Credito; 2=Bloqueado Atraso; 3=Cancelado; 4=Bloqueado outros
			ARA->ARA_LGLOB  := jData["ARA_LGLOB"]  // Limite Global do parceiro
			ARA->ARA_LTOTAL := jData["ARA_LTOTAL"] // Lim. Total
			ARA->ARA_LDISP  := jData["ARA_LDISP"]  // Limite Disponível
			ARA->ARA_LUTIL  := jData["ARA_LUTIL"]  // Limite Utilizado
			ARA->ARA_LVPREA := jData["ARA_LVPREA"] // Limite Pré-Autorizado vigente
			ARA->ARA_LRPREA := jData["ARA_LRPREA"] // Limite Pré-Autorizado reservada
			ARA->ARA_LSACAD := jData["ARA_LSACAD"] // Limite máximo do sacado
			ARA->ARA_TXANT  := jData["ARA_TXANT"]  // Taxa de Antecipação
			ARA->ARA_TXBON  := jData["ARA_TXBON"]  // Taxa de Bonificação
			ARA->ARA_TXPROR := jData["ARA_TXPROR"] // Taxa de Prorrogação
			ARA->ARA_TXDEV  := jData["ARA_TXDEV"]  // Taxa de Devolução
			ARA->ARA_TAC    := jData["ARA_TAC"]    // Taxa abertura de crédito
			ARA->ARA_IOFM   := jData["ARA_IOFM"]   // IOF mensal 
			ARA->ARA_IOFD   := jData["ARA_IOFD"]   // IOF diário
			ARA->ARA_FTXMSG := jData["ARA_FTXMSG"] // Mensagem em texto formatado
			ARA->ARA_PRODTF := "1"                 // Produto: Totvs Antecipa
		ARA->(MsUnlock())
	END TRANSACTION

	oSmartUtil := totvs.protheus.backoffice.techfin.util.SmartlinkUtil():new()
	oSmartUtil:setAliasMSUID("ARA")
	oSmartUtil:logResponse(cPayload)
	FwFreeObj(oSmartUtil)
	RpcClearEnv()

Return
