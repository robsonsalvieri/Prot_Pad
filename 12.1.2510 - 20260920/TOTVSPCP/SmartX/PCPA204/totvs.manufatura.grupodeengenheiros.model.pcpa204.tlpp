#include 'fw-tlpp-core.th'
#include "protheus.ch"
#include "totvs.framework.structure.model.th"
#include "totvs.manufatura.grupodeengenheiros.interface.pcpa204.ch"

namespace totvs.manufatura.grupodeengenheiros.model

@totvsFrameworkStructureModel(lookup=.F., country="ALL", description="Grupo de Engenheiros")

/*/{Protheus.doc} PCPA204
Classe PCPA204 responsável por definir o modelo de dados da rotina de Grupo de Engenheiros.

@autor thiago.rover
@since 14/08/2026
/*/
class PCPA204 from totvs.framework.structure.model.data
    public method new() as object
    public method setModel()
EndClass

/*/{Protheus.doc} new
Método construtor da classe PCPA204.

@autor thiago.rover
@since 14/08/2026

@return self, Retorna a instância da classe PCPA204.
/*/
method new() as object class PCPA204
    _Super:new(,,.T.)
Return self

/*/{Protheus.doc} setModel
Método responsável por configurar o modelo de dados da classe PCPA204.

@autor thiago.rover
@since 14/08/2026
/*/
method setModel() class PCPA204
    
    Local oItem as object
    Local oHeader as object

    // Cabeçalho: Mesma tabela SGL, apenas campos selecionados
    oHeader := totvs.framework.structure.object.ObjectFromMetadata():new("SGL",,{"GL_FILIAL", "GL_COD"},,{"GL_ITEM", "GL_USER", "GL_NOME"})
    
    // Itens: Mesma tabela SGL, chave inclui GL_ITEM e GL_USER
    oItem := totvs.framework.structure.object.ObjectFromMetadata():new("SGL",,{"GL_FILIAL", "GL_COD", "GL_ITEM", "GL_USER"})

    // Define cabeçalho como objeto principal; aModel2IncludeFields restringe campos exibidos
    self:setObject(oHeader:getObject(), "SGL",.T.,.T.,,,{"GL_COD", "GL_DESC"})

    // Grid de itens sob alias virtual SGLITEM, vínculo por GL_FILIAL + GL_COD
    self:addArray(oItem:getObject(), "SGLITEM", {"GL_FILIAL","GL_COD"}, {"GL_FILIAL","GL_COD"}, "SGL",, "Lista de Engenheiros", "SGLITEM")

    // Oculta o campo GL_DESC no grid de itens
    self:setProperty("GL_DESC", "hidden"         , .T.              , "SGLITEM")

    // Autoincremento do campo GL_ITEM, com sequência inicial "00" e formato alfanumérico sequencial
    self:setProperty("GL_ITEM", "autoinc"        , .T.              , "SGLITEM")
    self:setProperty("GL_ITEM", "autoincSequence", "00"             , "SGLITEM")
    self:setProperty("GL_ITEM", "format"         , "alphanumericSec", "SGLITEM")
    
    // Desativa TODOS os initializers padrão (X3_RELACAO) do modelo de dados
    self:disableDefaultInitializers()

    // Validação de linha no grid SGLITEM
    self:addLineValidation("SGLITEM","totvs.manufatura.grupodeengenheiros.valids.validLinePos")

    // Inclui o controle de eventos ao modelo
    self:setEvents(totvs.manufatura.grupodeengenheiros.events.pcpa204():new())

return
