#include "totvs.manufatura.grupodeengenheiros.interface.pcpa204.ch"

namespace totvs.manufatura.grupodeengenheiros.events

/*/{Protheus.doc} PCPA204
Classe PCPA204 responsável por definir os eventos da rotina de Grupo de Engenheiros.

@autor thiago.rover
@since 14/08/2026
/*/
Class PCPA204 

    private data cCodSugerido as character
    private data nSaveSX8     as numeric

    public method new() as object

    @beforeCreateInTransaction()
    public method beforeCreateInTransaction(oData as object, oModel as object, oError as object)

    @beforeUpdateInTransaction()
    public method beforeUpdateInTransaction(oData as object, oModel as object, oError as object)
    
    @beforeDeleteInTransaction()
    public method beforeDeleteInTransaction(oData as object, oModel as object, oError as object)

    @afterCreateInTransaction()
    public method afterCreateInTransaction(oData as object, oModel as object, oError as object)

    @afterCreate()
    public method afterCreate(oData as object, oModel as object, oError as object)
    
    @afterUpdate()
    public method afterUpdate(oData as object, oModel as object, oError as object)
    
    @afterDelete()
    public method afterDelete(oData as object, oModel as object, oError as object)

EndClass

/*/{Protheus.doc} new
Método construtor da classe PCPA204

@autor thiago.rover
@since 14/08/2026
@return self, Retorna a instância da classe PCPA204
/*/
Method new() as object class PCPA204
Return self

/*/{Protheus.doc} beforeCreateInTransaction
Evento executado antes da criação dos objetos contidos no modelo em uma transação

@author thiago.rover
@since 17/08/2026

@param01 oData  , object, Objeto contendo os dados do modelo
@param02 oModel , object, Objeto do modelo
@param03 oError , object, Objeto de erro recebido por referência que apresentará a mensagem de erro
@return lRetorno, Retorna: .T. se a operação da criação for permitida
                           .F. se a operação NÃO for permitida
/*/
Method beforeCreateInTransaction(oData as object, oModel as object, oError as object) class PCPA204
    
    Local lRetorno := totvs.manufatura.grupodeengenheiros.valids.validaListaDeEngenheiros(oData, oModel, @oError)
    
    If lRetorno
        // Caso o campo GL_COD esteja vazio, será gerado um código sugerido para o grupo de engenheiros
        If Empty(oData:getFieldValue("SGL", "GL_COD"))
            ::cCodSugerido := GetSXENum("SGL", "GL_COD")
            oData:setFieldValue("SGL", "GL_COD", "", ::cCodSugerido)
        EndIf

        // Ponto de Entrada PCP204VLD que permite validar os dados do modelo antes da criação
        // Substituição ao antigo Ponto de Entrada MT204VLD
        If (ExistBlock("PCP204VLD"))
            lRetorno := ExecBlock("PCP204VLD", .F., .F., {oData:GetData():SGLITEM, .F., oData:getFieldValue("SGL", "GL_COD"), @oError})
        EndIf
    EndIf

Return lRetorno

