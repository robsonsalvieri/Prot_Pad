    If (ExistBlock("PCP204VLD"))
        lRetorno := ExecBlock("PCP204VLD", .F., .F., {oData:GetData():SGLITEM, .F., oData:getFieldValue("SGL", "GL_COD"), @oError})
    EndIf

Return lRetorno

