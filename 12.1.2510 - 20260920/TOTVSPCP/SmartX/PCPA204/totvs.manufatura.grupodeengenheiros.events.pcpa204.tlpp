/*/
Method beforeDeleteInTransaction(oData as object, oModel as object, oError as object) class PCPA204
    
    Local lRetorno := .T.

    // Ponto de Entrada PCP204VLD que permite validar os dados do modelo antes da exclusão
    // Substituição ao antigo Ponto de Entrada MT204VLD
    If (ExistBlock("PCP204VLD"))
        lRetorno := ExecBlock("PCP204VLD", .F., .F., {oData:GetData():SGLITEM, .F., oData:getFieldValue("SGL", "GL_COD"), @oError})
