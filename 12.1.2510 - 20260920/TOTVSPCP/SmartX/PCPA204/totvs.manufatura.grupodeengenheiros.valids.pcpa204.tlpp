#include "protheus.ch"
#include 'fw-tlpp-core.th'
#include "totvs.manufatura.grupodeengenheiros.interface.pcpa204.ch"

namespace totvs.manufatura.grupodeengenheiros.valids

/*/{Protheus.doc} vldDupGrupo
Função responsável por validar e impedir a duplicidade do código (GL_COD) no banco de dados

@author thiago.rover
@since 17/08/2026

@param01 xValue      , any      , Valor preenchido no campo GL_COD
@param02 cField      , character, Nome do campo posicionado
@param03 aContextInfo, array    , [0] = GL_COD da linha atual
@return  jRetorno    , Retorna Json com a propriedade: "return" indicando se o registro é válido (.T.) e "notValidMessage" vazio, OU
                                                        "return" indicando se o registro é inválido (.F.) e "notValidMessage" contendo a mensagem de erro
*/
Function vldDupGrupo(xValue as variant, cField as character, aContextInfo as array)
    
    Local aArea     := GetArea()          as array
    Local cMensagem := ""                 as character
    Local lRetorno  := .T.                as logical

    dbSelectArea("SGL")
    SGL->(dbSetOrder(1))
    If SGL->(DbSeek(xFilial("SGL")+xValue))
        // STR0006 - O código do grupo informado já existe.
        cMensagem := STR0006
        lRetorno  := .F.
    EndIf

    RestArea(aArea)

Return montaRetorno(lRetorno, cMensagem)

/*/{Protheus.doc} vldUsuario
Função responsável por validar o conteúdo do campo usuário (GL_USER) informado

@author thiago.rover
@since 17/08/2026

@param01 xValue      , any      , Valor preenchido no campo GL_USER
@param02 cField      , character, Nome do campo posicionado
@param03 aContextInfo, array    , [0] = GL_USER da linha atual
@return  jRetorno    , Retorna Json com a propriedade: "return" indicando se o registro é válido (.T.) e "notValidMessage" vazio, ou
                                                        "return" indicando se o registro é inválido (.F.) e "notValidMessage" contendo a mensagem de erro
*/
Function vldUsuario(xValue as variant, cField as character, aContextInfo as array)

    Local aArea     := GetArea()          as array
    Local cMensagem := ""                 as character
    Local lRetorno  := .T.                as logical

    // Verifica se o código do usuário informado existe no cadastro de usuários do sistema
    PswOrder(1)
    If !PswSeek(xValue, .T.)
        // STR0007 - O código do usuário informado não existe.
        cMensagem := STR0007
        lRetorno  := .F.
    EndIf
    
    // Verifica se o usuário informado está cadastrado como engenheiro 
    If lRetorno
        dbSelectArea("SGK")
        SGK->(dbSetOrder(2))
        If SGK->(!dbSeek(xFilial("SGK")+xValue))
            // STR0008 - O código do usuário não pode ser utilizado, pois não está cadastrado como engenheiro.
            cMensagem := STR0008
            lRetorno  := .F.
        EndIf
    EndIf
    
    RestArea(aArea)

Return montaRetorno(lRetorno, cMensagem)

/*/{Protheus.doc} validLinPos
Função responsável pela validação de linhas do grid SGLITEM 

@author thiago.rover
@since 18/08/2026

@param01 cIdentifier, character, Identificador do grid
@param02 jFields    , json     , Objeto Json contendo os campos da linha do grid
@return  lRetorno   , logical  , Retorna: .T. se o registro for válido, OU 
                                            .F. se o registro for inválido 
*/
Function validLinePos(cIdentifier as character, jFields as json)

    Local aArea    := GetArea()                                      as array
    Local cCodUser := PadR(jFields["GL_USER"], TamSX3("GL_USER")[1]) as character
    Local lRetorno := .T.                                            as logical

    If cIdentifier == "SGLITEM" .And. Empty(cCodUser)
        // STR0009 - O código do usuário deve ser informado
        Help(,,"HELP",,STR0009,1,0)
        lRetorno := .F.
    EndIf

    RestArea(aArea)

Return lRetorno

/*/{Protheus.doc} validaListaDeEngenheiros
Função responsável por validar a lista de engenheiros contida no modelo

@author thiago.rover
@since 18/09/2026

@param01 oData  , object , Objeto contendo os dados do modelo
@param02 oModel , object , Objeto do modelo
@param03 oError , object , Objeto de erro recebido por referência que apresentará a mensagem de erro
@return lRetorno, logical, Retorno .T. quando NÃO houver duplicidade de engenheiros, OU 
                                   .F. quando houver duplicidade
/*/
Function validaListaDeEngenheiros(oData as object, oModel as object, oError as object)
    
    Local aChaveEng    := {}                      as array
    Local aEngenheiros := oData:GetData():SGLITEM as array
    Local cFilAux      := ""                      as character
    Local cItem        := ""                      as character
    Local cUsuario     := ""                      as character
    Local jLinha       := {}                      as object
    Local lRetorno     := .T.                     as logical
    Local nIndice      := 0                       as numeric

    If ValType(aEngenheiros) == "A" .And. Len(aEngenheiros) > 0
        For nIndice := 1 To Len(aEngenheiros)

            jLinha := aEngenheiros[nIndice]

            If !jLinha:hasProperty("lDeleted")
                cFilAux  := Upper(AllTrim(jLinha["GL_FILIAL"]))
                cUsuario := Upper(AllTrim(jLinha["GL_USER"]))
                cItem    := AllTrim(jLinha["GL_ITEM"])

                If AScan(aChaveEng, cFilAux+cUsuario) > 0
                    // STR0010 - "Validação de Lista de Engenheiros"
                    // STR0011 - "O Engenheiro "
                    // STR0012 - " da linha "
                    // STR0013 - " está duplicado."
                    oError:set(400, STR0010, STR0011+cUsuario+STR0012+cItem+STR0013)
                    lRetorno := .F.
                    Exit
                EndIf

                aAdd(aChaveEng, cFilAux+cUsuario)
            EndIf
        Next nIndice
    Endif

Return lRetorno

/*/{Protheus.doc} montaRetorno
Monta o contrato de retorno esperado pela validação exclusiva do Smart X.

@author thiago.rover
@since 18/09/2026

@param01 lValido  , logical  , Indica se o conteúdo informado é válido
@param02 cMensagem, character, Mensagem apresentada em caso de falha
@return  jRetorno , Json     , Objeto com as propriedades "return" e "notValidMessage"
/*/
Static Function montaRetorno(lValido as logical, cMensagem as character)

    Local jRetorno := JsonObject():New() as Json

    jRetorno['return']          := lValido
    jRetorno['notValidMessage'] := cMensagem

Return jRetorno
