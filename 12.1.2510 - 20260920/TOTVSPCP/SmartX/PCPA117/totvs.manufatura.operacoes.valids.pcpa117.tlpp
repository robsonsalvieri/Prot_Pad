#include "protheus.ch"
#include "totvs.framework.model.events.th"
#include 'fw-tlpp-core.th'
#include "totvs.manufatura.operacoes.interface.pcpa117.ch"

namespace totvs.manufatura.operacoes.valids

/*/{Protheus.doc} vldDupCodigo
Função responsável por validar e impedir a duplicidade do código (VI_CODIGO) no banco de dados.

@author thiago.rover
@since 12/08/2026

@param01 xValue       , any      , Valor preenchido no campo VI_CODIGO
@param02 cField       , character, Nome do campo posicionado
@param03 aContextInfo , array    , [0] = VI_CODIGO da linha atual
@return  jRetorno     , Retorna Json com a propriedade: "return" indicando se o registro é válido (.T.) e "notValidMessage" vazio, ou
                                                        "return" indicando se o registro é inválido (.F.) e "notValidMessage" contendo a mensagem de erro.
*/
Function vldDupCodigo(xValue as variant, cField as character, aContextInfo as array) as Json

    Local cConteudo := xValue
    Local jRetorno  := JsonObject():New() as Json

    // Inicializa o objeto Json de retorno
    jRetorno['return']          := .T.
    jRetorno['notValidMessage'] := ""

    dbSelectArea("SVI")
	SVI->(dbSetOrder(1))
	If SVI->(dbSeek(xFilial("SVI")+cConteudo))
        // STR0005 - O código informado já existe.                                        
        jRetorno['return'] := .F.
        jRetorno['notValidMessage'] := STR0005
	EndIf

Return jRetorno
