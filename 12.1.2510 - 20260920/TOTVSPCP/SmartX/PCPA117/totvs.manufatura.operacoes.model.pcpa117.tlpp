#include 'fw-tlpp-core.th'
#include "protheus.ch"
#include "totvs.framework.structure.model.th"

namespace totvs.manufatura.operacoes.model

@totvsFrameworkStructureModel(lookup=.F., country="ALL", description="Operações")

/*/{Protheus.doc} PCPA117
Classe PCPA117 responsável por definir o modelo de dados da rotina de Operações.

@autor thiago.rover
@since 12/08/2026
/*/
class PCPA117 from totvs.framework.structure.model.data
    public method new() as object
    public method setModel()
EndClass

/*/{Protheus.doc} new
Método construtor da classe PCPA117.

@autor thiago.rover
@since 12/08/2026

@return self, Retorna a instância da classe PCPA117.
/*/
method new() as object class PCPA117
    _Super:new(,,.T.)
Return self

/*/{Protheus.doc} setModel
Método responsável por configurar o modelo de dados da classe PCPA117.

@autor thiago.rover
@since 12/08/2026
/*/
method setModel() class PCPA117
    local oSVI as object

    // Constroi o modelo de dados da tabela SVI (Operações)
    oSVI := totvs.framework.structure.object.ObjectFromMetadata():new("SVI",,{"VI_FILIAL","VI_CODIGO"})

    // Define a entidade principal do seu modelo.
    self:setObject(oSVI:getObject(), "SVI")
    
    // Oculta o campo de filial
    self:setProperty("VI_FILIAL", "hidden", .T., "SVI")

return
