#include "fw-tlpp-core.th"
#include "protheus.ch"
#include "totvs.framework.model.events.th"
#include "totvs.manufatura.engenheiros.interface.pcpa203.ch"

namespace totvs.manufatura.engenheiros.events

/*/{Protheus.doc} PCPA203
Classe PCPA203 responsavel por definir os eventos transacionais da rotina de Engenheiros.

@type class
@author Felipe Avelar
@since 27/08/2026
@see https://jiraproducao.totvs.com.br/browse/DMANPCP2-2344
/*/
Class PCPA203

    private data nSaveSX8 as numeric

    public method new() as object

    @beforeCreateInTransaction()
    public method beforeCreateInTransaction()

    @afterCreateInTransaction()
    public method afterCreateInTransaction()

    @beforeDeleteInTransaction()
    public method beforeDeleteInTransaction()

EndClass

/*/{Protheus.doc} new
Metodo construtor da classe PCPA203.

@type method
@author Felipe Avelar
@since 27/08/2026
@return object, Retorna a instancia da classe PCPA203.
/*/
Method new() as object class PCPA203
    ::nSaveSX8 := GetSX8Len()
Return self

/*/{Protheus.doc} beforeCreateInTransaction
Evento executado antes de criar  o registro no modelo dentro de uma transacao.
Valida se o codigo do usuario (GK_USER) ja esta cadastrado na tabela SGK,
impedindo duplicidade.

@type method
@author Felipe Avelar
@since 27/08/2026

@param oData  , object, Objeto contendo os dados do modelo que sera inserido.
@param oModel , object, Objeto do modelo.
@param oError , object, Objeto de erro recebido por referencia para apresentar mensagem de erro.
@return logical, .T. se a operacao de insert for permitida, .F. caso contrario.
/*/
Method beforeCreateInTransaction(oData as object, oModel as object, oError as object) class PCPA203

    Local aArea    := GetArea()
    Local cUser    := oData:getFieldValue("SGK", "GK_USER")
    Local lRetorno := .T.

    dbSelectArea("SGK")

    SGK->(dbSetOrder(2))
    If SGK->(dbSeek(FWxFilial("SGK") + cUser))
        // STR0006 - Codigo do usuario ja cadastrado como engenheiro.
        oError:set(400, "InsertError", STR0006)
        While GetSX8Len() > ::nSaveSX8
            RollBackSX8()
        EndDo
        lRetorno := .F.
    EndIf

    RestArea(aArea)

Return lRetorno

/*/{Protheus.doc} afterCreateInTransaction
Evento executado apos criar o registro do modelo dentro de uma transacao.
Confirma as reservas de sequencia utilizadas pela inclusao.

@type method
@author Felipe Avelar
@since 15/09/2026

@param oData  , object, Objeto contendo os dados do modelo criado.
@param oModel , object, Objeto do modelo criado.
@param oError , object, Objeto de erro recebido por referencia.
@return logical, .T. se as reservas forem confirmadas.
/*/
Method afterCreateInTransaction(oData as object, oModel as object, oError as object) class PCPA203

    Local lRetorno := .T.

    While GetSX8Len() > ::nSaveSX8
        ConfirmSX8()
    EndDo

Return lRetorno

/*/{Protheus.doc} beforeDeleteInTransaction
Evento executado antes de deletar os objetos contidos no modelo em uma transacao.
Valida se o engenheiro esta vinculado a algum Grupo de Engenharia (SGL),
impedindo a exclusao caso esteja em uso.

@type method
@author Felipe Avelar
@since 27/08/2026

@param oData  , object, Objeto contendo os dados do modelo que sera deletado.
@param oModel , object, Objeto do modelo que sera deletado.
@param oError , object, Objeto de erro recebido por referencia para apresentar mensagem de erro.
@return logical, .T. se a operacao de delete for permitida, .F. caso contrario.
/*/
Method beforeDeleteInTransaction(oData as object, oModel as object, oError as object) class PCPA203

    Local aArea    := GetArea()
    Local cUser    := oData:getFieldValue("SGK", "GK_USER")
    Local lRetorno := .T.

    dbSelectArea("SGL")
    SGL->(dbSetOrder(2))
    If SGL->(dbSeek(FWxFilial("SGL") + cUser))
        // STR0007 - Codigo do Engenheiro cadastrado no Grupo de Engenharia. Nao e possivel excluir.
        oError:set(400, "DeleteError", STR0007)
        lRetorno := .F.
    EndIf

    RestArea(aArea)

Return lRetorno
