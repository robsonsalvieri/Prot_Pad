#include "fw-tlpp-core.th"
#include "protheus.ch"
#include "totvs.framework.structure.interface.th"
#include "totvs.manufatura.engenheiros.interface.pcpa203.ch"

namespace totvs.manufatura.engenheiros.interface

@totvsFrameworkStructureInterface(lookup=.F., country="ALL", description="Engenheiros")

/*/{Protheus.doc} PCPA203
Classe PCPA203 responsavel por definir a interface da rotina de Engenheiros.

@type class
@author Felipe Avelar
@since 27/08/2026
@see https://jiraproducao.totvs.com.br/browse/DMANPCP2-2344
/*/
class PCPA203
    private data oInterface  as object
    private data oDataNew    as object
    private data oDataEdit   as object
    private data oDataDetail as object
    private data oDataView   as object

    public method new() as object
    public method setInterface()
    public method getContract() as json
EndClass

/*/{Protheus.doc} new
Metodo construtor da classe PCPA203.

@type method
@author Felipe Avelar
@since 27/08/2026

@return object, Retorna a instancia da classe PCPA203.
/*/
Method new() as object class PCPA203
Return self

/*/{Protheus.doc} setInterface
Metodo responsavel por definir a interface da rotina de Engenheiros.
Configura os componentes de inclusao, edicao, visualizacao e browse.

@type method
@author Felipe Avelar
@since 27/08/2026
/*/
Method setInterface() class PCPA203

    Local oElementsSGK as object

    // STR0001 - Engenheiros
    ::oInterface := totvs.framework.structure.interface.BuildContract():new("pcpa203")
    ::oInterface:setTitle(STR0001)
    ::oInterface:setModelId("totvs.manufatura.engenheiros.model.pcpa203", .T.)
    ::oInterface:setVersion("1.0")

    // Elementos do formulario - campos da tabela SGK
    oElementsSGK := totvs.framework.structure.interface.BuildElementsFromCode():new()
    oElementsSGK:addElements({"GK_FILIAL", "GK_COD", "GK_USER", "GK_NOME", "GK_GRAPROV"}, .F.)

    // Construcao da interface de Inclusao
    // STR0003 - Incluir Engenheiro
    ::oDataNew := totvs.framework.structure.interface.BuildDataNew():new("pcpa203New", "totvs.manufatura.engenheiros.model.pcpa203")
    ::oDataNew:setTitle(STR0003)
    ::oDataNew:setElement(oElementsSGK:getElements())
    ::oDataNew:addProperty("SGK", "GK_NOME", "readOnly", .T.)

    // Construcao da interface de Edicao
    // STR0004 - Editar Engenheiro
    ::oDataEdit := totvs.framework.structure.interface.BuildDataEdit():new("pcpa203Edit", "totvs.manufatura.engenheiros.model.pcpa203")
    ::oDataEdit:setTitle(STR0004)
    ::oDataEdit:setElement(oElementsSGK:getElements())

    // Campo-chave (GK_COD): bloqueado na alteracao
    ::oDataEdit:addProperty("SGK", "GK_COD", "readOnly", .T.)

    // Construcao da interface de Visualizacao
    // STR0005 - Visualizar Engenheiro
    ::oDataDetail := totvs.framework.structure.interface.BuildDataDetail():new("pcpa203Detail", "totvs.manufatura.engenheiros.model.pcpa203")
    ::oDataDetail:setTitle(STR0005)
    ::oDataDetail:setElement(oElementsSGK:getElements())

    // Construcao da interface do Browse
    // STR0001 - Engenheiros
    ::oDataView := totvs.framework.structure.interface.BuildDataView():new("pcpa203View", "totvs.manufatura.engenheiros.model.pcpa203")
    ::oDataView:setTitle(STR0001)

    // Associa os componentes a interface
    ::oInterface:setDataNew(::oDataNew:getDataNew(), .F.)
    ::oInterface:setDataEdit(::oDataEdit:getDataEdit(), .F.)
    ::oInterface:setDataDetail(::oDataDetail:getDataDetail(), .F.)
    ::oInterface:setDataView(::oDataView:getDataView())

Return

/*/{Protheus.doc} getContract
Metodo responsavel por retornar o contrato da interface da rotina de Engenheiros.

@type method
@author Felipe Avelar
@since 27/08/2026

@return json, Retorna o contrato da interface da rotina de Engenheiros.
/*/
Method getContract() as json class PCPA203
Return ::oInterface:getContract()
