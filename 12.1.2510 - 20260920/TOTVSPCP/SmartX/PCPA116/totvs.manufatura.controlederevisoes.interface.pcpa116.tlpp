#include "fw-tlpp-core.th"
#include "protheus.ch"
#include "totvs.framework.structure.interface.th"
#include "totvs.manufatura.controlederevisoes.interface.pcpa116.ch"

namespace totvs.manufatura.controlederevisoes.interface

@totvsFrameworkStructureInterface(lookup=.F., country="ALL", description="Controle de Revisões")
/*/{Protheus.doc} PCPA116
Classe PCPA116 responsável por definir a interface da rotina de Controle de Revisões.

@author Thiago Rover
@since 06/08/2026
/*/
class PCPA116
    private data oInterface  as object
    private data oDataEdit   as object
    private data oDataDetail as object
    private data oDataView   as object
 
    public method new() as object
    public method setInterface()
    public method getContract() as json
EndClass

/*/{Protheus.doc} new
Método construtor da classe PCPA116.

@autor Thiago Rover
@since 06/08/2026

@return self, Retorna a instância da classe PCPA116.
/*/
Method new() as object class PCPA116
Return self

/*/{Protheus.doc} setInterface
Método responsável por definir a interface da rotina de Controle de Revisões.

@autor Thiago Rover
@since 06/08/2026
/*/
Method setInterface() class PCPA116

    Local oElementsSOW as object

    //STR0004 - Controle de Revisões
    ::oInterface := totvs.framework.structure.interface.BuildContract():new("pcpa116")
    ::oInterface:setTitle(STR0004) 
    ::oInterface:setModelId("totvs.manufatura.controlederevisoes.model.pcpa116", .T.)
    ::oInterface:setVersion("1.0")
    
    // Cabeçalho - Código e Descrição da Controle de Revisões
    oElementsSOW := totvs.framework.structure.interface.BuildElementsFromCode():new()
    oElementsSOW:addElements({"OW_FILIAL","OW_CODIGO","OW_DESCRI","OW_REVISA"}, .F.)
    
    // Construção da interface
    ::oDataEdit   := totvs.framework.structure.interface.BuildDataEdit():new("pcpa116Edit", "totvs.manufatura.controlederevisoes.model.pcpa116")
    ::oDataDetail := totvs.framework.structure.interface.BuildDataDetail():new("pcpa116Detail", "totvs.manufatura.controlederevisoes.model.pcpa116")
    ::oDataView   := totvs.framework.structure.interface.BuildDataView():new("pcpa116View", "totvs.manufatura.controlederevisoes.model.pcpa116")

    // Construção dos títulos das interfaces
    ::oDataEdit:setTitle(STR0005)   // STR0005 - Edição Controle de Revisões
    ::oDataDetail:setTitle(STR0006) // STR0006 - Detalhes Controle de Revisões
    ::oDataView:setTitle(STR0004)   // STR0004 - Controle de Revisões

    // Construção dos elementos das interfaces
    ::oDataEdit:setElement(oElementsSOW:getElements())
    ::oDataDetail:setElement(oElementsSOW:getElements())

    // Oculta botão de inclusão no browser (PageAction)
    ::oDataView:hideStandardPageAction("newAction")

    // Oculta botão de exclusão no browser (PageAction) e dentro do visualizar (TableAction)
    ::oDataDetail:hideStandardPageAction("deleteAction")
    ::oDataView:hideStandardTableAction("deleteAction")
    
    ::oInterface:setDataEdit(::oDataEdit:getDataEdit(), .f.)
    ::oInterface:setDataDetail(::oDataDetail:getDataDetail(), .f.)
    ::oInterface:setDataView(::oDataView:getDataView())
return

/*/{Protheus.doc} getContract
Método responsável por retornar o contrato da interface da rotina de Controle de Revisões.

@autor Thiago Rover
@since 06/08/2026

@return json, Retorna o contrato da interface da rotina de Controle de Revisões.
/*/
Method getContract() as json class PCPA116
Return ::oInterface:getContract()
