#include 'fw-tlpp-core.th'
#include "protheus.ch"
#include "totvs.framework.structure.model.th"
#include "totvs.manufatura.controlederevisoes.interface.pcpa116.ch"

namespace totvs.manufatura.controlederevisoes.model

@totvsFrameworkStructureModel(lookup=.F., country="ALL", description="Controle de Revisões")

/*/{Protheus.doc} PCPA116
Classe PCPA116 responsável por definir o modelo de dados da rotina de Controle de Revisões.

@autor Thiago Rover
@since 06/08/2026
/*/
class PCPA116 from totvs.framework.structure.model.data
    public method new() as object
    public method setModel()
EndClass

/*/{Protheus.doc} new
Método construtor da classe PCPA116.

@autor Thiago Rover
@since 06/08/2026

@return self, Retorna a instância da classe PCPA116.
/*/
method new() as object class PCPA116
    _Super:new(,,.T.)
Return self

/*/{Protheus.doc} setModel
Método responsável por configurar o modelo de dados da classe PCPA116.

@autor Thiago Rover
@since 06/08/2026
/*/
method setModel() class PCPA116
    local oSOW as object

    // Constroi o modelo de dados da tabela SOW (Controle de Revisões)
    oSOW := totvs.framework.structure.object.ObjectFromMetadata():new("SOW",;                                             // Alias da tabela SOW
                                                                      {"OW_FILIAL","OW_CODIGO","OW_DESCRI","OW_REVISA"},; // Lista de campos da tabela SOW
                                                                      {"OW_FILIAL","OW_CODIGO"})                          // Chave única da tabela SOW

    // Define a entidade principal do seu modelo.
    self:setObject(oSOW:getObject(), "SOW")
    
    // Oculta o campo de filial
    self:setProperty("OW_FILIAL", "hidden", .T., "SOW")

return
