#Include "fw-tlpp-core.th"
#Include "protheus.ch"
#Include "totvs.framework.model.events.th"
#include "totvs.manufatura.familiatecnica.interface.pcpa105.ch"

namespace totvs.manufatura.familiatecnica.events

/*/{Protheus.doc} PCPA105
Classe PCPA105 responsável por definir os eventos da rotina de Família Técnica.

@autor Thiago Rover
@since 24/07/2026
/*/
Class PCPA105 

    public method new() as object

    @beforeDeleteInTransaction()
    public method beforeDeleteInTransaction()     

EndClass

/*/{Protheus.doc} new
Método construtor da classe PCPA105.

@autor Thiago Rover
@since 24/07/2026
@return self, Retorna a instância da classe PCPA105.
/*/
Method new() as object class PCPA105
Return self

/*/{Protheus.doc} beforeDeleteInTransaction 
Evento executado antes de deletar os objetos contidos no modelo em uma transação

@author Thiago Rover
@since 24/07/2026

@param01 oData  , object, Objeto contendo os dados do modelo que será deletado.
@param02 oModel , object, Objeto do modelo que será deletado.
@param03 oError , object, Objeto de erro recebido por referência que apresentará a mensagem de erro.
@return lRetorno, Retorna: .T. se a operação de delete for permitida
                           .F. se a operação não for permitida.
/*/
Method beforeDeleteInTransaction(oData as object, oModel as object, oError as object) class PCPA105

    Local aArea     := GetArea()
    Local cConteudo := oData:getFieldValue("CZL","CZL_CDFATD")
    Local lRetorno  := .T.
    
    dbSelectArea("CZG")
    CZG->(dbSetOrder(4))
    If CZG->(dbSeek(xFilial("CZG")+cConteudo))
        // STR0006 - Família técnica já utilizada em uma ficha técnica, não pode ser excluída.
        oError:set(400, "DeleteError", STR0006)
        lRetorno := .F.
    Else
        dbSelectArea("SB5")
        SB5->(dbSetOrder(6))
        If SB5->(dbSeek(xFilial("SB5")+cConteudo))
            // STR0007 - Família técnica já utilizada em um produto, não pode ser excluída.
            oError:set(400, "DeleteError", STR0007)
            lRetorno := .F.
        EndIf
    EndIf

    RestArea(aArea)

Return lRetorno
