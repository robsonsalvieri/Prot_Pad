#include 'fw-tlpp-core.th'
#include "protheus.ch"
#include "totvs.framework.structure.model.th"
#include "totvs.manufatura.familiatecnica.interface.pcpa105.ch"

namespace totvs.manufatura.familiatecnica.model

@totvsFrameworkStructureModel(lookup=.F., country="ALL", description="Família Técnica")

/*/{Protheus.doc} PCPA105
Classe PCPA105 responsável por definir o modelo de dados da rotina de Família Técnica.

@autor Thiago Rover
@since 24/07/2026
/*/
class PCPA105 from totvs.framework.structure.model.data
    public method new() as object
    public method setModel()
EndClass

/*/{Protheus.doc} new
Método construtor da classe PCPA105.

@autor Thiago Rover
@since 24/07/2026

@return self, Retorna a instância da classe PCPA105.
/*/
method new() as object class PCPA105
    _Super:new(,,.T.)
Return self

/*/{Protheus.doc} setModel
Método responsável por configurar o modelo de dados da classe PCPA105.

@autor Thiago Rover
@since 24/07/2026
/*/
method setModel() class PCPA105
    local oCZL as object

    // Constroi o modelo de dados da tabela CZL (Família Técnica)
    oCZL := totvs.framework.structure.object.ObjectFromMetadata():new("CZL",;                                    // Alias da tabela CZL
                                                                      {"CZL_FILIAL","CZL_CDFATD","CZL_DSFATD"},; // Lista de campos da tabela CZL
                                                                      {"CZL_FILIAL","CZL_CDFATD"})               // Chave única da tabela CZL

    // Define a entidade principal do seu modelo.
    self:setObject(oCZL:getObject(), "CZL")
    
    // Oculta o campo de filial
    self:setProperty("CZL_FILIAL", "hidden", .T., "CZL")

    // Inclui o controle de eventos ao modelo
    self:setEvents(totvs.manufatura.familiatecnica.events.pcpa105():new())

return
