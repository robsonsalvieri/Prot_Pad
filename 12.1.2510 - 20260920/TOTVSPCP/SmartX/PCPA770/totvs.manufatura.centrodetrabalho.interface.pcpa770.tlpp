#include "fw-tlpp-core.th"
#include "protheus.ch"
#include "totvs.framework.structure.interface.th"
#include "totvs.manufatura.centrodetrabalho.interface.pcpa770.ch"

namespace totvs.manufatura.centrodetrabalho.interface

@totvsFrameworkStructureInterface(lookup=.F., country="ALL", description="Centro de Trabalho")

/*/{Protheus.doc} PCPA770
Classe responsável por definir a interface da rotina de Centro de Trabalho

@author thiago.rover
@since 10/08/2026
/*/
class PCPA770
    private data oInterface  as object
    private data oDataNew    as object
    private data oDataEdit   as object
    private data oDataDetail as object
    private data oDataView   as object
 
    public method new() as object
    public method setInterface()
    public method getContract() as json
EndClass

/*/{Protheus.doc} new
Método construtor da classe PCPA770

@autor thiago.rover
@since 10/08/2026

@return self, Retorna a instância da classe PCPA770.
/*/
Method new() as object class PCPA770
Return self

/*/{Protheus.doc} setInterface
Método responsável por definir a interface da rotina de Centro de Trabalho

@autor thiago.rover
@since 10/08/2026
/*/
Method setInterface() class PCPA770

    Local oElementsSHB as object

    //STR0001 - Centro de Trabalho
    ::oInterface := totvs.framework.structure.interface.BuildContract():new("PCPA770")
    ::oInterface:setTitle(STR0001) 
    ::oInterface:setModelId("totvs.manufatura.centrodetrabalho.model.PCPA770", .T.)
    ::oInterface:setVersion("1.0")
    
    // Cabeçalho - Código e Descrição da Centro de Trabalho
    oElementsSHB := totvs.framework.structure.interface.BuildElementsFromCode():new()
    oElementsSHB:addElements({"HB_COD","HB_NOME","HB_HRUT","HB_HRUTSAB","HB_HRUTDOM","HB_CC","HB_REND"}, .T.)
    
    // Construção da interface de Inclusão
    // STR0002 - Incluir Centro de Trabalho
    ::oDataNew := totvs.framework.structure.interface.BuildDataNew():new("PCPA770New", "totvs.manufatura.centrodetrabalho.model.PCPA770")
    ::oDataNew:setTitle(STR0002)
    ::oDataNew:setElement(oElementsSHB:getElements())

    // Construção da interface de Edição
    // STR0003 - Editar Centro de Trabalho
    ::oDataEdit := totvs.framework.structure.interface.BuildDataEdit():new("PCPA770Edit", "totvs.manufatura.centrodetrabalho.model.PCPA770")
    ::oDataEdit:setTitle(STR0003)
    ::oDataEdit:setElement(oElementsSHB:getElements())
    
    // Construção da interface de Detalhe = Visualização
    // STR0004 - Detalhes Centro de Trabalho
    ::oDataDetail := totvs.framework.structure.interface.BuildDataDetail():new("PCPA770Detail", "totvs.manufatura.centrodetrabalho.model.PCPA770")
    ::oDataDetail:setTitle(STR0004)
    ::oDataDetail:setElement(oElementsSHB:getElements())
    
    // Construção da interface do Browser
    // STR0001 - Centro de Trabalho
    ::oDataView := totvs.framework.structure.interface.BuildDataView():new("PCPA770View", "totvs.manufatura.centrodetrabalho.model.PCPA770")
    ::oDataView:setTitle(STR0001)
    
    ::oInterface:setDataNew(::oDataNew:getDataNew(), .f.)
    ::oInterface:setDataEdit(::oDataEdit:getDataEdit(), .f.)
    ::oInterface:setDataDetail(::oDataDetail:getDataDetail(), .f.)
    ::oInterface:setDataView(::oDataView:getDataView())
return

/*/{Protheus.doc} getContract
Método responsável por retornar o contrato da interface da rotina de Centro de Trabalho

@autor thiago.rover
@since 10/08/2026

@return json, Retorna o contrato da interface da rotina de Centro de Trabalho
/*/
Method getContract() as json class PCPA770
Return ::oInterface:getContract()
