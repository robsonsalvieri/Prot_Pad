#include "protheus.ch"

/*/{Protheus.doc} PCPA770SX
Realiza a chamada do aplicativo Smart X via menu

@author thiago.rover
@since 07/08/2026

@return logical, Retorna .T. se o aplicativo Smart X for aberto com sucesso
                         .F. se houver falha ao abrir o aplicativo Smart X
/*/
Function PCPA770SX()
    
    Local lVersaoCompat := GetRPORelease() >= '12.1.2610'
    Local oLauncher as Object
        
    If lVersaoCompat
        oLauncher := totvs.framework.application.smartx.launcher():new()
        oLauncher:setInterface("totvs.manufatura.centrodetrabalho.interface.pcpa770")
    Endif

Return Iif(lVersaoCompat .And. oLauncher != Nil, oLauncher:open(), Nil)
