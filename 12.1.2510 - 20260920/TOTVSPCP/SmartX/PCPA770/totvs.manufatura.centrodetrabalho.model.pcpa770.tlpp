#include "protheus.ch"
#include "totvs.framework.structure.model.th"
#include "totvs.manufatura.centrodetrabalho.interface.pcpa770.ch"
#include 'fw-tlpp-core.th'

namespace totvs.manufatura.centrodetrabalho.model

@totvsFrameworkStructureModel(lookup=.F., country="ALL", description="Centro de Trabalho")

/*/{Protheus.doc} PCPA770
Classe responsável por definir o modelo de dados da rotina de Centro de Trabalho.

@autor thiago.rover
@since 10/08/2026
/*/
Class PCPA770 from totvs.framework.structure.model.data
    public method new() as object
    public method setModel()
EndClass

/*/{Protheus.doc} new
Método construtor da classe PCPA770.

@autor thiago.rover
@since 10/08/2026

@return self, Retorna a instância da classe PCPA770
/*/
Method new() as object class PCPA770
    _Super:new(,,.T.)
Return self

/*/{Protheus.doc} setModel
Método responsável por configurar o modelo de dados da classe PCPA770

@autor thiago.rover
@since 10/08/2026
/*/
Method setModel() class PCPA770
    Local oLookupCTT as object
    local oSHB       as object

    // Constroi o modelo de dados da tabela SHB (Centro de Trabalho)
    oSHB := totvs.framework.structure.object.ObjectFromMetadata():new("SHB",,{"HB_FILIAL","HB_COD"})

    // Define a entidade principal do modelo
    self:setObject(oSHB:getObject(), "SHB")
    
    // Oculta o campo de filial
    self:setProperty("HB_FILIAL", "hidden", .T., "SHB")

    // Lookup Personalizado do campo HB_CC (Centro de Custo)
    oLookupCTT := totvs.framework.structure.model.lookup():new()
    oLookupCTT:setLookup("totvs.manufatura.centrodetrabalho.model.lookup.CTT", "XTX_COD",,, {"XTX_COD"})
    self:AddLookup("HB_CC", "SHB", oLookupCTT:getLookup())

    // Inclui o controle de eventos ao modelo
    self:setEvents(totvs.manufatura.centrodetrabalho.events.PCPA770():new())

Return
