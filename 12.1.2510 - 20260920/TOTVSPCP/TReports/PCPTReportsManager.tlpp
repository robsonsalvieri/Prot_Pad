#INCLUDE "TOTVS.CH"

/*/{Protheus.doc} PCPTReportsManager
Classe responsável pelos métodos de criação e manipulação do Smart View

@type Class
@author thiago.rover
@since 29/06/2026
/*/
CLASS PCPTReportsManager FROM LongNameClass

    PUBLIC METHOD SetQueryCustomFields(cQuery as Character, aCustomFields as Array, aTables as Array)
    PUBLIC METHOD new()
    PUBLIC METHOD SetStructCustomFields(aStruct as Array, aCustomFields as Array, aTabelas as Array)
    STATIC METHOD addToData(oSelf as Object, cPropertyId as Character, cType as Character, jDataItem as Json, cAlias as Character, lFormDecimal as Logical)

ENDCLASS

/*/{Protheus.doc} new
Construtor da Classe

@type Method
@author thiago.rover
@since 29/06/2026
@return Self, objeto, instancia da Classe PCPTReportsManager
/*/
METHOD new() CLASS PCPTReportsManager
RETURN Self

/*/{Protheus.doc} SetQueryCustomFields
Atribui os campos customizados na query filtrados conforme as tabelas informadas, separados por vírgula.

@type Method
@author thiago.rover
@since 26/05/2026

@param01 cQuery       , caracter , Query que será adicionada os campos customizados
@param02 aCustomFields, Array    , Campos customizados
@param03 aTables      , Array    , Tabelas para filtrar os campos customizados
@return  NIL          , Retorno nulo
/*/
METHOD SetQueryCustomFields(cQuery as Character, aCustomFields as Array, aTables as Array) CLASS PCPTReportsManager
    
    Local nFields := 0  // Contador para percorrer os campos

    If !Empty(aCustomFields) 
    
        // Percorre os campos customizados e os filtra conforme as tabelas informadas
        For nFields := 1 To Len(aCustomFields)
            cQuery += IIf(AScan(aTables, aCustomFields[nFields][5]) > 0, ", " + aCustomFields[nFields][5] + "." + aCustomFields[nFields][1], "")
        Next nFields
    EndIf

RETURN NIL


/*/{Protheus.doc} SetStructCustomFields
Adiciona os campos customizados a Struct do Objeto de Negócio de acordo com a tabela.

@type Method
@author thiago.rover
@since 29/06/2026

@param01 @aStruct     , Array    , Estrutura do Objeto Aninhado dos campos customizados
@param02 aCustomFields, Array    , Campos customizados
@param03 aTabelas     , Array    , Tabelas para filtrar os campos customizados
@return  NIL          , Retorno nulo 
/*/
METHOD SetStructCustomFields(aStruct as Array, aCustomFields as Array, aTabelas as Array) CLASS PCPTReportsManager
   
    Local cDescricao := "" // Descrição do campo
    Local cNomeTab   := "" // Nome do campo (nome da propriedade do Objeto de Negócio)
    Local cTipo      := "" // Tipo do campo
    Local cId        := "" // ID do campo
    Local nIndice    := 0  // Contador para percorrer os campos

    // Protege a execução caso não haja campos customizados ou tabelas informadas
    If !Empty(aCustomFields) .And. !Empty(aTabelas)

        // Percorre a lista de campos customizados e adiciona ao JSON de dados do Objeto de Negócio
        For nIndice := 1 To Len(aCustomFields)
            
            // Inclui no jData apenas os campos que pertencem as tabelas informadas
            If AScan(aTabelas, aCustomFields[nIndice][5]) > 0

                cNomeTab   := aCustomFields[nIndice][1]
                cId        := aCustomFields[nIndice][2]
                cTipo      := aCustomFields[nIndice][3]
                cDescricao := aCustomFields[nIndice][4]

                Aadd(aStruct, {cNomeTab, cDescricao, cTipo, cId})
            EndIf

        Next nIndice
    
    EndIf

RETURN NIL

/*/{Protheus.doc} addToData
Adiciona campo a estrutura de dados Json que será retornada para o Smart View

@author thiago.rover
@since 02/07/2026

@param 01 - oSelf        , objeto  , Instancia do Objeto de Negócio (ON)
@param 02 - cPropertyId  , caracter, Nome o campo na query (ON) para recuperação do dado
@param 03 - cType        , caracter, Tipo do dado
@param 04 - jDataItem    , json    , Objeto json para adição das propriedades e valores
@param 05 - cAlias       , caracter, Alias com os dados para adição nas propriedades
@param 06 - lFormDecimal , logico  , Indica se deverá usar o addDec para formatar o conteúdo numérico para decimal
@return     NIL          , Retorno nulo 
/*/
METHOD addToData(oSelf as object, cPropertyId as Character, cType as Character, jDataItem as Json, cAlias as Character, lFormDecimal as Logical) class PCPTReportsManager
    
	Local cComboContent := "" as Character
    
    Default lFormDecimal := .F.

	If (cAlias)->(FieldPos(cPropertyId)) > 0 .AND. (cAlias)->&(cPropertyId) != NIL .AND. Empty(jDataItem[cPropertyId])

		If cType == "string" .and. !Empty(cComboContent := x3Combo(cPropertyId, (cAlias)->&(cPropertyId)))
			jDataItem[cPropertyId] := cComboContent

        ElseIf cType == "date"
			jDataItem[cPropertyId] := totvs.framework.treports.date.stringToTimeStamp((cAlias)->&(cPropertyId))
        
        ElseIf cType == "number" .and. FWSX3Util():GetFieldStruct(cPropertyId)[4] > 0 .And. lFormDecimal
            jDataItem[cPropertyId] := addDec((cAlias)->&(cPropertyId), cPropertyId)

        Else
			jDataItem[cPropertyId] := (cAlias)->&(cPropertyId)

		EndIf

    EndIf

RETURN NIL
