	Self:addProperty("apontadas"      , "apontadas"      , "string" , STR0040 , "apontadas"      , , , , .F.) // "Apontadas"
	Self:addProperty("setup"          , "setup"          , "number" , STR0041 , "setup"          , , , , .F.) // "Setup"
	Self:addProperty("finalizacao"    , "finalizacao"    , "number" , STR0042 , "finalizacao"    , , , , .F.) // "Finalização"
	Self:addProperty("imprime"        , "imprime"        , "number" , STR0043 , "imprime"        , , , , .F.) // "Imprime"
	Self:addProperty("recurAlt"       , "recurAlt"       , "string" , STR0044 , "recurAlt"       , , , , .F.) // "Recurso Alternativo"
	Self:addProperty("ferramAlt"      , "ferramAlt"      , "string" , STR0045 , "ferramAlt"      , , , , .F.) // "Ferramenta Alternativa"
