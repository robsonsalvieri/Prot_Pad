	Self:addProperty("efetivadas"     , "efetivadas"     , "string" , STR0037 , "efetivadas"     , , , , .F.) // "Efetivadas"
	Self:addProperty("programadas"    , "programadas"    , "string" , STR0038 , "programadas"    , , , , .F.) // "Programadas"
