±±³          ³               ³                                            ³±±
±±ÀÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ±±
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß
/*/

Static Function MenuDef()
Private aRotina	:= {	{STR0001,"AxPesqui"  , 0 , 1,0,.F.},;	//"Pesquisar"
						{STR0002,"A380Visual", 0 , 2,0,nil},;	//"Visualizar"
						{STR0003,"A380Inclui", 0 , 3,0,nil},;	//"Incluir"
						{STR0004,"A380Altera", 0 , 4,37,nil},;	//"Alterar"
						{STR0005,"A380Exclui", 0 , 5,0,nil} }	//"Excluir"
Private aRotinaAux := aRotina

If ExistBlock ("MTA380MNU")
	aRotina := ExecBlock('MTA380MNU',.F.,.F.,aRotina)
	If aRotina == Nil
		aRotina := aRotinaAux
	EndIf
EndIf
Return (aRotina)

/*
ÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜ
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
±±ÉÍÍÍÍÍÍÍÍÍÍÑÍÍÍÍÍÍÍÍÍÍËÍÍÍÍÍÍÍÑÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍËÍÍÍÍÍÍÑÍÍÍÍÍÍÍÍÍÍÍÍÍ»±±
±±ºPrograma  ³MATA380   ºAutor  ³Aecio Ferreira Gomes º Data ³  11/04/11   º±±
±±ÌÍÍÍÍÍÍÍÍÍÍØÍÍÍÍÍÍÍÍÍÍÊÍÍÍÍÍÍÍÏÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÊÍÍÍÍÍÍÏÍÍÍÍÍÍÍÍÍÍÍÍÍ¹±±
±±ºDescricao ³ Valida a exclusão.								   	  	   º±±
±±º          ³                                                             º±±
±±ÌÍÍÍÍÍÍÍÍÍÍØÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ¹±±
±±ºUso       ³ MATA380                                                     º±±
±±ÈÍÍÍÍÍÍÍÍÍÍÏÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ¼±±
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß
*/
Function A380DelOK(nOpc)
Local aArea :=  GetArea()
Local lRet	:= .T.
Local lIntSFC := IntegraSFC() .And. !IsInCallStack("DPRA340INT")
//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
//³ Este ponto de entrada tem a finalidade de confirmar a exclusao. ³
//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
If ExistBlock('MT380EXC')
	lRet := ExecBlock('MT380EXC', .F., .F.)
EndIf

//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
//³Chama rotina para integracao com SFC(Chao de Fabrica) ³
//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
If lIntSFC
	lRet := A380IntSFC(nOpc)
EndIf

RestArea(aArea)

Return(lRet)

/*
ÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜ
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
±±ÉÍÍÍÍÍÍÍÍÍÍÑÍÍÍÍÍÍÍÍÍÍËÍÍÍÍÍÍÍÑÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍËÍÍÍÍÍÍÑÍÍÍÍÍÍÍÍÍÍÍÍÍ»±±
±±ºPrograma  ³MATA380   ºAutor  ³Aecio Ferreira Gomes º Data ³  11/04/11   º±±
±±ÌÍÍÍÍÍÍÍÍÍÍØÍÍÍÍÍÍÍÍÍÍÊÍÍÍÍÍÍÍÏÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÊÍÍÍÍÍÍÏÍÍÍÍÍÍÍÍÍÍÍÍÍ¹±±
±±ºDescricao ³ Atualiza arquivo de saldos(B2_QEMP) quando exclusão.    	   º±±
±±º          ³                                                             º±±
±±ÌÍÍÍÍÍÍÍÍÍÍØÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ¹±±
±±ºUso       ³ MATA380                                                     º±±
±±ÈÍÍÍÍÍÍÍÍÍÍÏÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ¼±±
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß
*/
Function A380DelAtu()
Local aTravas	:= {}
Local aArea		:= Getarea()
Local lConsVenc := GetMV('MV_LOTVENC')=='S'

//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
//³ Atualiza arq. de saldos  B2_QEMP                                  ³
//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
GravaEmp(SD4->D4_COD,;
		SD4->D4_LOCAL,;
		SD4->D4_QUANT,;
		SD4->D4_QTSEGUM,;
		SD4->D4_LOTECTL,;
		SD4->D4_NUMLOTE,;
		NIL,;
		NIL,;
		SD4->D4_OP,;
		SD4->D4_TRT,;
		NIL,;
		NIL,;
		"SC2",;
		NIL,;
		SD4->D4_DATA,;
		@aTravas,;
		.T.,;
		NIL,;
		.T.,;
		.T.,;
		lConsVenc)

If lWmsNew .And. IntWms(SD4->D4_COD)
	WmsEmpReq("SC2",;
				 SD4->D4_COD,;
				 SD4->D4_LOCAL,;
				 SD4->D4_QUANT,;
				 /*cEndereco*/,;
				 SD4->D4_LOTECTL,;
				 SD4->D4_NUMLOTE,;
				 /*cNumSerie*/,;
				 SD4->D4_OP,;
				 SD4->D4_TRT,;
				 SD4->D4_IDDCF,;
				 /*cIdUnitiz*/,;
				 .T.,; // lEstorno
				 .T.,; // lCriaSDC
				 .T.)  // lEmpD14
EndIf

//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
//³ Remove travas dos registros utilizados                  ³
//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
MaDesTrava(aTravas)

If FindFunction("A381GrvAgr")
	//Grava os dados do SIGAAGR (Dados existentes somente quando utilizado a integração com o PIMS)
	A381GrvAgr(.T.,SD4->D4_COD, SD4->D4_LOCAL, SD4->D4_OP, SD4->D4_TRT, SD4->D4_LOTECTL, SD4->D4_NUMLOTE)
EndIf

DbSelectArea("SD4")
If ( ExistBlock("MTA380E") )
	ExecBlock("MTA380E",.F.,.F.)
EndIf

RestArea(aArea)

Return

/*
ÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜ
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
±±ÚÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄ¿±±
±±³Fun‡ao    ³A380IntSFC ³ Autor ³ Aecio Ferreira Gomes    ³ Data ³30/04/11 ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄ´±±
±±³Descri‡ao ³Atualiza tabelas do SFC conforme modelagem dos dados(MVC)     ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ´±±
±±³Sintaxe   ³A380IntSFC(ExpN1)                                             ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ´±±
±±³Parametros³ExpN1 = Rotina a ser processada(3-Inc, 4-Alt, 5-Exc)          ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ´±±
±±³Uso       ³MATA770                                                       ³±±
±±ÀÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ±±
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß
*/
Static Function A380IntSFC(nOpc)
Local aArea      := GetArea()
Local lRet       := .T.
Local aCampos    := {}
Local aAux       := {}
Local nX    	 := 0
Local lIntegra   := .F.
Local lAchou     := .F.
Local oModel	 := NIL
Local cCod		 :=	If(nOpc==4, M->D4_COD, SD4->D4_COD)
Local cTRT		 :=	If(nOpc==4, M->D4_TRT, SD4->D4_TRT)
//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
//³ Valida se a OP foi integrada ao SFC ³
//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
CYQ->(dbSetOrder(1))
lIntegra := CYQ->(dbSeek(xFilial('CYQ')+If(nOpc == 5,SD4->D4_OP,M->D4_OP)))

If lIntegra .And. nOpc # 5
	If nOpc == 3
		//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
		//³Posicionma na OP para busca codigo do produto pai³
		//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
		SC2->(dbSetOrder(1))
		SC2->(dbSeek(xFilial("SC2")+M->D4_OP))

		//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
		//³ Posiciona na ultima operacao   ³
		//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
		SHY->(dbSetOrder(1))
		SHY->(dbSeek(xFilial("SHY")+M->D4_OP))
		If !SHY->(dbSeek(xFilial("SHY")+SHY->(HY_OP+HY_ROTEIRO)+Replicate("z",TamSX3("G2_OPERAC")[1]),.T.))
			SHY->(dbSkip(-1))
		EndIf

		//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
		//³Busca Oper X Comp da OP ³
		//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
		SGF->(dbSetOrder(2))
		SGF->(dbSeek(xFilial("SGF")+SC2->C2_PRODUTO+SHY->HY_ROTEIRO+M->D4_COD))

		//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
		//³Monta array com dados do Componente para atualizacao no SFC ³
		//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ
		aAdd(aCampos,{"CYP_NRORPO",M->D4_OP})
		aAdd(aCampos,{"CYP_CDMT",M->D4_COD})
		aAdd(aCampos,{"CYP_NRSQMT",M->D4_TRT})
		aAdd(aCampos,{"CYP_CDACPI",SC2->C2_PRODUTO})
		aAdd(aCampos,{"CYP_DTMT",M->D4_DATA})
		aAdd(aCampos,{"CYP_CDUN",Posicione("SB1",1,xFilial("SB1")+M->D4_COD,"B1_UM")})
		aAdd(aCampos,{"CYP_CDRT",SHY->HY_ROTEIRO})
		aAdd(aCampos,{"CYP_CDAT",If(Found(),SGF->GF_OPERAC,SHY->HY_OPERAC)})
	EndIf
	aAdd(aCampos,{"CYP_CDDP",M->D4_LOCAL})
	aAdd(aCampos,{"CYP_CDLO",M->D4_LOTECTL})
	aAdd(aCampos,{"CYP_QTMT",M->D4_QUANT})
	aAdd(aCampos,{"CYP_TPST","1"})
EndIf

If lIntegra
	//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
	//³Instancia modelo de dados(Model) do cadastro de Ordem de Producao - SFC ³
	//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
	oModel := FWLoadModel("SFCA100")
	oModel:SetOperation(4)
EndIf

//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
//³Ativa o modelo de dados ³
//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
If lIntegra .And. (lRet := oModel:Activate())
	//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
	//³Instancia modelo de dados(Model) da Reseva da OP  ³
	//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
	aAux := oModel:GetModel("CYPDETAIL"):GetStruct():GetFields()

	If nOpc <> 3
		//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
		//³Posiciona na linha do Grid ³
		//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
		For nX := 1 To oModel:GetModel("CYPDETAIL"):GetQtdLine()
			oModel:GetModel("CYPDETAIL"):GoLine(nX)
			If AllTrim(cCod) == AllTrim(oModel:GetValue("CYPDETAIL","CYP_CDMT")) .And.;
					 AllTrim(cTRT) == AllTrim(oModel:GetValue("CYPDETAIL","CYP_NRSQMT"))
				lAchou := .T.
				Exit
			EndIf
		Next nX
	EndIf

	If (nOpc == 3 .And. !Empty(oModel:GetValue("CYPDETAIL","CYP_CDMT"))) .Or. !lAchou
		//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
		//³Adiciona linha no modelo ³
		//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
		oModel:GetModel("CYPDETAIL"):AddLine()
	EndIf

	If nOpc # 5
		//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
		//³Loop para validacao e atribuicao de dados dos campos do Model ³
		//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
		For nX := 1 To Len(aCampos)
			//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
			//³Valida os campos existentes na estrutura do Model ³
			//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
			If aScan(aAux,{|x| AllTrim(x[3]) ==  AllTrim(aCampos[nX,1])}) > 0
				//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
				//³Atribui os valores aos campos do Model caso passem pela validacao do formulario ³
				//³referente a tipos de dados, tamanho ou outras incompatibilidades estruturais.   ³
				//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
				If !(oModel:SetValue("CYPDETAIL",aCampos[nX,1],aCampos[nX,2]))
					lRet := .F.
					Exit
				EndIf
			EndIf
		Next
    Else
		oModel:GetModel("CYPDETAIL"):DeleteLine()
	EndIf
Endif

If lRet .And. lIntegra
	//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
	//³Valida os dados e integridade conforme dicionario do Model ³
	//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
	If (lRet := oModel:VldData())
		//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
		//³Efetiva gravacao dos dados na tabela ³
		//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
    	lRet :=	 oModel:CommitData()
	EndIf
EndIf

//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
//³Gera log de erro caso nao tenha passado pela validacao ³
//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
If !lRet .And. lIntegra
	aErro := oModel:GetErrorMessage()

	//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
	//³Estrutura do vetor com erro ³
	//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
	//[1] Id do formulário de origem
	//[2] Id do campo de origem
	//[3] Id do formulário de erro
	//[4] Id do campo de erro
	//[5] Id do erro
	//[6] mensagem do erro
	//[7] mensagem da solução
	//[8] Valor atribuido
	//[9] Valor anterior

	AutoGrLog( "Id do formulário de origem:" + ' [' + AllToChar( aErro[1]  ) + ']' )
	AutoGrLog( "Id do campo de origem:     " + ' [' + AllToChar( aErro[2]  ) + ']' )
	AutoGrLog( "Id do formulário de erro:  " + ' [' + AllToChar( aErro[3]  ) + ']' )
	AutoGrLog( "Id do campo de erro:       " + ' [' + AllToChar( aErro[4]  ) + ']' )
	AutoGrLog( "Id do erro:                " + ' [' + AllToChar( aErro[5]  ) + ']' )
	AutoGrLog( "Mensagem do erro:          " + ' [' + AllToChar( aErro[6]  ) + ']' )
	AutoGrLog( "Mensagem da solução:       " + ' [' + AllToChar( aErro[7]  ) + ']' )
	AutoGrLog( "Valor atribuido:           " + ' [' + AllToChar( aErro[8]  ) + ']' )
	AutoGrLog( "Valor anterior:            " + ' [' + AllToChar( aErro[9]  ) + ']' )

	MostraErro()
EndIf

If lIntegra
	//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
	//³Desativa o Model ³
	//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
	oModel:DeActivate()

EndIf

RestArea(aArea)
Return lRet

/*
ÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜ
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
±±ÉÍÍÍÍÍÍÍÍÍÍÑÍÍÍÍÍÍÍÍÍÍËÍÍÍÍÍÍÍÑÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍËÍÍÍÍÍÍÑÍÍÍÍÍÍÍÍÍÍÍÍÍ»±±
±±ºPrograma  ³A380ValCodºAutor  ³ Andre Anjos		 º Data ³  26/02/13   º±±
±±ÌÍÍÍÍÍÍÍÍÍÍØÍÍÍÍÍÍÍÍÍÍÊÍÍÍÍÍÍÍÏÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÊÍÍÍÍÍÍÏÍÍÍÍÍÍÍÍÍÍÍÍÍ¹±±
±±ºDescricao ³ Valida codigo do produto digitado como componente da OP.   º±±
±±ÌÍÍÍÍÍÍÍÍÍÍØÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ¹±±
±±ºUso       ³ MATA380/MATA381                                            º±±
±±ÈÍÍÍÍÍÍÍÍÍÍÏÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ¼±±
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß
*/
Function A380ValCod()
Local lRet := .T.

lRet := ExistCpo("SB1")

If lRet .And. IsProdProt(M->D4_COD) .And. !IsInCallStack("DPRA340INT")
	Aviso(STR0014,STR0032,{"OK"}) //-- Protótipos podem ser manipulados somente através do módulo Desenvolvedor de Produtos (DPR).
	lRet := .F.
EndIf

Return lRet

//-------------------------------------------------------------------
/*/{Protheus.doc} A380VldEnd()
Efetua a validação do código do endereço quando informado empenho por endereço

@param cLocal - Local (Armazém) em que se deseja validar o endereço
@param cLocaliz - Localização que se deseja validar

@author  Jackson Patrick Werka
@version P12
@since   24/07/2017
@return  lRet
/*/
Function A380VldEnd(cLocal,cLocaliz)
Local lRet := .T.
	// Valida o código do endereço informado quando integrado com o WMS
	If lWmsNew .And. IntWms(M->D4_COD)
		lRet := Wms650End(cLocal,cLocaliz)
	EndIf
Return lRet

/*
ÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜ
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
±±ÉÍÍÍÍÍÍÍÍÍÍÑÍÍÍÍÍÍÍÍÍÍËÍÍÍÍÍÍÍÑÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍËÍÍÍÍÍÍÑÍÍÍÍÍÍÍÍÍÍÍÍÍ»±±
±±ºPrograma  ³A380IntDCFºAutor  ³ Andre Anjos		 	º Data ³  18/05/14   º±±
±±ÌÍÍÍÍÍÍÍÍÍÍØÍÍÍÍÍÍÍÍÍÍÊÍÍÍÍÍÍÍÏÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÊÍÍÍÍÍÍÏÍÍÍÍÍÍÍÍÍÍÍÍÍ¹±±
±±ºDescricao ³ Valida integracao com WMS para alteracao e exclusao.	   º±±
±±ÌÍÍÍÍÍÍÍÍÍÍØÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ¹±±
±±ºUso       ³ MATA380/MATA381                                            º±±
±±ÈÍÍÍÍÍÍÍÍÍÍÏÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ¼±±
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß
*/
Function A380IntDCF()
Local lRet := .T.

	If IntWms(SD4->D4_COD)
		lRet := WmsAvalSD4("1",SD4->(Recno()))
	EndIf
Return lRet

//-------------------------------------------------------------------
/*/{Protheus.doc} IntegPPI()
Realiza a integração com o PCFactory, atualizando os empenhos alterados.

@param lExclusao - Indica se está sendo chamado na operação de Exclusao

@author  Lucas Konrad França
@version P12
@since   18/09/2015
@return  lRet
/*/
//-------------------------------------------------------------------
Static Function IntegPPI(lExclusao)
   Local lRet       := .T.
   Local aArea      := GetArea()
   Local lAlteraBkp := Altera
   Local lIncluiBkp := Inclui
   Local cMsg       := ""

   Local cD4Op      := ""
   Private aIntegPPI := {}

   Altera := .T.
   Inclui := .F.
   cD4Op  := SD4->D4_OP
   dbSelectArea("SC2")
   SC2->(dbSetOrder(1))
   If SC2->(dbSeek(xFilial("SC2")+AllTrim(cD4Op)))
      mata650PPI(, , .T., .T., .F.)
   EndIf

   If Len(aIntegPPI) > 0
      cMsg := STR0035 + AllTrim(cD4Op) + ; //"Não foi possível realizar a integração com o TOTVS MES para a ordem de produção '"
              STR0036 + CHR(10)      + ; //"'. Foi gerada uma pendência de integração para esta ordem de produção."
              STR0037 + AllTrim(aIntegPPI[1,2]) //"Erro: "
      Help( ,, 'Help',, cMsg, 1, 0 )
   EndIf

   Altera := lAlteraBkp
   Inclui := lIncluiBkp
   RestArea(aArea)
Return lRet

//-------------------------------------------------------------------
/*/{Protheus.doc} A380AltQtd
Função para verificar se é permitido alterar quantidade do empenho

@param
@return lRet

@author  Michele Girardi
@version P12
@since   10/05/2018
/*/
//-------------------------------------------------------------------
 Static Function A380AltQtd()
 Local lRet      := .T.
 Local lReqNec   := (SUPERGETMV("MV_REQNEC", .F., "N") == "S")
 Local aAreaSB1  := GetArea()
 Local nAchouAlt := 0

 If Type("aAltQtd") == "U"
 	Return lRet
 EndIf

 aAltQtd := {}

 If lReqNec
 	If SB1->(dbSeek(xFilial("SB1")+SD4->D4_COD))
 		If SB1->B1_TIPODEC == "I"
 			If (SD4->D4_QTDEORI > SD4->D4_QUANT) .And.;
 			 	(SD4->D4_QTDEORI != M->D4_QTDEORI .Or. SD4->D4_QUANT != M->D4_QUANT)
 				lRet := .F.
 				Help(" ",1,"MA380ALTQTREQ") // Não é permitido alterar a quantidade do empenho para componente que possui requisição por quantidade necessária e que possui apontamento.
 			Else
 				If (SD4->D4_QTDEORI != M->D4_QTDEORI .Or. SD4->D4_QUANT != M->D4_QUANT)
 					nAchouAlt := ASCAN(aAltQtd,{ |x| x[1] == SD4->D4_COD .And. x[2] == SD4->D4_TRT  }) //componente teve alteração de quantidade
 					If nAchouAlt == 0
 						AADD (aAltQtd, {SD4->D4_COD, SD4->D4_TRT})
 					EndIf
 				EndIf
 			EndIf
 		EndIF
 	EndIf
 EndIf

 RestArea(aAreaSB1)

 Return lRet

/*/{Protheus.doc} redirAuto
Redireciona o execauto desda rotina para nova rotina (mata381)
@type  Static Function
@author Lucas Fagundes
@since 13/04/2022
@version P12
@param 01 aRotAuto, Array, Array cabeçalho do execauto original
@param 02 aEmpAuto, Array, Array componentes do execauto original
@param 03 nOpcAuto, Number, Operação do execauto
@return Nil
/*/
Static Function redirAuto(aRotAuto, aEmpAuto, nOpcAuto)
	Local aBkpMod    := {cModulo, nModulo}
	Local aCab       := {}
	Local aEnd       := {}
	Local aItens     := {}
	Local aLine      := {}
	Local aLineEnd   := {}
	Local cAliasCont := GetNextAlias()
	Local lPos       := .F.
	Local nCont      := 0
	Local nIndex     := 0
	Local nPosCod    := 0
	Local nPosOP     := 0
	Local nZeraEmp   := 0

	SetModulo("SIGAPCP","PCP")
	nPosOP := aScan(aRotAuto, {|x| Alltrim(x[1]) == "D4_OP"})
	If nOpcAuto == 3
		aAdd(aCab, aRotAuto[nPosOP])

		aLine := aClone(aRotAuto)

		If aEmpAuto != Nil .and. !Empty(aEmpAuto)
			For nIndex := 1 to len(aEmpAuto)
				aLineEnd := {}

				aAdd(aLineEnd, {"DC_QUANT"  , aEmpAuto[nIndex][1], Nil})
				aAdd(aLineEnd, {"DC_LOCALIZ", aEmpAuto[nIndex][2], Nil})
				aAdd(aLineEnd, {"DC_NUMSERI", aEmpAuto[nIndex][3], Nil})
				aAdd(aLineEnd, {"D4_QTSEGUM", aEmpAuto[nIndex][4], Nil})

				aAdd(aEnd, aLineEnd)
			Next
			aAdd(aLine, {"AUT_D4_END", aEnd, Nil})
		EndIf

		aAdd(aItens, aLine)
		MSExecAuto({|x,y,z| mata381(x,y,z)},aCab, aItens, 3)
	ElseIf nOpcAuto == 4
		nZeraEmp := aScan(aRotAuto, {|x| x[1] == "ZERAEMP"})

		aAdd(aCab, aRotAuto[nPosOP])

		If nZeraEmp != 0 .and. aRotAuto[nZeraEmp][2] == "S"
			aAdd(aCab, {"AUTZERAEMP", .T., Nil})
			aAdd(aCab, {"INDEX", 2, Nil})

			MSExecAuto({|x,y,z| mata381(x,y,z)},aCab, aItens, 4)
		Else
			lPos := buscaReg(aRotAuto)

			If lPos
				aAdd(aLine,{"LINPOS","D4_COD+D4_TRT+D4_LOTECTL+D4_NUMLOTE+D4_LOCAL+D4_OPORIG+D4_SEQ",;
							SD4->D4_COD,;
							SD4->D4_TRT,;
							SD4->D4_LOTECTL,;
							SD4->D4_NUMLOTE,;
							SD4->D4_LOCAL,;
							SD4->D4_OPORIG,;
							SD4->D4_SEQ})

				For nIndex := 1 to len(aRotAuto)
					If aRotAuto[nIndex][1] == "INDEX"
						Loop
					EndIf
					aAdd(aLine, aRotAuto[nIndex])
				Next

				If aEmpAuto != Nil .and. !Empty(aEmpAuto)
					For nIndex := 1 to len(aEmpAuto)
						aLineEnd := {}

						dbSelectArea("SDC")
						dbSetOrder(2)
						If dbSeek(xFilial("SDC")+SD4->D4_COD+SD4->D4_LOCAL+SD4->D4_OP+SD4->D4_TRT+SD4->D4_LOTECTL+SD4->D4_NUMLOTE)
							aAdd(aLineEnd,{"LINPOS","DC_LOCALIZ+DC_NUMSERI",;
						 	     aEmpAuto[nIndex][2],;
							     aEmpAuto[nIndex][3]})
						EndIf

						If valType(aEmpAuto[nIndex][5]) == "L" .and. aEmpAuto[nIndex][5]
							aAdd(aLineEnd, {"AUTDELETA", "S", Nil})
						Else
							aAdd(aLineEnd, {"DC_QUANT"  , aEmpAuto[nIndex][1], Nil})
							aAdd(aLineEnd, {"DC_LOCALIZ", aEmpAuto[nIndex][2], Nil})
							aAdd(aLineEnd, {"DC_NUMSERI", aEmpAuto[nIndex][3], Nil})
							aAdd(aLineEnd, {"D4_QTSEGUM", aEmpAuto[nIndex][4], Nil})
						EndIf

						aAdd(aEnd, aLineEnd)
					Next
					aAdd(aLine, {"AUT_D4_END", aEnd, Nil})
				EndIf

				aAdd(aItens, aLine)
				aAdd(aCab, {"INDEX", 2, Nil})

				MSExecAuto({|x,y,z| mata381(x,y,z)}, aCab, aItens, 4)
			EndIf
		EndIf

	ElseIf nOpcAuto == 5
		nPosCod  := aScan(aRotAuto, {|x| x[1] == "D4_COD"})

		BeginSQL alias cAliasCont
			SELECT Count(1) TOTAL
			  FROM %table:SD4% SD4
			 WHERE SD4.D4_FILIAL = %xfilial:SD4%
			   AND SD4.D4_OP = %exp:aRotAuto[nPosOP][2]%
			   AND SD4.%notDel%
		EndSQL

		If (cAliasCont)->(!EoF())
			nCont := (cAliasCont)->TOTAL
		EndIf
		(cAliasCont)->(dbCloseArea())

		aAdd(aCab, aRotAuto[nPosOP])
		aAdd(aCab, {"INDEX", 2, Nil})

		If nCont > 1
			lPos := buscaReg(aRotAuto)

			If lPos
				For nIndex := 1 To SD4->(FCount())
					aAdd(aLine, {SD4->(Field(nIndex)), SD4->(FieldGet(nIndex)), Nil})
				Next

				aAdd(aLine,{"LINPOS","D4_COD+D4_TRT+D4_LOTECTL+D4_NUMLOTE+D4_LOCAL+D4_OPORIG+D4_SEQ",;
							SD4->D4_COD,;
							SD4->D4_TRT,;
							SD4->D4_LOTECTL,;
							SD4->D4_NUMLOTE,;
							SD4->D4_LOCAL,;
							SD4->D4_OPORIG,;
							SD4->D4_SEQ})

				aAdd(aLine, {"AUTDELETA", "S", Nil})

				aAdd(aItens, aLine)
				MSExecAuto({|x,y,z| mata381(x,y,z)},aCab, aItens, 4)
			EndIf
		Else
			MSExecAuto({|x,y,z| mata381(x,y,z)},aCab, aItens, 5)
		EndIf
	EndIf
	ReSetModulo(aBkpMod)

	aSize(aEnd, 0)
	aSize(aLineEnd, 0)
	aSize(aCab, 0)
	aSize(aItens, 0)
	aSize(aLine, 0)

Return Nil

/*/{Protheus.doc} buscaReg
Posiciona no registro da SD4, com base nos dados informado no cabeçalho da execução automática.
@type  Static Function
@author Lucas Fagundes
@since 26/04/2022
@version P12
@param aDados, Array, Array com os dados do cabeçalho da execução automática.
@return lRet, Logico, Informa se posicionou ou não no registro.
/*/
Static Function buscaReg(aDados)
	Local cAlias     := GetNextAlias()
	Local cQueryCond := ""
	Local cChave     := ""
	Local lRet       := .F.
	Local nPosCod    := aScan(aDados, {|x| x[1] == "D4_COD"})
	Local nPosLocal  := aScan(aDados, {|x| x[1] == "D4_LOCAL"})
	Local nPosLote   := aScan(aDados, {|x| x[1] == "D4_LOTECTL"})
	Local nPosNLote  := aScan(aDados, {|x| x[1] == "D4_NUMLOTE"})
	Local nPosOP     := aScan(aDados, {|x| x[1] == "D4_OP"})
	Local nPosOpOrg  := aScan(aDados, {|x| x[1] == "D4_OPORIG"})
	Local nPosSeq    := aScan(aDados, {|x| x[1] == "D4_SEQ"})
	Local nPosTrt    := aScan(aDados, {|x| x[1] == "D4_TRT"})

	cQueryCond := "% SD4.D4_OP        = '" + aDados[nPosOP][2]  + "' "
	cQueryCond += " AND SD4.D4_FILIAL = '" + xFilial("SD4")     + "' "
	cQueryCond += " AND SD4.D4_COD    = '" + aDados[nPosCod][2] + "' "
	cQueryCond += Iif(nPosLocal != 0, " AND SD4.D4_LOCAL   = '" + aDados[nPosLocal][2] + "' ", " ")
	cQueryCond += Iif(nPosLote  != 0, " AND SD4.D4_LOTECTL = '" + aDados[nPosLote][2]  + "' ", " ")
	cQueryCond += Iif(nPosNLote != 0, " AND SD4.D4_NUMLOTE = '" + aDados[nPosNLote][2] + "' ", " ")
	cQueryCond += Iif(nPosOpOrg != 0, " AND SD4.D4_OPORIG  = '" + aDados[nPosOpOrg][2] + "' ", " ")
	cQueryCond += Iif(nPosSeq   != 0, " AND SD4.D4_SEQ     = '" + aDados[nPosSeq][2]   + "' ", " ")
	cQueryCond += Iif(nPosTrt   != 0, " AND SD4.D4_TRT     = '" + aDados[nPosTrt][2]   + "' ", " ")
	cQueryCond += " AND SD4.D_E_L_E_T_ = ' ' %"

	cChave := "D4_FILIAL := " + xFilial("SD4")
	cChave += CHR(10) + "D4_OP := " + aDados[nPosOP][2]
	cChave += CHR(10) + "D4_COD := " + aDados[nPosCod][2]
	cChave += Iif(nPosLocal != 0, CHR(10) + "D4_LOCAL := "   + aDados[nPosLocal][2], "")
	cChave += Iif(nPosLote  != 0, CHR(10) + "D4_LOTECTL := " + aDados[nPosLote][2] , "")
	cChave += Iif(nPosNLote != 0, CHR(10) + "D4_NUMLOTE := " + aDados[nPosNLote][2], "")
	cChave += Iif(nPosOpOrg != 0, CHR(10) + "D4_OPORIG := "  + aDados[nPosOpOrg][2], "")
	cChave += Iif(nPosSeq   != 0, CHR(10) + "D4_SEQ := "     + aDados[nPosSeq][2]  , "")
	cChave += Iif(nPosTrt   != 0, CHR(10) + "D4_TRT := "     + aDados[nPosTrt][2]  , "")

	BeginSQL alias cAlias
		SELECT SD4.R_E_C_N_O_
		  FROM %table:SD4% SD4
		 WHERE %exp:cQueryCond%
	EndSQL

	If (cAlias)->(!EoF())
		SD4->(dbGoTo((cAlias)->R_E_C_N_O_))
		lRet := .T.
	EndIf

	(cAlias)->(dbCloseArea())

	If !lRet
		AutoGRLog(STR0055) //"Pesquisa não encontrada para os dados informados na execução."
		AutoGRLog(cChave)
		AutoGRLog(Replicate("-",80))
	EndIf

Return lRet
