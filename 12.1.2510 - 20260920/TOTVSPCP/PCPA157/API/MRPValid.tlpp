#Include "TLPP-CORE.TH"
#Include "TOTVS.CH"
#Include "TLPP-REST.TH"
#Include "PCPA157.CH"

namespace totvs.protheus.manufacturing.mrp.apis

/*/{Protheus.doc} MRPValid
Classe de validacao de OPs efetivadas do CRP para o Cockpit MRP (PCPA157).
@author Joao Lucas de Jesus
@since 25/08/2026
@version P12
/*/
Class MRPValid

    public method new() as object

    @Get("api/pcp/v1/MRPValid/validacao/opsEfetivadas")
    public method getValidaOpsEfetivadas() as logical

    private method processGetValidaOpsEfetivadas(nPage as numeric, nPageSize as numeric, lFirmHorizon as logical, dMrpStartDate as date) as array
    private method trataErrorLogProcessamento(oError as object) as array
    private method setRespostaRest(aResposta as array) as logical

EndClass

/*/{Protheus.doc} new
Construtor da classe MRPValid.
@author Joao Lucas de Jesus
@since 25/08/2026
@version P12
@return Self
/*/
Method new() as object class MRPValid
Return Self

/*/{Protheus.doc} getValidaOpsEfetivadas
API para validar se existem OPs efetivadas pelo CRP que serao excluidas no processamento do MRP.
endpoint: [GET] api/pcp/v1/MRPValid/validacao/opsEfetivadas

QUERYPARAM:
mrpStartDate (character) -> Data base do MRP no formato AAAA-MM-DD.
firmHorizon (character) -> Indica se o horizonte firme deve ser considerado ("1" = sim, "2" = nao).
page (numeric) -> Numero da pagina a ser retornada.
pageSize (numeric) -> Numero de itens por pagina.

@author Joao Lucas de Jesus
@since 11/09/2026
@version P12
@return lRet, Logical, Retorna se processou com sucesso a requisicao.
/*/
Method getValidaOpsEfetivadas() as logical class MRPValid
    Local aReturnData   := {}        as array
    Local dMrpStartDate := dDataBase as date
    Local jQueryParams  := {}        as json
    Local lRet          := .T.       as logical

    oRest:setKeyHeaderResponse("Content-Type","application/json")

    jQueryParams := oRest:getQueryRequest()

    If jQueryParams:hasProperty("mrpStartDate") .And. !Empty(jQueryParams["mrpStartDate"])
        dMrpStartDate := PCPConvDat(jQueryParams["mrpStartDate"], 1)
    EndIf

    If jQueryParams:hasProperty("firmHorizon")
        jQueryParams["firmHorizon"] := jQueryParams["firmHorizon"] == "1"
    EndIf

    If jQueryParams:hasProperty("page")
        jQueryParams["page"] := Val(jQueryParams["page"])
    EndIf

    If jQueryParams:hasProperty("pageSize")
        jQueryParams["pageSize"] := Val(jQueryParams["pageSize"])
    EndIf

    TRY
        aReturnData := Self:processGetValidaOpsEfetivadas(jQueryParams["page"], jQueryParams["pageSize"], jQueryParams["firmHorizon"], dMrpStartDate)
    CATCH oError
        aReturnData := self:trataErrorLogProcessamento(oError)
    ENDTRY

    lRet := self:setRespostaRest(aReturnData)
Return lRet

/*/{Protheus.doc} trataErrorLogProcessamento
Realiza o tratamento de erros que ocorreram no processamento da busca de OPs
efetivadas, seguindo o mesmo padrao adotado em MRPLookups.
@author Joao Lucas de Jesus
@since 31/08/2026
@version P12
@param oError, Object, Objeto de error lancado pelo sistema.
@return aReturn, Array, Array com informacoes de retorno da API.
/*/
Method trataErrorLogProcessamento(oError as object) as array class MRPValid
    Local aReturn := Array(2) as array

    aReturn[1] := 500
    aReturn[2] := { "code": "500", "message": STR0108, "detailedMessage": oError:description } // "Erro ao consultar ordens de producao efetivadas pelo CRP."

    LogMsg("MRPValid", 0, 0, 1, "", "", AllTrim(oError:description) + CHR(10) + AllTrim(oError:errorStack))

Return aReturn

/*/{Protheus.doc} setRespostaRest
Encapsula o envio da resposta e liberacao de memoria
@author Joao Lucas de Jesus
@since 10/09/2026
@version P12
@param aResposta, Array, [1]=StatusCode, [2]=JsonObject
@return lRet, Logical, Retorna se a resposta foi enviada com sucesso.
/*/
Method setRespostaRest(aResposta as array) as logical class MRPValid
    Local lRet := .T. as logical

    oRest:setStatusCode(aResposta[1])
    lRet := oRest:setResponse(aResposta[2]:toJson())

    FreeObj(aResposta[2])
    aSize(aResposta, 0)
Return lRet

/*/{Protheus.doc} processGetValidaOpsEfetivadas
Processa a busca de OPs efetivadas pelo CRP que serao excluidas no processamento do MRP.
Retorna apenas os itens da pagina solicitada e se existe proxima pagina.
@author Joao Lucas de Jesus
@since 25/08/2026
@version P12
@param nPage, Numeric, Numero da pagina.
@param nPageSize, Numeric, Tamanho da pagina.
@param lFirmHorizon, Logical, Indica se o horizonte firme deve ser considerado.
@param dMrpStartDate, Date, Data base de inicio do MRP recebida do frontend.
@return aReturn, Array, [1] = HTTP status, [2] = Json { items[], hasNext }.
/*/
Method processGetValidaOpsEfetivadas(nPage as numeric, nPageSize as numeric, lFirmHorizon as logical, dMrpStartDate as date) as array class MRPValid
    Local aFilCent    := {}                 as array
    Local aFiliais    := {cFilAnt}          as array
    Local aReturn     := Array(2)           as array
    Local cAlias      := GetNextAlias()     as character
    Local cFiltOp     := ""                 as character
    Local cQuery      := ""                 as character
    Local jItem       := Nil                as json
    Local jResponse   := JsonObject():New() as json
    Local nCount      := 0                  as numeric
    Local nIndFil     := 1                  as numeric
    Local nTotFil     := 0                  as numeric

    aFilCent := A712FilME(.F.)
    For nIndFil := 1 To Len(aFilCent)
        aAdd(aFiliais, aFilCent[nIndFil][1])
    Next nIndFil
    nTotFil := Len(aFiliais)

    For nIndFil := 1 To nTotFil
        cFiltOp += " SELECT DISTINCT RTRIM(SC2.C2_NUM||SC2.C2_ITEM||SC2.C2_SEQUEN||SC2.C2_ITEMGRD) AS NUMOP "
        cFiltOp +=   " FROM " + RetSqlName("SC2") + " SC2"
        cFiltOp +=  " WHERE SC2.C2_FILIAL = HWF.HWF_FILIAL "
        cFiltOp +=    " AND " + PCPQrySC2("SC2", "HWF.HWF_OP")
        cFiltOp +=    " AND HWF.D_E_L_E_T_ = ' ' "
        
        cFiltOp +=    " AND " + A146FilSC2(aFiliais[nIndFil], dMrpStartDate, lFirmHorizon, "")

        If nIndFil <= nTotFil - 1
            cFiltOp += " UNION ALL "
        EndIf
    Next nIndFil

    cFiltOp := " AND RTRIM(HWF.HWF_OP) IN (" + cFiltOp + ")"

    cQuery := PCPA152Efetivacao():getOpsEfetivadas(cFiltOp, aFiliais)

    dbUseArea(.T., "TOPCONN", TcGenQry( , , cQuery), cAlias, .F., .T.)

    If nPage > 1 .And. nPageSize > 0
        (cAlias)->(dbSkip((nPage - 1) * nPageSize))
    EndIf

    jResponse["items"  ] := {}
    jResponse["hasNext"] := .F.

    While (cAlias)->(!EoF())
        nCount++

        jItem := JsonObject():New()

        jItem["filial"]            := RTrim((cAlias)->HWF_FILIAL)
        jItem["numOp"]             := RTrim((cAlias)->HWF_OP)
        jItem["operacao"]          := (cAlias)->HWF_OPER
        jItem["produto"]           := RTrim((cAlias)->C2_PRODUTO)
        jItem["descricaoProduto"]  := RTrim((cAlias)->B1_DESC)
        jItem["descricaoOperacao"] := RTrim((cAlias)->DESCRICAO)
        jItem["dataInicial"]       := (cAlias)->DATAINI 
        jItem["dataFinal"]         := (cAlias)->DATAFIM

        aAdd(jResponse["items"], jItem)

        (cAlias)->(dbSkip())
        If nCount >= nPageSize
            Exit
        EndIf
    EndDo

    jResponse["hasNext"] := (cAlias)->(!EoF())
    (cAlias)->(dbCloseArea())

    aReturn[1] := 200
    aReturn[2] := jResponse

Return aReturn
