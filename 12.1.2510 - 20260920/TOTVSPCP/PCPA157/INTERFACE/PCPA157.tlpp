#Include "TLPP-CORE.TH"
#Include "TOTVS.CH"

/*/{Protheus.doc} PCPA157
Chamada da tela do cockpit do MRP.
@type  Function
@author Lucas Fagundes
@since 05/08/2026
@version P12
@return Nil
/*/
Function PCPA157()

    If PCPVldApp()
        P157CallApp()
    EndIf

Return Nil

/*/{Protheus.doc} PCPA157Interface
Classe de interface do cockpit do MRP.
@author Lucas Fagundes
@since 19/08/2026
@version P12
/*/
Class PCPA157Interface

    static method processJsToAdvpl(oWebChannel as object, cType as character, cContent as character) as logical

EndClass

/*/{Protheus.doc} processJsToAdvpl
Processo as chamadas da tela.

@author Lucas Fagundes
@since 19/08/2026
@version P12
@param oWebChannel, Object, Instancia da classe TWebEngine.
@param cType, Character, Parâmetro de tipo.
@param cContent, Character, Conteúdo enviado pela tela.
@return .T.
/*/
Method processJsToAdvpl(oWebChannel as object, cType as character, cContent as character) as logical class PCPA157Interface
    Local jResponse := JsonObject():New() as json

    If cType == "loadData"
        jResponse := {;
            "HW2_DESCRI": {;
                "exists": GetSx3Cache("HW2_DESCRI", "X3_TAMANHO") > 0,;
                "size": GetSx3Cache("HW2_DESCRI", "X3_TAMANHO");
            };
        }
    EndIf

    oWebChannel:AdvPLToJS(cType, jResponse:toJson())

Return .T.
