#Include "TLPP-CORE.TH"
#Include "TOTVS.CH"
#Include "dtamrpeventsselection.ch"

#DEFINE STATUS_HZQ_PENDENTE    "0"
#DEFINE STATUS_HZQ_ERRO        "3"

/*/{Protheus.doc} DTAMRPEventsSelection
Classe responsável pelas ferramentas de criação de regras e seleção de documentos para atualização no processo do agente de Eventos do MRP

@author lucas.franca
@since 25/08/2026
@version P12
/*/
Class DTAMRPEventsSelection
	Static Method setDataParams(jFilters as Json) as Array
	Static Method setDataGridFilters(jFilters as Json) as Array
	Static Method loadTool() as Character
	Static Method loadToolSelectionByGridFilters() as Character
	Static Method loadToolSelectionByParams() as Character
	Static Method processSelection(cTicket as Character, cFilters as Character, cMode as Character) as Json
EndClass

/*/{Protheus.doc} loadTool
Método que faz a carga das propriedades das ferramentas disponíveis por esta classe. Alimenta as tabelas HZV/HZW.

@author lucas.franca
@since 25/08/2026
@version P12
@return cErrorMessage, Character, Indica se houve erro na carga da ferramenta
/*/
Method loadTool() as Character Class DTAMRPEventsSelection
	Local cErrorMessage := "" as Character

	cErrorMessage += DTAMRPEventsSelection():loadToolSelectionByParams()
	cErrorMessage += DTAMRPEventsSelection():loadToolSelectionByGridFilters()
Return cErrorMessage

/*/{Protheus.doc} loadToolSelectionByParams
Método que faz a carga da tool set_mrp_events_selection_by_params, responsável por tratar a seleção dos documentos conforme regras definidas pelo usuário.

@author lucas.franca
@since 25/08/2026
@version P12
@return cErrorMessage, Character, Indica se houve erro na carga da ferramenta
/*/
Method loadToolSelectionByParams() as Character Class DTAMRPEventsSelection
	Local cDescription  as Character
	Local cErrorMessage as Character
	Local cName         as Character
	Local cVersion      as Character
	Local jParameters   as Json
	Local oLoadTool     as Object

	cName    := "set_mrp_events_selection_by_params"
	cVersion := "001"

	If DTALoad():toolIsUpdated(cName, cVersion)
		Return ""
	EndIf

	jParameters := JsonObject():New()

	jParameters["selection_mode"] := JsonObject():New()
	jParameters["selection_mode"]["type"] := "string"
	jParameters["selection_mode"]["description"] := STR0001 //"Adicionar ou remover a seleção. Inferência: marcar=adicionar, desmarcar=remover."
	jParameters["selection_mode"]["enum"] := {"ADD", "REMOVE"}

	jParameters["delivery_date_range"] := JsonObject():New()
	jParameters["delivery_date_range"]["type"] := "object"
	jParameters["delivery_date_range"]["description"] := STR0002 //"Intervalo de datas de entrega dos documentos."
	jParameters["delivery_date_range"]["properties"] := JsonObject():New()
	jParameters["delivery_date_range"]["properties"]["start_date"] := JsonObject():New()
	jParameters["delivery_date_range"]["properties"]["start_date"]["type"] := "string"
	jParameters["delivery_date_range"]["properties"]["start_date"]["description"] := STR0003 //"Data inicial"
	jParameters["delivery_date_range"]["properties"]["end_date"] := JsonObject():New()
	jParameters["delivery_date_range"]["properties"]["end_date"]["type"] := "string"
	jParameters["delivery_date_range"]["properties"]["end_date"]["description"] := STR0004 //"Data final"

	jParameters["document_types"] := JsonObject():New()
	jParameters["document_types"]["type"] := "array"
	jParameters["document_types"]["description"] := I18N(STR0005, {"OP", "SC", "PC", "AE"}) //"Tipos de documentos. Codigos: OP=Ordem de Produção, SC=Solicitação de Compra, PC=Pedido de Compra, AE=Autorização de Entrega."
	jParameters["document_types"]["type"] := "array"
	jParameters["document_types"]["items"] := JsonObject():New()
	jParameters["document_types"]["items"]["type"] := "string"
	jParameters["document_types"]["items"]["enum"] := {"OP", "SC", "PC", "AE"}

	jParameters["action_types"] := JsonObject():New()
	jParameters["action_types"]["type"] := "array"
	jParameters["action_types"]["description"] := STR0006 //"Tipos de eventos sugeridos pelo MRP. Códigos: 002=Atrasar, 003=Adiantar, 007=Cancelar."
	jParameters["action_types"]["items"] := JsonObject():New()
	jParameters["action_types"]["items"]["type"] := "string"
	jParameters["action_types"]["items"]["enum"] := {"002", "003", "007"}

	jParameters["product_filters"] := JsonObject():New()
	jParameters["product_filters"]["type"] := "object"
	jParameters["product_filters"]["description"] := STR0007 //"Critérios para identificar os produtos a serem considerados na seleção dos documentos."
	jParameters["product_filters"]["properties"] := JsonObject():New()
	jParameters["product_filters"]["properties"]["codes"] := JsonObject():New()
	jParameters["product_filters"]["properties"]["codes"]["type"] := "array"
	jParameters["product_filters"]["properties"]["codes"]["description"] := STR0008 //"Lista de códigos específicos de produtos. Exemplo: ['PROD1', 'PROD2']"
	jParameters["product_filters"]["properties"]["codes"]["items"] := JsonObject():New()
	jParameters["product_filters"]["properties"]["codes"]["items"]["type"] := "string"
	jParameters["product_filters"]["properties"]["material_types"] := JsonObject():New()
	jParameters["product_filters"]["properties"]["material_types"]["type"] := "array"
	jParameters["product_filters"]["properties"]["material_types"]["description"] := STR0009 //"Lista de tipos de material do produto. Exemplo: ['PA', 'PI', 'MP']"
	jParameters["product_filters"]["properties"]["material_types"]["items"] := JsonObject():New()
	jParameters["product_filters"]["properties"]["material_types"]["items"]["type"] := "string"
	jParameters["product_filters"]["properties"]["stock_groups"] := JsonObject():New()
	jParameters["product_filters"]["properties"]["stock_groups"]["type"] := "array"
	jParameters["product_filters"]["properties"]["stock_groups"]["description"] := STR0010 //"Lista de grupos de estoque de produtos. Exemplo: ['0001', '0009']"
	jParameters["product_filters"]["properties"]["stock_groups"]["items"] := JsonObject():New()
	jParameters["product_filters"]["properties"]["stock_groups"]["items"]["type"] := "string"

	jParameters["warehouses"] := JsonObject():New()
	jParameters["warehouses"]["type"] := "array"
	jParameters["warehouses"]["description"] := STR0011 //"Códigos de armazéns relacionados aos documentos. Exemplo: ['01', 'AL', 'L1']"
	jParameters["warehouses"]["items"] := JsonObject():New()
	jParameters["warehouses"]["items"]["type"] := "string"

	jParameters["save_as_rule"] := JsonObject():New()
	jParameters["save_as_rule"]["type"] := "boolean"
	jParameters["save_as_rule"]["description"] := I18N(STR0012, {"true", "false"}) //"Deve ser 'true' quando o usuário pedir para salvar como regra para os próximos tickets. Deve ser 'false' quando o usuário pedir para aplicar somente no ticket atual. Se o usuário já indicar isso explicitamente na demanda, respeite a intenção informada sem nova inferência."

	cDescription := STR0013 //"Seleciona ou remove documentos do MRP por parâmetros informados no chat (datas, tipos, produtos, armazéns). Use quando o pedido não for sobre itens da tela/grid atual."

	oLoadTool := DTALoad():New()
	oLoadTool:setName(cName)
	oLoadTool:setClassName("DTAMRPEventsSelection")
	oLoadTool:setDataMethod("setDataParams")
	oLoadTool:setVersion(cVersion)
	oLoadTool:setDescription(cDescription)
	oLoadTool:setShortDescription(STR0014) //"Seleciona ou remove documentos na lista de sugestões do MRP"
	oLoadTool:setContext("resultadomrp")
	oLoadTool:setGroup("resultado_mrp")
	oLoadTool:setExample(STR0015) //"Desmarque os pedidos de compra."
	oLoadTool:setExample(STR0016) //"Desmarque SC e PC com entrega entre 2026-06-01 e 2026-06-15."
	oLoadTool:setExample(STR0017) //"Marque apenas OPs do armazém '01'."
	oLoadTool:setExample(STR0018) //"Marque documentos dos produtos 'PA0001' e 'PA0002'."
	oLoadTool:setExample(STR0019) //"Somente neste ticket, marque OP e SC do armazém '02'."
	oLoadTool:setExample(STR0020) //"Desmarque cancelamento de PC e salve como regra."
	oLoadTool:addParameter("selection_mode"     , , , .T., , jParameters["selection_mode"])
	oLoadTool:addParameter("delivery_date_range", , , .F., , jParameters["delivery_date_range"])
	oLoadTool:addParameter("document_types"     , , , .F., , jParameters["document_types"])
	oLoadTool:addParameter("action_types"       , , , .F., , jParameters["action_types"])
	oLoadTool:addParameter("product_filters"    , , , .F., , jParameters["product_filters"])
	oLoadTool:addParameter("warehouses"         , , , .F., , jParameters["warehouses"])
	oLoadTool:addParameter("save_as_rule"       , , , .T., , jParameters["save_as_rule"])
	If !oLoadTool:createTool()
		cErrorMessage := oLoadTool:getErrorMessage()
	EndIf
	oLoadTool:Destroy()
	FreeObj(jParameters)
Return cErrorMessage

/*/{Protheus.doc} setDataParams
Atualiza a seleção dos documentos do agente de Eventos do MRP com base nas regras informadas. 
Também pode registrar a regra na HZR para reutilização em processamentos futuros do MRP.

@author lucas.franca
@since 25/08/2026
@version P12
@param 01 jFilters, Json, Regras que serão aplicadas para a seleção dos registros
@return aReturn, Array, Array com os dados encontrados, sendo:
        aReturn[1] - Logical - Identifica se processou com sucesso.
        aReturn[2] - Json    - Dados do procesamento.
        aReturn[3] - Numeric - Status que representa o retorno (200 ok, 400 erro.)
/*/
Method setDataParams(jFilters as Json) as Array Class DTAMRPEventsSelection
	Local aDocTypes   as Array
	Local aReturn     as Array
	Local cTicket     as Character
	Local lSaveAsRule as Logical
	Local nIndex      as Integer
	Local oAgentDocs  as Object

	If !jFilters:HasProperty("contextParams") .Or. ;
	   !jFilters["contextParams"]:HasProperty("params") .Or. ;
	   !jFilters["contextParams"]["params"]:HasProperty("ticket")
		Return DTAUtils():APIErrorMessage(400, STR0021) //"Ticket não informado nos parâmetros de contexto."
	EndIf

	cTicket     := AllTrim(jFilters["contextParams"]["params"]["ticket"])
	lSaveAsRule := jFilters["save_as_rule"]
	jFilters:DelName("contextParams")
	jFilters:DelName("save_as_rule")

	//aqui preciso passar o document_type no formato da tabela 1,2,3,4
	If jFilters:HasProperty("document_types")
		aDocTypes := {}
		For nIndex := 1 To Len(jFilters["document_types"])
			If jFilters["document_types"][nIndex] == "OP"
				aAdd(aDocTypes, "1")
			ElseIf jFilters["document_types"][nIndex] == "SC"
				aAdd(aDocTypes, "2")
			ElseIf jFilters["document_types"][nIndex] == "PC"
				aAdd(aDocTypes, "3")
			ElseIf jFilters["document_types"][nIndex] == "AE"
				aAdd(aDocTypes, "4")
			EndIf
		Next nIndex
		jFilters["document_types"] := aDocTypes
		aDocTypes := Nil
	EndIf

	If lSaveAsRule
		DTAAgentMRPPreferences():save(jFilters:ToJson())
	EndIf

	oAgentDocs := DTAAgentMRPDocuments():new(jFilters, cTicket)
	If !oAgentDocs:updateChecks()
		Return DTAUtils():APIErrorMessage(400, I18N(STR0022, {})) //"Ocorreu erro na atualização de documentos"
	EndIf
	oAgentDocs:Destroy()

	aReturn := {.T., {"context": "", "data": {"refresh": .T.}, "suggestions": Array(0)}, 200}
Return aReturn

/*/{Protheus.doc} loadToolSelectionByGridFilters
Método que faz a carga da tool set_mrp_events_selection_by_grid_filters, responsável por tratar a seleção dos documentos conforme filtros aplicados em tela.

@author lucas.franca
@since 25/08/2026
@version P12
@return cErrorMessage, Character, Indica se houve erro na carga da ferramenta
/*/
Method loadToolSelectionByGridFilters() as Character Class DTAMRPEventsSelection
	Local cDescription  as Character
	Local cErrorMessage as Character
	Local cName         as Character
	Local cVersion      as Character
	Local jParameters   as Json
	Local oLoadTool     as Object

	cName    := "set_mrp_events_selection_by_grid_filters"
	cVersion := "001"

	If DTALoad():toolIsUpdated(cName, cVersion)
		Return ""
	EndIf

	jParameters := JsonObject():New()
	jParameters["selection_mode"] := JsonObject():New()
	jParameters["selection_mode"]["type"] := "string"
	jParameters["selection_mode"]["description"] := STR0001 //"Adicionar ou remover a seleção. Inferência: marcar=adicionar, desmarcar=remover."
	jParameters["selection_mode"]["enum"] := {"ADD", "REMOVE"}

	cDescription := STR0023 //"Seleciona ou remove documentos do MRP com base nos filtros já aplicados na tela/grid. Use quando o pedido citar tela, grid, itens visíveis ou já filtrados."

	oLoadTool := DTALoad():New()
	oLoadTool:setName(cName)
	oLoadTool:setClassName("DTAMRPEventsSelection")
	oLoadTool:setDataMethod("setDataGridFilters")
	oLoadTool:setVersion(cVersion)
	oLoadTool:setDescription(cDescription)
	oLoadTool:setShortDescription(STR0024) //"Seleciona documentos do MRP usando os filtros atuais da tela/grid."
	oLoadTool:setContext("resultadomrp")
	oLoadTool:setGroup("resultado_mrp")
	oLoadTool:setExample(STR0025) //"Marque os documentos que estão filtrados na minha tela."
	oLoadTool:setExample(STR0026) //"Desmarque os documentos conforme os filtros da grid."
	oLoadTool:setExample(STR0027) //"Marque os registros retornados pelo filtro atual da tela."
	oLoadTool:setExample(STR0028) //"Desmarque somente o resultado da consulta atual na grid."

	oLoadTool:addParameter("selection_mode", , , .T., , jParameters["selection_mode"])

	If !oLoadTool:createTool()
		cErrorMessage := oLoadTool:getErrorMessage()
	EndIf
	oLoadTool:Destroy()
	FreeObj(jParameters)
Return cErrorMessage

/*/{Protheus.doc} setDataGridFilters
Processa a solicitação de seleção de documentos do MRP com base nos filtros já aplicados na grid,
validando o contexto recebido e retornando os dados necessários para atualização da interface.

@type Static Method
@author lucas.franca
@since 16/06/2026
@param 01 jFilters, Json, JSON com os parâmetros de contexto, filtro atual da grid e modo de seleção
@return aReturn, Array, Array padrão de resposta da ferramenta com status, contexto e dados da operação
/*/
Method setDataGridFilters(jFilters as Json) as Array Class DTAMRPEventsSelection
	Local aReturn  as Array
	Local cTicket  as Character
	Local cMode    as Character
	Local cContext as Character
	Local jData    as Json

	If !jFilters:HasProperty("contextParams") .Or. ;
	   !jFilters["contextParams"]:HasProperty("params") .Or. ;
	   !jFilters["contextParams"]["params"]:HasProperty("ticket")
		Return DTAUtils():APIErrorMessage(400, STR0021) //"Ticket não informado nos parâmetros de contexto."
	EndIf

	If !jFilters:HasProperty("contextParams") .Or. ;
	   !jFilters["contextParams"]:HasProperty("params") .Or. ;
	   !jFilters["contextParams"]["params"]:HasProperty("filter") .Or. ;
	   Empty(jFilters["contextParams"]["params"]["filter"])
		Return DTAUtils():APIErrorMessage(400, STR0029) //"Filtros não informados nos parâmetros de contexto."
	EndIf

	cTicket  := AllTrim(jFilters["contextParams"]["params"]["ticket"])
	cFilters := jFilters["contextParams"]["params"]["filter"]
	cMode    := jFilters["selection_mode"]

	If cMode != "ADD" .And. cMode != "REMOVE"
		Return DTAUtils():APIErrorMessage(400, STR0030) //"Modo de seleção inválido. Use 'ADD' para adicionar ou 'REMOVE' para remover a seleção."
	EndIf

	jData    := DTAMRPEventsSelection():processSelection(cTicket, cFilters, cMode)
	cContext := I18N(STR0031, {"refresh"})//"A informação de 'refresh' é de controle interno e não deve ser considerado para nada em sua resposta."
	If jData["quantity_records_updated"] == 0
		cContext += "\n" + STR0032 //"Nenhum documento foi atualizado com os filtros selecionados."
	Else
		cContext += "\n" + STR0033 //"Utilize as informações descritas em 'data' para relatar ao usuário o resultado da operação."
	EndIf

	aReturn := {.T., {"context": cContext, "data": jData, "suggestions": Array(0)}, 200}
	jData   := Nil

Return aReturn

/*/{Protheus.doc} processSelection
Processa a seleção de documentos do MRP a partir dos filtros atuais da grid, recuperando os registros
correspondentes e aplicando a operação de marcação ou desmarcação.

@type Static Method
@author lucas.franca
@since 16/06/2026
@param 01 cTicket , Character, Ticket do contexto utilizado para buscar os eventos
@param 02 cFilters, Character, Filtros da grid serializados para localizar os documentos
@param 03 cMode   , Character, Operação de seleção a ser aplicada nos registros encontrados (ADD ou REMOVE)
@return jData, Json, Objeto com a quantidade de registros atualizados e indicador de refresh
/*/
Method processSelection(cTicket as Character, cKendoFilter as Character, cMode as Character) as Json Class DTAMRPEventsSelection
	Local aData            as Array
	Local aRecnos          as Array
	Local cFilter          as Character
	Local jData            as Json
	Local oAgentProcEvents as Object

	aRecnos := {}
	cFilter := "HZQ.HZQ_STATUS IN ('" + STATUS_HZQ_PENDENTE + "', '" + STATUS_HZQ_ERRO + "')"

	oAgentProcEvents := totvs.protheus.manufacturing.agent.mrp.events.DTAAgentMRPProcEvents():New()
	aData := oAgentProcEvents:processGetEvents(cTicket, 1, 999999999, cKendoFilter, "S", cFilter)
	
	aEval(aData[2]["items"], {|x| aAdd(aRecnos, x["recno"])})
	DTAAgentMRPDocuments():updateChecksByRecno(aRecnos, cMode)
	
	jData := {"quantity_records_updated": Len(aRecnos), "refresh": .F.}
	If jData["quantity_records_updated"] > 0
		jData["refresh"] = .T.
	EndIf

	oAgentProcEvents:destroy()
	aSize(aData, 0)
	aSize(aRecnos, 0)
	FreeObj(oAgentProcEvents)
Return jData
