#Include "TLPP-CORE.TH"
#Include "TOTVS.CH"
#Include "DTAConversationList.ch"

#DEFINE BREAK_LINE " \n "

/*/{Protheus.doc} DTAConversationList
Ferramenta do DTA que traz as sugestões de assuntos para conversação

@author lucas.franca/renan.roeder
@since 31/01/2025
@version P12
/*/
Class DTAConversationList
	Static Method getData(jFilters as Json) as Array
	Static Method loadTool() as Character
	Static Method getGroups(cContextName as Character) as Array
	Static Method getTools(cContextName as Character, aGroups as Array) as Array
EndClass

/*/{Protheus.doc} loadTool
Método que faz a carga das propriedades das ferramentas disponíveis por esta classe. Alimenta as tabelas HZV/HZW.

@author lucas.franca/renan.roeder
@since 31/01/2025
@version P12
@return cErrorMessage, Character, Indica se houve erro na carga da ferramenta
/*/
Method loadTool() as Character Class DTAConversationList
	Local cDescription  := ""                      as Character
	Local cErrorMessage := ""                      as Character
	Local cName         := "get_conversation_list" as Character
	Local cVersion      := "001"                   as Character
	Local oLoadTool     := Nil                     as Object

	If DTALoad():toolIsUpdated(cName, cVersion)
		Return ""
	EndIf

	cDescription := STR0001 //"Disponibiliza os assuntos que o usuário pode conversar ou consultar."
	oLoadTool := DTALoad():New()
	oLoadTool:setName(cName)
	oLoadTool:setClassName("DTAConversationList")
	oLoadTool:setDataMethod("getData")
	oLoadTool:setVersion(cVersion)
	oLoadTool:setDescription(cDescription)
	oLoadTool:setShortDescription(STR0002) //"Retorna quais são os assuntos disponíveis para conversação"
	oLoadTool:setExample(STR0003) //"Sobre quais assuntos podemos conversar?"
	oLoadTool:setExample(I18N(STR0004, {"description"})) //"O que posso falar sobre o assunto '#1[ASSUNTO]#'?"
	oLoadTool:addGlossary("items", STR0005) //"Assuntos disponíveis"
	oLoadTool:addGlossary("detail", STR0006) //"Detalhamento dos assuntos"
	If !oLoadTool:createTool()
		cErrorMessage := oLoadTool:getErrorMessage()
	EndIf
	oLoadTool:Destroy()
Return cErrorMessage

/*/{Protheus.doc} getData
Retorna uma lista dos assuntos disponíveis para conversação

@author lucas.franca/renan.roeder
@since 21/01/2025
@version P12
@param 01 jFilters, Json, Filtros que serão aplicados para a busca das ordens.
@return aReturn, Array, Array com os dados encontrados, sendo:
        aReturn[1] - Logical - Identifica se processou com sucesso a busca.
        aReturn[2] - Json    - Dados obtidos na busca ou mensagem de erro caso não consiga fazer a busca.
        aReturn[3] - Numeric - Status que representa o retorno (200 ok, 400 erro.)
/*/
Method getData(jFilters as Json) as Array Class DTAConversationList
	Local aReturn      as Array
	Local cContextName as Character
	Local nIndex       as Integer
	Local jData        as Json

	cContextName := "geral"
	If jFilters:hasProperty("contextParams") .And. jFilters["contextParams"]:hasProperty("contextName")
		cContextName := jFilters["contextParams"]["contextName"]
	EndIf
	
	jData := {"context": "", "suggestions": Array(0), "data": Nil}
	jData["data"] := {"items": DTAConversationList():getGroups(cContextName), "detail": {}, "hasNext": .F.}

	jData["context"] := I18N(STR0007, {"items", "subject_name", "description"}) //"Exiba apenas a lista de '#1[NOMELISTA]#' onde '#2[TITULO]#' é o título do assunto e '#3[DESCRICAO]#' é o texto do assunto."
	jData["context"] += BREAK_LINE + I18N(STR0008, {"detail", "subject_name"}) //"Se o usuário solicitar mais informações sobre um assunto, você encontrará essas informações na seção '#1[DETALHES]#', e deverá exibir esses detalhes em uma lista com todos os itens que possuam o '#2[ASSUNTO]#' solicitado."
	jData["context"] += BREAK_LINE + I18N(STR0009, {"detail_function", "detail_description", "detail_examples"}) //"Cada item da lista é composto pelo atributo '#1[FUNCAO]#', que é o nome da função, '#2[DESCRICAO]#', que descreve o que essa função faz, e '#3[EXEMPLOS]#', que é uma lista com exemplos de como ela pode ser invocada."
	jData["context"] += BREAK_LINE + STR0010 //"Considere otimizar a descrição da função e sempre exibir ao menos um dos exemplos da lista, quando houver."
	
	If Len(jData["data"]["items"]) > 0
		jData["data"]["detail"] := DTAConversationList():getTools(cContextName, jData["data"]["items"])
		nIndex := Random(1, Len(jData["data"]["items"]))
		aAdd(jData["suggestions"], {"label": I18N(STR0011, {jData["data"]["items"][nIndex]["description"]})}) //"O que posso falar sobre o assunto #1[ASSUNTO]#?"
		aReturn := {.T., jData, 200}
	Else
		aReturn := DTAUtils():APIErrorMessage(400, STR0012) //"Nenhum assunto foi encontrado."
	EndIf

	jData := Nil
Return aReturn

/*/{Protheus.doc} getGroups
Obtém a lista de grupos/assuntos disponíveis para conversação de acordo com o contexto informado

@author lucas.franca
@since 17/04/2026
@version P12
@param 01 cContextName, Character, Nome do contexto para filtrar os grupos disponíveis
@return aGroups, Array, Array contendo os grupos com as propriedades:
        aGroups[n]["subject_name"] - Identificador do grupo/assunto
        aGroups[n]["description"] - Descrição do grupo/assunto
/*/
Method getGroups(cContextName as Character) as Array Class DTAConversationList
	Local aGroups := {} as Array
	Local cAlias        as Character
	Local cQuery        as Character
	Local oQuery		as Object
	
	cQuery := "SELECT HZX.HZX_GRUPO, HZX.HZX_NOME "
	cQuery +=   "FROM " + RetSqlName("HZX") + " HZX "
	cQuery +=  "WHERE HZX.HZX_FILIAL = ? "
	cQuery +=    "AND HZX.D_E_L_E_T_ = ' ' "
	cQuery +=    "AND EXISTS (SELECT 1 FROM " + RetSqlName("HZV") + " HZV "
	cQuery +=                 "WHERE HZV.HZV_FILIAL = ? "
	cQuery +=                   "AND HZV.HZV_GRUPO = HZX.HZX_GRUPO "
	If DTALoad():hasToolContext()
		cQuery +=               "AND HZV.HZV_CONTEX = ? "
	EndIf
	cQuery +=                   "AND HZV.D_E_L_E_T_ = ' ') "
	cQuery +=  "ORDER BY HZX.HZX_GRUPO "
	
	oQuery := FwExecStatement():New(cQuery)
	oQuery:setString(1, xFilial("HZX"))
	oQuery:setString(2, xFilial("HZV"))
	If DTALoad():hasToolContext()
		oQuery:setString(3, cContextName)
	EndIf

	cAlias := oQuery:openAlias()
	While (cAlias)->(!Eof())
		aAdd(aGroups, {"subject_name": RTrim((cAlias)->HZX_GRUPO), "description": RTrim((cAlias)->HZX_NOME)})
		(cAlias)->(dbSkip())
	End
	(cAlias)->(dbCloseArea())
	oQuery:Destroy()
	FreeObj(oQuery)

Return aGroups

/*/{Protheus.doc} getTools
Obtém a lista de ferramentas/funções disponíveis do contexto

@author lucas.franca
@since 17/04/2026
@version P12
@param 01 cContextName, Character, Nome do contexto para filtrar as ferramentas disponíveis
@param 02 aGroups     , Array    , Array contendo os grupos/assuntos disponíveis
@return aTools, Array, Array contendo as ferramentas com as propriedades:
        aTools[n]["detail_function"]    - Nome da função/ferramenta
        aTools[n]["detail_description"] - Descrição da ferramenta
        aTools[n]["subject_name"]       - Assunto/grupo ao qual a ferramenta pertence
        aTools[n]["detail_examples"]    - Array com exemplos de uso da ferramenta
/*/
Method getTools(cContextName as Character, aGroups as Array) as Array Class DTAConversationList
	Local aTools       := {}  as Array
	Local cAlias       := ""  as Character
	Local cFilter      := ""  as Character
	Local jGroups      := Nil as Json
	Local jTool        := Nil as Json
	
	jGroups := JsonObject():New()
	aEval(aGroups, {|x| jGroups[x["subject_name"]] := .T. })
	cFilter := "%" + DTAUtils():buildToolFilter(cContextName, jGroups:getNames()) + "%"

	cAlias := GetNextAlias()
	BeginSql Alias cAlias
		SELECT HZV.HZV_FUNCAO, HZV.HZV_GRUPO, HZV.HZV_DESCRI
		  FROM %Table:HZV% HZV
		 WHERE HZV.HZV_FILIAL = %xFilial:HZV%
		   AND %Exp:cFilter%
		   AND HZV.%NotDel%
		 ORDER BY HZV.HZV_GRUPO, HZV.HZV_FUNCAO
	EndSql
	While (cAlias)->(!Eof())
		jTool := {;
			"detail_function": RTrim((cAlias)->HZV_FUNCAO),;
			"detail_description": (cAlias)->HZV_DESCRI,;
			"subject_name": RTrim((cAlias)->HZV_GRUPO),;
			"detail_examples": DTAUtils():getToolExamples((cAlias)->HZV_FUNCAO);
		}
		If !jGroups:hasProperty(jTool["subject_name"])
			//quando traz um grupo que não está no filtro, indica uma tool adicional no contexto. Nesse caso remove o vínculo com o grupo.
			jTool["subject_name"] := ""
		EndIf
		aAdd(aTools, jTool)
		(cAlias)->(dbSkip())
	End
	(cAlias)->(dbCloseArea())

	jTool := Nil
	FreeObj(jGroups)
Return aTools
