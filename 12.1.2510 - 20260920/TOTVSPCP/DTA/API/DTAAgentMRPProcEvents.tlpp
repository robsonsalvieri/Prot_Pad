/*/{Protheus.doc} DTAAgentMRPProcEvents
Classe da API de retorno dos eventos e documentos processados pelo agente

@type class
@author marcelo.neumann
@since 16/12/2025
@version P12
/*/
Class DTAAgentMRPProcEvents

	Private Data jMapFieldsHZQ            as Json
	Private Data nThreads                 as Integer
	Private Data oQueryPurchaseItems      as Object
	Private Data oQueryPurchaseOrderItems as Object

	Public Method new() as Object
	Public Method destroy()

	@Get("api/pcp/v1/DTAAgentMRPProcEvents/events/:ticket")
	Public Method getEvents() as Logical
	@Patch("api/pcp/v1/DTAAgentMRPProcEvents/check/:recno")
	Public Method patchCheckEvent() as Logical
	@Post("api/pcp/v1/DTAAgentMRPProcEvents/events/updateDocuments/:ticket")
	Public Method postUpdateDocuments() as Logical

	Public Method buildProcessableHZQFilter(cAlias as Character) as Character
	Public Method clearGlobalsThreads(cKey as Character)
	Public Method documentErrorRecover(jProcessData as Json, nDocumentIndex as Integer, oError as Object)
	Public Method mapFieldsHZQ()
	Public Method processCheckEvent(nRecno as Integer) as Array
	Public Method processDocuments(jProcessData as Json, lRecoveredError as Logical)
	Public Method processGetEvents(cTicket as Character, nPage as Integer, nPageSize as Integer, cKendoFilter as Character, cOnlyRecno as Character, cFilter as Character) as Array
	Public Method processGetStatus() as Array
	Public Method processUpdateDocuments(cTicket as Character) as Array
	Public Method startProcessDocuments(cTicket as Character) as Array
	Public Method validateStartProcess(cTicket as Character) as Array

	Private Method getAutoErrorMessage() as Character
	Private Method getDocuments(cTicket as Character) as Json
	Private Method getFieldHZQ(cField as Character) as Character

	Private Method montaClausula(cField as Character, cOperator as Character, cValue as Character, aData as Array) as Character
	Private Method montaFiltro(aFilters as Array, cLogic as Character, aData as Array) as Character
	Private Method markDocuments(cTicket as Character)
	Private Method verifyEventsProcessing(cTicket as Character)

	Private Method openThreads(lAddNewThread as Logical) as Logical
	Private Method parseKendoFilter(cFilter as Character, aData as Array) as Character
	Private Method purchaseOrderHasMultipleItems(cBranch as Character, cNum as Character) as Logical
	Private Method purchaseRequestHasMultipleItems(cBranch as Character, cNum as Character) as Logical
	Private Method prepareProcess(cTicket as Character)
	Private Method processCountEvents(cQuery as Character) as Numeric
	Private Method processProductionOrder(jDocument as Json) as Character
	Private Method processPurchaseOrder(jDocument as Json) as Character
	Private Method processPurchaseRequest(jDocument as Json) as Character
	Private Method updateDocumentStatus(nRecno as Integer, cMessage as Character)
	Private Method waitInitProcess(aReturn as Array, oPCPThread as Object)

	Static Method getEventDescription(cEventCode as Character) as Character
	Static Method getOriginDescription(cOriginCode as Character) as Character
	Static Method getStatusDescription(cStatusCode as Character) as Character
	Static Method incrementProgressProcessTable(nValue as Integer, nTotal as Integer)
	Static Method initializeProcessTable(cTicket as Character)
	Static Method openProcessTable()
	Static Method setErrorProcessTable(cErrorMessage as Character)
	Static Method updateMessageProcessTable(cMessage as Character)
	Static Method updateStatusProcessTable(cStatus as Character)

EndClass

/*/{Protheus.doc} new
Método construtor da classe.

@type method
@author marcelo.neumann
@since 16/12/2025
@version P12
@return Self, Object, Instância da classe
/*/
Method new() as Object Class DTAAgentMRPProcEvents
	Self:mapFieldsHZQ()
Return Self

/*/{Protheus.doc} destroy
Limpa as propriedades da classe

@type method
@author lucas.franca
@since 08/09/2026
@version P12
@return Nil
/*/
Method destroy() Class DTAAgentMRPProcEvents
	FreeObj(Self:jMapFieldsHZQ)
	
	If Self:oQueryPurchaseItems != Nil
		FreeObj(Self:oQueryPurchaseItems)
	EndIf
	If Self:oQueryPurchaseOrderItems != Nil
		FreeObj(Self:oQueryPurchaseOrderItems)
	EndIf
Return
/*/{Protheus.doc} mapFieldsHZQ
Método que carregará na propriedade jMapFieldsHZQ a relação dos campos da tabela HZQ com os campos que serão usados na API, para facilitar o processo de filtro e retorno dos dados.

@type method
@author marcelo.neumann
@since 05/05/2026
@version P12
@return Nil
/*/
Method mapFieldsHZQ() Class DTAAgentMRPProcEvents
	Self:jMapFieldsHZQ := JsonObject():New()
	Self:jMapFieldsHZQ["event_code"         ] := "HZQ_TPEVEN"
	Self:jMapFieldsHZQ["type_code"          ] := "HZQ_ORIGEM"
	Self:jMapFieldsHZQ["document"           ] := "HZQ_DOCUM"
	Self:jMapFieldsHZQ["status"             ] := "HZQ_STATUS"
	Self:jMapFieldsHZQ["old_date"           ] := "HZQ_DTORIG"
	Self:jMapFieldsHZQ["new_date"           ] := "HZQ_DTNOVA"
	Self:jMapFieldsHZQ["checked"            ] := "HZQ_CHECK"
	Self:jMapFieldsHZQ["product_code"       ] := "HZQ_PROD"
	Self:jMapFieldsHZQ["product_description"] := "B1_DESC"
	Self:jMapFieldsHZQ["warehouse"          ] := "HZQ_LOCAL"
	Self:jMapFieldsHZQ["HZQ_TPEVEN"         ] := "event_code"
	Self:jMapFieldsHZQ["HZQ_ORIGEM"         ] := "type_code"
	Self:jMapFieldsHZQ["HZQ_DOCUM"          ] := "document"
	Self:jMapFieldsHZQ["HZQ_STATUS"         ] := "status"
	Self:jMapFieldsHZQ["HZQ_DTORIG"         ] := "old_date"
	Self:jMapFieldsHZQ["HZQ_DTNOVA"         ] := "new_date"
	Self:jMapFieldsHZQ["HZQ_CHECK"          ] := "checked"
	Self:jMapFieldsHZQ["HZQ_PROD"           ] := "product_code"
	Self:jMapFieldsHZQ["B1_DESC"            ] := "product_description"
	Self:jMapFieldsHZQ["HZQ_LOCAL"          ] := "warehouse"
Return

/*/{Protheus.doc} getEvents
Método que será executado pelo REST com o endpoint [GET] api/pcp/v1/DTAAgentMRPProcEvents/events/:ticket
Retorna os eventos e documentos processados pelo agente

@type method
@author marcelo.neumann
@since 16/12/2025
@version P12
@return lRet, Logical, Indica se o processamento da requisição foi realizado corretamente.
/*/
Method getEvents() as Logical Class DTAAgentMRPProcEvents
	Local aReturnData  := {}  as Array
	Local jPathParams  := Nil as Json
	Local jQueryParams := Nil as Json
	Local cFilter      := ""  as Character
	Local lRet         := .T. as Logical

	oRest:setKeyHeaderResponse("Content-Type","application/json")

	jPathParams  := oRest:getPathParamsRequest()
	jQueryParams := oRest:getQueryRequest()
	cFilter      := DTAUtils():decodeUTF8(jQueryParams["filter"])
	aReturnData  := Self:processGetEvents(jPathParams["ticket"], Val(jQueryParams["page"]), Val(jQueryParams["pageSize"]), cFilter, jQueryParams["onlyRecno"])

	oRest:setStatusCode(aReturnData[1])
	lRet := oRest:setResponse(aReturnData[2]:toJson())
	jPathParams  := Nil
	FwFreeArray(aReturnData)
Return lRet

/*/{Protheus.doc} processGetEvents
Faz o processamento da busca dos documentos e eventos processados pelo agente

@type method
@author marcelo.neumann
@since 16/12/2025
@version P12
@param 01 cTicket     , Character, Número do ticket do MRP
@param 02 nPage       , Integer  , Número da página para paginação
@param 03 nPageSize   , Integer  , Quantidade de itens por página
@param 04 cKendoFilter, Character, Filtro enviado pelo Kendo UI para busca dos eventos
@param 05 cOnlyRecno  , Character, Indica se deve retornar apenas o RECNO dos registros
@param 06 cFilter     , Character, Filtro enviado pelo Kendo UI para busca dos eventos
@return aReturnData   , Array    , Array com informações da busca, onde:
                                   [1] - Código HTTP para retorno da requisição (200-ok;400-bad request)
                                   [2] - Objeto JSON com o status do processo
/*/
Method processGetEvents(cTicket as Character, nPage as Integer, nPageSize as Integer, cKendoFilter as Character, cOnlyRecno as Character, cFilter as Character) as Array Class DTAAgentMRPProcEvents
	Local aReturnData  := {}  as Array
	Local aItems       := {}  as Array
	Local aFilters     := {}  as Array
	Local cAlias       := ""  as Character
	Local cQrySelect   := ""  as Character
	Local cQuery       := ""  as Character
	Local jContent     := Nil as Json
	Local nIndexEvento := 0   as Numeric
	Local nStart       := 0   as Numeric
	Local nCount       := 0   as Numeric
	Local oQuery       := Nil as Object
	Default cFilter    := "1=1"

	aReturnData := {200, JsonObject():New()}
	If !DTARunAgent():findAgentProcessByKey(AGENTE_EVENTOS, cTicket)
		aReturnData[1] := 404
		aReturnData[2]["content"  ] := STR0027 //"Resultado não encontrado."
		aReturnData[2]["detail"   ] := STR0028 //"Não foi encontrada execução do agente de Logs do MRP."
		aReturnData[2]["isWorking"] := .F.
		Return aReturnData
	EndIf

	jContent := JsonObject():New()
	jContent:FromJson(HZP->HZP_RESULT)
	
	If HZP->HZP_STATUS == STATUS_HZP_ERRO
		aReturnData[1] := 400
		aReturnData[2]["content"  ] := STR0031 //"Ocorreram erros na execução do agente."
		aReturnData[2]["detail"   ] := AllTrim(jContent["error_message"])
		aReturnData[2]["isWorking"] := .F.
		Return aReturnData
	EndIf
	If HZP->HZP_STATUS != STATUS_HZP_FINALIZADO
		aReturnData[1] := 400
		aReturnData[2]["content"  ] := STR0029 //"O agente ainda está trabalhando."
		aReturnData[2]["detail"   ] := STR0030 //"Aguarde mais um pouco."
		aReturnData[2]["isWorking"] := .T.
		Return aReturnData
	EndIf

	aReturnData[2]["status"] := Self:processGetStatus()
	If !aReturnData[2]["status"][1]
		Self:verifyEventsProcessing(cTicket)
	EndIf

	aReturnData[2]["content"  ] := AllTrim(jContent["short_answer"])
	aReturnData[2]["reasoning"] := AllTrim(jContent["reasoning"])
	aReturnData[2]["insights" ] := AllTrim(jContent["insights"])
	aReturnData[2]["cards"    ] := AllTrim(jContent["cards"])
	FreeObj(jContent)

	aAdd(aFilters, xFilial("SB1"))
	aAdd(aFilters, xFilial("HZQ"))
	aAdd(aFilters, HZP->HZP_ID)
	aAdd(aFilters, IND_HZQ_ATIVO)

	cQrySelect := "SELECT HZQ.HZQ_TPEVEN,"
	cQrySelect +=       " HZQ.HZQ_ORIGEM,"
	cQrySelect +=       " HZQ.HZQ_DOCUM,"
	cQrySelect +=       " HZQ.HZQ_PROD,"
	cQrySelect +=       " HZQ.HZQ_LOCAL,"
	cQrySelect +=       " SB1.B1_DESC,"
	cQrySelect +=       " HZQ.HZQ_STATUS,"
	cQrySelect +=       " HZQ.HZQ_DTORIG,"
	cQrySelect +=       " HZQ.HZQ_DTNOVA,"
	cQrySelect +=       " HZQ.HZQ_CHECK,"
	cQrySelect +=       " HZQ.R_E_C_N_O_ RECNO"
	cQuery     :=  " FROM " + RetSqlName("HZQ") + " HZQ"
	cQuery     += " INNER JOIN " + RetSqlName("SB1") + " SB1"
	cQuery     +=    " ON SB1.B1_FILIAL  = ?"
	cQuery     +=   " AND SB1.B1_COD = HZQ.HZQ_PROD"
	cQuery     +=   " AND SB1.D_E_L_E_T_ = ' '"
	cQuery     += " WHERE HZQ.HZQ_FILIAL = ?"
	cQuery     +=   " AND HZQ.HZQ_IDPRC  = ?"
	cQuery     +=   " AND HZQ.HZQ_ATIVO  = ?"
	cQuery     +=   " AND HZQ.D_E_L_E_T_ = ' '"
	cQuery     +=   " AND (" + Self:parseKendoFilter(cKendoFilter, @aFilters) + ")"
	cQuery     +=   " AND " + cFilter

	nCount := Self:processCountEvents(cQuery, aFilters)
	If nCount == 0
		aReturnData[2]["hasNext"] := .F.
		aReturnData[2]["items"  ] := aItems
		Return aReturnData
	EndIf

	cQuery += " ORDER BY HZQ.HZQ_TPEVEN, HZQ.HZQ_ORIGEM, HZQ.HZQ_DOCUM"

	oQuery := FwExecStatement():New(cQrySelect + cQuery)
	oQuery:setParams(aFilters)
	cAlias := oQuery:openAlias()
	TcSetField(cAlias, "HZQ_DTORIG", "D", 10, 0)
	TcSetField(cAlias, "HZQ_DTNOVA", "D", 10, 0)
	If nPage > 1
		nStart := ( (nPage-1) * nPageSize )
		If nStart > 0
			(cAlias)->(dbSkip(nStart))
		EndIf
	EndIf

	While (cAlias)->(!Eof())
		nIndexEvento++
		aAdd(aItems, JsonObject():New())
		If cOnlyRecno <> "S"
			aItems[nIndexEvento][Self:getFieldHZQ("HZQ_TPEVEN")] := (cAlias)->HZQ_TPEVEN
			aItems[nIndexEvento][Self:getFieldHZQ("HZQ_ORIGEM")] := (cAlias)->HZQ_ORIGEM
			aItems[nIndexEvento][Self:getFieldHZQ("HZQ_DOCUM" )] := RTrim((cAlias)->HZQ_DOCUM)
			aItems[nIndexEvento][Self:getFieldHZQ("HZQ_PROD"  )] := RTrim((cAlias)->HZQ_PROD)
			aItems[nIndexEvento][Self:getFieldHZQ("B1_DESC"   )] := RTrim((cAlias)->B1_DESC)
			aItems[nIndexEvento][Self:getFieldHZQ("HZQ_LOCAL" )] := RTrim((cAlias)->HZQ_LOCAL)
			aItems[nIndexEvento][Self:getFieldHZQ("HZQ_STATUS")] := (cAlias)->HZQ_STATUS
			aItems[nIndexEvento][Self:getFieldHZQ("HZQ_DTORIG")] := DtoC((cAlias)->HZQ_DTORIG)
			aItems[nIndexEvento][Self:getFieldHZQ("HZQ_DTNOVA")] := ""
			aItems[nIndexEvento][Self:getFieldHZQ("HZQ_CHECK" )] := (cAlias)->HZQ_CHECK == "1"
			aItems[nIndexEvento]["type_description"            ] := DTAAgentMRPProcEvents():getOriginDescription((cAlias)->HZQ_ORIGEM)
			aItems[nIndexEvento]["event_description"           ] := DTAAgentMRPProcEvents():getEventDescription((cAlias)->HZQ_TPEVEN)
			aItems[nIndexEvento]["status_description"          ] := DTAAgentMRPProcEvents():getStatusDescription((cAlias)->HZQ_STATUS)
			If !Empty((cAlias)->HZQ_DTNOVA)
				aItems[nIndexEvento][Self:getFieldHZQ("HZQ_DTNOVA")] := DtoC((cAlias)->HZQ_DTNOVA)
			EndIf
		EndIf
		aItems[nIndexEvento]["recno"] := (cAlias)->RECNO

		(cAlias)->(dbSkip())
		
		If nIndexEvento >= nPageSize
			Exit
		EndIf
	End
	aReturnData[2]["hasNext"] := (cAlias)->(!Eof())
	aReturnData[2]["items"  ] := aItems
	aReturnData[2]["count"  ] := nCount

	(cAlias)->(dbCloseArea())

	aItems := Nil
	oQuery:Destroy()
	FreeObj(oQuery)
	aSize(aFilters, 0)

Return aReturnData

/*/{Protheus.doc} getFieldHZQ
Retorna o nome do campo da tabela HZQ correspondente ao campo usado na API, para facilitar o processo de filtro e retorno dos dados.

@type method
@author marcelo.neumann
@since 05/05/2026
@version P12
@param 01 cField, Character, Nome do campo da tabela HZQ usado na API
/*/
Method getFieldHZQ(cField as Character) as Character Class DTAAgentMRPProcEvents
	Local cRetField := cField as Character
	If Self:jMapFieldsHZQ:HasProperty(cField)
		cRetField := Self:jMapFieldsHZQ[cField]
	EndIf

Return cRetField

/*/{Protheus.doc} parseKendoFilter
Faz o parse do filtro enviado pelo Kendo UI para o formato SQL

@type method
@author marcelo.neumann
@since 05/05/2026
@version P12
@param 01 cFilter, Character, Filtro enviado pelo Kendo UI
@param 02 aData  , Array    , Retorna por referência os dados para bind na query
@return cWhere, Character, Filtro no formato SQL para ser adicionado na query de busca dos eventos
/*/
Method parseKendoFilter(cFilter as Character, aData as Array) as Character Class DTAAgentMRPProcEvents
    Local aFilters := {}      as Array
    Local cWhere   := "1 = 1" as Character
	Local jFilter  := Nil     as Json
    Local nIndex   := 0       as Numeric
	Local nTotal   := 0       as Numeric

	If Empty(cFilter)
		Return cWhere
	EndIf

	jFilter := JsonObject():New()
	jFilter:FromJson(cFilter)
	aFilters := jFilter['filters']
	nTotal   := Len(aFilters)

    If nTotal > 0
		cWhere += " AND ("
        For nIndex := 1 To nTotal
			cWhere += "(" + Self:montaFiltro(aFilters[nIndex]["filters"], aFilters[nIndex]["logic"], @aData) + ")"

            If (nIndex < nTotal)
                cWhere += " " + jFilter['logic'] + " "
            EndIf
        Next
		cWhere += ")"
    EndIf

Return cWhere

/*/{Protheus.doc} montaFiltro
Percorre o filtro de um determinado campo e monta a cláusula SQL correspondente

@type method
@author marcelo.neumann
@since 05/05/2026
@version P12
@param 01 aFilters, Array    , Filtro enviado pelo Kendo UI
@param 02 cLogic  , Character, Lógica de combinação dos filtros (AND/OR)
@param 03 aData   , Array    , Retorna por referência os dados para bind na query
@return cWhere, Character, Filtro no formato SQL para ser adicionado na query de busca dos eventos
/*/
Method montaFiltro(aFilters as Array, cLogic as Character, aData as Array) as Character Class DTAAgentMRPProcEvents
    Local cFieldHZQ := "" as Character
	Local cValueHZQ := "" as Character
	Local cWhere    := "" as Character
    Local nIndex    := 0 as Numeric
	Local nTotal    := 0 as Numeric

	nTotal := Len(aFilters)
	For nIndex := 1 To nTotal
		cFieldHZQ := Self:getFieldHZQ(aFilters[nIndex]['field'])
		cValueHZQ := ""

		Do Case
			Case (cFieldHZQ == 'HZQ_DTORIG' .Or. cFieldHZQ == 'HZQ_DTNOVA') .And. !Empty(aFilters[nIndex]['value'])
				cValueHZQ := PCPConvDat(Left(aFilters[nIndex]['value'], 10), 6)
			Case ValType(aFilters[nIndex]['value']) == "L"
				cValueHZQ := IIf(aFilters[nIndex]['value'], "1", "0")
			Otherwise
				cValueHZQ := aFilters[nIndex]['value']
		Endcase

		cWhere += Self:montaClausula(cFieldHZQ, aFilters[nIndex]['operator'], cValueHZQ, @aData)

		If (nIndex < nTotal)
			cWhere += " " + cLogic + " "
		EndIf
	Next

Return cWhere

/*/{Protheus.doc} montaClausula
Monta a cláusula SQL correspondente ao filtro enviado pelo Kendo UI

@type method
@author marcelo.neumann
@since 05/05/2026
@version P12
@param 01 cField   , Character, Campo da tabela a ser filtrado
@param 02 cOperator, Character, Operador do filtro enviado pelo Kendo UI (eq, neq, contains, startswith, endswith, gte, gt, lte, lt, isempty, isnotempty)
@param 03 cValue   , Character, Valor do filtro enviado pelo Kendo UI
@param 04 aData    , Array    , Retorna por referência os dados para bind na query
@return Character, Cláusula a ser adicionada na query
/*/
Method montaClausula(cField as Character, cOperator as Character, cValue as Character, aData as Array) as Character Class DTAAgentMRPProcEvents
	Local cClausule as Character

	cClausule := cField + " = ?" //Padrão é filtro de operador "eq", para caso chegue com algum operador não esperado
	Do Case
		Case cOperator == "neq"
			cClausule := cField + " <> ?"

		Case cOperator == "contains"
			cValue := "%" + cValue + "%"
			cClausule := cField + " LIKE ?"

		Case cOperator == "doesnotcontain"
			cValue := "%" + cValue + "%"
			cClausule := cField + " NOT LIKE ?"

		Case cOperator == "startswith"
			cValue := cValue + "%"
			cClausule := cField + " LIKE ?"

		Case cOperator == "endswith"
			cValue := "%" + cValue
			cClausule := "RTrim(" + cField + ") LIKE ?"

		Case cOperator == "gte"
			cClausule := cField + " >= ?"

		Case cOperator == "gt"
			cClausule := cField + " > ?"

		Case cOperator == "lte"
			cClausule := cField + " <= ?"

		Case cOperator == "lt"
			cClausule := cField + " < ?"

		Case cOperator == "isempty"
			cValue := " "
			cClausule := cField + " = ?"

		Case cOperator == "isnotempty"
			cValue := " "
			cClausule := cField + " <> ?"
	EndCase

	aAdd(aData, cValue)
Return cClausule

/*/{Protheus.doc} processCountEvents
Busca a quantidade total de eventos para ser usada na paginação dos resultados

@type method
@author marcelo.neumann
@since 05/05/2026
@version P12
@param 01 cQuery  , Character, Consulta SQL para contagem dos eventos
@param 02 aFilters, Array    , Array com os dados para bind na query de contagem dos eventos
@return nCount, Numeric, Quantidade total de eventos encontrados para a consulta
/*/
Method processCountEvents(cQuery as Character, aFilters as Array) as Numeric Class DTAAgentMRPProcEvents
	Local cAlias    := ""  as Character
	Local cQryCount := ""  as Character
	Local oQuery    := Nil as Object
	Local nCount    := 0   as Numeric

	cQryCount := "SELECT COUNT(*) AS QTD " + cQuery

	oQuery := FwExecStatement():New(cQryCount)
	oQuery:setParams(aFilters)

	cAlias := oQuery:openAlias()
	If (cAlias)->(!Eof())
		nCount := (cAlias)->QTD
	EndIf
	(cAlias)->(dbCloseArea())

	oQuery:Destroy()
	FreeObj(oQuery)

Return nCount

/*/{Protheus.doc} getEventDescription
Retorna a descrição do evento a partir do código do evento

@type method
@author marcelo.neumann
@since 05/05/2026
@version P12
@param cEventCode, Character, Código do evento
@return cEventDescription, Character, Descrição do evento.
/*/
Method getEventDescription(cEventCode As Character) as Character Class DTAAgentMRPProcEvents
	Local cEventDescription := "" as Character

	Do Case
		Case cEventCode == EVENTO_ATRASAR
			cEventDescription := STR0001 //"Atrasar Documentos"
		Case cEventCode == EVENTO_ADIANTAR
			cEventDescription := STR0002 //"Adiantar Documentos"
		Case cEventCode == EVENTO_CANCELAR
			cEventDescription := STR0003 //"Cancelar Documentos"
	EndCase

Return cEventDescription

/*/{Protheus.doc} getOriginDescription
Retorna a descrição da origem a partir do código da origem

@type method
@author marcelo.neumann
@since 05/05/2026
@version P12
@param cOriginCode, Character, Código da origem do documento
@return cOriginDescription, Character, Descrição da origem
/*/
Method getOriginDescription(cOriginCode As Character) as Character Class DTAAgentMRPProcEvents
	Local cOriginDescription := "" as Character

	Do Case
		Case cOriginCode == IND_ORIGEM_OP
			cOriginDescription := STR0004 //"Ordens de Produção"
		Case cOriginCode == IND_ORIGEM_SC
			cOriginDescription := STR0005 //"Solicitações de Compra"
		Case cOriginCode == IND_ORIGEM_PC
			cOriginDescription := STR0006 //"Pedidos de Compra"
		Case cOriginCode == IND_ORIGEM_AE
			cOriginDescription := STR0007 //"Autorizações de Entrega"
	EndCase

Return cOriginDescription

/*/{Protheus.doc} getStatusDescription
Retorna a descrição do status a partir do código do status

@type method
@author marcelo.neumann
@since 05/05/2026
@version P12
@param cStatusCode, Caracter, Código do status
@return cStatusDescription, Character, Descrição do status
/*/
Method getStatusDescription(cStatusCode As Character) as Character Class DTAAgentMRPProcEvents
	Local cStatusDescription := "" as Character

	Do Case
		Case cStatusCode == STATUS_HZQ_PENDENTE
			cStatusDescription := STR0008 //"Pendente"
		Case cStatusCode == STATUS_HZQ_ATUALIZANDO
			cStatusDescription := STR0025 //"Atualizando"
		Case cStatusCode == STATUS_HZQ_PROCESSADO
			cStatusDescription := STR0009 //"Processado"
		Case cStatusCode == STATUS_HZQ_ERRO
			cStatusDescription := STR0010 //"Erro"
	EndCase

Return cStatusDescription

/*/{Protheus.doc} patchCheckEvent
Método que será executado pelo REST com o endpoint [PATCH] api/pcp/v1/DTAAgentMRPProcEvents/check/:recno
Marca ou desmarca um documento

@type method
@author marcelo.neumann
@since 05/05/2026
@version P12
@return lRet, Logical, Indica se o processamento da requisição foi realizado corretamente.
/*/
Method patchCheckEvent() as Logical Class DTAAgentMRPProcEvents
	Local aReturn     as Array
	Local jPathParams as Json
	Local lRet        as Logical

	oRest:setKeyHeaderResponse("Content-Type","application/json")

	jPathParams := oRest:getPathParamsRequest()
	aReturn     := Self:processCheckEvent(Val(jPathParams["recno"]))

	oRest:setStatusCode(aReturn[3])
	lRet := oRest:setResponse(aReturn[2]:toJson())

	jPathParams := Nil
	aSize(aReturn, 0)
Return lRet

/*/{Protheus.doc} processCheckEvent
Processa a requisição de check de um evento específico

@type method
@author lucas.franca
@since 22/05/2026
@version P12
@param nRecno, Integer, Número de registro do evento
@return aReturn, Array, Array com informações do processamento, onde:
                        [1] - Lógico indicando sucesso ou não
                        [2] - Objeto JSON com os dados de resposta
                        [3] - Código HTTP para retorno da requisição (200-ok;400-bad request)
/*/
Method processCheckEvent(nRecno as Integer) as Array Class DTAAgentMRPProcEvents
	Local aReturn     as Array
	Local cCheckValue as Character

	If Empty(nRecno)
		aReturn := DTAUtils():APIErrorMessage(400, STR0011) //"Número de registro do evento é obrigatório."
	Else
		cCheckValue := DTAAgentMRPDocuments():toggleCheck(nRecno)
		If !Empty(cCheckValue)
			aReturn    := {.T., Nil, 200}
			aReturn[2] := {"checked": cCheckValue == IND_HZQ_MARCADO}
		Else
			aReturn := DTAUtils():APIErrorMessage(400, STR0012) //"Não foi encontrado o evento com o número de registro informado."
		EndIf
	EndIf

Return aReturn

/*/{Protheus.doc} processGetStatus
Busca o progresso atual ou do último processamento de atualização de documentos

@type method
@author lucas.franca
@since 21/01/2026
@version P12
@return aReturn, Array, Array com informações do processo, onde:
                        [1] - Lógico indicando sucesso ou não da busca dos dados
                        [2] - Objeto JSON com as informações do processo
                        [3] - Código HTTP para retorno da requisição (200-ok;400-bad request)
/*/
Method processGetStatus() as Array Class DTAAgentMRPProcEvents
	Local aReturn    as Array
	Local jProcData  as Json
	Local oPCPThread as Object

	DTAAgentMRPProcEvents():openProcessTable()

	If !MRPEVENTAGENT->(dbSeek(cFilAnt))
		Return DTAUtils():APIErrorMessage(400, STR0013) //"Não existem processamentos de eventos para consulta."
	Else
		jProcData := JsonObject():New()
		aReturn   := {.T., jProcData, 200}
		jProcData["status"         ] := RTrim(MRPEVENTAGENT->STATUS)
		jProcData["user"           ] := UsrRetName(MRPEVENTAGENT->USER)
		jProcData["ticket"         ] := MRPEVENTAGENT->TICKET
		jProcData["processDate"    ] := PCPConvDat(MRPEVENTAGENT->PROC_DATE, 2)
		jProcData["processHour"    ] := MRPEVENTAGENT->PROC_HOUR
		jProcData["progress"       ] := MRPEVENTAGENT->PROGRESS
		jProcData["totalQuantity"  ] := MRPEVENTAGENT->TOTAL
		jProcData["processQuantity"] := MRPEVENTAGENT->PROCESSED
		jProcData["message"        ] := RTRim(MRPEVENTAGENT->MESSAGE)
	EndIf

	If jProcData["status"] == "INITIALIZING"
		//se ainda está inicializando, verifica se tem algum erro registrado
		oPCPThread := PCPMultiThreadError():New(PROCESS_LOCK_KEY, .F.)
		If oPCPThread:possuiErro()
			jProcData["status" ] := "ERROR"
			jProcData["message"] += oPCPThread:getcError(3)
			oPCPThread:Destroy()
			FreeObj(oPCPThread)
		EndIf
	EndIf

	If jProcData["status"] == "RUNNING"
		//se não está encerrado, valida com o semáforo se realmente ainda está em execução.
		If PCPLockControl():semaforo("LOCK", PROCESS_LOCK_KEY, 0)
			PCPLockControl():semaforo("UNLOCK", PROCESS_LOCK_KEY)
			//se conseguiu o semáforo é pq não está rodando e está com status errado na tabela. Ignora o valor da tabela e retorna que não encontrou
			FwFreeArray(aReturn)
			aReturn := DTAUtils():APIErrorMessage(400, STR0014) //"Nenhum processamento em execução nesta filial."
		EndIf
	EndIf
Return aReturn

/*/{Protheus.doc} postUpdateDocuments
Método que será executado pelo REST com o endpoint [POST] api/pcp/v1/DTAAgentMRPProcEvents/events/updateDocuments/:ticket
Inicia o processamento de atualização dos documentos a partir dos eventos selecionados

@type method
@author lucas.franca
@since 21/01/2026
@version P12
@return lRet, Logical, Indica se o processamento da requisição foi realizado corretamente.
/*/
Method postUpdateDocuments() as Logical Class DTAAgentMRPProcEvents
	Local aProcess    as Array
	Local jPathParams as Json
	Local lRet        as Logical

	oRest:setKeyHeaderResponse("Content-Type","application/json")

	jPathParams := oRest:getPathParamsRequest()
	aProcess    := Self:processUpdateDocuments(jPathParams["ticket"])
	oRest:setStatusCode(aProcess[3])
	lRet := oRest:setResponse(aProcess[2]:toJson())

	jPathParams := Nil
	aSize(aProcess, 0)
Return lRet

/*/{Protheus.doc} processUpdateDocuments
Faz o start do processamento de atualização de documentos

@type method
@author lucas.franca
@since 21/01/2026
@version P12
@param 01 cTicket, Character , Número do ticket do MRP
@return aReturn, Array, Array com informações do processo, onde:
                        [1] - Lógico indicando sucesso ou não da inicialização do processo
                        [2] - Objeto JSON com as informações da inicialização
                        [3] - Código HTTP para retorno da requisição (200-ok;400-bad request)
/*/
Method processUpdateDocuments(cTicket as Character) as Array Class DTAAgentMRPProcEvents
	Local aReturn    as Array
	Local cRecover   as Character
	Local oPCPThread as Object

	aReturn := {.T., Nil, 200}
	If !PCPLockControl():semaforo("LOCK", PROCESS_LOCK_KEY + "_START", 0)
		Return DTAUtils():APIErrorMessage(400, STR0015, STR0016) //"Processamento não permitido.", "Existe outro usuário iniciando este processamento neste momento. Tente novamente mais tarde."
	EndIf

	DTAAgentMRPProcEvents():openProcessTable()
	If MRPEVENTAGENT->(dbSeek(cFilAnt)) .And. RTrim(MRPEVENTAGENT->STATUS) != "FINISHED"
		//valida com o semáforo se está realmente rodando
		If !PCPLockControl():semaforo("LOCK", PROCESS_LOCK_KEY, 0)
			aReturn := DTAUtils():APIErrorMessage(400, STR0015, STR0017) //"Processamento não permitido.", "Existe um processamento de eventos do MRP em andamento. Aguarde a finalização para iniciar um novo processo."
		Else
			//não está rodando. solta o lock para obter na thread de processamento
			PCPLockControl():semaforo("UNLOCK", PROCESS_LOCK_KEY)
		EndIf
	EndIf

	If aReturn[1]
		cRecover := "totvs.protheus.manufacturing.agent.mrp.events.DTAAgentMRPProcEventsError('" + PROCESS_LOCK_KEY + "')"
		DTAAgentMRPProcEvents():initializeProcessTable(cTicket)
		oPCPThread := PCPMultiThreadError():New(PROCESS_LOCK_KEY, .T.)
		oPCPThread:startJob("totvs.protheus.manufacturing.agent.mrp.events.MRPEventsUpdateDocuments", GetEnvServer(), .F., cEmpAnt, cFilAnt, cTicket,,,,,,,,,,,cRecover)
		Self:waitInitProcess(@aReturn, @oPCPThread)
		FreeObj(oPCPThread)
	EndIf

	PCPLockControl():semaforo("UNLOCK", PROCESS_LOCK_KEY + "_START")
Return aReturn

/*/{Protheus.doc} waitInitProcess
Aguarda o início do processo de atualização dos documentos, verificando possíveis erros na inicialização.

@type method
@author lucas.franca
@since 21/01/2026
@version P12
@param 01 aReturn   , Array , Retorna por referência o status da inicialização do processo, onde:
                              [1] - Lógico indicando sucesso ou não da inicialização do processo
                              [2] - Objeto JSON com as informações do processo
                              [3] - Código HTTP para retorno da requisição (200-ok;400-bad request)
@param 02 oPCPThread, Object, instância do PCPMultiThreadError para verificação de exceções.
@return Nil
/*/
Method waitInitProcess(aReturn as Array, oPCPThread as Object) Class DTAAgentMRPProcEvents
	Local lError := .F. as Logical
	Local nTry   := 0   as Integer

	If !oPCPThread:abriuUltimaThread() .Or. oPCPThread:possuiErro()
		lError  := .T.
		aReturn := DTAUtils():APIErrorMessage(400, STR0018, oPCPThread:getcError(3)) //"Erro ao iniciar o processamento."
		oPCPThread:Destroy()
	EndIf
	While !lError .And. nTry < 100 .And. MRPEVENTAGENT->(dbSeek(cFilAnt)) .And. RTrim(MRPEVENTAGENT->STATUS) == "INITIALIZING"
		Sleep(300)
		lError := oPCPThread:possuiErro()
		nTry++
	End
	If lError .Or. RTrim(MRPEVENTAGENT->STATUS) $ "|INITIALIZING|ERROR|"
		lError  := .T.
		aReturn := DTAUtils():APIErrorMessage(400, STR0019, MRPEVENTAGENT->MESSAGE + oPCPThread:getcError(3)) //"Não foi possível iniciar o processo de atualização."
		oPCPThread:Destroy()
	EndIf
	If !lError
		aReturn[2] := {"status": "RUNNING"}
	EndIf

Return

/*/{Protheus.doc} MRPEventsUpdateDocuments
Função executada em uma nova thread que fará o processamento da atualização dos documentos
a partir dos eventos do MRP

@type function
@author lucas.franca
@since 21/01/2026
@version P12
@param 01 cTicket, Character , Número do ticket do MRP
@return Nil
/*/
Function MRPEventsUpdateDocuments(cTicket as Character)
	Local aData       as Array
	Local cGlbKey     as Character
	Local cMessage    as Character
	Local oAgentMRP   as Object
	Local oPCPThread  as Object

	DTAAgentMRPProcEvents():openProcessTable()
	If !PCPLockControl():semaforo("LOCK", PROCESS_LOCK_KEY, 0)
		UserException(STR0032) //"Ocorreu uma falha ao obter o lock do processo."
	EndIf
	DTAAgentMRPProcEvents():updateStatusProcessTable("RUNNING") //atualiza status para executando

	oAgentMRP := DTAAgentMRPProcEvents():New()
	aData := oAgentMRP:validateStartProcess(cTicket)
	If aData[1]
		aData := oAgentMRP:startProcessDocuments(cTicket)
	EndIf

	cGlbKey := PROCESS_LOCK_KEY + cTicket + "_HASPROCESSERROR"
	MRPEVENTAGENT->(dbSeek(cFilAnt))
	If MRPEVENTAGENT->STATUS != "ERROR"
		If aData[1]
			cMessage := STR0020 //"Processamento concluído, todos os documentos atualizados."
			If !Empty(GetGlbValue(cGlbKey))
				cMessage := STR0021 //"Processamento concluído, mas ocorreram erros ao atualizar alguns documentos. Verifique os detalhes dos documentos para mais informações."
			EndIf
			DTAAgentMRPProcEvents():updateMessageProcessTable(cMessage)
			//terminou, atualiza o status na tabela e libera o lock
			DTAAgentMRPProcEvents():updateStatusProcessTable("FINISHED")
		Else
			cMessage := aData[2]["message"]
			If !Empty(aData[2]["detailedMessage"]) .And. aData[2]["message"] != aData[2]["detailedMessage"]
				cMessage += " - " + aData[2]["detailedMessage"]
			EndIf
			DTAAgentMRPProcEvents():setErrorProcessTable(cMessage)
		EndIf
	EndIf

	//libera lock e limpa seção de globais pois terminou tudo sem erro de execução
	PCPLockControl():semaforo("UNLOCK", PROCESS_LOCK_KEY)
	oAgentMRP:clearGlobalsThreads(PROCESS_LOCK_KEY)

	oAgentMRP:destroy()
	ClearGlbValue(cGlbKey)
	FreeObj(oPCPThread)
	FreeObj(oAgentMRP)
	aSize(aData, 0)
Return

/*/{Protheus.doc} startProcessDocuments
Inicia o processamento de atualização dos documentos, buscando os documentos a serem processados e disparando as threads para processamento

@type method
@author marcelo.neumann
@since 22/01/2026
@version P12
@param 01 cTicket, Character, Número do ticket do MRP
@return aReturnData, Array    , Array com informações do processo, onde:
                                [1] - Lógico indicando sucesso ou não da inicialização do processo
                                [2] - Objeto JSON com as informações da inicialização
                                [3] - Código HTTP para retorno da requisição (200-ok;400-bad request)
/*/
Method startProcessDocuments(cTicket as Character) as Array Class DTAAgentMRPProcEvents
	Local aOrigens     as Array
	Local jDocuments   as Json
	Local jProcessData as Json
	Local nIndex       as Integer

	Self:markDocuments(cTicket)
	Self:prepareProcess(cTicket)
	jDocuments   := Self:getDocuments(cTicket)
	aOrigens     := jDocuments:getNames()
	For nIndex := 1 To Len(aOrigens)
		jProcessData := {"documents": jDocuments[aOrigens[nIndex]], "origin": aOrigens[nIndex], "ticket": cTicket}
		PCPIPCGO(THREAD_KEY, .F., "totvs.protheus.manufacturing.agent.mrp.events.DTAAgentMRPProcEventsProcessDocuments", jProcessData, .F.)
	Next nIndex

	PCPIPCWait(THREAD_KEY)
	PCPIPCFinish(THREAD_KEY, 10, Self:nThreads)
	Self:clearGlobalsThreads(THREADS_ERROR)

	aSize(aOrigens, 0)
	FreeObj(jDocuments)
	FreeObj(jProcessData)
Return {.T., Nil, 201}

/*/{Protheus.doc} prepareProcess
Prepara o processo de tratamento dos documentos, criando pool de threads e inicializando o processamento

@type method
@author lucas.franca
@since 22/05/2026
@version P12
@param 01 cTicket, Character, Número do ticket do MRP
@return Nil
/*/
Method prepareProcess(cTicket as Character) Class DTAAgentMRPProcEvents
	Local cQuery       as Character
	Local cAlias       as Character
	Local lPCAdded     as Logical
	Local nTotalRegs   as Integer
	Local oQuery       as Object

	Self:nThreads := 0

	cQuery := " SELECT COUNT(*) TOTAL, HZQ.HZQ_ORIGEM"
	cQuery +=   " FROM " + RetSqlName("HZQ") + " HZQ"
	cQuery +=  " WHERE HZQ_FILIAL = ?"
	cQuery +=    " AND HZQ_TICKET = ?"
	cQuery +=    " AND HZQ_STATUS = ?"
	cQuery +=    " AND D_E_L_E_T_ = ' '"
	cQuery +=  " GROUP BY HZQ.HZQ_ORIGEM"
	oQuery := FwExecStatement():New(cQuery)
	oQuery:setString(1, xFilial("HZQ"))
	oQuery:setString(2, cTicket)
	oQuery:setString(3, STATUS_HZQ_ATUALIZANDO)
	cAlias := oQuery:openAlias()
	While (cAlias)->(!Eof())
		nTotalRegs += (cAlias)->TOTAL

		If (cAlias)->HZQ_ORIGEM == IND_ORIGEM_AE .Or. (cAlias)->HZQ_ORIGEM == IND_ORIGEM_PC
			If !lPCAdded
				Self:nThreads++
				lPCAdded := .T.
			EndIf
		Else
			Self:nThreads++
		EndIf

		(cAlias)->(dbSkip())
	End
	(cAlias)->(dbCloseArea())
	oQuery:Destroy()

	DTAAgentMRPProcEvents():incrementProgressProcessTable(0, nTotalRegs) //atualiza o total de registros

	Self:openThreads(.F.)

	FreeObj(oQuery)
Return

/*/{Protheus.doc} markDocuments
Marca os documentos para processamento

@type method
@author marcelo.neumann
@since 11/06/2026
@version P12
@param 01 cTicket, Character, Número do ticket do MRP
@return lOk, Logical, Indica se os documentos foram marcados com sucesso
/*/
Method markDocuments(cTicket as Character) Class DTAAgentMRPProcEvents
	Local aProcessFilter as Array
	Local cProcessFilter as Character
	Local lOk            as Logical

	cProcessFilter := Self:buildProcessableHZQFilter()
	aProcessFilter := {xFilial("HZQ"), cTicket}
	lOk := DTAAgentMRPDocuments():updateHZQByFilter(cTicket               , ;
	                                                STATUS_HZQ_ATUALIZANDO, ;
	                                                IND_HZQ_DESMARCADO    , ;
	                                                STR0026               , ;//"Desmarcado pelo processamento."
	                                                cProcessFilter        , ;
	                                                aProcessFilter        )

	aSize(aProcessFilter, 0)
Return lOk

/*/{Protheus.doc} verifyEventsProcessing
Verifica o processamento dos eventos, atualizando o status dos documentos

@type method
@author marcelo.neumann
@since 11/06/2026
@version P12
@param 01 cTicket, Character, Número do ticket do MRP
@return lOk, Logical, Indica se os documentos foram atualizados com sucesso
/*/
Method verifyEventsProcessing(cTicket as Character) Class DTAAgentMRPProcEvents
	Local lOk := .T. as Logical

	lOk := DTAAgentMRPDocuments():updateHZQByFilter(cTicket            , ;
	                                              STATUS_HZQ_PENDENTE, ;
												  IND_HZQ_MARCADO    , ;
												  " "                , ;
												  "AND HZQ_STATUS = '" + STATUS_HZQ_ATUALIZANDO + "'")

Return lOk

/*/{Protheus.doc} getDocuments
Recupera os documentos da tabela HZQ conforme o ticket informado

@type method
@author lucas.franca
@since 22/05/2026
@version P12
@param cTicket, Character, Número do ticket do MRP
@return jDocuments, Json, documentos organizados por origem
/*/
Method getDocuments(cTicket as Character) as Json Class DTAAgentMRPProcEvents
	Local cAlias     as Character
	Local cOrigem    as Character
	Local cDocument  as Character
	Local cQuery     as Character
	Local jDocuments as Json
	Local nSizeOP    as Integer
	Local nSizeSC    as Integer
	Local nSizePC    as Integer
	Local oQuery     as Object

	nSizeOP    := GetSX3Cache("C2_OP", "X3_TAMANHO")
	nSizeSC    := GetSX3Cache("C1_NUM", "X3_TAMANHO") + GetSX3Cache("C1_ITEM", "X3_TAMANHO") + GetSX3Cache("C1_ITEMGRD", "X3_TAMANHO")
	nSizePC    := GetSX3Cache("C7_NUM", "X3_TAMANHO") + GetSX3Cache("C7_ITEM", "X3_TAMANHO") + GetSX3Cache("C7_SEQUEN", "X3_TAMANHO") + GetSX3Cache("C7_ITEMGRD", "X3_TAMANHO")
	jDocuments := JsonObject():New()

	cQuery := " SELECT HZQ.R_E_C_N_O_ REC, HZQ.HZQ_FILIAL, HZQ.HZQ_ORIGEM, HZQ.HZQ_DOCUM, HZQ.HZQ_DTNOVA, HZQ.HZQ_TPEVEN"
	cQuery +=   " FROM " + RetSqlName("HZQ") + " HZQ"
	cQuery +=  " WHERE HZQ.HZQ_FILIAL = ?"
	cQuery +=    " AND HZQ.HZQ_TICKET = ?"
	cQuery +=    " AND HZQ.HZQ_STATUS = ?"
	cQuery +=    " AND HZQ.D_E_L_E_T_ = ' '"
	oQuery := FwExecStatement():New(cQuery)
	oQuery:setString(1, xFilial("HZQ"))
	oQuery:setString(2, cTicket)
	oQuery:setString(3, STATUS_HZQ_ATUALIZANDO)

	cAlias := oQuery:openAlias()
	While (cAlias)->(!Eof())
		cDocument := (cAlias)->HZQ_DOCUM
		cOrigem   := (cAlias)->HZQ_ORIGEM

		If cOrigem == IND_ORIGEM_OP
			cDocument := PadR(cDocument, nSizeOP)
		ElseIf cOrigem == IND_ORIGEM_SC
			cDocument := PadR(cDocument, nSizeSC)
		ElseIf cOrigem == IND_ORIGEM_PC .Or. cOrigem == IND_ORIGEM_AE
			cDocument := PadR(cDocument, nSizePC)
			cOrigem   := IND_ORIGEM_PC
		EndIf
		If !jDocuments:hasProperty(cOrigem)
			jDocuments[cOrigem] := {}
		EndIf

		aAdd(jDocuments[cOrigem]               ,;
			{"RECNO"     : (cAlias)->REC       ,;
			 "HZQ_FILIAL": (cAlias)->HZQ_FILIAL,;
			 "HZQ_DOCUM" : cDocument           ,;
			 "HZQ_DTNOVA": (cAlias)->HZQ_DTNOVA,;
			 "HZQ_ORIGEM": (cAlias)->HZQ_ORIGEM,;
			 "HZQ_TPEVEN": (cAlias)->HZQ_TPEVEN})

		(cAlias)->(dbSkip())
	End
	(cAlias)->(dbCloseArea())
	oQuery:Destroy()
	FreeObj(oQuery)

Return jDocuments

/*/{Protheus.doc} DTAAgentMRPProcEventsProcessDocuments
Função executada em uma nova thread para processar os documentos de uma origem específica

@type function
@author marcelo.neumann
@since 22/01/2026
@version P12
@param 01 jProcessData, Json, Json com os dados necessários para o processamento dos documentos, contendo:
							- documents: Array de documentos a serem processados
							- origin: Origem dos documentos (OP, SC, PC ou AE)
							- ticket: Número do ticket do MRP
@param 02 lRecoveredError, Logical, Identifica se está realizando o processamento após recuperação de erro
@return Nil
/*/
Function DTAAgentMRPProcEventsProcessDocuments(jProcessData as Json, lRecoveredError as Logical)
	Local oAgentProc as Object

	oAgentProc := DTAAgentMRPProcEvents():New()
	oAgentProc:processDocuments(jProcessData, lRecoveredError)
	oAgentProc:destroy()
	FreeObj(oAgentProc)
Return

/*/{Protheus.doc} processDocuments
Processa os documentos de uma origem específica, executa a rotina correspondente para cada item,
atualiza o status individual e registra indicador global quando houver erro no processamento.

@type method
@author lucas.franca
@since 02/06/2026
@version P12
@param 01 jProcessData, Json, Json com os dados necessários para o processamento dos documentos, contendo:
							- documents: Array de documentos a serem processados
							- origin: Origem dos documentos (OP, SC, PC ou AE)
							- ticket: Número do ticket do MRP
@param 02 lRecoveredError, Logical, Indica se a execução atual foi iniciada por recuperação de erro.
@return Nil
/*/
Method processDocuments(jProcessData as Json, lRecoveredError as Logical) Class DTAAgentMRPProcEvents
	Local bBlock      as CodeBlock
	Local cErro       as Character
	Local lHasError   as Logical
	Local nIndex      as Integer

	//Variáveis de controle para o ExecAuto.
	Private lMsHelpAuto    := .T. as Logical
	Private lAutoErrNoFile := .T. as Logical

	DTAAgentMRPProcEvents():openProcessTable()
	dbSelectArea("HZQ") //precisa desse dbselectarea para conseguir atualizar o status do registro no bloco de erro (ErrorBlock)
	bBlock    := ErrorBlock({|oError| Self:documentErrorRecover(jProcessData, nIndex, oError)})
	lHasError := .F.

	If jProcessData["origin"] == IND_ORIGEM_OP
		SetMVValue("MTA650", "MV_PAR01", 1)
	EndIf

	For nIndex := 1 To Len(jProcessData["documents"])
		jProcessData["documents"][nIndex]["HZQ_DTNOVA"] := StoD(jProcessData["documents"][nIndex]["HZQ_DTNOVA"])

		If jProcessData["origin"] == IND_ORIGEM_OP
			cErro := Self:processProductionOrder(jProcessData["documents"][nIndex])
		ElseIf jProcessData["origin"] == IND_ORIGEM_SC
			cErro := Self:processPurchaseRequest(jProcessData["documents"][nIndex])
		Else
			cErro := Self:processPurchaseOrder(jProcessData["documents"][nIndex])
		EndIf

		Self:updateDocumentStatus(jProcessData["documents"][nIndex]["RECNO"], cErro)

		lHasError := lHasError .Or. !Empty(cErro)
		FreeObj(jProcessData["documents"][nIndex])
	Next nIndex
	ErrorBlock(bBlock)

	If lHasError .Or. lRecoveredError
		PutGlbValue(PROCESS_LOCK_KEY + jProcessData["ticket"] + "_HASPROCESSERROR", "1")
	EndIf

	aSize(jProcessData["documents"], 0)
Return

/*/{Protheus.doc} documentErrorRecover
Realiza a recuperação de erro durante o processamento de documentos em thread, atualizando o status do documento com erro.
Prepara o ambiente para continuar o processamento dos demais documentos em uma nova thread

@type method
@author lucas.franca
@since 02/06/2026
@version P12
@param 01 jProcessData  , Json   , Dados que estão sendo processados
@param 02 nDocumentIndex, Integer, Indice do documento que gerou a exceção.
@param 03 oError        , Object , Objeto de erro capturado pelo ErrorBlock.
@return Logical, KillApp (encerra a thread).
/*/
Method documentErrorRecover(jProcessData as Json, nDocumentIndex as Integer, oError as Object) Class DTAAgentMRPProcEvents
	Local cErro           as Character
	Local nIndex          as Integer
	Local nTotalDocuments as Integer

	rollback()

	cErro := I18N(STR0022, {oError:description + oError:errorStack}) //"Erro ao processar o documento. #1[MSGERRO]#"
	Self:updateDocumentStatus(jProcessData["documents"][nDocumentIndex]["RECNO"], cErro)

	nTotalDocuments := Len(jProcessData["documents"])
	If nDocumentIndex < nTotalDocuments .And. nDocumentIndex > 0
		//se tiver mais registros pra processar, abre nova thread para continuar o processamento
		For nIndex := nDocumentIndex To 1 Step -1
			FreeObj(jProcessData["documents"][nIndex])
			aDel(jProcessData["documents"], nIndex)
		Next nIndex
		aSize(jProcessData["documents"], nTotalDocuments - nDocumentIndex)

		//abre nova thread para continuar o processamento dos demais documentos
		Self:openThreads(.T.)
		PCPIPCGO(THREAD_KEY, .F., "totvs.protheus.manufacturing.agent.mrp.events.DTAAgentMRPProcEventsProcessDocuments", jProcessData, .T.)
	EndIf

	PCPIPCThEr(THREAD_KEY) //marca no pool de threads o controle de threads com erro
Return KillApp(.T.)

/*/{Protheus.doc} updateDocumentStatus
Atualiza o status de processamento do documento e incrementa o progresso geral do processo.

@type method
@author lucas.franca
@since 02/06/2026
@version P12
@param 01 nRecno  , Integer  , Número de registro (RECNO) do documento na tabela HZQ.
@param 02 cMessage, Character, Mensagem de erro do processamento. Quando vazio, o documento é marcado como processado com sucesso.
@return Nil
/*/
Method updateDocumentStatus(nRecno as Integer, cMessage as Character) Class DTAAgentMRPProcEvents
	DTAAgentMRPDocuments():updateDocumentStatus(nRecno, cMessage=="", cMessage)
	DTAAgentMRPProcEvents():incrementProgressProcessTable()
Return

/*/{Protheus.doc} processProductionOrder
Faz a alteração da Ordem de Produção

@type method
@author marcelo.neumann
@since 22/01/2026
@version P12
@param 01 jDocument, Json, Dados da tabela HZQ com o documento a ser processado
@return cErro, Character, Mensagem de erro caso tenha ocorrido ou vazio para sucesso
/*/
Method processProductionOrder(jDocument as Json) as Character Class DTAAgentMRPProcEvents
	Local aMata650 := {} as Array
	Local cErro    := "" as Character
	Local nOpcao   := 0  as Integer

	Private lMsErroAuto := .F. as Logical

	SC2->(dbSetOrder(1))
	If SC2->(dbSeek(xFilial("SC2", jDocument["HZQ_FILIAL"]) + jDocument["HZQ_DOCUM"]))
		If jDocument["HZQ_TPEVEN"] == "007"
			nOpcao := 5
			aAdd(aMata650, {"DELOPI", "N", Nil})
			aAdd(aMata650, {"DELSC" , "N", Nil})
		Else
			If SC2->C2_DATPRF == SC2->C2_DATPRI
				aAdd(aMata650, {"C2_DATPRI", jDocument["HZQ_DTNOVA"], Nil})
			EndIf
			aAdd(aMata650, {"C2_DATPRF", jDocument["HZQ_DTNOVA"], Nil})
			nOpcao := 4
		EndIf

		MsExecAuto({|x,y| MATA650(x,y)}, aMata650, nOpcao)
		cErro := Self:getAutoErrorMessage()
		aSize(aMata650, 0)
	EndIf

Return cErro

/*/{Protheus.doc} processPurchaseRequest
Faz a alteração da Solicitação de Compra

@type method
@author marcelo.neumann
@since 22/01/2026
@version P12
@param 01 jDocument, Json, Dados da tabela HZQ com o documento a ser processado
@return cErro, Character, Mensagem de erro caso tenha ocorrido ou vazio para sucesso
/*/
Method processPurchaseRequest(jDocument as Json) as Character Class DTAAgentMRPProcEvents
	Local aCabecalho := {} as Array
	Local aLinha     := {} as Array
	Local cErro      := "" as Character
	Local nOpcao     := 4  as Integer

	Private lMsErroAuto := .F. as Logical

	SC1->(dbSetOrder(1))
	If SC1->(dbSeek(xFilial("SC1", jDocument["HZQ_FILIAL"]) + jDocument["HZQ_DOCUM"]))
		aCabecalho := {{"C1_NUM"    , SC1->C1_NUM    },;
		               {"C1_SOLICIT", SC1->C1_SOLICIT},;
		               {"C1_EMISSAO", SC1->C1_EMISSAO}}

		If jDocument["HZQ_TPEVEN"] == "007"
			If Self:purchaseRequestHasMultipleItems(SC1->C1_FILIAL, SC1->C1_NUM)
				aLinha := {{{"C1_ITEM"   , SC1->C1_ITEM   , Nil         },;
				            {"C1_PRODUTO", SC1->C1_PRODUTO, Nil         },;
				            {"LINPOS"    , "C1_ITEM"      , SC1->C1_ITEM},;
				            {"AUTDELETA" , "S"            , Nil         }}}
			Else
				nOpcao := 5
			EndIf
		Else
			aLinha := {{{"C1_ITEM"   , SC1->C1_ITEM           , Nil},;
			            {"C1_PRODUTO", SC1->C1_PRODUTO        , Nil},;
			            {"C1_QUANT"  , SC1->C1_QUANT          , Nil},;
			            {"C1_SOLICIT", SC1->C1_SOLICIT        , Nil},;
			            {"C1_OBS"    , SC1->C1_OBS            , Nil},;
			            {"C1_TPOP"   , SC1->C1_TPOP           , Nil},;
			            {"C1_CC"     , SC1->C1_CC             , Nil},;
			            {"C1_CONTA"  , SC1->C1_CONTA          , Nil},;
			            {"C1_ITEMCTA", SC1->C1_ITEMCTA        , Nil},;
			            {"C1_CLVL"   , SC1->C1_CLVL           , Nil},;
			            {"C1_DATPRF" , jDocument["HZQ_DTNOVA"], Nil}}}
		EndIf
		MsExecAuto({|x,y,z| MATA110(x,y,z)}, aCabecalho, aLinha, nOpcao)
		cErro := Self:getAutoErrorMessage()
		aSize(aCabecalho, 0)
		aSize(aLinha, 0)
	EndIf

Return cErro

/*/{Protheus.doc} purchaseRequestHasMultipleItems
Verifica se a solicitação de compra possui mais de um item ativo.

@type method
@author lucas.franca
@since 04/06/2026
@version P12
@param 01 cBranch          , Character, Filial da solicitação de compra.
@param 02 cNum             , Character, Número da solicitação de compra.
@return lHasMultipleItems  , Logical  , Retorna .T. quando existir mais de um item ativo na SC informada.
/*/
Method purchaseRequestHasMultipleItems(cBranch as Character, cNum as Character) as Logical Class DTAAgentMRPProcEvents
	Local cQuery as Character
	Local nCount as Integer

	If Self:oQueryPurchaseItems == Nil
		cQuery := " SELECT COUNT(*) TOTAL"
		cQuery +=   " FROM " + RetSqlName("SC1") + " SC1"
		cQuery +=  " WHERE SC1.C1_FILIAL  = ?"
		cQuery +=    " AND SC1.C1_NUM     = ?"
		cQuery +=    " AND SC1.D_E_L_E_T_ = ' '"
		Self:oQueryPurchaseItems := FwExecStatement():New(cQuery)
	EndIf
	Self:oQueryPurchaseItems:setString(1, cBranch)
	Self:oQueryPurchaseItems:setString(2, cNum)

	nCount := Self:oQueryPurchaseItems:execScalar("TOTAL")
Return nCount > 1

/*/{Protheus.doc} processPurchaseOrder
Faz a alteração da Pedido de Compra

@type method
@author marcelo.neumann
@since 22/01/2026
@version P12
@param 01 jDocument, Json, Dados da tabela HZQ com o documento a ser processado
@return cErro, Character, Mensagem de erro caso tenha ocorrido ou vazio para sucesso
/*/
Method processPurchaseOrder(jDocument as Json) as Character Class DTAAgentMRPProcEvents
	Local aCabecalho := {} as Array
	Local aLinha     := {} as Array
	Local cErro      := "" as Character
	Local nOpcao     := 4  as Integer
	Local nTipoDoc   := 1  as Integer

	Private lMsErroAuto := .F. as Logical

	SC7->(dbSetOrder(1))
	If SC7->(dbSeek(xFilial("SC7", jDocument["HZQ_FILIAL"]) + jDocument["HZQ_DOCUM"]))
		aCabecalho := {{"C7_NUM"    , SC7->C7_NUM    },;
		               {"C7_EMISSAO", SC7->C7_EMISSAO},;
		               {"C7_FORNECE", SC7->C7_FORNECE},;
		               {"C7_LOJA"   , SC7->C7_LOJA   },;
		               {"C7_COND"   , SC7->C7_COND   },;
		               {"C7_CONTATO", SC7->C7_CONTATO},;
		               {"C7_FILENT" , SC7->C7_FILENT } }

		If jDocument["HZQ_ORIGEM"] == IND_ORIGEM_AE
			nTipoDoc := 2
		EndIf

		If jDocument["HZQ_TPEVEN"] == "007"
			If Self:purchaseOrderHasMultipleItems(SC7->C7_FILIAL, SC7->C7_NUM)
				aLinha := {{{"C7_ITEM"   , SC7->C7_ITEM   , Nil         },;
				            {"C7_PRODUTO", SC7->C7_PRODUTO, Nil         },;
				            {"LINPOS"    , "C7_ITEM"      , SC7->C7_ITEM},;
				            {"AUTDELETA" , "S"            , Nil         },;
				            {"C7_REC_WT" , SC7->(Recno()) , Nil         }}}
			Else
				nOpcao := 5
			EndIf
		Else
			aLinha := {{{"C7_ITEM"   , SC7->C7_ITEM           , Nil         },;
			            {"C7_PRODUTO", SC7->C7_PRODUTO        , Nil         },;
			            {"C7_QUANT"  , SC7->C7_QUANT          , Nil         },;
			            {"C7_PRECO"  , SC7->C7_PRECO          , Nil         },;
			            {"C7_TOTAL"  , SC7->C7_TOTAL          , Nil         },;
			            {"C7_DATPRF" , jDocument["HZQ_DTNOVA"], Nil         },;
			            {"LINPOS"    , "C7_ITEM"              , SC7->C7_ITEM},;
			            {"AUTDELETA" , "N"                    , Nil         },;
			            {"C7_REC_WT" , SC7->(Recno())         , Nil         }}}
		EndIf

		MsExecAuto({|x,y,z,w| MATA120(x,y,z,w)}, nTipoDoc, aCabecalho, aLinha, nOpcao)
		cErro := Self:getAutoErrorMessage()
		aSize(aCabecalho, 0)
		aSize(aLinha, 0)
	EndIf

Return cErro

/*/{Protheus.doc} purchaseOrderHasMultipleItems
Verifica se o pedido de compra possui mais de um item ativo.

@type method
@author lucas.franca
@since 04/06/2026
@version P12
@param 01 cBranch          , Character, Filial do pedido de compra.
@param 02 cNum             , Character, Número do pedido de compra.
@return lHasMultipleItems  , Logical  , Retorna .T. quando existir mais de um item ativo no pedido informado.
/*/
Method purchaseOrderHasMultipleItems(cBranch as Character, cNum as Character) as Logical Class DTAAgentMRPProcEvents
	Local cQuery as Character
	Local nCount as Integer

	If Self:oQueryPurchaseOrderItems == Nil
		cQuery := " SELECT COUNT(*) TOTAL"
		cQuery +=   " FROM " + RetSqlName("SC7") + " SC7"
		cQuery +=  " WHERE SC7.C7_FILIAL  = ?"
		cQuery +=    " AND SC7.C7_NUM     = ?"
		cQuery +=    " AND SC7.D_E_L_E_T_ = ' '"
		Self:oQueryPurchaseOrderItems := FwExecStatement():New(cQuery)
	EndIf
	Self:oQueryPurchaseOrderItems:setString(1, cBranch)
	Self:oQueryPurchaseOrderItems:setString(2, cNum)

	nCount := Self:oQueryPurchaseOrderItems:execScalar("TOTAL")
Return nCount > 1

/*/{Protheus.doc} getAutoErrorMessage
Obtém a mensagem de erro gerada pela execução automática de rotina

@type method
@author lucas.franca
@since 21/05/2026
@version P12
@return cErro, Character, Mensagem de erro da execução automática caso tenha ocorrido
/*/
Method getAutoErrorMessage() as Character Class DTAAgentMRPProcEvents
	Local aErro as Array
	Local cErro as Character

	If lMsErroAuto
		aErro := GetAutoGRLog()
		aEval(aErro, {|x| cErro += x + " "})
		aSize(aErro, 0)
	EndIf
Return cErro

/*/{Protheus.doc} validateStartProcess
Faz validações para identificar se o ticket pode ter os eventos processados.

@type method
@author lucas.franca
@since 21/01/2026
@version P12
@param 01 cTicket, Character, Número do ticket do MRP
@return aResponse, Array    , Array com as informações das validações, onde:
                              [1] - Lógico indicando sucesso ou não das validações
                              [2] - Objeto JSON com informações de erro
                              [3] - Código HTTP para retorno da requisição (200-ok;400-bad request)
/*/
Method validateStartProcess(cTicket as Character) as Array Class DTAAgentMRPProcEvents
	Local aResponse  as Array
	Local cAlias     as Character
	Local cQuery     as Character
	Local jValidate  as Json
	Local oMRPEvents as Object
	Local oQuery     as Object

	aResponse  := {.T., Nil, 200}
	oMRPEvents := DTAAgentMRPEvents():New()
	jValidate  := oMRPEvents:processGetValidate(cTicket)
	If jValidate:hasProperty("error")
		aResponse := DTAUtils():APIErrorMessage(400, jValidate["error"])
	EndIf

	If aResponse[1]
		cQuery := " SELECT 1"
		cQuery +=   " FROM " + RetSqlName("HZQ") + " HZQ"
		cQuery +=  " WHERE " + Self:buildProcessableHZQFilter("HZQ")
		oQuery := FwExecStatement():New(cQuery)
		oQuery:setString(1, xFilial("HZQ"))
		oQuery:setString(2, cTicket)
		cAlias := oQuery:openAlias()
		If (cAlias)->(Eof())
			aResponse := DTAUtils():APIErrorMessage(400, STR0023) //"Não existem documentos selecionados para atualização neste ticket."
		EndIf
		(cAlias)->(dbCloseArea())
		oQuery:Destroy()
		FreeObj(oQuery)
	EndIf

	FreeObj(jValidate)
	FreeObj(oMRPEvents)
Return aResponse

/*/{Protheus.doc} openProcessTable
Abre a tabela que armazena o status do processo.
Sempre utiliza o alias MRPEVENTAGENT.
Esta tabela utiliza o driver SQLITE_SYS.
Caso a tabela não exista, ela será criada.

@type method
@author lucas.franca
@since 21/01/2026
@version P12
@return Nil
/*/
Method openProcessTable() Class DTAAgentMRPProcEvents
	Local aFields    as Array
	Local cAlias     as Character
	Local cTableName as Character

	cTableName := "MRPEVENTAGENT" + cEmpAnt + "0"
	cAlias     := GetNextAlias()

	If DBSqlExec(cAlias, "SELECT BRANCH FROM " + cTableName, "SQLITE_SYS")
		(cAlias)->(dbCloseArea())
	Else
		aFields := {}
		aAdd(aFields, {"BRANCH"   , "C", FwSizeFilial(), 0})
		aAdd(aFields, {"STATUS"   , "C", 15, 0})
		aAdd(aFields, {"TICKET"   , "C", 6 , 0})
		aAdd(aFields, {"USER"     , "C", 6 , 0})
		aAdd(aFields, {"PROC_DATE", "D", 8 , 0})
		aAdd(aFields, {"PROC_HOUR", "C", 8 , 0})
		aAdd(aFields, {"PROGRESS" , "N", 6 , 2})
		aAdd(aFields, {"TOTAL"    , "N", 10, 0})
		aAdd(aFields, {"PROCESSED", "N", 10, 0})
		aAdd(aFields, {"MESSAGE"  , "M", 10, 0})

		DBCreate(cTableName, aFields, "SQLITE_SYS")
		DBUseArea(.T., "SQLITE_SYS", cTableName, "MRPEVENTAGENT", .F., .F. )
		MRPEVENTAGENT->(DBCreateIndex(cTableName + "_01", "BRANCH", { || BRANCH }))
		MRPEVENTAGENT->(dbCloseArea())
	EndIf
	If Select("MRPEVENTAGENT") == 0
		DBUseArea(.T., "SQLITE_SYS", cTableName, "MRPEVENTAGENT", .T., .F. )
		MRPEVENTAGENT->(dbSetIndex(cTableName + "_01"))
		MRPEVENTAGENT->(dbSetOrder(1))
	EndIf
Return

/*/{Protheus.doc} initializeProcessTable
Cria/atualiza o registro na tabela de controle do processo com as informações iniciais do processo

@type method
@author lucas.franca
@since 21/01/2026
@version P12
@param 01 cTicket, Character, Ticket do MRP que será processado
@return Nil
/*/
Method initializeProcessTable(cTicket as Character) Class DTAAgentMRPProcEvents
	Local cUser  as Character
	Local lFound as Logical

	cUser  := RetCodUsr()
	lFound := MRPEVENTAGENT->(dbSeek(cFilAnt))
	RecLock("MRPEVENTAGENT", !lFound)
		MRPEVENTAGENT->BRANCH    := cFilAnt
		MRPEVENTAGENT->STATUS    := "INITIALIZING"
		MRPEVENTAGENT->TICKET    := cTicket
		MRPEVENTAGENT->USER      := cUser
		MRPEVENTAGENT->PROC_DATE := Date()
		MRPEVENTAGENT->PROC_HOUR := Time()
		MRPEVENTAGENT->PROGRESS  := 0
		MRPEVENTAGENT->TOTAL     := 0
		MRPEVENTAGENT->PROCESSED := 0
		MRPEVENTAGENT->MESSAGE   := ""
	MRPEVENTAGENT->(MsUnLock())
Return

/*/{Protheus.doc} updateStatusProcessTable
Faz a atualização do Status do processamento na tabela de controle

@type method
@author lucas.franca
@since 21/01/2026
@version P12
@param 01 cStatus, Character, Status que será atualizado (RUNNING,ERROR,FINISHED)
@return Nil
/*/
Method updateStatusProcessTable(cStatus as Character) Class DTAAgentMRPProcEvents

	If MRPEVENTAGENT->(dbSeek(cFilAnt))
		RecLock("MRPEVENTAGENT", .F.)
			MRPEVENTAGENT->STATUS := cStatus
		MRPEVENTAGENT->(MsUnLock())
	EndIf
Return

/*/{Protheus.doc} incrementProgressProcessTable
Faz o controle do progresso na tabela de controle.
Utilizado para:
- Definir o total de registros que serão processados - Ex: incrementProgressProcessTable(0, 1000)
- Fazer um incremento de processo (PROCESSED+1) - Ex: incrementProgressProcessTable()
- Definir uma quantidade de registros processados, sobrescrevendo o PROCESSED - Ex: incrementProgressProcessTable(50)

Sempre calcula o valor da coluna PROGRESS conforme os valores atualizados de PROCESSED e TOTAL.

@type method
@author lucas.franca
@since 21/01/2026
@version P12
@param 01 nValue, Integer, Valor a ser registrado na coluna PROCESSED. Se não enviado (Nil), será realizado o incremento PROCESSED+1
@param 02 nTotal, Integer, Valor a ser registrado na coluna TOTAL. Se não enviado, não altera o valor atual da coluna TOTAL
@return Nil
/*/
Method incrementProgressProcessTable(nValue as Integer, nTotal as Integer) Class DTAAgentMRPProcEvents

	If MRPEVENTAGENT->(dbSeek(cFilAnt))
		RecLock("MRPEVENTAGENT", .F.)
			If nValue == Nil
				MRPEVENTAGENT->PROCESSED := MRPEVENTAGENT->PROCESSED + 1
			Else
				MRPEVENTAGENT->PROCESSED := nValue
			EndIf
			If nTotal != Nil
				MRPEVENTAGENT->TOTAL := nTotal
			EndIf
			If MRPEVENTAGENT->TOTAL == 0 .Or. MRPEVENTAGENT->PROCESSED == 0
				MRPEVENTAGENT->PROGRESS := 0
			Else
				MRPEVENTAGENT->PROGRESS := Round((MRPEVENTAGENT->PROCESSED/MRPEVENTAGENT->TOTAL)*100, 2)
			EndIf
		MRPEVENTAGENT->(MsUnLock())
	EndIf
Return

/*/{Protheus.doc} updateMessageProcessTable
Atualiza a mensagem da tabela de controle do processo

@type method
@author lucas.franca
@since 21/01/2026
@version P12
@param 01 cMessage, Character, Mensagem que será registrada
@return Nil
/*/
Method updateMessageProcessTable(cMessage as Character) Class DTAAgentMRPProcEvents
	If MRPEVENTAGENT->(dbSeek(cFilAnt))
		RecLock("MRPEVENTAGENT", .F.)
			MRPEVENTAGENT->MESSAGE := cMessage
		MRPEVENTAGENT->(MsUnLock())
	EndIf
Return

/*/{Protheus.doc} setErrorProcessTable
Registra um erro na tabela de controle do processo, atualizando o status do processo para error.

@author lucas.franca
@type method
@since 21/01/2026
@version P12
@param 01 cErrorMessage, Character, Mensagem de erro que será registrada
@return Nil
/*/
Method setErrorProcessTable(cErrorMessage as Character) Class DTAAgentMRPProcEvents

	Default cErrorMessage := STR0024 //"Erro indeterminado."

	DTAAgentMRPProcEvents():updateStatusProcessTable("ERROR")
	DTAAgentMRPProcEvents():updateMessageProcessTable(cErrorMessage)
Return

/*/{Protheus.doc} openThreads
Realiza a abertura das threads para processamento dos documentos.

@type method
@author marcelo.neumann
@since 29/01/2026
@version P12
@param 01 lAddNewThread, Logical, Indica que irá abrir apenas uma thread adicional. Utilizado para subir nova thread em caso de erros no processamento
@return Logical, Indica se as threads foram abertas com sucesso
/*/
Method openThreads(lAddNewThread as Logical) as Logical Class DTAAgentMRPProcEvents
	Local cRecover as Character
	Local nThreads as Integer

	nThreads := Self:nThreads
	cRecover := "totvs.protheus.manufacturing.agent.mrp.events.DTAAgentMRPProcEventsError('" + THREAD_KEY + "')"
	If lAddNewThread
		nThreads := 1
	EndIf

	PCPIPCStart(THREAD_KEY, nThreads, 0, cEmpAnt, cFilAnt, THREADS_ERROR, cRecover, lAddNewThread) //Inicializa as Threads

Return PCPIPCWIni(THREAD_KEY, THREADS_TEMPO_ABERTURA)

/*/{Protheus.doc} clearGlobalsThreads
Limpa as variáveis globais e destrói o objeto de controle de erros das threads.

@type method
@author lucas.franca
@since 26/05/2026
@version P12
@param cKey, Character, Chave identificadora das threads (valor que foi utilizado na criação do PCPMultiThreadError)
@return Nil
/*/
Method clearGlobalsThreads(cKey as Character) Class DTAAgentMRPProcEvents
	Local oPCPThread as Object

	oPCPThread := PCPMultiThreadError():New(cKey, .F.)
	oPCPThread:Destroy()
	FreeObj(oPCPThread)
Return

/*/{Protheus.doc} buildProcessableHZQFilter
Monta o filtro padrão para consulta na tabela HZQ.

@type method
@author lucas.franca
@since 22/05/2026
@version P12
@param cAlias, Character, Alias utilizado na tabela HZQ
@return cFilter, Character, String contendo o filtro formatado para a consulta
/*/
Method buildProcessableHZQFilter(cAlias as Character) as Character Class DTAAgentMRPProcEvents
	Local cFilter as Character

	cFilter :=     " [HZQ].HZQ_FILIAL = ?"
	cFilter += " AND [HZQ].HZQ_TICKET = ?"
	cFilter += " AND [HZQ].HZQ_ATIVO = '" + IND_HZQ_ATIVO + "'"
	cFilter += " AND [HZQ].HZQ_STATUS IN ('" + STATUS_HZQ_PENDENTE + "', '" + STATUS_HZQ_ERRO + "')"
	cFilter += " AND [HZQ].HZQ_CHECK  = '"+IND_HZQ_MARCADO+"'"
	cFilter += " AND [HZQ].D_E_L_E_T_ = ' '"

	cFilter := StrTran(cFilter, IIf(Empty(cAlias), "[HZQ].", "[HZQ]"), cAlias)

Return cFilter

/*/{Protheus.doc} DTAAgentMRPProcEventsError
Trata o erro no processamento das threads.

@type function
@author marcelo.neumann
@since 29/01/2026
@version P12
@return Nil
/*/
Function DTAAgentMRPProcEventsError(cUUID as Character)
	Local oPCPThread as Object
	Local cMsgErro   as Character

	rollback()

	oPCPThread := PCPMultiThreadError():New(cUUID, .F.)
	If oPCPThread:possuiErro()
		cMsgErro := oPCPThread:getcError(3)
		oPCPThread:Destroy()
		FreeObj(oPCPThread)

		DTAAgentMRPProcEvents():openProcessTable()
		DTAAgentMRPProcEvents():setErrorProcessTable(cMsgErro)
	EndIf
Return

/*/{Protheus.doc} rollback
Realiza o rollback da transação atual quando o contexto estiver em transação ativa.

@type function
@author lucas.franca
@since 02/06/2026
@version P12
@return Nil
/*/
Static Function rollback()
	If InTransact()
		DisarmTransaction()
	EndIf
Return
