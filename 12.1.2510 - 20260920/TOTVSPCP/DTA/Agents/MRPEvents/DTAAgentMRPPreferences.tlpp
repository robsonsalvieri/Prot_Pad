#Include "TLPP-CORE.TH"
#Include "TOTVS.CH"

/*/{Protheus.doc} DTAAgentMRPPreferences
Classe responsável pela manipulação da tabela HZR (preferências do usuário
para atualização de documentos do log MRP gerados pelo agente).
Centraliza operações de gravação e consulta do campo HZR_REGRA.

@type Class
@author renan.roeder
@since 04/05/2026
/*/
Class DTAAgentMRPPreferences
	Static Method save(cJsonRegra as Character) as Character
	Static Method getRegras() as Array
EndClass

/*/{Protheus.doc} save
Persiste uma string JSON na tabela HZR para auditoria/replay.

@type Static Method
@author renan.roeder
@since 04/05/2026
@param 01 cJsonRegra, Character, String JSON dos filtros a persistir
@return cHZRID, Character, HZR_ID gerado se sucesso, "" se falha
/*/
Method save(cJsonRegra as Character) as Character Class DTAAgentMRPPreferences
	Local cHZRID as Character

	cHZRID := GetSXENum("HZR", "HZR_ID")
	RecLock("HZR", .T.)
		HZR->HZR_FILIAL := xFilial("HZR")
		HZR->HZR_ID     := cHZRID
		HZR->HZR_REGRA  := cJsonRegra
	HZR->(MsUnLock())

	ConfirmSX8()
Return cHZRID

/*/{Protheus.doc} getRegras
Retorna todas as regras (HZR_REGRA) da filial corrente.

@type Method
@author lucas.franca
@since 04/05/2026
@return aRegras, Array, Array com as regras encontradas em formato JSON
/*/
Method getRegras() as Array Class DTAAgentMRPPreferences
	Local aRegras := {}  as Array
	Local jRegra  := Nil as Json

	HZR->(dbSetOrder(1))
	HZR->(dbSeek(xFilial("HZR")))
	While HZR->(!Eof()) .And. HZR->HZR_FILIAL == xFilial("HZR")
		jRegra := JsonObject():New()
		jRegra:FromJson(HZR->HZR_REGRA)
		jRegra["HZR_ID"] := HZR->HZR_ID
		aAdd(aRegras, jRegra)

		HZR->(DbSkip())
	End
	jRegra := Nil
Return aRegras
