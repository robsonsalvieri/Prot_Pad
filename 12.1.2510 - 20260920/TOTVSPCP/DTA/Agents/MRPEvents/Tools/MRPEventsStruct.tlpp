#include "tlpp-core.th"
#include "protheus.ch"
#include "fwmcptool.th"
#include "mrpeventsstruct.ch"

namespace totvs.tools.sigapcp

/*/{Protheus.doc} MRPEventsStruct
Ferramenta MCP responsável por estruturar os eventos do MRP e persistir os dados para processamento.

@type class
@author lucas.franca
@since 16/07/2026
@version P12
/*/
@FWToolMCP(action="post", erpRelease="12.1.2510", routine="RESULTADOM", option=1, module="SIGAPCP")
Class MRPEventsStruct implements FWMCPTool
	
	Private Data aMetrics as Array

	Public Method new() as object
	Public Method getDescription() as character
	Public Method getNotes() as character
	Public Method getPayLoadSchema() as json
	Public Method getReturnSchema() as json
	Public Method getMetrics() as Array
	Public Method process(jPayLoad as json) as json
EndClass

/*/{Protheus.doc} New
Instancia a ferramenta MCP de estruturação de eventos do MRP.

@type method
@author lucas.franca
@since 16/07/2026
@return object, Instancia da classe.
/*/
Method New() as object Class MRPEventsStruct
	Self:aMetrics := {}
Return Self

/*/{Protheus.doc} getDescription
Retorna a descrição exibida para a ferramenta MCP.

@type method
@author lucas.franca
@since 16/07/2026
@return character, Descrição funcional da ferramenta.
/*/
Method getDescription() as character Class MRPEventsStruct
Return STR0001 //"Extrai e trata os logs de eventos do MRP, registrando os dados de forma estruturada na tabela que será utilizada para o processamento."

/*/{Protheus.doc} getNotes
Retorna as observações de negócio sobre o registro estruturado dos documentos.

@type method
@author lucas.franca
@since 16/07/2026
@return character, Observações sobre o processamento da estruturação.
/*/
Method getNotes() as character Class MRPEventsStruct
Return STR0002 //"Irá registrar os documentos que necessitam de alguma atualização na tabela de processamento."

/*/{Protheus.doc} getPayLoadSchema
Monta o schema JSON de entrada esperado pela ferramenta MCP.

@type method
@author lucas.franca
@since 16/07/2026
@return jSchema, json, Schema JSON com o campo obrigatório do ticket.
/*/
Method getPayLoadSchema() as json Class MRPEventsStruct
	Local jSchema as json
	
	jSchema := totvs.framework.mcp.tools.getJsonSchema()
	jSchema["properties"] := { "ticket": { "type": "string", "description": STR0003 } } //"Número do ticket do MRP para estruturação dos eventos"
	jSchema["required"  ] := { "ticket" }
Return jSchema

/*/{Protheus.doc} getReturnSchema
Monta o schema JSON de retorno publicado pela ferramenta MCP.

@type method
@author lucas.franca
@since 16/07/2026
@return jSchema, json, Schema JSON com totais, tipos de eventos e documentos estruturados.
/*/
Method getReturnSchema() as json Class MRPEventsStruct
	Local jSchema as json

	jSchema := totvs.framework.mcp.tools.getJsonSchema()
	jSchema["properties"] := {;
		"total_events": { "type": "integer", "description": STR0004 },; //"Total de eventos gerados pelo ticket do MRP"
		"total_documents": { "type": "integer", "description": STR0005 },; //"Total de documentos processados"
		"documents": {;
			"description": STR0006,; //"Lista com os tipos de documentos e suas quantidades que estão selecionados após o processo de estruturação dos documentos"
			"type": "array",;
			"items": {;
				"type": "object",;
				"properties": {;
					"type": { "type": "string", "description": STR0007 },; //"Tipo do documento"
					"quantity": { "type": "integer", "description": STR0008 }; //"Quantidade de documentos do tipo informado"
				},;
				"required": {"type", "quantity"};
			};
		},;
		"event_types": {;
			"description": STR0009,; //"Lista com os tipos de eventos e suas quantidades que estão selecionadas após o processo de estruturação dos documentos"
			"type": "array",;
			"items": {;
				"type": "object",;
				"properties": {;
					"type": { "type": "string", "description": STR0010 },; //"Tipo do evento"
					"quantity": { "type": "integer", "description": STR0011 }; //"Quantidade de eventos do tipo informado"
				},;
				"required": {"type", "quantity"};
			};
		};
	}
	jSchema["required"] := { "total_events", "total_documents", "documents", "event_types" }
Return jSchema

/*/{Protheus.doc} getMetrics
Retorna as métricas da tool

@type method
@author lucas.franca
@since 16/07/2026
@return Self:aMetrics, array, Array com a lista de métricas da tool
/*/
Method getMetrics() as Array Class MRPEventsStruct
Return Self:aMetrics

/*/{Protheus.doc} process
Executa a estruturação dos eventos do ticket informado e retorna a resposta padronizada da ferramenta MCP.

@type method
@author lucas.franca
@since 16/07/2026
@param jPayLoad, json, Carga de entrada contendo o ticket a ser processado.
@return jResponse, json, Resultado da estruturação com dados consolidados ou mensagem de erro.
/*/
Method process(jPayLoad as json) as json Class MRPEventsStruct
	Local jResponse       as Json
	Local jStructData     as Json
	Local oAgentMRPEvents as Object

	oAgentMRPEvents := totvs.protheus.manufacturing.agent.mrp.events.DTAAgentMRPEvents():New()
	jStructData     := oAgentMRPEvents:processPostStruct(jPayLoad["ticket"])

	If jStructData:hasProperty("error")
		jResponse := { "error": {"message": jStructData["error"]} }
		FreeObj(jStructData)
	Else
		jResponse   := jStructData
		jStructData := Nil
	EndIf
	FreeObj(oAgentMRPEvents)
Return jResponse
