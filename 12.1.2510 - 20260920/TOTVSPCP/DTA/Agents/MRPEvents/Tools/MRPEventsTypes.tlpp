#include "tlpp-core.th"
#include "protheus.ch"
#include "fwmcptool.th"
#include "mrpeventstypes.ch"

namespace totvs.tools.sigapcp

/*/{Protheus.doc} MRPEventsTypes
Ferramenta MCP responsável por buscar os tipos de eventos existentes na execução do MRP.

@type class
@author lucas.franca
@since 16/07/2026
@version P12
/*/
@FWToolMCP(action="get", erpRelease="12.1.2510", routine="RESULTADOM", option=1, module="SIGAPCP")
Class MRPEventsTypes implements FWMCPTool

	Private Data aMetrics as Array

	Public Method new() as object
	Public Method getDescription() as character
	Public Method getNotes() as character
	Public Method getPayLoadSchema() as json
	Public Method getReturnSchema() as json
	Public Method getMetrics() as Array
	Public Method process(jPayLoad as json) as json
EndClass

/*/{Protheus.doc} New
Instancia a ferramenta MCP

@type method
@author lucas.franca
@since 16/07/2026
@return object, Instancia da classe.
/*/
Method New() as object Class MRPEventsTypes
	Self:aMetrics := {}
Return Self

/*/{Protheus.doc} getDescription
Retorna a descrição exibida para a ferramenta MCP.

@type method
@author lucas.franca
@since 16/07/2026
@return character, Descrição funcional da ferramenta.
/*/
Method getDescription() as character Class MRPEventsTypes
Return STR0001 //"Retorna os tipos de eventos existentes no processo do MRP junto com suas quantidades, permitindo que o agente identifique pontos de atenção sobre os eventos gerados pelo MRP."

/*/{Protheus.doc} getNotes
Retorna as observações de negócio.

@type method
@author lucas.franca
@since 16/07/2026
@return character, Observações sobre a tool
/*/
Method getNotes() as character Class MRPEventsTypes
Return ""

/*/{Protheus.doc} getPayLoadSchema
Monta o schema JSON de entrada esperado pela ferramenta MCP.

@type method
@author lucas.franca
@since 16/07/2026
@return jSchema, json, Schema JSON com o campo obrigatório do ticket.
/*/
Method getPayLoadSchema() as json Class MRPEventsTypes
	Local jSchema as json
	
	jSchema := totvs.framework.mcp.tools.getJsonSchema()
	jSchema["properties"] := { "ticket": { "type": "string", "description": STR0002 } } //"Número do ticket do MRP para busca dos tipos de eventos"
	jSchema["required"  ] := { "ticket" }
Return jSchema

/*/{Protheus.doc} getReturnSchema
Monta o schema JSON de retorno publicado pela ferramenta MCP.

@type method
@author lucas.franca
@since 16/07/2026
@return jSchema, json, Schema JSON com a estrutura da resposta.
/*/
Method getReturnSchema() as json Class MRPEventsTypes
	Local jSchema as json

	jSchema := totvs.framework.mcp.tools.getJsonSchema()
	jSchema["properties"] := {;
		"events": {;
			"description": STR0003,; //"Lista com os tipos de eventos, quantidade de eventos e quantidade de produtos vinculados ao evento"
			"type": "array",;
			"items": {;
				"type": "object",;
				"properties": {;
					"eventCode": { "type": "string", "description": STR0004 },; //"Código do evento"
					"eventQuantity": { "type": "integer", "description": STR0005 },; //"Quantidade de eventos do tipo informado"
					"productsQuantity": { "type": "integer", "description": STR0006 }; //"Quantidade de produtos vinculados ao evento"
				},;
				"required": {"eventCode", "eventQuantity", "productsQuantity"};
			};
		};
	}
	jSchema["required"] := { "events" }
Return jSchema

/*/{Protheus.doc} getMetrics
Retorna as métricas da tool

@type method
@author lucas.franca
@since 16/07/2026
@return Self:aMetrics, array, Array com a lista de métricas da tool
/*/
Method getMetrics() as Array Class MRPEventsTypes
Return Self:aMetrics

/*/{Protheus.doc} process
Faz as busca dos eventos e suas quantidades para o ticket informado.

@type method
@author lucas.franca
@since 16/07/2026
@param jPayLoad, json, Carga de entrada contendo o ticket para busca dos eventos
@return jResponse, json, Resultado da busca com os eventos e suas quantidades ou mensagem de erro.
/*/
Method process(jPayLoad as json) as json Class MRPEventsTypes
	Local jResponse       as Json
	Local oAgentMRPEvents as Object

	oAgentMRPEvents := totvs.protheus.manufacturing.agent.mrp.events.DTAAgentMRPEvents():New()
	jResponse       := oAgentMRPEvents:processGetEventsTypes(jPayLoad["ticket"])
	FreeObj(oAgentMRPEvents)
Return jResponse
