#include "tlpp-core.th"
#include "protheus.ch"
#include "fwmcptool.th"
#include "mrpeventsvalidate.ch"

namespace totvs.tools.sigapcp

/*/{Protheus.doc} MRPEventsValidate
Ferramenta MCP responsável por validar o ticket do MRP antes do processamento do agente.

@type class
@author lucas.franca
@since 16/07/2026
@version P12
/*/
@FWToolMCP(action="get", erpRelease="12.1.2510", routine="RESULTADOM", option=1, module="SIGAPCP")
Class MRPEventsValidate implements FWMCPTool
	
	Private Data aMetrics as Array
	
	Public Method new() as object
	Public Method getDescription() as character
	Public Method getNotes() as character
	Public Method getPayLoadSchema() as json
	Public Method getReturnSchema() as json
	Public Method getMetrics() as Array
	Public Method process(jPayLoad as json) as json
EndClass

/*/{Protheus.doc} New
Instancia a ferramenta MCP de validação de eventos do MRP.

@type method
@author lucas.franca
@since 16/07/2026
@return object, Instancia da classe.
/*/
Method New() as object Class MRPEventsValidate
	Self:aMetrics := {}
Return Self

/*/{Protheus.doc} getDescription
Retorna a descrição exibida para a ferramenta MCP.

@type method
@author lucas.franca
@since 16/07/2026
@return character, Descrição funcional da ferramenta.
/*/
Method getDescription() as character Class MRPEventsValidate
Return STR0001 //"Verifica se o ticket do MRP informado é válido para processamento do agente."

/*/{Protheus.doc} getNotes
Retorna as observações de negócio sobre as validações executadas pela ferramenta.

@type method
@author lucas.franca
@since 16/07/2026
@return character, Observações sobre o processamento da validação.
/*/
Method getNotes() as character Class MRPEventsValidate
Return STR0002 //"Faz validações de negócio para o ticket, e verifica se o ticket possui os eventos que podem ser processados pelo agente."

/*/{Protheus.doc} getPayLoadSchema
Monta o schema JSON de entrada esperado pela ferramenta MCP.

@type method
@author lucas.franca
@since 16/07/2026
@return jSchema, json, Schema JSON com o campo obrigatório do ticket.
/*/
Method getPayLoadSchema() as json Class MRPEventsValidate
	Local jSchema as json
	
	jSchema := totvs.framework.mcp.tools.getJsonSchema()
	jSchema["properties"] := { "ticket": { "type": "string", "description": STR0003 } } //"Número do ticket do MRP a ser validado"
	jSchema["required"  ] := { "ticket" }
Return jSchema

/*/{Protheus.doc} getReturnSchema
Monta o schema JSON de retorno publicado pela ferramenta MCP.

@type method
@author lucas.franca
@since 16/07/2026
@return jSchema, json, Schema JSON com a estrutura da resposta.
/*/
Method getReturnSchema() as json Class MRPEventsValidate
	Local jSchema as json

	jSchema := totvs.framework.mcp.tools.getJsonSchema()
	jSchema["properties"] := { "message": { "type": "string", "description": STR0004 } } //"Mensagem de validação do ticket do MRP"
	jSchema["required"  ] := { "message" }
Return jSchema

/*/{Protheus.doc} getMetrics
Retorna as métricas da tool

@type method
@author lucas.franca
@since 16/07/2026
@return Self:aMetrics, array, Array com a lista de métricas da tool
/*/
Method getMetrics() as Array Class MRPEventsValidate
Return Self:aMetrics

/*/{Protheus.doc} process
Executa a validação do ticket informado e retorna a resposta padronizada da ferramenta MCP.

@type method
@author lucas.franca
@since 16/07/2026
@param jPayLoad, json, Carga de entrada contendo o ticket a ser validado.
@return jResponse, json, Resultado da validação com dados do ticket ou mensagem de erro.
/*/
Method process(jPayLoad as json) as json Class MRPEventsValidate
	Local jResponse       as Json
	Local jTicketData     as Json
	Local oAgentMRPEvents as Object

	oAgentMRPEvents := totvs.protheus.manufacturing.agent.mrp.events.DTAAgentMRPEvents():New()
	jTicketData     := oAgentMRPEvents:processGetValidate(jPayLoad["ticket"])

	If jTicketData:hasProperty("error")
		jResponse := { "error": {"message": jTicketData["error"]} }
		FreeObj(jTicketData)
	Else
		jResponse   := jTicketData
		jTicketData := Nil
	EndIf
	
	FreeObj(oAgentMRPEvents)
Return jResponse
