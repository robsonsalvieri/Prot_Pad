#INCLUDE "TOTVS.CH"

#define ELEGIVEL "S"
#define NAO_ELEGIVEL "N"

#define SOLICITACAO "S"
#define EXECUCAO    "E"

#define AUTORIZADO 1
#define NEGADO 0
#define AUDITORIA 2
#define PENDENTE 9

//Tipo de guias HAT
#define CONSULTA "1"

//Sadt no PLS
#define EXAME "2"
#define EXEC "3"
#define PRONTOSOCORRO "10"
#define TRATSERIADO "11" 	

#define RESUMO_INTERNACAO "5"
#define HONORARIO "6"
#define PRORROGACAO "8"
#define TRATODONTO "9" 	
#define INTERNACAO "4" 		
#define OPME "12" 			
#define QUIMIOTERAPIA "13" 	
#define RADIOTERAPIA "14" 

//Tipo de guias PLS
#DEFINE G_CONSULTA  "01"
#DEFINE G_SADT_ODON "02"
#DEFINE G_SOL_INTER "03"
#DEFINE G_REEMBOLSO "04" //nao usada no HAT
#DEFINE G_RES_INTER "05"
#DEFINE G_HONORARIO "06"
#DEFINE G_ANEX_QUIM "07"
#DEFINE G_ANEX_RADI "08"
#DEFINE G_ANEX_OPME "09"
#DEFINE G_REC_GLOSA "10" //nao usada no hat
#DEFINE G_PROR_INTE "11"

//-------------------------------------------------------------------
/*/{Protheus.doc} PLSProcGroupAuthDao

@author    PLSTEAM
@version   V12
@since     15/12/2025
/*/
//-------------------------------------------------------------------
class PLSProcGroupAuthDao From PLSProcAuthDao

    public data cJsonResp as Object 

    public method new(oJson) constructor

    public method authorization()
    private method getProcedures()

endClass

//------------------------------------------------------------------------------------------
/*/{Protheus.doc} new
    construtor

    @type  class
    @author Sakai
    @since 15/12/2025
/*/
//------------------------------------------------------------------------------------------
method new(oJson) class PLSProcGroupAuthDao

   _Super:New('',oJson)
  
   self:cJsonResp  := JsonObject():new()
   self:cJsonResp['procedures'] := {}
   self:setGroupProc(.T.)

return self

//-------------------------------------------------------------------
/*/{Protheus.doc} authorization

@author    Sakai
@version   V12
@since     15/12/2025
/*/
//-------------------------------------------------------------------
method authorization() class PLSProcGroupAuthDao

    local aArea    	             := getArea()
    local nRecnoBD5	             := self:getValue(self:oJson["recnobd5"], 0)
    local nRecBD6                := 0
    local nReqQuantity           := 0
    local cAuthtype              := self:guideType(self:getValue(self:oJson["journey"], '0'))
    local cSequen                := ''
    local cTableCode	         := ''
    local cProcCode              := ''
    local cOriTableCode	         := ''
    local cOriProcCode           := ''
    local cProcedureHour         := ''
    local cToothRegion           := ''
    local cSurfaces              := ''
    local cTipoProc              := self:isExec(cAuthtype)
    local cMes                   := ''
    local cAno                   := ''
    local cTissVer               := ''
    local cCodOpeProf	         := ''
    local cTpAcom                := ''
    local cPadCon                := ''
    local cRegAte                := ''
    local cTipPre                := ''
    local cAreaAbr               := ''
    local cOutDesp               := '0' //TODO - na implementacao da guia de outras despesas alimentar este campo com '1' quando for outras despesas.
    local cNewbornAttendance     := iif( self:getValue(self:oJson["newbornAttendance"], .F.) ,'1','0')
    local cHealthProviderId      := self:getValue(self:oJson["healthProvider"]["healthProviderId"], '') 
    local cIdOnHealthInsurer     := self:getValue(self:oJson["professional"]["idOnHealthInsurer"], '') 
    local cLocationCode          := self:getValue(self:oJson["locationCode"], '')
    local cHospType              := self:getValue(self:oJson["hospType"], '')
    local cSpecialtyCode         := self:getCodEsp(self:oJson["professional"]["cbos"])
    local cEspSol 	             := ''
    local cEspExe 	             := ''
    local cSolInterna            := self:getValue(self:oJson["attendanceProtocol"], '')   // TODO na prorrogacao verificar o numero da solicitacao de internacao
    local cMainAuthorizationCode := self:getValue(self:oJson["mainAuthorizationCode"], '') // TODO enviar esta informacao na validacao do evento na execucao.
    local cSubscriberId          := self:getValue(self:oJson["beneficiary"]["subscriberId"], '')
    local cHospRegime            := self:getValue(self:oJson["hospRegime"], '')
    local cChaveBD6              := ''
    local cPrimaryICD            := self:getValue(self:oJson["primaryICD"], '')
    local cNumLibe2	             := ''
    local cResponse              := ''
    local cOptionOrder           := ''
    local cAliasCab              := iif(cAuthtype $ "2", "BE1", iif(cAuthtype $ "3", "BE4", ''))
    local cTipAdm                := self:getValue(self:oJson["attendanceModel"], '')
    local cMV_PLSMODA            := getNewPar("MV_PLSMODA", "1")
    local dDatNas                := stod('')

    local lSolict       := cTipoProc == SOLICITACAO
    local lNegProPac    := .F.
    local lOk           := .T.
    local lTrtExe       := .F.
    local lDigGui	    := self:getValue(self:oJson["digitacaoOff"], .F.)
    local lMV_PLATURG   := getNewPar("MV_PLATURG", .F.)
    local lRegPagAto    := iif( self:getValue(self:oJson["journey"], '0') == TRATODONTO, .T., .F. )
    local aRet          := {}
    local aQtdBrw       := {}
    local aProrInt      := {}
    local aDadRda       := {}
    local aDadUsr       := {}
    local aProcAuto	    := {}
    local aRetCalend    := {}
    local nX            := 0
    local aVldGen	    := nil
    local dRequestDate  := stod(strTran( self:getValue( iif( at(cAuthtype, G_ANEX_QUIM + "|" + G_ANEX_OPME) > 0, self:oJson["requestedDate"], self:oJson["requestDate"] ), dtos(dDataBase)) ,'-','')) 			

    private aTabDup    := PlsBusTerDup( superGetMv("MV_TISSCAB",.F.,"87") )
    private aErrVarVin := { .F., "", "", "" }

    aRetProc := self:getProcedures(cAuthtype,dRequestDate)

    for nX := 1 to len(aRetProc[1])
        
        //Itens sem groupValidation ativo ou com status diferente de -1 sao ignorados
        if !aRetProc[2,nX,4] .Or. aRetProc[2,nX,5] <> -1 
            loop
        endIf

        lOk := .T.

        cTableCode     := aRetProc[1,nX,1]
        cProcCode      := aRetProc[1,nX,2]
        nReqQuantity   := aRetProc[1,nX,3]
        cProcedureHour := aRetProc[1,nX,5]
        cToothRegion   := aRetProc[1,nX,6]
        cSurfaces      := aRetProc[1,nX,7]
        cSequen        := aRetProc[1,nX,8]

        cOptionOrder   := aRetProc[2,nX,1]
        cOriTableCode  := aRetProc[2,nX,2]
        cOriProcCode   := aRetProc[2,nX,3]

        //Remove o evento que esta sendo validado do aQtdBrw
        aQtdBrw := {}
        nPosProc := aScan(aRetProc[1],{|x| Alltrim(x[1])+Alltrim(x[2]) == Alltrim(cTableCode)+Alltrim(cProcCode) })
        if nPosProc > 0 
            aQtdBrw := aClone(aRetProc[1])
            ADel(aQtdBrw, nPosProc)
            ASize(aQtdBrw, Len(aQtdBrw) - 1)
        endIf

        //Valida calendario pagamento
        if len(aRetCalend) == 0
            aRetCalend := PLSXVLDCAL( dRequestDate, plsIntPad(), .F., "", "" )
        endIf

        if aRetCalend[1]
            cMes := aRetCalend[5]
            cAno := aRetCalend[4]
        elseIf len(aRetCalend[2]) > 0
            lOk := .F.
            self:rejectionCauses( aRetCalend[2,1,1] + " - " + aRetCalend[2,1,2] )
        endIf

        //Realiza De-Para TISS e posiciona BR8
        if lOk
            //Retorna para tabela original para seguir fluxo da classe pai
            cTableCode := cOriTableCode
            cProcCode  := cOriProcCode
            lOk := self:checkTiss(cHealthProviderId, @cTableCode, @cProcCode, @cTissVer)
        endIf

        //Validacao RDA
        if lOk
            lOk := self:validRDA(@cCodOpeProf,lSolict,cIdOnHealthInsurer,cAuthtype,cSolInterna,@aProrInt,;
                                 @cSpecialtyCode,cHealthProviderId,dRequestDate,cLocationCode,@cEspSol,;
                                 @cEspExe,cTipoProc,cTableCode,cProcCode,@aDadRda,@cTipPre)
        endIf

        // Validacao Beneficiario
        if lOk
            lOk := self:validBenef(@cSubscriberId,dRequestDate,@aDadUsr,@cTpAcom,@cPadCon,@cRegAte,@cAreaAbr,@dDatNas)
        endIf

        //Verifica se alcancou o limite de itens PTU Online
        if lOk
            lOk := self:validPTU(aDadUsr,aQtdBrw,cTableCode,cProcCode)
        endIf

        //Se Execucao Odonto ou Sadt, verifica se a quantidade informada e superior ao saldo
        if lOk .and. (cAuthtype == G_SADT_ODON) .and. ! empty(cMainAuthorizationCode)
            lOk := self:vldSaldo(cAuthtype,cMainAuthorizationCode,cTableCode,cProcCode,nReqQuantity)
        endIf

        //Conceito execucao de uma solicitacao
        if lOk
            self:vldExecOff( lSolict, lDigGui, nRecnoBD5, @cChaveBD6, @nRecBD6, cTableCode, cProcCode )
        endIf

        //Valida liberacao
        if lOk
            lOk := self:vldLibReg(cAuthtype, cMainAuthorizationCode, cTableCode, cProcCode, lDigGui,;
                                  dRequestDate, aProcAuto, @aVldGen, @cPrimaryICD, @cNumLibe2)
        endIf

        if lOk

            aRet := { .T. }

            //Checa a regra para um determinado procedimento
            if ! ( lMV_PLATURG .and. cTipAdm == '2') .And. cAuthtype <> G_RES_INTER

                lNegProPac := self:crit09L(aQtdBrw,aDadRDA)

                aRet := PLSAUTP(dRequestDate,;
                                cProcedureHour,;
                                cTableCode,;
                                cProcCode,;
                                nReqQuantity - iif(nRecBD6 > 0 .and. lDigGui .and. nRecnoBD5 > 0, BD6->BD6_QTDPRO, 0),;
                                aDadUsr,;
                                nRecBD6,;
                                aDadRDA,;
                                "1",;
                                iif( cMV_PLSMODA == "0", .F., .T.),;
                                cPrimaryICD,;
                                .T.,;
                                "1",;
                                lSolict,;
                                cCodOpeProf,;
                                iif( lSolict, cIdOnHealthInsurer, ''),;
                                cAno,;
                                cMes,;
                                cTpAcom,;
                                cPadCon,;
                                cRegAte,;
                                .T.,; //vai calcular o valor de pagamento no ato
                                '',; // nao considero mais o solicitante como executante, esse conceito foi retirado do HAT
                                nil,;
                                0,;
                                iif(! lSolict, cCodOpeProf, ''),;
                                nil,;
                                cNewbornAttendance,;
                                nil,;
                                nil,;
                                cSequen,;
                                cMainAuthorizationCode,;
                                lRegPagAto,;
                                "2",;
                                cSurfaces,;
                                nil,;
                                nil,;
                                cTipPre,;
                                cHospType,;
                                nil,;
                                nil,;
                                cMainAuthorizationCode,;
                                cAreaAbr,;
                                nil,;
                                nil,;
                                cToothRegion,;
                                nil,;
                                nil,;
                                iif( lSolict, .F., lTrtExe),;
                                .T.,; //Padrao do TISS Online e calcular COPart com pagamento na RDA
                                cTipoProc,;
                                cSpecialtyCode,;
                                aQtdBrw,;
                                aVldGen,;
                                cLocationCode,;
                                nil,;
                                nil,;
                                nil,;
                                .T.,;
                                cAliasCab,;
                                cHospRegime,;
                                nil,;
                                lNegProPac,;
                                nil,;
                                nil,;
                                nil,;
                                nil,;
                                nil,;
                                nil,;
                                cEspSol,;
                                cEspExe,;
                                nil,;
                                nil,;
                                iif( !empty(cAuthtype), PADL(cAuthtype, 2, "0"), "" ),;
                                nil,;
                                nil,;
                                .T.,;
                                nil,;
                                nil,;
                                nil,;
                                nil,;
                                nil,;
                                nil,;
                                nil,;
                                nil,;
                                iif(nRecBD6 > 0 .and. lDigGui .and. nRecnoBD5 > 0, BD6->BD6_QTDPRO, 0),;
                                nil,;
                                iif( cOutDesp == "1", .T., .F. ),;
                                cNumLibe2,;
                                cTipAdm,;
                                ,,;
                                aProrInt,;
                                iif(cAuthtype == "3", .T., .F.),;
                                nil,;
                                nil,;
                                .T.)

            endIf

        endIf

        //Monta atributo de resposta do procedimento
        oProc := self:makeProcedure(aRet, cAuthtype, dRequestDate, cHospType, cTableCode, cProcCode, dDatNas, nReqQuantity,;
                                    cTissVer, cOriTableCode, cOriProcCode, cOptionOrder,cMes, cAno, aDadUsr, aDadRda, cRegAte,;
                                    cProcedureHour, cSpecialtyCode, cLocationCode, cTipPre, cPrimaryICD, cToothRegion, cSurfaces )
        
        aadd(self:cJsonResp['procedures'], oProc['procedure'])
        self:aRejectionCauses := {}

    next

    self:cJsonResp['serviceResponse'] := .T.
    cResponse := self:cJsonResp:toJson()

    restArea( aArea )

return cResponse

//-------------------------------------------------------------------
/*/{Protheus.doc} getProcedures

@author    Sakai
@version   V12
@since     15/12/2025
/*/
//-------------------------------------------------------------------
method getProcedures(cAuthtype,dRequestDate) class PLSProcGroupAuthDao
    
    local nTCODPAD   := TamSX3("BR8_CODPAD")[1]
    local nTCODPSA   := TamSX3("BR8_CODPSA")[1]
    local nTCODIGO   := TamSX3("B04_CODIGO")[1]
    local nTFADENT   := TamSX3("B09_FADENT")[1]
    local nTSEQUEN   := TamSx3("BD6_SEQUEN")[1]
    local cTime      := ''
    local cCodPad    := ''
    local cCodPro    := ''
    local cTableCode := ''
    local cProcCode  := ''
    local aSolicited := {}
    local aProcAux   := {}
    local nPos       := 0
 
    for nPos := 1 to len(self:oJson["procedures"])
        
        cTime := strTran(time(),':','')
        cTableCode := Padr( self:oJson["procedures",nPos,'tableCode'], nTCODPAD )
        cProcCode  := Padr( self:oJson["procedures",nPos,'procedureCode'], nTCODPSA )

        //Se o registro atual não estiver autorizado não entra na matriz do aQtdBrow
        if val(cvaltochar(self:oJson["procedures",nPos,"status"])) == 0
            loop
        endIf

        cCodPad := allTrim( PLSVARVINC('87','BR4', allTrim(self:oJson["procedures",nPos,'tableCode'])) )
        cCodPro := allTrim( PLSVARVINC(allTrim(self:oJson["procedures",nPos,'tableCode']), 'BR8', allTrim(self:oJson["procedures",nPos,'procedureCode']), cCodPad + cProcCode,, aTabDup, @cCodPad))
        
        aadd(aSolicited, {  padR( cCodPad, nTCODPAD ),;
                            padR( cCodPro, nTCODPSA ),;
                            self:oJson["procedures",nPos,'requestedQuantity'],;
                            dRequestDate,;
                            cTime,;
                            padR( self:oJson["procedures",nPos,'toothRegion'], nTCODIGO ),;
                            padR( self:oJson["procedures",nPos,'surfaces'], nTFADENT ),;
                            strZero(nPos, nTSEQUEN ) } )

        aadd(aProcAux, { iif(cAuthtype == G_ANEX_OPME, iif(self:oJson["procedures",nPos,'optionOrder'] != nil, self:oJson["procedures",nPos,'optionOrder'],''),'') ,;
                         cTableCode,;
                         cProcCode,;
                         self:oJson["procedures",nPos,'groupValidation'],;
                         self:oJson["procedures"][nPos]["status"] })

    next

return {aSolicited,aProcAux}
