#include "tlpp-core.th"
#include "tlpp-rest.th"

namespace totvs.protheus.health.plan.api.portal.access

using namespace totvs.protheus.health.plan.api.util

/*/{Protheus.doc} FamilyController
Classe controladora das APIs de familias
@type class
@version 12.1.2510
@author luca.spiller   
@since 05/11/2025
/*/
class FamilyController from BaseController

	public method new() constructor

    @GET("/totvsHealthPlans/portal/v1/families/:familyId")
	public method apiGetFamily()

endclass

/*/{Protheus.doc} new
Construtor da classe FamilyController. Inicializa os atributos e configurações necessárias para o controle de Familias.
@type method
@version 12.1.2510
@author luca.spiller
@since 05/11/2025
/*/
method new() class FamilyController

	_Super:new()

return self

/*/{Protheus.doc} apiGetFamily
Método responsável pela api que retorna os dados da família
@version 12.1.2510
@author luca.spiller
@since 05/11/2025
/*/
method apiGetFamily() class FamilyController

	local oController as object

	if self:validateRequiredParams(oRest:getPathParamsRequest(), {"familyId"})
		if self:validatePortalUserAccess() .and. self:hasAccessToBeneficiary(oRest:getPathParamsRequest()["familyId"])
			oController := totvs.protheus.health.plan.api.familycontract.family.FamilyController():new()
			oController:apiFamilyId()
		endif
	endif

	freeObj(oController)
	self:destroy()

return
