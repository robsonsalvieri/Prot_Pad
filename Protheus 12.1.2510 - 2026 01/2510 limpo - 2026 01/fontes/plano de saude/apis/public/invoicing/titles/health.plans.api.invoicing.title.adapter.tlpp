#include "tlpp-core.th"

#define PORTAL_COMPANY "2"
#define PORTAL_BENEFICIARY "3"

namespace totvs.protheus.health.plans.api.invoicing.title

using namespace totvs.protheus.health.plans.api.util

/*/{Protheus.doc} TitleAdapter
Classe adaptadora de collenction de Títulos - Base de dados
@type class
@author Vinicius Queiros Teixeira
@since 14/02/2023
@version Protheus 12
/*/
class TitleAdapter from BaseAdapter

	public method new() constructor
	public method getPageTitles() as logical
	public method getTotalTitles() as json
	public method getCompositions() as logical

	protected method mapFieldsTitles() as logical
	protected method getQueryTitles() as character
	protected method getWhereTitles() as character
	protected method getOrderTitles() as character

	protected method compositionsFieldsMap() as logical
	protected method getCompositionsQuery() as character
	protected method getCompositionsWhere() as character
	protected method getCompositionsOrder() as character

endclass

/*/{Protheus.doc} new
Método construtor da classe
@type method
@author Vinicius Queiros Teixeira
@since 14/02/2023
@version Protheus 12
/*/
method new() class TitleAdapter

	_Super:new()

return Self

/*/{Protheus.doc} getPageTitles
Método responsavel por retornar a pagina de Títulos
@type method
@author Vinicius Queiros Teixeira
@since 14/02/2023
@version Protheus 12
/*/
method getPageTitles() as logical class TitleAdapter

	local lSuccess := .F. as logical
    local cQuery := self:getQueryTitles() as character
    local cWhere := self:getWhereTitles() as character
    local cOrder := self:getOrderTitles() as character
	
	self:mapFieldsTitles()

	if self:executeQueryAdapter(cQuery, cWhere, cOrder)
		lSuccess := .T.
	endif

return lSuccess

/*/{Protheus.doc} getTotalTitles
Adapta e retorna os totalizadores dos títulos financeiros no formato JSON
@type method
@version 12.1.2510
@author vinicius.queiros
@since 22/06/2025
@return json, totalizadores dos títulos incluindo quantidade e valor por status (Vencido, Aberto e Pago)
/*/
method getTotalTitles() as json class TitleAdapter

	local cQuery := self:getQueryTitles() as character
	local cWhere := self:getWhereTitles() as character
	local cFields as character
	local oExecStmt as object
	local cAlias as character
	local jResponse := JsonObject():new() as json
	local lExcludeOverdue := .F. as logical

	lExcludeOverdue := self:hasValidParam("excludeOverdue") .and. self:jParams["excludeOverdue"] == "true"

	jResponse["open"] := {"total": 0, "value": 0}
	jResponse["paid"] := {"total": 0, "value": 0}
	jResponse["overdue"] := {"total": 0, "value": 0}
	jResponse["titles"] := {"total": 0, "value": 0}
	
	// Faturas em aberto
	cFields += "SUM(CASE WHEN E1_SALDO > 0 " + iif(lExcludeOverdue, "AND E1_VENCREA >= " + dtos(dDataBase), "") + " THEN 1 ELSE 0 END) TOTAL_OPEN,"
	cFields += "SUM(CASE WHEN E1_SALDO > 0 " + iif(lExcludeOverdue, "AND E1_VENCREA >= " + dtos(dDataBase), "") + " THEN E1_SALDO ELSE 0 END) VALUE_OPEN,"
	// Faturas pagas
	cFields += "SUM(CASE WHEN E1_SALDO = 0 THEN 1 ELSE 0 END) TOTAL_PAID,"
	cFields += "SUM(CASE WHEN E1_SALDO = 0 THEN E1_VALOR ELSE 0 END) VALUE_PAID,"
	// Faturas vencidas
	cFields += "SUM(CASE WHEN E1_SALDO > 0 AND E1_VENCREA < " + dtos(dDataBase) + " THEN 1 ELSE 0 END) TOTAL_OVERDUE,"
	cFields += "SUM(CASE WHEN E1_SALDO > 0 AND E1_VENCREA < " + dtos(dDataBase) + " THEN E1_SALDO ELSE 0 END) VALUE_OVERDUE,"
	// Total de faturas
	cFields += "COUNT(E1_NUM) TOTAL_TITLES,"
	cFields += "SUM(E1_VALOR) VALUE_TITLES"

	cQuery := strTran(cQuery, "#QueryWhere#", cWhere)
	cQuery := strTran(cQuery, "#QueryFields#", cFields)

	oExecStmt := FwExecStatement():new(cQuery)

	cAlias := oExecStmt:openAlias()

	if !(cAlias)->(eof())
		jResponse["open"] := {"total": (cAlias)->TOTAL_OPEN, "value": (cAlias)->VALUE_OPEN}
		jResponse["paid"] := {"total": (cAlias)->TOTAL_PAID, "value": (cAlias)->VALUE_PAID}
		jResponse["overdue"] := {"total": (cAlias)->TOTAL_OVERDUE, "value": (cAlias)->VALUE_OVERDUE}
		jResponse["titles"] := {"total": (cAlias)->TOTAL_TITLES, "value": (cAlias)->VALUE_TITLES}
	endif

	(cAlias)->(dbCloseArea())

	oExecStmt:destroy()
	freeObj(oExecStmt)

return jResponse

/*/{Protheus.doc} getCompositions
Executa a rotina de adaptação (leitura e transformação) para obter as composições de títulos, convertendo os dados da 
fonte original para o formato esperado.
@type method
@version 12.1.2610
@author vinicius.queiros
@since 24/11/2025
@param
@return logical, Indica se o adaptador conseguiu buscar, processar e adaptar as composições dos títulos com sucesso
/*/
method getCompositions() as logical class TitleAdapter

	local lSuccess := .F. as logical
	local cQuery := self:getCompositionsQuery() as character
	local cWhere := self:getCompositionsWhere() as character
	local cOrder := self:getCompositionsOrder() as character

	self:compositionsFieldsMap()

	lSuccess := self:executeQueryAdapter(cQuery, cWhere, cOrder)

return lSuccess

/*/{Protheus.doc} mapFieldsTitles
Método responsavel por mapear os atributos do json com os campos da tabela de títulos
@type method
@author Vinicius Queiros Teixeira
@since 14/02/2023
@version Protheus 12
/*/
method mapFieldsTitles() as logical class TitleAdapter

	self:oAdapterBase:addMapFields("customer_id", "E1_CLIENTE", .T., .F., {"E1_CLIENTE", "C", TamSX3("E1_CLIENTE")[1], 0})
	self:oAdapterBase:addMapFields("customer_store", "E1_LOJA", .T., .F., {"E1_LOJA", "C", TamSX3("E1_LOJA")[1], 0})
	self:oAdapterBase:addMapFields("customer_name", "E1_NOMCLI", .T., .F., {"E1_NOMCLI", "C", TamSX3("E1_NOMCLI")[1], 0})
	self:oAdapterBase:addMapFields("issue_date", "E1_EMISSAO", .T., .F., {"E1_EMISSAO", "C", TamSX3("E1_EMISSAO")[1], 0}, self:getFormatDate("E1_EMISSAO"))
	self:oAdapterBase:addMapFields("prefix", "E1_PREFIXO", .T., .F., {"E1_PREFIXO", "C", TamSX3("E1_PREFIXO")[1], 0})
	self:oAdapterBase:addMapFields("number", "E1_NUM", .T., .F., {"E1_NUM", "C", TamSX3("E1_NUM")[1], 0})
	self:oAdapterBase:addMapFields("parcel", "E1_PARCELA", .T., .F., {"E1_PARCELA", "C", TamSX3("E1_PARCELA")[1], 0})
	self:oAdapterBase:addMapFields("type", "E1_TIPO", .T., .F., {"E1_TIPO", "C", TamSX3("E1_TIPO")[1], 0})
	self:oAdapterBase:addMapFields("base_month", "E1_MESBASE", .T., .F., {"E1_MESBASE", "C", TamSX3("E1_MESBASE")[1], 0})
	self:oAdapterBase:addMapFields("base_year", "E1_ANOBASE", .T., .F., {"E1_ANOBASE", "C", TamSX3("E1_ANOBASE")[1], 0})
	self:oAdapterBase:addMapFields("real_due_date", "E1_VENCREA", .T., .F., {"E1_VENCREA", "C", TamSX3("E1_VENCREA")[1], 0}, self:getFormatDate("E1_VENCREA"))
	self:oAdapterBase:addMapFields("amount", "E1_VALOR", .T., .F., {"E1_VALOR", "N", TamSX3("E1_VALOR")[1], 0})
	self:oAdapterBase:addMapFields("balance", "E1_SALDO", .T., .F., {"E1_SALDO", "N", TamSX3("E1_SALDO")[1], 0})
	self:oAdapterBase:addMapFields("net_value", "E1_VALLIQ", .T., .F., {"E1_VALLIQ", "N", TamSX3("E1_VALLIQ")[1], 0})
	self:oAdapterBase:addMapFields("low_date", "E1_BAIXA", .T., .F., {"E1_BAIXA", "C", TamSX3("E1_BAIXA")[1], 0}, self:getFormatDate("E1_BAIXA"))
	self:oAdapterBase:AddMapFields("status", "STATUS", .T., .F., {"STATUS", "C", TamSX3("E1_STATUS")[1], 0},;
					  			   "CASE WHEN E1_SALDO = E1_VALOR THEN 'A' WHEN E1_SALDO > 0 AND E1_SALDO < E1_VALOR THEN 'P' WHEN E1_SALDO = 0 THEN 'B' ELSE '' END")
	self:oAdapterBase:AddMapFields("title_id", "SE1KEY", .T., .F., {"SE1KEY", "C", TamSX3("E1_PREFIXO")[1]+TamSX3("E1_NUM")[1]+TamSX3("E1_PARCELA")[1]+TamSX3("E1_TIPO")[1], 0},;
								   "CASE WHEN E1_PARCELA = ' ' THEN E1_PREFIXO"+self:concatOperator()+"E1_NUM"+self:concatOperator()+"'"+replicate("+", tamSX3("E1_PARCELA")[1])+"'"+self:concatOperator()+"E1_TIPO "+;
								   " ELSE E1_PREFIXO"+self:concatOperator()+"E1_NUM"+self:concatOperator()+"E1_PARCELA"+self:concatOperator()+"E1_TIPO END")
	self:oAdapterBase:addMapFields("situation", "E1_SITUACA", .T., .F., {"E1_SITUACA", "C", TamSX3("E1_SITUACA")[1], 0})
	self:oAdapterBase:addMapFields("company_code", "E1_CODEMP", .T., .F., {"E1_CODEMP", "C", TamSX3("E1_CODEMP")[1], 0})
	self:oAdapterBase:addMapFields("contract_code", "E1_CONEMP", .T., .F., {"E1_CONEMP", "C", TamSX3("E1_CONEMP")[1], 0})
	self:oAdapterBase:addMapFields("subcontract_code", "E1_SUBCON", .T., .F., {"E1_SUBCON", "C", TamSX3("E1_SUBCON")[1], 0})
	self:oAdapterBase:addMapFields("subcontract_description", "BQC_DESCRI", .T., .F., {"BQC_DESCRI", "C", tamSX3("BQC_DESCRI")[1], 0})
	self:oAdapterBase:addMapFields("company_description", "BG9_DESCRI", .T., .F., {"BG9_DESCRI", "C", tamSX3("BG9_DESCRI")[1], 0})

return .T.

/*/{Protheus.doc} getQueryTitles
Método responsavel por retornar o corpo da query que busca os títulos
@type Method
@author Vinicius Queiros Teixeira
@since 14/02/2023
@version Protheus 12
/*/
method getQueryTitles() as character class TitleAdapter

	local cQuery as character
	local aBindValues := {} as array

	cQuery := "SELECT #QueryFields# FROM ? SE1 "

	aAdd(aBindValues, {"set": "unsafe", "value": retSqlName("SE1")})

	if self:hasValidParam("loginUser")
		BSW->(dbSetOrder(1))
		if BSW->(msSeek(xFilial("BSW") + upper(self:jParams["loginUser"])))
			do case
				case BSW->BSW_TPPOR == PORTAL_COMPANY
					cQuery += " INNER JOIN ? B40 ON "
					cQuery += "		B40.B40_FILIAL = ? AND "
					cQuery += " 	B40.B40_CODUSR = ? AND "
					cQuery += " 	B40.B40_CODINT = SE1.E1_CODINT AND "
					cQuery += " 	B40.B40_CODEMP = SE1.E1_CODEMP AND "
					cQuery += " 	B40.B40_NUMCON = SE1.E1_CONEMP AND "
					cQuery += " 	B40.B40_VERCON = SE1.E1_VERCON AND "
					cQuery += " 	(B40.B40_SUBCON = SE1.E1_SUBCON OR SE1.E1_SUBCON = ?) AND "
					cQuery += " 	(B40.B40_VERSUB = SE1.E1_VERSUB OR SE1.E1_SUBCON = ?) AND "
					cQuery += " 	B40.D_E_L_E_T_ = ? "

					aAdd(aBindValues, {"set": "unsafe", "value": retSqlName("B40")})
					aAdd(aBindValues, {"set": "string", "value": xFilial("B40")})
					aAdd(aBindValues, {"set": "string", "value": BSW->BSW_CODUSR})
					aAdd(aBindValues, {"set": "string", "value": " "})
					aAdd(aBindValues, {"set": "string", "value": " "})
					aAdd(aBindValues, {"set": "string", "value": " "})
			endcase
		endif
	endif	

	cQuery += " LEFT JOIN ? BG9 ON"
	cQuery += "	    BG9.BG9_FILIAL = ? AND "
	cQuery += "		BG9.BG9_CODINT = SE1.E1_CODINT AND "
	cQuery += "		BG9.BG9_CODIGO = SE1.E1_CODEMP AND "
	cQuery += "		BG9.D_E_L_E_T_ = ? "

	cQuery += " LEFT JOIN ? BQC ON"
	cQuery += "	    BQC.BQC_FILIAL = ? AND "
	cQuery += "		BQC.BQC_CODIGO = SE1.E1_CODINT " + self:concatOperator() + " SE1.E1_CODEMP AND "
	cQuery += "		BQC.BQC_NUMCON = SE1.E1_CONEMP AND "
	cQuery += "		BQC.BQC_VERCON = SE1.E1_VERCON AND "
	cQuery += "		BQC.BQC_SUBCON = SE1.E1_SUBCON AND "
	cQuery += "		BQC.BQC_VERSUB = SE1.E1_VERSUB AND "
	cQuery += "		BQC.D_E_L_E_T_ = ? "

	aAdd(aBindValues, {"set": "unsafe", "value": retSqlName("BG9")})
	aAdd(aBindValues, {"set": "string", "value": xFilial("BG9")})
	aAdd(aBindValues, {"set": "string", "value": " "})

	aAdd(aBindValues, {"set": "unsafe", "value": retSqlName("BQC")})
	aAdd(aBindValues, {"set": "string", "value": xFilial("BQC")})
	aAdd(aBindValues, {"set": "string", "value": " "})

  	cQuery += " WHERE #QueryWhere#"

	cQuery := self:bindValuesToQuery(cQuery, aBindValues)

	fwFreeArray(aBindValues)

return cQuery

/*/{Protheus.doc} getWhereTitles
Método responsavel por retornar o WHERE da query que busca os títulos
@type Method
@author Vinicius Queiros Teixeira
@since 14/02/2023
@version Protheus 12
/*/
method getWhereTitles() as character class TitleAdapter

	local cQuery as character
	local aTitleStatus := {"A", "P", "B"} as array
	local nX := 0 as numeric
	local lAddStatus := .f. as logical
	local cType as character
	local aBindValues := {} as array
	local lExcludeOverdue := .F. as logical

	if self:jParams:hasProperty("status")
		aTitleStatus := strToKarr(upper(self:jParams["status"]), ",")
	endif

	cQuery := " SE1.E1_FILIAL = ? AND "
	aAdd(aBindValues, {"set": "string", "value": xFilial("SE1")})

	If self:hasValidParam("healthInsurerCode")
    	cQuery += " SE1.E1_CODINT = ? AND "
		aAdd(aBindValues, {"set": "string", "value": self:jParams["healthInsurerCode"]})
	endif

	If self:hasValidParam("companyCode")
		cQuery += " SE1.E1_CODEMP = ? AND "
		aAdd(aBindValues, {"set": "string", "value": self:jParams["companyCode"]})
	endif

	If self:hasValidParam("familyCode")
		cQuery += " SE1.E1_MATRIC = ? AND "
		aAdd(aBindValues, {"set": "string", "value": self:jParams["familyCode"]})
	Else
		If self:hasValidParam("contractCode")
			cQuery += " SE1.E1_CONEMP = ? AND "
			aAdd(aBindValues, {"set": "string", "value": self:jParams["contractCode"]})
		EndIf

		If self:hasValidParam("contractVersionCode")
			cQuery += " SE1.E1_VERCON = ? AND "
			aAdd(aBindValues, {"set": "string", "value": self:jParams["contractVersionCode"]})
		EndIf

		If self:hasValidParam("subcontractCode")
			cQuery += " SE1.E1_SUBCON = ? AND "	
			aAdd(aBindValues, {"set": "string", "value": self:jParams["subcontractCode"]})	
		EndIf

		If self:hasValidParam("subcontractVersionCode")
			cQuery += " SE1.E1_VERSUB = ? AND "
			aAdd(aBindValues, {"set": "string", "value": self:jParams["subcontractVersionCode"]})	
		EndIf
	EndIf

	if self:hasValidParam("type")
		cQuery += " SE1.E1_TIPO IN (?) AND "
		aAdd(aBindValues, {"set": "in", "value": strToKarr(self:jParams["type"], ",")})
	else
		cType := strTran(getNewPar("MV_PLSTIT", "DP"), "'", "")

		cQuery += " SE1.E1_TIPO IN (?) AND "
		aAdd(aBindValues, {"set": "in", "value": strToKarr(cType, ",")})
	endif

	if self:hasValidParam("status")
		lExcludeOverdue := self:hasValidParam("excludeOverdue") .and. self:jParams["excludeOverdue"] == "true"

		cQuery += " ( "
		for nX := 1 to len(aTitleStatus)
			do case
				case aTitleStatus[nX] == "A" // Em aberto
					cQuery += "( E1_SALDO = E1_VALOR " + iif(lExcludeOverdue, "AND E1_VENCREA >= " + dtos(dDataBase), "") + ")"
					lAddStatus := .t.

				case aTitleStatus[nX] == "P" // Baixado Parcialmente
					cQuery += "( E1_SALDO > 0 AND E1_SALDO < E1_VALOR " + iif(lExcludeOverdue, "AND E1_VENCREA >= " + dtos(dDataBase), "") + ")"
					lAddStatus := .t.

				case aTitleStatus[nX] == "B" // Baixado Totalmente
					cQuery += "( E1_SALDO = 0 ) "
					lAddStatus := .t.
				
				case aTitleStatus[nX] == "V" // Vencidas
					cQuery += "( E1_VENCREA < " + dtos(dDataBase) + " AND E1_SALDO > 0 ) "
					lAddStatus := .t.
			endcase

			if nX < len(aTitleStatus)
				if aTitleStatus[nX+1] $ "A/P/B/V" .And. lAddStatus
					cQuery += " OR "
					lAddStatus := .f.
				endif 		
			endif
		next nX
		cQuery += ") AND "
	endif

	if self:hasValidParam("situation")
		cQuery += " SE1.E1_SITUACA IN (?) AND "
		aAdd(aBindValues, {"set": "in", "value": strToKarr(self:jParams["situation"], ",")})
	endif

	if self:hasValidParam("startDate")
		cQuery += " SE1.E1_VENCREA >= ? AND "
		aAdd(aBindValues, {"set": "date", "value": stod(self:convertDateFormat(self:jParams["startDate"], "S"))})
	endif

	if self:hasValidParam("endDate")
		cQuery += " SE1.E1_VENCREA <= ? AND "
		aAdd(aBindValues, {"set": "date", "value": stod(self:convertDateFormat(self:jParams["endDate"], "S"))})
	endif

	if self:hasValidParam("number")
		cQuery += " SE1.E1_NUM = ? AND "
		aAdd(aBindValues, {"set": "string", "value": self:jParams["number"]})
	endif

	if self:hasValidParam("customer")
		cQuery += " (SE1.E1_CLIENTE = ? OR SE1.E1_NOMCLI LIKE '?%') AND "
		aAdd(aBindValues, {"set": "string", "value": upper(self:jParams["customer"])})
		aAdd(aBindValues, {"set": "unsafe", "value": upper(self:jParams["customer"])})
	endif

	cQuery += " SE1.D_E_L_E_T_ = ? "
	aAdd(aBindValues, {"set": "string", "value": " "})

	cQuery := self:bindValuesToQuery(cQuery, aBindValues)

	fwFreeArray(aBindValues)

return cQuery

/*/{Protheus.doc} getOrderTitles
Método responsavel por retornar a ORDEM da query que busca os títulos
@type Method
@author Vinicius Queiros Teixeira
@since 14/02/2023
@version Protheus 12
/*/
method getOrderTitles() as Character class TitleAdapter

	local cOrdemQuery as character
	
	cOrdemQuery := "SE1.E1_PREFIXO, SE1.E1_NUM, SE1.E1_PARCELA, SE1.E1_TIPO"

return cOrdemQuery

/*/{Protheus.doc} compositionsFieldsMap
Retorna o mapeamento dos campos utilizados para composições.
@type method
@version 12.1.2510
@author vinicius.queiros
@since 24/11/2025
@return logical, indica se o mapeamento dos campos de composições foi obtido com sucesso
/*/
method compositionsFieldsMap() as logical class TitleAdapter

	self:oAdapterBase:addMapFields("subscriberId", "BM1_MATUSU", .T., .F., {"BM1_MATUSU", "C", tamSX3("BM1_MATUSU")[1], 0})
	self:oAdapterBase:addMapFields("beneficiaryName", "BM1_NOMUSR", .T., .F., {"BM1_NOMUSR", "C", tamSX3("BM1_NOMUSR")[1], 0})
	self:oAdapterBase:addMapFields("typeCode", "BM1_CODTIP", .T., .F., {"BM1_CODTIP", "C", tamSX3("BM1_CODTIP")[1], 0})
	self:oAdapterBase:addMapFields("typeDescription", "BM1_DESTIP", .T., .F., {"BM1_DESTIP", "C", tamSX3("BM1_DESTIP")[1], 0})
	self:oAdapterBase:addMapFields("type", "BM1_TIPO", .T., .F., {"BM1_TIPO", "C", tamSX3("BM1_TIPO")[1], 0})
	self:oAdapterBase:addMapFields("amount", "BM1_VALOR", .T., .F., {"BM1_VALOR", "N", tamSX3("BM1_VALOR")[1], 0})
	self:oAdapterBase:addMapFields("baseMonth", "BM1_MES", .T., .F., {"BM1_MES", "C", tamSX3("BM1_MES")[1], 0})
	self:oAdapterBase:addMapFields("baseYear", "BM1_ANO", .T., .F., {"BM1_ANO", "C", tamSX3("BM1_ANO")[1], 0})
	
return .T.

/*/{Protheus.doc} getCompositionsQuery
Retorna a expressão SQL utilizada para consultar as composições do título.
@type method
@version 12.1.2510
@author vinicius.queiros
@since 24/11/2025
@return character, expressão SQL utilizada na consulta das composições
/*/
method getCompositionsQuery() as character class TitleAdapter

	local cQuery as character
	local aBindValues := {} as array

	cQuery := " SELECT #QueryFields# "
	cQuery += " FROM ? BM1 "
	cQuery += " WHERE #QueryWhere# "

	aAdd(aBindValues, {"set": "unsafe", "value": retSqlName("BM1")})

	cQuery := self:bindValuesToQuery(cQuery, aBindValues)

	fwFreeArray(aBindValues)

return cQuery

/*/{Protheus.doc} getCompositionsWhere
Retorna a cláusula WHERE utilizada na consulta das composições do título.
@type method
@version 12.1.2510
@author vinicius.queiros
@since 24/11/2025
@return character, cláusula WHERE aplicada na consulta das composições
/*/
method getCompositionsWhere() as character class TitleAdapter

	local cWhere as character
	local aBindValues := {} as array

	cWhere := " BM1.BM1_FILIAL = ? AND "
	cWhere += " BM1.BM1_PREFIX = ? AND "
	cWhere += " BM1.BM1_NUMTIT = ? AND "
	cWhere += " BM1.BM1_PARCEL = ? AND "
	cWhere += " BM1.BM1_TIPTIT = ? AND "
	cWhere += " BM1.D_E_L_E_T_ = ? "

	aAdd(aBindValues, {"set": "string", "value": xFilial("BM1")})
	aAdd(aBindValues, {"set": "string", "value": self:jParams["prefix"]})
	aAdd(aBindValues, {"set": "string", "value": self:jParams["number"]})
	aAdd(aBindValues, {"set": "string", "value": self:jParams["parcel"]})
	aAdd(aBindValues, {"set": "string", "value": self:jParams["type"]})
	aAdd(aBindValues, {"set": "string", "value": " "})

	cWhere := self:bindValuesToQuery(cWhere, aBindValues)

	fwFreeArray(aBindValues)

return cWhere

/*/{Protheus.doc} getCompositionsOrder
Retorna a cláusula ORDER BY utilizada na consulta das composições do título.
@type method
@version 12.1.2510
