#Include 'tlpp-core.th'
#Include 'tlpp-rest.th'
#Include "FWLIBVERSION.CH"

//-------------------------------------------------------------------
/*/{Protheus.doc} health.api.dta.request.tlpp
Realiza todas as integrações com o TOTVS DTA

@author  Nicole Luna
@version P12
@since   17/11/2025

/*/
//-------------------------------------------------------------------

@Post("/totvshealthplans/v1/dtaExtract")
function healthPostDTAExtract()
    local oRequest  := HealthDTAExtractRequest():new(oRest,'DTAExtract')

    oRequest:valida()
    oRequest:procPost()
    oRequest:endRequest()

return

@Post("/totvshealthplans/v1/dtaValidate")
function healthPostDTAResponse()
    local oRequest  := HealthDTAExtractRequest():new(oRest,'DTAValidate')

    oRequest:valida()
    oRequest:procValidResponse()
    oRequest:endRequest()

return

@Get("/totvshealthplans/v1/dtaConfig")
function healthGetDTAConfig()
    local oRequest  := HealthDTAExtractRequest():new(oRest,'DTAConfig')

    oRequest:procGetConfig()
    oRequest:endRequest()

return

class HealthDTAExtractRequest from CenRequest 

    Public Method new()
    Public Method procPost()
    Public Method procValidResponse()
    Public Method procGetConfig()
    Public Method valida()
    Public Method getToken()
    Public Method getResponseDta()
    Public Method readFile()
    Public Method getBodyToDta(cFileName, cBoundary, cFileBin)
    Public Method getQuery(cFilter, cCustomWhere, cProcedureId)
    Public Method setJsonResponse(oJson,cFilter, cCustomWhere)

    Public data aHeader
    Public data nIndexFile
    Public data nIndexData
    
endClass

Method New(oRest, cApi) class HealthDTAExtractRequest
    _Super:new(oRest,cApi,.t.)
    self:nIndexFile := 0
    self:nIndexData := 0
    self:aHeader    := {}
Return self

Method procPost() class HealthDTAExtractRequest
    Local oJson        := JsonObject():new()
    Local oJsonRet     := JsonObject():new()
    Local oFWRest      := nil
    Local cFilter      := ''
    Local cCustomWhere := ''
    Local nI           := 0

    //Valida se os campos obrigatórios foram enviados
    If Len(self:jRequest["Elements"]) == 0 .OR.; 
       aScan( self:jRequest["Elements"], { |e| Upper(e["Name"]) == "FILE" .OR. Upper(e["Name"]) == "FILES" } ) == 0 .OR.; 
       aScan( self:jRequest["Elements"], { |e| Upper(e["Name"]) == "DATA" } ) == 0 
        self:lSuccess       := .F.
        self:nFault         := 400
        self:nStatus        := 400
        self:cFaultDesc     := "Corpo da requisição inválido!"
        self:cFaultDetail   := "Obrigatórios: 'file' e 'data'"
    else 
        For nI := 1 To Len(self:jRequest["Elements"])
            If Upper(self:jRequest["Elements"][nI]["Name"]) == "FILE" .OR.;
               Upper(self:jRequest["Elements"][nI]["Name"]) == "FILES"
                self:nIndexFile := nI
                Loop
            EndIf

            If Upper(self:jRequest["Elements"][nI]["Name"]) == "DATA"
                self:nIndexData := nI
                Loop
            EndIf
        Next 

        cFilter      := self:jRequest["Elements"][self:nIndexData]['Value']['filter']
        cCustomWhere := self:jRequest["Elements"][self:nIndexData]['Value']['customWhere']

        oFWRest := self:getResponseDta()
        
        If self:lSuccess
            oJsonRet:fromJSON(oFWRest:GetResult())
            oJson:fromJSON(cvaltochar(oJsonRet['jsonDoc']))
            self:lSuccess := valtype(oJson['procedures']) == "A"
            if self:lSuccess
                self:setJsonResponse(oJson, cFilter, cCustomWhere)            
            endif
        EndIf

        if !self:lSuccess
            self:nFault         := 400
            self:nStatus        := 400
            self:cFaultDesc     := "Ocorreu um erro ao processar a requisição!"
            self:cFaultDetail   := self:cFaultDesc
        endif

        self:cResponse := self:oRespBody:tojson()

        FreeObj(oFWRest)
        oFWRest := Nil
    Endif 

    FreeObj(oJson)
    oJson := Nil

    FreeObj(oJsonRet)
    oJsonRet := Nil

Return 

Method procValidResponse() class HealthDTAExtractRequest
    Local oJson      := self:jRequest
    
    if self:lSuccess
        if valtype(oJson['procedures']) == "A" .AND.;
           valtype(oJson['filter']) == 'C' .AND.;
           valtype(oJson['customWhere']) == 'C'
            self:setJsonResponse(oJson, oJson['filter'], oJson['customWhere'])
        else
            self:lSuccess       := .F.
            self:nFault         := 400
            self:nStatus        := 400
            self:cFaultDesc     := "Corpo da requisição inválido!"
            self:cFaultDetail   := "Obrigatório: 'filter', 'customWhere' e array 'procedures'"
        endif    
    endif

    self:cResponse := self:oRespBody:tojson()

    FreeObj(oJson)
    oJson := Nil

Return 
    
Method valida() class HealthDTAExtractRequest
    _Super:checkBody(.t.)
Return 

Method getToken() class HealthDTAExtractRequest
    local cBody             := ''
    local oRest             := nil
    local oJson             := nil
    local cToken            := ''
    local cTotvsId          := GetNewPar("MV_PIDDTA","")
    local cProjectId        := GetNewPar("MV_PPRODTA","")
    local cUserDta          := GetNewPar("MV_PUSRDTA","")

    if self:lSuccess
        cBody += '{ '
        cBody += '  "totvsId": "' + cTotvsId + '", '
        cBody += '  "projectId": "' + cProjectId + '", '
        cBody += '  "user": "' + cUserDta + '" '
        cBody += '} '

        oRest := FWRest():New('https://auth.dta.totvs.io/api/productKey/auth/token')
        oRest:setPath("")
        oRest:setPostParams(cBody)
        self:lSuccess  := oRest:post({"Content-Type: application/json"})

        if self:lSuccess
            oJson   := jsonObject():new()
            oJson:fromJSON(oRest:GetResult())
            cToken := cvaltochar(oJson['token'])
        endif

        FreeObj(oJson)
        oJson := Nil

        FreeObj(oRest)
        oRest := Nil
    endif

Return cToken

Method getResponseDta() class HealthDTAExtractRequest
    Local aRet      := {}
    Local cFileName := ''
    Local cFileBin  := ''
    Local cBody     := ''
    Local cBoundary := "----BOUNDARY" + StrTran(Time(),":","") 
    Local aHeader   := {}
    Local cToken    := ''
    Local cUrl      := 'https://visiondocument.dta.totvs.io/api/dta-vision-ocr/dataExtract'
    Local oFWRest   := nil

    cToken := self:getToken()

    if self:lSuccess
        aRet      := self:readFile()

        if Len(aRet) > 0
            cFileName := aRet[1]
            cFileBin  := aRet[2]

            cBody := self:getBodyToDta(cFileName, cBoundary, cFileBin)

            AAdd(aHeader, "Content-Type: multipart/form-data; boundary=" + cBoundary)
            AAdd(aHeader, "Accept: application/json")
            AAdd(aHeader, "Authorization: Bearer " + cToken) 

            oFWRest := FWRest():New(cUrl)
            oFWRest:SetPath('')
            oFWRest:SetPostParams(cBody)  

            self:lSuccess := oFWRest:Post(aHeader) .OR. (oFWRest:getHttpCode() >= "200" .AND. oFWRest:getHttpCode() <= "299")
        endif
    endif 

Return @oFWRest

Method readFile() class HealthDTAExtractRequest
    Local cFilePath := StrTran(StrTran(SubStr(self:jrequest['Elements'][self:nIndexFile]['UploadDir'], At("protheus_data", self:jrequest['Elements'][self:nIndexFile]['UploadDir']) + Len("protheus_data")), "./", ""), "/", "\") + self:jrequest['Elements'][self:nIndexFile]['UploadName']
    Local oFile     := FwFileReader():New(cFilePath)
    Local cFileBin  := ""
    Local cFileName := ""
    Local aRet      := {}

    self:lSuccess := oFile:Open()

    if self:lSuccess
        cFileBin  := oFile:FullRead()   
        cFileName := self:jRequest["Elements"][self:nIndexData]['Value']['fileName']
        
        aRet := { cFileName, cFileBin }
    endif

    FreeObj(oFile)
    oFile := Nil

Return aRet

Method getBodyToDta(cFileName, cBoundary, cFileBin)  class HealthDTAExtractRequest
    Local cBody       := ''
    Local cCRLF       := Chr(13) + Chr(10)
    Default cFileName := ''
    Default cBoundary := ''
    Default cFileBin  := ''

    // monta o body multipart/form-data 
    cBody += "--" + cBoundary + cCRLF
    cBody += 'Content-Disposition: form-data; name="File"; filename="' + cFileName + '"' + cCRLF
    cBody += "Content-Type: image/jpeg" + cCRLF + cCRLF
    cBody += cFileBin + cCRLF

    cBody += "--" + cBoundary + cCRLF
    cBody += 'Content-Disposition: form-data; name="UserFieldsJson"' + cCRLF + cCRLF
    cBody += '[ '
    cBody += '   { '
    cBody += '      "fieldName":"procedures", '
    cBody += '      "fieldType":"array", '
    cBody += '      "userArray":[ '
    cBody += '         { '
    cBody += '            "fieldName":"procedureDescription", '
    cBody += '            "fieldType":"string" '
    cBody += '         }, '
    cBody += '         { '
    cBody += '            "fieldName":"procedureCode", '
    cBody += '            "fieldType":"string" '
    cBody += '         } '
    cBody += '      ] '
    cBody += '   } '
    cBody += '] '
    cBody += cCRLF

    cBody += "--" + cBoundary + "--" + cCRLF

Return cBody

Method getQuery(cFilter, cCustomWhere, cProcedureId) class HealthDTAExtractRequest
    Local cSql           := ''
    Local oRequest       := nil
    Default cFilter      := ''
    Default cProcedureId := ''
    Default cCustomWhere := ''

    oRequest := PLSProceduresRequest():New(self:oRest)
    cSql := oRequest:exportQuery(cFilter, cCustomWhere, cProcedureId)
    
    oRequest:destroy()

    FreeObj(oRequest)
    oRequest := Nil
    
Return cSql

Method setJsonResponse(oJsonDta, cFilter, cCustomWhere) class HealthDTAExtractRequest
    Local cAlias         := Getnextalias()
    Local nX             := 0
    Local nLenProc       := 0
    Local cTableCode     := ''
    Local cSql           := ''
    Local cFilterAux     := ''
    Default oJsonDta     := jsonObject():new()
    Default cFilter      := ''
    Default cCustomWhere := ''

    cFilterAux := cFilter

    self:oRespBody['proceduresNotFound'] := {}
    self:oRespBody['procedures'] := {}

    for nX := 1 to len(oJsonDta['procedures'])
        cFilter    := cFilterAux
        cTableCode := ''        
        //Neste primeiro momento vai validar apenas pelo codigo
        if !empty(cvaltochar(oJsonDta['procedures'][nX]['procedureCode']))
            cFilter += " and procedureId eq '" + oJsonDta['procedures'][nX]['procedureCode'] + "' "
            cSql := self:getQuery(cFilter, cCustomWhere, oJsonDta['procedures'][nX]['procedureCode'])
            dbUseArea(.T.,"TOPCONN",TCGENQRY(,,cSql),cAlias,.F.,.T.)

            if !(cAlias)->(eof())
                while !(cAlias)->(eof())
                    //Protecao de inconsistencia na base
                    if cTableCode <> (cAlias)->TABLECODE
                        aadd(self:oRespBody['procedures'],jsonObject():new())
                        nLenProc := len(self:oRespBody['procedures'])
                        self:oRespBody['procedures'][nLenProc]['tableCode']            := Alltrim((cAlias)->TABLECODE)
                        self:oRespBody['procedures'][nLenProc]['procedureCode']        := Alltrim((cAlias)->PROCIDJSON)
                        self:oRespBody['procedures'][nLenProc]['procedureDescription'] := Alltrim((cAlias)->PRODESJSON)
                    endif 
                    cTableCode := (cAlias)->TABLECODE
                    (cAlias)->(DbSkip())
                endDo
            else
                aadd(self:oRespBody['proceduresNotFound'],jsonObject():new())
                nLenProc := len(self:oRespBody['proceduresNotFound'])
                self:oRespBody['proceduresNotFound'][nLenProc]['code']            := cvaltochar(oJsonDta['procedures'][nX]['procedureCode'])
                self:oRespBody['proceduresNotFound'][nLenProc]['description']     := cvaltochar(oJsonDta['procedures'][nX]['procedureDescription'])
            endif

            (cAlias)->(dbCloseArea())
                    
            cProcAux := oJsonDta['procedures'][nX]['procedureCode']
        elseif !empty(cvaltochar(oJsonDta['procedures'][nX]['procedureDescription']))
            aadd(self:oRespBody['proceduresNotFound'],jsonObject():new())
            nLenProc := len(self:oRespBody['proceduresNotFound'])
            self:oRespBody['proceduresNotFound'][nLenProc]['description']     := cvaltochar(oJsonDta['procedures'][nX]['procedureDescription'])
            self:oRespBody['proceduresNotFound'][nLenProc]['code']            := ""
        endif                
    next

    FreeObj(oJsonDta)
    oJsonDta := Nil

Return 

Method procGetConfig() Class HealthDTAExtractRequest
    Local cTotvsId   := GetNewPar("MV_PIDDTA","")
    Local cProjectId := GetNewPar("MV_PPRODTA","")
    Local cUserDta   := GetNewPar("MV_PUSRDTA","")

    self:oRespBody['totvsId']   := cTotvsId
    self:oRespBody['projectId'] := cProjectId
    self:oRespBody['user']      := cUserDta

    self:cResponse := self:oRespBody:tojson()
Return 
