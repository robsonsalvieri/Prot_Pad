/*/{Protheus.doc} pinsCheckEnv
Validação do ambiente: Produção ou Engenharia Protheus Insights

@return lChkEnv, Logical, TRUE=Validou; FALSE=Não Validou

@author plinio.cfilho
@since 18/09/2025
/*/
//-------------------------------------------------------------------------------------
Function pinsCheckEnv()

	Local lChkEnv   As Logical

	lChkEnv := ( ( totvs.framework.environment.type.envAppGet( .T. ) == "1" ) .Or. ;    // 1=Produção;2=Homologação;3=Desenvolvimento
        ( FindClass( "FWEngineeringUtils" ) .And. FWEngineeringUtils():isAlphaEnvironment() ) )

Return lChkEnv

//-------------------------------------------------------------------------------------
/*/{Protheus.doc} deleteRecords
Função genérica que realiza o expurgo de dados do insight

@param cInsight, caracter, nome do insight
@param cDate, caracter, Data de corte

@author  Marcia Junko
@since   22/12/2025
/*/
//-------------------------------------------------------------------------------------
Function deleteRecords( cInsight, cDate  )
    Local aArea  := GetArea()
    Local cQuery := ''

    Default cDate := DTOS( Date() - 30 )

    //Limpa os registros de um determinado insight na tabela I21
    cQuery := "DELETE FROM " + RetSqlName( "I21" ) + ;
        " WHERE I21_INSIGT = '" + Alltrim( cInsight ) + "'" + ;
        " AND I21_DTPROC < '" + cDate + "' " + ;
        " AND D_E_L_E_T_ = ' ' "

    TcSqlExec( cQuery )

    //Limpa os registros de um determinado insight na tabela I19
    cQuery := "DELETE FROM " + RetSqlName( "I19" ) + ;
        " WHERE I19_INSIGT = '" + Alltrim( cInsight ) + "' " + ;
        " AND I19_DTPROC < '" + cDate + "' " + ;
        " AND D_E_L_E_T_ = ' ' "

    TcSqlExec( cQuery )    

    RestArea( aArea )

    aSize( aArea, 0 )
    aArea := NIL
Return 

//-------------------------------------------------------------------------------------
/*/{Protheus.doc} maxDTProc_I19
Função genérica que avalia o último registro de um insight pela data de processamento.

@param cInsight, caracter, nome do insight

@return array, Vetor com a maior data de processamento de um insight e o Recno
@author  Marcia Junko
@since   22/12/2025
/*/
//-------------------------------------------------------------------------------------
Function maxDTProc_I19( cInsight )
    Local aArea  := GetArea()
    Local aReturn := {}
    Local cQuery := ''
    Local cNextAlias := ''

    cQuery := "SELECT I19_DTPROC, R_E_C_N_O_ ID " + ;
        " FROM ? " + ;
        " WHERE I19_FILIAL = ? " + ;
            " AND I19_INSIGT =  ? " + ;
            " AND I19_DTPROC = ( SELECT MAX( I19_DTPROC ) I19_DTPROC " + ;
                " FROM ? " + ;
                " WHERE I19_FILIAL = ? " + ;
                    " AND I19_INSIGT = ? " + ;
                    " AND D_E_L_E_T_ = ? ) " + ;
            " AND D_E_L_E_T_ = ? "

    cQuery := ChangeQuery( cQuery )
    oQuery := FWExecStatement():New( cQuery )
    oQuery:SetUnsafe( 1, RetSqlName( "I19" ) )
    oQuery:SetString( 2, xFilial( "I19" ) )
    oQuery:SetString( 3, Alltrim( cInsight ) )
    oQuery:SetUnsafe( 4, RetSqlName( "I19" ) )
    oQuery:SetString( 5, xFilial( "I19" ) )
    oQuery:SetString( 6, Alltrim( cInsight ) )
    oQuery:SetString( 7, '' )
    oQuery:SetString( 8, '' )

	cNextAlias := oQuery:OpenAlias()

	If ( cNextAlias )->(!Eof())
		aReturn := { ( cNextAlias )->I19_DTPROC, ( cNextAlias )->ID }
	EndIf

    ( cNextAlias )->( DbCloseArea() )

    RestArea( aArea )

    aSize( aArea, 0 )
    aArea := NIL
    FreeObj( oQuery )
Return aReturn

//-------------------------------------------------------------------------------------
/*/{Protheus.doc} maxDTProc_I21
Função genérica que avalia o último registro de um insight pela data de processamento
da tabela I21.
@param cInsight, caracter, nome do insight

@return array, Vetor com a maior data de processamento de um insight e o Recno
@author  Marcia Junko
@since   22/12/2025
/*/
//-------------------------------------------------------------------------------------
Function maxDTProc_I21( cInsight )
    Local aArea  := GetArea()
    Local aReturn := {}
    Local cQuery := ''
    Local cNextAlias := ''

    cQuery := "SELECT I21_DTPROC, R_E_C_N_O_ ID " + ;
        " FROM ? " + ;
        " WHERE I21_FILIAL = ? " + ;
            " AND I21_INSIGT =  ? " + ;
            " AND I21_DTPROC = ( SELECT MAX( I21_DTPROC ) I21_DTPROC " + ;
                " FROM ? " + ;
                " WHERE I21_FILIAL = ? " + ;
                    " AND I21_INSIGT = ? " + ;
                    " AND D_E_L_E_T_ = ? ) " + ;
            " AND D_E_L_E_T_ = ? "

    cQuery := ChangeQuery( cQuery )
    oQuery := FWExecStatement():New( cQuery )
    oQuery:SetUnsafe( 1, RetSqlName( "I21" ) )
    oQuery:SetString( 2, xFilial( "I21" ) )
    oQuery:SetString( 3, Alltrim( cInsight ) )
    oQuery:SetUnsafe( 4, RetSqlName( "I21" ) )
    oQuery:SetString( 5, xFilial( "I21" ) )
    oQuery:SetString( 6, Alltrim( cInsight ) )
    oQuery:SetString( 7, '' )
    oQuery:SetString( 8, '' )

	cNextAlias := oQuery:OpenAlias()

	If ( cNextAlias )->(!Eof())
		aReturn := { ( cNextAlias )->I21_DTPROC, ( cNextAlias )->ID }
	EndIf

    ( cNextAlias )->( DbCloseArea() )

    RestArea( aArea )

    aSize( aArea, 0 )
    aArea := NIL
    FreeObj( oQuery )
Return aReturn


//-------------------------------------------------------------------------------------
/*/{Protheus.doc} findI19InsightID
Função genérica que busca o maior ID ( Recno ) de um insight na tabela I19 para atualizá-lo.
Caso seja uma permission, realiza a limpeza para haver apenas 1 registro.

@param cInsight, caracter, nome do insight
@param lClear, logical, Indica se deve realizar o processo de limpeza

@return integer, Retorna o Recno da maior data de processamento deste insight.
@author  Marcia Junko
@since   22/12/2025
/*/
//-------------------------------------------------------------------------------------
Function findI19InsightID( cInsight, lClear )
    Local aMaxInfo := {}
    Local nCount := 0
    Local nID := 0

    Default cInsight := 'Permission'
    Default lClear := .T.

    aMaxInfo := maxDTProc_I19( cInsight )

    If ( "permission" $ Lower( cInsight ) ) .And. !Empty( aMaxInfo )
        nCount := PINSA030Count( cInsight )

        If (  nCount > 1 ) .And. lClear
            // chama a função de limpeza das permission para que haja apenas 1 registro
            deleteRecords( cInsight, aMaxInfo[ 1 ] )
        EndIf
        nID := aMaxInfo[ 2 ]
    EndIf

    aSize( aMaxInfo, 0 )
    aMaxInfo := NIL
Return nID

//-------------------------------------------------------------------------------------
/*/{Protheus.doc} findI21InsightID
Função genérica que busca o maior ID ( Recno ) de um insight na tabela I19 para atualizá-lo.
Caso seja uma permission, realiza a limpeza para haver apenas 1 registro.

@param cInsight, caracter, nome do insight
@param lClear, logical, Indica se deve realizar o processo de limpeza

@return integer, Retorna o Recno da maior data de processamento deste insight.
@author  Marcia Junko
@since   22/12/2025
/*/
//-------------------------------------------------------------------------------------
Function findI21InsightID( cInsight, lClear )
    Local aMaxInfo := {}
    Local nCount := 0
    Local nID := 0

    Default cInsight := 'Permission'
    Default lClear := .T.

    aMaxInfo := maxDTProc_I21( cInsight )

    If ( "permission" $ Lower( cInsight ) ) .And. !Empty( aMaxInfo )
        nCount := PINSA030Count( cInsight )

        If (  nCount > 1 ) .And. lClear
            // chama a função de limpeza das permission para que haja apenas 1 registro
            deleteRecords( cInsight, aMaxInfo[ 1 ] )
        EndIf
        nID := aMaxInfo[ 2 ]
    EndIf

    aSize( aMaxInfo, 0 )
    aMaxInfo := NIL
Return nID
