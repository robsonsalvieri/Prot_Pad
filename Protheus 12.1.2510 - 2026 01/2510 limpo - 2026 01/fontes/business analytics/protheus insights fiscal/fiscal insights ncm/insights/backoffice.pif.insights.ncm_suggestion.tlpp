#include 'tlpp-core.th'
#include 'InsightDefs.ch'

REGISTER INSIGHT ncm_suggestion

//-------------------------------------------------------------------
/*{Protheus.doc} Class ncm_suggestion
	Classe com configuração do insight ncm_suggestion.

	Método New() construtor da classe.
	Método Config() configurações do insight gravados na tabela I20.
	Método Struct() estrutura da tabela temporária gravada no campo Memo I21_PAYLOD.

	@type Class
    @author Squad PIF
    @return Nil
*/
//-------------------------------------------------------------------
Class ncm_suggestion from PinsConfig
	Public Method New() CONSTRUCTOR
	Public Method Config()
	Public Method Struct()
EndClass

//-------------------------------------------------------------------
/*{Protheus.doc} New
	Método construtor da classe.

    @type Method
    @author Squad PIF
    @return Object, retorna o objeto criado
*/
//-------------------------------------------------------------------
Method New() class ncm_suggestion
	_Super:New( 'ncm_suggestion', 'FIS' )
Return Self

//-------------------------------------------------------------------
/*{Protheus.doc} Config
	Indica a configuração dos atributos utilizados pelo insight ncm_suggestion
	que serão gravados na tabela I20.

	@type Method
    @author Squad PIF
    @return Nil
*/
//-------------------------------------------------------------------
Method Config() class ncm_suggestion

	::SetHasKey( .T. )
	::SetHasFilter( .T. )
	::SetPriority( .T. )

	::SetKey("key")
    
Return

//-------------------------------------------------------------------
/*{Protheus.doc} Struct
	Indica os campos que fazem parte da tabela temporária e como estas 
	informações serão tratadas.

	A estrutura a ser definida deve ter a seguinte estrutura:
		[1] - nome da propriedade na mensagem ( campo memo da tabela I21 )
		[2] - estrutura de campo da tabela temporária
			[1] - Nome da coluna
			[2] - tipo
			[3] - tamanho
			[4] - decimal
		[3] - Indica se a coluna pode ser usada no filtro de pesquisa
		[4] - Texto apresentado
		[5] - Indica a ordem apresentada no browse
		[6] - Indica que a propriedade da mensagem contém uma chave composta

	@type Method
	@author Squad PIF
	@return Nil
*/
//-------------------------------------------------------------------
Method Struct() class ncm_suggestion
	Local aStruct := {}

	aStruct := PIFC010Fld()
	aStruct := PINSDebugFields(aStruct)

	_Super:SetStruct( aStruct )

Return
