#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "backoffice.pif.fiscal.insight.ncm.confirm.suggestion.data.ch"

namespace totvs.protheus.backoffice.pif.fiscal.insight.ncm
using namespace totvs.protheus.backoffice.pif.util

//------------------------------------------------------------------------------
/* {Protheus.doc} ConfirmSuggestionData
    Classe responsável por obter os dados de confirmação de sugestão de NCM

    @type Class
    @author Squad PIF
    @return Nil
*/
//------------------------------------------------------------------------------
Class ConfirmSuggestionData from FWAdapterBaseV2

	Public Method new() Constructor
	Public Method postConfirmSuggestion()
	Public Method getAdjusteds()             As Json
	Public Method formatAdjusteds()          As Json
	Public Method updResult()

EndClass

//------------------------------------------------------------------------------
/*{Protheus.doc} New
    Metodo construtor

    @type Method
    @author Squad PIF
    @return Object, retorna o objeto criado
/*/
//------------------------------------------------------------------------------
Method new(cMethod as Character) Class ConfirmSuggestionData
    Default cMethod := "GET"

	_Super:New(cMethod)
Return Self

//------------------------------------------------------------------------------
/*{Protheus.doc} getAdjusteds
    Metodo responsável por obter a lista de ncms ajustados

    @type Method
    @author Squad PIF
    @version 1.0
    @param nPage, numeric, numero da pagina
	@param nPageSize, numeric, Quantidade de registros por pagina
    @param cFilter, Character, Filtro a ser aplicado na consulta
    @param cTempTable, Character, Alias da tabela temporária
    @return Json, retorna o objeto json contendo os NCM Ajustados
*/
//------------------------------------------------------------------------------
Method getAdjusteds(nPage as Numeric, nPageSize as Numeric, cFilter as character, cTempTable as character) As Json class ConfirmSuggestionData
	Local cWhere     As Character
	Local aArea      As Array

	Default nPage     := 1
	Default nPageSize := 10

	aArea      := FWGetArea()
	cWhere     := " "

	addMapFieldsAcceptedSuggestions(self)

	::setUseSpaces(.T.)
	::setPage(nPage)
	::setPageSize(nPageSize)
	::SetQuery( getAdjustedsQuery(cTempTable) )

	cWhere := "  I21.I21_FILIAL = '" + FwxFilial("I21") +"' "
	cWhere += "  AND I21.I21_INSIGT = 'ncm_suggestion' "
	cWhere += "  AND I21.I21_STATUS = 'ACP' "
	cWhere += "  AND I21.D_E_L_E_T_ = ' ' "
	cWhere += "  AND TMP.D_E_L_E_T_ = ' ' "

	::SetWhere(cWhere)
	::SetOrder("I21.I21_FILIAL, I21.I21_UIDINS")

	if !Empty(cFilter)

		aUrlFilter := {;
			{"FILTER", cFilter};
			}
		::SetUrlFilter(aUrlFilter)
	endif

	If ::Execute()
		::FillGetResponse()
	EndIf

	FWRestArea(aArea)
	FwFreeArray(aArea)

Return

//------------------------------------------------------------------------------
/*{Protheus.doc} postConfirmSuggestion
    Metodo responsável por confirmar a sugestão de NCM

    @type Method
    @author Squad PIF
    @return Json, retorna o objeto json contendo os dados do dashboard de NCM
/*/
//------------------------------------------------------------------------------
Method postConfirmSuggestion(JBody As Json) class ConfirmSuggestionData
    Local aArea          := FWGetArea()
    Local jResponse      := JsonObject():New()        As Json
    Local aProducts      := {}                        As Array
    Local nX             := 1                         As Numeric

    dbSelectarea("SB1")
    SB1->(dbSetOrder(1))

    aProducts := JBody["products"]

    For nX := 1 to len(aProducts)
        If SB1->(dbSeek(FwxFilial("SB1")+aProducts[nX]["codProd"]))
            If aProducts[nX]["status"] == "ACP"
                RecLock("SB1", .F.)
                SB1->B1_POSIPI := aProducts[nX]["ncmProposed"]
                SB1->(MsUnlock())
            EndIf
            If aProducts[nX]["status"] == "RVT"
                RecLock("SB1", .F.)
                SB1->B1_POSIPI := aProducts[nX]["ncm"]
                SB1->(MsUnlock())
            EndIf 

            ::updResult(aProducts[nX])

            jResponse            := JsonObject():New()
            jResponse["message"] := STR0001 //"NCM alterado com sucesso!"
        EndIf
    Next

    jResponse := getSuccessReponse(jResponse)

    FWRestArea(aArea)
    FwFreeArray(aProducts)
   
Return jResponse

//------------------------------------------------------------------------------
/*/{Protheus.doc} addMapFieldsAcceptedSuggestions
    Metodo responsável por adicionar os campos mapeados para a consulta de Ncms Ajustados

    @type  Static Function
    @author Squad PIF
    @version 1.0
/*/
//------------------------------------------------------------------------------
Static Function addMapFieldsAcceptedSuggestions(oSelf as Object)

    oSelf:addMapFields("branchId"       , "I21_BRANCH", .F., .F., {"I21_BRANCH", "C", GetSx3Cache("I21_BRANCH", "X3_TAMANHO"), 0}, "I21.I21_BRANCH")
    oSelf:addMapFields("id"             , "I21_UIDINS", .T., .F., {"I21_UIDINS", "C", GetSx3Cache("I21_UIDINS", "X3_TAMANHO"), 0}, "I21.I21_UIDINS")
    oSelf:addMapFields("adjusted"       , "I21_RESULT", .T., .F., {"I21_RESULT", "M", GetSx3Cache("I21_RESULT","X3_TAMANHO") , 0}, "I21.I21_RESULT")
    oSelf:addMapFields("playload"       , "I21_PAYLOD", .T., .F., {"I21_PAYLOD", "M", GetSx3Cache("I21_PAYLOD","X3_TAMANHO") , 0}, "I21.I21_PAYLOD")

Return

//------------------------------------------------------------------------------
/*/{Protheus.doc} getAdjustedsQuery
    Metodo responsável por obter a query para a consulta de Ncms Ajustados

    @type  Static Function
    @author Squad PIF
    @version 1.0
    @param cTempTable, Character, Alias da tabela temporária
/*/
//------------------------------------------------------------------------------
Static Function getAdjustedsQuery(cTempTable as Character)
	Local cQuery   As Character

	cQuery := " SELECT #QueryFields# "
	cQuery += " FROM " + RetSqlName("I21") + " I21 "
	cQuery += " INNER JOIN " + cTempTable + " TMP "
	cQuery += " ON TMP.RECNOI21 = I21.R_E_C_N_O_
	cQuery += " WHERE #QueryWhere# "

Return cQuery

//------------------------------------------------------------------------------
/*{Protheus.doc} formatAdjusteds
    Metodo responsável por retornar o objeto json formatado com os dados do insight de NCM Ajustado

    @type  Private Method
    @author Squad PIF
    @version 1.0
    @param Json a ser formatado 
    @return Json, retorna o objeto json com o 
/*/
//------------------------------------------------------------------------------
Method formatAdjusteds(jResponse As Json) As Json Class ConfirmSuggestionData
    Local aArea := FWGetArea()  As Array
    Local jAdjustedNcm          As Json 
    Local JPlayload             As Json 

    aEval(jResponse:GetJsonObject("items"), {|x|,;
        jAdjustedNcm                   := JsonObject():New(),;
        jAdjustedNcm:FromJson(x:GetJsonText("adjusted")),;
        JPlayload                      := JsonObject():New(),;
        JPlayload:FromJson(x:GetJsonText("playload")),;
        jAdjustedNcm["id"]             := x:GetJsonText("id"),;
        jAdjustedNcm["ncmDescription"] := DecodeUTF8(JPlayload:GetJsonText("proposedClassification")),;
        x["adjustedNcm"]               := jAdjustedNcm,;
        x:DelName("adjusted"),;
        x:DelName("playload"),;
        x:DelName("id");
    })

	FWRestArea(aArea)
   
Return jResponse

//------------------------------------------------------------------------------
/*{Protheus.doc} updResult
    Metodo responsável por criar o result a partir da sugestão a ser atualizada na tabela de insights unificada.

    @type  Private Method
    @author Squad PIF
    @version 1.0
    @param Json com a sugestão de NCM a ser atualizada
/*/
//------------------------------------------------------------------------------
Method updResult(jSuggestion as Json) Class ConfirmSuggestionData
    Local aArea      := FWGetArea()                   As Array
    Local cCodUsr    := RetCodUsr()                   As Character  
    Local jResponse  := JsonObject():New()            As Json
    Local cUserName  := AllTrim(UsrRetName(cCodUsr))  As Character
    Local dDate      := Date()                        As Date
    Local cTime      := Time()                        As Character

    dbSelectArea("I21")
    I21->(dbSetOrder(1)) // I21_FILIAL, I21_UIDINS, R_E_C_N_O_, D_E_L_E_T_

    If I21->(dbSeek(FwxFilial("I21") + jSuggestion:GetJsonText("id")))

        jResponse["productCode"]        := jSuggestion:GetJsonText("codProd")
        jResponse["productDescription"] := AllTrim(SB1->B1_DESC)
        jResponse["reason"]             := decodeUTF8(jSuggestion:GetJsonText("reason"),"cp1252")
        jResponse["ncm"]                := jSuggestion:GetJsonText("ncm")
        jResponse["ncmProposed"]        := jSuggestion:GetJsonText("ncmProposed")
        jResponse["userId"]             := cCodUsr
        jResponse["userName"]           := cUserName
        jResponse["date"]               := dDate
        jResponse["hour"]               := cTime
        jResponse:DelName("items")

        RecLock("I21", .F.)
        I21->I21_STATUS := jSuggestion:GetJsonText("status")
        I21->I21_RESULT := jResponse:toJson()
        I21->(MsUnlock())

    EndIf
    
    FreeObj(jResponse) 
    FWRestArea(aArea)
   
Return 

