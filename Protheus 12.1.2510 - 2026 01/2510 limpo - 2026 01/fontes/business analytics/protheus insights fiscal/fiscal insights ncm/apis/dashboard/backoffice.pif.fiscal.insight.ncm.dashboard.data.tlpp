#include "tlpp-core.th"
#include "tlpp-rest.th"

namespace totvs.protheus.backoffice.pif.fiscal.insight.ncm
using namespace totvs.protheus.backoffice.pif.util

//------------------------------------------------------------------------------
/* {Protheus.doc} DashboardData
    Classe responsável pela consulta de dados de insights de NCM

    @type Class
    @author Squad PIF
    @return Nil
*/
//------------------------------------------------------------------------------
Class DashboardData

	Public Method new() Constructor
	Public Method getDashboard()

	Private Method getActiveProducts()
	Private Method divergentNcmCount()
	Private Method aiAdjustedNcmCount()

EndClass

//------------------------------------------------------------------------------
/*{Protheus.doc} New
    Metodo construtor

    @type Method
    @author Squad PIF
    @return Object, retorna o objeto criado
/*/
//------------------------------------------------------------------------------
Method new() Class DashboardData
Return Self

//------------------------------------------------------------------------------
/*{Protheus.doc} getDashboard
    Metodo responsável por obter os dados do dashboard de NCM

    @type Method
    @author Squad PIF
    @param cTempTable, Character, Alias da tabela temporária
    @return Json, retorna o objeto json contendo os dados do dashboard de NCM
/*/
//------------------------------------------------------------------------------
Method getDashboard(cTempTable As Character) class DashboardData
    
    Local JResponse          As Json
    Local oTempTable         As Object

    JResponse := JsonObject():New()
    
    if Empty(cTempTable)
        oTempTable  := PIFC010()
        cTempTable  := oTempTable:getRealName()
    endif
    
    JResponse["tempTable"]          := cTempTable
    JResponse["activeProducts"]     := self:getActiveProducts()
    JResponse["divergentNcmCount"]  := self:divergentNcmCount(cTempTable)
    JResponse["aiAdjustedNcmCount"] := self:aiAdjustedNcmCount(cTempTable)
    JResponse["charts"]             := JsonObject():New()
   
Return JResponse


//------------------------------------------------------------------------------
/*{Protheus.doc} getActiveProducts
    Metodo responsável por obter a quantidade de produtos ativos nos últimos 12 meses

    @type Method
    @author Squad PIF
    @return Json, retorna o objeto json contendo a quantidade de produtos ativos
/*/
//------------------------------------------------------------------------------
Method getActiveProducts() Class DashboardData
    Local oExec              As Object
    Local cQuery             As Character
    Local cAlias             As Character
    Local cDtInicial         As Character
    Local cDtFinal           As Character
    Local nDiasAtras         AS Numeric
    Local nParam             AS Numeric
    Local nActived           AS Numeric

    nActived := 0

    // Query para pegar os movimentos fiscais dos ultimos 12 meses
    cQuery := "SELECT COUNT(DISTINCT SFT.FT_PRODUTO) AS QTD_PRODUTOS_ATIVOS "
    cQuery += "FROM " + RetSqlName("SFT") + " SFT "
    cQuery += "INNER JOIN " + RetSqlName("SB1") + " SB1 ON ? "
    cQuery += "AND SB1.B1_COD = SFT.FT_PRODUTO "
    cQuery += "WHERE SFT.FT_FILIAL = ? "
	cQuery += "  AND SFT.FT_TIPO NOT IN ? "
	cQuery += "  AND SFT.FT_ESPECIE IN ? "
    cQuery += "  AND SFT.FT_EMISSAO BETWEEN ? AND ? "
    cQuery += "  AND SB1.B1_MSBLQL <> ? "
    cQuery += "  AND SFT.D_E_L_E_T_ = ? "
    cQuery += "  AND SB1.D_E_L_E_T_ = ? "

    nDiasAtras := 365
    If AnoBissexto(Year(dDatabase - nDiasAtras))
        nDiasAtras := 366
    EndIf

    // Calcula a data inicial considerando 12 meses atrás
    cDtInicial := DtoS(FirstDate(dDatabase - nDiasAtras))
    cDtFinal   := DtoS(dDatabase)

    cQuery := ChangeQuery(cQuery)
    oExec  := FwExecStatement():New(cQuery)

    nParam := 1
    oExec:SetUnsafe(nParam++, FWJoinFilial("SFT", "SB1"))
    oExec:SetString(nParam++, FWxFilial("SFT"))
    oExec:SetUnsafe(nParam++, "('S', 'I', 'C', 'P')")
    oExec:SetUnsafe(nParam++, "('NF', 'NFE', 'SPED', 'SATCE', 'NFCE')")
    oExec:SetString(nParam++, cDtInicial)
    oExec:SetString(nParam++, cDtFinal)
    oExec:SetString(nParam++, "1")
    oExec:SetString(nParam++, "")
    oExec:SetString(nParam++, "")

    cAlias := oExec:OpenAlias()

    if (cAlias)->(!eOf())
        nActived := (cAlias)->QTD_PRODUTOS_ATIVOS
    endif

    (cAlias)->(DbCloseArea())

    oExec:Destroy()
    FWFreeObj(oExec)

Return nActived

//------------------------------------------------------------------------------
/*{Protheus.doc} divergentNcmCount
    Metodo responsável por obter a quantidade de produtos com divergência

    @type Method
    @author Squad PIF
    @param cTempTable, Character, Alias da tabela temporária
    @return Json, retorna o objeto json contendo a quantidade de produtos ativos
/*/
//------------------------------------------------------------------------------
Method divergentNcmCount(cTempTable As Character) Class DashboardData
    Local oExec              As Object
    Local cQuery             As Character
    Local cAlias             As Character
    Local nParam             AS Numeric
    Local nDivergent         AS Numeric

    nDivergent := 0

	cQuery := " SELECT COUNT(DISTINCT PRODCODE) AS QTD_NCM_DIVERGENTES "
	cQuery += " FROM ? TMP "
	cQuery += " INNER JOIN " + RetSqlName("I21") + " I21 "
	cQuery += " ON I21.R_E_C_N_O_ = TMP.RECNOI21
	cQuery += " WHERE "
	cQuery += " I21.I21_BRANCH = ? "
	cQuery += " AND I21.I21_STATUS = ? "
	cQuery += " AND TMP.D_E_L_E_T_ = ? "
	cQuery += " AND I21.D_E_L_E_T_ = ? "

    cQuery := ChangeQuery(cQuery)
    oExec  := FwExecStatement():New(cQuery)

    nParam := 1
    oExec:SetUnsafe(nParam++, cTempTable)
    oExec:SetString(nParam++, FWxFilial("SFT"))
    oExec:SetString(nParam++, "")
    oExec:SetString(nParam++, "")
    oExec:SetString(nParam++, "")

    cAlias := oExec:OpenAlias()

    if (cAlias)->(!eOf())
        nDivergent := (cAlias)->QTD_NCM_DIVERGENTES
    endif

    (cAlias)->(DbCloseArea())

    oExec:Destroy()
    FWFreeObj(oExec)
Return nDivergent

//------------------------------------------------------------------------------
/*{Protheus.doc} aiAdjustedNcmCount
    Metodo responsável por obter a quantidade de produtos ajustados pela IA

    @type Method
    @author Squad PIF
    @param cTempTable, Character, Alias da tabela temporária
    @return Json, retorna o objeto json contendo a quantidade de produtos ativos
/*/
//------------------------------------------------------------------------------
Method aiAdjustedNcmCount(cTempTable As Character) Class DashboardData
    Local oExec              As Object
    Local cQuery             As Character
    Local cAlias             As Character
    Local nParam             AS Numeric
    Local nAdjusted          AS Numeric
 
    nAdjusted := 0

	cQuery := " SELECT COUNT(DISTINCT PRODCODE) AS QTD_NCM_AJUSTADO "
	cQuery += " FROM ? TMP "
	cQuery += " INNER JOIN " + RetSqlName("I21") + " I21 "
	cQuery += " ON I21.R_E_C_N_O_ = TMP.RECNOI21
	cQuery += " WHERE "
	cQuery += " I21.I21_BRANCH = ? "
	cQuery += " AND I21.I21_STATUS = ? "
	cQuery += " AND TMP.D_E_L_E_T_ = ? "
	cQuery += " AND I21.D_E_L_E_T_ = ? "

    cQuery := ChangeQuery(cQuery)
    oExec  := FwExecStatement():New(cQuery)

    nParam := 1
    oExec:SetUnsafe(nParam++, cTempTable)
    oExec:SetString(nParam++, FWxFilial("SFT"))
    oExec:SetString(nParam++, "ACP")
    oExec:SetString(nParam++, "")
    oExec:SetString(nParam++, "")

    cAlias := oExec:OpenAlias()

    if (cAlias)->(!eOf())
        nAdjusted := (cAlias)->QTD_NCM_AJUSTADO
    endif

    (cAlias)->(DbCloseArea())

    oExec:Destroy()
    FWFreeObj(oExec)
Return nAdjusted
