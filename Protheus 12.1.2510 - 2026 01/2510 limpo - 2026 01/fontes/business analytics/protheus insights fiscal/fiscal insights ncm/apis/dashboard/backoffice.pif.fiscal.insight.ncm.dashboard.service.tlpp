#include "tlpp-core.th"
#include "tlpp-rest.th"

namespace totvs.protheus.backoffice.pif.fiscal.insight.ncm
using namespace totvs.protheus.backoffice.pif.util


//------------------------------------------------------------------------------
/* {Protheus.doc} DashboardService
    Classe de serviços do dashboard NCM

    @type Class
    @author Squad PIF
    @return Nil
/*/
//------------------------------------------------------------------------------
Class DashboardService 

    Public Method New() Constructor
    Public Method getDashboard() As Json
    
EndClass


//------------------------------------------------------------------------------
/* {Protheus.doc} new
    Metodo construtor

    @type Method
    @author Squad PIF
    @return Object, retorna o objeto criado
*/
//------------------------------------------------------------------------------
Method New() Class DashboardService
Return Self


//------------------------------------------------------------------------------
/* {Protheus.doc} getDashboard
    Responsável por chamar a consulta de dados do dashboard de NCM

    @type Method
    @author Squad PIF
    @param cTempTable, Character, Alias da tabela temporária
    @return Json, retorna o objeto json contendo os dados do dashboard de NCM
*/
//------------------------------------------------------------------------------
Method getDashboard(cTempTable As character) As Json Class DashboardService

    Local JResponse          As Json
    Local oDashboardData      As Object
    Local JDashboard         As Json

    JResponse := JsonObject():New()
    
    oDashboardData := DashboardData():New()

    JDashboard := oDashboardData:getDashboard(cTempTable)

    JResponse  := getSuccessReponse(JDashboard)

    FWFreeObj(oDashboardData)
    FreeObj(JDashboard)

Return JResponse
