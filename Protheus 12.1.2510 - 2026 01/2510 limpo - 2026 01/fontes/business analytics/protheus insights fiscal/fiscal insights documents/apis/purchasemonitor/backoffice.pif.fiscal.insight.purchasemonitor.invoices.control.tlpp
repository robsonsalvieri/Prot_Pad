#include "tlpp-core.th"
#include "tlpp-rest.th"

namespace totvs.protheus.backoffice.pif.fiscal.insight.purchasemonitor.invoices
using namespace totvs.protheus.backoffice.pif.util

//------------------------------------------------------------------------------
/* {Protheus.doc} PurchaseMonitorInvoicesController
    API utilizada para consultar as requisições da tela de importação de XML de compras

    @author Squad PIF
    @version 1.0
*/
//------------------------------------------------------------------------------

Class PurchaseMonitorInvoicesController

    Public Method new() Constructor
    
    @Get("/api/pif/purchasemonitor/invoices")
    Public Method getInvoicesList()

    @Get("/api/pif/purchasemonitor/invoices/items")
    Public Method getInvoicesItems()
    
endClass

//------------------------------------------------------------------------------
/* {Protheus.doc} new
    Metodo construtor

    @author Squad PIF
    @version 1.0
    @return Object, retorna o objeto criado
*/
Method New() Class PurchaseMonitorInvoicesController
Return Self

//------------------------------------------------------------------------------
/* {Protheus.doc} getInvoicesList
    Método que executa a chamada da API

    @type Method
    @author Squad PIF
    @return Nil
*/
//------------------------------------------------------------------------------
Method getInvoicesList() class PurchaseMonitorInvoicesController

	Local oService      As Object
	Local oJResponse    As Json
    Local nPage         As Numeric
	Local nPageSize     As Numeric
	Local cFilter       As Character

	nPage     := 1
	nPageSize := 10
	cFilter   := ""

	oJResponse := getNoAccessResponse()

    if canAccess("PIFA020")
        getPageAndPageSize(@nPage, @nPageSize)

        If (oRest:getQueryRequest():GetJsonText("$filter") != "null")
            cFilter := AllTrim(oRest:getQueryRequest():GetJsonText("$filter"))
        EndIf

        oService     := PurchaseMonitorInvoicesService():New()
        oJResponse   := oService:getInvoicesList(@nPage, @nPageSize, cFilter)
        
	EndIf

	answerRest(oJResponse)

	FWFreeObj(oService)
	FreeObj(oJResponse)

Return

//------------------------------------------------------------------------------
/*/ {Protheus.doc} getInvoicesItems
    Método que retorna os itens das notas fiscais de fornecedores
    processadas pelo TOTVS Transmite via importação xml, para exibição no Monitor de Compras.

    @type Method
    @author Squad PIF
    @return Nil
/*/  

Method getInvoicesItems() class PurchaseMonitorInvoicesController

    Local oService      As Object
    Local oJResponse    As Json
    Local nPage         As Numeric
    Local nPageSize     As Numeric
    Local cFilter       As Character

    nPage     := 1
    nPageSize := 10
    cFilter   := ""

    oJResponse := getNoAccessResponse()

    if canAccess("PIFA020")
        getPageAndPageSize(@nPage, @nPageSize)

        If (oRest:getQueryRequest():GetJsonText("$filter") != "null")
            cFilter := AllTrim(oRest:getQueryRequest():GetJsonText("$filter"))
        EndIf

        oService     := PurchaseMonitorInvoicesService():New()
        oJResponse   := oService:getInvoicesItems(@nPage, @nPageSize, cFilter)
    
    EndIf

    answerRest(oJResponse)

    FWFreeObj(oService)
    FreeObj(oJResponse) 

Return
