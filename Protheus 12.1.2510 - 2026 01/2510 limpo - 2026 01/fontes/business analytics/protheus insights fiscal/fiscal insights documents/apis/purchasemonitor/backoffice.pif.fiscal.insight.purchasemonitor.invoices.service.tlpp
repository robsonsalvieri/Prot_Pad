#include "tlpp-core.th"
#include "tlpp-rest.th"

namespace totvs.protheus.backoffice.pif.fiscal.insight.purchasemonitor.invoices
using namespace totvs.protheus.backoffice.pif.util

//------------------------------------------------------------------------------
/*/ {Protheus.doc} PurchaseMonitorInvoicesService
    Classe de services do PurchaseMonitorInvoices

    @author Squad PIF
    @version 1.0
/*/
//------------------------------------------------------------------------------    

Class PurchaseMonitorInvoicesService 

    Public Method New() Constructor
    Public Method getInvoicesList() As Json
    Public Method getInvoicesItems() As Json
    
EndClass

//------------------------------------------------------------------------------
/*/ {Protheus.doc} new
    Metodo construtor

    @author Squad PIF
    @version 1.0
    @return Object, retorna o objeto criado
/*/
//------------------------------------------------------------------------------

Method New() Class PurchaseMonitorInvoicesService  
Return Self

//------------------------------------------------------------------------------
/*/ {Protheus.doc} getInvoicesList
    Método que prepara e executa a consulta da lista das notas fiscais com base nos parâmetros recebidos.

    @author Squad PIF
    @version 1.0
    @param nPage, Numeric, Número da página a ser retornada
    @param nPageSize, Numeric, Tamanho da página a ser retornada
    @param cFilter, character, Texto a ser usado na busca.
    @return Json, retorna o objeto json contendo os dados recebidos
/*/
//------------------------------------------------------------------------------    

Method getInvoicesList(nPage as Numeric, nPageSize as Numeric, cFilter as Character)  As Json Class PurchaseMonitorInvoicesService  

    Local oInvoicesListData As Object
    Local oError            := ErrorClass():New()  As Object
    Local oJResponse        := JsonObject():New()  As Json
    Local ojInvoiceList     := JsonObject():New()  As Json
    Local oListError        As Object

    oInvoicesListData := PurchaseMonitorInvoicesData():New()

    //Chama o método que retorna a lista das notas fiscais
    oInvoicesListData:getInvoicesList(nPage, nPageSize, cFilter)    
    
    oError:genCode  := oInvoicesListData:getCode()
    oError:description := oInvoicesListData:getMessage()

    oJResponse  := getBadRequestResponse({oError}) 

    If oInvoicesListData:lOk      
        //Se retornou com sucesso, formata o response
        ojInvoiceList:FromJson(oInvoicesListData:GetJSONResponse())
        //Recebe o Json de resposta e verifica se houve erro no processamento das notas fiscais
        oListError := GetErrorInvoiceData(ojInvoiceList)
        oJResponse := getSuccessReponse(oListError)
    EndIf

    oInvoicesListData:DeActivate()
    FWFreeObj(oInvoicesListData)

Return oJResponse

//------------------------------------------------------------------------------
/*/ {Protheus.doc} GetErrorInvoiceData
    Método que verifica se houve erro no processamento das notas fiscais 
    (campo CKO_CODERR) e retorna o detalhe/solução para o erro apresentado.

    @author Squad PIF
    @version 1.0
    @param ojInvoiceList, json, Json com as notas fiscais
    @return ojInvoiceList, json, Json com as notas fiscais
/*/
//------------------------------------------------------------------------------

Static Function GetErrorInvoiceData(ojInvoiceList as Json)

    Local oCurrentInvoice   As Object
    Local nI                As Numeric
    Local cErrorCode        As Character 

    For nI := 1 To Len(ojInvoiceList["items"])
        
        oCurrentInvoice := ojInvoiceList["items"][nI]
        cErrorCode := oCurrentInvoice:GetJsonText("errorcode")
        cErrorCode := IIF(cErrorCode == "null","",cErrorCode)

        oCurrentInvoice["detailError"] := JsonObject():New()

        //Se não ocorreu erro, grava os campos como vazio
        If Empty(cErrorCode)
            oCurrentInvoice["detailError"]["descriptionError"] := " "
            oCurrentInvoice["detailError"]["solutionError"]    := " "
            oCurrentInvoice["detailError"]["errorCategory"]    := " "
        Else
            //Em caso de erro, chama o método GetErrorInfo para atribuir ao objeto 
            //json a descrição (descriptionError), solução (solutionError) e categoria do erro (errorCategory)
            oJErrorInfo := PurchaseMonitorInvoicesData():GetErrorInfo(cErrorCode)
            oCurrentInvoice["detailError"]   := oJErrorInfo
        EndIf
        
    Next nI

Return ojInvoiceList


//------------------------------------------------------------------------------
/*/ {Protheus.doc} getInvoicesItems
    Método que prepara e executa a consulta daos ítens das notas fiscais com base nos parâmetros recebidos.

    @author Squad PIF
    @version 1.0
    @param nPage, Numeric, Número da página a ser retornada
    @param nPageSize, Numeric, Tamanho da página a ser retornada
    @param cFilter, character, Texto a ser usado na busca.
    @return Json, retorna o objeto json contendo os dados recebidos
/*/
//------------------------------------------------------------------------------

Method getInvoicesItems(nPage as Numeric, nPageSize as Numeric, cFilter as Character)  As Json Class PurchaseMonitorInvoicesService  

    Local oInvoicesItemsData As Object
    Local oError            := ErrorClass():New()  As Object
    Local oJResponse        := JsonObject():New()  As Json

    oInvoicesItemsData := PurchaseMonitorInvoicesData():New()
    oInvoicesItemsData:getInvoicesItems(nPage, nPageSize, cFilter)    
    
    oError:genCode  := oInvoicesItemsData:getCode()
    oError:description := oInvoicesItemsData:getMessage()

    oJResponse  := getBadRequestResponse({oError}) 

    If oInvoicesItemsData:lOk
        //Se retornou com sucesso, formata o response
        oJResponse:FromJson(oInvoicesItemsData:GetJSONResponse())
        oJResponse := getSuccessReponse(oJResponse)
    EndIf

    oInvoicesItemsData:DeActivate()
    FWFreeObj(oInvoicesItemsData)

Return oJResponse
