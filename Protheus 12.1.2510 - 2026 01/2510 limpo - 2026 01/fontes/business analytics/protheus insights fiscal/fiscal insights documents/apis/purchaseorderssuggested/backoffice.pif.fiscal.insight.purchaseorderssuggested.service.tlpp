#include "tlpp-core.th"
#include "tlpp-rest.th"

namespace totvs.protheus.backoffice.pif.fiscal.insight.purchaseorderssuggested
using namespace totvs.protheus.backoffice.pif.util


//------------------------------------------------------------------------------
/*/ {Protheus.doc} PurchaseOrdersSuggestedService
    Classe de services do PurchaseOrdersSuggested

    @author Squad PIF
    @version 1.0
/*/
//------------------------------------------------------------------------------    
Class PurchaseOrdersSuggestedService 

    Public Method new() Constructor
    Public Method getPurchaseOrdersSuggested() As Json
    Public Method getPurchaseOrdersManually() As Json
    Public Method getPurchaseOrdersLinked() As Json

EndClass

//------------------------------------------------------------------------------
/*/ {Protheus.doc} new
    Metodo construtor

    @author Squad PIF
    @version 1.0
    @return Object, retorna o objeto criado
/*/
//------------------------------------------------------------------------------
Method new() Class PurchaseOrdersSuggestedService  
Return Self

//------------------------------------------------------------------------------
/*/ {Protheus.doc} getPurchaseOrdersSuggested
    Método que prepara e executa a consulta da lista dos pedidos de compra 
    sugeridos para o documento fiscal

    @author Squad PIF
    @version 1.0
    @param cDocument, Character, numero do documento fiscal
    @param cSerial, Character, serie do documento fiscal
    @param cSupplier, Character, fornecedor do documento fiscal
    @param cStore, Character, loja do documento fiscal
    @param cProduct, Character, produto do documento fiscal
    @param lItems, Logical, indica se a pesquisa retornará os dados por item do pedido
    @return Json, retorna o objeto json contendo os dados recebidos
/*/
//------------------------------------------------------------------------------    
Method getPurchaseOrdersSuggested(cDocument As Character, cSerial As Character, cSupplier as Character, cStore as Character, cProduct as Character, lItems as Logical)  As Json Class PurchaseOrdersSuggestedService  
    Local oPurchaseData   := PurchaseOrdersSuggestedData():New() As Object
    Local JResponse       := JsonObject():New()                  As Json
    
    Default lItems := .F.

    JResponse := oPurchaseData:getPurchaseOrdersSuggested(cDocument, cSerial, cSupplier, cStore, cProduct, lItems)    
    JResponse := getSuccessReponse(JResponse)

    FWFreeObj(oPurchaseData)

Return JResponse
//------------------------------------------------------------------------------
/*/ {Protheus.doc} getPurchaseOrdersManually
    Método que prepara e executa a consulta da lista dos pedidos de compra em Aberto

    @author Squad PIF
    @version 1.0
    @param nPage, numeric, numero da pagina
	@param nPageSize, numeric, Quantidade de registros por pagina
    @param cFilter, Character, filtro
    @param lItems, Logical, infica retornará os itens do pedido
    @return Json, retorna o objeto json contendo os dados recebidos
/*/
//------------------------------------------------------------------------------    
Method getPurchaseOrdersManually(nPage As Numeric, nPageSize As Numeric, cFilter As Character, lItems as Logical)  As Json Class PurchaseOrdersSuggestedService  
    Local oPurchaseData   := PurchaseOrdersSuggestedData():New() As Object
    Local JResponse       := JsonObject():New()                  As Json
    Local oError          := ErrorClass():New()                  As Object
    Local cResponse       := ""                                  As Character

    Default lItems := .F.

    JResponse := oPurchaseData:getPurchaseOrdersManually(nPage, nPageSize, cFilter, lItems)    

    oError:genCode     := oPurchaseData:getCode()
    oError:description := oPurchaseData:getMessage()

    JResponse := getBadRequestResponse({oError})
    
    If oPurchaseData:lOk
        cResponse := oPurchaseData:GetJSONResponse()
        JResponse := JsonObject():New()
        JResponse:FromJson(cResponse)
        JResponse := getSuccessReponse(JResponse)
    EndIf

    oPurchaseData:DeActivate()
    FWFreeObj(oPurchaseData)
    
Return JResponse

//------------------------------------------------------------------------------
/*/ {Protheus.doc} getPurchaseOrdersLinked
    Método que prepara e executa a consulta da lista dos pedidos de compra ja vinculados ao documento

    @author Squad PIF
    @version 1.0
    @param nPage, numeric, numero da pagina
	@param nPageSize, numeric, Quantidade de registros por pagina
    @param cFilter, Character, filtro
    @param lItems, Logical, infica retornará os itens do pedido
    @return Json, retorna o objeto json contendo os dados recebidos
/*/
//------------------------------------------------------------------------------    
Method getPurchaseOrdersLinked(nPage As Numeric, nPageSize As Numeric, cFilter As Character, lItems as Logical)  As Json Class PurchaseOrdersSuggestedService  
    Local oPurchaseData   := PurchaseOrdersSuggestedData():New() As Object
    Local JResponse       := JsonObject():New()                  As Json
    Local oError          := ErrorClass():New()                  As Object
    Local cResponse       := ""                                  As Character

    Default lItems := .F.

    JResponse := oPurchaseData:getPurchaseOrdersLinked(nPage, nPageSize, cFilter, lItems)    

    oError:genCode     := oPurchaseData:getCode()
    oError:description := oPurchaseData:getMessage()

    JResponse := getBadRequestResponse({oError})
    
    If oPurchaseData:lOk
        cResponse := oPurchaseData:GetJSONResponse()
        JResponse := JsonObject():New()
        JResponse:FromJson(cResponse)
        JResponse := getSuccessReponse(JResponse)
    EndIf

    oPurchaseData:DeActivate()
    FWFreeObj(oPurchaseData)
    
Return JResponse
