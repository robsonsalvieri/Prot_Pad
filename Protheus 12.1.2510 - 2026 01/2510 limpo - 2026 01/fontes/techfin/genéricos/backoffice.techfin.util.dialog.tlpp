#include 'tlpp-core.th'
#Include "FwMVCDef.ch"

NAMESPACE totvs.protheus.backoffice.techfin.util

/*/{Protheus.doc} TechfinDialog
    Classe responsavel pelas mensagens que serão exibidas nas rotinas
    da TECHFIN
    @author Vitor Duca
    @since 02/09/2025
    @version 1.0
/*/
Class TechfinDialog From FWDialogModal
    Private Data aText          as Array
    Private Data aButtons       as Array  
    Private Data lScrollArea    as Logical
    Private Data lDisableCancel as Logical  

    Public Method new() as Object
    Public Method setText(nRow as Numeric, nColumn as Numeric, cText as Character)
    Public Method setButton()
    Public Method setScrollArea()
    Public Method setDisableCancel()
    Public Method openConfirm() as Logical
    Public Method openInfo()
    Private Method writeText()
EndClass

/*/{Protheus.doc} new
    Construtor da classe
    @author Vitor Duca
    @since 02/09/2025
    @version 1.0
    @return self, Object, Referencia do objeto da classe
/*/
Method new() as Object class TechfinDialog
    _Super:new()
    ::aText := {}
    ::aButtons := {}
    ::lScrollArea := .F.
    ::lDisableCancel := .F.
Return self

/*/{Protheus.doc} setText
    Configuração dos textos que serão exibidos na tela atraves do componente TSay
    @author Vitor Duca
    @since 02/09/2025
    @version 1.0
    @param nRow, Numeric, Coordenada da linha em pixel
    @param nColumn, Numeric, Coordenada da coluna em pixel
    @param cText, Character, Texto que será apresentado
/*/
Method setText(nRow as Numeric, nColumn as Numeric, cText as Character, nHeight as numeric) class TechfinDialog
    DEFAULT nHeight := 20

    Aadd(::aText, {"row": nRow, "column": nColumn, "text": cText, "height": nHeight})
Return

/*/{Protheus.doc} setButton
    Adiciona botões nas telas da dialog
    @author Vitor Duca
    @since 03/09/2025
    @version 1.0
    @param cLabel, Character, Titulo do botão
    @param bAction, CodeBlock, Bloco de codigo que será executado no clique da ação
/*/
Method setButton(cLabel as character, bAction as codeBlock) class TechfinDialog
    Aadd(::aButtons, {, cLabel, bAction, cLabel, 0, .T., .F.})
Return

/*/{Protheus.doc} setScrollArea
    Define se deve criar a area com Scroll, pode ser utilizada quando não sabemos
    o tamanho total da mensagem (Mensagens dinamicas)
    @author Vitor Duca
    @since 29/09/2025
    @version 1.0
    @param lScrollArea, Logical, Define se criar a area com Scroll
/*/
Method setScrollArea(lScrollArea as Logical) class TechfinDialog
    ::lScrollArea := lScrollArea
Return

/*/{Protheus.doc} setDisableCancel
    Define se deve desabilitar a apresentação do botão Cancelar
    @author Fabio
    @since 21/11/2025
    @version 1.0
    @param setDisableCancel, Logical, Define se desabilita botão
/*/

Method setDisableCancel(lDisableCancel as Logical) class TechfinDialog
    ::lDisableCancel := lDisableCancel
Return
/*/{Protheus.doc} openConfirm
    Abertura da tela de confirmação para o usuario
    @author Vitor Duca
    @since 02/09/2025
    @version 1.0
    @param nWidth, Numeric, Define a largura da dialog
    @param nHeigth, Numeric, Define a altura da dialog
    @return lConfirm, Logical, Define se a tela foi confirmada ou cancelada 
/*/
Method openConfirm(nWidth as numeric, nHeigth as numeric, lDefaultButtons As Logical ) as Logical class TechfinDialog
    Local lConfirm := .F.   as Logical

    DEFAULT nWidth := 180
    DEFAULT nHeigth := 250
    DEFAULT lDefaultButtons := .T.

    _Super:setSize(nWidth, nHeigth)
    _Super:SetEscClose(.F.)
    _Super:SetCloseButton(.F.)
    _Super:createDialog()
    ::writeText()

    If len(::aButtons) > 0 
        _Super:addButtons(::aButtons)
    EndIf    
   
    If lDefaultButtons
        _Super:addOkButton({|| lConfirm := .T., _Super:DeActivate()}, "Confirmar")
        If !(::lDisableCancel)
            _Super:addCloseButton({|| _Super:DeActivate()}, "Cancelar")
        EndIf
    EndIf

    _Super:Activate()
Return lConfirm

/*/{Protheus.doc} openInfo
    Abertura da tela de informações para o usuario
    @author Vitor Duca
    @since 02/09/2025
    @version 1.0
    @param nWidth, Numeric, Define a largura da dialog
    @param nHeigth, Numeric, Define a altura da dialog
/*/
Method openInfo(nWidth as numeric, nHeigth as numeric) class TechfinDialog
    
    DEFAULT nWidth := 180
    DEFAULT nHeigth := 250

    _Super:setSize(nWidth, nHeigth)
    _Super:SetEscClose(.T.)
    _Super:SetCloseButton(.T.)
    _Super:createDialog()
    ::writeText()

    If len(::aButtons) > 0 
        _Super:addButtons(::aButtons)
    Endif

    _Super:Activate()
Return

/*/{Protheus.doc} writeText
    Escreve os textos na dialog de acordo com as configurações
    pré-estabelecidas
    @author Vitor Duca
    @since 03/09/2025
    @version 1.0
/*/
Method writeText() class TechfinDialog
    local nText := 0    as numeric
    local oPanel        as object
    local oSay          as object

    oPanel := TPanel():New(,,, _Super:getPanelMain())

    If ::lScrollArea
        oPanel := TScrollArea():New(_Super:getPanelMain())
    Endif

	oPanel:Align := CONTROL_ALIGN_ALLCLIENT

    For nText := 1 to Len(::aText)
       oSay := TSay():New(::aText[nText]["row"], ::aText[nText]["column"], {|| ""}, oPanel,,,,,, .T.,,, (oPanel:nClientWidth / 2) - 30, ::aText[nText]["height"],,,,,, .T.)
        oSay:SetText( ::aText[nText]["text"] )
    Next nText

Return
