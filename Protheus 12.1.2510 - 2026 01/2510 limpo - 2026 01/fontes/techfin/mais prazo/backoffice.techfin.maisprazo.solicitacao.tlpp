#include "tlpp-core.th"
#Include "FwMVCDef.ch"
#include "backoffice.techfin.maisprazo.solicitacao.ch"

NAMESPACE totvs.protheus.backoffice.techfin.maisprazo.solicitacao
USING NAMESPACE totvs.protheus.backoffice.techfin.util

#DEFINE PAGAR_AGORA "1"
#DEFINE PAGAR_NO_VENCIMENTO "2"

// Variáveis estáticas
Static __oPayables              as object
Static __oPayablesNE            as object
Static __oTableBillsSelected    as object
Static __oTableBillsMaisPrazo   as object
Static __jColumnsBrowse         as json
Static __aFields := {"E2_FILIAL", "E2_PREFIXO", "E2_NUM", "E2_PARCELA", "E2_TIPO", "E2_FORNECE", "E2_LOJA", "E2_NOMFOR", "E2_VALOR", "E2_SALDO", "E2_EMISSAO", "E2_VENCREA", "E2_HIST", "E2_CODBAR"}  as array

/*/{Protheus.doc} requestExtension
    Tela principal do MaisPrazo para seleção, simulação e envio de prorrogação de boletos.
    Pontos importantes:
    - Carregamento dos títulos elegíveis (SE2)
    - Cards de status e limites
    - Simulação dos valores
    - Envio da solicitação
    @type       Function
    @author     Vitor Duca
    @since      04/09/2025
    @version    1.0
/*/
function requestExtension()
    local nLin := 0                             as numeric
    Local nSelected := 0                        as numeric
    Local nTotalValue := 0                      as numeric
    local aCoors := FWGetDialogSize(oMainWnd)   as array
    local aCpFilter := {}                       as array
    local cAlias := ""                          as character
    local cAliasNE := ""                        as character
    local cMark := ""                           as character
    local cCNPJBranch := ""                     as character
    local cFilBkp := cFilAnt                    as character
    local oDialog                               as object
    local oFont18                               as object
    Local oMarkBrowse := FWMarkBrowse():New()   as object
    Local oBrowse := FWMBrowse():New()          as object
    Local oPanelGrid                            as object
    Local oTFolder                              as object
    Local oPanelTotal                           as object
    Local oPanelLimTot                          as object
    Local oPanelLimUsed                         as object
    Local oPanelInProcess                       as object
    Local oPanelLimAvail                        as object
    Local oSayLimAvail                          as object
    Local oSaySel                               as object
    Local oSayTotal                             as object
    Local oSayLimTotal                          as object
    Local oSayLimUsed                           as object
    Local oSayInProcess                         as object
    Local oLayer                                as object
    Local jParamsBranch := JsonObject():new()   as json

    Private bUpdSel := {|| updateSelected(@oSaySel, @nSelected)}            as CodeBlock
    Private bUpdTotal := {|| updateTotalValue(@oSayTotal, @nTotalValue)}    as CodeBlock

    AAdd(aCpFilter, {"E2_PREFIXO", "Prefixo", "C", TamSX3("E2_PREFIXO")[1], TamSX3("E2_PREFIXO")[2], X3PICTURE("E2_PREFIXO")})
    AAdd(aCpFilter, {"E2_NUM", "Número", "C", TamSX3("E2_NUM")[1], TamSX3("E2_NUM")[2], X3PICTURE("E2_NUM")})
    AAdd(aCpFilter, {"E2_FORNECE", "Fornecedor", "C", TamSX3("E2_FORNECE")[1], TamSX3("E2_FORNECE")[2], X3PICTURE("E2_FORNECE")})
    AAdd(aCpFilter, {"E2_LOJA", "Loja", "C", TamSX3("E2_LOJA")[1], TamSX3("E2_LOJA")[2], X3PICTURE("E2_LOJA")})
    AAdd(aCpFilter, {"E2_VENCREA", "Vencimento", "D", TamSX3("E2_VENCREA")[1], TamSX3("E2_VENCREA")[2], X3PICTURE("E2_VENCREA")})

    If Pergunte("TFIN002", .T.)
        cFilAnt := MV_PAR01
        cCNPJBranch := FWSM0Util():GetSM0Data( cEmpAnt , cFilAnt, {"M0_CGC"})[1][2]

        FWMsgRun(, {|| loadPayables(cCNPJBranch)}, "", STR0002)

        oDialog   := TDialog():New(aCoors[1], aCoors[2], aCoors[3], aCoors[4], STR0003,,,,,,,, oMainWnd, .T.,,,,,,.T.) //"Prorrogar boletos"

        oLayer := FWLayer():new()
        oLayer:Init(oDialog, .F.)

        oLayer:AddLine("CARDS", 18, .F.)
        oLayer:addCollumn("CARD1", 20, .T., "CARDS")
        oLayer:addCollumn("CARD2", 20, .T., "CARDS")
        oLayer:addCollumn("CARD3", 20, .T., "CARDS")
        oLayer:addCollumn("CARD4", 20, .T., "CARDS")
        oLayer:addCollumn("CARD5", 20, .T., "CARDS")

        oLayer:AddWindow("CARD1", "Win1", STR0005, 100, .F., .T., , "CARDS")
        oLayer:AddWindow("CARD2", "Win1", STR0006, 100, .F., .T., , "CARDS")
        oLayer:AddWindow("CARD3", "Win1", STR0007, 100, .F., .T., , "CARDS")
        oLayer:AddWindow("CARD4", "Win1", STR0008, 100, .F., .T., , "CARDS")
        oLayer:AddWindow("CARD5", "Win1", STR0009, 100, .F., .T., , "CARDS")

        oPanelTotal   := oLayer:GetWinPanel("CARD1", "Win1", "CARDS")
        oPanelLimTot  := oLayer:GetWinPanel("CARD2", "Win1", "CARDS")
        oPanelLimUsed := oLayer:GetWinPanel("CARD3", "Win1", "CARDS")
        oPanelInProcess := oLayer:GetWinPanel("CARD4", "Win1", "CARDS")
        oPanelLimAvail := oLayer:GetWinPanel("CARD5", "Win1", "CARDS")

        nLin := oPanelTotal:nHeight / 6
        oFont18 := TFont():New(,,-18,,,)

        ARA->(DbSetOrder(1))
        If ARA->(DbSeek(FwXFilial("ARA") + cCNPJBranch + "2"))
            oSayLimTotal:= TSay():New(nLin, 5, {|| "R$ " + Transform(ARA->ARA_LTOTAL, PesqPict("ARA", "ARA_LTOTAL"))}, oPanelLimTot, , oFont18, .F., .F., .F., .T., , , 100, 020)
            oSayLimUsed := TSay():New(nLin, 5, {|| "R$ " + Transform(ARA->ARA_LUTIL, PesqPict("ARA", "ARA_LUTIL"))}, oPanelLimUsed, , oFont18, .F., .F., .F., .T., , , 100, 020)
            oSayLimAvail := TSay():New(nLin, 5, {|| "R$ " + Transform(ARA->ARA_LDISP, PesqPict("ARA", "ARA_LDISP"))}, oPanelLimAvail, , oFont18, .F., .F., .F., .T., , , 100, 020)
            oSayInProcess := TSay():New(nLin, 5, {|| "R$ " + Transform(ARA->ARA_LRPREA, PesqPict("ARA", "ARA_LRPREA"))}, oPanelInProcess, , oFont18, .F., .F., .F., .T., , , 100, 020)
            jParamsBranch:FromJson(ARA->ARA_PARAMS)
        Endif

        oSayTotal   := TSay():New(nLin, 5, {|| "R$ 0,00"}, oPanelTotal, , oFont18, .F., .F., .F., .T., , , 100, 020)
        
        oLayer:AddLine("TOTALSEL", 7, .F.)
        oLayer:addCollumn("COLUNA", 20, .T., "TOTALSEL")
        TSay():New(1,5,{|| STR0004 },oLayer:getColPanel('COLUNA','TOTALSEL'),,TFont():New(,,-12,,,),,,,.T.)
        oSaySel := TSay():New(1, 65,{|| "0" },oLayer:getColPanel('COLUNA','TOTALSEL'),,TFont():New(,,-12,,,),,,,.T.)

        oLayer:AddLine("TABLES", 65, .F.)
        oLayer:addCollumn("COLUNA", 100, .F., "TABLES")
        oPanelGrid := oLayer:getColPanel('COLUNA', "TABLES")

        If __jColumnsBrowse == NIL
            __jColumnsBrowse := createColumnsBrowse(__aFields, "SE2")
        Endif

        oTFolder := TFolder():New( 0, 0, {STR0010, STR0011}, {STR0010, STR0011}, oPanelGrid,,,,,, 1, 1 )
        oTFolder:Align := CONTROL_ALIGN_ALLCLIENT
        oTFolder:SetOption( 1 )

        cAlias := __oPayables:GetAlias()
        cMark := oMarkBrowse:Mark()
        oMarkBrowse:SetFieldMark("MARK")
        oMarkBrowse:SetOwner(oTFolder:aDialogs[1])
        oMarkBrowse:SetAlias(cAlias)
        oMarkBrowse:SetMainProc("requestExtension")
        oMarkBrowse:bMark    := {|| loadValues()}
        oMarkBrowse:bAllMark := {|| }
        oMarkBrowse:SetDescription("")
        oMarkBrowse:SetColumns(AClone(__jColumnsBrowse["columns"]))
        oMarkBrowse:SetMenuDef("")
        oMarkBrowse:SetMark("X", cAlias, "MARK")
        oMarkBrowse:SetTemporary(.T.)
        oMarkBrowse:SetUseFilter(.T.)
        oMarkBrowse:SetFieldFilter(aCpFilter)
        oMarkBrowse:AddButton("Parâmetros", {|| reloadTables(oMarkBrowse, oBrowse) },,,, .F., 2 )
        oMarkBrowse:DisableReport()
        oMarkBrowse:DisableConfig()
        oMarkBrowse:Activate()

        cAliasNE := __oPayablesNE:getAlias()
        oBrowse:SetOwner(oTFolder:aDialogs[2])
        oBrowse:SetAlias(cAliasNE)
        oBrowse:SetMainProc("requestExtension")
        oBrowse:SetDescription("")
        oBrowse:SetFields(AClone(__jColumnsBrowse["fields"]))
        oBrowse:SetMenuDef("")
        oBrowse:SetTemporary(.T.)
        oBrowse:SetUseFilter(.T.)
        oBrowse:SetFieldFilter(aCpFilter)
        oBrowse:AddButton("Parâmetros", {|| reloadTables(oMarkBrowse, oBrowse) },,,, .F., 2)
        oBrowse:DisableReport()
        oBrowse:DisableConfig()
        oBrowse:DisableDetails()
        oBrowse:bLDblClick := {|| viewReason(cAliasNE)}
        oBrowse:Activate()

        oDialog:Activate(,,,.T.,,,{|| loadValues(), EnchoiceBar(oDialog, {|| submitRequest(oDialog, jParamsBranch, nSelected, nTotalValue) }, {|| oDialog:End()}) } )
    EndIf

    If __oPayables <> NIL
        __oPayables:Delete()
        __oPayables := Nil
    EndIf

    If __oPayablesNE <> NIL
        __oPayablesNE:Delete()
        __oPayablesNE := Nil
    EndIf

    cFilAnt := cFilBkp
    
Return

/*/{Protheus.doc} viewReason
    Visualiza o motivo da não elegibilidade do titulo
    @type  Static Function
    @author Vitor Duca
    @since 26/09/2025
    @version 1.0
    @param cAlias, Character, Alias da tabela que esta amarrada a browse
/*/
static Function viewReason(cAlias as character)
    local cDescription := (cAlias)->ARBDESC as character
    local oModal := TechfinDialog():new()   as object

    oModal:setTitle(STR0066) //"Detalhes de Título negado"
    oModal:setScrollArea(.T.)
    oModal:setText(10, 10, STR0067) //"Essa consulta apresenta a situação atual do titulo, podendo ser alterada a qualquer momento devido as condições de limite disponíveis ou regras de elegibilidade"
    oModal:setText(30, 10, STR0068 + (cAlias)->E2_NUM + "     ! "+ STR0069) //"Situação do Título " # "Título não elegível"
    oModal:setText(50, 10, cDescription, 50)
    oModal:setButton(STR0070, {|| oModal:DeActivate() }) //"Ok, entendi"
    oModal:openInfo(150, 250)

Return

/*/{Protheus.doc} reloadTables
    Recarrega as tabelas dos titulos elegiveis e não elegiveis
    @type  Function
    @author Vitor Duca
    @since 04/09/2025
    @version 1.0
    @param oMarkBrowse, Object, Objeto visual que contem a FwMarkBrowse
    @param oBrowse, Object, Objeto visual que contem a FwBrowse
/*/
Function reloadTables(oMarkBrowse as object, oBrowse as object)
    local cCNPJBranch := "" as character
    If Pergunte('TFIN002', .T.)
        cFilAnt := MV_PAR01
        cCNPJBranch := FWSM0Util():GetSM0Data( cEmpAnt , cFilAnt, {"M0_CGC"})[1][2]
        FWMsgRun(, {|| loadPayables(cCNPJBranch), loadValues(), oMarkBrowse:Refresh(.T.), oBrowse:Refresh(.T.)}, '', STR0002)
    Endif
Return

/*/{Protheus.doc} loadPayables
    Realiza o carregamento das tabelas temporarias que serão utilizadas
    na montagem da browse (Titulos elegiveis e Titulos não elegiveis)
    @type  Static Function
    @author Vitor Duca
    @since 04/09/2025
    @version 1.0
    @param cCNPJBranch, Character, CNPJ da filial que serão considerada na montagem da tabela temporaria
/*/
function loadPayables(cCNPJBranch as character)
    local cArqTrab      := ""                   as character
    local cArqTrabNE    := ""                   as character
    local cArqReclock   := ""                   as character
    local nX            := 0                    as numeric
    local aCampos       := {}                   as array
    local aTypes        := {}                   as array
    Local oExecQuery                            as Object
    local cAliasQuery   := ""                   as character
    local nBindParam    := 1                    as numeric
    local aAreaSE2      := SE2->(FwGetArea())   as array
    local aAreaSA2      := SA2->(FwGetArea())   as array
    local cQuery        := ""                   as character
    local aRules        := {}                   as array
    local nLenFieldsSE2 := 0                    as numeric
    local aFieldsTable  := {}                   as array
    local aIndex        := {}                   as array
    local aFieldsSE2    := {}                   as array
    local cReasonNE     := ""                   as character

    DEFAULT cCNPJBranch := ""

    aTypes := StrTokArr2(MVABATIM+"|"+MV_CRNEG+"|"+MVPROVIS+"|"+MVPAGANT+"|"+MV_CPNEG+"|","|")

    //Adiciona campos que fazem parte da SE2 mas não irão aparecer na browse
    aFieldsSE2 := aClone(__aFields)
    Aadd(aFieldsSE2, "E2_FILORIG")
    Aadd(aFieldsSE2, "E2_LINDIG")
    nLenFieldsSE2    := Len(aFieldsSE2)

    //Campos que fazem parte da temporaria podendo ser SE2 ou não
    aFieldsTable  := AClone(aFieldsSE2)
    Aadd(aFieldsTable, "FK7_IDDOC")
    Aadd(aFieldsTable, "A2_CGC")
    Aadd(aFieldsTable, "A2_NOME")

    AAdd(aCampos, {"MARK", "C", 1, 0})
    AAdd(aCampos, {"ARBDESC", "M", 10, 0})
    For nX := 1 to Len(aFieldsTable)
        AAdd(aCampos, {aFieldsTable[nX], FWSX3Util():GetFieldType(aFieldsTable[nX]), TamSX3(aFieldsTable[nX])[1], TamSX3(aFieldsTable[nX])[2]})
    Next nX

    Aadd(aIndex, {"E2_FILIAL","E2_FORNECE","E2_LOJA"})
    Aadd(aIndex, {"E2_FILIAL","E2_VENCREA"})
    Aadd(aIndex, {"E2_FILIAL","E2_EMISSAO"})
    Aadd(aIndex, {"E2_FILIAL","E2_PREFIXO","E2_NUM"})
    Aadd(aIndex, {"MARK"})

    createTemporaryTable(@__oPayables, aCampos, aIndex)

    cArqTrab := __oPayables:getAlias()

    aIndex := {}
    Aadd(aIndex, {"E2_FILIAL","E2_FORNECE","E2_LOJA"})
    Aadd(aIndex, {"E2_FILIAL","E2_VENCREA"})
    Aadd(aIndex, {"E2_FILIAL","E2_EMISSAO"})
    Aadd(aIndex, {"E2_FILIAL","E2_PREFIXO","E2_NUM"})

    createTemporaryTable(@__oPayablesNE, aCampos, aIndex)

    cArqTrabNE := __oPayablesNE:getAlias()

    cQuery := " SELECT SE2.R_E_C_N_O_ RECNOSE2, SA2.R_E_C_N_O_ RECNOSA2, FK7.FK7_IDDOC, SA2.A2_CGC, SA2.A2_NOME "
    cQuery += " FROM " + RetSqlName("SE2") + " SE2 "
    cQuery += " INNER JOIN " + RetSqlName("FK7") + " FK7 "
    cQuery += " ON "
    cQuery += " FK7.FK7_ALIAS = ? "
    cQuery += " AND FK7.FK7_FILTIT = SE2.E2_FILIAL "
    cQuery += " AND FK7.FK7_PREFIX = SE2.E2_PREFIXO "
    cQuery += " AND FK7.FK7_NUM = SE2.E2_NUM "
    cQuery += " AND FK7.FK7_PARCEL = SE2.E2_PARCELA "
    cQuery += " AND FK7.FK7_TIPO = SE2.E2_TIPO "
    cQuery += " AND FK7.FK7_CLIFOR = SE2.E2_FORNECE "
    cQuery += " AND FK7.FK7_LOJA = SE2.E2_LOJA "
    cQuery += " AND FK7.D_E_L_E_T_ = ? "
    cQuery += " INNER JOIN " + RetSqlName("SA2") + " SA2 "
    cQuery += " ON "
    cQuery += " SA2.A2_FILIAL = ? "
    cQuery += " AND SA2.A2_COD = SE2.E2_FORNECE "
    cQuery += " AND SA2.A2_LOJA = SE2.E2_LOJA "
    cQuery += " AND SA2.D_E_L_E_T_ = ? "
    cQuery += " LEFT JOIN " + RetSqlName("ARH") + " ARH "
    cQuery += " ON "
    cQuery += " ARH.ARH_IDDOC = FK7.FK7_IDDOC "
    cQuery += " AND ARH.ARH_STATUS <> ? "
    cQuery += " AND ARH.D_E_L_E_T_ = ? "
    cQuery += " WHERE "
    cQuery += " SE2.E2_FILORIG = ? "
    cQuery += " AND SE2.E2_NUM >= ? "
    cQuery += " AND SE2.E2_NUM <= ? "
    cQuery += " AND SE2.E2_FORNECE >= ? "
    cQuery += " AND SE2.E2_FORNECE <= ? "
    cQuery += " AND SE2.E2_VENCREA >= ? "
    cQuery += " AND SE2.E2_VENCREA <= ? "
    cQuery += " AND SE2.E2_SALDO > ? "
    cQuery += " AND SE2.E2_TIPO NOT IN (?) "
    cQuery += " AND SE2.E2_CODBAR <> ? "
    cQuery += " AND SE2.E2_LINDIG <> ? "
    cQuery += " AND SE2.E2_ORIGEM <> ? "
    cQuery += " AND ARH.ARH_IDDOC IS NULL "
    cQuery += " AND SE2.D_E_L_E_T_= ? "

    oExecQuery := FwExecStatement():New(cQuery)
    oExecQuery:SetString(nBindParam++, "SE2") //FK7.FK7_ALIAS
    oExecQuery:SetString(nBindParam++, " ") //FK7.D_E_L_E_T_

    oExecQuery:SetString(nBindParam++, FwxFilial("SA2")) //SA2.A2_FILIAL
    oExecQuery:SetString(nBindParam++, " ") //SA2.D_E_L_E_T_

    oExecQuery:SetString(nBindParam++, "2") //ARH.ARH_STATUS
    oExecQuery:SetString(nBindParam++, " ") //ARH.D_E_L_E_T_

    oExecQuery:SetString(nBindParam++, cFilAnt) //SE2.E2_FILORIG
    oExecQuery:SetString(nBindParam++, MV_PAR02) //SE2.E2_NUM
    oExecQuery:SetString(nBindParam++, MV_PAR03) //SE2.E2_NUM
    oExecQuery:SetString(nBindParam++, MV_PAR04) //SE2.E2_FORNECE
    oExecQuery:SetString(nBindParam++, MV_PAR05) //SE2.E2_FORNECE
    oExecQuery:SetDate(nBindParam++, MV_PAR06) //SE2.E2_VENCREA
    oExecQuery:SetDate(nBindParam++, MV_PAR07) //SE2.E2_VENCREA
    oExecQuery:SetNumeric(nBindParam++, 0) //SE2.E2_SALDO
    oExecQuery:SetIn(nBindParam++, aTypes) //SE2.E2_TIPO
    oExecQuery:SetString(nBindParam++, Space(TamSx3("E2_CODBAR")[1])) //SE2.E2_CODBAR
    oExecQuery:SetString(nBindParam++, Space(TamSx3("E2_LINDIG")[1])) //SE2.E2_LINDIG
    oExecQuery:SetString(nBindParam++, "FINA137F") //SE2.E2_ORIGEM
    oExecQuery:SetString(nBindParam++, " ") //SE2.D_E_L_E_T_

    cAliasQuery := oExecQuery:OpenAlias()
    
    aRules := loadEligibilityRules("2", cCNPJBranch)

    While (cAliasQuery)->(!Eof())
        SE2->(dbGoTo((cAliasQuery)->RECNOSE2))
        SA2->(dbGoTo((cAliasQuery)->RECNOSA2))

        cReasonNE := execEligibilityRules(aRules)

        cArqReclock := cArqTrab

        //-- Não Elegíveis para Prorrogação
        If !Empty(cReasonNE)
            cArqReclock := cArqTrabNE
        Endif

        RecLock(cArqReclock, .T.)
            (cArqReclock)->MARK := " "
            For nX:=1 to nLenFieldsSE2
                (cArqReclock)->&(aFieldsSE2[nX]) := SE2->&(aFieldsSE2[nX])

                If aFieldsSE2[nX] == "E2_NOMFOR"
                    (cArqReclock)->&(aFieldsSE2[nX]) := GetLGPDValue("SE2", aFieldsSE2[nX])
                Endif
            Next nX

            (cArqReclock)->FK7_IDDOC := (cAliasQuery)->FK7_IDDOC
            (cArqReclock)->A2_CGC := (cAliasQuery)->A2_CGC
            (cArqReclock)->A2_NOME := (cAliasQuery)->A2_NOME
            (cArqReclock)->ARBDESC := cReasonNE

        (cArqReclock)->(msUnLock())

        (cAliasQuery)->(dbSkip())
    EndDo

    (cAliasQuery)->(dbCloseArea())
    
    (cArqTrab)->(DbSetOrder(MV_PAR08))
    (cArqTrab)->(DbGoTop())

    (cArqTrabNE)->(DbSetOrder(MV_PAR08))
    (cArqTrabNE)->(DbGoTop())

    FwRestArea(aAreaSA2)
    FwRestArea(aAreaSE2)
Return

/*/{Protheus.doc} updateSelected
    Realiza a atualização dos registros marcados
    @type  Static Function
    @author Vitor Duca
    @since 05/09/2025
    @version 1.0
    @param oSaySel, Object, Objeto visual que contem o TSay que será atualizado
    @param nSelected, Numeric, Variavel passada por referencia que irá armazenar a quantidade de titulos marcados
/*/
static function updateSelected(oSaySel as Object, nSelected as numeric)
    If __oPayables <> NIL .and. oSaySel <> nil
        nSelected := MpSysExecScalar("SELECT COUNT(MARK) SELECAO FROM " + __oPayables:getRealName() + " WHERE MARK = ? ", "SELECAO", {"X"})

        oSaySel:SetText( cValToChar(nSelected) )
        oSaySel:CtrlRefresh()
    Endif    
return

/*/{Protheus.doc} updateTotalValue
    Realiza a atualização do valor total registros marcados
    @type  Static Function
    @author Vitor Duca
    @since 05/09/2025
    @version 1.0
    @param oSayTotal, Object, Objeto visual que contem o TSay que será atualizado
    @param nTotalValue, Numeric, Variavel passada por referencia que irá armazenar o valor dos titulos marcados
/*/
static function updateTotalValue(oSayTotal as object, nTotalValue as numeric)
    If __oPayables <> NIL .and. oSayTotal <> NIL
        nTotalValue := MpSysExecScalar("SELECT SUM(E2_SALDO) SALDO FROM " + __oPayables:getRealName() + " WHERE MARK = ? ", "SALDO", {"X"})

        oSayTotal:SetText("R$ " + Transform(nTotalValue, PesqPict("SE2", "E2_SALDO")))
        oSayTotal:CtrlRefresh()
    Endif
return

/*/{Protheus.doc} loadValues
    Realiza a atualização de todos os valores que serão demonstrados ao usuario
    atraves dos cards
    @type  Static Function
    @author Vitor Duca
    @since 05/09/2025
    @version 1.0
/*/
static function loadValues()
    Eval(bUpdSel)
    Eval(bUpdTotal)
return

/*/{Protheus.doc} submitRequest
    Wizard de integração dos titulos a pagar com o TOTVS Mais Prazo
    @type Function
    @author Vitor Duca
    @since 12/09/2025
    @version 1.0
    @param oDialog, Object, Objeto da janela principal da rotina
    @param jParamsBranch, Json, Parametros configurados na filial ARA
    @param nSelected, Numeric, Quantidade de titulos selecionados
    @param nTotalValue, Numeric, Valor total dos titulos selecionados
/*/
Function submitRequest(oDialog as object, jParamsBranch as json, nSelected as numeric, nTotalValue as numeric) as logical
    Local oWizard                       as object
    Local oFirstStep                    as object
    Local oSecondStep                   as object
    Local oThirdStep                    as object
    Local oFourthStep                   as object
    Local cSelectedDueDate := ""        as character
    Local cSelectedParcels := ""        as character
    Local dDueDate := CTOD("//")        as date
    Local nDays := 0                    as numeric
    Local cResponse := ""               as character
    Local lSucess := .F.                as logical

    Private nBillsSelected := nSelected                     as numeric
    Private nBillsTotalValue := nTotalValue                 as numeric
    Private jResponseSimulation := JsonObject():new()       as json
    Private jInstallmentsSimulation := JsonObject():new()   as json
    Private oSaySelectedParcels                             as object   
    Private oSayFirstDueDate                                as object
    Private oSayFees                                        as object
    Private oSayCET                                         as object
    Private oSayFeesValue                                   as object
    Private oSayIOFValue                                    as object
    Private oSayValueTotal                                  as object

    if nBillsSelected == 0
        Help( ,,"NOMARK",, STR0074, 1, 0 ) //"Para realizar a solicitação de prorrogação é necessario que tenha ao menos um titulo marcado!"
        return
    Endif

    FWMsgRun(, {|| cResponse := sendSimulate() }, "", STR0012) //"Consultando simulações de prorrogação"

    If !Empty(cResponse)

        oWizard:= FWWizardControl():New(, {550, 800})
        oWizard:ActiveUISteps()

        // "Fornecedor"
        oFirstStep := oWizard:AddStep("1")
        oFirstStep:SetStepDescription(STR0013) //"Fornecedor"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
        oFirstStep:SetConstruction({|oPanel|createFirstStep(oPanel, @cSelectedDueDate)})
        oFirstStep:SetNextAction({|| validFirstStep(cSelectedDueDate, cResponse) })
        oFirstStep:SetCancelAction({|| .T. })
        
        // "Mais Prazo"
        oSecondStep := oWizard:AddStep("2")
        oSecondStep:SetStepDescription(STR0014) //"Mais Prazo"
        oSecondStep:SetConstruction({|oPanel|createSecondStep(oPanel, cSelectedDueDate, @dDueDate, @nDays)})
        oSecondStep:SetNextAction({|| validSecondStep(cSelectedDueDate, dDueDate, nDays) })
        oSecondStep:SetPrevAction({|| .F. })
        oSecondStep:SetCancelAction({|| .T. })
        
        // "Parcelamento"
        oThirdStep := oWizard:AddStep("3")
        oThirdStep:SetStepDescription(STR0015) //"Parcelamento"
        oThirdStep:SetConstruction({|oPanel|createThirdStep(oPanel, dDueDate, nDays, @cSelectedParcels)})
        oThirdStep:SetNextAction({|| updateFourthStep(cSelectedParcels, dDueDate, nDays)})
        oThirdStep:SetPrevAction({|| .F. })
        oThirdStep:SetCancelAction({|| .T. })

        // "Resumo"
        oFourthStep := oWizard:AddStep("4")
        oFourthStep:SetStepDescription(STR0016) //"Resumo"
        oFourthStep:SetConstruction({|oPanel|createFourthStep(oPanel, cSelectedDueDate, dDueDate, cSelectedParcels, nDays)})
        oFourthStep:SetNextTitle(STR0017) //"Solicitar prorrogação"
        oFourthStep:SetNextAction({|| FwMsgRun(, {|| lSucess := confirmSolicitation(cSelectedDueDate, nBillsSelected, jInstallmentsSimulation)}, "", STR0071), lSucess }) //"Gravando solicitação de prorrogação dos titulos"
        oFourthStep:SetPrevAction({|| .T. })
        oFourthStep:SetCancelAction({|| confirmCancelWizard() })

        oWizard:Activate()
        oWizard:Destroy()
    Endif

    If __oTableBillsSelected <> NIL
        __oTableBillsSelected:Delete()
        __oTableBillsSelected := Nil
    EndIf

    If __oTableBillsMaisPrazo <> NIL
        __oTableBillsMaisPrazo:Delete()
        __oTableBillsMaisPrazo := Nil
    EndIf

    If lSucess .and. oDialog <> NIL
        FWAlertSuccess(STR0072, STR0073) //"Após aprovação a solicitação seguirá para analise de credito. Atenção: aprovações após as 17h serão processadas no próximo dia útil."#"Solicitação enviada"
        oDialog:End()
    Endif
Return

/*/{Protheus.doc} confirmCancelWizard
    Realiza a abertura da tela de cancelamento da solicitação para o
    Mais Prazo
    @type  Function
    @author Vitor Duca
    @since 17/09/2025
    @version 1.0
/*/
Function confirmCancelWizard() as logical
    local lCloseWizard := .T.   as logical
    local oModal                as object

    oModal := totvs.protheus.backoffice.techfin.util.TechfinDialog():new()
    oModal:setTitle(STR0018) //"Deseja realmente cancelar a solicitação?"
    oModal:setText(10, 10, STR0019) //"Ao cancelar, todas as informações feitas até aqui serão perdidas"
    oModal:setButton(STR0020, {|| lCloseWizard := .F., oModal:DeActivate() }) //"Continuar"
    oModal:setButton(STR0021, {|| lCloseWizard := .T., oModal:DeActivate() }) //"Cancelar solicitação"
    oModal:openConfirm(100, 180, .F.)
Return lCloseWizard

/*/{Protheus.doc} sendSimulate
    Realiza o envio da mensagem de simulação da prorrogação e aguarda a resposta
    utilizando o mecanismos awaitSmartLink
    @type  Function
    @author Vitor Duca
    @since 16/09/2025
    @version version
    @return cResponse, Character, Resposta do smartlink (Mensagem que recebimento MaisPrazoCalculationSimulateResponseV1)
/*/
Function sendSimulate() as character
    Local cResponse := ""                                               as character
    Local cQueue := "MaisPrazoCalculationSimulateRequestV1"             as character
    Local cResponseQueue := "MaisPrazoCalculationSimulateResponseV1"    as character
    Local jData := JsonObject():new()                                   as json
    Local jBilling                                                      as json
    Local cAliasTemp := ""                                              as character
    Local cQuery := ""                                                  as character
    Local nValueTotal := 0                                              as numeric

    If __oPayables <> NIL
        jData["document"] := FWSM0Util():GetSM0Data( cEmpAnt , cFilAnt, {"M0_CGC"})[1][2] //CNPJ
        jData["paymentSlips"] := {} //Boletos

        cQuery := "SELECT FK7_IDDOC, A2_CGC, A2_NOME, E2_VENCREA, E2_SALDO, E2_CODBAR, E2_LINDIG "
        cQuery += "FROM " + __oPayables:getRealName() + " "
        cQuery += "WHERE MARK = ? "

        cAliasTemp := MPSysOpenQuery(cQuery,,,,{"X"})

        While (cAliasTemp)->(!Eof())
            jBilling := JsonObject():new()

            nValueTotal += (cAliasTemp)->E2_SALDO

            jBilling["paymentSlipId"] := (cAliasTemp)->FK7_IDDOC //idBoleto
            jBilling["companyDocumentNumber"] := AllTrim((cAliasTemp)->A2_CGC) // cnpjFornecedor
            jBilling["companyName"] := AllTrim((cAliasTemp)->A2_NOME) //razaoSocialFornecedor
            jBilling["paymentSlipDueDate"] := SubSTR(FWTimeStamp(5, Stod((cAliasTemp)->E2_VENCREA)), 1, 10) //dataVencimento
            jBilling["amount"] := (cAliasTemp)->E2_SALDO //valor
            jBilling["barcode"] := AllTrim((cAliasTemp)->E2_CODBAR) //barcode
            jBilling["digitableLine"] := AllTrim((cAliasTemp)->E2_LINDIG) //linhaDigitavel

            Aadd(jData["paymentSlips"], jBilling)

            (cAliasTemp)->(dbSkip())
        EndDo

        jData["totalPaymentSlipsAmount"] := nValueTotal //valorTotalBoletos

        (cAliasTemp)->(DbCloseArea())

        cResponse := awaitSmartLink("2", "Simulate", cQueue, cResponseQueue, jData:ToJson())

        If !Empty(totvs.protheus.backoffice.techfin.util.handleMessageError(cResponse))
            cResponse := ""
        Endif
    Endif

Return cResponse

/*/{Protheus.doc} panelTotal
    Cria o painel de totalizadores do Mais Prazo
    @type  Static Function
    @author Vitor Duca
    @since 12/09/2025
    @version 1.0
    @param oLayer, Object, Objeto de construção da interface usando o FwLayer
/*/
Static Function panelTotal(oLayer as object)
    Local oFont15 := TFont():New(,,-15,,,)  as object

    oLayer:AddLine("TOTAIS", 10, .F.)
    oLayer:addCollumn("SELECIONADOS", 50, .T., "TOTAIS")
    oLayer:addCollumn("VALORES", 50, .T., "TOTAIS")

    TSay():New(5, 5, {|| STR0022 + "<b>" + cValToChar(nBillsSelected) + "</b>" }, oLayer:getColPanel('SELECIONADOS','TOTAIS'), , oFont15, .F., .F., .F., .T., , , 100, 20,,,,,,.T.) //"Títulos selecionados: "
    TSay():New(5, 5, {|| STR0023 + "<b>R$ " + AllTrim(Transform(nBillsTotalValue, PesqPict("SE2", "E2_SALDO")))  + "</b>" }, oLayer:getColPanel('VALORES','TOTAIS'), , oFont15, .F., .F., .F., .T., , , 200, 20,,,,,,.T.) //"Soma dos titulos: "

Return

/*/{Protheus.doc} createFirstStep
    Realiza a criação do primeiro step do wizard
    @type  Static Function
    @author Vitor Duca
    @since 12/09/2025
    @version 1.0
    @param oPanel, Object, Painel disponivel para criação do step
    @param cSelectedDueDate, Character, Tipo de prorrogação selecionada, sendo PAGAR AGORA ou PAGAR NO VENCIMENTO
/*/
Static Function createFirstStep(oPanel as object, cSelectedDueDate as character)
    Local oLayer := FWLayer():new() as object
    Local aComboBox := {}           as array
    Local oPanelBody                as object
    
    Aadd(aComboBox, "1=" + STR0024) //Pagar agora"
    Aadd(aComboBox, "2=" + STR0025) //"Pagar no(s) vencimento(s)"

    oLayer:Init(oPanel, .F.)

    panelTotal(oLayer)

    oLayer:AddLine("PAINEL", 90, .F.)
    oLayer:addCollumn("CORPO", 100, .T., "PAINEL")
    oPanelBody := oLayer:getColPanel('CORPO','PAINEL')

    TSay():New(15, 5, {|| STR0026 }, oPanelBody, , TFont():New(,,-20,,,), .F., .F., .F., .T., , , 250, 20,,,,,,.T.) //"Quando devemos pagar seu(s) fornecedore(s)?"
    TComboBox():New(35, 5, {|value|if(PCount() > 0, cSelectedDueDate := value, cSelectedDueDate)}, aComboBox, 200, 70, oPanelBody,,,,,,.T.,TFont():New(,,-15,,.F.,),,,,,,,,'cSelectedDueDate')
    
Return

/*/{Protheus.doc} validFirstStep
    Validação e confirmação do primeiro passo do wizard
    @type  Function
    @author Vitor Duca
    @since 24/11/2025
    @version 1.0
    @param cSelectedDueDate, Character, Condição de pagamento aos fornecedores selecionada (Pagar Agora, Pagar no vencimento)
    @param cResponse, Character, Resposta da simulação
/*/
Function validFirstStep(cSelectedDueDate as character, cResponse as character) as logical
    local cPropertySimulation := "paymentScheduling"    as character
    local cResponseSimulation := ""                     as character
    local jResponse := JsonObject():new()               as json

    If Empty(jResponse:FromJson(cResponse)) .and. jResponse:hasProperty("data")
        If cSelectedDueDate == PAGAR_AGORA
            cPropertySimulation := "dueDateExtension"
        Endif

        If jResponse["data"]:hasProperty(cPropertySimulation)
            cResponseSimulation := jResponse["data"][cPropertySimulation]:ToJson()
        Endif

        If Type("jResponseSimulation") == "J"
            jResponseSimulation:FromJson(cResponseSimulation)
        Endif
    Endif

Return .T.

/*/{Protheus.doc} createSecondStep
    Realiza a criação do segundo step do wizard
    @type  Static Function
    @author Vitor Duca
    @since 12/09/2025
    @version 1.0
    @param oPanel, Object, Painel disponivel para criação do step
    @param cSelectedDueDate, Character, Tipo de prorrogação selecionada, sendo PAGAR AGORA ou PAGAR NO VENCIMENTO
    @param dDueDate, Date, Vencimento escolhido para prorrogação
    @param nDays, Numeric, Numero de dias escolhido para prorrogação
    @param jParameters, json, JSON contendo os parametros de financiamento da filial ARA_PARAMS
/*/
Static Function createSecondStep(oPanel as object, cSelectedDueDate as character, dDueDate as date, nDays as numeric, jParameters as json)
    Local oLayer := FWLayer():new() as object
    Local oPanelBody                as object
    Local oGetDay                   as object
    Local oGetDate                  as object
    Local lCheckDays := .T.         as logical
    Local lCheckDate := .F.         as logical
    Local cHelpDates := ""          as character
    Local dMinDate := CTOD("//")    as date
    Local dMaxDate := CTOD("//")    as date

    oLayer:Init(oPanel, .F.)

    panelTotal(oLayer)

    oLayer:AddLine("PAINEL", 90, .F.)
    oLayer:addCollumn("CORPO", 100, .T., "PAINEL")
    oPanelBody := oLayer:getColPanel('CORPO','PAINEL')

    TSay():New(15, 5, {|| STR0027 }, oPanelBody,, TFont():New(,,-20,,,), .F., .F., .F., .T., , , 300, 20,,,,,,.T.) //"Quando voce quer começar a pagar o Mais Prazo?"

    If Type("jResponseSimulation") == "J" .and. jResponseSimulation:hasProperty("processingData")
        dMinDate := Stod(StrTran(jResponseSimulation["processingData"][1]["requestedNewDueDate"], "-", ""))
        dMaxDate := Stod(StrTran(jResponseSimulation["processingData"][Len(jResponseSimulation["processingData"])]["requestedNewDueDate"], "-", ""))
        cHelpDates := STR0028 + Dtoc(dMinDate) + STR0029 + Dtoc(dMaxDate) //"O novo vencimento deve ser entre " # " e "
    Endif

    If cSelectedDueDate == PAGAR_AGORA
        oGetDate := TGet():New(35, 5,{|value| If(PCount()>0,dDueDate:=value,dDueDate) },oPanelBody,180,10,"@D",{||Empty(dDueDate) .Or. (dDueDate >= dMinDate .and. dMaxDate >= dDueDate)},,,TFont():New(,,-15,,.F.,),,,.T.,,,,,,,.F.,.F.,,,,,,.T.)
        TSay():New(50, 5, {|| cHelpDates }, oPanelBody,, TFont():New(,,-12,,.F.,,,,,,.T.), .F., .F., .F., .T., , , 250, 20,,,,,,.T.)
        oGetDate:SetContentAlign(-1)
	Else
        TCheckBox():New(45, 5, STR0030, {|| lCheckDays }, oPanelBody, 250, 20, Nil, {|| lCheckDate:=!lCheckDate, lCheckDays:=!lCheckDays, oGetDay:CtrlRefresh(), dDueDate := CTOD('//'), oGetDate:CtrlRefresh() }, TFont():New(,,-15,,,), Nil, Nil, ,.T.) //"Quero começar a pagar após X dias"
        oGetDay := TGet():New(55, 5,{|value| If(PCount()>0,nDays:=value,nDays) },oPanelBody,180,5,"@R 99",{||nDays >= 0 .And. 45 >= nDays},,,TFont():New(,,-15,,.F.,),,,.T.,,,{||lCheckDays},,,,.F.,.F.,,,,,,.T.)
        TSay():New(65, 5, {|| STR0031 }, oPanelBody,, TFont():New(,,-12,,.F.,,,,,,.T.), .F., .F., .F., .T., , , 250, 20,,,,,,.T.) //"Até 45 dias do vencimento"

        TCheckBox():New(85, 5, STR0032, {|| lCheckDate }, oPanelBody, 250, 20, Nil, {|| lCheckDate:=!lCheckDate, lCheckDays:=!lCheckDays, nDays := 0, oGetDay:CtrlRefresh(), oGetDate:CtrlRefresh() }, TFont():New(,,-15,,,), Nil, Nil, ,.T.) //"Quero escolher uma data específica"
        oGetDate := TGet():New(95, 5,{|value| If(PCount()>0,dDueDate:=value,dDueDate) },oPanelBody,180,10,"@D",{||Empty(dDueDate) .Or. (dDueDate >= dMinDate .and. dMaxDate >= dDueDate .And. DataValida(dDueDate))},,,TFont():New(,,-15,,.F.,),,,.T.,,,{||lCheckDate},,,,.F.,.F.,,,,,,.T.)
        TSay():New(110, 5, {|| cHelpDates }, oPanelBody,, TFont():New(,,-12,,.F.,,,,,,.T.), .F., .F., .F., .T., , , 250, 20,,,,,,.T.)
        oGetDate:SetContentAlign(-1)       
    Endif
Return

/*/{Protheus.doc} validSecondStep
    Validação do segundo passo no wizard
    @type  Function
    @author Vitor Duca
    @since 17/09/2025
    @version 1.0
    @param cSelectedDueDate, Character, Tipo de prorrogação selecionada, sendo PAGAR AGORA ou PAGAR NO VENCIMENTO
    @param dDueDate, Date, Vencimento escolhido para prorrogação
    @param nDays, Numeric, Numero de dias escolhido para prorrogação
    @return Logical, Retorna se deve continuar para o proximo passo
/*/
Static Function validSecondStep(cSelectedDueDate as character, dDueDate as date, nDays as numeric) as logical

Local lReturn := .F. As Logical

    If cSelectedDueDate == PAGAR_AGORA
        lReturn := !Empty(dDueDate)
    Endif

    If cSelectedDueDate == PAGAR_NO_VENCIMENTO
        lReturn := ((Empty(dDueDate) .and. !Empty(nDays)) .or. !Empty(dDueDate) .and. Empty(nDays))
    Endif

Return lReturn

/*/{Protheus.doc} createThirdStep
    Realiza a criação do terceiro step do wizard
    @type  Static Function
    @author Vitor Duca
    @since 12/09/2025
    @version 1.0
    @param oPanel, Object, Painel disponivel para criação do step
    @param dDueDate, Date, Data de vencimento escolhida
    @param nDays, Numeric, Numero de dias escolhidos apos vencimento
    @param cSelectedParcels, Character, Opção de parcelamento escolhida
/*/
Static Function createThirdStep(oPanel as object, dDueDate as date, nDays as numeric, cSelectedParcels as character)
    Local oLayer := FWLayer():new()     as object
    Local aComboBox := {}               as array
    Local oPanelBody                    as object
    Local nDiffDays := 0                as numeric
    Local cHelp := ""                   as character
    Local nInstallmentsOfUpTo100 := 0   as numeric

    If !Empty(dDueDate)
        nDiffDays := DateDiffDay(Date(), dDueDate)
    Endif

    If !Empty(nDays)
        nDiffDays := nDays
    Endif

    Aadd(aComboBox, "1=" + STR0033) //"Parcela"
    Aadd(aComboBox, "2=" + STR0034) //"Parcelas"
    Aadd(aComboBox, "3=" + STR0034) //"Parcelas"

    cHelp := STR0035 //"As parcelas terão intervalo de 30 dias entre elas"

    If nDiffDays > 30
        aComboBox := {}
        Aadd(aComboBox, "1=" + STR0033) //"Parcela"
        cHelp := STR0036 //"Parcelamento disponível para prorrogação até 30 dias"
    Endif

    nInstallmentsOfUpTo100 := NoRound(nBillsTotalValue / 100, 0)

    If nInstallmentsOfUpTo100 < 3
        aComboBox := {}
        Aadd(aComboBox, "1=" + STR0033) //"Parcela"
        Aadd(aComboBox, "2=" + STR0034) //"Parcelas"
        If nInstallmentsOfUpTo100 < 2
            aComboBox := {}
            Aadd(aComboBox, "1=" + STR0033)
        Endif
    Endif
    oLayer:Init(oPanel, .F.)

    panelTotal(oLayer)

    oLayer:AddLine("PAINEL", 90, .F.)
    oLayer:addCollumn("CORPO", 100, .T., "PAINEL")
    oPanelBody := oLayer:getColPanel('CORPO','PAINEL')

    TSay():New(15, 5, {|| STR0037 }, oPanelBody, , TFont():New(,,-20,,,), .F., .F., .F., .T., , , 400, 20,,,,,,.T.) //"Escolha a quantidade de parcelas para seus boletos com o Mais Prazo"
    TComboBox():New(35, 5, {|value|if(PCount() > 0, cSelectedParcels := value, cSelectedParcels)}, aComboBox, 200, 70, oPanelBody,,,,,,.T.,TFont():New(,,-15,,.F.,),,,,,,,,'cSelectedParcels')
    TSay():New(50, 5, {|| cHelp }, oPanelBody,, TFont():New(,,-12,,.F.,,,,,,.T.), .F., .F., .F., .T., , , 250, 20,,,,,,.T.)

Return

/*/{Protheus.doc} createFourthStep
    Realiza a criação do quarto step do wizard
    @type  Static Function
    @author Vitor Duca
    @since 16/09/2025
    @version 1.0
    @param oPanel, Object, Painel disponivel para criação do step
    @param cSelectedDueDate, Character, Define se foi escolhido Pagar agora ou pagar no vencimento
    @param dDueDate, Date, Data de vencimento escolhida
    @param cSelectedParcels, Character, Opção de parcelamento escolhida
    @param nDays, Numeric, Quantidade de dias escolhido após o vencimento
/*/
Static Function createFourthStep(oPanel as object, cSelectedDueDate as character, dDueDate as date, cSelectedParcels as character, nDays as numeric)
    Local oLayer := FWLayer():new()             as object
    Local oPanelLabel                           as object
    Local oPanelValue                           as object
    Local oFont15 := TFont():New(,,-15,,,)      as object
    Local oFont13 := TFont():New(,,-13,,.F.)    as object
    Local oButtonBills                          as object
    Local nColumn := 145                        as numeric

    oLayer:Init(oPanel, .F.)

    oLayer:AddLine("TITULO", 10, .F.)
    oLayer:addCollumn("RESUMO", 50, .T., "TITULO")
    oLayer:addCollumn("ANALISE", 50, .T., "TITULO")

    TSay():New(5, 5, {|| STR0038 }, oLayer:getColPanel('RESUMO','TITULO'), , TFont():New(,,-18,,,), .F., .F., .F., .T., , , 200, 20,,,,,,.T.) //"Resultado da simulação"
    TSay():New(5, nColumn, {|| STR0039 }, oLayer:getColPanel('ANALISE','TITULO'), , TFont():New(,,-12,,.F.,,,,,,.T.), .F., .F., .F., .T., , , 100, 20,,,,,,.T.) //"Sujeito a análise"

    oLayer:AddLine("PAINEL", 90, .F.)
    oLayer:addCollumn("LABEL", 50, .T., "PAINEL")
    oLayer:addCollumn("VALUES", 50, .T., "PAINEL")

    oPanelLabel := oLayer:getColPanel('LABEL','PAINEL')
    oPanelValue := oLayer:getColPanel('VALUES','PAINEL')

    If cSelectedDueDate == PAGAR_NO_VENCIMENTO
        nColumn := 120
    Endif

    TSay():New(5, 5, {|| STR0040 }, oPanelLabel, , oFont15, .F., .F., .F., .T., , , 200, 20,,,,,,.T.) //"Pagamento aos fornecedores"
    TSay():New(15, 5, {|| STR0041 }, oPanelLabel, , oFont13, .F., .F., .F., .T., , , 200, 20,,,,,,.T.) //"Quantidade de títulos prorrogados:"
    TSay():New(15, nColumn, {|| cValToChar(nBillsSelected) }, oPanelValue, , oFont13, .F., .F., .F., .T., , , 100, 20,,,,,,.T.)
    TSay():New(25, 5, {|| STR0042 }, oPanelLabel, , oFont13, .F., .F., .F., .T., , , 200, 20,,,,,,.T.) //"Valor total dos títulos selecionados:"
    TSay():New(25, nColumn, {|| "R$ " + AllTrim(Transform(nBillsTotalValue, PesqPict("SE2", "E2_SALDO"))) }, oPanelValue, , oFont13, .F., .F., .F., .T., , , 100, 20,,,,,,.T.)
    TSay():New(35, 5, {|| STR0043 }, oPanelLabel, , oFont13, .F., .F., .F., .T., , , 200, 20,,,,,,.T.) //"Quando devemos fazer o pagamento:"
    TSay():New(35, nColumn, {|| Iif(cSelectedDueDate == PAGAR_AGORA, STR0024, STR0025) }, oPanelValue, , oFont13, .F., .F., .F., .T., , , 100, 20,,,,,,.T.) //Pagar agora # Pagar no vencimento

    TSay():New(55, 5, {|| STR0044 }, oPanelLabel, , oFont15, .F., .F., .F., .T., , , 200, 20,,,,,,.T.) //"Seus boletos com o Mais Prazo"
    TSay():New(65, 5, {|| STR0045 }, oPanelLabel, , oFont13, .F., .F., .F., .T., , , 200, 20,,,,,,.T.) //"Quantidade de parcelas por título:"
    oSaySelectedParcels := TSay():New(65, nColumn, {||}, oPanelValue, , oFont13, .F., .F., .F., .T., , , 100, 20,,,,,,.T.)
    TSay():New(75, 5, {|| STR0046 }, oPanelLabel, , oFont13, .F., .F., .F., .T., , , 200, 20,,,,,,.T.) //"Vencimento da 1º parcela"
    oSayFirstDueDate :=  TSay():New(75, nColumn, {||}, oPanelValue, , oFont13, .F., .F., .F., .T., , , 100, 20,,,,,,.T.)
    TSay():New(85, 5, {|| STR0047 }, oPanelLabel, , oFont13, .F., .F., .F., .T., , , 200, 20,,,,,,.T.) //"Taxa de juros (a.m.):"
    oSayFees := TSay():New(85, nColumn, {||}, oPanelValue, , oFont13, .F., .F., .F., .T., , , 100, 20,,,,,,.T.)
    TSay():New(95, 5, {|| STR0048 }, oPanelLabel, , oFont13, .F., .F., .F., .T., , , 200, 20,,,,,,.T.) //"CET (a.m.):"
    oSayCET := TSay():New(95, nColumn, {||}, oPanelValue, , oFont13, .F., .F., .F., .T., , , 100, 20,,,,,,.T.)
    TSay():New(105, 5, {|| STR0049 }, oPanelLabel, , oFont13, .F., .F., .F., .T., , , 200, 20,,,,,,.T.) //"Juros:"
    oSayFeesValue := TSay():New(105, nColumn, {||}, oPanelValue, , oFont13, .F., .F., .F., .T., , , 100, 20,,,,,,.T.)
    TSay():New(115, 5, {|| STR0050 }, oPanelLabel, , oFont13, .F., .F., .F., .T., , , 200, 20,,,,,,.T.) //"IOF:"
    oSayIOFValue := TSay():New(115, nColumn, {||}, oPanelValue, , oFont13, .F., .F., .F., .T., , , 100, 20,,,,,,.T.)
    TSay():New(125, 5, {|| STR0051 }, oPanelLabel, , oFont13, .F., .F., .F., .T., , , 200, 20,,,,,,.T.) //"Valor total da operação:"
    oSayValueTotal := TSay():New(125, nColumn, {||}, oPanelValue, , oFont13, .F., .F., .F., .T., , , 100, 20,,,,,,.T.)

    updateFourthStep(cSelectedParcels, dDueDate, nDays)

    oButtonBills := TButton():New( 145, 5, STR0052 + " >", oPanelLabel, {||openDialogBills(dDueDate, nDays)}, 100,10,,oFont13,.F.,.T.,.F.,,.F.,,,.F. ) //"Consultar títulos da operação"
    oButtonBills:setCss("QPushButton{border: none}")

Return

/*/{Protheus.doc} updateFourthStep
    Realiza a atualização dos valores da simulação que serão demonstrado no 
    Passo 4 - Resumo da simulação
    @type  Function
    @author Vitor Duca
    @since 19/09/2025
    @version 1.0
    @param cSelectedParcels, character, Quantidade de parcelas selecionadas
    @param dDueDate, Date, Data de vencimento, quando informado data especifica
    @param nDays, Numeric, Numero de dias para prorrogação (Pagar no vencimento)
/*/
Static Function updateFourthStep(cSelectedParcels as character, dDueDate as Date, nDays as numeric) as logical
    local dNewDueDate := DataValida(DaySum(Date(), nDays), .T.)  as date
    local cTimeStampDueDate := ""               as character
    local nX := 0                               as numeric
    local nY := 0                               as numeric
    local cFirstDueDate := ""                   as character
    local nTotalEffectiveCostRate := 0          as numeric
    local nInterestRate := 0                    as numeric
    local nValueFees := 0                       as numeric
    local nTotalAmountRequested := 0            as numeric
    local nIofAmount := 0                       as numeric
    local jDataSimulation := JsonObject():new() as json
    local lExistFourthStep := oSayFees <> NIL   as logical

    If lExistFourthStep

        If !Empty(dDueDate)
            dNewDueDate := dDueDate
        Endif
        
        cTimeStampDueDate := SubSTR(FWTimeStamp(5, dNewDueDate), 1, 10)

        If Type("jResponseSimulation") == "J" .and. jResponseSimulation:hasProperty("processingData")

            jDataSimulation:FromJson(jResponseSimulation:ToJson())

            For nX := 1 to Len(jDataSimulation["processingData"])
                If jDataSimulation["processingData"][nX]["requestedNewDueDate"] == cTimeStampDueDate
                    For nY := 1 to Len(jDataSimulation["processingData"][nX]["simulations"])
                        If jDataSimulation["processingData"][nX]["simulations"][nY]["installmentCount"] == Val(cSelectedParcels)

                            jInstallmentsSimulation["simulations"] := jDataSimulation["processingData"][nX]["simulations"][nY]
                            jInstallmentsSimulation["installments"] := jDataSimulation["processingData"][nX]["simulations"][nY]["installments"]

                            cFirstDueDate := jDataSimulation["processingData"][nX]["simulations"][nY]["installments"][1]["installmentDueDate"]
                            cFirstDueDate := Dtoc(Stod(StrTran(cFirstDueDate, "-", "")))

                            nTotalEffectiveCostRate := jDataSimulation["processingData"][nX]["simulations"][nY]["monthlyTotalEffectiveCostRate"]
                            nInterestRate := jDataSimulation["processingData"][nX]["simulations"][nY]["monthlyInterestRate"]
                            nValueFees := jDataSimulation["processingData"][nX]["simulations"][nY]["interestAmount"]
                            nTotalAmountRequested := jDataSimulation["processingData"][nX]["simulations"][nY]["totalAmountRequested"]
                            nIofAmount := jDataSimulation["processingData"][nX]["simulations"][nY]["iofAmount"]
                            Exit
                        Endif
                    next nY
                Endif
            next nX
            If oSaySelectedParcels <> NIL
                oSaySelectedParcels:SetText(cSelectedParcels) //"Quantidade de parcelas:"
                oSaySelectedParcels:CtrlRefresh()
            Endif
            If oSayFirstDueDate <> NIL
                oSayFirstDueDate:SetText(cFirstDueDate) //"Vencimento da 1º parcela"
                oSayFirstDueDate:CtrlRefresh()
            Endif
            If oSayFees <> NIL
                oSayFees:SetText(AllTrim(Transform(nInterestRate, "@E 999.99"))+"%") //"Taxa de juros (a.m.):"
                oSayFees:CtrlRefresh()
            Endif
            If oSayCET <> NIL
                oSayCET:SetText(AllTrim(Transform(nTotalEffectiveCostRate, "@E 999.99"))+"%") //"CET (a.m.):"
                oSayCET:CtrlRefresh()
            Endif
            If oSayFeesValue <> NIL
                oSayFeesValue:SetText("R$ " + AllTrim(Transform(nValueFees, PesqPict("SE2", "E2_SALDO")))) //"Juros:"
                oSayFeesValue:CtrlRefresh()
            Endif
            If oSayIOFValue <> NIL
                oSayIOFValue:SetText("R$ " + AllTrim(Transform(nIofAmount, PesqPict("SE2", "E2_SALDO")))) //"IOF:"
                oSayIOFValue:CtrlRefresh()
            Endif
            If oSayValueTotal <> NIL
                oSayValueTotal:SetText("R$ " + AllTrim(Transform(nTotalAmountRequested, PesqPict("SE2", "E2_SALDO")))) //"Valor total da operação:"
                oSayValueTotal:CtrlRefresh()
            Endif
        Endif
    Endif
Return .T.

/*/{Protheus.doc} openDialogBills
    Abre o modal que irá exibir os titulos que serão prorrogados 
    e as novas parcelas
    @type  Function
    @author Vitor Duca
    @since 22/09/2025
    @version 1.0
    @param dDueDate, Date, Data especifica de vencimento para a primeira parcela do boleto com o Mais Prazo
    @param nDays, Numeric, Numero de dias escolhidos a partir do vencimento
/*/
Function openDialogBills(dDueDate as date, nDays as numeric)
    Local oDialog                                       as object
    Local oLayer                                        as object
    Local oBrowse                                       as object
    Local oBrowseMaisPrazo                              as object
    Local oFontTitleTable1 := TFont():New(,,-20,.T.)    as object
    Local lSpecificDate := !Empty(dDueDate)             as logical
    Local aFieldsSelBills := {}                         as array
    Local aFieldsMpzBills := {}                         as array
    Local cTitleTable1 := STR0053                       as character //"Títulos que serão pagos ao(s) fornecedor(es)"
    Local nPercentTable1 := 55                          as numeric
    
    createTemporaryDialogBills(lSpecificDate, nDays)

    Aadd(aFieldsSelBills, {STR0054, "E2_NUM", "C", TamSx3("E2_NUM")[1], 0}) //"Título (Fornecedor)"
    Aadd(aFieldsSelBills, {STR0056, "E2_VENCREA", "D", 8, 0}) //"Venc. original"
    Aadd(aFieldsSelBills, {STR0055, "E2_SALDO", "N", TamSx3("E2_SALDO")[1], TamSx3("E2_SALDO")[2], X3Picture("E2_SALDO")}) //"Valor total"

    If __oTableBillsSelected <> NIL .and. __oTableBillsMaisPrazo == NIL
        Aadd(aFieldsSelBills, {STR0057, "PARC1", "D", 8, 0}) //"Sua 1º parcela"
        Aadd(aFieldsSelBills, {STR0058, "PARC2", "D", 8, 0}) //"Sua 2º parcela"
        Aadd(aFieldsSelBills, {STR0059, "PARC3", "D", 8, 0}) //"Sua 3º parcela"
        Aadd(aFieldsSelBills, {STR0060, "VALORPARC", "N", 14, 2, X3Picture("E2_VALOR")}) //"Valor da parcela"
        cTitleTable1 := STR0061 //"As 3 primeiras colunas se referem aos titulos que serão pagos ao fornecedor. As demais colunas mostram os seus boletos com o Mais Prazo"
        oFontTitleTable1 := TFont():New(,,-13,.F.)
        nPercentTable1 := 80
    Endif

    oDialog   := TDialog():New(000, 000, 550, 1024, STR0062,,,,,,,, oMainWnd, .T.) //"Consultar títulos da operação"
    
    oLayer := FWLayer():new()
    oLayer:Init(oDialog, .F.)
    
    If __oTableBillsSelected <> NIL
        oLayer:AddLine('TITULOTBL1', 8,.F.)
        oLayer:addCollumn('TITULO',100, .F. ,'TITULOTBL1')
        TSay():New(5,5,{|| cTitleTable1 }, oLayer:getColPanel('TITULO','TITULOTBL1'),,oFontTitleTable1,,,,.T.)
    
        oLayer:AddLine("TLB1", nPercentTable1, .F.)
        oLayer:addCollumn("SELTITULOS", 100, .T., "TLB1")
        oBrowse     := FWMBrowse():New()
        oBrowse:SetOwner(oLayer:getColPanel('SELTITULOS', 'TLB1'))
        oBrowse:SetAlias(__oTableBillsSelected:getAlias())
        oBrowse:SetFields(aFieldsSelBills)
        oBrowse:SetMenuDef("")
        oBrowse:SetTemporary(.T.)
        oBrowse:SetUseFilter(.F.)
        oBrowse:DisableReport()
        oBrowse:DisableConfig()
        oBrowse:DisableDetails()
        oBrowse:Activate()
    Endif
    
    If __oTableBillsMaisPrazo <> NIL
        oLayer:AddLine('VALORESTBL1',7,.F.)
        oLayer:addCollumn('TITULO',100, .F. ,'VALORESTBL1')
        TSay():New(0,5,{|| STR0063 +" R$ " + AllTrim(Transform(nBillsTotalValue, PesqPict("SE2", "E2_SALDO")))}, oLayer:getColPanel('TITULO','VALORESTBL1'),,TFont():New(,,-12,.F.),,,,.T.) //"Total de títulos:"

        Aadd(aFieldsMpzBills, {STR0057, "PARC1", "D", 8, 0}) //"Sua 1º parcela"
        Aadd(aFieldsMpzBills, {STR0058, "PARC2", "D", 8, 0}) //"Sua 2º parcela"
        Aadd(aFieldsMpzBills, {STR0059, "PARC3", "D", 8, 0}) //"Sua 3º parcela"
        Aadd(aFieldsMpzBills, {STR0060, "VALORPARC", "N", 14, 2, X3Picture("E2_VALOR")}) //"Valor da parcela"

        oLayer:AddLine('TITULOTBL2',8,.F.)
        oLayer:addCollumn('TITULO',100, .F. ,'TITULOTBL2')
        TSay():New(5,5,{|| STR0064 },oLayer:getColPanel('TITULO','TITULOTBL2'),,TFont():New(,,-20,.T.),,,,.T.) //"Seus boletos com o Mais Prazo"

        oLayer:AddLine("TBL2", 15, .F.)
        oLayer:addCollumn("MAISPRAZO", 100, .T., "TBL2")
        oBrowseMaisPrazo     := FWMBrowse():New()
        oBrowseMaisPrazo:SetOwner(oLayer:getColPanel('MAISPRAZO', 'TBL2'))
        oBrowseMaisPrazo:SetAlias(__oTableBillsMaisPrazo:getAlias())
        oBrowseMaisPrazo:SetFields(aFieldsMpzBills)
        oBrowseMaisPrazo:SetMenuDef("")
        oBrowseMaisPrazo:SetTemporary(.T.)
        oBrowseMaisPrazo:SetUseFilter(.F.)
        oBrowseMaisPrazo:DisableReport()
        oBrowseMaisPrazo:DisableConfig()
        oBrowseMaisPrazo:DisableDetails()
        oBrowseMaisPrazo:Activate()
    Endif

    oLayer:AddLine('SUBTBL2',7,.F.)
    oLayer:addCollumn('INFO',100, .F. ,'SUBTBL2')
    TSay():New(0,5,{|| STR0065}, oLayer:getColPanel('INFO','SUBTBL2'),,TFont():New(,,-12,.F.),,,,.T.) //"*Valor já inclui juros da solicitação"

    oDialog:Activate(,,,.T.)
Return

/*/{Protheus.doc} createTemporaryDialogBills
    Realiza a criação das tabelas temporarias que serão exibidas na consulta
    dos titulos que fazem parte do processo de prorrogação
    @type  Function
    @author Vitor Duca
    @since 22/09/2025
    @version 1.0
    @param lSpecificDate, Logical, Define se foi o processo parte de uma data especifica (Pagar agora ou data especifica)
    @param nDays, Numeric, Numero de dias escolhidos, diferente de data especifica
/*/
Function createTemporaryDialogBills(lSpecificDate as logical, nDays as numeric)
    local aFieldsTemp   := {}                               as array
    local cAliasTemp := ""                                  as character
    local nX := 0                                           as numeric
    local cSelectInsert := ""                               as character
    local aIndex := {{"E2_NUM","E2_SALDO","E2_VENCREA"}}    as array
    local nValueInstallment := 0                            as numeric
    local cInstallment1 := ""                               as character
    local cInstallment2 := ""                               as character
    local cInstallment3 := ""                               as character

    If __oPayables <> NIL
        
        If jInstallmentsSimulation:hasProperty("installments")
            nValueInstallment := jInstallmentsSimulation["installments"][1]["installmentAmount"]
            For nX := 1 to len(jInstallmentsSimulation["installments"])
                &("cInstallment" + cValToChar(nX)) := StrTran(jInstallmentsSimulation["installments"][nX]["installmentDueDate"], "-", "")
            Next nX
        Endif

        If lSpecificDate
            cSelectInsert := " SELECT E2_NUM, E2_SALDO, E2_VENCREA "
            cSelectInsert += " FROM " + __oPayables:getRealName() + " "
            cSelectInsert += " WHERE MARK = 'X' "

            Aadd(aFieldsTemp, {"E2_NUM", "C", TamSx3("E2_NUM")[1], 0})
            Aadd(aFieldsTemp, {"E2_SALDO", "N", TamSx3("E2_SALDO")[1], TamSx3("E2_SALDO")[2]}) 
            Aadd(aFieldsTemp, {"E2_VENCREA", "D", 8, 0})

            createTemporaryTable(@__oTableBillsSelected, aFieldsTemp, aIndex, cSelectInsert)

            aFieldsTemp := {}
            Aadd(aFieldsTemp, {"PARC1", "D", 8, 0})
            Aadd(aFieldsTemp, {"PARC2", "D", 8, 0})
            Aadd(aFieldsTemp, {"PARC3", "D", 8, 0})
            Aadd(aFieldsTemp, {"VALORPARC", "N", 14, 2})

            createTemporaryTable(@__oTableBillsMaisPrazo, aFieldsTemp)

            cAliasTemp := __oTableBillsMaisPrazo:getAlias()
            RecLock(cAliasTemp, .T.)
                (cAliasTemp)->VALORPARC := nValueInstallment
                (cAliasTemp)->PARC1 := Stod(cInstallment1)
                (cAliasTemp)->PARC2 := Stod(cInstallment2)
                (cAliasTemp)->PARC3 := Stod(cInstallment3)
            (cAliasTemp)->(MsUnlock())
        Else
            cSelectInsert := " SELECT E2_NUM, E2_SALDO, E2_VENCREA, "
            cSelectInsert += " '"+cInstallment1+"', '"+cInstallment2+"', '"+cInstallment3+"', "+cValToChar(nValueInstallment)+" "
            cSelectInsert += " FROM " + __oPayables:getRealName() + " "
            cSelectInsert += " WHERE MARK = 'X' "
            
            Aadd(aFieldsTemp, {"E2_NUM", "C", TamSx3("E2_NUM")[1], 0})
            Aadd(aFieldsTemp, {"E2_SALDO", "N", TamSx3("E2_SALDO")[1], TamSx3("E2_SALDO")[2]}) 
            Aadd(aFieldsTemp, {"E2_VENCREA", "D", 8, 0})
            Aadd(aFieldsTemp, {"PARC1", "D", 8, 0})
            Aadd(aFieldsTemp, {"PARC2", "D", 8, 0})
            Aadd(aFieldsTemp, {"PARC3", "D", 8, 0})
            Aadd(aFieldsTemp, {"VALORPARC", "N", 14, 2})

            createTemporaryTable(@__oTableBillsSelected, aFieldsTemp, aIndex, cSelectInsert)
        Endif
    Endif
Return

/*/{Protheus.doc} confirmSolicitation
    Realiza a confirmação da solicitação, envio da mensagem ao smartlink 
    e gravação das tabelas
    @type  Function
    @author Vitor Duca
    @since 24/09/2025
    @version 1.0
/*/
Function confirmSolicitation(cSelectedDueDate as character, nQuantityOfPayment as numeric, jData as json) as logical
    local lRet := .T.               as logical
    local cNumRequest := ""         as character
    local cError := ""              as character
    local cQuery := ""              as character
    local cAliasTemp := ""          as character
    local oModel                    as object
    local oModelARG                 as object
    local oModelARH                 as object
    local nX := 0                   as numeric
    local nInstallments := 0        as numeric
    local aInstallments := {}       as Array
    local nValueInstallment := 0    as numeric
    
    If __oPayables <> NIL
        oModel    := FWLoadModel("totvs.protheus.backoffice.techfin.maisprazo.monitor.extensionMonitor")
        oModelARG := oModel:GetModel("ARGMASTER")
        oModelARH := oModel:GetModel("ARHDETAIL")
        oModel:SetOperation(MODEL_OPERATION_INSERT)
        oModel:Activate()

        cNumRequest := oModelARG:getValue("ARG_NUM")
        oModelARG:setValue("ARG_STATUS", "1") //STATUS AGUARDANDO APROVAÇÃO (AGUARDANDO APROVAÇÃO PELA PLATAFORMA TECHFIN)
        oModelARG:setValue("ARG_DTSOL", Date()) //DATA DA SOLICITAÇÃO
        oModelARG:setValue("ARG_QTDTIT", nQuantityOfPayment) //QUANTIDADE DE TITULOS QUE SERÃO PRORROGADOS
        oModelARG:setValue("ARG_VLTOT", jData["simulations"]["totalAmountRequested"] + jData["simulations"]["interestAmount"] + jData["simulations"]["iofAmount"]) //VALOR TOTAL DA SOLICITAÇÃO + TAXAS
        oModelARG:setValue("ARG_VLSOL", jData["simulations"]["totalAmountRequested"]) //VALOR TOTAL DA SOLICITAÇÃO
        oModelARG:setValue("ARG_FORPGO", cSelectedDueDate) //FORMA DE PAGAMENTO ESCOLHIDA (PAGAR AGORA, PAGAR NO VENCIMENTO)
        oModelARG:setValue("ARG_TXJUR", jData["simulations"]["monthlyInterestRate"]) //TAXA DE JUROS AO MES
        oModelARG:setValue("ARG_TXCET", jData["simulations"]["monthlyTotalEffectiveCostRate"]) //TAXA DE CUSTO EFETIVO TOTAL
        oModelARG:setValue("ARG_VLRJUR", jData["simulations"]["interestAmount"]) //VALOR DO JUROS
        oModelARG:setValue("ARG_VLRIOF", jData["simulations"]["iofAmount"]) //VALOR DO IOF
        oModelARG:setValue("ARG_DTAAGE", Stod(StrTran(jData["simulations"]["newDueDate"], "-", ""))) //DATA DE AGENDAMENTO
        oModelARG:setValue("ARG_FNCOND", jData["simulations"]["financingCondition"]) //CONDICAO DE FINANCIAMENTO (USO INTERNO SUPPLIER)

        nInstallments := Len(jData["installments"])
        nValueInstallment := jData["installments"][1]["installmentAmount"]

        For nX := 1 to nInstallments
            Aadd(aInstallments, Stod(StrTran(jData["installments"][nX]["installmentDueDate"], "-", "")))
        next nX

        cQuery := "SELECT E2_FILORIG, E2_PREFIXO, E2_NUM, E2_PARCELA, E2_TIPO, E2_FORNECE, E2_LOJA, E2_SALDO, E2_VENCREA, "
        cQuery += "FK7_IDDOC "
        cQuery += "FROM " + __oPayables:getRealName() + " "
        cQuery += "WHERE MARK = ? "

        cAliasTemp := MPSysOpenQuery(cQuery,,,,{"X"})

        While (cAliasTemp)->(!EOF())
            oModelARH:AddLine()
            oModelARH:setValue("ARH_NUM", cNumRequest)
            oModelARH:setValue("ARH_STATUS", "3") //STATUS EM PROCESSAMENTO (AGUARDANDO RETORNO)
            oModelARH:setValue("ARH_FILTIT", (cAliasTemp)->E2_FILORIG)
            oModelARH:setValue("ARH_PREFIX", (cAliasTemp)->E2_PREFIXO)
            oModelARH:setValue("ARH_NUMTIT", (cAliasTemp)->E2_NUM)
            oModelARH:setValue("ARH_PARCEL", (cAliasTemp)->E2_PARCELA)
            oModelARH:setValue("ARH_TIPO", (cAliasTemp)->E2_TIPO)
            oModelARH:setValue("ARH_FORNEC", (cAliasTemp)->E2_FORNECE)
            oModelARH:setValue("ARH_LOJA", (cAliasTemp)->E2_LOJA)
            oModelARH:setValue("ARH_VLBOL", (cAliasTemp)->E2_SALDO)
            oModelARH:setValue("ARH_VENCRE", Stod((cAliasTemp)->E2_VENCREA))
            oModelARH:setValue("ARH_IDDOC", (cAliasTemp)->FK7_IDDOC)

            For nX := 1 to nInstallments
                oModelARH:setValue("ARH_PARC" + cValToChar(nX), aInstallments[nX])
            next nX

            oModelARH:setValue("ARH_VLPARC", nValueInstallment)

            (cAliasTemp)->(dbSkip())
        EndDO
        (cAliasTemp)->(DbCloseArea())

        if !(lRet := oModel:vldData() .and. oModel:commitData() .and. !oModel:HasErrorMessage())
            cError := oModel:GetErrorMsgText(.T.)
            Help( ,,"SOLMODELVALID",,cError, 1, 0 )
        endif

        oModel:deActivate()
        oModel:destroy()
        oModel := NIL
    Endif

Return lRet

/*/{Protheus.doc} getObjectsTables
    Recupera os objetos contendo as tabelas temporarias
    @type  Function
    @author Vitor Duca
    @since 22/10/2025
    @version 1.0
    @return json, json, Objeto JSON contendo os objetos das tabelas temporarias
/*/
Function getObjectsTables()
Return {"elegivel": __oPayables, "naoelegivel": __oPayablesNE}
