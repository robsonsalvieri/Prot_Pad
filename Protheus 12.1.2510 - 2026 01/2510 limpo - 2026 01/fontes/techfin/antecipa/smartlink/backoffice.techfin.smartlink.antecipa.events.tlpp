return

/*/{Protheus.doc} AntecipaEvents::FConciliacao
    Pré-execução do evento de Conciliação
    @type method
    @author Squad TechFin
    @since 28/11/2025
/*/
method FConciliacao() class AntecipaEvents

    local aArea     := {}                 as array
    local lSucesso  := .F.                as logical
    local cMensagem := ""                 as character
    local jTitulo   := JsonObject():new() as json
    local dDateBkp  := dDataBase          as date
    local nA6_COD	 := 0                 as numeric
	local nA6_AGENCIA:= 0                 as numeric
	local nA6_NUMCON := 0                 as numeric
    local cMV_BCOTECF := ""               as character
    local cMV_AGETECF := ""               as character
    local cMV_CTNTECF := ""               as character

    nA6_COD 	:= TamSX3("A6_COD")[1]
	nA6_AGENCIA := TamSX3("A6_AGENCIA")[1]
	nA6_NUMCON 	:= TamSX3("A6_NUMCON")[1]

    ::nEventRunning := CONCILIACAO

    If ::canBeExecuted()
        aArea := {SE1->(FwGetArea()), ARF->(FwGetArea()), FwGetArea()}

		::jData["bank"]            := PadR(::jData["bank"],nA6_COD)
		::jData["branch"]          := PadR(::jData["branch"],nA6_AGENCIA)
		::jData["checkingAccount"] := PadR(::jData["checkingAccount"],nA6_NUMCON)

        cMV_BCOTECF := PadR(SuperGetMV("MV_BCOTECF",.F.,""),nA6_COD)
        cMV_AGETECF := PadR(SuperGetMV("MV_AGETECF",.F.,""),nA6_AGENCIA)
        cMV_CTNTECF := PadR(SuperGetMV("MV_CTNTECF",.F.,""),nA6_NUMCON)

        dbSelectArea("SE1")
        dbSetOrder(1)
        If SE1->(!msSeek(FWxFilial('SE1',ARE->ARE_FILTIT)+ARE->(ARE_PREFIX + ARE_NUMTIT + ARE_PARTIT + ARE_TIPTIT)))
            Aadd( ::jResult["error"], JsonObject():new())
            ::jResult["error"][Len(::jResult["error"])]["description"] := STR0001 //"Título a receber (SE1) não localizado."
        EndIF
        dbSelectArea("SA6")
        dbSetOrder(1)
        If SA6->(!msSeek(FWxFilial('SA6') + ::jData["bank"] + ::jData["branch"] + ::jData["checkingAccount"]))
            Aadd( ::jResult["error"], JsonObject():new())
            ::jResult["error"][Len(::jResult["error"])]["description"] := STR0009//"O banco enviado não esta cadastrado"
        Else
            iF SA6->A6_COD+SA6->A6_AGENCIA+SA6->A6_NUMCON == cMV_BCOTECF + cMV_AGETECF + cMV_CTNTECF
                Aadd( ::jResult["error"], JsonObject():new())
                ::jResult["error"][Len(::jResult["error"])]["description"] := STR0010//"O Banco informado não pode ser igual ao Banco contido nos parâmetros TOTVS Antecipa"
            EndIF        
        EndIF        

        If Empty( ::jResult["error"])            
            jTitulo["expenseClass"]     := SE1->E1_NATUREZ // Natureza da Despesa
            jTitulo["revenueClass"]     := SE1->E1_NATUREZ // Natureza da Receit            
            jTitulo["typeOperation"]    := Iif( ::jData["transactionType"]==1, 2, 1) // 1=Debito, 2=Credito
            jTitulo["date"]             := StoD( StrTran( ::jData["transactionDate"],"-","" ) )
            jTitulo["localAmount"]      := Abs( ::jData["transactionAmount"] )
            jTitulo["history"]          := ::jData["eventDescription"]
            jTitulo["bankCode"]         := ::jData["bank"]
            jTitulo["agencyCode"]	    := ::jData["branch"]
            jTitulo["accountCode"]      := ::jData["checkingAccount"]
            jTitulo["cDocTran"]         := ARF->ARF_CODIGO

            dDataBase := jTitulo["date"]            
            lSucesso := F136MovBan(jTitulo, @cMensagem)
            dDataBase := dDateBkp
            If !lSucesso
                Aadd( ::jResult["error"], JsonObject():new())
                ::jResult["error"][Len(::jResult["error"])]["description"] := cMensagem
            EndIF    
        EndIF

        aEval(aArea,{|x| FwRestArea(x)})
        FwFreeArray(aArea)
    EndIf
    FwFreeObj(jTitulo)

return

/*/{Protheus.doc} AntecipaEvents::FDevolucao
    Pré-execução do evento de devolução
    @type method
    @author Squad TechFin
    @since 22/10/2025
/*/
method FDevolucao() class AntecipaEvents
    local aArea     := {}                 as array
    local cMensagem := ""                 as character
    local jParcela  := JsonObject():new() as json
    local cChaveSE1 := ""                 as character
    local cChaveNCC := ""                 as character
    local nRecnoNCC := 0                  as numeric

    ::nEventRunning := DEVOLUCAO

    If ::canBeExecuted()
        aArea     := {SE1->(FwGetArea()), ARF->(FwGetArea()), FwGetArea()}
        cChaveSE1 := ARE->(FWxFilial('SE1',ARE_FILTIT) + ARE_PREFIX + ARE_NUMTIT + ARE_PARTIT + ARE_TIPTIT)

        dbSelectArea("SE1")
        dbSetOrder(1)

        cChaveNCC := FinFK7Key(, ARF->ARF_IDMOV)

        if SE1->(msSeek(cChaveNCC))
            nRecnoNCC := SE1->(RecNo())
        EndIf

        If SE1->(msSeek(cChaveSE1)) .And. nRecnoNCC > 0
            jParcela["localAmount"]          := ::jData["installmentDebitedAmount"]//Valor do desconto a ser aplicado
            jParcela["debitPrincipalAmount"] := 0
            jParcela["history"]              := ""
            jParcela["creditUnits"]          := {}
            jParcela["discountAmount"]       := 0
            jParcela["feeAmount"]            := ::jData["installmentFeeDebitedAmount"]
            jParcela["feeAmountOrigin"]      := 0
            jParcela["formattedErpId"]       := cChaveSE1
            jParcela["taxHistory"]           := STR0011 //"Devolução pelo TOTVS Antecipa"
            jParcela["creditUnits"]          := {}

            AAdd(jParcela["creditUnits"], {;
                "formattedErpId"  : cChaveNCC,;
                "creditErpId"     : cEmpAnt + "|" + cChaveNCC,;
                "creditAmount"    : self:jData["installmentDebitedAmount"],;
                "recordId"        : nRecnoNCC;
            })

            If !F136Bonifi(jParcela, @cMensagem)
                Aadd( ::jResult["error"], JsonObject():new())
                ::jResult["error"][Len(::jResult["error"])]["description"] := cMensagem
            EndIF
        Else
            Aadd( ::jResult["error"], JsonObject():new())
            ::jResult["error"][Len(::jResult["error"])]["description"] := STR0001 //"Título a receber (SE1) não localizado." 
        EndIF

        aEval(aArea,{|x| FwRestArea(x)})
        FwFreeArray(aArea)
    EndIf
    FwFreeObj(jParcela)
return

/*/{Protheus.doc} canBeExecuted
	Validação dos dados necessarios para processamento dos eventos
	@author Squad TechFin
	@since 07/10/2025
	@version 1.0
	@return lValid, logical, Define se o processamento esta valido para ser iniciado
/*/
Method canBeExecuted() as logical class AntecipaEvents
	local aParameters := {}	as array
	local nX := 0			as numeric
    
    Aadd(aParameters, "MV_BCOTECF")
    Aadd(aParameters, "MV_AGETECF")
    Aadd(aParameters, "MV_CTNTECF")

    If ::nEventRunning == BONIFICACAO .Or. ::nEventRunning == BAIXA
        Aadd(aParameters, "MV_MOTTECF")
    EndIf
    
    //Valida preenchimneto de parâmetros obrigatorios para execução dos eventos
    for nX := 1 to len(aParameters)
        If Empty(Alltrim(GetMV(aParameters[nX])))
            Aadd( ::jResult["error"], JsonObject():new())
            ::jResult["error"][Len(::jResult["error"])]["description"] :=  STR0003 + " " + aParameters[nX]+ " " + STR0004 //"Parametro "+aParameters[nX]+" não foi configurado."
            return .F.
        Endif
    next nX

Return .T.

/*/{Protheus.doc} RetBaixas
    Retrorna a sequencia da baixa realizada para o titulo informado no evento de Estorno
    @author Squad TechFin
    @since 07/10/2025
    @version 1.0
    @return cSeq, character, Sequencia da baixa realizada
/*/
Method RetBaixas() as character class AntecipaEvents
    local cAlias    :="" as Character
    local cChaveFK7 :="" as Character
    local cQuery    :="" as Character
    local cChaveSE1 :="" as Character
    local cSeq      :="" as character
    cChaveSE1 := FwXFilial("SE1", SE1->E1_FILORIG) + "|" +;
                    SE1->E1_PREFIXO     + "|" +;
                    SE1->E1_NUM         + "|" +;
                    SE1->E1_PARCELA     + "|" +;
                    SE1->E1_TIPO        + "|" +;
                    SE1->E1_CLIENTE     + "|" +;
                    SE1->E1_LOJA                    
    cChaveFK7   := FinBuscaFK7(cChaveSE1, "SE1")

    If ::oQryBaixas == Nil
        cQuery := "SELECT FK1_SEQ, FK1_VALOR" 
        cQuery += " FROM " + RetSQLName("FK1") + " FK1"
        cQuery += " WHERE "
        cQuery += " FK1.FK1_FILIAL = ? " 
        cQuery += " AND FK1.FK1_IDDOC = ? " 
        cQuery += " AND FK1.D_E_L_E_T_ = ? "
        cQuery += " AND NOT EXISTS( "
        cQuery += "     SELECT FK1EST.FK1_IDDOC FROM " + RetSQLName("FK1") +" FK1EST"
        cQuery += "     WHERE FK1EST.FK1_FILIAL = FK1.FK1_FILIAL"
        cQuery += "     AND FK1EST.FK1_IDDOC = FK1.FK1_IDDOC "
        cQuery += "     AND FK1EST.FK1_SEQ = FK1.FK1_SEQ "
        cQuery += "     AND FK1EST.FK1_DOC = FK1.FK1_DOC "
        cQuery += "     AND FK1EST.FK1_TPDOC = ? "
        cQuery += "     AND FK1EST.D_E_L_E_T_ = ?) "
        cQuery += " ORDER BY FK1_SEQ DESC"
        ::oQryBaixas := FwExecStatement():New(cQuery)
    EndIf
    ::oQryBaixas:SetString(1, FwXFilial("FK1"))
    ::oQryBaixas:SetString(2, cChaveFK7)
    ::oQryBaixas:SetString(3, " ")
    ::oQryBaixas:SetString(4, "ES")
    ::oQryBaixas:SetString(5, " ")

    cAlias := ::oQryBaixas:OpenAlias()
    While (cAlias)->(!EoF())
       If (cAlias)->FK1_VALOR == ::jData["details"]["installmentAmount"]
            cSeq := (cAlias)->FK1_SEQ
            Exit
        EndIf
        (cAlias)->(dbSkip())
    End
    (cAlias)->(DbCloseArea())

Return cSeq
