#include "tlpp-core.th"
#include "protheus.ch"
#include "backoffice.techfin.smartlink.antecipa.events.ch"

NAMESPACE totvs.protheus.backoffice.techfin.smartlink.antecipa.events

#Define ANTECIPACAO 1
#Define PRORROGACAO 2
#Define BONIFICACAO 3
#Define RECOMPRA    4
#Define BAIXA       5
#Define ESTORNO     6
#Define COOBRIGACAO 7
#Define DIVERGENCIA 8
#Define CONCILIACAO 9
#Define DEVOLUCAO  10  

/*/{Protheus.doc} AntecipaEvents
    Eventos Totvs Antecipa.
    Preperação dos dados pré execução dos eventos, conforme realizado atualmente pelo Job FINI136O.prw
    @type       Class
    @author     Totvs
    @since      9/12/2025
    @version    P12.1.2510  
/*/
Class AntecipaEvents

    data jData          as json
    data jResult        as json
    data oQryBaixas     as object
    data nEventRunning  as numeric

    public method new()  constructor    
    public method setData()
    public method getResult()
    public method FAntecipa()    //-- Evento de Antecipação
    public method FProrroga()    //-- Evento de Prorrogação
    public method FBonifica()    //-- Evento de Bonificação
    public method FRecompra()    //-- Evento de Recompra
    public method FBaixa()       //-- Evento de Baixa de titulo
    public method FEstorno()     //-- Evento de Estorno de baixa 
    public method FCoobrigacao() //-- Evento de Coobrigacao
    public method FDivergencia() //-- Evento de Divergencia
    public method FConciliacao() //-- Evento de Conciliação
    public method FDevolucao()   //-- Evento de Devolucao

    private method canBeExecuted()  as logical
    private method retBaixas()      as character

end class


/*/{Protheus.doc} AntecipaEvents::New
    Método construtor da classe
    @type method
    @author Squad TechFin
    @since 9/12/2025
/*/
method new() class AntecipaEvents
    ::jData             := JsonObject():new()
    ::jResult           := JsonObject():new()
    ::jResult["error"]  := {}
    ::nEventRunning     := 0
return Self

/*/{Protheus.doc} AntecipaEvents::setData
    Recebe dados para processamento do evento
    @type method
    @author Squad TechFin
    @since 9/12/2025
/*/
method setData( jDataOrigin as json ) class AntecipaEvents
    ::jData := jDataOrigin
return

/*/{Protheus.doc} AntecipaEvents::getResult
    REtorno resultado do processamento do evento
    @type method
    @author Squad TechFin
    @since 9/12/2025
    @return json, Objeto JSON contendo resultado e eventuais erros
/*/
method getResult() class AntecipaEvents
return( ::jResult )

/*/{Protheus.doc} AntecipaEvents::FAntecipa
    Pré-execução do evento de Antecipação
    @type method
    @author Squad TechFin
    @since 9/12/2025
/*/
method FAntecipa()  class AntecipaEvents

    Local oParcela  := JsonObject():new()          as json
    Local cMensagem := ""                          as character
    Local cRetType  := "04"                        as character
    Local lSucesso  := .T.                         as logical
    Local aArea     := {}                          as array
    Local cItem     := ::jData["erpInstallmentId"] as character
    Local cNumSol   := ARD->ARD_NUM                as character
    Local cChaveSE1 := ""                          as character

    ::nEventRunning := ANTECIPACAO
    If ::canBeExecuted()  

        aArea := {SE1->(FwGetArea()), ARD->(FwGetArea()), ARE->(FwGetArea()), FwGetArea()}

        dbSelectArea("SE1")
        dbSetOrder(1)
        dbSelectArea("ARE")
        dbSetOrder(1) //ARE_FILIAL, ARE_NUM, ARE_ITEM
        If ARE->(DBSeek(FwXFilial("ARE") + cNumSol + cItem)) .And. ARE->ARE_STATUS == "1" //Título Pre autorizado
            cChaveSE1 := FwXFilial("SE1", ARE->ARE_FILTIT) + ARE->(ARE_PREFIX + ARE_NUMTIT + ARE_PARTIT + ARE_TIPTIT)
            If SE1->(DBSeek(cChaveSE1))
                // Constroi oParcela conforme esperado pela função F136AntAp()
                oParcela["formattedErpId"]  := cChaveSE1
                oParcela["history"]         := ""           //cHistórico
                oParcela["date"]            := Date()       //dDataMov   
                oParcela["localAmount"]     := SE1->E1_SALDO//nVlrJson
                oParcela["feeAmount"]       := SE1->E1_SALDO - ARE->ARE_VLPREA//nValDesc

                lSucesso := F136AntAp(oParcela, @cMensagem, @cRetType)//F136AntAp -> FINA136A.PRW

                IF !lSucesso
                    Aadd( ::jResult["error"], JsonObject():new())
                    ::jResult["error"][Len(::jResult["error"])]["description"] := "ARE_ITEM "+ ARE->ARE_ITEM + ": " + cMensagem
                EndIF
            Else
                Aadd( ::jResult["error"], JsonObject():new())
                ::jResult["error"][Len(::jResult["error"])]["description"] := "ARE_ITEM "+ ARE->ARE_ITEM + ": " + STR0001 //Título a receber (SE1) não localizado. 
            EndIF
        EndIf    

        aEval(aArea,{|x| FwRestArea(x)})
        FwFreeArray(aArea)
        FwFreeObj(oParcela)
    EndIf

Return 

/*/{Protheus.doc} AntecipaEvents::FProrroga
    Pré-execução do evento de Prorrogação
    @type method
    @author Squad TechFin
    @since 9/12/2025
/*/
method FProrroga() class AntecipaEvents

    local aArea     := {}                 as array
    local lSucesso  := .F.                as logical
    local cMensagem := ""                 as character
    local jTitulo   := JsonObject():new() as json
    
    ::nEventRunning := PRORROGACAO

    If ::canBeExecuted()  
        aArea := {SE1->(FwGetArea()), ARF->(FwGetArea()), FwGetArea()}    
        dbSelectArea("SE1")
        dbSetOrder(1)
        If SE1->(msSeek(FwXFilial("SE1",ARF->ARF_FILTIT)+ARF->(ARF_PREFIX+ARF_NUMTIT+ARF_PARTIT+ARF_TIPTIT)))

            // Constroi jTitulo conforme esperado pela função F136Prorrg()                        
            jTitulo["newDueDate"]       := StoD(StrTran(::jData["newDueDate"],"-","")) //Formato original yyyy-mm-dd
            jTitulo["history"]          := ""                   
            jTitulo["feeAmount"]        := ::jData["installmentFeeDebitedAmount"]//Valor debitado pela taxa
            jTitulo["formattedErpId"]   := FwXFilial("SE1")+ARF->(ARF_PREFIX+ARF_NUMTIT+ARF_PARTIT+ARF_TIPTIT)        
            jTitulo["taxHistory"]       := "Tx Prorrog."
                
            lSucesso := F136Prorrg(jTitulo, @cMensagem)//F136Prorrg -> FINA136B.PRW                                    
            iF !lSucesso
                Aadd( ::jResult["error"], JsonObject():new())
                ::jResult["error"][Len(::jResult["error"])]["description"] := cMensagem
            EndIF
        Else
            Aadd( ::jResult["error"], JsonObject():new())
            ::jResult["error"][Len(::jResult["error"])]["description"] := STR0001 //"Título a receber (SE1) não localizado." 
        EndIF

        aEval(aArea,{|x| FwRestArea(x)})
        FwFreeArray(aArea)
    EndIf    
    FwFreeObj(jTitulo)
return

/*/{Protheus.doc} AntecipaEvents::FBonificac
    Pré-execução do evento de Bonificação
    @type method
    @author Squad TechFin
    @since 9/12/2025
/*/
method FBonifica() class AntecipaEvents

    local aArea     := {}                 as array
    local lSucesso  := .F.                as logical
    local cMensagem := ""                 as character
    local jTitulo   := JsonObject():new() as json

    ::nEventRunning := BONIFICACAO

    if ::canBeExecuted()    
        aArea := {SE1->(FwGetArea()), ARF->(FwGetArea()), FwGetArea()}   
        dbSelectArea("SE1")
        dbSetOrder(1)
        If SE1->(msSeek(FwXFilial("SE1",ARF->ARF_FILTIT)+ARF->(ARF_PREFIX+ARF_NUMTIT+ARF_PARTIT+ARF_TIPTIT)))

            // Constroi jTitulo conforme esperado pela função F136Bonifi()   
            jTitulo["localAmount"]          := 0  
            jTitulo["debitPrincipalAmount"] := 0
            jTitulo["history"]              := ""
            jTitulo["creditUnits"]          := {}
            jTitulo["discountAmount"]       := ::jData["installmentDebitedAmount"]//Valor do desconto a ser aplicado
            jTitulo["feeAmount"]            := ::jData["installmentFeeDebitedAmount"]//Valor debitado pela taxa
            jTitulo["feeAmountOrigin"]      := 0
            jTitulo["formattedErpId"]       := FwXFilial("SE1")+ARF->(ARF_PREFIX+ARF_NUMTIT+ARF_PARTIT+ARF_TIPTIT)
            jTitulo["taxHistory"]           := "Tx Bonific."

            lSucesso := F136Bonifi(jTitulo, @cMensagem)//F136Bonifi -> FINA136D.PRW
            If !lSucesso
                Aadd( ::jResult["error"], JsonObject():new())
                ::jResult["error"][Len(::jResult["error"])]["description"] := cMensagem
            EndIF
        Else
            Aadd( ::jResult["error"], JsonObject():new())
            ::jResult["error"][Len(::jResult["error"])]["description"] := STR0001 //"Título a receber (SE1) não localizado." 
        EndIF

        aEval(aArea,{|x| FwRestArea(x)})
        FwFreeArray(aArea)
    EndIf
    FwFreeObj(jTitulo)
return

/*/{Protheus.doc} AntecipaEvents::FRecompra
    Pré-execução do evento de Recompra
    @type method
    @author Squad TechFin
    @since 14/10/2025
/*/
method FRecompra() class AntecipaEvents

    local aArea     := {}                 as array
    local lSucesso  := .F.                as logical
    local cMensagem := ""                 as character
    local jTitulo   := JsonObject():new() as json

    ::nEventRunning := RECOMPRA

    If ::canBeExecuted()
        aArea := {SE1->(FwGetArea()), ARF->(FwGetArea()), FwGetArea()}
        dbSelectArea("SE1")
        dbSetOrder(1)
        If SE1->(msSeek(FwXFilial("SE1",ARF->ARF_FILTIT)+ARF->(ARF_PREFIX+ARF_NUMTIT+ARF_PARTIT+ARF_TIPTIT)))

            jTitulo["feeAmount"]       := ::jData["installmentFeeDebitedAmount"]//Valor debitado pela taxa
            jTitulo["feeAmountOrigin"] := 0
            jTitulo["taxHistory"]      := "Tx. Recompra"
            jTitulo["formattedErpId"]  := FwXFilial("SE1")+ARF->(ARF_PREFIX+ARF_NUMTIT+ARF_PARTIT+ARF_TIPTIT)
            jTitulo["history"]         :=  ""
            jTitulo["date"]            :=  ::jData["partnerDebitDate"]
            jTitulo["localAmount"]     :=  ::jData["installmentPendingAmount"]

            lSucesso := F136Cancel(jTitulo, @cMensagem)//F136Cancel -> FINA136A.PRW
            If !lSucesso
                Aadd( ::jResult["error"], JsonObject():new())
                ::jResult["error"][Len(::jResult["error"])]["description"] := cMensagem
            EndIF
        Else
            Aadd( ::jResult["error"], JsonObject():new())
            ::jResult["error"][Len(::jResult["error"])]["description"] := STR0001 //"Título a receber (SE1) não localizado." 
        EndIF

        aEval(aArea,{|x| FwRestArea(x)})
        FwFreeArray(aArea)
    EndIf
    FwFreeObj(jTitulo)
return

/*/{Protheus.doc} AntecipaEvents::FBaixa
    Pré-execução do evento de Baixa de Titulo
    @type method
    @author Squad TechFin
    @since 22/10/2025
/*/
method FBaixa() class AntecipaEvents

    local aArea     := {}                 as array
    local lSucesso  := .F.                as logical
    local cMensagem := ""                 as character
    local dDateBkp  := dDataBase          as date
    local jTitulo   := JsonObject():new() as json
    local cChaveSE1 := ""                 as character

    ::nEventRunning := BAIXA

    If ::canBeExecuted()
        aArea     := {SE1->(FwGetArea()), FwGetArea()}
        cChaveSE1 := FwXFilial("SE1", ARE->ARE_FILTIT) + ARE->(ARE_PREFIX + ARE_NUMTIT + ARE_PARTIT + ARE_TIPTIT)
        dbSelectArea("SE1")
        dbSetOrder(1)
        If SE1->(msSeek(cChaveSE1))
            jTitulo["formattedErpId"]  := cChaveSE1
            jTitulo["history"]         := STR0005 //"Recebimento pelo TOTVS Antecipa"
            jTitulo["date"]            := StoD(StrTran(::jData["details"]["executionDate"], "-", "")) //Formato original yyyy-mm-dd
            jTitulo["localAmount"]     := ::jData["details"]["installmentAmount"]
            
            dDataBase := jTitulo["date"]
            lSucesso := F136Baixa(jTitulo, @cMensagem)//F136Baixa -> FINA136B.PRW
            dDataBase := dDateBkp
            If !lSucesso
                Aadd( ::jResult["error"], JsonObject():new())
                ::jResult["error"][Len(::jResult["error"])]["description"] := cMensagem
            EndIF
        Else
            Aadd( ::jResult["error"], JsonObject():new())
            ::jResult["error"][Len(::jResult["error"])]["description"] := STR0001 //"Título a receber (SE1) não localizado." 
        EndIF

        aEval(aArea,{|x| FwRestArea(x)})
        FwFreeArray(aArea)
    EndIf

    FwFreeObj(jTitulo)
return


/*/{Protheus.doc} AntecipaEvents::FEstorno
    Pré-execução do evento de Estorno de Baixa
    @type method
    @author Squad TechFin
    @since 22/10/2025
/*/
method FEstorno() class AntecipaEvents

    local aArea     := {}                 as array
    local lSucesso  := .F.                as logical
    local cMensagem := ""                 as character
    local cSeq      := ""                 as character
    local jTitulo   := JsonObject():new() as json
    local cChaveSE1 := ""                 as character
    ::nEventRunning := ESTORNO

    If ::canBeExecuted()
        aArea     := {SE1->(FwGetArea()), ARF->(FwGetArea()), FwGetArea()}
        cChaveSE1 := FwXFilial("SE1", ARE->ARE_FILTIT) + ARE->(ARE_PREFIX + ARE_NUMTIT + ARE_PARTIT + ARE_TIPTIT)
        dbSelectArea("SE1")
        dbSetOrder(1)
         If SE1->(msSeek(cChaveSE1))
            cSeq := ::RetBaixas()
            jTitulo["sequence"] := cSeq
            jTitulo["history"]  := STR0006 //"Estorno de baixa pelo TOTVS Antecipa"
            jTitulo["date"]     := StoD(StrTran(::jData["details"]["executionDate"],"-","")) //Formato original yyyy-mm-dd

            If !Empty(cSeq)
                 lSucesso := F136CancBx(jTitulo, @cMensagem)//F136CancBx -> FINA136B.PRW
            Else
                lSucesso := .f.
                cMensagem := STR0002 //"Nenhuma baixa encontrada para o valor informado."
            EndIf            
            If !lSucesso
                Aadd( ::jResult["error"], JsonObject():new())
                ::jResult["error"][Len(::jResult["error"])]["description"] := cMensagem
            EndIF
        Else
            Aadd( ::jResult["error"], JsonObject():new())
            ::jResult["error"][Len(::jResult["error"])]["description"] := STR0001 //"Título a receber (SE1) não localizado." 
        EndIF

        aEval(aArea,{|x| FwRestArea(x)})
        FwFreeArray(aArea)
    EndIf
    FwFreeObj(jTitulo)
return

