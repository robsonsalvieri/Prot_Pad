#include "tlpp-core.th"
#include "TBICONN.ch"

/*/{Protheus.doc} AntecipaCalculationSimulateResponseV1MessageReader
	Classe de Integração Novo Antecipa.
	Responsável pela gravação do retorno da Simulação de Antecipação
	
	@type class
	@author Squad TechFin
	@since 8/22/2025
/*/
class AntecipaCalculationSimulateResponseV1MessageReader

	data jMSGData  as json
	data jMessage  as json
	data cMock     as character
	data lMock     as logical

	public method new() constructor
	public method read()
	public method mock()

end class

/*/{Protheus.doc} AntecipaCalculationSimulateResponseV1MessageReader::New
	Método construtor da classe
	@type method
	@author Squad TechFin
	@since 8/22/2025
/*/
method New() class AntecipaCalculationSimulateResponseV1MessageReader
	::jMSGData  := JsonObject():new()
	::jMessage  := JsonObject():new()
	::cMock     := ""
	::lMock     := .F.
return Self

/*/{Protheus.doc} AntecipaCalculationSimulateResponseV1MessageReader::mock
    Método para mockar a mensagem recebida para testes
    @type method
    @author Squad TechFin
    @since 9/11/2025
    @param cData, character, dados da mensagem a ser mockada
/*/
method mock(cData as character) class AntecipaCalculationSimulateResponseV1MessageReader
    ::cMock := cData
    ::lMock := .T.
return

/*/{Protheus.doc} AntecipaCalculationSimulateResponseV1MessageReader::read
	Responsável pela leitura e processamento da mensagem.
	@type method
	@author Squad TechFin
	@since 8/22/2025
	@param oLinkMessage, object, Instância de FwTotvsLinkMesage da mensagem
	@return logical, sucesso ou falha. Determina se deve ou não retirar a mensagem da fila.
/*/
method read(oLinkMessage as object) class AntecipaCalculationSimulateResponseV1MessageReader

	Local lSuccess := .F. as Logical
	Local aIdent   :={}   as Array
	Local cCompany := ""  as Character
	Local cBranch  := ""  as Character
	Local cIdMsg   := ""  as Character
	Local cPayload := ""  as Character


	cPayload :=  if(::lMock, ::cMock,  oLinkMessage:RawMessage())
	if ::jMessage:FromJSON(cPayload) == NIL
		::jMSGData  := ::jMessage["data"]

		aIdent := StrTOKArr(::jMSGData["erpRequestId"],"|")//"erpRequestId": "cEmpAnt|cFilAnt|UUID" - conforme mensagem de envio				
		If Len(aIdent) == 3
			cCompany := aIdent[1]
			cBranch	 := aIdent[2]
			cIdMsg	 := aIdent[3]
			
			lSuccess := StartJob("TACalSim", GetEnvServer(), .T., cCompany, cBranch, cPayload, cIdMsg)
		EndIf
	EndIf
	FwFreeObj(::jMSGData)
	FwFreeObj(::jMessage)

Return lSuccess // .T. apaga a mensagem da fila do smartlink

/*/{Protheus.doc} TACalSim
	Gravação do log do retorno da simulação
	@type function
	@author Squad TechFin
	@since 8/26/2025
	@param cCompany, character, Grupo Empresa
	@param cBranch , character, Filial
	@param cPayload, character, mensagem recebida
	@param cIdMsg, character, Id da requisição
/*/
Function TACalSim(cCompany as character, cBranch as character, cPayload as character, cIdMsg as character)
	
	RPCSetType(3) 
	RPCSetEnv(cCompany, cBranch,,,'FIN') 

	totvs.protheus.backoffice.techfin.util.logSmartLink(cPayload, "", "", "1", "Simulate", "T", cIdMsg) //cMessage, cAlias, cUUID, cProduct, cOperation, cOrigin, cIdMsg
	RpcClearEnv()
	
Return .T.
