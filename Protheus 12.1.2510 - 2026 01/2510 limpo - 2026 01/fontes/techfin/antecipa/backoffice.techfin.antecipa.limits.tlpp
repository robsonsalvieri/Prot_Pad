#Include "tlpp-core.th"
#Include "FwMVCDef.ch"
#Include "Protheus.ch"
#Include "backoffice.techfin.antecipa.limits.ch"

NAMESPACE totvs.protheus.backoffice.techfin.antecipa.limits

Static __cPicture :='' as character

/*/{Protheus.doc} AntecipaLimits
    Totvs Antecipa - Gerenciamento de Limites do Sacado
    @type       Function
    @author     Totvs
    @since      18/07/2025
    @version    P12.1.2510
    @param      
    @return     
/*/
Function AntecipaLimits()
    Local nLin        := 0                         as Numeric
    Local aCoors      := FWGetDialogSize(oMainWnd) as Array
    Local aAtuArea    := GetArea()                 as Array
    Local oDlg                                     as Object
    Local oLayer                                   as Object
    Local oSay1                                    as Object
    Local oSay2                                    as Object
    Local oSay3                                    as Object
    Local oSay4                                    as Object
    Local oFont18                                  as Object
    Local oBrwStatCli                              as Object
    Local oBrwHistSol                              as Object
    Local oPanelTitulo                             as Object
    Local oPanelLimite                             as Object
    Local oPanelPendAprov                          as Object
    Local oPanelEmProcess                          as Object
    Local oPanelLimDispo                           as Object
    Local oPanelStatCli                            as Object
    Local oPanelHistSol                            as Object
    Local oButtonPanelTitulo                       as Object
    Local bUpdValues                               as codeblock

    __cPicture  := PesqPict("ARA","ARA_LTOTAL") 
    oFont18     := TFont():New(,,-18,,, )
    oBrwStatCli := FWMBrowse():New()
    oBrwHistSol := FWMBrowse():New()
    
    bUpdValues := {||RetLimValues( @oSay1, @oSay2, @oSay3, @oSay4 )}

    DEFINE MSDIALOG oDlg  FROM aCoors[1],aCoors[2] TO aCoors[3],aCoors[4] of oMainWnd PIXEL STYLE nOr(WS_VISIBLE,WS_POPUP)

    oLayer := FWLayer():new()
    oLayer:Init(oDlg,.F.)

    oLayer:AddLine('LIN1',10,.F.)
    oLayer:addCollumn('COL1',95, .F. ,'LIN1')
    oPanelTitulo    := oLayer:getColPanel('COL1','LIN1')
    oPanelTitulo:FreeChildren()
    TSay():New(10,10,{|| STR0001 },oPanelTitulo,,TFont():New(,,-20,.T.),,,,.T.)//"Gerenciar limites"

    oLayer:addCollumn('COL2',5, .F. ,'LIN1')
    oButtonPanelTitulo := TButton():New( 10, 10, "x", oLayer:getColPanel('COL2','LIN1'), {||oDlg:End()}, 30,10,,TFont():New(,,-20,.T.),.F.,.T.,.F.,,.F.,,,.F. )
    oButtonPanelTitulo:setCss("QPushButton{border: none}")

    oLayer:AddLine('LIN2',15,.F.)
    oLayer:AddCollumn('COL1',25, .T. ,'LIN2')
    oLayer:AddCollumn('COL2',25, .T. ,'LIN2')
    oLayer:AddCollumn('COL3',25, .T. ,'LIN2')
    oLayer:AddCollumn('COL4',25, .T. ,'LIN2')
    oLayer:AddWindow('COL1','Win1',STR0002,100,.F.,.T.,/*bClickTitle*/,'LIN2')  //'Limite Utilizado'
    oLayer:AddWindow('COL2','Win1',STR0003,100,.F.,.T.,/*bClickTitle*/,'LIN2')  //'Pendente de Aprovacao'
    oLayer:AddWindow('COL3','Win1',STR0004,100,.F.,.T.,/*bClickTitle*/,'LIN2')  //'Em Processamento'
    oLayer:AddWindow('COL4','Win1',STR0005,100,.F.,.T.,/*bClickTitle*/,'LIN2')  //'Limite Disponível'

    oPanelLimite := oLayer:GetWinPanel('COL1','Win1','LIN2')
    oPanelLimite:FreeChildren()
    oPanelPendAprov := oLayer:GetWinPanel('COL2','Win1','LIN2')
    oPanelPendAprov:FreeChildren()
    oPanelEmProcess := oLayer:GetWinPanel('COL3','Win1','LIN2')
    oPanelEmProcess:FreeChildren()
    oPanelLimDispo := oLayer:GetWinPanel('COL4','Win1','LIN2')
    oPanelLimDispo:FreeChildren()

    oLayer:AddLine('LIN3',4,.F.)
    oLayer:addCollumn('COL1',100, .T. ,'LIN3')
    TSay():New(1,5,{|| STR0006 },oLayer:getColPanel('COL1','LIN3'),,,,,,.T.) //'Caso a empresa possua mais filiais em outro ambiente esse limite também será compartilhado'

    oLayer:AddLine('LIN4',20,.F.)
    oLayer:addCollumn('COL1',100, .T. ,'LIN4')
    oLayer:AddWindow('COL1','Win1',STR0007, 100, .F., .T., /*bClickTitle*/, 'LIN4') //'Status CNPJ Cliente'

    oPanelStatCli := oLayer:GetWinPanel('COL1','Win1','LIN4')
    oPanelStatCli:FreeChildren()

    oLayer:AddLine('LIN5',51,.F.)
    oLayer:addCollumn('COL1',100, .T. ,'LIN5')
    oLayer:AddWindow('COL1','Win1',STR0008, 100, .F., .T., /*bClickTitle*/, 'LIN5') //'Histórico de solicitações de meus clientes'

    oPanelHistSol := oLayer:GetWinPanel('COL1','Win1','LIN5')
    oPanelHistSol:FreeChildren()

    nLin := oPanelLimite:nHeight/4 //Altura das janelas superiores 
    oSay1 := TSay():New( nLin, 5,{|| ''},oPanelLimite,,     oFont18,.F.,.F.,.F.,.T.,,,100,020) 
    oSay2 := TSay():New( nLin, 5,{|| ''},oPanelPendAprov,,  oFont18,.F.,.F.,.F.,.T.,,,100,020) 
    oSay3 := TSay():New( nLin, 5,{|| ''},oPanelEmProcess,,  oFont18,.F.,.F.,.F.,.T.,,,100,020) 
    oSay4 := TSay():New( nLin, 5,{|| ''},oPanelLimDispo,,   oFont18,.F.,.F.,.F.,.T.,,,100,020) 
    
    oBrwStatCli:SetOwner(oPanelStatCli)
    oBrwStatCli:SetDescription( '' )
    oBrwStatCli:SetAlias('ARA')
    oBrwStatCli:SetMenuDef('')
    oBrwStatCli:AddLegend( "ARA_STATUS == '0'", "GREEN" , STR0009) //"Ativo" 
    oBrwStatCli:AddLegend( "ARA_STATUS == '1'", "RED"   , STR0010) //"Bloqueado Crédito" 
    oBrwStatCli:AddLegend( "ARA_STATUS == '2'", "ORANGE", STR0011) //"Bloqueado Atraso" 
    oBrwStatCli:AddLegend( "ARA_STATUS == '3'", "BROWN" , STR0012) //"Cancelado" 
    oBrwStatCli:AddLegend( "ARA_STATUS == '4'", "BLACK" , STR0013) //"Bloqueado Outros" 
    oBrwStatCli:SetFilterDefault( "ARA->ARA_PRODTF == '1'" ) //Antecipa
    oBrwStatCli:DisableReport()
    oBrwStatCli:DisableConfig()
    oBrwStatCli:DisableLocate()
    oBrwStatCli:DisableSaveConfig()
    oBrwStatCli:DisableSeek()
    oBrwStatCli:DisableFilter()
    oBrwStatCli:DisableDetails()
    oBrwStatCli:SetChange( bUpdValues )
    oBrwStatCli:Activate()

    oBrwHistSol:SetOwner(oPanelHistSol)
    oBrwHistSol:SetDescription( '' )
    oBrwHistSol:SetAlias('ARC')
    oBrwHistSol:SetMenuDef('totvs.protheus.backoffice.techfin.antecipa.limits.AntecipaLimits')
    oBrwHistSol:AddLegend( "ARC_STATUS == '1'", "WHITE" , STR0014 ) //"Limite Solicitado" 
    oBrwHistSol:AddLegend( "ARC_STATUS == '2'", "GREEN" , STR0015 ) //"Limite Aprovado" 
    oBrwHistSol:AddLegend( "ARC_STATUS == '3'", "RED"   , STR0016 ) //"Limite Negado"    
    oBrwHistSol:DisableReport()
    oBrwHistSol:DisableConfig()
    oBrwHistSol:DisableSaveConfig()
	oBrwHistSol:DisableDetails()
    oBrwHistSol:Activate()

    ACTIVATE MSDIALOG oDlg CENTERED on Init(Eval(bUpdValues))

    RestArea(aAtuArea)
    
    aSize(aCoors,0)
    aSize(aAtuArea,0)
    FwFreeArray(aCoors)
    FwFreeArray(aAtuarea)
    FwFreeObj(oDlg)

Return(Nil)

/*/{Protheus.doc} MenuDef
    Menu
    @author Squad Integrações Techfin
    @since 15/08/2025
    @version 1.0
/*/
Function MenuDef() as Array
Local aRotMnu := {} as Array

    ADD OPTION aRotMnu TITLE "Incluir"    ACTION 'VIEWDEF.totvs.protheus.backoffice.techfin.antecipa.limits.AntecipaLimits' OPERATION 3 ACCESS 0
    ADD OPTION aRotMnu TITLE "Visualizar" ACTION 'totvs.protheus.backoffice.techfin.antecipa.limits.ViewLimits' OPERATION 2 ACCESS 0

Return( aRotMnu )

/*/{Protheus.doc} ModelDef
    Modelo de dados 
    @author Squad Integrações Techfin
    @since 15/08/2025
    @version 1.0
/*/
Function Modeldef() as Object
    Local oModel        := MPFormModel():New( "AntecipaLimits") as object
    Local oStructARC    := FWFormStruct(1,"ARC")                as object
    Local oEvent        := AntecipaLimits():New()               as Object

    oModel:AddFields("ModelARC",  , oStructARC , {|| .T.}/*Pre-Validacao*/,{|| .T.}/*Pos-Validacao*/,/*Carga*/)
    oModel:SetPrimaryKey({"ARC_CODCLI","ARC_LOJCLI","ARC_DTINC","ARC_HRINC"})
    oModel:SetDescription(STR0017) //"Histórico de solicitações de meus clientes"
    oModel:GetModel("ModelARC"):SetDescription(STR0018) //"Solictações de Limite do Sacado"

    oModel:InstallEvent("AntecipaLimits", /*cOwner*/, oEvent)

Return(oModel)

/*/{Protheus.doc} ViewDef
    Visualizador de dados 
    @author Squad Integrações Techfin
    @since 15/08/2025
    @version 1.0
/*/
Function ViewDef() as Object

    Local oModel     := FWLoadModel("totvs.protheus.backoffice.techfin.antecipa.limits.AntecipaLimits") as object
    Local oStructARC := FWFormStruct(2,"ARC") as object
    Local oView      := FWFormView():New()    as object

    oView:SetModel(oModel)
    
    oStructARC:RemoveField("ARC_REASON")

    oView:AddField( "ViewField" , oStructARC,'ModelARC')   
    oView:CreateHorizontalBox("CABEC",100)
    oView:SetOwnerView( "ViewField","CABEC")
    oView:EnableControlBar(.T.)  

Return oView        

/*/{Protheus.doc} ViewLimits
    Visualização dos limites do sacado e mostra clientes do grupo
    @author Squad Integrações Techfin
    @since 01/10/2025
    @version 1.0
/*/
Function ViewLimits()
    Local cCliGrupo         := ""   as Character
    Local nLimTotal         := 0    as Numeric
    Local nLimUtil          := 0    as Numeric
    Local nLimProc          := 0    as Numeric
    Local nLimDisp          := 0    as Numeric
    Local nUltLimSol        := 0    as Numeric
    Local cUltDtSol         := ""   as Character
    Local cUltStatus        := ""   as Character
    Local cQry              := ""   as Character
    Local cAlsTmp           := ""   as Character
    Local cQryAI0           := ""   as Character
    Local cQryARC           := ""   as Character
    Local cDocumentCustomer := ""   as Character
    Local cPictureDocument  := ""   as Character
    Local cSubstrQry        := ""   as Character

    Local oFont1 := TFont():New("Arial",,018,,.T.,,,,,.F.,.F.)          as Object
    Local oFont2 := TFont():New("Arial",,021,,.T.,,,,,.F.,.F.)          as Object
    Local oFont3 := TFont():New("Arial",,019,,.F.,,,,,.F.,.F.)          as Object
    Local oFont4 := TFont():New("Courier New",,018,,.F.,,,,,.F.,.F.)    as Object // Fonte monoespaçada para o campo de clientes do grupo, usando "Courier New" é possivel alinhar os campos

    Local oExecGroup    as Object
    Local oExecLimit    as Object
    Local oExecSolic    as Object
    Local oDlg          as Object
    Local oBtOk         as Object
    Local oMGet         as Object
    Local oSay1         as Object
    Local oSay2         as Object
    Local oSay3         as Object
    Local oSay4         as Object
    Local oSay5         as Object
    Local oSay6         as Object
    Local oSay7         as Object
    Local oSay8         as Object
    Local oSay9         as Object

    cSubstrQry := totvs.protheus.backoffice.fin.functions.FunctionToDb("SUBSTRING")

    cQry := "SELECT DISTINCT SA1.A1_CGC, SA1.A1_NOME, AI0.AI0_TFSTS FROM " + RetSqlName("SA1") + " SA1 " //Incluso Select Distinct para evitar duplicidade de registros
    cQry += "LEFT JOIN " + RetSqlName("AI0") + " AI0 "
    cQry += " ON " + totvs.protheus.backoffice.ngf.util.BranchRelation( {"SA1","A1_FILIAL","SA1"}, {"AI0", "AI0_FILIAL", "AI0"})
    cQry += " AND SA1.A1_COD = AI0.AI0_CODCLI "
    cQry += " AND SA1.A1_LOJA = AI0.AI0_LOJA "
    cQry += " AND AI0.D_E_L_E_T_ = ? "
    cQry += "WHERE SA1.A1_FILIAL = ? "
    cQry += " AND "+cSubstrQry+"(SA1.A1_CGC,1,8) = ? "
    cQry += " AND SA1.D_E_L_E_T_ = ? "

    oExecGroup := FwExecStatement():New(cQry)
    oExecGroup:SetString(1, " ") //AI0.D_E_L_E_T_
    oExecGroup:SetString(2, xFilial("SA1")) //SA1.A1_FILIAL
    oExecGroup:SetString(3, SubStr(Alltrim(ARC->ARC_CNPJ),1,8)) //SA1.A1_CGC
    oExecGroup:SetString(4, " ") //SA1.D_E_L_E_T_
    cAlsTmp := oExecGroup:OpenAlias()
   
    While (cAlsTmp)->(!EoF())
        cDocumentCustomer := (cAlsTmp)->A1_CGC
        
        cPictureDocument := getPicLGPD(RetGlbLGPD("A1_CGC"),cDocumentCustomer)

        cCliGrupo += Transform(cDocumentCustomer, cPictureDocument)
        cCliGrupo += Space(3)
        cCliGrupo += padr(SubStr(Alltrim((cAlsTmp)->A1_NOME), 1, 35),40)
        cCliGrupo += Space(2)
        cCliGrupo += PadR(Iif((cAlsTmp)->AI0_TFSTS == "1", "ATIVO", "INATIVO"), 10)
        cCliGrupo += CRLF
        (cAlsTmp)->(dbSkip())
    EndDo

        If !Empty(cAlsTmp) .and. Select(cAlsTmp) > 0
            (cAlsTmp)->(dbCloseArea())
        EndIf

        cQryAI0 := "SELECT AI0_TFLIMT, "
        cQryAI0 += "AI0_TFLIMU, AI0_TFLIMR, "
        cQryAI0 += "AI0_TFLIMD FROM " + RetSqlName("AI0") + " AI0 "
        cQryAI0 += "WHERE AI0_FILIAL = ? "
        cQryAI0 += "AND AI0_CODCLI = ? "
        cQryAI0 += "AND AI0_LOJA = ? "
        cQryAI0 += "AND AI0.D_E_L_E_T_ = ? "
        cQryAI0 += "ORDER BY R_E_C_N_O_ DESC"

        oExecLimit := FwExecStatement():New(ChangeQuery(cQryAI0))
        oExecLimit:SetString(1, xFilial("AI0"))
        oExecLimit:SetString(2, ARC->ARC_CODCLI)
        oExecLimit:SetString(3, ARC->ARC_LOJCLI)
        oExecLimit:SetString(4, " ")
        cAlsTmp := oExecLimit:OpenAlias()
            If !(cAlsTmp)->(EoF())
                nLimTotal := (cAlsTmp)->AI0_TFLIMT
                nLimUtil  := (cAlsTmp)->AI0_TFLIMU
                nLimProc  := (cAlsTmp)->AI0_TFLIMR
                nLimDisp  := (cAlsTmp)->AI0_TFLIMD
            EndIf
        (cAlsTmp)->(dbCloseArea())
        
        cQryARC := "SELECT ARC_LIMSOL,"
        cQryARC += "ARC_DTINC, ARC_STATUS FROM " + RetSqlName("ARC") + " ARC "
        cQryARC += "WHERE ARC_FILIAL = ? "
        cQryARC += "AND ARC_CODCLI = ? "
        cQryARC += "AND ARC_LOJCLI = ? "
        cQryARC += "AND ARC.D_E_L_E_T_ = ? "
        cQryARC += "ORDER BY ARC_DTINC DESC, "
        cQryARC += "ARC_HRINC DESC"

        oExecSolic := FwExecStatement():New(ChangeQuery(cQryARC))
        oExecSolic:SetString(1, xFilial("ARC"))
        oExecSolic:SetString(2, ARC->ARC_CODCLI)
        oExecSolic:SetString(3, ARC->ARC_LOJCLI)
        oExecSolic:SetString(4, " ")
        cAlsTmp := oExecSolic:OpenAlias()
            If !(cAlsTmp)->(EoF())
                nUltLimSol := (cAlsTmp)->ARC_LIMSOL
                cUltDtSol  := (cAlsTmp)->ARC_DTINC
                cUltStatus := (cAlsTmp)->ARC_STATUS
            EndIf
        (cAlsTmp)->(dbCloseArea())
        
        If !Empty(cUltDtSol) .and. Len(cUltDtSol) == 8
            cUltDtSol := SubStr(cUltDtSol,7,2) + "/" + SubStr(cUltDtSol,5,2) + "/" + SubStr(cUltDtSol,1,4)
        EndIf

    DEFINE MSDIALOG oDlg TITLE STR0023 FROM 000, 000 TO 530, 600 COLORS 0, 16777215 PIXEL //"Meus limites"
    @ 005, 005 SAY oSay1 PROMPT STR0024 SIZE 241, 010 OF oDlg FONT oFont2 COLORS 0, 16777215 PIXEL //"Clientes que fazem parte do grupo"
    @ 017, 005 GET oMGet VAR cCliGrupo OF oDlg FONT oFont4 MULTILINE SIZE 294, 033 COLORS 0, 16777215 READONLY HSCROLL NOBORDER PIXEL //
    @ 064, 005 SAY oSay2 PROMPT STR0025 SIZE 241, 010 OF oDlg FONT oFont1 COLORS 0, 16777215 PIXEL //"Detalhes do limite"
    @ 076, 005 SAY oSay3 PROMPT STR0026 SIZE 234, 007 OF oDlg FONT oFont1 COLORS 0, 16777215 PIXEL //"Limite atual*"
    @ 085, 005 SAY oSay4 PROMPT "R$ " + Alltrim(TransForm(nLimTotal,"@E 999,999,999,999.99")) SIZE 238, 011 OF oDlg FONT oFont1 COLORS 0, 16777215 PIXEL // Limite atual
    @ 097, 005 SAY oSay5 PROMPT STR0027 SIZE 244, 007 OF oDlg COLORS 0, 16777215 PIXEL //"*O limite atual pode sofrer alterações após análises de crédito que são realizadas periodicamente"
    @ 108, 005 SAY oSay6 PROMPT STR0036 + Alltrim(TransForm(nLimUtil,"@E 999,999,999,999.99")) SIZE 240, 009 OF oDlg FONT oFont1 COLORS 0, 16777215 PIXEL // "Limite utilizado: R$ "
    @ 120, 005 SAY oSay7 PROMPT STR0037  + Alltrim(TransForm(nLimProc,"@E 999,999,999,999.99")) SIZE 240, 009 OF oDlg FONT oFont1 COLORS 0, 16777215 PIXEL // "Antecipações em processamento: R$ "
    @ 147, 005 SAY oSay8 PROMPT STR0038  SIZE 231, 009 OF oDlg FONT oFont1 COLORS 0, 16777215 PIXEL // "Último limite solicitado: "
    @ 158, 005 SAY oSay9 PROMPT "R$ " + Alltrim(TransForm(nUltLimSol,"@E 999,999,999,999.99")) SIZE 231, 020 OF oDlg FONT oFont1 COLORS 0, 16777215 PIXEL // Último valor solicitado
    @ 167, 005 SAY STR0039 SIZE 120, 007 OF oDlg FONT oFont3 COLORS 0, 16777215 PIXEL // "Data da última solicitação: "
    @ 174, 005 SAY Alltrim(cUltDtSol) SIZE 120, 016 OF oDlg FONT oFont3 PIXEL //Novo campo, STR
    @ 167, 178 SAY STR0040 SIZE 120, 007 OF oDlg FONT oFont3 COLORS 0, 16777215 PIXEL //"Status da solicitação: "
    @ 174, 178 SAY Iif(cUltStatus=="1","EM ANÁLISE",Iif(cUltStatus=="2","APROVADO","NEGADO")) SIZE 120, 016 OF oDlg FONT oFont3 PIXEL
    @ 200, 005 SAY STR0041 SIZE 300, 016 OF oDlg FONT oFont3 PIXEL // "Para solicitar novos limites, aguarde a conclusão da última solicitação"
    @ 230, 120 BUTTON oBtOk PROMPT STR0042 Action(oDlg:End()) SIZE 100, 020 OF oDlg FONT oFont3 PIXEL  // "OK, entendi."

    ACTIVATE MSDIALOG oDlg CENTERED

    FwFreeObj(oDlg)

Return(Nil)

/*/{Protheus.doc} RetLimValues
    Retorna dados de limites da empresa posicionada no browse
    @author Squad Integrações Techfin
    @param oLimUtil  , object, tSay do limite utilizado
    @param oPendAprov, object, tSay do limite pendente aprovação
    @param oEmProcess, object, tSay da limite em processo de autorização
    @param oLimDispo , object, tSay da limite disponível
    @since 22/08/2025
    @version 1.0
/*/
Function RetLimValues( oLimUtil as object, oPendAprov as object, oEmProcess as object, oLimDispo as object )

    Local nVEmProcess := 0 as numeric
   
    If ( ARA->ARA_LTOTAL - ARA->ARA_LUTIL ) > 0
        nVEmProcess := ARA->ARA_LTOTAL - ARA->ARA_LUTIL
    EndIf
    if oLimUtil <> nil
        oLimUtil:SetText("R$ "+Transform(ARA->ARA_LUTIL, __cPicture))
        oLimUtil:CtrlRefresh()
    endIf
    if oPendAprov <> nil
        oPendAprov:SetText("R$ "+Transform(ARA->ARA_LRPREA, __cPicture))
        oPendAprov:CtrlRefresh()
    endIf
    if oEmProcess <> nil
        oEmProcess:SetText("R$ "+Transform(nVEmProcess, __cPicture))
        oEmProcess:CtrlRefresh()
    endIf
    if oLimDispo <> nil
        oLimDispo:SetText("R$ "+Transform(ARA->ARA_LDISP, __cPicture))
        oLimDispo:CtrlRefresh()
    endIf     

Return(Nil)

/*/{Protheus.doc} PrepareMessage
    Prapara a mensagem para o Antecipa - Solicitacao de Limites
    @type function 
    @author Squad Techfin
    @since 01/09/2025
    @param aCliLim, array , {{1=Filial,2=CodCli,3=LojCli,4=Limi e Solicitado}}
    @return jData, json , Json com os dados formatados para o SmartLink
/*/
Function PrepareMessage(aCliLim as array) as json

    Local jData         := JsonObject():new()                as json
    Local jCustomers    := JsonObject():new()                as json
    Local cRespondTo    := "AntecipaLimitGrantGetResponseV1" as character
    Local cCodCli       := ""                                as character
    Local cFilCLi       := ""                                as character
    Local cLojCli       := ""                                as character
    Local cDocCli       := ""                                as character
    Local nLimSol       := 0                                 as numeric
    Local aKeys         := {}                                as array
    Local cAliasTmp     := ""                                as character
    Local cQuery        := ""                                as character
    Local cStreetName   := ""                                as character
    Local cStreetNumber := ""                                as character
    Local nX            := 0                                 as numeric
    Local oExec         := Nil                               as object

    cQuery := "SELECT "
    cQuery += " SA1.A1_NOME, SA1.A1_END, SA1.A1_COMPLEM, SA1.A1_BAIRRO, SA1.A1_MUN, SA1.A1_EST, SA1.A1_CEP, SA1.A1_CGC "
    cQuery += "FROM " +RetSqlName("SA1")+ " SA1 WHERE "
    cQuery += "SA1.A1_FILIAL = ? AND "
    cQuery += "SA1.A1_COD = ? AND "
    cQuery += "SA1.A1_LOJA = ? AND "
    cQuery += "SA1.D_E_L_E_T_ = ? "

    oExec := FwExecStatement():New(ChangeQuery(cQuery))

    For nX := 1 To Len(aCliLim)
        cFilCLi := aCliLim[nX][1]
        cCodCli := aCliLim[nX][2]
        cLojCli := aCliLim[nX][3]
        nLimSol := aCliLim[nX][4]
        
        oExec:SetString(1, cFilCLi)
        oExec:SetString(2, cCodCli)
        oExec:SetString(3, cLojCli)
        oExec:SetString(4, " ")
        cAliasTmp := oExec:OpenAlias()

        if (cAliasTmp)->(!EoF())
            cDocCli := Alltrim((cAliasTmp)->A1_CGC)

            //Se já o cliente, acumula o valor do limite solicitado
            if jCustomers:hasProperty(cDocCli)
                jCustomers[cDocCli]["suggestedCoobligationLimit"] += nLimSol
            else
                cStreetNumber := trataEnd((cAliasTmp)->A1_END, 'N')
                cStreetName   := trataEnd((cAliasTmp)->A1_END, 'L')
                If Empty(cStreetNumber)
                    cStreetNumber := "SN"
                Endif

                jCustomers[cDocCli] := JsonObject():new()
                jCustomers[cDocCli]["rootDocumentNumber"]   := cDocCli
                jCustomers[cDocCli]["suggestedCoobligationLimit"] := nLimSol

                jCustomers[cDocCli]["dataToProcess"]                 := JsonObject():new()
                jCustomers[cDocCli]["dataToProcess"]["customerName"] := Alltrim((cAliasTmp)->A1_NOME)

                jCustomers[cDocCli]["dataToProcess"]["billingAddress"]                      := JsonObject():new()
                jCustomers[cDocCli]["dataToProcess"]["billingAddress"]["street"]            := Alltrim(cStreetName)
                jCustomers[cDocCli]["dataToProcess"]["billingAddress"]["streetNumber"]      := Alltrim(cStreetNumber)
                jCustomers[cDocCli]["dataToProcess"]["billingAddress"]["addressComplement"] := Alltrim((cAliasTmp)->A1_COMPLEM)
                jCustomers[cDocCli]["dataToProcess"]["billingAddress"]["district"]          := Alltrim((cAliasTmp)->A1_BAIRRO)
                jCustomers[cDocCli]["dataToProcess"]["billingAddress"]["city"]              := Alltrim((cAliasTmp)->A1_MUN)
                jCustomers[cDocCli]["dataToProcess"]["billingAddress"]["state"]             := Alltrim((cAliasTmp)->A1_EST)
                jCustomers[cDocCli]["dataToProcess"]["billingAddress"]["postalCode"]        := Alltrim((cAliasTmp)->A1_CEP)
            endIf
        endIf
        (cAliasTmp)->(dbCloseArea())
    Next nX

    jData["respondTo"]    := cRespondTo
    jData["creditGrants"] := {}
    aKeys := jCustomers:getNames()
    For nX := 1 To Len(aKeys)
        aAdd( jData["creditGrants"], jCustomers[aKeys[nX]] )
    Next nX

    oExec:Destroy()
    oExec := Nil
return jData

/*/{Protheus.doc} AntecipaLimits
    Classe responsavel por orquestrar os eventos do modelo de dados da rotina
    @author Squad TechFin
    @since 09/09/2025
    @version 1.0
/*/
Class AntecipaLimits from FWModelEvent
    Public Method new()
    Public Method ModelPosVld(oModel as object) as logical
    Public Method InTTS(oModel as object)
EndClass

/*/{Protheus.doc} new
    Metodo construtor da classe
    @author Squad TechFin
    @since 28/08/2025
    @version 1.0
 /*/
Method new() Class AntecipaLimits
Return

/*/{Protheus.doc} ModelPosVld
    Método que é chamado pelo MVC quando ocorrer as ações de pos validação do Model
    Esse evento ocorre uma vez no contexto do modelo principal.
    @author Squad Techfin
    @since 08/09/2025
    @version 1.0
    @param oModel, Objeto, Modelo de dados da rotina
    @return lRet, Logical, Define se o commit será realizado
/*/
Method ModelPosVld(oModel as object) as logical Class AntecipaLimits
    Local lRet       := .T. as logical
    Local cQry       := ""  as character
    Local nQtdSol    := 0   as numeric
    Local oExec      := nil as object

    if oModel:GetOperation() == MODEL_OPERATION_INSERT
        cQry := "SELECT COUNT(*) AS QTSOLIC "
        cQry += "FROM " +RetSqlName("ARC")+ " ARC "
        cQry += "WHERE ARC_FILIAL = ? "
        cQry += "AND SUBSTRING(ARC_CNPJ, 1, 8) = ? "
        cQry += "AND ARC_STATUS = ? "
        cQry += "AND D_E_L_E_T_ = ? "

        oExec := FwExecStatement():New(ChangeQuery(cQry))

        oExec:SetString(1,xFilial("ARC"))
        oExec:SetString(2, SubStr(oModel:GetModel("ModelARC"):GetValue("ARC_CNPJ"), 1, 8))
        oExec:SetString(3,'1') // 1=Solicitado;2=Aprovado;3=Negado
        oExec:SetString(4," ")

        nQtdSol := oExec:ExecScalar("QTSOLIC")

        If nQtdSol > 0
            lRet := .F.
            Help( '', 1, STR0022,,STR0020 + CRLF + Alltrim(Str(nQtdSol)) + STR0021, 1, 0 ) //"Inconsistência"#//"Não é possível solicitar limite para este cliente, pois já possui " + " solicitação(ões) pendente(s) de aprovação."
        EndIf

        oExec:Destroy()
        oExec := nil 
        FwFreeObj(oExec)
    endIf

Return lRet

/*/{Protheus.doc} InTTS
    Método que é chamado pelo MVC durante a gravacao do Model, no controle de transacao
    @author Squad Techfin
    @since 09/09/2025
    @version version
    @param oModel, Objeto, Modelo de dados da rotina
/*/
Method InTTS(oModel as object) Class AntecipaLimits
    Local jData   := JsonObject():new()                                 as json
    Local cFila   := "AntecipaLimitGrantExecuteRequestV1"               as character
    Local cMSGID  := ""                                                 as character
    Local oView   := FwViewActive()                                     as object
    Local cCodCli := oModel:GetModel("ModelARC"):GetValue("ARC_CODCLI") as character
    Local cLojCli := oModel:GetModel("ModelARC"):GetValue("ARC_LOJCLI") as character
    Local nLimSol := oModel:GetModel("ModelARC"):GetValue("ARC_LIMSOL") as numeric
    
    if oModel:GetOperation() == MODEL_OPERATION_INSERT
        jData  := prepareMessage({{xFilial("SA1"), cCodCli, cLojCli, nLimSol}})
        cMSGId := totvs.protheus.backoffice.techfin.util.sendSmartLink(cFila, "1", "LimitGrant", jData:toJson(), .T., ARC->ARC_MSUID,  .T., "ARC", ARC->ARC_MSUID)
        If Empty(cMSGID)
            If oView <> NIL .and. oView:IsActive()
                oView:showInsertMsg(.F.)
            Endif
            RollbackDelTran()
        EndIf
    endIf
Return

/*/{Protheus.doc} getPicLGPD
    Retorna a mascara para exibição do documento conforme LGPD
    @type function 
    @author Squad Techfin
    @since 05/01/2025
    @param lContinue, logical, Define se o documento será mascarado
    @param cDocumentCustomer, character, Documento
    @return cPictureDocument, character , mascara
/*/
Function getPicLGPD(lContinue as logical, cDocumentCustomer as character) as character
    Local cPictureDocument := "@R 999.999.999-99" as character

    If Len(Alltrim(cDocumentCustomer)) >= 14
        cPictureDocument := "@!R NN.NNN.NNN/NNNN-99"
    Endif

    If lContinue
        cPictureDocument := Replicate("*", Len(cDocumentCustomer))
    Endif
Return cPictureDocument
