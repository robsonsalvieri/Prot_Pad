#include 'tlpp-core.th'
#include "protheus.ch"
#include 'FwMvcDef.ch'
#include 'backoffice.techfin.antecipa.monitor.ch'

Static __aOnlyFields:={} as Array

NAMESPACE totvs.protheus.backoffice.techfin.antecipa.monitor
USING NAMESPACE totvs.protheus.backoffice.techfin.util

/*/{Protheus.doc} Monitor
Totvs Antecipa - Monitor

@type       Function
@author     Totvs
@since      18/07/2025
@version    P12.1.2510
/*/
Function AntecipaRequests() as Object

    Local oBrowseRequest as Object

	If !totvs.protheus.backoffice.techfin.util.IsActive('1',.T.)
        Return
    EndIf
    oBrowseRequest := FWLoadBrw("totvs.protheus.backoffice.techfin.antecipa.monitor.AntecipaRequests")

Return oBrowseRequest

/*/{Protheus.doc} BrowseDef
    Definição do browse
    
    @type  Function
    @author Squad TechFin
    @since 05/09/2025
    @version version    
/*/
Function BrowseDef() as object
    local aCol      as Array
    local nx        as numeric
    local oBrowse   as object    

    oBrowse := FWmBrowse():New()
    oBrowse:SetAlias( 'ARD' )
    oBrowse:SetDescription( STR0001 )    //"Solicitações"
    oBrowse:SetMainProc("FINA740")    
    oBrowse:SetMenuDef( 'totvs.protheus.backoffice.techfin.antecipa.monitor.AntecipaRequests' )        
    oBrowse:AddLegend("ARD_STATUS=='1'","WHITE" , STR0002)//'Em processamento'
    oBrowse:AddLegend("ARD_STATUS=='2'","GRAY"  , STR0003)//'Cancelada'
    oBrowse:AddLegend("ARD_STATUS=='3'","ORANGE", STR0004)//'Aguardando aprovação'
    oBrowse:AddLegend("ARD_STATUS=='4'","RED"   , STR0005)//'Reprovada'
    oBrowse:AddLegend("ARD_STATUS=='5'","GREEN" , STR0007)//'Finalizada'

    If Empty(__aOnlyFields)
        aCol := oBrowse:LoadColumns('ARD')
        aSize(aCol, Len(aCol)-1)
        For nX :=1 to Len(aCol)
            Aadd(__aOnlyFields, aCol[nX,12])
        Next nX
    EndIf
    oBrowse:SetOnlyFields(__aOnlyFields)
    oBrowse:Activate()

Return oBrowse

/*/{Protheus.doc} MenuDef
    Definição do menu
    
    @type  Function
    @author Squad TechFin
    @since 05/09/2025
    @version version    
/*/
Function MenuDef() as Array

    Local aRotina := {} as Array

    //Add Option aRotina Title "Pesquisar" Action "PesqBrw" Operation OP_PESQUISAR Access 0
    ADD OPTION aRotina Title STR0008 Action "VIEWDEF.totvs.protheus.backoffice.techfin.antecipa.monitor.AntecipaRequests" OPERATION 2 ACCESS 0//'Visualizar'

Return aRotina


/*/{Protheus.doc} ModelDef
    Definição do model
    
    @type  Function
    @author Squad TechFin
    @since 05/09/2025
    @version version    
/*/
Function ModelDef() as Object

    Local bStatus                               as Codeblock
    Local oModel                                as Object
    Local oStruARD  := FWFormStruct( 1, 'ARD')  as Object
    Local oStruARE  := FWFormStruct( 1, 'ARE')  as Object
    Local oEvent    := AntecipaRequests():New() as Object

    bStatus := {|| Iif(ARE->ARE_STATUS=="0",'BR_BRANCO',Iif(ARE->ARE_STATUS=="1",'BR_AMARELO',Iif(ARE->ARE_STATUS=="2",'BR_VERMELHO','BR_VERDE')))}
    oStruARE:AddField('Status','Status','CPO_STS' ,'C',15,/*nDecimal*/,/*bValid*/,/*bWhen*/,/*aValues*/,.F./*lObrigat*/,bStatus/*bInit*/,/*lKey*/,/*lNoUpd*/,.T./*lVirtual*/) // Status da grid de titulos
    
    //adiciona campos virtuais para armazenar as mensagens do smartlink que serão enviadas na gravação
    oStruARD:AddField("PreAuthorization","","PreAuthorization","M",10,0,/*bValid*/,/*When*/,/*aValues*/,.F.,{||""},/*Key*/,.F.,.T.,)
    oStruARD:AddField("LimitGrant","","LimitGrant","M",10,0,/*bValid*/,/*When*/,/*aValues*/,.F.,{||""},/*Key*/,.F.,.T.,)
    oModel := MPFormModel():New( 'AntecipaRequests', /*bPreValidacao*/, /*bPosValidacao*/, /*bCommit*/, /*bCancel*/ )    

    oModel:AddFields( 'ARDMASTER', /*cOwner*/, oStruARD)

    oModel:SetPrimaryKey({"ARD_NUM"})
    oModel:AddGrid( 'AREDETAIL', 'ARDMASTER', oStruARE, /*bLinePre*/, /*bLinePost*/, /*bPreVal*/, /*bPosVal*/, /*BLoad*/ )
    oModel:SetRelation( 'AREDETAIL', { { 'ARE_FILIAL', 'xFilial( "ARE" )' }, { 'ARE_NUM', 'ARD_NUM' } }, ARE->( IndexKey( 1 ) ) )
    oModel:SetDescription( 'Solicitação de Antecipação' )
    oModel:GetModel( 'ARDMASTER' ):SetDescription( STR0009 )//'Dados da Solicitação'
    oModel:GetModel( 'AREDETAIL' ):SetDescription( STR0010 )//'Títulos da Solicitação'

    oModel:InstallEvent("AntecipaRequests", /*cOwner*/, oEvent)
Return oModel


/*/{Protheus.doc} ViewDef
    Definição da View
    
    @type  Function
    @author Squad TechFin
    @since 05/09/2025
    @version version    
/*/
Function ViewDef() as Object

    Local oView                                 as Object
    Local oModel                                as Object
    Local oStruARD := FWFormStruct( 2, 'ARD')   as Object
    Local oStruARE := FWFormStruct( 2, 'ARE')   as Object

    oModel := FWLoadModel( 'totvs.protheus.backoffice.techfin.antecipa.monitor.AntecipaRequests' )

    oStruARE:AddField('CPO_STS' ,'01','','',Nil,'GET','@BMP',Nil,Nil,.F.,Nil,Nil,Nil,Nil,Nil,.T.)    

    oView := FWFormView():New()
    oView:SetModel( oModel )
    
    oView:AddField( 'VIEW_ARD', oStruARD, 'ARDMASTER' )
    oView:AddGrid(  'VIEW_ARE', oStruARE, 'AREDETAIL' )

    oView:SetViewProperty("AREDETAIL", "GRIDDOUBLECLICK", {{|| DbClick()}})

    oView:addUserButton( STR0016, "", {|oModel| antecipaDownloadProofTransaction(oModel)},,, {MODEL_OPERATION_VIEW}, .T.) //"Comprovante da solicitação"
    oView:addUserButton( STR0017, "", {|oModel| antecipaDownloadSlips(oModel)},,, {MODEL_OPERATION_VIEW}, .T.)            //"Download 2a. via do boleto"
    
    oView:CreateHorizontalBox( 'SUPERIOR', 30 )
    oView:CreateHorizontalBox( 'INFERIOR', 70 )
    oView:SetOwnerView( 'VIEW_ARD', 'SUPERIOR' )
    oView:SetOwnerView( 'VIEW_ARE', 'INFERIOR' )
    
    oView:AddIncrementField( 'VIEW_ARE', 'ARE_ITEM' )
    oView:EnableTitleView('VIEW_ARE', STR0010 )//'Títulos da Solicitação'
    oView:SetViewProperty( 'VIEW_ARE', "GRIDSEEK" )
    
    oView:ShowUpdateMsg(.F.)
    oView:SetCloseOnOk( {|| .T. } )

Return oView

/*/{Protheus.doc} DbClick
    Açãodo duplo click da grid, apresenta detalhes da autorização do título
    
    @type  Function
    @author Squad TechFin
    @since 05/09/2025
    @version version    
/*/
Static Function DbClick()
    Local cMotivo       as Character
    Local oModel        as Object
    Local oModal        as Object

    oModel	:= FWModelActive()
    cMotivo := oModel:GetValue("AREDETAIL","ARE_REASON")
    If Empty(cMotivo)
        cMotivo := STR0021 //"Não há informações para esse título."
    EndIF

    oModal := totvs.protheus.backoffice.techfin.util.TechfinDialog():new()
    oModal:setTitle(STR0011)//"Autorização do Item"
    oModal:setSubTitle(STR0012)//"Essa consulta apresenta o status do título dentro da Pré-autorização."
    oModal:setText(10, 10, STR0013)//"O status pode ser alterado a qualquer momento devido as condições de limite ou regras de elegibilidade."
    oModal:setText(30, 10, STR0014 + CRLF + cMotivo)//'Status do título:'
    oModal:setButton(STR0015, {|| oModal:DeActivate() })//'Fechar'
    oModal:openInfo()
    
Return .T.


/*/{Protheus.doc} AntecipaRequests
    Classe responsavel por orquestrar os eventos do modelo de dados da rotina
    @author Squad TechFin
    @since 09/09/2025
    @version 1.0
/*/
Class AntecipaRequests from FWModelEvent
    Public Method new()
    Public Method InTTS(oModel as object)
EndClass

/*/{Protheus.doc} new
    Metodo construtor da classe
    @author Squad TechFin
    @since 28/08/2025
    @version 1.0
 /*/
Method new() Class AntecipaRequests
Return


/*/{Protheus.doc} InTTS
    Método que é chamado pelo MVC durante a gravacao do Model, no controle de transacao
    @author Squad Techfin
    @since 09/09/2025
    @version version
    @param oModel, Objeto, Modelo de dados da rotina
/*/
Method InTTS(oModel as object) Class AntecipaRequests
    Local cFilaPreAut := "AntecipaPreAuthorizationExecuteRequestV1" as character
    Local cFilaLimit  := "AntecipaLimitGrantExecuteRequestV1"       as character
    Local cDataPreAut := ""                                         as character
    Local cDataLimit  := ""                                         as character
    Local cMSGID      := ""                                         as character
    Local oView       := FwViewActive()                             as object
    
    if oModel:GetOperation() == MODEL_OPERATION_INSERT
        cDataPreAut := oModel:GetModel('ARDMASTER'):GetValue("PreAuthorization")
        cDataLimit  := oModel:GetModel('ARDMASTER'):GetValue("LimitGrant")
        cMSGId := totvs.protheus.backoffice.techfin.util.sendSmartLink(cFilaPreAut, "1", "PreAuthorization", cDataPreAut, .T., ARD->ARD_MSUID)
        If !Empty(cMSGID)
            totvs.protheus.backoffice.techfin.util.sendSmartLink(cFilaLimit, "1", "LimitGrant", cDataLimit, .T.)
        Else
            oModel:SetErrorMessage(,,,, "Smartlink", "Problema de comunicação com o Smartlink", "Verifique a configuração do SmartLink e tente novamente mais tarde")
            If oView <> NIL .and. oView:IsActive()
                oView:showInsertMsg(.F.)
            Endif
            RollbackDelTran()
        EndIf
    endIf
Return


/*/{Protheus.doc} antecipaDownloadSlips
    Download da 2a. via de boletos
    @author Ronald Piscioneri
    @since 05/11/2025
    @version 1.0
/*/
Function antecipaDownloadSlips(oModel as object) as logical
    Local cDocCode := Alltrim( oModel:GetValue("AREDETAIL", "ARE_TRANSC") ) as character
    FWMsgRun(, {|| antecipaGetDocuments(1, cDocCode) }, "", STR0019) //"Baixando 2a. via do boleto, aguarde"
Return .T.

/*/{Protheus.doc} antecipaDownloadProofTransaction
    Download do comprovante da transacao
    @author Ronald Piscioneri
    @since  05/11/2025
    @version 1.0
/*/
Function antecipaDownloadProofTransaction(oModel as object) as logical
    Local cDocCode := Alltrim( oModel:GetValue("ARDMASTER", "ARD_LOTE") ) as character
    FWMsgRun(, {|| antecipaGetDocuments(2, cDocCode) }, "", STR0018) //"Baixando comprovante da solicitação, aguarde"
Return .T.

/*/{Protheus.doc} antecipaGetDocuments
    Recupera os documentos em base64
    @author Ronald Piscioneri
    @since  05/11/2025
    @version 1.0
    @param nType, Numeric, Tipo de transação ( 1-Boleto; 2-Comprovante da Transacao)
    @param cDocCode, Character, Código do documento
/*/
Function antecipaGetDocuments(nType as numeric, cDocCode as character) as logical
    local jData          := JsonObject():new()              as json
    local jInstallments  := JsonObject():new()              as json
    local jResponse      := JsonObject():new()              as json
    local cQueue         := "AntecipaDocumentGetRequestV1"  as character
    local cResponseQueue := "AntecipaDocumentGetResponseV1" as character
    local cResponse      := ""                              as character
    local cNameFile      := Lower(FwUUIDV4()) + ".pdf"      as character

    DEFAULT nType          := 1
    DEFAULT cDocCode       := ""

    If Empty(cDocCode)
        Help( ,,"STATUS",, STR0020, 1, 0 ) //"Não é possível baixar o arquivo porque a solicitação está em aprovação ou foi rejeitada."
        Return .T.
    EndIf
    // Obs.: sempre 1 boleto ou comprovante por vez, por isso "installmentNumber" esta' fixo como "1"
    jInstallments["processingType"]    := nType
    jInstallments["documentNumber"]    := Alltrim( FWSM0Util():GetSM0Data( cEmpAnt , cFilAnt, {"M0_CGC"})[1,2] )
    jInstallments["code"]              := cDocCode
    jInstallments["installmentNumber"] := 1

    jData["respondTo"]    := cResponseQueue
    jData["installments"] := { jInstallments }

    cResponse := awaitSmartLink( "1", "DocumentGet", cQueue, cResponseQueue, jData:ToJson() )

    If !Empty(cResponse)
        if  jResponse:FromJson(cResponse) == NIL .and.; 
            jResponse:hasProperty("data") .and.;
            jResponse["data"]:hasProperty("processingData") .and.;
            jResponse["data"]["processingData"]:hasProperty("document")
            processFile(cNameFile, jResponse["data"]["processingData"]["document"])
        Endif
    Endif
Return .T.
