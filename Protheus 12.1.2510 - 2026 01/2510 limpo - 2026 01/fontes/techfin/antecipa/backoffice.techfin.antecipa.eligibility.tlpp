#Include "tlpp-core.th"
#Include "Protheus.ch"
#Include "backoffice.techfin.antecipa.eligibility.ch"

NAMESPACE totvs.protheus.backoffice.techfin.antecipa.eligibility

/*/{Protheus.doc} EligibilityRules
    Totvs Antecipa 
    Exibe mensagem de regras de elegibilidade para a filial logada

    @type       Function
    @author     Totvs
    @since      27/07/2025
    @version    P12.1.2510
/*/
Function EligibilityRules()

    Local aCoors   := FWGetDialogSize(oMainWnd) as Array
    Local cMsgJson := getFormatedMessage()      as Character
    Local cAuxText := ""                        as Character
    Local cCnpj    := ""                        as Character
    Local nNx      := 0                         as Numeric
    Local nNy      := 0                         as Numeric
    Local nLin     := 5                         as Numeric
    Local jMessage                              as Json
    Local oFont16                               as Object
    Local oFont14                               as Object
    Local oFont12                               as Object
    Local oSay                                  as Object
    Local oDlg                                  as Object
    Local oLayer                                as Object
    Local oScroll                               as Object
    Local oPanelTitulo                          as Object
    Local oPanelMessage                         as Object
    Local oButtonClose                          as Object
    Local oModal                                as Object
    
    If !Empty(cMsgJson)

        oFont16  := TFont():New(,,-18,.T.,.T.)
        oFont14  := TFont():New(,,-16,.T.,.T.)
        oFont12  := TFont():New(,,-12,.T.,.F.)

        jMessage := JsonObject():new()
        jMessage:fromJson(cMsgJson)

        DEFINE MSDIALOG oDlg  FROM aCoors[1],aCoors[2] TO aCoors[3],aCoors[4] of oMainWnd PIXEL STYLE nOr(WS_VISIBLE,WS_POPUP)

        oLayer := FWLayer():new()
        oLayer:Init(oDlg,.F.)

        oLayer:AddLine('LIN1',5,.F.)
        oLayer:AddCollumn('COL1',90, .F. ,'LIN1')
        oPanelTitulo := oLayer:getColPanel('COL1','LIN1')
        oPanelTitulo:FreeChildren()
        TSay():New(nLin,10,{|| STR0001 },oPanelTitulo,,TFont():New(,,-20,.T.,.T.),,,,.T.)//"Regras de Elegebilidade

        oLayer:addCollumn('COL2',10, .F. ,'LIN1')
        oButtonClose := TButton():New( nLin, 10, "x", oLayer:getColPanel('COL2','LIN1'), {||oDlg:End()}, 30,10,,TFont():New(,,-20,.T.),.F.,.T.,.F.,,.F.,,,.F. )
        oButtonClose:setCss("QPushButton{border: none}")

        oLayer:AddLine('LIN2',95,.F.)
        oLayer:addCollumn('COL3',100, .F. ,'LIN2')
        oPanelMessage := oLayer:getColPanel('COL3','LIN2')
        oPanelMessage:FreeChildren()
        oScroll := TScrollArea():New(oPanelMessage)
        oScroll:Align := CONTROL_ALIGN_ALLCLIENT

        For nNx := 1 to Len(jMessage["message"])

            If jMessage["message"][nNx]:hasProperty("category")

                If nNx == 1
                    nLin+=10
                Else
                    nLin+=30
                EndIf

                cAuxText := jMessage["message"][nNx]["category"]
                oSay := TSay():New(nLin, 10, {||''}, oScroll,,oFont16,,,,.T.,,,400, 20,,,,,, .T.)
                oSay:SetText( cAuxText )

            EndIf

            If jMessage["message"][nNx]:hasProperty("title")

                nLin+=12
                cAuxText := jMessage["message"][nNx]["title"]
                oSay := TSay():New(nLin, 10, {|| ''}, oScroll,,oFont14,,,,.T.,,,400, 16,,,,,, .T.)
                oSay:SetText( cAuxText )

            EndIf

            If jMessage["message"][nNx]:hasProperty("items")
                For nNy := 1 to Len(jMessage["message"][nNx]["items"])
                   
                    nLin+=12
                    cAuxText := jMessage["message"][nNx]["items"][nNy]
                    oSay := TSay():New(nLin, 10, {|| ''}, oScroll,,oFont12,,,,.T.,,,400, 10,,,,,, .T.)
                    oSay:SetText( cAuxText )

                Next nNy
            EndIf

        Next nNx

        ACTIVATE MSDIALOG oDlg CENTERED 

    Else

        cCNPJ := FWSM0Util():GetSM0Data(cEmpAnt, cFilAnt, {"M0_CGC"})[1,2]
        oModal := totvs.protheus.backoffice.techfin.util.TechfinDialog():new()
        oModal:setTitle( STR0001 ) // "Regras de Elegibilidade"
        oModal:setText(20, 10, STR0002 ) //"Não há regras de elegibilidade para esta empresa/filial para exibir"       
        oModal:setText(40, 10, "CNPJ "+ Transform(cCNPJ,'@!R NN.NNN.NNN/NNNN-99'))
        oModal:openInfo()

    EndIf

    aSize(aCoors,0)
    FwFreeArray(aCoors)
    FwFreeObj(oDlg)
    FwFreeObj(oFont16)
    FwFreeObj(oFont14)
    FwFreeObj(oFont12)

Return(Nil)

/*/{Protheus.doc} getFormatedMessage()
    Totvs Antecipa 
    Obtem mensagem formatada em Json do campo ARA_FTXMSG
    @type       Function
    @author     Totvs
    @since      06/10/2025
    @version    P12.1.2510
    @obs        Exemplo da mensagem a retornar:'{"message":[{"category":"Condições comerciais para antecipação:","items":["Taxa de antecipação: 1.17% a.m. (Antecipação isenta de IOF e Tarifa de Abertura de Crédito)","Horário limite de aprovação para o pagamento no mesmo dia: 14h00","A partir de 0 dia(s) de atraso pode ocorrer o processo de efetivação da cobrança."]},{"category":"Principais regras de elegibilidade","title":"GERAIS","items":["Apenas títulos dos CNPJs emitentes cadastrados e com status Ativo no TOTVS Antecipa","Títulos que os clientes estão em atraso com os CNPJs emitentes e/ou com o TOTVS Antecipa menor do que: 5 dia(s)","NFs que não são de Prestação de Serviço","Títulos que ainda não foram antecipadas e/ou recompradas do TOTVS Antecipa e não possui uma solicitação em andamento","Títulos que o cliente não está Bloqueado no TOTVS Antecipa","Títulos que não foram emitidos em moeda estrangeira","Títulos que não foram emitidos para empresas do mesmo grupo (intercompany)."]},{"category":"CONDIÇÕES DO TÍTULO","title":"Prazos e valores","items":["Prazo mínimo de dias até o vencimento do título: 11 dia(s)","Prazo máximo de dias até o vencimento do título: 60 dia(s)","Valor mínimo da NF para antecipação: R$ 10,00","Valor mínimo das parcelas da NF: R$ 10,0"]}]}'
/*/
Function getFormatedMessage() as Character
    Local cQuery    := ""                as Character
    Local cMessage  := ""                as Character
    Local nARArecno := 0                 as Numeric
    Local aAtuArea  := GetArea()         as Array
    Local aARAArea  := ARA->(GetArea())  as Array

    cQuery :=  "SELECT R_E_C_N_O_ FROM " +RetSQLName("ARA")
    cQuery += " WHERE ARA_FILIAL = ?"
    cQuery += " AND ARA_GRPSM0 = ?"
    cQuery += " AND ARA_FILSM0 = ?"
    cQuery += " AND ARA_PRODTF = ?"
    cQuery += " AND ARA_STATUS = ?"
    cQuery += " AND D_E_L_E_T_ = ?"

    nARArecno := MPSysExecScalar(cQuery, "R_E_C_N_O_", { xFilial("ARA"), cEmpAnt, cFilAnt, "1", "0", " " })

    If nARArecno > 0 

        DbSelectArea("ARA")
        ARA->(DbSetOrder(1))
        ARA->(DbGoTo(nARArecno))
        cMessage := ARA->ARA_FTXMSG

    EndIf

    RestArea(aARAArea)
    RestArea(aAtuArea)
    aSize(aARAArea,0)
    aSize(aAtuArea,0)
    FwFreeArray(aARAArea)
    FwFreeArray(aAtuArea)

Return( cMessage )
