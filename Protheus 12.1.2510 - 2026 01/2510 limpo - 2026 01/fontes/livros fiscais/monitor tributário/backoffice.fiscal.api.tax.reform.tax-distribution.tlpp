#INCLUDE "tlpp-core.th"
#INCLUDE "tlpp-rest.th"
#INCLUDE "totvs.ch"
#INCLUDE "FISA318.ch"

Static oGetDistrib     := Nil

/*-------------------------------------------------------------
{Protheus.doc} GET TITCalculationDistributionReformFilter
API Valores de Entrada/Saída dos Impostos Legado e Reforma Tributária.
@author william.palma
@parâmetros de entrada do endpoint: cBranches, cPeriodStart, cPeriodEnd, cMovimentType
@return Nil, nulo, não tem retorno.
@since 21/10/2025
--------------------------------------------------------------*/
@get(endpoint='/api/fiscal/tax-monitor/v1/tax-reform/tax-distribution', description='API Valores de Entrada/Saída Legado/Reforma Trib.')
Function TITCalculationDistributionReformFilter()
    Local oJsResponse      := JsonObject():new() as json
    Local oQryStr          := oRest:getQueryRequest() as json
    Local aRequiredProperties as array
    //--------------------------------
    //Monta um array bidimensional com query strings que se deseja verificar se existem na requisição
    //--------------------------------
        aRequiredProperties	:= {;
            {'branches',400,; //PROPERTY //ERROR_CODE
            STR0069,;   //"O parâmetro 'branches' é obrigatório e não foi informado."
            STR0070},;  //"Informar Código de Filiais separadas por vírgula."
            {'periodStart',400,;
            STR0071,;   //"Nenhuma Data foi informada no parâmetro 'periodStart'."
            STR0072},;  //"Informar a data desejada para o período"
            {'periodEnd',400,;
            STR0073,;   //"Nenhuma Data foi informada no parâmetro 'periodEnd'."
            STR0072},;  //"Informar a data desejada para o período"
            {'movimentType',400,;
            STR0085,;   //"O parâmetro 'movimentType' é obrigatório e não foi informado."
            STR0086};   //"Informar S Para Movimentos de Saída ou E Para Movimentos de Entrada."
        }
    //--------------------------------
    // Verifica se tem parâmetros obrigatórios na requisição da API
    //--------------------------------	
    If FISA318F6HasApiRequiredProperties(aRequiredProperties, oQryStr, @oJsResponse) 
        oJsResponse := CalculationDistributionReformFilter(oQryStr['branches'] , oQryStr['periodStart'] , oQryStr['periodEnd'] , oQryStr['movimentType'])   
    EndIf  

    oRest:setKeyHeaderResponse('Content-Type', 'application/json')
    oRest:setResponse(oJsResponse)
    //--------------------------------
    // Libera os objetos
    //-------------------------------  
    FwFreeArray(aRequiredProperties) 
    FWFreeObj(oJsResponse)
    FWFreeObj(oQryStr)
Return 

/*-------------------------------------------------------------------
{Protheus.doc} GET CalculationDistributionReformFilter
Função responsável por preencher o Json com com informações referentes a valores da Reforma Tributária e Legado
@author william.palma
@parâmetros de entrada do endpoint: cBranches, cPeriodStart, cPeriodEnd, cMovimentType
@return object, Objeto contendo o JSON com resultado da query executada.
@since 21/10/2025
-------------------------------------------------------------------*/
Static Function CalculationDistributionReformFilter(cBranches as character, cPeriodStart as character, cPeriodEnd as character, cMovimentType as character)
    Local nPos         := 0                         as numeric
    Local lHasNext     := .F.                       as logical
    Local lLegacy      := .F.                       as logical
    Local oJsonResp    := JsonObject():New()        as object
    Local cAlias       := getNextAlias()            as character  

    GetCalculationDistributionReformFilter(@cAlias, cBranches, cPeriodStart, cPeriodEnd, cMovimentType)

    // Iniciando o While
    If (cAlias)->(!Eof()) 
        oJsonResp["items"] := {}
        While (cAlias)->(!Eof()) .And. (cAlias)->VALIMP > 0

            If (cAlias)->LEGADO == "T"
                lLegacy := .T.
            Else
                lLegacy := .F.
            EndIf

            aAdd( oJsonResp["items"], JsonObject():New() )
            nPos++
            oJsonResp["items"][nPos]["tax"]     :=   Alltrim((cAlias)->IMPOSTO)
            oJsonResp["items"][nPos]["value"]   :=   (cAlias)->VALIMP
            oJsonResp["items"][nPos]["legacy"]  :=   lLegacy

        (cAlias)->(DbSkip())
        EndDo
        oJsonResp["hasNext"]    := lHasNext
    EndIf       
    (cAlias)->(DBCloseArea())
Return oJsonResp:toJson()

/*--------------------------------------------------------------------
{Protheus.doc} GetCalculationDistributionReformFilter
(Responsável por executar a consulta aos campos das tabelas Fato)
@author william.palma
@parâmetros de entrada do endpoint: cAlias, cBranches, cPeriodStart, cPeriodEnd, cMovimentType
@return Nil, nulo, não tem retorno.
@since 21/10/2025
//-------------------------------------------------------------------*/
Static Function GetCalculationDistributionReformFilter(cAlias as character, cBranches as character, cPeriodStart as character, cPeriodEnd as character, cMovimentType as character)
    Local cQuery    := ''  as character

    If oGetDistrib == Nil
        cQuery := "SELECT 'IPI' AS IMPOSTO, "                               
        cQuery += "'T' AS LEGADO, "                                         
        cQuery += "COALESCE(SUM(CJX_VALIPI),0) AS VALIMP "                  
        cQuery += "FROM ? "                                                         //1                                                
        cQuery += "WHERE CJX_FILIAL IN (?) "                                        //2                              
        cQuery += "AND CJX_ENTRAD BETWEEN ? AND ? AND D_E_L_E_T_ = ? "              //3, 4, 5
        cQuery += "AND CJX_VALIPI > ? "                                             //6                                  
        cQuery += "AND CJX_TIPMOV = ? "                                             //7                                 
        cQuery += "UNION ALL "
        cQuery += "SELECT 'ISS' AS IMPOSTO, "                               
        cQuery += "'T' AS LEGADO, "                                         
        cQuery += "COALESCE(SUM(CJY_VALICM),0) AS VALIMP "                  
        cQuery += "FROM ? "                                                         //8                                                 
        cQuery += "WHERE CJY_FILIAL IN (?) "                                        //9                              
        cQuery += "AND CJY_ENTRAD BETWEEN ? AND ? AND D_E_L_E_T_ = ? "              //10, 11, 12     
        cQuery += "AND CJY_VALICM > ? "                                             //13                                   
        cQuery += "AND CJY_TIPOMO = ? "                                             //14                                    
        cQuery += "UNION ALL "
        cQuery += "SELECT 'ICMS' AS IMPOSTO, "                              
        cQuery += "'T' AS LEGADO, "                                         
        cQuery += "COALESCE(SUM(CJZ_VALICM),0) AS VALIMP "                  
        cQuery += "FROM ? "                                                         //15                                                
        cQuery += "WHERE CJZ_FILIAL IN (?) "                                        //16                               
        cQuery += "AND CJZ_ENTRAD BETWEEN ? AND ? AND D_E_L_E_T_ = ? "              //17, 18, 19      
        cQuery += "AND CJZ_VALICM > ? "                                             //20                                    
        cQuery += "AND CJZ_TIPOMO = ? "                                             //21                                    
        cQuery += "UNION ALL "
        cQuery += "SELECT 'PIS' AS IMPOSTO, "                               
        cQuery += "'T' AS LEGADO, "                                         
        cQuery += "COALESCE(SUM(CK0_VALPIS),0) AS VALIMP "                  
        cQuery += "FROM ? "                                                         //22                                               
        cQuery += "WHERE CK0_FILIAL IN (?) "                                        //23                               
        cQuery += "AND CK0_ENTRAD BETWEEN ? AND ? AND D_E_L_E_T_ = ? "              //24, 25, 26    
        cQuery += "AND CK0_VALPIS > ? "                                             //27                                    
        cQuery += "AND CK0_TIPOMO = ? "                                             //28                                    
        cQuery += "UNION ALL "
        cQuery += "SELECT 'COFINS' AS IMPOSTO, "                            
        cQuery += "'T' AS LEGADO, "                                         
        cQuery += "COALESCE(SUM(CK0_VALCOF),0) AS VALIMP "                  
        cQuery += "FROM ? "                                                         //29                                                
        cQuery += "WHERE CK0_FILIAL IN (?) "                                        //30                               
        cQuery += "AND CK0_ENTRAD BETWEEN ? AND ? AND D_E_L_E_T_ = ? "              //31, 32, 33     
        cQuery += "AND CK0_VALCOF > ? "                                             //34                                    
        cQuery += "AND CK0_TIPOMO = ? "                                             //35                                   
        cQuery += "UNION ALL "
        cQuery += "SELECT 'CBS Federal' AS IMPOSTO, "                       
        cQuery += "'F' AS LEGADO, "                                         
        cQuery += "COALESCE(SUM(CLC_VALIMP),0) AS VALIMP "                  
        cQuery += "FROM ? "                                                         //36                                                
        cQuery += "WHERE CLC_FILIAL IN (?) "                                        //37                               
        cQuery += "AND CLC_ENTRAD BETWEEN ? AND ? AND D_E_L_E_T_ = ? "              //38, 39, 40     
        cQuery += "AND CLC_VALIMP > ? "                                             //41                                    
        cQuery += "AND CLC_TIPOMO = ? "                                             //42                                    
        cQuery += "AND CLC_IMP = ? "                                                //43                                      
        cQuery += "UNION ALL "
        cQuery += "SELECT 'IBS Estadual' AS IMPOSTO, "                      
        cQuery += "'F' AS LEGADO, "                                         
        cQuery += "COALESCE(SUM(CLC_VALIMP),0) AS VALIMP "                  
        cQuery += "FROM ? "                                                         //44                                                
        cQuery += "WHERE CLC_FILIAL IN (?) "                                        //45                               
        cQuery += "AND CLC_ENTRAD BETWEEN ? AND ? AND D_E_L_E_T_ = ? "              //46, 47, 48     
        cQuery += "AND CLC_VALIMP > ? "                                             //49                                    
        cQuery += "AND CLC_TIPOMO = ? "                                             //50                                    
        cQuery += "AND CLC_IMP = ? "                                                //51                                       
        cQuery += "UNION ALL "
        cQuery += "SELECT 'IBS Municipal' AS IMPOSTO, "                     
        cQuery += "'F' AS LEGADO, "                                         
        cQuery += "COALESCE(SUM(CLC_VALIMP),0) AS VALIMP "                  
        cQuery += "FROM ? "                                                         //52                                                
        cQuery += "WHERE CLC_FILIAL IN (?) "                                        //53                               
        cQuery += "AND CLC_ENTRAD BETWEEN ? AND ? AND D_E_L_E_T_ = ? "              //54, 55, 56    
        cQuery += "AND CLC_VALIMP > ? "                                             //57                                    
        cQuery += "AND CLC_TIPOMO = ? "                                             //58                                    
        cQuery += "AND CLC_IMP = ? "                                                //59                                       
        cQuery += "UNION ALL "
        cQuery += "SELECT 'IS' AS IMPOSTO, "                                
        cQuery += "'F' AS LEGADO, "                                         
        cQuery += "COALESCE(SUM(CLC_VALIMP),0) AS VALIMP "                  
        cQuery += "FROM ? "                                                         //60                                                
        cQuery += "WHERE CLC_FILIAL IN (?) "                                        //61                               
        cQuery += "AND CLC_ENTRAD BETWEEN ? AND ? AND D_E_L_E_T_ = ? "              //62, 63, 64     
        cQuery += "AND CLC_VALIMP > ? "                                             //65                                    
        cQuery += "AND CLC_TIPOMO = ? "                                             //66                                    
        cQuery += "AND CLC_IMP = ? "                                                //67                                       
        oGetDistrib := FwExecStatement():New()
        oGetDistrib:SetQuery(ChangeQuery(cQuery))
    Endif

    If oGetDistrib != Nil
        oGetDistrib:SetUnsafe(1, FIS319SqlName("CJX"))
        oGetDistrib:SetIn(2, StrTokArr(cBranches, "," ))
        oGetDistrib:setString(3, StrTran(cPeriodStart, "-", ""))
        oGetDistrib:setString(4, StrTran(cPeriodEnd, "-", ""))
        oGetDistrib:setString(5, " ")
        oGetDistrib:SetNumeric(6, 0)
        oGetDistrib:setString(7, cMovimentType)
        oGetDistrib:SetUnsafe(8, FIS319SqlName("CJY"))
        oGetDistrib:SetIn(9, StrTokArr(cBranches, "," ))
        oGetDistrib:setString(10, StrTran(cPeriodStart, "-", ""))
        oGetDistrib:setString(11, StrTran(cPeriodEnd, "-", ""))
        oGetDistrib:setString(12, " ")
        oGetDistrib:SetNumeric(13, 0)
        oGetDistrib:setString(14, cMovimentType)
        oGetDistrib:SetUnsafe(15, FIS319SqlName("CJZ"))
        oGetDistrib:SetIn(16, StrTokArr(cBranches, "," ))
        oGetDistrib:setString(17, StrTran(cPeriodStart, "-", ""))
        oGetDistrib:setString(18, StrTran(cPeriodEnd, "-", ""))
        oGetDistrib:setString(19, " ")
        oGetDistrib:SetNumeric(20, 0)
        oGetDistrib:setString(21, cMovimentType)
        oGetDistrib:SetUnsafe(22, FIS319SqlName("CK0"))
        oGetDistrib:SetIn(23, StrTokArr(cBranches, "," ))
        oGetDistrib:setString(24, StrTran(cPeriodStart, "-", ""))
        oGetDistrib:setString(25, StrTran(cPeriodEnd, "-", ""))
        oGetDistrib:setString(26, " ")
        oGetDistrib:SetNumeric(27, 0)
        oGetDistrib:setString(28, cMovimentType)
        oGetDistrib:SetUnsafe(29, FIS319SqlName("CK0"))
        oGetDistrib:SetIn(30, StrTokArr(cBranches, "," ))
        oGetDistrib:setString(31, StrTran(cPeriodStart, "-", ""))
        oGetDistrib:setString(32, StrTran(cPeriodEnd, "-", ""))
        oGetDistrib:setString(33, " ")
        oGetDistrib:SetNumeric(34, 0)
        oGetDistrib:setString(35, cMovimentType)
        oGetDistrib:SetUnsafe(36, FIS319SqlName("CLC"))
        oGetDistrib:SetIn(37, StrTokArr(cBranches, "," ))
        oGetDistrib:setString(38, StrTran(cPeriodStart, "-", ""))
        oGetDistrib:setString(39, StrTran(cPeriodEnd, "-", ""))
        oGetDistrib:setString(40, " ")
        oGetDistrib:SetNumeric(41, 0)
        oGetDistrib:setString(42, cMovimentType)
        oGetDistrib:setString(43, "000062")
        oGetDistrib:SetUnsafe(44, FIS319SqlName("CLC"))
        oGetDistrib:SetIn(45, StrTokArr(cBranches, "," ))
        oGetDistrib:setString(46, StrTran(cPeriodStart, "-", ""))
        oGetDistrib:setString(47, StrTran(cPeriodEnd, "-", ""))
        oGetDistrib:setString(48, " ")
        oGetDistrib:SetNumeric(49, 0)
        oGetDistrib:setString(50, cMovimentType)
        oGetDistrib:setString(51, "000060")
        oGetDistrib:SetUnsafe(52, FIS319SqlName("CLC"))
        oGetDistrib:SetIn(53, StrTokArr(cBranches, "," ))
        oGetDistrib:setString(54, StrTran(cPeriodStart, "-", ""))
        oGetDistrib:setString(55, StrTran(cPeriodEnd, "-", ""))
        oGetDistrib:setString(56, " ")
        oGetDistrib:SetNumeric(57, 0)
        oGetDistrib:setString(58, cMovimentType)
        oGetDistrib:setString(59, "000061")
        oGetDistrib:SetUnsafe(60, FIS319SqlName("CLC"))
        oGetDistrib:SetIn(61, StrTokArr(cBranches, "," ))
        oGetDistrib:setString(62, StrTran(cPeriodStart, "-", ""))
        oGetDistrib:setString(63, StrTran(cPeriodEnd, "-", ""))
        oGetDistrib:setString(64, " ")
        oGetDistrib:SetNumeric(65, 0)
        oGetDistrib:setString(66, cMovimentType)
        oGetDistrib:setString(67, "000063")
        oGetDistrib:cBaseQuery := oGetDistrib:GetFixQuery()
        cAlias := oGetDistrib:OpenAlias()
    Endif
    FWFreeObj(oGetDistrib)
Return 
