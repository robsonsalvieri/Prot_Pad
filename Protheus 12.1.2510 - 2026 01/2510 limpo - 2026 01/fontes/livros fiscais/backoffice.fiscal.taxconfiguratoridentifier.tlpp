#INCLUDE "tlpp-core.th"
#INCLUDE "SPEDXDEF.CH"

namespace totvs.protheus.backoffice.fiscal.taxconfiguratoridentifier

/*/{Protheus.doc} AuxiliaryToSped
 
    Classe responsavel por auxiliar a geracao da obrigacao acessoria SPED,
    para trabalhar em conjunto com as tabelas e movimentos do Configurador de Tributos
    e substituir o uso da TES(SF4) nos pontos que forem possiveis.

    @author Denis Souza
    @since 05/06/2025
    @version 12.1.2410
/*/
Class AuxiliaryToSped

    Private Data cBranchFrom    as character
    Private Data cBranchTo      as character
    Private Data cFilASpdFT     as character
    Private Data cDtInitial     as character
    Private Data cDtFinal       as character
    Private Data cDinamycFields as character
    Private Data cMaxFields     as character
    Private Data cQry1MD5       as character
    Private Data cQry2MD5       as character
    Private Data aLisFil        as array
    Private Data aTribFilt      as array
    Private Data aTribCol       as array

    Public Method new() CONSTRUCTOR
    Public Method getTaxByPeriod()
    Public Method getSelectBranch()          as character
    Public Method getCommonTableExpression() as character
    Public Method getDinamycFields()         as character
    Public Method getCaseDinamycFields()     as character
    Public Method getFields()
    Public Method getInvoiceMessages()
    Public Method clean()

    Private Method getValidDictionary()
    Private Method formatNameCol()

EndClass

/*/{Protheus.doc} new
    
    Método construtor da classe AuxiliaryToSped

    @author Denis Souza
    @since 05/06/2025
    @version 12.1.2410
    @return Objeto da classe AuxiliaryToSped    
    /*/
Method new( aLisFil      as array      ,;
            cBranchFrom  as character  ,;
            cBranchTo    as character  ,;
            cFilASpdFT   as character  ,;
            cDtInitial   as character  ,;
            cDtFinal     as character  ,;
            alTribFilter as array       ;
) CLASS AuxiliaryToSped

    self:aLisFil     := aLisFil
    self:cBranchFrom := cBranchFrom
    self:cBranchTo   := cBranchTo
    self:cFilASpdFT  := cFilASpdFT
    self:cDtInitial  := cDtInitial
    self:cDtFinal    := cDtFinal
    self:aTribFilt   := alTribFilter
    self:aTribCol    := {}
    self:cQry1MD5    := ''
    self:cQry2MD5    := ''

Return self

/*/{Protheus.doc} getTaxByPeriod

    Necessario obter os tributos utilizados na C3J do periodo, 
    porem a C3J nao possui data para filtrar diretamente.
    Entao filtra o periodo na SFT apenas com os FT_IDTRIB <> ' '
    amarra com a C3J, para retornar os tributos distintos.

    Query executada antes do laco de repeticao para ser chamada apenas uma vez
    e identificar todos os tributos com os parametros informados na wizard.

    @author Denis Souza
    @since 05/06/2025
    @version 12.1.2410
    @return Objeto da classe AuxiliaryToSped
    /*/
Method getTaxByPeriod() CLASS AuxiliaryToSped

    Local oPrepare    as object
    Local oTmpBranch  as object
    Local nX          as numeric
    Local nTmEmp      as numeric
    Local nTmUni      as numeric
    Local nTmF2BTRIB  as numeric
    Local nTmListFil  as numeric
    Local aBind       as array
    Local aList       as array
    Local cQry        as character
    Local cAliasQry   as character
    Local cFilF2BTrib as character
    Local cCompF2B    as character
    Local cCompF2E    as character
    Local cColumn     as character
    Local cCodTribL   as character

    nTmEmp     := Len( FWSM0Layout(cEmpAnt,1) )
    nTmUni     := Len( FWSM0Layout(cEmpAnt,2) )
    nTmF2BTRIB := GetSx3Cache("F2B_TRIB", "X3_TAMANHO")
    cCompF2B   := Upper(AllTrim(FWModeAccess("F2B",1) + FWModeAccess("F2B",2) + FWModeAccess("F2B",3)))
    cCompF2E   := Upper(AllTrim(FWModeAccess("F2E",1) + FWModeAccess("F2E",2) + FWModeAccess("F2E",3)))
    aBind      := {}
    aList      := {}

    cQry := "SELECT DISTINCT ( F2E.F2E_IDTRIB || F2B.F2B_TRIB ) LEGADOTRIB " //ALIAS da coluna na CTE nao ultrapassar tamanho 10 verificar tratamento no campo

    //Livro Fiscal por Item de NF
    cQry += "FROM " + RetSqlName("SFT") + " SFT "

    //Tabela Escrituracao por item
    cQry += "INNER JOIN "
    cQry += RetSqlName("CJ3") + " CJ3 ON " //CJ3_FILIAL, CJ3_IDTGEN
    cQry += "CJ3.CJ3_FILIAL = SFT.FT_FILIAL AND CJ3.CJ3_IDTGEN = SFT.FT_IDTRIB AND CJ3.D_E_L_E_T_ = ? "
    aadd( aBind, space(1) )

    //Regra Tributária
    cQry += "INNER JOIN "
    cQry += RetSqlName("F2B") + " F2B ON " //F2B_FILIAL, F2B_REGRA, F2B_VIGINI, F2B_VIGFIM, F2B_ALTERA
    if cCompF2B == "CCC" .Or. (cCompF2B == "EEC" .And. (nTmEmp+nTmUni) == 0)
        cQry += " F2B.F2B_FILIAL = ? "
        aadd(aBind, xFilial("F2B") )
    else
        cQry += FwJoinFilial("F2B","CJ3")
    endif
    cQry += " AND F2B.F2B_REGRA = CJ3.CJ3_TRIB AND F2B.D_E_L_E_T_ = ? "
    aadd( aBind, space(1) )

    //Cadastro de Tributo
    cQry += "INNER JOIN "
    cQry += RetSqlName("F2E") + " F2E ON "
    if cCompF2E == "CCC" .Or. (cCompF2E == "EEC" .And. (nTmEmp+nTmUni) == 0)
        cQry += " F2E.F2E_FILIAL = ? "
        aadd(aBind, xFilial("F2E"))
    else
        cQry += FwJoinFilial("F2E","F2B")
    endif
    cQry += " AND F2E.F2E_TRIB = F2B.F2B_TRIB "
    cQry += "AND F2E.F2E_IDTRIB IN (?) " //filtro por tributo legado na F2C
    aadd( aBind, self:aTribFilt )
    cQry += "AND F2E.D_E_L_E_T_ = ? "
    aadd( aBind, space(1) )

    cQry += "WHERE "

    nTmListFil := len( self:aLisFil ) //array de filiais selecionadas

    //Quando a opcao de seleciona filiais = sim, sera considerado as filiais selecionadas no browse.
    if nTmListFil > 0 //Prioridade nos itens selecionados
        if nTmListFil == 1 //Se tiver apenas um selecionado fara por igualdade.
            cQry += "SFT.FT_FILIAL = ? "
            aadd(aBind, self:aLisFil[nTmListFil][2] )
        elseif nTmListFil <= 5
            for nX := 1 to nTmListFil 
                aadd(aList ,self:aLisFil[nX][2] )
            next nX
            cQry += "SFT.FT_FILIAL IN (?) "
            aadd( aBind, aList )
        else //superior a 5, criar temporaria, pois poderao haver inumeras filais no IN
            //aqui nao eh possivel fazer bind, ex retorno da temporaria SELECT TMPFIL FROM ##TMPSC03_69
            cQry += "SFT.FT_FILIAL IN (" + ::getSelectBranch(self:aLisFil, @oTmpBranch ) + ") "
        endif
    else //Caso ao contrario, se nao tiver filias selecionadas, devera considerar os campos 'Filial DE/ATE'
        if !Empty(self:cBranchTo) //Se o Ate for diferente de vazio filtrara ao menos de vazio até conteudo do Ate.
            cQry += "SFT.FT_FILIAL >= ? AND SFT.FT_FILIAL <= ? "
            aadd( aBind, self:cBranchFrom )
            aadd( aBind, self:cBranchTo   )
        else //Se De e Ateh estiverem <vazio>, nenhuma filial foi selecionada, sera considerada a filial corrente.
            cQry += "SFT.FT_FILIAL = ? "
            aadd( aBind, self:cFilASpdFT ) //xFilial("SFT") cacheado no aSPFIL[FT_]
        endif
    endif

    cQry += "AND SFT.FT_ENTRADA BETWEEN ? AND ? AND SFT.FT_IDTRIB <> ? AND SFT.D_E_L_E_T_ = ? "
    aadd( aBind, self:cDtInitial )
    aadd( aBind, self:cDtFinal )
    aadd( aBind, space(1) )
    aadd( aBind, space(1) )

    cAliasQry := GetNextAlias()

    oPrepare := FwExecStatement():New(ChangeQuery(cQry))

    For nX := 1 To Len(aBind)
        If ValType(aBind[nX]) == 'C'
            oPrepare:setString(nX, aBind[nX])
        Elseif ValType(aBind[nX]) == 'A'
            oPrepare:setIn(nX, aBind[nX])
        EndIf
    Next nX

    oPrepare:OpenAlias( cAliasQry ) //oPrepare:GetFixQuery()

    ::cDinamycFields := ''
    ::cMaxFields     := ''

	While (cAliasQry)->(!Eof())

        aadd( self:aTribCol, ( cAliasQry )->LEGADOTRIB )

        nTmTrib := len(self:aTribCol)

        cColumn := Alltrim(self:aTribCol[nTmTrib])

        //{trecho 3} Primeira Posicao F2B.F2B_TRIB SX9 C/ F2E (cadastro de tributo).
        //Tributo que foi vinculado com o ID TRIBUTO LEGADO TOTVS
        cFilF2BTrib := PadR( SubSTr(cColumn,7,6) , nTmF2BTRIB) //Tributo Legado sempre vira com 6 caracteres TM12 CMP TEMP. PEGA POSICAO 7º8º9º10º11°12°

		//ALIAS da coluna na CTE nao ultrapassar tamanho 10 verificar tratamento no campo trecho 1 e trecho 2
        self:aTribCol[nTmTrib] := cValToChar(Val(SubStr(cColumn,1,6))) + cFilF2BTrib //pega o ID Legado 000015 e reduz para 15 (Tamanho 2) concatena com Tributo(TM 6), ex: 15TRIB01

        //Retira os espaços dos campos, pois sao 2 campos com tamanho 6 e podem estar preenchidos apenas com 4 caracteres,
        //quebrando a query no apelido abaixo. ex tratamento: De "16CO F   " ---> Para "16COF"
        ::formatNameCol( nTmTrib ) //Remove tudo que não for letra e número (inclusive espaço)

        /* Importante
        Para cada Regra Tributária/Tributo serão acrescentadas 3 colunas ver {trecho 1 cDinamycFields} ver {trecho 2 cMaxFields}
        Ex: Se usar CJ2_INCIDE, CJ2_STOTNF, CJ3_IDRESC em 4 tributos multiplicara por 3 Colunas --> 12 novas colunas
        */
        cCodTribL := SubStr(Alltrim(self:aTribCol[nTmTrib]),1,2) //Cod do Tributo Legado com 2 caracteres  ,ex: 15,16,21,22,53,54

        if cCodTribL <> '53' .And. cCodTribL <> '54'
            //{trecho 1 cDinamycFields}  Importante campos na temporaria nao podem comecar com numerico
            ::cDinamycFields += "," + "IN" + self:aTribCol[nTmTrib] //IN = INCIDE ---> ex: IN21TRIB01 (Tamanho10)
    
            //Se precisar dos campos de valores, ex:
            //::cMaxFields += ",MAX(CASE WHEN F2B_TRIB = '" + cFilF2BTrib + "' THEN CJ3_VLTRIB ELSE 0 END) AS VLTRIB_" + Alltrim(self:aTribCol[nX])

            //{trecho 2 cMaxFields}
            //Importante o nome da coluna nao deve ultrapassar Tamanho 10, o compilador despreza os caractres da coluna após a decima posicao,
            //gerando falha na comparacao de conteudo nos outros metodos da classe.
            ::cMaxFields += ",MAX(CASE WHEN F2B_TRIB = '" + cFilF2BTrib + "' THEN CJ2_INCIDE ELSE ' ' END) AS " + "IN" + self:aTribCol[nTmTrib] //IN = INCIDE

        else //Tratamento ZFM 53 e 54
            ::cDinamycFields += "," + "ZM" + self:aTribCol[nTmTrib]
            ::cMaxFields += ",MAX(CASE WHEN F2B_TRIB = '" + cFilF2BTrib + "' THEN F2B_TRIB ELSE ' ' END) AS " + "ZM" + self:aTribCol[nTmTrib]
        endif

		( cAliasQry )->( DBSkip() )
	EndDo
    ( cAliasQry )->( DBCloseArea() )

	If oPrepare != Nil
		oPrepare:Destroy()
        freeObj(oPrepare)
	EndIf

    if oTmpBranch != Nil
        oTmpBranch:Delete()
        freeObj(oTmpBranch)
    endif

    aSize(aBind,0)

Return Nil

/*/{Protheus.doc} getCommonTableExpression

    Método para obter a CTE(CommonTableExpression), uma temporaria que existe apenas 
    durante a execucao de uma consulta SQL. Se existir tributos gerados pelo configurador
    de tributos (CFGTRIB) havera leftjoins com as tabelas do mesmo e a SFT.
    Caso ao contrario, ira retornar apenas a estrutura da SFT utilizada no SPEDFiscal.

    @author Denis Souza
    @since 05/06/2025
    @version 12.1.2410
    @return String do CTE
    /*/
Method getCommonTableExpression(;
    cFilSFT    as character ,;
    cSlctSFT   as character ,;
    cWreQryPri as character ,;
    aWreQryPri as Array     ,;
    aParam     as Array     ;
) as character CLASS AuxiliaryToSped

Local cQry   as character
Local nX     as numeric

//Nome para manter compatibilidade do Alias no SPEDXFUN
cQry := "WITH SFT AS ( SELECT "

//Tratatamento dos espacamentos ja que o With nao funciona no changeQuery,
//cSlctSFT contem a lista de campos da SFT que constam no SPED.
while (" " $ cSlctSFT)
    cSlctSFT := StrTran(cSlctSFT," ","")
enddo

cQry += cSlctSFT + " " + self:cMaxFields

//Livro Fiscal por Item de NF
cQry += " FROM ? SFT "
Aadd(aParam,{'U', RetSqlName("SFT")}) //mantem o mesmo padrao do fonte spedxfun

/* Importante:
    - A CJ3\F2B\CJ2 nao deve influenciar na quantidade de registros que hoje
    ja retorna da SFT no SPEDFISCAL. Sendo assim nao utilizar inner e sim left join.
    - Mesmo se nao existir tributo do CFGTRIB e nenhuma escrituracao na CJ3 para aquela tupla da SFT,
    o registro da SFT deve ficar da mesma forma anterior que o SPED Fiscal trabalhava, 
    com a mesma quantidade de registros.
    - Se nao existir dados na CJ3 para aquela tupla e posteriormente amarrar a F2B ou CJ2 
    com inner join vai reduzir o tamanho do resultset e nao deve.
*/

if len(::aTribCol) > 0 //se existir tributos adicionados do Configurador de Tributos efetuara join com as tabelas

    /* Importante:
    - Foi identificado que a regra tributária pode ser alterada múltiplas vezes (N vezes), 
    mas a lógica atual estava considerando apenas a última alteração, 
    utilizando a condição F2B.F2B_REGRA = CJ3.CJ3_TRIB AND F2B.F2B_ALTERA = 2.
    - Por isso, será necessário incluir a tabela F2D na query, 
    com o objetivo de recuperar o Código de Metadados correspondente ao Perfil de Operação (F2B_PERFOP) 
    vigente no momento da operação — e não apenas o último (F2B_ALTERA = 2).
    - Essa inclusão é essencial porque a tabela CJ3 não possui um identificador direto (ID) que represente 
    a "foto" do cenário armazenado na tabela F2B. 
    Apenas a tabela F2D possui vínculo direto com a F2B, por meio da relação F2B_ID × F2D_IDCAD.
    - O campo F2D_IDCAD armazena exatamente o ID associado à regra tributária utilizada em cada registro, 
    garantindo assim a correta associação entre a operação e a versão vigente da regra no momento em que ela foi aplicada.
    - Se existisse um ID na CJ3 que semelhante ao F2D_IDCAD que amarra com F2B_ID, nao haveria a necessidade fazer o join com a F2D.
    */

    //Tributos Genéricos Calculados
    cQry += "LEFT JOIN ? F2D ON " //F2D_FILIAL, F2D_IDREL
    cQry += "F2D.F2D_FILIAL = SFT.FT_FILIAL AND F2D.F2D_IDREL = SFT.FT_IDTRIB AND F2D.D_E_L_E_T_ = ? "
    Aadd(aParam,{'U', RetSqlName("F2D")}) //mantem o mesmo padrao do fonte spedxfun
    Aadd(aParam,{'C', space(1)})

    //Tabela Escrituracao por item
    cQry += "LEFT JOIN ? CJ3 ON " //CJ3_FILIAL, CJ3_IDTGEN
    cQry += "CJ3.CJ3_FILIAL = F2D.F2D_FILIAL AND CJ3.CJ3_IDF2D = F2D.F2D_ID AND CJ3.CJ3_IDTGEN = F2D.F2D_IDREL AND CJ3.D_E_L_E_T_ = ? "
    Aadd(aParam,{'U', RetSqlName("CJ3")}) //mantem o mesmo padrao do fonte spedxfun
    Aadd(aParam,{'C', space(1)})

    //Regra Tributária
    cQry += "LEFT JOIN ? F2B ON " //F2B_FILIAL, F2B_REGRA, F2B_ALTERA
    Aadd(aParam,{'U', RetSqlName("F2B") }) //mantem o mesmo padrao do fonte spedxfun
    cQry += "F2B.F2B_FILIAL = ? "
    aadd(aParam,{'C', xFilial("F2B",cFilSFT)})
    cQry += " AND F2B.F2B_ID = F2D.F2D_IDCAD AND F2B.D_E_L_E_T_ = ? "
    Aadd(aParam,{'C', space(1) })

    //Regra Escrituracao
    cQry += "LEFT JOIN ? CJ2 ON " // CJ2_FILIAL,CJ2_ID,CJ2_CODIGO 
    Aadd(aParam,{'U', RetSqlName("CJ2") }) //mantem o mesmo padrao do fonte spedxfun
    cQry += "CJ2.CJ2_FILIAL = ? "
    aadd(aParam,{'C', xFilial("CJ2",cFilSFT)})
    //Importante: Nao utilizar com CJ2_ALTERA = 2 pq somente pegara a ultima foto, utilizar o relacionamento CJ2.CJ2_ID = CJ3.CJ3_IDRESC que buscara o retrato da incidencia daquele momento.
    cQry += " AND CJ2.CJ2_ID = CJ3.CJ3_IDRESC AND CJ2.CJ2_CODIGO = F2B.F2B_CODESC AND CJ2.D_E_L_E_T_ = ? "
    Aadd(aParam,{'C', space(1) })
endif

//cWreQryPri foi enviado por parametro do spedxfun, adiciona os filtros do where no aParam respeitando a ordem dos adicionados no aParam acima.
cQry += cWreQryPri
for nX := 1 to len( aWreQryPri ) //S(saida) E(entrada)
    aadd( aParam, aWreQryPri[nX] )
next nX

/*
Se existir tributos adicionados no Configurador de Tributos para a competencia, efetuara os left joins 
com as tabelas do CFGTRIB e precisara de agrupamento devido as funcoes acima de agregacao ( ::cMaxFields )
*/
if len(::aTribCol) > 0
    cQry += " GROUP BY " + cSlctSFT
endif

cQry += ") " //fecha o WITH

Return cQry

/*/{Protheus.doc} getcDinamycFields

    Método para retornar o cDinamycFields get necessario senao deveria ser um atributo publico ao inves de private

    @author Denis Souza
    @since 05/06/2025
    @version 12.1.2410
    @return Objeto da classe AuxiliaryToSped
    /*/
Method getDinamycFields() as character CLASS AuxiliaryToSped
Return ::cDinamycFields

/*/{Protheus.doc} getCaseDinamycFields

    Método para retornar o tratamento de case nos campos dinamicos.

    @author Denis Souza
    @since 05/06/2025
    @version 12.1.2410
    @return Objeto da classe AuxiliaryToSped
    /*/
Method getCaseDinamycFields() as character CLASS AuxiliaryToSped

Local nX      as numeric
Local aFields as array
Local cFields as character
Local cCase   as character
Local cPfxCmp as character

cFields := self:cDinamycFields
cFields := SubStr(cFields,2,len(cFields)) //remover primeira virgula
aFields := Separa( cFields, "," )

for nX := 1 to len( aFields )
    //A primeira e segunda Posicao Indica o Prefixo do campo, ex: IN = INCIDE, ST = STOTNF, IR = IDRESC
    //A Terceira e Quarta Posicao do Campo corresponde ao ID tributo legado, ex: 15 PIS, 16COFINS, 21 ICMS, 22 IPI
    cPfxCmp := Upper(SubStr(Alltrim(aFields[nX]),1,2))

    if cPfxCmp == 'IN'
        /* Importante: Deverá inverter o contido no sped fiscal
        1=Tributado;2=Isento;3=Outros;4=Tributado e Isento;5=Tributado e Outros;6=Isento e Outros;7=Tributado, Isento e Outros
        De: (cAliasSF4)->F4_LFIPI $ "T" Para: "T" $ (cAliasSF4)->F4_LFIPI
        Pois se for TIO, o T esta contido em TIO, mas TIO nao esta contido em C
        */
        cCase += ", CASE " + aFields[nX] + " WHEN '1' THEN 'T' WHEN '2' THEN 'I' WHEN '3' THEN 'O' WHEN '4' THEN 'TI' WHEN '5' THEN 'TO' "
        cCase += "WHEN '6' THEN 'IO'  WHEN '7' THEN 'TIO' ELSE ' ' END AS " + aFields[nX]
    elseif cPfxCmp == 'ZM'
        cCase += ", CASE WHEN " + aFields[nX] + " <> ' ' THEN '1' ELSE '2' END AS " + aFields[nX]
    endif
next nX

Return cCase

/*/{Protheus.doc} clean

    Método para limpar os atributos da classe

    @author Denis Souza
    @since 05/06/2025
    @version 12.1.2410
    @return Objeto da classe AuxiliaryToSped
    /*/
Method clean() Class AuxiliaryToSped

    aSize(self:aTribFilt, 0)
    self:aTribFilt := nil

    aSize(self:aLisFil, 0)
    self:aLisFil := nil

    aSize(self:aTribCol, 0)
    self:aTribCol := nil

    self:cBranchFrom := ''
    self:cBranchTo   := ''
    self:cFilASpdFT  := ''
    self:cDtInitial  := ''
    self:cDtFinal    := ''

Return Nil

/*/{Protheus.doc} getSelectBranch

    Método para criar temporaria e nao estourar string 
    com selecao de filiais marcadas.

    @author Denis Souza
    @since 06/06/2025
    @version 12.1.2410
    @return Objeto da classe AuxiliaryToSped
    /*/
Method getSelectBranch( aLisFil as array, oTmpBranch as object ) as character Class AuxiliaryToSped

    Local cBranchsIn as character
    Local cTmpAlias  as character
    Local cIncValue  as character
    Local cTable     as character
    Local cInsert    as character
    Local nA         as numeric
    Local nTmIdsList as numeric
    Local nTmBranch	 as numeric
    Local aStruTmp   as array

	cTmpAlias  := GetNextAlias()
	nTmBranch  := FWSizeFilial()
    nTmIdsList := Len(aLisFil)
    aStruTmp   := {}

    aAdd( aStruTmp, {'TMPFIL', 'C', nTmBranch ,0 } )

    oTmpBranch := FwTemporaryTable():New( cTmpAlias )
    oTmpBranch:SetFields( aStruTmp )
    oTmpBranch:AddIndex( '01', {'TMPFIL'} )
    oTmpBranch:Create()

    cTable := oTmpBranch:GetRealName()

    cInsert := " INSERT INTO " + cTable + " (TMPFIL) "
    For nA := 1 to nTmIdsList
        cIncValue := " VALUES ('" + aLisFil[nA][2] + "') "
        TcSqlExec( cInsert + cIncValue )
    Next nA
    ( cTmpAlias )->(DbGoTop())

    If Upper(TcGetDb()) $ "MSSQL7"
        cTable := StrTran(cTable,'dbo.')
    EndIf

    cBranchsIn := "SELECT TMPFIL FROM " + cTable

Return cBranchsIn

/*/{Protheus.doc} getFields
    Método que adiciona ao array as informações dos tributos gerados via configurador fiscal
    @author Rafael Leme \ Wesley Matos
    @since 06/06/2025
    @version
    @return Nil
    /*/
Method getFields( aFields as array, cAliasSFT as character, aTribCT as array ) Class AuxiliaryToSped 
                  /*--11/2025 - Trecho removido, os campos definidos como metadados serão mantidos na TES
                    cChvIdResc as character ,;
                    cChvIdPope as character ,;
                    oHashXFil  as object    ,;
                  
                    oOperation as object    ,;
                    oBookkeep  as object 
                  ) Class AuxiliaryToSped */

    Local nY 	  := 0  as numeric
    Local cCmp    := '' as character
    Local aIDResc := {} as array
    Local aIDOper := {} as array
    Local aListB  := {} as array
    Local aListO  := {} as array


	aTribCT[LFIPI] := (cAliasSFT)->F4_LFIPI   // 01 - T/I/O/Nao/Zerado          | T=Tributado;I=Isento;O=Outros;N=Nao;Z=IPI Zerado;P=Vl.IPI Outr.ICM                                                                         
    aTribCT[LFICM] := (cAliasSFT)->F4_LFICM   // 02 - T/I/O/Nao/Zerado/Observ   | T=Tributado;I=Isento;O=Outros;N=Nao;Z=ICMS Zerado;B=Observacao
    aTribCT[IPI]   := (cAliasSFT)->F4_IPI     // 03 - Calcula IPI (SNR)?        | S=Sim;N=Nao;R=Com.Nao Atac.                                                                                                       
    aTribCT[ICM]   := (cAliasSFT)->F4_ICM 	  // 04 - Calcula ICMS (SN)?        | S=Sim;N=Nao
    aTribCT[PISDSZF] := (cAliasSFT)->F4_PISDSZF  // 05 - PIS Zona Franca    | DESCZFPIS  (Escrituração) | Alterado SpedFiscal
    aTribCT[COFDSZF] := (cAliasSFT)->F4_COFDSZF  // 06 - COFINS Zona Franca | DESCZFCOF  (Escrituração) | Alterado SpedFiscal


    //Tratamento Dinamico com os Campos da CTE.
    For nY := 1 to Len(aFields)
        cCmp := AllTrim("(cAliasSFT)->" + aFields[nY])
		cContent := Alltrim(&cCmp)
        If !Empty(cContent)
            Do Case
                Case substr(aFields[nY],3,2) == '21' //ICMS
					aTribCT[ICM] := 'S'
                    If substr(aFields[nY],1,2) == 'IN'
                        aTribCT[LFICM] := cContent
                    EndIf
                Case substr(aFields[nY],3,2) == '22' //IPI
					aTribCT[IPI] := 'S'
                    If substr(aFields[nY],1,2) == 'IN'
                        aTribCT[LFIPI] := cContent
                    EndIf
                Case substr(aFields[nY],3,2) == '53' //ZFM PIS
                    If substr(aFields[nY],1,2) == 'ZM'
                        aTribCT[PISDSZF] := cContent
                    endif
                Case substr(aFields[nY],3,2) == '54' //ZFM COF
                    If substr(aFields[nY],1,2) == 'ZM'
                        aTribCT[COFDSZF] := cContent
                    endif
            EndCase
        EndIf
	Next nY 

Return nil

/*/{Protheus.doc} getMessages
    Método que adiciona ao array as informações dos tributos gerados via configurador fiscal
    @author Rafael Leme| Carlos Pister
    @since 22/08/2025
    @version
    @return Nil
    /*/
Method getInvoiceMessages(cWreQryPri,aWreQryPri,oMsg9095,aReg0460) Class AuxiliaryToSped

    Local oPrepare      := Nil as object
    Local aBind         := {}  as array
    Local aC9095D9095   := {}  as array
    Local nI            := 0   as numeric
    Local cQuery        := ''  as character
    Local cAlias        := ''  as character
    Local cDB           := Upper(TCGetDB())  as character
    Local lRet          := .F. as logical

    Default cWreQryPri := ''
    Default aWreQryPri := {}
    Default aReg0460   := {}
    Default oMsg9095   := Nil

    lRet := ::getValidDictionary()

    If lRet 

        cQuery += "SELECT "
	    cQuery += "SFT.FT_IDTRIB "
	    cQuery += ",CK6.CK6_FINALI "
	    cQuery += ",CJL.CJL_CODMSG "
	    cQuery += ",CJ8.CJ8_DESC "
        IF "ORACLE" $ cDB
        	cQuery += ",UTL_RAW.CAST_TO_VARCHAR2(DBMS_LOB.SUBSTR(CJL.CJL_MENSG, 4000, 1)) MENSAGEM"
        ELSEIF "POSTGRES" $ cDB
        	cQuery += ",REPLACE(encode(CJL.CJL_MENSG, 'escape'), '\000', '') MENSAGEM "
        ELSE
        	cQuery += ",COALESCE(CAST(CAST(CJL.CJL_MENSG AS VARBINARY(8000)) AS VARCHAR(8000)), ' ') MENSAGEM "
        ENDIF
	    
        cQuery += "FROM " + RetSqlName("SFT") + " SFT "

        cQuery += "INNER JOIN " + RetSqlName("CKA") + " CKA ON CKA.CKA_FILIAL = SFT.FT_FILIAL "
	    cQuery += "AND CKA.CKA_IDTRIB = SFT.FT_IDTRIB "
	    cQuery += "AND CKA.D_E_L_E_T_ = ? "
        aAdd(aBind, {'C', space(1)} )

        cQuery += "INNER JOIN " + RetSqlName("CJL") + " CJL ON CJL.CJL_FILIAL = CKA.CKA_FILIAL "
	    cQuery += "AND CJL.CJL_ID = CKA.CKA_IDMSGD "
	    cQuery += "AND CJL.D_E_L_E_T_ = ? "
        aAdd(aBind, {'C', space(1)} )

        cQuery += "INNER JOIN " + RetSqlName("CK6") + " CK6 ON CK6.CK6_FILIAL = CKA.CKA_FILIAL "
	    cQuery += "AND CK6.CK6_CODIGO = CKA.CKA_CODIDE "
	    cQuery += "AND CK6.CK6_OBRACE = ? "                   
        cQuery += "AND CK6.D_E_L_E_T_ = ? "
        aAdd(aBind, {'C', '01'} ) //SPED FISCAL
        aAdd(aBind, {'C', space(1)} )

        cQuery += "INNER JOIN " + RetSqlName("CJ8") + " CJ8 ON CJ8.CJ8_FILIAL = SFT.FT_FILIAL "
	    cQuery += "AND CJ8.CJ8_CODREF = CJL.CJL_CODMSG "
	    cQuery += "AND CJ8.D_E_L_E_T_ = ? "
        aAdd(aBind, {'C', space(1)} )

        cQuery += cWreQryPri

        For nI := 1 to Len(aWreQryPri)
            aAdd(aBind, aWreQryPri[nI])
        Next nI

        cQuery += " ORDER BY SFT.FT_IDTRIB,CK6.CK6_FINALI,CJL.CJL_CODMSG "

        oPrepare := FwExecStatement():New(ChangeQuery(cQuery))

        For nI := 1 to Len(aBind)
            If aBind[nI][1] == 'C'
                oPrepare:setString(nI, aBind[nI][2])
            Elseif aBind[nI][1] == 'D'
                oPrepare:setDate(nI, aBind[nI][2])
            Endif
        Next

        cAlias := oPrepare:OpenAlias(GetNextAlias())

        If !(cAlias)->(Eof())
            While !(cAlias)->(Eof())
                If AllTrim((cAlias)->CK6_FINALI) $ '1|2'
                    aAdd(aC9095D9095, {(cAlias)->FT_IDTRIB, (cAlias)->CJL_CODMSG, AllTrim((cAlias)->MENSAGEM), AllTrim((cAlias)->MENSAGEM), AllTrim((cAlias)->CK6_FINALI) })

                    Reg0460(@aReg0460,{(cAlias)->CJL_CODMSG,AllTrim((cAlias)->MENSAGEM)})
                EndIf
                (cAlias)->(DbSkip())
            EndDo
        EndIf

        (cAlias)->(DBCloseArea())
    EndIf

    If Len(aC9095D9095) > 0 
        oMsg9095 := AToHM(aC9095D9095, 1, 0)
    Else
        oMsg9095 := tHashMap():New() //Caso o array retorne vazio, inicializa o objeto para evitar erro de nil        
    EndIf

    aC9095D9095 := Nil    
    aBind       := Nil

    If oPrepare != Nil
	    oPrepare:Destroy()
        freeObj(oPrepare)
    EndIf    

Return nil

/*/{Protheus.doc} getValidDictionary
    Método que valida o dicionário para mensagens do SPED
    @author Carlos Pister
    @since 24/10/2025
    @version
    @return Nil
    /*/
Method getValidDictionary() Class AuxiliaryToSped

    Local aArea := FWGetArea() as character
    Local lRet  := .F. as logical

    If FWAliasInDic("CJL") .And. FWAliasInDic("CJ8") .And. FWAliasInDic("CK6") .And. FWAliasInDic("CKA") 
        DbSelectArea("CK6")
        If FieldPos("CK6_OBRACE") > 0 .AND. FieldPos("CK6_FINALI") > 0
            DbSelectArea("CJ8")
            If FieldPos("CJ8_CODREF") > 0 .AND. FieldPos("CJ8_DESC") > 0
                DbSelectArea("CJL")
                If FieldPos("CJL_CODMSG") > 0 .AND. FieldPos("CJL_MENSG") > 0
                    DbSelectArea("CKA")
                    If FieldPos("CKA_CODIDE") > 0 .AND. FieldPos("CKA_IDMSGD") > 0
                        lRet := .T.
                    EndIf
                EndIf
            EndIf
        EndIf
    EndIf 

    FWRestArea(aArea)

Return lRet

/*/{Protheus.doc} formatNameCol
    Remove tudo que não for letra e número, como o apelido das colunas é baseado no cadastro do tributo
    que o usuario efetuou, e os bancos não suportam caracteres especiais após o 'AS', como espaço, vírgula, ponto, etc.
    Se fez necessario tratar a string do apelido para evitar errorlog no sped.
    @author Denis Souza
    @since  12/01/2026
    @version
    @return Nil
/*/
Method formatNameCol( nTmTrib as numeric ) Class AuxiliaryToSped

    Local n       := 0 as numeric
    Local nAte    := 0 as numeric
    Local cFormat := "" as character

    nAte := Len( self:aTribCol[nTmTrib] )

    For n := 1 To nAte
        If SubStr( self:aTribCol[nTmTrib], n, 1) $ "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
            cFormat += SubStr(self:aTribCol[nTmTrib], n, 1)
        EndIf
    Next n
    self:aTribCol[nTmTrib] := cFormat

Return Nil