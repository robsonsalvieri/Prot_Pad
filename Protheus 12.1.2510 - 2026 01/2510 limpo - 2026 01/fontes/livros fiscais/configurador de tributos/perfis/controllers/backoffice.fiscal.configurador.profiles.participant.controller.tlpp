#include 'tlpp-core.th'
#include 'backoffice.fiscal.configurador.profiles.participant.controller.ch'

#define HTTP_CODE_OK 200 // (OK): Requisição bem-sucedida.
#define HTTP_CODE_CREATED 201 // (Created): Recurso criado com sucesso.
#define HTTP_CODE_BAD_REQUEST 400 // (Bad Request): Requisição inválida ou malformada.
#define HTTP_CODE_NOT_FOUND 404 // (Not Found): Recurso não encontrado.
#define HTTP_CODE_INTERNAL_SERVER_ERROR 500 // (Internal Server Error): Erro interno do servidor.

#define BASE_URL '/api/fiscal/tax-configurator/v1/participant-profile'

namespace totvs.protheus.backoffice.fiscal.configurador.profiles.participantprofile.controller
using namespace totvs.protheus.backoffice.fiscal.configurador.profiles.participantprofile.service
using namespace totvs.protheus.backoffice.fiscal.lib
using namespace totvs.protheus.backoffice.fiscal.configurador.profiles.profileoptimizer

/*/{Protheus.doc} ParticipantProfileController
Controller para gerenciamento dos endpoints de perfil de participante.
@type class
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
/*/
class ParticipantProfileController

    private data oExceptions as object
    private data oService as object
    private data oProfileOptimizer as object
    private data jBodyRequest as json
    private data jPathParamsRequest as json
    private data jQueryParamsRequest as json
    private data nStatusCode as numeric
    private data jResponse as json
    private data aMissingFields as array

    public method new() constructor

    @post(;
        endpoint = BASE_URL,; 
        description = 'Realiza a inclusão de um perfil de participante')
    public method create()

    @put(;
        endpoint = BASE_URL + '/:code',; 
        description = 'Realiza a atualização de um perfil de participante')
    public method update()

    @delete(;
        endpoint = BASE_URL + '/:code',;
        description = 'Realiza a exclusão de um perfil de participante')
    public method delete()

    @get(;
        endpoint = BASE_URL,;
        description = 'Realiza a consulta de todos os perfis de participante')
    public method findAll()

    @get(;
        endpoint = BASE_URL + '/:code',;
        description = 'Realiza a consulta de um perfil de participante')
    public method findOne()

    @post(;
        endpoint = BASE_URL + '/participants/search/count',;
        description = 'Realiza a busca da quantidade de participantes (clientes ou fornecedores) conforme o tipo e filtros informados.')
    public method searchParticipantsCount()

    @post(;
        endpoint = BASE_URL + '/participants/search/list',;
        description = 'Realiza a busca da lista de participantes (clientes ou fornecedores) conforme o tipo e filtros informados.')
    public method searchParticipantsList()

    private method validateRequest(xData as variant, aRequiredKeys as array, lAllowEmpty as logical) as logical
    private method setErrorResponse(cMessage as character, oError as object)
    private method destroy()

endclass

/*/{Protheus.doc} ParticipantProfileController::new
Construtor da classe ParticipantProfileController.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
@return object, Instância da classe ParticipantProfileController
/*/
method new() class ParticipantProfileController

    oRest:updateKeyHeaderResponse('Content-Type','application/json; charset=utf-8')

    self:oExceptions := FisExceptions():new()
    self:oService := ParticipantProfileService():new(self:oExceptions)
    self:oProfileOptimizer := ProfileOptimizer():new()
    self:jBodyRequest := JsonObject():new()
    self:jPathParamsRequest := JsonObject():new()
    self:jQueryParamsRequest := JsonObject():new()
    self:jResponse := JsonObject():new()
    self:aMissingFields := array(0)
    self:nStatusCode := HTTP_CODE_INTERNAL_SERVER_ERROR

return self

/*/{Protheus.doc} ParticipantProfileController::create
Método para inclusão de um perfil de participante.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
/*/
method create() class ParticipantProfileController

    local lValid as logical
    local nI as numeric
    local nJ as numeric
    local jParticipant as json
    local jFilter as json
    local jFilterItem as json
    local lAllowEmpty := .F. as logical

    try
        self:jBodyRequest:fromJson(oRest:getBodyRequest())
        self:jQueryParamsRequest:fromJson(oRest:getQueryRequest():toJson())

        self:oProfileOptimizer:changeBranch(self:jQueryParamsRequest['branchCode'])

        lValid := self:validateRequest(self:jBodyRequest,{'code','description','participants'},lAllowEmpty)
        lValid := lValid .and. self:validateRequest(self:jBodyRequest['participants'],{'code','store','type'},lAllowEmpty)
        if ( lValid )
            for nI := 1 to len(self:jBodyRequest['participants'])
                jParticipant := self:jBodyRequest['participants'][nI]
                lValid := lValid .and. self:validateRequest(jParticipant['type'],{'code'},lAllowEmpty)
            next nI
        endif

        if ( lValid .and. self:jBodyRequest:hasProperty('filters') .and. ;
            valType(self:jBodyRequest['filters']) == 'A' .and. !empty(self:jBodyRequest['filters']) )
            
            for nI := 1 to len(self:jBodyRequest['filters'])
                jFilter := self:jBodyRequest['filters'][nI]

                lValid := lValid .and. self:validateRequest(jFilter,{'type','items'},lAllowEmpty) .and. ;
                    self:validateRequest(jFilter['type'],{'code'},lAllowEmpty)

                if ( lValid )
                    for nJ := 1 to len(jFilter['items'])
                        jFilterItem := jFilter['items'][nJ]

                        lAllowEmpty := .F.
                        lValid := lValid .and. self:validateRequest(jFilterItem,{'key'},lAllowEmpty)

                        lAllowEmpty := ( jFilterItem['key'] $ 'A1_COD_FR|A1_LOJA_FR|A2_COD_FR|A2_LOJA_FR' )
                        lValid := lValid .and. self:validateRequest(jFilterItem,{'value'},lAllowEmpty)
                    next nJ
                endif
            next nI
        endif

        if ( !lValid )
            throw self:oExceptions:badRequestException(STR0001) // 'Dados obrigatórios ausentes na requisição'
        endif

        self:jResponse := self:oService:create(self:jBodyRequest)

        self:nStatusCode := HTTP_CODE_CREATED
    catch oError
        self:setErrorResponse(STR0002,oError) // 'Erro ao incluir perfil de participante'
    finally
        oRest:setStatusCode(self:nStatusCode)
        oRest:setResponse(self:jResponse:toJson())

        self:oProfileOptimizer:restoreBranch()

        self:destroy()
    endtry

return

/*/{Protheus.doc} ParticipantProfileController::update
Método para atualização de um perfil de participante.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
/*/
method update() class ParticipantProfileController

    local lValid as logical
    local nI as numeric
    local nJ as numeric
    local jParticipant as json
    local jFilter as json
    local jFilterItem as json
    local lAllowEmpty := .F. as logical

    try
        self:jBodyRequest:fromJson(oRest:getBodyRequest())
        self:jPathParamsRequest:fromJson(oRest:getPathParamsRequest():toJson())
        self:jQueryParamsRequest:fromJson(oRest:getQueryRequest():toJson())

        self:oProfileOptimizer:changeBranch(self:jQueryParamsRequest['branchCode'])

        lValid := self:validateRequest(self:jBodyRequest,{'description','participants'},lAllowEmpty)
        lValid := lValid .and. self:validateRequest(self:jBodyRequest['participants'],{'action','code','store','type','key'},lAllowEmpty)
        if ( lValid )
            for nI := 1 to len(self:jBodyRequest['participants'])
                jParticipant := self:jBodyRequest['participants'][nI]
                lValid := lValid .and. self:validateRequest(jParticipant['type'],{'code'},lAllowEmpty) .and. ;
                    self:validateRequest(jParticipant['key'],{'code','store','type'},lAllowEmpty)
            next nI
        endif

        if ( lValid .and. self:jBodyRequest:hasProperty('filters') .and. ;
            valType(self:jBodyRequest['filters']) == 'A' .and. !empty(self:jBodyRequest['filters']) )
            
            for nI := 1 to len(self:jBodyRequest['filters'])
                jFilter := self:jBodyRequest['filters'][nI]

                lValid := lValid .and. self:validateRequest(jFilter,{'action','type','items'},lAllowEmpty) .and. ;
                    self:validateRequest(jFilter['type'],{'code'},lAllowEmpty)

                if ( lValid .and. jFilter['action'] $ 'update|delete' )
                    lValid := self:validateRequest(jFilter,{'id'},lAllowEmpty)
                endif

                if ( lValid )
                    for nJ := 1 to len(jFilter['items'])     
                        jFilterItem := jFilter['items'][nJ]

                        lAllowEmpty := .F.
                        lValid := lValid .and. self:validateRequest(jFilterItem,{'action','key'},lAllowEmpty)

                        lAllowEmpty := ( jFilterItem['key'] $ 'A1_COD_FR|A1_LOJA_FR|A2_COD_FR|A2_LOJA_FR' )
                        lValid := lValid .and. self:validateRequest(jFilterItem,{'value'},lAllowEmpty)

                        if ( lValid .and. jFilterItem['action'] $ 'update|delete' )
                            lValid := self:validateRequest(jFilterItem,{'id'},lAllowEmpty)
                        endif
                    next nJ
                endif
            next nI
        endif

        if ( !lValid )
            throw self:oExceptions:badRequestException(STR0001) // 'Dados obrigatórios ausentes na requisição'
        endif

        self:jResponse := self:oService:update(self:jPathParamsRequest['code'], self:jBodyRequest)

        self:nStatusCode := HTTP_CODE_OK
    catch oError
        self:setErrorResponse(STR0003,oError) // 'Erro ao atualizar perfil de participante'
    finally
        oRest:setStatusCode(self:nStatusCode)
        oRest:setResponse(self:jResponse:toJson())

        self:oProfileOptimizer:restoreBranch()

        self:destroy()
    endtry

return

/*/{Protheus.doc} ParticipantProfileController::delete
Método para exclusão de um perfil de participante.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
/*/
method delete() class ParticipantProfileController

    try
        self:jPathParamsRequest:fromJson(oRest:getPathParamsRequest():toJson())
        self:jQueryParamsRequest:fromJson(oRest:getQueryRequest():toJson())

        self:oProfileOptimizer:changeBranch(self:jQueryParamsRequest['branchCode'])        

        self:jResponse := self:oService:delete(self:jPathParamsRequest['code'])

        self:nStatusCode := HTTP_CODE_OK
    catch oError
        self:setErrorResponse(STR0004,oError) // 'Erro ao excluir perfil de participante'
    finally
        oRest:setStatusCode(self:nStatusCode)
        oRest:setResponse(self:jResponse:toJson())

        self:oProfileOptimizer:restoreBranch()

        self:destroy()
    endtry

return

