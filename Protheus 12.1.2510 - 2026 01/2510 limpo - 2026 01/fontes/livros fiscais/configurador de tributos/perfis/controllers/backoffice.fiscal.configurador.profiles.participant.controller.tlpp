Método para consulta de todos os perfis de participante.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
/*/
method findAll() class ParticipantProfileController

    try
        self:jQueryParamsRequest:fromJson(oRest:getQueryRequest():toJson())

        self:jResponse := self:oService:findAll(self:jQueryParamsRequest)

        self:nStatusCode := HTTP_CODE_OK
    catch oError
        self:setErrorResponse('',oError)
    finally
        oRest:setStatusCode(self:nStatusCode)
        oRest:setResponse(self:jResponse:toJson())

        self:destroy()
    endtry    

return

