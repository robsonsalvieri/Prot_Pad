#include 'tlpp-core.th'
#include 'backoffice.fiscal.configurador.profiles.participant.repository.ch'

static lProfStatus := F20->(fieldPos('F20_STATUS')) > 0 .and. F22->(fieldPos('F22_STATUS')) > 0

namespace totvs.protheus.backoffice.fiscal.configurador.profiles.participantprofile.repository

/*/{Protheus.doc} ParticipantProfileRepository
Repository para gerenciamento dos perfis de participante.
@type class
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
/*/
class ParticipantProfileRepository

    private data oModel as object
    private data oParticipantGrid as object
    private data oFilters as object
    private data oFilterItems as object
    private data cError as character

    public method new() constructor

    public method exists(cCode as character) as logical
    public method startModel(nOperation as numeric)
    public method endModel()
    public method hasFiltersModel() as logical
    public method setHeaderValues(cCode as character, cDescription as character)
    public method saveModel() as logical
    public method getError() as character

    public method addParticipants(aParticipants as array, cCode as character)
    public method addFilters(aFilters as array, cCode as character)
    private method addFilterItems(aItems as array, cFilterId as character)

    public method updateParticipants(aParticipants as array, cCode as character) as logical
    public method updateFilters(aFilters as array, cCode as character) as logical
    private method updateFilterItems(aItems as array) as logical

    public method findAll(cFilter as character, nPage as numeric, nPageSize as numeric, lHasNext as logical) as array

    public method getParticipantProfileData() as json
    private method getParticipantProfileStatusData() as json
    private method getParticipantsData() as array
    private method getFiltersData() as array

    public method searchParticipants(cTypeCode as character, aItems as array, cSearchType as character, nPage as numeric, nPageSize as numeric, lHasNext as logical) as variant

    public method destroy()

endclass

/*/{Protheus.doc} ParticipantProfileRepository::new
Método construtor da classe ParticipantProfileRepository.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
@return object, Instância da classe ParticipantProfileRepository
/*/
method new() class ParticipantProfileRepository
return self

/*/{Protheus.doc} ParticipantProfileRepository::exists
Método para verificar se um perfil de participante existe.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
@param cCode, character, Código do perfil de participante
@return logical, Indica se o perfil de participante existe
/*/
method exists(cCode as character) as logical class ParticipantProfileRepository

    dbSelectArea('F20')
    F20->(dbSetOrder(1)) // F20_FILIAL+F20_CODIGO+F20_TIPO

return F20->(dbSeek(fwxFilial('F20') + cCode + '02'))

/*/{Protheus.doc} ParticipantProfileRepository::startModel
Método para iniciar o modelo de dados do perfil de participante.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
@param nOperation, numeric, Tipo de operação a ser realizada (inclusão, alteração, exclusão)
/*/
method startModel(nOperation as numeric) class ParticipantProfileRepository

    self:oModel := fwLoadModel('FISA164')
    self:oParticipantGrid := self:oModel:getModel('FISA164PARTICIPANTE')
    self:oFilters := self:oModel:getModel('FISA164FILTERS')
    self:oFilterItems := self:oModel:getModel('FISA164ITEMS')

    self:oModel:setOperation(nOperation)
    self:oModel:activate()

return

/*/{Protheus.doc} ParticipantProfileRepository::endModel
Método para finalizar o modelo de dados do perfil de participante.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
/*/
method endModel() class ParticipantProfileRepository

    self:oModel:deActivate()

return

/*/{Protheus.doc} ParticipantProfileRepository::hasFiltersModel
Método para verificar se os modelos de filtros e itens de filtro existem.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 29/10/2025
@return logical, Indica se os modelos de filtros e itens de filtro existem
/*/
method hasFiltersModel() as logical class ParticipantProfileRepository
return ( self:oFilters != nil .and. self:oFilterItems != nil )

/*/{Protheus.doc} ParticipantProfileRepository::setHeaderValues
Método para definir os valores do cabeçalho do perfil de participante.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
@param cCode, character, Código do perfil de participante
@param cDescription, character, Descrição do perfil de participante
/*/
method setHeaderValues(cCode as character, cDescription as character) class ParticipantProfileRepository

    self:oModel:setValue('FISA164','F20_CODIGO', cCode)
    self:oModel:setValue('FISA164','F20_DESC', decodeUtf8(cDescription))
    self:oModel:setValue('FISA164','F20_TIPO', '02')

return

/*/{Protheus.doc} ParticipantProfileRepository::saveModel
Método para salvar o modelo de dados do perfil de participante.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
@return logical, Indica se o modelo foi salvo com sucesso
/*/
method saveModel() as logical class ParticipantProfileRepository

    local aError := {} as array

    if !( self:oModel:vldData() .and. self:oModel:commitData() )
        aError := self:oModel:getErrorMessage()

        if ( len(aError) >= 6 )
            self:cError := aError[6]
        endif

        return .F.
    endif

    fwFreeArray(aError)

return .T.

/*/{Protheus.doc} ParticipantProfileRepository::getError
Método para obter a mensagem de erro da última operação.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
@return character, Mensagem de erro da última operação
/*/
method getError() as character class ParticipantProfileRepository
return self:cError

/*/{Protheus.doc} ParticipantProfileRepository::addParticipants
Método para adicionar participantes ao perfil de participante.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
@param aParticipants, array, Array de participantes a serem adicionados
@param cCode, character, Código do perfil de participante
/*/
method addParticipants(aParticipants as array, cCode as character) class ParticipantProfileRepository

    local nI as numeric

    for nI := 1 to len(aParticipants)
        if ( nI > 1 )
            self:oParticipantGrid:addLine()
        endif

        self:oParticipantGrid:setValue('F22_CODIGO', cCode)
        self:oParticipantGrid:setValue('F22_TPPART', aParticipants[nI]['type']['code'])
        self:oParticipantGrid:setValue('F22_CLIFOR', aParticipants[nI]['code'])
        self:oParticipantGrid:setValue('F22_LOJA', aParticipants[nI]['store'])

        if ( lProfStatus )
            self:oParticipantGrid:setValue('F22_STATUS', aParticipants[nI]['status']['code'])
        endif
    next nI

return

/*/{Protheus.doc} ParticipantProfileRepository::addFilters
Método para adicionar filtros ao perfil de participante.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
@param aFilters, array, Array de filtros a serem adicionados
@param cCode, character, Código do perfil de participante
/*/
method addFilters(aFilters as array, cCode as character) class ParticipantProfileRepository

    local nI as numeric
    local cFilterId as character

    for nI := 1 to len(aFilters)
        if ( nI > 1 )
            self:oFilters:addLine()
        endif

        cFilterId := FWUUIDV4(.T.)

        self:oFilters:setValue('CKJ_ID', cFilterId)
        self:oFilters:setValue('CKJ_CODIGO', cCode)
        self:oFilters:setValue('CKJ_TIPOPF', '02')
        self:oFilters:setValue('CKJ_TIPO', aFilters[nI]['type']['code'])

        self:addFilterItems(aFilters[nI]['items'], cFilterId)
    next nI

return

/*/{Protheus.doc} ParticipantProfileRepository::addFilterItems
Método para adicionar itens a um filtro do perfil de participante.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
@param aItems, array, Array de itens a serem adicionados ao filtro
@param cFilterId, character, ID do filtro ao qual os itens pertencem
/*/
method addFilterItems(aItems as array, cFilterId as character) class ParticipantProfileRepository

    local nI as numeric

    for nI := 1 to len(aItems)
        if ( nI > 1 )
            self:oFilterItems:addLine()
        endif

        self:oFilterItems:setValue('CKK_ID', FWUUIDV4(.T.))
        self:oFilterItems:setValue('CKK_IDFILT', cFilterId)
        self:oFilterItems:setValue('CKK_CHAVE', decodeUtf8(aItems[nI]['key']))
        self:oFilterItems:setValue('CKK_VALOR', decodeUtf8(aItems[nI]['value']))
    next nI

return

/*/{Protheus.doc} ParticipantProfileRepository::updateParticipants
Método para atualizar participantes do perfil de participante.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
@param aParticipants, array, Array de participantes a serem atualizados
@param cCode, character, Código do perfil de participante
@return logical, Indica se a operação foi bem-sucedida ou não
/*/
method updateParticipants(aParticipants as array, cCode as character) as logical class ParticipantProfileRepository

    local nI as numeric
    local aSeek as array
    local cAction as character

    for nI := 1 to len(aParticipants)
        cAction := aParticipants[nI]['action']

        do case
            case ( cAction == 'insert' )
                self:oParticipantGrid:addLine()
                self:oParticipantGrid:setValue('F22_CODIGO', cCode)

            case ( cAction == 'update' .or. cAction == 'delete' )
                aSeek := array(3)
                aSeek[1] := {'F22_TPPART',aParticipants[nI]['key']['type']}
                aSeek[2] := {'F22_CLIFOR',aParticipants[nI]['key']['code']}
                aSeek[3] := {'F22_LOJA',aParticipants[nI]['key']['store']}

                if ( !self:oParticipantGrid:seekLine(aSeek) )
                    self:cError := STR0001 + '. ' // 'Item do Perfil de participante não localizado'
                    self:cError += STR0002 + ': ' + aParticipants[nI]['key']['type'] + '. ' // 'Tipo'
                    self:cError += STR0003 + ': ' + aParticipants[nI]['key']['code'] + '. ' // 'Cliente/Fornecedor'
                    self:cError += STR0004 + ': ' + aParticipants[nI]['key']['store'] + '. ' // 'Loja'
                    fwFreeArray(aSeek)
                    return .F.
                endif

                fwFreeArray(aSeek)
        endcase

        if ( cAction == 'insert' .or. cAction == 'update' )
            self:oParticipantGrid:setValue('F22_TPPART', aParticipants[nI]['type']['code'])
            self:oParticipantGrid:setValue('F22_CLIFOR', aParticipants[nI]['code'])
            self:oParticipantGrid:setValue('F22_LOJA', aParticipants[nI]['store'])

            if ( lProfStatus )
                self:oParticipantGrid:setValue('F22_STATUS', aParticipants[nI]['status']['code'])
            endif
        elseif ( cAction == 'delete' )
            self:oParticipantGrid:deleteLine()
        endif
    next nI

return .T.

/*/{Protheus.doc} ParticipantProfileRepository::updateFilters
Método para atualizar filtros do perfil de participante.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
@param aFilters, array, Array de filtros a serem atualizados
@param cCode, character, Código do perfil de participante
@return logical, Indica se a operação foi bem-sucedida ou não
/*/
method updateFilters(aFilters as array, cCode as character) as logical class ParticipantProfileRepository

    local nI as numeric
    local nJ as numeric
    local cAction as character
    local aSeek as array
    local lHasItems as logical

    for nI := 1 to len(aFilters)
        cAction := aFilters[nI]['action']

        do case
            case ( cAction == 'insert' )
                aSeek := array(3)
                aSeek[1] := {'CKJ_CODIGO',cCode}
                aSeek[2] := {'CKJ_TIPOPF','02'}
                aSeek[3] := {'CKJ_TIPO',aFilters[nI]['type']['code']}

                if ( !self:oFilters:seekLine(aSeek) )
                    if ( !self:oFilters:isEmpty() )
                        self:oFilters:addLine()
                    endif

                    self:oFilters:setValue('CKJ_ID', FWUUIDV4(.T.))
                    self:oFilters:setValue('CKJ_CODIGO', cCode)
                    self:oFilters:setValue('CKJ_TIPOPF', '02')
                    self:oFilters:setValue('CKJ_TIPO', aFilters[nI]['type']['code'])
                endif

            case ( cAction == 'update' .or. cAction == 'delete' )
                aSeek := array(1)
                aSeek[1] := {'CKJ_ID',aFilters[nI]['id']}

                if ( !self:oFilters:seekLine(aSeek) )
                    self:cError := STR0005 + '. ' // 'Filtro do Perfil de participante não localizado'
                    self:cError += STR0006 + ': ' + aFilters[nI]['id'] + '. ' // 'Id do filtro'
                    fwFreeArray(aSeek)
                    return .F.
                endif
        endcase

        fwFreeArray(aSeek)

        if ( cAction == 'insert' .or. cAction == 'update' )
            if ( !self:updateFilterItems(aFilters[nI]['items']) )
                return .F.
            endif
        elseif ( cAction == 'delete' )
            self:oFilters:deleteLine()
        endif
    next nI

    for nI := 1 to self:oFilters:length()
        self:oFilters:goLine(nI)

        if ( !self:oFilters:isDeleted() )
            lHasItems := .F.

            for nJ := 1 to self:oFilterItems:length()
                self:oFilterItems:goLine(nJ)

                if ( !self:oFilterItems:isDeleted() )
                    lHasItems := .T.
                    exit
                endif
            next nJ

            if ( !lHasItems )
                self:oFilters:deleteLine()
            endif
        endif
    next nI

return .T.

/*/{Protheus.doc} ParticipantProfileRepository::updateFilterItems
Método para atualizar itens de um filtro do perfil de participante.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
@param aItems, array, Array de itens do filtro a serem atualizados
@return logical, Indica se a operação foi bem-sucedida ou não
/*/
method updateFilterItems(aItems as array) as logical class ParticipantProfileRepository

    local nI as numeric
    local cAction as character
    local aSeek as array

    for nI := 1 to len(aItems)
        cAction := aItems[nI]['action']

        do case
            case ( cAction == 'insert' )
                aSeek := array(2)
                aSeek[1] := {'CKK_CHAVE',decodeUtf8(aItems[nI]['key'])}
                aSeek[2] := {'CKK_VALOR',decodeUtf8(aItems[nI]['value'])}

                if ( !self:oFilterItems:seekLine(aSeek) )
                    if ( !self:oFilterItems:isEmpty() )
                        self:oFilterItems:addLine()
                    endif

                    self:oFilterItems:setValue('CKK_ID', FWUUIDV4(.T.))
                    self:oFilterItems:setValue('CKK_IDFILT', self:oFilters:getValue('CKJ_ID'))
                endif

            case ( cAction == 'update' .or. cAction == 'delete' )
                aSeek := array(1)
                aSeek[1] := {'CKK_ID',aItems[nI]['id']}

                if ( !self:oFilterItems:seekLine(aSeek) )
                    self:cError := STR0007 + '. ' // 'Item do filtro do Perfil de participante não localizado'
                    self:cError += STR0006 + ': ' + self:oFilters:getValue('CKJ_ID') + '. ' // 'Id do filtro'
                    self:cError += STR0008 + ': ' + aItems[nI]['id'] + '. ' // 'Id do item do filtro'
                    fwFreeArray(aSeek)
                    return .F.
                endif
        endcase

        fwFreeArray(aSeek)

        if ( cAction == 'insert' .or. cAction == 'update' )
            self:oFilterItems:setValue('CKK_CHAVE', decodeUtf8(aItems[nI]['key']))
            self:oFilterItems:setValue('CKK_VALOR', decodeUtf8(aItems[nI]['value']))
        elseif ( cAction == 'delete' )
            self:oFilterItems:deleteLine()
        endif
    next nI

return .T.

/*/{Protheus.doc} ParticipantProfileRepository::findAll
Método para consulta de todos os perfis de participante.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
@param cFilter, character, Filtro de pesquisa
@param nPage, numeric, Número da página
@param nPageSize, numeric, Tamanho da página
@param lHasNext, logical, Indica se há próxima página
@param lEnableFilters, logical, Indica se os filtros de status serão habilitados
@return array, Array com os perfis de participante encontrados
/*/
method findAll(cFilter as character, nPage as numeric, nPageSize as numeric, lHasNext as logical, lEnableFilters as logical) as array class ParticipantProfileRepository

    local aBind := {} as array
    local aResult := {} as array
    local nI as numeric
    local cQuery as character
    local cFields as character
    local cDefaultStatusCode := getParStCode('MANUAL') as character
    local cDefaultStatusDescription := capital(strTran(getParStDesc(cDefaultStatusCode),'_',' ')) as character
    local cStatusCode as character
    local cStatusDescription as character
    local cAlias as character
    local oStatement as object
    local nCount as numeric
    local nInitial as numeric
    local nFinal as numeric
    local cCompanyCode := fwGrpCompany() as character

	nInitial := ( ( nPage - 1 ) * nPageSize ) + 1
	nFinal := ( nPage * nPageSize ) + 1

    cFields := valtoSql(cDefaultStatusCode) + ' AS F20_STATUS, F20.F20_FILIAL, F20.F20_CODIGO, F20.F20_DESC'
    if ( lProfStatus )
        cFields := 'F20.F20_STATUS, F20.F20_FILIAL, F20.F20_CODIGO, F20.F20_DESC'
    endif

    cQuery := ' SELECT F20_STATUS, F20_FILIAL, F20_CODIGO, F20_DESC '
    cQuery += ' FROM ( '
    cQuery += '     SELECT ROW_NUMBER() OVER(ORDER BY F20.F20_FILIAL, F20.F20_CODIGO) LINE_NUMBER, '
    cQuery += '         ? '
    cQuery += '     FROM ' + retSqlName('F20') + ' F20 '
    cQuery += '     WHERE F20.F20_TIPO = ? '

    aadd(aBind, {'U', cFields})
    aadd(aBind, {'C', '02'})

    if ( !empty(cFilter) )
        cQuery += '         AND ( '
        cQuery += '             UPPER(F20.F20_FILIAL) LIKE ? OR '
        cQuery += '             UPPER(F20.F20_CODIGO) LIKE ? OR '
        cQuery += '             UPPER(F20.F20_DESC) LIKE ? '
        cQuery += '         ) '

        aadd(aBind, {'C', cFilter})
        aadd(aBind, {'C', cFilter})
        aadd(aBind, {'C', cFilter})
    endif

    cQuery += '         AND F20.D_E_L_E_T_ = ? '
    cQuery += ' ) F20 '
    cQuery += ' WHERE LINE_NUMBER BETWEEN ? AND ? '

    aadd(aBind, {'C', ' '})
    aadd(aBind, {'N', nInitial})
    aadd(aBind, {'N', nFinal})

    oStatement := fwExecStatement():new(changeQuery(cQuery))

    for nI := 1 to len(aBind)
        do case
            case ( aBind[nI][1] == 'C' )
                oStatement:setString(nI, aBind[nI][2])
            case ( aBind[nI][1] == 'N' )
                oStatement:setNumeric(nI, aBind[nI][2])
            case ( aBind[nI][1] == 'U' )
                oStatement:setUnsafe(nI, aBind[nI][2])
        endcase
    next nI

    cAlias := oStatement:openAlias()

    while !(cAlias)->(eof()) .and. nCount < nPageSize
        nCount++

        cStatusCode := cDefaultStatusCode
        cStatusDescription := cDefaultStatusDescription

        if ( !empty((cAlias)->F20_STATUS) )
            cStatusCode := (cAlias)->F20_STATUS
            cStatusDescription := capital(strTran(getParStDesc(cStatusCode),'_',' '))
        endif

        aadd(aResult,;
            {;
                'company': cCompanyCode,;
                'branch': fwxFilial('F20',(cAlias)->F20_FILIAL,'E','E','E'),;
                'code': (cAlias)->F20_CODIGO,;
                'description': allTrim(fwHttpEncode((cAlias)->F20_DESC)),;
                'status': {;
                    'code': cStatusCode,;
                    'description': cStatusDescription;
                };
            };
        )

        (cAlias)->(dbSkip())
    enddo

    lHasNext := !(cAlias)->(eof())
    
    (cAlias)->(dbCloseArea())

    lEnableFilters := lProfStatus

    oStatement:destroy()
    fwFreeObj(oStatement)

    fwFreeArray(aBind)

return aResult

/*/{Protheus.doc} ParticipantProfileRepository::getParticipantProfileData
Método para obter os dados completos do perfil de participante em formato JSON.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
@return json, Dados completos do perfil de participante em formato JSON
/*/
method getParticipantProfileData() as json class ParticipantProfileRepository
return;
    {;
        'code': self:oModel:getValue('FISA164','F20_CODIGO'),;
        'description': allTrim(fwHttpEncode(self:oModel:getValue('FISA164','F20_DESC'))),;
        'status': self:getParticipantProfileStatusData(),;
        'participants': self:getParticipantsData(),;
        'filters': self:getFiltersData();
    }

/*/{Protheus.doc} ParticipantProfileRepository::getParticipantProfileStatusData
Método para obter os dados de status do perfil de participante.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 29/10/2025
@return json, Dados de status do perfil de participante
/*/
method getParticipantProfileStatusData() as json class ParticipantProfileRepository

    local cDefaultStatusCode := getParStCode('MANUAL') as character
    local cStatusCode := cDefaultStatusCode as character
    local jStatus as json

    if ( lProfStatus )
        cStatusCode := self:oModel:getValue('FISA164','F20_STATUS')
    endif

    jStatus := ;
        {;
            'code': cStatusCode,;
            'description': capital(strTran(getParStDesc(cStatusCode),'_',' '));
        }    

return jStatus

/*/{Protheus.doc} ParticipantProfileRepository::getParticipantsData
Método para obter os dados dos participantes do perfil de participante.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 29/10/2025
@return array, Dados dos participantes do perfil de participante
/*/
method getParticipantsData() as array class ParticipantProfileRepository

    local aParticipants := {} as array
    local nI as numeric
    local cTypeDescription as character
    local cDefaultStatusCode := getParStCode('MANUAL') as character
    local cDefaultStatusDescription := capital(strTran(getParStDesc(cDefaultStatusCode),'_',' ')) as character
    local cStatusCode as character
    local cStatusDescription as character

    for nI := 1 to self:oParticipantGrid:length()
        self:oParticipantGrid:goLine(nI)

        if ( !self:oParticipantGrid:isDeleted() )
            cTypeDescription := STR0009 // 'Fornecedor'
            
            if ( self:oParticipantGrid:getValue('F22_TPPART') == '2' )
                cTypeDescription := STR0010 // 'Cliente'
            endif

	        cStatusCode := cDefaultStatusCode
            cStatusDescription := cDefaultStatusDescription

            if ( lProfStatus )
                if ( !empty(self:oParticipantGrid:getValue('F22_STATUS')) )
                    cStatusCode := self:oParticipantGrid:getValue('F22_STATUS')
                    cStatusDescription := capital(strTran(getParStDesc(cStatusCode),'_',' '))
                endif
            endif

            aadd(aParticipants,;
                {;
                    'code': self:oParticipantGrid:getValue('F22_CLIFOR'),;
                    'store': self:oParticipantGrid:getValue('F22_LOJA'),;
                    'name': allTrim(fwHttpEncode(self:oParticipantGrid:getValue('F22_RAZSOC'))),;            
                    'type': {;
                        'code': self:oParticipantGrid:getValue('F22_TPPART'),;
                        'description': cTypeDescription;
                    },;
                    'status': {;
                        'code': cStatusCode,;
                        'description': cStatusDescription;
                    },;                    
                    'key': {;
                        'type': self:oParticipantGrid:getValue('F22_TPPART'),;
                        'code': self:oParticipantGrid:getValue('F22_CLIFOR'),;
                        'store': self:oParticipantGrid:getValue('F22_LOJA');
                    };         
                };
            )
        endif
    next nI
    
return aParticipants

/*/{Protheus.doc} ParticipantProfileRepository::getFiltersData
Método para obter os dados dos filtros do perfil de participante.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 29/10/2025
@return array, Dados dos filtros do perfil de participante
/*/
method getFiltersData() as array class ParticipantProfileRepository

    local aFilters := {} as array
    local nI as numeric
    local nJ as numeric
    local nFilter as numeric

    if ( self:hasFiltersModel() )
        for nI := 1 to self:oFilters:length()
            self:oFilters:goLine(nI)

            if ( !self:oFilters:isDeleted() )
                if ( !empty(self:oFilters:getValue('CKJ_ID')) )
                    nFilter++

                    aadd(aFilters,;
                        {;
                            'id': self:oFilters:getValue('CKJ_ID'),;
                            'type': {;
                                'code': self:oFilters:getValue('CKJ_TIPO'),;
                                'description': allTrim(Capital(fwHttpEncode(getDesTpFil(self:oFilters:getValue('CKJ_TIPO')))));
                            },;
                            'items': array(0);
                        };
                    )        

                    for nJ := 1 to self:oFilterItems:length()
                        self:oFilterItems:goLine(nJ)

                        if ( !self:oFilterItems:isDeleted() )
                            aadd(aFilters[nFilter]['items'],;
                                {;
                                    'id': self:oFilterItems:getValue('CKK_ID'),;
                                    'key': allTrim(self:oFilterItems:getValue('CKK_CHAVE')),;
                                    'value': allTrim(fwHttpEncode(self:oFilterItems:getValue('CKK_VALOR')));
                                };
                            )
                        endif
                    next nJ
                endif
            endif
        next nI
    endif

return aFilters

/*/{Protheus.doc} ParticipantProfileRepository::searchParticipants
Método para busca de Participantes de acordo com o tipo (Cliente ou Fornecedor) e os filtros.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 11/11/2025
@param cTypeCode, character, Código do tipo do participante (1=Fornecedor;2=Cliente)
@param aItems, array, Array de jsons contendo os filtros
@param cSearchType, character, Tipo de busca (count (apenas contagem); list (listagem dos participantes))
@param nPage, numeric, Número da página
@param nPageSize, numeric, Tamanho da página
@param lHasNext, logical, Indica se há próxima página
@return variant, Se o tipo de busca for igual a 'count' retorna a contagem de registros, se 'list' retorna os dados dos participantes localizados
/*/
method searchParticipants(cTypeCode as character, aItems as array, cSearchType as character, nPage as numeric, nPageSize as numeric, lHasNext as logical) as variant class ParticipantProfileRepository

    local aResult := {} as array
    local xReturn as variant
    local cQuery as character
    local cAlias as character
    local nI := 1 as numeric
    local aBind := {} as array
    local cKey as character
    local aValues := {} as array
    local oStatement as object
    local cStatusCode := getParStCode('AUTOMATIZADO') as character
    local cStatusDescription := capital(strTran(getParStDesc(cStatusCode),'_',' ')) as character
    local cTypeDescription := STR0009 as character // 'Fornecedor'
    local nLength := Len(aItems) as numeric
    local jKeysFromTo as json
    local nCount as numeric
    local nInitial as numeric
    local nFinal as numeric
    local aKeys := {} as array
    local cCitiesFilter as character
    local cOr as character
    local cAuxiliaryField as character
    local cStateCode as character
    local cCityCode as character
    local lContinue as logical    

    jKeysFromTo := {;
        'A1_COD_FR': 'A1_COD >',;
        'A1_COD_TO': 'A1_COD <',;
        'A1_LOJA_FR': 'A1_LOJA >',;
        'A1_LOJA_TO': 'A1_LOJA <',;
        'A2_COD_FR': 'A2_COD >',;
        'A2_COD_TO': 'A2_COD <',;
        'A2_LOJA_FR': 'A2_LOJA >',;
        'A2_LOJA_TO': 'A2_LOJA <';
    }    
            
    if ( cTypeCode == '2' )
        cTypeDescription := STR0010 // 'Cliente'
    endif

	nInitial := ( ( nPage - 1 ) * nPageSize ) + 1
	nFinal := ( nPage * nPageSize ) + 1    

    cQuery := ' SELECT COUNT(*) AS TOTAL '

    do case 
        case ( cTypeCode == '1' )
            if ( cSearchType == 'list' )
                cQuery := ' SELECT A2_COD AS COD, A2_LOJA AS LOJA, A2_NOME AS NOME '
                cQuery += ' FROM ( '
                cQuery += '     SELECT ROW_NUMBER() OVER(ORDER BY A2_COD, A2_LOJA, A2_NOME) LINE_NUMBER, '
                cQuery += '         A2_COD, A2_LOJA, A2_NOME '
            endif

            cQuery += '     FROM ' + RetSqlName('SA2')
            cQuery += '     WHERE A2_FILIAL = ? '

            aadd(aBind, {'C',fwxFilial('SA2')})
        case ( cTypeCode == '2' )
            if ( cSearchType == 'list' )
                cQuery := ' SELECT A1_COD AS COD, A1_LOJA AS LOJA, A1_NOME AS NOME '
                cQuery += ' FROM ( '
                cQuery += '     SELECT ROW_NUMBER() OVER(ORDER BY A1_COD, A1_LOJA, A1_NOME) LINE_NUMBER, '
                cQuery += '         A1_COD, A1_LOJA, A1_NOME '
            endif

            cQuery += '     FROM ' + RetSqlName('SA1')
            cQuery += '     WHERE A1_FILIAL = ? '

            aadd(aBind, {'C',fwxFilial('SA1')})
    endcase

    while nI <= nLength
        cKey := aItems[nI]['key']
        aValues := {}

        while nI <= nLength .and. cKey == aItems[nI]['key']
            if ( ( cKey == 'A1_COD_MUN' .or. cKey == 'A2_COD_MUN' ) .and. ( '-' $ aItems[nI]['value'] ) )
                aKeys := strTokArr2(aItems[nI]['value'],'-')

                if ( len(aKeys) == 2 )
                    cStateCode := aKeys[1]
                    cCityCode := aKeys[2]

                    cAuxiliaryField := 'A1_EST'
                    if ( cTypeCode == '1' )
                        cAuxiliaryField := 'A2_EST'
                    endif

                    cCitiesFilter += cOr + '( ? = ? AND ? = ? )'
                    aadd(aBind, {'U',cAuxiliaryField})
                    aadd(aBind, {'C',cStateCode})

                    aadd(aBind, {'U',cKey})
                    aadd(aBind, {'C',cCityCode})

                    cOr := ' OR '
                endif

                lContinue := .F.
            else
                aadd(aValues, aItems[nI]['value'])
                lContinue := .T.
            endif

            nI++
        enddo

        if ( !empty(cCitiesFilter) )
            cQuery += ' AND ( ' + cCitiesFilter + ' ) '
            cCitiesFilter := ''
            cOr := ''
        endif

        if ( lContinue )
            if ( jKeysFromTo:hasProperty(cKey) )
                cQuery += '         AND ?'
                aadd(aBind, {'U',jKeysFromTo[cKey]})
            else
                cQuery += '         AND ? '
                aadd(aBind, {'U',cKey})
            endif

            if ( len(aValues) > 1 )
                cQuery += 'IN ( ? ) '
                aadd(aBind, {'A',aValues})
            else
                cQuery += '= ? '
                aadd(aBind, {'C',aValues[1]})
            endif
        endif
    enddo

    cQuery += '         AND D_E_L_E_T_ = ? '
    aadd(aBind, {'C',' '})

    if ( cSearchType == 'list' )
        cQuery += ' ) TAB '
        cQuery += ' WHERE LINE_NUMBER BETWEEN ? AND ? '
        aadd(aBind, {'N', nInitial})
        aadd(aBind, {'N', nFinal})        
    endif

    oStatement := fwExecStatement():new(changeQuery(cQuery))

    for nI := 1 to len(aBind)
        do case
            case ( aBind[nI][1] == 'A' )
                oStatement:setIn(nI,aBind[nI][2])
            case ( aBind[nI][1] == 'C' )
                oStatement:setString(nI, aBind[nI][2])
            case ( aBind[nI][1] == 'N' )
                oStatement:setNumeric(nI, aBind[nI][2])
            case ( aBind[nI][1] == 'U' )
                oStatement:setUnsafe(nI, aBind[nI][2])
        endcase
    next nI

    if ( cSearchType == 'count' )
        xReturn := oStatement:execScalar('TOTAL')
    else
        cAlias := oStatement:openAlias()

        while !(cAlias)->(eof()) .and. nCount < nPageSize
            nCount++

            aadd(aResult,;
                {;
                    'code': (cAlias)->COD,;
                    'store': (cAlias)->LOJA,;
                    'name': allTrim(fwHttpEncode((cAlias)->NOME)),;
                    'type': {;
                        'code': cTypeCode,;
                        'description': cTypeDescription;
                    },;
                    'status': {;
                        'code': cStatusCode,; 
                        'description': cStatusDescription;
                    },;
                    'key': {;
                        'type': cTypeCode,;
                        'code': (cAlias)->COD,;
                        'store': (cAlias)->LOJA;
                    };
                };
            )

            (cAlias)->(dbSkip())
        enddo

        lHasNext := !(cAlias)->(eof())

        (cAlias)->(dbCloseArea())
        
        xReturn := aResult
    endif

    fwFreeObj(jKeysFromTo)
    fwFreeArray(aBind)
    fwFreeArray(aValues)
    fwFreeArray(aKeys)

    oStatement:destroy()
    fwFreeObj(oStatement)

return xReturn

/*/{Protheus.doc} ParticipantProfileRepository::destroy
Método destrutor da classe ParticipantProfileRepository.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
/*/
method destroy() class ParticipantProfileRepository

    if ( valType(self:oModel) == 'O' )
        self:oModel:destroy()
        fwFreeObj(self:oModel)
    endif

    if ( valType(self:oParticipantGrid) == 'O' )
        fwFreeObj(self:oParticipantGrid)
    endif

    if ( valType(self:oFilters) == 'O' )
        fwFreeObj(self:oFilters)
    endif

    if ( valType(self:oFilterItems) == 'O' )
        fwFreeObj(self:oFilterItems)
    endif

    if ( select('F20') > 0 )
        F20->(dbCloseArea())
    endif

return
