#include 'tlpp-core.th'
#include 'backoffice.fiscal.configurador.profiles.product.repository.ch'

namespace totvs.protheus.backoffice.fiscal.configurador.profiles.productprofile.repository

#Define PERFIL_TIPO_PRODUTO '04'
#Define FILTRO_TIPO_PRODUTO '3'

/*/{Protheus.doc} ProductProfileRepository
Repository para gerenciamento dos perfis de produto.
@type class
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
/*/
class ProductProfileRepository

    private data oModel as object
    private data oProductGrid as object
    private data oFiltersGrid as object
    private data oFilterItemsGrid as object
    private data oOriginGrid as object
    private data cError as character
    private data lProfStatus as logical
    private data lArqProd as logical

    public method new() constructor

    public method exists(cCode as character) as logical
    public method startModel(nOperation as numeric)
    public method endModel()
    public method hasFiltersModel() as logical
    public method setHeaderValues(cCode as character, cDescription as character)
    public method saveModel() as logical
    public method getError() as character

    public method addProducts(aProducts as array, cCode as character)
    public method addOrigins(aOrigins as array, cCode as character)
    public method addFilters(aFilters as array, cCode as character)
    private method addFilterItems(aItems as array, cFilterId as character)

    public method updateProducts(aProducts as array, cCode as character) as logical
    public method updateOrigins(aOrigins as array, cCode as character) as logical
    public method updateFilters(aFilters as array, cCode as character) as logical
    private method updateFilterItems(aItems as array) as logical

    public method findAllProduct(cFilter as character, nPage as numeric, nPageSize as numeric, lHasNext as logical, lEnableFilters as logical) as array

    public method getProductProfileData() as json
    private method getProductProfileStatusData() as json
    private method getProductsData() as array
    private method getOriginsData() as array
    private method getFiltersData() as json

    public method searchProducts(aItems as array, cSearchType as character, nPage as numeric, nPageSize as numeric, lHasNext as logical) as variant

    public method destroy()

endclass

/*/{Protheus.doc} ProductProfileRepository:new()
Método construtor da classe ProductProfileRepository.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
@return object, Instância da classe ProductProfileRepository
/*/
method new() class ProductProfileRepository
    self:lProfStatus := F20->(fieldPos('F20_STATUS')) > 0 .and. F24->(fieldPos('F24_STATUS')) > 0
    self:lArqProd := getMV("MV_ARQPROD") == "SBZ"
return self

/*/{Protheus.doc} ProductProfileRepository:exists()
Método para verificar se um perfil de produto existe.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
@param cCode, character, Código do perfil de produto
@return logical, Indica se o perfil de produto existe
/*/
method exists(cCode as character) as logical class ProductProfileRepository
    dbSelectArea('F20')
    F20->(dbSetOrder(1)) // F20_FILIAL+F20_CODIGO+F20_TIPO
return F20->(msSeek(fwxFilial('F20') + cCode + PERFIL_TIPO_PRODUTO))

/*/{Protheus.doc} ProductProfileRepository:startModel()
Método para iniciar o modelo de dados do perfil de produto.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
@param nOperation, numeric, Tipo de operação a ser realizada (inclusão, alteração, exclusão)
/*/
method startModel(nOperation as numeric) class ProductProfileRepository

    self:oModel := fwLoadModel('FISA166')
    self:oProductGrid := self:oModel:getModel('FISA166PRODUTO')
    self:oOriginGrid := self:oModel:getModel('FISA166ORIGEM')
    self:oFiltersGrid := self:oModel:getModel('FISA166FILTERS')
    self:oFilterItemsGrid := self:oModel:getModel('FISA166ITEMS')

    self:oModel:setOperation(nOperation)
    self:oModel:activate()

return

/*/{Protheus.doc} ProductProfileRepository:endModel()
Método para finalizar o modelo de dados do perfil de produto.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
/*/
method endModel() class ProductProfileRepository

    self:oModel:deActivate()

return

/*/{Protheus.doc} ProductProfileRepository:hasFiltersModel()
Método para verificar se os modelos de filtros e itens de filtro existem.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 29/10/2025
@return logical, Indica se os modelos de filtros e it   ens de filtro existem
/*/
method hasFiltersModel() as logical class ProductProfileRepository
return ( self:oFiltersGrid != nil .and. self:oFilterItemsGrid != nil )

/*/{Protheus.doc} ProductProfileRepository:setHeaderValues()
Método para definir os valores do cabeçalho do perfil de produto.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
@param cCode, character, Código do perfil de produto
@param cDescription, character, Descrição do perfil de produto
/*/
method setHeaderValues(cCode as character, cDescription as character) class ProductProfileRepository

    self:oModel:setValue('FISA166','F20_CODIGO', cCode)
    self:oModel:setValue('FISA166','F20_DESC', decodeUtf8(cDescription))
    self:oModel:setValue('FISA166','F20_TIPO', PERFIL_TIPO_PRODUTO)

return

/*/{Protheus.doc} ProductProfileRepository:saveModel()
Método para salvar o modelo de dados do perfil de produto.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
@return logical, Indica se o modelo foi salvo com sucesso
/*/
method saveModel() as logical class ProductProfileRepository

    local aError := {} as array

    if !( self:oModel:vldData() .and. self:oModel:commitData() )
        aError := self:oModel:getErrorMessage()

        if ( len(aError) >= 6 )
            self:cError := aError[6]
        endif

        return .F.
    endif

    fwFreeArray(aError)

return .T.

/*/{Protheus.doc} ProductProfileRepository:getError()
Método para obter a mensagem de erro da última operação.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
@return character, Mensagem de erro da última operação
/*/
method getError() as character class ProductProfileRepository
return self:cError

/*/{Protheus.doc} ProductProfileRepository:addProducts()
Método para adicionar produtos ao perfil de produto.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
@param aProducts, array, Array de produtos a serem adicionados
@param cCode, character, Código do perfil de produto
/*/
method addProducts(aProducts as array, cCode as character) class ProductProfileRepository

    local nI as numeric

    for nI := 1 to len(aProducts)
        if ( nI > 1 )
            self:oProductGrid:addLine()
        endif

        self:oProductGrid:setValue('F24_CODIGO', cCode)
        self:oProductGrid:setValue('F24_CDPROD', aProducts[nI]['code'])

        if ( self:lProfStatus )
            self:oProductGrid:setValue('F24_STATUS', aProducts[nI]['status']['code'])
        endif
    next nI

return

/*/{Protheus.doc} ProductProfileRepository:addOrigins()
Método para adicionar as orignes ao perfil de produto.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
@param aOrigins, array, Array de origem a serem adicionados
@param cCode, character, Código do perfil de produto
/*/
method addOrigins(aOrigins as array, cCode as character) class ProductProfileRepository

    local nI as numeric

    self:oOriginGrid:delAllLine() //apaga todas as linhas criadas pela CargaOrigem() e somente inclui as informadas na requisição

    for nI := 1 to len(aOrigins)
        if self:oOriginGrid:seekLine({{'F25_ORIGEM', aOrigins[nI]['id']} , {'F25_TIPOPF', PERFIL_TIPO_PRODUTO} }, .T., .T.)
            self:oOriginGrid:unDeleteLine() //desmarco como deletado as linhas que o usuario deseja informar na origem
        endIf
    next nI

return

/*/{Protheus.doc} ProductProfileRepository:addFilters()
Método para adicionar filtros ao perfil de produto.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
@param aFilters, array, Array de filtros a serem adicionados
@param cCode, character, Código do perfil de produto
/*/
method addFilters(aFilters as array, cCode as character) class ProductProfileRepository

    local cFilterId as character

    cFilterId := FWUUIDV4(.T.)

    self:oFiltersGrid:setValue('CKJ_ID', cFilterId)
    self:oFiltersGrid:setValue('CKJ_CODIGO', cCode)
    self:oFiltersGrid:setValue('CKJ_TIPOPF', PERFIL_TIPO_PRODUTO)
    self:oFiltersGrid:setValue('CKJ_TIPO', FILTRO_TIPO_PRODUTO)

    self:addFilterItems(aFilters, cFilterId)

return

/*/{Protheus.doc} ProductProfileRepository:addFilterItems()
Método para adicionar itens a um filtro do perfil de produto.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
@param aItems, array, Array de itens a serem adicionados ao filtro
@param cFilterId, character, ID do filtro ao qual os itens pertencem
/*/
method addFilterItems(aItems as array, cFilterId as character) class ProductProfileRepository

    local nI as numeric

    for nI := 1 to len(aItems)
        if ( nI > 1 )
            self:oFilterItemsGrid:addLine()
        endif

        self:oFilterItemsGrid:setValue('CKK_ID', FWUUIDV4(.T.))
        self:oFilterItemsGrid:setValue('CKK_IDFILT', cFilterId)
        self:oFilterItemsGrid:setValue('CKK_CHAVE', decodeUtf8(aItems[nI]['key']))
        self:oFilterItemsGrid:setValue('CKK_VALOR', decodeUtf8(aItems[nI]['value']))
    next nI

return

/*/{Protheus.doc} ProductProfileRepository:updateProducts()
Método para atualizar produtos do perfil de produto.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
@param aProducts, array, Array de produtos a serem atualizados
@param cCode, character, Código do perfil de produto
@return logical, Indica se a operação foi bem-sucedida ou não
/*/
method updateProducts(aProducts as array, cCode as character) as logical class ProductProfileRepository

    local aSeek as array
    local nI as numeric
    local cAction  as character

    for nI := 1 to len(aProducts)
        cAction := aProducts[nI]['action']

        do case
            case ( cAction == 'insert' )
                self:oProductGrid:addLine()
                self:oProductGrid:setValue('F24_CODIGO', cCode)

            case ( cAction == 'update' .or. cAction == 'delete' )
                aSeek := array(1)
                aSeek[1] := {'F24_CDPROD', aProducts[nI]['key']}

                if ( !self:oProductGrid:seekLine(aSeek) )
                    self:cError := STR0001 + '. ' // 'Item do Perfil de produto não localizado'
                    self:cError += STR0002 + ': ' + aProducts[nI]['key'] + '. ' // 'Produto'
                    return .F.
                endif

                fwFreeArray(aSeek)
        endcase

        if ( cAction == 'insert' .or. cAction == 'update' )
            self:oProductGrid:setValue('F24_CDPROD', aProducts[nI]['code'])

            if ( self:lProfStatus )
                self:oProductGrid:setValue('F24_STATUS', aProducts[nI]['status']['code'])
            endif
        elseif ( cAction == 'delete' )
            self:oProductGrid:deleteLine()
        endif
    next nI

return .T.

/*/{Protheus.doc} ProductProfileRepository:updateOrigins()
Método para atualizar origins do perfil de produto.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
@param aOrigins, array, Array de origins a serem atualizados
@param cCode, character, Código do perfil de produto
@return logical, Indica se a operação foi bem-sucedida ou não
/*/
method updateOrigins(aOrigins as array, cCode as character) as logical class ProductProfileRepository

    local aSeek as array
    local nI as numeric
    local cAction  as character

    for nI := 1 to len(aOrigins)
        cAction := aOrigins[nI]['action']

        do case
            case ( cAction == 'insert' )
                self:oOriginGrid:addLine()
                self:oOriginGrid:setValue('F25_CODIGO', cCode)
                self:oOriginGrid:setValue('F25_TIPOPF', PERFIL_TIPO_PRODUTO)

            case ( cAction == 'update' .or. cAction == 'delete' )
                aSeek := array(2)
                aSeek[1] := {'F25_ORIGEM', aOrigins[nI]['key']}
                aSeek[2] := {'F25_TIPOPF', PERFIL_TIPO_PRODUTO}

                if ( !self:oOriginGrid:seekLine(aSeek) )
                    self:cError := STR0007 + '. ' // 'Origem do Perfil de produto não localizada'
                    self:cError += STR0008 + ': ' + aOrigins[nI]['key'] + '. ' // 'Origem'
                    return .F.
                endif

                fwFreeArray(aSeek)
        endcase

        if ( cAction == 'insert' .or. cAction == 'update' )
            self:oOriginGrid:setValue('F25_ORIGEM', aOrigins[nI]['id'])
        elseif ( cAction == 'delete' )
            self:oOriginGrid:deleteLine()
        endif
    next nI

return .T.

/*/{Protheus.doc} ProductProfileRepository:updateFilters()
Método para atualizar filtros do perfil de produto.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
@param aFilters, json, Json de filtros a serem atualizados
@param cCode, character, Código do perfil de produto
@return logical, Indica se a operação foi bem-sucedida ou não
/*/
method updateFilters(aFilters as array, cCode as character) as logical class ProductProfileRepository

    local cAction as character
    local aSeek as array
    local nI as numeric
    local nJ as numeric

    for nI := 1 to len(aFilters)
        cAction := aFilters[nI]['action']

        do case
            case ( cAction == 'insert' )

                aSeek := array(3)
                aSeek[1] := {'CKJ_CODIGO',cCode}
                aSeek[2] := {'CKJ_TIPOPF',PERFIL_TIPO_PRODUTO}
                aSeek[3] := {'CKJ_TIPO', FILTRO_TIPO_PRODUTO}

                if ( !self:oFiltersGrid:seekLine(aSeek) )

                    self:oFiltersGrid:setValue('CKJ_ID', FWUUIDV4(.T.))
                    self:oFiltersGrid:setValue('CKJ_CODIGO', cCode)
                    self:oFiltersGrid:setValue('CKJ_TIPOPF', PERFIL_TIPO_PRODUTO)
                    self:oFiltersGrid:setValue('CKJ_TIPO', FILTRO_TIPO_PRODUTO)

                endIF

            case ( cAction == 'update' .or. cAction == 'delete' )
                aSeek := array(1)
                aSeek[1] := {'CKJ_ID',aFilters[nI]['id']}

                if ( !self:oFiltersGrid:seekLine(aSeek) )
                    self:cError := STR0003 + '. ' // 'Filtro do Perfil de produto não localizado'
                    self:cError += STR0004 + ': ' + aFilters[nI]['id'] + '. ' // 'Id do filtro'
                    fwFreeArray(aSeek)
                    return .F.
                endif
        endcase

        fwFreeArray(aSeek)

        if ( cAction == 'insert' .or. cAction == 'update' )
            if ( !self:updateFilterItems(aFilters[nI]['items']) )
                return .F.
            endif
        elseif ( cAction == 'delete' )
            self:oFiltersGrid:deleteLine()
        endif
    next nI

    for nI := 1 to self:oFiltersGrid:length()
        self:oFiltersGrid:goLine(nI)

        if ( !self:oFiltersGrid:isDeleted() )
            lHasItems := .F.

            for nJ := 1 to self:oFilterItemsGrid:length()
                self:oFilterItemsGrid:goLine(nJ)

                if ( !self:oFilterItemsGrid:isDeleted() )
                    lHasItems := .T.
                    exit
                endif
            next nJ

            if ( !lHasItems )
                self:oFiltersGrid:deleteLine()
            endif
        endif
    next nI

return .T.

/*/{Protheus.doc} ProductProfileRepository:updateFilterItems()
Método para atualizar itens de um filtro do perfil de produto.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
@param aItems, array, Array de itens do filtro a serem atualizados
@return logical, Indica se a operação foi bem-sucedida ou não
/*/
method updateFilterItems(aItems as array) as logical class ProductProfileRepository

    local nI as numeric
    local cAction as character
    local aSeek as array

    for nI := 1 to len(aItems)
        cAction := aItems[nI]['action']

        do case
            case ( cAction == 'insert' )
                aSeek := array(2)
                aSeek[1] := {'CKK_CHAVE',decodeUtf8(aItems[nI]['key'])}
                aSeek[2] := {'CKK_VALOR',decodeUtf8(aItems[nI]['value'])}

                if ( !self:oFilterItemsGrid:seekLine(aSeek) )
                    if ( !self:oFilterItemsGrid:isEmpty() )
                        self:oFilterItemsGrid:addLine()
                    endif

                    self:oFilterItemsGrid:setValue('CKK_ID', FWUUIDV4(.T.))
                    self:oFilterItemsGrid:setValue('CKK_IDFILT', self:oFiltersGrid:getValue('CKJ_ID'))
                endIf
            case ( cAction == 'update' .or. cAction == 'delete' )
                aSeek := array(1)
                aSeek[1] := {'CKK_ID',aItems[nI]['id']}

                if ( !self:oFilterItemsGrid:seekLine(aSeek) )
                    self:cError := STR0005 + '. ' // 'Item do filtro do Perfil de produto não localizado'
                    self:cError += STR0004 + ': ' + self:oFiltersGrid:getValue('CKJ_ID') + '. ' // 'Id do filtro'
                    self:cError += STR0006 + ': ' + aItems[nI]['id'] + '. ' // 'Id do item do filtro'
                    fwFreeArray(aSeek)
                    return .F.
                endif
        endcase

        fwFreeArray(aSeek)

        if ( cAction == 'insert' .or. cAction == 'update' )
            self:oFilterItemsGrid:setValue('CKK_CHAVE', decodeUtf8(aItems[nI]['key']))
            self:oFilterItemsGrid:setValue('CKK_VALOR', decodeUtf8(aItems[nI]['value']))
        elseif ( cAction == 'delete' )
            self:oFilterItemsGrid:deleteLine()
        endif
    next nI

return .T.

/*/{Protheus.doc} ProductProfileRepository:findAllProduct()
Método para consulta de todos os perfis de produto.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
@param cFilter, character, Filtro de pesquisa
@param nPage, numeric, Número da página
@param nPageSize, numeric, Tamanho da página
@param lHasNext, logical, Indica se há próxima página - deve ser enviado por referência @lHasNext
@param lEnableFilters, logical, Indica se os filtros de status serão habilitados - deve ser enviado por referência @lHasNext
@return array, Array com os perfis de produto encontrados
/*/
method findAllProduct(cFilter as character, nPage as numeric, nPageSize as numeric, lHasNext as logical, lEnableFilters as logical) as array class ProductProfileRepository

    local aBind := {} as array
    local aResult := {} as array
    local nI as numeric
    local cQuery as character
	local cFields as character
    local cStatusCode as character
    local cStatusDescription as character
    local cDefaultStatusCode := getParStCode('MANUAL') as character
    local cDefaultStatusDescription := capital(strTran(getParStDesc(cDefaultStatusCode),'_',' ')) as character
    local cAlias as character
    local oStatement as object
    local nCount := 0 as numeric
    local nInitial as numeric
    local nFinal as numeric
    local cCompanyCode := fwGrpCompany() as character

	nInitial := ( ( nPage - 1 ) * nPageSize ) + 1
	nFinal := ( nPage * nPageSize ) + 1

    cFields := valtoSql(cDefaultStatusCode) + ' AS F20_STATUS, F20.F20_CODIGO, F20.F20_DESC'
    if ( self:lProfStatus )
        cFields := 'F20.F20_FILIAL, F20.F20_STATUS, F20.F20_CODIGO, F20.F20_DESC'
    endif

    cQuery := ' SELECT F20_FILIAL, F20_STATUS, F20_CODIGO, F20_DESC '
    cQuery += ' FROM ( '
    cQuery += '     SELECT ROW_NUMBER() OVER(ORDER BY F20.F20_FILIAL, F20.F20_CODIGO) LINE_NUMBER, '
    cQuery += '         ? '
    cQuery += '     FROM ' + retSqlName('F20') + ' F20 '
    cQuery += '     WHERE F20.F20_TIPO = ? '

    aadd(aBind, {'U', cFields})
    aadd(aBind, {'C', PERFIL_TIPO_PRODUTO})

    if ( !empty(cFilter) )
        cQuery += '         AND ( '
        cQuery += '             UPPER(F20.F20_FILIAL) LIKE ? OR '
        cQuery += '             UPPER(F20.F20_CODIGO) LIKE ? OR '
        cQuery += '             UPPER(F20.F20_DESC) LIKE ? '
        cQuery += '         ) '

        aadd(aBind, {'C', cFilter})
        aadd(aBind, {'C', cFilter})
        aadd(aBind, {'C', cFilter})
    endif

    cQuery += '         AND F20.D_E_L_E_T_ = ? '
    cQuery += ' ) F20 '
    cQuery += ' WHERE LINE_NUMBER BETWEEN ? AND ? '

    aadd(aBind, {'C', ' '})
    aadd(aBind, {'N', nInitial})
    aadd(aBind, {'N', nFinal})

    oStatement := fwExecStatement():new(changeQuery(cQuery))

    for nI := 1 to len(aBind)
        do case
            case ( aBind[nI][1] == 'C' )
                oStatement:setString(nI, aBind[nI][2])
            case ( aBind[nI][1] == 'N' )
                oStatement:setNumeric(nI, aBind[nI][2])
            case ( aBind[nI][1] == 'U' )
                oStatement:setUnsafe(nI, aBind[nI][2])
        endcase
    next nI

    cAlias := oStatement:openAlias()

    while !(cAlias)->(eof()) .and. nCount < nPageSize
        nCount++

        cStatusCode := cDefaultStatusCode
        cStatusDescription := cDefaultStatusDescription

        if ( !empty((cAlias)->F20_STATUS) )
            cStatusCode := (cAlias)->F20_STATUS
            cStatusDescription := capital(strTran(getParStDesc(cStatusCode),'_',' '))
        endif

        aadd(aResult,;
            {;
                'company': cCompanyCode,;
                'branch': fwxFilial('F20',(cAlias)->F20_FILIAL,'E','E','E'),;
                'code': (cAlias)->F20_CODIGO,;
                'description': allTrim(fwHttpEncode((cAlias)->F20_DESC)),;
                'status': {;
                    'code': cStatusCode,;
                    'description': cStatusDescription;
                };
            };
        )

        (cAlias)->(dbSkip())
    enddo

    lHasNext := !(cAlias)->(eof())
    
    (cAlias)->(dbCloseArea())

    lEnableFilters := self:lProfStatus

    oStatement:destroy()
    fwFreeObj(oStatement)

    fwFreeArray(aBind)

return aResult

/*/{Protheus.doc} ProductProfileRepository:getProductProfileData()
Método para obter os dados completos do perfil de produto em formato JSON.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
@return json, Dados completos do perfil de produto em formato JSON
/*/
method getProductProfileData() as json class ProductProfileRepository
    local jData := jsonObject():new()

    jData := {;
        'code': self:oModel:getValue('FISA166','F20_CODIGO'),;
        'description': allTrim(fwHttpEncode(self:oModel:getValue('FISA166','F20_DESC'))),;
        'status': self:getProductProfileStatusData(),;
        'products': self:getProductsData(),;
        'origins': self:getOriginsData(),;
        'filters': self:getFiltersData(); 
    }

return jData

/*/{Protheus.doc} ProductProfileRepository:getProductProfileStatusData()
Método para obter os dados de status do perfil de produto.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 29/10/2025
@return json, Dados de status do perfil de produto
/*/
method getProductProfileStatusData() as json class ProductProfileRepository

    local cDefaultStatusCode := getParStCode('MANUAL') as character
    local cStatusCode := cDefaultStatusCode as character
    local jStatus as json

    if ( self:lProfStatus )
        cStatusCode := self:oModel:getValue('FISA166','F20_STATUS')
    endif

    jStatus := ;
        {;
            'code': cStatusCode,;
            'description': capital(strTran(getParStDesc(cStatusCode),'_',' '));
        }    

return jStatus

/*/{Protheus.doc} ProductProfileRepository:getProductsData()
Método para obter os dados dos produtos do perfil de produto.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 29/10/2025
@return array, Dados dos produtos do perfil de produto
/*/
method getProductsData() as array class ProductProfileRepository

    local aProducts := {} as array
    local nI as numeric
    local cDefaultStatusCode := getParStCode('MANUAL') as character
    local cDefaultStatusDescription := capital(strTran(getParStDesc(cDefaultStatusCode),'_',' ')) as character
    local cStatusCode as character
    local cStatusDescription as character

    for nI := 1 to self:oProductGrid:length()
        self:oProductGrid:goLine(nI)

        if ( !self:oProductGrid:isDeleted() )
	        cStatusCode := cDefaultStatusCode
            cStatusDescription := cDefaultStatusDescription

            if ( self:lProfStatus )
                if ( !empty(self:oProductGrid:getValue('F24_STATUS')) )
                    cStatusCode := self:oProductGrid:getValue('F24_STATUS')
                    cStatusDescription := capital(strTran(getParStDesc(cStatusCode),'_',' '))
                endif
            endif

            aadd(aProducts,;
                {;
                    'code': self:oProductGrid:getValue('F24_CDPROD'),;
                    'description': allTrim(fwHttpEncode(self:oProductGrid:getValue('F24_DSPROD'))),;
                    'status': {;
                        'code': cStatusCode,;
                        'description': cStatusDescription;
                    },;
                    'key': self:oProductGrid:getValue('F24_CDPROD');
                };
            )
        endif
    next nI
return aProducts

/*/{Protheus.doc} ProductProfileRepository:getOriginsData()
Método para obter os dados dos produtos do perfil de produto.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 29/10/2025
@return array, Dados dos produtos do perfil de produto
/*/
method getOriginsData() as array class ProductProfileRepository

    local aOrigins := {} as array
    local nI as numeric

    for nI := 1 to self:oOriginGrid:length()
        self:oOriginGrid:goLine(nI)

        if ( !self:oOriginGrid:isDeleted() )
            aadd(aOrigins,;
                {;
                    'id': self:oOriginGrid:getValue('F25_ORIGEM'),;
                    'descorig': allTrim(fwHttpEncode(self:oOriginGrid:getValue('F25_DSORIG'))),;
                    'key': self:oOriginGrid:getValue('F25_ORIGEM');
                };
            )
        endif
    next nI
return aOrigins


/*/{Protheus.doc} ProductProfileRepository:getFiltersData()
Método para obter os dados dos filtros do perfil de produto.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 29/10/2025
@return array, Dados dos filtros do perfil de produto
/*/
method getFiltersData() as json class ProductProfileRepository

    local jFilters := jsonObject():new() as json
    local nI as numeric

    if ( self:hasFiltersModel() )
        if ( !self:oFiltersGrid:isDeleted() )
            if ( !empty(self:oFiltersGrid:getValue('CKJ_ID')) )
                jFilters := ;
                        {;
                            'id': self:oFiltersGrid:getValue('CKJ_ID'),;
                            'type': {;
                                'code': self:oFiltersGrid:getValue('CKJ_TIPO'),;
                                'description': allTrim(Capital(fwHttpEncode(getDesTpFil(self:oFiltersGrid:getValue('CKJ_TIPO')))));
                            },;
                            'items': array(0);
                        };

                for nI := 1 to self:oFilterItemsGrid:length()
                    self:oFilterItemsGrid:goLine(nI)

                    if ( !self:oFilterItemsGrid:isDeleted() )
                        aadd(jFilters['items'], ;
                            {;
                                'id': self:oFilterItemsGrid:getValue('CKK_ID'),;
                                'key': allTrim(self:oFilterItemsGrid:getValue('CKK_CHAVE')),;
                                'value': allTrim(fwHttpEncode(self:oFilterItemsGrid:getValue('CKK_VALOR')));
                            };
                        )
                    endif
                next nI
            endif
        endif
    endif
return jFilters

/*/{Protheus.doc} ProductProfileRepository::searchProducts
Método para busca de Produtos de acordo com o tipo e os filtros.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/11/2025
@param aItems, array, Array de jsons contendo os filtros
@param cSearchType, character, Tipo de busca (count (apenas contagem); list (listagem dos Produtos))
@param nPage, numeric, Número da página
@param nPageSize, numeric, Tamanho da página
@param lHasNext, logical, Indica se há próxima página
@return variant, Se o tipo de busca for igual a 'count' retorna a contagem de registros, se 'list' retorna os dados dos Produtos localizados
/*/
method searchProducts(aItems as array, cSearchType as character, nPage as numeric, nPageSize as numeric, lHasNext as logical) as variant class ProductProfileRepository

    local aResult := {} as array
    local xReturn as variant
    local cQuery as character
    local cAlias as character
    local nI := 1 as numeric
    local aBind := {} as array
    local cKey as character
    local aValues := {} as array
    local oStatement as object
    local cStatusCode := getParStCode('AUTOMATIZADO') as character
    local cStatusDescription := capital(strTran(getParStDesc(cStatusCode),'_',' ')) as character
    local nLength := Len(aItems) as numeric
    local jKeysFromTo as json
    local nCount as numeric
    local nInitial as numeric
    local nFinal as numeric
    local aKeys := {} as array
    local lContinue as logical    

    jKeysFromTo := { 'B1_COD_FR': 'B1_COD >', 'B1_COD_TO': 'B1_COD <' }
            
	nInitial := ( ( nPage - 1 ) * nPageSize ) + 1
	nFinal := ( nPage * nPageSize ) + 1    

    cQuery := ' SELECT COUNT(*) AS TOTAL '

    if ( cSearchType == 'list' )
        cQuery := ' SELECT B1_COD AS COD, B1_DESC AS DESCRI '
        cQuery += ' FROM ( '
        cQuery +=   ' SELECT ROW_NUMBER() OVER(ORDER BY B1_COD) LINE_NUMBER, B1_COD, B1_DESC '
    endif

    cQuery += ' FROM ' + RetSqlName('SB1') + ' SB1 '
    cQuery += ' LEFT JOIN ' + RetSqlName('SB5') + ' SB5 '
    cQuery +=   ' ON SB5.B5_FILIAL = ? AND SB1.B1_COD = SB5.B5_COD AND SB5.D_E_L_E_T_ = ? '
    aadd(aBind, {'C',fwxFilial('SB5')})
    aadd(aBind, {'C',' '})

    if self:lArqProd
        cQuery += ' LEFT JOIN ' + RetSqlName('SBZ') + ' SBZ '
        cQuery +=   ' ON SBZ.BZ_FILIAL = ? AND SB1.B1_COD = SBZ.BZ_COD AND SBZ.D_E_L_E_T_ = ? '

        aadd(aBind, {'C',fwxFilial('SBZ')})
        aadd(aBind, {'C',' '})
    endIf
    cQuery += ' WHERE SB1.B1_FILIAL = ? '
    
    aadd(aBind, {'C',fwxFilial('SB1')})

    while nI <= nLength
        cKey := aItems[nI]['key']
        aValues := {}

        while nI <= nLength .and. cKey == aItems[nI]['key']
            aadd(aValues, aItems[nI]['value'])
            lContinue := .T.
            nI++
        enddo

        if ( lContinue )
            if ( jKeysFromTo:hasProperty(cKey) )
                cQuery += ' AND ?'
                aadd(aBind, {'U',jKeysFromTo[cKey]})
            else
                cQuery += ' AND ? '
                aadd(aBind, {'U',cKey})
            endif

            if ( len(aValues) > 1 )
                cQuery += 'IN ( ? ) '
                aadd(aBind, {'A',aValues})
            else
                cQuery += '= ? '
                aadd(aBind, {'C',aValues[1]})
            endif
        endif
    enddo

    cQuery += ' AND SB1.D_E_L_E_T_ = ? '
    aadd(aBind, {'C',' '})

    if ( cSearchType == 'list' )
        cQuery += ' ) TAB '
        cQuery += ' WHERE LINE_NUMBER BETWEEN ? AND ? '
        aadd(aBind, {'N', nInitial})
        aadd(aBind, {'N', nFinal})        
    endif

    oStatement := fwExecStatement():new(changeQuery(cQuery))

    for nI := 1 to len(aBind)
        do case
            case ( aBind[nI][1] == 'A' )
                oStatement:setIn(nI,aBind[nI][2])
            case ( aBind[nI][1] == 'C' )
                oStatement:setString(nI, aBind[nI][2])
            case ( aBind[nI][1] == 'N' )
                oStatement:setNumeric(nI, aBind[nI][2])
            case ( aBind[nI][1] == 'U' )
                oStatement:setUnsafe(nI, aBind[nI][2])
        endcase
    next nI

    if ( cSearchType == 'count' )
        xReturn := oStatement:execScalar('TOTAL')
    else
        cAlias := oStatement:openAlias()

        while !(cAlias)->(eof()) .and. nCount < nPageSize
            nCount++

            aadd(aResult,;
                {;
                    'code': (cAlias)->COD,;
                    'description': allTrim(fwHttpEncode((cAlias)->DESCRI)),;
                    'status': {;
                        'code': cStatusCode,; 
                        'description': cStatusDescription;
                    },;
                    'key': (cAlias)->COD;
                };
            )

            (cAlias)->(dbSkip())
        enddo

        lHasNext := !(cAlias)->(eof())

        (cAlias)->(dbCloseArea())
        
        xReturn := aResult
    endif

    fwFreeObj(jKeysFromTo)
    fwFreeArray(aBind)
    fwFreeArray(aValues)
    fwFreeArray(aKeys)

    oStatement:destroy()
    fwFreeObj(oStatement)

return xReturn

/*/{Protheus.doc} ProductProfileRepository:destroy()
Método destrutor da classe ProductProfileRepository.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 28/10/2025
/*/
method destroy() class ProductProfileRepository

    if ( valType(self:oModel) == 'O' )
        self:oModel:destroy()
        fwFreeObj(self:oModel)
    endif

    if ( valType(self:oProductGrid) == 'O' )
        fwFreeObj(self:oProductGrid)
    endif

    if ( valType(self:oFiltersGrid) == 'O' )
        fwFreeObj(self:oFiltersGrid)
    endif

    if ( valType(self:oFilterItemsGrid) == 'O' )
        fwFreeObj(self:oFilterItemsGrid)
    endif

    if ( select('F20') > 0 )
        F20->(dbCloseArea())
    endif

return
