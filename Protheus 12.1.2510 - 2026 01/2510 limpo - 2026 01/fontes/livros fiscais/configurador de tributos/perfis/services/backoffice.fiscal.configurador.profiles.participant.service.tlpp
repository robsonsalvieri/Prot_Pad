#include 'tlpp-core.th'
#include 'fwmvcdef.ch'
#include 'backoffice.fiscal.configurador.profiles.participant.service.ch'

namespace totvs.protheus.backoffice.fiscal.configurador.profiles.participantprofile.service
using namespace totvs.protheus.backoffice.fiscal.configurador.profiles.participantprofile.repository
using namespace totvs.protheus.backoffice.fiscal.lib

/*/{Protheus.doc} ParticipantProfileService
Service para gerenciamento dos perfis de participante.
@type class
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
/*/
class ParticipantProfileService

    private data oRepository as object
    private data oExceptions as object
    private data jResponse as json

    public method new() constructor

    public method getStatusCode() as numeric

    public method create(jRequest as json) as json

    public method update(cCode as character, jRequest as json) as json

    public method delete(cCode as character) as json

    public method findAll(jRequest as json) as json

    public method findOne(cCode as character) as json

    public method searchParticipants(jRequest as json, cSearchType as character) as json

    public method destroy()

endclass

/*/{Protheus.doc} ParticipantProfileService::new
Método construtor da classe ParticipantProfileService.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
@param oExceptions, object, Instância da classe de exceções
@return object, Instância da classe ParticipantProfileService
/*/
method new(oExceptions as object) class ParticipantProfileService

    self:oRepository := ParticipantProfileRepository():new()
    self:oExceptions := oExceptions
    self:jResponse := JsonObject():new()

return self

/*/{Protheus.doc} ParticipantProfileService::create
Método para inclusão de um perfil de participante.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
@param jRequest, json, Dados do perfil de participante a ser incluído
@return json, Resposta da operação de inclusão
/*/
method create(jRequest as json) as json class ParticipantProfileService

    if ( self:oRepository:exists(jRequest['code']) )
        throw self:oExceptions:badRequestException(STR0001) // 'Perfil de participante já cadastrado'
    endif

    self:oRepository:startModel(MODEL_OPERATION_INSERT)
    self:oRepository:setHeaderValues(jRequest['code'], jRequest['description'])

    self:oRepository:addParticipants(jRequest['participants'], jRequest['code'])

    if ( jRequest:hasProperty('filters') .and. !empty(jRequest['filters']) .and. self:oRepository:hasFiltersModel() )
        self:oRepository:addFilters(jRequest['filters'], jRequest['code'])
    endif

    if ( !self:oRepository:saveModel() )
        throw self:oExceptions:badRequestException(self:oRepository:getError())
    endif

    self:jResponse['success'] := .T.
    self:jResponse['message'] := fwHttpEncode(STR0002) // 'Perfil de participante incluído com sucesso'
    self:jResponse['participantProfile'] := self:oRepository:getParticipantProfileData()

    self:oRepository:endModel()

return self:jResponse

/*/{Protheus.doc} ParticipantProfileService::update
Método para atualização de um perfil de participante.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
@param cCode, character, Código do perfil de participante a ser atualizado
@param jRequest, json, Dados do perfil de participante a ser atualizado
@return json, Resposta da operação de atualização
/*/
method update(cCode as character, jRequest as json) as json class ParticipantProfileService
    
    if ( !self:oRepository:exists(cCode) )
        throw self:oExceptions:notFoundException(STR0003) // 'Perfil de participante não localizado'
    endif

    self:oRepository:startModel(MODEL_OPERATION_UPDATE)
    self:oRepository:setHeaderValues(cCode, jRequest['description'])

    if ( !self:oRepository:updateParticipants(jRequest['participants'], cCode) .or. ;
         (jRequest:hasProperty('filters') .and. !empty(jRequest['filters']) .and. self:oRepository:hasFiltersModel() .and. !self:oRepository:updateFilters(jRequest['filters'], cCode)) .or. ;
         !self:oRepository:saveModel() )       
        throw self:oExceptions:badRequestException(self:oRepository:getError())
    endif

    self:jResponse['success'] := .T.
    self:jResponse['message'] := fwHttpEncode(STR0004) // 'Perfil de participante atualizado com sucesso'
    self:jResponse['participantProfile'] := self:oRepository:getParticipantProfileData()

    self:oRepository:endModel()

return self:jResponse

/*/{Protheus.doc} ParticipantProfileService::delete
Método para exclusão de um perfil de participante.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
@param cCode, character, Código do perfil de participante a ser excluído
@return json, Resposta da operação de exclusão
/*/
method delete(cCode as character) as json class ParticipantProfileService

    if ( !self:oRepository:exists(cCode) )   
        throw self:oExceptions:notFoundException(STR0003) // 'Perfil de participante não localizado'
    endif

    self:oRepository:startModel(MODEL_OPERATION_DELETE)

    if ( !self:oRepository:saveModel() )
        throw self:oExceptions:badRequestException(self:oRepository:getError())
    endif

    self:jResponse['success'] := .T. 
    self:jResponse['message'] := fwHttpEncode(STR0005) // 'Perfil de participante excluído com sucesso'

    self:oRepository:endModel()

return self:jResponse

/*/{Protheus.doc} ParticipantProfileService::findAll
Método para consulta de todos os perfis de participante.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
@param jRequest, json, Dados da requisição
@return json, Resposta da operação de consulta
/*/
method findAll(jRequest as json) as json class ParticipantProfileService

    local aParticipantProfiles as array
    local cFilter as character
    local nPage := 1 as numeric
    local nPageSize := 15 as numeric
    local lHasNext as logical
    local lEnableFilters as logical

    if ( jRequest:hasProperty('filter') .and. jRequest['filter'] != nil )
        cFilter := '%' + upper(allTrim(jRequest['filter'])) + '%'
    endif

    if ( jRequest:hasProperty('page') .and. jRequest['page'] != nil )
        nPage := val(jRequest['page'])
    endif

    if ( jRequest:hasProperty('pageSize') .and. jRequest['pageSize'] != nil )
        nPageSize := val(jRequest['pageSize'])
    endif

    aParticipantProfiles := self:oRepository:findAll(cFilter, nPage, nPageSize, @lHasNext, @lEnableFilters)

    self:jResponse['success'] := .T.
    self:jResponse['message'] := fwHttpEncode(STR0006) // 'Registros localizados com sucesso'

    if ( len(aParticipantProfiles) == 0 )         
        throw self:oExceptions:notFoundException(STR0007) // 'Nenhum registro localizado'
    endif

    self:jResponse['participantProfiles'] := aParticipantProfiles
    self:jResponse['hasNext'] := lHasNext
    self:jResponse['total'] := len(aParticipantProfiles)
    self:jResponse['page'] := nPage
    self:jResponse['pageSize'] := nPageSize
    self:jResponse['enableFilters'] := lEnableFilters

return self:jResponse

/*/{Protheus.doc} ParticipantProfileService::findOne
Método para consulta de um perfil de participante pelo código.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
@param cCode, character, Código do perfil de participante a ser consultado
@return json, Resposta da operação de consulta
/*/
method findOne(cCode as character) as json class ParticipantProfileService

    if ( !self:oRepository:exists(cCode) ) 
        throw self:oExceptions:notFoundException(STR0007) // 'Nenhum registro localizado'
    endif

    self:oRepository:startModel(MODEL_OPERATION_VIEW)

    self:jResponse['success'] := .T.
    self:jResponse['message'] := fwHttpEncode(STR0008) // 'Registro localizado com sucesso'
    self:jResponse['participantProfile'] := self:oRepository:getParticipantProfileData()

    self:oRepository:endModel()

return self:jResponse

/*/{Protheus.doc} ParticipantProfileService::searchParticipants
Método para busca de Participantes de acordo com o tipo (Cliente ou Fornecedor) e os filtros.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 10/11/2025
@param jRequest, json, Dados da requisição
@param cSearchType, character, Tipo de busca (count (apenas contagem); list (listagem dos participantes))
@return json, Resposta da operação de consulta
/*/
method searchParticipants(jRequest as json, cSearchType as character) as json class ParticipantProfileService

    local xReturn as variant
    local aParticipants as array
    local cTypeCode := jRequest['type']['code'] as character
    local aItems := jRequest['items'] as array
    local nPage := 1 as numeric
    local nPageSize := 15 as numeric
    local lHasNext as logical

    if ( jRequest:hasProperty('page') .and. jRequest['page'] != nil )
        nPage := jRequest['page']
    endif

    if ( jRequest:hasProperty('pageSize') .and. jRequest['pageSize'] != nil )
        nPageSize := jRequest['pageSize']
    endif    

    asort(aItems,,,{|x,y| x['key'] < y['key']}) // Ordena o array pela Chave (Key)
    
    xReturn := self:oRepository:searchParticipants(cTypeCode, aItems, cSearchType, nPage, nPageSize, @lHasNext)

    self:jResponse['success'] := .T.
    self:jResponse['message'] := fwHttpEncode(STR0006) // 'Registros localizados com sucesso'

    if ( cSearchType == 'count' )
        if ( xReturn == 0 )
            self:jResponse['message'] := fwHttpEncode(STR0007) // 'Nenhum registro localizado'
        endif

        self:jResponse['total'] := xReturn
    else
        aParticipants := xReturn
        if ( len(aParticipants) == 0 )
            self:jResponse['message'] := fwHttpEncode(STR0007) // 'Nenhum registro localizado'
        endif

        self:jResponse['participants'] := aParticipants
        self:jResponse['hasNext'] := lHasNext
        self:jResponse['total'] := len(aParticipants)
        self:jResponse['page'] := nPage
        self:jResponse['pageSize'] := nPageSize        
    endif

return self:jResponse

/*/{Protheus.doc} ParticipantProfileService::destroy
Método destrutor da classe ParticipantProfileService.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
/*/
method destroy() class ParticipantProfileService

    self:oRepository:destroy()
    fwFreeObj(self:oRepository)
    
    fwFreeObj(self:jResponse)
    self:jResponse := nil

return
