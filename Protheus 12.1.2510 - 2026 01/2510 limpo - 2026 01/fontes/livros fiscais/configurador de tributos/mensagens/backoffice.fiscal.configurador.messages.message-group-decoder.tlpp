#Include 'Protheus.ch'
#Include 'MessageGroupDecoder.ch'
#Include 'Matxdef.ch'
#Include 'tlpp-core.th'

Using Namespace totvs.protheus.backoffice.fiscal.configurador.messages.messagegroup

/*/{Protheus.doc} MessageGroupDecoder
Classe que decodifica as mensagens do grupo de mensagens.
@type class
@version 12.1.2410
@author Juliano Fernandes
@since 23/05/2025
/*/
Class MessageGroupDecoder

    Private Data cMessageGroupCode as character
    Private Data cInvoiceType as character
    Private Data cPurposeCode as character
    Private Data jMessageGroup as json
    Private Data cDecodingId as character
    Private Data lMatxfisInUse as logical
    Private Data lError as logical
    Private Data cErrorMessage as character
    Private Data lSuccess as logical
    Private Data cMessage as character
    Private Data cDetailedMessage as character
    Private Data jDecodedMessages as json
    Private Data cIdentifierType as character
    Private Data jProcessedMessages as json
    Private Data jQueriesCache as json

    Public Method new() Constructor
    Private Method getMessageGroupData() as json
    Private Method hasMessages() as logical
    Private Method setInvoiceType()
    Public Method setPurposeCode(cInvoiceType as character) as character
    Private Method setMessageGroup(cMessageGroupCode as character)
    Private Method setDecodingId(cDecodingId as character)
    Private Method setIdentifierType(cOrigin)
    Private Method validateDecodingId() as logical
    Private Method validateMatxfisInUse(aInvoiceHeader as array, aInvoiceItems as array, aNature as array) as logical
    Public Method decode(aInvoiceHeader as array, aInvoiceItems as array, aNature as array) as json
    Private Method processData(aInvoiceItems as array) as array
    Private Method createDecodedMessage(jDecodedMessage as json) as character
    Public Method getDecodedMessages(cDecodingId as character) as json
    Public Method delete(cTransactionType as character, cInvoiceNumber as character, cSerie as character, cCustomerSupplier as character, cStore as character)
    Private Method getMessageGroupsForDecoding(cType as character, cTaxRuleCode as character, cBookkeepingRuleId as character, cOperationProfileCode as character, cCfop as character, cOperationType as character, cIssCode as character) as array
    Public Method parseMemoField(cField as character, cDBType as character) as character
    Private Method restoreDefaultValues()
    Public Method destroy()

EndClass

/*/{Protheus.doc} MessageGroupDecoder::new
Construtor da classe MessageGroupDecoder.
@type method
@version 12.1.2410
@author Juliano Fernandes
@since 23/05/2025
@return object, Instância da classe MessageGroupDecoder
/*/
Method new() Class MessageGroupDecoder
Return self

/*/{Protheus.doc} MessageGroupDecoder::getMessageGroupData
Método que busca os dados do grupo de mensagens.
@type method
@version 12.1.2410
@author Juliano Fernandes
@since 23/05/2025
@return json, Objeto JSON com os dados do grupo de mensagens
/*/
Method getMessageGroupData() as json Class MessageGroupDecoder

    Local jMessageGroup as json
    Local aIdentifiers := {} as array
    Local cMessageCode as character
    Local aMessages := {} as array
    Local cQuery as character
    Local oStatement as object
    Local cAlias as character
    Local cPurposeDescription as character

    cQuery += ' SELECT CK7_CODIGO, CK7_DESC, CK7_ID, '
    cQuery += ' 	CK9_CODFIN, CK9_CODMSG, CJ8_DESC, ?, '
    cQuery += ' 	CK8_CODIDE, CK6_DESC, CK8_TIPO '
    cQuery += ' FROM ' + RetSqlName('CK7') + ' CK7 '
    cQuery += ' 	INNER JOIN ' + RetSqlName('CK9') + ' CK9 '
    cQuery += ' 		ON CK9_FILIAL = ? '
    cQuery += ' 		AND CK9_IDGRUP = CK7_ID '
    cQuery += ' 		AND CK9_CODIDE = ? '
    cQuery += ' 		AND CK9_CODFIN = ? '
    cQuery += ' 		AND CK9.D_E_L_E_T_ = ? '
    cQuery += ' 	INNER JOIN ' + RetSqlName('CK8') + ' CK8 '
    cQuery += ' 		ON CK8_FILIAL = ? '
    cQuery += ' 		AND CK8_IDGRUP = CK9_IDGRUP '
    cQuery += ' 		AND CK8_CODFIN = CK9_CODFIN '
    cQuery += ' 		AND CK8_CODMSG = CK9_CODMSG '
    cQuery += ' 		AND CK8_TIPO = ? '
    cQuery += ' 		AND CK8.D_E_L_E_T_ = ? '
    cQuery += ' 	INNER JOIN ' + RetSqlName('CK6') + ' CK6 '
    cQuery += ' 		ON CK6_FILIAL = ? '
    cQuery += ' 		AND CK6_CODIGO = CK8_CODIDE '
    cQuery += ' 		AND CK6.D_E_L_E_T_ = ? '
    cQuery += ' 	INNER JOIN ' + RetSqlName('CJ8') + ' CJ8 '
    cQuery += ' 		ON CJ8_FILIAL = ? '
    cQuery += ' 		AND CJ8_CODREF = CK9_CODMSG '
    cQuery += ' 		AND CJ8.D_E_L_E_T_ = ? '
    cQuery += ' WHERE CK7_FILIAL = ? '
    cQuery += ' 	AND CK7_CODIGO = ? '
    cQuery += ' 	AND CK7_ALTERA = ? '
    cQuery += ' 	AND CK7.D_E_L_E_T_ = ? '

    oStatement := FwExecStatement():New( ChangeQuery(cQuery) )

    oStatement:SetUnsafe(01, self:parseMemoField('CJ8_MENSG',Upper(TcGetDb())))
    oStatement:SetString(02, FWxFilial('CK9'))
    oStatement:SetString(03, ' ')
    oStatement:SetString(04, self:cPurposeCode)
    oStatement:SetString(05, ' ')
    oStatement:SetString(06, FWxFilial('CK8'))
    oStatement:SetString(07, self:cIdentifierType)
    oStatement:SetString(08, ' ')
    oStatement:SetString(09, FWxFilial('CK6'))
    oStatement:SetString(10, ' ')
    oStatement:SetString(11, FWxFilial('CJ8'))
    oStatement:SetString(12, ' ')
    oStatement:SetString(13, FWxFilial('CK7'))
    oStatement:SetString(14, self:cMessageGroupCode)
    oStatement:SetString(15, '2')
    oStatement:SetString(16, ' ')

    cAlias := oStatement:OpenAlias(GetNextAlias())

    While ( !(cAlias)->(EoF()) )
        If ( jMessageGroup == Nil )
            jMessageGroup := 							;
                {                                       ;
                    'code': (cAlias)->CK7_CODIGO,       ;
                    'description': (cAlias)->CK7_DESC,	;
                    'id': (cAlias)->CK7_ID,             ;
                    'messages': Array(0)                ;
                }                                       ;           

            aMessages := jMessageGroup['messages']
        EndIf

        If ( cMessageCode != (cAlias)->CK9_CODMSG )
            cMessageCode := (cAlias)->CK9_CODMSG

            cPurposeDescription := GetPurposeDescription((cAlias)->CK9_CODFIN)

            Aadd(aMessages,                                     ;
                {                                               ;
                    'purpose': {                                ;
                        'code': (cAlias)->CK9_CODFIN,           ; 
                        'description': cPurposeDescription      ;
                    },                                          ;
                    'message': {                                ;
                        'code': (cAlias)->CK9_CODMSG,           ; 
                        'description': (cAlias)->CJ8_DESC,      ;
                        'encodedMessage': (cAlias)->CJ8_MENSG   ;
                    },                                          ;
                    'identifiers': Array(0)                     ;
                }                                               ;
            )

            aIdentifiers := aMessages[Len(aMessages)]['identifiers']
        EndIf

        Aadd(aIdentifiers,                          ;
            {                                       ;
                'code': (cAlias)->CK8_CODIDE,       ;
                'description': (cAlias)->CK6_DESC,  ;
                'type': (cAlias)->CK8_TIPO          ;
            }                                       ;
        )

        (cAlias)->(DbSkip())
    EndDo

    (cAlias)->(DbCloseArea())

    oStatement:Destroy()
    FWFreeObj(oStatement)

Return jMessageGroup

/*/{Protheus.doc} MessageGroupDecoder::hasMessages
Método que verifica se o grupo de mensagens possui mensagens.
@type method
@version 12.1.2410
@author Juliano Fernandes
@since 29/05/2025
@return logical, Retorna .T. se o grupo de mensagens possui mensagens, caso contrário retorna .F.
/*/
Method hasMessages() as logical Class MessageGroupDecoder

    Local lHasMessages := self:jMessageGroup != Nil as logical

Return lHasMessages

/*/{Protheus.doc} MessageGroupDecoder::setInvoiceType
Método que define o tipo da Nota Fiscal conforme o array aNFCab.
@type method
@version 12.1.2410
@author Juliano Fernandes
@since 28/05/2025
/*/
Method setInvoiceType() Class MessageGroupDecoder

    self:cInvoiceType := AllTrim(MaFisRet(,'NF_TIPONF'))

Return

/*/{Protheus.doc} MessageGroupDecoder::setPurposeCode
Método que define o código do finalidade conforme o tipo da Nota Fiscal.
@type method
@version 12.1.2410
@author Juliano Fernandes
@since 28/05/2025
@param cInvoiceType, character, Tipo da Nota Fiscal
@return character, Código da finalidade
/*/
Method setPurposeCode(cInvoiceType as character) as character Class MessageGroupDecoder

    Do Case
        Case ( cInvoiceType == 'N' ) // N = Normal
            self:cPurposeCode := '1'
        Case ( cInvoiceType == 'D' ) // D = Devolução
            self:cPurposeCode := '2'
        Case ( cInvoiceType == 'B' ) // B = Beneficiamento
            self:cPurposeCode := '3'
        Case ( cInvoiceType == 'I' ) // I = Complemento ICMS
            self:cPurposeCode := '4'
        Case ( cInvoiceType == 'P' ) // P = Complemento IPI
            self:cPurposeCode := '5'
        Case ( cInvoiceType == 'C' ) // C = Complemento Preço
            self:cPurposeCode := '6'
    EndCase

Return self:cPurposeCode

/*/{Protheus.doc} MessageGroupDecoder::setMessageGroup
Método que define o grupo de mensagens.
@type method
@version 12.1.2410
@author Juliano Fernandes
@since 23/05/2025
@param cMessageGroupCode, character, Código do Grupo de Mensagens
/*/
Method setMessageGroup(cMessageGroupCode as character) Class MessageGroupDecoder

    self:cMessageGroupCode := cMessageGroupCode
    self:jMessageGroup := self:getMessageGroupData()

Return

/*/{Protheus.doc} MessageGroupDecoder::setIdentifierType
Método que define o tipo do identificador.
@type method
@version 12.1.2410
@author Juliano Fernandes
@since 22/07/2025
/*/
Method setIdentifierType(cOrigin as character) Class MessageGroupDecoder

    Do Case
        Case ( cOrigin == 'PER_OPERAC' ) // Perfil de Operação
            self:cIdentifierType := '1'
        Case ( cOrigin == 'REG_ESCRIT' ) // Regra de Escrituração
            self:cIdentifierType := '2'
        Case ( cOrigin == 'REG_CALCUL' ) // Regra de Cálculo
            self:cIdentifierType := '3'
    EndCase

Return

/*/{Protheus.doc} MessageGroupDecoder::setDecodingId
Método que define o Id de Decodificação.
@type method
@version 12.1.2410
@author Juliano Fernandes
@since 23/05/2025
@param cDecodingId, character, Id de Decodificação
/*/
Method setDecodingId(cDecodingId as character) Class MessageGroupDecoder

    self:cDecodingId := cDecodingId

Return

/*/{Protheus.doc} MessageGroupDecoder::validateDecodingId
Método que valida o Id de Decodificação.
@type method
@version 12.1.2410
@author Juliano Fernandes
@since 23/05/2025
@return logical, Retorna .T. se o Id de Decodificação for válido, caso contrário retorna .F.
/*/
Method validateDecodingId() as logical Class MessageGroupDecoder

    Local lValid := .T. as logical

    If ( Empty(self:cDecodingId) )
        lValid := .F.
        self:lError := .T.
        self:cErrorMessage := STR0003 // 'Id de Decodificação não pode ser vazio.'
    EndIf

    If ( lValid .And. Empty(Posicione('CKA',1,FWxFilial('CKA') + self:cDecodingId,'CKA_ID')) )
        lValid := .F.
        self:lError := .T.
        self:cErrorMessage := STR0004 // 'Id de Decodificação não encontrado.'
    EndIf

Return lValid

/*/{Protheus.doc} MessageGroupDecoder::validateMatxfisInUse
Método que valida se a MATXFIS está em uso.
@type method
@version 12.1.2410
@author Juliano Fernandes
@since 23/05/2025
@param aInvoiceHeader, array, Cabeçalho da Nota Fiscal (MATXFIS - aNFCab)
@param aInvoiceItems, array, Itens da Nota Fiscal (MATXFIS - aNFItem)
@param aNature, array, Natureza (MATXFIS - aInfNat)
@return logical, Retorna .T. se a MATXFIS estiver em uso, caso contrário retorna .F.
/*/
Method validateMatxfisInUse(aInvoiceHeader as array, aInvoiceItems as array, aNature as array) as logical Class MessageGroupDecoder
    
    Local lValid := .T. as logical

    self:lMatxfisInUse := MaFisFound('NF')

    If ( ( Empty(aInvoiceHeader) .And. Empty(aInvoiceItems) .And. Empty(aNature) ) .Or. ( !self:lMatxfisInUse ) )
        lValid := .F.
        self:lError := .T.
        self:cErrorMessage := STR0005 // 'MATXFIS não está em uso.'
    EndIf

Return lValid

/*/{Protheus.doc} MessageGroupDecoder::decode
Método que decodifica as mensagens do grupo de mensagens.
@type method
@version 12.1.2410
@author Juliano Fernandes
@since 23/05/2025
@param aInvoiceHeader, array, Cabeçalho da Nota Fiscal (MATXFIS - aNFCab)
@param aInvoiceItems, array, Itens da Nota Fiscal (MATXFIS - aNFItem)
@param aNature, array, Natureza (MATXFIS - aInfNat)
@return json, Objeto JSON com as mensagens decodificadas
/*/
Method decode(aInvoiceHeader as array, aInvoiceItems as array, aNature as array) as json Class MessageGroupDecoder

    Local oHMCad as object
    Local lBuild := .T. as logical
    Local cIdentifierCode as character
    Local cMessageCode as character
    Local cPurposeCode as character
    Local cEncodedMessage as character
    Local aRetHash := {} as array
    Local cDecodedMessage as character
    Local cMessageId as character
    Local i as integer
    Local j as integer
    Local nI as numeric
    Local jIdentifier as json
    Local jMessage as json
    Local jPurpose as json
    Local aDecodedMessages := {} as array
    Local aProcessData as array
    Local jProcessData as json
    Local cMessageGroupCode as character
    Local aItems as array
    Local cOrigin as character
    Local cTaxId as character
    Local cTaxCode as character

    self:restoreDefaultValues()

    If ( !self:validateMatxfisInUse(aInvoiceHeader,aInvoiceItems,aNature) )
        self:lSuccess := .F.
        self:cMessage := STR0006 // 'Falha ao decodificar mensagens do grupo.'
        self:cDetailedMessage := self:cErrorMessage
    EndIf    
    
    If ( !self:lError )
        Begin Transaction
        
            self:setDecodingId(FWUUIDV4(.T.))
            self:setInvoiceType()
            self:setPurposeCode(self:cInvoiceType)

            aProcessData := self:processData(aInvoiceItems)

            DbSelectArea('CJL')
            DbSelectArea('CKA')

            For nI := 1 To Len(aProcessData)
                jProcessData := aProcessData[nI]

                cMessageGroupCode := jProcessData['messageGroupCode']
                aItems := jProcessData['items']
                cOrigin := jProcessData['origin']
                cTaxId := jProcessData['taxId']
                cTaxCode := jProcessData['taxCode']
                    
                self:setIdentifierType(cOrigin)
                self:setMessageGroup(cMessageGroupCode)
                
                If ( self:hasMessages() )
                    For i := 1 To Len(self:jMessageGroup['messages'])
                        jMessage := self:jMessageGroup['messages'][i]
                        cMessageCode := jMessage['message']['code']
                        cEncodedMessage := jMessage['message']['encodedMessage']

                        jPurpose := jMessage['purpose']
                        cPurposeCode := jPurpose['code']

                        For j := 1 To Len(jMessage['identifiers'])
                            jIdentifier := jMessage['identifiers'][j]                
                            cIdentifierCode := jIdentifier['code']

                            cMessageId := ''
                            cDecodedMessage := ''

                            If ( self:jProcessedMessages:HasProperty(cTaxId + '-' + cMessageCode) )
                                cMessageId := self:jProcessedMessages[cTaxId + '-' + cMessageCode]
                            Else
                                cDecodedMessage := MensagRef(oHMCad,lBuild,aInvoiceHeader,aInvoiceItems,aNature,cEncodedMessage,aItems,aRetHash)
                            EndIf

                            cMessageId := self:createDecodedMessage(	;
                                {										;
                                    'messageId': cMessageId,	        ;
                                    'identifierCode': cIdentifierCode,	;
                                    'messageCode': cMessageCode,		;
                                    'purposeCode': cPurposeCode,		;
                                    'decodedMessage': cDecodedMessage,	;
                                    'origin': cOrigin,					;
                                    'taxId': cTaxId,					;
                                    'taxCode': cTaxCode					;
                                }                                       ;
                            )

                            Aadd(aDecodedMessages,                           	;
                                {                                           	;
                                    'identifier': cIdentifierCode,    			;
                                    'message': { 								;
                                        'code': cMessageCode, 				    ;
                                        'decodedMessage': cDecodedMessage 		;
                                    },											;
                                    'purpose': { 								;
                                        'code': cPurposeCode,   			    ;
                                        'description': jPurpose['description']	;
                                    }   										;
                                }                                           	;
                            )

                            self:jProcessedMessages[cTaxId + '-' + cMessageCode] := cMessageId
                        Next j
                    Next i
                EndIf    
            Next nI

            CJL->(DbCloseArea())
            CKA->(DbCloseArea())

            FWFreeArray(aProcessData)

        End Transaction
    EndIf

    self:jDecodedMessages := 		    			    ;
        { 												;
            'success': self:lSuccess, 					;
            'message': self:cMessage, 					;
            'detailedMessage': self:cDetailedMessage, 	;
            'id': self:cDecodingId, 					;
            'decodedMessages': aDecodedMessages 	    ;
        }
    
Return self:jDecodedMessages

/*/{Protheus.doc} MessageGroupDecoder::processData
Método que processa os dados dos itens da Nota Fiscal para decodificação ou exclusão das mensagens do grupo.
@type method
@version 12.1.2410
@author Juliano Fernandes
@since 28/07/2025
@param aInvoiceItems, array, Itens da Nota Fiscal (MATXFIS - aNFItem)
@return array, Array com os dados processados
/*/
Method processData(aInvoiceItems as array) as array Class MessageGroupDecoder

    Local aMessageGroups as array
	Local cMessageGroupCode as character
	Local cItem as character
	Local cTaxId as character
	Local cTaxCode as character
    Local cBookkeepingRuleId as character
    Local cTaxRuleCode as character
    Local cOperationProfileCode as character
    Local cCfop as character
    Local cOperationType as character
    Local cIssCode as character
	Local nI as numeric
	Local nJ as numeric
	Local nK as numeric
    Local aProcessData := {} as array

    For nI := 1 To Len(aInvoiceItems)
        cItem := aInvoiceItems[nI][IT_ITEM]

        cTaxId := aInvoiceItems[nI][IT_ID_LOAD_TRBGEN]

        If ( Empty(cTaxId) )
            cTaxId := aInvoiceItems[nI][IT_ID_TRBGEN]
        EndIf

        For nJ := 1 To Len(aInvoiceItems[nI][IT_TRIBGEN])
            cTaxCode := aInvoiceItems[nI][IT_TRIBGEN][nJ][TG_IT_SIGLA]

            cBookkeepingRuleId := aInvoiceItems[nI][IT_TRIBGEN][nJ][TG_IT_REGRA_ESCR][RE_ID]

            // Busca o Grupo de Mensagens da Regra de Escrituração
            aMessageGroups := self:getMessageGroupsForDecoding('REG_ESCRIT',,cBookkeepingRuleId)

            For nK := 1 To Len(aMessageGroups)
                cMessageGroupCode := aMessageGroups[nK]

                If ( !Empty(cMessageGroupCode) )
                    Aadd(aProcessData,                              ; 
                        {                                           ;
                            'messageGroupCode': cMessageGroupCode,  ; 
                            'items': {cItem},                       ; 
                            'origin': 'REG_ESCRIT',                 ;
                            'taxId': cTaxId,                        ; 
                            'taxCode': cTaxCode                     ;
                        }                                           ;
                    )
                EndIf
            Next nK

            cTaxRuleCode := aInvoiceItems[nI][IT_TRIBGEN][nJ][TG_IT_SIGLA]

            // Busca o Grupo de Mensagens da Regra de Cálculo
            aMessageGroups := self:getMessageGroupsForDecoding('REG_CALCUL',cTaxRuleCode)

            For nK := 1 To Len(aMessageGroups)
                cMessageGroupCode := aMessageGroups[nK]

                If ( !Empty(cMessageGroupCode) )
                    Aadd(aProcessData,                              ; 
                        {                                           ;
                            'messageGroupCode': cMessageGroupCode,  ;
                            'items': {cItem},                       ;
                            'origin': 'REG_CALCUL',                 ;
                            'taxId': cTaxId,                        ;
                            'taxCode': cTaxCode                     ;
                        }                                           ;
                    )
                EndIf
            Next nK

            cOperationProfileCode := aInvoiceItems[nI][IT_TRIBGEN][nJ][TG_IT_PERFOP][OP_COD]
            cCfop := aInvoiceItems[nI][IT_CF]
            cOperationType := aInvoiceItems[nI][IT_TPOPER]
            cIssCode := aInvoiceItems[nI][IT_CODISS] 

            if Empty(cIssCode)
                cIssCode := " "
            endIf

            // Busca o Grupo de Mensagens do Perfil de Operação
            aMessageGroups := self:getMessageGroupsForDecoding('PER_OPERAC',,,cOperationProfileCode,cCfop,cOperationType,cIssCode)

            For nK := 1 To Len(aMessageGroups)
                cMessageGroupCode := aMessageGroups[nK]

                If ( !Empty(cMessageGroupCode) )
                    Aadd(aProcessData,                              ; 
                        {                                           ;
                            'messageGroupCode': cMessageGroupCode,  ;
                            'items': {cItem},                       ;
                            'origin': 'PER_OPERAC',                 ;
                            'taxId': cTaxId,                        ;
                            'taxCode': cTaxCode                     ;
                        }                                           ;
                    )
                EndIf
            Next nK
        Next nJ
    Next nI

Return aProcessData

/*/{Protheus.doc} MessageGroupDecoder::createDecodedMessage
Método que grava as mensagens decodificadas nas tabelas CJL e CKA.
@type method
@version 12.1.2410
@author Juliano Fernandes
@since 23/05/2025
@param jDecodedMessage, json, Objeto JSON com a mensagem decodificada
@return character, Id da mensagem decodificada
/*/
Method createDecodedMessage(jDecodedMessage as json) as character Class MessageGroupDecoder

    Local cIdCJL := jDecodedMessage['messageId'] as character

    If ( Empty(cIdCJL) )
        cIdCJL := FWUUIDV4(.T.)

        CJL->(Reclock('CJL',.T.))
        CJL->CJL_FILIAL := FWxFilial('CJL')
        CJL->CJL_ID := cIdCJL
        CJL->CJL_CODMSG := jDecodedMessage['messageCode']
        CJL->CJL_INDICE := '04'
        CJL->CJL_MENSG := jDecodedMessage['decodedMessage']
        CJL->(MsUnlock())
    EndIf

    CKA->(Reclock('CKA',.T.))    
    CKA->CKA_FILIAL := FWxFilial('CKA')
    CKA->CKA_ID := self:cDecodingId
    CKA->CKA_IDGRUP := self:jMessageGroup['id']
    CKA->CKA_IDMSGD := cIdCJL
    CKA->CKA_CODIDE := jDecodedMessage['identifierCode']
    CKA->CKA_CODFIN := jDecodedMessage['purposeCode']
    CKA->CKA_ORIGEM := jDecodedMessage['origin']
    CKA->CKA_IDTRIB := jDecodedMessage['taxId']
    CKA->CKA_CODIGO := GetSX8Num('CKA','CKA_CODIGO')
    CKA->CKA_TRIB := jDecodedMessage['taxCode']
    CKA->(MsUnlock())

    ConfirmSX8()

Return cIdCJL

/*/{Protheus.doc} MessageGroupDecoder::getDecodedMessages
Método que retorna as mensagens decodificadas.
@type method
@version 12.1.2410
@author Juliano Fernandes
@since 23/05/2025
@param cDecodingId, character, Id de Decodificação
@return json, Objeto JSON com as mensagens decodificadas
/*/
Method getDecodedMessages(cDecodingId as character) as json Class MessageGroupDecoder

    Local cQuery as character
    Local oStatement as object
    Local cAlias as character
    Local aDecodedMessages := {} as array

    self:restoreDefaultValues()

    self:setDecodingId(cDecodingId)

    If ( !self:validateDecodingId() )
        self:lSuccess := .F.
        self:cMessage := STR0007 // 'Falha ao buscar as mensagens decodificadas.'
        self:cDetailedMessage := self:cErrorMessage
    EndIf

    If ( !self:lError )
        cQuery += ' SELECT CKA_IDMSGD, CKA_CODIGO, CKA_CODIDE, ? , CKA_ORIGEM, CKA_TRIB, CKA_CODFIN, CJL_CODMSG, CKA_IDTRIB, CK6_PROPRI, CK6_OBRACE, CK6_FINALI, CK6_ID '
        cQuery += ' FROM ' + RetSqlName('CKA') + ' CKA '
        cQuery += '     INNER JOIN ' + RetSqlName('CK6') + ' CK6'
        cQuery += '         ON CK6_FILIAL = ?'
        cQuery += '         AND CK6.CK6_CODIGO = CKA.CKA_CODIDE '
        cQuery += '         AND CK6.D_E_L_E_T_ = ? '
        cQuery += '     INNER JOIN ' + RetSqlName('CJL') + ' CJL '
        cQuery += '         ON CJL_FILIAL = ? '
        cQuery += '         AND CJL_ID = CKA_IDMSGD '
        cQuery += '         AND CJL.D_E_L_E_T_ = ? '
        cQuery += ' WHERE CKA_FILIAL = ? '
        cQuery += '     AND CKA_ID = ? '
        cQuery += '     AND CKA.D_E_L_E_T_ = ? '

        oStatement := FwExecStatement():New( ChangeQuery(cQuery) )

        oStatement:SetUnsafe(1, self:parseMemoField('CJL_MENSG',Upper(TcGetDb())))
        oStatement:SetString(2, FWxFilial('CK6'))
        oStatement:SetString(3, ' ')
        oStatement:SetString(4, FWxFilial('CJL'))
        oStatement:SetString(5, ' ')
        oStatement:SetString(6, FWxFilial('CKA'))
        oStatement:SetString(7, self:cDecodingId)
        oStatement:SetString(8, ' ')

        cAlias := oStatement:OpenAlias(GetNextAlias())

        While ( !(cAlias)->(EoF()) )
            Aadd(aDecodedMessages,						;
                {										;
                    'id': (cAlias)->CKA_IDMSGD,			;
                    'code': (cAlias)->CKA_CODIGO,		;
                    'origin': (cAlias)->CKA_ORIGEM,     ;
                    'taxCode': (cAlias)->CKA_TRIB,      ;
                    'purpose': AllTrim((cAlias)->CKA_CODFIN),    ;
                    'idtrib': (cAlias)->CKA_IDTRIB,     ;
                    'identifier': {                     ;
                        'code': AllTrim((cAlias)->CKA_CODIDE),;
                        'ancillaryObligation': AllTrim((cAlias)->CK6_OBRACE),;
                        'messageDestination': AllTrim((cAlias)->CK6_FINALI),;
                        'id': AllTrim((cAlias)->CK6_ID)},;
                    'decoded': {                        ;
                        'message':  AllTrim((cAlias)->CJL_MENSG),;
                        'code':     AllTrim((cAlias)->CJL_CODMSG)};
                }										;
            )

            (cAlias)->(DbSkip())
        EndDo

        (cAlias)->(DbCloseArea())

        oStatement:Destroy()
        FWFreeObj(oStatement)
    EndIf

    self:jDecodedMessages :=							;
		{                                               ;
			'success': self:lSuccess,                   ;
			'message': self:cMessage,                   ;
			'detailedMessage': self:cDetailedMessage,   ;
			'id': self:cDecodingId,                     ;
			'decodedMessages': aDecodedMessages         ;
		}

Return self:jDecodedMessages

/*/{Protheus.doc} MessageGroupDecoder::delete
Método que deleta as mensagens decodificadas do grupo de mensagens.
@type method
@version 12.1.2410
@author Juliano Fernandes
@since 22/07/2025
@param cTransactionType, character, Tipo de transação (E=Entrada, S=Saída)
@param cInvoiceNumber, character, Número da Nota Fiscal
@param cSerie, character, Série da Nota Fiscal
@param cCustomerSupplier, character, Código do Cliente/Fornecedor
@param cStore, character, Código da Loja
/*/
Method delete(cTransactionType as character, cInvoiceNumber as character, cSerie as character, cCustomerSupplier as character, cStore as character) Class MessageGroupDecoder

    Local cQuery as character
    Local oStatement as object
    Local cAlias as character
    Local cTaxId as character

    cQuery += ' SELECT FT_IDTRIB '
    cQuery += ' FROM ' + RetSqlName('SFT')
    cQuery += ' WHERE FT_FILIAL = ? '
    cQuery += '     AND FT_TIPOMOV = ? '
    cQuery += '     AND FT_SERIE = ? '
    cQuery += '     AND FT_NFISCAL = ? '
    cQuery += '     AND FT_CLIEFOR = ? '
    cQuery += '     AND FT_LOJA = ? '
    cQuery += '     AND D_E_L_E_T_ = ? '

    oStatement := FwExecStatement():New( ChangeQuery(cQuery) )

    oStatement:SetString(1, FWxFilial('SFT'))
    oStatement:SetString(2, cTransactionType)
    oStatement:SetString(3, cSerie)
    oStatement:SetString(4, cInvoiceNumber)
    oStatement:SetString(5, cCustomerSupplier)
    oStatement:SetString(6, cStore)
    oStatement:SetString(7, ' ')

    cAlias := oStatement:OpenAlias(GetNextAlias())

    While ( !(cAlias)->(EoF()) )
        cTaxId := (cAlias)->FT_IDTRIB

        If ( !Empty(cTaxId) )
            DbSelectArea('CKA')
            CKA->(DbSetOrder(4)) // CKA_FILIAL+CKA_IDTRIB
            While ( CKA->(MSSeek(FWxFilial('CKA') + cTaxId)) )
                DbSelectArea('CJL')
                CJL->(DbSetOrder(1)) // CJL_FILIAL+CJL_ID+CJL_INDICE+CJL_CODMSG
                While ( CJL->(MSSeek(FWxFilial('CJL') + CKA->CKA_IDMSGD + '04')) )
                    CJL->(Reclock('CJL',.F.))

                    CJL->(DbDelete())

                    CJL->(MsUnlock())
                EndDo

                CJL->(DbCloseArea())

                CKA->(Reclock('CKA',.F.))

                CKA->(DbDelete())

                CKA->(MsUnlock())
            EndDo

            CKA->(DbCloseArea())
        EndIf        

        (cAlias)->(DbSkip())
    EndDo
    
    (cAlias)->(DbCloseArea())
    
    oStatement:Destroy()
    FWFreeObj(oStatement)

Return

/*/{Protheus.doc} MessageGroupDecoder::getMessageGroupsForDecoding
Método que busca os grupos de mensagens para decodificação conforme o tipo, Perfil de Operação, Regra de Escrituração ou Regra de Cálculo.
@type method
@version 12.1.2410
@author Juliano Fernandes
@since 06/08/2025
@param cType, character, Tipo de busca (PER_OPERAC=Perfil de Operação, REG_ESCRIT=Regra de Escrituração, REG_CALCUL=Regra de Cálculo)
@param cTaxRuleCode, character, Código da Regra de Cálculo
@param cBookkeepingRuleId, character, ID da Regra de Escrituração
@param cOperationProfileCode, character, Código do Perfil de Operação
@param cCfop, character, Código do CFOP
@param cOperationType, character, Tipo de Operação
@param cIssCode, character, Código do ISS
@return array, Array com os grupos de mensagens encontrados
/*/
Method getMessageGroupsForDecoding(cType as character, cTaxRuleCode as character, cBookkeepingRuleId as character, cOperationProfileCode as character, cCfop as character, cOperationType as character, cIssCode as character) as array Class MessageGroupDecoder

	Local aMessageGroups := {} as array
	Local cQuery as character
	Local aParams := {} as array
	Local oStatement as object
	Local nI as numeric
	Local cAlias as character

	If ( cType == 'PER_OPERAC' )

        If ( self:jQueriesCache['PER_OPERAC'] == Nil )
            cQuery += ' SELECT CKC.CKC_MSGCOD MSGCOD '
            cQuery += ' FROM ' + RetSqlName('CKC') + ' CKC '
            cQuery += ' WHERE CKC.CKC_FILIAL = ? '
            cQuery += '     AND CKC.CKC_CODIGO = ? '
            cQuery += '     AND ( '
            cQuery += '         CKC.CKC_CFOP = ? '
            cQuery += '         OR ( '
            cQuery += '             CKC.CKC_CFOP = ? '
            cQuery += '             AND EXISTS ( '
            cQuery += '                 SELECT 1 '
            cQuery += '                 FROM ' + RetSqlName('F23') + ' F23 '
            cQuery += '                 WHERE F23.F23_FILIAL = ? '
            cQuery += '                     AND F23.F23_CODIGO = CKC.CKC_CODIGO '
            cQuery += '                     AND F23.F23_TIPOPF = ? '
            cQuery += '                     AND F23.F23_CFOP = ? '
            cQuery += '                     AND F23.D_E_L_E_T_ = ? '
            cQuery += '             ) '
            cQuery += '         ) '
            cQuery += '     ) '
            cQuery += '     AND ( '
            cQuery += '         CKC.CKC_TPOPER = ? '
            cQuery += '         OR ( '
            cQuery += '             CKC.CKC_TPOPER = ? '
            cQuery += '             AND EXISTS ( '
            cQuery += '                 SELECT 1 '
            cQuery += '                 FROM ' + RetSqlName('F26') + ' F26 '
            cQuery += '                 WHERE F26.F26_FILIAL = ? '
            cQuery += '                     AND F26.F26_CODIGO = CKC.CKC_CODIGO '
            cQuery += '                     AND F26.F26_TIPOPF = ? '
            cQuery += '                     AND F26.F26_TPOPER IN (?) '
            cQuery += '                     AND F26.D_E_L_E_T_ = ? '
            cQuery += '             ) '
            cQuery += '         ) '
            cQuery += '     ) '
            cQuery += '     AND ( '
            cQuery += '         CKC.CKC_CODISS = ? '
            cQuery += '         OR ( '
            cQuery += '             CKC.CKC_CODISS = ? '
            cQuery += '             AND EXISTS ( '
            cQuery += '                 SELECT 1 '
            cQuery += '                 FROM ' + RetSqlName('CIO') + ' CIO '
            cQuery += '                 WHERE CIO.CIO_FILIAL = ? '
            cQuery += '                     AND CIO.CIO_CODIGO = CKC.CKC_CODIGO '
            cQuery += '                     AND CIO.CIO_TIPOPF = ? '
            cQuery += '                     AND CIO.CIO_CODISS IN (?) '
            cQuery += '                     AND CIO.D_E_L_E_T_ = ? '
            cQuery += '             ) '
            cQuery += '         ) '
            cQuery += '     ) '
            cQuery += '     AND CKC.D_E_L_E_T_ = ? '
            cQuery += ' GROUP BY CKC.CKC_MSGCOD '                
        EndIf

		Aadd(aParams, {'C', FWxFilial('CKC')})
		Aadd(aParams, {'C', cOperationProfileCode})
		Aadd(aParams, {'C', cCfop})
		Aadd(aParams, {'C', 'TODOS'})
		Aadd(aParams, {'C', FWxFilial('F23')})
		Aadd(aParams, {'C', '03'})
		Aadd(aParams, {'C', cCfop})
		Aadd(aParams, {'C', ' '})
		Aadd(aParams, {'C', cOperationType})
		Aadd(aParams, {'C', 'TODOS'})
		Aadd(aParams, {'C', FWxFilial('F26')})
		Aadd(aParams, {'C', '03'})
		Aadd(aParams, {'A', {cOperationType,'TODOS'}})
		Aadd(aParams, {'C', ' '})
		Aadd(aParams, {'C', cIssCode})
		Aadd(aParams, {'C', 'TODOS'})
		Aadd(aParams, {'C', FWxFilial('CIO')})
		Aadd(aParams, {'C', '03'})
		Aadd(aParams, {'A', {cIssCode,'TODOS'}})
		Aadd(aParams, {'C', ' '})
		Aadd(aParams, {'C', ' '})

	ElseIf ( cType == 'REG_ESCRIT' )

        If ( self:jQueriesCache['REG_ESCRIT'] == Nil )
            cQuery += ' SELECT CJ2_MSGCOD MSGCOD '
            cQuery += ' FROM ' + RetSqlName('CJ2')
            cQuery += ' WHERE CJ2_FILIAL = ? '
            cQuery += ' 	AND CJ2_ID = ? '
            cQuery += ' 	AND D_E_L_E_T_ = ? '
        EndIf
		
		Aadd(aParams, {'C', FWxFilial('CJ2')})
		Aadd(aParams, {'C', cBookkeepingRuleId})
		Aadd(aParams, {'C', ' '})

	ElseIf ( cType == 'REG_CALCUL' )

        If ( self:jQueriesCache['REG_CALCUL'] == Nil )
            cQuery += ' SELECT F2B_MSGCOD MSGCOD '
            cQuery += ' FROM ' + RetSqlName('F2B')
            cQuery += ' WHERE F2B_FILIAL = ? '
            cQuery += ' 	AND F2B_REGRA = ? '
            cQuery += ' 	AND F2B_ALTERA = ? '
            cQuery += ' 	AND D_E_L_E_T_ = ? '
        EndIf
		
		Aadd(aParams, {'C', FWxFilial('F2B')})
		Aadd(aParams, {'C', cTaxRuleCode})
		Aadd(aParams, {'C', '2'})
		Aadd(aParams, {'C', ' '})

	EndIf

    oStatement := self:jQueriesCache[cType]

    If ( oStatement == Nil )
	    oStatement := FwExecStatement():New( ChangeQuery(cQuery) )

        self:jQueriesCache[cType] := oStatement
    EndIf

	For nI := 1 to Len(aParams)
		If ( aParams[nI][1] == 'C' )
			oStatement:SetString(nI, aParams[nI][2])
		ElseIf ( aParams[nI][1] == 'A' )
			oStatement:SetIn(nI, aParams[nI][2])
		EndIf		
	Next nI

	cAlias := oStatement:OpenAlias(GetNextAlias())

	While ( !(cAlias)->(EoF()) )
		If ( !Empty((cAlias)->MSGCOD) )
			Aadd(aMessageGroups, (cAlias)->MSGCOD)
		EndIf

		(cAlias)->(DbSkip())
	EndDo

	(cAlias)->(DbCloseArea())

	FWFreeArray(aParams)

Return aMessageGroups

/*/{Protheus.doc} MessageGroupDecoder::parseMemoField
Método que retorna a string de consulta para o campo memo.
@type method
@version 12.1.2410
@author Juliano Fernandes
@since 23/05/2025
@param cField, character, Nome do campo a ser convertido
@param cDBType, character, Tipo de banco de dados
@return character, String de consulta para o campo memo
/*/
Method parseMemoField(cField as character, cDBType as character) as character Class MessageGroupDecoder

    Local cQuery := "ISNULL(CAST(CAST(##FIELD## AS VARBINARY(8000)) AS VARCHAR(8000)),'') AS [##FIELD##]" as character

    If ( 'ORACLE' $ cDBType )
        cQuery := "UTL_RAW.CAST_TO_VARCHAR2(DBMS_LOB.SUBSTR(##FIELD##, 2000,1)) ##FIELD##"
    ElseIf ( 'POSTGRES' $ cDBType )
        cQuery := "encode(##FIELD##,'escape') ##FIELD##"
    EndIf

Return StrTran(cQuery,'##FIELD##',cField)

/*/{Protheus.doc} MessageGroupDecoder::restoreDefaultValues
Método que restaura os valores padrões da classe MessageGroupDecoder.
@type method
@version 12.1.2410
@author Juliano Fernandes
@since 23/05/2025
/*/
Method restoreDefaultValues() Class MessageGroupDecoder

    self:cMessageGroupCode := ''
    SELF:cInvoiceType := ''
    SELF:cPurposeCode := ''
    self:jMessageGroup := Nil
    self:cDecodingId := ''
    self:lMatxfisInUse := .F.
    self:lError := .F.
    self:cErrorMessage := ''
    self:lSuccess := .T.
    self:cMessage := STR0008 // 'Sucesso'
    self:cDetailedMessage := ''
    self:jDecodedMessages := Nil
    self:jProcessedMessages := JsonObject():New()
    self:jQueriesCache := JsonObject():New()

Return

/*/{Protheus.doc} MessageGroupDecoder::destroy
Método destrutor da classe MessageGroupDecoder.
Libera os objetos utilizados na classe.
@type method
@version 12.1.2410 
@author Juliano Fernandes
@since 23/05/2025
/*/
Method destroy() Class MessageGroupDecoder

    Local aNames as array
    Local nI as numeric

    // Executa o Destroy dos statements
    If ( ValType(self:jQueriesCache) == 'J' )
        aNames := self:jQueriesCache:GetNames()
        
        For nI := 1 To Len(aNames)
            self:jQueriesCache[aNames[nI]]:Destroy()
        Next nI
    EndIf

    FwFreeObj(self:jMessageGroup)
    FwFreeObj(self:jDecodedMessages)
    FwFreeObj(self:jProcessedMessages)
    FwFreeObj(self:jQueriesCache)

    FWFreeArray(aNames)

Return
