#include 'fwMvcDef.ch'
#include 'tlpp-core.th'
#include "taxindop.ch"

nameSpace totvs.protheus.backoffice.fiscal.configurador.tax.indop.registration

static cProgram := 'totvs.protheus.backoffice.fiscal.configurador.tax.indop.registration.Taxindop'

/*/{Protheus.doc} taxindop
Função que cria o cadastro de códigos cClassFis.
@author Douglas Dourado
@since 04/11/2025
/*/
function taxindop( lAutomato as logical ) as object
	local oBrowse as object
	default lAutomato := .F.

	if ( aliasIndic('CI1') ) .and. !lAutomato
		oBrowse := fwMBrowse():new()
		oBrowse:setAlias('CI1')		
		oBrowse:setUseFilter(.T.)
		oBrowse:setDescription(STR0002) // Códigos Indicadores de Operação.		
		oBrowse:activate()
	else
		help('',1,'Help','Help',STR0003,1,0) //'Dicionário desatualizado, verifique as atualizações do motor tributário fiscal.' 
	endIf

return oBrowse

/*/{Protheus.doc} MenuDef
Função que cria o menu do cadastro de códigos IndOp.
@author Douglas Dourado
@since 04/11/2025
@return array, Menu do cadastro de códigos IndOp.
/*/
function menuDef() as array	
	local aMenu:= {} as array	

	add option aMenu title STR0001 action 'VIEWDEF.' + cProgram operation 2 access 0 // 'Visualizar'	
	add option aMenu title STR0007 action 'VIEWDEF.' + cProgram operation 3 access 0 // 'Incluir'
	add option aMenu title STR0008 action 'VIEWDEF.' + cProgram operation 4 access 0 // 'Alterar'
	add option aMenu title STR0009 action 'VIEWDEF.' + cProgram operation 5 access 0 // 'Excluir'
	add option aMenu title STR0010 action 'VIEWDEF.' + cProgram operation 9 access 0 // 'Copiar'
                                                                
    add option aMenu title STR0011 action 'totvs.protheus.backoffice.fiscal.configurador.tax.indop.registration.import.ImpIndOp()' operation 3 access 0 //'Importa Tabela'

return aMenu

/*/{Protheus.doc} ModelDef
Função que cria o modelo de dados do cadastro de códigos IndOp.
@author Douglas Dourado
@since 04/11/2025
@return object, Modelo de dados do cadastro de códigos IndOp.
/*/
function modelDef() as object
	local oModel as object
	local oIndopStruct as object

	oIndopStruct:= fwFormStruct(1,'CI1')
	// Validações dos campos (esta aqui porque o tamanho do campo X3_VALID nao é suficiente para comportar a validação em tlpp (findfunction + nameSpace + function call) )
	oIndopStruct:setProperty('CI1_CODIGO',  MODEL_FIELD_VALID, {|| validateIdentifierCode(oModel)})
	oIndopStruct:setProperty('CI1_DTINI' , 	MODEL_FIELD_VALID, {|| validateIdentifierCode(oModel)})	
	oIndopStruct:setProperty('CI1_DTFIM' , 	MODEL_FIELD_VALID, {|| validateDtFim(oModel)})

	oIndopStruct:setProperty('CI1_CODIGO', 	MODEL_FIELD_WHEN , {|| (oModel:getOperation() == MODEL_OPERATION_INSERT) })
	oIndopStruct:setProperty('CI1_DTINI' , 	MODEL_FIELD_WHEN , {|| (oModel:getOperation() == MODEL_OPERATION_INSERT) })
	
	oModel := mpFormModel():new('INDOPMOD') // Cria o objeto do Modelo de Dados

	oModel:addFields('INDOPMOD',,oIndopStruct) // Adiciona ao modelo uma estrutura de formulário de edição por campo

	oModel:setPrimaryKey({'CI1_FILIAL','CI1_CODIGO'}) // Adiciona a chave primária do modelo
	
return oModel

/*/{Protheus.doc} ViewDef
Função que cria a View do cadastro de códigos de IndOp.
@author Douglas Dourado
@since 04/11/2025
@return object, View do cadastro de códigos de IndOp.
/*/
function viewDef() as object
	local oView  := fwFormView():new() as object
	local oModel := fwLoadModel(cProgram) as object	
	local oIndopStruct as object

	oIndopStruct := fwFormStruct(2,'CI1')
	oView:setModel(oModel) // Define qual o Modelo de dados será utilizado
	oView:addField('VIEW_CAB',oIndopStruct,'INDOPMOD') // Adiciona no nosso View um controle do tipo FormFields(antiga enchoice)
	oView:createHorizontalBox('CABEC',100)
	oView:setOwnerView('VIEW_CAB','CABEC')

return oView

/*/{Protheus.doc} validateIdentifierCode
Função que aplica a regras específicas aos campos e valida a operação.
@author Douglas Dourado
@since 04/11/2025
@param oModel, object, Modelo de dados
@return logical, Retorna .T. se a validação for bem sucedida.
/*/
static function validateIdentifierCode(oModel as object) as logical
	local cIndOp		:= oModel:getValue('INDOPMOD','CI1_CODIGO') as character
	local dStartOfValidity 	:= oModel:getValue('INDOPMOD','CI1_DTINI') as date
	local nOperation		:= oModel:getOperation() as numeric
	local lValid 			:= .T. as logical
	local aAreaCI1 			:= CI1->(GetArea())

	if !empty(dStartOfValidity) .and. (nOperation == MODEL_OPERATION_INSERT .or. nOperation == MODEL_OPERATION_UPDATE) 				
		CI1->(dbSetorder(1))

		if CI1->(dbSeek(xFilial('CI1')+cIndOp+dToS(dStartOfValidity)))
			help(nil,nil,STR0004,nil,STR0005,1,0,nil,nil,nil,nil,nil,{STR0006}) //'Registro já informado.','Chave única.','Campos Class Trib, Data Inicial e Data Final, já cadastrados. Por favor, verifique.'
			lValid := .F.
		endif			
	endif	

	RestArea(aAreaCI1)

return lValid 

/*/{Protheus.doc} validateDtFim
Função que valida a data final de vigência do código indicador de operação.
@author Douglas Dourado
@since 31/10/2025
@param oModel, object, Modelo de dados
@return logical, Retorna .T. se a validação for bem sucedida.
/*/
Static Function validateDtFim(oModel as object) as logical
	local dStartOfValidity 	:= oModel:getValue('INDOPMOD','CI1_DTINI') as date
	local dEndOfValidity   	:= oModel:getValue('INDOPMOD','CI1_DTFIM') as date
	local lValid 			:= .T. as logical

	if !empty(dEndOfValidity) 
		if dEndOfValidity < dStartOfValidity
			help(nil,nil,STR0012, nil, STR0013,1,0,nil,nil,nil,nil,nil,{}) //'Data Final não pode ser menor que Data Inicial.','Por favor, verifique.'
			lValid := .F.
		endif
	endif

Return lValid

/*/{Protheus.doc} FISALOCPRES
    (Função que retorna as opções de local de prestação para o campo FIS_LOCPRES)
    
    @author Douglas Dourado
    @since 04/11/2025
	@param lRetArr - Define se o retorno será em array(.T.) ou string(.F.)
	@return Array ou String com as opções de local de prestação
/*/
Function FisaLocPres(lRetArr as logical)
	Local aOpc := {}
	Local xRet
	Default lRetArr := .F.
		
	AADD(aOpc, "1=Localidade do imóvel (1)")
	AADD(aOpc, "2=Estabelecimento do fornecedor")
	AADD(aOpc, "3=Endereço do adquirente")
	AADD(aOpc, "4=Endereço do destinatário")
	AADD(aOpc, "5=Endereço diverso do fornecedor, adquirente ou destinatário")
	AADD(aOpc, "6=Local do Evento")
	AADD(aOpc, "7=Local da prestação")
	AADD(aOpc, "8=Local de início do transporte")
	AADD(aOpc, "9=Endereço fornecido para entrega")
	AADD(aOpc, "10=Local da retirada")
	AADD(aOpc, "11=Local da prestação, correspondente à extensão da via explorada e proporcional ao território dos entes tributantes")
	AADD(aOpc, "12=Local do domicílio principal do adquirente (3)")
	AADD(aOpc, "13=Local do domicílio do destinatário, nos casos de adquirente residente ou domiciliado no exterior (5)(6)")
	AADD(aOpc, "14=Local do domicílio principal do destinatário (6)")

	If lRetArr
		xRet := aOpc
	Else
		xRet := CenArr2Str(aOpc, ';')
	EndIf

Return xRet
