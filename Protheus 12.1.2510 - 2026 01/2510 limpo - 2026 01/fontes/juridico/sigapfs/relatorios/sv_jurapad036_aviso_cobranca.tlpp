#INCLUDE "JURAPAD036.CH"
#INCLUDE "protheus.ch"
#INCLUDE "totvs.ch"
#INCLUDE "msobject.ch"
#INCLUDE "totvs.framework.treports.integratedprovider.th"

namespace totvs.protheus.legal.sigapfs.jurapad036_aviso_cobranca.integratedprovider

@totvsFrameworkTReportsIntegratedProvider(active=.T.,;
	team='SIGAPFS',;
	tables='NXA,OHT,SE1',;
	name='Aviso de Cobrança',;
	country='ALL',;
	initialRelease='12.1.2210')

//------------------------------------------------------------------------------------
class jurapad036_aviso_cobranca from totvs.framework.treports.integratedprovider.IntegratedProvider
	public    method new()         as object
	public    method getData()     as object
	public    method getSchema()   as object

	data lExistPergunte as logical

endclass

//------------------------------------------------------------------------------------
method new() class jurapad036_aviso_cobranca
	_Super:new()

	//Define a área
	self:appendArea(STR0014) // "Pré-Faturamento Serviços"

	//Define o nome do Objeto de Negócio
	self:setDisplayName(STR0015) // "Relatório de Aviso de Cobrança"

	//Define a descrição do Objeto de Negócio
	self:setDescription(STR0016) // "Objeto de Negócio para gerar o relatório de Aviso de Cobrança"

Return self

//------------------------------------------------------------------------------------
method getData(nPage as numeric, oFilter as object) as object class jurapad036_aviso_cobranca

Local jParams    := oFilter:getParameters()
Local aArea      := GetArea()
Local cQuery     := ""
Local nTamFil    := TamSX3("NXA_FILIAL")[1]
Local nTamEsc    := TamSX3("NXA_CESCR")[1]
Local nTamFatur  := TamSX3("NXA_COD")[1]
Local nIniEscr   := nTamFil + 2
Local nIniFatur  := nTamFil + 1 + nTamEsc + 2
Local nRecTmp    := jParams['MV_PAR02'][1]
Local cSocio     := jParams['MV_PAR03'][1]
Local aBind      := {}
Local cTemp      := GetNextAlias()
Local cTempFat   := GetNextAlias()
Local lExistOHT  := AliasInDic("OHT")
Local lIntPFS    := lExistOHT .And. SuperGetMV("MV_JURXFIN",, .F.) // Integração SIGAPFS x SIGAFIN
Local nStatus    := 0
Local aDadosCli  := {}
Local oJsDados   as object

	/*
		MV_PAR01 - Nome da tabela temporária
		MV_PAR02 - RECNO da tabela temporária que está marcada
		MV_PAR03 - Sócio Responsável
	*/

	cQuery := "SELECT 1 FROM " + jParams['MV_PAR01'][1]

	nStatus := TCSqlExec(cQuery)

	If nStatus < 0 // A tabela temporária não existe
		self:setErrorStatus(400, STR0017, STR0018) // "Alerta", "Este layout só pode ser executado via PROTHEUS, pois necessita de informações geradas pelo sistema."
	Else
		oJsDados := JsonObject():new()
		oJsDados["Faturas"] := {}

		cQuery := "SELECT *"
		cQuery +=  " FROM " + jParams['MV_PAR01'][1] + " COB"
		cQuery += " WHERE R_E_C_N_O_ = ?"
		Aadd(aBind, {nRecTmp, "N"})

		cQuery := JurTRepBin(cQuery, aBind)

		MPSysOpenQuery(cQuery, cTemp)

		JurFreeArr(aBind)

		While !(cTemp)->(Eof())

			cQuery :=     "SELECT NXA.NXA_COD, NXA.NXA_DTVENC, SUM(SE1.E1_SALDO) TOTAL"
			cQuery +=      " FROM " + jParams['MV_PAR01'][1] + " TABTMP"
			// Dados do Título
			cQuery +=     " INNER JOIN " + RetSqlName('SE1') + " SE1"
			cQuery +=        " ON SE1.E1_FILIAL = ?"

			Aadd(aBind, {xFilial("SE1"), "S"})

			cQuery +=       " AND SE1.E1_CLIENTE = TABTMP.E1_CLIENTE"
			cQuery +=       " AND SE1.E1_LOJA = TABTMP.E1_LOJA"
			cQuery +=       " AND SE1.E1_SALDO > ?"

			Aadd(aBind, {0, "N"})

			cQuery +=       " AND SE1.E1_VENCTO < ?"

			Aadd(aBind, {DtoS(Date()), "S"})

			cQuery +=       " AND SE1.D_E_L_E_T_ = ?"

			Aadd(aBind, {' ', "S"})

			If lIntPFS
				// Dados da Fatura
				cQuery += " INNER JOIN " + RetSqlName("OHT") + " OHT"
				cQuery +=    " ON OHT.OHT_FILFAT = ?"

				Aadd(aBind, {xFilial("NXA"), "S"})

				cQuery +=   " AND OHT.OHT_FILTIT = SE1.E1_FILIAL"
				cQuery +=   " AND OHT.OHT_PREFIX = SE1.E1_PREFIXO"
				cQuery +=   " AND OHT.OHT_TITNUM = SE1.E1_NUM"
				cQuery +=   " AND OHT.OHT_TITPAR = SE1.E1_PARCELA"
				cQuery +=   " AND OHT.OHT_TITTPO = SE1.E1_TIPO"
				cQuery +=   " AND OHT.D_E_L_E_T_ = ?"

				Aadd(aBind, {' ', "S"})

				cQuery += " INNER JOIN " + RetSqlName("NXA") + " NXA"
				cQuery +=   "  ON NXA.NXA_FILIAL = OHT.OHT_FILFAT"
				cQuery +=   " AND NXA.NXA_CESCR = OHT.OHT_FTESCR"
				cQuery +=   " AND NXA.NXA_COD = OHT.OHT_CFATUR"
			Else
				cQuery += " INNER JOIN " + RetSqlName("NXA") + " NXA"
				cQuery +=    " ON NXA.NXA_FILIAL = SUBSTRING(E1_JURFAT, 1, ?)"

				Aadd(aBind, {nTamFil, "N"})

				cQuery +=   " AND NXA.NXA_CESCR = SUBSTRING(E1_JURFAT, ?, ?)"

				Aadd(aBind, {nIniEscr, "N"})
				Aadd(aBind, {nTamEsc, "N"})

				cQuery +=   " AND NXA.NXA_COD = SUBSTRING(E1_JURFAT, ?, ?)"

				Aadd(aBind, {nIniFatur, "N"})
				Aadd(aBind, {nTamFatur, "N"})
			EndIf
			cQuery +=       " AND NXA.NXA_CCONT  = TABTMP.U5_CODCONT"
			cQuery +=       " AND NXA.NXA_CMOEDA = TABTMP.CTO_MOEDA"
			cQuery +=       " AND NXA.NXA_SITUAC = ?"

			Aadd(aBind, {'1', "S"})

			//Filtra Sócio Responsável
			If !Empty(cSocio)
				cQuery += " AND NXA.NXA_CPART = ?"

				Aadd(aBind, {cSocio, "S"})
			EndIf

			cQuery +=       " AND NXA.D_E_L_E_T_ = ?"

			Aadd(aBind, {' ', "S"})

			cQuery +=     " WHERE TABTMP.R_E_C_N_O_ = ?"

			Aadd(aBind, {nRecTmp, "N"})

			cQuery +=     " GROUP BY NXA.NXA_COD, NXA.NXA_DTVENC"
			cQuery +=     " ORDER BY NXA.NXA_COD, NXA.NXA_DTVENC"

			cQuery := JurTRepBin(cQuery, aBind)

			MPSysOpenQuery(cQuery, cTempFat)

			While !(cTempFat)->(Eof())

				aAdd(oJsDados["Faturas"], {"NXA_COD"    : (cTempFat)->NXA_COD,;
										   "NXA_DTVENC" : totvs.framework.treports.date.dateToTimeStamp(StoD((cTempFat)->NXA_DTVENC)),;
										   "TOTAL"      : (cTempFat)->TOTAL})

				(cTempFat)->(DBSkip())
			EndDo

			(cTempFat)->(DbCloseArea())

			aDadosCli := JurGetDados('SA1', 1, xFilial('SA1') + (cTemp)->E1_CLIENTE + (cTemp)->E1_LOJA, {'A1_END','A1_BAIRRO','A1_MUN','A1_CEP','A1_EST'})

			oJsDados["NS7_RAZAO"]  := AllTrim(JurGetDados("NS7", 4, xFilial("NS7") + cFilant + cEmpAnt, "NS7_RAZAO"))
			oJsDados["E1_CLIENTE"] := (cTemp)->E1_CLIENTE
			oJsDados["E1_LOJA"]    := (cTemp)->E1_LOJA
			oJsDados["A1_CGC"]     := (cTemp)->A1_CGC
			oJsDados["A1_NOME"]    := AllTrim(Capital((cTemp)->A1_NOME))
			oJsDados["A1_END"]     := AllTrim(Capital(aDadosCli[1])) // Endereço do Cliente
			oJsDados["A1_BAIRRO"]  := AllTrim(Capital(aDadosCli[2])) // Bairro do Cliente
			oJsDados["A1_MUN"]     := AllTrim(Capital(aDadosCli[3])) // Município do Cliente
			oJsDados["A1_CEP"]     := Iif(FWRetIdiom() == 'pt-br', Transform(aDadosCli[4], "@R 99999-999"),  aDadosCli[4]) // CEP do Cliente
			oJsDados["A1_EST"]     := aDadosCli[5] // Estado do Cliente
			oJsDados["U5_CODCONT"] := (cTemp)->U5_CODCONT
			oJsDados["U5_CONTAT"]  := AllTrim(Capital((cTemp)->U5_CONTAT))
			oJsDados["CTO_MOEDA"]  := (cTemp)->CTO_MOEDA
			oJsDados["CTO_SIMB"]   := (cTemp)->CTO_SIMB
			oJsDados["TOTAL"]      := (cTemp)->TOTAL
			self:oData:appendData(oJsDados)

			(cTemp)->(DBSkip())
		EndDo

		(cTemp)->(DbCloseArea())

	EndIf

	RestArea(aArea)
Return self:oData

//------------------------------------------------------------------------------------
method getSchema() as object Class jurapad036_aviso_cobranca
Local aNested as array

	// Não foi inserido STR pois esses parâmetros são invisíveis
	self:oSchema:addParameter("MV_PAR01", "Tabela", "string", .F.,,,,,,,,,,.F.) // Nome da tabela temporária
	self:oSchema:addParameter("MV_PAR02", "Recno", "number", .F.,,,,,,,,,,.F.) // RECNO da tabela temporária
	self:oSchema:addParameter("MV_PAR03", "Sócio", "string", .F.,,,,,,,,,,.F.) // Sócio Responsável

	self:oSchema:addProperty("NS7_RAZAO" ,"NS7_RAZAO" , "string", "NS7_RAZAO" , "NS7_RAZAO")
	self:oSchema:addProperty("E1_CLIENTE","E1_CLIENTE", "string", "E1_CLIENTE", "E1_CLIENTE")
	self:oSchema:addProperty("E1_LOJA"   ,"E1_LOJA"   , "string", "E1_LOJA"   , "E1_LOJA")
	self:oSchema:addProperty("A1_CGC"    ,"A1_CGC"    , "string", "A1_CGC"    , "A1_CGC")
	self:oSchema:addProperty("A1_NOME"   ,"A1_NOME"   , "string", "A1_NOME"   , "A1_NOME")
	self:oSchema:addProperty("A1_END"    ,"A1_END"    , "string", "A1_END"    , "A1_END")
	self:oSchema:addProperty("A1_BAIRRO" ,"A1_BAIRRO" , "string", "A1_BAIRRO" , "A1_BAIRRO")
	self:oSchema:addProperty("A1_MUN"    ,"A1_MUN"    , "string", "A1_MUN"    , "A1_MUN")
	self:oSchema:addProperty("A1_CEP"    ,"A1_CEP"    , "string", "A1_CEP"    , "A1_CEP")
	self:oSchema:addProperty("A1_EST"    ,"A1_EST"    , "string", "A1_EST"    , "A1_EST")
	self:oSchema:addProperty("U5_CODCONT","U5_CODCONT", "string", "U5_CODCONT", "U5_CODCONT")
	self:oSchema:addProperty("U5_CONTAT" ,"U5_CONTAT" , "string", "U5_CONTAT" , "U5_CONTAT")
	self:oSchema:addProperty("CTO_MOEDA" ,"CTO_MOEDA" , "string", "CTO_MOEDA" , "CTO_MOEDA")
	self:oSchema:addProperty("CTO_SIMB"  ,"CTO_SIMB"  , "string", "CTO_SIMB"  , "CTO_SIMB")
	self:oSchema:addProperty("TOTAL"     ,"TOTAL"     , "number", "TOTAL"     , "TOTAL")

	aNested := Array(0)
	//Posições do array = 1-Id | 2-Description | 3-Type | 4-DisplayName
	aAdd(aNested, {"NXA_COD"   , "NXA_COD"   , "string", "NXA_COD"})
	aAdd(aNested, {"NXA_DTVENC", "NXA_DTVENC", "date"  , "NXA_DTVENC"})
	aAdd(aNested, {"TOTAL"     , "TOTAL"     , "number", "TOTAL"})
	self:oSchema:addNestedProperty("Faturas", "Faturas", "Faturas",, aNested)

Return self:oSchema
