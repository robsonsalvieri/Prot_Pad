//---------------------------------------------------------------------
/*/{Protheus.doc} GetIrrfTotalizer
@type           function
@description    Executa a consulta do resultado do relatório de conferência (Totalizador).
@author         Denis R de Oliveira
@since          27/11/2025
@param          jResponse (Json)    - Objeto JSON de retorno (passado por referência).
@param          cRequestID (Char)   - Identificador da Requisição.
@return         jResponse (Json)    - Retorna o objeto manipulado.
/*/
//---------------------------------------------------------------------
Function GetIrrfTotalizer( jResponse as Json, cRequestID as Character )

    Local cLevel    as Character
    Local jJsonFull as Object

    Default cRequestID := ""

    cLevel    := "1"
    
    // Inicializa vazio para garantir que retorna objeto, evitando erro 500
    jResponse := JsonObject():New() 

    DBSelectArea("V45")
    V45->( DbSetOrder(4) )
    
    // V45_FILIAL + V45_ID + V45_LEVEL

    If V45->( DBSeek(xFilial("V45") + cRequestID + cLevel ) ) 

        jJsonFull := JsonObject():New()
        jJsonFull:FromJson( V45->V45_RESP )
        
        If jJsonFull:HasProperty("totalIRRFCompany")
            jResponse := jJsonFull["totalIRRFCompany"]
        EndIf

    EndIf

Return jResponse

//---------------------------------------------------------------------
/*/{Protheus.doc} GetIrrfRevenueCodes
@type           function
@description    Executa a consulta dos códigos de receita do relatório.
@author         Denis R de Oliveira
@since          27/11/2025
@param          jResponse (Json)    - Objeto JSON de retorno (passado por referência).
@param          cRequestID (Char)   - Identificador da Requisição.
@return         jResponse (Json)    - Retorna o objeto manipulado.
/*/
//---------------------------------------------------------------------
Function GetIrrfRevenueCodes( jResponse as Json, cRequestID as Character )

    Local cLevel    as Character
    Local jJsonFull as Json

    Default cRequestID := ""

    cLevel    := "1"
    jJsonFull := JsonObject():New()
    jResponse := JsonObject():New() 

    DBSelectArea("V45")
    V45->( DbSetOrder(4) )
    
    If V45->( DBSeek(xFilial("V45") + cRequestID + cLevel ) ) 
        
        jJsonFull:FromJson( V45->V45_RESP )

        If jJsonFull:HasProperty("revenueCodes") .And. Len( jJsonFull["revenueCodes"]["items"] ) > 0
            jResponse := jJsonFull["revenueCodes"]
        EndIf

    EndIf

Return jResponse

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFPOSTDIRF
@type           Function
@description    Função de entrada (RPC) para processamento do relatório.
@author         Alexandre de Lima Santos.
@since          28/10/2025
@param          cEmpRequest (Char)  - Empresa da requisição.
@param          cFilRequest (Char)  - Filial da requisição.
@param          cTicket (Char)      - Ticket (ID) da requisição.
@return         lRet (Log)          - Sucesso ou falha.
/*/
//---------------------------------------------------------------------
Function TAFPOSTDIRF( cEmpRequest as Character, cFilRequest as Character, cTicket as Character )

    Local jRequest  as Json
    Local lIsLegacy as Logical
    Local lRet      as Logical

    Default cTicket := ""

    lIsLegacy := .F.
    lRet      := .F.
    jRequest  := Nil

    RPCSetType( 3 )
    RPCSetEnv( cEmpRequest, cFilRequest,,, "TAF", "TAFPOSTDIRF" )

    jRequest := JsonObject():New()

    V3J->(DbSetOrder(1))

    If V3J->( MsSeek( xFilial( "V3J" ) + PadR( cTicket, TamSX3( "V3J_ID" )[1] ) ) )

        lIsLegacy := !Empty( AllTrim( GetNewPar( "MV_TAFRHUR", "" ) ) )

        jRequest:FromJson( V3J->V3J_PARAMS )
        GetDirfVal( jRequest, cTicket, lIsLegacy )
        lRet := .T.
        
    EndIf

    jRequest := Nil

Return lRet

//---------------------------------------------------------------------
/*/{Protheus.doc} GetDirfVal
@type           Function
@description    Orquestrador para levantamento dos valores da DIRF/IRRF.
@author         Alexandre de Lima Santos.
@since          28/10/2025
@param          jRequest (Json)     - Parâmetros da requisição.
@param          cTicket (Char)      - Ticket da requisição.
@param          lIsLegacy (Log)     - Flag de legado.
/*/
//---------------------------------------------------------------------
Function GetDirfVal( jRequest as Json, cTicket as Character, lIsLegacy as Logical )

    Local aEmployeCod as Array
    Local aFils       as Array
    Local aForms      as Array
    Local aTotalizer  as Array
    Local cCpf        as Character
    Local cFil        as Character
    Local cName       as Character
    Local cPeriodo    as Character
    Local cRevCode    as Character

    Default cTicket   := ""
    Default jRequest  := Nil
    Default lIsLegacy := .F.
      
    aTotalizer := {}
    cCpf       := jRequest["cpf"]
    cFil       := jRequest["companyId"]
    cName      := jRequest["name"]
    cPeriodo   := jRequest["period"]
    cRevCode   := jRequest["revenueCode"]

    // Executa as etapas de extração e consolidação
    TAFTotalizer( cFil, cPeriodo, cRevCode, cCpf, cName, @aTotalizer, @aFils )
    TAFCodReceita( aFils, cPeriodo, cRevCode, cCpf, cName, @aTotalizer, @aEmployeCod )
    TAFFormEmployes( aFils, cPeriodo, cRevCode, cCpf, cName, @aEmployeCod, @aForms )

    // Gera os JSONs de resposta e grava
    TAFJsonTot( aTotalizer, cTicket, lIsLegacy )
    TAFJsonMod1( aEmployeCod, cTicket, lIsLegacy )
    TAFJsonMod2( aForms, cTicket, lIsLegacy )
    
Return

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFTotalizer
@description    Realiza a consulta SQL para totalizadores (T8R).
@author         Alexandre de Lima Santos.
@since          28/10/2025
@param          cFil (Char)             - Filial.
@param          cPeriodo (Char)         - Período.
@param          cRevCode (Char)         - Código Receita (Filtro).
@param          cCpf (Char)             - CPF (Filtro).
@param          cName (Char)            - Nome (Filtro).
@param          aTotalizer (Ref Array)  - Array de retorno dos totalizadores.
@param          aFils (Ref Array)       - Array de retorno das filiais processadas.
/*/
//---------------------------------------------------------------------
Function TAFTotalizer( cFil as Character, cPeriodo as Character, cRevCode as Character, cCpf as Character, cName as Character, aTotalizer as Array, aFils as Array )

    Local cAliasQry as Character
    Local cQuery    as Character
    Local nCount    as Numeric
    Local oStmt     as Object

    Default aFils      := {}
    Default aTotalizer := {}
    Default cCpf       := ""
    Default cName      := ""
    Default cRevCode   := ""
    
    aFils     := FilMatriz()
    cAliasQry := GetNextAlias()
    cQuery    := ""
    nCount    := 0
    oStmt     := Nil

    cQuery := " SELECT T8R_CODREC, T8R_ORIGEM, SUM( T8R_VLRTRI ) AS VLRTRI, SUM( T8R_VRTR13 ) AS VRTR13, SUM( T8R_VLRPRE ) AS VLRPRE, SUM( T8R_VPRE13 ) AS VPRE13, SUM( T8R_VLIRRF ) AS VLIRRF, SUM( T8R_IRRF13 ) AS IRRF13,"
    cQuery += " SUM( T8R_VLRISE ) AS VLRISE, SUM( T8R_VLRI13 ) VLRI13, SUM( T8R_VLRDIA ) AS VLRDIA, SUM( T8R_VLRAJU ) AS VLRAJU, SUM( T8R_VLRRSC ) AS VLRRSC, SUM( T8R_VLRABN ) AS VLRABN, SUM( T8R_VLRMLG ) AS VLRMLG, " 
    cQuery += " SUM( T8R_VMLG13 ) AS VMLG13, SUM( T8R_VLRAXM ) AS VLRAXM, SUM( T8R_VLBMED ) AS VLBMED, SUM( T8R_BMED13 ) AS BMED13, SUM( T8R_VLRMOR ) AS VLRMOR, SUM( T8R_VLRISO ) AS VLRISO "
    cQuery += " FROM " + RetSqlName( "T8R" ) + " T8R "
    cQuery += " WHERE T8R_FILIAL IN (?) " 
    cQuery += " AND T8R_PERAPU = ? "

    If !Empty(cRevCode)
        cQuery += " AND T8R_CODREC LIKE ? "
    EndIf
    
    If !Empty(cCpf)
        cQuery += " AND T8R_CPF = ? "
    EndIf

    If !Empty(cName)
        cQuery += " AND T8R_NOME = ? "
    EndIf

    cQuery += " AND ( T8R_FORABA = 'TRIBUT' OR T8R_FORABA = 'DEDDEP' OR T8R_FORABA = 'PENALI' OR T8R_FORABA = 'PREVCL' OR T8R_FORABA = 'PROCRE' ) "
    cQuery += " AND T8R.D_E_L_E_T_ = ''"
    cQuery += " GROUP BY T8R_ORIGEM, T8R_CODREC "
    
    oStmt := FWExecStatement():New( ChangeQuery(cQuery) )

    If !Empty(aFils)
        nCount++
        oStmt:setIn( nCount, aFils )
    EndIf

    If !Empty(cPeriodo)
        nCount++
        oStmt:SetString( nCount, cPeriodo )
    EndIf

    If !Empty(cRevCode)
        nCount++
        oStmt:SetString( nCount, "%" + cRevCode + "%" )
    EndIf

    If !Empty(cCpf)
        nCount++
        oStmt:SetString( nCount, cCpf )
    EndIf

    If !Empty(cName)
        nCount++
        oStmt:SetString( nCount, cName )
    EndIf

    cAliasQry := oStmt:OpenAlias()
    
    // Log query para debug
    cQuery := oStmt:getFixQuery()
    TafConOut(ProcName() + " " + cQuery)

    oStmt:executeQuery( cAliasQry )
    
    ( cAliasQry )->( DbGoTop() )

    If !(cAliasQry)->(EoF())
        TAFCodTotais( cAliasQry, @aTotalizer )
    EndIf
    
    (cAliasQry)->(DbCloseArea())

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFCodReceita
@type           Function
@description    Consulta analítica por código de receita.
@author         Alexandre de Lima Santos.
@since          28/10/2025
@param          aFils (Array)           - Filiais.
@param          cPeriodo (Char)         - Período.
@param          cRevCode (Char)         - Código Receita.
@param          cCpf (Char)             - CPF.
@param          cName (Char)            - Nome.
@param          aTotalizer (Ref Array)  - Dados totalizados.
@param          aEmployeCod (Ref Array) - Retorno com dados por empregado.
/*/
//---------------------------------------------------------------------
Function TAFCodReceita( aFils as Array, cPeriodo as Character, cRevCode as Character, cCpf as Character, cName as Character, aTotalizer as Array, aEmployeCod as Array )

    Local cAliasQry as Character
    Local cQuery    as Character
    Local nCount    as Numeric
    Local nX        as Numeric
    Local oStmt     as Object

    Default aEmployeCod := {}
    Default aFils       := FilMatriz()
    Default aTotalizer  := {}
    Default cCpf        := ""
    Default cName       := ""
    Default cRevCode    := ""
      
    cAliasQry := GetNextAlias()
    cQuery    := ""
    nCount    := 0
    nX        := 0
    oStmt     := Nil

    For nX := 1 to Len( aTotalizer )
        
        nCount := 0
        cQuery := " SELECT T8R_CODREC, T8R_NOME AS NOME, T8R_CPF AS CPF, T8R_ORIGEM AS ORIGEM, SUM( T8R_VLIRRF ) AS VLIRRF "
        cQuery += " FROM " + RetSqlName( "T8R" ) + " T8R "
        cQuery += " WHERE T8R_FILIAL IN (?) " 
        cQuery += " AND T8R_PERAPU = ? "

        If !Empty(aTotalizer[nX][1])
            cQuery += " AND T8R_CODREC LIKE ? "
        EndIf
        
        If !Empty(cCpf)
            cQuery += " AND T8R_CPF = ? "
        EndIf

        If !Empty(cName)
            cQuery += " AND T8R_NOME = ? "
        EndIf

        cQuery += " AND T8R.D_E_L_E_T_ = ''"
        cQuery += " AND ( T8R_FORABA = 'TRIBUT' OR T8R_FORABA = 'DEDDEP' OR T8R_FORABA = 'PENALI' OR T8R_FORABA = 'PREVCL' OR T8R_FORABA = 'PROCRE' ) "
        cQuery += " GROUP BY T8R_ORIGEM, T8R_CODREC, T8R_NOME, T8R_CPF "
        
        oStmt := FWExecStatement():New( ChangeQuery(cQuery) )

        If !Empty(aFils)
            nCount++
            oStmt:setIn( nCount, aFils )
        EndIf

        If !Empty(cPeriodo)
            nCount++
            oStmt:SetString( nCount, cPeriodo )
        EndIf

        If !Empty(aTotalizer[nX][1])
            nCount++
            oStmt:SetString( nCount, "%" + aTotalizer[nX][1] + "%" )
        EndIf

        If !Empty(cCpf)
            nCount++
            oStmt:SetString( nCount, cCpf )
        EndIf

        If !Empty(cName)
            nCount++
            oStmt:SetString( nCount, cName )
        EndIf

        cAliasQry := oStmt:OpenAlias()
        cQuery    := oStmt:getFixQuery()
        TafConOut(ProcName() + " " + cQuery)

        oStmt:executeQuery( cAliasQry )
        
        ( cAliasQry )->( DbGoTop() )

        If !(cAliasQry)->(EoF())
            TAFCodIRRF( cAliasQry, @aEmployeCod )
        EndIf

        (cAliasQry)->(DbCloseArea())

    Next nX

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFFormEmployes
@type           Function
@description    Consulta dados complementares (não tributários) dos empregados.
@author         Alexandre de Lima Santos.
@since          28/10/2025
@param          aFils (Array)           - Filiais.
@param          cPeriodo (Char)         - Período.
@param          cRevCode (Char)         - Código Receita.
@param          cCpf (Char)             - CPF.
@param          cName (Char)            - Nome.
@param          aTotalizer (Array)      - Dados totalizados (base para loop).
@param          aForms (Ref Array)      - Retorno com dados dos formulários.
/*/
//---------------------------------------------------------------------
Function TAFFormEmployes( aFils as Array, cPeriodo as Character, cRevCode as Character, cCpf as Character, cName as Character, aTotalizer as Array, aForms as Array )

    Local cAliasQry as Character
    Local cQuery    as Character
    Local nCount    as Numeric
    Local nX        as Numeric
    Local oStmt     as Object
	Local aEmployeCod as Array

    Default aFils       := FilMatriz()
    Default aForms      := {}
    Default aTotalizer  := {}
    Default cCpf        := ""
    Default cName       := ""
    Default cRevCode    := ""
      
	aEmployeCod := {}
    cAliasQry   := ""
    cQuery      := ""
    nCount      := 0
    nX          := 0
    oStmt       := Nil

    For nX := 1 to Len( aTotalizer )

        cAliasQry := GetNextAlias()
        
        nCount := 0
        
        cQuery := " SELECT T8R_CPF, T8R_NOME, T8R_CODREC, T8R_TPREND, T8R_CPFDEP, T8R_VLRDED, T8R_TPRPAL, T8R_CPFDPA, T8R_VLRPAL, T8R_TPPREV, T8R_CNPJPC,"
        cQuery += " T8R_VLDEPC, T8R_VLPC13, T8R_VLPCSP, T8R_TPPROC, T8R_NRPROC, T8R_CODSUP, T8R_INDAPU, T8R_VLRRTC, T8R_DEPJUD, T8R_CANOCA, T8R_CANOAN,"
        cQuery += " T8R_RENDSU, T8R_INDDED, T8R_DEDSUS, T8R_CNPJEC, T8R_VLCONT, T8R_CPFSUS, T8R_DEPSUS, T8R_CNPJOP, T8R_REGANS, T8R_VLRPLS, T8R_CPFDPS,"
        cQuery += " T8R_ORIREE, T8R_CNPJPS, T8R_ANSRRE, T8R_INSCRE, T8R_NRPSRE, T8R_VLREEM, T8R_VLRANT,T8R_CPFRED, T8R_DINSCR, T8R_DNRPSR, T8R_DVLRRE, T8R_DVLRAN, T8R_ORIGEM "
        cQuery += " FROM " + RetSqlName( "T8R" ) + " T8R "
        cQuery += " WHERE T8R_FILIAL IN (?) " 
        cQuery += " AND T8R_PERAPU = ? "

        If !Empty(aTotalizer[nX][1])
            cQuery += " AND ( T8R_CODREC LIKE ? OR T8R_CODREC = '' ) "
        EndIf
        
        If !Empty(aTotalizer[nX][3])
            cQuery += " AND T8R_CPF = ? "
        EndIf

        If !Empty(cName)
            cQuery += " AND T8R_NOME = ? "
        EndIf

        cQuery += " AND T8R.D_E_L_E_T_ = '' "
        cQuery += " AND T8R_ORIGEM IN( '1', '2', '3' )"
        
        oStmt := FWExecStatement():New( ChangeQuery(cQuery) )

        If !Empty(aFils)
            nCount++
            oStmt:setIn( nCount, aFils )
        EndIf

        If !Empty(cPeriodo)
            nCount++
            oStmt:SetString( nCount, cPeriodo )
        EndIf

        If !Empty(aTotalizer[nX][1])
            nCount++
            oStmt:SetString( nCount, "%" + aTotalizer[nX][1] + "%" )
        EndIf

        If !Empty(aTotalizer[nX][3])
            nCount++
            oStmt:SetString( nCount, aTotalizer[nX][3] )
        EndIf

        If !Empty(cName)
            nCount++
            oStmt:SetString( nCount, cName )
        EndIf

        cAliasQry := oStmt:OpenAlias()
        
        TafConOut(ProcName() + " " + cQuery)

        oStmt:executeQuery( cAliasQry )
        
        ( cAliasQry )->( DbGoTop() )

        If !(cAliasQry)->(EoF())
            TAFFormCod( cAliasQry, @aEmployeCod, @aForms, aFils, cPeriodo, aTotalizer[nX][1] )
        EndIf
        
        (cAliasQry)->(DbCloseArea())

    Next nX

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} GetPercent
@type           function
@description    Consulta o percentual de processamento da requisição na tabela V3J.
@author         Felipe C. Seolin
@since          30/08/2019
@param          jResponse (Ref Json) - Objeto JSON de retorno.
@param          cRequestID (Char)    - Identificador da Requisição.
/*/
//---------------------------------------------------------------------
Function GetPercent( jResponse as Json, cRequestID as Character )

    Default jResponse := JsonObject():New()

    DBSelectArea( "V3J" )
    V3J->( DBSetOrder( 1 ) )

    // Atualiza progresso para 100% caso esteja finalizado (lógica interna do setProgress)
    setProgress( cRequestID, 100, 100,,, )

    If V3J->( DBSeek( xFilial( "V3J" ) + cRequestID ) )

        jResponse["percent"] := V3J->V3J_PERC

        If V3J->V3J_PERC == 100
            jResponse["finished"] := .T.  
        Else
            jResponse["finished"] := .F.
        EndIf

    EndIf

    TAFConOut( ProcName() + " " + jResponse:ToJson() + ' ' +  V3J->V3J_STATUS + ' ' + cValToChar(V3J->V3J_PERC) )

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} setProgress
@type           function
@description    Atualiza o percentual de processamento na tabela V3J.
@author         Robson Santos
@since          26/08/19
@param          cTicket (Char)   - ID da Requisição.
@param          nItem (Num)      - Item atual.
@param          nQtdRegs (Num)   - Total de registros.
@param          lPercRH (Log)    - Indica se o percentual vem do RH.
@param          nPercRH (Num)    - Valor do percentual do RH.
@param          lIsLegacy (Log)  - Indica processamento legado.
/*/
//---------------------------------------------------------------------
Function setProgress( cTicket as Character, nItem as Numeric, nQtdRegs as Numeric, lPercRH as Logical,;
                      nPercRH as Numeric, lIsLegacy as Logical )

    Local aArea as Array
    Local lRet  as Logical
    Local nDif  as Numeric
    Local nPerc as Numeric
    Local nPeso as Numeric

    Default lPercRH   := .F.
    Default nPercRH   := 0
    Default lIsLegacy := .F.

    aArea := GetArea()
    lRet  := .F.
    nDif  := 0
    nPerc := 0
    nPeso := 50

    If V3J->( MsSeek( xFilial( "V3J" ) + PadR( cTicket, TamSX3( "V3J_ID" )[1] ) ) )

        If !lPercRH

            // --- Evita divisão por zero ---
            If nQtdRegs > 0
                // Calcula proporcionalidade baseada no peso (50%)
                nPerc := ( Int( ( nItem / nQtdRegs ) * 100 ) * ( nPeso/100 ) )
            Else
                nPerc := 0
            EndIf
            // ------------------------------------------

            If lIsLegacy
                nDif := ( ( V3J->V3J_PERC + nPerc ) - V3J->V3J_PERC )
            Else
                nDif := ( nPerc - V3J->V3J_PERC )
            EndIf

        Else

            nPerc := nPercRH

        EndIf

        If nPerc > 0

            If !lPercRH

                If V3J->V3J_PERC >= nPeso
                    nPerc := ( nPeso + nPerc )
                Else
                    nPerc := ( V3J->V3J_PERC + nDif )
                EndIf

            EndIf
            
            // --- BLINDAGEM CONTRA ESTOURO DE CAMPO ---
            // Se o cálculo matemático passar de 100% (por erro de contagem), 
            // forçamos o teto em 100 para não quebrar o banco de dados.
            If nPerc > 100
                nPerc := 100
            EndIf
            // -----------------------------------------------------

            RecLock( "V3J", .F. )
                V3J->V3J_PERC := Int( nPerc )
            V3J->( MsUnlock() )

        EndIf

        lRet := .T.

    EndIf

    RestArea( aArea )

Return lRet

//-------------------------------------------------------------------
/*/{Protheus.doc} FilMatriz
@type           function
@description    Retorna todas as filiais associadas à matriz logada ou grupo de empresas.
@author         Alexandre de Lima
@since          24/11/2025
@return         aFiliais (Array) - Lista de filiais.
/*/
//-------------------------------------------------------------------
Function FilMatriz()

    Local aFiliais := {}

    C1E->(DBSetOrder(3)) // Filial + ID
    
    If C1E->(MsSeek(xFilial("C1E") + PadR(cFilAnt, GetSX3Cache("C1E_FILTAF", "X3_TAMANHO")) + "1"))

        If C1E->C1E_MATRIZ
            aFiliais := LoadSM0BaseCNPJ()
        EndIf

    EndIf

    If Empty(aFiliais)
        aAdd(aFiliais, cFilAnt)
    EndIf

Return aFiliais

//---------------------------------------------------------------------
/*/{Protheus.doc} LoadSM0BaseCNPJ
@type           function
@description    Busca as Filiais com a mesma Raiz de CNPJ da filial logada.
@author         Alexandre de Lima
@since          24/11/2025
@return         aFilial (Array) - Lista de códigos de filiais.
/*/
//---------------------------------------------------------------------
Function LoadSM0BaseCNPJ()

    Local aFilial   := {}
    Local aSM0      := FWLoadSM0( .T.,,.T. )
    Local cBaseCNPJ := Left( AllTrim( Posicione( "SM0", 1, cEmpAnt + cFilAnt, "M0_CGC" ) ), 8 )
    Local nI        := 0

    For nI := 1 to Len( aSM0 )

        If cBaseCNPJ == AllTrim( Left( aSM0[nI][SM0_CGC], 8 ) )

            aAdd( aFilial, aSM0[nI][SM0_CODFIL] )

        EndIf

    Next nI

Return( aFilial )

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFCodTotais
@description    Processa o resultado da query de totais e preenche o array analítico.
@author         Alexandre de Lima Santos.
@since          28/10/2025
@param          cAliasQry (Char)        - Alias da query aberta.
@param          aAnalitico (Ref Array)  - Array onde os dados serão armazenados.
/*/
//---------------------------------------------------------------------
Function TAFCodTotais( cAliasQry as Character, aAnalitico as Array )

    Local aCodRec     as Array
    Local cCodRec     as Character
    Local nPosValores as Numeric
    Local nX          as Numeric
    Local nPos        as Numeric

    Default aAnalitico  := {}

    aCodRec     := {}
    cCodRec     := ""
    nPosValores := 0
    nX          := 0

    ( cAliasQry )->( DbGoTop() )

    While !(cAliasQry)->(EoF())

        If ( cAliasQry )->T8R_ORIGEM == "1" // TAF (Origem 1)

            aCodRec := StrTokArr( ( cAliasQry )->T8R_CODREC, "|" )

            For nX := 1 to Len( aCodRec )

                cCodRec := Alltrim(aCodRec[nX])

                If !Empty( cCodRec )

                    nPos := aScan(aAnalitico, {|x| AllTrim(Upper(x[1])) == cCodRec })

                    If nPos > 0
                        nPosValores := nPos
                    Else
                        aAdd(aAnalitico, Array(58))
                        nPosValores := Len(aAnalitico)
                        TAFInitArray( aAnalitico, nPosValores )
                    EndIf

                    aAnalitico[nPosValores][ANALITICO_CODRECEITA] := cCodRec

                    If cCodRec $ "056107|056108|056111|058806|061001|356201|188901|353301|188901"   
                        aAnalitico[nPosValores][ANALITICO_VLRRENDTRIB]  += ( cAliasQry )->VLRTRI
                    EndIf

                    If cCodRec $ "056107|056109|056110|056112|056113|058806|353301"   
                        aAnalitico[nPosValores][ANALITICO_VLRRENDTRIB13] += ( cAliasQry )->VRTR13
                        aAnalitico[nPosValores][ANALITICO_VLRPREVOFICIAL13] += ( cAliasQry )->VPRE13
                    EndIf

                    If cCodRec $ "056107|056108|056111|058806|061001|188901|353301|188901"   
                        aAnalitico[nPosValores][ANALITICO_VLRPREVOFICIAL]   += ( cAliasQry )->VLRPRE
                    EndIf

                    If cCodRec $ "056107|056108|056111|058806|061001|356201|188901|353301|188901"   
                        aAnalitico[nPosValores][ANALITICO_VLRCRMEN]         += ( cAliasQry )->VLIRRF
                    EndIf

                    If cCodRec $ "056107|056109|056110|056112|056113|356201|058806|353301"   
                        aAnalitico[nPosValores][ANALITICO_VLRCRMEN13]       += ( cAliasQry )->IRRF13
                    EndIf

                    If cCodRec $ "188901|353301|188901"   
                        aAnalitico[nPosValores][ANALITICO_VLRPARC65]        += ( cAliasQry )->VLRISE
                    EndIf

                    If cCodRec == "353301"   
                        aAnalitico[nPosValores][ANALITICO_VLRPARC6513]      += ( cAliasQry )->VLRI13
                    EndIf

                    If  cCodRec $ "056107|056108|056111|058806"   
                        aAnalitico[nPosValores][ANALITICO_VLRDIARIAS]       += ( cAliasQry )->VLRDIA
                        aAnalitico[nPosValores][ANALITICO_VLRAJDCUSTO]      += ( cAliasQry )->VLRAJU
                        aAnalitico[nPosValores][ANALITICO_VLRINDRESCTR]     += ( cAliasQry )->VLRRSC
                        aAnalitico[nPosValores][ANALITICO_VLRABONOPEC]      += ( cAliasQry )->VLRABN
                        aAnalitico[nPosValores][ANALITICO_VLRAUXMOR]        += ( cAliasQry )->VLRAXM
                    EndIf

                    If  cCodRec $ "188901|353301"   
                        aAnalitico[nPosValores][ANALITICO_VLRRENMOLGRV]     += ( cAliasQry )->VLRMLG
                        aAnalitico[nPosValores][ANALITICO_VLRRENMOLGRV13]   += ( cAliasQry )->VMLG13
                    EndIf

                    If  cCodRec == "056107"   
                        aAnalitico[nPosValores][ANALITICO_VLRBOLMEDIC]      += ( cAliasQry )->VLBMED
                        aAnalitico[nPosValores][ANALITICO_VLRBOLMEDIC13]    += ( cAliasQry )->BMED13
                    EndIf

                    If cCodRec == "188901"
                        aAnalitico[nPosValores][ANALITICO_VLRJUROSMORA]     += ( cAliasQry )->VLRMOR
                    EndIf
                    
                    If  cCodRec $ "056107|056108|056111|058806|353301"   
                        aAnalitico[nPosValores][ANALITICO_VLRINSEOUTROS]    += ( cAliasQry )->VLRISO
                    EndIf

                EndIf

            Next nX

        Else // Governo/Retorno (Origem Diferente de 1)

            cCodRec := Alltrim(( cAliasQry )->T8R_CODREC)

            nPos := aScan(aAnalitico, {|x| AllTrim(Upper(x[1])) == cCodRec })

            If nPos > 0
                nPosValores := nPos
            Else
                aAdd(aAnalitico, Array(58))
                nPosValores := Len(aAnalitico)
                TAFInitArray( aAnalitico, nPosValores )
            EndIf

            aAnalitico[nPosValores][ANALITICO_CODRECEITA] := cCodRec

            If cCodRec $ "056107|056108|056111|058806|061001|356201|188901|353301|188901"   
                IIf(( cAliasQry )->T8R_ORIGEM == '3', aAnalitico[nPosValores][ANALITICO_VLRRENDTRIBGOV] := ( cAliasQry )->VLRTRI, aAnalitico[nPosValores][ANALITICO_VLRRENDTRIBFOLHA]   := ( cAliasQry )->VLRTRI )
            EndIf

            If cCodRec $ "056107|056109|056110|056112|056113|058806|353301"   
            
                If ( cAliasQry )->T8R_ORIGEM == '3'
                    aAnalitico[nPosValores][ANALITICO_VLRRENDTRIB13GOV]     := ( cAliasQry )->VRTR13
                    aAnalitico[nPosValores][ANALITICO_VLRPREVOFICIAL13GOV]  := ( cAliasQry )->VPRE13
                Else
                    aAnalitico[nPosValores][ANALITICO_VLRRENDTRIB13FOLHA]     := ( cAliasQry )->VRTR13
                    aAnalitico[nPosValores][ANALITICO_VLRPREVOFICIAL13FOLHA]  := ( cAliasQry )->VPRE13
                EndIf

            EndIf

            If cCodRec $ "056107|056108|056111|058806|061001|188901|353301|188901"   
                IIf(( cAliasQry )->T8R_ORIGEM == '3', aAnalitico[nPosValores][ANALITICO_VLRPREVOFICIALGOV] := ( cAliasQry )->VLRPRE, aAnalitico[nPosValores][ANALITICO_VLRPREVOFICIALFOLHA]    := ( cAliasQry )->VLRPRE )
            EndIf

            If cCodRec $ "056107|056108|056111|058806|061001|356201|188901|353301|188901"   
                IIf(( cAliasQry )->T8R_ORIGEM == '3', aAnalitico[nPosValores][ANALITICO_VLRCRMENGOV] := ( cAliasQry )->VLIRRF, aAnalitico[nPosValores][ANALITICO_VLRCRMENFOLHA] := ( cAliasQry )->VLIRRF )
            EndIf

            If cCodRec $ "056107|056109|056110|056112|056113|356201|058806|353301"   
                IIf(( cAliasQry )->T8R_ORIGEM == '3', aAnalitico[nPosValores][ANALITICO_VLRCRMEN13GOV] := ( cAliasQry )->IRRF13, aAnalitico[nPosValores][ANALITICO_VLRCRMEN13FOLHA]:= ( cAliasQry )->IRRF13 )
            EndIf

            If cCodRec $ "188901|353301|188901"   
                IIf(( cAliasQry )->T8R_ORIGEM == '3', aAnalitico[nPosValores][ANALITICO_VLRPARC65GOV] := ( cAliasQry )->VLRISE, aAnalitico[nPosValores][ANALITICO_VLRPARC65FOLHA] := ( cAliasQry )->VLRISE )
            EndIf

            If cCodRec == "353301"   
                IIf(( cAliasQry )->T8R_ORIGEM == '3', aAnalitico[nPosValores][ANALITICO_VLRPARC6513GOV] := ( cAliasQry )->VLRI13, aAnalitico[nPosValores][ANALITICO_VLRPARC6513FOLHA] := ( cAliasQry )->VLRI13 )
            EndIf

            If  cCodRec $ "056107|056108|056111|058806"   
                
                If ( cAliasQry )->T8R_ORIGEM == '3'
                    aAnalitico[nPosValores][ANALITICO_VLRDIARIASGOV]    := ( cAliasQry )->VLRDIA
                    aAnalitico[nPosValores][ANALITICO_VLRAJDCUSTOGOV]   := ( cAliasQry )->VLRAJU
                    aAnalitico[nPosValores][ANALITICO_VLRINDRESCTRGOV]  := ( cAliasQry )->VLRRSC
                    aAnalitico[nPosValores][ANALITICO_VLRABONOPECGOV]   := ( cAliasQry )->VLRABN
                    aAnalitico[nPosValores][ANALITICO_VLRAUXMORGOV]     := ( cAliasQry )->VLRAXM
                Else
                    aAnalitico[nPosValores][ANALITICO_VLRDIARIASFOLHA]    := ( cAliasQry )->VLRDIA
                    aAnalitico[nPosValores][ANALITICO_VLRAJDCUSTOFOLHA]   := ( cAliasQry )->VLRAJU
                    aAnalitico[nPosValores][ANALITICO_VLRINDRESCTRFOLHA]  := ( cAliasQry )->VLRRSC
                    aAnalitico[nPosValores][ANALITICO_VLRABONOPECFOLHA]   := ( cAliasQry )->VLRABN
                    aAnalitico[nPosValores][ANALITICO_VLRAUXMORFOLHA]     := ( cAliasQry )->VLRAXM
                EndIf

            EndIf

            If  cCodRec $ "188901|353301"  

                If ( cAliasQry )->T8R_ORIGEM == '3'

                    aAnalitico[nPosValores][ANALITICO_VLRRENMOLGRVGOV]      := ( cAliasQry )->VLRMLG
                    aAnalitico[nPosValores][ANALITICO_VLRRENMOLGRV13GOV]    := ( cAliasQry )->VMLG13

                Else

                    aAnalitico[nPosValores][ANALITICO_VLRRENMOLGRVFOLHA]      := ( cAliasQry )->VLRMLG
                    aAnalitico[nPosValores][ANALITICO_VLRRENMOLGRV13FOLHA]    := ( cAliasQry )->VMLG13

                EndIf

            EndIf

            If  cCodRec == "056107"   

                If ( cAliasQry )->T8R_ORIGEM == '3'

                    aAnalitico[nPosValores][ANALITICO_VLRBOLMEDICGOV]       := ( cAliasQry )->VLBMED
                    aAnalitico[nPosValores][ANALITICO_VLRBOLMEDIC13GOV]     := ( cAliasQry )->BMED13

                Else

                    aAnalitico[nPosValores][ANALITICO_VLRBOLMEDICFOLHA]       := ( cAliasQry )->VLBMED
                    aAnalitico[nPosValores][ANALITICO_VLRBOLMEDIC13FOLHA]     := ( cAliasQry )->BMED13

                EndIf
            EndIf

            If cCodRec == "188901"
                IIf( ( cAliasQry )->T8R_ORIGEM == '3', aAnalitico[nPosValores][ANALITICO_VLRJUROSMORAGOV] := ( cAliasQry )->VLRMOR, aAnalitico[nPosValores][ANALITICO_VLRJUROSMORAFOLHA] := ( cAliasQry )->VLRMOR )
            EndIf
            
            If  cCodRec $ "056107|056108|056111|058806|353301"   
                IIf( ( cAliasQry )->T8R_ORIGEM == '3', aAnalitico[nPosValores][ANALITICO_VLRINSEOUTROSGOV] := ( cAliasQry )->VLRISO, aAnalitico[nPosValores][ANALITICO_VLRINSEOUTROSFOLHA] := ( cAliasQry )->VLRISO )
            EndIf

        EndIf

        (cAliasQry)->(DbSkip())

    EndDo

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFCodIRRF
@type           Function
@description    Processa os detalhes por empregado (IRRF) e preenche o array.
@author         Alexandre de Lima Santos.
@since          28/10/2025
@param          cAliasQry (Char)        - Alias da query.
@param          aEmployeCod (Ref Array) - Array de empregados.
@return         aEmployeCod (Array)     - Array preenchido.
/*/
//---------------------------------------------------------------------
Function TAFCodIRRF( cAliasQry as Character, aEmployeCod as Array )

    Local aCodRec     as Array
    Local cCodRec     as Character
    Local nPosValores as Numeric
    Local nX          as Numeric
    Local nPos        as Numeric

    Default aEmployeCod := {}
    Default cAliasQry   := ""

    aCodRec     := {}
    cCodRec     := ""
    nPosValores := 0
    nX          := 0

    ( cAliasQry )->( DbGoTop() )

    While !(cAliasQry)->(EoF())

        If ( cAliasQry )->ORIGEM == "1"

            aCodRec := StrTokArr( ( cAliasQry )->T8R_CODREC, "|" )

            For nX := 1 to Len( aCodRec )

                cCodRec := Alltrim(aCodRec[nX])

                If !Empty( cCodRec )

                    nPos := aScan(aEmployeCod, {|x| AllTrim(Upper(x[1])) == cCodRec .AND. AllTrim(x[3]) == ( cAliasQry )->CPF })

                    If nPos > 0
                        nPosValores := nPos
                    Else
                        aAdd(aEmployeCod, Array(6))
                        nPosValores := Len(aEmployeCod)
                        TafIniIRRF( aEmployeCod, nPosValores )
                    EndIf

                    aEmployeCod[nPosValores][CODRECEITA_CODRECEITA] := cCodRec
                    aEmployeCod[nPosValores][CODRECEITA_NOME]       := ( cAliasQry )->NOME
                    aEmployeCod[nPosValores][CODRECEITA_CPF]        := ( cAliasQry )->CPF

                    If cCodRec $ "056107|056108|056111|058806|061001|356201|188901|353301|188901"   
                        aEmployeCod[nPosValores][CODRECEITA_VLRIRRF]    += ( cAliasQry )->VLIRRF
                    EndIf

                EndIf

            Next nX

        Else

            cCodRec := Alltrim(( cAliasQry )->T8R_CODREC)

            nPos := aScan(aEmployeCod, {|x| AllTrim(Upper(x[1])) == cCodRec .AND. AllTrim(x[3]) == ( cAliasQry )->CPF })

            If nPos > 0
                nPosValores := nPos
            Else
                aAdd(aEmployeCod, Array(6))
                nPosValores := Len(aEmployeCod)
                TafIniIRRF( aEmployeCod, nPosValores )
            EndIf

            aEmployeCod[nPosValores][CODRECEITA_CODRECEITA] := cCodRec
            aEmployeCod[nPosValores][CODRECEITA_NOME]       := ( cAliasQry )->NOME
            aEmployeCod[nPosValores][CODRECEITA_CPF]        := ( cAliasQry )->CPF

            If cCodRec $ "056107|056108|056111|058806|061001|356201|188901|353301|188901"
                
                IIf( ( cAliasQry )->ORIGEM == "2", aEmployeCod[nPosValores][CODRECEITA_VLRIRRFFOLHA] += ( cAliasQry )->VLIRRF, aEmployeCod[nPosValores][CODRECEITA_VLRIRRFGOV] += ( cAliasQry )->VLIRRF )
                
            EndIf

        EndIf

        (cAliasQry)->(DbSkip())

    EndDo

Return aEmployeCod

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFInitArray
@type           Static Function
@description    Inicializa o array de analítico com valores zerados.
@author         Alexandre de Lima Santos.
@since          28/10/2025
@param          aAnalitico (Ref Array) - Array a ser inicializado.
@param          nPosValores (Num)      - Posição a ser inicializada.
/*/
//---------------------------------------------------------------------
Static Function TAFInitArray( aAnalitico as Array, nPosValores as Numeric )

    Local nI as Numeric
    
    Default aAnalitico  := {}
    Default nPosValores := 0

    // Otimização: Loop para inicializar do índice 2 ao 39
    aAnalitico[nPosValores][1]  := ""

    For nI := 2 to 58
        aAnalitico[nPosValores][nI] := 0
    Next nI

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} TafIniIRRF
@type           Function
@description    Inicializa o array de IRRF por empregado.
@author         Alexandre de Lima Santos.
@since          28/10/2025
@param          aAnalitico (Ref Array) - Array a ser inicializado.
@param          nPosValores (Num)      - Posição a ser inicializada.
/*/
//---------------------------------------------------------------------
Function TafIniIRRF( aAnalitico as Array, nPosValores as Numeric )

    Default aAnalitico  := {}
    Default nPosValores := 0

    aAnalitico[nPosValores][1]  := ""
    aAnalitico[nPosValores][2]  := ""
    aAnalitico[nPosValores][3]  := ""
    aAnalitico[nPosValores][4]  := 0
    aAnalitico[nPosValores][5]  := 0
    aAnalitico[nPosValores][6]  := 0

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} tafGeraTic
@type           function
@description    Cria e armazena o ticket para a requisição na tabela V3J.
@author         Robson Santos
@since          05/09/2019
@param          jRequest (Json) - Objeto da requisição.
@param          cBody (Char)    - Corpo da requisição com os parâmetros.
@return         cTicket (Char)  - ID gerado.
/*/
//---------------------------------------------------------------------
Function tafGeraTic( jRequest as Json, cBody as Character, cTribute as character ) as Character

    Local cTicket   as Character
    Local cServ     as Character
    Local oModelV3J as Object
    
    Default cTribute := ""

    oModelV3J := FWLoadModel( "TAFA531" )
    cTicket   := FWuuId( "WSTAF010" )
    cServ     := ""

    // Mapeamento de serviços para Log
    If jRequest["tribute"] == "1"

        cServ := "reportEsocialBaseConfer/InssRetValues"
        APILogAccess("ReportEsocialBaseConfer", "INSS")

    ElseIf jRequest["tribute"] == "2"

        cServ := "reportEsocialBaseConfer/FgtsValues"
        APILogAccess("ReportEsocialBaseConfer", "FGTS")

    ElseIf jRequest["tribute"] == "3"

        cServ := "reportEsocialBaseConfer/IrrfRetValues"
        APILogAccess("ReportEsocialBaseConfer", "IRRF")

    ElseIf cTribute == "4"

        cServ := "/api/rh/esocial/v1/reportEsocialIrrfRevenueCodes/totalizers"
        APILogAccess("ReportEsocialBaseConfer", "IRRF")

    EndIf

    oModelV3J:SetOperation( MODEL_OPERATION_INSERT )
    oModelV3J:Activate()
    oModelV3J:LoadValue( "MODEL_V3J", "V3J_ID"      , cTicket                       )
    oModelV3J:LoadValue( "MODEL_V3J", "V3J_SERVIC"  , cServ                         )
    oModelV3J:LoadValue( "MODEL_V3J", "V3J_METODO"  , "POST"                        )
    oModelV3J:LoadValue( "MODEL_V3J", "V3J_DTREQ"   , Date()                        )
    oModelV3J:LoadValue( "MODEL_V3J", "V3J_HRREQ"   , StrTran( Time(), ":", "" )    )
    oModelV3J:LoadValue( "MODEL_V3J", "V3J_STATUS"  , "1"                           )
    oModelV3J:LoadValue( "MODEL_V3J", "V3J_PARAMS"  , cBody                         )

    FWFormCommit( oModelV3J )

    oModelV3J:DeActivate()
    oModelV3J:Destroy()

Return cTicket

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFFormCod
@type           Function
@description    Processa os registros da query para montar a estrutura de formulários do JSON.
@author         Alexandre de Lima Santos
@since          03/12/2025
@param          cAliasQry (Char)        - Alias da consulta SQL.
@param          aEmployeCod (Array)     - (Não utilizado diretamente neste bloco, mas mantido assinatura).
@param          aForms (Ref Array)      - Array de formulários a ser populado.
@param          aFils (Array)           - Filiais.
@param          cPeriodo (Char)         - Período.
/*/
//---------------------------------------------------------------------
Function TAFFormCod( cAliasQry as Character, aEmployeCod as Array, aForms as Array, aFils as Array, cPeriodo as Character, cCodRec as character )

	Local aPlan01     as Array 
    Local aPlan02     as Array 
    Local aPlan03     as Array 
    Local aPlan04     as Array 
    Local aPlan05     as Array 
    Local aPlan06     as Array
    Local cOrigem     as Character
    Local cCPF        as Character
    Local nPos        as Numeric
    Local nPosValores as Numeric
    Local nC1         as Numeric
    Local lProcess    as Logical

    Default cAliasQry   := ""
    Default cPeriodo    := ""
    Default cCodRec     := ""
    Default aEmployeCod := {}
    Default aForms      := {}
    Default aFils       := {}

    aPlan01     := {}
    aPlan02     := {}
    aPlan03     := {}
    aPlan04     := {}
    aPlan05     := {}
    aPlan06     := {}
    cOrigem     := ""
    nPosValores := 0
    nC1         := 0

    ( cAliasQry )->( DbGoTop() )

    While !(cAliasQry)->(EoF())
        
        cCPF    := ( cAliasQry )->T8R_CPF
        nPos := aScan(aForms, {|x| AllTrim(x[5]) == cCodRec .AND. AllTrim(x[3]) == cCPF })

        If nPos > 0
            nPosValores := nPos
        Else
            aAdd(aForms, Array(22))
            nPosValores := Len(aForms)
            TafIniForm( @aForms, nPosValores )
        EndIf

        aForms[nPosValores][FORM_PERIODO]       := cPeriodo
        aForms[nPosValores][FORM_NOME]          := ( cAliasQry )->T8R_NOME
        aForms[nPosValores][FORM_CPF]           := ( cAliasQry )->T8R_CPF
        aForms[nPosValores][FORM_REVENUECODE]   := Alltrim(cCodRec)
        cOrigem := ( cAliasQry )->T8R_ORIGEM

        If Empty( aForms[nPosValores][FORM_REVENUESCODES] )
            aForms[nPosValores][FORM_REVENUESCODES] := TAFCodes( ( cAliasQry )->T8R_CPF, cPeriodo, aFils )
        EndIf

        // Carrega dados de Planos de Saúde/Reembolso (apenas na primeira iteração para o CPF atual da query)
        // Nota: A lógica original usa nC1 para controlar execução única. Mantido comportamento original.
        If nC1 == 0

            nC1++

            // Origem 1
            TAFNoRec( aFils, cCPF, cPeriodo, "PLASAU", '1', @aPlan01 )
            TAFNoRec( aFils, cCPF, cPeriodo, "DEPSAU", '1', @aPlan02 )
            TAFNoRec( aFils, cCPF, cPeriodo, "REMMED", '1', @aPlan03 )
            TAFNoRec( aFils, cCPF, cPeriodo, "REMTID", '1', @aPlan04 )
            TAFNoRec( aFils, cCPF, cPeriodo, "REMDEP", '1', @aPlan05 )
            TAFNoRec( aFils, cCPF, cPeriodo, "DETDEP", '1', @aPlan06 )

            // Origem 2
            TAFNoRec( aFils, cCPF, cPeriodo, "PLASAU", '2', @aPlan01 )
            TAFNoRec( aFils, cCPF, cPeriodo, "DEPSAU", '2', @aPlan02 )
            TAFNoRec( aFils, cCPF, cPeriodo, "REMMED", '2', @aPlan03 )
            TAFNoRec( aFils, cCPF, cPeriodo, "REMTID", '2', @aPlan04 )
            TAFNoRec( aFils, cCPF, cPeriodo, "REMDEP", '2', @aPlan05 )
            TAFNoRec( aFils, cCPF, cPeriodo, "DETDEP", '2', @aPlan06 )

            // Origem 3
            TAFNoRec( aFils, cCPF, cPeriodo, "PLASAU", '3', @aPlan01 )
            TAFNoRec( aFils, cCPF, cPeriodo, "DEPSAU", '3', @aPlan02 )
            TAFNoRec( aFils, cCPF, cPeriodo, "REMMED", '3', @aPlan03 )
            TAFNoRec( aFils, cCPF, cPeriodo, "REMTID", '3', @aPlan04 )
            TAFNoRec( aFils, cCPF, cPeriodo, "REMDEP", '3', @aPlan05 )
            TAFNoRec( aFils, cCPF, cPeriodo, "DETDEP", '3', @aPlan06 )

            // Planos de saúde são carregados para ambos, mas só atribuidos aqui se Origem = 1 na lógica original?
            // Verificando código original: Origem 1 atribuía Planos. Origem 3 atribuía Planos também.
            // A lógica abaixo cobre ambos pois lProcess é true para ambos.
            aForms[nPosValores][FORM_PLSAUDE]        := aPlan01
            aForms[nPosValores][FORM_PLSAUDE02]      := aPlan02
            aForms[nPosValores][FORM_REBMED]         := aPlan03
            aForms[nPosValores][FORM_REBMED02]       := aPlan04
            aForms[nPosValores][FORM_REBMED03]       := aPlan05
            aForms[nPosValores][FORM_REBMED04]       := aPlan06

            aForms[nPosValores][FORM_CONSOLID]       := TAFLid( aFils, cCodRec,  cCPF, cPeriodo, "TRIBUT", '1', @aForms[nPosValores][FORM_CONSOLID] )
            aForms[nPosValores][FORM_CONSOLID]       := TAFLid( aFils, cCodRec,  cCPF, cPeriodo, "TRIBUT", '2', @aForms[nPosValores][FORM_CONSOLID] )
            aForms[nPosValores][FORM_CONSOLID]       := TAFLid( aFils, cCodRec,  cCPF, cPeriodo, "TRIBUT", '3', @aForms[nPosValores][FORM_CONSOLID] )

        EndIf

        If cOrigem $ "1|2|3" .And. cCodRec == Alltrim(( cAliasQry )->T8R_CODREC ) 

            // Determina se deve processar baseando-se na origem e nas flags de controle
            lProcess := .F.

            If cOrigem == "1" .And. aForms[nPosValores][FORM_TAFPROCESS]
                lProcess := .T.
            ElseIf cOrigem == "2" .And. aForms[nPosValores][FORM_FOLHAPROCESS]
                lProcess := .T.
            ElseIf cOrigem == "3" .And. aForms[nPosValores][FORM_GOVPROCESS]
                lProcess := .T.
            EndIf

            If lProcess

                aForms[nPosValores][FORM_PERIODO]       := cPeriodo
                aForms[nPosValores][FORM_NOME]          := ( cAliasQry )->T8R_NOME
                aForms[nPosValores][FORM_CPF]           := cCPF
            
                // Carrega Grids Específicas
                aForms[nPosValores][FORM_DEPDEDUCTION]   := TAFGridRec( aFils, cCodRec, cCPF, cPeriodo, "DEDDEP", cOrigem, @aForms[nPosValores][FORM_DEPDEDUCTION]   )
                aForms[nPosValores][FORM_ALIMONY]        := TAFGridRec( aFils, cCodRec, cCPF, cPeriodo, "PENALI", cOrigem, @aForms[nPosValores][FORM_ALIMONY]        )
                aForms[nPosValores][FORM_PRIVAPENSION]   := TAFGridRec( aFils, cCodRec, cCPF, cPeriodo, "PREVCL", cOrigem, @aForms[nPosValores][FORM_PRIVAPENSION]   )
                aForms[nPosValores][FORM_LEGALPROCESS]   := TAFGridRec( aFils, cCodRec, cCPF, cPeriodo, "PROCRE", cOrigem, @aForms[nPosValores][FORM_LEGALPROCESS]   )
                aForms[nPosValores][FORM_LEGALPROCESSA1] := TAFGridRec( aFils, cCodRec, cCPF, cPeriodo, "PRCVAL", cOrigem, @aForms[nPosValores][FORM_LEGALPROCESSA1] )
                aForms[nPosValores][FORM_LEGALPROCESSA2] := TAFGridRec( aFils, cCodRec, cCPF, cPeriodo, "PRCDED", cOrigem, @aForms[nPosValores][FORM_LEGALPROCESSA2] )
                aForms[nPosValores][FORM_LEGALPROCESSA3] := TAFGridRec( aFils, cCodRec, cCPF, cPeriodo, "PRCBEN", cOrigem, @aForms[nPosValores][FORM_LEGALPROCESSA3] )

                // Atualiza flags de controle para não reprocessar a mesma origem
                If cOrigem == "1"
                    aForms[nPosValores][FORM_TAFPROCESS] := .F.
                ElseIf cOrigem == "2"
                    aForms[nPosValores][FORM_FOLHAPROCESS] := .F.
                Else
                    aForms[nPosValores][FORM_GOVPROCESS] := .F.
                EndIf

            EndIf

        EndIf

        (cAliasQry)->(DbSkip())

    EndDo

Return 

//---------------------------------------------------------------------
/*/{Protheus.doc} TafIniForm
@type           Static Function
@description    Inicializa o array do formulário de empregados.
@author         Alexandre de Lima Santos.
@since          28/10/2025
@param          aForms (Ref Array)      - Array de formulários.
@param          nPosValores (Num)       - Posição a inicializar.
/*/
//---------------------------------------------------------------------
Static Function TafIniForm( aForms as Array, nPosValores as Numeric )

    Local nI as Numeric

    Default aForms      := {}
    Default nPosValores := 0

    // Campos Texto
    For nI := 1 to 3
        aForms[nPosValores][nI] := ""
    Next nI

    aForms[nPosValores][5] := ""

    // Campos Array
    aForms[nPosValores][4] := {}

    For nI := 6 to 19
        aForms[nPosValores][nI] := {}
    Next nI

    // Flags de Controle
    aForms[nPosValores][20] := .T.
    aForms[nPosValores][21] := .T.
    aForms[nPosValores][22] := .T.

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFCodes
@type           Function
@description    Busca lista distinta de Códigos de Receita para um CPF.
@author         Alexandre de Lima Santos
@since          03/12/2025
@param          cCpf (Char)      - CPF.
@param          cPeriodo (Char)  - Período.
@param          aFils (Array)    - Filiais.
@return         aCode (Array)    - Lista de códigos únicos.
/*/
//---------------------------------------------------------------------
Static Function TAFCodes( cCpf as Character, cPeriodo as Character, aFils as Array )

    Local aCode     as Array
    Local aCodRec   as Array
    Local cQuery    as Character
    Local cAliasQry as Character
    Local cCodRec   as Character            
    Local nX        as Numeric
    Local nPos      as Numeric
    Local oStmt     as Object

    Default cPeriodo    := ""
    Default cCpf        := ""
    
    aCode     := {}
    aCodRec   := {}
    cAliasQry := GetNextAlias()
    nPos      := 0
    
    cQuery := " SELECT T8R_CODREC FROM " + RetSqlName( "T8R" ) + " T8R "
    cQuery += " WHERE T8R_FILIAL IN (?) " 
    cQuery += " AND T8R_PERAPU = ? "
    cQuery += " AND T8R_CPF = ? "
    cQuery += " AND T8R_ORIGEM = '1'"
    cQuery += " AND T8R_CODREC <> ''"
    cQuery += " AND T8R.D_E_L_E_T_ = ''"
    cQuery += " GROUP BY T8R_CODREC"

    oStmt := FWExecStatement():New( ChangeQuery(cQuery) )
    oStmt:setIn( 1, aFils )
    oStmt:SetString( 2, cPeriodo )
    oStmt:SetString( 3, cCpf )
    
    cAliasQry := oStmt:OpenAlias()
    TafConOut(ProcName() + " " + oStmt:getFixQuery())
    oStmt:executeQuery( cAliasQry )
    
    ( cAliasQry )->( DbGoTop() )

    While !(cAliasQry)->(EoF())

        If "|" $ ( cAliasQry )->T8R_CODREC 

            aCodRec := StrTokArr( Alltrim(( cAliasQry )->T8R_CODREC), "|" )

            if !Empty( aCodRec )

                For nX := 1 to Len( aCodRec )

                    nPos := aScan(aCode, {|x| AllTrim(x)== Alltrim( aCodRec[nX] ) })

                    If nPos == 0
                        AADD( aCode, Alltrim( aCodRec[nX] ) )   
                    EndIf   

                Next nX

            EndIf

        Else

            cCodRec := Alltrim(( cAliasQry )->T8R_CODREC )
            nPos := aScan(aCode, {|x| AllTrim(x) == Alltrim( cCodRec ) })

            If nPos == 0
                AADD( aCode, Alltrim( cCodRec ) ) 
            EndIf
			
        EndIf
        
        (cAliasQry)->(DbSkip())

    EndDo

    (cAliasQry)->(DbCloseArea())

Return aCode

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFGridRec
@type           Function
@description    Busca dados detalhados (Deduções, Pensão, Processos) para preencher as grids.
@author         Alexandre de Lima Santos
@since          03/12/2025
@param          aFils (Array)       - Filiais.
@param          cCodRec (Char)      - Código Receita.
@param          cCpf (Char)         - CPF.
@param          cPeriodo (Char)     - Período.
@param          cAba (Char)         - Identificador da Aba (ex: DEDDEP, PENALI).
@param          cOrigem (Char)      - Origem (1=TAF, 3=Gov).
@param          aInfos (Ref Array)  - Array de informações acumulado.
@return         aInfos (Array)      - Array atualizado.
/*/
//---------------------------------------------------------------------
Static Function TAFGridRec( aFils as Array, cCodRec as Character, cCpf as Character, cPeriodo as Character,;
                            cAba as Character, cOrigem as Character, aInfos as Array )

    Local cAliasQry as Character 
    Local cFil      as Character
    Local cQuery    as Character
    Local cRelaco   as Character
    Local nFolha1   as Numeric
    Local nFolha2   as Numeric
    Local nFolha3   as Numeric
    Local nFolha4   as Numeric
    Local nFolha5   as Numeric
    Local nGov1     as Numeric
    Local nGov2     as Numeric
    Local nGov3     as Numeric
    Local nGov4     as Numeric
    Local nGov5     as Numeric
    Local nPos      as Numeric
    Local nTaf1     as Numeric
    Local nTaf2     as Numeric
    Local nTaf3     as Numeric
    Local nTaf4     as Numeric
    Local nTaf5     as Numeric
    Local oStmt     as Object

    Default aInfos   := {}
    Default aFils    := {}
    Default cCodRec  := ""
    Default cPeriodo := ""
    Default cCpf     := ""
    Default cAba     := ""
    Default cOrigem  := ""
    
    cFil    := ""
    cRelaco := ""
    
    // Inicialização de variáveis numéricas em lote
    nFolha1:=0; nFolha2:=0; nFolha3:=0; nFolha4:=0; nFolha5:=0
    nGov1:=0; nGov2:=0; nGov3:=0; nGov4:=0; nGov5:=0
    nTaf1:=0; nTaf2:=0; nTaf3:=0; nTaf4:=0; nTaf5:=0

    cAliasQry := GetNextAlias()
    If Select(cAliasQry) > 0; (cAliasQry)->( dbCloseArea() ); EndIf
    
    // Seleção de Query baseada na Aba
    If cAba == "DEDDEP"
        cQuery := " SELECT T8R_TPREND, T8R_CPFDEP, T8R_VLRDED, T8R_RELACO, T8R_FILIAL FROM " + RetSqlName( "T8R" ) + "  T8R "
    ElseIf cAba == "PENALI"
        cQuery := " SELECT T8R_TPRPAL, T8R_CPFDPA, T8R_VLRPAL,T8R_RELACO, T8R_FILIAL FROM " + RetSqlName( "T8R" ) + "  T8R "
    ElseIf cAba == "PREVCL"
        cQuery := " SELECT T8R_TPPREV, T8R_CNPJPC, T8R_VLDEPC, T8R_VLPC13, T8R_VLPCSP, T8R_PCVP13, T8R_RELACO FROM " + RetSqlName( "T8R" ) + "  T8R "
    ElseIf cAba == "PROCRE"
        cQuery := " SELECT T8R_TPPROC, T8R_NRPROC, T8R_CODSUP, T8R_RELACO FROM " + RetSqlName( "T8R" ) + "  T8R "
    ElseIf cAba == "PRCVAL"
        cQuery := " SELECT T8R_INDAPU, T8R_VLRRTC, T8R_DEPJUD, T8R_CANOCA, T8R_CANOAN, T8R_RENDSU, T8R_RELACO FROM " + RetSqlName( "T8R" ) + "  T8R "
    ElseIf cAba == "PRCDED"
        cQuery := " SELECT T8R_INDDED, T8R_DEDSUS, T8R_CNPJEC, T8R_VLCONT, T8R_RELACO FROM " + RetSqlName( "T8R" ) + "  T8R "
    ElseIf cAba == "PRCBEN"
        cQuery := " SELECT T8R_CPFSUS, T8R_DEPSUS, T8R_RELACO FROM " + RetSqlName( "T8R" ) + "  T8R "
    EndIf

    cQuery += " WHERE T8R_FILIAL IN (?) "
    cQuery += " AND T8R_CODREC = ? "
    cQuery += " AND T8R_PERAPU = ? "
    cQuery += " AND T8R_CPF = ? "
    cQuery += " AND T8R_ORIGEM = ? "
    cQuery += " AND T8R_FORABA = ? "
    cQuery += " AND T8R.D_E_L_E_T_ = ''"

    oStmt := FWExecStatement():New( ChangeQuery(cQuery) )
    oStmt:setIn( 1, aFils )
    oStmt:SetString( 2, cCodRec ) 
    oStmt:SetString( 3, cPeriodo )
    oStmt:SetString( 4, cCpf )
    oStmt:SetString( 5, cOrigem )
    oStmt:SetString( 6, cAba )
    
    cAliasQry := oStmt:OpenAlias()
    TafConOut(ProcName() + " " + oStmt:getFixQuery())
    oStmt:executeQuery( cAliasQry )
    
    ( cAliasQry )->( DbGoTop() )

    While !(cAliasQry)->(EoF())

        // Bloco DEDDEP: Dedução de Dependentes
        If cAba == "DEDDEP"
            
            If cOrigem == '1'
                cRelaco := (cAliasQry)->T8R_RELACO
                cFil    := (cAliasQry)->T8R_FILIAL
                nTaf1   := (cAliasQry)->T8R_VLRDED
            ElseIf cOrigem == '2'
                nFolha1 := (cAliasQry)->T8R_VLRDED
            ElseIf cOrigem == '3'
                nGov1   := (cAliasQry)->T8R_VLRDED
            EndIf

            nPos := aScan(aInfos, {|x| AllTrim(x[1]) == Alltrim((cAliasQry)->T8R_TPREND ) .AND. AllTrim(x[2]) == Alltrim( (cAliasQry)->T8R_CPFDEP ) })

            If nPos > 0
                If cOrigem == '1'
                    aInfos[nPos][3] := nTaf1
                    aInfos[nPos][6] := cRelaco
                    aInfos[nPos][7] := cFil
                ElseIf  cOrigem == '2'
                    aInfos[nPos][5] := nFolha1
                ElseIf  cOrigem == '3'
                    aInfos[nPos][4] := nGov1
                EndIf
            Else
                AADD( aInfos, { (cAliasQry)->T8R_TPREND, (cAliasQry)->T8R_CPFDEP, nTaf1, nGov1, nFolha1, cRelaco, cFil  } )
            EndIf
        
        // Bloco PENALI: Pensão Alimentícia
        ElseIf cAba == "PENALI"

            If cOrigem == '1'
                cRelaco := (cAliasQry)->T8R_RELACO
                cFil    := (cAliasQry)->T8R_FILIAL
                nTaf1   := (cAliasQry)->T8R_VLRPAL
            ElseIf cOrigem == '2'
                nFolha1 := (cAliasQry)->T8R_VLRPAL
            ElseIf cOrigem == '3'
                nGov1   := (cAliasQry)->T8R_VLRPAL
            EndIf

            nPos := aScan(aInfos, {|x| AllTrim(x[1]) == Alltrim( (cAliasQry)->T8R_TPRPAL ) .AND. AllTrim(x[2]) == Alltrim( (cAliasQry)->T8R_CPFDPA ) })

            If nPos > 0

                If cOrigem == '1'

                    aInfos[nPos][3] := nTaf1
                    aInfos[nPos][6] := cRelaco
                    aInfos[nPos][7] := cFil

                ElseIf cOrigem == '2'

                    aInfos[nPos][5] := nFolha1

                ElseIf  cOrigem == '3'

                    aInfos[nPos][4] := nGov1

                EndIf

            Else

                AADD( aInfos, { (cAliasQry)->T8R_TPRPAL, (cAliasQry)->T8R_CPFDPA, nTaf1, nGov1, nFolha1, cRelaco, cFil } )

            EndIf

        // Bloco PREVCL: Previdência Complementar
        ElseIf cAba == "PREVCL"

            If cOrigem == '1'

                cRelaco := (cAliasQry)->T8R_RELACO
                nTaf1   := (cAliasQry)->T8R_VLDEPC
                nTaf2   := (cAliasQry)->T8R_VLPC13
                nTaf3   := (cAliasQry)->T8R_VLPCSP
                nTaf4   := (cAliasQry)->T8R_PCVP13
            
            ElseIf cOrigem == '2'

                nFolha1 := (cAliasQry)->T8R_VLDEPC
                nFolha2 := (cAliasQry)->T8R_VLPC13
                nFolha3 := (cAliasQry)->T8R_VLPCSP
                nFolha4 := (cAliasQry)->T8R_PCVP13

            ElseIf cOrigem == '3'

                nGov1   := (cAliasQry)->T8R_VLDEPC
                nGov2   := (cAliasQry)->T8R_VLPC13
                nGov3   := (cAliasQry)->T8R_VLPCSP
                nGov4   := (cAliasQry)->T8R_PCVP13

            EndIf

            nPos := aScan(aInfos, {|x| AllTrim(x[1]) == Alltrim( (cAliasQry)->T8R_TPPREV ) .AND. AllTrim(x[2]) == Alltrim( (cAliasQry)->T8R_CNPJPC ) })

            If nPos > 0

                If cOrigem == '1'

                    aInfos[nPos][3] := nTaf1 
                    aInfos[nPos][4] := nTaf2 
                    aInfos[nPos][5] := nTaf3 
                    aInfos[nPos][6] := nTaf4
                    aInfos[nPos][15] := cRelaco
                
                ElseIf cOrigem == '2' 

                    aInfos[nPos][11] := nFolha1 
                    aInfos[nPos][12] := nFolha2
                    aInfos[nPos][13] := nFolha3 
                    aInfos[nPos][14] := nFolha4

                ElseIf cOrigem == '3' 

                    aInfos[nPos][7]  := nGov1 
                    aInfos[nPos][8]  := nGov2 
                    aInfos[nPos][9]  := nGov3 
                    aInfos[nPos][10] := nGov4

                EndIf

            Else

                AADD( aInfos, { (cAliasQry)->T8R_TPPREV, (cAliasQry)->T8R_CNPJPC, nTaf1, nTaf2, nTaf3, nTaf4, nGov1, nGov2, nGov3, nGov4, nFolha1, nFolha2, nFolha3, nFolha4, cRelaco } )
            
			EndIf

        // Bloco PROCRE: Processos
        ElseIf cAba == "PROCRE"

            If cOrigem == '1'; cRelaco := (cAliasQry)->T8R_RELACO; EndIf

            nPos := aScan(aInfos, {|x| AllTrim(x[1]) == Alltrim( (cAliasQry)->T8R_TPPROC ) .AND. AllTrim(x[2]) == Alltrim( (cAliasQry)->T8R_NRPROC    ) .AND. AllTrim(x[3]) == Alltrim( (cAliasQry)->T8R_CODSUP    ) })
            
            If nPos > 0
                If cOrigem == '1'; aInfos[nPos][4] := cRelaco; EndIf
            Else 
                AADD( aInfos, { Alltrim((cAliasQry)->T8R_TPPROC), Alltrim((cAliasQry)->T8R_NRPROC), Alltrim((cAliasQry)->T8R_CODSUP), cRelaco } )
            EndIf

        // Bloco PRCVAL: Valores do Processo
        ElseIf cAba == "PRCVAL"

            If cOrigem == '1'

                cRelaco := (cAliasQry)->T8R_RELACO
                nTaf1 := (cAliasQry)->T8R_VLRRTC
                nTaf2 := (cAliasQry)->T8R_DEPJUD
                nTaf3 := (cAliasQry)->T8R_CANOCA
                nTaf4 := (cAliasQry)->T8R_CANOAN
                nTaf5 := (cAliasQry)->T8R_RENDSU

            ElseIf cOrigem == '2'

                nFolha1 := (cAliasQry)->T8R_VLRRTC
                nFolha2 := (cAliasQry)->T8R_DEPJUD
                nFolha3 := (cAliasQry)->T8R_CANOCA
                nFolha4 := (cAliasQry)->T8R_CANOAN
                nFolha5 := (cAliasQry)->T8R_RENDSU

            ElseIf cOrigem == '3'

                nGov1 := (cAliasQry)->T8R_VLRRTC
                nGov2 := (cAliasQry)->T8R_DEPJUD
                nGov3 := (cAliasQry)->T8R_CANOCA
                nGov4 := (cAliasQry)->T8R_CANOAN
                nGov5 := (cAliasQry)->T8R_RENDSU

            EndIf

            nPos := aScan( aInfos, {|x| AllTrim(x[1]) == Alltrim( (cAliasQry)->T8R_INDAPU ) })

            If nPos > 0

                If cOrigem == '1'

                    aInfos[nPos][2] := nTaf1 
                    aInfos[nPos][3] := nTaf2 
                    aInfos[nPos][4] := nTaf3 
                    aInfos[nPos][5] := nTaf4 
                    aInfos[nPos][6] := nTaf5
                    aInfos[nPos][17] := cRelaco

                ElseIf cOrigem == '2'

                    aInfos[nPos][12] := nFolha1 
                    aInfos[nPos][13] := nFolha2 
                    aInfos[nPos][14] := nFolha3 
                    aInfos[nPos][15] := nFolha4
                    aInfos[nPos][16] := nFolha5 

                ElseIf cOrigem == '3'

                    aInfos[nPos][7]  := nGov1 
                    aInfos[nPos][8]  := nGov2 
                    aInfos[nPos][9]  := nGov3 
                    aInfos[nPos][10] := nGov4
                    aInfos[nPos][11] := nGov5 

                EndIf

            Else

                AADD( aInfos, { (cAliasQry)->T8R_INDAPU, nTaf1, nTaf2, nTaf3, nTaf4, nTaf5, nGov1, nGov2, nGov3, nGov4, nGov5, nFolha1, nFolha2, nFolha3, nFolha4, nFolha5, cRelaco  } )
            
			EndIf

        // Bloco PRCDED: Deduções do Processo
        ElseIf cAba == "PRCDED"

            If cOrigem == '1'

                cRelaco := (cAliasQry)->T8R_RELACO
                nTaf1   := (cAliasQry)->T8R_DEDSUS
                nTaf2   := (cAliasQry)->T8R_VLCONT
            
            ElseIf cOrigem == '2'

                nFolha1   := (cAliasQry)->T8R_DEDSUS
                nFolha2   := (cAliasQry)->T8R_VLCONT

            ElseIf cOrigem == '3'

                nGov1   := (cAliasQry)->T8R_DEDSUS
                nGov2   := (cAliasQry)->T8R_VLCONT

            EndIf

            nPos := aScan( aInfos, {|x| AllTrim(x[1]) == Alltrim( (cAliasQry)->T8R_INDDED ) .AND. AllTrim(x[2]) == Alltrim( (cAliasQry)->T8R_CNPJEC ) })

            If nPos > 0

                If cOrigem == '1'

                    aInfos[nPos][3] := nTaf1 
                    aInfos[nPos][4] := nTaf2 
                    aInfos[nPos][9] := cRelaco
                
                ElseIf cOrigem == '2' 

                    aInfos[nPos][7] := nFolha1 
                    aInfos[nPos][8] := nFolha2

                ElseIf cOrigem == '3' 

                    aInfos[nPos][5] := nGov1 
                    aInfos[nPos][6] := nGov2 

                EndIf

            Else

                AADD( aInfos, { Alltrim((cAliasQry)->T8R_INDDED), Alltrim((cAliasQry)->T8R_CNPJEC), nTaf1, nTaf2, nGov1, nGov2, nFolha1, nFolha2, cRelaco } )
            
			EndIf

        // Bloco PRCBEN: Beneficiários do Processo
        ElseIf cAba == "PRCBEN"

            If cOrigem == '1'

                nTaf1   := (cAliasQry)->T8R_DEPSUS
                cRelaco := (cAliasQry)->T8R_RELACO

            ElseIf cOrigem == '2' 

                nFolha1 := (cAliasQry)->T8R_DEPSUS

            ElseIf cOrigem == '3' 

                nGov1   := (cAliasQry)->T8R_DEPSUS

            EndIf

            nPos := aScan( aInfos, {|x| AllTrim(x[1]) == Alltrim( (cAliasQry)->T8R_CPFSUS )})

            If nPos > 0

                If cOrigem == '1'

                    aInfos[nPos][2] := nTaf1
                    aInfos[nPos][5] := cRelaco

                ElseIf  cOrigem == '2'

                    aInfos[nPos][4] := nFolha1

                ElseIf  cOrigem == '3'

                    aInfos[nPos][3] := nGov1

                EndIf

            Else

                AADD( aInfos, { (cAliasQry)->T8R_CPFSUS,  nTaf1, nGov1, nFolha1, cRelaco } )
            
			EndIf

        EndIf

        (cAliasQry)->(DbSkip())

    EndDo

    (cAliasQry)->(DbCloseArea())

Return aInfos

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFLid
@type           Function
@description    Consolida as informações tributárias (Aba TRIBUT) comparando TAF, Governo e Folha.
@author         Alexandre de Lima Santos
@since          03/12/2025
/*/
//---------------------------------------------------------------------  
Static Function TAFLid( aFils as Array, cCodRec as Character, cCpf as Character, cPeriodo as Character,;
                        cAba as Character, cOrigem as Character, aInfos as Array )

    Local aCodRec   as Array
    Local cAliasQry as Character
    Local cQuery    as Character
    Local nFolha1   as Numeric
    Local nFolha2   as Numeric
    Local nFolha3   as Numeric
    Local nFolha4   as Numeric
    Local nFolha5   as Numeric
    Local nFolha6   as Numeric
    Local nFolha7   as Numeric
    Local nFolha8   as Numeric
    Local nFolha9   as Numeric
    Local nFolha10  as Numeric
    Local nFolha11  as Numeric
    Local nFolha12  as Numeric
    Local nFolha13  as Numeric
    Local nFolha14  as Numeric
    Local nFolha15  as Numeric
    Local nFolha16  as Numeric
    Local nFolha17  as Numeric
    Local nFolha18  as Numeric
    Local nFolha19  as Numeric
    Local nGov1     as Numeric
    Local nGov2     as Numeric
    Local nGov3     as Numeric
    Local nGov4     as Numeric
    Local nGov5     as Numeric
    Local nGov6     as Numeric
    Local nGov7     as Numeric
    Local nGov8     as Numeric
    Local nGov9     as Numeric
    Local nGov10    as Numeric
    Local nGov11    as Numeric
    Local nGov12    as Numeric
    Local nGov13    as Numeric
    Local nGov14    as Numeric
    Local nGov15    as Numeric
    Local nGov16    as Numeric
    Local nGov17    as Numeric
    Local nGov18    as Numeric
    Local nGov19    as Numeric
    Local nPos      as Numeric
    Local nTaf1     as Numeric
    Local nTaf2     as Numeric
    Local nTaf3     as Numeric
    Local nTaf4     as Numeric
    Local nTaf5     as Numeric
    Local nTaf6     as Numeric
    Local nTaf7     as Numeric
    Local nTaf8     as Numeric
    Local nTaf9     as Numeric
    Local nTaf10    as Numeric
    Local nTaf11    as Numeric
    Local nTaf12    as Numeric
    Local nTaf13    as Numeric
    Local nTaf14    as Numeric
    Local nTaf15    as Numeric
    Local nTaf16    as Numeric
    Local nTaf17    as Numeric
    Local nTaf18    as Numeric
    Local nTaf19    as Numeric
    Local nX        as Numeric
    Local oStmt     as Object

    Default aInfos   := {}
    Default aFils    := {}
    Default cCodRec  := ""
    Default cPeriodo := ""
    Default cCpf     := ""
    Default cAba     := ""
    Default cOrigem  := ""
    
    nTaf1:=0; nTaf2:=0; nTaf3:=0; nTaf4:=0; nTaf5:=0; nTaf6:=0; nTaf7:=0; nTaf8:=0; nTaf9:=0; nTaf10:=0
    nTaf11:=0; nTaf12:=0; nTaf13:=0; nTaf14:=0; nTaf15:=0; nTaf16:=0; nTaf17:=0; nTaf18:=0; nTaf19:=0
    nGov1:=0; nGov2:=0; nGov3:=0; nGov4:=0; nGov5:=0; nGov6:=0; nGov7:=0; nGov8:=0; nGov9:=0; nGov10:=0
    nGov11:=0; nGov12:=0; nGov13:=0; nGov14:=0; nGov15:=0; nGov16:=0; nGov17:=0; nGov18:=0; nGov19:=0
    nFolha1:=0; nFolha2:=0; nFolha3:=0; nFolha4:=0; nFolha5:=0; nFolha6:=0; nFolha7:=0; nFolha8:=0; nFolha9:=0; nFolha10:=0
    nFolha11:=0; nFolha12:=0; nFolha13:=0; nFolha14:=0; nFolha15:=0; nFolha16:=0; nFolha17:=0; nFolha18:=0; nFolha19:=0

    cAliasQry := GetNextAlias()
    If Select(cAliasQry) > 0; (cAliasQry)->( dbCloseArea() ); EndIf
    
    cQuery := " SELECT T8R_CPF, T8R_CODREC, SUM( T8R_VLRTRI ) AS VLRTRI, SUM( T8R_VRTR13 ) AS VRTR13, SUM( T8R_VLRPRE ) AS VLRPRE, SUM( T8R_VPRE13 ) AS VPRE13, SUM( T8R_VLIRRF ) AS VLIRRF, SUM( T8R_IRRF13 ) AS IRRF13, "
    cQuery += " SUM( T8R_VLRISE ) AS VLRISE, SUM( T8R_VLRI13 ) VLRI13, SUM( T8R_VLRDIA ) AS VLRDIA, SUM( T8R_VLRAJU ) AS VLRAJU, SUM( T8R_VLRRSC ) AS VLRRSC, SUM( T8R_VLRABN ) AS VLRABN, SUM( T8R_VLRMLG ) AS VLRMLG, " 
    cQuery += " SUM( T8R_VMLG13 ) AS VMLG13, SUM( T8R_VLRAXM ) AS VLRAXM, SUM( T8R_VLBMED ) AS VLBMED, SUM( T8R_BMED13 ) AS BMED13, SUM( T8R_VLRMOR ) AS VLRMOR, SUM( T8R_VLRISO ) AS VLRISO FROM " + RetSqlName( "T8R" ) + " T8R "
    cQuery += " WHERE T8R_FILIAL IN (?) " 
    cQuery += " AND T8R_PERAPU = ? "
    cQuery += " AND T8R_CODREC LIKE ? "
    cQuery += " AND T8R_CPF = ? "
    cQuery += " AND T8R_ORIGEM = ? "
    cQuery += " AND T8R_FORABA = 'TRIBUT' "
    cQuery += " AND T8R.D_E_L_E_T_ = ''"
    cQuery += " GROUP BY T8R_CPF, T8R_CODREC "

    oStmt := FWExecStatement():New( ChangeQuery(cQuery) )
    oStmt:setIn( 1, aFils )
    oStmt:SetString( 2, cPeriodo )
    oStmt:SetString( 3, "%" + cCodRec + "%" ) 
    oStmt:SetString( 4, cCpf )
    oStmt:SetString( 5, cOrigem )
    
    cAliasQry := oStmt:OpenAlias()
    oStmt:executeQuery( cAliasQry )
    
    ( cAliasQry )->( DbGoTop() )

    While !(cAliasQry)->(EoF())
        
        If cOrigem == '1'

            aCodRec := StrTokArr( ( cAliasQry )->T8R_CODREC, "|" )

            If Empty( aCodRec ); AADD( aCodRec, { cCodRec } ); EndIf

            For nX := 1 to Len( aCodRec )

                If cCodRec == Alltrim( aCodRec[nX] )

                    nPos := aScan( aInfos, {|x| AllTrim(x[1]) == Alltrim( cCodRec ) .AND. AllTrim(x[2]) == Alltrim( cCpf ) })

                    If nPos > 0

                        aInfos[nPos][3]  += (cAliasQry)->VLRTRI  
                        aInfos[nPos][4]  += (cAliasQry)->VRTR13
                        aInfos[nPos][5]  += (cAliasQry)->VLRPRE
                        aInfos[nPos][6]  += (cAliasQry)->VPRE13
                        aInfos[nPos][7]  += (cAliasQry)->VLIRRF
                        aInfos[nPos][8]  += (cAliasQry)->IRRF13
                        aInfos[nPos][9]  += (cAliasQry)->VLRISE
                        aInfos[nPos][10] += (cAliasQry)->VLRI13
                        aInfos[nPos][11] += (cAliasQry)->VLRDIA
                        aInfos[nPos][12] += (cAliasQry)->VLRAJU
                        aInfos[nPos][13] += (cAliasQry)->VLRRSC
                        aInfos[nPos][14] += (cAliasQry)->VLRABN
                        aInfos[nPos][15] += (cAliasQry)->VLRMLG
                        aInfos[nPos][16] += (cAliasQry)->VMLG13
                        aInfos[nPos][17] += (cAliasQry)->VLRAXM
                        aInfos[nPos][18] += (cAliasQry)->VLBMED
                        aInfos[nPos][19] += (cAliasQry)->BMED13
                        aInfos[nPos][20] += (cAliasQry)->VLRMOR
                        aInfos[nPos][21] += (cAliasQry)->VLRISO 

                    Else

                        nTaf1  := (cAliasQry)->VLRTRI;   nTaf2  := (cAliasQry)->VRTR13;  nTaf3  := (cAliasQry)->VLRPRE;  nTaf4  := (cAliasQry)->VPRE13
                        nTaf5  := (cAliasQry)->VLIRRF;   nTaf6  := (cAliasQry)->IRRF13;  nTaf7  := (cAliasQry)->VLRISE;  nTaf8  := (cAliasQry)->VLRI13
                        nTaf9  := (cAliasQry)->VLRDIA;   nTaf10 := (cAliasQry)->VLRAJU;  nTaf11 := (cAliasQry)->VLRRSC;  nTaf12 := (cAliasQry)->VLRABN
                        nTaf13 := (cAliasQry)->VLRMLG;   nTaf14 := (cAliasQry)->VMLG13;  nTaf15 := (cAliasQry)->VLRAXM;  nTaf16 := (cAliasQry)->VLBMED
                        nTaf17 := (cAliasQry)->BMED13;   nTaf18 := (cAliasQry)->VLRMOR;  nTaf19 := (cAliasQry)->VLRISO   

                        AADD( aInfos, { cCodRec, cCpf, nTaf1, nTaf2, nTaf3, nTaf4, nTaf5, nTaf6, nTaf7, nTaf8, nTaf9, nTaf10,;
                                        nTaf11, nTaf12, nTaf13, nTaf14, nTaf15, nTaf16, nTaf17, nTaf18, nTaf19,;
                                        nGov1, nGov2, nGov3, nGov4, nGov5, nGov6, nGov7, nGov8, nGov9, nGov10,;
                                        nGov11, nGov12, nGov13, nGov14, nGov15, nGov16, nGov17, nGov18, nGov19,; 
                                        nFolha1, nFolha2, nFolha3, nFolha4, nFolha5, nFolha6, nFolha7, nFolha8, nFolha9, nFolha10,;
                                        nFolha11, nFolha12, nFolha13, nFolha14, nFolha15, nFolha16, nFolha17, nFolha18, nFolha19 } )

                    EndIf

                    Exit

                EndIf

            Next nX

        EndIf

        If cOrigem == '2'

            nPos := aScan( aInfos, {|x| AllTrim(x[1]) == Alltrim( cCodRec ) .AND. AllTrim(x[2]) == Alltrim( cCpf ) })

            If nPos > 0

                aInfos[nPos][41] += (cAliasQry)->VLRTRI;   aInfos[nPos][42] += (cAliasQry)->VRTR13;  aInfos[nPos][43] += (cAliasQry)->VLRPRE;  aInfos[nPos][44] += (cAliasQry)->VPRE13
                aInfos[nPos][45] += (cAliasQry)->VLIRRF;   aInfos[nPos][46] += (cAliasQry)->IRRF13;  aInfos[nPos][47] += (cAliasQry)->VLRISE;  aInfos[nPos][48] += (cAliasQry)->VLRI13
                aInfos[nPos][49] += (cAliasQry)->VLRDIA;   aInfos[nPos][50] += (cAliasQry)->VLRAJU;  aInfos[nPos][51] += (cAliasQry)->VLRRSC;  aInfos[nPos][52] += (cAliasQry)->VLRABN
                aInfos[nPos][53] += (cAliasQry)->VLRMLG;   aInfos[nPos][54] += (cAliasQry)->VMLG13;  aInfos[nPos][55] += (cAliasQry)->VLRAXM;  aInfos[nPos][56] += (cAliasQry)->VLBMED
                aInfos[nPos][57] += (cAliasQry)->BMED13;   aInfos[nPos][58] += (cAliasQry)->VLRMOR;  aInfos[nPos][59] += (cAliasQry)->VLRISO 

            Else

                nFolha1  := (cAliasQry)->VLRTRI;   nFolha2  := (cAliasQry)->VRTR13;  nFolha3  := (cAliasQry)->VLRPRE;  nFolha4  := (cAliasQry)->VPRE13
                nFolha5  := (cAliasQry)->VLIRRF;   nFolha6  := (cAliasQry)->IRRF13;  nFolha7  := (cAliasQry)->VLRISE;  nFolha8  := (cAliasQry)->VLRI13
                nFolha9  := (cAliasQry)->VLRDIA;   nFolha10 := (cAliasQry)->VLRAJU;  nFolha11 := (cAliasQry)->VLRRSC;  nFolha12 := (cAliasQry)->VLRABN
                nFolha13 := (cAliasQry)->VLRMLG;   nFolha14 := (cAliasQry)->VMLG13;  nFolha15 := (cAliasQry)->VLRAXM;  nFolha16  := (cAliasQry)->VLBMED
                nFolha17 := (cAliasQry)->BMED13;   nFolha18 := (cAliasQry)->VLRMOR;  nFolha19 := (cAliasQry)->VLRISO   

                AADD( aInfos, { cCodRec, cCpf, nTaf1, nTaf2, nTaf3, nTaf4, nTaf5, nTaf6, nTaf7, nTaf8, nTaf9, nTaf10,;
                                nTaf11, nTaf12, nTaf13, nTaf14, nTaf15, nTaf16, nTaf17, nTaf18, nTaf19,;
                                nGov1, nGov2, nGov3, nGov4, nGov5, nGov6, nGov7, nGov8, nGov9, nGov10,;
                                nGov11, nGov12, nGov13, nGov14, nGov15, nGov16, nGov17, nGov18, nGov19,; 
                                nFolha1, nFolha2, nFolha3, nFolha4, nFolha5, nFolha6, nFolha7, nFolha8, nFolha9, nFolha10,;
                                nFolha11, nFolha12, nFolha13, nFolha14, nFolha15, nFolha16, nFolha17, nFolha18, nFolha19 } )

            EndIf

        EndIf

        If cOrigem == '3'

            nPos := aScan( aInfos, {|x| AllTrim(x[1]) == Alltrim( cCodRec ) .AND. AllTrim(x[2]) == Alltrim( cCpf ) })

            If nPos > 0

                aInfos[nPos][22] += (cAliasQry)->VLRTRI;   aInfos[nPos][23] += (cAliasQry)->VRTR13;  aInfos[nPos][24] += (cAliasQry)->VLRPRE;  aInfos[nPos][25] += (cAliasQry)->VPRE13
                aInfos[nPos][26] += (cAliasQry)->VLIRRF;   aInfos[nPos][27] += (cAliasQry)->IRRF13;  aInfos[nPos][28] += (cAliasQry)->VLRISE;  aInfos[nPos][29] += (cAliasQry)->VLRI13
                aInfos[nPos][30] += (cAliasQry)->VLRDIA;   aInfos[nPos][31] += (cAliasQry)->VLRAJU;  aInfos[nPos][32] += (cAliasQry)->VLRRSC;  aInfos[nPos][33] += (cAliasQry)->VLRABN
                aInfos[nPos][34] += (cAliasQry)->VLRMLG;   aInfos[nPos][35] += (cAliasQry)->VMLG13;  aInfos[nPos][36] += (cAliasQry)->VLRAXM;  aInfos[nPos][37] += (cAliasQry)->VLBMED
                aInfos[nPos][38] += (cAliasQry)->BMED13;   aInfos[nPos][39] += (cAliasQry)->VLRMOR;  aInfos[nPos][40] += (cAliasQry)->VLRISO 

            Else

                nGov1  := (cAliasQry)->VLRTRI;   nGov2  := (cAliasQry)->VRTR13;  nGov3  := (cAliasQry)->VLRPRE;  nGov4  := (cAliasQry)->VPRE13
                nGov5  := (cAliasQry)->VLIRRF;   nGov6  := (cAliasQry)->IRRF13;  nGov7  := (cAliasQry)->VLRISE;  nGov8  := (cAliasQry)->VLRI13
                nGov9  := (cAliasQry)->VLRDIA;   nGov10 := (cAliasQry)->VLRAJU;  nGov11 := (cAliasQry)->VLRRSC;  nGov12 := (cAliasQry)->VLRABN
                nGov13 := (cAliasQry)->VLRMLG;   nGov14 := (cAliasQry)->VMLG13;  nGov15 := (cAliasQry)->VLRAXM;  nGov16 := (cAliasQry)->VLBMED
                nGov17 := (cAliasQry)->BMED13;   nGov18 := (cAliasQry)->VLRMOR;  nGov19 := (cAliasQry)->VLRISO   

                AADD( aInfos, { cCodRec, cCpf, nTaf1, nTaf2, nTaf3, nTaf4, nTaf5, nTaf6, nTaf7, nTaf8, nTaf9, nTaf10,;
                                nTaf11, nTaf12, nTaf13, nTaf14, nTaf15, nTaf16, nTaf17, nTaf18, nTaf19,;
                                nGov1, nGov2, nGov3, nGov4, nGov5, nGov6, nGov7, nGov8, nGov9, nGov10,;
                                nGov11, nGov12, nGov13, nGov14, nGov15, nGov16, nGov17, nGov18, nGov19,; 
                                nFolha1, nFolha2, nFolha3, nFolha4, nFolha5, nFolha6, nFolha7, nFolha8, nFolha9, nFolha10,;
                                nFolha11, nFolha12, nFolha13, nFolha14, nFolha15, nFolha16, nFolha17, nFolha18, nFolha19 } )

            EndIf

        EndIf

        (cAliasQry)->(DbSkip())

    EndDo

    (cAliasQry)->(DbCloseArea())

Return aInfos

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFNoRec
@type           Function
@description    Busca informações complementares (não grid) como planos de saúde e reembolsos.
@author         Alexandre de Lima Santos
@since          03/12/2025
/*/ 
//--------------------------------------------------------------------- 
Static Function TAFNoRec( aFils as Array, cCpf as Character, cPeriodo as Character, cAba as Character, cOrigem  as Character, aInfos   as Array )

    Local cAliasQry as Character
    Local cQuery    as Character
    Local cRelaco   as Character
    Local nFolha1   as Numeric
    Local nFolha2   as Numeric
    Local nGov1     as Numeric
    Local nGov2     as Numeric
    Local nPos      as Numeric
    Local nTaf1     as Numeric
    Local nTaf2     as Numeric
    Local oStmt     as Object

    Default aFils    := {}
    Default aInfos   := {}
    Default cPeriodo := ""
    Default cCpf     := ""
    Default cAba     := ""
    Default cOrigem  := ""
    
    cRelaco := ""
	nFolha1 := 0
	nFolha2 := 0
	nGov1   := 0
	nGov2   := 0
    nTaf1   := 0
	nTaf2   := 0

    cAliasQry := GetNextAlias()
    
    If cAba == "PLASAU"
        cQuery := " SELECT T8R_CNPJOP, T8R_REGANS, T8R_VLRPLS, T8R_CPF, T8R_RELACO FROM " + RetSqlName( "T8R" ) + " T8R "
    ElseIf cAba == "DEPSAU"
        cQuery := " SELECT T8R_CPFDPS, T8R_VLRDPS, T8R_RELACO FROM " + RetSqlName( "T8R" ) + " T8R "
    ElseIf cAba == "REMMED"
        cQuery := " SELECT T8R_ORIREE, T8R_CNPJPS, T8R_ANSRRE, T8R_RELACO FROM " + RetSqlName( "T8R" ) + " T8R "
    ElseIf cAba == "REMTID"
        cQuery := " SELECT T8R_INSCRE, T8R_NRPSRE, T8R_VLREEM, T8R_VLRANT, T8R_RELACO FROM " + RetSqlName( "T8R" ) + " T8R "
    ElseIf cAba == "REMDEP"
        cQuery := " SELECT T8R_CPFRED, T8R_RELACO FROM " + RetSqlName( "T8R" ) + " T8R "
    ElseIf cAba == "DETDEP"
        cQuery := " SELECT T8R_DINSCR, T8R_DNRPSR, T8R_DVLRRE, T8R_DVLRAN, T8R_RELACO FROM " + RetSqlName( "T8R" ) + " T8R "
    EndIf

    cQuery += " WHERE T8R_FILIAL IN (?) "
    cQuery += " AND T8R_PERAPU = ? "
    cQuery += " AND T8R_CPF = ? "
    cQuery += " AND T8R_ORIGEM = ? "
    cQuery += " AND T8R_FORABA = ? "
    cQuery += " AND T8R.D_E_L_E_T_ = ''"
    cQuery += " ORDER BY T8R_ORIGEM "

    oStmt := FWExecStatement():New( ChangeQuery(cQuery) )
    oStmt:setIn( 1, aFils )
    oStmt:SetString( 2, cPeriodo )
    oStmt:SetString( 3, cCpf )
    oStmt:SetString( 4, cOrigem )
    oStmt:SetString( 5, cAba )
    
    cAliasQry := oStmt:OpenAlias()
    oStmt:executeQuery( cAliasQry )
    
    ( cAliasQry )->( DbGoTop() )

    While !(cAliasQry)->(EoF())

        If cAba == "PLASAU"

            If cOrigem == '1'
                cRelaco := (cAliasQry)->T8R_RELACO
                nTaf1   := (cAliasQry)->T8R_VLRPLS
            ElseIf cOrigem == '2'
                nFolha1 := (cAliasQry)->T8R_VLRPLS
            ElseIf cOrigem == '3'
                nGov1   := (cAliasQry)->T8R_VLRPLS
            EndIf

            nPos := aScan( aInfos, {|x| AllTrim(x[2]) == Alltrim( (cAliasQry)->T8R_CNPJOP ) })

            If nPos > 0

                If cOrigem == '1'
                    aInfos[nPos][4] := nTaf1
                    aInfos[nPos][7] := cRelaco
                ElseIf cOrigem == '2'
                    aInfos[nPos][6] := nFolha1 
                ElseIf cOrigem == '3'
                    aInfos[nPos][5] := nGov1 
                EndIf

            Else
                AADD( aInfos, { (cAliasQry)->T8R_CPF, (cAliasQry)->T8R_CNPJOP, (cAliasQry)->T8R_REGANS, nTaf1, nGov1,  nFolha1, cRelaco } )
            EndIf
        
        ElseIf cAba == "DEPSAU"
        
            If cOrigem == '1'
                cRelaco := (cAliasQry)->T8R_RELACO
                nTaf1   := (cAliasQry)->T8R_VLRDPS
            ElseIf cOrigem == '2'
                nFolha1 := (cAliasQry)->T8R_VLRDPS
            ElseIf cOrigem == '3'
                nGov1   := (cAliasQry)->T8R_VLRDPS
            EndIf

            nPos := aScan( aInfos, {|x| AllTrim(x[1]) == Alltrim( (cAliasQry)->T8R_CPFDPS ) })

            If nPos > 0
                If cOrigem == '1'
                    aInfos[nPos][5] := cRelaco
                    aInfos[nPos][2] := nTaf1 
                ElseIf cOrigem == '2'
                    aInfos[nPos][4] := nFolha1 
                ElseIf cOrigem == '3'
                    aInfos[nPos][3] := nGov1 
                EndIf
            Else
                AADD( aInfos, { (cAliasQry)->T8R_CPFDPS, nTaf1, nGov1,  nFolha1, cRelaco } )
            EndIf
        
        ElseIf cAba == "REMMED"

            If cOrigem == '1'
                cRelaco := (cAliasQry)->T8R_RELACO
                AADD( aInfos, { (cAliasQry)->T8R_ORIREE, (cAliasQry)->T8R_CNPJPS, (cAliasQry)->T8R_ANSRRE, cRelaco } )
            EndIf
        
        ElseIf cAba == "REMTID"

            If cOrigem == '1'
                cRelaco := (cAliasQry)->T8R_RELACO
                nTaf1   := (cAliasQry)->T8R_VLREEM
                nTaf2   := (cAliasQry)->T8R_VLRANT
            ElseIf cOrigem == '2'
                nFolha1 := (cAliasQry)->T8R_VLREEM
                nFolha2 := (cAliasQry)->T8R_VLRANT
            ElseIf cOrigem == '3'
                nGov1   := (cAliasQry)->T8R_VLREEM
                nGov2   := (cAliasQry)->T8R_VLRANT
            EndIf

            nPos := aScan( aInfos, {|x| AllTrim(x[1]) + AllTrim(x[2]) == Alltrim( (cAliasQry)->T8R_INSCRE ) + Alltrim( (cAliasQry)->T8R_NRPSRE ) })

            If nPos > 0

                If cOrigem == '1'
                    aInfos[nPos][9] := cRelaco
                    aInfos[nPos][3] := nTaf1
                    aInfos[nPos][4] := nTaf2 
                ElseIf cOrigem == '2'
                    aInfos[nPos][7] := nFolha1
                    aInfos[nPos][8] := nFolha2 
                ElseIf cOrigem == '3'
                    aInfos[nPos][5] := nGov1
                    aInfos[nPos][6] := nGov2 
                EndIf

            Else
                AADD( aInfos, { (cAliasQry)->T8R_INSCRE, (cAliasQry)->T8R_NRPSRE, nTaf1, nTaf2, nGov1, nGov2, nFolha1, nFolha2, cRelaco } )
            EndIf

        ElseIf cAba == "REMDEP"

            If cOrigem == '1'
                cRelaco := (cAliasQry)->T8R_RELACO
                AADD( aInfos, { (cAliasQry)->T8R_CPFRED, cRelaco } )
            EndIf 

        ElseIf cAba == "DETDEP"

            If cOrigem == '1'
                cRelaco := (cAliasQry)->T8R_RELACO
                nTaf1   := (cAliasQry)->T8R_DVLRRE
                nTaf2   := (cAliasQry)->T8R_DVLRAN
            ElseIf cOrigem == '2'
                nFolha1   := (cAliasQry)->T8R_DVLRRE
                nFolha2   := (cAliasQry)->T8R_DVLRAN
            ElseIf cOrigem == '3'
                nGov1   := (cAliasQry)->T8R_DVLRRE
                nGov2   := (cAliasQry)->T8R_DVLRAN
            EndIf

            nPos := aScan( aInfos, {|x| AllTrim(x[1]) + AllTrim(x[2]) == Alltrim( (cAliasQry)->T8R_DINSCR ) + Alltrim( (cAliasQry)->T8R_DNRPSR ) })

            If nPos > 0
			
                If cOrigem == '1'
                    aInfos[nPos][9] := cRelaco
                    aInfos[nPos][3] := nTaf1
                    aInfos[nPos][4] := nTaf2 
                ElseIf cOrigem == '2'
                    aInfos[nPos][7] := nFolha1
                    aInfos[nPos][8] := nFolha2 
                ElseIf cOrigem == '3'
                    aInfos[nPos][5] := nGov1
                    aInfos[nPos][6] := nGov2 
                EndIf
            Else
                AADD( aInfos, { (cAliasQry)->T8R_DINSCR, (cAliasQry)->T8R_DNRPSR, nTaf1, nTaf2, nGov1, nGov2, nFolha1, nFolha2, cRelaco } )
            EndIf

        EndIf

        (cAliasQry)->(DbSkip())

    EndDo

    (cAliasQry)->(DbCloseArea())
        
Return

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFJsonTot
@type           Function
@description    Gera o JSON Nível 1 (Totalizador Geral).
@author         Alexandre de Lima Santos
@since          03/12/2025
/*/
//---------------------------------------------------------------------
Static Function TAFJsonTot( aInfo as Array, cTicket as character, lIsLegacy as logical )

    Local cLevel    as Character
    Local nRet      as Numeric 
    Local nTaf      as Numeric
    Local nFolha    as Numeric 
    Local nX        as Numeric
    Local oEvenue   as Object
    Local oInfos    as Object
    Local oItem     as Object
    Local oResponse as Object

    Default aInfo     := {} 
    Default cTicket   := ""
    Default lIsLegacy := .F.
    
    cLevel := "1"
    nTaf   := 0 
    nRet   := 0
    nFolha := 0

    // Soma totais
    For nX := 1 to Len( aInfo )
        nTaf   += aInfo[nX][6]
        nRet   += aInfo[nX][25]
        nFolha += aInfo[nX][44]
    next nX

    oResponse := JsonObject():New()
    oResponse["totalIRRFCompany"] := JsonObject():New()
    oResponse["totalIRRFCompany"]["items"] := {}

    oItem := JsonObject():New()
    oItem["totalIRRFCompany"] := JsonObject():New()
    oItem["totalIRRFCompany"]["totalIrrfTaf"] := nTaf
    oItem["totalIRRFCompany"]["totalIrrfErp"] := nFolha
    oItem["totalIRRFCompany"]["totalIrrfRet"] := nRet

    aAdd(oResponse["totalIRRFCompany"]["items"], oItem)

    // Estrutura de Revenue Codes no Nível 1
    oResponse["revenueCodes"] := JsonObject():New()
    oResponse["revenueCodes"]["items"] := {}

    oEvenue := JsonObject():New()
    oEvenue["evenue"] := {} 
    aAdd(oResponse["revenueCodes"]["items"], oEvenue )
    
    For nX := 1 to Len( aInfo )

        oInfos := JsonObject():New()
        oInfos["revenueCode"] := aInfo[nX][1]

        oInfos["totalIrrf"] := JsonObject():New()
        oInfos["totalIrrf"]["tafValue"]  := aInfo[nX][6] + aInfo[nX][7]
        oInfos["totalIrrf"]["retValue"]  := aInfo[nX][25] + aInfo[nX][26]
        oInfos["totalIrrf"]["erpValue"]  := aInfo[nX][44] + aInfo[nX][45]

        If lIsLegacy
            oInfos["totalIrrf"]["divergent"] := aInfo[nX][6] + aInfo[nX][7] != aInfo[nX][25] + aInfo[nX][26] .OR. aInfo[nX][25] + aInfo[nX][26] != aInfo[nX][44] + aInfo[nX][45] .OR. aInfo[nX][6] + aInfo[nX][7] != aInfo[nX][44] + aInfo[nX][45]
        Else  
            oInfos["totalIrrf"]["divergent"] := aInfo[nX][6] + aInfo[nX][7] != aInfo[nX][25] + aInfo[nX][26]                                                
        EndIf

        AddJsonBlock(oInfos, "taxableIncome",         aInfo[nX][2],  aInfo[nX][21], aInfo[nX][40], lIsLegacy )
        AddJsonBlock(oInfos, "taxableIncome13",       aInfo[nX][3],  aInfo[nX][22], aInfo[nX][41], lIsLegacy )
        AddJsonBlock(oInfos, "officialPension",       aInfo[nX][4],  aInfo[nX][23], aInfo[nX][42], lIsLegacy )
        AddJsonBlock(oInfos, "officialPension13",     aInfo[nX][5],  aInfo[nX][24], aInfo[nX][43], lIsLegacy )
        AddJsonBlock(oInfos, "withheldIncomeTax",     aInfo[nX][6],  aInfo[nX][25], aInfo[nX][44], lIsLegacy )
        AddJsonBlock(oInfos, "withheldIncomeTax13",   aInfo[nX][7],  aInfo[nX][26], aInfo[nX][45], lIsLegacy )
        AddJsonBlock(oInfos, "exemptPortionOver65",   aInfo[nX][8],  aInfo[nX][27], aInfo[nX][46], lIsLegacy )
        AddJsonBlock(oInfos, "exemptPortionOver6513", aInfo[nX][9],  aInfo[nX][28], aInfo[nX][47], lIsLegacy )
        AddJsonBlock(oInfos, "dailyAllowances",       aInfo[nX][10], aInfo[nX][29], aInfo[nX][48], lIsLegacy )
        AddJsonBlock(oInfos, "costAid",               aInfo[nX][11], aInfo[nX][30], aInfo[nX][49], lIsLegacy )
        AddJsonBlock(oInfos, "terminationIndemnity",  aInfo[nX][12], aInfo[nX][31], aInfo[nX][50], lIsLegacy )
        AddJsonBlock(oInfos, "vacationBonus",         aInfo[nX][13], aInfo[nX][32], aInfo[nX][51], lIsLegacy )
        AddJsonBlock(oInfos, "seriousIllness",        aInfo[nX][14], aInfo[nX][33], aInfo[nX][52], lIsLegacy )
        AddJsonBlock(oInfos, "seriousIllness13",      aInfo[nX][15], aInfo[nX][34], aInfo[nX][53], lIsLegacy )
        AddJsonBlock(oInfos, "housingAllowance",      aInfo[nX][16], aInfo[nX][35], aInfo[nX][54], lIsLegacy )
        AddJsonBlock(oInfos, "doctorScholarship",     aInfo[nX][17], aInfo[nX][36], aInfo[nX][55], lIsLegacy )
        AddJsonBlock(oInfos, "doctorScholarship13",   aInfo[nX][18], aInfo[nX][37], aInfo[nX][56], lIsLegacy )
        AddJsonBlock(oInfos, "interestOnLatePayment", aInfo[nX][19], aInfo[nX][38], aInfo[nX][57], lIsLegacy )
        AddJsonBlock(oInfos, "taxExempt",             aInfo[nX][20], aInfo[nX][39], aInfo[nX][58], lIsLegacy )

        oInfos["divergent"] := oInfos["totalIrrf"]["divergent"]

        aAdd(oEvenue["evenue"], oInfos)

    Next nX

    GrvItRes( cTicket, oResponse:ToJson() , cLevel )
    
Return 


//---------------------------------------------------------------------
/*/{Protheus.doc} AddJsonBlock
@type           Function
@description    Função auxiliar local para DRY no JSON Builder
@author         Rodrigo Nicolino
@since          14/12/2025
/*/
//---------------------------------------------------------------------
Static Function AddJsonBlock(oJson, cKey, nTaf, nRet, nFolha, lIsLegacy )

    oJson[cKey] := JsonObject():New()
    oJson[cKey]["tafValue"]  := nTaf
    oJson[cKey]["retValue"]  := nRet
    oJson[cKey]["erpValue"]  := nFolha
    oJson[cKey]["divergent"] := IIf( lIsLegacy, nTaf != nRet .OR. nRet != nFolha .OR. nTaf != nFolha, nTaf != nRet )

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFJsonMod1
@type           Function
@description    Gera o JSON Nível 2 (Lista de Códigos de Receita).
@author         Alexandre de Lima Santos
@since          03/12/2025
/*/
//---------------------------------------------------------------------
Static Function TAFJsonMod1( aInfo as Array, cTicket as character, lIsLegacy as logical )

    Local aCodRec   as Array
    Local aJson     as Array
    Local cCodRec   as Character
    Local cLevel    as Character
    Local nX        as Numeric
    Local nY        as Numeric
    Local oItems    as Object
    Local oResponse as Object

    Default aInfo     := {} 
    Default cTicket   := ""
    Default lIsLegacy := .F.
    
    aCodRec := { '056107', '056108', '056109', '056110', '056111', '056112', '056113', '058806', '061001', '353301', '356201', '188901' }
    cLevel  := "2"

    For nX := 1 to Len( aCodRec )

        oResponse := JsonObject():New()
        aJson     := {}
        cCodRec   := aCodRec[nX]

        For nY := 1 to Len( aInfo )

            If cCodRec == aInfo[nY][1]

                oItems := JsonObject():New()
                oItems["name"]      := aInfo[nY][2]
                oItems["cpf"]       := aInfo[nY][3]

                If lIsLegacy
                    oItems["divergent"] := aInfo[nY][4] != aInfo[nY][5] .OR. aInfo[nY][4] != aInfo[nY][6] .OR. aInfo[nY][5] != aInfo[nY][6]
                Else
                    oItems["divergent"] := aInfo[nY][4] != aInfo[nY][5] 
                EndIf

                oItems["totalIr"]   := JsonObject():New() 
                oItems["totalIr"]["totalIrTaf"] := aInfo[nY][4]
                oItems["totalIr"]["totalIrRet"] := aInfo[nY][5] 
                oItems["totalIr"]["totalIrErp"] := aInfo[nY][6] 
                aAdd( aJson, oItems )

            EndIf

        next nY

        If !Empty( aJson )

            oResponse["items"] := aJson
            GrvItRes( cTicket, oResponse:ToJson() , cLevel, cCodRec )

        EndIf

    next nX
    
Return

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFJsonMod2
@type           Function
@description    Gera o JSON Nível 3 (Detalhes do Empregado).
@author         Alexandre de Lima Santos
@since          09/12/2025
/*/
//---------------------------------------------------------------------
Static Function TAFJsonMod2( aInfo as Array, cTicket as character, lIsLegacy as logical )

    Local aAlimony          as Array
    Local aChave            as Array
    Local aChave2           as Array
    Local aDepDeduc         as Array
    Local aDepDetail        as Array
    Local aDepReimb         as Array
    Local aDeps             as Array
    Local aHolderDetail     as Array
    Local aHolders          as Array
    Local aInfoBenefPen     as Array
    Local aInfoDedSusp      as Array
    Local aInfoValores      as Array
    Local aLegalProcessInfo as Array
    Local aPrivatePension   as Array
    Local aReimbursements   as Array
    Local aTemp             as Array
    Local aTemp1            as Array
    Local aTemp2            as Array
    Local aTemp3            as Array
    Local cLevel            as Character
    Local nX                as Numeric
    Local nY                as Numeric
    Local nY1               as Numeric
    Local nY2               as Numeric
    Local nY3               as Numeric
    Local oBenefPen         as Object
    Local oDep              as Object
    Local oDepDet           as Object
    Local oDepR             as Object
    Local oHolder           as Object
    Local oHolderDet        as Object
    Local oInfoDedSusp      as Object
    Local oInfoValores      as Object
    Local oItems            as Object
    Local oMonthlySummary   as Object
    Local oPrivPens         as Object
    Local oProc             as Object
    Local oReimbursement    as Object
    Local oResponse         as Object

    Default aInfo     := {} 
    Default cTicket   := ""
    Default lIsLegacy := .F.

    cLevel := "3"

    For nX := 1  to Len( aInfo )
        
        oResponse := JsonObject():New()
        oItems    := JsonObject():New()
        
        oItems["period"]       := aInfo[nX][1]
        oItems["name"]         := aInfo[nX][2]
        oItems["cpf"]          := aInfo[nX][3]
        oItems["divergent"]    := .T.
        oItems["revenueCodes"] := aClone(aInfo[nX][4]) 

        oItems["infoComplemNoContract"] := JsonObject():New()
        oItems["infoComplemNoContract"]["healthPlan"]           := JsonObject():New()
        oItems["infoComplemNoContract"]["medicalReimbursement"] := JsonObject():New()

        oItems["infoComplem"] := JsonObject():New()
        oItems["infoComplem"]["revenueCode"] := aInfo[nX][5]
        
        // 1. Dependent Deductions
        aTemp := aClone(aInfo[nX][6])
        aDepDeduc := {}

        For nY := 1 to len( aTemp )
            aAdd(aDepDeduc, BuildObjVal(Alltrim(aTemp[nY][1]), aTemp[nY][2], aTemp[nY][7], aTemp[nY][3], aTemp[nY][4], aTemp[nY][5], lIsLegacy ))
        Next nY

        oItems["infoComplem"]["dependentDeductions"] := aDepDeduc

        // 2. Alimony
        aTemp := aClone(aInfo[nX][7])
        aAlimony := {}

        For nY := 1 to len( aTemp )
            aAdd(aAlimony, BuildObjVal(Alltrim(aTemp[nY][1]), aTemp[nY][2], aTemp[nY][7], aTemp[nY][3], aTemp[nY][4], aTemp[nY][5], lIsLegacy ))
        Next nY 

        oItems["infoComplem"]["alimony"] := aAlimony

        // 3. Private Pension
        aTemp := aClone(aInfo[nX][8])
        aPrivatePension := {}

        For nY := 1 to len( aTemp )

            oPrivPens := JsonObject():New() 
            oPrivPens["pensionType"] := Alltrim(aTemp[nY][1])
            oPrivPens["cnpj"]        := Alltrim(aTemp[nY][2])
            AddJsonBlock(oPrivPens, "values", aTemp[nY][3], aTemp[nY][7], aTemp[nY][11], lIsLegacy )
            AddJsonBlock(oPrivPens, "values13", aTemp[nY][4], aTemp[nY][8], aTemp[nY][12], lIsLegacy )
            AddJsonBlock(oPrivPens, "publicServantValue", aTemp[nY][5], aTemp[nY][9], aTemp[nY][13], lIsLegacy )
            AddJsonBlock(oPrivPens, "publicServantValue13", aTemp[nY][6], aTemp[nY][10], aTemp[nY][14], lIsLegacy )
            aAdd(aPrivatePension, oPrivPens)

        Next nY

        oItems["infoComplem"]["privatePension"] := aPrivatePension

        // 4. Legal Process
        aLegalProcessInfo := {}
        aTemp := aClone(aInfo[nX][9])

        For nY := 1 to len( aTemp )

            oProc := JsonObject():New() 
            oProc["processType"]    := Alltrim( aTemp[nY][1] )
            oProc["processNumber"]  := Alltrim( aTemp[nY][2] )
            oProc["suspensionCode"] := Alltrim( aTemp[nY][3] )
            
            aInfoValores := {}
            aTemp1 := aClone(aInfo[nX][10])

            For nY1 := 1 to len( aTemp1 )

                If aTemp1[nY1][17] == aTemp[nY][4]

                    oInfoValores := JsonObject():New()
                    oInfoValores["taxPeriodIndicator"] := Alltrim(aTemp1[nY1][1])
                    AddJsonBlock(oInfoValores, "withholdingValue", aTemp1[nY1][2], aTemp1[nY1][7],aTemp1[nY1][12], lIsLegacy )
                    AddJsonBlock(oInfoValores, "judicialDepositValue", aTemp1[nY1][3], aTemp1[nY1][8], aTemp1[nY1][13], lIsLegacy )
                    AddJsonBlock(oInfoValores, "calendarYearCompensationValue", aTemp1[nY1][4], aTemp1[nY1][9], aTemp1[nY1][14], lIsLegacy )
                    AddJsonBlock(oInfoValores, "previousYearsCompensationValue", aTemp1[nY1][5], aTemp1[nY1][10], aTemp1[nY1][15], lIsLegacy )
                    AddJsonBlock(oInfoValores, "suspendedIncomeValue", aTemp1[nY1][6], aTemp1[nY1][11], aTemp1[nY1][16], lIsLegacy )
                    
                    aInfoDedSusp := {} 
                    aTemp2 := aClone(aInfo[nX][11])

                    For nY2 := 1 to len( aTemp2 )

                        aChave := StrTokArr( aTemp2[nY2][9], "|" )

                        If Len( aChave ) > 1 .And. Alltrim( aTemp1[nY1][17] ) == Alltrim( aChave[1] + "|" + aChave[2] + "|" + aChave[3] + "|" + aChave[4] + "|" + aChave[6] )
                           
						    oInfoDedSusp := JsonObject():New()
                            oInfoDedSusp["deductionIndicative"] := Alltrim( aTemp2[nY2][1] )
                            oInfoDedSusp["cnpj"]                := Alltrim( aTemp2[nY2][2] )
                            AddJsonBlock(oInfoDedSusp, "deductionValue", aTemp2[nY2][3], aTemp2[nY2][5], aTemp2[nY2][7], lIsLegacy )
                            AddJsonBlock(oInfoDedSusp, "contribFunpresp", aTemp2[nY2][4], aTemp2[nY2][6], aTemp2[nY2][8], lIsLegacy )
                            
                            aInfoBenefPen := {}
                            aTemp3 := aClone(aInfo[nX][12])

                            For nY3 := 1 to len( aTemp3 )

                                aChave := StrTokArr( aTemp3[nY3][5], "|" ) 

                                If Len( aChave ) > 1 .And. Alltrim( aTemp2[nY2][9] ) == Alltrim(aChave[1] + "|" + aChave[2] + "|" + aChave[3] + "|" + aChave[4] + "|" + aChave[5] + "|" + aChave[7])
                                    
									oBenefPen := JsonObject():New()
                                    oBenefPen["cpf"] := Alltrim( aTemp3[nY3][1] )
                                    AddJsonBlock(oBenefPen, "vlrDepenSusp", aTemp3[nY3][2], aTemp3[nY3][3], aTemp3[nY3][4], lIsLegacy )
                                    aAdd(aInfoBenefPen, oBenefPen)

                                EndIf

                            Next nY3

                            oInfoDedSusp["infoBenefPen"] := aInfoBenefPen
                            aAdd(aInfoDedSusp, oInfoDedSusp)

                        EndIf

                    Next nY2

                    oInfoValores["infoDedSusp"] := aInfoDedSusp
                    aAdd(aInfoValores, oInfoValores)

                EndIf

            Next nY1

            oProc["infoValores"] := aInfoValores
            aAdd(aLegalProcessInfo, oProc)

        Next nY

        oItems["infoComplem"]["legalProcessInfo"] := aLegalProcessInfo

        // 5. Health Plan (No Contract)
        aHolders := {}
        aTemp := aClone(aInfo[nX][13])

        For nY := 1 to Len( aTemp )

            oHolder := JsonObject():New() 
            oHolder["cpf"]     := Alltrim( aTemp[nY][1] )
            oHolder["cnpj"]    := Alltrim( aTemp[nY][2] )
            oHolder["ansCode"] := Alltrim( aTemp[nY][3] )
            AddJsonBlock(oHolder, "values", aTemp[nY][4], aTemp[nY][5], aTemp[nY][6], lIsLegacy )
            
            aDeps := {}
            aTemp1 := aClone(aInfo[nX][14])

            For nY1 := 1 to Len( aTemp1 )

                aChave  := StrTokArr( aTemp1[nY1][5], "|" )
                aChave2 := StrTokArr( aTemp[nY][7], "|" )

                If Len( aChave ) > 2 .AND. Len( aChave2 ) > 1 .And. Alltrim( aChave2[2] ) == Alltrim( aChave[3] )

                    oDep := JsonObject():New() 
                    oDep["cpf"] := Alltrim( aTemp1[nY1][1] )
                    AddJsonBlock(oDep, "values", aTemp1[nY1][2], aTemp1[nY1][3], aTemp1[nY1][4], lIsLegacy )
                    aAdd(aDeps, oDep)

                EndIf

            Next nY1  

            oHolder["dependents"] := aDeps
            aAdd(aHolders, oHolder)

        Next nY

        oItems["infoComplemNoContract"]["healthPlan"]["holders"] := aHolders

        // 6. Reimbursements
        aReimbursements := {}
        aTemp := aClone(aInfo[nX][15])

        For nY := 1 to Len( aTemp )

            oReimbursement := JsonObject():New() 
            oReimbursement["originOfRefund"]     := Alltrim( aTemp[nY][1] )
            oReimbursement["registrationNumber"] := Alltrim( aTemp[nY][2] )
            oReimbursement["ansCode"]            := Alltrim( aTemp[nY][3] )

            aHolderDetail := {}
            aTemp1 := aClone(aInfo[nX][16])

            For nY1 := 1 to Len(aTemp1)

                aChave  := StrTokArr( aTemp1[nY1][9], "|" )
                aChave2 := StrTokArr( aTemp[nY][4], "|" )

                If Len( aChave ) > 1 .AND. Len( aChave2 ) > 1 .And. Alltrim( aChave2[1] + aChave2[2] ) == Alltrim( aChave[3] + aChave[4])

                    oHolderDet := JsonObject():New() 
                    oHolderDet["registrationType"]   := Alltrim( aTemp1[nY1][1] )
                    oHolderDet["registrationNumber"] := Alltrim( aTemp1[nY1][2] )
                    AddJsonBlock(oHolderDet, "values", aTemp1[nY1][3], aTemp1[nY1][5], aTemp1[nY1][7], lIsLegacy )
                    AddJsonBlock(oHolderDet, "previousValues", aTemp1[nY1][4], aTemp1[nY1][6], aTemp1[nY1][8], lIsLegacy )
                    aAdd(aHolderDetail, oHolderDet)

                EndIf

            Next nY1

            oReimbursement["holderDetail"] := aHolderDetail

            aDepReimb := {}
            aTemp2 := aClone(aInfo[nX][17])

            For nY2 := 1 to Len(aTemp2)

                aChave  := StrTokArr( aTemp2[nY2][2], "|" )
                aChave2 := StrTokArr( aTemp[nY][4], "|" )

                If Len( aChave ) > 1 .AND. Len( aChave2 ) > 1 .And. Alltrim( aChave2[1] + aChave2[2] ) == Alltrim( aChave[2] + aChave[3] )

                    oDepR := JsonObject():New() 
                    oDepR["cpf"] := aTemp2[nY2][1]
                    aDepDetail := {}
                    aTemp3 := aClone(aInfo[nX][18])

                    For nY3 := 1 to Len(aTemp3)

                        aChave  := StrTokArr( aTemp3[nY3][9], "|" )

                        If Alltrim( aTemp2[nY2][2] ) == Alltrim( aChave[1] + "|" + aChave[4] + "|" + aChave[5] )

                            oDepDet := JsonObject():New() 
                            oDepDet["registrationType"]   := Alltrim(aTemp3[nY3][1])
                            oDepDet["registrationNumber"] := Alltrim(aTemp3[nY3][2])
                            AddJsonBlock(oDepDet, "values", aTemp3[nY3][3], aTemp3[nY3][5], aTemp3[nY3][7])
                            AddJsonBlock(oDepDet, "previousValues", aTemp3[nY3][4], aTemp3[nY3][6], aTemp3[nY3][8])
                            aAdd(aDepDetail, oDepDet)

                        EndIf

                    Next nY3

                    oDepR["dependentDetail"] := aDepDetail
                    aAdd(aDepReimb, oDepR)

                EndIf

            Next nY2

            oReimbursement["reimbursementDependent"] := aDepReimb
            aAdd(aReimbursements, oReimbursement)

        Next nY

        oItems["infoComplemNoContract"]["medicalReimbursement"]["reimbursements"] := aReimbursements

        // 7. Monthly Summary
        aTemp := aClone(aInfo[nX][19])

        For nY := 1 to Len(aTemp)

            oMonthlySummary := JsonObject():New() 
            AddJsonBlock(oMonthlySummary, "taxableIncome",         aTemp[nY][3],  aTemp[nY][22], aTemp[nY][41], lIsLegacy )
            AddJsonBlock(oMonthlySummary, "taxableIncome13",       aTemp[nY][4],  aTemp[nY][23], aTemp[nY][42], lIsLegacy )
            AddJsonBlock(oMonthlySummary, "officialPension",       aTemp[nY][5],  aTemp[nY][24], aTemp[nY][43], lIsLegacy )
            AddJsonBlock(oMonthlySummary, "officialPension13",     aTemp[nY][6],  aTemp[nY][25], aTemp[nY][44], lIsLegacy )
            AddJsonBlock(oMonthlySummary, "withheldIncomeTax",     aTemp[nY][7],  aTemp[nY][26], aTemp[nY][45], lIsLegacy )
            AddJsonBlock(oMonthlySummary, "withheldIncomeTax13",   aTemp[nY][8],  aTemp[nY][27], aTemp[nY][46], lIsLegacy )
            AddJsonBlock(oMonthlySummary, "exemptPortionOver65",   aTemp[nY][9],  aTemp[nY][28], aTemp[nY][47], lIsLegacy )
            AddJsonBlock(oMonthlySummary, "exemptPortionOver6513", aTemp[nY][10], aTemp[nY][29], aTemp[nY][48], lIsLegacy )
            AddJsonBlock(oMonthlySummary, "dailyAllowances",       aTemp[nY][11], aTemp[nY][30], aTemp[nY][49], lIsLegacy )
            AddJsonBlock(oMonthlySummary, "costAid",               aTemp[nY][12], aTemp[nY][31], aTemp[nY][50], lIsLegacy )
            AddJsonBlock(oMonthlySummary, "terminationIndemnity",  aTemp[nY][13], aTemp[nY][32], aTemp[nY][51], lIsLegacy )
            AddJsonBlock(oMonthlySummary, "vacationBonus",         aTemp[nY][14], aTemp[nY][33], aTemp[nY][52], lIsLegacy )
            AddJsonBlock(oMonthlySummary, "seriousIllness",        aTemp[nY][15], aTemp[nY][34], aTemp[nY][53], lIsLegacy )
            AddJsonBlock(oMonthlySummary, "seriousIllness13",      aTemp[nY][16], aTemp[nY][35], aTemp[nY][54], lIsLegacy )
            AddJsonBlock(oMonthlySummary, "housingAllowance",      aTemp[nY][17], aTemp[nY][36], aTemp[nY][55], lIsLegacy )
            AddJsonBlock(oMonthlySummary, "doctorScholarship",     aTemp[nY][18], aTemp[nY][37], aTemp[nY][56], lIsLegacy )
            AddJsonBlock(oMonthlySummary, "doctorScholarship13",   aTemp[nY][19], aTemp[nY][38], aTemp[nY][57], lIsLegacy )
            AddJsonBlock(oMonthlySummary, "interestOnLatePayment", aTemp[nY][20], aTemp[nY][39], aTemp[nY][58], lIsLegacy )
            AddJsonBlock(oMonthlySummary, "taxExempt",             aTemp[nY][21], aTemp[nY][40], aTemp[nY][59], lIsLegacy )
            
            oItems["infoComplemNoContract"]["monthlySummary"] := oMonthlySummary

        Next

        // Grava JSON por empregado
        GrvItRes( cTicket, oItems:ToJson() , cLevel, aInfo[nX][5], aInfo[nX][3] )

    Next nX

Return 

//---------------------------------------------------------------------
/*/{Protheus.doc} BuildObjVal
@type           function
@description    Helper para construir objetos repetitivos em TAFJsonMod2
@author         Rodrigo Nicolino
@since          14/12/2025
/*/
//---------------------------------------------------------------------
Static Function BuildObjVal(cIncType, cCpf, cRelaco, nTaf, nRet, nFolha, lIsLegacy )

    Local oObj := JsonObject():New()

    oObj["incomeType"] := cIncType
    oObj["name"]       := Alltrim( TAFFindName( cCpf, cRelaco ) )
    oObj["cpf"]        := cCpf

    AddJsonBlock(oObj, "values", nTaf, nRet, nFolha, lIsLegacy )

Return oObj

//---------------------------------------------------------------------
/*/{Protheus.doc} GrvItRes
@type           function
@description    Grava o resultado do processamento na tabela V45 (Cache de Resposta).
@author         Alexandre de Lima Santos
@since          09/12/2025
/*/
//---------------------------------------------------------------------
Static Function GrvItRes( cTicket as Character, cResp   as Character, cLevel  as Character, cCodRec as Character, cCpf as Character )

    Default cTicket := ""
    Default cResp   := ""
    Default cLevel  := ""
    Default cCodRec := ""
    Default cCpf    := ""

    RecLock("V45", .T.)

        V45->V45_FILIAL := xFilial("V45")
        V45->V45_ID     := cTicket
        V45->V45_RESP   := cResp
        V45->V45_LEVEL  := cLevel
        V45->V45_CODREC := cCodRec
        V45->V45_CPF    := cCpf

    V45->(MsUnlock())

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFFindName
@type           Function
@description    Busca o nome do dependente em diversas tabelas do sistema.
@author         Alexandre lima
@since          03/12/2025
/*/  
//---------------------------------------------------------------------  
Static Function TAFFindName( cCpf as Character, cFil as Character )

    Local cName as Character

    Default cCpf := ""
    Default cFil := ""

    cName := Posicione( "V7S", 3, xFilial("V7S", cFil) + cCpf, "V7S_NMDEP" )

    If Empty( cName )
        cName := Posicione( "C9Y", 3, xFilial("C9Y", cFil) + cCpf, "C9Y_NOMDEP" )
    EndIf

    If Empty( cName )
        cName := Posicione( "T3T", 2, xFilial("T3T", cFil) + cCpf, "T3T_NOMDEP" )
    EndIf

    If Empty( cName )
        cName := Posicione( "T2F", 3, xFilial("T2F", cFil) + cCpf, "T2F_NOMDEP" )
    EndIf

    If Empty( cName )
        cName := Posicione( "V74", 3, xFilial("V74", cFil) + cCpf, "V74_NMDEP" )
    EndIf

Return cName
