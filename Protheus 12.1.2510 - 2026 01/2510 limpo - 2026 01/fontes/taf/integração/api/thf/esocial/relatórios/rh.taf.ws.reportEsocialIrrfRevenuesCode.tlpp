//---------------------------------------------------------------------
Class IrrfRevenueCodes

    public Method New() as object

    @Post("/api/rh/esocial/v1/reportEsocialIrrfRevenueCodes")
    public Method reportEsocialIrrfRevenues() 

    @Get("/api/rh/esocial/v1/reportEsocialIrrfRevenueCodes/totalizers")
    public Method reportEsocialIrrfRevenueCodesTotalizer() 

    @Get("/api/rh/esocial/v1/reportEsocialIrrfRevenueCodes/revenueCodes")
    public Method reportEsocialIrrfRevenueCodesRevenues() 

    @Get("/api/rh/esocial/v1/reportEsocialIrrfRevenueCodes/employeesByRevenueCode")
    public Method employeesByRevenueCode() 

    @Get("/api/rh/esocial/v1/reportEsocialIrrfRevenueCodes/employeeDetails")
    public Method employeeDetails() 

    @Get("/api/rh/esocial/v1/reportEsocialIrrfRevenueCodes/status")
    public Method getStatus() 

    @Get("/api/rh/esocial/v1/reportEsocialIrrfRevenueCodes/exportEmployeeDetails")
    public Method exportEmployeeDetails() 

    private Method validateAndPrepare( jQuery, lCheckRequestId, cEmp, cFil, cReqId )

EndClass

Method New() as object Class IrrfRevenueCodes; Return

//---------------------------------------------------------------------
/*/{Protheus.doc} reportEsocialIrrfRevenues
@type           method
@description    Método POST para solicitar o processamento do relatório (Gera Ticket).
                Nota: Este método mantem lógica específica de parsing do Body diferente dos GETs.
@author         Alexandre Lima Santos / Fábio Mendonça
@since          
@param          companyId (Json) - ID da Empresa/Filial.
@param          period (Json)    - Período de apuração.
@return         lRet             - Indica se o processo foi iniciado.
/*/
//---------------------------------------------------------------------
Method reportEsocialIrrfRevenues() Class IrrfRevenueCodes

    Local aCompany    as Array
    Local cBody       as Character
    Local cEmpRequest as Character
    Local cFilRequest as Character
    Local cRequestID  as Character
    Local cCompany    as Character
    Local lRet        as Logical
    Local jJson       as Json 
    Local jRequest    as Json 
    Local jResponse   as Json 

    aCompany    := {}
    cBody       := oRest:getBodyRequest()
    cEmpRequest := ""
    cFilRequest := ""
    cRequestID  := ""
    cCompany    := ""
    lRet        := .T.
    jJson       := JsonObject():New()
    jRequest    := JsonObject():New()
    jResponse   := Nil

    jJson:FromJson( cBody )

    If jJson["companyId"] == Nil
        lRet := .F.
        oRest:setStatusCode(400)
        oRest:SetResponse( EncodeUTF8( "Empresa|Filial não informado no parâmetro 'companyId'." ) )
        Return
    ElseIf jJson["period"] == Nil
        lRet := .F.
        oRest:setStatusCode(400)
        oRest:SetResponse( EncodeUTF8( "Período não informado no parâmetro 'period'." ) )
        Return
    Else
        // Lógica específica do POST para tratar array de empresas separado por ponto e vírgula
        cCompany := Iif( Len( StrTokArr( jJson[ 'companyId' ], ";" ) ) > 1, StrTokArr( jJson[ 'companyId' ], ";" )[2], "" )

        If !Empty(cCompany)
            aCompany := StrTokArr( StrTokArr( jJson[ 'companyId' ], ";" )[1], "|" )
        Else
            aCompany := StrTokArr( jJson[ 'companyId' ], "|" )
        EndIf

        cEmpRequest := aCompany[1]
        cFilRequest := aCompany[2]

        PrepEnv( cEmpRequest, cFilRequest )

        cRequestID := tafGeraTic( jRequest, cBody, '4' )

        StartJob( "TAFPOSTDIRF", GetEnvServer(), .F., cEmpRequest, cFilRequest, cRequestID )

        jResponse              := JsonObject():New()
        jResponse["requestId"] := cRequestID
        oRest:SetResponse( jResponse:ToJson())

    EndIf

    FreeObj( jRequest )
    FreeObj( jResponse )

    DelClassIntF()

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} reportEsocialIrrfRevenueCodesTotalizer
@type           method
@description    Método GET para consultar os totalizadores do relatório.
@author         Denis R. de Oliveira
@since          26/11/2025
@param          companyId (Query) - ID da Empresa/Filial.
@param          requestId (Query) - ID da Requisição.
@return         lRet              - Sucesso.
/*/
//---------------------------------------------------------------------
Method reportEsocialIrrfRevenueCodesTotalizer() Class IrrfRevenueCodes

    Local cEmpRequest     as Character
    Local cFilRequest     as Character
    Local cRequestID      as Character
    Local jQuery          as Json
    Local jResponse       as Json
    Local lRet            as Logical

    cEmpRequest := ""
    cFilRequest := ""
    cRequestID  := ""
    jQuery      := oRest:getQueryRequest()
    jResponse   := JsonObject():New()
    lRet        := .T.

    // Uso do método auxiliar para validação e PrepEnv (DRY)
    If !Self:validateAndPrepare( jQuery, .T., @cEmpRequest, @cFilRequest, @cRequestID )
        Return 
    EndIf

    GetIrrfTotalizer( @jResponse, Padr( cRequestID , Tamsx3( 'V45_ID' )[1] ) )
    
    oRest:SetResponse( jResponse:toJson() )
    
    FreeObj( jResponse )
    DelClassIntF()

Return( lRet )

