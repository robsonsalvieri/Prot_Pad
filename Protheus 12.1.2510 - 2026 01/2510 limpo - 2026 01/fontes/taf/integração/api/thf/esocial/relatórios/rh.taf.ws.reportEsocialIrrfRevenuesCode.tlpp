//---------------------------------------------------------------------
/*/{Protheus.doc} employeesByRevenueCode
@type           method
@description    Método GET para listar funcionários por código de receita.
@author         Alexandre Lima Santos / Fábio Mendonça
@since          
@param          revenueCode (Query) - Código da Receita.
@param          companyId (Query)   - ID da Empresa/Filial.
@param          requestId (Query)   - ID da Requisição.
@return         lRet                - Sucesso.
/*/
//---------------------------------------------------------------------
Method employeesByRevenueCode() Class IrrfRevenueCodes

    Local cCodRec     as Character
    Local cLevel      as Character
    Local cRequestID  as Character
    Local cEmpRequest as Character
    Local cFilRequest as Character
    Local jQuery      as Json
    Local jJson       as Object
    
    cLevel      := "2"
    jQuery      := oRest:getQueryRequest()
    cEmpRequest := ""
    cFilRequest := ""
    cRequestID  := ""

    cCodRec     := IIF(jQuery["revenueCode"] <> Nil, jQuery["revenueCode"] , "") 

    If !Self:validateAndPrepare( jQuery, .T., @cEmpRequest, @cFilRequest, @cRequestID )
        Return
    EndIf

    DBSelectArea("V45")
    V45->( DbSetOrder(4) )
    
    //V45_FILIAL+V45_ID+V45_LEVEL+V45_CODREC+V45_CPF
    If V45->( DBSeek(xFilial("V45") + Padr( cRequestID , Tamsx3( 'V45_ID' )[1] ) + cLevel + cCodRec ) )
        jJson := JsonObject():New()
        jJson:FromJson( V45->V45_RESP )
        oRest:SetResponse(jJson)
    EndIf

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} employeeDetails
@type           method
@description    Método GET para consultar detalhes de um funcionário.
@author         Alexandre Lima Santos / Fábio Mendonça
@since          
@param          revenueCode (Query) - Código da Receita.
@param          cpf (Query)         - CPF.
@param          companyId (Query)   - ID da Empresa/Filial.
@param          requestId (Query)   - ID da Requisição.
@return         lRet                - Sucesso.
/*/
//---------------------------------------------------------------------
Method employeeDetails() Class IrrfRevenueCodes

    Local aJson       as Array
    Local cCodRec     as Character
    Local cCpf        as Character
    Local cLevel      as Character
    Local cRequestID  as Character
    Local cEmpRequest as Character
    Local cFilRequest as Character
    Local jQuery      as Json
    Local jJson       as Object
    Local jResponse   as Object 

    aJson       := {}
    cLevel      := "3"
    jQuery      := oRest:getQueryRequest()
    jResponse   := JsonObject():New()
    cEmpRequest := ""  
    cFilRequest := ""  
    cRequestID  := ""

    cCodRec     := IIF(jQuery["revenueCode"] <> Nil, jQuery["revenueCode"] , "") 
    cCpf        := IIF(jQuery["cpf"]         <> Nil, jQuery["cpf"] , "")  

    If !Self:validateAndPrepare( jQuery, .T., @cEmpRequest, @cFilRequest, @cRequestID )
        Return
    EndIf

    If !Empty(cCodRec) .And. !Empty(cCpf) 
        // V45 Order 4: V45_FILIAL + V45_ID + V45_LEVEL + V45_CODREC + V45_CPF
        DbSelectArea("V45")
        V45->( DbSetOrder(4) )
        If V45->( DBSeek(xFilial("V45") + Padr( cRequestID , Tamsx3( 'V45_ID' )[1] )  + cLevel + cCodRec + cCpf ) ) 
            jJson := JsonObject():New()
            jJson:FromJson( V45->V45_RESP )
            AAdd( aJson, jJson ) 
            jResponse["hasNext"] := .F.
            jResponse["items"]   := aJson
            oRest:SetResponse(jResponse)
        EndIf
    EndIf

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} getStatus
@type           method
@description    Método GET para consultar o percentual de execução do relatório.
@author         Felipe C. Seolin
@since          30/08/2019
@param          companyId (Query) - ID da Empresa/Filial.
@param          requestId (Query) - ID da Requisição.
@return         lRet              - Sucesso.
/*/
//---------------------------------------------------------------------
Method getStatus() Class IrrfRevenueCodes

    Local cEmpRequest as Character
    Local cFilRequest as Character
    Local cRequestID  as Character
    Local jResponse   as Json
    Local jQuery      as Json
    Local lIsLegacy   as Logical

    cEmpRequest := ""
    cFilRequest := ""
    cRequestID  := ""
    jQuery      := oRest:getQueryRequest()
    jResponse   := Nil
    lIsLegacy   := .F.

    If !Self:validateAndPrepare( jQuery, .T., @cEmpRequest, @cFilRequest, @cRequestID )
        Return
    EndIf

    lIsLegacy := TAFAlsInDic( "V5H" ) .and. !Empty( AllTrim( GetNewPar( "MV_TAFRHUR", "" ) ) )

    If ValidID( cRequestID )
        GetPercent( @jResponse, cRequestID )
        oRest:SetResponse(jResponse:toJson())
    Else
        oRest:setStatusCode(400)
        oRest:SetResponse( EncodeUTF8( "A Identificação da Requisição '" + cRequestID + "' informada não existe." ) )
    EndIf

    FreeObj( jResponse )
    DelClassIntF()

Return 

//---------------------------------------------------------------------
/*/{Protheus.doc} exportEmployeeDetails
@type           method
@description    Exporta em formato Excel os detalhes com paginação.
@author         Rodrigo Nicolino
@since          2025/12/14
@param          companyId (Query) - ID da Empresa/Filial.
@param          requestId (Query) - ID da Requisição.
@param          page (Query)      - Paginação.
@return         lRet              - Sucesso.
/*/
//---------------------------------------------------------------------
Method exportEmployeeDetails() Class IrrfRevenueCodes

    Local aJson       as Array
    Local cLevel      as Character
    Local cRequestID  as Character
    Local cEmpRequest as Character
    Local cFilRequest as Character
    Local cKey        as Character
    Local cIdPad      as Character
    Local jQuery      as Json
    Local jJson       as Object 
    Local jResponse   as Object 
    Local lRet        as Logical
    
    // Controle de Paginação
    Local nPage       as Numeric
    Local nPageSize   as Numeric
    Local nSkip       as Numeric
    Local nCount      as Numeric
    Local lHasNext    as Logical

    aJson       := {}
    cLevel      := "3" 
    jQuery      := oRest:getQueryRequest()
    jResponse   := JsonObject():New()
    lRet        := .T.

    // Paginação
    nPage       := IIF(jQuery["page"]     <> Nil, Val(jQuery["page"]), 1)
    nPageSize   := IIF(jQuery["pageSize"] <> Nil, Val(jQuery["pageSize"]), 100)
    
    If nPage < 1; nPage := 1; EndIf
    If nPageSize < 1; nPageSize := 100; EndIf

    cEmpRequest := ""
    cFilRequest := ""
    cRequestID  := ""

    // DRY: Valida e Prepara Ambiente
    If !Self:validateAndPrepare( jQuery, .T., @cEmpRequest, @cFilRequest, @cRequestID )
        Return 
    EndIf

    cIdPad := Padr( cRequestID , Tamsx3( 'V45_ID' )[1] )
    cKey   := xFilial("V45") + cIdPad + cLevel

    DbSelectArea("V45")
    V45->( DbSetOrder(4) ) 

    If V45->( DBSeek( cKey ) )
        
        // OFFSET
        nSkip := (nPage - 1) * nPageSize
        
        While nSkip > 0 .And. !V45->( Eof() ) .And. V45->( V45_FILIAL + V45_ID + V45_LEVEL ) == cKey
            V45->( DbSkip() )
            nSkip--
        EndDo

        // FETCH
        nCount   := 0
        lHasNext := .F.

        While !V45->( Eof() ) .And. V45->( V45_FILIAL + V45_ID + V45_LEVEL ) == cKey .And. nCount < nPageSize
            jJson := JsonObject():New()
            If !Empty(V45->V45_RESP)
                jJson:FromJson( V45->V45_RESP )
                AAdd( aJson, jJson )
            EndIf

            nCount++
            V45->( DbSkip() )
        EndDo
        
        If !V45->( Eof() ) .And. V45->( V45_FILIAL + V45_ID + V45_LEVEL ) == cKey
            lHasNext := .T.
        EndIf
        
        jResponse["hasNext"]  := lHasNext
        jResponse["items"]    := aJson
        jResponse["page"]     := nPage
        jResponse["pageSize"] := nPageSize
        
        oRest:SetResponse(jResponse)
    Else
        jResponse["hasNext"] := .F.
        jResponse["items"]   := {}
        oRest:SetResponse(jResponse)
    EndIf

    FreeObj(jResponse)

Return lRet

//---------------------------------------------------------------------
/*/{Protheus.doc} validateAndPrepare
@type           method
@description    Método auxiliar (DRY) para validar parâmetros comuns (CompanyId, RequestId)
                e preparar o ambiente (PrepEnv).
@author         Refatoração
@since          
@param          jQuery (Json)           - Objeto com os parâmetros da Query.
@param          lCheckRequestId (Log)   - Define se valida obrigatoriedade de requestId.
@param          cEmp (Ref)              - Retorna a Empresa extraída.
@param          cFil (Ref)              - Retorna a Filial extraída.
@param          cReqId (Ref)            - Retorna o RequestId extraído.
@return         lSuccess                - .T. se tudo OK, .F. se erro (já seta response 400).
/*/
//---------------------------------------------------------------------
Method validateAndPrepare( jQuery, lCheckRequestId, cEmp, cFil, cReqId ) Class IrrfRevenueCodes

    Local aCompany as Array
    Local cCompany as Character

    cCompany := IIF(jQuery["companyId"] <> Nil, jQuery["companyId"] , "") 
    cReqId   := IIF(jQuery["requestId"] <> Nil, jQuery["requestId"] , "")

    If Empty(cCompany)
        oRest:setStatusCode(400)
        oRest:SetResponse( EncodeUTF8( "Empresa|Filial não informado no parâmetro 'companyId'." ) )
        Return .F.
    EndIf

    If lCheckRequestId .And. Empty(cReqId)
        oRest:setStatusCode(400)
        oRest:SetResponse( EncodeUTF8( "Identificação da Requisição não informada no parâmetro 'requestId'." ) )
        Return .F. 
    EndIf

    aCompany := StrTokArr( cCompany, "|" )

    If Len( aCompany ) < 2
        oRest:setStatusCode(400)
        oRest:SetResponse( EncodeUTF8( "Formato de Empresa|Filial inválido no parâmetro 'companyId'." ) )
        Return .F.
    EndIf

    cEmp := aCompany[1]
    cFil := aCompany[2]

    If !PrepEnv( cEmp, cFil )
        oRest:setStatusCode(400)
        oRest:SetResponse( EncodeUTF8( "Falha na preparação do ambiente para a Empresa '" + cEmp + "' e Filial '" + cFil + "'." ) )
        Return .F.
    EndIf

Return .T.

//---------------------------------------------------------------------
/*/{Protheus.doc} ValidID
@type			function
@description	Verifica se o Identificador da Requisição é válido.
@author			Alexandre de Lima Santos
@since			03/08/2021
@param			cRequestID	-	Identificador da Requisição
@return			lRet		-	Indica se o Identificador da Requisição é válido
/*/
//---------------------------------------------------------------------
Static Function ValidID( cRequestID as character )

	Local lRet	as logical

	lRet	:=	.F.

	DBSelectArea( "V3J" )
	V3J->( DBSetOrder( 1 ) )
	lRet := V3J->( MsSeek( xFilial( "V3J" ) + cRequestID ) )

Return( lRet )
