#include "protheus.ch"
#include "tlpp-core.th"
#include "tlpp-object.th"
#include "tlpp-rest.th"
#include "totvs.protheus.fiscal.taf.eventsdocuments.ch"

namespace totvs.protheus.fiscal.taf.event

//------------------------------------------------------------------------------
/*/{Protheus.doc} eventsDocuments
Classe responsavel por gerenciar os endpoints de eventos de documentos fiscais

@type class
@version 1.0
@author Misael Ramos
@since 05/11/2025
/*/
//------------------------------------------------------------------------------
Class eventsDocuments

    public data jResponse as json

    public method new() as object

    @Get("/api/taf/fiscal/v1/eventsDocuments")
    public method getEventsDocuments()

EndClass

//------------------------------------------------------------------------------
/*/{Protheus.doc} eventsDocuments::new
Metodo construtor da classe eventsDocuments

@type method
@version 1.0
@author Misael Ramos
@since 05/11/2025
@return object, retorna a instancia da classe
/*/
//------------------------------------------------------------------------------
Method new() as Object Class eventsDocuments

    ::jResponse := JsonObject():New()

Return Self

//------------------------------------------------------------------------------
/*/{Protheus.doc} eventsDocuments::getEventsDocuments
Metodo responsavel por obter os eventos de documentos fiscais

@type method
@version 1.0
@author Misael Ramos
@since 05/11/2025
@return json, retorna a resposta em formato JSON
/*/
//------------------------------------------------------------------------------
Method getEventsDocuments() Class eventsDocuments

	Local oService := eventsDocumentsService():New() as object
	Local jParam := Nil as Json

	jParam := oRest:getQueryRequest()

	If Empty(jParam['page'])
		::jResponse := SetRestFault(400, STR0001,,, STR0002) //#"O parâmetro 'page' é obrigatório e não foi informado." ##"Informar o parâmetro page."
	ElseIf Empty(jParam['pageSize'])
		::jResponse := SetRestFault(400, STR0003,,, STR0004) //#"O parâmetro 'pageSize' é obrigatório e não foi informado." ##"Informar o parâmetro pageSize."
	Else
		::jResponse := oService:getEventsDocService(Val(jParam['page']), Val(jParam['pageSize']), jParam['status'],;
								jParam['startPeriod'], jParam['endPeriod'], jParam['events'])
	EndIf

	FreeObj(oService)

Return oRest:setResponse(::jResponse)
