#INCLUDE 'tlpp-core.th'
#INCLUDE 'tlpp-rest.th'
/*-------------------------------------------------------------------
{Protheus.doc} TafEventStats()

Monta o retorno dos metodos Get 
@author	Evandro Italo
@since  12/12/2025
-------------------------------------------------------------------*/

@GET(endpoint='/api/taf/fiscal/v1/eventstats', description='Status dos eventos')
Function TafEventStats()

    Local oJsResponse as json

    oJsResponse := getTafEventStats()
    oRest:setResponse(oJsResponse) 
    FWFreeObj(oJsResponse)

Return

/*-------------------------------------------------------------------
{Protheus.doc} getTafEventStats()
Consulta Unidades de Medida monta a lista completa ou por código    
@author	Evandro Italo
@since  12/12/2025
-------------------------------------------------------------------*/
Static Function getTafEventStats()

    Local oJsResponse     as json
    Local oItem           as json
    Local aEventsStatus   as array
    Local nStatus         as integer

    aEventsStatus := { "1=Solicitado", "2=Enviado", "3=Sol.Cancelamento", "4=Cancelado", "5=Falha de envio", "6=Todos" }
    oJsResponse := JsonObject():New()
    oJsResponse['data'] := {}

    FOR nStatus := 1 TO Len(aEventsStatus)

        oItem :=  JsonObject():New()
        oItem['key'    ] := SubStr(aEventsStatus[nStatus], 1, At("=", aEventsStatus[nStatus]) - 1)
        oItem['label'  ] := SubStr(aEventsStatus[nStatus], At("=", aEventsStatus[nStatus]) + 1)

        AADD(oJsResponse['data'], oItem)

    NEXT nStatus

    FwFreeArray(aEventsStatus)

Return oJsResponse
