	Else
		::jResponse["errorCode"] := jRetData["errorCode"]
		::jResponse["errorMessage"] := jRetData["errorMessage"]
	EndIf

	FreeObj(oDataRet)

Return ::jResponse

//------------------------------------------------------------------------------
/*/{Protheus.doc} GetEventType
Funcao responsavel por obter o tipo do evento conforme o codigo do evento

@type method
@version 1.0
@author Misael Ramos
@since 20/11/2025
@param cEvent, character, codigo do evento
@return character, retorna o tipo do evento
/*/
//------------------------------------------------------------------------------
Method getEventType(cEvent as character) as character Class WSEventsService

	Local cTypeEvent   := "" as character
	Local cEventRange1 := "112110" as character
	Local cEventRange2 := "112120, 112130, 112140, 211120, 211124, 211130, 211140" as character
	Local cEventRange3 := "211128, 212120, 212110" as character
	Local cEventRange4 := "211150" as character
	Local cEventRange5 := "211110" as character
	Local cEventRange6 := "112150" as character

	Do Case
		Case cEvent $ cEventRange1
			cTypeEvent := "EVENT_MODEL_1"
		Case cEvent $ cEventRange2
			cTypeEvent := "EVENT_MODEL_2"
		Case cEvent $ cEventRange3
			cTypeEvent := "EVENT_MODEL_3"
		Case cEvent $ cEventRange4
			cTypeEvent := "EVENT_MODEL_4"
		Case cEvent $ cEventRange5
			cTypeEvent := "EVENT_MODEL_5"
		Case cEvent $ cEventRange6
			cTypeEvent := "EVENT_MODEL_6"
	EndCase

Return cTypeEvent

//------------------------------------------------------------------------------
/*/{Protheus.doc} ItemsOrFieldsJson
Determina se o evento deve usar array items ou fields no Json de resposta

@type method
@version 1.0
@author Misael Ramos
@since 20/11/2025
@param cEvent, character, codigo do evento
@return logical, retorna .T. se deve usar items, .F. se deve usar fields
/*/
//------------------------------------------------------------------------------
Method itemsOrFieldsJson(cEvent as character) as logical Class WSEventsService

	Local lUseFields := .F. as logical
	Local cUseFields := "112110, 211128, 212120, 212110, 112150" as character

	If cEvent $ cUseFields
		lUseFields := .T.
	EndIf

Return lUseFields

//------------------------------------------------------------------------------
/*/{Protheus.doc} getStatusEnvironment
Metodo responsável por consultar o status do TSS

@type method
@version 1.0
@author Carla Bianca Santos Latorre
@since 07/01/2026
/*/
//------------------------------------------------------------------------------
Method getStatusEnvironment() As Json Class WSEventsService
    Local oWs          As Object
    Local jRetData     As Json
    Local aItems       As Array
    Local cIdEntConfig As Character 
    Local cEntityMsg   As Character 
    Local cStatus      As Character
    Local cUrl         As Character
    
    aItems       := {}
    cStatus      := "2" 
    cEntityMsg   := "Entidade não encontrada"
    cIdEntConfig := RetIdEnti()
    cUrl         := SuperGetMv("MV_SPEDURL", .F., "")
	jRetData     := JsonObject():New()

    If !Empty(cIdEntConfig) .And. !Empty(cUrl)

        oWS := WsSpedCfgNFe():New()
        oWS:cUSERTOKEN := "TOTVS"
        oWS:cID_ENT    := cIdEntConfig
        oWS:_URL       := AllTrim(cUrl) + "/SPEDCFGNFe.apw"

        If oWs:CFGCONNECT()
            cStatus    := "1"
            cEntityMsg := cIdEntConfig 
        EndIf
        
        FreeObj(oWS)
    EndIf

    jRetData['statusEnvironment'] := cStatus
    jRetData['entityTSS']         := cEntityMsg 
    
    AAdd(aItems, jRetData)

    ::jResponse['items']   := aItems
    ::jResponse['hasNext'] := .F.

    ::lOk   := .T.
    ::nCode := 200
   
Return ::jResponse
