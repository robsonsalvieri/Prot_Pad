#include "tlpp-core.th"

namespace totvs.protheus.fiscal.taf.event

CLASS WSEventsService
	public data jResponse as Json
    public Data lOk   As Logical
    public Data nCode As Numeric
    public Data cMessage As Character

    public Method New()
    public Method getQueryResponse()  As Json
    public Method postSaveEvents()    As Json
    public Method putSaveEvents()     As Json
    public method getEventById() 	  As Json
	public method putEventRelay() 	  As Json
	public method putEventCancel()	  As Json
	public method getEventType() 	  as character
	public method itemsOrFieldsJson() as logical
	public method getStatusEnvironment() as json
EndClass

/*/{Protheus.doc} New
	Método construtor
@author juan.felipe
@since 03/10/2025
/*/
Method New() CLASS WSEventsService
    Self:jResponse := JsonObject():new()
    Self:lOk := .F.
    Self:nCode := 0
    Self:cMessage := ""
Return Nil

/*/{Protheus.doc} getQueryResponse
	Metodo responsavel por validar regras de consulta.
@author juan.felipe
@since 03/10/2025
@param nPage, numeric, número da pagina.
@param nPageSize, numeric, tamanho da página.
@param nOption, numeric, opção de consulta.
@param oJsonQuery, json, parâmetros da requisição.
@return jResponse, json, objeto json com os dados requisitados.
/*/
Method getQueryResponse(nPage, nPageSize, nOption, oJsonQuery) As Json Class WSEventsService
    Local oEventsRepository As Object

    Default nPage := 1
	Default nPageSize := 10
    Default nOption := 0
    Default oJsonQuery := JsonObject():New()

    oEventsRepository := WSEventsRepository():New("GET")
    oEventsRepository:Get(nPage, nPageSize, nOption, oJsonQuery)

    Self:lOk := oEventsRepository:lOk
    Self:nCode := oEventsRepository:GetCode()
    Self:cMessage := oEventsRepository:GetMessage()
    Self:jResponse := oEventsRepository:getJSONResponse()

    oEventsRepository:DeActivate()
    FreeObj(oEventsRepository)
Return Self:jResponse 

/*/{Protheus.doc} postSaveEvents
	Salva eventos para os documentos fiscais selecionados.
@author juan.felipe
@since 19/11/2025
@return jResponse, object, objeto json com os dados da requisição.
/*/
Method postSaveEvents(jRequest As Json) As Json Class WSEventsService
    Local oEventsRepository As Object
    Local jResponse As Json
	
    Default jRequest := JsonObject():New()

    oEventsRepository := WSEventsRepository():New("POST")
    jResponse := oEventsRepository:postSaveEvents(jRequest)
    Self:lOk := oEventsRepository:lOk
    
    FreeObj(oEventsRepository)
Return jResponse

/*/{Protheus.doc} putSaveEvents
	Atualiza eventos para os documentos fiscais selecionados.
@author juan.felipe
@since 21/11/2025
@param cId, character, identificador do evento.
@param jRequest, json, parâmetros da requisição.
@return jResponse, object, objeto json com os dados da requisição.
/*/
Method putSaveEvents(cId As Character, jRequest As Json) As Json Class WSEventsService
    Local oEventsRepository As Object
    Local jResponse As Json
	
    Default cId := ""
    Default jRequest := JsonObject():New()

    oEventsRepository := WSEventsRepository():New("PUT")
    jResponse := oEventsRepository:putSaveEvents(cId, jRequest)
    Self:lOk := oEventsRepository:lOk
    
    FreeObj(oEventsRepository)
Return jResponse

//------------------------------------------------------------------------------
/*/{Protheus.doc} WSEventsService::getEventById
Metodo responsavel por obter os dados de do evento pelo ID

@type method
@version 1.0
@author Misael Ramos
@since 20/11/2025
@param cIdEvent, character, codigo do evento
@return json, retorna a resposta em formato JSON
/*/
//------------------------------------------------------------------------------
Method getEventById(cIdEvent as character) as json Class WSEventsService

	Local oDataRet   := Nil as object
	Local oCodEvent  := Nil as object
	Local jCodEvent	 := Nil as Json
	Local jItems 	 := Nil as Json
	Local jEvent	 := Nil as Json
	Local cItems	 := ""  as character
	Local cTypeEvent := ""  as character
	Local cRetData	 := ""  as character
	local cCodEvent  := ""  as character
	local cCodChvNf  := ""  as character
	Local aItems 	 := {}  as array

	oCodEvent := WSEventsRepository():New("GET")
	oCodEvent:getEventById("EVENT_CODE", cIdEvent)

	If oCodEvent:lOk
		Self:nCode := oCodEvent:GetCode()
    	Self:cMessage := oCodEvent:GetMessage()

		cItems    := oCodEvent:GetJSONResponse()
		jCodEvent := JsonObject():New()
		jCodEvent:FromJson(cItems)

		aItems := jCodEvent:GetJSonObject("items")

		If Len(aItems) > 0

			cCodEvent  := aItems[1]:GetJsonObject("event")
			cCodChvNf  := aItems[1]:GetJsonObject("chvnf")
			cTypeEvent := ::getEventType(cCodEvent)

			oDataRet := WSEventsRepository():New("GET")
			oDataRet:getEventById(cTypeEvent, cIdEvent)

			If oDataRet:lOk

				cRetData := oDataRet:getJSONResponse()
				jItems := JsonObject():New()
				jEvent := JsonObject():New()

				jItems:FromJson(cRetData)
				aItems := jItems:GetJSonObject("items")

				::jResponse["id"] 	 := cIdEvent
				::jResponse["chvnf"] := cCodChvNf

				// Define estrutura do JSON baseada no evento
				If ::itemsOrFieldsJson(cCodEvent)
					jEvent["event"]  := cCodEvent
					jEvent["items"]  := {}
					jEvent["fields"] := aItems
				Else
					jEvent["event"]  := cCodEvent
					jEvent["items"]  := aItems
					jEvent["fields"] := {}
				EndIf

				::jResponse["event"] := jEvent

			EndIf

			oDataRet:DeActivate()

			FreeObj(oDataRet)
			FreeObj(jItems)
			FreeObj(jEvent)

		EndIf

	EndIf
	
	oCodEvent:DeActivate()

	FreeObj(oCodEvent)
	FreeObj(jCodEvent)

Return ::jResponse

//------------------------------------------------------------------------------
/*/{Protheus.doc} WSEventsService::putEventRelay
Metodo responsavel por retransmitir o evento

@type method
@version 1.0
@author Misael Ramos
@since 19/11/2025
@param cIdEvent, character, codigo do evento
@return Json, retorna a resposta em formato JSON
/*/
//------------------------------------------------------------------------------
Method putEventRelay(cIdEvent as character) as Json Class WSEventsService

	Local oDataRet := Nil as object
	Local jRetData := Nil as Json

	oDataRet := WSEventsRepository():New("PUT")
	jRetData := oDataRet:putEventRelay(cIdEvent)

	If jRetData["lOk"] == .T.
		::jResponse["id"] := cIdEvent
		::jResponse["message"] := jRetData["message"]
	Else
		::jResponse["errorCode"] := jRetData["errorCode"]
		::jResponse["errorMessage"] := jRetData["errorMessage"]
	EndIf

	FreeObj(oDataRet)

Return ::jResponse

//------------------------------------------------------------------------------
