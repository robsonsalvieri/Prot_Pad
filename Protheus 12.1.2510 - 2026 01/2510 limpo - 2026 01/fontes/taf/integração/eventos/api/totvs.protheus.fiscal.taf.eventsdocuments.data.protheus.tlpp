#include "protheus.ch"
#include "tlpp-core.th"
#include "tlpp-object.th"
#include "totvs.protheus.fiscal.taf.eventsdocuments.ch"

namespace totvs.protheus.fiscal.taf.event

//-----------------------------------------------------------------------
/*/{Protheus.doc} eventsDocumentsProtheusData
Classe responsavel por gerenciar a obtencao dos dados de eventos de documentos fiscais no Protheus

@type class
@version 1.0
@author Misael Ramos
@since 05/11/2025
/*/
//-----------------------------------------------------------------------
Class eventsDocumentsProtheusData From FWAdapterBaseV2

	protected data cCodPresumido as character
	protected data cCodTribIbs   as character
	protected data cCodTribCbs   as character
	protected data oUtil         as object

    public method new() as object
	public method setMapFields()
	public method getEventsDocItems()

EndClass

//-----------------------------------------------------------------------
/*/{Protheus.doc} eventsDocumentsProtheusData::New
Metodo responsavel por criar uma nova instancia da classe eventsDocumentsProtheusData

@type method
@version 1.0
@author Misael Ramos
@since 05/11/2025
@param cVerb, character, verbo da operacao
@return object, retorna a instancia da classe
/*/
//-----------------------------------------------------------------------
Method New(cVerb as character) as object Class eventsDocumentsProtheusData

	_Super:New(cVerb, .T.)

	::oUtil := totvs.protheus.fiscal.taf.event.utils():New()
	
	::cCodPresumido := "211110"
	::cCodTribIbs   := "'000042', '000043', '000044', '000045', '000046', '000047', '000048', '000049'"
	::cCodTribCbs	:= "'000031', '000032', '000033', '000039', '000040'"

Return Self

//-----------------------------------------------------------------------
/*/{Protheus.doc} eventsDocumentsProtheusData::setMapFields
Metodo responsavel por chamar todos os mapeamentos de campos de acordo com a propriedade

@type method
@version 1.0
@author Misael Ramos
@since 06/11/2025
@param cProperty, character, nome da propriedade do Json a ser mapeada
/*/
//-----------------------------------------------------------------------
Method setMapFields(cProperty as character) Class eventsDocumentsProtheusData

	Do Case
		Case cProperty == "items"
			Self:AddMapFields("documentType", 	"C20_INDOPE", 	.T., .F., { "C20_INDOPE",	'C', ::oUtil:GetFieldLength('C20_INDOPE'), 	0 },"CASE WHEN C20_INDOPE = '0' THEN '"+STR0005+"' ELSE '"+STR0006+"' END") //Entrada ### Saída
			Self:AddMapFields("typeOfAuthor", 	"T7A_TPAUT",	.T., .T., { "T7A_TPAUT", 	'C', ::oUtil:GetFieldLength('T7A_TPAUT'),   0 })
			Self:AddMapFields("noteNumber", 	"T7A_NUMDOC",   .T., .T., { "T7A_NUMDOC", 	'C', ::oUtil:GetFieldLength('T7A_NUMDOC'), 	0 })
			Self:AddMapFields("dateEmission", 	"C20_DTDOC",    .T., .T., { "C20_DTDOC", 	'D', ::oUtil:GetFieldLength('C20_DTDOC'), 	0 })
			Self:AddMapFields("cnpjIssuer", 	"C1H_CNPJCPF", 	.T., .T., { "C1H_CNPJCPF", 	'C', ::oUtil:GetFieldLength('C1H_CNPJ'), 	0 }, GetCpfCnpj())
			Self:AddMapFields("issuer", 		"C1H_NOME",   	.T., .T., { "C1H_NOME", 	'C', ::oUtil:GetFieldLength('C1H_NOME'), 	0 })
		Case cProperty == "detailItems"
			Self:AddMapFields("event", 		      "T7A_TPEVEN", .T., .T., { "T7A_TPEVEN", 	'C', ::oUtil:GetFieldLength('T7A_TPEVEN'),  0 })
			Self:AddMapFields("dateEmission", 	  "T7A_DTEMIS", .T., .T., { "T7A_DTEMIS", 	'D', ::oUtil:GetFieldLength('T7A_DTEMIS'),  0 })
			Self:AddMapFields("eventDescription", "T7E_DESCRI", .T., .T., { "T7E_DESCRI", 	'C', ::oUtil:GetFieldLength('T7E_DESCRI'),  0 })
			Self:AddMapFields("status", 		  "T7A_STATUS", .T., .T., { "T7A_STATUS", 	'C', ::oUtil:GetFieldLength('T7A_STATUS'),  0 })
			Self:AddMapFields("id", 			  "T7A_IDENT",  .T., .T., { "T7A_IDENT",  	'C', ::oUtil:GetFieldLength('T7A_IDENT'),   0 })
			Self:AddMapFields("branch",			  "T7A_FILIAL", .F., .T., { "T7A_FILIAL", 	'C', ::oUtil:GetFieldLength('T7A_FILIAL'),  0 })
		Case cProperty == "subDetailItems"
			Self:AddMapFields("codItem", 		"COD_ITEM",   	.T., .F., { "COD_ITEM",   	'C', ::oUtil:GetFieldLength('T7B_ITEM'), 	0 }, GetItem(::cCodPresumido))
			Self:AddMapFields("description", 	"C1L_DESCRI",  	.T., .T., { "C1L_DESCRI", 	'C', ::oUtil:GetFieldLength('C1L_DESCRI'), 	0 })
			Self:AddMapFields("ncm", 			"C0A_CODIGO",  	.T., .T., { "C0A_CODIGO", 	'C', ::oUtil:GetFieldLength('C0A_CODIGO'), 	0 })
			Self:AddMapFields("cst", 			"T5R_CODCST",   .T., .T., { "T5R_CODCST",   'C', ::oUtil:GetFieldLength('T5R_CODCST'),  0 })
			Self:AddMapFields("cClassTri", 		"T5R_CCLATR",   .T., .T., { "T5R_CCLATR", 	'C', ::oUtil:GetFieldLength('T5R_CCLATR'), 	0 })
			Self:AddMapFields("unit", 			"C1J_CODIGO",  	.T., .T., { "C1J_CODIGO",   'C', ::oUtil:GetFieldLength('C1J_CODIGO'),  0 })
			Self:AddMapFields("amount",			"QTDE",    		.T., .T., { "QTDE", 		'N', ::oUtil:GetFieldLength('T7C_QUANT'), 	::oUtil:GetFieldDecimal('T7C_QUANT') },"Coalesce(T7C_QUANT,0)")
			Self:AddMapFields("valueItem", 		"C30_VLRITE",   .T., .T., { "C30_VLRITE", 	'N', ::oUtil:GetFieldLength('C30_VLRITE'), 	::oUtil:GetFieldDecimal('C30_VLRITE') })
			Self:AddMapFields("valueTotal", 	"C30_TOTAL",   	.T., .T., { "C30_TOTAL", 	'N', ::oUtil:GetFieldLength('C30_TOTAL'), 	::oUtil:GetFieldDecimal('C30_TOTAL') })
			Self:AddMapFields("ibs", 			"IBS_VALOR",   	.T., .T., { "IBS_VALOR", 	'N', ::oUtil:GetFieldLength('T7B_VALOR'), 	::oUtil:GetFieldDecimal('T7B_VALOR') }, GetValorTrib(::cCodPresumido, ::cCodTribIbs))
			Self:AddMapFields("cbs", 			"CBS_VALOR",   	.T., .T., { "CBS_VALOR", 	'N', ::oUtil:GetFieldLength('T7B_VALOR'), 	::oUtil:GetFieldDecimal('T7B_VALOR') }, GetValorTrib(::cCodPresumido, ::cCodTribCbs))
	EndCase

Return Nil

//-----------------------------------------------------------------------
/*/{Protheus.doc} eventsDocumentsProtheusData::getEventsDocData
Metodo responsavel por obter os dados de eventos de documentos fiscais no Protheus

@type method
@version 1.0
@author Misael Ramos
@since 06/11/2025
@param nPage, numeric, numero da pagina
@param nPageSize, numeric, numero da pagina
@param cStatus, character, status do evento
@param cStartPeriod, character, periodo de inicio
@param cEndPeriod, character, periodo de termino
@param cEvents, character, códigos dos eventos
@param cProperty, character, nome da propriedade do Json a ser mapeada
@param cIdEvent, character, identificador do evento
@param cNumDoc, character, numero do documento fiscal
@param cTypAut, character, tipo do autor do evento
@param cBranch, character, filial do evento
/*/
//-----------------------------------------------------------------------
Method getEventsDocItems(nPage as numeric, nPageSize as numeric, cStatus as character, cStartPeriod as character, cEndPeriod as character,;
						cEvents as character, cProperty as character, cIdEvent as character, cNumDoc as character, cTypAut as character) Class eventsDocumentsProtheusData

	Local aArea		  := GetArea() as array
	Local cQuery 	  := "" as character
	Local cWhere 	  := "" as character
	Local cOrderQuery := "" as character

	Default nPage := 1
	Default nPageSize := 10

	If !Empty(cStatus)
		cStatus := ::oUtil:formatItemsSQL(cStatus)
	EndIf

	If !Empty(cEvents)
		cEvents := ::oUtil:formatItemsSQL(cEvents)
	EndIf

	cQuery := getQuery(cProperty, ::cCodPresumido)
	cWhere := getFilterEventsDocuments(cStatus, cStartPeriod, cEndPeriod, cEvents, cProperty, cIdEvent, cNumDoc, cTypAut)
	cOrderQuery := getOrderEventsDocuments()

	::setMapFields(cProperty)

	If cProperty == "items"
		::setPage(nPage)
		::setPageSize(nPageSize)
	Else
		::setPage(nPage)
		::setPageSize(1000)
	EndIf

	::SetQuery(cQuery)
	::SetWhere(cWhere)
	::SetOrder(cOrderQuery)
	::SetIsCaseSensitive(.T.)

	If ::Execute()
		::FillGetResponse()
	EndIf

	RestArea(aArea)
	FWFreeObj(aArea)

Return

//-----------------------------------------------------------------------
/*/{Protheus.doc} getQuery
Funcao que constroi a query SQL para obtencao dos eventos de documentos fiscais

@type function
@version 1.0
@author Misael Ramos
@since 06/11/2025
@param cProperty, character, nome da propriedade do Json a ser mapeada
@param cCodPresumido, character, Código do tributo presumido
@return character, Retorna a query SQL
/*/
//-----------------------------------------------------------------------
Static Function getQuery(cProperty as character, cCodPresumido as character) as character

	Local cQuery := "" as character

	Default cProperty := ""

	Do Case
		Case cProperty == "items"
			cQuery := "SELECT #QueryFields# "
			cQuery += " FROM " + RetSqlName("T7A") + " T7A "
			cQuery += "INNER JOIN " + RetSqlName("C20") + " C20 "
			cQuery += " ON  C20.C20_FILIAL = '" + FwXFilial("C20") + "'"
			cQuery += " AND C20.C20_CHVNF  = T7A.T7A_CHVNF "
			cQuery += " AND C20.D_E_L_E_T_ = ' ' "
			cQuery += "LEFT JOIN " + RetSqlName("C1H") + " C1H "
			cQuery += " ON  C1H.C1H_FILIAL = '" + FwXFilial("C1H") + "'"
			cQuery += " AND C1H.C1H_ID = T7A.T7A_CODPAR "
			cQuery += "	AND C1H.D_E_L_E_T_ = ' ' "
			cQuery += "WHERE #QueryWhere# "
			cQuery += "GROUP BY T7A_FILIAL, T7A_NUMDOC, T7A_TPAUT, C20_INDOPE, C20_DTDOC, C1H_CNPJ, C1H_CPF, C1H_NOME, C1H_PPES, C1H_PEEXTE "
		Case cProperty == "detailItems"
			cQuery := "SELECT #QueryFields# "
			cQuery += " FROM " + RetSqlName("T7A") + " T7A "
			cQuery += "INNER JOIN " + RetSqlName("T7E") + " T7E "
			cQuery += " ON  T7E.T7E_FILIAL = '" + FwXFilial("T7E") + "'"
			cQuery += " AND T7E.T7E_EVENTO = T7A.T7A_TPEVEN "
			cQuery += " AND T7E.D_E_L_E_T_ = ' ' "
			cQuery += "WHERE #QueryWhere# "
		Case cProperty == "subDetailItems"
			cQuery := "SELECT #QueryFields# "
			cQuery += " FROM " + RetSqlName("T7A") + " T7A "
			cQuery += "LEFT JOIN " + RetSqlName("T7B") + " T7B "
			cQuery += " ON  T7B.T7B_FILIAL = '" + FwXFilial("T7B") + "'"
			cQuery += " AND T7B.T7B_IDENT  = T7A.T7A_IDENT "
			cQuery += " AND T7B.D_E_L_E_T_ = ' ' "
			cQuery += "LEFT JOIN " + RetSqlName("T7C") + " T7C "
			cQuery += " ON  T7C.T7C_FILIAL = '" + FwXFilial("T7C") + "'"
			cQuery += " AND T7C.T7C_IDENT  = T7A.T7A_IDENT "
			cQuery += " AND T7C.D_E_L_E_T_ = ' ' "
			cQuery += "INNER JOIN " + RetSqlName("C30") + " C30 "
			cQuery += " ON  C30.C30_FILIAL = '" + FwXFilial("C30") + "'"
			cQuery += " AND C30.C30_CHVNF  = T7A.T7A_CHVNF "
			cQuery += " AND C30.C30_ITEXML  =  "
			cQuery += " CASE "
            cQuery += "	   	WHEN T7A.T7A_TPEVEN = '" + cCodPresumido + "'"
			cQuery += " 		THEN T7B.T7B_ITEM "
            cQuery += "	   		ELSE T7C.T7C_ITEM "
            cQuery += "	END "
			cQuery += " AND C30.D_E_L_E_T_ = ' ' "
			cQuery += "INNER JOIN " + RetSqlName("C35") + " C35 "
			cQuery += " ON  C35.C35_FILIAL = '" + FwXFilial("C35") + "'"
			cQuery += " AND C35.C35_CHVNF  = T7A.T7A_CHVNF "
			cQuery += " AND C35.C35_NUMITE = C30.C30_NUMITE "
			cQuery += " AND C35.C35_CODITE = C30.C30_CODITE "
			cQuery += " AND C35.C35_CODTRI = CASE "
            cQuery += "            WHEN T7A.T7A_TPEVEN = '" + cCodPresumido + "' THEN T7B.T7B_CODTRI "
            cQuery += "            ELSE T7C.T7C_CODTRI "
            cQuery += "       END "
			cQuery += " AND C35.D_E_L_E_T_ = ' ' "
			cQuery += "INNER JOIN " + RetSqlName("C1L") + " C1L "
			cQuery += " ON  C1L.C1L_FILIAL = '" + FwXFilial("C1L") + "'"
			cQuery += " AND C1L.C1L_ID 	   = C30.C30_CODITE "
			cQuery += " AND C1L.D_E_L_E_T_ = ' ' "
			cQuery += "INNER JOIN " + RetSqlName("C1J") + " C1J "
			cQuery += "	ON  C1J.C1J_FILIAL = '" + FwXFilial("C1J") + "'"
			cQuery += "	AND C1J.C1J_ID     = C30.C30_UM "
			cQuery += "	AND C1J.D_E_L_E_T_ = ' ' "
			cQuery += "INNER JOIN " + RetSqlName("T5R") + " T5R "
			cQuery += "	ON  T5R.T5R_FILIAL = '" + FwXFilial("T5R") + "'"
			cQuery += "	AND T5R.T5R_ID     = C35.C35_CST "
			cQuery += "	AND T5R.D_E_L_E_T_ = ' ' "
			cQuery += "LEFT JOIN " + RetSqlName('C0A') + " C0A "
			cQuery += " ON C0A.C0A_FILIAL  = '" + FwXFilial("C0A") + "'"
			cQuery += " AND C0A.C0A_ID     = C1L.C1L_CODNCM "
			cQuery += " AND C0A.D_E_L_E_T_ = ' ' "
			cQuery += "WHERE #QueryWhere# "
			cQuery += "GROUP BY T7A_FILIAL, T7A_NUMDOC, T7A_TPEVEN, T7B_ITEM, T7C_ITEM, C1L_DESCRI, C0A_CODIGO, C1J_CODIGO, T7C_QUANT, C30_VLRITE, C30_TOTAL, T7A_IDENT, T5R_CODCST, T5R_CCLATR "
	EndCase

Return cQuery

//-----------------------------------------------------------------------
/*/{Protheus.doc} GetItem
Retorna string que irá definir o campo item conforme o código presumido

@type function
@version 1.0
@author Misael Ramos
@since 12/11/2025
@param cCodPresumido, character, Código presumido do item
@return character, Retorna a string que define o campo item
/*/
//-----------------------------------------------------------------------
Static Function GetItem(cCodPresumido as character) as character

	Local cItem := "" as character

	cItem := " CASE "
	cItem += " 		WHEN T7A_TPEVEN = '" + cCodPresumido + "'"
	cItem += "			THEN T7B_ITEM "
	cItem += "		ELSE T7C_ITEM "
	cItem += " END "

Return cItem

//-----------------------------------------------------------------------
/*/{Protheus.doc} GetCpfCnpj
Retorna string que irá definir o campo CPF/CNPJ conforme a existencia do CPF

@type function
@version 1.0
@author Misael Ramos
@since 12/11/2025
@return character, Retorna a string que define o campo CPF/CNPJ
/*/
//-----------------------------------------------------------------------
Static Function GetCpfCnpj() as character

	Local cCpfCnpj := "" as character

cCpfCnpj := " CASE "
cCpfCnpj += "     WHEN C1H.C1H_PPES = '1' OR (C1H.C1H_PPES = '3' AND C1H.C1H_PEEXTE = '1') THEN C1H.C1H_CPF "
cCpfCnpj += "     WHEN C1H.C1H_PPES = '2' OR (C1H.C1H_PPES = '3' AND C1H.C1H_PEEXTE = '2') THEN C1H.C1H_CNPJ "
cCpfCnpj += "     WHEN (C1H.C1H_CPF IS NULL OR LTRIM(RTRIM(C1H.C1H_CPF)) = '') THEN C1H.C1H_CNPJ "
cCpfCnpj += "     ELSE C1H.C1H_CPF "
cCpfCnpj += " END "

Return cCpfCnpj

//-----------------------------------------------------------------------
/*/{Protheus.doc} GetValorTrib
Retorna string que irá definir o campo Valor do Tributo

@type function
@version 1.0
@author Misael Ramos
@since 12/11/2025
@param cCodPresumido, character, Código presumido do tributo
@param cCodTrib, character, Códigos dos tributos
@return character, Retorna a string que define o campo Valor do Tributo
/*/
//-----------------------------------------------------------------------
Static Function GetValorTrib(cCodPresumido as character, cCodTrib as character) as character

	Local cValorTrib := "" as character

	cValorTrib := " MAX( "
	cValorTrib += " CASE "
	cValorTrib += " 	WHEN T7A_TPEVEN  = '" + cCodPresumido + "' THEN " 
	cValorTrib += " 		CASE WHEN T7B_CODTRI IN (" + cCodTrib + ") "
	cValorTrib += "			THEN T7B_VALOR ELSE 0 END "
	cValorTrib += " ELSE "
	cValorTrib += " 		CASE WHEN T7C_CODTRI IN (" + cCodTrib + ") "
	cValorTrib += "			THEN T7C_VALOR ELSE 0 END"
	cValorTrib += " END "
	cValorTrib += " ) "

Return cValorTrib

//-----------------------------------------------------------------------
/*/{Protheus.doc} getFilterEventsDocuments
Funcao que construi a clausula WHERE para filtragem dos eventos de documentos fiscais

@type function
@version 1.0
@author Misael Ramos
@since 06/11/2025
@param cStatus, character, parametro com codigos de status do evento
@param cStartPeriod, character, parametro de periodo inicial para filtrar
@param cEndPeriod, character, parametro de periodo final para filtrar
@param cEvents, character, parametro com codigos de eventos
@param cProperty, character, nome da propriedade do Json a ser mapeada
@param cIdEvent, character, identificador do evento
@param cNumDoc, character, numero do documento fiscal
@param cTypAut, character, tipo do autor do evento
@return character, Retorna a clausula WHERE para filtragem
/*/
//-----------------------------------------------------------------------
Static Function getFilterEventsDocuments(cStatus as character, cStartPeriod as character, cEndPeriod as character, cEvents as character,;
										cProperty as character, cIdEvent as character, cNumDoc as character, cTypAut as character) as character

	Local cWhere := "" as character

   	Default cStatus 	 := ""
	Default cStartPeriod := ""
	Default cEndPeriod 	 := ""
	Default cEvents 	 := ""
	Default cProperty 	 := ""
	Default cNumDoc 	 := ""
	Default cIdEvent     := ""
	Default cTypAut      := ""

	cWhere := " T7A.T7A_FILIAL = '" + FwXFilial("T7A") + "'"

	Do Case
		Case cProperty == "items"
			If !Empty(cStatus)
				cWhere += " AND T7A.T7A_STATUS IN(" + cStatus + ")"
			EndIf

			If !Empty(cEvents)
				cWhere += " AND T7A.T7A_TPEVEN IN(" + cEvents + ")"
			EndIf

			If !Empty(cStartPeriod) .And. cStartPeriod != "undefined"
				cWhere += " AND C20.C20_DTDOC >= '" + cStartPeriod + "'"
			EndIf

			If !Empty(cEndPeriod) .And. cEndPeriod != "undefined"
				cWhere += " AND C20.C20_DTDOC <= '" + cEndPeriod + "'"
			EndIf
		Case cProperty == "detailItems"
			If !Empty(cStatus)
				cWhere += " AND T7A.T7A_STATUS IN(" + cStatus + ")"
			EndIf

			If !Empty(cEvents)
				cWhere += " AND T7A.T7A_TPEVEN IN(" + cEvents + ")"
			EndIf

			If !Empty(cNumDoc)
				cWhere += " AND T7A.T7A_NUMDOC = '" + cNumDoc + "'"
			EndIf

			If !Empty(cTypAut)
				cWhere += " AND T7A.T7A_TPAUT = '" + cTypAut + "'"
			EndIf
		Case cProperty == "subDetailItems"
			cWhere += " AND T7A.T7A_IDENT = '" + cIdEvent + "'"
	EndCase

	cWhere += " AND T7A.D_E_L_E_T_ = ' ' "

Return cWhere

//-----------------------------------------------------------------------
/*/{Protheus.doc} getOrderEventsDocuments
Funcao que retorna a ordenacao dos dados para a query

@type function
@version 1.0
@author Misael Ramos
@since 06/11/2025
@return character, Retorna a ordenacao dos dados para a query
/*/
//-----------------------------------------------------------------------
Static Function getOrderEventsDocuments() as character

	Local cOrder := "" as character

	cOrder := " T7A_FILIAL, T7A_NUMDOC "

Return cOrder
