#include "protheus.ch"
#include "tlpp-core.th"
#include "tlpp-object.th"
#include "totvs.protheus.fiscal.taf.xmlmonitorevent.ch"

namespace totvs.protheus.fiscal.taf.event

/*-------------------------------------------------------------------------------
{Protheus.doc} TAFXmlMonitorEvent
Classe responsável por gerar e enviar os XMLs dos eventos da reforma tributária

@type class
@author Evandro Italo
@since 29/10/2025
@version 1.0
-------------------------------------------------------------------------------*/
Class TAFXmlMonitorEvent

    public method New() 							as object
    public method TAFGetXmlMonitorEvent() 			as object
	public method TAFScheduleXmlMonitorEvent() 	    as object
    private method TAFEventsEnabledForSubmission() 	as character
    private method TafAssemblingXmlEvent() 			as character
    private method TAFEventWithoutItems() 			as character
    private method TAFEventItems() 					as character
    private method TAFEventItemsCredPresumido() 	as character
	private method TAFSaveLogsMonitorEvents()		
	protected method TafStatusMonitorEvents()		as character		
	protected method Conv2Dec(nNum as numeric)		as character

EndClass
/*-------------------------------------------------------------------------------
{Protheus.doc} New()
Método de instância da classe

@type method
@author Evandro Italo
@since 29/10/2025
@version 1.0
-------------------------------------------------------------------------------*/
method New() as object class TAFXmlMonitorEvent  
return Self
/*-------------------------------------------------------------------------------
{Protheus.doc} TafScheduleXmlMonitorEvent()
Metodo responsável por agendar a execução do monitor de eventos via Smart Schedule

@type method
@author Evandro Italo
@since 29/10/2025
@version 1.0
-------------------------------------------------------------------------------*/
method TafScheduleXmlMonitorEvent() as object class TAFXmlMonitorEvent
    Local cAmbiente:= "" as character

	TAFConout(STR0002,,, STR0001) 
	cAmbiente:= TafContScd()
	//As validaÃ§Ãµes referente ao Smart Schedule devem ser retiradas assim que estiver confirmado que todas as suas funcionalidades estarÃ£o disponÃ­vel
	//no rpo do ARTE para teste. Nesse momento esta em uso somente para controle interno.
	If !Empty(cAmbiente)
		If totvs.framework.schedule.utils.createTask(cAmbiente, /*cEmpAnt*/, /*cFilAnt*/, 'TAFA621EVT', 84, __cUserID, '', {}, .T.) != Nil
			TAFConout(STR0004,,, STR0001)
		EndIf
	Else
		TAFConout(STR0005,,, STR0001)	
	EndIf

return Self
/*-------------------------------------------------------------------------------
{Protheus.doc} TafScheduleXmlMonitorEvent()
Metodo responsável por verificar os eventos habilitados para envio e gerar o 
XML para cada um deles

@Parametro MV_TAFSURL - URL do serviço do TSS para envio dos eventos (TAF)

@type method
@author Evandro Italo
@since 29/10/2025
@version 1.0
-------------------------------------------------------------------------------*/
method TAFGetXmlMonitorEvent() as object class TAFXmlMonitorEvent
	Local aRetTss 		as array
    Local cAliasQry   	as character
	Local cXmlCreated 	as character
	Local cIdEvento   	as character
	Local cEventCode  	as character
	Local cChNFe      	as character
	Local cOrgaoAutor 	as character
	Local cTpAutor    	as character
	Local cIdEnti		as character
	Local lEventCancel 	as logical
	Local lHasItems   	as logical
	Local cUrl          as character
	Local cMsg      	as character
	Local cError    	as character
	Local cIdProcessamento  	as character
	local cRet       	as character

	//VariÃ¡veis para envio na funÃ§Ã£o do TSS
	cIdEnti	:= RetIdEnti()
	cUrl   := SuperGetMv("MV_SPEDURL",.F.,"")

	cAliasQry := ::TAFEventsEnabledForSubmission()
	If !Empty(cAliasQry)	
		While (cAliasQry)->(!eof()) 

			// mapeia campos retornados pela query
            cIdEvento  	:= (cAliasQry)->T7A_IDENT
            cEventCode 	:= (cAliasQry)->T7A_TPEVEN
            cChNFe     	:= alltrim((cAliasQry)->T7A_CHVELE)
			cTpAutor	:= AllTrim((cAliasQry)->T7A_TPAUT)
            cOrgaoAutor	:= Posicione("C09",3,xFilial("C09")+AllTrim((cAliasQry)->T7A_EST),"ALLTRIM(C09_CODIGO)")

			//Log inicial
			TAFConout( STR0006 + cEventCode + STR0007,,, STR0001) 
			
			//Conferindo se Ã© um evento de cancelamento
			if (cAliasQry)->T7A_CANC == "1"
				lEventCancel  	:= .T.
			Else
				lEventCancel  	:= .F.
			Endif
			If cTpAutor == "3"
				cTpAutor := "8" //Sucessora
			Endif

			//Conferindo se o evento tem itens.
			If (cAliasQry)->T7E_TEMITE == "1"
            	lHasItems  	:= .T.
			Else
				lHasItems  	:= .F.	
			Endif

            // chama TafAssemblingXmlEvent e captura o XML gerado 
            cXmlCreated := ::TafAssemblingXmlEvent( cIdEvento, cEventCode, cOrgaoAutor, cTpAutor, cChNFe, lHasItems, lEventCancel )

			If !Empty(cXmlCreated)
				TAFConout(STR0008,,, STR0001) 
				TafConout(cXmlCreated)
				TafConout(STR0009,,, STR0001)

				// envia o XML para o TSS, (função TSSEnvEven)   
				aRetTss := TSSEnvEven(@cError, cUrl, cIdEnti, cXmlCreated, @cMsg)

    			If Len(aRetTss) > 0
					cIdProcessamento := aRetTss[1]
				EndIf
				
				cRet :=::TafStatusMonitorEvents(cUrl, cIdEnti, cChNFe, cIdProcessamento, lEventCancel, cIdEvento)
				::TafSaveLogsMonitorEvents(cError, cRet, cMsg, cIdEvento, cXmlCreated)
				TAFConout(STR0010,,, STR0001)
				TAFConout(STR0013 + cChNFe + "-" + cRet,,, STR0001)
            Else
                TAFConout(STR0014 + cEventCode + STR0015,,, STR0001)
            Endif

			(cAliasQry)->(DbSkip())
		enddo
	Endif

return Self

/*-------------------------------------------------------------------------------

{Protheus.doc} TAFEventsEnabledForSubmission()
Metodo responsável por brucar os eventos habilitados para envio no TAF.

Os eventos habilitados para o envio são aqueles que estão com 
T7A.T7A_STATUS "1 - Solicitado" ou "3 - Sol. de cancelamento".


@type method
@author Evandro Italo
@since 29/10/2025
@version 1.0
-------------------------------------------------------------------------------*/
method TAFEventsEnabledForSubmission() as character class TAFXmlMonitorEvent
    Local cQueryEvents as character
	Local oQryEnabledEvents as object
	Local cAliasEvent as character

	cQueryEvents += " SELECT T7A.T7A_IDENT, T7A.T7A_TPEVEN, T7A.T7A_CHVELE, T7A.T7A_EST, T7A.T7A_TPAUT, T7A.T7A_CANC, T7E.T7E_TEMITE " 
	cQueryEvents += " FROM " + RetSqlName('T7A') + " T7A "
	cQueryEvents += " LEFT JOIN " + RetSqlName('T7E') + " T7E ON "
	cQueryEvents +=  FwJoinFilial("T7A","T7E") + " AND T7A.T7A_TPEVEN = T7E.T7E_EVENTO "
	cQueryEvents += " WHERE T7A.T7A_FILIAL = ? " 
	cQueryEvents += " AND T7A.T7A_STATUS IN (?) " 
	cQueryEvents += " AND T7A.D_E_L_E_T_ = ? "
	cQueryEvents := ChangeQuery(cQueryEvents)

	oQryEnabledEvents := FwExecStatement():New(cQueryEvents)

	oQryEnabledEvents:SetString(1, xFilial('T7A'))
	oQryEnabledEvents:SetIn(2, {'1', '3'})
	oQryEnabledEvents:SetString(3, '')
	cAliasEvent := oQryEnabledEvents:OpenAlias() 
	
return cAliasEvent

/*-------------------------------------------------------------------------------
{Protheus.doc} TafAssemblingXmlEvent()
Metodo responsável por montar o XML do evento conforme os dados informados.

@param cIdEvento - Identificador único do evento (UUID)
@param cEventCode - Código do evento
@param cOrgaoAutor - Código do órgão autorizador
@param cTpAutor - Tipo do autor do evento
@param cChNFe - Chave de acesso da NF-e
@param lHasItems - Indica se o evento possui itens
@param lEventCancel - Indica se o evento é de cancelamento

@type method
@author Evandro Italo
@since 29/10/2025
@version 1.0
-------------------------------------------------------------------------------*/
method TafAssemblingXmlEvent(cIdEvento as character, cEventCode as character, cOrgaoAutor as character,;
							 cTpAutor as character, cChNFe as character, lHasItems as logical, lEventCancel as logical) as character class TAFXmlMonitorEvent
								 
	Local cXmlDone                 as character
	Local cItemsXml                as character
	Local cEventWithoutItems       as character
	Local cEventItemsCredPresumido as character
	Local cQtde                    as character
	Local cUnidade                 as character
	Local cVIBS                    as character
	Local cVCBS                    as character
	Local cVBC                     as character
	Local cItemCredPres            as character
	Local cCCredPresIBS            as character
	Local cPCredPresIBS            as character
	Local cVCredPresIBS            as character
	Local cCCredPresCBS            as character
	Local cPCredPresCBS            as character
	Local cVCredPresCBS            as character
	Local cEventCancel			   as character
	Local cIndQuitacao             as character
	Local cIndAceitacao            as character
	Local cDPrevEntrega            as character
	Local cNProtEvento             as character
	Local cCurItem				   as character	
	Local cCodTri				   as character
	Local aCodTriIBS		   	   :=  {"000042", "000043", "000044", "000045", "000047", "000048","000049"}  as array
	Local aCodTribCBS	   	   	   := {"000031", "000032", "000039", "000040" , "000041"} as array
	Local oXmlEvent                as object
	Local lXmlDone                 as logical

	cEventCancel := "110001" // CÃ³digo do evento de cancelamento

	//Verifica se Ã© cancelamento de evento para alterar o modo de envio das informaÃ§Ãµes para o XML
	if lEventCancel
		oXmlEvent := SchemaXMLEvents():New(cOrgaoAutor, cTpAutor, cEventCancel, cChNFe)
	else
		oXmlEvent := SchemaXMLEvents():New(cOrgaoAutor, cTpAutor, cEventCode, cChNFe)
	endif

	//Monta o Header
	cXmlDone := oXmlEvent:SchemaXmlEventHeader()

	//Verifica Ã© um evento que contem itens.
	If lHasItems .and. !lEventCancel
        // caso crÃ©dito presumido (T7B) - mantÃ©m lÃ³gica atual
        If cEventCode == "211110"
            cEventItemsCredPresumido := ::TAFEventItemsCredPresumido(cIdEvento)
			// percorre agrupando por T7B_ITEM â€” cada grupo/chave Ã© um item que pode ter IBS e CBS
			While !(cEventItemsCredPresumido)->(Eof())
				// inÃ­cio do grupo do item
				
            	cItemCredPres := AllTrim((cEventItemsCredPresumido)->T7B_ITEM)
				cVBC := Alltrim(::Conv2Dec((cEventItemsCredPresumido)->T7B_VLBASE))
            	While (cEventItemsCredPresumido)->(!Eof()) .And. AllTrim((cEventItemsCredPresumido)->T7B_ITEM) == cItemCredPres
            	    cCodTri := AllTrim((cEventItemsCredPresumido)->T7B_CODTRI)
            	    If cCodTri == "000046"
            	        cCCredPresIBS := AllTrim(cValToChar((cEventItemsCredPresumido)->T7B_CODCRE))
            	        cPCredPresIBS := AllTrim(cValToChar((cEventItemsCredPresumido)->T7B_PERC))
						cVCredPresIBS := Alltrim(::Conv2Dec((cEventItemsCredPresumido)->T7B_VALOR))
            	    elseif cCodTri == "000033"
            	        cCCredPresCBS := AllTrim(cValToChar((cEventItemsCredPresumido)->T7B_CODCRE))
            	        cPCredPresCBS := AllTrim(cValToChar((cEventItemsCredPresumido)->T7B_PERC))
					    cVCredPresCBS := Alltrim(::Conv2Dec((cEventItemsCredPresumido)->T7B_VALOR))
            	    Endif
            	    (cEventItemsCredPresumido)->(DbSkip())
            	Enddo
            	// monta bloco Ãºnico para crÃ©dito presumido
            	cXmlDone += oXmlEvent:XmlEvent211110(cItemCredPres, cVBC, cCCredPresIBS, cPCredPresIBS, cVCredPresIBS, cCCredPresCBS, cPCredPresCBS, cVCredPresCBS)
            	lXmlDone := .T.
			Enddo
        Else
            // demais eventos com itens: obtÃ©m alias de itens (T7C)
            cItemsXml := ::TAFEventItems(cIdEvento)
            If !Empty(cItemsXml)
                // percorre agrupando por T7C_ITEM â€” cada grupo/chave Ã© um item que pode ter IBS e CBS
                While !(cItemsXml)->(Eof())
                    // inÃ­cio do grupo do item
                    cCurItem := AllTrim((cItemsXml)->T7C_ITEM)
                    cVIBS := ""
                    cVCBS := ""
                    cQtde := ""
                    cUnidade := ""

                    // agrupa todas as linhas do item atual
                    While !(cItemsXml)->(Eof()) .And. AllTrim((cItemsXml)->T7C_ITEM) == cCurItem
                        cCodTri := AllTrim((cItemsXml)->T7C_CODTRI)
                        If AScan(aCodTriIBS, cCodTri) > 0
							cVIBS := Alltrim(::Conv2Dec((cItemsXml)->T7C_VALOR))
                        Elseif AScan(aCodTribCBS, cCodTri) > 0
							cVCBS := Alltrim(::Conv2Dec((cItemsXml)->T7C_VALOR))
                        Endif
                        // quantidade/unidade podem repetir nas duas linhas, sobrescreve com o Ãºltimo lido
                        cQtde := AllTrim(cValToChar((cItemsXml)->T7C_QUANT))
                        cUnidade := Posicione("C1J",3,xFilial("C1J")+ALLTRIM((cItemsXml)->T7C_UM),"ALLTRIM(C1J_CODIGO)")
                        (cItemsXml)->(DbSkip())
                    Enddo

                    // chama mÃ©todo do evento UMA vez por item (fragmento)
                    Do case
                        Case cEventCode == "112120"
                            cXmlDone += oXmlEvent:XmlEvent112120(cCurItem, cVIBS, cVCBS, cQtde, cUnidade)
                            lXmlDone := .T.
                        Case cEventCode == "112130"
                            cXmlDone += oXmlEvent:XmlEvent112130(cCurItem, cVIBS, cVCBS, cQtde, cUnidade)
                            lXmlDone := .T.
                        Case cEventCode == "112140"
                            cXmlDone += oXmlEvent:XmlEvent112140(cCurItem, cVIBS, cVCBS, cQtde, cUnidade)
                            lXmlDone := .T.
                        Case cEventCode == "211120"
                            cXmlDone += oXmlEvent:XmlEvent211120(cCurItem, cVIBS, cVCBS, cQtde, cUnidade, cChNFe, cCurItem)
                            lXmlDone := .T.
                        Case cEventCode == "211124"
                            cXmlDone += oXmlEvent:XmlEvent211124(cCurItem, cVIBS, cVCBS, cQtde, cUnidade)
                            lXmlDone := .T.
                        Case cEventCode == "211130"
                            cXmlDone += oXmlEvent:XmlEvent211130(cCurItem, cVIBS, cVCBS, cQtde, cUnidade)
                            lXmlDone := .T.
                        Case cEventCode == "211140"
                            cXmlDone += oXmlEvent:XmlEvent211140(cCurItem, cVIBS, cVCBS, cQtde, cUnidade)
                            lXmlDone := .T.
                        Case cEventCode == "211150"
                            cXmlDone += oXmlEvent:XmlEvent211150(cCurItem, cVIBS, cVCBS)
                            lXmlDone := .T.
                    Endcase
                Enddo
			Endif
		Endif
	Else
		//Eventos que nÃ£o contem item.
		cEventWithoutItems := ::TAFEventWithoutItems(cIdEvento)
		If !Empty(cEventWithoutItems)
			// mapeia campos retornados pela query
			cIndQuitacao  	:= (cEventWithoutItems)->T7A_PGTO
			cIndAceitacao 	:= Iif((cEventWithoutItems)->T7A_INDACE == "2","0","1")
			cDPrevEntrega 	:=  SubStr((cEventWithoutItems)->T7A_DTPREV, 1, 4) + "-" + ;
    							SubStr((cEventWithoutItems)->T7A_DTPREV, 5, 2) + "-" + ;
    							SubStr((cEventWithoutItems)->T7A_DTPREV, 7, 2)
			cNProtEvento    := AllTrim((cEventWithoutItems)->T7A_PROT)

			If lEventCancel
					cXmlDone += oXmlEvent:XmlEvent110001(cEventCode, cNProtEvento)
					lXmlDone := .T.		
			Else	
				Do Case
					Case cEventCode == "112110"
						cXmlDone += oXmlEvent:XmlEvent112110(cIndQuitacao)
						lXmlDone := .T.
					Case cEventCode == "112150"
						cXmlDone += oXmlEvent:XmlEvent112150(cDPrevEntrega)
						lXmlDone := .T.
					Case cEventCode == "211128"
						cXmlDone += oXmlEvent:XmlEvent211128(cIndAceitacao)
						lXmlDone := .T.
					Case cEventCode == "212110"
						cXmlDone += oXmlEvent:XmlEvent212110(cIndAceitacao)
						lXmlDone := .T.
					Case cEventCode == "212120"
						cXmlDone += oXmlEvent:XmlEvent212120(cIndAceitacao)
						lXmlDone := .T.
					Otherwise
						TAFConout(STR0011 + cEventCode,,, STR0001)
						lXmlDone := .F. 
						cXmlDone := ""
				Endcase
			endif
		Endif
	Endif

	If lXmlDone
		cXmlDone += oXmlEvent:SchemaXmlEventFooter()
	Endif

return cXmlDone

/*-------------------------------------------------------------------------------
{Protheus.doc} TAFEventWithoutItems()
Metodo responsável por buscar os dados do evento que não possui itens.

@param cIdEvento - Identificador único do evento (UUID)

@type method
@author Evandro Italo
@since 29/10/2025
@version 1.0
-------------------------------------------------------------------------------*/
method TAFEventWithoutItems(cIdEvent as character) as character class TAFXmlMonitorEvent
    Local cQueryEventWithoutItems as character
	Local oQryEventWithoutItems as object
	Local cAliasEventWithoutItems as character

	cQueryEventWithoutItems += " SELECT T7A.T7A_PGTO, T7A.T7A_INDACE, T7A.T7A_DTPREV, T7A.T7A_PROT " 
	cQueryEventWithoutItems += " FROM " + RetSqlName('T7A') + " T7A "
	cQueryEventWithoutItems += " WHERE T7A.T7A_FILIAL = ? " 
	cQueryEventWithoutItems += " AND T7A.D_E_L_E_T_  = ? " 
	cQueryEventWithoutItems += " AND T7A.T7A_IDENT = ? "
	cQueryEventWithoutItems := ChangeQuery(cQueryEventWithoutItems)

	oQryEventWithoutItems := FwExecStatement():New(cQueryEventWithoutItems)

	oQryEventWithoutItems:SetString(1, xFilial('T7A'))
	oQryEventWithoutItems:SetString(2, '')
	oQryEventWithoutItems:SetString(3, cIdEvent)
	cAliasEventWithoutItems := oQryEventWithoutItems:OpenAlias()

return cAliasEventWithoutItems

/*-------------------------------------------------------------------------------
{Protheus.doc} TAFEventItems()
Metodo responsável por buscar os dados do evento que possui itens.

@param cIdEvento - Identificador único do evento (UUID)

@type method
@author Evandro Italo
@since 29/10/2025
@version 1.0
-------------------------------------------------------------------------------*/
method TAFEventItems(cIdEvent as character) as character class TAFXmlMonitorEvent
    Local cQueryEventsItems as character
	Local oQryEventsItems as object
	Local cAliasEventItems as character

	cQueryEventsItems += " SELECT  T7C.T7C_ITEM, T7C.T7C_CODTRI, T7C.T7C_QUANT, T7C.T7C_UM, T7C.T7C_VALOR, T7A.T7A_CHVELE " 
	cQueryEventsItems += " FROM " + RetSqlName('T7C') + " T7C "
	cQueryEventsItems += " LEFT JOIN " + RetSqlName('T7A') + " T7A ON T7A.T7A_FILIAL = T7C.T7C_FILIAL AND T7A.T7A_IDENT = T7C.T7C_IDENT "
	cQueryEventsItems += " WHERE T7C.T7C_FILIAL = ? " 
	cQueryEventsItems += " AND T7C.D_E_L_E_T_ = ? "
	cQueryEventsItems += " AND T7C.T7C_IDENT =  ? " 
	cQueryEventsItems := ChangeQuery(cQueryEventsItems)

	oQryEventsItems := FwExecStatement():New(cQueryEventsItems)

	oQryEventsItems:SetString(1, xFilial('T7A'))
	oQryEventsItems:SetString(2, '')
	oQryEventsItems:SetString(3, cIdEvent)
	cAliasEventItems := oQryEventsItems:OpenAlias()

return cAliasEventItems

/*-------------------------------------------------------------------------------
{Protheus.doc} TAFEventItems()
Metodo responsável por buscar os dados dos itens do evento de crédito presumido.

@param cIdEvento - Identificador único do evento (UUID)

@type method
@author Evandro Italo
@since 29/10/2025
@version 1.0
-------------------------------------------------------------------------------*/
method TAFEventItemsCredPresumido(cIdEvent as character) as character class TAFXmlMonitorEvent
    Local cQueryEventsCredPresumido as character
	Local oQryEventsCredPresumido as object
	Local cAliasEventCredPresumido as character

	cQueryEventsCredPresumido += " SELECT T7B.T7B_ITEM, T7B.T7B_CODTRI, T7B.T7B_VLBASE, T7B.T7B_CODCRE, T7B.T7B_PERC, T7B.T7B_VALOR " 
	cQueryEventsCredPresumido += " FROM " + RetSqlName('T7B') + " T7B "
	cQueryEventsCredPresumido += " WHERE T7B.T7B_FILIAL = ? "  
	cQueryEventsCredPresumido += " AND T7B.D_E_L_E_T_ = ? "
	cQueryEventsCredPresumido += " AND T7B.T7B_IDENT = ? "
	cQueryEventsCredPresumido := ChangeQuery(cQueryEventsCredPresumido)

	oQryEventsCredPresumido := FwExecStatement():New(cQueryEventsCredPresumido)

	oQryEventsCredPresumido:SetString(1, xFilial('T7B'))
	oQryEventsCredPresumido:SetString(2, '')
	oQryEventsCredPresumido:SetString(3, cIdEvent)
	cAliasEventCredPresumido := oQryEventsCredPresumido:OpenAlias()

return cAliasEventCredPresumido

/*-------------------------------------------------------------------------------
{Protheus.doc} TafStatusMonitorEvents()

@param cUrl - Url usada para comunicação com o TSS
@param cIdEnti - Id da entidade para comunicação com o TSS
@param cChNFe - Chave da nota fiscal
@param cIdProcessamento - Id do processamento retornado pelo TSS
@param lEventCancel - Indica se o evento é de cancelamento
@param cIdEvento - Identificador único do evento (UUID)

@type method
@author Pâmela Bernardo
@since 19/11/2025
@version 1.0
-------------------------------------------------------------------------------*/
method TafStatusMonitorEvents(cUrl as character, cIdEnti as character, cChNFe as character, ;
							cIdProcessamento as character, lEventCancel as logical, ;
							cIdEvento as character) as character class TAFXmlMonitorEvent
	Local oWS 				as object
	Local lRetorno	:= .F. 	as logical
	Local lContinua	:= .T. 	as logical
	Local aRetorno 	:= {} 	as array
	Local nX 		:= 0 	as numeric
	Local cStatus 	:= "5" 	as character
	Local cRetorno 	:= "" 	as character
	Local cProtocolo:= "" 	as character

	If !Empty(cIdProcessamento)
		While lContinua
			oWS:= WSNFeSBRA():New()
			oWS:cUSERTOKEN	:= "TOTVS"
			oWS:cID_ENT		:= cIdEnti
			oWS:_URL		:= AllTrim(cURL)+"/NFeSBRA.apw"
			oWS:cEvenChvNFE	:= cChNFe
			lRetorno := oWS:NFERETORNAEVENTO() .And. Valtype("oWS:oWsNfeRetornaEventoResult") <> "U" .And.Valtype("oWS:oWsNfeRetornaEventoResult:oWsNfeRetornaEvento") <> "U"
			If lRetorno
				aRetorno := oWS:oWsNfeRetornaEventoResult:oWsNfeRetornaEvento
				For nX :=1 to Len(aRetorno)
					If Alltrim(aRetorno[nX]["CID_EVENTO"]) == Alltrim(cIdProcessamento) .And. ;
						(!Empty(aRetorno[nX]["CXMOTIVO"]) .Or. !Empty(aRetorno[nX]["CXMOTIVOEVEN"]))
				
						lContinua := .F.
						cRetorno := Alltrim(aRetorno[nX]["CXMOTIVO"])
						cRetorno += " - "+Alltrim(aRetorno[nX]["CXMOTIVOEVEN"])
						cRetorno += " - "+cIdProcessamento
						If aRetorno[nX]["NSTATUS"] == 6
							If lEventCancel
								cStatus := "4"
							Else
								cStatus := "2"
							EndIf
							cProtocolo:= cValToChar(aRetorno[nX]["NPROT"])						 
						EndIf
					EndIf
				Next nX
				FreeObj(oWS)
			EndIf
		EndDo
	Else
		cRetorno := STR0020 //"Falha de conexão com o TSS - Id de processamento não retornado."
	EndIf

	DbSelectArea("T7A")
	T7A->(DbSetOrder(1))
	T7A->(DbGoTop())
	IF T7A->(MsSeek( FWxFilial("T7A") + cIdEvento ))
		RecLock("T7A", .F.)
			T7A->T7A_STATUS := cStatus
			IF !Empty(cProtocolo)
				T7A->T7A_PROT := cProtocolo
			Endif
		T7A->(MsUnLock())
	Endif

Return cRetorno

/*-------------------------------------------------------------------------------
{Protheus.doc} TafSaveLogsMonitorEvents()

@param cError - Mensagem de erro retornada pelo TSS
@param cResultadoProcessamento - Mensagem de retorno do processamento
@param cMsg - Mensagem completa retornada pelo TSS
@param cIdEvento - Identificador único do evento (UUID)
@param cXmlCreated - XML do evento enviado ao TSS
@type method
@author Evandro Italo
@since 29/10/2025
@version 1.0
-------------------------------------------------------------------------------*/
method TafSaveLogsMonitorEvents(cError as character, cResultadoProcessamento as character , cMsg as character,;
								 cIdEvento as character, cXmlCreated as character) class TAFXmlMonitorEvent

	Local dSendDate := Date()  as date
	Local cSendTime := Time()  as character	
	Local cDadoslog := " " as character	

	cDadoslog:= STR0021+IIF(!EMPTY(cError), STR0016 + cError + " - " + ; //"Retorno do Processamento: "
				cMsg, cResultadoProcessamento)+STR0022+cXmlCreated //" ---- XML Enviado ao TSS ---- "

	DbSelectArea("T7D")
	//Grava log na tabela T7D
	IF RecLock("T7D", .T.)
		T7D->T7D_FILIAL	:= xFilial("T7D")
		T7D->T7D_IDLOG	:= FwUUIDv4(.T.)
		T7D->T7D_IDENT	:= cIdEvento
		T7D->T7D_DATA	:= dSendDate
		T7D->T7D_HORA	:= cSendTime
		T7D->T7D_XMSG	:= cDadoslog
		T7D->(MsUnLock())
	ENDIF
Return 

/*-------------------------------------------------------------------------------
{Protheus.doc} Conv2Dec()

@param nNum - Valor que será convertido conforme manual da Sefaz

@type method
@author Carla Bianca
@since 21/11/2025
@version 1.0
-------------------------------------------------------------------------------*/

Method Conv2Dec(nNum as numeric) as character class TAFXmlMonitorEvent
    Local cNumFormat as character

    cNumFormat := Alltrim(Str(nNum, 15, 2))
    cNumFormat := StrTran(cNumFormat, ",", ".")

Return cNumFormat
