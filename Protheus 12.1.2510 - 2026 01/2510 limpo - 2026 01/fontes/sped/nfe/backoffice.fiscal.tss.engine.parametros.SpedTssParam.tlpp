#Include "PROTHEUS.ch"
#include "topconn.ch"
#INCLUDE "TOTVS.CH"
#Include "ApWebSrv.ch"
#include "fwmvcdef.ch"
#include 'tlpp-core.th'
#include 'tlpp-object.th'
#include "tlpp-rest.th"
#Include "backoffice.fiscal.tss.engine.parametros.spedtssparam.ch"

namespace backoffice.fiscal.tss.engine.parametros

Static cTitulo := STR0001 // Tela de Parâmetros TSS

/*/{Protheus.doc} SpedTssParam
Tela de parâmetros do TSS.
@type function
@version P12 V1.2510
@author Gabriel Jesus
@since 12/12/2025
/*/
Function SpedTssParam()
    Local aArea         := FWGetArea()

    Private cAliasTmp   := GetNextAlias()
    Private oBrowse     := Nil
    Private oTempTable  := CreateTempTable()
    Private aParams     := EnvReq()
    Private aRotina     := MenuDef()

    TempTable(aParams)

    oBrowse := CreateParamBrowse()
    oBrowse:Activate()

    oTempTable:Delete()
    FWRestArea(aArea)

Return

/*/{Protheus.doc} CreateTempTable
Cria tabela temporária para carregar a tela.
@type function
@version P12 V1.2510
@author Gabriel Jesus
@since 12/12/2025
/*/
Static Function CreateTempTable()
    Local aCampos := {}
    Local oTemp   := Nil

    aAdd(aCampos, {"TMP_LEG",  "C", 2, 0})
    aAdd(aCampos, {"TMP_ENT",  "C", 6, 0})
    aAdd(aCampos, {"TMP_PAR",  "C", 10, 0})
    aAdd(aCampos, {"TMP_DESC", "C",100, 0})
    aAdd(aCampos, {"TMP_CONT", "C", 15, 0})

    oTemp := FWTemporaryTable():New(cAliasTmp)
    oTemp:SetFields(aCampos)
    oTemp:AddIndex("1", {"TMP_LEG", "TMP_PAR"})
    oTemp:AddIndex("2", {"TMP_PAR"})
    oTemp:Create()

Return oTemp

/*/{Protheus.doc} TempTable
Carrega os dados na tabela temporária.
@type function
@version P12 V1.2510
@author Gabriel Jesus
@since 12/12/2025
@param aParams, array, Parâmetros para popular a tabela temporária com base no GET realizado.
/*/
Static Function TempTable(aParams)
    Local nX    := 0

    Default aParams := {}

    DbSelectArea(cAliasTmp)

    For nX := 1 To Len(aParams)
        RecLock(cAliasTmp, .T.)
            (cAliasTmp)->TMP_LEG  := aParams[nX]["editavel"]
            (cAliasTmp)->TMP_ENT  := aParams[nX]["entidade"]
            (cAliasTmp)->TMP_PAR  := aParams[nX]["nome"]
            (cAliasTmp)->TMP_DESC := aParams[nX]["descricao"]
            (cAliasTmp)->TMP_CONT := cValToChar(aParams[nX]["conteudo"])
        (cAliasTmp)->(MsUnlock())
    Next nX

Return

/*/{Protheus.doc} ClearTempTable
Limpa a tabela temporária para atualizar os registros.
@type function
@version P12 V1.2510
@author Gabriel Jesus
@since 12/12/2025
/*/
Static Function ClearTempTable()
    DbSelectArea(cAliasTmp)
    (cAliasTmp)->(DbGoTop())

    While !(cAliasTmp)->(Eof())
        RecLock(cAliasTmp, .F.)
            (cAliasTmp)->(DbDelete())
        (cAliasTmp)->(DbSkip())
    EndDo
Return

/*/{Protheus.doc} CreateParamBrowse
Cria colunas do browse.
@type function
@version P12 V1.2510
@author Gabriel Jesus
@since 12/12/2025
/*/
Static Function CreateParamBrowse()
    Local aColunas  := {}
    Local aPesquisa := {}

    aAdd(aColunas, {STR0014, "TMP_ENT",  "C", 6, 0, "@!"}) //"Entidade"                                                                                                   
    aAdd(aColunas, {STR0015, "TMP_PAR",  "C", 10, 0, "@!"}) //"parâmetro"
    aAdd(aColunas, {STR0016,  "TMP_CONT", "C", 15, 0, "@!"}) //"Conteudo"
    aAdd(aColunas, {STR0017, "TMP_DESC", "C",100, 0, "@!"}) //"Descrição"

    aAdd(aPesquisa, {STR0015, {{"","C",10,0,STR0015,"@!","TMP_PAR"}}})

    oBrowse := FWMBrowse():New()
    oBrowse:SetAlias(cAliasTmp)
    oBrowse:SetTemporary(.T.)
    oBrowse:SetFields(aColunas)
    oBrowse:DisableDetails()
    oBrowse:SetDescription(cTitulo)
    //oBrowse:setSmartX()
    oBrowse:SetSeek(.T., aPesquisa)
    oBrowse:AddLegend("AllTrim((cAliasTmp)->TMP_LEG) == '1'", "GREEN",   STR0012 ) //"Editavel" 
    oBrowse:AddLegend("AllTrim((cAliasTmp)->TMP_LEG) == '2'", "RED",     STR0013 ) //"Nao Editavel"

Return oBrowse

/*/{Protheus.doc} PostParam
Chama o parambox para inclusão ou alteração do registro.
@type function
@version P12 V1.2510
@author Gabriel Jesus
@since 12/12/2025
@param nOpc, numeric, 1 para inclusão, 2 para alteração.
/*/
Function PostParam(nOpc)
    Local aParamBox := {}
    Local aRet      := {}
    Local aParams   := {}

    Default nOpc := 0

    MontaParamBox(nOpc, @aParamBox)
    if ParamBox(aParamBox, STR0002, @aRet,,,,,,,,.F.) //"Edição/Inclusão parâmetros TSS"
        if validaParam(nOpc, aRet)
            Processa({|| EnvReq(aRet[1], aRet[2], nOpc)}, STR0003, STR0004, .F.) // Aguarde... Processando...
            
            aParams := EnvReq() // Repopula a tabela temporária apos inclusão/alteração

            if len(aParams) > 0
                ClearTempTable()
            
                TempTable(aParams)

                oBrowse:Refresh(.T.)
            endIf

            aParams     := aSize(aParams,0)
            aParamBox   := aSize(aParamBox,0)
            aRet        := aSize(aRet,0)
        endIf

    endIf

Return

/*/{Protheus.doc} EnvReq
Envia requisição para o serviço de parâmetros do TSS.
@type function
@version P12 V1.2510
@author Gabriel Jesus
@since 12/12/2025
@param cParam, character, Parâmetro a ser enviado.
@param cValor, character, Valor do parâmetro a ser enviado.
@param nOpc, numeric, Operação: 0-GET, 1-POST inclusão, 2-POST alteração.
/*/
Static Function EnvReq(cParam, cValor, nOpc)
    Local oJson     := JsonObject():New()
    Local oBody     := JsonObject():New()
    Local oRest     := Nil
    Local aHeader   := {"Content-Type: application/json; charset=UTF-8"}
    Local cPath     := ""
    Local cErro     := ""
    Local cStatus   := ""
    Local cUrlBase  := SuperGetMv("MV_TSSREST", .T., "")

    Default cParam := ""
    Default cValor := ""
    Default nOpc   := 0

    cEntidade := RetIdEnti()

    If !Empty(cUrlBase)
        if isConnTSS(@cErro)
            oRest     := FWRest():New(cUrlBase)

            If nOpc <> 0
                oBody["entidade"]  := cEntidade
                oBody["parametro"] := cParam
                oBody["conteudo"]  := cValor

                cPath := "/v1/nfe/tss/param/config"

                oRest:SetPath(cPath)
                oRest:SetPostParams(EncodeUTF8(oBody:ToJson()))
                oRest:POST(aHeader)

                oJson:FromJson(oRest:GetResult())
            Else
                cPath := "/v1/nfe/tss/param/" + cEntidade

                oRest:SetPath(cPath)
                oRest:Get(aHeader)

                oJson:FromJson(oRest:GetResult())

                If oJson <> Nil
                    Return oJson["parametros"]
                EndIf
            EndIf

            cErro   := oRest:GetLastError() 

            cStatus := Substr(cErro,1,3)

            If cStatus $ "400-403" .And. oJson <> Nil
                FWAlertError(decodeutf8(oJson["erros"],"iso8859-1"), STR0006) // "Atenção!"
            EndIf
        else
            FWAlertError(cErro, STR0006) //"Atenção!"
        endIf
    Else
        FWAlertError(STR0007, STR0006) //"O parâmetro MV_TSSREST não está configurado com a URL do REST do TSS."  //"Atenção!"
    EndIf

Return {}

/*/{Protheus.doc} MontaParamBox
Monta tela parambox
@type function
@version P12 V1.2510
@author Gabriel Jesus
@since 12/12/2025
@param nOpc, numeric, Operação: 1- inclusão, 2- alteração.
@param aParamBox, array, Array para montar o parambox.
/*/
Static Function MontaParamBox(nOpc, aParamBox)
    Default aParamBox   := {}
    Default nOpc        := 0

    If nOpc == 2
        aAdd(aParamBox,{1,STR0008,allTrim((cAliasTmp)->TMP_PAR),,".T.",,".F.",,.F.,.F.}) //"Parâmetro: "                                               
        aAdd(aParamBox,{1,STR0009,padr((cAliasTmp)->TMP_CONT, 250),,"",,"",70,.T.,.T.}) //"Novo Valor: "   
        aAdd(aParamBox,{1,STR0010,allTrim((cAliasTmp)->TMP_CONT),,".T.",,".F.",,.F.,.F.}) //"Valor atual: "
    Else 
        aAdd(aParamBox,{1,STR0011,Space(10),"","","","",0,.T.}) //"Novo Parâmetro: "  
        aAdd(aParamBox,{1,STR0009,Space(250),"","","","",70,.T.}) //"Novo Valor: "   
    EndIf
Return

/*/{Protheus.doc} MenuDef
Define as opções do menu.
@type function
@version P12 V1.2510
@author Gabriel Jesus
@since 12/12/2025
/*/
Static Function MenuDef()
    Local aRotina := {}
  
    //Adicionando opcoes do menu
    ADD OPTION aRotina TITLE STR0019 ACTION "backoffice.fiscal.tss.engine.parametros.PostParam(1)" OPERATION 6 ACCESS 0 //"Incluir Parâm. TSS"
    ADD OPTION aRotina TITLE STR0020 ACTION "backoffice.fiscal.tss.engine.parametros.PostParam(2)" OPERATION 7 ACCESS 0 //"Alterar Parâm. TSS"
  
Return aRotina

/*/{Protheus.doc} validaParam
Responsável por validar o registro antes da apresentação da tela de alteração de parametros.
@type function
@version P12 Release 12.1.2510
@author fs.martinez
@since 09/01/2026
@param nOpc, numeric, Opção de operação (1-Inclusão, 2-Alteração).
@return logical, retorna .T. se a validação for ok, .F. caso contrário.
/*/
static function validaParam(nOpc, aDados)
    local lRet      := .T. as logical
    local cParam    := "" as character

    if nOpc == 1 // Inclusão
        cParam := upper(allTrim(aDados[1]))
        if aScan(aParams, {|x| cParam == upper(allTrim(x["nome"]))}) > 0
            FWAlertError(STR0021 + CHR(10)+CHR(13) + STR0022, STR0006) //#STR0021-"Parâmetro já cadastrado!" ##STR0022-"Por favor, utilizar a opção alterar parâmetro."
            lRet := .F.
        endIf

    elseif nOpc == 2 // Alteração
        if allTrim((cAliasTmp)->TMP_LEG) == "2" //não editável
            FWAlertError(STR0018, STR0006) //#STR0018-"Este parâmetro não está habilitado para alteração por esta rotina." ##STR0006-"Atenção!"
            lRet := .F.
        endIf
    EndIf
return lRet
 