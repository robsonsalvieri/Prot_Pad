#INCLUDE "PROTHEUS.CH"

/*/{Protheus.doc} GPEM946
Função de menu para abrir o .app da gestão de cálculos
@author Leandro Drumond
@since 17/10/2025
/*/
Function GPEM946()
    
FwCallApp("gpem946") //Abre o app da Gestão de Cálculos

Return

/*/{Protheus.doc} Gpm946LoadPolling
Retorna a lista de tasks em execução em segundo plano e inclui uma nova, se fornecida
@author Leandro Drumond
@since 06/11/2025
/*/
Function Gpm946LoadPolling(cIdTask)
Local aListTask     := {}
Local nTasks        := 0

DEFAULT cIdTask     := ""

If VarSetUID( "GPEM946", .T. ) //Inicia global para controle de processamento em segundo plano 

    VarBeginT("GPEM946","aListTask")
	    VarGetA("GPEM946","aListTask",@aListTask)

        If !Empty(cIdTask)
            aAdd(aListTask, { cIdTask, .T., {} })
            VarSetA("GPEM946","aListTask",aListTask)
        EndIf			
		
	VarEndT("GPEM946","aListTask")

    //Elimina as globais criadas
    If Empty(cIdTask)
        //Verifica se todas as task's já foram finalizadas e elimina global
        aEval(aListTask, {|x| If(!x[2], nTasks++, Nil)})
        If nTasks == Len(aListTask)
            VarClean("GPEM946")
        EndIf
    EndIf
EndIf

Return aListTask

/*/{Protheus.doc} Gpm946Lock
Efetua lock lógico nos roteiros em execução pela API
@author Leandro Drumond
@since 06/11/2025
/*/
Function Gpm946Lock(cIdTask, cKeyRot)
Local aLockRot      := {}
Local lRet          := .T.

DEFAULT cIdTask     := ""

If VarSetUID( "GPEM946", .T. ) //Inicia global para controle de lock

    VarBeginT("GPEM946","aLockRot")
	    VarGetA("GPEM946","aLockRot",@aLockRot)

        If !Empty(aLockRot)
            If( aScan(aLockRot, {|x| x[2] == cKeyRot})) > 0
                lRet := .F.  //Roteiro em execução 
            EndIf 
        EndIf 

        If lRet 
            aAdd(aLockRot, { cIdTask, cKeyRot })
        EndIf
        
        VarSetA("GPEM946","aLockRot",aLockRot)
        
		
	VarEndT("GPEM946","aLockRot")

EndIf

Return lRet

/*/{Protheus.doc} Gpm946UnLock
Retira lock lógico nos roteiros em execução pela API após finalização
@author Leandro Drumond
@since 06/11/2025
/*/
Function Gpm946UnLock(cIdTask, cKeyRot, aLog)
Local nX            := 0
Local aLockRot      := {}
Local aLogAux       := {}
Local aListTask     := {}

DEFAULT cIdTask     := ""
DEFAULT cKeyRot     := ""
DEFAULT aLog        := {}

If VarSetUID( "GPEM946", .T. ) //Inicia global para controle de lock

    VarBeginT("GPEM946","aLockRot")
	    VarGetA("GPEM946","aLockRot",@aLogAux)

        For nX := 1 to Len(aLogAux)
            //Inclui no array apenas os processos diferentes dos passados no parametro
            If !Empty(cIdTask) .and. !Empty(aLogAux[nX,1]) .and. !(aLogAux[nX,1] == cIdTask)
                aAdd(aLockRot, aLogAux[nX])
            ElseIf !Empty(cKeyRot) .and. !(aLogAux[nX,2] == cKeyRot)
                aAdd(aLockRot, aLogAux[nX])
            EndIf
        Next nX
      
        VarSetA("GPEM946","aLockRot",aLockRot)        
		
	VarEndT("GPEM946","aLockRot")

    If !Empty(cIdTask) //Indica que task foi finalizada
        VarBeginT("GPEM946","aListTask")
            VarGetA("GPEM946","aListTask",@aListTask)

            If ( nPos := aScan(aListTask, {|x| x[1] == cIdTask}) ) > 0
                aListTask[nPos,2] := .F. //Indica que a task não esta mais ativa
                aListTask[nPos,3] := aClone(aLog)
            EndIf

            VarSetA("GPEM946","aListTask",aListTask)
            
        VarEndT("GPEM946","aListTask")
    EndIf
EndIf

Return Nil
