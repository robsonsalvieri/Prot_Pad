#Include "totvs.framework.treports.integratedprovider.th"
#Include "tlpp-core.th"
#Include "tlpp-rest.th"
#Include "rh.sv.gpe.gper086a.ch"

namespace totvs.protheus.rh.treportsintegratedprovider

/*/{Protheus.doc} GPER086TReportsBusinessObject:new()
    Classe do objeto de negócio do Relatório de Incidências por Funcionário.
    @type Class
    @version 12.1.2410
    @author guilherme.suttanni
    @since 25/09/2025
/*/
@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGAGPE", tables="SRA, RGB, SRV, SQB, CTT, RGC, RCO", customTables="SRA", name="Incidências por Funcionário", country="ALL", initialRelease="12.1.2310") // "Incidências por Funcionário"
Class GPER086TReportsBusinessObject From totvs.framework.treports.integratedprovider.IntegratedProvider
    // Define os métodos da classe
    Public Method new()            As Object
    Public Method getDescription() As Character
    Public Method getData()        As Object
    Public Method getSchema()      As Object

    @Get("/api/rh/smartview/v1/options/GPER086/:param")
    Public Method getComboBox()    As Variant
EndClass

/*/{Protheus.doc} GPER086TReportsBusinessObject:new()
    Instancia a classe do objeto de negócio.
    @type Method
    @version 12.1.2410
    @author guilherme.suttanni
    @since 25/09/2025
    @return Object, Instância do objeto de negócio
/*/
Method new() As Object Class GPER086TReportsBusinessObject
    _Super:new()

    self:appendArea(STR0001) // "RH"

    self:setDisplayName(STR0002) // "Incidências por Funcionário"
Return self

/*/{Protheus.doc} GPER086TReportsBusinessObject:getDescription()
    Retorna a descrição do objeto de negócio.
    @type Method
    @version 12.1.2410
    @author guilherme.suttanni
    @since 25/09/2025
    @return Character, Descrição do objeto de negócio
/*/
Method getDescription() As Character Class GPER086TReportsBusinessObject
Return STR0003 // "Relatório de Incidências por Funcionário"

/*/{Protheus.doc} GPER086TReportsBusinessObject:getData()
    Captura os dados do objeto de negócio.
    @type Method
    @version 12.1.2410
    @author guilherme.suttanni
    @since 25/09/2025
    @return Object, Dados do objeto de negócio
/*/
Method getData(nPage As Numeric, oFilter As Object) As Object Class GPER086TReportsBusinessObject
    Local cQuery                As Character // Query do relatório
    Local cAlias                As Character // Alias do arquivo temporário
    Local cFiltro               As Character // Filtro do objeto de negócio
    Local JParams               As JSON      // Parâmetros do objeto de negócio
    Local cFilDe                As Character // Filial de
    Local cFilAte               As Character // Filial até
    Local cCCde                 As Character // Centro de custo de
    Local cCCAte                As Character // Centro de custo até
    Local cDeptoDe              As Character // Departamento de
    Local cDeptoAte             As Character // Departamento até
    Local cMatDe                As Character // Matrícula de
    Local cMatAte               As Character // Matrícula até
    Local aSituacoes            As Array     // Situações
    Local aCategorias           As Array     // Categorias
    Local cProcesso             As Character // Processo
    Local cRoteiro              As Character // Roteiro
    Local cPeriodo              As Character // Período
    Local cPagamento            As Character // Pagamento
    Local aVerbas               As Array     // Verbas
    Local lSalario              As Logical   // Imprimir salário
    Local lImpEmpr              As Logical   // Imprimir total empresa
    Local cCodVisao             As Character // Código da visão
    Local cDepVisao             As Character // Departamento da visão
    Local nOrdem                As Numeric   // Ordem de impressão
    Local oStatement            As Object    // Objeto usado para utilização da classe FwExecStatement
    Local nParamOrder           As Numeric   // Contador de parâmetros da query
    Local jData                 As JSON      // Informações a serem adicionadas no ON
    Local cVerQuery             As Character // Query das verbas
    Local lAllVerbas            As Logical   // Se imprime todas as verbas
    Local cOrdem                As Character // Ordem da query
    Local cSitQuery             As Character // Query das situações
    Local cCatQuery             As Character // Query das categorias
    Local cSRVSRA               As Character // Join SRV x SRA
    Local nReg                  As Numeric   // Contador
    Local cCodPesq              As Character // Código de pesquisa
    Local nPosx                 As Numeric   // Posição
    Local aAuxCods              As Array     // Array auxiliar de códigos
    Local cFilialAnt            As Character // Filial do funcionário anterior
    Local cMatAnt               As Character // Matrícula do funcionário anterior
    Local jIncidence            As JSON      // Incidência
    Local jEmployee             As JSON      // Funcionário
    Local cFilExec              As Character // Filial de execução
    Local cEmpExec              As Character // Empresa de execução
    Local cOrderDesc            As Character // Descrição da ordem
    Local lUsaKeyLoc            As Logical   // Usa campo RA_KEYLOC
    Local lUsaRegPat            As Logical   // Usa campo RA_CODRPAT
    Local cCpoAdic              As Character // Campos adicionais
    Local cJoin                 As Character // Joins adicionais
    Local cNotDel               As Character // Filtros de exclusão
    Local cVerAnt               As Character // Verba anterior (para ordem 13)
    Local jPayroll              As JSON      // Verba (para ordem 13)
    Local jPayrollEmployee      As JSON      // Funcionário da verba (para ordem 13)
    Local lUsaArqui             As Logical   // Usa arquitetura organizacional
    Local aChaveArq             As Array     // Chave da arquitetura
    Local cChaveArq             As Character // Chave da arquitetura organizacional
    Local cOrgJoin              As Character // Join da arquitetura organizacional
    Local lShar                 As Logical   // Compartilhamento

    // Inicialização das variáveis locais
    cQuery          := ""
    cAlias          := ""
    cFiltro         := IIf(oFilter:hasFilter(), " AND " + oFilter:getSQLExpression(), "")
    jParams         := oFilter:getParameters()
    cFilDe          := ""
    cFilAte         := ""
    cCCde           := ""
    cCCAte          := ""
    cDeptoDe        := ""
    cDeptoAte       := ""
    cMatDe          := ""
    cMatAte         := ""
    aSituacoes      := {}
    aCategorias     := {}
    cProcesso       := ""
    cRoteiro        := ""
    cPeriodo        := ""
    cPagamento      := ""
    aVerbas         := {}
    lSalario        := .F.
    lImpEmpr        := .F.
    cCodVisao       := ""
    cDepVisao       := ""
    nOrdem          := 1
    oStatement      := NIL
    nParamOrder     := 1
    jData           := NIL
    cVerQuery       := ""
    lAllVerbas      := .F.
    cOrdem          := "RGB_PROCES, RA_FILIAL, RA_MAT, RGB_PD" //Matrícula + Incidências
    cSitQuery       := ""
    cCatQuery       := ""
    cSRVSRA         := FWJoinFilial("SRV", "SRA")
    nReg            := 0
    cCodPesq        := ""
    nPosx           := 0
    aAuxCods        := {}
    cFilialAnt      := ""
    cMatAnt         := ""
    jIncidence      := NIL
    jEmployee       := NIL
    cOrderDesc      := ""
    lUsaKeyLoc      := SRA->(FieldPos("RA_KEYLOC")) > 0
    lUsaRegPat      := SRA->(FieldPos("RA_CODRPAT")) > 0
    cCpoAdic        := ""
    cJoin           := ""
    cNotDel         := ""
    cFilExec        := AllTrim(FwFilialName())
    cEmpExec        := AllTrim(FwEmpName(cEmpAnt))
    cVerAnt         := ""
    jPayroll        := NIL
    jPayrollEmployee := NIL
    lUsaArqui       := SuperGetMv("MV_ORGCFG",,"0") != "0" // 0-Não utiliza 1-Utiliza Postos e Deptos 2-Utiliza só Deptos
    aChaveArq       := {"", ""}
    cChaveArq       := ""
    cOrgJoin        := ""
    lShar           := .T.

    BEGIN SEQUENCE

        // Captura o valor dos parâmetros
        If (jParams != NIL)
            cFilDe      := IIf(jParams:hasProperty("PAR_FILIALDE")      .and. Len(jParams["PAR_FILIALDE"])  > 0 .and.!Empty(jParams["PAR_FILIALDE"][1]),    jParams["PAR_FILIALDE"][1],     "")
            cFilAte     := IIf(jParams:hasProperty("PAR_FILIALATE")     .and. Len(jParams["PAR_FILIALATE"]) > 0 .and.!Empty(jParams["PAR_FILIALATE"][1]),   jParams["PAR_FILIALATE"][1],    Replicate("Z", GetSX3Cache("RA_FILIAL", "X3_TAMANHO")))
            cCCde       := IIf(jParams:hasProperty("PAR_CCDE")          .and. Len(jParams["PAR_CCDE"])      > 0 .and.!Empty(jParams["PAR_CCDE"][1]),        jParams["PAR_CCDE"][1],         "")
            cCCAte      := IIf(jParams:hasProperty("PAR_CCATE")         .and. Len(jParams["PAR_CCATE"])     > 0 .and.!Empty(jParams["PAR_CCATE"][1]),       jParams["PAR_CCATE"][1],        Replicate("Z", GetSX3Cache("RA_CC", "X3_TAMANHO")))
            cDeptoDe    := IIf(jParams:hasProperty("PAR_DEPTODE")       .and. Len(jParams["PAR_DEPTODE"])   > 0 .and.!Empty(jParams["PAR_DEPTODE"][1]),     jParams["PAR_DEPTODE"][1],      "")
            cDeptoAte   := IIf(jParams:hasProperty("PAR_DEPTOATE")      .and. Len(jParams["PAR_DEPTOATE"])  > 0 .and.!Empty(jParams["PAR_DEPTOATE"][1]),    jParams["PAR_DEPTOATE"][1],     Replicate("Z", GetSX3Cache("RA_DEPTO", "X3_TAMANHO")))
            cMatDe      := IIf(jParams:hasProperty("PAR_MATDE")         .and. Len(jParams["PAR_MATDE"])     > 0 .and.!Empty(jParams["PAR_MATDE"][1]),       jParams["PAR_MATDE"][1],        "")
            cMatAte     := IIf(jParams:hasProperty("PAR_MATATE")        .and. Len(jParams["PAR_MATATE"])    > 0 .and.!Empty(jParams["PAR_MATATE"][1]),      jParams["PAR_MATATE"][1],       Replicate("Z", GetSX3Cache("RA_MAT", "X3_TAMANHO")))
            aSituacoes  := IIf(jParams:hasProperty("PAR_SIT"),          jParams["PAR_SIT"], {})
            aCategorias := IIf(jParams:hasProperty("PAR_CAT"),          jParams["PAR_CAT"], {})
            cProcesso   := IIf(jParams:hasProperty("PAR_PROCESSO")      .and. Len(jParams["PAR_PROCESSO"])  > 0 .and.!Empty(jParams["PAR_PROCESSO"][1]),    jParams["PAR_PROCESSO"][1],     "")
            cRoteiro    := IIf(jParams:hasProperty("PAR_ROTEIRO")       .and. Len(jParams["PAR_ROTEIRO"])   > 0 .and.!Empty(jParams["PAR_ROTEIRO"][1]),     jParams["PAR_ROTEIRO"][1],      "")
            cPeriodo    := IIf(jParams:hasProperty("PAR_PERIODO")       .and. Len(jParams["PAR_PERIODO"])   > 0 .and.!Empty(jParams["PAR_PERIODO"][1]),     jParams["PAR_PERIODO"][1],      "")
            cPagamento  := IIf(jParams:hasProperty("PAR_PAGAMENTO")     .and. Len(jParams["PAR_PAGAMENTO"]) > 0 .and.!Empty(jParams["PAR_PAGAMENTO"][1]),   jParams["PAR_PAGAMENTO"][1],    "")
            aVerbas     := IIf(jParams:hasProperty("PAR_VERBAS"),       jParams["PAR_VERBAS"], {}) // Array de verbas para filtro
            lSalario    := IIf(jParams:hasProperty("PAR_SALARIO")       .and. Len(jParams["PAR_SALARIO"])   > 0 .and.!Empty(jParams["PAR_SALARIO"][1]),     jParams["PAR_SALARIO"][1] == "1", .F.)
            lImpEmpr    := IIf(jParams:hasProperty("PAR_TOTALEMP")      .and. Len(jParams["PAR_TOTALEMP"])  > 0 .and.!Empty(jParams["PAR_TOTALEMP"][1]),    jParams["PAR_TOTALEMP"][1] == "1", .F.)
            cCodVisao   := IIf(jParams:hasProperty("PAR_CODVISAO")      .and. Len(jParams["PAR_CODVISAO"])  > 0 .and.!Empty(jParams["PAR_CODVISAO"][1]),    jParams["PAR_CODVISAO"][1],     "")
            cDepVisao   := IIf(jParams:hasProperty("PAR_DEPVISAO")      .and. Len(jParams["PAR_DEPVISAO"])  > 0 .and.!Empty(jParams["PAR_DEPVISAO"][1]),    jParams["PAR_DEPVISAO"][1],     "")
            nOrdem      := IIf(jParams:hasProperty("PAR_ORDEM")         .and. Len(jParams["PAR_ORDEM"])     > 0 .and.!Empty(jParams["PAR_ORDEM"][1]),       Val(jParams["PAR_ORDEM"][1]),   1)
        EndIf

        // Verifica se os parâmetros obrigatórios foram preenchidos
        If (Empty(cProcesso) .or. Empty(cRoteiro) .or. Empty(cPeriodo))
            self:setErrorStatus(400, STR0004, STR0005) // "Atenção" | "Os parâmetros Processo, Roteiro e Período são obrigatórios."
            FwLogMsg("WARN", NIL, "SmartView", NIL, NIL, NIL, STR0005)
            BREAK
        EndIf

        // Verifica campos disponíveis e ajusta ordem se necessário
        If !lUsaKeyLoc .And. (nOrdem == 9 .Or. nOrdem == 10)
            nOrdem := 1 // Muda para matrícula se não tem RA_KEYLOC
        EndIf

        // Define a ordem da query baseada na seleção
        Do Case
            Case nOrdem == 1 // Matrícula + Incidências
                cOrdem := "RGB_PROCES, RA_FILIAL, RA_MAT, RGB_PD"
                cOrderDesc := "Matrícula"
                
            Case nOrdem == 2 // Nome + Incidências  
                cOrdem := "RGB_PROCES, RA_FILIAL, RA_NOME, RA_MAT, RGB_PD"
                cOrderDesc := "Nome"
                
            Case nOrdem == 3 // C.Custo + Matrícula + Incidências
                cOrdem := "RGB_PROCES, RA_FILIAL, RGB_CC, RA_MAT, RGB_PD"
                cOrderDesc := "C.Custo + Matrícula"
                
            Case nOrdem == 4 // C.Custo + Nome + Incidências
                cOrdem := "RGB_PROCES, RA_FILIAL, RGB_CC, RA_NOME, RA_MAT, RGB_PD"
                cOrderDesc := "C.Custo + Nome"

            Case nOrdem == 5 // Depto + Matrícula + Incidências
                cOrdem := "RGB_PROCES, RA_FILIAL, RA_DEPTO, RA_MAT, RGB_PD"
                cOrderDesc := "Depto + Matrícula"

            Case nOrdem == 6 // Depto + Nome + Incidências
                cOrdem := "RGB_PROCES, RA_FILIAL, RA_DEPTO, RA_NOME, RA_MAT, RGB_PD"
                cOrderDesc := "Depto + Nome"

            Case nOrdem == 7 // C.Custo + Depto + Matrícula + Incidências
                cOrdem := "RGB_PROCES, RA_FILIAL, RGB_CC, RA_DEPTO, RA_MAT, RGB_PD"
                cOrderDesc := "C.Custo + Depto + Matrícula"
                
            Case nOrdem == 8 // C.Custo + Depto + Nome + Incidências
                cOrdem := "RGB_PROCES, RA_FILIAL, RGB_CC, RA_DEPTO, RA_NOME, RGB_PD"
                cOrderDesc := "C.Custo + Depto + Nome"
                
            Case nOrdem == 9 .And. lUsaKeyLoc // Loc.Pago + Matrícula + Incidências
                cOrdem := "RGB_PROCES, RA_FILIAL, RA_KEYLOC, RA_MAT, RGB_PD"
                cOrderDesc := IIf(cPaisLoc $ "COL", "Centro Trab.", "Loc.Pago") + " + Matrícula"
                
            Case nOrdem == 10 .And. lUsaKeyLoc // Loc.Pago + Nome + Incidências
                cOrdem := "RGB_PROCES, RA_FILIAL, RA_KEYLOC, RA_NOME, RGB_PD"
                cOrderDesc := IIf(cPaisLoc $ "COL", "Centro Trab.", "Loc.Pago") + " + Nome"
                
            Case nOrdem == 13 // Verba + Incidências
                cOrdem := "RGB_PROCES, RGB_FILIAL, RGB_PD, RGB_MAT"
                cOrderDesc := "Verba"
        EndCase

        // Verifica verbas selecionadas - máximo de 10 verbas
        lAllVerbas := .F.
        If Len(aVerbas) > 0
            // Valida se não foram selecionadas mais de 10 verbas
            If Len(aVerbas) > 10
                self:setErrorStatus(400, STR0004, STR0006) // "Atenção" | "É permitido selecionar no máximo 10 verbas."
                FwLogMsg("WARN", NIL, "SmartView", NIL, NIL, NIL, STR0006)
                BREAK
            EndIf
        Else
            lAllVerbas := .T.
        EndIf

        // Processa verbas se não for todas
        cVerQuery := ""
        If !lAllVerbas
            // Remove duplicatas das verbas
            For nReg := 1 to Len(aVerbas)
                cCodPesq := PadR(aVerbas[nReg], 3)
                nPosx := aScan(aAuxCods, {|x| x == cCodPesq})
                If nPosx == 0
                    aAdd(aAuxCods, cCodPesq)
                EndIf
            Next nReg
            
            // Monta query das verbas
            For nReg := 1 to Len(aAuxCods)
                cVerQuery += "'" + aAuxCods[nReg] + "'"
                If (nReg + 1) <= Len(aAuxCods)
                    cVerQuery += ","
                Endif
            Next nReg
        EndIf

        // Define campos adicionais e joins baseado na ordem escolhida
        cCpoAdic := ""
        cJoin := ""
        cNotDel := ""

        // Define campos adicionais e joins baseado na ordem escolhida
        cCpoAdic := ""
        cJoin := ""
        cNotDel := ""

        Do Case
            Case nOrdem == 3 .Or. nOrdem == 4 .Or. nOrdem == 7 .Or. nOrdem == 8 // Centro de Custo
                cCpoAdic := ", RGB.RGB_CC, CTT.CTT_FILIAL, CTT.CTT_CUSTO"
                cJoin := " INNER JOIN " + RetSqlName("CTT") + " CTT ON " + FWJoinFilial("CTT", "RGB") + " AND RGB.RGB_CC = CTT.CTT_CUSTO"
                cNotDel := " AND CTT.D_E_L_E_T_ = ' '"
                
                If nOrdem == 7 .Or. nOrdem == 8
                    cCpoAdic += ", SQB.QB_FILIAL, SQB.QB_CC, SQB.QB_DEPTO, SQB.QB_DESCRIC"
                    cJoin += " INNER JOIN " + RetSqlName("SQB") + " SQB ON SRA.RA_DEPTO = SQB.QB_DEPTO AND " + FWJoinFilial("SQB", "SRA")
                    cNotDel += " AND SQB.D_E_L_E_T_ = ' '"
                EndIf
                
            Case nOrdem == 5 .Or. nOrdem == 6 // Departamento
                cCpoAdic := ", SQB.QB_FILIAL, SQB.QB_DEPTO, SQB.QB_DESCRIC"
                cJoin := " INNER JOIN " + RetSqlName("SQB") + " SQB ON SRA.RA_DEPTO = SQB.QB_DEPTO AND " + FWJoinFilial("SQB", "SRA")
                cNotDel := " AND SQB.D_E_L_E_T_ = ' '"
                
            Case nOrdem == 9 .Or. nOrdem == 10 // Localidade de Pagamento
                If lUsaKeyLoc
                    cCpoAdic := ", SRA.RA_KEYLOC, RGC.RGC_FILIAL, RGC.RGC_KEYLOC, RGC.RGC_DESLOC"
                    cJoin := " INNER JOIN " + RetSqlName("RGC") + " RGC ON " + FWJoinFilial("RGC", "SRA") + " AND SRA.RA_KEYLOC = RGC.RGC_KEYLOC"
                    cNotDel := " AND RGC.D_E_L_E_T_ = ' '"
                EndIf
        EndCase

        // Implementa Arquitetura Organizacional se configurada
        If lUsaArqui .And. !Empty(cCodVisao) .And. !Empty(cDepVisao)
            aChaveArq := fQueryVisao(cCodVisao, cDepVisao)
            cChaveArq := aChaveArq[2]
            lShar     := Empty(aChaveArq[1])
            
            cOrgJoin := " INNER JOIN (SELECT RD4.RD4_FILIDE, RD4.RD4_CODIDE, RD4.RD4_CHAVE "
            cOrgJoin += " FROM " + RetSqlName("RD4") + " RD4 "
            
            cOrgJoin += " WHERE RD4_CODIDE >= ? AND RD4.D_E_L_E_T_ = ? ) TVRD4 "
            
            cOrgJoin += " ON SRA.RA_DEPTO = TVRD4.RD4_CODIDE "
            If !lShar
                cOrgJoin += " AND SRA.RA_FILIAL = TVRD4.RD4_FILIDE "
            EndIf
        EndIf

        // Montagem da query de busca
        cQuery := "SELECT "
        cQuery += "    SRA.RA_FILIAL, "
        cQuery += "    SRA.RA_MAT, "
        cQuery += "    SRA.RA_CC, "
        cQuery += "    SRA.RA_NOME, "
        cQuery += "    SRA.RA_DEPTO, "
        cQuery += "    SRA.RA_HRSMES, "
        cQuery += "    SRA.RA_SALARIO, "
        cQuery += "    RGB.RGB_FILIAL, "
        cQuery += "    RGB.RGB_MAT, "
        cQuery += "    RGB.RGB_PROCES, "
        cQuery += "    RGB.RGB_PERIOD, "
        cQuery += "    RGB.RGB_SEMANA, "
        cQuery += "    RGB.RGB_ROTEIR, "
        cQuery += "    RGB.RGB_PD, "
        cQuery += "    RGB.RGB_VALOR, "
        cQuery += "    RGB.RGB_HORAS, "
        cQuery += "    RGB.RGB_TIPO1, "
        cQuery += "    SRV.RV_TIPO, "
        cQuery += "    SRV.RV_TIPOCOD, "
        cQuery += "    SRV.RV_DESC"
        cQuery += cCpoAdic
        cQuery += " FROM " + RetSqlName("SRA") + " SRA"
        cQuery += " INNER JOIN " + RetSqlName("RGB") + " RGB ON SRA.RA_FILIAL = RGB.RGB_FILIAL AND SRA.RA_MAT = RGB.RGB_MAT"
        cQuery += " INNER JOIN " + RetSqlName("SRV") + " SRV ON " + FWJoinFilial("SRV", "SRA") + " AND SRV.RV_TIPOCOD IN (?,?) AND SRV.RV_COD = RGB.RGB_PD"
        cQuery += cJoin

        // Adiciona join da arquitetura organizacional se necessário
        If !Empty(cOrgJoin)
            cQuery += cOrgJoin
        EndIf

        cQuery += " WHERE SRA.RA_FILIAL BETWEEN ? AND ?"
        cQuery += "   AND SRA.RA_MAT BETWEEN ? AND ?"
        cQuery += "   AND SRA.RA_CC BETWEEN ? AND ?"
        cQuery += "   AND SRA.RA_DEPTO BETWEEN ? AND ?"
        
        // Adiciona filtro de situação com parâmetros individuais
        If Len(aSituacoes) > 0
            cQuery += "   AND SRA.RA_SITFOLH IN (?) "
        EndIf
        
        // Adiciona filtro de categoria com parâmetros individuais
        If Len(aCategorias) > 0
            cQuery += "   AND SRA.RA_CATFUNC IN (?) "
        EndIf
        
        cQuery += "   AND RGB.RGB_PROCES = ?"
        cQuery += "   AND RGB.RGB_ROTEIR = ?"
        cQuery += "   AND RGB.RGB_PERIOD = ?"
        If !Empty(cPagamento)
            cQuery += "   AND RGB.RGB_SEMANA = ?" 
        EndIf
        
        // Adiciona filtro de verbas com parâmetros individuais
        If !lAllVerbas .And. Len(aAuxCods) > 0
            cQuery += "   AND RGB.RGB_PD IN (?) "
        EndIf
        
        cQuery += cFiltro
        cQuery += "   AND SRA.D_E_L_E_T_ = ?"
        cQuery += "   AND RGB.D_E_L_E_T_ = ?"
        cQuery += "   AND SRV.D_E_L_E_T_ = ?"
        cQuery += cNotDel
        cQuery += " ORDER BY " + cOrdem

        cQuery := ChangeQuery(cQuery)

        // Instancia a classe
        oStatement := FwExecStatement():New(cQuery)

        // Define o valor dos bind parameters
        oStatement:SetString(nParamOrder++, "1")        // RV_TIPOCOD primeiro valor
        oStatement:SetString(nParamOrder++, "2")        // RV_TIPOCOD segundo valor
        oStatement:SetString(nParamOrder++, cFilDe)
        oStatement:SetString(nParamOrder++, cFilAte)
        oStatement:SetString(nParamOrder++, cMatDe)
        oStatement:SetString(nParamOrder++, cMatAte)
        oStatement:SetString(nParamOrder++, cCCde)
        oStatement:SetString(nParamOrder++, cCCAte)
        oStatement:SetString(nParamOrder++, cDeptoDe)
        oStatement:SetString(nParamOrder++, cDeptoAte)
        
        // Adiciona parâmetros das situações
        If Len(aSituacoes) > 0
            oStatement:SetIN(nParamOrder++, aSituacoes)
        EndIf
        
        // Adiciona parâmetros das categorias
        If Len(aCategorias) > 0
            oStatement:SetIN(nParamOrder++, aCategorias)
        EndIf
        
        // Adiciona parâmetros da arquitetura organizacional se usada
        If lUsaArqui .And. !Empty(cCodVisao) .And. !Empty(cDepVisao)
            oStatement:SetString(nParamOrder++, cDepVisao)  // RD4_CODIDE
            oStatement:SetString(nParamOrder++, " ")        // RD4.D_E_L_E_T_
        EndIf
        
        oStatement:SetString(nParamOrder++, cProcesso)
        oStatement:SetString(nParamOrder++, cRoteiro)
        oStatement:SetString(nParamOrder++, cPeriodo)
        
        If !Empty(cPagamento)
            oStatement:SetString(nParamOrder++, cPagamento)
        EndIf
        
        // Adiciona parâmetros das verbas
        If !lAllVerbas .And. Len(aAuxCods) > 0
            oStatement:SetIN(nParamOrder++, aAuxCods)
        EndIf
        
        oStatement:SetString(nParamOrder++, " ")        // SRA.D_E_L_E_T_
        oStatement:SetString(nParamOrder++, " ")        // RGB.D_E_L_E_T_
        oStatement:SetString(nParamOrder++, " ")        // SRV.D_E_L_E_T_

        // Executa a query e retorna o alias criado
        cAlias := oStatement:OpenAlias()

        jData := JSONObject():New()
        jData["FilialExec"] := RTrim(cFilExec)                      // Filial de execução
        jData["EmpresaExec"] := RTrim(cEmpExec)                     // Empresa de execução
        jData["Process"] := cProcesso      // "Processo"
        jData["Period"] := cPeriodo        // "Período"
        jData["Payment"] := cPagamento     // "Pagamento"
        jData["Script"] := cRoteiro        // "Roteiro"
        jData["PrintSalary"] := lSalario   // "Imprimir Salário"
        jData["PrintCompanyTotal"] := lImpEmpr // "Imprimir Total Empresa"
        jData["Order"] := cOrderDesc       // Descrição da ordem selecionada
        jData["Incidences"] := {}          // "Incidências"
        jData["PayrollIncidences"] := {}   // "Incidências por Verba" (nova propriedade)

        // Verifica se é ordem por verba
        If nOrdem == 13 // Verba + Incidências
            
            While (!(cAlias)->(EOF()))
                
                // Verifica se mudou verba
                If cVerAnt != (cAlias)->RGB_PD
                    
                    // Se não é a primeira, adiciona a verba anterior
                    If !Empty(cVerAnt)
                        AAdd(jData["PayrollIncidences"], jPayroll)
                    EndIf
                    
                    // Reinicia variáveis
                    cVerAnt := (cAlias)->RGB_PD
                    
                    // Cria nova verba
                    jPayroll := JSONObject():New()
                    jPayroll["PayrollCode"] := AllTrim((cAlias)->RGB_PD)                  // "Código Verba"
                    jPayroll["Description"] := AllTrim((cAlias)->RV_DESC)                 // "Descrição"
                    jPayroll["Type"] := (cAlias)->RV_TIPO                                 // "Tipo"
                    jPayroll["TypeCode"] := (cAlias)->RV_TIPOCOD                          // "Tipo Código"
                    jPayroll["Employees"] := {}                                           // "Funcionários" - Array
                EndIf
                
                // Adiciona funcionário da verba
                jPayrollEmployee := JSONObject():New()
                jPayrollEmployee["BranchCode"] := AllTrim((cAlias)->RA_FILIAL)          // "Filial"
                jPayrollEmployee["EmployeeCode"] := AllTrim((cAlias)->RA_MAT)           // "Matrícula"
                jPayrollEmployee["EmployeeName"] := AllTrim((cAlias)->RA_NOME)          // "Nome"
                jPayrollEmployee["CostCenter"] := AllTrim((cAlias)->RA_CC)              // "Centro de Custo"
                jPayrollEmployee["Department"] := AllTrim((cAlias)->RA_DEPTO)           // "Departamento"
                jPayrollEmployee["MonthlyHours"] := (cAlias)->RA_HRSMES                 // "Horas Mensais"
                jPayrollEmployee["Salary"] := (cAlias)->RA_SALARIO                      // "Salário"
                
                // Campos específicos baseados no tipo da verba
                jPayrollEmployee["Hours"] := IIf((cAlias)->RV_TIPO == "H", (cAlias)->RGB_HORAS, 0)        // "Horas"
                jPayrollEmployee["Days"] := IIf((cAlias)->RV_TIPO == "D", (cAlias)->RGB_HORAS, 0)         // "Dias"
                jPayrollEmployee["Reference"] := IIf((cAlias)->RV_TIPO != "H" .And. (cAlias)->RV_TIPO != "D", (cAlias)->RGB_HORAS, 0) // "Referência"
                jPayrollEmployee["Earnings"] := IIf((cAlias)->RV_TIPOCOD == "1", (cAlias)->RGB_VALOR, 0)  // "Proventos"
                jPayrollEmployee["Deductions"] := IIf((cAlias)->RV_TIPOCOD == "2", (cAlias)->RGB_VALOR, 0) // "Descontos"
                jPayrollEmployee["PayrollType"] := (cAlias)->RV_TIPOCOD                 // "Tipo da Verba" (1=Provento, 2=Desconto)
                jPayrollEmployee["PayrollCategory"] := (cAlias)->RV_TIPO                // "Categoria da Verba" (H=Horas, D=Dias, etc)
                
                // Adiciona o funcionário ao array Employees da verba
                AAdd(jPayroll["Employees"], jPayrollEmployee)
                
                (cAlias)->(DBSkip())
            End
            
            // Adiciona a última verba se existir
            If !Empty(cVerAnt)
                AAdd(jData["PayrollIncidences"], jPayroll)
            EndIf
            
        Else
            // Lógica original para outras ordens
            While (!(cAlias)->(EOF()))
                
                // Verifica se mudou funcionário
                If (cFilialAnt + cMatAnt) != ((cAlias)->RA_FILIAL + (cAlias)->RA_MAT)
                    
                    // Se não é o primeiro, adiciona o funcionário anterior
                    If !Empty(cMatAnt)
                        AAdd(jData["Incidences"], jEmployee)
                    EndIf
                    
                    // Reinicia variáveis
                    cFilialAnt := (cAlias)->RA_FILIAL
                    cMatAnt := (cAlias)->RA_MAT
                    
                    // Cria novo funcionário
                    jEmployee := JSONObject():New()
                    jEmployee["BranchCode"] := AllTrim((cAlias)->RA_FILIAL)              // "Filial"
                    jEmployee["EmployeeCode"] := AllTrim((cAlias)->RA_MAT)               // "Matrícula"
                    jEmployee["EmployeeName"] := AllTrim((cAlias)->RA_NOME)              // "Nome"
                    jEmployee["CostCenter"] := AllTrim((cAlias)->RA_CC)                  // "Centro de Custo"
                    jEmployee["Department"] := AllTrim((cAlias)->RA_DEPTO)               // "Departamento"
                    jEmployee["MonthlyHours"] := (cAlias)->RA_HRSMES                     // "Horas Mensais"
                    jEmployee["Salary"] := (cAlias)->RA_SALARIO                          // "Salário"
                    jEmployee["Items"] := {}                                             // "Itens" - Array vazio
                EndIf
                
                // Adiciona item de incidência
                jIncidence := JSONObject():New()
                jIncidence["PayrollCode"] := AllTrim((cAlias)->RGB_PD)                    // "Código Verba"
                jIncidence["Description"] := AllTrim((cAlias)->RV_DESC)                   // "Descrição"
                jIncidence["Hours"] := (cAlias)->RGB_HORAS                                // "Horas"
                jIncidence["Value"] := (cAlias)->RGB_VALOR                                // "Valor"
                jIncidence["Type"] := (cAlias)->RV_TIPO                                   // "Tipo"
                jIncidence["TypeCode"] := (cAlias)->RV_TIPOCOD                            // "Tipo Código"
                
                // Adiciona o item ao array Items do funcionário
                AAdd(jEmployee["Items"], jIncidence)
                
                (cAlias)->(DBSkip())
            End

            // Adiciona o último funcionário se existir
            If !Empty(cMatAnt)
                AAdd(jData["Incidences"], jEmployee)
            EndIf
            
        EndIf

        // Adiciona as informações da linha
        self:oData:appendData(jData)

    END SEQUENCE

    // Fecha a área da tabela temporária
    If !Empty(cAlias)
        (cAlias)->(DBCloseArea())
    Endif

    // Limpa os objetos da memória
    FwFreeObj(jParams)
    FwFreeObj(oStatement)
    FwFreeArray(aSituacoes)
    FwFreeArray(aCategorias)
    FwFreeArray(aVerbas)
    FwFreeArray(aAuxCods)

Return self:oData

/*/{Protheus.doc} fQueryVisao
    Pesquisa Visão / Departamento para a Arquitetura Organizacional
    @type Static Function
    @author guilherme.suttanni
    @since 25/09/2025
    @param cCodVisao, Character, Código da visão
    @param cCodDepto, Character, Código do departamento
    @return Array, [1] - Filial, [2] - Chave
/*/
Static Function fQueryVisao(cCodVisao, cCodDepto)
    Local aArea         := GetArea()
    Local aChave        := {"", ""}
    Local cQuery        := ""
    Local cQryAlias     := ""
    Local oStatement    := NIL
    Local nParamOrder   := 1

    cQuery := "SELECT RD4.RD4_CHAVE, RD4.RD4_FILIDE FROM " + RetSqlName("RD4") + " RD4 "
    cQuery += "INNER JOIN " + RetSqlName("RDK") + " RDK "
    cQuery += "ON RD4_CODIGO = RDK_CODIGO AND RD4_FILIAL = RDK_FILIAL "
    cQuery += "WHERE RD4_CODIDE = ? AND RDK_HIERAR = ? AND RDK_CODIGO = ? "
    cQuery += "AND RD4.D_E_L_E_T_ = ? AND RDK.D_E_L_E_T_ = ? "
    cQuery := ChangeQuery(cQuery)

    // Instancia a classe FwExecStatement
    oStatement := FwExecStatement():New(cQuery)

    // Define o valor dos bind parameters
    oStatement:SetString(nParamOrder++, cCodDepto)  // RD4_CODIDE
    oStatement:SetString(nParamOrder++, "1")        // RDK_HIERAR
    oStatement:SetString(nParamOrder++, cCodVisao)  // RDK_CODIGO
    oStatement:SetString(nParamOrder++, " ")        // RD4.D_E_L_E_T_
    oStatement:SetString(nParamOrder++, " ")        // RDK.D_E_L_E_T_

    // Executa a query e retorna o alias criado
    cQryAlias := oStatement:OpenAlias()

    If !(cQryAlias)->(EOF())
        aChave[1] := (cQryAlias)->RD4_FILIDE
        aChave[2] := (cQryAlias)->RD4_CHAVE
    EndIf

    // Fecha a área da query
    If !Empty(cQryAlias)
        (cQryAlias)->(DbCloseArea())
    EndIf

    // Limpa o objeto da memória
    FwFreeObj(oStatement)
    
    RestArea(aArea)

Return aChave

/*/{Protheus.doc} GPER086TReportsBusinessObject:getComboBox()
    Retorna os valores de ComboBox do parâmetro requisitado.
    @type Method
    @version 12.1.2410
    @author guilherme.suttanni
    @since 01/10/2025
    @return Variant, Retorno nulo pré-fixado
    @obs Path parameters: param (nome do parâmetro solicitado)
/*/
Method getComboBox() As Variant Class GPER086TReportsBusinessObject
    Local jPath     As JSON    // Path parameters da requisição
    Local jResponse As JSON    // Resposta da requisição
    Local jItem     As JSON    // Item do valor do parâmetro
    Local cParam    As Character // Parâmetro requisitado
    Local aOrdens   As Array   // Array com as ordens disponíveis
    Local nX        As Numeric // Contador
    Local lUsaKeyLoc As Logical // Usa campo RA_KEYLOC
    Local lUsaRegPat As Logical // Usa campo RA_CODRPAT

    // Inicialização das variáveis
    jPath     := oRest:getPathParamsRequest()
    jResponse := JSONObject():New()
    cParam    := ""
    aOrdens   := {}
    nX        := 0
    lUsaKeyLoc := SRA->(FieldPos("RA_KEYLOC")) > 0
    lUsaRegPat := SRA->(FieldPos("RA_CODRPAT")) > 0

    // Captura os path parameters da requisição
    If (jPath != NIL)
        cParam := jPath["param"]
    EndIf

    // Cria o atributo data e nextPageUrl no JSON de resposta
    jResponse["data"]        := {}
    jResponse["nextPageUrl"] := NIL

    // Verifica qual parâmetro foi solicitado
    If cParam == "getOrders"
        
        // Monta array com todas as ordens
        AAdd(aOrdens, {"1", STR0054})   // "Matrícula + Incidências"
        AAdd(aOrdens, {"2", STR0055})   // "Nome + Incidências"
        AAdd(aOrdens, {"3", STR0056})   // "C.Custo + Matrícula + Incidências"
        AAdd(aOrdens, {"4", STR0057})   // "C.Custo + Nome + Incidências"
        AAdd(aOrdens, {"5", STR0058})   // "Depto + Matrícula + Incidências"
        AAdd(aOrdens, {"6", STR0059})   // "Depto + Nome + Incidências"
        AAdd(aOrdens, {"7", STR0060})   // "C.Custo + Depto + Matrícula + Incidências"
        AAdd(aOrdens, {"8", STR0061})   // "C.Custo + Depto + Nome + Incidências"
        AAdd(aOrdens, {"9", STR0062})   // "Loc.Pago + Matrícula + Incidências"
        AAdd(aOrdens, {"10", STR0063})  // "Loc.Pago + Nome + Incidências"
        AAdd(aOrdens, {"13", STR0064})  // "Verba + Incidências"

        // Percorre o array de ordens e adiciona cada item no JSON de resposta
        For nX := 1 To Len(aOrdens)
            jItem := {;
                "key":   aOrdens[nX][1],;
                "label": FwHTTPEncode(aOrdens[nX][2]);
            }
            AAdd(jResponse["data"], jItem)
        Next nX

    EndIf

    oRest:setResponse(jResponse)
    oRest:setStatusCode(200)
    oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")
    oRest:setKeyHeaderResponse("Accept-Encoding", "UTF-8")

    FwFreeObj(jPath)
    FwFreeObj(jResponse)
    FwFreeObj(jItem)
    FwFreeArray(aOrdens)

Return NIL

/*/{Protheus.doc} GPER086TReportsBusinessObject:getSchema()
    Define o schema do objeto de negócio.
    @type Method
    @version 12.1.2410
    @author guilherme.suttanni
    @since 25/09/2025
    @return Object, Schema do objeto de negócio
/*/
Method getSchema() As Object Class GPER086TReportsBusinessObject
    Local aIncidenceFields          As Array // Array com os campos do item de incidência
    Local aItemFields               As Array // Array com os campos do funcionário
    Local aPayrollIncidenceFields   As Array // Array com os campos do relatório
    Local aPayrollEmployeeFields    As Array // Array com os campos do relatório

    // Define os parâmetros do relatório 
    self:oSchema:addParameter("PAR_PROCESSO",   STR0009,    "string", .F.)        // "Processo"
    self:oSchema:addParameter("PAR_ROTEIRO",    STR0012,    "string", .F.)        // "Roteiro"
    self:oSchema:addParameter("PAR_PERIODO",    STR0010,    "string", .F.)        // "Período"
    self:oSchema:addParameter("PAR_FILIALDE",   STR0039,    "string", .F.)        // "Filial de"
    self:oSchema:addParameter("PAR_FILIALATE",  STR0040,    "string", .F.)        // "Filial até"
    self:oSchema:addParameter("PAR_CCDE",       STR0041,    "string", .F.)        // "Centro de Custo de"
    self:oSchema:addParameter("PAR_CCATE",      STR0042,    "string", .F.)        // "Centro de Custo até"
    self:oSchema:addParameter("PAR_DEPTODE",    STR0043,    "string", .F.)        // "Departamento de"
    self:oSchema:addParameter("PAR_DEPTOATE",   STR0044,    "string", .F.)        // "Departamento até"
    self:oSchema:addParameter("PAR_MATDE",      STR0045,    "string", .F.)        // "Matrícula de"
    self:oSchema:addParameter("PAR_MATATE",     STR0046,    "string", .F.)        // "Matrícula até"
    self:oSchema:addParameter("PAR_SIT",        STR0047,    "string", .T.)        // "Situações"
    self:oSchema:addParameter("PAR_CAT",        STR0048,    "string", .T.)        // "Categorias"
    self:oSchema:addParameter("PAR_PAGAMENTO",  STR0011,    "string", .F.)        // "Pagamento"
    self:oSchema:addParameter("PAR_VERBAS",     STR0049,    "string", .T.)        // "Verbas"
    self:oSchema:addParameter("PAR_SALARIO",    STR0050,    "string", .F.)        // "Salário do Cadastro"
    self:oSchema:addParameter("PAR_TOTALEMP",   STR0051,    "string", .F.)        // "Lista Total Empresa"
    self:oSchema:addParameter("PAR_CODVISAO",   STR0052,    "string", .F.)        // "Código da Visão"
    self:oSchema:addParameter("PAR_DEPVISAO",   STR0053,    "string", .F.)        // "Dept. por Visões"
    self:oSchema:addParameter("PAR_ORDEM",      STR0015,    "string", .F.)        // "Ordem"

    // Define endpoints dos parâmetros de tipo lookup/combobox
    self:setCustomURL("PAR_PROCESSO",   "/api/framework/v1/genericLookupService/smartview/RCJ",     2)
    self:setCustomURL("PAR_ROTEIRO",    "/api/framework/v1/genericLookupService/smartview/SRY",     2)
    self:setCustomURL("PAR_PERIODO",    "/api/framework/v1/genericLookupService/smartview/RCH08",   2)
    self:setCustomURL("PAR_FILIALDE",   "/api/rh/smartview/v1/options/GPEParams/getBranches",       2)
    self:setCustomURL("PAR_FILIALATE",  "/api/rh/smartview/v1/options/GPEParams/getBranches",       2)
    self:setCustomURL("PAR_CCDE",       "/api/framework/v1/genericLookupService/smartview/CTT",     2)
    self:setCustomURL("PAR_CCATE",      "/api/framework/v1/genericLookupService/smartview/CTT",     2)
    self:setCustomURL("PAR_DEPTODE",    "/api/framework/v1/genericLookupService/smartview/SQB",     2)
    self:setCustomURL("PAR_DEPTOATE",   "/api/framework/v1/genericLookupService/smartview/SQB",     2)
    self:setCustomURL("PAR_MATDE",      "/api/framework/v1/genericLookupService/smartview/SRA",     2)
    self:setCustomURL("PAR_MATATE",     "/api/framework/v1/genericLookupService/smartview/SRA",     2)
    self:setCustomURL("PAR_SIT",        "/api/rh/smartview/v1/options/GPEParams/getSX5/31",         2)
    self:setCustomURL("PAR_CAT",        "/api/rh/smartview/v1/options/GPEParams/getSX5/28",         2)
    self:setCustomURL("PAR_VERBAS",     "/api/framework/v1/genericLookupService/smartview/SRV",     2)
    self:setCustomURL("PAR_SALARIO",    "/api/rh/smartview/v1/options/GPEParams/getSNOptions",      1)
    self:setCustomURL("PAR_TOTALEMP",   "/api/rh/smartview/v1/options/GPEParams/getSNOptions",      1)
    self:setCustomURL("PAR_CODVISAO",   "/api/framework/v1/genericLookupService/smartview/RDK",     2)
    self:setCustomURL("PAR_DEPVISAO",   "/api/framework/v1/genericLookupService/smartview/RD4",     2)
    self:setCustomURL("PAR_ORDEM",      "/api/rh/smartview/v1/options/GPER086/getOrders",           1) 

    // Propriedades principais do objeto
    self:oSchema:addProperty("FilialExec",          STR0007,    "string",   STR0007)        // "Filial de Execução"
    self:oSchema:addProperty("EmpresaExec",         STR0008,    "string",   STR0008)        // "Empresa de Execução"
    self:oSchema:addProperty("Process",             STR0009,    "string",   STR0009)        // "Processo"
    self:oSchema:addProperty("Period",              STR0010,    "string",   STR0010)        // "Período"
    self:oSchema:addProperty("Payment",             STR0011,    "string",   STR0011)        // "Pagamento"
    self:oSchema:addProperty("Script",              STR0012,    "string",   STR0012)        // "Roteiro"
    self:oSchema:addProperty("PrintSalary",         STR0013,    "boolean",  STR0013)        // "Imprimir Salário"
    self:oSchema:addProperty("PrintCompanyTotal",   STR0014,    "boolean",  STR0014)        // "Imprimir Total Empresa"
    self:oSchema:addProperty("Order",               STR0015,    "string",   STR0015)        // "Ordem"

    // Estrutura das incidências - FUNCIONÁRIO x VERBAS (ordens 1-12)
    aIncidenceFields := {}
    AAdd(aIncidenceFields, {"BranchCode",       STR0018,    "string", STR0018})           // "Filial"
    AAdd(aIncidenceFields, {"EmployeeCode",     STR0019,    "string", STR0019})           // "Matrícula"
    AAdd(aIncidenceFields, {"EmployeeName",     STR0020,    "string", STR0020})           // "Nome"
    AAdd(aIncidenceFields, {"CostCenter",       STR0021,    "string", STR0021})           // "Centro de Custo"
    AAdd(aIncidenceFields, {"Department",       STR0022,    "string", STR0022})           // "Departamento"
    AAdd(aIncidenceFields, {"MonthlyHours",     STR0023,    "number", STR0023})           // "Horas Mensais"
    AAdd(aIncidenceFields, {"Salary",           STR0024,    "number", STR0024})           // "Salário"
    AAdd(aIncidenceFields, {"Items",            STR0025,    "string", STR0025})           // "Itens"

    // Estrutura dos itens de incidência (verbas do funcionário)
    aItemFields := {}
    AAdd(aItemFields, {"PayrollCode",   STR0026,    "string", STR0026})                   // "Código da Verba"
    AAdd(aItemFields, {"Description",   STR0027,    "string", STR0027})                   // "Descrição"
    AAdd(aItemFields, {"Hours",         STR0028,    "number", STR0028})                   // "Horas"
    AAdd(aItemFields, {"Value",         STR0029,    "number", STR0029})                   // "Valor"
    AAdd(aItemFields, {"Type",          STR0030,    "string", STR0030})                   // "Tipo"
    AAdd(aItemFields, {"TypeCode",      STR0031,    "string", STR0031})                   // "Tipo Código"

    // Estrutura das incidências por verba - VERBA x FUNCIONÁRIOS (ordem 13)
    aPayrollIncidenceFields := {}
    AAdd(aPayrollIncidenceFields, {"PayrollCode",   STR0026,    "string", STR0026})       // "Código da Verba"
    AAdd(aPayrollIncidenceFields, {"Description",   STR0027,    "string", STR0027})       // "Descrição"
    AAdd(aPayrollIncidenceFields, {"Type",          STR0030,    "string", STR0030})       // "Tipo"
    AAdd(aPayrollIncidenceFields, {"TypeCode",      STR0031,    "string", STR0031})       // "Tipo Código"
    AAdd(aPayrollIncidenceFields, {"Employees",     STR0032,    "string", STR0032})       // "Funcionários"

    // Estrutura dos funcionários da verba (ordem 13)
    aPayrollEmployeeFields := {}
    AAdd(aPayrollEmployeeFields, {"BranchCode",         STR0018,    "string", STR0018})    // "Filial"
    AAdd(aPayrollEmployeeFields, {"EmployeeCode",       STR0019,    "string", STR0019})    // "Matrícula"
    AAdd(aPayrollEmployeeFields, {"EmployeeName",       STR0020,    "string", STR0020})    // "Nome"
    AAdd(aPayrollEmployeeFields, {"CostCenter",         STR0021,    "string", STR0021})    // "Centro de Custo"
    AAdd(aPayrollEmployeeFields, {"Department",         STR0022,    "string", STR0022})    // "Departamento"
    AAdd(aPayrollEmployeeFields, {"MonthlyHours",       STR0023,    "number", STR0023})    // "Horas Mensais"
    AAdd(aPayrollEmployeeFields, {"Salary",             STR0024,    "number", STR0024})    // "Salário"
    AAdd(aPayrollEmployeeFields, {"Hours",              STR0028,    "number", STR0028})    // "Horas"
    AAdd(aPayrollEmployeeFields, {"Days",               STR0033,    "number", STR0033})    // "Dias"
    AAdd(aPayrollEmployeeFields, {"Reference",          STR0034,    "number", STR0034})    // "Referência"
    AAdd(aPayrollEmployeeFields, {"Earnings",           STR0035,    "number", STR0035})    // "Proventos"
    AAdd(aPayrollEmployeeFields, {"Deductions",         STR0036,    "number", STR0036})    // "Descontos"
    AAdd(aPayrollEmployeeFields, {"PayrollType",        STR0037,    "string", STR0037})    // "Tipo da Verba"
    AAdd(aPayrollEmployeeFields, {"PayrollCategory",    STR0038,    "string", STR0038})    // "Categoria da Verba"

    // Define a propriedade principal como nested (array de funcionários) - ordens 1-12
    self:addNestedProperty("Incidences", STR0016, STR0016, NIL, aIncidenceFields)         // "Incidências"

    // Define a propriedade para incidências por verba (array de verbas) - ordem 13
    self:addNestedProperty("PayrollIncidences", STR0017, STR0017, NIL, aPayrollIncidenceFields) // "Incidências por Verba"

    // Transforma os itens em nested properties para ambas estruturas
    self:transformInNested("Items", NIL, aItemFields)                                      // "Itens"
    self:transformInNested("Employees", NIL, aPayrollEmployeeFields)                       // "Funcionários"

Return self:oSchema
