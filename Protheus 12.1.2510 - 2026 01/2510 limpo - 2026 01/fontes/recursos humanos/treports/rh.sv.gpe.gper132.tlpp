#include "msobject.ch"
#include "totvs.framework.treports.integratedprovider.th"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#INCLUDE "FWLIBVERSION.CH"
#include "rh.sv.gpe.gper132.ch"

namespace totvs.protheus.rh.treportsintegratedprovider

/*/{Protheus.doc} GPER132TReportsBusinessObject
    Classe do objeto de negócio do Recibo do Abono de Férias.
    @type Class
    @version 12.1.2310
    @author Bruno Costa
    @since 02/12/2025
/*/
@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGAGPE", tables="SRA, SRH, SRR, SRV", name="Recibo do Abono de Férias", country="ALL", initialRelease="12.1.2310")
class GPER132TReportsBusinessObject from totvs.framework.treports.integratedprovider.IntegratedProvider
	public method new() as object
	public method getDescription() as character
	public method getData() as object
	public method getSchema() as object
	private method getWherePar() as character
    private method geraREQ() as variant
endclass

/*/{Protheus.doc} GPER132TReportsBusinessObject:new()
    Instancia a classe do objeto de negócio.
    @type Method
    @version 12.1.2310
    @author Bruno Costa
    @since 02/12/2025
    @return Object, Instância do objeto de negócio
/*/
method new() class GPER132TReportsBusinessObject
	_Super:new()
	self:appendArea(STR0002) //"RH"
	self:setDisplayName(STR0001) //"Recibo do Abono de Férias"

return self

/*/{Protheus.doc} GPER132TReportsBusinessObject:getDescription()
    Retorna a descrição do objeto de negócio.
    @type Method
    @version 12.1.2310
    @author Bruno Costa
    @since 02/12/2025
    @return Character, Descrição do objeto de negócio
/*/
method getDescription() as character class GPER132TReportsBusinessObject
return STR0003 //"Objeto com os registros do Recibo do Abono de Férias"

/*/{Protheus.doc} GPER132TReportsBusinessObject:getData()
    Dados do objeto de negócio.
    @type Method
    @version 12.1.2310
    @author Bruno Costa
    @since 02/12/2025
    @return Object, Dados do objeto de negócio
/*/
method getData(nPage as numeric, oFilter as object) as object class GPER132TReportsBusinessObject

	local cAlias as character
	local cQuery as character
	local cWhere as character
	local cOrdem as character 
    local cDtIni as character
    local cDtFim as character 
    local cAbono as character
    local nDiasAb as character
	local cExtLiq as character
    local cMatric as character
    local cLastCC as character
    local cDtPgto as character
	local cUltCalc as character
    local cLastFil as character
    local cLastDep as character
    local cDescCTT as character
    local cDescDep as character
    local cFilFunc as character
    local cDtIniAb as character
    local cDtFimAb as character
    local cAliasCpo as character
    local cValidFil as character
  	local cAcessaSRA as character
    local cCustomFields as character
    local nVlAbono as numeric
    local nVl13Ab as numeric
   	local nPOrder as numeric
    local nLiqAb as numeric
	local nVias as numeric
	local nI as numeric
	local jParams as json
	local jData :=  JSonObject():new() as json
	local aTipoCod as array
    local aParams as array
    local aFldRel as array
    local aAllCpo as array
    local aInfo as array
	local lOfusca as logical
    local lTAE as logical
    local dDtIni := CtoD("//") as date
    local dDtFim := CtoD("//") as date

	Private lGp1033 as logical //Usar posteriormente no TAE

	Static oStatement
	Static __cWhere  := ""

	jParams    := oFilter:getParameters() 
	cOrdem     := "SRA.RA_FILIAL, SRA.RA_MAT, SRH.RH_DATAINI, SRH.RH_DATAFIM" 
	cAcessaSRA := &( " { || " + ChkRH( "GPER1033" , "SRA" , "2" ) + " } " )
    cValidFil  := fValidFil()
    cAbono 	   := SuperGetMv("MV_ABOPEC",, "N")
    nPOrder    := 2
	nVias      := 1
    aTipoCod   := {"0074", "0079", "0205", "0206", "0617", "0622", "0623", "0632", "0633", "0634", "0635", "1312", "1313", "1314", "1315", "1316", "1317",;
                    "1318", "1319", "1320", "1321", "1322", "1323", "1324", "1325", "1326", "1327", "1330", "1331", "1407", "1408", "1409", "1410" }
    aParams    := {"IMPDEM", "FILDE", "FILATE", "MATDE", "MATATE", "CCDE", "CCATE", "NOMEDE", "NOMEATE", "DTPGODE", "DTPGOATE", "PERFERDE", "PERFERATE" }             
    aFldRel	   := FwProtectedDataUtil():UsrAccessPDField(__cUserID, self:getArrayFields())
    aAllCpo    := self:getStructFields()
    lOfusca    := Len(aFldRel) != Len(self:getArrayFields())

    If !Empty(jParams['IMPDEM', 1]) .And. Len(jParams['IMPDEM', 1]) > 1
        lGp1033 := .T.
        lTAE    := SubStr(jParams['IMPDEM', 1], 2, 1) == "2"
        jParams['IMPDEM', 1] := SubStr(jParams['IMPDEM', 1], 1, 1)
    EndIf

    cWhere := self:getWherePar(jParams)

	If !Empty(jParams['ORDER', 1])
		cOrdem := Iif(jParams['ORDER', 1] == "1", "SRA.RA_FILIAL, SRA.RA_MAT, SRH.RH_DATAINI, SRH.RH_DATAFIM", Iif(jParams['ORDER', 1] == "2", "SRA.RA_FILIAL, SRA.RA_CC, SRA.RA_MAT, SRH.RH_DATAINI, SRH.RH_DATAFIM",;
			Iif(jParams['ORDER', 1] == "3", "SRA.RA_FILIAL, SRA.RA_CC, SRA.RA_NOME, SRA.RA_MAT, SRH.RH_DATAINI, SRH.RH_DATAFIM", "SRA.RA_FILIAL, SRA.RA_NOME, SRA.RA_MAT, SRH.RH_DATAINI, SRH.RH_DATAFIM" )))
	EndIf

	If !Empty(jParams['NVIAS', 1]) .And. jParams['NVIAS', 1] > 0
		nVias := jParams['NVIAS', 1]
	EndIf

    If oStatement == Nil .Or. !(__cWhere == cWhere) 
        cQuery := "SELECT SRA.RA_FILIAL, SRA.RA_MAT, SRA.RA_CC, SRA.RA_NOME, SRA.RA_NSOCIAL, SRA.RA_DEPTO, "
        cQuery += "SRH.RH_DATAINI, SRH.RH_DATAFIM, SRH.RH_DFERIAS, SRH.RH_DABONPE, SRH.RH_ABOPEC, SRH.RH_DTRECIB, SRR.RR_VALOR, SRV.RV_CODFOL "
        cQuery +=  " ? "
        cQuery += "FROM " + RetSqlName("SRA") + " SRA "
        cQuery += "INNER JOIN " + RetSqlName("SRH") + " SRH ON SRH.RH_FILIAL = SRA.RA_FILIAL AND SRH.RH_MAT = SRA.RA_MAT AND SRH.D_E_L_E_T_ = ? "
        cQuery += "INNER JOIN " + RetSqlName("SRR") + " SRR ON SRR.RR_FILIAL = SRA.RA_FILIAL AND SRR.RR_MAT = SRA.RA_MAT AND SRR.RR_DATA = SRH.RH_DATAINI AND SRR.D_E_L_E_T_ = ? "
        cQuery += "INNER JOIN " + RetSqlName("SRV") + " SRV ON " + FWJoinFilial( "SRV", "SRR" ) + " AND SRV.RV_COD = SRR.RR_PD AND SRV.RV_CODFOL IN (?) AND SRV.D_E_L_E_T_ = ? "
        cQuery += "WHERE "

        If !Empty(cWhere)
            cQuery += cWhere
        EndIf

        cQuery += "SRA.D_E_L_E_T_ = ? "
        cQuery += "ORDER BY " + cOrdem

		cQuery     := ChangeQuery(cQuery)
		__cWhere   := cWhere
		oStatement := FwExecStatement():New(cQuery)
	EndIf

    cCustomFields := GPESmartViewUtils():GetCustomFields(self:getCustomFields(), {"SRA", "SRH", "SRR", "SRV"})
    oStatement:SetUnsafe(1, IIf(!Empty(cCustomFields), "," + cCustomFields, "")) 
	oStatement:SetString(nPOrder++, " ")
	oStatement:SetString(nPOrder++, " ")
	oStatement:SetIn(nPOrder++, aTipoCod)
	oStatement:SetString(nPOrder++, " ")

    For nI := 1 To Len(aParams)
        If !Empty(jParams[aParams[nI], 1]) 
            If !aParams[nI] == "IMPDEM"
                If nI > 9
                    oStatement:setDate(nPOrder++, SToD(StrTran(SubStr(jParams[aParams[nI], 1], 1, 10), "-" )))
                ElseIf ("RA_FILIAL" $ jParams[aParams[nI], 1]) .Or.;
                       ("RA_MAT" $ jParams[aParams[nI], 1]) .Or.;
                       ("RA_CC" $ jParams[aParams[nI], 1]) .Or.;
                       ("RA_NOME" $ jParams[aParams[nI], 1]) 
                    Loop 
                Else    
                    oStatement:SetString(nPOrder++, jParams[aParams[nI], 1])
                EndIf
            ElseIf cValToChar(jParams[aParams[nI], 1]) == "2"
                oStatement:SetString(nPOrder++, "D")
            EndIf          
        EndIf
    Next nI

	oStatement:SetString(nPOrder++, " ")

	cAlias := oStatement:OpenAlias()

	While !(cAlias)->(Eof())

        If cLastFil != (cAlias)->RA_FILIAL
            If !((cAlias)->RA_FILIAL $ cValidFil) .Or. !Eval(cAcessaSRA) 
                (cAlias)->(dbSkip())
                Loop
            EndIf
            cLastFil := (cAlias)->RA_FILIAL
            cLastCC  := "" 
            cLastDep := ""
            cUltCalc := ""
            fInfo(@aInfo, (cAlias)->RA_FILIAL)
        EndIf

        If cUltCalc != (cAlias)->(RA_FILIAL+RA_MAT+RH_DATAINI)
            cUltCalc  := (cAlias)->(RA_FILIAL+RA_MAT+RH_DATAINI)
            cNome     := RTrim(IF(Empty((cAlias)->RA_NSOCIAL), (cAlias)->RA_NOME, (cAlias)->RA_NSOCIAL))
            cFilFunc  := (cAlias)->RA_FILIAL
            cMatric   := (cAlias)->RA_MAT
            cDtIni    := (cAlias)->RH_DATAINI 
            cDtFim    := (cAlias)->RH_DATAFIM
            dDtIni    := sTod((cAlias)->RH_DATAINI)
            dDtFim    := sTod((cAlias)->RH_DATAFIM)
            nDiasAb   := (cAlias)->RH_DABONPE
            cDtPgto   := (cAlias)->RH_DTRECIB
            cAliasCpo := cAlias
            nVl13Ab   := 0
            nVlAbono  := 0
            cDescDep  := If(Empty((cAlias)->RA_DEPTO) .And. !Empty(cDescDep), "", (cAlias)->RA_DEPTO)
            cAbono 	  := If(!Empty((cAlias)->RH_ABOPEC), (cAlias)->RH_ABOPEC, If(cAbono == "S", "1", "2")) 
            cDtIniAb  := dToS(If(cAbono == "1", StoD((cAlias)->RH_DATAINI) - (cAlias)->RH_DABONPE, StoD((cAlias)->RH_DATAFIM) + 1))
            cDtFimAb  := dToS(If(cAbono == "1", StoD((cAlias)->RH_DATAINI) - 1, StoD((cAlias)->RH_DATAFIM) + (cAlias)->RH_DABONPE))
            If cLastCC != (cAlias)->RA_CC 
                cDescCTT := RTrim(DescCc((cAlias)->RA_CC, (cAlias)->RA_FILIAL))
                cLastCC  := (cAlias)->RA_CC 
            EndIf
            If !Empty((cAlias)->RA_DEPTO) .And. cLastDep != (cAlias)->RA_DEPTO   
                cDescDep := RTrim(FDesc("SQB", (cAlias)->RA_DEPTO, "SQB->QB_DESCRIC",, (cAlias)->RA_FILIAL)) 
                cLastDep := (cAlias)->RA_DEPTO 
            EndIf 
        EndIf

		If (cAlias)->RV_CODFOL $ "0079*0206"
            nVl13Ab += (cAlias)->RR_VALOR
        Else
            nVlAbono += (cAlias)->RR_VALOR
        EndIf 

        (cAlias)->( dbSkip() )

        If (cAlias)->(Eof()) .Or. cUltCalc != (cAlias)->(RA_FILIAL+RA_MAT+RH_DATAINI)   
            nLiqAb   := nVlAbono + nVl13Ab  
            cExtLiq  := EXTENSO(nLiqAb, .F., 1) 
            cExtLiq  := If(!Empty(cExtLiq), cExtLiq, STR0004) //ZERO CENTAVO     
            cDtIni   := totvs.framework.treports.date.stringToTimeStamp(cDtIni) 
            cDtFim   := totvs.framework.treports.date.stringToTimeStamp(cDtFim)
            cDtIniAb := totvs.framework.treports.date.stringToTimeStamp(cDtIniAb)
            cDtFimAb := totvs.framework.treports.date.stringToTimeStamp(cDtFimAb)
            cDtPgto  := totvs.framework.treports.date.stringToTimeStamp(cDtPgto)

            For nI := 1 to nVias
                jData := {;
                    "branchCode": cFilFunc,; 
                    "employeeCode": cMatric,;
                    "employeeName": cNome,; 
                    "startVacation": cDtIni,; 
                    "endVacation": cDtFim,;
                    "startAllowance": cDtIniAb,;
                    "endAllowance": cDtFimAb,;
                    "vacationPaymentDate": cDtPgto,;
                    "daysAllowance": nDiasAb,;
                    "allowanceValue": nVlAbono,; 
                    "add13Allowance": nVl13Ab,;
                    "liquidAllowance": nLiqAb,;
                    "liquidExtensive": cExtLiq,;
                    "branchCity": RTrim(aInfo[05]),; 
                    "branchName": RTrim(aInfo[03]),; 
                    "companyName": RTrim(aInfo[02]),;
                    "costCenterDescription": cDescCTT,; 
                    "departmentName": cDescDep;
                }

                GPESmartViewUtils():SetCustomFields(aAllCpo, jData, cAliasCpo, aFldRel, lOfusca)
                self:oData:appendData(jData)
            Next nI

            If lTAE
                self:geraREQ(cFilFunc, cMatric, dDtIni, dDtFim)
            EndIf

        EndIf 
	EndDo

	(cAlias)->(DbCloseArea())

return self:oData

/*/{Protheus.doc} GPER132TReportsBusinessObject:getSchema()
    Define o schema do objeto de negócio.
    @type Method
    @version 12.1.2310
    @author Bruno Costa
    @since 02/12/2025
    @return Object, Schema do objeto de negócio
/*/
method getSchema() as object class GPER132TReportsBusinessObject

    self:oSchema:addProperty("branchCode", STR0005, "string", STR0005, "branchCode",,,, .F.)                       //Filial
    self:oSchema:addProperty("employeeCode", STR0006, "string", STR0006, "employeeCode",,,, .F.)                   //Matrícula
    self:oSchema:addProperty("employeeName", STR0007, "string", STR0007, "employeeName",,,, .F.)                   //Nome
    self:oSchema:addProperty("startVacation", STR0008, "date", STR0008, "startVacation",,,, .F.)                   //Início das Férias
    self:oSchema:addProperty("endVacation", STR0009, "date", STR0009, "endVacation",,,, .F.)                       //Fim das Férias
    self:oSchema:addProperty("startAllowance", STR0010, "date", STR0010, "startAllowance",,,, .F.)                 //Início do Abono Pecuniário
	self:oSchema:addProperty("endAllowance", STR0011, "date", STR0011, "endAllowance",,,, .F.)                     //Fim do Abono Pecuniário
    self:oSchema:addProperty("daysAllowance", STR0012, "number", STR0012, "daysAllowance",,,, .F.)                 //Dias de Abono Pecuniário
	self:oSchema:addProperty("allowanceValue", STR0013, "number", STR0013, "allowanceValue",,,, .F.)               //Valor do Abono Pecuniário
	self:oSchema:addProperty("add13Allowance", STR0014, "number", STR0014, "add13Allowance",,,, .F.)               //Valor do 1/3 do Abono Pecuniário
	self:oSchema:addProperty("liquidAllowance", STR0015, "number", STR0015, "liquidAllowance",,,, .F.)             //Líquido do Abono Pecuniário
    self:oSchema:addProperty("liquidExtensive", STR0016, "string", STR0016, "liquidExtensive",,,, .F.)             //Líquido por extenso
    self:oSchema:addProperty("branchCity", STR0017, "string", STR0017, "branchCity",,,, .F.)                       //Cidade da Filial
	self:oSchema:addProperty("branchName", STR0018, "string", STR0018, "branchName",,,, .F.)                       //Nome da Filial
    self:oSchema:addProperty("companyName", STR0019, "string", STR0019, "companyName",,,, .F.)                     //Empresa
    self:oSchema:addProperty("costCenterDescription", STR0020, "string", STR0020, "costCenterDescription",,,, .F.) //Centro de Custo
	self:oSchema:addProperty("departmentName", STR0021, "string", STR0021, "departmentName",,,, .F.)               //Departamento
    self:oSchema:addProperty("vacationPaymentDate", STR0037, "date", STR0037, "vacationPaymentDate",,,, .F.)       //Data de Pagamento das Férias

	self:addParameter("PERFERDE", STR0022, "date", .F.)  //Período Férias De ?
	self:addParameter("PERFERATE", STR0023, "date", .F.) //Período Férias Até ?
	self:addParameter("FILDE", STR0024, "string", .F.)   //Filial De ?
	self:addParameter("FILATE", STR0025, "string", .F.)  //Filial Até ?
	self:addParameter("MATDE", STR0026, "string", .F.)   //Matrícula De ?
	self:addParameter("MATATE", STR0027, "string", .F.)  //Matrícula Até ?
	self:addParameter("CCDE", STR0028, "string", .F.)    //Centro de Custo De ?
	self:addParameter("CCATE", STR0029, "string", .F.)   //Centro de Custo Até ?
    self:addParameter("NOMEDE", STR0030, "string", .F.)  //Nome De ?
    self:addParameter("NOMEATE", STR0031, "string", .F.) //Nome Até ?
	self:addParameter("DTPGODE", STR0032, "date", .F.)   //Data de pagamento De ?
	self:addParameter("DTPGOATE", STR0033, "date", .F.)  //Data de pagamento Até ?
    self:addParameter("IMPDEM", STR0034, "string", .F.)  //Imprimi Demitidos ?
	self:addParameter("NVIAS", STR0035, "number", .F.)   //Nº de Vias ?
	self:addParameter("ORDER", STR0036, "string", .F.)   //Ordem de Impressão ?

	If FWLibVersion() >= "20231121"
		self:setCustomURL("FILDE", "api/rh/smartview/v1/options/GPEParams/getBranches", 2)
		self:setCustomURL("FILATE", "api/rh/smartview/v1/options/GPEParams/getBranches", 2)
		self:setCustomURL("CCDE", "api/framework/v1/genericLookupService/smartview/CTT", 2)
		self:setCustomURL("CCATE", "api/framework/v1/genericLookupService/smartview/CTT", 2)
		self:setCustomURL("MATDE", "api/framework/v1/genericLookupService/smartview/SRA", 2)
		self:setCustomURL("MATATE", "api/framework/v1/genericLookupService/smartview/SRA", 2)
        self:setCustomURL("IMPDEM", "/api/rh/smartview/v1/options/GPER131/IMPDEM", 1) 
		self:setCustomURL("ORDER", "/api/rh/smartview/v1/options/gpersv1033/ORDER", 1)
	EndIf

return self:oSchema

/*/{Protheus.doc} GPER132TReportsBusinessObject:getWherePar()
    Metodo que retorna a consulta conforme os parâmetros
    @type Method
    @version 12.1.2310
    @author Bruno Costa
    @since 02/12/2025
    @return character
/*/
method getWherePar( jPar as json) as character class GPER132TReportsBusinessObject

	Local cRet as character

    If(cValToChar(jPar['IMPDEM', 1]) == "2") 
        cRet += " SRA.RA_SITFOLH <> ? AND "
    EndIf
	If !(lGp1033 .And. "RA_FILIAL" $ jPar['FILDE', 1])
		If !Empty(jPar['FILDE', 1])
			cRet += " RA_FILIAL >= ? AND "
		EndIf
		If !Empty(jPar['FILATE', 1])
			cRet += " RA_FILIAL <= ? AND "
		EndIf
	Else
		cRet += jPar['FILDE', 1] + " AND "
	EndIf
	If !(lGp1033 .And. "RA_MAT" $ jPar['MATDE', 1])
		If !Empty(jPar['MATDE', 1])
			cRet += " RA_MAT >= ? AND "
		EndIf
		If !Empty(jPar['MATATE', 1])
			cRet += " RA_MAT <= ? AND "
		EndIf
	Else
		cRet += jPar['MATDE', 1] + " AND "
	EndIf
	If !(lGp1033 .And. "RA_CC" $ jPar['CCDE', 1])
		If !Empty(jPar['CCDE', 1])
			cRet += " RA_CC >= ? AND "
		EndIf
		If !Empty(jPar['CCATE', 1])
			cRet += " RA_CC <= ? AND "
		EndIf
	Else
		cRet += jPar['CCDE', 1] + " AND "
	EndIf
    If !(lGp1033 .And. "RA_NOME" $ jPar['NOMEDE', 1])
        If !Empty(jPar['NOMEDE', 1])
            cRet += " SRA.RA_NOME >= ? AND "
        EndIf
        If !Empty(jPar['NOMEATE', 1])
            cRet += " SRA.RA_NOME <= ? AND"
        EndIf
    Else 
        cRet += " AND " + jPar['NOMEDE', 1]
    EndIf
	If !Empty(jPar['DTPGODE', 1])
		cRet += " RH_DTRECIB >= ? AND "
	EndIf
	If !Empty(jPar['DTPGOATE', 1])
		cRet += " RH_DTRECIB <= ? AND "
	EndIf
	If !Empty(jPar['PERFERDE', 1])
		cRet += " RH_DATAINI >= ? AND "
	EndIf
	If !Empty(jPar['PERFERATE', 1])
		cRet += " RH_DATAINI <= ? AND "
	EndIf

Return cRet

/*/{Protheus.doc} GPER132TReportsBusinessObject:geraREQ()
    Metodo para criar o registro na REQ para controle do que enviar no GPER1033
    @type Method
    @version 12.1.2310
    @author Bruno Costa
    @since 10/12/2025
    @return Nil
/*/
method geraREQ(cFilRec as character, cMatRec as character, dDtIni as date, dDtFim as date) as variant class GPER132TReportsBusinessObject
    
    local nDoc := "SVGPER132ABO"+cFilRec+cMatRec as character

    DbSelectArea("REQ")
    DbSetOrder(1)
    RecLock("REQ", !REQ->(DbSeek(cFilRec + cMatRec + nDoc)))
    REQ->REQ_FILIAL := cFilRec
    REQ->REQ_MAT	:= cMatRec
    REQ->REQ_DTINI	:= dDtIni
    REQ->REQ_DTFIM 	:= dDtFim
    REQ->REQ_NDOC	:= nDoc
    REQ->REQ_TPDOC	:= "1"
    REQ->REQ_ID 	:= 0
    REQ->REQ_DTINTE	:= Date()
    REQ->REQ_STATUS	:= "N"

    REQ->(MsUnLock())

Return Nil
