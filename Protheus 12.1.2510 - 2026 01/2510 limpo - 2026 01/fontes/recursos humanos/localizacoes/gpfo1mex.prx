aAdd(aRc3Cols, { '','S_','40301','000010','','','','CONT_02','SI_MAYOR','','TOTPER','','0','','',} )
aAdd(aRc3Cols, { '','S_','40301','000011','','','','NO_APLICADO','MUEVE','','','','IMPORTE','','',} )
aAdd(aRc3Cols, { '','S_','40301','000012','','','','IMPORTE','MUEVE','','','','0','','',} )
aAdd(aRc3Cols, { '','S_','40301','000013','','','','','ETIQUETA','','CONT_02','','','','',} )
aAdd(aRc3Cols, { '','S_','40301','000014','','','','NAUX_02','RESTA','','TOTPER','','TOTDED','','',} )
