Function AddMEX0111( aRc2Header , aRc3Header , aSYPHeader )

Local aRc2Cols    := {}
Local aRc3Cols    := {}
Local aItensSYP   := {}

Local cFilRC2     := xFilial('RC2')
Local cCliVersao  := ''

Local lFound      := .F.

Local nRc2Origem	:=  GdFieldPos( 'RC2_ORIGEM' , aRC2Header )
Local nRc2Codigo	:=  GdFieldPos( 'RC2_CODIGO' , aRC2Header )
Local nRc2Versao	:=  GdFieldPos( 'RC2_VERSAO' , aRC2Header )

aAdd(aRc2Cols, { '','S_','40301','ORD Neto ISR','Nómina 01,03,04,09,10','JLRR 2020','','004','1','2',} )

aAdd(aRc3Cols, { '','S_','40301','000001','','','','FINAL','SI_IGUAL','','NOCALCULA','','1','','',} )
aAdd(aRc3Cols, { '','S_','40301','000002','','','','IMPORTE','MUEVE','','','','INCIMPINC','','',} )
