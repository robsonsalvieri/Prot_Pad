aAdd(aRc2Cols, { '','S_','22109','FIN Liq Veinte días','Nómina 09,10','JLRR 2020','','004','1','2',} )

aAdd(aRc3Cols, { '','S_','22109','000001','','','','FINAL','SI_IGUAL','','NOCALCULA','','1','','',} )
