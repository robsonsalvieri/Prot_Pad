	cCliVersao := '__New_Version__' 
EndIf
If ( Val(cCliVersao) < Val(aRc2Cols[ 1 , nRc2Versao ]) ) .Or. (cCliVersao == '__New_Version__') .Or. ( lFilRPO .And. Empty(xFilial('RC2')) .And. Val(cCliVersao) == Val(aRc2Cols[ 1 , nRc2Versao ]) )
