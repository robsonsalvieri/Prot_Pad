#INCLUDE "totvs.ch"
#INCLUDE "tlpp-core.th"
#INCLUDE "FwSchedule.ch"
#INCLUDE "rh.sigagpe.insights.rhpayrollauditdatacommand.ch"

#DEFINE INSIGHTSERROR_TABLE_NOT_EXISTS	1
#DEFINE INSIGHTSERROR_PPROCESSING   	2

USING NAMESPACE totvs.protheus.rh.sigagpe.insights 

Static lTemRUI 

/*-------------------------------------------------------------------
{Protheus.doc} RHPayrollAuditDataCommandMessageReader
Classe de processamento das mensagens do tipo RHPayrollAuditDataCommand - Auditoria de Folha de Pagamento

@author	Bruno Costa
@since	20/10/2025
-------------------------------------------------------------------*/
Class RHPayrollAuditDataCommandMessageReader from LongNameClass

    Public Method New()
    Public Method Read(oLinkMessage As Object) As Logical

EndClass

/*-------------------------------------------------------------------
{Protheus.doc} RHPayrollAuditDataCommandMessageReader::New
Construtor da classe RHPayrollAuditDataCommandMessageReader

@return	Self, objeto do tipo RHPayrollAuditDataCommandMessageReader
@author	Bruno Costa
@since	20/10/2025
-------------------------------------------------------------------*/
Method New() Class RHPayrollAuditDataCommandMessageReader 
Return Self

/*-------------------------------------------------------------------
{Protheus.doc} RHPayrollAuditDataCommandMessageReader::Read
Método responsável pela leitura e processamento da mensagem

@param	oLinkMessage Object. Instância do FwTotvsLinkMessage
@return	logical, sucesso ou falha. Determina se deve ou não retirar a mensgagem da fila
@author	Bruno Costa
@since	20/10/2025
-------------------------------------------------------------------*/
Method Read(oLinkMessage As Object) As Logical Class RHPayrollAuditDataCommandMessageReader
    Local cRawMsg           As Character
    Local lReadOk           As Logical
    Local nStart            As Numeric
    Local oJsonMessage      As Object
    Local oInsightMessage   As Object
    Local oException        As Object

    DEFAULT lTemRUI := AliasInDic("RUI")
    
    nStart := Seconds()
    conout("Sucesso recebido pelo consummer RHPayrollAuditDataCommand - "+ FWTimeStamp(5))
    Try 
        cRawMsg         := oLinkMessage:RawMessage()
        CONOUT("MENSAGEM RECEBIDA METODO READ - CLASSE RHPayrollAuditDataCommand") 
        CONOUT(cRawMsg)
        oJsonMessage    := JsonObject():New()
        oJsonMessage:fromJson(cRawMsg)

        If lTemRUI
            oInsightMessage          := InsightMessageRh():New()
            oInsightMessage:oJsBody  := oJsonMessage["data"] 
            If !oInsightMessage:InsertMessageRh()
                //oException := oInsightMessage:getError(INSIGHTSERROR_PPROCESSING, 'RHPayrollAuditDataCommand', {STR0001, {oJsonMessage["data"]["Tenantid"], oJsonMessage["data"]["ID"]}})            
               // Throw oException
            EndIF 
        Else 
            oInsightMessage := InsightMessageRh():New()
            oException := oInsightMessage:getError(INSIGHTSERROR_TABLE_NOT_EXISTS, 'RHPayrollAuditDataCommand', {STR0002})          
            Throw oException
        EndIf
        
        lReadOk := .T.
    
    Catch oException
        
        FwLogMsg( "ERROR", Nil, "ProtheusInsights", "RHPayrollAuditDataCommand",, "", "Exceção ocorrida ao processar a mensagem de insight",, Seconds() - nStart, ; //"Exceção ocorrida ao processar a mensagem de insight"
            {;
                { "Message", "Exceção ocorrida ao processar a mensagem da Auditoria da Folha" },; //"Exceção ocorrida ao processar a mensagem de insight"
                { "ErrorCode", oException:genCode },;
                { "ErrorMessage", oException:description };
            })

        lReadOk := .T. //Retorna verdadeiro para limpar a mensagem da fila

    Finally
        //RpcClearEnv()
        FreeObj(oJsonMessage)
    EndTry

Return lReadOk

