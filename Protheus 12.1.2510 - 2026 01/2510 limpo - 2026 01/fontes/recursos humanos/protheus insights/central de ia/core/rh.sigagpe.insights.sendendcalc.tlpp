#Include "PROTHEUS.CH"
#Include "tlpp-core.th"
#Include "fwlibversion.ch"

USING NAMESPACE totvs.protheus.rh.sigagpe.insights 

Static __lHRPlatform := Nil 

/*-------------------------------------------------------------------
{Protheus.doc} GPESndEndCalc
Executa o envio da mensagem (gatilho) para a execucao dos pipelines
no ambiente Totvs Carol

@author	Evandro Oliveira
@since	27/11/2025
-------------------------------------------------------------------*/
Function GPESndEndCalc()

	Local oSmartLink 	as object
	Local lSucess    	as logical 
	Local cTenantId  	as character 
	Local cProduct   	as character 
	Local cMessageType 	as character 
	Local cPipelines 	as character 
	Local cBody 	    as character
	Local aFieldsSRD	as array
	Local nPos			as numeric 

	oSmartLink := FwTotvsLinkClient():New()
	cTenantId := oSmartLink:GetTenantClient()

	If !Empty(AllTrim(cTenantId))

		If __lHRPlatform == Nil 
			aFieldsSRD := TcStruct(RetSqlName("SRD"))
			nPos := aScan(aFieldsSRD,{|field|AllTrim(field[1]) == "S_T_A_M_P_"}) 
			__lHRPlatform := (nPos > 0) //Se encontrou o campo quer dizer que o cliente rodou o app do HRPlatform
		EndIf 

		If __lHRPlatform

			cProduct := "hrdatalake"
			cMessageType := "ExecutePipelinesHrPlatform"
			cAudience := "rhshared"

			//cPipelines := '"HR Platform - Protheus - Employee"' 
			//cPipelines += ',"HR Platform - Protheus - Payment"' 
			//cPipelines += ',"HR Platform - Protheus - Payroll Rubric"' 
			//cPipelines += ',"HR Platform - Protheus - Remuneration"' 
			cPipelines += '"HR Platform - Protheus - Draft Remuneration"'
			cPipelines += ',"HR Platform - Protheus - Draft Payment"'

			cBody := '{' + ;
							'"tenantId":"'   + cTenantId    + '",' + ;
							'"product":"'    + cProduct     + '",' + ;
							'"messageType":"' + cMessageType + '",' + ;
							'"Content":{' + ;
							'"Pipelines":[' + cPipelines + ']' + ;
							'}' + ;
						 '}' 

			lSucess := oSmartLink:SendAudience(cMessageType, cAudience, cBody)

			If(lSucess,	FWLogMsg("INFO",Nil,FunName(),"Send",Nil,"","Mensagem publicada com sucesso."), FWLogMsg("ERROR",Nil,FunName(),"Send",Nil,"",oSmartLink:GetError()))
			
		Else 
			FWLogMsg("INFO",Nil,FunName(),"Send",Nil,"","App HRPlatform nao configurado")
		EndIf 
	Else 
		FWLogMsg("INFO",Nil,FunName(),"Send",Nil,"","SmartLink nao configurado")
	EndIf 

Return lSucess
