#include "totvs.ch"
#include "totvs.framework.treports.integratedprovider.th"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "manufacturing.pcp.crp.alocacaoferramenta.ch"

namespace totvs.protheus.sigapcp.treportsintegratedprovider

@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGAPCP", tables="HZK,HZJ,SMF,T4X", name="Análise Alocação por Ferramenta", country="ALL", initialRelease="12.1.2410")

#DEFINE HWF_ATIVO "1"

/*/{Protheus.doc} AnaliseAlocacaoPorFerramentaTReportsBusinessObject
Classe para criação do objeto de negócio do relatório de Análise Alocação por Ferramenta.

@author Lucas Fagundes
@since 29/10/2025
@version P12
/*/
Class AnaliseAlocacaoPorFerramentaTReportsBusinessObject From totvs.framework.treports.integratedprovider.IntegratedProvider
    private data jParametros       as json
    private data jDataProgramacao  as json
    private data cTempoEfetivadas  as character
    private data cTempoProgramadas as character
    private data cTempoBloqueios   as character
    private data oStatementTempos  as object

    public Method new() as object
    public Method getData() as object
    public Method getSchema() as object

    private Method carregaTemposFerramenta(cFerramenta as character, dData as date) as variant
    private Method combinaCodigoDescricao(cCodigo as character, cDescricao as character) as character
    private Method getDescricaoTipoAlocacao(nTipo as numeric) as character
    private Method getLabelSituacaoOrdem(cTipo as character) as character
    private Method setParametros(oFilters as object) as logical
EndClass

/*/{Protheus.doc} new
Construtor da classe AnaliseAlocacaoPorFerramentaTReportsBusinessObject.
@author Lucas Fagundes
@since 29/10/2025
@version P12
@return self
/*/
Method new() as object class AnaliseAlocacaoPorFerramentaTReportsBusinessObject

    _Super:new()

    self:appendArea(STR0001) // "Manufatura"

    self:setDisplayName(STR0002) // "Análise Alocação por Ferramenta"
    self:setDescription(STR0003) // "Informações das alocações realizadas nas ferramentas pela programação do CRP"
    self:setPergunte("PCP152AREC")

Return self

/*/{Protheus.doc} getSchema
Retorna o schema do relatório de Análise Alocação por Ferramenta.
@author Lucas Fagundes
@since 29/10/2025
@version P12
@return self:oSchema
/*/
Method getSchema() as object class AnaliseAlocacaoPorFerramentaTReportsBusinessObject

    self:addProperty("programacao"    , "programacao"    , "string", STR0019) // "Programação"
    self:addProperty("status"         , "status"         , "string", STR0020) // "Status"
    self:addProperty("periodo"        , "periodo"        , "string", STR0021) // "Período"
    self:addProperty("dataReal"       , "dataReal"       , "string", STR0022) // "Data Real"
    self:addProperty("ferramenta"     , "ferramenta"     , "string", STR0023) // "Ferramenta"
    self:addProperty("qtdFerramenta"  , "qtdFerramenta"  , "number", STR0031) // "Quantidade"
    self:addProperty("data"           , "data"           , "date"  , STR0024) // "Data"
    self:addProperty("efetivadas"     , "efetivadas"     , "string", STR0025) // "Efetivadas"
    self:addProperty("programadas"    , "programadas"    , "string", STR0026) // "Programadas"
    self:addProperty("bloqueios"      , "bloqueios"      , "string", STR0027) // "Bloqueios"
    self:addProperty("ordemProducao"  , "ordemProducao"  , "string", STR0028) // "Ordem de Produção"
    self:addProperty("situacao"       , "situacao"       , "string", STR0029) // "Situação"
    self:addProperty("produto"        , "produto"        , "string", STR0030) // "Produto"
    self:addProperty("quantidade"     , "quantidade"     , "number", STR0031) // "Quantidade"
    self:addProperty("operacao"       , "operacao"       , "string", STR0032) // "Operação"
    self:addProperty("recurso"        , "recurso"        , "string", STR0033) // "Recurso"
    self:addProperty("centTrabalho"   , "centTrabalho"   , "string", STR0034) // "Centro de Trabalho"
    self:addProperty("horaInicio"     , "horaInicio"     , "string", STR0035) // "Hora Inicio"
    self:addProperty("horaFim"        , "horaFim"        , "string", STR0036) // "Hora Fim"
    self:addProperty("tempo"          , "tempo"          , "number", STR0037) // "Tempo"
    self:addProperty("tipo"           , "tipo"           , "string", STR0038) // "Tipo"
    self:addProperty("alternativa"    , "alternativa"    , "string", STR0039) // "Alternativa"

    self:setCustomURL("MV_PAR01", "/api/pcp/smartview/v1/alocProgramacao", 2)
    self:setCustomURL("MV_PAR02", "/api/pcp/smartview/v1/alocRecurso",     2)
    self:setCustomURL("MV_PAR03", "/api/pcp/smartview/v1/alocRecurso",     2)
    self:setCustomURL("MV_PAR04", "/api/pcp/smartview/v1/alocCtrab",       2)
    self:setCustomURL("MV_PAR05", "/api/pcp/smartview/v1/alocCtrab",       2)

Return self:oSchema

/*/{Protheus.doc} getData
Retorna os dados do relatório de Análise Alocação por Ferramenta.
@author Lucas Fagundes
@since 29/10/2025
@version P12
@param nPage, Numeric, Número da página a ser retornada
@param oFilters, Object, Filtros aplicados na consulta
@return self:oData
/*/
Method getData(nPage as numeric, oFilters as object) as object class AnaliseAlocacaoPorFerramentaTReportsBusinessObject
    Local cAlias              := ""  as character
    Local cFerramentaAnterior := ""  as character
    Local cQuery              := ""  as character
    Local dDataAnterior              as date
    Local jItem               := JSONObject():New()  as json
    Local nPosParam           := 1   as numeric
    Local oStatement          := Nil as object

    If !self:setParametros(oFilters)
        return self:oData
    EndIf

    cQuery := " SELECT HZJ.HZJ_FERRAM ferramenta, "
    cQuery +=        " SH4.H4_DESCRI descFerram, "
    cQuery +=        " HZK.HZK_DATA data, "
    cQuery +=        " SMF.MF_OP ordemProducao, "
    cQuery +=        " CASE "
    cQuery +=            " WHEN SC2.C2_STATUS = 'S' THEN SC2.C2_STATUS "
    cQuery +=            " ELSE SC2.C2_TPOP "
    cQuery +=        " END situacao, "
    cQuery +=        " SC2.C2_PRODUTO produto, "
    cQuery +=        " SB1.B1_DESC descProd, "
    cQuery +=        " SMF.MF_SALDO saldo, "
    cQuery +=        " SMF.MF_OPER operacao, "
    cQuery +=        " COALESCE(SHY.HY_DESCRI, SG2.G2_DESCRI) descOper, "
    cQuery +=        " SMF.MF_RECURSO recurso, "
    cQuery +=        " SH1.H1_DESCRI descRecur, "
    cQuery +=        " SMF.MF_CTRAB centroTrab, "
    cQuery +=        " SHB.HB_NOME descCT, "
    cQuery +=        " HZK.HZK_INICIO inicio, "
    cQuery +=        " HZK.HZK_FIM fim, "
    cQuery +=        " HZK.HZK_TEMPO tempo, "
    cQuery +=        " SVM.VM_TIPO tipo, "
    cQuery +=        " HZJ.HZJ_ALTERN alternativa, "
    cQuery +=        " HZK.HZK_PROG programacao, "
    cQuery +=        " HZJ.HZJ_QUANT qtdFerramenta "
    cQuery +=   " FROM " + RetSqlName("HZK") + " HZK "
    cQuery +=  " INNER JOIN " + RetSqlName("HZJ") + " HZJ "
    cQuery +=     " ON HZJ.HZJ_FILIAL = ? "
    cQuery +=    " AND HZJ.HZJ_PROG   = HZK.HZK_PROG "
    cQuery +=    " AND HZJ.HZJ_ID     = HZK.HZK_ID "
    cQuery +=    " AND HZJ.D_E_L_E_T_ = ' ' "
    cQuery +=  " INNER JOIN " + RetSqlName("SH4") + " SH4 "
    cQuery +=     " ON SH4.H4_FILIAL = ? "
    cQuery +=    " AND SH4.H4_CODIGO  = HZJ.HZJ_FERRAM "
    cQuery +=    " AND SH4.D_E_L_E_T_ = ' ' "
    cQuery +=  " INNER JOIN " + RetSqlName("SVM") + " SVM "
    cQuery +=     " ON SVM.VM_FILIAL = ? "
    cQuery +=    " AND SVM.VM_PROG    = HZK.HZK_PROG "
    cQuery +=    " AND SVM.VM_ID      = HZK.HZK_IDOPER "
    cQuery +=    " AND SVM.VM_SEQ     = HZK.HZK_SEQALO "
    cQuery +=    " AND SVM.D_E_L_E_T_ = ' ' "
    cQuery +=  " INNER JOIN " + RetSqlName("SMF") + " SMF "
    cQuery +=     " ON SMF.MF_FILIAL  = ? "
    cQuery +=    " AND SMF.MF_PROG     = HZJ.HZJ_PROG "
    cQuery +=    " AND SMF.MF_ID       = HZJ.HZJ_OPER "
    cQuery +=    " AND SMF.MF_RECURSO >= ? "
    cQuery +=    " AND SMF.MF_RECURSO <= ? "
    cQuery +=    " AND SMF.MF_CTRAB   >= ? "
    cQuery +=    " AND SMF.MF_CTRAB   <= ? "
    cQuery +=    " AND SMF.D_E_L_E_T_  = ' ' "
    cQuery +=  " INNER JOIN " + RetSqlName("SC2") + " SC2 "
    cQuery +=     " ON SC2.C2_FILIAL = ? "
    cQuery +=    " AND " + PCPQrySC2("SC2", "SMF.MF_OP")
    cQuery +=    " AND SC2.D_E_L_E_T_ = ' ' "
    cQuery +=  " INNER JOIN " + RetSqlName("SB1") + " SB1 "
    cQuery +=     " ON SB1.B1_FILIAL = ? "
    cQuery +=    " AND SB1.B1_COD    = SC2.C2_PRODUTO "
    cQuery +=    " AND SB1.D_E_L_E_T_ = ' ' "
    cQuery +=  " INNER JOIN " + RetSqlName("SH1") + " SH1 "
    cQuery +=     " ON SH1.H1_FILIAL  = ? "
    cQuery +=    " AND SH1.H1_CODIGO  = SMF.MF_RECURSO "
    cQuery +=    " AND SH1.D_E_L_E_T_ = ' ' "
    cQuery +=   " LEFT JOIN " + RetSqlName("SHB") + " SHB "
    cQuery +=     " ON SHB.HB_FILIAL  = ? "
    cQuery +=    " AND SHB.HB_COD     = SMF.MF_CTRAB "
    cQuery +=    " AND SHB.D_E_L_E_T_ = ' ' "
    cQuery +=   " LEFT JOIN " + RetSqlName("SHY") + " SHY "
    cQuery +=     " ON SHY.HY_FILIAL  = ? "
    cQuery +=    " AND SHY.HY_OP      = SMF.MF_OP "
    cQuery +=    " AND SHY.HY_ROTEIRO = SMF.MF_ROTEIRO "
    cQuery +=    " AND SHY.HY_OPERAC  = SMF.MF_OPER "
    cQuery +=    " AND SHY.HY_TEMPAD <> 0 "
    cQuery +=    " AND SHY.D_E_L_E_T_ = ' ' "
    cQuery +=   " LEFT JOIN " + RetSqlName("SG2") + " SG2 "
    cQuery +=     " ON SG2.G2_FILIAL  = ? "
    cQuery +=    " AND SG2.G2_CODIGO  = SMF.MF_ROTEIRO "
    cQuery +=    " AND SG2.G2_PRODUTO = SC2.C2_PRODUTO "
    cQuery +=    " AND SG2.G2_OPERAC  = SMF.MF_OPER"
    cQuery +=    " AND SHY.HY_OP IS NULL "
    cQuery +=    " AND SG2.D_E_L_E_T_ = ' ' "
    cQuery +=  " WHERE HZK.HZK_FILIAL = ? "
    cQuery +=    " AND HZK.HZK_PROG   = ? "
    cQuery +=    " AND HZK.HZK_DATA  >= ? "
    cQuery +=    " AND HZK.HZK_DATA  <= ? "
    cQuery +=    " AND HZK.D_E_L_E_T_ = ' ' "
    If self:jParametros["exibeEfetivadas"]
        cQuery +=  " UNION ALL "
        cQuery += " SELECT HZL.HZL_FERRAM ferramenta, "
        cQuery +=        " SH4.H4_DESCRI descFerram, "
        cQuery +=        " HZL.HZL_DATA data, "
        cQuery +=        " HZL.HZL_OP ordemProducao, "
        cQuery +=        " CASE "
        cQuery +=            " WHEN SC2.C2_STATUS = 'S' THEN SC2.C2_STATUS "
        cQuery +=            " ELSE SC2.C2_TPOP "
        cQuery +=        " END situacao, "
        cQuery +=        " SC2.C2_PRODUTO produto, "
        cQuery +=        " SB1.B1_DESC descProd, "
        If SuperGetMV("MV_PERDINF")
            cQuery +=    " SC2.C2_QUANT - SC2.C2_QUJE saldo, "
        Else
            cQuery +=    " SC2.C2_QUANT - SC2.C2_QUJE - SC2.C2_PERDA saldo, "
        EndIf
        cQuery +=        " HZL.HZL_OPER operacao, "
        cQuery +=        " COALESCE(SHY.HY_DESCRI, SG2.G2_DESCRI) descOper, "
        cQuery +=        " HZL.HZL_RECURS recurso, "
        cQuery +=        " SH1.H1_DESCRI descRecur, "
        cQuery +=        " HZL.HZL_CTRAB centroTrab, "
        cQuery +=        " SHB.HB_NOME descCT, "
        cQuery +=        " HZL.HZL_INICIO inicio, "
        cQuery +=        " HZL.HZL_FIM fim, "
        cQuery +=        " HZL.HZL_TEMPOT tempo, "
        cQuery +=        " HZL.HZL_TIPO tipo, "
        cQuery +=        " HZL.HZL_ALTERN alternativa, "
        cQuery +=        " HWF.HWF_PROG programacao, "
        cQuery +=        " 0 qtdFerramenta "
        cQuery +=   " FROM " + RetSqlName("HZL") + " HZL "
        cQuery +=  " INNER JOIN " + RetSqlName("SH4") + " SH4 "
        cQuery +=     " ON SH4.H4_FILIAL = ? "
        cQuery +=    " AND SH4.H4_CODIGO  = HZL.HZL_FERRAM "
        cQuery +=    " AND SH4.D_E_L_E_T_ = ' ' "
        cQuery +=  " INNER JOIN " + RetSqlName("SC2") + " SC2 "
        cQuery +=     " ON SC2.C2_FILIAL = ? "
        cQuery +=    " AND " + PCPQrySC2("SC2", "HZL.HZL_OP")
        cQuery +=    " AND SC2.D_E_L_E_T_ = ' ' "
        cQuery +=  " INNER JOIN " + RetSqlName("SB1") + " SB1 "
        cQuery +=     " ON SB1.B1_FILIAL = ? "
        cQuery +=    " AND SB1.B1_COD    = SC2.C2_PRODUTO "
        cQuery +=    " AND SB1.D_E_L_E_T_ = ' ' "
        cQuery +=  " INNER JOIN " + RetSqlName("SH1") + " SH1 "
        cQuery +=     " ON SH1.H1_FILIAL  = ? "
        cQuery +=    " AND SH1.H1_CODIGO  = HZL.HZL_RECURS "
        cQuery +=    " AND SH1.D_E_L_E_T_ = ' ' "
        cQuery +=   " LEFT JOIN " + RetSqlName("SHB") + " SHB "
        cQuery +=     " ON SHB.HB_FILIAL  = ? "
        cQuery +=    " AND SHB.HB_COD     = HZL.HZL_CTRAB "
        cQuery +=    " AND SHB.D_E_L_E_T_ = ' ' "
        cQuery +=   " LEFT JOIN (SELECT DISTINCT HWF.HWF_OP, "
        cQuery +=                              " HWF.HWF_OPER, "
        cQuery +=                              " HWF.HWF_RECURS, "
        cQuery +=                              " HWF.HWF_CTRAB, "
        cQuery +=                              " HWF.HWF_PROG, "
        cQuery +=                              " HWF.HWF_ROTEIR "
        cQuery +=                " FROM " + RetSqlName("HWF") + " HWF "
        cQuery +=               " WHERE HWF.HWF_FILIAL = ? "
        cQuery +=                 " AND HWF.HWF_STATUS = '" + HWF_ATIVO + "' "
        cQuery +=                 " AND HWF.D_E_L_E_T_ = ' ') HWF "
        cQuery +=     " ON HWF.HWF_OP     = HZL.HZL_OP "
        cQuery +=    " AND HWF.HWF_OPER   = HZL.HZL_OPER "
        cQuery +=    " AND HWF.HWF_RECURS = HZL.HZL_RECURS "
        cQuery +=    " AND HWF.HWF_CTRAB  = HZL.HZL_CTRAB "
        cQuery +=   " LEFT JOIN " + RetSqlName("SHY") + " SHY "
        cQuery +=     " ON SHY.HY_FILIAL  = ? "
        cQuery +=    " AND SHY.HY_OP      = HZL.HZL_OP "
        cQuery +=    " AND SHY.HY_ROTEIRO = HWF.HWF_ROTEIR "
        cQuery +=    " AND SHY.HY_OPERAC  = HZL.HZL_OPER "
        cQuery +=    " AND SHY.HY_TEMPAD <> 0 "
        cQuery +=    " AND SHY.D_E_L_E_T_ = ' ' "
        cQuery +=   " LEFT JOIN " + RetSqlName("SG2") + " SG2 "
        cQuery +=     " ON SG2.G2_FILIAL  = ? "
        cQuery +=    " AND SG2.G2_CODIGO  = HWF.HWF_ROTEIR "
        cQuery +=    " AND SG2.G2_PRODUTO = SC2.C2_PRODUTO "
        cQuery +=    " AND SG2.G2_OPERAC  = HZL.HZL_OPER"
        cQuery +=    " AND SHY.HY_OP IS NULL "
        cQuery +=    " AND SG2.D_E_L_E_T_ = ' ' "
        cQuery +=  " WHERE HZL.HZL_FILIAL   =  ? "
        cQuery +=    " AND HZL.HZL_DATA    >=  ? "
        cQuery +=    " AND HZL.HZL_DATA    <=  ? "
        cQuery +=    " AND HZL.HZL_RECURS  >=  ? "
        cQuery +=    " AND HZL.HZL_RECURS  <=  ? "
        cQuery +=    " AND HZL.HZL_CTRAB   >=  ? "
        cQuery +=    " AND HZL.HZL_CTRAB   <=  ? "
        cQuery +=    " AND HZL.HZL_STATUS   = '1' "
        cQuery +=    " AND HZL.D_E_L_E_T_   = ' ' "
    EndIf
    cQuery +=  " ORDER BY ferramenta, data, inicio "

    oStatement := FwExecStatement():new(cQuery)

    oStatement:setString(nPosParam++, xFilial("HZJ")) // HZJ_FILIAL
    oStatement:setString(nPosParam++, xFilial("SH4")) // H4_FILIAL
    oStatement:setString(nPosParam++, xFilial("SVM")) // VM_FILIAL
    oStatement:setString(nPosParam++, xFilial("SMF")) // MF_FILIAL
    oStatement:setString(nPosParam++, self:jParametros["recursoDe"    ]) // MF_RECURSO >=
    oStatement:setString(nPosParam++, self:jParametros["recursoAte"   ]) // MF_RECURSO <=
    oStatement:setString(nPosParam++, self:jParametros["centroTrabDe" ]) // MF_CTRAB >=
    oStatement:setString(nPosParam++, self:jParametros["centroTrabAte"]) // MF_CTRAB <=
    oStatement:setString(nPosParam++, xFilial("SC2")) // C2_FILIAL
    oStatement:setString(nPosParam++, xFilial("SB1")) // B1_FILIAL
    oStatement:setString(nPosParam++, xFilial("SH1")) // H1_FILIAL
    oStatement:setString(nPosParam++, xFilial("SHB")) // HB_FILIAL
    oStatement:setString(nPosParam++, xFilial("SHY")) // HY_FILIAL
    oStatement:setString(nPosParam++, xFilial("SG2")) // G2 FILIAL
    oStatement:setString(nPosParam++, xFilial("HZK")) // HZK_FILIAL
    oStatement:setString(nPosParam++, self:jParametros["programacao"]) // HZK_PROG
    oStatement:setDate(nPosParam++,   self:jParametros["dataDe"     ]) // HZK_DATA >=
    oStatement:setDate(nPosParam++,   self:jParametros["dataAte"    ]) // HZK_DATA <=
    If self:jParametros["exibeEfetivadas"]
        oStatement:setString(nPosParam++, xFilial("SH4")) // H4_FILIAL
        oStatement:setString(nPosParam++, xFilial("SC2")) // C2_FILIAL
        oStatement:setString(nPosParam++, xFilial("SB1")) // B1_FILIAL
        oStatement:setString(nPosParam++, xFilial("SH1")) // H1_FILIAL
        oStatement:setString(nPosParam++, xFilial("SHB")) // HB_FILIAL
        oStatement:setString(nPosParam++, xFilial("HWF")) // HWF_FILIAL
        oStatement:setString(nPosParam++, xFilial("SHY")) // HY_FILIAL
        oStatement:setString(nPosParam++, xFilial("SG2")) // G2_FILIAL
        oStatement:setString(nPosParam++, xFilial("HZL")) // HZL_FILIAL
        oStatement:setDate(nPosParam++,   self:jParametros["dataDe" ]) // HZL_DATA >=
        oStatement:setDate(nPosParam++,   self:jParametros["dataAte"]) // HZL_DATA <=
        oStatement:setString(nPosParam++, self:jParametros["recursoDe"    ]) // HZL_RECURS >=
        oStatement:setString(nPosParam++, self:jParametros["recursoAte"   ]) // HZL_RECURS <=
        oStatement:setString(nPosParam++, self:jParametros["centroTrabDe" ]) // HZL_CTRAB >=
        oStatement:setString(nPosParam++, self:jParametros["centroTrabAte"]) // HZL_CTRAB <=
    EndIf

    cAlias := oStatement:openAlias()

    TcSetField(cAlias, 'data', 'D', GetSx3Cache("HZK_DATA", "X3_TAMANHO"), 0)

    While (cAlias)->(!EoF())

        If (cAlias)->ferramenta != cFerramentaAnterior .Or. (cAlias)->data != dDataAnterior
            self:carregaTemposFerramenta((cAlias)->ferramenta, (cAlias)->data)
            cFerramentaAnterior := (cAlias)->ferramenta
            dDataAnterior := (cAlias)->data
        EndIf

        jItem := JSONObject():New()
        jItem["programacao"  ] := self:jParametros["programacao"]
        jItem["status"       ] := PCPA152Process():getDescricaoStatus(self:jDataProgramacao['status'])
        jItem["periodo"      ] := DToC(self:jDataProgramacao['dataInicial']) + " - " + DToC(self:jDataProgramacao['dataFinal'])
        jItem["dataReal"     ] := DToC(self:jDataProgramacao['dataRealFim'])
        jItem["ferramenta"   ] := self:combinaCodigoDescricao((cAlias)->ferramenta, (cAlias)->descFerram)
        jItem["data"         ] := totvs.framework.treports.date.stringToTimeStamp(DToS((cAlias)->data))
        jItem["efetivadas"   ] := self:cTempoEfetivadas
        jItem["programadas"  ] := self:cTempoProgramadas
        jItem["bloqueios"    ] := self:cTempoBloqueios
        jItem["ordemProducao"] := (cAlias)->ordemProducao
        jItem["situacao"     ] := self:getLabelSituacaoOrdem((cAlias)->situacao, (cAlias)->programacao)
        jItem["produto"      ] := self:combinaCodigoDescricao((cAlias)->produto, (cAlias)->descProd)
        jItem["quantidade"   ] := (cAlias)->saldo
        jItem["operacao"     ] := self:combinaCodigoDescricao((cAlias)->operacao, (cAlias)->descOper)
        jItem["recurso"      ] := self:combinaCodigoDescricao((cAlias)->recurso, (cAlias)->descRecur)
        jItem["centTrabalho" ] := self:combinaCodigoDescricao((cAlias)->centroTrab, (cAlias)->descCT)
        jItem["horaInicio"   ] := (cAlias)->inicio
        jItem["horaFim"      ] := (cAlias)->fim
        jItem["tempo"        ] := (cAlias)->tempo
        jItem["tipo"         ] := self:getDescricaoTipoAlocacao((cAlias)->tipo)
        jItem["alternativa"  ] := Iif((cAlias)->alternativa == "1", STR0017, STR0018) // "Sim" "Não"
        jItem["qtdFerramenta"] := (cAlias)->qtdFerramenta

        self:ProcessData()
        self:oData:appendData(jItem)

        (cALias)->(dbSkip())
    End
    (cAlias)->(dbCloseArea())

    oStatement:destroy()
    FreeObj(oStatement)

    If self:oStatementTempos != Nil
        self:oStatementTempos:destroy()
        FreeObj(self:oStatementTempos)
    EndIf

Return self:oData

/*/{Protheus.doc} setParams
Define os parâmetros para a consulta do relatório de Análise Alocação por Ferramenta.
@author Lucas Fagundes
@since 29/10/2025
@version P12
@param oFilters, object, Filtros aplicados na consulta.
@return lOk, Logical, Indica se os parâmetros foram definidos com sucesso.
/*/
Method setParametros(oFilters as object) as logical class AnaliseAlocacaoPorFerramentaTReportsBusinessObject
    Local dDataFinal                                   as date
    Local jParametros      := oFilters:getParameters() as json
    Local nExibeEfetivadas := 0                        as numeric

    self:jParametros := JSONObject():New()
    self:jDataProgramacao := JSONObject():New()

    If PCPSmartViewParamUtils():existePergunte("PCP152AREC", 8)
        nExibeEfetivadas := jParametros["MV_PAR08"][1]
    EndIf

    self:jParametros["programacao"    ] := jParametros["MV_PAR01"][1]
    self:jParametros["recursoDe"      ] := pcpGetParametroSV(jParametros, "MV_PAR02", .F., "MF_RECURSO")
    self:jParametros["recursoAte"     ] := pcpGetParametroSV(jParametros, "MV_PAR03", .T., "MF_RECURSO")
    self:jParametros["centroTrabDe"   ] := pcpGetParametroSV(jParametros, "MV_PAR04", .F., "MF_CTRAB")
    self:jParametros["centroTrabAte"  ] := pcpGetParametroSV(jParametros, "MV_PAR05", .T., "MF_CTRAB")
    self:jParametros["dataDe"         ] := pcpconvdat(jParametros["MV_PAR06"][1], 1)
    self:jParametros["dataAte"        ] := pcpconvdat(jParametros["MV_PAR07"][1], 1)
    self:jParametros["exibeEfetivadas"] := nExibeEfetivadas == 1

    If Empty(self:jParametros["programacao"])
        self:setErrorStatus(400, STR0004, STR0005) // "Programação não informada." "O parâmetro de Programação é obrigatório."
        return .f.
    EndIf

    T4X->(dbSetOrder(1))
    If T4X->(dbSeek(xFilial("T4X") + self:jParametros["programacao"]))

        self:jDataProgramacao['status'] := T4X->T4X_STATUS

        T4Y->(dbSetOrder(2))

        T4Y->(dbSeek(xFilial("T4X") + self:jParametros["programacao"] + "dataInicial"))
        self:jDataProgramacao['dataInicial'] := PCPConvDat(AllTrim(T4Y->T4Y_VALOR), 1)

        T4Y->(dbSeek(xFilial("T4X") + self:jParametros["programacao"] + "dataFinal"))
        self:jDataProgramacao['dataFinal'] := PCPConvDat(AllTrim(T4Y->T4Y_VALOR), 1)

        T4Y->(dbSeek(xFilial("T4X") + self:jParametros["programacao"] + "dataRealFim"))
        self:jDataProgramacao['dataRealFim'] := PCPConvDat(AllTrim(T4Y->T4Y_VALOR), 1)

        dDataFinal := self:jDataProgramacao['dataFinal']
        If self:jDataProgramacao['dataRealFim'] > dDataFinal
            dDataFinal := self:jDataProgramacao['dataRealFim']
        EndIf

        If self:jParametros['dataDe' ] < self:jDataProgramacao['dataInicial'] .Or.;
           self:jParametros['dataAte'] > dDataFinal .Or.;
           self:jParametros['dataAte'] < self:jParametros['dataDe']

            self:setErrorStatus(400, STR0006, STR0007) // "Período inválido." "O período informado está fora do intervalo da programação."
            return .f.
        EndIf
    Else
        self:setErrorStatus(400, STR0008, STR0009) // "Programação inválida." "A Programação informada não existe."
        return .f.
    EndIf

Return .t.

/*/{Protheus.doc} combinaCodigoDescricao
Retorna a label com o código e descrição combinados.
@author Lucas Fagundes
@since 30/10/2025
@version P12
@param cCodigo, Character, Código a ser combinado.
@param cDescricao, Character, Descrição a ser combinada.
@return cLabel, Character, Código e descrição combinados.
/*/
Method combinaCodigoDescricao(cCodigo as character, cDescricao as character) as character class AnaliseAlocacaoPorFerramentaTReportsBusinessObject
    Local cLabel := "" as character

    cLabel := RTrim(cCodigo)
    If !Empty(cDescricao)
        cLabel += " - " + RTrim(cDescricao)
    EndIf

Return cLabel

/*/{Protheus.doc} getDescricaoTipoAlocacao
Retorna a descrição do tipo de alocação com base no código informado.
@author Lucas Fagundes
@since 30/10/2025
@version P12
@param nTipo, Numeric, Código do tipo de alocação.
@return cDescricao, Character, Descrição do tipo de alocação.
/*/
Method getDescricaoTipoAlocacao(nTipo as numeric) as character class AnaliseAlocacaoPorFerramentaTReportsBusinessObject
    Local cDescricao := "" as character

    If nTipo == 1
        cDescricao := STR0010 // "Setup"
    ElseIf nTipo == 2
        cDescricao := STR0011 // "Produção"
    EndIf

Return cDescricao

/*/{Protheus.doc} getLabelSituacaoOrdem
Retorna label para situação da ordem de produção.
@author Lucas Fagundes
@since 31/10/2025
@version P12
@param cTipo, Character, Tipo da ordem de produção.
@param cProgramacao, Character, Código da programação que processou a ordem.
@return cLabel, Character, Label para a situação da ordem.
/*/
Method getLabelSituacaoOrdem(cTipo as character, cProgramacao as character) as character class AnaliseAlocacaoPorFerramentaTReportsBusinessObject
    Local cLabel := ""

    If cTipo == "S"
        cLabel := STR0014 + " - " + cProgramacao // "Efetivada"
    ElseIf cTipo == "F"
        cLabel := STR0015 // "Firme"
    ElseIf cTipo == "P"
        cLabel := STR0016 // "Prevista"
    EndIf

Return cLabel

/*/{Protheus.doc} carregaTemposFerramenta
Carregas o totalizadores de tempo de uma ferramenta em uma determinada data.
@author Lucas Fagundes
@since 30/10/2025
@version P12
@param cFerramenta, Character, Código da ferramenta.
@param dData, Date, Data que irã carregar os tempos.
@return Nil
/*/
Method carregaTemposFerramenta(cFerramenta as character, dData as date) as variant class AnaliseAlocacaoPorFerramentaTReportsBusinessObject
    Local cAlias    := "" as character
    Local cQuery    := "" as character
    Local nPosParam := 1  as numeric

    self:cTempoEfetivadas  := "00:00"
    self:cTempoProgramadas := "00:00"
    self:cTempoBloqueios   := "00:00"

    If self:oStatementTempos == Nil
        cQuery += " SELECT SUM(SMR.MR_TEMPOBL) bloqueado, "
        cQuery +=        " SUM(SMR.MR_TEMPOEF) efetivado, "
        cQuery +=        " (SELECT SUM(HZK.HZK_TEMPO) "
        cQuery +=           " FROM " + RetSqlName("HZJ") + " HZJ "
        cQuery +=          " INNER JOIN " + RetSqlName("HZK") + " HZK "
        cQuery +=             " ON HZK.HZK_FILIAL = ? "
        cQuery +=            " AND HZK.HZK_PROG   = HZJ.HZJ_PROG "
        cQuery +=            " AND HZK.HZK_ID     = HZJ.HZJ_ID "
        cQuery +=            " AND HZK.HZK_DATA   =  ? "
        cQuery +=            " AND HZK.D_E_L_E_T_ = ' ' "
        cQuery +=          " WHERE HZJ.HZJ_FILIAL =  ? "
        cQuery +=            " AND HZJ.HZJ_PROG   =  ? "
        cQuery +=            " AND HZJ.HZJ_FERRAM =  ? "
        cQuery +=            " AND HZJ.D_E_L_E_T_ = ' ') programado "
        cQuery +=   " FROM " + RetSqlName("SMR") + " SMR "
        cQuery +=  " WHERE SMR.MR_FILIAL  =  ? "
        cQuery +=    " AND SMR.MR_PROG    =  ? "
        cQuery +=    " AND SMR.MR_RECURSO =  ? "
        cQuery +=    " AND SMR.MR_TIPO    = '2' "
        cQuery +=    " AND SMR.MR_DATDISP =  ? "
        cQuery +=    " AND SMR.D_E_L_E_T_ = ' ' "

        self:oStatementTempos := FwExecStatement():new(cQuery)
    EndIf

    self:oStatementTempos:setString(nPosParam++, xFilial("HZK")) // HZK_FILIAL
    self:oStatementTempos:setDate(nPosParam++, dData) // HZK_DATA
    self:oStatementTempos:setString(nPosParam++, xFilial("HZJ")) // HZJ_FILIAL
    self:oStatementTempos:setString(nPosParam++, self:jParametros['programacao']) // HZJ_PROG
    self:oStatementTempos:setString(nPosParam++, cFerramenta) // HZJ_FERRAM
    self:oStatementTempos:setString(nPosParam++, xFilial("SMR")) // MR_FILIAL
    self:oStatementTempos:setString(nPosParam++, self:jParametros['programacao']) // MR_PROG
    self:oStatementTempos:setString(nPosParam++, cFerramenta) // MR_RECURSO
    self:oStatementTempos:setDate(nPosParam++, dData) // MR_DATDISP

    cAlias := self:oStatementTempos:openAlias()

    If (cAlias)->(!Eof())
        self:cTempoEfetivadas  := __min2hrs((cAlias)->efetivado, .T.)
        self:cTempoProgramadas := __min2hrs((cAlias)->programado, .T.)
        self:cTempoBloqueios   := __min2hrs((cAlias)->bloqueado, .T.)
    EndIf
    (cAlias)->(dbCloseArea())

Return Nil
