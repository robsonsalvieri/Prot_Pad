/*/{Protheus.doc} getTribDKMImport
    Monta Json com os tributos da tabela DKM, para ser enviado para ser utilizado no metodo
    TaxOperandIntegrator

    @type  Function
    @author Tiago Tudisco
    @since 12/12/2025
    @version version
    @param jTribGen  Object  Objeto JSON com os tributos genéricos
    @param cPosItem  String  Posição do item no Item da NF
    @param cIdTotvs   String  Identificador TOTVS do Tributo
    @return oRet - Objeto JSON com os tributos da tabela DKM
    @example
    (examples)
    @see (links_or_references)
    /*/
function getTribDKMImport(jTribGen, cPosItem, cIdTotvs)

If DKM->DKM_TABELA == "SWN" .And. DKM->DKM_ORIGEM $ "EICDI154|EICDI554|EICIN100"
    //Propriedades do Tributo (F2D)
    jTribGen[cPosItem][cIdTotvs]["base_valor"]      := DKM->DKM_BASE //Valor da base do imposto
    //IIF(!Empty(xxxxx), jTribGen[cPosItem][cIdTotvs]["base_quantidade"] := "", )//Valor da base quando é operação com quantidade
    //IIF(!Empty(xxxxx), jTribGen[cPosItem][cIdTotvs]["base_um"]         := "", ) //Unidade de medida
    jTribGen[cPosItem][cIdTotvs]["aliquota"]        := DKM->DKM_PALIEF //Alíquota do tributo
    jTribGen[cPosItem][cIdTotvs]["valor"]           := DKM->DKM_VALOR //Valor do imposto
    
    //Propriedades de escrituração (CJ3)
    If !Empty(DKM->DKM_CST) .And. !Empty(DKM->DKM_CLASTR)
        jTribGen[cPosItem][cIdTotvs]["esc_CST"]             := DKM->DKM_CST //Classificação fiscal
        jTribGen[cPosItem][cIdTotvs]["esc_CCT"]             := DKM->DKM_CLASTR //CCT IBS/CBS
        jTribGen[cPosItem][cIdTotvs]["esc_vl_tributado"]    := DKM->DKM_VALOR //Valor tributado
        jTribGen[cPosItem][cIdTotvs]["esc_vl_isento"]       := 0 //Valor isento
        jTribGen[cPosItem][cIdTotvs]["esc_vl_outros"]       := 0 //Valor outros
        IIF(!Empty(DKM->DKM_VDIF), jTribGen[cPosItem][cIdTotvs]["esc_vl_diferido"]          := DKM->DKM_VDIF, ) //Valor diferido
        IIF(!Empty(DKM->DKM_PDIF), jTribGen[cPosItem][cIdTotvs]["esc_pc_diferido"]          := DKM->DKM_PDIF, ) //Perceutao do diferimento
        //jTribGen[cPosItem][cIdTotvs]["esc_pc_reducao_base"]                                 := 0 //Percentual de redução
        //IIF(!Empty(DKM->DKM_BASE), jTribGen[cPosItem][cIdTotvs]["esc_base_original"]        := DKM->DKM_BASE, ) //Base original
        IIF(!Empty(DKM->DKM_PREDAL), jTribGen[cPosItem][cIdTotvs]["esc_pc_reducao_aliq"]    := DKM->DKM_PREDAL, ) //Percentual de redução de alíquota
        IIF(!Empty(DKM->DKM_ALIQ), jTribGen[cPosItem][cIdTotvs]["esc_aliquota_original"]    := DKM->DKM_ALIQ, ) //Alíquota original
    EndIf
EndIf

return jTribGen
