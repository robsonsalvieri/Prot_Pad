	@type class
	@author Iury Soares Azevedo
	@since 09/06/2025
/*/
Class OFSoInFieldServiceService
	Public Method New() CONSTRUCTOR
	Public Method Process()
EndClass

/*/{Protheus.doc} New
	Construtor Simples

	@type method
	@author Iury Soares Azevedo
	@since 09/06/2025
/*/
Method New() Class OFSoInFieldServiceService
Return SELF

/*/{Protheus.doc} Process
	Metodo que processa as requisicoes vindas do Service Operations

	@type method
	@author Iury Soares Azevedo
	@since 09/06/2025
/*/
Method Process(aQueryParams as Array, cBody as Character, cGatewayHeader as Character) Class OFSoInFieldServiceService
	local jGatewayHeader := JsonObject():New()
	local cParseHead := jGatewayHeader:fromJson(cGatewayHeader)
	Local oSoRequest := OFSoRequestBody():New(cBody)
	local oInteractor := nil
	Local oRet := Nil

	if ! empty(cParseHead)
		Conout("===Erro PARSEHEAD vazio===")
		return OFSoInvalidGatewayHeaderResponse():New()
	endif

	if ! oSoRequest:IsValid()
		Conout("===Erro OSOREQUEST invalido===")
		return OFSoInvalidBodyResponse():New()
	endif

	if Upper(AllTrim(aQueryParams[2])) != Upper(AllTrim(oSoRequest:GetName()))
		Conout("===Erro Nome da requisicao diferente da url===")
		return OFSoInvalidBodyResponse():New()
	EndIf

	do case
		case oSoRequest:GetName() == "WorkOrderPartsAddedInFieldService"
			oInteractor := OFSoWorkOrderPartsAddedInFieldServiceInteractor():New()
		case oSoRequest:GetName() == "ContactUpdatedInFieldService"
			oInteractor :=  OFSoContactUpdatedInFieldServiceInteractor():New()
		case oSoRequest:GetName() == "CustomerCreatedInFieldService"
			oInteractor := OFSoCustomerCreatedInFieldServiceInteractor():New()
		case oSoRequest:GetName() == "CustomerUpdatedInFieldService"
			oInteractor := OFSoCustomerUpdatedInFieldServiceInteractor():New()
		case oSoRequest:GetName() == "EquipmentCreatedInFieldService"
			oInteractor := OFSoEquipmentCreatedInFieldServiceInteractor():New()
		case oSoRequest:GetName() == "EquipmentUpdatedInFieldService"
			oInteractor := OFSoEquipmentUpdatedInFieldServiceInteractor():New()
		case oSoRequest:GetName() == "EquipmentModelCreatedInFieldService"
			oInteractor := OFSoEquipmentModelCreatedInFieldServiceInteractor():New()
		case oSoRequest:GetName() == "EquipmentModelUpdatedInFieldService"
			oInteractor := OFSoEquipmentModelUpdatedInFieldServiceInteractor():New()
		case oSoRequest:GetName() == "PartsGetRelated"
			oInteractor := OFSoPartsGetRelatedInteractor():New()
		case oSoRequest:GetName() == "PartsSearch"
			oInteractor := OFSoPartsSearchInteractor():New()
		case oSoRequest:GetName() == "WorkOrderPartsRemovedInFieldService"
			oInteractor := OFSworkOrderPartsRemovedInFieldServiceInteractor():New()
		case oSoRequest:GetName() == "WorkOrderPartsReturnRequestedInFieldService"
			oInteractor := OFSworkOrderPartReturnRequestedInFieldServiceInteractor():New()
		case oSoRequest:GetName() == "WorkOrderPartsUpdatedInFieldService"
			oInteractor := OFSworkOrderPartsUpdatedInFieldServiceInteractor():New()
		case oSoRequest:GetName() == "WorkOrderSegmentCreatedInFieldService"
			oInteractor := OFSworkOrderSegmentCreatedInFieldServiceInteractor():New()
		case oSoRequest:GetName() == "WorkOrderSegmentUpdatedInFieldService"
			oInteractor := OFSoWorkOrderSegmentUpdatedInFieldServiceInteractor():New()
		case oSoRequest:GetName() == "WorkOrderSegmentRetrieveInFieldService"
			oInteractor := OFSworkOrderSegmentRetrieveInFieldServiceInteractor():New()
		case oSoRequest:GetName() == "WorkOrderSegmentUpdatePricingInFieldService"
			oInteractor := OFSoWorkOrderSegmentUpdatePricingInFieldServiceInteractor():New()
		case oSoRequest:GetName() == "WorkOrderPartsTransferRequestedInFieldService"
			oInteractor := OFSworkOrderPartsTransferRequestedInFieldServiceInteractor():New()
	end case

	if Empty(oInteractor)
		Conout("===Erro Mensagem nao encontrada===")
		oRet := OFSoInvalidBodyResponse():New(STR0001) //Message not found
	else
		oRet := oInteractor:Process(oSoRequest,jGatewayHeader)
	endif

Return oRet

