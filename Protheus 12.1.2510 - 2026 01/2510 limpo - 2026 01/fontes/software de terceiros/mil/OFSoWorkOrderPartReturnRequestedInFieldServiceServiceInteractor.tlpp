#include 'totvs.ch'
#Include "FWMVCDEF.CH"
//#include "OFSworkOrderPartReturnRequestedInFieldServiceInteractor.ch"

#DEFINE STR0001 "Invalid body data, work order does not exist."
#DEFINE STR0002 "Invalid body data, work order segment does not exist."
#DEFINE STR0003 "Pending"
#DEFINE STR0004 "Part not found."
#DEFINE STR0005 "Complete"
#DEFINE STR0006 "The quantity returned is greater than the quantity requested."


/*/{Protheus.doc} OFSworkOrderPartReturnRequestedInFieldServiceInteractor
	Classe que vai tratar a criacao de modelos no field service
	
	@type class
	@author Iury Soares Azevedo
	@since 12/06/2025
/*/
Class OFSworkOrderPartReturnRequestedInFieldServiceInteractor 
	public data OFSoWorkOrder as object
	Public Method New() CONSTRUCTOR
	Public Method Process()
EndClass

/*/{Protheus.doc} New
	Construtor Simples

	@type method
	@author Iury Soares Azevedo
	@since 13/06/2025
/*/
Method New() Class OFSworkOrderPartReturnRequestedInFieldServiceInteractor
	self:OFSoWorkOrder := OFSoWorkOrder():New()
Return SELF

/*/{Protheus.doc} Process
	processa a criacao
	@type method
	@author Iury Soares Azevedo
	@since 13/06/2025
/*/
Method Process(jSoRequestBody) Class OFSworkOrderPartReturnRequestedInFieldServiceInteractor
	local jBody := jSoRequestBody:jBody as Json
	local cReferenceID := "" as character
	local cSegmReferenceID := "" as character
	local jRet as json
	Local aResult as array
	Local cNumOSV as character


	if jBody:HasProperty("data")
		cReferenceID := iif(jBody["data"]:HasProperty("woHeaderReferenceId"),jBody["data"]["woHeaderReferenceId"],"")
		cSegmReferenceID := iif(jBody["data"]:HasProperty("woSegmentReferenceId"),jBody["data"]["woSegmentReferenceId"],"")
	endif
	
	if empty(cReferenceID) .OR. ;
		! self:OFSoWorkOrder:existsWorkOrder(cReferenceID)
		
		jRet :=  OFSoRestErrorResponse():BadRequest("WorkOrderPartReturnRequestedInField", 0, STR0001, "")	// "Invalid body data, work order does not exist."
		return jret
	endif

	if empty(cSegmReferenceID) .OR. ;
		! self:OFSoWorkOrder:existsWorkOrderSegment(cSegmReferenceID)
		
		jRet :=  OFSoRestErrorResponse():BadRequest("WorkOrderPartReturnRequestedInField", 0, STR0002, "")	// "Invalid body data, work order segment does not exist."
		return jret
	endif

	cNumOSV := self:OFSoWorkOrder:getNumOSV()



	VO1->(dbSelectArea("VO1"))
	VO1->(dbSetOrder(1))

	VO1->(MsSeek(xFilial("VO1")+cNumOSV))

	aResult := ReturnParts(jBody["data"]["parts"], self:OFSoWorkOrder:getSeqInc() )
	If aResult[1]
		jRet := OFSoResponseBody():New(200, jSoRequestBody, aResult[2])
	Else
		jRet := OFSoRestErrorResponse():BadRequest("WorkOrderPartReturnRequestedInFieldService", 0, aResult[2], "")
	EndIf
	
return jRet


/*/{Protheus.doc} ReturnParts
	Efetua o a remocao das pecas envidas na tabela VSJ
	@type method
	@author Iury Soares Azevedo
	@since 13/06/2025
/*/
Static Function ReturnParts(aParts,cSeqInc)
	Local aRet := {.T.,Nil} as array
	Local nX as Numeric
	Local aItem := {} as array
	Local aItens := {} as array
	Local aPecaLib := {} as array
	Local cFiltroSQL := "VO3_SEQINC='" + cSeqInc + "'"
	
	Private lMSHelpAuto := .t.
	Private lMsErroAuto := .f.
	
	For nX := 1 to len(aParts)
		aPecaLib := FMX_CALPEC(;
								VO1->VO1_NUMOSV,; // cNumOS
								"C",;    		 // cTipTem
								,;           // cGruIte
								 aParts[nX]["partNumber"],; // cCodIte
								.f.,;        // lMov
								.f.,;        // lNegoc
								.t.,;        // lReqZerada - Remove itens com qtde zerada
								.t.,;        // lRetAbe
								.t.,;        // lRetLib
								.f.,;        // lRetFec
								.f.,;        // lRetCan
								,;    		 // cLibVOO
								cFiltroSQL,;           // cFiltroSQL
								.f.,;        // lRetRem
								.f.)         // lAgrInc

		If !Empty(aPecaLib)
			 
			If aPecaLib[1][5] >= aParts[nX]["quantity"]
				aItem := {}
				aadd(aItem, { "VO3_NUMOSV" , VO1->VO1_NUMOSV , nil } )
				aadd(aItem, { "VO3_TIPTEM" , aPecaLib[1][3] , nil } )
				aadd(aItem, { "VO3_GRUITE" , aPecaLib[1][1] , nil } )
				aadd(aItem, { "VO3_CODITE" , aPecaLib[1][2] , nil } )
				aadd(aItem, { "VO3_QTDREQ" , aParts[nX]["quantity"] , nil } )
				aadd(aItem, { "VO3_QTDEST" , aParts[nX]["quantity"] , nil } )

				aadd(aItens,aItem)

				aParts[nX]["status"] := STR0005 //Complete
			Else
				aParts[nX]["status"] := STR0003 //Failure
				aParts[nX]["statusMessage"] := STR0006 //"The quantity returned is greater than the quantity requested..
			EndIf
		Else
			aParts[nX]["status"] := STR0003 //Failure
			aParts[nX]["statusMessage"] := STR0004 //"Part not found.
		EndIf
	Next nX

	MSExecAuto({|x,y,z| OFIOM020(,,x,y,z)},aItens,3 /* Devolucao */ )
	if lMsErroAuto
		RollbackSx8()
		MsUnlockAll()
		aRet[1] := .f.
		aRet[2] := MostraErro("\logsmil\workOrderPartReturnRequestedInFieldService.log")

	Else
		aRet[1] := .T.
		aRet[2] := aParts
	Endif

Return aRet

