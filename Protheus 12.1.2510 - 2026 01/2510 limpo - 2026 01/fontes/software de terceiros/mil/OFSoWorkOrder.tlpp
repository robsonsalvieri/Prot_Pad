#include "tlpp-core.th"
#include "totvs.ch"


/*/{Protheus.doc} OFSoWorkOrder
	Classe criada para retornar os dados conforme Customer Service do Service Operations

	@type function
	@author Iury Soares Azevedo
	@since 10/07/2025
/*/
class OFSoWorkOrder
	Public Method New()
	Public Method ToJson()
	Public Method SaveByJson()

	Public Method existsWorkOrder()
	Public Method existsWorkOrderSegment()
	Public Method existsNumOSV()
	Public Method existsSeqInc()
	Public Method getNumOSV()
	Public Method getSeqInc()
	Public method DocVersion()
	Public method Lock()
	Public method ReleaseLock()
	Public method IsLocked()
end class

/*/{Protheus.doc} New
	Construtor basico

	@type function
	@author Iury Soares Azevedo
	@since 10/07/2025
/*/
method New() class OFSoWorkOrder

return self



/*/{Protheus.doc} ToJson
	Retorna um JSON para enviar a API

	@type function
	@author Iury Soares Azevedo
	@since 10/07/2025
/*/
Method ToJson(lNewSegment) Class OFSoWorkOrder
	local jJson := JsonObject():New() as Json
	default lNewSegment := .T.

	jJson["salesOrderReferenceId"] := FGX_SetVlJson(VKD->VKD_INTID)
	jJson["woHeaderReferenceId"] := FGX_SetVlJson(VKC->VKC_REFID)
	jJson["woSegmentReferenceId"] := FGX_SetVlJson(VKD->VKD_REFID)

	If lNewSegment
		jJson["woSegmentNumber"] := FGX_SetVlJson(VKD->VKD_SEGMEN) 
		jJson["salesOrderNumber"] := FGX_SetVlJson(VKD->VKD_CODIGO)
		jJson["referenceId"] := FGX_SetVlJson(VKD->VKD_REFID)
		jJson["woHeaderNumber"] := FGX_SetVlJson(VKC->VKC_HEADER)
	EndIf
Return jJson



/*/{Protheus.doc} SaveByJson
	preenche o objeto com valores vindos da request e salva

	@type method
	@author Iury Soares Azevedo
	@since 10/07/2025
/*/
Method SaveByJson(jBody, cFilOSV, cNumOSV, cChassi) Class OFSoWorkOrder
	Local lRet := .T. as logical
	Local lSeek as logical
	Local cSeqInc := "" as character

	Begin Transaction
		VKC->(dbSelectArea("VKC"))
		VKC->(dbSetOrder(2))
		If !VKC->(MsSeek(xFilial("VKC")+jBody["data"]["woHeaderReferenceId"]))
			RecLock("VKC",.T.)
			VKC->VKC_FILIAL := xFilial("VKC")
			VKC->VKC_CODIGO := GetSXENum("VKC","VKC_CODIGO")
			VKC->VKC_HEADER := jBody["data"]["woHeaderNumber"]
			VKC->VKC_REFID  := jBody["data"]["woHeaderReferenceId"]
			VKC->VKC_IDLOC  := jBody["data"]["locationReferenceId"]
			VKC->VKC_FILOS  := cFilOSV
			VKC->VKC_NUMOSV := cNumOSV
			VKC->(MsUnLock())
			ConfirmSx8()
		EndIf
		
		If lRet
			VKD->(dbSelectArea("VKD"))
			VKD->(dbSetOrder(4))
			lSeek := VKD->(MsSeek(xFilial("VKD")+jBody["data"]["referenceId"]))
			
			If !lSeek
				cSeqInc := CreateSeqInc(VKC->VKC_CODIGO,cNumOSV, jBody["data"]["woSegmentNumber"],cChassi)
			EndIf
			

			RecLock("VKD",!lSeek)
			If !lSeek
				VKD->VKD_FILIAL := xFilial("VKD")
				VKD->VKD_CODIGO := GetSXENum("VKD","VKD_CODIGO")
				VKD->VKD_VKCCOD := VKC->VKC_CODIGO
				VKD->VKD_SEGMEN  := jBody["data"]["woSegmentNumber"]
				VKD->VKD_REFID  := jBody["data"]["referenceId"]
				VKD->VKD_INTID  :=  FwUUIDV4(.t.)
				VKD->VKD_SEQINC  :=  cSeqInc
				ConfirmSx8()
			EndIf
			VKD->VKD_CUSTOM  := jBody["data"]["customerReferenceId"]
			VKD->VKD_WORKLO  := jBody["data"]["jobCodeNumber"]
			VKD->VKD_JOBTYP  := jBody["data"]["jobCodeType"]
			VKD->(MsUnLock())
		EndIf
	End Transaction
Return lRet

/*/{Protheus.doc} CreateSeqInc
	//Na inclunsão de novo segmento, caso encontre algum outro segmento na OS
	//Ou seja se tiver um unico segmento não precisa criar incoveniente passando cria um incoveneinte para cada segmento
	//Deve se criar um INCOVENIENTE para efetuar a amarração 
	//Criação do incoveniente via RECLOCK ja qeu o mesmo não possui modelo definido ainda.

	@type function
	@author Iury Soares Azevedo
	@since 10/07/2025
/*/
Static Function CreateSeqInc(cVKCCOD, cNumOSV, cSegment,cChassi)
	Local cAlias := getNextAlias()
	Local cRet := ""

	BeginSql Alias cAlias
		SELECT
			MAX(VKD_SEQINC) MAX_SEQINC
		FROM	
			%Table:VKD% VKD
		WHERE
			VKD.%notDel%
			AND VKD_FILIAL = %xFilial:VKD%
			AND VKD_VKCCOD = %Exp:cVKCCOD%
	EndSql

	cRet := (cAlias)->MAX_SEQINC	
	
	(cAlias)->(dbCloseArea())
	
	cRet := Soma1(cRet)
	VST->(dbSelectArea("VST"))
	VST->(dbSetOrder(1))
	RecLock("VST",.T.)
		VST->VST_FILIAL := xFilial("VST")
		VST->VST_TIPO := "2"
		VST->VST_CODIGO := cNumOSV
		VST->VST_SEQINC := cRet
		VST->VST_DESINC := cRet + cSegment
		VST->VST_CHASSI := cChassi
		VST->VST_EXPSRV := '0'
		VST->VST_EXPPEC := '0'
	VST->(MsUnLock())
				
Return cRet

/*/{Protheus.doc} existsWorkOrder
	retorna se a Work Order existe no Protheus

	@type method
	@author Rubens Takahashi
	@since 10/07/2025
/*/
Method existsWorkOrder(WOReferenceID) Class OFSoWorkOrder
	local lRet := .F. as logical
	VKC->(dbSetOrder(2))
	lRet := VKC->(MsSeek(xFilial("VKC")+WOReferenceID))
return lRet

/*/{Protheus.doc} existsWorkOrderSegment
	retorna se a Work Order Segment existe no Protheus

	@type method
	@author Rubens Takahashi
	@since 10/07/2025
/*/
Method existsWorkOrderSegment(WOSegmentReferenceID) Class OFSoWorkOrder
	local lRet := .F. as logical
	VKD->(dbSetOrder(4))
	lRet := VKD->(MsSeek(xFilial("VKD")+WOSegmentReferenceID))
return lRet

/*/{Protheus.doc} existsNumOSV
	retorna se existe uma OS do protheus importante lembrar que o campo filos e gravado

	@type method
	@author Iury Soares Azevedo
	@since 25/07/2025
/*/
Method existsNumOSV(cFilOS, cNumOSV) Class OFSoWorkOrder
	local lRet := .F. as logical
	VKC->(dbSetOrder(3))
	lRet := VKC->(MsSeek(xFilial("VKC")+cFilOS+cNumOSV))
return lRet

/*/{Protheus.doc} existsSeqInc
	retorna se existe um segmento amarrado a sequencial de incoveniente

	@type method
	@author Iury Soares Azevedo
	@since 25/07/2025
/*/
Method existsSeqInc(cSeqInc) Class OFSoWorkOrder
	local lRet := .F. as logical
	VKD->(dbSetOrder(5))
	lRet := VKD->(MsSeek(xFilial("VKD")+VKC->VKC_CODIGO+cSeqInc))
return lRet

/*/{Protheus.doc} getNumOSV
	retorna o numero da OS no Protheus

	@type method
	@author Iury Soares Azevedo
	@since 10/07/2025
/*/
Method getNumOSV() Class OFSoWorkOrder
return VKC->VKC_NUMOSV

/*/{Protheus.doc} getSeqInc
	retorna o numero da SEQINC no Protheus de acordo com segmento posicionado

	@type method
	@author Iury Soares Azevedo
	@since 10/07/2025
/*/

Method getSeqInc() Class OFSoWorkOrder
return VKD->VKD_SEQINC

/*/{Protheus.doc} DocVersion
	Versão da documentação utlizada na integracao
	@type method
	@author Iury Soares Azevedo
	@since 27/08/2025
/*/
Method DocVersion() class OFSoWorkOrder
Return "1.0.14"

/*/{Protheus.doc} Lock
	Efetua o Lock da OS posicionada
	@type method
	@author Iury Soares Azevedo
	@since 27/08/2025
/*/
Method Lock(cId, cKey, cExpiresOn) class OFSoWorkOrder
	RecLock("VKC",.F.)
		VKC->VKC_LOCKID := cId
		VKC->VKC_LOCKKY := cKey
		VKC->VKC_LOCEXP := cExpiresOn
	VKC->(MsUnLock())
Return 

/*/{Protheus.doc} ReleaseLock
	Efetua a liberacao de Lock da OS posicionada
	@type method
	@author Iury Soares Azevedo
	@since 27/08/2025
/*/
Method ReleaseLock() class OFSoWorkOrder
	RecLock("VKC",.F.)
		VKC->VKC_LOCKID := ""
		VKC->VKC_LOCKKY := ""
		VKC->VKC_LOCEXP := ""
	VKC->(MsUnLock())
Return
/*/{Protheus.doc} IsLocked
	Efetua a liberacao de Lock da OS posicionada
	@type method
	@author Iury Soares Azevedo
	@since 27/08/2025
/*/
Method IsLocked() class OFSoWorkOrder
	Local lRet := .F. as logical
	Local nDif := 15 as Numeric
	Local nLimit := 15 as Numeric

	If !Empty(VKC->VKC_LOCEXP)
		//Se tiver marcado como locado verifica se ja nao expirou
		nDif := DiffDateTime(VKC->VKC_LOCEXP,FWTimeStamp(6))
		If nDif >= nLimit
			self:ReleaseLock()
		Else
			lRet := .T.
		EndIf
	EndIf
Return lRet

/*/{Protheus.doc} DiffDateTime
	Diferenca entre dois datetimes em minutos
	@type function
	@author Iury Soares Azevedo
	@since 27/08/2025
/*/
Static Function DiffDateTime(cDt1, cDt2)
    Local dDate1, dDate2
    Local cTime1, cTime2
    Local nH1, nM1, nS1
    Local nH2, nM2, nS2
    Local nRet := 0

    // Exemplo: "2019-08-20T14:02:00Z"
    // Pega apenas a parte da data -> "2019-08-20"
    dDate1 := StoD(StrTran(SubStr(cDt1,1,10),"-",""))
    dDate2 := StoD(StrTran(SubStr(cDt2,1,10),"-",""))

    // Pega apenas a hora -> "14:02:00"
    cTime1 := SubStr(cDt1,12,8)
    cTime2 := SubStr(cDt2,12,8)

    // Quebra hora:min:seg em números
    nH1 := Val(SubStr(cTime1,1,2))
    nM1 := Val(SubStr(cTime1,4,2))
    nS1 := Val(SubStr(cTime1,7,2))

    nH2 := Val(SubStr(cTime2,1,2))
    nM2 := Val(SubStr(cTime2,4,2))
    nS2 := Val(SubStr(cTime2,7,2))

    // Converte tudo para segundos absolutos desde 01/01/1970
    nTotal1 := (dDate1 - Ctod("01/01/1970")) * 86400 + (nH1 * 3600 + nM1 * 60 + nS1)
    nTotal2 := (dDate2 - Ctod("01/01/1970")) * 86400 + (nH2 * 3600 + nM2 * 60 + nS2)

    // Diferença em segundos
    nRet := nTotal2 - nTotal1

	// Diferenca em minutos
	nRet := nRet * 60

Return nRet
