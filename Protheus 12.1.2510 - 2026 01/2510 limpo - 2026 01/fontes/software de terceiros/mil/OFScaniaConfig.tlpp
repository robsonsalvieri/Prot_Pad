#INCLUDE "PROTHEUS.CH"
#INCLUDE "tlpp-core.th"



Class OfScaniaConfig
    public data jConfig as json
    private data cNomeConfig as character
    private data cIdVrn as character
    private data cEnvironment as character
    private data lForceEnv as logical

    public method new(cNomeConfig as character) as object
    public method getConfig() as json
    public method setForceEnv() as object
    public method saveConfig() as json
    public method getValue(cNomeConfig as character) as json

    private method _setCNomeConfig(cNomeConfig as character)  as character
    private method _setCIdVrn(cIdVrn as character) as character
    private method _getEnviroment(lForceEnv as logical) as character
EndClass


/*/{Protheus.doc} new
    Método construtor da classe
    @author Renan Migliaris
    @since 03/11/2025
    /*/
Method new(cNomeConfig, cIdVrn) class OfScaniaConfig
    ::_setCNomeConfig(cNomeConfig)
    ::_setCIdVrn(cIdVrn)
    ::lForceEnv := .f. //atribuindo diretamente aqui para verificar como falso e pegar da variavel da totvs como padrão
    ::jConfig := JsonObject():new()
Return self

/*/{Protheus.doc} _setcNomeConfig
    Seta o nome da configuração que vai ser buscada na VRN
    @author Renan Migliaris 
    @since 03/11/2025
    /*/
Method _setcNomeConfig(cNomeConfig) class OfScaniaConfig
    ::cNomeConfig := cNomeConfig
Return self

/*/{Protheus.doc} _setcNomeConfig
    Seta o id da vrn a ser buscado
    @author Renan Migliaris 
    @since 03/11/2025
    /*/
method _setCIdVrn(cIdVrn) class OfScaniaConfig
    ::cIdVrn := cIdVrn
return self


/*/{Protheus.doc} setForceEnv
    Vai forçar para o ambiente de producao 
    Ou seja, se passar como .t. vai ignorar a variável da totvs e vai forçar pra pegar a config de produção
    @author Renan Migliaris
    @since 03/11/2025
    /*/
Method setForceEnv(lForceEnv) class OfScaniaConfig
    ::lForceEnv := lForceEnv
Return self

/*/{Protheus.doc} _getEnviroment
    Vai pegar a variável da totvs e montar o ambiente que vai ser recuperado do json
    Existe um método para forçar esse ambiente 
    @author Renan Migliaris
    @since 03/11/2025
    /*/
Method _getEnviroment() class OfScaniaConfig
    local cEnvAuxiliar := ''
    
    if ::lForceEnv
        cEnvAuxiliar := '1'
    else
        cEnvAuxiliar := totvs.framework.environment.type.envAppGet(.T.)
    endif

    if cEnvAuxiliar == '3' .or. cEnvAuxiliar == '2'
        ::cEnvironment := 'HOMOLOGACAO'
    elseif cEnvAuxiliar == '1'
        ::cEnvironment := 'PRODUCAO'
    endif
Return ::cEnvironment

/*/{Protheus.doc} getConfig
    Vai buscar a braba
    @author Renan Migliaris
    @since 03/11/2025
    /*/
method getConfig() class OfScaniaConfig
    local jJsonAuxiliar := JsonObject():new()
    local jJsonFinal := JsonObject():new()
    local cAmbiente := self:_getEnviroment()
    local cFallBackAmbiente := ""

    Do Case
        case cAmbiente == "PRODUCAO"
            cFallBackAmbiente := "HOMOLOGACAO"
        case cAmbiente == "HOMOLOGACAO"
            cFallBackAmbiente := "PRODUCAO"
    EndCase


    DbSelectArea('VRN')
    DbSetOrder(1)
    if DbSeek(xFilial('VRN')+self:cIdVrn)
        jJsonAuxiliar:FromJson(VRN->VRN_CONFIG)
        if jJsonAuxiliar:HasProperty(self:cNomeConfig)
            if jJsonAuxiliar[self:cNomeConfig]:HasProperty(cAmbiente)
                jJsonFinal := jJsonAuxiliar[self:cNomeConfig][cAmbiente]
            else
                jJsonFinal := jJsonAuxiliar[self:cNomeConfig][cFallBackAmbiente]
            endif
        endif
    endif
    DbCloseArea()

    self:jConfig := jJsonFinal
    freeObj(jJsonAuxiliar)
return self:jConfig

/*/{Protheus.doc} saveConfig
    Salva Configuração da VRN
    @author Bruno Forcato
    @since 05/11/2025
/*/
method saveConfig(jConfig) class OfScaniaConfig
    local lfound := .f.
    self:jConfig := jConfig

	dbselectArea("VRN")
	dbSetOrder(1)
	lfound := dbSeek(xFilial("VRN") + self:CIDVRN)    
	if lfound
        reclock("VRN",.f.)
	    VRN->VRN_CONFIG := self:jConfig:toJSON()
    else
        reclock("VRN",.t.)
	    VRN->VRN_CODIGO := self:cIdVrn
        VRN->VRN_CONFIG := self:jConfig:toJSON()
    endif
    msUnlock()
return self:jConfig

/*/{Protheus.doc} getValue
    Vai buscar a braba
    @author Renan Migliaris
    @since 03/11/2025
    /*/
method getValue(cNomeConfig) class OfScaniaConfig
    local jJsonAuxiliar := JsonObject():new()
    local jJsonFinal := JsonObject():new()

    DbSelectArea('VRN')
    DbSetOrder(1)
    if DbSeek(xFilial('VRN')+self:CIDVRN)
        jJsonAuxiliar:FromJson(VRN->VRN_CONFIG)
        if jJsonAuxiliar:HasProperty(cNomeConfig)
            jJsonFinal := jJsonAuxiliar[cNomeConfig]
        endif
    endif
    DbCloseArea()

    freeObj(jJsonAuxiliar)
return jJsonFinal
