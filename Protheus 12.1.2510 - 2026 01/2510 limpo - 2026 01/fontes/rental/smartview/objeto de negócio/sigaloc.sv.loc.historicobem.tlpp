method getSchema() as object class historicobem

	self:addProperty("Filial",       "Filial",              "string", "Filial",              "FQ4_FILIAL")
	self:addProperty("CodBem",       "Cod. Bem",            "string", "Cod. Bem",            "FQ4_CODBEM")
	self:addProperty("Nome",         "Desc. Bem",           "string", "Desc. Bem",           "FQ4_NOME")
	self:addProperty("Status",       "Status",              "string", "Status",              "FQ4_STATUS")
	self:addProperty("DesStat",      "Desc. Status",        "string", "Desc. Status",        "FQ4_DESTAT")
	self:addProperty("Familia",      "Familia",             "string", "Familia",             "T6_CODFAMI")
	self:addProperty("DescFamilia",  "Desc. Familia",       "string", "Desc. Familia",       "T6_NOME")
	self:addProperty("TipMod",       "Tipo Modelo",         "string", "Tipo Modelo",         "FQ4_TIPMOD")
	self:addProperty("DescMod",      "Desc. Modelo",        "string", "Desc. Modelo",        "TQR_DESMOD")
	self:addProperty("Fabric",       "Fabricante",          "string", "Fabricante",          "FQ4_FABRIC")
	self:addProperty("NomeFab",      "Nome do Fabricante",  "string", "Nome do Fabricante",  "T7_NOME")
	self:addProperty("SubLoc",       "Sublocado",           "string", "Sublocado",           "FQ4_SUBLOC")
	self:addProperty("PosCon",       "Horimetro",           "number", "Horimetro",           "FQ4_POSCON")
	self:addProperty("CenTra",       "C. Trabalho",         "string", "C. Trabalho",         "FQ4_CENTRA")
	self:addProperty("NomTra",       "Nome Centrab",        "string", "Nome Centrab",        "FQ4_NOMTRA")
	self:addProperty("Serie",        "Serie",               "string", "Serie",               "FQ4_SERIE")
	self:addProperty("OS",           "Numero OS",           "string", "Numero OS",           "FQ4_OS")
	self:addProperty("TpServ",       "Tp. Servico",         "string", "Tp. Servico",         "FQ4_TPSERV")
	self:addProperty("PreLib",       "Prev. Libera",        "string", "Prev. Libera",        "FQ4_PRELIB")
	self:addProperty("Projet",       "Projeto",             "string", "Projeto",             "FQ4_PROJET")
	self:addProperty("Obra",         "Obra",                "string", "Obra",                "FQ4_OBRA")
	self:addProperty("AS",           "AS Atual",            "string", "AS Atual",            "FQ4_AS")
	self:addProperty("CodCli",       "Cli Obra",            "string", "Cli Obra",            "FQ4_CODCLI")
	self:addProperty("LojCli",       "Loja Cli.",           "string", "Loja Cli.",           "FQ4_LOJCLI")
	self:addProperty("NomCli",       "Nome Cliente",        "string", "Nome Cliente",        "FQ4_NOMCLI")
	self:addProperty("CodMun",       "Cod. Municipio",      "string", "Cod. Municipio",      "FQ4_CODMUN")
	self:addProperty("Munic",        "Municipio",           "string", "Municipio",           "FQ4_MUNIC")
	self:addProperty("Est",          "Estado",              "string", "Estado",              "FQ4_EST")
	self:addProperty("DtIni",        "Dt Inicio",           "date",   "Dt Inicio",           "FQ4_DTINI")
	self:addProperty("DtFim",        "Dt Fim",              "date",   "Dt Fim",              "FQ4_DTFIM")
	self:addProperty("PreDesp",      "Prev Retirad",        "date",   "Prev Retirad",        "FQ4_PREDES")
	self:addProperty("Log",          "Log registro",        "string", "Log registro",        "FQ4_LOG")
	self:addProperty("StSold",       "Status Anterior",     "string", "Status Anterior",     "FQ4_STSOLD")
	self:addProperty("DescStSold",   "Desc. Status Ant.",   "string", "Desc. Status Ant.",   "FQD_DESTQY")
	self:addProperty("Seq",          "Sequencia",           "string", "Sequencia",           "FQ4_SEQ")
	self:addProperty("CCusto",       "C. Custo",            "string", "C. Custo",            "CTT_CUSTO")
	self:addProperty("DescCCusto",   "Desc. C. Custo",      "string", "Desc. C. Custo",      "CTT_DESC01")
	self:addProperty("DtIniOcor",    "Dt. Ini. Ocorrencia", "date",   "Dt. Ini. Ocorrencia", "FQF_DTINI")
	self:addProperty("Hora",         "Hr. Ini. Ocorrencia", "string", "Hr. Ini. Ocorrencia", "FQF_HORA")
	self:addProperty("Codigo",       "Sub-Status",          "string", "Sub-Status",          "FQE_CODIGO")
	self:addProperty("Descri",       "Desc.Subst.",         "string", "Desc.Subst.",         "FQE_DESCRI")
	self:addProperty("Conta",        "Cont.Bem",            "number", "Cont.Bem",            "FQF_CONTA")
	self:addProperty("BemRes",       "Bem Reserva",         "string", "Bem Reserva",         "FQF_BEMRES")
	self:addProperty("ConRes",       "Cont.Reserva",        "number", "Cont.Reserva",        "FQF_CONRES")
	self:addProperty("SeqOcor",      "Seq. Ocorrencia",     "string", "Seq. Ocorrencia",     "FQF_SEQ")
	self:addProperty("Cod",          "Cod. Ocorrencia",     "string", "Cod. Ocorrencia",     "FQF_COD")
	self:addProperty("DppIni",       "Dt. Prev. Ini",       "date",   "Dt. Prev. Ini",       "FQF_DPPINI")
	self:addProperty("HppIni",       "Hr. Prev. Ini",       "string", "Hr. Prev. Ini",       "FQF_HPPINI")
	self:addProperty("DppFim",       "Dt. Prev. Fim",       "date",   "Dt. Prev. Fim",       "FQF_DPPFIM")
	self:addProperty("HppFim",       "Hr. Prev. Fim",       "string", "Hr. Prev. Fim",       "FQF_HPPFIM")
	self:addProperty("DprIni",       "Dt. Real Ini",        "date",   "Dt. real Ini",        "FQF_DPRINI")
	self:addProperty("HprIni",       "Hr. Real Ini",        "string", "Hr. Real Ini",        "FQF_HPRINI")
	self:addProperty("DprFim",       "Dt. real final",      "date",   "Dt. real final",      "FQF_DPRFIM")
	self:addProperty("HprFim",       "Hr. real final",      "string", "Hr. real final",      "FQF_HPRFIM")

	self:addParameter("01", "Bem de",      "string", .F., "", .F., .T., "ST9", "MV_PAR01")
	self:addParameter("02", "Bem até",     "string", .F., "", .F., .T., "ST9", "MV_PAR02")
	self:addParameter("03", "Familia de",  "string", .F., "", .F., .T., "ST6", "MV_PAR03")
	self:addParameter("04", "Familia até", "string", .F., "", .F., .T., "ST6", "MV_PAR04")
	self:addParameter("05", "Status de",   "string", .F., "", .F., .T., "FQD", "MV_PAR05")
	self:addParameter("06", "Status até",  "string", .F., "", .F., .T., "FQD", "MV_PAR06")
	self:addParameter("07", "Projeto de",  "string", .F., "", .F., .T., "FP0", "MV_PAR07")
	self:addParameter("08", "Projeto até", "string", .F., "", .F., .T., "FP0", "MV_PAR08")
	self:addParameter("09", "Obra de",     "string", .F., "", .F., .F., ""   , "MV_PAR09")
	self:addParameter("10", "Obra até",    "string", .F., "", .F., .F., ""   , "MV_PAR10")

return self:oSchema
