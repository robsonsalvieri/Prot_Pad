namespace totvs.protheus.rental.manutencao.integratedprovider

@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGALOC", tables="FQ4,FQF,ST6,CTT,TQR,ST7,FQE,FQD", name="Rental", country="ALL", initialRelease="12.1.2210")
class historicobem from totvs.framework.treports.integratedprovider.integratedprovider
public method new() as object
public method getData() as object
public method getSchema() as object 
endclass

/*/{PROTHEUS.DOC} historicobem
ITUP BUSINESS - TOTVS RENTAL
Declaração das classes
@AUTHOR LEONARDO PACHECO FUGA
@SINCE 08/12/2025
/*/

method new() class historicobem
	_Super:new()
	//Define a Área
	self:appendArea("Rental")

	//Define o nome do Objeto de Negócio
	self:setDisplayName("Histórico de Movimentações de Bens")

	//Define a descrição do Objeto de Negócio
	self:setDescription("Histórico de Movimentações de Bens")
return self

/*/{PROTHEUS.DOC} getData
ITUP BUSINESS - TOTVS RENTAL
Processamento do relatório
@AUTHOR LEONARDO PACHECO FUGA
@SINCE 08/12/2025
/*/

method getData(nPage as numeric, oFilter as object) as object class historicobem
local cQuery as character
Local aBind       := {}

	//Define a quantidade máxima por página (Default 100)
	self:setPageSize(20)

	jParams := oFilter:getParameters() //metodo para retorno do json dos parâmetros

	If type("jParams['01'][1]") <> "C" .or. file("\SYSTEM\LOCSV026.TXT")
		jParams['01'][1] := space(TamSx3("FQ4_CODBEM")[1])
	EndIf
	If empty(jParams['01'][1])
		jParams['01'][1] := space(TamSx3("FQ4_CODBEM")[1])
	EndIf

	If type("jParams['02'][1]") <> "C" .or. file("\SYSTEM\LOCSV026.TXT")
		jParams['02'][1] := space(TamSx3("FQ4_CODBEM")[1])
	EndIf
	If empty(jParams['02'][1])
		jParams['02'][1] := space(TamSx3("FQ4_CODBEM")[1])
	EndIf

	If type("jParams['03'][1]") <> "C" .or. file("\SYSTEM\LOCSV026.TXT")
		jParams['03'][1] := space(TamSx3("FQ4_CODFAM")[1])
	EndIf
	If empty(jParams['03'][1])
		jParams['03'][1] := space(TamSx3("FQ4_CODFAM")[1])
	EndIf

	If type("jParams['04'][1]") <> "C" .or. file("\SYSTEM\LOCSV026.TXT")
		jParams['04'][1] := space(TamSx3("FQ4_CODFAM")[1])
	EndIf
	If empty(jParams['04'][1])
		jParams['04'][1] := space(TamSx3("FQ4_CODFAM")[1])
	EndIf

	If type("jParams['05'][1]") <> "C" .or. file("\SYSTEM\LOCSV026.TXT")
		jParams['05'][1] := space(TamSx3("FQ4_STATUS")[1])
	EndIf
	If empty(jParams['05'][1])
		jParams['05'][1] := space(TamSx3("FQ4_STATUS")[1])
	EndIf

	If type("jParams['06'][1]") <> "C" .or. file("\SYSTEM\LOCSV026.TXT")
		jParams['06'][1] := space(TamSx3("FQ4_STATUS")[1])
	EndIf
	If empty(jParams['06'][1])
		jParams['06'][1] := space(TamSx3("FQ4_STATUS")[1])
	EndIf

	If type("jParams['07'][1]") <> "C" .or. file("\SYSTEM\LOCSV026.TXT")
		jParams['07'][1] := space(TamSx3("FQ4_PROJET")[1])
	EndIf
	If empty(jParams['07'][1])
		jParams['07'][1] := space(TamSx3("FQ4_PROJET")[1])
	EndIf

	If type("jParams['08'][1]") <> "C" .or. file("\SYSTEM\LOCSV026.TXT")
		jParams['08'][1] := space(TamSx3("FQ4_PROJET")[1])
	EndIf
	If empty(jParams['08'][1])
		jParams['08'][1] := space(TamSx3("FQ4_PROJET")[1])
	EndIf

	If type("jParams['09'][1]") <> "C" .or. file("\SYSTEM\LOCSV026.TXT")
		jParams['09'][1] := space(TamSx3("FQ4_OBRA")[1])
	EndIf
	If empty(jParams['09'][1])
		jParams['09'][1] := space(TamSx3("FQ4_OBRA")[1])
	EndIf

	If type("jParams['10'][1]") <> "C" .or. file("\SYSTEM\LOCSV026.TXT")
		jParams['10'][1] := space(TamSx3("FQ4_OBRA")[1])
	EndIf
	If empty(jParams['10'][1])
		jParams['10'][1] := space(TamSx3("FQ4_OBRA")[1])
	EndIf
	
	cQuery := " SELECT "
	cQuery += " FQ4.FQ4_FILIAL, FQ4.FQ4_CODBEM, FQ4.FQ4_NOME, FQ4.FQ4_STATUS, FQ4.FQ4_DESTAT, FQ4.FQ4_TIPMOD, TQR.TQR_DESMOD, "
	cQuery += " FQ4.FQ4_FABRIC, T7_NOME, FQ4.FQ4_POSCON, FQ4.FQ4_CENTRA, FQ4.FQ4_NOMTRA, FQ4.FQ4_SERIE, FQ4.FQ4_OS, "   
	cQuery += " CASE "
	cQuery += " WHEN FQ4.FQ4_SUBLOC = 'S' THEN 'SIM' "
	cQuery += " WHEN FQ4.FQ4_SUBLOC = 'N' THEN 'NAO' "
	cQuery += " WHEN FQ4.FQ4_SUBLOC = ' ' THEN 'NAO' "
	cQuery += " ELSE ' ' "
	cQuery += " END FQ4_SUBLOC, "
	cQuery += " FQ4.FQ4_TPSERV, FQ4.FQ4_PRELIB, FQ4.FQ4_PROJET, FQ4.FQ4_OBRA, FQ4.FQ4_AS, FQ4.FQ4_CODCLI, "
	cQuery += " FQ4.FQ4_NOMCLI, FQ4.FQ4_CODMUN, FQ4.FQ4_MUNIC, FQ4.FQ4_EST, FQ4.FQ4_DTINI, FQ4.FQ4_DTFIM, FQ4.FQ4_PREDES, "
	cQuery += " FQ4.FQ4_LOG, FQ4.FQ4_STSOLD, FQD.FQD_DESTQY, FQ4.FQ4_LOJCLI, FQ4.FQ4_SEQ, "

	cQuery += " COALESCE(ST6.T6_CODFAMI,' ') T6_CODFAMI, "
	cQuery += " COALESCE(ST6.T6_NOME,' ') T6_NOME, "
	cQuery += " COALESCE(CTT.CTT_CUSTO, 'SEM CENTRO DE CUSTO') CTT_CUSTO, "
	cQuery += " COALESCE(CTT.CTT_DESC01,'SEM CENTRO DE CUSTO') CTT_DESC01, "     
	cQuery += " COALESCE(FQF.FQF_DTINI, ' ') FQF_DTINI, "
	cQuery += " COALESCE(FQF.FQF_HORA, ' ') FQF_HORA, " 
	cQuery += " COALESCE(FQE.FQE_CODIGO, ' ') FQE_CODIGO, "
	cQuery += " COALESCE(FQE.FQE_DESCRI, ' ') FQE_DESCRI, "
	cQuery += " COALESCE(FQF.FQF_CONTA, 0) FQF_CONTA, " 
	cQuery += " COALESCE(FQF.FQF_BEMRES, ' ') FQF_BEMRES, "
	cQuery += " COALESCE(FQF.FQF_CONRES, 0) FQF_CONRES, "
	cQuery += " COALESCE(FQF.FQF_SEQ, ' ') FQF_SEQ, "   
	cQuery += " COALESCE(FQF.FQF_OS, ' ') FQF_OS, "   
	cQuery += " COALESCE(FQF.FQF_COD, ' ') FQF_COD, "   
	cQuery += " COALESCE(FQF.FQF_DPPINI, ' ') FQF_DPPINI, "
	cQuery += " COALESCE(FQF.FQF_HPPINI, ' ') FQF_HPPINI, "
	cQuery += " COALESCE(FQF.FQF_DPPFIM, ' ') FQF_DPPFIM, "
	cQuery += " COALESCE(FQF.FQF_HPPFIM, ' ') FQF_HPPFIM, "
	cQuery += " COALESCE(FQF.FQF_DPRINI, ' ') FQF_DPRINI, "
	cQuery += " COALESCE(FQF.FQF_HPRINI, ' ') FQF_HPRINI, "
	cQuery += " COALESCE(FQF.FQF_DPRFIM, ' ') FQF_DPRFIM, "
	cQuery += " COALESCE(FQF.FQF_HPRFIM, ' ') FQF_HPRFIM "

	cQuery += " FROM "+RetSqlName("FQ4")+" FQ4 "

	cQuery += " LEFT JOIN "+RetSqlName("FQF")+" FQF ON "
	cQuery += " FQF.FQF_FILIAL = '"+xFilial("FQF")+ "' AND "
	cQuery += " FQF.FQF_CODBEM = FQ4.FQ4_CODBEM AND "
	cQuery += " FQF.D_E_L_E_T_ = ' ' "

	cQuery += " LEFT JOIN "+RetSqlName("FQE")+" FQE ON "
	cQuery += " FQE.FQE_FILIAL = '"+xFilial("FQE")+ "' AND "
	cQuery += " FQE.FQE_CODIGO = FQF.FQF_SUBST AND "
	cQuery += " FQE.D_E_L_E_T_ = ' ' "

	cQuery += " LEFT JOIN "+RetSqlName("ST6")+" ST6 "
	cQuery += " ON ST6.T6_FILIAL = '"+xFilial("ST6")+ "' "   
	cQuery += " AND ST6.T6_CODFAMI = FQ4.FQ4_CODFAM AND "  
	cQuery += " ST6.D_E_L_E_T_ = ' ' "

	cQuery += " LEFT JOIN "+RetSqlName("TQR")+" TQR ON "
	cQuery += " TQR.TQR_FILIAL = '"+xFilial("TQR")+ "' AND "
	cQuery += " TQR.TQR_TIPMOD = FQ4.FQ4_TIPMOD AND "
	cQuery += " TQR.D_E_L_E_T_ = ' ' "

	cQuery += " LEFT JOIN "+RetSqlName("ST7")+" ST7 ON "
	cQuery += " ST7.T7_FILIAL = '"+xFilial("ST7")+ "' AND "
	cQuery += " ST7.T7_FABRICA = FQ4.FQ4_FABRIC AND "
	cQuery += " ST7.D_E_L_E_T_ = ' ' "

	cQuery += " LEFT JOIN "+RetSqlName("CTT")+" CTT ON "
	cQuery += " CTT.CTT_FILIAL = '"+xFilial("CTT")+ "' AND "
	cQuery += " CTT.CTT_CUSTO = FQF.FQF_CC AND "
	cQuery += " CTT.D_E_L_E_T_ = ' ' "

	cQuery += " LEFT JOIN "+RetSqlName("FQD")+" FQD ON "
	cQuery += " FQD.FQD_FILIAL = '"+xFilial("FQD")+ "' AND "
	cQuery += " FQD.FQD_STATQY = FQ4.FQ4_STSOLD AND "
	cQuery += " FQD.D_E_L_E_T_ = ' ' "

	cQuery += " WHERE FQ4.FQ4_FILIAL = '"+xFilial("FQ4")+ "' AND "
	cQuery += " FQ4.FQ4_CODBEM >= ? AND "
	AAdd(aBind, {jParams['01'][1], "S"})
	cQuery += " FQ4.FQ4_CODBEM <= ? AND "
	AAdd(aBind, {jParams['02'][1], "S"})
	cQuery += " FQ4.FQ4_CODFAM >= ? AND "
	AAdd(aBind, {jParams['03'][1], "S"})
	cQuery += " FQ4.FQ4_CODFAM <= ? AND "
	AAdd(aBind, {jParams['04'][1], "S"})
	cQuery += " FQ4.FQ4_STATUS >= ? AND "
	AAdd(aBind, {jParams['05'][1], "S"})
	cQuery += " FQ4.FQ4_STATUS <= ? AND "
	AAdd(aBind, {jParams['06'][1], "S"})
	cQuery += " FQ4.FQ4_PROJET >= ? AND "
	AAdd(aBind, {jParams['07'][1], "S"})
	cQuery += " FQ4.FQ4_PROJET <= ? AND "
	AAdd(aBind, {jParams['08'][1], "S"})
	cQuery += " FQ4.FQ4_OBRA >= ? AND "
	AAdd(aBind, {jParams['09'][1], "S"})
	cQuery += " FQ4.FQ4_OBRA <= ? AND "
	AAdd(aBind, {jParams['10'][1], "S"})
	cQuery += " FQ4.D_E_L_E_T_ = ' ' "
		  
	cQuery := CHANGEQUERY(cQuery)
	cQuery := JurTRepBin(cQuery, aBind)
	self:setOrder("FQ4.FQ4_CODBEM")
	self:setQuery(cQuery)

return self:oData

/*/{PROTHEUS.DOC} getShema
