#include "msobject.ch"
#include "TOTVS.ch"
#include "totvs.framework.treports.integratedprovider.th"

/*/{PROTHEUS.DOC} sigaloc.sv.loc.titulosrental.tlpp
ITUP BUSINESS - TOTVS RENTAL
Relatório de Titulos do Rental
@TYPE FUNCTION
@AUTHOR LEONARDO PACHECO FUGA
@SINCE 02/09/2025
/*/

namespace totvs.protheus.rental.manutencao.integratedprovider

@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGALOC", tables="FP0,FP1,FPA,SE1,FQB,FPZ,SD2", name="Rental", country="ALL", initialRelease="12.1.2210")
class titulosrental from totvs.framework.treports.integratedprovider.integratedprovider
data oTempTable as object
public method new() as object
public method getData() as object
public method getSchema() as object 
endclass

/*/{PROTHEUS.DOC} sigaloc.sv.loc.titulosrental.tlpp
ITUP BUSINESS - TOTVS RENTAL
@TYPE Method new
Method para definição do caminho, nome e descrição do objeto de negócio
@AUTHOR LEONARDO PACHECO FUGA
@SINCE 02/09/2025
/*/

method new() class titulosrental
	_Super:new()
	//Define a Área
	self:appendArea("Rental")

	//Define o nome do Objeto de Negócio
	self:setDisplayName("Titulos do Rental")

	//Define a descrição do Objeto de Negócio
	self:setDescription("Titulos do Rental")
return self

/*/{PROTHEUS.DOC} sigaloc.sv.loc.titulosrental.tlpp
ITUP BUSINESS - TOTVS RENTAL
@TYPE Method getData
Method para etrair os dados e dar o funcionamento da consulta
@AUTHOR LEONARDO PACHECO FUGA
@SINCE 02/09/2025
/*/
method getData(nPage as numeric, oFilter as object) as object class titulosrental
local cQuery as character
local cAlias as character
local oExec as object
Local aFields
Local cComando
Local aBind   := {}
private jParams := Nil

	If select("LOC017B") > 0
		LOC017B->(dbCloseArea())
	EndIf
    self:oTempTable := FWTemporaryTable():New("LOC017B")

    aFields := {}
	aAdd(aFields, {"FILIAL",  "C", TamSx3("E1_FILIAL")[1], 0})
	aAdd(aFields, {"TITULO",  "C", TamSx3("E1_NUM")[1], 0})
	aAdd(aFields, {"PREFIXO", "C", TamSx3("E1_PREFIXO")[1], 0})
	aAdd(aFields, {"PARCELA", "C", TamSx3("E1_PARCELA")[1], 0})
    aAdd(aFields, {"NATUREZA","C", TamSx3("E1_NATUREZ")[1], 0})
	aAdd(aFields, {"CLIENTE", "C", TamSx3("E1_CLIENTE")[1], 0})
	aAdd(aFields, {"LOJA",    "C", TamSx3("E1_LOJA")[1], 0})
	aAdd(aFields, {"EMISSAO", "D", TamSx3("E1_EMISSAO")[1], 0})
	aAdd(aFields, {"VENCTO",  "D", TamSx3("E1_VENCTO")[1], 0})
	aAdd(aFields, {"VENCREA", "D", TamSx3("E1_VENCREA")[1], 0})
	aAdd(aFields, {"DIFDATA", "N", 4, 0})
	aAdd(aFields, {"VALOR",   "N", TamSx3("E1_VALOR")[1], TamSx3("E1_VALOR")[2]})
	aAdd(aFields, {"VALJUR",  "N", TamSx3("E1_VALJUR")[1], TamSx3("E1_VALJUR")[2]})
	aAdd(aFields, {"PORCJUR", "N", TamSx3("E1_PORCJUR")[1], TamSx3("E1_PORCJUR")[2]})
	aAdd(aFields, {"MOEDA",   "N", TamSx3("E1_MOEDA")[1], 0})
	aAdd(aFields, {"BAIXA",   "D", TamSx3("E1_BAIXA")[1], 0})
	aAdd(aFields, {"SALDO",   "N", TamSx3("E1_SALDO")[1], TamSx3("E1_SALDO")[2]})
	aAdd(aFields, {"PROJETO", "C", TamSx3("FPZ_PROJET")[1], 0})
	aAdd(aFields, {"OBRA",    "C", TamSx3("FPZ_OBRA")[1], 0})
	aAdd(aFields, {"A_S",     "C", TamSx3("FPZ_AS")[1], 0})
	aAdd(aFields, {"CLIFAT",  "C", TamSx3("E1_CLIENTE")[1], 0})
	aAdd(aFields, {"LOJFAT",  "C", TamSx3("E1_LOJA")[1], 0})

    //Define as colunas usadas
    self:oTempTable:SetFields( aFields )

    //Efetua a criação da tabela
    self:oTempTable:Create()

	//Define a quantidade máxima por página (Default 100)
	self:setPageSize(20)

	jParams := oFilter:getParameters() //metodo para retorno do json dos parâmetros

	//Define o preenchimento dos filtros caso estiverem em branco
	If type("jParams['01'][1]") <> "C" .or. file("\SYSTEM\LOCSV017.TXT")
		jParams['01'][1] := space(TamSx3("FP0_CLI")[1])
	EndIf
	If empty(jParams['01'][1])
		jParams['01'][1] := space(TamSx3("FP0_CLI")[1])
	EndIf

	If type("jParams['02'][1]") <> "C" .or. file("\SYSTEM\LOCSV017.TXT")
		jParams['02'][1] := space(TamSx3("FP0_LOJA")[1])
	EndIf
	If empty(jParams['02'][1])
		jParams['02'][1] := space(TamSx3("FP0_LOJA")[1])
	EndIf

	If type("jParams['03'][1]") <> "C" .or. file("\SYSTEM\LOCSV017.TXT")
		jParams['03'][1] := space(TamSx3("FP0_CLI")[1])
	EndIf
	If empty(jParams['03'][1])
		jParams['03'][1] := space(TamSx3("FP0_CLI")[1])
	EndIf

	If type("jParams['04'][1]") <> "C" .or. file("\SYSTEM\LOCSV017.TXT")
		jParams['04'][1] := space(TamSx3("FP0_LOJA")[1])
	EndIf
	If empty(jParams['04'][1])
		jParams['04'][1] := space(TamSx3("FP0_LOJA")[1])
	EndIf

	If type("jParams['05'][1]") <> "C" .or. file("\SYSTEM\LOCSV017.TXT")
		jParams['05'][1] := space(TamSx3("FPZ_PROJET")[1])
	EndIf
	If empty(jParams['05'][1])
		jParams['05'][1] := space(TamSx3("FPZ_PROJET")[1])
	EndIf

	If type("jParams['06'][1]") <> "C" .or. file("\SYSTEM\LOCSV017.TXT")
		jParams['06'][1] := space(TamSx3("FPZ_PROJET")[1])
	EndIf
	If empty(jParams['06'][1])
		jParams['06'][1] := space(TamSx3("FPZ_PROJET")[1])
	EndIf

	If type("jParams['07'][1]") <> "C" .or. file("\SYSTEM\LOCSV017.TXT")
		jParams['07'][1] := space(TamSx3("FPZ_OBRA")[1])
	EndIf
	If empty(jParams['07'][1])
		jParams['07'][1] := space(TamSx3("FPZ_OBRA")[1])
	EndIf

	If type("jParams['08'][1]") <> "C" .or. file("\SYSTEM\LOCSV017.TXT")
		jParams['08'][1] := space(TamSx3("FPZ_OBRA")[1])
	EndIf
	If empty(jParams['08'][1])
		jParams['08'][1] := space(TamSx3("FPZ_OBRA")[1])
	EndIf

	jParams['09'][1] := StrTran(SubStr(jParams["09"][1],1,8),"-","") // "20000101"
	If empty(jParams['09'][1])
		jParams['09'][1] := space(8)
	EndIf

	jParams['10'][1] := StrTran(SubStr(jParams["10"][1],1,8),"-","") // "20000101"
	If empty(jParams['10'][1])
		jParams['10'][1] := space(8)
	EndIf

	jParams['11'][1] := StrTran(SubStr(jParams["11"][1],1,8),"-","") // "20000101"
	If empty(jParams['11'][1])
		jParams['11'][1] := space(8)
	EndIf

	jParams['12'][1] := StrTran(SubStr(jParams["12"][1],1,8),"-","") // "20000101"
	If empty(jParams['12'][1])
		jParams['12'][1] := space(8)
	EndIf
	
	If file("\SYSTEM\LOCSV019.TXT")
		LOCSV017A()
	EndIF
	//TABELA 1 (FPZ)
	If jParams['13'][1] == '1' .or. jParams['13'][1] == '3'
		If select("TRBSE1") > 0
			TRBSE1->(dbCloseArea())
		EndIf
		cQuery := " SELECT "
		cQuery += " SE1.E1_FILIAL, SE1.E1_NUM, SE1.E1_PREFIXO, SE1.E1_PARCELA, SE1.E1_NATUREZ, SE1.E1_CLIENTE, SE1.E1_LOJA, SE1.E1_EMISSAO, "
		cQuery += " SE1.E1_VENCTO, SE1.E1_VENCREA, SE1.E1_VALOR, SE1.E1_VALJUR, SE1.E1_PORCJUR, SE1.E1_MOEDA, "
		cQuery += " SE1.E1_BAIXA, SE1.E1_SALDO, "
		cQuery += " FPZ.FPZ_PROJET, FPZ.FPZ_OBRA, FPZ.FPZ_AS, "
		cQuery += " CASE "
		cQuery += " WHEN FPA.FPA_CLIFAT <> '' THEN FPA.FPA_CLIFAT "
		cQuery += " WHEN FPA.FPA_CLIFAT = '' AND FP1.FP1_CLIDES <> '' THEN FP1.FP1_CLIDES "
		cQuery += " WHEN FPA.FPA_CLIFAT = '' AND FP1.FP1_CLIDES = '' THEN FP0.FP0_CLI "
		cQuery += " END CLIFAT, "
		cQuery += " CASE "
		cQuery += " WHEN FPA.FPA_LOJFAT <> '' THEN FPA.FPA_LOJFAT "
		cQuery += " WHEN FPA.FPA_LOJFAT = '' AND FP1.FP1_LOJDES <> '' THEN FP1.FP1_LOJDES "
		cQuery += " WHEN FPA.FPA_LOJFAT = '' AND FP1.FP1_LOJDES = '' THEN FP0.FP0_LOJA "
		cQuery += " END LOJFAT, "

		If "ORACLE" $ Upper(TCGetDB()) .or. "POSTGRES" $ Upper(TCGetDB()) .or. file("\SYSTEM\LOCSV018.TXT")
			cQuery += " CASE "
			cQuery += " WHEN SE1.E1_VENCREA <> ' ' AND SE1.E1_VENCREA < ? THEN TO_DATE(SE1.E1_VENCREA, 'YYYYMMDD') - TO_DATE(?, 'YYYYMMDD') " //1
			AAdd(aBind, dtos(dDataBase))
			AAdd(aBind, dtos(dDataBase))
			cQuery += " ELSE 0 "
			cQuery += " END DIFDATA "
			If file("\SYSTEM\LOCSV018.TXT")
				return 
			EndIf
		Else
			cQuery += " CASE "
			cQuery += " WHEN SE1.E1_VENCREA <> ' ' AND SE1.E1_VENCREA < ? THEN DATEDIFF(DAY,SE1.E1_VENCREA, ?) " //1
			AAdd(aBind, dtos(dDataBase))
			AAdd(aBind, dtos(dDataBase))
			cQuery += " ELSE 0 "
			cQuery += " END DIFDATA "
		EndIF

		cQuery += " FROM " + RetSqlName("SE1") + " SE1 "

		cQuery += " INNER JOIN " + RetSqlName("SD2") + " SD2 ON "
		cQuery += " SD2.D2_FILIAL = '"+xFilial("SD2")+"' AND "
		cQuery += " SD2.D2_DOC = SE1.E1_NUM AND "
		cQuery += " SD2.D2_SERIE = SE1.E1_PREFIXO AND "
		cQuery += " SD2.D_E_L_E_T_ = ' ' "

		cQuery += " INNER JOIN " + RetSqlName("FPZ") + " FPZ ON "
		cQuery += " FPZ.FPZ_FILIAL = '"+xFilial("FPZ")+"' AND "
		cQuery += " FPZ.FPZ_PEDVEN = SD2.D2_PEDIDO AND "
		cQuery += " FPZ.FPZ_ITMFPZ = SD2.D2_ITEMPV AND "
		cQuery += " FPZ.FPZ_PROJET >= ? AND "
		AAdd(aBind, jParams['05'][1])
		cQuery += " FPZ.FPZ_PROJET <= ? AND "
		AAdd(aBind, jParams['06'][1])
		cQuery += " FPZ.FPZ_OBRA >= ? AND "
		AAdd(aBind, jParams['07'][1])
		cQuery += " FPZ.FPZ_OBRA <= ? AND "
		AAdd(aBind, jParams['08'][1])
		cQuery += " FPZ.D_E_L_E_T_ = ' ' "

		cQuery += " INNER JOIN " + RetSqlName("FPA") + " FPA ON " 
		cQuery += " FPA.FPA_FILIAL = '"+xFilial("FPA")+"' AND "
		cQuery += " FPA.FPA_PROJET = FPZ.FPZ_PROJET AND "
		cQuery += " FPA.FPA_AS = FPZ.FPZ_AS AND "
		cQuery += " FPA.D_E_L_E_T_ = ' ' "

		cQuery += " INNER JOIN " + RetSqlName("FP1") + " FP1 ON "
		cQuery += " FP1.FP1_FILIAL = '"+xFilial("FP1")+"' AND "
		cQuery += " FP1.FP1_PROJET = FPZ.FPZ_PROJET AND "
		cQuery += " FP1.D_E_L_E_T_ = ' ' "

		cQuery += " INNER JOIN " + RetSqlName("FP0") + " FP0 ON "
		cQuery += " FP0.FP0_FILIAL = '"+xFilial("FP0")+"' AND "
		cQuery += " FP0.FP0_PROJET = FPZ.FPZ_PROJET AND "
		cQuery += " FP0.D_E_L_E_T_ = ' ' "

		cQuery += " WHERE "
		cQuery += " FPZ.FPZ_PROJET <> ' ' AND "
		cQuery += " SE1.E1_CLIENTE >= ? AND "
		AAdd(aBind, jParams['01'][1])
		cQuery += " SE1.E1_LOJA >= ? AND "
		AAdd(aBind, jParams['02'][1])
		cQuery += " SE1.E1_CLIENTE <= ? AND "
		AAdd(aBind, jParams['03'][1])
		cQuery += " SE1.E1_LOJA <= ? AND "
		AAdd(aBind, jParams['04'][1])
		cQuery += " SE1.E1_EMISSAO BETWEEN ? AND ? AND "
		cQuery += " SE1.E1_VENCTO BETWEEN ? AND ? AND "
		AAdd(aBind, jParams['09'][1])
		AAdd(aBind, jParams['10'][1])
		AAdd(aBind, jParams['11'][1])
		AAdd(aBind, jParams['12'][1])

		If jParams['14'][1] == '1'
			cQuery += " SE1.E1_SALDO = 0 AND "
		EndIf

		If jParams['14'][1] == '2'
			cQuery += " SE1.E1_SALDO <> 0 AND "
		EndIf

		If jParams['14'][1] == '3'
			cQuery += " SE1.E1_SALDO <> SE1.E1_VALOR AND SE1.E1_SALDO <> 0 AND "
		EndIf

		If jParams['14'][1] == '4'
			cQuery += " SE1.E1_SALDO >= 0 AND "
		EndIf
		cQuery += " SE1.D_E_L_E_T_ = ' ' "
		cQuery := CHANGEQUERY(cQuery)
		MPSysOpenQuery(cQuery,"TRBSE1",,,aBind)
		aBind := {}
		While !TRBSE1->(Eof())
			LOC017B->(RecLock("LOC017B",.T.))
			LOC017B->FILIAL   := TRBSE1->E1_FILIAL
			LOC017B->TITULO   := TRBSE1->E1_NUM
			LOC017B->PREFIXO  := TRBSE1->E1_PREFIXO
			LOC017B->PARCELA  := TRBSE1->E1_PARCELA
			LOC017B->NATUREZA := TRBSE1->E1_NATUREZ
			LOC017B->CLIENTE  := TRBSE1->E1_CLIENTE
			LOC017B->LOJA     := TRBSE1->E1_LOJA
			LOC017B->EMISSAO  := STOD(TRBSE1->E1_EMISSAO)
			LOC017B->VENCTO   := STOD(TRBSE1->E1_VENCTO)
			LOC017B->VENCREA  := STOD(TRBSE1->E1_VENCREA)
			LOC017B->DIFDATA  := TRBSE1->DIFDATA
			LOC017B->VALOR    := TRBSE1->E1_VALOR
			LOC017B->VALJUR   := TRBSE1->E1_VALJUR
			LOC017B->PORCJUR  := TRBSE1->E1_PORCJUR
			LOC017B->MOEDA    := TRBSE1->E1_MOEDA
			LOC017B->BAIXA    := STOD(TRBSE1->E1_BAIXA)
			LOC017B->SALDO    := TRBSE1->E1_SALDO
			LOC017B->PROJETO  := TRBSE1->FPZ_PROJET
			LOC017B->OBRA     := TRBSE1->FPZ_OBRA
			LOC017B->A_S      := TRBSE1->FPZ_AS
			LOC017B->CLIFAT   := TRBSE1->CLIFAT
			LOC017B->LOJFAT   := TRBSE1->LOJFAT
			LOC017B->(MsUnlock())
			TRBSE1->(dbSkip())
		EndDo
		TRBSE1->(dbCloseArea())
	EndIf

	//TABELA 2 (STJ)
	If jParams['13'][1] == '2' .or. jParams['13'][1] == '3'
		If select("TRBFQB") > 0
			TRBFQB->(dbCloseArea())
		EndIf
		cQuery := " SELECT "
		cQuery += " SE1.E1_FILIAL, SE1.E1_NUM, SE1.E1_PREFIXO, SE1.E1_PARCELA, SE1.E1_NATUREZ, SE1.E1_CLIENTE, SE1.E1_LOJA, "
		cQuery += " SE1.E1_EMISSAO, SE1.E1_VENCTO, SE1.E1_VENCREA, SE1.E1_VALOR, SE1.E1_VALJUR, SE1.E1_PORCJUR, SE1.E1_MOEDA, "
		cQuery += " SE1.E1_BAIXA, SE1.E1_SALDO, "
		cQuery += " FQB.FQB_PROJET, FQB.FQB_OBRA, FQB.FQB_AS, "
		cQuery += " CASE "
		cQuery += " WHEN FPA.FPA_CLIFAT <> '' THEN FPA.FPA_CLIFAT "
		cQuery += " WHEN FPA.FPA_CLIFAT = '' AND FP1.FP1_CLIDES <> '' THEN FP1.FP1_CLIDES "
		cQuery += " WHEN FPA.FPA_CLIFAT = '' AND FP1.FP1_CLIDES = '' THEN FP0.FP0_CLI "
		cQuery += " END CLIFAT, "

		cQuery += " CASE "
		cQuery += " WHEN FPA.FPA_LOJFAT <> '' THEN FPA.FPA_LOJFAT "
		cQuery += " WHEN FPA.FPA_LOJFAT = '' AND FP1.FP1_LOJDES <> '' THEN FP1.FP1_LOJDES "
		cQuery += " WHEN FPA.FPA_LOJFAT = '' AND FP1.FP1_LOJDES = '' THEN FP0.FP0_LOJA "
		cQuery += " END LOJFAT, "

		If "ORACLE" $ Upper(TCGetDB()) .or. "POSTGRES" $ Upper(TCGetDB()) .or. file("\SYSTEM\LOCSV019.TXT")
			cQuery += " CASE "
			cQuery += " WHEN SE1.E1_VENCREA <> ' ' AND SE1.E1_VENCREA < ? THEN TO_DATE(SE1.E1_VENCREA, 'YYYYMMDD') - TO_DATE(?, 'YYYYMMDD') " //1
			AAdd(aBind, dtos(dDataBase))
			AAdd(aBind, dtos(dDataBase))
			cQuery += " ELSE 0 "
			cQuery += " END DIFDATA "
			If file("\SYSTEM\LOCSV019.TXT")
				return 
			EndIf
		Else
			cQuery += " CASE "
			cQuery += " WHEN SE1.E1_VENCREA <> ' ' AND SE1.E1_VENCREA < ? THEN DATEDIFF(DAY,SE1.E1_VENCREA, ?) " //1
			AAdd(aBind, dtos(dDataBase))
			AAdd(aBind, dtos(dDataBase))
			cQuery += " ELSE 0 "
			cQuery += " END DIFDATA "
		EndIF

		cQuery += " FROM " + RetSqlName("SE1") + " SE1 "

		cQuery += " INNER JOIN " + RetSqlName("FQB") + " FQB ON "
		cQuery += " FQB.FQB_FILIAL = '"+xFilial("FQB")+"' AND "
		cQuery += " FQB.FQB_PR = SE1.E1_NUM AND "
		cQuery += " FQB.FQB_PREF = SE1.E1_PREFIXO AND "
		cQuery += " FQB.FQB_PARC = SE1.E1_PARCELA AND "
		cQuery += " FQB.FQB_PROJET >= ? AND "
		AAdd(aBind, jParams['05'][1])
		cQuery += " FQB.FQB_PROJET <= ? AND "
		AAdd(aBind, jParams['06'][1])
		cQuery += " FQB.FQB_OBRA >= ? AND "
		AAdd(aBind, jParams['07'][1])
		cQuery += " FQB.FQB_OBRA <= ? AND "
		AAdd(aBind, jParams['08'][1])
		cQuery += " FQB.D_E_L_E_T_ = ' ' "

		cQuery += " INNER JOIN " + RetSqlName("FPA") + " FPA ON "
		cQuery += " FPA.FPA_FILIAL = '"+xFilial("FPA")+"' AND "
		cQuery += " FPA.FPA_PROJET = FQB.FQB_PROJET AND "
		cQuery += " FPA.FPA_AS = FQB.FQB_AS AND "
		cQuery += " FPA.D_E_L_E_T_ = ' ' "

		cQuery += " INNER JOIN " + RetSqlName("FP1") + " FP1 ON "
		cQuery += " FP1.FP1_FILIAL = '"+xFilial("FP1")+"' AND "
		cQuery += " FP1.FP1_PROJET = FQB.FQB_PROJET AND "
		cQuery += " FP1.D_E_L_E_T_ = ' ' "

		cQuery += " INNER JOIN " + RetSqlName("FP0") + " FP0 ON "
		cQuery += " FP0.FP0_FILIAL = '"+xFilial("FP0")+"' AND "
		cQuery += " FP0.FP0_PROJET = FQB.FQB_PROJET AND "
		cQuery += " FP0.D_E_L_E_T_ = ' ' "

		cQuery += " WHERE "
		cQuery += " FQB.FQB_PROJET <> ' ' AND "
		cQuery += " SE1.E1_CLIENTE >= ? AND "
		AAdd(aBind, jParams['01'][1])
		cQuery += " SE1.E1_LOJA >= ? AND "
		AAdd(aBind, jParams['02'][1])
		cQuery += " SE1.E1_CLIENTE <= ? AND "
		AAdd(aBind, jParams['03'][1])
		cQuery += " SE1.E1_LOJA <= ? AND "
		AAdd(aBind, jParams['04'][1])

		cQuery += " SE1.E1_EMISSAO BETWEEN ? AND ? AND "
		cQuery += " SE1.E1_VENCTO BETWEEN ? AND ? AND "
		AAdd(aBind, jParams['09'][1])
		AAdd(aBind, jParams['10'][1])
		AAdd(aBind, jParams['11'][1])
		AAdd(aBind, jParams['12'][1])
		cQuery += " SE1.D_E_L_E_T_ = ' ' "

		cQuery := CHANGEQUERY(cQuery)
		MPSysOpenQuery(cQuery,"TRBFQB",,,aBind)
		aBind := {}
		While !TRBFQB->(Eof())
			LOC017B->(RecLock("LOC017B",.T.))
			LOC017B->FILIAL   := TRBFQB->E1_FILIAL
			LOC017B->TITULO   := TRBFQB->E1_NUM
			LOC017B->PREFIXO  := TRBFQB->E1_PREFIXO
			LOC017B->PARCELA  := TRBFQB->E1_PARCELA
			LOC017B->NATUREZA := TRBFQB->E1_NATUREZ
			LOC017B->CLIENTE  := TRBFQB->E1_CLIENTE
			LOC017B->LOJA     := TRBFQB->E1_LOJA
			LOC017B->EMISSAO  := STOD(TRBFQB->E1_EMISSAO)
			LOC017B->VENCTO   := STOD(TRBFQB->E1_VENCTO)
			LOC017B->VENCREA  := STOD(TRBFQB->E1_VENCREA)
			LOC017B->DIFDATA  := TRBFQB->DIFDATA
			LOC017B->VALOR    := TRBFQB->E1_VALOR
			LOC017B->VALJUR   := TRBFQB->E1_VALJUR
			LOC017B->PORCJUR  := TRBFQB->E1_PORCJUR
			LOC017B->MOEDA    := TRBFQB->E1_MOEDA
			LOC017B->BAIXA    := STOD(TRBFQB->E1_BAIXA)
			LOC017B->SALDO    := TRBFQB->E1_SALDO
			LOC017B->PROJETO  := TRBFQB->FQB_PROJET
			LOC017B->OBRA     := TRBFQB->FQB_OBRA
			LOC017B->A_S      := TRBFQB->FQB_AS
			LOC017B->CLIFAT   := TRBFQB->CLIFAT
			LOC017B->LOJFAT   := TRBFQB->LOJFAT
			LOC017B->(MsUnlock())
			TRBFQB->(dbSkip())
		EndDo
		TRBFQB->(dbCloseArea())
	EndIf
   

	//inicio da query
	cQuery := " SELECT "
	cQuery += " FILIAL, TITULO, PREFIXO, PARCELA, NATUREZA, CLIENTE, LOJA, EMISSAO, VENCTO, VENCREA, DIFDATA, VALOR, "
	cQuery += " VALJUR, PORCJUR, MOEDA, BAIXA, SALDO, PROJETO, OBRA, A_S, CLIFAT, LOJFAT "

	cComando := " cQuery += "
    cComando += "'"
    cComando += " FROM "+ self:oTempTable:GetRealName() + " SE1 "
    cComando += "'"
	&(cComando)

	oExec  := FwExecStatement():New(ChangeQuery(cQuery))

	cAlias := oExec:OpenAlias()

	(cAlias)->(DBCloseArea())
	self:setQuery(cQuery)//Pega a nova query formatada

	//Define o campo de ordenação da query
	self:setOrder("PROJETO")

	cComando := 'MEMOWRITE("\SYSTEM\LOCADEL-"+alltrim(str(ThreadID()))+".TXT",self:oTempTable:GetRealName())'
	&(cComando)
 
return self:oData

/*/{PROTHEUS.DOC} sigaloc.sv.loc.titulosrental.tlpp
ITUP BUSINESS - TOTVS RENTAL
@TYPE Method getSchema
Method para definição dos campos de apresentação da consulta e definição dos parâmetros
@AUTHOR LEONARDO PACHECO FUGA
@SINCE 10/09/2025
/*/
method getSchema() as object class titulosrental
 
	self:addProperty("Filial",       "Filial",              "string", "Filial",              "FILIAL")
	self:addProperty("NumeroTitulo", "Numero do Titulo",    "string", "Numero do Titulo",    "TITULO")
	self:addProperty("Prefixo",      "Prefixo",             "string", "Prefixo",             "PREFIXO")
	self:addProperty("Parcela",      "Parcela",             "string", "Parcela",             "PARCELA")
	self:addProperty("Natureza",     "Natureza",            "string", "Natureza",            "NATUREZA")
	self:addProperty("Cliente",      "Cliente",             "string", "Cliente",             "CLIENTE")
	self:addProperty("Loja",         "Loja",                "string", "Loja",                "LOJA")
	self:addProperty("DtEmissao",    "Dt Emissao",          "date",   "Dt Emissao",          "EMISSAO")
	self:addProperty("Vencimento",   "Vencimento",          "date",   "Vencimento",          "VENCTO")
	self:addProperty("VenctoReal",   "Vencto. Real",        "date",   "Vencto. Real",        "VENCREA")
	self:addProperty("DiasVencidos", "Dias Vencidos",       "number", "Dias Vencidos",       "DIFDATA")
	self:addProperty("ValorTitulo",  "Valor Titulo",        "number", "Valor Titulo",        "VALOR")
	self:addProperty("TaxaPerman",   "Taxa Perman.",        "number", "Taxa Perman.",        "VALJUR")
	self:addProperty("PorcJuros",    "Porc Juros",          "number", "Porc Juros",          "PORCJUR")
	self:addProperty("Moeda",        "Moeda",               "number", "Moeda",               "MOEDA")
	self:addProperty("DtdaBaixa",    "Data da Baixa",       "date",   "Data da Baixa",       "BAIXA")
	self:addProperty("Saldo",        "Saldo",               "number", "Saldo",               "SALDO")
	self:addProperty("Projeto",      "Projeto",             "string", "Projeto",             "PROJETO")
	self:addProperty("Obra",         "Obra",                "string", "Obra",                "OBRA")
	self:addProperty("AS",           "Nr. A.S.",            "string", "Nr. A.S.",            "A_S")
	self:addProperty("CliFat",       "Cliente Faturamento", "string", "Cliente Faturamento", "CLIFAT")
	self:addProperty("LojFat",       "Loja Faturamento",    "string", "Loja Faturamento",    "LOJFAT")
	
	self:addParameter("01"  , "Cliente de",         "string"  , .F., "", .F.,.T.,"SA1",    "MV_PAR01")
	self:addParameter("02"  , "Loja de",            "string"  , .F., "", .F.,.F.,"",       "MV_PAR02")
	self:addParameter("03"  , "Cliente até",        "string"  , .F., "", .F.,.T.,"SA1",    "MV_PAR03")
	self:addParameter("04"  , "Loja até",           "string"  , .F., "", .F.,.F.,"",       "MV_PAR04")
	self:addParameter("05"  , "Projeto de",         "string"  , .F., "", .F.,.T.,"FP0",    "MV_PAR05")
	self:addParameter("06"  , "Projeto até",        "string"  , .F., "", .F.,.T.,"FP0",    "MV_PAR06")
	self:addParameter("07"  , "Obra de",            "string"  , .F., "", .F.,.F.,"",       "MV_PAR07")
	self:addParameter("08"  , "Obra até",           "string"  , .F., "", .F.,.F.,"",       "MV_PAR08")
	self:addParameter("09"  , "Data Emissao de",    "date"    , .F., "", .F.,.F.,"",       "MV_PAR09")
	self:addParameter("10"  , "Data Emissao até",   "date"    , .F., "", .F.,.F.,"",       "MV_PAR10")
	self:addParameter("11"  , "Data Vencimento de", "date"    , .F., "", .F.,.F.,"",       "MV_PAR11")
	self:addParameter("12"  , "Data Vencimento até","date"    , .F., "", .F.,.F.,"",       "MV_PAR12")
	self:addParameter("13"  , "Titulos",            "string"  , .F., "", .F.,.F.,"",       "MV_PAR13", "1=Titulos, 2=Titulos Prvosorios, 3=Ambos Ex:1", .F., {"1"})
	self:addParameter("14"  , "Status do Titulo",   "string"  , .F., "", .F.,.F.,"",       "MV_PAR14", "1=Baixados, 2=Nao Baixados, 3=Parcialmente baixados, 4=Todos Ex:1", .F., {"1"})

return self:oSchema

/*/{PROTHEUS.DOC} LOCSV017A
ITUP BUSINESS - TOTVS RENTAL
@TYPE Function
Função para passagem no ADVPR
@AUTHOR LEONARDO PACHECO FUGA
@SINCE 29/09/2025
/*/
Function LOCSV017A
Local cQuery
	cQuery := " SELECT E1_NUM, E1_VALOR "
	cQuery += " FROM " + RETSQLNAME("SE1") + " SE1 "
	cQuery += " WHERE SE1.D_E_L_E_T_ = '' AND SE1.E1_PREFIXO = 'REM' "
	cQuery := CHANGEQUERY(cQuery)
	MPSysOpenQuery(cQuery,"TRBSE1",,,)
	MPSysOpenQuery(cQuery,"TRBFQB",,,)
return
