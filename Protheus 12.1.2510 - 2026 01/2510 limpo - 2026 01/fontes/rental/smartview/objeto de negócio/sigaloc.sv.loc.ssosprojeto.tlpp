	self:addProperty("SituacaoSS",     "Situacao S.S",           "string", "Situacao S.S",          "SOLUCA")
	self:addProperty("TipoServico",    "Tipo Servico",           "string", "Tipo Servico",          "CDSERV")
	self:addProperty("DataEnc",        "Data Enc.",              "date",   "Data Enc.",             "DTFECH")
	self:addProperty("HoraEnc",        "Hora Enc.",              "string", "Hora Enc.",             "HOFECH")
	self:addProperty("Contador",       "Contador",               "number", "Contador",              "POSCON")
	self:addProperty("Contador2",      "Contador2",              "number", "Contador2",             "POSCO2")
	self:addProperty("TipoSolicit",    "Tipo de Solicitacao",    "string", "Tipo de Solicitacao",   "TPSERV")
