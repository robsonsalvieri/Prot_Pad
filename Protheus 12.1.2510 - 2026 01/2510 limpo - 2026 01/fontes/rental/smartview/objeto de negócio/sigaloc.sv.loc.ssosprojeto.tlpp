	self:addProperty("EquipSS",        "Equip. da S.S",          "string", "Equip. da S.S",         "CODBEM")
	self:addProperty("DescEquipSS",    "Desc. Equip. da S.S",    "string", "Desc. Equip. da S.S",   "NOMEBEM")
	self:addProperty("CCustoSS",       "C. Custo da S.S",        "string", "C. Custo da S.S",       "C_CUSTO")
