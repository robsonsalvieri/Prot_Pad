namespace totvs.protheus.rental.manutencao.integratedprovider

@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGALOC", tables="FP0,SC6,FPY,FPZ,CTT", name="Rental", country="ALL", initialRelease="12.1.2210")
class ssosprojeto from totvs.framework.treports.integratedprovider.integratedprovider
data oTempTable as object
public method new() as object
public method getData() as object
public method getSchema() as object 
endclass

/*/{Protheus.doc} ssosprojeto
Método para geração do relatório
@type method
@author Leonardo Pacheco Fuga
@since 23/10/2025
/*/
method new() class ssosprojeto
	_Super:new()
	//Define a Área
	self:appendArea("Rental")

	//Define o nome do Objeto de Negócio
	self:setDisplayName("SS OS por Projeto")

	//Define a descrição do Objeto de Negócio
	self:setDescription("SS OS por Projeto")
return self

/*/{Protheus.doc} getData
Método para geração do relatório
@type method
@author Leonardo Pacheco Fuga
@since 23/10/2025
/*/
method getData(nPage as numeric, oFilter as object) as object class ssosprojeto
local cQuery as character
local cAlias as character
local oExec as object
local cComando    := ""
Local cLinha      := ""

	If select("LOC018B") > 0
		LOC018B->(dbCloseArea())
	EndIf
    self:oTempTable := FWTemporaryTable():New("LOC018B")

    aFields := {}
	aAdd(aFields, {"CLI",         "C", TamSx3("FP0_CLI")[1], 0})
	aAdd(aFields, {"CLINOM",      "C", TamSx3("FP0_CLINOM")[1], 0})
	aAdd(aFields, {"LOJA",        "C", TamSx3("FP0_LOJA")[1], 0})
	aAdd(aFields, {"FILIALOS",    "C", TamSx3("TJ_FILIAL")[1], 0})
    aAdd(aFields, {"ORDEM",       "C", TamSx3("TJ_ORDEM")[1], 0})
	aAdd(aFields, {"PRIORIDOS",   "C", TamSx3("TJ_PRIORID")[1], 0})
	aAdd(aFields, {"TERMINO",     "C", 40, 0})
	aAdd(aFields, {"USUAINI",     "C", TamSx3("TJ_USUAINI")[1], 0})
	aAdd(aFields, {"USUAFIM",     "C", TamSx3("TJ_USUAFIM")[1], 0})
	aAdd(aFields, {"DTORIGI",     "D", TamSx3("TJ_DTORIGI")[1], 0})
	aAdd(aFields, {"T9A_CODBEM",  "C", TamSx3("T9_CODBEM")[1], 0})
	aAdd(aFields, {"T9A_NOME",    "C", TamSx3("T9_NOME")[1], 0})
	aAdd(aFields, {"CTTA_CUSTO",  "C", 40, 0})
	aAdd(aFields, {"CTTA_DESC",   "C", TamSx3("CTT_DESC01")[1], 0})
	aAdd(aFields, {"POSCONT",     "N", TamSx3("TJ_POSCONT")[1], 0})
	aAdd(aFields, {"POSCON2",     "N", TamSx3("TJ_POSCON2")[1], 0})
	aAdd(aFields, {"DTPRINI",     "D", TamSx3("TJ_DTPRINI")[1], 0})
	aAdd(aFields, {"HOPRINI",     "C", TamSx3("TJ_HOPRINI")[1], 0})
	aAdd(aFields, {"DTPRFIM",     "D", TamSx3("TJ_DTPRFIM")[1], 0})
	aAdd(aFields, {"HOPRFIM",     "C", TamSx3("TJ_HOPRFIM")[1], 0})
	aAdd(aFields, {"DTMPINI",     "D", TamSx3("TJ_DTMPINI")[1], 0})
	aAdd(aFields, {"HOMPINI",     "C", TamSx3("TJ_HOMPINI")[1], 0})
	aAdd(aFields, {"DTMPFIM",     "D", TamSx3("TJ_DTMPFIM")[1], 0})
	aAdd(aFields, {"HOMPFIM",     "C", TamSx3("TJ_HOMPFIM")[1], 0})
	aAdd(aFields, {"DTMRINI",     "D", TamSx3("TJ_DTMRINI")[1], 0})
	aAdd(aFields, {"HOMRINI",     "C", TamSx3("TJ_HOMRINI")[1], 0})
	aAdd(aFields, {"DTMRFIM",     "D", TamSx3("TJ_DTMRFIM")[1], 0})
	aAdd(aFields, {"HOMRFIM",     "C", TamSx3("TJ_HOMRFIM")[1], 0})
	aAdd(aFields, {"SOLICI",      "C", TamSx3("TJ_SOLICI")[1], 0})
	aAdd(aFields, {"IRREGU",      "C", TamSx3("TJ_IRREGU")[1], 0})
	aAdd(aFields, {"TERCEIR",     "C", 3, 0})
	aAdd(aFields, {"A_S",         "C", TamSx3("TJ_AS")[1], 0})
	aAdd(aFields, {"PROJETO",     "C", TamSx3("TJ_PROJETO")[1], 0})
	aAdd(aFields, {"OBRA",        "C", TamSx3("TJ_OBRA")[1], 0})
	aAdd(aFields, {"TRAB_COD",    "C", TamSx3("HB_COD")[1], 0})
	aAdd(aFields, {"TRAB_NOME",   "C", TamSx3("HB_NOME")[1], 0})
	aAdd(aFields, {"CUSTMDO",     "N", TamSx3("TJ_CUSTMDO")[1], TamSx3("TJ_CUSTMDO")[2]})
	aAdd(aFields, {"CUSTMAT",     "N", TamSx3("TJ_CUSTMAT")[1], TamSx3("TJ_CUSTMAT")[2]})
	aAdd(aFields, {"CUSTMAA",     "N", TamSx3("TJ_CUSTMAA")[1], TamSx3("TJ_CUSTMAA")[2]})
	aAdd(aFields, {"CUSTMAS",     "N", TamSx3("TJ_CUSTMAS")[1], TamSx3("TJ_CUSTMAS")[2]})
	aAdd(aFields, {"CUSTTER",     "N", TamSx3("TJ_CUSTTER")[1], TamSx3("TJ_CUSTTER")[2]})
	aAdd(aFields, {"FILIALSS",    "C", TamSx3("TQB_FILIAL")[1], 0})
	aAdd(aFields, {"SOLICI2",     "C", TamSx3("TQB_SOLICI")[1], 0})
	aAdd(aFields, {"PRIORID",     "C", 10, 0})
	aAdd(aFields, {"ORDEM2",      "C", TamSx3("TQB_ORDEM")[1], 0})
	aAdd(aFields, {"CODBEM",      "C", TamSx3("T9_CODBEM")[1], 0})
	aAdd(aFields, {"NOMEBEM",     "C", TamSx3("T9_NOME")[1], 0})
	aAdd(aFields, {"C_CUSTO",     "C", 40, 0})
	aAdd(aFields, {"C_DESC01",    "C", TamSx3("CTT_DESC01")[1], 0})
	aAdd(aFields, {"DTABER",      "D", TamSx3("TQB_DTABER")[1], 0})
	aAdd(aFields, {"HOABER",      "C", TamSx3("TQB_HOABER")[1], 0})
	aAdd(aFields, {"SOLUCA",      "C", 40, 0})
	aAdd(aFields, {"CDSERV",      "C", TamSx3("TQB_CDSERV")[1], 0})
	aAdd(aFields, {"DTFECH",      "D", TamSx3("TQB_DTFECH")[1], 0})
	aAdd(aFields, {"HOFECH",      "C", TamSx3("TQB_HOFECH")[1], 0})
	aAdd(aFields, {"POSCON",      "N", TamSx3("TQB_POSCON")[1], 0})
	aAdd(aFields, {"POSCO2",      "N", TamSx3("TQB_POSCO2")[1], 0})
	aAdd(aFields, {"TPSERV",      "C", 40, 0})
	aAdd(aFields, {"DTCANC",      "D", TamSx3("TQB_DTCANC")[1], 0})
	aAdd(aFields, {"HRCANC",      "C", TamSx3("TQB_HRCANC")[1], 0})
	aAdd(aFields, {"PROJET2",     "C", TamSx3("TQB_PROJET")[1], 0})
	aAdd(aFields, {"OBRA2",       "C", TamSx3("TQB_OBRA")[1], 0})
	aAdd(aFields, {"A_S2",        "C", TamSx3("TQB_AS")[1], 0})

	//Define as colunas usadas
    self:oTempTable:SetFields( aFields )

    //Efetua a criação da tabela
    self:oTempTable:Create()

	//Define a quantidade máxima por página (Default 100)
	self:setPageSize(20)

	jParams := oFilter:getParameters() //metodo para retorno do json dos parâmetros

	If type("jParams['01'][1]") <> "C" .or. file("\SYSTEM\LOCSV009.TXT")
		jParams['01'][1] := space(TamSx3("FP0_PROJET")[1])
	EndIf
	If empty(jParams['01'][1])
		jParams['01'][1] := space(TamSx3("FP0_PROJET")[1])
	EndIf

	If type("jParams['02'][1]") <> "C" .or. file("\SYSTEM\LOCSV009.TXT")
		jParams['02'][1] := space(TamSx3("FP0_PROJET")[1])
	EndIf
	If empty(jParams['02'][1])
		jParams['02'][1] := space(TamSx3("FP0_PROJET")[1])
	EndIf

	If type("jParams['03'][1]") <> "C" .or. file("\SYSTEM\LOCSV009.TXT")
		jParams['03'][1] := space(TamSx3("FP0_CLI")[1])
	EndIf
	If empty(jParams['03'][1])
		jParams['03'][1] := space(TamSx3("FP0_CLI")[1])
	EndIf

	If type("jParams['04'][1]") <> "C" .or. file("\SYSTEM\LOCSV009.TXT")
		jParams['04'][1] := space(TamSx3("FP0_CLI")[1])
	EndIf
	If empty(jParams['04'][1])
		jParams['04'][1] := space(TamSx3("FP0_CLI")[1])
	EndIf

	If type("jParams['05'][1]") <> "C" .or. file("\SYSTEM\LOCSV009.TXT")
		jParams['05'][1] := space(TamSx3("FP0_LOJA")[1])
	EndIf
	If empty(jParams['05'][1])
		jParams['05'][1] := space(TamSx3("FP0_LOJA")[1])
	EndIf

	If type("jParams['06'][1]") <> "C" .or. file("\SYSTEM\LOCSV009.TXT")
		jParams['06'][1] := space(TamSx3("FP0_LOJA")[1])
	EndIf
	If empty(jParams['06'][1])
		jParams['06'][1] := space(TamSx3("FP0_LOJA")[1])
	EndIf

	jParams['08'][1] := StrTran(SubStr(jParams["08"][1],1,10),"-","") // "20000101"
	If empty(jParams['08'][1])
		jParams['08'][1] := space(8)
	EndIf

	jParams['09'][1] := StrTran(SubStr(jParams["09"][1],1,10),"-","") // "20000101"
	If empty(jParams['09'][1])
		jParams['09'][1] := space(8)
	EndIf

	jParams['10'][1] := StrTran(SubStr(jParams["10"][1],1,10),"-","") // "20000101"
	If empty(jParams['10'][1])
		jParams['10'][1] := space(8)
	EndIf

	jParams['11'][1] := StrTran(SubStr(jParams["11"][1],1,10),"-","") // "20000101"
	If empty(jParams['11'][1])
		jParams['11'][1] := space(8)
	EndIf


	If file("\SYSTEM\LOCSV019.TXT")
		LOCSV018A()
	EndIF
	//TABELA 1 (TQB)
	If jParams['07'][1] == 'S' .or. jParams['07'][1] == 'A' .or. jParams['07'][1] == 'OS'
		If select("TRBTQB") > 0
			TRBTQB->(dbCloseArea())
		EndIf
		cQuery := " SELECT "
		cQuery += " COALESCE(FP0.FP0_CLI, ' ') FP0_CLI, "
		cQuery += " COALESCE(FP0.FP0_CLINOM, ' ') FP0_CLINOM, "
		cQuery += " COALESCE(FP0.FP0_LOJA, ' ') FP0_LOJA, "
		cQuery += " COALESCE(STJ.TJ_FILIAL, ' ') TJ_FILIAL, "
		cQuery += " COALESCE(STJ.TJ_ORDEM, ' ') TJ_ORDEM, "
		cQuery += " COALESCE(STJ.TJ_PRIORID, ' ') TJ_PRIORID, "
		cQuery += " CASE "
		cQuery += " WHEN COALESCE(STJ.TJ_TERMINO, ' ') = 'S' THEN 'O.S Finalizada' "
		cQuery += " WHEN COALESCE(STJ.TJ_TERMINO, ' ') = 'N' THEN 'O.S Aberta' "
		cQuery += " ELSE ' ' "
		cQuery += " END TJ_TERMINO, "
		cQuery += " COALESCE(STJ.TJ_USUAINI, ' ') TJ_USUAINI, "
		cQuery += " COALESCE(STJ.TJ_USUAFIM, ' ') TJ_USUAFIM, "
		cQuery += " COALESCE(STJ.TJ_DTORIGI, ' ') TJ_DTORIGI, "
		cQuery += " COALESCE(ST9A.T9_CODBEM, ' ') T9A_CODBEM, "
		cQuery += " COALESCE(ST9A.T9_NOME, ' ') T9A_NOME, "
		cQuery += " COALESCE(CTTA.CTT_CUSTO,'SEM CENTRO DE CUSTO') CTTA_CUSTO, "
		cQuery += " COALESCE(CTTA.CTT_DESC01,'SEM CENTRO DE CUSTO') CTTA_DESC, "
		cQuery += " COALESCE(SHB.HB_COD, ' ') HB_COD, "
		cQuery += " COALESCE(SHB.HB_NOME, ' ') HB_NOME, "
		cQuery += " COALESCE(STJ.TJ_CUSTMDO, 0) TJ_CUSTMDO, "
		cQuery += " COALESCE(STJ.TJ_CUSTMAT, 0) TJ_CUSTMAT, "
		cQuery += " COALESCE(STJ.TJ_CUSTMAA, 0) TJ_CUSTMAA, "
		cQuery += " COALESCE(STJ.TJ_CUSTMAS, 0) TJ_CUSTMAS, "
		cQuery += " COALESCE(STJ.TJ_CUSTTER, 0) TJ_CUSTTER, "
		cQuery += " COALESCE(STJ.TJ_POSCONT, 0) TJ_POSCONT, "
		cQuery += " COALESCE(STJ.TJ_POSCON2, 0) TJ_POSCON2, "
		cQuery += " COALESCE(STJ.TJ_DTPRINI, ' ') TJ_DTPRINI, "
		cQuery += " COALESCE(STJ.TJ_HOPRINI, ' ') TJ_HOPRINI, "
		cQuery += " COALESCE(STJ.TJ_DTPRFIM, ' ') TJ_DTPRFIM, "
		cQuery += " COALESCE(STJ.TJ_HOPRFIM, ' ') TJ_HOPRFIM, "
		cQuery += " COALESCE(STJ.TJ_DTMPINI, ' ') TJ_DTMPINI, "
		cQuery += " COALESCE(STJ.TJ_HOMPINI, ' ') TJ_HOMPINI, "
		cQuery += " COALESCE(STJ.TJ_DTMPFIM, ' ') TJ_DTMPFIM, "
		cQuery += " COALESCE(STJ.TJ_HOMPFIM, ' ') TJ_HOMPFIM, "
		cQuery += " COALESCE(STJ.TJ_DTMRINI, ' ') TJ_DTMRINI, "
		cQuery += " COALESCE(STJ.TJ_HOMRINI, ' ') TJ_HOMRINI, "
		cQuery += " COALESCE(STJ.TJ_DTMRFIM, ' ') TJ_DTMRFIM, "
		cQuery += " COALESCE(STJ.TJ_HOMRFIM, ' ') TJ_HOMRFIM, "
		cQuery += " COALESCE(STJ.TJ_SOLICI, ' ') TJ_SOLICI, "
		cQuery += " COALESCE(STJ.TJ_IRREGU, ' ') TJ_IRREGU, "
		cQuery += " CASE "
		cQuery += " WHEN COALESCE(STJ.TJ_TERCEIR, ' ') = '1' THEN 'Nao' "
		cQuery += " WHEN COALESCE(STJ.TJ_TERCEIR, ' ') = '2' THEN 'Sim' "
		cQuery += " ELSE ' ' "
		cQuery += " END TJ_TERCEIR, "
		cQuery += " COALESCE(STJ.TJ_AS, ' ') TJ_AS, "
		cQuery += " COALESCE(STJ.TJ_PROJETO, ' ') TJ_PROJETO, "
		cQuery += " COALESCE(STJ.TJ_OBRA, ' ') TJ_OBRA, "
		cQuery += " COALESCE(TQB.TQB_FILIAL, ' ') TQB_FILIAL, "
		cQuery += " COALESCE(TQB.TQB_SOLICI, ' ') TQB_SOLICI, "
		cQuery += " CASE "
		cQuery += " WHEN COALESCE(TQB.TQB_PRIORI, ' ') = '1' THEN 'Alta' "
		cQuery += " WHEN COALESCE(TQB.TQB_PRIORI, ' ') = '2' THEN 'Media' "
		cQuery += " WHEN COALESCE(TQB.TQB_PRIORI, ' ') = '3' THEN 'Baixa' "
		cQuery += " ELSE '' "
		cQuery += " END TQB_PRIORI, "
		cQuery += " COALESCE(TQB.TQB_ORDEM, ' ') TQB_ORDEM, "
		cQuery += " COALESCE(ST9.T9_CODBEM, ' ') T9_CODBEM, "
		cQuery += " COALESCE(ST9.T9_NOME, ' ') T9_NOME, "
		cQuery += " COALESCE(CTT.CTT_CUSTO,'SEM CENTRO DE CUSTO') CTT_CUSTO, "
		cQuery += " COALESCE(CTT.CTT_DESC01,'SEM CENTRO DE CUSTO') CTT_DESC01, "
		cQuery += " COALESCE(TQB.TQB_DTABER, ' ') TQB_DTABER, "
		cQuery += " COALESCE(TQB.TQB_HOABER, ' ') TQB_HOABER, "
		cQuery += " CASE "
		cQuery += " WHEN COALESCE(TQB.TQB_SOLUCA, ' ') = 'A' THEN 'Aguardando Analise' "
		cQuery += " WHEN COALESCE(TQB.TQB_SOLUCA, ' ') = 'D' THEN 'Distribuida' "
		cQuery += " WHEN COALESCE(TQB.TQB_SOLUCA, ' ') = 'E' THEN 'Encerrada' "
		cQuery += " WHEN COALESCE(TQB.TQB_SOLUCA, ' ') = 'C' THEN 'Cancelada' "
		cQuery += " ELSE ' ' "
		cQuery += " END TQB_SOLUCA, "
		cQuery += " COALESCE(TQB.TQB_CDSERV, ' ') TQB_CDSERV, "
		cQuery += " COALESCE(TQB.TQB_DTFECH, ' ') TQB_DTFECH, "
		cQuery += " COALESCE(TQB.TQB_HOFECH, ' ') TQB_HOFECH, "
		cQuery += " COALESCE(TQB.TQB_POSCON, 0) TQB_POSCON, "
		cQuery += " COALESCE(TQB.TQB_POSCO2, 0) TQB_POSCO2, "
		cQuery += " CASE "
		cQuery += " WHEN COALESCE(TQB.TQB_TPSERV, ' ') = '1' THEN 'Incidente' "
		cQuery += " WHEN COALESCE(TQB.TQB_TPSERV, ' ') = '2' THEN 'Melhoria' "
		cQuery += " ELSE '' "
		cQuery += " END TQB_TPSERV, "
		cQuery += " COALESCE(TQB.TQB_DTCANC, ' ') TQB_DTCANC, "
		cQuery += " COALESCE(TQB.TQB_HRCANC, ' ') TQB_HRCANC, "
		cQuery += " COALESCE(TQB.TQB_PROJET, ' ') TQB_PROJET, "
		cQuery += " COALESCE(TQB.TQB_OBRA, ' ') TQB_OBRA, "
		cQuery += " COALESCE(TQB.TQB_AS, ' ') TQB_AS "
		cQuery += " FROM " + RetSQLName("TQB") + " TQB "
		cQuery += " LEFT JOIN " + RetSQLName("STJ") + " STJ ON "
		cQuery += " STJ.TJ_FILIAL = '"+xFilial("STJ")+"' AND "
		cQuery += " STJ.TJ_SOLICI = TQB_SOLICI AND "
		cLinha := " STJ.TJ_DTORIGI >= '"+jParams['08'][1]+"' AND "
		cComando := 'cQuery += cLinha '
		&(cComando)
		cLinha := " STJ.TJ_DTORIGI <= '"+jParams['09'][1]+"' AND "
		cComando := 'cQuery += cLinha '
		&(cComando)
		cQuery += " STJ.D_E_L_E_T_ = ' ' "

		cQuery += " INNER JOIN " + RetSQLName("FP0") + " FP0 ON "
		cQuery += " FP0.FP0_FILIAL = '"+xFilial("FP0")+"' AND "
		cQuery += " FP0.FP0_PROJET = TQB.TQB_PROJET AND "
		cLinha := " FP0.FP0_CLI >= '"+jParams['03'][1]+"' AND "
		cComando := 'cQuery += cLinha '
		&(cComando)
		cLinha := " FP0.FP0_CLI <= '"+jParams['04'][1]+"' AND "
		cComando := 'cQuery += cLinha '
		&(cComando)
		cLinha := " FP0.FP0_LOJA >= '"+jParams['05'][1]+"' AND "
		cComando := 'cQuery += cLinha '
		&(cComando)
		cLinha := " FP0.FP0_LOJA <= '"+jParams['06'][1]+"' AND "
		cComando := 'cQuery += cLinha '
		&(cComando)
		cQuery += " FP0.D_E_L_E_T_ = ' ' "

		cQuery += " LEFT JOIN " + RetSQLName("ST9") + " ST9 ON "
		cQuery += " ST9.T9_FILIAL = '"+xFilial("ST9")+"' AND "
		cQuery += " ST9.T9_CODBEM = TQB.TQB_CODBEM AND "
		cQuery += " ST9.D_E_L_E_T_ = ' ' "

		cQuery += " LEFT JOIN " + RetSQLName("ST9") + " ST9A ON "
		cQuery += " ST9A.T9_FILIAL = '"+xFilial("ST9")+"' AND "
		cQuery += " ST9A.T9_CODBEM = STJ.TJ_CODBEM AND "
		cQuery += " ST9A.D_E_L_E_T_ = ' ' "

		cQuery += " LEFT JOIN " + RetSQLName("CTT") + " CTT ON "
		cQuery += " CTT.CTT_FILIAL = '"+xFilial("CTT")+"' AND "
		cQuery += " CTT.CTT_CUSTO = TQB.TQB_CCUSTO AND "
		cQuery += " CTT.D_E_L_E_T_ = ' ' "

		cQuery += " LEFT JOIN " + RetSQLName("CTT") + " CTTA ON "
		cQuery += " CTTA.CTT_FILIAL = '"+xFilial("CTT")+"' AND "
		cQuery += " CTTA.CTT_CUSTO = STJ.TJ_CCUSTO AND "
		cQuery += " CTTA.D_E_L_E_T_ = ' ' "

		cQuery += " LEFT JOIN " + RetSQLName("SHB") + " SHB ON "
		cQuery += " SHB.HB_FILIAL = '"+xFilial("SHB")+"' AND "
		cQuery += " SHB.HB_COD = STJ.TJ_CENTRAB AND "
		cQuery += " SHB.D_E_L_E_T_ = ' ' "

		cQuery += " WHERE "
		Do Case
			Case jParams['07'][1] == "S"
				cQuery += " COALESCE(STJ.TJ_ORDEM, ' ') = ' ' AND "

			Case jParams['07'][1] == "OS"
				cQuery += " COALESCE(STJ.TJ_SOLICI, ' ') = TQB.TQB_SOLICI AND "
		EndCase

		cLinha := " TQB.TQB_DTABER >= '"+jParams['10'][1]+"' AND "
		cComando := 'cQuery += cLinha '
		&(cComando)
		cLinha := " TQB.TQB_DTABER <= '"+jParams['11'][1]+"' AND "
		cComando := 'cQuery += cLinha '
		&(cComando)
		cLinha := " TQB.TQB_PROJET >= '"+jParams['01'][1]+"' AND "
		cComando := 'cQuery += cLinha '
		&(cComando)
		cLinha := " TQB.TQB_PROJET <= '"+jParams['02'][1]+"' AND "
		cComando := 'cQuery += cLinha '
		&(cComando)
		cQuery += " TQB.D_E_L_E_T_ = ' ' "
		cQuery := CHANGEQUERY(cQuery)
		MPSysOpenQuery(cQuery,"TRBTQB",,,)
		While !TRBTQB->(Eof())
			LOC018B->(RecLock("LOC018B",.T.))
			LOC018B->CLI         := TRBTQB->FP0_CLI
			LOC018B->CLINOM      := TRBTQB->FP0_CLINOM
			LOC018B->LOJA        := TRBTQB->FP0_LOJA
			LOC018B->FILIALOS    := TRBTQB->TJ_FILIAL
			LOC018B->ORDEM       := TRBTQB->TJ_ORDEM
			LOC018B->PRIORIDOS   := TRBTQB->TJ_PRIORID
			LOC018B->TERMINO     := TRBTQB->TJ_TERMINO
			LOC018B->USUAINI     := TRBTQB->TJ_USUAINI
			LOC018B->USUAFIM     := TRBTQB->TJ_USUAFIM
			LOC018B->DTORIGI     := STOD(TRBTQB->TJ_DTORIGI)
			LOC018B->T9A_CODBEM  := TRBTQB->T9A_CODBEM
			LOC018B->T9A_NOME    := TRBTQB->T9A_NOME
			LOC018B->CTTA_CUSTO  := TRBTQB->CTTA_CUSTO
			LOC018B->CTTA_DESC   := TRBTQB->CTTA_DESC
			LOC018B->POSCONT     := TRBTQB->TJ_POSCONT
			LOC018B->POSCON2     := TRBTQB->TJ_POSCON2
			LOC018B->DTPRINI     := STOD(TRBTQB->TJ_DTPRINI)
			LOC018B->HOPRINI     := TRBTQB->TJ_HOPRINI
			LOC018B->DTPRFIM     := STOD(TRBTQB->TJ_DTPRFIM)
			LOC018B->HOPRFIM     := TRBTQB->TJ_HOPRFIM
			LOC018B->DTMPINI     := STOD(TRBTQB->TJ_DTMPINI)
			LOC018B->HOMPINI     := TRBTQB->TJ_HOMPINI
			LOC018B->DTMPFIM     := STOD(TRBTQB->TJ_DTMPFIM)
			LOC018B->HOMPFIM     := TRBTQB->TJ_HOMPFIM
			LOC018B->DTMRINI     := STOD(TRBTQB->TJ_DTMRINI)
			LOC018B->HOMRINI     := TRBTQB->TJ_HOMRINI
			LOC018B->DTMRFIM     := STOD(TRBTQB->TJ_DTMRFIM)
			LOC018B->HOMRFIM     := TRBTQB->TJ_HOMRFIM
			LOC018B->SOLICI      := TRBTQB->TJ_SOLICI
			LOC018B->IRREGU      := TRBTQB->TJ_IRREGU
			LOC018B->TERCEIR     := TRBTQB->TJ_TERCEIR
			LOC018B->A_S         := TRBTQB->TJ_AS
			LOC018B->PROJETO     := TRBTQB->TJ_PROJETO
			LOC018B->OBRA        := TRBTQB->TJ_OBRA
			LOC018B->TRAB_COD    := TRBTQB->HB_COD
			LOC018B->TRAB_NOME   := TRBTQB->HB_NOME
			LOC018B->CUSTMDO     := TRBTQB->TJ_CUSTMDO
			LOC018B->CUSTMAT     := TRBTQB->TJ_CUSTMAT
			LOC018B->CUSTMAA     := TRBTQB->TJ_CUSTMAA
			LOC018B->CUSTMAS     := TRBTQB->TJ_CUSTMAS
			LOC018B->CUSTTER     := TRBTQB->TJ_CUSTTER
			LOC018B->FILIALSS    := TRBTQB->TQB_FILIAL
			LOC018B->SOLICI2     := TRBTQB->TQB_SOLICI
			LOC018B->PRIORID     := TRBTQB->TQB_PRIORI
			LOC018B->ORDEM2      := TRBTQB->TQB_ORDEM
			LOC018B->CODBEM      := TRBTQB->T9_CODBEM
			LOC018B->NOMEBEM     := TRBTQB->T9_NOME
			LOC018B->C_CUSTO     := TRBTQB->CTT_CUSTO
			LOC018B->C_DESC01    := TRBTQB->CTT_DESC01
			LOC018B->DTABER      := STOD(TRBTQB->TQB_DTABER)
			LOC018B->HOABER      := TRBTQB->TQB_HOABER
			LOC018B->SOLUCA      := TRBTQB->TQB_SOLUCA
			LOC018B->CDSERV      := TRBTQB->TQB_CDSERV
			LOC018B->DTFECH      := STOD(TRBTQB->TQB_DTFECH)
			LOC018B->HOFECH      := TRBTQB->TQB_HOFECH
			LOC018B->POSCON      := TRBTQB->TQB_POSCON
			LOC018B->POSCO2      := TRBTQB->TQB_POSCO2
			LOC018B->TPSERV      := TRBTQB->TQB_TPSERV
			LOC018B->DTCANC      := STOD(TRBTQB->TQB_DTCANC)
			LOC018B->HRCANC      := TRBTQB->TQB_HRCANC
			LOC018B->PROJET2     := TRBTQB->TQB_PROJET
			LOC018B->OBRA2       := TRBTQB->TQB_OBRA
			LOC018B->A_S2        := TRBTQB->TQB_AS
			LOC018B->(MsUnlock())
			TRBTQB->(dbSkip())
		EndDo
		TRBTQB->(dbCloseArea())
	EndIf

	If file("\SYSTEM\LOCSV019.TXT")
		LOCSV018A()
	EndIF
	//TABELA 2 (STJ)
	If jParams['07'][1] == 'O' .or. jParams['07'][1] == 'A'
		If select("TRBSTJ") > 0
			TRBSTJ->(dbCloseArea())
		EndIf
		cQuery := " SELECT "
		cQuery += " COALESCE(FP0.FP0_CLI, ' ') FP0_CLI, "
		cQuery += " COALESCE(FP0.FP0_CLINOM, ' ') FP0_CLINOM, "
		cQuery += " COALESCE(FP0.FP0_LOJA, ' ') FP0_LOJA, "

		cQuery += " COALESCE(STJ.TJ_FILIAL, ' ') TJ_FILIAL, "
		cQuery += " COALESCE(STJ.TJ_ORDEM, ' ') TJ_ORDEM, "
		cQuery += " COALESCE(STJ.TJ_PRIORID, ' ') TJ_PRIORID, "
		cQuery += " CASE "
		cQuery += " WHEN COALESCE(STJ.TJ_TERMINO, ' ') = 'S' THEN 'O.S Finalizada' "
		cQuery += " WHEN COALESCE(STJ.TJ_TERMINO, ' ') = 'N' THEN 'O.S Aberta' "
		cQuery += " ELSE ' ' "
		cQuery += " END TJ_TERMINO, "
		cQuery += " COALESCE(STJ.TJ_USUAINI, ' ') TJ_USUAINI, "
		cQuery += " COALESCE(STJ.TJ_USUAFIM, ' ') TJ_USUAFIM, "
		cQuery += " COALESCE(STJ.TJ_DTORIGI, ' ') TJ_DTORIGI, "
		cQuery += " COALESCE(ST9A.T9_CODBEM, ' ') T9A_CODBEM, "
		cQuery += " COALESCE(ST9A.T9_NOME, ' ') T9A_NOME, "
		cQuery += " COALESCE(CTTA.CTT_CUSTO,'SEM CENTRO DE CUSTO') CTTA_CUSTO, "
		cQuery += " COALESCE(CTTA.CTT_DESC01,'SEM CENTRO DE CUSTO') CTTA_DESC, "
		cQuery += " COALESCE(SHB.HB_COD, ' ') HB_COD, "
		cQuery += " COALESCE(SHB.HB_NOME, ' ') HB_NOME, "
		cQuery += " COALESCE(STJ.TJ_CUSTMDO, 0) TJ_CUSTMDO, "
		cQuery += " COALESCE(STJ.TJ_CUSTMAT, 0) TJ_CUSTMAT, "
		cQuery += " COALESCE(STJ.TJ_CUSTMAA, 0) TJ_CUSTMAA, "
		cQuery += " COALESCE(STJ.TJ_CUSTMAS, 0) TJ_CUSTMAS, "
		cQuery += " COALESCE(STJ.TJ_CUSTTER, 0) TJ_CUSTTER, "

		cQuery += " COALESCE(STJ.TJ_POSCONT, 0) TJ_POSCONT, "
		cQuery += " COALESCE(STJ.TJ_POSCON2, 0) TJ_POSCON2, "
		cQuery += " COALESCE(STJ.TJ_DTPRINI, ' ') TJ_DTPRINI, "
		cQuery += " COALESCE(STJ.TJ_HOPRINI, ' ') TJ_HOPRINI, "
		cQuery += " COALESCE(STJ.TJ_DTPRFIM, ' ') TJ_DTPRFIM, "
		cQuery += " COALESCE(STJ.TJ_HOPRFIM, ' ') TJ_HOPRFIM, "
		cQuery += " COALESCE(STJ.TJ_DTMPINI, ' ') TJ_DTMPINI, "
		cQuery += " COALESCE(STJ.TJ_HOMPINI, ' ') TJ_HOMPINI, "
		cQuery += " COALESCE(STJ.TJ_DTMPFIM, ' ') TJ_DTMPFIM, "
		cQuery += " COALESCE(STJ.TJ_HOMPFIM, ' ') TJ_HOMPFIM, "
		cQuery += " COALESCE(STJ.TJ_DTMRINI, ' ') TJ_DTMRINI, "
		cQuery += " COALESCE(STJ.TJ_HOMRINI, ' ') TJ_HOMRINI, "
		cQuery += " COALESCE(STJ.TJ_DTMRFIM, ' ') TJ_DTMRFIM, "
		cQuery += " COALESCE(STJ.TJ_HOMRFIM, ' ') TJ_HOMRFIM, "
		cQuery += " COALESCE(STJ.TJ_SOLICI, ' ') TJ_SOLICI, "
		cQuery += " COALESCE(STJ.TJ_IRREGU, ' ') TJ_IRREGU, "
		cQuery += " CASE "
		cQuery += " WHEN COALESCE(STJ.TJ_TERCEIR, ' ') = '1' THEN 'Nao' "
		cQuery += " WHEN COALESCE(STJ.TJ_TERCEIR, ' ') = '2' THEN 'Sim' "
		cQuery += " ELSE ' ' "
		cQuery += " END TJ_TERCEIR, "
		cQuery += " COALESCE(STJ.TJ_TERCEIR, ' ') TJ_TERCEIR, "
		cQuery += " COALESCE(STJ.TJ_AS, ' ') TJ_AS, "
		cQuery += " COALESCE(STJ.TJ_PROJETO, ' ') TJ_PROJETO, "
		cQuery += " COALESCE(STJ.TJ_OBRA, ' ') TJ_OBRA "

		cQuery += " FROM " + RetSQLName("STJ") + " STJ "

		cQuery += " INNER JOIN " + RetSQLName("FP0") + " FP0 ON "
		cQuery += " FP0.FP0_FILIAL = '"+xFilial("FP0")+"' AND "
		cQuery += " FP0.FP0_PROJET = STJ.TJ_PROJETO AND "
		
		cLinha := " FP0.FP0_CLI >= '"+jParams['03'][1]+"' AND "
		cComando := 'cQuery += cLinha '
		&(cComando)

		cLinha := " FP0.FP0_CLI <= '"+jParams['04'][1]+"' AND "
		cComando := 'cQuery += cLinha '
		&(cComando)

		cLinha := " FP0.FP0_LOJA >= '"+jParams['05'][1]+"' AND "
		cComando := 'cQuery += cLinha '
		&(cComando)

		cLinha := " FP0.FP0_LOJA <= '"+jParams['06'][1]+"' AND "
		cComando := 'cQuery += cLinha '
		&(cComando)

		cQuery += " FP0.D_E_L_E_T_ = ' ' "

		cQuery += " LEFT JOIN " + RetSQLName("ST9") + " ST9A ON "
		cQuery += " ST9A.T9_FILIAL = '"+xFilial("ST9")+"' AND "
		cQuery += " ST9A.T9_CODBEM = STJ.TJ_CODBEM AND "
		cQuery += " ST9A.D_E_L_E_T_ = ' ' "

		cQuery += " LEFT JOIN " + RetSQLName("CTT") + " CTTA ON "
		cQuery += " CTTA.CTT_FILIAL = '"+xFilial("CTT")+"' AND "
		cQuery += " CTTA.CTT_CUSTO = STJ.TJ_CCUSTO AND "
		cQuery += " CTTA.D_E_L_E_T_ = ' ' "

		cQuery += " LEFT JOIN " + RetSQLName("SHB") + " SHB ON "
		cQuery += " SHB.HB_FILIAL = '"+xFilial("SHB")+"' AND "
		cQuery += " SHB.HB_COD = STJ.TJ_CENTRAB AND "
		cQuery += " SHB.D_E_L_E_T_ = ' ' "

		cQuery += " WHERE "
		Do Case
			Case jParams['07'][1] == "O"
				cQuery += " STJ.TJ_ORDEM <> ' ' AND "
		EndCase

		cQuery += " STJ.TJ_SOLICI = ' ' AND "

		cLinha := " STJ.TJ_PROJETO >= '"+jParams['01'][1]+"' AND "
		cComando := 'cQuery += cLinha '
		&(cComando)

		cLinha := " STJ.TJ_PROJETO <= '"+jParams['02'][1]+"' AND "
		cComando := 'cQuery += cLinha '
		&(cComando)

		cLinha := " STJ.TJ_DTORIGI >= '"+jParams['08'][1]+"' AND "
		cComando := 'cQuery += cLinha '
		&(cComando)
		cLinha := " STJ.TJ_DTORIGI <= '"+jParams['09'][1]+"' AND "
		cComando := 'cQuery += cLinha '
		&(cComando)
		cQuery += " STJ.D_E_L_E_T_ = ' ' "
		cQuery := CHANGEQUERY(cQuery)
		MPSysOpenQuery(cQuery,"TRBSTJ",,,)
		While !TRBSTJ->(Eof())
			LOC018B->(RecLock("LOC018B",.T.))
			LOC018B->CLI         := TRBSTJ->FP0_CLI
			LOC018B->CLINOM      := TRBSTJ->FP0_CLINOM
			LOC018B->LOJA        := TRBSTJ->FP0_LOJA
			LOC018B->FILIALOS    := TRBSTJ->TJ_FILIAL
			LOC018B->ORDEM       := TRBSTJ->TJ_ORDEM
			LOC018B->PRIORIDOS   := TRBSTJ->TJ_PRIORID
			LOC018B->TERMINO     := TRBSTJ->TJ_TERMINO
			LOC018B->USUAINI     := TRBSTJ->TJ_USUAINI
			LOC018B->USUAFIM     := TRBSTJ->TJ_USUAFIM
			LOC018B->DTORIGI     := STOD(TRBSTJ->TJ_DTORIGI)
			LOC018B->T9A_CODBEM  := TRBSTJ->T9A_CODBEM
			LOC018B->T9A_NOME    := TRBSTJ->T9A_NOME
			LOC018B->CTTA_CUSTO  := TRBSTJ->CTTA_CUSTO
			LOC018B->CTTA_DESC   := TRBSTJ->CTTA_DESC
			LOC018B->POSCONT     := TRBSTJ->TJ_POSCONT
			LOC018B->POSCON2     := TRBSTJ->TJ_POSCON2
			LOC018B->DTPRINI     := STOD(TRBSTJ->TJ_DTPRINI)
			LOC018B->HOPRINI     := TRBSTJ->TJ_HOPRINI
			LOC018B->DTPRFIM     := STOD(TRBSTJ->TJ_DTPRFIM)
			LOC018B->HOPRFIM     := TRBSTJ->TJ_HOPRFIM
			LOC018B->DTMPINI     := STOD(TRBSTJ->TJ_DTMPINI)
			LOC018B->HOMPINI     := TRBSTJ->TJ_HOMPINI
			LOC018B->DTMPFIM     := STOD(TRBSTJ->TJ_DTMPFIM)
			LOC018B->HOMPFIM     := TRBSTJ->TJ_HOMPFIM
			LOC018B->DTMRINI     := STOD(TRBSTJ->TJ_DTMRINI)
			LOC018B->HOMRINI     := TRBSTJ->TJ_HOMRINI
			LOC018B->DTMRFIM     := STOD(TRBSTJ->TJ_DTMRFIM)
			LOC018B->HOMRFIM     := TRBSTJ->TJ_HOMRFIM
			LOC018B->SOLICI      := TRBSTJ->TJ_SOLICI
			LOC018B->IRREGU      := TRBSTJ->TJ_IRREGU
			LOC018B->TERCEIR     := TRBSTJ->TJ_TERCEIR
			LOC018B->A_S         := TRBSTJ->TJ_AS
			LOC018B->PROJETO     := TRBSTJ->TJ_PROJETO
			LOC018B->OBRA        := TRBSTJ->TJ_OBRA
			LOC018B->TRAB_COD    := TRBSTJ->HB_COD
			LOC018B->TRAB_NOME   := TRBSTJ->HB_NOME
			LOC018B->CUSTMDO     := TRBSTJ->TJ_CUSTMDO
			LOC018B->CUSTMAT     := TRBSTJ->TJ_CUSTMAT
			LOC018B->CUSTMAA     := TRBSTJ->TJ_CUSTMAA
			LOC018B->CUSTMAS     := TRBSTJ->TJ_CUSTMAS
			LOC018B->CUSTTER     := TRBSTJ->TJ_CUSTTER
			LOC018B->(MsUnlock())
			TRBSTJ->(dbSkip())
		EndDo
		TRBSTJ->(dbCloseArea())
	EndIf
	
	cQuery := " SELECT "
	cQuery += " CLI, CLINOM, LOJA, FILIALOS, ORDEM, PRIORIDOS, TERMINO, USUAINI, USUAFIM, DTORIGI, T9A_CODBEM, T9A_NOME, CTTA_CUSTO, CTTA_DESC, POSCONT, POSCON2, DTPRINI, HOPRINI, "    
	cQuery += " DTPRFIM, HOPRFIM, DTMPINI, HOMPINI, DTMPFIM, HOMPFIM, DTMRINI, HOMRINI, DTMRFIM, HOMRFIM, SOLICI, IRREGU, TERCEIR, A_S, PROJETO, OBRA, TRAB_COD, TRAB_NOME, "
	cQuery += " CUSTMDO, CUSTMAT, CUSTMAA, CUSTMAS, CUSTTER, FILIALSS, SOLICI2, PRIORID, ORDEM2, CODBEM, NOMEBEM, C_CUSTO, C_DESC01, DTABER, HOABER, SOLUCA, CDSERV, DTFECH, HOFECH, POSCON, "      
	cQuery += " POSCO2, TPSERV, DTCANC, HRCANC, PROJET2, OBRA2, A_S2 "        

	cComando := " cQuery += "
    cComando += "'"
    cComando += " FROM "+ self:oTempTable:GetRealName() + " TQB "
    cComando += "'"
	&(cComando)



	oExec  := FwExecStatement():New(ChangeQuery(cQuery))

	cAlias := oExec:OpenAlias()

	(cAlias)->(DBCloseArea())
	self:setQuery(cQuery)

	//Define o campo de ordenação da query
	self:setOrder("PROJETO, PROJET2")

	cComando := 'MEMOWRITE("\SYSTEM\LOCADEL-"+alltrim(str(ThreadID()))+".TXT",self:oTempTable:GetRealName())'
	&(cComando)

return self:oData

/*/{Protheus.doc} ssosprojeto
Método para informar os parâmetros
@type method
@author Leonardo Pacheco Fuga
@since 23/10/2025
/*/

method getSchema() as object class ssosprojeto
 
	self:addProperty("Cliente",        "Cliente",                "string", "Cliente",               "CLI")
	self:addProperty("NomeCliente",    "Nome Cliente",           "string", "Nome Cliente",          "CLINOM")
	self:addProperty("Loja",           "Loja",                   "string", "Loja",                  "LOJA")
	self:addProperty("FilialOS",       "Filial da O.S",          "string", "Filial da O.S",         "FILIALOS")
	self:addProperty("OrdemServico",   "Ordem de servico",       "string", "Ordem de servico",      "ORDEM")
	self:addProperty("PrioridadeOS",   "Prioridade da O.S",      "string", "Prioridade da O.S",     "PRIORIDOS")
	self:addProperty("TerminoOS",      "Termino da OS",          "string", "Termino da OS",         "TERMINO")
	self:addProperty("UsuarioInic",    "Usuario Inic",           "string", "Usuario Inic",          "USUAINI")
	self:addProperty("UsuarioFim",     "Usuario Fim",            "string", "Usuario Fim",           "USUAFIM")
	self:addProperty("DtOriginal",     "Dt. Original",           "date",   "Dt. Original",          "DTORIGI")
	self:addProperty("EquipOS",        "Equip. da O.S",          "string", "Equip. da O.S",         "T9A_CODBEM")
	self:addProperty("DescEquipOS",    "Desc. Equip. da O.S",    "string", "Desc. Equip. da O.S",   "T9A_NOME")
	self:addProperty("CCustoOS",       "C. Custo da O.S",        "string", "C. Custo da O.S",       "CTTA_CUSTO")
	self:addProperty("DescCCustoOS",   "Desc. C.Custo da O.S",   "string", "Desc. C. Custo da O.S", "CTTA_DESC")
	self:addProperty("CTrabalho",      "Centro Trab.",           "string", "Centro Trab.",          "TRAB_COD")
	self:addProperty("NomeCCtrabalho", "Desc.Trab.",             "string", "Desc.Trab.",            "TRAB_NOME")
	self:addProperty("CustoMDO",       "Custo MDO",              "number", "Custo MDO",             "CUSTMDO")
	self:addProperty("CustoTroca",     "Custo Troca",            "number", "Custo Troca",           "CUSTMAT")
	self:addProperty("CustoMater",     "Custo Mater.",           "number", "Custo Mater.",          "CUSTMAA")
	self:addProperty("CustoSubst",     "Custo Subst.",           "number", "Custo Subst.",          "CUSTMAS")
	self:addProperty("CustoTerc",      "Custo Terc.",            "number", "Custo Terc.",           "CUSTTER")
	self:addProperty("Contador1",      "Contador",               "number", "Contador",              "POSCONT")
	self:addProperty("2Contador",      "2. Contador",            "number", "2. Contador",           "POSCON2")
	self:addProperty("DtParReI",       "Dt.Par.Re.I.",           "date",   "Dt.Par.Re.I.",          "DTPRINI")
	self:addProperty("HoParReI",       "Ho.Par.Re.I",            "string", "Ho.Par.Re.I",           "HOPRINI")
	self:addProperty("DtParReF",       "Dt.Par.Re.F.",           "date",   "Dt.Par.Re.F.",          "DTPRFIM")
	self:addProperty("HoParReF",       "Ho.Par.Re.F.",           "string", "Ho.Par.Re.F.",          "HOPRFIM")
	self:addProperty("DtManPrI",       "Dt.Man.Pr.I.",           "date",   "Dt.Man.Pr.I.",          "DTMPINI")
	self:addProperty("HoManPrI",       "Ho.Man.Pr.I.",           "string", "Ho.Man.Pr.I.",          "HOMPINI")
	self:addProperty("DtManPrF",       "Dt.Man.Pr.F.",           "date",   "Dt.Man.Pr.F.",          "DTMPFIM")
	self:addProperty("HoManPrF",       "Ho.Man.Pr.F.",           "string", "Ho.Man.Pr.F.",          "HOMPFIM")
	self:addProperty("DtManReI",       "Dt.Man.Re.I.",           "date",   "Dt.Man.Re.I.",          "DTMRINI")
	self:addProperty("HoManReI",       "Ho.Man.Re.I",            "string", "Ho.Man.Re.I",           "HOMRINI")
	self:addProperty("DtManReF",       "Dt.Man.Re.F.",           "date",   "Dt.Man.Re.F.",          "DTMRFIM")
	self:addProperty("HoManReF",       "Ho.Man.Re.F.",           "string", "Ho.Man.Re.F.",          "HOMRFIM")
	self:addProperty("SolServico",     "Sol. Servico",           "string", "Sol. Servico",          "SOLICI")
	self:addProperty("CdIrregula",     "Cd. Irregula",           "string", "Cd. Irregula",          "IRREGU")
	self:addProperty("Terceiro",       "Terceiro",               "string", "Terceiro",              "TERCEIR")
	self:addProperty("NrASOS",         "Nr. A.S. da O.S",        "string", "Nr. A.S. da O.S",       "A_S")
	self:addProperty("ProjetoOS",      "Projeto da O.S",         "string", "Projeto da O.S",        "PROJETO")
	self:addProperty("ObraOS",         "Obra da O.S",            "string", "Obra da O.S",           "OBRA")
	self:addProperty("FilialSS",       "Filial da S.S",          "string", "Filial da S.S",         "FILIALSS")
