namespace totvs.protheus.rental.manutencao.integratedprovider

@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGALOC", tables="FP0,FPF,ST9", name="Rental", country="ALL", initialRelease="12.1.2210")
class dispstatusana from totvs.framework.treports.integratedprovider.integratedprovider
public method new() as object
public method getData() as object
public method getSchema() as object 
endclass

/*/{PROTHEUS.DOC} Minutas
ITUP BUSINESS - TOTVS RENTAL
Declaração das classes
@AUTHOR LEONARDO PACHECO FUGA
@SINCE 31/10/2025
/*/

method new() class dispstatusana
	_Super:new()
	//Define a Área
	self:appendArea("Rental")

	//Define o nome do Objeto de Negócio
	self:setDisplayName("Disponibilidade por Status Analitico")

	//Define a descrição do Objeto de Negócio
	self:setDescription("Disponibilidade por Status Analitico")
return self

/*/{PROTHEUS.DOC} getData
ITUP BUSINESS - TOTVS RENTAL
Processamento do relatório
@AUTHOR LEONARDO PACHECO FUGA
@SINCE 31/10/2025
/*/

method getData(nPage as numeric, oFilter as object) as object class dispstatusana
local cQuery as character
Local aBind       := {}

	//Define a quantidade máxima por página (Default 100)
	self:setPageSize(20)

	jParams := oFilter:getParameters() //metodo para retorno do json dos parâmetros

	If type("jParams['01'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['01'][1] := space(TamSx3("T9_FILIAL")[1])
	EndIf
	If empty(jParams['01'][1])
		jParams['01'][1] := space(TamSx3("T9_FILIAL")[1])
	EndIf

	If type("jParams['02'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['02'][1] := space(TamSx3("T9_FILIAL")[1])
	EndIf
	If empty(jParams['02'][1])
		jParams['02'][1] := space(TamSx3("T9_FILIAL")[1])
	EndIf

	If type("jParams['03'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['03'][1] := space(TamSx3("T9_CODFIL")[1])
	EndIf
	If empty(jParams['03'][1])
		jParams['03'][1] := space(TamSx3("T9_CODFIL")[1])
	EndIf

	If type("jParams['04'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['04'][1] := space(TamSx3("T9_CODFIL")[1])
	EndIf
	If empty(jParams['04'][1])
		jParams['04'][1] := space(TamSx3("T9_CODFIL")[1])
	EndIf

	If type("jParams['05'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['05'][1] := space(TamSx3("HB_COD")[1])
	EndIf
	If empty(jParams['05'][1])
		jParams['05'][1] := space(TamSx3("HB_COD")[1])
	EndIf

	If type("jParams['06'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['06'][1] := space(TamSx3("HB_COD")[1])
	EndIf
	If empty(jParams['06'][1])
		jParams['06'][1] := space(TamSx3("HB_COD")[1])
	EndIf

	If type("jParams['07'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['07'][1] := space(TamSx3("T9_CODBEM")[1])
	EndIf
	If empty(jParams['07'][1])
		jParams['07'][1] := space(TamSx3("T9_CODBEM")[1])
	EndIf

	If type("jParams['08'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['08'][1] := space(TamSx3("T9_CODBEM")[1])
	EndIf
	If empty(jParams['08'][1])
		jParams['08'][1] := space(TamSx3("T9_CODBEM")[1])
	EndIf

	If type("jParams['09'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['09'][1] := space(TamSx3("T6_CODFAMI")[1])
	EndIf
	If empty(jParams['09'][1])
		jParams['09'][1] := space(TamSx3("T6_CODFAMI")[1])
	EndIf

	If type("jParams['10'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['10'][1] := space(TamSx3("T6_CODFAMI")[1])
	EndIf
	If empty(jParams['10'][1])
		jParams['10'][1] := space(TamSx3("T6_CODFAMI")[1])
	EndIf

	If type("jParams['11'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['11'][1] := space(TamSx3("T9_TIPMOD")[1])
	EndIf
	If empty(jParams['11'][1])
		jParams['11'][1] := space(TamSx3("T9_TIPMOD")[1])
	EndIf

	If type("jParams['12'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['12'][1] := space(TamSx3("T9_TIPMOD")[1])
	EndIf
	If empty(jParams['12'][1])
		jParams['12'][1] := space(TamSx3("T9_TIPMOD")[1])
	EndIf

	If type("jParams['13'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['13'][1] := space(TamSx3("FQD_STAREN")[1])
	EndIf
	If empty(jParams['13'][1])
		jParams['13'][1] := space(TamSx3("FQD_STAREN")[1])
	EndIf

	If type("jParams['14'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['14'][1] := space(TamSx3("FQD_STAREN")[1])
	EndIf
	If empty(jParams['14'][1])
		jParams['14'][1] := space(TamSx3("FQD_STAREN")[1])
	EndIf

	If type("jParams['15'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['15'][1] := space(TamSx3("FQ4_PROJET")[1])
	EndIf
	If empty(jParams['15'][1])
		jParams['15'][1] := space(TamSx3("FQ4_PROJET")[1])
	EndIf

	If type("jParams['16'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['16'][1] := space(TamSx3("FQ4_PROJET")[1])
	EndIf
	If empty(jParams['16'][1])
		jParams['16'][1] := space(TamSx3("FQ4_PROJET")[1])
	EndIf

	If type("jParams['17'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['17'][1] := space(TamSx3("FQ4_OBRA")[1])
	EndIf
	If empty(jParams['17'][1])
		jParams['17'][1] := space(TamSx3("FQ4_OBRA")[1])
	EndIf

	If type("jParams['18'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['18'][1] := space(TamSx3("FQ4_OBRA")[1])
	EndIf
	If empty(jParams['18'][1])
		jParams['18'][1] := space(TamSx3("FQ4_OBRA")[1])
	EndIf
//------------------------------------------------------------------------------------------------------
	cQuery := " SELECT "
	cQuery += " ST9.T9_CODFIL, ST9.T9_FILIAL, ST9.T9_CODBEM, ST9.T9_CODIMOB, ST9.T9_TIPMOD, TQR.TQR_DESMOD, "
	cQuery += " COALESCE(ST6.T6_CODFAMI,' ') T6_CODFAMI, "
	cQuery += " COALESCE(ST6.T6_NOME,' ') T6_NOME, "	 
	cQuery += " ST9.T9_FABRICA, T7_NOME, "		  
	cQuery += " ST9.T9_NOME, "		 
	cQuery += " ST9.T9_STATUS, "
	cQuery += " CASE "
	cQuery += " WHEN FQD.FQD_STAREN = '00' THEN 'DISPONIVEL' "
	cQuery += " WHEN FQD.FQD_STAREN = '  ' THEN 'DISPONIVEL' "
	cQuery += " WHEN FQD.FQD_STAREN = '10' THEN 'CONTRATO GERADO' "
	cQuery += " WHEN FQD.FQD_STAREN = '20' THEN 'NF DE REMESSA GERADA' "
	cQuery += " WHEN FQD.FQD_STAREN = '50' THEN 'RETORNO DE LOCACAO' "
	cQuery += " WHEN FQD.FQD_STAREN = '60' THEN 'NF DE RETORNO GERADA' "
	cQuery += " WHEN FQD.FQD_STAREN = '70' THEN 'MANUTENCAO' "
	cQuery += " ELSE ' ' "
	cQuery += " END FQD_STAREN, "
	cQuery += " COALESCE(SHB.HB_COD, ' ') HB_COD, " 		
	cQuery += " COALESCE(SHB.HB_NOME, ' ') HB_NOME, "		
	cQuery += " COALESCE(CTT.CTT_CUSTO, 'SEM CENTRO DE CUSTO') CTT_CUSTO, "
	cQuery += " COALESCE(CTT.CTT_DESC01,'SEM CENTRO DE CUSTO') CTT_DESC01, "	  
	cQuery += " COALESCE(FQ4.FQ4_DOCUME,' ') FQ4_DOCUME, "		  
	cQuery += " COALESCE(FQ4.FQ4_SERIE,' ') FQ4_SERIE, "		  
	cQuery += " COALESCE(FQ4.FQ4_OS,' ') FQ4_OS, "		  
	cQuery += " COALESCE(FQ4.FQ4_SERVIC,' ') FQ4_SERVIC, "		  
	cQuery += " COALESCE(FQ4.FQ4_PRELIB,' ') FQ4_PRELIB,	"	  
	cQuery += " COALESCE(FQ4.FQ4_PROJET,' ') FQ4_PROJET,	"	  
	cQuery += " COALESCE(FQ4.FQ4_OBRA,' ') FQ4_OBRA, "		  
	cQuery += " COALESCE(FQ4.FQ4_AS,' ') FQ4_AS,	"	  
	cQuery += " COALESCE(FQ4.FQ4_CODCLI,' ') FQ4_CODCLI, "		  
	cQuery += " COALESCE(FQ4.FQ4_LOJCLI,' ') FQ4_LOJCLI, "		  
	cQuery += " COALESCE(FQ4.FQ4_NOMCLI,' ') FQ4_NOMCLI, "		  		  
	cQuery += " COALESCE(FQ4.FQ4_DTINI,' ') FQ4_DTINI, "		  
	cQuery += " COALESCE(FQ4.FQ4_DTFIM,' ') FQ4_DTFIM, "		  
	cQuery += " COALESCE(FQ4.FQ4_LOG,' ') FQ4_LOG, "		 
	cQuery += " COALESCE(FQ4.FQ4_PREDES,' ') FQ4_PREDES "	  
	cQuery += " FROM "+RetSqlName("ST9")+" ST9 "
	If !Empty(jParams['15'][1])  
		cQuery += " INNER JOIN "+RetSqlName("FQ4")+" FQ4 "       
		cQuery += " ON FQ4.FQ4_FILIAL = '"+xFilial("FQ4")+ "' "
		cQuery += " AND FQ4.FQ4_CODBEM = ST9.T9_CODBEM AND "
		cQuery += " FQ4.FQ4_PROJET >= ? AND "
		AAdd(aBind, {jParams['15'][1], "S"})
		cQuery += " FQ4.FQ4_PROJET <= ? AND "
		AAdd(aBind, {jParams['16'][1], "S"})	
		cQuery += " FQ4.FQ4_OBRA >= ? AND "
		AAdd(aBind, {jParams['17'][1], "S"})
		cQuery += " FQ4.FQ4_OBRA <= ? AND "
		AAdd(aBind, {jParams['18'][1], "S"})		         
		cQuery += " FQ4.D_E_L_E_T_=' ' "  
		cQuery += " AND FQ4.R_E_C_N_O_ = (SELECT MAX(FQ41.R_E_C_N_O_) FROM "+RetSqlName("FQ4")+" FQ41 WHERE FQ41.FQ4_CODBEM = ST9.T9_CODBEM AND FQ41.D_E_L_E_T_ = ' ' ) "
	Else
		cQuery += " LEFT JOIN "+RetSqlName("FQ4")+" FQ4 "       
		cQuery += " ON FQ4.FQ4_FILIAL = '"+xFilial("FQ4")+ "' "
		cQuery += " AND FQ4.FQ4_CODBEM = ST9.T9_CODBEM AND "	         
		cQuery += " FQ4.D_E_L_E_T_=' ' "  
		cQuery += " AND FQ4.R_E_C_N_O_ = (SELECT MAX(FQ41.R_E_C_N_O_) FROM "+RetSqlName("FQ4")+" FQ41 WHERE FQ41.FQ4_CODBEM = ST9.T9_CODBEM AND FQ41.D_E_L_E_T_ = ' ' ) "
	EndIF
	cQuery += " LEFT JOIN "+RetSqlName("CTT")+" CTT "
	cQuery += " ON CTT.CTT_FILIAL = '"+xFilial("CTT")+ "' "
	cQuery += " AND CTT.CTT_CUSTO = ST9.T9_CCUSTO "
	cQuery += " AND CTT.D_E_L_E_T_ = ' ' "
	cQuery += " LEFT JOIN "+RetSqlName("TQR")+" TQR "
	cQuery += " ON TQR.TQR_FILIAL = '"+xFilial("TQR")+ "' "
	cQuery += " AND TQR.TQR_TIPMOD = ST9.T9_TIPMOD "
	cQuery += " AND TQR.D_E_L_E_T_ = ' ' "
	cQuery += " LEFT JOIN "+RetSqlName("ST7")+" ST7 "
	cQuery += " ON ST7.T7_FILIAL = '"+xFilial("ST7")+ "' "
	cQuery += " AND ST7.T7_FABRICA = ST9.T9_FABRICA "
	cQuery += " AND ST7.D_E_L_E_T_ = ' ' "
	cQuery += " LEFT JOIN "+RetSqlName("SHB")+" SHB "      
	cQuery += " ON SHB.HB_FILIAL = '"+xFilial("SHB")+ "' "
	cQuery += " AND SHB.HB_COD = ST9.T9_CENTRAB AND "  	  
	cQuery += " SHB.D_E_L_E_T_= ' ' "
	cQuery += " LEFT JOIN "+RetSqlName("ST6")+" ST6 "
	cQuery += " ON ST6.T6_FILIAL = '"+xFilial("ST6")+ "' "   
	cQuery += " AND ST6.T6_CODFAMI = ST9.T9_CODFAMI AND "  
	cQuery += " ST6.D_E_L_E_T_ = ' ' "
	cQuery += " INNER JOIN "+RetSqlName("FQD")+" FQD "
	cQuery += " ON FQD.FQD_FILIAL = '"+xFilial("FQD")+ "' "
	cQuery += " AND FQD.FQD_STATQY = ST9.T9_STATUS AND "
	cQuery += " FQD.FQD_STAREN >= ? AND "
	AAdd(aBind, {jParams['13'][1], "S"})
	cQuery += " FQD.FQD_STAREN <= ? AND "
	AAdd(aBind, {jParams['14'][1], "S"})
	cQuery += " FQD.D_E_L_E_T_ = ' ' "
	cQuery += " WHERE ST9.T9_SITBEM	= 'A' AND "	
	cQuery += " ST9.T9_FILIAL >= ? AND "
	AAdd(aBind, {jParams['01'][1], "S"})
	cQuery += " ST9.T9_FILIAL <= ? AND "
	AAdd(aBind, {jParams['02'][1], "S"})
	cQuery += " ST9.T9_CODFIL >= ? AND "
	AAdd(aBind, {jParams['03'][1], "S"})
	cQuery += " ST9.T9_CODFIL <= ? AND "
	AAdd(aBind, {jParams['04'][1], "S"})
	cQuery += " ST9.T9_CENTRAB >= ? AND "
	AAdd(aBind, {jParams['05'][1], "S"})
	cQuery += " ST9.T9_CENTRAB <= ? AND "
	AAdd(aBind, {jParams['06'][1], "S"})
	cQuery += " ST9.T9_CODBEM >= ? AND "
	AAdd(aBind, {jParams['07'][1], "S"})
	cQuery += " ST9.T9_CODBEM <= ? AND "
	AAdd(aBind, {jParams['08'][1], "S"})
	cQuery += " ST9.T9_CODFAMI >= ? AND "
	AAdd(aBind, {jParams['09'][1], "S"})
	cQuery += " ST9.T9_CODFAMI <= ? AND "
	AAdd(aBind, {jParams['10'][1], "S"})
	cQuery += " ST9.T9_TIPMOD >= ? AND "
	AAdd(aBind, {jParams['11'][1], "S"})
	cQuery += " ST9.T9_TIPMOD <= ? AND "
	AAdd(aBind, {jParams['12'][1], "S"})
	cQuery += " ST9.D_E_L_E_T_ = ' ' "			  
	cQuery := CHANGEQUERY(cQuery)
	cQuery := JurTRepBin(cQuery, aBind)
	self:setOrder("ST9.T9_CODFAMI, ST9.T9_TIPMOD, ST9.T9_CODBEM")
	self:setQuery(cQuery)

return self:oData

