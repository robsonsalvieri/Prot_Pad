method getSchema() as object class dispstatusana
 
	self:addProperty("FilialEquip",  "Filial Equip",       "string", "Filial Equip",       "T9_CODFIL")
	self:addProperty("Filial",       "Filial",             "string", "Filial",             "T9_FILIAL")
	self:addProperty("Equipamento",  "Equipamento",        "string", "Equipamento",        "T9_CODBEM")
	self:addProperty("DescEquip",    "Desc. Equip.",       "string", "Desc. Equip.",       "T9_NOME")
	self:addProperty("Imobilizado",  "Imobilizado",        "string", "Imobilizado",        "T9_CODIMOB")
	self:addProperty("TipoModelo",   "Tipo Modelo",        "string", "Tipo Modelo",        "T9_TIPMOD")
	self:addProperty("DescMod",      "Desc. Modelo",       "string", "Desc. Modelo",       "TQR_DESMOD")
	self:addProperty("Familia",      "Familia",            "string", "Familia",            "T6_CODFAMI")
	self:addProperty("DescFamilia",  "Desc. Familia",      "string", "Desc. Familia",      "T6_NOME")
	self:addProperty("Fabricante",   "Fabricante",         "string", "Fabricante",         "T9_FABRICA")
	self:addProperty("NomeFab",      "Nome do Fabricante", "string", "Nome do Fabricante", "T7_NOME")
	self:addProperty("StatusBem",    "Status Bem",         "string", "Status Bem",         "T9_STATUS")
	self:addProperty("NomeStatus",   "Nome do Status",     "string", "Nome do Status",     "FQD_STAREN")
	self:addProperty("CTrabalho",    "C. Trabalho",        "string", "C. Trabalho",        "HB_COD")
	self:addProperty("DescCTrab",    "Desc. C. Trab.",     "string", "Desc. C. Trab.",     "HB_NOME")
	self:addProperty("CCusto",       "C. Custo",           "string", "C. Custo",           "CTT_CUSTO")
	self:addProperty("DescCCusto",   "Desc. C. Custo",     "string", "Desc. C. Custo",     "CTT_DESC01")
	self:addProperty("NFRemessa",    "NF Remessa",         "string", "NF Remessa",         "FQ4_DOCUME")
	self:addProperty("Serie",        "Serie",              "string", "Serie",              "FQ4_SERIE")
	self:addProperty("OS",           "O.S",                "string", "O.S",                "FQ4_OS")
	self:addProperty("Servico",      "Servico",            "string", "Servico",            "FQ4_SERVIC")
	self:addProperty("PrevLibera",   "Prev. Libera",       "string", "Prev. Libera",       "FQ4_PRELIB")
	self:addProperty("Projeto",      "Projeto",            "string", "Projeto",            "FQ4_PROJET")
	self:addProperty("Obra",         "Obra",               "string", "Obra",               "FQ4_OBRA")
	self:addProperty("NrAS",         "Nr. A.S.",           "string", "Nr. A.S.",           "FQ4_AS")
	self:addProperty("Cliente",      "Cliente",            "string", "Cliente",            "FQ4_CODCLI")
	self:addProperty("Loja",         "Loja",               "string", "Loja",               "FQ4_LOJCLI")
	self:addProperty("NomeCli",      "Nome Cliente",       "string", "Nome Cliente",       "FQ4_NOMCLI")
	self:addProperty("DtInicio",     "Dt. Inicio",         "date",   "Dt. Inicio",         "FQ4_DTINI")
	self:addProperty("DtFim",        "Dt. Fim",            "date",   "Dt. Fim",            "FQ4_DTFIM")
	self:addProperty("LOG",          "LOG",                "string", "LOG",                "FQ4_LOG")
	self:addProperty("PrevRetirada", "Prev Retirada",      "date",   "Prev Retirada",      "FQ4_PREDES")

	self:addParameter("01", "Filial de",          "string", .F., "", .F., .T., "SM0", "MV_PAR01")
	self:addParameter("02", "Filial até",         "string", .F., "", .F., .T., "SM0", "MV_PAR02")
	self:addParameter("03", "Filial do Bem de",   "string", .F., "", .F., .T., "SM0", "MV_PAR03")
	self:addParameter("04", "Filial do Bem até",  "string", .F., "", .F., .T., "SM0", "MV_PAR04")
	self:addParameter("05", "C. Trabalho de",     "string", .F., "", .F., .T., "SHB", "MV_PAR05")
	self:addParameter("06", "C. Trabalho até",    "string", .F., "", .F., .T., "SHB", "MV_PAR06")
	self:addParameter("07", "Equipamento de",     "string", .F., "", .F., .T., "ST9", "MV_PAR07")
	self:addParameter("08", "Equipamento até",    "string", .F., "", .F., .T., "ST9", "MV_PAR08")
	self:addParameter("09", "Familia de",         "string", .F., "", .F., .T., "ST6", "MV_PAR09")
	self:addParameter("10", "Familia até",        "string", .F., "", .F., .T., "ST6", "MV_PAR10")
	self:addParameter("11", "Modelo de",          "string", .F., "", .F., .T., "TQR", "MV_PAR11")
	self:addParameter("12", "Modelo até",         "string", .F., "", .F., .T., "TQR", "MV_PAR12")
	self:addParameter("13", "Staus de",           "string", .F., "", .F., .T., "FQD", "MV_PAR13")
	self:addParameter("14", "Staus até",          "string", .F., "", .F., .T., "FQD", "MV_PAR14")
	self:addParameter("15", "Projeto de",         "string", .F., "", .F., .T., "FP0", "MV_PAR15")
	self:addParameter("16", "Projeto até",        "string", .F., "", .F., .T., "FP0", "MV_PAR16")
	self:addParameter("17", "Obra de",            "string", .F., "", .F., .F., "",    "MV_PAR17")
	self:addParameter("18", "Obra até",           "string", .F., "", .F., .F., "",    "MV_PAR18")

return self:oSchema
