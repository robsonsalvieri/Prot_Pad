/*/{Protheus.doc} checkFields
Verifica se o campo do objeto está de acorco com os parâmetros informados (tipo e obrigatóriedade)
@type method
@version 12.1.2510 
@author giovanna.charlo
@since 21/10/2025
@param jData, json, dados do campo a ser verificado (body, attribute, type, required)
@return logical, se o campo está válido
/*/
method checkFields(jData as json) as logical class CadBenefApiContractsService

	local lOk := .T. as logical

	if jData["required"] .and. !jData["body"]:hasProperty(jData["attribute"])
		lOk := .F.
		self:setResponseStatus("E", "400.001", STR0001 + jData["attribute"] + STR0002 ) // "O campo ";" é obrigatório."
		self:setStatusCode(400)
	else
		if jData["body"]:hasProperty(jData["attribute"]) .and. valType(jData["body"][jData["attribute"]]) <> jData["type"]
			lOk := .F.
			self:setResponseStatus("E", "400.002", STR0003 + jData["attribute"] + STR0004) // "O valor informado para o campo ";" é inválido."

		endif
	endif

return lOk


/*/{Protheus.doc} validJsonData
Valida se os dados do json (body) está preenchidos corretamente. (obrigatóriedade e tipo)
@type method
@version 12.1.2510 
@author giovanna.charlo
@since 21/05/2024
@return logical, se os dados do body estão validos.
/*/
method validJsonData() as logical class CadBenefApiContractsService

	if self:checkFields({"body": self:jRequestBody, "attribute": "dadosBeneficiario", "type": "J", "required": REQUIRED})
		self:checkFields({"body": self:jRequestBody["dadosBeneficiario"], "attribute": "carteirinhaBeneficiario", "type": "C", "required": REQUIRED})

        if self:checkFields({"body": self:jRequestBody["dadosBeneficiario"], "attribute": "statusProcessamento", "type": "A", "required": REQUIRED})
            if self:checkFields({"body": self:jRequestBody["dadosBeneficiario"]["statusProcessamento"][1], "attribute": "status", "type": "C", "required": REQUIRED})
                if self:jRequestBody["dadosBeneficiario"]["statusProcessamento"][1]["status"] == "S"
                    self:checkFields({"body": self:jRequestBody["dadosBeneficiario"], "attribute": "codigoControleUnimedBrasil", "type": "C", "required": REQUIRED})
                endif
            endif
            self:checkFields({"body": self:jRequestBody["dadosBeneficiario"]["statusProcessamento"][1], "attribute": "codigoMensagem", "type": "C", "required": REQUIRED})
            self:checkFields({"body": self:jRequestBody["dadosBeneficiario"]["statusProcessamento"][1], "attribute": "descricaoMensagem", "type": "C", "required": REQUIRED})

        endif
    endif

return !self:lError
/*/{Protheus.doc} validRequestData
Valida se os dados recebidos pela requisição estão validos para serem processados
@type method
@version 12.1.2510 
@author giovanna.charlo
@since 21/10/2025
@return logical, se os dados da solicitação estão válidos.
/*/
method validRequestData() as logical class CadBenefApiContractsService

	local lValid := .F. as logical
	local lFoundBeneficiary := .F. as logical
	local lFoundBatch := .F. as logical

	BA1->(dbSetOrder(2))
    lFoundBeneficiary := BA1->(msSeek(xFilial("BA1") +self:jRequestBody["dadosBeneficiario"]["carteirinhaBeneficiario"])) 

	lFoundBatch := searchBatch(self:jRequestBody["dadosBeneficiario"]["carteirinhaBeneficiario"])

    if !lFoundBeneficiary .or. !lFoundBatch
        self:setResponseStatus("E", "422.003", STR0005) // "Beneficiário ou lote com essa carteirinha não encontrado."
		self:setStatusCode(422)
    else
		if self:validJsonData() 
			lValid := .T.
		endif
    endif

return lValid

/*/{Protheus.doc} setResponseStatus
Defini o status da resposta da api
@type method
@version 12.1.2510 
@author giovanna.charlo
@since 21/05/2024
@param cStatus, character, status, sendo: E ou S
@param cCode, character, código do status code
@param cMessage, character, mensagem do status
@param cSubscriberId, character, número de carteirinha do beneficiário
/*/
method setResponseStatus(cStatus as character, cCode as character, cMessage as character) class CadBenefApiContractsService

	local jStatus := JsonObject():new() as object
	
	jStatus["status"] := cStatus
	jStatus["codigoMensagem"] := cCode
	jStatus["descricaoMensagem"] := cMessage

	if !self:jResponseBody:hasProperty("dadosBeneficiario")
		self:jResponseBody["dadosBeneficiario"] := JsonObject():new()
	endif

    if self:jRequestBody:hasProperty("dadosBeneficiario") .and. self:jRequestBody["dadosBeneficiario"]:hasProperty("carteirinhaBeneficiario")
		self:jResponseBody["dadosBeneficiario"]["carteirinhaBeneficiario"] := self:jRequestBody["dadosBeneficiario"]["carteirinhaBeneficiario"]
    endif

	self:jResponseBody["dadosBeneficiario"]["statusProcessamento"] := { jStatus }
	
	if cStatus == "E"
		self:lError := .T.
	endif

return

/*/{Protheus.doc} commitUpdate
Realiza a atualização do lote do beneficiário
@type method
@version 12.1.2510 
@author giovanna.charlo
@since 21/05/2024
@return logical, se a gravação foi realizada com sucesso
/*/
method commitUpdate() as logical class CadBenefApiContractsService

	local lSuccess := .F. as logical
	local oModelBPY as object
	local cMessage as character
	local cStatusCode as character
	local nStatusCode as numeric
	local cStatusBatch as character
	local cStatusResponse as character
	local aErrorMessage as array
	local cResult as character

	BPY->(dbSetOrder(2))
    if BPY->(msSeek(xFilial("BPY") +self:jRequestBody["dadosBeneficiario"]["carteirinhaBeneficiario"]))

		oModelBPY := fwLoadModel("PLPTU002")
		oModelBPY:setOperation(MODEL_OPERATION_UPDATE)
		oModelBPY:activate()

		BPW->(dbSetOrder(1))
    	if BPW->(msSeek(xFilial("BPW")+ BPY->BPY_CODLOT))

			cStatusResponse := self:jRequestBody["dadosBeneficiario"]["statusProcessamento"][1]["status"]

			do case
				case cStatusResponse == "S"
					cStatusBatch := "2"
					cadBenefUpdateBatchStatus(SUCCESSFULLY_COMPLETED)
				case cStatusResponse == "E"
					cStatusBatch := "3"
					cadBenefUpdateBatchStatus(BATCH_WITH_ERROR)
			OtherWise
					cStatusBatch := "4"
					cadBenefUpdateBatchStatus(UNDER_ANALYSIS)
			endcase
		endif

		cResult := BPY->BPY_MSGRES + CRLF + Replicate("-",100) + CRLF + self:jRequestBody["dadosBeneficiario"]["statusProcessamento"][1]["descricaoMensagem"]

        oModelBPY:setValue("BPYMASTER", "BPY_DATENV", dDataBase)
		oModelBPY:setValue("BPYMASTER", "BPY_HORENV", time())
		oModelBPY:setValue("BPYMASTER", "BPY_MSGRES", cResult)

		if cStatusBatch == "2"
			oModelBPY:setValue("BPYMASTER", "BPY_RESULT", "Beneficiário Incluído")
		else
			oModelBPY:setValue("BPYMASTER", "BPY_RESULT", "Existem críticas referente a comercialização deste contrato")
		endif

		oModelBPY:setValue("BPYMASTER", "BPY_STATUS", cStatusBatch)

		cMessage := STR0006 // "Beneficiário atualizado."
		cStatusCode := "200.001"
		nStatusCode := 200    
		                                                                  
	endif   

	if oModelBPY:vldData()
		oModelBPY:commitData()

		if self:jRequestBody["dadosBeneficiario"]:hasProperty("codigoControleUnimedBrasil") .and. !empty(self:jRequestBody["dadosBeneficiario"]["codigoControleUnimedBrasil"])
			BA1->(dbSetOrder(2))
    		BA1->(msSeek(xFilial("BA1") +self:jRequestBody["dadosBeneficiario"]["carteirinhaBeneficiario"]))
			
			RecLock("BA1",.F.)
            BA1->BA1_CODUBR := self:jRequestBody["dadosBeneficiario"]["codigoControleUnimedBrasil"]
        	BA1->(MsUnLock())
		endif 

		self:setResponseStatus("S", cStatusCode, cMessage)
		self:setStatusCode(nStatusCode)
		lSuccess := .T.
	else
		aErrorMessage := oModelBPY:getErrorMessage()

		if len(aErrorMessage) >= 6 .and. !empty(aErrorMessage[6])
			self:setResponseStatus("E", "422.024", aErrorMessage[6])
			self:setStatusCode(422)
		endif
	endif

	oModelBPY:deActivate()
	oModelBPY:destroy()

	freeObj(oModelBPY)
	fwFreeArray(aErrorMessage)

return lSuccess

/*/{Protheus.doc} destroy
Limpa da memória as variáveis (objeto, array e json) da clase
@type method
@version 12.1.2510 
@author giovanna.charlo
@since 21/05/2024
/*/
method destroy() class CadBenefApiContractsService

	freeObj(self:jRequestBody)
	freeObj(self:jResponseBody)
return

/*/{Protheus.doc} searchBatch
Localiza o lote do cadbenef deste beneficiário.
@type method
@version 12.1.2510 
@author giovanna.charlo
@since 21/05/2024
@param cSubscriberId, character, carteirinha do beneficiário
/*/
static function searchBatch(cSubscriberId as character) as logical

	local lFoundBatch := .f. as logical 
	local oExecStmt as object
	local cQuery as character
	local nOrder := 1 as numeric
	local cAlias as character

	cQuery := " SELECT ? "
	cQuery += " FROM ? BPY "
	cQuery += " WHERE "
	cQuery += "     BPY.BPY_FILIAL = ? AND "
	cQuery += "     BPY.BPY_CODINT = ? AND "
	cQuery += "     BPY.BPY_CODEMP = ? AND "
	cQuery += "     BPY.BPY_MATRIC = ? AND "
	cQuery += "     BPY.BPY_TIPREG = ? AND "
	cQuery += "     BPY.BPY_DIGITO = ? AND "
	cQuery += "     BPY.BPY_TIPMOV = ? AND "
	cQuery += "     BPY.D_E_L_E_T_ = ? "

	oExecStmt := FwExecStatement():new(cQuery)

	oExecStmt:setUnsafe(nOrder++, "BPY.BPY_CODLOT")
	oExecStmt:setUnsafe(nOrder++, retSqlName("BPY"))
	oExecStmt:setString(nOrder++, xFilial("BPY"))
	oExecStmt:setString(nOrder++, substr(cSubscriberId, 1, 4))
	oExecStmt:setString(nOrder++, substr(cSubscriberId, 5, 4))
	oExecStmt:setString(nOrder++, substr(cSubscriberId, 9, 6)) 
	oExecStmt:setString(nOrder++, substr(cSubscriberId, 15, 2))
	oExecStmt:setString(nOrder++, substr(cSubscriberId, 17, 1))
	oExecStmt:setString(nOrder++, "1")
	oExecStmt:setString(nOrder++, "")

	cAlias := oExecStmt:openAlias()

	if !(cAlias)->(eof())
		lFoundBatch := .t.
	endif

	(cAlias)->(dbCloseArea())

	freeObj(oExecStmt)

return lFoundBatch
