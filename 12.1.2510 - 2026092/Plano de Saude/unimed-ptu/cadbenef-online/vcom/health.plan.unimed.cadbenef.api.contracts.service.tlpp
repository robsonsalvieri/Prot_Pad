#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "fwmvcdef.ch"
#include "health.plan.unimed.cadbenef.api.contracts.service.ch"

#define CRLF CHR(13) + CHR(10)
#define LOG_FILE_NAME "unimed-cadbenef-api-contracts.log"
#define REQUIRED .T.
#define OPTIONAL .F.


#define BATCH_WITH_ERROR "3" // Lote com erro
#define SUCCESSFULLY_COMPLETED "4" // Finalizado com sucesso
#define UNDER_ANALYSIS "6" // "Em Análise"

namespace totvs.protheus.health.plan.unimed

using namespace totvs.protheus.health.plan.api.util

/*/{Protheus.doc} CadBenefApiContractsService
Possibilitar que seja enviado a atualização do beneficiário referente a validação VCOM para Unimed Destino.
Limite máximo: 1 Beneficiário por mensagem
@type class
@version 12.1.2510 
@author giovanna.charlo
@since 21/10/2025
/*/
class CadBenefApiContractsService

    protected data cRequestBody as character
    protected data jRequestBody as json
	protected data jResponseBody as json
    protected data nStatusCode as numeric
    protected data lError as logical
	protected data cHealthInsurerCode as character
	

    public method new() constructor	
    public method post() as logical

    public method setRequestBody(cRequestBody as character)
    public method getResponse() as character
	public method getStatusCode() as numeric
    public method destroy()

	protected method validRequestData() as logical
    protected method validJsonData() as logical
    protected method checkFields(jData as json) as logical
	protected method commitUpdate() as logical
	protected method setResponseStatus(cStatus as character, cCode as character, cMessage as character)
	protected method setStatusCode(nStatusCode as numeric)

endclass

/*/{Protheus.doc} new
Método construtor da classe
@type method
@version 12.1.2510 
@author giovanna.charlo
@since 21/10/2025
@return object, objeto da instância da classe
/*/
method new() class CadBenefApiContractsService

	self:jRequestBody := JsonObject():new()
	self:jResponseBody := JsonObject():new()
	self:cHealthInsurerCode := plsIntPad()
	self:lError := .F.

return self

/*/{Protheus.doc} post
Realiza o processamento da requisição de inclusão (post) da atualização do beneficiário.
@type method
@version 12.1.2510 
@author giovanna.charlo
@since 21/10/2025
@return logical, se o processo de inclusão foi realizado com sucesso
/*/
method post() as logical class CadBenefApiContractsService

	local lSuccess := .F. as logical

	if self:validRequestData() 
	
		lSuccess := self:commitUpdate()
	endif

return lSuccess

