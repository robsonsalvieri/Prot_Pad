#include "tlpp-core.th"
#include "fwmvcdef.ch"
#include "health.plan.unimed.cadbenef.contracts.send.ch"

#define CRLF CHR(13) + CHR(10)
#define SEND_COMPLETED "1" // Cadastrado com Sucesso 
#define PENDING_SEND "2" // Pendente de envio
#define SEND_ERROR "3" // Erro de envio
#define IN_ANALYSIS "4" // Em análise
#define COMPLETED "5" // Em análise

#define SEND_DISABLED  "5" // Não Envio do VCom

#define INCLUSION_TYPE "0" // Inclusão 
#define UPDATE_TYPE "1" // Encerramento
#define SEARCH_TYPE "2" // Consultar
#define RESEND_TYPE "3" // Renvio

namespace totvs.protheus.health.plan.unimed

using namespace totvs.protheus.health.plan.api.util

/*/{Protheus.doc} cadBenefSendContracts
Realiza a comunicação com o servidor do CadBenef para envio do contrato
@type function
@version 12.1.2510
@author giovanna.charlo
@since 20/03/2025
@param lShowMessage, logical, exibir mensagem do status do envio
@return json, objeto com os dados do status do envio
/*/
function cadBenefSendContracts(cOperation as character, cAlias as character, cKey as character) as json

    local oCadBenefContract as object
    local jContractData as json
    local jStatus as json
    local aArea := getArea() as array

    jStatus := {"status": "",;
                "sendMessage": "",;
                "responseMessage": "",;
                "showMessage": "",;
                "transactionCode": "",;
                "sendDate": "",;
                "sendTime": "",;
                "protocolNumber": "",;
                "responseTime": "";
               }
 
    (cAlias)->(dbSetOrder(1))
    if !(cAlias)->(msSeek(xFilial(cAlias) + &(cAlias+"->(" + cKey + ")")))
        jStatus["status"] := SEND_ERROR
        jStatus["showMessage"] := STR0005 //"Não foi encontrado nenhum contrato com essa chave."
        return jStatus
    else
        if cAlias == "BA1"
            BA3->(dbSetOrder(1)) // BA3_FILIAL+BA3_CODINT+BA3_CODEMP+BA3_MATRIC+BA3_CONEMP+BA3_VERCON+BA3_SUBCON+BA3_VERSUB
            if BA3->(msSeek(xFilial("BA3") + BA1->(BA1_CODINT+BA1_CODEMP+BA1_MATRIC+BA1_CONEMP+BA1_VERCON+BA1_SUBCON+BA1_VERSUB)))
                cAlias := "BA3"
                cKey := BA3->(BA3_CODINT+BA3_CODEMP+BA3_MATRIC+BA3_CONEMP+BA3_VERCON+BA3_SUBCON+BA3_VERSUB) 
            else
                jStatus["status"] := SEND_ERROR
                jStatus["showMessage"] := STR0008
                return jStatus                                                   
            endif
        endif

        jContractData := getContractData(cAlias, cKey) 
        jStatus := contractValidation(jContractData, jStatus, cOperation) 

        if jStatus["status"] == SEND_ERROR
            return jStatus          
        elseIf jStatus["status"] == SEND_DISABLED
            return jStatus
        else
            if cOperation == RESEND_TYPE
                if BA1->(fieldPos("BA1_NPRBVC")) > 0 .and. !empty(jContractData["protocolNumber"])
                    updateBeneficiaryVComProtocol(jContractData)
                else
                    jStatus["status"] := SEND_ERROR
                    jStatus["showMessage"] :=  STR0012 //Não foi possível atualizar o protocolo VCOM. Verifique se o campo BA1_NPRBVC existe na base de dados.
                    return jStatus
                endif
            endif    
            
            oCadBenefContract := CadBenefApiContracts():new(jContractData["healthInsurerCode"])
            jStatus["transactionCode"] := getNewTransactionCode(jContractData)
                                                                                        
            if oCadBenefContract:addContracts(cKey, cOperation, jStatus["transactionCode"], jContractData)
                jStatus["responseTime"] := time()

                if oCadBenefContract:send()
                    jStatus["status"] := SEND_COMPLETED            
                else
                    jStatus["status"] := SEND_ERROR
                endif  

                jStatus["responseTime"] := elapTime(jStatus["responseTime"], time())
            else
                jStatus["status"] := SEND_ERROR 
            endif

            jStatus["showMessage"] := oCadBenefContract:getMessage()
            jStatus["sendMessage"] := oCadBenefContract:getRequest():toJson()
            jStatus["responseMessage"] := oCadBenefContract:getResponse():toJson()
            jStatus["transactionCode"] := jStatus["transactionCode"]
            jStatus["sendDate"] := dDataBase
            jStatus["sendTime"] := time()    

            if jContractData["sendingOperation"] == "1" .and. !empty(jContractData["protocolNumber"])
                jStatus["protocolNumber"] := jContractData["protocolNumber"]
            else
                jStatus["protocolNumber"] := oCadBenefContract:getProtocolNumber()
            endif
      
            RecLock(cAlias,.F.)
            &(cAlias+"->"+cAlias+"_STSVC") := jStatus["status"]
            &(cAlias+"->"+cAlias+"_NPROVC") := jStatus["protocolNumber"]
            if cOperation == "0" // Envio do contrato
                &(cAlias+"->"+cAlias+"_CDTRVC") := jStatus["transactionCode"]
                &(cAlias+"->"+cAlias+"_JSABVC") := jStatus["sendMessage"]
            elseif cOperation == "1" // Encerramento do contrato
                &(cAlias+"->"+cAlias+"_CDENVC") := jStatus["transactionCode"]
                &(cAlias+"->"+cAlias+"_JSENVC") := jStatus["sendMessage"]
            elseif cOperation == RESEND_TYPE
                &(cAlias+"->"+cAlias+"_CDTRVC") := jStatus["transactionCode"]
                &(cAlias+"->"+cAlias+"_JSABVC") := jStatus["sendMessage"]
                if jStatus["status"] == SEND_COMPLETED
                    &(cAlias+"->"+cAlias+"_CDENVC") := ""
                    &(cAlias+"->"+cAlias+"_JSENVC") := ""
                endif
            endif
            &(cAlias+"->"+cAlias+"_MSGRVC")  := &(cAlias+"->"+cAlias+"_MSGRVC") + CRLF + "[Retorno da operacao de " + iif(cOperation == "0", "ABERTURA", "ENCERRAMENTO") + " - " + dtoc(date()) + " " + time() + "]" +;
                                             CRLF + jStatus["responseMessage"] + CRLF + replicate("-", 80)
            &(cAlias+"->( MsUnlock())")

            restArea(aArea)
            oCadBenefContract:destroy()

            freeObj(jContractData)
            freeObj(oCadBenefContract)
            
        endif
    endif

return jStatus

/*/{Protheus.doc} sendContracts
Envia o contrato vinculado ao SubContrato
@type function
@version 12.1.2510
@author giovanna.charlo
@since 20/03/2025
/*/
function sendContracts(cOperation as character, cAlias as character, cKey as character)

    local cAlertMsg := "" as character

    if FWAlertNoYes("Deseja enviar este Contrato para Unimed da Brasil?", "") // "Deseja enviar todos os beneficiários do lote para o CadBenef?"

        jStatus := cadBenefSendContracts(cOperation, cAlias, cKey)

        if empty(jStatus["showMessage"])
            if jStatus["status"] == SEND_COMPLETED
                cAlertMsg := STR0006 // "Operação concluída com sucesso, porém a API não retornou detalhes adicionais."
            else
                cAlertMsg := STR0007 // "Não foi possível concluir a operação e a API não retornou detalhes sobre o erro."
            endif
        else
            cAlertMsg := jStatus["showMessage"]
        endif

        do case
            case jStatus["status"] == SEND_COMPLETED
                fwAlertSuccess(cAlertMsg, "")
            otherWise
                fwAlertError(cAlertMsg, "")
        endcase
    endif
return

/*/{Protheus.doc} getNewTransactionCode
Obter o proximo código de transação a ser utilizado para comunicar com o validador comercial unimed.
@type function
@version 12.1.2510
@author giovanna.charlo
@since 20/03/2025
@param cTransactionCode, character, código de transacao
@return character, código da transação gerado
/*/
static function getNewTransactionCode(jContractData as json) as character

    local cAlias := jContractData["alias"] as character
    local aArea := (cAlias)->(GetArea()) as array
    local oExecStmt as object
    local cTransactionCode as character
    local cMonth as character
    local cYear as character
    local cDataCurr := dtos(dDatabase)
    local cQuery as character
    local nOrder := 1 as numeric
    local lNewCode := .F. as logical

    cYear := subStr(cDataCurr, 1, 4)
    cMonth := subStr(cDataCurr, 5, 2)

    cQuery := " SELECT MAX(?) CODE "
	cQuery += " FROM ? " + cAlias
	cQuery += " WHERE "

    if cAlias == "BA3"
        cQuery += "  BA3.BA3_FILIAL = ? AND "
        cQuery += "  BA3.BA3_CODINT = ? AND "
        cQuery += "  BA3.BA3_CODEMP = ? AND "
        cQuery += "  BA3.D_E_L_E_T_ = ? "
    else
        cQuery += "  BQC.BQC_FILIAL = ? AND "
        cQuery += "  BQC.BQC_CODIGO = ? AND "
        cQuery += "  BQC.D_E_L_E_T_ = ? "
    endif

	oExecStmt := FwExecStatement():new(cQuery)

    if cAlias == "BA3"
        oExecStmt:setUnsafe(nOrder++, "CASE WHEN BA3_CDENVC > BA3_CDTRVC THEN BA3_CDENVC ELSE BA3_CDTRVC END")
        oExecStmt:setUnsafe(nOrder++, retSqlName("BA3"))
        oExecStmt:setString(nOrder++, xFilial("BA3"))
        oExecStmt:setString(nOrder++, &((cAlias)+"->"+ (cAlias + "_CODINT")))
        oExecStmt:setString(nOrder++, &((cAlias)+"->"+ (cAlias + "_CODEMP")))
        oExecStmt:setString(nOrder++, " ")
    else
        oExecStmt:setUnsafe(nOrder++, "CASE WHEN BQC_CDENVC > BQC_CDTRVC THEN BQC_CDENVC ELSE BQC_CDTRVC END")
        oExecStmt:setUnsafe(nOrder++, retSqlName("BQC"))
        oExecStmt:setString(nOrder++, xFilial("BQC"))
        oExecStmt:setString(nOrder++, &((cAlias)+"->"+ (cAlias + "_CODIGO")))
        oExecStmt:setString(nOrder++, " ")
    endif

    cTransactionCode := oExecStmt:execScalar("CODE")

    if empty(cTransactionCode)
        lNewCode := .T.
    else
        if subStr(cTransactionCode, 1, 6) >= cYear + cMonth
            cTransactionCode := soma1(cTransactionCode)
        else
            lNewCode := .T.
        endif
    endif

    if lNewCode
        if cAlias == "BA3"
            cTransactionCode :=  cYear + cMonth +  &(cAlias+"->("+cAlias+"_CODINT+" + cAlias+"_CODEMP)" ) + strZero(1, 6)
        else
            cTransactionCode :=  cYear + cMonth + &((cAlias)->((cAlias + "_CODIGO"))) + strZero(1, 6)
        endif
    endif

    oExecStmt:destroy()
    freeObj(oExecStmt)

    restArea(aArea)

return cTransactionCode

/*/{Protheus.doc} getContractData
Captura os daodos do contrato para envio
@type function
@version 12.1.2510
@author giovanna.charlo
@since 02/06/2025
@param cAlias, tabela posicionada
@param cKey, chave da tabela posicionada
@return json, dados do contrato
/*/
static function getContractData(cAlias as character, cKey as character)

    local jContractData := JsonObject():new() as json

    jContractData["sendContract"] := &((cAlias)+"->"+ (cAlias + "_ENVVC"))
    jContractData["sendingOperation"] := &((cAlias)+"->"+ (cAlias + "_OPEVC"))
    jContractData["beneficiaryQuantity"] := &((cAlias)+"->"+ (cAlias + "_QTBVC"))
    jContractData["agreementFile"] := &((cAlias)+"->"+ (cAlias + "_ACDVC"))
    jContractData["contractStatus"] := &((cAlias)+"->"+ (cAlias + "_STSVC"))
    jContractData["protocolNumber"] := &((cAlias)+"->"+ (cAlias + "_NPROVC"))
    jContractData["healthInsurerCode"] := &((cAlias)+"->"+ (cAlias + "_CODINT"))
    jContractData["companyCode"] := &((cAlias)+"->"+ (cAlias + "_CODEMP"))

    if cAlias == "BA3"
        jContractData["familyCode"] := &((cAlias)+"->"+ (cAlias + "_MATRIC"))
        jContractData["contractNumber"] := &((cAlias)+"->"+ (cAlias + "_CONEMP"))
    else    
        jContractData["contractNumber"] := &((cAlias)+"->"+ (cAlias + "_NUMCON"))
    endif

    jContractData["contractVersion"] := &((cAlias)+"->"+ (cAlias + "_VERCON"))
    jContractData["subcontractNumber"] := &((cAlias)+"->"+ (cAlias + "_SUBCON"))
    jContractData["subcontractVersion"] := &((cAlias)+"->"+ (cAlias + "_VERSUB"))
    jContractData["alias"] := cAlias
    jContractData["key"] := cKey

return jContractData

/*/{Protheus.doc} contractValidation
Chamada da base de conhecimento para abertura do anexo
@type function
@version 12.1.2510
@author giovanna.charlo
@since 02/05/2025
@param cAlias, tabela da rotina sendo utilizada
@param cSearchKey, chave de busca para gravação do arquivo
@return logical, situação do retorno
/*/
static function contractValidation(jContractData as json, jStatus as json, cOperation as character)

    if cOperation == RESEND_TYPE .and. empty(jContractData["protocolNumber"]) 
        jStatus["status"] := SEND_ERROR
        jStatus["showMessage"] := "Não é possível realizar o reenvio, pois o contrato não possui protocolo de envio."

    elseif jContractData["contractStatus"] == SEND_COMPLETED .and. !empty(jContractData["protocolNumber"])
        if cOperation <> RESEND_TYPE .and. jContractData["sendingOperation"] == INCLUSION_TYPE
            jStatus["status"] := SEND_ERROR
            jStatus["showMessage"] := STR0001 // "O contrato já enviado no VCOM."
        endif
    else
        if jContractData["sendContract"] == "1"
            do case
                case jContractData["sendingOperation"] == "1" .and. empty(jContractData["protocolNumber"])
                    jStatus["status"] := SEND_ERROR 
                    jStatus["showMessage"] := STR0003 //"Não é possível realizar o encerramento, pois esse contrato não foi cadastrado!"
            endcase
        elseIf Empty(jContractData["sendContract"]) .OR. jContractData["sendContract"] == "0" 
                jStatus["status"] := SEND_DISABLED 
                jStatus["showMessage"] := STR0009
        endif
    endif
    
return jStatus

/*/{Protheus.doc} generateProspectingFile
Gera o arquivo de prospecção do contrato
@type function
@version 12.1.2610
@author gabriel.lakatos
@since 07/01/2026
/*/
function generateProspectingFile(cOperation as character, cAlias as character, cKey as character)

    local cRet := "" as character
    local jStatus

    if fwAlertYesNo(STR0010, STR0011) // "Deseja gerar o arquivo de prospecção para este contrato?" // "Atenção"

        jStatus := cadBenefGenerateProspectingFile(cOperation, cAlias, cKey)
        
        if jStatus["status"] == SEND_COMPLETED
            cRet := jStatus["sendMessage"]
        elseif jStatus["status"] == SEND_ERROR
            cRet := jStatus["responseMessage"]
        endif
    endif
    
return cRet

/*/{Protheus.doc} cadBenefGenerateProspectingFile
Gera o arquivo de prospecção do contrato
@type function
@version 12.1.2610
@author gabriel.lakatos
@since 07/01/2026
/*/
function cadBenefGenerateProspectingFile(cOperation as character, cAlias as character, cKey as character) as json

    local oCadBenefProspect as object
    local jContractData as json
    local jStatus as json
    local aArea := getArea() as array
    
    jStatus := {"status": "",;
                "sendMessage": "",;
                "showMessage": "",;
                "responseMessage": "",;
                "transactionCode": "",;
                "sendDate": "",;
                "sendTime": "",;
                "protocolNumber": "",;
                "responseTime": "";
               }
 
    (cAlias)->(dbSetOrder(1))
    if !(cAlias)->(msSeek(xFilial(cAlias) + &(cAlias+"->(" + cKey + ")")))
        jStatus["status"] := SEND_ERROR
        jStatus["showMessage"] := STR0005 //"Não foi encontrado nenhum contrato com essa chave."
        return jStatus
    else
        if cAlias == "BA1"
            BA3->(dbSetOrder(1)) // BA3_FILIAL+BA3_CODINT+BA3_CODEMP+BA3_MATRIC+BA3_CONEMP+BA3_VERCON+BA3_SUBCON+BA3_VERSUB
            if BA3->(msSeek(xFilial("BA3") + BA1->(BA1_CODINT+BA1_CODEMP+BA1_MATRIC+BA1_CONEMP+BA1_VERCON+BA1_SUBCON+BA1_VERSUB)))
                cAlias := "BA3"
                cKey := BA3->(BA3_CODINT+BA3_CODEMP)                                                               
            endif
        endif
        jContractData := getContractData(cAlias, cKey)

        oCadBenefProspect := CadBenefApiProspecting():new(jContractData["healthInsurerCode"])
        jStatus["transactionCode"] := getNewTransactionCode(jContractData)

        jStatus["responseTime"] := time()

        if oCadBenefProspect:generateProspectingFile(cKey, cOperation, jStatus["transactionCode"], jContractData)                                                                            
            jStatus["status"] := SEND_COMPLETED
        else
            jStatus["status"] := SEND_ERROR 
        endif
        
        jStatus["responseTime"] := elapTime(jStatus["responseTime"], time())
        jStatus["showMessage"] := oCadBenefProspect:getMessage()
        jStatus["sendMessage"] := oCadBenefProspect:getRequest():toJson()
        jStatus["responseMessage"] := oCadBenefProspect:getResponse():toJson()
        jStatus["sendDate"] := dDataBase
        jStatus["sendTime"] := time()

        restArea(aArea)
        oCadBenefProspect:destroy()

        freeObj(jContractData)
        freeObj(oCadBenefProspect)
            
    endif

return jStatus

/*/{Protheus.doc} updateBeneficiaryVComProtocol
Atualiza o protocolo de envio dos beneficiários vinculados ao contrato no VCOM
@type function
@version 12.1.2510
@author danilo.melog
@since 07/08/2026
@param jContractData, json, dados do contrato utilizados para localizar os beneficiários e aplicar o novo protocolo
@return array, lista de beneficiários atualizados com os dados de identificação
/*/
static function updateBeneficiaryVComProtocol(jContractData as json)
    
    local cBranch := xFilial(jContractData['alias'])
    local nOrder := 1 as numeric
    local cQuery := '' as character
    local cAlias := ''as character
    local oExecStmt as object

    cQuery := " SELECT ? " 
    cQuery += " FROM ? BA3 " 
    cQuery += " INNER JOIN ? BA1 "
    cQuery += " ON BA3.BA3_FILIAL = BA1.BA1_FILIAL "
    cQuery += " AND BA3.BA3_CODINT = BA1.BA1_CODINT "
    cQuery += " AND BA3.BA3_CODEMP = BA1.BA1_CODEMP "
    
    if jContractData['alias'] == 'BA3'
        cQuery += " AND BA3.BA3_MATRIC = BA1.BA1_MATRIC "
    else
        cQuery += " AND BA3.BA3_CONEMP = BA1.BA1_CONEMP "
        cQuery += " AND BA3.BA3_VERCON = BA1.BA1_VERCON "
        cQuery += " AND BA3.BA3_SUBCON = BA1.BA1_SUBCON "
        cQuery += " AND BA3.BA3_VERSUB = BA1.BA1_VERSUB "
    endif
    
    cQuery += " WHERE BA3.BA3_FILIAL = ? " 
    cQuery += " AND BA3.BA3_CODINT = ? " 
    cQuery += " AND BA3.BA3_CODEMP = ? " 

    if jContractData['alias'] == 'BA3'
        cQuery += " AND BA3.BA3_MATRIC = ? " 
    else
        cQuery += " AND BA3.BA3_CONEMP = ? " 
        cQuery += " AND BA3.BA3_VERCON = ? " 
        cQuery += " AND BA3.BA3_SUBCON = ? " 
        cQuery += " AND BA3.BA3_VERSUB = ? " 
    endif

    cQuery += " AND BA1.BA1_CODUBR <> ? "
    cQuery += " AND BA1.BA1_NPRBVC = ? "
    cQuery += " AND BA1.D_E_L_E_T_ = ? "
    cQuery += " AND BA3.D_E_L_E_T_ = ? " 

    oExecStmt := FWExecStatement():New(cQuery)
    
    oExecStmt:setUnsafe(nOrder++, "BA1.R_E_C_N_O_ RECNO")
    oExecStmt:setUnsafe(nOrder++, retSqlName("BA3"))
    oExecStmt:setUnsafe(nOrder++, retSqlName("BA1"))
    oExecStmt:SetString(nOrder++, cBranch)
    oExecStmt:SetString(nOrder++, jContractData["healthInsurerCode"])
    oExecStmt:SetString(nOrder++, jContractData["companyCode"])

    if jContractData["alias"] == 'BA3'
        oExecStmt:SetString(nOrder++, jContractData["familyCode"])
    else
        oExecStmt:SetString(nOrder++, jContractData["contractNumber"])
        oExecStmt:SetString(nOrder++, jContractData["contractVersion"])
        oExecStmt:SetString(nOrder++, jContractData["subcontractNumber"])
        oExecStmt:SetString(nOrder++, jContractData["subcontractVersion"])
    endif

    oExecStmt:SetString(nOrder++, space(tamSX3('BA1_CODUBR')[1]))
    oExecStmt:SetString(nOrder++, space(tamSX3('BA1_NPRBVC')[1]))
    oExecStmt:SetString(nOrder++, space(1))
    oExecStmt:SetString(nOrder++, space(1))
    
    cAlias := oExecStmt:OpenAlias()

    While !(cAlias)->(Eof())
        BA1->(dbGoto((cAlias)->RECNO))

        BA1->(recLock("BA1", .F.))
        BA1->BA1_NPRBVC := jContractData["protocolNumber"]
        BA1->(msUnlock())

        (cAlias)->(DbSkip())
    EndDo

    (cAlias)->(DbCloseArea())

    oExecStmt:destroy()
    FreeObj(oExecStmt)

return
