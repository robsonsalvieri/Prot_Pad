#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "fwmvcdef.ch"
#include "health.plan.unimed.cadbenef.api.risksharing.service.ch"

#define REQUIRED .T.
#define OPTIONAL .F.

namespace totvs.protheus.health.plan.unimed

using namespace totvs.protheus.health.plan.api.util

class TransparenciaProtocoloService

	protected data jRequestBody as json
	protected data jResponseBody as json
	protected data nStatusCode as numeric
	protected data cHealthInsurerCode as character
	protected data lError as logical
	protected data cRequestBody as character

	public method new() constructor
	public method post() as logical
	public method setRequestBody(cRequestBody as character)
	public method getResponse() as character	

	protected method validRequestData(nOperation as numeric) as logical
	protected method validJsonData() as logical
	protected method checkFields(jData as json) as logical
	protected method setResponse(cStatus as character, cMessage as character, aProtocolos as array)
	protected method setStatusCode(nStatusCode as numeric)
	protected method getStatusCode() as numeric
	protected method saveReceivedMessage(cControle as character, cCnpjCpf as character, cPrestador as character, cCompetencia as character) as logical
	protected method UpdateBIWMessage(cControle as character) as logical
endclass

/*/{Protheus.doc} new
Método construtor da classe
@type method
@version 12.1.2510
@author zaar.goes
@since 28/07/2026
@return object, objeto da instância da classe
/*/
method new() class TransparenciaProtocoloService

	self:jRequestBody := JsonObject():new()
	self:jResponseBody := JsonObject():new()
	self:cHealthInsurerCode := plsIntPad()
	self:lError := .F.
	self:nStatusCode := 0

return self

/*/{Protheus.doc} post
Realiza o processamento da requisição de consulta de protocolos para a Transparência.
@type method
@version 12.1.2510  
@author zaar.goes
@since 28/07/2026
@return logical, se o processo de inclusão foi realizado com sucesso
/*/
method post() as logical class TransparenciaProtocoloService
	local lSuccess  := .F. as logical
	local cCodigoControleTransacao := ""
	local cDataGeracao := ""
	local cCodRDA := ""
	local cCpfCnpjPrestador := ""
	local cCompetencia := ""
	local cNomePrestador := "" as character
	local aProt := {}
	local aSeqBGQ := {}
	local adadDebCre := {}

	if self:validRequestData(MODEL_OPERATION_INSERT)		
		cCodigoControleTransacao := self:jRequestBody["cabecalho"]["codigoControleTransacao"]
		cDataGeracao := alltrim( cValToChar( self:jRequestBody["cabecalho"]["dataGeracao"] ) )
		cCpfCnpjPrestador := self:jRequestBody["prestadorExecutante"]["cpfCnpjPrestador"]
		cCompetencia := substr(self:jRequestBody["prestadorExecutante"]["competencia"], 3, 4) + substr(self:jRequestBody["prestadorExecutante"]["competencia"], 1, 2)

		BAU->(dbSetOrder(4))
		If BAU->(MsSeek(xfilial("BAU") + alltrim(cCpfCnpjPrestador)))
			cCodRDA := BAU->BAU_CODIGO
			cNomePrestador := alltrim(BAU->BAU_NOME)
		EndIf

		self:saveReceivedMessage(cCodigoControleTransacao, cDataGeracao, cCpfCnpjPrestador, cNomePrestador, cCompetencia)
		
		if !Empty(cCodRDA)					
			//Processa a consulta de protocolos do Demonstrativo de Pagamento
			aProt := QDemoPag(.F.,,cCompetencia,cCodRDA)
			adadDebCre := QDemoPagCD(.F.,,cCompetencia,cCodRDA,@aSeqBGQ)
			if Len(aSeqBGQ) > 0				
				QDemoNPag(.F.,,cCompetencia,cCodRDA,aSeqBGQ,adadDebCre,@aProt)
			endif

			if len(aProt) > 0
				lSuccess := .T.
				self:setResponse("S", "Processamento realizado com sucesso", aProt)
				self:setStatusCode(200)
			else
				self:setResponse("NA", "Não há protocolos para os parâmetros consultados")
				self:setStatusCode(422)
			endif
		else
			self:setResponse("E", "Prestador Executante não encontrado")
			self:setStatusCode(404)
		endif
		self:UpdateBIWMessage(cCodigoControleTransacao)
	endif
return lSuccess

/*/{Protheus.doc} setRequestBody
Defini o body recebido pela solicitação
@type method
@version 12.1.2510 
@author zaar.goes
@since 26/04/2025
@param cRequestBody, character, body da solicitação
/*/
method setRequestBody(cRequestBody as character) class TransparenciaProtocoloService	
	self:cRequestBody := cRequestBody

	self:jRequestBody:fromJson(cRequestBody)
return

/*/{Protheus.doc} validRequestData
Valida se os dados recebidos pela requisição estão validos para serem processados
@type method
@version 12.1.2510  
@author zaar.goes
@since 26/04/2025
@param nOperation, numeric, operação sendo realizada: Inclusão, atualização ou exclusão
@return logical, se os dados da solicitação estão válidos.
/*/
method validRequestData(nOperation as numeric) as logical class TransparenciaProtocoloService

	local lValid := .F. as logical

	if self:validJsonData()
		BA0->(dbSetOrder(1))
		If BA0->(msSeek(xFilial("BA0") + strZero(self:jRequestBody["cabecalho"]["codigoUnimedDestino"], 4)))			
			lValid:= .T.
		Else
		    
			self:setResponse("E", "Unimed não cadastrada") 
			self:setStatusCode(422)
		EndIf
	endif

return lValid

/*/{Protheus.doc} validJsonData
Valida se os dados do json (body) está preenchidos corretamente. (obrigatóriedade e tipo)
@type method
@version 12.1.2510 
@author zaar.goes
@since 26/04/2025
@return logical, se os dados do body estão validos.
/*/
method validJsonData() as logical class TransparenciaProtocoloService

	if self:checkFields({"body": self:jRequestBody, "attribute": "cabecalho", "type": "J", "required": REQUIRED})
		self:checkFields({"body": self:jRequestBody["cabecalho"], "attribute": "codigoControleTransacao", "type": "C", "required": REQUIRED})
		self:checkFields({"body": self:jRequestBody["cabecalho"], "attribute": "numeroVersaoPTU", "type": "C", "required": REQUIRED})
		self:checkFields({"body": self:jRequestBody["cabecalho"], "attribute": "dataGeracao", "type": "C", "required": REQUIRED})
	endif

	if self:checkFields({"body": self:jRequestBody, "attribute": "prestadorExecutante", "type": "J", "required": REQUIRED})
		self:checkFields({"body": self:jRequestBody["prestadorExecutante"], "attribute": "cpfCnpjPrestador", "type": "C", "required": REQUIRED})
		self:checkFields({"body": self:jRequestBody["prestadorExecutante"], "attribute": "competencia", "type": "N", "required": REQUIRED})
	endif
return !self:lError

/*/{Protheus.doc} checkFields
Verifica se o campo do objeto está de acordo com os parâmetros informados (tipo e obrigatoriedade)
@type method
@version 12.1.2510
@author zaar.goes
@since 26/04/2025
@param jData, json, dados do campo a ser verificado (body, attribute, type, required)
@return logical, se o campo está válido
/*/
method checkFields(jData as json) as logical class TransparenciaProtocoloService
	local lOk := .T. as logical

	if jData["required"] .and. !jData["body"]:hasProperty(jData["attribute"])
		lOk := .F.
		self:setResponse("E", STR0004 + jData["attribute"] + STR0005) // "O campo ";" é obrigatório."
		self:setStatusCode(400)	
	endif

return lOk

/*/{Protheus.doc} TransparenciaProtocoloService::setStatusCode
Defini o status code do processamento
@type method
@version 12.1.2510  
@author zaar.goes
@since 26/04/2025
@param nStatusCode, numeric, código do status code
/*/
method setStatusCode(nStatusCode as numeric) class TransparenciaProtocoloService

	self:nStatusCode := nStatusCode

return

/*/{Protheus.doc} TransparenciaProtocoloService::saveReceivedMessage
Salva recebimento da mensagem de pedido de protocolo
@type method
@version 12.1.2510
@author zaar.goes
@since 25/08/2026
@param cControle, character, Código de controle da transação
@param cDataGeracao, character, Data de Geração da transação
@param cCnpjCpf, character, CPF/CNPJ do prestador
@param cPrestador, character, Nome do prestador
@param cCompetencia, character, Competência solicitada
@return logical, retorno do método
/*/
method saveReceivedMessage(cControle as character, cDataGeracao as character, cCnpjCpf as character, cPrestador as character, cCompetencia as character) as logical class TransparenciaProtocoloService
	local dData := Date() as date
	local cHora := Time() as character
	local cFilBIW := xFilial("BIW") as character
	local lOk := .F. as logical
	local cPeriodo := alltrim(cValToChar(cCompetencia)) as character
	local cStatus := "R" as character
	local cDataTmp := "" as character
	local cHoraTmp := "" as character

	If !Empty(cControle)		
		If !Empty(cDataGeracao)
			cDataGeracao := StrTran(cDataGeracao, "T", " ")
			cDataGeracao := StrTran(cDataGeracao, "Z", "")
			cDataGeracao := AllTrim(cDataGeracao)

			If Len(cDataGeracao) >= 10
				cDataTmp := SubStr(cDataGeracao, 1, 10)				
				dData := CToD( SubStr(cDataTmp, 9, 2) + "/" + SubStr(cDataTmp, 6, 2) + "/" + SubStr(cDataTmp, 1, 4) )				
			EndIf

			If Len(cDataGeracao) >= 16
				cHoraTmp := SubStr(cDataGeracao, 12, 8)
				If !Empty(cHoraTmp)
					cHora := cHoraTmp
				EndIf
			EndIf
		EndIf

		DbSelectArea("BIW")
		DbSetOrder(1)
		If !BIW->(MsSeek(cFilBIW + cControle))
			RecLock("BIW", .T.)
				BIW->BIW_FILIAL := cFilBIW
				BIW->BIW_CTRL   := alltrim(cControle)
				BIW->BIW_TPTRA  := "1"
				BIW->BIW_DATA   := dData
				BIW->BIW_HORA   := cHora
				BIW->BIW_CNPJ   := alltrim(cCnpjCpf)
				BIW->BIW_PREST  := alltrim(cPrestador)
				BIW->BIW_COMPET  := cPeriodo
				BIW->BIW_STATUS := cStatus				
			MsUnlock()
			lOk := .T.
		EndIf
	EndIf

return lOk

/*/{Protheus.doc} UpdateBIWMessage
Updates the BIW control record with the complete JSON processing message.
@type function
@version 12.1.2510
@author zaar.goes
@since 25/08/2026
@param cControle, character, Transaction control code
@param cMensagem, character, Complete JSON processing message
@return logical, indicates whether the BIW record was updated
/*/
method UpdateBIWMessage(cControle as character) as logical class TransparenciaProtocoloService
	local aArea := GetArea() as array
	local cFilBIW := xFilial("BIW") as character
	local cStatus := "" as character
	local cErro := "" as character
	local cMensagem := self:jResponseBody:ToJson()
	local lOk := .F. as logical

	If !Empty(cControle) .And. !Empty(cMensagem)		
		If self:jResponseBody:HasProperty("status")
			If self:jResponseBody["status"]:HasProperty("statusProcessamento")
				cStatus := self:jResponseBody["status"]["statusProcessamento"]
			EndIf

			If self:jResponseBody["status"]:HasProperty("descricaoMensagem")
				cErro := self:jResponseBody["status"]["descricaoMensagem"]
			EndIf
		EndIf

		DbSelectArea("BIW")
		DbSetOrder(1)
		If BIW->(MsSeek(cFilBIW + cControle))
			RecLock("BIW", .F.)
				BIW->BIW_FILIAL := cFilBIW
				BIW->BIW_PROTO  := cMensagem
				BIW->BIW_STATUS := cStatus
				BIW->BIW_ERRO   := cErro
				BIW->BIW_DTFIM  := Date()
				BIW->BIW_HRFIM  := Time()
				BIW->BIW_ARQZIP := ""
			MsUnlock()
			lOk := .T.
		EndIf
	EndIf

	RestArea(aArea)
return lOk

method getResponse() as character class TransparenciaProtocoloService
return self:jResponseBody:toJson()

/*/{Protheus.doc} getStatusCode
Método responsavel por retornar o status code de retorno da API

@type method
@author zaar.goes
@since 29/04/25
@version Protheus 12
/*/
method getStatusCode() as numeric class TransparenciaProtocoloService
return self:nStatusCode

/*/{Protheus.doc} setResponse
Montagem da responsta da consulta de protocolos para a Transparência.
@type method
@version 12.1.2510  
@author zaar.goes
@since 26/04/2025
@param cStatus, character, status, sendo: E ou S
@param cMessage, character, mensagem do status
@param cSubscriberId, character, número de carteirinha do beneficiário
/*/
method setResponse(cStatus as character, cMessage as character, aProtocolos as array) class TransparenciaProtocoloService
    local aPedidosProtocolo := {}
	local jProtocolo as json
	local i as numeric
	local aProtocolo := {}
	default aProtocolos := {}

    self:jResponseBody["cabecalho"] := JsonObject():new()
    self:jResponseBody["cabecalho"]["codigoControleTransacao"] := self:jRequestBody["cabecalho"]["codigoControleTransacao"]    

    If cStatus != "S"
		self:jResponseBody["status"]  := JsonObject():new()
        self:jResponseBody["status"]["statusProcessamento"] := cStatus        
        self:jResponseBody["status"]["descricaoMensagem"] := cMessage        
        self:lError := .T.      
	Else 
		if Len(aProtocolos) > 0
			self:jResponseBody["protocolos"]  := JsonObject():new()
			for i := 1 to Len(aProtocolos)
				aProtocolo := aProtocolos[i]
				jProtocolo := JsonObject():new()
				jProtocolo["codigoProtocolo"] := aProtocolo[6]
				jProtocolo["numeroLote"] := alltrim(retNumLote(aProtocolo[6]))
				jProtocolo["dataProtocolo"] := substr(aProtocolo[5], 1, 4) + "-" + substr(aProtocolo[5], 5, 2) + "-" + substr(aProtocolo[5], 7, 2)
				jProtocolo["valorInformado"] := aProtocolo[1]
				jProtocolo["valorLiberado"] := aProtocolo[3]
				jProtocolo["valorGlosa"] := aProtocolo[4]
				jProtocolo["dataGeracao"] := jProtocolo["dataProtocolo"] + " 00:00:00"

				aAdd(aPedidosProtocolo, jProtocolo)
			next

			self:jResponseBody["protocolos"] := aPedidosProtocolo

			self:jResponseBody["status"]  := JsonObject():new()
			self:jResponseBody["status"]["statusProcessamento"] := cStatus
			self:lError := .F.        
		endif  
    endIf    
return
