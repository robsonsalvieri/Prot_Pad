#include "tlpp-core.th"
#include "tlpp-rest.th"

namespace totvs.protheus.health.plan.unimed

using namespace totvs.protheus.health.plan.api.util

/*/{Protheus.doc} TransparenciaProtocoloController
API que possibilita que seja enviado a movimentação de transparencia
para a Unimed do Brasil.
@type class
@version 12.1.2410 
@author zaar.goes
@since 28/07/2026
/*/
class TransparenciaProtocoloController

    public method new() constructor

    @POST("/totvsHealthPlans/unimed/transparencia/v1/pedido-protocolo")
    public method apiTranspareciaProtocolo()

    @POST("/totvsHealthPlans/unimed/transparencia/v1/pedido-detalhe-protocolo")
    public method apiTranspareciaDetalheProtocolo()

endclass

/*/{Protheus.doc} new
Método construtor da classe
@type method
@version 12.1.2410
@author zaar.goes
@since 28/07/2026
@return object, objeto da instância da classe
/*/
method new() class TransparenciaProtocoloController
return self

/*/{Protheus.doc} apiTranspareciaProtocolo
Recurso responsável pelo processamento do pedido de protocolo de transparencia da Unimed do Brasil
@type method
@version 12.1.2410  
@author zaar.goes
@since 28/07/2026
/*/
method apiTranspareciaProtocolo() class TransparenciaProtocoloController

    local cRequestBody := oRest:getBodyRequest() as character
    local oService      as object
    local oAuthToken    := ReverseTokenAuth():new()

    oService := TransparenciaProtocoloService():new()
    
    oService:setRequestBody(cRequestBody)

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    if oService:post()
        oRest:setResponse(oService:getResponse())
        oRest:setStatusCode(oService:getStatusCode())
    else
        oRest:setFault(oService:getResponse())
        oRest:setStatusCode(400)
    endif 
    
    PLSLOGFIL("Data: "+dtoc(date())+ " - Hora: "+time()+ " - Json: "+oRest:getBodyRequest(),'TranspararenciaProtocolo_LOG')   
    PLSLOGFIL("Data: "+dtoc(date())+ " - Hora: "+time()+ " - Json: "+oService:getResponse(),'TranspararenciaProtocolo_LOG')   

    oAuthToken:destroy()
    freeObj(oAuthToken)  
return

method apiTranspareciaDetalheProtocolo() class TransparenciaProtocoloController
    local lSucess := .T.
    local cRequestBody := oRest:getBodyRequest() as character
    local oService     as object
    local oAuthToken   := ReverseTokenAuth():new()

    oService := TransparenciaProtDetalheService():new()

    oService:setRequestBody(cRequestBody)

    lSucess := oService:post()
    
    if lSucess
        // ------------------------------------------------------------
        // Se o serviço gerou um ZIP, retorna o arquivo
        // ------------------------------------------------------------
        lSucess := !Empty(oService:getCaminhoZipGerado())
        
        if lSucess
            lSucess := oService:anexarZipResposta()            
        endif
            
        // --------------------------------------------------------
        // Resposta de zip não gerado
        // --------------------------------------------------------
        iif(!lSucess, oRest:setKeyHeaderResponse(;
            "Content-Type",;
            "application/json";
            ),)
        iif(!lSucess, oService:setResponseNoZip(),)
        iif(!lSucess, oRest:setResponse(oService:getResponse()),)

        oRest:setStatusCode(oService:getStatusCode())
        lSucess := .T. //Volta a true para caso para não passar nas linhas de erro da api
    endif

    // ------------------------------------------------------------
    // Erro da API
    // ------------------------------------------------------------
    iif(!lSucess, oRest:setKeyHeaderResponse(;
        "Content-Type",;
        "application/json";
        ),)

    iif(!lSucess, oRest:setFault(oService:getResponse()),)
    iif(!lSucess, oRest:setStatusCode(400),)

    PLSLOGFIL(;
        "Data: " + DToC(Date()) + ;
        " - Hora: " + Time() + ;
        " - Json: " + oRest:getBodyRequest(),;
        "TranspararenciaDetalheProtocolo_LOG";
    )

    PLSLOGFIL(;
        "Data: " + DToC(Date()) + ;
        " - Hora: " + Time() + ;
        " - Json: " + oService:getResponse(),;
        "TranspararenciaDetalheProtocolo_LOG";
    )

    oAuthToken:destroy()
    FreeObj(oAuthToken)
return

