	protected method getCaminhoZipGerado() as character
	protected method anexarZipResposta() as logical
	protected method saveReceivedMessage(cControle as character, cDataGeracao as character, cCnpjCpf as character, cPrestador as character, cProtocolo as character) as logical
	protected method UpdateBIWMessage(lSuccess as logical) as logical
	protected method plsMensagem(cId, cMensagem) as character
endclass

/*/{Protheus.doc} new
Método construtor da classe
@type method
@version 12.1.2510
@author zaar.goes
@since 28/07/2026
@return object, objeto da instância da classe
/*/
method new() class TransparenciaProtDetalheService

	self:jRequestBody := JsonObject():new()
	self:jResponseBody := JsonObject():new()
	self:cHealthInsurerCode := plsIntPad()
	self:lError := .F.
	self:nStatusCode := 0
	self:aArquivosSalvos := {}
	self:cCodigoControleTransacao := ""
	self:cDataGeracao := ""
	self:cCaminhoZipGerado := ""

return self

/*/{Protheus.doc} post
Realiza o processamento da solicitação de detalhes dos protocolos para a transparência da Unimed do Brasil.
@type method
@version 12.1.2510  
@author zaar.goes
@since 28/07/2026
@return logical, se o processo de inclusão foi realizado com sucesso
/*/
method post() as logical class TransparenciaProtDetalheService
	local lSuccess  := .F. as logical
	local cControle := ""
	local cDataGeracao := ""
	local cMsg := ""
	local cCodRDA := ""
	local cCpfCnpjPrestador := ""
	local cPrestador := ""
	local cProtocolo := ""
	self:aMensagens := {}

	if self:validRequestData(MODEL_OPERATION_INSERT)
		cProtocolo := self:jRequestBody:toJson()
		cControle := self:jRequestBody["cabecalho"]["codigoControleTransacao"]
		cDataGeracao := self:jRequestBody["cabecalho"]["dataGeracao"]
		cCpfCnpjPrestador := self:jRequestBody["prestadorExecutante"]["cpfCnpjPrestador"]

		BAU->(dbSetOrder(4))
		If BAU->(MsSeek(xfilial("BAU") + alltrim(cCpfCnpjPrestador)))
			cCodRDA := BAU->BAU_CODIGO
			cPrestador := BAU->BAU_NOME
		EndIf

		self:saveReceivedMessage(cControle, cDataGeracao, cCpfCnpjPrestador, cPrestador, cProtocolo)
	
		if !Empty(cCodRDA)
			//Processa os protocolos								
			lSuccess := self:setResponse("S", "Processamento realizado com sucesso", cCodRDA)
		else
			lSuccess := self:setResponse("E", "Prestador Executante não encontrado")
			self:setStatusCode(404)
		endif	
	endif
	
	// Compactar arquivos após terminar de processar todos os protocolos
	if lSuccess .and. len(self:aArquivosSalvos) > 0
		cMsg := self:compactarArquivos(self:cCodigoControleTransacao, self:cDataGeracao)
		lSuccess := empty(cMsg)
		if !lSuccess
			self:cCaminhoZipGerado := ""
			::plsMensagem(self:cCodigoControleTransacao, cMsg)			
			self:setResponseNoZip()
		endif
	else
		self:setResponseNoZip()
		self:setStatusCode(422)									
	endif

	if lSuccess	
		self:UpdateBIWMessage(lSuccess)
	endif
return lSuccess

/*/{Protheus.doc} setRequestBody
Defini o body recebido pela solicitação
@type method
@version 12.1.2510 
@author zaar.goes
@since 31/07/2026
@param cRequestBody, character, body da solicitação
/*/
method setRequestBody(cRequestBody as character) class TransparenciaProtDetalheService
	self:cRequestBody := cRequestBody

	self:jRequestBody:fromJson(cRequestBody)
return

/*/{Protheus.doc} validRequestData
Valida se os dados recebidos pela requisição estão validos para serem processados
@type method
@version 12.1.2510  
@author zaar.goes
@since 31/07/2026
@param nOperation, numeric, operação sendo realizada: Inclusão, atualização ou exclusão
@return logical, se os dados da solicitação estão válidos.
/*/
method validRequestData(nOperation as numeric) as logical class TransparenciaProtDetalheService	
	local lValid := .F. as logical

	if self:validJsonData()
		BA0->(dbSetOrder(1))
		If BA0->(msSeek(xFilial("BA0") + strZero(self:jRequestBody["cabecalho"]["codigoUnimedDestino"], 4)))			
			lValid:= .T.
		Else
			self:setResponse("E", "Unimed não cadastrada") 
			self:setStatusCode(422)
		EndIf
	endif

return lValid

/*/{Protheus.doc} validJsonData
Valida se os dados do json (body) está preenchidos corretamente. (obrigatóriedade e tipo)
@type method
@version 12.1.2510 
@author zaar.goes
@since 31/07/2026
@return logical, se os dados do body estão validos.
/*/
method validJsonData() as logical class TransparenciaProtDetalheService

	if self:checkFields({"body": self:jRequestBody, "attribute": "cabecalho", "type": "J", "required": REQUIRED})
		self:checkFields({"body": self:jRequestBody["cabecalho"], "attribute": "codigoControleTransacao", "type": "C", "required": REQUIRED})
		self:checkFields({"body": self:jRequestBody["cabecalho"], "attribute": "numeroVersaoPTU", "type": "C", "required": REQUIRED})
		self:checkFields({"body": self:jRequestBody["cabecalho"], "attribute": "dataGeracao", "type": "C", "required": REQUIRED})
	endif

	if self:checkFields({"body": self:jRequestBody, "attribute": "prestadorExecutante", "type": "J", "required": REQUIRED})
		self:checkFields({"body": self:jRequestBody["prestadorExecutante"], "attribute": "cpfCnpjPrestador", "type": "C", "required": REQUIRED})		
	endif
return !self:lError

/*/{Protheus.doc} checkFields
Verifica se o campo do objeto está de acordo com os parâmetros informados (tipo e obrigatóriedade)
@type method
@version 12.1.2510
@author zaar.goes
@since 31/07/2026
@param jData, json, dados do campo a ser verificado (body, attribute, type, required)
@return logical, se o campo está válido
/*/
method checkFields(jData as json) as logical class TransparenciaProtDetalheService
	local lOk := .T. as logical

	if jData["required"] .and. !jData["body"]:hasProperty(jData["attribute"])
		lOk := .F.
		self:setResponseNoZip(STR0004 + jData["attribute"] + STR0005) // "O campo ";" é obrigatório."
		self:setStatusCode(400)	
	endif
	iif(!self:lError, self:lError := !lOk, )
return lOk

/*/{Protheus.doc} TransparenciaProtDetalheService::setStatusCode
Defini o status code do processamento
@type method
@version 12.1.2510  
@author zaar.goes
@since 31/07/2026
@param nStatusCode, numeric, código do status code
/*/
method setStatusCode(nStatusCode as numeric) class TransparenciaProtDetalheService

	self:nStatusCode := nStatusCode

return

method getResponse() as character class TransparenciaProtDetalheService
return self:jResponseBody:toJson()

method setResponseNoZip(cComplemento as character) class TransparenciaProtDetalheService
	default cComplemento := ""
	self:jResponseBody := JsonObject():new()
	self:jResponseBody["cabecalho"] := JsonObject():new()
	self:jResponseBody["cabecalho"]["codigoControleTransacao"] := self:jRequestBody["cabecalho"]["codigoControleTransacao"]
	self:jResponseBody["status"]  := JsonObject():new()
	self:jResponseBody["status"]["statusProcessamento"] := "E"
	self:jResponseBody["status"]["descricaoMensagem"] := ::plsMensagem(self:cCodigoControleTransacao, "Não foi possível gerar o arquivo Zip. " + cComplemento)	
	self:UpdateBIWMessage(.F.)
return

/*/{Protheus.doc} getStatusCode
Método responsavel por retornar o status code de retorno da API

@type method
@author zaar.goes
@since 29/04/25
@version Protheus 12
/*/
method getStatusCode() as numeric class TransparenciaProtDetalheService
return self:nStatusCode

/*/{Protheus.doc} setResponse
Defini o status da resposta da api
@type method
@version 12.1.2510  
@author zaar.goes
@since 31/07/2026
@param cStatus, character, status, sendo: E ou S
@param cMessage, character, mensagem do status
@param cCodRDA, character, código RDA
/*/
method setResponse(cStatus as character, cMessage as character, cCodRDA as character) class TransparenciaProtDetalheService    
	local lSuccess := .T. as logical
	local i as numeric
	local jArqProtocolo as json

	// Armazenar código de controle da transação
	self:cCodigoControleTransacao := self:jRequestBody["cabecalho"]["codigoControleTransacao"]
	self:cDataGeracao := self:jRequestBody["cabecalho"]["dataGeracao"]

	if Len(self:jRequestBody["protocolos"]) > 0		
		for i := 1 to Len(self:jRequestBody["protocolos"])
			jArqProtocolo := JsonObject():new()
			jArqProtocolo["cabecalho"] := JsonObject():new()
			jArqProtocolo["cabecalho"]["codigoControleTransacao"] := self:jRequestBody["cabecalho"]["codigoControleTransacao"]
			jArqProtocolo["cabecalho"]["codigoProtocolo"] := self:jRequestBody["protocolos"][i]

			if cStatus == "S"								
				try
					jGuias := self:getProtocolo(self:jRequestBody["protocolos"][i], cCodRDA)

					if len(jGuias) > 0					
						jArqProtocolo["guias"] := jGuias
						jArqProtocolo["status"]  := JsonObject():new()
						jArqProtocolo["status"]["statusProcessamento"] := cStatus
					else
						jArqProtocolo["status"]  := JsonObject():new()
						jArqProtocolo["status"]["statusProcessamento"] := "NA"
						jArqProtocolo["status"]["descricaoMensagem"] := ::plsMensagem(self:jRequestBody["protocolos"][i], "Não há protocolos para os parâmetros consultados")						
						self:lError := .T.
					endif			
					
					if !::lError
						self:lError := .F.        
					endif
				catch oExc
					lSuccess := .F.					
					jArqProtocolo["status"]  := JsonObject():new()
					jArqProtocolo["status"]["statusProcessamento"] := "E"
					jArqProtocolo["status"]["descricaoMensagem"] := ::plsMensagem(self:jRequestBody["protocolos"][i] + "|" + ::cGuiaprocessada, "Erro ao processar arquivo JSON: " + oExc:description)
				endtry
			else
				jArqProtocolo["status"]  := JsonObject():new()
				jArqProtocolo["status"]["statusProcessamento"] := cStatus
				jArqProtocolo["status"]["descricaoMensagem"] := ::plsMensagem(self:jRequestBody["protocolos"][i], cMessage)				
				self:lError := .T.
			endif

			// Salvar JSON em arquivo			
			lSuccess := self:salvarJsonEmArquivo(jArqProtocolo, cCodRDA, self:jRequestBody["protocolos"][i])
		next		
	endIf
return lSuccess

/*/{Protheus.doc} getProtocolo
Montagem do objeto guia do protocolo para a Transparência.
@type method
@version 12.1.2510  
@author zaar.goes
@since 31/07/2026
@param cProtocolo, character, número do protocolo
@param cCodRDA, character, código do RDA
@return json, objeto json com os dados da guia
/*/
method getProtocolo(cProtocolo, cCodRDA) as json class TransparenciaProtDetalheService
    local jGuias        as json
    local jGuiaItem     as json
	local aGuias := {}
	local jidentificacaoGuia as json
	local aSolicitante as array
	local jCExecutante as json	
	local cTipPre as character
	local cGuiaOpe := ""
	local cGuiPri := ""
	local cTpFat := ""
	local cMatric := ""
	local cCodUBR := ""
	local cChvProduto := ""
	local cTipoContratacao := ""
	
	::cGuiaProcessada := ""
	::getGuiasProtocolo(cProtocolo, cCodRDA)

    jGuias := JsonObject():New()

    // Percorre cada elemento do array de entrada (cada guia)
    while !(GuiasData)->(eof())
        jGuiaItem := JsonObject():New()

        // 1. identificacaoGuia
		cGuiaOpe := (GuiasData)->(CODLDP+CODPEG+NUMERO)
		::cGuiaProcessada := cGuiaOpe
		if (GuiasData)->TIPGUI == "05"
			cGuiPri := ::BuscaNrGuiPri((GuiasData)->GUIINT) // Operadora + Ano + Mês + Numero
			if empty((GuiasData)->BE4_TIPFAT) .or.  (GuiasData)->BE4_TIPFAT $ 'TP'
				cTpFat := iif((GuiasData)->BE4_TIPFAT=="P","1","2" )
			else
				cTpFat := (GuiasData)->BE4_TIPFAT
			endif
		else
			cGuiPri := iif(len((GuiasData)->GUIPRI)>20,substr((GuiasData)->GUIPRI,5,20),(GuiasData)->GUIPRI) //Código LDP + Peg + Numero
		endif		

		//Feito antes para pegar o tipo de prestador 
		jCExecutante := ::getContratadoExecutante((GuiasData))
		cTipPre := jCExecutante["tipoPrestador"]

		jidentificacaoGuia := JsonObject():New()

		SetJsonValue(@jidentificacaoGuia, "tipoGuia", ::getTipoGuia((GuiasData)->TIPGUI))
		SetJsonChar(@jidentificacaoGuia, "numeroLotePrestador", retNumLote(cProtocolo))
		SetJsonChar(@jidentificacaoGuia, "numeroGuiaTissPrestador", ifPls((GuiasData)->NUMIMP,cGuiaOpe))			
		SetJsonChar(@jidentificacaoGuia, "numeroGuiaTissPrincipal", cGuiPri)
		SetJsonChar(@jidentificacaoGuia, "numeroGuiaTissOperadora", cGuiaOpe)
		SetJsonChar(@jidentificacaoGuia, "dataProtocolo", getData((GuiasData)->BD6_DTDIGI))        
		SetJsonChar(@jidentificacaoGuia, "versaoTiss", ifPls((GuiasData)->TISVER, posicione("BAU",1,xfilial("BAU")+(GuiasData)->CODRDA,"BAU_TISVER")))
		SetJsonValue(@jidentificacaoGuia, "indicadorLiminar", ifPls((GuiasData)->GUIJUR, 0))
		SetJsonChar(@jidentificacaoGuia, "tipoAtendimento", ifPls((GuiasData)->TIPATE,'23'))
        SetJsonValue(@jidentificacaoGuia, "tipoConsulta", iif((GuiasData)->TIPCON == '5','2',(GuiasData)->TIPCON))
        SetJsonValue(@jidentificacaoGuia, "caraterAtendimento", iif((GuiasData)->TIPGUI $ "02,05", PLSGETVINC("BTU_CDTERM", "BDR", .F., "23", (GuiasData)->TIPADM, .F.), ""))
        SetJsonValue(@jidentificacaoGuia, "motivoEncerramento", iif((GuiasData)->TIPGUI == "05", PLSGETVINC("BTU_CDTERM", "BIY", .F., "39", (GuiasData)->BE4_TIPALT), ""))
        SetJsonChar(@jidentificacaoGuia, "regimeAtendimento", iif(alltrim(cTipPre) == "08", "02", ifPls((GuiasData)->TMREGA,"")))
        SetJsonChar(@jidentificacaoGuia, "tipoSaudeOcupacional", ifPls((GuiasData)->SAUOCU,""))
        SetJsonChar(@jidentificacaoGuia, "tipoAcomodacao", iif((GuiasData)->TIPGUI == "05", PLSGETVINC('BTU_CDTERM',"BI4", .F., "49", (GuiasData)->BE4_PADINT), ""))
        SetJsonValue(@jidentificacaoGuia, "tipoInternacao", iif((GuiasData)->TIPGUI == "05", (GuiasData)->(BE4_GRPINT), ""))
        SetJsonValue(@jidentificacaoGuia, "regimeInternacao", iif((GuiasData)->TIPGUI == "05", (GuiasData)->(BE4_REGINT), ""))
        SetJsonValue(@jidentificacaoGuia, "tipoFaturamento", cTpFat)
        SetJsonChar(@jidentificacaoGuia, "dataInicioFaturamento", getData((GuiasData)->DTINIF))
        SetJsonChar(@jidentificacaoGuia, "dataFimFaturamento", getData((GuiasData)->DTFIMF))
        SetJsonChar(@jidentificacaoGuia, "numeroAutorizacao", substr(ifPls((GuiasData)->NRAOPE,(GuiasData)->NRAEMP),1,10))
		
		jGuiaItem["identificacaoGuia"] := jidentificacaoGuia

        // 2. dadosBeneficiario
		BA1->(dbSetOrder(2))
		if BA1->(MsSeek(xFilial("BA1")+(GuiasData)->(BD6_OPEUSR+BD6_CODEMP+BD6_MATRIC+BD6_TIPREG+BD6_DIGITO)))
			cMatric	:= ifPls(BA1->BA1_MATEDI, (GuiasData)->(BD6_OPEUSR+BD6_CODEMP+BD6_MATRIC+BD6_TIPREG+BD6_DIGITO))
			cCodUBR := BA1->BA1_CODUBR

			If Empty(AllTrim(BA1->BA1_CODPLA))
				If BA3->(MsSeek(xFilial("BA3")+BA1->(BA1_CODINT+BA1_CODEMP+BA1_MATRIC+BA1_CONEMP+BA1_VERCON+BA1_SUBCON+BA1_VERSUB)))
					cChvProduto := Alltrim(BA3->(BA3_CODINT+BA3_CODPLA+BA3_VERSAO))
				EndIf
			Else
				cChvProduto := Alltrim(BA1->(BA1_CODINT+BA1_CODPLA+BA1_VERSAO))
			EndIf
			
			BI3->(dbSetOrder(1)) // BI3_FILIAL+BI3_CODINT+BI3_CODIGO+BI3_VERSAO
			if BI3->(MsSeek(xFilial("BI3") + cChvProduto))
				cTipoContratacao := ifPls(BI3->BI3_CLAPLS, "1")
			endif
		else
			cMatric	:= alltrim((GuiasData)->BD6_MATANT)
			cCodUBR := ""
			cTipoContratacao := ""
		endif

        jdadosBeneficiario := JsonObject():New()
        SetJsonChar(@jdadosBeneficiario, "carteirinhaBeneficiario", PadL(cMatric, 17, "0"))
        SetJsonChar(@jdadosBeneficiario, "codigoControleUnimedBrasil", cCodUBR)
        SetJsonValue(@jdadosBeneficiario, "tipoContratacao", cTipoContratacao)
        SetJsonValue(@jdadosBeneficiario, "indicadorNato", (GuiasData)->IDRN)
        SetJsonChar(@jdadosBeneficiario, "nomeBeneficiario", substr((GuiasData)->NOMUSR,1,25))
        SetJsonValue(@jdadosBeneficiario, "indicadorPacienteAssistencial", (GuiasData)->TIPPAC)

		jGuiaItem["dadosBeneficiario"] := jdadosBeneficiario
        		
		// 3. dadosContratadoSolicitante
		if (GuiasData)->TIPGUI $ "02,05"
			aSolicitante := ::getSolicitante((GuiasData))	
        	iif(len(aSolicitante) > 0, jGuiaItem["dadosContratadoSolicitante"] := aSolicitante[1], )
			iif(len(aSolicitante) > 1, jGuiaItem["dadosProfissionalSolicitante"] := aSolicitante[2], )				
		endif

        // 5. dadosContratadoExecutante
        jGuiaItem["dadosContratadoExecutante"] := jCExecutante

        // 6. dadosHospital
		if (GuiasData)->TIPGUI $ "05,06"
        	jGuiaItem["dadosHospital"] := ::getHospital((GuiasData))
		endif

        // 7. procedimentos (Array)
        jGuiaItem["procedimentos"] := ::getProcedimentos(cCodRDA)      

        // Adiciona a guia pronta ao array principal de guias
        aAdd(aGuias, jGuiaItem)
    enddo
	(GuiasData)->(dbclosearea())
	jGuias := aGuias
return jGuias

static function SetJsonChar(jObj as json, cKey as character, cValue)
	if !empty(alltrim(cValue))
		jObj[cKey] := AllTrim(cValue)
	//else
	//	jObj[cKey] := nil
	endif
return 

static function SetJsonValue(jObj as json, cKey as character, cValue)
	if valtype(cValue) == "C"
		if !empty(alltrim(cValue))		
			jObj[cKey] := Val(cValue)
		//else
		//	jObj[cKey] := nil
		endif
	else
		if cValue != nil
			jObj[cKey] := cValue		
		//else
		//	jObj[cKey] := nil
		endif
	endif
return

/*/{Protheus.doc} getGuiasProtocolo
Retorna os dados das guias do protocolo consultado
@type method
@version 12.1.2510
@author zaar.goes
@since 31/07/2026
@param cProtocolo, character, número do protocolo
@param cCodRDA, character, código do RDA
@return json, objeto json com os dados das guias do protocolo
/*/
method getGuiasProtocolo(cProtocolo, cCodRDA) class TransparenciaProtDetalheService
	local cTPGui := ""
	local cAliCab := ""
	local cSql as character
	
	//Posiciono na BCI
	BCI->(DbSetOrder(14))	//BCI_FILIAL+BCI_CODPEG
	cTPGui := Iif(BCI->(MsSeek(xFilial("BCI")+ cProtocolo)),BCI->BCI_TIPGUI,"")	

	if cTPGui != "05"
		cSql := " SELECT BD5_CODOPE CODOPE, BD5_CODLDP CODLDP, BD5_CODPEG CODPEG, BD5_NUMERO NUMERO, BD5_TIPGUI TIPGUI, BD5_CODRDA CODRDA, BD5_NUMIMP NUMIMP, "
		cSql += " BD5_DATPRO DATPRO, BD5_HORPRO HORPRO, BD5_GUIJUR GUIJUR, BD5_INDCLI INDCLI, BD5_INDCL2 INDCL2, BD5_ANOAUT ANOAUT, BD5_MESAUT MESAUT, "
		cSql += " BD5_GUIINT GUIINT, BD5_TISVER TISVER, BD5_ATERNA IDRN, BD5_TIPPAC TIPPAC, BD5_INDACI INDACI, BD5_NRAOPE NRAOPE, BD5_NOMRDA NOMRDA, "
		cSql += " BD5_CODLOC CODLOC, BD5_REGEXE REGEXE, BD5_CDPFRE CDPFRE, BD5_CODESP CODESP, BD5_TIPCON TIPCON, BD5_DATSOL DATSOL, BD5_SENHA SENHA, BD5_TIPATE TIPATE,  "
		cSql += " BD5_NUMAUT NUMAUT, BD5_TIPADM TIPADM, BD5_GUIPRI GUIPRI, BD5_REGSOL REGSOL, BD5_TPGRV TPGRV, ' ' DTINIF, ' ' HRINIF, ' ' DTFIMF, "
		cSql += " ' ' HRFIMF, ' ' DTALTA, ' ' HRALTA, BD5_CID CID,  BD5_NRAEMP NRAEMP, BD5_NOMUSR NOMUSR, BD5_CDPFSO CDPFSO, BD5_NOMSOL NOMSOL, "
		cSql += " BD5_SIGLA SIGLA, BD5_ESTSOL ESTSOL, BD5_CNESED CNESED,BD5_MUNEDI MUNEDI, "
		cSql += " BD5_TMREGA TMREGA, BD5_SAUOCU SAUOCU, BD5_COBESP COBESP, "		
		cAliCab := 'BD5'
	else
		cSql := " SELECT BE4_CODOPE CODOPE, BE4_CODLDP CODLDP, BE4_CODPEG CODPEG, BE4_NUMERO NUMERO, BE4_TIPGUI TIPGUI, BE4_CODRDA CODRDA, BE4_SENHA SENHA, "
		cSql += " BE4_NUMIMP NUMIMP, BE4_DATPRO DATPRO, BE4_HORPRO HORPRO, BE4_GUIJUR GUIJUR, BE4_INDCLI INDCLI, BE4_INDCL2 INDCL2, BE4_ANOINT ANOINT, "
		cSql += " BE4_MESINT MESINT, BE4_NUMINT NUMINT, BE4_GUIINT GUIINT, BE4_TISVER TISVER, BE4_ATERNA IDRN, '1' TIPPAC, BE4_DATPRO DATSOL, '' TIPATE, "
		cSql += " BE4_NOMRDA NOMRDA, BE4_CODLOC CODLOC, BE4_REGEXE REGEXE, BE4_CODESP CODESP, BE4_TIPCON TIPCON, BE4_INDACI INDACI, BE4_NRAOPE NRAOPE, "
		cSql += " BE4_TIPADM TIPADM, BE4_GUIINT GUIPRI, BE4_REGSOL REGSOL, BE4_TPGRV TPGRV, BE4_DTINIF DTINIF, BE4_HRINIF HRINIF, BE4_DTFIMF DTFIMF,
		cSql += " BE4_HRFIMF HRFIMF, BE4_DTALTA DTALTA, BE4_HRALTA HRALTA, BE4_PADINT, BE4_REGINT, BE4_GRPINT, BE4_TIPALT, BE4_CIDOBT, BE4_NRDCOB, "
		cSql += " BE4_TIPFAT, BE4_NRDCNV, BE4_CID CID, BE4_NMAUDI, BE4_RMAUDI, BE4_NEAUDI, BE4_REAUDI, BE4_NRAEMP NRAEMP, BE4_NOMUSR NOMUSR, BE4_CDPFSO CDPFSO, "
		cSql += " BE4_SIGLA SIGLA, BE4_ESTSOL ESTSOL, BE4_NOMSOL NOMSOL,BE4_CNESED CNESED,BE4_MUNEDI MUNEDI, "
		cSql += " '03' TMREGA, '' SAUOCU, '' COBESP, "
		cSql += iif(BE4->(fieldpos("BE4_UMAUDI")) > 0, "BE4_UMAUDI ", "' ' ")	+ " UMAUDI, "
		cSql += iif(BE4->(fieldpos("BE4_UEAUDI")) > 0, "BE4_UEAUDI ", "' ' ")	+ " UEAUDI, "
		cAliCab := 'BE4'
	endif
	cSql += " BX6_NOMFOR, BX6_CNPJFO, BX6_NNFFOR, BX6_DREANV, BX6_REGANV, BX6.R_E_C_N_O_ RecnoBx6, BX6_IDUNIC, BX6_SEQPTU," + iif(lIdUnico2,"BX6_IDUNI2,","")
	cSql += " BD6_CODPAD, BD6_CODPRO, BD6_VLRPF, BD6_QTDPRO, BD6_DESPRO, BD6_MATANT, BD6_PACOTE,BD6_CD_PAC, BD6_CPFRDA, BD6_DTDIGI, BD6_CODEMP, BD6_PERTAD, "
	cSql += " BD6_MATRIC, BD6_TIPREG, BD6_DIGITO, BD6_ORIMOV, BD6_SEQUEN, BD6_HORFIM, BD6_HORPRO, BD6_VIA, BD6_PERHES, BX6_CODUNM, BD6_CODTAB, BD6_DATPRO, "
	cSql += " BD6_CDTBRC, BD6_PERC1, "
	cSql += " BD6_REFFED, BD6_NFE, BD6_PROCCI, BD6_VLRTAD, BD6_TECUTI, BD6_ESPSOL, BD6_ESPEXE, BD6_OPEUSR,BD6_CODRDA,BD6_CONEMP,BD6_VERCON,BD6_SUBCON,BD6_VERSUB,BD6_RDAEDI RDAEDI ,BD6_NOMEDI NOMEDI,BD6_CNPJED CNPJED ,BD6_TRDAED TRDAED,BD6_RPEDI RPEDI "
	cSql += " FROM " + cBD6Name + " BD6 "	
	cSql += " INNER JOIN "+ retSqlName(cAliCab) + " " + cAliCab
	cSql += " ON  "+cAliCab+"_FILIAL = BD6_FILIAL "
	cSql += " AND "+cAliCab+"_CODOPE = BD6_CODOPE "
	cSql += " AND "+cAliCab+"_CODLDP = BD6_CODLDP "
	cSql += " AND "+cAliCab+"_CODPEG = BD6_CODPEG "
	cSql += " AND "+cAliCab+"_NUMERO = BD6_NUMERO "
	cSql += " AND "+cAliCab+".D_E_L_E_T_ = ' ' "
	cSql += " LEFT JOIN " + cBX6Name + " BX6 "
	cSql += " ON  BX6_FILIAL = '" + xfilial("BX6") + "' "
	cSql += " AND BX6_CODOPE = BD6.BD6_CODOPE "
	cSql += " AND BX6_CODLDP = BD6.BD6_CODLDP "
	cSql += " AND BX6_CODPEG = BD6.BD6_CODPEG "
	cSql += " AND BX6_NUMERO = BD6.BD6_NUMERO "
	cSql += " AND BX6_ORIMOV = BD6.BD6_ORIMOV "
	cSql += " AND BX6_SEQUEN = BD6.BD6_SEQUEN "
	cSql += " AND BX6.D_E_L_E_T_ = ' ' "
	cSql += " WHERE BD6_FILIAL =  '" + xfilial("BD6") + "' "	
	cSql += " AND " + iif(cTpGui != "05", "BD5_CODRDA", "BE4_CODRDA") + " = '" + cCodRDA + "' "
	cSql += " AND BD6_CODPEG = '" + cProtocolo + "' "	
	cSql += " AND BD6.D_E_L_E_T_ = ' ' "
	cSql += " ORDER BY BD6_TIPGUI, CODLDP, CODPEG, NUMERO "

	plsUseArea(.T.,"TOPCONN",TCGENQRY(,,cSql),GuiasData,.F.,.T.)		
return

/*/{Protheus.doc} getSolicitante
Retorna os dados do solicitante da guia
@type method
@version 12.1.2510
@author zaar.goes
@since 31/07/2026
@return json, objeto json com os dados do solicitante
/*/
method getSolicitante() class TransparenciaProtDetalheService
	local cSql 			as character
	local cCbos 		as character
	local cNome 		:= ""
	local cCodSig		:= ""
	local cNumCr 		:= ""
	local cUF 			:= ""
	local cCodContra	:= (GuiasData)->CODRDA
	local cNomeContra	:= (GuiasData)->NOMRDA
	local cSgCDir		:= ""
	local aSolicitante  := {}
	local jSolicitante 	as json
	local jSolicitanteProf 	as json

	cNome 	:= (GuiasData)->NOMSOL
	cCodSig := getSiglaConselho((GuiasData)->SIGLA)
	cNumCr 	:= (GuiasData)->REGSOL
	cUF 	:= (GuiasData)->ESTSOL

	if !empty((GuiasData)->CDPFSO)
		cSql := " SELECT BB0_CODIGO, BB0_NOME NOME, BB0_CODSIG CODSIG, BB0_NUMCR NUMCR, BB0_ESTADO ESTADO, BB0_CGC "
		cSql += " FROM " + cBB0Name + " BB0 "
		cSql += " WHERE BB0_FILIAL 	=  '" + xfilial("BB0") + "' "
		cSql += " AND BB0_CODIGO 	= '" + (GuiasData)->CDPFSO + "' "
		cSql += " AND BB0.D_E_L_E_T_ = ' ' "
		plsUseArea(.T.,"TOPCONN",TCGENQRY(,,cSql),"TrbSOL",.F.,.T.)

		if !TrbSOL->(eof())
			cCodContra  := TrbSOL->BB0_CODIGO
			cNomeContra := TrbSOL->NOME
		endif

		cNome 	:= TrbSOL->NOME
		cCodSig := getSiglaConselho(TrbSOL->CODSIG)
		cNumCr 	:= TrbSOL->NUMCR
		cUF 	:= TrbSOL->ESTADO

		TrbSOL->(dbclosearea())
	else
		cSql := " SELECT BAU_CODIGO, BAU_NOME, BAU_CPFCGC, BAU_SIGLCR, BAU_CONREG, BAU_ESTCR, BAU_SIGDIR, BAU_DIRREG, BAU_UFCDIR, BAU_TIPPE, BAU_DIRTEC"
		cSql += " FROM " + cBAUName + " BAU"
		cSql += " WHERE BAU_FILIAL = '" + xfilial("BAU") + "'"
		cSql += " AND BAU_CODIGO = '" + (GuiasData)->CODRDA + "'"
		cSql += " AND BAU.D_E_L_E_T_ = ' '"
		plsUseArea(.T.,"TOPCONN",TCGENQRY(,,cSql),"TrbBAU",.F.,.T.)

		cSgCDir 	:= getSiglaConselho(TrbBAU->BAU_SIGDIR)
		cCodContra	:= TrbBAU->BAU_CODIGO
		cNomeContra	:= TrbBAU->BAU_NOME

		if TrbBAU->BAU_TIPPE == 'F'
			cNome		:= TrbBAU->BAU_NOME
			cCodSig		:= getSiglaConselho(TrbBAU->BAU_SIGLCR)
			cNumCr		:= TrbBAU->BAU_CONREG
			cUF			:= TrbBAU->BAU_ESTCR
		else
			cNome		:= TrbBAU->BAU_DIRTEC
			cCodSig		:= cSgCDir
			cNumCr		:= TrbBAU->BAU_DIRREG
			cUF			:= TrbBAU->BAU_UFCDIR
		endif
		TrbBAU->(dbclosearea())
	endif

	cCbos := BAQ->(posicione("BAQ",1,xFilial("BAQ")+cCodInt+alltrim((GuiasData)->BD6_ESPSOL),"BAQ_CBOS"))
	iif(empty(cCbos), cCbos := BAQ->(posicione("BAQ",1,xFilial("BAQ")+cCodInt+alltrim((GuiasData)->CODESP),"BAQ_CBOS")), )	

	jSolicitante := JsonObject():New()
    SetJsonChar(@jSolicitante, "nome", cNomeContra)
    SetJsonChar(@jSolicitante, "codigo", cCodContra)

	aadd(aSolicitante, jSolicitante)

	// 4. dadosProfissionalSolicitante
	if !empty(cCodSig) .and. !empty(cNumCr)
		jSolicitanteProf := JsonObject():New()
		SetJsonChar(@jSolicitanteProf, "nome", cNome)
		SetJsonChar(@jSolicitanteProf, "siglaConselhoProfissional", cCodSig)
		SetJsonChar(@jSolicitanteProf, "numeroConselhoProfissional", cNumCr)
		SetJsonChar(@jSolicitanteProf, "ufConselhoProfissional", PLSGETVINC("BTU_CDTERM", "   ", .F., "59", cUF))
		SetJsonChar(@jSolicitanteProf, "cbo", cCbos)
		aadd(aSolicitante, jSolicitanteProf)
	endif
return aSolicitante

/*/{Protheus.doc} getContratadoExecutante
Retorna os dados do contratado executante da guia
@type method
@version 12.1.2510
@author zaar.goes
@since 31/07/2026
@return json, objeto json com os dados do contratado executante
/*/
method getContratadoExecutante() class TransparenciaProtDetalheService
	local cSql 		as character	
	local cCnesPE	:= ""
	local cNomRDAEx := ""
	local cCPFCNPJSol := ""
	local cCPFCGCEx := ""
	local cMuniEx   := ""
	local cRecProEx := ""

	//BB8_FILIAL+BB8_CODIGO+BB8_CODINT+BB8_CODLOC+BB8_LOCAL
	cSql := " SELECT BB8_CPFCGC, BB8_CNES, BB8_CODMUN, BAU_TIPRED, BAU_TIPPRE, BAU_RECPRO, BAU_CPFCGC, BAU_CNES, BAU_CODOPE, BAU_COPCRE FROM " + cBAUName + " BAU "
	cSql += " INNER JOIN " + cBB8Name + " BB8 "
	cSql += " ON BB8_FILIAL 	= '" + xfilial("BB8") + "' "
	cSql += " AND BB8_CODIGO 	= BAU_CODIGO "
	cSql += " AND BB8_CODINT 	= '" + cCodInt + "' "
	if !empty((GuiasData)->CODLOC)
		cSql += " AND BB8_CODLOC 	= '" + (GuiasData)->CODLOC + "' "
	endif
	cSql += " AND BB8.D_E_L_E_T_ = ' ' "
	cSql += " WHERE BAU_FILIAL 	=  '" + xfilial("BB8") + "' "
	cSql += " AND BAU_CODIGO 	= '" + (GuiasData)->CODRDA + "' "
	cSql += " AND BAU.D_E_L_E_T_ = ' ' "
	plsUseArea(.T.,"TOPCONN",TCGENQRY(,,cSql),"TrbBAU",.F.,.T.)

	if !TrbBAU->(eof())
		cTipPre := posicione("BAG",1,xfilial("BAG")+TrbBAU->BAU_TIPPRE,"BAG_CODPT")

		cCPFCNPJSol := ifPls(TrbBAU->BB8_CPFCGC, TrbBAU->BAU_CPFCGC)
		cCnes := ifPls(ifPls(TrbBAU->BB8_CNES,TrbBAU->BAU_CNES),"9999999")

		if lPLU5CNES
			cCnesPE := execBlock("PLU5CNES", .f., .f. , {cCnes, (GuiasData)->CODRDA, (GuiasData)})
		endif
		cCnesPE := iif( (lPLU5CNES .and. valtype(cCnesPE) == "C"), cCnesPE, cCnes)

		cUniPre := iif(TrbBAU->BAU_TIPPRE == "OPE",TrbBAU->BAU_CODOPE,cCodInt) //Unimed do Prestador
		cCodPre := iif( empty((GuiasData)->RDAEDI), (GuiasData)->CODRDA,(GuiasData)->RDAEDI) //Codigo do Prestador

		cNomRDAEx := (GuiasData)->NOMRDA

		if StrZero( Val(cTipPre), 2) == '01'
			cCPFCGCEx := P400CPFCNPJ(.t., (GuiasData)->CODRDA)
		else
			cCPFCGCEx := cCPFCNPJSol
		endif

		iif(empty(cCPFCGCEx), cCPFCGCEx := cCPFCNPJSol, )

		cMuniEx   := TrbBAU->BB8_CODMUN
		cRecProEx :=  iif(TrbBAU->BAU_COPCRE == '1', 1, iif(cRecProEx == 'S', 2, 3))
		
		jCExecutante := JsonObject():New()
        SetJsonChar(@jCExecutante, "cpfCnpj", cCPFCGCEx)
        SetJsonChar(@jCExecutante, "codigo", cCodPre)
        SetJsonChar(@jCExecutante, "nome", cNomRDAEx)
        SetJsonValue(@jCExecutante, "cnes", cCnesPE)
        SetJsonChar(@jCExecutante, "tipoPrestador", cTipPre)
        SetJsonValue(@jCExecutante, "tipoVinculo", cRecProEx)
        SetJsonValue(@jCExecutante, "codigoMunicipio", cMuniEx)
	endif
	TrbBAU->(dbclosearea())
return jCExecutante

/*/{Protheus.doc} getHospital
Retorna os dados do hospital da guia
@type method
@version 12.1.2510
@author zaar.goes
@since 31/07/2026
@return json, objeto json com os dados do hospital
/*/
method getHospital() class TransparenciaProtDetalheService
	local cSql := ""

	cSql := " SELECT BE4_CODRDA, BB8_CNES, BE4_NOMRDA, BAU_CPFCGC, BE4_CGCRDA "
	cSql += " FROM " + cBE4Name + " BE4 "
	cSql += " INNER JOIN " + cBAUName + " BAU "
	cSql += " ON BAU_FILIAL = '" + xfilial("BAU") + "' "
	cSql += " AND BAU_CODIGO = BE4_CODRDA "
	cSql += " AND BAU.D_E_L_E_T_ = ' ' "
	cSql += " INNER JOIN " + cBB8Name + " BB8 "
	cSql += " ON BB8_FILIAL  = '" + xfilial("BB8") + "' "
	cSql += " AND BB8_CODIGO = BAU_CODIGO "
	cSql += " AND BB8_CODINT = '" + cCodInt + "' "
	cSql += " AND BB8_CODLOC = BE4_CODLOC  "
	cSql += " AND BB8.D_E_L_E_T_ = ' ' "
	cSql += " WHERE BE4_FILIAL = '" + xfilial("BE4") + "' "
	cSql += " AND BE4_CODOPE = '" + substr((GuiasData)->GUIINT,01,4) + "' "
	cSql += " AND BE4_CODLDP = '" + substr((GuiasData)->GUIINT,05,4) + "' "
	cSql += " AND BE4_CODPEG = '" + substr((GuiasData)->GUIINT,09,8) + "' "
	cSql += " AND BE4_NUMERO = '" + substr((GuiasData)->GUIINT,17,8) + "' "
	cSql += " AND BE4.D_E_L_E_T_ = ' ' "
	plsUseArea(.T.,"TOPCONN",TCGENQRY(,,cSql),"TrbHM",.F.,.T.)
	
	if TrbHM->(!eof())
		jHospital := JsonObject():New()
		SetJsonChar(@jHospital, "codigo", TrbHM->BE4_CODRDA)
        SetJsonChar(@jHospital, "cnpj", IIF(empty(TrbHM->BE4_CGCRDA) .OR. Len(alltrim(TrbHM->BE4_CGCRDA)) <> 14, IIF(empty(TrbHM->BAU_CPFCGC) .OR. Len(alltrim(TrbHM->BAU_CPFCGC)) <> 14, "", TrbHM->BAU_CPFCGC), TrbHM->BE4_CGCRDA))
        SetJsonChar(@jHospital, "nome", TrbHM->BE4_NOMRDA)
        SetJsonValue(@jHospital, "cnes", TrbHM->BB8_CNES)
	endif

	TrbHM->(dbclosearea())
return jHospital

/*/{Protheus.doc} getProcedimentos
Retorna os dados dos procedimentos da guia
@type method
@version 12.1.2510
@author zaar.goes
@since 31/07/2026
@param cCodRda, character, código do RDA
@return json, objeto json com os dados dos procedimentos
/*/
method getProcedimentos(cCodRda) class TransparenciaProtDetalheService
	local jProcedimento as json
	local jProcedimentos as json
	local jFornecedor as json
	local jEquipes as json
	local aProcedimentos := {}
	local cViaAce	:= ""
	local cFatSer	:= 0
	local cTecUtil	:= ""
	local cCodUnm	:= ""
	local cCodAto	:= ""
	local cTpProc	:= ""
	local nX		:= 1	
	local lPacote 	:= .f.
	local aPacote 	:= {}	
	local cCodPro	:= ""
	local cPacote	:= ""
	local lPacAbert	:= .f.
	local lPEExtPac	:= existBlock( "PLSPACOTE" ) //PE para envio de pacote aberto
	local lGeraEquipe	:= .T.
	local aAreaBA8  := {}
	local cRegAnvis := ""
	local id_Acresc := 0
	local nPerHorEsp:= 0	
	local cHorFim 	:= ""
	local cCodTab	:= ""
	local cSeek		:= ""
	local cViaAceF  := ""
	local lLisRef   := GETNEWPAR("MV_PLSLRF","0") =="1" .And. BGR->(FieldPos("BGR_POSREF")) > 0 .And. BA0->(FieldPos("BA0_LISREF")) > 0
	local lPea      := .F.
	local cOpe      := ""
	local lIdAcrs   := .F.	
	local cSql 		:= ""
	local cNrAutor  := ""
	local nSeq		:= 0
	
	cChave := (GuiasData)->CODLDP + (GuiasData)->CODPEG + (GuiasData)->NUMERO
	while !(GuiasData)->(eof()) .and. cChave == (GuiasData)->CODLDP + (GuiasData)->CODPEG + (GuiasData)->NUMERO
		nSeq := nSeq + 1
		::cGuiaProcessada := cChave + "|" + cvaltochar(nSeq)
		cSql 		:= ""
		cViaAce 	:= ""
		cFatSer		:= 1
		cTecUtil	:= ""
		cPorteAne	:= ""
		cPacote 	:= ""
		cNrAutor	:= ""
		aPacote 	:= {{.f.}}
		lPacAbert	:= .f.
		cViaAceF    := ""
		lIdAcrs   	:= .F.
		id_Acresc	:= 0
		nPerHorEsp   := 0

		if BGR->(msSeek(xFilial("BGR")+cCodInt+(GuiasData)->BD6_VIA))
			if !empty(BGR->BGR_CODEDI)
				cViaAce := BGR->BGR_CODEDI
				cViaAceF:= BGR->BGR_CODVIA
			else
				cViaAce := BGR->BGR_CODVIA
				cViaAceF:= BGR->BGR_CODVIA
			endif
		endif

		if (GuiasData)->BD6_PROCCI == '1'
			cTecUtil := iif((GuiasData)->BD6_TECUTI == "C", 1,;
						iif((GuiasData)->BD6_TECUTI == "V", 2,;
						iif((GuiasData)->BD6_TECUTI == "R", 3,;
						ifPls((GuiasData)->BD6_TECUTI, '1'))))			
		endif

		//Busca o Percentual de horario especial, na cobrança (BD7_PRCHES) ou pagamento (BD6_PERHES)
		nPerHorEsp := PerHorHesp((GuiasData)->CODOPE,(GuiasData)->CODLDP,(GuiasData)->CODPEG,(GuiasData)->NUMERO,;
			(GuiasData)->BD6_ORIMOV,(GuiasData)->BD6_SEQUEN,(GuiasData)->BD6_PERHES)

		If nPerHorEsp > 0 .And. BR8->(fieldPos("BR8_TIPROL")) > 0
			BR8->(dbSetOrder(1))
			BR8->(msSeek(xFilial("BR8")+Alltrim((GuiasData)->BD6_CODPAD) + Alltrim((GuiasData)->BD6_CODPRO)))
			lIdAcrs := BR8->BR8_TIPROL == "1"     //1-honor  2-SADT
		EndIf

		//quando tem horário especial o id_acrescimo é 'S' e o fator_multiplicador '1.00'
		//se o procedimento esta relacionado como exceção id_acrescimo = 'N'
		//se BR8_TIPROL='1' honorario - id_acrescimo = 'S'
		//se tem horario especial e esta definido como BR8_ADCNOT='1' - id_acrescimo = 'S'
		if !(alltrim((GuiasData)->BD6_CODPRO) $ getnewpar("MV_PLSE500","")) .and. ((nPerHorEsp > 0) .and. PlsParPro(Alltrim((GuiasData)->BD6_CODPRO)))
			id_Acresc := 1
			cFatSer   := 1		
		endif

		if id_Acresc = 0 //condição para não sobrescrever quando tem horário especial acima
			//Verifica se o procedimento está com o campo quantidade X percentual "1 - SIM"
			BR8->(dbSetOrder(1))
			BR8->(msSeek(xFilial("BR8")+Alltrim((GuiasData)->BD6_CODPAD) + Alltrim((GuiasData)->BD6_CODPRO)))
			if BR8->BR8_QTDPER == "1" 
				//Verifica configuração padrão quantidade X percentual  
				iif(BL0->(msSeek(xFilial("BL0")+ Alltrim((GuiasData)->BD6_CODPAD) + Alltrim((GuiasData)->BD6_CODPRO))) .and. !Empty((GuiasData)->BD6_PERC1) .and. (GuiasData)->BD6_PERC1 > 0,;
					cFatSer := Transform((GuiasData)->BD6_PERC1/100,"9.99"), )
			else // senão verifica BGR - Vias de Acessos
				cFatSer := PlsBscMPS(cViaAceF,(GuiasData)->CODOPE)
			endif
		endif

		If lPLFATMUL
			cFatSer:= ExecBlock("PLFATMUL",.F.,.F.,{(GuiasData)->CODOPE + (GuiasData)->CODLDP + (GuiasData)->CODPEG + (GuiasData)->NUMERO,Alltrim((GuiasData)->BD6_CODPAD),Alltrim((GuiasData)->BD6_CODPRO),Alltrim((GuiasData)->BD6_SEQUEN),cFatSer}) 
		EndIf 		

		cCodUnm 	:= (GuiasData)->BX6_CODUNM
		cRegAnvis	:= (GuiasData)->BX6_REGANV

		

		if (GuiasData)->BD6_CODTAB <> (GuiasData)->BD6_CDTBRC
			cCodTab:= (GuiasData)->BD6_CDTBRC
		else
			cCodTab:= (GuiasData)->BD6_CODTAB
		endif

		If lLisRef
			lPea:= (GuiasData)->(BD6_CODEMP) == GetNewPar("MV_PLSCPEA", "" )
			If !lPea
				BD6->(DBSETORDER(1))
				BD6->(MsSeek(xFilial("BD6") + cCodInt+cChave))
				cOpe:= PLSBSCOPI((GuiasData)->CODOPE+(GuiasData)->(BD6_CODEMP+BD6_MATRIC+BD6_TIPREG+BD6_DIGITO),"BD6",STOD((GuiasData)->(BD6_DATPRO)))
			EndIF

		EndIF 
		
		//BD4_FILIAL+BD4_CODTAB+BD4_CDPADP+BD4_CODPRO+BD4_CODIGO+DTOS(BD4_VIGINI)
		BD4->(Msseek( cSeek:= xFilial("BD4")+cCodInt+cCodTab+(GuiasData)->(BD6_CODPAD+BD6_CODPRO)+"PA" ))
		While BD4->(!Eof()) .And. cSeek==BD4->(BD4_FILIAL+BD4_CODTAB+BD4_CDPADP+BD4_CODPRO+Left(BD4_CODIGO,2))
			if ( BD4->BD4_VIGINI <= stod((GuiasData)->DATPRO) .and. BD4->BD4_VIGFIM >= stod((GuiasData)->DATPRO) ) .or. ;
			   ( BD4->BD4_VIGINI <= stod((GuiasData)->DATPRO) .and. empty(BD4->BD4_VIGFIM) ) .or. ;
			   ( empty(BD4->BD4_VIGINI) .and. empty(BD4->BD4_VIGFIM) )

				cPorteAne := iif((lPea .Or. !Empty(cOpe)) .and. AllTrim(BD4->BD4_CODIGO) $ cAnest,;
							 BD4->BD4_PORMED, getBKF((GuiasData)->DATPRO))				
				exit
			endif
			BD4->(dbSkip())
		enddo

		if posicione("BAU",1,xfilial("BAU")+(GuiasData)->CODRDA,"BAU_TIPPRE") $ "MED,ANE"
			cCodAto := '1'
		else
			cCodAto := '2'
		endif
		if (GuiasData)->BD6_PACOTE == '1'
			lPacote := .t.
			aPacote := iif(lPEExtPac, execBlock("PLSPACOTE",.F.,.F.,GuiasData), getPacote(GuiasData))
			lPacAbert :=  iif(lPEExtPac, aPacote[1] == 2, .F.) //opção 2-Sem pacote principal PLSPACOTE			
		endif

		BE4->(dbSetOrder(1))
		If BE4->(MsSeek(xfilial('BE4') + (GuiasData)->CODOPE + (GuiasData)->CODLDP + (GuiasData)->CODPEG))
			iif(!Empty(BE4->BE4_HRFIMF), cHorFim := BE4->BE4_HRFIMF,;
				iif(!Empty(BE4->BE4_HRALTA), cHorFim := BE4->BE4_HRALTA, cHorFim := ""))
		EndIf

		for nX := 1 to len(aPacote)
			if nX > 1
				nSeq := nSeq + 1
				::cGuiaProcessada := cChave + "|" + cvaltochar(nSeq)
			endif
			
			if !(lPacAbert .and. nX == 1) //Processo para funcionamento do PE PLSPACOTE não exportar o pacote principal							
				jProcedimento := ::baseProcedimento(aPacote[nX], @cTpProc, @cCodPro, @lGeraEquipe, nSeq)
				if lPacote .and. nX == 1
					cPacote := cCodPro
				endif

				if empty(cCodUnm) .or. empty(cRegAnvis) .And. cTpProc <> "5"
					if BA8->(msSeek(xFilial("BA8")+(GuiasData)->(CODOPE+BD6_CODTAB+BD6_CODPAD+BD6_CODPRO)))
						cCodUnm  	:= BA8->BA8_UNMEDI
						cRegAnvis	:= iif(!Empty(BA8->BA8_RGANVI),ifPls(cRegAnvis ,BA8->BA8_RGANVI ),cRegAnvis)
					endif
				endif

				SetJsonChar(@jProcedimento, "tipoViaAcesso", cViaAce)
				SetJsonValue(@jProcedimento, "indicadorAcrescimo", id_Acresc)
				
				if !(lPacote .and. nX > 1)
					cSql := ::getSqlVlPag(cCodRda)
					plsUseArea(.T.,"TOPCONN",tcGenQry(,,ChangeQuery(cSql)),"VlPag",.F.,.T.)				
					SetJsonValue(@jProcedimento, "valorInformado", VlPag->(A))
					SetJsonValue(@jProcedimento, "valorProcessado", VlPag->(P))
					SetJsonValue(@jProcedimento, "valorLiberado", VlPag->(M))
					SetJsonValue(@jProcedimento, "valorGlosa", VlPag->(G))
					VlPag->(DbCloseArea())
				else
					SetJsonValue(@jProcedimento, "valorInformado", 0)
					SetJsonValue(@jProcedimento, "valorProcessado", 0)
					SetJsonValue(@jProcedimento, "valorLiberado", 0)
					SetJsonValue(@jProcedimento, "valorGlosa", 0)
				endif

				if (GuiasData)->TIPGUI <> "10" 
					if lPacote .and. nX > 1
						aAreaBA8 := BA8->(getArea())
						BA8->(dbsetOrder(3))
						if BA8->(msSeek(xFilial("BA8")+aPacote[nX][1]+aPacote[nX][2]))
							cCodUnm  := BA8->BA8_UNMEDI
						endif
						restarea(aAreaBA8)
					endif
					SetJsonChar(@jProcedimento,"unidadeMedida", cCodUnm)
				endif

				
				SetJsonValue(@jProcedimento,"fatorMultiplicadorServico", cFatSer)
				SetJsonValue(@jProcedimento,"indicadorPacote", iif(lPacote,1,0))
				SetJsonValue(@jProcedimento, "codigoPacote", cPacote) 
				SetJsonChar(@jProcedimento, "indicadorAnestesico", cPorteAne)
				SetJsonChar(@jProcedimento, "numeroRegistroAnvisa", cRegAnvis)
				
				cNrAutor := substr(ifPls((GuiasData)->NRAOPE,(GuiasData)->NRAEMP),1,10)
				if !empty(alltrim(cNrAutor))
					SetJsonChar(@jProcedimento, "numeroAutorizacao", cNrAutor)
					SetJsonChar(@jProcedimento, "dataAutorizacao", getData((GuiasData)->DATPRO))
				end if
				SetJsonChar(@jProcedimento, "codigoReferenciaFabricante", (GuiasData)->BD6_REFFED)
				SetJsonChar(@jProcedimento, "especialidade", BAQ->(posicione("BAQ",1,xFilial("BAQ")+cCodInt+alltrim((GuiasData)->CODESP),"BAQ_INTERC")))				
				SetJsonChar(@jProcedimento, "codigoAtuacao", "")
				
				if !(lPacote .and. nX > 1)
					jFornecedor := ::getFornecedor(cTpProc, cCodPro)
					if jFornecedor != nil
						jProcedimento["dadosFornecedor"] := jFornecedor
					endif

					// Subnó: equipes (Array)
					jEquipes := ::equipeProfissional((GuiasData)->TIPGUI,cTpProc,lGeraEquipe)			
					if jEquipes != nil
						jProcedimento["equipes"] := jEquipes
					endif
				endif
				aAdd(aProcedimentos, jProcedimento	)
			endif
		next
		
		lPacote 	:= .f.				
		(GuiasData)->(dbskip())
	enddo
	::cGuiaProcessada := cChave
	jProcedimentos := aProcedimentos
return jProcedimentos

/*/{Protheus.doc} baseProcedimento
Método responsável por montar os dados dos procedimentos
@type method
@version 12.1.2510
@author zaar.goes
@since 31/07/2026
@param aPacote, array, vetor com os dados do pacote
@param cTpProc, character, tipo do procedimento
@param cCodPro, character, código do procedimento
@return json, objeto json com os dados dos procedimentos
/*/
method baseProcedimento(aPacote, cTpProc, cCodPro, lGeraEquipe, nSeq) class TransparenciaProtDetalheService	
	local cQtd		:= ""
	local aProced	:= {}
	local lPeaPacote := (GuiasData)->(BD6_CODEMP) == GetNewPar("MV_PLSCPEA", "" );
						.and. cPacGPTU $  Alltrim((GuiasData)->BD6_CODPRO) .AND. !Empty((GuiasData)->BD6_CD_PAC)
	local lPacote 	:= .f.
	default lAvisado:= .f.
	default nX 		:= 0 //Acrescimo para quando vier do procedimentosExecutados
	default aPacote	:= {}
	default cCodPad	:= ""
	default cCodPro	:= ""
	default lGeraEquipe := .F.
	
	if len(aPacote) > 1
		cCodPad := Alltrim(aPacote[1])
		cCodPro := Alltrim(aPacote[2])
		lPacote := .t.
	else
		cCodPad := Alltrim((GuiasData)->BD6_CODPAD)
		cCodPro := Alltrim((GuiasData)->BD6_CODPRO)
	endif

	aProced		:= dePara(cCodPad,cCodPro,(GuiasData)->BD6_DATPRO,(GuiasData)->BD6_CODRDA,(GuiasData)->TIPGUI)
	cCodPad 	:= aProced[1]
	cCodPro 	:= alltrim(aProced[2])
	cTpProc 	:= aProced[3]
	lGeraEquipe	:= aproced[4]

	//Quando for PEA deve exportar o pacote recebido da outra UNIMED
	iif(lPeaPacote, cCodPad := "98", )
	iif(lPeaPacote,	cCodPro := Alltrim((GuiasData)->BD6_CD_PAC), )

	if cCodPad == "00"
		iif(cTpProc $ "3;4;7;8", cCodPro := "18" + cCodPro, )  //Diárias, taxas, gases medicinais e Alugueis			
		iif(cTpProc $ "1;5", cCodPro := "19" + cCodPro, ) // Materiais e OPME
		iif(cTpProc == "2", cCodPro := "20" + cCodPro, ) // Medicamentos
		iif(.not. (cTpProc $ "1;2;3;4;5;7;8"), cCodPro := "22" + cCodPro, )
	endif
	
	jProcedimento := JsonObject():New()	
	SetJsonChar(@jProcedimento, "dataExecucao", getData((GuiasData)->BD6_DATPRO))
	SetJsonValue(@jProcedimento, "sequencialItem", nSeq)
	SetJsonChar(@jProcedimento, "tipoTabela", cCodPad)
	SetJsonChar(@jProcedimento, "codigoServico", cCodPro)
	SetJsonChar(@jProcedimento, "descricaoServico", iif(lPacote,aPacote[3], iif(cCodPad == "00", (GuiasData)->BD6_DESPRO, "")))

	if (GuiasData)->TIPGUI != "01"		
		if len(aPacote) < 11 //Caso > que 10 houve manipulação do PE PLSPACOTE e a quantidade já foi processada e armazenada na posição [11]
			if lPacote .and.  (aPacote[5] # "BLY|BLE")  .and. len(aPacote)>=9
				cQtd := cValTochar(iif(aPacote[9] == 0,1, aPacote[9])) //Se o Alias não vier como BLY ou BLE pego a qtde do B43_QTDPRO
			else
				cQtd := iif(lPacote,getQtdProc((GuiasData)->CODRDA, (GuiasData)->BD6_CODPRO,aPacote[2], aPacote[5],aPacote[1]) ,cvaltochar((GuiasData)->BD6_QTDPRO))
			endif
		endif
		iif(len(aPacote) >= 11, cQtd := cvaltochar(aPacote[11]), )		

		SetJsonValue(@jProcedimento,"quantidadeCobrada", ifpls(cQtd,1))
	endif
return jProcedimento

/*/{Protheus.doc} equipeProfissional
Método responsável por montar os dados dos procedimentos
@type method
@version 12.1.2510
@author zaar.goes
@since 31/07/2026
/*/
method equipeProfissional(cTipGui,cTpProc,lGeraEquipe) class TransparenciaProtDetalheService	
	local cSql	 		:= ""
	local aEquip		:= {}
	local nX 			:= 1
	local nI			:= 0
	local lReg			:= .f. //indica se o registro já está no array aEquip
	local lIncEqpTag	:= .t.
	Local lTemUmValido	:= .F.
	Local aAreaBAU		:= BAU->(getArea())
	Local cCpfCNPJRDA	:= ""
	Local cNomeRDA		:= ""
	Local aPartic		:= {}
	local jEquipe := nil as json
	local jEquipes := nil as json
	local cGrauPa := ""
	local cGraupart := ""
	default cTpProc 	:= ""
	default lGeraEquipe := .f.
	
	
	cSql += " SELECT BD7_CDPFPR, BD7_SIGLA, BD7_REGPRE, BD7_ESTPRE, BD7_ESPEXE, BD7_CODUNM, BD7_NLANC, BD7_CODTPA, BD7_CODESP "
	cSql += " FROM " + cBD7Name + " BD7 "
	cSql += " WHERE BD7_CODOPE = '" + cCodInt + "' "
	cSql += " AND BD7_CODLDP = '" + (GuiasData)->CODLDP + "' "
	cSql += " AND BD7_CODPEG = '" + (GuiasData)->CODPEG + "' "
	cSql += " AND BD7_NUMERO = '" + (GuiasData)->NUMERO + "' "
	cSql += " AND BD7_SEQUEN = '" + (GuiasData)->BD6_SEQUEN + "' "
	cSql += " AND BD7_CDPFPR <> ' ' "
	plsUseArea(.T.,"TOPCONN",TCGENQRY(,,cSql),"TrbBD7",.F.,.T.)
	while !TrbBD7->(eof())
		cSql := " SELECT BB0_NOME, BB0_CGC "
		cSql += " FROM " + cBB0Name + " BB0 "
		cSql += " WHERE BB0_FILIAL = '" + xfilial("BB0") + "' "
		cSql += " AND BB0_CODIGO = '" + TrbBD7->BD7_CDPFPR + "' "
		cSql += " AND LEN(BB0_CGC) = 11 "
		cSql += " AND BB0.D_E_L_E_T_ = ' ' "
		plsUseArea(.T.,"TOPCONN",TCGENQRY(,,ChangeQuery(cSql)),"TrbBB0",.F.,.T.)
		while !TrbBB0->(eof())
			aadd(aEquip,{TrbBD7->BD7_ESPEXE,TrbBD7->BD7_CODESP,TrbBD7->BD7_CODTPA,TrbBD7->BD7_CODUNM,TrbBB0->BB0_NOME,TrbBB0->BB0_CGC,TrbBD7->BD7_SIGLA,TrbBD7->BD7_REGPRE,TrbBD7->BD7_ESTPRE,TrbBD7->BD7_NLANC,TrbBD7->BD7_CDPFPR})
			if !(empty(aEquip[Len(aEquip)][3]))
				lTemUmValido := .T.
			endif
			TrbBB0->(dbskip())
		enddo
		TrbBB0->(dbclosearea())
		TrbBD7->(dbskip())
	enddo
	TrbBD7->(dbclosearea())

	if (cTipGui != "10") .AND. !lTemUmValido
		lIncEqpTag	:= .f.
	endif

	//tag obrigatória na guia de honorarios, se não achei mando o proprio RDA
	if (cTipGui == "10" .or. cTpProc == "0")
		cSql := " SELECT BAU_CODIGO, BAU_NOME, BAU_CPFCGC, BAU_SIGLCR, BAU_CONREG, BAU_ESTCR, BD7_ESPEXE, BD7_CODUNM, BD7_CODTPA, BD7_CODESP, BD7_NLANC, BAU_SIGDIR, BAU_DIRREG, BAU_UFCDIR, BAU_TIPPE, BAU_DIRTEC "
		cSql += " FROM " + cBD7Name + " BD7 "
		cSql += " INNER JOIN " + cBAUName + " BAU "
		cSql += " ON BAU_FILIAL 	=  '" + xfilial("BB8") + "' "
		cSql += " AND BAU_CODIGO 	= BD7.BD7_CODRDA "
		cSql += " AND BAU.D_E_L_E_T_ = ' ' "
		cSql += " WHERE BD7_CODOPE = '" + cCodInt + "' "
		cSql += " AND BD7_CODLDP = '" + (GuiasData)->CODLDP + "' "
		cSql += " AND BD7_CODPEG = '" + (GuiasData)->CODPEG + "' "
		cSql += " AND BD7_NUMERO = '" + (GuiasData)->NUMERO + "' "
		cSql += " AND BD7_SEQUEN = '" + (GuiasData)->BD6_SEQUEN + "' "
		cSql += " AND BD7_CODUNM NOT IN ("+cCusOpe+","+cFilm+") "
		cSql += " AND BAU_TIPPE = 'F' "		
		plsUseArea(.T.,"TOPCONN",TCGENQRY(,,cSql),"TrbBD7",.F.,.T.)

		while !TrbBD7->(eof())

			lReg := .f. //reset da flag
			for nI := 1 to len(aEquip) //verifico se já existe um registro no array aEquip com os dados a serem imputados
				if aScan( aEquip[nI] , TrbBD7->BD7_CODUNM ) > 0 .and. aScan( aEquip[nI] , TrbBD7->BD7_NLANC )  > 0
					lReg := .T.
					exit
				endif
			next
			if lReg //se achou, sai do for e skipa a linha sem duplicar o registro
				TrbBD7->(dbskip())
				loop
			endif
						
			aadd(aEquip,{TrbBD7->BD7_ESPEXE,TrbBD7->BD7_CODESP,TrbBD7->BD7_CODTPA,TrbBD7->BD7_CODUNM,TrbBD7->BAU_NOME,TrbBD7->BAU_CPFCGC,TrbBD7->BAU_SIGLCR,TrbBD7->BAU_CONREG,TrbBD7->BAU_ESTCR,TrbBD7->BD7_NLANC, TrbBD7->BAU_CODIGO})
			
			TrbBD7->(dbskip())
		enddo
		TrbBD7->(dbclosearea())
	endif

	BAU->(dbsetOrder(1))
	If BAU->(MsSeek(xfilial("BAU") + (GuiasData)->CODRDA))
		cCpfCNPJRDA := Alltrim(BAU->BAU_CPFCGC)
		cNomeRDA	:= Alltrim(BAU->BAU_NOME)
	endif
	restArea(aAreaBAU)

	for nX := 1 to len(aEquip)

		cCBOS := AllTrim( Posicione("BAQ",7,xfilial("BAQ")+aEquip[nX][1],"BAQ_CBOS") )
		iif(empty(cCBOS), cCBOS := AllTrim( Posicione("BAQ",7,xfilial("BAQ")+aEquip[nX][2],"BAQ_CBOS") ), )
		iif(empty(cCBOS), cCBOS := "000000", )		

		cGrauPart := ""
		cGrauPa	:= ""		
		if cTipGui == "06"
			if aEquip[nX][4] == "AUX"
				cGrauPart	:=  aEquip[nX][10]
				if empty(cGrauPart) .or. !(cGrauPart $ '01;02;03;04')
					cGrauPart	:=  "01"
				endif
			elseif aEquip[nX][4] $ cAnest
				cGrauPart	:=  "06"
			else
				cGrauPa := PLSGrauUM((GuiasData)->BD6_CODPAD,(GuiasData)->BD6_CODPRO,aEquip[nX][4],stod((GuiasData)->BD6_DATPRO),"2")[2]
				iif(empty(cGrauPa) .and. aEquip[nX][4] $ cServ, cGrauPart := "00", cGrauPart := PLSGETVINC("BTU_CDTERM", "BWT", .F., "35", cGrauPa))
			endif
		elseif !empty(aEquip[nX][3])
			cGrauPart := PLSGETVINC("BTU_CDTERM", "BWT", .F., "35", aEquip[nX][3])
		endIf

		
		//Se participação inválida ou não informada o tipo de participação e número de conselho, não gera a tag de equipe.
		if (lGeraEquipe .and. !cGrauPart == "O") .or. (lIncEqpTag .and. (!Empty(cGrauPart) .and. !cGrauPart == "O"))				
			jEquipe := JsonObject():New()
			SetJsonChar(@jEquipe, "tipoParticipacao", ifpls(cGrauPart, iif(cTipGui $ "01,02", "12","00")))
			SetJsonChar(@jEquipe, "codigoprestador", aEquip[nX][11])
			SetJsonChar(@jEquipe, "cpf", iif(!empty(aEquip[nX][6]),aEquip[nX][6],cCpfCNPJRDA))
			SetJsonChar(@jEquipe, "nomeProfissional", iif(!empty(aEquip[nX][5]),aEquip[nX][5],cNomeRDA))
			SetJsonChar(@jEquipe, "siglaConselhoProfissional", getSiglaConselho(aEquip[nX][7]))
			SetJsonChar(@jEquipe, "numeroConselhoProfissional", aEquip[nX][8])
			SetJsonChar(@jEquipe, "ufConselhoProfissional", PLSGETVINC("BTU_CDTERM", "   ", .F., "59", aEquip[nX][9]))
			SetJsonChar(@jEquipe, "cbo", PADL(cCBOS,6,"0"))								
			Aadd(aPartic, jEquipe)
		endif		
	next
	if len(aPartic) > 0
		jEquipes := aPartic
	endif
return jEquipes

/*/{Protheus.doc} getSqlVlPag
Método responsável por buscar os valores faturados, pagos, glosados e liberados do procedimento
@type method
@version 12.1.2510
@author zaar.goes
@since 31/07/2026
@param cCodRDA, character, código do RDA
@return character, query SQL com os valores do procedimento
/*/
method getSqlVlPag(cCodRDA) class TransparenciaProtDetalheService
	local cSql		:= ""	
	

	BAU->(DbSetOrder(1))
	BAU->(MsSeek(xFilial("BAU") + alltrim(cCodRDA)))

	if BAU->BAU_CALIMP == "1"
		// pesquisa pelos valores faturados da SE2 e BD7
		cSql += " SELECT Sum(BD7_VALORI) A, SUM(BD7_VLRMAN) M, Sum(BD7_VLRPAG) P, Sum(BD7_VLRGLO)+Sum(BD7_VLRGTX) G, "
		cSql += " BD7_CODLDP, BD7_CODPEG, BD7_NUMERO, BD7_ORIMOV, BD7_SEQUEN, BD7_CODRDA "
		cSql += " from " + cSE2Name + " E2 "

		cSql += " INNER JOIN " + cSD1Name + " SD1 "
		cSql += " ON D1_FILIAL = '" + xFilial("SD1") + "' "
		cSql += " AND D1_SERIE   = E2_PREFIXO "
		cSql += " AND D1_DOC   = E2_NUM "
		cSql += " AND D1_FORNECE = E2_FORNECE "
		cSql += " AND D1_LOJA    = E2_LOJA "
		cSql += " AND SD1.D_E_L_E_T_ = ' ' "

		cSql += " INNER JOIN " + cSC7Name + " SC7 "
		cSql += " ON C7_FILIAL  = '" + xFilial("SC7") + "' "
		cSql += " AND C7_NUM    = D1_PEDIDO "
		cSql += " AND C7_ITEM   = D1_ITEMPC "
		cSql += " AND SC7.D_E_L_E_T_ = ' ' "

		cSql += " INNER JOIN " + cBD7Name + " BD7  "
		cSql += " ON BD7_FILIAL  = '" + xFilial("BD7") + "' "
		cSql += " AND BD7_CODOPE = C7_PLOPELT "
		cSql += " AND BD7_OPELOT = C7_PLOPELT "
		cSql += " AND BD7_NUMLOT = C7_LOTPLS "
		cSql += " AND BD7_CODRDA = C7_CODRDA "
		cSql += " AND BD7.D_E_L_E_T_ = ' ' "

		cSql += " INNER JOIN " + cBR8Name + " BR8 "
		cSql += " ON BR8_FILIAL  = '" + xFilial("BR8") + "' "
		cSql += " AND BR8_CODPAD = BD7_CODPAD "
		cSql += " AND BR8_CODPSA = BD7_CODPRO "
		cSql += " AND BR8_ODONTO != '1' "
		cSql += " AND BR8.D_E_L_E_T_ = ' ' "
		cSql += " Where "
		cSql += " E2_FILIAL = '" + xfilial("SE2") + "' "		
		cSql += " AND BD7_CODOPE = '" + (GuiasData)->CODOPE + "' "
		cSql += " AND BD7_CODLDP = '" + (GuiasData)->CODLDP + "' "
		cSql += " AND BD7_CODPEG = '" + (GuiasData)->CODPEG + "' "
		cSql += " AND BD7_NUMERO = '" + (GuiasData)->NUMERO + "' "
		cSql += " AND BD7_ORIMOV = '" + (GuiasData)->BD6_ORIMOV + "' "
		cSql += " AND BD7_SEQUEN = '" + (GuiasData)->BD6_SEQUEN + "' "
		cSql += " AND E2_CODRDA = '" + cCodRDA + "' "
		cSql += " AND E2.D_E_L_E_T_ =  ' ' "
		cSql += " Group By "
		cSql += " BD7_CODLDP, BD7_CODPEG, BD7_NUMERO, BD7_ORIMOV, BD7_SEQUEN, BD7_CODRDA "		

	Elseif BAU->BAU_CALIMP == "4"

		cSql += " SELECT Sum(BD7_VALORI) A, SUM(BD7_VLRMAN) M, Sum(BD7_VLRPAG) P, Sum(BD7_VLRGLO)+Sum(BD7_VLRGTX) G, 0 IR,0 ISS, 0 INSS, 0 PIS, 0 COF,0 CSLL, "
		cSql += " BD7_CODLDP, BD7_CODPEG, BD7_NUMERO, BD7_ORIMOV, BD7_SEQUEN, BD7_CODRDA "
		cSql += " from " + cSRDName + " SRD "
		cSql += " Inner join " + cBD7Name + " BD7 "
		cSql += " On "
		cSql += " BD7_FILIAL = '" + xfilial("BD7") + "' AND "
		cSql += " BD7_NUMLOT = RD_LOTPLS AND "
		cSql += " BD7_CODRDA = '" + cCodRDA + "' AND "
		csql += " BD7.D_E_L_E_T_ =  ' ' "
		cSql += " Inner Join " + cBR8Name + " BR8 "
		csql += " On "
		cSql += " BR8_FILIAL = '" + xFilial("BR8") + "' AND "
		cSql += " BR8_CODPAD = BD7_CODPAD AND "
		csql += " BR8_CODPSA = BD7_CODPRO AND "
		csql += " BR8_ODONTO != '1' AND "
		cSql += " BR8.D_E_L_E_T_ =  ' ' "
		cSql += " Where "
		cSql += " RD_FILIAL = '" + xfilial("SRD") + "' "
		cSql += " AND BD7_CODOPE = '" + (GuiasData)->CODOPE + "' "
		cSql += " AND BD7_CODLDP = '" + (GuiasData)->CODLDP + "' "
		cSql += " AND BD7_CODPEG = '" + (GuiasData)->CODPEG + "' "
		cSql += " AND BD7_NUMERO = '" + (GuiasData)->NUMERO + "' "
		cSql += " AND BD7_ORIMOV = '" + (GuiasData)->BD6_ORIMOV + "' "
		cSql += " AND BD7_SEQUEN = '" + (GuiasData)->BD6_SEQUEN + "' "
		cSql += " AND BD7_CODRDA = '" + cCodRDA + "' "
		cSql += " AND SRD.D_E_L_E_T_ =  ' ' "
		cSql += " Group By "
		cSql += " BD7_CODLDP, BD7_CODPEG, BD7_NUMERO, BD7_ORIMOV, BD7_SEQUEN, BD7_CODRDA "		
	else		
		// pesquisa pelo título(SE2) vinculado a BD7 faturada através do BD7_CHKSE2
		cSql += " SELECT Sum(BD7_VALORI) A, SUM(BD7_VLRMAN) M, Sum(BD7_VLRPAG) P, Sum(BD7_VLRGLO)+Sum(BD7_VLRGTX) G, "
		cSql += " BD7_CODLDP, BD7_CODPEG, BD7_NUMERO, BD7_ORIMOV, BD7_SEQUEN, BD7_CODRDA "
		cSql += " from " + cSE2Name + " E2 "
		cSql += " Inner join " + cBD7Name + " BD7 "
		cSql += " On "
		cSql += " BD7_FILIAL = '" + xfilial("BD7") + "' AND "
		cSql += sqlBD7ChkSE2()
		cSql += " BD7_CODRDA = '" + cCodRDA + "' AND "
		csql += " BD7.D_E_L_E_T_ =  ' ' "
		cSql += " Inner Join " + cBR8Name + " BR8 "
		csql += " On "
		cSql += " BR8_FILIAL = '" + xFilial("BR8") + "' AND "
		cSql += " BR8_CODPAD = BD7_CODPAD AND "
		csql += " BR8_CODPSA = BD7_CODPRO AND "
		csql += " BR8_ODONTO != '1' AND "
		cSql += " BR8.D_E_L_E_T_ =  ' ' "
		cSql += " Where "
		cSql += " E2_FILIAL = '" + xfilial("SE2") + "' "
		cSql += " AND BD7_CODOPE = '" + (GuiasData)->CODOPE + "' "
		cSql += " AND BD7_CODLDP = '" + (GuiasData)->CODLDP + "' "
		cSql += " AND BD7_CODPEG = '" + (GuiasData)->CODPEG + "' "
		cSql += " AND BD7_NUMERO = '" + (GuiasData)->NUMERO + "' "
		cSql += " AND BD7_ORIMOV = '" + (GuiasData)->BD6_ORIMOV + "' "
		cSql += " AND BD7_SEQUEN = '" + (GuiasData)->BD6_SEQUEN + "' "
		cSql += " AND BD7_CODRDA = '" + cCodRDA + "' "
		cSql += " AND E2_CODRDA = '" + cCodRDA + "' "
		cSql += " AND E2.D_E_L_E_T_ =  ' ' "
		cSql += " Group By "
		cSql += " BD7_CODLDP, BD7_CODPEG, BD7_NUMERO, BD7_ORIMOV, BD7_SEQUEN, BD7_CODRDA "			
	endif

	//if ExistBlock("PLQRYTISS")
	//	cSql := ExecBlock("PLQRYTISS",.F.,.F.,{"1", cSql, cCodRDA, cdatPag, cCompeten, cPEGinSql })
	//endif
Return cSql

/*/{Protheus.doc} BuscaNrGuiPri
Método responsável por buscar o número da guia principal
@type method
@version 12.1.2510
@author zaar.goes
@since 31/07/2026
@param pGuiint, character, código da guia interna
@return character, número da guia principal
/*/
method BuscaNrGuiPri(pGuiint) class TransparenciaProtDetalheService
	local GuiasDataTmp		:= GetNextAlias()
	local cResult := ""

	BeginSql Alias GuiasDataTmp
		SELECT BE4.BE4_CODOPE, BE4.BE4_ANOINT, BE4.BE4_MESINT, BE4.BE4_NUMINT
			FROM %table:BE4% BE4
		WHERE
			BE4.BE4_FILIAL = %xFilial:BE4% AND
			BE4.BE4_CODOPE = %Exp:substr(pGuiint,01,4)% AND
			BE4.BE4_CODLDP = %Exp:substr(pGuiint,05,4)% AND
			BE4.BE4_CODPEG = %Exp:substr(pGuiint,09,8)% AND
			BE4.BE4_NUMERO = %Exp:substr(pGuiint,17,8)% AND	
			BE4.%NotDel%
	ENDSQL

	if ( (GuiasDataTmp)->(!eof()) )
		cResult := (GuiasDataTmp)->(BE4_CODOPE+BE4_ANOINT+BE4_MESINT+BE4_NUMINT)
	endif	
	(GuiasDataTmp)->(DbCloseArea())

return cResult

/*/{Protheus.doc} getTipoGuia
Método responsável por retornar o tipo da guia
@type method
@version 12.1.2510
@author zaar.goes
@since 31/07/2026
@param pTipGui, character, código do tipo da guia
@return numeric, código do tipo da guia no padrão PTU
/*/
method getTipoGuia(pTipGui) class TransparenciaProtDetalheService
	local cRet := 2

	do case
		case pTipGui == "01"
			cRet := 1
		case pTipGui == "02"
			cRet := 2
		case pTipGui == "05"
			cRet := 3
		case pTipGui == "06"
			cRet := 5
	endcase
return cRet

/*/{Protheus.doc} ifPls
Método responsável por retornar o valor informado ou o valor default caso esteja vazio
@type function
@version 12.1.2510
@author zaar.goes
@since 31/07/2026
@param cValor, character, valor informado
@param cDefault, character, valor default
@return character, valor informado ou valor default
/*/
static function ifPls(cValor, cDefault)
return iif(empty(cValor),cDefault,cValor)

/*/{Protheus.doc} getData
Método responsável por formatar a data no padrão AAAA-MM-DD
@type function
@version 12.1.2510
@author zaar.goes
@since 31/07/2026
@param pData, character, data no formato AAAAMMDD
@return character, data no formato AAAA-MM-DD
/*/
static function getData(pData)
	local cRet := ""

	if !empty(pData)
		cRet := substr(pData,1,4) + "-" + substr(pData,5,2) + "-" + substr(pData,7,2)
	endif	
return cRet

/*/{Protheus.doc} PerHorHesp
	(Retorna o percentual de horario especial)
	@type function
	@author Thiago Rodrigues
	@since 17/02/2023
	@version 12.1.2510
/*/
static function PerHorHesp(cCodope,cCodldp,cCodpeg,cNumero,cOrimov,cSequen,nPerbd6)
	local GuiasDataBD7:= GetNextAlias()
	local nRet     := nPerbd6 

	//Quando o horario especial é utilizado na cobrança é gravado no BD7
	if nRet == 0 
		BeginSql  Alias GuiasDataBD7
		SELECT 
			BD7_PRCHES
		FROM %table:BD7% BD7
		WHERE 
			BD7.BD7_FILIAL = %xFilial:BD7% 
			AND BD7.BD7_CODOPE = %Exp:cCodope%
			AND BD7.BD7_CODLDP = %Exp:cCodldp%
			AND BD7.BD7_CODPEG = %Exp:cCodpeg%
			AND BD7.BD7_NUMERO = %Exp:cNumero%
			AND BD7.BD7_ORIMOV = %Exp:cOrimov%
			AND BD7.BD7_SEQUEN = %Exp:cSequen%
			AND BD7.%NotDel%
		EndSql

		if !(GuiasDataBD7)->(eof())
			nRet := (GuiasDataBD7)->BD7_PRCHES
		endif 

		(GuiasDataBD7)->(DbCloseArea())
	endif	

Return nRet

/*/{Protheus.doc} dePara
Método responsável por buscar o código do procedimento no padrão TISS
@type function
@version 12.1.2510
@author zaar.goes
@since 31/07/2026
@param cCodPadO, character, código do procedimento no padrão Protheus
@param cCodProO, character, código do procedimento no padrão Protheus
@param cDatPro, character, data do procedimento
@param cCodRda, character, código do RDA
@param cTipGui, character, tipo da guia
@return array, array com o código do procedimento no padrão TISS, código do procedimento no padrão Protheus, tipo do procedimento e flag de geração de equipe
/*/
static function dePara(cCodPadO,cCodProO,cDatPro,cCodRda,cTipGui)
	local aProced	:= {}
	local cSql 		:= ""
	local cTpProc	:= ""
	local lAchou  	:= .f.
	Local lEquipe	:= BR8->(FieldPos("BR8_EQUIPE")) <> 0
	Local lGeraEquipe := .T.
	default cDatPro := ""
	default cCodRda := ""
	default cTipGui := ""

	if lPTUDEPARA
		aRet 		:= execBlock("PTUDEPARA",.F.,.F.,{cCodPadO,cCodProO,cDatPro,cCodRda})
		lAchou 	  	:= aRet[1]
		cCodPad 	:= aRet[2]
		cCodPro 	:= aRet[3]
	endif	

	if !lAchou
		cSql := " SELECT BR8_CODEDI, BR8_TPPROC  "
		if lEquipe
			cSql += ", BR8_EQUIPE"
		endif
		cSql += " FROM "+ cBR8Name+ " BR8 "
		cSql += " WHERE BR8_FILIAL = '"+xFilial("BR8")+"' "
		cSql += " AND BR8_CODPAD = '"+cCodPadO+"' "
		cSql += " AND BR8_CODPSA = '"+cCodProO+"' "
		cSql += " AND BR8.D_E_L_E_T_ = ' '
		dbUseArea(.T.,"TOPCONN",TCGENQRY(,,cSQL),"TrbBR8",.F.,.T.)

		if !lAchou
			aProced		:= PLGETPROC(cCodPadO,cCodProO)
			cCodPad 	:= aProced[2]
			cCodPro 	:= aProced[3]
		endif
		if !TrbBR8->(eof())
			cTpProc := TrbBR8->BR8_TPPROC
			if lEquipe
				lGeraEquipe := TrbBR8->BR8_EQUIPE <> "0"
			endif
			if !lAchou
				cCodPro := ifPls(TrbBR8->BR8_CODEDI,cCodPro)
			endif
		endif

		TrbBR8->(dbCloseArea())
	endif

	//Se não achou devolvo o original
	cCodPad := ifPls(cCodPad,cCodPadO)
	cCodPro := ifPls(cCodPro,cCodProO)

return {cCodPad,cCodPro,cTpProc,lGeraEquipe}

/*/{Protheus.doc} getFornecedor
Método responsável por buscar os dados do fornecedor do procedimento
@type method
@version 12.1.2510
@author zaar.goes
@since 31/07/2026
/*/
method getFornecedor(cTpProc,cCodPro) as json class TransparenciaProtDetalheService	
	local cPagNomFor := ""
	local cCnpjFor   := ""
	local cNumNFForn := ""
	local lOpmeGen	 := .f.
	local jProcFornec := nil as json

	//BR8 posicionada no metodo procedimentos
	if cTpProc == '5'
		cPagNomFor 	:= (GuiasData)->BX6_NOMFOR
		cCnpjFor 	:= (GuiasData)->BX6_CNPJFO
		cNumNFForn 	:= (GuiasData)->BX6_NNFFOR

		if (empty(cPagNomFor) .or. empty(cCnpjFor) .or. empty(cNumNFForn)) .and. !empty((GuiasData)->BD6_NFE)
			if SF1->(msSeek(xFilial("SF1") + alltrim((GuiasData)->BD6_NFE)))
				if empty(cNumNFForn)
					cNumNFForn := Padr(SF1->F1_DOC,20)
				endif
				if SA2->(msSeek(xFilial("SA2")+SF1->(F1_FORNECE+F1_LOJA)))
					if empty(cPagNomFor)
						cPagNomFor := SA2->A2_NOME
					endif
					if empty(cCnpjFor)
						cCnpjFor := SA2->A2_CGC
					endif
				endif
			endif
		endif


		lOpmeGen := alltrim(cOpmeGen) == cCodPro .OR. "19"+alltrim(cOpmeGen) == cCodPro //19 codigo depara para OPME

		if !empty(cNumNFForn) .OR. lOpmeGen			
			if !empty(cNumNFForn)
				jProcFornec := JsonObject():New()
                SetJsonChar(@jProcFornec,"cnpjFornecedor", ifPls(cCnpjFor,(GuiasData)->BD6_CPFRDA))
                SetJsonChar(@jProcFornec,"nomeFornecedorMatMed", ifPls(cPagNomFor,(GuiasData)->NOMRDA))
                SetJsonChar(@jProcFornec,"numeroNotaFiscalFornecedor", cNumNFForn)                
			endif
		endif
	endif

return jProcFornec

/*/{Protheus.doc} getSiglaConselho
Retorna a sigla do conselho regional
@type function
@author  Zaar Ribeiro
@since   17/08/2026
@version 12.1.2510
/*/
static function getSiglaConselho(cSgCnRg as character) as character
	local nPos as numeric
	local cSigConReg as character

	cSgCnRg := alltrim(cSgCnRg)	
	nPos := aScan(aMapConselho, {|aItem| aItem[1] == cSgCnRg})

	cSigConReg := iif(nPos > 0, aMapConselho[nPos][2], "10")
Return cSigConReg
/*/{Protheus.doc} salvarJsonEmArquivo
Salva o JSON gerado em um arquivo .json na pasta protheus_data/ptu/transparencia
@type method
@version 12.1.2510  
@author zaar.goes
@since 19/08/2026
@param jArqProtocolo, json, objeto json com os dados do protocolo
@param cCodRDA, character, código do RDA
@param cNumProtocolo, character, número do protocolo
@return logical, se o arquivo foi salvo com sucesso
/*/
method salvarJsonEmArquivo(jArqProtocolo as json, cCodRDA as character, cNumProtocolo as character) as logical class TransparenciaProtDetalheService
	local lSuccess := .T. as logical	
	local cCaminhoArquivo as character
	local cNomeArquivo as character
	local cJsonContent as character
	local nHandle
	
	// Criar a pasta se não existir
	iif(!existDir(cCaminhoBase), makeDir(cCaminhoBase), )
	
	// Montar nome do arquivo: codigoControleTransacao + número do protocolo
	cNomeArquivo := alltrim(self:cCodigoControleTransacao) + "_" + alltrim(cNumProtocolo) + ".json"
	cCaminhoArquivo := cCaminhoBase + "\" + cNomeArquivo
	
	// Obter conteúdo JSON
	cJsonContent := jArqProtocolo:toJson()
	
	// Salvar arquivo				
	nHandle := FCreate(cCaminhoArquivo)
	lSuccess := nHandle != -1
	
	if lSuccess
		FWrite(nHandle, cJsonContent)
		FClose(nHandle)					
	endif		
	
	// Adicionar arquivo à lista de salvos
	if lSuccess
		aAdd(self:aArquivosSalvos, cCaminhoArquivo)
	endif
		
	iif(!lSuccess, ::plsMensagem(cNumProtocolo, "Erro ao salvar arquivo JSON."),)
return lSuccess

/*/{Protheus.doc} compactarArquivos
Compacta todos os arquivos .json salvos em um arquivo .zip
@type method
@version 12.1.2510  
@author zaar.goes
@since 19/08/2026
@param cCodControle, character, código de controle da transação
@param cDataGeracao, character, data de geração da transação
@return logical, se o arquivo foi compactado com sucesso
/*/
method compactarArquivos(cCodControle, cDataGeracao) as character class TransparenciaProtDetalheService
    local lSuccess      := .F. as logical
	local cMsg			:= ""  as character
    local cCaminhoZip   := ""  as character
    local cNomeZip      := ""  as character
    local cArquivo      := ""  as character
    local i             := 0   as numeric
    local nRetZip       := 0   as numeric
    local aToZip        := {}  as array
    //local oExc          as object

	// Não há arquivos para compactar
	iif(Len(self:aArquivosSalvos) == 0, cMsg := "Nenhum arquivo para compactar.", )
	
	lSuccess := Empty(cMsg)	

	// Garante que o diretório exista
	if lSuccess
		lSuccess := ExistDir(cCaminhoBase)

		iif(!lSuccess,;
			iif(!MakeDir(cCaminhoBase), cMsg := "Não foi possível criar o diretório: " + cCaminhoBase, ),;
		)
		lSuccess := Empty(cMsg)
	endif

	// Nome do ZIP
	if lSuccess
		cNomeZip := limparData(cDataGeracao) + "_" + AllTrim(cCodControle) + ".zip"
		cCaminhoZip := cCaminhoBase + "\" + cNomeZip
	
		// Remove ZIP anterior, caso exista
		if File(cCaminhoZip)
			iif(FErase(cCaminhoZip) != 0, cMsg := "Não foi possível remover o ZIP existente: " + cCaminhoZip, )
			lSuccess := Empty(cMsg)
		endif
	endif

	if lSuccess
		// Monta lista de arquivos para o FZip
		for i := 1 to Len(self:aArquivosSalvos)
			cArquivo := self:aArquivosSalvos[i]
			iif(File(cArquivo), AAdd(aToZip, cArquivo), cMsg := "Arquivo não encontrado: " + cArquivo)
		next i

		// Verifica se encontrou arquivos
		iif(Len(aToZip) == 0, cMsg := "Nenhum arquivo encontrado para compactação.", )
		lSuccess := Empty(cMsg)
	endif

	// Compacta os arquivos
	if lSuccess
		nRetZip := FZip(cCaminhoZip, aToZip, cCaminhoBase)        

		// Valida criação do ZIP
		iif(nRetZip != 0, cMsg := "Falha ao compactar os arquivos. Código retorno FZip: " + cValToChar(nRetZip), )
		lSuccess := Empty(cMsg)
	endif

	if lSuccess
		iif(!File(cCaminhoZip), cMsg := "FZip retornou sucesso, porém o ZIP não foi encontrado. Caminho esperado: " + cCaminhoZip, )
		lSuccess := Empty(cMsg)
	endif

	// ZIP criado com sucesso	
	if lSuccess
		self:cCaminhoZipGerado := cCaminhoZip        

		// Só exclui os arquivos originais depois de confirmar
		// que o ZIP foi criado
		for i := 1 to Len(aToZip)
			cArquivo := aToZip[i]
			if File(cArquivo)
				iif(FErase(cArquivo) != 0, cMsg := "Não foi possível excluir: " + cArquivo, )
			endif
		next i
		lSuccess := Empty(cMsg)
	endif
return cMsg

/*/{Protheus.doc} getCaminhoZipGerado
Retorna o caminho do arquivo ZIP gerado
@type method
@version 12.1.2510  
@author zaar.goes
@since 19/08/2026
@return character, caminho completo do arquivo ZIP
/*/
method getCaminhoZipGerado() as character class TransparenciaProtDetalheService
return self:cCaminhoZipGerado

/*/{Protheus.doc} anexarZipResposta
Anexa o arquivo ZIP no header da resposta HTTP
@type method
@version 12.1.2510  
@author zaar.goes
@since 19/08/2026
@return logical, se o arquivo foi anexado com sucesso
/*/
method anexarZipResposta() as logical class TransparenciaProtDetalheService

    local lSuccess     := .F. as logical
    local cCaminhoZip  := "" as character
    local cNomeZip     := "" as character
    local cBuffer      := "" as character
    local nHandle      := -1 as numeric
    local nTamanho     := 0 as numeric
    local nLidos       := 0 as numeric
    local cBoundary    := "" as character
    local cBody        := "" as character
    local cCRLF        := "" as character
    //local oExc         as object

	// ------------------------------------------------------------
	// Caminho do ZIP gerado
	// ------------------------------------------------------------
	cCaminhoZip := self:cCaminhoZipGerado
	lSuccess := !Empty(cCaminhoZip)        		
	iif(!lSuccess, ::plsMensagem(self:cCaminhoZipGerado, "Caminho do ZIP não informado."),)

	// ------------------------------------------------------------
	// Verifica se o arquivo existe no AppServer
	// ------------------------------------------------------------
	if lSuccess
		lSuccess := File(cCaminhoZip)
		iif(!lSuccess, ::plsMensagem(cCaminhoZip, "ZIP não encontrado."),)
	endif

	// ------------------------------------------------------------
	// Obtém somente o nome do arquivo
	// ------------------------------------------------------------
	if lSuccess
		cNomeZip := SubStr(cCaminhoZip, Rat("\", cCaminhoZip) + 1)

		// ------------------------------------------------------------
		// Abre o arquivo para leitura.		
		// ------------------------------------------------------------
		nHandle := FOpen(cCaminhoZip)
	
		lSuccess := nHandle >= 0
		iif(!lSuccess, ::plsMensagem(cCaminhoZip, "Não foi possível abrir o ZIP. ";											
											+ " FError: " + cValToChar(FError())),)                    
	endif

	// ------------------------------------------------------------
	// Vai para o final do arquivo para descobrir o tamanho
	// ------------------------------------------------------------
	if lSuccess
		nTamanho := FSeek(nHandle,0,2)

		lSuccess := nTamanho > 0
		iif(!lSuccess, ::plsMensagem(cCaminhoZip, "Não foi possível obter o tamanho do ZIP."),)            
	endif

	// ------------------------------------------------------------
	// Volta para o início do arquivo
	// ------------------------------------------------------------
	if lSuccess
		FSeek(nHandle, 0)

		// ------------------------------------------------------------
		// Cria buffer com exatamente o tamanho do ZIP
		// ------------------------------------------------------------
		cBuffer := Space(nTamanho)

		// ------------------------------------------------------------
		// Lê os bytes do ZIP
		// ------------------------------------------------------------
		nLidos := FRead(;
			nHandle,;
			@cBuffer,;
			nTamanho;
		)
	endif

	// ------------------------------------------------------------
	// Fecha o arquivo
	// ------------------------------------------------------------
	FClose(nHandle)
	nHandle := -1

	// ------------------------------------------------------------
	// Confirma que todos os bytes foram lidos
	// ------------------------------------------------------------
	lSuccess := nLidos == nTamanho
	iif(!lSuccess,  ::plsMensagem(cCaminhoZip, "Leitura incompleta do ZIP. " ),)


	// ------------------------------------------------------------
	// Configura resposta HTTP como multipart/form-data
	// ------------------------------------------------------------
	if lSuccess
		cCRLF := Chr(13) + Chr(10)
		cBoundary := "protocolo"
		
		// Monta o body multipart/form-data com a parte "protocolo"
		cBody := "--" + cBoundary + cCRLF
		cBody += 'Content-Disposition: form-data; name="protocolo"; filename="' + cNomeZip + '"' + cCRLF
		cBody += "Content-Type: application/zip" + cCRLF + cCRLF
		cBody += cBuffer + cCRLF
		cBody += "--" + cBoundary + "--" + cCRLF

		// Define o Content-Type com boundary
		oRest:setKeyHeaderResponse(;
			"Content-Type",;
			"multipart/form-data; boundary=" + cBoundary;
		)

		oRest:setKeyHeaderResponse(;
			"Content-Length",;
			AllTrim(Str(Len(cBody)));
		)

		// Envia o body no formato multipart/form-data
		oRest:setResponse(cBody)

		lSuccess := .T.      
	endif
return lSuccess

static function limparData(cData as character) as character
    cData := StrTran(cData, "-", "")
    cData := StrTran(cData, ":", "")
    cData := StrTran(cData, " ", "")
return cData

/*/{Protheus.doc} TransparenciaProtocoloService::saveReceivedMessage
Salva recebimento da mensagem de pedido de protocolo
@type method
@version 12.1.2510
@author zaar.goes
@since 25/08/2026
@param cControle, character, Código de controle da transação
@param cDataGeracao, character, Data de Geração da transação
@param cCnpjCpf, character, CPF/CNPJ do prestador
@param cPrestador, character, Nome do prestador
@param cCompetencia, character, Competência solicitada
@return logical, retorno do método
/*/
method saveReceivedMessage(cControle as character, cDataGeracao as character, cCnpjCpf as character, cPrestador as character, cProtocolo as character) as logical class TransparenciaProtDetalheService
	local dData := Date() as date
	local cHora := Time() as character
	local cFilBIW := xFilial("BIW") as character
	local lOk := .F. as logical	
	local cStatus := "R" as character
	local cDataTmp := "" as character
	local cHoraTmp := "" as character

	If !Empty(cControle)		
		If !Empty(cDataGeracao)
			cDataGeracao := StrTran(cDataGeracao, "T", " ")
			cDataGeracao := StrTran(cDataGeracao, "Z", "")
			cDataGeracao := AllTrim(cDataGeracao)

			If Len(cDataGeracao) >= 10
				cDataTmp := SubStr(cDataGeracao, 1, 10)				
				dData := CToD( SubStr(cDataTmp, 9, 2) + "/" + SubStr(cDataTmp, 6, 2) + "/" + SubStr(cDataTmp, 1, 4) )				
			EndIf

			If Len(cDataGeracao) >= 16
				cHoraTmp := SubStr(cDataGeracao, 12, 8)
				If !Empty(cHoraTmp)
					cHora := cHoraTmp
				EndIf
			EndIf
		EndIf

		DbSelectArea("BIW")
		DbSetOrder(1)
		If !BIW->(MsSeek(cFilBIW + cControle))
			RecLock("BIW", .T.)
				BIW->BIW_FILIAL := cFilBIW
				BIW->BIW_CTRL   := alltrim(cControle)
				BIW->BIW_TPTRA  := "2"
				BIW->BIW_DATA   := dData
				BIW->BIW_HORA   := cHora
				BIW->BIW_CNPJ   := alltrim(cCnpjCpf)
				BIW->BIW_PREST  := alltrim(cPrestador)
				BIW->BIW_PROTO  := cProtocolo
				BIW->BIW_STATUS := cStatus				
			MsUnlock()
			lOk := .T.
		EndIf
	EndIf

return lOk

/*/{Protheus.doc} UpdateBIWMessage
Updates the BIW control record with the complete JSON processing message.
@type function
@version 12.1.2510
@author zaar.goes
@since 25/08/2026
@return logical, indicates whether the BIW record was updated
/*/
method UpdateBIWMessage(lSuccess as logical) as logical class TransparenciaProtDetalheService
	local aArea := GetArea() as array
	local cControle := "" as character
	local cFilBIW := xFilial("BIW") as character
	local cStatus := "" as character
	local cErro := "" as character
	local cNomeZip := "" as character
	local cMensagem := self:jRequestBody:ToJson()
	local lOk := .F. as logical
	local i := 1	

	If !Empty(cMensagem)		
		cControle := self:jRequestBody["cabecalho"]["codigoControleTransacao"]
		cStatus := iif(lSuccess, "S", "E")

		If len(self:aMensagens) > 0						
			for i := 1 to len(self:aMensagens)
				cErro += self:aMensagens[i] + chr(13)+chr(10)
			next
		EndIf

		if !empty(self:cCaminhoZipGerado)
			cNomeZip := SubStr(;
				self:cCaminhoZipGerado,;
				Rat("\", self:cCaminhoZipGerado) + 1;
			)
		endif

		DbSelectArea("BIW")
		DbSetOrder(1)
		If BIW->(MsSeek(cFilBIW + cControle))
			RecLock("BIW", .F.)
				BIW->BIW_FILIAL := cFilBIW
				BIW->BIW_PROTO  := cMensagem
				BIW->BIW_STATUS := cStatus
				BIW->BIW_ERRO   := cErro
				BIW->BIW_DTFIM  := Date()
				BIW->BIW_HRFIM  := Time()
				BIW->BIW_ARQZIP := cNomeZip
			MsUnlock()
			lOk := .T.
		EndIf
	EndIf

	RestArea(aArea)
return lOk

method plsMensagem(cId, cMensagem) as character class TransparenciaProtDetalheService
	local cMsg := "[" + cId + "] " + cMensagem
	aadd(self:aMensagens, cMsg)
return cMsg

function plsUseArea(lNewArea, cDriver, cFile, cAlias, lShared, lReadOnly)
	iif(Select(cAlias) > 0, (cAlias)->(DbCloseArea()), )
	dbUseArea(lNewArea,cDriver,cFile,cAlias,lShared,lReadOnly)	
return


//-------------------------------------------------------------------
/*/{Protheus.doc} getBKF
Retorna o código EDI da BKF
@type function
@version 12.1.2510
@author zaar.goes
@since 31/07/2026
@param cDatPro, character, data do procedimento
@return character, código EDI da BKF
/*/
static function getBKF(cDatPro)
	local cRet := ""
	local cSql as character
	local cCodPoA := alltrim(BD4->BD4_PORMED)
	local nPos := aScan(aPorteAne, {|aItem| aItem[1] == cCodPoA})

	iif(nPos > 0, cRet := aPorteAne[nPos][2], )

	if empty(cRet)
		cSql := " SELECT BKF_CODEDI, BKF_SEQPOR FROM " + cBKFName
		cSql += " WHERE BKF_FILIAL = '" + xfilial("BKF") + "'"
		cSql += " AND BKF_CODINT = '" + substr(BD4->BD4_CODTAB,1,4) + "'"
		cSql += " AND BKF_CODTAB = '" + substr(BD4->BD4_CODTAB,5,3) + "'"
		cSql += " AND BKF_SEQPOR = " + cvaltochar(BD4->BD4_VALREF)
		cSql += " AND ( ( BKF_VIGINI <= '" + (cDatPro) + "' AND BKF_VIGFIN >= '" + (cDatPro) + "') "
		cSql += "       OR ( BKF_VIGINI <= '" + (cDatPro) + "' AND BKF_VIGFIN = '        ') "
		cSql += "       OR ( BKF_VIGINI = '        ' AND BKF_VIGFIN <= '        ') ) "
		cSql += " AND D_E_L_E_T_ = ' ' "
		plsUseArea(.T.,"TOPCONN",TCGENQRY(,,cSql),"TrbBKF",.F.,.T.)

		if !TrbBKF->(eof())
			cRet := iif(!empty(TrbBKF->BKF_CODEDI), TrbBKF->BKF_CODEDI, Alltrim(cValToChar(TrbBKF->BKF_SEQPOR)))
		endif

		TrbBKF->(dbclosearea())
	endif

return cRet

/*/{Protheus.doc} getPacote
Retorna os procedimentos do pacote
@type function
@version 12.1.2510
@author zaar.goes
@since 31/07/2026
@param cAlias, character, alias da guia
@return array, array com os procedimentos do pacote
/*/
static function getPacote(cAlias)
	local aRet := {{.f.}}
	local cSql := ""
	Local lB43Qtd := B43->(FieldPos("B43_QTDPRO")) > 0

	cSql += " SELECT B43_CODPAD, B43_CODPRO, B43_NIVPAC, B43_DESPRO, B43_TIPO, B43_IDUNIC, B43_SEQPTU, R_E_C_N_O_ Recno " + iif(lB43Qtd,",B43_QTDPRO ","")
	cSql += " FROM " + cB43Name + " B43 "
	cSql += " WHERE  B43_FILIAL = '" + xfilial("B43") + "' "
	cSql += " AND B43_CODOPE = '" +  (cAlias)->CODOPE + "' "
	cSql += " AND B43_CODLDP = '" +  (cAlias)->CODLDP + "' "
	cSql += " AND B43_CODPEG = '" +  (cAlias)->CODPEG + "' "
	cSql += " AND B43_NUMERO = '" +  (cAlias)->NUMERO + "' "
	cSql += " AND B43_ORIMOV = '" +  (cAlias)->BD6_ORIMOV + "' "
	cSql += " AND B43_SEQUEN = '" +  (cAlias)->BD6_SEQUEN + "' "
	cSql += " AND B43_TIPO IN ('0','5') " //0=Procedimento;5=Ortese/Protese
	cSql += " AND B43.D_E_L_E_T_ = ' ' "
	plsUseArea(.T.,"TOPCONN",TCGENQRY(,,cSql),'TMPB43',.F.,.T.)

	while !TMPB43->(eof())
		if TMPB43->B43_TIPO == "0"
			BR8->(msseek(xFilial("BR8")+TMPB43->(B43_CODPAD+B43_CODPRO)))
			if BR8->BR8_TIPROL == "2"
				TMPB43->(dbskip())
				loop
			endif
		endif

		aadd(aRet,{TMPB43->B43_CODPAD, alltrim(TMPB43->B43_CODPRO), TMPB43->B43_DESPRO, TMPB43->B43_TIPO, TMPB43->B43_NIVPAC, TMPB43->B43_IDUNIC,;
			TMPB43->B43_SEQPTU, TMPB43->Recno,iif(lB43Qtd,TMPB43->B43_QTDPRO,0)})

		TMPB43->(dbskip())
	enddo

	TMPB43->(dbclosearea())

return aRet
