#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "health.plan.api.portal.callcenter.controller.ch"

#define STATUS_CODE_NOT_FOUND 404
#define STATUS_CODE_INVALID_PROTOCOL 403

namespace totvs.protheus.health.plan.api.portal.access

using namespace totvs.protheus.health.plan.api.util

/*/{Protheus.doc} CallCenterController
API protocolo de atendimento do call center
@type class
@version 12.1.2510  
@author luca.spiller
@since 17/11/2025
*/
class CallCenterController from BaseController

	public method new() constructor

    @POST("/totvsHealthPlans/portal/v1/protocols")
    public method apiPostProtocol()

	@POST("/totvsHealthPlans/portal/v1/protocols/close")
	public method apiPostCloseProtocol()
	
    @POST("/totvsHealthPlans/portal/v1/protocols/rdStationReference")
	public method apiPostRdStationReference()

	private method validateCallCenterAccess(jRequestData as json, aRequiredParams as array) as logical
	private method getCallCenterSubscriberId(cProtocol as character) as character

endclass

/*/{Protheus.doc} new
Construtor da classe CallCenterController.
@type method
@version 12.1.2510
@author luca.spiller
@since 17/11/2025
@return self, instancia da classe CallCenterController.
*/
method new() class CallCenterController

	_Super:new()

return self

/*/{Protheus.doc} apiPostProtocol
Recurso responsável por gerar um novo protocolo de atendimento de origem do call center
@type method
@version 12.1.2510
@author luca.spiller
@since 17/11/2025
/*/
method apiPostProtocol() class CallCenterController

	local oController as object
	local aRequiredData as array

	aRequiredData := {"subscriberId"}	

	if self:setBodyRequest(oRest:getBodyRequest()) .and. self:validateCallCenterAccess(self:getBodyRequest(), aRequiredData)
		oController := totvs.protheus.health.plan.api.callcenter.AttendanceProtocolController():new()
		oController:apiPostProtocols()
	endif

	fwFreeArray(aRequiredData)
	freeObj(oController)
	self:destroy()

return

/*/{Protheus.doc} apiPostCloseProtocol
Recurso responsável por encerrar um protocolo de atendimento em aberto.
@type method
@version 12.1.2510
@author luca.spiller
@since 17/11/2025
/*/
method apiPostCloseProtocol() class CallCenterController

	local oController as object
	local aRequiredData as array

	aRequiredData := {"protocol"}

	if self:setBodyRequest(oRest:getBodyRequest()) .and. self:validateCallCenterAccess(self:getBodyRequest(), aRequiredData)
		oController := totvs.protheus.health.plan.api.callcenter.AttendanceProtocolController():new()
		oController:apiPostCloseProtocol()
	endif

	fwFreeArray(aRequiredData)
	freeObj(oController)
	self:destroy()

return

/*/{Protheus.doc} apiPostRdStationReference
Recurso responsável por gerar um novo protocolo de atendimento de origem do call center
@type method
@version 12.1.2510
@author luca.spiller
@since 27/11/2025
/*/
method apiPostRdStationReference() class CallCenterController

	local oController as object
	local aRequiredData as array

	aRequiredData := {"protocolRD", "protocolANS"}

	if self:setBodyRequest(oRest:getBodyRequest()) .and. self:validateCallCenterAccess(self:getBodyRequest(), aRequiredData)
		oController := totvs.protheus.health.plan.api.callcenter.AttendanceProtocolController():new()
		oController:apiPostRdStationReference()
	endif

	fwFreeArray(aRequiredData)
	freeObj(oController)
	self:destroy()

return


/*/{Protheus.doc} validateCallCenterAccess
Valida se os dados da requisição contêm as informações necessárias para acessar a funcionalidade de calcenter.
@type method
@version 12.1.2510
@author luca.spiller
@since 25/11/2025
@param jRequestData, json, dados da requisição recebidos pela API
@param aRequiredParams, array, lista de parâmetros obrigatórios que devem estar presentes
@return logical, indica se os dados são válidos para acesso ao reembolso
/*/
method validateCallCenterAccess(jRequestData as json, aRequiredParams as array) as logical class CallCenterController

	local lHasAccess := .F. as logical
	local cSubscriberId as character
	local cSubscriberIdRD as character 
	local cSubscriberIdANS as character

 	if self:validateRequiredParams(jRequestData, aRequiredParams)
		if jRequestData:hasProperty("subscriberId") 
			cSubscriberId := jRequestData["subscriberId"]
		elseif jRequestData:hasProperty("protocol")
			cSubscriberId := self:getCallCenterSubscriberId(jRequestData["protocol"])
		elseif jRequestData:hasProperty("protocolRD") .and. jRequestData:hasProperty("protocolANS")
			cSubscriberIdRD  := self:getCallCenterSubscriberId(jRequestData["protocolRD"])
   			cSubscriberIdANS := self:getCallCenterSubscriberId(jRequestData["protocolANS"])
			if !empty(cSubscriberIdRD) .and. !empty(cSubscriberIdANS)
				if cSubscriberIdRD == cSubscriberIdANS
					cSubscriberId := cSubscriberIdRD
				else
					self:nStatusCode := STATUS_CODE_INVALID_PROTOCOL
					self:jResult["code"] := self:nStatusCode
					self:jResult["message"] := STR0003 // Protocolos ANS e RD nao pertencem ao mesmo beneficiario
					self:jResult["detailedMessage"] := STR0004 // Informe um protocolo valido que seja do mesmo beneficiario"
					self:setResponseData()
				endif
			endif 
		endif

		if !empty(cSubscriberId) .and. self:validatePortalUserAccess()
			lHasAccess := self:hasAccessToBeneficiary(cSubscriberId)
		endif
	endif

return lHasAccess

/*/{Protheus.doc} getCallCenterSubscriberId
Retorna o identificador do beneficiário associado ao procolo de callcenter informada.
@type method
@version 12.1.2510
@author luca.spiller
@since 25/11/2025
@param cProtocol, character, código do protocolo de callcenter
@return character, identificador do beneficiário vinculado ao protocolo
/*/
method getCallCenterSubscriberId(cProtocol as character) as character class CallCenterController

	local cSubscriberId as character
	local cQuery as character
	local nOrder := 1 as numeric
	local oExecStmt as object
	local cAlias as character

	cQuery += "SELECT ? "
	cQuery += " FROM ? B00 "
	cQuery += " WHERE B00.B00_FILIAL = ? AND "
	cQuery += "		B00.B00_COD = ? AND "
	cQuery += "		B00.D_E_L_E_T_ = ? "

	oExecStmt := FwExecStatement():new(cQuery)

	oExecStmt:setUnsafe(nOrder++, "B00.B00_MATRIC")
	oExecStmt:setUnsafe(nOrder++, retSqlName("B00"))
	oExecStmt:setString(nOrder++, xFilial("B00"))
	oExecStmt:setString(nOrder++, cProtocol)
	oExecStmt:setString(nOrder++, " ")

	cAlias := oExecStmt:openAlias()

	if !(cAlias)->(eof())
		cSubscriberId := alltrim((cAlias)->B00_MATRIC)
	else
		self:nStatusCode := STATUS_CODE_NOT_FOUND
		self:jResult["code"] := self:nStatusCode
		self:jResult["message"] := STR0001 // Protocolo de autorizacao nao encontrado.
		self:jResult["detailedMessage"] := STR0002 // Nenhum protocolo foi localizado na tabela B00. Verifique se o numero do protocolo esta correto e se ele foi previamente registrado.
		self:setResponseData()
	endif

	(cAlias)->(dbCloseArea())

	oExecStmt:destroy()
	freeObj(oExecStmt)

return cSubscriberId
