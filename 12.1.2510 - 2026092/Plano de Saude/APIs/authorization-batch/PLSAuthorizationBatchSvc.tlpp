#INCLUDE 'protheus.ch'
#INCLUDE 'restful.ch'

//-------------------------------------------------------------------
/*/{Protheus.doc} PLSAuthorizationBatchSvc

@author  Nicole Luna
@version P12
@since   29/01/2024
/*/
//------------------------------------------------------------------- 
class PLSAuthorizationBatchSvc

    Data oError as Object
  
    public method New()
    public method alteraLote(cLoteHat, cGuias, cContent)
    public method buscarGuias(cBatchCode)

endClass

method New() class PLSAuthorizationBatchSvc
Return self

//-------------------------------------------------------------------
/*/{Protheus.doc} alteraLote

@author    Nicole Luna
@version   V12
@since     29/01/2024
/*/
method alteraLote(cLoteHat, cGuias, cContent) class PLSAuthorizationBatchSvc

    local cQueryBEA     := ""
    local cQueryUpdate  := ""
    local cWhere        := ""
    local lSuccess      := .T.
    local lHasActive    := .F.
    local aGuias        := ""
    local nX            := 0

    default cLoteHat    := ""
    default cGuias      := ""
    default cContent    := ""

    if !empty(cGuias)
        aGuias := StrTokArr(cGuias,',')
        cWhere += " AND ( "
        for nX := 1 to len(aGuias)
            cWhere += "( BEA_OPEMOV = '" + Substr(aGuias[nX],2,4) + "' "
            cWhere += " AND BEA_ANOAUT = '" + Substr(aGuias[nX],6,4) + "' "
            cWhere += " AND BEA_MESAUT = '" + Substr(aGuias[nX],10,2) + "' "
            cWhere += " AND BEA_NUMAUT = '" + Substr(aGuias[nX],12,8) + "' "
            cWhere += ")" + iif(nX < len(aGuias)," OR ","")
        next
        cWhere += " ) "
    elseif !empty(cLoteHat)
        cWhere += " AND BEA_LOTHAT = '" +  cLoteHat + "'"
    endif

    //Se existem guias ativas, executa o UPDATE
    cQueryBEA := " SELECT BEA_LOTHAT FROM " + RetSqlName("BEA") 
    cQueryBEA += " WHERE BEA_FILIAL = '" + xFilial("BEA") + "' "
    cQueryBEA += cWhere
    cQueryBEA += " AND D_E_L_E_T_ = ' ' "
    
    dbUseArea(.T., "TOPCONN", tcGenQry(,,cQueryBEA), "cAliasBEA", .F., .T.)

    lHasActive := !cAliasBEA->(Eof())
    cAliasBEA->(dbCloseArea())

    if lHasActive
        begin transaction

			cQueryUpdate := " UPDATE " + RetsqlName("BEA") 
            cQueryUpdate += " SET BEA_LOTHAT = '" + cContent + "'"
            cQueryUpdate += " WHERE BEA_FILIAL = '" + xfilial("BEA") + "' "
            cQueryUpdate += cWhere
            cQueryUpdate += " AND D_E_L_E_T_ = ' ' "

            tcSqlExec( cQueryUpdate )

        end transaction
    endif

return lSuccess

//-------------------------------------------------------------------
/*/{Protheus.doc} buscarGuias

@author    Nicole Luna
@version   V12
@since     01/02/2024
/*/

Method buscarGuias(cBatchCode) class PLSAuthorizationBatchSvc

    Local cQuery := ""
    Default cBatchCode := ""

    cQuery := " SELECT BEA_OPEMOV+BEA_ANOAUT+BEA_MESAUT+BEA_NUMAUT AS NUMEROGUIA FROM " + RetSqlName("BEA") + " 
    cQuery += " WHERE BEA_FILIAL = '" + xFilial("BEA") + "' " 
    cQuery += " AND BEA_LOTHAT = '" + cBatchCode +  "'"
    cQuery += " AND D_E_L_E_T_ = ' ' "
	cQuery := PLSConSQL(cQuery)

Return cQuery
