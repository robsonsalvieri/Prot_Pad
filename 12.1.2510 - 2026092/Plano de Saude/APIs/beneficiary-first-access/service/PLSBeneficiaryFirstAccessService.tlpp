using namespace totvs.protheus.health.plans.api.util
//-------------------------------------------------------------------
/*/{Protheus.doc} PLSBeneficiaryFirstAccessService

@author    Daniel Silva
@version   V12
@since     11/01/2024
/*/
class PLSBeneficiaryFirstAccessService from CenRequest

	public Data oError as Object
	public Data oResult as Object
	public data oRest as object
	public data oJson as object
	public data lCriaAcesso as logical

	public method new() constructor
	public method validBenef()
	public method vldJson()
	public method setError()
	public method getError()
	public method getResult()
	public method setResult()
	public Method getStatusCode()
	public Method verificaCpfMingle()
	public Method GetBeneficiarySQL()
	public Method criaAcesso()
	public method getQryBA1(cCpf)
	public method searchUserWithoutEmail(cMatric,cCpf)
	public method setNewBSW(cLoginUsr,cMatric)
	public method getUserMingle(cUser,cPass)

endclass

//-------------------------------------------------------------------
/*/{Protheus.doc} new

@author    Daniel Silva
@version   V12
@since     11/01/2024
/*/
method new(oRest,jPathParams) class PLSBeneficiaryFirstAccessService

	_Super:New(oRest)
	::oRest := jPathParams
	self:oError    := JsonObject():new()
	self:oResult   := JsonObject():new()
	self:nStatus   := 200
	self:lCriaAcesso  := .F.

return self

//-------------------------------------------------------------------
/*/{Protheus.doc} metodos get set

@author    Daniel Silva
@version   V12
@since     11/01/2024
/*/

method getError() class PLSBeneficiaryFirstAccessService
return self:oError

method getResult() class PLSBeneficiaryFirstAccessService
return self:oResult:toJson()

method getStatusCode() class PLSBeneficiaryFirstAccessService
return self:nStatus

//-------------------------------------------------------------------
/*/{Protheus.doc} validBenef

@author    Daniel Silva
@version   V12
@since     11/01/2024
/*/
method validBenef() class PLSBeneficiaryFirstAccessService
	local cRet 		:= ''

	if(self:lSuccess)

		if self:lCriaAcesso
			cRet := self:criaAcesso()
		else
			cRet := self:verificaCpfMingle(self:oRest['cpf'])
		endIf
	
		if('criado com sucesso' $ cvaltochar(cRet)) 
			self:setResult(cRet)
		else 
			self:setError(400,'0001',nil,cRet)
		endif 
	endif

return 

//-------------------------------------------------------------------
/*/{Protheus.doc} vldJson

@author    Daniel Silva
@version   V12
@since     11/01/2024
/*/


Method vldJson() class PLSBeneficiaryFirstAccessService

	if (::oRest <> nil)
		if empty(::oRest['cpf'])
			self:setError(400,'0001',nil,"Atributo 'cpf' nao informado")
		endif

		//Modelo novo cria um registro na BSW e ja integra com o Mingle
		if !empty(self:oRest['email']) .And. !empty(self:oRest['birthDate']) .And. !empty(self:oRest['password'])
			self:lCriaAcesso  := .T.
		
		//Modelo antigo, apenas envia um e-mail para o beneficiário com o link de acesso
		else
			if !GetNewPar("MV_PLEMAIL", .F.)
				self:setError(400,'0001',nil,"Parametro MV_PLEMAIL desativado, não será possivel enviar e-mail ")
			endif

			if !FindFunction( "PLSNotifica") .or. !FWAliasInDic("BQ7")
				self:setError(400,'0001',nil,"Sistema desatualizado ou sem a tabela BQ7 criada")
			endif		

			oPLMailMsg := PLMailMessage():New()
			If !oPLMailMsg:Connect()
				self:setError(400,'0001',nil,"Parametrização de envio de e-mail invalida.")
			endif
		endIf
	else 
		self:setError(400,'0001',nil,"Informe o atributo 'cpf' no corpo da requisicao")
	endif 
	
Return

//-------------------------------------------------------------------
/*/{Protheus.doc} setError

@author    Daniel Silva
@version   V12
@since     11/01/2024
/*/

method setError(nStatus, cCode, cMessage, cDetailedMessage) class PLSBeneficiaryFirstAccessService

    Default nStatus  := 400
    Default cCode    := '0002'
    Default cMessage := 'Bad Request'
    Default cDetailedMessage := 'O servidor nao foi capaz de entender a solicitacao'

    self:oError['status'] := nStatus
    self:oError['code'] := cCode
    self:oError['message'] := cMessage
    self:oError['detailedMessage'] := cDetailedMessage
    self:nStatus  := nStatus
    self:lSuccess := .F.

return

//-------------------------------------------------------------------
/*/{Protheus.doc} setResult

@author    Daniel Silva
@version   V12
@since     11/01/2024
/*/

method setResult(cMsg) class PLSBeneficiaryFirstAccessService

    self:oResult['code'] := 200
    self:oResult['message'] := 'success'
	self:oResult['detailedMessage'] := cMsg

return

//-------------------------------------------------------------------
/*/{Protheus.doc} verificaCpfMingle

@author    Guilherme Bonni
@version   12.1.2410
@since     30/05/2025
/*/
method verificaCpfMingle(cCpf) class PLSBeneficiaryFirstAccessService
	Local cRet	:= ""
	Local oJson := JsonObject():New()

	cCpf := strtran( cCpf, ".","" ) // retira os pontos
	cCpf := strtran( cCpf, "-","" ) // retira os traços

	oJson:= self:GetBeneficiarySQL(cCpf)
	
	If oJson["subscriberId"] != ""
		If !Empty(oJson["email"]) .And. IsEMail(AllTrim(oJson["email"]))

			lRet := PIncLogin(oJson["subscriberId"],,,,cCpf,oJson["email"],.T.,.T.)
			
			If ValType(lRet) == 'L'
				cRet := STR0001 //"Login criado com sucesso! As informações de acesso foram enviados para o e-mail cadastrado"
			ElseIf ValType(lRet) == 'C' 		
				cRet := lRet
			EndIf	
		Else
			cRet := STR0002 //"Não existe e-mail cadastrado ou está incorreto no Beneficiário, entre em contato com a operadora"
		EndIf
	Else
		cRet := STR0003 //"Beneficiário não encontrado, entre em contato com a operadora"
	EndIf

Return cRet

//-------------------------------------------------------------------
/*/{Protheus.doc} GetBeneficiarySQL

@author    Guilherme Bonni
@version   12.1.2410
@since     05/06/2025
/*/
method GetBeneficiarySQL(cCpf) class PLSBeneficiaryFirstAccessService

	local aBindValues := {} as array
	local oExec as object
    Local cSql           := ""
    Local cAlias         := "BENEF"
    Local cSubscriberId  := ""
    Local cEmail         := ""
	Local cTypeUser      := ""
    Local oJson          := JsonObject():New()
	Local aRet           := {}
    
	aRet := self:getQryBA1(cCpf)
	cSql := aRet[1]
	aBindValues := aRet[2]

    cSql := BaseAdapter():bindValuesToQuery(cSql, aBindValues)

	fwFreeArray(aBindValues)

    cSql := ChangeQuery(cSql)

	oExec := FwExecStatement():new(cSql)

    cAlias := oExec:OpenAlias()

    oJson["subscriberId"] := ""
    oJson["email"]        := ""
	oJson["typeUser"]     := ""

    If !(cAlias)->(Eof())
        cSubscriberId := (cAlias)->BA1_CODINT + ;
                         (cAlias)->BA1_CODEMP + ;
                         (cAlias)->BA1_MATRIC + ;
                         (cAlias)->BA1_TIPREG + ;
                         (cAlias)->BA1_DIGITO

        cEmail 	  := AllTrim((cAlias)->BA1_EMAIL)
		cTypeUser := AllTrim((cAlias)->BA1_TIPUSU)

        oJson["subscriberId"] := cSubscriberId
        oJson["email"]        := cEmail
		oJson["typeUser"]     := cTypeUser
    EndIf

    (cAlias)->(DbCloseArea())

	oExec:destroy()
	freeObj(oExec)

Return oJson

//-------------------------------------------------------------------
/*/{Protheus.doc} criaAcesso

@author    sakai
@version   12.1.2410
@since     05/06/2025
/*/
method criaAcesso() class PLSBeneficiaryFirstAccessService
	
	Local cRet := ""
	Local cCpf := self:oRest['cpf']
	Local aRet := {}
	Local cBirthDate := StrTran(self:oRest['birthDate'],"-","")
	Local cMatric := ""
	Local cSql := ""
	Local lRet := .F.

	cCpf := strtran( cCpf, ".","" ) // retira os pontos
	cCpf := strtran( cCpf, "-","" ) // retira os traços

	aRet := self:getQryBA1(cCpf)
	cSql := aRet[1]
	aBindValues := aRet[2]

    cSql := BaseAdapter():bindValuesToQuery(cSql, aBindValues)

	fwFreeArray(aBindValues)
    cSql := ChangeQuery(cSql)
	oExec := FwExecStatement():new(cSql)
    cAlias := oExec:OpenAlias()

	// Verifica se a data de nascimento informada é igual a data de nascimento do beneficiário
    if !(cAlias)->(Eof()) 
		if Stod((cAlias)->BA1_DATNAS) == Stod(cBirthDate)
			cMatric := (cAlias)->BA1_CODINT + ;
					(cAlias)->BA1_CODEMP + ;
					(cAlias)->BA1_MATRIC + ;
					(cAlias)->BA1_TIPREG + ;
					(cAlias)->BA1_DIGITO

			aRet := self:searchUserWithoutEmail(cMatric, cCpf)
			if len(aRet) > 0
				lRet := self:setNewBSW(aRet[1],aRet[2])
				cRet := iif(lRet,STR0005,STR0006) //"Login criado com sucesso!"##"Nao foi possivel sincronizar a nova senha com o Mingle, entre em contato com a operadora."
			else
				xRet := PIncLogin(cMatric,,"3",,cCpf,self:oRest["email"],.T.,.T.,self:oRest["password"])
				if ValType(xRet) == 'L'
					cRet := STR0005 //"Login criado com sucesso!"
					BA1->(Dbsetorder(2)) //BA1_FILIAL+BA1_CODINT+BA1_CODEMP+BA1_MATRIC+BA1_TIPREG+BA1_DIGITO
					if BA1->(MsSeek(xFilial("BA1")+cMatric))
						BA1->(RecLock("BA1",.F.))
						BA1->(BA1_EMAIL) := Upper(self:oRest["email"])
						BA1->(MsUnlock())
					endIf

				elseIf ValType(xRet) == 'C'
					cRet := xRet
				endIf
			endIf
		else
			cRet := STR0007 //"Data de nascimento informada não confere com a data de nascimento do beneficiário"
		endIf
	else
		cRet := STR0003 //"Beneficiário não encontrado, entre em contato com a operadora"
	endIf
	(cAlias)->(DbCloseArea())

	oExec:destroy()
	freeObj(oExec)

return cRet

//-------------------------------------------------------------------
/*/{Protheus.doc} getQryBA1

@author    sakai
@version   12.1.2410
@since     05/06/2025
/*/
method getQryBA1(cCpf) class PLSBeneficiaryFirstAccessService

	Local cSql := ""
	Local aBindValues := {}
	Local cDtAtual := Dtos(dDataBase) 

	cSql += " SELECT ? "
	cSql += "	FROM ? BA1 "
    cSql += " WHERE  "
    cSql += " BA1.BA1_FILIAL = ? AND "
    cSql += " BA1.BA1_CPFUSR = ? AND "
    cSql += " ( BA1.BA1_DATBLO = '' OR BA1.BA1_DATBLO > ? ) AND "
    cSql += " BA1.D_E_L_E_T_ = ' ' "

	aAdd(aBindValues, {"set": "unsafe", "value": "BA1.BA1_CODINT, BA1.BA1_CODEMP, BA1.BA1_MATRIC, BA1.BA1_TIPREG, BA1.BA1_DIGITO, BA1.BA1_EMAIL, BA1.BA1_TIPUSU, BA1.BA1_DATNAS "})
    aAdd(aBindValues, {"set": "unsafe", "value": retSqlName("BA1")})
    aAdd(aBindValues, {"set": "string", "value": xFilial("BA1")})
	aAdd(aBindValues, {"set": "string", "value": cCpf})
    aAdd(aBindValues, {"set": "string", "value": cDtAtual})

Return {cSql,aBindValues}

//-------------------------------------------------------------------
/*/{Protheus.doc} searchUserWithoutEmail

@author    sakai
@version   12.1.2410
@since     05/06/2025
/*/
method searchUserWithoutEmail(cMatric, cCpf) class PLSBeneficiaryFirstAccessService

	Local cQuery := ""
	Local oExecStmt := nil
	Local nOrder := 1
	Local cAlias := ""
	Local aRet := {}

	default cMatric := ""
	default cCpf 	:= ""

	cQuery := " SELECT ? "
	cQuery += " FROM ? BSW "
	cQuery += " INNER JOIN ? B49 ON "
	cQuery += " B49.B49_FILIAL = ? AND "
	cQuery += " B49.B49_CODUSR = BSW.BSW_CODUSR AND "
	cQuery += " B49.B49_BENEFI = ? AND "
	cQuery += " B49.D_E_L_E_T_ = ? "
	cQuery += " WHERE "
	cQuery += " BSW.BSW_FILIAL = ? AND "
	cQuery += " (BSW.BSW_LOGUSR = ? OR BSW.BSW_LOGUSR = ? ) AND "
	cQuery += " BSW.BSW_EMAIL = ? AND "
	cQuery += " BSW.D_E_L_E_T_ = ? "

	oExecStmt := FwExecStatement():new(cQuery)

	oExecStmt:setUnsafe(nOrder++, "BSW.BSW_LOGUSR, B49.B49_BENEFI")
	oExecStmt:setUnsafe(nOrder++, retSqlName("BSW"))
	oExecStmt:setUnsafe(nOrder++, retSqlName("B49"))
	oExecStmt:setString(nOrder++, xFilial("B49"))
	oExecStmt:setString(nOrder++, cMatric)
	oExecStmt:setString(nOrder++, " ")
	oExecStmt:setString(nOrder++, xFilial("BSW"))
	oExecStmt:setString(nOrder++, cMatric)
	oExecStmt:setString(nOrder++, cCpf)
	oExecStmt:setString(nOrder++, " ")
	oExecStmt:setString(nOrder++, " ")

	cAlias := oExecStmt:openAlias()
	if !(cAlias)->(eof())
		aRet := {(cAlias)->BSW_LOGUSR, (cAlias)->B49_BENEFI}
	endif

	(cAlias)->(dbCloseArea())

	oExecStmt:destroy()
	freeObj(oExecStmt)

return aRet

//-------------------------------------------------------------------
/*/{Protheus.doc} setNewBSW

@author    sakai
@version   12.1.2410
@since     05/06/2025
/*/
method setNewBSW(cLoginUsr,cMatric) class PLSBeneficiaryFirstAccessService

	Local lRet := .F.
	Local cSenhaOrg := ""

	BSW->(DbSetOrder(1)) //BSW_FILIAL+BSW_LOGUSR
	if BSW->(MsSeek(xFilial("BSW")+cLoginUsr))

		cSenhaOrg := SHA256(Trim(self:oRest["password"]))
		PLStoragePass(cSenhaOrg,BSW->BSW_LOGUSR,BSW->BSW_CODUSR)

		lRet := self:getUserMingle(BSW->BSW_LOGUSR,cSenhaOrg)

		if lRet
			BSW->(RecLock("BSW",.F.))
			BSW->(BSW_EMAIL) := Upper(self:oRest["email"])
			BSW->(BSW_SENHA) := cSenhaOrg
			BSW->(MsUnlock())

			BA1->(Dbsetorder(2)) //BA1_FILIAL+BA1_CODINT+BA1_CODEMP+BA1_MATRIC+BA1_TIPREG+BA1_DIGITO
			if BA1->(MsSeek(xFilial("BA1")+cMatric))
				BA1->(RecLock("BA1",.F.))
				BA1->(BA1_EMAIL) := Upper(self:oRest["email"])
				BA1->(MsUnlock())
			endIf
		endIf
	endIf

return lRet

//-------------------------------------------------------------------
/*/{Protheus.doc} getUserMingle

@author    sakai
@version   12.1.2410
@since     05/06/2025
/*/
method getUserMingle(cUser,cPass) class PLSBeneficiaryFirstAccessService

	local oJson := JsonObject():New()
	local oJsonRet := JsonObject():New()
	local oMingle := nil
	local cUrl := GetNewPar("MV_MINGURL","")
	local aHeader := {}
	local nX := 0
	local nOpc := 0
	local lRet := .F.
	
	aAdd(aHeader,"x-mingle-integrator-auth: " + GetNewPar("MV_MINGTOK",""))
	aAdd(aHeader,'Content-Type: application/json')

	oJson["integratorUser"] := GetNewPar("MV_MINGIUS","")	
	oJson["applicationUsers"] := {}
	aAdd(oJson["applicationUsers"], JsonObject():new())
	oJson['applicationUsers'][1]['login'] := Alltrim(cUser)
	oJson['applicationUsers'][1]['password'] := Alltrim(cPass)

	oMingle := FWRest():New(cUrl)
	oMingle:setPath("/api/api/v1/data/musers-public")
	oMingle:SetPostParams(oJson:toJson())
	oMingle:Post(aHeader)

	if oMingle:oResponseH:cStatusCode $ "200/201/202"
		oJsonRet:fromJson(oMingle:GetResult())
		for nX := 1 to Len(oJsonRet["applicationUsers"])
			nOpc := iif(Upper(oJsonRet["applicationUsers"][nX]["Error"]) == Upper("Login must be unique"),K_Alterar,K_Incluir)
			lRet := PLMINGCRUD(nOpc, BSW->BSW_LOGUSR, cPass , "3", .F.)
		next
	endif

return lRet
