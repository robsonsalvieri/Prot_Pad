#Include "PROTHEUS.CH"
#Include "TOTVS.CH"
#Include 'tlpp-core.th'
#Include 'tlpp-rest.th'

//-------------------------------------------------------------------
/*/{Protheus.doc} PlsGetSpecialityData


@author  Carolina Médici
@version P12
@since   24/07/2026
@see     PLSTotvsSign
/*/
//-------------------------------------------------------------------
@Get("/totvshealthplans/v1/specialityData")
Function PlsGetSpecialityData()

    Local aData         := {}   
    Local jResponse     as json  
    Local cQuery        := ""
    Local cAliasTemp    := ""
    local jItem as Json
    Local oQryParam     := oRest:getQueryRequest()
    Local nElapTime     := 0
    Local nStatus    := 200 as numeric

    jResponse := JsonObject():new()
    cAliasTemp := GetNextAlias()  

    If ValType(oQryParam) == "J" .And. oQryParam:HasProperty("elapTime")
        nElapTime := Val(cValToChar(oQryParam["elapTime"]))
    EndIf

    cQuery := "SELECT BAQ.BAQ_FILIAL, BAQ.BAQ_CODINT, BAQ.BAQ_CODESP, BAQ.BAQ_DESCRI, BAQ.BAQ_CBOS, BAQ.BAQ_DESCBO, BAQ.S_T_A_M_P_"
    cQuery += " FROM " + RetSqlName("BAQ") + " BAQ "
    cQuery += " WHERE BAQ.BAQ_FILIAL = '" + xFilial("BAQ") + "'"
    cQuery += "   AND BAQ.D_E_L_E_T_ = ' '"
    
    If nElapTime > 0
        cQuery += "   AND BAQ.S_T_A_M_P_ >= " + getStamp(nElapTime)
    EndIf
  
    dbUseArea(.T., "TOPCONN", tcGenQry(,,cQuery), cAliasTemp, .F., .T.)
    
    while !(cAliasTemp)->(Eof())        
        jItem := JsonObject():new()
        jItem["branch"]                 := AllTrim((cAliasTemp)->BAQ_FILIAL)
        jItem["providerCode"]           := AllTrim((cAliasTemp)->BAQ_CODINT)
        jItem["especialityCode"]        := AllTrim((cAliasTemp)->BAQ_CODESP)
        jItem["description"]            := AllTrim((cAliasTemp)->BAQ_DESCRI)
        jItem["cboCode"]                := AllTrim((cAliasTemp)->BAQ_CBOS) 
        jItem["cboDescription"]         := AllTrim((cAliasTemp)->BAQ_DESCBO)    
        
		AAdd(aData, jItem)
        (cAliasTemp)->(DBSKIP())
    EndDo

    (cAliasTemp)->(DbCloseArea())
    
    jResponse["items"]          := aData
    jResponse["totalRecords"]   := Len(aData)   

    oRest:appendKeyHeaderResponse("Content-Type", "application/json")
    oRest:setStatusCode(nStatus)
    oRest:setResponse(jResponse:toJson())
    fwFreeArray(aData)
Return 


static function getStamp(nHoras)
local cDBType := TCGetDB()
local cStringHoras := cValToChar(nHoras)

cSql := iif(cDBType $ "ORACLE|DB2", " (SYS_EXTRACT_UTC(systimestamp)  - INTERVAL '"+cStringHoras+"' HOUR)  ",iif(cDBType == "POSTGRES"," (current_timestamp - interval'"+cStringHoras+" hours') ", " (DATEADD(HOUR, -"+cStringHoras+", GETUTCDATE())) ")) 

return cSql

