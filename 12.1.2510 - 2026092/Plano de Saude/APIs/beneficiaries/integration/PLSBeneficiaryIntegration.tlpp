#Include 'tlpp-core.th'
#Include 'tlpp-rest.th'
#Include "FWLIBVERSION.CH"

//-------------------------------------------------------------------
/*/{Protheus.doc} PLSBeneficiaryIntegration
Integração PLS x HAT
Busca beneficiários que foram alterados a partir de um determinado tempo (lookbackDays), retornando os campos solicitados (fields).

@author  Nicole Luna
@version P12
@since   22/07/2026

/*/
//-------------------------------------------------------------------

@Get("/totvshealthplans/v1/beneficiarySynchronization")
function beneficiarySynchronization()
    Local oRequest  := PLSBeneficiaryIntegration():new(oRest,'beneficiarySynchronization')

    oRequest:valida()
    oRequest:procGet()
    oRequest:endRequest()

return

class PLSBeneficiaryIntegration from CenRequest 

    Public Method new()
    Public Method procGet()
    Public Method valida()
    Public Method getDate(cDias)

    Public data aHeader
    Public data nIndexFile
    Public data nIndexData
    
endClass

Method New(oRest, cApi) class PLSBeneficiaryIntegration
    _Super:new(oRest, cApi, .T.)
Return self

Method procGet() class PLSBeneficiaryIntegration
    Local cSql    := ''
    Local cAlias  := GetNextAlias()
    local nX      := 1

    if self:lSuccess      
        self:oRespBody["items"] := {}

        cSql := " SELECT "
        cSql += " BA1_CODINT, BA1_CODEMP, BA1_MATRIC, BA1_TIPREG, BA1_DIGITO, BA1_CPFUSR, " 
        cSql += " BA1_MATANT, BA1_MATVID, BA1_NOMUSR, BA1_NOMSOC, BA1_DATNAS, BA1_SEXO, "
        cSql += " BA1_PESO, BA1_ALTURA, BA1_DATINC, BA1_DTVLCR "
        cSql += " FROM " + RetSQLName("BA1") 
        cSql += " WHERE BA1_FILIAL = '" + xFilial("BA1") + "' "
        cSql += " AND ("
        cSql += "   BA1_DATINC = " + self:getDate(self:jRequest[ 'lookbackDays' ])
        cSql += "   OR BA1_DATBLO = " + self:getDate(self:jRequest[ 'lookbackDays' ])
        cSql += "   OR BA1_DATALT = " + self:getDate(self:jRequest[ 'lookbackDays' ])
        cSql += "   )"
        cSql += " AND D_E_L_E_T_ = ' ' "

        dbUseArea(.T.,"TOPCONN",TcGenQry(,,cSql),cAlias,.T.,.F.)

        while !(cAlias)->(eof())
	    	aadd(self:oRespBody["items"], jsonObject():new())
            self:oRespBody["items"][nX]['healthInsurerId'] := (cAlias)->BA1_CODINT
            self:oRespBody["items"][nX]['companyId'] := (cAlias)->BA1_CODEMP 
            self:oRespBody["items"][nX]['subscriberId'] := (cAlias)->BA1_MATRIC 
            self:oRespBody["items"][nX]['recordType'] := (cAlias)->BA1_TIPREG 
            self:oRespBody["items"][nX]['digit'] := (cAlias)->BA1_DIGITO
            self:oRespBody["items"][nX]['holderCPF'] := (cAlias)->BA1_CPFUSR
            self:oRespBody["items"][nX]['oldSubscriberId'] := AllTrim((cAlias)->BA1_MATANT)
            self:oRespBody["items"][nX]['lifeRecord'] := (cAlias)->BA1_MATVID
            self:oRespBody["items"][nX]['name'] := AllTrim((cAlias)->BA1_NOMUSR)
            self:oRespBody["items"][nX]['socialName'] := AllTrim((cAlias)->BA1_NOMSOC)
            self:oRespBody["items"][nX]['birthdate'] := (cAlias)->BA1_DATNAS
            self:oRespBody["items"][nX]['gender'] := (cAlias)->BA1_SEXO
            self:oRespBody["items"][nX]['weight'] := (val((cAlias)->BA1_PESO) / 1000) 
            self:oRespBody["items"][nX]['height'] := (cAlias)->BA1_ALTURA
            self:oRespBody["items"][nX]['effectiveDate'] := (cAlias)->BA1_DATINC
            self:oRespBody["items"][nX]['cardExpiration'] := (cAlias)->BA1_DTVLCR
	    	(cAlias)->(dbSkip())
            nX++
	    enddo 

        (cAlias)->(dbclosearea())
        self:cResponse := self:oRespBody:tojson()
    endif

Return 

Method valida() class PLSBeneficiaryIntegration
    local cFields   := ''

    self:jRequest   := oRest:getQueryRequest()

    if self:lSuccess
        if empty(cvaltochar(self:jRequest[ 'lookbackDays' ]))  
            cFields += iif(!empty(cFields),',','')+"'lookbackDays'"
        endif   

        if empty(cvaltochar(self:jRequest[ 'fields' ]))  
            cFields += iif(!empty(cFields),',','')+"'fields'"
        endif   

        if !empty(cFields)
            self:nFault       := 400
            self:cFaultDesc   := "Campo(s) obrigatório(s) não informado(s): " + cFields
            self:cFaultDetail := cFields
            self:lSuccess     := .F.
        endIf         
    endIf
Return 

Method getDate(cDias) class PLSBeneficiaryIntegration
    Local cDBType := TCGetDB()
    Local cSql := ""

    Do Case
    Case cDBType $ "ORACLE|DB2"
        cSql := "TO_CHAR(TRUNC(SYSDATE-" + cDias + "), 'YYYYMMDD')"

    Case cDBType == "POSTGRES"
        cSql := "TO_CHAR(CURRENT_DATE - INTERVAL '" + cDias + " day', 'YYYYMMDD')"

    Otherwise // SQL Server
        cSql := "CONVERT(VARCHAR(8), DATEADD(DAY,-" + cDias + ",GETDATE()),112)"
    EndCase

Return cSql
