#INCLUDE "TOTVS.CH"

//-------------------------------------------------------------------
/*/{Protheus.doc} PLSProcGroupAuthSvc

@author    Sakai
@version   V12
@since     15/12/2025
/*/
//-------------------------------------------------------------------
class PLSProcGroupAuthSvc From PLSProcAuthSvc

    public data oRest as object
    public data oJson as object

    public method new(oRest) constructor
    public method valida()
    public method authorization()
    public method destroy()

endclass

//-------------------------------------------------------------------
/*/{Protheus.doc} new

@author    Sakai
@version   V12
@since     15/12/2025
/*/
//-------------------------------------------------------------------
method new(oRest) class PLSProcGroupAuthSvc

    self:oRest := oRest
    self:oJson := jsonObject():new()

return self

//-------------------------------------------------------------------
/*/{Protheus.doc} valida

@author    PLSTEAM
@version   V12
@since     12/05/2022
/*/
//-------------------------------------------------------------------
method valida() class PLSProcGroupAuthSvc
 
    local lRet      := .F.
    local lHasCheck := .F.
    local nI        := 1
    local oError    := jsonObject():new()
    local cError    := self:oJson:fromJson(self:oRest:getContent())
    local cProper   := ''
    local aBody     := {  "ansRegistry", "journey", "authorizationStatus", "locationCode", "attendanceLocation", "beneficiary",;
                        "healthProvider", "professional", "procedures" }

    lRet := iIf( empty(cError), .T., .F.)

    if lRet
        for nI := 1 to len(aBody)            
            if self:oJson[aBody[nI]] == nil
                cProper += aBody[nI] + ', '
            endIf
        next

        if !empty(cProper)
            cError := 'Verifique o BODY da api [' + left(cProper, len(cProper) - 2) + ']'
            lRet   := .f.
        else   
            if len(self:oJson['procedures']) == 0
                cError  := 'Infome ao menos um evento'
                lRet    := .f.
            else
                for nI := 1 to len(self:oJson['procedures'])
                    if Valtype(self:oJson['procedures',nI,'groupValidation'] ) == "L" .And. ;
                       self:oJson['procedures',nI,'groupValidation'] .And. ;
                       Valtype(self:oJson['procedures',nI,'status'] ) == "N" .And. ;
                       self:oJson['procedures',nI,'status'] == -1
                        lHasCheck := .T.
                    endIf                    
                next

                if !lHasCheck
                    cError  := 'Nao ha eventos com os atributos <groupValidation> ativo e <status> = -1'
                    lRet    := .f.
                endif
            endIf
        endIf
    endIf

    if !lRet
        oError['hasError']     := .t.
        oError['errorMessage'] := cError
        self:oRest:setResponse(encodeUTF8(oError:toJSon()))
    endIf

    FreeObj(oError)
    oError := nil

return lRet

//-------------------------------------------------------------------
/*/{Protheus.doc} authorization

@author    Sakai
@version   V12
@since     15/12/2025
/*/
//-------------------------------------------------------------------
method authorization() class PLSProcGroupAuthSvc

    local lRet := .T.
    local oDao := PLSProcGroupAuthDao():new(self:oJson)
    
    self:oRest:setResponse(encodeUTF8(oDao:authorization()))

    FreeObj(oDao)
    oDao := nil

return lRet

//-------------------------------------------------------------------
/*/{Protheus.doc} destroy

@author    Sakai
@version   V12
@since     15/12/2025
/*/
//-------------------------------------------------------------------
method destroy() class PLSProcGroupAuthSvc

    FreeObj(self:oJson)
    self:oJson := nil

return
