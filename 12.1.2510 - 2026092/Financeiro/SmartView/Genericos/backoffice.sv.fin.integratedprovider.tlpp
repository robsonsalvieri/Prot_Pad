//-------------------------------------------------------------------
/*/{Protheus.doc} completeData
    Complementa o jData com dados do schema que ainda n„o foram preenchidos, 
    permitindo que o objeto de negÛcio manipule apenas campos calculados
    e os demais campos da query sejam preenchidos no jData automaticamente.

    Quando o objeto est· configurado para permitir filtro de Smart View, 
    pode-se concluir que os campos que n„o permitem filtro s„o campos calculados
    e n„o devem ser preenchidos automaticamente.
    Quando o objeto est· configurado para n„o permitir filtro de Smart View
    em nenhum campo, todos os campos estar„o configurados com lCanFilter = falso, 
    ent„o n„o temos como saber o campo È calculado ou n„o. Nesse caso, todos os campos
    calculados j· devem estar devidamente preenchidos no jData quando completeData() for 
    invocado, caso contr·rio o sistema vai apresentar error.log ao tentar preencher no 
    jData uma propriedade que n„o È um campo retornado pela query.

    A estrutura das propriedades elegiveis para autopreenchimento (self:oSchema:getProperties(),
    filtrada por lCalcField/lCustomField/lListedField) nao muda durante uma mesma requisicao,
    por isso e resolvida uma unica vez e reaproveitada nas linhas seguintes, evitando
    recalcular os getters de SchemaProperty a cada registro (padrao N+1).

    @author guilherme.sordi@totvs.com.br
    @since 24/10/2023
    @version 12.1.2310
*/
//-------------------------------------------------------------------
method completeData() class FinIntegratedProvider
    local aProperties := {} as array
    local nX := 1 as numeric
    local cPropertyId := "" as character
    local cType := "" as character
    local cRealName := "" as character
    local lCanFilter := .F. as logical
    local lCustomField := .F. as logical
    local lListedField := .F. as logical
    local lCalcField := .F. as logical
    local oProperty as object
    local aField as array

    if self:aCompleteDataFieldsCache == NIL
        aProperties := self:oSchema:getProperties()
        self:nSchemaPropertiesCount := len(aProperties)
        self:aCompleteDataFieldsCache := {}

        for nX := 1 to len(aProperties)
            oProperty := aProperties[nX]
            cPropertyId := oProperty:getName()        
            cType := oProperty:getType()
            cRealName := oProperty:getRealName()
            lCanFilter := oProperty:getCanFilter()
            lCustomField := oProperty:getCustomField()

            lListedField := empty(self:cFieldsToCompleteData) .or. (cRealName $ self:cFieldsToCompleteData)

            if self:lAllowSmartViewFilter
                lCalcField := !lCanFilter
            else
                lCalcField := .F.
            endIf

            if !lCalcField .and. !lCustomField .and. lListedField
                aAdd(self:aCompleteDataFieldsCache, { cPropertyId, cType, cRealName })
            endIf
        next nX
    endIf

    for nX := 1 to len(self:aCompleteDataFieldsCache)
        aField := self:aCompleteDataFieldsCache[nX]
        if !self:jData:hasProperty(aField[1])
            self:addToData(aField[1], aField[2], aField[3])
        endIf
    next nX

return


//-------------------------------------------------------------------
/*/{Protheus.doc} setCompleteData
    @author guilherme.sordi@totvs.com.br
    @since 24/10/2023
    @version 12.1.2310
*/
//-------------------------------------------------------------------
method setCompleteData(lEnable as logical) class FinIntegratedProvider
    self:lEnableCompleteData := lEnable
return


