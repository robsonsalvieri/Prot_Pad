#include "totvs.ch"
#include "msobject.ch"
#include "tlpp-rest.th"
#include "tlpp-core.th"
#include "totvs.framework.treports.integratedprovider.th"
#include "backoffice.sv.fin.generalaccountsreceivablestatus.ch"


namespace totvs.protheus.backoffice.fin.smartview.integratedprovider

@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGAFIN", tables="SE1,FK1,FK6,SC5,SC6,FRV", name="Posição Geral do Contas a Receber", country="ALL")

//-------------------------------------------------------------------
/*/{Protheus.doc} GeneralAccountsReceivableStatusReportSmartViewBusinessObject
    Classe para criação do Objeto de Negócio para geração da Posição geral do contas a receber

    @author Guilherme de Paula Santos
    @since 23/11/2023
    @version 12.1.2310
*/
//-------------------------------------------------------------------
class GeneralAccountsReceivableStatusReportSmartViewBusinessObject from totvs.protheus.backoffice.fin.smartView.integratedProvider.FinIntegratedProvider
    public method new() as object

    protected data oQueryTitulos as object
    protected data oQueryBaixas as object
    protected data oQueryVendas as object
    protected data oQueryFatMes as object
    protected data oQueryProvAbat as object

    protected data cChequeTypes as character
    protected data lTemGEM as logical
    protected data lGateAbat as logical

    protected data nListpostingsby      as numeric
    protected data dIssueDateFrom       as date
    protected data dIssueDateTo         as date
    protected data nCurrency            as numeric
    protected data lListarOutrasMoedas  as logical
    protected data cInitialprefix       as character
    protected data cFinalprefix         as character
    protected data dFromDueDate         as date
    protected data dToDueDate           as date
    protected data jRelationSE1SC5      as json

    public method getData() as object
    protected method initializeBusinessObject()
    
    protected method mySetSchema()
    protected method loadParameters()

    protected method getListaDeTitulos()
    protected method getListaDeBaixas()
    protected method getListaDePedidosDeVendas()
    protected method getListaDeFaturamentoNoMes()
    protected method getListaDeProvisoriosEAbatimentos()

    protected method setDataListaDeTitulos()                    as object
    protected method setDataListaDeBaixas()                     as object
    protected method setDataListaDePedidosDeVendas()            as object
    protected method setDataListaDeFaturamentoNoMes()           as object
    protected method setDataListaDeProvisoriosEAbatimentos()    as object

    protected method getAgingCode() as numeric
    protected method getAgingText() as character
    protected method getSalesOrderAgingCode() as numeric
    protected method getSalesOrderAgingText() as character
    protected method getTypeOfBillCode() as numeric
    protected method getTypeOfBillText() as character
    protected method getCategoryText() as character
    protected method getSaleTypeCode() as numeric
    protected method getSaleTypeText() as character
    protected method getTypeSeparator() as character
    protected method hasWithholdingTax() as logical
    protected method getNotInTypeTitle()
    protected method changeCanFilter()
    protected method filterWithRelationOfSC5() as character


endclass

//-------------------------------------------------------------------
/*{Protheus.doc} new
    Método de instância da classe

    @return object: self

    @author Guilherme de Paula Santos
    @since 23/11/2023
    @version 12.1.2310
*/
//-----------|--------------------------------------------------------   
method new() class GeneralAccountsReceivableStatusReportSmartViewBusinessObject
    _Super:new()

    self:initializeBusinessObject()

    self:setIsCBoxLookup(.T., .T.)
    self:setIsLookup(.T.)

    self:loadParameters()

    self:setCompleteData(.T.)
    self:setMainTable("SE1")
    self:setBranchFilter(.T., .T.)

return self


//-------------------------------------------------------------------
/*/{Protheus.doc} initializeBusinessObject
    Método utilizado para inicializar dados do objeto de negócio, como nome, descrição e pergunta.

    @author Guilherme de Paula Santos
    @since 23/11/2023
    @version 12.1.2310
*/
//-------------------------------------------------------------------  
method initializeBusinessObject() class GeneralAccountsReceivableStatusReportSmartViewBusinessObject
    self:setDisplayName(STR0002) //Posição Geral do Contas a Receber
    self:setDescription(STR0003) //Posição Geral do Contas a Receber - Listagem de títulos por categoria e aging.
    self:setPergunte("FINT028")

    If Type("MVCHEQUES") == "C"
        self:cChequeTypes := MVCHEQUES
    ElseIf Type("MVCHEQUE") == "C"
        self:cChequeTypes := MVCHEQUE
    Else
        self:cChequeTypes := ""
    EndIf

    self:lTemGEM := ExistTemplate("GEMDESCTO") .And. HasTemplate("LOT")

    //Habilita o gate TEM_ABAT somente quando o vinculo pai-filho por FK7_IDPAI
    //NAO esta ativo. Com a FK7 ativa, SomaAbat resolve o vinculo por
    //getFatherRelatedBillsByType e o titulo filho pode ter prefixo, numero e
    //parcela diferentes do pai, o que o EXISTS por componentes nao alcancaria:
    //nesse cenario o gate ficaria mais restrito que a funcao e poderia deixar
    //de descontar um abatimento. Preferimos perder a otimizacao a arriscar o
    //valor. UsaBillRel mantem cache interno em __lBillRel/__oBillRel, mas ainda
    //assim e resolvida uma unica vez aqui.
    self:lGateAbat := (UsaBillRel() == Nil)
return


//-------------------------------------------------------------------
/*{Protheus.doc} getData
    Retorna os dados do objeto de negócio

    @param nPage, numérico, indica a página atual do relatório
    @param oFilter, objeto, contém o filtro do TReports
    @return object: self:oData

    @author Guilherme de Paula Santos
    @since 23/11/2023
    @version 12.1.2310
*/
//-------------------------------------------------------------------
method getData(nPage as numeric, oFilter as object) as object class GeneralAccountsReceivableStatusReportSmartViewBusinessObject
    if !self:validEnvironment()
        return self:oData
    endIf

    self:setFilter(oFilter)
    self:setMVPAR()
    self:loadParameters()
    self:loadFilterBranches( { "SE1", "SC6" } )
    self:loadMainTableSelectedBranches()
    self:loadBranchNames()
    self:loadLGPDFields()

    //Carrega o bloco de títulos a receber
    self:getListaDeTitulos()
    self:cAlias  := self:oQueryTitulos:openAlias(/*cAlias*/, self:cLifeTime, self:cTimeout)
    self:setDataListaDeTitulos()    
    (self:cAlias)->( DBCloseArea() )

    //Carrega o bloco de baixas
    self:getListaDeBaixas()
    self:cAlias  := self:oQueryBaixas:openAlias(/*cAlias*/, self:cLifeTime, self:cTimeout)
    self:setDataListaDeBaixas()
    (self:cAlias)->( DBCloseArea() )

    //carrega o bloco de pedidos de Vendas
    self:getListaDePedidosDeVendas()
    self:cAlias  := self:oQueryVendas:openAlias(/*cAlias*/, self:cLifeTime, self:cTimeout)
    self:setDataListaDePedidosDeVendas()
    (self:cAlias)->( DBCloseArea() )

    //Carrega o bloco FATURAMENTO (no mes).
    self:getListaDeFaturamentoNoMes()
    self:cAlias  := self:oQueryFatMes:openAlias(/*cAlias*/, self:cLifeTime, self:cTimeout)
    self:setDataListaDeFaturamentoNoMes()
    (self:cAlias)->( DBCloseArea() )

    //Carrega provisorios e abatimentos. 
    self:getListaDeProvisoriosEAbatimentos()
    self:cAlias  := self:oQueryProvAbat:openAlias(/*cAlias*/, self:cLifeTime, self:cTimeout)
    self:setDataListaDeProvisoriosEAbatimentos()
    (self:cAlias)->( DBCloseArea() )

return self:oData


//-------------------------------------------------------------------
/*{Protheus.doc} mySetSchema
Retorna a estrutura dos campos

@return object: self:oSchema

@author Guilherme de Paula Santos
@since 23/11/2023
@version 12.1.2310
*/
//-------------------------------------------------------------------
method mySetSchema() class GeneralAccountsReceivableStatusReportSmartViewBusinessObject

    local aFieldsSE1 := {} as array
    local aFieldsSED := {} as array
    local aFieldsFK1 := {} as array

    aFieldsSE1 := {"E1_FILIAL", "E1_PREFIXO", "E1_PARCELA", "E1_TIPO", "E1_NATUREZ",;
        "E1_CLIENTE", "E1_LOJA", "E1_NOMCLI", "E1_EMISSAO", "E1_BAIXA", "E1_SITUACA"}
    aFieldsSED := {"ED_DESCRIC"}
    aFieldsFK1 := {"FK1_VALOR"}

    self:jRelationSE1SC5 := {"E1_FILIAL":"C5_FILIAL","E1_CLIENTE":"C5_CLIENTE","E1_LOJA":"C5_LOJA","E1_EMISSAO":"C5_EMISSAO"}

    self:oSchema:aliasToSchema("SE1", aFieldsSE1)
    self:oSchema:aliasToSchema("SED", aFieldsSED)
    self:oSchema:aliasToSchema("FK1", aFieldsFK1)

    self:finAddProperty("E1_NUM"         , STR0004, "string")   //"Nro. Título/Ped. Vendas"
    self:finAddProperty("E1_VENCREA"     , STR0005, "date"  )   //"Vencto Tit./Prev. Entrega"
    self:finAddProperty("E1_VALOR"       , STR0006, "number")   //"Vlr. Titulo/Total Vendas"
    self:finAddProperty("E1_SALDO"       , STR0007, "number")   //"Vlr. em Aberto"
    self:finAddProperty("TIPOVENDA"      , STR0008, "string")   //"Tipo de Venda"
    self:finAddProperty("TIPOTITULO"     , STR0009, "string")   //"Tipo de Título"
    self:finAddProperty("CATEG_TITULO"   , STR0010, "string")   //"Classificação"
    self:finAddProperty("AGING_TITULO"   , STR0011, "string")   //"Aging do Título"
    self:finAddProperty("VALOR_CORRECAO" , STR0042, "number")   //"Valor de Correção"
    self:finAddProperty("VALOR_ACESSORIO", STR0043, "number")   //"Valor Acessório"

    self:finAddProperty("RECEBIDO"       , STR0030, "number")   //"Valor Recebido"
    self:finAddProperty("JUROS"          , FWX3Titulo("E1_JUROS")  , "number")
    self:finAddProperty("MULTA"          , FWX3Titulo("E1_MULTA")  , "number")
    self:finAddProperty("DESCONTO"       , FWX3Titulo("E1_DECRESC"), "number")

    self:finAddProperty("FRV_DESCRI"     , STR0044, "string") //"Situacao de Cobranca"

    //Codigos estaveis de identificacao dos blocos do relatorio legado FINR320. Devem ser usados no design do Smart View no lugar dos campos de texto correspondentes.
    self:finAddProperty("COD_ORIGEM"     , STR0045, "number")    //"Cod. Origem do Registro"
    self:finAddProperty("COD_BLOCO"      , STR0046, "number")    //"Cod. Bloco do Relatorio"
    self:finAddProperty("COD_AGING"      , STR0047, "number")    //"Cod. Aging"
    self:finAddProperty("COD_AGING_PED"  , STR0048, "number")    //"Cod. Aging do Pedido"
    self:finAddProperty("COD_TIPOTITULO" , STR0049, "number")    //"Cod. Tipo de Titulo"
    self:finAddProperty("COD_TIPOVENDA"  , STR0050, "number")    //"Cod. Tipo de Venda"
    self:finAddProperty("FL_DISTRIB"     , STR0051, "number")    //"Compoe Distribuicao da Cobranca"
    self:finAddProperty("FATURA_MES"     , STR0052, "number")    //"Faturamento no Mes"
    self:finAddProperty("SALDO_QUOC"     , STR0053, "number")    //"Saldo Base do Quociente de Atraso"
    self:finAddProperty("DIAS_PRAZO"     , STR0054, "number")    //"Dias de Prazo"

    FwFreeArray(aFieldsSE1)
    FwFreeArray(aFieldsSED)
    FwFreeArray(aFieldsFK1)

    self:changeCanFilter()

return self:oSchema


//-------------------------------------------------------------------
/*{Protheus.doc} getListaDeTitulos

    @author Guilherme de Paula Santos
    @since  23/11/2023
    @version 12.1.2310
    
*/
//-------------------------------------------------------------------
method getListaDeTitulos() class GeneralAccountsReceivableStatusReportSmartViewBusinessObject
    local cQuery    := ""  as Character
    local nParam    := 1   as numeric
    local aTitNotIn := {} as array

    //Obtem array para uso no setIn com os tipos de titulos
    self:getNotInTypeTitle(MVPROVIS, @aTitNotIn)
    self:getNotInTypeTitle(MVABATIM, @aTitNotIn)

    cQuery := " SELECT "
    cQuery += "  E1_FILIAL, E1_PREFIXO, E1_NUM, E1_PARCELA, E1_TIPO, "
    cQuery += "  E1_NATUREZ, ED_DESCRIC, E1_CLIENTE, E1_LOJA, E1_NOMCLI, "
    cQuery += "  E1_EMISSAO, E1_VENCREA, E1_BAIXA, E1_VALOR, E1_SALDO, "
    cQuery += "  E1_TXMOEDA, E1_MOEDA, E1_SITUACA, FRV.FRV_DESCRI FRV_DESCRI, "

    cQuery += "  E1_SDACRES, E1_SDDECRE, SE1.R_E_C_N_O_ SE1RECNO, "
    cQuery += "  SED.ED_CALCIRF, SED.ED_CALCINS, SED.ED_CALCPIS, "
    cQuery += "  SED.ED_CALCCOF, SED.ED_CALCCSL, SED.ED_CALCISS, "
    cQuery += "  E1_DESCFIN "

    if self:lGateAbat
        cQuery += ", CASE WHEN EXISTS ( "
        cQuery += "   SELECT 1 FROM " + RetSQLName("SE1") + " ABT "
        cQuery += "   WHERE ABT.E1_FILIAL = SE1.E1_FILIAL AND "
        cQuery += "     ABT.E1_PREFIXO = SE1.E1_PREFIXO AND "
        cQuery += "     ABT.E1_NUM = SE1.E1_NUM AND "
        cQuery += "     ABT.E1_PARCELA = SE1.E1_PARCELA AND "
        cQuery += "     ABT.E1_TIPO LIKE ? AND "
        cQuery += "     ABT.E1_EMISSAO <= ? AND "
        cQuery += "     ABT.D_E_L_E_T_ = ? "
        cQuery += " ) THEN 1 ELSE 0 END TEM_ABAT "
    else
        cQuery += ", 1 TEM_ABAT "
    endIf

    cQuery += " FROM " + RetSQLName("SE1") + " SE1 "
    cQuery += " INNER JOIN " + RetSQLName("SED") + " SED ON " + FWJoinFilial("SED", "SE1") + " "
    cQuery += "  AND SED.ED_CODIGO = SE1.E1_NATUREZ"
    cQuery += "  AND SED.D_E_L_E_T_ = ? "

    cQuery += " LEFT JOIN " + RetSQLName("FRV") + " FRV ON " + FWJoinFilial("FRV", "SE1") + " "
    cQuery += "  AND FRV.FRV_CODIGO = SE1.E1_SITUACA"
    cQuery += "  AND FRV.D_E_L_E_T_ = ? "
    cQuery += " WHERE "
    if self:lEmptyMultiBranches
        cQuery += " SE1.E1_FILIAL = ? AND "
    else
        cQuery += " SE1.E1_FILIAL IN (?) AND "
    endIf
    cQuery += " SE1.E1_VENCREA BETWEEN ? AND ? AND "
    cQuery += " SE1.E1_PREFIXO BETWEEN ? AND ? AND "

    //Um NOT IN por constante: o separador dos tipos varia por localizacao e
    //agrupar tudo em um unico FormatIn corromperia a lista.
    //
    //Aqui SO provisorio e abatimento sao descartados. A assimetria com
    //getListaDeFaturamentoNoMes, que descarta quatro tipos, e proposital e NAO
    //deve ser "corrigida": recebimento antecipado (MVRECANT) e nota de credito
    //(MV_CRNEG) TEM de entrar neste dataset porque alimentam linhas proprias do
    //bloco POR TIPO DE TITULO. Ver getTypeOfBillCode, que os classifica nos
    //codigos 6 e 7, equivalentes a aVal[24] e aVal[36] do FINR320. Excluir os
    //dois aqui zeraria essas duas linhas do relatorio.
    
    cQuery += " SE1.E1_TIPO NOT IN (?) AND "

    cQuery += " SE1.E1_SALDO > ? AND "
    
    if !self:lListarOutrasMoedas
        cQuery += " SE1.E1_MOEDA = ? AND "
    endIf

    cQuery += " SE1.D_E_L_E_T_ = ? "

    cQuery += " ? "

    cQuery := ChangeQuery(cQuery)

    self:oQueryTitulos := FWExecStatement():New(cQuery)

    //Os parametros do EXISTS de TEM_ABAT vem primeiro porque a expressao esta
    //na lista de colunas, que precede os JOIN e o WHERE. Quando o gate esta
    //desligado a expressao e a constante 1 e nao consome parametro.
    if self:lGateAbat
        self:oQueryTitulos:SetString(nParam++, "%-")    //E1_TIPO de abatimento
        self:oQueryTitulos:SetDate(nParam++, dDataBase) //dDataRef de SomaAbat
        self:oQueryTitulos:SetString(nParam++, ' ')     //SE1 do abatimento
    endIf

    self:oQueryTitulos:SetString(nParam++, ' ') //SED
    self:oQueryTitulos:SetString(nParam++, ' ') //FRV
    if self:lEmptyMultiBranches
        self:oQueryTitulos:SetString(nParam++, self:oFilterBranches["SE1"][1])
    else
        self:oQueryTitulos:SetIn(nParam++, self:oFilterBranches["SE1"][1])
    endIf
    self:oQueryTitulos:SetDate(nParam++, self:dFromDueDate)
    self:oQueryTitulos:SetDate(nParam++, self:dToDueDate)
    self:oQueryTitulos:SetString(nParam++,self:cInitialprefix)
    self:oQueryTitulos:SetString(nParam++,self:cFinalprefix)

    self:oQueryTitulos:SetIn(nParam++, aTitNotIn)

    self:oQueryTitulos:SetNumeric(nParam++, 0)

    if !self:lListarOutrasMoedas
        self:oQueryTitulos:SetNumeric(nParam++,self:nCurrency)
    endIf

    self:oQueryTitulos:SetString(nParam++, ' ')
    self:oQueryTitulos:SetUnsafe(nParam++, self:getFilterToSQL())

return


//-------------------------------------------------------------------
/*{Protheus.doc} getListaDeBaixas

    @author Guilherme de Paula Santos
    @since 23/11/2023
    @version 12.1.2310
*/
//-------------------------------------------------------------------
method getListaDeBaixas() class GeneralAccountsReceivableStatusReportSmartViewBusinessObject
    local cQuery     := ""  as Character
    local nParam     := 1   as numeric

    cQuery := " SELECT "
    cQuery += " E1_FILIAL, E1_PREFIXO, E1_NUM, E1_PARCELA, E1_TIPO, E1_NATUREZ, E1_CLIENTE, "
    cQuery += " E1_LOJA, E1_NOMCLI, E1_EMISSAO, E1_VENCREA, E1_BAIXA, E1_VALOR, E1_SALDO, "
    cQuery += " ED_DESCRIC, FK1_TPDOC, FK1_TXMOED, FK1_MOTBX, FK1_VALOR, FK1_VLMOE2, FK1_DATA, "
    cQuery += " FK1_MOEDA, E1_MOEDA, E1_TXMOEDA, "
    cQuery += " COALESCE(FK6.VALOR_CORRECAO, 0) VALOR_CORRECAO, "
    cQuery += " COALESCE(FK6.VALOR_ACESSORIO, 0) VALOR_ACESSORIO, "
    cQuery += " COALESCE(FK6.JUROS, 0) JUROS, "
    cQuery += " COALESCE(FK6.MULTA, 0) MULTA, "
    cQuery += " COALESCE(FK6.DESCONTO, 0) DESCONTO, "
    cQuery += " COALESCE(FK6.RECEBIDO, 0) RECEBIDO "
    cQuery += " FROM " + RetSQLName("SE1") + " SE1 "
	cQuery += " INNER JOIN " + RetSQLName("SED") + " SED ON " + FWJoinFilial("SED", "SE1") + " AND "
    cQuery += "     SED.ED_CODIGO = E1_NATUREZ AND "
	cQuery += "     SED.D_E_L_E_T_ = ? "
	cQuery += " INNER JOIN " + RetSQLName("FK7") + " FK7 ON "
    cQuery += "     FK7.FK7_ALIAS = ? AND "
	cQuery += "     FK7.FK7_FILTIT = SE1.E1_FILIAL AND "
	cQuery += "     FK7.FK7_PREFIX = SE1.E1_PREFIXO AND "
    cQuery += "     FK7.FK7_NUM = SE1.E1_NUM AND "
	cQuery += "     FK7.FK7_PARCEL = SE1.E1_PARCELA AND "
	cQuery += "     FK7.FK7_TIPO = SE1.E1_TIPO AND "
	cQuery += "     FK7.FK7_CLIFOR = SE1.E1_CLIENTE AND "
	cQuery += "     FK7.FK7_LOJA = SE1.E1_LOJA AND "
	cQuery += "     FK7.D_E_L_E_T_ = ? "
	cQuery += " INNER JOIN " + RetSQLName("FK1") + " FK1 ON " + FWJoinFilial("FK1","FK7") + " AND "
	cQuery += "     FK1.FK1_IDDOC = FK7.FK7_IDDOC AND "
    cQuery += "     FK1.FK1_MOTBX NOT IN (?) AND "

    If self:nListpostingsby == 2
        cQuery += " FK1.FK1_DTDIGI BETWEEN ? AND ? AND "
    ElseIf self:nListpostingsby == 3 
        cQuery += " FK1.FK1_DTDISP BETWEEN ? AND ? AND "
    Else
        cQuery += " FK1.FK1_DATA BETWEEN ? AND ? AND "
    EndIf

    cQuery += " FK1.FK1_RECPAG = ? AND "
    cQuery += " FK1.D_E_L_E_T_ = ? AND "
    cQuery += " NOT EXISTS ("
    cQuery += "     SELECT FK1EST.FK1_IDDOC FROM " + RetSQLName("FK1") + " FK1EST "
    cQuery += "     WHERE FK1EST.FK1_IDDOC = FK1.FK1_IDDOC AND "
    cQuery += "     FK1EST.FK1_SEQ = FK1.FK1_SEQ AND "
	cQuery += "     FK1EST.FK1_TPDOC = ? AND "
	cQuery += "     FK1EST.D_E_L_E_T_ = ? ) "

    cQuery += " LEFT JOIN ( "
    cQuery += "   SELECT FK6I.FK6_FILIAL FK6_FILIAL, FK6I.FK6_IDORIG FK6_IDORIG, "
    cQuery += "     SUM(CASE WHEN FK6I.FK6_TPDOC IN (?) THEN FK6I.FK6_VALMOV ELSE 0 END) VALOR_CORRECAO, "
    cQuery += "     SUM(CASE WHEN FK6I.FK6_TPDOC IN (?) THEN FK6I.FK6_VALMOV ELSE 0 END) VALOR_ACESSORIO, "
    cQuery += "     SUM(CASE WHEN FK6I.FK6_TPDOC IN (?) THEN FK6I.FK6_VALMOV ELSE 0 END) JUROS, "
    cQuery += "     SUM(CASE WHEN FK6I.FK6_TPDOC IN (?) THEN FK6I.FK6_VALMOV ELSE 0 END) MULTA, "
    cQuery += "     SUM(CASE WHEN FK6I.FK6_TPDOC IN (?) THEN FK6I.FK6_VALMOV ELSE 0 END) DESCONTO, "
    cQuery += "     SUM(CASE WHEN FK6I.FK6_TPDOC IN (?) THEN FK6I.FK6_VALMOV ELSE 0 END) RECEBIDO "
    cQuery += "   FROM " + RetSQLName("FK6") + " FK6I "
    cQuery += "   WHERE FK6I.FK6_TABORI = ? AND "
    cQuery += "     FK6I.D_E_L_E_T_ = ? "
    cQuery += "   GROUP BY FK6I.FK6_FILIAL, FK6I.FK6_IDORIG "
    cQuery += " ) FK6 ON " + FWJoinFilial("FK6","FK1") + " AND "
    cQuery += "   FK6.FK6_IDORIG = FK1.FK1_IDFK1 "

    cQuery += " WHERE "
	if self:lEmptyMultiBranches
        cQuery += " SE1.E1_FILIAL = ? AND "
    else
        cQuery += " SE1.E1_FILIAL IN (?) AND "
    endIf
    cQuery += " SE1.E1_PREFIXO BETWEEN ? AND ? AND "

    if !self:lListarOutrasMoedas
        cQuery += " SE1.E1_MOEDA = ? AND "
    endIf

    cQuery += " SE1.D_E_L_E_T_ = ? "

    cQuery += " ? "

    cQuery := ChangeQuery(cQuery)

    self:oQueryBaixas := FWExecStatement():New(cQuery)

    //SED
    self:oQueryBaixas:SetString(nParam++, ' ')

    //FK7
    self:oQueryBaixas:SetString(nParam++, 'SE1')
    self:oQueryBaixas:SetString(nParam++, ' ')

    //FK1.
    self:oQueryBaixas:SetIn(nParam++, {'DSD', 'FAT', 'LIQ', 'STP'})
    self:oQueryBaixas:SetDate(nParam++, self:dIssueDateFrom)
    self:oQueryBaixas:SetDate(nParam++, self:dIssueDateTo)
    self:oQueryBaixas:SetString(nParam++, 'R')
    self:oQueryBaixas:SetString(nParam++, ' ')

    //FK1 do estorno
    self:oQueryBaixas:SetString(nParam++, 'ES')
    self:oQueryBaixas:SetString(nParam++, ' ')

    self:oQueryBaixas:SetIn(nParam++, {'CM','VM','C2'})     //VALOR_CORRECAO

    self:oQueryBaixas:SetIn(nParam++, {'VA'})               //VALOR_ACESSORIO

    self:oQueryBaixas:SetIn(nParam++, {'JR','J2','TL'})     //JUROS (Taxa de Permanencia)
    self:oQueryBaixas:SetIn(nParam++, {'MT','M2'})          //MULTA
    self:oQueryBaixas:SetIn(nParam++, {'DC','D2'})          //DESCONTO

    self:oQueryBaixas:SetIn(nParam++, {'VL','V2','BA'})     //RECEBIDO

    self:oQueryBaixas:SetString(nParam++, 'FK1')            //FK6_TABORI
    self:oQueryBaixas:SetString(nParam++, ' ')              //FK6 D_E_L_E_T_

    if self:lEmptyMultiBranches
        self:oQueryBaixas:SetString(nParam++, self:oFilterBranches["SE1"][1])
    else
        self:oQueryBaixas:SetIn(nParam++, self:oFilterBranches["SE1"][1])
    endIf

    self:oQueryBaixas:SetString(nParam++,self:cInitialprefix)
    self:oQueryBaixas:SetString(nParam++,self:cFinalprefix)

    if !self:lListarOutrasMoedas
        self:oQueryBaixas:SetNumeric(nParam++,self:nCurrency)
    endIf

    self:oQueryBaixas:SetString(nParam++, ' ')
    self:oQueryBaixas:SetUnsafe(nParam++, self:getFilterToSQL())

return


//-------------------------------------------------------------------
/*{Protheus.doc} getListaDePedidosDeVendas

    @author Guilherme de Paula Santos
    @since 23/11/2023
    @version 12.1.2310
*/
//-------------------------------------------------------------------
method getListaDePedidosDeVendas() class GeneralAccountsReceivableStatusReportSmartViewBusinessObject
    local cQuery := "" as Character
    local nParam := 1  as numeric

    cQuery := " SELECT "
    cQuery += "  C6_FILIAL E1_FILIAL, C6_ITEM, C6_NUM, C6_TES, C6_QTDENT, "
    cQuery += "  C6_QTDVEN, C6_PRCVEN, C6_VALOR, C6_CLI, C6_LOJA, "
    cQuery += "  A1_NOME, C5_EMISSAO, C6_ENTREG, C5_MOEDA, C5_TXMOEDA "
    cQuery += " FROM " + RetSQLName("SC6") + " SC6 "
    cQuery += " INNER JOIN " + RetSQLName("SC5") + " SC5 ON " + FWJoinFilial("SC5", "SC6")  + " AND "
    cQuery += "     SC5.C5_NUM = SC6.C6_NUM AND "
    cQuery += "     SC5.C5_CLIENTE = SC6.C6_CLI AND "
    cQuery += "     SC5.C5_LOJACLI = SC6.C6_LOJA AND "
    cQuery += "     SC5.D_E_L_E_T_ = ? "
    cQuery += " INNER JOIN " + RetSQLName("SA1") + " SA1 ON " + FWJoinFilial("SA1","SC6") + " AND "
    cQuery += "     SA1.A1_COD = SC6.C6_CLI AND "
    cQuery += "     SA1.A1_LOJA = SC6.C6_LOJA AND "
    cQuery += "     SA1.D_E_L_E_T_ = ? "
    cQuery += " INNER JOIN " + RetSQLName("SF4") + " SF4 ON " + FWJoinFilial("SF4","SC6") + " AND "
    cQuery += "     SF4.F4_CODIGO = SC6.C6_TES AND "
    cQuery += "     SF4.F4_DUPLIC = ? AND "
    cQuery += "     SF4.D_E_L_E_T_ = ? "
    cQuery += " WHERE "
    if self:lEmptyMultiBranches
        cQuery += " SC6.C6_FILIAL = ? AND "
    else
        cQuery += " SC6.C6_FILIAL IN (?) AND "
    endIf
    cQuery += " C6_QTDENT < C6_QTDVEN AND "

    if !self:lListarOutrasMoedas
        cQuery += " SC5.C5_MOEDA = ? AND "
    endIf

    cQuery += " SC6.D_E_L_E_T_ = ? "

    cQuery += " ? "

    cQuery := ChangeQuery(cQuery)

    self:oQueryVendas := FWExecStatement():New(cQuery)

    self:oQueryVendas:SetString(nParam++, ' ')
    self:oQueryVendas:SetString(nParam++, ' ')
    self:oQueryVendas:SetString(nParam++, 'S')
    self:oQueryVendas:SetString(nParam++, ' ')

    if self:lEmptyMultiBranches
        self:oQueryVendas:SetString(nParam++, self:oFilterBranches["SC6"][1])
    else
        self:oQueryVendas:SetIn(nParam++, self:oFilterBranches["SC6"][1])
    endIf   

    if !self:lListarOutrasMoedas
        self:oQueryVendas:SetNumeric(nParam++,self:nCurrency)
    endIf

    self:oQueryVendas:SetString(nParam++, ' ')
    self:oQueryVendas:SetUnsafe(nParam++, self:filterWithRelationOfSC5())

return


//-------------------------------------------------------------------
/*{Protheus.doc} setDataListaDeTitulos
Adiciona dados dos títulos em aberto no objeto de negócios

@return character: cQuery

@author Fábio Andrade
@since 26/05/2023
@version 1.0
*/
//-------------------------------------------------------------------
method setDataListaDeTitulos() as object class GeneralAccountsReceivableStatusReportSmartViewBusinessObject

    Local cTipoVenda    := "" as character
    Local cTipoTitulo   := "" as character
    Local cCategoria    := "" as character
    Local cAgingReceber := "" as character
    Local nDias         := 0  as numeric
    Local nSaldo        := 0  as numeric
    Local nValor        := 0  as numeric
    Local nSaldoAtu     := 0  as numeric
    Local nValAbat      := 0  as numeric
    Local nCodBloco     := 0  as numeric
    Local nCodAging     := 0  as numeric
    Local nCodTipoTit   := 0  as numeric
    Local nCodTpVenda   := 0  as numeric
    Local nDiasPrazo    := 0  as numeric
    Local nSaldoQuoc    := 0  as numeric
    Local nFlDistrib    := 0  as numeric
    Local lAdto         := .F. as logical
    Local lTemDescFin   := .F. as logical
    Local lTemAbat      := .F. as logical
    Local aAreaSE1      := {} as array

    //FaDescFin exige SE1 posicionado, o que obriga o dbGoto dentro do laco.
    //A area de SE1 e salva aqui e restaurada apos o laco para nao devolver ao
    //chamador o ponteiro de registro deslocado.
    aAreaSE1 := SE1->(GetArea())

    (self:cAlias)->(DBGoTop())

    While !(self:cAlias)->(Eof())

        nDias         := 0
        nCodBloco     := 0
        nCodAging     := 0
        nCodTipoTit   := 0
        nSaldoQuoc    := 0
        nFlDistrib    := 0
        nValAbat      := 0
        cCategoria    := ""
        cTipoTitulo   := "-"
        cAgingReceber := "-"

        //Tipo de venda: mesma conta do legado (E1_VENCREA - E1_EMISSAO)
        nDiasPrazo  := StoD((self:cAlias)->E1_VENCREA) - StoD((self:cAlias)->E1_EMISSAO)
        nCodTpVenda := self:getSaleTypeCode(nDiasPrazo)
        cTipoVenda  := self:getSaleTypeText(nCodTpVenda)

        lAdto := (self:cAlias)->E1_TIPO $ (MVRECANT + "|" + MV_CRNEG)

        //Saldo na regra do FINR320: saldo em aberto mais acrescimo menos'decrescimo ainda nao baixados, convertido para a moeda do relatorio.
        nSaldoAtu := xMoeda((self:cAlias)->E1_SALDO + (self:cAlias)->E1_SDACRES - (self:cAlias)->E1_SDDECRE,;
            (self:cAlias)->E1_MOEDA, self:nCurrency, (self:cAlias)->E1_EMISSAO, self:nDecimals,;
            (self:cAlias)->E1_TXMOEDA)

        //Gate do desconto financeiro.
        lTemDescFin := self:lTemGEM .Or. (self:cAlias)->E1_DESCFIN <> 0

        //Gate do abatimento. 
        lTemAbat := !lAdto .And. self:hasWithholdingTax() .And. ;
                    (self:cAlias)->TEM_ABAT == 1


        If lTemDescFin .Or. lTemAbat
            SE1->(dbGoto((self:cAlias)->SE1RECNO))
        EndIf

        //Desconto financeiro
        If lTemDescFin
            nSaldoAtu -= FaDescFin("SE1", dDataBase, nSaldoAtu, self:nCurrency, , self:lTemGEM)
        EndIf

        //Abatimentos vinculados ao titulo. O valor vem de SomaAbat, a mesma funcao usada pelo FINR320
        If nSaldoAtu > 0 .And. lTemAbat
            nValAbat := SomaAbat((self:cAlias)->E1_PREFIXO, (self:cAlias)->E1_NUM,;
                (self:cAlias)->E1_PARCELA, "R", self:nCurrency, dDataBase,;
                (self:cAlias)->E1_CLIENTE, (self:cAlias)->E1_LOJA,;
                (self:cAlias)->E1_FILIAL, dDataBase, (self:cAlias)->E1_TIPO)

            nSaldoAtu -= nValAbat
        EndIf

        nSaldoAtu := Round(NoRound(nSaldoAtu, 3), 2)

        If nSaldoAtu > 0
            If dDatabase <= StoD((self:cAlias)->E1_VENCREA) .OR. (self:cAlias)->E1_TIPO $ MVRECANT
                nCodBloco := 3 //TITULOS A VENCER
                nDias := (StoD((self:cAlias)->E1_VENCREA) - dDatabase)
            Else
                nCodBloco := 4 //TITULOS VENCIDOS
                nDias := (dDatabase - StoD((self:cAlias)->E1_VENCREA))
            EndIf
            cCategoria := self:getCategoryText(nCodBloco)

            nCodTipoTit := self:getTypeOfBillCode((self:cAlias)->E1_TIPO, (self:cAlias)->E1_EMISSAO)
            cTipoTitulo := self:getTypeOfBillText(nCodTipoTit)

            nCodAging     := self:getAgingCode(nDias)
            cAgingReceber := self:getAgingText(nCodAging)

        EndIf

        nValor := xMoeda((self:cAlias)->E1_VALOR,(self:cAlias)->E1_MOEDA,self:nCurrency,(self:cAlias)->E1_EMISSAO,self:nDecimals,(self:cAlias)->E1_TXMOEDA)
        nSaldo := nSaldoAtu

        If lAdto
            nValor := nValor*-1
            nSaldo := nSaldo*-1
        EndIf

        If nSaldoAtu > 0
            If StoD((self:cAlias)->E1_VENCREA) < dDataBase
                nSaldoQuoc := nSaldo
            ElseIf !lAdto
                nSaldoQuoc := nSaldo
            EndIf
        EndIf

        If nSaldoAtu > 0 .And. !lAdto .And. !Empty((self:cAlias)->FRV_DESCRI)
            nFlDistrib := 1
        EndIf

        self:jData := {"E1_FILIAL":     AllTrim((self:cAlias)->E1_FILIAL),;
            "E1_CLIENTE":   AllTrim((self:cAlias)->E1_CLIENTE),;
            "E1_LOJA":      AllTrim((self:cAlias)->E1_LOJA),;
            "E1_NOMCLI":    AllTrim((self:cAlias)->E1_NOMCLI),;
            "E1_PREFIXO":   AllTrim((self:cAlias)->E1_PREFIXO),;
            "E1_NUM":       AllTrim((self:cAlias)->E1_NUM),;
            "E1_PARCELA":   AllTrim((self:cAlias)->E1_PARCELA),;
            "E1_TIPO":      AllTrim((self:cAlias)->E1_TIPO),;
            "E1_EMISSAO":   self:varToTimeStamp( (self:cAlias)->E1_EMISSAO ),;
            "E1_VENCREA":   self:varToTimeStamp( (self:cAlias)->E1_VENCREA ),;
            "E1_BAIXA":     Nil,;
            "E1_VALOR":     nValor,;
            "E1_SALDO":     nSaldo,;
            "FK1_VALOR":    0,;
            "E1_NATUREZ":   MascNat((self:cAlias)->E1_NATUREZ),;
            "ED_DESCRIC":   AllTrim((self:cAlias)->ED_DESCRIC),;
            "E1_SITUACA":   AllTrim((self:cAlias)->E1_SITUACA),;
            "FRV_DESCRI":   AllTrim((self:cAlias)->FRV_DESCRI),;
            "TIPOVENDA":   cTipoVenda,;
            "TIPOTITULO":   cTipoTitulo,;
            "CATEG_TITULO": cCategoria,;
            "AGING_TITULO": cAgingReceber,;
            "COD_ORIGEM":     1,;
            "COD_BLOCO":      nCodBloco,;
            "COD_AGING":      nCodAging,;
            "COD_AGING_PED":  0,;
            "COD_TIPOTITULO": nCodTipoTit,;
            "COD_TIPOVENDA":  nCodTpVenda,;
            "FL_DISTRIB":     nFlDistrib,;
            "FATURA_MES":     0,;
            "SALDO_QUOC":     nSaldoQuoc,;
            "DIAS_PRAZO":     nDiasPrazo,;
            "RECEBIDO":       0,;
            "JUROS":          0,;
            "MULTA":          0,;
            "DESCONTO":       0,;
            "VALOR_CORRECAO":0,;
            "VALOR_ACESSORIO":0}

        self:processAndAppend()

        (self:cAlias)->( dbSkip() )

    EndDo

    RestArea(aAreaSE1)

Return self:oData


//-------------------------------------------------------------------
/*{Protheus.doc} setDataListaDeBaixas
Adiciona dados das baixas no objeto de negócios

@return character: cQuery

@author Fábio Andrade
@since 30/05/2023
@version 1.0
*/
//-------------------------------------------------------------------
method setDataListaDeBaixas() as object class GeneralAccountsReceivableStatusReportSmartViewBusinessObject
    Local cTipoVenda := "" as character
    Local cTipoTitulo := "" as character
    Local cCategoria  := "" as character
    Local cAgingReceber := "" as character
    Local nSaldo      := 0  as numeric
    Local nValor      := 0  as numeric
    Local nBaixa      := 0  as numeric
    Local nMoeda      := 0  as numeric
    Local nTxMoeda    := 0  as numeric
    Local nCodTipoTit := 0  as numeric
    Local nCodTpVenda := 0  as numeric

    (self:cAlias)->(DBGoTop())

    cCategoria := self:getCategoryText(2) //VALORES BAIXADOS

    While !(self:cAlias)->(Eof())

        nCodTpVenda := self:getSaleTypeCode(StoD((self:cAlias)->E1_VENCREA) - StoD((self:cAlias)->E1_EMISSAO))
        cTipoVenda  := self:getSaleTypeText(nCodTpVenda)

        //Nas baixas a data de emissao nao restringe a classificacao, ao contrario do bloco POR TIPO DE TITULO.
        nCodTipoTit := self:getTypeOfBillCode((self:cAlias)->E1_TIPO, (self:cAlias)->E1_EMISSAO, .F.)
        cTipoTitulo := self:getTypeOfBillText(nCodTipoTit)

        cAgingReceber := "-"

        nMoeda := Val(AllTrim((self:cAlias)->FK1_MOEDA))
        If (self:cAlias)->E1_TXMOEDA == 0
            nTxMoeda := RecMoeda((self:cAlias)->E1_EMISSAO, (self:cAlias)->E1_MOEDA)
        Else 
            nTxMoeda := (self:cAlias)->E1_TXMOEDA
        EndIf

        If nMoeda == (self:cAlias)->E1_MOEDA
            nTxMoeda := (self:cAlias)->FK1_TXMOED
        EndIf

        nValor := xMoeda((self:cAlias)->E1_VALOR,(self:cAlias)->E1_MOEDA,self:nCurrency,(self:cAlias)->E1_EMISSAO,self:nDecimals,nTxMoeda)
        nSaldo := xMoeda((self:cAlias)->E1_SALDO,(self:cAlias)->E1_MOEDA,self:nCurrency,(self:cAlias)->E1_EMISSAO,self:nDecimals,nTxMoeda)
        nBaixa := xMoeda((self:cAlias)->FK1_VALOR,nMoeda,self:nCurrency,(self:cAlias)->FK1_DATA ,self:nDecimals,(self:cAlias)->FK1_TXMOED)

        If (self:cAlias)->E1_TIPO $ (MVRECANT + "|" + MV_CRNEG)
            nValor := nValor*-1
            nSaldo := nSaldo*-1
            nBaixa := nBaixa*-1
        EndIf

        self:jData := {"E1_FILIAL":     AllTrim((self:cAlias)->E1_FILIAL),;
            "E1_CLIENTE":     AllTrim((self:cAlias)->E1_CLIENTE),;
            "E1_LOJA":        AllTrim((self:cAlias)->E1_LOJA),;
            "E1_NOMCLI":      AllTrim((self:cAlias)->E1_NOMCLI),;
            "E1_PREFIXO":     AllTrim((self:cAlias)->E1_PREFIXO),;
            "E1_NUM":         AllTrim((self:cAlias)->E1_NUM),;
            "E1_PARCELA":     AllTrim((self:cAlias)->E1_PARCELA),;
            "E1_TIPO":        AllTrim((self:cAlias)->E1_TIPO),;
            "E1_EMISSAO":     self:varToTimeStamp( (self:cAlias)->E1_EMISSAO ),;
            "E1_VENCREA":     self:varToTimeStamp( (self:cAlias)->E1_VENCREA ),;
            "E1_BAIXA":       self:varToTimeStamp( (self:cAlias)->FK1_DATA ),;
            "E1_VALOR":       nValor,;
            "E1_SALDO":       nSaldo,;
            "FK1_VALOR":      nBaixa,;
            "E1_NATUREZ":     MascNat((self:cAlias)->E1_NATUREZ),;
            "ED_DESCRIC":     AllTrim((self:cAlias)->ED_DESCRIC),;
            "E1_SITUACA":     "",;
            "FRV_DESCRI":     "",;
            "TIPOVENDA":     cTipoVenda,;
            "TIPOTITULO":     cTipoTitulo,;
            "CATEG_TITULO":   cCategoria,;
            "AGING_TITULO":   cAgingReceber,;
            "COD_ORIGEM":     2,;
            "COD_BLOCO":      2,;
            "COD_AGING":      0,;
            "COD_AGING_PED":  0,;
            "COD_TIPOTITULO": nCodTipoTit,;
            "COD_TIPOVENDA":  nCodTpVenda,;
            "FL_DISTRIB":     0,;
            "FATURA_MES":     0,;
            "SALDO_QUOC":     0,;
            "DIAS_PRAZO":     0,;
            "RECEBIDO":       (self:cAlias)->RECEBIDO,;
            "JUROS":          (self:cAlias)->JUROS,;
            "MULTA":          (self:cAlias)->MULTA,;
            "DESCONTO":       (self:cAlias)->DESCONTO,;
            "VALOR_CORRECAO": (self:cAlias)->VALOR_CORRECAO,;
            "VALOR_ACESSORIO":(self:cAlias)->VALOR_ACESSORIO}

        self:processAndAppend()

        (self:cAlias)->( dbSkip() )
    EndDo


Return self:oData


//-------------------------------------------------------------------
/*{Protheus.doc} setDataListaDePedidosDeVendas
Adiciona dados dos pedidos de vendas no objeto de negócios

@return character: cQuery

@author Fábio Andrade
@since 30/05/2023
@version 1.0
*/
//-------------------------------------------------------------------
method setDataListaDePedidosDeVendas() as object class GeneralAccountsReceivableStatusReportSmartViewBusinessObject

    Local cTipoVenda := "" as character
    Local cTipoTitulo := "" as character
    Local cCategoria  := "" as character
    Local cAgingReceber := "" as character
    Local nDias       := 0  as numeric
    Local nVlrSaldo   := 0  as numeric
    Local nSaldo      := 0  as numeric
    Local nValor      := 0  as numeric
    Local nCodTpVenda := 0  as numeric
    Local nCodAgingPed := 0 as numeric
    Local lAtrasado   := .F. as logical

    (self:cAlias)->(DBGoTop())

    nCodTpVenda := 3 //Pedido de Venda
    cTipoVenda  := self:getSaleTypeText(nCodTpVenda)

    While !(self:cAlias)->(Eof())       

        lAtrasado := StoD((self:cAlias)->C6_ENTREG) < dDataBase

        If lAtrasado
            cCategoria := STR0038 //"PEDIDOS DE VENDA ATRASADOS"
            nDias := dDataBase - StoD((self:cAlias)->C6_ENTREG)
        Else
            cCategoria := STR0039 //"PEDIDOS DE VENDA ADIANTADOS"
            nDias := StoD((self:cAlias)->C6_ENTREG) - dDataBase
        EndIf

        nCodAgingPed  := self:getSalesOrderAgingCode(nDias, lAtrasado)
        cAgingReceber := self:getSalesOrderAgingText(nCodAgingPed)

        If (self:cAlias)->C6_QTDENT > 0
            cTipoTitulo := STR0040 //"Parcialmente atendido"
        Else
            cTipoTitulo := STR0041 //"Não atendido"
        EndIf

        nVlrSaldo := ((self:cAlias)->C6_QTDVEN - (self:cAlias)->C6_QTDENT) * (self:cAlias)->C6_PRCVEN
        
        nValor := xMoeda((self:cAlias)->C6_VALOR,(self:cAlias)->C5_MOEDA,self:nCurrency,(self:cAlias)->C5_EMISSAO,self:nDecimals,(self:cAlias)->C5_TXMOEDA)
        nSaldo := xMoeda(nVlrSaldo,(self:cAlias)->C5_MOEDA,self:nCurrency,(self:cAlias)->C5_EMISSAO,self:nDecimals,(self:cAlias)->C5_TXMOEDA)       

        self:jData := {"E1_FILIAL":     AllTrim((self:cAlias)->E1_FILIAL),;
            "E1_CLIENTE":   AllTrim((self:cAlias)->C6_CLI),;
            "E1_LOJA":      AllTrim((self:cAlias)->C6_LOJA),;
            "E1_NOMCLI":    AllTrim((self:cAlias)->A1_NOME),;
            "E1_PREFIXO":   "",;
            "E1_NUM":       AllTrim((self:cAlias)->C6_NUM) + "-" + AllTrim((self:cAlias)->C6_ITEM),;
            "E1_PARCELA":   "",;
            "E1_TIPO":      "",;
            "E1_EMISSAO":   self:varToTimeStamp( (self:cAlias)->C5_EMISSAO ),;
            "E1_VENCREA":   self:varToTimeStamp( (self:cAlias)->C6_ENTREG ),;
            "E1_BAIXA":     Nil,;
            "E1_VALOR":     nValor,;
            "E1_SALDO":     nSaldo,;
            "FK1_VALOR":    0,;
            "E1_NATUREZ":   "",;
            "ED_DESCRIC":   "",;
            "E1_SITUACA":   "",;
            "FRV_DESCRI":   "",;
            "TIPOVENDA":   cTipoVenda,;
            "TIPOTITULO":   cTipoTitulo,;
            "CATEG_TITULO": cCategoria,;
            "AGING_TITULO": cAgingReceber,;
            "COD_ORIGEM":     3,;
            "COD_BLOCO":      8,;
            "COD_AGING":      0,;
            "COD_AGING_PED":  nCodAgingPed,;
            "COD_TIPOTITULO": 0,;
            "COD_TIPOVENDA":  nCodTpVenda,;
            "FL_DISTRIB":     0,;
            "FATURA_MES":     0,;
            "SALDO_QUOC":     0,;
            "DIAS_PRAZO":     0,;
            "RECEBIDO":       0,;
            "JUROS":          0,;
            "MULTA":          0,;
            "DESCONTO":       0,;
            "VALOR_CORRECAO":0,;
            "VALOR_ACESSORIO":0}

        self:processAndAppend()

        (self:cAlias)->( dbSkip() )
    EndDo

Return self:oData


//-------------------------------------------------------------------
/*{Protheus.doc} loadParameters
    Carrega os parâmetros do filtro para as propriedades da classe.
    @author Guilherme de Paula Santos
    @since 23/11/2023
    @version 12.1.2310
*/
//-------------------------------------------------------------------
method loadParameters() class GeneralAccountsReceivableStatusReportSmartViewBusinessObject

    self:lListarOutrasMoedas := .F.
    self:nCurrency := 1

    if self:oCurrentFilter != NIL
        self:nListpostingsby     := MV_PAR01
        self:dIssueDateFrom      := MV_PAR02
        self:dIssueDateTo        := MV_PAR03
        self:nCurrency           := self:getCurrencyValue(MV_PAR04)
        self:lListarOutrasMoedas := MV_PAR05 == 1
        self:cInitialprefix      := MV_PAR06
        self:cFinalprefix        := MV_PAR07
        self:dFromDueDate        := MV_PAR08
        self:dToDueDate          := MV_PAR09        
    endIf
return


//-------------------------------------------------------------------
/*{Protheus.doc} getAgingText
    @author guilherme.sordi@totvs.com.br
    @since 30/11/2023
    @version 12.1.2310
*/
//-------------------------------------------------------------------
method getAgingCode(nDias as numeric) as numeric class GeneralAccountsReceivableStatusReportSmartViewBusinessObject
    local nCodAging := 0 as numeric
    
    default nDias := 0

    If nDias <= 15
        nCodAging := 1
    ElseIf nDias > 15 .And. nDias <= 30
        nCodAging := 2
    ElseIf nDias > 30 .And. nDias <= 60
        nCodAging := 3
    ElseIf nDias > 60 .And. nDias <= 90
        nCodAging := 4
    Else
        nCodAging := 5
    Endif
return nCodAging


//-----------------------------------------------------------------
/*{Protheus.doc} getAgingText
    Retorna a descricao da faixa de aging a partir do codigo devolvido por
    getAgingCode. Derivar o texto do codigo garante que os dois nunca fiquem
    divergentes.

    @param nCodAging, numeric, codigo da faixa de aging
    @return character: descricao traduzida da faixa

    @author guilherme.sordi@totvs.com.br
    @since 30/11/2023
    @version 12.1.2310
*/
//-----------------------------------------------------------------
method getAgingText(nCodAging as numeric) as character class GeneralAccountsReceivableStatusReportSmartViewBusinessObject
    local cAgingText := "-" as character
    
    default nCodAging := 0

    Do Case
        Case nCodAging == 1
            cAgingText := STR0022 //"Ate 15 Dias"
        Case nCodAging == 2
            cAgingText := STR0023 //"De 16 a 30 Dias"
        Case nCodAging == 3
            cAgingText := STR0024 //"De 31 a 60 Dias"
        Case nCodAging == 4
            cAgingText := STR0025 //"De 61 a 90 Dias"
        Case nCodAging == 5
            cAgingText := STR0026 //"Acima de 90 Dias"
    EndCase
return cAgingText


//-------------------------------------------------------------------
/*{Protheus.doc} getTypeOfBillText
    @author guilherme.sordi@totvs.com.br
    @since 30/11/2023
    @version 12.1.2310
*/
//-------------------------------------------------------------------
method getTypeOfBillCode(cType as character, cEmissao as character, lCheckIssueDate as logical) as numeric class GeneralAccountsReceivableStatusReportSmartViewBusinessObject
    local nCodTipoTit := 0 as numeric

    default cType := ""
    default cEmissao := ""
    default lCheckIssueDate := .T.

    If lCheckIssueDate .And. StoD(cEmissao) > dDatabase
        Return nCodTipoTit
    EndIf

    Do Case
        Case cType $ MVDUPLIC
            nCodTipoTit := 1
        Case cType $ MVNOTAFIS
            nCodTipoTit := 2
        Case !Empty(self:cChequeTypes) .And. cType $ self:cChequeTypes
            nCodTipoTit := 3
        Case AllTrim(cType) == "CN"
            nCodTipoTit := 4
        Case cType $ MVTAXA
            nCodTipoTit := 5
        Case cType $ MVRECANT
            nCodTipoTit := 6
        Case cType $ MV_CRNEG
            nCodTipoTit := 7
        Case cType $ MVABATIM
            nCodTipoTit := 9
        OtherWise
            nCodTipoTit := 8
    EndCase
return nCodTipoTit


//-----------------------------------------------------------------
/*{Protheus.doc} getTypeOfBillText
    Retorna a descricao do tipo de titulo a partir do codigo devolvido por
    getTypeOfBillCode.

    @param nCodTipoTit, numeric, codigo do tipo de titulo
    @return character: descricao traduzida do tipo de titulo

    @author guilherme.sordi@totvs.com.br
    @since 30/11/2023
    @version 12.1.2310
*/
//-----------------------------------------------------------------
method getTypeOfBillText(nCodTipoTit as numeric) as character class GeneralAccountsReceivableStatusReportSmartViewBusinessObject
    local cTypeOfBillText := "-" as character

    default nCodTipoTit := 0

    Do Case
        Case nCodTipoTit == 1
            cTypeOfBillText := STR0014 //Duplicatas
        Case nCodTipoTit == 2
            cTypeOfBillText := STR0015 //Notas fiscais
        Case nCodTipoTit == 3
            cTypeOfBillText := STR0016  //"Cheques Pré"
        Case nCodTipoTit == 4
            cTypeOfBillText := STR0017  //"Carne De Pagamento"
        Case nCodTipoTit == 5
            cTypeOfBillText := STR0018  //"Impostos"
        Case nCodTipoTit == 6
            cTypeOfBillText := STR0019 //Recebimento antecipado
        Case nCodTipoTit == 7
            cTypeOfBillText := STR0020 //Nota de Credito
        Case nCodTipoTit == 8
            cTypeOfBillText := STR0021 //Outros
        Case nCodTipoTit == 9
            cTypeOfBillText := STR0057  //"Abatimentos"
    EndCase
return cTypeOfBillText


//-------------------------------------------------------------------
/*{Protheus.doc} changeCanFilter
@author guilhermed.santos
@since 10/01/2024
@version 12.1.2310
*/
//-------------------------------------------------------------------
method changeCanFilter() class GeneralAccountsReceivableStatusReportSmartViewBusinessObject
    local aSchemaProperties := {} as array
    local cProperty         := "" as character
    local nX                := 1  as numeric

    aSchemaProperties := self:oSchema:getProperties()

    for nX := 1 to Len(aSchemaProperties)
        cProperty := aSchemaProperties[nX]:getName()
        if !self:jRelationSE1SC5:hasProperty(cProperty)
            self:setCanFilter(cProperty,.F.)
        endIf
    next nX
return


//-------------------------------------------------------------------
/*{Protheus.doc} filterWithRelationOfSC5
@author guilhermed.santos
@since 10/01/2024
@version 12.1.2310
*/
//-------------------------------------------------------------------
method filterWithRelationOfSC5() as character class GeneralAccountsReceivableStatusReportSmartViewBusinessObject
    local aRelationProperties   := {} as array
    local cFilter               := "" as character
    local nX                    := 1  as numeric

    cFilter := self:getFilterToSQL()

    if empty(cFilter)
        return cFilter
    endIf

    aRelationProperties := self:jRelationSE1SC5:GetNames()
    
    for nX := 1 to Len(aRelationProperties)
        cFilter := replace(cFilter,aRelationProperties[nX],self:jRelationSE1SC5:GetJSonObject(aRelationProperties[nX]))
    next nX

return cFilter


//-----------------------------------------------------------------
/*{Protheus.doc} getSalesOrderAgingCode
    Retorna o codigo da faixa de aging do item de pedido de venda.

    @param nDias, numeric, dias a vencer ou em atraso
    @param lAtrasado, logical, indica item com entrega prevista anterior a data base

    @return numeric: 0 = nao se aplica, 1 = vencido, 2 = ate 30, 3 = 31 a 60, 4 = 61 a 90, 5 = acima de 90

    @author raphael.ramos
    @since 11/09/2026
    @version 12.1.2510
*/
//-----------------------------------------------------------------
method getSalesOrderAgingCode(nDias as numeric, lAtrasado as logical) as numeric class GeneralAccountsReceivableStatusReportSmartViewBusinessObject
    local nCodAgingPed := 0 as numeric

    default nDias := 0
    default lAtrasado := .F.

    If lAtrasado
        Return 1
    EndIf

    If nDias <= 30
        nCodAgingPed := 2
    ElseIf nDias > 30 .And. nDias <= 60
        nCodAgingPed := 3
    ElseIf nDias > 60 .And. nDias <= 90
        nCodAgingPed := 4
    Else
        nCodAgingPed := 5
    EndIf

return nCodAgingPed


//-----------------------------------------------------------------
/*{Protheus.doc} getSalesOrderAgingText
    Retorna a descricao da faixa de aging do pedido a partir do codigo devolvido
    por getSalesOrderAgingCode.

    @param nCodAgingPed, numeric, codigo da faixa de aging do pedido
    @return character: descricao da faixa

    @author raphael.ramos
    @since 11/09/2026
    @version 12.1.2510
*/
//-----------------------------------------------------------------
method getSalesOrderAgingText(nCodAgingPed as numeric) as character class GeneralAccountsReceivableStatusReportSmartViewBusinessObject
    local cAgingText := "-" as character

    default nCodAgingPed := 0

    Do Case
        Case nCodAgingPed == 1
            cAgingText := STR0055 //"Itens de Pedidos Vencidos"
        Case nCodAgingPed == 2
            cAgingText := STR0056 //"Ate 30 Dias"
        Case nCodAgingPed == 3
            cAgingText := STR0024 //"De 31 a 60 Dias"
        Case nCodAgingPed == 4
            cAgingText := STR0025 //"De 61 a 90 Dias"
        Case nCodAgingPed == 5
            cAgingText := STR0026 //"Acima de 90 Dias"
    EndCase

return cAgingText


//-----------------------------------------------------------------
/*{Protheus.doc} getCategoryText
    Retorna a descricao da categoria a partir do codigo do bloco. A numeracao
    segue a ordem das secoes impressas no relatorio legado FINR320, para que
    ordenar por COD_BLOCO reproduza a ordem do relatorio.

    @param nCodBloco, numeric, codigo do bloco do relatorio
    @return character: descricao traduzida da categoria

    @author raphael.ramos
    @since 11/09/2026
    @version 12.1.2510
*/
//-----------------------------------------------------------------
method getCategoryText(nCodBloco as numeric) as character class GeneralAccountsReceivableStatusReportSmartViewBusinessObject
    local cCategoria := "" as character

    default nCodBloco := 0

    Do Case
        Case nCodBloco == 1
            cCategoria := STR0052 //"FATURAMENTO (no mês)"
        Case nCodBloco == 2
            cCategoria := STR0027 //"VALORES BAIXADOS"
        Case nCodBloco == 3
            cCategoria := STR0012 //"TITULOS A VENCER"
        Case nCodBloco == 4
            cCategoria := STR0013 //"TITULOS VENCIDOS"
        Case nCodBloco == 7
            cCategoria := STR0058 //"ABATIMENTOS/OUTROS"
    EndCase

return cCategoria


//-----------------------------------------------------------------
/*{Protheus.doc} getSaleTypeCode
    Retorna o codigo do tipo de venda a partir do prazo em dias entre a emissao
    e o vencimento do titulo.

    @param nDiasPrazo, numeric, dias entre emissao e vencimento
    @return numeric: 1 = a vista, 2 = a prazo

    @author raphael.ramos
    @since 11/09/2026
    @version 12.1.2510
*/
//-----------------------------------------------------------------
method getSaleTypeCode(nDiasPrazo as numeric) as numeric class GeneralAccountsReceivableStatusReportSmartViewBusinessObject
    local nCodTpVenda := 0 as numeric

    default nDiasPrazo := 0

    If nDiasPrazo <= 1
        nCodTpVenda := 1
    Else
        nCodTpVenda := 2
    EndIf

return nCodTpVenda


//-----------------------------------------------------------------
/*{Protheus.doc} getSaleTypeText
    Retorna a descricao do tipo de venda a partir do codigo. O codigo 3
    identifica os registros originados de pedido de venda.

    @param nCodTpVenda, numeric, codigo do tipo de venda
    @return character: descricao traduzida do tipo de venda

    @author raphael.ramos
    @since 11/09/2026
    @version 12.1.2510
*/
//-----------------------------------------------------------------
method getSaleTypeText(nCodTpVenda as numeric) as character class GeneralAccountsReceivableStatusReportSmartViewBusinessObject
    local cTipoVenda := "" as character

    default nCodTpVenda := 0

    Do Case
        Case nCodTpVenda == 1
            cTipoVenda := STR0028 //"A vista"
        Case nCodTpVenda == 2
            cTipoVenda := STR0029 //"A prazo"
        Case nCodTpVenda == 3
            cTipoVenda := STR0037 //"Pedido de Venda"
    EndCase

return cTipoVenda


//-----------------------------------------------------------------
/*{Protheus.doc} getTypeSeparator
    Retorna o separador usado na constante de tipos de titulo informada.

    @param cTypes, character, conteudo da constante de tipos
    @return character: "|" quando a constante usa pipe, "," caso contrario

    @author raphael.ramos
    @since 11/09/2026
    @version 12.1.2510
*/
//-----------------------------------------------------------------
method getTypeSeparator(cTypes as character) as character class GeneralAccountsReceivableStatusReportSmartViewBusinessObject
    local cSeparator := "," as character

    default cTypes := ""

    If "|" $ cTypes
        cSeparator := "|"
    EndIf

return cSeparator


//-----------------------------------------------------------------
/*{Protheus.doc} getListaDeFaturamentoNoMes
    Monta a query do bloco FATURAMENTO (no mes), equivalente aos acumuladores
    aVal[1] (A Vista) e aVal[2] (A Prazo) do FINR320.

    O universo e diferente do bloco de titulos a receber: o legado considera
    todo titulo emitido no mes da data base, independente de saldo e sem
    restricao de vencimento, e por isso o bloco exige um dataset proprio.

    @author raphael.ramos
    @since 11/09/2026
    @version 12.1.2510
*/
//-----------------------------------------------------------------
method getListaDeFaturamentoNoMes() class GeneralAccountsReceivableStatusReportSmartViewBusinessObject
    local cQuery        := "" as character
    local nParam        := 1  as numeric
    local dFirstDay     := FirstDate(dDataBase) as date
    local dLastDay      := LastDay(dDataBase)  as date
    local aTipoTitNotIn := {} as array

    //Obtem array para uso no setIn com os tipos de titulos
    self:getNotInTypeTitle(MVPROVIS, @aTipoTitNotIn)
    self:getNotInTypeTitle(MVABATIM, @aTipoTitNotIn)
    self:getNotInTypeTitle(MVRECANT, @aTipoTitNotIn)
    self:getNotInTypeTitle(MV_CRNEG, @aTipoTitNotIn)

    cQuery := " SELECT "
    cQuery += "  SE1.E1_FILIAL, SE1.E1_PREFIXO, SE1.E1_NUM, SE1.E1_PARCELA, SE1.E1_TIPO, "
    cQuery += "  SE1.E1_NATUREZ, SE1.E1_CLIENTE, SE1.E1_LOJA, SE1.E1_NOMCLI, "
    cQuery += "  SE1.E1_EMISSAO, SE1.E1_VENCREA, SE1.E1_VALOR, SE1.E1_MOEDA, SE1.E1_TXMOEDA, "
    cQuery += "  SED.ED_DESCRIC ED_DESCRIC "
    cQuery += " FROM " + RetSQLName("SE1") + " SE1 "

    cQuery += " LEFT JOIN " + RetSQLName("SED") + " SED ON " + FWJoinFilial("SED", "SE1") + " "
    cQuery += "  AND SED.ED_CODIGO = SE1.E1_NATUREZ"
    cQuery += "  AND SED.D_E_L_E_T_ = ? "
    cQuery += " WHERE "
    if self:lEmptyMultiBranches
        cQuery += " SE1.E1_FILIAL = ? AND "
    else
        cQuery += " SE1.E1_FILIAL IN (?) AND "
    endIf
    cQuery += " SE1.E1_EMISSAO BETWEEN ? AND ? AND "
    cQuery += " SE1.E1_PREFIXO BETWEEN ? AND ? AND "

    cQuery += " SE1.E1_TIPO NOT IN (?) AND "

    if !self:lListarOutrasMoedas
        cQuery += " SE1.E1_MOEDA = ? AND "
    endIf

    //Titulo aglutinado em fatura ja emitida nao compoe o faturamento do mes.
    cQuery += " ( SE1.E1_FATURA = ? OR SE1.E1_FATURA = ? ) AND "
    cQuery += " ( SE1.E1_DTFATUR > ? OR SE1.E1_DTFATUR = ? ) AND "
    cQuery += " SE1.E1_TIPOLIQ = ? AND "
    cQuery += " ( SE1.E1_DESDOBR <> ? OR ( SE1.E1_DESDOBR = ? AND SE1.E1_STATUS = ? ) ) AND "

    cQuery += " SE1.D_E_L_E_T_ = ? "

    cQuery += " ? "

    cQuery := ChangeQuery(cQuery)

    self:oQueryFatMes := FWExecStatement():New(cQuery)

    self:oQueryFatMes:SetString(nParam++, ' ') //SED

    if self:lEmptyMultiBranches
        self:oQueryFatMes:SetString(nParam++, self:oFilterBranches["SE1"][1])
    else
        self:oQueryFatMes:SetIn(nParam++, self:oFilterBranches["SE1"][1])
    endIf

    self:oQueryFatMes:SetDate(nParam++, dFirstDay)
    self:oQueryFatMes:SetDate(nParam++, dLastDay)
    self:oQueryFatMes:SetString(nParam++, self:cInitialprefix)
    self:oQueryFatMes:SetString(nParam++, self:cFinalprefix)

    self:oQueryFatMes:SetIn(nParam++, aTipoTitNotIn)

    if !self:lListarOutrasMoedas
        self:oQueryFatMes:SetNumeric(nParam++, self:nCurrency)
    endIf

    self:oQueryFatMes:SetString(nParam++, ' ')       //E1_FATURA em branco
    self:oQueryFatMes:SetString(nParam++, 'NOTFAT')  //E1_FATURA marcado como nao faturado
    self:oQueryFatMes:SetDate(nParam++, dDataBase)   //E1_DTFATUR posterior a data base
    self:oQueryFatMes:SetString(nParam++, Space(8))  //E1_DTFATUR em branco
    self:oQueryFatMes:SetString(nParam++, ' ')       //E1_TIPOLIQ
    self:oQueryFatMes:SetString(nParam++, '1')       //E1_DESDOBR diferente de 1
    self:oQueryFatMes:SetString(nParam++, '1')       //E1_DESDOBR igual a 1
    self:oQueryFatMes:SetString(nParam++, 'A')       //E1_STATUS ativo

    self:oQueryFatMes:SetString(nParam++, ' ')
    self:oQueryFatMes:SetUnsafe(nParam++, self:getFilterToSQL())

return


//-----------------------------------------------------------------
/*{Protheus.doc} setDataListaDeFaturamentoNoMes
    Adiciona no objeto de negocios as linhas do bloco FATURAMENTO (no mes).

    @return object: self:oData

    @author raphael.ramos
    @since 11/09/2026
    @version 12.1.2510
*/
//-----------------------------------------------------------------
method setDataListaDeFaturamentoNoMes() as object class GeneralAccountsReceivableStatusReportSmartViewBusinessObject
    local cCategoria  := "" as character
    local cTipoVenda  := "" as character
    local nCodTpVenda := 0  as numeric
    local nDiasPrazo  := 0  as numeric
    local nFaturaMes  := 0  as numeric

    (self:cAlias)->(DBGoTop())

    cCategoria := self:getCategoryText(1) //FATURAMENTO (no mes)

    While !(self:cAlias)->(Eof())

        nDiasPrazo  := StoD((self:cAlias)->E1_VENCREA) - StoD((self:cAlias)->E1_EMISSAO)
        nCodTpVenda := self:getSaleTypeCode(nDiasPrazo)
        cTipoVenda  := self:getSaleTypeText(nCodTpVenda)

        nFaturaMes := xMoeda((self:cAlias)->E1_VALOR,(self:cAlias)->E1_MOEDA,self:nCurrency,;
            (self:cAlias)->E1_EMISSAO,self:nDecimals,(self:cAlias)->E1_TXMOEDA)

        self:jData := {"E1_FILIAL":     AllTrim((self:cAlias)->E1_FILIAL),;
            "E1_CLIENTE":   AllTrim((self:cAlias)->E1_CLIENTE),;
            "E1_LOJA":      AllTrim((self:cAlias)->E1_LOJA),;
            "E1_NOMCLI":    AllTrim((self:cAlias)->E1_NOMCLI),;
            "E1_PREFIXO":   AllTrim((self:cAlias)->E1_PREFIXO),;
            "E1_NUM":       AllTrim((self:cAlias)->E1_NUM),;
            "E1_PARCELA":   AllTrim((self:cAlias)->E1_PARCELA),;
            "E1_TIPO":      AllTrim((self:cAlias)->E1_TIPO),;
            "E1_EMISSAO":   self:varToTimeStamp( (self:cAlias)->E1_EMISSAO ),;
            "E1_VENCREA":   self:varToTimeStamp( (self:cAlias)->E1_VENCREA ),;
            "E1_BAIXA":     Nil,;
            "E1_VALOR":     0,;
            "E1_SALDO":     0,;
            "FK1_VALOR":    0,;
            "E1_NATUREZ":   MascNat((self:cAlias)->E1_NATUREZ),;
            "ED_DESCRIC":   AllTrim((self:cAlias)->ED_DESCRIC),;
            "E1_SITUACA":   "",;
            "FRV_DESCRI":   "",;
            "TIPOVENDA":   cTipoVenda,;
            "TIPOTITULO":   "-",;
            "CATEG_TITULO": cCategoria,;
            "AGING_TITULO": "-",;
            "COD_ORIGEM":     4,;
            "COD_BLOCO":      1,;
            "COD_AGING":      0,;
            "COD_AGING_PED":  0,;
            "COD_TIPOTITULO": 0,;
            "COD_TIPOVENDA":  nCodTpVenda,;
            "FL_DISTRIB":     0,;
            "FATURA_MES":     nFaturaMes,;
            "SALDO_QUOC":     0,;
            "DIAS_PRAZO":     nDiasPrazo,;
            "RECEBIDO":       0,;
            "JUROS":          0,;
            "MULTA":          0,;
            "DESCONTO":       0,;
            "VALOR_CORRECAO":0,;
            "VALOR_ACESSORIO":0}

        self:processAndAppend()

        (self:cAlias)->( dbSkip() )

    EndDo

return self:oData


//-----------------------------------------------------------------
/*{Protheus.doc} getListaDeProvisoriosEAbatimentos
    Monta a query dos titulos provisorios e de abatimento, equivalente aos
    acumuladores aVal[16] (Outros) e aVal[35] (Abatimentos) do FINR320.

    @author raphael.ramos
    @since 11/09/2026
    @version 12.1.2510
*/
//-----------------------------------------------------------------
method getListaDeProvisoriosEAbatimentos() class GeneralAccountsReceivableStatusReportSmartViewBusinessObject
    local cQuery := "" as character
    local nParam := 1  as numeric
    local aTipoIn := {} as array

    //Obtem array para uso no setIn com os tipos de titulos
    self:getNotInTypeTitle(MVPROVIS, @aTipoNotIn)
    self:getNotInTypeTitle(MVABATIM, @aTipoNotIn)

    cQuery := " SELECT "
    cQuery += "  SE1.E1_FILIAL, SE1.E1_PREFIXO, SE1.E1_NUM, SE1.E1_PARCELA, SE1.E1_TIPO, "
    cQuery += "  SE1.E1_NATUREZ, SE1.E1_CLIENTE, SE1.E1_LOJA, SE1.E1_NOMCLI, "
    cQuery += "  SE1.E1_EMISSAO, SE1.E1_VENCREA, SE1.E1_BAIXA, SE1.E1_VALOR, SE1.E1_SALDO, "
    cQuery += "  SE1.E1_MOEDA, SE1.E1_TXMOEDA, SED.ED_DESCRIC ED_DESCRIC "
    cQuery += " FROM " + RetSQLName("SE1") + " SE1 "

    cQuery += " LEFT JOIN " + RetSQLName("SED") + " SED ON " + FWJoinFilial("SED", "SE1") + " "
    cQuery += "  AND SED.ED_CODIGO = SE1.E1_NATUREZ"
    cQuery += "  AND SED.D_E_L_E_T_ = ? "
    cQuery += " WHERE "
    if self:lEmptyMultiBranches
        cQuery += " SE1.E1_FILIAL = ? AND "
    else
        cQuery += " SE1.E1_FILIAL IN (?) AND "
    endIf
    cQuery += " SE1.E1_PREFIXO BETWEEN ? AND ? AND "

    cQuery += " SE1.E1_TIPO IN (?) AND "

    if !self:lListarOutrasMoedas
        cQuery += " SE1.E1_MOEDA = ? AND "
    endIf

    cQuery += " ( SE1.E1_FATURA = ? OR SE1.E1_FATURA = ? ) AND "
    cQuery += " ( SE1.E1_DTFATUR > ? OR SE1.E1_DTFATUR = ? ) AND "
    cQuery += " SE1.E1_TIPOLIQ = ? AND "
    cQuery += " ( SE1.E1_DESDOBR <> ? OR ( SE1.E1_DESDOBR = ? AND SE1.E1_STATUS = ? ) ) AND "

    cQuery += " SE1.D_E_L_E_T_ = ? "

    cQuery += " ? "

    cQuery := ChangeQuery(cQuery)

    self:oQueryProvAbat := FWExecStatement():New(cQuery)

    self:oQueryProvAbat:SetString(nParam++, ' ') //SED

    if self:lEmptyMultiBranches
        self:oQueryProvAbat:SetString(nParam++, self:oFilterBranches["SE1"][1])
    else
        self:oQueryProvAbat:SetIn(nParam++, self:oFilterBranches["SE1"][1])
    endIf

    self:oQueryProvAbat:SetString(nParam++, self:cInitialprefix)
    self:oQueryProvAbat:SetString(nParam++, self:cFinalprefix)
    self:oQueryProvAbat:SetIn(nParam++, aTipoIn)

    if !self:lListarOutrasMoedas
        self:oQueryProvAbat:SetNumeric(nParam++, self:nCurrency)
    endIf

    self:oQueryProvAbat:SetString(nParam++, ' ')       //E1_FATURA em branco
    self:oQueryProvAbat:SetString(nParam++, 'NOTFAT')  //E1_FATURA marcado como nao faturado
    self:oQueryProvAbat:SetDate(nParam++, dDataBase)   //E1_DTFATUR posterior a data base
    self:oQueryProvAbat:SetString(nParam++, Space(8))  //E1_DTFATUR em branco
    self:oQueryProvAbat:SetString(nParam++, ' ')       //E1_TIPOLIQ
    self:oQueryProvAbat:SetString(nParam++, '1')       //E1_DESDOBR diferente de 1
    self:oQueryProvAbat:SetString(nParam++, '1')       //E1_DESDOBR igual a 1
    self:oQueryProvAbat:SetString(nParam++, 'A')       //E1_STATUS ativo

    self:oQueryProvAbat:SetString(nParam++, ' ')
    self:oQueryProvAbat:SetUnsafe(nParam++, self:getFilterToSQL())

return


//-----------------------------------------------------------------
/*{Protheus.doc} setDataListaDeProvisoriosEAbatimentos
    Adiciona no objeto de negocios as linhas de titulo provisorio e de
    abatimento, que no FINR320 alimentam apenas o bloco POR TIPO DE TITULO.

    @return object: self:oData

    @author raphael.ramos
    @since 11/09/2026
    @version 12.1.2510
*/
//-----------------------------------------------------------------
method setDataListaDeProvisoriosEAbatimentos() as object class GeneralAccountsReceivableStatusReportSmartViewBusinessObject
    local cTipoVenda  := "" as character
    local cTipoTitulo := "" as character
    local cCategoria  := "" as character
    local nCodTipoTit := 0  as numeric
    local nCodTpVenda := 0  as numeric
    local nDiasPrazo  := 0  as numeric
    local nBase       := 0  as numeric
    local nValor      := 0  as numeric
    local nSaldo      := 0  as numeric

    (self:cAlias)->(DBGoTop())

    //Estas linhas alimentam exclusivamente o bloco POR TIPO DE TITULO, 
    cCategoria := self:getCategoryText(7) //POR TIPO DE TITULO

    While !(self:cAlias)->(Eof())

        If (self:cAlias)->E1_TIPO $ MVABATIM
            nCodTipoTit := 9 //Abatimentos
            If dDataBase < StoD((self:cAlias)->E1_BAIXA)
                nBase := (self:cAlias)->E1_VALOR
            Else
                nBase := (self:cAlias)->E1_SALDO
            EndIf
        Else
            nCodTipoTit := 8 //Outros
            nBase := (self:cAlias)->E1_SALDO
        EndIf

        If nBase == 0
            (self:cAlias)->( dbSkip() )
            Loop
        EndIf

        cTipoTitulo := self:getTypeOfBillText(nCodTipoTit)

        nDiasPrazo  := StoD((self:cAlias)->E1_VENCREA) - StoD((self:cAlias)->E1_EMISSAO)
        nCodTpVenda := self:getSaleTypeCode(nDiasPrazo)
        cTipoVenda  := self:getSaleTypeText(nCodTpVenda)

        nValor := xMoeda((self:cAlias)->E1_VALOR,(self:cAlias)->E1_MOEDA,self:nCurrency,;
            (self:cAlias)->E1_EMISSAO,self:nDecimals,(self:cAlias)->E1_TXMOEDA)
        nSaldo := xMoeda(nBase,(self:cAlias)->E1_MOEDA,self:nCurrency,;
            (self:cAlias)->E1_EMISSAO,self:nDecimals,(self:cAlias)->E1_TXMOEDA)

        self:jData := {"E1_FILIAL":     AllTrim((self:cAlias)->E1_FILIAL),;
            "E1_CLIENTE":   AllTrim((self:cAlias)->E1_CLIENTE),;
            "E1_LOJA":      AllTrim((self:cAlias)->E1_LOJA),;
            "E1_NOMCLI":    AllTrim((self:cAlias)->E1_NOMCLI),;
            "E1_PREFIXO":   AllTrim((self:cAlias)->E1_PREFIXO),;
            "E1_NUM":       AllTrim((self:cAlias)->E1_NUM),;
            "E1_PARCELA":   AllTrim((self:cAlias)->E1_PARCELA),;
            "E1_TIPO":      AllTrim((self:cAlias)->E1_TIPO),;
            "E1_EMISSAO":   self:varToTimeStamp( (self:cAlias)->E1_EMISSAO ),;
            "E1_VENCREA":   self:varToTimeStamp( (self:cAlias)->E1_VENCREA ),;
            "E1_BAIXA":     Nil,;
            "E1_VALOR":     nValor,;
            "E1_SALDO":     nSaldo,;
            "FK1_VALOR":    0,;
            "E1_NATUREZ":   MascNat((self:cAlias)->E1_NATUREZ),;
            "ED_DESCRIC":   AllTrim((self:cAlias)->ED_DESCRIC),;
            "E1_SITUACA":   "",;
            "FRV_DESCRI":   "",;
            "TIPOVENDA":   cTipoVenda,;
            "TIPOTITULO":   cTipoTitulo,;
            "CATEG_TITULO": cCategoria,;
            "AGING_TITULO": "-",;
            "COD_ORIGEM":     5,;
            "COD_BLOCO":      7,;
            "COD_AGING":      0,;
            "COD_AGING_PED":  0,;
            "COD_TIPOTITULO": nCodTipoTit,;
            "COD_TIPOVENDA":  nCodTpVenda,;
            "FL_DISTRIB":     0,;
            "FATURA_MES":     0,;
            "SALDO_QUOC":     0,;
            "DIAS_PRAZO":     0,;
            "RECEBIDO":       0,;
            "JUROS":          0,;
            "MULTA":          0,;
            "DESCONTO":       0,;
            "VALOR_CORRECAO":0,;
            "VALOR_ACESSORIO":0}

        self:processAndAppend()

        (self:cAlias)->( dbSkip() )

    EndDo

return self:oData


//-----------------------------------------------------------------
/*{Protheus.doc} hasWithholdingTax
    Indica se a natureza do titulo posicionado no alias corrente calcula alguma
    retencao, reproduzindo o gate de FR320RtImp no FINR320: se a natureza nao
    calcula IRRF, INSS, PIS, COFINS, CSLL nem ISS, o legado nao procura
    abatimento e portanto nada e descontado do saldo.

    Os flags vem da SED, que ja esta no join da query de titulos, entao a
    verificacao nao custa acesso adicional e evita chamar SomaAbat para
    titulos que nao teriam abatimento a descontar.

    @return logical: .T. quando a natureza calcula ao menos uma retencao

    @author raphael.ramos
    @since 14/09/2026
    @version 12.1.2510
*/
//-----------------------------------------------------------------
method hasWithholdingTax() as logical class GeneralAccountsReceivableStatusReportSmartViewBusinessObject
    local lTemReten := .F. as logical

    lTemReten := (self:cAlias)->ED_CALCIRF == "S" .Or. ;
                 (self:cAlias)->ED_CALCINS == "S" .Or. ;
                 (self:cAlias)->ED_CALCPIS == "S" .Or. ;
                 (self:cAlias)->ED_CALCCOF == "S" .Or. ;
                 (self:cAlias)->ED_CALCCSL == "S" .Or. ;
                 (self:cAlias)->ED_CALCISS == "S"

return lTemReten

//-----------------------------------------------------------------
/*{Protheus.doc} getNotInTypeTitle
    Realiza a separação do coneteudo informado do parametro cVarParam com base no tipo de separador retornado da
    função getTypeSeparator

    @param cVarParam, Character, conteudo do parametro a ser separado
    @param aParamDest, Array, Array que recebrá o conteudo informado no cVarparam após a separação

    @author raphael.ramos
    @since 21/09/2026
    @version 12.1.2510
*/
//-----------------------------------------------------------------
method getNotInTypeTitle(cVarParam as character, aParamDest as array) class GeneralAccountsReceivableStatusReportSmartViewBusinessObject

    local aParamOri     := {}   as array

    default cVarParam   := ""
    default aParamDest  := {}

    If ValType(cVarParam) == "C" .AND. !Empty(cVarParam)
        aParamOri := StrTokArr2(cVarParam, self:getTypeSeparator(cVarParam))

        If Len(aParamOri) > 0
            AEval(aParamOri, {|x| AAdd(aParamDest, x)})
        EndIf
    EndIf

return
