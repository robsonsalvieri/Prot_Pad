#include "msobject.ch"
#include "totvs.ch"
#include "tlpp-core.th"
#include "backoffice.fin.financiallabel.ch"

#define LABEL_CONDITION 1
#define LABEL_COLOR 2
#define LABEL_DESCRIPTION 3

//-------------------------------------------------------------------
/*/{Protheus.doc} backoffice.fin.financialLabel
    @description Fonte utilizado para centralizar funções relacionadas às legendas do módulo financeiro.

    Funções disponíveis:
    - getDefaultFinancialLabel: Retorna as legendas padrão do módulo financeiro, podendo ser filtrada por contas a pagar ou receber.

    @since  19/05/2026
/*/
//-------------------------------------------------------------------

namespace totvs.protheus.backoffice.fin.financialLabel

//-------------------------------------------------------------------
/*{Protheus.doc} getDefaultFinancialLabel
    @description Retorna as legendas padrão de acordo com o alias recebido via parâmetro.
    @param cAlias: Alias para o qual a legenda será carregada (SE1/SE2).
            aBrwLegenda: 1ª posição indica se será exibida a tela de legenda, 
                         2ª posição título da tela, 
                         3ª posição subtitulo da tela.
    @type Function
    @author guilhermed.santos
    @since 06/05/2026
*/
//-------------------------------------------------------------------
function getDefaultFinancialLabel(cAlias as character, aBrwLegenda as array) as array
    local aLabel := {} as array
    local lPeFinLegen := existBlock( "FINLEGEN" ) as logical

    default cAlias := ""
    default aBrwLegenda := {}

    if cAlias == 'SE1'
        aLabel := getBillsReceivableDefaultLabel()
    elseIf cAlias == 'SE2'
        aLabel := getBillsPayableDefaultLabel()
    endIf

    aadd(aLabel,{".T.", "BR_VERDE", STR0001}) //Em aberto

    if lPeFinLegen
        aLabel := processEntryPoint(aLabel)
    endIf

    if len(aBrwLegenda) > 1 .and. aBrwLegenda[1] == .T.
        showBrwLegenda(aLabel,aBrwLegenda)
    endIf

return aLabel

//-------------------------------------------------------------------
/*{Protheus.doc} getBillsReceivableDefaultLabel
    @description Retorna as legendas padrão do Contas a Receber.
    @type Static Function
    @author guilhermed.santos
    @since 06/05/2026
*/
//-------------------------------------------------------------------
static function getBillsReceivableDefaultLabel() as array
    local aLabel := {} as array
    local cTitTemPIX := "TitTemPIX(E1_FILIAL,E1_PREFIXO,E1_NUM,E1_PARCELA,E1_TIPO,E1_CLIENTE,E1_LOJA, E1_FILORIG)" as character
    local cOriCobrDiv := OriCobrDiv() as character
    local cfinXTitCo := ".F." as character

    if findFunction('finXTitCo')
        cfinXTitCo := "finXTitCo(SE1->E1_NATUREZ)"
    endIf

    aadd(aLabel,{"JurCNF(SE1->(Recno()),SE1->E1_JURFAT,SE1->E1_SALDO)", "BR_AZUL_CLARO", STR0008}) //Fatura cancelada (SIGAPFS)
    aadd(aLabel,{"ROUND(E1_SALDO,2) = 0", "BR_VERMELHO", STR0003}) //Baixado 
    
    if cPaisLoc == "BRA" .and. findFunction("FINA890")
        aadd(aLabel,{cTitTemPIX + " .AND. !Empty(E1_NUMBOR) .AND.(ROUND(E1_SALDO,2) # ROUND(E1_VALOR,2))", "BR_VIOLETA", STR0012}) //Baixado parcialmente e em PIX e Borderô
        aadd(aLabel,{cTitTemPIX + " .AND.(ROUND(E1_SALDO,2) # ROUND(E1_VALOR,2))", "BR_MARROM", STR0010}) //Baixado parcialmente e em PIX
        aadd(aLabel,{cTitTemPIX + " .AND. !Empty(E1_NUMBOR)", "BR_PINK", STR0011}) //Em PIX e Borderô
        aadd(aLabel,{cTitTemPIX , "BR_LARANJA", STR0009}) //Título em PIX
    endIf
    
    aadd(aLabel,{"!Empty(E1_NUMBOR) .AND.(ROUND(E1_SALDO,2) # ROUND(E1_VALOR,2))", "BR_CINZA", STR0006}) //Baixado parcialmente e em borderô
    aadd(aLabel,{"E1_TIPO == '"+MVRECANT+"'.AND. ROUND(E1_SALDO,2) > 0 .AND. !"+cfinXTitCo, "BR_BRANCO", STR0005}) //Adiantamento com saldo
    aadd(aLabel,{"!Empty(E1_NUMBOR)", "BR_PRETO", STR0004}) // Em borderô
    aadd(aLabel,{"!((ROUND(E1_SDACRES,2)>0.OR.ROUND(E1_ACRESC,2)>0) .AND. ROUND(E1_SALDO,2)=ROUND(E1_VALOR,2)) .AND. ROUND(E1_SALDO,2) + ROUND(E1_SDACRES,2) # ROUND(E1_VALOR,2) + ROUND(E1_ACRESC,2) .AND. !"+cfinXTitCo, "BR_AZUL", STR0002}) //Baixado parcialmente
    aadd(aLabel,{"ROUND(E1_SALDO,2) == ROUND(E1_VALOR,2) .AND. AllTrim(E1_SITUACA)== 'F'", "BR_VERDE_ESCURO", STR0007}) //Protestado
    
    if cPaisLoc == "MEX" .and. X3Usado("ED_OPERADT")
        aadd(aLabel,{"E1_ORIGEM == 'MATA467N' .AND. ROUND(E1_SALDO,2) > 0 .AND. "+cfinXTitCo, "BR_PINK", STR0013}) //Adiantamento gerado por Nota Fiscal
        aadd(aLabel,{"ALLTRIM(E1_ORIGEM) $ 'FINA087A|"+cOriCobrDiv+"' .AND. ROUND(E1_SALDO,2) > 0 .AND. "+cfinXTitCo+" .AND. E1_TIPO == '"+MVRECANT+"'", "BR_LARANJA", STR0014}) //Título com operacão de adiantamento
    endIf
return aLabel

//-------------------------------------------------------------------
/*{Protheus.doc} getBillsPayableDefaultLabel
    @description Retorna as legendas padrão do Contas a Pagar.
    @type Static Function
    @author guilhermed.santos
    @since 06/05/2026
*/
//-------------------------------------------------------------------
static function getBillsPayableDefaultLabel() as array
    local aLabel := {} as array
    local cMvVlMinPg := "0" as character
    local lPrjCni := ValidaCNI() as logical
    local lFaLegPares := .F. as logical
    local lFinUsaDH := FinUsaDH() as logical


    if existBlock("FaLegPARes")
        lFaLegPares := execBlock("FaLegPARes",.f.,.f.)
    endIf

    cMvVlMinPg := cValToChar(SuperGetMV('MV_VLMINPG',.F.,0))

    if lPrjCni
        if !empty(superGetMv("MV_APRPAG",.F.,"")) .or. superGetMv("MV_CTLIPAG",.F.,.F.)
            aadd(aLabel,{"EMPTY(E2_DATALIB) .AND. (SE2->E2_SALDO+SE2->E2_SDACRES-SE2->E2_SDDECRE) > " + cMvVlMinPg + " .AND. E2_SALDO > 0", "BR_PINK", STR0015}) //Aguardando liberação
        endIf
    else
        if superGetMv("MV_CTLIPAG",.F.,.F.)
            aadd(aLabel,{"!( SE2->E2_TIPO $ MVPAGANT ).AND. EMPTY(E2_DATALIB) .AND. (SE2->E2_SALDO+SE2->E2_SDACRES-SE2->E2_SDDECRE) > " + cMvVlMinPg + " .AND. E2_SALDO > 0", "BR_PINK", STR0015}) //Aguardando liberação
        endIf
    endIf

    aadd(aLabel,{"(ALLTRIM(SE2->E2_ORIGEM) $ 'FINA667|FINA677') .AND. SE2->E2_MOEDA > 1 .AND. SE2->E2_TXMOEDA == 0 .AND. SE2->E2_SALDO > 0", "BR_LARANJA", STR0016}) //Adiantamento de Viagem sem taxa

    if lFaLegPares
        aadd(aLabel,{"E2_TIPO == '"+MVPAGANT+"' .AND. ROUND(E2_SALDO,2) > 0 .AND. (ROUND(E2_SALDO,2) < ROUND(E2_VALOR,2))", "BR_MARROM", STR0019}) //Adiantamento com resíduo no saldo
    endIf

    if lFinUsaDH
        aadd(aLabel,{"ROUND(E2_SALDO,2) > 0 .AND. !EMPTY(E2_DOCHAB)","BR_VIOLETA", STR0017}) //Vinculado a Docto Hábil
    endIf

    aadd(aLabel,{"E2_TIPO $ 'INA/"+MVTXA+"' .AND. ROUND(E2_SALDO,2) > 0 .AND. E2_OK == 'TA'", "BR_AMARELO", STR0018}) //Adiantamento de Imp. Bx. com saldo
    aadd(aLabel,{"E2_TIPO == '"+MVPAGANT+"' .AND. ROUND(E2_SALDO,2) > 0", "BR_BRANCO", STR0005}) //Adiantamento com saldo
    aadd(aLabel,{"ROUND(E2_SALDO,2) + ROUND(E2_SDACRES,2)  = 0", "BR_VERMELHO", STR0003}) //Baixado
    aadd(aLabel,{"!Empty(E2_NUMBOR) .AND.(ROUND(E2_SALDO,2)+ ROUND(E2_SDACRES,2) # ROUND(E2_VALOR,2)+ ROUND(E2_ACRESC,2))", "BR_CINZA", STR0006}) //Baixado parcialmente e em borderô
    aadd(aLabel,{"!Empty(E2_NUMBOR)", "BR_PRETO", STR0004}) // Em borderô
    aadd(aLabel,{"ROUND(E2_SALDO,2)+ ROUND(E2_SDACRES,2) # ROUND(E2_VALOR,2)+ ROUND(E2_ACRESC,2)", "BR_AZUL", STR0002}) //Baixado parcialmente
return aLabel

//-------------------------------------------------------------------
/*{Protheus.doc} processEntryPoint
    @description Processa o ponto de entrada FINLEGEN para carregar as legendas.
    @type Static Function
    @author guilhermed.santos
    @since 06/05/2026
    @return array: self:aLabel
*/
//-------------------------------------------------------------------
static function processEntryPoint(aLabel as array) as array
    local aLabelEntryPoint  := {} as array
    local aNewLabel         := {} as array
    local cCondition        := "" as character
    local cColor            := "" as character
    local cDescription      := "" as character
    local nFor              := 0 as numeric

    default aLabel := {}

    aLabelEntryPoint := execBlock("FINLEGEN",.F.,.F.,aLabel)

    if len(aLabelEntryPoint) > 0
        for nFor := 1 to len(aLabelEntryPoint)
            if valType(aLabelEntryPoint[nFor]) == 'A' .and. len(aLabelEntryPoint[nFor]) == 3
                cCondition := aLabelEntryPoint[nFor][LABEL_CONDITION]
                cColor := aLabelEntryPoint[nFor][LABEL_COLOR]
                cDescription := aLabelEntryPoint[nFor][LABEL_DESCRIPTION]
                
                if validateLabel(cCondition, cColor, cDescription)
                    aadd(aNewLabel, {cCondition, cColor, cDescription})
                endIf
            endIf
        next
    endIf

    if len(aNewLabel) > 0
        aLabel := aNewLabel
    endIf

return aLabel

//-------------------------------------------------------------------
/*{Protheus.doc} validateLabel
    @description Valida se os parâmetros de entrada são válidos para a adição da legenda.
    @param  cCondition: Condição da legenda.
            cColor: Cor da legenda.
            cDescription: Descrição da legenda.
    @type Static Function
    @author guilhermed.santos
    @since 06/05/2026
    @return logical: lIsValid
*/
//-------------------------------------------------------------------
static function validateLabel(cCondition as character, cColor as character, cDescription as character) as logical
    local lIsValid := .T. as logical

    lIsValid := !(empty(cCondition) .or. empty(cColor) .or. empty(cDescription))
    
    lIsValid := lIsValid .and. !(valType(cCondition) != "C" .or. valType(cColor) != "C" .or. valType(cDescription) != "C")
return lIsValid


//-------------------------------------------------------------------
/*{Protheus.doc} showBrwLegenda
    @description Exibe a tela de legendas com a função BrwLegenda. Removendo a condição
                    da legenda, pois a tela de legenda só exibe cor e descrição.
    @param aLabel: Array contendo as legendas com condição.
    @type Static Function
    @author guilhermed.santos
    @since 30/05/2026
    @return array: aLabel sem a condição
*/
// -------------------------------------------------------------------
static function showBrwLegenda(aLabel as array, aBrwLegenda as array)
    local aNewLabel := {} as array
    local cTitle    := "" as character
    local cSubTitle := "" as character
    local nFor      := 0 as numeric

    default aLabel := {}

    if len(aBrwLegenda) > 2
        cTitle := aBrwLegenda[2]
        cSubTitle := aBrwLegenda[3]
    endIf

    if len(aLabel) > 0
        for nFor := 1 to len(aLabel)
            aadd(aNewLabel, {aLabel[nFor][LABEL_COLOR], aLabel[nFor][LABEL_DESCRIPTION]})
        next
        BrwLegenda(cTitle, cSubTitle, aNewLabel)
    endIf

return
