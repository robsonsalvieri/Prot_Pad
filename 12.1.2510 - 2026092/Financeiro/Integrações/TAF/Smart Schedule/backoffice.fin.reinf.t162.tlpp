#include "msobject.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#Include "TOTVS.CH"

#define IR_TAX_CODE '9'
#define FULL_AMOUNT_YES '1'
#define ACCOUNTING_DATE '1'
#define ISSUE_DATE '2'

namespace totvs.protheus.backoffice.fin.taf.smartschedule

//-------------------------------------------------------------------
/*/{Protheus.doc} DataBlockT162
    Classe responsável por selecionar e montar Json do Bloco T162 (Pagamentos a Beneficiários não Identificados)
    @author guilhermed.santos@totvs.com.br
    @since 08/05/2025
    @version 12.1.2410
*/
//-------------------------------------------------------------------
class DataBlockT162
    protected data cIdDoc as character
    protected data jBlockT162 as json
    protected data lHasDataBlock as logical
    protected data cIssueDateParameter as character

    public method new(cIdDoc as character) as object
    public method loadT162Block()
    public method getHasDataBlock() as logical
    public method getT162Block() as json
    protected method setIdDoc(cIdDoc as character)
    protected method getT162Data() as json
    protected method setHasDataBlock(lHasDataBlock as logical)
endClass


//-------------------------------------------------------------------
/*{Protheus.doc} new
    Construtor
    @return object: self
    @author guilhermed.santos
    @since 08/05/2025
    @version 12.1.2410
*/
//-------------------------------------------------------------------
method new(cIdDoc as character) as object class DataBlockT162
        self:setIdDoc(cIdDoc)
        self:jBlockT162 := jsonObject():new()
        self:setHasDataBlock(.F.)
        self:cIssueDateParameter := "1"
return self

//-------------------------------------------------------------------
/*{Protheus.doc} setIdDoc
    @description Define o conteúdo da propriedade cIdDoc.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 08/05/2025
    @return
*/
//-------------------------------------------------------------------
method setIdDoc(cIdDoc as character) class DataBlockT162
    self:cIdDoc := cIdDoc
return



//-------------------------------------------------------------------
/*{Protheus.doc} loadT162Block
    @description Responsável por acionar os métodos de buscas de registros e montar o json na propriedade self:jBlockT162.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 08/05/2025
    @return
*/
//-------------------------------------------------------------------
method loadT162Block() class DataBlockT162
    local aArea      := {} as array
    local aAreaFK7   := {} as array

    aArea    := getArea()
    aAreaFK7 := FK7->(getArea())

    dbSelectArea('FK7')
    FK7->(dbSetOrder(5)) //FK7_IDDOC
    if FK7->(dbSeek(self:cIdDoc))
        self:jBlockT162 := self:getT162Data()
    endIf

    if self:jBlockT162:hasProperty("T162")
        self:setHasDataBlock(.T.)
    endIf

    restArea(aAreaFK7)
    restArea(aArea)
return


//-------------------------------------------------------------------
/*{Protheus.doc} getT162Block
    @description Retorna a propriedade self:jBlockT162.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 08/05/2025
    @return
*/
//-------------------------------------------------------------------
method getT162Block() as json class DataBlockT162
return self:jBlockT162

//-------------------------------------------------------------------
/*{Protheus.doc} getT162Data
    @description Montagem do Json do bloco T162.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 08/05/2025
    @return
*/
//-------------------------------------------------------------------
method getT162Data() as json class DataBlockT162
	local aArea			:= {} as array
	local aAreaSE1		:= {} as array
	local aAreaFKW		:= {} as array
	local aAreaCCF		:= {} as array
	local aT162			:= {} as array
	local aT162AA		:= {} as array
	Local cBillNumber 	:= "" as character
	local cSeekSE1 		:= "" as character
	local dIssueDate	:= dDataBase as date
	Local nSuspValue   	:= 0 as numeric
	Local nDeposValue  	:= 0 as numeric
	local nTamCCFNum	:= 0 as numeric
	local jT162			:= jsonObject():new() as json


	nTamCCFNum := tamSX3("CCF_NUMERO")[1]

	aArea    := getArea()
    aAreaSE1 := SE1->(getArea())

	cSeekSE1 := FinFK7Key('',self:cIdDoc)

	dbSelectArea("SE1")
	SE1->( DBSetOrder(1) ) //E1_FILIAL+E1_PREFIXO+E1_NUM+E1_PARCELA+E1_TIPO
	if !SE1->(dbSeek(cSeekSE1))
		return jT162
	endIf

	cBillNumber  := alltrim(SE1->E1_NUM)
	if !empty(SE1->E1_PARCELA)
		cBillNumber  += "-" + SE1->E1_PARCELA
	endIf
    if self:cIssueDateParameter == ACCOUNTING_DATE
        dIssueDate := SE1->E1_EMIS1
    else
        dIssueDate := SE1->E1_EMISSAO
    endIf

	aAreaFKW := FKW->(getArea())
    aAreaCCF := CCF->(getArea())

	dbSelectArea("FKW")
	FKW->( dbSetOrder(2) ) //FKW_FILIAL+FKW_IDDOC+FKW_CARTEI+FKW_NATREN+FKW_TPIMP
	if FKW->( dbSeek( xFilial("FKW") + self:cIdDoc + "2" ) )
		while FKW->(!Eof()) .and. alltrim(FKW->(FKW_FILIAL+FKW_IDDOC+FKW_CARTEI)) == alltrim(xFilial("FKW") + self:cIdDoc + "2" )

			if !Empty(FKW->FKW_NUMPRO)
				nSuspValue  := FKW->FKW_VLIMPN
				nDeposValue := 0

				dbSelectArea("CCF")
				CCF->(dbSetOrder(1)) // CCF_FILIAL, CCF_NUMERO, CCF_TIPO	
				CCF->( dbSeek( xFilial("CCF") + PadR( FKW->FKW_NUMPRO, nTamCCFNum ) +  FKW->FKW_TPPROC ) )
				while CCF->( !Eof() ) .AND. CCF->( CCF_FILIAL + CCF_NUMERO + CCF_TIPO ) == xFilial("FKW") + FKW->( FKW_NUMPRO + FKW_TPPROC )					
					if CCF->CCF_TRIB == IR_TAX_CODE
						if CCF->CCF_MONINT == FULL_AMOUNT_YES
							nSuspValue  := 0
							nDeposValue := FKW->FKW_VLIMPN
						endIf
					endIf
					CCF->( DbSkip() )
				endDo

				aadd(aT162AA,{"TP_PROC" : FKW->FKW_TPPROC,;
						"NUM_PROC" : FKW->FKW_NUMPRO,;
						"COD_SUS" : FKW->FKW_CODSUS,;
						"BASE_SUSPENSA" : FKW->FKW_BASENR,;
						"VAL_SUS" : nSuspValue,;
						"VAL_DEPOSITO_IR" : nDeposValue})
			endIf

            aadd(aT162,{"CODIGO_DOCUMENTO" : SE1->(E1_PREFIXO)+cBillNumber,;
						"NATUREZA_DO_RENDIMENTO" : FKW->FKW_NATREN,;
						"DT_PAGAMENTO" : dIssueDate,;
						"VLR_LIQ" : 0,;
						"VLR_REAJUSTADO" : FKW->(FKW_BASETR+FKW->FKW_BASENR),;
						"VLR_IR" : FKW->(FKW_VLIMP+FKW->FKW_VLIMPN),;
						"DESCRICAO" : alltrim(SE1->E1_HIST),;
						"BASE_IR" : FKW->(FKW_BASETR+FKW->FKW_BASENR),;
						"NATUREZ" : '1',;
						"COD_PARTICIPANTE" : 'C'+SE1->(E1_CLIENTE+E1_LOJA),;
                        "T162AA" :aT162AA})
			FKW->( DbSkip() )
		endDo

		jT162["T162"] := aT162
	endIf

	restArea(aAreaCCF)
	restArea(aAreaFKW)
	restArea(aAreaSE1)
    restArea(aArea)

return jT162

//-------------------------------------------------------------------
/*{Protheus.doc} setHasDataBlock
    @description Define o conteúdo da propriedade self:lHasDataBlock.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 08/05/2025
    @return
*/
//-------------------------------------------------------------------
method setHasDataBlock(lHasDataBlock) class DataBlockT162
    self:lHasDataBlock := lHasDataBlock
return

//-------------------------------------------------------------------
/*{Protheus.doc} getHasDataBlock
    @description Retorna o conteúdo da propriedade self:lHasDataBlock.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 08/05/2025
    @return
*/
//-------------------------------------------------------------------
method getHasDataBlock() as logical class DataBlockT162
return self:lHasDataBlock
