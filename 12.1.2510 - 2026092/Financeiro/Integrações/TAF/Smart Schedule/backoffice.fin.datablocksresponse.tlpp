#include "msobject.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#Include "TOTVS.CH"

#define CODE_MOVEMENT_MIT '1'
#define CODE_MOVEMENT_REINF '2'
#define INSERT_OPERATION '1'
#define UPDATE_OPERATION  '2'
#define DELETE_OPERATION '3'
#define POST_OPERATION   '4'
#define CANCEL_POST_OPERATION '5'

namespace totvs.protheus.backoffice.fin.taf.smartschedule

class DataBlocksResponse
    protected data aFkhId       as array
    protected data cIdDoc       as character
    protected data cIdFkMov     as character
    protected data cMovType     as character
    protected data cTaxIdDoc    as character
    protected data cOperation   as character
    protected data oBlockT001AB as object
    protected data oBlockT003   as object
    protected data oBlockT154   as object
    protected data oBlockT157   as object
    protected data oBlockT158   as object
    protected data oBlockT159   as object
    protected data oBlockT162   as object
    protected data oBlockT999   as object
    protected data oBlockMit    as object

    public method new(cIdDoc as character, cMovType as character, cOperation as character) as object
    public method getJsonBlocks() as json
    public method handleIntegrationResult(lIntegrationResult as logical)
    protected method setIdDoc(cIdDoc as character)
    protected method setIdMov(cIdMov as character)
    protected method setMovType(cMovType as character)
    protected method setTaxIdDoc(cIdDoc as character)
    protected method setOperation(cOperation as character)
    protected method updateFkf()
    protected method updateFkh()
    protected method updateFk2()
    protected method getParentIdDoc() as character
    protected method validateProperties() as logical
    protected method validateFk7IdDoc(cIdDoc as character, isRecursive as logical) as logical
    protected method updateIdDocFromPostingID() as logical
    protected method getFk7FromPostingID() as character
endClass


//-------------------------------------------------------------------
/*{Protheus.doc} new
    Construtor
    @return object: self
    @author guilhermed.santos
    @since 09/04/2025
    @version 12.1.2410
*/
//-------------------------------------------------------------------
method new(cIdDoc as character, cMovType as character, cOperation as character) as object class DataBlocksResponse
    default cIdDoc      := ""
    default cMovType    := ""
    default cOperation  := ""

    self:setIdDoc(cIdDoc)
    self:setIdMov()
    self:setMovType(cMovType)
    self:setOperation(cOperation)
    self:aFkhId       := {}
    self:oBlockT001AB := Nil
    self:oBlockT003   := Nil
    self:oBlockT154   := Nil
    self:oBlockT157   := Nil
    self:oBlockT158   := Nil
    self:oBlockT159   := Nil
    self:oBlockT162   := Nil
    self:oBlockT999   := Nil
    self:oBlockMit    := Nil
return self

