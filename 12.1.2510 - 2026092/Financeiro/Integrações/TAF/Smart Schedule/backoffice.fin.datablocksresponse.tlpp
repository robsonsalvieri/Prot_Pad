//-------------------------------------------------------------------
/*{Protheus.doc} getJsonBlocks
    @description Chama as classes de cada bloco e junta todas em um único json para retorno.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 10/04/2025
    @return
*/
//-------------------------------------------------------------------
method getJsonBlocks() as json class DataBlocksResponse    
    local aT159inT003   := {} as array
    local aBlockT003    := {} as array
    local cIdDoc        := "" as character
    local nCounter      := 0 as numeric
    local jBlockT003    := jsonObject():new() as json
    local jDataBlocks   := jsonObject():new() as json

    if self:validateProperties()
        if self:cMovType == CODE_MOVEMENT_REINF
            if self:cOperation $ (INSERT_OPERATION + '/' + UPDATE_OPERATION + '/' + POST_OPERATION)

                self:oBlockT001AB := DataBlockT001AB():new(self:cIdDoc)
                self:oBlockT001AB:loadT001ABBlock()
                if self:oBlockT001AB:getHasDataBlock()
                    jDataBlocks["T001AB"] := self:oBlockT001AB:getT001ABBlock()
                endIf

                self:oBlockT003 := DataBlockT003():new(self:cIdDoc)
                self:oBlockT003:loadT003Block()
                if self:oBlockT003:getHasDataBlock()
                    jDataBlocks["T003"] := self:oBlockT003:getT003Block()
                endIf

                self:oBlockT157 := DataBlockT157():new(self:cIdDoc)
                self:oBlockT157:loadT157Block()
                if self:oBlockT157:getHasDataBlock()
                    jDataBlocks["T157"] := self:oBlockT157:getT157Block()
                endIf
                
                self:oBlockT159 := DataBlockT159():new(self:cIdDoc)
                self:oBlockT159:loadT159Block()                
                if self:oBlockT159:getHasDataBlock()
                    jDataBlocks["T159"] := self:oBlockT159:getT159Block()
                    if self:oBlockT159:getHasT003()
                        self:oBlockT159:validParticipants(jDataBlocks)
                        aT159inT003 := self:oBlockT159:getT159InT003()
                        for nCounter := 1 to len(aT159inT003)
                            if aT159inT003[nCounter][2]
                                aadd(jDataBlocks["T003"]["T003"],aT159inT003[nCounter][1])
                            endIf
                        next
                    endIf
                endIf

                if self:cOperation == POST_OPERATION
                    self:oBlockT158 := DataBlockT158():new(self:cIdDoc,self:cIdFkMov)
                    self:oBlockT158:loadT158Block()
                    if self:oBlockT158:getHasDataBlock()
                        jDataBlocks["T158"] := self:oBlockT158:getT158Block()
                    endIf
                else
                    self:oBlockT154 := DataBlockT154():new(self:cIdDoc)
                    self:oBlockT154:loadT154Block()
                    if self:oBlockT154:getHasDataBlock()
                        jDataBlocks["T154"] := self:oBlockT154:getT154Block()
                    endIf
                endIf

                self:oBlockT162 := DataBlockT162():new(self:cIdDoc)
                self:oBlockT162:loadT162Block()
                if self:oBlockT162:getHasDataBlock()
                    jDataBlocks["T162"] := self:oBlockT162:getT162Block()
                endIf
            else
                self:oBlockT999 := DataBlockT999():new(self:cIdDoc,self:cIdFkMov,CODE_MOVEMENT_REINF)
                self:oBlockT999:loadT999Block()
                if self:oBlockT999:getHasDataBlock()
                    jDataBlocks["T999"] := self:oBlockT999:getT999Block()
                    self:aFkhId := jDataBlocks["T999"]["FKH_ID"]
                endIf
            endIf
        elseif self:cMovType == CODE_MOVEMENT_MIT
            self:setTaxIdDoc(self:cIdDoc)
            cIdDoc := self:getParentIdDoc()
            
            if !empty(cIdDoc)
                self:setIdDoc(cIdDoc)
            endIf

            if self:cOperation $ (INSERT_OPERATION + '/' + UPDATE_OPERATION + '/' + POST_OPERATION)
                self:oBlockT001AB := DataBlockT001AB():new(self:cIdDoc)
                self:oBlockT001AB:loadT001ABBlock()
                if self:oBlockT001AB:getHasDataBlock()
                    jDataBlocks["T001AB"] := self:oBlockT001AB:getT001ABBlock()
                endIf

                self:oBlockT159 := DataBlockT159():new(self:cIdDoc)
                self:oBlockT159:loadT159Block()
                if self:oBlockT159:getHasDataBlock()
                    if self:oBlockT159:getHasT003()
                        aT159inT003 := self:oBlockT159:getT159InT003()
                        for nCounter := 1 to len(aT159inT003)
                            if aT159inT003[nCounter][2]
                                aadd(aBlockT003,aT159inT003[nCounter][1])
                            endIf
                        next
                        jBlockT003["T003"] := aBlockT003
                        jDataBlocks["T003"] := jBlockT003
                    endIf
                    jDataBlocks["T159"] := self:oBlockT159:getT159Block()
                endIf

                self:oBlockMit := DataBlockMit():new(self:cIdDoc, self:cTaxIdDoc)
                self:oBlockMit:loadMitBlock()            
                if self:oBlockMit:getHasDataBlock()
                    jDataBlocks["MIT"] := self:oBlockMit:getMitBlock()
                endIf
            else
                self:oBlockT999 := DataBlockT999():new(self:cTaxIdDoc,,CODE_MOVEMENT_MIT)
                self:oBlockT999:loadT999Block()
                if self:oBlockT999:getHasDataBlock()
                    jDataBlocks["T999"] := self:oBlockT999:getT999Block()
                    self:aFkhId := jDataBlocks["T999"]["FKH_ID"]
                endIf
            endIf
        endIf
    endIf

return jDataBlocks

//-------------------------------------------------------------------
/*{Protheus.doc} handleIntegrationResult
    @description Método responsável por realizar tratamentos de acordo com o resultado da integração.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 17/04/2025
    @return
*/
//-------------------------------------------------------------------
method handleIntegrationResult(lIntegrationResult as logical) class DataBlocksResponse
    if lIntegrationResult
        if self:cOperation $ (INSERT_OPERATION + '/' + UPDATE_OPERATION + '/' + POST_OPERATION)
            self:updateFkf()
            if self:cOperation == POST_OPERATION
                self:updateFk2()
            endIf
        else
            self:updateFkh()
        endIf
    endIf
return

//-------------------------------------------------------------------
/*{Protheus.doc} updateFkf
    @description Atualiza a tabela FKF.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 21/05/2025
    @return
*/
//-------------------------------------------------------------------
method updateFkf() class DataBlocksResponse
    local aArea     := {} as array
    local aAreaFkf  := {} as array

    aArea    := getArea()
    aAreaFkf := FKF->(getArea())
    
    dbSelectArea("FKF")
    FKF->(dbSetOrder(1)) //FKF_FILIAL+FKF_IDDOC
    if FKF->(dbSeek(xFilial('FKF')+self:cIdDoc))
        RecLock("FKF",.F.)
            FKF->FKF_REINF := '1'
        FKF->(MsUnLock())
    endIf

    restArea(aAreaFkf)
    restArea(aArea)
return

//-------------------------------------------------------------------
/*{Protheus.doc} updateFkh
    @description Atualiza a tabela FKH.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 21/05/2025
    @return
*/
//-------------------------------------------------------------------
method updateFkh() class DataBlocksResponse
    local aArea     := {} as array
    local aAreaFkh  := {} as array
    local nCounter  := {} as numeric

    aArea    := getArea()
    aAreaFkh := FKH->(getArea())
    
    if self:oBlockT999:getHasDataBlock()
        dbSelectArea("FKH")
        FKH->(dbGotop())
        FKH->(dbSetOrder(1)) //FKH_FILIAL+FKH_LAYOUT+FKH_ID+FKH_REVISA
        for nCounter := 1 to len(self:aFkhId)
            if FKH->(dbSeek(xFilial('FKH')+self:aFkhId[nCounter]["LAYOUT"]+self:aFkhId[nCounter]["ID"]))
                RecLock("FKH",.F.)
                    FKH->FKH_REINF := '1'
                FKH->(MsUnLock())
            endIf
        next
    endIf

    restArea(aAreaFkh)
    restArea(aArea)
return

//-------------------------------------------------------------------
/*{Protheus.doc} updateFk2
    @description Atualiza a tabela FKF.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 21/05/2025
    @return
*/
//-------------------------------------------------------------------
method updateFk2() class DataBlocksResponse
    local aArea     := {} as array
    local aAreaFk2  := {} as array

    aArea    := getArea()
    aAreaFk2 := FKF->(getArea())
    
    dbSelectArea("FK2")
    FK2->(dbSetOrder(1)) //FK2_FILIAL+FK2_IDFK2
    if FK2->(dbSeek(xFilial('FK2')+self:cIdFkMov))
        RecLock("FK2",.F.)
            FK2->FK2_REINF := '1'
        FK2->(MsUnLock())
    endIf

    restArea(aAreaFk2)
    restArea(aArea)
return

//-------------------------------------------------------------------
/*{Protheus.doc} getParentIdDoc
    @description Retorna o IdDoc do título pai.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 21/05/2025
    @return
*/
//-------------------------------------------------------------------
method getParentIdDoc() as character class DataBlocksResponse
    local aArea         := {} as array
    local aAreaFk7      := {} as array
    local aAreaSe2      := {} as array
    Local cChildTitle   := "" as character
    Local cKey          := "" as character
    Local cIdDoc        := "" as character
    Local lUseClass     := .F. as logical
    Local oBillRelated  := Nil as object   
    Local jRetBillRelatedObj    := JsonObject():New() as json

    aArea    := getArea()
    aAreaFk7 := FK7->(getArea())
    aAreaSe2 := SE2->(getArea())
    
    dbSelectArea("FK7")
    FK7->(dbSetOrder(5)) //FK7_IDDOC
    if !FK7->(dbSeek(self:cTaxIdDoc))
        return
    endIf    
 
    cChildTitle := FK7->(FK7_FILTIT+FK7_PREFIX+FK7_NUM+FK7_PARCEL+FK7_TIPO+FK7_CLIFOR+FK7_LOJA)
    lUseClass := FindClass('totvs.protheus.backoffice.fin.bills.related.BillRelated') .and. FK7->(FieldPos("FK7_IDPAI")) > 0
 
    DbSelectArea('SE2')
    dbSetOrder(1)
    if SE2->(DbSeek(cChildTitle))
        if lUseClass
            oBillRelated := totvs.protheus.backoffice.fin.bills.related.BillRelated():New()
            if lUseClass := oBillRelated:canUseRelatedBill()
                jRetBillRelatedObj := oBillRelated:getRelatedBills('SE2', .T.)
                if !Empty(jRetBillRelatedObj['document']) .And. Len(jRetBillRelatedObj['document']) > 0
                    cIdDoc := jRetBillRelatedObj['document'][1]['FK7_IDDOC']
                endif
            endif
        endif
 
        if !lUseClass
            if !Empty(SE2->E2_TITPAI) .And. SE2->(MsSeek(xFilial("SE2") + SE2->E2_TITPAI))
                cKey := SE2->E2_FILIAL + "|" +  SE2->E2_PREFIXO + "|" + SE2->E2_NUM + "|" + SE2->E2_PARCELA + "|" + SE2->E2_TIPO + "|" +SE2->E2_FORNECE + "|" + SE2->E2_LOJA
                cIdDoc := FinBuscaFK7(cKey,"SE2")
            endif
        endif
    endif    
    
    restArea(aAreaSe2)
    restArea(aAreaFk7)
    restArea(aArea)
return cIdDoc

//-------------------------------------------------------------------
/*{Protheus.doc} validateProperties
    @description Valida se as propriedades cIdDoc e cMovType estão aptas para prosseguir com a integração.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 11/06/2025
    @return
*/
//-------------------------------------------------------------------
method validateProperties() as logical class DataBlocksResponse
    local lValidated := .T. as logical

    if empty(self:cIdDoc) .or. empty(self:cMovType)
        return .F.
    endIf

    if self:cOperation $ (INSERT_OPERATION + '/' + UPDATE_OPERATION + '/' + POST_OPERATION) .and. !self:validateFk7IdDoc()
        return .F.
    endIf
    
    if self:cOperation == CANCEL_POST_OPERATION
        lValidated := self:updateIdDocFromPostingID()
    endIf

return lValidated

//-------------------------------------------------------------------
/*{Protheus.doc} validateFk7IdDoc
    @description Valida se a propriedade self:cIdDoc foi preenchida de acordo com a FK7.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 11/06/2025
    @return
*/
//-------------------------------------------------------------------
method validateFk7IdDoc(cIdDoc as character, isRecursive as logical) as logical class DataBlocksResponse
    local aArea      := {} as array
    local aAreaFk7   := {} as array
    local lValidated := .F. as logical

    default cIdDoc      := self:cIdDoc
    default isRecursive := .F.

    aArea    := getArea()
    aAreaFk7 := FK7->(getArea())

    dbSelectArea("FK7")
    FK7->(dbSetOrder(5)) //FK7_IDDOC
    FK7->(dbGotop())
    if FK7->(dbSeek(cIdDoc))
        lValidated := .T.
    else
        lValidated := .F.
        if !isRecursive
            lValidated := self:updateIdDocFromPostingID()
        endIf
    endIf

    restArea(aAreaFk7)
    restArea(aArea)
return lValidated

//-------------------------------------------------------------------
/*{Protheus.doc} updateIdDocFromPostingID
    @description Atualiza a propriedade self:cIdDoc de acordo com o Id Baixa.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 11/06/2025
    @return
*/
//-------------------------------------------------------------------
method updateIdDocFromPostingID() as logical class DataBlocksResponse
    local lUpdated  := .F.
    local cIdDoc    := "" as character

    cIdDoc := self:getFk7FromPostingID()

    if empty(cIdDoc)
        return .F.
    endIf

    if self:validateFk7IdDoc(cIdDoc,.T.)
        self:setIdMov(self:cIdDoc)
        self:setIdDoc(cIdDoc)
        lUpdated := .T.
    endIf
    
return lUpdated

//-------------------------------------------------------------------
/*{Protheus.doc} getFk7FromPostingID
    @description Valida se a propriedade self:cIdDoc foi preenchida de acordo com a FK7.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 11/06/2025
    @return
*/
//-------------------------------------------------------------------
method getFk7FromPostingID() as character class DataBlocksResponse
    local aArea      := {} as array
    local aAreaFk1   := {} as array
    local aAreaFk2   := {} as array
    local cIdDoc     := "" as character

    aArea    := getArea()
    aAreaFk1 := FK1->(getArea())
    aAreaFk2 := FK2->(getArea())

    dbSelectArea("FK1")
    FK1->(dbSetOrder(1)) //FK1_FILIAL+FK1_IDFK1
    FK1->(dbGotop())
    if FK1->(dbSeek(xFilial('FK1')+self:cIdDoc))
        cIdDoc := FK1->FK1_IDDOC
    else
        dbSelectArea("FK2")
        FK2->(dbSetOrder(1)) //FK2_FILIAL+FK2_IDFK2
        FK2->(dbGotop())
        if FK2->(dbSeek(xFilial('FK2')+self:cIdDoc))
            cIdDoc := FK2->FK2_IDDOC
        endIf
    endIf

    restArea(aAreaFk2)
    restArea(aAreaFk1)
    restArea(aArea)
return cIdDoc
