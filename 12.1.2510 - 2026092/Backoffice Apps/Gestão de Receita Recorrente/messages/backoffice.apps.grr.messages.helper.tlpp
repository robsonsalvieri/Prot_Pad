#include "totvs.ch"
#include "tlpp-core.th"

namespace totvs.protheus.backoffice.apps.grr.messages

static _lEntryPointPreProcessing := NIL
static _lEntryPointApiCustomRequest := NIL

/*/{Protheus.doc} CustomProcessingResponse
    @description Representa o resultado do processamento customizado de mensagens.
    @type class
    @author guilherme.sordi@totvs.com.br
    @since 24/06/2026
    @version 12.1.2410
/*/
class CustomProcessingResponse
    public data jMessage as json
    public data lSuccess as logical
    public data lContinueDefaultProcessing as logical

    public method new(jMessage as json, lSuccess as logical, lContinueDefaultProcessing as logical) as object
endClass

/*/{Protheus.doc} new
    @description Inicializa a resposta do processamento customizado com os dados informados.
    @author guilherme.sordi@totvs.com.br
    @since 24/06/2026
    @type method
    @version 12.1.2410
/*/
method new(jMessage as json, lSuccess as logical, lContinueDefaultProcessing as logical) as object class CustomProcessingResponse
    default jMessage := JsonObject():new()
    default lSuccess := .F.
    default lContinueDefaultProcessing := .T.

    self:jMessage := jMessage
    self:lSuccess := lSuccess
    self:lContinueDefaultProcessing := lContinueDefaultProcessing
return self

class ApiRequestData
    public data cVerb as character
    public data cUrl as character
    public data cPath as character
    public data xData as variant

    public method new(cVerb as character, cUrl as character, cPath as character, xData as variant) as object
    public method toJson() as json
    public method replaceData(xData as variant)
endClass

method new(cVerb as character, cUrl as character, cPath as character, xData as variant) as object class ApiRequestData
    default cVerb := ""
    default cUrl := ""
    default cPath := ""
    default xData := JSONObject():new()
    
    self:cVerb := cVerb
    self:cUrl := cUrl
    self:cPath := cPath
    self:xData := xData
return self

method toJson() as json class ApiRequestData
return {"cVerb": self:cVerb, "cUrl": self:cUrl, "cPath": self:cPath, "xData": self:xData}

method replaceData(xData as variant) class ApiRequestData
    if valType(self:xData) == "A"
        fwFreeArray(self:xData)
    elseif valType(self:xData) == "J"
        self:xData:fromJson("{}")
    endIf

    self:xData := xData
return

/*/{Protheus.doc} MessagesHelper
    @description Centraliza o disparo de pontos de entrada para customizacao do processamento de mensagens.
    @type class
    @author guilherme.sordi@totvs.com.br
    @since 24/06/2026
    @version 12.1.2410
/*/
class MessagesHelper
    static method customProcessing(cMessageName as character, jMessage as json) as object
    static method customApiRequest(cVerb as character, cUrl as character, cPath as character, xData as variant) as object
endClass

/*/{Protheus.doc} customProcessing
    @description Executa o ponto de entrada de customizacao e devolve o resultado tratado para o fluxo padrao.
    @author guilherme.sordi@totvs.com.br
    @since 24/06/2026
    @type method
    @version 12.1.2410
/*/
method customProcessing(cMessageName as character, jMessage as json) as object class MessagesHelper
    local oResponse as object
    local jMessageCopy := JsonObject():new() as json
    local jEntryPointResponse as json

    default jMessage := JsonObject():new()

    oResponse := CustomProcessingResponse():new(jMessage)

    if _lEntryPointPreProcessing == NIL
        _lEntryPointPreProcessing := ExistBlock("custom.backoffice.apps.grr.messages.processing")
    endIf

    if _lEntryPointPreProcessing
        jMessageCopy:FromJson(jMessage:toJson())

        jEntryPointResponse := ExecBlock("custom.backoffice.apps.grr.messages.processing", .F., .F., {cMessageName, jMessageCopy})
        
        if valType(jEntryPointResponse) != "J" .or. empty(jEntryPointResponse:getNames())
            return oResponse
        endIf

        if jEntryPointResponse:hasProperty("lSuccess") .and. valType(jEntryPointResponse["lSuccess"]) == "L"
            oResponse:lSuccess := jEntryPointResponse["lSuccess"]
        endIf
        if jEntryPointResponse:hasProperty("lContinueDefaultProcessing") .and. valType(jEntryPointResponse["lContinueDefaultProcessing"]) == "L"
            oResponse:lContinueDefaultProcessing := jEntryPointResponse["lContinueDefaultProcessing"]
        endIf
        if jEntryPointResponse:hasProperty("jMessage") .and. valType(jEntryPointResponse["jMessage"]) == "J"
            oResponse:jMessage := jEntryPointResponse["jMessage"]
        endIf
    endIf
return oResponse

method customApiRequest(cVerb as character, cUrl as character, cPath as character, xData as variant) as object class MessagesHelper 
    local oRequest := ApiRequestData():new(cVerb, cUrl, cPath, xData) as object
    local jRequestCopy := JsonObject():new() as json
    local jEntryPointResponse as json

    if _lEntryPointApiCustomRequest == NIL
        _lEntryPointApiCustomRequest := ExistBlock("custom.backoffice.apps.grr.messages.request")
    endIf

    if _lEntryPointApiCustomRequest
        jRequestCopy:FromJson(oRequest:toJson():toJson())

        jEntryPointResponse := ExecBlock("custom.backoffice.apps.grr.messages.request", .F., .F., {jRequestCopy})
        
        if valType(jEntryPointResponse) == "J" .and. jEntryPointResponse:hasProperty("xData") .and. valType(jEntryPointResponse["xData"]) $ "AJ"
            oRequest:replaceData(jEntryPointResponse['xData'])
        endIf
    endIf
return oRequest
