#include "totvs.ch"
#include "tlpp-core.th"

namespace totvs.protheus.backoffice.apps.grr.messages
using namespace totvs.protheus.backoffice.apps.grr.general
using namespace totvs.protheus.backoffice.apps.grr.integration.paymentorder

//-------------------------------------------------------------------
/*/{Protheus.doc} BillPaidCreatedMessageHandler
    @description Trata a mensagem de título pago criado, atualizando o status do documento no HRJ conforme a origem da integração.
    @type class
    @author claudio.yoshio@totvs.com.br
    @since 02/06/2025
    @version 12.1.2410
*/
//-------------------------------------------------------------------
class BillPaidCreatedMessageHandler from totvs.protheus.backoffice.apps.grr.messages.HandleMessage
    public method new() as object
    protected method processMessage(jData as json) as logical
    protected method isProtheusProvider(cIdDoc as character) as logical
endClass

//------------------------------------------------------------------
/*/{Protheus.doc} new
    @description Instancia o handler e define as propriedades obrigatárias da mensagem de título pago criado.
    @type method
    @author claudio.yoshio@totvs.com.br
	@since 02/06/2025
    @version 12.1.2410
/*/
//-------------------------------------------------------------------
method new() as object class BillPaidCreatedMessageHandler
    local jMandatoryProperties := JsonObject():new() as json

    _Super:new()

    jMandatoryProperties["organizationIntegrationId"] := {"type": "C", "notEmpty": .T.}
    jMandatoryProperties["billIntegrationId"] := {"type": "C", "notEmpty": .F.}
    jMandatoryProperties["source"] := {"type": "C", "notEmpty": .F.}

    self:setMandatoryProperties(jMandatoryProperties)
return self

//------------------------------------------------------------------
/*/{Protheus.doc} processMessage
    @description Processa a mensagem de título pago, define o novo status conforme a origem e atualiza o registro do documento no HRJ.
    @type method
    @author claudio.yoshio@totvs.com.br
	@since 02/06/2025
    @version 12.1.2410
/*/
//-------------------------------------------------------------------
method processMessage(jData as json) as logical class BillPaidCreatedMessageHandler
    local lSuccess := .F. as logical
    local cIdDoc := "" as character
    local cPendingReconciliationStatusCode := "07" as character
    local cSettledStatusCode := "08" as character
    local cNewStatus as character

    if jData['source'] == 'GRRI110'
        cIdDoc := jData['billIntegrationId']
    endIf
    
    cNewStatus := cPendingReconciliationStatusCode
    if self:isProtheusProvider(cIdDoc)
        cNewStatus := cSettledStatusCode
    endIf

    if !empty(cIdDoc)
        HRJ->(dbSetOrder(2)) //HRJ_IDDOC
        if HRJ->(dbSeek(cIdDoc)) .and. recLock("HRJ", .F.)
            HRJ->HRJ_STAT := cNewStatus 
            //to-do: Verificar se é melhor gravar o objeto inteiro ou apenas informações que realmente vamos usar
            HRJ->HRJ_DET := Util():getJsonUpdate(HRJ->HRJ_DET, {"BillPaidCreated": jData})
            HRJ->(msUnlock())

            lSuccess := .T.
        endIf
    endIf
return lSuccess

//------------------------------------------------------------------
/*/{Protheus.doc} isProtheusProvider
    @description Verifica se o registro segue o fluxo de Provedor Protheus
    @type method
    @author guilherme.sordi@totvs.com.br
	@since 27/08/2026
    @version 12.1.2510
/*/
//-------------------------------------------------------------------
method isProtheusProvider(cIdDoc as character) as logical class BillPaidCreatedMessageHandler
    local lProtheusProvider := .F. as logical
    local lClassPaymentOrderIntegrationUpdated := .F. as logical

    lClassPaymentOrderIntegrationUpdated := ( getRpoRelease() >= "12.1.2610" ) .or. ( findClass("totvs.protheus.backoffice.apps.grr.integration.paymentorder.PaymentOrderIntegration") .and. getApoInfo("backoffice.apps.grr.integration.paymentorder.tlpp")[4] >= cToD("27/08/2026"))
    
    lProtheusProvider := lClassPaymentOrderIntegrationUpdated .and. !empty(cIdDoc) .and. ( PaymentOrderIntegration():getExistsPaymentOrderIntegrationByIdDoc(cIdDoc) > 0 )
return lProtheusProvider
