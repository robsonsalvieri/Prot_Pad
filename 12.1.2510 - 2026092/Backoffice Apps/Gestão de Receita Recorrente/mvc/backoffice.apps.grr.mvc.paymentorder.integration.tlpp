#include "totvs.ch"
#include "tlpp-core.th"
#include "fwmvcdef.ch"

namespace totvs.protheus.backoffice.apps.grr.mvc.paymentorder.integration

PUBLISH MODEL REST NAME HRK SOURCE "totvs.protheus.backoffice.apps.grr.mvc.paymentorder.integration.model"

//-------------------------------------------------------------------
/*/{Protheus.doc} ModelDef
Cria o modelo de dados da ordem de pagamento GR.
@return object, Modelo com os dados da ordem de pagamento.
@author  Claudio Yoshio Muramatsu
@since   29/04/2026
/*/
//-------------------------------------------------------------------
function modelDef()
	local oModel as object
	local oStruHRK as object
	
	oStruHRK := FWFormStruct( 1, 'HRK' )

	oModel:= MPFormModel():New( "MODEL_HRK" )
	oModel:AddFields( 'HRKMASTER', /*cOwner*/, oStruHRK )
return oModel

//-------------------------------------------------------------------
/*/{Protheus.doc} ViewDef
Cria a view com os dados da ordem de pagamento.
@return object, View com os dados da ordem de pagamento.
@author  Claudio Yoshio Muramatsu
@since   29/04/2026
/*/
//-------------------------------------------------------------------
function viewDef()
	local oModel as object
	local oStruHRK as object
	local oView as object

	oModel := FWLoadModel( "totvs.protheus.backoffice.apps.grr.mvc.paymentorder.integration.model" )
	oStruHRK := FWFormStruct( 2, 'HRK' )
	oView := FWFormView():New()

	oView:SetModel( oModel )
	oView:AddField( 'VIEW_HRK', oStruHRK, 'HRKMASTER' )
return oView
