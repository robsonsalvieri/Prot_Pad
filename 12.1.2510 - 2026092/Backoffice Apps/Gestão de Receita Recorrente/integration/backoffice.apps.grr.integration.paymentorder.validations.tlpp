#include "totvs.ch"
#include "tlpp-core.th"

namespace totvs.protheus.backoffice.apps.grr.integration.paymentorder

//-------------------------------------------------------------------
/*/{Protheus.doc} Validations
    @description Classe com implementações de validações para outros módulos.
    @type class
    @author claudio.yoshio@totvs.com.br
    @since 08/07/2025
    @version 12.1.2510
/*/
//-------------------------------------------------------------------
class Validations
    static method hasPaymentOrderDictionaryRequirements() as logical
endClass

//------------------------------------------------------------------
/*/{Protheus.doc} hasPaymentOrderDictionaryRequirements
    @description Verifica os requisitos mínimos de dicionário para a integração das ordens de pagamento.
    @author claudio.yoshio@totvs.com.br
    @since 13/05/2026
    @version 12.1.2510
    @return logical Retorna .T. se os requisitos são atendidos, caso contrário .F.
/*/
//-------------------------------------------------------------------
method hasPaymentOrderDictionaryRequirements() as logical class Validations
return GetRpoRelease() >= "12.1.2610" .or. fwAliasInDic("HRK")
