#include "tlpp-core.th"
#include "protheus.ch"
#include "backoffice.techfin.contadigital.bordero.ch"

NAMESPACE totvs.protheus.backoffice.techfin.contadigital.bordero

/*/{Protheus.doc} VldTFKG
	Apresenta uma tela com mensagem do uso do ERP Banking TechFin
	@type  Function
	@author renato.mpaiva
	@since 22/11/2025
	@version 1.0
	@param cTFFunc, caracter, função que está sendo expirada
	@param nTipoMsg, numeric, tipo da mensagem a ser exibida
	@param lVldTFKG, logico, Valida se é um processo de conta ERP BANKING TECHFIN
	@param cPort240, caracter, codigo do banco 
	@param cAgen240, caracter, numero da agencia do banco
	@param cConta240, caracter, numero da conta do banco
	@return lVldTFKG, logico, Verdadeiro se foi escolhido para desabilitar a mensagem por 7 dias
/*/
Function VldTFKG(cTFFunc As Character,nTipoMsg as Numeric, lVldTFKG	As Logical,cPort240 As Character, cAgen240 As Character, cConta240 As Character) As Logical
	Local cQryTFKG		:= "" 		As Character
	Local cLinkTDN		:= "" 		As Character
	Local cExpiraData	:= "" 		As Character
	Local cShow			:= "" 		As Character
	Local cMsg1			:= "" 		As Character
	Local cMsg2			:= "" 		As Character
	Local cMsg3			:= "" 		As Character
	Local cMsg4			:= "" 		As Character
	Local nQtdDShow		:= 0  		As Numeric
	Local aAreaSA6		:= {} 		As Array
	Local aArea 		:= {} 		As Array
	Local aLoad			:= {} 		As Array
	Local lCheck		:= .F. 		As Logical
	Local dDtExpRot		:= SToD("") As Date
	Local dDate			:= SToD("") As Date
	Local oExec 		:= Nil 		As Object

	DEFAULT cTFFunc 	:= ""
	DEFAULT	lVldTFKG	:= .F.
	DEFAULT	cPort240	:= ""
	DEFAULT	cAgen240	:= ""
	DEFAULT	cConta240	:= ""

	nQtdDShow	:= 7
	aArea 		:= FWGetArea()
	aAreaSA6	:= SA6->(FWGetArea())
	
	If SA6->(FieldPos("A6_TFCNT")) > 0

		If !lVldTFKG
			cQryTFKG := " SELECT "
			cQryTFKG += " SA6.R_E_C_N_O_ REC_SA6 "
			cQryTFKG += " FROM " + RetSqlName("SA6") + " SA6 "
			cQryTFKG += " WHERE "
			cQryTFKG += " A6_FILIAL = ? "
			cQryTFKG += " AND A6_TFCNT = ? "
			cQryTFKG += " AND SA6.D_E_L_E_T_ = ? "

			oExec := FwExecStatement():New(ChangeQuery(cQryTFKG))
			oExec:SetString(1, FwXFilial("SA6") )
			oExec:SetString(2, "1" )    
			oExec:SetString(3, " " ) 

			lVldTFKG := (oExec:ExecScalar("REC_SA6") > 0)
			
		EndIf

		If lVldTFKG .And. !IsBlind()
			cLinkTDN 	:= "https://tdn.totvs.com/display/PROT/TOTVS+Conta+Digital+-+ERP+Banking"
			dDtExpRot 	:= Date() + nQtdDShow
			cExpiraData := DToC(dDtExpRot)
			dDate 		:= Date()
			oProfile := FwProFile():New()
			oProfile:SetTask("TFCTAdDIG") //Nome da sess?o
			oProfile:SetType(cTFFunc) //Valor
			aLoad := oProfile:Load()
			If Empty(aLoad)
				cShow := "00000000"
			Else
				cShow := aLoad[1]
			Endif

			// reseta o controle de nPauseDays dias e volta apresentar a tela de advertencia
			dShow := (STOD(cShow) + nQtdDShow)
			If cShow <> "00000000" .and. dShow <= dDate
				cShow := "00000000"
				oProfile:SetProfile({cShow})
				oProfile:Save()
			ENDIF

			
			If nTipoMsg == 1 .And. cShow == "00000000" 
				cMsg1 		:= i18n("<b>" + STR0001 + "</b>")	//"Facilite sua conciliação com a conta TECHFIN."
				cMsg2 		:= i18n(STR0002)//"Ao enviar seus borderôs de pagamento pela conta TECHFIN, você elimina a necessidade de gerar e trocar arquivos CNAB."
				cMsg3 		:= ""
				cMsg4 		:= i18n(STR0003)//"A conciliação e a baixa dos títulos são feitas automaticamente, trazendo mais agilidade e segurança para o seu processo financeiro."

				lCheck 		:= DlgMsgTF(cTFFunc,cExpiraData, nQtdDShow, cLinkTDN, cMsg1, cMsg2, cMsg3, cMsg4)
				
			ElseIf nTipoMsg == 2
				SA6->(DbSetOrder(1))
			
				If SA6->(DbSeek(xFilial("SA6")+cPort240+cAgen240+cConta240)) .And. SA6->A6_TFCNT == "1"
					cModPgto := "30"
					cTipoPag := "20"
			
				ElseIf cShow == "00000000" .And. !lShowVldTF
					cMsg1 	:= i18n("")	
					cMsg2 	:= i18n("<b>" + STR0004 + "</b>")	//"Apenas a conta Techfin garante conciliação e baixa automática dos títulos." 

					cMsg3 	:= ""
					cMsg4 	:= i18n(STR0005)//"Para pagar com a conta Techfin, volte para o início da parametrização do borderô e selecione a sua conta Techifin."

					lCheck 	:= DlgMsgTF(cTFFunc,cExpiraData, nQtdDShow, cLinkTDN, cMsg1, cMsg2, cMsg3, cMsg4)
					lShowVldTF 	:= .T.

				EndIf	
			EndIf
			
			If lCheck
				cShow := dtos(date())
				oProfile:SetProfile({cShow})
				oProfile:Save()
			EndIf

			oProfile:Destroy()
			oProfile := nil
			aLoad := aSize(aLoad,0)
			aLoad := nil

		Endif
	EndIf

	FWRestArea(aAreaSA6)
	FWRestArea(aArea)
	aArea 	 := {}
	aAreaSA6 := {}
	FwFreeArray(aArea)
	FwFreeArray(aAreaSA6)
Return lVldTFKG


/*/{Protheus.doc} DlgMsgTF
	Apresenta uma tela com mensagem do uso do ERP Banking TechFin
	@type  Function
	@author renato.mpaiva
	@since 22/11/2025
	@version 1.0
	@param cMsgFunc, caracter, função que está sendo expirada
	@param cMsgData, caracter, data de experiração a ser informada deve estar no formato AAAAMMDD
	@param nPauseDays, numeric, numero de dias que a mensagem pode ser ocultada
	@param cLinkTDN, caracter, endere?o http referente a rotina que esta sendo descontinuada
	@param cMsg1, caracter, primeira mensagem a ser exibida
	@param cMsg2, caracter, segunda mensagem a ser exibida
	@param cMsg3, caracter, terceira mensagem a ser exibida
	@param cMsg4, caracter, quarta mensagem a ser exibida
	@return lCheck, logico, Verdadeiro se foi escolhido para desabilitar a mensagem por 7 dias
/*/
Function DlgMsgTF(cMsgFunc as character, cMsgData as character, nPauseDays as numeric, cLinkTDN as character, cMsg1 as character, cMsg2 as character, cMsg3 as character, cMsg4 as character) As Logical
	local oSay1		as object
	local oSay2		as object
	local oSay3		as object
	local oSay4		as object
	local oCheck1	as object
	local oModal	as object
	Local lCheck	as logical
	Local nLin2		as numeric
	Local nLin3		as numeric
	Local nLin4		as numeric
	Local oFont1	as Object
	
	Default cMsg1	:= ""	
	Default cMsg2	:= ""
	Default cMsg3	:= ""
	Default cMsg4	:= ""

	oFont1 	:= TFont():New(Nil, Nil, -15, .T., .T., Nil, Nil, Nil, Nil, Nil)
	
	oModal := FWDialogModal():New()
	oModal:SetCloseButton( .F. )
	oModal:SetEscClose( .F. )
	oModal:setTitle(STR0006)//"Borderô de Pagamentos"
	oModal:setSubTitle(STR0007)//"Comunicado de Software - TOTVS Linha Protheus"
	
	oModal:setSize(180, 250)

	oModal:createDialog()

	oModal:AddButton( STR0008, {||oModal:DeActivate()}, STR0008, , .T., .F., .T., ) // "Confirmar"

	oContainer := TPanel():New( ,,, oModal:getPanelMain() )
	oContainer:Align := CONTROL_ALIGN_ALLCLIENT

	nLin2  := 40 - If(Empty(cMsg1),20,0) 
	nLin3  := 60 - If(Empty(cMsg1),20,0) 
	nLin4  := 80 - If(Empty(cMsg1),20,0)
	
	oSay1 := TSay():New( 10,10,{||cMsg1 },oContainer,,oFont1,,,,.T.,,,220,20,,,,,,.T.)
	oSay2 := TSay():New( nLin2,10,{||cMsg2 },oContainer,,,,,,.T.,,,220,20,,,,,,.T.)
	oSay4 := TSay():New( nLin3,10,{||cMsg4 },oContainer,,,,,,.T.,,,220,20,,,,,,.T.)

	cMsg3 := If(Empty(cMsg3),STR0009,cMsg3) +space(01)//"Para mais informações:"	

	If ! Empty(cLinkTDN)
		cMsg3 += "<b><a target='_blank' href='"+cLinkTDN+"'> "
		cMsg3 += STR0010//"clique aqui"
		cMsg3 += " </a></b>."
		cMsg3 += "<span style='font-family: Verdana; font-size: 12px; color: #565759;' >" + ' ' +"</span>"
		cMsg3 := i18n(cMsg3)
		oSay3 := TSay():New(nLin4,10,{||cMsg3},oContainer,,,,,,.T.,,,220,20,,,,,,.T.)
		oSay3:bLClicked := {|| MsgRun( STR0011, "URL",{|| ShellExecute("open",cLinkTDN,"","",1) } ) } //"Abrindo o link... Aguarde..." 
	EndIf
	
	lCheck := .F.
	oCheck1 := TCheckBox():New(100,10,i18n(STR0012,{strzero(nPauseDays,2)}) ,{|x|If(Pcount()==0,lCheck,lCheck:=x)},oContainer,220,21,,,,,,,,.T.,,,) // "Não apresentar esta mensagem nos proximos #1[7]# dias."

	oModal:Activate()

Return lCheck

/*/{Protheus.doc} DlgPrcTF
	Apresenta uma tela com mensagem do uso do ERP Banking TechFin
	@type  Function
	@author renato.mpaiva
	@since 22/11/2025
	@version 1.0
	@param cPort240, caracter, codigo do banco 
	@param cAgen240, caracter, numero da agencia do banco
	@param cConta240, caracter, numero da conta do banco 
	@param lShow, logical, indica se a tela deve ser exibida
	@return aRet, Array, 1-Logical, exibe dialogs Techfin, 2-Numeric, opção selecionada (1-Pagar agora, 2-Pagar na data de vencimento)
/*/
Function DlgPrcTF(cPort240 As Character, cAgen240 As Character, cConta240 As Character, lShow as Logical) As Array
	local oSay1		as object
	local oSay2		as object
	local oModal	as object
	Local oFont1	as Object
	Local oRadio 	as Object
	Local cMsg1		as Character
	Local cMsg2		as Character
	Local nRadio	as Numeric
	Local aItems	as Array
	Local aAreaSA6  as Array
	Local aArea		As Array
	Local lSayDlgTF as Logical
	LOCAL lOK		as Logical

	DEFAULT cPort240	:= ""
	DEFAULT cAgen240	:= ""
	DEFAULT cConta240	:= ""
	DEFAULT lShow		:= .F.

	cMsg1	:= ""	
	cMsg2	:= ""
	nRadio 	:= 1
	aItems 	:= {}
	
	lSayDlgTF := .F.
	lOK		  := .F.

	aArea	  := FWGetArea()
	aAreaSA6  := SA6->(FWGetArea())

	SA6->(DbSetOrder(1))
			
	If SA6->(FieldPos("A6_TFCNT")) > 0 .And. SA6->(DbSeek(xFilial("SA6")+cPort240+cAgen240+cConta240)) .And. SA6->A6_TFCNT == "1"
		lSayDlgTF := .T.

		If lShow.And. !IsBlind()
			oFont1 	:= TFont():New(Nil, Nil, -15, .T., .T., Nil, Nil, Nil, Nil, Nil)
			
			oModal := FWDialogModal():New()
			oModal:SetCloseButton( .F. )
			oModal:SetEscClose( .F. )
			//STR000
			oModal:setTitle(STR0013)	//"Definir data pagamento"
			// oModal:setTitle("Definir data pagamento")	//"Definir data pagamento"
				
			//define a altura e largura da janela em pixel
			oModal:setSize(130, 200)

			oModal:createDialog()

			oModal:AddButton( STR0008, {|| lOK := .T., oModal:DeActivate()}, STR0008, , .T., .F., .T., ) // "Confirmar"

			oContainer := TPanel():New( ,,, oModal:getPanelMain() )
			oContainer:Align := CONTROL_ALIGN_ALLCLIENT

			aItems := {STR0014,STR0015}//'Pagar agora' # 'Pagar na data de vencimento'

			oRadio := TRadMenu():New (30,10,aItems,,oContainer,,,,,,,,100,12,,,,.T.)
			oRadio:bSetGet := {|u|Iif (PCount()==0,nRadio,nRadio:=u)}
			
			cMsg1 := i18n(STR0016)//"Selecione como deseja pagar?"
			oSay1 := TSay():New( 10,10,{||cMsg1 },oContainer,,oFont1,,,,.T.,,,180,20,,,,,,.T.)

			cMsg2 := i18n(STR0017)//"Os títulos pagos na conta Techfin serão automaticamente baixados e conciliados no seu ERP."
			oSay2 := TSay():New( 60,10,{||cMsg2 },oContainer,,,,,,.T.,,,180,20,,,,,,.T.)

			oModal:Activate()

			If lOK
				DlgEndTF()
			EndIf
			
		EndIf
	EndIf

	FWRestArea(aAreaSA6)
	FWRestArea(aArea)
	aArea 	 := {}
	aAreaSA6 := {}
	FwFreeArray(aArea)
	FwFreeArray(aAreaSA6)
Return {lSayDlgTF,nRadio}


/*/{Protheus.doc} DlgEndTF
	Apresenta uma tela com mensagem ERP Banking TechFin
	@type  Function
	@author renato.mpaiva
	@since 22/11/2025
	@version 1.0
/*/
Function DlgEndTF()
	local oSay1		as object
	local oSay2		as object
	local oModal	as object
	Local oFont1	as Object
	Local cMsg1		as Character
	Local cMsg2		as Character
	
	
	cMsg1	:= ""	
	cMsg2	:= ""
		
	oFont1 	:= TFont():New(Nil, Nil, -15, .T., .T., Nil, Nil, Nil, Nil, Nil)
	
	oModal := FWDialogModal():New()
	oModal:SetCloseButton( .F. )
	oModal:SetEscClose( .F. )
	
	oModal:setTitle(STR0018)	//"Confirmação de envio"
		
	//define a altura e largura da janela em pixel
	oModal:setSize(100, 200)
	oModal:createDialog()
	
	oModal:AddButton( STR0008, {||oModal:DeActivate()}, STR0008, , .T., .F., .T., ) // "Confirmar"
	oContainer := TPanel():New( ,,, oModal:getPanelMain() )
	oContainer:Align := CONTROL_ALIGN_ALLCLIENT
	
	cMsg1 := i18n(STR0019)//"Solicitação  enviada para aprovação!"
	oSay1 := TSay():New( 10,10,{||cMsg1 },oContainer,,oFont1,,,,.T.,,,180,20,,,,,,.T.)
	
	cMsg2 := i18n(STR0020)//"Aguardando conclusão do pagamento pelos aprovadores."
	oSay2 := TSay():New( 30,10,{||cMsg2 },oContainer,,,,,,.T.,,,180,20,,,,,,.T.)
		
	oModal:Activate()

Return 

/*/{Protheus.doc} getTitulosKG(cArqNew)
	(long_description)
	@type  Function
	@author Renato.MPaiva
	@since 06/02/2026
	@version version
	@param cAliasBordero, caracter, alias do bordero
	/*/
Function setTitulosKG(cAliasBordero as Character)
	local cQuery 	as Character
	local oExec 	as Object
	local cDDASE2 	as Character
	
	aArea := FWGetArea()

	cQuery := " SELECT FIG_IDEKEY FROM " + RetSqlName("FIG") + " "
	cQuery += " WHERE FIG_FILIAL = ? "
	cQuery += " AND D_E_L_E_T_ = ? "
	cQuery += " AND FIG_DDASE2 = ? "
	
	(cAliasBordero)->(DbGoTop())
	While (cAliasBordero)->(!Eof())
		cDDASE2 := (cAliasBordero)->E2_FILORIG 	+ '|' + ;
				   (cAliasBordero)->E2_PREFIXO 	+ '|' + ;
				   (cAliasBordero)->E2_NUM 		+ '|' + ;
				   (cAliasBordero)->E2_PARCELA	+ '|' + ;
				   (cAliasBordero)->E2_TIPO 	+ '|' + ;
				   (cAliasBordero)->E2_FORNECE 	+ '|' + ;
				   (cAliasBordero)->E2_LOJA		+ '|'
		
		oExec := FwExecStatement():New(ChangeQuery(cQuery))
		oExec:SetString(1, FWxFilial("FIG",(cAliasBordero)->E2_FILORIG))
		oExec:SetString(2, " ")
		oExec:SetString(3, cDDASE2)

		cFIGDDASE2 := oExec:ExecScalar("FIG_IDEKEY")

		If !Empty(cFIGDDASE2)
			RecLock(cAliasBordero,.F.)
				(cAliasBordero)->FIG_IDEKEY := "Sim"
			(cAliasBordero)->(MsUnLock())
		EndIf
		oExec:Destroy()
		
		(cAliasBordero)->(DbSkip())
	EndDo
	
Return 

/*/{Protheus.doc} getBcoTFKcBanco,cAgencia,cContacription)
	@type  Function
	@author Renato.MPaiva
	@since 06/02/2026
	@version version
	@param cPort240, caracter, codigo do banco 
	@param cAgen240, caracter, numero da agencia do banco
	@param cConta240, caracter, numero da conta do banco 
	@return lRet, logical, retorna .T. se o banco é TechFin
	/*/
Function getBcoTFKG(cBanco as Character,cAgencia as Character,cConta as Character) as Logical
	local aAreaSA6	:= {}  as Array	
	local lRet		:= .F. as Logical
	
	aAreaSA6 := SA6->(FWGetArea())
	
	SA6->(DbSetOrder(1))
	lRet := (SA6->(MsSeek(xFilial("SA6")+cBanco+cAgencia+cConta)) .And. SA6->A6_TFCNT == "1")
	
	FWRestArea(aAreaSA6)
	FwFreeArray(aAreaSA6)
Return lRet

/*/{Protheus.doc} getSEAProce
	@type  Function
	@author squad.techfin
	@since 10/04/2026
	@version version
	@param cFilSEA, caracter, Filial SEA
	@param cNumBor, caracter, numero do bordero
	@return lRet, logical, retorna .T. se existe algum item em andamento
/*/
Function getSEAProce(cFilSEA as character,cNumBor as character) as Logical
Local lRet 		:= .F.              as Logical
Local aAreaSEA	:= SEA->(FWGetArea())
Default cFilSEA := ""
Default cNumBor := ""

DbSelectArea("SEA")
dbSetOrder(2)//EA_FILIAL+EA_NUMBOR+EA_CART+EA_PREFIXO+EA_NUM+EA_PARCELA+EA_TIPO+EA_FORNECE+EA_LOJA
If MsSeek( cFilSEA + cNumBor+"P" ) .and. SEA->(FieldPos("EA_STTFIN")) > 0
	While !Eof() .And. cFilSEA == SEA->EA_FILIAL .And. SEA->EA_NUMBOR == cNumBor .And. SEA->EA_CART == "P"
		If SEA->EA_STTFIN $ "2;3;4;7" //2=Aguardando retorno Techfin ;3=Pendente de aprovação;4=Aprovado;7=Pago
			lRet := .T.
			Exit
		Endif
		SEA->(DbSkip())
	Enddo
Endif

FWRestArea(aAreaSEA)
FwFreeArray(aAreaSEA)
Return lRet

/*/{Protheus.doc} getTitProce
	@type  Function
	@author squad.techfin
	@since 10/04/2026
	@version version
	@param cFilSEA, caracter, Filial SEA
	@param cNumBor, caracter, numero do bordero
	@param cPrefixo, caracter, Prefixo do título
	@param cNum, caracter, numero do titulo
	@param cParcela, caracter, parcela do titulo
	@param cTipo, caracter, tipo do titulo
	@param cFornece, caracter, fornecedor do titulo
	@param cLoja, caracter, loja do fornecedor do titulo
	@return lRet, logical, retorna .T. se o item esta em andamento
/*/
Function getTitProce(cFilSEA as character,cNumBor as character, cPrefixo as character, cNum as character, cParcela as character, cTipo as character, cFornece as character, cLoja as character) as Logical
Local lRet 			:= .F.              as Logical
Local aAreaSEA		:= SEA->(FWGetArea()) as Array
Default cFilSEA		:= ""
Default cNumBor	 	:= ""
Default cPrefixo 	:= ""
Default cNum 	 	:= ""
Default cParcela 	:= ""
Default cTipo 	 	:= ""
Default cFornece 	:= ""
Default cLoja 	 	:= ""

DbSelectArea("SEA")
dbSetOrder(2)//EA_FILIAL+EA_NUMBOR+EA_CART+EA_PREFIXO+EA_NUM+EA_PARCELA+EA_TIPO+EA_FORNECE+EA_LOJA
If MsSeek( cFilSEA + cNumBor+"P" + cPrefixo + cNum + cParcela + cTipo + cFornece + cLoja ) .and. SEA->(FieldPos("EA_STTFIN")) > 0
	lRet := SEA->EA_STTFIN $ "2;3;4;7" //2=Aguardando retorno Techfin ;3=Pendente de aprovação;4=Aprovado;7=Pago
Endif

FWRestArea(aAreaSEA)
FwFreeArray(aAreaSEA)
Return lRet

/*/{Protheus.doc} getIdeKey
	@type  Function
	@author squad.techfin
	@since 10/04/2026
	@version version
	@return cIdekey, character, retorna FIG_IDEKEY do titulo caso encontre
/*/
Function getIdeKey() as Character
local cQuery 	as Character
local oExec 	as Object
local cDDASE2 	as Character
local cIdekey	as Character

If FIG->(FieldPos("FIG_IDEKEY")) > 0
	
	cQuery := " SELECT FIG_IDEKEY FROM " + RetSqlName("FIG") + " "
	cQuery += " WHERE FIG_FILIAL = ? "
	cQuery += " AND D_E_L_E_T_ = ? "
	cQuery += " AND FIG_DDASE2 = ? "

	cDDASE2 := 	SE2->E2_FILORIG	+ '|' + ;
				SE2->E2_PREFIXO	+ '|' + ;
				SE2->E2_NUM		+ '|' + ;
				SE2->E2_PARCELA	+ '|' + ;
				SE2->E2_TIPO 	+ '|' + ;
				SE2->E2_FORNECE	+ '|' + ;
				SE2->E2_LOJA	+ '|'
	
	oExec := FwExecStatement():New(ChangeQuery(cQuery))
	oExec:SetString(1, FWxFilial("FIG",SE2->E2_FILORIG))
	oExec:SetString(2, " ")
	oExec:SetString(3, cDDASE2)

	cIdekey := oExec:ExecScalar("FIG_IDEKEY")

	oExec:Destroy()
Endif

Return cIdekey
