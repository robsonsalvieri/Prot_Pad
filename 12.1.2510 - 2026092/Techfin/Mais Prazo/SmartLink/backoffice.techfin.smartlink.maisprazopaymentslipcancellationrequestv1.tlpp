    data cCodError              as character
    data cReqKey                as character
    data cIdMsgRequest          as character

    public method new() 
    public method destroy()
    public method setCancelation(cSolicitacao as character,cJustificativa as character) as array
    public method isValidStatus(lProccess as logical) as logical
    public method getCodError()   as character
    public method goTo(cSolicitacao as character) as logical
    public method setEligibilityRules()
    
    private method setSolicitacao(cSolicitacao as character)
    private method setJustification(cJustification as character) 
    private method setPaymentSlips()
    private method setRequestId(cRequestId as character)
    private method setCodError(cCodError as character)
    private method setReqKey(cReqKey as character)

    private method getRequestId()        as character
    private method getJustification()    as character
    private method getSolicitacao()      as character
    private method getPaymentSlips()     as array
    private method getEligibilityRules() as array
    private method getReqKey()           as character

    private method send()               as logical
    private method isValidStatusSlip(lProccess as logical)  as logical
    private method isEligibility(cAlias as character,aEligibilityRules as Array) as logical
    private method updateStatusSolicitacao()

    private method loadRequestMsgId(cRequestMsg as character, cProduto as character, cReqKey as character)
