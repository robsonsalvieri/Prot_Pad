/*/{Protheus.doc} send
    Envia a solicitação de cancelamento para o sistema Smartlink via fila
    @type method
    @author Squad Techfin
    @since 20/05/2026
    @version 1.0
    @return lSuccess, logical, Verdadeiro se a solicitação foi enviada com sucesso
/*/
Method send() as logical class MaisPrazoPaymentSlipCancellationRequestv1
    local cFila       := "MaisPrazoPaymentSlipCancellationRequestV1" as character
    local cRequestMsg := "MaisPrazoPaymentSchedulingExecuteRequestV1" as character
    local cIdMsg      := ""                    as character
    local cOrigin     := "1"                   as character
    local cReqKey     := ::getReqKey()         as character
    local lSuccess    := .F.                   as logical
    local jData       := jsonObject():new()    as json
    local oSmartUtil  := SmartlinkUtil():new() as object

    ::loadRequestMsgId(cRequestMsg, __cProdTFMaisPrazo, cReqKey, cOrigin)
    cIdMsg := ::getIdMsgRequest()

    jData["requestId"] := Alltrim(::getRequestId())
    jData["justificationCancellationDesc"] := ::getJustification()
    jData["paymentSlips"] := ::getPaymentSlips()
    
    oSmartUtil:setErpRequestId(cIdMsg)
    oSmartUtil:setAliasMSUID("ARG",.F.,cReqKey)
    If (lSuccess := oSmartUtil:send(cFila, jData:toJson(), .T./*lReqID*/,cReqKey/*cReqId*/, .F./*lHelp*/))
        ::updateStatusSolicitacao()
    EndIf

    FwFreeObj(jData)
    FwFreeObj(oSmartUtil)
Return lSuccess

Method loadRequestMsgId(cRequestMsg as character, cProduct as character, cReqKey as character, cOrigin as character) class MaisPrazoPaymentSlipCancellationRequestv1
    local cQuery   := ""  as character
    local cIdMsg   := ""  as character
    local oExec    := Nil as object

    cQuery := "SELECT ARL_IDMSG FROM " + RetSQLName("ARL")
    cQuery += " WHERE ARL_PRODTF = ?"
    cQuery += " AND ARL_FILA = ?"
    cQuery += " AND ARL_ORIGEM = ?"
    cQuery += " AND ARL_IDORIG = ?"
    cQuery += " AND D_E_L_E_T_ = ?"
    cQuery := ChangeQuery(cQuery)
    oExec := FwExecStatement():New(cQuery)
    
    oExec:SetString(1, cProduct ) 
    oExec:SetString(2, cRequestMsg ) 
    oExec:SetString(3, cOrigin ) 
    oExec:SetString(4, cReqKey ) 
    oExec:SetString(5, ' ' ) 
    
    cIdMsg := oExec:ExecScalar("ARL_IDMSG")   
    
    ::setIdMsgRequest(cIdMsg)
    
    oExec:Destroy()
Return 

Method setIdMsgRequest(cIdMsgRequest as character) class MaisPrazoPaymentSlipCancellationRequestv1
    ::cIdMsgRequest := cIdMsgRequest
Return

Method getIdMsgRequest() as character class MaisPrazoPaymentSlipCancellationRequestv1
Return ::cIdMsgRequest

