/*/{Protheus.doc} updateStatusSolicitacao
    Atualiza o status da solicitação (ARG) e de todos os boletos vinculados (ARH)
    para "Em Análise de Cancelamento" (status __cStatusCancelamentoEmAnalise)
    @type method
    @author Squad Techfin
    @since 20/05/2026
    @version 1.0
/*/
Method updateStatusSolicitacao() class MaisPrazoPaymentSlipCancellationRequestv1
    local cSolicitacao := ::getSolicitacao() as character
    local cKeyARG       := FwXFilial("ARG")+cSolicitacao as character
    local cKeyARH       := FwXFilial("ARH")+cSolicitacao as character
    local aAreas        := {} as Array

    aAdd(aAreas, ARG->(FwGetArea()))
    aAdd(aAreas, ARH->(FwGetArea()))

    ARG->(DbSetOrder(1))
    ARH->(DbSetOrder(1))
    
    If ARG->(MsSeek(cKeyARG)) .And. ARH->(MsSeek(cKeyARH))
        RecLock("ARG",.F.)
            ARG->ARG_STATUS := __cStatusCancelamentoEmAnalise
        ARG->(MsUnlock())
            
        While !ARH->(Eof()) .And. ARH->ARH_FILIAL+ARH->ARH_NUM == cKeyARH
            RecLock("ARH",.F.)
                ARH->ARH_STATUS := __cStatusCancelamentoEmAnalise
            ARH->(MsUnlock())
        ARH->(DbSkip())
        EndDo

    EndIf

    aEval(aAreas, {|x| FwRestArea(x)})
    FwFreeArray(aAreas)
Return
        
