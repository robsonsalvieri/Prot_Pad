#include "TOTVS.ch"
#include "TBICONN.ch"

/*/{Protheus.doc} MaisPrazoCompanyConsultationResponseV1MessageReader
	Classe de Integração Novo Antecipa
	Atualiza dados dos fornecedores cadastrados no Mais Prazo
	@type class
	@author Vitor Duca
	@since 10/10/2025
/*/
class MaisPrazoCompanyConsultationResponseV1MessageReader
	data jMSGData  	as json
	data jMessage  	as json
	data cMock    	as character
    data lMock    	as logical

	public method new() constructor
	public method read(oLinkMessage as object) as logical
	public method mock()
end class

/*/{Protheus.doc} MaisPrazoCompanyConsultationResponseV1MessageReader::New
	Método construtor da classe
	@type method
	@author Vitor Duca
	@since 10/10/2025
/*/
method New() class MaisPrazoCompanyConsultationResponseV1MessageReader
	::jMSGData  := JsonObject():new()
	::jMessage  := JsonObject():new()
	::cMock		:= ""
	::lMock		:= .F.
return Self

/*/{Protheus.doc} MaisPrazoCompanyConsultationResponseV1MessageReader::mock
    Método para mockar a mensagem recebida para testes
    @type method
    @author Vitor Duca
    @since 10/10/2025
    @param cData, character, dados da mensagem a ser mockada
/*/
method mock(cData as character) class MaisPrazoCompanyConsultationResponseV1MessageReader
    ::cMock := cData
    ::lMock := .T.
return

/*/{Protheus.doc} MaisPrazoCompanyConsultationResponseV1MessageReader::read
	esponsável pela leitura e processamento da mensagem.
	@type method
	@author Vitor Duca
	@since 10/10/2025
	@param oLinkMessage, object, Instância de FwTotvsLinkMesage da mensagem
	@return logical, sucesso ou falha. Determina se deve ou não retirar a mensagem da fila.
/*/
method read(oLinkMessage as object) as logical class MaisPrazoCompanyConsultationResponseV1MessageReader
	local lSuccess := .F. 	as logical
	local cMessage := ""	as character
	local aIdent := {}		as array
	local cCompany := ""	as character
	local cBranch := ""		as character
	local cIdMsg := ""		as character
	local cUUID := ""		as character

	cMessage :=  if(::lMock, ::cMock,  oLinkMessage:RawMessage())

	if ::jMessage:FromJSON(cMessage) == NIL
		::jMSGData  := ::jMessage["data"]
		aIdent := StrTOKArr(::jMSGData["erpRequestId"], "|")//"erpRequestId": "cEmpAnt|cFilAnt|IDMSG|ARI_MSUID"		
		If Len(aIdent) == 4
			cCompany := aIdent[1]
			cBranch	 := aIdent[2]
			cIdMsg	 := aIdent[3]
			cUUID	 := aIdent[4]
			
			lSuccess := StartJob("TMPZAtuFor", GetEnvServer(), .T., cCompany, cBranch, cMessage, cIdMsg, cUUID)
		Endif
	endIf

	FwFreeObj(::jMSGData)
	FwFreeObj(::jMessage)

Return lSuccess // .T. apaga a mensagem da fila do smartlink

/*/{Protheus.doc} TMPZAtuFor
	Atualização do status do fornecedor
	@type function
	@author Vitor Duca
	@since 10/10/2025
	@param cCompany, Character, Codigo do grupo de empresa onde será iniciado o processamento
	@param cBranch, Character, Codigo da filial onde será iniciado o processamento
	@param cMessage, Character, Mensagem recebida para ser armazenada no log
	@param cUUID, Character, Identificador unico do registro que será atualizado
/*/
Function TMPZAtuFor(cCompany as character, cBranch as character, cMessage as character, cIdMsg as character, cUUID as character) as logical
	local jData	:= JsonObject():new()	as json
	local aLog := {}					as array
	local cLog := ""					as character

	RPCSetType(3)
	RPCSetEnv(cCompany, cBranch,,,'FIN') 

	jData:fromJson(cMessage)
	BEGIN TRANSACTION
		If jData:hasProperty("data") .and. jData["data"]:hasProperty("companies") .and. totvs.protheus.backoffice.techfin.util.setPositionByUUID("ARI", cUUID)
			RecLock('ARI', .F.)
				ARI->ARI_STATUS := cValToChar(jData["data"]["companies"][1]["companyStatus"]) //0=Não cadastrado;1=Ativo;2=Inativo;3=Bloqueado
			ARI->(msUnLock())
		Else
			aLog := {{"error", "Não foi possivel atualizar o status do fornecedor", "Fornecedor não encontrado - ARI_MSUID " + cUUID}}
			cLog := totvs.protheus.backoffice.techfin.util.formatLog(aLog)
		Endif

		totvs.protheus.backoffice.techfin.util.LogSmartLink(cMessage, "ARI", cUUID, "2", "CompanyConsultation", "T", cIdMsg, cLog)
	END TRANSACTION

	RpcClearEnv()
Return .T.
