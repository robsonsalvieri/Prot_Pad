#include 'tlpp-core.th'
#include "protheus.ch"
#include "FWMVCDef.ch"

NAMESPACE totvs.protheus.backoffice.techfin.capitalgiro.installments

/*/{Protheus.doc} vldParcelas
    
    @author Renato Paiva
    @type function
    @since 02/10/2025
    @version 1.0
    @param jData   , json , Recebe jaon com dados do emprestimo 
    @param aAutoCab, array, Recebe array com dados enviado para o execauto
 /*/
Function vldParcelas(jData as Json, aAutoCab as Array) as Logical 
    Local oExecQry      := Nil As Object
    Local lRet          := .F. As Logical
    Local cNumEmprest   := ""  As Character
    Local cNumRevisao   := ""  As Character  
    Local cAplEmp       := ""  As Character  
    Local cQuery        := ""  As Character
    Local cAliasTMP     := ""  As Character
    Local cTipoTitulo   := ""  As Character    
    Local cRotina       := ""  As Character
    Local cFornecedor   := ""  As Character
    Local cLoja         := ""  As Character   
    Local cHistorico    := ""  As Character
    Local cDelete       := ""  As Character
    Local aSEHMaster    := {}  As Array
    Local aParcelas     := {}  As Array
    Local aCmpCal       := {}  As Array
    Local aDataParcela  := {}  As Array
    Local jTransacao    := NIL As Json
    Local nPos01        := 0   As Numeric
    Local nPos02        := 0   As Numeric    
    Local nPos03        := 0   As Numeric
    Local nRecno        := 0   As Numeric
    
    
    jTransacao  := jData["transacao"]
    aDataParcela:= jData["parcelas"] 
    cHistorico  := "+Giro Techfin - Contrato " + jTransacao["codigo"]
    
    aSEHMaster  := if((nPos01 := aScan(aAutoCab,{|x| x[1] == "SEHMASTER"})) > 0,aAutoCab[nPos01],{})
    aParcelas   := If((nPos02 := aScan(aAutoCab,{|x| x[1] == "SE2DETAIL"})) > 0,aAutoCab[nPos02],{})
    aCmpCal     := If((nPos03 := aScan(aAutoCab,{|x| x[1] == "CALCPARC"}))  > 0,aAutoCab[nPos03],{})
    
    cRotina     := "FINA171"
    
    cFornecedor := aSEHMaster[2][aScan(aSEHMaster[2],{|x| Alltrim(x[1]) == "AUTCODFOR" })][2]
    cLoja       := aSEHMaster[2][aScan(aSEHMaster[2],{|x| Alltrim(x[1]) == "AUTFORLOJA" })][2]

    If Len(aSEHMaster) > 0 .And. Len(aParcelas) > 0 .And. !Empty(cFornecedor) .And. !Empty(cLoja)
        cTipoTitulo := "PR"
        cNumEmprest := aSEHMaster[2][aScan(aSEHMaster[2],{|x| Alltrim(x[1]) == "EH_NUMERO" })][2]
        cNumRevisao := aSEHMaster[2][aScan(aSEHMaster[2],{|x| Alltrim(x[1]) == "EH_REVISAO"})][2]
        cAplEmp     := aSEHMaster[2][aScan(aSEHMaster[2],{|x| Alltrim(x[1]) == "EH_APLEMP" })][2]

        cDelete     := " "

        cQuery := " SELECT "
        cQuery += " SE2.R_E_C_N_O_ REC_SE2, E2_FILIAL, E2_PREFIXO, E2_NUM, E2_PARCELA, E2_TIPO, E2_FORNECE, E2_LOJA,E2_EMISSAO,E2_VENCTO,E2_VENCREA,E2_SALDO "
        cQuery += " FROM " + RetSqlName("SEH") + " SEH "
        cQuery += " JOIN " + RetSqlName("SE2") + " SE2 "
        cQuery += "     ON ("
        cQuery +=  totvs.protheus.backoffice.ngf.util.BranchRelation( {"SE2", "E2_FILIAL", "SE2"}, {'SEH', "EH_FILIAL", "SEH"} )
        cQuery += "     AND SE2.E2_PREFIXO = SEH.EH_TIPO "
        cQuery += "     AND SE2.E2_NUM     = SEH.EH_NUMERO " 
        cQuery += "     AND SE2.E2_TIPO    = ? " // PR - Provisorio            
        cQuery += "     AND SE2.E2_FORNECE = ? " 
        cQuery += "     AND SE2.E2_LOJA    = ? " 
        cQuery += "     AND SE2.E2_EMISSAO = SEH.EH_DATA "
        cQuery += "     AND SE2.E2_ORIGEM  = ? " // Rotina - FINA171
        cQuery += "     AND SE2.D_E_L_E_T_ = ?) "
        cQuery += " WHERE "
        cQuery += "     SEH.EH_FILIAL  = ? "
        cQuery += "     AND SEH.EH_NUMERO  = ? "
        cQuery += "     AND SEH.EH_REVISAO = ? "
        cQuery += "     AND SEH.EH_APLEMP  = ? "
        cQuery += "     AND SEH.D_E_L_E_T_ = ? "

        oExecQry := FwExecStatement():New(cQuery)

        oExecQry:SetString(1,cTipoTitulo)
        oExecQry:SetString(2,cFornecedor)
        oExecQry:SetString(3,cLoja)
        oExecQry:SetString(4,cRotina)
        oExecQry:SetString(5,cDelete)
        
        oExecQry:SetString(6,xFilial("SEH"))
        oExecQry:SetString(7,cNumEmprest)
        oExecQry:SetString(8,cNumRevisao) 
        oExecQry:SetString(9,cAplEmp)
        oExecQry:SetString(10,cDelete)

        cAliasTMP := oExecQry:OpenAlias()
        (cAliasTMP)->(DbGoTop())

        While (cAliasTMP)->(!EoF())
            nRecno := (cAliasTMP)->REC_SE2
            SE2->(DbGoTo(nRecno))
            If SE2->(RECNO()) == nRecno
                RecLock("SE2",.F.)
                    SE2->E2_HIST   := Left(cHistorico, TamSX3("E2_HIST")[1])
                    SE2->E2_CODBAR := getCodBarra(SE2->E2_PARCELA,aDataParcela)
                    SE2->E2_LINDIG := getLinDigitavel(SE2->E2_PARCELA,aDataParcela )
                SE2->(MsUnLock())
            EndIf
        (cAliasTMP)->(DbSkip())
        EndDo

        (cAliasTMP)->(dbCloseArea())
        lRet := .T.
    EndIf
return lRet


/*/{Protheus.doc} getCodBarra
	Retorna objeto JSON das parcelas carregadas.
	@type function
	@author Renato Paiva
	@since 02/10/2025
    @param cParcel  , Characater, Recebe numero da parcela que deseja retornar a linha digitavel
    @param aParcelas, Array     , Recebe array de json com os dados das parcelas
/*/
Function getCodBarra(cParcela as Character, aParcelas as Array) as Character 
    Local cCodBarra := "" As Character
    //Local jParcelas := {} As Json
    
    //jParcelas := ::getParcelas()
    If Val(cParcela) <= Len(aParcelas)
        cCodBarra := aParcelas[aScan(aParcelas,{|x| Alltrim(x["numeroParcela"]) == Alltrim(cParcela)})]["codigoDeBarras"]
        If ValType(cCodBarra) == "C"
            cCodBarra := StrTran(cCodBarra," ","")
            cCodBarra := StrTran(cCodBarra,".","")
            cCodBarra := StrTran(cCodBarra,"-","")
        Else
            cCodBarra := ""
        EndIf
    EndIf
return cCodBarra

/*/{Protheus.doc} getLinDigitavel
	Retorna linha digitavel.
	@type function
	@author Renato Paiva
	@since 02/10/2025
    @param cParcel  , Characater, Recebe numero da parcela que deseja retornar a linha digitavel
    @param aParcelas, Array     , Recebe array de json com os dados das parcelas
/*/
Function getLinDigitavel(cParcela as Character, aParcelas as Array) as Character 
    Local cLinDigitavel := "" As Character
    //Local jParcelas      := {} As Json
    
    //jParcelas := ::getParcelas()
    If Val(cParcela) <= Len(aParcelas)
        cLinDigitavel := aParcelas[aScan(aParcelas,{|x| Alltrim(x["numeroParcela"]) == Alltrim(cParcela)})]["linhaDigitavel"]
    EndIf
    If !(ValType(cLinDigitavel) == "C")
        cLinDigitavel := ""
    EndIf
return cLinDigitavel

/*/{Protheus.doc} CapitalGiroInstallmentsResponseV1MessageReader::vldBanco
	Valida os dados bancarios enviado pelo SmartLInk.
	@type method
	@author Renato Paiva
	@since 02/10/2025
/*/
Function vldBanco(cPayload as Character) as Array 
    Local aRet     := {}                 as Array
    Local aBanco   := {}                 as Array
    Local cBanco   := ""                 as Character
    Local cAgencia := ""                 as Character
    Local cConta   := ""                 as Character
    Local cDgConta := ""                 as Character
    Local cAccount := ""                 as Character
    Local cAliasTMP:= ""                 as Character
    Local cQuery   := ""                 as Character
    Local nPos     := 0                  as Numeric
    Local oExecQry := Nil                as Object
    Local jMsgData := JsonObject():New() as Json
    Local jPayLoad := JsonObject():New() as Json
    
    jPayLoad:FromJSON(cPayload)

    jMsgData := jPayLoad["data"]

    cBanco   := jMSGData["bankAccount"]["bankCode"]
    cAgencia := jMSGData["bankAccount"]["branch"]
    cAccount := Alltrim(jMSGData["bankAccount"]["checkingAccount"])
    nPos     := At("-",cAccount)
    cConta   := Left(cAccount, nPos - 1)
    cDgConta := SubStr(cAccount, nPos + 1)
    aRet     := ARRAY(3) 
    aRet[1]  := .F.
    aRet[2]  := {}
    aRet[3]  := {{"error","vldBanco","Dados bancarios incompletos."}}   
            
    If !Empty(cBanco) .And. !Empty(cAgencia) .And. !Empty(cAccount) 
        cQuery := " SELECT "
        cQuery += " A6_FILIAL,A6_COD,A6_AGENCIA,A6_NUMCON,A6_DVCTA "
        cQuery += " FROM " + RetSqlName("SA6") + " SA6 "
        cQuery += " WHERE"
        cQuery += " A6_FILIAL = ? "
        cQuery += " AND A6_AGENCIA = ? "
        cQuery += " AND A6_NUMCON = ? "
        cQuery += " AND D_E_L_E_T_ = ? "

        oExecQry := FwExecStatement():New(cQuery)

        oExecQry:SetString(1,xFilial("SA6"))
        oExecQry:SetString(2,cAgencia)
        oExecQry:SetString(3,cConta) 
        oExecQry:SetString(4," ")

        cAliasTMP := oExecQry:OpenAlias()
        
        If (cAliasTMP)->(!EoF())
            aAdd(aBanco,{"a6_cod"     ,(cAliasTMP)->A6_COD  })
            aAdd(aBanco,{"a6_agencia" ,(cAliasTMP)->A6_AGENCIA})
            aAdd(aBanco,{"a6_numcon"  ,(cAliasTMP)->A6_NUMCON })
            aAdd(aBanco,{"a6_dvcta"   ,(cAliasTMP)->A6_DVCTA  })

            aRet := {.T., aBanco, {}}
        EndIf

        oExecQry:Destroy()
        oExecQry := nil 
        (cAliasTMP)->(dbCloseArea())
    EndIf 
return aRet

/*/{Protheus.doc} CapitalGiroInstallmentsResponseV1MessageReader::vldFornecedor
	valida dados do fornecedor, retornado resultado da validação.
	@type method
	@author Renato Paiva
	@since 02/10/2025
/*/
Function vldFornecedor(cPayload as Character) as Array 
    Local aRet       := {} as Array
    Local aFornecedor:= {} as Array
    Local aError     := {} as Array
    Local cCNPJ      := "" as Character
    Local cConta     := "" as Character
    Local cDgConta   := "" as Character
    Local cAccount   := "" as Character
    Local nPos       := 0  as Numeric
    Local jMsgData := JsonObject():New() as Json
    Local jPayLoad := JsonObject():New() as Json
    
    jPayLoad:FromJSON(cPayload)

    jMsgData := jPayLoad["data"]

    cAccount := Alltrim(jMSGData["bankAccount"]["checkingAccount"])
    nPos     := At("-",cAccount)
    cConta   := Left(cAccount, nPos - 1)
    cDgConta := SubStr(cAccount, nPos + 1)
            
    cCNPJ := jMSGData["bankAccount"]["issuerDocument"]
    If !Empty(cCNPJ)
        SA2->(DbSetOrder(3))
        If SA2->(DbSeek(xFilial("SA2")+PadR(cCNPJ,TamSx3("A2_CGC")[1])))
            aAdd(aFornecedor,{"a2_cod"     ,SA2->A2_COD    })
            aAdd(aFornecedor,{"a2_loja"    ,SA2->A2_LOJA   })
            aAdd(aFornecedor,{"a2_nome"    ,SA2->A2_NOME   })
            aAdd(aFornecedor,{"a2_nreduz"  ,SA2->A2_NREDUZ })
            aAdd(aFornecedor,{"a2_est"     ,SA2->A2_EST    })
            aAdd(aFornecedor,{"a2_end"     ,SA2->A2_END    })
            aAdd(aFornecedor,{"a2_tipo"    ,SA2->A2_TIPO   })
            aAdd(aFornecedor,{"a2_cgc"     ,SA2->A2_CGC    })

            aRet := {.T.,aFornecedor,aError}
        Else 
            
            aAdd(aFornecedor,{"a2_cod"     , GetSX8Num("SA2","A2_COD") })
            aAdd(aFornecedor,{"a2_loja"    , "01"})
            aAdd(aFornecedor,{"a2_nome"    , Left(jMSGData["bankAccount"]["issuerName"],TamSX3("A2_NOME")[1])})
            aAdd(aFornecedor,{"a2_nreduz"  , Left(jMSGData["bankAccount"]["issuerName"],TamSX3("A2_NREDUZ")[1])})
            aAdd(aFornecedor,{"a2_est"     , "SP"})
            aAdd(aFornecedor,{"a2_mun"     , "SAO PAULO"})
            aAdd(aFornecedor,{"a2_end"     , Left(jMSGData["bankAccount"]["bankName"],TamSX3("A2_NOME")[1])})
            aAdd(aFornecedor,{"a2_tipo"    , "J"})
            aAdd(aFornecedor,{"a2_cgc"     , Left(jMSGData["bankAccount"]["issuerDocument"],TamSX3("A2_NOME")[1])})

            aRet := createFornecedor(aFornecedor)
            If aRet[1]
                ConfirmSX8()
            EndIf
        EndIf
    EndIf 
return aRet

/*/{Protheus.doc} CapitalGiroInstallmentsResponseV1MessageReader::createFornecedor
	Cria fornecedor com os dados passados pelo array aFornecedor
	@type method
	@author Renato Paiva
	@since 02/10/2025
    @param aFornecedor, Array, Array com os dados do fornecedor
/*/
Function createFornecedor(aFornecedor as Array) as Array 
    Local lRet    := .T. as Logical
    Local nX      := 0   as Numeric
    Local nCount  := 0   as Numeric
    Local oModel  := Nil as Object
    Local aErro   := {}  as Array
    
    If (nCount := Len(aFornecedor)) > 0

        oModel := FwLoadModel ("MATA020")
        oModel:SetOperation(MODEL_OPERATION_INSERT)
        oModel:Activate()

        For nX := 1 To nCount
            oModel:SetValue("SA2MASTER",Upper(aFornecedor[nX][1]) ,aFornecedor[nX][2])
        Next
        
        If(lRet := oModel:VldData())
            oModel:CommitData()
        Else
            aFornecedor := {}
            cResult := oModel:GetErrorMsgText(.T.)
            aAdd(aErro,{"error","ExecAuto MATA020: ",cResult})
        EndIf

        oModel:DeActivate()
        oModel:Destroy()
        oModel := NIL
    EndIf 

return {lRet,aFornecedor,aErro}
