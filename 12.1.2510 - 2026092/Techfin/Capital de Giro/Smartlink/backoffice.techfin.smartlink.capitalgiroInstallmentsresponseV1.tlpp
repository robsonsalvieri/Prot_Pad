#include "TOTVS.ch"
#include "TBICONN.ch"
#include "FWMVCDef.ch"

/*/{Protheus.doc} CapitalGiroInstallmentsResponseV1MessageReader
    Classe de Integração Capital de Giro
    Recebe os dados bancários do fornecedor, valor do crédito e quantidade de parcelas a cada transação realizada.
    @type class
    @author Renato Paiva 
    @since 02/10/2025
/*/
class CapitalGiroInstallmentsResponseV1MessageReader
    data jMSGData    as json
    data jMessage    as json
    data jCustomer   as json
    data jTransacao  as json
    data jParcelas   as json
    data aEmpresaFil as Array
    data cDataInst   as Character
    data cError      as Character
    data cMock       as character
    data lMock       as logical
    
    public method new() constructor
    public method read(oLinkMessage as object) as logical
    public method mock() 
    public method formatMessage()
    public method processMessage()  as logical
    public method loadMessage()     as logical
    public method setMsgData(jMsgData as Json)

    private method setCustomer()
    private method setEmpFil(cCnpj as Character) 
    private method setTransacao() 
    private method setParcelas()
    
    private method getCustomer()      as json
    private method getEmpFil()        as Array
    private method getTransacao()     as json
    private method getParcelas()      as json
    
end class

/*/{Protheus.doc} CapitalGiroInstallmentsResponseV1MessageReader::New
	Método construtor da classe
	@type method
	@author Renato Paiva
	@since 02/10/2025
    @return object, Instância da classe
*/
method New() class CapitalGiroInstallmentsResponseV1MessageReader
    ::jMSGData   := JsonObject():new()
    ::jMessage   := JsonObject():new()
    ::jCustomer  := JsonObject():new()
    ::jTransacao := JsonObject():new()
    ::jParcelas  := JsonObject():new()
    ::aEmpresaFil:= {}
    ::cDataInst  := ""
    ::cError     := ""
    ::cMock      := ""
    ::lMock      := .F.
return Self

/*/{Protheus.doc} CapitalGiroInstallmentsResponseV1MessageReader::mock
    Método para mockar a mensagem recebida para testes
    @type method
    @author Squad TechFin
    @since 02/10/2025
    @param cData, character, dados da mensagem a ser mockada
/*/
method mock(cData as character) class CapitalGiroInstallmentsResponseV1MessageReader
    ::cMock := cData
    ::lMock := .T. 
return

/*/{Protheus.doc} CapitalGiroInstallmentsResponseV1MessageReader::read
	responsável pela leitura e processamento da mensagem.
	@type method
	@author Renato Paiva
	@since 02/10/2025
	@param oLinkMessage, object, Instância de FwTotvsLinkMesage da mensagem
	@return logical, sucesso ou falha. Determina se deve ou não retirar a mensagem da fila.
/*/

method read(oLinkMessage as object) as logical class CapitalGiroInstallmentsResponseV1MessageReader
    local lSuccess := .F.  as logical
    local cMessage := ""   as character

    cMessage := if(::lMock, ::cMock, oLinkMessage:RawMessage())

    if ::jMessage:FromJSON(cMessage) == NIL
        ::setMsgData(::jMessage["data"])
        If ::loadMessage()
            ::formatMessage()
            lSuccess := ::processMessage()
        EndIf
    endIf

    FwFreeObj(::jMSGData)
    FwFreeObj(::jMessage)

Return lSuccess

/*/{Protheus.doc} CapitalGiroInstallmentsResponseV1MessageReader::setMsgData
	Define dados da variavel jMSGData
	@type method
	@author Renato Paiva
	@since 02/10/2025
/*/
method setMsgData(jMsgData as Json)  class CapitalGiroInstallmentsResponseV1MessageReader
    ::jMSGData := jMsgData
Return 

/*/{Protheus.doc} CapitalGiroInstallmentsResponseV1MessageReader::loadMessage
	Realiza load (carga de dados).
	@type method
	@author Renato Paiva
	@since 02/10/2025
    @return Logical, Verdadeiro - quado os dados estão dentro do layout para processsar ou Falso - quando não esta correto.
/*/
method loadMessage() as logical class CapitalGiroInstallmentsResponseV1MessageReader
    Local lRet := .F.

    If ::jMSGData:hasProperty("status") .And. ::jMSGData["status"] == "SUCCESS"
        lRet := .T.
        If ::jMSGData:hasProperty("customers")
            ::setCustomer()
        EndIf
        If ::jMSGData:hasProperty("transaction")
            ::setTransacao()
        EndIf
        If ::jMSGData:hasProperty("installments")
            ::setParcelas()
        EndIf
    EndIf
Return lRet

/*/{Protheus.doc} CapitalGiroInstallmentsResponseV1MessageReader::formatMessage
	Realiza mortação dos dados para processamento.
	@type method
	@author Renato Paiva
	@since 02/10/2025
/*/
method formatMessage() class CapitalGiroInstallmentsResponseV1MessageReader
    local jData       := nil            as json

    jData := JsonObject():Net()
    jData["cliente"]    := ::getCustomer()
    jData["transacao"]  := ::getTransacao()
    jData["parcelas"]   := ::getParcelas()

    ::cDataInst := jData:ToJSON()
   
return

/*/{Protheus.doc} CapitalGiroInstallmentsResponseV1MessageReader::processMessage
	Inicia o processamento da mensagem enviada pelo Smartlink.
	@type method
	@author Renato Paiva
	@since 02/10/2025
    
/*/
method processMessage() as logical class CapitalGiroInstallmentsResponseV1MessageReader
    local cPayload := ""  as character
    local lSuccess := .T. as logical
    Local aSM0     := {}  as array

    aSM0     := ::getEmpFil()

    If Len(aSM0) > 0
        cPayload := ::jMessage:ToJSON()
        
        lSuccess := StartJob("TCGInstRes", GetEnvServer(), .T., aSM0[Len(aSM0)][1], aSM0[Len(aSM0)][2], ::cDataInst, cPayload)
    EndIf    

return lSuccess

/*/{Protheus.doc} CapitalGiroInstallmentsResponseV1MessageReader::setParcelas
	Realiza leitura e carga das parcelas enviadas pelo SmartLink.
	@type method
	@author Renato Paiva
	@since 02/10/2025
/*/
method setCustomer()  class CapitalGiroInstallmentsResponseV1MessageReader
    Local nTotalCustomers := 0                   As numeric
    Local nX              := 0                   As numeric
    
    ::jCustomer := {}

    If (nTotalCustomers := Len(::jMSGData["customers"])) > 0
        For nX := 1 To nTotalCustomers
             aAdd(::jCustomer,{})
            ::jCustomer[Len(::jCustomer)] := JsonObject():New()
            ::jCustomer[Len(::jCustomer)]["cnpjCpf"]           := cValToChar(::jMSGData["customers"][nX]["document"])
            ::jCustomer[Len(::jCustomer)]["razaoSocial"]       := cValToChar(::jMSGData["customers"][nX]["name"])
            ::jCustomer[Len(::jCustomer)]["statusCliente"]     := cValToChar(::jMSGData["customers"][nX]["customerStatus"])
            ::jCustomer[Len(::jCustomer)]["statusClienteDesc"] := cValToChar(::jMSGData["customers"][nX]["descCustomerStatus"])
            
            ::setEmpFil(::jCustomer[Len(::jCustomer)]["cnpjCpf"])
        Next
    EndIf

return 

/*/{Protheus.doc} CapitalGiroInstallmentsResponseV1MessageReader::getCustomer
	Retorna dasdos da empresa (Customer).
	@type method
	@author Renato Paiva
	@since 02/10/2025
/*/
method getCustomer()  class CapitalGiroInstallmentsResponseV1MessageReader
return ::jCustomer

/*/{Protheus.doc} CapitalGiroInstallmentsResponseV1MessageReader::setEmpFil
	Valida dados empresa na SM0
	@type method
	@author Renato Paiva
	@since 02/10/2025
/*/
method setEmpFil(cCnpj as Character)  class CapitalGiroInstallmentsResponseV1MessageReader
    Local aSM0      := FWLoadSM0()	as array
    Local nPosSM0   := 0            as numeric 

    If !Empty(cCnpj) .And. (nPosSM0 := aScan(aSM0, {|x| x[18] == Alltrim(cCnpj)})) > 0
        aAdd(::aEmpresaFil,{aSM0[nPosSM0][1],aSM0[nPosSM0][2],cCnpj})
    EndIf
 return 

/*/{Protheus.doc} CapitalGiroInstallmentsResponseV1MessageReader::getEmpFil
	Retorna dasdos da empresa SM0.
	@type method
	@author Renato Paiva
	@since 02/10/2025
/*/
method getEmpFil()  class CapitalGiroInstallmentsResponseV1MessageReader
return ::aEmpresaFil

/*/{Protheus.doc} CapitalGiroInstallmentsResponseV1MessageReader::setTransacao
	Realiza leitura dos dados da transação.
	@type method
	@author Renato Paiva
	@since 02/10/2025
/*/
method setTransacao()  class CapitalGiroInstallmentsResponseV1MessageReader
    Local jContaCorrete := JsonObject():New() as Json

    jContaCorrete["cnpj"]       := ::jMSGData["bankAccount"]["issuerDocument"]
    jContaCorrete["nomeCNPJ"]   := ::jMSGData["bankAccount"]["issuerName"]
    jContaCorrete["banco"]      := ::jMSGData["bankAccount"]["bankCode"]
    jContaCorrete["nomeBanco"]  := ::jMSGData["bankAccount"]["bankName"]
    jContaCorrete["agencia"]    := ::jMSGData["bankAccount"]["branch"]
    jContaCorrete["conta"]      := ::jMSGData["bankAccount"]["checkingAccount"]
    
    ::jTransacao                   := JsonObject():New()
    ::jTransacao["contaCorrente"]  := jContaCorrete
    ::jTransacao["valor"]          := ::jMSGData["transaction"]["invoiceAmount"]
    ::jTransacao["codigo"]         := ::jMSGData["transaction"]["transactionCode"]
    ::jTransacao["documento"]      := ::jMSGData["transaction"]["invoiceNumber"]
    ::jTransacao["parcelas"]       := ::jMSGData["transaction"]["installmentCount"]
    ::jTransacao["dataCreditoCC"]  := ::jMSGData["transaction"]["partnerReceiptDate"]  
    ::jTransacao["valorIOF"]       := ::jMSGData["transaction"]["contractIofValue"]  
    ::jTransacao["taxaJuros"]      := ::jMSGData["transaction"]["interestRate"]
    ::jTransacao["custoEfetivo"]   := ::jMSGData["transaction"]["effectiveCostValue"]
    ::jTransacao["custoTotal"]     := ::jMSGData["transaction"]["transactionTotalAmount"]
    ::jTransacao["valorPrincipal"] := ::jMSGData["transaction"]["transactionPrincipalAmount"]
    
    
return 

/*/{Protheus.doc} CapitalGiroInstallmentsResponseV1MessageReader::getTransacao
	Retorna objeto JSON da transação carregada.
	@type method
	@author Renato Paiva
	@since 02/10/2025
/*/
method getTransacao() as json class CapitalGiroInstallmentsResponseV1MessageReader
return ::jTransacao

/*/{Protheus.doc} CapitalGiroInstallmentsResponseV1MessageReader::setParcelas
	Realiza leitura e carga das parcelas enviadas pelo SmartLink.
	@type method
	@author Renato Paiva
	@since 02/10/2025
/*/
method setParcelas()  class CapitalGiroInstallmentsResponseV1MessageReader
    Local nTotalParcelas := 0                   As numeric
    Local nX             := 0                   As numeric
    
    ::jParcelas := {}

    nTotalParcelas := Len(::jMSGData["installments"])
    
    For nX := 1 To nTotalParcelas
        aAdd(::jParcelas,{})
        ::jParcelas[Len(::jParcelas)] := JsonObject():New()
        ::jParcelas[Len(::jParcelas)]["numeroParcela"]         := cValToChar(::jMSGData["installments"][nX]["installmentNumber"])
        ::jParcelas[Len(::jParcelas)]["dataVencimentoParcela"] := ::jMSGData["installments"][nX]["dueDate"]
        ::jParcelas[Len(::jParcelas)]["valorTotalParcela"]     := ::jMSGData["installments"][nX]["installmentTotalAmount"]
        ::jParcelas[Len(::jParcelas)]["valorPrincipalParcela"] := ::jMSGData["installments"][nX]["installmentPrincipalAmount"]        
        ::jParcelas[Len(::jParcelas)]["valorJurosParcela"]     := ::jMSGData["installments"][nX]["installmentInterestAmount"]
        ::jParcelas[Len(::jParcelas)]["statusParcela"]         := ::jMSGData["installments"][nX]["installmentStatus"]
        ::jParcelas[Len(::jParcelas)]["statusParcelaDesc"]     := ::jMSGData["installments"][nX]["installmentStatusDesc"]
        ::jParcelas[Len(::jParcelas)]["linhaDigitavel"]        := ::jMSGData["installments"][nX]["digitableLine"]
        ::jParcelas[Len(::jParcelas)]["codigoDeBarras"]        := ::jMSGData["installments"][nX]["barCode"]
        
    Next

return 

/*/{Protheus.doc} CapitalGiroInstallmentsResponseV1MessageReader::getParcelas
	Retorna objeto JSON das parcelas carregadas.
	@type method
	@author Renato Paiva
	@since 02/10/2025
/*/
method getParcelas() as json class CapitalGiroInstallmentsResponseV1MessageReader
return ::jParcelas

/*/{Protheus.doc} TCGInstRes
    Realiza o processamento da criação de emprestimo do capital de giro, coforme dados enviados pelo SmartLink
    @type function
    @author Renato Paiva 
    @since 02/10/2025
    @param cCompany, character, Grupo Empresa
    @param cBranch , character, Filial
    @param cData   , character, dados da organização
    @param cPayload, character, mensagem recebida
/*/
Function TCGInstRes(cCompany as character, cBranch as character, cData as character, cPayload as character) as logical
    Local cUUID         := FWUUIDV4()         As Character
    Local jData         := JsonObject():new() As json
    Local cAplEmp       := ""                 As Character
    Local cRevisao      := ""                 As Character
    Local cBanco        := ""                 As Character
    Local cAgencia      := ""                 As Character
    Local cConta        := ""                 As Character
    Local cGeraParc     := ""                 As Character
    Local cAmortiza     := ""                 As Character
    Local cFornecedor   := ""                 As Character
    Local cLoja         := ""                 As Character
    Local cNumero       := ""                 As Character
    Local cResult       := ""                 As Character
    Local cLog          := ""                 As Character
    Local aExecAuto     := {}                 As Array
	Local aAutoCab	    := {}				  As Array
    Local aParams	    := {}				  As Array
    Local aSEHMst	    := {}                 As Array
	Local aLinha	    := {}                 As Array
	Local aParcelas	    := {}                 As Array
    Local aRetFornecedor:= {}                 As Array
    Local aRetBanco     := {}                 As Array
    Local aLogs         := {}                 As Array
    local aSM0          := {}                 As Array
    Local nMoeda        := 0                  As Numeric
    Local nPrazo        := 0                  As Numeric
    Local nTotal        := 0                  As Numeric
    Local nX            := 0                  As Numeric
    
    Private lMsErroAuto    := .F.           As Logical
	Private lAutoErrNoFile := .T.           As Logical

    RPCSetType(3)
    RPCSetEnv(cCompany, cBranch,,,'FIN')

    aSM0 := FWArrFilAtu()
    
    jData:fromJson(cData)
    
    dDataBase := SToD(StrTran(jData["transacao"]["dataCreditoCC"],"-",""))
    
    If !(totvs.protheus.backoffice.techfin.util.isActive("3",.F.))   
        jOrgData := JsonObject():new()
        jOrgData["ARA_GRPSM0"] := aSM0[01]
        jOrgData["ARA_FILSM0"] := aSM0[02]
        jOrgData["ARA_CNPJ"]   := aSM0[18]
        jOrgData["ARA_NOMFIL"] := aSM0[06]
        jOrgData["ARA_STATUS"] := "0"      //0=Ativo;1=Bloqueado Credito;2=Bloqueado Atraso;3=Cancelado;4=Bloqueado outros
        
        StartJob("TCGOrgLst", GetEnvServer(), .F., aSM0[01], aSM0[02], jOrgData:toJSON(), "")
    EndIf

    If Len(aRetFornecedor := totvs.protheus.backoffice.techfin.capitalgiro.installments.vldFornecedor(cPayload)) > 1
        If !aRetFornecedor[1] 
            aScan(aRetFornecedor[3],{|x| aAdd(aLogs,x) })
        EndIf
    EndIf
    If Len(aRetBanco := totvs.protheus.backoffice.techfin.capitalgiro.installments.vldBanco(cPayload)) > 1
        If !aRetBanco[1]
            aScan(aRetBanco[3],{|x| aAdd(aLogs,x) })
        EndIf
    EndIf
    
    If Len(aLogs) == 0
        cNumero    := GetSX8Num("SEH","EH_NUMERO")
        cAplEmp    := "EMP"       
        cRevisao   := "01"
        cBanco     := Padr(aRetBanco[2][aScan(aRetBanco[2],{|x| Upper(Alltrim(x[1])) == "A6_COD"})][2], TamSx3("A6_COD")[1])
        cAgencia   := Padr(aRetBanco[2][aScan(aRetBanco[2],{|x| Upper(Alltrim(x[1])) == "A6_AGENCIA"})][2], TamSx3("A6_AGENCIA")[1])
        cConta     := Padr(aRetBanco[2][aScan(aRetBanco[2],{|x| Upper(Alltrim(x[1])) == "A6_NUMCON"})][2], TamSx3("A6_NUMCON")[1])
        cGeraParc  := '1'
        cAmortiza  := '1'
        cFornecedor:= Padr(aRetFornecedor[2][aScan(aRetFornecedor[2],{|x| Upper(Alltrim(x[1])) == "A2_COD"})][2], TamSx3("A2_COD")[1])
        cLoja      := Padr(aRetFornecedor[2][aScan(aRetFornecedor[2],{|x| Upper(Alltrim(x[1])) == "A2_LOJA"})][2], TamSx3("A2_LOJA")[1])
        nMoeda     := 1
        nPrazo     := Len(jData["parcelas"])
        nValIOF    := jData["transacao"]["valorIOF"]
        nTxEmp     := jData["transacao"]["taxaJuros"] 
        nTotal     := jData["transacao"]["valor"]
        
        Aadd(aSEHMst, {"EH_FILIAL"  , xFilial("SEH")    , NIL})
        Aadd(aSEHMst, {"EH_NUMERO"  , cNumero           , NIL})
        Aadd(aSEHMst, {"EH_APLEMP"  , cAplEmp           , NIL})
        Aadd(aSEHMst, {"EH_TIPO"    , cAplEmp           , NIL})
        Aadd(aSEHMst, {"EH_REVISAO" , cRevisao          , NIL})
        Aadd(aSEHMst, {"EH_BANCO"   , cBanco            , NIL})
        Aadd(aSEHMst, {"EH_AGENCIA" , cAgencia          , NIL})
        Aadd(aSEHMst, {"EH_CONTA"   , cConta            , NIL})
        Aadd(aSEHMst, {"EH_DATA"    , dDataBase         , NIL})
        Aadd(aSEHMst, {"EH_VALOR"   , nTotal            , NIL})
        Aadd(aSEHMst, {"EH_MOEDA"   , nMoeda            , NIL})
        Aadd(aSEHMst, {"EH_GERPARC" , cGeraParc         , NIL})
        Aadd(aSEHMst, {"EH_AMORTIZ" , cAmortiza         , NIL})
        Aadd(aSEHMst, {"EH_PRAZO"   , nPrazo            , NIL})
        Aadd(aSEHMst, {"EH_VALIOF"  , nValIOF           , NIL})
        Aadd(aSEHMst, {"EH_TAXA"    , nTxEmp            , NIL})
        Aadd(aSEHMst, {"AUTCODFOR"  , cFornecedor       , Nil})
        Aadd(aSEHMst, {"AUTFORLOJA" , cLoja             , Nil})
        
        For nX := 1  To nPrazo
            aLinha := {}
            Aadd(aLinha, {"PARCELA"     , jData["parcelas"][nX]["numeroParcela"]})
            Aadd(aLinha, {"VENCTO"      , SToD(StrTran(jData["parcelas"][nX]["dataVencimentoParcela"],"-",""))})
            Aadd(aLinha, {"VALOR"       , jData["parcelas"][nX]["valorTotalParcela"]})
            Aadd(aLinha, {"JUROS"       , jData["parcelas"][nX]["valorJurosParcela"]})
            Aadd(aLinha, {"VCORRIGIDO"  , jData["parcelas"][nX]["valorTotalParcela"]})
            Aadd(aLinha, {"AMORTIZA"    , jData["parcelas"][nX]["valorPrincipalParcela"]})
            Aadd(aLinha, {"PRESTACAO"   , jData["parcelas"][nX]["valorTotalParcela"]})
            Aadd(aParcelas, aLinha)
        Next

        aExecAuto  := FwVetByDic(aSEHMst, "SEH")
        
        aAdd(aAutoCab, {"SEHMASTER", aExecAuto})

        If Len(aParcelas) > 0
            aAdd(aAutoCab, {"SE2DETAIL", aParcelas})
        Endif
        aAdd(aAutoCab, {"AUTHISTMOV", Left("+Giro Techfin - Contrato " + jData["transacao"]["codigo"], TamSx3("FK5_HISTOR")[1]), NIL})

        SetFunName("FINA171")
        MsExecAuto({|a,b,c,d,e| FINA171(a,b,c,d,e)},0,aAutoCab, 3, aParams)
        If lMsErroAuto
            RollBackSx8()
            cResult := "Erro ao executar rotina FINA171."  
            cResult += CRLF + totvs.protheus.backoffice.ngf.util.GetError()
            cResult += CRLF + fingethelp()
              
            aAdd(aLogs, {"error", "ExecAuto FINA171: ", cResult })              
            
        EndIf
    EndIf

	If Len(aLogs) > 0
        cLog := totvs.protheus.backoffice.techfin.util.formatLog(aLogs)
		
        totvs.protheus.backoffice.techfin.util.logSmartLink(cPayload, "SEH", cUUID, "3", "Installments", "T",,cLog)//cMessage, cAlias, cUUID, cProduct, cOperation, cOrigin, cIDReq, cLogNeg
        
    Else
        ConfirmSX8()
        totvs.protheus.backoffice.techfin.capitalgiro.installments.vldParcelas(jData,aAutoCab)
        
        If SEH->(FieldPos("EH_MSUID"))
            cUUID := SEH->EH_MSUID
        EndIf
        totvs.protheus.backoffice.techfin.util.logSmartLink(cPayload, "SEH", cUUID, "3", "Installments", "T")//cMessage, cAlias, cUUID, cProduct, cOperation, cOrigin, cIDReq, cLogNeg
    EndIf
	    
Return .T.
