#Include "tlpp-core.th"
#include "protheus.ch"
#include "fwmvcdef.ch"
 
NAMESPACE totvs.protheus.backoffice.techfin.duplicataescritural.config.dados
USING NAMESPACE totvs.protheus.backoffice.techfin.smartlink.DupesOptInCnpjExecuteRequestV1
USING NAMESPACE totvs.protheus.backoffice.techfin.duplicataescritural.config
USING NAMESPACE totvs.protheus.backoffice.techfin.util

Static __aFields := {{"A1_CGC"  ,"TFDE_CNPJ","cnpj","CGC(M->TFDE_CNPJ)"},;
                     {"A1_NOME" ,"TFDE_NOME","razaosocial","!Vazio()"}} as Array
Static __aColumn := {}             as Array
Static __oTable                    as Object
Static __cProdTF      := "5"       as Character
Static __cStatusAtivo := "0"       as Character
Static __cAlias  := GetNextAlias() as Character

/*/{Protheus.doc} autorizados
    Realizar fluxo de abertura do objeto de visualização do MVC.
    @type Function
    @author Squad Techfin
    @since 01/03/2026
    @version 1.0
    @param oPanel, Object, Painel disponivel para criação do step
    @param nTipo, Numeric, Tipo de operação, 1 para visualização e diferente de 1 para edição
    @param jDados, Json, JSON contendo os parametros do serviço de Duplicata Escritural
    @param cAlias, Character, Alias temporário para uso do MVC
    @return oView, Object, Objeto da view MVC a ser renderizada no step do wizard
/*/
Function autorizados(oPanel as object, nTipo as Numeric, jDados as Json, cAlias as Character) as Object
    Local oView         as object
    
    oView := FWLoadView("totvs.protheus.backoffice.techfin.duplicataescritural.config.dados.autorizados")    
    oView:SetOwner(oPanel)
    
    If nTipo == 1
        oView:SetOperation( MODEL_OPERATION_VIEW )
    Else
        oView:SetOperation( MODEL_OPERATION_UPDATE )
    EndIf
    
    oView:Activate()


return oView

/*/{Protheus.doc} loadAutorizados
    Realiza o load dos dados para Duplicata Escritural, criando a temporária e carregando os dados do JSON para a mesma
    @type  Function
    @author Squad Techfin
    @since 25/02/2026
    @version 1.0
    @param nTipo, Numeric, Tipo de load, 1 para ModelStruct, 2 para ViewStruct e 3 para load da estrutura de colunas sem SX3 para criação da tabela temporária
    @param aFields, Array, Array com os campos da tabela temporária.
    @param cAlias, Character, Alias para criação da tabela temporária
    @param aColumn, Array, Array com a estrutura de colunas para criação da tabela
    @param oTable, Object, Objeto de tabela para criação da tabela temporária
    @param cJson, Character, JSON contendo os dados para load da tabela temporária
    @return jDados, Json, JSON contendo os dados da Duplicata Escritural.
/*/
Function loadAutorizados(nTipo as Numeric,aFields as Array, cAlias as Character,aColumn as Array,oTable as Object,cJson as Character) as Json
    Local jDados as Json

    Default aFields := __aFields
    Default cAlias  := __cAlias
    Default aColumn := __aColumn
    Default oTable  := __oTable

    __aFields := aFields
    __cAlias  := cAlias
    __aColumn := aColumn
    __oTable  := oTable

    loadStruct(nTipo,__aFields,__cAlias,@__aColumn)   
    createTemporaryTable(__oTable, __aColumn,,,__cAlias)
    jDados := loadDados(cJson,__cAlias)

Return jDados
 
/*/{Protheus.doc} loadDados
    Leitura dos dados para Duplicata Escritural, realizando o parse do JSON e carregando os dados na tabela temporária.
    @type  Function
    @author Squad Techfin
    @since 04/03/2026
    @version 1.0
    @param cJson, Character, JSON contendo os dados para load da tabela temporária
    @param cAlias, Character, Alias para criação da tabela temporária
    @return jData, Json, JSON contendo os dados da Duplicata Escritural.
/*/
Function loadDados(cJson as Character, cAlias as Character) as Json 
    Local jData         as Json
    Local aDados  := {}  as Array
    Local nTotal  := 0   as Numeric
    Local nTotalY := 0   as Numeric
    Local nX      := 0   as Numeric
    Local nY      := 0   as Numeric
    
    Default cJson := getDefault()

    nTotalY := Len(__aFields)
    jData := JsonObject():New()
    jData:fromJson(cJson)
    
    If jData:hasProperty("optInList")
        aDados := jData["optInList"]
        If (nTotal := Len(aDados)) > 0
            clearTemp(cAlias)
            For nX := 1 To nTotal
                RecLock(cAlias,.T.)
                For nY := 1 To nTotalY
                    (cAlias)->&(__aFields[nY][2]) := aDados[nX][__aFields[nY][3]]
                Next
                (cAlias)->(MsUnLock())
            Next
        Else
            RecLock(cAlias,.T.)
            For nY := 1 To nTotalY
                (cAlias)->&(__aFields[nY][2]) := CriaVar(__aFields[nY][1])
            Next
            (cAlias)->(MsUnLock())
        EndIf
    EndIf
       
Return jData

/*/{Protheus.doc} getDefault
    Realiza a leitura dos JSON de parametros do ARA_PARAMS, caso exista, ou retorna um JSON com os parâmetros padrões para o funcionamento da Duplicata Escritural.
    @type  Function
    @author user
    @since 04/03/2026
    @version 1.0
    @return cJson, Character, JSON contendo os dados da Duplicata Escritural.
/*/
Function getDefault() as Character
    Local cJson := "" as Character
    Local aArea := {} as Array
    
    aArea := ARA->(GetArea())
    ARA->(DbSetOrder(2))
    
    If ARA->(DbSeek(FWxFilial("ARA")+cFilAnt+__cProdTF+__cStatusAtivo))
        cJson := Alltrim(ARA->ARA_PARAMS)
    EndIf

    If Empty(cJson)
        BeginContent Var cJson            
            {
                "parametros": {        
                    "escrituracaoAutomatica": false,
                    "permiteNotaFiscal": true,
                    "bloqueiaTitulos": true
                },
                "optInList": [
                    {
                        "cnpj": "",
                        "razaosocial": ""
                    }
                ],
                "service": "",
                "I_N_S_D_T_": "",
                "built": false
            }
        EndContent
    EndIf
    
    RestArea(aArea)
Return cJson

/*/{Protheus.doc} getDateConfig
    Retorna a data de configuração do produto duplicata estrutural, presente no campo I_N_S_D_T_ do JSON ARA_PARAMS no formato AAAAMMDD
    @type  Function
    @author squad Techfin
    @since 17/06/2026
    @version 1.0
    @return cDateConfig, Character, Data de configuração do produto duplicata estrutural no formato AAAAMMDD
/*/
Function getDateConfig()
    Local jConfig := JsonObject():new() as json
    Local cDateConfig := "" as character

    jConfig:fromJson(getDefault())
    If jConfig:hasProperty("I_N_S_D_T_") .and. !Empty(jConfig["I_N_S_D_T_"])
        cDateConfig := jConfig["I_N_S_D_T_"]
        cDateConfig := Replace(Substr(cDateConfig,1,10), "-", "")
    Endif
        
    fwFreeObj(jConfig)

Return cDateConfig

/*/{Protheus.doc} ModelDef
    Montagem do modelo dados para MVC
    @return oModel - Objeto do modelo de dados
    @author Squad Techfin
    @since 11/02/2026
    @version 1.0
/*/
function ModelDef()
    Local oModel    as object
    Local oStrField as object
    Local oStrGrid  as object
    
    oModel := MPFormModel():New("autorizados")
    oModel:setDescription("MVC_TITLE")

    oStrField := loadStruct(1,__aFields,__cAlias)
    oStrGrid  := loadStruct(1,__aFields,__cAlias)
    oModel:addFields("CAB", /*cOwner*/, oStrField, /*bPre*/, /*bPost*/)
    oModel:addGrid("GRID", "CAB", oStrGrid, /*bLinePre*/, /*bLinePost*/, /*bPre*/, /*bPost*/, {|oMdl| loadGrid(oMdl)})
    
    oModel:GetModel("GRID"):SetOptional(.T.)
    oModel:GetModel("GRID"):SetUniqueLine({__aFields[1][2]})

    oModel:SetActivate({|oMdl| loadActivate(oMdl)})

return oModel

/*/{Protheus.doc} loadActivate
    
    @type  Function
    @author squad Techfin
    @since 17/06/2026
    @version 1.0
    @param oModel, Object , Modelo do Objeto

/*/
Function loadActivate(oModel as Object)
    Local oModelGrid := oModel:GetModel("GRID") as Object
    Local nTotal     := 0 as Numeric
    Local nX         := 0 as Numeric
    Local nOperation := 0 as Numeric

    nOperation := oModel:GetOperation()

    If nOperation == MODEL_OPERATION_UPDATE
        If oModelGrid:CanClearData()
            oModelGrid:ClearData(.T.,.F.)
        EndIf

        (__cAlias)->(DbGoTop())
        While !(__cAlias)->(Eof())
            oModelGrid:addLine()
            nTotal := Len(__aFields)
            For nX := 1 To nTotal
                oModelGrid:SetValue(__aFields[nX][2], (__cAlias)->&(__aFields[nX][2]))
            Next
        (__cAlias)->(DbSkip())
        EndDo
    EndIf

Return 
/*/{Protheus.doc} loadGrid
    Função estática para efetuar o load dos dados do grid. Carrega a lista de CNPJs armazenadas no Json do ARA_PARAMS
    @author Squad Techfin
    @since 11/02/2026
    @version 1.0
    @param oModel - Objeto do modelo de dados
    @return aData - Array com os dados para exibição no grid
/*/
function loadGrid(oModel)
    Local aData      := {} as array
    Local aDados     := {} as Array
    Local nTotal     := 0  as Numeric
    Local nX         := 0  as Numeric
    Local nY         := 0  as Numeric
    Local nOperation := 0  as Numeric

    nOperation := oModel:GetOperation()

    If nOperation == MODEL_OPERATION_VIEW
        nTotal := Len(__aFields)

        (__cAlias)->(DbGoTop())
        While !(__cAlias)->(Eof())
            aDados := {}
            For nX := 1 To nTotal
                aAdd(aDados, (__cAlias)->&(__aFields[nX][2]))
            Next
            aAdd(aData,{0, aDados})
            nY++
        (__cAlias)->(DbSkip())
        EndDo    
        clearTemp(__cAlias)
    EndIf

return aData

/*/{Protheus.doc} ViewDef
    Função estática do ViewDef
    @author Squad Techfin
    @since 11/02/2026
    @version 1.0
    @return oView - Objeto da view, interface 
/*/
function viewDef()
    local oView as object
    local oModel as object
    local oStrCab as object
    local oStrGrid as object

    oModel := FWLoadModel("totvs.protheus.backoffice.techfin.duplicataescritural.config.dados.autorizados")
    oView  := FwFormView():New()
    oView:setModel(oModel)

    oStrCab  := loadStruct(2,__aFields) 
    oStrGrid := loadStruct(2,__aFields)

    oView:addField("CAB", oStrCab, "CAB")
    oView:addGrid("GRID", oStrGrid, "GRID")
    oView:createHorizontalBox("TOHIDE", 0 )
    oView:createHorizontalBox("TOSHOW", 100 )
    oView:setOwnerView("CAB", "TOHIDE" )
    oView:setOwnerView("GRID", "TOSHOW")    
    oView:setDescription('')
  
return oView

/*/{Protheus.doc} loadStruct
    Cria objeto de estrutura para uso em ModelStruct, ViewStruct ou estrutura de colunas para criação de tabela temporária, dependendo do tipo passado por parâmetro.
    @type  Function
    @author Squad Techfin
    @since 13/02/2026
    @version 1.0
    @param nTipo, Numeric, Tipo de estrutura a ser criada, 1 para ModelStruct, 2 para ViewStruct e 3 para estrutura de colunas sem SX3 para criação da tabela temporária
    @param aFields, Array, Array com os campos da tabela temporária.
    @param cAlias, Character, Alias para criação da tabela temporária
    @param aColumn, Array, Array com a estrutura de colunas para criação da tabela temporária, caso nTipo seja 3
    @return oStrField, Object, Objeto de estrutura criada para uso em ModelStruct, ViewStruct ou estrutura de colunas para criação de tabela temporária, dependendo do tipo passado por parâmetro.
/*/
Function loadStruct(nTipo as Numeric,aFields as Array, cAlias as Character,aColumn) as Object
    Local nX        := 0  as Numeric
    Local nTotal    := 0  as Numeric
    Local oStrField       as Object
    
    If (nTotal := Len(aFields)) > 0
        If nTipo == 1
            oStrField := FWFormModelStruct():New()
            oStrField:addTable(cAlias, {"TFDE_CNPJ"}, 'MVC_TITLE', {|| cAlias})
            For nX := 1 To nTotal
                oStrField:addField( GetSX3Cache(aFields[nX][1] ,"X3_TITULO"),;
                                    GetSX3Cache(aFields[nX][1]  ,"X3_TITULO"),;
                                    aFields[nX][2],;
                                    GetSX3Cache(aFields[nX][1],"X3_TIPO"),;
                                    GetSX3Cache(aFields[nX][1],"X3_TAMANHO"),;
                                    GetSX3Cache(aFields[nX][1],"X3_DECIMAL"),;
                                    FwBuildFeature( STRUCT_FEATURE_VALID, aFields[nX][4]),;
                                    Nil,;
                                    {},;
                                    .T.,;
                                    FwBuildFeature( STRUCT_FEATURE_INIPAD, "Iif(!INCLUI,"+cAlias+"->" + aFields[nX][2] + ",'')" ),;
                                    .T.,;
                                    .T.,;
                                    .F.)
            Next
        ElseIf nTipo == 2
            oStrField := FWFormViewStruct():New()
            For nX := 1 To nTotal
                oStrField:addField( aFields[nX][2],;
                                    PadL(cValToChar(nX),2,"0"),;
                                    GetSX3Cache(aFields[nX][1] ,"X3_TITULO"),;
                                    GetSX3Cache(aFields[nX][1] ,"X3_TITULO"),;
                                    Nil,;
                                    GetSX3Cache(aFields[nX][1],"X3_TIPO"),;
                                    GetSX3Cache(aFields[nX][1],"X3_PICTURE"),;
                                    NIL,;							
							        NIL,;							
							        .T.)
            Next
        ElseIf nTipo == 3
            aColumn := {}
            For nX := 1 To nTotal
                aAdd(aColumn, { aFields[nX][2],;
                                GetSX3Cache(aFields[nX][1],"X3_TIPO"),;
                                GetSX3Cache(aFields[nX][1],"X3_TAMANHO"),;
                                GetSX3Cache(aFields[nX][1],"X3_DECIMAL") })
            Next

        EndIf
    EndIf

Return oStrField

/*/{Protheus.doc} saveDados
    (long_description)
    @type  Function
    @author Squad Techfin
    @since 11/02/2026
    @version 1.0
    @param cAlias, Character, Alias para criação da tabela temporária
    @param jDados, Json, Dados a serem salvos
    @param oView, Object, View contendo os dados
    @return lRet, Logical, Indicador de sucesso da operação
/*/
Function saveDados(cAlias as Character, jDados as Json, oView as Object, oSay01 as Object, oSay02 as Object, oSay03 as Object,oView5 as Object) as Logical
    Local aDados  := {}  as Array
    Local nTotal  := 0   as Numeric
    Local nTotalY := 0   as Numeric
    Local nX      := 0   as Numeric
    Local nY      := 0   as Numeric
    Local oModel         as Object
    Local jOptInList     as Json
    
    oModel := oView:GetModel()
    nTotalY := Len(__aFields)
    nTotal := oModel:GetModel("GRID"):length()
    If nTotal > 0
        clearTemp(cAlias)
        For nX := 1 To nTotal
            oModel:GetModel("GRID"):GoLine(nX)
            If !oModel:GetModel("GRID"):IsDeleted()
                jOptInList := JsonObject():New()
                RecLock(cAlias,.T.)
                For nY := 1 To nTotalY
                    jOptInList[__aFields[nY][3]]  := Alltrim(oModel:GetModel("GRID"):GetValue(__aFields[nY][2]))
                    (cAlias)->&(__aFields[nY][2]) := Alltrim(oModel:GetModel("GRID"):GetValue(__aFields[nY][2]))
                Next
                (cAlias)->(MsUnLock())
                aAdd(aDados, jOptInList)
            EndIf
        Next
        jDados["optInList"] := aDados
    EndIf
    
Return .T.

/*/{Protheus.doc} commitDados
    Realiza o commit dos dados, salvando o JSON atualizado no campo ARA_PARAMS da tabela ARA.
    @type  Function
    @author Squad Techfin
    @since 11/02/2026
    @version 1.0
    @param jDados, Json, Dados a serem salvos
    @return lRet, Logical, Indicador de sucesso da operação
/*/
Function commitDados(jDados as Json, lSendOptInList as logical) as Logical    
    Local lRet    := .T.    as Logical
    local oOptIn  := Nil    as object

    default lSendOptInList := .F.
        
    ARA->(DbSetOrder(2))
    If (lRet := ARA->(DbSeek(FWxFilial("ARA")+cFilAnt+__cProdTF+__cStatusAtivo)))
        jDados["built"] := .T.
        If Empty(jDados['I_N_S_D_T_'])
            jDados['I_N_S_D_T_'] := FwTimeStamp(6)//Timestamp da primeira configuração do wizard
        EndIf
        RecLock("ARA",.F.)
            ARA->ARA_PARAMS := jDados:toJson()
        ARA->(MsUnLock())

        If lSendOptInList
            //-- Envia mensagem com a lista de Financiadores cadastrados
            oOptIn := DupesOptInCnpjExecuteRequestV1():New()
            oOptIn:Send()
            FwFreeObj(oOptIn)
        EndIf
    EndIf

Return lRet

/*/{Protheus.doc} clearTemp
    Limpa os dados da tabela temporária.
    @type  Function
    @author Squad Techfin
    @since 11/02/2026
    @version 1.0
    @param cAlias, Character, Alias para criação da tabela temporária
/*/
Function clearTemp(cAlias as Character)
    Default cAlias := __cAlias

    If Select(cAlias) > 0
        DbSelectArea(cAlias)
        ZAP
    EndIf
Return

/*/{Protheus.doc} clearVariables
    (long_description)
    @type  Function
    @author Squad Techfin
    @since 16/03/2026
    @version 1.0
    @return lRet, Logical, Indicador de sucesso da operação
    /*/
Function clearVariables() as Logical
    Local lRet := .T. as Logical

    If Select(__cAlias) > 0
        DbSelectArea(__cAlias)
        (__cAlias)->(DbCloseArea())
    EndIf
    __cAlias  := GetNextAlias()
    
Return lRet
