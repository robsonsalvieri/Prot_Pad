#include "tlpp-core.th"
#include "TBICONN.ch"
#include "totvs.ch"
#include "FwMVCDef.ch"

NAMESPACE totvs.protheus.backoffice.techfin.smartlink.DupesLockUnlockRequestV1
USING NAMESPACE totvs.protheus.backoffice.techfin.util

/*/{Protheus.doc} DupesLockUnlockRequestV1    
    Classe de Integração Duplicata Escritural
    Retorno da tentativa de escrituração do título.

    @type class
    @author Squad TechFin
    @since 3/28/2026
/*/
class DupesLockUnlockRequestV1

    data jMessage    as json
    data lMock       as logical
    data cProdTF     as character
    data cIdDoc      as character
    data cOcurrences as character
    data cStatus     as character
    
    public method new() constructor
    public method setIdDoc()
    public method setOcurrences()
    public method setProduct()
    public method setStatus()
    public method send()          as logical
    public method getProduct()    as character
    public method getIdDoc()      as character
    public method getOcurrences() as character
    public method getStatus()     as character
end class

/*/{Protheus.doc} DupesLockUnlockRequestV1::New
    Método construtor da classe
    @type method
    @author Squad TechFin
    @since 3/28/2026
/*/
method new() class DupesLockUnlockRequestV1
    ::jMessage    := JsonObject():new()
    ::lMock       := .F.
    ::cProdTF     := ""
    ::cIdDoc      := ""
    ::cOcurrences := ""
    ::cStatus     := ""

return Self

/*/{Protheus.doc} send
    Método responsável por enviar a mensagem de lock/unlock para o smartlink, além de registrar as ocorrências do evento.
    @type method
    @author Squad TechFin
    @since 10/04/2026
    @version 1.0
    @return lSuccess, logical, Indica se o envio foi bem sucedido
    /*/
Method send() class DupesLockUnlockRequestV1
    local cFila       := "DupesLockUnlockRequestV1" as character
	local jData       := jsonObject():new()         as json
    local jDuplicatas := jsonObject():new()         as json
    local oSmartUtil  := SmartlinkUtil():new()      as object
    local oOcurrences := TechfinOccurrences():new() as object
    local lSuccess    := .F.                        as logical

    jData["respondTo"]       := "DupesLockUnlockResponseV1"
    jData["cnpjSolicitante"] := FwSM0Util():GetSM0Data(cEmpAnt, cFilAnt, {"M0_CGC"})[1][2]
    jData["duplicatas"]      := {}
    
    jDuplicatas := jsonObject():new()
    jDuplicatas["erpInstallmentId"] := ::getIdDoc()
    jDuplicatas["tipo_bloqueio"]    := ::getStatus()
    
    aAdd(jData["duplicatas"], jDuplicatas)
    
    If (lSuccess := oSmartUtil:send(cFila, jData:toJson(), .T.))
        oOcurrences:setProduct(::getProduct()) //Duplicata escritural
        oOcurrences:setIdDoc(::getIdDoc())
        oOcurrences:register(::getOcurrences()) 
                
    EndIf
Return lSuccess


/*/{Protheus.doc} setProduct
    Método para definir o produto Techfin, utilizado para registro de ocorrências no monitor de duplicata escritural.
     Código do produto Techfin:
        5 - Duplicata escritural
    @type method
    @author Squad Techfin
    @since 13/04/2026
    @version 1.0
    @param cProduct, character, Código do produto Techfin
    @return return_var, return_type, return_description
    /*/
Method setProduct(cProduct as character) class DupesLockUnlockRequestV1
    ::cProdTF := cProduct
Return 

/*/{Protheus.doc} getProduct
    Método para obter o Código do produto Techfin definido para a mensagem, utilizado para registro de ocorrências no monitor de duplicata escritural.
     Código do produto Techfin:
        5 - Duplicata escritural
    @type method
    @author Squad Techfin
    @since 13/04/2026
    @version 1.0
    @return cProdTF, character, Código do produto Techfin
/*/
Method getProduct() as character class DupesLockUnlockRequestV1
Return ::cProdTF

