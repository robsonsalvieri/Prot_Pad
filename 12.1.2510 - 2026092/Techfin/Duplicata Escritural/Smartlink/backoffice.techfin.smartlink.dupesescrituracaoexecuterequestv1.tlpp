    @author Squad TechFin
    @since  02/04/2026
    @version P12.1.2510
/*/
//-----------------------------------------------------------------------
Method getModNota() as character class DupesEscrituracaoExecuteRequest
Return ::cModNota

//-----------------------------------------------------------------------
/*/{Protheus.doc} DupesEscrituracaoExecuteRequest::loadParametroDuplicata
    Carrega os parâmetros de duplicata conforme a modalidade da nota fiscal.
    @type method
    @param cModNota Modelo/modalidade da nota fiscal
    @return logical Verdadeiro se parametros foram encontrados e carregados
    @author Squad TechFin
    @since  02/04/2026
    @version P12.1.2510
/*/
//-----------------------------------------------------------------------
Method loadParametroDuplicata() as logical class DupesEscrituracaoExecuteRequest
    Local aDocFiscal    := {}                      as array
    Local lProcess      := .F.                     as logical
    Local aDupMercantil := aClone(::aDupMercantil) as array
    Local aDupServico   := aClone(::aDupServico)   as array
    Local nPos          := 0                       as numeric
    Local cModNota      := ::getModNota()
   
    If ((nPos := aScan(aDupMercantil, {|x| cModNota $ x})) > 0)
        ::setTipoDuplicata(__cTipoDupMercantil)
        aDocFiscal := StrTokArr2(aDupMercantil[nPos], "=")
        lProcess := .T.
    ElseIf ((nPos := aScan(aDupServico, {|x| cModNota $ x})) > 0)
        ::setTipoDuplicata(__cTipoDupServico)
        aDocFiscal := StrTokArr2(aDupServico[nPos], "=")
        lProcess := .T.
    EndIf
    If lProcess
        If Len(aDocFiscal) > 1 .And. Alltrim(aDocFiscal[2]) == Alltrim(cModNota)
            ::setTipoDocFiscal(aDocFiscal[1])
        EndIf
    EndIf
   
    FwFreeArray(aDocFiscal)
    FwFreeArray(aDupMercantil)
    FwFreeArray(aDupServico)
Return lProcess

