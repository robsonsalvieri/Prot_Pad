#include "tlpp-core.th"
#include "totvs.ch"
#include "fwmvcdef.ch"

NAMESPACE totvs.protheus.backoffice.techfin.smartlink.dupesescrituracaoexecuterequest
USING NAMESPACE totvs.protheus.backoffice.techfin.util
USING NAMESPACE totvs.protheus.backoffice.techfin.duplicataescritural.config.dados

Static __lLoadCfg          := .F.                    as Logical
Static __lDupAuto          := .F.                    as Logical
Static __lFilTit           := ExistBlock("TFDFILE1") as Logical
Static __lFilNota          := ExistBlock("TFDFILF2") as Logical
Static __lCustomRule       := ExistBlock("TFDPLESC") as Logical
Static __cTipoDupMercantil := "1"                    as Character
Static __cTipoDupServico   := "2"                    as Character

#define ID_VALORFATURA  1
#define ID_DATAVENC     2
#define ID_JUROSMORA    3
#define ID_MULTA        4
#define ID_ABATIMENTO   5
#define ID_DESCONTO     6
#define ID_JUROSPERCENT 7

/*/{Protheus.doc} escrituraTitulo()
    Chama a classe para executar a escrituração, após a inclusão de título a receber (FINA040).
    @type function
    @author Squad TechFin
    @since  02/04/2026
/*/
Function escrituraTitulo()

    local oDupes    := Nil                  as object
    local lExecTFD  := .T.                  as logical 
    local cChaveTit := ""                   as character
    local cChaveFK7 := ""                   as character
    Local aArea     := FwGetArea()          as array
    local jConfig   := JsonObject():new()   as jSon    
    
    //----------------------------------------------------------------------------
    //-- Verifica se esta configurado com escrituração automática
    If !__lLoadCfg
        __lLoadCfg :=.T.
        jConfig:fromJson(getDefault())
        
        If jConfig["built"]//-- Wizard ja parametrizado
            __lDupAuto := jConfig["parametros"]["escrituracaoAutomatica"]
        EndIf
    EndIF
    
    If __lDupAuto .And. SE1->E1_MOEDA==1 .And. !(SE1->E1_TIPO $ (MVABATIM+"|"+MV_CRNEG+"|"+MVPROVIS+"|"+MVRECANT+"|"+MV_CPNEG+"|"+MVTAXA+"|"+MVTXA+"|"+MVINSS))

        cChaveTit := FWxFilial("SE1", SE1->E1_FILORIG)+"|"+SE1->E1_PREFIXO+"|"+SE1->E1_NUM+"|"+SE1->E1_PARCELA+"|"+SE1->E1_TIPO+"|"+SE1->E1_CLIENTE+"|"+SE1->E1_LOJA
        cChaveFK7 := FINBuscaFK7(cChaveTit, "SE1")

        If __lFilTit//-- P.E para permitir ou nao escrituração
            lExecTFD := ExecBlock("TFDFILE1",.F.,.F.)
        EndIf
        If lExecTFD
            oDupes := DupesEscrituracaoExecuteRequest():New()
            oDupes:addIdFK7(cChaveFK7)
            oDupes:runByInstallment()
            oDupes:Destroy()
        EndIf
    EndIf

    FwRestArea(aArea)
    FwFreeArray(aArea)
    FwFreeObj(jConfig)
Return

//--------------------------------------------------------------------------------------------------
/*/{Protheus.doc} escrituraNota()
    Chama a classe para executar a escrituração de notas após inclusão em documento de saída.
    Valida configurações e dispara processo de escrituração automática por nota fiscal.
    @type function
    @author Squad TechFin
    @since  02/04/2026
    @version P12.1.2510
/*/
//--------------------------------------------------------------------------------------------------
Function escrituraNota()

    local oDupes    := Nil                as object
    local jConfig   := JsonObject():new() as jSon
    local lExecTFD  := .T.                as logical 
    local aArea     := FwGetArea()        as array

    jConfig:fromJson(getDefault())

    If  jConfig["built"] .And. jConfig["parametros"]["escrituracaoAutomatica"]//Wizard ja parametrizado
        If SF2->F2_TIPO $ 'N|C'//N=Normal;C=Compl.Preco/Quantidade
            If __lFilNota
                lExecTFD := ExecBlock("TFDFILF2",.F.,.F.)
            EndIf

            If lExecTFD
                oDupes := DupesEscrituracaoExecuteRequest():New()            
                oDupes:setIdInvoice( SF2->(Recno() ))
                oDupes:runByInvoice() 
                oDupes:Destroy()
            EndIf
        EndIf
    EndIF

    FwRestArea(aArea)
    FwFreeArray(aArea)
    FwFreeObj(jConfig)
Return

//--------------------------------------------------------------------------------------------------
/*/{Protheus.doc} DupesEscrituracaoExecuteRequest
    Envio de títulos para escrituração
    @type       Class
    @author     Totvs
    @since      02/04/2026
    @version    P12.1.2510  
/*/
//--------------------------------------------------------------------------------------------------
Class DupesEscrituracaoExecuteRequest

    data nRecnoNF           as numeric
    data jConfig            as json
    data jPayload           as json
    data aIdsPLoad          as array
    data aIdsList           as array
    data aFilterId          as array
    data lPermiteNotaFiscal as logical
    data lRespLegal         as logical
    data lEscritAvulsa      as logical
    data cIdentRespLegal    as character    
    data cNomeFil           as character
    data cCnpjFil           as character    
    data oRespLegal         as object
    data oIdList            as object
    data lSetMsgToFront     as logical
    data cModNota           as character
    data cDupMercantil      as character
    data cDupServico        as character
    data cTipoDuplicata     as character
    data cTipoDocFiscal     as character
    data aDupMercantil      as array
    data aDupServico        as array

    public method new()  constructor    
    public method Destroy()
    public method setIdInvoice()
    public method addIdFK7()
    public method loadIdList()    
    public method setFilterId()
    public method runByInvoice()
    public method runByInstallment()
    public method SetMsgToFront()

    //Métodos construtores do payload
    private method payloadIni()        
    private method payloadDbArea()
    private method payloadDuplicatas()
    private method payloadDadosDuplicata()
    private method payloadDadosSacador()
    private method payloadDadosSacado()
    private method payloadDuplicatasNota()
    
    private method commitDuplicatas()  
    private method loadCustomRule()
    
    private method setIdsList(cIdDoc as character)
    private method getIdsList() as Array    

    private method setModNota(cEspecie as character)
    private method setTipoDuplicata(cTipoDuplicata as character)
    private method setTipoDocFiscal(cModNota as character)
    private method getModNota() as character
    private method getTipoDuplicata() as character
    private method getTipoDocFiscal() as character
    private method loadParametroDuplicata() as logical
    
End Class 

//--------------------------------------------------------------------------------------------------
/*/{Protheus.doc} DupesEscrituracaoExecuteRequest::new
    Construtor da classe DupesEscrituracaoExecuteRequest.
    Inicializa arrays, variáveis e objetos necessários para execução do processo de escrituração.
    @type method
    @author Squad TechFin
    @since  02/04/2026
    @version P12.1.2510
/*/
//--------------------------------------------------------------------------------------------------
Method New() class DupesEscrituracaoExecuteRequest
    ::nRecnoNF          := 0    
    ::aIdsPLoad         := {}
    ::aIdsList          := {}
    ::aFilterId         := {}
    ::lPermiteNotaFiscal:= .F.
    ::lRespLegal        := .F.    
    ::lEscritAvulsa     := .T.
    ::lSetMsgToFront    := .F.
    ::cIdentRespLegal   := SuperGetMv( "MV_TFDIDRL", .F., " ")    
    ::cModNota          := ''
    ::cDupMercantil     := SuperGetMv( "MV_TFDUPM", .F., "1|NFEL=55|NFCE=65")
    ::cDupServico       := SuperGetMv( "MV_TFDUPS", .F., "2|CTEL=07|CTEL=57|NFSE=99")
    ::aDupMercantil     := StrTokArr2(::cDupMercantil, "|")
    ::aDupServico       := StrTokArr2(::cDupServico, "|")
    ::cTipoDuplicata    := __cTipoDupMercantil
    ::cTipoDocFiscal    := ''
    ::cNomeFil          := ''
    ::cCnpjFil          := ''
    ::oRespLegal        := Nil
    ::oIdList           := Nil
    ::jPayload          := JsonObject():new()   
    ::jConfig           := JsonObject():new()       
    ::jConfig:fromJson(getDefault())
Return self

