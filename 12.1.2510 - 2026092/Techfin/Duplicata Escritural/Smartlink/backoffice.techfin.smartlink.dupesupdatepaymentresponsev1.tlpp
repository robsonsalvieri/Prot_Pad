/*/{Protheus.doc} TFDEUpdatePayment
    Processa o retorno enviado pelo SmartLink para atualizar o status de pagamento das duplicatas no Protheus.
    Realiza transação com registro de ocorrências e logging de operações.
    @type function
    @author squad.techfin 
    @since 02/10/2025
    @param cCompany, character, Identificador do Grupo Empresa
    @param cBranch, character, Identificador da Filial
    @param cData, character, Dados estruturados em json com itens processados e inválidos
    @param cPayload, character, Payload completo da mensagem recebida do SmartLink
    @return logical, Retorna sempre verdadeiro para não gerar retry. Erros são registrados em log para análise posterior
/*/

function TFDEUpdatePayment(cCompany as character, cBranch as character, cData as character, cPayload as character) as logical
    Local cLog         := ""                 as Character
    Local cError       := ""                 as Character
    Local cErrorCode   := ""                 as Character
    Local aLogs        := {}                 as Array
    Local aErros       := {}                 as Array
    Local aInvalidos   := {}                 as Array
    Local aProcessados := {}                 as Array
    Local jData        := jsonObject():new() as json

    RPCSetType(3)
    RPCSetEnv(cCompany, cBranch,,,'FIN')

    Begin Transaction
        Try
            jData:fromjson(cData)

            aInvalidos   := jData["invalidos"]
            aProcessados := jData["processados"]
            
            ARP->(DbSetOrder(1))

            processIdsDoc(aProcessados, @aLogs, @aErros, __cOcurrencesS)
            processIdsDoc(aInvalidos, @aLogs, @aErros, __cOcurrencesE)

            If len(aErros) > 0
                cLog  := formatLog(aErros)
                logSmartLink(cPayload, "ARP", /*cUUID*/, __cProdTF, "UpdatePaymentResponsev1", "T",,cLog)//cMessage, cAlias, cUUID, cProduct, cOperation, cOrigin, cIDReq, cLogNeg
            Else                
                logSmartLink(cPayload, "ARP", /*cUUID*/, __cProdTF, "UpdatePaymentResponsev1", "T",,)//cMessage, cAlias, cUUID, cProduct, cOperation, cOrigin, cIDReq, cLogNeg
            EndIf
        Catch oError 
            DisarmTransaction()
            cErrorCode := "catch"
            cError     := oError:Description
            aAdd(aErros, {"error", cErrorCode, cError})
            cLog  := formatLog(aErros)
            logSmartLink(cPayload, "ARP", /*cUUID*/, __cProdTF, "UpdatePaymentResponsev1", "T",,cLog)//cMessage, cAlias, cUUID, cProduct, cOperation, cOrigin, cIDReq, cLogNeg
        EndTry
    End Transaction

    RpcClearEnv()

    FWFreeArray(aLogs)
    FWFreeArray(aErros)
    FWFreeArray(aProcessados)
    FWFreeArray(aInvalidos)
    FwFreeObj(jData)
Return .T. //Retorno sempre verdadeiro para não gerar retry da mensagem. O tratamento de erros é feito via log para análise posterior.


/*/{Protheus.doc} processIdsDoc
    Processa uma lista de IDs de documentos (parcelas) da tabela ARP, validando registros e registrando ocorrências.
    Atualiza arrays de logs e erros conforme os registros sejam encontrados ou não na base de dados.
    @type function
    @author squad.techfin
    @since 08/05/2026
    @param aDados, array, Array contendo objetos com chave 'erpInstallmentId' a serem processados
    @param aLogs, array, Array de referência para armazenar registros processados com sucesso
    @param aErros, array, Array de referência para armazenar erros de processamento
    @param cOcurrence, character, Código da ocorrência a registrar (ex: '013' para sucesso, '014' para erro)
    @return Nil
/*/
static function processIdsDoc(aDados as Array,aLogs as Array,aErros as Array, cOcurrence as Character) 
    Local nTotal       := 0                          as Numeric
    Local nX           := 0                          as Numeric
    local cFilialARP   := FwXFilial("ARP")           as Character
    local cErroMsg     := ""                         as Character
    local cMotBrowse   := ""                         as Character
    local oOcurrences  := TechfinOccurrences():new() as object
    local aErrosTF     := {}                         as Array

    oOcurrences:setProduct(__cProdTF) //Duplicata escritural
    
    nTotal := Len(aDados)
    For nX := 1 To nTotal
        If ARP->(MsSeek(cFilialARP+aDados[nX]["erpInstallmentId"]))
            aErrosTF    := TFGetError( aDados[nX] )
            cErroMsg    := aErrosTF[1]
            cMotBrowse  := aErrosTF[2]
            oOcurrences:setIdDoc(aDados[nX]["erpInstallmentId"])
            oOcurrences:makeBrowseUpdated(cMotBrowse)
            oOcurrences:setLog(cErroMsg)  
            oOcurrences:register(cOcurrence)   
            aAdd(aLogs, aDados[nX])
        Else
            aAdd(aErros, {"error", aDados[nX]["erpInstallmentId"], "ID de parcela inválido"})
        EndIf
    Next

   FwFreeObj(oOcurrences)
   FwFreeArray(aErrosTF)
Return
