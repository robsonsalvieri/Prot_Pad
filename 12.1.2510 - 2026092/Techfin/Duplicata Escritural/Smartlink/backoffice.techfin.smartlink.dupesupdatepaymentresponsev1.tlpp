#include "tlpp-core.th"
#include "totvs.ch"

USING NAMESPACE totvs.protheus.backoffice.techfin.util

static __cOcurrencesS := "013" as character// "013": {"description": "Alteração de dados processada.",   "origin": "2"},
static __cOcurrencesE := "014" as character// "014": {"description": "Alteração de dados não realizada.","origin": "2"},
static __cProdTF      := "5"   as character//Produto TF - Duplicata Escritural

/*/{Protheus.doc} DupesUpdatePaymentResponseV1MessageReader
    Classe de Integração Dupes Update Payment
    Recebe os dados de atualização de pagamento de duplicatas.
    @type class
    @author squad.techfin 
    @since 02/10/2025
    
/*/
class DupesUpdatePaymentResponseV1MessageReader
    data jMSGData           as json
    data jMessage           as json
    data aEmpresaFil        as Array
    data cMock              as character
    data cData              as Character
    data lMock              as logical
    data aItensInvalidos    as Array
    data aItensProcessados  as Array
    
    public method new() constructor
    public method formatMessage()
    public method processMessage() as logical
    public method loadMessage()    as logical
    public method read(oLinkMessage as object) as logical
    
    public method setMock(cData as character) 
    public method setMsgData(jMsgData as json)
    public method setItensInvalidos(aItens as Array)
    public method setItensProcessados(aItens as Array)
    
    public method getItensInvalidos()   as Array
    public method getItensProcessados() as Array

    private method setEmpFil(cCnpj as Character)
    private method getEmpFil() as Array
    
    
end class

/*/{Protheus.doc} DupesUpdatePaymentResponseV1MessageReader::New
	Método construtor da classe
	@type method
	@author squad.techfin
	@since 02/10/2025
    @return object, Instância da classe
/*/
method New() class DupesUpdatePaymentResponseV1MessageReader 
    ::jMSGData           := jsonObject():new()
    ::jMessage           := jsonObject():new()
    ::aEmpresaFil        := {}
    ::cMock              := ""
    ::cData              := ""
    ::lMock              := .F.
    ::aItensInvalidos    := {}
    ::aItensProcessados  := {}
return Self

/*/{Protheus.doc} DupesUpdatePaymentResponseV1MessageReader::setMock
    Método para mockar a mensagem recebida para testes
    @type method
    @author Squad TechFin
    @since 02/10/2025
    @param cData, character, dados da mensagem a ser mockada
    @return Nil
/*/
method setMock(cData as character) class DupesUpdatePaymentResponseV1MessageReader
    ::cMock := cData
    ::lMock := .T. 
return

/*/{Protheus.doc} DupesUpdatePaymentResponseV1MessageReader::read
	responsável pela leitura e processamento da mensagem.
	@type method
	@author squad.techfin
	@since 02/10/2025
	@param oLinkMessage, object, Instância de FwTotvsLinkMessage da mensagem
	@return logical, sucesso ou falha. Determina se deve ou não retirar a mensagem da fila.
/*/

method read(oLinkMessage as object) as logical class DupesUpdatePaymentResponseV1MessageReader
    local lSuccess := .F.  as logical
    local cMessage := ""   as character

    If ::lMock
        cMessage := ::cMock
    Else
        cMessage := oLinkMessage:RawMessage()
    EndIf

    if ::jMessage:Fromjson(cMessage) == NIL
        ::setMsgData(::jMessage["data"])
        If ::loadMessage()
            ::formatMessage()
            lSuccess := ::processMessage()
        EndIf
    endIf

    FwFreeObj(::jMSGData)
    FwFreeObj(::jMessage)

Return lSuccess

/*/{Protheus.doc} DupesUpdatePaymentResponseV1MessageReader::setMsgData
	Define dados da variavel jMSGData
	@type method
	@author squad.techfin
	@since 02/10/2025	
    @param jMsgData, json, dados da mensagem a serem armazenados
    @return Nil
/*/
method setMsgData(jMsgData as json)  class DupesUpdatePaymentResponseV1MessageReader
    ::jMSGData := jMsgData
Return 

/*/{Protheus.doc} DupesUpdatePaymentResponseV1MessageReader::loadMessage
	Realiza load (carga de dados).
	@type method
	@author squad.techfin
	@since 02/10/2025
    @return logical, Verdadeiro - quado os dados estão dentro do layout para processsar ou Falso - quando não esta correto.
/*/
method loadMessage() as logical class DupesUpdatePaymentResponseV1MessageReader
    Local lRet := .F. as logical

    If ::jMSGData:hasProperty("status") .And. ::jMSGData["status"] == "PROCESSADO"
        lRet := .T.
        
        If ::jMSGData:hasProperty("erpRequestId")
            ::setEmpFil(::jMSGData["erpRequestId"])
        EndIf
        If ::jMSGData:hasProperty("lista_itens_invalidos")
            ::setItensInvalidos(::jMSGData["lista_itens_invalidos"])
        EndIf
        If ::jMSGData:hasProperty("lista_itens_processados")
            ::setItensProcessados(::jMSGData["lista_itens_processados"])
        EndIf
    EndIf
Return lRet

/*/{Protheus.doc} DupesUpdatePaymentResponseV1MessageReader::formatMessage
	Realiza formatação dos dados para processamento.
	@type method
	@author squad.techfin
	@since 02/10/2025	
    @return Nil
/*/
method formatMessage() class DupesUpdatePaymentResponseV1MessageReader
    local jData       := nil            as json

    jData := jsonObject():New()
    jData["invalidos"]    := ::getItensInvalidos()
    jData["processados"]  := ::getItensProcessados()
    
    ::cData := jData:Tojson()
   
return

/*/{Protheus.doc} DupesUpdatePaymentResponseV1MessageReader::processMessage
	Inicia o processamento da mensagem enviada pelo Smartlink.
	@type method
	@author squad.techfin
	@since 02/10/2025
	@return logical, Verdadeiro se o processamento foi bem-sucedido, Falso caso contrário
/*/
method processMessage() as logical class DupesUpdatePaymentResponseV1MessageReader
    local cPayload := ""            as character
    local lSuccess := .T.           as logical
    Local aSM0     := ::getEmpFil() as array

    If Len(aSM0) > 0
        cPayload := ::jMessage:Tojson()
        
        lSuccess := StartJob("TFDEUpdatePayment", GetEnvServer(), .T., aSM0[Len(aSM0)][1], aSM0[Len(aSM0)][2], ::cData, cPayload)
    EndIf    

return lSuccess

/*/{Protheus.doc} DupesUpdatePaymentResponseV1MessageReader::setEmpFil
	Valida dados empresa na SM0
	@type method
	@author squad.techfin
	@since 02/10/2025
	@param cErpRequestId, character, identificador de requisição da empresa
	@return Nil
/*/
method setEmpFil(cErpRequestId as Character)  class DupesUpdatePaymentResponseV1MessageReader
    Local nPosSM0   := 0                             as numeric 
    Local aSM0      := FWLoadSM0()	                 as array
    Local aErpReqId := StrTOKArr2(cErpRequestId,"|") as array

    If Len(aErpReqId) >= 3 .And. (nPosSM0 := aScan(aSM0, {|x| (Alltrim(x[1]) == Alltrim(aErpReqId[1]) .And. Alltrim(x[2]) == Alltrim(aErpReqId[2]))})) > 0
        aAdd(::aEmpresaFil,{aSM0[nPosSM0][1],aSM0[nPosSM0][2],cErpRequestId})
    EndIf
 return 

/*/{Protheus.doc} DupesUpdatePaymentResponseV1MessageReader::getEmpFil
	Retorna dados da empresa SM0.
	@type method
	@author squad.techfin
	@since 02/10/2025
	@return array, Array com dados da empresa e filial
/*/
method getEmpFil() as Array class DupesUpdatePaymentResponseV1MessageReader
return ::aEmpresaFil

