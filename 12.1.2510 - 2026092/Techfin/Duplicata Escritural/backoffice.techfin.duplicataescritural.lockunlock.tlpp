#include "tlpp-core.th"
#include "totvs.ch"
#include "fwmvcdef.ch"
#include "backoffice.techfin.duplicataescritural.lockunlock.ch"


NAMESPACE totvs.protheus.backoffice.techfin.duplicataescritural.lockunlock
USING NAMESPACE totvs.protheus.backoffice.techfin.util

static __cProdTF := "5"       as Character

static __cStatusBloqueado    := "1" as Character
static __cStatusDesbloqueado := "2" as Character

static __cTipoProcessadoSucesso    := "1" as Character
static __cTipoProcessadoNaoSucesso := "2" as Character

static __cOcurrenciaBlqRealizado       := "007" as Character // Bloqueio realizado
static __cOcurrenciaBlqNaoRealizado    := "008" as Character // Bloqueio não realizado
static __cOcurrenciaDesblqRealizado    := "009" as Character // Desbloqueio realizado
static __cOcurrenciaDesblqNaoRealizado := "010" as Character // Desbloqueio não realizado

/*/{Protheus.doc} DupesLockUnlock
    Classe responsável pelo processamento de bloqueio e desbloqueio de documentos ARP (Duplicata Escritural)
    @type class
    @author Squad.TechFin
    @since 03/05/2026
    @version 1.0
/*/
Class DupesLockUnlock 
    data cIdDoc           as Character
    data cTpLockUnlock    as Character
    data cLockUnlockValue as Character
    data cOcurrences      as Character
    data aError           as Array

    public method new()
    public method destroy()
    
    public method process(cIdDocARP as character) as logical
    
    public method setIdLockUnlock(cIdDocARP as character)
    public method setTipo(cTpLockUnlock as character)

    public method getIdLockUnlock()      as character
    public method getTipo()    as character

    public method getError() as Array

    private method setValue(cLockUnlockValue as character)
    private method getValue() as character
    
    private method loadOcurrences() as logical
    private method saveOcurrences() 
    
    private method setOcurrences(cOcurrences as character)
    private method getOcurrences() as character

    private method setError(cError as character, cErrorCode as character)
End Class

/*/{Protheus.doc} new
    Construtor da classe DupesLockUnlock
    @author Squad.TechFin
    @since 03/05/2026
    @version 1.0
    @type method
    @return self, object, Instância da classe
/*/
Method new() class DupesLockUnlock
    ::cIdDoc           := ""
    ::cTpLockUnlock    := ""
    ::cLockUnlockValue := ""
    ::cOcurrences      := ""
    ::aError           := {}
Return self

/*/{Protheus.doc} destroy
    Destrutor da classe DupesLockUnlock
    @author Squad.TechFin
    @since 03/05/2026
    @version 1.0
    @type method
    @return Nil
/*/
Method destroy() class DupesLockUnlock
    ::cIdDoc           := ""
    ::cTpLockUnlock    := ""
    ::cLockUnlockValue := ""
    ::cOcurrences      := ""
    ::aError           := {}
Return 

/*/{Protheus.doc} setIdLockUnlock
    Define o ID do documento ARP e busca seu status de bloqueio/desbloqueio
    @author Squad.TechFin
    @since 03/05/2026
    @version 1.0
    @type method
    @param cIdDocARP, character, ID do documento ARP
    @return Nil
/*/
Method setIdLockUnlock(cIdDocARP as character) class DupesLockUnlock
    ARP->(DbSetOrder(1))
    If ARP->(MsSeek(FwXFilial("ARP")+cIdDocARP))
        ::cIdDoc  := ARP->ARP_IDDOC
        ::setValue(ARP->ARP_SITUAC)
    EndIf
Return

/*/{Protheus.doc} getIdLockUnlock
    Obtém o ID do documento ARP
    @author Squad.TechFin
    @since 03/05/2026
    @version 1.0
    @type method
    @return character, ID do documento ARP
/*/
Method getIdLockUnlock() class DupesLockUnlock
Return ::cIdDoc

/*/{Protheus.doc} setValue
    Define o valor do status de bloqueio/desbloqueio do documento
    @author Squad.TechFin
    @since 03/05/2026
    @version 1.0
    @type method
    @param cLockUnlockValue, character, Status do documento (bloqueado/desbloqueado)
    @return Nil
/*/
Method setValue(cLockUnlockValue as character) class DupesLockUnlock
    If cLockUnlockValue == __cStatusBloqueado         // Bloqueado, será desbloqueado caso mensagem seja de processado com sucesso
        ::cLockUnlockValue := __cStatusDesbloqueado   // Desbloqueado
    ElseIf cLockUnlockValue == __cStatusDesbloqueado  // Desbloqueado, será bloqueado caso mensagem seja de processado com sucesso
        ::cLockUnlockValue := __cStatusBloqueado      // Bloqueado
    EndIf
Return

/*/{Protheus.doc} getValue
    Obtém o valor do status de bloqueio/desbloqueio do documento
    @author Squad.TechFin
    @since 03/05/2026
    @version 1.0
    @type method
    @return character, Status do documento (bloqueado/desbloqueado)
/*/
Method getValue() as character class DupesLockUnlock
Return ::cLockUnlockValue

/*/{Protheus.doc} setTipo
    Define o tipo de bloqueio/desbloqueio do documento
    @author Squad.TechFin
    @since 03/05/2026
    @version 1.0
    @type method
    @param cTpLockUnlock, character, Tipo de bloqueio/desbloqueio
    @return Nil
/*/
Method setTipo(cTpLockUnlock as character) class DupesLockUnlock
    ::cTpLockUnlock := cTpLockUnlock
Return

/*/{Protheus.doc} getTipo
    Obtém o tipo de bloqueio/desbloqueio do documento
    @author Squad.TechFin
    @since 03/05/2026
    @version 1.0
    @type method
    @return character, Tipo de bloqueio/desbloqueio
/*/
Method getTipo() as character class DupesLockUnlock
Return ::cTpLockUnlock

/*/{Protheus.doc} process
    Processa o bloqueio ou desbloqueio do documento ARP e registra as ocorrências
    @author Squad.TechFin
    @since 03/05/2026
    @version 1.0
    @type method
    @param cIdDocARP, character, ID do documento ARP
    @return logical, .T. se operação realizada com sucesso
/*/
Method process(cIdDocARP as character) as logical class DupesLockUnlock
    local oModel           := Nil          as Object 
    local oModelARP        := Nil          as Object
    local oModelARQ        := Nil          as Object
    local lRet             := .F.          as logical 
    local cError           := ""           as character
    local cLockUnlockValue := ""           as character
    local cErrorCode       := ""           as character
    
    If !Empty(cIdDocARP) 
        ::setIdLockUnlock(cIdDocARP)
        
        Begin Transaction
            Try 
                If !Empty(::getIdLockUnlock()) .and. ::loadOcurrences()
                    lRet := .T. 
                    If ::getTipo() == __cTipoProcessadoSucesso   
                        cLockUnlockValue := ::getValue()
                        oModel    := FWLoadModel("totvs.protheus.backoffice.techfin.duplicataescritural.monitor.duplicatasMonitor")
                        oModelARP := oModel:GetModel("ARPMASTER")
                        oModelARQ := oModel:GetModel("ARQDETAIL")
                        oModelARQ:SetOptional(.T.)
                        oModel:SetOperation(MODEL_OPERATION_UPDATE)
                        oModel:Activate()
                        
                        oModelARP:setValue("ARP_SITUAC",cLockUnlockValue)

                        if ! (lRet := oModel:vldData() .and. oModel:commitData() .and. !oModel:HasErrorMessage())
                            cError := oModel:GetErrorMsgText(.T.)
                            cErrorCode := ""
                            ::setError(cError,cErrorCode)
                        endif
                        oModel:deActivate()
                        oModel:destroy()
                        oModel := NIL
                    
                    EndIf

                    If lRet 
                        ::saveOcurrences()
                    EndIf
                EndIf
            
            Catch oError
                If oModel != Nil
                    oModel:deActivate()
                    oModel:destroy()
                    oModel := Nil
                EndIf
                cErrorCode := ""
                cError     := oError:Description
                ::setError(cError, cErrorCode)
                lRet := .F.
                Disarmtransaction()
                Break 
            EndTry
        
        End Transaction

        If !lRet .And. !Empty(cError)
            FWLogMsg("ERROR", , "APP", "DUPMODELVALID", , "01", STR0002 + cError, 0, 0, {})
        EndIf

    EndIf

Return lRet

/*/{Protheus.doc} setError
    Define o erro ocorrido durante o processo de bloqueio/desbloqueio
    @author Squad.TechFin
    @since 03/05/2026
    @version 1.0
    @type method
    @param cError, character, Mensagem de erro
    @param cErrorCode, character, Código de erro
    @return Nil
/*/
Method setError(cError as character, cErrorCode as character) class DupesLockUnlock
    local aError := {} as Array
    
    aAdd(aError, {"cError"          ,cError})
    aAdd(aError, {"cErrorCode"      ,cErrorCode})
    aAdd(aError, {"cLockUnlock"     ,::getIdLockUnlock()})
    aAdd(aError, {"cLockUnlockValue",::getValue()})
    aAdd(aError, {"cTpLockUnlock"   ,::getTipo()})
    aAdd(aError, {"cOcurrences"     ,::getOcurrences()})

    ::aError := aClone(aError)
Return 

/*/{Protheus.doc} getError
    Obtém os erros ocorridos durante o processo de bloqueio/desbloqueio
    @author Squad.TechFin
    @since 03/05/2026
    @version 1.0
    @type method
    @return Array, Array com informações de erro
/*/
Method getError() as Array class DupesLockUnlock
Return ::aError

/*/{Protheus.doc} loadOcurrences
    Carrega as ocorrências baseado no tipo e status do bloqueio/desbloqueio
    @author Squad.TechFin
    @since 03/05/2026
    @version 1.0
    @type method
    @return logical, .T. se ocorrência foi definida com sucesso
/*/
Method loadOcurrences() as logical class DupesLockUnlock
    local cLockUnlockValue := ::getValue() as character
    local cTpLockUnlock    := ::getTipo()  as character
    local cOcurrences      := ""           as character
    local lRet             := .F.          as logical
                                                                                                     
    If cTpLockUnlock == __cTipoProcessadoSucesso              // Processado com sucesso
        If cLockUnlockValue == __cStatusBloqueado             // Registro bloqueado 
            cOcurrences := __cOcurrenciaBlqRealizado          // Bloqueio realizado
        ElseIf cLockUnlockValue == __cStatusDesbloqueado      // Registro desbloqueado
            cOcurrences := __cOcurrenciaDesblqRealizado       // Desbloqueio realizado
        EndIf
    ElseIf cTpLockUnlock == __cTipoProcessadoNaoSucesso       // Registro não processado com sucesso
        If cLockUnlockValue == __cStatusBloqueado             // Registro bloqueado
            cOcurrences := __cOcurrenciaBlqNaoRealizado       // Bloqueio não realizado
        ElseIf cLockUnlockValue == __cStatusDesbloqueado      // Registro desbloqueado
            cOcurrences := __cOcurrenciaDesblqNaoRealizado    // Desbloqueio não realizado
        EndIf
    EndIf
    If ! Empty(cOcurrences)
        lRet := .T.
        ::setOcurrences(cOcurrences)
    EndIf

Return lRet

/*/{Protheus.doc} setOcurrences
    Define o código de ocorrência do bloqueio/desbloqueio
    @author Squad.TechFin
    @since 03/05/2026
    @version 1.0
    @type method
    @param cOcurrences, character, Código da ocorrência
    @return Nil
/*/
Method setOcurrences(cOcurrences as character) class DupesLockUnlock
    ::cOcurrences := cOcurrences
Return 

/*/{Protheus.doc} getOcurrences
    Obtém o código de ocorrência do bloqueio/desbloqueio
    @author Squad.TechFin
    @since 03/05/2026
    @version 1.0
    @type method
    @return character, Código da ocorrência
/*/
Method getOcurrences() as character class DupesLockUnlock
Return ::cOcurrences

/*/{Protheus.doc} saveOcurrences
    Salva a ocorrência do bloqueio/desbloqueio no sistema
    @author Squad.TechFin
    @since 03/05/2026
    @version 1.0
    @type method
    @return Nil
/*/
Method saveOcurrences() class DupesLockUnlock
    local oOcurrences := TechfinOccurrences():new()  as object

    oOcurrences:setProduct(__cProdTF) //Duplicata escritural
    oOcurrences:setIdDoc(::getIdLockUnlock())
    oOcurrences:register(::getOcurrences())   

    FwFreeObj(oOcurrences)

Return
