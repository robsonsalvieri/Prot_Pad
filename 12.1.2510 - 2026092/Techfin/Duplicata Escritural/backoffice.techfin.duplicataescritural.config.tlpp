#Include "tlpp-core.th"
#Include "FwMVCDef.ch"
#Include "Protheus.ch"
#include "backoffice.techfin.duplicataescritural.config.ch"

NAMESPACE totvs.protheus.backoffice.techfin.duplicataescritural.config
USING NAMESPACE totvs.protheus.backoffice.techfin.duplicataescritural.config.dados
USING NAMESPACE totvs.protheus.backoffice.techfin.util

/*/{Protheus.doc} Wizard
    Wizard para configuração do serviço de Duplicatas Escriturais.
    @type  Function
    @author Squad Techfin
    @since 12/02/2026
    @version 1.0
    @param Nil
    @return Nil

/*/
Function Wizard()
    Local cAlias := "" as Character
    Local oWizard      as Object
    Local oFirstStep   as Object
    Local oSecondStep  as Object
    Local oThirdStep   as Object
    Local oFourthStep  as Object
    Local oFivethStep  as Object
    Local oView4       as Object
    Local oView5       as Object
    Local oSay01       as Object
    Local oSay02       as Object
    Local oSay03       as Object
    Local jDados       as Json
    Local lActivate    as Logical

    If (lActivate := isActive("5",.F.)) 
        cAlias := GetNextAlias()

        jDados := loadAutorizados(3,, cAlias,,)
    
        oWizard:= FWWizardControl():New(, {550, 750})
        oWizard:ActiveUISteps()

        // "Sobre o serviço"
        oFirstStep := oWizard:AddStep("1")
        oFirstStep:SetStepDescription(STR0001) //"Sobre o serviço"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
        oFirstStep:SetConstruction({|oPanel| createFirstStep(oPanel,jDados)})
        oFirstStep:SetNextAction({|| .T.  })
        oFirstStep:SetCancelAction({|| .T. })
            
        // "Forma de escrituração"
        oSecondStep := oWizard:AddStep("2")
        oSecondStep:SetStepDescription(STR0002) //"Forma de escrituração" 
        oSecondStep:SetConstruction({|oPanel| createSecondStep(oPanel,jDados)})
        oSecondStep:SetNextAction({|| .T. })
        oSecondStep:SetPrevAction({|| .T. })
        oSecondStep:SetCancelAction({|| .T. })
            
        // "Regras de escrituração"
        oThirdStep := oWizard:AddStep("3")
        oThirdStep:SetStepDescription(STR0003) //"Regras de escrituração"
        oThirdStep:SetConstruction({|oPanel| createThirdStep(oPanel,jDados)})
        oThirdStep:SetNextAction({|| .T.})
        oThirdStep:SetPrevAction({|| .T. })
        oThirdStep:SetCancelAction({|| .T. })

        // "Autorizações" 
        oFourthStep := oWizard:AddStep("4")
        oFourthStep:SetStepDescription(STR0004) //"Autorizações" 
        oFourthStep:SetConstruction({|oPanel| oView4 := createFourthStep(oPanel,jDados,cAlias)})
        oFourthStep:SetNextAction({|| Iif(oView4 == NIL, .F., saveDados(cAlias,jDados,oView4,@oSay01,@oSay02,@oSay03,@oView5))})
        oFourthStep:SetPrevAction({|| .T. })
        oFourthStep:SetCancelAction({|| .T. })

        // "Revisão"
        oFivethStep := oWizard:AddStep("5")
        oFivethStep:SetStepDescription(STR0005) //"Revisão"
        oFivethStep:SetConstruction({|oPanel| oView5 := createFivethStep(oPanel,jDados,cAlias,@oSay01,@oSay02,@oSay03)})
        oFivethStep:SetNextAction({|| commitDados(jDados, .T.)}) 
        oFivethStep:SetPrevAction({|| .T. })
        oFivethStep:SetCancelAction({|| .T. })

        oWizard:Activate()
        oWizard:Destroy()
        clearVariables()
     
        oFirstStep  := Nil
        oSecondStep := Nil
        oThirdStep  := Nil
        oFourthStep := Nil
        oFivethStep := Nil
        oWizard     := Nil
        oView4      := Nil
        oView5      := Nil
        oSay01      := Nil
        oSay02      := Nil
        oSay03      := Nil

        FwFreeObj(oFirstStep)
        FwFreeObj(oSecondStep)
        FwFreeObj(oThirdStep)
        FwFreeObj(oFourthStep)
        FwFreeObj(oFivethStep)
        FwFreeObj(oWizard)
        FwFreeObj(oView4)
        FwFreeObj(oView5)
        FwFreeObj(oSay01)
        FwFreeObj(oSay02)
        FwFreeObj(oSay03)

    EndIf
Return 

/*/{Protheus.doc} createFirstStep
    Realiza a criação do primeiro step do wizard
    @type  Static Function
    @author Squad Techfin
    @since 01/03/2026
    @version 1.0
    @param oPanel, Object, Painel disponivel para criação do step
    @param jDados, Json, JSON contendo os parametros do serviço de Duplicata Escritural
/*/
Static Function createFirstStep(oPanel as object, jDados as Json)
    Local oLayer := FWLayer():new() as object
    Local oPanelBody                as object
    Local cMsg1 := "" as character
    Local cMsg2 := "" as character
    Local cMsg3 := "" as character
    Local cMsg4 := "" as character
    
    oLayer:Init(oPanel, .F.)

    oLayer:AddLine("PAINEL", 100, .F.)
    oLayer:addCollumn("CORPO", 100, .T., "PAINEL")
    oPanelBody := oLayer:getColPanel('CORPO','PAINEL')

    cMsg1 := STR0006 //"Este assistente ajuda a configurar o serviço de Duplicatas Escriturais no TOTVS Protheus."
    cMsg2 := STR0007 //"A escrituração permite registrar seus títulos a receber como duplicatas escriturais, conforme a " 
    cMsg3 := STR0008 //"regulamentação vigente. "
    cMsg4 := STR0009 //"Depois de configurado, você poderá selecionar títulos à registradora. "

    TSay():New(015, 25, {|| cMsg1 }, oPanelBody, , TFont():New(,,-15,,,), .F., .F., .F., .T., , , 450, 20,,,,,,.T.) 
    TSay():New(045, 25, {|| cMsg2 }, oPanelBody, , TFont():New(,,-15,,,), .F., .F., .F., .T., , , 450, 20,,,,,,.T.) 
    TSay():New(060, 25, {|| cMsg3 }, oPanelBody, , TFont():New(,,-15,,,), .F., .F., .F., .T., , , 450, 20,,,,,,.T.) 
    TSay():New(080, 25, {|| cMsg4 }, oPanelBody, , TFont():New(,,-15,,,), .F., .F., .F., .T., , , 450, 20,,,,,,.T.) 
    
Return

/*/{Protheus.doc} createSecondStep
    Realiza a criação do segundo step do wizard
    @type  Static Function
    @author Squad Techfin
    @since 01/03/2026
    @version 1.0
    @param oPanel, Object, Painel disponivel para criação do step
    @param jDados, Json, JSON contendo os parametros do serviço de Duplicata Escritural
/*/
Static Function createSecondStep(oPanel as object, jDados as Json)
    Local oLayer := FWLayer():new() as object
    Local oPanelBody                as object
    Local oCheck1                   as object
    Local oCheck2                   as object
    Local cLinkTDN := "https://tdn.totvs.com/pages/viewpage.action?pageId=1060868911" as Character
    Local cMsg     := ""            as Character

    oLayer:Init(oPanel, .F.)

    oLayer:AddLine("PAINEL", 90, .F.)
    oLayer:addCollumn("CORPO", 100, .T., "PAINEL")
    oPanelBody := oLayer:getColPanel('CORPO','PAINEL')

    TSay():New(10, 25, {|| STR0010 }, oPanelBody,, TFont():New(,,-20,,,), .F., .F., .F., .T., , , 300, 20,,,,,,.T.) //"Forma de escrituração"

    oCheck1 := TCheckBox():New(30, 35, STR0011, {|| jDados["parametros"]["escrituracaoAutomatica"] }, oPanelBody, 250, 20, Nil,;
                                {|| jDados["parametros"]["escrituracaoAutomatica"]:=!jDados["parametros"]["escrituracaoAutomatica"],oCheck1:CtrlRefresh(),oCheck2:CtrlRefresh() },;
                                TFont():New(,,-15,,,), {|| .T.}, Nil, ,.T.) //"Automatica"
    TSay():New(45, 45, {|| STR0012 }, oPanelBody,, TFont():New(,,-12,,.F.,,,,,,.T.), .F., .F., .F., .T., , , 250, 20,,,,,,.T.)//"O sistema identifica e envia automaticamente os títulos elegíveis para escrituração." 
    
    oCheck2 := TCheckBox():New(60, 35, STR0013, {|| !jDados["parametros"]["escrituracaoAutomatica"] }, oPanelBody, 250, 20, Nil,;
                                {||  jDados["parametros"]["escrituracaoAutomatica"]:=!jDados["parametros"]["escrituracaoAutomatica"],oCheck2:CtrlRefresh(),oCheck1:CtrlRefresh() },;
                                TFont():New(,,-15,,,), {|| .T.}, Nil, ,.T.) //"Manual"
    TSay():New(75, 45, {|| STR0014 }, oPanelBody,, TFont():New(,,-12,,.F.,,,,,,.T.), .F., .F., .F., .T., , , 250, 20,,,,,,.T.)//"Você escolhe quais títulos quer enviar para escrituração."
    

    TSay():New(100, 25, {|| STR0015 }, oPanelBody,, TFont():New(,,-12,,.F.,,,,,,.T.), .F., .F., .F., .T., , , 250, 20,,,,,,.T.)//"Precisa de regras mais avançadas?"
    cMsg := STR0016 //"Para personalizações além das opções deste Wizard, use um "
    cMsg += "<b><a target='_blank' href='"+cLinkTDN+"'> "
	cMsg += STR0017//"Ponto de Entrada do Protheus."
	cMsg += " </a></b>."
	cMsg += "<span style='font-family: Verdana; font-size: 12px; color: #565759;' >" + ' ' +"</span>"
	cMsg := i18n(cMsg)
    TSay():New(115, 25, {|| cMsg }, oPanelBody,, TFont():New(,,-12,,.F.,,,,,,.T.), .F., .F., .F., .T., , , 250, 20,,,,,,.T.)
    
Return

/*/{Protheus.doc} createThirdStep
    Realiza a criação do terceiro step do wizard
    @type  Static Function
    @author Squad Techfin
    @since 01/03/2026
    @version 1.0
    @param oPanel, Object, Painel disponivel para criação do step
    @param jDados, Json, JSON contendo os parametros do serviço de Duplicata Escritural
/*/
Static Function createThirdStep(oPanel as object, jDados as Json)
    Local oLayer := FWLayer():new() as object
    Local oPanelBody                as object
    Local oCheck1                   as object
    Local oCheck2                   as object
    
    oLayer:Init(oPanel, .F.)

    oLayer:AddLine("PAINEL", 90, .F.)
    oLayer:addCollumn("CORPO", 100, .T., "PAINEL")
    oPanelBody := oLayer:getColPanel('CORPO','PAINEL')

    TSay():New(15, 25, {|| STR0018 }, oPanelBody,, TFont():New(,,-20,,,), .F., .F., .F., .T., , , 300, 20,,,,,,.T.) //"Regras da escrituração"

    oCheck1 := TCheckBox():New(30, 35, STR0019, {||jDados["parametros"]["permiteNotaFiscal"] }, oPanelBody, 250, 20, Nil,; 
                                {|| jDados["parametros"]["permiteNotaFiscal"]:=!jDados["parametros"]["permiteNotaFiscal"],oCheck1:CtrlRefresh(),oCheck2:CtrlRefresh() },;
                                TFont():New(,,-15,,,), {|| .T.}, Nil, ,.T.) //"Permitir escrituração por Nota Fiscal quando houver erro na parcela"
    TSay():New(40, 45, {|| STR0020 }, oPanelBody,, TFont():New(,,-12,,.F.,,,,,,.T.), .F., .F., .F., .T., , , 250, 20,,,,,,.T.) //"Se um título não puder ser escriturado por parcela, o sistema poderá usar a Nota Fiscal, incluindo todos os títulos vinculados a ela."
    
    oCheck2 := TCheckBox():New(60, 35, STR0021, {|| jDados["parametros"]["bloqueiaTitulos"] }, oPanelBody, 250, 20, Nil,;
                                {|| jDados["parametros"]["bloqueiaTitulos"]:=!jDados["parametros"]["bloqueiaTitulos"],oCheck1:CtrlRefresh(),oCheck2:CtrlRefresh() },;
                                TFont():New(,,-15,,,), {|| .T.}, Nil, ,.T.) //"Bloquear títulos para negociação"

    TSay():New(110, 20, {|| STR0022 }, oPanelBody,, TFont():New(,,-12,,.F.,,,,,,.T.), .F., .F., .F., .T., , , 250, 20,,,,,,.T.)//"Quando ativado, os títulos escriturados ficam bloqueados para negociações (antecipação, garantia, etc). O desbloqueio pode ser feito de forma manual na rotina de Duplicatas Escriturais."
    
Return

/*/{Protheus.doc} createFourthStep
    Realiza a criação do quarto step do wizard
    @type  Static Function
    @author Squad Techfin
    @since 01/03/2026
    @version 1.0
    @param oPanel, Object, Painel disponivel para criação do step
    @param jDados, Json, JSON contendo os parametros do serviço de Duplicata Escritural
    @param cAlias, Character, Alias temporário para uso do MVC
/*/
Static Function createFourthStep(oPanel as object, jDados as Json, cAlias as Character) as Object
    Local nTipo  := 3               as Numeric   
    Local oLayer := FWLayer():new() as object
    Local oPanelBody                as object
    Local oPanelHeader              as object
    Local oView                     as object
    
    oLayer:Init(oPanel, .F.)

    oLayer:addLine("CABECALHO", 30, .F.)
    oLayer:AddLine("PAINEL", 70, .F.)
    oLayer:addCollumn("CORPO", 100, .T., "CABECALHO")
    oLayer:addCollumn("CORPO", 100, .T., "PAINEL")
    
    oPanelHeader := oLayer:getColPanel('CORPO','CABECALHO')
    oPanelBody   := oLayer:getColPanel('CORPO','PAINEL')

    TSay():New(15, 20, {|| "<b>"+STR0023+"</b>" }, oPanelHeader, , TFont():New(,,-15,,,), .F., .F., .F., .T., , , 450, 20,,,,,,.T.) //"Instituições autorizadas "
    TSay():New(30, 20, {|| STR0024 }, oPanelHeader, , TFont():New(,,-12,,,), .F., .F., .F., .T., , , 450, 20,,,,,,.T.) //"Informe os CNPJs das instituições que poderão consultar sua agenda de duplicatas escriturais."
    TSay():New(45, 20, {|| STR0025 }, oPanelHeader, , TFont():New(,,-12,,,), .F., .F., .F., .T., , , 450, 20,,,,,,.T.) //"Essas instituições poderão visualizar seus títulos escriturados para análise de crédito ou negociações."
    
    oView := autorizados(oPanelBody,nTipo,jDados,cAlias)
    
Return oView

/*/{Protheus.doc} createFivethStep
    Realiza a criação do quinto step do wizard
    @type  Static Function
    @author Squad Techfin
    @since 01/03/2026
    @version 1.0
    @param oPanel, Object, Painel disponivel para criação do step
    @param jDados, Json, JSON contendo os parametros do serviço de Duplicata Escritural
    @param cAlias, Character, Alias temporário para uso do MVC
    @param oSay01, Object, TSay para exibição do tipo de escrituração selecionada
    @param oSay02, Object, TSay para exibição do bloqueio por erro
    @param oSay03, Object, TSay para exibição do bloqueio para negociação
    @return oView, Object, View contendo os dados para revisão das configurações antes da confirmação
/*/
Static Function createFivethStep(oPanel as object, jDados as Json, cAlias as Character,oSay01 as Object,oSay02 as Object,oSay03 as Object) as Object
    Local oLayer := FWLayer():new() as object
    Local oPanelBody                as object
    Local cTpEscrituracao  := ""    as character
    Local cTpGeracao       := ""    as character
    Local cTpBlqNegociacao := ""    as character
    Local aDescWizard      := {}     as Array
    Local oPanelHeader              as object
    Local oView                     as object

    
    aDescWizard := getDescStep5(jDados)
    cTpEscrituracao  := "<b>" + aDescWizard[1] + "</b>"
    cTpGeracao       := "<b>" + aDescWizard[2] + "</b>"
    cTpBlqNegociacao := "<b>" + aDescWizard[3] + "</b>"
        
    oLayer:Init(oPanel, .F.)

    oLayer:addLine("CABECALHO", 50, .F.)
    oLayer:AddLine("PAINEL", 50, .F.)
    oLayer:addCollumn("CORPO", 100, .T., "CABECALHO")
    oLayer:addCollumn("CORPO", 100, .T., "PAINEL")
    
    oPanelHeader := oLayer:getColPanel('CORPO','CABECALHO')
    oPanelBody   := oLayer:getColPanel('CORPO','PAINEL')

    TSay():New(10, 20, {|| "<b>"+STR0033+"</b>" }, oPanelHeader, , TFont():New(,,-15,,,), .F., .F., .F., .T., , , 450, 20,,,,,,.T.) //"Revisão e confirmação"
    TSay():New(25, 20, {|| STR0034 }, oPanelHeader, , TFont():New(,,-12,,,), .F., .F., .F., .T., , , 450, 20,,,,,,.T.) //"Confira e confirme as configurações informadas."
    
    TSay():New(40, 020, {|| STR0036 }, oPanelHeader, , TFont():New(,,-15,,,), .F., .F., .F., .T., , , 450, 20,,,,,,.T.) //"Forma de escrituração"
    TSay():New(55, 020, {|| STR0037 }, oPanelHeader, , TFont():New(,,-15,,,), .F., .F., .F., .T., , , 450, 20,,,,,,.T.) //"Escriturar por Nota Fiscal em caso de erro: "
    TSay():New(70, 020, {|| STR0038 }, oPanelHeader, , TFont():New(,,-15,,,), .F., .F., .F., .T., , , 450, 20,,,,,,.T.) //"Bloquear títulos para negociação: "
    
    oSay01 := TSay():New(40, 180, {|| cTpEscrituracao }, oPanelHeader, , TFont():New(,,-13,,,), .F., .F., .F., .T., , , 450, 20,,,,,,.T.)
    oSay02 := TSay():New(55, 180, {|| cTpGeracao      }, oPanelHeader, , TFont():New(,,-13,,,), .F., .F., .F., .T., , , 450, 20,,,,,,.T.)
    oSay03 := TSay():New(70, 180, {|| cTpBlqNegociacao}, oPanelHeader, , TFont():New(,,-13,,,), .F., .F., .F., .T., , , 450, 20,,,,,,.T.)
    
    oView := autorizados(oPanelBody,1,jDados,cAlias)
    
Return oView

/*/{Protheus.doc} getDescStep5
    Busca descrições de exibição
    @type  Static Function
    @author Squad Techfin
    @since 16/03/2026
    @version 1.0
    @param jDados, Json, JSON contendo os parametros do serviço de Duplicata Escritural
    @return aRet, Array, Descrição para exibição no step de revisão do wizard
    /*/
Static Function getDescStep5(jDados as Json) as Array
    Local aRet             := {} as Array
    Local cTpEscrituracao  := "" as Character
    Local cTpGeracao       := "" as Character
    Local cTpBlqNegociacao := "" as Character

    If jDados["parametros"]["escrituracaoAutomatica"] 
        cTpEscrituracao  := STR0028 //"Automática"
    Else
        cTpEscrituracao  := STR0029 //"Manual"
    EndIf
    If jDados["parametros"]["permiteNotaFiscal"]
        cTpGeracao       := STR0030 //"Ativado"
    Else
        cTpGeracao       := STR0031 //"Desabilitado"
    EndIf
    If jDados["parametros"]["bloqueiaTitulos"]
        cTpBlqNegociacao := STR0030 //"Ativado "    
    Else 
        cTpBlqNegociacao := STR0031 //"Desabilitado "    
    EndIf

    aAdd(aRet, cTpEscrituracao)
    aAdd(aRet, cTpGeracao)
    aAdd(aRet, cTpBlqNegociacao)

Return aRet
