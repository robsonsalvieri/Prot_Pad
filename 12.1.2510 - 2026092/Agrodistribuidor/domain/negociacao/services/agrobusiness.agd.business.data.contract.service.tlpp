#include "totvs.ch"
#include 'tlpp-core.th'

namespace totvs.protheus.agrobusiness.agd  

/*/{Protheus.doc} BusinessDataContractService
Classe de serviço dos Contratos de Negocio Barter
@type class
@version 12
@author jc.maldonado
@since 03/09/2025
/*/
class BusinessDataContractService from UtilsService
	public method new()
	public method listar() as logical
endclass

/*/{Protheus.doc} BusinessDataContractService::new
Constructor
@type method
@version 12
@author jc.maldonado
@since 03/09/2025
@return object, instancia da classe
/*/
method new() class BusinessDataContractService
	_Super:New()
return Self

/*/{Protheus.doc} BusinessDataContractService::listar
Lista os contratos de negocio barter
@type method
@version 12
@author jc.maldonado
@since 03/09/2025
@param nPage, numeric, numero da pagina
@param nPageSize, numeric, tamanho da pagina
@param jQryParam, json, parametros de consulta
@return logical, always true
/*/
method listar(nPage as numeric, nPageSize as numeric, jQryParam as json) as logical class BusinessDataContractService
	local oDadosContratosRepo as Object
	
	default nPage     := 1
	default nPageSize := 10
	default jQryParam := nil

	oDadosContratosRepo := BusinessDataContractRepository():New()
	oDadosContratosRepo:find(nPage, nPageSize, jQryParam)

	::setFullResponse(oDadosContratosRepo)

	FWFreeObj(oDadosContratosRepo)
return .t.

