#include 'tlpp-core.th'
#include 'totvs.ch'
#include 'agrobusiness.agd.dta.barter.agronomic.recipe.get.tool.ch'

#define MAX_LIST_ITEMS 20

namespace totvs.protheus.agrobusiness.agd  

/*/{Protheus.doc} DTABarterAgronomicRecipeGetTool
Tool do DTA para dados do receituário agronômico com origem no pedido de venda
@type class
@version 12
@author gilson.venturi
@since 10/06/2026
/*/
class DTABarterAgronomicRecipeGetTool
	static method getSetup()            as json
	static method getParameters()       as json
	static method getRules()            as character
	static method getDescription()      as character
	static method getDescriptionShort() as character
	static method getExamples()         as array
	static method getGlossary()         as array
	static method apply()               as array
endclass

/*/{Protheus.doc} getSetup
Retorna as configurações da tool
@type method
@version 12
@author gilson.venturi
@since 10/06/2026
@return json, setup
/*/
method getSetup() as json class DTABarterAgronomicRecipeGetTool
	local oDTAToolsBuilder as object
	local jSetup           as json
	local cName := 'BReceituarioAgronomicoGET' as character

	oDTAToolsBuilder := DTAToolsBuilder():new()

	oDTAToolsBuilder:setName(cName)
	oDTAToolsBuilder:setDescription(DTABarterAgronomicRecipeGetTool():getDescription())
	oDTAToolsBuilder:setShortDescription(DTABarterAgronomicRecipeGetTool():getDescriptionShort())

	jSetup := oDTAToolsBuilder:build()

	FreeObj(oDTAToolsBuilder)
return jSetup

/*/{Protheus.doc} getDescription
Retorna a descrição completa da tool
@type method
@version 12
@author gilson.venturi
@since 10/06/2026
@return character, descrição completa
/*/
method getDescription() as character  class DTABarterAgronomicRecipeGetTool
return STR0001 //"O resumo de dados tem a lista de receitas, código, descrição item e quantidade. O resumo tem as informações do numero pedido de venda, numero da receita ou numero da solicitação da receita."


/*/{Protheus.doc} getDescriptionShort
Retorna a descrição curta da tool
@type method
@version 12
@author gilson.venturi
@since 10/06/2026
@return character, descrição curta
/*/
method getDescriptionShort() as character class DTABarterAgronomicRecipeGetTool
return STR0002 //'Buscar dados de receituário agronômico associados ao pedido de venda.'

/*/{Protheus.doc} getRules
Retorna as regras da tool
@type method
@version 12
@author gilson.venturi
@since 10/06/2026
@return character, regras
/*/
method getRules() as character class DTABarterAgronomicRecipeGetTool
return I18N(STR0003, {'order_code', 'prescription_code', 'request_code'})  //"O argumento '#1[ARG_NAME]#' ou '#2[ARG_NAME]#' ou '#3[ARG_NAME]#' precisam ser informados, solicite a informação antes de realizar a pesquisa."

/*/{Protheus.doc} getParameters
Retorna os parâmetros disponíveis para a tool
@type method
@version 12
@author gilson.venturi
@since 10/06/2026
@return json, parâmetros
/*/
method getParameters() as json class DTABarterAgronomicRecipeGetTool
	local oDTAToolsBuilder as object
	local jDTATool         as json
	local jParameters      as json

	oDTAToolsBuilder := DTAToolsBuilder():new()

	oDTAToolsBuilder:addParameter('order_code', 'string', STR0004, .F.) //'Código Pedido de Venda'
	oDTAToolsBuilder:addParameter('prescription_code', 'string', STR0005, .F.) //'Código Receita'
	oDTAToolsBuilder:addParameter('request_code', 'string', STR0006, .F.) //'Código Solicitação'
	oDTAToolsBuilder:addParameter('customer_code', 'string', STR0025, .F.) //'Código Cliente'

	jDTATool    := oDTAToolsBuilder:build()
	jParameters := jDTATool['parameters']

	FreeObj(oDTAToolsBuilder)
	FreeObj(jDTATool)
return jParameters

/*/{Protheus.doc} getExamples
Retorna exemplos de perguntas para a tool
@type method
@version 12
@author gilson.venturi
@since 10/06/2026
@return array, exemplos
/*/
method getExamples() as array class DTABarterAgronomicRecipeGetTool
	local oDTAToolsBuilder as object
	local jDTATool         as json
	local aExamples        as array

	oDTAToolsBuilder := DTAToolsBuilder():new()

	oDTAToolsBuilder:addExample(I18N(STR0007, {'order_code'}))   //"O pedido de venda '#1[order_code]#' possui receituário gerado ?"	
	oDTAToolsBuilder:addExample(I18N(STR0008, {'prescription_code'})) //"Qual pedido de venda vinculado a receita '#1[prescription_code]#' ?"
	oDTAToolsBuilder:addExample(I18N(STR0009, {'request_code'})) //"Qual o código do pedido de venda vinculado a solicitação '#1[request_code]#' ?"
	oDTAToolsBuilder:addExample(I18N(STR0026, {'customer_code'})) //"Quais receitas foram geradas para o cliente '#1[customer_code]#' no periodo ?"

	jDTATool  := oDTAToolsBuilder:build()
	aExamples := jDTATool['examples']

	FreeObj(oDTAToolsBuilder)
return aExamples

/*/{Protheus.doc} getGlossary
Retorna o glossário das informações utilizadas pela tool
@type method
@version 12
@author gilson.venturi
@since 10/06/2026
@return array, glossário
/*/
method getGlossary() as array class DTABarterAgronomicRecipeGetTool
	local oDTAToolsBuilder as object
	local jDTATool         as json
	local aGlossary        as array

	oDTAToolsBuilder := DTAToolsBuilder():new()

	oDTAToolsBuilder:addGlossary('prescription_code'       , STR0010) //"Código receituário agronômico"
	oDTAToolsBuilder:addGlossary('engineer_code'           , STR0011) //"Código engenheiro agrônomo"
	oDTAToolsBuilder:addGlossary('engineer_name'           , STR0012) //"Nome do engenheiro agrônomo"

	oDTAToolsBuilder:addGlossary('recipe_code'             , STR0013) //"Numero da receita"
	oDTAToolsBuilder:addGlossary('order_code'              , STR0014) //"Código do pedido"
	oDTAToolsBuilder:addGlossary('customer_code'           , STR0015) //"Código do cliente do pedido"
	oDTAToolsBuilder:addGlossary('customer_name'           , STR0016) //"Nome do cliente do pedido"
	oDTAToolsBuilder:addGlossary('issue_date'              , STR0022) //"Data de emissão"
	oDTAToolsBuilder:addGlossary('recipe_status'           , STR0017) //"Status da receita"

	jDTATool  := oDTAToolsBuilder:build()
	aGlossary := jDTATool['glossary']

	FreeObj(oDTAToolsBuilder)
return aGlossary

/*/{Protheus.doc} apply
Método utilizado pelo DTA para obter os dados
@type method
@version 12
@author gilson.venturi
@since 10/06/2026
@param jFilters, json, filtros
@return array, dados retornados
/*/
method apply(jFilters as json) as array class DTABarterAgronomicRecipeGetTool
	local oRepository            as object
	local oJsonReturn            as object
	local aReturn                as array
	local cContext               as character
	local jData                  as json
	local aSuggestions           as array
	local nX                     as numeric

	if  (!jFilters:HasProperty('order_code')        .or. Empty(jFilters['order_code'])) .and.;
		(!jFilters:HasProperty('request_code')      .or. Empty(jFilters['request_code'])) .and.;
		(!jFilters:HasProperty('prescription_code') .or. Empty(jFilters['prescription_code'])) .and.;
		(!jFilters:HasProperty('customer_code')     .or. Empty(jFilters['customer_code']))
		return DTAUtilsService():setToolError(400, I18N(STR0023, {'order_code', 'request_code', 'prescription_code'})) //"Para realizar a busca, o parâmetro '#1[PARAM]#' ou '#2[PARAM]#' ou '#3[PARAM]#' deve ser informado."
	endIf

	oRepository := RecipeRepository():New()
	oJsonReturn  := JsonObject():new()

	if jFilters:HasProperty('order_code') .and. !Empty(jFilters['order_code'])
		oJsonReturn['numeroPedido'] := jFilters['order_code']
	endIf

	if jFilters:HasProperty('request_code') .and. !Empty(jFilters['request_code'])
		oJsonReturn['numeroReceita'] := jFilters['request_code']
	endIf

	if jFilters:HasProperty('prescription_code') .and. !Empty(jFilters['prescription_code'])
		oJsonReturn['idSolicitacao'] := jFilters['prescription_code']
	endIf

	if jFilters:HasProperty('customer_code') .and. !Empty(jFilters['customer_code'])
		oJsonReturn['cliente'] := jFilters['customer_code']
	endIf

	oRepository:find(1, 9999,oJsonReturn)
	aReceituario := oRepository:getResponse()['items']
	FWFreeObj(oRepository)

	jData  := JsonObject():New()
	jData["order_list"] := {}

	For nX:= 1 to Len(aReceituario)
		aadd(jData["order_list"],  {'prescription_code'   : aReceituario[nX]['idReceita'],;
									'engineer_code'       : aReceituario[nX]['engenheiro'],;
									'engineer_name'       : aReceituario[nX]['nomeEngenheiro'],;
									'recipe_code'         : aReceituario[nX]['numeroReceita'],;
									'order_code'          : aReceituario[nX]['numeroPedido'],;
									'customer_code'       : aReceituario[nX]['cliente'],;
									'customer_name'       : aReceituario[nX]['clienteNome'],;
									'issue_date'          : aReceituario[nX]['dataEmissao'],;
									'recipe_status'       : X3Combo( "NE6_STATUS", aReceituario[nX]['status'] );
		})
	Next

	cContext := I18N(STR0024 /*"Receituário vinculado ao pedido de venda #1[order_code]#"*/, {jFilters['order_code']})
                                                                                                                                                                                                 
	aReturn := {.t., {'context': cContext, 'data': jData, 'suggestions': aSuggestions},	200}

return aReturn
