#Include "agrobusiness.agd.dta.barter.business.item.get.tool.ch"
#Include "TLPP-CORE.TH"
#Include "TOTVS.CH"

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} DTABarterBusinessItemGetTool
Tool do DTA para consulta dos itens/insumos das negociacoes Barter.
@type class
@version 12
@author rodrigo.nsoledade
@since 28/05/2026
/*/
Class DTABarterBusinessItemGetTool
	Static Method getSetup() as Json
	Static Method getParameters() as Json
	Static Method getRules() as Character
	Static Method getDescription() as Character
	Static Method getDescriptionShort() as Character
	Static Method getExamples() as Array
	Static Method getGlossary() as Array

	Static Method apply(jFilters as Json) as Array
EndClass

/*/{Protheus.doc} getSetup
Retorna os dados basicos de configuracao da Tool.
@type method
@version 12
@author rodrigo.nsoledade
@since 28/05/2026
@return json, dados de configuracao da tool
/*/
Method getSetup() as Json Class DTABarterBusinessItemGetTool
	Local cName     := ""  as Character
	Local oLoadTool := Nil as Object
	Local jReturn   := Nil as Json

	cName := "BNegocioItensGET"

	oLoadTool := DTAToolsBuilder():New()
	oLoadTool:setName(cName)
	oLoadTool:setDescription(DTABarterBusinessItemGetTool():getDescription())
	oLoadTool:setShortDescription(DTABarterBusinessItemGetTool():getDescriptionShort())

	jReturn := oLoadTool:build()
	FreeObj(oLoadTool)
Return jReturn

/*/{Protheus.doc} getDescription
Retorna a descricao completa da Tool.
@type method
@version 12
@author rodrigo.nsoledade
@since 28/05/2026
@return character, descricao completa da tool
/*/
Method getDescription() as Character Class DTABarterBusinessItemGetTool
Return STR0001 //"Fornece um resumo de informações sobre os itens/insumos de negociações barter. O resumo de dados tem produtos negociados, quantidades, precos, valores totais, paridades, saldo da negociacao e informacoes de entrega."

/*/{Protheus.doc} getDescriptionShort
Retorna a descricao curta da Tool.
@type method
@version 12
@author rodrigo.nsoledade
@since 28/05/2026
@return character, descricao curta da tool
/*/
Method getDescriptionShort() as Character Class DTABarterBusinessItemGetTool
Return STR0002 //"Busca os itens de uma negociacao barter"

/*/{Protheus.doc} getRules
Retorna as regras de uso da Tool.
@type method
@version 12
@author rodrigo.nsoledade
@since 28/05/2026
@return character, regras de uso da tool
/*/
Method getRules() as Character Class DTABarterBusinessItemGetTool
Return STR0003 //"Use esta tool quando a pergunta envolver itens, produtos, insumos, quantidade, valor do item, preco, paridade, saldo, venda perdida ou entrega de uma negociacao barter. Para consultar apenas dados gerais do cabecalho da negociacao, use a tool BNegocioGET. O parametro business deve ser informado para buscar itens de uma negociacao especifica."

/*/{Protheus.doc} getParameters
Retorna os parametros aceitos pela Tool.
@type method
@version 12
@author rodrigo.nsoledade
@since 28/05/2026
@return json, parametros da tool
/*/
Method getParameters() as Json Class DTABarterBusinessItemGetTool
	Local oLoadTool := Nil as Object
	Local jReturn   := Nil as Json

	oLoadTool := DTAToolsBuilder():New()

	oLoadTool:addParameter("business", "string", STR0004 , .T.) //"Codigo da negociacao barter. Exemplo: '000601'."
	oLoadTool:addParameter("version" , "string", STR0005 , .F.) //"Versao da negociacao barter. Exemplo: '001'."
	oLoadTool:addParameter("item"    , "string", STR0006 , .F.) //"Item/insumo da negociacao. Exemplo: '001'."
	oLoadTool:addParameter("customer", "string", STR0007 , .F.) //"Codigo ou nome do cliente vinculado ao item da negociacao."
	oLoadTool:addParameter("product" , "string", STR0008 , .F.) //"Codigo ou descricao do produto/insumo negociado."

	jReturn := oLoadTool:build()
	FreeObj(oLoadTool)
Return jReturn["parameters"]

/*/{Protheus.doc} getExamples
Retorna exemplos de perguntas que podem acionar a Tool.
@type method
@version 12
@author rodrigo.nsoledade
@since 28/05/2026
@return array, exemplos de uso da tool
/*/
Method getExamples() as Array Class DTABarterBusinessItemGetTool
	Local oLoadTool := Nil as Object
	Local jReturn   := Nil as Json

	oLoadTool := DTAToolsBuilder():New()

	oLoadTool:addExample(I18N(STR0009, {"customer"})) //"Quais os itens da negociacao '#1[business]#'?"
	oLoadTool:addExample(I18N(STR0010, {"business"})) //"Qual o valor total dos itens da negociacao '#1[business]#'?"
	oLoadTool:addExample(I18N(STR0011, {"business"})) //"Qual a paridade dos itens da negociacao '#1[business]#'?"
	oLoadTool:addExample(I18N(STR0012, {"business"})) //"Na negociacao '#1[business]#' teve venda perdida?"
	oLoadTool:addExample(I18N(STR0013, {"business"})) //"Qual produto foi lancado como venda perdida na negociacao '#1[business]#'?")
	oLoadTool:addExample(I18N(STR0014, {"business"})) //"Qual o saldo dos itens da negociacao '#1[business]#'?")

	jReturn := oLoadTool:build()
	FreeObj(oLoadTool)
Return jReturn["examples"]

/*/{Protheus.doc} getGlossary
Retorna o glossario dos campos devolvidos pela Tool.
@type method
@version 12
@author rodrigo.nsoledade
@since 28/05/2026
@return array, glossario de campos da tool
/*/
Method getGlossary() as Array Class DTABarterBusinessItemGetTool
	Local oLoadTool := Nil as Object
	Local jReturn   := Nil as Json

	oLoadTool := DTAToolsBuilder():New()

	oLoadTool:addGlossary("business_item_list"      , STR0015) //"Lista de itens/insumos da negociacao barter"
	oLoadTool:addGlossary("business_code"           , STR0016) //"Codigo da negociacao barter"
	oLoadTool:addGlossary("business_version"        , STR0017) //"Versao da negociacao barter"
	oLoadTool:addGlossary("item"                    , STR0018) //"Item/insumo da negociacao barter"
	oLoadTool:addGlossary("customer_code"           , STR0019) //"Codigo do cliente"
	oLoadTool:addGlossary("customer_store"          , STR0020) //"Loja do cliente"
	oLoadTool:addGlossary("customer_name"           , STR0021) //"Nome do cliente"
	oLoadTool:addGlossary("product_code"            , STR0022) //"Codigo do produto/insumo"
	oLoadTool:addGlossary("product_description"     , STR0023) //"Descricao do produto/insumo"
	oLoadTool:addGlossary("measurement_unit"        , STR0024) //"Unidade de medida do produto/insumo"
	oLoadTool:addGlossary("cost_price"              , STR0025) //"Preco de custo do item"
	oLoadTool:addGlossary("sale_price"              , STR0026) //"Preco de venda/tabela do item"
	oLoadTool:addGlossary("final_price"             , STR0027) //"Preco unitario final do item"
	oLoadTool:addGlossary("quantity"                , STR0028) //"Quantidade negociada/vendida do item"
	oLoadTool:addGlossary("freight"                 , STR0029) //"Valor do frete do item"
	oLoadTool:addGlossary("adjustment_percent"      , STR0030) //"Percentual de desconto/acrescimo do item"
	oLoadTool:addGlossary("adjustment_value"        , STR0031) //"Valor de desconto/acrescimo do item"
	oLoadTool:addGlossary("total_value"             , STR0032) //"Valor total do item"
	oLoadTool:addGlossary("warehouse"               , STR0033) //"Codigo do armazem"
	oLoadTool:addGlossary("warehouse_description"   , STR0034) //"Descricao do armazem"
	oLoadTool:addGlossary("fiscal_operation"        , STR0035) //"Codigo da operacao fiscal"
	oLoadTool:addGlossary("fiscal_operation_desc"   , STR0036) //"Descricao da operacao fiscal"
	oLoadTool:addGlossary("tes"                     , STR0037) //"Codigo da TES do item"
	oLoadTool:addGlossary("tes_description"         , STR0038) //"Descricao da TES"
	oLoadTool:addGlossary("delivery_date"           , STR0039) //"Data de entrega do item"
	oLoadTool:addGlossary("lot"                     , STR0040) //"Lote do item"
	oLoadTool:addGlossary("parity"                  , STR0041) //"Paridade do item"
	oLoadTool:addGlossary("lost_sale_quantity"      , STR0042) //"Quantidade de venda perdida do item"
	oLoadTool:addGlossary("boarding_instruction_qty", STR0043) //"Quantidade vinculada em instrucao de embarque"
	oLoadTool:addGlossary("business_balance"        , STR0044) //"Saldo restante do item na negociacao"

	jReturn := oLoadTool:build()
	FreeObj(oLoadTool)
Return jReturn["glossary"]

/*/{Protheus.doc} apply
Executa a consulta de itens/insumos da negociacao barter e formata o retorno para o DTA.
@type method
@version 12
@author rodrigo.nsoledade
@since 28/05/2026
@param jFilters, json, filtros informados pelo DTA
@return array, retorno padrao da execucao da tool
/*/
Method apply(jFilters as Json) as Array Class DTABarterBusinessItemGetTool
	Local aReturn       := {}  as Array
	Local aSuggestions  := {}  as Array
	Local cContext      := ""  as Character
	Local cFilter       := ""  as Character
	Local cProduct      := ""  as Character
	Local jQryParam     := Nil as Json
	Local jData         := Nil as Json
	Local jDataLine     := Nil as Json
	Local oRepository   := Nil as Object
	Local aBusinessItem := {}  as Array
	Local aCustomers    := {}  as Array
	Local nX            := 0   as Numeric

	If !jFilters:HasProperty("business") .Or. Empty(AllTrim(jFilters["business"]))
		Return DTAUtilsService():setToolError(400, STR0045) //"Informe o codigo da negociacao para consultar os itens."
	EndIf

	If jFilters:HasProperty("customer") .And. !Empty(AllTrim(jFilters["customer"]))
		aCustomers := DTAUtilsService():getCodCliente(Upper(AllTrim(jFilters["customer"])))

		If Len(aCustomers) == 0
			Return DTAUtilsService():setToolError(400, I18N(STR0046, {RTrim(jFilters["customer"]) }))  //"O cliente #1[customer]# não foi encontrado na base de dados."
		EndIf

		If Len(aCustomers) > 1
			Return DTAUtilsService():setToolError(400, I18N(STR0047, {RTrim(jFilters["customer"]) }))  //"O cliente #1[customer]# está genérico. Informe um código ou nome mais específico."
		EndIf
	EndIf

	cFilter := "codigo eq '" + AllTrim(jFilters["business"]) + "'"

	If jFilters:HasProperty("version") .And. !Empty(AllTrim(jFilters["version"]))
		cFilter += " and versao eq '" + AllTrim(jFilters["version"]) + "'"
	EndIf

	If jFilters:HasProperty("item") .And. !Empty(AllTrim(jFilters["item"]))
		cFilter += " and item eq '" + AllTrim(jFilters["item"]) + "'"
	EndIf

	If Len(aCustomers) == 1
		cFilter += " and codigoCliente eq '" + AllTrim(aCustomers[1]) + "'"
	EndIf

	If jFilters:HasProperty("product") .And. !Empty(AllTrim(jFilters["product"]))
		cProduct := Upper(AllTrim(jFilters["product"]))
		cFilter += " and (codigoProduto eq '" + cProduct + "' or descricaoProduto like '%" + cProduct + "%')"
	EndIf

	jQryParam := JsonObject():New()
	jQryParam["filter"] := cFilter

	oRepository := BusinessItemRepository():New()
	oRepository:find(1, 50, jQryParam)

	jData := JsonObject():New()
	jData["business_item_list"] := {}
	aBusinessItem := oRepository:getResponse()["items"]

	For nX := 1 To Len(aBusinessItem)
		jDataLine := JsonObject():New()
		jDataLine := {"business_code"           : aBusinessItem[nX]["codigo"],;
			          "business_version"        : aBusinessItem[nX]["versao"],;
			          "item"                    : aBusinessItem[nX]["item"],;
			          "customer_code"           : aBusinessItem[nX]["codigoCliente"],;
			          "customer_store"          : aBusinessItem[nX]["loja"],;
			          "customer_name"           : aBusinessItem[nX]["nomeCliente"],;
			          "product_code"            : aBusinessItem[nX]["codigoProduto"],;
			          "product_description"     : aBusinessItem[nX]["descricaoProduto"],;
			          "unit"                    : aBusinessItem[nX]["unidadeMedida"],;
			          "cost_price"              : aBusinessItem[nX]["precoCusto"],;
			          "sale_price"              : aBusinessItem[nX]["precoVenda"],;
			          "quantity"                : aBusinessItem[nX]["quantidade"],;
			          "freight"                 : aBusinessItem[nX]["frete"],;
			          "adjustment_percent"      : aBusinessItem[nX]["percentualAjuste"],;
			          "adjustment_value"        : aBusinessItem[nX]["valorAjuste"],;
			          "final_price"             : aBusinessItem[nX]["precoFinal"],;
			          "total_value"             : aBusinessItem[nX]["valorTotal"],;
			          "warehouse"               : aBusinessItem[nX]["armazem"],;
			          "warehouse_description"   : aBusinessItem[nX]["descricaoArmazem"],;
			          "fiscal_operation"        : aBusinessItem[nX]["operacaoFiscal"],;
			          "fiscal_operation_desc"   : aBusinessItem[nX]["descricaoOperacaoFiscal"],;
			          "tes"                     : aBusinessItem[nX]["codigoTes"],;
			          "tes_description"         : aBusinessItem[nX]["descricaoTes"],;
			          "delivery_date"           : aBusinessItem[nX]["dataEntrega"],;
			          "lot"                     : aBusinessItem[nX]["lote"],;
			          "parity"                  : aBusinessItem[nX]["paridade"],;
			          "lost_sale_quantity"      : aBusinessItem[nX]["qtdVendaPerdida"],;
			          "boarding_instruction_qty": aBusinessItem[nX]["qtdInstrucaoEmbarque"],;
			          "business_balance"        : aBusinessItem[nX]["saldoNeg"]}

		AAdd(jData["business_item_list"], jDataLine)
	Next nX

	If Len(aBusinessItem) > 0
		AAdd(aSuggestions, {"label": STR0048}) //"Qual o valor total dos itens dessa negociacao?"
		AAdd(aSuggestions, {"label": STR0049}) //"Teve venda perdida nessa negociacao?"
		AAdd(aSuggestions, {"label": STR0050}) //"Qual a paridade dos itens dessa negociacao?"

		cContext := STR0051 //"Os dados contidos em 'business_item_list' representam a lista de itens/insumos da negociacao barter informada, incluindo produto, quantidade, valor total, paridade, venda perdida, instrucao de embarque e saldo."
		aReturn := {.T., {"context": cContext, "data": jData, "suggestions": aSuggestions}, 200}
	Else
		aReturn := DTAUtilsService():setToolError(400, I18N(STR0052, {AllTrim(jFilters["business"])})) //"Nenhum item de negociacao barter foi encontrado para a negociacao '#1[business]#'. Verifique se o código da negociação está correto ou se os itens da negociação atendem aos filtros informados."
	EndIf

	FreeObj(oRepository)
	FreeObj(jQryParam)
	jData        := Nil
	aSuggestions := Nil
Return aReturn
