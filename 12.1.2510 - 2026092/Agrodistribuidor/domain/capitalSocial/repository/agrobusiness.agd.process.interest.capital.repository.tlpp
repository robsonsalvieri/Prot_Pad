#include 'totvs.ch'
#include 'tlpp-core.th'


namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} ProcessInterestCapitalRepository
Repositorio de Tipo de Movimento de Quota
@type class
@version 12
@author carlos.augusto
@since 11/05/2026
/*/
class ProcessInterestCapitalRepository from UtilsRepository
	public Data cChaveIDRepository As Object //chave unica para updates

	public method new()
	public method getParametrosCalculo() as json
	public method getQueryMovimentos() as character
	public method hasProcessoAnoReferencia(cAnoReferencia as character) as logical
	public method hasFinancialTitles(cFilCalc as character, cCodProcesso as character) as logical
	public method isCalculado() as logical
	public method isPendenteAprovacao() as logical
	public method isPermitidoAlterar() as logical
	public method isPendenteConclusao() as logical
	public method removerMovimentosCalculo()

	private method getFields() as array
endclass

/*/{Protheus.doc} new
Construtor
@type method
@version 12
@author carlos.augusto
@since 11/05/2026
@return object, self
/*/
method new(cCodigoTipo as character) class ProcessInterestCapitalRepository
	Self:cChaveIDRepository := cCodigoTipo
	_Super:New('NF7', Self:getFields())
return self


/*/{Protheus.doc} getParametrosCalculo
Obtém o filtro pelo ID
@type method
@version 12
@author jean.schulze
@since 7/8/2026
@param cCodigo, character, codigo do tipo de movimento
@return array, filtro pelo ID
/*/
Method getParametrosCalculo() as Json Class ProcessInterestCapitalRepository
	Local aParametros := {}

	dbselectArea("NF7")
	if NF7->(dbSeek(Self:cChaveIDRepository))

		aParametros :={;
			'filial'            : NF7->NF7_FILIAL,;
			'dataCorteCalculo'  : STOD(NF7->NF7_ANOREF+"1231"),/*Sempre ultimo dia do ano*/;
			'simulacao'         : IIF(NF7->NF7_SIMULA == "1", .T., .F.),;
			'geraDemitidos'     : IIF(NF7->NF7_GERDEM == "1", .T., .F.),;
			'dataCorteDemitido' : NF7->NF7_DTDEMI,;
			'tipoMovimento'     : NF7->NF7_TIPMOV,;
			'juros'             : NF7->NF7_JURANO;
			}

	endif
return aParametros

/*/{Protheus.doc} isPermitidoAlterar
Verifica se o registro pode ser alterado.
Permite somente quando o Status for Pendente de Aprovacao (3) ou Erro (4).
@type method
@version 12
@author felipe.savelar
@since 27/07/2026
@return logical, .T. se permitido, .F. caso contrario
/*/
Method isPermitidoAlterar() as logical Class ProcessInterestCapitalRepository
	Local lPermitido as logical

	dbselectArea("NF7")
	if NF7->(dbSeek(Self:cChaveIDRepository))
		lPermitido := (NF7->NF7_STATUS $ "1|3|4") //1=Pendente | 3=Pend. Aprovacao | 4=Erro
	endif
return lPermitido

/*/{Protheus.doc} isCalculado
Verifica se o cálculo já foi realizado
@type method
@version 12
@author jean.schulze
@since 7/15/2026
@return logical, calculado ou não
/*/
Method isCalculado() as logical Class ProcessInterestCapitalRepository
	Local lCalculado as logical

	dbselectArea("NF7")
	if NF7->(dbSeek(Self:cChaveIDRepository))
		lCalculado := !(NF7->NF7_STATUS $ "1|4|5|7") //1=Pendente;;4=Erro;5=Erro Aprovacao;7=Reprovado
	endif
return lCalculado

/*/{Protheus.doc} isPendenteAprovacao
Verifica se o cálculo está pendente de aprovação
@type method
@version 12
@author jean.schulze
@since 7/15/2026
@return logical, pendente de aprovação ou não
/*/
Method isPendenteAprovacao() as logical Class ProcessInterestCapitalRepository
	Local lPendente as logical

	dbselectArea("NF7")
	if NF7->(dbSeek(Self:cChaveIDRepository))
		lPendente := (NF7->NF7_STATUS == "3") //3=Pendente Aprovacao
	endif
return lPendente

/*/{Protheus.doc} isPendenteConclusao
Verifica se o cálculo está pendente de conclusão
@type method
@version 12
@author jean.schulze
@since 7/15/2026
@return logical, pendente de conclusão ou não
/*/
Method isPendenteConclusao() as logical Class ProcessInterestCapitalRepository
	Local lPendente as logical

	dbselectArea("NF7")
	if NF7->(dbSeek(Self:cChaveIDRepository))
		lPendente := (NF7->NF7_STATUS $ "3|8") //3=Pendente Aprovacao | 8=Aprovado
	endif
return lPendente

/*/{Protheus.doc} removerMovimentosCalculo
Remove os movimentos de cálculo
@type method
@version 12
@author jean.schulze
@since 7/17/2026
/*/
Method removerMovimentosCalculo() Class ProcessInterestCapitalRepository

	dbselectArea("NF4")
	NF4->(dbSetOrder(2)) //NF4_FILIAL+NF4_CODJUR
	if NF4->(dbSeek(Self:cChaveIDRepository))

		while NF4_FILIAL+NF4_CODJUR == Self:cChaveIDRepository .and. NF4->(! EOF())
			RecLock('NF4',.f.)
			NF4->(dbdelete())
			NF4->(MsUnLock())
			NF4->(dbSkip())
		enddo

	endif
return nil

/*/{Protheus.doc} getQueryMovimentos
Retorna a query de movimentos de cálculo de juros de capital
@type method
@version 12
@author jean.schulze
@since 7/22/2026
@param cFilCalc, character, filial
@param cCodProcesso, character, código do processo
@return character, query de movimentos de cálculo de juros de capital
/*/
Method getQueryMovimentos(cFilCalc as character, cCodProcesso as character) as Character Class ProcessInterestCapitalRepository
	Local cQuery  as character

	cQuery := " SELECT NF4_FILIAL, NF4_CODCOO, NF4_LOJCOO, NF4_VLRCAP, NF4_VALIMP, NF4_IDMOV, NF4_TIPMOV"
	cQuery += " FROM " + RetSqlName("NF4") + " NF4 "
	cQuery += " WHERE NF4.NF4_FILIAL = ? "
	cQuery += "   AND NF4.NF4_CODJUR = ? "
	cQuery += "   AND NF4.D_E_L_E_T_ = ' ' "

	cQuery 	 := ChangeQuery(cQuery)
	oFwPrepS := FWPreparedStatement():New()
	oFwPrepS:SetQuery(cQuery)
	oFwPrepS:SetString(1, cFilCalc)
	oFwPrepS:SetString(2, cCodProcesso)

return oFwPrepS:GetFixQuery()

/*/{Protheus.doc} hasProcessoANoReferencia
Verifica se existe outro processo para o mesmo ano de referencia
com status diferente de Reprovado.
@type method
@version 12
@author jean.schulze
@since 18/08/2026
@param cAnoReferencia, character, ano de referencia do processo
@return logical, .T. quando encontrar outro processo ativo para o ano
/*/
Method hasProcessoAnoReferencia(cAnoReferencia as character, cCodigoProcesso as character) as logical Class ProcessInterestCapitalRepository
	Local lHasProcesso    as logical
	Local cQuery          as character
	Local cAliasQry       as character
	Local oFwPrepS        as object

	Default cAnoReferencia := ""
	Default cCodigoProcesso := ""

	cQuery := " SELECT COUNT(*) AS QTD "
	cQuery += " FROM " + RetSqlName("NF7") + " NF7 "
	cQuery += " WHERE NF7_FILIAL = ? "
	cQuery += "   AND NF7_ANOREF = ? "
	cQuery += "   AND NF7_STATUS <> '7' AND NF7_STATUS <> '6' "
	cQuery += "   AND NF7.D_E_L_E_T_ = ' ' "

	If !Empty(cCodigoProcesso)
		cQuery += "   AND NF7_CODIGO <> ? "
	EndIf

	cQuery  := ChangeQuery(cQuery)
	oFwPrepS := FWPreparedStatement():New()
	oFwPrepS:SetQuery(cQuery)
	oFwPrepS:SetString(1, xFilial("NF7"))
	oFwPrepS:SetString(2, cAnoReferencia)

	If !Empty(cCodigoProcesso)
		oFwPrepS:SetString(3, cCodigoProcesso)
	EndIf

	cAliasQry := MpSysOpenQuery(oFwPrepS:GetFixQuery())
	If (cAliasQry)->(!Eof())
		lHasProcesso := (cAliasQry)->QTD > 0
	EndIf
	(cAliasQry)->(DbCloseArea())

return lHasProcesso

/*/{Protheus.doc} ProcessInterestCapitalRepository::hasFinancialTitles
Verifica se tem titulos gerados para os cooperados do processo de calculo de juros
@type method
@version P12
@author claudineia.reinert
@since 25/08/2026
@param cFilCalc, character, Filial do processo de calculo
@param cCodProcesso, character, codigo do processo de calculo de juros
@return logical, .T. quando existirem titulos para os cooperados do processo
/*/
Method hasFinancialTitles(cFilCalc as character, cCodProcesso as character) as logical Class ProcessInterestCapitalRepository
	Local lHasTitles    := .F.
	Local cQuery          as character
	Local cAliasQry       as character
	Local oFwPrepS        as object

	Default cFilCalc := ""
	Default cCodProcesso := ""

	cQuery := " SELECT NF4.NF4_IDMOV "
	cQuery += " FROM " + RetSqlName("NF4") + " NF4 "
	cQuery += " INNER JOIN " + RetSqlName("NF6") + " NF6 ON "
	cQuery += " 	NF6.NF6_FILIAL = NF4.NF4_FILIAL "
	cQuery += " 	AND NF6.D_E_L_E_T_ = '' "
	cQuery += " 	AND NF6.NF6_IDMOV = NF4.NF4_IDMOV "
	cQuery += " 	AND NF6.NF6_CODCOO = NF4.NF4_CODCOO "
	cQuery += " 	AND NF6.NF6_LOJCOO = NF4.NF4_LOJCOO "
	cQuery += " WHERE NF4.NF4_FILIAL = ? "
	cQuery += " 	AND NF4.D_E_L_E_T_ = '' "
	cQuery += " 	AND NF4.NF4_CODJUR = ? "
	cQuery += " GROUP BY NF4.NF4_IDMOV "

	cQuery  := ChangeQuery(cQuery)
	oFwPrepS := FWPreparedStatement():New()
	oFwPrepS:SetQuery(cQuery)
	oFwPrepS:SetString(1, cFilCalc)
	oFwPrepS:SetString(2, cCodProcesso)

	cAliasQry := MpSysOpenQuery(oFwPrepS:GetFixQuery())
	If (cAliasQry)->(!Eof())
		lHasTitles := .T.
	EndIf
	(cAliasQry)->(DbCloseArea())

return lHasTitles

/*/{Protheus.doc} getFields
Obtém os campos do repositório
@type method
@version 12
@author jc.maldonado
@since 15/01/2026
@return array, {{cCampoJson, cCampoProtheus, cTipoCampo, lMostraCampoConsulta}, ...}
/*/
method getFields() as array class ProcessInterestCapitalRepository
	local aFields as array

	aFields := {;
		{'filial'      , 'NF7_FILIAL' , 'C', .F.},;
		{'codigo'      , 'NF7_CODIGO' , 'C', .T.},;
		}
return aFields
