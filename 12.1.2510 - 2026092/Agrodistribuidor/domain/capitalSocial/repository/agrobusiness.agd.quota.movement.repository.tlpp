#INCLUDE "totvs.ch"
#INCLUDE "tlpp-core.th"


namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} QuotaMovementRepository
Repositório de Movimentações de Quotas - NF4
@type class
@version 12
@author rodrigo.nsoledade
@since 09/05/2025
/*/
class QuotaMovementRepository FROM UtilsRepository
	public Data cChaveIDRepository As Object //chave unica para updates

	public method New()
	public Method getFilterById()    as Array
	public Method save() 
	public method getNewCode()
	public method findIncomeStatementData(cFilialDe,cFilialAte,cCoopDe,cCoopAte,cAnoRef) as Array

	private method getFields() as Array
	private method buildIncomeStatementQuery(cFilialDe,cFilialAte,cCoopDe,cCoopAte,cAnoRef,cMatricDe,cMatricAte) as Character


endclass

/*/{Protheus.doc} New
Constructor
@type method
@version 12
@author jean.schulze
@since 15/05/2025
@return variant, this
/*/
method New(pcChaveIDRepository as character) class QuotaMovementRepository
	Self:cChaveIDRepository := pcChaveIDRepository
	_Super:New('NF4', Self:getFields(), nil, nil, 'AGDA140')
return Self


/*/{Protheus.doc} getFields
Retorna a Lista de Campos do Repositorio
@type method
@version 12
@author rodrigo.nsoledade
@since 09/05/2025
@return array, lista de campos
/*/
method getFields() class QuotaMovementRepository
	Local aFields := {}


	AAdd(aFields, {"filial"        	    , "NF4_FILIAL" , "C", .T.})
	AAdd(aFields, {"codigoCooperado"    , "NF4_CODCOO" , "C", .T.})
	AAdd(aFields, {"lojaCooperado"    	, "NF4_LOJCOO" , "C", .T.})
	AAdd(aFields, {"idMovimento"    	, "NF4_IDMOV"  , "C", .T.})
	AAdd(aFields, {"dataMovimento"    	, "NF4_DTMOV " , "D", .T.})
	AAdd(aFields, {"horaMovimento"      , "NF4_HRMOV " , "C", .T.})
	AAdd(aFields, {"tipoMovimento"    	, "NF4_OPTMOV" , "C", .T.})
	AAdd(aFields, {"codigoMovimento"   	, "NF4_TIPMOV" , "C", .T.})
	AAdd(aFields, {"qtdCotas"    		, "NF4_QTDCOT" , "N", .T.})
	AAdd(aFields, {"valorCotas"    		, "NF4_VLRCOT" , "N", .T.})
	AAdd(aFields, {"valorCapital"    	, "NF4_VLRCAP" , "N", .T.})
	AAdd(aFields, {"observacao"    		, "NF4_OBS   " , "C", .F.})


Return aFields

/*/{Protheus.doc} getFilterById
Obtem Filtro para Get By ID
@type method
@version 12
@author lindembergson.pacheco
@since 08/09/2025
@param cCodigo, character, codigo instrucao de embarque
@return array, lista de filtro
/*/
Method getFilterById(cFilMovimento, cCodCooperado, cLojaCooperado, cIdMovimento) as Array Class QuotaMovementRepository
	Local aFilterId := {}

	AAdd(aFilterId, {'NF4_FILIAL', cFilMovimento})
	AAdd(aFilterId, {'NF4_CODCOO', cCodCooperado})
	AAdd(aFilterId, {'NF4_LOJCOO', cLojaCooperado})
	AAdd(aFilterId, {'NF4_IDMOV', cIdMovimento})

return aFilterId



/*/{Protheus.doc} save
Insere registro através do modelo, gerando o NF4_IDMOV antes do insert
@type method
@version 12
@author lindembergson.pacheco
@since 22/06/2026
@param aFieldValue, array, {{'cField', 'xValue'}, ...}
/*/
method save(aFieldValue as array) class QuotaMovementRepository
	::buildModelInsert(aFieldValue)
return


/*/{Protheus.doc} getNewCode
Retorna o proximo código (NF4_CODCOO, NF4_LOJCOO) disponível
@type method
@version 12
@author lindembergson.pacheco
@since 22/06/2026
@return character, cNewCode
/*/
method getNewCode(cCodigo, cLoja)  class QuotaMovementRepository
	local cQuery           as character
	local aBindParam := {} as array
	local cDefaultCode     as character
	local cNewCode         as character

	cDefaultCode  := Space(FWSX3Util():GetFieldStruct('NF4_IDMOV')[3 /*nSize*/])

	cQuery := " SELECT"
	cQuery += "	 COALESCE(MAX(NF4_IDMOV), ?) NF4_IDMOV" ; aAdd(aBindParam, cDefaultCode)
	cQuery += " FROM "
	cQuery += retSQLname("NF4")
	cQuery += " WHERE"
	cQuery += "	 NF4_FILIAL = ?" ; aAdd(aBindParam, FWXFilial("NF4"))
	cQuery += "	 AND NF4_CODCOO = ?" ; aAdd(aBindParam, cCodigo)
	cQuery += "	 AND NF4_LOJCOO = ?" ; aAdd(aBindParam, cLoja)
	cQuery += "	 AND D_E_L_E_T_ = ' '"
	cQuery := ChangeQuery(cQuery)

	cNewCode      := Soma1(MPSysExecScalar(cQuery, 'NF4_IDMOV', aBindParam))

return cNewCode

/*/{Protheus.doc} findIncomeStatementData
Retorna os dados das movimentações de Capital Social utilizados na geração
dos Informes de Rendimentos dos cooperados.
@type method
@version 12
@author rodrigo.nsoledade
@since 14/08/2026
@param cFilialDe, character, filial inicial
@param cFilialAte, character, filial final
@param cCoopDe, character, cooperado inicial
@param cCoopAte, character, cooperado final
@param cAnoRef, character, ano-calendário de referência
@return array, dados agrupados por filial, cooperado e loja
/*/
method findIncomeStatementData(cFilialDe,cFilialAte,cCoopDe,cCoopAte,cAnoRef,cMatricDe,cMatricAte) as Array class QuotaMovementRepository
	Local aArea     := FWGetArea()
	Local aItems    := {}
	Local cAliasQry := GetNextAlias()
	Local cQuery    := ""
	Local jItem     As Object

	cQuery := Self:buildIncomeStatementQuery(cFilialDe,cFilialAte,cCoopDe,cCoopAte,cAnoRef,cMatricDe,cMatricAte)

	MPSysOpenQuery(cQuery,cAliasQry)

	While !(cAliasQry)->(Eof())
		jItem := JsonObject():New()
		jItem["filial"]          := (cAliasQry)->NF4_FILIAL
		jItem["codigoCooperado"] := (cAliasQry)->NF4_CODCOO
		jItem["lojaCooperado"]   := (cAliasQry)->NF4_LOJCOO
		jItem["cpfBeneficiario"] := (cAliasQry)->CPFBEN
		jItem["nomeBeneficiario"]:= (cAliasQry)->NOMEBEN
		jItem["valorAno"]        := (cAliasQry)->VLR_ANO
		jItem["valorAcumulado"]  := (cAliasQry)->VLR_ACUM

		AAdd(aItems,jItem)
		(cAliasQry)->(DbSkip())
	EndDo

	(cAliasQry)->(DbCloseArea())
	FWRestArea(aArea)
Return aItems

/*/{Protheus.doc} buildIncomeStatementQuery
Monta a consulta das movimentações de Capital Social utilizadas
na geração dos Informes de Rendimentos.
@type method
@version 12
@author rodrigo.nsoledade
@since 14/08/2026
@param cFilialDe, character, filial inicial
@param cFilialAte, character, filial final
@param cCoopDe, character, cooperado inicial
@param cCoopAte, character, cooperado final
@param cAnoRef, character, ano-calendário de referência
@return character, consulta SQL preparada
/*/
method buildIncomeStatementQuery(cFilialDe,cFilialAte,cCoopDe,cCoopAte,cAnoRef,cMatricDe,cMatricAte) as Character class QuotaMovementRepository
	Local cQuery     := ""
	Local cDataIni   := cAnoRef + "0101"
	Local cDataFim   := cAnoRef + "1231"
	Local oStatement := FWPreparedStatement():New()

	cQuery += " SELECT NF4.NF4_FILIAL,"
	cQuery += " NF4.NF4_CODCOO,"
	cQuery += " NF4.NF4_LOJCOO,"
	cQuery += " SA1.A1_CGC AS CPFBEN,"
	cQuery += " SA1.A1_NOME AS NOMEBEN,"

	cQuery += " SUM(CASE"
	cQuery += " WHEN NF5.NF5_OPEXEC = '2' THEN NF4.NF4_VLRCAP"
	cQuery += " WHEN NF5.NF5_OPEXEC = '3' THEN -NF4.NF4_VLRCAP"
	cQuery += " ELSE 0"
	cQuery += " END) AS VLR_ANO,"

	cQuery += " (SELECT COALESCE(SUM(CASE"
	cQuery += " WHEN NF5TOT.NF5_OPEXEC = '2' THEN NF4TOT.NF4_VLRCAP"
	cQuery += " WHEN NF5TOT.NF5_OPEXEC = '3' THEN -NF4TOT.NF4_VLRCAP"
	cQuery += " ELSE 0"
	cQuery += " END),0)"
	cQuery += " FROM " + RetSqlName("NF4") + " NF4TOT"
	cQuery += " INNER JOIN " + RetSqlName("NF5") + " NF5TOT"
	cQuery += " ON NF5TOT.NF5_CODIGO = NF4TOT.NF4_TIPMOV"
	cQuery += " AND NF5TOT.NF5_FILIAL = ?"
	cQuery += " AND NF5TOT.D_E_L_E_T_ = ' '"
	cQuery += " WHERE NF4TOT.NF4_FILIAL = NF4.NF4_FILIAL"
	cQuery += " AND NF4TOT.NF4_CODCOO = NF4.NF4_CODCOO"
	cQuery += " AND NF4TOT.NF4_LOJCOO = NF4.NF4_LOJCOO"
	cQuery += " AND NF4TOT.NF4_STATUS = '1'"
	cQuery += " AND NF4TOT.NF4_DTMOV <=  ? "
	cQuery += " AND NF4TOT.D_E_L_E_T_ = ' ') AS VLR_ACUM"

	cQuery += " FROM " + RetSqlName("NF4") + " NF4"

	cQuery += " INNER JOIN " + RetSqlName("NF5") + " NF5"
	cQuery += " ON NF5.NF5_CODIGO = NF4.NF4_TIPMOV"
	cQuery += " AND NF5.NF5_FILIAL = ?"
	cQuery += " AND NF5.D_E_L_E_T_ = ' '"

	cQuery += " INNER JOIN " + RetSqlName("SA1") + " SA1"
	cQuery += " ON SA1.A1_COD = NF4.NF4_CODCOO"
	cQuery += " AND SA1.A1_LOJA = NF4.NF4_LOJCOO"
	cQuery += " AND " + RetSqlCond("SA1")

	cQuery += " INNER JOIN " + RetSqlName("NEP") + " NEP"
	cQuery += " ON NEP.NEP_CODCLI = NF4.NF4_CODCOO"
	cQuery += " AND NEP.NEP_LOJCLI = NF4.NF4_LOJCOO"
	cQuery += " AND " + RetSqlCond("NEP")
	cQuery += " AND NEP.NEP_COOPER = '1' AND NEP.NEP_MATRIC <> '' "

	cQuery += " WHERE NF4.D_E_L_E_T_ = ' '"
	cQuery += " AND NF4.NF4_FILIAL BETWEEN ? AND ?"
	cQuery += " AND NF4.NF4_CODCOO BETWEEN ? AND ?"
	cQuery += " AND NF4.NF4_DTMOV BETWEEN ? AND ?"
	cQuery += " AND NF4.NF4_STATUS = '1'"
	cQuery += " AND NEP.NEP_MATRIC BETWEEN ? AND ?"

	cQuery += " GROUP BY"
	cQuery += " NF4.NF4_FILIAL,"
	cQuery += " NF4.NF4_CODCOO,"
	cQuery += " NF4.NF4_LOJCOO,"
	cQuery += " SA1.A1_CGC,"
	cQuery += " SA1.A1_NOME"

	cQuery := ChangeQuery(cQuery)

	oStatement:SetQuery(cQuery)
	oStatement:SetString(1,FWxFilial("NF5"))
	oStatement:SetString(2,cDataFim)
	oStatement:SetString(3,FWxFilial("NF5"))
	oStatement:SetString(4,FWxFilial("NF4",cFilialDe))
	oStatement:SetString(5,FWxFilial("NF4",cFilialAte))
	oStatement:SetString(6,cCoopDe)
	oStatement:SetString(7,cCoopAte)
	oStatement:SetString(8,cDataIni)
	oStatement:SetString(9,cDataFim)
	oStatement:SetString(10,cMatricDe)
	oStatement:SetString(11,cMatricAte)

	cQuery := oStatement:GetFixQuery()

	FWFreeObj(oStatement)
Return cQuery
