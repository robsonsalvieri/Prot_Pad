#Include "totvs.ch"
#Include "tlpp-core.th"
#include 'agrobusiness.agd.quota.income.statement.service.ch'

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} QuotaIncomeStatementService
Serviço responsável pela geração dos históricos de Informe de Rendimentos
sobre Capital Social.
@type class
@version 12
@author rodrigo.nsoledade
@since 14/08/2026
/*/
Class QuotaIncomeStatementService From UtilsService

	Public Method New()
	Public Method hasHistory(cFilialDe,cFilialAte,cCoopDe,cCoopAte,cAnoRef,cMatricDe,cMatricAte) As Logical
	Public Method generate(cFilialDe,cFilialAte,cCoopDe,cCoopAte,cAnoRef,cRespCTB,cMatricDe,cMatricAte,cFilPgdora,lReprocess)

	Private Method buildIncomeStatementFields(jMovement,cAnoRef,cRespCTB) As Array

EndClass

/*/{Protheus.doc} New
Construtor do service de Informe de Rendimentos.
@type method
@version 12
@author rodrigo.nsoledade
@since 14/08/2026
@return object, instância da classe
/*/
Method New() Class QuotaIncomeStatementService
	_Super:New()
Return Self

/*/{Protheus.doc} hasHistory
Verifica se já existe histórico gerado para os filtros informados.
@type method
@version 12
@author rodrigo.nsoledade
@since 14/08/2026
@return logical, indica existência de histórico
/*/
Method hasHistory(cFilialDe,cFilialAte,cCoopDe,cCoopAte,cAnoRef,cMatricDe,cMatricAte) As Logical Class QuotaIncomeStatementService
	Local lExists     := .F.
	Local oRepository := QuotaIncomeStatementRepository():New()

	lExists := oRepository:hasHistory(cFilialDe,cFilialAte,cCoopDe,cCoopAte,cAnoRef,cMatricDe,cMatricAte)

	FWFreeObj(oRepository)
Return lExists

/*/{Protheus.doc} generate
Gera os históricos de Informe de Rendimentos utilizando as movimentações
da NF4 e persistindo os resultados na NF0.
@type method
@version 12
@author rodrigo.nsoledade
@since 14/08/2026
@param cFilialDe, character, filial inicial
@param cFilialAte, character, filial final
@param cCoopDe, character, cooperado inicial
@param cCoopAte, character, cooperado final
@param cAnoRef, character, ano-calendário
@param cRespCTB, character, código do contabilista responsável
@param lReprocess, logical, indica reprocessamento
/*/
Method generate(cFilialDe,cFilialAte,cCoopDe,cCoopAte,cAnoRef,cRespCTB,cMatricDe,cMatricAte,cFilPgdora,lReprocess) Class QuotaIncomeStatementService
	Local aFields         := {}
	Local aMovements      := {}
	Local jMovement       As Object
	Local lProcess        := .T.
	Local nIndex          := 0
	Local oIncomeRepo     := QuotaIncomeStatementRepository():New()
	Local oMovementRepo   := QuotaMovementRepository():New()

	Default lReprocess := .F.

	If Empty(cFilPgdora) .Or. Empty(cRespCTB) .Or. Empty(cAnoRef)
		Self:setError(STR0002,404) //"Parâmetro obrigatório não informado."
		FWFreeObj(oIncomeRepo)
		FWFreeObj(oMovementRepo)
		Return Nil
	EndIf

	aMovements := oMovementRepo:findIncomeStatementData(cFilialDe,cFilialAte,cCoopDe,cCoopAte,cAnoRef,cMatricDe,cMatricAte)//Metodo que retorna os dados das movimentações de Capital Social

	If Empty(aMovements)
		Self:setError(STR0001,404) //"Nenhum registro foi encontrado para os parâmetros informados."
		FWFreeObj(oIncomeRepo)
		FWFreeObj(oMovementRepo)
		Return Nil
	EndIf

	Begin Transaction

		For nIndex := 1 To Len(aMovements)

			jMovement := aMovements[nIndex]

			If lReprocess
				lProcess := oIncomeRepo:inactivate(;
					jMovement["filial"],;
					jMovement["codigoCooperado"],;
					jMovement["lojaCooperado"],;
					cAnoRef)
			EndIf

			If lProcess
				aFields := Self:buildIncomeStatementFields(jMovement,cAnoRef,cRespCTB,cFilPgdora)
				oIncomeRepo:saveWithReclock(aFields)
				lProcess := oIncomeRepo:isSuccess()
			EndIf

			If !lProcess
				Self:setFullResponse(oIncomeRepo)
				DisarmTransaction()
				Exit
			EndIf
		Next nIndex

	End Transaction

	If lProcess
		Self:setSuccess(.T.)
	EndIf

	FWFreeObj(oIncomeRepo)
	FWFreeObj(oMovementRepo)
Return Nil

/*/{Protheus.doc} buildIncomeStatementFields
Monta os campos da NF0 a partir dos dados consolidados das movimentações.
@type method
@version 12
@author rodrigo.nsoledade
@since 14/08/2026
@param jMovement, json, dados consolidados do cooperado
@param cAnoRef, character, ano-calendário
@param cRespCTB, character, contabilista responsável
@param cFilPgdora, character, filial pagadora
@return array, campos para inclusão na NF0
/*/
Method buildIncomeStatementFields(jMovement,cAnoRef,cRespCTB,cFilPgdora) As Array Class QuotaIncomeStatementService
	Local aFields     := {}
	Local aSM0Data    := {}
	Local cCnpjFonte  := ""
	Local cNomeFonte  := ""
	Local cFilNF0     := jMovement["filial"]

	aSM0Data := FWSM0Util():GetSM0Data(cEmpAnt,cFilPgdora,{"M0_CGC","M0_NOMECOM","M0_NOME"})

	If Len(aSM0Data) >= 2
		cCnpjFonte := AllTrim(aSM0Data[1][2])
		cNomeFonte := IIF(!Empty(aSM0Data[2][2]), AllTrim(aSM0Data[2][2]), AllTrim(aSM0Data[3][2]))
	EndIf

	AAdd(aFields,{"NF0_FILIAL",FWxFilial("NF0",cFilNF0)})
	AAdd(aFields,{"NF0_CODCOO",jMovement["codigoCooperado"]})
	AAdd(aFields,{"NF0_LOJCOO",jMovement["lojaCooperado"]})
	AAdd(aFields,{"NF0_ANOEXE",StrZero(Val(cAnoRef) + 1,4)})
	AAdd(aFields,{"NF0_DTGERA",dDataBase})
	AAdd(aFields,{"NF0_HRGERA",Time()})
	AAdd(aFields,{"NF0_ANOCAL",cAnoRef})
	AAdd(aFields,{"NF0_CNPJF",cCnpjFonte})
	AAdd(aFields,{"NF0_NOMFON",cNomeFonte})
	AAdd(aFields,{"NF0_CPFBEN",jMovement["cpfBeneficiario"]})
	AAdd(aFields,{"NF0_NOMBEN",jMovement["nomeBeneficiario"]})
	AAdd(aFields,{"NF0_VALLIQ",jMovement["valorAno"]})
	AAdd(aFields,{"NF0_VALCMP",jMovement["valorAcumulado"]})
	AAdd(aFields,{"NF0_STATUS","1"})
	AAdd(aFields,{"NF0_CODCTB",cRespCTB})
	AAdd(aFields,{"NF0_NOMCTB",POSICIONE("CVB", 1, FwXFilial("CVB")+cRespCTB,"CVB_NOME")})
	AAdd(aFields,{"NF0_USRESP",RETCODUSR()})

Return aFields
