#Include "agrobusiness.agd.ipaas.proxy.service.ch"
#include "tlpp-core.th"
#include "totvs.ch"


namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} IpaasProxyService
Service de proxy para consulta de monitor no iPaaS.
@type class
@version 12
@author rodrigo.nsoledade
@since 19/06/2026
/*/
class IpaasProxyService from UtilsService

    public Data nHttpStatus As Numeric

    public method new()
    public method getListMonitor() as logical
    public method getHttpStatus() as Numeric
    public method saveConfiguration() as logical
    public method hasConfiguration() as logical

    private method buildFilter() as Character
    private method getApiKey()   as Character
    private method getTenant()   as Character
    private method getUrlBase()   as Character
endclass

/*/{Protheus.doc} New
Construtor do service de proxy iPaaS.
@type method
@version 12
@author rodrigo.nsoledade
@since 19/06/2026
@return object, Instancia da classe
/*/
method New() class IpaasProxyService
    _Super:New()
    ::nHttpStatus := 0
return Self

/*/{Protheus.doc} getListMonitor
Executa chamada HTTP ao monitor iPaaS com paginação.
@type method
@version 12
@author rodrigo.nsoledade
@since 19/06/2026
@param cCodFeature, character, codigo da feature informada na rota
@param oJsonQryParam, json, query params da requisicao
@param nPage, numeric, pagina atual
@param nPageSize, numeric, tamanho da pagina
@return logical, .T. quando processado
/*/
method getListMonitor(cCodFeature as Character, oJsonQryParam as Json, nPage as Numeric, nPageSize as Numeric) as logical class IpaasProxyService
    Local cApiKey      := Self:getApiKey()
    Local jResponse    := JsonObject():New()
    Local cUrl         as Character
    Local cResponse    as Character
    Local cHeaderRet   as Character
    Local cHttpError   as Character
    Local nHttpStatus  as Numeric
    Local nErrorStatus as Numeric
    Local aHeadStr     as Array

    Default cCodFeature   := ""
    Default oJsonQryParam := nil
    Default nPage         := 1
    Default nPageSize     := 10

    
    if !Self:hasConfiguration()
        ::setError(STR0001, 400) //"Dados de configuração não encontrados."
        return .T.
    endif

    aHeadStr := {}
    aAdd(aHeadStr, "Accept: application/json")
    aAdd(aHeadStr, "Content-Type: application/json;charset=utf-8")
    aAdd(aHeadStr, "Authorization: ApiKey " + cApiKey)

    cUrl      := Self:getUrlBase()  + Self:getTenant() + "/message?" + Self:buildFilter(cCodFeature, oJsonQryParam) + "&order=-createdDate&page=" + Str(nPage) + "&pageSize=" + Str(nPageSize)
    cResponse := HttpGet(cUrl, "", 60, aHeadStr, @cHeaderRet)

    nHttpStatus := HTTPGetStatus(@cHttpError)
    ::nHttpStatus := nHttpStatus

    if nHttpStatus >= 200 .and. nHttpStatus <= 299
        jResponse:fromJson(DecodeUTF8(cResponse))
        ::setSuccess(jResponse)
    else
        nErrorStatus := 502
        if nHttpStatus > 0
            nErrorStatus := nHttpStatus
        endif
        ::setError(cResponse, nErrorStatus, "", cResponse)
    endif

return .T.

/*/{Protheus.doc} getHttpStatus
Retorna o status HTTP da ultima chamada ao iPaaS.
@type method
@version 12
@author rodrigo.nsoledade
@since 19/06/2026
@return numeric, codigo HTTP retornado
/*/
method getHttpStatus() as Numeric class IpaasProxyService
return ::nHttpStatus

/*/{Protheus.doc} buildFilter
Cria o filtro de consulta para o iPaaS baseado nos parâmetros informados e na configuração da feature.
@type method
@version 12
@author jean.schulze
@since 6/22/2026
@param cCodFeature, character, codigo da feature informada na rota
@param oJsonQryParam, json, query params da requisicao
@return character, filtro de consulta gerado
/*/
method buildFilter(cCodFeature as Character, oJsonQryParam as Json) as Character class IpaasProxyService
    Local cFilter := ""
    Local cProjectName := ""
    Local cStartDate := ""
    Local cEndDate := "" 
    Local cStatus := "error,done"
    Local cFluxo := ""

    oTCOrepository := TCORepository():New()

	oFeatureClass := oTCOrepository:getFeatureClassById(AllTrim(cCodFeature))
	if oFeatureClass != nil
		cProjectName := oFeatureClass:getProjetoIPAAS()
	endIf

    FWFreeObj(oTCOrepository)

    if ValType(oJsonQryParam) == "J"

        if oJsonQryParam:hasProperty("status") .and. !Empty(AllTrim(cValToChar(oJsonQryParam["status"])))
            cStatus := AllTrim(cValToChar(oJsonQryParam["status"]))
        endif

        if oJsonQryParam:hasProperty("startDate") .and. !Empty(AllTrim(cValToChar(oJsonQryParam["startDate"])))
            cStartDate := "&startDate=" + AllTrim(cValToChar(oJsonQryParam["startDate"])) + "T00:00:00.000"
        endif

        if oJsonQryParam:hasProperty("endDate") .and. !Empty(AllTrim(cValToChar(oJsonQryParam["endDate"])))
            cEndDate := "&endDate=" + AllTrim(cValToChar(oJsonQryParam["endDate"])) + "T23:59:59.000"
        endif   

         if oJsonQryParam:hasProperty("fluxo") .and. !Empty(AllTrim(cValToChar(oJsonQryParam["fluxo"])))
            cFluxo := "&diagramName="+AllTrim(cValToChar(oJsonQryParam["fluxo"]))
        endif
    endif

    cFilter := "projectName=" + cProjectName + "&status=" + cStatus + cStartDate + cEndDate + cFluxo

return cFilter

/*/{Protheus.doc} saveConfiguration
Salva a configuração do iPaaS (tenant e apikey) nos parâmetros do Protheus.
@type method
@version 12
@author jean.schulze
@since 6/24/2026
@param jConfig, json, parametros
@return logical, nil
/*/
method saveConfiguration(jConfig as Json) as Logical class IpaasProxyService
    Local cUrl         as Character
    Local cResponse    as Character
    Local cHeaderRet   as Character
    Local cHttpError   as Character
    Local nHttpStatus  as Numeric

    if jConfig:hasProperty("tenant") .and. jConfig:hasProperty("apiKey")  .and. !Empty(AllTrim(jConfig['tenant'])) .and. !Empty(AllTrim(jConfig['apiKey']))
        
        /*Realiza o teste*/
        aHeadStr := {}
        aAdd(aHeadStr, "Accept: application/json")
        aAdd(aHeadStr, "Content-Type: application/json;charset=utf-8")
        aAdd(aHeadStr, "Authorization: ApiKey " + jConfig['apiKey'])

        cUrl      := Self:getUrlBase()  + jConfig['tenant'] + "/message?status=DONE&page=1&pageSize=1"
        cResponse := HttpGet(cUrl, "", 60, aHeadStr, @cHeaderRet)

        nHttpStatus := HTTPGetStatus(@cHttpError)

        if nHttpStatus >= 200 .and. nHttpStatus <= 299
            if PutMV("MV_AGD0008", jConfig['tenant']) .and. PutMV("MV_AGD0009", Encode64( WebEncript( jConfig['apiKey'] ) ))
                ::setSuccess(STR0002) //"Dados salvos com sucesso."
            else
                ::setError(STR0003, 404)       //"Não foi possível salvar os dados de acesso."
            endif
        else
            ::setError(STR0004 + cValToChar(cHttpError) + " " + cValToChar(cResponse), 404) //"Não foi possível validar os dados de acesso:"
        endif       
       
    else   
        ::setError(STR0005, 400) //"Dados não informados"
    endif
return .t.

/*/{Protheus.doc} hasConfiguration
Verifica se as configurações de tenant e apikey estão preenchidas.
@type method
@version 12
@author jean.schulze
@since 24/06/2026
@return logical, .T. quando tenant e apikey estiverem preenchidos
/*/
method hasConfiguration() as Logical class IpaasProxyService
    Local cTenant as Character
    Local cApiKey as Character

    cTenant := AllTrim(Self:getTenant())
    cApiKey := AllTrim(Self:getApiKey())

return !Empty(cTenant) .and. !Empty(cApiKey)

/*/{Protheus.doc} getApiKey
Retorna a chave de API configurada para o iPaaS.
@type method
@version 12
@author jean.schulze
@since 6/22/2026
@return variant, apikey
/*/
method getApiKey() as Character class IpaasProxyService
    Local cApiKey := SUPERGETMV("MV_AGD0009", .F., '') 

    if !Empty(cApiKey)
        cApiKey := WebEncript( Decode64( cApiKey ), .T. ) 
    endif
return cApiKey

/*/{Protheus.doc} getTenant
Retorna o tenant configurado para o iPaaS.
@type method
@version 12
@author jean.schulze
@since 6/22/2026
@return variant, tenant
/*/
method getTenant() as Character class IpaasProxyService
return SUPERGETMV("MV_AGD0008", .F., '')

/*/{Protheus.doc} getUrlBase
Retorna a URL base para as chamadas ao iPaaS.
@type method
@version 12
@author jean.schulze
@since 6/22/2026
@return character, rota
/*/
method getUrlBase() as Character class IpaasProxyService
return "https://api-ipaas.totvs.app/api/v1/"

