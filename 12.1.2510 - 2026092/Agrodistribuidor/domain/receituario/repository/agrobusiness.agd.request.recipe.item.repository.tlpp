#INCLUDE "totvs.ch"
#INCLUDE 'tlpp-core.th'

namespace totvs.protheus.agrobusiness.agd  

/*/{Protheus.doc} RequestRecipeItemRepository
Repositório dos Itens Solicitação de Receita (NEU)
@type class
@version P12.1.2610
@author carlos.augusto
@since 13/11/2025
/*/
class RequestRecipeItemRepository FROM UtilsRepository
	public Data cChaveIDRepository	As Object

	public Method New()
	public Method getFields()
	public Method getJoins()
	public Method getItemSolicitacaoAtivaByChave()
	public Method update()
endclass

/*/{Protheus.doc} New
Inicializador da Instancia
@type class
@version P12.1.2610
@author carlos.augusto
@since 13/11/2025
/*/
Method New(pcChaveIDRepository as character) Class RequestRecipeItemRepository
	Self:cChaveIDRepository := pcChaveIDRepository
	_Super:New('NEU', self:getFields(), Self:getJoins())
Return Self


/*/{Protheus.doc} getFields
Campos
@type class
@version P12.1.2610
@author carlos.augusto
@since 13/11/2025
/*/
Method getFields() Class RequestRecipeItemRepository
	Local aArrayFields := {}

	AAdd(aArrayFields, {'filial'                  , 'NEU_FILIAL', 'C', .T.})
	AAdd(aArrayFields, {'idSolicitacao'           , 'NEU_CODIGO', 'C', .T.})
	AAdd(aArrayFields, {'itemSolicitacao'   	  , 'NEU_ITEM'  , 'C', .T.})
	AAdd(aArrayFields, {'numeroPedido'            , 'NEU_NUMPED', 'C', .T.})
	AAdd(aArrayFields, {'itemPedido' 		      , 'NEU_ITEMPE', 'C', .T.})
	AAdd(aArrayFields, {'codigoProduto'           , 'NEU_PRODUT', 'C', .T.})
	AAdd(aArrayFields, {'sequenciaLiberacaoPedido', 'NEU_SEQLIB', 'C', .T.}) 
	AAdd(aArrayFields, {'quantidade'              , 'NEU_QTDVEN', 'C', .T.})
	AAdd(aArrayFields, {'unidadeMedida'           , 'NEU_UM'    , 'C', .T.})
	AAdd(aArrayFields, {'codigoMapa'              , 'NEU_MAPA'  , 'C', .T.})

	AAdd(aArrayFields, {'descricaoProduto'        , 'B1_DESC'   , 'C', .T.})

Return aArrayFields

/*/{Protheus.doc} getJoins
Relacionamento
@type class
@version P12.1.2610
@author carlos.augusto
@since 13/11/2025
/*/
Method getJoins() Class RequestRecipeItemRepository
	Local aArrayJoins  := {}

	AAdd(aArrayJoins, {'LEFT OUTER', 'SB1' , Self:getWhereDefault('SB1.B1_COD = NEU.NEU_PRODUT', 'SB1')})

Return aArrayJoins


/*/{Protheus.doc} getItemSolicitacaoAtivaByChave
Retorna o item de uma solicitação de receita (NEU) ativa de acordo com a sua SC9, pois podemos ter a mesma NEU em vários status
@type class
@version P12.1.2610
@author carlos.augusto
@since 10/03/2026
/*/
Method getItemSolicitacaoAtivaByChave(cFilSC9, cPedidoSC9, cItemSC9, cSeqLibSC9, cProdSC9) Class RequestRecipeItemRepository
	Local nRecnoNEU  := 0
    Local oFwPrepS   As Object
	Local cAliasSol  := GetNextAlias()
	Local cQuery     := ""

    cQuery := " SELECT NEU.R_E_C_N_O_ NEURECNO "
    cQuery += 	" FROM " + RetSqlName("NEU") + " NEU "
    cQuery += 		" INNER JOIN " + RetSqlName("NET") + " NET "
	cQuery += 		  " ON (  NET.NET_FILIAL = NEU.NEU_FILIAL "
    cQuery += 			" AND NET.NET_CODIGO = NEU.NEU_CODIGO "
	cQuery += 			" AND (( NET.NET_STSSOL = '1' AND NET.NET_STSREC = '0' )  " //Enviado sem receita
	cQuery += 			  " OR ( NET.NET_STSSOL = '0' AND NET.NET_STSREC = '0' )  " //Pendente envio
	cQuery += 			  " OR ( NET.NET_STSSOL = '4' AND NET.NET_STSREC = '0' )  " //Incompleta
	cQuery += 			  " OR ( NET.NET_STSSOL = '1' AND NET.NET_STSREC = '1' )) " //Enviado com receita
    cQuery += 			" AND NET.D_E_L_E_T_ = ' ' ) "
	cQuery += 	  " WHERE NEU.NEU_FILIAL = ? "
	cQuery += 		" AND NEU.NEU_NUMPED = ? "
	cQuery += 		" AND NEU.NEU_ITEMPE = ? "
	cQuery += 		" AND NEU.NEU_SEQLIB = ? "
	cQuery += 		" AND NEU.D_E_L_E_T_ = ' ' "

    cQuery := ChangeQuery(cQuery)

    oFwPrepS := FWPreparedStatement():New()
    oFwPrepS:SetQuery(cQuery)
    oFwPrepS:SetString(1, cFilSC9)
	oFwPrepS:SetString(2, cPedidoSC9)
	oFwPrepS:SetString(3, cItemSC9)
	oFwPrepS:SetString(4, cSeqLibSC9)
    
    cQuery := oFwPrepS:GetFixQuery()
    
    DbUseArea(.T., "TOPCONN", TCGenQry(,,cQuery), cAliasSol, .F., .T.)
 	If (cAliasSol)->(!Eof())
		nRecnoNEU := (cAliasSol)->NEURECNO
	EndIf
	 (cAliasSol)->(DbCloseArea())
	 FwFreeObj(oFwPrepS)   

Return nRecnoNEU

/*/{Protheus.doc} RequestRecipeItemRepository::update
Atualiza o repositorio a partir dos campos e valores informados
@type method
@version 12
@author jc.maldonado
@since 09/06/2026
@param aFieldsSave, array, campo/valores a serem atualizados {{cCampo, xValor}, ...}
@param cChaveID, character, chave do registro a ser atualizado
@param nOrderTable, numeric, ordem da tabela
/*/
Method update(aFieldsSave as array, cChaveID as character, nOrderTable as integer) Class RequestRecipeItemRepository
	Default nOrderTable := 1
	::updateRepository(aFieldsSave, cChaveID, nOrderTable)
Return 
