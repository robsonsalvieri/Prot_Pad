	AAdd(aArrayFields, {'horaExport'	, 'NF2_HREXP'  , 'C', .T.})

Return aArrayFields

/*/{Protheus.doc} saveDadosNotaEntrada
Salva o modelo AGDA041
@type method
@version P12
@author lindembergson.pacheco
@since 11/05/2026
@param aPayload, array, array com payload
/*/
Method saveDadosNotaEntrada(jPayload) Class InvoiceDataRepository
	Local oModel
	Local aPayload, aFields
	Local cError := ""
	Local nI	:= 0
	Local aNota := {}
	Local cChave := {}

	If !jPayload:hasProperty("items") .Or. !ValType(jPayload["items"]) == "A"
		Self:setDefaultError(403)
		Return nil
	EndIf

	aNota 		:= jPayload["items"]
	aPayload	:= Self:getFieldsNF1()

	For nI := 1 To Len(aNota)

		cChave := PadR( aNota[nI]['numero'], TamSX3("NF1_DOC")[1]) + PadR( aNota[nI]['serie'], TamSX3("NF1_SERIE")[1]) +  PadR( aNota[nI]['fornecedor'], TamSX3("NF1_FORNEC")[1])  +  PadR( aNota[nI]['loja'], TamSX3("NF1_LOJA")[1])  +  PadR( aNota[nI]['formulario'], TamSX3("NF1_FORMUL")[1])
		DBSelectArea("NF1")
		DBSetOrder(1) //NF1_FILIAL+NF1_DOC+NF1_SERIE+NF1_FORNEC+NF1_LOJA+NF1_FORMUL
		If !dbSeek(xFilial("NF1")+cChave)

			DBSelectArea("SF1")
			DBSetOrder(12) //F1_FILIAL+F1_DOC+F1_SERIE+F1_FORNECE+F1_LOJA+F1_FORMUL
			If dbSeek(xFilial("SF1")+cChave)

				oModel := FwLoadModel("AGDA041")
				oModel:SetOperation(MODEL_OPERATION_INSERT)
				oModel:Activate()

				aFields := Self:jsonToArrayFields(aNota[nI], aPayload)
				Self:setValueModel(oModel:GetModel("AGDA041_NF1"), aFields)

				If oModel:VldData()
					oModel:CommitData()
				Else
					cError := cValToChar(oModel:GetErrorMessage()[MODEL_MSGERR_IDFIELDERR]) + " - "
					cError += cValToChar(oModel:GetErrorMessage()[MODEL_MSGERR_ID]) + " - "
					cError += cValToChar(oModel:GetErrorMessage()[MODEL_MSGERR_MESSAGE])
					Self:setError(cError, 400)
				EndIf

				oModel:DeActivate()
				oModel:Destroy()

			endif


		ENDIF

	Next

	oModel := Nil
	FreeObj(oModel)

Return .T.

/*/{Protheus.doc} saveDadosNotaSaida
Salva o modelo AGDA042
@type method
@version P12
@author lindembergson.pacheco
@since 11/05/2026
@param aPayload, array, array com payload
/*/
Method saveDadosNotaSaida(jPayload) Class InvoiceDataRepository
	Local oModel
	Local aPayload, aFields
	Local cError := ""
	Local nI	:= 0
	Local aNota := {}
	Local cChave := ""

	If !jPayload:hasProperty("items") .Or. !ValType(jPayload["items"]) == "A"
		Self:setDefaultError(403)
		Return nil
	EndIf

	aNota 		:= jPayload["items"]
	aPayload	:= Self:getFieldsNF2()

	For nI := 1 To Len(aNota)
		cChave := PadR( aNota[nI]['numero'] , TamSX3("NF2_DOC")[1]) + PadR( aNota[nI]['serie'] , TamSX3("NF2_SERIE")[1]) +  PadR( aNota[nI]['cliente'] , TamSX3("NF2_CLIENT")[1])  +  PadR( aNota[nI]['loja'] , TamSX3("NF2_LOJA")[1])
		DBSelectArea("NF2")
		DBSetOrder(1) //NF2_FILIAL+NF2_DOC+NF2_SERIE+NF2_CLIENT+NF2_LOJA
		If !dbSeek(xFilial("NF2")+ cChave)

			DBSelectArea("SF2")
			DBSetOrder(1) //F2_FILIAL+F2_DOC+F2_SDOC+F2_CLIENTE+F2_LOJA+F2_FORMUL+F2_TIPO
			If dbSeek(xFilial("SF2")+cChave)
				oModel := FwLoadModel("AGDA042")
				oModel:SetOperation(MODEL_OPERATION_INSERT)
				oModel:Activate()

				aFields := Self:jsonToArrayFields(aNota[nI], aPayload)
				Self:setValueModel(oModel:GetModel("AGDA042_NF2"), aFields)

				If oModel:VldData()
					oModel:CommitData()
				Else
					cError := cValToChar(oModel:GetErrorMessage()[MODEL_MSGERR_IDFIELDERR]) + " - "
					cError += cValToChar(oModel:GetErrorMessage()[MODEL_MSGERR_ID]) + " - "
					cError += cValToChar(oModel:GetErrorMessage()[MODEL_MSGERR_MESSAGE])
					Self:setError(cError, 400)
				EndIf

				oModel:DeActivate()
				oModel:Destroy()

			Endif

		ENDIF

	Next

	oModel := Nil

	FreeObj(oModel)

Return .T.


/*/{Protheus.doc} InvoiceDataRepository::formatFiltro
Formata a String de parametros de busca para uso na query 
@type method
@version  P12
@author claudineia.reinert
@since 22/05/2026
@param cFiltro, character, String com as informacoes separadas por ";"
@return variant, String formatada para uso na query
/*/
method formatFiltro(cFiltro) class InvoiceDataRepository
	Local aItems     := StrTokArr2(cFiltro, ";")
	Local cFiltroRet := ""
	Local nX         := 0

	for nX := 1 to Len(aItems)
		cFiltroRet += "'" + Upper(AllTrim(aItems[nX])) + "'"
		If nX > 0 .and. nX < Len(aItems)
			cFiltroRet += ","
		EndIf
	next nX
Return cFiltroRet
