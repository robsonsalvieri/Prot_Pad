#INCLUDE "totvs.ch"
#INCLUDE 'tlpp-core.th'

namespace totvs.protheus.agrobusiness.agd  


/*/{Protheus.doc} RecipeItemRepository
Repositório dos Itens Solicitação de Receita (NEU)
@type class
@version P12.1.2610
@author carlos.augusto
@since 13/11/2025
/*/
class RecipeItemRepository FROM UtilsRepository
	public Data cChaveIDRepository	As Object

	public Method New()
	public Method getFields()
	public Method update()
endclass

/*/{Protheus.doc} New
Inicializador da Instancia
@type class
@version P12.1.2610
@author carlos.augusto
@since 13/11/2025
/*/
Method New(pcChaveIDRepository as character) Class RecipeItemRepository
	Self:cChaveIDRepository := pcChaveIDRepository
	_Super:New('NE7', self:getFields())
Return Self


/*/{Protheus.doc} getFields
Campos
@type class
@version P12.1.2610
@author carlos.augusto
@since 13/11/2025
/*/
Method getFields() Class RecipeItemRepository
	Local aArrayFields := {}

	AAdd(aArrayFields, {'filial'                  , 'NE7_FILIAL', 'C', .T.})
	AAdd(aArrayFields, {'idReceita'               , 'NE7_CODREC', 'C', .T.})
	AAdd(aArrayFields, {'sequencia'   	          , 'NE7_SEQREC', 'C', .T.})
	AAdd(aArrayFields, {'quantidade' 		      , 'NE7_QTDE'  , 'N', .T.})
	AAdd(aArrayFields, {'quantidadeDisponivel'    , 'NE7_QTDISP', 'N', .T.})
	AAdd(aArrayFields, {'codigoMapa'        	  , 'NE7_MAPA'	, 'C', .T.})

Return aArrayFields

/*/{Protheus.doc} RecipeItemRepository::update
Atualiza o repositorio a partir dos campos e valores informados
@type method
@version 12
@author jc.maldonado
@since 09/06/2026
@param aFieldsSave, array, Campos/valores a serem atualizados {{cCampo, xValor}, ...}
@param cChaveID, character, Chave do registro a ser atualizado
@param nOrderTable, numeric, Ordem da tabela
/*/
Method update(aFieldsSave as array, cChaveID as character, nOrderTable as integer) Class RecipeItemRepository
	Default nOrderTable := 1
	::updateRepository(aFieldsSave, cChaveID, nOrderTable)
Return 
