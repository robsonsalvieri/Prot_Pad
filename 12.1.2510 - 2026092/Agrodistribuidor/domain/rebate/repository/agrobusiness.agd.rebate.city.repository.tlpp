#Include "totvs.ch"
#Include "tlpp-core.th"

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} CityRepository
Repositório responsável pela consulta de municípios para integração de rebate.
Tabela base: CC2 (Municípios).
@type class
@author felipe.savelar
@since 30/07/2026
/*/
Class CityRepository From UtilsRepository

    Public Method New()
    Public Method find( nPage As Numeric, nPageSize As Numeric, jQueryParams As Json )
    Public Method getFields() As Array

    Private Method formatResponse( jResponse As Json ) As Object

EndClass

/*/{Protheus.doc} New
Construtor do repositório de municípios.
@type method
@author felipe.savelar
@since 30/07/2026
@return object, instância da classe
/*/
Method New() Class CityRepository
    _Super:New("CC2", Self:getFields())
Return Self

/*/{Protheus.doc} find
Consulta paginada dos municípios para integração de rebate.
@type method
@author felipe.savelar
@since 30/07/2026
@param nPage, numeric, número da página
@param nPageSize, numeric, quantidade de registros por página
@param jQueryParams, json, parâmetros de filtro e ordenação
/*/
Method find( nPage As Numeric, nPageSize As Numeric, jQueryParams As Json ) Class CityRepository
    Local aArea     As Array
    Local cOrder    As Character
    Local cWhere    As Character
    Local jResponse As Object

    Default nPage       := 1
    Default nPageSize   := 10
    Default jQueryParams := Nil

    If Self:lOk
        aArea  := FwGetArea()
        cOrder := Self:getOrderQueryParam(jQueryParams, Self:getFields())
        cWhere := Self:getWhereQueryParam(jQueryParams, Self:getFields())

        Self:setFieldsConsulta(Self:getFields())
        Self:setPage(nPage)
        Self:setPageSize(nPageSize)
        Self:SetQuery(Self:getQueryDefault({}))
        Self:SetWhere(Self:getWhereDefault(cWhere))
        Self:SetUrlFilter(Self:getFilterAdvancedQueryParam(jQueryParams))
        Self:SetOrder(cOrder)

        If Self:Execute()
            Self:FillGetResponse()
            If Self:lOk
                jResponse := Self:convertToJson(Self:getJSONResponse())
                Self:setSuccess(Self:formatResponse(jResponse))
            EndIf
        EndIf

        FwRestArea(aArea)
        FwFreeArray(aArea)
        FreeObj(jResponse)
    EndIf
Return Nil

/*/{Protheus.doc} getFields
Retorna os campos disponibilizados pela API e seus respectivos campos Protheus.
Mapeamento: tabela CC2 conforme especificação técnica de rebate.
@type method
@author felipe.savelar
@since 30/07/2026
@return array, {{cCampoJson, cCampoProtheus, cTipo, lExibir}, ...}
/*/
Method getFields() As Array Class CityRepository
    Local aFields := {}

    AAdd(aFields, {"MunicipioCodigoERP"  , "CC2_CODMUN"  , "C", .T.})
    AAdd(aFields, {"MunicipioCodigoIBGE" , "CC2_CODMUN"  , "C", .T.})
    AAdd(aFields, {"MunicipioDescricao"  , "CC2_MUN"     , "C", .T.})
    AAdd(aFields, {"MunicipioUF"         , "CC2_EST"     , "C", .T.})

Return aFields

/*/{Protheus.doc} formatResponse
Complementa os campos calculados da resposta:
- MunicipioCodigoERP  : monta chave empresa|filial|municipio
- MunicipioCodigoIBGE : prefixa com o código IBGE do estado (Tms120CdUf)
  para formar o código de 7 dígitos conforme padrão IBGE.
@type method
@author felipe.savelar
@since 30/07/2026
@param jResponse, json, resposta bruta gerada pelo FWAdapterBaseV2
@return object, resposta tratada
/*/
Method formatResponse( jResponse As Json ) As Object Class CityRepository
    Local aItems    As Array
    Local jItem     As Object
    Local nItem     As Numeric
    Local cEmpresa  As Character
    Local cFilAux   As Character
    Local cMunicipio As Character
    Local cUF       As Character
    Local cCodIBGE  As Character

    aItems := jResponse["items"]
    cEmpresa := AllTrim(FwGrpCompany())
    cFilAux  := RTrim(FWxFilial("CC2"))

    For nItem := 1 To Len(aItems)
        jItem := aItems[nItem]

        // MunicipioCodigoERP: empresa|filial|municipio
        cMunicipio := AllTrim(jItem["MunicipioCodigoERP"])
        jItem["MunicipioCodigoERP"] := cEmpresa + "|" + cFilAux + "|" + cMunicipio

        // MunicipioCodigoIBGE: codigo IBGE estado (2 dig) + codigo municipio (5 dig) = 7 digitos
        cUF      := AllTrim(jItem["MunicipioUF"])
        cCodIBGE := Tms120CdUf(cUF) + AllTrim(jItem["MunicipioCodigoIBGE"])
        jItem["MunicipioCodigoIBGE"] := cCodIBGE
    Next nItem

Return jResponse
