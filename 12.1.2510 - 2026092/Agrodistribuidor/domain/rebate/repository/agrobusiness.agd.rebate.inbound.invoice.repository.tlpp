/*/
Method getItemFields() As Array Class RebateInboundInvoiceRepository
	Local aFields := {}

	AAdd(aFields,{"codi_pro","D1_COD","C",.T.})
	AAdd(aFields,{"desc_pro","B1_DESC","C",.T.})
	AAdd(aFields,{"unid_pro","D1_UM","C",.T.})
	AAdd(aFields,{"ncmp_pro","B1_POSIPI","C",.T.})
	AAdd(aFields,{"barr_pro","B1_CODBAR","C",.T.})
	AAdd(aFields,{"cind_pro","CODIGOPRODUTOFABRICANTE","C",.T.})
	AAdd(aFields,{"lote_ivn","D1_LOTECTL","C",.T.})
	AAdd(aFields,{"fsem_pro","SEMENTE","C",.T.})
	AAdd(aFields,{"trat_pro","TRATAMENTO","C",.T.})
	AAdd(aFields,{"trib_ivn","VALORTRIBUTOS","N",.T.})
	AAdd(aFields,{"codi_cul","NCR_CULTUR","C",.T.})
	AAdd(aFields,{"desc_cul","NP3_DESCRI","C",.T.})
	AAdd(aFields,{"crec_ivn","CULTURARECEITUARIO","C",.T.})
	AAdd(aFields,{"drec_ivn","DESCCULTURARECEITUARIO","C",.T.})
	AAdd(aFields,{"pbru_ivn","FT_TOTAL","N",.T.})
	AAdd(aFields,{"pliq_ivn","D1_TOTAL","N",.T.})
	AAdd(aFields,{"qtde_ivn","D1_QUANT","N",.T.})
Return aFields

/*/{Protheus.doc} formatResponse
Formata campos derivados, preenche dados da filial e aplica
proteção aos dados do emitente da devolução.
@type method
@author rodrigo.nsoledade
@param jResponse, json, resposta da consulta
@return object, resposta formatada
/*/
Method formatResponse(jResponse) As Object Class RebateInboundInvoiceRepository
	Local aItems  as Object
	Local aProtectedFields as Array
	Local aAllowedFields as Array
	Local aProtectedMap as Array
	Local aBranchData := {} 
	Local aJsonFields := {}
	Local jItem As Object
	Local nItem := 0
	Local nField := 0
	Local nJsonField := 0

	aItems := jResponse["items"]
	aProtectedFields := {"A2_CGC","A2_INSCR","A2_NOME","A2_END","A2_BAIRRO","A2_COMPLEM","A2_CEP","A2_TEL","A2_EMAIL"}
	aAllowedFields := FwProtectedDataUtil():UsrAccessPDField(__cUserID,aProtectedFields)
	aProtectedMap := {;
		{"A2_CGC",{"cnpj_cli","emit_ven"}},;
		{"A2_INSCR"  ,{"insc_cli"}},;
		{"A2_NOME"   ,{"nome_cli"}},;
		{"A2_END"    ,{"enco_cli"}},;
		{"A2_BAIRRO" ,{"bair_cli"}},;
		{"A2_COMPLEM",{"comp_cli"}},;
		{"A2_CEP"    ,{"cepc_cli"}},;
		{"A2_TEL"    ,{"tele_cli","celu_cli"}},;
		{"A2_EMAIL"  ,{"emai_cli"}},;
		{"A2_CGC"    ,{"dest_ven"}},;
		{"A2_END"    ,{"enco_ivn"}},;
		{"A2_BAIRRO" ,{"bair_ivn"}},;
		{"A2_COMPLEM",{"comp_ivn"}},;
		{"A2_CEP"    ,{"cepc_ivn"}}}

	aBranchData := Self:getBranchData(Self:cFilialUsada)

	For nItem := 1 To Len(aItems)
		jItem := aItems[nItem]		

		jItem["codi_ven"] := cValToChar(jItem["codi_ven"])
		jItem["modl_ven"] := SubStr(jItem["modl_ven"],21,2)

		// O emitente da NF de devolução é o fornecedor/cliente que emitiu o documento.
		jItem["emit_ven"] := jItem["cnpj_cli"]
		jItem["nume_cli"] := TrataEnd(jItem["enco_cli"],"N")
		jItem["enco_cli"] := TrataEnd(jItem["enco_cli"],"L")
		jItem["muni_cli"] := Tms120CdUf(jItem["estd_cli"],"1") + AllTrim(jItem["muni_cli"])
		jItem["insc_cli"] := IIf(Empty(jItem["insc_cli"]),"ISENTO",jItem["insc_cli"])
		jItem["tele_cli"] := IIf(Empty(jItem["ddd_cli"]),AllTrim(jItem["tele_cli"]),"(" + AllTrim(jItem["ddd_cli"]) + ") " + AllTrim(jItem["tele_cli"]))
		jItem["celu_cli"] := IIf(Empty(jItem["ddd_cli"]),AllTrim(jItem["celu_cli"]),"(" + AllTrim(jItem["ddd_cli"]) + ") " + AllTrim(jItem["celu_cli"]))
		jItem:DelName("ddd_cli")

		// O destinatário e o endereço de entrega correspondem à própria filial.
		If Len(aBranchData) > 0
			jItem["dest_ven"] := AllTrim(aBranchData[1][2])
			jItem["enco_ivn"] := AllTrim(aBranchData[2][2])
			jItem["bair_ivn"] := AllTrim(aBranchData[3][2])
			jItem["comp_ivn"] := AllTrim(aBranchData[4][2])
			jItem["cepc_ivn"] := AllTrim(aBranchData[5][2])
			jItem["estd_ivn"] := AllTrim(aBranchData[6][2])
			jItem["muni_ivn"] := AllTrim(aBranchData[7][2])
			jItem["nume_ivn"] := TrataEnd(jItem["enco_ivn"],"N")
			jItem["enco_ivn"] := TrataEnd(jItem["enco_ivn"],"L")
			jItem["muni_ivn"] := Tms120CdUf(jItem["estd_ivn"],"1") + jItem["muni_ivn"]
		EndIf

		For nField := 1 To Len(aProtectedMap)
			If AScan(aAllowedFields,aProtectedMap[nField][1]) == 0
				aJsonFields := aProtectedMap[nField][2]

				For nJsonField := 1 To Len(aJsonFields)
					If jItem:HasProperty(aJsonFields[nJsonField])
						jItem[aJsonFields[nJsonField]] := FwProtectedDataUtil():ValueAsteriskToAnonymize(jItem[aJsonFields[nJsonField]])
					EndIf
				Next nJsonField
			EndIf
		Next nField
	Next nItem

	jResponse["items"] := aItems
Return jResponse

/*/{Protheus.doc} getBranchData
Retorna os dados da filial utilizados como destinatário da devolução.
A posição dos campos no retorno segue a ordem informada ao FWSM0Util.
@type method
@author rodrigo.nsoledade
@param cBranch, character, código da filial
@return array, dados da SM0
/*/
Method getBranchData(cBranch) As Array Class RebateInboundInvoiceRepository
	Local aFields := {;
		"M0_CGC",;
		"M0_ENDENT",;
		"M0_BAIRENT",;
		"M0_COMPENT",;
		"M0_CEPENT",;
		"M0_ESTENT",;
		"M0_CODMUN"}
Return FWSM0Util():GetSM0Data(cEmpAnt,cBranch,aFields)
