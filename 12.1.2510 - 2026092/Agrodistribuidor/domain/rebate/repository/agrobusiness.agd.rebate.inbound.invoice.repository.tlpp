#Include "totvs.ch"
#Include "tlpp-core.th"

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} RebateInboundInvoiceRepository
Repository responsável pela consulta de notas fiscais de entrada
do tipo devolução para integração de rebate.
@type class
@version 1.0
@author rodrigo.nsoledade
@since 23/07/2026
/*/
Class RebateInboundInvoiceRepository From UtilsRepository
	Private data cFilialUsada  As character

	Public Method New()
	Public Method findInboundInvoices(nPage,nPageSize,jQueryParams)

	Private Method buildInboundQuery(jQueryParams) As Character
	Private Method getFields() As Array
	Private Method getItemFields() As Array
	Private Method formatResponse(jResponse) As Object
	Private Method getBranchData(cBranch) As Array

EndClass

/*/{Protheus.doc} New
Construtor da classe.
@type method
@version 1.0
@author rodrigo.nsoledade
@since 23/07/2026
@return object, instância da classe
/*/
Method New() Class RebateInboundInvoiceRepository
	Self:cFilialUsada := cFilAnt
	_Super:New("SF1")
Return Self

/*/{Protheus.doc} findInboundInvoices
Consulta notas fiscais de entrada do tipo devolução.
@type method
@version 1.0
@author rodrigo.nsoledade
@since 23/07/2026
@param nPage, numeric, número da página
@param nPageSize, numeric, quantidade de registros por página
@param jQueryParams, json, parâmetros da query string
/*/
Method findInboundInvoices(nPage,nPageSize,jQueryParams) Class RebateInboundInvoiceRepository
	Local cOrder  := "F1_EMISSAO, F1_DOC, F1_SERIE"
	Local cQuery  := ""
	Local cWhere  := ""
	Local aFields := AClone(Self:getFields())
	Local jResponse As Object

	Default nPage := 1
	Default nPageSize := 10
	Default jQueryParams := Nil

	If jQueryParams != Nil .And. jQueryParams:HasProperty("codi_rev") .And. !Empty(jQueryParams["codi_rev"])
		Self:cFilialUsada := jQueryParams["codi_rev"]
		jQueryParams["codi_rev"] := FWxFilial('SF1',Self:cFilialUsada)
	EndIf

	nPageSize := Min(nPageSize,200)
	cQuery := Self:buildInboundQuery(jQueryParams)
	cOrder := Self:getOrderQueryParam(jQueryParams,Self:getFields())
	cWhere := Self:getWhereQueryParam(jQueryParams,Self:getFields())

	AEval(Self:getItemFields(),{|aField| AAdd(aFields,aField)})

	Self:setFieldsConsulta(aFields)
	Self:setPage(nPage)
	Self:setPageSize(nPageSize)
	Self:SetQuery(Self:getQueryDefault(,cQuery))
	Self:SetWhere(if(Empty(cWhere),"1=1",cWhere))
	self:SetUrlFilter(self:getFilterAdvancedQueryParam(jQueryParams))
	Self:SetUseSpaces(.F.)
	Self:SetOrder(cOrder)

	If Self:Execute()
		Self:FillGetResponse()

		If Self:lOk
			jResponse := Self:convertToJson(Self:getJSONResponse())
			Self:setSuccess(Self:formatResponse(jResponse))
		EndIf
	EndIf
	
Return Nil

/*/{Protheus.doc} buildInboundQuery
Monta a consulta das notas fiscais de entrada do tipo devolução.
@type method
@version 1.0
@author rodrigo.nsoledade
@since 23/07/2026
@param jQueryParams, json, filtros opcionais: codi_rev, data_ini (YYYYMMDD), data_fim (YYYYMMDD), fabricanteID
@return character, consulta SQL preparada
/*/
Method buildInboundQuery(jQueryParams) As Character Class RebateInboundInvoiceRepository
	Local cQuery        := ""
	Local oStatement    := FWPreparedStatement():New()
	Local aBindParam    := {}
	Local nParamPos     := 1
	Local nX            := 0
	Local cDataIni      := ""
	Local cDataFim      := ""
	Local cFabricanteID := ""
	Local cFilialSF1    := ""

	Default jQueryParams := Nil

	If ValType(jQueryParams) == "J"
		If jQueryParams:HasProperty("data_ini")
			cDataIni := AllTrim(jQueryParams["data_ini"])
		EndIf

		If jQueryParams:HasProperty("data_fim")
			cDataFim := AllTrim(jQueryParams["data_fim"])
		EndIf

		If jQueryParams:HasProperty("fabricanteID")
			cFabricanteID := AllTrim(jQueryParams["fabricanteID"])
		EndIf
	EndIf

	cFilialSF1 := FWXFilial("SF1", Self:cFilialUsada)

	cQuery += " SELECT SF1.R_E_C_N_O_ AS RECNOSF1, "
	cQuery += "        SF1.D_E_L_E_T_, "
	cQuery += "        F1_FILIAL, "
	cQuery += "        CONCAT(NCR_FABCOD, CONCAT('.', NCR_FABLOJ)) AS FABRICANTE, "
	cQuery += "        F1_CHVNFE AS MODELODOCUMENTO, "
	cQuery += "        ' ' AS EMITENTEVENDA, "
	cQuery += "        F1_DOC, "
	cQuery += "        F1_SERIE, "
	cQuery += "        F1_CHVNFE, "

	cQuery += "        CASE F1_TIPO "
	cQuery += "            WHEN 'N' THEN '1 - NF-e Normal' "
	cQuery += "            WHEN 'B' THEN '1 - NF-e Normal' "
	cQuery += "            WHEN 'C' THEN '2 - NF-e Complementar' "
	cQuery += "            WHEN 'I' THEN '2 - NF-e Complementar' "
	cQuery += "            WHEN 'P' THEN '2 - NF-e Complementar' "
	cQuery += "            WHEN 'D' THEN '4 - Devolução de Mercadoria' "
	cQuery += "            ELSE '1 - NF-e Normal' "
	cQuery += "        END AS F1_TIPO, "

	cQuery += "        F1_EMISSAO, "
	cQuery += "        NULL AS DATAVENCIMENTO, "
	cQuery += "        CASE WHEN D1_NFORI = ' ' "
	cQuery += "             THEN D1_PEDIDO "
	cQuery += "             ELSE CONCAT(D1_NFORI, CONCAT('.', D1_SERIORI)) "
	cQuery += "        END AS ORIGEMVENDA, "
	cQuery += "        NULL AS CODIGOCONDICAO, "
	cQuery += "        NULL AS PRAZOCONDICAO, "
	cQuery += "        NULL AS DESCRICAOCONDICAO, "
	cQuery += "        NULL AS TIPOCONDICAO, "
	cQuery += "        CASE WHEN F1_MOEDA = '1' THEN NULL ELSE F1_MOEDA END AS INDEXADORMOEDA, "
	cQuery += "        NULL AS DESCINDEXADORMOEDA, "
	cQuery += "        NULL AS UMINDEXADORMOEDA, "
	cQuery += "        CASE WHEN F1_MOEDA = '1' THEN NULL ELSE F1_TXMOEDA END AS COTACAOINDEXADORMOEDA, "
	cQuery += "        F4_CODIGO, "
	cQuery += "        F4_TEXTO, "
	cQuery += "        F4_TIPO, "
	cQuery += "        F4_CF, "
	cQuery += "        CASE WHEN FT_DTCANC = ' ' THEN 'A' ELSE 'C' END AS STATUSNF, "

	// Para devolução de entrada, o emitente do documento está cadastrado na SA2.
	cQuery += "        CONCAT(SA2.A2_COD, CONCAT('.', SA2.A2_LOJA)) AS CODIGOCLIENTE, "
	cQuery += "        SA2.A2_CGC AS CLIENTECGC, "
	cQuery += "        SA2.A2_INSCR AS CLIENTEINSCR, "
	cQuery += "        SA2.A2_NOME AS CLIENTENOME, "
	cQuery += "        SA2.A2_END AS CLIENTEENDERECO, "
	cQuery += "        SA2.A2_EST AS CLIENTEESTADO, "
	cQuery += "        SA2.A2_BAIRRO AS CLIENTEBAIRRO, "
	cQuery += "        SA2.A2_COMPLEM AS CLIENTECOMPLEMENTO, "
	cQuery += "        SA2.A2_CEP AS CLIENTECEP, "
	cQuery += "        SA2.A2_COD_MUN AS CLIENTEMUNICIPIO, "
	cQuery += "        SA2.A2_DDD AS CLIENTEDDD, "
	cQuery += "        SA2.A2_TEL AS CLIENTETELEFONE, "
	cQuery += "        SA2.A2_EMAIL AS CLIENTEEMAIL, "
	cQuery += "        ' ' AS DATAULTIMAMOVIMENTACAODB, "

	cQuery += "        D1_COD, "
	cQuery += "        B1_DESC, "
	cQuery += "        D1_UM, "
	cQuery += "        B1_POSIPI, "
	cQuery += "        B1_CODBAR, "
	cQuery += "        D1_LOTECTL, "
	cQuery += "        NULL AS CODIGOPRODUTOFABRICANTE, "
	cQuery += "        NULL AS TRATAMENTO, "
	cQuery += "        CASE WHEN B5_SEMENTE = '1' THEN 'S' ELSE 'D' END AS SEMENTE, "
	cQuery += "        ISNULL(D1_VALICM,0) + ISNULL(D1_ICMSRET,0) + ISNULL(D1_VALIPI,0) AS VALORTRIBUTOS, "
	cQuery += "        NCR_CULTUR, "
	cQuery += "        NP3_DESCRI, "
	cQuery += "        ' ' AS CULTURARECEITUARIO, "
	cQuery += "        ' ' AS DESCCULTURARECEITUARIO, "
	cQuery += "        FT_TOTAL, "
	cQuery += "        D1_TOTAL, "
	cQuery += "        D1_QUANT, "

	// Não existe vendedor associado diretamente à SF1.
	cQuery += "        ' ' AS CODIGOVENDEDOR, "
	cQuery += "        ' ' AS NOMEVENDEDOR, "
	cQuery += "        ' ' AS CGCVENDEDOR, "
	cQuery += "        ' ' AS NASCIMENTOVENDEDOR, "
	cQuery += "        ' ' AS NPISVENDEDOR, "

	// Na devolução de entrada, o destinatário é a própria filial.
	cQuery += "        ' ' AS CGCDESTINATARIO, "
	cQuery += "        ' ' AS ENDERECOENTREGA, "
	cQuery += "        ' ' AS BAIRROENTREGA, "
	cQuery += "        ' ' AS COMPLEMENTOENTREGA, "
	cQuery += "        ' ' AS CEPENTREGA, "
	cQuery += "        ' ' AS ESTADOENTREGA, "
	cQuery += "        ' ' AS MUNICIPIOENTREGA "

	cQuery += "   FROM " + RetSqlName("SF1") + " SF1 "

	cQuery += "  INNER JOIN " + RetSqlName("SD1") + " SD1 "
	cQuery += "     ON SD1.D_E_L_E_T_ = ' ' "
	cQuery += "    AND D1_FILIAL = F1_FILIAL "
	cQuery += "    AND D1_DOC = F1_DOC "
	cQuery += "    AND D1_SERIE = F1_SERIE "
	cQuery += "    AND D1_FORNECE = F1_FORNECE "
	cQuery += "    AND D1_LOJA = F1_LOJA "

	cQuery += "  INNER JOIN " + RetSqlName("SB1") + " SB1 "
	cQuery += "     ON SB1.D_E_L_E_T_ = ' ' "
	cQuery += "    AND B1_FILIAL = ? " ;AAdd(aBindParam, FWXFilial("SB1", Self:cFilialUsada))
	cQuery += "    AND B1_COD = D1_COD "

	cQuery += "  INNER JOIN " + RetSqlName("SA2") + " SA2 "
	cQuery += "     ON SA2.D_E_L_E_T_ = ' ' "
	cQuery += "    AND A2_FILIAL = ? " ;AAdd(aBindParam, FWXFilial("SA2", Self:cFilialUsada))
	cQuery += "    AND A2_COD = F1_FORNECE "
	cQuery += "    AND A2_LOJA = F1_LOJA "

	cQuery += "  INNER JOIN " + RetSqlName("NCR") + " NCR "
	cQuery += "     ON NCR.D_E_L_E_T_ = ' ' "
	cQuery += "    AND NCR_FILIAL = B1_FILIAL "
	cQuery += "    AND NCR_PROD = D1_COD "

	cQuery += "  INNER JOIN " + RetSqlName("SA2") + " FAB "
	cQuery += "     ON FAB.D_E_L_E_T_ = ' ' "
	cQuery += "    AND FAB.A2_FILIAL = ? " ;AAdd(aBindParam, FWXFilial("SA2", Self:cFilialUsada))
	cQuery += "    AND FAB.A2_COD = NCR_FABCOD "
	cQuery += "    AND FAB.A2_LOJA = NCR_FABLOJ "

	cQuery += "  INNER JOIN " + RetSqlName("SF4") + " SF4 "
	cQuery += "     ON SF4.D_E_L_E_T_ = ' ' "
	cQuery += "    AND F4_FILIAL = ? " ;AAdd(aBindParam, FWXFilial("SF4", Self:cFilialUsada))
	cQuery += "    AND F4_CODIGO = D1_TES "

	cQuery += "   LEFT JOIN " + RetSqlName("SFT") + " SFT "
	cQuery += "     ON SFT.D_E_L_E_T_ = ' ' "
	cQuery += "    AND FT_FILIAL = ? " ;AAdd(aBindParam, FWXFilial("SFT", Self:cFilialUsada))
	cQuery += "    AND FT_TIPOMOV = 'E' "
	cQuery += "    AND FT_SERIE = F1_SERIE "
	cQuery += "    AND FT_NFISCAL = F1_DOC "
	cQuery += "    AND FT_CLIEFOR = D1_FORNECE "
	cQuery += "    AND FT_LOJA = D1_LOJA "
	cQuery += "    AND FT_ITEM = D1_ITEM "
	cQuery += "    AND FT_PRODUTO = D1_COD "

	cQuery += "   LEFT JOIN " + RetSqlName("SB5") + " SB5 "
	cQuery += "     ON SB5.D_E_L_E_T_ = ' ' "
	cQuery += "    AND B5_FILIAL = B1_FILIAL "
	cQuery += "    AND B5_COD = B1_COD "

	cQuery += "   LEFT JOIN " + RetSqlName("NP3") + " NP3 "
	cQuery += "     ON NP3.D_E_L_E_T_ = ' ' "
	cQuery += "    AND NP3_FILIAL = ? " ;AAdd(aBindParam, FWXFilial("NP3", Self:cFilialUsada))
	cQuery += "    AND NP3_CODIGO = NCR_CULTUR "

	cQuery += "  WHERE SF1.D_E_L_E_T_ = ' ' "
	cQuery += "    AND F1_FILIAL = ? " ;AAdd(aBindParam, cFilialSF1)
	cQuery += "    AND F1_TIPO = 'D' "
	cQuery += "    AND F1_CHVNFE <> ' ' "
	
	If !Empty(cDataIni)
		cQuery += "    AND F1_EMISSAO >= ? "
		AAdd(aBindParam, cDataIni)
	EndIf

	If !Empty(cDataFim)
		cQuery += "    AND F1_EMISSAO <= ? "
		AAdd(aBindParam, cDataFim)
	EndIf

	If !Empty(cFabricanteID)
		cQuery += "    AND LTRIM(RTRIM(FAB.A2_COD)) = ? "
		AAdd(aBindParam, SubStr(AllTrim(cFabricanteID), 1, TAMSX3("A2_COD")[1]))
	EndIf

	oStatement:SetQuery(cQuery)

	For nX := 1 To Len(aBindParam)
		oStatement:SetString(nParamPos++, aBindParam[nX])
	Next nX

	cQuery := ChangeQuery(oStatement:GetFixQuery())

Return cQuery

/*/{Protheus.doc} getFields
Define os campos do cabeçalho da nota fiscal de entrada.
@type method
@author rodrigo.nsoledade
@return array, mapeamento dos campos
/*/
Method getFields() As Array Class RebateInboundInvoiceRepository
	Local aFields := {}

	AAdd(aFields,{"codi_ven","RECNOSF1","N",.T.})
	AAdd(aFields,{"codi_rev","F1_FILIAL","C",.T.})
	AAdd(aFields,{"codi_fab","FABRICANTE","C",.T.})
	AAdd(aFields,{"modl_ven","MODELODOCUMENTO","C",.T.})
	AAdd(aFields,{"emit_ven","EMITENTEVENDA","C",.T.})
	AAdd(aFields,{"nume_ven","F1_DOC","C",.T.})
	AAdd(aFields,{"seri_ven","F1_SERIE","C",.T.})
	AAdd(aFields,{"chav_ven","F1_CHVNFE","C",.T.})
	AAdd(aFields,{"fina_ven","F1_TIPO","C",.T.})
	AAdd(aFields,{"data_ven","F1_EMISSAO","D",.T.})
	AAdd(aFields,{"datv_ven","DATAVENCIMENTO","D",.T.})
	AAdd(aFields,{"orig_ven","ORIGEMVENDA","C",.T.})
	AAdd(aFields,{"codi_con","CODIGOCONDICAO","C",.T.})
	AAdd(aFields,{"praz_con","PRAZOCONDICAO","C",.T.})
	AAdd(aFields,{"desc_con","DESCRICAOCONDICAO","C",.T.})
	AAdd(aFields,{"tipo_con","TIPOCONDICAO","C",.T.})
	AAdd(aFields,{"inde_ven","INDEXADORMOEDA","C",.T.})
	AAdd(aFields,{"dind_ven","DESCINDEXADORMOEDA","C",.T.})
	AAdd(aFields,{"bund_ven","UMINDEXADORMOEDA","C",.T.})
	AAdd(aFields,{"cota_ven","COTACAOINDEXADORMOEDA","N",.T.})
	AAdd(aFields,{"oper_ven","F4_CODIGO","C",.T.})
	AAdd(aFields,{"desc_opr","F4_TEXTO","C",.T.})
	AAdd(aFields,{"sina_opr","F4_TIPO","C",.T.})
	AAdd(aFields,{"cfop_ven","F4_CF","C",.T.})
	AAdd(aFields,{"stat_ven","STATUSNF","C",.T.})

	AAdd(aFields,{"codi_cli","CODIGOCLIENTE","C",.T.})
	AAdd(aFields,{"cnpj_cli","CLIENTECGC","C",.T.})
	AAdd(aFields,{"insc_cli","CLIENTEINSCR","C",.T.})
	AAdd(aFields,{"nome_cli","CLIENTENOME","C",.T.})
	AAdd(aFields,{"enco_cli","CLIENTEENDERECO","C",.T.})
	AAdd(aFields,{"bair_cli","CLIENTEBAIRRO","C",.T.})
	AAdd(aFields,{"comp_cli","CLIENTECOMPLEMENTO","C",.T.})
	AAdd(aFields,{"cepc_cli","CLIENTECEP","C",.T.})
	AAdd(aFields,{"muni_cli","CLIENTEMUNICIPIO","C",.T.})
	AAdd(aFields,{"estd_cli","CLIENTEESTADO","C",.T.})
	AAdd(aFields,{"ddd_cli","CLIENTEDDD","C",.T.})
	AAdd(aFields,{"tele_cli","CLIENTETELEFONE","C",.T.})
	AAdd(aFields,{"celu_cli","CLIENTETELEFONE","C",.T.})
	AAdd(aFields,{"emai_cli","CLIENTEEMAIL","C",.T.})
	AAdd(aFields,{"duma_cli","DATAULTIMAMOVIMENTACAODB","C",.T.})

	AAdd(aFields,{"codi_ved","CODIGOVENDEDOR","C",.T.})
	AAdd(aFields,{"nome_ved","NOMEVENDEDOR","C",.T.})
	AAdd(aFields,{"cpfc_ved","CGCVENDEDOR","C",.T.})
	AAdd(aFields,{"nasc_ved","NASCIMENTOVENDEDOR","D",.T.})
	AAdd(aFields,{"npis_ved","NPISVENDEDOR","C",.T.})

	AAdd(aFields,{"dest_ven","CGCDESTINATARIO","C",.T.})
	AAdd(aFields,{"enco_ivn","ENDERECOENTREGA","C",.T.})
	AAdd(aFields,{"bair_ivn","BAIRROENTREGA","C",.T.})
	AAdd(aFields,{"comp_ivn","COMPLEMENTOENTREGA","C",.T.})
	AAdd(aFields,{"cepc_ivn","CEPENTREGA","C",.T.})
	AAdd(aFields,{"muni_ivn","MUNICIPIOENTREGA","C",.T.})
	AAdd(aFields,{"estd_ivn","ESTADOENTREGA","C",.T.})
Return aFields

