#Include "totvs.ch"
#Include "tlpp-core.th"

namespace totvs.protheus.agrobusiness.agd


/*/{Protheus.doc} RebateProductRepository
Repository responsável pela consulta de produtos
do tipo devolução para integração de rebate.
@type class
@version 1.0
@author carlos.augusto
@since 29/07/2026
/*/
Class RebateProductRepository From UtilsRepository

	public method New()
	
	private method getFields() As Array
	private Method getJoins()  as array

EndClass

/*/{Protheus.doc} New
Construtor da classe.
@type method
@version 1.0
@author carlos.augusto
@since 29/07/2026
@return object, instância da classe
/*/
Method New() Class RebateProductRepository
	_Super:New('SB1', Self:getFields(), Self:getJoins())
Return Self


/*/{Protheus.doc} getFields
Define os campos do produto.
@type method
@author carlos.augusto
@since 29/07/2026
@return array, mapeamento dos campos
/*/
Method getFields() As Array Class RebateProductRepository
	Local aFields := {}

	AAdd(aFields, {"filial"       		 , "B1_FILIAL" , "C", .T.})
	
	AAdd(aFields, {"codigoProduto"       , "B1_COD"    , "C", .T.})
	AAdd(aFields, {"descricaoProduto"    , "B1_DESC"   , "C", .T.})
	AAdd(aFields, {"barCode"             , "B1_CODBAR" , "C", .T.})

	AAdd(aFields, {"codigoGrupo"         , "B1_GRUPO"  , "C", .T.})
	AAdd(aFields, {"descricaoGrupo"      , "BM_DESC"   , "C", .T.})

	AAdd(aFields, {"codigoTipo"          , "B1_TIPO"   , "C", .T.})
	AAdd(aFields, {"descricaoTipo"       , "X5_DESCRI" , "C", .T.})

	AAdd(aFields, {"fatorConversao"      , "B1_CONV"   , "N", .T.})

	AAdd(aFields, {"codigoFabricante"    , "NCR_FABCOD", "C", .T.})
	AAdd(aFields, {"lojaFabricante"      , "A2_LOJA"   , "C", .T.})
	AAdd(aFields, {"fabricanteCNPJ"      , "A2_CGC"    , "C", .T.})
	AAdd(aFields, {"descricaoFabricante" , "A2_NOME"   , "C", .T.})

	AAdd(aFields, {"codigoProdutoFabricante" , "A5_CODPRF" , "C", .T.})

	AAdd(aFields, {"codigoSubGrupo"      , "NF8_CODIGO", "C", .T.})
	AAdd(aFields, {"descricaoSubGrupo"   , "NF8_DESCRI", "C", .T.})
	

	AAdd(aFields, {"familia"             , "B1_TIPO"   , "C", .T.})
	AAdd(aFields, {"familiaDescricao"    , "X5_DESCRI" , "C", .T.})

Return aFields



/*/{Protheus.doc} getJoins
Relacionamentos entre tabelas para a consulta de produtos.
@type method
@author carlos.augusto
@since 29/07/2026
@return array, mapeamento dos campos
/*/
Method getJoins() as array class RebateProductRepository
	Local aJoin := {} as array

	aJoin := {;
		{"LEFT", "SX5", ::getWhereDefault("SX5.X5_TABELA = '02' AND SX5.X5_CHAVE = SB1.B1_TIPO", "SX5")},;
		{"LEFT", "SBM", ::getWhereDefault("SBM.BM_GRUPO = SB1.B1_GRUPO", "SBM")},;
		{"LEFT", "NF8", ::getWhereDefault("NF8.NF8_GRPPRD = SB1.B1_GRUPO", "NF8")},;
		{"LEFT", "NCR", ::getWhereDefault("NCR.NCR_PROD = SB1.B1_COD", "NCR")},;
		{"LEFT", "SA2", ::getWhereDefault("SA2.A2_COD = NCR.NCR_FABCOD AND SA2.A2_LOJA = NCR.NCR_FABLOJ", "SA2")},;
		{"LEFT", "SA5", ::getWhereDefault("SA5.A5_FORNECE = SA2.A2_COD AND SA5.A5_LOJA = SA2.A2_LOJA AND SA5.A5_PRODUTO = SB1.B1_COD", "SA5")};
		}

Return aJoin
