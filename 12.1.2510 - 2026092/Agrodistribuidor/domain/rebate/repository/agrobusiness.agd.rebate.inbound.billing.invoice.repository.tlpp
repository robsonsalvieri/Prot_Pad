#Include "totvs.ch"
#Include "tlpp-core.th"

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} RebateInboundBillingInvoiceRepository
Repository responsável pela consulta de notas fiscais de entrada
do tipo devolução para integração de rebate.
@type class
@version 1.0
@author gilson.venturi
@since 04/08/2026
/*/
Class RebateInboundBillingInvoiceRepository From UtilsRepository

	Public Method New()
	Public Method findInboundBillingInvoices(nPage,nPageSize,jQueryParams)

	Private Method buildInboundQuery() As Character
	Private Method getFields() As Array
	Private Method formatResponse(jResponse) As Object

EndClass

/*/{Protheus.doc} New
Construtor da classe.
@type method
@version 1.0
@author gilson.venturi
@since 04/08/2026
@return object, instância da classe
/*/
Method New() Class RebateInboundBillingInvoiceRepository
	_Super:New("SF1")
Return Self

/*/{Protheus.doc} findInboundBillingInvoices
Consulta notas fiscais de entrada do tipo devolução.
@type method
@version 1.0
@author gilson.venturi
@since 04/08/2026
@param nPage, numeric, número da página
@param nPageSize, numeric, quantidade de registros por página
@param jQueryParams, json, parâmetros da query string
/*/
Method findInboundBillingInvoices(nPage,nPageSize,jQueryParams) Class RebateInboundBillingInvoiceRepository
	Local cOrder := "F1_EMISSAO, F1_DOC, F1_SERIE"
	Local cQuery := ""
	Local jResponse As Object

	Default nPage := 1
	Default nPageSize := 10
	Default jQueryParams := Nil

	nPageSize := Min(nPageSize,200)
	cQuery := Self:buildInboundQuery()

	Self:setFieldsConsulta(Self:getFields())
	Self:setPage(nPage)
	Self:setPageSize(nPageSize)
	Self:SetQuery(Self:getQueryDefault(,cQuery))
	Self:SetWhere("1=1")
	self:SetUrlFilter(self:getFilterAdvancedQueryParam(jQueryParams))
	Self:SetUseSpaces(.F.)
	Self:SetOrder(cOrder)

	If Self:Execute()
		Self:FillGetResponse()

		If Self:lOk
			jResponse := Self:convertToJson(Self:getJSONResponse())
			Self:setSuccess(Self:formatResponse(jResponse))
		EndIf
	EndIf
Return Nil

/*/{Protheus.doc} buildInboundQuery
Monta a consulta das notas fiscais de entrada do tipo devolução.
@type method
@version 1.0
@author gilson.venturi
@since 04/08/2026
@return character, consulta SQL preparada
/*/
Method buildInboundQuery() As Character Class RebateInboundBillingInvoiceRepository
	Local cQuery := ""
	Local oStatement := FWPreparedStatement():New()
	Local nParamPos := 1

	cQuery += " SELECT YEAR(F1_EMISSAO) AS ANONOTA, "
    cQuery += "        CASE WHEN FT_DTCANC = ' ' THEN 'A' ELSE 'C' END AS STATUSNF, "
    cQuery += "        A2_TIPO, "
    cQuery += "        D1_CF, "
    cQuery += "        F1_CHVNFE AS MODELODOCUMENTO, "
    cQuery += "        F1_FORNECE, "
    cQuery += "        A2_CGC, "
    cQuery += "        NEX_CODCLI, "
    cQuery += "        F1_COND, "
    cQuery += "        NCR_CULTUR, "
    cQuery += "        B2_CM1, "
    cQuery += "        B1_CUSTD, "
    cQuery += "        F1_EMISSAO, "
    cQuery += "        'S' AS AGROVIEW, "
    cQuery += "        CONCAT(NCR_FABCOD, CONCAT('.', NCR_FABLOJ)) AS FABRICANTE, "
    cQuery += "        ' ' AS FAMILIAPRODUTO, "
    cQuery += "        F1_FILIAL, "
    cQuery += "        '' AS GERENTE, "
    cQuery += "        B1_GRUPO, "
    cQuery += "        MONTH(F1_EMISSAO) AS MESNOTA, "
    cQuery += "        F1_DOC, "
    cQuery += "        '' AS OPERACAO, "
    cQuery += "        D1_PEDIDO, "
    cQuery += "        D1_COD, "
    cQuery += "        NJU_CODSAF, "
    cQuery += "        NJU_DTFIM, "
    cQuery += "        NJU_DTINI, "
    cQuery += "        F1_SERIE, "
    cQuery += "        'COMPRA' AS SITFATUR, "
    cQuery += "        NF8_CODIGO, "
    cQuery += "        B1_TIPO, "
    cQuery += "        FT_TOTAL, "
    cQuery += "        D1_VUNIT, "
    cQuery += "        '' AS VENDEDOR, "
    cQuery += "        D1_QUANT "
	cQuery += "   FROM " + RetSqlName("SF1") + " SF1 "

	cQuery += "  INNER JOIN " + RetSqlName("SD1") + " SD1 "
	cQuery += "     ON SD1.D_E_L_E_T_ = ' ' "
	cQuery += "    AND D1_FILIAL = F1_FILIAL "
	cQuery += "    AND D1_DOC = F1_DOC "
	cQuery += "    AND D1_SERIE = F1_SERIE "
	cQuery += "    AND D1_FORNECE = F1_FORNECE "
	cQuery += "    AND D1_LOJA = F1_LOJA "

	cQuery += "  INNER JOIN " + RetSqlName("SB1") + " SB1 "
	cQuery += "     ON SB1.D_E_L_E_T_ = ' ' "
	cQuery += "    AND B1_FILIAL = ? "
	cQuery += "    AND B1_COD = D1_COD "

	cQuery += "  INNER JOIN " + RetSqlName("SB2") + " SB2 "
	cQuery += "     ON SB2.D_E_L_E_T_ = ' ' "
	cQuery += "    AND B2_FILIAL = ? "
	cQuery += "    AND B2_COD = D1_COD "
	cQuery += "    AND B2_LOCAL = D1_LOCAL "

	cQuery += "  INNER JOIN " + RetSqlName("SA2") + " SA2 "
	cQuery += "     ON SA2.D_E_L_E_T_ = ' ' "
	cQuery += "    AND A2_FILIAL = ? "
	cQuery += "    AND A2_COD = F1_FORNECE "
	cQuery += "    AND A2_LOJA = F1_LOJA "

	cQuery += "  INNER JOIN " + RetSqlName("NCR") + " NCR "
	cQuery += "     ON NCR.D_E_L_E_T_ = ' ' "
	cQuery += "    AND NCR_FILIAL = B1_FILIAL "
	cQuery += "    AND NCR_PROD = D1_COD "

	cQuery += "   LEFT JOIN " + RetSqlName("NF8") + " NF8 "
	cQuery += "     ON NF8.D_E_L_E_T_ = ' ' "
	cQuery += "    AND NF8_FILIAL = ? "
	cQuery += "    AND NF8_GRPPRD = B1_GRUPO "

	cQuery += "   LEFT JOIN " + RetSqlName("NJU") + " NJU "
	cQuery += "     ON NJU.D_E_L_E_T_ = ' ' "
	cQuery += "    AND NJU_FILIAL = ? "
	cQuery += "    AND NJU_CODSAF = D1_CODSAF "

	cQuery += "   LEFT JOIN " + RetSqlName("NEX") + " NEX "
	cQuery += "     ON NEX.D_E_L_E_T_ = ' ' "
	cQuery += "    AND NEX_FILIAL = ? "
	cQuery += "    AND NEX_CODCLI = A2_COD "
	cQuery += "    AND NEX_LOJCLI = A2_LOJA "
	cQuery += "    AND NEX_PRINCI = '1' "

	cQuery += "  LEFT JOIN " + RetSqlName("SFT") + " SFT "
	cQuery += "     ON SFT.D_E_L_E_T_ = ' ' "
	cQuery += "    AND FT_FILIAL = ? "
	cQuery += "    AND FT_TIPOMOV = 'E' "
	cQuery += "    AND FT_SERIE = F1_SERIE "
	cQuery += "    AND FT_NFISCAL = F1_DOC "
	cQuery += "    AND FT_CLIEFOR = D1_FORNECE "
	cQuery += "    AND FT_LOJA = D1_LOJA "
	cQuery += "    AND FT_ITEM = D1_ITEM "
	cQuery += "    AND FT_PRODUTO = D1_COD "

	cQuery += "  WHERE SF1.D_E_L_E_T_ = ' ' "
	cQuery += "    AND F1_FILIAL = ? "
	cQuery += "    AND F1_TIPO = 'D' "
	cQuery += "    AND F1_CHVNFE <> ' ' "

	oStatement:SetQuery(cQuery)
	oStatement:SetString(nParamPos++,FWXFilial("SB1"))
	oStatement:SetString(nParamPos++,FWXFilial("SB2"))
	oStatement:SetString(nParamPos++,FWXFilial("SA2"))
	oStatement:SetString(nParamPos++,FWXFilial("NF8"))
	oStatement:SetString(nParamPos++,FWXFilial("NJU"))
	oStatement:SetString(nParamPos++,FWXFilial("NEX"))
	oStatement:SetString(nParamPos++,FWXFilial("SFT"))
	oStatement:SetString(nParamPos++,FWXFilial("SF1"))

	cQuery := ChangeQuery(oStatement:GetFixQuery())
Return cQuery

/*/{Protheus.doc} getFields
Define os campos do cabeçalho da nota fiscal de entrada.
@type method
@author gilson.venturi
@since 04/08/2026
@return array, mapeamento dos campos
/*/
Method getFields() As Array Class RebateInboundBillingInvoiceRepository
	Local aFields := {}

	AAdd(aFields,{"FaturamentoAno",              "ANONOTA",        "N", .T.})
	AAdd(aFields,{"FaturamentoCancelado",        "STATUSNF",       "C", .T.})
	AAdd(aFields,{"FaturamentoCategoriaCliente", "A2_TIPO",        "C", .T.})
	AAdd(aFields,{"FaturamentoCFOP",             "D1_CF",          "C", .T.})
	AAdd(aFields,{"FaturamentoChaveNF",          "MODELODOCUMENTO","C", .T.})
	AAdd(aFields,{"FaturamentoCliente",          "F1_FORNECE",     "C", .T.})
	AAdd(aFields,{"FaturamentoClienteCPFCNPJ",   "A2_CGC",         "C", .T.})
	AAdd(aFields,{"FaturamentoClientePrincipal", "NEX_CODCLI",     "C", .T.})
	AAdd(aFields,{"FaturamentoCondicaoPagamento","F1_COND",        "C", .T.})
	AAdd(aFields,{"FaturamentoCultura",          "NCR_CULTUR",     "C", .T.})
	AAdd(aFields,{"FaturamentoCustoMedio",       "B2_CM1",         "N", .T.})
	AAdd(aFields,{"FaturamentoCustoUnitario",    "B1_CUSTD",       "N", .T.})
	AAdd(aFields,{"FaturamentoData",             "F1_EMISSAO",     "D", .T.})
	AAdd(aFields,{"FaturamentoExibirAgroview",   "AGROVIEW",       "C", .T.})
	AAdd(aFields,{"FaturamentoFabricante",       "FABRICANTE",     "C", .T.})
	AAdd(aFields,{"FaturamentoFamilia",          "FAMILIAPRODUTO", "C", .T.})
	AAdd(aFields,{"FaturamentoFilial",           "F1_FILIAL",      "C", .T.})
	AAdd(aFields,{"FaturamentoGerente",          "GERENTE",        "C", .T.})
	AAdd(aFields,{"FaturamentoGrupo",            "B1_GRUPO",       "C", .T.})
	AAdd(aFields,{"FaturamentoMes",              "MESNOTA",        "N", .T.})
	AAdd(aFields,{"FaturamentoNumeroNF",         "F1_DOC",         "C", .T.})
	AAdd(aFields,{"FaturamentoOperacao",         "OPERACAO",       "C", .T.})
	AAdd(aFields,{"FaturamentoPedido",           "D1_PEDIDO",      "C", .T.})
	AAdd(aFields,{"FaturamentoProduto",          "D1_COD",         "C", .T.})
	AAdd(aFields,{"FaturamentoSafra",            "NJU_CODSAF",     "C", .T.})
	AAdd(aFields,{"FaturamentoSafraFim",         "NJU_DTFIM",      "D", .T.})
	AAdd(aFields,{"FaturamentoSafraInicio",      "NJU_DTINI",      "D", .T.})
	AAdd(aFields,{"FaturamentoSerieNF",          "F1_SERIE",       "C", .T.})
	AAdd(aFields,{"FaturamentoSituacao",         "SITFATUR",       "C", .T.})
	AAdd(aFields,{"FaturamentoSubgrupo",         "NF8_CODIGO",     "C", .T.})
	AAdd(aFields,{"FaturamentoTipoProduto",      "B1_TIPO",        "C", .T.})
	AAdd(aFields,{"FaturamentoValorBrutoItem",   "FT_TOTAL",       "N", .T.})
	AAdd(aFields,{"FaturamentoValorItem",        "D1_VUNIT",       "N", .T.})
	AAdd(aFields,{"FaturamentoVendedor",         "VENDEDOR",       "C", .T.})
	AAdd(aFields,{"FaturamentoVolumeEmbalagem",  "D1_QUANT",       "N", .T.})
	AAdd(aFields,{"FaturamentoVolumeItem",       "D1_QUANT",       "N", .T.})

Return aFields


/*/{Protheus.doc} formatResponse
Formata campos derivados, preenche dados da filial e aplica
proteção aos dados do emitente da devolução.
@type method
@author gilson.venturi
@since 04/08/2026
@param jResponse, json, resposta da consulta
@return object, resposta formatada
/*/
Method formatResponse(jResponse) As Object Class RebateInboundBillingInvoiceRepository
	Local jItem As Object
	Local aItems := {} as Array
	Local aProtectedFields as Array
	Local aAllowedFields as Array
	Local aProtectedMap as Array
	Local aSM0Data := {}
	Local aJsonFields := {}
	Local nItem := 0
	Local nField := 0
	Local nJsonField := 0

	aItems := jResponse["items"]
	aProtectedFields := {"A2_CGC"}
	aAllowedFields := FwProtectedDataUtil():UsrAccessPDField(__cUserID,aProtectedFields)
	aProtectedMap := {;
		{"A2_CGC" ,{"FaturamentoClienteCPFCNPJ","FaturamentoFilialCPFCNPJ"}}}

	For nItem := 1 To Len(aItems)
		jItem := aItems[nItem]
		aSM0Data := FWSM0Util():GetSM0Data(cEmpAnt,jItem["FaturamentoFilial"],{"M0_CODMUN"})
		jItem["FaturamentoMunicipioIBGE"] := IIf(Len(aSM0Data) > 0,AllTrim(aSM0Data[1][2]),"")

		For nField := 1 To Len(aProtectedMap)
			If AScan(aAllowedFields,aProtectedMap[nField][1]) == 0
				aJsonFields := aProtectedMap[nField][2]

				For nJsonField := 1 To Len(aJsonFields)
					If jItem:HasProperty(aJsonFields[nJsonField])
						jItem[aJsonFields[nJsonField]] := FwProtectedDataUtil():ValueAsteriskToAnonymize(jItem[aJsonFields[nJsonField]])
					EndIf
				Next nJsonField
			EndIf
		Next nField
	Next nItem

	jResponse["items"] := aItems
Return jResponse
