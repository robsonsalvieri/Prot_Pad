#include 'totvs.ch'
#include 'tlpp-core.th'
#include 'fwmvcdef.ch'
#include 'agrobusiness.agd.rebate.processed.repository.ch'

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} RebateProcessedRepository
Repositorio do dados processados de Rebate
@type class
@version 12
@author lindembergson.pacheco
@since 17/08/2026
/*/
class RebateProcessedRepository from UtilsRepository
	public data cChaveIDRepository as character

	public method new()
	public method getFields()		as array

	public method getDadosProcessados()     as array

endclass

/*/{Protheus.doc} RebateProcessedRepository::new
Constructor
@type method
@version 12
@author lindembergson.pacheco
@since 17/08/2026
@param pcChaveIDRepository, character, chave
@return object, instancia da classe
/*/
method new(pcChaveIDRepository as character) class RebateProcessedRepository
	::cChaveIDRepository := pcChaveIDRepository
	_Super:New("NFA", ::getFields())
return self

/*/{Protheus.doc} RebateProcessedRepository::getFields
Retorna os campos do repositorio
@type method
@version 12
@author lindembergson.pacheco
@since 17/08/2026
@return array, {{campoJson, campoProtheus, tipoCampo, lShowField}, ...}
/*/
method getFields() as array class RebateProcessedRepository
	local aFields as array

	aFields := {;
		{'filial'  			, 'NFA_FILIAL', 'C', .T.},;
		{'identificador'	, 'NFA_IDENT', 'C', .T.},;
		{'entidade'    		, 'NFA_ENTIDA', 'C', .T.},;
		{'dataExecucao'    	, 'NFA_DTREG', 'D', .T.},;
		{'dados'    		, 'NFA_DADOS', 'C', .T.},;
		{'filialExecucao'	, 'NFA_FILORI', 'C', .T.}}
return aFields



/*/{Protheus.doc} getDadosProcessados
Busca registros de De-Para para Armazem
@type method
@version 12
@author lindembergson.pacheco
@since 17/08/2026
@param jIdent    , character, Identificador
@param jRota     , character, Rota
@param jFilial   , character, Filial
@param jDataIni  , character, Data inicial
@param jDataFim  , character, Data final
/*/
Method getDadosProcessados(jIdent, jRota, jFilial, jDataIni, jDataFim) as array class RebateProcessedRepository

	Local cQuery	as character
	Local cAlias	as character
	Local aResult	as array
	Local oJson		as object
	Local oLinha	as object
	Local oItem		as object
	Local aKeys		as array
	Local cJson		as character
	Local cErro		as character
	Local cKey		as character
	Local nItem		:= 0
	Local nKey		:= 0

	cQuery := "SELECT "
	cQuery += "    NFA.NFA_FILIAL, "
	cQuery += "    NFA.NFA_IDENT, "
	cQuery += "    NFA.NFA_ENTIDA, "
	cQuery += "    NFA.NFA_CHAVE, "
	cQuery += "    NFA.NFA_SEQUEN, "
	cQuery += "    NFA.NFA_ROTA, "
	cQuery += "    NFA.NFA_FILORI, "
	cQuery += "    NFA.NFA_DTREG, "
	cQuery += "    NFA.NFA_DADOS "
	cQuery += "FROM " + RetSQLName("NFA") + " NFA "
	cQuery += "WHERE NFA.D_E_L_E_T_ = ' ' "

	If !Empty(jIdent)
		cQuery += " AND NFA.NFA_IDENT = '" + jIdent + "' "
	EndIf

	If !Empty(jRota)
		cQuery += " AND NFA.NFA_ROTA = '" + jRota + "' "
	EndIf

	If !Empty(jFilial)
		cQuery += " AND NFA.NFA_FILORI = '" + jFilial + "' "
	EndIf

	If !Empty(jDataIni) .And. !Empty(jDataFim)
		cQuery += " AND NFA.NFA_DTREG BETWEEN '" + jDataIni + "' AND '" + jDataFim + "' "
	EndIf

	cQuery += " ORDER BY NFA.NFA_FILORI, NFA.NFA_IDENT, NFA.NFA_DTREG, NFA.NFA_SEQUEN "

	cQuery := ChangeQuery(cQuery)
	cAlias := MPSysOpenQuery(cQuery)

	aResult := {}

	While (cAlias)->(!EOF())

		cJson := AllTrim((cAlias)->NFA_DADOS)

		If !Empty(cJson)

			oLinha := JsonObject():New()

			cErro := oLinha:FromJSON(cJson)

			If Empty(cErro)

				For nItem := 1 To Len(oLinha)

					oItem := oLinha[nItem]

					// Remove espacos dos campos Character
					aKeys := oItem:GetNames()

					For nKey := 1 To Len(aKeys)

						cKey := aKeys[nKey]

						If ValType(oItem[cKey]) == "C"
							oItem[cKey] := AllTrim(oItem[cKey])
						EndIf

					Next

					AAdd(aResult, oItem)

				Next

			Else
				Self:setError(i18n(STR0001, {AllTrim((cAlias)->NFA_CHAVE), AllTrim((cAlias)->NFA_SEQUEN)}) , 400) //"Json mal formatado. Chave: #1[CODIGO_CHAVE]#  Sequencia: #2[CODIGO_SEQ]#"
				return
			EndIf

		EndIf

		(cAlias)->(DbSkip())

	End

	(cAlias)->(DbCloseArea())

	oJson := JsonObject():New()
	oJson:Set(aResult)
	Self:setSuccess(oJson)

Return nil
