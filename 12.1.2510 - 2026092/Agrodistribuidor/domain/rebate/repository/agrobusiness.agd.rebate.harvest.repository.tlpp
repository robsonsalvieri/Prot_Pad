#include 'totvs.ch'
#include 'tlpp-core.th'
#include 'fwmvcdef.ch'

namespace totvs.protheus.agrobusiness.agd  

/*/{Protheus.doc} RebateHarvestRepository
Repositorio de Safras (Tabela NJU)
@type class
@version 12
@author ronery.filho
@since 31/07/2026
/*/
class RebateHarvestRepository from UtilsRepository
	public method new()
	public method save() as logical

	private method getFields() as array
endclass

/*/{Protheus.doc} RebateHarvestRepository::New
Construtor
@type method
@version 12
@author ronery.filho
@since 31/07/2026
@return object, self
/*/
method new() class RebateHarvestRepository
	_Super:new('NJU', ::getFields())
return self

/*/{Protheus.doc} RebateHarvestRepository::getFields
Retorna os campos que serao utilizados no AddMapFields da classe FWAdapterBaseV2
@type method
@version 12
@author ronery.filho
@since 31/07/2026
@return array, {{cCampoJson, cCampoTabela, cTipoCampo, lJsonField|lFixed}, ...}
/*/
method getFields() as array class RebateHarvestRepository
	local aFields as array

	aFields := {;
		{'filial'   		, 'NJU_FILIAL'	, 'C', .T.},;
		{'safraCodigo'     	, 'NJU_CODSAF'	, 'C', .T.},;
		{'safraDescricao'   , 'NJU_DESCRI'	, 'C', .T.},;
		{'safraFim' 		, 'NJU_DTFIM'	, 'D', .T.},;
		{'safraInicio' 		, 'NJU_DTINI'	, 'D', .T.};
		}
return aFields
