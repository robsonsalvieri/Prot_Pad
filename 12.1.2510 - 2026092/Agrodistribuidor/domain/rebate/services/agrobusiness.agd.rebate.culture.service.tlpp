#include 'totvs.ch'
#include 'tlpp-core.th'

namespace totvs.protheus.agrobusiness.agd  

/*/{Protheus.doc} RebateCultureService
Serviço de culturas.
@type class
@version 12
@author ronery.filho
@since 31/07/2026
/*/
class RebateCultureService from UtilsService
	public method new()
	public method listar()
endclass

/*/{Protheus.doc} RebateCultureService::new
Construtor
@type method
@version 12
@author ronery.filho
@since 31/07/2026
@return object, self
/*/
method new() class RebateCultureService
	_Super:New()
return self

/*/{Protheus.doc} RebateCultureService::listar
Listagem dos registros da tabela
@type method
@version 12
@author ronery.filho
@since 31/07/2026
@param nPage, numeric, numero da pagina
@param nPageSize, numeric, tamanho da pagina
@param jQueryParam, json, query
/*/
method listar(nPage as numeric, nPageSize as numeric, jQueryParam as json) class RebateCultureService
	local oCultureRepo as object
	
    default nPage       := 1
	default nPageSize   := 10
	default jQueryParam := nil

	If !Self:isSIGAAGDActive()
		return Nil
	endif

	oCultureRepo := RebateCultureRepository():New()
	oCultureRepo:find(nPage, nPageSize, jQueryParam)

	::setFullResponse(oCultureRepo)

	FreeObj(oCultureRepo)
return
