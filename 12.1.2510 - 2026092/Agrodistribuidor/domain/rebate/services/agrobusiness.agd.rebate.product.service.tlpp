#include 'totvs.ch'
#include 'tlpp-core.th'

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} RebateProductService
Service responsavel pela consulta dos produtos e estoque de produtos utilizados na integração de rebate.
@type class
@version 12
@author carlos.augusto/rodrigo.nsoledade
@since 29/07/2026
/*/
class RebateProductService from UtilsService
	public method new()
	public method findProducts(nPage, nPageSize, jQueryParam)
	public method findProductStock(nPage,nPageSize,jQueryParams)
	public method findStockPosition(nPage,nPageSize,jQueryParams)
endclass

/*/{Protheus.doc} new
Construtor
@type method
@version 12
@author carlos.augusto/rodrigo.nsoledade
@since 28/07/2026
@return object, self
/*/
method new() class RebateProductService
	_Super:New()
return self

/*/{Protheus.doc} RebateProductService::findProducts
Lista os produtos para a integração de rebate
@type method
@version 12
@author carlos.augusto
@since 29/07/2026
@param nPage, numeric, numero da pagina
@param nPageSize, numeric, tamanho da pagina
@param jQueryParams, json, parametros da consulta
/*/
method findProducts(nPage,nPageSize,jQueryParams) class RebateProductService
	Local oRebateProductRepository as Object
	Local oResponse as Object
	Local jItem     as Object
	Local jItemPE   as Object
	Local nX 	 	:= 0
	Local nY 	 	:= 0
	Local aItems 	:= {}
	Local lAGDPE002 := ExistBlock("AGDPE002")
	
	Local aAllowedFields   := FwProtectedDataUtil():UsrAccessPDField(__cUserID, {"A2_NOME","A2_CGC"})
	Local aProtectedMap    := {{"A2_NOME","descricaoFabricante"},{"A2_CGC","fabricanteCNPJ"}}
	Local cAtribAnonimizar := ""
	Local nField 		   := 0

	Default nPage     	 := 1
	Default nPageSize 	 := 10
	Default jQueryParams := nil

	If !Self:isSIGAAGDactive()
		Return Nil
	EndIf

	oRebateProductRepository := RebateProductRepository():New()
	oRebateProductRepository:find(nPage, nPageSize, jQueryParams)

	If oRebateProductRepository:isSuccess()
		oResponse := oRebateProductRepository:getResponse()
		aItems := aClone(oResponse['items'])

        For nX := 1 to Len(oResponse['items'])
			jItem := oResponse['items'][nX]

			//Anonimiza os campos protegidos
			For nField := 1 To Len(aProtectedMap)
				If AScan(aAllowedFields,aProtectedMap[nField][1]) == 0
					cAtribAnonimizar := aProtectedMap[nField][2]
					If !Empty(jItem:GetJsonObject( cAtribAnonimizar )) 

						If jItem:HasProperty(cAtribAnonimizar)
							jItem[cAtribAnonimizar] := FwProtectedDataUtil():ValueAsteriskToAnonymize( jItem:GetJsonObject( cAtribAnonimizar )  )
						EndIf
					EndIf

				EndIf
			Next nField
			//Fim anonimização

			If lAGDPE002
            	jItemPE := ExecBlock("AGDPE002",.f.,.f., aItems[nX] )
				If ValType(jItemPE) != "J"
					Loop
				EndIf

				For nY := 1 to Len(jItemPE:GetNames())
					If !jItem:hasProperty(jItemPE:GetNames()[nY])
						jItem[jItemPE:GetNames()[nY]] := jItemPE:GetJsonObject( jItemPE:GetNames()[nY] )
					EndIf
				Next nY
			EndIf
	
        Next nX
	EndIf

	Self:setFullResponse(oRebateProductRepository)

	FWFreeObj(oRebateProductRepository)

Return Nil

/*/{Protheus.doc} findProductStock
Consulta os dados de estoque dos produtos.
@type method
@version 12
@author rodrigo.nsoledade
@since 28/07/2026
@param nPage, numeric, número da página
@param nPageSize, numeric, quantidade de registros por página
@param jQueryParams, json, parâmetros da query string
/*/
Method findProductStock(nPage,nPageSize,jQueryParams) Class RebateProductService
	Local oProductRepository As Object
	Local oResponse          As Object
	Local aItems             := {} As Array
	Local nX 				 := 0
	Local nY 				 := 0
	Local jItem    			 as Object
	Local jItemPE  			 as Object

	If !Self:isSIGAAGDactive()
		Return Nil
	EndIf

	oProductRepository := RebateProductStockRepository():New()
	oProductRepository:findProductStock(nPage,nPageSize,jQueryParams)

	If !oProductRepository:isSuccess()
		Self:setFullResponse(oProductRepository)
		FWFreeObj(oProductRepository)
		Return Nil
	EndIf

	If ExistBlock("AGDPE003")

		oResponse := oProductRepository:getResponse()
		aItems := aClone(oResponse['items'])

        For nX := 1 to Len(oResponse['items'])
			jItem := oResponse['items'][nX]
            jItemPE := ExecBlock("AGDPE003",.f.,.f., aItems[nX] )

			If ValType(jItemPE) != "J"
				Loop
			EndIf

			For nY := 1 to Len(jItemPE:GetNames())
				If !jItem:hasProperty(jItemPE:GetNames()[nY])
					jItem[jItemPE:GetNames()[nY]] := jItemPE:GetJsonObject( jItemPE:GetNames()[nY] )
				EndIf
			Next nY
	
        Next nX
    EndIf

    Self:setFullResponse(oProductRepository)

    FWFreeObj(oProductRepository)
Return Nil

/*/{Protheus.doc} findStockPosition
Consulta a posição consolidada de estoque dos produtos conforme o layout
específico da integração de rebate.
@type method
@version 12
@author rodrigo.nsoledade
@since 03/08/2026
@param nPage, numeric, número da página
@param nPageSize, numeric, quantidade de registros por página
@param jQueryParams, json, parâmetros da query string
/*/
Method findStockPosition(nPage,nPageSize,jQueryParams) Class RebateProductService
	Local oProductRepository As Object

	If !Self:isSIGAAGDactive()
		Return Nil
	EndIf

	oProductRepository := RebateProductStockRepository():New()
	oProductRepository:findStockPosition(nPage,nPageSize,jQueryParams)

	Self:setFullResponse(oProductRepository)

	FWFreeObj(oProductRepository)
Return Nil
