#include 'totvs.ch'
#include 'tlpp-core.th'
#include 'agrobusiness.agd.salesman.integration.service.ch'

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} SalesmanIntegrationService
Classe de serviço responsavel pela regra de negócio da API de consulta de vendedores destinados a integração de rebate.
@type class
@author beatriz.dantas
@since 17/07/2026
@version p12
/*/
class SalesmanIntegrationService from UtilsService
	public method new()
	public method listSalesman()
endClass

/*/{Protheus.doc} new
Construtor da classe SalesmanIntegrationService.
@type method
@author beatriz.dantas
@since 17/07/2026
@version p12
@param param_name, param_type, param_descr
@return return_var, return_type, return_description
/*/
method new() class SalesmanIntegrationService
	_Super:new()
return Self

/*/{Protheus.doc} listarPedidos
Executa a consulta dos pedidos de venda e compra para integração de rebate.
@type method
@author beatriz.dantas
@since 20/07/2026
@version p12
@param param_name, param_type, param_descr
@return return_var, return_type, return_description
/*/
method listSalesman(nPage, nPageSize, jQueryParams) class SalesmanIntegrationService
	Local oRepository    as object 
	
    Default nPage        := 1
	Default nPageSize    := 10
	Default jQueryParams := nil

	If !(::isSIGAAGDactive())
		Self:setError(STR0001, 403) //"Módulo SIGAAGD não está ativo."
		return nil
	EndIf

	oRepository := SalesmanIntegrationRepository():New()
	oRepository:find(nPage,nPageSize,jQueryParams)

	Self:setFullResponse(oRepository)

	oRepository:DeActivate()
	FreeObj(oRepository)
Return nil
