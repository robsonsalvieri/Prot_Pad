#Include "totvs.ch"
#Include "tlpp-core.th"

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} CityService
Camada de serviço responsável pelas regras de negócio da API de municípios
para integração de rebate.
@type class
@author felipe.savelar
@since 30/07/2026
/*/
Class CityService From UtilsService

    Public Method New() Constructor
    Public Method listCities( nPage As Numeric, nPageSize As Numeric, jParams As Json )

EndClass

/*/{Protheus.doc} New
Construtor da classe CityService.
@type method
@author felipe.savelar
@since 30/07/2026
@return object, instância da classe
/*/
Method New() Class CityService
Return Self

/*/{Protheus.doc} listCities
Responsável por validar o ambiente e solicitar ao repository
a consulta dos municípios.
@type method
@author felipe.savelar
@since 30/07/2026   
@param nPage, numeric, número da página
@param nPageSize, numeric, quantidade de registros por página
@param jParams, json, parâmetros de filtro e ordenação
@return variant, nil
/*/
Method listCities( nPage As Numeric, nPageSize As Numeric, jParams As Json ) Class CityService

    Local oRepository As Object

    If ! Self:isSIGAAGDactive()
        Return Nil
    EndIf

    oRepository := CityRepository():New()
    oRepository:find(nPage, nPageSize, jParams)

    Self:setFullResponse(oRepository)

    FWFreeObj(oRepository)
Return
