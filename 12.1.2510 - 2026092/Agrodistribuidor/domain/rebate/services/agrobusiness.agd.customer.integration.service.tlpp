#Include "totvs.ch"
#Include "tlpp-core.th"

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} CustomerIntegrationService
Camada de serviço responsável pelas regras de negócio da API de integração
de clientes utilizada pelas empresas Bayer, Corteva e Syngenta.
@type class
@author Rodrigo N. Soledade
@since 17/07/2026
/*/
Class CustomerIntegrationService From UtilsService

    Public Method New() Constructor
    Public Method listCustomers( nPage As Numeric, nPageSize As Numeric, jParams As Json ) As Json

EndClass

/*/{Protheus.doc} New
Construtor da classe CustomerIntegrationService
@return object
/*/
Method New() Class CustomerIntegrationService
Return Self

/*/{Protheus.doc} listCustomers
Responsável por validar o ambiente e solicitar ao repository
a consulta dos clientes.
@author rodrigo.nsoledade
@since 17/07/2026
@param nPage
@param nPageSize
@param jParams
@return Json
/*/
Method listCustomers(nPage, nPageSize, jParams) Class CustomerIntegrationService
    Local oRepository     As Object

	If ! Self:isSIGAAGDactive()
		return nil
	EndIf

    oRepository := CustomerIntegrationRepository():New()
    oRepository:find(nPage, nPageSize, jParams)

    Self:setFullResponse(oRepository)

Return
