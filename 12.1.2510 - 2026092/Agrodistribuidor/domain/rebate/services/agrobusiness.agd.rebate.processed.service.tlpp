#include "totvs.ch"
#include 'tlpp-core.th'

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} RebateProcessedService
Classe de serviços para dados processados de Rebate
@type class
@version 12
@author lindembergson.pacheco
@since 17/08/2026
/*/
class RebateProcessedService FROM UtilsService
	public method new()
	public method getDadosProcessados()
endClass

/*/{Protheus.doc} new
Construtor
@type method
@version 12
@author lindembergson.pacheco
@since 17/08/2026
@return object, Instancia da classe
/*/
method new() class RebateProcessedService
	_Super:New()
return Self


/*/{Protheus.doc} getDadosProcessados
Buscar registros processados
@type method
@version 12
@author lindembergson.pacheco
@since 17/08/2026
@param jIdent    , character, Identificador
@param jRota     , character, Rota
@param jFilial   , character, Filial
@param jDataIni  , character, Data inicial
@param jDataFim  , character, Data final
@return variant, nil
/*/
method getDadosProcessados(jIdent, jRota, jFilial, jDataIni, jDataFim ) class RebateProcessedService
	Local oRepository		As object

	oRepository := RebateProcessedRepository():New()
	oRepository:getDadosProcessados(jIdent, jRota, jFilial, jDataIni, jDataFim)
	Self:setFullResponse(oRepository)

	oRepository:DeActivate()
	FreeObj(oRepository)
return nil
