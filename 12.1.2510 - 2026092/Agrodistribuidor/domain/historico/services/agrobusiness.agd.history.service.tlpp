#include 'totvs.ch'
#include 'tlpp-core.th'

namespace totvs.protheus.agrobusiness.agd  

/*/{Protheus.doc} HistoryService
Serviço de historicos
@type class
@version 12
@author jc.maldonado
@since 20/05/2025
/*/
class HistoryService from UtilsService
	public method new()
	public method listar()
	public method registrar()
endclass

/*/{Protheus.doc} HistoryService::new
Construtor
@type method
@version 12
@author jc.maldonado
@since 20/05/2025
@return object, self
/*/
method new() class HistoryService
	_Super:New()
return self

/*/{Protheus.doc} HistoryService::listar
Listagem dos registros da tabela
@type method
@version 12
@author jc.maldonado
@since 20/05/2025
@param nPage, numeric, numero da pagina
@param nPageSize, numeric, tamanho da pagina
@param jQueryParam, json, query
/*/
method listar(nPage as numeric, nPageSize as numeric, jQueryParam as json) class HistoryService
	local oHistoricoRepo as object
	
    default nPage       := 1
	default nPageSize   := 10
	default jQueryParam := nil

	oHistoricoRepo := HistoryRepository():New()
	oHistoricoRepo:find(nPage, nPageSize, jQueryParam)

	::setFullResponse(oHistoricoRepo)

	FreeObj(oHistoricoRepo)
return

/*/{Protheus.doc} HistoryService::registrar
Registra um novo log
@type method
@version 12
@author thomaz.coelho
@since 23/07/2026
@param cTabela, character, Alias da tabela
@param cChave, character, Chave para tabela
@param nOperation, numeric, Operação 3 = Inclusão, 4 = Alteração e 5 = Remoção 
@param cCodUsuario, character, Código do usuário
@param cMsgMemo, character, Mensagem de observação
@param nSeq, numeric, Sequência para o log
@param cAcaoCustom, character, Ação customizada para o log
/*/
method registrar(cTabela as character, cChave as character, nOperation as integer, cCodUsuario as character, cMsgMemo as character, cAcaoCustom as character, nSeq as numeric) class HistoryService
	local oHistoricoRepo as object

	default cMsgMemo    := ""
	default cCodUsuario := RetCodUsr()
	default cAcaoCustom := ""
	default nSeq        := 0

	oHistoricoRepo := HistoryRepository():New()
	oHistoricoRepo:save(cTabela, cChave, nOperation, cCodUsuario, cMsgMemo, cAcaoCustom, nSeq)

	::setFullResponse(oHistoricoRepo)

	FreeObj(oHistoricoRepo)
return
