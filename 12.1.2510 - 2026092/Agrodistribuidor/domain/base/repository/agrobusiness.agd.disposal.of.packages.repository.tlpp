#include 'tlpp-core.th'
#include 'totvs.ch'

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} DisposalOfPackagesRepository
Repositório de Descarte de Embalagens - Tabela NEO
@type class
@version 12
@author jc.maldonado
@since 13/05/2026
/*/
class DisposalOfPackagesRepository from UtilsRepository
	public data cChaveIDRepository as character

	public method new()

	private method getFields() as array

	static method getDefaultDisposalCode() as character
endclass

/*/{Protheus.doc} DisposalOfPackagesRepository::new
Construtor
@type method
@version 12
@author jc.maldonado
@since 13/05/2026
@param cChaveIDRepository, character, 
@return object, Instância da classe
/*/
method new(cChaveIDRepository as character) class DisposalOfPackagesRepository
	::cChaveIDRepository := cChaveIDRepository

	_Super:New('NEO', ::getFields())
return Self

/*/{Protheus.doc} DisposalOfPackagesRepository::getFields
Obtem os campos do repositório
@type method
@version 12
@author jc.maldonado
@since 13/05/2026
@return array, {{cCampoJson, cCampoProtheus, cTipoCampo, lMostraCampoConsulta}, ...}
/*/
method getFields() as array class DisposalOfPackagesRepository
	local aFields as array

	aFields := {;
		{'filial'           , 'NEO_FILIAL', 'C', .F.},;
		{'codigo'           , 'NEO_CODIGO', 'C', .T.},;
		{'nome'             , 'NEO_NOME'  , 'C', .T.},;
		{'data'             , 'NEO_DATA'  , 'D', .T.},;
		{'cgc'              , 'NEO_CPFCGC', 'C', .T.},;
		{'estado'           , 'NEO_EST'   , 'C', .T.},;
		{'codigoMunicipio'  , 'NEO_CODMUN', 'C', .T.},;
		{'bairro'           , 'NEO_BAIRRO', 'C', .T.},;
		{'endereco'         , 'NEO_ENDERE', 'C', .T.},;
		{'numero'           , 'NEO_NUMERO', 'C', .T.},;
		{'cep'              , 'NEO_CEP'   , 'C', .T.},;
		{'ddd'              , 'NEO_DDD'   , 'C', .T.},;
		{'telefone'         , 'NEO_TEL'   , 'C', .T.},;
		{'inscricaoEstadual', 'NEO_INSEST', 'C', .T.},;
		{'complemento'      , 'NEO_COMPL' , 'C', .T.},;
		{'bloqueado'        , 'NEO_BLOQUE', 'C', .T.},;
		{'padrao'           , 'NEO_PADRAO', 'C', .T.};
		}
return aFields

/*/{Protheus.doc} DisposalOfPackagesRepository::getDefaultDisposal
Retorna o primeiro código de local de descarte padrão desbloqueado.
@type method
@version 12
@author jc.maldonado
@since 13/05/2026
@return character, Código do local de descarte padrão
/*/
Method getDefaultDisposalCode() as character class DisposalOfPackagesRepository
	Local cQuery         as character
	Local aBindQry := {} as array

	cQuery := "SELECT"
	cQuery += "   NEO_CODIGO"
	cQuery += " FROM "
	cQuery +=       RetSQLName("NEO")
	cQuery += " WHERE"
	cQuery += "   NEO_FILIAL = ?" ; aAdd(aBindQry, FwXFilial("NEO"))
	cQuery += "   AND NEO_PADRAO = '1'" //'1'=Sim
	cQuery += "   AND NEO_BLOQUE = '2'" //'2'=Não
	cQuery += "   AND D_E_L_E_T_ = ' '"

	cQuery := ChangeQuery(cQuery)
Return MPSysExecScalar(cQuery, 'NEO_CODIGO', aBindQry)
