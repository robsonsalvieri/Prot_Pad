#include "totvs.ch"
#include 'tlpp-core.th'
#include 'fwmvcdef.ch'
#include 'agrobusiness.agd.sales.order.extension.service.ch'

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} SalesOrderExtensionService
Classe de serviço referente a extensão do pedido de venda do agro distribuidor
@type class
@version 12
@author claudineia.reinert
@since 30/04/2026
/*/
class SalesOrderExtensionService FROM UtilsService
	public method new()
	public method listar()
	public method registrar()
	public method informarIntegracaoExterna()
    
endClass

/*/{Protheus.doc} New
Construtor da classe
@type method
@version  P12
@author claudineia.reinert
@since 30/04/2026
/*/
method new() class SalesOrderExtensionService
    _Super:new()
return Self

/*/{Protheus.doc} listar
Listar registros da tabela de extensão do pedido de venda do agro distribuidor
@type method
@version 12
@author claudineia.reinert
@since 13/05/2026
@param nPage, numeric, pagina
@param nPageSize, numeric, tamanho pagina
@param oJsonQryParam, object, query param
@param oJsonPathParam, object, path param
@return variant, nil
/*/
method listar(nPage, nPageSize, oJsonQryParam) class SalesOrderExtensionService
	Local oRepository As Object
	Default nPage     := 1
	Default nPageSize := 10
	Default oJsonQryParam := nil

	oRepository := SalesOrderExtensionRepository():New()
	oRepository:find(nPage, nPageSize, oJsonQryParam)

	Self:setFullResponse(oRepository)

	oRepository:DeActivate()
	FreeObj(oRepository)
Return nil

/*/{Protheus.doc} registrar
Insere um registro na tabela de extensão do pedido de venda do agro distribuidor
@type method
@version 12
@author claudineia.reinert
@since 30/04/2026
@param jCmdRegistrar, json, json com os dados para registro
@return variant, nil
/*/
method registrar(jCmdRegistrar) class SalesOrderExtensionService
    Local oRepository As Object
    Local cPedido As Character
    Local cFilPed As Character
    Local cIdRepository As Character
    Local oOrderRepository As Object

    If ValType(jCmdRegistrar) != "J" .or. !(::isSIGAAGDactive())
        return .F.    
    ElseIf !jCmdRegistrar:hasProperty('numeroPedido') .or. ValType(jCmdRegistrar['numeroPedido']) != "C" .Or. Empty(AllTrim(jCmdRegistrar['numeroPedido']))
        Self:setError(STR0001, 422) //"Atributo 'numeroPedido' não informado ou inválido."
        return .F.
    EndIf

    cPedido := AllTrim(jCmdRegistrar['numeroPedido'])
    cFilPed := xFilial("NEQ")

    cIdRepository := cFilPed + cPedido
    oOrderRepository := OrderRepository():New()    
    oRepository := SalesOrderExtensionRepository():New()

    //valida se pedido existe antes de inserir extensão
   If !oOrderRepository:existsById(cIdRepository)
        Self:setError(STR0003, 404) //"Pedido de venda informado não existe."
    ElseIf oRepository:existsById(cIdRepository)
        Self:setError(STR0002, 409) //"Registro já existente."
    else
        oRepository:save(jCmdRegistrar)
        Self:setFullResponse(oRepository)
    EndIf    

    oRepository:DeActivate()
    FreeObj(oRepository)
    FreeObj(oOrderRepository)
return nil

/*/{Protheus.doc} SalesOrderExtensionService::informarIntegracaoExterna
Metodo para informar que o pedido de venda é integração externa
@type method
@version P12
@author claudineia.reinert
@since 04/05/2026
@param cChaveId, character, chave unica da tabela de extensão do pedido de venda do agro distribuidor (filial + numero do pedido)
/*/
method informarIntegracaoExterna(cChaveId as Character) class SalesOrderExtensionService
	Local oRepository As Object

	if ::isSIGAAGDactive() //ja trata o erro caso o SIGAAGD não esteja ativo
        oRepository := SalesOrderExtensionRepository():New(cChaveId)
		oRepository:informarIntegracaoExterna()
		Self:setFullResponse(oRepository)

		oRepository:DeActivate()
		FreeObj(oRepository)
	EndIf
	
return nil
