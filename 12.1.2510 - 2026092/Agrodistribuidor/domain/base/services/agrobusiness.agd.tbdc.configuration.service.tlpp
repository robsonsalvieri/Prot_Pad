#include 'totvs.ch'
#include 'tlpp-core.th'

namespace totvs.protheus.agrobusiness.agd  

/*/{Protheus.doc} TBDCConfigurationService
Servico de Configuracao automatica TBDC
@type class
@version 12
@author lindembergson.pacheco
@since 01/09/2026
/*/ 
class TBDCConfigurationService FROM UtilsService

	public method new()

	public method listar()
	public method buscarPorId()

endclass

/*/{Protheus.doc} new
Constructor
@type method
@version 12
@author lindembergson.pacheco
@since 01/09/2026
@return variant, instância
/*/
method new() class TBDCConfigurationService
	_Super:New()
return Self

/*/{Protheus.doc} listar
Listar Configuracoes
@type method
@version 12
@author lindembergson.pacheco
@since 01/09/2026
@param nPage, numeric, pagina
@param nPageSize, numeric, tamanho pagina
@param oJsonQryParam, object, query param
@param oJsonPathParam, object, path param
@return variant, nil
/*/
method listar(nPage, nPageSize, oJsonQryParam) class TBDCConfigurationService
	Local oRepository As Object
	Default nPage     := 1
	Default nPageSize := 10
	Default oJsonQryParam := nil

	oRepository := TBDCConfigurationRepository():New()
	oRepository:find(nPage, nPageSize, oJsonQryParam)

	Self:setFullResponse(oRepository)

	oRepository:DeActivate()
	FreeObj(oRepository)
Return nil


/*/{Protheus.doc} buscarPorId
Buscar Por Id Unico
@type method
@version 12
@author lindembergson.pacheco
@since 01/09/2026
@param cCodigo, character, id unico
@return variant, nil
/*/
method buscarPorId(cCodigo) class TBDCConfigurationService
	Local oRepository As object
	Local oResponseMerge     As object

	oRepository := TBDCConfigurationRepository():New()
	oRepository:findById(oRepository:getFilterById(cCodigo)) 

	oResponseMerge := oRepository:getResponse()

	Self:setFullResponse(oRepository)

	oRepository:DeActivate()
	FreeObj(oRepository)	
return nil
