#include 'tlpp-core.th'
#include 'tlpp-rest.th'
#include 'TOTVS.CH'

#DEFINE PATH_URL_CONFIG '/api/agd/v1/configuracoes-automaticas-tbdc'
#DEFINE PATH_URL_CONFIG_ID '/api/agd/v1/configuracoes-automaticas-tbdc/:codigo'

namespace totvs.protheus.agrobusiness.agd  /*nameSpace - para ser importado em shortcurt*/


/*/{Protheus.doc} 
Controller de Configuracao automatica TBDC
@type class
@version 12
@author lindembergson.pacheco
@since 01/09/2026
/*/
class TBDCConfigurationController
	public Data nPage     As Integer
	public Data nPageSize As Integer

	public method new()
	
	@Get(PATH_URL_CONFIG)
	public method getConfiguracao() as logical

	@Get(PATH_URL_CONFIG_ID)
	public method getConfiguracaoId() as logical

endClass

/*/{Protheus.doc} new
Constructor
@type method
@version 12
@author lindembergson.pacheco
@since 01/09/2026
@return variant, inst ncia
/*/
method new() class TBDCConfigurationController
return self

/*/{Protheus.doc} getConfiguracao
API REST Get retorna json com lista de Configuracao automatica TBDC
@type method
@version p12
@author lindembergson.pacheco
@since 01/09/2026
@return logical, return_true
/*/
method getConfiguracao() as logical class TBDCConfigurationController
	Local oTabelaPrecoService As Object
	Local oRestService As Object
	Local oJsonQryParam := Nil


	oRestService := RestService():New()
	oTabelaPrecoService := TBDCConfigurationService():New()

	oRestService:getPageAndPageSize(@Self:nPage, @Self:nPageSize)
	oJsonQryParam := oRestService:getQueryParams()

	oTabelaPrecoService:listar(Self:nPage, Self:nPageSize, oJsonQryParam)

	oRestService:setAPIResponse(oRest, oTabelaPrecoService)

	FreeObj(oTabelaPrecoService)
	FreeObj(oRestService)

return .T.

/*/{Protheus.doc} getConfiguracaoId
API REST Get retorna json com Configuracao automatica TBDC por codigo
@type method
@version p12
@author lindembergson.pacheco
@since 01/09/2026
@return logical, return_true
/*/
method getConfiguracaoId() as logical class TBDCConfigurationController
	Local oTabelaPrecoService As Object
	Local oRestService As Object
	Local oJsonQryParam := Nil
	Local cCodProduto

	oRestService := RestService():New()
	oTabelaPrecoService := TBDCConfigurationService():New()

	cCodProduto  := oRestService:getIDWithPathParams({{"codigo", "NF9_CODREG"}})

	oRestService:getPageAndPageSize(@Self:nPage, @Self:nPageSize)
	oJsonQryParam := oRestService:getQueryParams()

	oTabelaPrecoService:buscarPorId( cCodProduto )

	oRestService:setAPIResponse(oRest, oTabelaPrecoService)

	FreeObj(oTabelaPrecoService)
	FreeObj(oRestService)

return .T.
