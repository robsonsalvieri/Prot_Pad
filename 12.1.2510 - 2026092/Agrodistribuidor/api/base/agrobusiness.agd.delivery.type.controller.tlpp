#include 'tlpp-core.th'
#include 'tlpp-rest.th'
#include 'totvs.ch'

#define PATH_URL '/api/agd/v2/delivery-type/:filial/:cliente'

namespace totvs.protheus.agrobusiness.agd 


/*/{Protheus.doc} DeliveryTypeController
Retorna o tipo de entrega com base no estado da filial e estado do cliente
@type class
@version 12
@author carlos.augusto
@since 11/05/2026
/*/
class DeliveryTypeController
	public data nPage     as integer
	public data nPageSize as integer

	public method new()

	@Get(PATH_URL)
	public method getDeliveryType() as logical
endClass

/*/{Protheus.doc} DeliveryTypeController::new
Construtor
@type method
@version 12
@author carlos.augusto
@since 11/05/2026
@return object, self
/*/
method new() class DeliveryTypeController
return self

/*/{Protheus.doc} 
Lista TipoEntregaController
@type method
@version 12
@author carlos.augusto
@since 11/05/2026
@return logical, Always true
/*/
method getDeliveryType() as logical class DeliveryTypeController
    Local oService     as Object
    Local oRestService as Object
    Local oJsonPath    as Json

    oRestService := RestService():New()
    oJsonPath := oRest:getPathParamsRequest()

    If ValType(oJsonPath) == "J" .And. oJsonPath:hasProperty("filial") .And. oJsonPath:hasProperty("cliente")

        oService := DeliveryTypeService():New()
        oService:getDeliveryType(oJsonPath["filial"], oJsonPath["cliente"])

        oRestService:setAPIResponse(oRest, oService)
    EndIf

    FreeObj(oService)
    FreeObj(oRestService)
    FreeObj(oJsonPath)

return .T.
