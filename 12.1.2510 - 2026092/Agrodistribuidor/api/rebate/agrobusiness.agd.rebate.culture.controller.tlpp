#include 'tlpp-core.th'
#include 'tlpp-rest.th'
#include 'totvs.ch'

#define PATH_URL '/api/agd/v1/rebate/culturas'

namespace totvs.protheus.agrobusiness.agd 

/*/{Protheus.doc} CultureController
Controller de Culturas.
@type class
@version 12
@author ronery.filho
@since 31/07/2026
/*/
class CultureController
	public data nPage     as integer
	public data nPageSize as integer

	public method new()

	@Get(PATH_URL)
	public method listar() as logical
endClass

/*/{Protheus.doc} CultureController::new
Construtor
@type method
@version 12
@author ronery.filho
@since 31/07/2026
@return object, self
/*/
method new() class CultureController
return self

/*/{Protheus.doc} culture::listar
Lista Culturas (Tabela NP3)
@type method
@version 12
@author ronery.filho
@since 31/07/2026
@return logical, Always true
/*/
method listar() as logical class CultureController
	local oCulturaService 	as object
	local oRestService      as object
	local jsonQueryParam    as json

	oRestService   	:= RestService():New()
	if !oRestService:isFilialInformado()
        FWFreeObj(oRestService)
        return .T.
    endif
	oCulturaService := RebateCultureService():New()

	oRestService:getPageAndPageSize(@::nPage, @::nPageSize)
	jsonQueryParam 	:= oRestService:getQueryParams()

	oCulturaService:listar(::nPage, ::nPageSize, jsonQueryParam)

	oRestService:setAPIResponse(oRest, oCulturaService)

	FreeObj(oCulturaService)
	FreeObj(oRestService)
return .T.
