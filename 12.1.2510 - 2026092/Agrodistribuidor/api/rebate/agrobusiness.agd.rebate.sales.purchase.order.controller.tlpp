#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "totvs.ch"

#DEFINE ORDER_INTEGRATION_PATH '/api/agd/v1/rebate/por-fabricante/:fabricanteID/sendSalesOrder/:filial/:data_ini/:data_fim'

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} SalesPurchaseOrderRebateController
Controller responsável por disponibilizar a API REST de consulta de pedidos de venda e compra destinados a integração de rebate.
@type class
@author beatriz.dantas
@since 17/07/2026
@version p12
/*/
class SalesPurchaseOrderRebateController
    public data nPage     as integer
    public data nPageSize as integer 

    public method New() constructor 

    @Get(ORDER_INTEGRATION_PATH)
    public method listarPedidos() as logical
endClass

/*/{Protheus.doc} new
Construtor da classe SalesPurchaseOrderRebateController.
@author beatriz.datns
@since 20/07/2026
@version p12
@return Object, Instância da classe SalesPurchaseOrderRebateController
/*/
method new() class SalesPurchaseOrderRebateController
return self

/*/{Protheus.doc} listarPedidos
Processa a requisição GET da API de consulta de pedidos para integração de rebate.
@author beatriz.dantas
@since 20/07/2026
@version p12
@return Logical, Retorna .T. quando a requisição é processada com sucesso
/*/
method listarPedidos() as logical class SalesPurchaseOrderRebateController
	Local oSPOService   as object
	Local oRestService  as object
	Local oJsonPath     as object
	Local jQueryParams  as object
	Local lRet          := .T.

	oRestService := RestService():New()
	oSPOService  := SalesPurchaseOrderRebateSevice():New()

	oRestService:getPageAndPageSize(@Self:nPage, @Self:nPageSize)

	oJsonPath    := oRest:getPathParamsRequest()
	jQueryParams := oRestService:getQueryParams()
	
	If ValType(oJsonPath) == "J"
		If oJsonPath:HasProperty("fabricanteID")
			jQueryParams["codiFab"]  := AllTrim(oJsonPath["fabricanteID"])
		EndIf
		If oJsonPath:HasProperty("filial")
			jQueryParams["codi_rev"] := AllTrim(oJsonPath["filial"])
		EndIf
		If oJsonPath:HasProperty("data_ini")
			jQueryParams["data_ini"] := StrTran(SubStr(AllTrim(oJsonPath["data_ini"]), 1, 10), "-", "")
		EndIf
		If oJsonPath:HasProperty("data_fim")
			jQueryParams["data_fim"] := StrTran(SubStr(AllTrim(oJsonPath["data_fim"]), 1, 10), "-", "")
		EndIf
	EndIf

	oSPOService:listarPedidos(Self:nPage, Self:nPageSize, jQueryParams)

	oRestService:setAPIResponse(oRest, oSPOService)

	FreeObj(oSPOService)
	FreeObj(oRestService)
return lRet
