#Include "totvs.ch"
#Include "tlpp-core.th"
#Include "tlpp-rest.th"

#Define CUSTOMER_INTEGRATION_PATH "/api/agd/v1/rebate/por-fabricante/:fabricanteID/sendCliAndProp/:filial"


namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} CustomerIntegrationController
Controller REST responsável por disponibilizar os dados de clientes utilizados
nas integrações de rebate com Bayer, Corteva e Syngenta.
@type class
@author rodrigo.nsoledade
@since 17/07/2026
/*/
Class CustomerIntegrationController
    Public Data nPage     As Integer
    Public Data nPageSize As Integer

    Public Method New()

    @Get(CUSTOMER_INTEGRATION_PATH)
    Public Method listCustomers() As Logical

EndClass

/*/{Protheus.doc} New
Construtor da classe CustomerIntegrationController.
@type method
@author rodrigo.nsoledade
@since 17/07/2026
@return object, instância da classe
/*/
Method New() Class CustomerIntegrationController
Return Self

/*/{Protheus.doc} listCustomers
Disponibiliza a consulta paginada dos clientes no layout utilizado pelas
integrações de rebate com Bayer, Corteva e Syngenta.
@type method
@author rodrigo.nsoledade
@since 17/07/2026
@return logical, indica a execução do recurso REST
/*/
Method listCustomers() As Logical Class CustomerIntegrationController
    Local oRestService As Object
    Local oService     As Object
    Local oJsonPath    As Object
    Local jQueryParams := JsonObject():New()

    oRestService := RestService():New()
    oService     := CustomerIntegrationService():New()

    oRestService:getPageAndPageSize(@Self:nPage, @Self:nPageSize)
    jQueryParams := oRestService:getQueryParams()

    oJsonPath    := oRest:getPathParamsRequest()

	If ValType(oJsonPath) == "J"
		If oJsonPath:HasProperty("fabricanteID")
            jQueryParams["fabricanteID"] := AllTrim(oJsonPath["fabricanteID"])
		EndIf
		If oJsonPath:HasProperty("filial")
            jQueryParams["codi_rev"] := AllTrim(oJsonPath["filial"])
		EndIf
	EndIf

    oService:listCustomers(Self:nPage, Self:nPageSize, jQueryParams)
    oRestService:setAPIResponse(oRest, oService)

    FWFreeObj(oService)
    FWFreeObj(oRestService)
Return .T.
