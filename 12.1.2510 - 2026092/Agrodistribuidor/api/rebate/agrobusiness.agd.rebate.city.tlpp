#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "totvs.ch"

#Define CITY_PATH "/api/agd/v1/rebate/municipio"

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} CityController
Controller REST responsável por disponibilizar os dados de municípios
para integração de rebate.
@type class
@author felipe.savelar
@since 30/07/2026
/*/
Class CityController
    Public Data nPage     As Integer
    Public Data nPageSize As Integer

    Public Method New() Constructor

    @Get(CITY_PATH)
    Public Method listCities() As Logical

EndClass
/*/{Protheus.doc} New
Construtor da classe CityController.
@type method
@author felipe.savelar
@since 30/07/2026
@return object, instância da classe
/*/
/*/{Protheus.doc} New
Construtor da classe CityController.
@type method
@author felipe.savelar
@since 30/07/2026
@return object, instância da classe
/*/
Method New() Class CityController
Return Self

/*/{Protheus.doc} CityController::listCities
Disponibiliza a consulta paginada dos municípios para integração de rebate.
@type method
@author felipe.savelar
@since 30/07/2026
@return logical, indica a execução do recurso REST
/*/
Method listCities() As Logical Class CityController
    Local oRestService As Object
    Local oService     As Object

    oRestService := RestService():New()
    oService     := CityService():New()

    If oRestService:isFilialInformado()
        oRestService:getPageAndPageSize(@Self:nPage, @Self:nPageSize)

        oService:listCities(Self:nPage, Self:nPageSize, oRestService:getQueryParams())

        oRestService:setAPIResponse(oRest, oService)
    EndIf

    FWFreeObj(oService)
    FWFreeObj(oRestService)
Return .T.

