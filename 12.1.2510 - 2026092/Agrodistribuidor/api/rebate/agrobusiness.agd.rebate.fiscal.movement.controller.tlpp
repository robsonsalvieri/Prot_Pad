#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "totvs.ch"

#define FISCAL_MOVEMENT_PATH '/api/agd/v1/rebate/por-fabricante/:fabricanteID/sendBilling/:filial/:data_ini/:data_fim'

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} FiscalMovementController
Controller responsável por disponibilizar a API REST de consulta de movimentações fiscais destinadas a integração de rebate.
@type class
@author beatriz.dantas
@since 04/08/2026
@version p12
/*/
class FiscalMovementController
    public data nPage     as integer
    public data nPageSize as integer 

    public method new() constructor 

    @Get(FISCAL_MOVEMENT_PATH)
    public method listarMovimentosFiscais() as logical
endclass

/*/{Protheus.doc} new
Construtor da classe FiscalMovementController.
@type method
@author beatriz.dantas
@since 04/08/2026
@version p12
@return Object, Instância da classe FiscalMovementController
/*/
method new() class FiscalMovementController
return self

/*/{Protheus.doc} listarMovimentosFiscais
Processa a requisição GET da API de consulta de movimentações fiscais para integração de rebate.
@type method
@author beatriz.dantas
@since 04/08/2026
@version p12
@return Logical, Retorna .T. quando a requisição é processada com sucesso
/*/
method listarMovimentosFiscais() as logical class FiscalMovementController
	Local oFMService     as object //fiscal movements (movimentações fiscais)
	Local oRestService   as object
	Local oJsonPath      as object
	Local jQueryParams   := JsonObject():New()
	Local lRet           := .t.

	oRestService := RestService():New()

	oRestService:getPageAndPageSize(@Self:nPage, @Self:nPageSize)
	oJsonPath    := oRest:getPathParamsRequest()
	jQueryParams := oRestService:getQueryParams()

	If ValType(oJsonPath) == "J"
		If oJsonPath:HasProperty("fabricanteID")
			jQueryParams["fabricanteID"] := AllTrim(oJsonPath["fabricanteID"])
		EndIf
		If oJsonPath:HasProperty("filial")
			jQueryParams["codi_rev"] := AllTrim(oJsonPath["filial"])
		EndIf
		If oJsonPath:HasProperty("data_ini")
			jQueryParams["data_ini"] := StrTran(SubStr(AllTrim(oJsonPath["data_ini"]), 1, 10), "-", "")
		EndIf
		If oJsonPath:HasProperty("data_fim")
			jQueryParams["data_fim"] := StrTran(SubStr(AllTrim(oJsonPath["data_fim"]), 1, 10), "-", "")
		EndIf
	EndIf

	oFMService := FiscalMovementService():New()
	oFMService:listarMovimentosFiscais(Self:nPage, Self:nPageSize, jQueryParams)

	oRestService:setAPIResponse(oRest, oFMService)

	FreeObj(oFMService)
	FreeObj(oRestService)
return lRet
