#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "totvs.ch"

#DEFINE PATH_URL_PRODUTOS '/api/agd/v1/rebate/produtos'
#Define PATH_URL_PRODUCT_STOCK '/api/agd/v1/rebate/por-fabricante/:fabricanteID/sendStock/:filial/:data_ini/:data_fim'
#Define PATH_URL_STOCK_POSITION "/api/agd/v1/rebate/estoque"


namespace totvs.protheus.agrobusiness.agd


/*/{Protheus.doc} RebateProductController
Controller responsável pela disponibilização de dados de produtos
para integração de rebate.
@type class
@version 12
@author carlos.augusto/rodrigo.nsoledade
@since 28/07/2026
/*/
class RebateProductController
	public Data nPage     As Integer
	public Data nPageSize As Integer

	public method New() constructor

	@Get(PATH_URL_PRODUTOS)
	public method getProdutos() as logical
	
	@Get(PATH_URL_PRODUCT_STOCK)
	public method getProductStock() As Logical

	@Get(PATH_URL_STOCK_POSITION)
	public method getStockPosition() As Logical

endClass

/*/{Protheus.doc} New
Constructor
@type method
@version 12
@author carlos.augusto/rodrigo.nsoledade
@since 28/07/2026
@return variant, self
/*/
method New() class RebateProductController
return self


/*/{Protheus.doc} getProdutos
Busca todos os produtos para a integração de rebate
@type method
@version 12
@author carlos.augusto
@since 28/07/2026
/*/
method getProdutos() as logical class RebateProductController
	Local oRebateProductService As Object
	Local oRestService As Object
	oRebateProductService := RebateProductService():New()

	oRestService := RestService():New()
	if !oRestService:isFilialInformado()
		FWFreeObj(oRestService)
		return .T.
	endif

	oRebateProductService:findProducts(@self:nPage, @self:nPageSize, oRestService:getQueryParams())

	oRestService:setAPIResponse(oRest, oRebateProductService)

	FreeObj(oRebateProductService)
	FreeObj(oRestService)
return .T.


/*/{Protheus.doc} getProductStock
Disponibiliza os dados de estoque dos produtos para integração.
@type method
@version 12
@author rodrigo.nsoledade
@since 28/07/2026
@return logical, verdadeiro após o processamento da requisição
/*/
Method getProductStock() As Logical Class RebateProductController
	Local oRebateProductService As Object
	Local oRestService    As Object
	Local oJsonPath       As Object
	Local jQueryParams    As Object
	
	oRestService := RestService():New()
	
	oRestService:getPageAndPageSize(@Self:nPage,@Self:nPageSize)

	oJsonPath    := oRest:getPathParamsRequest()
	jQueryParams := oRestService:getQueryParams()

	If ValType(oJsonPath) == "J"
		If oJsonPath:HasProperty("fabricanteID")
			jQueryParams["codi_fab"] := AllTrim(oJsonPath["fabricanteID"])
		EndIf
		If oJsonPath:HasProperty("filial")
			jQueryParams["codi_rev"] := AllTrim(oJsonPath["filial"])
		EndIf
		If oJsonPath:HasProperty("data_ini")
			jQueryParams["data_ini"] := StrTran(SubStr(AllTrim(oJsonPath["data_ini"]), 1, 10), "-", "")
		EndIf
		If oJsonPath:HasProperty("data_fim")
			jQueryParams["data_fim"] := StrTran(SubStr(AllTrim(oJsonPath["data_fim"]), 1, 10), "-", "")
		EndIf
	EndIf

	// Instancia o service de rebate e realiza a busca de estoque
	oRebateProductService := RebateProductService():New()
	oRebateProductService:findProductStock(Self:nPage,Self:nPageSize, jQueryParams)

	oRestService:setAPIResponse(oRest, oRebateProductService)

	FreeObj(oRebateProductService)
	FreeObj(oRestService)
Return .T.

/*/{Protheus.doc} getStockPosition
Disponibiliza a posição consolidada de estoque dos produtos conforme
o layout específico da integração de rebate.
@type method
@version 12
@author rodrigo.nsoledade
@since 03/08/2026
@return logical, verdadeiro após o processamento da requisição
/*/
Method getStockPosition() As Logical Class RebateProductController
	Local oProductService As Object
	Local oRestService    As Object

	oRestService := RestService():New()

	If !oRestService:isFilialInformado()
		FWFreeObj(oRestService)
		Return .T.
	EndIf

	oRestService:getPageAndPageSize(@Self:nPage,@Self:nPageSize)

	oProductService := RebateProductService():New()
	oProductService:findStockPosition(Self:nPage,Self:nPageSize,oRestService:getQueryParams())

	oRestService:setAPIResponse(oRest,oProductService)

	FWFreeObj(oProductService)
	FWFreeObj(oRestService)
Return .T.
