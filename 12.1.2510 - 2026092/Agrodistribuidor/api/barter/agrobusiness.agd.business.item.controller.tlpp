#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "TOTVS.CH"

namespace totvs.protheus.agrobusiness.agd



/*/{Protheus.doc} BusinessItemController
API REST para listagem dos itens da negociação barter.
@type class
@version 12
@author rodrigo.nsoledade
@since 05/05/2025
/*/
class BusinessItemController

	public method New() constructor

    @Get("/api/agd/v2/negociacoes/insumos")
	public method listarInsumos() as logical

endclass

/*/{Protheus.doc} New
Construtor da classe
@type method
@return Self
/*/
method New() class BusinessItemController
return Self

/*/{Protheus.doc} listarInsumos
Recurso REST para listar itens de insumo de uma negociação
@type method
@version 12
@since 05/05/2025
@return logical
/*/
method listarInsumos() as logical class BusinessItemController
	Local oNegocioInsumoServive As Object

	oNegocioInsumoServive   := BusinessItemService():New()

    oNegocioInsumoServive:listar() 

	FreeObj(oNegocioInsumoServive)

Return .T.
