/*/{Protheus.doc} auditoriaregraspadrao
Tool MCP para auditoria das regras padrao de faturamento de casos
juridicos, verificando contratos, lancamentos pendentes e
conformidade de cobranca.
@type class
@author Abner Fogaca de Oliveira
@since 13/08/2026
/*/
//-------------------------------------------------------------------
@FWToolMCP(action="get", erpRelease="12.1.2510", routine="auditoriaregraspadrao", option=2, module="SIGAPFS")
class auditoriaregraspadrao implements FWMCPTool
    public Method new() as object
    public Method getDescription() as character
    public Method getNotes() as character
    public Method getPayLoadSchema() as json
    public Method getReturnSchema() as json
    public method getMetrics() as array
    public Method process(jPayLoad as json) as json
endclass

