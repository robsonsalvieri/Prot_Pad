//------------------------------------------------------------------
/*/{Protheus.doc} Process
Processa a requisicao da Tool, validando os parametros e executando
a auditoria das regras padrao do caso.
@type method
@author Abner Fogaca de Oliveira
@since 13/08/2026
@param jPayLoad, json, Objeto JSON contendo codcliente, codloja, codcaso e context
@return json, Objeto JSON com os dados auditados do caso ou mensagem de erro
/*/
//-------------------------------------------------------------------
Method Process(jPayLoad as json) as json class auditoriaregraspadrao
Local jRetorno := JsonObject():New() as json

    If jPayLoad:hasProperty("codcliente") .And. !Empty(jPayLoad["codcliente"]);
       .And. jPayLoad:hasProperty("codloja")   .And. !Empty(jPayLoad["codloja"]);
       .And. jPayLoad:hasProperty("codcaso")   .And. !Empty(jPayLoad["codcaso"]);
       .And. jPayLoad:hasProperty("context")   .And. !Empty(jPayLoad["context"])
        jRetorno := JAuditVerificaCaso(jPayLoad)
    Else
        jRetorno["error"] := JsonObject():New()
        jRetorno["error"]["message"] := JConvUTF8(STR0001) // "Nao foram enviados todos os parametros obrigatorios"
    EndIf

Return jRetorno

//-----------------------------------------------------------------
/*/{Protheus.doc} JAuditVerificaCaso
Consulta e audita as regras padrao de faturamento do caso.
@type function
@author Abner Fogaca de Oliveira
@since 13/08/2026
@param jPayLoad, json, Objeto json contendo os dados necessarios para a execucao da tool
@return json, Objeto JSON com os dados auditados do caso
/*/
//-----------------------------------------------------------------
Static Function JAuditVerificaCaso(jPayLoad as json) as json
Local cQryCasos    := ""                      as character
Local cCodCliente  := jPayLoad["codcliente"]  as character
Local cCodLoja     := jPayLoad["codloja"]     as character
Local cCodCaso     := jPayLoad["codcaso"]     as character
Local nIJson       := 0                       as integer
Local cAlsQryCasos := GetNextAlias()          as character
Local jRetorno     := JsonObject():New()      as json
Local cUltContr    := ""                      as character

    jRetorno["caso"] := JsonObject():New()

    cQryCasos := JAuditQryCasos(cCodCliente, cCodLoja, cCodCaso)
    MpSysOpenQuery(cQryCasos, cAlsQryCasos)

    While (cAlsQryCasos)->(!Eof())
        nIJson++
        If nIJson == 1
            jRetorno["caso"]["cod_cliente"]              := (cAlsQryCasos)->NVE_CCLIEN
            jRetorno["caso"]["cod_loja"]                 := (cAlsQryCasos)->NVE_LCLIEN
            jRetorno["caso"]["cod_caso"]                 := (cAlsQryCasos)->NVE_NUMCAS
            jRetorno["caso"]["pk"]                       := (cAlsQryCasos)->NVE_FILIAL + (cAlsQryCasos)->NVE_CCLIEN + (cAlsQryCasos)->NVE_LCLIEN + (cAlsQryCasos)->NVE_NUMCAS
            jRetorno["caso"]["possui_contrato"]          := !Empty((cAlsQryCasos)->NT0_COD)
            jRetorno["caso"]["caso_provisorio"]          := (cAlsQryCasos)->NVE_SITCAD == "1"
            jRetorno["caso"]["caso_cobravel"]            := (cAlsQryCasos)->NVE_COBRAV == "1"
            jRetorno["caso"]["caso_permite_timesheet"]   := (cAlsQryCasos)->NVE_LANTS  == "1"
            jRetorno["caso"]["caso_permite_despesa"]     := (cAlsQryCasos)->NVE_LANDSP == "1"
            jRetorno["caso"]["data_criacao_caso"]        := SToD((cAlsQryCasos)->NVE_DTENTR)
            jRetorno["caso"]["tabela_honorarios"]        := !Empty((cAlsQryCasos)->NVE_CTABH)
            jRetorno["caso"]["encerra_cobranca_honorarios"] := (cAlsQryCasos)->NVE_ENCHON == "1"
            jRetorno["caso"]["encerra_cobranca_despesas"]   := (cAlsQryCasos)->NVE_ENCDES == "1"
        EndIf

        If !Empty((cAlsQryCasos)->NT0_COD)
            If !jRetorno["caso"]:hasProperty("contratos")
                jRetorno["caso"]["contratos"] := {}
            EndIf

            If (cAlsQryCasos)->NT0_COD != cUltContr
                cUltContr := (cAlsQryCasos)->NT0_COD
                Aadd(jRetorno["caso"]["contratos"], JsonObject():New())
                nIJson := Len(jRetorno["caso"]["contratos"])

                jRetorno["caso"]["contratos"][nIJson]["contrato_inativo"]          := (cAlsQryCasos)->NT0_ATIVO == "2"
                jRetorno["caso"]["contratos"][nIJson]["contrato_provisorio"]       := (cAlsQryCasos)->NT0_SIT   == "1"
                jRetorno["caso"]["contratos"][nIJson]["contrato_cobra_timesheet"]  := (cAlsQryCasos)->NRA_COBRAH  == "1"
                jRetorno["caso"]["contratos"][nIJson]["contrato_cobra_tabelado"]   := (cAlsQryCasos)->NT0_SERTAB == "1"
                jRetorno["caso"]["contratos"][nIJson]["contrato_cobra_despesa"]    := (cAlsQryCasos)->NT0_DESPES == "1"
                jRetorno["caso"]["contratos"][nIJson]["contrato_descricao"]        := JConvUTF8((cAlsQryCasos)->NT0_NOME)

                If !Empty((cAlsQryCasos)->NT0_DTVIGI)
                    jRetorno["caso"]["contratos"][nIJson]["vigencia_inicial"] := StoD((cAlsQryCasos)->NT0_DTVIGI)
                Else
                    jRetorno["caso"]["contratos"][nIJson]["vigencia_inicial"] := ""
                EndIf
                
                If !Empty((cAlsQryCasos)->NT0_DTVIGF)
                    jRetorno["caso"]["contratos"][nIJson]["vigencia_final"] := StoD((cAlsQryCasos)->NT0_DTVIGF)
                Else
                    jRetorno["caso"]["contratos"][nIJson]["vigencia_final"] := ""
                EndIf
                
				jRetorno["caso"]["contratos"][nIJson]["encerra_cobranca_honorarios_caso"]     := (cAlsQryCasos)->NVE_ENCHON == "1"
				jRetorno["caso"]["contratos"][nIJson]["encerra_cobranca_honorarios_contrato"] := (cAlsQryCasos)->NT0_ENCH == "1"
				jRetorno["caso"]["contratos"][nIJson]["encerra_cobranca_tabelado_contrato"]   := (cAlsQryCasos)->NT0_ENCT == "1"
				jRetorno["caso"]["contratos"][nIJson]["encerra_cobranca_despesa_contrato"]    := (cAlsQryCasos)->NT0_ENCD == "1"
				jRetorno["caso"]["contratos"][nIJson]["encerra_cobranca_despesas_caso"]       := (cAlsQryCasos)->NVE_ENCDES == "1"
				jRetorno["caso"]["contratos"][nIJson]["encerra_cobranca_tabelado_caso"]       := (cAlsQryCasos)->NVE_ENCTAB == "1"

                JAuditQryTiposAtivNaoCobraveis((cAlsQryCasos)->NT0_COD, @jRetorno)
            EndIf

            If !Empty((cAlsQryCasos)->NT1_DATAIN)
                If !jRetorno["caso"]["contratos"][nIJson]:hasProperty("data_inicial_parcela")
                    jRetorno["caso"]["contratos"][nIJson]["data_inicial_parcela"] := {}
                EndIf
                Aadd(jRetorno["caso"]["contratos"][nIJson]["data_inicial_parcela"], StoD((cAlsQryCasos)->NT1_DATAIN))
            EndIf
        EndIf

        (cAlsQryCasos)->(DbSkip())
    EndDo

    JAuditVerificaLancamentos(cCodCliente, cCodLoja, cCodCaso, .T., /*lCobraDesp*/, /*lCobraTab*/, @jRetorno)
    JAuditVerificaLancamentos(cCodCliente, cCodLoja, cCodCaso, /*lCobraTS*/, .T., /*lCobraTab*/, @jRetorno)
    JAuditVerificaLancamentos(cCodCliente, cCodLoja, cCodCaso, /*lCobraTS*/, /*lCobraDesp*/, .T., @jRetorno)

    (cAlsQryCasos)->(dbCloseArea())

Return jRetorno

//-----------------------------------------------------------------
/*/{Protheus.doc} JAuditQryCasos
Monta a query SQL de consulta do caso para auditoria.
@type function
@author Abner Fogaca de Oliveira
@since 13/08/2026
@param cCodCliente, character, Codigo do cliente para filtro da consulta
@param cCodLoja, character, Codigo da loja para filtro da consulta
@param cCodCaso, character, Codigo do caso para filtro da consulta
@return character, String SQL da consulta com os parametros aplicados
/*/
//-----------------------------------------------------------------
Static Function JAuditQryCasos(cCodCliente as character, cCodLoja as character, cCodCaso as character) as character
Local cQuery := "" as character
Local aBind  := {} as array
Local oQuery as object

    cQuery := "SELECT NVE_FILIAL, NVE_DTENTR, NVE_CCLIEN, NVE_LCLIEN, NVE_NUMCAS, NVE_TITULO, NVE_SITUAC, NVE_SITCAD, NVE_COBRAV, NVE_LANTS, NVE_LANDSP,"
    cQuery +=       " NVE_LANTAB, NVE_ENCHON, NVE_ENCDES, NVE_ENCTAB, NVE_CTABH, NT0_COD, NT0_NOME, NT0_SIT, NT0_ATIVO, NT0_DESPES, NT0_ENCH, NT0_ENCD,"
    cQuery +=       " NT0_ENCT, NRA_COBRAH, NT0_SERTAB, NT0_DTVIGI, NT0_DTVIGF, A1_ESTADO, A1_BAIRRO, NT1.NT1_DATAIN"
    cQuery +=  " FROM " + RetSqlName("NVE") + " NVE"
    cQuery += " INNER JOIN " + RetSqlName("SA1") + " SA1"
    cQuery +=    " ON SA1.A1_FILIAL = ?"
    Aadd(aBind, {"C", xFilial("SA1")})
    cQuery +=   " AND NVE.NVE_CCLIEN = SA1.A1_COD"
    cQuery +=   " AND NVE.NVE_LCLIEN = SA1.A1_LOJA"
    cQuery +=   " AND SA1.D_E_L_E_T_ = ?"
    Aadd(aBind, {"C", ' '})
    cQuery +=  " LEFT JOIN " + RetSqlName("NUT") + " NUT"
    cQuery +=    " ON NUT.NUT_CCLIEN = NVE.NVE_CCLIEN"
    cQuery +=   " AND NUT.NUT_CLOJA  = NVE.NVE_LCLIEN"
    cQuery +=   " AND NUT.NUT_CCASO  = NVE.NVE_NUMCAS"
    cQuery +=   " AND NUT.NUT_FILIAL = ?"
    Aadd(aBind, {"C", xFilial("NUT")})
    cQuery +=   " AND NUT.D_E_L_E_T_ = ?"
    Aadd(aBind, {"C", ' '})
    cQuery +=  " LEFT JOIN " + RetSqlName("NT0") + " NT0"
    cQuery +=    " ON NT0.NT0_COD    = NUT.NUT_CCONTR"
    cQuery +=   " AND NT0.NT0_FILIAL = ?"
    Aadd(aBind, {"C", xFilial("NT0")})
    cQuery +=   " AND NT0.D_E_L_E_T_ = ?"
    Aadd(aBind, {"C", ' '})
    cQuery +=  " LEFT JOIN " + RetSqlName("NRA") + " NRA"
    cQuery +=    " ON NRA.NRA_COD    = NT0.NT0_CTPHON"
    cQuery +=   " AND NRA.NRA_FILIAL = ?"
    Aadd(aBind, {"C", xFilial("NRA")})
    cQuery +=   " AND NRA.D_E_L_E_T_ = ?"
    Aadd(aBind, {"C", ' '})
    cQuery +=  " LEFT JOIN " + RetSqlName("NT1") + " NT1"
    cQuery +=    " ON NT1.NT1_CCONTR = NT0.NT0_COD"
    cQuery +=   " AND NT1.NT1_FILIAL = ?"
    Aadd(aBind, {"C", xFilial("NT1")})
    cQuery +=   " AND NT1.NT1_SITUAC = ?"
    Aadd(aBind, {"C", '1'}) // Restringe estritamente a parcelas pendentes
    cQuery +=   " AND NT1.D_E_L_E_T_ = ?"
    Aadd(aBind, {"C", ' '})
    cQuery += " WHERE NVE.NVE_CCLIEN = ?"
    Aadd(aBind, {"C", cCodCliente})
    cQuery +=   " AND NVE.NVE_LCLIEN = ?"
    Aadd(aBind, {"C", cCodLoja})
    If !Empty(cCodCaso)
        cQuery +=   " AND NVE.NVE_NUMCAS = ?"
        Aadd(aBind, {"C", cCodCaso})
    EndIf
    cQuery +=   " AND NVE.D_E_L_E_T_ = ?"
    Aadd(aBind, {"C", ' '})

    oQuery := FWPreparedStatement():New(cQuery)
    oQuery := JQueryPSPr(oQuery, aBind)
    cQuery := oQuery:GetFixQuery()

Return cQuery

//-----------------------------------------------------------------
/*/{Protheus.doc} JAuditQryTiposAtivNaoCobraveis
Retorna os tipos de atividades ou tipos de despesas não cobráveis
com base em um contrato.
@type function
@author Abner Fogaca de Oliveira
@since 13/08/2026
@param cCodContrato, character, Codigo do contrato posicionado
@param oJSonRet, json, Objeto JSON onde serao adicionados os tipos nao cobraveis
@return variant, Nil (resultado adicionado por referencia em oJSonRet)
/*/
//-----------------------------------------------------------------
Static Function JAuditQryTiposAtivNaoCobraveis(cCodContrato as character, oJSonRet as json) as variant
Local cQuery          := ""                                 as character
Local nIndiceContrato := Len(oJSonRet["caso"]["contratos"]) as integer
Local cAlsQry         := GetNextAlias()                     as character
Local aBind           := {}                                 as array
Local oQuery          as object

    cQuery := "SELECT NTJ.NTJ_CTPATV TIPO, 'S' TIMESHEET, 'N' DESPESA"
    cQuery +=  " FROM " + RetSqlName("NTJ") + " NTJ"
    cQuery += " WHERE NTJ.NTJ_FILIAL = ?"
    AAdd(aBind, {"C", xFilial("NTJ")})
    cQuery +=   " AND NTJ.NTJ_CCONTR = ?"
    AAdd(aBind, {"C", cCodContrato})
    cQuery +=   " AND NTJ.D_E_L_E_T_ = ?"
    AAdd(aBind, {"C", ' '})
	cQuery += " UNION ALL "
    cQuery += "SELECT NTK.NTK_CTPDSP TIPO, 'N' TIMESHEET, 'S' DESPESA"
    cQuery +=  " FROM " + RetSqlName("NTK") + " NTK"
	cQuery += " WHERE NTK.NTK_FILIAL = ?"
    AAdd(aBind, {"C", xFilial("NTK")})
	cQuery +=   " AND NTK.NTK_CCONTR = ?"
	AAdd(aBind, {"C", cCodContrato})
    cQuery +=   " AND NTK.D_E_L_E_T_ = ?"
    AAdd(aBind, {"C", ' '})
    
    oQuery := FWPreparedStatement():New(cQuery)
    oQuery := JQueryPSPr(oQuery, aBind)
    cQuery := oQuery:GetFixQuery()
	MpSysOpenQuery(cQuery, cAlsQry)
	
	While (cAlsQry)->(!Eof())
		If !Empty((cAlsQry)->TIPO)
			If (cAlsQry)->TIMESHEET == 'S'
				If !oJSonRet["caso"]["contratos"][nIndiceContrato]:hasProperty("tipos_atividade_nao_cobravel")
					oJSonRet["caso"]["contratos"][nIndiceContrato]["tipos_atividade_nao_cobravel"] := {}
				EndIf
				Aadd(oJSonRet["caso"]["contratos"][nIndiceContrato]["tipos_atividade_nao_cobravel"], JsonObject():New())
				aTail(oJSonRet["caso"]["contratos"][nIndiceContrato]["tipos_atividade_nao_cobravel"])['tipo_atividade'] := (cAlsQry)->TIPO
			ElseIf (cAlsQry)->DESPESA == 'S'
				If !oJSonRet["caso"]["contratos"][nIndiceContrato]:hasProperty("tipos_despesa_nao_cobravel")
					oJSonRet["caso"]["contratos"][nIndiceContrato]["tipos_despesa_nao_cobravel"] := {}
				EndIf
				Aadd(oJSonRet["caso"]["contratos"][nIndiceContrato]["tipos_despesa_nao_cobravel"], JsonObject():New())
				aTail(oJSonRet["caso"]["contratos"][nIndiceContrato]["tipos_despesa_nao_cobravel"])['tipo_despesa'] := (cAlsQry)->TIPO
			EndIf
		EndIf
		(cAlsQry)->(DbSkip())
	EndDo
	(cAlsQry)->(dbCloseArea())
	
Return Nil

//-------------------------------------------------------------------
/*/{Protheus.doc} JAuditVerificaLancamentos
Retorna os lancamentos a faturar por Caso (TS, despesas ou tabelado).
@type function
@author Abner Fogaca de Oliveira
@since 13/08/2026
@param cCodCliente, character, Codigo do cliente
@param cCodLoja, character, Codigo da loja
@param cCodCaso, character, Codigo do caso
@param lCobraTS, logical, Indica se deve considerar lancamentos de TS cobraveis
@param lCobraDesp, logical, Indica se deve considerar lancamentos de despesas cobraveis
@param lCobraTab, logical, Indica se deve considerar lancamentos de tabelado cobraveis
@param oJSonRet, json, Objeto JSON onde serao adicionados os lancamentos encontrados
@return variant, Nil (resultado adicionado por referencia em oJSonRet)
/*/
//-------------------------------------------------------------------
Static Function JAuditVerificaLancamentos(cCodCliente as character, cCodLoja as character, cCodCaso as character, lCobraTS as logical, lCobraDesp as logical, lCobraTab as logical, oJSonRet as json) as variant
Local aArea     := GetArea()                        as array
Local aBind     := {}                               as array
Local nValor    := 0                                as numeric
Local nLanc     := 0                                as integer
Local cQuery    := ""                               as character
Local cQryRes   := ""                               as character
Local cMoedaNac := SuperGetMv('MV_JMOENAC',, '01') as character
Local cTpcnvl   := SuperGetMv('MV_JCONVLT',, '3')  as character
Local oQuery    as object

    Default lCobraTS   := .F.
    Default lCobraDesp := .F.
    Default lCobraTab  := .F.
    Default oJSonRet   := Nil

    Do Case
        Case lCobraTS .And. !lCobraTab
            cQuery := " SELECT SUM(NUE.NUE_VALOR) VALOR, NUE.NUE_CATIVI, NUE.NUE_CMOEDA CMOEDA, NUE_DATATS DTMOED "
            cQuery +=   " FROM " + RetSqlName("NUE") + " NUE "
            cQuery +=  " INNER JOIN " + RetSqlName("NRC") + " NRC"
            cQuery +=     " ON NRC.NRC_FILIAL = ?"
            AAdd(aBind, {"C", xFilial("NRC")})
            cQuery +=    " AND NRC.NRC_COD    = NUE.NUE_CATIVI"
            cQuery +=    " AND NRC.NRC_TEMPOZ = '1'"
            cQuery +=    " AND NRC.D_E_L_E_T_ = ?"
            AAdd(aBind, {"C", ' '})
            cQuery +=  " WHERE NUE.NUE_FILIAL = ?"
            AAdd(aBind, {"C", xFilial("NUE")})
            cQuery +=    " AND NUE.NUE_CCLIEN = ?"
            AAdd(aBind, {"C", cCodCliente})
            cQuery +=    " AND NUE.NUE_CLOJA  = ?"
            AAdd(aBind, {"C", cCodLoja})
            cQuery +=    " AND NUE.NUE_CCASO  = ?"
            AAdd(aBind, {"C", cCodCaso})
            cQuery +=    " AND NUE.NUE_SITUAC = ?"
            AAdd(aBind, {"C", '1'})
            cQuery +=    " AND NUE.NUE_COBRAR = ?"
            AAdd(aBind, {"C", '1'})
            cQuery +=    " AND NUE.D_E_L_E_T_ = ?"
            AAdd(aBind, {"C", ' '})
            cQuery +=  " GROUP BY NUE.NUE_CATIVI, NUE.NUE_CMOEDA, NUE.NUE_DATATS "

        Case lCobraTab .And. !lCobraTS
            cQuery := " SELECT SUM(NV4.NV4_VLHFAT) VALOR, NV4.NV4_CMOEH CMOEDA, NV4_DTCONC, "
            cQuery +=        " (CASE WHEN ? = '1' THEN NV4.NV4_DTLANC ELSE "
            AAdd(aBind, {"C", cTpcnvl})
            cQuery +=        " (CASE WHEN ? = '2' THEN NV4.NV4_DTINC ELSE NV4.NV4_DTCONC END) "
            AAdd(aBind, {"C", cTpcnvl})
            cQuery +=         " END) DTMOED "
            cQuery +=   " FROM " + RetSqlName('NV4') + " NV4 "
            cQuery +=  " WHERE NV4.NV4_FILIAL = ?"
            AAdd(aBind, {"C", xFilial("NV4")})
            cQuery +=    " AND NV4.NV4_CCLIEN = ?"
            AAdd(aBind, {"C", cCodCliente})
            cQuery +=    " AND NV4.NV4_CLOJA  = ?"
            AAdd(aBind, {"C", cCodLoja})
            cQuery +=    " AND NV4.NV4_CCASO  = ?"
            AAdd(aBind, {"C", cCodCaso})
            cQuery +=    " AND NV4.NV4_SITUAC = ?"
            AAdd(aBind, {"C", '1'})
            cQuery +=    " AND NV4.NV4_COBRAR = ?"
            AAdd(aBind, {"C", '1'})
            cQuery +=    " AND NV4.NV4_CONC   = ?"
            AAdd(aBind, {"C", '1'})
            cQuery +=    " AND NV4.D_E_L_E_T_ = ?"
            AAdd(aBind, {"C", ' '})
            cQuery +=  " GROUP BY NV4.NV4_CMOEH, NV4.NV4_DTLANC, NV4.NV4_DTINC, NV4.NV4_DTCONC "

        Case lCobraDesp
            cQuery := " SELECT SUM(NVY.NVY_VALOR) VALOR, NVY.NVY_CTPDSP, NVY.NVY_CMOEDA CMOEDA, NVY.NVY_DATA DTMOED "
            cQuery +=   " FROM " + RetSqlName("NVY") + " NVY "
            cQuery +=  " INNER JOIN " + RetSqlName("NRH") + " NRH"
            cQuery +=     " ON NRH.NRH_FILIAL = ?"
            AAdd(aBind, {"C", xFilial("NRH")})
            cQuery +=    " AND NRH.NRH_COD    = NVY.NVY_CTPDSP"
            cQuery +=    " AND NRH.NRH_COBRAR = ?"
            AAdd(aBind, {"C", '1'})
            cQuery +=    " AND NRH.D_E_L_E_T_ = ?"
            AAdd(aBind, {"C", ' '})
            cQuery +=  " WHERE NVY.NVY_FILIAL = ?"
            AAdd(aBind, {"C", xFilial("NVY")})
            cQuery +=    " AND NVY.NVY_CCLIEN = ?"
            AAdd(aBind, {"C", cCodCliente})
            cQuery +=    " AND NVY.NVY_CLOJA  = ?"
            AAdd(aBind, {"C", cCodLoja})
            cQuery +=    " AND NVY.NVY_CCASO  = ?"
            AAdd(aBind, {"C", cCodCaso})
            cQuery +=    " AND NVY.NVY_COBRAR = ?"
            AAdd(aBind, {"C", '1'})
            cQuery +=    " AND NVY.NVY_SITUAC = ?"
            AAdd(aBind, {"C", '1'})
            cQuery +=    " AND NVY.D_E_L_E_T_ = ?"
            AAdd(aBind, {"C", ' '})
            cQuery +=  " GROUP BY NVY.NVY_CTPDSP, NVY.NVY_CMOEDA, NVY.NVY_DATA "
    EndCase

    oQuery := FWPreparedStatement():New(cQuery)
    oQuery := JQueryPSPr(oQuery, aBind)
    cQuery := oQuery:GetFixQuery()

    cQryRes := GetNextAlias()
    MpSysOpenQuery(cQuery, cQryRes)

    While !(cQryRes)->(EOF())
        nLanc++
        If (cQryRes)->CMOEDA != cMoedaNac
            nValor := JA201FConv(cMoedaNac, (cQryRes)->CMOEDA, (cQryRes)->VALOR, "1", StoD((cQryRes)->DTMOED))[1]
        Else
            nValor := (cQryRes)->VALOR
        EndIf

        If lCobraTS
            If oJSonRet["caso"]:hasProperty("timesheets_pendentes")
                Aadd(oJSonRet["caso"]["timesheets_pendentes"], JsonObject():New())
                nLanc := Len(oJSonRet["caso"]["timesheets_pendentes"])
            Else
                oJSonRet["caso"]["timesheets_pendentes"] := {}
                Aadd(oJSonRet["caso"]["timesheets_pendentes"], JsonObject():New())
            EndIf
            oJSonRet["caso"]["timesheets_pendentes"][nLanc]["tipo_atividade"] := (cQryRes)->NUE_CATIVI
            oJSonRet["caso"]["timesheets_pendentes"][nLanc]["valor_pendente"] := nValor
            oJSonRet["caso"]["timesheets_pendentes"][nLanc]["anomes"]         := Anomes(StoD((cQryRes)->DTMOED))
        EndIf

        If lCobraDesp
            If oJSonRet["caso"]:hasProperty("despesas_pendentes")
                Aadd(oJSonRet["caso"]["despesas_pendentes"], JsonObject():New())
                nLanc := Len(oJSonRet["caso"]["despesas_pendentes"])
            Else
                oJSonRet["caso"]["despesas_pendentes"] := {}
                Aadd(oJSonRet["caso"]["despesas_pendentes"], JsonObject():New())
            EndIf
            oJSonRet["caso"]["despesas_pendentes"][nLanc]["tipo_despesa"]   := (cQryRes)->NVY_CTPDSP
            oJSonRet["caso"]["despesas_pendentes"][nLanc]["valor_pendente"] := nValor
            oJSonRet["caso"]["despesas_pendentes"][nLanc]["anomes"]         := Anomes(StoD((cQryRes)->DTMOED))
        EndIf

        If lCobraTab
            If oJSonRet["caso"]:hasProperty("tabelado_pendentes")
                Aadd(oJSonRet["caso"]["tabelado_pendentes"], JsonObject():New())
                nLanc := Len(oJSonRet["caso"]["tabelado_pendentes"])
            Else
                oJSonRet["caso"]["tabelado_pendentes"] := {}
                Aadd(oJSonRet["caso"]["tabelado_pendentes"], JsonObject():New())
            EndIf
            oJSonRet["caso"]["tabelado_pendentes"][nLanc]["valor_pendente"] := nValor
            oJSonRet["caso"]["tabelado_pendentes"][nLanc]["anomes"]         := Anomes(StoD((cQryRes)->NV4_DTCONC))
        EndIf

        (cQryRes)->(DbSkip())
    EndDo

    (cQryRes)->(DbCloseArea())
    RestArea(aArea)

Return Nil
