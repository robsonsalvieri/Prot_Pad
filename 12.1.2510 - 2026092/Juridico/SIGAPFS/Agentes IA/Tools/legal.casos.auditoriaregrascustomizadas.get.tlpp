/*/
//-------------------------------------------------------------------
method getMetrics() as array class auditoriaregrascustomizadas
    Local jMetrics := {}
return jMetrics

//------------------------------------------------------------------
/*/{Protheus.doc} auditoriaregrascustomizadas::process
Processa o payload e retorna a estrutura de campos auditaveis por submodelo.
@type method
@author Abner Oliveira
@since 12/08/2026
@param jPayLoad, json, Payload com codcliente, codloja, codcaso, context e submodels
@return json, JSON com array structures contendo os submodelos e seus campos
/*/
//-------------------------------------------------------------------
method process(jPayLoad as json) as json class auditoriaregrascustomizadas
	Local jResp          as json
	Local jStruct        as json
	Local jFiltered      as json
	Local jNRAField      as json
	Local cCodCliente    := "" as character
	Local cCodLoja       := "" as character
	Local cCodCaso       := "" as character
	Local cQryCasos      := "" as character
	Local cAlsQryCasos   := "" as character
	Local cUltContr      := "" as character
	Local nSizeCustomer  := TamSX3("A1_COD")[1]     // Tamanho do campo Codigo Cliente
	Local nSizeStore     := TamSX3("A1_LOJA")[1]    // Tamanho do campo Codigo Loja
	Local nSizeMatter    := TamSX3("NVE_NUMCAS")[1] // Tamanho do campo Numero do Caso
	Local aArea          as array
	Local aStructures    := {} as array
	Local aSubModels     as array
	Local aJura096Mdls   := {"NT0MASTER", "NT1DETAIL"} as array
	Local nI             := 0 as numeric
	Local lNeedJura096   := .F. as logical
	Local cSubModel      := "" as character
	Local cRoutine       := "" as character
	Local cValidModels   := "" as character
	Local aValidModels   := {"SA1MASTER", "NVEMASTER", "NT0MASTER", "NT1DETAIL"} as array

	jResp := JsonObject():new()

	If jPayLoad:hasProperty("codcliente") .And. jPayLoad:hasProperty("codloja") .And. ;
	   jPayLoad:hasProperty("codcaso") .And. jPayLoad:hasProperty("context") .And. ;
	   !Empty(jPayLoad["codcliente"]) .And. !Empty(jPayLoad["codcaso"]) .And. ;
	   jPayLoad:hasProperty("submodels") .And. !Empty(jPayLoad["submodels"])
		
		aArea       := GetArea()
		cCodCliente := jPayLoad["codcliente"]
		cCodLoja    := jPayLoad["codloja"]
		cCodCaso    := jPayLoad["codcaso"]
		aSubModels  := jPayLoad["submodels"]

		// Verifica se algum submodelo do JURA096 foi solicitado
		For nI := 1 To Len(aSubModels)
			If AScan(aJura096Mdls, {|x| x == aSubModels[nI]["id"]}) > 0
				lNeedJura096 := .T.
				Exit
			EndIf
		Next nI

		If FindFunction("JStructMdl")

			For nI := 1 To Len(aSubModels)
				cSubModel := aSubModels[nI]["id"]
				cRoutine  := ""

				Do Case
					Case cSubModel == "SA1MASTER"
						cRoutine := "JURA148"
						dbSelectArea("SA1")
						SA1->(dbSetOrder(1)) // A1_FILIAL + A1_COD + A1_LOJA
						If !SA1->(dbSeek(xFilial("SA1") + PadR(cCodCliente, nSizeCustomer) + PadR(cCodLoja, nSizeStore)))
							jResp["error"] := {"message": STR0001} // "Cliente não encontrado na base de dados para os parâmetros informados."
							Return jResp
						EndIf

					Case cSubModel == "NVEMASTER"
						cRoutine := "JURA070"
						dbSelectArea("NVE")
						NVE->(dbSetOrder(1)) // NVE_FILIAL + NVE_CCLIEN + NVE_LCLIEN + NVE_NUMCAS
						If !NVE->(dbSeek(xFilial("NVE") + PadR(cCodCliente, nSizeCustomer) + PadR(cCodLoja, nSizeStore) + PadR(cCodCaso, nSizeMatter)))
							jResp["error"] := {"message": STR0002} // "Caso não encontrado na base de dados para os parâmetros informados."
							Return jResp
						EndIf

					OtherWise
						// Submodelo não reconhecido
						If AScan(aValidModels, {|x| x == cSubModel}) == 0
						
							AEval(aValidModels, {|x| cValidModels += ", " + x})
							
							cValidModels := SubStr(cValidModels, 3)
							
							If RAt(", ", cValidModels) > 0
								cValidModels := Left(cValidModels, RAt(", ", cValidModels) - 1) + " e " + SubStr(cValidModels, RAt(", ", cValidModels) + 2)
							EndIf
							
							jResp["error"] := {"message": I18n(STR0003, {cSubModel, cValidModels})} // "Submodelo #1 não é válido para esta tool. Os modelos válidos são: #2"
							RestArea(aArea)
							Return jResp
						EndIf
				EndCase

				If !Empty(cRoutine)
					jStruct := JStructMdl(cRoutine, /*cNomeCampo*/, .F., .T., /*lPropTable*/, .T.)
					If ValType(jStruct) != "U"
						jFiltered := FilterStruct(jStruct, cSubModel)
						If !Empty(jFiltered["submodel"])
							AAdd(aStructures, jFiltered)
						EndIf
					EndIf
				EndIf
			Next nI

			// 3. Consulta e busca de todos os contratos vinculados ao caso (JURA096 -> NT0MASTER, NT1DETAIL)
			If lNeedJura096
				cQryCasos    := JQryCasos(cCodCliente, cCodLoja, cCodCaso)
				cAlsQryCasos := GetNextAlias()
				MpSysOpenQuery(cQryCasos, cAlsQryCasos)

				dbSelectArea("NT0")
				NT0->(dbSetOrder(1)) // NT0_FILIAL + NT0_COD
				
				While (cAlsQryCasos)->(!Eof())
					If !Empty((cAlsQryCasos)->NT0_COD) .And. (cAlsQryCasos)->NT0_COD != cUltContr
						cUltContr := (cAlsQryCasos)->NT0_COD
						If NT0->(dbSeek(xFilial("NT0") + cUltContr))
							jStruct := JStructMdl("JURA096", /*cNomeCampo*/, .F., .T., /*lPropTable*/, .T.)
							If ValType(jStruct) != "U"
								For nI := 1 To Len(aSubModels)
									If AScan(aJura096Mdls, {|x| x == aSubModels[nI]["id"]}) > 0
										jFiltered := FilterStruct(jStruct, aSubModels[nI]["id"])
										If !Empty(jFiltered["submodel"])
											If aSubModels[nI]["id"] == "NT0MASTER"
												jNRAField               := JsonObject():new()
												jNRAField["id"]         := "NRA_COBRAH"
												jNRAField["fieldValue"] := JurGetDados("NRA", 1, xFilial("NRA") + (cAlsQryCasos)->NT0_CTPHON, "NRA_COBRAH") // Tipo de Honorários
												AAdd(jFiltered["fields"], jNRAField)
											EndIf
											AAdd(aStructures, jFiltered)
										EndIf
									EndIf
								Next nI
							EndIf
						EndIf
					EndIf
					(cAlsQryCasos)->(DbSkip())
				EndDo
				(cAlsQryCasos)->(DbCloseArea())
			EndIf

			jResp["structures"] := aStructures
		Else
			jResp["error"] := {"message": STR0004} // "Função 'JStructMdl' não encontrada, verifique a data do fonte WSJurGenerico."
		EndIf
		RestArea(aArea)
	Else
		jResp["error"] := {"message": STR0005} // "Os parâmetros de entrada obrigatórios não foram informados corretamente."
	EndIf

Return jResp

//-----------------------------------------------------------------
/*/{Protheus.doc} JQryCasos
Consulta os casos cobráveis e os contratos vinculados ao caso.
@type function
@author Abner Oliveira
@since 12/08/2026
@param cCodCliente, character, Código do cliente para filtro da consulta
@param cCodLoja, character, Código da loja para filtro da consulta
@param cCodCaso, character, Código do caso para filtro da consulta
@return character, String contendo a query SQL compilada
/*/
//-----------------------------------------------------------------
Static Function JQryCasos(cCodCliente as character, cCodLoja as character, cCodCaso as character) as character
	Local cQuery := ""
	Local aBind  := {}
	Local oQuery := Nil

	cQuery := "SELECT NVE_FILIAL, NVE_DTENTR, NVE_CCLIEN, NVE_LCLIEN, NVE_NUMCAS, NVE_TITULO, NVE_SITUAC, NVE_SITCAD, NVE_COBRAV, NVE_LANTS, NVE_LANDSP,"
	cQuery +=       " NVE_LANTAB, NVE_ENCHON, NVE_ENCDES, NVE_ENCTAB,NVE_CTABH, NT0_COD, NT0_NOME, NT0_SIT, NT0_ATIVO, NT0_DESPES, NT0_ENCH, NT0_ENCD,"
	cQuery +=       " NT0_CTPHON, NT0_ENCT, NRA_COBRAH, NT0_SERTAB, NT0_DTVIGI, NT0_DTVIGF, A1_ESTADO, A1_BAIRRO, NT1.NT1_DATAIN"
	cQuery +=  " FROM " + RetSqlName("NVE") + " NVE"
	cQuery += " INNER JOIN " + RetSqlName("SA1") + " SA1"
	cQuery +=    " ON SA1.A1_FILIAL = ?"
	Aadd(aBind, {"C", xFilial("SA1")})
	cQuery +=   " AND NVE.NVE_CCLIEN = SA1.A1_COD"
	cQuery +=   " AND NVE.NVE_LCLIEN = SA1.A1_LOJA"
	cQuery +=   " AND SA1.D_E_L_E_T_ = ?"
	Aadd(aBind, {"C", ' '})
	cQuery +=  " LEFT JOIN " + RetSqlName("NUT") + " NUT"
	cQuery +=    " ON NUT.NUT_CCLIEN = NVE.NVE_CCLIEN"
	cQuery +=   " AND NUT.NUT_CLOJA = NVE.NVE_LCLIEN"
	cQuery +=   " AND NUT.NUT_CCASO = NVE.NVE_NUMCAS"
	cQuery +=   " AND NUT.NUT_FILIAL = ?"
	Aadd(aBind, {"C", xFilial("NUT")})
	cQuery +=   " AND NUT.D_E_L_E_T_ = ?"
	Aadd(aBind, {"C", ' '})
	cQuery +=  " LEFT JOIN " + RetSqlName("NT0") + " NT0"
	cQuery +=    " ON NT0.NT0_COD = NUT.NUT_CCONTR"
	cQuery +=   " AND NT0.NT0_FILIAL = ?"
	Aadd(aBind, {"C", xFilial("NT0")})
	cQuery +=   " AND NT0.D_E_L_E_T_ = ?"
	Aadd(aBind, {"C", ' '})
	cQuery +=  " LEFT JOIN " + RetSqlName("NRA") + " NRA"
	cQuery +=    " ON NRA.NRA_COD = NT0.NT0_CTPHON"
	cQuery +=   " AND NRA.D_E_L_E_T_ = ?"
	Aadd(aBind, {"C", ' '})
	cQuery +=   " AND NRA.NRA_FILIAL = ?"
	Aadd(aBind, {"C", xFilial("NRA")})
	cQuery +=  " LEFT JOIN " + RetSqlName("NT1") + " NT1"
	cQuery +=    " ON NT1.NT1_CCONTR = NT0.NT0_COD"
	cQuery +=   " AND NT1.NT1_FILIAL = ?"
	Aadd(aBind, {"C", xFilial("NT1")})
	cQuery +=   " AND NT1.NT1_SITUAC = ?"
	Aadd(aBind, {"C", '1'}) // Restringe estritamente parcelas pendentes
	cQuery +=   " AND NT1.D_E_L_E_T_ = ?"
	Aadd(aBind, {"C", ' '})
	cQuery += " WHERE NVE.NVE_CCLIEN = ?"
	Aadd(aBind, {"C", cCodCliente})
	cQuery +=   " AND NVE.NVE_LCLIEN = ?"
	Aadd(aBind, {"C", cCodLoja})
	If !Empty(cCodCaso)
		cQuery +=   " AND NVE.NVE_NUMCAS = ?"
		Aadd(aBind, {"C", cCodCaso})
	EndIf
	cQuery +=   " AND NVE.D_E_L_E_T_ = ?"
	Aadd(aBind, {"C", ' '})
	
	oQuery := FWPreparedStatement():New(cQuery)
	oQuery := JQueryPSPr(oQuery, aBind)
	cQuery := oQuery:GetFixQuery()

Return cQuery

//------------------------------------------------------------------
/*/{Protheus.doc} FilterStruct
Filtra o JSON retornado por JStructMdl aplicando duas regras:
1 - Retorna apenas o item do array "struct" cujo "id" seja igual ao informado em cIdFilter.
2 - Para cada campo dentro de "fields", retorna apenas as propriedades especificadas.
@type function
@author Abner Oliveira
@since 12/08/2026
@param jResp, json, JSON completo retornado pela JStructMdl
@param cIdFilter, character, Id do struct a ser retornado (ex: "NVEMASTER", "SA1MASTER", "NT0MASTER")
@return json, Objeto JSON contendo a estrutura filtrada
/*/
//-------------------------------------------------------------------
Static Function FilterStruct(jResp as json, cIdFilter as character) as json
	Local jFiltered   := JsonObject():new()
	Local jStruct     := Nil
	Local jField      := Nil
	Local jFieldFilt  := Nil
	Local aStruct     := {}
	Local aFields     := {}
	Local aFieldsFilt := {}
	Local nI          := 0
	Local nJ          := 0
	Local cHelp       := ""
	Local cFieldValue := ""

	Default cIdFilter    := ""
	
	jFiltered["submodel"] := ""
	jFiltered["fields"]   := {}

	If ValType(jResp) == "J" .And. jResp:hasProperty("struct")
		aStruct := jResp["struct"]

		For nI := 1 To Len(aStruct)
			jStruct := aStruct[nI]

			If jStruct["id"] == cIdFilter
				aFields     := jStruct["fields"]
				aFieldsFilt := {}

				For nJ := 1 To Len(aFields)
					jField     := aFields[nJ]
					jFieldFilt := JsonObject():new()

					jFieldFilt["title"]       := jField["description"]
					jFieldFilt["options"]     := jField["options"]
					jFieldFilt["description"] := jField["descComplet"]

					cFieldValue := ""
					If jField:hasProperty("fieldValue")
						cFieldValue := cValToChar(jField["fieldValue"])
					EndIf
					jFieldFilt["fieldValue"] := cFieldValue
					
					cHelp := jField["help"]

					If !Empty(cHelp)
						cHelp := StrTran(cHelp, Chr(13) + Chr(10), " ")
						cHelp := StrTran(cHelp, Chr(13), " ")
						cHelp := StrTran(cHelp, Chr(10), " ")
						cHelp := StrTran(cHelp, Chr(9), " ")
						cHelp := StrTran(cHelp, Chr(0), "")
						cHelp := cleanString(DecodeUTF8(cHelp))
						cHelp := AllTrim(cHelp)
					EndIf

					jFieldFilt["help"] := cHelp

					aAdd(aFieldsFilt, jFieldFilt)
				Next nJ

				jFiltered["submodel"] := jStruct["id"]
				jFiltered["fields"]   := aFieldsFilt
				Exit
			EndIf
		Next nI
	EndIf

Return jFiltered
