#include "tlpp-object.th"
#include "tlpp-core.th"
#include "totvs.ch"
#include "fwmcptool.th"
#include "totvs.protheus.legal.casos.auditoriaregrascustomizadas.ch"

namespace totvs.protheus.legal.casos
using namespace totvs.framework.mcp.tools

//------------------------------------------------------------------
/*/{Protheus.doc} auditoriaregrascustomizadas
Tool MCP que retorna a estrutura de campos, help e valores de cliente, caso e contratos vinculados para auditoria.
@type class
@author Abner Oliveira
@since 12/08/2026
/*/
//------------------------------------------------------------------
@FWToolMCP(action="get", erpRelease="12.1.2510", routine="auditoriaregrascustomizadas", option=2, module="SIGAPFS")
class auditoriaregrascustomizadas implements FWMCPTool
	public method new() as object
	public method getDescription() as character
	public method getNotes() as character
	public method getPayLoadSchema() as json
	public method getReturnSchema() as json
	public method getMetrics() as array
	public method process(jPayLoad as json) as json
endclass

//------------------------------------------------------------------
/*/{Protheus.doc} auditoriaregrascustomizadas::new
Construtor da classe auditoriaregrascustomizadas.
@type method
@author Abner Oliveira
@since 12/08/2026
@return object, Instância da classe
/*/
//-------------------------------------------------------------------
method new() as object class auditoriaregrascustomizadas
return self
//------------------------------------------------------------------
/*/{Protheus.doc} auditoriaregrascustomizadas::getDescription
Informa a descrição da tool.
@type method
@author Abner Oliveira
@since 12/08/2026
@return character, Descrição resumida da tool
/*/
//-------------------------------------------------------------------
method getDescription() as character class auditoriaregrascustomizadas
return "Auxilia a auditoria retornando a estrutura dos campos, help e valores com base em um cliente (SA1), caso (NVE) e contratos (NT0) informados."

//------------------------------------------------------------------
/*/{Protheus.doc} auditoriaregrascustomizadas::getNotes
Informa as notas adicionais sobre a tool.
@type method
@author Abner Oliveira
@since 12/08/2026
@return character, Notas com instruções de uso da tool
/*/
//-------------------------------------------------------------------
method getNotes() as character class auditoriaregrascustomizadas
return "Informe o código do cliente, loja e caso para listar a estrutura de campos, ajuda e valores gravados do cliente, caso e contratos vinculados."

//------------------------------------------------------------------
/*/{Protheus.doc} auditoriaregrascustomizadas::getPayLoadSchema
Metodo responsavel por informar o schema de entrada da Tool.
@type method
@author Abner Oliveira
@since  12/08/2026
@return json, Schema JSON de entrada da tool
/*/
//-------------------------------------------------------------------
method getPayLoadSchema() as json class auditoriaregrascustomizadas
Local jSchema := JsonObject():New() as json

    jSchema:FromJson(;
        '{'                                                                                            +;
        '  "type" : "object",'                                                                         +;
        '  "required" : [ "codcliente", "codloja", "codcaso", "context", "submodels" ],'               +;
        '  "properties" : {'                                                                           +;
        '    "context" : {'                                                                            +;
        '      "type" : "string",'                                                                     +;
        '      "description" : "Contexto de empresa e filial a ser considerado no ERP."'               +;
        '    },'                                                                                       +;
        '    "codloja" : {'                                                                            +;
        '      "type" : "string",'                                                                     +;
        '      "description" : "Código da loja associada ao caso."'                                    +;
        '    },'                                                                                       +;
        '    "codcaso" : {'                                                                            +;
        '      "type" : "string",'                                                                     +;
        '      "description" : "Código do caso que está sendo auditado."'                              +;
        '    },'                                                                                       +;
        '    "codcliente" : {'                                                                         +;
        '      "type" : "string",'                                                                     +;
        '      "description" : "Código do cliente no sistema."'                                        +;
        '    },'                                                                                       +;
        '    "submodels" : {'                                                                          +;
        '      "type" : "array",'                                                                      +;
        '      "description" : "Lista de submodelos das rotinas relacionados ao caso de auditoria.",'  +;
        '      "items" : {'                                                                            +;
        '        "type" : "object",'                                                                   +;
        '        "properties" : {'                                                                     +;
        '          "id" : { "type" : "string" }'                                                       +;
        '        }'                                                                                    +;
        '      }'                                                                                      +;
        '    }'                                                                                        +;
        '  }'                                                                                          +;
        '}' )

Return jSchema

//------------------------------------------------------------------
/*/{Protheus.doc} auditoriaregrascustomizadas::getReturnSchema
Metodo responsavel por informar o schema de retorno da Tool.
@type method
@author Abner Oliveira
@since 12/08/2026
@return json, Schema JSON de retorno da tool
/*/
//-------------------------------------------------------------------
method getReturnSchema() as json class auditoriaregrascustomizadas
	Local jSchema := {;
		"type": "object",;
		"required": {"structures"},;
		"properties": {;
			"structures": {;
				"type": "array",;
				"description" : "Lista de estruturas de submodelos retornadas pela auditoria.",;
				"items": {;
					"type": "object",;
					"required": {"submodel", "fields"},;
					"properties": {;
						"submodel": {"type": "string"},;
						"description" : "Identificador do submodelo da rotina (ex: NVEMASTER, NT0MASTER).",;
						"fields": {;
							"type": "array",;
							"description" : "Lista de campos auditáveis associados ao submodelo.",;
							"items": {;
								"type": "object",;
								"properties": {;
									"help": {;
										"type": "string",;
										"description" : "Texto de ajuda ou instrução de preenchimento do campo.";
									},;
									"title": {;
										"type": "string",;
										"description" : "Título ou nome amigável do campo.";
									},;
									"options": {;
										"type": "array",;
										"description" : "Opções disponíveis do campo (aplicável a campos do tipo combo).";
									},;
									"fieldValue": {;
										"type": "string",;
										"description" : "Valor atual que está gravado no campo no banco de dados.";
									},;
									"description": {;
										"type": "string",;
										"description" : "Descrição detalhada do campo no dicionário de dados.";
									};
								};
							};
						};
					};
				};
			};
		};
	}

return jSchema

