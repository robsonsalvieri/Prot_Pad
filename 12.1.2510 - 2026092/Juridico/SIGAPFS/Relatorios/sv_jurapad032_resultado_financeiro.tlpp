#INCLUDE "JURAPAD032.CH"
#INCLUDE "protheus.ch"
#INCLUDE "totvs.ch"
#INCLUDE "msobject.ch"
#INCLUDE "totvs.framework.treports.integratedprovider.th"

namespace totvs.protheus.legal.sigapfs.jurapad032_resultado_financeiro.integratedprovider

@totvsFrameworkTReportsIntegratedProvider(active=.T.,;
	team='SIGAPFS',;
	tables='OHB,SED,SE7,NS7',;
	name='Resultado Financeiro',;
	country='ALL',;
	initialRelease='12.1.2210')

//------------------------------------------------------------------------------------
class jurapad032_resultado_financeiro from totvs.framework.treports.integratedprovider.IntegratedProvider
public    method new()         as object
public    method getData()     as object
public    method getSchema()   as object

endclass

//------------------------------------------------------------------------------------
method new() class jurapad032_resultado_financeiro
	_Super:new()

	//Define a área
	self:appendArea(STR0038) // "Pré-Faturamento Serviços"

	//Define o nome do Objeto de Negócio
	self:setDisplayName(STR0014) // "Relatório de Resultado Financeiro"

	//Define a descrição do Objeto de Negócio
	self:setDescription(STR0040) // "Objeto de Negócio de Resultado Financeiro"

	self:setPergunte("JURAPAD032")

Return self

//------------------------------------------------------------------------------------
method getData(nPage as numeric, oFilter as object) as object class jurapad032_resultado_financeiro
Local jParams    := oFilter:getParameters()
Local aArea      := GetArea()
Local cQuery     := ""
Local cTpContTmp := ""
Local cFilEscr   := ""
Local cTempEnt   := GetNextAlias()
Local cTempEsc   := GetNextAlias()
Local cTempCus   := GetNextAlias()
Local cTempDes   := GetNextAlias()
Local cTempObr   := GetNextAlias()
Local cTempInv   := GetNextAlias()
Local aEscrit    := {}
Local aMeses     := {}
Local aAllMeses  := {}
Local aEntradas  := {0, 0, 0, 0, 0, 0, 0, 0, 0} // Inicializa o Array com 9 posições sendo todos com 0 (zero)
Local aTotEntra  := {0, 0, 0, 0, 0, 0, 0, 0, 0} // Inicializa o Array com 9 posições sendo todos com 0 (zero)
Local aCustos    := {0, 0, 0, 0, 0, 0, 0, 0, 0} // Inicializa o Array com 9 posições sendo todos com 0 (zero)
Local aTotCustos := {0, 0, 0, 0, 0, 0, 0, 0, 0} // Inicializa o Array com 9 posições sendo todos com 0 (zero)
Local aMargem    := {0, 0, 0, 0, 0, 0, 0, 0, 0} // Inicializa o Array com 9 posições sendo todos com 0 (zero)
Local aDespes    := {0, 0, 0, 0, 0, 0, 0, 0, 0} // Inicializa o Array com 9 posições sendo todos com 0 (zero)
Local aTotDespes := {0, 0, 0, 0, 0, 0, 0, 0, 0} // Inicializa o Array com 9 posições sendo todos com 0 (zero)
Local aResuIR    := {0, 0, 0, 0, 0, 0, 0, 0, 0} // Inicializa o Array com 9 posições sendo todos com 0 (zero)
Local aObriga    := {0, 0, 0, 0, 0, 0, 0, 0, 0} // Inicializa o Array com 9 posições sendo todos com 0 (zero)
Local aTotObriga := {0, 0, 0, 0, 0, 0, 0, 0, 0} // Inicializa o Array com 9 posições sendo todos com 0 (zero)
Local aResuLi    := {0, 0, 0, 0, 0, 0, 0, 0, 0} // Inicializa o Array com 9 posições sendo todos com 0 (zero)
Local aInvest    := {0, 0, 0, 0, 0, 0, 0, 0, 0} // Inicializa o Array com 9 posições sendo todos com 0 (zero)
Local aTotInvest := {0, 0, 0, 0, 0, 0, 0, 0, 0} // Inicializa o Array com 9 posições sendo todos com 0 (zero)
Local nI         := 0
Local nLenaMeses := 0
Local nDif       := 0
Local oJsDados   as object
Local oTpConta   := JurTpConta():New()
Local lParamOk   := .T.

	/*
		MV_PAR01 - Ano de referência
		MV_PAR02 - Mês de referência inicial
		MV_PAR03 - Mês de referência final
		MV_PAR04 - Código do Escritório
	*/

	// Validação do preenchimento do Ano
	If jParams['MV_PAR01'][1] < 0
		self:setErrorStatus(400, STR0001, STR0002) // // "O ano não pode ser negativo." - "Informe um ano valido."
		lParamOk := .F.
	ElseIf lParamOk .And. (Empty(jParams['MV_PAR01'][1]) .Or. jParams['MV_PAR01'][1] == 0)
		self:setErrorStatus(400, STR0009, STR0010) // "O ano é obrigatório." - "Informe um ano válido."
		lParamOk := .F.
	EndIf

	// Validação dos Meses
	If lParamOk .And. (jParams['MV_PAR02'][1] < 0 .Or. jParams['MV_PAR03'][1] < 0)
		self:setErrorStatus(400, STR0003, STR0004) // "O mês não pode ser negativo." - "Informe um mês valido."
		lParamOk := .F.
	ElseIf lParamOk .And. (Empty(jParams['MV_PAR02'][1]) .Or. Empty(jParams['MV_PAR03'][1]) .Or. jParams['MV_PAR02'][1] == 0 .Or. jParams['MV_PAR03'][1] == 0)
		self:setErrorStatus(400, STR0011, STR0012) // "O mês é obrigatório." - "Informe um mês válido."
		lParamOk := .F.
	ElseIf lParamOk .And. (jParams['MV_PAR02'][1] > 12 .Or. jParams['MV_PAR03'][1] > 12) // Validação de Mês maior que 12
		self:setErrorStatus(400, STR0005, STR0004) // "Mês não pode ser maior que '12'." - "Informe um mês valido."
		lParamOk := .F.
	ElseIf lParamOk .And. jParams['MV_PAR02'][1] > 0 .And. jParams['MV_PAR03'][1] > 0 .And. jParams['MV_PAR02'][1] > jParams['MV_PAR03'][1] // Validação de mês inicial maior que final
		self:setErrorStatus(400, STR0006, STR0004) // "O mês inicial não pode ser maior que o mês final." - "Informe um mês valido."
		lParamOk := .F.
	ElseIf lParamOk .And. (jParams['MV_PAR03'][1] - jParams['MV_PAR02'][1] + 1) > 6
		self:setErrorStatus(400, I18N(STR0013, {'6'}), STR0004) // "O periódo não pode ser maior que 6 meses" - "Informe um mês valido."
		lParamOk := .F.
	EndIf

	// Validação do Escritório
	If lParamOk .And. !Empty(jParams['MV_PAR04'][1]) .And. Empty(JurGetDados("NS7", 1, xFilial("NS7") + jParams['MV_PAR04'][1], "NS7_COD"))
		self:setErrorStatus(400, STR0007, STR0008) // "Escritório não encontrado." - "Informe um escritório valido."
		lParamOk := .F.
	EndIf

	If lParamOk
		aMeses     := JGetMeses(jParams['MV_PAR01'][1], jParams['MV_PAR02'][1], jParams['MV_PAR03'][1])
		aAllMeses  := aClone(aMeses)
		nLenaMeses := Len(aMeses)
		nDif       := 6 - nLenaMeses

		oTpConta:GeraTmp()
		cTpContTmp := oTpConta:GetTmpName()
		
		oJsDados := JsonObject():new()

		cQuery := JBuscEscr(jParams['MV_PAR04'][1], aMeses)

		MPSysOpenQuery(cQuery, cTempEsc)

		While !(cTempEsc)->(Eof())

			cFilEscr := (cTempEsc)->NS7_CFILIA

			oJsDados["ESCRIT"] := (cTempEsc)->NS7_RAZAO
			For nI := 1 To nLenaMeses
				oJsDados["MES" + cValtoChar(nI)] := aMeses[nI][1]
			Next nI

			oJsDados["ENTRADAS"]      := STR0015 // "ENTRADAS"
			oJsDados["CUSTOS"]        := STR0017 // "CUSTOS"
			oJsDados["DESPESAS"]      := STR0020 // "DESPESAS"
			oJsDados["OBRIGACOES"]    := STR0023 // "OBRIGAÇÕES FISCAIS"
			oJsDados["INVESTIMENTOS"] := STR0026 // "INVESTIMENTOS"

			self:oData:appendData(oJsDados)

			If nDif > 0
				For nI := 1 To nDif
					aAdd(aAllMeses, {"VAZIO", Date(), "VAZIO"}) // Completa o array aAllMeses para não ter que tratar o tamanho em todas as demais chamadas
				Next nI
			EndIf

			cQuery := JSubReport("3", aMeses, cTpContTmp, jParams['MV_PAR01'][1], cFilEscr) // Query Entradas

			MPSysOpenQuery(cQuery, cTempEnt)

			oJsDados["Detalhes"]  := {}

			While !(cTempEnt)->(Eof())

				aEntradas[1]  := JGetValor(aAllMeses[1][1], cTempEnt)
				aEntradas[2]  := JGetValor(aAllMeses[2][1], cTempEnt)
				aEntradas[3]  := JGetValor(aAllMeses[3][1], cTempEnt)
				aEntradas[4]  := JGetValor(aAllMeses[4][1], cTempEnt)
				aEntradas[5]  := JGetValor(aAllMeses[5][1], cTempEnt)
				aEntradas[6]  := JGetValor(aAllMeses[6][1], cTempEnt)

				aTotEntra[1] := Iif(Empty(aTotEntra[1]), aEntradas[1]         , aTotEntra[1] + aEntradas[1]         ) // VALMES1
				aTotEntra[2] := Iif(Empty(aTotEntra[2]), aEntradas[2]         , aTotEntra[2] + aEntradas[2]         ) // VALMES2
				aTotEntra[3] := Iif(Empty(aTotEntra[3]), aEntradas[3]         , aTotEntra[3] + aEntradas[3]         ) // VALMES3
				aTotEntra[4] := Iif(Empty(aTotEntra[4]), aEntradas[4]         , aTotEntra[4] + aEntradas[4]         ) // VALMES4
				aTotEntra[5] := Iif(Empty(aTotEntra[5]), aEntradas[5]         , aTotEntra[5] + aEntradas[5]         ) // VALMES5
				aTotEntra[6] := Iif(Empty(aTotEntra[6]), aEntradas[6]         , aTotEntra[6] + aEntradas[6]         ) // VALMES6
				aTotEntra[7] := Iif(Empty(aTotEntra[7]), (cTempEnt)->REALIZADO, aTotEntra[7] + (cTempEnt)->REALIZADO) // Total Geral
				aTotEntra[8] := Iif(Empty(aTotEntra[8]), (cTempEnt)->ORCADO   , aTotEntra[8] + (cTempEnt)->ORCADO   ) // Orçamento
				aTotEntra[9] := Iif(Empty(aTotEntra[9]), (cTempEnt)->PERCEN   , aTotEntra[9] + (cTempEnt)->PERCEN   ) // Percentual

				aAdd(oJsDados["Detalhes"], {"NATUREZA" : (cTempEnt)->ED_CODIGO + ' - ' + (cTempEnt)->ED_DESCRIC,;
											"VALMES1"  : aEntradas[1],;
											"VALMES2"  : aEntradas[2],;
											"VALMES3"  : aEntradas[3],;
											"VALMES4"  : aEntradas[4],;
											"VALMES5"  : aEntradas[5],;
											"VALMES6"  : aEntradas[6],;
											"TOTAL"    : (cTempEnt)->REALIZADO,;
											"ORCADO"   : (cTempEnt)->ORCADO,;
											"PERC"     : (cTempEnt)->PERCEN})

				(cTempEnt)->(DBSkip())
			EndDo

			oJsDados["TIPO"]    := STR0016 // "1 - TOTAL DE ENTRADAS"
			oJsDados["VALMES1"] := aTotEntra[1]
			oJsDados["VALMES2"] := aTotEntra[2]
			oJsDados["VALMES3"] := aTotEntra[3]
			oJsDados["VALMES4"] := aTotEntra[4]
			oJsDados["VALMES5"] := aTotEntra[5]
			oJsDados["VALMES6"] := aTotEntra[6]
			oJsDados["TOTAL"]   := aTotEntra[7]
			oJsDados["ORCADO"]  := aTotEntra[8]
			oJsDados["PERC"]    := Iif(Empty(aTotEntra[8]) .Or. aTotEntra[8] == 0, 0, (aTotEntra[7] / aTotEntra[8]) * 100)

			self:oData:appendData(oJsDados)

			cQuery := JSubReport("2", aMeses, cTpContTmp, jParams['MV_PAR01'][1], cFilEscr) // Query Custos

			MPSysOpenQuery(cQuery, cTempCus)

			oJsDados["Detalhes"]  := {}

			While !(cTempCus)->(Eof())

				aCustos[1]  := JGetValor(aAllMeses[1][1], cTempCus)
				aCustos[2]  := JGetValor(aAllMeses[2][1], cTempCus)
				aCustos[3]  := JGetValor(aAllMeses[3][1], cTempCus)
				aCustos[4]  := JGetValor(aAllMeses[4][1], cTempCus)
				aCustos[5]  := JGetValor(aAllMeses[5][1], cTempCus)
				aCustos[6]  := JGetValor(aAllMeses[6][1], cTempCus)

				aTotCustos[1] := Iif(Empty(aTotCustos[1]), aCustos[1]           , aTotCustos[1] + aCustos[1]           ) // VALMES1
				aTotCustos[2] := Iif(Empty(aTotCustos[2]), aCustos[2]           , aTotCustos[2] + aCustos[2]           ) // VALMES2
				aTotCustos[3] := Iif(Empty(aTotCustos[3]), aCustos[3]           , aTotCustos[3] + aCustos[3]           ) // VALMES3
				aTotCustos[4] := Iif(Empty(aTotCustos[4]), aCustos[4]           , aTotCustos[4] + aCustos[4]           ) // VALMES4
				aTotCustos[5] := Iif(Empty(aTotCustos[5]), aCustos[5]           , aTotCustos[5] + aCustos[5]           ) // VALMES5
				aTotCustos[6] := Iif(Empty(aTotCustos[6]), aCustos[6]           , aTotCustos[6] + aCustos[6]           ) // VALMES6
				aTotCustos[7] := Iif(Empty(aTotCustos[7]), (cTempCus)->REALIZADO, aTotCustos[7] + (cTempCus)->REALIZADO) // Total Geral
				aTotCustos[8] := Iif(Empty(aTotCustos[8]), (cTempCus)->ORCADO   , aTotCustos[8] + (cTempCus)->ORCADO   ) // Orçamento
				aTotCustos[9] := Iif(Empty(aTotCustos[9]), (cTempCus)->PERCEN   , aTotCustos[9] + (cTempCus)->PERCEN   ) // Percentual

				aAdd(oJsDados["Detalhes"], {"NATUREZA" : (cTempCus)->ED_CODIGO + ' - ' + (cTempCus)->ED_DESCRIC,;
											"VALMES1"  : aCustos[1],;
											"VALMES2"  : aCustos[2],;
											"VALMES3"  : aCustos[3],;
											"VALMES4"  : aCustos[4],;
											"VALMES5"  : aCustos[5],;
											"VALMES6"  : aCustos[6],;
											"TOTAL"    : (cTempCus)->REALIZADO,;
											"ORCADO"   : (cTempCus)->ORCADO,;
											"PERC"     : (cTempCus)->PERCEN})

				(cTempCus)->(DBSkip())
			EndDo

			oJsDados["TIPO"]    := STR0018 // "2 - TOTAL DE CUSTOS"
			oJsDados["VALMES1"] := aTotCustos[1]
			oJsDados["VALMES2"] := aTotCustos[2]
			oJsDados["VALMES3"] := aTotCustos[3]
			oJsDados["VALMES4"] := aTotCustos[4]
			oJsDados["VALMES5"] := aTotCustos[5]
			oJsDados["VALMES6"] := aTotCustos[6]
			oJsDados["TOTAL"]   := aTotCustos[7]
			oJsDados["ORCADO"]  := aTotCustos[8]
			oJsDados["PERC"]    := Iif(Empty(aTotCustos[8]) .Or. aTotCustos[8] == 0, 0, (aTotCustos[7] / aTotCustos[8]) * 100)

			self:oData:appendData(oJsDados)
			oJsDados["Detalhes"]  := {}

			aMargem[1] := aTotEntra[1] - aTotCustos[1]
			aMargem[2] := aTotEntra[2] - aTotCustos[2]
			aMargem[3] := aTotEntra[3] - aTotCustos[3]
			aMargem[4] := aTotEntra[4] - aTotCustos[4]
			aMargem[5] := aTotEntra[5] - aTotCustos[5]
			aMargem[6] := aTotEntra[6] - aTotCustos[6]
			aMargem[7] := aTotEntra[7] - aTotCustos[7]

			oJsDados["TIPO"]    := STR0019 // "3 - MARGEM DE CONTRIBUIÇÃO (1-2)"
			oJsDados["VALMES1"] := aMargem[1]
			oJsDados["VALMES2"] := aMargem[2]
			oJsDados["VALMES3"] := aMargem[3]
			oJsDados["VALMES4"] := aMargem[4]
			oJsDados["VALMES5"] := aMargem[5]
			oJsDados["VALMES6"] := aMargem[6]
			oJsDados["TOTAL"]   := aMargem[7]
			oJsDados["ORCADO"]  := 0
			oJsDados["PERC"]    := 0

			self:oData:appendData(oJsDados)

			cQuery := JSubReport("8", aMeses, cTpContTmp, jParams['MV_PAR01'][1], cFilEscr) // Query Despesas

			MPSysOpenQuery(cQuery, cTempDes)

			While !(cTempDes)->(Eof())

				aDespes[1] := JGetValor(aAllMeses[1][1], cTempDes)
				aDespes[2] := JGetValor(aAllMeses[2][1], cTempDes)
				aDespes[3] := JGetValor(aAllMeses[3][1], cTempDes)
				aDespes[4] := JGetValor(aAllMeses[4][1], cTempDes)
				aDespes[5] := JGetValor(aAllMeses[5][1], cTempDes)
				aDespes[6] := JGetValor(aAllMeses[6][1], cTempDes)

				aTotDespes[1] := Iif(Empty(aTotDespes[1]), aDespes[1]           , aTotDespes[1] + aDespes[1]           ) // VALMES1
				aTotDespes[2] := Iif(Empty(aTotDespes[2]), aDespes[2]           , aTotDespes[2] + aDespes[2]           ) // VALMES2
				aTotDespes[3] := Iif(Empty(aTotDespes[3]), aDespes[3]           , aTotDespes[3] + aDespes[3]           ) // VALMES3
				aTotDespes[4] := Iif(Empty(aTotDespes[4]), aDespes[4]           , aTotDespes[4] + aDespes[4]           ) // VALMES4
				aTotDespes[5] := Iif(Empty(aTotDespes[5]), aDespes[5]           , aTotDespes[5] + aDespes[5]           ) // VALMES5
				aTotDespes[6] := Iif(Empty(aTotDespes[6]), aDespes[6]           , aTotDespes[6] + aDespes[6]           ) // VALMES6
				aTotDespes[7] := Iif(Empty(aTotDespes[7]), (cTempDes)->REALIZADO, aTotDespes[7] + (cTempDes)->REALIZADO) // Total Geral
				aTotDespes[8] := Iif(Empty(aTotDespes[8]), (cTempDes)->ORCADO   , aTotDespes[8] + (cTempDes)->ORCADO   ) // Orçamento
				aTotDespes[9] := Iif(Empty(aTotDespes[9]), (cTempDes)->PERCEN   , aTotDespes[9] + (cTempDes)->PERCEN   ) // Percentual

				aAdd(oJsDados["Detalhes"], {"NATUREZA" : (cTempDes)->ED_CODIGO + ' - ' + (cTempDes)->ED_DESCRIC,;
											"VALMES1"  : aDespes[1],;
											"VALMES2"  : aDespes[2],;
											"VALMES3"  : aDespes[3],;
											"VALMES4"  : aDespes[4],;
											"VALMES5"  : aDespes[5],;
											"VALMES6"  : aDespes[6],;
											"TOTAL"    : (cTempDes)->REALIZADO,;
											"ORCADO"   : (cTempDes)->ORCADO,;
											"PERC"     : (cTempDes)->PERCEN})

				(cTempDes)->(DBSkip())
			EndDo

			oJsDados["TIPO"]    := STR0021 // "4 - TOTAL DE DESPESAS"
			oJsDados["VALMES1"] := aTotDespes[1]
			oJsDados["VALMES2"] := aTotDespes[2]
			oJsDados["VALMES3"] := aTotDespes[3]
			oJsDados["VALMES4"] := aTotDespes[4]
			oJsDados["VALMES5"] := aTotDespes[5]
			oJsDados["VALMES6"] := aTotDespes[6]
			oJsDados["TOTAL"]   := aTotDespes[7]
			oJsDados["ORCADO"]  := aTotDespes[8]
			oJsDados["PERC"]    := Iif(Empty(aTotDespes[8]) .Or. aTotDespes[8] == 0, 0, (aTotDespes[7] / aTotDespes[8]) * 100)

			self:oData:appendData(oJsDados)
			oJsDados["Detalhes"]  := {}

			aResuIR[1] := aMargem[1] - aTotDespes[1]
			aResuIR[2] := aMargem[2] - aTotDespes[2]
			aResuIR[3] := aMargem[3] - aTotDespes[3]
			aResuIR[4] := aMargem[4] - aTotDespes[4]
			aResuIR[5] := aMargem[5] - aTotDespes[5]
			aResuIR[6] := aMargem[6] - aTotDespes[6]
			aResuIR[7] := aMargem[7] - aTotDespes[7]

			oJsDados["TIPO"]    := STR0022 // "5 - RESULTADO ANTES DO IR (3-4)"
			oJsDados["VALMES1"] := aResuIR[1]
			oJsDados["VALMES2"] := aResuIR[2]
			oJsDados["VALMES3"] := aResuIR[3]
			oJsDados["VALMES4"] := aResuIR[4]
			oJsDados["VALMES5"] := aResuIR[5]
			oJsDados["VALMES6"] := aResuIR[6]
			oJsDados["TOTAL"]   := aResuIR[7]
			oJsDados["ORCADO"]  := 0
			oJsDados["PERC"]    := 0

			self:oData:appendData(oJsDados)

			cQuery := JSubReport("6", aMeses, cTpContTmp, jParams['MV_PAR01'][1], cFilEscr) // Query Obrigações Fiscais

			MPSysOpenQuery(cQuery, cTempObr)

			While !(cTempObr)->(Eof())

				aObriga[1] := JGetValor(aAllMeses[1][1], cTempObr)
				aObriga[2] := JGetValor(aAllMeses[2][1], cTempObr)
				aObriga[3] := JGetValor(aAllMeses[3][1], cTempObr)
				aObriga[4] := JGetValor(aAllMeses[4][1], cTempObr)
				aObriga[5] := JGetValor(aAllMeses[5][1], cTempObr)
				aObriga[6] := JGetValor(aAllMeses[6][1], cTempObr)

				aTotObriga[1] := Iif(Empty(aTotObriga[1]), aObriga[1]           , aTotObriga[1] + aObriga[1]           ) // VALMES1
				aTotObriga[2] := Iif(Empty(aTotObriga[2]), aObriga[2]           , aTotObriga[2] + aObriga[2]           ) // VALMES2
				aTotObriga[3] := Iif(Empty(aTotObriga[3]), aObriga[3]           , aTotObriga[3] + aObriga[3]           ) // VALMES3
				aTotObriga[4] := Iif(Empty(aTotObriga[4]), aObriga[4]           , aTotObriga[4] + aObriga[4]           ) // VALMES4
				aTotObriga[5] := Iif(Empty(aTotObriga[5]), aObriga[5]           , aTotObriga[5] + aObriga[5]           ) // VALMES5
				aTotObriga[6] := Iif(Empty(aTotObriga[6]), aObriga[6]           , aTotObriga[6] + aObriga[6]           ) // VALMES6
				aTotObriga[7] := Iif(Empty(aTotObriga[7]), (cTempObr)->REALIZADO, aTotObriga[7] + (cTempObr)->REALIZADO) // Total Geral
				aTotObriga[8] := Iif(Empty(aTotObriga[8]), (cTempObr)->ORCADO   , aTotObriga[8] + (cTempObr)->ORCADO   ) // Orçamento
				aTotObriga[9] := Iif(Empty(aTotObriga[9]), (cTempObr)->PERCEN   , aTotObriga[9] + (cTempObr)->PERCEN   ) // Percentual

				aAdd(oJsDados["Detalhes"], {"NATUREZA" : (cTempObr)->ED_CODIGO + ' - ' + (cTempObr)->ED_DESCRIC,;
											"VALMES1"  : aObriga[1],;
											"VALMES2"  : aObriga[2],;
											"VALMES3"  : aObriga[3],;
											"VALMES4"  : aObriga[4],;
											"VALMES5"  : aObriga[5],;
											"VALMES6"  : aObriga[6],;
											"TOTAL"    : (cTempObr)->REALIZADO,;
											"ORCADO"   : (cTempObr)->ORCADO,;
											"PERC"     : (cTempObr)->PERCEN})

				(cTempObr)->(DBSkip())
			EndDo

			oJsDados["TIPO"]    := STR0024 // "6 - TOTAL DE OBRIGAÇÕES"
			oJsDados["VALMES1"] := aTotObriga[1]
			oJsDados["VALMES2"] := aTotObriga[2]
			oJsDados["VALMES3"] := aTotObriga[3]
			oJsDados["VALMES4"] := aTotObriga[4]
			oJsDados["VALMES5"] := aTotObriga[5]
			oJsDados["VALMES6"] := aTotObriga[6]
			oJsDados["TOTAL"]   := aTotObriga[7]
			oJsDados["ORCADO"]  := aTotObriga[8]
			oJsDados["PERC"]    := Iif(Empty(aTotObriga[8]) .Or. aTotObriga[8] == 0, 0, (aTotObriga[7] / aTotObriga[8]) * 100)

			self:oData:appendData(oJsDados)
			oJsDados["Detalhes"]  := {}

			aResuLi[1] := aResuIR[1] - aTotObriga[1]
			aResuLi[2] := aResuIR[2] - aTotObriga[2]
			aResuLi[3] := aResuIR[3] - aTotObriga[3]
			aResuLi[4] := aResuIR[4] - aTotObriga[4]
			aResuLi[5] := aResuIR[5] - aTotObriga[5]
			aResuLi[6] := aResuIR[6] - aTotObriga[6]
			aResuLi[7] := aResuIR[7] - aTotObriga[7]

			oJsDados["TIPO"]    := STR0025 // "7 - RESULTADO LÍQUIDO (5-6)"
			oJsDados["VALMES1"] := aResuLi[1]
			oJsDados["VALMES2"] := aResuLi[2]
			oJsDados["VALMES3"] := aResuLi[3]
			oJsDados["VALMES4"] := aResuLi[4]
			oJsDados["VALMES5"] := aResuLi[5]
			oJsDados["VALMES6"] := aResuLi[6]
			oJsDados["TOTAL"]   := aResuLi[7]
			oJsDados["ORCADO"]  := 0
			oJsDados["PERC"]    := 0

			self:oData:appendData(oJsDados)

			cQuery := JSubReport("4", aMeses, cTpContTmp, jParams['MV_PAR01'][1], cFilEscr) // Query Investimentos

			MPSysOpenQuery(cQuery, cTempInv)

			While !(cTempInv)->(Eof())

				aInvest[1]  := JGetValor(aAllMeses[1][1], cTempInv)
				aInvest[2]  := JGetValor(aAllMeses[2][1], cTempInv)
				aInvest[3]  := JGetValor(aAllMeses[3][1], cTempInv)
				aInvest[4]  := JGetValor(aAllMeses[4][1], cTempInv)
				aInvest[5]  := JGetValor(aAllMeses[5][1], cTempInv)
				aInvest[6]  := JGetValor(aAllMeses[6][1], cTempInv)

				aTotInvest[1] := Iif(Empty(aTotInvest[1]), aInvest[1]           , aTotInvest[1] + aInvest[1]           ) // Janeiro
				aTotInvest[2] := Iif(Empty(aTotInvest[2]), aInvest[2]           , aTotInvest[2] + aInvest[2]           ) // Fevereiro
				aTotInvest[3] := Iif(Empty(aTotInvest[3]), aInvest[3]           , aTotInvest[3] + aInvest[3]           ) // Março
				aTotInvest[4] := Iif(Empty(aTotInvest[4]), aInvest[4]           , aTotInvest[4] + aInvest[4]           ) // Abril
				aTotInvest[5] := Iif(Empty(aTotInvest[5]), aInvest[5]           , aTotInvest[5] + aInvest[5]           ) // Maio
				aTotInvest[6] := Iif(Empty(aTotInvest[6]), aInvest[6]           , aTotInvest[6] + aInvest[6]           ) // Junho
				aTotInvest[7] := Iif(Empty(aTotInvest[7]), (cTempInv)->REALIZADO, aTotInvest[7] + (cTempInv)->REALIZADO) // Total Geral
				aTotInvest[8] := Iif(Empty(aTotInvest[8]), (cTempInv)->ORCADO   , aTotInvest[8] + (cTempInv)->ORCADO   ) // Orçamento
				aTotInvest[9] := Iif(Empty(aTotInvest[9]), (cTempInv)->PERCEN   , aTotInvest[9] + (cTempInv)->PERCEN   ) // Percentual

				aAdd(oJsDados["Detalhes"], {"NATUREZA" : (cTempInv)->ED_CODIGO + ' - ' + (cTempInv)->ED_DESCRIC,;
											"VALMES1"  : aInvest[1],;
											"VALMES2"  : aInvest[2],;
											"VALMES3"  : aInvest[3],;
											"VALMES4"  : aInvest[4],;
											"VALMES5"  : aInvest[5],;
											"VALMES6"  : aInvest[6],;
											"TOTAL"    : (cTempInv)->REALIZADO,;
											"ORCADO"   : (cTempInv)->ORCADO,;
											"PERC"     : (cTempInv)->PERCEN})

				(cTempInv)->(DBSkip())
			EndDo

			oJsDados["TIPO"]    := STR0027 // "8 - TOTAL DE INVESTIMENTOS"
			oJsDados["VALMES1"] := aTotInvest[1]
			oJsDados["VALMES2"] := aTotInvest[2]
			oJsDados["VALMES3"] := aTotInvest[3]
			oJsDados["VALMES4"] := aTotInvest[4]
			oJsDados["VALMES5"] := aTotInvest[5]
			oJsDados["VALMES6"] := aTotInvest[6]
			oJsDados["TOTAL"]   := aTotInvest[7]
			oJsDados["ORCADO"]  := aTotInvest[8]
			oJsDados["PERC"]    := Iif(Empty(aTotInvest[8]) .Or. aTotInvest[8] == 0, 0, (aTotInvest[7] / aTotInvest[8]) * 100)

			self:oData:appendData(oJsDados)
			oJsDados["Detalhes"]  := {}

			oJsDados["TIPO"]          := STR0028 // "9 - RESULTADO FINANCEIRO (7-8)"
			oJsDados["VALMES1"]       := aResuLi[1] - aTotInvest[1]
			oJsDados["VALMES2"]       := aResuLi[2] - aTotInvest[2]
			oJsDados["VALMES3"]       := aResuLi[3] - aTotInvest[3]
			oJsDados["VALMES4"]       := aResuLi[4] - aTotInvest[4]
			oJsDados["VALMES5"]       := aResuLi[5] - aTotInvest[5]
			oJsDados["VALMES6"]       := aResuLi[6] - aTotInvest[6]
			oJsDados["TOTAL"]         := aResuLi[7] - aTotInvest[7]
			oJsDados["ORCADO"]        := 0
			oJsDados["PERC"]          := 0
			self:oData:appendData(oJsDados)

			(cTempEsc)->(DBSkip())
		EndDo

		(cTempEnt)->(DbCloseArea())
		(cTempEsc)->(DbCloseArea())
		(cTempCus)->(DbCloseArea())
		(cTempDes)->(DbCloseArea())
		(cTempObr)->(DbCloseArea())
		(cTempInv)->(DbCloseArea())
	EndIf

	JurFreeArr(aEscrit)
	JurFreeArr(aMeses)
	JurFreeArr(aAllMeses)
	JurFreeArr(aEntradas)
	JurFreeArr(aTotEntra)
	JurFreeArr(aCustos)
	JurFreeArr(aTotCustos)
	JurFreeArr(aMargem)
	JurFreeArr(aDespes)
	JurFreeArr(aTotDespes)
	JurFreeArr(aResuIR)
	JurFreeArr(aObriga)
	JurFreeArr(aTotObriga)
	JurFreeArr(aResuLi)
	JurFreeArr(aInvest)
	JurFreeArr(aTotInvest)

	RestArea(aArea)
Return self:oData

//------------------------------------------------------------------------------------
method getSchema() as object Class jurapad032_resultado_financeiro
Local aNestedDet as array

	self:oSchema:addProperty("ESCRIT"       ,"ESCRIT"       , "string", "ESCRIT"       , "ESCRIT"       )
	self:oSchema:addProperty("TIPO"         ,"TIPO"         , "string", "TIPO"         , "TIPO"         )
	self:oSchema:addProperty("MES1"         ,"MES1"         , "string", "MES1"         , "MES1"         )
	self:oSchema:addProperty("MES2"         ,"MES2"         , "string", "MES2"         , "MES2"         )
	self:oSchema:addProperty("MES3"         ,"MES3"         , "string", "MES3"         , "MES3"         )
	self:oSchema:addProperty("MES4"         ,"MES4"         , "string", "MES4"         , "MES4"         )
	self:oSchema:addProperty("MES5"         ,"MES5"         , "string", "MES5"         , "MES5"         )
	self:oSchema:addProperty("MES6"         ,"MES6"         , "string", "MES6"         , "MES6"         )
	self:oSchema:addProperty("VALMES1"      ,"VALMES1"      , "number", "VALMES1"      , "VALMES1"      )
	self:oSchema:addProperty("VALMES2"      ,"VALMES2"      , "number", "VALMES2"      , "VALMES2"      )
	self:oSchema:addProperty("VALMES3"      ,"VALMES3"      , "number", "VALMES3"      , "VALMES3"      )
	self:oSchema:addProperty("VALMES4"      ,"VALMES4"      , "number", "VALMES4"      , "VALMES4"      )
	self:oSchema:addProperty("VALMES5"      ,"VALMES5"      , "number", "VALMES5"      , "VALMES5"      )
	self:oSchema:addProperty("VALMES6"      ,"VALMES6"      , "number", "VALMES6"      , "VALMES6"      )
	self:oSchema:addProperty("TOTAL"        ,"TOTAL"        , "number", "TOTAL"        , "TOTAL"        )
	self:oSchema:addProperty("ORCADO"       ,"ORCADO"       , "number", "ORCADO"       , "ORCADO"       )
	self:oSchema:addProperty("PERC"         ,"PERC"         , "number", "PERC"         , "PERC"         )
	self:oSchema:addProperty("ENTRADAS"     ,"ENTRADAS"     , "string", "ENTRADAS"     , "ENTRADAS"     )
	self:oSchema:addProperty("CUSTOS"       ,"CUSTOS"       , "string", "CUSTOS"       , "CUSTOS"       )
	self:oSchema:addProperty("DESPESAS"     ,"DESPESAS"     , "string", "DESPESAS"     , "DESPESAS"     )
	self:oSchema:addProperty("OBRIGACOES"   ,"OBRIGACOES"   , "string", "OBRIGACOES"   , "OBRIGACOES"   )
	self:oSchema:addProperty("INVESTIMENTOS","INVESTIMENTOS", "string", "INVESTIMENTOS", "INVESTIMENTOS")

	aNestedDet := Array(0)
	//Posições do array = 1-Id | 2-Description | 3-Type | 4-DisplayName
	aAdd(aNestedDet, {"NATUREZA", "NATUREZA", "string", "NATUREZA"})
	aAdd(aNestedDet, {"VALMES1" , "VALMES1" , "number", "VALMES1" })
	aAdd(aNestedDet, {"VALMES2" , "VALMES2" , "number", "VALMES2" })
	aAdd(aNestedDet, {"VALMES3" , "VALMES3" , "number", "VALMES3" })
	aAdd(aNestedDet, {"VALMES4" , "VALMES4" , "number", "VALMES4" })
	aAdd(aNestedDet, {"VALMES5" , "VALMES5" , "number", "VALMES5" })
	aAdd(aNestedDet, {"VALMES6" , "VALMES6" , "number", "VALMES6" })
	aAdd(aNestedDet, {"TOTAL"   , "TOTAL"   , "number", "TOTAL"   })
	aAdd(aNestedDet, {"ORCADO"  , "ORCADO"  , "number", "ORCADO"  })
	aAdd(aNestedDet, {"PERC"    , "PERC"    , "number", "PERC"    })
	self:oSchema:addNestedProperty("Detalhes", "Detalhes", "Detalhes",, aNestedDet)

Return self:oSchema

//-------------------------------------------------------------------
/*/{Protheus.doc} JGetMeses()
Rotina para gerar o array para os campos dinâmicos dos meses.

@Param nAno       - Ano do resultado financeiro
@Param nMesIni    - Mês Inicial do balanço
@Param nMesFinal  - Mês Final do balanço

@return aMeses[nI][1] Descrição do mês.
		aMeses[nI][2] Mês do saldo por Natureza.
		aMeses[nI][3] Campo da SE7.

@author Jacques Alves Xavier
@since 10/11/2025
@version 1.0
/*/
//-------------------------------------------------------------------
Static Function JGetMeses(nAno, nMesIni, nMesFinal)
Local nI       := 0
Local nQtdMes  := (nMesFinal - nMesIni) + 1
Local dData    := CToD('  /  /  ')
Local cDescMes := ""
Local aMeses   := {}
Local cCpoSE7  := ""

For nI := 1 to nQtdMes

	dData    := StoD(cValtochar(nAno) + StrZero(nMesIni, 2) + '01')
	cDescMes := MesExtenso(dData)
	cCpoSE7  := "E7_VAL" + LEFT(UPPER(cDescMes), 3) + "1"

	Aadd(aMeses, {cDescMes, dData, cCpoSE7})

	nMesIni += 1

Next nI

Return aMeses

//-------------------------------------------------------------------
/*/{Protheus.doc} JSubReport()
Rotina para gerar a query dos Subreports do relatorio de Resumo Financeiro.

@Param cTpConta - Tipo de Conta do Escritório
@Param aMeses   - Array com as informações dinamicas dos meses
		aMeses[nI][1] Descrição do mês.
		aMeses[nI][2] Mês do saldo por Natureza.
		aMeses[nI][3] Campo da SE7.
@Param cTpContTmp - Tabela temporária com os dados dos tipos de conta
@param nAno       - Ano para filtro do relatório
@param cFilEscr   - Código da Filial do Escritório filtrado

@return cQuery  - Query do Subreport por Natureza.

@author Jacques Alves Xavier
@since 11/11/2025
@version 1.0
/*/
//-------------------------------------------------------------------
Static Function JSubReport(cTpConta, aMeses, cTpContTmp, nAno, cFilEscr)
Local cQuery     := ""
Local nI         := 0
Local cSaldoMes  := ""
Local cOrcado    := ""
Local cOrcado2   := ""
Local cRealizado := ""
Local aBind      := {}

	For nI := 1 to Len(aMeses)
		cSaldoMes += " SUM(TOTAL." + aMeses[nI][3] + " ) " + aMeses[nI][3] + ","
		cOrcado   += " SUM(SE7." + aMeses[nI][3] + " ) +"
	Next nI

	cRealizado := " SUM(COALESCE(TOTAL.REALIZADO, 0))"
	cOrcado2    := " (" + Left(cOrcado, Len(cOrcado)-2) + ") " //Remove o ultimo '+'

	cQuery += " SELECT TOTAL.ED_FILIAL, TOTAL.ED_CODIGO, TOTAL.ED_DESCRIC, TOTAL.ED_CMOEJUR,"
	cQuery +=          "?" // cSaldoMes

	Aadd(aBind, {cSaldoMes, "U"})
	
	cQuery +=          "? REALIZADO,"

	Aadd(aBind, {cRealizado, "U"})

	cQuery +=          "? ORCADO,"

	Aadd(aBind, {cOrcado2, "U"})

	cQuery +=        " (CASE WHEN ? IS NULL THEN 0
	cQuery +=              " WHEN ? = 0 THEN 0
	cQuery +=              " ELSE (? / ?) * 100 END) PERCEN"

	Aadd(aBind, {cOrcado2, "U"})
	Aadd(aBind, {cOrcado2, "U"})
	Aadd(aBind, {cRealizado, "U"})
	Aadd(aBind, {cOrcado2, "U"})

	cQuery +=   " FROM ("
	cQuery +=           JQryTotal(cTpContTmp, aMeses, "O" , cTpConta, cFilEscr)
	cQuery +=         " UNION ALL"
	cQuery +=           JQryTotal(cTpContTmp, aMeses, "D" , cTpConta, cFilEscr)
	cQuery +=        " ) TOTAL"

	cQuery +=   " LEFT OUTER JOIN " + RetSqlName("SE7") + " SE7"
	cQuery +=     " ON (SE7.E7_NATUREZ = TOTAL.ED_CODIGO"
	If !Empty(cFilEscr)
		cQuery +=    " AND SE7.E7_FILIAL = ?"

		Aadd(aBind, {AllTrim(cFilEscr), "S"})
	EndIf
	cQuery +=    " AND SE7.E7_ANO = ?"

	Aadd(aBind, {cValtoChar(nAno), "S"})

	cQuery +=    " AND SE7.D_E_L_E_T_ = ?)"

	Aadd(aBind, {' ', "S"})

	cQuery +=  " GROUP BY TOTAL.ED_FILIAL, TOTAL.ED_CODIGO, TOTAL.ED_DESCRIC, TOTAL.ED_CMOEJUR"
	cQuery +=  " ORDER BY TOTAL.ED_CODIGO"

	cQuery := JurTRepBin(cQuery, aBind)

Return cQuery

//-------------------------------------------------------------------
/*/{Protheus.doc} JQryTotal()
Query principal com os totalizadores dos meses

@Param cTpContTmp - Tabela temporária com os dados dos tipos de conta
@param aMeses     - Array com as informações dinamicas dos meses
                   aMeses[nI][1] Descrição do mês.
                   aMeses[nI][2] Mês do saldo por Natureza.
                   aMeses[nI][3] Campo da SE7.
@Param cOriDest   - O tipo da natureza no lançamento O = Origem, D = Destino
@Param cTpConta   - Tipo de conta de Natureza
@param cFilEscr   - Código da Filial do Escritório filtrado

@return cQuery      - Query principal do relatório (Filtro por escritório)

@author Jacques Alves Xavier
@since 11/11/2025
@version 1.0
/*/
//-------------------------------------------------------------------
Static Function JQryTotal(cTpContTmp, aMeses, cOriDest, cTpConta, cFilEscr)
Local cQuery     := ""
Local cCpoOriDes := Iif(cOriDest == "O", "OHB_NATORI", "OHB_NATDES")
Local nI         := 0
Local cMesIni    := ""
Local cMesFin    := ""
Local cSaldoMes  := ""
Local aBind      := {}

	For nI := 1 to Len(aMeses)
		IIf(nI == 1          , cMesIni := DtoS(aMeses[nI][2]), Nil)
		IIf(nI == Len(aMeses), cMesFin := DtoS(LastDay(aMeses[nI][2])), Nil)

		cSaldoMes += JSaldoMes(aMeses[nI], cOriDest, cTpContTmp, cFilEscr) +", "
	Next nI

	cRealizado := " SUM( OHB.OHB_VLNAC ) * (SELECT SINAL FROM ? WHERE TIPO = ? AND CODIGO = SED.ED_TPCOJR)"

	cQuery += " SELECT SED.ED_TPCOJR, SED.ED_FILIAL, SED.ED_CODIGO, SED.ED_DESCRIC, SED.ED_CMOEJUR,"
	cQuery +=         cSaldoMes // Não precisa de bind, pois foi realizado na função JSaldoMes
	cQuery +=         cRealizado + " REALIZADO"

	Aadd(aBind, {cTpContTmp, "U"})
	Aadd(aBind, {cOriDest, "S"})

	cQuery +=   " FROM " + RetSqlName("OHB") + " OHB"
	cQuery +=  " INNER JOIN " + RetSqlName("SED") + " SED"
	cQuery +=     " ON SED.ED_FILIAL = ?"

	Aadd(aBind, {xFilial("SED"), "S"})

	cQuery +=    " AND SED.ED_CODIGO = OHB.?"

	Aadd(aBind, {cCpoOriDes, "U"})

	cQuery +=    " AND SED.D_E_L_E_T_ = ?"

	Aadd(aBind, {' ', "S"})

	cQuery +=  " WHERE OHB.OHB_DTLANC BETWEEN ? AND ?"

	Aadd(aBind, {cMesIni, "S"})
	Aadd(aBind, {cMesFin, "S"})

	If !Empty(cFilEscr)
		cQuery +=    " AND OHB.OHB_FILIAL = ?"

		Aadd(aBind, {AllTrim(cFilEscr), "S"})
	EndIf
	cQuery +=    " AND SED.ED_TPCOJR = ?"

	Aadd(aBind, {cTpConta, "S"})

	cQuery +=    " AND SED.ED_CCJURI IN (' ','1','2','3','4','5')"
	
	cQuery +=    " AND OHB.D_E_L_E_T_ = ?"

	Aadd(aBind, {' ', "S"})

	cQuery +=  " GROUP BY SED.ED_FILIAL, SED.ED_CODIGO, SED.ED_DESCRIC, SED.ED_CMOEJUR, SED.ED_TPCOJR"

	cQuery := JurTRepBin(cQuery, aBind)

Return cQuery

//-------------------------------------------------------------------
/*/{Protheus.doc} JSaldoMes(aMeses)
Rotina para gerar a SubQuery saldo de naturezas por mês.

@Param aMeses  - Array com as informações dinamicas dos meses
		aMeses[1] Descrição do mês.
		aMeses[2] Mês do saldo por Natureza.
		aMeses[3] Campo da SE7.

@Param cOriDest - O tipo da natureza no lançamento O = Origem, D = Destino
@Param cTpContTmp - Tabela temporária com os dados dos tipos de conta
@param cFilEscr   - Código da Filial do Escritório filtrado

@return cQuery  - SubQuery de somatória de saldo de naturezas por mês.

@author Jacques Alves Xavier
@since 11/11/2025
@version 1.0
/*/
//-------------------------------------------------------------------
Static Function JSaldoMes(aMeses, cOriDest, cTpContTmp, cFilEscr)
Local cQuery     := ""
Local cCpoOriDes := Iif(cOriDest == "O", "OHB_NATORI", "OHB_NATDES")
Local cMes       := aMeses[3]
Local aBind      := {}

	cQuery += "(SELECT COALESCE(SUM(OHBMES.OHB_VLNAC * TPCONTA.SINAL), 0) VALOR"
	cQuery +=   " FROM " + RetSqlName("OHB") + " OHBMES,"
	cQuery +=        " ? TPCONTA"

	Aadd(aBind, {cTpContTmp, "U"})

	cQuery +=  " WHERE OHBMES.OHB_DTLANC BETWEEN ? AND ?"

	Aadd(aBind, {DtoS(aMeses[2]), "S"})
	Aadd(aBind, {DtoS(LastDay(aMeses[2])), "S"})

	If !Empty(cFilEscr)
		cQuery +=    " AND OHBMES.OHB_FILIAL = ?"

		Aadd(aBind, {AllTrim(cFilEscr), "S"})
	EndIf
	cQuery +=    " AND OHBMES.? = SED.ED_CODIGO"

	Aadd(aBind, {cCpoOriDes, "U"})

	cQuery +=    " AND TPCONTA.TIPO = ?"

	Aadd(aBind, {AllTrim(cOriDest), "S"})

	cQuery +=    " AND TPCONTA.CODIGO = SED.ED_TPCOJR"
	cQuery +=    " AND OHBMES.D_E_L_E_T_ = ?) " + cMes

	Aadd(aBind, {' ', "S"})

	cQuery := JurTRepBin(cQuery, aBind)

Return cQuery

//-------------------------------------------------------------------
/*/{Protheus.doc} JGetValor()
Função para retornar o valor por mês

@Param cMes       - Mês para a pesquisa do valor
@Param aMeses     - Array com os meses filtrados
@Param cAlias     - Alias contendo os valores

@return nValor    - Retorno o valor para o mês pesquisado

@author Jacques Alves Xavier
@since 12/11/2025
@version 1.0
/*/
//-------------------------------------------------------------------
Static Function JGetValor(cMes, cAlias)
Local nValor := 0

	Do Case
		Case cMes == "Janeiro"
			nValor := (cAlias)->E7_VALJAN1
		Case cMes == "Fevereiro"
			nValor := (cAlias)->E7_VALFEV1
		Case cMes == "Marco"
			nValor := (cAlias)->E7_VALMAR1
		Case cMes == "Abril"
			nValor := (cAlias)->E7_VALABR1
		Case cMes == "Maio"
			nValor := (cAlias)->E7_VALMAI1
		Case cMes == "Junho"
			nValor := (cAlias)->E7_VALJUN1
		Case cMes == "Julho"
			nValor := (cAlias)->E7_VALJUL1
		Case cMes == "Agosto"
			nValor := (cAlias)->E7_VALAGO1
		Case cMes == "Setembro"
			nValor := (cAlias)->E7_VALSET1
		Case cMes == "Outubro"
			nValor := (cAlias)->E7_VALOUT1
		Case cMes == "Novembro"
			nValor := (cAlias)->E7_VALNOV1
		Case cMes == "Dezembro"
			nValor := (cAlias)->E7_VALDEZ1
	EndCase

Return nValor

//-------------------------------------------------------------------
/*/{Protheus.doc} JBuscEscr
Rotina para gerar a query do report principal do relatorio de
Resumo Financeiro.

@param cEscrit - Escritório para filtro
@param aMeses  - Array com as informações dinamicas dos meses
                 aMeses[nI][1] Descrição do mês.
                 aMeses[nI][2] Mês do saldo por Natureza.
                 aMeses[nI][3] Campo da SE7.

@return cQuery - Query principal do relatório (Filtro por escritório)

@author Jacques Alves Xavier
@since 19/11/2025
@version 1.0
/*/
//-------------------------------------------------------------------
Static Function JBuscEscr(cEscrit, aMeses)
Local cQuery   := " "
Local cMesIni  := DtoS(aMeses[1][2])
Local cMesFin  := DtoS(LastDay(aMeses[Len(aMeses)][2]))
Local cFilEscr := ""

	If !Empty(cEscrit)
		cFilEscr := JurGetDados("NS7", 1, xFilial("NS7") + cEscrit, "NS7_CFILIA")
	EndIf

	cQuery := " SELECT NS7.NS7_RAZAO, NS7.NS7_CFILIA "
	cQuery +=     "  FROM " + RetSqlName("NS7") + " NS7 "
	cQuery +=     " WHERE NS7.NS7_FILIAL = '" + xFilial("NS7") + "' "
	If !Empty(cEscrit)
		cQuery +=   " AND NS7.NS7_COD = '" + cEscrit + "' "
	EndIf
	cQuery +=       " AND NS7.D_E_L_E_T_ = ' ' "
	cQuery +=       " AND EXISTS (SELECT DISTINCT SED.R_E_C_N_O_ "
	cQuery +=                     " FROM " + RetSqlName("SED") + " SED "
	cQuery +=                    " INNER JOIN " + RetSqlName("OHB") + " OHB "
	cQuery +=                          " ON (OHB.OHB_NATORI = SED.ED_CODIGO OR OHB.OHB_NATDES = SED.ED_CODIGO) "
	If !Empty(cEscrit)
		cQuery +=                     " AND OHB.OHB_FILIAL = '" + cFilEscr + "' "
	EndIf
	cQuery +=                         " AND OHB.D_E_L_E_T_ = ' ' "
	cQuery +=                         " AND OHB.OHB_DTLANC BETWEEN '"+ cMesIni +"' AND '"+ cMesFin +"' "
	cQuery +=                       " WHERE SED.ED_FILIAL = '" + xFilial("SED") + "' "
	cQuery +=                         " AND SED.ED_TPCOJR IN ('2','3','4','6','8') "
	cQuery +=                         " AND SED.D_E_L_E_T_ = ' ' )"

Return cQuery
