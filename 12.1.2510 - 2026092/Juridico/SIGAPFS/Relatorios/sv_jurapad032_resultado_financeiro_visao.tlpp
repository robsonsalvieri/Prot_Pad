			aResuIR[1]  := aMargem[1]  - aTotDespes[1]
			aResuIR[2]  := aMargem[2]  - aTotDespes[2]
			aResuIR[3]  := aMargem[3]  - aTotDespes[3]
			aResuIR[4]  := aMargem[4]  - aTotDespes[4]
			aResuIR[5]  := aMargem[5]  - aTotDespes[5]
			aResuIR[6]  := aMargem[6]  - aTotDespes[6]
			aResuIR[7]  := aMargem[7]  - aTotDespes[7]
			aResuIR[8]  := aMargem[8]  - aTotDespes[8]
			aResuIR[9]  := aMargem[9]  - aTotDespes[9]
			aResuIR[10] := aMargem[10] - aTotDespes[10]
			aResuIR[11] := aMargem[11] - aTotDespes[11]
			aResuIR[12] := aMargem[12] - aTotDespes[12]
			aResuIR[13] := aMargem[13] - aTotDespes[13]

			oJsDados["TIPO"]      := STR0022 // "5 - RESULTADO ANTES DO IR (3-4)"
			oJsDados["JANEIRO"]   := aResuIR[1]
			oJsDados["FEVEREIRO"] := aResuIR[2]
			oJsDados["MARCO"]     := aResuIR[3]
			oJsDados["ABRIL"]     := aResuIR[4]
			oJsDados["MAIO"]      := aResuIR[5]
			oJsDados["JUNHO"]     := aResuIR[6]
			oJsDados["JULHO"]     := aResuIR[7]
			oJsDados["AGOSTO"]    := aResuIR[8]
			oJsDados["SETEMBRO"]  := aResuIR[9]
			oJsDados["OUTUBRO"]   := aResuIR[10]
			oJsDados["NOVEMBRO"]  := aResuIR[11]
			oJsDados["DEZEMBRO"]  := aResuIR[12]
			oJsDados["TOTAL"]     := aResuIR[13]
			oJsDados["ORCADO"]    := 0
			oJsDados["PERC"]      := 0

			self:oData:appendData(oJsDados)

			cQuery := JSubReport("6", aMeses, cTpContTmp, jParams['MV_PAR01'][1], cFilEscr) // Query Obrigações Fiscais

			MPSysOpenQuery(cQuery, cTempObr)

			While !(cTempObr)->(Eof())

				aObriga[1]  := JGetValor("Janeiro"  , aMeses, cTempObr)
				aObriga[2]  := JGetValor("Fevereiro", aMeses, cTempObr)
				aObriga[3]  := JGetValor("Marco"    , aMeses, cTempObr)
				aObriga[4]  := JGetValor("Abril"    , aMeses, cTempObr)
				aObriga[5]  := JGetValor("Maio"     , aMeses, cTempObr)
				aObriga[6]  := JGetValor("Junho"    , aMeses, cTempObr)
				aObriga[7]  := JGetValor("Julho"    , aMeses, cTempObr)
				aObriga[8]  := JGetValor("Agosto"   , aMeses, cTempObr)
				aObriga[9]  := JGetValor("Setembro" , aMeses, cTempObr)
				aObriga[10] := JGetValor("Outubro"  , aMeses, cTempObr)
				aObriga[11] := JGetValor("Novembro" , aMeses, cTempObr)
				aObriga[12] := JGetValor("Dezembro" , aMeses, cTempObr)

				aTotObriga[1]  := Iif(Empty(aTotObriga[1]) , aObriga[1]           , aTotObriga[1]  + aObriga[1]           ) // Janeiro
				aTotObriga[2]  := Iif(Empty(aTotObriga[2]) , aObriga[2]           , aTotObriga[2]  + aObriga[2]           ) // Fevereiro
				aTotObriga[3]  := Iif(Empty(aTotObriga[3]) , aObriga[3]           , aTotObriga[3]  + aObriga[3]           ) // Março
				aTotObriga[4]  := Iif(Empty(aTotObriga[4]) , aObriga[4]           , aTotObriga[4]  + aObriga[4]           ) // Abril
				aTotObriga[5]  := Iif(Empty(aTotObriga[5]) , aObriga[5]           , aTotObriga[5]  + aObriga[5]           ) // Maio
				aTotObriga[6]  := Iif(Empty(aTotObriga[6]) , aObriga[6]           , aTotObriga[6]  + aObriga[6]           ) // Junho
				aTotObriga[7]  := Iif(Empty(aTotObriga[7]) , aObriga[7]           , aTotObriga[7]  + aObriga[7]           ) // Julho
				aTotObriga[8]  := Iif(Empty(aTotObriga[8]) , aObriga[8]           , aTotObriga[8]  + aObriga[8]           ) // Agosto
				aTotObriga[9]  := Iif(Empty(aTotObriga[9]) , aObriga[9]           , aTotObriga[9]  + aObriga[9]           ) // Setembro
				aTotObriga[10] := Iif(Empty(aTotObriga[10]), aObriga[10]          , aTotObriga[10] + aObriga[10]          ) // Outubro
				aTotObriga[11] := Iif(Empty(aTotObriga[11]), aObriga[11]          , aTotObriga[11] + aObriga[11]          ) // Novembro
				aTotObriga[12] := Iif(Empty(aTotObriga[12]), aObriga[12]          , aTotObriga[12] + aObriga[12]          ) // Dezembro
				aTotObriga[13] := Iif(Empty(aTotObriga[13]), (cTempObr)->REALIZADO, aTotObriga[13] + (cTempObr)->REALIZADO) // Total Geral
				aTotObriga[14] := Iif(Empty(aTotObriga[14]), (cTempObr)->ORCADO   , aTotObriga[14] + (cTempObr)->ORCADO   ) // Orçamento
				aTotObriga[15] := Iif(Empty(aTotObriga[15]), (cTempObr)->PERCEN   , aTotObriga[15] + (cTempObr)->PERCEN   ) // Percentual

				oJsDados["TIPO"]      := (cTempObr)->ED_CODIGO + ' - ' + (cTempObr)->ED_DESCRIC
				oJsDados["JANEIRO"]   := aObriga[1]
				oJsDados["FEVEREIRO"] := aObriga[2]
				oJsDados["MARCO"]     := aObriga[3]
				oJsDados["ABRIL"]     := aObriga[4]
				oJsDados["MAIO"]      := aObriga[5]
				oJsDados["JUNHO"]     := aObriga[6]
				oJsDados["JULHO"]     := aObriga[7]
				oJsDados["AGOSTO"]    := aObriga[8]
				oJsDados["SETEMBRO"]  := aObriga[9]
				oJsDados["OUTUBRO"]   := aObriga[10]
				oJsDados["NOVEMBRO"]  := aObriga[11]
				oJsDados["DEZEMBRO"]  := aObriga[12]
				oJsDados["TOTAL"]     := (cTempObr)->REALIZADO
				oJsDados["ORCADO"]    := (cTempObr)->ORCADO
				oJsDados["PERC"]      := (cTempObr)->PERCEN

				self:oData:appendData(oJsDados)

				(cTempObr)->(DBSkip())
			EndDo

			oJsDados["TIPO"]      := STR0024 // "6 - TOTAL DE OBRIGAÇÕES"
			oJsDados["JANEIRO"]   := aTotObriga[1]
			oJsDados["FEVEREIRO"] := aTotObriga[2]
			oJsDados["MARCO"]     := aTotObriga[3]
			oJsDados["ABRIL"]     := aTotObriga[4]
			oJsDados["MAIO"]      := aTotObriga[5]
			oJsDados["JUNHO"]     := aTotObriga[6]
			oJsDados["JULHO"]     := aTotObriga[7]
			oJsDados["AGOSTO"]    := aTotObriga[8]
			oJsDados["SETEMBRO"]  := aTotObriga[9]
			oJsDados["OUTUBRO"]   := aTotObriga[10]
			oJsDados["NOVEMBRO"]  := aTotObriga[11]
			oJsDados["DEZEMBRO"]  := aTotObriga[12]
			oJsDados["TOTAL"]     := aTotObriga[13]
			oJsDados["ORCADO"]    := aTotObriga[14]
			oJsDados["PERC"]      := Iif(Empty(aTotObriga[14]) .Or. aTotObriga[14] == 0, 0, (aTotObriga[13] / aTotObriga[14]) * 100)

			self:oData:appendData(oJsDados)

			aResuLi[1]  := aResuIR[1]  - aTotObriga[1]
			aResuLi[2]  := aResuIR[2]  - aTotObriga[2]
			aResuLi[3]  := aResuIR[3]  - aTotObriga[3]
			aResuLi[4]  := aResuIR[4]  - aTotObriga[4]
			aResuLi[5]  := aResuIR[5]  - aTotObriga[5]
			aResuLi[6]  := aResuIR[6]  - aTotObriga[6]
			aResuLi[7]  := aResuIR[7]  - aTotObriga[7]
			aResuLi[8]  := aResuIR[8]  - aTotObriga[8]
			aResuLi[9]  := aResuIR[9]  - aTotObriga[9]
			aResuLi[10] := aResuIR[10] - aTotObriga[10]
			aResuLi[11] := aResuIR[11] - aTotObriga[11]
			aResuLi[12] := aResuIR[12] - aTotObriga[12]
			aResuLi[13] := aResuIR[13] - aTotObriga[13]

			oJsDados["TIPO"]      := STR0025 // "7 - RESULTADO LÍQUIDO (5-6)"
			oJsDados["JANEIRO"]   := aResuLi[1]
			oJsDados["FEVEREIRO"] := aResuLi[2]
			oJsDados["MARCO"]     := aResuLi[3]
			oJsDados["ABRIL"]     := aResuLi[4]
			oJsDados["MAIO"]      := aResuLi[5]
			oJsDados["JUNHO"]     := aResuLi[6]
			oJsDados["JULHO"]     := aResuLi[7]
			oJsDados["AGOSTO"]    := aResuLi[8]
			oJsDados["SETEMBRO"]  := aResuLi[9]
			oJsDados["OUTUBRO"]   := aResuLi[10]
			oJsDados["NOVEMBRO"]  := aResuLi[11]
			oJsDados["DEZEMBRO"]  := aResuLi[12]
			oJsDados["TOTAL"]     := aResuLi[13]
			oJsDados["ORCADO"]    := 0
			oJsDados["PERC"]      := 0

			self:oData:appendData(oJsDados)

			cQuery := JSubReport("4", aMeses, cTpContTmp, jParams['MV_PAR01'][1], cFilEscr) // Query Investimentos

			MPSysOpenQuery(cQuery, cTempInv)

			While !(cTempInv)->(Eof())

				aInvest[1]  := JGetValor("Janeiro"  , aMeses, cTempInv)
				aInvest[2]  := JGetValor("Fevereiro", aMeses, cTempInv)
				aInvest[3]  := JGetValor("Marco"    , aMeses, cTempInv)
				aInvest[4]  := JGetValor("Abril"    , aMeses, cTempInv)
				aInvest[5]  := JGetValor("Maio"     , aMeses, cTempInv)
				aInvest[6]  := JGetValor("Junho"    , aMeses, cTempInv)
				aInvest[7]  := JGetValor("Julho"    , aMeses, cTempInv)
				aInvest[8]  := JGetValor("Agosto"   , aMeses, cTempInv)
				aInvest[9]  := JGetValor("Setembro" , aMeses, cTempInv)
				aInvest[10] := JGetValor("Outubro"  , aMeses, cTempInv)
				aInvest[11] := JGetValor("Novembro" , aMeses, cTempInv)
				aInvest[12] := JGetValor("Dezembro" , aMeses, cTempInv)

				aTotInvest[1]  := Iif(Empty(aTotInvest[1]) , aInvest[1]           , aTotInvest[1]  + aInvest[1]           ) // Janeiro
				aTotInvest[2]  := Iif(Empty(aTotInvest[2]) , aInvest[2]           , aTotInvest[2]  + aInvest[2]           ) // Fevereiro
				aTotInvest[3]  := Iif(Empty(aTotInvest[3]) , aInvest[3]           , aTotInvest[3]  + aInvest[3]           ) // Março
				aTotInvest[4]  := Iif(Empty(aTotInvest[4]) , aInvest[4]           , aTotInvest[4]  + aInvest[4]           ) // Abril
				aTotInvest[5]  := Iif(Empty(aTotInvest[5]) , aInvest[5]           , aTotInvest[5]  + aInvest[5]           ) // Maio
				aTotInvest[6]  := Iif(Empty(aTotInvest[6]) , aInvest[6]           , aTotInvest[6]  + aInvest[6]           ) // Junho
				aTotInvest[7]  := Iif(Empty(aTotInvest[7]) , aInvest[7]           , aTotInvest[7]  + aInvest[7]           ) // Julho
				aTotInvest[8]  := Iif(Empty(aTotInvest[8]) , aInvest[8]           , aTotInvest[8]  + aInvest[8]           ) // Agosto
				aTotInvest[9]  := Iif(Empty(aTotInvest[9]) , aInvest[9]           , aTotInvest[9]  + aInvest[9]           ) // Setembro
				aTotInvest[10] := Iif(Empty(aTotInvest[10]), aInvest[10]          , aTotInvest[10] + aInvest[10]          ) // Outubro
				aTotInvest[11] := Iif(Empty(aTotInvest[11]), aInvest[11]          , aTotInvest[11] + aInvest[11]          ) // Novembro
				aTotInvest[12] := Iif(Empty(aTotInvest[12]), aInvest[12]          , aTotInvest[12] + aInvest[12]          ) // Dezembro
				aTotInvest[13] := Iif(Empty(aTotInvest[13]), (cTempInv)->REALIZADO, aTotInvest[13] + (cTempInv)->REALIZADO) // Total Geral
				aTotInvest[14] := Iif(Empty(aTotInvest[14]), (cTempInv)->ORCADO   , aTotInvest[14] + (cTempInv)->ORCADO   ) // Orçamento
				aTotInvest[15] := Iif(Empty(aTotInvest[15]), (cTempInv)->PERCEN   , aTotInvest[15] + (cTempInv)->PERCEN   ) // Percentual

				oJsDados["TIPO"]      := (cTempInv)->ED_CODIGO + ' - ' + (cTempInv)->ED_DESCRIC
				oJsDados["JANEIRO"]   := aInvest[1]
				oJsDados["FEVEREIRO"] := aInvest[2]
				oJsDados["MARCO"]     := aInvest[3]
				oJsDados["ABRIL"]     := aInvest[4]
				oJsDados["MAIO"]      := aInvest[5]
				oJsDados["JUNHO"]     := aInvest[6]
				oJsDados["JULHO"]     := aInvest[7]
				oJsDados["AGOSTO"]    := aInvest[8]
				oJsDados["SETEMBRO"]  := aInvest[9]
				oJsDados["OUTUBRO"]   := aInvest[10]
				oJsDados["NOVEMBRO"]  := aInvest[11]
				oJsDados["DEZEMBRO"]  := aInvest[12]
				oJsDados["TOTAL"]     := (cTempInv)->REALIZADO
				oJsDados["ORCADO"]    := (cTempInv)->ORCADO
				oJsDados["PERC"]      := (cTempInv)->PERCEN

				self:oData:appendData(oJsDados)

				(cTempInv)->(DBSkip())
			EndDo

			oJsDados["TIPO"]      := STR0027 // "8 - TOTAL DE INVESTIMENTOS"
			oJsDados["JANEIRO"]   := aTotInvest[1]
			oJsDados["FEVEREIRO"] := aTotInvest[2]
			oJsDados["MARCO"]     := aTotInvest[3]
			oJsDados["ABRIL"]     := aTotInvest[4]
			oJsDados["MAIO"]      := aTotInvest[5]
			oJsDados["JUNHO"]     := aTotInvest[6]
			oJsDados["JULHO"]     := aTotInvest[7]
			oJsDados["AGOSTO"]    := aTotInvest[8]
			oJsDados["SETEMBRO"]  := aTotInvest[9]
			oJsDados["OUTUBRO"]   := aTotInvest[10]
			oJsDados["NOVEMBRO"]  := aTotInvest[11]
			oJsDados["DEZEMBRO"]  := aTotInvest[12]
			oJsDados["TOTAL"]     := aTotInvest[13]
			oJsDados["ORCADO"]    := aTotInvest[14]
			oJsDados["PERC"]      := Iif(Empty(aTotInvest[14]) .Or. aTotInvest[14] == 0, 0, (aTotInvest[13] / aTotInvest[14]) * 100)

			self:oData:appendData(oJsDados)

			oJsDados["TIPO"]      := STR0028 // "9 - RESULTADO FINANCEIRO (7-8)"
			oJsDados["JANEIRO"]   := aResuLi[1]  - aTotInvest[1]
			oJsDados["FEVEREIRO"] := aResuLi[2]  - aTotInvest[2]
			oJsDados["MARCO"]     := aResuLi[3]  - aTotInvest[3]
			oJsDados["ABRIL"]     := aResuLi[4]  - aTotInvest[4]
			oJsDados["MAIO"]      := aResuLi[5]  - aTotInvest[5]
			oJsDados["JUNHO"]     := aResuLi[6]  - aTotInvest[6]
			oJsDados["JULHO"]     := aResuLi[7]  - aTotInvest[7]
			oJsDados["AGOSTO"]    := aResuLi[8]  - aTotInvest[8]
			oJsDados["SETEMBRO"]  := aResuLi[9]  - aTotInvest[9]
			oJsDados["OUTUBRO"]   := aResuLi[10] - aTotInvest[10]
			oJsDados["NOVEMBRO"]  := aResuLi[11] - aTotInvest[11]
			oJsDados["DEZEMBRO"]  := aResuLi[12] - aTotInvest[12]
			oJsDados["TOTAL"]     := aResuLi[13] - aTotInvest[13]
			oJsDados["ORCADO"]    := 0
			oJsDados["PERC"]      := 0

			self:oData:appendData(oJsDados)

			(cTempEsc)->(DBSkip())
		EndDo

		(cTempEnt)->(DbCloseArea())
		(cTempEsc)->(DbCloseArea())
		(cTempCus)->(DbCloseArea())
		(cTempDes)->(DbCloseArea())
		(cTempObr)->(DbCloseArea())
		(cTempInv)->(DbCloseArea())
	EndIf

	JurFreeArr(aMeses)
	JurFreeArr(aEntradas)
	JurFreeArr(aTotEntra)
	JurFreeArr(aCustos)
	JurFreeArr(aTotCustos)
	JurFreeArr(aMargem)
	JurFreeArr(aDespes)
	JurFreeArr(aTotDespes)
	JurFreeArr(aResuIR)
	JurFreeArr(aObriga)
	JurFreeArr(aTotObriga)
	JurFreeArr(aResuLi)
	JurFreeArr(aInvest)
	JurFreeArr(aTotInvest)

	RestArea(aArea)
Return self:oData

//------------------------------------------------------------------------------------
method getSchema() as object Class jurapad032_resultado_financeiro_visao

	self:oSchema:addProperty("ESCRITORIO", "ESCRITORIO"   , "string", "ESCRITORIO", "ESCRITORIO")
	self:oSchema:addProperty("TIPO"      , "TIPO"         , "string", "TIPO"      , "TIPO"      )
	self:oSchema:addProperty("JANEIRO"   , "JANEIRO"      , "string", "JANEIRO"   , "JANEIRO"   )
	self:oSchema:addProperty("FEVEREIRO" , "FEVEREIRO"    , "string", "FEVEREIRO" , "FEVEREIRO" )
	self:oSchema:addProperty("MARCO"     , "MARCO"        , "string", "MARCO"     , "MARCO"     )
	self:oSchema:addProperty("ABRIL"     , "ABRIL"        , "string", "ABRIL"     , "ABRIL"     )
	self:oSchema:addProperty("MAIO"      , "MAIO"         , "string", "MAIO"      , "MAIO"      )
	self:oSchema:addProperty("JUNHO"     , "JUNHO"        , "string", "JUNHO"     , "JUNHO"     )
	self:oSchema:addProperty("JULHO"     , "JULHO"        , "string", "JULHO"     , "JULHO"     )
	self:oSchema:addProperty("AGOSTO"    , "AGOSTO"       , "string", "AGOSTO"    , "AGOSTO"    )
	self:oSchema:addProperty("SETEMBRO"  , "SETEMBRO"     , "string", "SETEMBRO"  , "SETEMBRO"  )
	self:oSchema:addProperty("OUTUBRO"   , "OUTUBRO"      , "string", "OUTUBRO"   , "OUTUBRO"   )
	self:oSchema:addProperty("NOVEMBRO"  , "NOVEMBRO"     , "string", "NOVEMBRO"  , "NOVEMBRO"  )
	self:oSchema:addProperty("DEZEMBRO"  , "DEZEMBRO"     , "string", "DEZEMBRO"  , "DEZEMBRO"  )
	self:oSchema:addProperty("TOTAL"     , "TOTAL"        , "number", "TOTAL"     , "TOTAL"     )
	self:oSchema:addProperty("ORCADO"    , "ORCADO"       , "number", "ORCADO"    , "ORCADO"    )
	self:oSchema:addProperty("PERC"      , "PERC"         , "number", "PERC"      , "PERC"      )

Return self:oSchema

//-------------------------------------------------------------------
/*/{Protheus.doc} JGetMeses()
Rotina para gerar o array para os campos dinâmicos dos meses.

@Param nAno       - Ano do resultado financeiro
@Param nMesIni    - Mês Inicial do balanço
@Param nMesFinal  - Mês Final do balanço

@return aMeses[nI][1] Descrição do mês.
		aMeses[nI][2] Mês do saldo por Natureza.
		aMeses[nI][3] Campo da SE7.

@author Jacques Alves Xavier
@since 10/11/2025
@version 1.0
/*/
//-------------------------------------------------------------------
Static Function JGetMeses(nAno, nMesIni, nMesFinal)
Local nI       := 0
Local nQtdMes  := (nMesFinal - nMesIni) + 1
Local dData    := CToD('  /  /  ')
Local cDescMes := ""
Local aMeses   := {}
Local cCpoSE7  := ""

For nI := 1 to nQtdMes

	dData    := StoD(cValtochar(nAno) + StrZero(nMesIni, 2) + '01')
	cDescMes := MesExtenso(dData)
	cCpoSE7  := "E7_VAL" + LEFT(UPPER(cDescMes), 3) + "1"

	Aadd(aMeses, {cDescMes, dData, cCpoSE7})

	nMesIni += 1

Next nI

Return aMeses

//-------------------------------------------------------------------
/*/{Protheus.doc} JSubReport()
Rotina para gerar a query dos Subreports do relatorio de Resumo Financeiro.

@Param cTpConta - Tipo de Conta do Escritório
@Param aMeses   - Array com as informações dinamicas dos meses
		aMeses[nI][1] Descrição do mês.
		aMeses[nI][2] Mês do saldo por Natureza.
		aMeses[nI][3] Campo da SE7.
@Param cTpContTmp - Tabela temporária com os dados dos tipos de conta
@param nAno       - Ano para filtro do relatório
@param cFilEscr   - Código da Filial do Escritório filtrado

@return cQuery  - Query do Subreport por Natureza.

@author Jacques Alves Xavier
@since 11/11/2025
@version 1.0
/*/
//-------------------------------------------------------------------
Static Function JSubReport(cTpConta, aMeses, cTpContTmp, nAno, cFilEscr)
Local cQuery     := ""
Local nI         := 0
Local cSaldoMes  := ""
Local cOrcado    := ""
Local cOrcado2   := ""
Local cRealizado := ""
Local aBind      := {}

	For nI := 1 to Len(aMeses)
		cSaldoMes += " SUM(TOTAL." + aMeses[nI][3] + " ) " + aMeses[nI][3] + ","
		cOrcado   += " SUM(SE7." + aMeses[nI][3] + " ) +"
	Next nI

	cRealizado := " SUM(COALESCE(TOTAL.REALIZADO, 0))"
	cOrcado2    := " (" + Left(cOrcado, Len(cOrcado)-2) + ") " //Remove o ultimo '+'

	cQuery += " SELECT TOTAL.ED_FILIAL, TOTAL.ED_CODIGO, TOTAL.ED_DESCRIC, TOTAL.ED_CMOEJUR,"
	cQuery +=          "?" // cSaldoMes

	Aadd(aBind, {cSaldoMes, "U"})
	
	cQuery +=          "? REALIZADO,"

	Aadd(aBind, {cRealizado, "U"})

	cQuery +=          "? ORCADO,"

	Aadd(aBind, {cOrcado2, "U"})

	cQuery +=        " (CASE WHEN ? IS NULL THEN 0
	cQuery +=              " WHEN ? = 0 THEN 0
	cQuery +=              " ELSE (? / ?) * 100 END) PERCEN"

	Aadd(aBind, {cOrcado2, "U"})
	Aadd(aBind, {cOrcado2, "U"})
	Aadd(aBind, {cRealizado, "U"})
	Aadd(aBind, {cOrcado2, "U"})

	cQuery +=   " FROM ("
	cQuery +=           JQryTotal(cTpContTmp, aMeses, "O" , cTpConta, cFilEscr)
	cQuery +=         " UNION ALL"
	cQuery +=           JQryTotal(cTpContTmp, aMeses, "D" , cTpConta, cFilEscr)
	cQuery +=        " ) TOTAL"

	cQuery +=   " LEFT OUTER JOIN " + RetSqlName("SE7") + " SE7"
	cQuery +=     " ON (SE7.E7_NATUREZ = TOTAL.ED_CODIGO"
	If !Empty(cFilEscr)
		cQuery +=    " AND SE7.E7_FILIAL = ?"

		Aadd(aBind, {AllTrim(cFilEscr), "S"})
	EndIf
	cQuery +=    " AND SE7.E7_ANO = ?"

	Aadd(aBind, {cValtoChar(nAno), "S"})

	cQuery +=    " AND SE7.D_E_L_E_T_ = ?)"

	Aadd(aBind, {' ', "S"})

	cQuery +=  " GROUP BY TOTAL.ED_FILIAL, TOTAL.ED_CODIGO, TOTAL.ED_DESCRIC, TOTAL.ED_CMOEJUR"
	cQuery +=  " ORDER BY TOTAL.ED_CODIGO"

	cQuery := JurTRepBin(cQuery, aBind)

Return cQuery

//-------------------------------------------------------------------
/*/{Protheus.doc} JQryTotal()
Query principal com os totalizadores dos meses

@Param cTpContTmp - Tabela temporária com os dados dos tipos de conta
@param aMeses     - Array com as informações dinamicas dos meses
                   aMeses[nI][1] Descrição do mês.
                   aMeses[nI][2] Mês do saldo por Natureza.
                   aMeses[nI][3] Campo da SE7.
@Param cOriDest   - O tipo da natureza no lançamento O = Origem, D = Destino
@Param cTpConta   - Tipo de conta de Natureza
@param cFilEscr   - Código da Filial do Escritório filtrado

@return cQuery      - Query principal do relatório (Filtro por escritório)

@author Jacques Alves Xavier
@since 11/11/2025
@version 1.0
/*/
//-------------------------------------------------------------------
Static Function JQryTotal(cTpContTmp, aMeses, cOriDest, cTpConta, cFilEscr)
Local cQuery     := ""
Local cCpoOriDes := Iif(cOriDest == "O", "OHB_NATORI", "OHB_NATDES")
Local nI         := 0
Local cMesIni    := ""
Local cMesFin    := ""
Local cSaldoMes  := ""
Local aBind      := {}

	For nI := 1 to Len(aMeses)
		IIf(nI == 1          , cMesIni := DtoS(aMeses[nI][2]), Nil)
		IIf(nI == Len(aMeses), cMesFin := DtoS(LastDay(aMeses[nI][2])), Nil)

		cSaldoMes += JSaldoMes(aMeses[nI], cOriDest, cTpContTmp, cFilEscr) +", "
	Next nI

	cRealizado := " SUM( OHB.OHB_VLNAC ) * (SELECT SINAL FROM ? WHERE TIPO = ? AND CODIGO = SED.ED_TPCOJR)"

	cQuery += " SELECT SED.ED_TPCOJR, SED.ED_FILIAL, SED.ED_CODIGO, SED.ED_DESCRIC, SED.ED_CMOEJUR,"
	cQuery +=         cSaldoMes // Não precisa de bind, pois foi realizado na função JSaldoMes
	cQuery +=         cRealizado + " REALIZADO"

	Aadd(aBind, {cTpContTmp, "U"})
	Aadd(aBind, {cOriDest, "S"})

	cQuery +=   " FROM " + RetSqlName("OHB") + " OHB"
	cQuery +=  " INNER JOIN " + RetSqlName("SED") + " SED"
	cQuery +=     " ON SED.ED_FILIAL = ?"

	Aadd(aBind, {xFilial("SED"), "S"})

	cQuery +=    " AND SED.ED_CODIGO = OHB.?"

	Aadd(aBind, {cCpoOriDes, "U"})

	cQuery +=    " AND SED.D_E_L_E_T_ = ?"

	Aadd(aBind, {' ', "S"})

	cQuery +=  " WHERE OHB.OHB_DTLANC BETWEEN ? AND ?"

	Aadd(aBind, {cMesIni, "S"})
	Aadd(aBind, {cMesFin, "S"})

	If !Empty(cFilEscr)
		cQuery +=    " AND OHB.OHB_FILIAL = ?"

		Aadd(aBind, {AllTrim(cFilEscr), "S"})
	EndIf
	cQuery +=    " AND SED.ED_TPCOJR = ?"

	Aadd(aBind, {cTpConta, "S"})

	cQuery +=    " AND SED.ED_CCJURI IN (' ','1','2','3','4','5')"
	
	cQuery +=    " AND OHB.D_E_L_E_T_ = ?"

	Aadd(aBind, {' ', "S"})

	cQuery +=  " GROUP BY SED.ED_FILIAL, SED.ED_CODIGO, SED.ED_DESCRIC, SED.ED_CMOEJUR, SED.ED_TPCOJR"

	cQuery := JurTRepBin(cQuery, aBind)

Return cQuery

//-------------------------------------------------------------------
/*/{Protheus.doc} JSaldoMes(aMeses)
Rotina para gerar a SubQuery saldo de naturezas por mês.

@Param aMeses  - Array com as informações dinamicas dos meses
		aMeses[1] Descrição do mês.
		aMeses[2] Mês do saldo por Natureza.
		aMeses[3] Campo da SE7.

@Param cOriDest - O tipo da natureza no lançamento O = Origem, D = Destino
@Param cTpContTmp - Tabela temporária com os dados dos tipos de conta
@param cFilEscr   - Código da Filial do Escritório filtrado

@return cQuery  - SubQuery de somatória de saldo de naturezas por mês.

@author Jacques Alves Xavier
@since 11/11/2025
@version 1.0
/*/
//-------------------------------------------------------------------
Static Function JSaldoMes(aMeses, cOriDest, cTpContTmp, cFilEscr)
Local cQuery     := ""
Local cCpoOriDes := Iif(cOriDest == "O", "OHB_NATORI", "OHB_NATDES")
Local cMes       := aMeses[3]
Local aBind      := {}

	cQuery += "(SELECT COALESCE(SUM(OHBMES.OHB_VLNAC * TPCONTA.SINAL), 0) VALOR"
	cQuery +=   " FROM " + RetSqlName("OHB") + " OHBMES,"
	cQuery +=        " ? TPCONTA"

	Aadd(aBind, {cTpContTmp, "U"})

	cQuery +=  " WHERE OHBMES.OHB_DTLANC BETWEEN ? AND ?"

	Aadd(aBind, {DtoS(aMeses[2]), "S"})
	Aadd(aBind, {DtoS(LastDay(aMeses[2])), "S"})

	If !Empty(cFilEscr)
		cQuery +=    " AND OHBMES.OHB_FILIAL = ?"

		Aadd(aBind, {AllTrim(cFilEscr), "S"})
	EndIf
	cQuery +=    " AND OHBMES.? = SED.ED_CODIGO"

	Aadd(aBind, {cCpoOriDes, "U"})

	cQuery +=    " AND TPCONTA.TIPO = ?"

	Aadd(aBind, {AllTrim(cOriDest), "S"})

	cQuery +=    " AND TPCONTA.CODIGO = SED.ED_TPCOJR"
	cQuery +=    " AND OHBMES.D_E_L_E_T_ = ?) " + cMes

	Aadd(aBind, {' ', "S"})

	cQuery := JurTRepBin(cQuery, aBind)

Return cQuery

//-------------------------------------------------------------------
/*/{Protheus.doc} JGetValor()
Função para retornar o valor por mês

@Param cMes       - Mês para a pesquisa do valor
@Param aMeses     - Array com os meses filtrados
@Param cAlias     - Alias contendo os valores

@return nValor    - Retorno o valor para o mês pesquisado

@author Jacques Alves Xavier
@since 12/11/2025
@version 1.0
/*/
//-------------------------------------------------------------------
Static Function JGetValor(cMes, aMeses, cAlias)
Local nValor := 0
Local nPos   := aScan(aMeses, {|x| x[1] == cMes})

	If nPos > 0
		Do Case
			Case cMes == "Janeiro"
				nValor := (cAlias)->E7_VALJAN1
			Case cMes == "Fevereiro"
				nValor := (cAlias)->E7_VALFEV1
			Case cMes == "Marco"
				nValor := (cAlias)->E7_VALMAR1
			Case cMes == "Abril"
				nValor := (cAlias)->E7_VALABR1
			Case cMes == "Maio"
				nValor := (cAlias)->E7_VALMAI1
			Case cMes == "Junho"
				nValor := (cAlias)->E7_VALJUN1
			Case cMes == "Julho"
				nValor := (cAlias)->E7_VALJUL1
			Case cMes == "Agosto"
				nValor := (cAlias)->E7_VALAGO1
			Case cMes == "Setembro"
				nValor := (cAlias)->E7_VALSET1
			Case cMes == "Outubro"
				nValor := (cAlias)->E7_VALOUT1
			Case cMes == "Novembro"
				nValor := (cAlias)->E7_VALNOV1
			Case cMes == "Dezembro"
				nValor := (cAlias)->E7_VALDEZ1
		EndCase
	EndIf

Return nValor

//-------------------------------------------------------------------
/*/{Protheus.doc} JBuscEscr
Rotina para gerar a query do report principal do relatorio de
Resumo Financeiro.

@param cEscrit - Escritório para filtro
@param aMeses  - Array com as informações dinamicas dos meses
                 aMeses[nI][1] Descrição do mês.
                 aMeses[nI][2] Mês do saldo por Natureza.
                 aMeses[nI][3] Campo da SE7.

@return cQuery - Query principal do relatório (Filtro por escritório)

@author Jacques Alves Xavier
@since 19/11/2025
@version 1.0
/*/
//-------------------------------------------------------------------
Static Function JBuscEscr(cEscrit, aMeses)
Local cQuery   := " "
Local cMesIni  := DtoS(aMeses[1][2])
Local cMesFin  := DtoS(LastDay(aMeses[Len(aMeses)][2]))
Local cFilEscr := ""

	If !Empty(cEscrit)
		cFilEscr := JurGetDados("NS7", 1, xFilial("NS7") + cEscrit, "NS7_CFILIA")
	EndIf

	cQuery := " SELECT NS7.NS7_RAZAO, NS7.NS7_CFILIA "
	cQuery +=     "  FROM " + RetSqlName("NS7") + " NS7 "
	cQuery +=     " WHERE NS7.NS7_FILIAL = '" + xFilial("NS7") + "' "
	If !Empty(cEscrit)
		cQuery +=   " AND NS7.NS7_COD = '" + cEscrit + "' "
	EndIf
	cQuery +=       " AND NS7.D_E_L_E_T_ = ' ' "
	cQuery +=       " AND EXISTS (SELECT DISTINCT SED.R_E_C_N_O_ "
	cQuery +=                     " FROM " + RetSqlName("SED") + " SED "
	cQuery +=                    " INNER JOIN " + RetSqlName("OHB") + " OHB "
	cQuery +=                          " ON (OHB.OHB_NATORI = SED.ED_CODIGO OR OHB.OHB_NATDES = SED.ED_CODIGO) "
	If !Empty(cEscrit)
		cQuery +=                     " AND OHB.OHB_FILIAL = '" + cFilEscr + "' "
	EndIf
	cQuery +=                         " AND OHB.D_E_L_E_T_ = ' ' "
	cQuery +=                         " AND OHB.OHB_DTLANC BETWEEN '"+ cMesIni +"' AND '"+ cMesFin +"' "
	cQuery +=                       " WHERE SED.ED_FILIAL = '" + xFilial("SED") + "' "
	cQuery +=                         " AND SED.ED_TPCOJR IN ('2','3','4','6','8') "
	cQuery +=                         " AND SED.D_E_L_E_T_ = ' ' )"

Return cQuery
