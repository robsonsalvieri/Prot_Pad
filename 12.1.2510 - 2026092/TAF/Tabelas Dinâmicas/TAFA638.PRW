#INCLUDE "PROTHEUS.CH" 
#INCLUDE "FWMVCDEF.CH" 
#INCLUDE "TAFA638.CH"

/*----------------------------------------------------------------------
{Protheus.doc} TAFA638
Cadastro MVC de DeRE - Códigos de Tributação

Tabela 11 - Códigos de Tributação (codTrib)

Revisão: Anexo I v1.2.0 da DeRE (LC 214/2025) Layout do governo atualizado em 05/09/2026.

T7Q_ATIVTR 1-Serv. Financeiros 2-Serv. de Plano de Assist. à Saúde 3-Serv. Concurso Prog.

Ver Trecho 
    { SERVIÇOS FINANCEIROS (T7Q_ATIVTR = "1") }
    { PLANOS DE ASSISTÊNCIA À SAÚDE (T7Q_ATIVTR = "2") }
    { CONCURSOS DE PROGNÓSTICOS (T7Q_ATIVTR = "3") }

@author Carlos Pister
@since 02/03/2026
@version 1.0
----------------------------------------------------------------------*/
Function TAFA638()
	Local oBrowse := FWmBrowse():New()

	If AliasIndic("T7Q")
		oBrowse:SetDescription(STR0001) //'Dere - Códigos de Tributação'
		oBrowse:SetAlias('T7Q')
		oBrowse:SetMenuDef('TAFA638')
		oBrowse:Activate()
	Else
		MsgAlert(STR0002) //"Tabela T7Q não existe."
	EndIf

Return

/*----------------------------------------------------------------------
{Protheus.doc} ModelDef
Função genérica MVC do model

@return oModel - Objeto do Modelo MVC

@author Carlos Pister	
@since 02/03/2026
@version 1.0
----------------------------------------------------------------------*/
Static Function ModelDef()
	Local oStructT7Q := FWFormStruct(1, 'T7Q')
	Local oModel     := MPFormModel():New('TAFA638')

	oModel:AddFields('MODEL_T7Q',, oStructT7Q)
	oModel:GetModel('MODEL_T7Q'):SetPrimaryKey({'T7Q_FILIAL','T7Q_ID'})
Return oModel

/*----------------------------------------------------------------------
{Protheus.doc} ViewDef
Função genérica MVC da View

@return oView - Objeto da View MVC

@author Carlos Pister
@since 02/03/2026
@version 1.0
----------------------------------------------------------------------*/
Static Function ViewDef()
	Local oModel     := FWLoadModel('TAFA638')
	Local oStructT7Q := FWFormStruct(2, 'T7Q')
	Local oView      := FWFormView():New()

	oView:SetModel(oModel)
	oView:AddField('VIEW_T7Q', oStructT7Q, 'MODEL_T7Q')

	oView:EnableTitleView('VIEW_T7Q', STR0001) //'Dere - Códigos de Tributação'
	oView:CreateHorizontalBox('FIELDST7Q', 100)
	oView:SetOwnerView('VIEW_T7Q', 'FIELDST7Q')

	oStructT7Q:RemoveField('T7Q_ID')

Return oView 

/*----------------------------------------------------------------------
{Protheus.doc} MenuDef
Função genérica MVC com as opções de menu

@author Carlos Pister
@since 02/03/2026
@version 1.0
----------------------------------------------------------------------*/
Static Function MenuDef()
Return XFUNMnuTAF('TAFA638',,,.T.)

/*-------------------------------------------------------------------
{Protheus.doc} FAtuCont

Rotina para carga e atualização da tabela autocontida.

@Param	nVerEmp	- Versão corrente na empresa
		nVerAtu	- Versão atual (passado como referência)
@Return	aRet - Array com estrutura de campos e conteúdo da tabela

@Author	 Carlos Pister
@Since	 02/03/2026
@Version 1.0
-------------------------------------------------------------------*/
Static Function FAtuCont(nVerEmp, nVerAtu)

Local aHeader := {}
Local aBody   := {}
Local aRet    := {}

nVerAtu := 1033.95

If nVerEmp < nVerAtu

    aAdd(aHeader, 'T7Q_FILIAL')
    aAdd(aHeader, 'T7Q_ID')
    aAdd(aHeader, 'T7Q_ATIVTR') //1-Serv. Financeiros 2-Serv. de Plano de Assist. à Saúde 3-Serv. Concurso Prog.
    aAdd(aHeader, 'T7Q_TIPO')   //1-Analítica 2-Sintética
    aAdd(aHeader, 'T7Q_CODTRI')
    aAdd(aHeader, 'T7Q_TITTRI')
    aAdd(aHeader, 'T7Q_DESCRI')
    aAdd(aHeader, 'T7Q_DISPLG')
    aAdd(aHeader, 'T7Q_ALTCON')

    // ============================================================
    // { SERVIÇOS FINANCEIROS (T7Q_ATIVTR = "1") }
    // ============================================================
    aAdd(aBody,{"","bdfad34c-9493-7bbf-688a-f39078d7b33b","1","2","1","ATIVO","","",1033.95})
    aAdd(aBody,{"","e4c07730-7886-8e11-54fb-be0005aa11d9","1","2","11","SERVIÇOS FINANCEIROS","","",1033.95})
    aAdd(aBody,{"","895cf1f3-8077-b5b7-9d51-4fd1f33408ef","1","2","1101","CRÉDITO, CÂMBIO E TVM","","",1033.95})
    aAdd(aBody,{"","c14ca9af-3737-14b4-d196-fafc073fc943","1","2","11011","VALORES REMUNERADOS POR MARGEM","","",1033.95})
    aAdd(aBody,{"","6aa20b7b-2eda-5c62-d804-0e5aa2d3f458","1","2","110111","VALORES TRIBUTADOS PELO REGIME DE CAIXA","","",1033.95})
    aAdd(aBody,{"","35482d8d-4016-8b3b-6115-6fa5fdb6c4b9","1","1","110111001","Valores recebidos da administração pública tributados pelo regime de caixa","Classificar nesse código as rubricas contábeis representativas dos valores recebidos da administração pública direta, autárquica ou fundacional, cuja tributação se dá no momento do efetivo recebimento.","LC 214/2025 Art. 10, § 2º",1033.95})
    aAdd(aBody,{"","c9b32886-e7f6-0d33-bba3-3c2a2dc5e359","1","2","110112","VALORES RECEBIDOS EM OPERAÇÕES DE CRÉDITO E TVM","","",1033.95})
    aAdd(aBody,{"","928044d4-4539-0920-67e2-0903e49d8eaa","1","1","110112001","Valores recebidos em operações de crédito, relativos a contratos firmados em moeda nacional","Classificar nesse código as rubricas contábeis representativas dos valores em operações de crédito, que serão usadas como base para cálculo do valor do IBS e da CBS que será concedido como crédito aos adquirentes, relativos a contratos firmados em moeda nacional. Obs.: As receitas oriundas de operações com títulos de dívida com oferta pública devem ser classificadas em código específicos, por não darem direito a crédito.","LC 214/2025 Art. 194",1033.95})
    aAdd(aBody,{"","befcb40f-259c-892d-d6b1-772f1df5d13e","1","1","110112002","Valores recebidos em operações de crédito, relativos a contratos firmados em moeda estrangeira","Classificar nesse código as rubricas contábeis representativas dos valores recebidos em operações de crédito, relativos a contratos firmados em moeda estrangeira.","LC 214/2025 Art. 197, II",1033.95})
    aAdd(aBody,{"","21ba96b6-e8b4-eb04-c403-eca8ac67e0bb","1","1","110112003","Valores recebidos em operações de TVM, relativos a contratos firmados em moeda nacional","Classificar nesse código as rubricas contábeis representativas dos valores em operações de TVM, que serão usadas como base para cálculo do valor do IBS e da CBS que será concedido como crédito aos adquirentes, relativos a contratos firmados em moeda nacional. Obs.: As receitas oriundas de operações com títulos de dívida com oferta pública devem ser classificadas em código específicos, por não darem direito a crédito.","LC 214/2025 Art. 195",1033.95})
    aAdd(aBody,{"","f6cd92a7-5c76-a682-59ac-61099eb8ab3d","1","1","110112004","Valores recebidos em operações de TVM, relativos a contratos firmados em moeda estrangeira","Classificar nesse código as rubricas contábeis representativas dos valores em operações de TVM, relativos a contratos firmados em moeda estrangeira.","LC 214/2025 Art. 197, II",1033.95})
    aAdd(aBody,{"","67444e63-b5f8-8d54-c4d6-d2ae6f97633b","1","1","110112005","Valores recebidos em operações de crédito, com recursos do FGTS","Classificar nesse código as rubricas contábeis representativas dos valores recebidos em operações de crédito com recursos do FGTS, que serão usadas como base para cálculo do valor do IBS e da CBS que será concedido crédito aos adquirentes.","LC 214/2025 Art. 194",1033.95})
    aAdd(aBody,{"","8f7dc27a-1447-9f15-9402-c9cb01588d10","1","2","110113","OPERAÇÕES COM TÍTULOS DE DÍVIDA OBJETO DE OFERTA PÚBLICA","","",1033.95})
    aAdd(aBody,{"","b427a1c5-63d7-7f1f-d332-2a09ff7d6879","1","1","110113001","Títulos de dívida objeto de oferta pública","Classificar nesse código as rubricas contábeis representativas dos saldos dos títulos de dívida que forem objeto de oferta pública na forma regulamentada pela CVM.","LC 214/2025 Art. 195, § 1º",1033.95})
    aAdd(aBody,{"","400ca181-c15b-4594-b380-913178ffd0b7","1","1","110113002","Títulos de dívida objeto de oferta pública - Fundo de investimento exclusivo","Classificar nesse código as rubricas contábeis representativas dos saldos das aplicações em cotas de fundos de investimento exclusivos cuja carteira seja composta por, no mínimo, 95% (noventa e cinco por cento) de títulos de dívida que sejam objeto de oferta pública na forma regulamentada pela CVM.","LC 214/2025 Art. 195, § 2º",1033.95})
    aAdd(aBody,{"","d58b0042-699d-24c8-50a6-9dc40a18c73e","1","2","11012","VALORES REMUNERADOS POR PREÇO","","",1033.95})
    aAdd(aBody,{"","b51ac783-7e39-dd36-9a1b-79048c57164a","1","2","110121","VALORES TRIBUTADOS PELO REGIME DE CAIXA","","",1033.95})
    aAdd(aBody,{"","84d3fc49-3697-2711-d3b8-1bd85824461b","1","1","110121001","Valores recebidos da administração pública tributados pelo regime de caixa","Classificar nesse código as rubricas contábeis representativas dos valores recebidos da administração pública direta, autárquica ou fundacional, cuja tributação se dá no momento do efetivo recebimento.","LC 214/2025 Art. 10, § 2º",1033.95})
    aAdd(aBody,{"","0d745b2b-a10f-4b85-d824-8dbece67614b","1","2","1102","SECURITIZAÇÃO E FATURIZAÇÃO","","",1033.95})
    aAdd(aBody,{"","789e9705-89c2-95e7-bde1-220a7f417e75","1","2","11021","SECURITIZAÇÃO","","",1033.95})
    aAdd(aBody,{"","fb935f01-e026-4405-a735-1cab66559f3f","1","2","110211","SERVIÇOS REMUNERADOS POR PREÇO","","",1033.95})
    aAdd(aBody,{"","f862ab3c-0602-45a6-b3d8-726a52e60386","1","2","1102111","VALORES RECEBIDOS TRIBUTÁVEIS","","",1033.95})
    aAdd(aBody,{"","61f9667d-7b3f-49cd-9d29-df1656a6fe6c","1","1","110211101","Taxas de administração fiduciária","Classificar nesse código as rubricas contábeis representativas dos valores recebidos relativas a tarifas e comissões vinculadas a operações de securitização, tais como taxas de estruturação, emissão, cessão, entre outras.","LC 214/2025 Art. 185",1033.95})
    aAdd(aBody,{"","9be256c2-e7dd-4dfc-bc49-902646dc49e9","1","2","1102114","VALORES RECEBIDOS TRIBUTÁVEIS PELA REGRA DE TRANSIÇÃO","","",1033.95})
    aAdd(aBody,{"","7d1c6dc9-8c4b-421f-9c5c-4966b7cdb1ea","1","1","110211401","Valores tributados pelo PIS/Cofins - Não tributáveis pela CBS - FG Competência","Classificar nesse código as rubricas contábeis representativas valores recebidos, que sejam tributados pelo PIS/COFINS durante o período de transição.","LC 214/2025 Art. 408, § 1º",1033.95})
    aAdd(aBody,{"","d38f1b7c-1ac0-4159-bb4d-d19e20b223d1","1","1","110211402","Valores tributados pelo PIS/Cofins - Não tributáveis pela CBS - FG Caixa","Classificar nesse código as rubricas contábeis representativas valores recebidos, que sejam tributados pelo PIS/COFINS durante o período de transição.","LC 214/2025 Art. 408, § 3º",1033.95})
    aAdd(aBody,{"","b2beb0d0-d70f-4191-8d26-6c3e65b116ec","1","2","1102115","VALORES RECEBIDOS NÃO TRIBUTÁVEIS OU SUJEITOS À ALÍQUOTA ZERO","","",1033.95})
    aAdd(aBody,{"","d3c98f44-6b8a-4b2d-9e22-98181504e919","1","1","110211501","Exportação de serviços","Classificar nesse código as rubricas contábeis representativas valores recebidos, que sejam provenientes de residentes no exterior e atendam os requisitos legais para serem consideradas exportação de serviços. Incluir nesse código os valores relativos a tarifas e outros encargos vinculados aos referidos contratos.","LC 214/2025 Art. 232",1033.95})
    aAdd(aBody,{"","494c303d-1409-4ddf-bdf9-c06a67b57540","1","2","1102116","VALORES PAGOS DEDUTÍVEIS","","",1033.95})
    aAdd(aBody,{"","0f5f0d77-4503-4e82-bd37-1d34cc7359b1","1","2","11021161","DESPESAS GERAIS","","",1033.95})
    aAdd(aBody,{"","94936d9d-1e04-4fee-8d96-4393d1f036b7","1","1","110211611","Despesas de securitização","Classificar nesse código as rubricas contábeis representativas das despesas com securitização, consistindo na emissão, distribuição, custódia, escrituração, registro, preparação e formalização de documentos, administração do patrimônio separado e atuação de agentes fiduciários, de cobrança e de classificação de risco, desde que esses serviços não tenham sido prestados por empregados ou administradores da empresa. Essas despesas devem ser acobertadas por documento fiscal idôneo, emitido pelo prestador do serviço.","LC 214/2025 Art. 193, § 1º, II",1033.95})
    aAdd(aBody,{"","8497cc4e-1be5-40a9-a84f-c32d80758e0f","1","2","11022","FATURIZAÇÃO","","",1033.95})
    aAdd(aBody,{"","6903ebb7-fa17-4f15-ba1e-a074a4d518db","1","2","110221","SERVIÇOS REMUNERADOS POR MARGEM","","",1033.95})
    aAdd(aBody,{"","11e67e2f-e277-4379-9a02-06a0c9895bee","1","2","1102211","VALORES RECEBIDOS TRIBUTÁVEIS","","",1033.95})
    aAdd(aBody,{"","c74c5d7d-aff6-4817-8b11-e6738d5bad8b","1","1","110221101","Faturização - Desconto aplicado - Contratos em moeda nacional","Classificar nesse código as rubricas contábeis representativas do valor do desconto aplicado em operações de faturização, em contratos firmados em moeda nacional.","LC 214/2025 Art. 193, § 1º",1033.95})
    aAdd(aBody,{"","a91cb7b6-603d-444a-a9c6-bb83219641ac","1","1","110221102","Faturização - Desconto aplicado - Contratos em moeda estrangeira","Classificar nesse código as rubricas contábeis representativas do valor do desconto aplicado em operações de faturização, em contratos firmados em moeda estrangeira.","LC 214/2025 Art. 193, § 1º",1033.95})
    aAdd(aBody,{"","adfda3dc-9cdd-4415-a899-a2197b0a84b3","1","1","110221103","Valor recebido do exterior (não considerado exportação)","Classificar nesse código as rubricas contábeis representativas dos valores residuais recebidos, que sejam provenientes de residentes no exterior, mas que não sejam consideradas exportação de serviços, sendo, portanto, tributáveis para o IBS/CBS.","LC 214/2025 Art. 232, § 2º",1033.95})
    aAdd(aBody,{"","4318c045-0fa7-44e3-a4bc-63984c3c26cd","1","2","1102214","VALORES RECEBIDOS TRIBUTÁVEIS PELA REGRA DE TRANSIÇÃO","","",1033.95})
    aAdd(aBody,{"","a8e942ac-7096-4e1f-b0c9-ff1407237588","1","1","110221401","Valores tributados pelo PIS/Cofins - Não tributáveis pela CBS - FG Competência","Classificar nesse código as rubricas contábeis representativas valores recebidos, que sejam tributados pelo PIS/COFINS durante o período de transição.","LC 214/2025 Art. 408, § 1º",1033.95})
    aAdd(aBody,{"","7cfa2668-1ca9-4362-9942-eea1c852e9b6","1","1","110221402","Valores tributados pelo PIS/Cofins - Não tributáveis pela CBS - FG Caixa","Classificar nesse código as rubricas contábeis representativas valores recebidos, que sejam tributados pelo PIS/COFINS durante o período de transição.","LC 214/2025 Art. 408, § 3º",1033.95})
    aAdd(aBody,{"","e9bd1119-19c5-4113-ae4c-3b0f2a1d1d0c","1","2","1102215","VALORES RECEBIDOS NÃO TRIBUTÁVEIS OU SUJEITOS À ALÍQUOTA ZERO","","",1033.95})
    aAdd(aBody,{"","12d16f84-4be1-4cba-8302-bd87240a9558","1","1","110221501","Exportação de serviços","Classificar nesse código as rubricas contábeis representativas valores recebidos, que sejam provenientes de residentes no exterior e atendam os requisitos legais para serem consideradas exportação de serviços. Incluir nesse código os valores relativos a tarifas e outros encargos vinculados aos referidos contratos.","LC 214/2025 Art. 232",1033.95})
    aAdd(aBody,{"","503ad1fd-8e52-43cd-8749-1878363d76c0","1","2","1102216","VALORES DEDUTÍVEIS","","",1033.95})
    aAdd(aBody,{"","0d8242c2-1ba3-42df-b428-163b53b45339","1","2","11022161","DESPESAS GERAIS","","",1033.95})
    aAdd(aBody,{"","5dbdced4-fedd-4d76-ab85-17b5c2bd4056","1","1","110221611","Perdas incorridas nos recebimentos de créditos e na concessão de descontos","Classificar nesse código as rubricas contábeis representativas das despesas com perdas incorridas no recebimento de créditos e as perdas na cessão destes créditos e na concessão de descontos, desde que sejam realizados a valor de mercado.","LC 214/2025 Art. 193, § 2º",1033.95})
