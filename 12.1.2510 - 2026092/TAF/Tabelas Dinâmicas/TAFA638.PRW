    aAdd(aBody,{"","e3984218-5e00-483b-b24c-81085e4cc00c","1","2","41103128","DESPESAS NÃO DEDUTÍVEIS","","",1033.95})
    aAdd(aBody,{"","aec4a497-dcff-4f5b-80b4-7255ec68d4dc","1","1","411031281","Valor dos bens imóveis adquiridos para fins de arrendamento","Classificar nesse código as rubricas contábeis onde estão registrados os bens imóveis adquiridos para fins de arrendamento mercantil operacional, comprovados mediante emissão de documento fiscal ou não (no caso de aquisição de pessoa física).","LC 214/2025 Art. 303",1033.95})
    aAdd(aBody,{"","08bdaaab-39c7-6f40-c75a-067491941db2","1","2","4110313","OPERAÇÕES - BENS MÓVEIS - CONTRIBUINTES IBS/CBS","","",1033.95})
