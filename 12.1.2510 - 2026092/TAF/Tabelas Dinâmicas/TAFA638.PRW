    aAdd(aBody,{"","8931bd2c-02c4-0682-988f-d2f3c66de162","2","1","120210004","Prêmios ou contraprestações recebidas - corresponsabilidade assumida","Classificar nesse código as rubricas contábeis representativas dos valores recebidos por prêmios ou contraprestações em razão de corresponsabilidade assumida.","LC 214/2025 Art. 235, I, a",1033.95})
