    aAdd(aBody,{"","c7dfd5c9-3567-458d-43e9-775a8945b7bc","1","1","110910001","Valores recebidos da administração pública tributados pelo regime de caixa","Classificar nesse código as rubricas contábeis representativas dos valores recebidos da administração pública direta, autárquica ou fundacional, cuja tributação se dá no momento do efetivo recebimento.","LC 214/2025 Art. 10, § 2º",1033.95})
