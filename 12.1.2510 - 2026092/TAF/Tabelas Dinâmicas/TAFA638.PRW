    aAdd(aBody,{"","e56bedce-c5cf-879e-c583-911c53083efc","1","1","411168099","Outras despesas não dedutíveis","Classificar nesse código as rubricas contábeis relativas a outras despesas não dedutíveis da base de cálculo do IBS/CBS.","",1033.95})
    aAdd(aBody,{"","3790aa5f-1b30-d4d0-3bc0-595db58800ff","1","2","41199","DESPESAS GERAIS - TODAS AS ATIVIDADES","","",1033.95})
    aAdd(aBody,{"","7eeba1b7-504e-e911-7831-06419b8c4f87","1","2","411998","DESPESAS NÃO DEDUTÍVEIS","","",1033.95})
    aAdd(aBody,{"","f8e2561b-0629-c8ce-e58c-79fe79240001","1","1","411998001","Despesa de captação de cooperativas com recursos próprios, de cooperados ou recursos públicos","Classificar nesse código as despesas com captação de recursos junto a cooperados, ou com recursos públicos ou, ainda, recursos próprios, no caso das cooperativas de crédito ou bancos cooperativos, optantes pelo regime específico do Art. 271 da LC 214/2025, aplicados em operações com cooperados do regime regular do IBS/CBS.","LC 214/2025 Art. 192, § 8º",1033.95})
    aAdd(aBody,{"","add9de8d-4dd0-4086-8fcb-329d447d209a","1","1","411998002","Provisão para perdas","Classificar nesse código as despesas com provisão para perdas.","LC 214/2025 Art. 186",1033.95})
    aAdd(aBody,{"","962d64e5-82a7-b9b6-8e9d-c7de51062183","1","1","411998003","Crédito baixado como prejuízo","Classificar nesse código as despesas com créditos baixados como prejuízo.","LC 214/2025 Art. 186",1033.95})
    aAdd(aBody,{"","4cc94e26-d314-57e2-4e23-4bbfc78ec097","1","1","411998004","Despesas administrativas","Classificar nesse código as despesas administrativas.","LC 214/2025 Art. 187",1033.95})
    aAdd(aBody,{"","2faafee0-2c17-7300-4bc5-473555081d14","1","1","411998005","Despesa já deduzida anteriormente","Classificar nesse código as despesas já deduzidas anteriormente.","LC 214/2025 Art. 302",1033.95})
    aAdd(aBody,{"","d0b89979-0a53-c377-3e93-a95cb566f252","1","1","411998006","Despesa com correspondente bancário não vinculada a serviços de crédito, câmbio e TVM","Classificar nesse código as despesas com correspondentes bancários, não vinculados aos serviços de crédito, câmbio e TVM, devidamente comprovados por meio de documento fiscal idôneo, emitidos pelos prestadores do serviço. Nesse caso, o contribuinte pode aproveitar crédito do IBS e CBS sobre o serviço.","LC 214/2025 Art. 192, VI",1033.95})
    aAdd(aBody,{"","c49e61c2-e827-a4c4-a5e9-9ea584134683","1","1","411998099","Outras despesas não dedutíveis","Classificar nesse código as rubricas contábeis relativas a outras despesas não dedutíveis da base de cálculo do IBS/CBS.","",1033.95})
