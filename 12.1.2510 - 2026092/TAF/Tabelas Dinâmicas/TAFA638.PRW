    aAdd(aBody,{"","17b26b6f-3351-7dc6-66de-79fba360dc6b","1","1","411166002","ISSQN incidente sobre a operação","Classificar nesse código as despesas com ISSQN incidentes sobre as operações.","LC 214/2025 Art. 12, § 2º, V",1033.95})
