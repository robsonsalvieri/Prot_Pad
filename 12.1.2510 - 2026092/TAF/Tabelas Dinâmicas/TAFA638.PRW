    aAdd(aBody,{"","a4f2a388-f0f3-5bf5-d2d3-ac95a470870c","1","1","110324801","Valor dos bens móveis adquiridos para fins de arrendamento","Classificar nesse código as rubricas contábeis onde estão registrados os bens móveis adquiridos para fins de arrendamento mercantil operacional, comprovados mediante emissão de documento fiscal.","LC 214/2025 Art. 303",1033.95})
    aAdd(aBody,{"","02bc66bc-db3b-ff0d-9f00-4a937db466ae","1","2","1104","ARRENDAMENTO MERCANTIL FINANCEIRO","","",1033.95})
