#include "tlpp-core.th"
#include "tlpp-object.th"
#include "totvs.ch"

namespace backoffice.taf.dere.xml

/*-------------------------------------------------------------------------------
{Protheus.doc} TAFDereEventsMonitor
Classe responsï¿½vel por monitorar o eventos da Dere.

@type class
@author Rafael de Paula Leme
@since 20/08/2026
@version 1.0
-------------------------------------------------------------------------------*/
Class TAFDereXmlEvents

	public  method New() 				as object
	public  method TafDereGetXmlEvent() as character
	private method GetXmlD1001()        as character
	private method GetXmlD1011()        as character
	private method GetStartEndDate()    as array
	private method GetFormattedDate()   as character

EndClass

/*-------------------------------------------------------------------------------
{Protheus.doc} New()
Método para instanciar a classe

@type method
@author Rafael de Paula Leme
@since 20/08/206
@version 1.0
-------------------------------------------------------------------------------*/
method New() as object class TAFDereXmlEvents  
return Self

/*-------------------------------------------------------------------------------
{Protheus.doc} TafDereGetXmlEvent()
Metodo responsável por gerar os XMLs dos eventos da Dere

@type method
@author Rafael de Paula Leme
@since 20/08/2026
@version 1.0
-------------------------------------------------------------------------------*/
method TafDereGetXmlEvent(cEvento as character, cID as character, cVersao as character) as character class TAFDereXmlEvents
	Local cXML := "" as character

	If cEvento == "D-1001"
		cXML := ::GetXmlD1001(cID, cVersao)
	ElseIf cEvento == "D-1011"
		cXML := ::GetXmlD1011(cID, cVersao)
	EndIf

Return(cXML)

/*-------------------------------------------------------------------------------
{Protheus.doc} GetXmlD1001()
Metodo responsável por gerar o xml do evento D-1001

@type method
@author Rafael de Paula Leme
@since 20/08/2026
@version 1.0
-------------------------------------------------------------------------------*/
method GetXmlD1001(cIDT7T as character, cVersao as character) as character class TAFDereXmlEvents

	Local oRegSec := Nil as object
	Local aDatas  := {}  as array
	Local aRegFin := {}  as array
	Local aRegSau := {}  as array
	Local aRegPro := {}  as array
	Local aRet    := {}  as array
	Local lUf     := .F. as logical
	Local nX      := 0   as numeric
	Local cXml    := ""  as character
	Local cChvT7U := ""  as character
	Local cChvT7V := ""  as character

	Default cIDT7T  := ""
	Default cVersao := ""
	
	oRegSec := HMNew()

	//Montagem do corpo do XML
	cXml += "<idePeriodo>"

	DBSelectArea("T7T")
	T7T->(DBSetOrder(1)) //T7T_FILIAL+T7T_ID+T7T_VERSAO
	T7T->(DBSeek(xFilial("T7T") + cIDT7T + cVersao))

	If T7T->T7T_EVENTO == "A"
		aDatas := self:GetStartEndDate("T7T", T7T->T7T_ID, T7T->T7T_VERSAO, T7T->T7T_VERANT)
		If Len(aDatas) == 2 .and. (aDatas[1][1] <> aDatas[2][1] .or. aDatas[1][2] <> aDatas[2][2])
			cXml += xTafTag("iniValid", self:GetFormattedDate(aDatas[2][1]))
			If !(Empty(aDatas[2][2]))
				cXml += xTafTag("fimValid", self:GetFormattedDate(aDatas[2][2]))
			EndIf
		Else
			cXml += xTafTag("iniValid", self:GetFormattedDate(DtoS(T7T->T7T_DTINVA)))
			If !(Empty(T7T->T7T_DTFIVA))
    			cXml += xTafTag("fimValid", self:GetFormattedDate(DtoS(T7T->T7T_DTFIVA)))
			EndIf
		EndIf
	Else
		//Inclusao (I) e exclusao (E): iniValid e obrigatorio no XSD (minOccurs=1),
		//portanto idePeriodo nao pode ser gerado vazio
		cXml += xTafTag("iniValid", self:GetFormattedDate(DtoS(T7T->T7T_DTINVA)))
		If !(Empty(T7T->T7T_DTFIVA))
    		cXml += xTafTag("fimValid", self:GetFormattedDate(DtoS(T7T->T7T_DTFIVA)))
		EndIf
	EndIf
	
	//Verifico se houve alteração nas datas da versão ativa x versão inativa. Se houver,
	//é necessário informar o grupo novaValidade
	If Len(aDatas) == 2 .and. T7T->T7T_EVENTO == "A" .and. (aDatas[1][1] <> aDatas[2][1] .or. aDatas[1][2] <> aDatas[2][2])
		cXml += "<novaValidade>"
		cXml += 	xTafTag("iniValid", self:GetFormattedDate(aDatas[1][1]))
		If !(Empty(aDatas[1][2]))
			cXml +=     xTafTag("fimValid", self:GetFormattedDate(aDatas[1][2]))
		EndIf
		cXml += "</novaValidade>"
	EndIf

	cXml += "</idePeriodo>"
	If T7T->T7T_EVENTO == "I" .or. T7T->T7T_EVENTO == "A"
		cXml += "<infoContrib>"
		cXml += 	xTafTag("regTribPrinc", T7T->T7T_REGPRI)

		DBSelectArea("T7U")
		DBSetOrder(3) //T7U_FILIAL+T7U_ID+T7U_VERSAO+T7U_ATIVO
		//A chave completa impede que registros de outras versoes ou inativos entrem no XML
		cChvT7U := xFilial("T7U") + T7T->T7T_ID + T7T->T7T_VERSAO + T7T->T7T_ATIVO
		If DBSeek(cChvT7U)
			While !T7U->(Eof()) .and. T7U->(T7U_FILIAL + T7U_ID + T7U_VERSAO + T7U_ATIVO) == cChvT7U
				//T7U_REGIME indica principal(1)/secundario(2); o codigo do regime esta
				//em T7U_TPATIV. Comparar REGIME com REGPRI emitia o regime principal
				//como regTribSecund quando T7T_REGPRI era 2 ou 3
				If T7U->T7U_TPATIV <> T7T->T7T_REGPRI
					If !HMGet(oRegSec, T7U->T7U_TPATIV, aRet)
						HMAdd(oRegSec, {T7U->T7U_TPATIV, 1})
						cXml += xTafTag("regTribSecund", T7U->T7U_TPATIV)
					EndIF
				EndIf

				Do Case
					Case T7U->T7U_TPATIV == '1'
						Aadd(aRegFin, T7U->T7U_CODATI)
					Case T7U->T7U_TPATIV == '2'
						Aadd(aRegSau, T7U->T7U_CODATI)
					Case T7U->T7U_TPATIV == '3'
						Aadd(aRegPro, T7U->T7U_CODATI)
				EndCase

				T7U->(DbSkip())
			EndDo

		EndIf

		cXml += xTafTag("indNatTrib", T7T->T7T_INTRI)

		If Len(aRegFin) > 0
			cXml += "<servFinanc>"
			cXml += 	"<tpAtividades>"
			For nX := 1 to Len(aRegFin)
				cXml += 	xTafTag("tpAtividade", aRegFin[nX])
			Next nX
			cXml += 	"</tpAtividades>"
			cXml += "</servFinanc>"
		EndIf

		If Len(aRegSau) > 0
			cXml += "<plAssistSaude>"
			cXml += 	"<tpAtividades>"
			For nX := 1 to Len(aRegSau)
				cXml += 	xTafTag("tpAtividade", aRegSau[nX])
			Next nX
			cXml += 	"</tpAtividades>"
			cXml += "</plAssistSaude>"
		EndIf

		DBSelectArea("T7V")
		DBSetOrder(2) //T7V_FILIAL+T7V_ID+T7V_VERSAO+T7V_ATIVO
		cChvT7V := xFilial("T7V") + T7T->T7T_ID + T7T->T7T_VERSAO + T7T->T7T_ATIVO
		lUf := DBSeek(cChvT7V)

		//O XSD exige tpAtividades dentro de prognosticos (minOccurs=1), logo o grupo
		//so pode ser aberto quando existe atividade de concursos de prognosticos
		If Len(aRegPro) > 0
			cXml += "<prognosticos>"
			cXml += 	"<tpAtividades>"
			For nX := 1 to Len(aRegPro)
				cXml += 	xTafTag("tpAtividade", aRegPro[nX])
			Next nX
			cXml += 	"</tpAtividades>"
			If lUf
				cXml += "<UFsCredenc>"
				While !T7V->(EoF()) .and. T7V->(T7V_FILIAL + T7V_ID + T7V_VERSAO + T7V_ATIVO) == cChvT7V
					cXml +=	xTafTag("UFCredenc", T7V->T7V_CODUFC)
					T7V->(DbSkip())
				EndDo
				cXml += "</UFsCredenc>"
			EndIf
			cXml += "</prognosticos>"
		EndIf
		cXml += "</infoContrib>"
	EndIf
	
	//Complementa XML com cabeçalho
	cXml := TAFXmlDeRE(cXml, '1001', T7T->T7T_EVENTO, T7T->T7T_MOTEXC, T7T->T7T_NRPROC)

	FreeObj(oRegSec)
	oRegSec := NIL

Return cXml

/*-------------------------------------------------------------------------------
{Protheus.doc} GetXmlD1001()
Metodo responsável por gerar o xml do evento D-1011

@type method
@author Rafael de Paula Leme
@since 20/08/2026
@version 1.0
-------------------------------------------------------------------------------*/
method GetXmlD1011(cIDT7Z as character, cVersao as character) as character class TAFDereXmlEvents
	Local aDatas       := {} as array
	Local cXml         := "" as character
	Local cChaveT8A    := "" as character
	Local cCta         := "" as character
	
	Default cIDT7Z  := ""
	Default cVersao := ""
	
	DBSelectArea("T7Z")
	T7Z->(DBSetOrder(1)) //T7Z_FILIAL+T7Z_ID+T7Z_VERSAO
	T7Z->(DBSeek(xFilial("T7Z") + cIDT7Z + cVersao))

	DBSelectArea("T8A")
	T8A->(DBSetOrder(1)) //T8A_FILIAL+T8A_ID+T8A_VERSAO                                                                                                                                                                                                                              
	T8A->(DBSeek(xFilial("T8A") + cIDT7Z + cVersao))

	//Montagem do corpo do XML
	cXml += "<idePeriodo>"

	If T7Z->T7Z_EVENTO == "A"
		aDatas := self:GetStartEndDate("T7Z", T7Z->T7Z_ID, T7Z->T7Z_VERSAO, T7Z->T7Z_VERANT)
		If Len(aDatas) == 2 .and. (aDatas[1][1] <> aDatas[2][1] .or. aDatas[1][2] <> aDatas[2][2])
			cXml += xTafTag("iniValid", self:GetFormattedDate(aDatas[2][1]))
			If !Empty(aDatas[2][2])
				cXml += xTafTag("fimValid", self:GetFormattedDate(aDatas[2][2]))
			EndIf
		Else
			cXml += xTafTag("iniValid", self:GetFormattedDate(DtoS(T7Z->T7Z_DTINVA)))
			If !Empty(T7Z->T7Z_DTFIVA)
    			cXml += xTafTag("fimValid", self:GetFormattedDate(DtoS(T7Z->T7Z_DTFIVA)))
			EndIf
		EndIf
	Else
		//Inclusao (I) e exclusao (E): iniValid e obrigatorio no XSD (minOccurs=1),
		//portanto idePeriodo nao pode ser gerado vazio
		cXml += xTafTag("iniValid", self:GetFormattedDate(DtoS(T7Z->T7Z_DTINVA)))
		If !Empty(T7Z->T7Z_DTFIVA)
    		cXml += xTafTag("fimValid", self:GetFormattedDate(DtoS(T7Z->T7Z_DTFIVA)))
		EndIf
	EndIf
	
	//Verifico se houve alteração nas datas da versão ativa x versão inativa. Se houver,
	//é necessário informar o grupo novaValidade
	If Len(aDatas) == 2 .and. T7Z->T7Z_EVENTO == "A" .and. (aDatas[1][1] <> aDatas[2][1] .or. aDatas[1][2] <> aDatas[2][2])
		cXml += "<novaValidade>"
		cXml += 	xTafTag("iniValid", self:GetFormattedDate(aDatas[1][1]))
		If !Empty(aDatas[1][2])
			cXml += xTafTag("fimValid", self:GetFormattedDate(aDatas[1][2]))
		EndIf
		cXml += "</novaValidade>"
	EndIf

	cXml += "</idePeriodo>"

	If T7Z->T7Z_EVENTO == "I" .or. T7Z->T7Z_EVENTO == "A"
		cXml += "<infoPGCC>"
		cXml += 	xTafTag("planoCtaRef", T7Z->T7Z_PLANCT)
		cXml += 	xTafTag("freqEncerr", T7Z->T7Z_FREQEN)
		cXml += 	"<infoContas>"

		cChaveT8A := T8A->T8A_FILIAL + T8A->T8A_ID + T8A->T8A_VERSAO

		While !T8A->(EOf()) .and. cChaveT8A == T7Z->T7Z_FILIAL + T7Z->T7Z_ID + T7Z->T7Z_VERSAO
					
			// cCta: concatenacao de cCtaInterna + cDbrMista
			cCta := AllTrim(T8A->T8A_CONTA) + AllTrim(T8A->T8A_DESDCT)	
			
			//=============================================================================
			// Montagem do XML
			//=============================================================================
			cXml += 	"<infoConta>"
			cXml += 		xTafTag("cCta", cCta)
			cXml += 		xTafTag("cCtaInterna", AllTrim(T8A->T8A_CONTA))
			cXml += 		xTafTag("cDbrMista", AllTrim(T8A->T8A_DESDCT))
			cXml += 		xTafTag("nomeCta", AllTrim(T8A->T8A_DESCCT))
			cXml += 		xTafTag("indCta", T8A->T8A_INDCTA)
			
			If !Empty(T8A->T8A_DESNAT) //Não obrigatório, vazio não gera.
				cXml += 	xTafTag("descCta", AllTrim(T8A->T8A_DESNAT))
			EndIf
			
			If !Empty(T8A->T8A_CNTSUP) //Não obrigatório, vazio não gera.
				cXml += 	xTafTag("cCtaSup", AllTrim(T8A->T8A_CNTSUP))
			EndIf
			
			cXml += 		xTafTag("cCtaRef", AllTrim(T8A->T8A_CODREF))
			cXml += 		xTafTag("nivelCta", AllTrim(T8A->T8A_NIVCTA))
			cXml += 		xTafTag("natCta", T8A->T8A_NATCTA)
			cXml += 		xTafTag("codNat", T8A->T8A_CODNAT)
			
			// codTrib e indTribISS: apenas para contas analiticas (indCta = "A")
			If T8A->T8A_INDCTA == "A"
				cXml += 	xTafTag("codTrib", AllTrim(T8A->T8A_CODTRI), , .T.) //Não obrigatório, vazio não gera com lHide := .T. 
				
				// indTribISS: NAO preencher se indCta = "S" (validacao XSD)
				cXml += 	xTafTag("indTribISS", T8A->T8A_INDTIS, , .T.) //Não obrigatório, vazio não gera com lHide := .T. 
			EndIf
			
			If !Empty(T8A->T8A_IDLEID) //Não obrigatório, vazio não gera.
				cXml +=		xTafTag("idLeiDisp", T8A->T8A_IDLEID)
			EndIf
			
			cXml += 		xTafTag("iniVig", self:GetFormattedDate(DtoS(T8A->T8A_INIVIG)))
			
			If !Empty(T8A->T8A_FIMVIG) //Não obrigatório, vazio não gera.
				cXml += 	xTafTag("fimVig", self:GetFormattedDate(DtoS(T8A->T8A_FIMVIG)))
			EndIf
			
			cXml +=     "</infoConta>"
			
			T8A->(DBSkip())

			cChaveT8A := T8A->T8A_FILIAL + T8A->T8A_ID + T8A->T8A_VERSAO
		EndDo

		cXml += 	"</infoContas>"
		cXml += "</infoPGCC>"
	EndIf

	//Complementa XML com cabeï¿½alho
	cXml := TAFXmlDeRE(cXml, '1011', T7Z->T7Z_EVENTO, T7Z->T7Z_MOTEXC, T7Z->T7Z_NRPROC)
	
Return cXML

/*-------------------------------------------------------------------------------
{Protheus.doc} GetStartEndDate()
Metodo responsável por retornar as datas de inicio e fim

@type method
@author Rafael de Paula Leme
@since 20/08/2026
@version 1.0
-------------------------------------------------------------------------------*/
method GetStartEndDate(cAlias as character, cID as character, cVersao as character, cVerAnt as character) as array class TAFDereXmlEvents

	Local oPrepare  := Nil            as object	
	Local aVersoes  := {}             as array
	Local aDatas    := {}             as array
	Local cQuery    := ""             as character
	Local cAliasQry := GetNextAlias() as character
	
	aadd(aVersoes, cVersao)
	aadd(aVersoes, cVerAnt)

	cQuery += "SELECT "
	cQuery += cAlias + "." + cAlias + "_DTINVA  DTINI, " 
	cQuery += cAlias + "." + cAlias + "_DTFIVA  DTFIN  "
	cQuery += "FROM "
	cQuery += RetSqlName(cAlias) + " " + cAlias 
	cQuery += "WHERE " 
	cQuery += cAlias + "." + cAlias + "_FILIAL = ? AND "
	cQuery += cAlias + "." + cAlias + "_ID = ? AND "
	cQuery += cAlias + "." + cAlias + "_VERSAO IN (?) AND "
	cQuery += cAlias + ".D_E_L_E_T_ = ? "
	cQuery += "ORDER BY "
	cQuery += cAlias + "." + cAlias + "_ATIVO"

	cQuery := ChangeQuery(cQuery) 

    oPrepare := FwExecStatement():New(cQuery)

	oPrepare:SetString(1, xFilial(cAlias))
	oPrepare:SetString(2, cID)
	oPrepare:SetIn(3, aVersoes)
	oPrepare:SetString(4, Space(1))

	oPrepare:OpenAlias(cAliasQry)

	While (cAliasQry)->(!EoF())
		Aadd(aDatas,{(cAliasQry)->DTINI, (cAliasQry)->DTFIN})
		(cAliasQry)->(DbSkip())
	EndDo

	(cAliasQry)->(DBCloseArea())

	If oPrepare != Nil
		oPrepare:Destroy()
		oPrepare := nil
	EndIf
	
Return aDatas

/*-------------------------------------------------------------------------------
{Protheus.doc} GetFormattedDate()
Metodo responsável por formatas as datas

@type method
@author Rafael de Paula Leme
@since 20/08/2026
@version 1.0
-------------------------------------------------------------------------------*/
method GetFormattedDate(cData as character) as character class TAFDereXmlEvents
	Local cDataForm := "" as character

	If !Empty(cData)
		cDataForm := SubStr(cData,1,4) + '-' + SubStr(cData,5,2) + '-' + SubStr(cData,7,2)
	EndIf

Return cDataForm

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFXmlDeRE
@type			function
@description	Função que retorna o XML com o cabeçalho para cada evento da DeRE
@author			Rafael de Paula Leme
@since			04/03/2026
@version		1.0
@param			cXMLLayout	-	XML específico do Layout
@param			cLayout		-	Layout sem o "D-" / Exemplo: D-1001 -> "1001"
@param			cTpOper		-	Tipo de operação / I = Inclusão A = Alteração E = Exclusão
@param			cMotExcl	-	Motivo da exclusao (1 digito) / opcional, usado quando cTpOper = E
@param			cNrProc		-	Numero do processo administrativo/judicial / opcional
@return			cXml 		- 	Estrutura final do XML
/*/
//---------------------------------------------------------------------
Function TAFXmlDeRE(cXMLLayout, cLayout, cTpOper, cMotExcl, cNrProc)

	Local aCGC       := FWSM0Util():GetSM0Data(cEmpAnt, cFilAnt, {"M0_CGC"})
	Local nTpOper    := 0
	Local cTpAmb	 := SuperGetMv("MV_TAFAMBD", .F., "2")
	Local cPathURL	 := "http://www.dere.gov.br/schemas/"
	Local cVerSchema := "v" + SuperGetMv("MV_TAFVLDE", .F., "1_0_1")
	Local cXml		 := ""
	Local cId        := ""
	Local cTpInscr	 := "1"
	Local cCGC		 := ""
	Local cNameSpace := ""
	Local cEvento    := ""
	Local cXmlInicio := ""
	Local cXmlFim    := ""

	Default cMotExcl := ""
	Default cNrProc  := ""

	cCGC := SubStr(AllTrim(aCGC[1][2]), 1, 8)

	Do Case
		Case cTpOper == 'I'
			nTpOper := 1
		Case cTpOper == 'A'
			nTpOper := 2
		Case cTpOper == 'E'
			nTpOper := 3
	EndCase
		
	cId := "DeRE" + cLayout + cTpInscr + PadL(AllTrim(Left(aCGC[1][2], 8)), 14, "0") + DToS(Date()) + StrTran(Time(), ":", "")
	
	cId	+= StrZero(Randomize(1, 99999), 5)

	//Nome do grupo do evento. Compoe tambem o namespace exigido pelo XSD:
	//D-1001 -> evtInfoContrib/v1_0_1  |  D-1011 -> evtPGCC/v1_0_1
	Do Case
		Case cLayout == "1001"
			cEvento := "evtInfoContrib"
		Case cLayout == "1011"
			cEvento := "evtPGCC"
			cVerSchema := 'v1_0_2'
	EndCase

	cNameSpace := cPathURL + cEvento + "/" + cVerSchema

	cXmlInicio := '<DeRE xmlns="' + cNameSpace + '">'

	//O XSD define "id" como atributo obrigatorio do grupo do evento, nao como elemento
	cXmlInicio += '<' + cEvento + xTafTag("id", cId, , , , , .T.) + '>'
	
	cXmlInicio += '<ideEvento>'
	cXmlInicio += 	xTafTag("tpOper", nTpOper)
	If nTpOper == 3
		//motExcl tem 1 digito no XSD (o valor '01' violava o pattern). Ambos os
		//grupos sao opcionais, portanto so sao gerados quando informados
		If !Empty(cMotExcl)
			cXmlInicio += 	xTafTag("motExcl", cMotExcl)
		EndIf
		If !Empty(cNrProc)
			cXmlInicio += 	xTafTag("nrProc", cNrProc)
		EndIf
	EndIf
	cXmlInicio += 	xTafTag("tpAmb" , cTpAmb)
	cXmlInicio += 	xTafTag("aplicEmi", 1)
    cXmlInicio += 	xTafTag("verAplic", '1.0.0')
	cXmlInicio += '</ideEvento>'
	cXmlInicio += '<ideContrib>'
	cXmlInicio += 	xTafTag("nrInsc", cCGC)
	cXmlInicio += '</ideContrib>'

	//O grupo do evento e fechado no proprio cXml. Antes o fechamento era
	//concatenado em cXmlInicio, que ja havia sido consumido, e o XML saia mal formado
	cXmlFim := '</' + cEvento + '>'

	cXml := cXmlInicio + cXMLLayout + cXmlFim + '</DeRE>'

Return(cXml)

/*-------------------------------------------------------------------------------
{Protheus.doc} TAFXmlIdDe()
Retorna o ID do Xml.

@type function
@author Rafael de Paula Leme
@since 26/08/2026
@version 1.0
-------------------------------------------------------------------------------*/
Function TAFXmlIdDe(cXml)
	Local cId   := "" as character
	Local nDe   := 0  as numeric
	
	nDe := At('id=', cXml)
	
	If nDe > 0
		nDe := nDe + 4
		cId := SubStr(cXml, nDe, 42)
	EndIf

return cId
