#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "totvs.ch"
#include "backoffice.taf.dere.status.ch"

namespace backoffice.taf.dere.status

#DEFINE CONTENT_TYPE        "application/json"
#DEFINE HEADER_CONTENT_TYPE "Content-Type"
#DEFINE STATUS_CODE_SUCCESS 200
#DEFINE STATUS_CODE_FAIL    500

#DEFINE DERE_STATUS_PREVALID     "0"
#DEFINE DERE_STATUS_WAITING      "1"
#DEFINE DERE_STATUS_REJECTED_TSS "2"
#DEFINE DERE_STATUS_REJECTED     "3"
#DEFINE DERE_STATUS_VALIDATED    "4"
#DEFINE DERE_RECORD_ACTIVE       "1"

#DEFINE DERE_EVENT_CODE  1
#DEFINE DERE_EVENT_ALIAS 4

/*/{Protheus.doc} TAFDereStatusCount
Função que retorna o totalizador de status dos eventos da DeRE.

@endpoint  /api/taf/dere/status/count
@method    GET
@type      function
@author    Rafael de Paula Leme
@since     11/03/2026
@version   1.0
@return    Nil, a resposta é devolvida ao cliente pelo objeto oRest.
           Sucesso (200): propriedade "events" com um objeto por evento composto por
           "event" (código do evento) e os totalizadores "pending", "waiting",
           "rejected" e "validated".
           Falha de dicionário ou de consulta (500): propriedade "message" com o motivo.
/*/
@GET(endpoint="/api/taf/dere/status/count", description="Totalizador dos status dos eventos")
Function TAFDereStatusCount()
    Local jResponse := JsonObject():New()  as json
    Local lSuccess  := .T.                 as logical
    Local cMessage  := ""                  as character
    Local nStatus   := STATUS_CODE_SUCCESS as numeric

    If !TAFAlsInDic("T7T") .or. !TAFAlsInDic("T7Z")
        cMessage := STR0002 //"Dicionário de dados desatualizado. Verifique."
        nStatus  := STATUS_CODE_FAIL
        lSuccess := .F.
    Else
        StatusCount(jResponse)
    EndIf

    oRest:SetKeyHeaderResponse(HEADER_CONTENT_TYPE, CONTENT_TYPE)
    oRest:SetStatusCode(nStatus)

    If !Empty(cMessage)
        jResponse['message'] := cMessage
        jResponse['success'] := lSuccess
    EndIf

    oRest:SetResponse(jResponse)

Return Nil

/*/{Protheus.doc} StatusCount
Totalizador dos status dos eventos da DeRE.

Percorre o registro único de eventos suportados (TAFDereEvents) e delega a contagem de
cada evento, resolvendo a tabela pela própria coluna de alias do registro. Dessa forma
um evento novo passa a ser totalizado apenas com o acréscimo da sua linha em
TAFDereEvents, sem alteração neste fonte.

A resposta só é montada quando todos os eventos foram totalizados com sucesso, para não
devolver ao cliente um painel parcialmente preenchido que seria interpretado como
contagem real.

@type      static function
@author    Rafael de Paula Leme
@since     11/03/2026
@version   1.0
@param     jResponse, json   , objeto de resposta que recebe a propriedade "events"
@param     nStatus  , numeric, recebido por referência, retorna o status HTTP da operação
@return    character, vazio em caso de sucesso ou a mensagem do motivo da falha
/*/
Static Function StatusCount(jResponse as json)
    Local aEventos := {} as array
    Local aEvents  := {} as array
    Local nX       := 0  as numeric

    jResponse["events"] := {}

    aEventos := backoffice.taf.dere.events.TAFDereEvents()

    For nX := 1 To Len(aEventos)
        EventStatusCount(aEvents, aEventos[nX][DERE_EVENT_CODE],;
                         aEventos[nX][DERE_EVENT_ALIAS])
    Next nX

    jResponse["events"] := aEvents

Return Nil

/*/{Protheus.doc} EventStatusCount
Totalizador de status de um evento da DeRE.

Atende qualquer evento da DeRE, resolvendo os campos pelo alias da tabela recebida.

Agrupamento dos totalizadores por conteudo do campo de status:
pending   - status em branco e "2"
waiting   - status "1" e "0"
rejected  - status "2" e "3"
validated - status "4"

O status "2" pertence a dois grupos por definicao da regra de negocio: o mesmo registro
e contado em "pending" e em "rejected". Portanto a soma dos quatro totalizadores e
maior que a quantidade de registros do evento, e isso nao e erro de contagem.

O filtro considera apenas os registros ativos (DERE_RECORD_ACTIVE), mantendo o mesmo
critério aplicado pelo endpoint de detalhe (/api/taf/dere/events/eventDetail). Alterar
este filtro sem alterar o detalhe faria o total exibido divergir da lista aberta pelo
usuário ao clicar no totalizador.

A contagem usa COUNT(*) e não COUNT do campo de status, porque a função de agregação
sobre a coluna desconsidera conteúdo nulo e subnotificaria o grupo dos registros
pendentes de envio.

@type      static function
@author    Rafael de Paula Leme
@since     11/03/2026
@version   1.0
@param     aEvents, array    , recebido por referência, recebe o objeto totalizador do evento
@param     cEvento, character, código do evento (ex.: "D-1001")
@param     cAlias , character, alias da tabela que armazena os registros do evento (ex.: "T7T")
@param     nStatus, numeric  , recebido por referência, retorna o status HTTP da operação
@return    character, vazio em caso de sucesso ou a mensagem do motivo da falha
/*/
Static Function EventStatusCount(aEvents as array, cEvento as character, cAlias as character)
    Local oPrepare   := Nil            as object
    Local jItem      := Nil            as json
    Local nQtde      := 0              as numeric
    Local nPending   := 0              as numeric
    Local nWaiting   := 0              as numeric
    Local nRejected  := 0              as numeric
    Local nValidated := 0              as numeric
    Local cQuery     := ""             as character
    Local cAliasQry  := GetNextAlias() as character
    Local cIdStatus  := ""             as character

    cQuery += "SELECT " + cAlias + "_STATUS, COUNT(*) QTDE "
    cQuery += "FROM " + RetSqlName(cAlias) + " "
    cQuery += "WHERE " + cAlias + "_FILIAL = ? AND "
    cQuery += cAlias + "_ATIVO = ? AND "
    cQuery += "D_E_L_E_T_ = ? "
    cQuery += "GROUP BY " + cAlias + "_STATUS "

    cQuery := ChangeQuery(cQuery)

    oPrepare := FwExecStatement():New(cQuery)

    oPrepare:SetString(1, xFilial(cAlias))
    oPrepare:SetString(2, DERE_RECORD_ACTIVE)
    oPrepare:SetString(3, Space(1))

    oPrepare:OpenAlias(cAliasQry)

    While !(cAliasQry)->(EoF())
        cIdStatus := (cAliasQry)->&(cAlias + "_STATUS")
        nQtde     := (cAliasQry)->QTDE

        //As condicoes sao independentes, e nao um Do Case, porque um mesmo conteudo de
        //status alimenta mais de um totalizador: o Do Case encerraria a avaliacao na
        //primeira ocorrencia verdadeira e o segundo grupo nunca seria somado.
        If Empty(cIdStatus) .Or. cIdStatus == DERE_STATUS_REJECTED_TSS
            nPending   += nQtde
        EndIf

        If cIdStatus == DERE_STATUS_WAITING .Or. cIdStatus == DERE_STATUS_PREVALID
            nWaiting   += nQtde
        EndIf

        If cIdStatus == DERE_STATUS_REJECTED_TSS .Or. cIdStatus == DERE_STATUS_REJECTED
            nRejected  += nQtde
        EndIf

        If cIdStatus == DERE_STATUS_VALIDATED
            nValidated += nQtde
        EndIf

        (cAliasQry)->(DBSkip())
    EndDo

    (cAliasQry)->(DBCloseArea())

    jItem := JsonObject():New()

    jItem["event"]     := cEvento
    jItem["pending"]   := nPending
    jItem["waiting"]   := nWaiting
    jItem["rejected"]  := nRejected
    jItem["validated"] := nValidated

    Aadd(aEvents, jItem)

    If oPrepare != Nil
        oPrepare:Destroy()
        oPrepare := Nil
    EndIf

Return Nil
