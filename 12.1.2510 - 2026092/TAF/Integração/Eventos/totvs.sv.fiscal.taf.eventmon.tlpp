#include "msobject.ch"
#include "totvs.framework.treports.integratedprovider.th"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "totvs.sv.fiscal.taf.eventmon.ch"

namespace totvs.protheus.fiscal.taf.treportsintegratedprovider
@totvsFrameworkTReportsIntegratedProvider(active=.T.,team="SIGATAF", tables="T7A, T7B, T7C, T7D, T7E, C20, C1H, C1J", name="TafEventMonitoringSmartViewBusinessObject", country="BRA", initialRelease="12.1.2410")

//-------------------------------------------------------------------
/*{Protheus.doc}  TafEventMonitoringSmartViewBusinessObject
Classe para criação do Objeto de acompanhamento do Eventos transmitidos da reforma tributária
@author Evandro Peixoto
@since 21/12/2025
*/
//-------------------------------------------------------------------  
class TafEventMonitoringSmartViewBusinessObject from totvs.framework.treports.integratedprovider.IntegratedProvider

	public method new() as object
	public method getData() as object
	public method getSchema() as object

endclass

//-------------------------------------------------------------------
/*{Protheus.doc} new
Método de instância da classe 
@return object: self 
@author Evandro Peixoto
@since 21/12/2025
*/
//-------------------------------------------------------------------   
method new() as object class TafEventMonitoringSmartViewBusinessObject

	_Super:new()

	//Define a Área
	self:appendArea(STR0001) //"TAF Fiscal"

	//Define o nome do Objeto de Negócio
	self:setDisplayName(STR0002) //"Acompanhamento do Eventos transmitidos da reforma tributária"

	//Define a descrição do Objeto de Negócio
	self:setDescription(STR0003) //"Objeto de Negocio para acompanhamento do Eventos transmitidos da reforma tributária"

return self

//-------------------------------------------------------------------
/*{Protheus.doc} getData
Retorna os dados do objeto de negócio 
@param nPage, numérico, indica a página atual do relatório
@param oFilter, objeto, contém o filtro do TReports 
@return object: self:oData 
@author Evandro Peixoto
@since 21/12/2025
@version 2.0 - Ajuste do nParam e ajuste na query para obter melhor desempenho, adicionado coluna de tributo.
*/
//-------------------------------------------------------------------   
method getData(nPage as numeric, oFilter as object) as object class TafEventMonitoringSmartViewBusinessObject

	Local cQuery              as Character
	Local oPrepare     := nil as object	
	Local jParams             as Json
	Local nParam       := 1   as Numeric

	//Define a quantidade máxima por página (Default 100)
	self:setPageSize(200)

	jParams	:= oFilter:getParameters()

	cQuery += " SELECT	T7A.T7A_FILIAL,  "
	cQuery += " T7A.T7A_TPEVEN, "
	cQuery += " C20.C20_CHVELE, "
	cQuery += " T7E.T7E_DESCRI, "
	cQuery += " T7A.T7A_PROT, "
	cQuery += " T7A.T7A_DTEMIS, "
	cQuery += " C09.C09_UF, "
	cQuery += " C20.C20_NUMDOC, "
	cQuery += " C20.C20_SERIE, "
	cQuery += " C20.C20_ESPECI, "
	cQuery += " C1H.C1H_NOME,
	cQuery += " COALESCE(NULLIF(LTRIM(RTRIM(C1H.C1H_CPF)), ''),C1H.C1H_CNPJ) CGC, "
	cQuery += " CASE "
	cQuery += " 	WHEN T7A.T7A_STATUS = '1' THEN 'Solicitado' "
	cQuery += " 	WHEN T7A.T7A_STATUS = '2' THEN 'Enviado' "
	cQuery += " 	WHEN T7A.T7A_STATUS = '3' THEN 'Sol. Cancelamento' "
	cQuery += " 	WHEN T7A.T7A_STATUS = '4' THEN 'Cancelado' "
	cQuery += " 	WHEN T7A.T7A_STATUS = '5' THEN 'Falha de envio' "
	cQuery += " END EVENTO_STATUS,  "
	cQuery += " T7C.T7C_ITEM, "
	cQuery += " T7C.T7C_QUANT, "
	cQuery += " C1J.C1J_CODIGO, "
	cQuery += " T7C.T7C_VALOR, "
	cQuery += " T7B.T7B_ITEM, "
	cQuery += " T7B.T7B_VLBASE, "
	cQuery += " T7B.T7B_PERC, "
	cQuery += " T7B.T7B_VALOR, "
	cQuery += " T7D.T7D_DATA, "
	cQuery += " C3S.C3S_DESCRI  TRIBUTO_DESCRICAO "
	cQuery += " FROM " + RetSQLName('T7A') +  " T7A "
	cQuery += " INNER JOIN " + RetSQLName('T7E') +  " T7E ON T7E.T7E_EVENTO = T7A.T7A_TPEVEN AND T7A.D_E_L_E_T_ = ? "
	cQuery += " INNER JOIN " + RetSQLName('C20') +  " C20 ON " + FwJoinFilial('C20', 'T7A') + " AND C20.C20_CHVELE = T7A.T7A_CHVELE AND C20.C20_CHVNF = T7A.T7A_CHVNF AND C20.D_E_L_E_T_ = ? "
	cQuery += " INNER JOIN " + RetSQLName('C1H') +  " C1H ON " + FwJoinFilial('C1H', 'T7A') + "  AND C1H.C1H_ID = T7A.T7A_CODPAR AND C1H.D_E_L_E_T_ = ? "
	cQuery += " LEFT JOIN  " + RetSQLName('C09') +  " C09 ON  C09.C09_ID = T7A.T7A_EST AND C09.D_E_L_E_T_ = ? "
	cQuery += " LEFT JOIN  " + RetSQLName('T7C') +  " T7C ON " + FwJoinFilial('T7C', 'T7A') + "  AND T7C.T7C_IDENT = T7A.T7A_IDENT AND T7C.D_E_L_E_T_ = ? "
	cQuery += " LEFT JOIN  " + RetSQLName('T7B') +  " T7B ON " + FwJoinFilial('T7B', 'T7A') + "  AND T7B.T7B_IDENT = T7A.T7A_IDENT AND T7B.D_E_L_E_T_ = ? "
	cQuery += " LEFT JOIN  " + RetSQLName('C1J') +  " C1J ON " + FwJoinFilial('C1J', 'T7C') + "  AND C1J.C1J_ID = T7C.T7C_UM AND C1J.D_E_L_E_T_ = ? "
	cQuery += " LEFT JOIN  " + RetSQLName('C3S') +  " C3S ON C3S.C3S_ID = COALESCE(T7B.T7B_CODTRI, T7C.T7C_CODTRI) AND C3S.D_E_L_E_T_ = ? "
	cQuery += " LEFT JOIN ( SELECT T7D_FILIAL, T7D_IDENT, MAX(R_E_C_N_O_) AS T7D_RECNO "
    cQuery += "     FROM " + RetSqlName("T7D")
    cQuery += "     WHERE D_E_L_E_T_ = ? "
    cQuery += "     GROUP BY T7D_FILIAL, T7D_IDENT "
    cQuery += " ) T7D_LAST ON "
    cQuery += FwJoinFilial("T7A","T7D_LAST")
    cQuery += " AND T7A.T7A_IDENT = T7D_LAST.T7D_IDENT "
    cQuery += " LEFT JOIN " + RetSqlName("T7D") + " T7D ON T7D.R_E_C_N_O_ = T7D_LAST.T7D_RECNO "

	cQuery += " WHERE T7A.D_E_L_E_T_ = ? "

	//Adiciona filtro de data de emissão (Opcional)
	If !Empty(jParams["01"][1]) .And. !Empty(jParams["02"][1])
		cQuery += " AND T7A.T7A_DTEMIS BETWEEN ? AND ? "
	EndIf
	//Adiciona filtro de Nota Fiscal (Opcional)
	If !Empty(jParams["03"][1])
		cQuery += " AND T7A.T7A_NUMDOC = ? "
	EndIf
	//Adiciona filtro de Série (Opcional)
	If !Empty(jParams["04"][1])
		cQuery += " AND T7A.T7A_SERIE = ? "
	EndIf
	//Adiciona filtro de Espécie (Opcional)
	If !Empty(jParams["05"][1])
		cQuery += " AND T7A.T7A_ESPECI = ? "
	EndIf
	//Adiciona filtro de Evento (Opcional)
	If !Empty(jParams["06"][1])
		cQuery += " AND T7A.T7A_TPEVEN = ? "
	EndIf
	//Adiciona filtro de Status do Evento (Opcional)
	If !Empty(jParams["07"][1]) .AND. ALLTRIM(jParams["07"][1]) <> "6" // 6 = Todos
		cQuery += " AND T7A.T7A_STATUS = ? "
	EndIf

	self:setOrder("T7A.T7A_TPEVEN, T7A.T7A_DTEMIS")

	cQuery := ChangeQuery( cQuery )

	oPrepare := FWPreparedStatement():New(cQuery)

	//Define os parâmetros da query do 01 - 10 (D_E_L_E_T_)
	oPrepare:SetString( nParam++ , Space(01)  )
	oPrepare:SetString( nParam++ , Space(01)  )
	oPrepare:SetString( nParam++ , Space(01)  )
	oPrepare:SetString( nParam++ , Space(01)  )
	oPrepare:SetString( nParam++ , Space(01)  )
	oPrepare:SetString( nParam++ , Space(01)  )
	oPrepare:SetString( nParam++ , Space(01)  )
	oPrepare:SetString( nParam++ , Space(01)  )
	oPrepare:SetString( nParam++ , Space(01)  )
	oPrepare:SetString( nParam++ , Space(01)  )
	// Define os parâmetros adicionais conforme filtros informados
	// Data (opcional)
	If !Empty(jParams["01"][1]) .And. !Empty(jParams["02"][1])
		oPrepare:SetString(nParam++, StrTran(SubStr(jParams["01"][1], 1, 10), "-"))
		oPrepare:SetString(nParam++, StrTran(SubStr(jParams["02"][1], 1, 10), "-"))
	EndIf
	// Nota Fiscal (opcional)
	If !Empty(jParams["03"][1])
		oPrepare:SetString(nParam++, jParams["03"][1])
	EndIf
	// Série (opcional)
	If !Empty(jParams["04"][1])
		oPrepare:SetString(nParam++, jParams["04"][1])
	EndIf
	// Espécie (opcional)
	If !Empty(jParams["05"][1])
		oPrepare:SetString(nParam++, jParams["05"][1])
	EndIf
	// Evento (opcional)
	If !Empty(jParams["06"][1])
		oPrepare:SetString(nParam++, jParams["06"][1])
	EndIf
	// Status do Evento (opcional)
	If !Empty(jParams["07"][1]) .AND. ALLTRIM(jParams["07"][1]) <> "6" // 6 = Todos
		oPrepare:SetString(nParam++, ALLTRIM(jParams["07"][1]))
	EndIf

	cQuery := oPrepare:GetFixQuery()

	self:setQuery(cQuery)

	freeObj(oPrepare)

return self:oData


//-------------------------------------------------------------------
/*{Protheus.doc} getSchema
Retorna a estrutura dos campos 
@return object: self:oSchema 
@author Evandro Peixoto
@since 21/12/2025
*/
//-------------------------------------------------------------------   
method getSchema() as object class TafEventMonitoringSmartViewBusinessObject

//                  (Nome               ,  Descricao ,Tipo    , Display , cRealName          )
	self:addProperty("T7A_FILIAL "       , STR0004 , "string" , STR0004 , "T7A_FILIAL "      ) // "Filial"
	self:addProperty("T7A_TPEVEN "       , STR0005 , "string" , STR0005 , "T7A_TPEVEN "      ) // "Cod. Evento"
	self:addProperty("T7E_DESCRI  "      , STR0006 , "string" , STR0006 , "T7E_DESCRI  "     ) // "Descrição do Evento"
	self:addProperty("T7A_DTEMIS "       , STR0007 , "date"   , STR0007 , "T7A_DTEMIS "      ) // "Data do Evento"
	self:addProperty("C20_NUMDOC "       , STR0008 , "string" , STR0008 , "C20_NUMDOC "      ) // "Nota fiscal"
	self:addProperty("C20_SERIE   "      , STR0009 , "string" , STR0009 , "C20_SERIE   "     ) // "Serie da nota"
	self:addProperty("C20_ESPECI  "      , STR0010 , "string" , STR0010 , "C20_ESPECI  "     ) // "Espécie da nota"
	self:addProperty("C1H_NOME  "        , STR0011 , "string" , STR0011 , "C1H_NOME  "       ) // "Nome do participante"
	self:addProperty("CGC   "            , STR0012 , "string" , STR0012 , "CGC   "           ) // "CGC do Participante"
	self:addProperty("EVENTO_STATUS   "  , STR0013 , "string" , STR0013 , "EVENTO_STATUS   " ) // "Status do Evento"
	self:addProperty("T7C_ITEM  "        , STR0014 , "string" , STR0014 , "T7C_ITEM  "       ) // "Item do Evento"
	self:addProperty("T7C_QUANT  "       , STR0015 , "string" , STR0015 , "T7C_QUANT  "      ) // "Quantidade do item doEvento"
	self:addProperty("C1J_CODIGO   "     , STR0016 , "string" , STR0016 , "C1J_CODIGO   "    ) // "Unidade de Medida do item do Evento"
	self:addProperty("T7C_VALOR   "      , STR0017 , "string" , STR0017 , "T7C_VALOR   "     ) // "Valor do item do Evento"
	self:addProperty("C20_CHVELE   "     , STR0018 , "string" , STR0018 , "C20_CHVELE   "    ) // "Chave Eletrônica"
	self:addProperty("T7A_PROT   "       , STR0019 , "string" , STR0019 , "T7A_PROT   "      ) // "Protocolo de envio do Evento"
	self:addProperty("C09_UF   "         , STR0020 , "string" , STR0020 , "C09_UF"           ) // "UF"
	self:addProperty("T7B_ITEM   "       , STR0021 , "string" , STR0021 , "T7B_ITEM"         ) // "Item Crédito presumido"
	self:addProperty("T7B_VLBASE   "     , STR0022 , "string" , STR0022 , "T7B_VLBASE"       ) // "Valor Base de crédito presumido"
	self:addProperty("T7B_PERC   "       , STR0023 , "string" , STR0023 , "T7B_PERC"         ) // "Percentual de crédito presumido"
	self:addProperty("T7B_VALOR   "      , STR0024 , "string" , STR0024 , "T7B_VALOR"        ) // "Valor crédito presumido"
	self:addProperty("TRIBUTO_DESCRICAO" , STR0032 , "string" , STR0032 , "TRIBUTO_DESCRICAO") // "Descrição do Tributo"
	self:addProperty("T7D_DATA"          , STR0033 , "date"   , STR0033 , "T7D_DATA"         ) // "Data Retorno SEFAZ"

	//Criando Parametros do Objeto de Negócio (Dessa forma não é necessário criar SX1)
	self:addParameter("01", STR0025, "date",   .F., "", .F., .F., "", "MV_PAR01") //"Data de  :"
	self:addParameter("02", STR0026, "date",   .F., "", .F., .F., "", "MV_PAR02") //"Data até :"
	self:addParameter("03", STR0027, "string", .F., "", .F., .F., "", "MV_PAR03") //"Nota     :"
	self:addParameter("04", STR0028, "string", .F., "", .F., .F., "", "MV_PAR04") //"Série    :"
	self:addParameter("05", STR0029, "string", .F., "", .F., .F., "", "MV_PAR05") //"Espécie  :"
	self:addParameter("06", STR0030, "string", .F., "", .F., .F., "", "MV_PAR06") //"Evento   :"
	self:addParameter("07", STR0031, "string", .F., "", .F., .F., "", "MV_PAR07") //"Status   :"

	//Define os valores possíveis para o parâmetro Status (COMBO) - totvs.protheus.fiscal.taf.sv.eventstats.tlpp
	self:setCustomURL("07","/api/taf/fiscal/v1/eventstats",  1)

return self:oSchema
