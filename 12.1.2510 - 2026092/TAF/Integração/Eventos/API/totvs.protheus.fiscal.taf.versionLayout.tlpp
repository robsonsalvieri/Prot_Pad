#include 'tlpp-core.th'
#include 'tlpp-rest.th'
#include 'totvs.ch'
#include 'totvs.protheus.fiscal.taf.versionLayout.ch'

namespace totvs.protheus.fiscal.taf.event

/*/{Protheus.doc} TAFVersionLayoutMonit
Controller REST responsavel pela versao de layout utilizada na
geracao dos eventos do TAF. O valor e unico por grupo de empresa,
gravado no perfil Protheus (MP_SYSTEM_PROFILE) sob a identificacao
TAFA635LAY, seguindo o mesmo padrao adotado em
FISA318F7OnboardProfile (identificador FISA318).

@author    Pâmela Bernardo
@since     06/07/2026
@version   1.0
/*/
Class TAFVersionLayoutMonit

	public Method New() Constructor
	public Method loadVersionLayout() As Character

	@Get('/api/taf/fiscal/v1/versionLayout')
	public Method getVersionLayout() As Logical

	@Post('/api/taf/fiscal/v1/versionLayout')
	public Method postVersionLayout() As Logical

	private Method getNewVersionLayout() As Character
	private Method loadProfileContent() As Character
	private Method saveVersionLayout() As Logical
	private Method saveVersionLayoutLog() As Logical
	private Method buildProfile() As Object
	private Method getProgramId() As Character
	private Method buildListResponse() As Json
	private Method buildStatusResponse() As Json

EndClass

//----------------------------------------------------------------
/*/{Protheus.doc} TAFVersionLayoutMonit:New
Metodo construtor.

@type      method
@author    Pâmela Bernardo
@since     06/07/2026
@version   1.0
@return    Self  Object  Instancia corrente da classe
/*/
//----------------------------------------------------------------
Method New() Class TAFVersionLayoutMonit
Return Self

//----------------------------------------------------------------
/*/{Protheus.doc} TAFVersionLayoutMonit:getVersionLayout
Endpoint REST GET /api/taf/fiscal/v1/versionLayout.
Retorna a versao de layout gravada no perfil Protheus
(MP_SYSTEM_PROFILE) para o grupo de empresa corrente.

Resposta (200):
{
    "items": [
        { "versionLayout": "1.0" }
    ],
    "hasNext": false
}

@type      method
@author    Pâmela Bernardo
@since     06/07/2026
@version   1.0
@return    lOk  Logical  Retorna o resultado do envio da resposta REST
/*/
//----------------------------------------------------------------
Method getVersionLayout() As Logical Class TAFVersionLayoutMonit

	Local cVersion As Character
	Local cMessage As Character
	Local cDetailedMessage As Character
	Local jResp    As Json
	Local lOk      As Logical
	Local lExisteT7J := TAFAlsInDic("T7J")	   As Logical

	jResp := JsonObject():New()		

	oRest:setKeyHeaderResponse('Content-Type', 'application/json')

	If lExisteT7J
		cVersion := Self:loadVersionLayout()
		If !Empty(cVersion)
			jResp    := Self:buildListResponse(cVersion)
		EndIf	
		lOk   := oRest:setStatusResponse(200, jResp:ToJson())
	Else
		cMessage := STR0001 //"Seu dicionário de dados está desatualizado. Para garantir o uso de todos os recursos da rotina. " 
		cDetailedMessage := STR0002 //"atualize-o para a versão mais recente disponível na nossa documentação."
		jResp := Self:buildStatusResponse(400, cMessage, cDetailedMessage )
		lOk   := oRest:setStatusResponse(400, jResp:ToJson())
	Endif

	FwFreeObj(jResp)

Return lOk

//----------------------------------------------------------------
/*/{Protheus.doc} TAFVersionLayoutMonit:postVersionLayout
Endpoint REST POST /api/taf/fiscal/v1/versionLayout.
Solicita a atualizacao da versao de layout salva no perfil
Protheus (MP_SYSTEM_PROFILE), unica por grupo de empresa.

Corpo esperado:
{
    "VersionLayout": "1.0"
}

Respostas:
200 - Atualizacao realizada com sucesso.
400 - Falha na atualizacao (corpo invalido, parametro ausente ou tipo incorreto).

@type      method
@author    Pâmela Bernardo
@since     06/07/2026
@version   1.0
@return    lOk  Logical  Retorna o resultado do envio da resposta REST
/*/
//----------------------------------------------------------------
Method postVersionLayout() As Logical Class TAFVersionLayoutMonit

	Local cBody          As Character
	Local jBody          As JSON
	Local jResp          As Json
	Local cNewVersion    As Character
	Local cOldVersion    As Character
	Local cBeforeContent As Character
	Local cMessage As Character
	Local cDetailedMessage As Character
	Local lOk := .T.     As Logical
	Local lExisteT7J := TAFAlsInDic("T7J")	   As Logical

	oRest:setKeyHeaderResponse('Content-Type', 'application/json')

	cBody := oRest:getBodyRequest()
	jBody := JsonObject():New()

	
	If lExisteT7J
		If Empty(cBody) .Or. jBody:FromJson(cBody)<> Nil
			lOk :=.F.
			cDetailedMessage := STR0003 //" Body da requisição Vazio "
		EndIf
		If lOk
			cNewVersion := Self:getNewVersionLayout(jBody)
			lOk   := !Empty(cNewVersion)
			If !lOk
				cDetailedMessage := STR0004 //" Tag versionLayout não enviada  "
			Endif
		EndIf

		If lOk
			cOldVersion := Self:loadVersionLayout()
			cBeforeContent :=  STR0005 + cOldVersion //"Versão do Layout:"
			lOk:= Self:saveVersionLayout(cNewVersion, cBeforeContent, Empty(cOldVersion))
		EndIf

		If lOk
			jResp := Self:buildStatusResponse(201, STR0006) //'Sucesso no processo de atualização.'
			lOk   := oRest:setStatusResponse(201, jResp:ToJson())
		Else
			cMessage := STR0007 //'Dados informados inconsistente. Validar os valores enviados.'
			jResp := Self:buildStatusResponse(400, cMessage, cDetailedMessage )
			lOk   := oRest:setStatusResponse(400, jResp:ToJson())
		EndIf
	Else
		cMessage := STR0001 //"Seu dicionário de dados está desatualizado. Para garantir o uso de todos os recursos da rotina. " 
		cDetailedMessage := STR0002 //"atualize-o para a versão mais recente disponível na nossa documentação."
		jResp := Self:buildStatusResponse(400, cMessage, cDetailedMessage )
		lOk   := oRest:setStatusResponse(400, jResp:ToJson())
	EndIf 	
	FwFreeObj(jBody)
	FwFreeObj(jResp)

Return lOk

//----------------------------------------------------------------
/*/{Protheus.doc} TAFVersionLayoutMonit:getNewVersionLayout
Extrai e valida a propriedade "versionLayout" do corpo da
requisicao. So retorna valor quando a propriedade existe e e do
tipo Character (string), conforme contrato do endpoint.

@type      method
@author    Pâmela Bernardo
@since     06/07/2026
@version   1.0
@param     jBody        Object     JsonObject com o corpo da requisicao
@return    cNewVersion  Character  Nova versao de layout valida, ou vazio quando invalida/ausente
/*/
//----------------------------------------------------------------
Method getNewVersionLayout(jBody As JSON) As Character Class TAFVersionLayoutMonit

	Local cNewVersion:= "" As Character

	If jBody <> Nil .And. jBody:HasProperty('versionLayout') .And. ValType(jBody['versionLayout']) == 'C'
		cNewVersion := AllTrim(jBody['versionLayout'])
	EndIf

Return cNewVersion

//----------------------------------------------------------------
/*/{Protheus.doc} TAFVersionLayoutMonit:loadVersionLayout
Le a versao de layout gravada no perfil Protheus
(MP_SYSTEM_PROFILE) para o grupo de empresa corrente. Retorna
vazio quando ainda nao existe registro salvo.

@type      method
@author    Pâmela Bernardo
@since     06/07/2026
@version   1.0
@return    cVersion  Character  Versao de layout gravada, ou vazio quando nao existe

@see https://tdn.totvs.com/display/public/framework/FWProfile
/*/
//----------------------------------------------------------------
Method loadVersionLayout() As Character Class TAFVersionLayoutMonit

	Local cVersion  As Character
	Local cContent  As Character
	Local oJsonProf As Object

	cVersion := ''
	cContent := Self:loadProfileContent()

	If !Empty(cContent)
		oJsonProf := JsonObject():New()
		oJsonProf:FromJson(cContent)

		If oJsonProf:HasProperty('versionLayout')
			cVersion := AllTrim(cValToChar(oJsonProf['versionLayout']))
		EndIf

		FwFreeObj(oJsonProf)
	EndIf

Return cVersion

//----------------------------------------------------------------
/*/{Protheus.doc} TAFVersionLayoutMonit:loadProfileContent
Le o conteudo bruto (JSON serializado) gravado no perfil
Protheus (MP_SYSTEM_PROFILE) sob a identificacao TAFA635LAY.
Retorna vazio quando ainda nao existe registro salvo. Utilizado
para obter o conteudo "antes" da alteracao para fins de log
(T7J_BEFORE).

@type      method
@author    Pâmela Bernardo
@since     06/07/2026
@version   1.0
@return    cContent  Character  Conteudo bruto gravado no perfil, ou vazio quando nao existe

@see https://tdn.totvs.com/display/public/framework/FWProfile
/*/
//----------------------------------------------------------------
Method loadProfileContent() As Character Class TAFVersionLayoutMonit

	Local cContent As Character
	Local oProfile As Object

	oProfile := Self:buildProfile()

	oProfile:loadStrProfile(.T.)
	cContent := oProfile:getStringProfile()

	oProfile:Destroy()

Return cContent

//----------------------------------------------------------------
/*/{Protheus.doc} TAFVersionLayoutMonit:saveVersionLayout
Grava a nova versao de layout no perfil Protheus
(MP_SYSTEM_PROFILE), unica por grupo de empresa: filial em branco
e usuario fixo "000000", para que o valor nao varie conforme o
usuario ou filial que efetuou a chamada.

@type      method
@author    Pâmela Bernardo
@since     06/07/2026
@version   1.0
@param     cNewVersion     Character  Nova versao de layout a ser gravada
@param     cBeforeContent  Character  Conteudo do perfil antes da alteracao (vazio na inclusao), usado para o log em T7J
@param     lInclusion  Logical  Define se é inclusão na tabela T7J
@return    lOk             Logical    Indica se a gravacao foi realizada com sucesso

@see https://tdn.totvs.com/display/public/framework/FWProfile
/*/
//----------------------------------------------------------------
Method saveVersionLayout(cNewVersion As Character, cBeforeContent As Character, lInclusion As Logical) As Logical Class TAFVersionLayoutMonit

	Local lOk         As Logical
	Local oProfile    As Object
	Local oJsonProf   As Object
	Local cAfterCont  As Character

	Default cNewVersion    := ''
	Default cBeforeContent := ''
	Default lInclusion	   := .T.

	lOk := .F.

	If !Empty(cNewVersion)
		oProfile := Self:buildProfile()

		oJsonProf := JsonObject():New()
		oJsonProf['versionLayout'] := cNewVersion
		oJsonProf['updateDate']    := DateTimeUTC()

		cAfterCont := STR0005 + cNewVersion //"Versão do Layout:"

		oProfile:setStringProfile(oJsonProf:ToJson())
		lOk := oProfile:save(.T.)

		If lOk
			lOk := Self:saveVersionLayoutLog(cBeforeContent, cAfterCont,lInclusion)
		EndIf

		FwFreeObj(oJsonProf)
		oProfile:Destroy()
	EndIf

Return lOk

//----------------------------------------------------------------
/*/{Protheus.doc} TAFVersionLayoutMonit:saveVersionLayoutLog
Grava na tabela T7J o log de criacao/alteracao do profile de
versao de layout (TAFA635LAY), registrando filial, identificador
unico, usuario logado, tipo de movimento (1=Inclusao,
2=Alteracao), data/hora e o conteudo antes/depois da alteracao.

@type      method
@author    Pâmela Bernardo
@since     06/07/2026
@version   1.0
@param     cBeforeContent  Character  Conteudo do perfil antes da alteracao (vazio na inclusao)
@param     cAfterContent   Character  Conteudo do perfil apos a alteracao
@param     lInclusion  Logical  Define se é inclusão na tabela T7J
@return    lOk             Logical    Indica se o log foi gravado com sucesso
/*/
//----------------------------------------------------------------
Method saveVersionLayoutLog(cBeforeContent As Character, cAfterContent As Character, lInclusion As Logical) As Logical Class TAFVersionLayoutMonit

	Local lOk:= .F.      As Logical
	Local cTipo    As Character
	Local cMensag  As Character

	Default cBeforeContent := ''
	Default cAfterContent  := ''
	Default lInclusion	   := .T.


	If lInclusion
		cTipo   := '1'
		cMensag := STR0008 //'Criação da versão de layout do profile TAFA635LAY.'
	Else
		cTipo   := '2'
		cMensag := STR0009 //'Alteração da versão de layout do profile TAFA635LAY.'
	EndIf

	DbSelectArea('T7J')

	Begin Transaction

		If RecLock('T7J', .T.)
			T7J->T7J_FILIAL := xFilial('T7J')
			T7J->T7J_IDENT  := FwUUIDv4(.T.)
			T7J->T7J_CODUSR := RetCodUsr()
			T7J->T7J_TIPO   := cTipo
			T7J->T7J_DATA   := Date()
			T7J->T7J_HORA   := Time()
			T7J->T7J_BEFORE := cBeforeContent
			T7J->T7J_AFTER  := cAfterContent
			T7J->T7J_MENSAG := cMensag
			T7J->T7J_ORIGEM := Self:getProgramId()

			T7J->(MsUnLock())

			lOk := .T.
		EndIf
	End Transaction

Return lOk

//----------------------------------------------------------------
/*/{Protheus.doc} TAFVersionLayoutMonit:buildProfile
Monta o objeto FwProfile configurado para o controle unico por
grupo de empresa (filial em branco, usuario fixo "000000"),
identificado por TAFA635LAY.

@type      method
@author    Pâmela Bernardo
@since     06/07/2026
@version   1.0
@return    oProfile  Object  Instancia de FwProfile configurada
/*/
//----------------------------------------------------------------
Method buildProfile() As Object Class TAFVersionLayoutMonit

	Local oProfile As Object

	oProfile := FwProfile():New()
	oProfile:SetCompany(FWGrpCompany())
	oProfile:SetBranch('')
	oProfile:setUser('000000')
	oProfile:setProgram(Self:getProgramId())
	oProfile:setTask('VERSIONLAY')
	oProfile:setType('LAYOUT')

Return oProfile

//----------------------------------------------------------------
/*/{Protheus.doc} TAFVersionLayoutMonit:getProgramId
Retorna a identificacao utilizada para o registro no perfil
Protheus, seguindo o mesmo padrao adotado em
FISA318F7OnboardProfile (identificador FISA318).

@type      method
@author    Pâmela Bernardo
@since     06/07/2026
@version   1.0
@return    cProgramId  Character  Identificacao do programa no perfil
/*/
//----------------------------------------------------------------
Method getProgramId() As Character Class TAFVersionLayoutMonit
Return 'TAFA635LAY'

//----------------------------------------------------------------
/*/{Protheus.doc} TAFVersionLayoutMonit:buildListResponse
Monta o payload de sucesso do endpoint GET versionLayout,
conforme contrato: {items: [{versionLayout}], hasNext}.

@type      method
@author    Pâmela Bernardo
@since     06/07/2026
@version   1.0
@param     cVersion  Character  Versao de layout gravada
@return    jResp     Json     JsonObject com items e hasNext
/*/
//----------------------------------------------------------------
Method buildListResponse(cVersion As Character) As Json Class TAFVersionLayoutMonit

	Local jResp As Json
	Local jItem As Json

	Default cVersion := ''

	jResp := JsonObject():New()
	jItem := JsonObject():New()

	jItem['versionLayout'] := cVersion

	jResp['items']   := {jItem}
	jResp['hasNext'] := .F.


Return jResp

//----------------------------------------------------------------
/*/{Protheus.doc} TAFVersionLayoutMonit:buildStatusResponse
Monta o payload padrao de resposta do endpoint POST
versionLayout, conforme contrato: {status, detailMessage}.

@type      method
@author    Pâmela Bernardo
@since     06/07/2026
@version   1.0
@param     nCode        Numeric    Codigo referente ao processo de atualizacao
@param     cMessage Character  Mensagem de erro
@param     cDetailMessage Character  Mensagem detalhada do processo
@return    jResp          Json     JsonObject com status e detailMessage
/*/
//----------------------------------------------------------------
Method buildStatusResponse(nCode As Numeric, cMessage as Character, cDetailMessage As Character) As JSON Class TAFVersionLayoutMonit

	Local jResp As JSON

	Default nCode          := 400
	Default cMessage 	   := ''
	Default cDetailMessage := ''

	jResp := JsonObject():New()
	jResp['code']          := nCode
	jResp['message']       := cMessage
	jResp['detailMessage'] := cDetailMessage

Return jResp
