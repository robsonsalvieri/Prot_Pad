#INCLUDE 'tlpp-core.th'
#INCLUDE 'tlpp-rest.th'
#INCLUDE 'totvs.protheus.fiscal.taf.logsEvents.ch'

namespace totvs.protheus.fiscal.taf.event

/*/{Protheus.doc} TafLogsEvents
API responsável pela consulta de Logs de Eventos SEFAZ
com suporte a paginação e filtros opcionais.

@type     function
@author   José Riquelmo
@since    24/02/2026
@version  1.0
@project  TAF
/*/
@GET(endpoint='/api/taf/fiscal/v1/logsEvents', description='Consulta Logs de Eventos SEFAZ')
Function TafLogsEvents() as Logical

    Local jParam        as Json
    Local cPage         as Character
    Local cPageSize     as Character
    Local cFilEvent     as Character
    Local cStatus       as Character
    Local cEventCode    as Character
    Local cSendFrom     as Character
    Local cSendTo       as Character
    Local cRecvFrom     as Character
    Local cRecvTo       as Character
    Local oJsResponse   as Json

    If !Empty(oRest:getQueryRequest()['filial'])
        cFilEvent := oRest:getQueryRequest()['filial']
    EndIf

    jParam := oRest:getQueryRequest()

    If jParam:HasProperty("page")
        cPage := jParam:GetJsonText("page")
    EndIf

    If jParam:HasProperty("pageSize")
        cPageSize := jParam:GetJsonText("pageSize")
    EndIf

    If jParam:HasProperty("status")
        cStatus := jParam:GetJsonText("status")
    EndIf

    If jParam:HasProperty("eventCode")
        cEventCode := jParam:GetJsonText("eventCode")
    EndIf

    If jParam:HasProperty("sendDateFrom")
        cSendFrom := jParam:GetJsonText("sendDateFrom")
    EndIf

    If jParam:HasProperty("sendDateTo")
        cSendTo := jParam:GetJsonText("sendDateTo")
    EndIf

    If jParam:HasProperty("receivedDateFrom")
        cRecvFrom := jParam:GetJsonText("receivedDateFrom")
    EndIf

    If jParam:HasProperty("receivedDateTo")
        cRecvTo := jParam:GetJsonText("receivedDateTo")
    EndIf

    oJsResponse := getTafLogsEventsService( ;
        Val(cPage), ;
        Val(cPageSize), ;
        cFilEvent, ;
        cStatus, ;
        cEventCode, ;
        cSendFrom, ;
        cSendTo, ;
        cRecvFrom, ;
        cRecvTo )

    oRest:setResponse(oJsResponse)
    FwFreeObj(oJsResponse)

Return .T.

// ----------------------------------------------------------------

/*/{Protheus.doc} getTafLogsEventsService
Serviço responsável por montar a query dinâmica,
aplicar filtros e retornar os registros paginados
de Logs de Eventos SEFAZ.

@type     function
@author   José Riquelmo
@since    24/02/2026
@version  1.0
/*/
Static Function getTafLogsEventsService( ;
    nPage            as Numeric, ;
    nPageSize        as Numeric, ;
    cFilEvent        as Character, ;
    cStatusParam     as Character, ;
    cEventCodeParam  as Character, ;
    cSendFromParam   as Character, ;
    cSendToParam     as Character, ;
    cRecvFromParam   as Character, ;
    cRecvToParam     as Character ) as Json

    Local oJsResponse := JsonObject():New()
    Local oItem       as Json
    Local oQry        as Object
    Local cAliasQry   as Character
    Local cQry        := "" as Character
    Local nBind       := 1 as Numeric
    Local nOffset     := 0 as Numeric
    Local nCount      := 0 as Numeric
    Local lHasNext    := .F. as Logical
    Local cMsg        as Character

    If Empty(cFilEvent)
        cFilEvent := xFilial('T7A')
    EndIf

    nOffset := (nPage - 1) * nPageSize

    oJsResponse['items'] := {}

    cQry += " SELECT "
    cQry += " T7A.T7A_IDENT, "
    cQry += " T7A.T7A_TPEVEN, "
    cQry += " T7A.T7A_DTEMIS, "
    cQry += " T7A.T7A_DTPREV, "
    cQry += " T7A.T7A_STATUS, "
    cQry += " T7A.T7A_NUMDOC, "
    cQry += " T7E.T7E_DESCRI, "
    cQry += " T7D.T7D_XMSG, "
    cQry += " T7D.T7D_DATA, "
    cQry += " T7D.R_E_C_N_O_ AS T7D_RECNO "
    cQry += " FROM " + RetSqlName("T7A") + " T7A "

    cQry += " LEFT JOIN ( "
    cQry += "     SELECT T7D_FILIAL, "
    cQry += "            T7D_IDENT, "
    cQry += "            MAX(R_E_C_N_O_) AS T7D_RECNO "
    cQry += "     FROM " + RetSqlName("T7D") + " "
    cQry += "     WHERE D_E_L_E_T_ = ? "
    cQry += "     GROUP BY T7D_FILIAL, T7D_IDENT "
    cQry += " ) T7D_LAST ON "
    cQry += FwJoinFilial("T7A","T7D_LAST")
    cQry += " AND T7A.T7A_IDENT = T7D_LAST.T7D_IDENT "

    cQry += " LEFT JOIN " + RetSqlName("T7D") + " T7D ON "
    cQry += " T7D.R_E_C_N_O_ = T7D_LAST.T7D_RECNO "

    cQry += " LEFT JOIN " + RetSqlName("T7E") + " T7E ON "
    cQry += FwJoinFilial("T7A","T7E")
    cQry += " AND T7A.T7A_TPEVEN = T7E.T7E_EVENTO "
    cQry += " AND T7E.D_E_L_E_T_ = ? "

    cQry += " WHERE T7A.D_E_L_E_T_ = ? "
    cQry += " AND T7A.T7A_FILIAL = ? "

    If !Empty(cEventCodeParam)
        cQry += " AND T7A.T7A_TPEVEN IN (?) "
    EndIf

    If !Empty(cStatusParam)
        cQry += " AND T7A.T7A_STATUS IN (?) "
    EndIf

    If !Empty(cSendFromParam)
        cQry += " AND T7A.T7A_DTEMIS >= ? "
    EndIf

    If !Empty(cSendToParam)
        cQry += " AND T7A.T7A_DTEMIS <= ? "
    EndIf

    If !Empty(cRecvFromParam)
        cQry += " AND T7A.T7A_DTPREV >= ? "
    EndIf

    If !Empty(cRecvToParam)
        cQry += " AND T7A.T7A_DTPREV <= ? "
    EndIf

    cQry += " ORDER BY T7A.T7A_IDENT "
    cQry += " OFFSET " + AllTrim(Str(nOffset)) + " ROWS "
    cQry += " FETCH NEXT " + AllTrim(Str(nPageSize + 1)) + " ROWS ONLY "

    cQry := ChangeQuery(cQry)
    oQry := FwExecStatement():New(cQry)

    oQry:SetString(nBind++, Space(1))
    oQry:SetString(nBind++, Space(1))
    oQry:SetString(nBind++, Space(1))
    oQry:SetString(nBind++, cFilEvent)

    If !Empty(cEventCodeParam)
        oQry:SetIn(nBind++, StrTokArr(cEventCodeParam, "', '"))
    EndIf

    If !Empty(cStatusParam)
        oQry:SetIn(nBind++, StrTokArr(cStatusParam, "', '"))
    EndIf

    If !Empty(cSendFromParam)
        oQry:SetString(nBind++, DToS(SToD(StrTran(cSendFromParam,"-",""))))
    EndIf

    If !Empty(cSendToParam)
        oQry:SetString(nBind++, DToS(SToD(StrTran(cSendToParam,"-",""))))
    EndIf

    If !Empty(cRecvFromParam)
        oQry:SetString(nBind++, DToS(SToD(StrTran(cRecvFromParam,"-",""))))
    EndIf

    If !Empty(cRecvToParam)
        oQry:SetString(nBind++, DToS(SToD(StrTran(cRecvToParam,"-",""))))
    EndIf

    cAliasQry := oQry:OpenAlias()

    While (cAliasQry)->(!EOF())

        oItem := JsonObject():New()

        T7D->(DbGoTo((cAliasQry)->T7D_RECNO))
        cMsg := alltrim(T7D->T7D_XMSG)

        If Empty(cMsg)
            cMsg := STR0005
        EndIf

        oItem['id']              := (cAliasQry)->T7A_IDENT
        oItem['eventCode']       := AllTrim((cAliasQry)->T7A_TPEVEN)
        oItem['description']     := (cAliasQry)->T7E_DESCRI
        oItem['status']          := AllTrim((cAliasQry)->T7A_STATUS)
        oItem['noteNumber']      := AllTrim((cAliasQry)->T7A_NUMDOC)

        oItem['sendDate'] := ;
            SubStr((cAliasQry)->T7A_DTEMIS,1,4) + "-" + ;
            SubStr((cAliasQry)->T7A_DTEMIS,5,2) + "-" + ;
            SubStr((cAliasQry)->T7A_DTEMIS,7,2)

        oItem['sefazReturnDate'] := ;
            SubStr((cAliasQry)->T7D_DATA,1,4) + "-" + ;
            SubStr((cAliasQry)->T7D_DATA,5,2) + "-" + ;
            SubStr((cAliasQry)->T7D_DATA,7,2)

        oItem['sefazDetail']     := cMsg

        AAdd(oJsResponse['items'], oItem)

        nCount++
        (cAliasQry)->(DbSkip())

        If nCount == nPageSize
            If !(cAliasQry)->(EOF())
                lHasNext := .T.
            EndIf
            Exit
        EndIf

    EndDo

    oJsResponse['hasNext'] := lHasNext

    (cAliasQry)->(DbCloseArea())

Return oJsResponse
