#include 'tlpp-core.th'
#include 'tlpp-rest.th'
#include 'totvs.ch'
#include 'totvs.protheus.fiscal.taf.logsMonitorActions.ch'


namespace totvs.protheus.fiscal.taf.event

/*/{Protheus.doc} TAFLogsMonitorActions
Controller REST responsavel pela consulta dos logs das acoes de
manutencao gravadas na tabela T7J (Monitor de Eventos - Logs),
com suporte a paginacao encapsulada via FWAdapterBaseV2 e filtros
opcionais por tipo de acao e intervalo de data/hora.

@type      class
@author    Pamela Bernardo
@since     07/07/2026
@version   2.0
/*/
Class TAFLogsMonitorActions FROM FWAdapterBaseV2

	private data jQueryParams as JSON

	public Method New() Constructor

	@Get('/api/taf/fiscal/v1/logsMonitorActions')
	public Method getLogsMonitorActions()

	private Method getQueryParams() As JSON
	private Method loadLogs()
	private Method addFields()
	private Method getQueryLog() As Character
	private Method getWhereLog() As Character

EndClass

//----------------------------------------------------------------
/*/{Protheus.doc} TAFLogsMonitorActions:New
Metodo construtor. Inicializa a classe base FWAdapterBaseV2
com o verbo GET e habilita o modo case-sensitive.

@type      method
@author    Pamela Bernardo
@since     07/07/2026
@version   2.0
@return    Self  Object  Instancia corrente da classe
/*/
//----------------------------------------------------------------
Method New() Class TAFLogsMonitorActions
	_Super:New("GET", .T.)
Return Self

//----------------------------------------------------------------
/*/{Protheus.doc} TAFLogsMonitorActions:getLogsMonitorActions
Endpoint REST GET /api/taf/fiscal/v1/logsMonitorActions.
Retorna os logs das acoes de manutencao gravadas na tabela T7J,
com suporte a paginacao (page/pageSize) encapsulada pelo
FWAdapterBaseV2 e filtros opcionais por tipo de acao (typeAction)
e intervalo de data/hora (startDate/endDate/startTime/endTime).
Em caso de parametros invalidos ou dicionario desatualizado,
o endpoint retorna 400 com o payload de erro
{code, message, detailedMessage}.

@type      method
@author    Pamela Bernardo
@since     07/07/2026
@version   2.0
@return    lOk  Logical  Retorna o resultado do envio da resposta REST
/*/
//----------------------------------------------------------------
Method getLogsMonitorActions() Class TAFLogsMonitorActions

	Local oUtils     As Object
	Local xResponse  As Variant
	Local nCode     As Numeric
	Local lOk := .T.       As Logical
	Local lExisteT7J    := TAFAlsInDic("T7J") As Logical

	::jQueryParams := Self:getQueryParams()

	oUtils := Utils():New()

	If lExisteT7J
		Self:loadLogs()
		nCode := Self:GetCode()
		xResponse := Self:getJSONResponse()
		lOk := Self:lOk
	Else
		lOk := .F.
		nCode := 400
		xResponse := oUtils:setClassResponse(400, STR0009, STR0010) //"Seu dicionario de dados esta desatualizado..." ## "atualize-o para a versao mais recente disponivel..."
	Endif

	oUtils:setAPIResponse(oRest, xResponse, lOk, nCode)

	FreeObj(oUtils)

Return

//----------------------------------------------------------------
/*/{Protheus.doc} TAFLogsMonitorActions:getQueryParams
Extrai e normaliza os parametros de query string da requisicao
(page, pageSize, typeAction, startDate, endDate, startTime,
endTime), aplicando os valores padrao de paginacao (page=1,
pageSize=10) quando nao informados ou invalidos.

@type      method
@author    Pamela Bernardo
@since     07/07/2026
@version   2.0
@return    jBody  JSON  JsonObject com os parametros normalizados
/*/
//----------------------------------------------------------------
Method getQueryParams() As JSON Class TAFLogsMonitorActions

	Local jBody                 As JSON
	Local jBodyAux              As JSON
	Local nAux                  As Numeric
	Local dDateAux := Stod('')  As Date

	jBody    := JsonObject():New()
	jBodyAux := oRest:getQueryRequest()

	jBody['typeAction'] := {}
	jBody['startDate']  := dDateAux
	jBody['endDate']    := dDateAux
	jBody['startTime']  := ""
	jBody['endTime']    := ""

	If jBodyAux:HasProperty('page')
		nAux := Val(jBodyAux['page'])
		If nAux <= 0
			nAux := 1
		EndIf
		jBody['page'] := nAux
	EndIf

	If jBodyAux:HasProperty('pageSize')
		nAux := Val(jBodyAux['pageSize'])
		If nAux <= 0
			nAux := 10
		EndIf
		jBody['pageSize'] := nAux
	EndIf

	If jBodyAux:HasProperty('typeAction')
		jBody['typeAction'] := StrToKarr(jBodyAux['typeAction'], ',')
	EndIf

	If jBodyAux:HasProperty('startDate')
		jBody['startDate'] := SToD(StrTran(jBodyAux['startDate'], "-", ""))
	EndIf

	If jBodyAux:HasProperty('endDate')
		jBody['endDate'] := SToD(StrTran(jBodyAux['endDate'], "-", ""))
	EndIf

	If jBodyAux:HasProperty('startTime')
		jBody['startTime'] := jBodyAux['startTime']
	EndIf

	If jBodyAux:HasProperty('endTime')
		jBody['endTime'] := jBodyAux['endTime']
	EndIf

Return jBody

//----------------------------------------------------------------
/*/{Protheus.doc} TAFLogsMonitorActions:loadLogs
Orquestra a consulta na tabela T7J delegando a paginacao ao
FWAdapterBaseV2. Configura os campos mapeados, monta query e
where, define page/pageSize e executa via adapter.

@type      method
@author    Pamela Bernardo
@since     07/07/2026
@version   2.0
@return    Nil
/*/
//----------------------------------------------------------------
Method loadLogs() Class TAFLogsMonitorActions

	Local jParams       As JSON
	Local nPage         As Numeric
	Local nPageSize     As Numeric
	Local cWhere        As Character
	Local oUtils        As Object

	jParams   := ::jQueryParams
	nPage     := jParams['page']
	nPageSize := jParams['pageSize']
	cWhere    := Self:getWhereLog()
	oUtils    := Utils():New()

	Self:addFields()

	Self:setPage(nPage)
	Self:setPageSize(nPageSize)
	Self:setIsCaseSensitive(.T.)
	Self:SetQuery(Self:getQueryLog())
	Self:SetWhere(cWhere)
	Self:SetOrder("T7J_DATA, T7J_HORA")
	Self:SetUseSpaces(.T.)

	Self:SetFields(oUtils:getQueryParam('FIELDS'))
	Self:SetOrderQuery(oUtils:getQueryParam('ORDER'))

	If Self:Execute()
		Self:FillGetResponse()
	EndIf

	FreeObj(oUtils)

Return

//----------------------------------------------------------------
/*/{Protheus.doc} TAFLogsMonitorActions:addFields
Cria o mapa de campos Protheus x API para o FWAdapterBaseV2.
Cada campo e mapeado com nome API, campo fisico, visibilidade,
filtrabilidade e estrutura do campo.

Observacao: o campo 'id' do contrato descreve o tipo como
'number', porem o dado de origem T7J_IDENT e gravado como UUID
(Character), conforme o mesmo padrao adotado na gravacao do log
em TAFVersionLayoutMonit (T7J_IDENT := FwUUIDv4(.T.)). O valor e
retornado como Character para preservar a integridade do dado
de origem.

@type      method
@author    Pamela Bernardo
@since     07/07/2026
@version   2.0
@return    Nil
/*/
//----------------------------------------------------------------
Method addFields() Class TAFLogsMonitorActions

	Self:AddMapFields('id'          , 'T7J_IDENT' , .T., .T., {'T7J_IDENT' , 'C', TamSX3('T7J_IDENT')[1] , 0})
	Self:AddMapFields('T7J_CODUSR'  , 'T7J_CODUSR', .F., .T., {'T7J_CODUSR', 'C', TamSX3('T7J_CODUSR')[1], 0})
	Self:AddMapFields('nameUser'    , 'USR_CODIGO', .T., .T., {'USR_CODIGO', 'C', 30, 0}, " LTRIM(RTRIM(USR_CODIGO)) ")
	Self:AddMapFields('typeAction'  , 'T7J_TIPO'  , .T., .T., {'T7J_TIPO'  , 'C', TamSX3('T7J_TIPO')[1]  , 0})
	Self:AddMapFields('actionDate'  , 'T7J_DATA'  , .T., .T., {'T7J_DATA'  , 'D', TamSX3('T7J_DATA')[1]  , 0})
	Self:AddMapFields('actionTime'  , 'T7J_HORA'  , .T., .T., {'T7J_HORA'  , 'C', TamSX3('T7J_HORA')[1]  , 0})
	Self:AddMapFields('beforeAction', 'T7J_BEFORE', .T., .T., {'T7J_BEFORE', 'M', TamSX3('T7J_BEFORE')[1], 0})
	Self:AddMapFields('afterAction' , 'T7J_AFTER' , .T., .T., {'T7J_AFTER' , 'M', TamSX3('T7J_AFTER')[1] , 0})
	Self:AddMapFields('message'     , 'T7J_MENSAG', .T., .T., {'T7J_MENSAG', 'M', TamSX3('T7J_MENSAG')[1], 0})

Return

//----------------------------------------------------------------
/*/{Protheus.doc} TAFLogsMonitorActions:getQueryLog
Monta a expressao SQL para consulta dos dados na tabela T7J.
Utiliza os placeholders #QueryFields# e #QueryWhere# do
FWAdapterBaseV2 que serao substituidos automaticamente pelo adapter.

@type      method
@author    Pamela Bernardo
@since     07/07/2026
@version   2.0
@return    cQuery  Character  Expressao SQL com placeholders
/*/
//----------------------------------------------------------------
Method getQueryLog() As Character Class TAFLogsMonitorActions

	Local cQuery := "" As Character

	cQuery := " SELECT #QueryFields#"
	cQuery += " FROM " + RetSqlName("T7J") + " T7J "
	cQuery += " INNER JOIN SYS_USR USR ON USR.USR_ID = T7J.T7J_CODUSR "
	cQuery += " AND USR.D_E_L_E_T_ = ' '  "
	cQuery += " WHERE #QueryWhere#"

Return cQuery

//----------------------------------------------------------------
/*/{Protheus.doc} TAFLogsMonitorActions:getWhereLog
Monta a expressao SQL WHERE para consulta dos logs, aplicando
os filtros obrigatorios (D_E_L_E_T_ e filial) e opcionais
(typeAction, startDate/endDate, startTime/endTime).

@type      method
@author    Pamela Bernardo
@since     07/07/2026
@version   2.0
@return    cWhere  Character  Expressao WHERE para consulta
/*/
//----------------------------------------------------------------
Method getWhereLog() As Character Class TAFLogsMonitorActions

	Local cWhere       := "" As Character
	Local cStartTime   := "" As Character
	Local cEndTime     := "" As Character
	Local cStartDate   := "" As Character
	Local cEndDate     := "" As Character
	Local cTypeAction  := "" As Character
	Local aTypeAction  := {} As Array
	Local jParams      As JSON
	Local nX           := 0  As Numeric

	jParams     := ::jQueryParams
	aTypeAction := jParams['typeAction']
	cStartDate  := DtoS(jParams['startDate'])
	cEndDate    := DtoS(jParams['endDate'])
	cStartTime  := jParams['startTime']
	cEndTime    := jParams['endTime']

	cWhere += " T7J.D_E_L_E_T_ = ' ' "
	cWhere += " AND T7J.T7J_FILIAL = '" + FWxFilial('T7J') + "' "

	If !Empty(cStartDate)
		cWhere += " AND T7J.T7J_DATA >= '" + cStartDate + "' "
	EndIf

	If !Empty(cEndDate)
		cWhere += " AND T7J.T7J_DATA <= '" + cEndDate + "' "
	EndIf

	If Len(aTypeAction) > 0
		For nX := 1 To Len(aTypeAction)
			If nX > 1
				cTypeAction += ","
			EndIf
			cTypeAction += "'" + aTypeAction[nX] + "'"
		Next nX
		cWhere += " AND T7J.T7J_TIPO IN (" + cTypeAction + ") "
	EndIf

	If !Empty(cStartTime)
		cWhere += " AND T7J.T7J_HORA >= '" + cStartTime + "' "
	EndIf

	If !Empty(cEndTime)
		cWhere += " AND T7J.T7J_HORA <= '" + cEndTime + "' "
	EndIf

Return cWhere

