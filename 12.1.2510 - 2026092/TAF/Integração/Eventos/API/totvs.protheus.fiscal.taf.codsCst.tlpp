#INCLUDE 'tlpp-core.th'
#INCLUDE 'tlpp-rest.th'
#INCLUDE 'protheus.ch'

namespace totvs.protheus.fiscal.taf.event

//----------------------------------------------------------------
/*/{Protheus.doc} GetCodsCst
Endpoint REST GET /api/taf/fiscal/v1/codsCst.
Retorna as classes tributarias de CST cadastradas na tabela T5R sem paginacao.

@type      function
@author    GitHub Copilot
@since     28/04/2026
@version   1.0
@return    cJson  Character  JSON de resposta: {items, hasNext} em sucesso
/*/
//----------------------------------------------------------------
@Get('/api/taf/fiscal/v1/codsCst')
Function GetCodsCst() As Character

	Local oResp      As Object
	Local cJson      As Character

	oResp := QueryCodsCst()
	cJson := oResp:ToJson()
	oRest:setStatusResponse(200, cJson)

	FwFreeObj(oResp)

Return

//----------------------------------------------------------------
/*/{Protheus.doc} QueryCodsCst
Executa a consulta das classes tributarias de CST na tabela T5R.
Utiliza FwExecStatement e ChangeQuery para portabilidade entre SGBDs.

@type      static function
@author    GitHub Copilot
@since     28/04/2026
@version   1.0
@return    oResp      Object     JsonObject com items e hasNext
/*/
//----------------------------------------------------------------
Static Function QueryCodsCst() As Object

	Local oQry       As Object
	Local oResp      As Object
	Local oItem      As Object
	Local cSQL       As Character
	Local cAlias     As Character

	oResp := JsonObject():New()
	oResp['items'] := {}
	oResp['hasNext'] := .F.

	cSQL := "SELECT T5R.T5R_CCLATR, T5R.T5R_DESCST, T5R.T5R_DCLATR " + ;
		"FROM " + RetSqlName('T5R') + " T5R " + ;
		"WHERE T5R.D_E_L_E_T_ = ? " + ;
		"AND T5R.T5R_FILIAL = ? " + ;
		"ORDER BY T5R.T5R_CCLATR "

	cSQL := ChangeQuery(cSQL)

	oQry := FwExecStatement():New(cSQL)
	oQry:SetString(1, Space(1))
	oQry:SetString(2, xFilial('T5R'))

	cAlias := oQry:OpenAlias()

	While !(cAlias)->(EOF())
		oItem := JsonObject():New()
		oItem['codCst'] := AllTrim((cAlias)->T5R_CCLATR)
		oItem['desCst'] := AllTrim((cAlias)->T5R_DESCST)
		oItem['descri'] := AllTrim((cAlias)->T5R_DCLATR)

		aAdd(oResp['items'], oItem)

		(cAlias)->(DBSkip())
	EndDo

	(cAlias)->(DBCloseArea())
	FwFreeObj(oQry)

Return oResp
