#INCLUDE 'tlpp-core.th'
#INCLUDE 'tlpp-rest.th'

/*-------------------------------------------------------------------
{Protheus.doc} TafGetDetailEventsById()
Obtém os detalhes completos de um evento fiscal, incluindo data, hora, protocolo e XML de envio.

@author	Evandro Italo
@since  02/02/2026 
-------------------------------------------------------------------*/

@GET(endpoint='/api/taf/fiscal/v1/detailEvents', description='Obtém os detalhes completos de um evento fiscal, incluindo data, hora, protocolo e XML de envio.')
Function TafGetDetailEventsById()

    Local oJsResponse as json
    Local cIdEvent      as character
    Local cFilEvent      as character

    cIdEvent    := oRest:getQueryRequest()['id']
    If !Empty(oRest:getQueryRequest()['filial'])
        cFilEvent := oRest:getQueryRequest()['filial']
    EndIf

    if !Empty(cIdEvent)
        oJsResponse := getTafDetailEvents(Upper(AllTrim(cIdEvent)), cFilEvent)
    EndIf

    oRest:setResponse( (oJsResponse ))
    FWFreeObj(oJsResponse)

Return

/*-------------------------------------------------------------------
{Protheus.doc} getTafDetailEvents()
Obtém os detalhes completos de um evento fiscal, incluindo data, hora, protocolo e XML de envio.
@author	Evandro Italo
@since  12/12/2025
-------------------------------------------------------------------*/
Static Function getTafDetailEvents(cFilter as character, cFilEvent as character)

    Local cQry                                          as character
    Local oJsResponse                                   as json
    Local oQry                                          as object
    Local cAliasQry                                     as character
    Local lExistSndXml  := TAFColumnPos("T7D_SNDXML")   as logical

    cQry            := ""
    cAliasQry       := getNextAlias()
    If Empty(cFilEvent)
        cFilEvent := xFilial('T7A')
    EndIf

    //Query para obter o protocolo, data e hora do evento, além do XML de envio e retorno do evento fiscal
    cQry += " SELECT T7A.T7A_PROT, T7D.T7D_DATA, T7D.T7D_HORA, T7D.R_E_C_N_O_ T7D_RECNO "
    cQry += " FROM " + RetSqlName("T7A") + " T7A "
    //Subquery para obter o último registro do T7D relacionado ao evento do T7A
    cQry += " LEFT JOIN ( "
    cQry += "     SELECT T7D_IDENT, MAX(R_E_C_N_O_) AS MAX_RECNO "
    cQry += "     FROM " + RetSqlName("T7D") + " "
    cQry += "     WHERE D_E_L_E_T_ = ? "
    cQry += "     GROUP BY T7D_IDENT "
    cQry += " ) T7D_MAX ON T7D_MAX.T7D_IDENT = T7A.T7A_IDENT "
    //Join para obter os detalhes do último registro do T7D relacionado ao evento do T7A
    cQry += " LEFT JOIN " + RetSqlName("T7D") + " T7D ON "
    cQry += "     T7D.T7D_IDENT = T7D_MAX.T7D_IDENT "
    cQry += "     AND T7D.R_E_C_N_O_ = T7D_MAX.MAX_RECNO "
    cQry += "     AND " + FwJoinFilial("T7A","T7D") + " "
    //Condições para filtrar o evento específico
    cQry += " WHERE T7A.D_E_L_E_T_ = ? "
    cQry += " AND T7A.T7A_FILIAL = ? "
    cQry += " AND T7A.T7A_IDENT = ? "

    cQry := ChangeQuery(cQry)

    oQry := FwExecStatement():New(cQry)

    oQry:SetString(1, '')
    oQry:SetString(2, '')
    oQry:SetString(3, cFilEvent)
    oQry:SetString(4, cFilter)
    cAliasQry := oQry:OpenAlias()

    oJsResponse :=  JsonObject():New()

    If (cAliasQry)->(!EOF())

        oJsResponse['hour'        ] := AllTrim((cAliasQry)->T7D_HORA)
        oJsResponse['date'        ] := AllTrim((cAliasQry)->T7D_DATA)
        oJsResponse['protocol'    ] := AllTrim((cAliasQry)->T7A_PROT)

        T7D->(DbGoTo((cAliasQry)->T7D_RECNO))
        if lExistSndXml
            oJsResponse['xmlSend'     ] := AllTrim(T7D->T7D_SNDXML)
        else
            oJsResponse['xmlSend'     ] := ""
        EndIf
        if Empty(T7D->T7D_XMSG)
            oJsResponse['xmlReturn'   ] := "Não Obtido"
        Else    
            oJsResponse['xmlReturn'   ] := AllTrim(T7D->T7D_XMSG)
        EndIf

    EndIf

    (cAliasQry)->(DBCloseArea())

    FwFreeObj(oQry)

Return oJsResponse:ToJson()
