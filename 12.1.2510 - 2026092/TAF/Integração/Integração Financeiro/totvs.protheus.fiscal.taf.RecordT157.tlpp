#INCLUDE "TLPP-CORE.TH"
#INCLUDE "PROTHEUS.CH"
#INCLUDE "TAFXFIN.CH"
#INCLUDE "FWMVCDEF.CH"

namespace totvs.protheus.fiscal.taf.financialintegration

/*/{Protheus.doc} GravaT157
@type			Function
@description	Função para gravar os registros CADASTRO DE OBRAS
@author			Pâmela Bernardo
@since			17/03/2025
@version		1.0
/*/
Function GravaT157(jRetornoT157 as json, aDadosLog as array, cAliasTemp as character) as logical
	Local lGravadados 	:= .F. as Logical
	Local cLog			:= "" as character
	Local nOperacao 	:=  MODEL_OPERATION_INSERT as numeric
	Local oModel489		as object
	Local oModel_T9C 	as object
	
	T9C->(dbSetOrder(3))
	If T9C->(DbSeek(xFilial("T9C")+jRetornoT157["T157"]["TP_INSCRICAO"]+jRetornoT157["T157"]["NR_INSC_ESTAB"]))
		nOperacao :=  MODEL_OPERATION_UPDATE 
	EndIf
	oModel489  := FWLoadModel("TAFA489")
	oModel489:SetOperation( nOperacao )
	oModel489:Activate()
	oModel_T9C := oModel489:GetModel("MODEL_T9C")
	
	oModel_T9C:SetValue( "T9C_TPINSC", jRetornoT157["T157"]["TP_INSCRICAO"])
	oModel_T9C:SetValue( "T9C_NRINSC", AllTrim(jRetornoT157["T157"]["NR_INSC_ESTAB"]))
	oModel_T9C:SetValue( "T9C_INDOBR", jRetornoT157["T157"]["IND_OBRA"])
	oModel_T9C:SetValue( "T9C_INDTER", jRetornoT157["T157"]["IND_TERCEIRO"])
	oModel_T9C:SetValue( "T9C_DSCOBR", AllTrim(jRetornoT157["T157"]["DESCRICAO"]))
	oModel_T9C:SetValue( "T9C_CPRB",  jRetornoT157["T157"]["INDCPRB"])

	If oModel489:VldData()
		lGravadados :=  oModel489:CommitData()
	Else
		lGravadados := .F.
		cLog := cValToChar(oModel489:GetErrorMessage()[4]) + ' - '
		cLog += cValToChar(oModel489:GetErrorMessage()[5]) + ' - '
		cLog += cValToChar(oModel489:GetErrorMessage()[6])
		aDadosLog := {(cAliasTemp)->TMP_MOVORI, (cAliasTemp)->TMP_ID, FwX2Nome('T9C'), cLog, .T., '' }
		TAFConout(cLog,,, STR0002)
	Endif

Return lGravadados
