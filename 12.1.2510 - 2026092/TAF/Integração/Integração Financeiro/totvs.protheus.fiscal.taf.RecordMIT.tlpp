#INCLUDE "TLPP-CORE.TH"
#INCLUDE "PROTHEUS.CH"
#INCLUDE "TAFXFIN.CH"
#INCLUDE "FWMVCDEF.CH"

namespace totvs.protheus.fiscal.taf.financialintegration

/*/{Protheus.doc} GravaMIT
@type			Function
@description	Função para gravar os registros nas tabelas T1A/T1B referente ao MIT
@author			Pâmela Bernardo
@since			17/03/2025
@version		1.0
/*/
Function GravaMIT(jRetornoMIT as json, aDadosLog as array, cAliasTemp as character ) as logical
	Local lGravadados := .T. as Logical
	Local cLog		  := "" as character
	Local cCodMun	  := "" as character
	Local cIDTributo  := "" as character
	Local cCodigoUF	  := "" as character
	Local cFCISCP	  := "" as character
	Local nOperacao	  := MODEL_OPERATION_INSERT as Numeric
	Local oModel632		as object
	Local oModel_T1A	as object

	If lGravadados
		cIDTributo := Posicione("C3S",1,xFilial("C3S")+jRetornoMIT["T1A"]["IDTRIB"],"ALLTRIM(C3S_ID)" )
		T1A->(dbSetOrder(3))
		If T1A->(DbSeek(xFilial("T1A")+(cAliasTemp)->TMP_IDMOV+cIDTributo))
			nOperacao :=  MODEL_OPERATION_UPDATE 
		Else
			nOperacao :=  MODEL_OPERATION_INSERT
		EndIf
		oModel632 := FWLoadModel("TAFA632")
		oModel632:SetOperation( nOperacao )
		oModel632:Activate()

		oModel_T1A:=oModel632:GetModel("MODEL_T1A")
		If !Empty(jRetornoMIT["T1A"]["UF"])
			cCodigoUF := Posicione("C09",1,xFilial("C09")+jRetornoMIT["T1A"]["UF"],"C09_ID")
		EndIf
		If !Empty(jRetornoMIT["T1A"]["CNPINC"])
			cFCISCP := Posicione("V3X",2,xFilial("V3X")+jRetornoMIT["T1A"]["CNPINC"],"ALLTRIM(V3X_ID)")
		EndIf
		oModel_T1A:SetValue( "T1A_FILORI", cEmpAnt+jRetornoMIT["T1A"]["FILORIG"] )
		oModel_T1A:SetValue( "T1A_IDTRIB", cIDTributo )
		oModel_T1A:SetValue( "T1A_PERAPU", jRetornoMIT["T1A"]["PERAPU"])
		oModel_T1A:SetValue( "T1A_CODREC", jRetornoMIT["T1A"]["CODREC"] )
		oModel_T1A:SetValue( "T1A_TRIPOS", "")
		oModel_T1A:SetValue( "T1A_IDDOC", (cAliasTemp)->TMP_IDMOV )
		DbSelectArea("C07")
		C07->(DbSetOrder(5))
		If C07->(MsSeek(xFilial("C07")+jRetornoMIT["T1A"]["CODMUN"]))
			cCodMun := C07->C07_ID
		EndIf
		oModel_T1A:SetValue( "T1A_PERIOD", jRetornoMIT["T1A"]["PERIOD"])
		oModel_T1A:SetValue( "T1A_CNPINC", jRetornoMIT["T1A"]["CNPINC"])
		oModel_T1A:SetValue( "T1A_VALTRI", jRetornoMIT["T1A"]["VALTRIB"] )
		oModel_T1A:SetValue( "T1A_UF", cCodigoUF)
		oModel_T1A:SetValue( "T1A_CODMUN", cCodMun)
		oModel_T1A:SetValue( "T1A_IDSCP", cFCISCP)
		oModel_T1A:SetValue( "T1A_DTDEBI", jRetornoMIT["T1A"]["DTDEBITO"] )
		
		If oModel632:VldData()
			lGravadados := oModel632:CommitData()
			If lGravadados
				LEM->(DbSetOrder(1))
				If LEM->(DbSeek(xfilial("LEM")+(cAliasTemp)->TMP_ID))
					RecLock("LEM", .F.)
						LEM->LEM_INTEGR := "5"
					LEM->(MsUnLock())
				EndIf
			EndIf
		Else
			lGravadados := .F.
			cLog := cValToChar(oModel632:GetErrorMessage()[4]) + ' - '
			cLog += cValToChar(oModel632:GetErrorMessage()[5]) + ' - '
			cLog += cValToChar(oModel632:GetErrorMessage()[6])
			aDadosLog := {(cAliasTemp)->TMP_MOVORI, (cAliasTemp)->TMP_ID, FwX2Nome('T1A'), cLog, .T., '' }
			TAFConout(cLog,,, STR0002)
		Endif
	EndIf

Return lGravadados
