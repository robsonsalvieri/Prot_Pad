/*/{Protheus.doc} ProfileOptimizer:getParticipantModelFields()
Método responsável por retornar os campos que podem ser filtrados da participante.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 24/09/2025
@return jParticipantModel, json, Json com os campos do participante.
/*/
method getParticipantModelFields(cAlias as character) as json class ProfileOptimizer
    local jParticipantModel := jsonObject():new() as json

    jParticipantModel['status'] := "F22_STATUS"
    jParticipantModel['fields'] := { {'F22_TPPART', self:cTypeCode}, {'F22_CLIFOR', self:jData[cAlias+'_COD']}, {'F22_LOJA', self:jData[cAlias+'_LOJA']} }
    jParticipantModel['seekAll'] := { {'F22_TPPART', self:cTypeCode}, {'F22_CLIFOR', 'TODOS'}, {'F22_LOJA', 'ZZ'} }

return jParticipantModel

/*/{Protheus.doc} ProfileOptimizer:getProductModelFields()
