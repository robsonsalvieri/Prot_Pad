@since 24/09/2025
@return jProductModel, json, Json com os campos do produto.
/*/
method getProductModelFields() as json class ProfileOptimizer
    local jProductModel := jsonObject():new() as json

    jProductModel['status'] := "F24_STATUS"
    jProductModel['fields'] := { {"F24_CDPROD", self:jData['B1_COD']} }
    jProductModel['seekAll'] := { {'F24_CDPROD', 'TODOS'} }

return jProductModel

/*/{Protheus.doc} ProfileOptimizer:fisRetFldProd()
Método responsável por retornar os campos que podem ser filtrados do produto.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 24/09/2025
@param aFields, array, Array com os campos do produto.
@return aNewFields, array, Array com os campos do produto.
/*/
method fisRetFldProd(aFields as array) as array class ProfileOptimizer
    local jFieldsSBZ := nil as json
    local aNewFields := {} as array
    local cAlias := "" as character
    local cField := "" as character
    local nI := 0 as numeric

    jFieldsSBZ := self:getFieldsSBZ()
    
    for nI := 1 to len(aFields)
        cAlias := aFields[nI][1]
        cField := aFields[nI][2]

        if jFieldsSBZ:hasproperty(cField)
            cAlias := jFieldsSBZ[cField][1]
            cField := jFieldsSBZ[cField][2]
        endIf

        aadd(aNewFields, { cAlias, cField })
    next nI

    FreeObj(jFieldsSBZ)
    jFieldsSBZ := nil
return aNewFields


