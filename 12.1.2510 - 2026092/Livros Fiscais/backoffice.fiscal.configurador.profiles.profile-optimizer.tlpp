/*/
method setProduct(cCodProd as character) class ProfileOptimizer
    self:cProduct := cCodProd
    self:jData['B1_COD'] := cCodProd
return

/*/{Protheus.doc} ProfileOptimizer:getFieldsSBZ()
Método responsável por retornar os campos que são usados quando a tabela de produto esta compartilhada - SBZ.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 24/09/2025
@param jFieldsSBZ, json, json com os campos da tabela SBZ
/*/
method getFieldsSBZ() as json class ProfileOptimizer
    local jFieldsSBZ := jsonObject():new() as json

    jFieldsSBZ["B1_LOCPAD"] := { "SBZ", "BZ_LOCPAD" }
    jFieldsSBZ["B1_CODISS"] := { "SBZ", "BZ_CODISS" }
    jFieldsSBZ["B1_ORIGEM"] := { "SBZ", "BZ_ORIGEM" }
    jFieldsSBZ["B1_CLASFIS"] := { "SBZ", "BZ_CLASFIS" }
    jFieldsSBZ["B1_GRTRIB"] := { "SBZ", "BZ_GRTRIB" }
    jFieldsSBZ["B1_IRRF"]   := { "SBZ", "BZ_IRRF"   }
    jFieldsSBZ["B1_PIS"]    := { "SBZ", "BZ_PIS"    }
    jFieldsSBZ["B1_COFINS"] := { "SBZ", "BZ_COFINS" }
    jFieldsSBZ["B1_CSLL"]   := { "SBZ", "BZ_CSLL"   }

return jFieldsSBZ

/*/{Protheus.doc} ProfileOptimizer::findProfiles
Método responsável por localizar os perfis que o participante ou produto atual deve ser incluído ou excluído.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 24/09/2025
/*/
method findProfiles() class ProfileOptimizer

    local aBindInsert := {} as array
    local aBindDelete := {} as array
    local cQueryInsert as character
    local cQueryDelete as character
    local oStatement as object
    local cAlias as character
    local cProfiles as character

    if ( self:cType == TYPE_PRODUCT )
        cQueryInsert := self:getQueryProduct(@aBindInsert,.T.)
        cQueryDelete := self:getQueryProduct(@aBindDelete,.F.)
    else
        cQueryInsert := self:getQueryParticipant(@aBindInsert,.T.)
        cQueryDelete := self:getQueryParticipant(@aBindDelete,.F.)
    endIf

    oStatement := fwExecStatement():new(cQueryInsert)

    self:setBinds(@oStatement,aBindInsert)

    cAlias := oStatement:openAlias()

    while (cAlias)->(!eof())
        aadd(self:jProfiles['profiles'], { 'code': (cAlias)->COD_PERFIL, 'action': 'insert' })

        cProfiles += (cAlias)->COD_PERFIL + '|'

        (cAlias)->(dbSkip())
    enddo

    (cAlias)->(dbCloseArea())

    oStatement:destroy()
    fwFreeObj(oStatement)    

    oStatement := fwExecStatement():new(cQueryDelete)

    self:setBinds(@oStatement,aBindDelete)

    cAlias := oStatement:openAlias()

    while (cAlias)->(!eof())
        if ( !((cAlias)->COD_PERFIL $ cProfiles) )
            aadd(self:jProfiles['profiles'], { 'code': (cAlias)->COD_PERFIL, 'action': 'delete' })
        endif

        (cAlias)->(dbSkip())
    enddo

    (cAlias)->(dbCloseArea())

    fwFreeArray(aBindInsert)
    fwFreeArray(aBindDelete)

    oStatement:destroy()
    fwFreeObj(oStatement)

return

/*/{Protheus.doc} ProfileOptimizer::setBinds
Método responsável por configurar os binds na query.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 24/09/2025
@param oStatement, object, Objeto da instrução SQL.
@param aBind, array, Array com os valores a serem vinculados.
/*/
method setBinds(oStatement as object, aBind as array) class ProfileOptimizer

    local nI as numeric

    for nI := 1 to len(aBind)
        if ( aBind[nI][1] == 'C' )
            oStatement:setString(nI,aBind[nI][2])
        else
            oStatement:setUnsafe(nI,aBind[nI][2])
        endif
    next nI

return

/*/{Protheus.doc} ProfileOptimizer::getQueryParticipant
Método responsável por retornar a query SQL para localizar os perfis.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 24/09/2025
@param aBind, array, Array com os valores a serem vinculados.
@param lQueryInsert, logical, Indica se a query é de inserção.
@return character, Retorna a query SQL gerada.
/*/
method getQueryParticipant(aBind as array, lQueryInsert as logical) as character class ProfileOptimizer

    local cQuery as character
    local nI as numeric
    local nLength as numeric
    local cField as character
    local cStateField as character
    local cDB := upper(tcGetDb()) as character
    local cConcat := '||' as character

    if ( lQueryInsert )
        if ( cDB == 'MSSQL' )
            cConcat := '+'
        endif

        nLength := len(self:aFields)

        cQuery += ' WITH PROF_OPT AS ( '
        cQuery += '     SELECT CKJ.CKJ_CODIGO, '

        for nI := 1 to nLength
            cField := self:aFields[nI][2]

            if ( '|' + cField + '|' $ '|A1_COD|A1_LOJA|A2_COD|A2_LOJA|' )
                // Tratamento específico para campos De/Até (From/To)

                // Tratamento do campo De (From)
                
                cQuery += '         SUM(CASE WHEN CKK.CKK_CHAVE = ? THEN 1 ELSE 0 END) AS ?, '
                cQuery += '         SUM(CASE WHEN CKK.CKK_CHAVE = ? AND TRIM(CKK.CKK_VALOR) <= ? THEN 1 ELSE 0 END) AS ?, '

                aadd(aBind,{'C',cField + '_FR'})
                aadd(aBind,{'U','TOT_' + cField + '_FR'})
                aadd(aBind,{'C',cField + '_FR'})
                aadd(aBind,{'U',self:cTable + '.' + cField})
                aadd(aBind,{'U','OK_' + cField + '_FR'})

                // Tratamento do campo Até (To)
                cQuery += '         SUM(CASE WHEN CKK.CKK_CHAVE = ? THEN 1 ELSE 0 END) AS ?, '
                cQuery += '         SUM(CASE WHEN CKK.CKK_CHAVE = ? AND TRIM(CKK.CKK_VALOR) >= ? THEN 1 ELSE 0 END) AS ?'

                aadd(aBind,{'C',cField + '_TO'})
                aadd(aBind,{'U','TOT_' + cField + '_TO'})
                aadd(aBind,{'C',cField + '_TO'})
                aadd(aBind,{'U',self:cTable + '.' + cField})
                aadd(aBind,{'U','OK_' + cField + '_TO'})

            elseif ( '|' + cField + '|' $ '|A1_COD_MUN|A2_COD_MUN|' )
                // Tratamento específico para campos de Código de Município, que estão gravados como por exemplo: 'SP-47809'
                cStateField := 'A1_EST'
                if ( cField == 'A2_COD_MUN' )
                    cStateField := 'A2_EST'
                endif

                cQuery += '         SUM(CASE WHEN CKK.CKK_CHAVE = ? THEN 1 ELSE 0 END) AS ?, '
                cQuery += '         SUM(CASE WHEN CKK.CKK_CHAVE = ? AND TRIM(CKK.CKK_VALOR) = ? ? ? ? ? THEN 1 ELSE 0 END) AS ?'

                aadd(aBind,{'C',cField})
                aadd(aBind,{'U','TOT_' + cField})
                aadd(aBind,{'C',cField})
                aadd(aBind,{'U',self:cTable + '.' + cStateField})
                aadd(aBind,{'U',cConcat})
                aadd(aBind,{'C','-'})
                aadd(aBind,{'U',cConcat})
                aadd(aBind,{'U',self:cTable + '.' + cField})
                aadd(aBind,{'U','OK_' + cField})

            else
                // Campos de igualdade, ou seja, o valor do campo da tabela, exemplo SA1, será igual ao conteúdo do mesmo campo no filtro
                cQuery += '         SUM(CASE WHEN CKK.CKK_CHAVE = ? THEN 1 ELSE 0 END) AS ?, '
                cQuery += '         SUM(CASE WHEN CKK.CKK_CHAVE = ? AND TRIM(CKK.CKK_VALOR) = ? THEN 1 ELSE 0 END) AS ?'

                aadd(aBind,{'C',cField})
                aadd(aBind,{'U','TOT_' + cField})
                aadd(aBind,{'C',cField})
                aadd(aBind,{'U',self:cTable + '.' + cField})
                aadd(aBind,{'U','OK_' + cField})

            endif

            if ( nI < nLength )
                cQuery += ', '
            endif
        next nI

        cQuery += '     FROM ' + retSqlName('CKK') + ' CKK '
        cQuery += '         INNER JOIN ' + retSqlName('CKJ') + ' CKJ '
        cQuery += '             ON CKJ.CKJ_FILIAL = ? '
        cQuery += '             AND CKJ.CKJ_ID = CKK.CKK_IDFILT '
        cQuery += '             AND CKJ.CKJ_TIPO = ? '
        cQuery += '             AND CKJ.D_E_L_E_T_ = ? '

        aadd(aBind,{'C',fwxFilial('CKJ')})
        aadd(aBind,{'C',self:cTypeCode})
        aadd(aBind,{'C',' '})        

        if ( self:cType == TYPE_SUPPLIER )
            cQuery += '         INNER JOIN ' + retSqlName('SA2') + ' SA2 '
            cQuery += '             ON SA2.A2_FILIAL = ? '
            cQuery += '             AND SA2.A2_COD = ? '
            cQuery += '             AND SA2.A2_LOJA = ? '
            cQuery += '             AND SA2.D_E_L_E_T_ = ? '

            aadd(aBind,{'C',fwxFilial('SA2')})
            aadd(aBind,{'C',self:jData['A2_COD']})
            aadd(aBind,{'C',self:jData['A2_LOJA']}) 
            aadd(aBind,{'C',' '})           
        elseif ( self:cType == TYPE_CUSTOMER )
            cQuery += '         INNER JOIN ' + retSqlName('SA1') + ' SA1 '
            cQuery += '             ON SA1.A1_FILIAL = ? '
            cQuery += '             AND SA1.A1_COD = ? '
            cQuery += '             AND SA1.A1_LOJA = ? '
            cQuery += '             AND SA1.D_E_L_E_T_ = ? '

            aadd(aBind,{'C',fwxFilial('SA1')})
            aadd(aBind,{'C',self:jData['A1_COD']})
            aadd(aBind,{'C',self:jData['A1_LOJA']})
            aadd(aBind,{'C',' '})
        endif

        cQuery += '     WHERE CKK.CKK_FILIAL = ? '
        cQuery += '         AND CKK.D_E_L_E_T_ = ? '
        cQuery += '     GROUP BY CKJ.CKJ_CODIGO '
        cQuery += ' ) '

        aadd(aBind,{'C',fwxFilial('CKK')})
        aadd(aBind,{'C',' '})

        cQuery += ' SELECT CKJ_CODIGO COD_PERFIL '
        cQuery += ' FROM PROF_OPT '
        cQuery += ' WHERE '

        for nI := 1 to nLength
            cField := self:aFields[nI][2]

            if ( nI > 1 )
                cQuery += 'AND'
            endif

            if ( '|' + cField + '|' $ '|A1_COD|A1_LOJA|A2_COD|A2_LOJA|' )
                cQuery += ' (? = ? OR (? > 0 AND ? <= ?)) '
                
                aadd(aBind,{'U','OK_' + cField + '_FR'})
                aadd(aBind,{'U','TOT_' + cField + '_FR'})
                aadd(aBind,{'U','OK_' + cField + '_FR'})
                aadd(aBind,{'U','OK_' + cField + '_FR'})
                aadd(aBind,{'U','TOT_' + cField + '_FR'})

                cQuery += 'AND (? = ? OR (? > 0 AND ? <= ?)) '

                aadd(aBind,{'U','OK_' + cField + '_TO'})
                aadd(aBind,{'U','TOT_' + cField + '_TO'})
                aadd(aBind,{'U','OK_' + cField + '_TO'})
                aadd(aBind,{'U','OK_' + cField + '_TO'})
                aadd(aBind,{'U','TOT_' + cField + '_TO'})
            else
                cQuery += ' (? = ? OR (? > 0 AND ? <= ?)) '

                aadd(aBind,{'U','OK_' + cField})
                aadd(aBind,{'U','TOT_' + cField})
                aadd(aBind,{'U','OK_' + cField})
                aadd(aBind,{'U','OK_' + cField})
                aadd(aBind,{'U','TOT_' + cField})
            endif
        next nI        

    elseif ( self:cType $ TYPE_SUPPLIER+'|'+TYPE_CUSTOMER )

        cQuery += ' SELECT F22.F22_CODIGO COD_PERFIL '
        cQuery += ' FROM ' + retSqlName('F22') + ' F22 '
        cQuery += '     INNER JOIN ' + retSqlName('F20') + ' F20 '
        cQuery += '         ON F20.F20_FILIAL = ? '
        cQuery += '         AND F20.F20_CODIGO = F22.F22_CODIGO '
        cQuery += '         AND F20.F20_TIPO = F22.F22_TIPOPF '
        cQuery += '         AND F20.D_E_L_E_T_ = ? '
        cQuery += ' WHERE F22.F22_FILIAL = ? '
        cQuery += '     AND F22.F22_CLIFOR = ? '
        cQuery += '     AND F22.F22_LOJA = ? '
        cQuery += '     AND F22.F22_TPPART = ? '
        cQuery += '     AND F22.F22_TIPOPF = ? '
        cQuery += '     AND F22.F22_STATUS = ? '
        cQuery += '     AND F22.D_E_L_E_T_ = ? '

        aadd(aBind,{'C',fwxFilial('F20')})
        aadd(aBind,{'C',' '})
        aadd(aBind,{'C',fwxFilial('F22')})

        if ( self:cType == TYPE_SUPPLIER )
            aadd(aBind,{'C',self:jData['A2_COD']})
            aadd(aBind,{'C',self:jData['A2_LOJA']})
        else
            aadd(aBind,{'C',self:jData['A1_COD']})
            aadd(aBind,{'C',self:jData['A1_LOJA']})
        endif

        aadd(aBind,{'C',self:cTypeCode})
        aadd(aBind,{'C',self:cProfileTypeCode})
        aadd(aBind,{'C',getParStCode('AUTOMATIZADO')})
        aadd(aBind,{'C',' '})

    endif

return cQuery

/*/{Protheus.doc} ProfileOptimizer::getQueryProduct
Método responsável por retornar a query SQL para localizar os perfis.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 24/09/2025
@param aBind, array, Array com os valores a serem vinculados.
@param lQueryInsert, logical, Indica se a query é de inserção.
@return character, Retorna a query SQL gerada.
/*/
method getQueryProduct(aBind as array, lQueryInsert as logical) as character class ProfileOptimizer

    local cQuery as character
    local nI as numeric
    local nLength as numeric
    local cAlias as character
    local cField as character
    
    if ( lQueryInsert )
        nLength := len(self:aFields)

        cQuery += ' WITH REGRAS AS ( '
        cQuery +=   ' SELECT '
        cQuery +=       ' CKJ.CKJ_CODIGO, '
        cQuery +=       ' CKK.CKK_CHAVE, '
        cQuery +=       ' MAX( '
        cQuery +=           ' CASE '

        for nI := 1 to nLength
            cAlias := self:aFields[nI][1]
            cField := self:aFields[nI][2]

            if cField == "B1_COD"
                cQuery +=           ' WHEN CKK.CKK_CHAVE = ? AND TRIM(CKK.CKK_VALOR) >= ? THEN 1 '

                aadd(aBind,{'C',cField + '_TO'})
                aadd(aBind,{'U',cAlias + '.' + cField})

                cQuery +=           ' WHEN CKK.CKK_CHAVE = ? AND TRIM(CKK.CKK_VALOR) <= ? THEN 1 '

                aadd(aBind,{'C',cField + '_FR'})
                aadd(aBind,{'U',cAlias + '.' + cField})
            else
                cQuery +=           ' WHEN CKK.CKK_CHAVE = ? AND TRIM(CKK.CKK_VALOR) = ? THEN 1 '
                aadd(aBind,{'C',cField})
                aadd(aBind,{'U',cAlias + '.' + cField})
            endIf
        next nI

        cQuery +=           ' ELSE 0 '
        cQuery +=           ' END '
        cQuery +=       ' ) AS MATCH_OK '
    
        cQuery += ' FROM ' + retSqlName('CKK') + ' CKK '
        cQuery += ' INNER JOIN ' + retSqlName('CKJ') + ' CKJ '
        cQuery +=   ' ON CKJ.CKJ_FILIAL = ? '
        cQuery +=   ' AND CKJ.CKJ_ID = CKK.CKK_IDFILT '
        cQuery +=   ' AND CKJ.CKJ_TIPO = ? '
        cQuery +=   ' AND CKJ.D_E_L_E_T_ = ? '

        aadd(aBind,{'C',fwxFilial('CKJ')})
        aadd(aBind,{'C',self:cTypeCode})
        aadd(aBind,{'C',' '})        

        cQuery += ' INNER JOIN ' + retSqlName('SB1') + ' SB1 '
        cQuery += ' ON SB1.B1_FILIAL = ? '
        cQuery +=   ' AND SB1.B1_COD = ? '
        cQuery +=   ' AND SB1.D_E_L_E_T_ = ? '

        aadd(aBind,{'C',fwxFilial('SB1')})
        aadd(aBind,{'C',self:jData['B1_COD']})
        aadd(aBind,{'C',' '})

        cQuery += ' LEFT JOIN ' + retSqlName('SB5') + ' SB5 '
        cQuery += ' ON SB5.B5_FILIAL = ? '
        cQuery +=   ' AND SB5.B5_COD = ? '
        cQuery +=   ' AND SB5.D_E_L_E_T_ = ? '

        aadd(aBind,{'C',fwxFilial('SB5')})
        aadd(aBind,{'C',self:jData['B1_COD']})
        aadd(aBind,{'C',' '})

        if self:lArqProd
            cQuery += ' LEFT JOIN ' + retSqlName('SBZ') + ' SBZ '
            cQuery += ' ON SBZ.BZ_FILIAL = ? '
            cQuery +=   ' AND SBZ.BZ_COD = ? '
            cQuery +=   ' AND SBZ.D_E_L_E_T_ = ? '

            aadd(aBind,{'C',fwxFilial('SBZ')})
            aadd(aBind,{'C',self:jData['B1_COD']})
            aadd(aBind,{'C',' '})
        endIf

        cQuery += ' WHERE CKK.CKK_FILIAL = ? '
        cQuery +=   ' AND CKK.D_E_L_E_T_ = ? '
        cQuery += ' GROUP BY CKJ.CKJ_CODIGO, CKK.CKK_CHAVE '
        cQuery += ' ), '

        aadd(aBind,{'C',fwxFilial('CKK')})
        aadd(aBind,{'C',' '})

        cQuery += ' RESUMO AS ( '
        cQuery +=   ' SELECT CKJ_CODIGO, COUNT(*) TOTAL_CHAVES, SUM(MATCH_OK) TOTAL_OK '
        cQuery +=   ' FROM REGRAS '
        cQuery +=   ' GROUP BY CKJ_CODIGO '
        cQuery += ' ) '
        cQuery += ' SELECT CKJ_CODIGO COD_PERFIL '
        cQuery += ' FROM RESUMO '
        cQuery += ' WHERE TOTAL_OK = TOTAL_CHAVES '

    elseif ( self:cType == TYPE_PRODUCT )
        cQuery += self:getQueryProfileProduct(@aBind)
    endif

return cQuery

/*/{Protheus.doc} ProfileOptimizer:getQueryProfileProduct()
Método responsável por retornar a query SQL para localizar os perfis tributario de produto
@type method
@version 12.1.2510
@author Matheus Bispo
@since 24/09/2025
@param aBind, array, Array com os valores a serem vinculados.
@return cQuery, character, Retorna a query SQL gerada.
/*/
method getQueryProfileProduct(aBind as array) as character class ProfileOptimizer
    local cQuery := "" as character

    cQuery += ' SELECT F24.F24_CODIGO COD_PERFIL '
    cQuery += ' FROM ' + retSqlName('F24') + ' F24 '
    cQuery += '     INNER JOIN ' + retSqlName('F20') + ' F20 '
    cQuery += '         ON F20.F20_FILIAL = ? '
    cQuery += '         AND F20.F20_CODIGO = F24.F24_CODIGO '
    cQuery += '         AND F20.F20_TIPO = F24.F24_TIPOPF '
    cQuery += '         AND F20.D_E_L_E_T_ = ? '
    cQuery += ' WHERE F24.F24_FILIAL = ? '
    cQuery += '     AND F24.F24_CDPROD = ? '
    cQuery += '     AND F24.F24_TIPOPF = ? '
    cQuery += '     AND F24.F24_STATUS = ? '
    cQuery += '     AND F24.D_E_L_E_T_ = ? '

    aadd(aBind,{'C',fwxFilial('F20')})
    aadd(aBind,{'C',' '})

    aadd(aBind,{'C',fwxFilial('F24')})
    aadd(aBind,{'C',self:jData['B1_COD']})
    aadd(aBind,{'C',self:cProfileTypeCode})
    aadd(aBind,{'C',getParStCode('AUTOMATIZADO')})
    aadd(aBind,{'C',' '})

return cQuery

/*/{Protheus.doc} ProfileOptimizer::updateProfiles
Método responsável por executar a inclusão e exclusão dos participantes ou produtos nos perfis localizados.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 24/09/2025
/*/
method updateProfiles() class ProfileOptimizer
    local oModel := fwLoadModel(self:cModel) as object
    local oSubModel := nil as object
    local jFieldsModel := nil as json
    local nLength := len(self:jProfiles['profiles']) as numeric
    local nLengthFields := 0 as numeric
    local nI := 0 as numeric
    local nJ := 0 as numeric
    local aSeek := {} as array
    local aSeekAll := {} as array
    local cStatus := getParStCode('AUTOMATIZADO') as character
    local lUpdate := .F. as logical

    if ( self:cType == TYPE_SUPPLIER )
        jFieldsModel := self:getParticipantModelFields("A2")
    elseif ( self:cType == TYPE_CUSTOMER )
        jFieldsModel := self:getParticipantModelFields("A1")
    elseif ( self:cType == TYPE_PRODUCT )
        jFieldsModel := self:getProductModelFields()
    endif

    aSeekAll := jFieldsModel['seekAll']

    dbSelectArea('F20')
    F20->(dbSetOrder(1)) // F20_FILIAL+F20_CODIGO+F20_TIPO

    for nI := 1 to nLength
        jProfile := self:jProfiles['profiles'][nI]

        if ( F20->(dbSeek( fwxFilial('F20') + jProfile['code'] + self:cProfileTypeCode)) )
            lUpdate := .F.
            oModel:setOperation(MODEL_OPERATION_UPDATE)
            oModel:activate()

            oSubModel := oModel:getModel(self:cSubModel)

            aSeek := jFieldsModel['fields']
            nLengthFields := len(aSeek)

            if ( jProfile['action'] == 'insert' )

                if ( !oSubModel:seekLine(aSeekAll) )
                    if ( !oSubModel:seekLine(aSeek) )
                        lUpdate := .T.
                        oSubModel:addLine()

                        for nJ := 1 to nLengthFields
                            oSubModel:setValue(aSeek[nJ][1], aSeek[nJ][2])
                        next nJ

                        oSubModel:setValue(jFieldsModel['status'], cStatus)
                    endif
                endif

            elseif ( jProfile['action'] == 'delete' )

                if oSubModel:seekLine(aSeek)
                    lUpdate := .T.
                    oSubModel:deleteLine()
                endif                

            endif

            if ( lUpdate .and. oModel:vldData() )
                oModel:commitData()
            endif

            oModel:deActivate()            
        endif
    next nI

    fwFreeArray(aSeek)
    fwFreeArray(aSeekAll)
    fwFreeArray(jFieldsModel['fields'])
    fwFreeArray(jFieldsModel['seekAll'])
    fwFreeObj(jFieldsModel)
    jFieldsModel := nil

    F20->(dbCloseArea())

    oModel:destroy()
    oModel := nil       
return

/*/{Protheus.doc} ProfileOptimizer::changeBranch
Método para alterar a filial do sistema.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 19/11/2025
@param cNewBranchCode, character, Código da filial para ser definido
@return character, Código da filial
/*/
method changeBranch(cNewBranchCode as character) as character class ProfileOptimizer
    
    if ( valType(cNewBranchCode) == 'C' .and. !empty(cNewBranchCode) )
        self:cBackupBranchCode := cFilAnt
        cFilAnt := cNewBranchCode
    endif

return cFilAnt

/*/{Protheus.doc} ProfileOptimizer::restoreBranch
Método para restaurar a filial original logada.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 19/11/2025
@return character, Código da filial
/*/
method restoreBranch() as character class ProfileOptimizer

    if ( valType(self:cBackupBranchCode) == 'C' .and. !empty(self:cBackupBranchCode) )
        cFilAnt := self:cBackupBranchCode
        self:cBackupBranchCode := ''
    endif

return cFilAnt

/*/{Protheus.doc} ProfileOptimizer::destroy
Método destrutor da classe ProfileOptimizer.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 24/09/2025
/*/
method destroy() class ProfileOptimizer

    fwFreeArray(self:aFields)
    fwFreeObj(self:jData)
    self:jData := nil
    fwFreeArray(self:jProfiles['profiles'])
    fwFreeObj(self:jProfiles)
    self:jProfiles := nil

return

/*/{Protheus.doc} ProfileOptimizerMVC
Classe responsável pelo Otimizador de Perfis de Participantes e Produtos, que tem como objetivo 
armazenar os métodos em comum utilizados em ambos os perfis.
@type class
@version 12.1.2510
@author Matheus Bispo
@since 
/*/
class ProfileOptimizerMVC
    private data oModel as object
    private data cModel as character
    private data cSubModel as character
    private data cFiltersModel as character
    private data cFilterItemsModel as character
    private data cFieldStatus as character
    private data cFieldLegend as character
    private data cTypeProfile as character
    private data cTable as character
    private data lArqProd as logical

    public method new() constructor

    public method setDefaultModel(oModel as object)
    public method getArqProp() as logical

    public method addCmpLegend(oObject as object, lModel as logical)
    public method showLegend()
    public method addLegend(cStatusLine as character) as character
    
    public method updAllStatus() as logical
    public method updLineStatus(oSubModel as object) as character

    private method getFilters(cProfileType as character) as array
    private method isInFilter(aFilters as array, cProfileType as character, cCusSupCode as character, cCusSupStore as character, cCodProduct as character) as logical
    private method getPartQuery(cPartType as character, aBind as array, cCusSupCode as character, cCusSupStore as character, cCodProduct as character) as character
    private method updProfStatus(lManSemFil as logical, lAutomatiz as logical, lManEmConf as logical, lManFoConf as logical) as character

endClass

/*/{Protheus.doc} ProfileOptimizerMVC:new()
    Método construtor da classe ProfileOptimizerMVC.
    @type method
    @author Matheus Bispo
    @since 25/08/2025
    @param oModel, object, Modelo do Perfil de Participantes ou Produto
    @param cModel, character, Nome do modelo do Perfil de Participantes ou Produto
    @param cSubModel, character, Nome do modelo dos itens do Perfil de Participantes ou Produto
    @param cFiltersModel, character, Nome do modelo dos filtros
    @param cFilterItemsModel, character, Nome do modelo dos ítens do filtro
    @param cFieldStatus, character, Campo de Status
    @param cFieldLegend, character, Campo de Legenda
    @param cTypeProfile, character, Tipo de Perfil
    @version 12.1.2410
/*/
method new(oModel as object, cModel as character, cSubModel as character, cFiltersModel as character, cFilterItemsModel as character, cFieldStatus as character, cFieldLegend as character, cTypeProfile as character) class ProfileOptimizerMVC
    self:oModel := oModel
    self:cModel := cModel
    self:cSubModel := cSubModel
    self:cFiltersModel := cFiltersModel
    self:cFilterItemsModel := cFilterItemsModel
    self:cFieldStatus := cFieldStatus
    self:cFieldLegend := cFieldLegend
    self:cTypeProfile := cTypeProfile
    self:lArqProd := getMV("MV_ARQPROD", .F., "") == "SBZ"
    self:cTable := ""
return self

/*/{Protheus.doc} ProfileOptimizerMVC:setDefaultModel()
    Metodo construtor da classe ProfileOptimizerMVC.
    @type  method
    @param oModel, object, o objeto do modelo
    @return nil
    @author Matheus Bispo
    @since 07/10/2025
    @version 12.1.2410

/*/
method setDefaultModel(oModel as object) class ProfileOptimizerMVC
    self:oModel := oModel
return

/*/{Protheus.doc} ProfileOptimizerMVC:getArqProp()
    retorna o conteúdo do parâmetro MV_ARQPROD.
    @type  method
    @param nil, nil, nil
    @return logical, indica se o parâmetro está configurado para SBZ
    @author Matheus Bispo
    @since 07/10/2025
    @version 12.1.2410

/*/
method getArqProp() class ProfileOptimizerMVC
return getMV("MV_ARQPROD", .F., "") == "SBZ"

/*/{Protheus.doc} ProfileOptimizerMVC:addCmpLegend()
    Adiciona a legenda ao campo
    @type  method
    @author Rafael Oliveira
    @since 25/08/2025
    @version 12.1.2410
    @param oObject, object, o objeto a ser modificado
    @param lModel, logical, indica se o objeto é um modelo
    @param cCampo, character, campo que será considerado
    @return nil
    @see (links_or_references)
/*/
method addCmpLegend(oObject as object, lModel as logical) class ProfileOptimizerMVC
    If lModel
        oObject:addField(       ;   // Ord. Tipo    Desc.
            allTrim(''),        ;   // [01] C       Titulo do campo
            allTrim(''),        ;   // [02] C       ToolTip do campo
            self:cFieldLegend,  ;   // [03] C       identificador (ID) do Field
            'C',                ;   // [04] C       Tipo do campo
            50,                 ;   // [05] N       Tamanho do campo
            0,                  ;   // [06] N       Decimal do campo
            Nil,                ;   // [07] B       Code-block de validação do campo
            Nil,                ;   // [08] B       Code-block de validação When do campo
            Nil,                ;   // [09] A       Lista de valores permitido do campo
            Nil,                ;   // [10] L       Indica se o campo tem preenchimento obrigatório
            {|| self != nil .and. self:addLegend()},; // [11] B       Code-block de inicializacao do campo
            Nil,                ;   // [12] L       Indica se trata de um campo chave
            Nil,                ;   // [13] L       Indica se o campo pode receber valor em uma operação de update.
            .T.                 )   // [14] L       Indica se o campo é virtual 
    Else
        oObject:addField(       ;   // Ord. Tipo    Desc.
            self:cFieldLegend,  ;   // [01] C       Nome do Campo
            '00',               ;   // [02] C       Ordem
            allTrim(''),        ;   // [03] C       Titulo do campo
            allTrim(''),        ;   // [04] C       Descricao do campo
            {'Legenda'},        ;   // [05] A       Array com Help
            'C',                ;   // [06] C       Tipo do campo
            '@BMP',             ;   // [07] C       Picture
            Nil,                ;   // [08] B       Bloco de Picture Var
            '',                 ;   // [09] C       Consulta F3
            .F.,                ;   // [10] L       Indica se o campo é alteravel
            Nil,                ;   // [11] C       Pasta do campo
            Nil,                ;   // [12] C       Agrupamento do campo
            Nil,                ;   // [13] A       Lista de valores permitido do campo (Combo)
            Nil,                ;   // [14] N       Tamanho maximo da maior opção do combo
            Nil,                ;   // [15] C       Inicializador de Browse
            .T.,                ;   // [16] L       Indica se o campo é virtual
            Nil,                ;   // [17] C       Picture Variavel
            Nil                 )   // [18] L       Indica pulo de linha após o campo 
    EndIf
return

/*/{Protheus.doc} ProfileOptimizerMVC:addLegend()
    Adiciona a legenda ao campo
    @type  method
    @author Rafael Oliveira
    @since 25/08/2025
    @version 12.1.2410
    @param cStatusLine, character, status do perfil
    @return cLegenda, character, a legenda do campo    
/*/
method addLegend(cStatusLine as character) as character class ProfileOptimizerMVC
    local cStatus := cStatusLine as character
    local cLegenda := "" as character
    
    if empty(cStatus)
        if self:cTypeProfile == PROFILE_PARTICIPANT
            cStatus := F22->F22_STATUS
        elseIf self:cTypeProfile == PROFILE_PRODUCT
            cStatus := F24->F24_STATUS
        endIF
    endIf

    if Empty(cStatus) .Or. cStatus == MANUAL
        cLegenda := "BR_CINZA"
    elseIf cStatus == AUTOMATIZADO
        cLegenda := "BR_AZUL"
    elseIf cStatus == MANUAL_EM_CONFORMIDADE
        cLegenda := "BR_VERDE"
    elseIf cStatus == MANUAL_FORA_CONFORMIDADE
        cLegenda := "BR_VERMELHO"
    endIF
return cLegenda

/*/{Protheus.doc} ProfileOptimizerMVC:showLegend()
Função que exibe a legenda do perfil de participante.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 24/09/2025
/*/
method showLegend() class ProfileOptimizerMVC
    local aLegend := {} as array
    local cTitle := "" as character

    aadd(aLegend,{'BR_CINZA',STR0003})    // 'Manual'
    aadd(aLegend,{'BR_AZUL',STR0004})     // 'Automatizado'
    aadd(aLegend,{'BR_VERDE',STR0005})    // 'Manual (em conformidade com o filtro)'
    aadd(aLegend,{'BR_VERMELHO',STR0006}) // 'Manual (fora de conformidade com o filtro)'

    if self:cTypeProfile == PROFILE_PARTICIPANT
        cTitle := STR0001
    elseIf self:cTypeProfile == PROFILE_PRODUCT
        cTitle := STR0002
    endIF

    brwLegenda(cTitle,STR0007,aLegend) // 'Cadastro de Perfil Tributário de Produto' 'Legenda'
return

/*/{Protheus.doc} ProfileOptimizerMVC:updAllStatus()
Função que atualiza o status do perfil de participante e de cada linha do grid.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 24/09/2025
@param nil, nil, nil
@return logical, true
/*/
method updAllStatus() as logical class ProfileOptimizerMVC
    local oSubModel := self:oModel:getModel(self:cSubModel) as object
    local nOperation := self:oModel:GetOperation() as numeric
    local nLine := oSubModel:getLine() as numeric
    local nI := 0 as numeric
    local cStatus := '' as character
    local lEmpty := .F. as logical
    local lManSemFil := .F. as logical // Manual sem filtro
    local lAutomatiz := .F. as logical  // Automatizado
    local lManEmConf := .F. as logical  // Manual Em Conformidade
    local lManFoConf := .F. as logical  // Manuel Fora de Conformidade
    local cAllManualStatus := MANUAL + '|' +  MANUAL_EM_CONFORMIDADE + '|' + MANUAL_FORA_CONFORMIDADE as character

    if self:cTypeProfile == PROFILE_PARTICIPANT
        lEmpty := empty(oSubModel:getValue('F22_CLIFOR')) .and. empty(oSubModel:getValue('F22_LOJA'))
    elseIf self:cTypeProfile == PROFILE_PRODUCT
        lEmpty := empty(oSubModel:getValue('F24_CDPROD'))
    endIF

    If ( (nOperation == MODEL_OPERATION_INSERT .or. nOperation == MODEL_OPERATION_UPDATE) .and. !lEmpty )
        For nI := 1 to oSubModel:Length()
            oSubModel:goLine(nI)

            If ( !oSubModel:isDeleted() )
                cStatus := oSubModel:getValue(self:cFieldStatus)

                If ( Empty(cStatus) .or. cStatus $ cAllManualStatus .or. (cStatus != AUTOMATIZADO .and. nI == nLine) )
                    cStatus := self:updLineStatus(oSubModel)
                EndIf

                Do Case
                    Case ( cStatus == MANUAL )
                        lManSemFil := .T.
                    Case ( cStatus == AUTOMATIZADO )
                        lAutomatiz := .T.
                    Case ( cStatus == MANUAL_EM_CONFORMIDADE )
                        lManEmConf := .T.
                    Case ( cStatus == MANUAL_FORA_CONFORMIDADE )
                        lManFoConf := .T.
                EndCase
            EndIf
        Next nI

        oSubModel:goLine(nLine)

        self:updProfStatus(lManSemFil, lAutomatiz, lManEmConf, lManFoConf)
    EndIf

Return .T.

/*/{Protheus.doc} ProfileOptimizerMVC:updLineStatus()
Função que atualiza o status de uma linha do grid.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 24/09/2025
@param oSubModel, object, Subodelo que contém os dados
@return character, Status da linha
/*/
method updLineStatus(oSubModel as object) as character class ProfileOptimizerMVC

    local cProfileType := '' as character
    local cCusSupCode := '' as character
    local cCusSupStore := '' as character
    local cProductCode := '' as character
    local cStatus := MANUAL as character
    local aFilters := {} as array
    local lHasFilter := .F. as logical
    local lOk as logical

    if self:cTypeProfile == PROFILE_PARTICIPANT
        cProfileType := oSubModel:getValue('F22_TPPART')
        cCusSupCode := oSubModel:getValue('F22_CLIFOR')
        cCusSupStore := oSubModel:getValue('F22_LOJA')
        lOk := !empty(cProfileType) .and. !empty(cCusSupCode) .and. !empty(cCusSupStore)
    elseif self:cTypeProfile == PROFILE_PRODUCT
        cProfileType := PRODUCT
        cProductCode := oSubModel:getValue('F24_CDPROD')
        lOk := !empty(cProfileType) .and. !empty(cProductCode)
    endif

    if ( lOk )
        aFilters := self:getFilters(cProfileType)
        lHasFilter := len(aFilters) > 0

        if ( lHasFilter )
            cStatus := MANUAL_FORA_CONFORMIDADE

            if ( self:isInFilter(aFilters, cProfileType, cCusSupCode, cCusSupStore, cProductCode) )
                cStatus := MANUAL_EM_CONFORMIDADE
            endif
        endif

        oSubModel:setValue(self:cFieldStatus, cStatus)
        oSubModel:setValue(self:cFieldLegend, self:addLegend(cStatus))
    endif

    fwFreeArray(aFilters)

return cStatus

/*/{Protheus.doc} ProfileOptimizerMVC:getFilters()
Função que retorna o array com os filtros do perfil.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 30/10/2025
@param cProfileType, character, Tipo do perfil
@return array, Alias com os filtros do perfil
/*/
method getFilters(cProfileType as character) as array class ProfileOptimizerMVC

    local oFiltersModel := self:oModel:getModel(self:cFiltersModel) as object
    local oFilterItemsModel as object
    local aSeek as array
    local nI as numeric
    local aFilters := {} as array

    aSeek := array(1)
    aSeek[1] := {'CKJ_TIPO',cProfileType}

    if ( oFiltersModel:seekLine(aSeek) )
        oFilterItemsModel := self:oModel:getModel(self:cFilterItemsModel)

        for nI := 1 to oFilterItemsModel:length()
            oFilterItemsModel:goLine(nI)

            if !oFilterItemsModel:isDeleted()
                aadd(aFilters, {allTrim(oFilterItemsModel:getValue('CKK_CHAVE')), allTrim(oFilterItemsModel:getValue('CKK_VALOR'))})
            endif
        next nI        
    endif

    asort(aFilters,,,{|x,y| x[1] < y[1]}) // Ordena o array pela Chave (Key)

    fwFreeArray(aSeek)

return aFilters

/*/{Protheus.doc} ProfileOptimizerMVC:isInFilter()
Função que verifica se o cliente ou fornecedor ou produto está dentro do filtro do perfil.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 30/10/2025
@param aFilters, character, Array com os filtros do perfil
@param cPartType, character, Tipo do perfil
@param cCusSupCode, character, Código do cliente ou fornecedor
@param cCusSupStore, character, Loja do cliente ou fornecedor
@param cProductCode, character, Código do produto
@return logical, Retorno da verificação
/*/
method isInFilter(aFilters as array, cProfileType as character, cCusSupCode as character, cCusSupStore as character, cProductCode as character) as logical class ProfileOptimizerMVC

    local aBind := {} as array
    local aValues := {} as array
    local nI := 1 as numeric
    local cQuery := self:getPartQuery(cProfileType,@aBind,cCusSupCode,cCusSupStore,cProductCode) as character
    local cKey := '' as character
    local lIsInFilter := .F. as logical
    local oQryProfileFilters as object
    local nPosKey := 1 as numeric
    local nPosValue := 2 as numeric
    local nLength := Len(aFilters) as numeric
    local jKeysFromTo as json
    local aKeys := {} as array
    local cCitiesFilter as character
    local cOr as character
    local cAuxiliaryField as character
    local cStateCode as character
    local cCityCode as character    
    local lIsSupplier as logical
    local lContinue as logical

    jKeysFromTo := {;
        'A1_COD_FR': 'A1_COD >',;
        'A1_COD_TO': 'A1_COD <',;
        'A1_LOJA_FR': 'A1_LOJA >',;
        'A1_LOJA_TO': 'A1_LOJA <',;
        'A2_COD_FR': 'A2_COD >',;
        'A2_COD_TO': 'A2_COD <',;
        'A2_LOJA_FR': 'A2_LOJA >',;
        'A2_LOJA_TO': 'A2_LOJA <',;
        'B1_COD_FR': 'B1_COD >',;
        'B1_COD_TO': 'B1_COD <';
    }
    
    // Adiciona na query base da SA1, SA2 ou SB1 os campos contidos no filtro do Perfil de Participante e Produto
    while nI <= nLength
        cKey := aFilters[nI][nPosKey]
        aValues := {}

        while nI <= nLength .and. cKey == aFilters[nI][nPosKey]
            if ( ( cKey == 'A1_COD_MUN' .or. cKey == 'A2_COD_MUN' ) .and. ( '-' $ aFilters[nI][nPosValue] ) )
                lIsSupplier := (cKey == 'A2_COD_MUN')

                aKeys := strTokArr2(aFilters[nI][nPosValue],'-')

                if ( len(aKeys) == 2 )
                    cStateCode := aKeys[1]
                    cCityCode := aKeys[2]
                    
                    cAuxiliaryField := 'A1_EST'
                    if ( lIsSupplier )
                        cAuxiliaryField := 'A2_EST'
                    endif

                    cCitiesFilter += cOr + '( ? = ? AND ? = ? )'
                    aadd(aBind, {'U',cAuxiliaryField})
                    aadd(aBind, {'C',cStateCode})

                    aadd(aBind, {'U',cKey})
                    aadd(aBind, {'C',cCityCode})

                    cOr := ' OR '
                endif

                lContinue := .F.
            else
                aadd(aValues, aFilters[nI][nPosValue])
                lContinue := .T.
            endif

            nI++
        enddo

        if ( !empty(cCitiesFilter) )
            cQuery += ' AND ( ' + cCitiesFilter + ' ) '
            cCitiesFilter := ''
            cOr := ''
        endif
        
        if ( lContinue )
            if ( jKeysFromTo:hasProperty(cKey) )
                cQuery += '     AND ?'
                aadd(aBind, {'U',jKeysFromTo[cKey]})
            else
                cQuery += '     AND ? '
                aadd(aBind, {'U',cKey})
            endif

            if ( len(aValues) > 1 )
                cQuery += 'IN ( ? ) '
                aadd(aBind, {'A',aValues})
            else
                cQuery += '= ? '
                aadd(aBind, {'C',aValues[1]})
            endif
        endif
    enddo

    cQuery += '     AND ? = ? '
    aadd(aBind, {'U', self:cTable + ".D_E_L_E_T_"})
    aadd(aBind, {'C',' '})

    oQryProfileFilters := fwExecStatement():new(cQuery)

    for nI := 1 to len(aBind)
        do case
            case ( aBind[nI][1] == 'A' )
                oQryProfileFilters:setIn(nI,aBind[nI][2])
            case ( aBind[nI][1] == 'C' )
                oQryProfileFilters:setString(nI,aBind[nI][2])
            case ( aBind[nI][1] == 'U' )
                oQryProfileFilters:setUnsafe(nI,aBind[nI][2])
        endcase
    next nI

    lIsInFilter := !empty(oQryProfileFilters:execScalar('COD'))

    fwFreeObj(jKeysFromTo)
    fwFreeArray(aBind)
    fwFreeArray(aValues)
    fwFreeArray(aKeys)

    oQryProfileFilters:destroy()
    fwFreeObj(oQryProfileFilters)

return lIsInFilter

/*/{Protheus.doc} ProfileOptimizerMVC:getPartQuery()
Função que retorna a query base para validação do participante na SA1 ou SA2.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 29/09/2025
@param cPartType, character, Tipo do participante
@param aBind, array, Array de parâmetros
@param cCusSupCode, character, Código do cliente ou fornecedor
@param cCusSupStore, character, Loja do cliente ou fornecedor
@param cCodProduct, character, Código do produto
@return character, Query base para validação do participante
/*/
method getPartQuery(cPartType as character, aBind as array, cCusSupCode as character, cCusSupStore as character, cCodProduct as character) as character class ProfileOptimizerMVC
    local cQuery := '' as character

    If ( cPartType == SUPPLIER )

        self:cTable := "SA2"

        cQuery := ' SELECT A2_COD COD '
        cQuery += ' FROM ' + retSqlName('SA2') + ' SA2 '
        cQuery += ' WHERE SA2.A2_FILIAL = ? '
        cQuery += '     AND SA2.A2_COD = ? '
        cQuery += '     AND SA2.A2_LOJA = ? '
        

        aadd(aBind, {'C', fwxFilial('SA2')})
        aadd(aBind, {'C', cCusSupCode})
        aadd(aBind, {'C', cCusSupStore})

    ElseIf ( cPartType == CUSTOMER )

        self:cTable := "SA1"

        cQuery := ' SELECT A1_COD COD '
        cQuery += ' FROM ' + retSqlName('SA1') + ' SA1 '
        cQuery += ' WHERE SA1.A1_FILIAL = ? '
        cQuery += '     AND SA1.A1_COD = ? '
        cQuery += '     AND SA1.A1_LOJA = ? '

        aadd(aBind, {'C', fwxFilial('SA1')})
        aadd(aBind, {'C', cCusSupCode})
        aadd(aBind, {'C', cCusSupStore})
    ElseIf ( cPartType == PRODUCT )
        
        self:cTable := "SB1"

        cQuery := ' SELECT B1_COD COD '
        cQuery += ' FROM ' + retSqlName('SB1') + ' SB1 '
        cQuery += ' LEFT JOIN ' + retSqlName('SB5') + ' SB5 '
        cQuery += '     ON SB5.B5_FILIAL = ? AND SB5.B5_COD = SB1.B1_COD AND SB5.D_E_L_E_T_ = ? '
        
        aadd(aBind, {'C', fwxFilial('SB5')})
        aadd(aBind, {'C', ' '})

        if self:getArqProp()
            cQuery += ' LEFT JOIN ' + retSqlName('SBZ') + ' SBZ '
            cQuery += '     ON SBZ.BZ_FILIAL = ? AND SBZ.BZ_COD = SB1.B1_COD AND SBZ.D_E_L_E_T_ = ? '

            aadd(aBind, {'C', fwxFilial('SBZ')})
            aadd(aBind, {'C', ' '})
        endIf

        cQuery += ' WHERE SB1.B1_FILIAL = ? '
        cQuery += '     AND SB1.B1_COD = ? '

        aadd(aBind, {'C', fwxFilial('SB1')})
        aadd(aBind, {'C', cCodProduct})

    EndIf
return cQuery

/*/{Protheus.doc} ProfileOptimizerMVC:updProfStatus()
Função que atualiza o status do perfil de participante.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 24/09/2025
@param lManSemFil, logical, Manual sem filtro
@param lAutomatiz, logical, Automatizado
@param lManEmConf, logical, Manual em conformidade
@param lManFoConf, logical, Manual fora de conformidade
/*/
method updProfStatus(lManSemFil as logical, lAutomatiz as logical, lManEmConf as logical, lManFoConf as logical) as character class ProfileOptimizerMVC
    local cStatus := '' as character

    Do Case
        Case ( lManSemFil )
            cStatus := MANUAL
        Case ( lAutomatiz .And. !lManEmConf .And. !lManFoConf )
            cStatus := AUTOMATIZADO
        Case ( lManEmConf .And. !lManFoConf )
            cStatus := MANUAL_EM_CONFORMIDADE
        Case ( lManFoConf )
            cStatus := MANUAL_FORA_CONFORMIDADE
    EndCase

    self:oModel:loadValue(self:cModel, 'F20_STATUS', cStatus)
return cStatus
