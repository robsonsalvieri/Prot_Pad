#include 'tlpp-core.th'
#include 'fwmvcdef.ch'
#include 'backoffice.fiscal.configurador.profiles.profile-optimizer.ch'

namespace totvs.protheus.backoffice.fiscal.configurador.profiles.profileoptimizer

#Define MANUAL "1"
#Define AUTOMATIZADO "2"
#Define MANUAL_EM_CONFORMIDADE "3"
#Define MANUAL_FORA_CONFORMIDADE "4"
#Define SUPPLIER "1"
#Define CUSTOMER "2"
#Define PRODUCT "3"
#Define PROFILE_PARTICIPANT "02"
#Define PROFILE_PRODUCT "04"
#Define TYPE_SUPPLIER 'SUPPLIER'
#Define TYPE_CUSTOMER 'CUSTOMER'
#Define TYPE_PRODUCT 'PRODUCT'

/*/{Protheus.doc} ProfileOptimizer
Classe responsável pelo Otimizador de Perfis, que tem como objetivo automatizar a 
atualização de clientes/fornecedores/produtos nos perfis fiscais.
@type class
@version 12.1.2510 
@author Juliano Fernandes
@since 24/09/2025
/*/
class ProfileOptimizer

    private data cType as character
    private data cTypeCode as character
    private data cProfileTypeCode as character
    private data cTable as character
    private data aFields as array
    private data jData as json
    private data jProfiles as json
    private data cBackupBranchCode as character
    private data lArqProd as logical
    private data cModel as character
    private data cSubModel as character
    private data cProduct as character

    public method new() constructor
    public method setTypes(cProfileType as character, cType as character)
    public method getData()
    public method process()
    public method getFields() as array
    public method setProduct(cProd as character)
    private method getSupplierFields() as array
    private method getCustomerFields() as array
    private method getProductFields() as array
    private method getParticipantModelFields(cAlias as character) as json
    private method getProductModelFields() as json
    private method fisRetFldProd(aFields as array) as array
    private method getFieldsSBZ() as json
    public method findProfiles()
    private method setBinds(oStatement as object, aBind as array)
    private method getQueryParticipant(aBind as array, lQueryInsert as logical) as character
    private method getQueryProduct(aBind as array, lQueryInsert as logical) as character
    private method getQueryProfileProduct(aBind as array, lQueryInsert as logical) as character
    public method updateProfiles()
    public method changeBranch(cNewBranchCode as character) as character
    public method restoreBranch() as character      
    public method destroy()

endclass

/*/{Protheus.doc} ProfileOptimizer::new
Método construtor da classe ProfileOptimizer.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 24/09/2025
/*/
method new() class ProfileOptimizer

    self:jData := jsonObject():new()
    self:jProfiles := { 'profiles': Array(0) }
    self:lArqProd := getMV("MV_ARQPROD", .F., "") == "SBZ"
    self:cModel := ""
    self:cSubModel := ""

return self

/*/{Protheus.doc} ProfileOptimizer::setTypes
Método responsável por definir o tipo de perfil (PARTICIPANT, PRODUCT) e o tipo (SUPPLIER, CUSTOMER, PRODUCT).
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 24/09/2025
@param cProfileType, character, Tipo de perfil (PARTICIPANT, PRODUCT)
@param cType, character, Tipo de participante (SUPPLIER, CUSTOMER, PRODUCT)
/*/
method setTypes(cProfileType as character, cType as character) class ProfileOptimizer

    self:cType := cType

    if ( cProfileType == 'PARTICIPANT' )
        self:cProfileTypeCode := PROFILE_PARTICIPANT
    endif

    if ( self:cType == TYPE_SUPPLIER )

        self:cModel := "FISA164"
        self:cSubModel := "FISA164PARTICIPANTE"
        self:cTypeCode := '1'
        self:cTable := 'SA2'
        self:aFields := self:getSupplierFields()

    elseif ( self:cType == TYPE_CUSTOMER )

        self:cModel := "FISA164"
        self:cSubModel := "FISA164PARTICIPANTE"
        self:cTypeCode := '2'
        self:cTable := 'SA1'
        self:aFields := self:getCustomerFields()

    elseif ( self:cType == TYPE_PRODUCT )

        self:cModel := "FISA166"
        self:cSubModel := "FISA166PRODUTO"
        self:cTypeCode := '3'
        self:cTable := 'SB1'
        self:aFields := self:getProductFields()

        self:cProfileTypeCode := PROFILE_PRODUCT

    endif

return

/*/{Protheus.doc} ProfileOptimizer::getData
Método responsável por capturar os dados do participante (cliente/fornecedor) ou produto atual.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 24/09/2025
/*/
method getData() class ProfileOptimizer

    local nI as numeric
    local nLength := len(self:aFields) as numeric

    for nI := 1 to nLength
        self:jData[self:aFields[nI][2]] := &(self:aFields[nI][1] + '->' + self:aFields[nI][2])
    next nI

return

/*/{Protheus.doc} ProfileOptimizer::process
Método principal responsável por executar o processo de inclusão e exclusão de participantes ou produtos nos perfis.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 24/09/2025
/*/
method process() class ProfileOptimizer

    begin transaction

        self:getData()
        self:findProfiles()
        self:updateProfiles()

    end transaction

return

/*/{Protheus.doc} ProfileOptimizer:getFields()
Método responsável por retornar os campos que serão processados
@type method
@version 12.1.2510
@author Matheus Bispo
@since 05/11/2025
@return array, Array com os campos que serão considerados no filtro
/*/
method getFields() as array class ProfileOptimizer
return self:aFields

