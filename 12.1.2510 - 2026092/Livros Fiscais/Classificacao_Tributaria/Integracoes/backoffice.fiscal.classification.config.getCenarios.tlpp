#Include "Protheus.ch"
#Include "RwMake.ch"
#Include "FwBrowse.ch"
#Include "FwMvcDef.ch"
#Include "TOPCONN.ch"
#INCLUDE "TBICONN.CH"
#include 'tlpp-core.th'
#include 'tlpp-rest.th'
#include 'classificadorfiscal.ch'

Namespace totvs.protheus.backoffice.fiscal.Classifier

//----------------------------------------------------------------------------------------------------
/*/{Protheus.doc} FisGetMonitorCenario
Classe que contém as operações para obter os dados do status dos cenários salvos e/ou enviados
@author  Yuri Gimenes da Costa
@since   19.07.2022
@version 1.0
/*/
//-----------------------------------------------------------------------------------------------------
Class FisGetMonitorCenario

    data jQuery as json

    public method new() constructor

    @Get("/GetMonitorCenario")    
    public method GetMonitorCenario()

    @Get("/cenarios/detalhe/:idEnvio")
    public method getScenarioDetail() as logical

    @Get('/cenarios/status/:idCenario')
    public method GetStatusById() as json

    private method GetParams() as json
    
    public method GetJsonFieldsForQuery() as character
    public method GetScenarioStatus() as character

End Class

//-------------------------------------------------------------------
/*/{Protheus.doc} New()
Método construtor da classe
@author  Yuri Gimenes da Costa
@since   19.07.2022
@version 1.0
/*/
//-------------------------------------------------------------------
method new() class FisGetMonitorCenario


return

//-------------------------------------------------------------------
/*/{Protheus.doc} GetMonitorCenario()
Método para obter os dados dos status dos cenários e devolve-los 
em um Json

@Obs    Passar via QueryParam a filial da busca que será realizada
        
@author  Yuri Gimenes da Costa
@since   19.07.2022
@version 1.0
/*/
//-------------------------------------------------------------------
method GetMonitorCenario() class FisGetMonitorCenario

Local cQry              := "" as character
Local oJBody            := JsonObject():New() as json
Local oJBodyDt          as object
Local oStatement        as object
Local jQuery            := oRest:GetQueryRequest() as json
Local nPage             as numeric
Local nPageSize         as numeric
Local cFilGroup         as character
Local lOk               as logical
Local cDB               as character
Local nCount            as integer
Local lJsRet            as logical
Local cErroSystax       as character
Local oMemoObj          := nil as object
Local cMemoInQuery      := "" as character
Local aBind             := {} as array
Local nI                as numeric
Local jHeaderResponse   as json
Local oFISEnviaCenario  as object
Local jRetornoSystax    as json

oMemoObj := MemoInQuery():New()
cMemoInQuery := oMemoObj:execMemo()

DbSelectArea('CJG')
lJsRet := CJG->(FieldPos('CJG_JSRET') > 0)
CJG->(DbCloseArea())

nPage       := IIF(jQuery['page'] <> Nil,Val(jQuery['page']), 1 )
nPageSize   := IIF(jQuery['pageSize'] <> Nil,Val(jQuery['pageSize']), 15 )
cFilGroup    := IIF(jQuery['filGroup'] <> Nil .and. !('*' $ jQuery['filGroup']) , jQuery['filGroup'], '')
lAutomato   := Iif(jQuery['automato'] <> Nil, .T., .F.)

nRegIni := ( ( nPage - 1 ) * nPageSize ) + 1
nRegFim := nPage * nPageSize

cDB := Upper(TCGetDB())

cQry += " SELECT "
cQry += "   CJG_DTENV, CJG_HRENV, CJG_IDENVI, CJG_IDPPRO, CJG_IDPPAR, CJG_IDCENA, "

cJsonFields := self:GetJsonFieldsForQuery(cDB, lJsRet)
cQry += ' ? '

aadd(aBind, {"U", cJsonFields})

cQry += " FROM ( "
cQry += "   SELECT ROW_NUMBER() OVER( ORDER BY R_E_C_N_O_ ) LINE_NUMBER, "
cQry += "       CJG_DTENV, CJG_HRENV, CJG_IDENVI, CJG_IDPPRO, CJG_IDPPAR, CJG_IDCENA, CJG_JSON "

if ( lJsRet )
    cQry += " , CJG_JSRET "
endif

cQry += "   FROM " + RetSqlName("CJG")
cQry += "   WHERE CJG_FILIAL = ? "
cQry += "       AND D_E_L_E_T_ = ? "

aadd(aBind, {"C", fwxFilial("CJG")})
aadd(aBind, {"C", " "})

If ( !Empty(cFilGroup) .And. 'status:' $ cFilGroup) 

    If (cFilGroup $ 'status: ' + Lower(STR0103) .And. !(cFilGroup $ 'status: ' + Lower(STR0104))) .Or. (cFilGroup $ 'status:enviado'/*utilizado somente para automação */)
        cQry += "       AND CJG_DTENV <> ? AND CJG_HRENV <> ? "
        aadd(aBind, {"C", " "})
        aadd(aBind, {"C", " "})
    ElseIf (cFilGroup $ 'status: ' + Lower(STR0104) .And. !(cFilGroup $ 'status: ' + Lower(STR0103))) .Or. (cFilGroup $ 'status:a_enviar'/*utilizado somente para automação */)
        cQry += "       AND CJG_DTENV = ? AND CJG_HRENV = ? "
        aadd(aBind, {"C", " "})
        aadd(aBind, {"C", " "})
    EndIf

ElseIf (!Empty(cFilGroup) .And. !('status: ' $ cFilGroup))

	cQry += " AND ( "
	cQry += "   CJG_IDENVI LIKE ? OR " 
	cQry += "   CJG_DTENV LIKE ? OR " 
	cQry += "   CJG_HRENV LIKE ? OR " 
	cQry += "   UPPER(CJG_IDPPRO) LIKE ? OR " 
	cQry += "   UPPER(CJG_IDPPAR) LIKE ? OR "
	cQry += "   CJG_IDCENA LIKE ? "
	cQry += " ) "

    For nI := 1 To 6
        aadd(aBind, {"C", "%" + upper(cFilGroup) + "%"})
    Next nI

EndIf

cQry += " ) CJG "
cQry += " WHERE LINE_NUMBER BETWEEN " + cValTochar(nRegIni) + " AND " + cValTochar(nRegFim + 1) + " " // Soma mais um registro para retorno do HasNext
cQry += " ORDER BY CJG_IDENVI "

oStatement := fwExecStatement():new(changeQuery(cQry))

For nI := 1 To Len(aBind)
    if ( aBind[nI][1] == "C" )
        oStatement:setString(nI, aBind[nI][2])
    elseif ( aBind[nI][1] == "U" )
        oStatement:setUnsafe(nI, aBind[nI][2])
    endif
Next nI

cQry := oStatement:getFixQuery()

cAliasMonitor := oStatement:openAlias()

oMemoObj:Close()

oJBody["cenarios"] := {}

While (cAliasMonitor)->(!EoF()) .And. nCount < nPageSize

    nCount++

    cErroSystax := ''

    if ( lJsRet )
        jRetornoSystax := JsonObject():New()

        if ( jRetornoSystax:FromJson( AllTrim((cAliasMonitor)->JSRET) ) == nil )
            oFISEnviaCenario := FISEnviaCenario():New()
            cErroSystax := oFISEnviaCenario:GetResponseMessage(jRetornoSystax)
            FreeObj(oFISEnviaCenario)
        endif
        
        FreeObj(jRetornoSystax)
    endif

    oJBodyDt := JsonObject():New()
    
    oJBodyDt["id_envio"]            := AllTrim((cAliasMonitor)->CJG_IDENVI)
    oJBodyDt["status"]              := self:GetScenarioStatus((cAliasMonitor)->CJG_IDCENA, cErroSystax)
    oJBodyDt["data_envio"]          := DtoC(StoD((cAliasMonitor)->CJG_DTENV))
    oJBodyDt["hora_envio"]          := AllTrim((cAliasMonitor)->CJG_HRENV )
    oJBodyDt["id_perfil_prod"]      := AllTrim((cAliasMonitor)->CJG_IDPPRO)
    oJBodyDt["id_perfil_part"]      := AllTrim((cAliasMonitor)->CJG_IDPPAR)
    oJBodyDt["id_cenario"]          := AllTrim((cAliasMonitor)->CJG_IDCENA)
    oJBodyDt["status_code_systax"]  := '0'
    oJBodyDt["status_systax"]       := STR0231 // 'Clique em Verificar status Systax para obter o status'
    oJBodyDt["json_cenario"]        := AllTrim((cAliasMonitor)->JSON)
    oJBodyDt["erro_systax"]         := AllTrim(cErroSystax)

    If lAutomato

        oJBodyDt["id_envio"]          := "TESTE"
        oJBodyDt["status"]            := "enviado"   
        oJBodyDt["data_envio"]        := ""
        oJBodyDt["hora_envio"]        := ""
        oJBodyDt["id_cenario"]        := "AUTOMACAO"

    EndIf

    aadd(oJBody["cenarios"],oJBodyDt)

    FreeObj( oJBodyDt )

    lOk := .T.

    (cAliasMonitor)->(DbSkip())

EndDo

oJBody["success"] := lOk
oJBody["hasNext"] := !(cAliasMonitor)->(EoF())

(cAliasMonitor)->(DbCloseArea())

oStatement:destroy()
fwFreeObj(oStatement)
fwFreeObj(oMemoObj)
fwFreeArray(aBind)

jHeaderResponse := JsonObject():New()
jHeaderResponse["Content-Type"] := "application/json;charset=cp1252"
oRest:SetHeaderResponse(jHeaderResponse)
FreeObj(jHeaderResponse)

Return oRest:setResponse(oJBody)

/*/{Protheus.doc} FisGetMonitorCenario::getScenarioDetail
Método responsável por obter os detalhes de um cenário específico, como os produtos relacionados, e devolve-los em um Json
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 20/04/2026
@return logical, True se a resposta foi definida com sucesso no objeto oRest, False caso contrário
/*/
method getScenarioDetail() as logical class FisGetMonitorCenario

    local cQry as character
    local jBody := jsonObject():new() as json
    local jProd as json
    local oStatement as object
    local cJson as character
    local jQuery := oRest:getQueryRequest() as json
    local nPage := 1 as numeric
    local nPageSize := 15 as numeric
    local lSuccess as logical
    local lHasNext as logical
    local cDB := upper(tcGetDb()) as character
    local nCount as numeric
    local jCenario as json
    local cJsonFields as character
    local oMemoObj as object
    local cMemoInQuery as character
    local aBind := {} as array
    local nI as numeric
    local jHeaderResponse as json
    local jPathParamsRequest := oRest:getPathParamsRequest() as json
    local cIdEnvio := jPathParamsRequest["idEnvio"] as character
    local nRegIni as numeric
    local nRegFim as numeric

    if ( jQuery:hasProperty("page") .and. !empty(jQuery["page"]) )
        nPage := val(jQuery["page"])
    endif

    if ( jQuery:hasProperty("pageSize") .and. !empty(jQuery["pageSize"]) )
        nPageSize := val(jQuery["pageSize"])
    endif

    oMemoObj := MemoInQuery():new()
    cMemoInQuery := oMemoObj:execMemo()

    nRegIni := ( ( nPage - 1 ) * nPageSize ) + 1
    nRegFim := nPage * nPageSize

    cQry := " SELECT CJG_IDENVI, CJG_IDPPAR, F20_DESC, CJG_IDPPRO, B1_DESC, CJG_IDCENA, F24_CDPROD, "

    cJsonFields := self:getJsonFieldsForQuery(cDB, .T.)
    cQry += " ? "
    aadd(aBind, {"U", cJsonFields})

    cQry += " FROM ( "
    cQry += "   SELECT ROW_NUMBER() OVER( ORDER BY F24.R_E_C_N_O_ ) LINE_NUMBER, "
    cQry += "       CJG.CJG_IDENVI, CJG.CJG_IDPPAR, F20.F20_DESC, CJG.CJG_IDPPRO, SB1.B1_DESC, CJG.CJG_IDCENA, F24.F24_CDPROD, "
    cQry += "       CJG.CJG_JSON, CJG.CJG_JSRET "
    cQry += "   FROM " + retSqlName("CJG") + " CJG "
    cQry += "   INNER JOIN " + retSqlName("F20") + " F20 "
    cQry += "       ON F20.F20_FILIAL = ? "
    cQry += "       AND F20.F20_CODIGO = CJG.CJG_IDPPAR "
    cQry += "       AND F20.F20_TIPO = ? "
    cQry += "       AND F20.D_E_L_E_T_ = ? "

    aadd(aBind, {"C", fwxFilial("F20")})
    aadd(aBind, {"C", "02"})
    aadd(aBind, {"C", " "})

    cQry += "   INNER JOIN " + retSqlName("F24") + " F24 "
    cQry += "       ON F24.F24_FILIAL = ? "
    cQry += "       AND F24.F24_CODIGO = CJG.CJG_IDPPRO "
    cQry += "       AND F24.D_E_L_E_T_ = ? "

    aadd(aBind, {"C", fwxFilial("F24")})
    aadd(aBind, {"C", " "})

    cQry += "   INNER JOIN " + retSqlName("SB1") + " SB1 "
    cQry += "       ON SB1.B1_FILIAL = ? "
    cQry += "       AND SB1.B1_COD = F24.F24_CDPROD "
    cQry += "       AND SB1.D_E_L_E_T_ = ? "

    aadd(aBind, {"C", fwxFilial("SB1")})
    aadd(aBind, {"C", " "})

    cQry += "   WHERE CJG.CJG_FILIAL = ? "
    cQry += "       AND CJG.CJG_IDENVI = ? "
    cQry += "       AND CJG.D_E_L_E_T_ = ? "

    aadd(aBind, {"C", fwxFilial("CJG")})
    aadd(aBind, {"C", cIdEnvio})
    aadd(aBind, {"C", " "})

    cQry += " ) TAB "

    cQry += " WHERE LINE_NUMBER BETWEEN ? AND ? "

    aadd(aBind, {"N", nRegIni})
    aadd(aBind, {"N", nRegFim + 1}) // Soma mais um registro para retorno do HasNext

    cQry += " ORDER BY F24_CDPROD "

    oStatement := fwExecStatement():new(changeQuery(cQry))

    for nI := 1 to len(aBind)
        do case
            case ( aBind[nI][1] == "C" )
                oStatement:setString(nI, aBind[nI][2])
            case ( aBind[nI][1] == "N" )
                oStatement:setNumeric(nI, aBind[nI][2])
            case ( aBind[nI][1] == "U" )
                oStatement:setUnsafe(nI, aBind[nI][2])
        endcase
    next nI

    cQry := oStatement:getFixQuery()

    cAliasMonitor := oStatement:openAlias()

    oMemoObj:close()

    if (cAliasMonitor)->(!eof())

        jCenario := jsonObject():new()
        cJson := allTrim((cAliasMonitor)->JSON)
        jCenario:fromJson(cJson)
        
        jBody["id_envio"] := allTrim((cAliasMonitor)->CJG_IDENVI)
        jBody["id_perfil_prod"] := allTrim((cAliasMonitor)->CJG_IDPPRO)
        jBody["id_perfil_part"] := allTrim((cAliasMonitor)->CJG_IDPPAR)
        jBody["id_cenario"] := allTrim((cAliasMonitor)->CJG_IDCENA)
        jBody["nome_part"] := allTrim((cAliasMonitor)->F20_DESC)
        jBody["uf_origem"] := allTrim(jCenario["cenarios"][1]["uf_origem"])
        jBody["uf_destino"] := allTrim(jCenario["cenarios"][1]["uf_destino"])
        jBody["produtos"] := {}

        while (cAliasMonitor)->(!eof()) .and. nCount < nPageSize
            nCount++

            jProd := jsonObject():new()
            jProd["cod_prod"] := allTrim((cAliasMonitor)->F24_CDPROD)
            jProd["descricao"] := allTrim((cAliasMonitor)->B1_DESC)
            aadd(jBody["produtos"], jProd)
            
            freeObj(jProd)

            (cAliasMonitor)->(dbSkip())
        enddo

        lSuccess := .T.
        lHasNext := !(cAliasMonitor)->(eof())

        (cAliasMonitor)->(dbCloseArea())
    endif

    freeObj(jCenario)

    oStatement:destroy()
    fwFreeObj(oStatement)

    fwFreeObj(oMemoObj)

    jBody["success"] := lSuccess
    jBody["hasNext"] := lHasNext

    fwFreeArray(aBind)

    jHeaderResponse := jsonObject():new()
    jHeaderResponse["Content-Type"] := "application/json;charset=cp1252"
    oRest:setHeaderResponse(jHeaderResponse)
    freeObj(jHeaderResponse)

return oRest:setResponse(jBody)

/*/{Protheus.doc} GetStatusById
Método responsável por verificar o status do cenário na Systax
@author Juliano Fernandes
@since 06/05/2024
@version 12.1.2310
@return jResponse, json, Json contendo as informações do status do cenário na Systax
/*/
method GetStatusById() as json class FisGetMonitorCenario

    local jHeaderResponse as json
    local jResponse as json
    local oRestClient as object
    local aHeader as array
    local cResult as character
    local jResult as json
    local cStatus as character
    local jParams as json
    
    jParams := self:GetParams()

    jResponse := JsonObject():New()
    jResponse['success'] := .F.
    jResponse['id'] := jParams['id']
    jResponse['statusCode'] := '0'
    jResponse['status'] := EncodeUTF8(STR0227) // 'Erro ao buscar status do cenário'

    oRestClient := FwRest():New(jParams['url'])
	oRestClient:SetPath(jParams['path'])

    if ( !Empty(jParams['token']) )
        aHeader := {}
		Aadd(aHeader, 'Content-Type: application/json; charset=UTF-8')
		Aadd(aHeader, 'Content-Length: <calculated when request is sent>')
		Aadd(aHeader, 'Accept: */*')
		Aadd(aHeader, 'User-Agent: Chrome/65.0 (compatible; Protheus ' + GetBuild() + ')')
		Aadd(aHeader, 'Authorization: Bearer ' + jParams['token'])

        if ( oRestClient:Get(aHeader) )
            cResult := oRestClient:GetResult()

            jResult := JsonObject():New()

            if ( jResult:FromJson(cResult) == nil )
                cStatus := jResult['msg']

                if ( jResult:HasProperty('motivo') )
                    cStatus += ' - ' + jResult['motivo']
                endif

                jResponse['success'] := .T.
                jResponse['statusCode'] := jResult['status']
                jResponse['status'] := cStatus
            endif
        endif
    endif

    if ( !FwIsInCallStack('GetMonitorCenario') )
        jHeaderResponse := JsonObject():New()
        jHeaderResponse['Content-Type'] := 'application/json; charset=UTF-8'
        oRest:SetHeaderResponse(jHeaderResponse)
    
        oRest:SetResponse(jResponse)

        FwFreeVar(jParams)
        FwFreeVar(jResponse)
    endif

    FwFreeVar(jHeaderResponse)
    FwFreeVar(oRestClient)
    FwFreeVar(jResult)
    FwFreeArray(aHeader)

return jResponse

/*/{Protheus.doc} GetParams
Método responsável por obter os parâmetros necessários para buscar o status do cenário na Systax
@author Juliano Fernandes
@since 09/05/2024
@version 12.1.2310
@return jParams, json, Json contendo os parâmetros necessários a busca do status
/*/
method GetParams() as json class FisGetMonitorCenario

    local jParams as json
    local jPathParamsRequest as json
    local jQueryParamsRequest as json
    local cCJEParam as character
    local jCJEParam as json
    local cMockServer as character
    local cUrl as character
    local cId as character
    local cPath as character

    jPathParamsRequest := oRest:GetPathParamsRequest()
    jQueryParamsRequest := oRest:GetQueryRequest()

    if ( Empty(cId) .and. jPathParamsRequest:HasProperty('idCenario') )
        cId := jPathParamsRequest['idCenario']
    endif

    cCJEParam := GetConfigClassif({'URLPRINCIPAL'})
    
    jCJEParam := JsonObject():New()
    if ( jCJEParam:FromJson(cCJEParam) == nil )
        cUrl := jCJEParam:URLPRINCIPAL
    endif

	if ( jQueryParamsRequest:HasProperty('mockserver') )
        cMockServer := jQueryParamsRequest['mockserver']
		cUrl := cMockServer
	endif

    cPath := '/cadastro-geral/cenarios/status/' + cId

	if ( jQueryParamsRequest:HasProperty('endpoint') )
		cPath := jQueryParamsRequest['endpoint']
	endif

    jParams := JsonObject():New()
    jParams['id'] := cId
    jParams['url'] := cUrl
    jParams['path'] := cPath
    jParams['token'] := AllTrim(ConsultTok(cUserName, cMockServer))    
    jParams['mockserver'] := cMockServer

return jParams

/*/{Protheus.doc} GetJsonFieldsForQuery
Método responsável por obter os campos json convertidos para utilização na query
@author Juliano Fernandes
@since 25/07/2024
@version 12.1.2310
@param cDbType, character, Tipo do banco de dados em que o sistema está sendo executado
@param lJsRet, logical, Define se o campo CJB_JSRET existe na base de dados
@return cQry, character, Campos json convertidos para utilização na query
/*/
method GetJsonFieldsForQuery(cDbType as character, lJsRet as logical) as character class FisGetMonitorCenario

    local cQry as character 
    
    if ( "POSTGRES" $ cDbType )
        cQry += " encode(CJG_JSON,'escape') JSON "

        if ( lJsRet )
            cQry += ", encode(CJG_JSRET,'escape') JSRET "
        endif
    else
        cQry += " CJG_JSON JSON "

        if ( lJsRet )
            cQry += ", CJG_JSRET JSRET "
        endif      
    endif 

return cQry

/*/{Protheus.doc} GetScenarioStatus
Método responsável por obter o status do cenário
@author Juliano Fernandes
@since 12/08/2024
@version 12.1.2310
@param cScenarioId, character, ID do cenário
@param cError, character, Erro ocorrido no envio do cenário
@return cStatus, character, Status do cenário
/*/
method GetScenarioStatus(cScenarioId as character, cError as character) as character class FisGetMonitorCenario

    local cStatus as character

    do case
        case ( !Empty(cError) )
            cStatus := 'erro'
        case ( !Empty(cScenarioId) )
            cStatus := 'enviado'
        otherwise
            cStatus := 'a enviar'
    endcase

return cStatus
