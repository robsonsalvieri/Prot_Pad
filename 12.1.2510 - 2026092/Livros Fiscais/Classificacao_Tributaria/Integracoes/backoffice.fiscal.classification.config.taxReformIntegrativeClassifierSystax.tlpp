/*/
method setWritingTags() class TaxReformIntegrativeClassifierSystax
    self:aWritingTags := {}
    aadd(self:aWritingTags, {"cst",        "operacao"})  // CST de saida
    aadd(self:aWritingTags, {"cstEntrada", "credito" })  // CST de entrada
return

