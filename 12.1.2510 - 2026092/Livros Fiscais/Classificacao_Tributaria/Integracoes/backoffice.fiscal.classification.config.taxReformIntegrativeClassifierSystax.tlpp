/*/{Protheus.doc} organizeJson
método para organizar os dados recebidos em json para o cadastro dos tributos
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@return json, objeto json com os tributos organizados para cadastro no Protheus    
/*/
method organizeJson() as json class TaxReformIntegrativeClassifierSystax
    local jScenario as json
    local nC, nR as numeric

    if self:lReady
        for nC := 1 to len(self:getJsonData()["cenario"])

            jScenario := self:getJsonData()["cenario"][nC]

            self:setFederativeUnitOrigin(jScenario["ufOrigem"])
            self:setFederativeUnitDestination(jScenario["ufDestino"])

            // Q1: gravar dados do cenario para uso em saveCalcRule (suporte a multiplos cenarios)
            self:setIdCenario(cValToChar(jScenario["idCenario"]))

            if jScenario:hasProperty("entSai")
                self:setEntSai(jScenario["entSai"])
            endif

            if jScenario:hasProperty("naturezaOperacao")
                self:setNaturezaOperacao(cValToChar(jScenario["naturezaOperacao"]))
            endif

            // Q4: finalidade pode ser ausente (ex: cenario 254748) — default ""
            if jScenario:hasProperty("finalidade") .and. valType(jScenario["finalidade"]) != "U"
                self:setFinalidade(cValToChar(jScenario["finalidade"]))
            else
                self:setFinalidade("")
            endif

            if jScenario:hasProperty("apelido")
                self:setApelidoCenario(jScenario["apelido"])
            endif

            for nR := 1 to Len(jScenario["produto"])

                self:processJsonReturns(jScenario, jScenario["produto"][nR])
                
            next nR
        next nC
    endif
    
return self:jTaxesReturn

/*/{Protheus.doc} processJsonReturns
método para processar os retornos do json
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@param jScenario, json, objeto json com os dados do cenário
@param jProduto, json, objeto json com os dados do produto
@return json, objeto json com os tributos
/*/
method processJsonReturns(jScenario as json, jProduto as json) as json class TaxReformIntegrativeClassifierSystax
    local aTaxes as array
    local nT as numeric
    local cNCM as character
    local cTipReg  as character
    local cCodProd as character

    if jProduto:hasProperty("ncm")
        cNCM := cValToChar(jProduto["ncm"])
    endif
    self:setNcm(cNCM)

    // Capturar tipoRegra e codigoProduto do JSON Systax
    cTipReg := jProduto["tipoRegra"]

    cCodProd := cTipReg
    if jProduto:hasProperty("codigoProduto")
        cCodProd := jProduto["codigoProduto"]
    endif
    self:cCodProduto := cCodProd

    self:setOriginProduct(cValToChar(jProduto["origemProduto"]))
    self:setRule(jProduto["regra"])

    if self:validateReceivedData()
        aTaxes := self:getRule():getNames()

        // Adiciona as regras de alíquota e regras de escrituração
        for nT := 1 to len(aTaxes)
            if valType(self:getRule()[aTaxes[nT]]) == "J"
                self:addTaxes(self:taxesConvert(aTaxes[nT]),self:getRule()[aTaxes[nT]])
            endif
        next nT

        asize(aTaxes, 0)

        aTaxes := self:jTaxesReturn["ncm"][self:getNcm()]:getNames()

        // Adiciona as bases de cálculo e as regras de cálculo
        for nT := 1 to len(aTaxes)
            if valType(self:jTaxesReturn["ncm"][self:getNcm()][aTaxes[nT]]) == "J"
                self:addTaxes(aTaxes[nT],jScenario)
            endif
        next nT

        asize(aTaxes, 0)
    endif

return self:jTaxesReturn

/*/{Protheus.doc} addTaxes
método para adicionar os tributos no objeto json jTaxesReturn
Esta rotina pode trabalhar com recursão, pois o tributo pode ter um tributo dentro dele, como é o caso do ICMS ST.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@param cTax, character, tributo a ser adicionado
@param jTax, json, objeto json com os dados do tributo    
@return logical, indica se os tributos foram adicionados com sucesso ou não    
/*/
method addTaxes(cTax as character, jTax as json) as logical class TaxReformIntegrativeClassifierSystax
    local aTaxes := {} as array
    local jProcess as json
    local lReturn as logical

    if self:validTaxes(cTax)
        aTaxes := jTax:getNames()

        jProcess := self:initializeTaxesReturn()

        if !jProcess:hasProperty(cTax)
            jProcess[cTax] := jsonObject():new()

            self:nContTax := self:nContTax + 1
        endif        

        self:processNCM(jProcess[cTax], jTax, cTax)

        self:processBaseCalc(jProcess[cTax], jTax, cTax)

        self:processAliquot(jProcess[cTax], jTax, cTax)

        self:processFiscalWriting(jProcess[cTax], jTax, cTax)

        self:processTaxCalc(jProcess[cTax], jTax, cTax)

        // Processa o grupo gTribRegular (tributacao regular) gerando um conjunto
        // proprio de regras sob o tributo regular (ex: ibserg / cbsreg)
        self:processTribRegular(jProcess, jTax, cTax)

        lReturn := .T.
    endif

    asize( aTaxes, 0 )

return lReturn

/*/{Protheus.doc} initializeTaxesReturn
método para inicializar o objeto json jTaxesReturn
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@return json, Objeto json jTaxesReturn inicializado
/*/
method initializeTaxesReturn() as json class TaxReformIntegrativeClassifierSystax
    local cCodeNcm as character
    local cFederativeUnitDestination as character
    local cFederativeUnitOrigin as character
    local cOriginProduct as character
    local jProcess as json

    cCodeNcm := self:getNcm()
    
    if !valType(self:jTaxesReturn["ncm"]) == "J"
        self:jTaxesReturn["ncm"] := jsonObject():new()
    endif

    if !self:jTaxesReturn["ncm"]:hasProperty(cCodeNcm)
        self:jTaxesReturn["ncm"][cCodeNcm] := jsonObject():new()

        cFederativeUnitDestination := self:getFederativeUnitDestination()
        cFederativeUnitOrigin := self:getFederativeUnitOrigin()
        cOriginProduct := self:getOriginProduct()        

        jProcess := self:jTaxesReturn["ncm"][cCodeNcm]

        jProcess["ncm"] := cCodeNcm
        jProcess["uf_origem"] := cFederativeUnitOrigin
        jProcess["uf_destino"] := cFederativeUnitDestination
        jProcess["cOriginProduct"] := cOriginProduct
        // Q1: dados do cenario gravados por NCM para suporte a multiplos cenarios em saveCalcRule
        jProcess["cIdCenario"]        := self:cIdCenario
        jProcess["cNaturezaOperacao"] := self:cNaturezaOperacao
        jProcess["cFinalidade"]       := self:cFinalidade
        jProcess["cApelidoCenario"]   := self:cApelidoCenario
        // Produto para GetPerfis da Reforma (CJG_IDCENR)
        jProcess["cCodProduto"]       := self:cCodProduto        
    else
        jProcess := self:jTaxesReturn["ncm"][cCodeNcm]
    endif
    
return jProcess

/*/{Protheus.doc} processNCM
método para processar dados de cadastro de ncm NCM
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@param jProtheus, json, Json com os dados de cadastro de ncm
@param jTaxSystax, json, Json com os dados do tributo
@return json, Json com os dados de cadastro de ncm
/*/
method processNCM(jProtheus as json, jTaxSystax as json, cTax as character) as json class TaxReformIntegrativeClassifierSystax
    self:addPauta(jProtheus, jTaxSystax, cTax)

return jProtheus

/*/{Protheus.doc} addPauta
Método para processar dados de valor de pauta
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@param jProtheus, json, Json com os dados de cadastro de ncm
@param jTaxSystax, json, Json com os dados do tributo
@param cTax, character, tributo a ser processado
@return json, Json com os dados de cadastro de ncm e valor de pauta
/*/
method addPauta(jProtheus as json, jTaxSystax as json, cTax as character) as json class TaxReformIntegrativeClassifierSystax
    
    local jPauta as json //Objeto json com valor de pauta
    local cNumRules as character //Número de regras de pauta
    local cHashTax as character //Hash do tributo    
    local cVigenciaDe as character //Vigencia de
    local cVigenciaAte as character //Vigencia ate
    local cUM //Unidade de medida

    if jTaxSystax:hasProperty("valorPauta")

        self:addProperty(jProtheus, "ncm")

        cVigenciaDe := self:mountVigencia(jTaxSystax, "vigenciaDe")
        cVigenciaAte := self:mountVigencia(jTaxSystax, "vigenciaAte")

        cUM := self:convertUnitMeasure(jTaxSystax["uTrib"])

        cHashTax := md5( self:getNcm() + cTax + self:getFederativeUnitOrigin() + self:getFederativeUnitDestination() + cVigenciaDe + cVigenciaAte + /*self:getCodeCEST() +*/ cUM)

        cNumRules := "pauta_" + cHashTax

        if !jProtheus["ncm"]:hasProperty(cNumRules)

            self:nContRulesPauta := self:nContRulesPauta + 1

            jProtheus["ncm"][cNumRules] := {;    
                                                "uf_origem": "",;
                                                "uf_destino": "",;
                                                "vigencia_de": "",;
                                                "vigencia_ate": cVigenciaAte,;
                                                "unidade_medida": "",;
                                                "codigo_cest": "",;
                                                "valor_pauta": 0,;
                                                "origem_produto": "";
                                            }
                                            
            jPauta := jProtheus["ncm"][cNumRules]

            jPauta[ "valor_pauta" ] := self:convertValue(jTaxSystax[ "valorPauta" ])

            jPauta[ "uf_origem" ]      := self:getFederativeUnitOrigin()
            jPauta[ "uf_destino" ]     := self:getFederativeUnitDestination()
            jPauta[ "unidade_medida" ] := cUM
            jPauta[ "origem_produto" ] := self:getOriginProduct()
            jPauta[ "vigencia_de" ]    := cVigenciaDe
            jPauta[ "vigencia_ate" ]   := cVigenciaAte            
            
        endif
    endif

return jProtheus

/*/{Protheus.doc} convertUnitMeasure
método para converter unidade de medida
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@param cUnitMeasure, character, unidade de medida
@return character, unidade de medida convertida    
/*/
method convertUnitMeasure(cUnitMeasure as character) as character class TaxReformIntegrativeClassifierSystax
    if upper(cUnitMeasure) == upper('sc50kg')
        cUnitMeasure := 'S5'
    elseif upper(cUnitMeasure) == upper('saca')
        cUnitMeasure := 'SA'
    endif
    
return cUnitMeasure

/*/{Protheus.doc} addProperty
método para adicionar os dados de cadastro de ncm no objeto json jProtheus
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@param jProtheus, json, objeto json com os dados do tributo
/*/
method addProperty(jProtheus as json, cProperty as character) as json class TaxReformIntegrativeClassifierSystax
    if !jProtheus:hasProperty(cProperty)
        jProtheus[cProperty] := jsonObject():new()
        
        Do Case
            Case cProperty == 'ncm'
                self:lIntegrativeNCM := .T.
            Case cProperty == 'baseCalc'
                self:lIntegrativeBaseCalc := .T.
            Case cProperty == 'aliquot'
                self:lIntegrativeAliquot := .T.
            Case cProperty == "writing"
                self:lIntegrativeWriting  := .T.
            Case cProperty == "calcRule"
                self:lIntegrativeCalcRule := .T.
        endCase
    endif
    
return jProtheus

/*/{Protheus.doc} processBaseCalc
método para processar dados de cadastro de Base de Cálculo
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@param jTax, json, objeto json com os dados do tributo
@return json, objeto json com os dados de cadastro de Base de Cálculo
/*/
method processBaseCalc(jProtheus as json, jTaxSystax as json, cTax as character) as json class TaxReformIntegrativeClassifierSystax
    local cBaseCalc := self:getBaseCalc(jTaxSystax) as character // Base de Cálculo
    local jBaseCalc as json // Objeto json com base de cálculo
    local cProperty as character // Propriedade do tributo
    local cCodigo as character // Código do tributo
    local cFormula as character // Fórmula
    local nPcRed as numeric // Percentual de redução
    local cDescricao as character // Descrição
    local oRuleBaseCalc as object // Objeto FISGravaBase usado na montagem da formula
    local cFormulaOrigin as character // Fórmula original

    if !empty(cBaseCalc)
        cProperty := 'baseCalc'

        cCodigo := 'baseCalc_' + md5(cBaseCalc)

        self:addProperty(jProtheus, cProperty)

        if !jProtheus[cProperty]:hasProperty(cCodigo)
            self:nContBaseCalc := self:nContBaseCalc + 1
            
            jProtheus[cProperty][cCodigo] := jsonObject():new()
            jBaseCalc := jProtheus[cProperty][cCodigo]

            oRuleBaseCalc := FISGravaBase():new()
            cFormulaOrigin := self:mountCalcBase(val(cBaseCalc), cTax, oRuleBaseCalc)
            cFormula := cFormulaOrigin
            
            cDescricao := oRuleBaseCalc:descricaoBase(cBaseCalc)
            cFormula := oRuleBaseCalc:ajustaFormulaReducao(@cDescricao, cFormula, @nPcRed, jTaxSystax)

            if !empty(cFormula)

                jBaseCalc[ 'description' ]    := cDescricao
                jBaseCalc[ 'formula' ]        := cFormula
                jBaseCalc[ 'value_origin' ]   := '11'
                jBaseCalc[ 'reduction_base' ] := nPcRed

            endif

            fwFreevar(oRuleBaseCalc)

        endif
    endif

return jProtheus

/*/{Protheus.doc} setBaseCalcTags
Metodo para definir as tags de extracao da base de calculo dos tributos da Reforma
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
/*/
method setBaseCalcTags() class TaxReformIntegrativeClassifierSystax

    self:aBaseCalcTags := {}
    aadd(self:aBaseCalcTags, "baseCalculo") // Base de cálculo para apuração do Imposto sobre Bens e Serviços (IBS), Contribuiééo sobre Bens e Serviços (CBS) e Imposto Seletivo
    aadd(self:aBaseCalcTags, "baseCalculoReg") // Base de cálculo da tributação regular do IBSUF, IBSMun e CBS

return

/*/{Protheus.doc} setWritingTags
Método para definir as tags de extracao de CST dos tributos da Reforma Tributaria
