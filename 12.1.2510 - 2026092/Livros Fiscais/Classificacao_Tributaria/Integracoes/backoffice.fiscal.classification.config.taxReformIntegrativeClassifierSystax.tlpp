    public method getTaxesReturn() as json //método para retornar o objeto json com os tributos    
    public method getNcm() as character //método para retornar o ncm    
    public method getOriginProduct() as character //método para retornar a origem do produto
    public method setRule(jValue as json) as object //método para retornar os dados da regra
    public method getRule() as json //método para retornar os dados da regra
    public method setData(cValue as character) as object //método para receber um dado carácter com conteúdo json
    public method getRegisterAliquot() as array //método para retornar o registro de alíquota
    public method getRegisterBase() as array //método para retornar o registro de base de cálculo
    public method setMockServer(cValue as character) as object //método para receber um dado carácter com a url do mock server
    public method getIntegrativeWriting() as logical //método para retornar indicador de escrituração
    public method getIntegrativeCalcRule() as logical //método para retornar indicador de regra de cálculo
    public method getRegisterWriting() as array //método para retornar o registro de escrituração
    public method getRegisterCalcRule() as array //método para retornar o registro de regra de cálculo
    public method getProtheusTaxes(cSystaxTax as character) as character //retorna os tributos Protheus (principal e regular) relacionados ao tributo da Systax

    private method setWritingTags() //define tags de extracao de CST
    private method setEntSai(nValue as numeric) as object //recebe entSai do cenario
    private method setNaturezaOperacao(cValue as character) as object //recebe naturezaOperacao
    private method setFinalidade(cValue as character) as object //recebe finalidade (pode ser vazio)
    private method setApelidoCenario(cValue as character) as object //recebe apelido do cenario
    private method setIdCenario(cValue as character) as object //recebe id do cenario
    private method montaJsonCenarioPerfis(cNCM as character) as json //monta jCenario para GetPerfis/GravaPerfilOriDes
    private method processFiscalWriting(jProtheus as json, jTaxSystax as json, cTax as character) as json //processa escrituracao
    private method processTaxCalc(jProtheus as json, jTaxSystax as json, cTax as character) as json //marca calculo
    private method processTribRegular(jProtheus as json, jTaxSystax as json, cTax as character) as json //processa grupo gTribRegular (tributacao regular)
    private method getRegularTax(cTax as character) as character //retorna o tributo Protheus regular correspondente ao tributo informado
    private method addAliquotTribRegular(jProtheus as json, jTribRegular as json, cTax as character) as json //adiciona aliquota nominal da tributacao regular
    private method addWritingTribRegular(jProtheus as json, jTribRegular as json, cTax as character) as json //adiciona escrituracao (CST) da tributacao regular

endclass

/*/{Protheus.doc} new
Método construtor da classe TaxReformIntegrativeClassifierSystax
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@param cValue, character, Conteúdo em formato json
@return object, Objeto da classe TaxReformIntegrativeClassifierSystax
/*/
method new(cValue as character) class TaxReformIntegrativeClassifierSystax
    self:aRegisterAliquot := {}
    self:aRegisterBase := {}
    self:cCodeNcm := ""
    self:cData := ""
    self:cError := ""
    self:cFederativeUnitDestination := ""
    self:cFederativeUnitOrigin := ""
    self:cMockServer := ""
    self:cOriginProduct := ""
    self:jRule := jsonObject():new()
    self:jData := jsonObject():new()
    self:jTaxesReturn := jsonObject():new()
    self:lIntegrativeAliquot := .F.
    self:lIntegrativeBaseCalc := .F.
    self:lIntegrativeNCM := .F.
    self:lReady := .F.
    self:nContAliquot := 0
    self:nContBaseCalc := 0
    self:nContRulesPauta := 0
    self:nContTax := 0
    self:setRelationTaxProtheusAndSystax()
    self:setAliquotTags()
    self:setBaseCalcTags()
    self:setWritingTags()

    self:aNCMs := {}
    self:aBases := {}
    self:aAliquotas := {}
    self:aEscrituracoes := {}
    self:aRegras := {}
    self:aOrigensEDestinos := {}
    self:aOperacoes := {}
    self:aRegisterWriting := {}
    self:aRegisterCalcRule := {}
    self:lIntegrativeWriting := .F.
    self:lIntegrativeCalcRule := .F.
    self:nEntSai := 0
    self:cNaturezaOperacao := ""
    self:cFinalidade := ""
    self:cApelidoCenario := ""
    self:cIdCenario := ""
    self:cCodProduto := ""

    // A carga do json deve ser a ULTIMA etapa do construtor: setData executa o
    // parsing completo e liga as flags lIntegrativeWriting e lIntegrativeCalcRule.
    // Se as inicializacoes acima ocorressem depois, essas flags seriam zeradas e
    // saveWriting/saveCalcRule nunca executariam.
    if !empty(cValue)
        self:setData(cValue)
    endif

return self

/*/{Protheus.doc} setData
Método para receber um dado carácter com conteúdo json
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@param cValue, character, conteúdo em formato json
@return object, Objeto da classe TaxReformIntegrativeClassifierSystax
/*/
method setData(cValue as character) as object class TaxReformIntegrativeClassifierSystax
    self:cData := cValue

    // B1: resetar estado para suporte a multiplos JSONs no mesmo objeto
    // (TesteNcmReforma chama setData 3x sobre o mesmo objeto em modo lote)
    fwFreevar(self:jTaxesReturn)
    self:jTaxesReturn         := jsonObject():new()
    self:lIntegrativeNCM      := .F.
    self:lIntegrativeAliquot  := .F.
    self:lIntegrativeBaseCalc := .F.
    self:lIntegrativeWriting  := .F.
    self:lIntegrativeCalcRule := .F.
    self:nContAliquot         := 0
    self:nContBaseCalc        := 0
    self:nContRulesPauta      := 0
    self:nContTax             := 0
    self:aRegisterWriting     := {}
    self:aRegisterCalcRule    := {}
    asize(self:aRegisterAliquot, 0)
    asize(self:aRegisterBase, 0)

    self:setJsonData()

return self

/*/{Protheus.doc} getData
Metodo para retornar o dado caracter com o conteudo json recebido
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@return character, conteudo json recebido armazenado na classe
/*/
method getData() as character class TaxReformIntegrativeClassifierSystax
return self:cData

/*/{Protheus.doc} setJsonData
Método para converter dados recebidos em json
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@return logical, indica se o conteúdo enviado esta pronto para ser processado
/*/
method setJsonData() as logical class TaxReformIntegrativeClassifierSystax
    local cError as character

    // Guard de dicionario: CJG_IDCENR e usado mais adiante na cadeia de gravacao
    // (saveCalcRule -> FISGravaRegra:GetPerfis) para localizar os perfis do cenario
    // da Reforma. Sem o campo, a gravacao falharia com erro de SQL (coluna
    // inexistente) em vez de um erro de negocio tratavel.
    if !fisExtCmp('12.1.2510', .T., 'CJG', 'CJG_IDCENR')
        self:lReady := .F.
        self:setError(STR0246) // "Dicionario desatualizado. Verifique as atualizacoes da Classificacao Tributaria"
        return self:lReady
    endif

    if valType(self:jData) == "J"
        fwFreeObj(self:jData)         
        self:jData := jsonObject():new()
    endif

    cError := self:jData:fromJson(self:cData)

    if !empty(cError) .or. !self:getJsonData():hasProperty("cenario")
        self:lReady := .F.
        self:setError("Erro ao converter o conteúdo recebido em json ou o conteúdo recebido não é um json válido. " + allToChar(cError))
    else
        self:lReady := .T.
        self:organizeJson()
    endif

return self:lReady

/*/{Protheus.doc} setRelationTaxProtheusAndSystax
método para definir o relacionamento de tributos do Protheus e Systax
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
/*/
method setRelationTaxProtheusAndSystax() class TaxReformIntegrativeClassifierSystax
    self:aRelationTaxProtheusAndSystax :={  {"ibsest"   , "ibsuf"   , "ibserg"},; // IBS ESTADUAL - Imposto sobre Bens e Serviços Estadual
                                            {"ibsest"   , "ibs"     , "ibserg"},; // IBS ESTADUAL - Imposto sobre Bens e Serviços Estadual
                                            {"cbsfed"   , "cbs"     , "cbsreg"},; // CBS FEDERAL - Contribuição sobre Bens e Serviços Federal
                                            {"isfed"    , "is"      , ""      },; // IS - Imposto Seletivo
                                            {"ibserg"   , "ibsuf"   , ""      },; // IBS ESTADUAL REGULAR - reverso p/ resolucao do tributo Systax na formula de base
                                            {"ibserg"   , "ibs"     , ""      },; // IBS ESTADUAL REGULAR - reverso
                                            {"cbsreg"   , "cbs"     , ""      } } // CBS REGULAR - reverso
                                            // ibsmun removido - Classificacao Tributaria nao trata Servicos (IBS Municipal). Ref.: // IBS MUNICIPAL - Imposto sobre Bens e Serviços Municipal

return

