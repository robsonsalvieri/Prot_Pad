/*/{Protheus.doc} getBaseCalc
Metodo para extrair a base de calculo do tributo Systax, percorrendo recursivamente as tags mapeadas
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@param jTaxSystax, json, objeto json com os dados do tributo
@return character, codigo da base de calculo encontrada
/*/
method getBaseCalc(jTaxSystax as json) as character class TaxReformIntegrativeClassifierSystax

    local cBaseCalc as character
    local nT, nX as numeric
    local aTaxes as array

    aTaxes := jTaxSystax:getNames()

    for nT := 1 to len(aTaxes)
        if valType(jTaxSystax[aTaxes[nT]]) == "J"
            cBaseCalc := self:getBaseCalc(jTaxSystax[aTaxes[nT]])
        else
            if (nX := ascan(self:aBaseCalcTags,{|x| x == aTaxes[nT]})) > 0
                cBaseCalc := cValToChar(jTaxSystax[self:aBaseCalcTags[nX]])
            endif
        endif

        if !empty(cBaseCalc)
            exit
        endif
    next nT

    asize(aTaxes,0)

return cBaseCalc

/*/{Protheus.doc} mountCalcBase
método para montar a fórmula de base de cálculo, utilizando o componente RuleBaseCalc da Systax
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@param nCodigo, numeric, código da base de cálculo
@param cTax, character, tributo a ser processado
@param oRuleBaseCalc, object, objeto do componente RuleBaseCalc da Systax
@return character, fórmula de base de cálculo montada
/*/
method mountCalcBase(nCodigo as numeric, cTax as character, oRuleBaseCalc as object) as character class TaxReformIntegrativeClassifierSystax
    local jFormula as json //Objeto json com base de cálculo
    local cTaxSystax as character //Tributo Systax
    local cFormula   as character //Fórmula
    local cDescricao as character //Descrição
    local lFormulaReformaTributaria := .T. as logical

    cTaxSystax := self:taxesConvert('',cTax)

    jFormula := oRuleBaseCalc:FISGetformulaBase(nCodigo, cTaxSystax, self:cMockServer, nil, lFormulaReformaTributaria)

    if valType(jFormula) == "J"

        if jFormula:hasProperty('bcComposicao')

            cDescricao := DECODEUTF8(jFormula["bcComposicao"][1]["descricao"], "CP1252")

            cFormula := jFormula["bcComposicao"][1]["formulaBC"]

        endif

        cFormula := oRuleBaseCalc:FisDeParaformula(cFormula)

    endif

    fwFreevar(jFormula)

return cFormula

/*/{Protheus.doc} processAliquot
método para processar dados de cadastro de Alíquota
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@param jTax, json, objeto json com os dados do tributo
@return json, objeto json com os dados de cadastro de Alíquota
/*/
method processAliquot(jProtheus as json, jTaxSystax as json, cTax as character) as json class TaxReformIntegrativeClassifierSystax
    local aAliquot := self:getAliquot(jTaxSystax) as array // Dados da alíquota
    local cAliquot as character
    local cAliquotType as character
    local jAliquot  as json // Objeto json com alíquota
    local cProperty as character // Propriedade do tributo
    local cCodigo   as character // Código do tributo 
    local cDescription as character
    
    if valType(aAliquot) == "A" .and. len(aAliquot) == 2 .and. !empty(aAliquot[1]) .and. !empty(aAliquot[2])
        cAliquot := aAliquot[1]
        cAliquotType := aAliquot[2]

        cProperty := 'aliquot'

        cCodigo := 'aliquot_' + md5(cAliquot)

        self:addProperty(jProtheus, cProperty)

        if !jProtheus[cProperty]:hasProperty(cCodigo)
            self:nContAliquot := self:nContAliquot + 1
            
            jProtheus[cProperty][cCodigo] := jsonObject():new()
            jAliquot := jProtheus[cProperty][cCodigo]

            cDescription := "Aliquota " + cValtochar(val(cAliquot))

            if cAliquotType == ALIQUOT_TYPE_PERCENTAGE
                cDescription += "%"
            endif

            jAliquot["descricao"] := cDescription
            jAliquot["val_origem"] := "04" //formula
            jAliquot["tp_aliquota"] := cAliquotType
            jAliquot["aliquota"] := cAliquot            
        endif
    endif

    self:addAliquot(jProtheus, jTaxSystax, cTax)

return jProtheus

/*/{Protheus.doc} setAliquotTags
Metodo para definir as tags de extracao de aliquota dos tributos da Reforma e seus respectivos tipos
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
/*/
method setAliquotTags() class TaxReformIntegrativeClassifierSystax

    self:aAliquotTags := {}
    aadd(self:aAliquotTags, {"pIBSUF", ALIQUOT_TYPE_PERCENTAGE}) // Alíquota (em %)
    aadd(self:aAliquotTags, {"pIBSMun", ALIQUOT_TYPE_PERCENTAGE}) // Alíquota (em %)
    aadd(self:aAliquotTags, {"pCBS", ALIQUOT_TYPE_PERCENTAGE}) // Alíquota (em %)
    aadd(self:aAliquotTags, {"pAliq", ALIQUOT_TYPE_UNIT_OF_MEASURE}) // Alíquota (em R$)
    aadd(self:aAliquotTags, {"pAliqEfet", ALIQUOT_TYPE_PERCENTAGE}) // Alíquota efetiva que do IBS de competência das UF que será aplicada a base de cálculo (em %)
    aadd(self:aAliquotTags, {"aliquotaAdRem", ALIQUOT_TYPE_UNIT_OF_MEASURE}) // Alíquota por unidade de medida (em R$)
    aadd(self:aAliquotTags, {"aliquotaAdRemReten", ALIQUOT_TYPE_UNIT_OF_MEASURE}) // Alíquota por unidade de medida com retenção (em R$)
    aadd(self:aAliquotTags, {"pAliqEfetRegCBS", ALIQUOT_TYPE_PERCENTAGE}) // Valor da alíquota efetiva da tributação regular do CBS 
    aadd(self:aAliquotTags, {"pCBSUF", ALIQUOT_TYPE_PERCENTAGE}) // Alíquota (em %)
    aadd(self:aAliquotTags, {"pAliqEfetRegIBSUF", ALIQUOT_TYPE_PERCENTAGE}) // Valor da alíquota efetiva da tributação regular do IBS

return

/*/{Protheus.doc} getAliquot
Metodo para extrair a aliquota do tributo Systax, percorrendo recursivamente as tags mapeadas
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@param jTaxSystax, json, objeto json com os dados do tributo
@return array, array no formato {cAliquota, cTipoAliquota}
/*/
method getAliquot(jTaxSystax as json) as array class TaxReformIntegrativeClassifierSystax

    local aAliquot as array
    local cAliquot as character
    local cAliquotType as character
    local nT, nX as numeric
    local aTaxes as array

    aTaxes := jTaxSystax:getNames()

    for nT := 1 to len(aTaxes)
        if valType(jTaxSystax[aTaxes[nT]]) == "J"             
            aAliquot := self:getAliquot(jTaxSystax[aTaxes[nT]])
            cAliquot := aAliquot[1]
            cAliquotType := aAliquot[2]
        else
            if (nX := ascan(self:aAliquotTags,{|x| x[1] == aTaxes[nT]})) > 0
                cAliquot := cValToChar(jTaxSystax[self:aAliquotTags[nX][1]])
                cAliquotType := self:aAliquotTags[nX][2]
            endif
        endif

        if !empty(cAliquot) .and. !empty(cAliquotType)
            exit
        endif
    next nT

    asize(aTaxes,0)

return {cAliquot, cAliquotType}

/*/{Protheus.doc} AddAliquot
método para adicionar os dados de cadastro de alíquota e que serão utilizados com indice de NCM no objeto json jProtheus
Cadastros genéricos que serão utilizados com indice de NCM
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@param jProtheus, json, objeto json com os dados do tributo
@return json, objeto json com os dados de cadastro de alíquota
/*/
method addAliquot(jProtheus as json, jTaxSystax as json, cTax as character) as json class TaxReformIntegrativeClassifierSystax
    local jAliquot as json //Objeto json com alíquota
    local cProperty as character //Propriedade do tributo
    local cCodigo as character //Código do tributo
    
    if self:lIntegrativeNCM

        if jTaxSystax:hasproperty('valorPauta')

            cProperty := 'aliquot'

            self:addProperty(jProtheus, cProperty)
            
            cCodigo := 'aliquot_' + md5('INDPTA')        
            jProtheus[cProperty][cCodigo] := jsonObject():new()
            jAliquot := jProtheus[cProperty][cCodigo]      

            jAliquot[ 'descricao' ] := 'Alíquota de indice de pauta'
            jAliquot[ 'val_origem' ] := '06' //formula
            jAliquot[ 'tp_aliquota' ] := ALIQUOT_TYPE_PERCENTAGE    
            jAliquot[ 'formula' ] := 'I:PAUTA'
        endif

    endif

return jProtheus

/*/{Protheus.doc} validateReceivedData
método para validar os dados recebidos da Systax, verificando se os campos obrigatórios estão preenchidos e se os dados existem nas tabelas do Protheus
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026  
@return logical, indica se os dados recebidos são válidos ou não
/*/
method validateReceivedData() as logical class TaxReformIntegrativeClassifierSystax
    local cCodeNcm := self:getNcm() as character
    local cFederativeUnitOrigin := self:getFederativeUnitOrigin() as character
    local cFederativeUnitDestination := self:getFederativeUnitDestination() as character
    local cOriginProduct := self:getOriginProduct() as character
    local jRule := self:getRule() as json
    local lReturn := .T. as logical

    if (empty(cCodeNcm) .or. empty(cFederativeUnitOrigin) .or. empty(cFederativeUnitDestination) .or. empty(cOriginProduct) .or. valType(jRule) != "J" )
        self:setError("Dados recebidos inválidos, verifique o preenchimento do NCM, estado de origem, estado de destino, origem do produto e regra")
        lReturn := .F.
    endif
    
    if lReturn .and. !empty(cCodeNcm) .and. cCodeNcm != "00000000" .and. memoryCache("NCM_" + cCodeNcm,,{|| !existCpo("SYD",cCodeNcm)},.T.)
        self:setError("NCM não cadastrado: " + cCodeNcm)
        lReturn := .F.        
    endif

    if lReturn .and. !empty(cFederativeUnitOrigin) .and. memoryCache("UF_" + cFederativeUnitOrigin,,{|| !existCpo("SX5","12" + cFederativeUnitOrigin)},.T.)
        self:setError("Estado de origem não cadastrado: " + cFederativeUnitOrigin)
        lReturn := .F.        
    endif

    if lReturn .and. !empty(cFederativeUnitDestination) .and. memoryCache("UF_" + cFederativeUnitDestination,,{|| !existCpo("SX5","12" + cFederativeUnitDestination)},.T.)
        self:setError("Estado de destino não cadastrado: " + cFederativeUnitDestination)
        lReturn := .F.
    endif

    if lReturn .and. !empty(cOriginProduct) .and. memoryCache("Origin_" + cOriginProduct,,{||! existCpo("SX5","S0" + cOriginProduct)},.T.)   
        self:setError("Origem do produto não cadastrada: " + cOriginProduct)
        lReturn := .F.
    endif

return lReturn

/*/{Protheus.doc} validTaxes
método para validar os tributos aceitos para importação
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@param cTax, character, tributo a ser validado
@return logical, indica se o tributo é válido ou não
/*/
method validTaxes(cTax as character) as logical class TaxReformIntegrativeClassifierSystax
    local lValid as logical

    if !empty(cTax) 
        if memoryCache(cTax,,{|| existCpo("F2E",upper(cTax),2)},.T.)    
            lValid := .T.
        endif
    endif

return lValid

/*/{Protheus.doc} taxesConvert
método para converter os tributos para o formato do Protheus legado (id_totvs)
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@param cSystax, character, tributo da Systax a ser convertido
@param cProtheus, character, tributo do Protheus a ser convertido
@return character, tributo convertido
/*/
method taxesConvert(cSystax as character, cProtheus as character) as character class TaxReformIntegrativeClassifierSystax
    local cRet as character
    local nX as numeric

    default cProtheus := ""
    default cSystax := ""

    cProtheus := lower(cProtheus)
    cSystax := lower(cSystax)

    if !empty(cProtheus)
        
        if (nX := ascan(self:aRelationTaxProtheusAndSystax,{|x| x[1] == cProtheus})) > 0
            cRet := self:aRelationTaxProtheusAndSystax[nX][2]
        endif
    
    elseif !empty(cSystax)

        if (nX := ascan(self:aRelationTaxProtheusAndSystax,{|x| x[2] == cSystax})) > 0
            cRet := self:aRelationTaxProtheusAndSystax[nX][1]
        endif

    endif

return cRet

/*/{Protheus.doc} convertValue
método para converter o valor para o formato correto
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@param xValue, variant, valor a ser convertido
@return variant, valor convertido
/*/
method convertValue(xValue as variant) as numeric class TaxReformIntegrativeClassifierSystax
    local nRet as numeric

    if valType(xValue) == "N"
        nRet := xValue
    else
        nRet := val(xValue)
    endif
    
return nRet

/*/{Protheus.doc} mountVigencia
método para montar a vigência do tributo
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@param jTaxSystax, json, objeto json com os dados do tributo
@param cChave, character, chave do tributo
/*/
method mountVigencia(jTaxSystax as json, cChave as character) as character class TaxReformIntegrativeClassifierSystax
    local cVigencia as character
    local cData   as character

    if jTaxSystax:hasProperty(cChave)
        cData := jTaxSystax[ cChave ]
        cVigencia := substr( cData, 9, 2 ) + '/' + substr( cData, 6, 2 ) + '/' + substr(cData, 1, 4 )
    endif

return cVigencia

/*/{Protheus.doc} recordTaxes
método para gravar os dados processados e organizados no Protheus
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026 
@return logical, indica se os dados foram gravados com sucesso ou não
/*/
method recordTaxes() as logical class TaxReformIntegrativeClassifierSystax
    local lReturn := .T. as logical

    lReturn := self:saveNCM()

    if lReturn
        lReturn := self:saveBaseCalc()
    endif

    if lReturn
        lReturn := self:saveAliquot()
    endif

    if lReturn
        lReturn := self:saveWriting()
    endif

    if lReturn
        lReturn := self:saveCalcRule()
    endif

return lReturn

/*/{Protheus.doc} saveNCM
método para gravar os dados de cadastro de NCM no Protheus
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@return logical, indica se os dados foram gravados com sucesso ou não
/*/
method saveNCM() as logical class TaxReformIntegrativeClassifierSystax
    local oRecordTaxesNCM as object
    local lReturn := .T. as logical

    if self:getIntegrativeNCM()
        oRecordTaxesNCM := RecordTaxesNCM():new(self:jTaxesReturn:toJSON())
        if !oRecordTaxesNCM:recordTaxes()
            self:setError(oRecordTaxesNCM:getError())        
            lReturn := .F.
        endif

        self:aNCMs := oRecordTaxesNCM:aNCMs
        
        oRecordTaxesNCM:destroy()        
        freeObj( oRecordTaxesNCM )
        oRecordTaxesNCM := nil
    endif
    
return lReturn

/*/{Protheus.doc} saveAliquot
método para gravar os dados de cadastro de alíquota no Protheus
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@return logical, indica se os dados foram gravados com sucesso ou não    
/*/
method saveAliquot() as logical class TaxReformIntegrativeClassifierSystax
    local oRecordTaxesAliquot as object
    local lReturn := .T. as logical

    if self:getIntegrativeAliquot()
        oRecordTaxesAliquot := FISGravAliquota():new()

        self:aRegisterAliquot := oRecordTaxesAliquot:gravaDadosjson(self:jTaxesReturn:toJSON())

        if Len(self:aRegisterAliquot) == 0
            self:setError('Erro ao gravar aliquotas')
            lReturn := .F.
        endif

        self:aAliquotas := oRecordTaxesAliquot:aAliquotas
                
        freeObj( oRecordTaxesAliquot )
        oRecordTaxesAliquot := nil
    endif
    
return lReturn

/*/{Protheus.doc} saveBaseCalc
método para gravar os dados de cadastro de base de cálculo no Protheus
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026 
@return logical, indica se os dados foram gravados com sucesso ou não
/*/
method saveBaseCalc() as logical class TaxReformIntegrativeClassifierSystax
    local oRecordTaxesbaseCalc as object
    local lReturn := .T. as logical

    if self:getIntegrativeBaseCalc()
        oRecordTaxesbaseCalc := FISGravaBase():new()

        self:aRegisterBase := oRecordTaxesbaseCalc:gravaDadosjson(self:jTaxesReturn:toJSON())
        
        if Len(self:aRegisterBase) == 0
            self:setError('Erro ao gravar base de calculo')  
            lReturn := .F.
        endif

        self:aBases := oRecordTaxesbaseCalc:aBases
                
        freeObj( oRecordTaxesbaseCalc )
        oRecordTaxesbaseCalc := nil
    endif
    
return lReturn

/*/{Protheus.doc} processTaxCalc
Método marcador: sinaliza que o tributo possui dados suficientes para Regra de Cálculo.
Só marca se há alíquota e base presentes — ambos necessarios para F2B.
A gravação efetiva ocorre em saveCalcRule() após todos os tributos serem processados.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@param jProtheus, json, Json com os dados do tributo no Configurador
@param jTaxSystax, json, Json com os dados do tributo da Systax
@param cTax, character, tributo a ser processado
@return json, Json com marcador calcRule adicionado
/*/
method processTaxCalc(jProtheus as json, jTaxSystax as json, cTax as character) as json class TaxReformIntegrativeClassifierSystax
    local cProperty as character
    local cCodigo as character

    // Só marca se há alíquota e base — necessarios para Regra de Calculo
    if jProtheus:hasProperty("aliquot") .and. jProtheus:hasProperty("baseCalc")
        cProperty := "calcRule"
        cCodigo   := "calc_" + md5(cTax)

        self:addProperty(jProtheus, cProperty)

        if !jProtheus[cProperty]:hasProperty(cCodigo)
            jProtheus[cProperty][cCodigo] := jsonObject():new()
            jProtheus[cProperty][cCodigo]["tributo"] := cTax
        endif
    endif

return jProtheus

/*/{Protheus.doc} processTribRegular
Metodo para processar o grupo gTribRegular (tributacao regular) presente nos tributos
ibs/cbs de produtos com tipoRegra "ESP". Gera um conjunto proprio de regras (base,
aliquota, escrituracao e calculo) sob o tributo regular correspondente (ex: ibserg / cbsreg),
que ja existem cadastrados na F2E. Assim as classes gravadoras (FISGravaBase, FISGravAliquota,
FISGravaCST e FISGravaRegra) geram as 4 regras sem necessidade de ajuste, pois o tributo
regular e distinto do tributo especial.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 04/08/2026
@param jProtheus, json, no do NCM em jTaxesReturn (recebe o no irmao do tributo regular)
@param jTaxSystax, json, objeto json do tributo Systax (ibs/cbs) que pode conter gTribRegular
@param cTax, character, tributo Protheus principal (ex: ibsest, cbsfed)
@return json, no do NCM atualizado com o tributo regular
/*/
method processTribRegular(jProtheus as json, jTaxSystax as json, cTax as character) as json class TaxReformIntegrativeClassifierSystax
    local cTaxReg as character
    local jTribRegular as json
    local jReg as json

    cTaxReg := self:getRegularTax(cTax)

    // Sem tributo regular mapeado ou sem grupo gTribRegular no retorno: nada a fazer
    if empty(cTaxReg) .or. !jTaxSystax:hasProperty("gTribRegular")
        return jProtheus
    endif

    jTribRegular := jTaxSystax["gTribRegular"]

    if valType(jTribRegular) != "J"
        return jProtheus
    endif

    // O tributo regular precisa existir no Configurador de Tributos (F2E)
    if !self:validTaxes(cTaxReg)
        return jProtheus
    endif

    // Cria o no do tributo regular como irmao do tributo principal sob o NCM
    if !jProtheus:hasProperty(cTaxReg)
        jProtheus[cTaxReg] := jsonObject():new()
        self:nContTax := self:nContTax + 1
    endif

    jReg := jProtheus[cTaxReg]

    // Regra de base (baseCalculoReg) - reutiliza o mesmo tratamento do tributo principal
    self:processBaseCalc(jReg, jTribRegular, cTaxReg)

    // Regra de aliquota (aliquota nominal da tributacao regular)
    self:addAliquotTribRegular(jReg, jTribRegular, cTaxReg)

    // Regra de escrituracao (cstReg / cClassTribReg)
    self:addWritingTribRegular(jReg, jTribRegular, cTaxReg)

    // Regra de calculo - marcada somente se houver aliquota e base no no regular
    self:processTaxCalc(jReg, jTribRegular, cTaxReg)

return jProtheus

/*/{Protheus.doc} getRegularTax
Metodo para retornar o tributo Protheus regular correspondente ao tributo informado,
conforme a 3a coluna da relacao aRelationTaxProtheusAndSystax.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 04/08/2026
@param cTax, character, tributo Protheus principal (ex: ibsest, cbsfed)
@return character, tributo Protheus regular (ex: ibserg, cbsreg) ou vazio quando nao houver
/*/
method getRegularTax(cTax as character) as character class TaxReformIntegrativeClassifierSystax
    local cRet as character
    local nX as numeric

    cTax := lower(cTax)

    nX := ascan(self:aRelationTaxProtheusAndSystax, {|x| len(x) >= 3 .and. lower(x[1]) == cTax .and. !empty(x[3])})

    if nX > 0
        cRet := self:aRelationTaxProtheusAndSystax[nX][3]
    endif

return cRet

/*/{Protheus.doc} addAliquotTribRegular
Metodo para adicionar a aliquota da tributacao regular no no do tributo regular.
Utiliza a aliquota nominal (IBS: pIBSUF, CBS: pCBSUF), com fallback para a aliquota
efetiva regular (pAliqEfetRegIBSUF / pAliqEfetRegCBS) quando a nominal nao vier no retorno.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 04/08/2026
@param jProtheus, json, no do tributo regular
@param jTribRegular, json, objeto json do grupo gTribRegular
@param cTax, character, tributo regular (ex: ibserg, cbsreg)
@return json, no do tributo regular atualizado
/*/
method addAliquotTribRegular(jProtheus as json, jTribRegular as json, cTax as character) as json class TaxReformIntegrativeClassifierSystax
    local cAliquotTag as character
    local cAliquot as character
    local cAliquotType as character
    local cCodigo as character
    local cProperty as character
    local jAliquot as json
    local nX as numeric
    local cDescription as character

    do case
        case jTribRegular:hasProperty("pIBSUF")
            cAliquotTag := "pIBSUF"
        case jTribRegular:hasProperty("pCBSUF")
            cAliquotTag := "pCBSUF"
        case jTribRegular:hasProperty("pAliqEfetRegIBSUF")
            cAliquotTag := "pAliqEfetRegIBSUF"
        case jTribRegular:hasProperty("pAliqEfetRegCBS")
            cAliquotTag := "pAliqEfetRegCBS"
    endcase

    if (nX := ascan(self:aAliquotTags,{|x| x[1] == cAliquotTag})) > 0
        cAliquot := cValToChar(jTribRegular[self:aAliquotTags[nX][1]])
        cAliquotType := self:aAliquotTags[nX][2]
    endif

    if !empty(cAliquot) .and. !empty(cAliquotType)
        cProperty := "aliquot"
        cCodigo   := "aliquot_" + md5(cAliquot)

        self:addProperty(jProtheus, cProperty)

        if !jProtheus[cProperty]:hasProperty(cCodigo)
            self:nContAliquot := self:nContAliquot + 1

            jProtheus[cProperty][cCodigo] := jsonObject():new()
            jAliquot := jProtheus[cProperty][cCodigo]

            cDescription := "Aliquota " + alltrim(cValToChar(val(cAliquot)))

            if cAliquotType == ALIQUOT_TYPE_PERCENTAGE
                cDescription += "%"
            endif

            jAliquot["descricao"]   := cDescription
            jAliquot["val_origem"]  := "04"
            jAliquot["tp_aliquota"] := cAliquotType
            jAliquot["aliquota"]    := cAliquot
        endif
    endif

return jProtheus

/*/{Protheus.doc} addWritingTribRegular
Metodo para adicionar a escrituracao (CST) da tributacao regular no no do tributo regular,
a partir das tags cstReg e cClassTribReg do grupo gTribRegular.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 04/08/2026
@param jProtheus, json, no do tributo regular
@param jTribRegular, json, objeto json do grupo gTribRegular
@param cTax, character, tributo regular (ex: ibserg, cbsreg)
@return json, no do tributo regular atualizado
/*/
method addWritingTribRegular(jProtheus as json, jTribRegular as json, cTax as character) as json class TaxReformIntegrativeClassifierSystax
    local cCST       as character
    local cClassTrib as character
    local cDispLegal as character
    local nPcRed     as numeric
    local cProperty  as character
    local cCodigo    as character
    local jWriting   as json

    if !jTribRegular:hasProperty("cstReg")
        return jProtheus
    endif

    cCST := cValToChar(jTribRegular["cstReg"])

    if jTribRegular:hasProperty("cClassTribReg")
        cClassTrib := cValToChar(jTribRegular["cClassTribReg"])
    endif

    if jTribRegular:hasProperty("dispositivoLegal")
        cDispLegal := jTribRegular["dispositivoLegal"]
    endif

    if jTribRegular:hasProperty("pRedAliq")
        nPcRed := jTribRegular["pRedAliq"]
    endif

    if !empty(cCST)
        cCST := padL(cCST, FWSX3Util():getFieldStruct("CKB_CST")[3], "0")

        if !empty(cClassTrib)
            cClassTrib := padL(cClassTrib, FWSX3Util():getFieldStruct("CKB_CSTCCT")[3], "0")
        endif

        cProperty := "writing"
        cCodigo   := "writing_" + md5(cTax + cCST)

        self:addProperty(jProtheus, cProperty)

        if !jProtheus[cProperty]:hasProperty(cCodigo)
            jProtheus[cProperty][cCodigo] := jsonObject():new()
            jWriting := jProtheus[cProperty][cCodigo]

            jWriting["cst"]        := cCST
            jWriting["tributo"]    := cTax
            jWriting["ent_sai"]    := self:nEntSai
            jWriting["disp_legal"] := cDispLegal
            jWriting["pRedAliq"]   := nPcRed
            jWriting["cstcct"]     := cClassTrib
        endif
    endif

return jProtheus

/*/{Protheus.doc} processFiscalWriting
Método para processar dados de cadastro de Escrituração Fiscal
Extrai o CST do tributo Systax e armazena em jProtheus["writing"] para posterior gravacao.
Q5: quando jTaxSystax nao possui "operacao" nem "credito" (chamada via addTaxes com jScenario),
retorna jProtheus inalterado (no-op seguro).
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@param jProtheus, json, Json com os dados do tributo no Configurador
@param jTaxSystax, json, Json com os dados do tributo da Systax
@param cTax, character, tributo a ser processado (ibsest, cbsfed, isfed, ibsmun)
@return json, Json com os dados de escrituração adicionados
/*/
method processFiscalWriting(jProtheus as json, jTaxSystax as json, cTax as character) as json class TaxReformIntegrativeClassifierSystax
    local cCST               as character
    local cClassTrib         as character
    local nPcRed             as numeric
    local cDispLegal         as character
    local cProperty          as character
    local cCodigo            as character
    local jWriting           as json
    local lEntrada           as logical
    local jSubTax            as json

    // Q5: guard no-op - jTaxSystax sem operacao/credito: chamada via addTaxes com jScenario inteiro
    if !jTaxSystax:hasProperty("operacao") .and. !jTaxSystax:hasProperty("credito")
        return jProtheus
    endif

    lEntrada := (self:nEntSai == 1 .or. self:nEntSai == 4)

    if lEntrada
        if jTaxSystax:hasProperty("credito")
            jSubTax := jTaxSystax["credito"]
            if jSubTax:hasProperty("cstEntrada")
                cCST := cValToChar(jSubTax["cstEntrada"])
                if jSubTax:hasProperty("dispositivoLegal")
                    cDispLegal := jSubTax["dispositivoLegal"]
                endif
            endif
        endif
        // cClassTrib e pRedAliq ficam na sub-estrutura "operacao" mesmo para entradas
        if jTaxSystax:hasProperty("operacao")
            if jTaxSystax["operacao"]:hasProperty("cClassTrib")
                cClassTrib := cValToChar(jTaxSystax["operacao"]["cClassTrib"])
            endif
            if jTaxSystax["operacao"]:hasProperty("pRedAliq")
                nPcRed := jTaxSystax["operacao"]["pRedAliq"]
            endif
        endif
    else
        if jTaxSystax:hasProperty("operacao")
            jSubTax := jTaxSystax["operacao"]
            if jSubTax:hasProperty("cst")
                cCST := cValToChar(jSubTax["cst"])
                if jSubTax:hasProperty("dispositivoLegal")
                    cDispLegal := jSubTax["dispositivoLegal"]
                endif
                if jSubTax:hasProperty("cClassTrib")
                    cClassTrib := cValToChar(jSubTax["cClassTrib"])
                endif
                if jSubTax:hasProperty("pRedAliq")
                    nPcRed := jSubTax["pRedAliq"]
                endif
            endif
        endif
    endif

    if !empty(cCST)
        cCST := padL(cCST, FWSX3Util():getFieldStruct("CKB_CST")[3], "0")
    
        if !empty(cClassTrib)
            cClassTrib := padL(cClassTrib, FWSX3Util():getFieldStruct("CKB_CSTCCT")[3], "0")
        endif
        
        cProperty := "writing"
        cCodigo   := "writing_" + md5(cTax + cCST)

        self:addProperty(jProtheus, cProperty)

        if !jProtheus[cProperty]:hasProperty(cCodigo)
            jProtheus[cProperty][cCodigo] := jsonObject():new()
            jWriting := jProtheus[cProperty][cCodigo]

            jWriting["cst"]        := cCST
            jWriting["tributo"]    := cTax
            jWriting["ent_sai"]    := self:nEntSai
            jWriting["disp_legal"] := cDispLegal
            jWriting["pRedAliq"]   := nPcRed
            jWriting["cstcct"]     := cClassTrib
        endif
    endif

return jProtheus

/*/{Protheus.doc} saveWriting
Método para gravar os dados de cadastro de Escrituração no Protheus via FISGravaCST.
Q2: aborta (lReturn=.F.) se nenhuma escrituração for gravada.
Q3: passa lIpi:=.F., lIcms:=.F. para processar todos tributos da Reforma sem filtro.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@return logical, indica se os dados foram gravados com sucesso ou não
/*/
method saveWriting() as logical class TaxReformIntegrativeClassifierSystax
    local oFISGravaCST as object
    local lReturn := .T. as logical

    if self:getIntegrativeWriting()
        oFISGravaCST := FISGravaCST():new()

        // gravaDadosjson itera jTaxesReturn (ncm->tributo->writing) e chama FisGrvCST
        // internamente resolve tabela CST via GetCCT (Reforma) ou GetTabCST (legado)
        self:aRegisterWriting := oFISGravaCST:gravaDadosjson(self:jTaxesReturn:toJSON())

        // Q2: abortar se nenhuma escrituracao foi gravada
        if len(self:aRegisterWriting) == 0
            self:setError("Erro ao gravar regras de escrituracao")
            lReturn := .F.
        endif

        self:aEscrituracoes := oFISGravaCST:aEscrituracoes

        freeObj(oFISGravaCST)
        oFISGravaCST := nil
    endif

return lReturn

/*/{Protheus.doc} montaJsonCenarioPerfis
Método para montar o JSON de cenário usado em GetPerfis e GravaPerfilOrigemEDestino.
Lê os dados do cenário diretamente do NCM em jTaxesReturn (Q1: suporte a multiplos cenarios).
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@param cNCM, character, código do NCM para ler os dados do cenário
@return json, objeto json com uf_origem, uf_destino, id_cenario, cod_natureza_operacao, finalidade
/*/
method montaJsonCenarioPerfis(cNCM as character) as json class TaxReformIntegrativeClassifierSystax
    local jCenario as json
    local jNCM     as json

    jCenario := jsonObject():new()

    if self:jTaxesReturn["ncm"]:hasProperty(cNCM)
        jNCM := self:jTaxesReturn["ncm"][cNCM]

        jCenario["uf_origem"]             := jNCM["cFederativeUnitOrigin"]
        jCenario["uf_destino"]            := jNCM["cFederativeUnitDestination"]
        jCenario["id_cenario"]            := jNCM["cIdCenario"]
        jCenario["cod_natureza_operacao"] := jNCM["cNaturezaOperacao"]
        jCenario["finalidade"]            := jNCM["cFinalidade"]  // Q4: pode ser ""
        jCenario["apelido"]               := jNCM["cApelidoCenario"]
    endif

return jCenario

/*/{Protheus.doc} saveCalcRule
Método para gravar os dados de Regra de Cálculo no Protheus via FISGravaRegra.
Q1: lê dados do cenário do NCM (não do campo privado sobrescrito).
Q4: cFinalidade pode ser "" — gravaPerfOperacao aceita normalmente.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@return logical, indica se os dados foram gravados com sucesso ou não
/*/
method saveCalcRule() as logical class TaxReformIntegrativeClassifierSystax
    local oFISGravaRegra as object
    local jPayload       as json
    local lReturn        := .T. as logical

    if !self:getIntegrativeCalcRule()
        return lReturn
    endif

    oFISGravaRegra := FISGravaRegra():new()

    // Montar payload: jTaxesReturn + arrays de registro das regras ja gravadas
    // gravaDadosjson precisa desses arrays para cruzar tributo+NCM e obter codigos
    jPayload := jsonObject():new()
    jPayload:fromJson(self:jTaxesReturn:toJSON())
    jPayload["aRegisterAliquot"] := self:aRegisterAliquot
    jPayload["aRegisterBase"]    := self:aRegisterBase
    jPayload["aRegisterWriting"] := self:aRegisterWriting

    // gravaDadosjson itera ncm->tributo->calcRule, resolve perfis e chama FISGravaRegra
    self:aRegisterCalcRule := oFISGravaRegra:gravaDadosjson(jPayload:toJSON())

    if len(self:aRegisterCalcRule) == 0
        self:setError("Erro ao gravar regras de calculo")
        lReturn := .F.
    endif

    self:aRegras := oFISGravaRegra:aRegras

    // Perfis resolvidos/gravados pela FISGravaRegra - necessarios para o estorno da aprovacao
    self:aOrigensEDestinos := oFISGravaRegra:aOrigensEDestinos
    self:aOperacoes := oFISGravaRegra:aOperacoes

    fwFreevar(jPayload)
    freeObj(oFISGravaRegra)
    oFISGravaRegra := nil

return lReturn

/*/{Protheus.doc} destroy
método para limpar os dados da classe TaxReformIntegrativeClassifierSystax
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 18/03/2026
@see https://tdn.totvs.com/display/tec/fwFreeObj
/*/
method destroy() class TaxReformIntegrativeClassifierSystax
    self:cError := ""
    self:cData := ""

    asize(self:aRegisterAliquot,0)
    self:aRegisterAliquot := nil

    asize(self:aRegisterBase,0)
    self:aRegisterBase := nil

    asize(self:aRegisterWriting,0)
    self:aRegisterWriting := nil

    asize(self:aRegisterCalcRule,0)
    self:aRegisterCalcRule := nil

    asize(self:aWritingTags,0)
    self:aWritingTags := nil

    asize(self:aRelationTaxProtheusAndSystax,0)
    self:aRelationTaxProtheusAndSystax := nil

    asize(self:aAliquotTags,0)
    self:aAliquotTags := nil

    asize(self:aBaseCalcTags,0)
    self:aBaseCalcTags := nil

    asize(self:aNCMs,0)
    self:aNCMs := nil

    asize(self:aBases,0)
    self:aBases := nil

    asize(self:aAliquotas,0)
    self:aAliquotas := nil

    asize(self:aEscrituracoes,0)
    self:aEscrituracoes := nil

    asize(self:aRegras,0)
    self:aRegras := nil

    asize(self:aOrigensEDestinos,0)
    self:aOrigensEDestinos := nil

    asize(self:aOperacoes,0)
    self:aOperacoes := nil

    self:cNaturezaOperacao := ""
    self:cFinalidade       := ""
    self:cApelidoCenario   := ""
    self:cIdCenario        := ""
    self:cCodProduto       := ""

    fwFreevar(self:jData)
    fwFreevar(self:jTaxesReturn)
    fwFreevar(self:jRule)

return

/*/{Protheus.doc} getProtheusTaxes
Metodo para retornar os tributos do Protheus (tributacao principal e tributacao regular)
relacionados ao tributo recebido da Systax, em letras maiusculas e separados por pipe.

Utilizado na atualizacao da regra anterior, onde o tributo gravado em F2B_TRIB
(ex: IBSEST, IBSERG, CBSFED, CBSREG, ISFED) precisa ser comparado com os tributos
que sofreram atualizacao no retorno da Systax (ex: ibs, cbs, is).
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 05/08/2026
@param cSystaxTax, character, tributo da Systax (ex: ibs, cbs, is)
@return character, tributos do Protheus separados por pipe (ex: "IBSEST|IBSERG|")
/*/
method getProtheusTaxes(cSystaxTax as character) as character class TaxReformIntegrativeClassifierSystax
    local cTaxes := "" as character
    local cTax as character
    local cTaxRegular as character
    local nX as numeric

    default cSystaxTax := ""

    cSystaxTax := lower(cSystaxTax)

    if !empty(cSystaxTax) .and. valType(self:aRelationTaxProtheusAndSystax) == "A"

        for nX := 1 to len(self:aRelationTaxProtheusAndSystax)

            if lower(self:aRelationTaxProtheusAndSystax[nX][2]) != cSystaxTax
                loop
            endif

            cTax := upper(self:aRelationTaxProtheusAndSystax[nX][1])

            if !(cTax + "|" $ cTaxes)
                cTaxes += cTax + "|"
            endif

            cTaxRegular := upper(self:aRelationTaxProtheusAndSystax[nX][3])

            if !empty(cTaxRegular) .and. !(cTaxRegular + "|" $ cTaxes)
                cTaxes += cTaxRegular + "|"
            endif

        next nX

    endif

return cTaxes
