    private method getBaseCalc(jTaxSystax as json) as character
    private method processJsonReturns(jScenario as json, jProduto as json) as json //método para processar os retornos do json    
    private method processNCM(jProtheus as json, jTaxSystax as json, cTax as character) as json //método para processar dados de cadastro de ncm
    private method taxesConvert(cTax as character) as character //método para converter os tributos para o formato do Protheus    
    private method validateReceivedData() as logical //método para validar os dados recebidos    
    private method validTaxes(cTributo as character) as logical //método para validar os tributos aceitos para importaééo

    private method setError(value as character) as object //método para receber um dado carácter com o erro ocorrido
    private method setFederativeUnitDestination(value as character) as object //método para receber um dado carácter com o estado de destino
    private method setFederativeUnitOrigin(value as character) as object //método para receber um dado carácter com o estado de origem
    private method setJsonData() as logical //método para converter dados recebidos em json
    private method setNcm(value as character) as object //método para receber um dado carácter com o ncm
    private method setOriginProduct(value) as object //método para receber um dado carácter com a origem do produto
    private method setRelationTaxProtheusAndSystax() //método para receber um dado carácter com a origem do produto
    
    public method getContNCM() as numeric //método para retornar o contador de ncm
