#include 'tlpp-core.th'
#include 'tlpp-object.th'

namespace totvs.protheus.backoffice.fiscal.Classifier

/*/{Protheus.doc} MemoInQuery
    Classe Responsavel por fazer a interface com a fucao memoinquery para ser reutilizada se forma pratica.
    @author Ricardo Henrique de Mello Lima
    @since 07/10/2025
    @version 12.1.2410
    /*/
Class MemoInQuery

	Private Data lMemoInQuery as logical 

    Public Method new() constructor
	Public Method execMemo() as character
	Public Method setMemoInquery(lValue as logical)
    Public Method close(lValue as logical)

EndClass


/*/{Protheus.doc} new
    Metodo Inicializador da Classe
    @author Ricardo Henrique de Mello Lima
    @since 07/10/2025
    @version 12.1.2410
    /*/
Method new() class MemoInQuery
    self:lMemoInQuery := .F.
Return

/*/{Protheus.doc} memoInQuery
    Metodo que verifica a chave memoinquery esta ativada caso não esteja ativa a chave
    @author Ricardo Henrique de Mello Lima
    @since 07/10/2025
    @version 12.1.2410
    @return character , indica se o DBACCESS esta com MEMOINQUERY ON | OFF
    /*/
Method execMemo() as character class MemoInQuery

    if TCConfig('GETMEMOINQUERY') == 'OFF'
       self:lMemoInQuery := .F.
        self:setMemoInQuery(.T.)
    elseif TCConfig('GETMEMOINQUERY') == 'ON'
        self:lMemoInQuery := .T.
    endif

Return TCConfig('GETMEMOINQUERY')

/*/{Protheus.doc} setMemoInQuery
    Metodo que habilita ou desabilita o memoinquery 
    @author Ricardo Henrique de Mello Lima
    @since 07/10/2025
    @version 12.1.2410
    /*/
Method setMemoInQuery(lValue as logical) class MemoInQuery
	if lValue
		TCConfig('SETMEMOINQUERY=ON')
	else
		TCConfig('SETMEMOINQUERY=OFF')
	endif
Return

/*/{Protheus.doc} close
    Metodo que encerra a operacao
    @author Ricardo Henrique de Mello Lima
    @since 07/10/2025
    @version 12.1.2410
    /*/
Method close() class MemoInQuery
    if !self:lMemoInQuery
        self:setMemoInQuery(.F.)
    endif
Return
