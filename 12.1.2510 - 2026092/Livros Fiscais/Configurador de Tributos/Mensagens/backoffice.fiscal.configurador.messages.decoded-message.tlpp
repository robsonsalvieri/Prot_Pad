#Include 'Protheus.ch'
#Include 'FWMBrowse.ch'
#Include 'FWMvcDef.ch'
#Include "FWEditPanel.ch"
#Include 'DecodedMessage.ch'
#Include 'tlpp-core.th'

Namespace totvs.protheus.backoffice.fiscal.configurador.messages.decodedmessage

Static cProgram := 'totvs.protheus.backoffice.fiscal.configurador.messages.decodedmessage.decodedMessage'

/*/{Protheus.doc} decodedMessage
Função que cria o cadastro de Mensagens Decodificadas.
@type function
@version 12.1.2410 
@author Juliano Fernandes
@since 10/06/2025
/*/
Function decodedMessage()

	Local oBrowse as object

	If ( AliasIndic('CKA') .And. AliasIndic('CJL') ) .and. (CKA->(FieldPos("CKA_CODIGO")) > 0)
		oBrowse := FWMBrowse():New()
		oBrowse:SetAlias('CKA')
		oBrowse:SetDescription(STR0001) // 'Mensagens Decodificadas'
		oBrowse:Activate()
	Else
		Help('',1,'Help','Help',STR0002,1,0) // 'Dicionário desatualizado, verifique as atualizações do motor tributário fiscal.'
	EndIf

Return

/*/{Protheus.doc} menuDef
Função que cria o menu das Mensagens Decodificadas.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 10/06/2025
@Return array, Menu das Mensagens Decodificadas.
/*/
Function menuDef() as array

	Local aMenu := {} as array

	ADD OPTION aMenu TITLE STR0003 ACTION 'VIEWDEF.' + cProgram OPERATION 2 ACCESS 0 // 'Visualizar'
	ADD OPTION aMenu TITLE STR0004 ACTION 'VIEWDEF.' + cProgram OPERATION 4 ACCESS 0 // 'Alterar'

Return aMenu

/*/{Protheus.doc} modelDef
Função que cria o modelo de dados do cadastro de Mensagens Decodificadas.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 10/06/2025
@Return object, Modelo de dados do cadastro de Mensagens Decodificadas.
/*/
Function modelDef() as object

    Local oModel as object
    Local oDecodedMessageStruct as object
	Local oMessageOriginStruct as object
    Local oMessageStruct as object

	// Cria o objeto do Modelo de Dados
	oModel := MPFormModel():New('DECODEDMESSAGE',,,{|oModel| saveDecodedMessage(oModel)})

    oDecodedMessageStruct := FWFormStruct(1,'CKA',{|cField| AllTrim(cField) != 'CKA_TRIB'})

    // Adiciona ao modelo uma estrutura de formulário de edição por campo
	oModel:AddFields('DECODEDMESSAGE',,oDecodedMessageStruct)

	oModel:GetModel("DECODEDMESSAGE"):SetOnlyView(.T.)

	oMessageOriginStruct := FWFormStruct(1,'CKA',{|cField| AllTrim(cField) == 'CKA_TRIB'})

	// Adiciona campos virtuais
	addVirtualFields(oMessageOriginStruct,'MODEL','CKA')

    // Adiciona ao modelo uma estrutura de formulário de edição por campo
	oModel:AddFields('MESSAGEORIGIN','DECODEDMESSAGE',oMessageOriginStruct)

	oModel:GetModel("MESSAGEORIGIN"):SetOnlyView(.T.)

    oMessageStruct := FWFormStruct(1,'CJL')

	// Adiciona campos virtuais
	addVirtualFields(oMessageStruct,'MODEL','CJL')	

	oMessageStruct:SetProperty('CJL_CODMSG',MODEL_FIELD_VALID,{|| validateMessageCode(oModel)})

    // Adiciona ao modelo uma estrutura de formulário de edição por campo
	oModel:AddFields('MESSAGE','DECODEDMESSAGE',oMessageStruct)

    oModel:SetRelation('MESSAGE',{{'CJL_FILIAL','FWxFilial("CJL")'},{'CJL_ID','CKA_IDMSGD'}},CJL->(IndexKey(1)))

    oModel:SetPrimaryKey({'CKA_FILIAL','CKA_ID','CKA_IDGRUP','CKA_IDMSGD','CKA_CODIGO'})

	// Adiciona a descricao do Modelo de Dados
	oModel:SetDescription(STR0001) // 'Mensagens Decodificadas'

Return oModel

/*/{Protheus.doc} viewDef
Função que cria a View do cadastro de Mensagens Decodificadas.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 10/06/2025
@Return object, View do cadastro de Mensagens Decodificadas.
/*/
Function viewDef() as object

    Local oModel := FWLoadModel(cProgram) as object
    Local oView := FWFormView():New() as object
    Local oDecodedMessageStruct as object
	Local oMessageOriginStruct as object
    Local oMessageStruct as object

    // Define qual o Modelo de dados será utilizado
	oView:SetModel(oModel)

    oDecodedMessageStruct := FWFormStruct(2,'CKA',{|cField| AllTrim(cField) != 'CKA_TRIB'})

	// Remove campos da View
	oDecodedMessageStruct:RemoveField('CKA_ID')
	oDecodedMessageStruct:RemoveField('CKA_IDGRUP')
	oDecodedMessageStruct:RemoveField('CKA_IDMSGD')
	oDecodedMessageStruct:RemoveField('CKA_CODFIN')
	oDecodedMessageStruct:RemoveField('CKA_ORIGEM')
	oDecodedMessageStruct:RemoveField('CKA_IDTRIB')

	oDecodedMessageStruct:SetProperty('CKA_CODIGO',MVC_VIEW_ORDEM,'01')
	oDecodedMessageStruct:SetProperty('CKA_CODIGO',MVC_VIEW_TITULO,STR0005) // 'Código da mensagem decodificada'
	oDecodedMessageStruct:SetProperty('CKA_CODIDE',MVC_VIEW_ORDEM,'02')
	oDecodedMessageStruct:SetProperty('CKA_CODIDE',MVC_VIEW_TITULO,STR0008) // 'Código do identificador'
	oDecodedMessageStruct:SetProperty('CKA_DESIDE',MVC_VIEW_ORDEM,'03')
	oDecodedMessageStruct:SetProperty('CKA_DESIDE',MVC_VIEW_TITULO,STR0009) // 'Descrição do identificador'

    // Adiciona no nosso View um controle do tipo FormFields(antiga enchoice)
	oView:AddField('VIEW_DECODEDMESSAGE',oDecodedMessageStruct,'DECODEDMESSAGE')

	oMessageOriginStruct := FWFormStruct(2,'CKA',{|cField| AllTrim(cField) == 'CKA_TRIB'})

	// Adiciona campos virtuais
	addVirtualFields(oMessageOriginStruct,'VIEW','CKA')

	oMessageOriginStruct:SetProperty('CKA_TRIB',MVC_VIEW_ORDEM,'07')

    // Adiciona no nosso View um controle do tipo FormFields(antiga enchoice)
	oView:AddField('VIEW_MESSAGEORIGIN',oMessageOriginStruct,'MESSAGEORIGIN')

    oMessageStruct := FWFormStruct(2,'CJL')

	// Adiciona campos virtuais
	addVirtualFields(oMessageStruct,'VIEW','CJL')	

    // Remove campos da View
    oMessageStruct:RemoveField('CJL_ID')
    oMessageStruct:RemoveField('CJL_INDICE')

	oMessageStruct:SetProperty('CJL_CODMSG',MVC_VIEW_ORDEM,'01')
	oMessageStruct:SetProperty('CJL_CODMSG',MVC_VIEW_LOOKUP,'CJ82')
	oMessageStruct:SetProperty('CJL_CODMSG',MVC_VIEW_TITULO,STR0010) // 'Código da mensagem'
	oMessageStruct:SetProperty('CJL_DESMSG',MVC_VIEW_ORDEM,'02')
	oMessageStruct:SetProperty('CJL_MENSG',MVC_VIEW_ORDEM,'03')
	oMessageStruct:SetProperty('CJL_MENSG',MVC_VIEW_TITULO,STR0006) // 'Mensagem'

	oView:AddField('VIEW_MESSAGE',oMessageStruct,'MESSAGE')

	oView:EnableTitleView('VIEW_DECODEDMESSAGE',STR0001) // 'Mensagens Decodificadas'
	oView:EnableTitleView('VIEW_MESSAGEORIGIN',STR0011) // 'Origem da Mensagem'
	oView:EnableTitleView('VIEW_MESSAGE',STR0006) // 'Mensagem'

	oView:CreateHorizontalBox('DECODEDMESSAGE',20)
	oView:CreateHorizontalBox('MESSAGEORIGIN',30)
	oView:CreateHorizontalBox('MESSAGE',50)

	oView:SetOwnerView('VIEW_DECODEDMESSAGE','DECODEDMESSAGE')
	oView:SetOwnerView('VIEW_MESSAGEORIGIN','MESSAGEORIGIN')
	oView:SetOwnerView('VIEW_MESSAGE','MESSAGE')

Return oView

/*/{Protheus.doc} saveDecodedMessage
Função que salva a Mensagem Decodificada.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 29/07/2025
@param oModel, object, Modelo de dados do cadastro de Mensagens Decodificadas.
@return logical, Retorna .T. se o cadastro foi salvo com sucesso
/*/
Static Function saveDecodedMessage(oModel as object) as logical

	Begin Transaction

		If ( oModel:GetOperation() == MODEL_OPERATION_UPDATE )
			updateDecodedMessage(oModel)
		EndIf

	End Transaction

Return .T.

/*/{Protheus.doc} updateDecodedMessage
Função que atualiza a Mensagem Decodificada.
Regra para atualização de registro da tabela CKA: 
	- Se mais de um registro da tabela CKA estiver utilizando a mensagem, ao alterar, cria uma 
		nova mensagem na tabela CJL e atualiza o ID da mensagem no registro da tabela CKA.
	- Se apenas um registro da tabela CKA estiver utilizando a mensagem, ao alterar, apenas 
		atualiza da mensagem da tabela CJL.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 29/07/2025
@param oModel, object, Modelo de dados do cadastro de Mensagens Decodificadas.
/*/
Static Function updateDecodedMessage(oModel as object)

	Local cQuery as character
	Local oStatement as object
    Local cIdCJL as character

	cQuery += ' SELECT COUNT(CKA_IDMSGD) QTCKA '
	cQuery += ' FROM ' + RetSqlName('CKA')
	cQuery += ' WHERE CKA_FILIAL = ? '
	cQuery += ' 	AND CKA_IDMSGD = ? '
	cQuery += ' 	AND D_E_L_E_T_ = ? '

	oStatement := FWExecStatement():New(cQuery)
 
	oStatement:SetString(1, FWxFilial('CKA'))
	oStatement:SetString(2, oModel:GetValue('DECODEDMESSAGE','CKA_IDMSGD'))
	oStatement:SetString(3, ' ')

	If ( oStatement:ExecScalar('QTCKA') == 1 )

		CJL->(Reclock('CJL',.F.))
		CJL->CJL_MENSG := oModel:GetValue('MESSAGE','CJL_MENSG')
		CJL->(MsUnlock())

	Else

		cIdCJL := FWUUIDV4(.T.)

		CJL->(Reclock('CJL',.T.))
		CJL->CJL_FILIAL := FWxFilial('CJL')
		CJL->CJL_ID := cIdCJL
		CJL->CJL_CODMSG := oModel:GetValue('MESSAGE','CJL_CODMSG')
		CJL->CJL_INDICE := '04'
		CJL->CJL_MENSG := oModel:GetValue('MESSAGE','CJL_MENSG')
		CJL->(MsUnlock())

		CKA->(Reclock('CKA',.F.))
		CKA->CKA_IDMSGD := cIdCJL
		CKA->(MsUnlock())

	EndIf

	oStatement:Destroy()
	FWFreeObj(oStatement)

Return

/*/{Protheus.doc} validateFieldEdit
Função que valida se o campo pode ser editado.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 10/06/2025
@Return logical, Indica se o campo pode ser editado ou não.
/*/
Function validateFieldEdit() as logical

	Local cField := ReadVar() as character
	Local cContent := &(cField) as character
	Local lValid := .T. as logical
	
	If ( 'F6_CODMSD' $ cField .And. cContent != SF6->F6_CODMSD )
		lValid := .F.
		Help(,,'Help',,STR0007,1,0)  // 'Campo não pode ser alterado'
	EndIf

Return lValid

/*/{Protheus.doc} getDecodedMessageCode
Função que busca o código da mensagem decodificada.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 13/06/2025
@param cTaxId, character, Identificador do tributo
@param cIdentifierCode, character, Código do identificador
@param cTaxCode, character, Código do tributo
@Return character, Código da mensagem decodificada
/*/
Function getDecodedMessageCode(cTaxId as character, cIdentifierCode as character, cTaxCode as character) as character

	Local cQry as character
	Local oStatement as object
	Local cDecodedMessageCode as character

	cQry += ' SELECT CKA_CODIGO '
	cQry += ' FROM ' + RetSqlName('CKA')
	cQry += ' WHERE CKA_FILIAL = ? '
	cQry += ' 	AND CKA_IDTRIB = ? '
	cQry += ' 	AND CKA_TRIB = ? '
	cQry += ' 	AND CKA_CODIDE = ? '
	cQry += ' 	AND D_E_L_E_T_ = ? '

	oStatement := FWExecStatement():New(cQry)

    oStatement:SetString(1, FWxFilial('CKA'))
    oStatement:SetString(2, cTaxId)
    oStatement:SetString(3, cTaxCode)
    oStatement:SetString(4, cIdentifierCode)
    oStatement:SetString(5, ' ')

	cDecodedMessageCode := oStatement:ExecScalar('CKA_CODIGO')

	oStatement:Destroy()
	oStatement := Nil

Return cDecodedMessageCode

/*/{Protheus.doc} validateMessageCode
Função que valida o código da mensagem.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 13/06/2025
@param oModel, object, Modelo de dados do cadastro de Mensagens Decodificadas
@Return logical, Indica se o código da mensagem é válido ou não.
/*/
Static Function validateMessageCode(oModel as object) as logical

	Local oDecodedMessage := oModel:GetModel('DECODEDMESSAGE') as object
	Local oMessage := oModel:GetModel('MESSAGE') as object
	Local cDecodedMessageId := oDecodedMessage:GetValue('CKA_IDMSGD') as character
	Local cMessageCode := oMessage:GetValue('CJL_CODMSG') as character
	Local lValid := .T. as logical

	If ( cMessageCode != Posicione('CJL',1,FWxFilial('CJL') + cDecodedMessageId,'CJL_CODMSG') )
		lValid := .F.
		Help(,,'Help',,STR0007,1,0)  // 'Campo não pode ser alterado'
	EndIf

Return lValid

/*/{Protheus.doc} addVirtualFields
Funcao para adicionar campos a uma estrutura.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 29/07/2025
@param oStruct, object, Objeto com a estrutura e que recebe os campos adicionais
@param cType, character, Flag de indicação onde o campos serão adicionados (MODEL ou VIEW
/*/
Static Function addVirtualFields(oStruct as object, cType as character, cTable as character)

	Local aField as array
	Local lCustomer := Posicione('SFT',13,FWxFilial('SFT') + CKA->CKA_IDTRIB,'FT_TIPOMOV') == 'S' as logical

	If ( cType == 'MODEL' )

		aField := Array(14)

		aField[01] := '' 	// [01] - C - Titulo do campo
		aField[02] := '' 	// [02] - C - ToolTip do campo
		aField[03] := '' 	// [03] - C - Id do campo
		aField[04] := '' 	// [04] - C - Tipo do campo
		aField[05] := 0 	// [05] - N - Tamanho do campo
		aField[06] := 0 	// [06] - N - Decimal do campo
		aField[07] := {|| } // [07] - B - Code-block de validação do campo
		aField[08] := {|| } // [08] - B - Code-block de validação When do campo
		aField[09] := {} 	// [09] - A - Lista de valores permitido do campo
		aField[10] := .F. 	// [10] - L - Indica se o campo tem preenchimento obrigatório
		aField[11] := {|| } // [11] - B - Code-block de inicialização do campo
		aField[12] := .F. 	// [12] - L - Indica se trata-se de um campo chave
		aField[13] := .F. 	// [13] - L - Indica se o campo pode receber valor em uma operação de update.
		aField[14] := .T. 	// [14] - L - Indica se o campo é virtual

		If ( cTable == 'CKA' )

			aField[01] := STR0012 // 'Tipo do Movimento'
			aField[02] := STR0012 // 'Tipo do Movimento'
			aField[03] := 'CKA_TIPOMO'
			aField[04] := 'C'
			aField[05] := 1
			aField[11] := {|| Posicione('SFT',13,FWxFilial('SFT') + FwFldGet('CKA_IDTRIB'),'FT_TIPOMOV')}

			addField(oStruct,cType,aField)

			aField[01] := STR0013 // 'Documento Fiscal'
			aField[02] := STR0014 // 'Número do Documento Fiscal'
			aField[03] := 'CKA_NFISCA'
			aField[04] := 'C'
			aField[05] := 9
			aField[11] := {|| Posicione('SFT',13,FWxFilial('SFT') + FwFldGet('CKA_IDTRIB'),'FT_NFISCAL')}

			addField(oStruct,cType,aField)

			aField[01] := STR0015 // 'Série'
			aField[02] := STR0016 // 'Série do Documento Fiscal'
			aField[03] := 'CKA_SERIE'
			aField[04] := 'C'
			aField[05] := 3
			aField[11] := {|| Posicione('SFT',13,FWxFilial('SFT') + FwFldGet('CKA_IDTRIB'),'FT_SERIE')}

			addField(oStruct,cType,aField)		

			aField[01] := STR0018 // 'Fornecedor'
			aField[02] := STR0018 // 'Fornecedor'

			If ( lCustomer )
				aField[01] := STR0017 // 'Cliente'
				aField[02] := STR0017 // 'Cliente'
			EndIf

			aField[03] := 'CKA_CLIEFO'
			aField[04] := 'C'
			aField[05] := 6
			aField[11] := {|| Posicione('SFT',13,FWxFilial('SFT') + FwFldGet('CKA_IDTRIB'),'FT_CLIEFOR')}

			addField(oStruct,cType,aField)

			aField[01] := STR0019 // 'Loja'
			aField[02] := STR0020 // 'Código da Loja'
			aField[03] := 'CKA_LOJA'
			aField[04] := 'C'
			aField[05] := 2
			aField[11] := {|| Posicione('SFT',13,FWxFilial('SFT') + FwFldGet('CKA_IDTRIB'),'FT_LOJA')}

			addField(oStruct,cType,aField)

			aField[01] := STR0021 // 'Item do Doc. Fiscal'
			aField[02] := STR0022 // 'Código do Item do Documento Fiscal'
			aField[03] := 'CKA_ITEM'
			aField[04] := 'C'
			aField[05] := 4
			aField[11] := {|| Posicione('SFT',13,FWxFilial('SFT') + FwFldGet('CKA_IDTRIB'),'FT_ITEM')}

			addField(oStruct,cType,aField)

		ElseIf ( cTable == 'CJL' )

			aField[01] := STR0023 // 'Descrição'
			aField[02] := STR0024 // 'Descrição da Mensagem'
			aField[03] := 'CJL_DESMSG'
			aField[04] := 'C'
			aField[05] := 100
			aField[11] := {|| Posicione('CJ8',1,FWxFilial('CJ8') + FwFldGet('CJL_CODMSG'),'CJ8_DESC')}

			addField(oStruct,cType,aField)

		EndIf

		FWFreeArray(aField)

	ElseIf ( cType == 'VIEW' )
	
		aField := Array(18)

		aField[01] := '' 	// [01] - C - Nome do Campo
		aField[02] := '' 	// [02] - C - Ordem
		aField[03] := '' 	// [03] - C - Titulo do campo
		aField[04] := '' 	// [04] - C - Descricao do campo
		aField[05] := {} 	// [05] - A - Array com Help
		aField[06] := '' 	// [06] - C - Tipo do campo
		aField[07] := '@!' 	// [07] - C - Picture
		aField[08] := {|| } // [08] - B - Bloco de Picture Var
		aField[09] := '' 	// [09] - C - Consulta F3
		aField[10] := .F. 	// [10] - L - Indica se o campo é alteravel
		aField[11] := '' 	// [11] - C - Pasta do campo
		aField[12] := '' 	// [12] - C - Agrupamento do campo
		aField[13] := {} 	// [13] - A - Lista de valores permitido do campo (Combo)
		aField[14] := 0 	// [14] - N - Tamanho maximo da maior opção do combo
		aField[15] := '' 	// [15] - C - Inicializador de Browse
		aField[16] := .T. 	// [16] - L - Indica se o campo é virtual
		aField[17] := '' 	// [17] - C - Picture Variavel
		aField[18] := .F. 	// [18] - L - Indica pulo de linha após o campo

		If ( cTable == 'CKA' )				

			aField[01] := 'CKA_TIPOMO'
			aField[02] := '01'
			aField[03] := STR0012 // 'Tipo do Movimento'
			aField[04] := STR0012 // 'Tipo do Movimento'
			aField[05] := {STR0012} // 'Tipo do Movimento'
			aField[06] := 'C'
			aField[13] := {'E=' + STR0025,'S=' + STR0026} // 'Entrada' 'Saída'

			addField(oStruct,cType,aField)

			aField[01] := 'CKA_NFISCA'
			aField[02] := '02'
			aField[03] := STR0013 // 'Documento Fiscal'
			aField[04] := STR0014 // 'Número do Documento Fiscal'
			aField[05] := {STR0014} // 'Número do Documento Fiscal'
			aField[06] := 'C'
			aField[13] := {}

			addField(oStruct,cType,aField)

			aField[01] := 'CKA_SERIE'
			aField[02] := '03'
			aField[03] := STR0015 // 'Série'
			aField[04] := STR0016 // 'Série do Documento Fiscal'
			aField[05] := {STR0016} // 'Série do Documento Fiscal'
			aField[06] := 'C'
			aField[13] := {}

			addField(oStruct,cType,aField)		

			aField[01] := 'CKA_CLIEFO'
			aField[02] := '04'
			aField[03] := STR0018 // 'Fornecedor'
			aField[04] := STR0018 // 'Fornecedor'
			aField[05] := {STR0018} // 'Fornecedor'

			If ( lCustomer )
				aField[03] := STR0017 // 'Cliente'
				aField[04] := STR0017 // 'Cliente'
				aField[05] := {STR0017} // 'Cliente'
			EndIf
		
			aField[06] := 'C'
			aField[13] := {}

			addField(oStruct,cType,aField)

			aField[01] := 'CKA_LOJA'
			aField[02] := '05'
			aField[03] := STR0019 // 'Loja'
			aField[04] := STR0020 // 'Codigo da Loja'
			aField[05] := {STR0020} // 'Codigo da Loja'
			aField[06] := 'C'
			aField[13] := {}

			addField(oStruct,cType,aField)

			aField[01] := 'CKA_ITEM'
			aField[02] := '06'
			aField[03] := STR0021 // 'Item do Doc. Fiscal'
			aField[04] := STR0022 // 'Código do Item do Documento Fiscal'
			aField[05] := {STR0022} // 'Código do Item do Documento Fiscal'
			aField[06] := 'C'
			aField[13] := {}

			addField(oStruct,cType,aField)

		ElseIf ( cTable == 'CJL' )

			aField[01] := 'CJL_DESMSG'
			aField[02] := '02'
			aField[03] := STR0023 // 'Descrição'
			aField[04] := STR0024 // 'Descrição da Mensagem'
			aField[05] := {STR0024} // 'Descrição da Mensagem'
			aField[06] := 'C'
			aField[13] := {}

			addField(oStruct,cType,aField)			

		EndIf

		FWFreeArray(aField)

	EndIf

Return

/*/{Protheus.doc} addField
Função que adiciona um campo a uma estrutura.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 29/07/2025
@param oStruct, object, Estrutura onde o campo será adicionado
@param cType, character, Tipo de estrutura (MODEL ou VIEW)
@param aField, array, Array com os dados do campo
/*/
Static Function addField(oStruct as object, cType as character, aField as array)

	If ( cType == 'MODEL' )
		oStruct:AddField(;
			aField[01],aField[02],aField[03],aField[04],aField[05],;
			aField[06],aField[07],aField[08],aField[09],aField[10],;
			aField[11],aField[12],aField[13],aField[14];
		)
	ElseIf ( cType == 'VIEW' )
		oStruct:AddField(;
			aField[01],aField[02],aField[03],aField[04],aField[05],;
