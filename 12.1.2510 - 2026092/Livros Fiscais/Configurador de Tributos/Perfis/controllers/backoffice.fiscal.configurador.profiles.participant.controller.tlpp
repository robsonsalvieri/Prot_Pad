return

/*/{Protheus.doc} ParticipantProfileController::findOne
Método para consulta de um perfil de participante.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
/*/
method findOne() class ParticipantProfileController

    local nPage := 1 as numeric
    local nPageSize := 50 as numeric

    try
        self:jPathParamsRequest:fromJson(oRest:getPathParamsRequest():toJson())
		self:jQueryParamsRequest:fromJson(oRest:getQueryRequest():toJson())
		
		self:oProfileOptimizer:changeBranch(self:jQueryParamsRequest['branchCode'])

        if ( self:jQueryParamsRequest:hasProperty('page') )
            nPage := val(self:jQueryParamsRequest['page'])
        endif

        if ( self:jQueryParamsRequest:hasProperty('pageSize') )
            nPageSize := val(self:jQueryParamsRequest['pageSize'])
        endif

        self:jResponse := self:oService:findOne(self:jPathParamsRequest['code'], nPage, nPageSize)

        self:nStatusCode := HTTP_CODE_OK
    catch oError
        self:setErrorResponse('',oError)
    finally
        oRest:setStatusCode(self:nStatusCode)
        oRest:setResponse(self:jResponse:toJson())
		
		self:oProfileOptimizer:restoreBranch()

        self:destroy()
    endtry

return

/*/{Protheus.doc} ParticipantProfileController::searchParticipantsCount
Método para busca da quantidade de Participantes de acordo com o tipo (Cliente ou Fornecedor) e os filtros.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 10/11/2025
/*/
method searchParticipantsCount() class ParticipantProfileController

    local lValid as logical
    local nI as numeric
    local jFilterItems as json
    local lAllowEmpty := .F. as logical

    try
        self:jBodyRequest:fromJson(oRest:getBodyRequest())
        self:jQueryParamsRequest:fromJson(oRest:getQueryRequest():toJson())

        self:oProfileOptimizer:changeBranch(self:jQueryParamsRequest['branchCode'])

        lValid := self:validateRequest(self:jBodyRequest,{'type','items'},lAllowEmpty)
        lValid := lValid .and. self:validateRequest(self:jBodyRequest['type'],{'code'},lAllowEmpty)
        if ( lValid )
            for nI := 1 to len(self:jBodyRequest['items'])
                jFilterItems := self:jBodyRequest['items'][nI]
                lAllowEmpty := .F.
                lValid := lValid .and. self:validateRequest(jFilterItems,{'key'},lAllowEmpty)
                if ( lValid .and. !self:isValidSearchParticipantKey(self:jBodyRequest['type']['code'], jFilterItems['key']) )
                    lValid := .F.
                    aadd(self:aMissingFields, 'key')
                endif
                lAllowEmpty := .T.
                lValid := lValid .and. self:validateRequest(jFilterItems,{'value'},lAllowEmpty)
            next nI
        endif

        if ( !lValid )
            throw self:oExceptions:badRequestException(STR0001) // 'Dados obrigatórios ausentes na requisição'
        endif

        self:jResponse := self:oService:searchParticipants(self:jBodyRequest, 'count', '')

        self:nStatusCode := HTTP_CODE_OK
    catch oError
        self:setErrorResponse(STR0005,oError) // 'Erro ao buscar participantes'
    finally
        oRest:setStatusCode(self:nStatusCode)
        oRest:setResponse(self:jResponse:toJson())

        self:oProfileOptimizer:restoreBranch()

        self:destroy()
    endtry

return

/*/{Protheus.doc} ParticipantProfileController::searchParticipantsList
Método para busca de Participantes de acordo com o tipo (Cliente ou Fornecedor) e os filtros.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 10/11/2025
/*/
method searchParticipantsList() class ParticipantProfileController

    local lValid as logical
    local nI as numeric
    local jFilterItems as json
    local lAllowEmpty := .F. as logical
    local cContext := '' as character

    try
        self:jBodyRequest:fromJson(oRest:getBodyRequest())
        self:jQueryParamsRequest:fromJson(oRest:getQueryRequest():toJson())

        self:oProfileOptimizer:changeBranch(self:jQueryParamsRequest['branchCode'])

        if ( self:jQueryParamsRequest:hasProperty('context') )
            cContext := self:jQueryParamsRequest['context']
        endif

        lValid := self:validateRequest(self:jBodyRequest,{'type','items'},lAllowEmpty)
        lValid := lValid .and. self:validateRequest(self:jBodyRequest['type'],{'code'},lAllowEmpty)
        if ( lValid )
            for nI := 1 to len(self:jBodyRequest['items'])
                jFilterItems := self:jBodyRequest['items'][nI]
                lAllowEmpty := .F.
                lValid := lValid .and. self:validateRequest(jFilterItems,{'key'},lAllowEmpty)
                if ( lValid .and. !self:isValidSearchParticipantKey(self:jBodyRequest['type']['code'], jFilterItems['key']) )
                    lValid := .F.
                    aadd(self:aMissingFields, 'key')
                endif
                lAllowEmpty := .T.
                lValid := lValid .and. self:validateRequest(jFilterItems,{'value'},lAllowEmpty)
            next nI
        endif

        if ( !lValid )
            throw self:oExceptions:badRequestException(STR0001) // 'Dados obrigatórios ausentes na requisição'
        endif

        self:jResponse := self:oService:searchParticipants(self:jBodyRequest, 'list', cContext)

        self:nStatusCode := HTTP_CODE_OK
    catch oError
        self:setErrorResponse(STR0005,oError) // 'Erro ao buscar participantes'
    finally
        oRest:setStatusCode(self:nStatusCode)
        self:sendChunkedResponse()

        self:oProfileOptimizer:restoreBranch()

        self:destroy()
    endtry

return

/*/{Protheus.doc} ParticipantProfileController::sendChunkedResponse
Envia a resposta do endpoint em partes, serializando os participantes individualmente.
@type method
@version 12.1.2510
@author Douglas Dourado
@since 21/08/2026
/*/
method sendChunkedResponse() class ParticipantProfileController

    local nChunkSize := 32768 as numeric
    local jChunkResponse as json
    local aResponseNames as array
    local nI as numeric
    local cContent as character
    local cChunk := '' as character

    if ( self:jResponse:hasProperty('participants') .and. valType(self:jResponse['participants']) == 'A' )
        jChunkResponse := JsonObject():New()
        aResponseNames := self:jResponse:GetNames()

        for nI := 1 to Len(aResponseNames)
            if ( aResponseNames[nI] != 'participants' )
                jChunkResponse[aResponseNames[nI]] := self:jResponse[aResponseNames[nI]]
            endif
        next nI

        jChunkResponse['participants'] := self:jResponse['participants']
        cContent := jChunkResponse:toJson()
        cChunk := self:appendChunkedContent(cContent, cChunk, nChunkSize)
        FWFreeObj(jChunkResponse)
    else
        cContent := self:jResponse:toJson()
        cChunk := self:appendChunkedContent(cContent, cChunk, nChunkSize)
    endif

    oRest:setLastChunkedResponse(cChunk)

return

/*/{Protheus.doc} ParticipantProfileController::appendChunkedContent
Adiciona conteúdo ao buffer e envia os chunks completos imediatamente.
@type method
@version 12.1.2510
@author Douglas Dourado
@since 21/08/2026
@param cContent, character, Conteúdo a ser adicionado ao buffer
@param cChunk, character, Buffer do chunk atual
@param nChunkSize, numeric, Tamanho máximo do chunk
@return character, Buffer com o conteúdo restante após os envios
/*/
method appendChunkedContent(cContent as character, cChunk as character, nChunkSize as numeric) as character class ParticipantProfileController

    local nAvailable as numeric

    while ( !Empty(cContent) )
        nAvailable := nChunkSize - Len(cChunk)
        if ( Len(cContent) <= nAvailable )
            cChunk := cChunk + cContent
            cContent := ''
        else
            cChunk := cChunk + SubStr(cContent, 1, nAvailable)
            cContent := SubStr(cContent, nAvailable + 1)
            oRest:setChunkedResponse(cChunk)
            cChunk := ''
        endif
    enddo

return cChunk

/*/{Protheus.doc} ParticipantProfileController::validateRequest
Método para validação dos dados obrigatórios na requisição.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
@param xData, variant, Dados a serem validados (pode ser um objeto JSON ou um array de objetos JSON)
@param aRequiredKeys, array, Chaves obrigatórias que devem estar presentes nos dados
@param lAllowEmpty, logical, Indica se permite valores em branco
@return logical, Retorna .T. se os dados forem válidos, .F. caso contrário
/*/
method validateRequest(xData as variant, aRequiredKeys as array, lAllowEmpty as logical) as logical class ParticipantProfileController
    
    local aItems := xData as array
    local jRequest as json
    local cField as character
    local lValid := .T. as logical
    local nI as numeric
    local nJ as numeric

    if ( valType(xData) == 'J' )
        aItems := { xData }
    endif

    for nI := 1 to len(aItems)
        jRequest := aItems[nI]
        for nJ := 1 to len(aRequiredKeys)
            cField := aRequiredKeys[nJ]
            if ( !jRequest:hasProperty(cField) .or. (valType(jRequest[cField]) != 'J' .and. empty(jRequest[cField]) .and. !lAllowEmpty) )
                lValid := .F.
                aadd(self:aMissingFields, cField)
            endif
        next nJ
    next nI

return lValid

/*/{Protheus.doc} ParticipantProfileController::isValidSearchParticipantKey
Valida se a chave do filtro pertence ao contrato do tipo de participante.
@type method
@version 12.1.2510
@author Edinei Cruz
@since 13/08/2026
@param cTypeCode, character, Tipo do participante
@param cKey, character, Chave do filtro
@return logical, Indica se a chave pode ser usada na busca
/*/
method isValidSearchParticipantKey(cTypeCode as character, cKey as character) as logical class ParticipantProfileController

    local cAllowedKeys as character

    do case
        case ( cTypeCode == '1' )
            cAllowedKeys := '|A2_COD|A2_LOJA|A2_EST|A2_COD_MUN|A2_MUN|A2_TIPO|A2_TRANSP|A2_COND|A2_RECISS|A2_PAIS|A2_RECINSS|A2_GRPTRIB|A2_CNAE|A2_RECPIS|A2_RECCSLL|A2_RECCOFI|A2_SIMPNAC|A2_MINIRF|A2_CONTRIB|A2_COD_FR|A2_COD_TO|A2_LOJA_FR|A2_LOJA_TO|'
        case ( cTypeCode == '2' )
            cAllowedKeys := '|A1_COD|A1_LOJA|A1_PESSOA|A1_TIPO|A1_EST|A1_COD_MUN|A1_MUN|A1_PAIS|A1_VEND|A1_REGIAO|A1_TRANSP|A1_COND|A1_RECISS|A1_GRPTRIB|A1_TPESSOA|A1_RECINSS|A1_RECCOFI|A1_RECCSLL|A1_RECPIS|A1_GRPVEN|A1_SIMPNAC|A1_MINIRF|A1_CONTRIB|A1_COD_FR|A1_COD_TO|A1_LOJA_FR|A1_LOJA_TO|'
    endcase

return ( '|' + cKey + '|' $ cAllowedKeys )

/*/{Protheus.doc} ParticipantProfileController::setErrorResponse
Método para definir a resposta de erro.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
@param cMessage, character, Mensagem de erro
@param oError, object, Objeto de erro capturado na exceção
/*/
method setErrorResponse(cMessage as character, oError as object) class ParticipantProfileController

    if ( oError:genCode == HTTP_CODE_BAD_REQUEST .or. ;
         oError:genCode == HTTP_CODE_NOT_FOUND )
        self:nStatusCode := oError:genCode
    endif

    self:jResponse['success'] := .F.
    self:jResponse['message'] := fwHttpEncode(cMessage)

    if ( !empty(oError:description) )
        if ( empty(cMessage) )
            self:jResponse['message'] := fwHttpEncode(oError:description)
        else
            self:jResponse['detailedMessage'] := fwHttpEncode(oError:description)
        endif
    endif

    if ( !empty(self:aMissingFields) )
        self:jResponse['missingFields'] := self:aMissingFields
    endif

return

/*/{Protheus.doc} ParticipantProfileController::destroy
Método destrutor da classe ParticipantProfileController.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
/*/
method destroy() class ParticipantProfileController

    self:oExceptions:destroy()
    fwFreeObj(self:oExceptions)

    self:oService:destroy()
    fwFreeObj(self:oService)

    self:oProfileOptimizer:destroy()
    fwFreeObj(self:oProfileOptimizer)

    fwFreeObj(self:jBodyRequest)
    self:jBodyRequest := nil

    fwFreeObj(self:jPathParamsRequest)
    self:jPathParamsRequest := nil

    fwFreeObj(self:jQueryParamsRequest)
    self:jQueryParamsRequest := nil

    fwFreeObj(self:jResponse)
    self:jResponse := nil

    fwFreeArray(self:aMissingFields)
    self:aMissingFields := nil

return
