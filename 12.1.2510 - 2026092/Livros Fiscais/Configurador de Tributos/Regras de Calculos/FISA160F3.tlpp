#include 'tlpp-core.th'
#include 'tlpp-object.th'

Static cF3RetField := "" as character

using namespace backoffice.fiscal.configurator.profile.lookup

/*/{Protheus.doc} FISA160F3
	Funcao Responsavel por chamar o browser de uma consulta Especifica
	no campo CIN_CONSUL 
	@type  Function
	@author user
	@since 17/03/2026
	@version 12.1.2510
	@see (links_or_references)
	/*/
Function FISA160F3() as logical

	Local oTela :=  nil as object
	Local cQuery := "" as character
	Local aBinds := {} as array
	Local lOk := .F. as logical
	Local aRetCpo := {} as array
	Local cRegra := xFisTPCIN() as character
	Local cDescription := "" as character
	Local cRegraTrib := M->CIN_TRIB as character

	cDescription := FISA160DESC()

	cQuery := " SELECT CIN.CIN_CODIGO,CIN.CIN_TREGRA,CIN.CIN_DESCR"
	cQuery += " FROM "+RetSqlName("CIN")+" CIN"
	cQuery += " WHERE CIN_FILIAL = ?"
	cQuery += " AND CIN.CIN_TREGRA IN (?)"
	if !Empty(cRegraTrib)
		cQuery += " AND CIN_REGRA = ?"
	endif
	cQuery += " AND CIN.CIN_ALTERA = ?"
	cQuery += " AND CIN.D_E_L_E_T_ = ?"
	cQuery += " ORDER BY CIN.CIN_CODIGO ASC"

	aAdd(aBinds,{"C",xFilial("CIN")})
	aAdd(aBinds,{"A",StrTokArr2(cRegra,"/",)})
	if !Empty(cRegraTrib) 
		aAdd(aBinds,{"C",cRegraTrib})
	endif
	aAdd(aBinds,{"C","0"})
	aAdd(aBinds,{"C"," "})

	oTela := FisLookup():New()
	oTela:SetDescription(cDescription)
	oTela:SetIndex({"CIN_TREGRA"})
	oTela:SetIndex({"CIN_CODIGO"})
	oTela:SetIndex({"CIN_DESCR"})
	oTela:SetGetFields({"CIN_CODIGO"})
	aRetCpo := oTela:Show(cQuery,aBinds)
	FreeObj(oTela)

	if !empty(aRetCpo)
		lOk := .T.
		cF3RetField := Alltrim(aRetCpo[1])
	endif

Return lOk

/*/{Protheus.doc} FISA160DESC
	funcao responalvel para recuperar o titulo do filtro selecionado
	@type  Static Function
	@author Ricardo Henrique de Mello Lima
	@since 16/03/2026
	@version 12.1.2510
/*/
Static Function FISA160DESC() as character

	Local cDescRegra := XFISTREGRA() as array
	Local aRetRegras := {} as array
	Local nCount := 0 as numeric
	Local nPosIni := 4 as numeric
	
	aRetRegras := StrTokArr2( cDescRegra, ";",)

	if !Empty(aRetRegras)
		for nCount := 1 to len(aRetRegras)
			if Substr(aRetRegras[nCount],1,2) == Alltrim(M->CIN_FILTRO)
				cValue := "Regras do Configurador - "+Alltrim(SubStr(aRetRegras[ncount],nPosIni,Len(Alltrim(aRetRegras[ncount]))))
				exit
			endif
		next
	endif

Return cValue

/*/{Protheus.doc} FISA160F3R
	Retorna o campo selecionado na consulta F3
	@type  Function
	@author Ricardo Henrique de Mello Lima
	@since 16/03/2026
	@version 12.1.2510
	@return cCampos, character, codigo da formula CIN
	/*/
Function FISA160F3R() as character
Return cF3RetField


