/*/{Protheus.doc} A055ForNo
Gatilho para exibir el nombre del Proveedor en el browse (SmartX).
Usado en SX3->X3_INIBRW del campo virtual del nombre del Proveedor.
@type Function
@author Rodrigo Correia
@since 11/09/2026
@version 1.0
@return Character, Retorna el valor del campo A2_NOME
/*/
Function A055ForNo()
	Local aArea := GetArea()
	Local cRet  := ""
	If Select("SCU") > 0 .And. !Empty(SCU->CU_FORNECE)
		cRet := Posicione("SA2",1,xFilial("SA2")+SCU->CU_FORNECE+SCU->CU_LOJA,"A2_NOME")
	EndIf
	RestArea(aArea)
Return cRet

/*/{Protheus.doc} A055MotDs
Gatilho para exibir la descripcion del Motivo en el browse (SmartX).
Usado en SX3->X3_INIBRW del campo virtual de la descripcion del Motivo.
Motivo (CU_MOTIVO) se relaciona con la Tabela Generica SX5, grupo "O1"
(confirmado via X3_VALID: ExistCpo('SX5',"O1"+M->CU_MOTIVO)).
@type Function
@author Rodrigo Correia
@since 11/09/2026
@version 1.0
@return Character, Retorna el valor del campo X5_DESCRI
/*/
Function A055MotDs()
	Local aArea := GetArea()
	Local cRet  := ""
	If Select("SCU") > 0 .And. !Empty(SCU->CU_MOTIVO)
		cRet := Posicione("SX5",1,FWxFilial("SX5")+"O1"+SCU->CU_MOTIVO,"X5_DESCRI")
	EndIf
	RestArea(aArea)
Return cRet