#INCLUDE 'msobject.ch'
#INCLUDE 'tlpp-rest.th'
#INCLUDE 'totvs.framework.treports.integratedprovider.th'
#INCLUDE 'backoffice.sv.fis.districtfiles.ch'

namespace custom.fiscal.districtfiles.integratedprovider

//-------------------------------------------------------------------------------
/*{Protheus.doc} backoffice.sv.fis.districtfiles
@description Classe para creaciÛn del Objeto de Negocio para TReports
@author Laura Medina
@since 11/12/2025
@version 1.1
*/
//-------------------------------------------------------------------------------
@totvsFrameworkTReportsIntegratedProvider( active=.T., team='SIGAFIS', tables='SFB', name='Archivos Distritales', country='COL', initialRelease='12.1.2310', customTables='ALL' )
class districtfilesTReportsBusinessObject from totvs.framework.treports.integratedprovider.IntegratedProvider

	public Method new() as object
	public Method getData() as object
	public Method getSchema() as object

	protected data aFields as array
	protected data aStruct as array
	protected data nRecno as numeric
	protected data jItems as json

endclass

//-------------------------------------------------------------------
/*{Protheus.doc} new
MÈtodo de inst‚ncia da classe 
@Return object: self
@author Laura Medina
@since 11/12/2025
@version 1.0
*/
//-------------------------------------------------------------------
Method new() class districtfilesTReportsBusinessObject

	Local aCpos := {} as array

	_Super:new()

	//Define o nome do Objeto de NegÛcio
	self:setDisplayName( STR0001 )  // 'Archivos Distritales'

	//Define a descriÁ„o do Objeto de NegÛcio
	self:setDescription( STR0001 )  // 'Archivos Distritales'

	// Define a ¡rea
	self:appendArea( STR0002 ) // 'Libros Fiscales'

	// Define se as perguntas terao lookup
	self:setIsLookUp( .T. )

	// Indica o pergunte que ser· utilizado no relatÛrio
	If !self:setPergunte( 'FISSV503' )
		IIf(!self:setErrorStatus( 400, STR0003, STR0004 ),FwLogMsg( 'WARN',, 'Smart View',,,, STR0005,,, ),'') // 'Sin Preguntas' // '°Verifique el grupo de preguntas dado!' // 'CÛdigo de error no v·lido, solo acepte cÛdigos de error 4xx'
		FwLogMsg( 'WARN',, 'Smart View',,,, STR0006,,, ) // 'Grupo de preguntas no encontrado!'
	EndIf
	
	aAdd( aCpos, { 'D1_BASIMP', STR0007, 'number', STR0007} ) //'Base Impuesto' 
	aAdd( aCpos, { 'D1_VALIMP', STR0008, 'number', STR0008} ) //'Valor Impuesto'
	aAdd( aCpos, { 'VISTA', 	STR0009, 'string', STR0009} ) // STR0009 'VISTA
	// demais campos
	self:aFields := {'F1_FILIAL','F1_DOC','F1_SERIE','F1_FORNECE','F1_LOJA','F1_ESPECIE','F1_TPACTIV','B1_TPCLAS','D1_ITEM','D1_COD','D1_QUANT','D1_VUNIT','D1_TOTAL','D1_TES','D1_BASIMP','D1_VALIMP','F1_MOEDA','F1_TXMOEDA','D1_CODMUN','F1_EMISSAO','F1_EST','VISTA'}
	self:aStruct := getStrutObj( self:aFields, aCpos )

Return( self )

//-------------------------------------------------------------------
/*{Protheus.doc} getData
Retorna los datos del objeto de negÛcio
@param nPage, numÈrico, indica la pagina actual del relatÛrio
@param oFilter, objeto, contiene el filtro del TReports
@return object: self:oData
@author Laura Medina
@since 11/12/2025
@version 1.0
*/
//------------------------------------------------------------------- 
Method getData( nPage as numeric, oFilter as object) as object class districtfilesTReportsBusinessObject

	// Declaracao de variables
	Local cQuery		as character
	Local cQrySuc		as character
	Local cQueryfb		as character
	Local cFiltro 		as character
	Local cAliasA       as character
	Local cAliasB       as character
	Local cSUMBas		as character
	Local cSUMVal		as character
	Local cSUMBas2		as character
	Local cSUMVal2		as character
	Local cCpoSF1 		as character
	Local cCpoSD1 		as character
	Local cCpoSF2 		as character
	Local cCpoSD2 		as character
	Local cCpoSB1		as character
	Local cFilDesde		as character
	Local cFilHasta		as character
	Local cMunicipio	as character
	Local cImpTexto		as character
	Local cWhereVal		as character
	Local cWhereVal2	as character
	Local cVista		as character

	Local nX			as numeric
	Local nDecs 		as numeric
	Local nSeq			as numeric
	Local nFil			as numeric
	Local nMoeda		as numeric
	Local nPosRepo		as numeric

	Local jParams 		as json

	Local aFiltro		as array
	Local aCustomFields as array
	Local aImptos		as array
	Local aEspSF1		as array
	Local aEspSF2		as array
	Local aLivros   	as array
	Local aFiliales		as array
	Local aQryLivro		as array
	Local aQryBloques   as array

	Local lProcesa		as logical

	Local oExecA		as object
	Local oExecB		as object
	Local oLivros		as object

	cQuery      	:= ""
    cQrySuc     	:= ""
	cFiltro 		:= ''
	cAliasA			:= ''
	cAliasB			:= ''
	cSUMBas			:= ''
	cSUMVal			:= ''
	cSUMBas2		:= ''
	cSUMVal2		:= ''
	cFilDesde		:= ''
	cFilHasta		:= ''
	cMunicipio		:= ''
	cWhereVal   	:= ""
	cWhereVal2  	:= ""
	cVista			:= ""

	nPosRepo 		:=0
	nDecs 			:= 0
	nX 				:= 0
	nSeq			:= 0
	nFil			:= 0
	nMoeda			:= 1 //Moneda 1

	oLivros 		:= JsonObject():New() 

	aFiltro			:= { }
	aCustomFields	:= { }
	aImptos			:= { }
	aLivros			:= { }
	aFiliales		:= { }
	aQryLivro		:= { }
	aQryBloques		:= { }
	aEspSF1			:= { }
	aEspSF2			:= { }

	lProcesa		:= .F.  //Para procesar el query si cumple todas las validaciones

	// Coleta os campos personalizados pra agregar na query, campos de usuario.
	aCustomFields := self:getCustomFields( )
	cCpoSF1 := getCpoUser( aCustomFields, 'SF1', 'F1', ',' )
	cCpoSD1 := getCpoUser( aCustomFields, 'SD1', 'D1', ',' )
	cCpoSF2 := getCpoUser( aCustomFields, 'SF2', 'F2', ',' )
	cCpoSD2 := getCpoUser( aCustomFields, 'SD2', 'D2', ',' )
	cCpoSB1 := getCpoUser( aCustomFields, 'SB1', 'B1', ',' )

	// Coleta os dados dos parametros
	jParams := oFilter:getParameters( )

	// Adiciona campo customizado na estrutura de campos
	For nX := 1 To Len( aCustomFields )
		aAdd( self:aStruct, { aCustomFields[nX, 1], aCustomFields[nX, 4], aCustomFields[nX, 3], aCustomFields[nX, 2], aCustomFields[nX, 1] } )
		aAdd( self:aFields, aCustomFields[nX, 1] )
	Next

	If  oFilter:hasFilter( )  
		cFiltro := oFilter:getSQLExpression( )
		aFiltro := getParamToArr( cFiltro )
		// Ordena os parametros
		aSort( aFiltro,,, { |x, y| x[1] + x[3] < y[1] + y[3] } )

		
		nPosRepo := aScan( aFiltro, { | x | AllTrim( x[1] ) == 'VISTA' } )
		If ( nPosRepo > 0 )
			cVista := aFiltro[nPosRepo, 3]
			aDel( aFiltro, nPosRepo )
			aSize( aFiltro, ( Len( aFiltro ) - 1 ) )
		EndIf
	EndIf

	If  (jParams:hasProperty("MV_PAR04") .And. len(jParams['MV_PAR04']) > 0 ) .And. (jParams:hasProperty("MV_PAR01") .And. len(jParams['MV_PAR01']) > 0 ) .And. ;
		(jParams:hasProperty("MV_PAR02") .And. len(jParams['MV_PAR02']) > 0 ) .And. (jParams:hasProperty("MV_PAR03") .And. len(jParams['MV_PAR03']) > 0 ) .And. ;
		(jParams:hasProperty("MV_PAR06") .And. len(jParams['MV_PAR06']) > 0 ) .And. (jParams:hasProperty("MV_PAR07") .And. len(jParams['MV_PAR07']) > 0 )
		
		/* Par·metros del grupo de preguntas: 
			MV_PAR01 -> øDe fecha?
			MV_PAR02 -> øA fecha?
			MV_PAR03 -> øLista Movimientos?
			MV_PAR04 -> øImpuestos asociados al ICA?
			MV_PAR05 -> øMunicipio?
			MV_PAR06 -> ø De Sucursal?
			MV_PAR07 -> ø A Sucursal?
		*/

		cImpTexto := jParams['MV_PAR04'][1]
		cImpTexto := StrTran(cImpTexto, " ", "")
		aImptos := StrTokArr2( cImpTexto, ";" )

		If  jParams['MV_PAR03'][1] == 1 //Compras //MV_PAR03 
			aEspSF1:= { 'NDP','NF' } 
			aEspSF2:= { 'NCP' } 
		Elseif jParams['MV_PAR03'][1] == 2 //Ventas //MV_PAR03 
			aEspSF1:= { 'NCC' } 
			aEspSF2:= { 'NDC', 'NF'} 
		Endif
		cFilDesde := jParams['MV_PAR06'][1]
		cFilHasta := jParams['MV_PAR07'][1]
		aFiliales := ObtRangFil(cFilDesde, cFilHasta)
		If jParams:hasProperty("MV_PAR05") .And. !Empty(jParams['MV_PAR05'][1])
			cMunicipio := AllTrim(jParams['MV_PAR05'][1])
		EndIf

		nDecs	:= Msdecimais(nMoeda)

		lProcesa := .T.  //Pasa las validaciones y puede procesar.
	Endif

	//Solo procesa si los par·metros fueron informados.
	If  lProcesa
		For nFil := 1 to len(aFiliales)  

			aLivros		:= {}
			cSUMBas		:= ""
			cSUMVal		:= ""
			cSUMBas2	:= ""
			cSUMVal2	:= ""
			nSeq		:= 0 
			cQrySuc		:= "" 

			
			// Realiza a montagem da QUERY que ser· enviada para o banco de dados
			// (Mejora: verificar si la comparticiÛn de la SFB CCC y en este caso solo buscar una vez los libros)
			If oExecA == Nil
				cQueryfb := "SELECT FB_FILIAL, FB_CODIGO, FB_CPOLVRO "
				cQueryfb += "FROM " + RetSQLName( "SFB" ) + " SFB "
				cQueryfb += "WHERE SFB.FB_FILIAL = ? "
				cQueryfb += "   AND SFB.FB_CODIGO IN (?) "
				cQueryfb += "   AND SFB.D_E_L_E_T_= ? "

				// Executa a QUERY e cria uma tabela temporaria com os dados retornados
				cQueryfb := ChangeQuery( cQueryfb )

				oExecA := FwExecStatement():New( cQueryfb )
			EndIf	

			oExecA:SetString( 1,	FWxFilial("SFB", PadR(aFiliales[nFil], FwTamSx3("FB_FILIAL")[1], " ")))
			oExecA:SetIn(	  2,	aImptos )  
			oExecA:SetString( 3,	' '  )

			cQueryfb := oExecA:getFixQuery( )

			// Executa a QUERY e cria uma tabela temporaria 
			cAliasA := oExecA:OpenAlias( )

			While !( cAliasA )->( EOF( ) )
				aAdd(aLivros,(cAliasA)->FB_CPOLVRO)

				( cAliasA )->( DbSkip( ) )
			End
			( cAliasA )->( DbCloseArea( ) )


			If  len(aLivros) > 0 
				//Obtienes los campos D1_BASIMPx, D1_ALQIMPx y D1_VALIMP, de todo los impuestos que fueron informados, 
				//los campos libro ya est·n contenidos en el arreglo aLivros.
				ObtCpsLiv(aLivros, "D1", @cSUMBas, @cSUMVal,@cWhereVal,cVista)
				ObtCpsLiv(aLivros, "D2", @cSUMBas2,@cSUMVal2,@cWhereVal2,cVista)
			
				
				If  !Empty(cSUMBas) .And. !Empty(cSUMVal) .And. !Empty(cSUMBas2) .And. !Empty(cSUMVal2)
					
					
					
						// Realiza a montagem da QUERY que serù enviada para o banco de dados
						cQrySuc += "SELECT SF1.F1_FILIAL, SF1.F1_DOC, SF1.F1_SERIE, SF1.F1_FORNECE, SF1.F1_LOJA, SF1.F1_ESPECIE,SF1.F1_MOEDA, SF1.F1_TXMOEDA, SF1.F1_EMISSAO, "
						IF cVista=="'G'"
							cQrySuc += "	 'G' AS VISTA, "
						ELSEIF cVista=="'D'"
							cQrySuc += "	 'D' AS VISTA, "
						ENDIF
						cQrySuc += " CASE WHEN RTRIM(SD1.D1_TPACTIV) <> '' THEN SD1.D1_TPACTIV ELSE SF1.F1_TPACTIV END AS F1_TPACTIV, "
						IF cVista=="'G'"
							cQrySuc += " SB1.B1_TPCLAS, SD1.D1_ITEM, SD1.D1_COD, SD1.D1_QUANT,SD1.D1_VUNIT, SD1.D1_TOTAL, SD1.D1_TES, ?, ? , "	
						ELSEIF cVista=="'D'"
							cQrySuc += " 0 B1_TPCLAS, 0 D1_ITEM,0 D1_COD, 0 D1_QUANT,0 D1_VUNIT, SUM( SD1.D1_TOTAL) D1_TOTAL, 0 D1_TES, ?, ? , "
						ENDIF
						cQrySuc += " CASE WHEN RTRIM(SD1.D1_CODMUN) <> '' THEN SD1.D1_CODMUN ELSE SF1.F1_CODMUN END AS D1_CODMUN ,F1_EST"
						cQrySuc += " FROM " + RetSQLName( 'SD1' ) + " SD1 " 
						cQrySuc += "INNER JOIN " + RetSQLName( 'SF1' ) + " SF1 "
						cQrySuc += "   ON SF1.F1_EMISSAO BETWEEN ? AND ? "
						cQrySuc += "      AND SF1.F1_ESPECIE IN (?) "
						cQrySuc += "      AND SF1.F1_DOC = SD1.D1_DOC "
						cQrySuc += "      AND SF1.F1_SERIE = SD1.D1_SERIE "
						cQrySuc += "      AND SF1.F1_TIPO  = SD1.D1_TIPO "
						cQrySuc += "      AND SF1.F1_TIPODOC = SD1.D1_TIPODOC  "
						cQrySuc += "      AND SF1.F1_FORNECE = SD1.D1_FORNECE  "
						cQrySuc += "      AND SF1.F1_LOJA = SD1.D1_LOJA  "
						cQrySuc += "      AND F1_FILIAL = ? "
						cQrySuc += "      AND SF1.D_E_L_E_T_ = ? "
						cQrySuc += "INNER JOIN " + RetSQLName( 'SB1' ) + " SB1 "
						cQrySuc += "   ON SB1.B1_COD = SD1.D1_COD "
						cQrySuc += "      AND SB1.B1_FILIAL = ? "
						cQrySuc += "      AND SB1.D_E_L_E_T_ = ? "
						cQrySuc += "WHERE SD1.D1_FILIAL = ? "
						cQrySuc += "      AND SD1.D_E_L_E_T_ = ? "	
						cQrySuc += "      AND ( ? ) > 0 " 

						// Agrega os filtros na QUERY
						For nX := 1 To Len( aFiltro )
							cQrySuc += " AND ? " + ' ' + " ? ? "
						Next
						If !Empty(cMunicipio)
							cQrySuc += "  AND ( (RTRIM(SD1.D1_CODMUN) <> '' AND RTRIM(SD1.D1_CODMUN) = ?) OR (RTRIM(SD1.D1_CODMUN) = '' AND RTRIM(SF1.F1_CODMUN) = ?) ) "
						EndIf	

						IF cVista=="'D'"
							cQrySuc+=" GROUP BY SF1.F1_FILIAL, SF1.F1_DOC, SF1.F1_SERIE, SF1.F1_FORNECE, SF1.F1_LOJA, SF1.F1_ESPECIE,SF1.F1_MOEDA, SF1.F1_TXMOEDA, SF1.F1_EMISSAO, "
							cQrySuc+="  CASE WHEN RTRIM(SD1.D1_TPACTIV) <> '' THEN SD1.D1_TPACTIV ELSE SF1.F1_TPACTIV END , "
							cQrySuc+=" CASE WHEN RTRIM(SD1.D1_CODMUN) <> '' THEN SD1.D1_CODMUN ELSE SF1.F1_CODMUN END  ,F1_EST "

						ENDIF
						cQrySuc += "UNION "
						cQrySuc += "SELECT SF2.F2_FILIAL F1_FILIAL, SF2.F2_DOC F1_DOC, SF2.F2_SERIE F1_SERIE, SF2.F2_CLIENTE F1_FORNECE, SF2.F2_LOJA F1_LOJA, SF2.F2_ESPECIE F1_ESPECIE, SF2.F2_MOEDA F1_MOEDA, SF2.F2_TXMOEDA F1_TXMOEDA,  SF2.F2_EMISSAO F1_EMISSAO,  "
						IF cVista=="'G'"
							cQrySuc += "	 'G' AS VISTA, "
						ELSEIF cVista=="'D'"
							cQrySuc += "	 'D' AS VISTA, "
						ENDIF
						cQrySuc += " CASE WHEN RTRIM(SD2.D2_TPACTIV) <> '' THEN SD2.D2_TPACTIV ELSE SF2.F2_TPACTIV END AS F1_TPACTIV, "
						IF cVista=="'G'"
						cQrySuc += " SB1.B1_TPCLAS, SD2.D2_ITEM D1_ITEM, SD2.D2_COD D1_COD, SD2.D2_QUANT D1_QUANT, SD2.D2_PRCVEN D1_VUNIT, SD2.D2_TOTAL D1_TOTAL, SD2.D2_TES D1_TES, ?, ? , "	
						ELSEIF cVista=="'D'"
							cQrySuc += " 0 B1_TPCLAS, 0 D1_ITEM,0 D1_COD, 0 D1_QUANT,0 D1_VUNIT, SUM( SD2.D2_TOTAL) D1_TOTAL, 0 D1_TES, ?, ? , "
						ENDIF
						cQrySuc += " CASE WHEN RTRIM(SD2.D2_CODMUN) <> '' THEN SD2.D2_CODMUN ELSE SF2.F2_CODMUN END AS D1_CODMUN ,F2_EST AS F1_EST "
						cQrySuc += " FROM " + RetSQLName( 'SD2' ) + " SD2 " 
						cQrySuc += "INNER JOIN " + RetSQLName( 'SF2' ) + " SF2 "
						cQrySuc += "   ON SF2.F2_EMISSAO BETWEEN ? AND ? "
						cQrySuc += "      AND SF2.F2_ESPECIE IN (?) "
						cQrySuc += "      AND SF2.F2_DOC = SD2.D2_DOC "
						cQrySuc += "      AND SF2.F2_SERIE = SD2.D2_SERIE "
						cQrySuc += "      AND SF2.F2_TIPO  = SD2.D2_TIPO "
						cQrySuc += "      AND SF2.F2_TIPODOC = SD2.D2_TIPODOC  "
						cQrySuc += "      AND SF2.F2_CLIENTE = SD2.D2_CLIENTE  "
						cQrySuc += "      AND SF2.F2_LOJA = SD2.D2_LOJA  "
						cQrySuc += "      AND F2_FILIAL = ? "
						cQrySuc += "      AND SF2.D_E_L_E_T_ = ? "
						cQrySuc += "INNER JOIN " + RetSQLName( 'SB1' ) + " SB1 "
						cQrySuc += "   ON SB1.B1_COD = SD2.D2_COD "
						cQrySuc += "      AND SB1.B1_FILIAL = ? "
						cQrySuc += "      AND SB1.D_E_L_E_T_ = ? "
						cQrySuc += "WHERE SD2.D2_FILIAL = ? "
						cQrySuc += "      AND SD2.D_E_L_E_T_ = ? "
						cQrySuc += "      AND ( ? ) > 0 "
						

						// Agrega os filtros na QUERY
						For nX := 1 To Len( aFiltro )
							cQrySuc += " AND ? " + ' ' + " ? ? "
						Next
						If !Empty(cMunicipio)
							cQrySuc += "  AND ( (RTRIM(SD2.D2_CODMUN) <> '' AND RTRIM(SD2.D2_CODMUN) = ?) OR (RTRIM(SD2.D2_CODMUN) = '' AND RTRIM(SF2.F2_CODMUN) = ?) ) "
						EndIf
						If cVista=="'D'"
							cQrySuc+=" GROUP BY SF2.F2_FILIAL, SF2.F2_DOC, SF2.F2_SERIE, SF2.F2_CLIENTE, SF2.F2_LOJA, SF2.F2_ESPECIE,SF2.F2_MOEDA, SF2.F2_TXMOEDA, SF2.F2_EMISSAO, "
							cQrySuc+="  CASE WHEN RTRIM(SD2.D2_TPACTIV) <> '' THEN SD2.D2_TPACTIV ELSE SF2.F2_TPACTIV END , "
							cQrySuc+=" CASE WHEN RTRIM(SD2.D2_CODMUN) <> '' THEN SD2.D2_CODMUN ELSE SF2.F2_CODMUN END  ,F2_EST "
						ENDIF
						//almacena cada query de sucursal en el arreglo aQryBloques
						aAdd(aQryBloques, cQrySuc)
						//Se agrega el complemento del query con el D1_BASIMP y D1_VALIMP (tengan o no contenido)
						aAdd(aQryLivro,{cSUMBas,cSUMVal,cSUMBas2,cSUMVal2, cWhereVal, cWhereVal2})
					
					
				Endif 
			Endif
		Next nFil

		cQuery := ""
		If Len(aQryBloques) > 0
			For nX := 1 To Len(aQryBloques)
				cQuery += aQryBloques[nX]
				// Solo pone el UNION ALL si hay otra sucursal
				If nX < Len(aQryBloques)
					cQuery += " UNION ALL "
				EndIf
			Next nX
		EndIf
		If  !Empty(cQuery)
			cQuery := ChangeQuery( cQuery )
			oExecB := FwExecStatement():New() // Executa a QUERY e cria uma tabela temporaria com os dados retornados
			oExecB:SetQuery( cQuery )//Define a consulta e os par‚metros
		
			For nFil := 1 to len(aQryLivro)  
				If  !Empty(aQryLivro[nFil,1]) .And. !Empty(aQryLivro[nFil,2]) .And. !Empty(aQryLivro[nFil,3]) .And. !Empty(aQryLivro[nFil,4])   //!Empty(cSUMBas) .And. !Empty(cSUMAlq) .And. !Empty(cSUMVal) .And. !Empty(cSUMBas2) .And. !Empty(cSUMAlq2) .And. !Empty(cSUMVal2)
					oExecB:SetUnsafe( nSeq += 1, aQryLivro[nFil,1] )  //cSUMBas
					oExecB:SetUnsafe( nSeq += 1, aQryLivro[nFil,2] )  //cSUMVal
					oExecB:SetString( nSeq += 1, DtoS( FwDateTimeToLocal( jParams['MV_PAR01'][1] )[1] ) )
					oExecB:SetString( nSeq += 1, DtoS( FwDateTimeToLocal( jParams['MV_PAR02'][1] )[1] ) )
					oExecB:SetIn( nSeq += 1, aEspSF1)
					oExecB:SetString( nSeq += 1, FWxFilial("SF1", PadR(aFiliales[nFil], FwTamSx3("F1_FILIAL")[1], " ")))
					oExecB:SetString( nSeq += 1, ' ' )
					oExecB:SetString( nSeq += 1, FWxFilial("SB1", PadR(aFiliales[nFil], FwTamSx3("B1_FILIAL")[1], " ")))
					oExecB:SetString( nSeq += 1, ' ' )
					oExecB:SetString( nSeq += 1, FWxFilial("SD1", PadR(aFiliales[nFil], FwTamSx3("D1_FILIAL")[1], " ")))
					oExecB:SetString( nSeq += 1, ' ' )	
					oExecB:SetUnsafe( nSeq += 1, aQryLivro[nFil,5] )	
					For nX := 1 To Len( aFiltro )
						oExecB:SetUnSafe ( nSeq += 1, aFiltro[nX, 1] )
						oExecB:SetUnSafe ( nSeq += 1, aFiltro[nX, 2] )
						oExecB:SetUnSafe ( nSeq += 1, aFiltro[nX, 3] )
					Next
					If !Empty(cMunicipio)
						oExecB:SetString( nSeq += 1, cMunicipio ) // Para D1_CODMUN 
						oExecB:SetString( nSeq += 1, cMunicipio ) // Para F1_CODMUN 
					EndIf

					oExecB:SetUnsafe( nSeq += 1, aQryLivro[nFil,3] )  //cSUMBas2
					oExecB:SetUnsafe( nSeq += 1, aQryLivro[nFil,4] )  //cSUMVal2
					oExecB:SetString( nSeq += 1, DtoS( FwDateTimeToLocal( jParams['MV_PAR01'][1] )[1] ) )
					oExecB:SetString( nSeq += 1, DtoS( FwDateTimeToLocal( jParams['MV_PAR02'][1] )[1] ) )
					oExecB:SetIn( nSeq += 1, aEspSF2) 
					oExecB:SetString( nSeq += 1, FWxFilial("SF2", PadR(aFiliales[nFil], FwTamSx3("F2_FILIAL")[1], " ")))
					oExecB:SetString( nSeq += 1, ' ' )
					oExecB:SetString( nSeq += 1, FWxFilial("SB1", PadR(aFiliales[nFil], FwTamSx3("B1_FILIAL")[1], " ")))
					oExecB:SetString( nSeq += 1, ' ' )
					oExecB:SetString( nSeq += 1, FWxFilial("SD2", PadR(aFiliales[nFil], FwTamSx3("D2_FILIAL")[1], " ")))
					oExecB:SetString( nSeq += 1, ' ' )
					oExecB:SetUnsafe( nSeq += 1, aQryLivro[nFil,6] )
					
					For nX := 1 To Len( aFiltro )
						oExecB:SetUnSafe ( nSeq += 1, aFiltro[nX, 1] )
						oExecB:SetUnSafe ( nSeq += 1, aFiltro[nX, 2] )
						oExecB:SetUnSafe ( nSeq += 1, aFiltro[nX, 3] )
					Next
					If !Empty(cMunicipio)
						oExecB:SetString( nSeq += 1, cMunicipio ) // Para D2_CODMUN
						oExecB:SetString( nSeq += 1, cMunicipio ) // Para F2_CODMUN
					EndIf
				Endif
			Next nFil

			cQuery := oExecB:getFixQuery( )
			cAliasB := oExecB:OpenAlias( )// Executa a QUERY e cria uma tabela temporaria com os dados retornados
			

			// Alimenta o objeto de dados da classe para retornar ao SmartView
			While !( cAliasB )->( EOF( ) )	
				
					self:jItems := JsonObject():new( )				
					For nX := 1 To Len( self:aStruct )
						If  Alltrim(self:aStruct[nX][1]) == "D1_VUNIT" .And. (cAliasB)->F1_MOEDA <> nMoeda
							self:jItems[self:aStruct[nX][1]] := xMoeda((cAliasB)->D1_VUNIT,(cAliasB)->F1_MOEDA,nMoeda,(cAliasB)->F1_EMISSAO,nDecs+1,(cAliasB)->F1_TXMOEDA)
						Elseif  Alltrim(self:aStruct[nX][1]) == "D1_TOTAL" 
							If  (cAliasB)->F1_MOEDA <> nMoeda
								self:jItems[self:aStruct[nX][1]] := xMoeda((cAliasB)->D1_TOTAL,(cAliasB)->F1_MOEDA,nMoeda,(cAliasB)->F1_EMISSAO,nDecs+1,(cAliasB)->F1_TXMOEDA)
							Else
								self:jItems[self:aStruct[nX][1]] := ( cAliasB )->&( self:aStruct[nX][5] )
							Endif
							If  Alltrim((cAliasB)->F1_ESPECIE) $'NCP|NCC'
								self:jItems[self:aStruct[nX][1]] := self:jItems[self:aStruct[nX][1]] * (-1)
							Endif
						Elseif  Alltrim(self:aStruct[nX][1]) == "D1_BASIMP" 
							If  (cAliasB)->F1_MOEDA <> nMoeda
								self:jItems[self:aStruct[nX][1]] := xMoeda((cAliasB)->D1_BASIMP,(cAliasB)->F1_MOEDA,nMoeda,(cAliasB)->F1_EMISSAO,nDecs+1,(cAliasB)->F1_TXMOEDA)
							Else
								self:jItems[self:aStruct[nX][1]] := ( cAliasB )->&( self:aStruct[nX][5] )
							Endif
							If  Alltrim((cAliasB)->F1_ESPECIE) $'NCP|NCC'
								self:jItems[self:aStruct[nX][1]] := self:jItems[self:aStruct[nX][1]] * (-1)
							Endif
						Elseif  Alltrim(self:aStruct[nX][1]) == "D1_VALIMP"
							If  (cAliasB)->F1_MOEDA <> nMoeda
								self:jItems[self:aStruct[nX][1]] := xMoeda((cAliasB)->D1_VALIMP,(cAliasB)->F1_MOEDA,nMoeda,(cAliasB)->F1_EMISSAO,nDecs+1,(cAliasB)->F1_TXMOEDA)
							Else
								self:jItems[self:aStruct[nX][1]] := ( cAliasB )->&( self:aStruct[nX][5] )
							Endif
							If   Alltrim((cAliasB)->F1_ESPECIE) $'NCP|NCC'
								self:jItems[self:aStruct[nX][1]] := self:jItems[self:aStruct[nX][1]] * (-1)
							Endif
						ElseIf ( self:aStruct[nX][3] == 'date' )
							self:jItems[self:aStruct[nX][1]] := totvs.framework.treports.date.dateToTimeStamp( StoD( ( cAliasB )->&( self:aStruct[nX][5] ) ) )
						Else
							self:jItems[self:aStruct[nX][1]] := ( cAliasB )->&( self:aStruct[nX][5] )
						Endif
					Next
						
					// Inclui os dados no objeto paea retorno ao SmartView
					self:oData:appendData( self:jItems )
				

				( cAliasB )->( DbSkip( ) )
			End
			( cAliasB )->( DbCloseArea( ) )
		Endif 

	EndIf

	If oExecA <> Nil
		oExecA:Destroy( )
		FwFreeObj(oExecA)
		oExecA := Nil	
	Endif
	If oExecB <> Nil
		oExecB:Destroy( )
		FwFreeObj(oExecB)
		oExecB := Nil
	Endif
	FwFreeArray(aImptos)
	FwFreeArray(aFiliales)
	FwFreeArray(aQryBloques)
	FwFreeArray(aQryLivro)
	fwFreeObj(oLivros)

Return( self:oData )

//-------------------------------------------------------------------
/*{Protheus.doc} getSchema
@description Retorna la estructura de los campos
@return object: self:oSchema
@author Laura Medina
@since 11/12/2025
@version 1.0
*/
//------------------------------------------------------------------- 
Method getSchema() as object class districtfilesTReportsBusinessObject

	Local nX as numeric

	// Adiciona as propriedades dos campos que ser„o retornados para o SMARTView
	For nX := 1 To Len( self:aStruct )
		self:addProperty( self:aStruct[nX][1], self:aStruct[nX][2], self:aStruct[nX][3], self:aStruct[nX][4], self:aStruct[nX][5] )
	Next

Return( self:oSchema )


//-------------------------------------------------------------------
/*{Protheus.doc} ObtCpsLiv
@description: FunciÛn que arma parte del query con los campos de libros fiscales
@param aLivros  array  : Arreglo con los campos libro (1,2,3,..A).
@param cIDTable character  : Alias de la tabla a usar "D1" o "D2".
@param cSUMBas  character  : Variable para sumar los _BASIMPx
@param cSUMVal  character  : Variable para sumar los _VALIMPx

@author Laura Medina
@since 15/01/2026
@version 1.0
*/
//------------------------------------------------------------------- 
Static Function ObtCpsLiv(aLivros, cIDTable, cSUMBas, cSUMVal,cWhereVal,cVista)
	Local nPosBas		as numeric
	Local nPosVal		as numeric
	Local nLoop			as numeric
	Local cAux          as character
	Local aStruSD1		as array

	Default aLivros 	:= {}  
	Default cIDTable	:= ""  
	Default cSUMBas		:= ""  
	Default cSUMVal 	:= ""
	Default cWhereVal   := ""
	Default cVista		:=""

	nPosBas			:= 0
	nPosVal			:= 0
	nLoop			:= 0
	aStruSD1		:= {}
	cAux			:= " "
	// Campos de impuestos
	If  cIDTable == "D1"
		aStruSD1 := SD1->( DbStruct( ) )
	Elseif cIDTable == "D2"
		aStruSD1 := SD2->( DbStruct( ) )
	Endif 
	For nloop:= 1 to len(aLivros)
		// PosiciÛn de los impuestos
		nPosBas := aScan( aStruSD1, { | x |  x[1] == cIDTable+"_BASIMP"+aLivros[nloop] } )
		nPosVal := aScan( aStruSD1, { | x |  x[1] == cIDTable+"_VALIMP"+aLivros[nloop] } )
		If  nPosBas > 0 
			If  !Empty(cSUMBas)	
				cSUMBas += " + "
			Endif	
			IF cVista=="'D'"
				cSUMBas +="SUM("+ cIDTable+"_BASIMP"+aLivros[nloop]+") "
			ELSE
				cSUMBas += cIDTable+"_BASIMP"+aLivros[nloop]
			EndIf
		EndIf
		// Los valores de los impuestos se suman de manera acumulativa	
		If  nPosVal > 0 
			If  !Empty(cSUMVal)	
				cSUMVal += " + "
				cAux += " + "
			Endif
			IF cVista=="'D'"
				cSUMVal += " SUM("+ cIDTable+"_VALIMP"+aLivros[nloop] +") "
				
			ELSE
				cSUMVal += cIDTable+"_VALIMP"+aLivros[nloop]
			EndIf
			cAux += cIDTable+"_VALIMP"+aLivros[nloop]+" "
		EndIf
	Next nloop
	
	cWhereVal := cAux
	If  !Empty(cSUMBas)
		cSUMBas := cSUMBas + ' ' + cIDTable + '_BASIMP'
	EndIf	
	If  !Empty(cSUMVal)
		cSUMVal := cSUMVal + ' ' + cIDTable + '_VALIMP'
	EndIf

	FwFreeArray(aStruSD1)
Return 
//-------------------------------------------------------------------
/*{Protheus.doc} ObtRangFil
@description: FunciÛn que eval˙a el rango de sucursales.
@param cDesde character : Sucursal inicial
@param cHasta character : Sucursal final 
@return array : Arreglo con los cÛdigos internos correspondientes
*/
//------------------------------------------------------------------- 
Static Function ObtRangFil(cDesde, cHasta)
	Local aSM0		:= FWLoadSM0()
	Local aRango	:= {}
	Local nI		as numeric
	Local cCodFil	as character

	Default cDesde	:= ""
	Default cHasta	:= ""	
	For nI := 1 To Len(aSM0)
		cCodFil:=AllTrim(aSM0[nI, 2])

		If cCodFil >= AllTrim(cDesde) .And. cCodFil <= AllTrim(cHasta)
			aAdd(aRango, cCodFil)
		EndIf
	Next

Return aRango
