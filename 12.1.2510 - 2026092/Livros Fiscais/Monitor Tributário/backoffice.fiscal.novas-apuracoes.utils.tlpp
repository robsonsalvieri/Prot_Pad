#INCLUDE "TLPP-CORE.TH"
#INCLUDE "TLPP-REST.TH"
#INCLUDE "TOTVS.CH"
#INCLUDE "PROTHEUS.CH"

namespace totvs.protheus.backoffice.tit.control.utils

/*/{Protheus.doc} ControlTITUtils
    Classe genÈrica de utilidades para o controle do TIT
    @author Caique Carlos
    @since 12/02/2026
    @version 1.0
/*/
Class ControlTITUtils
    Public Method new() as object

    @Get("/api/fiscal/tax-monitor/v1/generic-functions/values-combo/:objectName/:function")
    Public Method GetComboParamSv()

    Static Method GetOptionCombo() as array
    Static Method ProcessValuesCombo() as character
    Public Method TITGetPreviousPeriod()
    Public Method TITDateToApiFormat() as character

    Private data jPath        as object
    Private data cFunction    as character
    Private data cObjectName  as character
    Private data cComboValues as character
    Private data aOptions     as array
EndClass

/*/{Protheus.doc} New
    Inicializa a classe ControlTITUtils
    @author Caique Carlos
    @since 12/02/2026
    @version 1.0
    @return Self, object, Inst‚ncia da classe ControlTITUtils
/*/
Method New() Class ControlTITUtils
    ::jPath        := Nil
    ::aOptions     := {}
    ::cFunction    := ""
    ::cObjectName  := ""
    ::cComboValues := ""
Return Self

/*/{Protheus.doc} GetComboParamSv
    MÈtodo para preparar os valores do combo via API do SmartView, a partir da funÁ„o e objeto requisitado
    @author Caique Carlos
    @since 12/02/2026
    @version 1.0
    @return cComboValues, Json, Retorna os valores do combo formatados em Json para serem consumidos pelo SmartView
/*/
Method GetComboParamSv() Class ControlTITUtils
    ::jPath := oRest:GetPathParamsRequest()
    If (::jPath <> Nil)
        ::cFunction   := ::jPath["function"]
        ::cObjectName := ::jPath["objectName"]
    EndIf

    ::aOptions := ::GetOptionCombo(::cFunction, ::cObjectName)
    ::cComboValues := ::ProcessValuesCombo(::aOptions)

    aSize(::aOptions, 0)

Return oRest:SetResponse(::cComboValues)

/*/{Protheus.doc} GetOptionCombo
    MÈtodo para validar se a funÁ„o existem no RPO. Caso exista, realiza a chamada da funÁ„o e retorna os valores para o combo.
    @author Caique Carlos
    @since 12/02/2026
    @version 1.0
    @param cFunction, character, Nome da funÁ„o a ser chamada
    @param cObjectName, character, Nome do objeto de negÛcio a ser chamado
    @return aReturn, array, Valores retornados pela funÁ„o para o combo
/*/
Method GetOptionCombo(cFunction as character, cObjectName as character) as array Class ControlTITUtils
    Local aReturn           := {}                              as array
    Local lFound            := .F.                             as logical
    Local cInitialName      := "totvs.protheus.backoffice.sv"  as character
    Local cLastName         := "treports.integratedprovider"   as character
    Local cFullNameFunction :=  cInitialName + ".fiscal." + cObjectName + "." +;
                                cLastName + "." + cFunction    as character

    lFound  := tlpp.ffunc(cFullNameFunction)

    If lFound
        aReturn := tlpp.call(cFullNameFunction)
    EndIf
Return aReturn

/*/{Protheus.doc} ProcessValuesCombo
    MÈtodo para processar os valores do combo. Ao final retorna um Json formatado para ser consumido pelo SmartView,
        contendo as chaves "key" e "label" para cada opÁ„o do combo.
    @author Caique Carlos
    @since 12/02/2026
    @version 1.0
    @param aOptions, array, Valores retornados pela funÁ„o para o combo
    @return cReturn, character, Valores do combo formatados em Json para serem consumidos pelo SmartView
/*/
Method ProcessValuesCombo(aOptions as array) as character Class ControlTITUtils
    Local jReturn := JsonObject():New() as json
    Local aReturn := {}                 as array
    Local nX      := 0                  as numeric
    Local nPos    := 0                  as numeric

    For nX := 1 to Len(aOptions)
        aAdd(aReturn, JsonObject():New())
        nPos := Len(aReturn)

        aReturn[nPos]["key"] := nX
        aReturn[nPos]["label"] := AllTrim(aOptions[nX])
    Next nX

    jReturn["data"] := aReturn
Return jReturn:toJson()

/*/{Protheus.doc} TITGetPreviousPeriod
    MÈtodo que calcula o perùodo anterior equivalente (em dias) a um perùodo informado, para fins de
    comparaùùo de tendùncia. A duraùùo (em dias, inclusive) do perùodo informado ù replicada
    imediatamente antes da data inicial informada.
    @author Yasmim Lira
    @since 28/07/2026
    @version 1.0
    @param cPeriodStart, character, Data inicial do perùodo atual no formato YYYY-MM-DD
    @param cPeriodEnd, character, Data final do perùodo atual no formato YYYY-MM-DD
    @param cPeriodStartAnt, character, (Referùncia) Data inicial do perùodo anterior no formato YYYY-MM-DD
    @param cPeriodEndAnt, character, (Referùncia) Data final do perùodo anterior no formato YYYY-MM-DD
    @return Nil, nulo, Datas retornadas via parùmetros por referùncia
    @example
        // periodStart=01/05/2026, periodEnd=30/06/2026 (61 dias) => perùodo anterior = 01/03/2026 a 30/04/2026
        TITGetPreviousPeriod("2026-05-01", "2026-06-30", @cPeriodStartAnt, @cPeriodEndAnt)
/*/
Method TITGetPreviousPeriod(cPeriodStart as character, cPeriodEnd as character, cPeriodStartAnt as character, cPeriodEndAnt as character) Class ControlTITUtils
    // Datas mantidas sem tipagem estùtica ("as date") propositalmente: o compilador TLPP infere
    // o resultado de "date - date" como "date" (e nùo "numeric"), causando erro de tipos
    // incompatùveis entre N e D na atribuiùùo de nDuration. Comportamento dinùmico (AdvPL) evita o falso positivo.
    Local dPeriodStart      := StoD(StrTran(cPeriodStart, "-", ""))
    Local dPeriodEnd        := StoD(StrTran(cPeriodEnd, "-", ""))
    Local dPeriodStartAnt
    Local dPeriodEndAnt
    Local nDuration         := 0                                   as numeric

    nDuration       := dPeriodEnd - dPeriodStart + 1   // Duraùùo do perùodo informado, em dias (inclusive)
    dPeriodEndAnt   := dPeriodStart - 1
    dPeriodStartAnt := dPeriodStart - nDuration

    cPeriodStartAnt := ::TITDateToApiFormat(dPeriodStartAnt)
    cPeriodEndAnt   := ::TITDateToApiFormat(dPeriodEndAnt)
Return Nil

/*/{Protheus.doc} TITDateToApiFormat
    Converte uma data para o formato de caracter YYYY-MM-DD utilizado pelos parùmetros de
    perùodo das APIs do Monitor Tributùrio.
    @author Yasmim Lira
    @since 28/07/2026
    @version 1.0
    @param dDate, date, Data a ser convertida
    @return cDate, character, Data convertida no formato YYYY-MM-DD
    @example
        TITDateToApiFormat(StoD("20260301")) // Retorna "2026-03-01"
/*/
Method TITDateToApiFormat(dDate as date) as character Class ControlTITUtils
    Local cAaaaMmDd := DtoS(dDate) as character
Return SubStr(cAaaaMmDd, 1, 4) + "-" + SubStr(cAaaaMmDd, 5, 2) + "-" + SubStr(cAaaaMmDd, 7, 2)
