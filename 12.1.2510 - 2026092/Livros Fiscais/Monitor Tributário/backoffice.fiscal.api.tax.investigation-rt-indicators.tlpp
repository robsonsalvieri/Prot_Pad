#INCLUDE "tlpp-core.th"
#INCLUDE "tlpp-rest.th"
#INCLUDE "totvs.ch"
#INCLUDE "FISA318.CH"

namespace totvs.protheus.backoffice.fiscal.investigationRtCredits                                                                                                                                                                                                                         
using namespace totvs.protheus.backoffice.tit.control.utils

/*/ {Protheus.doc} TITInvestigationRTCredits
    Endpoint REST para processar a requisiùùo da API de indicadores de CrÈditos (CBS + IBS) da
    visùo Investigation RT, para preenchimento do card Total de CrÈditos.
    @type  Function
    @author Yasmim Lira
    @since 28/07/2026
    @version 1.0
    @param branches, character, Codigo das filiais separadas por viùrgula (via query parameter)
    @param periodStart, character, Data inicial do periùodo no formato YYYY-MM-DD (via query parameter)
    @param periodEnd, character, Data final do periodo no formato YYYY-MM-DD (via query parameter)
    @return Nil, nulo, Resposta enviada via framework oRest
    @example
        GET /api/fiscal/tax-monitor/v1/investigation-rt/credits?branches=D MG 01 ,D RJ 02 ,D SP 01&periodStart=2024-06-12&periodEnd=2025-06-15
/*/
@get(endpoint='/api/fiscal/tax-monitor/v1/investigation-rt/credits', description='Obtùm os indicadores de CrÈditos da visùo Investigation RT para preenchimento do card Total de CrÈditos.')
Function TITInvestigationRTCredits()
    Local oJsResponse := JsonObject():new()                as json
    Local oQryStr     := oRest:getQueryRequest()           as json
    Local aRequiredProperties                              as array

    aRequiredProperties	:= {;
        {'branches',400,;   //PROPERTY //ERROR_CODE
        STR0069,;           //"O parametro 'branches' eh obrigatorio e n„o foi informado."
        STR0070},;          //"Informar Codigo de Filiais separadas por vi≠rgula."
        {'periodStart',400,;
        STR0071,;           //"Nenhuma Data foi informada no parametro 'periodStart'."
        STR0072},;          //"Informar a data desejada para o peri≠odo"
        {'periodEnd',400,;
        STR0073,;           //"Nenhuma Data foi informada no parametro 'periodEnd'."
        STR0072};           //"Informar a data desejada para o periodo"
    }

    If FISA318F6HasApiRequiredProperties(aRequiredProperties, oQryStr, @oJsResponse) 
        oJsResponse := GetJsonInvestigationRTCredits(;
                                                oQryStr['branches'],;
                                                oQryStr['periodStart'],;
                                                oQryStr['periodEnd'];
                                                )  
    EndIf

    oRest:setKeyHeaderResponse('Content-Type', 'application/json')
    oRest:setResponse(oJsResponse)

    FwFreeArray(aRequiredProperties)
    FWFreeObj(oJsResponse)
    FWFreeObj(oQryStr)

Return

/*/{Protheus.doc} GetJsonInvestigationRTCredits
    Funùùo para obter o total de CrÈditos (CBS + IBS) do perùodo atual e do perùodo anterior
    equivalente, calcular a tendùncia percentual entre eles e montar o json de resposta.
    @type  Function
    @author Yasmim Lira
    @since 28/07/2026
    @version 1.0
    @param cBranches, character, Codigo das filiais separadas por virgula
    @param cPeriodStart, character, Data inicial do perùodo no formato YYYY-MM-DD
    @param cPeriodEnd, character, Data final do perùodo no formato YYYY-MM-DD
    @return cJsonResponse, character, Dados processados em formato JSON string
    @example
        GetJsonInvestigationRTCredits("D MG 01,D RJ 02", "2024-01-01", "2024-12-31")
/*/
Static Function GetJsonInvestigationRTCredits(cBranches as character, cPeriodStart as character, cPeriodEnd as character) as character
    Local oJsResult         := JsonObject():New() as json
    Local cAliasAtual       := GetNextAlias()     as character
    Local cAliasAnterior    := GetNextAlias()     as character
    Local cPeriodStartAnt   := ""                 as character
    Local cPeriodEndAnt     := ""                 as character
    Local nCreditsAtual      := 0              as numeric
    Local nCreditsAnterior   := 0              as numeric
    Local nPercent          := 0                  as numeric
    Local lPositive         := .F.                as logical
    Local cPercent          := ""                 as character
    Local cTipoMo           := "E"               as character
    Local oUtils            := ControlTITUtils():New() as object

    oUtils:TITGetPreviousPeriod(cPeriodStart, cPeriodEnd, @cPeriodStartAnt, @cPeriodEndAnt)
    FWFreeObj(oUtils)

    GetValuesInvestigationRTCredits(@cAliasAtual, cBranches, cPeriodStart, cPeriodEnd, cTipoMo)
    nCreditsAtual := (cAliasAtual)->TOTALCREDITO
    (cAliasAtual)->(DbCloseArea())

    GetValuesInvestigationRTCredits(@cAliasAnterior, cBranches, cPeriodStartAnt, cPeriodEndAnt, cTipoMo)
    nCreditsAnterior := (cAliasAnterior)->TOTALCREDITO
    (cAliasAnterior)->(DbCloseArea())

    If nCreditsAtual == 0
        oJsResult["Credits"] := JsonObject():New()
    Else
        If nCreditsAnterior == 0
            cPercent  := "0%"
            lPositive := .T.
        Else
            nPercent  := ((nCreditsAtual - nCreditsAnterior) / nCreditsAnterior) * 100
            cPercent  := AllTrim(Transform(nPercent, "@E 999999.99")) + "%"
            lPositive := (nCreditsAtual > nCreditsAnterior)
        EndIf

        oJsResult["totalCredits"]                     := JsonObject():New()
        oJsResult["totalCredits"]["value"]            := nCreditsAtual
        oJsResult["totalCredits"]["trend"]            := JsonObject():New()
        oJsResult["totalCredits"]["trend"]["percent"] := cPercent
        oJsResult["totalCredits"]["trend"]["positive"]:= lPositive
    EndIf

Return oJsResult:toJson()


/*/{Protheus.doc} GetValuesInvestigationRTCredits
    Funùùo que monta e executa query para obter o total de CrÈditos (CLC_TIPOMO = 'E') da
    Investigation RT em um perùodo genùrico. Considera apenas os tributos da Reforma
    Tributùria IBS (Estadual/Municipal) e CBS Federal, representados pelos cùdigos de
    imposto 000060, 000061 e 000062 na tabela CLC. Parametrizada para ser chamada tanto
    com o perùodo atual quanto com o perùodo anterior.
    @type Function
    @author Yasmim Lira
    @since 28/07/2026
    @version 1.0
    @param cAlias, character, Alias do cursor para manipulacao dos dados retornados
    @param cBranches, character, Codigo das filiais separadas por vùrgula
    @param cPeriodStart, character, Data inicial do perùodo no formato YYYY-MM-DD
    @param cPeriodEnd, character, Data final do perùodo no formato YYYY-MM-DD
    @return Nil, nulo, Dados retornados via alias temporùrio (campo TOTALCREDITO)
    @example
        GetValuesInvestigationRTCredits(@cAlias, "D MG 01,D RJ 02", "2024-01-01", "2024-12-31")
/*/
Function GetValuesInvestigationRTCredits(cAlias as character, cBranches as character, cPeriodStart as character, cPeriodEnd as character, cTipoMo as character)
    Local oQryValues  := FWExecStatement():New()          as object
    Local nBind       := 1                                as numeric
    Local cQuery      := ""                               as character
    Local aCodTributo := {"000060","000061", "000062", "000064", "000065", "000066", "000067", "000068", "000069", "000070"}  as array  // IBS Estadual, IBS Municipal, CBS Federal

    cQuery := "SELECT "
    cQuery +=   "COALESCE(SUM(CLC_VALIMP),0) AS TOTALCREDITO "                              // Total de CrÈditos (Entrada)
    cQuery += "FROM " + FIS319SqlName("CLC") + " CLC "
    cQuery += "WHERE CLC_TIPOMO = ? "                                                      // CrÈdito (Entrada)
    cQuery +=   "AND CLC_FILIAL IN ( ? ) "                                                 // Filiais informadas
    cQuery +=   "AND CLC_ENTRAD BETWEEN ? AND ? "                                          // Perùodo
    cQuery +=   "AND CLC_IMP IN ( ? ) "                                                    // IBS UF/Mun + CBS
    cQuery +=   "AND CLC_VALIMP > ? "                                                      // Maior que 0
    cQuery +=   "AND CLC.D_E_L_E_T_ = ? "                                                  // Registro nùo deletado

    oQryValues:SetQuery(cQuery)

    oQryValues:SetString(nBind++, cTipoMo)                                     // Tipo de Movimento
    oQryValues:SetIn(nBind++, StrTokArr(cBranches, ","))
    oQryValues:SetString(nBind++, StrTran(cPeriodStart, "-", ""))
    oQryValues:SetString(nBind++, StrTran(cPeriodEnd, "-", ""))
    oQryValues:SetIn(nBind++, aCodTributo)
    oQryValues:SetNumeric(nBind++, 0)
    oQryValues:SetString(nBind++, " ")

    oQryValues:cBaseQuery := oQryValues:GetFixQuery()
    cAlias := oQryValues:OpenAlias()

    oQryValues:Destroy()
Return Nil
