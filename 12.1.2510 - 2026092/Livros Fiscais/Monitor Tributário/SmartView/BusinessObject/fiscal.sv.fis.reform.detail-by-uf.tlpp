#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "totvs.framework.treports.integratedprovider.th"
#include "FISA318.CH"

namespace totvs.framework.treports.integratedprovider

/*/{Protheus.doc} ReformDetailByUfBusinessObject
    Objeto de Negócio SmartView para detalhamento por UF da Reforma Tributária.
    Abre em formato Visão de Dados os tributos CBS, IBS, ISS, ICMS, IPI, PIS e COFINS
    consolidados por estado, com drill-down para município.
    Processa dados da API /tax-reform/detail-by-uf e expõe visão hierárquica:
    UF > Município > Tributos (CBS, IBS_UF, IBS_MUN, totalizadores)
    
    @type  Class
    @author Caique Carlos
    @since 17/11/2025
    @version 1.0
    @see https://tdn.totvs.com/pages/releaseview.action?pageId=625448935
/*/
@totvsFrameworkTReportsIntegratedProvider(;
    active=.T.,;
    team="SIGAFIS",;
    name="ReformDetailByUfBusinessObject",;
    country="BRA",;
    initialRelease="12.1.2310";
)
Class ReformDetailByUfBusinessObject From totvs.framework.treports.integratedprovider.IntegratedProvider
    Public Method new()         as object
    Public Method getData()     as object
    Public Method getSchema()   as object
EndClass

/*/{Protheus.doc} new
    Construtor da classe - Define área, nome de exibição e descrição do Objeto de Negócio.
    Utiliza helper FISA318F4GetDisplayNameComplement() para sufixo com timestamp.
    
    @type   Method
    @author Caique Carlos
    @since  17/11/2025
    @version 1.0
    @return object, self (instância da classe)
    @example
    oReformDetail := ReformDetailByUfBusinessObject():new()
*/  
Method new() as object Class ReformDetailByUfBusinessObject
    _Super:new()

    ::appendArea(STR0006) //"Monitor Tributário"
    ::setDisplayName(STR0098 + FISA318F4GetDisplayNameComplement()) //"CARD_REFORMA_TRIBUTARIA_DETALHAMENTO_POR_UF_"
    ::setDescription(STR0099) //"Abertura dos dados do Card de Detalhamento por UF da Reforma Tributária no formato Visão de Dados da Tecnologia SmartView"
Return self

/*/{Protheus.doc} getData
    Retorna dados do objeto de negócio consolidados por UF.
    Consome função ResponseDetailByUfTaxReform() que consulta API REST interna.
    Processa JSON de resposta expandindo hierarquia UF > Município > Tributos.
    Cada linha representa uma UF com totalizadores e array de detalhes por município.
    
    @type   Method
    @author Caique Carlos
    @since  17/11/2025
    @version 1.0
    @param  nPage, numeric, Página atual do relatório (não utilizado - retorna dataset completo)
    @param  oFilter, object, Objeto FWFilter com parâmetros do SmartView (branches, periodStart, periodEnd, movimentType)
    @return object, self:oData (array de hashmaps com dados consolidados por UF)
    @example
    oData := oReformDetail:getData(1, oFilter)
/*/  
Method getData(nPage as numeric, oFilter as object) as object Class ReformDetailByUfBusinessObject
    Local aUfItems                            as array
    Local oSynthetic                          as object
    Local oAnalytical                         as object
    Local oFilterParams                       as object
    Local oFuncResponse := JsonObject():New() as object
    Local oDetailByUf   := JsonObject():new() as object
    Local nIAnalytical  := 0                  as numeric
    Local nISynthetic   := 0                  as numeric

    oFilterParams := oFilter:getParameters()

    oFuncResponse := ResponseDetailByUfTaxReform(;
                        oFilterParams["branches"][1],;
                        oFilterParams["periodStart"][1],;
                        oFilterParams["periodEnd"][1],;
                        oFilterParams["movimentType"][1],;
                        "1",;
                        "999999";
                    );

    If !Empty(oFuncResponse["items"])    
        aUfItems := oFuncResponse["items"]

        For nISynthetic := 1 To Len(aUfItems)
            oSynthetic             := aUfItems[nISynthetic]
            oDetailByUf["uf"]         := oSynthetic["uf"]
            oDetailByUf["cbs"]        := oSynthetic["cbs"]
            oDetailByUf["ibsTotal"]   := oSynthetic["ibsTotal"]
            oDetailByUf["iss"]        := oSynthetic["iss"]
            oDetailByUf["icms"]       := oSynthetic["icms"]
            oDetailByUf["ipi"]        := oSynthetic["ipi"]
            oDetailByUf["pis"]        := oSynthetic["pis"]
            oDetailByUf["cofins"]     := oSynthetic["cofins"]
            oDetailByUf["taxesTotal"] := oSynthetic["taxesTotal"]

            If oSynthetic["detail"] <> Nil
                For nIAnalytical := 1 To Len(oSynthetic["detail"])
                    oAnalytical                   := oSynthetic["detail"][nIAnalytical]
                    oDetailByUf["municipality"]   := oAnalytical["municipality"]
                    oDetailByUf["cbsDetail"]      := oAnalytical["cbs"]
                    oDetailByUf["ibsUfDetail"]    := oAnalytical["ibsUf"]
                    oDetailByUf["ibsMunDetail"]   := oAnalytical["ibsMun"]
                    oDetailByUf["ibsDetailTotal"] := oAnalytical["ibsTotal"]

                ::appendData(oDetailByUf)
                Next nIAnalytical
            Else
                ::appendData(oDetailByUf)
            EndIf

        Next nISynthetic
    EndIf

    FwFreeObj(oSynthetic)
    FwFreeObj(oAnalytical)
    FwFreeObj(oDetailByUf)
    FwFreeObj(oFilterParams)
    FwFreeObj(oFuncResponse)
    FwFreeArray(aUfItems)
Return ::oData

/*/{Protheus.doc} getSchema
    Retorna estrutura dos campos (schema) do Objeto de Negócio.
    Define parâmetros de filtro (branches, periodStart, periodEnd, movimentType)
    e colunas de dados (UF, tributos CBS/IBS/IPI/ISS/ICMS/PIS/COFINS, totalizadores).
    Utiliza helper FISA318F2SVGetParametersByDashboard() para obter parâmetros padrão.

    @type   Method
    @author Caique Carlos
    @since  17/11/2025
    @version 1.0
    @return object, self:oSchema (definição de parâmetros e colunas)
    @example
    oSchema := oReformDetail:getSchema()
/*/  
Method getSchema() as object Class ReformDetailByUfBusinessObject
    Local aSVParams   as array

    aSVParams := FISA318F2SVGetParametersByDashboard("taxreform")

    aEval(aSVParams, {|aParam| ::addParameter(aParam[1], aParam[2], aParam[3], aParam[4])})

    // Colunas do ON - Nível UF (totalizadores)
    ::addProperty("uf"         , STR0025 , "string" , STR0025 , "uf"         ) // UF
    ::addProperty("cbs"        , STR0100 , "number" , STR0100 , "cbs"        ) // CBS
    ::addProperty("ibsTotal"   , STR0101 , "number" , STR0101 , "ibsTotal"   ) // IBS Total
    ::addProperty("iss"        , STR0029 , "number" , STR0029 , "iss"        ) // ISS
    ::addProperty("icms"       , STR0028 , "number" , STR0028 , "icms"       ) // ICMS
    ::addProperty("ipi"        , STR0017 , "number" , STR0017 , "ipi"        ) // IPI
    ::addProperty("pis"        , STR0030 , "number" , STR0030 , "pis"        ) // PIS
    ::addProperty("cofins"     , STR0031 , "number" , STR0031 , "cofins"     ) // COFINS
    ::addProperty("taxesTotal" , STR0102 , "number" , STR0102 , "taxesTotal" ) // Total Tributos
    
    // Colunas do ON - Nível Município (detalhe)
    ::addProperty("municipality"  , STR0050 , "string", STR0050 , "municipality"   ) // Município
    ::addProperty("cbsDetail"     , STR0103 , "number", STR0103 , "cbsDetail"      ) // CBS Detalhado
    ::addProperty("ibsUfDetail"   , STR0104 , "number", STR0104 , "ibsUfDetail"    ) // IBS UF Detalhado
    ::addProperty("ibsMunDetail"  , STR0105 , "number", STR0105 , "ibsMunDetail"   ) // IBS Município Detalhado
    ::addProperty("ibsDetailTotal", STR0106 , "number", STR0106 , "ibsDetailTotal" ) // IBS SubTotal

    FwFreeArray(aSVParams)
Return ::oSchema
