#INCLUDE "tlpp-core.th"
#INCLUDE "tlpp-rest.th"
#INCLUDE "totvs.ch"
#INCLUDE "FISA318.CH"

/*/ {Protheus.doc} TITInvestigationRTDebits
    Endpoint REST para processar a requisiùùo da API de indicadores de dùbitos (CBS + IBS) da
    visùo Investigation RT, para preenchimento do card Total de Dùbitos.
    @type  Function
    @author Evandro Italo
    @since 28/07/2026
    @version 1.0
    @param branches, character, Codigo das filiais separadas por viùrgula (via query parameter)
    @param periodStart, character, Data inicial do periùodo no formato YYYY-MM-DD (via query parameter)
    @param periodEnd, character, Data final do periodo no formato YYYY-MM-DD (via query parameter)
    @return Nil, nulo, Resposta enviada via framework oRest
    @example
        GET /api/fiscal/tax-monitor/v1/investigation-rt/debits?branches=D MG 01 ,D RJ 02 ,D SP 01&periodStart=2024-06-12&periodEnd=2025-06-15
/*/
                    
@Get(endpoint='/api/fiscal/tax-monitor/v1/investigation-rt/debits', description='Obtem os indicadores de debitos da visao Investigation RT para preenchimento do card Total de Debitos.')
Function TITInvestigationRTDebits()
    Local oJsResponse := JsonObject():new()                as json
    Local oQryStr     := oRest:getQueryRequest()           as json
    Local aRequiredProperties                              as array

    aRequiredProperties	:= {;
        {'branches',400,;   //PROPERTY //ERROR_CODE
        STR0069,;           //"O parametro 'branches' eh obrigatorio e n„o foi informado."
        STR0070},;          //"Informar Codigo de Filiais separadas por vi≠rgula."
        {'periodStart',400,;
        STR0071,;           //"Nenhuma Data foi informada no parametro 'periodStart'."
        STR0072},;          //"Informar a data desejada para o peri≠odo"
        {'periodEnd',400,;
        STR0073,;           //"Nenhuma Data foi informada no parametro 'periodEnd'."
        STR0072};           //"Informar a data desejada para o periodo"
    }

    If FISA318F6HasApiRequiredProperties(aRequiredProperties, oQryStr, @oJsResponse) 
        oJsResponse := GetJsonInvestigationRTDebits(;
                                                oQryStr['branches'],;
                                                oQryStr['periodStart'],;
                                                oQryStr['periodEnd'];
                                                )  
    EndIf

    oRest:setKeyHeaderResponse('Content-Type', 'application/json')
    oRest:setResponse(oJsResponse)

    FwFreeArray(aRequiredProperties)
    FWFreeObj(oJsResponse)
    FWFreeObj(oQryStr)

Return

/*/{Protheus.doc} GetJsonInvestigationRTDebits
    Funùùo para obter o total de dùbitos (CBS + IBS) do perùodo atual e do perùodo anterior
    equivalente, calcular a tendùncia percentual entre eles e montar o json de resposta.
    @type  Function
    @author Evandro Italo
    @since 28/07/2026
    @version 1.0
    @param cBranches, character, Codigo das filiais separadas por virgula
    @param cPeriodStart, character, Data inicial do perùodo no formato YYYY-MM-DD
    @param cPeriodEnd, character, Data final do perùodo no formato YYYY-MM-DD
    @return cJsonResponse, character, Dados processados em formato JSON string
    @example
        GetJsonInvestigationRTDebits("D MG 01,D RJ 02", "2024-01-01", "2024-12-31")
/*/
Static Function GetJsonInvestigationRTDebits(cBranches as character, cPeriodStart as character, cPeriodEnd as character) as json
    Local oJsResult         := JsonObject():New() as json
    Local cAliasAtual       := GetNextAlias()     as character
    Local cAliasAnterior    := GetNextAlias()     as character
    Local cPeriodStartAnt   := ""                 as character
    Local cPeriodEndAnt     := ""                 as character
    Local nDebitsAtual      := 0                  as numeric
    Local nDebitsAnterior   := 0                  as numeric
    Local nPercent          := 0                  as numeric
    Local lPositive         := .F.                as logical
    Local cPercent          := ""                 as character

    TITGetPreviousPeriod(cPeriodStart, cPeriodEnd, @cPeriodStartAnt, @cPeriodEndAnt)

    GetValuesInvestigationRTDebits(@cAliasAtual, cBranches, cPeriodStart, cPeriodEnd)
    nDebitsAtual := (cAliasAtual)->TOTALDEBITO
    (cAliasAtual)->(DbCloseArea())

    GetValuesInvestigationRTDebits(@cAliasAnterior, cBranches, cPeriodStartAnt, cPeriodEndAnt)
    nDebitsAnterior := (cAliasAnterior)->TOTALDEBITO
    (cAliasAnterior)->(DbCloseArea())

    If nDebitsAtual == 0
        oJsResult["indicators"] := JsonObject():New()   // Sem debitos no periodo/filiais informados
    Else
        If nDebitsAnterior == 0
            // Sem base de comparacao no periodo anterior (nao existe percentual matematicamente
            // valido para "saiu de zero"). Como nDebitsAtual > 0 neste ponto, sinaliza aumento
            // em termos absolutos, mas sem expressa-lo como percentual.
            cPercent  := "0%"
            lPositive := .T.
        Else
            nPercent  := ((nDebitsAtual - nDebitsAnterior) / nDebitsAnterior) * 100
            cPercent  := AllTrim(Transform(nPercent, "@E 999999.99")) + "%"
            lPositive := (nDebitsAtual > nDebitsAnterior)
        EndIf

        oJsResult["totalDebits"]                      := JsonObject():New()
        oJsResult["totalDebits"]["value"]             := nDebitsAtual
        oJsResult["totalDebits"]["trend"]             := JsonObject():New()
        oJsResult["totalDebits"]["trend"]["percent"]  := cPercent
        oJsResult["totalDebits"]["trend"]["positive"] := lPositive
    EndIf

Return oJsResult:toJson()

/*/{Protheus.doc} GetValuesInvestigationRTDebits
    Funùùo que monta e executa query para obter o total de dùbitos (CLC_TIPOMO = 'S') da
    Investigation RT em um perùodo genùrico. Considera apenas os tributos da Reforma
    Tributùria IBS (Estadual/Municipal) e CBS Federal, representados pelos cùdigos de
    imposto 000060, 000061 e 000062 na tabela CLC. Parametrizada para ser chamada tanto
    com o perùodo atual quanto com o perùodo anterior.
    @type  Static Function
    @author Evandro Italo
    @since 28/07/2026
    @version 1.0
    @param cAlias, character, Alias do cursor para manipulacao dos dados retornados
    @param cBranches, character, Codigo das filiais separadas por vùrgula
    @param cPeriodStart, character, Data inicial do perùodo no formato YYYY-MM-DD
    @param cPeriodEnd, character, Data final do perùodo no formato YYYY-MM-DD
    @return Nil, nulo, Dados retornados via alias temporùrio (campo TOTALDEBITO)
    @example
        GetValuesInvestigationRTDebits(@cAlias, "D MG 01,D RJ 02", "2024-01-01", "2024-12-31")
/*/
Static Function GetValuesInvestigationRTDebits(cAlias as character, cBranches as character, cPeriodStart as character, cPeriodEnd as character)
    Local oQryValues  := FWExecStatement():New()          as object
    Local nBind       := 1                                as numeric
    Local cQuery      := ""                               as character
    Local aCodTributo := {"000060","000061", "000062", "000064", "000065", "000066", "000067", "000068", "000069", "000070"}     as array  // IBS Estadual, IBS Municipal, CBS Federal

    cQuery := "SELECT "
    cQuery +=   "COALESCE(SUM(CLC_VALIMP),0) AS TOTALDEBITO "                              // Total de Dùbitos (Saùda)
    cQuery += "FROM " + FIS319SqlName("CLC") + " CLC "
    cQuery += "WHERE CLC_TIPOMO = ? "                                                      // Dùbito (Saùda)
    cQuery +=   "AND CLC_FILIAL IN ( ? ) "                                                 // Filiais informadas
    cQuery +=   "AND CLC_ENTRAD BETWEEN ? AND ? "                                          // Perùodo
    cQuery +=   "AND CLC_IMP IN ( ? ) "                                                    // IBS UF/Mun + CBS
    cQuery +=   "AND CLC_VALIMP > ? "                                                      // Maior que 0
    cQuery +=   "AND CLC.D_E_L_E_T_ = ? "                                                  // Registro nùo deletado

    oQryValues:SetQuery(cQuery)

    oQryValues:SetString(nBind++, "S")                                     // Dùbito
    oQryValues:SetIn(nBind++, StrTokArr(cBranches, ","))
    oQryValues:SetString(nBind++, StrTran(cPeriodStart, "-", ""))
    oQryValues:SetString(nBind++, StrTran(cPeriodEnd, "-", ""))
    oQryValues:SetIn(nBind++, aCodTributo)
    oQryValues:SetNumeric(nBind++, 0)
    oQryValues:SetString(nBind++, " ")

    oQryValues:cBaseQuery := oQryValues:GetFixQuery()
    cAlias := oQryValues:OpenAlias()

    FwFreeArray(aCodTributo)
    FWFreeObj(oQryValues)
Return Nil

/*/{Protheus.doc} TITGetPreviousPeriod
    Calcula o perùodo anterior equivalente (em dias) a um perùodo informado, para fins de
    comparaùùo de tendùncia. A duraùùo (em dias, inclusive) do perùodo informado ù replicada
    imediatamente antes da data inicial informada.
    @type  Static Function
    @author Evandro Italo
    @since 28/07/2026
    @version 1.0
    @param cPeriodStart, character, Data inicial do perùodo atual no formato YYYY-MM-DD
    @param cPeriodEnd, character, Data final do perùodo atual no formato YYYY-MM-DD
    @param cPeriodStartAnt, character, (Referùncia) Data inicial do perùodo anterior no formato YYYY-MM-DD
    @param cPeriodEndAnt, character, (Referùncia) Data final do perùodo anterior no formato YYYY-MM-DD
    @return Nil, nulo, Datas retornadas via parùmetros por referùncia
    @example
        // periodStart=01/05/2026, periodEnd=30/06/2026 (61 dias) => perùodo anterior = 01/03/2026 a 30/04/2026
        TITGetPreviousPeriod("2026-05-01", "2026-06-30", @cPeriodStartAnt, @cPeriodEndAnt)
/*/
Static Function TITGetPreviousPeriod(cPeriodStart as character, cPeriodEnd as character, cPeriodStartAnt as character, cPeriodEndAnt as character)
    // Datas mantidas sem tipagem estùtica ("as date") propositalmente: o compilador TLPP infere
    // o resultado de "date - date" como "date" (e nùo "numeric"), causando erro de tipos
    // incompatùveis entre N e D na atribuiùùo de nDuration. Comportamento dinùmico (AdvPL) evita o falso positivo.
    Local dPeriodStart      := StoD(StrTran(cPeriodStart, "-", ""))
    Local dPeriodEnd        := StoD(StrTran(cPeriodEnd, "-", ""))
    Local dPeriodStartAnt
    Local dPeriodEndAnt
    Local nDuration         := 0                                   as numeric

    nDuration       := dPeriodEnd - dPeriodStart + 1   // Duraùùo do perùodo informado, em dias (inclusive)
    dPeriodEndAnt   := dPeriodStart - 1
    dPeriodStartAnt := dPeriodStart - nDuration

    cPeriodStartAnt := TITDateToApiFormat(dPeriodStartAnt)
    cPeriodEndAnt   := TITDateToApiFormat(dPeriodEndAnt)
Return Nil

/*/{Protheus.doc} TITDateToApiFormat
    Converte uma data para o formato de caracter YYYY-MM-DD utilizado pelos parùmetros de
    perùodo das APIs do Monitor Tributùrio.
    @type  Static Function
    @author Evandro Italo
    @since 28/07/2026
    @version 1.0
    @param dDate, date, Data a ser convertida
    @return cDate, character, Data convertida no formato YYYY-MM-DD
    @example
        TITDateToApiFormat(StoD("20260301")) // Retorna "2026-03-01"
/*/
Static Function TITDateToApiFormat(dDate as date) as character
    Local cAaaaMmDd := DtoS(dDate) as character
Return SubStr(cAaaaMmDd, 1, 4) + "-" + SubStr(cAaaaMmDd, 5, 2) + "-" + SubStr(cAaaaMmDd, 7, 2)
