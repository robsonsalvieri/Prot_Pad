#INCLUDE "tlpp-core.th"
#INCLUDE "tlpp-rest.th"
#INCLUDE "totvs.ch"
#INCLUDE "FISA318.CH"

/*/{Protheus.doc} TITFinancialTotalTaxValues
    Endpoint REST para processar a requisição da API de Valores do Total de Impostos.
    @type  Function
    @author Caique Carlos
    @since 08/01/2026
    @version 1.0
    @param branches, character, Código das filiais separadas por vírgula (via query parameter)
    @param periodStart, character, Data inicial do período no formato YYYY-MM-DD (via query parameter)
    @param periodEnd, character, Data final do período no formato YYYY-MM-DD (via query parameter)
    @return Nil, nulo, Resposta enviada via framework oRest
    @example
        GET /api/fiscal/tax-monitor/v1/financial/tax-total?branches=D MG 01,D RJ 02&periodStart=2024-01-01&periodEnd=2024-12-31
/*/
@get(endpoint='/api/fiscal/tax-monitor/v1/financial/tax-total', description='API de Valores do Total de Impostos')
Function TITFinancialTotalTaxValues()
    Local oJsResponse := JsonObject():new()      as json
    Local oQryStr     := oRest:getQueryRequest() as json
    Local aRequiredProperties                    as array

    aRequiredProperties	:= {;
        {'branches',400,;   //PROPERTY //ERROR_CODE
        STR0069,;           //"O parâmetro 'branches' é obrigatório e não foi informado."
        STR0070},;          //"Informar Código de Filiais separadas por vírgula."
        {'periodStart',400,;
        STR0071,;           //"Nenhuma Data foi informada no parâmetro 'periodStart'."
        STR0072},;          //"Informar a data desejada para o período"
        {'periodEnd',400,;
        STR0073,;           //"Nenhuma Data foi informada no parâmetro 'periodEnd'."
        STR0072};           //"Informar a data desejada para o período"
    }

    If FISA318F6HasApiRequiredProperties(aRequiredProperties, oQryStr, @oJsResponse) 
        oJsResponse := GetJsonFinancialTotalTaxValues(oQryStr['branches'], oQryStr['periodStart'], oQryStr['periodEnd'])   
    EndIf  

    oRest:setKeyHeaderResponse('Content-Type', 'application/json')
    oRest:setResponse(oJsResponse)

    FwFreeArray(aRequiredProperties) 
    FWFreeObj(oJsResponse)
    FWFreeObj(oQryStr)
Return 

/*/{Protheus.doc} GetJsonFinancialTotalTaxValues
    Função para obter os dados de Valores do Total de Impostos e montar json de resposta.
    @type  Static Function
    @author Caique Carlos
    @since 08/01/2026
    @version 1.0
    @param cBranches, character, Código das filiais separadas por vírgula
    @param cPeriodStart, character, Data inicial do período no formato YYYY-MM-DD
    @param cPeriodEnd, character, Data final do período no formato YYYY-MM-DD
    @return cJsonResponse, character, Dados processados em formato JSON string
    @example
        Local cJson := GetJsonFinancialTotalTaxValues("D MG 01,D RJ 02", "2024-01-01", "2024-12-31")
/*/
Static Function GetJsonFinancialTotalTaxValues(cBranches as character, cPeriodStart as character, cPeriodEnd as character) as json
    Local oJsResult := JsonObject():New() as json
    Local cAlias    := GetNextAlias()     as character

    GetTaxesTotalValues(@cAlias, cBranches, cPeriodStart, cPeriodEnd)

    If (cAlias)->(!EoF())
        oJsResult["withholdingsPaid"]      := (cAlias)->VAL_PAGO
        oJsResult["outstandingRetentions"] := (cAlias)->VALOR_PAGAR
    EndIf

    (cAlias)->(DbCloseArea())

Return oJsResult:toJson()

/*/{Protheus.doc} GetTaxesTotalValues
    Função que monta e executa query para obter o resultado Valores do Total de Impostos.
    @type  Static Function
    @author Caique Carlos
    @since 08/01/2026
    @version 1.0
    @param cAlias, character, Alias do cursor para manipulação dos dados retornados
    @param cBranches, character, Código das filiais separadas por vírgula
    @param cPeriodStart, character, Data inicial do período no formato YYYY-MM-DD
    @param cPeriodEnd, character, Data final do período no formato YYYY-MM-DD
    @return Nil, nulo, Dados retornados via alias temporário
    @example
        GetTaxesTotalValues(@cAlias, "D MG 01,D RJ 02", "2024-01-01", "2024-12-31")
/*/
Static Function GetTaxesTotalValues(cAlias as character, cBranches as character, cPeriodStart as character, cPeriodEnd as character)
    Local oQryValues  := FWExecStatement():New()    as object
    Local nBind       := 1                          as numeric
    Local cQuery      := ""                         as character

    cQuery := "SELECT "
    cQuery +=   "SUM(CASE WHEN CIW.CIW_SALDO > 0 THEN CIW.CIW_SALDO ELSE 0 END) VALOR_PAGAR, "
    cQuery +=   "SUM(CIW.CIW_VALOR) - SUM(CIW.CIW_SALDO) VAL_PAGO "
    cQuery += "FROM ? CIW "
    cQuery += "WHERE CIW.CIW_FILIAL IN ( ? ) "
    cQuery +=   "AND CIW.CIW_EMISSA BETWEEN ? AND ? "
    cQuery +=   "AND CIW.CIW_VALOR > ? "
    cQuery +=   "AND CIW.D_E_L_E_T_ = ? "

    oQryValues:SetQuery(ChangeQuery(cQuery))

    oQryValues:SetUnsafe(nBind++, FIS319SqlName("CIW"))
    oQryValues:SetIn(nBind++, StrTokArr(cBranches, "," ))
    oQryValues:SetString(nBind++, StrTran(cPeriodStart, "-", ""))
    oQryValues:SetString(nBind++, StrTran(cPeriodEnd, "-", ""))
    oQryValues:SetNumeric(nBind++, 0)
    oQryValues:SetString(nBind++, " ")

    oQryValues:cBaseQuery := oQryValues:GetFixQuery()
    cAlias := oQryValues:OpenAlias()

    FwFreeObj(oQryValues)
Return
