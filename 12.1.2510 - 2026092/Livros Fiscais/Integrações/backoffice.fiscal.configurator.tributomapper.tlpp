#INCLUDE "TOTVS.CH"
#INCLUDE "TLPP-CORE.TH"

//-------------------------------------------------------------------
/*/{Protheus.doc} TributoMapper
Classe Singleton responsavel por mapear tributos entre:
- ID CFGTRIB (ex: "000021")
- Sigla MaFisSomaIt (ex: "ICM")
- Nome Proprio (ex: "ICMS")

Aplica SRP (Single Responsibility Principle) separando logica de
mapeamento de tributos da construcao de JSON.

@type class
@author Rafael Oliveira
@since 02/12/2025
@version 12.1.2510
@see FISA168.PRW - Cadastro de Tributos (funcao FSA168F2E)
@see matxfis.prx - Funcao MaFisSomaIt()
@example
    oMapper := TributoMapper():New()
    cSigla := oMapper:GetSiglaNativa("000021")  // Retorna "ICM"
    cNome := oMapper:GetNomeProprio("000021")   // Retorna "ICMS"
    FreeObj(oMapper)
/*/
//-------------------------------------------------------------------

namespace totvs.protheus.backoffice.fiscal.configurator.tributomapper

Class TributoMapper
    
    // Membros de Dados Privados
    Private Data jIdToSigla   as json    // Hash ID ? Sigla MaFisSomaIt (ex: "000021" ? "ICM")
    Private Data jIdToNome    as json    // Hash ID ? Nome Proprio (ex: "000021" ? "ICMS")
    Private Data lInitialized as logical // Flag de inicializacao do mapeamento
    
    // Metodos Publicos
    Public Method New() Constructor
    Public Method Destroy()
    Public Method GetSiglaNativa(cIdTrib) as character
    Public Method GetNomeProprio(cIdTrib) as character
    Public Method HasNativeMapping(cIdTrib) as logical
    
    // Metodos Privados
    Private Method InitializeMappings()
    Private Method BuildSiglaMap() as json
    Private Method BuildNomeMap() as json

EndClass

//-------------------------------------------------------------------
/*/{Protheus.doc} TributoMapper:New
Construtor da classe TributoMapper.
Inicializa hashes de mapeamento com lazy loading.

@type method
@author Rafael Oliveira
@since 02/12/2025
@version 12.1.2510
@return object, Instancia do TributoMapper
/*/
//-------------------------------------------------------------------
Method New() Class TributoMapper
    
    self:jIdToSigla   := Nil
    self:jIdToNome    := Nil
    self:lInitialized := .F.
    
    // Lazy initialization - constrùi hashes sob demanda
    self:InitializeMappings()
    
Return Self

//-------------------------------------------------------------------
/*/{Protheus.doc} TributoMapper:Destroy
Destrutor da classe TributoMapper.
Libera recursos de memoria dos hashes JSON.

@type method
@author Rafael Oliveira
@since 02/12/2025
@version 12.1.2510
/*/
//-------------------------------------------------------------------
Method Destroy() Class TributoMapper
    
    If self:jIdToSigla != Nil
        FreeObj(self:jIdToSigla)
        self:jIdToSigla := Nil
    EndIf
    
    If self:jIdToNome != Nil
        FreeObj(self:jIdToNome)
        self:jIdToNome := Nil
    EndIf
    
    self:lInitialized := .F.
    
Return

//-------------------------------------------------------------------
/*/{Protheus.doc} TributoMapper:GetSiglaNativa
Obtem sigla nativa de MaFisSomaIt para um ID CFGTRIB.
Aplica fallback para nome proprio se nao houver sigla mapeada.

@type method
@author Rafael Oliveira
@since 02/12/2025
@version 12.1.2510
@param cIdTrib, character, ID do tributo CFGTRIB (ex: "000021")
@return character, Sigla nativa (ex: "ICM") ou nome proprio (ex: "IBSEST")
@example
    cSigla := oMapper:GetSiglaNativa("000021")  // Retorna "ICM"
    cSigla := oMapper:GetSiglaNativa("000060")  // Retorna "IBSEST" (sem sigla nativa)
/*/
//-------------------------------------------------------------------
Method GetSiglaNativa(cIdTrib) Class TributoMapper
    
    Local cSigla as character
    
    Default cIdTrib := ""
    
    cSigla := ""
    
    // Valida entrada
    If Empty(cIdTrib) .Or. !self:lInitialized
        Return cSigla
    EndIf
    
    // Busca sigla nativa (O(1) hash lookup)
    If self:jIdToSigla:HasProperty(cIdTrib)
        cSigla := self:jIdToSigla[cIdTrib]
    EndIf
    
    // Fallback: se nao tem sigla nativa, usa nome proprio
    If Empty(cSigla)
        cSigla := self:GetNomeProprio(cIdTrib)
    EndIf
    
Return cSigla

//-------------------------------------------------------------------
/*/{Protheus.doc} TributoMapper:GetNomeProprio
Obtem nome proprio do tributo para um ID CFGTRIB.

@type method
@author Rafael Oliveira
@since 02/12/2025
@version 12.1.2510
@param cIdTrib, character, ID do tributo CFGTRIB (ex: "000021")
@return character, Nome proprio do tributo (ex: "ICMS")
@example
    cNome := oMapper:GetNomeProprio("000021")  // Retorna "ICMS"
    cNome := oMapper:GetNomeProprio("000060")  // Retorna "IBSEST"
/*/
//-------------------------------------------------------------------
Method GetNomeProprio(cIdTrib) Class TributoMapper
    
    Local cNome as character
    
    Default cIdTrib := ""
    
    cNome := ""
    
    // Valida entrada
    If Empty(cIdTrib) .Or. !self:lInitialized
        Return cNome
    EndIf
    
    // Busca nome prùprio (O(1) hash lookup)
    If self:jIdToNome:HasProperty(cIdTrib)
        cNome := self:jIdToNome[cIdTrib]
    EndIf
    
Return cNome

//-------------------------------------------------------------------
/*/{Protheus.doc} TributoMapper:HasNativeMapping
Verifica se ID tributo possui mapeamento para sigla MaFisSomaIt.

@type method
@author Rafael Oliveira
@since 02/12/2025
@version 12.1.2510
@param cIdTrib, character, ID do tributo CFGTRIB
@return logical, .T. se possui sigla nativa, .F. se usa nome proprio
@example
    lTemSigla := oMapper:HasNativeMapping("000021")  // .T. (tem "ICM")
    lTemSigla := oMapper:HasNativeMapping("000060")  // .F. (so tem "IBSEST")
/*/
//-------------------------------------------------------------------
Method HasNativeMapping(cIdTrib) Class TributoMapper
    
    Local lHasMapping as logical
    
    Default cIdTrib := ""
    
    lHasMapping := .F.
    
    If !Empty(cIdTrib) .And. self:lInitialized
        If self:jIdToSigla:HasProperty(cIdTrib)
            lHasMapping := !Empty(self:jIdToSigla[cIdTrib])
        EndIf
    EndIf
    
Return lHasMapping

//-------------------------------------------------------------------
/*/{Protheus.doc} TributoMapper:InitializeMappings
Inicializa hashes de mapeamento ID?Sigla e ID?Nome.
Chamado uma unica vez no construtor (lazy loading).

@type method
@author Rafael Oliveira
@since 02/12/2025
@version 12.1.2510
@private
/*/
//-------------------------------------------------------------------
Method InitializeMappings() Class TributoMapper
    
    If !self:lInitialized
        self:jIdToSigla := self:BuildSiglaMap()
        self:jIdToNome  := self:BuildNomeMap()
        self:lInitialized := .T.
    EndIf
    
Return

//-------------------------------------------------------------------
/*/{Protheus.doc} TributoMapper:BuildSiglaMap
Constroi hash de mapeamento ID CFGTRIB ? Sigla MaFisSomaIt.
Apenas IDs com correspondencia nativa sao incluidos (51 de 76).

@type method
@author Rafael Oliveira
@since 02/12/2025
@version 12.1.2510
@return json, Hash JSON com mapeamento ID?Sigla
@private
@obs Fonte: matxfis.prx - Funcao MaFisSomaIt() linhas 1-332
@see https://tdn.totvs.com/display/public/PROT/MaFisResumo

TABELA DE REFERENCIA CRUZADA (Validado com MaFisSomaIt.prw):
TRIB_ID | Sigla | IT_* Fields        | Linha MaFisSomaIt.prw | Contexto
--------|-------|--------------------|-----------------------|------------------
000015  | PS2   | IT_BASEPS2/VALPS2  | 115                   | PIS Via Apuracao
000016  | CF2   | IT_BASECF2/VALCF2  | 126                   | COFINS Via Apuracao
000018  | IRR   | IT_BASEIRR/VALIRR  | 87                    | IR Retido na Fonte
000019  | INS   | IT_BASEINS/VALINS  | 91                    | INSS Retencao
000028  | FMP   | IT_BASEFMP/VALFMP  | 52                    | FUMIPEQ
000043  | COF   | IT_BASECOF/VALCOF  | 98                    | COFINS Via Retencao
000045  | PIS   | IT_BASEPIS/VALPIS  | 95                    | PIS Via Retencao
000051  | ICA   | IT_BASEICA/VALICA  | 58                    | ICMS Frete Autonomo
/*/
//-------------------------------------------------------------------
Method BuildSiglaMap() Class TributoMapper
    
    Local jMap as json
    
    jMap := JsonObject():New()
    
    // Mapeamento ID CFGTRIB ? Sigla MaFisSomaIt (51 tributos com sigla nativa)
    // Formato: jMap[ID_CFGTRIB] := SIGLA_MAFISSOMAIT
    
    // Contribuicoes Rurais
    jMap["000001"] := "FRU"      // FUNRURAL (alternativa de 000002)
    jMap["000002"] := "FRU"      // GILRAT (principal)
    jMap["000003"] := "SENAR"    // SENAR
    
    // Fundos Estaduais/Municipais
    jMap["000004"] := "AFRMM"    // AFRMM
    jMap["000005"] := "FAB"      // FABOV
    jMap["000006"] := "FAC"      // FACS
    jMap["000007"] := "FMD"      // FAMAD
    jMap["000008"] := "FAS"      // FASE-MT
    jMap["000009"] := "FET"      // FETHAB
    jMap["000010"] := "FDS"      // FUNDERSUL
    jMap["000011"] := "FUN"      // FUNDESA
    jMap["000012"] := "IMA"      // IMA-MT
    jMap["000013"] := "SES"      // SEST/SENAT
    jMap["000014"] := "TPD"      // TPDP-PB
    
    // PIS/COFINS Base (Via Apuracao/Importacao)
    jMap["000015"] := "PS2"      // PIS base (Via Apuracao OU Importacao)
    jMap["000016"] := "CF2"      // COFINS base (Via Apuracao OU Importacao)
    
    // IR e INSS (Via Retencao)
    jMap["000018"] := "IRR"      // IR Retido na Fonte
    jMap["000019"] := "INS"      // INSS Retencao
    
    // Tributos Principais (ICMS, IPI, ISS)
    jMap["000020"] := "ISS"      // ISS
    jMap["000021"] := "ICM"      // ICMS (principal)
    jMap["000022"] := "IPI"      // IPI
    
    // Contribuicoes Federais
    jMap["000023"] := "CID"      // CIDE
    jMap["000024"] := "CPB"      // CPRB
    jMap["000025"] := "FEEF"     // FEEF
    jMap["000026"] := "CSL"      // CSLL
    jMap["000027"] := "PTG"      // PROTEGE-GO
    jMap["000028"] := "FMP"      // FUMIPEQ
    
    // INSS
    jMap["000036"] := "INP"      // INSS Patronal
    
    // ICMS Variantes (DIFAL, ST, Complementar)
    jMap["000037"] := "DIF"      // DIFAL
    jMap["000038"] := "ICC"      // ICMS Complementar
    
    // FECP (Fundo Combate Pobreza)
    jMap["000040"] := "FCP"      // FECP ICMS
    jMap["000041"] := "FST"      // FECP ST
    jMap["000042"] := "FCM"      // FECP Complementar
    
    // PIS/COFINS Retencao e ST
    jMap["000043"] := "COF"      // COFINS Retencao
    jMap["000044"] := "CF3"      // COFINS ST
    jMap["000045"] := "PIS"      // PIS Retencao
    jMap["000046"] := "PS3"      // PIS ST
    
    // ISS Bi-Tributado
    jMap["000047"] := "CPM"      // ISS Bi-Tributado
    
    // Frete Autonomo
    jMap["000051"] := "ICA"      // ICMS Frete Autonomo
    
    // Desoneracoes ZFM (Zona Franca de Manaus)
    jMap["000052"] := "ZFI"      // ICMS Desonerado ZFM
    jMap["000053"] := "ZFP"      // PIS Desonerado ZFM
    jMap["000054"] := "ZFC"      // COFINS Desonerado ZFM
    
    // ICMS ST
    jMap["000056"] := "ICR"      // ICMS ST (Retencao)
    jMap["000057"] := "TST"      // ICMS ST Frete Embarcador
    
    // TOTAL: 51 mapeamentos com sigla nativa MaFisSomaIt
    // NOTA: TRIB_ID_PISMAJ (000048) e TRIB_ID_COFMAJ (000049) NAO possuem sigla MaFisSomaIt propria.
    //       Majoracao e exibida como PARTE do PS2/CF2 com descricao condicional baseada em TS_ALQPMAJ/TS_ALQCMAJ.
    
Return jMap

//-------------------------------------------------------------------
/*/{Protheus.doc} TributoMapper:BuildNomeMap
Constroi hash de mapeamento ID CFGTRIB ? Nome Proprio.
Inclui TODOS os 76 IDs (nativos + orfaos sem sigla MaFisSomaIt).

@type method
@author Rafael Oliveira
@since 02/12/2025
@version 12.1.2510
@return json, Hash JSON com mapeamento ID?Nome
@private
@obs Fonte: FISA168.PRW - Funcao FSA168F2E() - Array aTrib
@see https://tdn.totvs.com/pages/releaseview.action?pageId=604015213
/*/
//-------------------------------------------------------------------
Method BuildNomeMap() Class TributoMapper
    
    Local jMap as json
    
    jMap := JsonObject():New()
    
    // Mapeamento COMPLETO: ID CFGTRIB ? Nome Proprio (76 tributos)
    // Formato: jMap[ID_CFGTRIB] := NOME_PROPRIO_TRIBUTO
    
    // IDs 000001-000014: Contribuicoes Rurais e Fundos
    jMap["000001"] := "FUNRUR"
    jMap["000002"] := "FUNRUR"
    jMap["000003"] := "SENAR"
    jMap["000004"] := "AFRMM"
    jMap["000005"] := "FABOV"
    jMap["000006"] := "FACS"
    jMap["000007"] := "FAMAD"
    jMap["000008"] := "FASEMT"
    jMap["000009"] := "FETHAB"
    jMap["000010"] := "FUNDER"
    jMap["000011"] := "FUNDES"
    jMap["000012"] := "IMAMT"
    jMap["000013"] := "SEST"
    jMap["000014"] := "TPDP"
    
    // IDs 000015-000028: Tributos Principais
    jMap["000015"] := "PIS"
    jMap["000016"] := "COF"
    jMap["000017"] := "II"
    jMap["000018"] := "IRF"
    jMap["000019"] := "INSS"
    jMap["000020"] := "ISS"
    jMap["000021"] := "ICMS"
    jMap["000022"] := "IPI"
    jMap["000023"] := "CIDE"
    jMap["000024"] := "CPRB"
    jMap["000025"] := "FEEF"
    jMap["000026"] := "CSL"
    jMap["000027"] := "PROTEG"
    jMap["000028"] := "FUMIPQ"
    
    // IDs 000029-000035: Creditos Presumidos (sem sigla MaFisSomaIt)
    jMap["000029"] := "CRDPRE"
    jMap["000030"] := "CRPRST"
    jMap["000031"] := "CPPROD"
    jMap["000032"] := "CRDPCT"
    jMap["000033"] := "SECP15"
    jMap["000034"] := "SECP20"
    jMap["000035"] := "SECP25"
    
    // IDs 000036-000058: INSS, ICMS Variantes, FECP, PIS/COFINS
    jMap["000036"] := "INSSPT"
    jMap["000037"] := "DIFAL"
    jMap["000038"] := "CMP"
    jMap["000039"] := "ANTEC"
    jMap["000040"] := "FECPIC"
    jMap["000041"] := "FCPST"
    jMap["000042"] := "FCPCMP"
    jMap["000043"] := "COFRET"
    jMap["000044"] := "COFST"
    jMap["000045"] := "PISRET"
    jMap["000046"] := "PISST"
    jMap["000047"] := "ISSBI"
    jMap["000048"] := "PISMAJ"
    jMap["000049"] := "COFMAJ"
    jMap["000050"] := "DED"
    jMap["000051"] := "FRTAUT"
    jMap["000052"] := "ICMDES"
    jMap["000053"] := "DZFPIS"
    jMap["000054"] := "DZFCOF"
    jMap["000055"] := "ESTICM"
    jMap["000056"] := "ICMSST"
    jMap["000057"] := "FRTEMB"
    jMap["000058"] := "CRDOUT"
    
    // IDs 000059-000076: Tributos CFGTRIB exclusivos (Reforma Tributùria 2026+)
    jMap["000059"] := "STMONO"
    jMap["000060"] := "IBSEST"   // *** SEM SIGLA MAFISSOMAIT ***
    jMap["000061"] := "IBSMUN"   // *** SEM SIGLA MAFISSOMAIT ***
    jMap["000062"] := "CBSFED"   // *** SEM SIGLA MAFISSOMAIT ***
    jMap["000063"] := "ISFED"    // *** SEM SIGLA MAFISSOMAIT ***
    jMap["000064"] := "IBSERG"   // *** SEM SIGLA MAFISSOMAIT ***
    jMap["000065"] := "IBSMRG"   // *** SEM SIGLA MAFISSOMAIT ***
    jMap["000066"] := "CBSREG"   // *** SEM SIGLA MAFISSOMAIT ***
    jMap["000067"] := "IBSCRP"   // *** SEM SIGLA MAFISSOMAIT ***
    jMap["000068"] := "CBSCRP"   // *** SEM SIGLA MAFISSOMAIT ***
    jMap["000069"] := "IBSMON"   // *** SEM SIGLA MAFISSOMAIT ***
    jMap["000070"] := "CBSMON"   // *** SEM SIGLA MAFISSOMAIT ***
    jMap["000071"] := "FUST"     // *** SEM SIGLA MAFISSOMAIT ***
    jMap["000072"] := "FUNTTEL"  // *** SEM SIGLA MAFISSOMAIT ***
    jMap["000073"] := "IBSRET"   // *** SEM SIGLA MAFISSOMAIT ***
    jMap["000074"] := "CBSRET"   // *** SEM SIGLA MAFISSOMAIT ***
    jMap["000075"] := "IBSANT"   // *** SEM SIGLA MAFISSOMAIT ***
    jMap["000076"] := "CBSANT"   // *** SEM SIGLA MAFISSOMAIT ***
    
    // TOTAL: 76 mapeamentos completos
    
Return jMap
