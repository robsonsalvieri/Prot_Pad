#Include "tlpp-core.th"
#Include "TOTVS.CH"
#include "totvs.protheus.manufacturing.dtacontexts.resultadomrp.ch"

namespace totvs.protheus.manufacturing.dtacontexts

#DEFINE BREAK_LINE "\n"

/*/{Protheus.doc} ResultadoMRP
Define as configurações e os recursos do contexto de assistente do Resultado MRP.
@type class
@author lucas.franca
@since 13/04/2026
@version P12
/*/
Class ResultadoMRP
	Static Method getDeveloperPrompt() as Array
	Static Method getAdditionalTools() as Array
	Static Method getWelcomeSuggestions() as Array
	Static Method getContextParameters() as Json
EndClass

/*/{Protheus.doc} getDeveloperPrompt
Retorna definições específicas do contexto "ResultadoMRP" que serão enviadas no prompt de developer.
@author lucas.franca
@since 13/04/2026
@version P12
@return aPrompts, Array, Array de strings com as definições do contexto ResultadoMRP.
/*/
Method getDeveloperPrompt() as Array Class ResultadoMRP
	Local aPrompts   := {} as Array
	Local cDeveloper       as Character

	cDeveloper += "### " + STR0001 + " (Tool: set_mrp_events_selection)" + BREAK_LINE //"Protocolo de Confirmação"
	cDeveloper += "### " + STR0002 + BREAK_LINE //"Diretriz de Seleção MRP"
	cDeveloper += STR0003 + ":" + BREAK_LINE //"Ao receber um pedido de marcação/desmarcação, você deve seguir este fluxo obrigatoriamente"
	cDeveloper += "1. " + STR0004 + BREAK_LINE //"Identificar a ação: marcar/adicionar/incluir = adicionar; desmarcar/remover/retirar = remover."
	cDeveloper += STR0005 + BREAK_LINE //"Na ausência de verbo explícito, usar adicionar (padrão)."
	cDeveloper += "1.1 " + STR0006 + BREAK_LINE //"Regra de precedência: se houver verbo explícito de desmarcar/remover/retirar, a ação é SEMPRE remover."
	cDeveloper += "2. " + STR0007 + ". **" + STR0008 + "**: " + STR0009 + BREAK_LINE //"Extrair os dados" //"REGRA ESTRITA" //"É PROIBIDO fazer perguntas ao usuário sobre parâmetros não informados. Se o usuário não citou datas, produtos, ações ou armazéns, assuma IMEDIATAMENTE os valores padrão ('Não especificado', 'Todos', 'Nenhum') e vá direto para o passo 3."
	cDeveloper += "2.1 " + STR0010 + ": " + STR0011 + BREAK_LINE //"Pedidos múltiplos" //"se o usuário fez dois ou mais pedidos em uma única frase (ex: 'marque X e desmarque Y'), gere UMA ÚNICA confirmação consolidada para todos os pedidos, listando cada ação na ordem em que foi solicitada. Informe ao usuário que as ações serão executadas nessa mesma ordem após a confirmação."
	cDeveloper += "3. " + STR0012 + BREAK_LINE //"Gerar a resposta preenchendo o formulário de confirmação."
	cDeveloper += "3.1 " + STR0013 + ": " + STR0014 + BREAK_LINE //"Regra de confirmação (intenção semântica)" //"quando o usuário deixar explícito o escopo temporal da ação, não listar opções 1/2/3; apenas informar a opção definida e pedir confirmação final."
	cDeveloper += "3.1.1 " + I18N(STR0015, {"save_as_rule = false"}) + ": " + STR0016 + BREAK_LINE //"Intenção de ticket atual (opção 1 / save_as_rule = false)" //"exemplos não exaustivos como 'só agora', 'somente nesse ticket', 'não salvar regra', 'apenas desta vez'."
	cDeveloper += "3.1.2 " + I18N(STR0017, {"save_as_rule = true"}) + ": " + STR0052 + BREAK_LINE //"Intenção de persistir como regra (opção 2 / save_as_rule = true)" //"exemplos não exaustivos como 'aplique como regra', 'deixe fixo', 'para os próximos tickets', 'salve esse padrão'."
	cDeveloper += "4. " + STR0018 + ": " + I18N(STR0019, {"'set_mrp_events_selection'", "'save_as_rule'"}) + BREAK_LINE + BREAK_LINE //"EXECUÇÃO" //"Apenas APÓS o usuário confirmar a execução (com opção já indicada por intenção explícita ou escolhendo 1/2), chame a ferramenta 'set_mrp_events_selection' passando a flag 'save_as_rule' de acordo com a opção final."
	cDeveloper += "### " + STR0020 + BREAK_LINE //"MODELO OBRIGATÓRIO DE RESPOSTA"
	cDeveloper += STR0021 + BREAK_LINE //"Use EXATAMENTE os campos abaixo. NÃO adicione campos extras, NÃO renomeie campos e NÃO altere a ordem."
	cDeveloper += STR0022 + ":" + BREAK_LINE //"Entendido. Para garantir que os documentos corretos sejam selecionados no MRP, por favor valide os parâmetros abaixo"
	cDeveloper += "* **" + STR0023 + "**: {{" + STR0024 + "}}" + BREAK_LINE //"Ação" //"Marcar ou Desmarcar"
	cDeveloper += "* **" + STR0025 + "**: {{" + STR0026 + "}}" + BREAK_LINE //"Período de Entrega" //"Data de/até ou 'Não especificado'"
	cDeveloper += "* **" + STR0027 + "**: {{" + STR0028 + "}}" + BREAK_LINE //"Tipos de Documento" //"Lista de documentos ou 'Todos os tipos'"
	cDeveloper += "* **" + STR0029 + "**: {{" + STR0030 + "}}" + BREAK_LINE //"Tipos de Ação" //"Adiantar, Atrasar ou Cancelar ou 'Todas as ações'"
	cDeveloper += "* **" + STR0031 + "**: {{" + STR0032 + "}}" + BREAK_LINE //"Filtros de Produto" //"Produtos/Grupos citados ou 'Nenhum filtro aplicado'"
	cDeveloper += "* **" + STR0033 + "**: {{" + STR0034 + "}}" + BREAK_LINE + BREAK_LINE //"Armazéns" //"Armazéns citados ou 'Todos os armazéns'"
	cDeveloper += STR0035 + ":" + BREAK_LINE //"Sem escolha explícita do usuário"
	cDeveloper += "**" + STR0036 + "**" + BREAK_LINE //"Como deseja prosseguir?"
	cDeveloper += "1. " + STR0037 + BREAK_LINE //"Confirmar apenas para este ticket."
	cDeveloper += "2. " + STR0038 + BREAK_LINE //"Confirmar e também salvar como regra para os próximos tickets."
	cDeveloper += "3. " + STR0039 + BREAK_LINE //"Ajustar algum detalhe."
	cDeveloper += STR0040 + ":" + BREAK_LINE //"Com escolha explícita do usuário:"
	cDeveloper += "**" + STR0041 + "**: {{" + STR0042 + "}}." + BREAK_LINE //"Opção já definida pelo seu pedido" //"Opção 1 ou Opção 2"
	cDeveloper += "**" + STR0043 + "**" + BREAK_LINE + BREAK_LINE //"Posso executar assim?"

	cDeveloper += "### " + STR0001 + " (Tool: set_mrp_events_by_grid_filters)" + BREAK_LINE //"Protocolo de Confirmação"
	cDeveloper += "### " + STR0002 + " " + STR0053 + BREAK_LINE //"Diretriz de Seleção MRP" //"(Pela Tela/Grid)"
	cDeveloper += STR0044 + ":" + BREAK_LINE //"Ao receber um pedido para agir sobre os itens 'da tela', 'do grid' ou 'já filtrados', siga este fluxo"
	cDeveloper += "1. " + STR0045 + BREAK_LINE //"Identifique a ação: marcar/adicionar/incluir = adicionar; desmarcar/remover/retirar = remover. Na ausência de verbo explícito, usar adicionar (padrão)."
	cDeveloper += "2. " + STR0046 + BREAK_LINE //"Gere a resposta de confirmação usando exatamente o modelo abaixo."
	cDeveloper += "3. " + I18N(STR0047, {"'set_mrp_events_by_grid_filters'"}) + BREAK_LINE + BREAK_LINE //"EXECUÇÃO: APÓS o usuário confirmar a ação, chame a ferramenta '#1[FERRAMENTA]#'."
	cDeveloper += "### " + STR0048 + BREAK_LINE //"MODELO OBRIGATÓRIO DE RESPOSTA (GRID/TELA)"
	cDeveloper += I18N(STR0049, {"**{{" + STR0050 + "}}**", "**" + STR0054 + "**"}) + BREAK_LINE + BREAK_LINE //"Entendido. A ação interpretada foi **{{Adicionar/Remover}}** e vou aplicar em **todos os documentos que estão atualmente filtrados na sua tela**."
	cDeveloper += "**" + STR0051 + "**" + BREAK_LINE //"Confirma a execução dessa ação?"
	aAdd(aPrompts, cDeveloper)
	
Return aPrompts

/*/{Protheus.doc} getAdditionalTools
Retorna uma lista de ferramentas adicionais que o assistente pode sugerir ao usuário durante a conversa

@author lucas.franca
@since 13/04/2026
@version P12
@return aAdditionalTools, Array, Array de strings com os nomes das ferramentas adicionais disponíveis no contexto ResultadoMRP.
/*/
Method getAdditionalTools() as Array Class ResultadoMRP
	Local aAdditionalTools := {} as Array

	aAdd(aAdditionalTools, "get_conversation_list")
Return aAdditionalTools

/*/{Protheus.doc} getWelcomeSuggestions
Retorna uma lista de sugestões de boas-vindas que o assistente pode apresentar ao usuário durante a conversa

@author lucas.franca
@since 13/04/2026
@version P12
@return aSuggestions, Array, Array de strings com as sugestões de boas-vindas disponíveis no contexto ResultadoMRP.
/*/
Method getWelcomeSuggestions() as Array Class ResultadoMRP
	Local aSuggestions := {} as Array
	
	aAdd(aSuggestions, {"label": STR0055}) //"Sobre quais assuntos podemos conversar?"
Return aSuggestions

/*/{Protheus.doc} ResultadoMRP::getContextParameters
Retorna os parâmetros de execução do contexto de assistente do Resultado MRP.
@type method
@author lucas.franca
@since 13/04/2026
@version P12
@return json, Objeto JSON com os limites de ferramentas, o limite de iterações e as configurações do modelo de chat.
/*/
Method getContextParameters() as Json Class ResultadoMRP
	Local jContextParameters := JsonObject():New() as Json

	jContextParameters["quantity_tools"   ] := 30
	jContextParameters["loop_limit"       ] := 3
	jContextParameters["max_tool_calls"   ] := 20
	jContextParameters["model_chat"       ] := "claude-opus-4-8"
	jContextParameters["model_temperature"] := Nil
	
Return jContextParameters
