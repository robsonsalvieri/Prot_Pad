#Include "tlpp-core.th"
#Include "TOTVS.CH"
#include "totvs.protheus.manufacturing.dtacontexts.geral.ch"

namespace totvs.protheus.manufacturing.dtacontexts

#DEFINE BREAK_LINE "\n"

/*/{Protheus.doc} Geral
Define as configurações e os recursos do contexto geral de assistente para manufatura.
@type class
@author lucas.franca
@since 13/04/2026
@version P12
/*/
Class Geral
	Static Method getDeveloperPrompt() as Array
	Static Method getAdditionalTools() as Array
	Static Method getWelcomeSuggestions() as Array
	Static Method getContextParameters() as Json
EndClass

/*/{Protheus.doc} getDeveloperPrompt
Retorna definições específicas do contexto "geral" que serão enviadas no prompt de developer.

@author lucas.franca
@since 13/04/2026
@version P12
@return aPrompts, Array, Array de strings com as definições do contexto geral.
/*/
Method getDeveloperPrompt() as Array Class Geral
	Local aPrompts   := {} as Array
	Local cDeveloper       as Character

	cDeveloper := "### " + STR0001 + BREAK_LINE                               //"Especialidade"
	cDeveloper += "**" + STR0002 + "**: " + STR0003 + BREAK_LINE + BREAK_LINE //"REGRA" //"Você é um assistente de IA especialista em planejamento, programação e controle de produção em um contexto industrial. Responda apenas sobre o ERP TOTVS Protheus."
	aAdd(aPrompts, cDeveloper)

	cDeveloper := "### " + STR0004 + BREAK_LINE                               //"Definições de negócio"
	cDeveloper += "> **" + STR0005 + "**: " + STR0006                         //"Estrutura (BOM - Bill of Materials)" //"lista de componentes vinculada a um produto. É a definição da engenharia de produtos indicando o padrão de materiais utilizados para a fabricação do produto."
	cDeveloper += BREAK_LINE+"---"+BREAK_LINE
	cDeveloper += "> **" + STR0007 + "**: " + STR0008                         //"Ordem de produção (OP)" //"documento que define a fabricação de um produto, incluindo quantidade, datas, processo produtivo e componentes utilizados. Também chamada de OP ou Ordem, é identificada por um código alfanumérico único."
	cDeveloper += BREAK_LINE+"---"+BREAK_LINE
	cDeveloper += "> **" + STR0009 + "**: " + STR0010                         //"Empenho" //"lista de materiais reservados para a execução de uma ordem de produção. Diferente da estrutura (BOM), que define o padrão de materiais de um produto, o empenho está sempre vinculado a uma ordem específica. Também pode ser chamado de componentes da ordem ou materiais da ordem."
	cDeveloper += BREAK_LINE
	cDeveloper += "**" + STR0011 + "**: " + STR0012                           //"IMPORTANTE" //"Embora pareçam semelhantes, Empenho e Estrutura são entidades distintas. Consultas sobre Estrutura não devem retornar informações de Empenho, e consultas sobre Empenho não devem retornar informações de Estrutura."
	cDeveloper += BREAK_LINE+"---"+BREAK_LINE
	cDeveloper += "> **" + STR0013 + "**: " + STR0014                         //"Armazém" //"É o local físico ou a entidade lógica designada no sistema para a guarda e o controle de mercadorias. Ele é o ponto central para as operações de recebimento, estocagem, movimentação e expedição de produtos, permitindo o rastreamento preciso do inventário. O código do armazém pode conter somente letras, somente números ou a combinação de caracteres. Exemplo: '01', '98', 'AL', 'L1'."
	cDeveloper += BREAK_LINE+"---"+BREAK_LINE
	cDeveloper += "> **" + STR0015 + "**: " + STR0016                         //"Endereço de Estoque" //"Identifica a localização exata de um produto dentro de um armazém. Ele funciona como uma coordenada, dividindo o espaço em áreas, corredores, prateleiras e posições, para permitir a localização e movimentação rápida e precisa das mercadorias."
	cDeveloper += BREAK_LINE+"---"+BREAK_LINE
	aAdd(aPrompts, cDeveloper)
	
Return aPrompts

/*/{Protheus.doc} getAdditionalTools
Retorna uma lista de ferramentas adicionais que o assistente pode sugerir ao usuário durante a conversa

@author lucas.franca
@since 13/04/2026
@version P12
@return aAdditionalTools, Array, Array de strings com os nomes das ferramentas adicionais disponíveis no contexto geral.
/*/
Method getAdditionalTools() as Array Class Geral
Return {}

/*/{Protheus.doc} getWelcomeSuggestions
Retorna uma lista de sugestões de boas-vindas que o assistente pode apresentar ao usuário durante a conversa

@author lucas.franca
@since 13/04/2026
@version P12
@return aSuggestions, Array, Array de strings com as sugestões de boas-vindas disponíveis no contexto geral.
/*/
Method getWelcomeSuggestions() as Array Class Geral
	Local aSuggestions := {} as Array
	
	aAdd(aSuggestions, {"label": STR0017}) //"Sobre quais assuntos podemos conversar?"
Return aSuggestions

/*/{Protheus.doc} Geral::getContextParameters
Retorna os parâmetros de execução do contexto geral de assistente para manufatura.
@type method
@author lucas.franca
@since 13/04/2026
@version P12
@return json, Objeto JSON com os limites de ferramentas, o limite de iterações e as configurações do modelo de chat.
/*/
Method getContextParameters() as Json Class Geral
	Local jContextParameters := JsonObject():New() as Json

	jContextParameters["quantity_tools"   ] := 30
	jContextParameters["loop_limit"       ] := 3
	jContextParameters["max_tool_calls"   ] := 20
	jContextParameters["model_chat"       ] := "gpt-4.1-mini"
	jContextParameters["model_temperature"] := 0.5
	
Return jContextParameters
