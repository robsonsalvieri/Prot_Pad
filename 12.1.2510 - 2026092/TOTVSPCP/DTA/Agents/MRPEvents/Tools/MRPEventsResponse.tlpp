#include "tlpp-core.th"
#include "protheus.ch"
#include "fwmcptool.th"
#include "mrpeventsresponse.ch"

namespace totvs.tools.sigapcp

/*/{Protheus.doc} MRPEventsResponse
Ferramenta MCP responsável por registrar as respostas do agente de eventos do MRP

@type class
@author lucas.franca
@since 16/07/2026
@version P12
/*/
@FWToolMCP(action="post", erpRelease="12.1.2510", routine="RESULTADOM", option=1, module="SIGAPCP")
Class MRPEventsResponse implements FWMCPTool

	Private Data aMetrics as Array

	Public Method new() as object
	Public Method getDescription() as character
	Public Method getNotes() as character
	Public Method getPayLoadSchema() as json
	Public Method getReturnSchema() as json
	Public Method getMetrics() as Array
	Public Method process(jPayLoad as json) as json
EndClass

/*/{Protheus.doc} New
Instancia a ferramenta MCP

@type method
@author lucas.franca
@since 16/07/2026
@return object, Instancia da classe.
/*/
Method New() as object Class MRPEventsResponse
	Self:aMetrics := {}
Return Self

/*/{Protheus.doc} getDescription
Retorna a descrição exibida para a ferramenta MCP.

@type method
@author lucas.franca
@since 16/07/2026
@return character, Descrição funcional da ferramenta.
/*/
Method getDescription() as character Class MRPEventsResponse
Return STR0001 //"Registra as respostas das etapas de short_answer, insights, reasoning e cards executadas pelo agente de eventos do MRP."

/*/{Protheus.doc} getNotes
Retorna as observações de negócio.

@type method
@author lucas.franca
@since 16/07/2026
@return character, Observações sobre o processamento.
/*/
Method getNotes() as character Class MRPEventsResponse
Return STR0002 //"Registra na tabela de processamento do agente a resposta do agente para cada etapa do processo (short_answer, insights, reasoning ou cards), que serão utilizadas para exibição de diferentes formas para o usuário final."

/*/{Protheus.doc} getPayLoadSchema
Monta o schema JSON de entrada esperado pela ferramenta MCP.

@type method
@author lucas.franca
@since 16/07/2026
@return jSchema, json, Schema JSON com o campo obrigatório do ticket.
/*/
Method getPayLoadSchema() as json Class MRPEventsResponse
	Local jSchema as json

	jSchema := totvs.framework.mcp.tools.getJsonSchema()
	jSchema["properties"] := {;
		"ticket": { "type": "string", "description": STR0003 },; //"Número do ticket do MRP para registro das respostas"
		"responses": {;
			"description": STR0004,; //"Lista com as respostas do agente de eventos do MRP para cada etapa do processo"
			"type": "array",;
			"items": {;
				"type": "object",;
				"properties": {;
					"type": { "type": "string", "description": STR0005 },; //"Tipo da resposta (short_answer, insights, reasoning ou cards)"
					"message": { "type": "string", "description": STR0006 }; //"Mensagem da resposta"
				},;
				"required": {"type", "message"};
			};
		};
	}
	jSchema["required"] := {"ticket", "responses"}
Return jSchema

/*/{Protheus.doc} getReturnSchema
Monta o schema JSON de retorno publicado pela ferramenta MCP.

@type method
@author lucas.franca
@since 16/07/2026
@return jSchema, json, Schema JSON com totais, tipos de eventos e documentos estruturados.
/*/
Method getReturnSchema() as json Class MRPEventsResponse
	Local jSchema as json

	jSchema := totvs.framework.mcp.tools.getJsonSchema()
	jSchema["properties"] := {"message": { "type": "string", "description": STR0007 }} //"Mensagem informativa sobre a execução do processo"
	jSchema["required"  ] := {"message"}
Return jSchema

/*/{Protheus.doc} getMetrics
Retorna as métricas da tool

@type method
@author lucas.franca
@since 16/07/2026
@return Self:aMetrics, array, Array com a lista de métricas da tool
/*/
Method getMetrics() as Array Class MRPEventsResponse
Return Self:aMetrics

/*/{Protheus.doc} process
Registra a resposta do agente na tabela de processamento

@type method
@author lucas.franca
@since 16/07/2026
@param jPayLoad, json, Carga de entrada contendo o ticket a ser processado.
@return jResponse, json, Resultado da estruturação com dados consolidados ou mensagem de erro.
/*/
Method process(jPayLoad as json) as json Class MRPEventsResponse
	Local jResponse       as Json
	Local oAgentMRPEvents as Object

	oAgentMRPEvents := totvs.protheus.manufacturing.agent.mrp.events.DTAAgentMRPEvents():New()
	jResponse       := oAgentMRPEvents:processPostResponses(jPayLoad["ticket"], jPayLoad["responses"])
	FreeObj(oAgentMRPEvents)
Return jResponse
