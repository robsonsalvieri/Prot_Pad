#include "tlpp-core.th"
#include "protheus.ch"
#include "fwmcptool.th"
#include "mrpeventsmark.ch"

namespace totvs.tools.sigapcp

/*/{Protheus.doc} MRPEventsMark
Ferramenta MCP responsável por aplicar as marcações dos documentos do MRP conforme as regras do agente.

@type class
@author lucas.franca
@since 16/07/2026
@version P12
/*/
@FWToolMCP(action="put", erpRelease="12.1.2510", routine="RESULTADOM", option=1, module="SIGAPCP")
Class MRPEventsMark implements FWMCPTool
	
	Private Data aMetrics as Array
	
	Public Method new() as Object
	Public Method getDescription() as Character
	Public Method getNotes() as Character
	Public Method getPayLoadSchema() as Json
	Public Method getReturnSchema() as Json
	Public Method getMetrics() as Array
	Public Method process(jPayLoad as Json) as Json
	
	Private Method createResponse(jMarkData as Json) as Json
EndClass

/*/{Protheus.doc} New
Instancia a ferramenta MCP de marcação de eventos do MRP.

@type method
@author lucas.franca
@since 16/07/2026
@return object, Instancia da classe.
/*/
Method New() as object Class MRPEventsMark
	Self:aMetrics := {}
Return Self

/*/{Protheus.doc} getDescription
Retorna a descrição exibida para a ferramenta MCP.

@type method
@author lucas.franca
@since 16/07/2026
@return character, Descrição funcional da ferramenta.
/*/
Method getDescription() as character Class MRPEventsMark
Return STR0001 //"Aplica regras pré-definidas para atualizar a seleção de quais documentos devem ser processados."

/*/{Protheus.doc} getNotes
Retorna as observações de negócio sobre a marcação e desmarcação dos documentos.

@type method
@author lucas.franca
@since 16/07/2026
@return character, Observações sobre o processamento da marcação.
/*/
Method getNotes() as character Class MRPEventsMark
Return STR0002 //"De acordo com regras pré-definidas, irá marcar ou desmarcar os documentos que serão atualizados."

/*/{Protheus.doc} getPayLoadSchema
Monta o schema JSON de entrada esperado pela ferramenta MCP.

@type method
@author lucas.franca
@since 16/07/2026
@return jSchema, json, Schema JSON com o campo obrigatório do ticket.
/*/
Method getPayLoadSchema() as json Class MRPEventsMark
	Local jSchema as json
	
	jSchema := totvs.framework.mcp.tools.getJsonSchema()
	jSchema["properties"] := { "ticket": { "type": "string", "description": STR0003 } } //"Número do ticket do MRP para atualização da seleção de documentos"
	jSchema["required"  ] := { "ticket" }
Return jSchema

/*/{Protheus.doc} getReturnSchema
Monta o schema JSON de retorno publicado pela ferramenta MCP.

@type method
@author lucas.franca
@since 16/07/2026
@return jSchema, json, Schema JSON com totais, tipos de eventos e documentos processados.
/*/
Method getReturnSchema() as json Class MRPEventsMark
	Local jSchema as json

	jSchema := totvs.framework.mcp.tools.getJsonSchema()
	jSchema["properties"] := {;
		"total_events": { "type": "integer", "description": STR0004 },; //"Total de eventos gerados pelo ticket do MRP"
		"total_documents": { "type": "integer", "description": STR0005 },; //"Total de documentos processados"
		"message": { "type": "string", "description": STR0006 },; //"Mensagem informativa sobre a execução do processo"
		"applyed_rules": { "type": "string", "description": STR0007 },; //"Regras de usuário que foram aplicadas no processo de seleção de documentos"
		"system_rules": { "type": "string", "description": STR0008 },; //"Regras do sistema aplicadas no processo de seleção de documentos"
		"documents": {;
			"description": STR0009,; //"Lista com os tipos de documentos e suas quantidades que estão selecionados após o processo de aplicação das regras"
			"type": "array",;
			"items": {;
				"type": "object",;
				"properties": {;
					"type": { "type": "string", "description": STR0010 },; //"Tipo do documento"
					"quantity": { "type": "integer", "description": STR0011 }; //"Quantidade de documentos do tipo informado"
				},;
				"required": {"type", "quantity"};
			};
		},;
		"event_types": {;
			"description": STR0012,; //"Lista com os tipos de eventos e suas quantidades que estão selecionadas após o processo de aplicação das regras"
			"type": "array",;
			"items": {;
				"type": "object",;
				"properties": {;
					"type": { "type": "string", "description": STR0013 },; //"Tipo do evento"
					"quantity": { "type": "integer", "description": STR0014 }; //"Quantidade de eventos do tipo informado"
				},;
				"required": {"type", "quantity"};
			};
		};
	}
	jSchema["required"] := { "total_events", "total_documents", "applyed_rules", "system_rules", "documents", "event_types" }
Return jSchema

/*/{Protheus.doc} getMetrics
Retorna as métricas da tool

@type method
@author lucas.franca
@since 16/07/2026
@return Self:aMetrics, array, Array com a lista de métricas da tool
/*/
Method getMetrics() as Array Class MRPEventsMark
Return Self:aMetrics

/*/{Protheus.doc} process
Executa a marcação dos documentos do ticket informado e retorna a resposta padronizada da ferramenta MCP.

@type method
@author lucas.franca
@since 16/07/2026
@param jPayLoad, json, Carga de entrada contendo o ticket a ser processado.
@return jResponse, json, Resultado da marcação com dados consolidados ou mensagem de erro.
/*/
Method process(jPayLoad as json) as json Class MRPEventsMark
	Local jResponse       as Json
	Local jMarkData       as Json
	Local oAgentMRPEvents as Object

	oAgentMRPEvents := totvs.protheus.manufacturing.agent.mrp.events.DTAAgentMRPEvents():New()
	jMarkData := oAgentMRPEvents:processPostMark(jPayLoad["ticket"])
	jResponse := Self:createResponse(jMarkData)

	FreeObj(jMarkData)
	FreeObj(oAgentMRPEvents)
Return jResponse

/*/{Protheus.doc} createResponse
Cria a resposta padronizada da ferramenta MCP a partir dos dados de marcação.

@type method
@author lucas.franca
@since 16/07/2026
@param jMarkData , json, Dados de marcação retornados pelo agente.
@return jResponse, json, Resultado da marcação com dados consolidados ou mensagem de erro.
/*/
Method createResponse(jMarkData as Json) as Json Class MRPEventsMark
	Local aNames    as Array
	Local jResponse as Json
	Local jRules    as Json
	Local nIndex    as Integer

	If jMarkData:hasProperty("error")
		jResponse := { "error": {"message": jMarkData["error"]} }
	Else
		jResponse := {"total_events": 0, "total_documents": 0, "message": "", "applyed_rules": "", "system_rules": "", "documents": Array(0), "event_types": Array(0)}
		aNames    := jMarkData:getNames()

		For nIndex := 1 To Len(aNames)
			If jResponse:hasProperty(aNames[nIndex])
				If aNames[nIndex] $ "applyed_rules|system_rules"
					jRules := JsonObject():New()
					jRules:set(jMarkData[aNames[nIndex]])
					jResponse[aNames[nIndex]] := jRules:toJson()
					FreeObj(jRules)
				Else
					jResponse[aNames[nIndex]] := jMarkData[aNames[nIndex]]
				EndIf
				jMarkData[aNames[nIndex]] := Nil
			EndIf
		Next nIndex
		aSize(aNames, 0)
	EndIf
Return jResponse
