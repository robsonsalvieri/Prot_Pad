#include "protheus.ch"
#include "totvs.manufatura.controlederevisoes.interface.pcpa116.ch"

/*/{Protheus.doc} PCPA116SX
Realiza a chamada do aplicativo Smart X via menu

@author Thiago Rover
@since 06/08/2026

@return logical, Retorna .T. se o aplicativo Smart X for aberto com sucesso.
                         .F. se houver falha ao abrir o aplicativo Smart X.
/*/
Function PCPA116SX()
    
    Local lRevAut       := SuperGetMv("MV_REVAUT",.F.,.F.)
    Local lVersaoCompat := GetRPORelease() >= '12.1.2610'
    Local oLauncher as Object
        
    If lVersaoCompat
        oLauncher := totvs.framework.application.smartx.launcher():new()
        oLauncher:setInterface("totvs.manufatura.controlederevisoes.interface.pcpa116")
        
        If !lRevAut
            // STR0001 - Help
            // STR0002 - Acesso não autorizado à rotina.
            // STR0003 - O parâmetro MV_REVAUT que indica controle de revisões automaticamente está inativo!
            Help(NIL, NIL, STR0001, NIL, STR0002, 1, 0, NIL, NIL, NIL, NIL, NIL, {STR0003})
        Else
            PopulaSOW()
        Endif
    Endif

Return Iif(lVersaoCompat .And. lRevAut .And. oLauncher != Nil, oLauncher:open(), Nil)


/*/{Protheus.doc} PopulaSOW
Popula a tabela SOW com os campos da SG1 para a execução da rotina.

@author Thiago Rover
@since 06/08/2026

@return Nil, Retorna Nil após a execução do método.
/*/
Static Function PopulaSOW()

    Local aStrSG1 := {}
    Local nI      := 0
    
    // Lista de campos
    aAdd(aStrSG1,"G1_TRT")
    aAdd(aStrSG1,"G1_QUANT")
    aAdd(aStrSG1,"G1_PERDA")
    aAdd(aStrSG1,"G1_INI")
    aAdd(aStrSG1,"G1_FIM")
    aAdd(aStrSG1,"G1_OBSERV")
    aAdd(aStrSG1,"G1_FIXVAR")
    aAdd(aStrSG1,"G1_GROPC")
    aAdd(aStrSG1,"G1_OPC")
    aAdd(aStrSG1,"G1_POTENCI")
    aAdd(aStrSG1,"G1_TIPVEC")
    aAdd(aStrSG1,"G1_VECTOR")

    // Proteção do fonte para não exibir campos novos nesta release
    If FindFunction("RodaNewPCP") .And. RodaNewPCP()
        aAdd(aStrSG1,"G1_LOCCONS")
        aAdd(aStrSG1,"G1_FANTASM")
    EndIf
    
    // Persistência dos campos na tabela SOW
    DbSelectArea('SOW')
    SOW->(DbSetOrder(1))
    For nI := 1 to len( aStrSG1 )
        If !SOW->(DbSeek(xFilial('SOW')+aStrSG1[nI]))
            RecLock('SOW',.T.)			
            SOW->OW_FILIAL := xFilial('SOW')
            SOW->OW_CODIGO := aStrSG1[nI]
            SOW->OW_REVISA := "1"
            SOW->(MsUnLock())
        Endif
    Next

Return Nil
