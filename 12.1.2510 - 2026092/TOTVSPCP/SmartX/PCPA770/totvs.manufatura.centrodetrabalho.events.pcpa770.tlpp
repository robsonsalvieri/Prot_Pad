#Include "fw-tlpp-core.th"
#Include "protheus.ch"
#Include "totvs.framework.model.events.th"
#Include "totvs.manufatura.centrodetrabalho.interface.pcpa770.ch"
#Include 'FWMVCDEF.CH'

namespace totvs.manufatura.centrodetrabalho.events

/*/{Protheus.doc} PCPA770
Classe responsável por definir os eventos da rotina de Centro de Trabalho

@autor thiago.rover
@since 10/08/2026
/*/
Class PCPA770 

    public method new() as object

    @beforeDeleteInTransaction()
    public method beforeDeleteInTransaction(oData as object, oModel as object, oError as object)

    @afterCreateInTransaction()
    public method afterCreateInTransaction(oData as object, oModel as object, oError as object)

	@afterUpdateInTransaction()
	public method afterUpdateInTransaction(oData as object, oModel as object, oError as object)

	@afterDeleteInTransaction()
	public method afterDeleteInTransaction(oData as object, oModel as object, oError as object)

	public method integracaoComChaoDeFabrica(nOperacao as numeric, cError as character, cNome as character, oModel as object, oModelSHB as object, oError as object)

EndClass

/*/{Protheus.doc} new
Método construtor da classe PCPA770

@autor thiago.rover
@since 10/08/2026

@return self, Retorna a instância da classe PCPA770
*/
Method new() as object class PCPA770
Return self

/*/{Protheus.doc} beforeDeleteInTransaction
Evento executado antes de deletar os objetos contidos no modelo em uma transação

@autor thiago.rover
@since 10/08/2026

@param01 oData  , object, Objeto contendo os dados do modelo que será deletado
@param02 oModel , object, Objeto do modelo que será deletado
@param03 oError , object, Objeto de erro recebido por referência que apresentará a mensagem de erro
@return lRetorno, Retorna: .T. se a operação de delete for permitida
                           .F. se a operação não for permitida
*/
Method beforeDeleteInTransaction(oData as object, oModel as object, oError as object) class PCPA770

    Local aArea     := GetArea()
    Local cConteudo := oData:getFieldValue("SHB","HB_COD")
    Local lRetorno  := .T.

    dbSelectArea("SG2")
    SG2->(dbSetOrder(5))
    If SG2->(dbSeek(xFilial()+cConteudo))
        // STR0007 - Centro de Trabalho já utilizado em um Roteiro de Operações, não pode ser excluído.
        oError:set(400, "DeleteError", STR0007)
        lRetorno := .F.
    EndIf

    dbSelectArea(aArea)

Return lRetorno

/*/{Protheus.doc} afterCreateInTransaction
Evento executado após criar os objetos contidos no modelo em uma transação

@autor thiago.rover
@since 10/08/2026

@param01 oData  , object, Objeto contendo os dados do modelo que foi criado
@param02 oModel , object, Objeto do modelo que foi criado
@param03 oError , object, Objeto de erro recebido por referência que apresentará a mensagem de erro
@return lRetorno, Retorna: .T. se a operação de criação ocorreu corretamente
                           .F. se a operação de criação NÃO ocorreu corretamente
/*/
Method afterCreateInTransaction(oData as object, oModel as object, oError as object) class PCPA770

	Local lIntDPR  := IntegraDPR() .And. !IsInCallStack("AUTO770")     // Determina se existe integração com o SIGADPR
	Local lIntSFC  := ExisteSFC("SHB") .And. !IsInCallStack("AUTO770") // Determina se existe integração com o SIGASFC
	Local lRetorno := .T.
	
	// Chama o method para integração com SFC (Chão de Fábrica)
	If lIntDPR .Or. lIntSFC
		lRetorno := self:integracaoComChaoDeFabrica(3,,,,oData, @oError)
	EndIf
   
Return lRetorno

/*/{Protheus.doc} afterUpdateInTransaction
Evento executado após editar os objetos contidos no modelo em uma transação

@autor thiago.rover
@since 10/08/2026

@param01 oData  , object, Objeto contendo os dados do modelo que foi editado
@param02 oModel , object, Objeto do modelo que foi editado
@param03 oError , object, Objeto de erro recebido por referência que apresentará a mensagem de erro
@return lRetorno, Retorna: .T. se a operação de edição ocorreu corretamente
                           .F. se a operação de edição NÃO ocorreu corretamente
/*/
Method afterUpdateInTransaction(oData as object, oModel as object, oError as object) class PCPA770

	Local lIntDPR  := IntegraDPR() .And. !IsInCallStack("AUTO770")     // Determina se existe integração com o SIGADPR
	Local lIntSFC  := ExisteSFC("SHB") .And. !IsInCallStack("AUTO770") // Determina se existe integração com o SIGASFC
	Local lRetorno := .T.
	
	// Chama o method para integração com SFC (Chão de Fábrica)
	If lIntDPR .Or. lIntSFC
		lRetorno := self:integracaoComChaoDeFabrica(4,,,,oData, @oError)
	EndIf
   
Return lRetorno

/*/{Protheus.doc} afterDeleteInTransaction
Evento executado após deletar os objetos contidos no modelo em uma transação

@autor thiago.rover
@since 10/08/2026

@param01 oData  , object, Objeto contendo os dados do modelo que foi deletado
@param02 oModel , object, Objeto do modelo que foi deletado
@param03 oError , object, Objeto de erro recebido por referência que apresentará a mensagem de erro
@return lRetorno, Retorna: .T. se a operação de deleção ocorreu corretamente
                           .F. se a operação de deleção NÃO ocorreu corretamente
/*/
Method afterDeleteInTransaction(oData as object, oModel as object, oError as object) class PCPA770

	Local lIntDPR  := IntegraDPR() .And. !IsInCallStack("AUTO770")     // Determina se existe integração com o SIGADPR
	Local lIntSFC  := ExisteSFC("SHB") .And. !IsInCallStack("AUTO770") // Determina se existe integração com o SIGASFC
	Local lRetorno := .T.
	
	// Chama o method para integração com SFC (Chão de Fábrica)
	If lIntDPR .Or. lIntSFC
		lRetorno := self:integracaoComChaoDeFabrica(5,,,,oData, @oError)
	EndIf
   
Return lRetorno

/*/{Protheus.doc} integracaoComChaoDeFabrica
Realiza integração com o módulo chão de fábrica (SIGASFC) - Função preparada para chamadas antigas e Smart X

@author thiago.rover
@since 11/08/2026

@param nOperacao , number   , Operação que está sendo realizada
@param cError    , character, Variável passada por referência, para retornar mensagens de erro caso existam
@param cNome     , character, Nome para geração de log de erro caso ocorra
@param oModel    , object   , Modelo de dados utilizado na integração
@param oModelSHB , object   , Modelo de dados específico do SHB utilizado na integração
@param oError    , object   , Objeto de erro SMART X recebido por referência que será montada a mensagem de erro

@return lRetorno , logical  , Retorna: .T. integração realizada com sucesso 
                                       .F. integração NÃO realizada
/*/
Method integracaoComChaoDeFabrica(nOperacao,cError,cNome,oModel,oModelSHB,oError) class PCPA770
	
	Local aArea    := GetArea() 
	Local aAux     := {}        
	Local aCampos  := {}       
	Local cHB_CC   := ""        // Centro de Custo
	Local cHB_COD  := ""        // Código do Centro de Trabalho
	Local cHB_HRUT := ""        // Horas Uteis Centesimais
	Local cHB_NOME := ""        // Nome do Centro de Trabalho
	Local lSmartX  := .F.       // Indica se a chamada origem é via Smart X ou legado
	Local lRetorno := .T.       
	Local nX       := 0         

	Default oModelSHB := NIL
	Default oModel    := FWLoadModel("SFCA001")

	lSmartX := IsInCallStack("afterCreateInTransaction") .Or. ;
	           IsInCallStack("afterUpdateInTransaction") .Or. ;
			   IsInCallStack("afterDeleteInTransaction")

	If oModelSHB == NIL
		oModelSHB := FWLoadModel("MATA770")
		oModelSHB:SetOperation(MODEL_OPERATION_VIEW)
		oModelSHB:Activate()
	Endif

	cHB_COD  := IIF(lSmartX, oModelSHB:getFieldValue("SHB","HB_COD") , oModelSHB:GetValue("SHBMASTER","HB_COD"))
	cHB_NOME := IIF(lSmartX, oModelSHB:getFieldValue("SHB","HB_NOME"), oModelSHB:GetValue("SHBMASTER","HB_NOME"))
	cHB_CC   := IIF(lSmartX, oModelSHB:getFieldValue("SHB","HB_CC")  , oModelSHB:GetValue("SHBMASTER","HB_CC"))
	cHB_HRUT := IIF(lSmartX, oModelSHB:getFieldValue("SHB","HB_HRUT"), oModelSHB:GetValue("SHBMASTER","HB_HRUT"))

	If nOperacao < 5
		// Monta array com dados do Centro de Trabalho para atualização no SFC
		If nOperacao == 3
			aAdd(aCampos,{"CYI_CDCETR", cHB_COD})
		EndIf
		aAdd(aCampos,{"CYI_DSCETR", cHB_NOME})
		aAdd(aCampos,{"CYI_CDCECS", cHB_CC})
		aAdd(aCampos,{"CYI_HRUTDY", cHB_HRUT})
	EndIf

	oModel:SetOperation(nOperacao)
	
	If nOperacao # 3
		// Alteração e Exclusão: Posiciona o registro antes de realizar a operação
		CYI->(dbSetOrder(1))
		CYI->(dbSeek(xFilial("CYI")+cHB_COD))
	EndIf

	// Ativa o modelo de dados
	If (lRetorno := oModel:Activate())
		// Obtém a estrutura de dados do Model
		aAux := oModel:GetModel("CYIMASTER"):GetStruct():GetFields()
		
		// Loop para validação e atribuição de dados dos campos do Model
		For nX := 1 To Len(aCampos)
			// Valida os campos existentes na estrutura do Model
			If aScan(aAux,{|x| AllTrim(x[3]) ==  AllTrim(aCampos[nX,1])}) > 0
				// Atribui os valores aos campos do Model após validação de tipo, tamanho e compatibilidade estrutural
				If !(oModel:SetValue("CYIMASTER",aCampos[nX,1],aCampos[nX,2]))
					lRetorno := .F.
					Exit       
				EndIf
			EndIf
		Next nX
	EndIf
	
	If lRetorno
		// Valida os dados e integridade conforme dicionario do Model
		If (lRetorno := oModel:VldData())
			// Efetiva gravação dos dados na tabela
			lRetorno := oModel:CommitData()
		EndIf
	EndIf

	// Gera log de erro caso não tenha passado pela validação
	If !lRetorno
	    If lSmartX
			oError:set(400, "IntegrationError", oModel:GetErrorMessage()[6])
		Else
			A010SFCErr(oModel,@cError,NIL,cNome,cHB_COD,@oError)
	    EndIf
	EndIf
	
	// Desativa o Model
	oModel:DeActivate()
	
	// Restaura a área
	RestArea(aArea)
Return(lRetorno)
