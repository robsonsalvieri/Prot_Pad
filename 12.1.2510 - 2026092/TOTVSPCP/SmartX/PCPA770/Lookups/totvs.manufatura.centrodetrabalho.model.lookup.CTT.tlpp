#include 'fw-tlpp-core.th'
#include "protheus.ch"
#include "totvs.framework.structure.model.th"
#include "totvs.manufatura.centrodetrabalho.interface.pcpa770.ch"

namespace totvs.manufatura.centrodetrabalho.model.lookup

@totvsFrameworkStructureModel(lookup=.T., country="ALL", description="Tabela CTT - Centro de Custo")

/*/{Protheus.doc} CTT
Classe CTT responsável por definir o modelo de dados da lookup de Centro de Custo

@autor thiago.rover
@since 10/08/2026
/*/
Class CTT from totvs.framework.structure.model.data
    public method new() as object
    public method setModel()
EndClass

/*/{Protheus.doc} new
Método construtor da classe CTT

@autor thiago.rover
@since 10/08/2026

@return self, Retorna a instância da classe CTT
/*/
Method new() as object class CTT
    _Super:new(,,.T.)
Return self

/*/{Protheus.doc} setModel
Método responsável por configurar o modelo de dados da classe CTT

@autor thiago.rover
@since 10/08/2026
/*/
Method setModel() class CTT
    
    Local oHeader as Object
    Local oArray  as Object
    Local oField  as Object
    Local oIndex  as Object
    Local oFinder as Object

    oHeader := totvs.framework.structure.object.BuildFromCode():new("XTX")

    // Campo Código
    oField := totvs.framework.structure.object.BuildFieldProperties():new("XTX_COD")
    oField:setType("C")
    oField:setTitle(STR0005)       // STR0005 - Código
    oField:setDescription(STR0005) // STR0005 - Código
    oField:setSize(9)
    oField:setOrder(1)
    oField:setRequired(.T.)
    oField:setUpperCase(.T.)
    oHeader:addFieldProperties(oField:getFieldProperties())

    // Campo Descrição
    oField := totvs.framework.structure.object.BuildFieldProperties():new("XTX_DESC")
    oField:setType("C")
    oField:setTitle(STR0006)       // STR0006 - Descrição
    oField:setDescription(STR0006) // STR0006 - Descrição
    oField:setSize(100)
    oField:setOrder(2)
    oField:setRequired(.T.)
    oField:setUpperCase(.T.)
    oHeader:addFieldProperties(oField:getFieldProperties())

    oHeader:setTitle(STR0007) // STR0007 - Tabela CTT - Centro de Custo

    oIndex := totvs.framework.structure.object.BuildIndex():new("XTX" + cEmpAnt + "0")
    oIndex:setOrder("1")
    oIndex:setKeyFields({"XTX_COD"})
    oHeader:addIndexConstraint(oIndex:getIndex())

    oFinder := totvs.framework.structure.model.finder():new()
    oFinder:setFinder({"XTX_COD", "XTX_DESC"}, "", .T.)
    oHeader:addFinder(oFinder:getFinder())

    oHeader:setUniqueKeyConstraint("XTX" + cEmpAnt + "0", {"XTX_COD"})

    oArray := CTTDataArray():new()

    self:setObject(oHeader:getObject(), "XTX",,,,,, oArray)

    self:setOrder({{"XTX_COD", .F.}})
    self:LoadEventsFromMetadata()
    
Return

/*/{Protheus.doc} CTTDataArray
Classe responsável por definir o array de dados da lookup de Centro de Custo

@autor thiago.rover
@since 10/08/2026
/*/
Class CTTDataArray
    
    public method new() as object
    public method getData() as array

EndClass

/*/{Protheus.doc} new
Instância do objeto da classe

@autor thiago.rover
@since 10/08/2026
/*/
Method new() as object class CTTDataArray
Return self

/*/{Protheus.doc} getData
Monta array de dados do Lookup (CTT ou SI3) com base na filial correspondente

@author  thiago.rover
@since   10/08/2026

@return aData, array, {Custo, Moeda}
/*/
Method getData() as array class CTTDataArray

    Local aData       := {}
    Local cAliasTmp   := ""
    Local lCTBInUse   := CtbInUse()   // Verifica se o Módulo SIGACTB está ativo (.T.) ou inativo (.F.)
    Local cTabela     := If(lCTBInUse, "CTT", "SI3")
    Local cFilTab     := If(lCTBInUse, "CTT_FILIAL", "I3_FILIAL")
    Local cCusto      := If(lCTBInUse, "CTT_CUSTO" , "I3_CUSTO")
    Local cMoeda      := If(lCTBInUse, "CTT_DESC01", "I3_MOEDA")
    Local cQuery      := ""
    Local nParamOrder := 1
    Local oStatement  := NIL

    // Buscar os dados da CTT ou SI3 com base na filial correspondente e ordenado pelo campo de custo
    cQuery := " SELECT "
    cQuery +=   " " + cCusto + " AS CUSTO, " 
    cQuery +=   " " + cMoeda + " AS MOEDA  "
    cQuery += " FROM " + RetSqlName(cTabela)
    cQuery += " WHERE " + cFilTab + " = ? "
    cQuery +=   " AND D_E_L_E_T_ = ? "
    cQuery += " ORDER BY " + cCusto + " "

    cQuery := ChangeQuery(cQuery)

    oStatement := FwExecStatement():New(cQuery)

    oStatement:SetString(nParamOrder++, xFilial("SHB"))
    oStatement:SetString(nParamOrder++, " ")

    cAliasTmp := oStatement:OpenAlias()

    If (cAliasTmp)->(!Eof())
        While (cAliasTmp)->(!Eof())
            
            AAdd(aData, { (cAliasTmp)->CUSTO, ;
                          (cAliasTmp)->MOEDA })

            (cAliasTmp)->(dbSkip())
        EndDo
    EndIf

    (cAliasTmp)->(dbCloseArea())

Return aData
