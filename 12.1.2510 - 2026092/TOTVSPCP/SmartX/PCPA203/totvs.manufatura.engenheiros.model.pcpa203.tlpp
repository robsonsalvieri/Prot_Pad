#include "fw-tlpp-core.th"
#include "protheus.ch"
#include "totvs.framework.structure.model.th"
#include "totvs.manufatura.engenheiros.interface.pcpa203.ch"

namespace totvs.manufatura.engenheiros.model

@totvsFrameworkStructureModel(lookup=.F., country="ALL", description="Engenheiros")

/*/{Protheus.doc} PCPA203
Classe PCPA203 responsavel por definir o modelo de dados da rotina de Engenheiros.
Tabela principal: SGK.

@type class
@author Felipe Avelar
@since 27/08/2026
@see https://jiraproducao.totvs.com.br/browse/DMANPCP2-2344
/*/
class PCPA203 from totvs.framework.structure.model.data
    public method new() as object
    public method setModel()
EndClass

/*/{Protheus.doc} new
Metodo construtor da classe PCPA203.

@type method
@author Felipe Avelar
@since 27/08/2026

@return object, Retorna a instancia da classe PCPA203.
/*/
method new() as object class PCPA203
    _Super:new(,,.T.)
Return self

/*/{Protheus.doc} setModel
Metodo responsavel por configurar o modelo de dados da classe PCPA203.
Define a entidade SGK (Engenheiros) com seus campos e chave unica,
oculta o campo de filial e associa os eventos transacionais.

@type method
@author Felipe Avelar
@since 27/08/2026
/*/
method setModel() class PCPA203
    Local oSGK as object

    // Constroi o modelo de dados da tabela SGK (Engenheiros)
    oSGK := totvs.framework.structure.object.ObjectFromMetadata():new("SGK")

    // Define a entidade principal do modelo
    self:setObject(oSGK:getObject(), "SGK")

    // Oculta o campo de filial
    self:setProperty("GK_FILIAL", "hidden", .T., "SGK")

    // Autoincremento SmartX temporariamente desabilitado para testar
    // o preenchimento automatico configurado no dicionario da SGK.
    // self:setProperty("GK_COD", "autoinc", .T., "SGK")
    // self:setProperty("GK_COD", "autoincSequence", "00", "SGK")
    // self:setProperty("GK_COD", "format", "alphanumericSec", "SGK")

    // Teste: mantem somente as validacoes do dicionario.
    // Triggers e inicializadores ficam desabilitados para isolar a origem do GK_COD.
    self:loadEventsFromMetadata(.F., .T., .F.)

    // Inclui as validacoes transacionais especificas da rotina.
    self:setEvents(totvs.manufatura.engenheiros.events.pcpa203():new())

Return
