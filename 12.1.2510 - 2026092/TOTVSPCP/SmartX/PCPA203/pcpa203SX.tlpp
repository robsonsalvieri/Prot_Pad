#include "fw-tlpp-core.th"
#include "protheus.ch"

/*/{Protheus.doc} PCPA203SX
Realiza a chamada do aplicativo Smart X via menu para o Cadastro de Engenheiros.

@type function
@author Felipe Avelar
@since 27/08/2026

@return logical, Retorna .T. se o aplicativo Smart X for aberto com sucesso.
                         .F. se houver falha ao abrir o aplicativo Smart X.

@see https://jiraproducao.totvs.com.br/browse/DMANPCP2-2344
/*/
Function PCPA203SX()
    Local lVersaoCompat := GetRPORelease() >= '12.1.2610'
    Local oLauncher     as Object

    If lVersaoCompat
        oLauncher := totvs.framework.application.smartx.launcher():new()
        oLauncher:setInterface("totvs.manufatura.engenheiros.interface.pcpa203")
    EndIf

 Return Iif(lVersaoCompat .and. oLauncher != Nil, oLauncher:open(), Nil)




