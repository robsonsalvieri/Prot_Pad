#include "protheus.ch"
#include "totvs.framework.model.events.th"
#include 'fw-tlpp-core.th'
#include "totvs.manufatura.familiatecnica.interface.pcpa105.ch"

namespace totvs.manufatura.familiatecnica.valids

/*/{Protheus.doc} vldDupFamTec
Função responsável por validar e impedir a duplicidade do código da família técnica (CZL_CDFATD) no banco de dados.

@author Thiago Rover
@since 24/07/2026

@param01 xValue       , any      , Valor preenchido no campo CZL_CDFATD
@param02 cField       , character, Nome do campo posicionado
@param03 aContextInfo , array    , [0] = CZL_CDFATD da linha atual
@return  jRetorno     , Retorna Json com a propriedade: "return" indicando se o registro é válido (.T.) e "notValidMessage" vazio, ou
                                                        "return" indicando se o registro é inválido (.F.) e "notValidMessage" contendo a mensagem de erro.
*/
Function vldDupFamTec(xValue as variant, cField as character, aContextInfo as array) as Json

    Local cConteudo := AllTrim(xValue)
    Local jRetorno  := JsonObject():New() as Json

    // Inicializa o objeto Json de retorno
    jRetorno['return']          := .T.
    jRetorno['notValidMessage'] := ""

    dbSelectArea("CZL")
	CZL->(dbSetOrder(1))
	If CZL->(dbSeek(xFilial("CZL")+cConteudo))
        // STR0002 - Família técnica já cadastrada.
        jRetorno['return'] := .F.
        jRetorno['notValidMessage'] := STR0002
	EndIf

Return jRetorno
