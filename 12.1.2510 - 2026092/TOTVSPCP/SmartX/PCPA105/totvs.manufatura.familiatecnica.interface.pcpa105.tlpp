#include "totvs.manufatura.familiatecnica.interface.pcpa105.ch"

namespace totvs.manufatura.familiatecnica.interface

@totvsFrameworkStructureInterface(lookup=.F., country="ALL", description="Família Técnica")

/*/{Protheus.doc} PCPA105
Classe PCPA105 responsável por definir a interface da rotina de Família Técnica.

@author Thiago Rover
@since 24/07/2026
/*/
class PCPA105
    private data oInterface  as object
    private data oDataNew    as object
    private data oDataEdit   as object
    private data oDataDetail as object
    private data oDataView   as object
 
    public method new() as object
    public method setInterface()
    public method getContract() as json
EndClass

/*/{Protheus.doc} new
Método construtor da classe PCPA105.

@autor Thiago Rover
@since 24/07/2026

@return self, Retorna a instância da classe PCPA105.
/*/
Method new() as object class PCPA105
Return self

/*/{Protheus.doc} setInterface
Método responsável por definir a interface da rotina de Família Técnica.

@autor Thiago Rover
@since 24/07/2026
/*/
Method setInterface() class PCPA105

    Local oElementsCZL as object

    //STR0001 - Família Técnica
    ::oInterface := totvs.framework.structure.interface.BuildContract():new("pcpa105")
    ::oInterface:setTitle(STR0001) 
    ::oInterface:setModelId("totvs.manufatura.familiatecnica.model.pcpa105", .T.)
    ::oInterface:setVersion("1.0")
    
    // Cabeçalho - Código e Descrição da Família Técnica
    oElementsCZL := totvs.framework.structure.interface.BuildElementsFromCode():new()
    oElementsCZL:addElements({"CZL_FILIAL", "CZL_CDFATD","CZL_DSFATD"}, .F.)
    
    // Construção da interface de Inclusão
    // STR0003 - Incluir Família Técnica
    ::oDataNew := totvs.framework.structure.interface.BuildDataNew():new("pcpa105New", "totvs.manufatura.familiatecnica.model.pcpa105")
    ::oDataNew:setTitle(STR0003)
    ::oDataNew:setElement(oElementsCZL:getElements())
    
    // Construção da interface de Edição
    // STR0004 - Editar Família Técnica
    ::oDataEdit := totvs.framework.structure.interface.BuildDataEdit():new("pcpa105Edit", "totvs.manufatura.familiatecnica.model.pcpa105")
    ::oDataEdit:setTitle(STR0004)
    ::oDataEdit:setElement(oElementsCZL:getElements())
    
    // Construção da interface de Detalhe = Visualização
    // STR0005 - Detalhes Família Técnica
    ::oDataDetail := totvs.framework.structure.interface.BuildDataDetail():new("pcpa105Detail", "totvs.manufatura.familiatecnica.model.pcpa105")
    ::oDataDetail:setTitle(STR0005)
    ::oDataDetail:setElement(oElementsCZL:getElements())
    
    // Construção da interface do Browser
    // STR0001 - Família Técnica
    ::oDataView := totvs.framework.structure.interface.BuildDataView():new("pcpa105View", "totvs.manufatura.familiatecnica.model.pcpa105")
    ::oDataView:setTitle(STR0001)
 
    ::oInterface:setDataNew(::oDataNew:getDataNew(), .f.)
    ::oInterface:setDataEdit(::oDataEdit:getDataEdit(), .f.)
    ::oInterface:setDataDetail(::oDataDetail:getDataDetail(), .f.)
    ::oInterface:setDataView(::oDataView:getDataView())
return

/*/{Protheus.doc} getContract
Método responsável por retornar o contrato da interface da rotina de Família Técnica.

@autor Thiago Rover
@since 24/07/2026

@return json, Retorna o contrato da interface da rotina de Família Técnica.
/*/
Method getContract() as json class PCPA105
Return ::oInterface:getContract()
