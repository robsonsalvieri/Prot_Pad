namespace totvs.manufatura.operacoes.interface

@totvsFrameworkStructureInterface(lookup=.F., country="ALL", description="Operações")

/*/{Protheus.doc} PCPA117
Classe PCPA117 responsável por definir a interface da rotina de Operações.

@author thiago.rover
@since 12/08/2026
/*/
class PCPA117
    private data oInterface  as object
    private data oDataNew    as object
    private data oDataEdit   as object
    private data oDataDetail as object
    private data oDataView   as object
 
    public method new() as object
    public method setInterface()
    public method getContract() as json
EndClass

/*/{Protheus.doc} new
Método construtor da classe PCPA117.

@autor thiago.rover
@since 12/08/2026

@return self, Retorna a instância da classe PCPA117.
/*/
Method new() as object class PCPA117
Return self

/*/{Protheus.doc} setInterface
Método responsável por definir a interface da rotina de Operações.

@autor thiago.rover
@since 12/08/2026
/*/
Method setInterface() class PCPA117

    Local oElementsSVI as object

    // STR0001 - Operações
    ::oInterface := totvs.framework.structure.interface.BuildContract():new("PCPA117")
    ::oInterface:setTitle("Operações") 
    ::oInterface:setModelId("totvs.manufatura.operacoes.model.PCPA117", .T.)
    ::oInterface:setVersion("1.0")
    
    // Cabeçalho
    oElementsSVI := totvs.framework.structure.interface.BuildElementsFromCode():new()
    oElementsSVI:addElements({"VI_CODIGO", "VI_DESCRI"}, .F.)
    
    // Construção da interface de Inclusão
    // STR0002 - Incluir Operações
    ::oDataNew := totvs.framework.structure.interface.BuildDataNew():new("PCPA117New", "totvs.manufatura.operacoes.model.PCPA117")
    ::oDataNew:setTitle(STR0002)
    ::oDataNew:setElement(oElementsSVI:getElements())
    
    // Construção da interface de Edição
    // STR0003 - Editar Operações
    ::oDataEdit := totvs.framework.structure.interface.BuildDataEdit():new("PCPA117Edit", "totvs.manufatura.operacoes.model.PCPA117")
    ::oDataEdit:setTitle(STR0003)
    ::oDataEdit:setElement(oElementsSVI:getElements())
    
    // Construção da interface de Detalhe = Visualização
    // STR0004 - Detalhes Operações
    ::oDataDetail := totvs.framework.structure.interface.BuildDataDetail():new("PCPA117Detail", "totvs.manufatura.operacoes.model.PCPA117")
    ::oDataDetail:setTitle(STR0004)
    ::oDataDetail:setElement(oElementsSVI:getElements())
    
    // Construção da interface do Browser
    // STR0001 - Operações
    ::oDataView := totvs.framework.structure.interface.BuildDataView():new("PCPA117View", "totvs.manufatura.operacoes.model.PCPA117")
    ::oDataView:setTitle(STR0001)
 
    ::oInterface:setDataNew(::oDataNew:getDataNew(), .f.)
    ::oInterface:setDataEdit(::oDataEdit:getDataEdit(), .f.)
    ::oInterface:setDataDetail(::oDataDetail:getDataDetail(), .f.)
    ::oInterface:setDataView(::oDataView:getDataView())
return

/*/{Protheus.doc} getContract
Método responsável por retornar o contrato da interface da rotina de Operações.

@autor thiago.rover
@since 12/08/2026

@return json, Retorna o contrato da interface da rotina de Operações.
/*/
Method getContract() as json class PCPA117
Return ::oInterface:getContract()
