namespace totvs.manufatura.grupodeengenheiros.interface

@totvsFrameworkStructureInterface(lookup=.F., country="ALL", description="Grupo de Engenheiros")

/*/{Protheus.doc} PCPA204
Classe PCPA204 responsável por definir a interface da rotina de Grupo de Engenheiros.

@author thiago.rover
@since 14/08/2026
/*/
class PCPA204
    private data oInterface  as object
    private data oDataNew    as object
    private data oDataEdit   as object
    private data oDataDetail as object
    private data oDataView   as object
 
    public method new() as object
    public method setInterface()
    public method getContract() as json
EndClass

/*/{Protheus.doc} new
Método construtor da classe PCPA204.

@autor thiago.rover
@since 14/08/2026

@return self, Retorna a instância da classe PCPA204.
/*/
Method new() as object class PCPA204
Return self

/*/{Protheus.doc} setInterface
Método responsável por definir a interface da rotina de Grupo de Engenheiros.

@autor thiago.rover
@since 14/08/2026
/*/
Method setInterface() class PCPA204

    Local cId    := "PCPA204"                                           as character
    Local cModel := "totvs.manufatura.grupodeengenheiros.model.PCPA204" as character

    // STR0001 - Grupo de Engenheiros
    ::oInterface := totvs.framework.structure.interface.BuildContract():new(cId)
    ::oInterface:setTitle(STR0001)
    ::oInterface:setModelId(cModel, .T.)
    ::oInterface:setVersion("1.0")

    // Construção da interface
    ::oDataNew    := totvs.framework.structure.interface.BuildDataNew():new(cId+"New", cModel)
    ::oDataEdit   := totvs.framework.structure.interface.BuildDataEdit():new(cId+"Edit", cModel)
    ::oDataView   := totvs.framework.structure.interface.BuildDataView():new(cId+"View", cModel)
    ::oDataDetail := totvs.framework.structure.interface.BuildDataDetail():new(cId+"Detail", cModel)

    // Seta os títulos da interface
    ::oDataNew:setTitle(STR0002)    // STR0002 - Incluir Grupo de Engenheiros
    ::oDataEdit:setTitle(STR0003)   // STR0003 - Editar Grupo de Engenheiros
    ::oDataView:setTitle(STR0001)   // STR0001 - Grupo de Engenheiros
    ::oDataDetail:setTitle(STR0005) // STR0005 - Detalhes Grupo de Engenheiros

    // Restringe os campos do cabeçalho do formulário
    ::oDataNew:addInclude({"GL_COD"   , "GL_DESC"}, "SGL")
    ::oDataEdit:addInclude({"GL_COD"  , "GL_DESC"}, "SGL")
    ::oDataView:addInclude({"GL_COD"  , "GL_DESC"}, "SGL")
    ::oDataDetail:addInclude({"GL_COD", "GL_DESC"}, "SGL")

    ::oInterface:setDataNew(::oDataNew:getDataNew(), .F.)
    ::oInterface:setDataEdit(::oDataEdit:getDataEdit(), .F.)
    ::oInterface:setDataDetail(::oDataDetail:getDataDetail(), .F.)
    ::oInterface:setDataView(::oDataView:getDataView())
return

/*/{Protheus.doc} getContract
Método responsável por retornar o contrato da interface da rotina de Grupo de Engenheiros.

@autor thiago.rover
@since 14/08/2026

@return json, Retorna o contrato da interface da rotina de Grupo de Engenheiros.
/*/
Method getContract() as json class PCPA204
Return ::oInterface:getContract()
