#include "totvs.ch"
#include "msobject.ch"
#include "totvs.framework.treports.integratedprovider.th"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "manufacturing.pcp.crp.alocacaorecurso.ch"

#DEFINE HZ7_TIPO_ALTERNATIVO   "2"
#DEFINE HZ7_TIPO_DESDOBRAMENTO "3"

#DEFINE VM_TIPO_FINALIZACAO 3
#DEFINE VM_TIPO_REMOCAO     4

namespace totvs.protheus.sigapcp.treportsintegratedprovider

@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGAPCP", tables="SMF,SVM,T4X,SC2,SG2,SHY,SH1,SHB,SB1,HWF,HZK,HZJ,SH4,HZ7,HZL", name="Análise Programação por Recurso", country="ALL", initialRelease="12.1.2310", customTables="SMF,SVM,T4X,SC2,SG2,SHY,SH1,SHB,SB1,HWF,HZK,HZJ,SH4,HZ7,HZL")

/*/{Protheus.doc} AnaliseProgramacaoPorRecursoTReportsBusinessObject
Classe para criação do Objeto de Negócio para a Análise Programação por Recurso

@author breno.ferreira
@since 01/04/2024
@version 1.0
/*/
Class AnaliseProgramacaoPorRecursoTReportsBusinessObject From totvs.framework.treports.integratedprovider.IntegratedProvider
    Public Method new() as object
    Public Method getData() as object
    Public Method getSchema() as object
EndClass

/*/{Protheus.doc} new
Método de instância da classe

@return object: self

@author breno.ferreira
@since 01/04/2024
@version 1.0
/*/
Method new() as object Class AnaliseProgramacaoPorRecursoTReportsBusinessObject
    _Super:new()
    //Define a Área
    self:appendArea(STR0001)//STR0001 = "Manufatura"

    //Define o nome do Objeto de Negócio
    self:setDisplayName(STR0002)//STR0002 - "Análise Programação por Recurso"

    //Define a descrição do Objeto de Negócio
    self:setDescription(STR0003)//STR0003 - "Informações das alocações realizadas nos recursos pela programação do CRP"

    self:setPergunte("PCP152AREC") //Indica o pergunte que será utilizado no relatório
Return self

/*/{Protheus.doc} getData
Retorna os dados do objeto de negócio

@param nPage, numérico, indica a página atual do relatório
@param oFilter, objeto, contém o filtro do TReports
@return object: self:oData
@author breno.ferreira
@since 01/04/2024
@version 1.0
/*/
Method getData(nPage as numeric, oFilter as object) as object Class AnaliseProgramacaoPorRecursoTReportsBusinessObject
    Local aStruct        := {}                 as array
    Local aTables        := {}                 as array
    Local cAlias         := ""                 as character
    Local cCtrabAte      := ""                 as character
    Local cCtrabDe       := ""                 as character
    Local cDataAnterior  := ""                 as character
    Local cDataFinal     := ""                 as character
    Local cDataInicial   := ""                 as character
    Local cDataRealFinal := ""                 as character
    Local cFerramAlt     := ""                 as character
    Local cMsg           := ""                 as character
    Local cMsgDesc       := ""                 as character
    Local cOpAte         := ""                 as character
    Local cOpDe          := ""                 as character
    Local cPeriodo       := ""                 as character
    Local cProg          := ""                 as character
    Local cQueryFilter   := ""                 as character
    Local cQueryOrig     := ""                 as character
    Local cRecAlt        := ""                 as character
    Local cRecAte        := ""                 as character
    Local cRecDe         := ""                 as character
    Local cRecursoAnt    := ""                 as character
    Local cRegAux        := ""                 as character
    Local cSituacao      := ""                 as character
    Local cTipo          := ""                 as character
    Local dDataAte                             as date
    Local dDataDe                              as date
    Local jParams        := Nil                as json
    Local nEfetivadas    := 2                  as numeric
    Local nExibe         := 0                  as numeric
    Local nPosParam      := 0                  as numeric
    Local nX             := 0                  as numeric
    Local oExec          := Nil                as object
    Local oHoras         := JsonObject():New() as object
    Local ojItems        := Nil                as json
    Local oReturn        := Nil                as object

    jParams := oFilter:getParameters() //metodo para retorno do json dos parâmetros

    cProg       := jParams["MV_PAR01"][1] //Programação
    cRecDe      := pcpGetParametroSV(jParams, "MV_PAR02", .F.) //Recurso de
    cRecAte     := pcpGetParametroSV(jParams, "MV_PAR03", .T., "HZ7_RECURS") //Recurso até
    cCtrabDe    := pcpGetParametroSV(jParams, "MV_PAR04", .F.) //Centro de Trabalho de
    cCtrabAte   := pcpGetParametroSV(jParams, "MV_PAR05", .T., "HZ7_CTRAB") //Centro de Trabalho até
    dDataDe     := pcpconvdat(jParams["MV_PAR06"][1], 1) //Data Alocação de
    dDataAte    := pcpconvdat(jParams["MV_PAR07"][1], 1) //Data Alocação até
    nEfetivadas := jParams["MV_PAR08"][1] //Exibe Ordens Efetivadas
    cOpDe       := pcpGetParametroSV(jParams, "MV_PAR10", .F.) //Ordem de Produção de
    cOpAte      := pcpGetParametroSV(jParams, "MV_PAR11", .T., "MF_OP") //Ordem de Produção até

    If !validaParam(jParams, @cMsg, @cMsgDesc, @cDataInicial, @cDataFinal, @cDataRealFinal)
        self:setErrorStatus(400, cMsg, cMsgDesc)
        Return Self:oData
    EndIf

    aAdd(aTables, {"C2_","SC2."})
    aAdd(aTables, {"B1_","SB1."})
    aAdd(aTables, {"MF_" ,"SMF."})
    aAdd(aTables, {"VM_" ,"' ' "})
    aAdd(aTables, {"T4X_","T4X."})
    aAdd(aTables, {"G2_" ,"SG2."})
    aAdd(aTables, {"HY_" ,"SHY."})
    aAdd(aTables, {"H1_" ,"SH1."})
    aAdd(aTables, {"HB_" ,"SHB."})
    aAdd(aTables, {"HWF_","HWF."})
    aAdd(aTables, {"HZK_","' ' "})
    aAdd(aTables, {"HZJ_","' ' "})
    aAdd(aTables, {"H4_" ,"SH4."})
    aAdd(aTables, {"HZL_","HZL."})
    aAdd(aTables, {"HZ7_","HZ7."})

    cPeriodo := cDataInicial + " - " + cDataFinal

    cQueryOrig += " SELECT DISTINCT T4X.T4X_PROG programacao, "
    cQueryOrig +=                 " HZ7.HZ7_RECURS recurso, "
    cQueryOrig +=                 " COALESCE(HZJ.HZJ_FERRAM, '') ferramentas, "
    cQueryOrig +=                 " COALESCE(SH4.H4_DESCRI,'') descriFerr, "
    cQueryOrig +=                 " SH1.H1_DESCRI descriRec, "
    cQueryOrig +=                 " HZ7.HZ7_CTRAB centTrabalho, "
    cQueryOrig +=                 " SHB.HB_NOME descriCTrab, "
    cQueryOrig +=                 " SMF.MF_OPER operacao, "
    cQueryOrig +=                 " COALESCE(SHY.HY_DESCRI,SG2.G2_DESCRI) descriOper, "
    cQueryOrig +=                 " SMF.MF_OP ordemProducao, "
    cQueryOrig +=                 " SMF.MF_SALDO quantidade, "
    cQueryOrig +=                 " SVM.VM_INICIO horaInicio, "
    cQueryOrig +=                 " SVM.VM_FIM horaFim, "
    cQueryOrig +=                 " SVM.VM_DATA data, "
    cQueryOrig +=                 " T4X.T4X_STATUS statusProg, "
    cQueryOrig +=                 " T4X.T4X_DESCRI descriProg, "
    cQueryOrig +=                 " SC2.C2_PRODUTO produto, "
    cQueryOrig +=                 " SB1.B1_DESC descriProd, "
    cQueryOrig +=                 " CASE SC2.C2_STATUS "
    cQueryOrig +=                     " WHEN 'S' THEN '1' "
    cQueryOrig +=                     " ELSE SC2.C2_TPOP "
    cQueryOrig +=                 " END situacao, "
    cQueryOrig +=                 " SVM.VM_TEMPO tempo, "
    cQueryOrig +=                 " SVM.VM_TIPO tipo, "
    cQueryOrig +=                 " CASE "
    cQueryOrig +=                     " WHEN SVM.VM_TIPO = 1 THEN SVM.VM_TEMPO ELSE 0 "
    cQueryOrig +=                 " END setup, "
    cQueryOrig +=                 " CASE "
    cQueryOrig +=                     " WHEN SVM.VM_TIPO = 3 THEN SVM.VM_TEMPO ELSE 0 "
    cQueryOrig +=                 " END finalizacao, "
    cQueryOrig +=                 " ' ' progEfet, "
    cQueryOrig +=                 " HZ7.HZ7_TIPO recurAlter, "
    cQueryOrig +=                 " HZJ.HZJ_ALTERN ferramAlter, "
    cQueryOrig +=                 " CASE "
    cQueryOrig +=                     " WHEN EXISTS (SELECT 1 "
    cQueryOrig +=                                    " FROM " + RetSqlName("SMT") + " SMT "
    cQueryOrig +=                                   " WHERE SMT.MT_FILIAL  = ? "
    cQueryOrig +=                                     " AND SMT.MT_PROG    = SMF.MF_PROG "
    cQueryOrig +=                                     " AND SMT.MT_RECURSO = SMF.MF_RECURSO "
    cQueryOrig +=                                     " AND SMT.D_E_L_E_T_ = ' ') THEN 1 "
    cQueryOrig +=                     " ELSE 0 "
    cQueryOrig +=                 " END recInProg "

    PcpInCposPerson(aStruct, @cQueryOrig, self:getCustomFields(), .T., .T.,,aTables)

    cQueryOrig +=   " FROM " + RetSqlName("SMF") + " SMF "
    cQueryOrig +=  " INNER JOIN " + RetSqlName("HZ7") + " HZ7 "
    cQueryOrig +=     " ON HZ7.HZ7_FILIAL = ? "
    cQueryOrig +=    " AND HZ7.HZ7_PROG   = SMF.MF_PROG "
	cQueryOrig +=    " AND HZ7.HZ7_ID     = SMF.MF_ID "
    cQueryOrig +=    " AND HZ7.HZ7_RECURS >= ? "
    cQueryOrig +=    " AND HZ7.HZ7_RECURS <= ? "
    cQueryOrig +=    " AND HZ7.HZ7_CTRAB  >= ? "
    cQueryOrig +=    " AND HZ7.HZ7_CTRAB  <= ? "
	cQueryOrig +=    " AND HZ7.D_E_L_E_T_ = ' ' "
    cQueryOrig +=  " INNER JOIN " + RetSqlName("SVM") + " SVM "
    cQueryOrig +=     " ON SVM.VM_FILIAL  = ? "
	cQueryOrig +=    " AND SVM.VM_ID      = HZ7.HZ7_ID "
	cQueryOrig +=    " AND SVM.VM_SEQRECU = HZ7.HZ7_SEQ "
    cQueryOrig +=    " AND SVM.VM_PROG    = ? "
    cQueryOrig +=    " AND SVM.VM_DATA   >= ? "
    cQueryOrig +=    " AND SVM.VM_DATA   <= ? "
    cQueryOrig +=    " AND SVM.D_E_L_E_T_ = ' ' "
	cQueryOrig +=   " LEFT JOIN " + RetSqlName("HZK") + " HZK "
	cQueryOrig +=     " ON HZK.HZK_FILIAL = ? "
	cQueryOrig +=    " AND HZK.HZK_PROG   = SVM.VM_PROG "
	cQueryOrig +=    " AND HZK.HZK_IDOPER = SVM.VM_ID "
	cQueryOrig +=    " AND HZK.HZK_SEQALO = SVM.VM_SEQ "
    cQueryOrig +=    " AND HZK.HZK_SEQREC = SVM.VM_SEQRECU "
	cQueryOrig +=    " AND HZK.D_E_L_E_T_ = ' ' "
	cQueryOrig +=   " LEFT JOIN " + RetSqlName("HZJ") + " HZJ "
	cQueryOrig +=     " ON HZJ.HZJ_FILIAL = ? "
	cQueryOrig +=    " AND HZJ.HZJ_PROG   = HZK.HZK_PROG "
	cQueryOrig +=    " AND HZJ.HZJ_ID     = HZK.HZK_ID "
	cQueryOrig +=    " AND HZJ.D_E_L_E_T_ = ' ' "
	cQueryOrig +=   " LEFT JOIN " + RetSqlName("SH4") + " SH4 "
	cQueryOrig +=     " ON SH4.H4_FILIAL = ? "
	cQueryOrig +=    " AND SH4.H4_CODIGO = HZJ.HZJ_FERRAM "
	cQueryOrig +=    " AND SH4.D_E_L_E_T_ = ' ' "
    cQueryOrig +=  " INNER JOIN " + RetSqlName("T4X") + " T4X "
    cQueryOrig +=     " ON T4X.T4X_FILIAL = ? "
    cQueryOrig +=    " AND T4X.T4X_PROG   = ? "
    cQueryOrig +=    " AND T4X.D_E_L_E_T_ = ' ' "
    cQueryOrig +=  " INNER JOIN " + RetSqlName("SC2") + " SC2 "
    cQueryOrig +=     " ON SC2.C2_FILIAL  = ? "
    cQueryOrig +=    " AND " + PCPQrySC2("SC2", "SMF.MF_OP")
    cQueryOrig +=    " AND SC2.D_E_L_E_T_ = ' ' "
    cQueryOrig +=   " LEFT JOIN " + RetSqlName("SHY") + " SHY "
	cQueryOrig +=     " ON SHY.HY_FILIAL  = ? "
	cQueryOrig +=    " AND SHY.HY_OP      = SMF.MF_OP "
	cQueryOrig +=    " AND SHY.HY_ROTEIRO = SMF.MF_ROTEIRO "
	cQueryOrig +=    " AND SHY.HY_OPERAC  = SMF.MF_OPER "
	cQueryOrig +=    " AND SHY.HY_TEMPAD  <> 0 "
	cQueryOrig +=    " AND SHY.D_E_L_E_T_ = ' ' "
	cQueryOrig +=   " LEFT JOIN " + RetSqlName("SG2") + " SG2 "
	cQueryOrig +=     " ON SG2.G2_FILIAL  = ? "
	cQueryOrig +=    " AND SG2.G2_CODIGO  = SMF.MF_ROTEIRO "
	cQueryOrig +=    " AND SG2.G2_OPERAC  = SMF.MF_OPER "
	cQueryOrig +=    " AND SG2.G2_PRODUTO = SC2.C2_PRODUTO "
	cQueryOrig +=    " AND SHY.HY_OP IS NULL "
	cQueryOrig +=    " AND SG2.D_E_L_E_T_ = ' ' "
	cQueryOrig +=  " INNER JOIN " + RetSqlName("SB1") + " SB1 "
	cQueryOrig +=     " ON SB1.B1_FILIAL  = ? "
	cQueryOrig +=    " AND SB1.B1_COD     = SC2.C2_PRODUTO "
	cQueryOrig +=    " AND SB1.D_E_L_E_T_ = ' ' "
	cQueryOrig +=  " INNER JOIN " + RetSqlName("SH1") + " SH1 "
	cQueryOrig +=     " ON SH1.H1_FILIAL  = ? "
	cQueryOrig +=    " AND SH1.H1_CODIGO  = HZ7.HZ7_RECURS "
	cQueryOrig +=    " AND SH1.D_E_L_E_T_ = ' ' "
	cQueryOrig +=   " LEFT JOIN " + RetSqlName("SHB") + " SHB "
	cQueryOrig +=     " ON SHB.HB_FILIAL  = ? "
	cQueryOrig +=    " AND SHB.HB_COD     = HZ7.HZ7_CTRAB "
	cQueryOrig +=    " AND SHB.D_E_L_E_T_ = ' ' "
    cQueryOrig +=  " WHERE SMF.MF_FILIAL = ? "
    cQueryOrig +=    " AND SMF.MF_PROG   = ? "
    cQueryOrig +=    " AND SMF.MF_OP    >= ? "
    cQueryOrig +=    " AND SMF.MF_OP    <= ? "
	cQueryOrig +=    " AND SMF.D_E_L_E_T_ = ' ' "
    If nEfetivadas == 1
        cQueryOrig +=  " UNION ALL "
        cQueryOrig += " SELECT DISTINCT T4X.T4X_PROG programacao, "
        cQueryOrig +=                 " HWF.HWF_RECURS recurso, "
        cQueryOrig +=                 " COALESCE(HZL.HZL_FERRAM,'') ferramentas, "
        cQueryOrig +=                 " COALESCE(SH4.H4_DESCRI,'') descriFerr, "
        cQueryOrig +=                 " SH1.H1_DESCRI descriRec, "
        cQueryOrig +=                 " HWF.HWF_CTRAB centTrabalho, "
        cQueryOrig +=                 " SHB.HB_NOME descriCTrab, "
        cQueryOrig +=                 " HWF.HWF_OPER operacao, "
        cQueryOrig +=                 " COALESCE(SHY.HY_DESCRI,SG2.G2_DESCRI) descriOper, "
        cQueryOrig +=                 " HWF.HWF_OP ordemProducao, "
        If SuperGetMV("MV_PERDINF") == .F.
            cQueryOrig +=             " SC2.C2_QUANT - SC2.C2_QUJE - SC2.C2_PERDA quantidade, "
        Else
            cQueryOrig +=             " SC2.C2_QUANT - SC2.C2_QUJE quantidade, "
        EndIf
        cQueryOrig +=                 " HWF.HWF_HRINI horaInicio, "
        cQueryOrig +=                 " HWF.HWF_HRFIM horaFim, "
        cQueryOrig +=                 " HWF.HWF_DATA data, "
        cQueryOrig +=                 " T4X.T4X_STATUS statusProg, "
        cQueryOrig +=                 " T4X.T4X_DESCRI descriProg, "
        cQueryOrig +=                 " SC2.C2_PRODUTO produto, "
        cQueryOrig +=                 " SB1.B1_DESC descriProd, "
        cQueryOrig +=                 " HWF.HWF_STATUS situacao, "
        cQueryOrig +=                 " HWF.HWF_TEMPOT tempo, "
        cQueryOrig +=                 " HWF.HWF_TIPO tipo, "
        cQueryOrig +=                 " CASE "
        cQueryOrig +=                 "      WHEN HWF.HWF_TIPO = 1 THEN HWF.HWF_TEMPOT ELSE 0 "
        cQueryOrig +=                 " END setup, "
        cQueryOrig +=                 " CASE "
        cQueryOrig +=                 "      WHEN HWF.HWF_TIPO = 3 THEN HWF.HWF_TEMPOT ELSE 0 "
        cQueryOrig +=                 " END finalizacao, "
        cQueryOrig +=                 " HWF.HWF_PROG progEfet, "
        cQueryOrig +=                 " HWF.HWF_RECALT recurAlter, "
        cQueryOrig +=                 " HZL.HZL_ALTERN ferramAlter, "
        cQueryOrig +=                 " CASE "
        cQueryOrig +=                     " WHEN EXISTS (SELECT 1 "
        cQueryOrig +=                                    " FROM " + RetSqlName("SMT") + " SMT "
        cQueryOrig +=                                   " WHERE SMT.MT_FILIAL  = ? "
        cQueryOrig +=                                     " AND SMT.MT_PROG    = ? "
        cQueryOrig +=                                     " AND SMT.MT_RECURSO = HWF.HWF_RECURS "
        cQueryOrig +=                                     " AND SMT.D_E_L_E_T_ = ' ') THEN 1 "
        cQueryOrig +=                     " ELSE 0 "
        cQueryOrig +=                 " END recInProg "

        PcpInCposPerson(aStruct, @cQueryOrig, self:getCustomFields(), .T., .T.,,aTables)

        cQueryOrig +=   " FROM " + RetSqlName("HWF") + " HWF "
        cQueryOrig +=   " LEFT JOIN " + RetSqlName("HZL") + " HZL "
        cQueryOrig +=     " ON HZL.HZL_FILIAL = ? "
        cQueryOrig +=    " AND HZL.HZL_PROG   = HWF.HWF_PROG "
        cQueryOrig +=    " AND HZL.HZL_OP     = HWF.HWF_OP "
		cQueryOrig +=    " AND HZL.HZL_OPER   = HWF.HWF_OPER "
		cQueryOrig +=    " AND HZL.HZL_RECURS = HWF.HWF_RECURS "
		cQueryOrig +=    " AND HWF.HWF_TIPO NOT IN (?) "
        cQueryOrig +=    " AND HZL.D_E_L_E_T_ = ' ' "
        cQueryOrig +=   " LEFT JOIN " + RetSqlName("SH4") + " SH4 "
        cQueryOrig +=     " ON SH4.H4_FILIAL = ? "
        cQueryOrig +=    " AND SH4.H4_CODIGO = HZL.HZL_FERRAM "
        cQueryOrig +=    " AND SH4.D_E_L_E_T_ = ' ' "
        cQueryOrig +=  " INNER JOIN " + RetSqlName("T4X") + " T4X "
        cQueryOrig +=     " ON T4X.T4X_FILIAL = ? "
        cQueryOrig +=    " AND T4X.T4X_PROG   = ? "
        cQueryOrig +=    " AND T4X.D_E_L_E_T_ = ' ' "
        cQueryOrig +=  " INNER JOIN " + RetSqlName("SC2") + " SC2 "
        cQueryOrig +=     " ON SC2.C2_FILIAL  = ? "
        cQueryOrig +=    " AND " + PCPQrySC2("SC2", "HWF.HWF_OP")
        cQueryOrig +=    " AND SC2.D_E_L_E_T_ = ' ' "
        cQueryOrig +=   " LEFT JOIN " + RetSqlName("SHY") + " SHY "
	    cQueryOrig +=     " ON SHY.HY_FILIAL  = ? "
	    cQueryOrig +=    " AND SHY.HY_OP      = HWF.HWF_OP "
	    cQueryOrig +=    " AND SHY.HY_ROTEIRO = HWF.HWF_ROTEIR "
	    cQueryOrig +=    " AND SHY.HY_OPERAC  = HWF.HWF_OPER "
	    cQueryOrig +=    " AND SHY.HY_TEMPAD  <> 0 "
	    cQueryOrig +=    " AND SHY.D_E_L_E_T_ = ' ' "
	    cQueryOrig +=   " LEFT JOIN " + RetSqlName("SG2") + " SG2 "
	    cQueryOrig +=     " ON SG2.G2_FILIAL  = ? "
	    cQueryOrig +=    " AND SG2.G2_CODIGO  = HWF.HWF_ROTEIR "
	    cQueryOrig +=    " AND SG2.G2_OPERAC  = HWF.HWF_OPER "
	    cQueryOrig +=    " AND SG2.G2_PRODUTO = SC2.C2_PRODUTO "
	    cQueryOrig +=    " AND SHY.HY_OP IS NULL "
	    cQueryOrig +=    " AND SG2.D_E_L_E_T_ = ' ' "
	    cQueryOrig +=  " INNER JOIN " + RetSqlName("SB1") + " SB1 "
	    cQueryOrig +=     " ON SB1.B1_FILIAL  = ? "
	    cQueryOrig +=    " AND SB1.B1_COD     = SC2.C2_PRODUTO "
	    cQueryOrig +=    " AND SB1.D_E_L_E_T_ = ' ' "
	    cQueryOrig +=  " INNER JOIN " + RetSqlName("SH1") + " SH1 "
	    cQueryOrig +=     " ON SH1.H1_FILIAL  = ? "
	    cQueryOrig +=    " AND SH1.H1_CODIGO  = HWF.HWF_RECURS "
	    cQueryOrig +=    " AND SH1.D_E_L_E_T_ = ' ' "
	    cQueryOrig +=   " LEFT JOIN " + RetSqlName("SHB") + " SHB "
	    cQueryOrig +=     " ON SHB.HB_FILIAL  = ? "
	    cQueryOrig +=    " AND SHB.HB_COD     = HWF.HWF_CTRAB "
	    cQueryOrig +=    " AND SHB.D_E_L_E_T_ = ' ' "
        cQueryOrig +=   " LEFT JOIN " + RetSqlName("SMF") + " SMF "
        cQueryOrig +=     " ON SMF.MF_FILIAL  = ? "
        cQueryOrig +=    " AND SMF.MF_PROG    = ? "
        cQueryOrig +=    " AND SMF.MF_OP      = HWF.HWF_OP "
        cQueryOrig +=    " AND SMF.MF_OPER    = HWF.HWF_OPER "
        cQueryOrig +=    " AND SMF.D_E_L_E_T_ = ' ' "
        cQueryOrig +=   " LEFT JOIN " + RetSqlName("HZ7") + " HZ7 "
        cQueryOrig +=     " ON HZ7.HZ7_FILIAL = ? "
        cQueryOrig +=    " AND HZ7.HZ7_PROG   = SMF.MF_PROG "
	    cQueryOrig +=    " AND HZ7.HZ7_ID     = SMF.MF_ID "
	    cQueryOrig +=    " AND HZ7.HZ7_RECURS = SMF.MF_RECURSO "
	    cQueryOrig +=    " AND HZ7.D_E_L_E_T_ = ' ' "
        cQueryOrig +=  " WHERE HWF.HWF_FILIAL  = ? "
        cQueryOrig +=    " AND HWF.HWF_RECURS >= ? "
        cQueryOrig +=    " AND HWF.HWF_RECURS <= ? "
        cQueryOrig +=    " AND HWF.HWF_CTRAB  >= ? "
        cQueryOrig +=    " AND HWF.HWF_CTRAB  <= ? "
        cQueryOrig +=    " AND HWF.HWF_DATA   >= ? "
        cQueryOrig +=    " AND HWF.HWF_DATA   <= ? "
        cQueryOrig +=    " AND HWF.HWF_OP     >= ? "
        cQueryOrig +=    " AND HWF.HWF_OP     <= ? "
        cQueryOrig +=    " AND HWF.HWF_STATUS  = '1' "
        cQueryOrig +=    " AND NOT EXISTS (SELECT 1 "
        cQueryOrig +=                      " FROM " + RetSqlName("SMF") + " SMF "
        cQueryOrig +=                     " WHERE SMF.MF_FILIAL  = ? "
        cQueryOrig +=                       " AND SMF.MF_PROG    = ? "
        cQueryOrig +=                       " AND SMF.MF_OP      = HWF.HWF_OP "
        cQueryOrig +=                       " AND SMF.MF_OPER    = HWF.HWF_OPER "
        cQueryOrig +=                       " AND SMF.D_E_L_E_T_ = ' ') "
        cQueryOrig +=    " AND HWF.D_E_L_E_T_  = ' ' "
    EndIf

    If oFilter:hasFilter()
        cQueryFilter := " SELECT Aux.programacao, "
        cQueryFilter +=        " Aux.recurso, "
        cQueryFilter +=        " Aux.ferramentas, "
        cQueryFilter +=        " Aux.descriFerr, "
        cQueryFilter +=        " Aux.descriRec, "
        cQueryFilter +=        " Aux.centTrabalho, "
        cQueryFilter +=        " Aux.descriCTrab, "
        cQueryFilter +=        " Aux.operacao, "
        cQueryFilter +=        " Aux.descriOper, "
        cQueryFilter +=        " Aux.ordemProducao, "
        cQueryFilter +=        " Aux.quantidade, "
        cQueryFilter +=        " Aux.horaInicio, "
        cQueryFilter +=        " Aux.horaFim, "
        cQueryFilter +=        " Aux.data, "
        cQueryFilter +=        " Aux.statusProg, "
        cQueryFilter +=        " Aux.descriProg, "
        cQueryFilter +=        " Aux.produto, "
        cQueryFilter +=        " Aux.descriProd, "
        cQueryFilter +=        " Aux.situacao, "
        cQueryFilter +=        " Aux.tempo, "
        cQueryFilter +=        " Aux.tipo, "
        cQueryFilter +=        " Aux.setup, "
        cQueryFilter +=        " Aux.finalizacao, "
        cQueryFilter +=        " Aux.progEfet, "
        cQueryFilter +=        " Aux.recurAlter, "
        cQueryFilter +=        " Aux.ferramAlter, "
        cQueryFilter +=        " Aux.recInProg "

        PcpInCposPerson(aStruct, @cQueryFilter, self:getCustomFields(), .T., .T.,,aTables)

        cQueryFilter +=   " FROM (" + cQueryOrig + ") AS Aux "
        cQueryFilter +=  " WHERE " + oFilter:getSQLExpression()
        cQueryFilter +=  " ORDER BY Aux.recurso, Aux.data, Aux.horaInicio "

        cQueryOrig := cQueryFilter
    Else
        cQueryOrig +=  " ORDER BY recurso, data, horaInicio "
    EndIf

    nPosParam := 1

    oExec := FwExecStatement():New(cQueryOrig)

    oExec:setString(nPosParam++, xFilial("SMT"))
    oExec:setString(nPosParam++, xFilial("HZ7"))
    oExec:setString(nPosParam++, cRecDe)
    oExec:setString(nPosParam++, cRecAte)
    oExec:setString(nPosParam++, cCtrabDe)
    oExec:setString(nPosParam++, cCtrabAte)
    oExec:setString(nPosParam++, xFilial("SVM"))
    oExec:setString(nPosParam++, cProg)
    oExec:setDate(nPosParam++, dDataDe)
    oExec:setDate(nPosParam++, dDataAte)
    oExec:setString(nPosParam++, xFilial("HZK"))
    oExec:setString(nPosParam++, xFilial("HZJ"))
    oExec:setString(nPosParam++, xFilial("SH4"))
    oExec:setString(nPosParam++, xFilial("T4X"))
    oExec:setString(nPosParam++, cProg)
    oExec:setString(nPosParam++, xFilial("SC2"))
    oExec:setString(nPosParam++, xFilial("SHY"))
    oExec:setString(nPosParam++, xFilial("SG2"))
    oExec:setString(nPosParam++, xFilial("SB1"))
    oExec:setString(nPosParam++, xFilial("SH1"))
    oExec:setString(nPosParam++, xFilial("SHB"))
    oExec:setString(nPosParam++, xFilial("SMF"))
    oExec:setString(nPosParam++, cProg)
    oExec:setString(nPosParam++, cOpDe)
    oExec:setString(nPosParam++, cOpAte)
    If nEfetivadas == 1
        oExec:setString(nPosParam++, xFilial("SMT"))
        oExec:setString(nPosParam++, cProg)
        oExec:setString(nPosParam++, xFilial("HZL"))
        oExec:setIn(nPosParam++, {VM_TIPO_FINALIZACAO, VM_TIPO_REMOCAO})
        oExec:setString(nPosParam++, xFilial("SH4"))
        oExec:setString(nPosParam++, xFilial("T4X"))
        oExec:setString(nPosParam++, cProg)
        oExec:setString(nPosParam++, xFilial("SC2"))
        oExec:setString(nPosParam++, xFilial("SHY"))
        oExec:setString(nPosParam++, xFilial("SG2"))
        oExec:setString(nPosParam++, xFilial("SB1"))
        oExec:setString(nPosParam++, xFilial("SH1"))
        oExec:setString(nPosParam++, xFilial("SHB"))
        oExec:setString(nPosParam++, xFilial("SMF"))
        oExec:setString(nPosParam++, cProg)
        oExec:setString(nPosParam++, xFilial("HZ7"))
        oExec:setString(nPosParam++, xFilial("HWF"))
        oExec:setString(nPosParam++, cRecDe)
        oExec:setString(nPosParam++, cRecAte)
        oExec:setString(nPosParam++, cCtrabDe)
        oExec:setString(nPosParam++, cCtrabAte)
        oExec:setDate(nPosParam++, dDataDe)
        oExec:setDate(nPosParam++, dDataAte)
        oExec:setString(nPosParam++, cOpDe)
        oExec:setString(nPosParam++, cOpAte)
        oExec:setString(nPosParam++, xFilial("SMF"))
        oExec:setString(nPosParam++, cProg)
    EndIf

    cAlias := oExec:OpenAlias()

    While (cAlias)->(!Eof())
        If cRecursoAnt != (cAlias)->recurso
            cRecursoAnt   := (cAlias)->recurso
            cDataAnterior := ""

            If (cAlias)->recInProg == 1
                oReturn := P152UTIREC(cProg, Nil, Nil, dDataDe, dDataAte, (cAlias)->recurso, cCtrabDe, cCtrabAte, .T., .F.)
            EndIf
        EndIf

        cData := pcpconvdat((cAlias)->data, 4)
        If (cAlias)->recInProg == 1 .And. cData != cDataAnterior
            cDataAnterior := cData

            oHoras["capacidade"     ] := oReturn["items"][1]["utilizacao"]["datas"][P152UtiDef("IND_CAPACIDADE"     )][cData]
            oHoras["disponibilidade"] := oReturn["items"][1]["utilizacao"]["datas"][P152UtiDef("IND_DISPONIBILIDADE")][cData]
            oHoras["efetivadas"     ] := oReturn["items"][1]["utilizacao"]["datas"][P152UtiDef("IND_EFETIVADAS"     )][cData]
            oHoras["programadas"    ] := oReturn["items"][1]["utilizacao"]["datas"][P152UtiDef("IND_PROGRAMADAS"    )][cData]
            oHoras["apontadas"      ] := oReturn["items"][1]["utilizacao"]["datas"][P152UtiDef("IND_APONTADAS"      )][cData]
            oHoras["saldo"          ] := oReturn["items"][1]["utilizacao"]["datas"][P152UtiDef("IND_SALDO"          )][cData]
        Else
            oHoras["capacidade"     ] := "00:00"
            oHoras["disponibilidade"] := "00:00"
            oHoras["efetivadas"     ] := "00:00"
            oHoras["programadas"    ] := "00:00"
            oHoras["apontadas"      ] := "00:00"
            oHoras["saldo"          ] := "00:00"
        Endif

        If (cAlias)->situacao == '1'
            cSituacao := STR0020 //STR0020 - 'Efetivada'

            If !Empty((cAlias)->progEfet)
                cSituacao += " - " + (cAlias)->progEfet
            EndIf
        ElseIf (cAlias)->situacao == 'F'
            cSituacao := STR0016 //STR0016 - 'Firme'
        ElseIf (cAlias)->situacao == 'P'
            cSituacao := STR0017 //STR0017 - 'Prevista'
        EndIf

        If (cAlias)->tipo == 1
            cTipo := STR0023 //"Setup"
        ElseIf (cAlias)->tipo == 2
            cTipo := STR0024 //"Produção"
        ElseIf (cAlias)->tipo == 3
            cTipo := STR0025 //"Finalização"
        ElseIf (cAlias)->tipo == 4
            cTipo := STR0026 // "Remoção"
        EndIf

        If cRegAux == (cAlias)->(ordemProducao + produto + operacao + horaInicio + horaFim + data)
            nExibe := 1
            cRegAux := (cAlias)->(ordemProducao + produto + operacao + horaInicio + horaFim + data)
        Else
            nExibe := 0
            cRegAux := (cAlias)->(ordemProducao + produto + operacao + horaInicio + horaFim + data)
        Endif

        cRecAlt := ""
        If !Empty((cAlias)->recurAlter)
            cRecAlt := STR0029 //"Não"
            If (cAlias)->recurAlter == HZ7_TIPO_ALTERNATIVO
                cRecAlt := STR0028 //"Sim"
            EndIf
            If (cAlias)->recurAlter == HZ7_TIPO_DESDOBRAMENTO
                cRecAlt := STR0059 //"Desdobrado"
            EndIf
        EndIf

        cFerramAlt := ""
        If !Empty((cAlias)->ferramAlter)
            cFerramAlt := STR0029 //"Não"
            If (cAlias)->ferramAlter == '1'
                cFerramAlt := STR0028 //"Sim"
            EndIf
        EndIf

        ojItems := JsonObject():new()
        ojItems["programacao"    ] := descricao(AllTrim((cAlias)->programacao), (cAlias)->descriProg)
        ojItems["status"         ] := PCPA152Process():getDescricaoStatus((cAlias)->statusProg)
        ojItems["centTrabalho"   ] := descricao(AllTrim((cAlias)->centTrabalho), (cAlias)->descriCTrab)
        ojItems["ferramentas"    ] := Iif(Empty((cAlias)->ferramentas),"",STR0027 + descricao(AllTrim((cAlias)->ferramentas), (cAlias)->descriFerr)) // "Ferramenta: "
        ojItems["ordemProducao"  ] := (cAlias)->ordemProducao
        ojItems["situacao"       ] := cSituacao
        ojItems["produto"        ] := descricao(AllTrim((cAlias)->produto), (cAlias)->descriProd)
        ojItems["recurso"        ] := descricao(AllTrim((cAlias)->recurso), (cAlias)->descriRec)
        ojItems["operacao"       ] := descricao(AllTrim((cAlias)->operacao), (cAlias)->descriOper)
        ojItems["quantidade"     ] := (cAlias)->quantidade
        ojItems["periodo"        ] := cPeriodo
        ojItems["data"           ] := totvs.framework.treports.date.stringToTimeStamp((cAlias)->data)
        ojItems["horaInicio"     ] := (cAlias)->horaInicio
        ojItems["horaFim"        ] := (cAlias)->horaFim
        ojItems["dataReal"       ] := cDataRealFinal
        ojItems["tempo"          ] := (cAlias)->tempo
        ojItems["tipo"           ] := cTipo
        ojItems["capacidade"     ] := oHoras["capacidade"     ]
        ojItems["disponibilidade"] := oHoras["disponibilidade"]
        ojItems["efetivadas"     ] := oHoras["efetivadas"     ]
        ojItems["programadas"    ] := oHoras["programadas"    ]
        ojItems["apontadas"      ] := oHoras["apontadas"      ]
        ojItems["saldo"          ] := oHoras["saldo"          ]
        ojItems["setup"          ] := (cAlias)->setup
        ojItems["finalizacao"    ] := (cAlias)->finalizacao
        ojItems["imprime"        ] := nExibe
        ojItems["recurAlt"       ] := cRecAlt
        ojItems["ferramAlt"      ] := cFerramAlt
        ojItems["recInProg"      ] := (cAlias)->recInProg == 1

		For nX := 1 To Len(aStruct)
			If aStruct[nX][3] == "date"
				ojItems[aStruct[nX][1]] := totvs.framework.treports.date.stringToTimeStamp((cAlias)->&(aStruct[nX][5]))
            ElseIf aStruct[nX][3] == "boolean"
                ojItems[aStruct[nX][1]] := ((cAlias)->&(aStruct[nX][5]) == "T")
			Else
            	ojItems[aStruct[nX][1]] := (cAlias)->&(aStruct[nX][5])
			EndIf
        End

        self:ProcessData()
        self:oData:appendData(ojItems)

        (cAlias)->(DBSkip())

    EndDo

    (cAlias)->(DBCloseArea())

    oExec:Destroy()
    FreeObj(oExec)
    FreeObj(oHoras)
    FwFreeArray(aTables)

Return self:oData

