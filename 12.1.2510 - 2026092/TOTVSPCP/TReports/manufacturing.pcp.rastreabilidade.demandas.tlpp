#include "totvs.ch"
#include "msobject.ch"
#include "totvs.framework.treports.integratedprovider.th"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "manufacturing.pcp.rastreabilidade.demandas.ch"

namespace totvs.protheus.sigapcp.treportsintegratedprovider

@totvsFrameworkTReportsIntegratedProvider(active=.T.,team="SIGAPCP", tables="SMH,SB1,SC2,SC1,SVR,SC7", name="Rastreabilidade das Demandas", country="ALL", customTables="SMH,SB1,SC2,SC1,SVR,SC7", initialRelease="12.1.2210")

#DEFINE LISTA_POR_DOCUMENTO 1
#DEFINE LISTA_POR_DEMANDA   2

#DEFINE TIPO_AUTORIZACAO_ENTREGA 2

/*/{Protheus.doc} RastreabilidadeDemandasTReportsBusinessObject
Classe para criação do Objeto de Negócio para listagem dos registros do Resultado do MRP

@author breno.ferreira
@since 27/09/2023
@version 1.0
/*/
Class RastreabilidadeDemandasPrincipalTReportsBusinessObject From totvs.framework.treports.integratedprovider.IntegratedProvider

    private data jParametros as json

    public method new() as object
    public method getData() as object
    public method getSchema() as object

    private method getQueryBuscaDados(aCamposCustomizados) as Character
    private method getFiltroTipo() as Array
    private method getSituacaoDocumento(cTipo, nRecno) as Variant
    private method getLabelOrigem() as Character
    private method getDiferencaDias(dDataDocumento) as Numeric

EndClass

/*/{Protheus.doc} new
Método de instância da classe

@return object: self

@author breno.ferreira
@since 27/09/2023
@version 1.0
/*/
Method new() as object class RastreabilidadeDemandasPrincipalTReportsBusinessObject
    _Super:new()
    //Define a Área
    self:appendArea(STR0001) //STR0001 - "Manufatura"

    //Define o nome do Objeto de Negócio
    self:setDisplayName(STR0002) //STR0002 - "Rastreabilidade das Demandas"

    //Define a descrição do Objeto de Negócio
    self:setDescription(STR0003) //STR0003 - "Listagem da Rastreabilidade das Demandas"

    self:setPergunte("TRRAS") //Indica o pergunte que será utilizado no relatório
Return self

/*/{Protheus.doc} getData
Retorna os dados do objeto de negócio

@param nPage, numérico, indica a página atual do relatório
@param oFilter, objeto, contém o filtro do TReports

@return object: self:oData

@author breno.ferreira
@since 27/09/2023
@version 1.0
/*/
Method getData(nPage as numeric, oFilter as object) as object class RastreabilidadeDemandasPrincipalTReportsBusinessObject
    Local aStrutCustomizados := {}  as Array
    Local cAlias             := ""  as character
    Local cQuery             := ""  as character
    Local cSituacao          := ""  as character
    Local jParamsAux         := {}  as json
    Local nDias              := 0   as numeric
    Local nIndex             := 1   as numeric
    Local nPosParam          := 1   as numeric
    Local nQtdCustom         := 0   as numeric
    Local oJItem             := Nil as object
    Local oStatement         := Nil as object

    jParamsAux := oFilter:getParameters() //metodo para retorno do json dos parâmetros

    Self:jParametros := {;
        'demandaDe': jParamsAux["MV_PAR01"][1],;
        'demandaAte':  pcpGetParametroSV(jParamsAux, "MV_PAR02", .T., "MH_DEMANDA"),;
        'documentoDe': jParamsAux["MV_PAR03"][1],;
        'documentoAte': pcpGetParametroSV(jParamsAux, "MV_PAR04", .T., "MH_DEMDOC"),;
        'ordemDe': jParamsAux["MV_PAR05"][1],;
        'ordemAte': pcpGetParametroSV(jParamsAux, "MV_PAR06", .T., "MH_NMDCENT"),;
        'produtoDe': jParamsAux["MV_PAR07"][1],;
        'produtoAte': pcpGetParametroSV(jParamsAux, "MV_PAR08", .T., "MH_PRODUTO"),;
        'pedidoVenda': (jParamsAux["MV_PAR09"][1] == 1),;
        'previsaoVenda': (jParamsAux["MV_PAR10"][1] == 1),;
        'planoMestreProducao': (jParamsAux["MV_PAR11"][1] == 1),;
        'empenhoProjeto': (jParamsAux["MV_PAR12"][1] == 1),;
        'manual': (jParamsAux["MV_PAR13"][1] == 1),;
        'listaPor': LISTA_POR_DOCUMENTO,;
        'listaEmBranco': .T.,;
        'filtros': oFilter;
    }

    If (jParamsAux:hasProperty("MV_PAR14"))
        Self:jParametros["listaPor"] := jParamsAux["MV_PAR14"][1]
    EndIf

    If (jParamsAux:hasProperty("MV_PAR15"))
        Self:jParametros["listaEmBranco"] := jParamsAux["MV_PAR15"][1] == 1
    EndIf

    cQuery := Self:getQueryBuscaDados(@aStrutCustomizados)
    nQtdCustom := Len(aStrutCustomizados)
    oStatement := FwExecStatement():New(cQuery)

    oStatement:setString(nPosParam++, xFilial("SB1"))   // SB1.B1_FILIAL
    oStatement:setString(nPosParam++, xFilial("SC2"))   // SC2.C2_FILIAL
    oStatement:setString(nPosParam++, xFilial("SC1"))   // SC1.C1_FILIAL
    oStatement:setString(nPosParam++, xFilial("SVR"))   // SVR.VR_FILIAL
    oStatement:setIn(nPosParam++, Self:getFiltroTipo()) // SVR.VR_TIPO
    oStatement:setString(nPosParam++, xFilial("SC7"))   // SC7.C7_FILIAL
    oStatement:setString(nPosParam++, xFilial("SMH"))   // SMH.MH_FILIAL
    oStatement:setString(nPosParam++, Self:jParametros["demandaDe"   ]) // SMH.MH_DEMANDA
    oStatement:setString(nPosParam++, Self:jParametros["demandaAte"  ]) // SMH.MH_DEMANDA
    oStatement:setString(nPosParam++, Self:jParametros["documentoDe" ]) // SMH.MH_DEMDOC
    oStatement:setString(nPosParam++, Self:jParametros["documentoAte"]) // SMH.MH_DEMDOC
    oStatement:setString(nPosParam++, Self:jParametros["produtoDe"   ]) // SMH.MH_PRODUTO
    oStatement:setString(nPosParam++, Self:jParametros["produtoAte"  ]) // SMH.MH_PRODUTO

    cAlias := oStatement:openAlias()

    TcSetField(cAlias, 'entrega', 'D', GetSx3Cache("C2_DATPRF" , "X3_TAMANHO"), 0)

    While (cAlias)->(!EoF())
        ojItem := JsonObject():New()

        Self:getSituacaoDocumento((cAlias)->tipo, (cAlias)->recnoDoc, (cAlias)->entrega, @cSituacao, @nDias)

        ojItem["documento"       ] := (cAlias)->MH_DEMDOC
        ojItem["demanda"         ] := (cAlias)->MH_DEMANDA
        ojItem["sequenciaDemanda"] := (cAlias)->MH_DEMSEQ
        ojItem["produto"         ] := RTrim((cAlias)->MH_PRODUTO) + " - " + RTrim((cAlias)->B1_DESC)
        ojItem["numero"          ] := (cAlias)->MH_NMDCENT
        ojItem["tipo"            ] := (cAlias)->tipo
        ojItem["quantidade"      ] := (cAlias)->quantidade
        ojItem["quantidadeUsada" ] := (cAlias)->MH_QUANT
        ojItem["entrega"         ] := totvs.framework.treports.date.stringToTimeStamp(DToS((cAlias)->entrega))
        ojItem["dataUso"         ] := totvs.framework.treports.date.stringToTimeStamp((cAlias)->MH_DATA)
        ojItem["situacao"        ] := cSituacao
        ojItem["dias"            ] := nDias
        ojItem["origem"          ] := Self:getLabelOrigem((cAlias)->VR_TIPO)

        For nIndex := 1 To nQtdCustom
            If aStrutCustomizados[nIndex][3] == "date"
                ojItem[aStrutCustomizados[nIndex][1]] := totvs.framework.treports.date.stringToTimeStamp((cAlias)->&(aStrutCustomizados[nIndex][5]))
            ElseIf aStrutCustomizados[nIndex][3] == "boolean"
                ojItem[aStrutCustomizados[nIndex][1]] := ((cAlias)->&(aStrutCustomizados[nIndex][5]) == "T")
            Else
                ojItem[aStrutCustomizados[nIndex][1]] := (cAlias)->&(aStrutCustomizados[nIndex][5])
            EndIf
        End

        self:ProcessData()
        self:oData:appendData(ojItem)

        (cAlias)->(dbSkip())
    End
    (cAlias)->(dbCloseArea())

Return self:oData

/*/{Protheus.doc} getSchema
Retorna a estrutura dos campos

@return object: self:oSchema

@author breno.ferreira
@since 27/09/2023
@version 1.0
/*/
Method getSchema() as object class RastreabilidadeDemandasPrincipalTReportsBusinessObject

    Self:addProperty("documento"       , "documento"       , "string", STR0014, "MH_DEMDOC"      , /*cComboValues*/, .F., /*cRenameField*/, .T.) // "Documento"
    Self:addProperty("demanda"         , "demanda"         , "string", STR0015, "MH_DEMANDA"     , /*cComboValues*/, .F., /*cRenameField*/, .T.) // "Demanda"
    Self:addProperty("sequenciaDemanda", "sequenciaDemanda", "string", STR0016, "MH_DEMSEQ"      , /*cComboValues*/, .F., /*cRenameField*/, .T.) // "Seq. Demanda"
    Self:addProperty("produto"         , "produto"         , "string", STR0017, "MH_PRODUTO"     , /*cComboValues*/, .F., /*cRenameField*/, .T.) // "Produto"
    Self:addProperty("numero"          , "numero"          , "string", STR0018, "MH_NMDCENT"     , /*cComboValues*/, .F., /*cRenameField*/, .T.) // "Número"
    Self:addProperty("tipo"            , "tipo"            , "string", STR0019, "tipo"           , /*cComboValues*/, .F., /*cRenameField*/, .F.) // "Tipo"
    Self:addProperty("quantidade"      , "quantidade"      , "number", STR0020, "quantidade"     , /*cComboValues*/, .F., /*cRenameField*/, .F.) // "Quantidade"
    Self:addProperty("quantidadeUsada" , "quantidadeUsada" , "number", STR0021, "MH_QUANT"       , /*cComboValues*/, .F., /*cRenameField*/, .T.) // "Qtd. Usada"
    Self:addProperty("entrega"         , "entrega"         , "date"  , STR0022, "entrega"        , /*cComboValues*/, .F., /*cRenameField*/, .F.) // "Entrega"
    Self:addProperty("dataUso"         , "dataUso"         , "date"  , STR0023, "MH_DATA"        , /*cComboValues*/, .F., /*cRenameField*/, .T.) // "Data Uso"
    Self:addProperty("situacao"        , "situacao"        , "string", STR0024, "situacao"       , /*cComboValues*/, .F., /*cRenameField*/, .F.) // "Situação"
    Self:addProperty("dias"            , "dias"            , "number", STR0025, "dias"           , /*cComboValues*/, .F., /*cRenameField*/, .F.) // "Dias"
    Self:addProperty("origem"          , "origem"          , "string", STR0026, "VR_TIPO"        , /*cComboValues*/, .F., /*cRenameField*/, .T.) // "Origem"

    self:setCustomURL("MV_PAR01", "/api/pcp/smartview/v1/rastreaDemanda"  , 2)
    self:setCustomURL("MV_PAR02", "/api/pcp/smartview/v1/rastreaDemanda"  , 2)
    self:setCustomURL("MV_PAR03", "/api/pcp/smartview/v1/rastreaDocumento", 2)
    self:setCustomURL("MV_PAR04", "/api/pcp/smartview/v1/rastreaDocumento", 2)

Return self:oSchema

/*/{Protheus.doc} getQueryBuscaDados
Retorna a query para busca dos dados que irão compor o relatório.
@author Lucas Fagundes
@since 21/05/2026
@version P12
@param aCamposCustomizados, Array, Retorna por referencia a estrutura dos campos customizados.
@return cQuery, string, Query para busca dos dados.
/*/
Method getQueryBuscaDados(aCamposCustomizados) as Character Class RastreabilidadeDemandasPrincipalTReportsBusinessObject
    Local aMapAlias  := {}                               as Array
    Local cBalanceOP := ""                               as Character
    Local cBanco     := TcGetDb()                        as Character
    Local cFieldOP   := ""                               as Character
    Local cFieldPC   := ""                               as Character
    Local cFieldSC   := ""                               as Character
    Local cQuery     := ""                               as Character
    Local cThenES    := ""                               as Character
    Local cThenPP    := ""                               as Character
    Local cTxtES     := MrpDGetSTR("ES")                 as Character
    Local cTxtPP     := MrpDGetSTR("PP")                 as Character
    Local lPerdInf   := SuperGetMV("MV_PERDINF",.F.,.F.) as Logical

    aAdd(aMapAlias, {"MH_", "SMH."})
    aAdd(aMapAlias, {"B1_", "SB1."})
    aAdd(aMapAlias, {"C1_", "SC1."})
    aAdd(aMapAlias, {"C2_", "SC2."})
    aAdd(aMapAlias, {"C7_", "SC7."})
    aAdd(aMapAlias, {"VR_", "SVR."})

    If "MSSQL" $ cBanco
        cFieldOP += " SC2.C2_NUM + SC2.C2_ITEM + SC2.C2_SEQUEN + SC2.C2_ITEMGRD "
        cFieldSC += " SC1.C1_NUM + SC1.C1_ITEM + SC1.C1_ITEMGRD "
        cFieldPC += " SC7.C7_NUM + SC7.C7_ITEM + SC7.C7_SEQUEN + SC7.C7_ITEMGRD "
        cThenES  += " THEN TRIM('" + cTxtES + " ' + SMH.MH_PRODUTO) "
        cThenPP  += " THEN TRIM('" + cTxtPP + " ' + SMH.MH_PRODUTO) "

    ElseIf cBanco == "POSTGRES"
        cFieldOP += " TRIM(CONCAT(SC2.C2_NUM, SC2.C2_ITEM, SC2.C2_SEQUEN, SC2.C2_ITEMGRD)) "
        cFieldSC += " TRIM(CONCAT(SC1.C1_NUM, SC1.C1_ITEM, SC1.C1_ITEMGRD)) "
        cFieldPC += " TRIM(CONCAT(SC7.C7_NUM, SC7.C7_ITEM, SC7.C7_SEQUEN, SC7.C7_ITEMGRD)) "
        cThenES  += " THEN TRIM(CONCAT('" + cTxtES + " ', SMH.MH_PRODUTO)) "
        cThenPP  += " THEN TRIM(CONCAT('" + cTxtPP + " ', SMH.MH_PRODUTO)) "

    Else
        cFieldOP += " SC2.C2_NUM || SC2.C2_ITEM || SC2.C2_SEQUEN || SC2.C2_ITEMGRD "
        cFieldSC += " SC1.C1_NUM || SC1.C1_ITEM || SC1.C1_ITEMGRD "
        cFieldPC += " SC7.C7_NUM || SC7.C7_ITEM || SC7.C7_SEQUEN || SC7.C7_ITEMGRD "
        cThenES  += " THEN TRIM('" + cTxtES + " ' || SMH.MH_PRODUTO) "
        cThenPP  += " THEN TRIM('" + cTxtPP + " ' || SMH.MH_PRODUTO) "

    EndIf

    If lPerdInf
        cBalanceOP +=   " (SC2.C2_QUANT - SC2.C2_QUJE - SC2.C2_PERDA) "
    Else
        cBalanceOP +=   " (SC2.C2_QUANT - SC2.C2_QUJE) "
    EndIf

    cQuery := " SELECT CASE "
    cQuery +=            " WHEN TRIM(SMH.MH_DEMDOC) = '" + cTxtES + "' " + cThenES
    cQuery +=            " WHEN TRIM(SMH.MH_DEMDOC) = '" + cTxtPP + "' " + cThenPP
    cQuery +=            " ELSE TRIM(SMH.MH_DEMDOC) "
    cQuery +=        " END MH_DEMDOC, "
    cQuery +=        " SMH.MH_DEMANDA, "
    cQuery +=        " SMH.MH_DEMSEQ, "
    cQuery +=        " SMH.MH_PRODUTO, "
    cQuery +=        " SB1.B1_DESC, "
    cQuery +=        " CASE "
    cQuery +=            " WHEN SMH.MH_TPDCENT = '0' THEN '" + STR0012  + "' " // 'Saldo inicial'
    cQuery +=            " WHEN SMH.MH_TPDCENT = '1' THEN "  + cFieldOP + " "
    cQuery +=            " WHEN SMH.MH_TPDCENT = '2' THEN "  + cFieldSC + " "
    cQuery +=            " WHEN SMH.MH_TPDCENT = '3' THEN "  + cFieldPC + " "
    cQuery +=            " ELSE SMH.MH_NMDCENT "
    cQuery +=        " END MH_NMDCENT, "
    cQuery +=        " CASE "
    cQuery +=            " WHEN SMH.MH_TPDCENT = '0' THEN 'SI' "
    cQuery +=            " WHEN SMH.MH_TPDCENT = '1' THEN 'OP' "
    cQuery +=            " WHEN SMH.MH_TPDCENT = '2' THEN 'SC' "
    cQuery +=            " WHEN SMH.MH_TPDCENT = '3' THEN 'AE' "
    cQuery +=            " ELSE SMH.MH_TPDCENT "
    cQuery +=        " END tipo, "
    cQuery +=        " CASE "
    cQuery +=            " WHEN SMH.MH_TPDCENT = '1' THEN " + cBalanceOP + " "
    cQuery +=            " WHEN SMH.MH_TPDCENT = '2' THEN (SC1.C1_QUANT - SC1.C1_QUJE) "
    cQuery +=            " WHEN SMH.MH_TPDCENT = '3' THEN (SC7.C7_QUANT - SC7.C7_QUJE) "
    cQuery +=            " ELSE SMH.MH_QUANT "
    cQuery +=        " END quantidade, "
    cQuery +=        " SMH.MH_QUANT, "
    cQuery +=        " CASE "
    cQuery +=            " WHEN SMH.MH_TPDCENT = '1' THEN SC2.C2_DATPRF "
    cQuery +=            " WHEN SMH.MH_TPDCENT = '2' THEN SC1.C1_DATPRF "
    cQuery +=            " WHEN SMH.MH_TPDCENT = '3' THEN SC7.C7_DATPRF "
    cQuery +=            " ELSE ' ' "
    cQuery +=        " END entrega, "
    cQuery +=        " SMH.MH_DATA, "
    cQuery +=        " SVR.VR_TIPO, "
    cQuery +=        " CASE "
    cQuery +=            " WHEN SMH.MH_TPDCENT = '1' THEN SC2.R_E_C_N_O_ "
    cQuery +=            " WHEN SMH.MH_TPDCENT = '2' THEN SC1.R_E_C_N_O_ "
    cQuery +=            " WHEN SMH.MH_TPDCENT = '3' THEN SC7.R_E_C_N_O_ "
    cQuery +=            " ELSE SMH.R_E_C_N_O_ "
    cQuery +=        " END recnoDoc "

    PcpInCposPerson(@aCamposCustomizados, @cQuery, self:getCustomFields(), .T., .T., Nil, aMapAlias)

    cQuery +=   " FROM " + RetSqlName("SMH") + " SMH "

    cQuery +=  " INNER JOIN " + RetSqlName("SB1") + " SB1 "
    cQuery +=     " ON SB1.B1_FILIAL  =  ? "
    cQuery +=    " AND SB1.B1_COD     = SMH.MH_PRODUTO "
    cQuery +=    " AND SB1.D_E_L_E_T_ = ' ' "

    cQuery +=   " LEFT JOIN " + RetSqlName("SC2") + " SC2 "
    cQuery +=     " ON SC2.C2_FILIAL  =  ? "
    cQuery +=    " AND SMH.MH_TPDCENT = '1' " // tipo = ordem de produção
    cQuery +=    " AND " + cFieldOP + " = SMH.MH_NMDCENT "
    cQuery +=    " AND SC2.D_E_L_E_T_ = ' ' "

    cQuery +=   " LEFT JOIN " + RetSqlName("SC1") + " SC1 "
    cQuery +=     " ON SC1.C1_FILIAL  =  ? "
    cQuery +=    " AND SMH.MH_TPDCENT = '2' " // tipo = solicitação de compra
    cQuery +=    " AND " + cFieldSC + " = SMH.MH_NMDCENT "
    cQuery +=    " AND SC1.D_E_L_E_T_ = ' ' "

    cQuery +=   " LEFT JOIN " + RetSqlName("SVR") + " SVR "
    cQuery +=     " ON SVR.VR_FILIAL  =  ? "
    cQuery +=    " AND SVR.VR_CODIGO  = SMH.MH_DEMANDA "
    cQuery +=    " AND SVR.VR_SEQUEN  = SMH.MH_DEMSEQ "
    cQuery +=    " AND SVR.VR_TIPO   IN (?)"
    cQuery +=    " AND SVR.D_E_L_E_T_ = ' ' "

    cQuery +=   " LEFT JOIN " + RetSqlName("SC7") + " SC7 "
    cQuery +=     " ON SC7.C7_FILIAL  =  ? "
    cQuery +=    " AND SMH.MH_TPDCENT = '3' " // tipo = pedido de compra
    cQuery +=    " AND " + cFieldPC + " = SMH.MH_NMDCENT "
    cQuery +=    " AND SC7.C7_TIPO    = " + cValToChar(TIPO_AUTORIZACAO_ENTREGA)
    cQuery +=    " AND SC7.D_E_L_E_T_ = ' ' "

    cQuery += " WHERE SMH.MH_FILIAL   =  ? "
    cQuery +=   " AND SMH.MH_DEMANDA >=  ? "
    cQuery +=   " AND SMH.MH_DEMANDA <=  ? "
    cQuery +=   " AND SMH.MH_DEMDOC  >=  ? "
    cQuery +=   " AND SMH.MH_DEMDOC  <=  ? "
    cQuery +=   " AND SMH.MH_PRODUTO >=  ? "
    cQuery +=   " AND SMH.MH_PRODUTO <=  ? "
    If !Self:jParametros["listaEmBranco"]
        cQuery += " AND SMH.MH_DEMDOC != ' ' "
    EndIf
    cQuery +=   " AND SMH.D_E_L_E_T_  = ' ' "

    If Self:jParametros["filtros"]:hasFilter()
        cQuery += " AND " + Self:jParametros["filtros"]:getSQLExpression()
    EndIf

    If Self:jParametros["listaPor"] == LISTA_POR_DEMANDA
        cQuery += " ORDER BY SMH.MH_DEMANDA, SMH.MH_DEMDOC "

    ElseIf Self:jParametros["listaPor"] == LISTA_POR_DOCUMENTO
        cQuery += " ORDER BY SMH.MH_DEMDOC, SMH.MH_DEMANDA, SMH.MH_DEMSEQ "

    EndIf

    aSize(aMapAlias, 0)
Return cQuery

/*/{Protheus.doc} getFiltroTipo
Retorna os tipo de demanda selecionados no filtro para serem utilizados na query de busca dos dados.
@author Lucas Fagundes
@since 25/05/2026
@version P12
@return aTipos, Array, Array com os tipos selecionados no filtro.
/*/
Method getFiltroTipo() as Array Class RastreabilidadeDemandasPrincipalTReportsBusinessObject
    Local aNames := {}                 as Array
    Local aTipos := {}                 as Array
    Local nIndex := 0                  as Numeric
    Local nTotal := 0                  as Numeric
    Local oTipos := JsonObject():New() as object

    oTipos["1"] := Self:jParametros["pedidoVenda"]
    oTipos["2"] := Self:jParametros["previsaoVenda"]
    oTipos["3"] := Self:jParametros["planoMestreProducao"]
    oTipos["4"] := Self:jParametros["empenhoProjeto"]
    oTipos["9"] := Self:jParametros["manual"]

    aNames := oTipos:getNames()
    nTotal := Len(aNames)

    For nIndex := 1 To nTotal
        If oTipos[aNames[nIndex]]
            aAdd(aTipos, aNames[nIndex])
        EndIf
    Next

Return aTipos

/*/{Protheus.doc} getSituacao
Retorna a situação do documento.
@author Lucas Fagundes
@since 25/05/2026
@version P12
@param cTipo       , Character, Tipo do documento.
@param nRecno      , Numeric  , Recno do documento.
@param dDataEntrega, Date     , Data de entrega do documento.
@param cSituacao   , Character, Retorna por referencia a situação do documento.
@param nDias       , Numeric  , Retorna por referencia a diferença em dias entre a data atual e a data de entrega do documento.
@return Nil
/*/
Method getSituacaoDocumento(cTipo, nRecno, dDataEntrega, cSituacao, nDias) as Variant Class RastreabilidadeDemandasPrincipalTReportsBusinessObject
    Local cSituacao := "" as Character
    Local cStatus   := "" as Character

    cSituacao := ""
    nDias     := Self:getDiferencaDias(dDataEntrega)

    If cTipo == "OP"
        cStatus := PCPStatsPO(nRecno)

        // Encerrada Parcialmente ou Encerrada Totalmente
        If cStatus == "5" .Or. cStatus == "6"
            cSituacao := STR0013 // "Encerrada"
            nDias     := 0

        ElseIf nDias > 0
            cSituacao := STR0004 // "Atrasada"

        Else
            cSituacao := STR0011 // "No prazo"

        EndIf
    Else
        If nDias > 0
            cSituacao := STR0004 // "Atrasada"

        Else
            cSituacao := STR0011 // "No prazo"

        EndIf
    EndIf

Return Nil

/*/{Protheus.doc} getLabelOrigem
Retorna o label com nome da origem da demanda.
@author Lucas Fagundes
@since 25/05/2026
@version P12
@param cOrigem, Caracter, Origem da demanda (valor da tabela SVR).
@return cLabel, Caracter, Label com nome da origem da demanda.
/*/
Method getLabelOrigem(cOrigem) as Character Class RastreabilidadeDemandasPrincipalTReportsBusinessObject
    Local cLabel := "" as Character

    If cOrigem == "1"
        cLabel := STR0006 // "Pedido de venda"
    EndIf

    If cOrigem == "2"
        cLabel := STR0007 // "Previsão de vendas"
    EndIf

    If cOrigem == "3"
        cLabel := STR0008 // "Plano mestre"
    EndIf

    If cOrigem == "4"
        cLabel := STR0009 // "Empenho de projeto"
    EndIf

    If cOrigem == "9"
        cLabel := STR0010 // "Manual"
    EndIf

Return cLabel

/*/{Protheus.doc} getDiferencaDias
Retorna a diferença em dias entre a data atual e a data de entrega do documento.
@author Lucas Fagundes
@since 25/05/2026
@version P12
@param dDataDocumento, Date, Data do documento.
@return nDias, Numeric, Diferença em dias entre a data atual e a data de entrega do documento.
/*/
Method getDiferencaDias(dDataDocumento) as Numeric Class RastreabilidadeDemandasPrincipalTReportsBusinessObject
    Local nDias := 0 as Numeric

    If !Empty(dDataDocumento)
        nDias := DateDiffDay(dDataBase, dDataDocumento)

        If dDataBase < dDataDocumento
            nDias := nDias * -1
        EndIf
    EndIf

Return nDias
