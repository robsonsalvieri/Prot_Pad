#include "tlpp-core.th"
#include "totvs.ch"
#include "pcpa156.ch"

namespace totvs.protheus.manufacturing.acompanhapedidos.apis

#define STATUS_PEDIDO_PENDENTE "PEND"
#define STATUS_PEDIDO_CONCLUIDO "CON"
#define STATUS_PEDIDO_PRODUCAO "PRD"
#define STATUS_PEDIDO_QUALIDADE "QUA"
#define STATUS_PEDIDO_EXPEDICAO "EXP"

#define STATUS_QPK_PENDENTE "1" // Laudo Geral Pendente
#define STATUS_QPK_APROVADO "2" // Laudo Aprovado
#define STATUS_QPK_REPROVADO "3" // Laudo Reprovado
#define STATUS_QPK_LIB_URGENTE "4" // Liberação Urgente
#define STATUS_QPK_LIB_CONDICIONAL "5" // Liberação Condicional
#define STATUS_QPK_MOV_EST_PENDENTE "6" // Mov. Estoque Pendente
#define STATUS_QPK_PARCIAL "7" // Laudo Parcial

#define STATUS_CB7_DIVERGENCIA "1" // Divergencia
#define STATUS_CB7_PAUSA "1" // Pausa
#define STATUS_CB7_INICIO "0" // Inicio
#define STATUS_CB7_SEPARANDO "1" // Separando
#define STATUS_CB7_SEP_FINAL "2" // Sep.Final
#define STATUS_CB7_EMBALANDO "3" // Embalando
#define STATUS_CB7_EMB_FINAL "4" // Emb.Final
#define STATUS_CB7_GERA_NOTA "5" // Gera Nota
#define STATUS_CB7_IMP_NOTA "6" // Imp.nota
#define STATUS_CB7_IMP_VOL "7" // Imp.Vol
#define STATUS_CB7_EMBARCADO "8" // Embarcado
#define STATUS_CB7_EMBARQUE_FINAL "9" // Embarque Finalizado

#define PRAZO_PEDIDO_NO_PRAZO "PRAZ"
#define PRAZO_PEDIDO_ATRASADO "ATR"

/*/{Protheus.doc} ACOMPANHAPEDIDOS
Classe de Web Service para acompanhamento de pedidos e processos produtivos
@type class
@author karina.lmiranda
@since 27/07/2026
/*/
Class ACOMPANHAPEDIDOS

    @GET("api/pcp/v1/acompanhaPedidos/pedidos")
    public method getPedidos() as logical
    private method processGetPedidos(nPage as numeric, nPageSize as numeric, cOrderNumber as character, cCustomerName as character, aStatus as array, cProduct as character, lAtrasados as logical) as array
    private method getQueryStatusExpedicao() as character
    private method getQueryStatusProducao() as character
    private method getQueryStatusQualidade() as character

    @GET("api/pcp/v1/acompanhaPedidos/detalhes/:pedido/:item")
    public method getDetalhePedido() as logical
    private method processGetDetalhePedido(cPedido as character, cItem as character) as array
    private method getDocumentosDeSaida(cPedido as character, cItem as character) as array
    private method getNotasFiscaisEntrada(cPedido as character, cItem as character) as array
    private method getOrdensDeProducao(cPedido as character, cItem as character) as array
    private method getOrdensSeparacao(cPedido as character, cItem as character) as array
    private method getPedidosDeCompra(cPedido as character, cItem as character) as array
    private method getQualidade(cPedido as character, cItem as character) as array
    private method getSolicitacoesDeCompra(cPedido as character, cItem as character) as array
    private method getStatusLiberacaoPedido(cPedido as character, cItem as character) as json

    @GET("api/pcp/v1/acompanhaPedidos/kpis")
    public method getKpis() as logical
    private method processGetKpis() as array

    public method new()

    // Métodos auxiliares
    private method combinaCodigoDescricao(cCodigo as character, cDescricao as character) as character
    private method getStatusOrdemSeparacao(cDivergencia as character, cPausa as character, cStatus as character) as character
    private method getStatusQualidade(cSitOP as character) as character
    private method getTimePedido(dPrevisaoEntrega as date) as character
    private method setRespostaRest(aResposta as array) as logical
    private method trataErrorLogProcessamento(oError as object) as array

End Class

/*/{Protheus.doc} new
Construtor da classe
@type method
@author karina.lmiranda
@since 27/07/2026
@return Self, Object, Instância da classe
/*/
Method new() Class ACOMPANHAPEDIDOS
Return Self

/*/{Protheus.doc} trataErrorLogProcessamento
Realiza o tratamento de erros que ocorreram no processamento de algum endpoint.

@author Lucas Fagundes
@since 24/08/2026
@version P12
@param oError, Object, Objeto de error lançado pelo sistema.
@return aReturn, Array, Array com informações de retorno da API.
/*/
Method trataErrorLogProcessamento(oError as object) as array class ACOMPANHAPEDIDOS
    Local aReturn := Array(2) as array

    aReturn[1] := 500
    aReturn[2] := { "code": "500", "message": STR0027, "detailedMessage": oError:description } // "Ocorreu um erro no processamento."

    LogMsg("acompanhapedidos", 0, 0, 1, "", "", AllTrim(oError:description) + CHR(10) + AllTrim(oError:errorStack))

Return aReturn


/*/{Protheus.doc} setRespostaRest
Seta o retorno da API.
@author Lucas Fagundes
@since 24/08/2026
@version P12
@param aResposta, Array, Array com as informações do processamento da API, segue o formato: [statusCode: numeric, responseData: json]
@return lRet, Logical, Retorna se processou com sucesso a requisição.
/*/
Method setRespostaRest(aResposta as array) as logical class ACOMPANHAPEDIDOS
    Local lRet := .T. as logical

    oRest:setStatusCode(aResposta[1])
    lRet := oRest:setResponse(aResposta[2]:toJson())

    FreeObj(aResposta[2])
    aSize(aResposta, 0)
Return lRet

/*/{Protheus.doc} getPedidos
API para busca de pedidos de venda com paginação e filtros
endpoint: [GET] api/pcp/v1/acompanhaPedidos/pedidos

QUERYPARAM:
page (numeric) -> Número da página a ser retornada.
pageSize (numeric) -> Número de itens por página.
number (character) -> Número do pedido para filtro.
customerName (character) -> Nome do cliente para filtro.
status (character) -> String contendo os status dos pedidos que serão retornados, separados por vírgula.
somenteAtrasados (logical) -> Indicador para filtrar apenas pedidos atrasados.

@type method
@author karina.lmiranda
@since 27/07/2026
@return lRet, Logical, Retorna se processou com sucesso a requisição.
/*/
Method getPedidos() as logical Class ACOMPANHAPEDIDOS
    Local aReturnData  := {}  as array
    Local aStatus      := {}  as array
    Local jQueryParams := {}  as json
    Local lAtrasados   := .F. as logical
    Local lRet         := .T. as logical

    oRest:setKeyHeaderResponse("Content-Type","application/json")

    jQueryParams := oRest:getQueryRequest()

    If jQueryParams:hasProperty("page")
        jQueryParams["page"] := val(jQueryParams["page"])
    EndIf

    If jQueryParams:hasProperty("pageSize")
        jQueryParams["pageSize"] := val(jQueryParams["pageSize"])
    EndIf

    If jQueryParams:hasProperty("somenteAtrasados")
        lAtrasados := jQueryParams["somenteAtrasados"] == 'true'
    EndIf

    If jQueryParams:hasProperty("status")
        aStatus := StrTokArr(jQueryParams["status"], ",")
    EndIf

    TRY
        aReturnData := self:processGetPedidos(jQueryParams["page"], jQueryParams["pageSize"], jQueryParams["number"], jQueryParams["customerName"], aStatus, jQueryParams["product"], lAtrasados)
    CATCH oError
        aReturnData := self:trataErrorLogProcessamento(oError)
    ENDTRY

    lRet := self:setRespostaRest(aReturnData)
Return lRet

/*/{Protheus.doc} processGetPedidos
Processa a API para busca de pedidos de venda com paginação e filtros
@author Lucas Fagundes
@since 24/08/2026
@version P12
@param nPage, numeric, Número da página a ser retornada.
@param nPageSize, numeric, Número de itens por página.
@param cOrderNumber, character, Número do pedido para filtro.
@param cCustomerName, character, Nome do cliente para filtro.
@param aStatus, array, Array contendo os status dos pedidos que serão retornados.
@param cProduct, character, Código do produto para filtro.
@param lAtrasados, logical, Indicador para filtrar apenas pedidos atrasados.
@return aReturn, array, Array contendo os dados dos pedidos.
/*/
Method processGetPedidos(nPage as numeric, nPageSize as numeric, cOrderNumber as character, cCustomerName as character, aStatus as array, cProduct as character, lAtrasados as logical) as array class ACOMPANHAPEDIDOS
    Local aReturn    := Array(2)           as array
    Local cAlias     := ""                 as Character
    Local cQuery     := ""                 as Character
    Local jItem      := Nil                as Json
    Local jResponse  := JsonObject():New() as Json
    Local nCount     := 0                  as Numeric
    Local nPosParam  := 1                  as Numeric
    Local nStart     := 0                  as Numeric
    Local oStatement := Nil                as Object

    cQuery += " SELECT SC5.C5_NUM, "
    cQuery +=        " SC5.C5_CLIENTE, "
    cQuery +=        " SA1.A1_NREDUZ, "
    cQuery +=        " SC6.C6_ITEM, "
    cQuery +=        " SC6.C6_PRODUTO, "
    cQuery +=        " SB1.B1_DESC, "
    cQuery +=        " SC6.C6_QTDVEN, "
    cQuery +=        " SC6.C6_VALOR, "
    cQuery +=        " SC6.C6_ENTREG, "
    cQuery +=        " CASE "
    cQuery +=            " WHEN SC6.C6_NOTA <> ' ' THEN '" + STATUS_PEDIDO_CONCLUIDO + "' "
    cQuery +=            " WHEN EXISTS (" + self:getQueryStatusProducao()     + ") THEN '" + STATUS_PEDIDO_PRODUCAO  + "' "
    cQuery +=            " WHEN EXISTS (" + self:getQueryStatusQualidade()    + ") THEN '" + STATUS_PEDIDO_QUALIDADE + "' "
    cQuery +=            " WHEN EXISTS (" + self:getQueryStatusExpedicao()    + ") THEN '" + STATUS_PEDIDO_EXPEDICAO + "' "
    cQuery +=            " ELSE '" + STATUS_PEDIDO_PENDENTE + "' "
    cQuery +=        " END status "
    cQuery +=   " FROM " + RetSqlName("SC6") + " SC6 "
    cQuery +=  " INNER JOIN " + RetSqlName("SC5") + " SC5 "
    cQuery +=     " ON SC5.C5_FILIAL = SC6.C6_FILIAL "
    cQuery +=    " AND SC5.C5_NUM    = SC6.C6_NUM "
    cQuery +=    " AND SC5.D_E_L_E_T_= ' ' "
    cQuery +=  " INNER JOIN " + RetSqlName("SA1") + " SA1 "
    cQuery +=     " ON SA1.A1_FILIAL  = ? "
    cQuery +=    " AND SA1.A1_COD     = SC5.C5_CLIENTE "
    cQuery +=    " AND SA1.A1_LOJA    = SC5.C5_LOJACLI "
    If !Empty(cCustomerName)
        cQuery += " AND (SA1.A1_NOME LIKE ? OR SA1.A1_NREDUZ LIKE ? ) "
    EndIf
    cQuery +=    " AND SA1.D_E_L_E_T_ = ' ' "
    cQuery +=  " INNER JOIN " + RetSqlName("SB1") + " SB1 "
    cQuery +=     " ON SB1.B1_FILIAL  = ? "
    cQuery +=    " AND SB1.B1_COD     = SC6.C6_PRODUTO "
    cQuery +=    " AND SB1.D_E_L_E_T_ = ' ' "
    cQuery +=  " WHERE SC6.C6_FILIAL = ? "
    If !Empty(cOrderNumber)
        cQuery += " AND SC6.C6_NUM LIKE ? "
    EndIf
    If !Empty(cProduct)
        cQuery += " AND SC6.C6_PRODUTO LIKE ? "
    EndIf
    If lAtrasados
        cQuery += " AND SC6.C6_ENTREG < ? "
    EndIf
    cQuery +=    " AND SC6.D_E_L_E_T_ = ' ' "

    If !Empty(aStatus)
        cQuery := " SELECT aux.C5_NUM, "          +;
                         " aux.C5_CLIENTE, "      +;
                         " aux.A1_NREDUZ, "       +;
                         " aux.C6_ITEM, "         +;
                         " aux.C6_PRODUTO, "      +;
                         " aux.B1_DESC, "         +;
                         " aux.C6_QTDVEN, "       +;
                         " aux.C6_VALOR, "        +;
                         " aux.C6_ENTREG, "       +;
                         " aux.status "           +;
                    " FROM (" + cQuery + ") aux " +;
                   " WHERE aux.status IN (?) "       +;
                   " ORDER BY aux.C5_NUM DESC, aux.C6_ITEM "
    Else
        cQuery += " ORDER BY SC5.C5_NUM DESC, SC6.C6_ITEM "
    EndIf

    oStatement := FwExecStatement():New(cQuery)

    oStatement:setString(nPosParam++, xFilial("SC2")) // getQueryStatusProducao()  => SC2.C2_FILIAL
    oStatement:setString(nPosParam++, xFilial("QPK")) // getQueryStatusQualidade() => QPK.QPK_FILIAL
    oStatement:setString(nPosParam++, xFilial("SC2")) // getQueryStatusQualidade() => SC2.C2_FILIAL
    oStatement:setString(nPosParam++, xFilial("CB7")) // getQueryStatusExpedicao() => CB7.CB7_FILIAL
    oStatement:setString(nPosParam++, xFilial("SA1")) // SA1.A1_FILIAL
    If !Empty(cCustomerName)
        oStatement:setString(nPosParam++, Upper("%"+cCustomerName+"%")) // SA1.A1_NOME
        oStatement:setString(nPosParam++, Upper("%"+cCustomerName+"%")) // SA1.A1_NREDUZ
    EndIf
    oStatement:setString(nPosParam++, xFilial("SB1")) // SB1.B1_FILIAL
    oStatement:setString(nPosParam++, xFilial("SC6")) // SC6.C6_FILIAL
    If !Empty(cOrderNumber)
        oStatement:setString(nPosParam++, cOrderNumber+"%") // SC6.C6_NUM
    EndIf
    If !Empty(cProduct)
        oStatement:setString(nPosParam++, "%"+cProduct+"%") // SC6.C6_PRODUTO
    EndIf
    If lAtrasados
        oStatement:setDate(nPosParam++, dDataBase) // SC6.C6_ENTREG
    EndIf
    If !Empty(aStatus)
        oStatement:setIn(nPosParam++, aStatus) // aux.status
    EndIf

    cAlias := oStatement:openAlias()

    TcSetField(cAlias, 'C6_ENTREG', 'D', GetSx3Cache("C6_ENTREG", "X3_TAMANHO"), 0)

    If nPage > 1
        nStart := (nPage - 1) * (nPageSize)
        If nStart > 0
            (cAlias)->(dbSkip(nStart))
        EndIf
    EndIf

    jResponse["items"  ] := {}
    jResponse["hasNext"] := .F.

    While (cAlias)->(!EoF())
        nCount++

        jItem := {;
            "status": RTrim((cAlias)->status),;
            "time": self:getTimePedido((cAlias)->C6_ENTREG),;
            "pedido": (cAlias)->C5_NUM,;
            "item": (cAlias)->C6_ITEM,;
            "cliente": self:combinaCodigoDescricao((cAlias)->C5_CLIENTE, (cAlias)->A1_NREDUZ),;
            "produto": self:combinaCodigoDescricao((cAlias)->C6_PRODUTO, (cAlias)->B1_DESC),;
            "entrega": DToC((cAlias)->C6_ENTREG),;
            "quantidade": (cAlias)->C6_QTDVEN,;
            "valor": (cAlias)->C6_VALOR,;
            "acoes": "an an-eye";
        }

        aAdd(jResponse["items"], jItem)

        (cAlias)->(dbSkip())
        If nCount >= nPageSize
            Exit
        EndIf
    End

    jResponse["hasNext"] := ((cAlias)->(!EoF()))
    (cAlias)->(dbCloseArea())

    aReturn[1] := 200
    aReturn[2] := jResponse

    oStatement:destroy()
    FreeObj(oStatement)

Return aReturn

/*/{Protheus.doc} getTimePedido
Verifica se o item do pedido esta dentro do prazo de entrega ou atrasado.
@author Lucas Fagundes
@since 24/08/2026
@version P12
@param dPrevisaoEntrega, date, Data prevista de entrega do item
@return cTime, character, PRAZO_PEDIDO_NO_PRAZO se dentro do prazo ou PRAZO_PEDIDO_ATRASADO se atrasado
/*/
Method getTimePedido(dPrevisaoEntrega as date) as character class ACOMPANHAPEDIDOS
    Local cTime := PRAZO_PEDIDO_NO_PRAZO as Character

    If dPrevisaoEntrega < dDataBase
        cTime := PRAZO_PEDIDO_ATRASADO
    EndIf

Return cTime

/*/{Protheus.doc} getQueryStatusProducao
Retorna query para verificar o status de produção de um item do pedido.
@author Lucas Fagundes
@since 24/08/2026
@version P12
@return cQuery, character, Query para verificar o status de produção de um item do pedido.
/*/
Method getQueryStatusProducao() as character class ACOMPANHAPEDIDOS
    Local cQuery := "" as character

    cQuery := " SELECT 1 "
    cQuery +=   " FROM " + RetSqlName("SC2") + " SC2 "
    cQuery +=  " WHERE SC2.C2_FILIAL = ? "
    cQuery +=    " AND SC2.C2_PEDIDO = SC6.C6_NUM "
    cQuery +=    " AND SC2.C2_ITEMPV = SC6.C6_ITEM "
    cQuery +=    " AND SC2.C2_DATRF  = ' ' "
    cQuery +=    " AND SC2.D_E_L_E_T_= ' ' "

Return cQuery

/*/{Protheus.doc} getQueryStatusQualidade
Retorna query para verificar o status de qualidade de um item do pedido.
@author Lucas Fagundes
@since 24/08/2026
@version P12
@return cQuery, character, Query para verificar o status de qualidade de um item do pedido.
/*/
Method getQueryStatusQualidade() as character class ACOMPANHAPEDIDOS
    Local cQuery := "" as character

    cQuery := " SELECT 1 "
    cQuery +=   " FROM " + RetSqlName("SC2") + " SC2 "
    cQuery +=  " INNER JOIN " + RetSqlName("QPK") + " QPK "
    cQuery +=     " ON QPK.QPK_FILIAL = ? "
    cQuery +=    " AND " + PCPQrySC2("SC2", "QPK.QPK_OP")
    cQuery +=    " AND QPK.QPK_SITOP NOT IN ('" + STATUS_QPK_APROVADO + "', '" + STATUS_QPK_REPROVADO + "') "
    cQuery +=    " AND QPK.D_E_L_E_T_ = ' ' "
    cQuery +=  " WHERE SC2.C2_FILIAL  = ? "
    cQuery +=    " AND SC2.C2_PEDIDO  = SC6.C6_NUM "
    cQuery +=    " AND SC2.C2_ITEMPV  = SC6.C6_ITEM "
    cQuery +=    " AND SC2.D_E_L_E_T_ = ' ' "

Return cQuery

/*/{Protheus.doc} getQueryStatusExpedicao
Retorna query para verificar o status de expedição de um item do pedido.
@author Lucas Fagundes
@since 24/08/2026
@version P12
@return cQuery, character, Query para verificar o status de expedição de um item do pedido.
/*/
Method getQueryStatusExpedicao() as character class ACOMPANHAPEDIDOS
    Local cQuery := "" as character

    cQuery := " SELECT 1 "
    cQuery +=   " FROM " + RetSqlName("CB7") + " CB7 "
    cQuery +=  " INNER JOIN " + RetSqlName("CB8") + " CB8 "
    cQuery +=     " ON CB8.CB8_FILIAL = CB7.CB7_FILIAL "
    cQuery +=    " AND CB8.CB8_ORDSEP = CB7.CB7_ORDSEP "
    cQuery +=    " AND CB8.CB8_PROD   = SC6.C6_PRODUTO "
    cQuery +=    " AND CB8.D_E_L_E_T_ = ' ' "
    cQuery +=  " WHERE CB7.CB7_FILIAL = ? "
    cQuery +=    " AND CB7.CB7_PEDIDO = SC6.C6_NUM "
    cQuery +=    " AND CB7.D_E_L_E_T_ = ' ' "

Return cQuery

/*/{Protheus.doc} getDetalhePedido
Retorna detalhes de um item do pedido.
endpoint: [GET] api/pcp/v1/acompanhaPedidos/detalhes/:pedido/:item

PATHPARAM:
pedido (character) -> Número do pedido que irá consultar os detalhes.
item (character) -> Item do pedido que irá consultar os detalhes.

@type method
@author Lucas Fagundes
@since 08/09/2026
@return lRet, Logical, Retorna se processou com sucesso a requisição.
/*/
Method getDetalhePedido() as logical Class ACOMPANHAPEDIDOS
    Local aReturnData := {}  as array
    Local cItem       := ""  as Character
    Local cPedido     := ""  as Character
    Local jPathParams := {}  as json
    Local lRet        := .T. as logical

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    jPathParams := oRest:getPathParamsRequest()

    cPedido := jPathParams:getJsonText("pedido")
    cItem   := jPathParams:getJsonText("item")

    TRY
        aReturnData := self:processGetDetalhePedido(cPedido, cItem)
    CATCH oError
        aReturnData := self:trataErrorLogProcessamento(oError)
    ENDTRY

    lRet := self:setRespostaRest(aReturnData)

Return lRet

/*/{Protheus.doc} processGetDetalhePedido
Processa a API que retorna os detalhes de um item do pedido.
@author Lucas Fagundes
@since 08/09/2026
@version P12
@param cPedido, character, Número do pedido de venda.
@param cItem, character, Item do pedido de venda.
@return aReturn, array, Array com as informações do processamento da API, segue o formato: [statusCode: numeric, responseData: json]
/*/
Method processGetDetalhePedido(cPedido as character, cItem as character) as array class ACOMPANHAPEDIDOS
    Local aReturn   := Array(2)           as array
    Local jResponse := JsonObject():New() as Json

    jResponse["liberacao"] := self:getStatusLiberacaoPedido(cPedido, cItem)

    jResponse["producao"] := JsonObject():New()
    jResponse["producao"]["ordens"   ] := self:getOrdensDeProducao(cPedido, cItem)
    jResponse["producao"]["qualidade"] := self:getQualidade(cPedido, cItem)

    jResponse["suprimentos"] := JsonObject():New()
    jResponse["suprimentos"]["solicitacoesCompra"] := self:getSolicitacoesDeCompra(cPedido, cItem)
    jResponse["suprimentos"]["pedidosCompra"     ] := self:getPedidosDeCompra(cPedido, cItem)
    jResponse["suprimentos"]["notasFiscais"      ] := self:getNotasFiscaisEntrada(cPedido, cItem)

    jResponse["expedicao"] := self:getOrdensSeparacao(cPedido, cItem)

    jResponse["faturamento"] := self:getDocumentosDeSaida(cPedido, cItem)

    aReturn[1] := 200
    aReturn[2] := jResponse

Return aReturn

/*/{Protheus.doc} getStatusLiberacaoPedido
Verifica bloqueios de crédito/estoque

@type method
@author Lucas Fagundes
@since 08/09/2026
@param cPedido, character, Número do pedido de venda
@param cItem, character, Item do pedido de venda
@return json, JSON com status de liberação: regra, crédito e estoque
/*/
Method getStatusLiberacaoPedido(cPedido as character, cItem as character) as json class ACOMPANHAPEDIDOS
    Local jStatusPedido := JsonObject():New() as Json

    jStatusPedido["regra"  ] := STR0112 // "Liberado"
    jStatusPedido["credito"] := "N/A"
    jStatusPedido["estoque"] := "N/A"

    SC5->(dbSetOrder(1))
    If SC5->(dbSeek(xFilial("SC5") + cPedido))
        If SC5->C5_BLQ == "1"
            jStatusPedido["regra"] := STR0114 // "Pedido Bloqueado por regra"
        ElseIf SC5->C5_BLQ == "2"
            jStatusPedido["regra"] := STR0115 // "Pedido Bloqueado por verba"
        EndIf

        SC9->(dbSetOrder(1))
        If SC9->(dbSeek(xFilial("SC9") + cPedido + cItem))
            If Empty(SC9->C9_BLCRED) .Or. SC9->C9_BLCRED == "10"
                jStatusPedido["credito"] := STR0112 // "Liberado"
            Else
                jStatusPedido["credito"] := STR0116 // "Bloqueado"
            EndIf

            If Empty(SC9->C9_BLEST) .Or. SC9->C9_BLEST == "10"
                jStatusPedido["estoque"] := STR0112 // "Liberado"
            Else
                jStatusPedido["estoque"] := STR0116 // "Bloqueado"
            EndIf
        EndIf
    EndIf

Return jStatusPedido

/*/{Protheus.doc} getOrdensDeProducao
Busca OPs vinculadas ao pedido
@type method
@author Lucas Fagundes
@since 08/09/2026
@param cPedido, character, Número do pedido de venda
@param cItem, character, Item do pedido de venda
@return array, Array de JSON com as Ordens de Producao vinculadas ao item
/*/
Method getOrdensDeProducao(cPedido as character, cItem as character) as array class ACOMPANHAPEDIDOS
    Local aOrdensProducao := {}                                 as Array
    Local cAlias          := ""                                 as Character
    Local cQuery          := ""                                 as Character
    Local jOp             := Nil                                as Json
    Local lPerdInf        := SuperGetMV("MV_PERDINF", .F., .F.) as logical
    Local nPosParam       := 1                                  as numeric
    Local oStatement      := Nil                                as Object

    cQuery := " SELECT SC2.C2_NUM, "
    cQuery +=        " SC2.C2_ITEM, "
    cQuery +=        " SC2.C2_SEQUEN, "
    cQuery +=        " SC2.C2_ITEMGRD, "
    cQuery +=        " SC2.C2_QUANT, "
    cQuery +=        " SC2.C2_QUJE, "
    cQuery +=        " SC2.C2_PERDA, "
    cQuery +=        " SC2.C2_DATPRF, "
    cQuery +=        " SC2.C2_DATRF "
    cQuery +=   " FROM " + RetSqlName("SC2") + " SC2 "
    cQuery +=  " WHERE SC2.C2_FILIAL = ? "
    cQuery +=    " AND SC2.C2_PEDIDO = ? "
    cQuery +=    " AND SC2.C2_ITEMPV = ? "
    cQuery +=    " AND SC2.D_E_L_E_T_ = ' ' "

    oStatement := FwExecStatement():New(cQuery)

    oStatement:setString(nPosParam++, xFilial("SC2"))
    oStatement:setString(nPosParam++, cPedido)
    oStatement:setString(nPosParam++, cItem)

    cAlias := oStatement:openAlias()

    While (cAlias)->(!EoF())
        jOp := JsonObject():New()

        jOp["ordemProducao"] := RTrim((cAlias)->C2_NUM) + RTrim((cAlias)->C2_ITEM) + RTrim((cAlias)->C2_SEQUEN) + RTrim((cAlias)->C2_ITEMGRD)
        jOp["quantidade"   ] := (cAlias)->C2_QUANT
        jOp["qtdProduzida" ] := (cAlias)->C2_QUJE
        If !lPerdInf
            jOp['qtdProduzida'] += (cAlias)->C2_PERDA
        EndIf
        jOp["entrega"      ] := PCPConvDat((cAlias)->C2_DATPRF, 4)
        jOp["finalizacao"  ] := PCPConvDat((cAlias)->C2_DATRF, 4)

        aAdd(aOrdensProducao, jOp)

        (cAlias)->(dbSkip())
    EndDo
    (cAlias)->(dbCloseArea())

    oStatement:destroy()
    FreeObj(oStatement)

Return aOrdensProducao

/*/{Protheus.doc} getQualidade
Busca laudos de qualidade vinculados à OP
@type method
@author Lucas Fagundes
@since 08/09/2026
@param cPedido, character, Número do pedido de venda
@param cItem, character, Item do pedido de venda
@return array, Array de JSON com os laudos de qualidade (QPK) vinculados
/*/
Method getQualidade(cPedido as character, cItem as character) as array class ACOMPANHAPEDIDOS
    Local aInspecoesQualidade := {}  as Array
    Local cAlias              := ""  as Character
    Local cQuery              := ""  as Character
    Local jInsp               := Nil as Json
    Local nPosParam           := 1   as numeric
    Local oStatement          := Nil as Object

    cQuery := " SELECT SC2.C2_NUM, "
    cQuery +=        " SC2.C2_ITEM, "
    cQuery +=        " SC2.C2_SEQUEN, "
    cQuery +=        " SC2.C2_ITEMGRD, "
    cQuery +=        " QPK.QPK_REVI, "
    cQuery +=        " QPK.QPK_LOCAL, "
    cQuery +=        " QPK.QPK_TAMLOT, "
    cQuery +=        " QPK.QPK_DTPROD, "
    cQuery +=        " QPK.QPK_EMISSA, "
    cQuery +=        " QPK.QPK_QTREJ, "
    cQuery +=        " QPK.QPK_SITOP "
    cQuery +=   " FROM " + RetSqlName("SC2") + " SC2"
    cQuery +=  " INNER JOIN " + RetSqlName("QPK") + " QPK "
    cQuery +=     " ON QPK.QPK_FILIAL = ? "
    cQuery +=    " AND " + PCPQrySC2("SC2", "QPK.QPK_OP")
    cQuery +=    " AND QPK.D_E_L_E_T_ = ' ' "
    cQuery +=  " WHERE SC2.C2_FILIAL  =  ? "
    cQuery +=    " AND SC2.C2_PEDIDO  =  ? "
    cQuery +=    " AND SC2.C2_ITEMPV  =  ? "
    cQuery +=    " AND SC2.D_E_L_E_T_ = ' ' "

    oStatement := FwExecStatement():New(cQuery)

    oStatement:setString(nPosParam++, xFilial("QPK")) // QPK.QPK_FILIAL
    oStatement:setString(nPosParam++, xFilial("SC2")) // SC2.C2_FILIAL
    oStatement:setString(nPosParam++, cPedido)        // SC2.C2_PEDIDO
    oStatement:setString(nPosParam++, cItem)          // SC2.C2_ITEMPV

	cAlias := oStatement:openAlias()

    While (cAlias)->(!EoF())
        jInsp := JsonObject():New()

        jInsp["ordemProducao"] := RTrim((cAlias)->C2_NUM) + RTrim((cAlias)->C2_ITEM) + RTrim((cAlias)->C2_SEQUEN) + RTrim((cAlias)->C2_ITEMGRD)
        jInsp["revisao"      ] := RTrim((cAlias)->QPK_REVI)
        jInsp["local"        ] := RTrim((cAlias)->QPK_LOCAL)
        jInsp["lote"         ] := (cAlias)->QPK_TAMLOT
        jInsp["dataProducao" ] := PCPConvDat((cAlias)->QPK_DTPROD, 4)
        jInsp["dataEmissao"  ] := PCPConvDat((cAlias)->QPK_EMISSA, 4)
        jInsp["qtdRejeitada" ] := (cAlias)->QPK_QTREJ
        jInsp["status"       ] := self:getStatusQualidade((cAlias)->QPK_SITOP)

        aAdd(aInspecoesQualidade, jInsp)

        (cAlias)->(dbSkip())
    EndDo
    (cAlias)->(dbCloseArea())

    oStatement:destroy()
    FreeObj(oStatement)

Return aInspecoesQualidade

/*/{Protheus.doc} getSolicitacoesDeCompra
Busca solicitações de compra do pedido
@type method
@author Lucas Fagundes
@since 08/09/2026
@param cPedido, character, Número do pedido de venda
@param cItem, character, Item do pedido de venda
@return array, Array de JSON com as Solicitações de Compra vinculadas a OP
/*/
Method getSolicitacoesDeCompra(cPedido as character, cItem as character) as array class ACOMPANHAPEDIDOS
    Local aSolicitacoesCompra := {}  as Array
    Local cAlias              := ""  as Character
    Local cQuery              := ""  as Character
    Local jSc                 := Nil as Json
    Local nPosParam           := 1   as numeric
    Local oStatement          := Nil as Object

    cQuery := " SELECT SC1.C1_NUM, "
    cQuery +=        " SC1.C1_ITEM, "
    cQuery +=        " SC1.C1_PRODUTO, "
    cQuery +=        " SB1.B1_DESC, "
    cQuery +=        " SC1.C1_DESCRI, "
    cQuery +=        " SC1.C1_EMISSAO, "
    cQuery +=        " SC1.C1_QUANT, "
    cQuery +=        " SC1.C1_QUJE, "
    cQuery +=        " SC1.C1_PEDIDO, "
    cQuery +=        " SC1.C1_ITEMPED "
    cQuery +=   " FROM " + RetSqlName("SC2") + " SC2 "
    cQuery +=  " INNER JOIN " + RetSqlName("SC1") + " SC1 "
    cQuery +=     " ON SC1.C1_FILIAL  =  ? "
    cQuery +=    " AND " + PCPQrySC2("SC2", "SC1.C1_OP")
    cQuery +=    " AND SC1.D_E_L_E_T_ = ' ' "
    cQuery +=  " INNER JOIN " + RetSqlName("SB1") + " SB1 "
    cQuery +=     " ON SB1.B1_FILIAL  =  ? "
    cQuery +=    " AND SB1.B1_COD     = SC1.C1_PRODUTO "
    cQuery +=    " AND SB1.D_E_L_E_T_ = ' ' "
    cQuery +=  " WHERE SC2.C2_FILIAL  =  ? "
    cQuery +=    " AND SC2.C2_PEDIDO  =  ? "
    cQuery +=    " AND SC2.C2_ITEMPV  =  ? "
    cQuery +=    " AND SC2.D_E_L_E_T_ = ' ' "

    oStatement := FwExecStatement():New(cQuery)

    oStatement:setString(nPosParam++, xFilial("SC1")) // SC1.C1_FILIAL
    oStatement:setString(nPosParam++, xFilial("SB1")) // SB1.B1_FILIAL
    oStatement:setString(nPosParam++, xFilial("SC2")) // SC2.C2_FILIAL
    oStatement:setString(nPosParam++, cPedido)        // SC2.C2_PEDIDO
    oStatement:setString(nPosParam++, cItem)          // SC2.C2_ITEMPV

    cAlias := oStatement:openAlias()

    While (cAlias)->(!EoF())
        jSc := JsonObject():New()

        jSc["numero"     ] := RTrim((cAlias)->C1_NUM)
        jSc["item"       ] := RTrim((cAlias)->C1_ITEM)
        jSc["produto"    ] := self:combinaCodigoDescricao((cAlias)->C1_PRODUTO, (cAlias)->B1_DESC)
        jSc["emissao"    ] := PCPConvDat((cAlias)->C1_EMISSAO, 4)
        jSc["quantidade" ] := (cAlias)->C1_QUANT
        jSc["qtdEntregue"] := (cAlias)->C1_QUJE
        jSc["pedido"     ] := (cAlias)->C1_PEDIDO
        jSc["itemPedido" ] := (cAlias)->C1_ITEMPED

        aAdd(aSolicitacoesCompra, jSc)

        (cAlias)->(dbSkip())
    EndDo
    (cAlias)->(dbCloseArea())

    oStatement:destroy()
    FreeObj(oStatement)

Return aSolicitacoesCompra

/*/{Protheus.doc} getPedidosDeCompra
Busca pedidos de compra vinculados à OP
@type method
@author Lucas Fagundes
@since 08/09/2026
@param cPedido, character, Número do pedido de venda
@param cItem, character, Item do pedido de venda
@return array, Array de JSON com os Pedidos de Compra vinculados a OP
/*/
Method getPedidosDeCompra(cPedido as character, cItem as character) as array class ACOMPANHAPEDIDOS
    Local aPedidosCompra := {}  as Array
    Local cAlias         := ""  as Character
    Local cQuery         := ""  as Character
    Local jPc            := Nil as Json
    Local nPosParam      := 1   as numeric
    Local oStatement     := Nil as Object

    cQuery := " SELECT SC7.C7_NUM, "
    cQuery +=        " SC7.C7_ITEM, "
    cQuery +=        " SC7.C7_PRODUTO, "
    cQuery +=        " SC7.C7_DESCRI, "
    cQuery +=        " SC7.C7_EMISSAO, "
    cQuery +=        " SC7.C7_QUANT, "
    cQuery +=        " SC7.C7_QUJE, "
    cQuery +=        " SC7.C7_PRECO, "
    cQuery +=        " SC7.C7_TOTAL, "
    cQuery +=        " SC7.C7_FORNECE, "
    cQuery +=        " SC7.C7_LOJA, "
    cQuery +=        " SA2.A2_NREDUZ "
    cQuery +=   " FROM " + RetSqlName("SC2") + " SC2 "
    cQuery +=  " INNER JOIN " + RetSqlName("SC1") + " SC1 "
    cQuery +=     " ON SC1.C1_FILIAL  = ? "
    cQuery +=    " AND " + PCPQrySC2("SC2", "SC1.C1_OP")
    cQuery +=    " AND SC1.D_E_L_E_T_ = ' ' "
    cQuery +=  " INNER JOIN " + RetSqlName("SC7") + " SC7 "
    cQuery +=     " ON SC7.C7_FILIAL  =  ? "
    cQuery +=    " AND SC7.C7_NUM     = SC1.C1_PEDIDO "
    cQuery +=    " AND SC7.C7_ITEM    = SC1.C1_ITEMPED "
    cQuery +=    " AND SC7.D_E_L_E_T_ = ' ' "
    cQuery +=  " INNER JOIN " + RetSqlName("SA2") + " SA2 "
    cQuery +=     " ON SA2.A2_FILIAL  =  ? "
    cQuery +=    " AND SA2.A2_COD     = SC7.C7_FORNECE "
    cQuery +=    " AND SA2.A2_LOJA    = SC7.C7_LOJA "
    cQuery +=    " AND SA2.D_E_L_E_T_ = ' ' "
    cQuery +=  " INNER JOIN " + RetSqlName("SB1") + " SB1 "
    cQuery +=     " ON SB1.B1_FILIAL  =  ? "
    cQuery +=    " AND SB1.B1_COD     = SC7.C7_PRODUTO "
    cQuery +=    " AND SB1.D_E_L_E_T_ = ' ' "
    cQuery +=  " WHERE SC2.C2_FILIAL  =  ? "
    cQuery +=    " AND SC2.C2_PEDIDO  =  ? "
    cQuery +=    " AND SC2.C2_ITEMPV  =  ? "
    cQuery +=    " AND SC2.D_E_L_E_T_ = ' ' "

    oStatement := FwExecStatement():New(cQuery)

    oStatement:setString(nPosParam++, xFilial("SC1")) // SC1.C1_FILIAL
    oStatement:setString(nPosParam++, xFilial("SC7")) // SC7.C7_FILIAL
    oStatement:setString(nPosParam++, xFilial("SA2")) // SA2.A2_FILIAL
    oStatement:setString(nPosParam++, xFilial("SB1")) // SB1.B1_FILIAL
    oStatement:setString(nPosParam++, xFilial("SC2")) // SC2.C2_FILIAL
    oStatement:setString(nPosParam++, cPedido)        // SC2.C2_PEDIDO
    oStatement:setString(nPosParam++, cItem)          // SC2.C2_ITEMPV

    cAlias := oStatement:openAlias()

    While (cAlias)->(!EoF())
        jPc := JsonObject():New()

        jPc["numero"     ] := RTrim((cAlias)->C7_NUM)
        jPc["item"       ] := RTrim((cAlias)->C7_ITEM)
        jPc["fornecedor" ] := self:combinaCodigoDescricao((cAlias)->C7_FORNECE, (cAlias)->A2_NREDUZ)
        jPc["produto"    ] := self:combinaCodigoDescricao((cAlias)->C7_PRODUTO, (cAlias)->C7_DESCRI)
        jPc["emissao"    ] := PCPConvDat((cAlias)->C7_EMISSAO, 4)
        jPc["quantidade" ] := (cAlias)->C7_QUANT
        jPc["qtdEntregue"] := (cAlias)->C7_QUJE
        jPc["preco"      ] := (cAlias)->C7_PRECO
        jPc["valorTotal" ] := (cAlias)->C7_TOTAL

        aAdd(aPedidosCompra, jPc)

        (cAlias)->(dbSkip())
    EndDo

    (cAlias)->(dbCloseArea())
    oStatement:destroy()
    FreeObj(oStatement)

Return aPedidosCompra

/*/{Protheus.doc} getNotasFiscaisEntrada
Busca notas fiscais de entrada vinculadas ao pedido
@type method
@author Lucas Fagundes
@since 08/09/2026
@param cPedido, character, Número do pedido de venda
@param cItem, character, Item do pedido de venda
@return array, Array de JSON com as Notas Fiscais de Entrada vinculadas
/*/
Method getNotasFiscaisEntrada(cPedido as character, cItem as character) as array class ACOMPANHAPEDIDOS
    Local aNotasFiscais := {}  as Array
    Local cAlias        := ""  as Character
    Local cQuery        := ""  as Character
    Local jPc           := Nil as Json
    Local nPosParam     := 1   as Numeric
    Local oStatement    := Nil as Object

    cQuery := " SELECT SD1.D1_DOC, "
    cQuery +=        " SD1.D1_SERIE, "
    cQuery +=        " SD1.D1_EMISSAO, "
    cQuery +=        " SD1.D1_ITEM, "
    cQuery +=        " SD1.D1_QUANT, "
    cQuery +=        " SD1.D1_VUNIT, "
    cQuery +=        " SD1.D1_TOTAL, "
    cQuery +=        " SC7.C7_FORNECE, "
    cQuery +=        " SA2.A2_NREDUZ, "
    cQuery +=        " SC7.C7_PRODUTO, "
    cQuery +=        " SC7.C7_DESCRI "
    cQuery +=   " FROM " + RetSqlName("SC2") + " SC2 "
    cQuery +=  " INNER JOIN " + RetSqlName("SC1") + " SC1 "
    cQuery +=     " ON SC1.C1_FILIAL  = ? "
    cQuery +=    " AND " + PCPQrySC2("SC2", "SC1.C1_OP")
    cQuery +=    " AND SC1.D_E_L_E_T_ = ' ' "
    cQuery +=  " INNER JOIN " + RetSqlName("SC7") + " SC7 "
    cQuery +=     " ON SC7.C7_FILIAL  = SC1.C1_FILIAL "
    cQuery +=    " AND SC7.C7_NUM     = SC1.C1_PEDIDO "
    cQuery +=    " AND SC7.C7_ITEM    = SC1.C1_ITEMPED "
    cQuery +=    " AND SC7.D_E_L_E_T_ = ' ' "
    cQuery +=  " INNER JOIN " + RetSqlName("SA2") + " SA2 "
    cQuery +=     " ON SA2.A2_FILIAL  = ? "
    cQuery +=    " AND SA2.A2_COD     = SC7.C7_FORNECE "
    cQuery +=    " AND SA2.A2_LOJA    = SC7.C7_LOJA "
    cQuery +=    " AND SA2.D_E_L_E_T_ = ' ' "
    cQuery +=  " INNER JOIN " + RetSqlName("SD1") + " SD1 "
    cQuery +=     " ON SD1.D1_FILIAL  = SC7.C7_FILIAL "
    cQuery +=    " AND SD1.D1_FORNECE = SC7.C7_FORNECE "
    cQuery +=    " AND SD1.D1_LOJA    = SC7.C7_LOJA "
    cQuery +=    " AND SD1.D1_PEDIDO  = SC7.C7_NUM "
    cQuery +=    " AND SD1.D1_ITEMPC  = SC7.C7_ITEM "
    cQuery +=    " AND SD1.D_E_L_E_T_ = ' ' "
    cQuery +=  " WHERE SC2.C2_FILIAL  = ? "
    cQuery +=    " AND SC2.C2_PEDIDO  = ? "
    cQuery +=    " AND SC2.C2_ITEMPV  = ? "
    cQuery +=    " AND SC2.D_E_L_E_T_ = ' ' "
    cQuery +=  " ORDER BY SC2.C2_SEQUEN "

    oStatement := FwExecStatement():New(cQuery)

    oStatement:setString(nPosParam++, xFilial("SC1")) // SC1.C1_FILIAL
    oStatement:setString(nPosParam++, xFilial("SA2")) // SA2.A2_FILIAL
    oStatement:setString(nPosParam++, xFilial("SC2")) // SC2.C2_FILIAL
    oStatement:setString(nPosParam++, cPedido)        // SC2.C2_PEDIDO
    oStatement:setString(nPosParam++, cItem)          // SC2.C2_ITEMPV

    cAlias := oStatement:openAlias()

    While (cAlias)->(!EoF())
        jPc := JsonObject():New()

        jPc["numero"       ] := RTrim((cAlias)->D1_DOC)
        jPc["serie"        ] := RTrim((cAlias)->D1_SERIE)
        jPc["fornecedor"   ] := self:combinaCodigoDescricao((cAlias)->C7_FORNECE, (cAlias)->A2_NREDUZ)
        jPc["emissao"      ] := PCPConvDat((cAlias)->D1_EMISSAO, 4)
        jPc["item"         ] := RTrim((cAlias)->D1_ITEM)
        jPc["produto"      ] := self:combinaCodigoDescricao((cAlias)->C7_PRODUTO, (cAlias)->C7_DESCRI)
        jPc["quantidade"   ] := (cAlias)->D1_QUANT
        jPc["valorUnitario"] := (cAlias)->D1_VUNIT
        jPc["valorTotal"   ] := (cAlias)->D1_TOTAL

        aAdd(aNotasFiscais, jPc)

        (cAlias)->(dbSkip())
    EndDo
    (cAlias)->(dbCloseArea())

    oStatement:destroy()
    FreeObj(oStatement)

Return aNotasFiscais

/*/{Protheus.doc} getOrdensSeparacao
Busca Ordens de Separação WMS
@type method
@author Lucas Fagundes
@since 08/09/2026
@param cPedido, character, Número do pedido de venda
@param cItem, character, Item do pedido de venda
@return array, Array de JSON com as Ordens de Separação WMS
/*/
Method getOrdensSeparacao(cPedido as character, cItem as character) as array class ACOMPANHAPEDIDOS
    Local aOrdensSeparacao := {}  as Array
    Local cAlias           := ""  as Character
    Local cQuery           := ""  as Character
    Local jOrdemSeparacao  := Nil as Json
    Local nPosParam        := 1   as Numeric
    Local oStatement       := Nil as Object

    cQuery := " SELECT CB7.CB7_ORDSEP, "
    cQuery +=        " CB7.CB7_DTEMIS, "
    cQuery +=        " CB7.CB7_HREMIS, "
    cQuery +=        " CB7.CB7_CODOPE, "
    cQuery +=        " CB7.CB7_DTINIS, "
    cQuery +=        " CB7.CB7_HRINIS, "
    cQuery +=        " CB7.CB7_DTFIMS, "
    cQuery +=        " CB7.CB7_HRFIMS, "
    cQuery +=        " CB7.CB7_DIVERG, "
    cQuery +=        " CB7.CB7_STATPA, "
    cQuery +=        " CB7.CB7_STATUS "
    cQuery +=   " FROM " + RetSqlName("SC6") + " SC6 "
    cQuery +=  " INNER JOIN " + RetSqlName("CB7") + " CB7 "
    cQuery +=    "  ON CB7.CB7_FILIAL = ? "
    cQuery +=    " AND CB7.CB7_PEDIDO = SC6.C6_NUM "
    cQuery +=    " AND CB7.D_E_L_E_T_ = ' ' "
    cQuery +=  " INNER JOIN " + RetSqlName("CB8") + " CB8 "
    cQuery +=    "  ON CB8.CB8_FILIAL = CB7.CB7_FILIAL "
    cQuery +=    " AND CB8.CB8_ORDSEP = CB7.CB7_ORDSEP "
    cQuery +=    " AND CB8.CB8_PROD   = SC6.C6_PRODUTO "
    cQuery +=    " AND CB8.D_E_L_E_T_ = ' ' "
    cQuery +=  " WHERE SC6.C6_FILIAL = ? "
    cQuery +=    " AND SC6.C6_NUM    = ? "
    cQuery +=    " AND SC6.C6_ITEM   = ? "
    cQuery +=    " AND SC6.D_E_L_E_T_ = ' ' "

    oStatement := FwExecStatement():New(cQuery)

    oStatement:setString(nPosParam++, xFilial("CB7")) // CB7.CB7_FILIAL
    oStatement:setString(nPosParam++, xFilial("SC6")) // SC6.C6_FILIAL
    oStatement:setString(nPosParam++, cPedido)        // SC6.C6_NUM
    oStatement:setString(nPosParam++, cItem)          // SC6.C6_ITEM

    cAlias := oStatement:openAlias()

    While (cAlias)->(!EoF())
        jOrdemSeparacao := JsonObject():New()

        jOrdemSeparacao["status"             ] := self:getStatusOrdemSeparacao((cAlias)->CB7_DIVERG, (cAlias)->CB7_STATPA, (cAlias)->CB7_STATUS)
        jOrdemSeparacao["ordemSeparacao"     ] := RTrim((cAlias)->CB7_ORDSEP)
        jOrdemSeparacao["dataEmissao"        ] := PCPConvDat((cAlias)->CB7_DTEMIS, 4)
        jOrdemSeparacao["horaEmissao"        ] := (cAlias)->CB7_HREMIS
        jOrdemSeparacao["operador"           ] := RTrim((cAlias)->CB7_CODOPE)
        jOrdemSeparacao["dataInicioSeparacao"] := IIf(Empty((cAlias)->CB7_DTINIS), "", PCPConvDat((cAlias)->CB7_DTINIS, 4))
        jOrdemSeparacao["horaInicioSeparacao"] := RTrim((cAlias)->CB7_HRINIS)
        jOrdemSeparacao["dataFimSeparacao"   ] := IIf(Empty((cAlias)->CB7_DTFIMS), "", PCPConvDat((cAlias)->CB7_DTFIMS, 4))
        jOrdemSeparacao["horaFimSeparacao"   ] := RTrim((cAlias)->CB7_HRFIMS)

        aAdd(aOrdensSeparacao, jOrdemSeparacao)

        (cAlias)->(dbSkip())
    EndDo
    (cAlias)->(dbCloseArea())

    oStatement:destroy()
    FreeObj(oStatement)

Return aOrdensSeparacao

/*/{Protheus.doc} getDocumentosDeSaida
Busca notas de faturamento (SF2/SD2)
@type method
@author Lucas Fagundes
@since 08/09/2026
@param cPedido, character, Número do pedido de venda
@param cItem, character, Item do pedido de venda
@return array, Array de JSON com as Notas Fiscais de saída (faturamento)
/*/
Method getDocumentosDeSaida(cPedido as character, cItem as character) as array class ACOMPANHAPEDIDOS
    Local aDocumentos := {}  as Array
    Local cAlias      := ""  as Character
    Local cQuery      := ""  as Character
    Local jNotaFiscal := Nil as Json
    Local nPosParam   := 1   as Numeric
    Local oStatement  := Nil as Object

    cQuery := " SELECT SF2.F2_DOC, "
    cQuery +=        " SF2.F2_SERIE, "
    cQuery +=        " SF2.F2_EMISSAO, "
    cQuery +=        " SF2.F2_CHVNFE, "
    cQuery +=        " SD2.D2_ITEM, "
    cQuery +=        " SD2.D2_QUANT, "
    cQuery +=        " SD2.D2_PRCVEN, "
    cQuery +=        " SD2.D2_TOTAL "
    cQuery +=   " FROM " + RetSqlName("SD2") + " SD2 "
    cQuery +=  " INNER JOIN " + RetSqlName("SF2") + " SF2 "
    cQuery +=    "  ON SF2.F2_FILIAL  = SD2.D2_FILIAL  "
    cQuery +=    " AND SF2.F2_DOC     = SD2.D2_DOC     "
    cQuery +=    " AND SF2.F2_SERIE   = SD2.D2_SERIE   "
    cQuery +=    " AND SF2.F2_CLIENTE = SD2.D2_CLIENTE "
    cQuery +=    " AND SF2.F2_LOJA    = SD2.D2_LOJA    "
    cQuery +=    " AND SF2.D_E_L_E_T_ = ' ' "
    cQuery +=  " WHERE SD2.D2_FILIAL  =  ? "
    cQuery +=    " AND SD2.D2_PEDIDO  =  ? "
    cQuery +=    " AND SD2.D2_ITEMPV  =  ? "
    cQuery +=    " AND SD2.D_E_L_E_T_ = ' ' "

    oStatement := FwExecStatement():New(cQuery)

    oStatement:setString(nPosParam++, xFilial("SD2")) // D2_FILIAL
    oStatement:setString(nPosParam++, cPedido)        // D2_PEDIDO
    oStatement:setString(nPosParam++, cItem)          // D2_ITEMPV

	cAlias := oStatement:openAlias()

    While (cAlias)->(!EoF())
        jNotaFiscal := JsonObject():New()

        jNotaFiscal["numero"       ] := RTrim((cAlias)->F2_DOC)
        jNotaFiscal["serie"        ] := (cAlias)->F2_SERIE
        jNotaFiscal["emissao"      ] := PCPConvDat((cAlias)->F2_EMISSAO, 4)
        jNotaFiscal["chave"        ] := RTrim((cAlias)->F2_CHVNFE)
        jNotaFiscal["itemNF"       ] := RTrim((cAlias)->D2_ITEM)
        jNotaFiscal["quantidade"   ] := (cAlias)->D2_QUANT
        jNotaFiscal["valorUnitario"] := (cAlias)->D2_PRCVEN
        jNotaFiscal["valorTotal"   ] := (cAlias)->D2_TOTAL

        aAdd(aDocumentos, jNotaFiscal)

        (cAlias)->(dbSkip())
    EndDo

    (cAlias)->(dbCloseArea())

    oStatement:destroy()
    FreeObj(oStatement)

Return aDocumentos

/*/{Protheus.doc} getKpis
Retorna indicadores de status do pedido
@type method
@author karina.lmiranda
@since 27/08/2026
@version P12
@return lRet, Logical, Retorna se processou com sucesso a requisição.
/*/
Method getKpis() as logical Class ACOMPANHAPEDIDOS
    Local aReturnData := {}  as array
    Local lRet        := .T. as logical

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    TRY
        aReturnData := self:processGetKpis()
    CATCH oError
        aReturnData := self:trataErrorLogProcessamento(oError)
    ENDTRY

    lRet := self:setRespostaRest(aReturnData)

Return lRet

/*/{Protheus.doc} processGetKpis
Processa a API de KPIs, retornando a quantidade de pedidos de venda em cada fase.
@author karina.lmiranda
@since 27/08/2026
@version P12
@return aReturn, array, Array com as informações do processamento da API, segue o formato: [statusCode: numeric, responseData: json]
/*/
Method processGetKpis() as array class ACOMPANHAPEDIDOS
    Local aReturn      := Array(2)           as Array
    Local cAlias       := ""                 as Character
    Local cQuery       := ""                 as Character
    Local jResponse    := JsonObject():New() as Json
    Local nPosParam    := 1                  as Numeric
    Local oStatement   := Nil                as Object

    cQuery += " SELECT SUM(CASE WHEN aux.status = '" + STATUS_PEDIDO_CONCLUIDO + "' THEN 1 ELSE 0 END) AS TOTAL_CONCLUIDOS, "
    cQuery +=        " SUM(CASE WHEN aux.status = '" + STATUS_PEDIDO_PRODUCAO  + "' THEN 1 ELSE 0 END) AS TOTAL_PRODUCAO, "
    cQuery +=        " SUM(CASE WHEN aux.status = '" + STATUS_PEDIDO_QUALIDADE + "' THEN 1 ELSE 0 END) AS TOTAL_QUALIDADE, "
    cQuery +=        " SUM(CASE WHEN aux.status = '" + STATUS_PEDIDO_EXPEDICAO + "' THEN 1 ELSE 0 END) AS TOTAL_EXPEDICAO, "
    cQuery +=        " SUM(CASE WHEN aux.status = '" + STATUS_PEDIDO_PENDENTE  + "' THEN 1 ELSE 0 END) AS TOTAL_PENDENTES, "
    cQuery +=        " SUM(aux.ATRASADO) AS TOTAL_ATRASADOS "
    cQuery +=   " FROM ( "
    cQuery +=      " SELECT CASE "
    cQuery +=                  " WHEN SC6.C6_NOTA <> ' '                                 THEN '" + STATUS_PEDIDO_CONCLUIDO + "' "
    cQuery +=                  " WHEN EXISTS (" + self:getQueryStatusProducao()     + ") THEN '" + STATUS_PEDIDO_PRODUCAO  + "' "
    cQuery +=                  " WHEN EXISTS (" + self:getQueryStatusQualidade()    + ") THEN '" + STATUS_PEDIDO_QUALIDADE + "' "
    cQuery +=                  " WHEN EXISTS (" + self:getQueryStatusExpedicao()    + ") THEN '" + STATUS_PEDIDO_EXPEDICAO + "' "
    cQuery +=                  " ELSE '" + STATUS_PEDIDO_PENDENTE + "' "
    cQuery +=              " END AS status, "
    cQuery +=              " CASE WHEN SC6.C6_NOTA = ' ' AND SC6.C6_ENTREG < ? THEN 1 ELSE 0 END AS ATRASADO "
    cQuery +=         " FROM " + RetSqlName("SC6") + " SC6 "
    cQuery +=         " WHERE SC6.C6_FILIAL = ? "
    cQuery +=           " AND SC6.D_E_L_E_T_ = ' ' "
    cQuery +=    " ) aux "

    oStatement := FwExecStatement():New(cQuery)

    oStatement:setString(nPosParam++, xFilial("SC2")) // getQueryStatusProducao()  => SC2.C2_FILIAL
    oStatement:setString(nPosParam++, xFilial("QPK")) // getQueryStatusQualidade() => QPK.QPK_FILIAL
    oStatement:setString(nPosParam++, xFilial("SC2")) // getQueryStatusQualidade() => SC2.C2_FILIAL
    oStatement:setString(nPosParam++, xFilial("CB7")) // getQueryStatusExpedicao() => CB7.CB7_FILIAL
    oStatement:setDate(nPosParam++, dDataBase)        // SC6.C6_ENTREG
    oStatement:setString(nPosParam++, xFilial("SC6")) // SC6.C6_FILIAL

    cAlias := oStatement:openAlias()

    jResponse["concluidos"] := IIf((cAlias)->TOTAL_CONCLUIDOS == Nil, "0", cValToChar((cAlias)->TOTAL_CONCLUIDOS))
    jResponse["atrasados" ] := IIf((cAlias)->TOTAL_ATRASADOS  == Nil, "0", cValToChar((cAlias)->TOTAL_ATRASADOS))
    jResponse["producao"  ] := IIf((cAlias)->TOTAL_PRODUCAO   == Nil, "0", cValToChar((cAlias)->TOTAL_PRODUCAO))
    jResponse["qualidade" ] := IIf((cAlias)->TOTAL_QUALIDADE  == Nil, "0", cValToChar((cAlias)->TOTAL_QUALIDADE))
    jResponse["expedicao" ] := IIf((cAlias)->TOTAL_EXPEDICAO  == Nil, "0", cValToChar((cAlias)->TOTAL_EXPEDICAO))
    jResponse["pendentes" ] := IIf((cAlias)->TOTAL_PENDENTES  == Nil, "0", cValToChar((cAlias)->TOTAL_PENDENTES))

    (cAlias)->(dbCloseArea())
    oStatement:destroy()
    FreeObj(oStatement)

    aReturn[1] := 200
    aReturn[2] := jResponse

Return aReturn

/*/{Protheus.doc} combinaCodigoDescricao
Retorna a label com o código e descrição combinados.
@author Lucas Fagundes
@since 24/08/2026
@version P12
@param cCodigo, Character, Código a ser combinado.
@param cDescricao, Character, Descrição a ser combinada.
@return cLabel, Character, Código e descrição combinados.
/*/
Method combinaCodigoDescricao(cCodigo as character, cDescricao as character) as character class ACOMPANHAPEDIDOS
    Local cLabel := "" as character

    cLabel := RTrim(cCodigo)
    If !Empty(cDescricao)
        cLabel += " - " + RTrim(cDescricao)
    EndIf

Return cLabel

/*/{Protheus.doc} getStatusQualidade
Retorna o label dos status dos registros de qualidade.
@author Lucas Fagundes
@since 08/09/2026
@version P12
@param cSitOP, Character, Valor do campo QPK_SITOP
@return cLabel, Character, Label do status da tabela QPK.
/*/
Method getStatusQualidade(cSitOP as character) as character class ACOMPANHAPEDIDOS
    Local cLabel := cSitOP as character

    If Empty(cSitOP)
        cLabel := STR0091 // "Não iniciada"

    ElseIf cSitOP == STATUS_QPK_PENDENTE
        cLabel := STR0092 // "Laudo Geral Pendente"

    ElseIf cSitOP == STATUS_QPK_APROVADO
        cLabel := STR0093 // "Laudo Aprovado"

    ElseIf cSitOP == STATUS_QPK_REPROVADO
        cLabel := STR0094 // "Laudo Reprovado"

    ElseIf cSitOP == STATUS_QPK_LIB_URGENTE
        cLabel := STR0095 // "Liberação Urgente"

    ElseIf cSitOP == STATUS_QPK_LIB_CONDICIONAL
        cLabel := STR0096 // "Liberação Condicional"

    ElseIf cSitOP == STATUS_QPK_MOV_EST_PENDENTE
        cLabel := STR0097 // "Mov. Estoque Pendente"

    ElseIf cSitOP == STATUS_QPK_PARCIAL
        cLabel := STR0098 // "Laudo Parcial"

    EndIf

Return cLabel

/*/{Protheus.doc} getStatusOrdemSeparacao
Retorna o label de status da ordem de separação.
@author Lucas Fagundes
@since 08/09/2026
@version P12
@param cDivergencia, character, Valor referente ao campo CB7_DIVERG.
@param cPausa, character, Valor referente ao campo CB7_STATPA.
@param cStatus, character, Valor referente ao campo CB7_STATUS.
@return cLabel, character, Label para o status da ordem de separação.
/*/
Method getStatusOrdemSeparacao(cDivergencia as character, cPausa as character, cStatus as character) as character class ACOMPANHAPEDIDOS
    Local cLabel := "" as character

    If cDivergencia == STATUS_CB7_DIVERGENCIA
        cLabel := STR0099 // "Divergência"

    ElseIf cPausa == STATUS_CB7_PAUSA
        cLabel := STR0100 // "Pausa"

    Else
        cLabel := cStatus

        If cStatus == STATUS_CB7_INICIO
            cLabel := STR0101 // "Inicio"

        ElseIf cStatus == STATUS_CB7_SEPARANDO
            cLabel := STR0102 // "Separando"

        ElseIf cStatus == STATUS_CB7_SEP_FINAL
            cLabel := STR0103 // "Sep.Final"

        ElseIf cStatus == STATUS_CB7_EMBALANDO
            cLabel := STR0104 // "Embalando"

        ElseIf cStatus == STATUS_CB7_EMB_FINAL
            cLabel := STR0105 // "Emb.Final"

        ElseIf cStatus == STATUS_CB7_GERA_NOTA
            cLabel := STR0106 // "Gera Nota"

        ElseIf cStatus == STATUS_CB7_IMP_NOTA
            cLabel := STR0107 // "Imp.nota"

        ElseIf cStatus == STATUS_CB7_IMP_VOL
            cLabel := STR0108 // "Imp.Vol"

        ElseIf cStatus == STATUS_CB7_EMBARCADO
            cLabel := STR0109 // "Embarcado"

        ElseIf cStatus == STATUS_CB7_EMBARQUE_FINAL
            cLabel := STR0110 // "Embarque Finalizado"

        EndIf
    EndIf

Return cLabel
