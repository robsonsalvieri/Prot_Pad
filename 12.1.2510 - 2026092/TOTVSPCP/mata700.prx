/*/
Function a700Vis(cAlias,nReg,nOpc)
   Local aBut700 := {}
   
   If GetMv("MV_SELEOPC") == "S"
      AAdd(aBut700,{, {|| A700Opc() },STR0011} ) // Botao Opcionais
   EndIf
   
   AxVisual(cAlias,nReg,nOpc,,,,,aBut700)
   
Return

