/*/{Protheus.doc} MRPLookups
API para retorno dos dados dos lookups do MRP.
@author Lucas Fagundes
@since 28/07/2026
@version P12
/*/
Class MRPLookups

    public method new() as object

    @Get("api/pcp/v1/MRPLookups/setups")
    public method getSetup() as logical
    private method processGetSetup(nPage as numeric, nPageSize as numeric, cFilter as character, lOnlyCreated as logical, lReturnMultiple as logical) as array
    private method getParametrosSetup(cCodigoSetup as character) as json

    @Get("api/pcp/v1/MRPLookups/setups/:value")
    public method getSetupByValue() as logical

    @Get("api/pcp/v1/MRPLookups/seletivos/documents")
    public method getDocuments() as logical
    private method processGetDocuments(nPage as numeric, nPageSize as numeric, cFilter as character, lFilterIN as logical) as array

    @Get("api/pcp/v1/MRPLookups/seletivos/documents/:value")
    public method getDocumentsByValue() as logical

    @Get("api/pcp/v1/MRPLookups/seletivos/warehouses")
    public method getWarehouses() as logical
    private method processGetWarehouses(nPage as numeric, nPageSize as numeric, cFilter as character, lMultiple as logical, lOnlyCreated as logical, lFiltraIN as logical) as array

    @Get("api/pcp/v1/MRPLookups/seletivos/warehouses/:value")
    public method getWarehousesByValue() as logical

    @Get("api/pcp/v1/MRPLookups/seletivos/demandCodes")
    public method getDemandCodes() as logical
    private method processGetDemandCodes(nPage as numeric, nPageSize as numeric, cFilter as character, lFiltraIN as logical) as array

    @Get("api/pcp/v1/MRPLookups/seletivos/demandCodes/:value")
    public method getDemandCodesByValue() as logical

    @Post("api/pcp/v1/MRPLookups/pontosEntrada/P712VLD")
    public method postExecutaP712VLD() as logical
    private method processPostExecutaP712VLD(jParams as json) as array

    private method trataErrorLogProcessamento(oError as object) as array
    private method setRespostaRest(aResposta as array) as logical

EndClass

