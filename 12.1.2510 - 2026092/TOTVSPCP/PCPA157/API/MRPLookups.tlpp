/*/{Protheus.doc} processGetWarehouses
Processa a API de busca de armazéns para os seletivos do MRP.
@author Lucas Fagundes
@since 03/08/2026
@version P12
@param nPage, Numeric, Número da página.
@param nPageSize, Numeric, Tamanho da página.
@param cFilter, Character, Filtro para busca dos armazéns.
@param lFiltraIN, Logical, Indica se o filtro informado é uma lista, neste caso filtra a query com a cláusula IN.
@return aReturn, Array, Array com informações de retorno da API.
/*/
Method processGetWarehouses(nPage as numeric, nPageSize as numeric, cFilter as character, lFiltraIN as logical) as array class MRPLookups
    Local aReturn           := Array(2)  as array
    Local cAlias            := ""        as character
    Local cQuery            := ""        as character
    Local jItem             := {}        as json
    Local jResponse         := {}        as json
    Local lRealizaPaginacao := nPage > 0 as logical
    Local nCount            := 0         as numeric
    Local nPosParam         := 1         as numeric
    Local nStatusResponse   := 200       as numeric
    Local oStatement        := Nil       as object

    cQuery := " SELECT NNR.NNR_CODIGO, "
    cQuery +=        " NNR.NNR_DESCRI "
    cQuery +=   " FROM " + RetSqlName("NNR") + " NNR "
    cQuery +=  " WHERE NNR.NNR_FILIAL = ? "
    If !Empty(cFilter)
        If lFiltraIN
            cQuery += " AND NNR.NNR_CODIGO IN (?) "
        Else
            cQuery += " AND NNR.NNR_CODIGO LIKE ? "
        EndIf
    EndIf
    cQuery +=    " AND NNR.D_E_L_E_T_ = ' ' "

    oStatement := FwExecStatement():New(cQuery)
    oStatement:setString(nPosParam++, xFilial("NNR")) // NNR_FILIAL
    If !Empty(cFilter)
        If lFiltraIN
            oStatement:setIn(nPosParam++, StrTokArr(cFilter, ",")) // NNR_CODIGO

        Else
            oStatement:setString(nPosParam++, cFilter + "%") // NNR_CODIGO

        EndIf
    EndIf

    cAlias := oStatement:openAlias()

    If nPage > 1 .And. nPageSize > 0
        (cAlias)->(dbSkip((nPage - 1) * nPageSize))
    EndIf

    jResponse := JsonObject():New()
    jResponse["items"  ] := {}
    jResponse["hasNext"] := .F.

    While (cAlias)->(!EoF())
        nCount++

        jItem := {;
            "codigo": (cAlias)->NNR_CODIGO,;
            "descricao": (cAlias)->NNR_DESCRI;
        }

        aAdd(jResponse["items"], jItem)

        (cAlias)->(dbSkip())
        If lRealizaPaginacao .And. nCount >= nPageSize
            Exit
        EndIf
    End

    jResponse["hasNext"] := (cAlias)->(!EoF())
    (cAlias)->(dbCloseArea())

    aReturn[1] := nStatusResponse
    aReturn[2] := jResponse

Return aReturn

