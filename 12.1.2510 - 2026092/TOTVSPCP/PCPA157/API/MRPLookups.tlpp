/*/{Protheus.doc} processGetDemandCodes
Processa a API de busca de códigos de demanda para os seletivos do MRP.
@author Lucas Fagundes
@since 03/08/2026
@version P12
@param nPage, Numeric, Número da página.
@param nPageSize, Numeric, Tamanho da página.
@param cFilter, Character, Filtro para busca dos códigos de demanda.
@param lFiltraIN, Logical, Indica se o filtro informado é uma lista, neste caso filtra a query com a cláusula IN.
@return aReturn, Array, Array com informações de retorno da API.
/*/
Method processGetDemandCodes(nPage as numeric, nPageSize as numeric, cFilter as character, lFiltraIN as logical) as array class MRPLookups
    Local aFiltro           := {}        as array
    Local aReturn           := Array(2)  as array
    Local cAlias            := ""        as character
    Local cQuery            := ""        as character
    Local jItem             := {}        as json
    Local jResponse         := {}        as json
    Local lFiltroLike       := .T.       as logical
    Local lRealizaPaginacao := nPage > 0 as logical
    Local nCount            := 0         as numeric
    Local nPosParam         := 1         as numeric
    Local oStatement        := Nil       as object

    If lFiltraIN
        lFiltroLike := .F.
        aFiltro     := StrTokArr(cFilter, ",")
    EndIf

    cQuery := " SELECT SVB.VB_CODIGO, "
    cQuery +=        " SVB.VB_DTINI, "
    cQuery +=        " SVB.VB_DTFIM "
    cQuery +=   " FROM " + RetSqlName("SVB") + " SVB "
    cQuery +=  " WHERE SVB.VB_FILIAL = ? "
    If !Empty(cFilter)
        If lFiltroLike
            cQuery += " AND SVB.VB_CODIGO LIKE ? "

        ElseIf lFiltraIN
            cQuery += " AND SVB.VB_CODIGO IN (?) "

        EndIf
    EndIf
    cQuery +=    " AND SVB.D_E_L_E_T_ = ' ' "

    oStatement := FwExecStatement():New(cQuery)
    oStatement:setString(nPosParam++, xFilial("SVB")) // VB_FILIAL
    If !Empty(cFilter)
        If lFiltroLike
            oStatement:setString(nPosParam++, cFilter + "%") // VB_CODIGO

        ElseIf lFiltraIN
            oStatement:setIn(nPosParam++, aFiltro) // VB_CODIGO

        EndIf
    EndIf

    cAlias := oStatement:openAlias()

    TcSetField(cAlias, 'VB_DTINI', 'D', GetSx3Cache("VB_DTINI", "X3_TAMANHO"), 0)
    TcSetField(cAlias, 'VB_DTFIM', 'D', GetSx3Cache("VB_DTFIM", "X3_TAMANHO"), 0)

    If nPage > 1 .And. nPageSize > 0
        (cAlias)->(dbSkip((nPage - 1) * nPageSize))
    EndIf

    jResponse := JsonObject():New()
    jResponse["items"  ] := {}
    jResponse["hasNext"] := .F.

    While (cAlias)->(!EoF())
        nCount++

        jItem := {;
            "codigo": (cAlias)->VB_CODIGO,;
            "dataInicio": DToC((cAlias)->VB_DTINI),;
            "dataFim": DToC((cAlias)->VB_DTFIM);
        }

        aAdd(jResponse["items"], jItem)

        (cAlias)->(dbSkip())
        If lRealizaPaginacao .And. nCount >= nPageSize
            Exit
        EndIf
    End

    jResponse["hasNext"] := (cAlias)->(!EoF())
    (cAlias)->(dbCloseArea())

    aReturn[1] := 200
    aReturn[2] := jResponse
Return aReturn

/*/{Protheus.doc} postExecutaP712VLD
API para executar o ponto de entrada P712VLD.
endpoint: [POST] api/pcp/v1/MRPLookups/pontosEntrada/P712VLD

@author Lucas Fagundes
@since 04/08/2026
@version P12
@return lRet, Logical, Retorna se processou com sucesso a requisição.
/*/
Method postExecutaP712VLD() as logical class MRPLookups
    Local aReturnData := {}                 as array
    Local jBody       := JsonObject():New() as json
    Local lRet        := .T.                as logical

    oRest:setKeyHeaderResponse("Content-Type","application/json")

    jBody:FromJson(oRest:getBodyRequest())

    TRY
        aReturnData := self:processPostExecutaP712VLD(jBody)
    CATCH oError
        aReturnData := self:trataErrorLogProcessamento(oError)
    ENDTRY

    lRet := self:setRespostaRest(aReturnData)
Return lRet

/*/{Protheus.doc} processPostExecutaP712VLD
Processa a API para executar o ponto de entrada P712VLD.
@author Lucas Fagundes
@since 04/08/2026
@version P12
@param jParams, Json, JSON com os parâmetros para execução do MRP.
@return aReturn, Array, Array com informações de retorno da API.
/*/
Method processPostExecutaP712VLD(jParams as json) as array class MRPLookups
    Local aReturn := Array(2) as array
    Local lRetPE  := .T.      as logical

    If ExistBlock("P712VLD")
        lRetPE := ExecBlock("P712VLD", .F., .F., {"COCKPIT_MRP", jParams:ToJson()})
    EndIf

    aReturn[1] := 200
    aReturn[2] := { "success": lRetPE }

Return aReturn
