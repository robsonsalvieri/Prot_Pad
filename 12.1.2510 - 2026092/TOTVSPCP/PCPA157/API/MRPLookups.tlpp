/*/{Protheus.doc} trataErrorLogProcessamento
Realiza o tratamento de erros que ocorreram no processamento de algum endpoint.

@author Lucas Fagundes
@since 28/07/2026
@version P12
@param oError, Object, Objeto de error lançado pelo sistema.
@return aReturn, Array, Array com informações de retorno da API.
/*/
Method trataErrorLogProcessamento(oError as object) as array class MRPLookups
    Local aReturn := Array(2) as array

    aReturn[1] := 500
    aReturn[2] := { "code": "500", "message": STR0100, "detailedMessage": oError:description } // "Ocorreu um erro no processamento."

    LogMsg("MRPLookups", 0, 0, 1, "", "", AllTrim(oError:description) + CHR(10) + AllTrim(oError:errorStack))

Return aReturn

/*/{Protheus.doc} setRespostaRest
(long_description)
@author Lucas Fagundes
@since 28/07/2026
@version P12
@param aResposta, Array, Array com as informações do processamento da API, segue o formato: [statusCode: numeric, responseData: json]
@return lRet, Logical, Retorna se processou com sucesso a requisição.
/*/
Method setRespostaRest(aResposta as array) as logical class MRPLookups
    Local lRet := .T. as logical

    oRest:setStatusCode(aResposta[1])
    lRet := oRest:setResponse(aResposta[2]:toJson())

    FreeObj(aResposta[2])
    aSize(aResposta, 0)
Return lRet

/*/{Protheus.doc} getSetup
API de busca dos setups do MRP.
endpoint: [GET] api/pcp/v1/MRPLookups/setups

QUERYPARAM:
page (numeric) -> Número da página a ser retornada.
pageSize (numeric) -> Número de itens por página.
filter (character) -> Filtro para busca dos setups.

@author Lucas Fagundes
@since 28/07/2026
@version P12
@return lRet, Logical, Retorna se processou com sucesso a requisição.
/*/
Method getSetup() as logical class MRPLookups
    Local aReturnData  := {}  as array
    Local jQueryParams := {}  as json
    Local lRet         := .T. as logical

    oRest:setKeyHeaderResponse("Content-Type","application/json")

    jQueryParams := oRest:getQueryRequest()

    If (jQueryParams:hasProperty("page"))
        jQueryParams["page"] := Val(jQueryParams["page"])
    EndIf

    If (jQueryParams:hasProperty("pageSize"))
        jQueryParams["pageSize"] := Val(jQueryParams["pageSize"])
    EndIf

    TRY
        aReturnData := self:processGetSetup(jQueryParams["page"], jQueryParams["pageSize"], jQueryParams["filter"], .T., .T.)
    CATCH oError
        aReturnData := self:trataErrorLogProcessamento(oError)
    ENDTRY

    lRet := self:setRespostaRest(aReturnData)
Return lRet

/*/{Protheus.doc} getSetupByValue
API de busca dos setups do MRP por valor.
endpoint: [GET] api/pcp/v1/MRPLookups/setups/:value

PATHPARAM:
value (character) -> Código do setup a ser buscado.

@author Lucas Fagundes
@since 30/07/2026
@version P12
@return lRet, Logical, Retorna se processou com sucesso a requisição.
/*/
Method getSetupByValue() as logical class MRPLookups
    Local aReturnData   := {}                                      as array
    Local jPathParams   := {}                                      as json
    Local lRet          := .T.                                     as logical
    Local nTamanhoSetup := GetSX3Cache("HW2_CODIGO", "X3_TAMANHO") as numeric

    oRest:setKeyHeaderResponse("Content-Type","application/json")

    jPathParams := oRest:getPathParamsRequest()

    TRY
        If Len(jPathParams["value"]) > nTamanhoSetup
            aReturnData := Array(2)
            aReturnData[1] := 400
            aReturnData[2] := { "code": "400", "message": STR0101, "detailedMessage": i18n(STR0102, {nTamanhoSetup}) } // "Código informado é inválido!" "Código informado possui tamanho superior ao tamanho do campo. Informe um código com tamanho menor ou igual a #1[tamanho]# caracteres."
        Else
            aReturnData := self:processGetSetup(1, 1, jPathParams["value"], .F., .F.)
        EndIf
    CATCH oError
        aReturnData := self:trataErrorLogProcessamento(oError)
    ENDTRY

    lRet := self:setRespostaRest(aReturnData)
Return lRet

/*/{Protheus.doc} processGetSetup
Processa a API de busca de setups do MRP.
@author Lucas Fagundes
@since 28/07/2026
@version P12
@param nPage, Numeric, Número da página.
@param nPageSize, Numeric, Tamanho da página.
@return aReturn, Array, Array com informações de retorno da API.
/*/
Method processGetSetup(nPage as numeric, nPageSize as numeric, cFilter as character, lOnlyCreated as logical, lReturnMultiple as logical) as array class MRPLookups
    Local aReturn         := Array(2) as array
    Local cAlias          := ""       as character
    Local cQuery          := ""       as character
    Local jItem           := {}       as json
    Local jResponse       := {}       as json
    Local nCount          := 0        as numeric
    Local nPosParam       := 1        as numeric
    Local nStatusResponse := 200      as numeric
    Local oStatement      := Nil      as object

    cQuery := " SELECT DISTINCT HW2.HW2_CODIGO, "
    cQuery +=                 " HW2.HW2_DESCRI "
    cQuery +=   " FROM " + RetSqlName("HW2") + " HW2 "
    cQuery +=  " WHERE HW2.HW2_FILIAL = ? "
    If !Empty(cFilter)
        cQuery += " AND HW2.HW2_CODIGO = ? "
    EndIf
    cQuery +=    " AND HW2.D_E_L_E_T_ = ' ' "

    oStatement := FwExecStatement():New(cQuery)
    oStatement:setString(nPosParam++, xFilial("HW2")) // HW2_FILIAL
    If !Empty(cFilter)
        oStatement:setString(nPosParam++, cFilter) // HW2_CODIGO
    EndIf

    cAlias := oStatement:openAlias()

    If nPage > 1 .And. nPageSize > 0
        (cAlias)->(dbSkip((nPage - 1) * nPageSize))
    EndIf

    jResponse := JsonObject():New()
    If lReturnMultiple
        jResponse["items"  ] := {}
        jResponse["hasNext"] := .F.
    EndIf

    If (cAlias)->(!EoF())

        While (cAlias)->(!EoF())
            nCount++

            jItem := {;
                "codigo": (cAlias)->(HW2_CODIGO),;
                "descricao": (cAlias)->(HW2_DESCRI),;
                "parametros": Self:getParametrosSetup((cAlias)->(HW2_CODIGO)),;
                "created": .T.;
            }

            If lReturnMultiple
                aAdd(jResponse["items"], jItem)
            Else
                jResponse := jItem
            EndIf

            (cAlias)->(dbSkip())
            If nCount >= nPageSize
                Exit
            EndIf
        End

        jResponse["hasNext"] := (cAlias)->(!EoF())
    ElseIf !Empty(cFilter)

        If lOnlyCreated
            nStatusResponse := 404
            jResponse := { "code": "404", "message": STR0103, "detailedMessage": i18n(STR0104, {cFilter}) } // "Setup não encontrado." "O setup #1[codigo]# não existe."
        Else
            jResponse := {;
                "codigo": cFilter,;
                "descricao": "",;
                "parametros": JsonObject():New(),;
                "created": .F.;
            }
        EndIf

    EndIf
    (cAlias)->(dbCloseArea())

    aReturn[1] := nStatusResponse
    aReturn[2] := jResponse

    oStatement:destroy()
    oStatement := Nil
Return aReturn

/*/{Protheus.doc} getParametrosSetup
(long_description)
@author Lucas Fagundes
@since 28/07/2026
@version P12
@param cCodigoSetup, Character, Código do setup.
@return jParametros, Json, JSON com os parâmetros do setup.
/*/
Method getParametrosSetup(cCodigoSetup as character) as json class MRPLookups
    Local cAlias      := getNextAlias()     as character
    Local cParametro  := ""                 as character
    Local cValue      := ""                 as character
    Local jParametros := JsonObject():New() as json

    BeginSQL Alias cAlias
        SELECT HW2.HW2_PARAM,
               HW2.HW2_VALOR,
               HW2.HW2_LISTA
          FROM %table:HW2% HW2
         WHERE HW2.HW2_FILIAL = %xFilial:HW2%
           AND HW2.HW2_CODIGO = %exp:cCodigoSetup%
           AND HW2.%notDel%
    EndSQL

    While (cAlias)->(!EoF())
        cParametro := RTrim((cAlias)->HW2_PARAM)
        cValue     := (cAlias)->HW2_VALOR

        If Empty((cAlias)->HW2_VALOR)
            cValue := (cAlias)->HW2_LISTA
        EndIf

        jParametros[cParametro] := RTrim(cValue)

        (cAlias)->(dbSkip())
    End
    (cAlias)->(dbCloseArea())

Return jParametros

