@author Lucas Fagundes
@since 03/08/2026
@version P12
@return lRet, Logical, Retorna se processou com sucesso a requisição.
/*/
Method getDocuments() as logical class MRPLookups
    Local aReturnData  := {}  as array
    Local jQueryParams := {}  as json
    Local lRet         := .T. as logical

    oRest:setKeyHeaderResponse("Content-Type","application/json")

    jQueryParams := oRest:getQueryRequest()

    If (jQueryParams:hasProperty("page"))
        jQueryParams["page"] := Val(jQueryParams["page"])
    EndIf

    If (jQueryParams:hasProperty("pageSize"))
        jQueryParams["pageSize"] := Val(jQueryParams["pageSize"])
    EndIf

    TRY
        aReturnData := self:processGetDocuments(jQueryParams["page"], jQueryParams["pageSize"], jQueryParams["filter"], .F.)
    CATCH oError
        aReturnData := self:trataErrorLogProcessamento(oError)
    ENDTRY

    lRet := self:setRespostaRest(aReturnData)

Return lRet

/*/{Protheus.doc} getDocumentsByValue
API de busca dos documentos para os seletivos do MRP por valor.
endpoint: [GET] api/pcp/v1/MRPLookups/seletivos/documents/:value

PATHPARAM:
value (character) -> Código do documento a ser buscado.

@author Lucas Fagundes
@since 03/08/2026
@version P12
@return lRet, Logical, Retorna se processou com sucesso a requisição.
/*/
Method getDocumentsByValue() as logical class MRPLookups
    Local aReturnData  := {}  as array
    Local jPathParams  := {}  as json
    Local jQueryParams := {}  as json
    Local lRet         := .T. as logical

    oRest:setKeyHeaderResponse("Content-Type","application/json")

    jPathParams  := oRest:getPathParamsRequest()
    jQueryParams := oRest:getQueryRequest()

    If jQueryParams:hasProperty("filterIN")
        jQueryParams["filterIN"] := jQueryParams["filterIN"] == "true"
    EndIf

    TRY
        aReturnData := self:processGetDocuments(0, 0, jPathParams["value"], jQueryParams["filterIN"])
    CATCH oError
        aReturnData := self:trataErrorLogProcessamento(oError)
    ENDTRY

    lRet := self:setRespostaRest(aReturnData)
Return lRet

/*/{Protheus.doc} processGetDocuments
Processa a API de busca de documentos para os seletivos do MRP.
@author Lucas Fagundes
@since 03/08/2026
@version P12
@param nPage, Numeric, Número da página.
@param nPageSize, Numeric, Tamanho da página.
@param cFilter, Character, Filtro para busca dos documentos.
@param lFilterIN, Logical, Indica se o filtro informado é uma lista, neste caso filtra a query com a cláusula IN.
@return aReturn, Array, Array com informações de retorno da API.
/*/
Method processGetDocuments(nPage as numeric, nPageSize as numeric, cFilter as character, lFilterIN as logical) as array class MRPLookups
    Local aFiltro           := {}        as array
    Local aReturn           := Array(2)  as array
    Local cAlias            := ""        as character
    Local cQuery            := ""        as character
    Local jItem             := {}        as json
    Local jResponse         := {}        as json
    Local lFiltroLike       := .T.       as logical
    Local lRealizaPaginacao := nPage > 0 as logical
    Local nCount            := 0         as numeric
    Local nPosParam         := 1         as numeric
    Local oStatement        := Nil       as object

    If lFilterIN
        lFiltroLike := .F.
        aFiltro     := StrTokArr(cFilter, ",")
    EndIf

    cQuery := " SELECT DISTINCT SVR.VR_DOC "
    cQuery +=   " FROM " + RetSqlName("SVR") + " SVR "
    cQuery +=  " WHERE SVR.VR_FILIAL = ? "
    cQuery +=    " AND SVR.VR_DOC   != ' ' "
    If !Empty(cFilter)
        If lFiltroLike
            cQuery += " AND SVR.VR_DOC LIKE ? "
        ElseIf lFilterIN
            cQuery += " AND SVR.VR_DOC IN (?) "
        EndIf
    EndIf
    cQuery +=    " AND SVR.D_E_L_E_T_ = ' ' "

    oStatement := FwExecStatement():New(cQuery)
    oStatement:setString(nPosParam++, xFilial("SVR")) // VR_FILIAL
    If !Empty(cFilter)
        If lFiltroLike
            oStatement:setString(nPosParam++, cFilter + "%") // VR_DOC
        ElseIf lFilterIN
            oStatement:setIn(nPosParam++, aFiltro) // VR_DOC
        EndIf
    EndIf

    cAlias := oStatement:openAlias()

    If nPage > 1 .And. nPageSize > 0
        (cAlias)->(dbSkip((nPage - 1) * nPageSize))
    EndIf

    jResponse := JsonObject():New()
    jResponse["items"  ] := {}
    jResponse["hasNext"] := .F.

    While (cAlias)->(!EoF())
        nCount++

        jItem := {;
            "documento": (cAlias)->VR_DOC;
        }

        aAdd(jResponse["items"], jItem)

        (cAlias)->(dbSkip())
        If lRealizaPaginacao .And. nCount >= nPageSize
            Exit
        EndIf
    End

    jResponse["hasNext"] := (cAlias)->(!EoF())
    (cAlias)->(dbCloseArea())

    aReturn[1] := 200
    aReturn[2] := jResponse
Return aReturn

