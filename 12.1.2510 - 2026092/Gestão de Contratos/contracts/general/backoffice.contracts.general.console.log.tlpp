#INCLUDE 'tlpp-core.th'

namespace totvs.protheus.backoffice.contracts.general

/*/{Protheus.doc} ConsoleLog
    @description Centraliza o registro de mensagens e erros de log do processo.
    @type class
    @author guilherme.sordi@totvs.com.br
    @since 08/06/2026
    @version 12.1.2510
*/

class ConsoleLog
	public method new() constructor
	static method warning(cMessage as character)
	static method info(cMessage as character)
	static method error(oError as object)
endClass

//-------------------------------------------------------------------
/*/{Protheus.doc} new
	@author guilherme.sordi@totvs.com.br
	@since 08/03/2024
	@type method
	@version 12.1.2310
/*/
//-------------------------------------------------------------------
method new() Class ConsoleLog
return Self

method info(cMessage as character) class ConsoleLog
	local aMessage	:= {} as array
	local cGroupLogMsg 		:= FunName()
	local cCategoryLogMsg 	:= 'LoggerInfoMessage'
	
	aAdd(aMessage, {"[INFO]", cMessage})

	FwLogMsg("INFO", /*cTransactionId*/, cGroupLogMsg, cCategoryLogMsg, "", FunName(), '', /*nMensure*/, /*nElapseTime*/, aMessage)
return

//-------------------------------------------------------------------
/*/{Protheus.doc} error
	@description Loga mensagem de erro no console
	@author rafael.rondon
	@since 18/09/2024
	@type method
	@version 12.1.2310
/*/
//-------------------------------------------------------------------
method error(oError as object ) class ConsoleLog
	local aMessage	:= {} as array
	local cGroupLogMsg 		:= FunName()
	local cCategoryLogMsg 	:= 'LoggerErrorMessage'
	
	aAdd(aMessage, {"Description", oError:description})
	aAdd(aMessage, {"ErrorStack", oError:errorStack})

	FwLogMsg("ERROR", /*cTransactionId*/, cGroupLogMsg, cCategoryLogMsg, "", FunName(), '', /*nMensure*/, /*nElapseTime*/, aMessage)
return

/*/{Protheus.doc} warning
    @description Registra mensagem de aviso no log padronizado do processo.
    @author guilherme.sordi@totvs.com.br
    @since 08/06/2026
    @version 12.1.2510
/*/

method warning(cMessage as character) class ConsoleLog
	local aMessage	:= {} as array
	local cGroupLogMsg 		:= FunName()
	local cCategoryLogMsg 	:= 'LoggerWarningMessage'
	
	aAdd(aMessage, {"[WARNING]", cMessage})

	FwLogMsg("WARN", /*cTransactionId*/, cGroupLogMsg, cCategoryLogMsg, "", FunName(), '', /*nMensure*/, /*nElapseTime*/, aMessage)
return
