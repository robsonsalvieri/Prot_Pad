#include "totvs.ch"
#include "msobject.ch"
#include "tlpp-core.th"

namespace totvs.protheus.backoffice.contracts.general

/*/{Protheus.doc} ThreadLock
    @description Controla o bloqueio e desbloqueio de regiões críticas entre threads.
    @type class
    @author guilherme.sordi@totvs.com.br
    @since 08/06/2026
    @version 12.1.2510
*/

class ThreadLock	
	public method new() as object
	static method lock(cOperation as character, nRetryInterval as numeric) as logical
	static method unlock(cOperation as character) as logical
endClass

/*/{Protheus.doc} new
    @description Inicializa a instância da classe com seus valores padrão.
    @author guilherme.sordi@totvs.com.br
    @since 08/06/2026
    @version 12.1.2510
/*/

method new() as object class ThreadLock
return self

/*/{Protheus.doc} lock
    @description Obtém bloqueio exclusivo para a operação informada.
    @author guilherme.sordi@totvs.com.br
    @since 08/06/2026
    @version 12.1.2510
/*/

method lock(cOperation as character, nRetryInterval as numeric) as logical class ThreadLock
	local lLock := .F. as logical
	local lTimeout := .F. as logical
	local nSecondsWaiting := 0 as numeric
	local nStart := seconds() as numeric

	default nRetryInterval := 2000
	
	while !lLock .and. !lTimeout
		lLock := lockByName("GCT"+cOperation, .T., .T.)
		if !lLock
			sleep(nRetryInterval) 
			nSecondsWaiting := seconds() - nStart
			lTimeout := nSecondsWaiting > 120
			ConsoleLog():info("Waiting for lock on operation " + cOperation + " - " + tlpp.toStr(nSecondsWaiting) + " seconds")
		endIf
	endDo
return lLock

/*/{Protheus.doc} unlock
    @description Libera o bloqueio da operação informada.
    @author guilherme.sordi@totvs.com.br
    @since 08/06/2026
    @version 12.1.2510
/*/

method unlock(cOperation as character) as logical class ThreadLock
return unlockByName("GCT"+cOperation, .T., .T.)
