#include "totvs.ch"
#include "msobject.ch"
#include "tlpp-core.th"

namespace totvs.protheus.backoffice.contracts.adjustment

/*/{Protheus.doc} ThreadData
    @description Encapsula os dados de execucao de uma thread. Responsavel por armazenar, atualizar e sincronizar informacoes de progresso em variaveis globais.
    @type class
    @author guilherme.sordi@totvs.com.br
    @since 25/05/2026
    @version 12.1.2510
*/
class ThreadData
	private data nThreadId as numeric
	private data cAdjustmentNumber as character
	private data cFromContract as character
	private data cToContract as character
	private data nSecondsStamp as numeric
	private data cStatus as character	
	private data nCurrentContractDone as numeric
	private data nTotalContracts as numeric
	
	public method new(nThreadId as numeric, cAdjustmentNumber as character, cFromContract as character, cToContract as character) as object
	public method toJson() as character
	public method setTotalContracts(nTotal as numeric) as object
	public method incrementCurrentContractDone() as object
	public method setFinished() as object
	public method setError() as object
	
	private method getGlobalVarName() as character
	private method postGlobalVar() as object
	private method setStatus(cStatus as character) as object
endClass

/*/{Protheus.doc} new
    @description Inicializa uma nova instancia de ThreadData com informacoes do ajuste e contrato.
    @param nThreadId Identificador da thread.
    @param cAdjustmentNumber Numero do ajuste de contrato.
    @param cFromContract Contrato de origem.
    @param cToContract Contrato de destino.
    @return Instancia de ThreadData inicializada.
    @author guilherme.sordi@totvs.com.br
    @since 25/05/2026
    @version 12.1.2510
*/
method new(nThreadId as numeric, cAdjustmentNumber as character, cFromContract as character, cToContract as character) as object class ThreadData
    self:nThreadId := nThreadId
    self:cAdjustmentNumber := cAdjustmentNumber
    self:cFromContract := cFromContract
    self:cToContract := cToContract
	self:nCurrentContractDone := 0
	self:nTotalContracts := 1
	self:setStatus("running")
	self:postGlobalVar()
return self

/*/{Protheus.doc} toJson
    @description Serializa os dados de execucao da thread para formato JSON.
    @return String JSON com todos os dados da thread.
    @author guilherme.sordi@totvs.com.br
    @since 25/05/2026
    @version 12.1.2510
*/
method toJson() as character class ThreadData
	local oJson := JsonObject():New() as json
	oJson["threadId"] := self:nThreadId
	oJson["adjustmentNumber"] := self:cAdjustmentNumber
	oJson["fromContract"] := self:cFromContract
	oJson["toContract"] := self:cToContract
	oJson["currentContractDone"] := self:nCurrentContractDone
	oJson["totalContracts"] := self:nTotalContracts
	oJson["status"] := self:cStatus
	oJson["secondsStamp"] := self:nSecondsStamp
return oJson:toJson()

/*/{Protheus.doc} getGlobalVarName
    @description Obtem o nome da variavel global onde os dados desta thread sao armazenados.
    @return Nome da variavel global.
    @author guilherme.sordi@totvs.com.br
    @since 25/05/2026
    @version 12.1.2510
*/
method getGlobalVarName() as character class ThreadData
return ThreadManager():globalVarNameFromId(self:nThreadId)

/*/{Protheus.doc} postGlobalVar
    @description Sincroniza os dados da thread para uma variavel global.
    @return Instancia de ThreadData para encadeamento de chamadas.
    @author guilherme.sordi@totvs.com.br
    @since 25/05/2026
    @version 12.1.2510
*/
method postGlobalVar() as object class ThreadData
	self:nSecondsStamp := seconds()
	PutGlbValue(self:getGlobalVarName(), self:toJson())
return self

/*/{Protheus.doc} setTotalContracts
    @description Define o total de contratos a processar e sincroniza com variavel global.
    @param nTotal Quantidade total de contratos.
    @return Instancia de ThreadData para encadeamento de chamadas.
    @author guilherme.sordi@totvs.com.br
    @since 25/05/2026
    @version 12.1.2510
*/
method setTotalContracts(nTotal as numeric) as object class ThreadData
	self:nTotalContracts := nTotal
	self:postGlobalVar()
return self

/*/{Protheus.doc} incrementCurrentContractDone
    @description Incrementa o contador de contratos ja processados.
    @return Instancia de ThreadData para encadeamento de chamadas.
    @author guilherme.sordi@totvs.com.br
    @since 25/05/2026
    @version 12.1.2510
*/
method incrementCurrentContractDone() as object class ThreadData
	self:nCurrentContractDone += 1
	self:postGlobalVar()
return self

/*/{Protheus.doc} setFinished
    @description Define o status como finalizado e sincroniza com variavel global.
    @return Instancia de ThreadData para encadeamento de chamadas.
    @author guilherme.sordi@totvs.com.br
    @since 25/05/2026
    @version 12.1.2510
*/
method setFinished() as object class ThreadData
	self:setStatus("finished")
	self:postGlobalVar()
return self

/*/{Protheus.doc} setError
    @description Define o status como erro e sincroniza com variavel global.
    @return Instancia de ThreadData para encadeamento de chamadas.
    @author guilherme.sordi@totvs.com.br
    @since 25/05/2026
    @version 12.1.2510
*/
method setError() as object class ThreadData
	self:setStatus("error")
	self:postGlobalVar()
return self

/*/{Protheus.doc} setStatus
    @description Define o status da thread com validacao.
    @param cStatus Novo status (running|finished|error).
    @return Instancia de ThreadData para encadeamento de chamadas.
    @author guilherme.sordi@totvs.com.br
    @since 25/05/2026
    @version 12.1.2510
*/
method setStatus(cStatus as character) as object class ThreadData
	self:cStatus := "unknown"
	if cStatus $ "running|finished|error"
		self:cStatus := cStatus
	endIf
return self
