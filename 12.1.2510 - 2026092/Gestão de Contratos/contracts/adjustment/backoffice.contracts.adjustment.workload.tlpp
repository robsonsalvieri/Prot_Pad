#include "totvs.ch"
#include "msobject.ch"
#include "tlpp-core.th"

#INCLUDE "GCTXDEF.CH"

namespace totvs.protheus.backoffice.contracts.adjustment

//-------------------------------------------------------------------
/*/{Protheus.doc} ContractAdjustmentWorkload
	@description Concentra a montagem da query de carga de trabalho do reajuste automatico de contratos.
	@type class
	@author guilherme.sordi@totvs.com.br
	@since 19/05/2026
	@version 12.1.2510
*/
//-------------------------------------------------------------------
class ContractAdjustmentWorkload
	private data cContract as character
	private data cContractTypeFilter as character
	private data cWorksheetTypeFilter as character
	private data cCustomerFilter as character
	private data cCustomerStoreFilter as character
	private data cSupplierFilter as character
	private data cSupplierStoreFilter as character
	private data dReferenceDate as date
	private data dAdjustmentDate as date

	public method new(cContract as character, cContractTypeFilter as character, cWorksheetTypeFilter as character, cCustomerFilter as character, cCustomerStoreFilter as character, cSupplierFilter as character, cSupplierStoreFilter as character, dReferenceDate as date, dAdjustmentDate as date) as object
	public method buildQuery() as character

	private method buildContractsWithItemsQuery() as character
	private method buildContractsWithoutItemsQuery() as character
	private method appendCustomerOrSupplierFilter(cQuery as character) as character
	private method appendCustomQuery(cQuery as character, nQuerySection as numeric, nQuerySegment as numeric) as character
	private method hasContractNextAdjustmentField() as logical
endClass

/*/{Protheus.doc} new
	@description Armazena os parametros usados na construcao da carga de trabalho do reajuste.
	@author guilherme.sordi@totvs.com.br
	@since 19/05/2026
	@version 12.1.2510
/*/
method new(cContract as character, cContractTypeFilter as character, cWorksheetTypeFilter as character, cCustomerFilter as character, cCustomerStoreFilter as character, cSupplierFilter as character, cSupplierStoreFilter as character, dReferenceDate as date, dAdjustmentDate as date) as object class ContractAdjustmentWorkload
	self:cContract := cContract
	self:cContractTypeFilter := cContractTypeFilter
	self:cWorksheetTypeFilter := cWorksheetTypeFilter
	self:cCustomerFilter := cCustomerFilter
	self:cCustomerStoreFilter := cCustomerStoreFilter
	self:cSupplierFilter := cSupplierFilter
	self:cSupplierStoreFilter := cSupplierStoreFilter
	self:dReferenceDate := dReferenceDate
	self:dAdjustmentDate := dAdjustmentDate
return self

/*/{Protheus.doc} buildQuery
	@description Monta e retorna a mesma query SQL usada para carregar a carga de trabalho do reajuste.
	@author guilherme.sordi@totvs.com.br
	@since 19/05/2026
	@version 12.1.2510
/*/
method buildQuery() as character class ContractAdjustmentWorkload
	local cQuery := "" as character

	cQuery += self:buildContractsWithItemsQuery()
	cQuery += " UNION ALL  "
	cQuery += self:buildContractsWithoutItemsQuery()
	cQuery += " ORDER BY CN9_NUMERO,CN9_REVISA "
return ChangeQuery(cQuery)

/*/{Protheus.doc} buildContractsWithItemsQuery
	@description Monta o bloco completo da query para contratos com itens vinculados na planilha.
	@author guilherme.sordi@totvs.com.br
	@since 19/05/2026
	@version 12.1.2510
/*/
method buildContractsWithItemsQuery() as character class ContractAdjustmentWorkload
	local cQuery := "" as character

	cQuery += " SELECT "
	cQuery += " CN9.CN9_NUMERO,  "
	cQuery += " CN9.CN9_REVISA,  "
	cQuery += " CN9.CN9_INDICE,  "
	cQuery += " CNA.CNA_NUMERO,  "
	cQuery += " CNA.CNA_INDICE,  "
	cQuery += " CNB.CNB_DTREAJ DTREAJ, "
	cQuery += " CNA.CNA_PROXRJ PROXRJ, "
	cQuery += " CNB.CNB_VLUNIT VLANT, "
	cQuery += " CNB.CNB_ITEM, "
	cQuery += " CNB.CNB_INDICE "
	cQuery := self:appendCustomQuery(cQuery, 1, 1)
	cQuery += " FROM " + RetSqlName("CN9") + " CN9 "
	cQuery += " INNER JOIN " + RetSqlName("CNA") + " CNA ON("
	cQuery += " 	CNA.CNA_FILIAL = CN9.CN9_FILIAL"
	cQuery += " AND CNA.CNA_CONTRA = CN9.CN9_NUMERO"
	cQuery += " AND CNA.CNA_REVISA = CN9.CN9_REVISA"
	cQuery += " AND CNA.CNA_FLREAJ = CN9.CN9_FLGREJ"
	cQuery += " AND CNA.D_E_L_E_T_ = ' ') "
	cQuery += " INNER JOIN " + RetSqlName("CNB") + " CNB ON("
	cQuery += " 	CNB.CNB_FILIAL = CNA.CNA_FILIAL "
	cQuery += " AND CNB.CNB_CONTRA = CNA.CNA_CONTRA "
	cQuery += " AND CNB.CNB_REVISA = CNA.CNA_REVISA "
	cQuery += " AND CNB.CNB_NUMERO = CNA.CNA_NUMERO "
	cQuery += " AND (CNB.CNB_FLREAJ = CNA.CNA_FLREAJ OR CNB.CNB_FLREAJ = ' ')"
	cQuery += " AND CNB.D_E_L_E_T_ = ' ')"
	cQuery += " WHERE "
	cQuery += " CN9.CN9_FILIAL = '" + FWxFilial("CN9") + "' "

	if !Empty(self:cContract)
		cQuery += "  AND " + self:cContract
	endIf

	cQuery += " AND CN9.CN9_SITUAC = '" + DEF_SVIGE + "' "
	cQuery += " AND CN9.CN9_FLGREJ = '1' "
	cQuery += " AND CN9_REVATU='" + Space(GetSX3Cache("CN9_REVATU", "X3_TAMANHO")) + "' "

	if self:hasContractNextAdjustmentField()
		cQuery += " AND CN9.CN9_PROXRJ <= '" + DtoS(self:dAdjustmentDate) + "'"
	endIf

	cQuery += " AND CN9.D_E_L_E_T_ = ' ' "

	if !Empty(self:cContractTypeFilter)
		cQuery += " AND " + self:cContractTypeFilter
	endIf

	cQuery += " AND (CNA.CNA_PROXRJ = '' OR CNA.CNA_PROXRJ <= '" + DtoS(self:dAdjustmentDate) + "')"
	cQuery += " AND CNA.CNA_SALDO > 0"
	cQuery := self:appendCustomerOrSupplierFilter(cQuery)

	if !Empty(self:cWorksheetTypeFilter)
		cQuery += " AND " + self:cWorksheetTypeFilter
	endIf

	cQuery += " AND CNB.CNB_ITMDST = ' ' "
	cQuery += " AND (CNB.CNB_SLDMED > 0 OR CNB_QTDORI = 0)"
	cQuery += "  AND EXISTS ( SELECT 1   "
	cQuery += "               FROM " + RetSqlName("CN6") + " CN6, " + RetSqlName("CN7") + " CN7 "
	cQuery += "               WHERE CN6.CN6_FILIAL = '" + xFilial("CN6") + "' "
	cQuery += "               AND CN6.CN6_CODIGO = (  "
	cQuery += "                   CASE   "
	cQuery += "                   WHEN CNB.CNB_INDICE <> ' ' THEN CNB.CNB_INDICE "
	cQuery += "                   WHEN CNA.CNA_INDICE <> ' ' THEN CNA.CNA_INDICE "
	cQuery += "                   WHEN CN9.CN9_INDICE <> ' ' THEN CN9.CN9_INDICE "
	cQuery += "                   END  "
	cQuery += "                   ) "
	cQuery += "               AND CN6.D_E_L_E_T_ = ' ' "
	cQuery += "               AND CN7.CN7_FILIAL = '" + xFilial("CN7") + "' "
	cQuery += "               AND CN7.CN7_CODIGO = CN6.CN6_CODIGO "
	cQuery += "               AND CN7.D_E_L_E_T_ = ' ' "
	cQuery += "               AND (  "
	cQuery += "                      CASE   "
	cQuery += "                      WHEN CN6.CN6_TIPO = '1' AND CN7.CN7_DATA = '" + DtoS(self:dReferenceDate) + "' THEN 'TRUE' "
	cQuery += "                      WHEN CN6.CN6_TIPO = '2' AND CN7.CN7_COMPET = '" + StrZero(Month(self:dReferenceDate), 2) + "/" + StrZero(Year(self:dReferenceDate), 4) + "' THEN 'TRUE'  "
	cQuery += "                      ELSE 'FALSE'  "
	cQuery += "                      END  "
	cQuery += "                    ) = 'TRUE' "
	cQuery += "               )  "
	cQuery := self:appendCustomQuery(cQuery, 1, 2)
return cQuery

/*/{Protheus.doc} buildContractsWithoutItemsQuery
	@description Monta o bloco completo da query para contratos sem itens vinculados na planilha.
	@author guilherme.sordi@totvs.com.br
	@since 19/05/2026
	@version 12.1.2510
/*/
method buildContractsWithoutItemsQuery() as character class ContractAdjustmentWorkload
	local cQuery := "" as character

	cQuery += " SELECT   "
	cQuery += " CN9.CN9_NUMERO,  "
	cQuery += " CN9.CN9_REVISA, "
	cQuery += " CN9.CN9_INDICE, "
	cQuery += " CNA.CNA_NUMERO, "
	cQuery += " CNA.CNA_INDICE, "
	cQuery += " CNA.CNA_DTREAJ DTREAJ, "
	cQuery += " CNA.CNA_PROXRJ PROXRJ, "
	cQuery += " CNA.CNA_VLTOT VLANT, "
	cQuery += " cast(' ' as varchar(" + AllTrim(Str(TamSX3("CNB_ITEM")[1])) + ")) as CNB_ITEM, "
	cQuery += " cast(' ' as varchar(" + AllTrim(Str(TamSX3("CNB_INDICE")[1])) + ")) as CNB_INDICE "
	cQuery := self:appendCustomQuery(cQuery, 2, 1)
	cQuery += " FROM "
	cQuery += RetSqlName("CN9") + " CN9,"
	cQuery += RetSqlName("CNA") + " CNA "
	cQuery += " WHERE "
	cQuery += " CN9.CN9_FILIAL = '" + FWxFilial("CN9") + "' "

	if !Empty(self:cContract)
		cQuery += "  AND " + self:cContract
	endIf

	cQuery += " AND CN9.CN9_SITUAC = '" + DEF_SVIGE + "' "
	cQuery += " AND CN9.CN9_FLGREJ = '1' "
	cQuery += " AND CN9_REVATU='" + Space(GetSX3Cache("CN9_REVATU", "X3_TAMANHO")) + "' "

	if self:hasContractNextAdjustmentField()
		cQuery += " AND CN9.CN9_PROXRJ <= '" + DtoS(self:dAdjustmentDate) + "'"
	endIf

	cQuery += " AND CN9.D_E_L_E_T_ = ' ' "

	if !Empty(self:cContractTypeFilter)
		cQuery += " AND " + self:cContractTypeFilter
	endIf

	cQuery += " AND CNA.CNA_FILIAL = CN9.CN9_FILIAL "
	cQuery += " AND CNA.CNA_CONTRA = CN9.CN9_NUMERO "
	cQuery += " AND CNA.CNA_REVISA = CN9.CN9_REVISA "
	cQuery += " AND CNA.CNA_FLREAJ = '1' "
	cQuery += " AND (CNA.CNA_PROXRJ = '' OR CNA.CNA_PROXRJ <= '" + DtoS(self:dAdjustmentDate) + "')"
	cQuery += " AND CNA.CNA_SALDO > 0"
	cQuery += " AND CNA.D_E_L_E_T_ = ' ' "
	cQuery := self:appendCustomerOrSupplierFilter(cQuery)

	if !Empty(self:cWorksheetTypeFilter)
		cQuery += " AND " + self:cWorksheetTypeFilter
	endIf

	cQuery += " AND NOT EXISTS ( SELECT 1 "
	cQuery += "                  FROM " + RetSqlName("CNB") + " CNB "
	cQuery += "                  WHERE CNB.CNB_FILIAL = CNA.CNA_FILIAL "
	cQuery += "                  AND CNB.CNB_CONTRA = CNA.CNA_CONTRA  "
	cQuery += "                  AND CNB.CNB_REVISA = CNA.CNA_REVISA  "
	cQuery += "                  AND CNB.CNB_NUMERO = CNA.CNA_NUMERO "
	cQuery += "                  AND CNB.D_E_L_E_T_ = ' ' )"
	cQuery += " AND EXISTS ( SELECT 1   "
	cQuery += "              FROM " + RetSqlName("CN6") + " CN6, " + RetSqlName("CN7") + " CN7 "
	cQuery += "              WHERE CN6.CN6_FILIAL = '" + xFilial("CN6") + "' "
	cQuery += "              AND CN6.CN6_CODIGO = (  "
	cQuery += "                                      CASE   "
	cQuery += "                                      WHEN CNA.CNA_INDICE <> ' ' THEN CNA.CNA_INDICE "
	cQuery += "                                      WHEN CN9.CN9_INDICE <> ' ' THEN CN9.CN9_INDICE "
	cQuery += "                                      END  "
	cQuery += "                                      ) "
	cQuery += "              AND CN6.D_E_L_E_T_ = ' ' "
	cQuery += "              AND CN7.CN7_FILIAL = '" + xFilial("CN7") + "' "
	cQuery += "              AND CN7.CN7_CODIGO = CN6.CN6_CODIGO "
	cQuery += "              AND CN7.D_E_L_E_T_ = ' ' "
	cQuery += "              AND ("
	cQuery += "                   CASE   "
	cQuery += "                   WHEN CN6.CN6_TIPO = '1' AND CN7.CN7_DATA = '" + DtoS(self:dReferenceDate) + "' THEN 'TRUE' "
	cQuery += "                   WHEN CN6.CN6_TIPO = '2' AND CN7.CN7_COMPET = '" + StrZero(Month(self:dReferenceDate), 2) + "/" + StrZero(Year(self:dReferenceDate), 4) + "' THEN 'TRUE'  "
	cQuery += "                   ELSE 'FALSE'  "
	cQuery += "                   END  "
	cQuery += "                  ) = 'TRUE' "
	cQuery += "               ) "
	cQuery := self:appendCustomQuery(cQuery, 2, 2)
return cQuery

/*/{Protheus.doc} appendCustomerOrSupplierFilter
	@description Adiciona os filtros opcionais de cliente ou fornecedor na query.
	@author guilherme.sordi@totvs.com.br
	@since 19/05/2026
	@version 12.1.2510
/*/
method appendCustomerOrSupplierFilter(cQuery as character) as character class ContractAdjustmentWorkload
	if !Empty(self:cCustomerFilter)
		cQuery += " AND " + self:cCustomerFilter

		if !Empty(self:cCustomerStoreFilter)
			cQuery += " AND " + self:cCustomerStoreFilter
		endIf
	elseif !Empty(self:cSupplierFilter)
		cQuery += " AND " + self:cSupplierFilter

		if !Empty(self:cSupplierStoreFilter)
			cQuery += " AND " + self:cSupplierStoreFilter
		endIf
	endIf
return cQuery

/*/{Protheus.doc} appendCustomQuery
	@description Aplica o ponto de entrada de customizacao da query quando disponivel.
	@author guilherme.sordi@totvs.com.br
	@since 19/05/2026
	@version 12.1.2510
/*/
method appendCustomQuery(cQuery as character, nQuerySection as numeric, nQuerySegment as numeric) as character class ContractAdjustmentWorkload
	local cCustomQuery := "" as character

	if ExistBlock("CN310QRY")
		cCustomQuery := ExecBlock("CN310QRY", .F., .F., { cQuery, nQuerySection, nQuerySegment })

		if ValType(cCustomQuery) == "C"
			cQuery += cCustomQuery
		endIf
	endIf
return cQuery

/*/{Protheus.doc} hasContractNextAdjustmentField
	@description Informa se o campo de proximo reajuste existe na CN9 para aplicar o filtro correspondente.
	@author guilherme.sordi@totvs.com.br
	@since 19/05/2026
	@version 12.1.2510
/*/
method hasContractNextAdjustmentField() as logical class ContractAdjustmentWorkload
return CN9->(ColumnPos("CN9_PROXRJ")) > 0
