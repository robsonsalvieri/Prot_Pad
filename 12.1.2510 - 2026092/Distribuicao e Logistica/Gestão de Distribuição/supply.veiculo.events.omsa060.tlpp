#include 'fw-tlpp-core.th'
#include "protheus.ch"
#INCLUDE "OMSA060.CH"
#include "totvs.framework.model.events.th"

namespace totvs.protheus.supply.veiculo.events

/*/-----------------------------------------------------------
{Protheus.doc} supply.veiculo.events.omsa060 
Classe de eventos do cadastro de veículos
Documentação técnica SMART X 
https://tdn.totvs.com/pages/releaseview.action?pageId=900448160

@author Rafael Souza
@since 17/03/2025
@version 1.0
-----------------------------------------------------------/*/ 
class OMSA060
    public method new() as object 

    @beforeCreateInTransaction()
    public method beforeCreateInTransaction()

    @afterUpdateInTransaction()
    public method afterUpdateInTransaction()

    @beforeDeleteInTransaction()
    public method beforeDeleteInTransaction()

    @afterDeleteInTransaction()
    public method afterDeleteInTransaction()

EndClass


Method new() as object class OMSA060
Return self

/*/-----------------------------------------------------------
{Protheus.doc} beforeDeleteInTransaction 
Evento executado antes de deletar os objetos contidos no modelo 
em uma transação

@author Rafael Souza
@since 17/03/2025
@version 1.0
-----------------------------------------------------------/*/ 
method beforeDeleteInTransaction(oData as object, oModel as object, oError as object) class OMSA060

    local lRet      as logical
    local cCodvei   as character 
    local cQuery    as character
    local cCodBem   as character
    Local cMntTms   as character
    local lContVei  as logical
    local lIntGFE   as logical 
    local oQuery    as object
    
    
    cMntTms     := SuperGetMV('MV_NGMNTMS',,'N') //-- Ativa integracao TMS X MNT 
    lContVei    := SuperGetMV('MV_CONTVEI',,.T.) //-- Verifica se o sistema controla veiculo/motorista
    lIntGFE     := SuperGetMv("MV_INTGFE",.F.,.F.) // Integração TMS / OMS x GFE
    
    lRet := .T.

    If nModulo == 39 //SIGAOMS 
        cCodvei := oData:getFieldValue("DA3", "DA3_COD")
        DbSelectArea("DA8")
        DbSetOrder(2)
        If DbSeek(xFilial("DA8")+ cCodvei )
            oError:set(400, "DeleteError", "DS0600611" + "-" + STR0049) //"Veículo utilizado em rotas de entregas, exclusão não permitida."
            lRet := .f.
        EndIf

        //-- Nao permite a exclusao do veiculo quando o mesmo esta amarrado a uma montagem de cargas.
        If lRet 
            cQuery := " SELECT COUNT(DAK_CAMINH) CAMINH "
            cQuery += " FROM "+RetSqlName("DAK")+" DAK "
            cQuery += " WHERE DAK.DAK_FILIAL = ? " 
            cQuery += " AND DAK.DAK_CAMINH = ? "
            cQuery += " AND DAK.D_E_L_E_T_ = ? " 

            cQuery := changeQuery(cQuery)
            oQuery := FwExecStatement():New(cQuery)
            oQuery:setString(1,FWxFilial( 'DAK' ))
            oQuery:setString(2,cCodvei)
            oQuery:setString(3,' ') 

            If oQuery:ExecScalar('CAMINH') > 0
                oError:set(400, "DeleteError", "OMSA06007" + "-" + STR0007 + STR0050) //"O veiculo está em uso na Montagem de Carga, exclusão nao permitida!"
                lRet := .f.
            EndIf

            oQuery:Destroy()
        EndIf

        If lRet 
            cQuery := " SELECT COUNT(DAE_CODVEI) DAE_CODVEI "
            cQuery += " FROM "+RetSqlName("DAE")+" DAE "
            cQuery += " WHERE DAE.DAE_FILIAL = ? " 
            cQuery += " AND DAE.DAE_CODVEI = ? "
            cQuery += " AND DAE.D_E_L_E_T_ = ? " 

            cQuery := changeQuery(cQuery)
            oQuery := FwExecStatement():New(cQuery)
            oQuery:setString(1,FWxFilial( 'DAE' ))
            oQuery:setString(2,cCodvei)
            oQuery:setString(3,' ') 

            If oQuery:ExecScalar('DAE_CODVEI') > 0
                oError:set(400, "DeleteError", "OMSA06006" + "-" + STR0007 + STR0051) //"O veiculo está em uso no cadastro de regras, nao pode ser excluido!"
                lRet := .f.
            EndIf

            oQuery:Destroy()
        EndIf 
    EndIf 

    If nModulo == 43 .And. cMntTms == "S" .And. lRet //- Integração TMS x MNT
        cCodBem := oData:getFieldValue("DA3", "DA3_CODBEM") 
        DbSelectArea("STF")
        STF->(DbSetOrder(1))
        If !Empty(cCodBem) .And. MsSeek(xFilial("STF")+AllTrim(cCodBem))
            oError:set(400, "DeleteError", STR0052 + STR0053) //"Existe ordem de servico para o bem, não é permitido a exclusão!"
            lRet := .f.
        EndIf 

        DbSelectArea("STJ")
        STJ->(DbSetOrder(2))
        If !Empty(cCodBem) .And. MsSeek(xFilial("STJ")+ "B" +AllTrim(cCodBem))
            oError:set(400, "DeleteError", STR0052 + STR0053) //"Existe ordem de servico para o bem, não é permitido a exclusão!"
            lRet := .F.
        ElseIf lRet .And. !Empty(cCodBem) .And. MsSeek(xFilial("STJ")+ "L" +AllTrim(cCodBem))
            oError:set(400, "DeleteError", STR0052 + STR0053) //"Existe ordem de servico para o bem, não é permitido a exclusão!"
            lRet := .F.
        EndIf
        
    ElseIf nModulo == 43 .And. lRet   
        cCodvei := oData:getFieldValue("DA3", "DA3_COD") 
        cQuery := " SELECT COUNT(DTR_CODVEI) CODVEI "
        cQuery += " FROM "+RetSqlName("DTR")+" DTR "
        cQuery += " WHERE DTR.DTR_FILIAL = ? " 
        cQuery += " AND ( DTR_CODVEI = ?"
		cQuery += " OR DTR_CODRB1 = ? "
        cQuery += " OR DTR_CODRB2 = ? "
		cQuery += " OR DTR_CODRB3 = ? ) "
        cQuery += " AND DTR.D_E_L_E_T_ = ? " 

        cQuery := changeQuery(cQuery)
        oQuery := FwExecStatement():New(cQuery)
        oQuery:setString(1,FWxFilial( 'DTR' ))
        oQuery:setString(2,cCodvei)
        oQuery:setString(3,cCodvei)
        oQuery:setString(4,cCodvei)
        oQuery:setString(5,cCodvei)
        oQuery:setString(6,' ') 

        If oQuery:ExecScalar('CODVEI') > 0
            oError:set(400, "DeleteError", STR0007 + STR0008 ) //"O Veiculo, nao pode ser excluido pois esta sendo utilizado na Viagem. "
            lRet := .f.
        EndIf
        oQuery:Destroy()

        If lRet .And. lContVei
          
            cQuery := " SELECT COUNT(DTU_CODVEI) DTU_CODVEI "
            cQuery += " FROM "+RetSqlName("DTU")+" DTU "
            cQuery += " WHERE DTU.DTU_FILIAL = ? " 
            cQuery += " AND DTU.DTU_CODVEI = ? "
            cQuery += " AND DTU.D_E_L_E_T_ = ? " 

            cQuery := changeQuery(cQuery)
            oQuery := FwExecStatement():New(cQuery)
            oQuery:setString(1,FWxFilial( 'DTU' ))
            oQuery:setString(2,cCodvei)
            oQuery:setString(3,' ') 

            If oQuery:ExecScalar('DTU_CODVEI') > 0
                oError:set(400, "DeleteError",  STR0007 + STR0009 ) //"O Veiculo, não pode ser excluido pois esta sendo utilizado no Movimento de Veiculos. "
                lRet := .f.
            EndIf

            oQuery:Destroy()
        EndIf 
    EndIf 

    //--Verifica se existe Pedido de Venda vinculado ao Veículo
    If lRet
        cCodvei := oData:getFieldValue("DA3", "DA3_COD") 
        cQuery := " SELECT COUNT(C5_VEICULO) VEICULO "
        cQuery += " FROM "+RetSqlName("SC5")+" SC5 "
        cQuery += " WHERE SC5.C5_FILIAL = ? " 
        cQuery += " AND SC5.C5_VEICULO = ? "
        cQuery += " AND SC5.D_E_L_E_T_ = ? " 

        cQuery := changeQuery(cQuery)
        oQuery := FwExecStatement():New(cQuery)
        oQuery:setString(1,FWxFilial( 'SC5' ))
        oQuery:setString(2,cCodvei)
        oQuery:setString(3,' ') 

        If oQuery:ExecScalar('VEICULO') > 0
            oError:set(400, "DeleteError", "OMSA06015" + "-" + STR0007 + STR0048 ) // "O veiculo está em uso no de Pedido de Venda, exclusão nao permitida."
            lRet := .f.
        EndIf

        oQuery:Destroy()
    EndIf

    If lRet .And. lIntGFE
        cCodvei := oData:getFieldValue("DA3", "DA3_COD") 
        GU8->(dbSetOrder(1)) //GU8_FILIAL+GU8_CDVEIC
        If GU8->(DbSeek(xFilial("GU8")+cCodvei )) 
            RecLock('GU8', .F. )
            GU8->(DbDelete())
            GU8->(MsUnLock("GU8"))
        EndIf		
    EndIf   

return lRet

/*/-----------------------------------------------------------
{Protheus.doc} beforeDeleteInTransaction 
Evento executado depois de deletar os objetos contidos no modelo 
em uma transação

@author Rafael Souza
@since 17/03/2025
@version 1.0
-----------------------------------------------------------/*/ 
method afterDeleteInTransaction(oData as object, oModel as object, oError as object) class OMSA060

    local lRet      as logical
    local cMntTms   as character
    local lRestRepom as logical
    local cCodBem   as character
    local cCodVei   as character

    cMntTms     := SuperGetMV('MV_NGMNTMS',,'N') //Ativa integracao TMS X MNT 
    lRestRepom  := SuperGetMV( 'MV_VSREPOM',, '1' ) == '2.2'
    lRet        := .T. 

    If nModulo == 43 .And. cMntTms == "S"
        //Altera a categoria do bem para nao integrado ao TMS.
        cCodBem := oData:getFieldValue("DA3", "DA3_CODBEM") 
        dbSelectArea("ST9")
        dbSetOrder(1)
        If dbSeek(xFilial("ST9")+cCodBem)
            RecLock("ST9",.F.)
            ST9->T9_CATBEM := "4"
            ST9->T9_CODTMS := Space(Len(ST9->T9_CODTMS))
            MsUnlock("ST9")
            lRet := .T. 
        Else 
            oError:set(400, "DeleteError", STR0047) //"O vínculo do veículo, não foi removido do BEM."
            lRet := .F. 
        EndIf
        
    EndIf 

    If lRestRepom .And. oData:getFieldValue("DA3", "DA3_FROVEI") == "2"  .And. oData:getFieldValue("DA3", "DA3_INTOPE") == "2" //Terceiro e REPOM 
        cCodVei := oData:getFieldValue("DA3", "DA3_COD") 
        lRet := TMSVeiLoc( cCodVei, .T., "Delete" )
        If !lRet
             oError:set(400, "DeleteError", STR0007 + STR0046 ) //"O veiculo não foi excluído na REPOM."
        EndIf  
    EndIf 



return lRet 


/*/-----------------------------------------------------------
{Protheus.doc} afterUpdateInTransaction 
Evento executado após atualizar os objetos contidos no modelo em uma transação

@author Rafael Souza
@since 01/04/2025
@version 1.0
-----------------------------------------------------------/*/ 
method afterUpdateInTransaction(oData as object, oModel as object, oError as object) class OMSA060

    local lRet          as logical
    local lRestRepom    as logical
    local cCodVei       as character
    
    lRestRepom  := SuperGetMV( 'MV_VSREPOM',, '1' ) == '2.2'
    lRet := .T.

    If lRestRepom .And. oData:getFieldValue("DA3", "DA3_FROVEI") == "2"  .And. oData:getFieldValue("DA3", "DA3_INTOPE") == "2" .And. oData:getFieldValue("DA3", "DA3_INTEGR") == "2"//Terceiro e REPOM 
        cCodVei := oData:getFieldValue("DA3", "DA3_COD") 
        lRet := TMSVehic( cCodVei )
        If lRet
            DA3->(DbSetOrder(1))
            If DA3->(DbSeek( FWxFilial("DA3") + cCodVei ) ) 
                RecLock( "DA3", .F.)
                DA3->DA3_INTEGR := "1"
                DA3->( MsUnlock() )
            EndIf  
        Else 
            oError:set(400, "UpdateError", STR0007 + STR0045) //"O veiculo não foi atualizado na REPOM."
        EndIf 
    EndIf

 return lRet  

/*/-----------------------------------------------------------
{Protheus.doc} beforeCreateInTransaction 
Evento executado antes de criar um objeto em uma transação por objeto

@author Rafael Souza
@since 04/04/2025
@version 1.0
-----------------------------------------------------------/*/ 
method beforeCreateInTransaction(oData as object, oModel as object, oError as object) class OMSA060
    local lRet          as logical
    local lIntGFE       as logical 
    local aCabAux       as array
    local aMaster       as array
    local cMsgErr       as character

    lIntGFE := SuperGetMv("MV_INTGFE",.F.,.F.)
    lRet    := .T. 

    If lRet .And. lIntGFE
   
        aCabAux := {}
        aMaster := {} 

        Aadd( aCabAux, { "GU8_FILIAL" , xFilial("GU8")  , Nil } )
	    Aadd( aCabAux, { "GU8_CDVEIC" , oData:getFieldValue("DA3", "DA3_COD")       , Nil } )
	    Aadd( aCabAux, { "GU8_CDTPVC" , oData:getFieldValue("DA3", "DA3_TIPVEI")    , Nil } )
	    Aadd( aCabAux, { "GU8_PLACA"  , oData:getFieldValue("DA3", "DA3_PLACA")     , Nil } )
        Aadd( aCabAux, { "GU8_UFPLAC" , oData:getFieldValue("DA3", "DA3_ESTPLA")    , Nil } )
        Aadd( aCabAux, { "GU8_ALTUR"  , oData:getFieldValue("DA3", "DA3_ALTEXT")    , Nil } )
        Aadd( aCabAux, { "GU8_LARGUR" , oData:getFieldValue("DA3", "DA3_LAREXT")    , Nil } )
        Aadd( aCabAux, { "GU8_COMPRI" , oData:getFieldValue("DA3", "DA3_COMEXT")    , Nil } )
        Aadd( aCabAux, { "GU8_VOLUT"  , oData:getFieldValue("DA3", "DA3_VOLMAX")    , Nil } )
        Aadd( aCabAux, { "GU8_CARGUT" , oData:getFieldValue("DA3", "DA3_CAPACM")    , Nil } )
        Aadd( aCabAux, { "GU8_PBT"    , oData:getFieldValue("DA3", "DA3_CAPACN")    , Nil } )
        Aadd( aCabAux, { "GU8_TPPROP" , IIF(oData:getFieldValue("DA3", "DA3_FROVEI") == "1","2","1")    , Nil } )
        Aadd( aCabAux, { "GU8_CDPROP" , GFEXINPROP(oData:getFieldValue("DA3", "DA3_CODFOR"),oData:getFieldValue("DA3", "DA3_LOJFOR"))   , Nil } )
        Aadd( aCabAux, { "GU8_TARA"   , oData:getFieldValue("DA3", "DA3_TARA")      , Nil } )
        Aadd( aCabAux, { "GU8_MMOD"   , oData:getFieldValue("DA3", "DA3_DESC")      , Nil } )
        Aadd( aCabAux, { "GU8_ANOFAB" , oData:getFieldValue("DA3", "DA3_ANOFAB")    , Nil } )
        Aadd( aCabAux, { "GU8_RENAVA" , oData:getFieldValue("DA3", "DA3_RENAVA")    , Nil } )
        Aadd( aCabAux, { "GU8_CIV"    , oData:getFieldValue("DA3", "DA3_CIV")       , Nil } )
        Aadd( aCabAux, { "GU8_CIPP"   , oData:getFieldValue("DA3", "DA3_CIPP")      , Nil } )

        If oData:getFieldValue("DA3", "DA3_ATIVO") == "2"
            Aadd( aCabAux, { "GU8_SIT" , "2"         , Nil } )
            Aadd( aCabAux, { "GU8_DSSIT" , STR0034   , Nil } ) // "Veículo Inativo"
        Else
            Aadd( aCabAux, { "GU8_DSSIT" , STR0038   , Nil } ) // "Veiculo Ativo                                     
        EndIf


        Aadd( aMaster ,{} )
	    Aadd( aMaster[Len(aMaster)] , aClone(aCabAux) )
	    Aadd( aMaster[Len(aMaster)] , "GFEA046_GU8" )
	    Aadd( aMaster[Len(aMaster)] , "GU8" )

	    lRet	:= TMSExecAuto( "GFEA046" ,  aMaster  ,,  3  , .T. , @cMsgErr  )

        If !lRet 
            oError:set(400, "UpdateError", "OMSA06018" - STR0036 + cMsgErr) //"Inconsistência com o Frete Embarcador (SIGAGFE): "
        EndIf  

    EndIf  

return lRet 


/*/-----------------------------------------------------------
{Protheus.doc} Om060Blq 
Bloqueio e Desbloqueio de veículos na Filial
Params: cCode == Código do Veículo marcado no grid (DA3_COD)
        cTpMov == L - Liberado / B - Bloqueado
@author Rafael Souza
@since 22/04/2025
@version 1.0
-----------------------------------------------------------/*/ 
Function Om060Blq(cCode, cTpMov)

local cMsg      as character
local oQuery    as object
local cTipVei   as character
local cCatVei   as character
 
cMsg := ""

DA3->(DbSetOrder(1))
If DA3->(DbSeek(FWxFilial("DA3") + cCode))
    cTipVei := DA3->DA3_TIPVEI 
EndIf

DUT->(DbSetOrder(1))
If DUT->(DbSeek(FWxFilial("DUT") + cTipVei))
    cCatVei := DUT->DUT_CATVEI
EndIf 

If cCatVei == '3'// Carreta 
    cQuery := " SELECT COUNT(?) DTR_CODVEI FROM " //1
    cQuery += RetSqlName('DTR') + " DTR "
    cQuery += " JOIN " + RetSqlName("DTQ") + " DTQ "
    cQuery += " ON DTQ.DTQ_FILIAL = DTR.DTR_FILIAL " 
    cQuery += " AND DTQ.DTQ_FILORI = DTR.DTR_FILORI " 
    cQuery += " AND DTQ.DTQ_VIAGEM = DTR.DTR_VIAGEM "
    cQuery += " WHERE DTR.DTR_FILIAL = ? " //2
    cQuery += " AND (DTR.DTR_CODRB1 = ? " //3
    cQuery += " OR DTR.DTR_CODRB2 = ? "   //4
    cQuery += " OR DTR.DTR_CODRB3 = ? )"   //5
    cQuery += " AND DTR.D_E_L_E_T_ = ? " //6
    cQuery += " AND DTQ.DTQ_STATUS NOT IN ( '3', '9' )"
    cQuery += " AND DTQ.D_E_L_E_T_ = ? " //7

    cQuery := changeQuery(cQuery)
    oQuery := FwExecStatement():New(cQuery)
    oQuery:setString(1,cCode)
    oQuery:setString(2,FWxFilial( 'DTR' ))
    oQuery:setString(3,cCode)
    oQuery:setString(4,cCode)
    oQuery:setString(5,cCode)
    oQuery:setString(6,' ') 
    oQuery:setString(7,' ') 

Else 
    cQuery := " SELECT COUNT(DTR_CODVEI) DTR_CODVEI FROM "
    cQuery += RetSqlName('DTR') + " DTR, "
    cQuery += RetSqlName('DTQ') + " DTQ  "
    cQuery += "  WHERE DTR.DTR_FILIAL = ? " //1
    cQuery += "    AND DTR.DTR_CODVEI = ? " //2
    cQuery += "    AND DTR.D_E_L_E_T_ = ? " //3
    cQuery += "    AND DTQ.DTQ_FILIAL = ? " //4
    cQuery += "    AND DTQ.DTQ_FILORI = DTR_FILORI"
    cQuery += "    AND DTQ.DTQ_VIAGEM = DTR_VIAGEM"
    cQuery += "    AND DTQ.DTQ_STATUS NOT IN ( '3', '9' )"
    cQuery += "    AND DTQ.D_E_L_E_T_ = ? " //5

    cQuery := changeQuery(cQuery)
    oQuery := FwExecStatement():New(cQuery)
    oQuery:setString(1,FWxFilial( 'DTR' ))
    oQuery:setString(2,cCode)
    oQuery:setString(3,' ') 
    oQuery:setString(4,FWxFilial( 'DTQ' ))
    oQuery:setString(5,' ') 
     
EndIf

    If oQuery:ExecScalar('DTR_CODVEI') > 0
        cMsg := STR0027 +  STR0028 // Opção inválida. Veículo em viagem.
    Else
        // Verifica se é uma operação válida (Liberação ou Bloqueio)
        If cTpMov == "L" .Or. cTpMov == "B"
            DA3->(DbSetOrder(1))
            If DA3->(DbSeek(FWxFilial("DA3") + cCode))
                If RecLock("DA3", .F.)
                    DA3->DA3_FILATU := cFilAnt
                    DA3->DA3_STATUS := Iif(cTpMov == "L", "2", "1")
                    DA3->(MsUnlock())

                    cMsg := Iif(cTpMov == "L", STR0014 + " " + STR0015 , STR0014 + " " + STR0016 ) //"Veículo Desbloqueado!" ## "Veículo bloqueado!"
                EndIf
            EndIf

        EndIf
    EndIf

    oQuery:Destroy() 
 
return '{"title": "SIGATMS - ", "cMsg": "'+cMsg+'"}' 

/*/-----------------------------------------------------------
{Protheus.doc} Om060AtOpe 
Atualiza os dados do Veiculo no Cadastro da Operadora
Somente REPOM / PAGBEM foi removido o envio do veículo
@author Rafael Souza
@since 25/04/2025
@version 1.0
-----------------------------------------------------------/*/ 
Function Om060AtOpe(cCode)
local cTipVei   as character
local cCatVei   as character
local aCodigos  as array

DA3->(DbSetOrder(1))
If DA3->(DbSeek(FWxFilial("DA3") + cCode))
    cTipVei := DA3->DA3_TIPVEI 
EndIf

DUT->(DbSetOrder(1))
If DUT->(DbSeek(FWxFilial("DUT") + cTipVei))
    cCatVei := DUT->DUT_CATVEI
EndIf 

If cCatVei == '3' //-- Carreta
    aCodigos := {}
    AAdd( aCodigos, {'','','',cCode} )
Else
    aCodigos := {}
    AAdd( aCodigos, {'','',cCode,''} )
EndIf

//-Atualiza veículo na REPOM
RepAtualOp( "01", Iif(cCatVei <> '3', '3', '4'), aCodigos, .T. )

return
