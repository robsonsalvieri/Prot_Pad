#INCLUDE "tlpp-core.th"
#INCLUDE "totvs.ch"
//#INCLUDE "backoffice.stock.costsimulator.componentlevels.ch"

/*/{Protheus.doc} ComponentLevels
    Classe responsavel pelo calculo dos niveis da estrutura
    @type Class
    @author Squad.Entradas
    @since 05/08/2026
    @version 1.0
    /*/
Class ComponentLevels

    Public Data oModel
    Public Data oEvent
    Public Data oNivelD5B
    Public Data nPosComp
    Public Data nPosNiv
    Public Data nPosNivInv

    Public Method New(oModel)
    Public Method execute(cRoot)
    Private Method generateTopDown(cParent, nCurrentLevel)
    Private Method commitCache()
    Private Method getEvent()
    Private Method getFieldIndex(cModelID, cFieldName)

EndClass

/*/{Protheus.doc} New
    Método construtor da classe de calculo de niveis
    @type Method
    @author Squad.Entradas
    @since 05/08/2026
    @version 1.0
    /*/
Method New(oModel) Class ComponentLevels
    Local aPais := {} as Array
    Local cPai  := "" as Character
    Local nI    := 0 as Numeric
    Local nJ    := 0 as Numeric

    ::oModel := oModel
    ::oEvent := ::getEvent()
    
    // Mapeia posição dos campos
    ::nPosComp   := ::GetFieldIndex("D5BDETAIL", "D5B_COMP")
    ::nPosNiv    := ::GetFieldIndex("D5BDETAIL", "D5B_NIV")
    ::nPosNivInv := ::GetFieldIndex("D5BDETAIL", "D5B_NIVINV")
    
    // Clona cache JSON
    ::oNivelD5B := JsonObject():New()
    aPais := ::oEvent:oCacheD5B:GetNames()
    
    For nI := 1 To Len(aPais)
        cPai := RTrim(aPais[nI])
        ::oNivelD5B[cPai] := {}
        For nJ := 1 To Len(::oEvent:oCacheD5B[cPai])
            AAdd(::oNivelD5B[cPai], { ::oEvent:oCacheD5B[cPai][nJ][1], aClone(::oEvent:oCacheD5B[cPai][nJ][2]) })
        Next nJ
    Next nI

Return Self

/*/{Protheus.doc} ESTA101Niv
    Função para realizar o calculo de niveis
    Recebe o model, define o produto pai, instancia a classe e executa o calculo
    @type Funtion
    @author Squad.Entradas
    @since 05/08/2026
    @version 1.0
    /*/
Function ESTA101Niv(oModel)
    Local cProdPai  := "" as Character
    Local oCalNivel := Nil as Object

    ESTA101Sav(oModel)
    // Obtém o Produto Pai Raiz (Root)
    cProdPai := RTrim(oModel:GetModel("D5AMASTER"):GetValue("D5A_CODPRO"))

    oCalNivel := ComponentLevels():New(oModel)
    
    oCalNivel:execute(cProdPai)
    
    FreeObj(oCalNivel)

Return Nil

/*/{Protheus.doc} execute
    Método chamado no calculo de niveis, gerando a recursividade e gravando no cache
    @type Method
    @author Squad.Entradas
    @since 05/08/2026
    @version 1.0
    /*/
Method execute(cRoot) Class ComponentLevels

    ::generateTopDown(RTrim(cRoot), 1, 99)
    ::commitCache()

Return .T.

/*/{Protheus.doc} generateTopDown
    Método que realiza a recursividade dos componentes e niveis
    @type Method
    @author Squad.Entradas
    @since 05/08/2026
    @version 1.0
    /*/
Method generateTopDown(cParent, nCurrentLevel, nInvLevel) Class ComponentLevels
    Local nX     := 0 as Numeric
    Local cFilho := "" as Character
    
    If ::oNivelD5B:HasProperty(cParent)
        
        For nX := 1 To Len(::oNivelD5B[cParent])
            
            // Leitura do codigo do filho
            cFilho := RTrim(::oNivelD5B[cParent][nX][2][::nPosComp])
            
            // Grava os Niveis
            ::oNivelD5B[cParent][nX][2][::nPosNiv]  := StrZero(nCurrentLevel, 2)
            ::oNivelD5B[cParent][nX][2][::nPosNivInv] := StrZero(nInvLevel, 2)
            
            // proximo nivel
            If !Empty(cFilho)
                ::generateTopDown(cFilho, nCurrentLevel + 1, nInvLevel - 1)
            EndIf
            
        Next nX
        
    EndIf
Return

/*/{Protheus.doc} generateTopDown
    Método que realiza a recursividade dos componentes e niveis
    @type Method
    @author Squad.Entradas
    @since 05/08/2026
    @version 1.0
    /*/
Method commitCache() Class ComponentLevels
    Local aPais     := ::oNivelD5B:GetNames() as Array
    Local cPai      := "" as Character
    Local nI        := 0 as Numeric
    Local nJ        := 0 as Numeric
    Local oModelD5B := Nil as Object
    Local nLinha    := 0 as Numeric
    Local nLinhaAtu := 0 as Numeric
    Local cGridPai  := "" as Character
    Local cGridComp := "" as Character
    
    // Atualiza o Cache JSON Original
    For nI := 1 To Len(aPais)
        cPai := RTrim(aPais[nI])
        
        For nJ := 1 To Len(::oNivelD5B[cPai])
            ::oEvent:oCacheD5B[cPai][nJ][2][::nPosNiv]  := ::oNivelD5B[cPai][nJ][2][::nPosNiv]
            ::oEvent:oCacheD5B[cPai][nJ][2][::nPosNivInv] := ::oNivelD5B[cPai][nJ][2][::nPosNivInv]
        Next nJ
    Next nI

    // Sincroniza o Model MVC
    oModelD5B := ::oModel:GetModel("D5BDETAIL")
    
    If oModelD5B != Nil
        nLinhaAtu := oModelD5B:GetLine()
        For nLinha := 1 To oModelD5B:GetQtdLine()
            oModelD5B:GoLine(nLinha)
            
            // Ignora deletadas
            If !oModelD5B:IsDeleted()
                cGridPai  := RTrim(oModelD5B:GetValue("D5B_COD"))
                cGridComp := RTrim(oModelD5B:GetValue("D5B_COMP"))
                
                // Se o Pai existe no cache atualizado, localiza o respectivo filho
                If ::oEvent:oCacheD5B:HasProperty(cGridPai)
                    For nJ := 1 To Len(::oEvent:oCacheD5B[cGridPai])
                        If RTrim(::oEvent:oCacheD5B[cGridPai][nJ][2][::nPosComp]) == cGridComp
                            //carrega os niveis para a linha do model
                            oModelD5B:LoadValue("D5B_NIV", ::oEvent:oCacheD5B[cGridPai][nJ][2][::nPosNiv])
                            oModelD5B:LoadValue("D5B_NIVINV", ::oEvent:oCacheD5B[cGridPai][nJ][2][::nPosNivInv])
                            Exit
                        EndIf
                    Next nJ
                EndIf
            EndIf
        Next nLinha
        If nLinhaAtu > 0
            oModelD5B:GoLine(nLinhaAtu)
        EndIf
    EndIf

Return

/*/{Protheus.doc} generateTopDown
    Método que busca o oEventHandler do evento
    @type Method
    @author Squad.Entradas
    @since 05/08/2026
    @version 1.0
    /*/
Method getEvent() Class ComponentLevels
    Local nIndex  := 0 as Numeric
    Local oEvent  := Nil as Object
    Local oMdlPai := Nil as Object

    If ::oModel != Nil
        oMdlPai := ::oModel:GetModel()
    EndIf

    If oMdlPai != Nil .And. AttIsMemberOf(oMdlPai, "oEventHandler", .T.) .And. oMdlPai:oEventHandler != NIL
        For nIndex := 1 To Len(oMdlPai:oEventHandler:aEvents)
            If oMdlPai:oEventHandler:aEvents[nIndex]:cIdEvent == "ESTA101EVDEF"
                oEvent := oMdlPai:oEventHandler:aEvents[nIndex]
                Exit
            EndIf
        Next nIndex
    EndIf

Return oEvent

/*/{Protheus.doc} generateTopDown
    Método auxiliar para ler estrutura do model e posição dos campos
    @type Method
    @author Squad.Entradas
    @since 05/08/2026
    @version 1.0
    /*/
Method getFieldIndex(cModelID as Character, cFieldName as Character) Class ComponentLevels
    Local aFields := ::oModel:GetModel(cModelID):GetStruct():GetFields() as Array
    Local nPos    := aScan(aFields, {|x| AllTrim(x[3]) == cFieldName}) as Numeric
Return nPos


