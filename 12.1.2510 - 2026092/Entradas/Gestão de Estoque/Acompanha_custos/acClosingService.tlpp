Method isAllBranches(aParams) class acClosingServ

Local lRet := .F.

if aParams[20] == 1
   lRet := .T.
endif

return lRet


Method getBranches() class acClosingServ

Local oRepository   as Object
oRepository :=  ac.branchesList.Repository.acBranchesListRep():new()

return oRepository:listBranches330()

/*/{Protheus.doc} eventUpdateConsumption
Prepara e aciona a thread (StartJob) para o calculo
@type    Method
@author  Paulo Dias Oliveira / Squad Retail
@since   11/05/2026
@version P12
/*/
Method eventUpdateConsumption(aListFil, cCompany, cBranch) Class acClosingServ
	Default aListFil := {}
	Default cCompany := ""
	Default cBranch  := ""

	// Verifica se a tabela D4R existe no dicionário de dados
	If AliasInDic('D4R')
		// Coloca a execução na fila de background
		StartJob('ACExeConsI', GetEnvServer(), .F., aListFil, cCompany, cBranch)
	EndIf
Return .T.

