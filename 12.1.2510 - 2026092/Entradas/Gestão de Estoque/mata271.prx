±±³ Uso      ³ MATA271                                                    ³±±
±±ÀÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ±±
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß
*/
Static Function A271OK()
Return (MsgYesNo(OemToAnsi(STR0011),OemToAnsi(STR0012)))			//"Confirma Sele‡„o?"###"Aten‡„o"

/*
ÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜ
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
±±ÉÍÍÍÍÍÍÍÍÍÍÑÍÍÍÍÍÍÍÍÍÍËÍÍÍÍÍÍÍÑÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍËÍÍÍÍÍÍÑÍÍÍÍÍÍÍÍÍÍÍÍÍ»±±
±±ºPrograma  ³ A271BlindºAutor  ³ Andre Anjos		 º Data ³  02/01/12   º±±
±±ÌÍÍÍÍÍÍÍÍÍÍØÍÍÍÍÍÍÍÍÍÍÊÍÍÍÍÍÍÍÏÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÊÍÍÍÍÍÍÏÍÍÍÍÍÍÍÍÍÍÍÍÍ¹±±
±±ºDescricao ³ Processa bloqueio as cegas                                 º±±
±±ÌÍÍÍÍÍÍÍÍÍÍØÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ¹±±
±±ºUso       ³ MATA271                                                    º±±
±±ÈÍÍÍÍÍÍÍÍÍÍÏÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ¼±±
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß
*/
Function A271Blind()
//-- Ajusta perguntas para processamento as cegas e da data corrente.
Pergunte("MTA271",.F.)

mv_par01 := 1
mv_par02 := Space(TamSX3("B2_LOCAL")[1])
mv_par03 := Replicate("Z", TamSX3("B2_LOCAL")[1])
mv_par04 := Space(TamSX3("B1_COD")[1])
mv_par05 := Replicate("Z",TamSX3("B1_COD")[1])
mv_par06 := Space(TamSX3("B1_TIPO")[1])
mv_par07 := Replicate("Z",TamSX3("B1_TIPO")[1])
mv_par08 := Space(TamSX3("B1_GRUPO")[1])
mv_par09 := Replicate("Z",TamSX3("B1_GRUPO")[1])
mv_par10 := "*"
mv_par11 := dDataBase
mv_par12 := dDataBase
mv_par13 := 2
mv_par14 := dDataBase

//-- Faz chamada ao processamento
A271Proces(.T.)

//-- Atualiza MV_DATAINV com a data de processamento
PutMV("MV_DATAINV",dDataBase)

Return


/*/{Protheus.doc} SchedDef
@author Everton Fregonezi Diniz
@since 18/03/2026
@type function
/*/
Static Function SchedDef()

local aParam 		as array

	aParam := {	"P"			,;	//Tipo R para relatorio P para processo
				"MTA271"	,;	//Nome do grupo de perguntas (SX1)
				Nil			,;	//cAlias (para Relatorio)
				Nil			,;	//aArray (para Relatorio)
				Nil			}	//Titulo (para Relatorio)Caso 

Return aParam

//-------------------------------------------------------------------
/*/{Protheus.doc} INCSched271  
@author  TOTVS Framework
@since   15/01/2024
@version 1.0
/*/
//-------------------------------------------------------------------
Function INCSched271()
  
    Local cEnv      		:= ""
    Local oScheduleAuto 	:= NIL
    Local lInterfaceParams 	:= .F.
 
    cEnv := GetEnvServer()
    lInterfaceParams := .T.
 
    oScheduleAuto := totvs.framework.schedule.automatic():new()

    oScheduleAuto:setRoutine("MATA271")
    oScheduleAuto:setFirstExecution(DATE(),TIME())
    oScheduleAuto:setEnvironment(cEnv,{{cEmpAnt}})
    oScheduleAuto:setModule(4)
    oScheduleAuto:setUser("000000")
    oScheduleAuto:setDescription("Schedule Automático")
    oScheduleAuto:setRecurrence(.T.)
     
    if lInterfaceParams
        oScheduleAuto:setParams(A271Blind())
    endIf
     
    oScheduleAuto:setPrintParams("Impressao Automatica",1,"arquivo")
  
    if oScheduleAuto:setPeriod("D",,12,0)
  
        if oScheduleAuto:setFrequency("H",6,,18,0)
             
            oScheduleAuto:setDiscard(.F.)
 
            if oScheduleAuto:createSchedule()
                ConOut("/* * * * * * * * * * * * * * * * * * * * */")
                ConOut("/*  INCLUSÃO DO AGENDAMENTO COM SUCESSO  */")
                ConOut("/* * * * * * * * * * * * * * * * * * * * */")
            else
                ConOut("CREATE ERROR: "+oScheduleAuto:getErrorMessage())
            endIf
  
        endIf
  
    endIf
  
Return

//-------------------------------------------------------------------
/*/{Protheus.doc} DELSched271
  
    Exemplo de Exclusão de Agendamento Automático do SCHEDULE.
  
@author  TOTVS Framework
@since   15/01/2024
@version 1.0
/*/
//-------------------------------------------------------------------
Function DELSched271()
  
    Local cEnv				:= ""
    Local oScheduleAuto		:= NIL
    Local aSchedules 		:= {}
    Local lInterfaceParams	:= .F.
 
    cEnv := GetEnvServer()   
    lInterfaceParams := .T.
 
    aSchedules := totvs.framework.schedule.utils.getSchedsByRotine("MATA271") // Busca do código do Agendamento para o MATA271
  
    if !Empty(aSchedules)
  
        oScheduleAuto := totvs.framework.schedule.automatic():new()
  
        oScheduleAuto:setSchedule(aSchedules[1])
  
        if oScheduleAuto:deleteSchedule()
            Conout("/* * * * * * * * * * * * * * * * * * * * */")
            Conout("/*  EXCLUSÃO DO AGENDAMENTO COM SUCESSO  */")
            ConOut("/* * * * * * * * * * * * * * * * * * * * */")
        else
            ConOut("DELETE ERROR: "+oScheduleAuto:getErrorMessage())
        endIf
      
    endIf
  
Return

Function VldParSched()

	Local aSchedules	:= totvs.framework.schedule.utils.getSchedsByRotine("MATA271") // Busca do código do Agendamento para o MATA271
	Local lAlt			:= .T.
	Local lRelease		:= GetRPORelease() >= "12.1.2610"

    if !Empty(aSchedules) .AND. lRelease .AND. (alltrim(M->X6_CONTEUD) == "F" .OR. alltrim(M->X6_CONTEUD) == ".F.")
		Help(,,STR0021,,STR0022,1,0, , , , , , {STR0023}) //Help: VALIDSCHED //Problema: Não é possível alterar o parâmetro pois existe um agendamento de schedule da rotina MATA271 //Solução: É necessário apagar todos os agendamentos referente a rotina MATA271 para poder alterar o parâmetro.
		lAlt := .F.
	Endif

Return lAlt
