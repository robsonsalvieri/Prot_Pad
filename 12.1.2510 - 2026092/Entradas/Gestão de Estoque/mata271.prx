#INCLUDE "MATA271.CH"
#INCLUDE "PROTHEUS.CH"
#INCLUDE "TBICONN.CH"
#INCLUDE "TOPCONN.CH"
/*
ÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜ
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
±±ÚÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄ¿±±
±±³Fun‡…o    ³ MATA271  ³ Autor ³ Marcelo Pimentel      ³ Data ³ 19.01.98 ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄ´±±
±±³Descri‡…o ³Monta o arquivo de Bloqueio de movimentacao de produtos que ³±±
±±³          ³serao inventariados.                                        ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ´±±
±±³ Uso      ³SigaEst                                                     ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ´±±
*/
Function MATA271(lBlind)

Local lBlqInvA	:= SuperGetMV("MV_BLQINVA",.F.,.F.)
Local lA271Auto	:= GetRemoteType() == -1		// Execução via schedule

Default lBlind	:= .F.

//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
//³ Carrega as perguntas selecionadas                            ³
//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
//³ Parametros utilizados:                                       ³
//³ mv_par01    Quanto ao Invent rio:(Bloqueia) (Desbloqueia)    ³
//³ mv_par02    Almoxarifado De                                  ³
//³ mv_par03    Almoxarifado Ate                                 ³
//³ mv_par04    Produto De                                       ³
//³ mv_par05    Produto Ate                                      ³
//³ mv_par06    Tipo De                                          ³
//³ mv_par07    Tipo Ate                                         ³
//³ mv_par08    Grupo De                                         ³
//³ mv_par09    Grupo Ate                                        ³
//³ mv_par10    Mascara                                          ³
//³ mv_par11    Data  De                                         ³
//³ mv_par12    Data  Ate                                        ³
//³ mv_par13    Quanto a data:(Informada) (Calculada)            ³
//³ mv_par14    Data Informada                                   ³
//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
If !lBlind .And. !lA271Auto .And. Pergunte("MTA271",.T.)
	
	//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
	//³ Chamada da funcao para processamento em tela.            ³
	//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
	A271Proces(.F.)

ElseIf lBlind .And. !lA271Auto .And. (lBlqInvA) .And. dDataBase > SuperGetMV("MV_DATAINV",.F.,SToD("19800101"))
	
	//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
	//³ Chamada da funcao para processamento em job.             ³
	//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
	A271Blind()

elseif lA271Auto

	A271Proces(.T.)

EndIf

Return NIL

/*
ÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜ
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
±±ÚÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄ¿±±
±±³Fun‡Æo    ³A271Proces ³ Autor ³ Marcelo Pimentel      ³ Data ³ 02/06/93 ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄ´±±
±±³Descri‡Æo ³ Monta o arquivo de trabalho                                 ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ´±±
±±³ Uso      ³ MATA271                                                     ³±±
±±ÀÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ±±
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß
*/
Static Function A271Proces(lBlind)

LOCAL nX		:= 0
LOCAL nOpca		:= 0
LOCAL nPosFil	:= 0
LOCAL nDias		:= 1
LOCAL cArqTrab    := ""
LOCAL cQuery		:= ""
LOCAL cCod		:= ""
LOCAL cAliasQry		:= GetNextAlias() 
LOCAL oMark		  := NIL
LOCAL oDlg		  := NIL
LOCAL aStru		  := {}
LOCAL aObjects    := {}
LOCAL aPosObj 	  := {}
LOCAL aSize       := {}
LOCAL aInfo       := {}
LOCAL aFilsCalc   := {}
LOCAL lMt271Fil   := ExistBlock("MT271FIL")
LOCAL cFilBack	  := cFilAnt
LOCAL lMantem     := .F.
LOCAL lRetPe      := .T.
LOCAL lViewFilial := .F.
LOCAL lModoComp   := FWModeAccess("SB1",3)=="C"  // Referente ao X2_MODO
LOCAL lBloqueia		:= .T.
LOCAL oTempTable	:= NIL
LOCAL oQuery		:= NIL

//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
//³ Selecao de Multiplas Filiais                                 ³
//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
If mv_par15 == 1
	If lModoComp
		aFilsCalc   := MatFilCalc(mv_par15==1)
		lViewFilial := .T.
	Else 
		//'MATR935MODO' ; 'Para utilização de Seleção de Filiais a Tabela de Produtos (SB1) deve estar no modo compartilhado por filial. Para este processo será considera somente a filial corrente [' ; ']!'
		Help(nil,1,STR0017,nil,STR0018+cFilAnt+"' ]",3,0)
		aFilsCalc := MatFilCalc(.F.)
	Endif
Else
	aFilsCalc := MatFilCalc(mv_par15==1)
EndIf

//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
//³ Cria Arquivo de Trabalho                                     ³
//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
If lViewFilial
	Aadd( aStru,{ "TB_OK"   	, "C",01,0} )
	Aadd( aStru,{ "TB_FILIAL"	, "C",TamSX3("B1_FILIAL")[1],0} )
	Aadd( aStru,{ "TB_PRODUTO"	, "C",TamSX3("B1_COD")[1],0} )
	Aadd( aStru,{ "TB_DESCR"   	, "C",30,0} )
	Aadd( aStru,{ "TB_TIPO"		, "C",02,0} )
	Aadd( aStru,{ "TB_ALMOX"	, "C",TamSX3("B2_LOCAL")[1],0} )
	Aadd( aStru,{ "TB_DIAS" 	, "N",03,0} )
Else
	Aadd( aStru,{ "TB_OK"   	, "C",01,0} )
	Aadd( aStru,{ "TB_PRODUTO"	, "C",TamSX3("B1_COD")[1],0} )
	Aadd( aStru,{ "TB_DESCR"   	, "C",30,0} )
	Aadd( aStru,{ "TB_TIPO"		, "C",02,0} )
	Aadd( aStru,{ "TB_ALMOX"	, "C",TamSX3("B2_LOCAL")[1],0} )
	Aadd( aStru,{ "TB_DIAS" 	, "N",03,0} )
EndIf	

oTempTable := FWTemporaryTable():New( "TRB" )
oTempTable:SetFields( aStru )
oTempTable:AddIndex("indice1", {"TB_PRODUTO"} )
oTempTable:Create()

cArqTrab := oTempTable:GetRealName()

//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
//³ Redefinicao do aCampos para utilizar no MarkBrow             ³
//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
If lViewFilial
	aCampos := {{"TB_OK"	 ,""," "},;						//"Ok"
				{"TB_FILIAL","" ,OemToAnsi(STR0016)},;		//"Filial"
				{"TB_PRODUTO","",OemToAnsi(STR0003)},;		//"Produto"
				{"TB_DESCR"	 ,"",OemToAnsi(STR0004)},;		//"Descri‡ao"
				{"TB_TIPO"	 ,"",OemToAnsi(STR0005)},;		//"Tipo"
				{"TB_ALMOX"	 ,"",OemToAnsi(STR0006)},;		//"Local"
				{"TB_DIAS" 	 ,"",OemToAnsi(STR0013)} }     //"Quantidade de Dias Bloqueados"
Else
	aCampos := {{"TB_OK"	 ,""," "},;						//"Ok"
				{"TB_PRODUTO","",OemToAnsi(STR0003)},;		//"Produto"
				{"TB_DESCR"	 ,"",OemToAnsi(STR0004)},;		//"Descri‡ao"
				{"TB_TIPO"	 ,"",OemToAnsi(STR0005)},;		//"Tipo"
				{"TB_ALMOX"	 ,"",OemToAnsi(STR0006)},;		//"Local"
				{"TB_DIAS" 	 ,"",OemToAnsi(STR0013)} }     //"Quantidade de Dias Bloqueados"
EndIf	

For nPosFil := 1 To Len( aFilsCalc )

	If aFilsCalc[nPosFil,1]

		//-- Muda Filial para processamento
		cFilAnt := aFilsCalc[nPosFil,2]

		lBloqueia := mv_par01 == 1
		
		//De acordo com a função é possível utilizar "*" ou "?" para os caracteres desconhecidos
		cCod	:= mv_par10
		cCod	:= StrTran(cCod,"*","")
		cCod	:= StrTran(cCod,"?","")
	
		cQuery := " SELECT "
		cQuery += " 	B1_COD, B1_DESC, B1_TIPO, COALESCE(B5_BLQINVA,'2') B5_BLQINVA, COALESCE(B5_BLQINVD,0) B5_BLQINVD, B2_DINVENT, B2_DINVFIM, B2_DTINV, B2_LOCAL "
		cQuery += " FROM " + RetSqlName("SB1") + " SB1 "
		
		cQuery += " 	INNER JOIN " + RetSqlName("SB2") + " SB2 "
		cQuery += " 		ON " + FWJoinFilial("SB2", "SB1")
		cQuery += " 		AND	B2_COD	= B1_COD "
		cQuery += " 		AND SB2.D_E_L_E_T_ = ' ' "
		
		cQuery += " 	LEFT JOIN " + RetSqlName("SB5") + " SB5 "
		cQuery += " 		ON " + FWJoinFilial("SB5", "SB1")
		cQuery += " 		AND B5_COD	= B1_COD "
		cQuery += "			AND	SB5.D_E_L_E_T_ = ' ' "
		
		cQuery += " WHERE "
		cQuery += "		B1_FILIAL = ? AND "
		
		if !(Empty(cCod))
			cQuery += " 	B1_COD LIKE ? AND "
		endif
		
		cQuery += " 	B1_COD		BETWEEN ? AND ? AND "
		cQuery += " 	B1_TIPO		BETWEEN ? AND ? AND "
		cQuery += " 	B1_GRUPO	BETWEEN ? AND ? AND "
		cQuery += " 	SB1.D_E_L_E_T_ = ' ' AND "
		
		if mv_par13 == 2 
			if lBloqueia
				cQuery += " B2_DINVFIM = ' ' AND "
			else
				cQuery += " B2_DINVFIM <> ' ' AND "
			endif
		ElseIf mv_par13 == 1
			if lBloqueia
				cQuery += " B2_DTINV = ' ' AND "
			else
				cQuery += " B2_DTINV <> ' ' AND "
			endif
		endif
		
		cQuery += " 	B2_LOCAL	BETWEEN ? AND ? AND "
		cQuery += " 	( B2_DINVENT = ' ' OR " 
		cQuery += " 		B2_DINVENT BETWEEN ? AND ? "
		cQuery += " 	) AND  "
		cQuery += " 	NOT (B2_STATUS = '2') "
 		
		If lBlind
			cQuery += " AND ( B2_DINVENT <= ? OR B2_DINVENT = ' ' ) "
		EndIf
		
		nX := 1
		oQuery := FWExecStatement():New( changeQuery(cQuery) )
		oQuery:setString(nX++,FWxFilial("SB1"))

		if !(empty(cCod))
			oQuery:setString(nX++,cCod + '%')
		endif

		oQuery:setString(nX++,mv_par04)
		oQuery:setString(nX++,mv_par05)
		oQuery:setString(nX++,mv_par06)
		oQuery:setString(nX++,mv_par07)
		oQuery:setString(nX++,mv_par08)
		oQuery:setString(nX++,mv_par09)
		oQuery:setString(nX++,mv_par02)
		oQuery:setString(nX++,mv_par03)
		oQuery:setDate(nX++,mv_par11)
		oQuery:setDate(nX++,mv_par12)

		if lBlind
			oQuery:setDate(nX++,dDataBase)
		endif

		cAliasQry := oQuery:OpenAlias()

		oQuery:destroy()
		
		If lMt271Fil
			SB1->(DbSetOrder(1))
			SB2->(DbSetOrder(1))
			SB5->(DbSetOrder(1))
		EndIf
		
		While (cAliasQry)->(!(Eof()))
		
			If lBlind .And. (StoD((cAliasQry)->B2_DINVENT) + (cAliasQry)->B5_BLQINVD) > dDataBase  
				Loop
			EndIf
		
			If lMt271Fil
				
				SB1->(DbSeek(xFilial("SB1") + (cAliasQry)->B1_COD ))
				SB2->(DbSeek(xFilial("SB2") + (cAliasQry)->B1_COD + (cAliasQry)->B2_LOCAL))
				SB5->(DbSeek(xFilial("SB5") + (cAliasQry)->B1_COD ))
				
		        lRetPe := ExecBlock("MT271FIL",.F.,.F.,{mv_par01})
		        If ValType(lRetPe)=="L" .And. lRetPe==.F.
					(cAliasQry)->(dbSkip())
					Loop
		        EndIf
			EndIf
		
			dbSelectArea("TRB")
			RecLock("TRB",.T.)
			
			If lViewFilial
				TRB->TB_FILIAL  := cFilAnt
				TRB->TB_PRODUTO := (cAliasQry)->B1_COD
				TRB->TB_TIPO    := (cAliasQry)->B1_TIPO
				TRB->TB_ALMOX   := (cAliasQry)->B2_LOCAL
				TRB->TB_DESCR   := (cAliasQry)->B1_DESC
			Else
				TRB->TB_PRODUTO := (cAliasQry)->B1_COD
				TRB->TB_TIPO    := (cAliasQry)->B1_TIPO
				TRB->TB_ALMOX   := (cAliasQry)->B2_LOCAL
				TRB->TB_DESCR   := (cAliasQry)->B1_DESC
			EndIf				
			
			If lBlind
				TRB->TB_OK := "x"
				if mv_par01 == 1
					TRB->TB_DIAS := if((cAliasQry)->B5_BLQINVA == '1', (cAliasQry)->B5_BLQINVD, 1)
				else
					if (cAliasQry)->(!empty(B2_DINVFIM) .And. !empty(B2_DTINV))
						TRB->TB_DIAS := (cAliasQry)->(SToD(B2_DINVFIM) - SToD(B2_DTINV)) + 1
					endif
				endif
			else
				If mv_par01 == 2
					If !empty((cAliasQry)->B2_DINVFIM) .And. !empty((cAliasQry)->B2_DTINV) .And. (cAliasQry)->B2_DINVFIM <> (cAliasQry)->B2_DTINV
						TRB->TB_DIAS := (cAliasQry)->(StoD(B2_DINVFIM)-StoD(B2_DTINV)) + 1
					Else
						TRB->TB_DIAS := 1
					EndIf
				EndIf

			EndIf
			
			TRB->(MsUnLock())
			
			(cAliasQry)->(dbSkip())
			
		enddo
		
		(cAliasQry)->(DbCloseArea())

	endif
	
Next nPosFil

dbSelectArea("TRB")
dbGoTop()
If Bof() .and. EOF()
	If !lBlind
		Help(NIL, 1, "MATA271VAZIO", NIL, STR0019, 3, 0, NIL, NIL, NIL, NIL, NIL, {STR0020}) // "Nao foram gerados dados conforme selecao anterior de Bloqueio / Desbloqueio." # "Verificar se os parametros estao corretos e se os produtos estao Bloqueados/Desbloqueados." 
	EndIf
ElseIf !lBlind
	aSize := MsAdvSize()
	aInfo := {aSize[1],aSize[2],aSize[3],aSize[4],3,3}
	AADD(aObjects,{100,100,.T.,.T.,.F.})
	AADD(aObjects,{100,020,.T.,.F.,.F.})
	aPosObj := MsObjSize(aInfo,aObjects)
	While .T.
		DEFINE MSDIALOG oDlg TITLE If(mv_par01 == 1,STR0001,STR0002) OF oMainWnd PIXEL FROM aSize[7],0 TO aSize[6],aSize[5] //"Bloqueio"###"Desbloqueio"
		cAlias := Alias()
		oMark := MsSelect():New(cAlias,"TB_OK",,aCampos,,"x",{aPosObj[1,1],aPosObj[1,2],aPosObj[1,3],aPosObj[1,4]})
		oMark:bMark := {|| A271Marca(nDias,lMantem)}
		oMark:oBrowse:lHasMark := .T.
		oMark:oBrowse:bAllMark := {| | A271MarkAll(oDlg,nDias,lMantem)}
		@aPosObj[2,1]+5,aPosObj[2,2]+5 BUTTON OemToAnsi(STR0008) ACTION IIF(A271Pesqui(),oMark:oBrowse:Refresh(),Nil) SIZE 34,11 OF oDlg FONT oDlg:oFont PIXEL	//"Pesquisa"
		If mv_par01 == 1
			DEFINE SBUTTON FROM aPosObj[2,1]+4,aPosObj[2,4]-100 TYPE 11 ENABLE OF oDlg ACTION (a271Dias(@nDias,@lMantem),oMark:oBrowse:Refresh())
		EndIf	
		DEFINE SBUTTON FROM aPosObj[2,1]+4,aPosObj[2,4]-65  TYPE  1 ENABLE OF oDlg ACTION (If(a271OK(),nOpca:=1,nOpca:=0),oDlg:End())
		DEFINE SBUTTON FROM aPosObj[2,1]+4,aPosObj[2,4]-30  TYPE  2 ENABLE OF oDlg ACTION (oDlg:End())
		ACTIVATE MSDIALOG oDlg CENTERED
		If nOpca == 1
			a271Grava(Nil,lViewFilial)
		Endif
		Exit
	EndDo
Else 
	A271Grava(lBlind,lViewFilial)
EndIf

//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
//³ Restaura para filial de origem.                              ³
//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
If lViewFilial
	cFilAnt := cFilBack
EndIf

oTempTable:Delete()

Return Nil

/*
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
±±ÚÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄ¿±±
±±³Fun‡…o    ³ A271Dias ³ Autor ³ Larson Zordan         ³ Data ³ 07.05.02 ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄ´±±
±±³Descri‡ao ³ Ajusta o numero de Dias de Bloqueio para Inventariar       ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ´±±
±±³Uso       ³ Mata271                                                    ³±±
±±ÀÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ±±
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß
*/
Static Function A271Dias(nDias,lMantem)
Local oDlg,oChk
Local nQtde    := nDias
Local aAreaAnt := GetArea()
Local aAreaSB2 := SB2->(GetArea())
Local nOpcX	   := 0

Define MSDialog oDlg Title STR0013 OF oMainWnd Pixel From 0,0 TO 110,200

@ 05,10 Say STR0013	Size 50,20 Pixel Of oDlg
@ 07,62 Get nQtde Picture "999"       		Size 20,09 Pixel Of oDlg Valid( nQtde >= 1 )

@ 25,10 CheckBox oChk Var lMantem PROMPT STR0014 Size 93,29 Of oDlg Pixel 

Define SButton From 40,35 Type 1 Enable Of oDlg Action (nDias := nQtde, nOpcX := 1, oDlg:End())
Define SButton From 40,68 Type 2 Enable Of oDlg Action (oDlg:End())

Activate MSDialog oDlg Centered

if nOpcX == 1
	
	RecLock("TRB",.F.)
	TRB->TB_DIAS := nDias
	TRB->(MsUnlock())

	nRecno := TRB->(Recno())

	If !lMantem
		dbSelectArea("TRB")
		TRB->(dbGoTop())
		While TRB->(!Eof())
			
			//-- Posiciona SB2
			SB2->(dbSetOrder(1))
			SB2->(dbSeek(FWxFilial("SB2")+TRB->TB_PRODUTO+TRB->TB_ALMOX))
			
			//-- Ajusta TRB
			RecLock("TRB",.F.)
			TRB->TB_OK := " "
			
			If mv_par01 == 1
				TRB->TB_DIAS := 0
			EndIf
			
			TRB->(MsUnLock())
			TRB->(dbSkip())
		EndDo
	EndIf
endif

RestArea(aAreaSB2)
RestArea(aAreaAnt)

Return

/*
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
±±ÚÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄ¿±±
±±³Fun‡…o    ³A271Pesqui³ Autor ³ Marcelo Pimentel      ³ Data ³ 19.01.98 ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄ´±±
±±³Descri‡…o ³ Pesquisas pelos index's abertos                            ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ´±±
±±³Uso       ³ MATA271                                                    ³±±
±±ÀÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ±±
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß
*/
Static Function A271Pesqui()

Local cAlias,cCampo,cOrd
Local nReg,nI,nOpca:=0
Local oDlg,oCbx,lRet := .T.
Local aOrd := { }

dbSelectArea("TRB")
//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
//³Salva a Integridade dos Dados                                         ³
//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
cAlias  := ALIAS()

AADD(aOrd," "+STR0015) //"Codigo"

//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
//³ Processa Choices dos Campos do Banco de Dados          ³
//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
cOrd := aOrd[1]
cCampo:=SPACE(40)
For nI:=1 to Len(aOrd)
	aOrd[nI] := OemToAnsi(aOrd[nI])
Next
If IndexOrd() >= Len(aOrd)
	cOrd := aOrd[Len(aOrd)]
ElseIf IndexOrd() <= 1
	cOrd := aOrd[1]
Else
	cOrd := aOrd[IndexOrd()]
Endif
DEFINE MSDIALOG oDlg FROM 5, 5 TO 14, 50 TITLE OemToAnsi(STR0010)  //"Pesquisa"

@ 0.6,1.3 COMBOBOX oCbx VAR cOrd ITEMS aOrd  SIZE 165,44 OF oDlg FONT oDlg:oFont
@ 2.1,1.3 MSGET cCampo SIZE 165,10
DEFINE SBUTTON FROM 055,122   TYPE 1 ACTION (nOpca := 1,A271OK(),oDlg:End()) ENABLE OF oDlg
DEFINE SBUTTON FROM 055,149.1 TYPE 2 ACTION oDlg:End() ENABLE OF oDlg
ACTIVATE MSDIALOG oDlg CENTERED

If nOpca == 0
	lRet := .F.
Endif

nReg := RecNo()

If lRet
	cIndex1:=CriaTrab(nil,.f.)
	dbSelectArea("TRB")
	dbSetOrder(1)
	dbGotop()
	lRet := IIf(dbSeek(Trim(cCampo),.T.),.T.,.F.)
	If  !lRet
		Go nReg
		Help(" ",1,"PESQ01")
	EndIf
Endif

Return lRet

/*
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
±±ÚÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄ¿±±
±±³Fun‡…o    ³ A271Marca  ³ Autor ³Rodrigo de A.Sartorio³ Data ³ 04/01/96 ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄ´±±
±±³Descri‡…o ³ Avalia Marca.                                              ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ´±±
±±³Uso       ³ MATA271                                                    ³±±
±±ÀÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ±±
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß
*/
Static Function A271Marca(nDias,lMantem)

Local aArea	:= {SB1->(GetArea()), SB2->(GetArea()), SB5->(GetArea()), GetArea()}
Local nDaysBlk	:= nDias

	if mv_par01 == 1
		DbSelectArea("SB5")
		SB5->(DbSetOrder(1))
		if SB5->(MsSeek(FWxFilial('SB5') + TRB->TB_PRODUTO))
			if SB5->B5_BLQINVA == '1'
				nDaysBlk := SB5->B5_BLQINVD
			endif
		endif
	else
		DbSelectArea("SB2")
		SB2->(DbSetOrder(1))
		if SB2->(MsSeek(FWxFilial('SB2') + TRB->TB_PRODUTO))
			if SB2->(!Empty(B2_DINVFIM) .And. !Empty(B2_DTINV) .And. B2_DINVFIM <> B2_DTINV)
				nDaysBlk := SB2->(B2_DINVFIM - B2_DTINV) + 1
			endif
		endif
	endif

	RecLock("TRB",.F.)
	TRB->TB_DIAS := If(!Empty(TRB->TB_OK),If(lMantem.And.TRB->TB_DIAS>0,TRB->TB_DIAS,nDaysBlk),0)
	TRB->(MsUnlock())

	aEval(aArea,{|x| RestArea(x)})

Return

/*
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
±±ÚÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄ¿±±
±±³Fun‡…o    ³ L³ Autor ³Marcelo Pimentel     ³ Data ³ 19/01/98 ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄ´±±
±±³Descri‡…o ³ Inverte Marcadas/Desmarcadas                               ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ´±±
±±³Uso       ³ MATA271                                                    ³±±
±±ÀÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ±±
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß
*/
Static Function A271MarkAll(oDlg,nDias,lMantem)

Local aArea		:= {SB2->(GetArea()), SB5->(GetArea())}
Local nRecno	:= Recno()
Local nDaysBlk	:= 0

	TRB->(dbGotop())
	
	While TRB->(!Eof())
		
		nDaysBlk := nDias

		if mv_par01 == 1
			DbSelectArea("SB5")
			SB5->(DbSetOrder(1))
			if SB5->(MsSeek(FWxFilial('SB5') + TRB->TB_PRODUTO))
				if SB5->B5_BLQINVA == '1'
					nDaysBlk := SB5->B5_BLQINVD
				endif
			endif
		else
			DbSelectArea("SB2")
			SB2->(DbSetOrder(1))
			if SB2->(MsSeek(FWxFilial('SB2') + TRB->TB_PRODUTO))
				if SB2->(!Empty(B2_DINVFIM) .And. !Empty(B2_DTINV) .And. B2_DINVFIM <> B2_DTINV)
					nDaysBlk := SB2->(B2_DINVFIM - B2_DTINV)
				elseif SB2->(!Empty(B2_DINVFIM) .And. !Empty(B2_DTINV) .And. B2_DINVFIM == B2_DTINV)
					nDaysBlk := 1
				endif
			endif
		endif
		
		RecLock("TRB",.F.)
		If Empty(TRB->TB_OK)
			TRB->TB_OK		:= "x"
			TRB->TB_DIAS	:= If(mv_par01 == 1, nDaysBlk, TRB->TB_DIAS)
		Else
			If !lMantem //-- Nao mantem os itens marcados (.F.)
				TRB->TB_OK		:= " "
				TRB->TB_DIAS	:= If(mv_par01 == 1, 0, TRB->TB_DIAS)
			EndIf			
		Endif
		TRB->(MsUnlock())
		TRB->(dbSkip())
	EndDo
	
	TRB->(dbGoto(nRecno))
	oDlg:Refresh()

	aEval(aArea,{|x| RestArea(x)})

Return .T.

/*
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
±±ÚÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄ¿±±
±±³Fun‡…o    ³ A271Grava³ Autor ³ Marcelo Pimentel      ³ Data ³ 19.01.98 ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄ´±±
±±³Descri‡…o ³ Bloqueia / Desbloqueia itens para Inventario               ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ´±±
±±³Uso       ³ MATA271                                                    ³±±
±±ÀÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ±±
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß
*/
Static Function A271Grava(lBlind,lViewFilial)

Local cFilAux	:= cFilAnt
Local lMt271Grv := ExistBlock("MT271GRV")

Default lBlind := .F.

dbSelectArea("TRB")
TRB->(dbGoTop())

While TRB->(!Eof())
	
	If Empty(TRB->TB_OK)
		TRB->(dbSkip())
		Loop
	EndIf
	
	// Posiciona na Filial Selecionada
	If lViewFilial
		cFilAnt := TRB->TB_FILIAL
	EndIf

	dbSelectArea("SB2")
	SB2->(dbSetOrder(1))
	If SB2->(MsSeek(FWxFilial("SB2") + TRB->(TB_PRODUTO + TB_ALMOX)))
		RecLock("SB2",.F.)
		If mv_par01 == 1
			If mv_par13 == 1
				SB2->B2_DTINV := if(!empty(mv_par14),mv_par14,dDataBase)
			Else
				SB1->(dbSetOrder(1))
				SB1->(MsSeek(FWxFilial("SB1") + TRB->TB_PRODUTO))
				SB2->B2_DTINV := if(!empty(SB2->B2_DINVENT),SB2->B2_DINVENT,dDataBase) + SB1->B1_PERINV
			Endif
			SB2->B2_DINVFIM	:= SB2->B2_DTINV + (TRB->TB_DIAS - 1)
		Else
			SB2->B2_DTINV	:= Ctod("  /  /  ")
			SB2->B2_DINVFIM	:= Ctod("  /  /  ")
		EndIf
		SB2->(MsUnlock())
	EndIf
	
	If lMt271Grv
		ExecBlock("MT271GRV",.F.,.F.)
	EndIf
	
	dbSelectArea("TRB")
	TRB->(dbSkip())
EndDo

// Restaura a filial 
If lViewFilial
	cFilAnt := cFilAux
EndIf

Return

/*
ÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜ
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
±±ÚÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄ¿±±
±±³ Fun‡…o   ³ A271OK   ³ Autor ³ Cristina M. Ogura     ³ Data ³28.11.95  ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄ´±±
±±³ Descri‡…o³ Mensagem de OK antes de executar o processamento           ³±±
