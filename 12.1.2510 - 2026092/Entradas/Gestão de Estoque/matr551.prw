Function Matr551()
Local cReport	:= "MATR551"	//Nome do Programa
Local cAlias	:= "SBV"		//Alias da tabela
Local cTitle	:= STR0001		//Tabelas da Grade de Produtos 
Local cDesc		:= STR0002		//Este relatório apresenta uma relação das Tabelas das Grades de Produtos cadastradas.
Local lInd		:= .T.			//Retorna Indice SIX

// Validação de aviso/bloqueio do relatório em Release 12.1.2510 e superiores
if ExistFunc("VldDescRel")
	if !VldDescRel()
		return
	endif
endif

MPReport(cReport,cAlias,cTitle,cDesc,,lInd)
Return
