Static Function MenuDef()

Private aRotina	:= {	{STR0002,"C060Visual", 0 , 2,0,nil}}	//"Visualizar" 

If ExistBlock ("MTC060MNU")							    
	ExecBlock ("MTC060MNU",.F.,.F.)
