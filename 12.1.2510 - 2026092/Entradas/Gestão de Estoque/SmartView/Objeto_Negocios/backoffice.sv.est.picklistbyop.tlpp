#include "msobject.ch"
#include "backoffice.sv.est.PickListByOP.ch"
#include "totvs.framework.treports.integratedprovider.th"

#define SX1GRUPO "ESTT037"

namespace totvs.protheus.backoffice.est.PickListByOP.integratedprovider
using namespace totvs.protheus.backoffice.est.smartView.integratedProvider

@totvsFrameworkTReportsIntegratedProvider(active=.T.,team="SIGAEST",tables="SC2,SD4,SB1",name="PickList Por OP",country="ALL",customTables="ALL")

//-------------------------------------------------------------------
/*{Protheus.doc} PickListByOPSmartViewBusinessObject
Classe para criação do Objeto de Negócio 

@author Vicente Gomes
@since 11/2023
@version 1.0
*/
//-------------------------------------------------------------------
Class PickListByOPSmartViewBusinessObject From totvs.protheus.backoffice.est.smartView.integratedProvider.EstIntegratedProvider

	Public Method new() as object
	Public Method getData() as object

	Protected Method oNGetSchema()
	Protected data aFields	as array
	Protected data jItems	as json
	Protected data cWhere	as character
	Protected data lExistPergunte	as logical

EndClass

//-------------------------------------------------------------------
/*{Protheus.doc} PickListByOPSmartViewBusinessObject
Método de instância da classe

@return object: self
@author Vicente Gomes
@since 11/2023
@version 1.0
*/
//-------------------------------------------------------------------
Method new() Class PickListByOPSmartViewBusinessObject

	_Super:new()

	//Define a Área
	self:appendArea( STR0001 )// "Estoque/Custos"

	//Define o nome do Objeto de Negócio
	self:setDisplayName( STR0002 ) // "PickList Por OP."

	//Define a descrição do Objeto de Negócio
	self:setDescription( STR0003 ) // "Este relatório realiza uma avaliação sobre as baixas realizadas no armazém"
	
	//Define o conjunto de perguntas e faz o teste se existe
	self:lExistPergunte := self:setPergunte( SX1GRUPO )
	If !self:lExistPergunte
		self:setErrorStatus(400,STR0005,i18n(STR0006,{SX1GRUPO}))//O Grupo de perguntas não existe		
		FWLogMsg('WARN', , 'SmartView', , , , i18n(STR0006,{SX1GRUPO}), , , )//O Grupo de perguntas não existe
	EndIf

	//Indica que o LookUp será do tipo padrão LookUp
	self:setIsLookUp(.T.)

Return self

//-------------------------------------------------------------------
/*{Protheus.doc} getData
Retorna os dados do objeto de negócio

@return object: self:oData
@author Vicente Gomes
@since 11/2023
@version 1.0
*/
//-------------------------------------------------------------------
Method getData( nPage as Numeric, oFilter as object) as object Class PickListByOPSmartViewBusinessObject

local aTamSX3		as array
local cAlias		as character
local cFieldName	as character
local cFieldType	as character
local cQuery		as character
local cSubStr		as character
local nBind     	as numeric 
local nX			as numeric
local jParams		as json
local dDataDe		as date
local dDataAte		as date
local oQuery		as object

	//Valida o pergunte
	If !self:lExistPergunte
		return self:oData
	Endif

	aTamSX3 := Array(4)
	aTamSX3[1] := FWSX3Util():GetFieldStruct( "C2_NUM"		)[3]
	aTamSX3[2] := FWSX3Util():GetFieldStruct( "C2_ITEM"		)[3]
	aTamSX3[3] := FWSX3Util():GetFieldStruct( "C2_SEQUEN"	)[3]
	aTamSX3[4] := FWSX3Util():GetFieldStruct( "C2_ITEMGRD"	)[3]
	cSubStr := if( TCGetDB() $ "ORACLE/POSTGRES","SUBSTR","SUBSTRING" )
	
	jParams := oFilter:getParameters() //metodo para retorno do json dos parâmetros

    //Retorno da tela de multi filiais com as filiais selecionadas ou somente a filial corrente
    self:aFils := self:retFils(jParams['SV_MULTBRANCH'], oFilter)

	dDataDe  := if(!empty(jParams['MV_PAR01'][1]), FwDateTimeToLocal( jParams['MV_PAR01'][1] )[1], FirstDate(dDataBase))
	dDataAte := if(!empty(jParams['MV_PAR02'][1]), FwDateTimeToLocal( jParams['MV_PAR02'][1] )[1], LastDate(dDataBase))

	cQuery := " SELECT " + self:getSQLFields(.T.)
	cQuery += " , ( SC2.C2_QUANT - SC2.C2_QUJE ) SALDO "
	cQuery += " , ( CASE WHEN SDC.DC_QTDORIG IS NOT NULL THEN SDC.DC_QTDORIG ELSE SD4.D4_QTDEORI END ) QTDEEMP "
	cQuery += " , ( CASE WHEN SDC.DC_QUANT IS NOT NULL THEN SDC.DC_QUANT ELSE SD4.D4_QUANT END ) SLDOEMP "
	cQuery += " FROM " + RetSQLName("SC2") + " SC2 "
	
	cQuery += " INNER JOIN " + RetSqlName("SD4") + " SD4 "
	cQuery += " ON " + FWJoinFilial("SD4", "SC2") 
	cQuery += "	AND " + cSubStr + "(D4_OP,1," + str(aTamSX3[1]) + ") = SC2.C2_NUM "
	cQuery += "	AND " + cSubStr + "(D4_OP," + str(aTamSX3[1] + 1) + "," + str(aTamSX3[2]) + ") = SC2.C2_ITEM "
	cQuery += "	AND " + cSubStr + "(D4_OP,"+ str(aTamSX3[1] + aTamSX3[2] + 1) + "," + str(aTamSX3[3]) + ") = SC2.C2_SEQUEN "
	cQuery += "	AND " + cSubStr + "(D4_OP," + str(aTamSX3[1] + aTamSX3[2] + aTamSX3[3] + 1) + "," + str(aTamSX3[4]) + ") = SC2.C2_ITEMGRD "
	cQuery += " AND SD4.D_E_L_E_T_ = ? "
	
	cQuery += " INNER JOIN " + RetSqlName("SB1") + " SB1 " 
	cQuery += " ON " + FWJoinFilial("SB1", "SD4")
	cQuery += " AND SB1.B1_COD = SD4.D4_COD "
	cQuery += " AND SB1.D_E_L_E_T_ = ? "

	cQuery += " INNER JOIN " + RetSqlName("NNR") + " NNR " 
	cQuery += " ON " + FWJoinFilial("NNR", "SD4")
	cQuery += " AND NNR.NNR_CODIGO = SD4.D4_LOCAL "
	cQuery += " AND NNR.D_E_L_E_T_ = ? "

	cQuery += " LEFT JOIN " + RetSqlName("SDC") + " SDC "
	cQuery += " ON " + FWJoinFilial("SDC", "SD4")
	cQuery += " AND SDC.DC_PRODUTO = SD4.D4_COD "
	cQuery += " AND SDC.DC_LOCAL = SD4.D4_LOCAL "
	cQuery += " AND SDC.DC_OP = SD4.D4_OP "
	cQuery += " AND SDC.DC_TRT = SD4.D4_TRT "
	cQuery += " AND SDC.DC_LOTECTL = SD4.D4_LOTECTL "
	cQuery += " AND SDC.DC_NUMLOTE = SD4.D4_NUMLOTE "
	cQuery += " AND SDC.D_E_L_E_T_ = ? "

	cQuery += " WHERE "
	cQuery += " SC2.C2_FILIAL IN (?) "
	cQuery += " AND SC2.C2_OP BETWEEN ? AND ? "
	cQuery += " AND SC2.C2_OP <> ? "
	cQuery += " AND SC2.C2_DATPRI BETWEEN ? AND ? "
	cQuery += " AND SC2.C2_LOCAL BETWEEN ? AND ? "
	cQuery += " AND C2_TPOP IN (?) "	
	cQuery += " AND SC2.D_E_L_E_T_ = ? "

	cQuery += self:cWhere
	cQuery += self:cWhereFiltroSV

	cQuery += " GROUP BY " + self:getSQLFields(.T.)
	
	cQuery := ChangeQuery(cQuery)

	oQuery := FwExecStatement():New(cQuery)

	// Carrega os campos do schema a serem populados e fornecidos ao Smartview
	self:aFields := self:getStructFields()
	
	nBind := 1

	//Binding
	oQuery:setString(nBind++,' ')
	oQuery:setString(nBind++,' ')
	oQuery:setString(nBind++,' ')
	oQuery:setString(nBind++,' ')
	oQuery:setIn(nBind++,self:aFils)
	oQuery:setString(nBind++,jParams['MV_PAR05'][1])
	oQuery:setString(nBind++,jParams['MV_PAR06'][1])
	oQuery:setString(nBind++,' ')
	oQuery:SetDate(nBind++,dDataDe)
	oQuery:SetDate(nBind++,dDataAte)
	oQuery:setString(nBind++,jParams['MV_PAR03'][1])
	oQuery:setString(nBind++,jParams['MV_PAR04'][1])

	if jParams['MV_PAR07'][1] == 1
		oQuery:setIn(nBind++,{'F'})
	elseif jParams['MV_PAR07'][1] == 2
		oQuery:setIn(nBind++,{'P'})	
	else
		oQuery:setIn(nBind++,{'F','P'})		
	endif
	
	oQuery:setString(nBind++,' ')
	
	cAlias := oQuery:OpenAlias()

	While !(cAlias)->(Eof())

		self:jItems := JsonObject():New()

		For nX := 1 To Len(self:aFields)

			cFieldName	:= self:aFields[nX]:getName()
			cFieldType	:= self:aFields[nX]:getType()

			if cFieldName $ 'EMPNOME|FILNOME|DESCPRD'
				
				if cFieldName == 'EMPNOME'
					self:jItems[cFieldName]	:= self:getInfoEmp("M0_NOME", (cAlias)->C2_FILIAL)
				elseif cFieldName == 'FILNOME'
					self:jItems[cFieldName]	:= self:getInfoEmp("M0_FILIAL", (cAlias)->C2_FILIAL)
				else
					self:jItems[cFieldName]	:= GetAdvFVal("SB1","B1_DESC", FWxFilial("SB1",(cAlias)->C2_FILIAL) + (cAlias)->C2_PRODUTO, 1)
				endif
			
			elseif cFieldType == "date"
				if !Empty( (cAlias)->&(cFieldName) )
					self:jItems[cFieldName] := totvs.framework.treports.date.dateToTimeStamp( StoD((cAlias)->&(cFieldName)) )
				endif
			else
				self:jItems[cFieldName] := (cAlias)->&(cFieldName)
			endif

		Next nX

		self:processData()
		
		self:oData:appendData(self:jItems)

		(cAlias)->(DBSkip())

	EndDo

	(cAlias)->(DBCloseArea())

	oQuery:Destroy()

return self:oData

//-------------------------------------------------------------------
/*{Protheus.doc} getSchema
Retorna a estrutura dos campos

@return object: self:oSchema
@author Vicente Gomes
@since 11/2023
@version 1.0
*/
//-------------------------------------------------------------------
Method oNGetSchema() Class PickListByOPSmartViewBusinessObject

local lCanFilter := .F. as logical

	self:addProperty( "EMPNOME", STR0004, "string", STR0004 , "EMPNOME", /*cComboValues*/, /*lIsRequired*/, /*cRenameField*/, lCanFilter ) // "Nome Empresa"
	self:addProperty( "FILNOME", STR0005, "string", STR0005 , "FILNOME", /*cComboValues*/, /*lIsRequired*/, /*cRenameField*/, lCanFilter ) // "Nome Filial"
	self:addProperty( "DESCPRD", STR0007, "string", STR0007 , "DESCPRD", /*cComboValues*/, /*lIsRequired*/, /*cRenameField*/, lCanFilter ) // "Descr. Produto"
	self:addProperty( "QTDEEMP", STR0008, "number", STR0008 , "QTDEEMP", /*cComboValues*/, /*lIsRequired*/, /*cRenameField*/, lCanFilter ) // "Qtd. Empenho"
	self:addProperty( "SLDOEMP", STR0009, "number", STR0009 , "SLDOEMP", /*cComboValues*/, /*lIsRequired*/, /*cRenameField*/, lCanFilter ) // "Sal. Empenho"
	self:addProperty( "SALDO"  , STR0010, "number", STR0010 , "SALDO"  , /*cComboValues*/, /*lIsRequired*/, /*cRenameField*/, lCanFilter ) // "Saldo"

	self:AliasToSchema("SC2", {"C2_FILIAL","C2_OP","C2_PRODUTO","C2_EMISSAO","C2_DATPRI","C2_DATPRF","C2_QUANT","C2_QUJE","C2_OBS"})
	self:AliasToSchema("SD4", {"D4_COD","D4_LOCAL","D4_TRT","D4_LOTECTL","D4_NUMLOTE","D4_DTVALID","D4_POTENCI","D4_QTDEORI","D4_QUANT"})
	self:AliasToSchema("SB1", {"B1_DESC","B1_UM"})
	self:AliasToSchema("SDC", {"DC_LOCALIZ","DC_NUMSERI","DC_QTDORIG","DC_QUANT"})
	self:AliasToSchema("NNR", {"NNR_DESCRI"})

Return
