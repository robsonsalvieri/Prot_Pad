#include "msobject.ch"
#include "backoffice.sv.est.inventorylist.ch"
#include "totvs.framework.treports.integratedprovider.th"
#define SX1GRUPO "ESTT013"

namespace totvs.protheus.backoffice.est.inventorylist.integratedprovider
using namespace totvs.protheus.backoffice.est.smartView.integratedProvider

@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGAEST", tables="SB1,SB2,SBF,SB8,NNR", name="Listagem para Inventário", customTables="SB1,SB2,NNR", country="ALL")

class InventoryListTReportsBusinessObject from totvs.protheus.backoffice.est.smartView.integratedProvider.EstIntegratedProvider
    
    public method new() as object    
    public method getData() as object

    Protected Method oNGetSchema()

    Protected data lExistPergunte	as logical

endclass

/*/{Protheus.doc} New
Metodo de instancia da classe (MATR280).
@type  Metodo
@author Squad Entradas
@since  Maio 15,2023
/*/
method new() class InventoryListTReportsBusinessObject
    _Super:new()

    //Define a Área
    self:appendArea(STR0001) // Estoque/Custos
    
    //Define o nome do Objeto de Negócio
    self:setDisplayName(STR0002) // "Listagem para Inventário"

    //Define a descrição do Objeto de Negócio
	self:setDescription( STR0003 ) // Emite um relatório que facilita a digitação das quantidades inventariadas.

    //Indica o pergunte que será utilizado no relatório
    self:lExistPergunte := self:setPergunte( SX1GRUPO )//ESTT013
	If !self:lExistPergunte
		self:setErrorStatus(400,STR0036,i18n(STR0037,{SX1GRUPO}))//O Grupo de perguntas #1 não existe		
		FWLogMsg('WARN', , 'SmartView', , , , i18n(STR0037,{SX1GRUPO}), , , )//O Grupo de perguntas #1 não existe
	EndIf

    //Indica que o LookUp será do tipo padrão LookUp
    self:setIsLookUp(.T.)

return self


/*/{Protheus.doc} getData
Metodo que retorna o Objeto de dados.
@type  Metodo
@author Squad Entradas
@since  Maio 15,2023
/*/
method getData(nPage as numeric, oFilter as object) as object class InventoryListTReportsBusinessObject

local aFils		as array
local aFields	as array
local aColumn	as array
local aLine		as array
local cAlias	as character
local cQuery	as character
local cFldName	as character
local cFldType	as character
local dDataDe	as date
local dDataAte	as date
local nBind		as numeric
local nX		as numeric
local nY		as numeric
local jParams	as json
local jItems	as json
local lImpLote	as logical
local oQuery	as object

    //Valida o pergunte
	If !self:lExistPergunte
		return self:oData
	Endif

	// Método para retorno do json dos parâmetros
	jParams := oFilter:getParameters()

    aFils := self:retFils(jParams['SV_MULTBRANCH'], oFilter)

    //Inicia as variáveis utilizadas no objeto de negócio
    lImpLote := jParams['MV_PAR13'][1] == 1
    dDataDe  := if(!empty( jParams['MV_PAR11'][1] ),FwDateTimeToLocal( jParams['MV_PAR11'][1] )[1], FirstDate(dDataBase))
	dDataAte := if(!empty( jParams['MV_PAR12'][1] ),FwDateTimeToLocal( jParams['MV_PAR12'][1] )[1], LastDate(dDataBase))

    //Atualiza os arrays responsáveis por apresentar o nome das colunas e linhas dinâmicas
    If lImpLote
        aColumn := {STR0004,STR0005,STR0006,STR0007,STR0008,STR0011,STR0009,STR0011,STR0010,STR0011}
        aLine	:= {"","","","",STR0012,STR0013,STR0012,STR0013,STR0012,STR0013}
    Else
        aColumn := {"","","","",STR0008,STR0011,STR0009,STR0011,STR0010,STR0011}
        aLine	:= {"","","","",STR0012,STR0013,STR0012,STR0013,STR0012,STR0013}
    EndIf

	// Carrega os campos do schema do objeto de negócio
	aFields := self:getStructFields()

	cQuery := " SELECT " + self:getSQLFields(.T.)
	cQuery += " FROM " + RetSqlName("SB2") + " SB2 "

	cQuery += " INNER JOIN " + RetSqlName("SB1") + " SB1 "
	cQuery += " ON " + FwJoinFilial("SB1","SB2")
	cQuery += " AND SB1.B1_COD = SB2.B2_COD "
	cQuery += " AND SB1.D_E_L_E_T_ = ? "

	cQuery += " INNER JOIN " + RetSqlName("NNR") + " NNR "
	cQuery += " ON " + FwJoinFilial("NNR","SB2")
	cQuery += " AND NNR.NNR_CODIGO = SB2.B2_LOCAL "
	cQuery += " AND NNR.D_E_L_E_T_ = ? "

	cQuery += " LEFT JOIN " + RetSqlName("SBF") + " SBF "
	cQuery += " ON " + FwJoinFilial("SBF","SB2")
	cQuery += " AND SBF.BF_PRODUTO = SB2.B2_COD "
	cQuery += " AND SBF.BF_LOCAL = SB2.B2_LOCAL "
	if jParams['MV_PAR14'][1] == 2
		cQuery += " AND SBF.BF_QUANT <> ? "
	endif
	cQuery += " AND SBF.D_E_L_E_T_ = ? "
	
	cQuery += " LEFT JOIN " + RetSqlName("SB8") + " SB8 "
	cQuery += " ON " + FwJoinFilial("SB8","SB2")
	cQuery += " AND SB8.B8_PRODUTO = SB2.B2_COD "
	cQuery += " AND SB8.B8_LOCAL = SB2.B2_LOCAL "
	cQuery += " AND ( SB1.B1_LOCALIZ = ? AND SB8.B8_LOTECTL = SBF.BF_LOTECTL ) "
	cQuery += " AND ( SB1.B1_LOCALIZ = ? AND SB8.B8_NUMLOTE = SBF.BF_NUMLOTE ) "
	if jParams['MV_PAR14'][1] == 2
		cQuery += " AND SB8.B8_SALDO <> ? "
	endif
	cQuery += " AND SB8.D_E_L_E_T_ = ? "

	cQuery += " WHERE "
	cQuery += " SB2.B2_FILIAL IN (?) "
	cQuery += " AND SB2.B2_COD BETWEEN ? AND ? "
	cQuery += " AND SB2.B2_LOCAL BETWEEN ? AND ? "
	
	if jParams['MV_PAR15'][1] == 2
		cQuery += " AND (SB2.B2_DINVFIM <> ? AND SB2.B2_DINVFIM >= ? AND SB2.B2_DTINV <= ?) "
	else
		cQuery += " AND (SB2.B2_DINVENT = ? OR (SB2.B2_DINVENT <> ? AND (CAST(SB2.B2_DINVENT AS INTEGER) + SB1.B1_PERINV) >= ? AND (CAST(SB2.B2_DINVENT AS INTEGER) + SB1.B1_PERINV) <= ?)) "
	endif

	if jParams['MV_PAR14'][1] == 2
		cQuery += " AND SB2.B2_QATU <> ? "
	endif

	cQuery += " AND SB2.D_E_L_E_T_ = ? "
	cQuery += " AND SB1.B1_TIPO BETWEEN ? AND ? "
	cQuery += " AND SB1.B1_GRUPO BETWEEN ? AND ? "
	cQuery += " AND SB1.B1_DESC BETWEEN ? AND ? "

	cQuery += self:cWhereFiltroSV

	cQuery += " ORDER BY B2_FILIAL, B2_COD, B2_LOCAL, BF_LOCALIZ, B8_LOTECTL, B8_NUMLOTE, BF_NUMSERI "

	cQuery := changeQuery(cQuery)

	nBind := 1

    oQuery := FwExecStatement():New(cQuery)

	// JOIN - SB1
	oQuery:SetString(nBind++, ' ')

	// JOIN - NNR
	oQuery:SetString(nBind++, ' ')

	// JOIN - SBF
	if jParams['MV_PAR14'][1] == 2
		oQuery:SetNumeric(nBind++, 0)
	endif
	oQuery:SetString(nBind++, ' ')

	// JOIN - SB8
	oQuery:SetString(nBind++, 'S')
	oQuery:SetString(nBind++, 'S')
	if jParams['MV_PAR14'][1] == 2
		oQuery:SetNumeric(nBind++, 0)
	endif
	oQuery:SetString(nBind++, ' ')

	// WHERE
	oQuery:SetIn(nBind++, aFils)
	oQuery:SetString(nBind++, jParams['MV_PAR03'][1])
	oQuery:SetString(nBind++, jParams['MV_PAR04'][1])
	oQuery:SetString(nBind++, jParams['MV_PAR01'][1])
	oQuery:SetString(nBind++, jParams['MV_PAR02'][1])
	if jParams['MV_PAR15'][1] == 2
		oQuery:SetDate(nBind++, CTOD("  /  /  "))
		oQuery:SetDate(nBind++, dDataDe)
		oQuery:SetDate(nBind++, dDataAte)
	else
		oQuery:SetDate(nBind++, CTOD("  /  /  "))
		oQuery:SetDate(nBind++, CTOD("  /  /  "))
		oQuery:SetDate(nBind++, dDataDe)
		oQuery:SetDate(nBind++, dDataAte)
	endif
	if jParams['MV_PAR14'][1] == 2
		oQuery:SetNumeric(nBind++, 0)
	endif
	oQuery:SetString(nBind++, ' ')
	oQuery:SetString(nBind++, jParams['MV_PAR05'][1])
	oQuery:SetString(nBind++, jParams['MV_PAR06'][1])
	oQuery:SetString(nBind++, jParams['MV_PAR07'][1])
	oQuery:SetString(nBind++, jParams['MV_PAR08'][1])
	oQuery:SetString(nBind++, jParams['MV_PAR09'][1])
	oQuery:SetString(nBind++, jParams['MV_PAR10'][1])
	
	cAlias := oQuery:OpenAlias()

	Do While !(cAlias)->(Eof())

		if lImpLote
			aLine[1] := (cAlias)->BF_LOCALIZ
			aLine[2] := (cAlias)->B8_LOTECTL
			aLine[3] := (cAlias)->B8_NUMLOTE
			aLine[4] := (cAlias)->BF_NUMSERI
		endif

		jItems := JsonObject():New()

		// Laço para carregar os valores nos campos padrões do schema do objeto
		For nX := 1 To Len(aFields)
				
			cFldName := alltrim(aFields[nX]:getName())
			cFldType := alltrim(aFields[nX]:getType())

			if left(cFldName,3) <> "BF_" .And. left(cFldName,3) <> "B8_"
				if cFldName == "EMPNOME"
					jItems[cFldName] := self:getInfoEmp("M0_NOME", (cAlias)->B2_FILIAL)
				elseif cFldName == "FILNOME"
					jItems[cFldName] := self:getInfoEmp("M0_FILIAL", (cAlias)->B2_FILIAL)
				elseif left(cFldName,5) == "COLUM"
					nY := val(right(cFldName,2))
					jItems[cFldName] := aColumn[nY]
				elseif left(cFldName,4) == "LINE"
					nY := val(right(cFldName,2))
					jItems[cFldName] := aLine[nY]
				elseif cFldType == "date" .and. !Empty( (cAlias)->&(cFldName) )
					jItems[cFldName] := totvs.framework.treports.date.dateToTimeStamp( StoD((cAlias)->&(cFldName)) )
				else
					jItems[cFldName] := (cAlias)->&(cFldName)
				endif
			endif

		Next nX

		self:processData()
		self:appendData(jItems)

		(cAlias)->( dbSkip() )
	EndDo

	(cAlias)->( DBCloseArea() )

	oQuery:Destroy()

return self:oData

/*/{Protheus.doc} oNGetSchema
Metodo que retorna a Estrutura de dados.
@type  Metodo
@author Squad Entradas
@since  Maio 15,2023
/*/
method oNGetSchema() class InventoryListTReportsBusinessObject

local aFldSB1	as array
local aFldSB2	as array
local aFldSB8	as array
local aFldNNR	as array
local aFldSBF	as array
local aColumn	as array
local aLine		as array

    aFldSB2 := {"B2_FILIAL","B2_COD","B2_LOCAL"}
    aFldNNR := {"NNR_DESCRI"}
    aFldSB1 := {"B1_TIPO","B1_GRUPO","B1_DESC","B1_UM"}
    aFldSBF := {"BF_LOCALIZ", "BF_NUMSERI"}
    aFldSB8 := {"B8_LOTECTL", "B8_NUMLOTE"}
    aColumn	:= {"COLUM01","COLUM02","COLUM03","COLUM04","COLUM05","COLUM06","COLUM07","COLUM08","COLUM09","COLUM10"}
    aLine   := {"LINE01","LINE02","LINE03","LINE04","LINE05","LINE06","LINE07","LINE08","LINE09","LINE10"}

    self:aliasToSchema("SB2",aFldSB2)
    self:aliasToSchema("NNR",aFldNNR)
    self:aliasToSchema("SB1",aFldSB1)
    self:aliasToSchema("SBF",aFldSBF)
    self:aliasToSchema("SB8",aFldSB8)

    self:addProperty( "EMPNOME"		, STR0034, "string", STR0034, "EMPNOME", , , , .F. )//Empresa
    self:addProperty( "FILNOME"		, STR0038, "string", STR0038, "FILNOME", , , , .F. )//"Nome Filial"
    self:addProperty( aColumn[1]	, STR0014, "string", STR0014, "COLUM01", , , , .F. )//Coluna 01
    self:addProperty( aLine[1]		, STR0015, "string", STR0015, "LINE01" , , , , .F. )//Linha 01
    self:addProperty( aColumn[2]	, STR0016, "string", STR0016, "COLUM02", , , , .F. )//Coluna 02
    self:addProperty( aLine[2]		, STR0017, "string", STR0017, "LINE02" , , , , .F. )//Linha 02
    self:addProperty( aColumn[3]	, STR0018, "string", STR0018, "COLUM03", , , , .F. )//Coluna 03
    self:addProperty( aLine[3]		, STR0019, "string", STR0019, "LINE03" , , , , .F. )//Linha 03
    self:addProperty( aColumn[4]	, STR0020, "string", STR0020, "COLUM04", , , , .F. )//Coluna 04
    self:addProperty( aLine[4]		, STR0021, "string", STR0021, "LINE04" , , , , .F. )//Linha 04
    self:addProperty( aColumn[5]	, STR0022, "string", STR0022, "COLUM05", , , , .F. )//Coluna 05
    self:addProperty( aLine[5]		, STR0023, "string", STR0023, "LINE05" , , , , .F. )//Linha 05
    self:addProperty( aColumn[6]	, STR0024, "string", STR0024, "COLUM06", , , , .F. )//Coluna 06
    self:addProperty( aLine[6]		, STR0025, "string", STR0025, "LINE06" , , , , .F. )//Linha 06
    self:addProperty( aColumn[7]	, STR0026, "string", STR0026, "COLUM07", , , , .F. )//Coluna 07
    self:addProperty( aLine[7]		, STR0027, "string", STR0027, "LINE07" , , , , .F. )//Linha 07
    self:addProperty( aColumn[8]	, STR0028, "string", STR0028, "COLUM08", , , , .F. )//Coluna 08
    self:addProperty( aLine[8]		, STR0029, "string", STR0029, "LINE08" , , , , .F. )//Linha 08
    self:addProperty( aColumn[9]	, STR0030, "string", STR0030, "COLUM09", , , , .F. )//Coluna 09
    self:addProperty( aLine[9]		, STR0031, "string", STR0031, "LINE09" , , , , .F. )//Linha 09
    self:addProperty( aColumn[10]	, STR0032, "string", STR0032, "COLUM10", , , , .F. )//Coluna 10
    self:addProperty( aLine[10]		, STR0033, "string", STR0033, "LINE10" , , , , .F. )//Linha 10

return
