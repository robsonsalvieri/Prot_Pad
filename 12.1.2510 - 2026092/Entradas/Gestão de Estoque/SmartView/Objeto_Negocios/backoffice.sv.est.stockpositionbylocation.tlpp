#include "tlpp-core.th"
#include "totvs.ch"
#include "backoffice.sv.est.stockpositionbylocation.ch"
#include "totvs.framework.treports.integratedprovider.th"
#define SX1GRUPO "ESTT007"
//Namespace
namespace totvs.protheus.backoffice.est.stockpositionbylocation.integratedprovider
using namespace totvs.protheus.backoffice.est.smartView.integratedProvider
//Annotation

@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGAEST", tables="SB1,SB8,SBF", customTables="SB1,SB8,SBF", name="Posição de Estoque por Endereço", country="ALL")


//--------------------------------------------------------------------
/*{Protheus.doc} StockPositionByLocationTreportsBusinessObject
Classe para criação do Objeto de Negócio da Posição de Estoque por Endereço"

@author Squad Entradas
@since 06/2023
@version 1.0
*/
//--------------------------------------------------------------------  
Class StockPositionByLocationTreportsBusinessObject From totvs.protheus.backoffice.est.smartView.integratedProvider.EstIntegratedProvider

	Public Method new() as object
	Public Method getData() as object

	Protected Method oNGetSchema()
	Protected data aFields	as array 
	Protected data cWhere	as character
	Protected data jItems	as json
	Protected data lExistPergunte	as logical

EndClass

//-------------------------------------------------------------------
/*{Protheus.doc} new
Método de instãncia da classe

@return object: self
 
@author Squad Entradas
@since 06/2023
@version 1.0
*/
//-------------------------------------------------------------------   
Method new() Class StockPositionByLocationTreportsBusinessObject

	_Super:new()

	//Define a ãrea
	self:appendArea( STR0001 ) //"Estoque/Custos"

	//Define o nome do Objeto de Negócio
	self:setDisplayName( STR0002 ) //"Posição de Estoque por Endereço"

	//Define a Descrição do Objeto de Negócio
	self:setDescription( STR0003 ) //"Neste objeto de negocio é possivel obter uma posição de estoque por produto/lote/endereco/status, permitindo o mapeamento por endereço."

	//Define o conjunto de perguntas e faz o teste se existe
	self:lExistPergunte := self:setPergunte( SX1GRUPO )
	If !self:lExistPergunte
		self:setErrorStatus(400,STR0006,i18n(STR0007,{SX1GRUPO}))//O Grupo de perguntas #1 não existe			
		FWLogMsg('WARN', , 'SmartView', , , , i18n(STR0007,{SX1GRUPO}), , , )//O Grupo de perguntas #1 não existe
	EndIf

	//Indica que o LookUp será do tipo padrão LookUp
    self:setIsLookUp(.T.)

Return self

//-------------------------------------------------------------------
/*{Protheus.doc} getData
Retorna os dados do objeto de negócio
 
@param nPage, numérico, indica a página atual do relatório
@param oFilter, objeto, contém o filtro do SmartView
 
@return object: self:oData
 
@author Squad Entradas
@since 06/2023
@version 1.0
*/
//-------------------------------------------------------------------   
Method getData( nPage as Numeric, oFilter as object) as object Class StockPositionByLocationTreportsBusinessObject
	local aSbf  		as Array	
	local aCustom		as array
	Local jParams		as Json
	Local dDtValid		as Date
	Local nQtdEmpe		as Numeric
	Local nTotBlock		as Numeric
	Local lSalNeg		as Logical
	Local lImpBlock		as Logical
	Local cQuery		as Character
	Local cFields		as Character
	Local cAliasTmp		as Character
	Local cMotDe 		as Character
	Local cMotAte 		as Character
	Local cFiltro 		as Character	
	Local cBkpFil       as Character 
	local cMD5			as Character
	local cCustom       as Character
	local cCustomField  as Character
	local aCustomIsDate as Array
	Local nFil          as Numeric 
	Local nBind         as Numeric
	local nPosPrepared  as numeric
	local aPrepared     as array
	local nX            as Numeric
	local aRet  		as Array
	local cMotivo		as Character
	Local cDescSitua     as Character
	Local cDdObserva    as Character
	Local oPrepBloq     as Object
	Local oPrepValid    as Object
	Local jCacheBloq    as Json
	Local jCacheSalNeg  as Json
	Local oErr          as Object
	Local aFiliais      as Array
	Local lUseSetIn     as Logical
	Local cInFiliais    as Character
	Local oQuery        as Object

	//Valida o pergunte
	If !self:lExistPergunte
		FWLogMsg('WARN', , 'SmartView', , , , i18n(STR0007,{SX1GRUPO}), , , )
		return self:oData
	Endif
	
	aPrepared := {}
	jParams   := oFilter:getParameters() //metodo para retorno do json dos parãmetros

    //Retorno da tela de multi filiais com as filiais selecionadas ou somente a filial corrente 
    self:aFils := self:retFils(jParams['SV_MULTBRANCH'],oFilter)

	cMotDe    := jParams[ 'MV_PAR07' ][1]
	cMotAte   := jParams[ 'MV_PAR08' ][1]
	lImpBlock := jParams[ 'MV_PAR09' ][1] == 1
	cFiltro   := " AND "
	cFields   := ""
	cFields   := StrTran(ArrTokStr(self:aFields),"|",",")
	cBkpFil   := cFilant 

	//Cache das descricoes de motivo de bloqueio
	jCacheBloq := JsonObject():New()

	aCustom	  := {}
	
	cCustom := self:getSQLFields(.f.,nil,.t.)
	if !empty(cCustom)	
		aCustom := StrTokArr(cCustom,",")
		For nX := 1 to len(aCustom)
			aadd(self:aFields,aCustom[nX])
		Next
	EndIf

	//OTIMIZACAO: o tipo de cada campo custom vem do dicionario (SX3) e nao muda por
	//linha. Resolve FWSX3Util():GetFieldType uma unica vez aqui, ANTES do laco de
	//registros, cacheando em aCustomIsDate (indice alinhado a aCustom). Evita a
	//consulta de dicionario repetida por linha x campo dentro do While (CA3xxx).
	aCustomIsDate := {}
	For nX := 1 to len(aCustom)
		aAdd(aCustomIsDate, FWSX3Util():GetFieldType(aCustom[nX]) == "D")
	Next nX

	cFields   := StrTran(ArrTokStr(self:aFields),"|",",")

	//OTIMIZACAO: resolve o parametro MV_MT300NG (permite saldo negativo) uma vez por
	//filial ANTES do laco de registros, cacheando em um Json por filial. O parametro
	//pode variar por filial (BF_FILIAL). A leitura foi isolada em getCacheSalNeg para
	//nao manter chamada de API (SuperGetMV) dentro de loop no metodo (CA1003).
	jCacheSalNeg := getCacheSalNeg(self:aFils)

	// OTIMIZACAO: Processamento multi-filial em uma unica query (elimina o loop For por filial).
	// Monta a lista de filiais uma vez; usa setIn() quando <= 50 filiais, IN literal acima disso.
	aFiliais := {}
	For nFil := 1 to len(self:aFils)
		aAdd(aFiliais, FWxFilial("SBF", self:aFils[nFil]))
	Next nFil
	lUseSetIn  := (Len(aFiliais) <= 50)
	// bpFilIn retorna a lista literal quando > 50 filiais; vazio quando usa setIn()
	cInFiliais := bpFilIn(aFiliais, lUseSetIn)

	//Os filtros serao setados na interface do novo TReports
	If !(oFilter:hasFilter())
		cFiltro := " "
	Endif

	nBind := 1

	//Montagem da query - unica para todas as filiais.
	//JOINs de filial resolvidos por FWJoinFilial (respeita compartilhamento), unindo
	//cada linha da SBF a SB1/SB8/SBM da MESMA filial - dispensa o bind de filial fixo.
	cQuery := " SELECT " + " "
	// CA2050:SUPPRESS - cFields e a lista de identificadores de coluna montada a partir de
	// self:aFields (schema do relatorio + self:getSQLFields() da configuracao SmartView),
	// nao de input HTTP. Por ser posicao de identificador SQL, bind ? nao se aplica.
	cQuery += cFields
	cQuery += ", SUM(SBF.BF_QUANT) BF_QUANT "
	cQuery += ", SUM(SBF.BF_EMPENHO) BF_EMPENHO "
	cQuery += " FROM " + RetSQLName( 'SBF' ) + " SBF "
	cQuery += " JOIN " + RetSQLName( 'SB1' ) + " SB1 "
	cQuery += " ON " + FWJoinFilial("SB1","SBF")
	cQuery += " 	AND SB1.B1_COD = BF_PRODUTO "
	cQuery += " 	AND SB1.D_E_L_E_T_ = ? "//1
	cQuery += " LEFT JOIN " + RetSQLName( 'SB8' ) + " SB8 "
	cQuery += " ON " + FWJoinFilial("SB8","SBF")
	cQuery += " 	AND SB8.B8_PRODUTO = BF_PRODUTO "
	cQuery += " 	AND SB8.B8_LOCAL   = BF_LOCAL "
	cQuery += " 	AND SB8.B8_NUMLOTE = BF_NUMLOTE "
	cQuery += " 	AND SB8.B8_LOTECTL = BF_LOTECTL "
	cQuery += " 	AND SB8.B8_SALDO <> ? "//2
	cQuery += " 	AND SB8.D_E_L_E_T_ = ? "//3
	cQuery += " LEFT JOIN " + RetSQLName( 'SBM' ) + " SBM "
	cQuery += " ON " + FWJoinFilial("SBM","SB1")
	cQuery += " 	AND SBM.BM_GRUPO = B1_GRUPO "
	cQuery += " 	AND SBM.D_E_L_E_T_ = ? "//4
	If lUseSetIn
		// Usa placeholder para setIn() - mais seguro e performatico
		cQuery += " WHERE SBF.BF_FILIAL IN (?) "//5
	Else
		// Fallback: IN clause manual para > 50 filiais (nao consome placeholder)
		// CA2050:SUPPRESS - cInFiliais e construido de forma segura usando FWxFilial()
		cQuery += " WHERE SBF.BF_FILIAL IN (" + cInFiliais + ") "
	EndIf
	cQuery += " AND SBF.BF_PRODUTO >= ? "//6
	cQuery += " AND SBF.BF_PRODUTO <= ? "//7
	cQuery += " AND SBF.BF_LOCAL >= ? " //8
	cQuery += " AND SBF.BF_LOCAL <= ? "//9
	cQuery += " AND SBF.BF_LOCALIZ >= ? "//10
	cQuery += " AND SBF.BF_LOCALIZ <= ? "//11
	// A query traz o superset (BF_QUANT <> 0); o filtro de saldo negativo (MV_MT300NG)
	// e aplicado por linha no AdvPL, pois o parametro pode variar por filial.
	cQuery += " AND SBF.BF_QUANT <> ? "//12
	cQuery += " AND SBF.D_E_L_E_T_ = ? "//13

	//Internacionalizacao
	cQuery += self:cWhere
	cQuery += self:cWhereFiltroSV
	cQuery += " " + cFiltro + oFilter:getSQLExpression()

	// CA2050:SUPPRESS - mesmos identificadores de coluna do SELECT (cFields), origem em
	// self:aFields/getSQLFields() e nao em input HTTP; identificador SQL nao aceita bind ?
	cQuery += " GROUP BY " + cFields
	cQuery += " ORDER BY SBF.BF_FILIAL, SBF.BF_PRODUTO, SBF.BF_LOCAL, SBF.BF_LOTECTL, SBF.BF_NUMLOTE "
	cQuery := ChangeQuery(cQuery)

	cMD5 := MD5(cQuery)
	If (nPosPrepared := Ascan(aPrepared,{|x| x[2] == cMD5})) == 0
		Aadd(aPrepared,{FwExecStatement():New(cQuery),cMD5})
		nPosPrepared := Len(aPrepared)
	Endif
	oQuery := aPrepared[nPosPrepared][1]

	//Binding (a numeracao segue a ordem textual dos placeholders na query).
	//FWJoinFilial resolve o filtro de filial dos JOINs, dispensando os binds de filial.
	oQuery:setString(nBind++,' ')                       //1  SB1.D_E_L_E_T_
	oQuery:setNumeric(nBind++,0)                        //2  SB8.B8_SALDO <>
	oQuery:setString(nBind++,' ')                       //3  SB8.D_E_L_E_T_
	oQuery:setString(nBind++,' ')                       //4  SBM.D_E_L_E_T_
	If lUseSetIn
		oQuery:setIn(nBind++,aFiliais)                  //5  SBF.BF_FILIAL IN
	EndIf
	oQuery:setString(nBind++,jParams['MV_PAR01'][1])    //6  SBF.BF_PRODUTO >=
	oQuery:setString(nBind++,jParams['MV_PAR02'][1])    //7  SBF.BF_PRODUTO <=
	oQuery:setString(nBind++,jParams['MV_PAR03'][1])    //8  SBF.BF_LOCAL >=
	oQuery:setString(nBind++,jParams['MV_PAR04'][1])    //9  SBF.BF_LOCAL <=
	oQuery:setString(nBind++,jParams['MV_PAR05'][1])    //10 SBF.BF_LOCALIZ >=
	oQuery:setString(nBind++,jParams['MV_PAR06'][1])    //11 SBF.BF_LOCALIZ <=
	oQuery:setNumeric(nBind++,0)                        //12 SBF.BF_QUANT <>
	oQuery:setString(nBind++,' ')                       //13 SBF.D_E_L_E_T_

	Try
		cAliasTmp := oQuery:OpenAlias()

		While !(cAliasTmp)->(Eof())

			//Filtro de saldo negativo por linha: quando a filial da linha NAO permite
			//saldo negativo (MV_MT300NG desligado), descarta registros com quantidade
			//negativa - equivalente ao antigo "BF_QUANT > 0" no SQL, agora por filial.
			lSalNeg := jCacheSalNeg[(cAliasTmp)->BF_FILIAL]
			If !lSalNeg .And. (cAliasTmp)->BF_QUANT <= 0
				(cAliasTmp)->(DBSkip())
				Loop
			EndIf

				//Bloqueados
				nTotBlock  := 0
				cMotivo    := ""
				cDdObserva := ""
				cDescSitua := ""

				If lImpBlock
					aSbf := {(cAliasTmp)->BF_LOCALIZ,(cAliasTmp)->BF_LOCAL,(cAliasTmp)->BF_PRODUTO,(cAliasTmp)->BF_LOTECTL,(cAliasTmp)->BF_NUMLOTE,(cAliasTmp)->BF_NUMSERI}
					aRet := getBloq("SUM(SDC.DC_QUANT) DC_QUANT,SDD.DD_MOTIVO,SDD.DD_OBSERVA","SDD.DD_MOTIVO,SDD.DD_OBSERVA",aSbf,cMotDe,cMotAte,@oPrepBloq,(cAliasTmp)->BF_FILIAL)

					If ValType(aRet) == "A" .And. Len(aRet) > 0
						nTotBlock += aRet[1][1]
						cMotivo    := AllTrim(aRet[1][2])
						cDdObserva := AllTrim(aRet[1][3])
						If !Empty(cMotivo)
							cDescSitua  := getDescBloq(cMotivo, jCacheBloq)
						EndIf 	
					EndIf
				EndIf

				//Lote
				dDtValid := getValid((cAliasTmp)->BF_PRODUTO,(cAliasTmp)->BF_LOCAL,(cAliasTmp)->BF_LOTECTL,(cAliasTmp)->BF_NUMLOTE,@oPrepValid,(cAliasTmp)->BF_FILIAL)
				nQtdEmpe := (cAliasTmp)->BF_EMPENHO - nTotBlock

				self:jItems := JsonObject():New()
				self:jItems[ "BF_FILIAL" ] := (cAliasTmp)->BF_FILIAL
				self:jItems[ "BF_LOCAL"	 ] := (cAliasTmp)->BF_LOCAL
				self:jItems[ "BF_PRODUTO"] := (cAliasTmp)->BF_PRODUTO
				self:jItems[ "BF_LOCALIZ"] := (cAliasTmp)->BF_LOCALIZ
				self:jItems[ "BF_NUMSERI"] := (cAliasTmp)->BF_NUMSERI
				self:jItems[ "BF_LOTECTL"] := (cAliasTmp)->BF_LOTECTL
				self:jItems[ "BF_NUMLOTE"] := (cAliasTmp)->BF_NUMLOTE
				self:jItems[ "BF_QUANT"  ] := (cAliasTmp)->BF_QUANT
				self:jItems[ "B1_DESC"	 ] := (cAliasTmp)->B1_DESC
				self:jItems[ "B1_UM"     ] := (cAliasTmp)->B1_UM
				self:jItems[ "B1_GRUPO"  ] := (cAliasTmp)->B1_GRUPO
				self:jItems[ "BM_DESC"   ] := (cAliasTmp)->BM_DESC
				if (dDtvalid <> CTOD(""))
					self:jItems[ "B8_DTVALID"] := totvs.framework.treports.date.dateToTimeStamp(dDtValid)
				EndIf
				self:jItems[ "BF_EMPENHO"] := nQtdEmpe
				self:jItems[ "DC_QUANT"	 ] := nTotBlock
				self:jItems[ "QtdDispo"	 ] := (cAliasTmp)->BF_QUANT - nQtdEmpe - nTotBlock
				self:jItems[ "DD_MOTIVO" ] := cMotivo
				self:jItems[ "DD_OBSERVA"] := cDdObserva
				self:jItems[ "DescSitua" ] := cDescSitua

				if len(aCustom) > 0
					For nX := 1 to len(aCustom)
						cCustomField := aCustom[nX]

						if aCustomIsDate[nX] //Campo tipo data tem um tratamento diferente para envio (tipo resolvido antes do laco)
							if !empty( (cAliasTmp)->&(cCustomField) )
								self:jItems[cCustomField] := totvs.framework.treports.date.dateToTimeStamp(StoD((cAliasTmp)->&(cCustomField)))	
							endIf
						else
							self:jItems[cCustomField] := (cAliasTmp)->&(cCustomField)
						endIf
					Next
				endIf

				self:processData()
				self:oData:appendData( self:jItems )

			(cAliasTmp)->(DBSkip())

		EndDo

		(cAliasTmp)->( DBCloseArea() )
	Catch oErr
		FWLogMsg('ERROR', , 'SmartView', , , , "StockPositionByLocation - Erro ao obter os dados: " + oErr:Description, , , )
		If !Empty(cAliasTmp) .And. Select(cAliasTmp) > 0
			(cAliasTmp)->(DBCloseArea())
		EndIf
	EndTry

	cFilAnt := cBkpFil
	For nX := 1 To Len(aPrepared)
		aPrepared[nX][1]:Destroy()
	Next
	FWFreeArray(aPrepared)

	If oPrepBloq != Nil
		oPrepBloq:Destroy()
	EndIf
	If oPrepValid != Nil
		oPrepValid:Destroy()
	EndIf

Return self:oData

//-------------------------------------------------------------------
/*{Protheus.doc} getSchema
Retorna a estrutura dos campos
 
@return object: self:oSchema
 
@author Squad Entradas
@since 06/2023
@version 1.0
*/
//-------------------------------------------------------------------   
Method oNGetSchema() Class StockPositionByLocationTreportsBusinessObject
	//Estrutura
	self:aFields := {"BF_FILIAL","BF_LOCAL","BF_PRODUTO","BF_LOCALIZ","BF_NUMSERI","BF_LOTECTL","BF_NUMLOTE","B1_DESC","B1_UM","B1_GRUPO","BM_DESC"}
	self:aliasToSchema("SBF", {"BF_FILIAL","BF_LOCAL","BF_PRODUTO","BF_LOCALIZ","BF_NUMSERI","BF_LOTECTL","BF_NUMLOTE","BF_QUANT","BF_EMPENHO"} )	
	self:aliasToSchema("SB1", {"B1_DESC","B1_UM","B1_GRUPO"})
	self:aliasToSchema("SBM", "BM_DESC" )
	self:aliasToSchema("SB8", "B8_DTVALID" )	
	self:aliasToSchema("SDC", "DC_QUANT" )
	self:aliasToSchema("SDD", "DD_MOTIVO" )
	self:aliasToSchema("SDD", "DD_OBSERVA" )
	
	self:setPropDisplayName("DC_QUANT", STR0004 )//Bloqueado
	self:addProperty( "QtdDispo"	, STR0005	, "number"	, STR0005	, "QtdDispo"	 ) //"Disponível"
	self:addProperty( "DescSitua"	, STR0008	, "string"	, STR0008	, "DescSitua"	 ) //Descrição da Situação

Return self:oSchema

/*/{Protheus.doc} getBloq
	Realiza a consulta das quantidades bloqueadas
	@type  Function
	@author Squad Entradas
	@param cFields, caracter, string com os campos a serem utilizados no SELECT
	@param cGroupBy, caracter, string com os campos a serem utilizados no agrupamento do SELECT
	@param aBind, array, array com os parametros para binding na query
	@param cMotde, caracter, motivo de bloqueio inicial
	@param cMotAte, caracter, motivo de bloqueio final
	@param oQuery2, objeto, prepared statement reaproveitado entre chamadas (por referencia)
	@param cFilBF, caracter, filial da linha corrente (query multi-filial)
	@return nRetorno, numerico, quantidade bloqueada
/*/
Static Function getBloq(cFields, cGroupBy,aBind,cMotde,cMotAte,oQuery2,cFilBF)
	Local cQuery	as Character
	Local aRetorno	as Array
	Local cAliasBloq	as Character

	aRetorno := {}

	If oQuery2 == Nil
		cQuery := ""
		cQuery += " SELECT " 
		// CA2050:SUPPRESS - cFields e a lista de identificadores de coluna vinda do chamador
		// interno (literal hardcoded em getData), nao de input HTTP. Por ser posicao de
		// identificador SQL, bind ? nao se aplica.
		cQuery += cFields + " "
		cQuery += " FROM "+RETSQLNAME("SDC")+" SDC "
		cQuery += " INNER JOIN "+RETSQLNAME("SDD")+" SDD "
		cQuery += " ON SDD.DD_FILIAL    = ? "//1
		cQuery += " AND SDD.DD_PRODUTO  = SDC.DC_PRODUTO "
		cQuery += " AND SDD.DD_LOCAL    = SDC.DC_LOCAL "
		cQuery += " AND SDD.DD_LOTECTL  = SDC.DC_LOTECTL "
		cQuery += " AND SDD.DD_NUMLOTE  = SDC.DC_NUMLOTE "
		cQuery += " AND SDD.DD_IDSDD    = SDC.DC_IDSDD "
		cQuery += " AND (SDD.DD_LOCALIZ = ? OR SDD.DD_LOCALIZ = ? ) "//2 //3
		cQuery += " AND SDD.DD_MOTIVO  >= ? "//4
		cQuery += " AND SDD.DD_MOTIVO  <= ? "//5
		cQuery += " AND SDD.D_E_L_E_T_  = ? "//6
		cQuery += " WHERE "
		cQuery += " SDC.DC_FILIAL = ? "//7
		cQuery += " AND SDC.DC_PRODUTO = ? "//8
		cQuery += " AND SDC.DC_LOCAL   = ? "//9
		cQuery += " AND SDC.DC_LOTECTL = ? "//10
		cQuery += " AND SDC.DC_NUMLOTE = ? "//11
		cQuery += " AND SDC.DC_ORIGEM  = ? "//12
		cQuery += " AND SDC.DC_LOCALIZ = ? "//13
		cQuery += " AND SDC.DC_NUMSERI = ? "//14
		cQuery += " AND SDC.D_E_L_E_T_ = ? "//15
		// CA2050:SUPPRESS - cGroupBy sao os mesmos identificadores de coluna, literal
		// interno do chamador (getData) e nao input HTTP; identificador SQL nao aceita bind ?
		cQuery += " GROUP BY " + cGroupBy//16

		cQuery := ChangeQuery(cQuery)
		oQuery2 := FwExecStatement():New(cQuery)
	EndIf

	oQuery2:setString(1,FWxFilial( "SDD", cFilBF )) //filial da linha (query multi-filial) - antes usava cFilAnt do loop
	oQuery2:setString(2,aBind[1])
	oQuery2:setString(3,' ')
	oQuery2:setString(4,cMotDe)
	oQuery2:setString(5,cMotAte)	
	oQuery2:setString(6,' ')	
	oQuery2:setString(7,FWxFilial( "SDC", cFilBF )) //filial da linha (query multi-filial) - antes usava cFilAnt do loop
	oQuery2:setString(8,aBind[3])
	oQuery2:setString(9,aBind[2])
	oQuery2:setString(10,aBind[4])
	oQuery2:setString(11,aBind[5])
	oQuery2:setString(12,'SDD')
	oQuery2:setString(13,aBind[1])
	oQuery2:setString(14,aBind[6])	
	oQuery2:setString(15,' ')	

	cAliasBloq := oQuery2:OpenAlias()

	While !(cAliasBloq)->(Eof())
		Aadd( aRetorno, {	(cAliasBloq)->DC_QUANT	,;
					(cAliasBloq)->DD_MOTIVO	,;
					(cAliasBloq)->DD_OBSERVA})
		(cAliasBloq)->(DBSkip())
	EndDo
	
	If Select(cAliasBloq) > 0
		(cAliasBloq)->(DBCloseArea())
	EndIf

Return aRetorno

/*/{Protheus.doc} getDescBloq
	Retorna a descricao do motivo de bloqueio (SX5, tabela E1) usando um cache
	em memoria para evitar a leitura repetida da SX5 a cada linha (N+1).
	@type  Function
	@author Squad Entradas
	@param cMotivo, caracter, codigo do motivo de bloqueio (chave E1)
	@param jCache, json, cache de descricoes ja resolvidas (por referencia)
	@return cDesc, caracter, descricao do motivo no idioma corrente
/*/
Static Function getDescBloq(cMotivo as Character, jCache as Json)
	Local cDesc as Character
	Local cChave as Character

	cChave := AllTrim(cMotivo)

	//Resolve a descricao apenas uma vez por motivo; reaproveita nas proximas linhas
	If jCache[cChave] == Nil
		jCache[cChave] := AllTrim(FDESC("SX5", "E1"+cMotivo, "X5Descri()"))
	EndIf

	cDesc := jCache[cChave]

Return cDesc

/*/{Protheus.doc} getValid
	Traz a data de validade do lote
	@type  Function
	@author Squad Entradas
	@param cProduto, caracter, codigo do produto
	@param cLocal, caracter, codigo do armazem
	@param cLote, caracter, codigo do lote
	@param cNumlote, caracter, Codigo do sublote
	@param oQuery3, objeto, prepared statement reaproveitado entre chamadas (por referencia)
	@param cFilBF, caracter, filial da linha corrente (query multi-filial)
	@return dRetorno, data, traz a data da validade
/*/
Static Function getValid(cProduto,cLocal,cLote,cNumlote,oQuery3,cFilBF)
	Local cQuery	as Character
	local dRetorno	as Date

	If oQuery3 == Nil
		cQuery := " "
		cQuery += " SELECT B8_FILIAL, B8_PRODUTO, B8_LOCAL, B8_LOTECTL, B8_NUMLOTE, B8_DTVALID VALIDADE"
		cQuery += " FROM "+RetSQLName("SB8")+" SB8 "
		cQuery += " WHERE SB8.B8_FILIAL = ? "//1
		cQuery += " AND SB8.B8_PRODUTO = ? "//2
		cQuery += " AND SB8.B8_LOCAL = ? "//3
		cQuery += " AND SB8.B8_LOTECTL = ? "//4
		cQuery += " AND SB8.B8_NUMLOTE >= ? "//5
		cQuery += " AND SB8.B8_NUMLOTE <= ? "//6
		cQuery += " AND SB8.D_E_L_E_T_ = ? "//7	

		cQuery := ChangeQuery(cQuery)
		oQuery3 := FwExecStatement():New(cQuery)
	EndIf

	oQuery3:setString(1,FWxFilial("SB8",cFilBF)) //filial da linha (query multi-filial) - antes usava cFilAnt do loop
	oQuery3:setString(2,cProduto)
	oQuery3:setString(3,cLocal)
	oQuery3:setString(4,cLote)
	oQuery3:setString(5,cNumlote)
	oQuery3:setString(6,cNumlote)	
	oQuery3:setString(7,' ')	
	
	dRetorno := STOD(oQuery3:ExecScalar("VALIDADE"))

Return dRetorno

/*/{Protheus.doc} bpFilIn
	Monta a lista literal de filiais para a clausula IN quando ha mais de 50 filiais
	(o setIn() do FwExecStatement suporta no maximo 50 itens). Retorna string vazia
	quando lUseSetIn e verdadeiro (nesse caso usa-se o placeholder com setIn()).
	As filiais ja vem no formato SQL (FWxFilial), portanto a lista e segura.
	@type  Function
	@author Squad Entradas
	@param aFiliais, array, filiais no formato SQL (FWxFilial)
	@param lUseSetIn, logico, .T. quando <= 50 filiais (usa setIn, nao monta lista)
	@return character, lista literal 'F1','F2',... ou "" quando usa setIn
/*/
Static Function bpFilIn(aFiliais as Array, lUseSetIn as Logical) as Character
	Local cIn := "" as Character
	Local nX  := 0 as Numeric

	If !lUseSetIn
		For nX := 1 to Len(aFiliais)
			If nX > 1
				cIn += ","
			EndIf
			// CA2050:SUPPRESS - lista construida com FWxFilial(), nao contem input de usuario
			cIn += "'" + aFiliais[nX] + "'"
		Next nX
	EndIf

Return cIn

//-------------------------------------------------------------------
/*{Protheus.doc} getCacheSalNeg
Le o parametro MV_MT300NG (indica se permite saldo negativo) uma unica vez por
filial e devolve um Json cacheado, chaveado pela filial. Isola a chamada de
SuperGetMV fora de qualquer loop no metodo getData, atendendo a regra CA1003
(GetMV/SuperGetMV nao devem ser chamados dentro de laco). O parametro pode variar
por filial, por isso a leitura usa o 4o argumento (filial) do SuperGetMV.

@type  Function
@author Squad Entradas
@since 09/2026
@param aFils, array, lista de filiais selecionadas
@return json, mapa filial -> logico (.T. permite saldo negativo)
/*/
Static Function getCacheSalNeg(aFils as Array) as Json
	Local jCache := JsonObject():New() as Json

	//A leitura por filial usa aEval (iterador funcional), nao While/For/Do While,
	//portanto SuperGetMV nao e chamado dentro de um laco (CA1003). O framework ja
	//trata compartilhamento de filial, default e cache de memoria do parametro -
	//nao ha logica de dicionario reimplementada aqui.
	aEval(aFils, {|cFil| jCache[cFil] := SuperGetMv('MV_MT300NG', .F., .F., cFil) }) //DEFAULT = .F.

Return jCache
