#Include 'Totvs.ch'
#Include 'tlpp-core.th'

Using namespace totvs.protheus.backoffice.stock.iterativecost.table.manager
Using namespace totvs.protheus.backoffice.stock.iterativecost.table.balancebywarehouse
Using Namespace totvs.protheus.backoffice.stock.iterativecost.table.aglutinattedmovementtable
using namespace totvs.protheus.backoffice.stock.iterativecost.table.productstructleveltable

Namespace totvs.protheus.backoffice.stock.iterativecost.table.productgrouping

/*/{Protheus.doc} ProductGroupingTable
    Classe responsável pela tabela de grupos de produto, para processamento multi threads
    @author Squad Entradas
    @since 03/12/2024
/*/
Class ProductGroupingTable From TableManager

    Public Method New() 

    Static Method TableFields()
    Static Method TableIndexes()
    Static Method TableName()

    Public Method InsertSQL()
    Public Method StructQuery()
    Public Method NotStrQuery()
    Public Method CalcGrupo()
    Public Method UpdGrupo()
    Public Method UpdLevelTable()

    Public Data   oStrQry    As Object
    Public Data   oNonStrQry As Object
    Public Data   oLoopQry   As Object
    Public Data   oAtuQry    As Object
    Public Data   oPaiQry    As Object
    Public Data   oFilQry    As Object
    Public Data   oQrtLeft   As Object
    Public Data   oQryLast   As Object
    Public Data   oQryFirst  As Object
    Public Data   oQryLevel  As Object
    Public Data   cCusFil    As Character
    Public Data   cFProc     As Character
    Public Data   jParams    As Json

EndClass

/*/{Protheus.doc} New
    Instância da classe
    @author Squad Entradas
    @since 03/12/2024
/*/
Method New(aFil, cFProc, jParams) Class ProductGroupingTable
    ::oStrQry    := Nil
    ::oNonStrQry := Nil
    ::oLoopQry   := Nil
    ::cCusFil    := SuperGetMv("MV_CUSFIL", .F., "A")
    ::cFProc     := cFProc
    ::jParams    := jParams
	
    If ::cCusFil == 'E'
        _Super:New(aFil, 'E', 'C', 'C' )
    Else
        _Super:New(aFil, 'E', 'E', 'E')
    EndIf

    ::TableManager(::TableName(),::TableFields(),::TableIndexes())
Return Self

/*/{Protheus.doc} TableFields
    Campos da tabela
    @author Squad Entradas
    @since 03/12/2024
/*/
Method TableFields() Class ProductGroupingTable
    Local aFields   := {} as array

    aAdd(aFields, {"FILPROC",   "C" , TamSX3('G1_FILIAL')[1],  0})
    aAdd(aFields, {"FILIAL",    "C" , TamSX3('G1_FILIAL')[1], 0})
    aAdd(aFields, {"PRODREQ",   "C" , TamSX3('D1_COD')[1],    0})
    aAdd(aFields, {"PRODDEV",   "C" , TamSX3('D1_COD')[1],    0})
    aAdd(aFields, {"NIVEL",     "C" , 2, 0})
    aAdd(aFields, {"NIVINV",    "C" , 2, 0})
    aAdd(aFields, {"GRUPO",     "N" , 8, 0})
    
Return aFields

/*/{Protheus.doc} TableIndexes
    Índices da tabela
    @author Squad Entradas
    @since 03/12/2024
/*/
Method TableIndexes() Class ProductGroupingTable
    Local aIndex := {} as array

    aAdd(aIndex, {ProductGroupingTable():TableName()+'_01', 'FILPROC+FILIAL+PRODREQ+PRODDEV'})
    aAdd(aIndex, {ProductGroupingTable():TableName()+'_02', 'FILPROC+FILIAL+PRODDEV+PRODREQ'})
    aAdd(aIndex, {ProductGroupingTable():TableName()+'_03', 'FILPROC+FILIAL+NIVINV+GRUPO+PRODREQ'})

Return aIndex

/*/{Protheus.doc} TableName
    Retorna o nome da tabela
    @author Squad Entradas
    @since 03/12/2024
/*/
Method TableName() Class ProductGroupingTable
    Local cAlias as character

    cAlias := "TSG2"+cEmpAnt+"SP"

Return cAlias

/*/{Protheus.doc} StructQuery
    Retorna a query da tabela
    @author Squad Entradas
    @since 03/12/2024
    @cFilAtu - Filial atual
/*/
Method StructQuery(cFilAtu) Class ProductGroupingTable
    Local cQuery       As Character
    Local aCampos      As Array
    Local cCampos      As Character
    Local nI           As Integer
    Local aBind        As Array
    Local dDtIni       As Date
    Local dDtFim       As Date

    dDtIni := ::jParams["dataini"]
    dDtFim := ::jParams["datafin"]

    Default cFilAtu := cFilAnt
    
    cCampos   := " "
    aCampos   := ::TableFields()
    For nI := 1 To Len(aCampos)
        cCampos += aCampos[nI, 1]
        If nI != Len(aCampos)
            cCampos += ", "
        EndIf
    Next nI

    If ::oStrQry == Nil
        cQuery := " Select "
        If ::lPostgres
            cQuery += " Char("+cValToChar(FWSizeFilial())+") "
        EndIf
        cQuery += " '"+::cFProc+"' FILPROC,"
        If ::cCusFil == 'E'
            If ::lPostgres
                cQuery += " Char("+cValToChar(FWSizeFilial())+") "
            EndIf
            cQuery += " '"+PadR(FWCompany(), FWSizeFilial())+"' FILIAL, "
        Else
            cQuery += " REQ.D3_FILIAL FILIAL,"
        EndIf
        cQuery += " REQ.D3_COD PRODREQ, "
        cQuery += " DEV.D3_COD PRODDEV, "
        cQuery += " NIV.NIVEL NIVEL, "
        cQuery += " NIV.NIVINV NIVINV, "
        cQuery += " 0 GRUPO "
        cQuery += " From " +RetSQLName("SD3") +" REQ "
        cQuery += " Inner Join " +RetSQLName("SD3") +" DEV "
        cQuery += " On "
        cQuery += "     DEV.D3_FILIAL = REQ.D3_FILIAL "
        cQuery += " And DEV.D3_NUMSEQ = REQ.D3_NUMSEQ "
        cQuery += " And DEV.D3_CF In (?, ?) "
        cQuery += " And DEV.D3_ESTORNO = ? "
        cQuery += " And DEV.D_E_L_E_T_ = ? "
        cQuery += " Inner Join "+ProductStructLevelTable():TableName()+" NIV "
        cQuery += " On  NIV.FILPROC = ? And "
        If ::cCusFil == 'E'
            cQuery += " NIV.FILIAL  = ? And "
        Else
            cQuery += " NIV.FILIAL  = REQ.D3_FILIAL  And "
        EndIf
        cQuery += " NIV.COD     = REQ.D3_COD "
        cQuery += " Left Outer Join "+::TableName()+" TSG2 On "
        cQuery += " TSG2.FILPROC = ? And "
        If ::cCusFil == 'E'
            cQuery += " TSG2.FILIAL  = ? And "
        Else
            cQuery += " TSG2.FILIAL  = REQ.D3_FILIAL  And "
        EndIf
        cQuery += " TSG2.PRODREQ = REQ.D3_COD And " //Não deve repetir o par requisição-devolução
        cQuery += " TSG2.PRODDEV = DEV.D3_COD "
        cQuery += " Where "
        cQuery += "     REQ.D3_FILIAL = ? "
        cQuery += " And REQ.D3_CF In (?, ?) "
        cQuery += " And REQ.D3_EMISSAO  >= ? "
        cQuery += " And REQ.D3_EMISSAO  <= ? "
        cQuery += " And REQ.D3_ESTORNO = ? "
        cQuery += " And REQ.D_E_L_E_T_ = ? "
        cQuery += " And REQ.D3_COD <> DEV.D3_COD "
        cQuery += " And TSG2.PRODREQ Is Null "
        cQuery += " Group By "
        If ::cCusFil != 'E'
            cQuery += " REQ.D3_FILIAL,"
        EndIf
        cQuery += " REQ.D3_COD, "
        cQuery += " DEV.D3_COD, "
        cQuery += " NIV.NIVEL, " 
        cQuery += " NIV.NIVINV "

        cQuery := ChangeQuery(cQuery)

        ::oStrQry := FWExecStatement():New(cQuery)
    EndIf

    aBind := {}
    AAdd(aBind, 'DE4') //D3_CF
    AAdd(aBind, 'DE7') //D3_CF
    AAdd(aBind, ' ') //D3_ESTORNO
    AAdd(aBind, ' ') //D_E_L_E_T_
    AAdd(aBind, ::cFProc) //NIV.FILPROC
    If ::cCusFil == 'E'
        AAdd(aBind, PadR(FWCompany(), FWSizeFilial())) //NIV.FILIAL
    EndIf
    AAdd(aBind, ::cFProc) //TSG2.FILPROC
    If ::cCusFil == 'E'
        AAdd(aBind, PadR(FWCompany(), FWSizeFilial())) //TSG2.FILIAL
    EndIf

    AAdd(aBind, FWxFilial("SD3", cFilAtu)) //REQ.D3_FILIAL
    AAdd(aBind, 'RE4') //D3_CF
    AAdd(aBind, 'RE7') //D3_CF
    AAdd(aBind, DToS(dDtIni)) //D3_EMISSAO
    AAdd(aBind, DToS(dDtFim)) //D3_EMISSAO
    AAdd(aBind, ' ') //D3_ESTORNO
    AAdd(aBind, ' ') //REQ.D_E_L_E_T_

    For nI := 1 To Len(aBind)
        ::oStrQry:SetString(nI, aBind[nI])
    Next nI

    cQuery := ::oStrQry:GetFixQuery()

    //Montagem da query com CTE (Commom Table Expression)
    cQuery := ::FormatCTE(cCampos, cQuery)

    FWFreeArray(aBind)
Return cQuery


/*/{Protheus.doc} NotStrQuery
    Prepara a query dos outros produtos que não tem componentes na estrutura
    @author Squad Entradas
    @since 19/09/2024
    /*/
Method NotStrQuery(cFilAtu) Class ProductGroupingTable
    Local cQuery  := ""
    Local cCampos := ""
    Local aCampos := {}
    Local aBind   := {}
    Local nI      := 0

    cCampos   := " "
    aCampos   := ::TableFields()
    For nI := 1 To Len(aCampos)
        cCampos += aCampos[nI, 1]
        If nI != Len(aCampos)
            cCampos += ", "
        EndIf
    Next nI

    If ::oNonStrQry == Nil
        cQuery := " Select "
        If ::lPostgres
            cQuery += " Char("+cValToChar(FWSizeFilial())+") "
        EndIf
        cQuery += " '"+::cFProc+"' FILPROC, "
        If ::cCusFil == 'E'
            If ::lPostgres
                cQuery += " Char("+cValToChar(FWSizeFilial())+") "
            EndIf
            cQuery += " '"+PadR(FWCompany(), FWSizeFilial())+"' FILIAL, "
        Else
            cQuery += " TSG2A.FILIAL FILIAL,"
        EndIf
        cQuery += " TSG2A.PRODDEV PRODREQ, "
        If ::lPostgres
            cQuery += " Char("+cValToChar(Len(SB1->B1_COD))+") "
        EndIf
        cQuery += " '"+Space(Len(SB1->B1_COD))+"' PRODDEV, "
        cQuery += " NIV.NIVEL, "
        cQuery += " NIV.NIVINV, "
        cQuery += " 0 GRUPO "
        cQuery += " From "+::TableName()+" TSG2A "
        cQuery += " Inner Join "+ProductStructLevelTable():TableName()+" NIV "
        cQuery += " On "
        cQuery += " NIV.FILPROC = TSG2A.FILPROC And "
        cQuery += " NIV.FILIAL  = TSG2A.FILIAL And "
        cQuery += " NIV.COD     = TSG2A.PRODDEV "
        cQuery += " Left Outer Join "+::TableName()+" TSG2 On "
        cQuery += " TSG2.FILPROC = TSG2A.FILPROC And "
        cQuery += " TSG2.FILIAL  = TSG2A.FILIAL  And "
        cQuery += " TSG2.PRODREQ = TSG2A.PRODDEV  "
        cQuery += " Where "
        cQuery += " TSG2A.FILPROC = ? And "
        cQuery += " TSG2A.FILIAL  = ? And "
        cQuery += " TSG2.PRODREQ Is Null "
        cQuery += " Group By "
        cQuery += " TSG2A.FILPROC, TSG2A.FILIAL, TSG2A.PRODDEV, NIV.NIVEL, NIV.NIVINV "

        cQuery := ChangeQuery(cQuery)

        ::oNonStrQry := FWExecStatement():New(cQuery)
    EndIf

    AAdd(aBind, ::cFProc)
    AAdd(aBind, cFilAtu)

    For nI := 1 To Len(aBind)
        ::oNonStrQry:SetString(nI, aBind[nI])
    Next nI

    cQuery := ::oNonStrQry:GetFixQuery()

    cQuery := ::FormatCTE(cCampos, cQuery)

    FWFreeArray(aBind)
Return cQuery

/*/{Protheus.doc} InsertSQL
    Faz a inserção dos dados
    @author Squad Entradas
    @since 03/12/2024
    @cFProc - Filial onde iniciou a execução
    @dDtIni - Data inicial de processamento
    @dDtFim - Data final de processamento
/*/
Method insertSQL() Class ProductGroupingTable
    Local nFil       := 0

    For nFil := 1 To Len(::aFilProc)
        cQuery := ::StructQuery(::aFilProc[nFil, 1])
        ::RunQuery(cQuery)

        cQuery := ::NotStrQuery(::aFilProc[nFil, 1])
        ::RunQuery(cQuery)

        If ::cCusFil != 'E'
            ::CalcGrupo(::aFilProc[nFil, 1])
            ::UpdLevelTable(::aFilProc[nFil, 1])
        EndIf
    Next nFil
    If ::cCusFil == 'E'
        ::CalcGrupo(::aFilProc[1, 2])
        ::UpdLevelTable(::aFilProc[1, 1])
    EndIf
Return

/*/{Protheus.doc} CalcGrupo
    Método responsável pelo agrupamento dos produtos
    @author Squad Entradas
    @since 03/12/2024
    /*/

Method CalcGrupo(cFilAtu As Character) Class ProductGroupingTable
    Local lRet     As Logical
    Local cQuery   As Character
    Local nBind    As Integer
    Local nGrupo   AS Integer
    Local nCount   As Integer

    lRet := .T.

    If ::oQrtLeft == Nil
        cQuery := " Select "
        cQuery += " Count(GRP.GRUPO) CNT "
        cQuery += " From "+::TableName()+" GRP "
        cQuery += " Where "
        cQuery += " GRP.FILPROC = ? And "
        cQuery += " GRP.FILIAL  = ? And "
        cQuery += " GRP.GRUPO   = ? "
        cQuery := ChangeQuery(cQuery)

        ::oQrtLeft := FWExecStatement():New(cQuery)
    EndIf

    If ::oQryLast == Nil
        cQuery := " Select "
        cQuery += " Max(GRP.GRUPO) GRUPO "
        cQuery += " From "+::TableName()+" GRP "
        cQuery += " Where "
        cQuery += " GRP.FILPROC = ? And "
        cQuery += " GRP.FILIAL  = ? "
        cQuery := ChangeQuery(cQuery)

        ::oQryLast := FWExecStatement():New(cQuery)
    EndIf

    If ::oAtuQry == Nil
        cQuery := " Select "
        cQuery += " GRP.R_E_C_N_O_ REC "
        cQuery += " From "+::TableName()+" GRP "
        cQuery += " Where "
        cQuery += " GRP.FILPROC = ? And "
        cQuery += " GRP.FILIAL  = ? And "
        cQuery += " GRP.PRODREQ In  "
        cQuery += " ("
        cQuery += " Select SUB.PRODREQ PROD"
        cQuery += " From "+::TableName()+" SUB "
        cQuery += " Where "
        cQuery += " SUB.FILPROC = ? And "
        cQuery += " SUB.FILIAL  = ? And "
        cQuery += " SUB.GRUPO   = ? "
        cQuery += " )"
        cQuery := ChangeQuery(cQuery)

        ::oAtuQry := FWExecStatement():New(cQuery)
    EndIf

    If ::oQryFirst == Nil
        cQuery := " Select "
        If ::lMSSQL
            cQuery += " Top 1 "
        EndIf
        cQuery += " GRP.R_E_C_N_O_ REC "
        cQuery += " From "+::TableName()+" GRP "
        cQuery += " Where "
        cQuery += " GRP.FILPROC = ? And "
        cQuery += " GRP.FILIAL  = ? And "
        cQuery += " GRP.GRUPO   = ? "
        If ::lOracle
            cQuery += " And ROWNUM = 1 "
        EndIf
        If ::lPostgres
            cQuery += " Limit 1 "
        EndIf
        cQuery := ChangeQuery(cQuery)

        ::oQryFirst := FWExecStatement():New(cQuery)
    EndIf

    If ::oPaiQry == Nil
        cQuery := " Select "
        cQuery += " GRP.R_E_C_N_O_ REC "
        cQuery += " From "+::TableName()+" GRP "
        cQuery += " Where "
        cQuery += " GRP.FILPROC = ? And "
        cQuery += " GRP.FILIAL  = ? And "
        cQuery += " GRP.PRODREQ In  "
        cQuery += " ("
        cQuery += " Select PAI.PRODREQ PROD"
        cQuery += " From "+::TableName()+" PAI "
        cQuery += " Inner Join "+::TableName()+" FILHO "
        cQuery += " On "
        cQuery += " FILHO.FILPROC = PAI.FILPROC And "
        cQuery += " FILHO.FILIAL  = PAI.FILIAL  And "
        cQuery += " FILHO.PRODREQ = PAI.PRODDEV And "
        cQuery += " FILHO.NIVEL   = PAI.NIVEL "
        cQuery += " Where "
        cQuery += " PAI.FILPROC = ? And "
        cQuery += " PAI.FILIAL  = ? And "
        cQuery += " FILHO.GRUPO = ? "
        cQuery += " )"
        cQuery := ChangeQuery(cQuery)

        ::oPaiQry := FWExecStatement():New(cQuery)
    EndIf
    
    If ::oFilQry == Nil
        cQuery := " Select "
        cQuery += " GRP.R_E_C_N_O_ REC "
        cQuery += " From "+::TableName()+" GRP "
        cQuery += " Where "
        cQuery += " GRP.FILPROC = ? And "
        cQuery += " GRP.FILIAL  = ? And "
        cQuery += " GRP.PRODREQ In  "
        cQuery += " ("
        cQuery += " Select FILHO.PRODREQ PROD"
        cQuery += " From "+::TableName()+" PAI "
        cQuery += " Inner Join "+::TableName()+" FILHO "
        cQuery += " On "
        cQuery += " FILHO.FILPROC = PAI.FILPROC And "
        cQuery += " FILHO.FILIAL  = PAI.FILIAL  And "
        cQuery += " FILHO.PRODREQ = PAI.PRODDEV And "
        cQuery += " FILHO.NIVEL   = PAI.NIVEL    "
        cQuery += " Where "
        cQuery += " PAI.FILPROC = ? And "
        cQuery += " PAI.FILIAL  = ? And "
        cQuery += " PAI.GRUPO   = ? "
        cQuery += " )"
        cQuery := ChangeQuery(cQuery)

        ::oFilQry := FWExecStatement():New(cQuery)
    EndIf

    nBind := 1
    ::oQrtLeft:SetString(nBind++, ::cFProc) //GRP.FILPROC
    ::oQrtLeft:SetString(nBind++, cFilAtu) //GRP.FILIAL
    ::oQrtLeft:SetNumeric(nBind++, 0) //GRP.GRUPO

    //Último grupo incluso
    nBind := 1
    ::oQryLast:SetString(nBind++, ::cFProc) //GRP.FILPROC
    ::oQryLast:SetString(nBind++, cFilAtu) //GRP.FILIAL
    nGrupo := ::oQryLast:ExecScalar('GRUPO')

    //Enquanto há produtos sem atribuição em grupo
    While ::oQrtLeft:ExecScalar('CNT') > 0
        //Próximo grupo
        nGrupo++

        //Seleciona o primeiro produto sem grupo e atribui a ele
        nBind := 1
        ::oQryFirst:SetString(nBind++, ::cFProc) //GRP.FILPROC
        ::oQryFirst:SetString(nBind++, cFilAtu) //GRP.FILIAL
        ::oQryFirst:SetNumeric(nBind++, 0) //GRP.GRUPO

        cQuery := ::oQryFirst:GetFixQuery()
        ::UpdGrupo(cQuery, nGrupo)

        //Checa quantos estão no grupo
        nBind := 1
        ::oQrtLeft:SetString(nBind++, ::cFProc) //GRP.FILPROC
        ::oQrtLeft:SetString(nBind++, cFilAtu) //GRP.FILIAL
        ::oQrtLeft:SetNumeric(nBind++, nGrupo) //GRP.GRUPO

        nCount := ::oQrtLeft:ExecScalar('CNT')
        While .T.
            //Seta todos os produtos que se repetem na tabela, baseado
            //nos produtos existentes no grupo
            nBind := 1
            ::oAtuQry:SetString(nBind++, ::cFProc) //GRP.FILPROC
            ::oAtuQry:SetString(nBind++, cFilAtu) //GRP.FILIAL
            ::oAtuQry:SetString(nBind++, ::cFProc) //SUB.FILPROC
            ::oAtuQry:SetString(nBind++, cFilAtu) //SUB.FILIAL
            ::oAtuQry:SetNumeric(nBind++, nGrupo) //SUB.GRUPO

            cQuery := ::oAtuQry:GetFixQuery()
            ::UpdGrupo(cQuery, nGrupo)

            //Seta todos os produtos pai no mesmo grupo atual
            nBind := 1
            ::oPaiQry:SetString(nBind++, ::cFProc) //GRP.FILPROC
            ::oPaiQry:SetString(nBind++, cFilAtu) //GRP.FILIAL
            ::oPaiQry:SetString(nBind++, ::cFProc) //PAI.FILPROC
            ::oPaiQry:SetString(nBind++, cFilAtu) //PAI.FILIAL
            ::oPaiQry:SetNumeric(nBind++, nGrupo) //FILHO.GRUPO

            cQuery := ::oPaiQry:GetFixQuery()
            ::UpdGrupo(cQuery, nGrupo)

            //Seta todos os produtos filhos no mesmo grupo atual
            nBind := 1
            ::oFilQry:SetString(nBind++, ::cFProc) //GRP.FILPROC
            ::oFilQry:SetString(nBind++, cFilAtu) //GRP.FILIAL
            ::oFilQry:SetString(nBind++, ::cFProc) //PAI.FILPROC
            ::oFilQry:SetString(nBind++, cFilAtu) //PAI.FILIAL
            ::oFilQry:SetNumeric(nBind++, nGrupo) //PAI.GRUPO

            cQuery := ::oFilQry:GetFixQuery()
            ::UpdGrupo(cQuery, nGrupo)
            
            //Verifica se houve variação no número de membros do grupo
            nCount2 := ::oQrtLeft:ExecScalar('CNT')
            If nCount != nCount2
                nCount := nCount2
                Loop //Houve membros novos, repete a operação
            Else
                Exit //Não há membros novos, passa para o próximo produto sem grupo
            EndIf
        EndDo

        //Restaura os parâmetros da query para o while
        nBind := 1
        ::oQrtLeft:SetString(nBind++, ::cFProc) //GRP.FILPROC
        ::oQrtLeft:SetString(nBind++, cFilAtu) //GRP.FILIAL
        ::oQrtLeft:SetNumeric(nBind++, 0) //GRP.GRUPO
    EndDo

Return lRet

/*/{Protheus.doc} UpdGrupo
    Atualiza o grupo de um ou mais produtos, dependendo da 
    query informada. A query deve conter o recno renomeado para REC
    @author Squad Entradas
    @since 04/12/2024
    /*/
Method UpdGrupo(cQuery As Character, nGrupo As Integer) Class ProductGroupingTable
    Local cCTE    As Character
    Local cUpdate As Character

    If !::lOracle
        cCTE := " With TEMPTABLE As "
    Else
        cCTE := " Merge Into "+::TableName()+" Using "
    EndIf

    cQuery := " ( "+cQuery+" ) "

    If ::lOracle
        cQuery += " TEMPTABLE "
        cQuery += " On ("
        cQuery += " "+::TableName()+".R_E_C_N_O_ = TEMPTABLE.REC"
        cQuery += " ) "
        cQuery += " When Matched Then "
    EndIf

    If !::lOracle
        cUpdate := " Update "+::TableName()+" "
    Else
        cUpdate := " Update "
    EndIf
    cUpdate += "    Set "
    cUpdate += " GRUPO  = '"+cValToChar(nGrupo)+"' "

    If !::lOracle
        cUpdate += " From TEMPTABLE "
    EndIf
    cUpdate += " Where "
    cUpdate += " "+::TableName()+".R_E_C_N_O_ = TEMPTABLE.REC"

    ::RunQuery(cCTE+cQuery+cUpdate)

Return 

/*/{Protheus.doc} UpdLevelTable
    Atualiza a tabela de níveis com os grupos calculados
    @author Squad Entradas
    @since 04/12/2024
    /*/
Method UpdLevelTable(cFilAtu As Character) Class ProductGroupingTable
    Local cCTE      As Character
    Local cUpdate   As Character
    Local cQuery    As Character
    Local cTabNivel As Character

    cTabNivel := ProductStructLevelTable():TableName()

    If !::lOracle
        cCTE := " With TEMPTABLE As "
    Else
        cCTE := " Merge Into "+cTabNivel+" Using "
    EndIf

    If ::oQryLevel == Nil
        cQuery := " Select "
        cQuery += " GRP.GRUPO   GRUPO, "
        cQuery += " GRP.FILPROC FILPROC, "
        cQuery += " GRP.FILIAL  FILIAL, "
        cQuery += " GRP.PRODREQ COD, "
        cQuery += " GRP.NIVINV  NIVINV "
        cQuery += " From "+::TableName()+" GRP "
        cQuery += " Where "
        cQuery += " GRP.FILPROC = ? And "
        cQuery += " GRP.FILIAL  = ? "
        cQuery += " Group By "
        cQuery += " GRP.FILPROC, GRP.FILIAL, GRP.NIVINV, GRP.GRUPO, GRP.PRODREQ "
        cQuery := ChangeQuery(cQuery)

        ::oQryLevel := FWExecStatement():New(cQuery)
    EndIf

    ::oQryLevel:SetString(1, ::cFProc)
    ::oQryLevel:SetString(2, cFilAtu)

    cQuery := ::oQryLevel:GetFixQuery()

    cQuery := " ( "+cQuery+" ) "

    If ::lOracle
        cQuery += " TEMPTABLE "
        cQuery += " On ("
        cQuery += " "+cTabNivel+".FILPROC = TEMPTABLE.FILPROC And "
        cQuery += " "+cTabNivel+".FILIAL  = TEMPTABLE.FILIAL  And "
        cQuery += " "+cTabNivel+".COD     = TEMPTABLE.COD     And "
        cQuery += " "+cTabNivel+".NIVINV  = TEMPTABLE.NIVINV      "
        cQuery += " ) "
        cQuery += " When Matched Then "
    EndIf

    If !::lOracle
        cUpdate := " Update "+cTabNivel+" "
    Else
        cUpdate := " Update "
    EndIf
    cUpdate += "    Set "
    cUpdate += " GRUPO  = TEMPTABLE.GRUPO "

    If !::lOracle
        cUpdate += " From TEMPTABLE "
    EndIf
    cUpdate += " Where "
    cUpdate += " "+cTabNivel+".FILPROC = TEMPTABLE.FILPROC And "
    cUpdate += " "+cTabNivel+".FILIAL  = TEMPTABLE.FILIAL  And "
    cUpdate += " "+cTabNivel+".COD     = TEMPTABLE.COD     And "
    cUpdate += " "+cTabNivel+".NIVINV  = TEMPTABLE.NIVINV      "

    ::RunQuery(cCTE+cQuery+cUpdate)

Return 
