#include "msobject.ch"
#include "protheus.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "backoffice.sv.est.acquisitioncost.ch"
#include "totvs.framework.treports.integratedprovider.th"

#DEFINE SX1GRUPO 'ESTT043'

namespace totvs.protheus.backoffice.est.acquisitioncost.integratedprovider

using namespace totvs.framework.treports.integratedprovider
using namespace totvs.protheus.backoffice.stock.iterativecost.view.manager
using namespace totvs.protheus.backoffice.stock.iterativecost.view.acquisitioncost
using namespace totvs.protheus.backoffice.stock.iterativecost.view.fullinitialstockbalance

@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGAEST", tables="SB1,SB2,SB9,SF1,SD1", name="Custo de Entrada", country="ALL")

//-------------------------------------------------------------------
/*{Protheus.doc} AcquisitioncostSmartViewBusinessObject
Classe para criação do Objeto de Negócio do Custo de Entrada
 
@author BackOffice
@since 04/2023
@version 1.0
*/
//-------------------------------------------------------------------  
Class AcquisitioncostSmartViewBusinessObject From totvs.protheus.backoffice.est.smartView.integratedProvider.EstIntegratedProvider

	Public Method new()				as object
	Public Method getData()			as object

	Protected Method oNGetSchema()
	Protected data jItems		  as json
	Protected data cWhere		  as character
	Protected data aFields		  as array
	Protected data lExistPergunte as logical
	Protected data cNameViewSB9	  as character
	Protected data cNameViewSD1	  as character

EndClass
 
//-------------------------------------------------------------------
/*{Protheus.doc} new
Método de instância da classe
 
@return object: self
 
@author BackOffice
@since 04/2023
@version 1.0
*/
//-------------------------------------------------------------------   
Method new() Class AcquisitioncostSmartViewBusinessObject

	Local lExecute	as logical

	_Super:new()

	//Define a Área
	self:appendArea(STR0001) //"Estoque/Custos"

	//Define o nome do Objeto de Negócio
	self:setDisplayName(STR0002) //"Pré-Conferência do Custo em Partes"
 
	//Define a descrição do Objeto de Negócio
	self:setDescription(STR0003) //"Emite uma relação dos vínculos que serão criados na efetivação do Wizard do Custo em Partes."

	//Indica o pergunte que será utilizado no relatório
	lExecute  := FnVldCMod2()
    self:lExistPergunte := (self:setPergunte( SX1GRUPO ) .And. lExecute)
	If !self:lExistPergunte
		self:setErrorStatus(400,STR0004,i18n(STR0005,{SX1GRUPO}))//O Grupo de perguntas #1 não existe
		FWLogMsg('WARN', , 'SmartView', , , , i18n(STR0007,{SX1GRUPO}), , , )//O Grupo de perguntas #1 não existe
	EndIf
    
	//Indica que o LookUp será do tipo padrão LookUp
    self:setIsLookUp(.T.)

Return self

//-------------------------------------------------------------------
/*{Protheus.doc} getData
Retorna os dados do objeto de negócio
 
@param nPage, numérico, indica a página atual do relatório
@param oFilter, objeto, contém o filtro do TReports
 
@return object: self:oData
 
@author BackOffice
@since 04/2023
@version 1.0
*/
//-------------------------------------------------------------------   
Method getData( nPage as Numeric, oFilter as object) as object Class AcquisitioncostSmartViewBusinessObject

	Local oQuery				as object
    Local oViewFullInitBalance	as object
    Local oViewAcquisCost		as object
	Local oViews				as object

	Local cQuery				as character
	Local cFieldsB9				as character
	Local cFieldsD1				as character
	Local cAliasTmp				as character
	Local cMoedaD1				as character
	Local nX					as numeric
	Local nFil					as numeric
	Local nQtdSB9				as numeric
	Local aTotaisPrd			as array
	Local jParams				as json

	Local dDataDe				as date
	Local dDataAte				as date

	Local dDataDeT				as date
	Local dDataAteT				as date

	//Valida o pergunte
	If !self:lExistPergunte	
		return self:oData
	Endif

	//Metodo para retorno do json dos parâmetros
    jParams := oFilter:getParameters()

    //Retorno da tela de multi filiais com as filiais selecionadas ou somente a filial corrente
    self:aFils := self:retFils(jParams['SV_MULTBRANCH'], oFilter)

	dDataDe := FwDateTimeToLocal( jParams['MV_PAR01'][1] )[1]
	dDataAte := FwDateTimeToLocal( jParams['MV_PAR02'][1] )[1]

	dDataDeT := ctod('  /  /    ')
	dDataAteT := date()

	If jParams['MV_PAR11'][1] == 1
		cMoedaD1 := ''
	Else
		cMoedaD1 := AllTrim(Str(jParams['MV_PAR11'][1]))
	EndIf

	If jParams['MV_PAR13'][1] == 1
		nQtdSB9 := -1
	Else
		nQtdSB9 := 0
	EndIf

	oViews := ViewManager():New(self:aFils)
	oViews:Install()

    oViewFullInitBalance := ViewFullInitialStockBalance():New(self:aFils)
    oViewAcquisCost  := ViewAcquisitionCost():New(self:aFils)

	self:cNameViewSB9:= "VW_" + oViewFullInitBalance:GetViewID() + "_" + cEmpAnt
    self:cNameViewSD1:= "VW_" + oViewAcquisCost:GetViewID() + "_" + cEmpAnt

	// Instala views
    If TCIsView(self:cNameViewSB9) .And. TCIsView(self:cNameViewSD1)
		//Query View SB9
		cFieldsB9 := 'B9_FILIAL FILIAL, '
		cFieldsB9 += 'B9_COD PRODUTO, '
		cFieldsB9 += 'B1_DESC DESCRICAO, '
		cFieldsB9 += 'B9_LOCAL LOCAL, '
		cFieldsB9 += 'B9_DATA DATA, '
		cFieldsB9 += "'" + STR0007 + "' DOCUMENTO, " //"Saldo Inicial"
		cFieldsB9 += "' ' FORNECEDOR, "
		cFieldsB9 += 'B9_QINI QUANTIDADE, '
		cFieldsB9 += 'CASE WHEN B9_QINI > 0 AND B9_CM'+AllTrim(Str(jParams['MV_PAR11'][1])) + ' > 0 '
		cFieldsB9 +=      'THEN (B9_VINI'+AllTrim(Str(jParams['MV_PAR11'][1]))+' / B9_QINI) '
		cFieldsB9 +=      'ELSE 0 '
		cFieldsB9 += 'END VLRUNITNF, '
		cFieldsB9 += 'B9_CM'+AllTrim(Str(jParams['MV_PAR11'][1]))+' CUSTOUNMED, '
		cFieldsB9 += '(B9_CM'+AllTrim(Str(jParams['MV_PAR11'][1]))+' * B9_QINI) CUSTOTOTAL '

		cQuery := "SELECT ? "
		cQuery += " FROM " + self:cNameViewSB9 + " SB9 "
		cQuery += " INNER JOIN "+self:cNameViewSD1+" SD1 "
		cQuery += " ON SD1.D1_FILIAL = SB9.B9_FILIAL"
		cQuery += " AND SD1.D1_COD  = SB9.B9_COD"
		cQuery += " AND SD1.D1_DTDIGIT >= ? AND SD1.D1_DTDIGIT <= ?"
		cQuery += " INNER JOIN "+RetSQLName('SB1')+" SB1 "
		cQuery += " ON SB1.B1_FILIAL = ?"
		cQuery += " AND SB1.B1_COD  = SB9.B9_COD"
		cQuery += " AND SB1.D_E_L_E_T_ = ?"
		cQuery += " WHERE SB9.B9_FILIAL = ?"
		cQuery += " AND SB9.B9_COD >= ? AND SB9.B9_COD <= ?"
		cQuery += " AND SB9.B9_LOCAL >= ? AND SB9.B9_LOCAL <= ?"
		cQuery += " AND SB1.B1_TIPO >= ? AND SB1.B1_TIPO <= ?"
		cQuery += " AND	SB1.B1_GRUPO >= ? AND SB1.B1_GRUPO <= ?"
		cQuery += " AND	SB9.B9_QINI > ? "
		cQuery += " AND	(SB9.B9_DATA = ? "
		cQuery += "      OR (SB9.B9_DATA >= ? "
		cQuery += "      AND SB9.B9_DATA <= ? ))"

		cQuery += " UNION "

		//Query View SD1
		cFieldsD1 := 'D1_FILIAL FILIAL, '
		cFieldsD1 += 'D1_COD PRODUTO, '
		cFieldsD1 += 'B1_DESC DESCRICAO, '
		cFieldsD1 += 'D1_LOCAL LOCAL, '
		cFieldsD1 += 'D1_DTDIGIT DATA, '
		cFieldsD1 += "CONCAT(COALESCE(D1_DOC, ''), COALESCE(D1_SERIE, '')) DOCUMENTO, "
		cFieldsD1 += "D1_FORNECE FORNECEDOR, "
		cFieldsD1 += 'D1_QUANT QUANTIDADE, '
		cFieldsD1 += 'D1_VUNIT VLRUNITNF, '
		cFieldsD1 += 'CASE WHEN D1_QUANT > 0 '
		cFieldsD1 +=      'THEN (D1_CUSTO'+cMoedaD1+' / D1_QUANT) '
		cFieldsD1 +=      'ELSE 0 '
		cFieldsD1 += 'END CUSTOUNMED, '
		cFieldsD1 += 'D1_CUSTO'+cMoedaD1+' CUSTOTOTAL '

		cQuery += " SELECT ?"
		cQuery += " FROM " + self:cNameViewSD1 + " SD1 "
		cQuery += " INNER JOIN "+RetSQLName('SB1')+" SB1 "
		cQuery += " ON SB1.B1_FILIAL = ?"
		cQuery += " AND SB1.B1_COD  = SD1.D1_COD"
		cQuery += " AND SB1.D_E_L_E_T_ = ?"
		cQuery += " WHERE SD1.D1_FILIAL = ?"
		cQuery += " AND SD1.D1_COD >= ? AND SD1.D1_COD <= ?"
		cQuery += " AND SD1.D1_LOCAL >= ? AND SD1.D1_LOCAL <= ?"
		cQuery += " AND SD1.D1_DTDIGIT >= ? AND SD1.D1_DTDIGIT <= ?"
		cQuery += " AND SB1.B1_TIPO >= ? AND SB1.B1_TIPO <= ?"
		cQuery += " AND	SB1.B1_GRUPO >= ? AND SB1.B1_GRUPO <= ?"

		cQuery += " ORDER BY 2,3,5,6"

		cQuery := ChangeQuery(cQuery)

		//Montagem da query para execução
		oQuery := FwExecStatement():New(cQuery)

		cBkpFil := cFilAnt

		For nFil :=1 to len(self:aFils)
			cFilAnt := self:aFils[nFil]

			aTotaisPrd := {}

			//Binding
			oQuery:SetUnsafe(1, cFieldsB9)
			oQuery:SetString(2, Dtos(dDataDeT))
			oQuery:SetString(3, Dtos(dDataAteT))
			oQuery:SetString(4, FWxFilial("SB1"))
			oQuery:SetString(5, ' ')
			oQuery:SetString(6, FWxFilial("SB9"))
			oQuery:SetString(7, jParams['MV_PAR03'][1])
			oQuery:SetString(8, jParams['MV_PAR04'][1])
			oQuery:SetString(9, jParams['MV_PAR09'][1])
			oQuery:SetString(10, jParams['MV_PAR10'][1])
			oQuery:SetString(11, jParams['MV_PAR05'][1])
			oQuery:SetString(12, jParams['MV_PAR06'][1])
			oQuery:SetString(13, jParams['MV_PAR07'][1])
			oQuery:SetString(14, jParams['MV_PAR08'][1])
			oQuery:SetNumeric(15, nQtdSB9)
			oQuery:SetString(16, ' ')
			oQuery:SetString(17, Dtos(dDataDe))
			oQuery:SetString(18, Dtos(dDataAte))
			oQuery:SetUnsafe(19, cFieldsD1)
			oQuery:SetString(20, FWxFilial("SB1"))
			oQuery:SetString(21, ' ')
			oQuery:SetString(22, FWxFilial("SD1"))
			oQuery:SetString(23, jParams['MV_PAR03'][1])
			oQuery:SetString(24, jParams['MV_PAR04'][1])
			oQuery:SetString(25, jParams['MV_PAR09'][1])
			oQuery:SetString(26, jParams['MV_PAR10'][1])
			oQuery:SetString(27, Dtos(dDataDe))
			oQuery:SetString(28, Dtos(dDataAte))
			oQuery:SetString(29, jParams['MV_PAR05'][1])
			oQuery:SetString(30, jParams['MV_PAR06'][1])
			oQuery:SetString(31, jParams['MV_PAR07'][1])
			oQuery:SetString(32, jParams['MV_PAR08'][1])

			cAliasTmp := oQuery:OpenAlias()

			(cAliasTmp)->(dbGoTop())
			While !(cAliasTmp)->(Eof())
				//Totaliza valores do produto criando uma nova linha no json
				If Len(aTotaisPrd) > 0 .And. cProdAnt <> (cAliasTmp)->&(self:aFields[02])
					self:jItems		:= JsonObject():New()
					For nX := 1 To Len(self:aFields)
						self:jItems[self:aFields[nX]] := aTotaisPrd[Len(aTotaisPrd)][nX]
					Next nX

					self:processData()
					self:oData:appendData(self:jItems)

					aTotaisPrd := {}
				EndIf

				If jParams['MV_PAR12'][1] == 1	//Apenas para listagem analitica
					self:jItems		:= JsonObject():New()
					For nX := 1 To Len(self:aFields)
						if self:aFields[nX] == "DATA" //Campo tipo data tem um tratamento diferente para envio
							If !Empty( (cAliasTmp)->&(self:aFields[nX]) )
								self:jItems[self:aFields[nX]] := totvs.framework.treports.date.dateToTimeStamp(StoD((cAliasTmp)->&(self:aFields[nX])))	
							EndIf
						Else
							self:jItems[self:aFields[nX]] := (cAliasTmp)->&(self:aFields[nX])
						EndIf
					Next nX

					self:processData()
					self:oData:appendData(self:jItems)
				EndIf

				If Len(aTotaisPrd) == 0
					aAdd(aTotaisPrd, {(cAliasTmp)->&(self:aFields[01]),;
									(cAliasTmp)->&(self:aFields[02]),;
									(cAliasTmp)->&(self:aFields[03]),;
									totvs.framework.treports.date.dateToTimeStamp(StoD('')),;
									STR0008,;	//"Total do Produto"
									'',;
									'',;
									(cAliasTmp)->&(self:aFields[08]),;
									0,;
									(cAliasTmp)->&(self:aFields[10]),;
									(cAliasTmp)->&(self:aFields[11])})
				Else
									aTotaisPrd[Len(aTotaisPrd)][08] += (cAliasTmp)->&(self:aFields[08])
									aTotaisPrd[Len(aTotaisPrd)][11] += (cAliasTmp)->&(self:aFields[11])
									aTotaisPrd[Len(aTotaisPrd)][10] := (aTotaisPrd[Len(aTotaisPrd)][11] / aTotaisPrd[Len(aTotaisPrd)][08])
				EndIf

				cProdAnt := (cAliasTmp)->&(self:aFields[02])

				(cAliasTmp)->(DBSkip())
			EndDo

			//Totaliza valores do produto criando uma nova linha no json
			If Len(aTotaisPrd) > 0
				self:jItems		:= JsonObject():New()
				For nX := 1 To Len(self:aFields)
					self:jItems[self:aFields[nX]] := aTotaisPrd[Len(aTotaisPrd)][nX]
				Next nX

				self:processData()
				self:oData:appendData(self:jItems)
			EndIf

			(cAliasTmp)->( DBCloseArea() )
		Next

		cFilAnt := cBkpFil

		oQuery:Destroy()

		fwFreeArray(aTotaisPrd)
	EndIf

return self:oData

//-------------------------------------------------------------------
/*{Protheus.doc} getSchema
Retorna a estrutura dos campos
 
@return object: self:oSchema
 
@author BackOffice
@since 04/2023
@version 1.0
*/
//-------------------------------------------------------------------   
Method oNGetSchema() Class AcquisitioncostSmartViewBusinessObject

	self:aFields := {"FILIAL", "PRODUTO", "DESCRICAO", "DATA", "DOCUMENTO", "FORNECEDOR",;
					 "LOCAL", "QUANTIDADE", "VLRUNITNF", "CUSTOUNMED", "CUSTOTOTAL"}

	self:addProperty( "FILIAL"		, STR0009, "string", STR0009, "FILIAL")		//"Filial"
	self:addProperty( "PRODUTO"		, STR0010, "string", STR0010, "PRODUTO")	//"Produto"
	self:addProperty( "DESCRICAO"	, STR0011, "string", STR0011, "DESCRICAO")	//"Descrição"
	self:addProperty( "DATA"		, STR0012, "date"  , STR0012, "DATA")		//"Data"
	self:addProperty( "DOCUMENTO"	, STR0013, "string", STR0013, "DOCUMENTO")	//"Documento"
	self:addProperty( "FORNECEDOR"	, STR0014, "string", STR0014, "FORNECEDOR")	//"Fornecedor"
	self:addProperty( "LOCAL"		, STR0015, "string", STR0015, "LOCAL")		//"Local"
	self:addProperty( "QUANTIDADE"	, STR0016, "number", STR0016, "QUANTIDADE")	//"Quantidade"
	self:addProperty( "VLRUNITNF"	, STR0017, "number", STR0017, "VLRUNITNF")	//"Valor Unitário"
	self:addProperty( "CUSTOUNMED"	, STR0018, "number", STR0018, "CUSTOUNMED")	//"Custo Unitário Médio"
	self:addProperty( "CUSTOTOTAL"	, STR0019, "number", STR0019, "CUSTOTOTAL")	//"Custo Total"

Return
