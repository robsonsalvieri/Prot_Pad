    /*/
Method GetViewID() Class ViewAcquisitionCost
Return "VWSD1CT"

/*/{Protheus.doc} GetParams
    Retorna Json contendo os codeblock executáveis para obter os parâmetros da View
    @author g.moreira
    @since 22/07/2024
    @type method
    /*/
Method GetParams() Class ViewAcquisitionCost
    Local jExec := JsonObject():New() As Json

    jExec["SF4_EMPRESA"] := {|| FWModeAccess('SF4', 1)}
    jExec["SF4_UNIDADE"] := {|| FWModeAccess('SF4', 2)}
    jExec["SF4_FILIAL"]  := {|| FWModeAccess('SF4', 3)}
    jExec["AFN_EMPRESA"] := {|| FWModeAccess('SF4', 1)}
    jExec["AFN_UNIDADE"] := {|| FWModeAccess('SF4', 2)}
    jExec["AFN_FILIAL"]  := {|| FWModeAccess('SF4', 3)}
    jExec["VW_SB9_NOME"] := {|| Posicione('D4D',1,FWXFilial('D4D')+'VWSB9CT','D4D_VWNAME')}

Return jExec

/*/{Protheus.doc} GetQuery
    Retorna a query estruturada da instalação da View com base nos parâmetros informados
    @author Squad Entradas
    @since 22/07/2024
    @type method
    /*/
Method GetQuery(cEmpAtu As Character, jParam As Json) Class ViewAcquisitionCost
    Local cQuery  As Character
    Local cIDView As Character
    Local cNomFis As Character
    Local cDbType As Character
    Local cVersao As Character

	cIDView := ::GetViewID()
    cNomFis := "VW_"+cIDView+"_"+cEmpAtu
    cDbType := TCGetDB()
    cVersao := ::GetVersion()

    cQuery := " Create View "+cNomFis+" As "
    cQuery += " Select "
    cQuery += " Distinct "
    If cDbType $ 'POSTGRES'
        cQuery += " Char(4) "
    EndIf
    cQuery += "'"+cVersao+"' ASSINATURA, "
    cQuery += " D1_FILIAL, D1_COD, D1_DTDIGIT, D1_LOCAL, D1_FORMUL, D1_ITEMGRD, "
    cQuery += " D1_DOC, D1_SERIE, D1_FORNECE, D1_LOJA, D1_ITEM, D1_NUMSEQ, "
    cQuery += " D1_CUSTO, D1_CUSTO2, D1_CUSTO3, D1_CUSTO4, D1_CUSTO5, "
    cQuery += " D1_QUANT, D1_QTSEGUM, D1_VUNIT, SD1.R_E_C_N_O_ D1RECNO, F4_FILIAL, "
    cQuery += " AFN_FILIAL, AFN_COD "
    cQuery += " From "+RetSQLName('SD1')+" SD1 "
    cQuery += " Inner Join "+RetSQLName('SF4')+" SF4 On "
    If  jParam["SF4_EMPRESA"] == FWModeAccess("SD1", 1) .And. ;
        jParam["SF4_UNIDADE"] == FWModeAccess("SD1", 2) .And. ;
        jParam["SF4_FILIAL"]  == FWModeAccess("SD1", 3)
        cQuery += " F4_FILIAL = D1_FILIAL And "
    EndIf
    cQuery += " F4_CODIGO  = D1_TES And "
    cQuery += " F4_ESTOQUE = 'S' And "
    cQuery += " F4_TRANFIL in (' ', '2') And "
    cQuery += " F4_PODER3 In (' ', 'N') And "
    cQuery += " SF4.D_E_L_E_T_ = ' ' And "
    cQuery += " SD1.D_E_L_E_T_ = ' ' "
    cQuery += " Left Join "+RetSQLName('SD3')+" SD3AFN On "
    cQuery += " SD3AFN.D3_FILIAL  = SD1.D1_FILIAL And "
    cQuery += " SD3AFN.D3_NUMSEQ  = SD1.D1_NUMSEQ And "
    cQuery += " SD3AFN.D3_ESTORNO = ' ' And "
    cQuery += " SD3AFN.D_E_L_E_T_ = ' ' "
    cQuery += " Left Join "+RetSQLName('AFN')+" AFN On "
    cQuery += FwJoinFilial("AFN", "SD1", "AFN", "SD1")+ " And "
    cQuery += " AFN.AFN_PROJET = SD3AFN.D3_PROJPMS And "
    cQuery += " AFN.AFN_TAREFA = SD3AFN.D3_TASKPMS And "
    cQuery += " AFN.AFN_DOC    = SD1.D1_DOC     And "
    cQuery += " AFN.AFN_SERIE  = SD1.D1_SERIE   And "
    cQuery += " AFN.AFN_FORNEC = SD1.D1_FORNECE And "
    cQuery += " AFN.AFN_LOJA   = SD1.D1_LOJA    And "
    cQuery += " AFN.AFN_ITEM   = SD1.D1_ITEM    And "
    cQuery += " AFN.AFN_ESTOQU = '1' And "
    cQuery += " AFN.D_E_L_E_T_ = ' '  "
    cQuery += " Where "
    cQuery += " D1_TIPO In ('N', 'P', 'B', 'I', 'C') And "
    cQuery += " Not (D1_CONHEC <> ' ' And D1_TIPO_NF = '5' And D1_TIPODOC = '10') And "
    cQuery += " Not (D1_ORIGLAN = 'LF') And "
    cQuery += " D1_REMITO = ' ' And " //Independente da localização, ignora os remitos
    cQuery += " D1_TIPODOC < '50' And "
    cQuery += " D1_OP = ' ' "
    cQuery += " And AFN.AFN_COD Is Null "

Return cQuery
