#Include 'Totvs.ch'
#Include 'tlpp-core.th'

using namespace totvs.protheus.backoffice.stock.iterativecost.table.manager
using namespace totvs.protheus.backoffice.stock.iterativecost.table.balancebywarehouse
using namespace totvs.protheus.backoffice.stock.iterativecost.table.processingtable
using namespace totvs.protheus.backoffice.stock.iterativecost.table.analyticalmovementtable
using namespace totvs.protheus.backoffice.stock.iterativecost.update.movement

namespace totvs.protheus.backoffice.stock.iterativecost.processing.averagecostrecalculation

/*/{Protheus.doc} AverageCostRecalculation
    Classe responsável por atualizar o custo médio com o custo da reavaliação (RE3|DE3)
    @type Method
    @author Squad Entradas
    @since 08/12/2025
/*/
Class AverageCostRecalculation From TableManager

    public method New()

    public method adjustAverageCostInMovTable()
    public method adjustAverageCostInProcTable()
    public method updateRevaluationMovement()
    method getWarehousesMissingRevaluation()
    method updateProductAverageCost()

    Data cFilProc                 as character
    Data aMoedas                  as array
    Data cCusFil                  as character
    Data lE330REA                 as logical
    Data oQueryWarehousesMissing  as object
    Data oQueryProductAverageCost as object

endclass

/*/{Protheus.doc} New
    Instância da classe
    @type Method
    @author Squad Entradas
    @since 08/12/2025
/*/
Method new(cFilProc,aMoedas,cCusFil,lE330REA) Class AverageCostRecalculation

    //Inicia as propriedades da classe TableManager para utilizar os seus métodos de query
    _Super:New({})

    ::cFilProc := cFilProc
    ::aMoedas  := aMoedas
    ::cCusFil  := cCusFil
    ::lE330REA := lE330REA

Return

/*/{Protheus.doc} adjustAverageCostInMovTable
    Atualiza o movimento de reavaliação na tabela de movimentação
    @type Method
    @author Squad Entradas
    @since 08/12/2025
/*/
Method adjustAverageCostInMovTable() Class AverageCostRecalculation
    local oQuery        as object
    local cQuery        as character
    local cFieldsUpd    as character
    local cMatchFilter  as character
    local cCteStatement as character
    local cTableProc    := ProcessingTable():TableName() as character
    local cTableTRK     := BalanceByWarehouse():TableName() as character
    local cTableMov     := AnalyticalMovementTable():TableName() as character
    local nX            as integer
    Local nY            as integer

    // Filtro do update
    cMatchFilter := cTableMov+".FILPROC = TEMPTABLE.FILPROC AND "
    cMatchFilter += cTableMov+".FILIAL  = TEMPTABLE.FILIAL AND "
    cMatchFilter += cTableMov+".COD     = TEMPTABLE.COD AND "
    cMatchFilter += cTableMov+".LOCARM  = TEMPTABLE.LOCARM AND "
    cMatchFilter += cTableMov+".MOEDA   = TEMPTABLE.MOEDA "

    For nX := 1 to Len(::aMoedas)
        nY := 1
        // Campos que serão atualizados no Update
        cFieldsUpd := " CF  = CASE WHEN TEMPTABLE.CUSTO > 0 THEN 'DEA' ELSE 'REA' END, "
        cFieldsUpd += " TM  = CASE WHEN TEMPTABLE.CUSTO > 0 THEN '499' ELSE '999' END, "
        cFieldsUpd += " CUSTO"+::aMoedas[nX]+" = CASE WHEN TEMPTABLE.CUSTO < 0 THEN TEMPTABLE.CUSTO * -1 ELSE TEMPTABLE.CUSTO END, "
        cFieldsUpd += " CSTOR"+::aMoedas[nX]+" = CASE WHEN TEMPTABLE.CUSTO < 0 THEN TEMPTABLE.CUSTO * -1 ELSE TEMPTABLE.CUSTO END "

        If oQuery == Nil
            // Query utilizada no CTE
            cQuery := " SELECT TRG.FILIAL,TRG.FILPROC,TRG.COD,TRG.LOCARM,MAX(TRG.MOEDA) MOEDA, "
            If ::lE330REA        
                cQuery += " ((AVG(TRG.CMFIXO) * MAX(TRK.QTDINI) ) - MAX(TRH.CMPROC? * TRK.QTDINI)) / COUNT(TRG.LOCARM) CUSTO "
            Else
                cQuery += " ((AVG(TRG.CMFIXO) * MAX(TRK.QUANT) ) - MAX(TRH.CMPROC? * TRK.QUANT)) / COUNT(TRG.LOCARM) CUSTO "
            EndIf
            cQuery += " FROM "+cTableMov+" TRG "
            cQuery += " INNER JOIN "+cTableTRK+" TRK ON "
            cQuery += " TRK.FILPROC = TRG.FILPROC "
		    cQuery += " AND TRK.FILIAL = TRG.FILIAL "
		    cQuery += " AND TRK.COD = TRG.COD "
            cQuery += " AND TRK.ARMAZEM = TRG.LOCARM "
            cQuery += " INNER JOIN "+cTableProc+" TRH ON "
            cQuery += " TRH.FILPROC = TRG.FILPROC "
            If ::cCusFil == "E"
                cQuery += " AND TRH.FILIAL = ? "
            Else
			    cQuery += " AND TRH.FILIAL = TRG.FILIAL "
            EndIf
			cQuery += " AND TRH.COD = TRG.COD "
            If ::cCusFil == "A"
                cQuery += " AND TRH.ARMAZEM = TRG.LOCARM "
            EndIf
            cQuery += " WHERE TRG.FILPROC = ? "
            cQuery += " AND TRG.CF IN (?) "
            cQuery += " AND TRG.MOEDA = ? "
            cQuery += " GROUP BY TRG.FILPROC,TRG.FILIAL,TRG.COD,TRG.LOCARM "
            cQuery := ChangeQuery(cQuery)

            oQuery := FWExecStatement():New(cQuery)
        EndIf

        oQuery:SetUnsafe(nY++,::aMoedas[nX])
        If ::cCusFil == "E"
            oQuery:SetString(nY++,FWCodEmp())
        EndIf
        oQuery:SetString(nY++,cFilAnt)
        oQuery:SetIn(nY++,{'REA','DEA'})
        oQuery:SetString(nY++,::aMoedas[nX])

        cQuery := oQuery:GetFixQuery()

        cCteStatement := ::buildCteStatement(cTableMov,cFieldsUpd,cMatchFilter,cQuery)

        ::RunQuery(cCteStatement)
    Next nX

Return

/*/{Protheus.doc} adjustAverageCostInProcTable
    Atualiza o custo da tabela de processamento com base no movimento de reavaliação
    @type Method
    @author Squad.Entradas
    @since 08/12/2025
/*/
Method adjustAverageCostInProcTable() Class AverageCostRecalculation
    local oQuery        as object
    local cQuery        as character
    local cFieldsUpd    as character
    local cMatchFilter  as character
    local cCteStatement as character
    local cTableProc    := ProcessingTable():TableName()         as character
    local cTableTRK     := BalanceByWarehouse():TableName()      as character
    local cTableMov     := AnalyticalMovementTable():TableName() as character
    local nX            as integer
    local nY            as integer

    // Filtro do update
    cMatchFilter := cTableProc+".R_E_C_N_O_ = TEMPTABLE.RECNO "

    For nX := 1 to Len(::aMoedas)
        nY := 1
        cFieldsUpd := " "

        // Campos que serão atualizados no Update        
        If ::cCusFil == "A"
            cFieldsUpd := " CMPROC"+::aMoedas[nX]+" = TEMPTABLE.CMFIXO, "
        EndIf

        If ::lE330REA
            cFieldsUpd += " CSTPROC"+::aMoedas[nX]+" = CSTPROC"+::aMoedas[nX]+" + TEMPTABLE.CUSTO "
        Else
            cFieldsUpd += " CSTPROC"+::aMoedas[nX]+" = (TEMPTABLE.QUANT * TEMPTABLE.CMPROC) + TEMPTABLE.CUSTO "
        EndIf

        // Query utilizada no CTE
        If oQuery == Nil
            cQuery := " SELECT TRG.FILPROC,TRH.FILIAL,TRG.COD, "
            If !::lE330REA
                cQuery += " SUM(TRK.QUANT) QUANT, "
            EndIf
            cQuery += " MAX(TRH.CMPROC?) CMPROC,MAX(TRH.R_E_C_N_O_) RECNO, SUM(TRG.CUSTO) CUSTO "
            If ::cCusFil == "A"
                cQuery += " ,TRG.LOCARM, "
                cQuery += " AVG(TRG.CMFIXO) CMFIXO "
            EndIf
            cQuery += " FROM ( "
            cQuery += " SELECT FILPROC, FILIAL, COD, LOCARM, AVG(CMFIXO) CMFIXO, "
            cQuery += " SUM(CASE WHEN CF = 'DEA' THEN CUSTO? "
            cQuery += " WHEN CF = 'REA' THEN - CUSTO? "
            cQuery += " END) CUSTO "
            cQuery += " FROM "+cTableMov+" TRG "
            cQuery += " WHERE TRG.FILPROC = ? "
            cQuery += " AND TRG.CF IN (?) "
            cQuery += " AND TRG.MOEDA = ? "
            cQuery += " GROUP BY TRG.FILPROC, TRG.FILIAL, TRG.COD, TRG.LOCARM "
            cQuery += " ) TRG "
            If !::lE330REA
                cQuery += " INNER JOIN "+cTableTRK+" TRK ON "
                cQuery += " TRK.FILPROC = TRG.FILPROC "
                cQuery += " AND TRK.FILIAL = TRG.FILIAL "
                cQuery += " AND TRK.COD = TRG.COD "
                cQuery += " AND TRK.ARMAZEM = TRG.LOCARM "
            EndIf
            cQuery += " INNER JOIN "+cTableProc+" TRH ON "
            cQuery += " TRH.FILPROC = TRG.FILPROC "
            If ::cCusFil == "E"
                cQuery += " AND TRH.FILIAL = ? "
            Else
                cQuery += " AND TRH.FILIAL = TRG.FILIAL "
            EndIf
            cQuery += " AND TRH.COD = TRG.COD "
            If ::cCusFil == "A"
                cQuery += " AND TRH.ARMAZEM = TRG.LOCARM "
            EndIf
            cQuery += " GROUP BY TRG.FILPROC,TRH.FILIAL,TRG.COD "
            If ::cCusFil == "A"
                cQuery += " ,TRG.LOCARM "
            EndIf
            cQuery := ChangeQuery(cQuery)

            oQuery := FWExecStatement():New(cQuery)
        EndIf

        oQuery:SetUnsafe(nY++,::aMoedas[nX])
        oQuery:SetUnsafe(nY++,::aMoedas[nX])
        oQuery:SetUnsafe(nY++,::aMoedas[nX])
        oQuery:SetString(nY++,cFilAnt)
        oQuery:SetIn(nY++,{'REA','DEA'})
        oQuery:SetString(nY++,::aMoedas[nX])
        If ::cCusFil == "E"
            oQuery:SetString(nY++,FWCodEmp())
        EndIf

        cQuery := oQuery:GetFixQuery()

        cCteStatement := ::buildCteStatement(cTableProc,cFieldsUpd,cMatchFilter,cQuery)

        ::RunQuery(cCteStatement)

        If ::cCusFil <> "A"
            //Adiciona o custo na tabela de processamento dos armazéns que não tiveram reavaliação 
            ::getWarehousesMissingRevaluation(::aMoedas[nX],cTableProc,cTableTRK,cTableMov)
            
            //Atualiza a tabela de processamento como o novo custo médio
            ::updateProductAverageCost(::aMoedas[nX],cTableProc,cTableTRK,cTableMov)
        EndIf
    Next nX

Return

/*/{Protheus.doc} updateRevaluationMovement
    Atualiza o custo médio dos movimentos de reavaliação na SD3
    @type Method
    @author Squad.Entradas
    @since 08/12/2025
/*/
Method updateRevaluationMovement(oMovement,dDataIni) Class AverageCostRecalculation
    local oQuery    as object
    local cQuery    as character
    local cAlias    as character
    local cDataIni  := DtoS(dDataIni) as character
    local cTableMov := AnalyticalMovementTable():TableName() as character

    cQuery := " SELECT TRG.FILIAL,'SD3' TABELA,COD,RECNO,CF,TM, "
    cQuery += " CUSTO1,CUSTO2,CUSTO3,CUSTO4,CUSTO5, SEQCALC "
    cQuery += " FROM "+cTableMov+" TRG "
    cQuery += " WHERE TRG.FILPROC = ? "
    cQuery += " AND TRG.CF IN (?) "
    cQuery += " ORDER BY TRG.FILIAL "
    cQuery := ChangeQuery(cQuery)

    oQuery := FWExecStatement():New(cQuery)

    oQuery:SetString(1,::cFilProc)
    oQuery:SetIn(2,{'REA','DEA'})

    cAlias := oQuery:OpenAlias()

    oMovement:gravaMov(cAlias,cDataIni)

    If Select(cAlias) > 0
        (cAlias)->(DbCloseArea())
    EndIf

Return

/*/{Protheus.doc} getWarehousesMissingRevaluation
    Atualiza o custo na tabela de processamento de armazéns que não tiveram reavaliação
    considerando o custo unificado
    @type Method
    @author Squad.Entradas
    @since 08/12/2025
/*/
Method getWarehousesMissingRevaluation(cMoeda,cTableProc,cTableTRK,cTableMov) Class AverageCostRecalculation
    local cQuery        as character
    local cFieldsUpd    as character
    local cMatchFilter  as character
    local cCteStatement as character
    local nX            := 1 as integer

    // Filtro do update
    cMatchFilter := cTableProc+".R_E_C_N_O_ = TEMPTABLE.RECNO "

    cFieldsUpd := " CSTPROC"+cMoeda+" = CSTPROC"+cMoeda+" + TEMPTABLE.CUSTO "

    // Query utilizada no CTE
    If ::oQueryWarehousesMissing == Nil
        cQuery := " SELECT TRK.FILPROC, "
        If ::cCusFil == "F"
            cQuery += " TRK.FILIAL, "
        EndIf
        cQuery += " TRK.COD, "
        If ::lE330REA
            cQuery += " MAX(TRK.QTDINI) QUANT, "
        Else
            cQuery += " MAX(TRK.QUANT) QUANT, "
        EndIf
        cQuery += " TRH.R_E_C_N_O_ RECNO, "
	    cQuery += " MAX(TRK.QUANT * TRH.CMPROC?) CUSTO "
        cQuery += " FROM "+cTableTRK+" TRK "
        cQuery += " INNER JOIN "+cTableProc+" TRH "
        cQuery += " ON TRH.FILPROC = TRK.FILPROC "
        If ::cCusFil == "F"
            cQuery += " AND TRH.FILIAL = TRK.FILIAL "
        EndIf
        cQuery += " AND TRH.COD = TRK.COD "
        cQuery += " INNER JOIN "+cTableMov+" TRG ON "
        cQuery += " TRG.FILPROC = TRK.FILPROC "
        cQuery += " AND TRG.FILIAL  = TRK.FILIAL "
        cQuery += " AND TRG.COD     = TRK.COD "
        cQuery += " LEFT JOIN "+cTableMov+" TRGMOV "
        cQuery += " ON TRGMOV.FILPROC = TRK.FILPROC "
        cQuery += " AND TRGMOV.FILIAL  = TRK.FILIAL "
        cQuery += " AND TRGMOV.COD     = TRK.COD "
	    cQuery += " AND TRGMOV.LOCARM  = TRK.ARMAZEM "
        cQuery += " WHERE TRK.FILPROC = ? "
        cQuery += " AND TRG.CF IN (?) "
        cQuery += " AND TRG.MOEDA = ? "
        cQuery += " AND TRGMOV.LOCARM IS NULL "
        cQuery += " GROUP BY TRK.FILPROC, "
        If ::cCusFil == "F"
            cQuery += " TRK.FILIAL, "
        EndIf
        cQuery += " TRK.COD,TRK.ARMAZEM,TRH.R_E_C_N_O_ "

        ::oQueryWarehousesMissing := FWExecStatement():New(cQuery)
    EndIf

    ::oQueryWarehousesMissing:SetUnsafe(nX++,cMoeda)
    ::oQueryWarehousesMissing:SetString(nX++,::cFilProc)
    ::oQueryWarehousesMissing:SetIn(nX++,{'REA','DEA'})
    ::oQueryWarehousesMissing:SetString(nX++,cMoeda)

    cQuery := ::oQueryWarehousesMissing:GetFixQuery()

    cCteStatement := ::buildCteStatement(cTableProc,cFieldsUpd,cMatchFilter,cQuery)

    ::RunQuery(cCteStatement)

Return

/*/{Protheus.doc} updateProductAverageCost
    Reprocessa o custo médio dos produtos que tiveram reavaliação
    @type Method
    @author Squad.Entradas
    @since 08/12/2025
/*/
Method updateProductAverageCost(cMoeda,cTableProc,cTableTRK,cTableMov) Class AverageCostRecalculation 
    local cQuery        as character
    local cFieldsUpd    as character
    local cMatchFilter  as character
    local cCteStatement as character

    // Filtro do update
    cMatchFilter := cTableProc+".FILPROC = TEMPTABLE.FILPROC AND "
    If ::cCusFil == "E"
        cMatchFilter += cTableProc+".FILIAL = '"+FWCodEmp()+"' AND "
    Else
        cMatchFilter += cTableProc+".FILIAL = TEMPTABLE.FILIAL AND "
    EndIf
    cMatchFilter += cTableProc+".COD = TEMPTABLE.COD "

    cFieldsUpd := " CMPROC"+cMoeda+" =  CASE WHEN TEMPTABLE.QUANT > 0 THEN CSTPROC"+cMoeda+" / TEMPTABLE.QUANT ELSE TEMPTABLE.CMFIXO END "

    If ::oQueryProductAverageCost == Nil
        cQuery := " SELECT TRK.FILPROC, "
        If ::cCusFil == "F"
            cQuery += " TRK.FILIAL, "
        EndIf
        cQuery += " TRK.COD, "
        If ::lE330REA
            cQuery += " SUM(TRK.QTDINI) QUANT, "
        Else
            cQuery += " SUM(TRK.QUANT) QUANT, "
        EndIf
        cQuery += " MAX(TRG.CMFIXO) CMFIXO "
        cQuery += " FROM "+cTableTRK+" TRK "
        cQuery += " INNER JOIN ( "
        cQuery += " SELECT FILPROC, "
        If ::cCusFil == "F"
            cQuery += " FILIAL, "
        EndIf
        cQuery += " COD,AVG(CMFIXO) CMFIXO "
        cQuery += " FROM "+cTableMov+" TRG "
        cQuery += " WHERE TRG.FILPROC = ? "
        cQuery += " AND TRG.CF IN (?) "
        cQuery += " AND TRG.MOEDA = ? "
        cQuery += " GROUP BY FILPROC, "
        If ::cCusFil == "F"
            cQuery += " FILIAL, "
        EndIf
        cQuery += " COD ) TRG "
        cQuery += " ON TRG.FILPROC = TRK.FILPROC "
        If ::cCusFil == "F"
            cQuery += " AND TRG.FILIAL = TRK.FILIAL "
        EndIf
        cQuery += " AND TRG.COD = TRK.COD "
        cQuery += " WHERE TRK.FILPROC = ? "
        cQuery += " GROUP BY TRK.FILPROC, "
        If ::cCusFil == "F"
            cQuery += " TRK.FILIAL, "
        EndIf
        cQuery += " TRK.COD "
        cQuery := ChangeQuery(cQuery)

        ::oQueryProductAverageCost := FWExecStatement():New(cQuery)
    EndIf
    ::oQueryProductAverageCost:SetString(1,::cFilProc)
    ::oQueryProductAverageCost:SetIn(2,{'REA','DEA'})
    ::oQueryProductAverageCost:SetString(3,cMoeda)
    ::oQueryProductAverageCost:SetString(4,::cFilProc)

    cQuery := ::oQueryProductAverageCost:GetFixQuery()

    cCteStatement := ::buildCteStatement(cTableProc,cFieldsUpd,cMatchFilter,cQuery)

    ::RunQuery(cCteStatement)

Return
