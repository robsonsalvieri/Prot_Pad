#include "Totvs.ch"
#include "tlpp-core.th"

Namespace totvs.protheus.backoffice.stock.iterativecost.view.parts.incominginvoiceitems

/*/{Protheus.doc} ViewIncomingInvoiceItemsParts
    View SB1MODP - Itens NF entrada - custo em partes
    @author Leonardo Kichitaro
    @Type Method
    @since 28/10/2025
    @version 1
    /*/
Class ViewIncomingInvoiceItemsParts //Implements IterativeCostView
    Public Method New()

    Static Method GetVersion()
    Static Method GetViewID()
    Public Method GetParams()
    Public Method GetQuery()
EndClass

/*/{Protheus.doc} New
    Instância
    @author Leonardo Kichitaro
    @Type Method
    @since 28/10/2025
    /*/
Method New() Class ViewIncomingInvoiceItemsParts

    Select('D4L')

Return Self

/*/{Protheus.doc} GetVersion
    Versão da View
    @author Leonardo Kichitaro
    @Type Method
    @since 28/10/2025
    /*/
Method GetVersion() Class ViewIncomingInvoiceItemsParts
Return "0001"

/*/{Protheus.doc} GetViewID
    ID da View
    Não alterar após entrar em produção
    @author Leonardo Kichitaro
    @Type Method
    @since 28/10/2025
    /*/
Method GetViewID() Class ViewIncomingInvoiceItemsParts
Return "VWD1SDITCP"

/*/{Protheus.doc} GetParams
    Retorna Json contendo os codeblock executáveis para obter os parâmetros da View
    @author Leonardo Kichitaro
    @Type Method
    @since 28/10/2025
    /*/
Method GetParams() Class ViewIncomingInvoiceItemsParts
    Local jExec := JsonObject():New() As Json

    jExec["TAM_CODPAR"]  := {|| TamSX3('D4L_PARTE')[1]}
Return jExec

/*/{Protheus.doc} GetQuery
    Retorna a query estruturada da instalação da View com base nos parâmetros informados
    @author Leonardo Kichitaro
    @Type Method
    @since 28/10/2025
    /*/
Method GetQuery(cEmpAtu As Character, jParam As Json) Class ViewIncomingInvoiceItemsParts

    Local cQuery  As Character
    Local cIDView As Character
    Local cNomFis As Character
    Local cDbType As Character
    Local cVersao As Character
    Local nTamPar := jParam["TAM_CODPAR"]
    Local cOutros := Replicate('9', nTamPar)
    Local cTamPar := cValToChar(nTamPar)

	cIDView := ::GetViewID()
    cNomFis := "VW_"+cIDView+"_"+cEmpAtu
    cDbType := TCGetDB()
    cVersao := ::GetVersion()

    cQuery := " Create View "+cNomFis+" As "
    cQuery += " Select "
    cQuery += " Cast('"+cVersao+"' As Char(4)) ASSINATURA, "
    cQuery += " D1_FILIAL, D1_COD, D1_DTDIGIT, D1_LOCAL, D1_FORMUL, D1_ITEMGRD, "
    cQuery += " D1_DOC, D1_SERIE, D1_FORNECE, D1_LOJA, D1_ITEM, D1_NUMSEQ, D1_TES, "
    cQuery += " D1_CUSTO D1_CUSTO1, D1_CUSTO2, D1_CUSTO3, D1_CUSTO4, D1_CUSTO5, "
    cQuery += " D1_QUANT, D1_QTSEGUM, SD1.R_E_C_N_O_, "
    cQuery += " D4L_FILIAL, D4L_REVISA, "
    cQuery += " Cast(Coalesce(D4L_PARTE, '"+cOutros+"') As Char("+cTamPar+")) D4L_PARTE, "
    cQuery += " D4L_MOEDA, D4L_TOTAL "
    cQuery += " From "+RetSQLName('SD1')+" SD1 "
    cQuery += " Inner Join "+RetSQLName('D4L')+" D4L On "
    cQuery += " D4L.D4L_FILIAL = SD1.D1_FILIAL And "
    cQuery += " D4L.D4L_DOC  = SD1.D1_DOC And "
    cQuery += " D4L.D4L_SERIE = SD1.D1_SERIE And "
    cQuery += " D4L.D4L_FORNEC  = SD1.D1_FORNECE And "
    cQuery += " D4L.D4L_LOJA = SD1.D1_LOJA And "
    cQuery += " D4L.D4L_ITEM  = SD1.D1_ITEM And "
    cQuery += " D4L.D4L_FORMUL = SD1.D1_FORMUL And "
    cQuery += " D4L.D4L_ITEMGR = SD1.D1_ITEMGRD And "
    cQuery += " D4L.D_E_L_E_T_ = ' ' " 

Return cQuery
