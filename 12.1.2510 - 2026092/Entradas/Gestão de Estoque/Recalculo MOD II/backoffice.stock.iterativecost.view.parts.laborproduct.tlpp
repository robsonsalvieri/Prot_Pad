#include "Totvs.ch"
#include "tlpp-core.th"

Namespace totvs.protheus.backoffice.stock.iterativecost.view.parts.laborproduct

/*/{Protheus.doc} ViewLaborProductParts
    View SB1MODP - Produtos Mão de Obra - custo em partes
    @author Squad Entrada
    @Type Method
    @since 23/04/2025
    @version 1
    /*/
Class ViewLaborProductParts //Implements IterativeCostView
    Public Method New()

    Static Method GetVersion()
    Static Method GetViewID()
    Public Method GetParams()
    Public Method GetQuery()
EndClass

/*/{Protheus.doc} New
    Instância
    @author Squad Entrada
    @Type Method
    @since 23/04/2025
    /*/
Method New() Class ViewLaborProductParts
Return Self

/*/{Protheus.doc} GetVersion
    Versão da View
    @author Squad Entrada
    @Type Method
    @since 23/04/2025
    /*/
Method GetVersion() Class ViewLaborProductParts
Return "0001"

/*/{Protheus.doc} GetViewID
    ID da View
    Não alterar após entrar em produção
    @author Squad Entrada
    @Type Method
    @since 23/04/2025
    /*/
Method GetViewID() Class ViewLaborProductParts
Return "VWB1PMO"

/*/{Protheus.doc} GetParams
    Retorna Json contendo os codeblock executáveis para obter os parâmetros da View
    @author Squad Entrada
    @Type Method
    @since 23/04/2025
    /*/
Method GetParams() Class ViewLaborProductParts
    Local jExec := JsonObject():New() As Json

    jExec["VWB1MOD_NOME"] := {|| Posicione('D4D',1,FWXFilial('D4D')+'VWB1MOD','D4D_VWNAME')}
    jExec["TAM_REVIS"]   := {|| TamSX3('D4G_REVIS')[1]}
    jExec["TAM_CODPAR"]  := {|| TamSX3('D4F_CODPAR')[1]}
Return jExec

/*/{Protheus.doc} GetQuery
    Retorna a query estruturada da instalação da View com base nos parâmetros informados
    @author Squad Entrada
    @Type Method
    @since 23/04/2025
    /*/
Method GetQuery(cEmpAtu As Character, jParam As Json) Class ViewLaborProductParts
    Local cQuery  As Character
    Local cIDView As Character
    Local cNomFis As Character
    Local cDbType As Character
    Local cVersao As Character
    Local nTamPar := jParam["TAM_CODPAR"] As Numeric
    Local cOutros := Replicate('9', nTamPar) As Character
    Local nTamCC  As Numeric
    Local nTamGr  As Numeric
    Local nTamRev As Numeric
    Local cRevis  As Character
    Local nTamTip As Numeric
    Local cTipo   As Character
    Local nTamClV As Numeric
    Local cClVlr  As Character
    Local nTamItC As Numeric
    Local cItCont As Character
    
	cIDView := ::GetViewID()
    cNomFis := "VW_"+cIDView+"_"+cEmpAtu
    cDbType := TCGetDB()
    cVersao := ::GetVersion()
    nTamCC  := TamSX3('B1_CCCUSTO')[1]
    nTamGr  := TamSX3('B1_GCCUSTO')[1]
    nTamRev := TamSX3('D4G_REVIS')[1]
    nTamTip := TamSX3('D4F_TIPO')[1]
    nTamClV := TamSX3('D4F_CLVLR')[1]
    nTamItC := TamSX3('D4F_ITEMC')[1]
    cRevis  := Space(nTamRev)
    cTipo   := Space(nTamTip)
    cClVlr  := Space(nTamClV)
    cItCont := Space(nTamItC)

    cQuery := " Create View "+cNomFis+" As "
    //pega as partes vinculadas ao produto MOD
    cQuery += " Select "    
    cQuery += " Cast('"+cVersao+"' As Char(4)) ASSINATURA, "
    cQuery += " SB1MOD.B1_FILIAL, SB1MOD.B1_COD, "
    cQuery += " SB1MOD.B1_CCCUSTO, SB1MOD.B1_GCCUSTO, SB1MOD.MODELO, "
    cQuery += " D4G.D4G_REVIS, "
    cQuery += " D4F.D4F_TIPO, "
    cQuery += " D4F.D4F_ITEMC, "
    cQuery += " D4F.D4F_CLVLR, "
    cQuery += " D4G.D4G_CODPAR "
    cQuery += " From "+jParam["VWB1MOD_NOME"]+" SB1MOD "
    cQuery += " Inner Join "+RetSQLName("D4G")+" D4G On "
    cQuery += " D4G.D4G_FILIAL = SB1MOD.B1_FILIAL And "
    cQuery += " D4G.D4G_PRODUT = SB1MOD.B1_COD    And "
    cQuery += " D4G.D_E_L_E_T_ = ' ' "
    cQuery += " Inner Join "+RetSQLName("D4F")+" D4F On "
    cQuery += " D4F.D4F_FILIAL = '"+FWXFilial("D4F")+"' And "
    cQuery += " D4F.D4F_REVIS  = D4G.D4G_REVIS And "
    cQuery += " D4F.D4F_CODPAR = D4G.D4G_CODPAR And "
    cQuery += " D4F.D_E_L_E_T_ = ' ' "

    cQuery += " Union All"
    
    //Vincula o produto MOD automaticamente com a parte 99
    cQuery += " Select "    
    cQuery += " Cast('"+cVersao+"' As Char(4)) ASSINATURA, "
    cQuery += " SB1MOD.B1_FILIAL, SB1MOD.B1_COD, "
    cQuery += " SB1MOD.B1_CCCUSTO, SB1MOD.B1_GCCUSTO, SB1MOD.MODELO, "
    cQuery += " Cast('"+cRevis+"' As Char("+cValToChar(nTamRev)+")) D4G_REVIS, "
    cQuery += " Cast('"+cTipo+"'  As Char("+cValToChar(nTamTip)+")) D4F_TIPO, "
    cQuery += " Cast('"+cItCont+"' As Char("+cValToChar(nTamItC)+")) D4F_ITEMC, "
    cQuery += " Cast('"+cClVlr+"' As Char("+cValToChar(nTamClV)+")) D4F_CLVLR, "
    cQuery += " Cast('"+cOutros+"' As Char("+cValToChar(nTamPar)+")) D4G_CODPAR "
    cQuery += " From "+jParam["VWB1MOD_NOME"]+" SB1MOD "
Return cQuery
