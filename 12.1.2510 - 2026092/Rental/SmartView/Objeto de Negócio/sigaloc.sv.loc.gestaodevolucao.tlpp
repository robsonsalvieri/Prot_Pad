@SINCE 02/12/2025
/*/

method getSchema() as object class gestaodevolucao

	self:addProperty("Projeto",         "Projeto",               "string", "Projeto",               "FQW_PROJET")
	self:addProperty("Obra",            "Obra",                  "string", "Obra",                  "FQW_OBRA")
	self:addProperty("Romaneio",        "Romaneio",              "string", "Romaneio",              "FQW_NUM")
	self:addProperty("Item",            "Item",                  "string", "Item",                  "FQX_ITEM")
	self:addProperty("ClienteProj",     "Cliente Proj",          "string", "Cliente Proj",          "FQW_CLIENT")
	self:addProperty("LojaCliente",     "Loja Cliente",          "string", "Loja Cliente",          "FQW_LOJA")
	self:addProperty("NomeCliente",     "Nome Cliente",          "string", "Nome Cliente",          "FQW_NOMCLI")
	self:addProperty("ClienteDest",     "Cliente Dest",          "string", "Cliente Dest",          "FQW_CLIDEV")
	self:addProperty("LojaDestino",     "Loja Destino",          "string", "Loja Destino",          "FQW_LOJDEV")
	self:addProperty("NomeDestino",     "Nome Destino",          "string", "Nome Destino",          "FQW_NOMDEV")
	self:addProperty("Endereço",        "Endereço",              "string", "Endereço",              "FQW_ENDDEV")
	self:addProperty("Bairro",          "Bairro",                "string", "Bairro",                "FQW_BAIDEV")
	self:addProperty("Municipio",       "Municipio",             "string", "Municipio",             "FQW_MUNDEV")
	self:addProperty("UFDestino",       "UF Destino",            "string", "UF Destino",            "FQW_ESTDEV")
	self:addProperty("CEPDestino",      "CEP Destino",           "string", "CEP Destino",           "FQW_CEPDEV")
	self:addProperty("Produto",         "Produto",               "string", "Produto",               "FQX_PROD")
	self:addProperty("DescProdut",      "Desc. Produt",          "string", "Desc. Produt",          "B1_DESC")
	self:addProperty("Armazem",         "Armazem",               "string", "Armazem",               "B1_LOCPAD")
	self:addProperty("Equipamento",     "Equipamento",           "string", "Equipamento",           "T9_CODBEM")
	self:addProperty("NomeEquipamento", "Nome Equip.",           "string", "Nome Equip.",           "T9_NOME")
	self:addProperty("UnidadeMedida",   "Unidade de medida",     "string", "Unidade de medida",     "B1_UM")
	self:addProperty("Quantidade",      "Quantidade",            "number", "Quantidade",            "FQX_QTD")

	self:addParameter("01", "Romaneio", "string", .F., "", .F., .F., "", "MV_PAR01")

return self:oSchema


/*/{Protheus.doc} printReceipt
Gera a impressão do Romaneio Posicionado 
@author Leonardo Pacheco Fuga
@since 02/12/2025
@version 25.10
*/
method printDevolucao(cRomaneio as character) as logical class gestaodevolucao
Local lSuccess := .F. as logical
Local jPrintInfo as json
Local cSmartViewId := "sigaloc.sv.loc.gestaodevolucao.default.rep"
Local aReportType := {"report", "data-grid", "pivot-table"} as array
Local cDefaultPath := GetTempPath() as character
Local oSmartView As Object
Local cMsg := "" As Character
  
    jPrintInfo := JsonObject():New() 
    jPrintInfo['name'] := "Romaneio_" + FwTimeStamp()
    jPrintInfo['extension'] := "pdf"
    jPrintInfo['path'] := cDefaultPath
    
    oSmartView := totvs.framework.smartview.callSmartView():new(cSmartViewId,aReportType[1])
	oSmartView:setOpenFile(.T.)
    oSmartView:setNoInterface(.F.)
    oSmartView:setParam("01", cRomaneio, "Disabled")
    oSmartView:setForceParams(.T.)
    oSmartView:setPrintInfo(jPrintInfo)
    lSuccess := oSmartView:executeSmartView(.T.)

    If !lSuccess .or. file("\SYSTEM\LOCSV026.TXT")
        cMsg := oSmartView:getError()
    EndIf

    oSmartView:Destroy()

    If oSmartView != Nil   
        FreeObj(oSmartView)
    EndIf

return lSuccess

