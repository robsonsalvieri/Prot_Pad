//-------------------------------------------------------------------
/*/{Protheus.doc} getCtGerPlanSchema
    Metodo getCtGerPlanSchema
    
    @author Controladoria
    @since 09/11/2023
    @version 12.1.2310
/*/
//-------------------------------------------------------------------

method getCtGerPlanSchema() as object class BalanceSheetCostCenterxAccountSmartViewBusinessObject
    Local lCanFilter := .F. as logical

    self:oSchema:addProperty("TOT_MOV"        , STR0003  , "string", STR0003 , "TOT_MOV"        ,,,,lCanFilter) //"Total Mov. Acumulado"
    self:oSchema:addProperty("TOT_DEBITO"     , STR0004  , "string", STR0004 , "TOT_DEBITO"     ,,,,lCanFilter) //"Total Débito Acumulado"
    self:oSchema:addProperty("TOT_CREDITO"    , STR0005  , "string", STR0005 , "TOT_CREDITO"    ,,,,lCanFilter) //"Total Crédito Acumulado"
    self:oSchema:addProperty("TOT_SALDOANT"   , STR0006  , "string", STR0006 , "TOT_SALDOANT"   ,,,,lCanFilter) //"Total Saldo Anterior"    
    self:oSchema:addProperty("TOT_SALDOATU"   , STR0007  , "string", STR0007 , "TOT_SALDOATU"   ,,,,lCanFilter) //"Total Saldo Atual" 
    self:oSchema:addProperty("TOT_MOV_CC"     , STR0011  , "string", STR0011 , "TOT_MOV_CC"     ,,,,lCanFilter) //"Total Mov. Acumulado CC"
    self:oSchema:addProperty("TOT_DEBITO_CC"  , STR0012  , "string", STR0012 , "TOT_DEBITO_CC"  ,,,,lCanFilter) //"Total Débito Acumulado CC"
    self:oSchema:addProperty("TOT_CREDITO_CC" , STR0013  , "string", STR0013 , "TOT_CREDITO_CC" ,,,,lCanFilter) //"Total Crédito Acumulado CC"
    self:oSchema:addProperty("TOT_SALDOANT_CC", STR0014  , "string", STR0014 , "TOT_SALDOANT_CC",,,,lCanFilter) //"Total Saldo Anterior CC"     
    self:oSchema:addProperty("TOT_SALDOATU_CC", STR0015  , "string", STR0015 , "TOT_SALDOATU_CC",,,,lCanFilter) //"Total Saldo Atual CC" 
    self:oSchema:addProperty("NomeEmpresa"    , STR0008  , "string", STR0008 , "NomeEmpresa"    ,,,,lCanFilter) //"Nome Empresa"
    self:oSchema:addProperty("NomeFilial"     , STR0009  , "string", STR0009 , "NomeFilial"     ,,,,lCanFilter) //"Nome Filial"
    
    self:oSchema:addParameter("SV_MULTBRANCH" ,STR0010 , "string", .T.)  //"Filiais"
    self:setCustomURL("SV_MULTBRANCH",  "/api/controladoria/smartview/v1/options/getBranches",2)  

return self:oSchema

