namespace totvs.protheus.ctb.smartviewintegratedprovider
using namespace control.sv.functions.utils

@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGACTB", tables="CT1, CT2, CTT", name="Balancete Centro de Custos x Contas", country="ALL")

//-------------------------------------------------------------------------------
/*{Protheus.doc} BalanceSheetCostCenterxAccountSmartViewBusinessObject
Classe paara a criação do Objeto de Negócio do Balancete Centro de Custos x Contas 
para o TReports
 
@author Controladoria
@since 09/11/2023
@version 1.0
*/
//-------------------------------------------------------------------------------

class BalanceSheetCostCenterxAccountSmartViewBusinessObject from totvs.protheus.ctb.smartviewintegratedprovider.SmartviewCtbFunctions
    public method new()                     as object
    public method getDescription()          as character
    public method getCtgGerPlanData()       as object
    public method getCtGerPlanSchema()      as object

    //usados na internacionalização
    public method preData()                as object
    public method preSchema()              as object
    public method processData()            as json
    
    public method handleCtgGerPlanParams() 
    public method handleCtgGerPlanAppend()  as object
    public method handleExeCtgGerPlan()     as object

    public method ExecDBSkipTemp()
    public method vldExeCtgGerPlan()
    public method processCustomData()       as json

    protected method somaTotal()            as numeric
    protected method RetValorCtb()          as character

    protected data nTotCrd      as numeric
    protected data nTotDeb      as numeric
    protected data nTotMov      as numeric
    protected data nTotSldAnt   as numeric
    protected data nTotSldAtu   as numeric
    protected data nTotSldAntCC as numeric
    protected data nTotDebCC    as numeric
    protected data nTotCrdCC    as numeric
    protected data nTotSldAtuCC as numeric
    protected data nTotMovCC    as numeric
    protected data nGrupoOrdAnt as numeric
    protected data cCustoAnt    as character
    protected data cValorCtb    as character
    protected data cMvMasc      as character
    protected data cMvCus       as character
    protected data lTotSintCalc   as logical  // flag: totais já foram pré-calculados pelas analíticas
    protected data aTotSintCC     as array    // array com totais pré-calculados por CC [{cCusto, nAnt, nDeb, nCrd, nAtu}]
    protected data aTotSintCta    as array    // array com totais pré-calculados por conta sintética [{cConta+cCusto, nAnt, nDeb, nCrd, nAtu}]
    protected data cGrupoBkpCC    as character // backup do grupo do último registro appendado (para LTROCAGRP/LTROCACC)
    protected data cCustoBkpCC    as character // backup do custo do último registro appendado
    protected data lHouveTrocaCC  as logical  // indica se já houve troca de CC em algum registro anterior
    protected data lHouveTrocaGrp as logical  // indica se já houve troca de grupo em algum registro anterior

    // --- DSERCTR1-52903 (Correo A): invariantes de DecimalCTB/picture, calculadas 1x ---
    protected data nDecCache      as numeric   // DecimalCTB(::aSetOfBook, mv_par10) - invariante da execuo
    protected data cPictVlr       as character // picture de valor derivada de ::aSetOfBook[4] - invariante da execuo

    // --- DSERCTR1-52903 (Correo B): invariantes de CTBSetOf/mscaras de ExecDBSkipTemp, calculadas 1x ---
    protected data aSetOfBkFil    as array     // CTBSetOf(mv_par08) - idntico ao antigo ExecDBSkipTemp:660, cacheado
    protected data cMascCta       as character // mscara de conta derivada de ::aSetOfBkFil, cacheada
    protected data cMascCC        as character // mscara de centro de custo derivada de ::aSetOfBkFil, cacheada

    // --- DSERCTR1-52903 (Correo C): totalizadores formatados, cacheados por pgina / por CC ---
    protected data lTotGerFmt     as logical   // .T. quando os 5 TOT_* gerais j esto formatados nesta pgina
    protected data cTotDebFmt     as character
    protected data cTotCrdFmt     as character
    protected data cTotAtuFmt     as character
    protected data cTotAntFmt     as character
    protected data cTotMovFmt     as character
    protected data cChvTotCC      as character // chave do cache de CC: CUSTO + "|" + CCNORMAL
    protected data cTotDebCCFmt   as character
    protected data cTotCrdCCFmt   as character
    protected data cTotAtuCCFmt   as character
    protected data cTotAntCCFmt   as character
    protected data cTotMovCCFmt   as character

    // --- DSERCTR1-52903 (Correo D): ndices hash paralelos aos arrays de totais sintticos ---
    protected data oIdxTotCC      as object    // THashMap: AllTrim(CUSTO)      -> posio em ::aTotSintCC
    protected data oIdxTotCta     as object    // THashMap: conta + "|" + custo -> posio em ::aTotSintCta

endclass

//-------------------------------------------------------------------
/*{Protheus.doc} new
Método de instância da classe
 
@return object: self
 
@author Controladoria
@since 09/11/2023
@version 1.0
*/
//------------------------------------------------------------------- 

method new() as object class BalanceSheetCostCenterxAccountSmartViewBusinessObject

    _Super:new()

    //Define o nome do Objeto de Negócio
    self:setDisplayName(STR0001) //str0001 - "Balancete Centro de Custos x Contas"
    self:setPergunte("CTR180") //Indica o pergunte que será utilizado no relatório
    self:setIsLookUp(.T.)

    self:cCustoAnt      := ""
    self:nTotSldAnt     := 0
    self:nTotSldAtu     := 0
    self:nTotCrd        := 0
    self:nTotDeb        := 0
    self:nTotMov        := 0
    self:nTotMovCC      := 0
    self:nTotSldAntCC   := 0
    self:nTotDebCC      := 0
    self:nTotCrdCC      := 0
    self:nTotSldAtuCC   := 0
    self:lTotSintCalc   := .F.
    self:aTotSintCC     := {}
    self:aTotSintCta    := {}
    self:cGrupoBkpCC    := ""
    self:cCustoBkpCC    := ""
    self:lHouveTrocaCC  := .F.
    self:lHouveTrocaGrp := .F.
    self:cMvMasc        := SuperGetMv("MV_MASCARA")
    self:cMvCus         := SuperGetMV("MV_MASCCUS")

    // DSERCTR1-52903 (Correo C): flags de cache dos totalizadores formatados,
    // invalidadas por pgina em handleExeCtgGerPlan (::lTotGerFmt) e por troca de
    // CC em processCustomData (::cChvTotCC).
    self:lTotGerFmt     := .F.
    self:cChvTotCC      := ""

    // DSERCTR1-52903 (Correo D): indices hash paralelos a ::aTotSintCC/::aTotSintCta,
    // instanciados uma nica vez, no mesmo ponto em que os arrays so inicializados.
    self:oIdxTotCC      := THashMap():New()
    self:oIdxTotCta     := THashMap():New()

return self

