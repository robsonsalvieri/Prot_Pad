/*/
//-------------------------------------------------------------------

method getCtgGerPlanData(nPage as numeric, oFilter as object) as object class BalanceSheetCostCenterxAccountSmartViewBusinessObject
    //Carrega lista de parametros para a memória
    CTBsetValueMVPAR(oFilter:getParameters(), "CTR180")
    self:handleCtgGerPlanParams( oFilter )
    
return self:oData

//-------------------------------------------------------------------
/*/{Protheus.doc} handleExeCtgGerPlan
    Metodo handleExeCtgGerPlan

    Pré-calcula, antes dos filtros de impressão, os totais que o processCustomData
    consome linha a linha: o total geral, o total por centro de custo (::aTotSintCC)
    e o total por conta sintética (::aTotSintCta), todos apurados exclusivamente a
    partir das contas ANALÍTICAS (TIPOCONTA="2") do arquivo temporário.

    A hierarquia de contas é percorrida pela cadeia SUPERIOR já persistida em cada
    linha do arquivo temporário pela CtEntCtSup — sem qualquer acesso à CT1 —,
    acumulando POR CHAVE (conta|custo) em todos os níveis até a raiz, com guarda
    contra ciclo e com salvamento/restauração do Recno() do temporário ao redor da
    travessia.

    @author Controladoria
    @since 09/11/2023
    @version 12.1.2310
/*/
//-------------------------------------------------------------------

method handleExeCtgGerPlan(oFilter as object) as object class BalanceSheetCostCenterxAccountSmartViewBusinessObject
    // Pré-calcula totais geral, por CC e por conta sintética percorrendo o arquivo
    // temporário completo com base apenas nas contas ANALÍTICAS (TIPOCONTA="2"),
    // análogo ao SldCCusto() do CTBR180 — executado antes dos filtros de impressão.
    //
    // A hierarquia de contas superiores de cada analítica
    // é percorrida pela cadeia SUPERIOR já gravada em cada linha do arquivo
    // temporário pela CtEntCtSup, e não por uma travessia própria sobre a CT1 — que
    // rompia em silêncio a partir do 2º salto e deixava apenas o 1º nível acumulado.
    // Para cada analítica: os saldos e as chaves são capturados em variáveis locais
    // antes da travessia; o Recno() do temporário é salvo e restaurado ao redor dela,
    // porque a navegação move o ponteiro; cada nível encontrado é acumulado POR CHAVE
    // (conta|custo); e uma guarda contra ciclo impede que o mesmo nível seja
    // contabilizado duas vezes para a mesma analítica. Assim os totais se propagam
    // corretamente do 1º nível até a raiz da árvore de contas, sem acesso à CT1.

    Local cChaveSint    as character  // chave composta conta+custo para sintéticas
    Local nPosCC        as numeric    // posicao do CC corrente em aTotSintCC
    Local nPosCta       as numeric
    Local nSldAnt       as numeric    // SALDOANT da linha analitica corrente
    Local nSldDeb       as numeric    // SALDODEB da linha analitica corrente
    Local nSldCrd       as numeric    // SALDOCRD da linha analitica corrente
    Local nSldAtu       as numeric    // SALDOATU da linha analitica corrente
    Local nRegTmp       as numeric    // Recno() do temporario (restauracao da posicao)
    Local nTamCta       as numeric    // largura plena da chave de conta (CT1_CONTA)
    Local nTamCC        as numeric    // largura plena da chave de centro de custo (CTT_CUSTO)
    Local cContaSup     as character  // conta superior corrente na travessia hierárquica
    Local cCusto        as character  // custo da analítica em processamento

    // Os acumuladores ::nTotSldAnt, ::nTotDeb, ::nTotCrd, ::nTotSldAtu, ::aTotSintCC
    // e ::aTotSintCta NAO sao reinicializados aqui: a inicializacao e UNICA, feita em
    // new().
    // Motivo: handleExeCtgGerPlan e a ultima instrucao de exeCtgGerPlan, e o
    // getNextPage reexecuta exeCtgGerPlan apos o CTBGerClean(), de modo que toda
    // reentrada por pagina passava novamente por este ponto e zerava o que ja havia
    // sido apurado. Com a acumulacao POR CHAVE (aScan + acumula na posicao encontrada,
    // aAdd apenas quando a entrada ainda nao existe), a segunda pagina soma no mesmo
    // centro de custo e na mesma chave conta|custo, em vez de reiniciar o total ou
    // criar entrada duplicada - a consolidacao passa a ser estavel entre paginas.
    ::lTotSintCalc := .T.

    // DSERCTR1-52903 (Correcao C): os totalizadores formatados (::cTotDebFmt etc.)
    // sao cache dos acumuladores gerais/de CC acima. Como esses acumuladores
    // reacumulam por pagina (mesmo motivo do ::lTotSintCalc := .T. acima), o cache
    // de rodape formatado precisa cair no MESMO ponto - senao a segunda pagina
    // exibiria o rodape formatado da primeira.
    ::lTotGerFmt := .F.
    ::cChvTotCC  := ""

    nRegTmp     := 0

    // Larguras plenas das chaves lidas do dicionario UMA UNICA VEZ, fora do laco
    // externo, para nao repetir a leitura do SX3 por registro do temporario.
    nTamCta := TamSX3("CT1_CONTA")[1]
    nTamCC  := TamSX3("CTT_CUSTO")[1]

    // Ordem 1 (CUSTO+CONTA) fixada UMA UNICA VEZ, antes da varredura, para nao
    // depender da ordem herdada e para que a travessia da cadeia SUPERIOR - que faz
    // MsSeek/dbGoto sobre o mesmo alias - nao altere a ordem no meio do laco
    // externo, o que poderia revisitar registros ja somados.
    cArqTmp->(dbSetOrder(1))
    cArqTmp->(dbGoTop())

    While !cArqTmp->(Eof())

        // Processa apenas contas ANALÍTICAS — são elas que carregam SALDOANT real
        If cArqTmp->TIPOCONTA == "2"

            // Acumulador por CC - localizacao e acumulacao POR CHAVE.
            // A entrada do centro de custo e localizada por aScan e acumulada onde
            // estiver; a criacao com aAdd ocorre apenas quando ainda nao existe.
            // Motivo: o agrupamento sequencial anterior fechava o grupo ao trocar de
            // CUSTO e pressupunha que cada CUSTO formasse um trecho CONTIGUO na
            // varredura - premissa rompida pela travessia da cadeia SUPERIOR, que
            // movimenta o ponteiro do temporario. Duas entradas para o mesmo centro
            // de custo tornariam a segunda inalcancavel pelo aScan de
            // processCustomData (que retorna a primeira ocorrencia), produzindo
            // TOT_*_CC parcial. A acumulacao por chave torna a apuracao independente
            // da ordem fisica do temporario e nunca cria entrada duplicada.
            // Este bloco roda ANTES do laco interno de travessia, portanto o ponteiro
            // do temporario ainda esta na linha analitica corrente e os acessos
            // cArqTmp->SALDO* abaixo leem exatamente o mesmo registro de antes.
            // DSERCTR1-52903 (Correcao D): localizacao por indice THashMap no lugar
            // do aScan linear. ::oIdxTotCC mapeia a MESMA chave (AllTrim(CUSTO)) para
            // a posicao em ::aTotSintCC. Comportamento de "chave nao encontrada"
            // preservado: :Get devolve .F. e nPosCC permanece 0, cai no mesmo ramo
            // Else que o aScan retornando 0 caia.
            nPosCC := 0
            If !::oIdxTotCC:Get(AllTrim(cArqTmp->CUSTO), @nPosCC)
                nPosCC := 0
            EndIf
            If nPosCC > 0
                ::aTotSintCC[nPosCC][2] += cArqTmp->SALDOANT
                ::aTotSintCC[nPosCC][3] += cArqTmp->SALDODEB
                ::aTotSintCC[nPosCC][4] += cArqTmp->SALDOCRD
                ::aTotSintCC[nPosCC][5] += cArqTmp->SALDOATU
            Else
                aAdd(::aTotSintCC, { AllTrim(cArqTmp->CUSTO),;
                                     cArqTmp->SALDOANT,;
                                     cArqTmp->SALDODEB,;
                                     cArqTmp->SALDOCRD,;
                                     cArqTmp->SALDOATU })
                ::oIdxTotCC:Set(AllTrim(cArqTmp->CUSTO), Len(::aTotSintCC))
            EndIf

            // Acumulador por conta SINTÉTICA — propaga os valores por TODA a hierarquia.
            // Chave: conta sintética + "|" + CUSTO — garante separação por CC
            // quando MV_PAR13=3 (Ambos), cada CC tem seu próprio acumulador.
            //
            // Para cada analítica, sobe a árvore de contas pela cadeia SUPERIOR já
            // gravada no próprio arquivo temporário pela CtEntCtSup, acumulando em
            // cada nível encontrado até a raiz — sem acesso à CT1. Corrige o bug
            // Em que a travessia própria sobre a CT1 rompia em
            // silêncio a partir do 2º salto e somente o 1º nível era acumulado.
            cCusto    := AllTrim(cArqTmp->CUSTO)
            cContaSup := AllTrim(cArqTmp->SUPERIOR)

            // Saldos da linha analitica corrente capturados ANTES do laco interno:
            // mesmo registro, mesmos campos, mesmo valor do acesso direto anterior.
            // Mesmo padrao de CtEntCtSup (nSaldoAnt/nSaldoDeb/nSaldoCrd/nSaldoAtu).
            nSldAnt := cArqTmp->SALDOANT
            nSldDeb := cArqTmp->SALDODEB
            nSldCrd := cArqTmp->SALDOCRD
            nSldAtu := cArqTmp->SALDOATU

            // Posicao da linha analitica e guarda contra ciclo da travessia:
            // nRegTmp e restaurado ao sair do laco interno, porque a navegacao pela
            // cadeia SUPERIOR move o ponteiro do temporario e reiniciado
            // por analitica e acumula as chaves conta|custo ja contabilizadas.
            nRegTmp    := cArqTmp->(Recno())

            While !Empty(cContaSup)
                cChaveSint := cContaSup + "|" + cCusto

                // DSERCTR1-52903 (Correcao D): idem acima, para ::aTotSintCta via
                // ::oIdxTotCta, chave conta+"|"+custo - mesma chave do aScan anterior.
                nPosCta := 0
                If !::oIdxTotCta:Get(cChaveSint, @nPosCta)
                    nPosCta := 0
                EndIf
                If nPosCta > 0
                    ::aTotSintCta[nPosCta][2] += nSldAnt
                    ::aTotSintCta[nPosCta][3] += nSldDeb
                    ::aTotSintCta[nPosCta][4] += nSldCrd
                    ::aTotSintCta[nPosCta][5] += nSldAtu
                Else
                    aAdd(::aTotSintCta, { cChaveSint,;
                                          nSldAnt,;
                                          nSldDeb,;
                                          nSldCrd,;
                                          nSldAtu })
                    ::oIdxTotCta:Set(cChaveSint, Len(::aTotSintCta))
                EndIf

                // Sobe um nivel lendo o campo SUPERIOR da linha do nivel corrente no
                // proprio temporario - a cadeia completa de ancestrais foi gravada ali
                // pela CtEntCtSup no append de cada nivel sintetico. A ordem 1
                // (CUSTO+CONTA) ja esta fixada antes da varredura e a chave e montada
                // em largura plena - mesmo contrato do MsSeek(cEntidG+cContaSup) da
                // CtEntCtSup.
                // Quando o MsSeek nao posiciona, o encerramento e legitimo: o framework
                // nao consolidou aquele nivel (nivel fora da faixa, ou raiz da arvore).
                If cArqTmp->(MsSeek(PadR(cCusto, nTamCC) + PadR(cContaSup, nTamCta)))
                    cContaSup := AllTrim(cArqTmp->SUPERIOR)
                Else
                    cContaSup := ""
                EndIf
            EndDo

            // Restaura a posicao da linha analitica antes de qualquer leitura
            // subsequente de cArqTmp (o total geral abaixo) e antes do dbSkip() do
            // laco externo. Vale para todos os caminhos de saida do laco interno,
            // inclusive a saida pela guarda contra ciclo. Mesmo padrao de
            // CtEntCtSup / Ctb3CtaSup.
            cArqTmp->(dbGoto(nRegTmp))

            //Total geral: acumula apenas CC analítico (TIPOCC="2")
            // Espelha o critério do SldCCusto do CTBR180
            If cArqTmp->TIPOCC == "2"
                ::nTotSldAnt += cArqTmp->SALDOANT
                ::nTotDeb    += cArqTmp->SALDODEB
                ::nTotCrd    += cArqTmp->SALDOCRD
                ::nTotSldAtu += cArqTmp->SALDOATU
            EndIf

        EndIf

        cArqTmp->(dbSkip())
    EndDo

    cArqTmp->(dbGoTop())

    // Inicializa backups de grupo/custo com o primeiro registro válido
    If !cArqTmp->(Eof())
        ::cGrupoBkpCC := cArqTmp->GRUPO
        ::cCustoBkpCC := cArqTmp->CUSTO
    EndIf

return self:oData

//-------------------------------------------------------------------
/*/{Protheus.doc} handleCtgGerPlanAppend
