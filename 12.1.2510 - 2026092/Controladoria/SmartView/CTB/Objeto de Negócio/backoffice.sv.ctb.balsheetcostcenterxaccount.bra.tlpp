//-------------------------------------------------------------------
/*{Protheus.doc} processCustomData
Utilizado antes do append no data
 
@return object: self:oData
 
@author Ewerton Franklin
@since 11/12/2024
@version 1.0
*/
//-------------------------------------------------------------------

method processCustomData() as json class BalanceSheetCostCenterxAccountSmartViewBusinessObject

    Local nRecnoLook       as numeric
    Local cGrupoLook       as character
    Local cCustoLook       as character
    Local cGrupoAtual      as character
    Local cCustoAtual      as character
    Local lSeraPulado      as logical
    Local lTrocaGrp        as logical
    Local lTrocaCC         as logical
    Local nPosCC           as numeric
    Local nPosCta          as numeric
    Local cChaveSint       as character  // chave conta+custo para lookup em aTotSintCta
    Local nSldAntLinha     as numeric    // saldo anterior calculado para a linha atual
    Local nSldDebLinha     as numeric
    Local nSldCrdLinha     as numeric
    Local nSldAtuLinha     as numeric
    Local nMovLinha        as numeric
    Local TAM_VALOR        := 17 as numeric
    Local nDecimais        as numeric
    Local cPicture         as character
    Local cChvCC           as character  // chave do cache de totalizadores de CC: CUSTO+"|"+CCNORMAL

    lTrocaGrp := .F.
    lTrocaCC  := .F.

    // DSERCTR1-52903 (Correcao A): nDecimais/cPicture sao invariantes da execucao
    // (::aSetOfBook e mv_par10 fixados em handleCtgGerPlanParams, antes do laco).
    // Le o cache calculado uma unica vez, em vez de recalcular por linha - a
    // expressao cacheada e verbatim (ver ::nDecCache/::cPictVlr em
    // handleCtgGerPlanParams).
    nDecimais  := ::nDecCache
    cPicture   := ::cPictVlr

    //Totais de CC (rodapé por centro de custo)
    // DSERCTR1-52903 (Correcao D): localizacao por indice THashMap no lugar do
    // aScan linear - mesma chave (AllTrim(CUSTO)), mesmo comportamento de "chave
    // nao encontrada" (zera os totais de CC no ramo Else).
    nPosCC := 0
    If !::oIdxTotCC:Get(AllTrim(cArqTmp->CUSTO), @nPosCC)
        nPosCC := 0
    EndIf
    If nPosCC > 0
        ::nTotSldAntCC := ::aTotSintCC[nPosCC][2]
        ::nTotDebCC    := ::aTotSintCC[nPosCC][3]
        ::nTotCrdCC    := ::aTotSintCC[nPosCC][4]
        ::nTotSldAtuCC := ::aTotSintCC[nPosCC][5]
    Else
        ::nTotSldAntCC := 0
        ::nTotDebCC    := 0
        ::nTotCrdCC    := 0
        ::nTotSldAtuCC := 0
    EndIf

    self:nTotMov   := (self:nTotCrd - self:nTotDeb)
    self:nTotMovCC := (self:nTotCrdCC - self:nTotDebCC)

    // DSERCTR1-52903 (Correcao C): os 5 totalizadores GERAIS sao invariantes da
    // pagina - ::nTotDeb/::nTotCrd/::nTotSldAtu/::nTotSldAnt sao fechados em
    // handleExeCtgGerPlan, ANTES do laco, e nunca alterados dentro dele; ::nTotMov
    // deriva de operandos constantes, logo tambem e constante na pagina. Formata
    // uma unica vez por pagina (guarda ::lTotGerFmt, invalidada no mesmo ponto de
    // ::lTotSintCalc em handleExeCtgGerPlan) em vez de a cada uma das 2.816 linhas.
    If !::lTotGerFmt
        ::cTotDebFmt := self:RetValorCtb(self:nTotDeb,  .F., "1")
        ::cTotCrdFmt := self:RetValorCtb(self:nTotCrd,  .F., "2")
        ::cTotAtuFmt := self:RetValorCtb(self:nTotSldAtu)
        ::cTotAntFmt := self:RetValorCtb(self:nTotSldAnt)
        ::cTotMovFmt := self:RetValorCtb(self:nTotMov)
        ::lTotGerFmt := .T.
    EndIf
    ::jDados["TOT_DEBITO" ]  := ::cTotDebFmt
    ::jDados["TOT_CREDITO"]  := ::cTotCrdFmt
    ::jDados["TOT_SALDOATU"] := ::cTotAtuFmt
    ::jDados["TOT_SALDOANT"] := ::cTotAntFmt
    ::jDados["TOT_MOV" ]     := ::cTotMovFmt

    // DSERCTR1-52903 (Correcao C): os 5 totalizadores de CC mudam somente quando o
    // centro de custo muda. Chave inclui CCNORMAL porque ele e o 3o argumento de
    // 3 das 5 chamadas de RetValorCtb abaixo.
    cChvCC := AllTrim(cArqTmp->CUSTO) + "|" + cArqTmp->CCNORMAL
    If ::cChvTotCC <> cChvCC
        ::cTotDebCCFmt := self:RetValorCtb(self:nTotDebCC,    .F., "1")
        ::cTotCrdCCFmt := self:RetValorCtb(self:nTotCrdCC,    .F., "2")
        ::cTotAtuCCFmt := self:RetValorCtb(self:nTotSldAtuCC, .T., cArqTmp->CCNORMAL)
        ::cTotAntCCFmt := self:RetValorCtb(self:nTotSldAntCC, .T., cArqTmp->CCNORMAL)
        ::cTotMovCCFmt := self:RetValorCtb(self:nTotMovCC,    .T., cArqTmp->CCNORMAL)
        ::cChvTotCC    := cChvCC
    EndIf
    ::jDados["TOT_DEBITO_CC"]   := ::cTotDebCCFmt
    ::jDados["TOT_CREDITO_CC"]  := ::cTotCrdCCFmt
    ::jDados["TOT_SALDOATU_CC"] := ::cTotAtuCCFmt
    ::jDados["TOT_SALDOANT_CC"] := ::cTotAntCCFmt
    ::jDados["TOT_MOV_CC"]      := ::cTotMovCCFmt

    //Saldo anterior / atual das linhas SINTÉTICAS de conta
    If cArqTmp->TIPOCONTA == "1"
        cChaveSint := AllTrim(cArqTmp->CONTA) + "|" + AllTrim(cArqTmp->CUSTO)
        // DSERCTR1-52903 (Correcao D): localizacao por indice THashMap no lugar do
        // aScan linear - mesma chave, mesmo comportamento de "chave nao encontrada".
        nPosCta := 0
        If !::oIdxTotCta:Get(cChaveSint, @nPosCta)
            nPosCta := 0
        EndIf
        If nPosCta > 0
            nSldAntLinha := ::aTotSintCta[nPosCta][2]
            nSldDebLinha := ::aTotSintCta[nPosCta][3]
            nSldCrdLinha := ::aTotSintCta[nPosCta][4]
            nSldAtuLinha := ::aTotSintCta[nPosCta][5]
        Else
            nSldAntLinha := 0
            nSldDebLinha := 0
            nSldCrdLinha := 0
            nSldAtuLinha := 0
        EndIf
        nMovLinha := nSldCrdLinha - nSldDebLinha

        // Sobrescreve os campos numéricos e as máscaras no jDados
        ::jDados["SALDOANT"]     := nSldAntLinha
        ::jDados["SALDOANT_M"]   := ValorCTB(nSldAntLinha,,,TAM_VALOR-2,nDecimais,.T.,cPicture,cArqTmp->NORMAL,,,,,,::lPrintZero,.F.)
        ::jDados["SALDOANTDB"]   := 0
        ::jDados["SALDOANTDB_M"] := ValorCTB(0,,,TAM_VALOR-2,nDecimais,.T.,cPicture,cArqTmp->NORMAL,,,,,,::lPrintZero,.F.)
        ::jDados["SALDOANTCR"]   := 0
        ::jDados["SALDOANTCR_M"] := ValorCTB(0,,,TAM_VALOR-2,nDecimais,.T.,cPicture,cArqTmp->NORMAL,,,,,,::lPrintZero,.F.)
        ::jDados["SALDODEB"]     := nSldDebLinha
        ::jDados["SALDODEB_M"]   := ValorCTB(nSldDebLinha,,,TAM_VALOR,nDecimais,.F.,cPicture,"1",,,,,,::lPrintZero,.F.)
        ::jDados["SALDOCRD"]     := nSldCrdLinha
        ::jDados["SALDOCRD_M"]   := ValorCTB(nSldCrdLinha,,,TAM_VALOR-2,nDecimais,.T.,cPicture,"2",,,,,,::lPrintZero,.F.)
        ::jDados["SALDOATU"]     := nSldAtuLinha
        ::jDados["SALDOATU_M"]   := ValorCTB(nSldAtuLinha,,,TAM_VALOR-2,nDecimais,.T.,cPicture,cArqTmp->NORMAL,,,,,,::lPrintZero,.F.)
        ::jDados["SALDOADB"]     := 0
        ::jDados["SALDOADB_M"]   := ValorCTB(0,,,TAM_VALOR-2,nDecimais,.T.,cPicture,cArqTmp->NORMAL,,,,,,::lPrintZero,.F.)
        ::jDados["SALDOACR"]     := 0
        ::jDados["SALDOACR_M"]   := ValorCTB(0,,,TAM_VALOR-2,nDecimais,.T.,cPicture,cArqTmp->NORMAL,,,,,,::lPrintZero,.F.)
        ::jDados["MOVIMENTO"]    := nMovLinha
        ::jDados["MOVIMENTO_M"]  := ValorCTB(nMovLinha,,,TAM_VALOR-2,nDecimais,.T.,cPicture,cArqTmp->NORMAL,,,,,,::lPrintZero,.F.)
    EndIf

    //Dados empresa e filial logada????
    ::jDados["NomeEmpresa"] := ::cCompanyName
    ::jDados["NomeFilial" ] := ::cBranchName

    //Lookahead: detecta troca de CC e Grupo para LTROCACC e LTROCAGRP ?
    // Avança no arquivo temporário para encontrar o próximo registro que seria
    // impresso (respeitando os filtros de ExecImpSint e ExecDBSkipTemp), e compara
    // CC e Grupo com o registro atual para sinalizar quebra de grupo/CC no TReports.
    nRecnoLook  := cArqTmp->(Recno())
    cGrupoAtual := AllTrim(cArqTmp->GRUPO)
    cCustoAtual := AllTrim(cArqTmp->CUSTO)
    cGrupoLook  := cGrupoAtual
    cCustoLook  := cCustoAtual

    cArqTmp->(DbSkip())
    If cArqTmp->(Eof())
        // Último registro imprimível: força ambos .T. para garantir que o total
        // de CC e/ou grupo seja impresso no design — equivalente ao fim do loop
        // While !Eof() do CTBR180, onde cCCAnt <> cArqTmp->CUSTO é sempre .T. ao sair.
        lTrocaGrp := .T.
        lTrocaCC  := .T.
    Else
        While !cArqTmp->(Eof())
            lSeraPulado := .F.
            // Verifica filtro de sintética de conta (mesmo critério do loop principal)
            If !::lImpSint .And. self:ExecImpSint(::cArqAux)
                lSeraPulado := .T.
            EndIf
            // Verifica filtro geral de linha (MV_PAR07, MV_PAR33, segmento etc.)
            If !lSeraPulado .And. !self:ExecDBSkipTemp(::cArqAux)
                lSeraPulado := .T.
            EndIf
            If !lSeraPulado
                cGrupoLook := AllTrim(cArqTmp->GRUPO)
                cCustoLook := AllTrim(cArqTmp->CUSTO)
                Exit
            EndIf
            cArqTmp->(DbSkip())
        EndDo
        If cArqTmp->(Eof())
            // Todos os próximos seriam pulados: mesmo efeito de fim de arquivo,
            // força total de CC e grupo no registro atual.
            lTrocaGrp := .T.
            lTrocaCC  := .T.
        Else
            If cGrupoAtual <> cGrupoLook
                lTrocaGrp := .T.
            EndIf
            If cCustoAtual <> cCustoLook
                lTrocaCC := .T.
            EndIf
        EndIf
    EndIf
    cArqTmp->(dbGoto(nRecnoLook))

    ::jDados["LTROCAGRP"] := lTrocaGrp
    ::jDados["LTROCACC"]  := lTrocaCC

    If lTrocaGrp
        ::lHouveTrocaGrp := .T.
    EndIf
    If lTrocaCC
        ::lHouveTrocaCC := .T.
    EndIf
    ::cGrupoBkpCC := cGrupoAtual
    ::cCustoBkpCC := cCustoAtual

return ::jDados

//-------------------------------------------------------------------
/*{Protheus.doc} vldExeCtgGerPlan
Método para validar se deve executar a chamada da funcao CtGerPlan()
 
@param cArqTmp, caracter, indica o alias do arquivo temporário
 
@return lógico
 
@author Bruno Oliveira
@since 16/04/2024
@version 1.0
*/
//-------------------------------------------------------------------

method vldExeCtgGerPlan() class BalanceSheetCostCenterxAccountSmartViewBusinessObject
    Local lRet := .T. as Logical
    Local aCtbMoeda := {} as Array

    if !Empty( mv_par08 )
    	lRet := VdSetOfBook( mv_par08 , .F. ) // codigo do livro , visao gerencial
	endif

    //Valida se a moeda é valida!
    aCtbMoeda  	:= CtbMoeda(mv_par10,self:nDivide)
    If Empty(aCtbMoeda[1])
        lRet := .F.
    Endif
Return lRet

//-------------------------------------------------------------------
/*{Protheus.doc} ExecDBSkipTemp
Método para pular linha
 
@param cArqTmp, caracter, indica o alias do arquivo temporário
 
@return lógico
 
@author Bruno Oliveira
@since 16/11/2023
@version 1.0
*/
//-------------------------------------------------------------------

method ExecDBSkipTemp(cArqTmp As character) class BalanceSheetCostCenterxAccountSmartViewBusinessObject

    Local lRet          := .T. as Logical
    Local lVlrZerado    := Iif(mv_par09==1,.T.,.F.) as Logical

    Local nDigitAte     := 0 as Numeric
    Local nDigCCAte     := 0 as Numeric

    // DSERCTR1-52903 (Correcao B): ::cMascCta/::cMascCC ja foram calculadas uma
    // unica vez em handleCtgGerPlanParams (mesma expressao verbatim que estava
    // aqui: CTBSetOf(mv_par08) + fallback de mascara), em vez de recalcular
    // CTBSetOf e RetMasCtb a cada uma das 5.631 chamadas deste metodo.

    //Filtro CC sintética/analítica (mv_par33)
    If mv_par33 == 1					// So imprime Sinteticas de CC
        lRet := cArqTmp->TIPOCC <> "2"
    ElseIf mv_par33 == 2				// So imprime Analiticas de CC
        lRet := cArqTmp->TIPOCC <> "1"
    EndIf

    //Filtro de Conta sintética/analítica (mv_par07)?
    // Equivalente ao f180Fil do CTBR180
    If mv_par07 == 1                        // So imprime Sinteticas
        If cArqTmp->TIPOCONTA == "2"        // Pula analiticas
            lRet := .F.
        EndIf
    ElseIf mv_par07 == 2                    // So imprime Analiticas
        If cArqTmp->TIPOCONTA == "1"        // Pula sinteticas
            lRet := .F.
        EndIf
    EndIf

    //Filtro de saldo zerado
    // Idêntico ao CTBR180 (ReportPrint): lê SALDOANT/SALDODEB/SALDOCRD/SALDOATU
    // direto do temporário, tanto para analíticas quanto para sintéticas.
    // A CTGerPlan com lImpSint=.T. já consolida os saldos das filhas nas sintéticas
    // antes de gravar no temporário, portanto os campos refletem o valor real.
    // O aTotSintCta é usado apenas em processCustomData para exibição no JSON,
    // não deve interferir na decisão de pular/imprimir a linha.
    If lRet
        IF ( MV_PAR07 == 3 .Or. ( ( MV_PAR07 == 1 .And. cArqTmp->TIPOCONTA == '1' ) .Or. ( MV_PAR07 == 2 .And. cArqTmp->TIPOCONTA == '2' ) ) )
            If !lVlrZerado .And. cArqTmp->SALDOANT == 0 .And. cArqTmp->SALDODEB == 0 .And. cArqTmp->SALDOCRD == 0 .And. cArqTmp->SALDOATU == 0
                lRet := .F.
            EndIf
        EndIf
    EndIf

    //Filtragem ate o Segmento da Conta( antigo nivel do SIGACON)
    If !Empty(mv_par14)
        nDigitAte := CtbRelDig(mv_par14,::cMascCta)
        If Len(Alltrim(cArqTmp->CONTA)) > nDigitAte
            lRet := .T.
        else
            lRet := .F.
        Endif
    EndIf

    //Filtragem ate o Segmento do CC( antigo nivel do SIGACON)
    If !Empty(mv_par28)
        nDigCCAte := CtbRelDig(mv_par28,::cMascCC)
        lRet := iif(Len(Alltrim(cArqTmp->CUSTO)) > nDigCCAte, .T., .F.)
    EndIf

return lRet

//-------------------------------------------------------------------
/*/{Protheus.doc} handleCtgGerPlanParams
    Metodo handleCtgGerPlanParams
    
    @author Controladoria
    @since 09/11/2023
    @version 12.1.2310
/*/
//-------------------------------------------------------------------

method handleCtgGerPlanParams( oFilter as object) class BalanceSheetCostCenterxAccountSmartViewBusinessObject
local lMov           as logical
local lImpAntLP      as logical
local aSetOfBook     as array
local cContaIni      as character
local cContaFim      as character
local dDataIni       as date
local dDataFim       as date
local dDataLP        as date
local cCusIni        as character
local cCusFim        as character
local cMoeda  :="01" as character
local cTpsald :="1"  as character
local cFilSeg        as character
local cConteudIni    as character
local cConteudFim    as character
local cConteudCont   as character
local lVlrZerado     as logical
local aSelFil        as array
local lPrintZero     as logical
local lImpSint       as logical
local lCttSint       as logical
local lRecDesp0		 as logical 
local cRecDesp		 as character 
local dDtZeraRD		 as date
local nDivide		 as numeric
local nGrupo		 as numeric
// DSERCTR1-52903 (Correcao B): separadores de mascara, exigidos por RetMasCtb por
// referencia (@). Sao descartados apos o calculo - o que importa e a mascara.
local cSepCta        as character
local cSepCC         as character
    
    ::oIntegratedProvider:lMultSelectBranches := .T.
    ::oIntegratedProvider:lAllowBranchFilter  := .T.
    ::oIntegratedProvider:setBranchPar(self:jParams)
    ::oIntegratedProvider:loadFilterBranches({"CT2"})

    If Valtype(::oIntegratedProvider:oFilterBranches["CT2"][1]) == "A"
        aSelFil := ::oIntegratedProvider:oFilterBranches["CT2"][1]
    Else
        aSelFil := ::oIntegratedProvider:oFilterBranches["CT2"]
    EndIf

    ::oIntegratedProvider:setStep(10000) //Seta o step da paginação

    dDataIni    := MV_PAR01                                                         //  	Data Inicial ?                	      	               	               	               
    dDataFim    := MV_PAR02                                                         //  	Data Final ?                  	      	               	               	               
    cContaIni   := MV_PAR03                                                         //  	Conta Inicial ?               	CT1   	               	               	               
    cContaFim   := MV_PAR04                                                         //  	Conta Final ?                 	CT1   	               	               	               
    cCusIni     := MV_PAR05                                                         //  	Do Centro de Custo ?          	CTT   	               	               	               
    cCusFim     := MV_PAR06                                                         //  	Ate Centro de Custo ?         	CTT   	               	               	               
    lImpSint    := IIf(MV_PAR07 == 1 .Or. MV_PAR07 == 3, .T., .F.)                  //      Imprime Contas ? (Valida sintética)
    aSetOfBook  := iIf(!Empty(MV_PAR08),CTBSetOf(MV_PAR08),CTBSetOf())              //  	Cod. Config. Livros ?         	CTN   	               	               	               
    lVlrZerado  := iIf(MV_PAR09==1,.T.,.F.)                                         //  	Saldos Zerados ?              	      	Sim            	Nao            	               
    cMoeda      := Iif(Empty(MV_PAR10),cMoeda,MV_PAR10)                             //  	Moeda ?                       	CTO   	               	               	               
    cTpsald     := Iif(Empty(MV_PAR12),cTpsald,PadR(AllTrim(MV_PAR12), TamSX3("CT2_TPSALD")[1]))                            //  	Tipo de Saldo ?               	SLD   	               	               	               
    nGrupo      := MV_PAR13
    cFilSeg     := MV_PAR15                                                         //    	Filtra Segmento No. ?         
    cConteudIni := MV_PAR16                                                         //    	Conteudo Ini Segmen ?         
    cConteudFim := MV_PAR17                                                         //    	Conteudo Fim Segmen ?         
    cConteudCont:= MV_PAR18                                                         //    	Conteudo Contido em ?         
    lMov        := iIf(MV_PAR19==1,.T.,.F.)                                         //  	Imprime Coluna Mov. ?         	      	Sim            	Nao            	               
    lPrintZero  := iIf(MV_PAR22==1,.T.,.F.)                                         //  	Imprime Valor 0.00 ?          	      	Sim            	Nao            	               
    nDivide     := MV_PAR24 	                                                    //      Divide por ?
	lImpAntLP   := iIf(MV_PAR26==1,.T.,.F.)                                         //     	Posicao Ant. L/P ?            	      	Sim            	Nao            	               
    dDataLP     := MV_PAR27                                                         //     	Data Lucros/Perdas ?          	CTZ   	               	               	               
    lCttSint    := Iif(MV_PAR33 == 1 .or. MV_PAR33 == 3,.T.,.F.)
    lRecDesp0	:= Iif(MV_PAR34==1,.T.,.F.)                                         //     	Ignora Sl Ant.Rec/Des ?       	      	Sim            	Nao
    cRecDesp	:= MV_PAR35                                                         //     	Grupo Receitas/Desp. ?        	      	               	   
    dDtZeraRD	:= MV_PAR36                                                         //     	Data Sld Ant.Rec/Desp ?       	      	               	                                                           

    //Setando os atributos
    self:dDataIni       := dDataIni
    self:dDataFim       := dDataFim
    self:cAlias         := "CT3"//são obrigatórios
    self:cIdent         := ""//são obrigatórios   
    self:cContaIni      := cContaIni
    self:cContaFim      := cContaFim
    self:cCCIni         := cCusIni
    self:cCCFim         := cCusFim
    self:cMoeda         := cMoeda
    self:cSaldos        := cTpsald
    self:aSetOfBook     := aSetOfBook
    self:cSegmento      := cFilSeg     
    self:cSegIni        := cConteudIni 
    self:cSegFim        := cConteudFim 
    self:cFiltSegm      := cConteudCont
    self:lNImpMov       := !lMov
    self:lImpConta      := .T.
    self:lImpAntLP      := lImpAntLP     
    self:dDataLP        := dDataLP  
    self:nDivide        := nDivide
    self:lVlrZerado     := lVlrZerado
    self:nGrupo         := nGrupo
    self:cHeader        := "CTT"
    self:lRecDesp0      := lRecDesp0
    self:cRecDesp       := cRecDesp 
    self:dDtZeraRD      := dDtZeraRD
    self:aSelFil        := aSelFil
    self:lCttSint       := lCttSint
    self:lImpSint       := lImpSint
    self:lPrintZero     := lPrintZero
    self:lPageControl   := .T.

    // DSERCTR1-52903 (Correcao A): nDecimais/cPicture sao invariantes desta
    // execucao - ::aSetOfBook e MV_PAR10 ja estao fixados neste ponto e nao mudam
    // durante o laco. Calculadas uma unica vez aqui, espelhando o CTBR180
    // (ctbr180.prw:173), em vez de recalcular por linha e por valor formatado em
    // processCustomData e RetValorCtb.
    // Usa MV_PAR10 literal, NAO ::cMoeda: em cMoeda := Iif(Empty(MV_PAR10),"01",MV_PAR10)
    // acima, ::cMoeda diverge de MV_PAR10 quando MV_PAR10 esta vazio, e DecimalCTB
    // faz MsSeek(xFilial()+cMoeda) na CTO - trocar por ::cMoeda mudaria o resultado
    // nesse cenario. Preservar MV_PAR10 mantem a equivalencia byte a byte com a
    // expressao original.
    ::nDecCache := DecimalCTB(::aSetOfBook, mv_par10)
    If !Empty(::aSetOfBook[4])
        ::cPictVlr := "@E 999,999,999,999.99"
    Else
        ::cPictVlr := ""
    EndIf

    // DSERCTR1-52903 (Correcao B): ::aSetOfBkFil cacheia CTBSetOf(mv_par08)
    // VERBATIM - a MESMA expressao que estava em ExecDBSkipTemp (linha original
    // 660), calculada 1x em vez de a cada chamada de ExecDBSkipTemp (5.631x).
    // NAO reusa ::aSetOfBook: ::aSetOfBook (acima) vem de
    // iIf(!Empty(MV_PAR08),CTBSetOf(MV_PAR08),CTBSetOf()), enquanto ExecDBSkipTemp
    // sempre chamava CTBSetOf(mv_par08) sem o iIf - os dois caminhos passam
    // argumentos diferentes (Nil vs "") para o Padr() interno quando MV_PAR08 esta
    // vazio. Cachear a expressao original em um data proprio garante equivalencia
    // por construcao, sem depender de inferir que os dois caminhos convergem.
    ::aSetOfBkFil := CTBSetOf(mv_par08)

    If Empty(::aSetOfBkFil[2])
        ::cMascCta := ::cMvMasc
    Else
        ::cMascCta := RetMasCtb(::aSetOfBkFil[2], @cSepCta)
    EndIf

    If Empty(::aSetOfBkFil[6])
        ::cMascCC := ::cMvCus
    Else
        ::cMascCC := RetMasCtb(::aSetOfBkFil[6], @cSepCC)
    EndIf

return 

//-------------------------------------------------------------------
/*{Protheus.doc} RetValorCtb
Retorna Mascara

@return character

@author Ewerton Franklin
@since 09/11/2023
@version 1.0*/
//-------------------------------------------------------------------

method RetValorCtb(nValCtb as numeric, lSinal as Logical, cNormal as character) as character class BalanceSheetCostCenterxAccountSmartViewBusinessObject

Local cPicture as character
Local cTipo   as character
Local TAM_VALOR := 17 as numeric
Local nDecimais as numeric

// DSERCTR1-52903 (Correcao A): le o cache calculado uma unica vez em
// handleCtgGerPlanParams, em vez de recalcular DecimalCTB/picture a cada uma das
// 28.160 chamadas de RetValorCtb.
nDecimais := ::nDecCache
cPicture := ::cPictVlr

DEFAULT nValCtb := 0
DEFAULT lSinal  := .T.
DEFAULT cNormal := ""

::cValorCtb := "0"

If !Empty(cNormal)
    cTipo := cNormal
ElseIf nValCtb <= 0
    cTipo := "1"
Else
    cTipo := "2"
EndIf

::cValorCtb := ValorCTB(nValCtb,,,TAM_VALOR,nDecimais,lSinal,cPicture,cTipo,,,,,,::lPrintZero,.F.)

Return ::cValorCtb
