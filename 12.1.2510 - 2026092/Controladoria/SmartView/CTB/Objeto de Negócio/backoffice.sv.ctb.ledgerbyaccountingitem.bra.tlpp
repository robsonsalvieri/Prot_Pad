*/
//------------------------------------------------------------------- 

method processData() as json class ledgerbyaccountingitemSmartViewBusinessObject
return ::jDados

//-------------------------------------------------------------------
/*{Protheus.doc} processCustomData
Método de instância da classe. Calcula saldo e enriquece o jDados por linha.
Usa cache de saldos (jSaldoCache) pre-carregado por loadSaldoCache() para evitar
chamar SaldTotCT4 por linha — corrige N+1 identificado em DSERCTR1-52515.
 
@return object: string
 
@author Ednilson Queiroz de Castro
@since 10/11/2023
@version 1.0
*/
//------------------------------------------------------------------- 

method processCustomData() as json class ledgerbyaccountingitemSmartViewBusinessObject
    
    local cMoedaDesc    as character
    local cDescItem     as character
    Local cPicture      as character 
    Local nSaldoAnt     as Numeric
    Local nDecimais 	as numeric
    Local TAM_VALOR := 17 as Numeric

    //Carrega os valores default    
    cMoedaDesc  := ::cMoeda
    cDescItem   := " "

    cPicture    := ::aSetOfBook[4]
    nDecimais   := DecimalCTB(::aSetOfBook, ::cMoeda)
  
    If CTD->(dbSeek(FWxFilial("CTD")+cArqTMP->ITEM))
        cDescItem := &("CTD->CTD_DESC" + cMoedaDesc)
    Endif

    //Se trocou item, busca saldo usando cache (evita SaldTotCT4 por linha)
    if cArqTmp->ITEM <> ::cItemAnt
        //Lazy init: carrega o cache na primeira troca de item — cArqTmp ja existe aqui.
        //NAO pode ser feito antes pois cArqTmp e criado por exeCtgGerRaz, chamado apos getCtgGerRazData.
        if ::jSaldoCache == Nil
            self:loadSaldoCache()
        endif
        //Cache guarda apenas aSaldoAnt (invariante por item).
        //aSaldo (saldo ate DATAL do lancamento) sempre calculado por linha — garante valor correto.
        if ::jSaldoCache != Nil .and. ::jSaldoCache:HasProperty(AllTrim(cArqTMP->ITEM)+"_ANT")
            //Saldo anterior: usa cache (1 chamada/item, nao por linha)
            ::aSaldoAnt := ::jSaldoCache:GetJsonObject(AllTrim(cArqTMP->ITEM)+"_ANT")
        else
            //Fallback: item nao esta no cache — calcula diretamente e cacheia
            ::aSaldoAnt := SaldTotCT4(cArqTMP->ITEM,cArqTMP->ITEM,::cCustoIni,::cCustoFim,::cContaIni,::cContaFim,::dDataIni,::cMoeda,::cSaldo,::aSelFil)
            if ::jSaldoCache != Nil
                ::jSaldoCache[AllTrim(cArqTMP->ITEM)+"_ANT"] := ::aSaldoAnt
            endif
        endif
        //aSaldo (saldo ate DATAL): sempre calculado — data varia por lancamento
        ::aSaldo := SaldTotCT4(cArqTMP->ITEM,cArqTMP->ITEM,::cCustoIni,::cCustoFim,::cContaIni,::cContaFim,cArqTmp->DATAL,::cMoeda,::cSaldo,::aSelFil)
        ::nSaldoAtu := ::aSaldoAnt[6]
        nSaldoAnt   := ::aSaldo[6]
    endif
    nSaldoAnt := ::nSaldoAtu
    ::nSaldoAtu := ::nSaldoAtu - cArqTmp->LANCDEB + cArqTmp->LANCCRD

    //Manipulação de conteúdo do json
    ::jDados["LANCDEB_M"]  := ValorCTB(cArqTmp->LANCDEB,,,TAM_VALOR,nDecimais,.F.,cPicture,"1",,,,,,::lPrintZero,.F.,.T.)
    ::jDados["LANCCRD_M"]  := ValorCTB(cArqTmp->LANCCRD,,,TAM_VALOR,nDecimais,.F.,cPicture,"2",,,,,,::lPrintZero,.F.,.T.)
    ::jDados["SALDANT"]    := nSaldoAnt
    ::jDados["TPSLDANT"]   := ValorCTB(nSaldoAnt,,,TAM_VALOR,nDecimais,.T.,cPicture,"",,,,,,::lPrintZero,.F.)
    ::jDados["SALDOSCR"]   := ::nSaldoAtu
    ::jDados["TPSLDATU"]   := ValorCTB(::nSaldoAtu,,,TAM_VALOR,nDecimais,.T.,cPicture,"",,,,,,::lPrintZero,.F.)
    ::jDados["DESCITEM"]   := cDescItem
    ::jDados["NomeEmpresa"]:= ::cCompanyName
    ::jDados["NomeFilial" ]:= ::cBranchName
    ::cItemAnt := cArqTmp->ITEM

return

