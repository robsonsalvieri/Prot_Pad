//-------------------------------------------------------------------
/*{Protheus.doc} processCustomData
Método de instância da classe
 
@return object: string
 
@author Renan Gremes
@since 09/11/2023
@version 1.0
*/
//------------------------------------------------------------------- 

method processCustomData() as json class Accountx12MonthsSmartViewBusinessObject
    Local cPicture  := ""  as character
    Local cNormal   := ""  as character
    Local cGrupoBkp := "" as character
    Local lSoma     := .F. as logical
    Local nDecimais       as numeric

    cPicture  := Iif(!Empty(::aSetOfBook[4]),"@E 999,999,999,999.99","")
    nDecimais := DecimalCTB(::aSetOfBook,::cMoeda)
    cNormal   := cArqTmp->NORMAL
    cGrupoBkp := cArqTMP->GRUPO

    ::JItens["NomeEmpresa"]  := self:cCompanyName
    ::JItens["NomeFilial" ]  := self:cBranchName

    ::JItens["TOTALPERIODO"] := AllTrim(ValorCTB(cArqTmp->(COLUNA1+COLUNA2+COLUNA3+;
	                                              COLUNA4+COLUNA5+COLUNA6+;
	                                              COLUNA7+COLUNA8+COLUNA9+;
	                                              COLUNA10+COLUNA11+COLUNA12),,,20-2,nDecimais,.T.,cPicture,cNormal, , , , , ,::lPrintZero,.F.))

    // Sobrescreve as colunas mascaradas com AllTrim para evitar quebra na grid
    ::JItens["COLUNA1_M" ] := AllTrim(ValorCTB(cArqTmp->COLUNA1 ,,,::aTamVal[1],nDecimais,.T.,cPicture,cNormal, , , , , ,::lPrintZero,.F.))
    ::JItens["COLUNA2_M" ] := AllTrim(ValorCTB(cArqTmp->COLUNA2 ,,,::aTamVal[1],nDecimais,.T.,cPicture,cNormal, , , , , ,::lPrintZero,.F.))
    ::JItens["COLUNA3_M" ] := AllTrim(ValorCTB(cArqTmp->COLUNA3 ,,,::aTamVal[1],nDecimais,.T.,cPicture,cNormal, , , , , ,::lPrintZero,.F.))
    ::JItens["COLUNA4_M" ] := AllTrim(ValorCTB(cArqTmp->COLUNA4 ,,,::aTamVal[1],nDecimais,.T.,cPicture,cNormal, , , , , ,::lPrintZero,.F.))
    ::JItens["COLUNA5_M" ] := AllTrim(ValorCTB(cArqTmp->COLUNA5 ,,,::aTamVal[1],nDecimais,.T.,cPicture,cNormal, , , , , ,::lPrintZero,.F.))
    ::JItens["COLUNA6_M" ] := AllTrim(ValorCTB(cArqTmp->COLUNA6 ,,,::aTamVal[1],nDecimais,.T.,cPicture,cNormal, , , , , ,::lPrintZero,.F.))
    ::JItens["COLUNA7_M" ] := AllTrim(ValorCTB(cArqTmp->COLUNA7 ,,,::aTamVal[1],nDecimais,.T.,cPicture,cNormal, , , , , ,::lPrintZero,.F.))
    ::JItens["COLUNA8_M" ] := AllTrim(ValorCTB(cArqTmp->COLUNA8 ,,,::aTamVal[1],nDecimais,.T.,cPicture,cNormal, , , , , ,::lPrintZero,.F.))
    ::JItens["COLUNA9_M" ] := AllTrim(ValorCTB(cArqTmp->COLUNA9 ,,,::aTamVal[1],nDecimais,.T.,cPicture,cNormal, , , , , ,::lPrintZero,.F.))
    ::JItens["COLUNA10_M"] := AllTrim(ValorCTB(cArqTmp->COLUNA10,,,::aTamVal[1],nDecimais,.T.,cPicture,cNormal, , , , , ,::lPrintZero,.F.))
    ::JItens["COLUNA11_M"] := AllTrim(ValorCTB(cArqTmp->COLUNA11,,,::aTamVal[1],nDecimais,.T.,cPicture,cNormal, , , , , ,::lPrintZero,.F.))
    ::JItens["COLUNA12_M"] := AllTrim(ValorCTB(cArqTmp->COLUNA12,,,::aTamVal[1],nDecimais,.T.,cPicture,cNormal, , , , , ,::lPrintZero,.F.))
    
    //Validação para realizar a soma dos acumulados (mesma regra do bCond do CTBR265.prw)
    //Somente no modo "Somente Sinteticas" (MV_PAR05==1) a sintetica de nivel 1 (raiz) entra
    //no acumulado, pois nesse modo as analiticas nao sao exibidas (ExecDBSkipTemp as filtra),
    //logo a raiz sintetica e a unica linha visivel que representa o total consolidado.
    //Nos demais modos (2-Analiticas, 3-Ambos) a sintetica NUNCA soma nos totalizadores, pois
    //ela e um agregado das analiticas: soma-la junto duplicaria o valor no "Total do Periodo".
    If cArqTmp->TIPOCONTA == "1"
        If MV_PAR05 <> 1
            lSoma := .F.
        Else
            If cArqTmp->NIVEL1
                lSoma := .T.
            Else
                lSoma := .F.
            EndIf
        EndIf
    Else
        lSoma := .T.
    EndIf

    ::nAcumColuna1  += iif(lSoma, cArqTmp->COLUNA1,  0)
    ::nAcumColuna2  += iif(lSoma, cArqTmp->COLUNA2,  0)
    ::nAcumColuna3  += iif(lSoma, cArqTmp->COLUNA3,  0)
    ::nAcumColuna4  += iif(lSoma, cArqTmp->COLUNA4,  0)
    ::nAcumColuna5  += iif(lSoma, cArqTmp->COLUNA5,  0)
    ::nAcumColuna6  += iif(lSoma, cArqTmp->COLUNA6,  0)
    ::nAcumColuna7  += iif(lSoma, cArqTmp->COLUNA7,  0)
    ::nAcumColuna8  += iif(lSoma, cArqTmp->COLUNA8,  0)
    ::nAcumColuna9  += iif(lSoma, cArqTmp->COLUNA9,  0)
    ::nAcumColuna10 += iif(lSoma, cArqTmp->COLUNA10, 0)
    ::nAcumColuna11 += iif(lSoma, cArqTmp->COLUNA11, 0)
    ::nAcumColuna12 += iif(lSoma, cArqTmp->COLUNA12, 0)

    // DSERCTR1-52528: so reformata via ValorCTB quando o acumulado mudou (lSoma==.T.).
    // Quando lSoma==.F. o valor numerico e identico ao da linha anterior, logo a string
    // formatada tambem e identica reaproveitamos o cache sem custo de ValorCTB.
    // Empty(::cAcumCol01): garante que a 1a linha processada sempre passe por ValorCTB com
    // nDecimais/cPicture reais, mesmo quando essa 1a linha tem lSoma==.F. (correcao de defeito
    // do cache "0,00" hardcoded) - mesmo padrao do gate de grupo (cAcumGrpCol01) abaixo.
    If lSoma .Or. Empty(::cAcumCol01)
        ::cAcumCol01  := AllTrim(ValorCTB(::nAcumColuna1 ,,,::aTamVal[1],nDecimais,.T.,cPicture,"", , , , , ,::lPrintZero,.F.))
        ::cAcumCol02  := AllTrim(ValorCTB(::nAcumColuna2 ,,,::aTamVal[1],nDecimais,.T.,cPicture,"", , , , , ,::lPrintZero,.F.))
        ::cAcumCol03  := AllTrim(ValorCTB(::nAcumColuna3 ,,,::aTamVal[1],nDecimais,.T.,cPicture,"", , , , , ,::lPrintZero,.F.))
        ::cAcumCol04  := AllTrim(ValorCTB(::nAcumColuna4 ,,,::aTamVal[1],nDecimais,.T.,cPicture,"", , , , , ,::lPrintZero,.F.))
        ::cAcumCol05  := AllTrim(ValorCTB(::nAcumColuna5 ,,,::aTamVal[1],nDecimais,.T.,cPicture,"", , , , , ,::lPrintZero,.F.))
        ::cAcumCol06  := AllTrim(ValorCTB(::nAcumColuna6 ,,,::aTamVal[1],nDecimais,.T.,cPicture,"", , , , , ,::lPrintZero,.F.))
        ::cAcumCol07  := AllTrim(ValorCTB(::nAcumColuna7 ,,,::aTamVal[1],nDecimais,.T.,cPicture,"", , , , , ,::lPrintZero,.F.))
        ::cAcumCol08  := AllTrim(ValorCTB(::nAcumColuna8 ,,,::aTamVal[1],nDecimais,.T.,cPicture,"", , , , , ,::lPrintZero,.F.))
        ::cAcumCol09  := AllTrim(ValorCTB(::nAcumColuna9 ,,,::aTamVal[1],nDecimais,.T.,cPicture,"", , , , , ,::lPrintZero,.F.))
        ::cAcumCol10  := AllTrim(ValorCTB(::nAcumColuna10,,,::aTamVal[1],nDecimais,.T.,cPicture,"", , , , , ,::lPrintZero,.F.))
        ::cAcumCol11  := AllTrim(ValorCTB(::nAcumColuna11,,,::aTamVal[1],nDecimais,.T.,cPicture,"", , , , , ,::lPrintZero,.F.))
        ::cAcumCol12  := AllTrim(ValorCTB(::nAcumColuna12,,,::aTamVal[1],nDecimais,.T.,cPicture,"", , , , , ,::lPrintZero,.F.))
        ::cTotAcumPer := AllTrim(ValorCTB(::nAcumColuna1+::nAcumColuna2+::nAcumColuna3+::nAcumColuna4+::nAcumColuna5+::nAcumColuna6+;
                                          ::nAcumColuna7+::nAcumColuna8+::nAcumColuna9+::nAcumColuna10+::nAcumColuna11+::nAcumColuna12;
                                          ,,,20-2,nDecimais,.T.,cPicture,cNormal, , , , , ,::lPrintZero,.F.))
    EndIf

    // Atribuicao a partir do cache eh executada em toda linha, independentemente de lSoma
    ::JItens["ACUMCOL01"]  := ::cAcumCol01
    ::JItens["ACUMCOL02"]  := ::cAcumCol02
    ::JItens["ACUMCOL03"]  := ::cAcumCol03
    ::JItens["ACUMCOL04"]  := ::cAcumCol04
    ::JItens["ACUMCOL05"]  := ::cAcumCol05
    ::JItens["ACUMCOL06"]  := ::cAcumCol06
    ::JItens["ACUMCOL07"]  := ::cAcumCol07
    ::JItens["ACUMCOL08"]  := ::cAcumCol08
    ::JItens["ACUMCOL09"]  := ::cAcumCol09
    ::JItens["ACUMCOL10"]  := ::cAcumCol10
    ::JItens["ACUMCOL11"]  := ::cAcumCol11
    ::JItens["ACUMCOL12"]  := ::cAcumCol12
    ::JItens["TOTACUMPER"] := ::cTotAcumPer


    ::nAcumGrpColuna1  += iif(lSoma, cArqTmp->COLUNA1,  0)
    ::nAcumGrpColuna2  += iif(lSoma, cArqTmp->COLUNA2,  0)
    ::nAcumGrpColuna3  += iif(lSoma, cArqTmp->COLUNA3,  0)
    ::nAcumGrpColuna4  += iif(lSoma, cArqTmp->COLUNA4,  0)
    ::nAcumGrpColuna5  += iif(lSoma, cArqTmp->COLUNA5,  0)
    ::nAcumGrpColuna6  += iif(lSoma, cArqTmp->COLUNA6,  0)
    ::nAcumGrpColuna7  += iif(lSoma, cArqTmp->COLUNA7,  0)
    ::nAcumGrpColuna8  += iif(lSoma, cArqTmp->COLUNA8,  0)
    ::nAcumGrpColuna9  += iif(lSoma, cArqTmp->COLUNA9,  0)
    ::nAcumGrpColuna10 += iif(lSoma, cArqTmp->COLUNA10, 0)
    ::nAcumGrpColuna11 += iif(lSoma, cArqTmp->COLUNA11, 0)
    ::nAcumGrpColuna12 += iif(lSoma, cArqTmp->COLUNA12, 0)

    // DSERCTR1-52528: mesmo gate para o acumulado de grupo.
    // ATENCAO: sem AllTrim — o codigo original nao tinha AllTrim nos campos ACUMGRPCOL,
    // logo o baseline contem o retorno bruto de ValorCTB (com padding de espacos).
    // Os campos ACUMCOL acima usam AllTrim pois o original tambem usava — paridade preservada.
    If lSoma .Or. Empty(::cAcumGrpCol01)
        ::cAcumGrpCol01  := ValorCTB(::nAcumGrpColuna1 ,,,::aTamVal[1],nDecimais,.T.,cPicture,"", , , , , ,::lPrintZero,.F.)
        ::cAcumGrpCol02  := ValorCTB(::nAcumGrpColuna2 ,,,::aTamVal[1],nDecimais,.T.,cPicture,"", , , , , ,::lPrintZero,.F.)
        ::cAcumGrpCol03  := ValorCTB(::nAcumGrpColuna3 ,,,::aTamVal[1],nDecimais,.T.,cPicture,"", , , , , ,::lPrintZero,.F.)
        ::cAcumGrpCol04  := ValorCTB(::nAcumGrpColuna4 ,,,::aTamVal[1],nDecimais,.T.,cPicture,"", , , , , ,::lPrintZero,.F.)
        ::cAcumGrpCol05  := ValorCTB(::nAcumGrpColuna5 ,,,::aTamVal[1],nDecimais,.T.,cPicture,"", , , , , ,::lPrintZero,.F.)
        ::cAcumGrpCol06  := ValorCTB(::nAcumGrpColuna6 ,,,::aTamVal[1],nDecimais,.T.,cPicture,"", , , , , ,::lPrintZero,.F.)
        ::cAcumGrpCol07  := ValorCTB(::nAcumGrpColuna7 ,,,::aTamVal[1],nDecimais,.T.,cPicture,"", , , , , ,::lPrintZero,.F.)
        ::cAcumGrpCol08  := ValorCTB(::nAcumGrpColuna8 ,,,::aTamVal[1],nDecimais,.T.,cPicture,"", , , , , ,::lPrintZero,.F.)
        ::cAcumGrpCol09  := ValorCTB(::nAcumGrpColuna9 ,,,::aTamVal[1],nDecimais,.T.,cPicture,"", , , , , ,::lPrintZero,.F.)
        ::cAcumGrpCol10  := ValorCTB(::nAcumGrpColuna10,,,::aTamVal[1],nDecimais,.T.,cPicture,"", , , , , ,::lPrintZero,.F.)
        ::cAcumGrpCol11  := ValorCTB(::nAcumGrpColuna11,,,::aTamVal[1],nDecimais,.T.,cPicture,"", , , , , ,::lPrintZero,.F.)
        ::cAcumGrpCol12  := ValorCTB(::nAcumGrpColuna12,,,::aTamVal[1],nDecimais,.T.,cPicture,"", , , , , ,::lPrintZero,.F.)
        ::cTotAcumGrp    := AllTrim(ValorCTB(::nAcumGrpColuna1+::nAcumGrpColuna2+::nAcumGrpColuna3+::nAcumGrpColuna4+::nAcumGrpColuna5+::nAcumGrpColuna6+;
                                             ::nAcumGrpColuna7+::nAcumGrpColuna8+::nAcumGrpColuna9+::nAcumGrpColuna10+::nAcumGrpColuna11+::nAcumGrpColuna12;
                                             ,,,20-2,nDecimais,.T.,cPicture,cNormal, , , , , ,::lPrintZero,.F.))
    EndIf

    // Atribuicao a partir do cache eh executada em toda linha, independentemente de lSoma
    ::JItens["ACUMGRPCOL01"] := ::cAcumGrpCol01
    ::JItens["ACUMGRPCOL02"] := ::cAcumGrpCol02
    ::JItens["ACUMGRPCOL03"] := ::cAcumGrpCol03
    ::JItens["ACUMGRPCOL04"] := ::cAcumGrpCol04
    ::JItens["ACUMGRPCOL05"] := ::cAcumGrpCol05
    ::JItens["ACUMGRPCOL06"] := ::cAcumGrpCol06
    ::JItens["ACUMGRPCOL07"] := ::cAcumGrpCol07
    ::JItens["ACUMGRPCOL08"] := ::cAcumGrpCol08
    ::JItens["ACUMGRPCOL09"] := ::cAcumGrpCol09
    ::JItens["ACUMGRPCOL10"] := ::cAcumGrpCol10
    ::JItens["ACUMGRPCOL11"] := ::cAcumGrpCol11
    ::JItens["ACUMGRPCOL12"] := ::cAcumGrpCol12
    ::JItens["TOTACUMGRP"]   := ::cTotAcumGrp

    //Pula registro para validar se trocou o grupo
    cArqTmp->(DbSkip())

    //Se trocou grupo, appenda os valores e reseta as variaveis
    If cGrupoBkp <> cArqTMP->GRUPO
        ::nAcumGrpColuna1  := 0
        ::nAcumGrpColuna2  := 0
        ::nAcumGrpColuna3  := 0
        ::nAcumGrpColuna4  := 0
        ::nAcumGrpColuna5  := 0
        ::nAcumGrpColuna6  := 0
        ::nAcumGrpColuna7  := 0
        ::nAcumGrpColuna8  := 0
        ::nAcumGrpColuna9  := 0
        ::nAcumGrpColuna10 := 0
        ::nAcumGrpColuna11 := 0
        ::nAcumGrpColuna12 := 0
        // Reseta tambem o cache de grupo: na proxima linha (que sera a primeira do novo
        // grupo), lSoma sera recalculado e, se .T., o cache sera atualizado normalmente.
        // Se for .F., o cache zerado sera reaproveitado correto, pois o acumulado e 0.
        ::cAcumGrpCol01  := ""
        ::cAcumGrpCol02  := ""
        ::cAcumGrpCol03  := ""
        ::cAcumGrpCol04  := ""
        ::cAcumGrpCol05  := ""
        ::cAcumGrpCol06  := ""
        ::cAcumGrpCol07  := ""
        ::cAcumGrpCol08  := ""
        ::cAcumGrpCol09  := ""
        ::cAcumGrpCol10  := ""
        ::cAcumGrpCol11  := ""
        ::cAcumGrpCol12  := ""
        ::cTotAcumGrp    := ""
    EndIf

    //Volta registro pulado
    cArqTmp->(DbSkip(-1))

return

//-------------------------------------------------------------------
/*{Protheus.doc} ExecDBSkipTemp
Se .T., pula registros de acordo com as validações do método
 
@return lógico: lRet
 
@author Renan Gremes
@since 25/11/2024
@version 1.0
*/
//-------------------------------------------------------------------

method ExecDBSkipTemp(cArqTmp As character) as logical class Accountx12MonthsSmartViewBusinessObject
   
    local lRet     := .F. as logical
    local lDifZero := .F. as logical

    //Indica se ha valor diferente de zero em algum dos periodos da linha atual.
    //As colunas ja chegam com a soma/subtracao de debito e credito aplicada na origem
    //(CQ1_CREDIT - CQ1_DEBITO), tanto para analiticas quanto para sinteticas (estas
    //recebem o valor propagado/consolidado dos descendentes pela SupCompCt7).
    lDifZero := (cArqTmp->COLUNA1  <> 0 .Or. cArqTmp->COLUNA2  <> 0 .Or. cArqTmp->COLUNA3  <> 0 .Or.;
                 cArqTmp->COLUNA4  <> 0 .Or. cArqTmp->COLUNA5  <> 0 .Or. cArqTmp->COLUNA6  <> 0 .Or.;
                 cArqTmp->COLUNA7  <> 0 .Or. cArqTmp->COLUNA8  <> 0 .Or. cArqTmp->COLUNA9  <> 0 .Or.;
                 cArqTmp->COLUNA10 <> 0 .Or. cArqTmp->COLUNA11 <> 0 .Or. cArqTmp->COLUNA12 <> 0)

    //Mesma regra de filtragem do CTBR265.prw (cFilter/cDifZero): quando "Saldos Zerados"
    //(MV_PAR07) esta como Nao, uma linha (sintetica OU analitica) so aparece se possuir
    //valor liquido diferente de zero em algum periodo. Ex.: uma sintetica cuja soma dos
    //descendentes zera (debito cancelando credito) nao deve aparecer nesse caso; ja uma
    //sintetica cujo(s) descendente(s) tem sobra de debito ou credito deve aparecer normalmente.
    if MV_PAR05 == 1        // Apenas sinteticas
        lRet := !(cArqTmp->TIPOCONTA == "1")
        If !lRet .And. !self:lVlrZerado .And. !lDifZero
            lRet := .T.
        EndIf
    elseif MV_PAR05 == 2    // Apenas analiticas
        lRet := !(cArqTmp->TIPOCONTA == "2")
        If !lRet .And. !self:lVlrZerado .And. !lDifZero
            lRet := .T.
        EndIf
    else                    // Ambos (sinteticas e analiticas)
        If !self:lVlrZerado .And. !lDifZero
            lRet := .T.
        EndIf
    endif

return lRet
