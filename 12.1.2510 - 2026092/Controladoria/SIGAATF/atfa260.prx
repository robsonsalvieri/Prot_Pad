/*/
Function AF260DtEmi()
Local lRet  := .T.
Local dData := &(ReadVAr())

If Dtos(dData) > Dtos(m->n9_dtaquis)
	Help(" ",1,"AF260DATA")  //Data de emissao nao pode ser maior q a data de aquisicao
	lRet := .F.                     
Endif
Return(lRet)
                            

