/*/
Function A260DataT(dDataTrans)
Local lRet := .T.

If Dtos(dDataTrans)< Dtos(SN9->N9_DTAQUIS) .or. Dtos(dDataTrans)< Dtos(SN9->N9_DTEMISS)
	Help(" ",1,"AF260DATA")  // A data da transferencia deve ser maior que a data de aquis e a de emissao
	lRet := .F.	
EndIf

Return(lRet)

