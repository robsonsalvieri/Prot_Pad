Function A260VMenor(cValor)
Local lRet   := .T.

cValor:= StrZero(Val(cValor),10)
If Val(cValor)< Val(SN9->N9_NROINIC) .Or. Val(cValor) > Val(SN9->N9_NROFINA)
	Help(" ",1,"AF260TRANSF")  // O nro inicial deve estar entre o nro inicla e o nro final
	lRet := .F.
Endif

Return(lRet)

