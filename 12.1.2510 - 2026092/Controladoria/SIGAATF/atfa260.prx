Function AF260Valor()
Local lRet   := .T.
Local nValor := &(ReadVAr())

If nValor < 0
	Help(" ",1,"AF260ZERO")  // O vlr da acao nao pode ser menor que zero
	lRet := .F.
Endif
Return(lRet)
 
