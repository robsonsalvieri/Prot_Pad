/*/

Function AF260TudOK()
Local lRet := .T.

If Empty(m->n9_dtaquis) .Or. Empty(m->n9_dtemiss) .Or. (M->N9_VLRUNIT)<= 0 .Or.;
	(Empty(m->n9_matric) .And. Empty(m->n9_nomepro))
	Help(" ", 1, "AF260BRANC")  // Os cpos ... nao podem ficar em branco
	lRet := .F.
Endif
If lRet
	If Empty(M->N9_MOEDA)
		HelP(" ", 1,"AF260BRANC")
		lRet := .F.		
	Endif
Endif

Return(lRet)

