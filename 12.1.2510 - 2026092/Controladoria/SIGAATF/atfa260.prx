/*/
Static Function MenuDef()
	Local aRotina as array
	Local lPageAction as logical

	lPageAction := .T.

	aRotina := { { OemToAnsi(STR0001),"AxPesqui", 0, 1 , ,.F.},;  			//"Pesquisar"
				 { OemToAnsi(STR0002),"AxVisual", 0, 2},;  		  			//"Visualizar"
				 { OemToAnsi(STR0003),"AF260Inc", 0, 3},;  		  			//"Incluir"
				 { OemToAnsi(STR0004),"AF260Tra", 0, 4,,,,,,lPageAction},;	//"Transferir"
				 { OemToAnsi(STR0005),"AF260Del", 0, 5} }   		  		//"Excluir"

Return aRotina
