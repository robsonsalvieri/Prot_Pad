#include "tlpp-core.th"

namespace totvs.protheus.backoffice.accountingclosing.clearctk

//-------------------------------------------------------------------
/*/{Protheus.doc} ClearCTKService
Classe de serviço, realiza instância e chamada de métodos de serviços

@type class
@author Totvs
@since 17/06/2026
/*/
//-------------------------------------------------------------------
class ClearCTKService
    public method new()
    public method getInstance()
    public method postClearCTK()
    public method saveLogCV8()
endclass

//-------------------------------------------------------------------
/*/{Protheus.doc} new
Método construtor

@type method
@author Totvs
@since 17/06/2026
@return object, Instância da classe ClearCTKService
/*/
//-------------------------------------------------------------------
method new() class ClearCTKService
return

//-------------------------------------------------------------------
/*/{Protheus.doc} getInstance
Responsável por instanciar a classe service (Singleton)

@type method
@author Totvs
@since 17/06/2026
@return object, Instância a classe ClearCTKService
/*/
//-------------------------------------------------------------------
method getInstance() class ClearCTKService
    static __instance As Object
    
    If ValType(__instance) == "U"
        __instance := ClearCTKService():new()
    EndIf
return __instance

//-------------------------------------------------------------------
/*/{Protheus.doc} postClearCTK
Responsável por chamar a camada de dados e parsear o retorno

@type method
@author Totvs
@since 17/06/2026
@param cTpSald, character, Tipo de saldo
@param cCodCurr, character, Código da moeda
@param aBlockedCTG, array, Array de JSON com calendários bloqueados
@return array, Array contendo [lSucesso, nTotalDeleted]
/*/
//-------------------------------------------------------------------
method postClearCTK(cTpSald as Character, cCodCurr as Character, aBlockedCTG as Array) class ClearCTKService
    Local oData     As Object
    Local aRetClear As Array

    oData     := ClearCTKProtheusData():getData()
    aRetClear := oData:postClearCTK(cTpSald, cCodCurr, aBlockedCTG)

    FreeObj(oData)
return aRetClear
//-------------------------------------------------------------------
/*/{Protheus.doc} saveLogCV8
Responsável por chamar a camada de dados para salvamento de log

@type method
@author Totvs
@since 17/06/2026
@param nTotalDeleted, numeric, Quantidade total de registros deletados
@return logical, .T. se sucesso, .F. caso contrário
/*/
//-------------------------------------------------------------------
method saveLogCV8(nTotalDeleted as Numeric) class ClearCTKService
    Local oData     As Object
    Local lResponse As Logical

    oData     := clearCTKProtheusData():getData()
    lResponse := oData:saveLogCV8(nTotalDeleted)

    FreeObj(oData)
return lResponse
