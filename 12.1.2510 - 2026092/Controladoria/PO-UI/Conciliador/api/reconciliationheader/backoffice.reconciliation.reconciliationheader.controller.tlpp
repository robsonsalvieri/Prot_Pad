#include "tlpp-core.th"
#include "backoffice.reconciliation.reconciliationheader.controller.ch"

namespace totvs.protheus.backoffice.reconciliation.reconciliationheader
using namespace totvs.protheus.backoffice.reconciliation.util

//-------------------------------------------------------------------
/*/{Protheus.doc} ReconciliationHeader
Classe principal de controle, onde é inicializado o EndPoint

@author Totvs
/*/
//-------------------------------------------------------------------
class ReconciliationHeader
    public method new()

    @Get("/api/tc/reconciliationheader/")
    public method getAllReconciliationHeaders()
endclass

//-------------------------------------------------------------------
/*/{Protheus.doc} ReconciliationHeader
Metodo construtor

@author Totvs
/*/
//-------------------------------------------------------------------
method new() class ReconciliationHeader
return

//-------------------------------------------------------------------
/*/{Protheus.doc} getAllReconciliationHeaders
Metodo que inicia a chamada das configuracoes de match do conciliador

@author Totvs
/*/
//-------------------------------------------------------------------
method getAllReconciliationHeaders() class ReconciliationHeader
    Local oService  As Object
    Local oField    As Object
    Local jResposta As Json
    Local cFilBkp   As Character
    Local cFilters  As Character 
    Local nPage     As Numeric
    Local nPageSize As Numeric
    Local nAt       As Numeric
    Local aFilters  As Array
    Local lResponse As Logical
    Local cChaveRes As Character
    Local cResponse As Character	
    Local nI := 0   As Numeric
    Local cNmTabOri As Character
    Local cNmTabDes As Character
    Local cBranchesCondition  As Character 
    Local lRet      As Logical 
    Local cSearch      As Character
    Local cWhereBusca  As Character
    Local cSearchDate  As Character

    //Inicilaiza variaveis
    oService  := ReconciliationHeaderService():getInstance()
    oField    := tcTreatsFilter():new()
    jResposta := JsonObject():new()
    cFilBkp   := cFilAnt
    cFilters  := ""
    aFilters  := {}
    nPage     := 1
    nPageSize := 10
    nAt       := 0
    lResponse := .F.
    cChaveRes := "message"
    cResponse := "Resposta inválida."
    lRet      := .T.
    cSearch      := ""
    cWhereBusca  := ""
    cSearchDate  := ""
    cBranchesCondition := GetBranchiesForConditional("QLC")
    
    If cBranchesCondition == ""
        cResponse := STR0001+;//"Não há filiais validas na seleção de filiais que podem ser acessadas desta filial, de acordo com seu compartilhamento de tabelas."+;
                        STR0002//"Acesse a rotina por outra filial ou altere sua seleção de filiais"
        lRet := .F.
    EndIf
    
    If lRet

        tcGetHeaders()

        tcGetPageAndPageSize(@nPage, @nPageSize)

        //Le o termo de busca (lupa) da tela Gerenciar e saneia contra SQL injection (CA2050)
        cSearch := tcGetQryParams("search")

        If !Empty(cSearch)
            //tcClearSql ja aplica UPPER no termo e remove metacaracteres/curinga '%'.
            //Se detectar conteudo suspeito, retorna "" (descarta o termo inteiro).
            cSearch := tcClearSql(cSearch)

            If !Empty(cSearch)
                //Se o termo saneado corresponder a uma data dd/mm/aaaa, converte para AAAAMMDD
                //(QLC_DATCON e comparado como STRING - PA-01)
                cSearchDate := tcSearchToDate(cSearch)

                //Predicado OR LIKE sobre as colunas identificadoras da QLC (G-03).
                //Termo ja vem em CAIXA ALTA do tcClearSql - nao reaplicar UPPER() no literal.
                cWhereBusca := " AND ( "
                cWhereBusca += " UPPER(QLC.QLC_CODCON) LIKE '%" + cSearch + "%'"
                cWhereBusca += " OR UPPER(QLC.QLC_CODCFG) LIKE '%" + cSearch + "%'"
                cWhereBusca += " OR UPPER(QLC.QLC_FILIAL) LIKE '%" + cSearch + "%'"
                cWhereBusca += " OR UPPER(QLC.QLC_TABORI) LIKE '%" + cSearch + "%'"
                cWhereBusca += " OR UPPER(QLC.QLC_TABDES) LIKE '%" + cSearch + "%'"

                If !Empty(cSearchDate)
                    cWhereBusca += " OR QLC.QLC_DATCON = '" + cSearchDate + "'"
                EndIf

                cWhereBusca += " ) "

                //Compoe o predicado de busca DENTRO do mesmo cWhere das filiais - sem parametro novo (PA-04)
                cBranchesCondition += cWhereBusca
            EndIf
        EndIf

        jResposta:fromJson(oService:getAllReconciliationHeader(nPage, nPageSize, cBranchesCondition))

        If ValType(jResposta:GetJsonText("items")) <> "U" 

            If Len(jResposta["items"]) > 0
                For nI := 1 to Len(jResposta["items"]) 
                    
                    PswOrder(1)
                    If PswSeek(jResposta["items"][nI]["codusr"])
                        jResposta["items"][nI]["codusr"] += "-"+ PswChave(jResposta["items"][nI]["codusr"])
                    EndIf

                    cNmTabOri := FwSX2Util():GetX2Name( jResposta["items"][nI]["tabori"]) 
                    cNmTabDes := FwSX2Util():GetX2Name( jResposta["items"][nI]["tabdes"])                     
                    jResposta["items"][nI]["tabori"] += "-"+cNmTabOri
                    jResposta["items"][nI]["tabdes"] += "-"+cNmTabDes
                Next nI
            EndIf

            lResponse := .T.                    
        EndIf

        IIf(lResponse,; 
            tcAnswerRest(jResposta, .T.),; 
            tcSetResponse(lResponse, cChaveRes, cResponse, .F.))
    Else
        tcSetResponse(lResponse, cChaveRes, cResponse, .F.)
    EndIf

    //Restaura empresa e filial
    cFilAnt := cFilBkp

    //Limpa array
	FWFreeArray(aFilters)
return

//-------------------------------------------------------------------
/*/{Protheus.doc} tcSearchToDate
Converte o termo de busca para o formato AAAAMMDD quando o termo
casar o padrao de data dd/mm/aaaa (G-02/PA-01). QLC_DATCON e
comparado no WHERE como STRING, nunca como tipo date.
Retorna "" quando o termo nao representa uma data valida no
formato dd/mm/aaaa.

O parse e feito manualmente por posicao (sem CToD): CToD depende
do formato de data configurado no ambiente (SET DATE FORMAT), que nao
e garantidamente "dd/mm/yyyy" no AppServer. Se o ambiente estiver em
outro formato (ex.: mm/dd/yy), CToD("31/12/2024") interpreta "31" como
mes invalido e retorna data vazia, fazendo a busca por data nunca
casar (AC-10). O parse manual e determinstico e independe do
ambiente.

A validacao calendarica completa (dia existente para o mes/ano, ex.:
rejeitar 30/02 e 31/04) e delegada ao SToD(), que tambem independe do
SET DATE FORMAT por trabalhar em formato fixo "aaaammdd" e retorna
data vazia quando o conteudo informado nao representa uma data real.

@author Totvs
/*/
//-------------------------------------------------------------------
Static Function tcSearchToDate(cSearch as Character) as Character
    Local cReturn := "" as Character
    Local cDay    := "" as Character
    Local cMonth  := "" as Character
    Local cYear   := "" as Character
    Local nDay    := 0  as Numeric
    Local nMonth  := 0  as Numeric

    If Len(cSearch) == 10 .And. SubStr(cSearch, 3, 1) == "/" .And. SubStr(cSearch, 6, 1) == "/"
        cDay   := SubStr(cSearch, 1, 2)
        cMonth := SubStr(cSearch, 4, 2)
        cYear  := SubStr(cSearch, 7, 4)

        If tcOnlyDigits(cDay) .And. tcOnlyDigits(cMonth) .And. tcOnlyDigits(cYear)
            nDay   := Val(cDay)
            nMonth := Val(cMonth)

            If nDay >= 1 .And. nDay <= 31 .And. nMonth >= 1 .And. nMonth <= 12
                cReturn := cYear + cMonth + cDay

                //Valida se a data e calendariamente valida (ex.: rejeita 30/02, 31/04).
                //STOD() nao depende de SET DATE FORMAT (formato fixo AAAAMMDD) e retorna
                //data vazia quando o conteudo nao representa uma data real.
                If Empty(SToD(cReturn))
                    cReturn := ""
                EndIf
            EndIf
        EndIf
    EndIf
Return cReturn

//-------------------------------------------------------------------
/*/{Protheus.doc} tcOnlyDigits
Verifica se o conteudo informado e composto exclusivamente por
digitos numericos (0-9) e nao esta vazio. Usado para validar os
segmentos dia/mes/ano extraidos do termo de busca antes de compor a
data no formato AAAAMMDD (tcSearchToDate), sem depender de CToD.

@author Totvs
@param cValue, conteudo a ser validado
@return lReturn, .T. se todos os caracteres forem digitos e o
conteudo nao estiver vazio; .F. caso contrario
/*/
//-------------------------------------------------------------------
Static Function tcOnlyDigits(cValue as Character) as Logical
    Local lReturn := .T. as Logical
    Local nI      := 0   as Numeric
    
    For nI := 1 To Len(cValue)
        If !(SubStr(cValue, nI, 1) >= "0" .And. SubStr(cValue, nI, 1) <= "9")
            lReturn := .F.
            Exit
        EndIf
    Next nI
    
Return lReturn
