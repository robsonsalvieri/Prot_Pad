#include "totvs.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "topconn.ch"


namespace totvs.protheus.backoffice.ctb.balance.analitico

/*/{protheus.doc} getBalanceanalitico

Método POST para retornar razao contábil
Usando REST Versão 2.0 com Annotation

@type function
@author Jader Berto
@since 16/04/2025
@version P12

/*/ 
@POST(endpoint="api/ctb/balance/analitico", description="Balancete Analítico")
User Function getBalanceanalitico()
	Local jHeaderReq     := oRest:getHeaderRequest()  as object
	Local cError         := ""                        as character
	Local oJRes          := JsonObject():new()        as object
	Local jBody          := JsonObject():new()        as object
	Local oJConexao      := JsonObject():new()        as object
	Local cMsg           := ""                        as character
	Local lOK            := .F.                       as logical
	Local cFilInic       as character
	Local cFilFinal      as character
	Local cDatInic       := ""                        as character
	Local cDataFinal     := ""                        as character
	Local cCtaInic       as character
	Local cCtaFinal      as character
	Local cCCsInic       as character
	Local cCCsFinal      as character
	Local cItmInic       as character
	Local cItemFinal     as character
	Local cClsInic       as character
	Local cClsFinal      as character
	Local cEnt05Inic     as character
	Local cEnt05Fin      as character
	Local cEnt06Inic     as character
	Local cEnt06Fin      as character
	Local cEnt07Inic     as character
	Local cEnt07Fin      as character
	Local cEnt08Inic     as character
	Local cEnt08Fin      as character
	Local cEnt09Inic     as character
	Local cEnt09Fin      as character
	Local ctempCon       := "TRBCONN"                  as character
	Local cMoeda         as character
	Local cTPSaldo       as character
	Local nTamEntid      := 0                          as numeric

	cMSg  := ""
    lOk   := .T.
	cError  :=  jBody:fromJson(oRest:GetBodyRequest())

    //Se tiver algum erro no Parse, encerra a execucao
    IF Empty(cError)
		// filial
		nTamEntid  := TamSX3('CT2_FILIAL')[01]
		cFilInic   := Replicate(" ", nTamEntid)
		cFilFinal  := Replicate("Z", nTamEntid)
		jBody:GetJsonValue("filialInicial", @cFilInic)
		jBody:GetJsonValue("filialFinal",   @cFilFinal)
		cDatInic   := iif(empty(jBody:GetJsonText("dataInicial")), DTOS(FirstDay(DATE())), DTOS(CTOD(jBody:GetJsonText("dataInicial"))))
		cDataFinal := iif(empty(jBody:GetJsonText("dataFinal")),   DTOS(LastDay(DATE())),  DTOS(CTOD(jBody:GetJsonText("dataFinal"))))
		cMoeda     := "01"
		cTPSaldo   := "1"
		jBody:GetJsonValue("moeda",   @cMoeda)
		jBody:GetJsonValue("tpsaldo", @cTPSaldo)

		// Inicializa variaveis de range com valores default baseados no tamanho do dicionario
		// A chamada GetJsonValue sobrescreve somente se a chave existir no JSON

		// conta contabil
		nTamEntid  := TamSX3('CT2_CREDIT')[01]
		cCtaInic   := Replicate(" ", nTamEntid)
		cCtaFinal  := Replicate("Z", nTamEntid)
		jBody:GetJsonValue("contaInicial", @cCtaInic)
		jBody:GetJsonValue("contaFinal",   @cCtaFinal)

		// centro de custo
		nTamEntid  := TamSX3('CT2_CCC')[01]
		cCCsInic   := Replicate(" ", nTamEntid)
		cCCsFinal  := Replicate("Z", nTamEntid)
		jBody:GetJsonValue("cCustoInicial", @cCCsInic)
		jBody:GetJsonValue("cCustoFinal",   @cCCsFinal)

		// item contabil
		nTamEntid  := TamSX3('CT2_ITEMC')[01]
		cItmInic   := Replicate(" ", nTamEntid)
		cItemFinal := Replicate("Z", nTamEntid)
		jBody:GetJsonValue("itemInicial", @cItmInic)
		jBody:GetJsonValue("itemFinal",   @cItemFinal)

		// classe de valor
		nTamEntid  := TamSX3('CT2_CLVLCR')[01]
		cClsInic   := Replicate(" ", nTamEntid)
		cClsFinal  := Replicate("Z", nTamEntid)
		jBody:GetJsonValue("classeInicial", @cClsInic)
		jBody:GetJsonValue("classeFinal",   @cClsFinal)

		// entidades contabeis opcionais (so inicializa se o campo existir na tabela)
		If CT2->(FieldPos("CT2_EC05CR")) > 0
			nTamEntid    := TamSX3('CT2_EC05CR')[01]
			cEnt05Inic   := Replicate(" ", nTamEntid)
			cEnt05Fin    := Replicate("Z", nTamEntid)
			jBody:GetJsonValue("ent05Inicial", @cEnt05Inic)
			jBody:GetJsonValue("ent05Final",   @cEnt05Fin)
		EndIf
		If CT2->(FieldPos("CT2_EC06CR")) > 0
			nTamEntid    := TamSX3('CT2_EC06CR')[01]
			cEnt06Inic   := Replicate(" ", nTamEntid)
			cEnt06Fin    := Replicate("Z", nTamEntid)
			jBody:GetJsonValue("ent06Inicial", @cEnt06Inic)
			jBody:GetJsonValue("ent06Final",   @cEnt06Fin)
		EndIf
		If CT2->(FieldPos("CT2_EC07CR")) > 0
			nTamEntid    := TamSX3('CT2_EC07CR')[01]
			cEnt07Inic   := Replicate(" ", nTamEntid)
			cEnt07Fin    := Replicate("Z", nTamEntid)
			jBody:GetJsonValue("ent07Inicial", @cEnt07Inic)
			jBody:GetJsonValue("ent07Final",   @cEnt07Fin)
		EndIf
		If CT2->(FieldPos("CT2_EC08CR")) > 0
			nTamEntid    := TamSX3('CT2_EC08CR')[01]
			cEnt08Inic   := Replicate(" ", nTamEntid)
			cEnt08Fin    := Replicate("Z", nTamEntid)
			jBody:GetJsonValue("ent08Inicial", @cEnt08Inic)
			jBody:GetJsonValue("ent08Final",   @cEnt08Fin)
		EndIf
		If CT2->(FieldPos("CT2_EC09CR")) > 0
			nTamEntid    := TamSX3('CT2_EC09CR')[01]
			cEnt09Inic   := Replicate(" ", nTamEntid)
			cEnt09Fin    := Replicate("Z", nTamEntid)
			jBody:GetJsonValue("ent09Inicial", @cEnt09Inic)
			jBody:GetJsonValue("ent09Final",   @cEnt09Fin)
		EndIf

		If jHeaderReq != Nil
			oJConexao := movimContA(@ctempCon,cFilInic,cFilFinal,cDatInic,cDataFinal,cCtaInic,cCtaFinal,cCCsInic,cCCsFinal,cItmInic,cItemFinal,cClsInic,cClsFinal,cEnt05Inic,cEnt05Fin,cEnt06Inic,cEnt06Fin,cEnt07Inic,cEnt07Fin,cEnt08Inic,cEnt08Fin,cEnt09Inic,cEnt09Fin,cMoeda,cTPSaldo)
			If oJConexao["sucesso"]
				oJRes["itens"] := {}
				While (ctempCon)->(!EOF())
					AAdd(oJRes["itens"], { "FILIAL": (ctempCon)->FILIAL,;
										"MOEDA": Alltrim((ctempCon)->MOEDA),;
										"TIPO": Alltrim((ctempCon)->TIPO),;
										"CONTA": Alltrim((ctempCon)->CONTA),;
										"CENTRO_CUSTO": Alltrim((ctempCon)->CENTRO_CUSTO),;
										"ITEM_CONTABIL": Alltrim((ctempCon)->ITEM_CONTABIL),;
										"CLASSE_VALOR": Alltrim((ctempCon)->CLASSE_VALOR),;
										"DDATA": Alltrim((ctempCon)->DDATA),;
										"TPSALD": Alltrim((ctempCon)->TPSALD),;
										"DC": Alltrim((ctempCon)->DC),;
										"LOTE": Alltrim((ctempCon)->LOTE),;
										"SUBLOTE": Alltrim((ctempCon)->SUBLOTE),;
										"DOC": Alltrim((ctempCon)->DOC),;
										"LINHA": Alltrim((ctempCon)->LINHA),;
										"XPARTIDA": Alltrim((ctempCon)->XPARTIDA),;
										"HIST": Alltrim((ctempCon)->HIST),;
										"SEQHIS": Alltrim((ctempCon)->SEQHIS),;
										"SEQLAN": Alltrim((ctempCon)->SEQLAN),;
										"EMPORI": Alltrim((ctempCon)->EMPORI),;
										"FILORI": Alltrim((ctempCon)->FILORI),;
										"ENT05": Alltrim((ctempCon)->ENT05),;
										"ENT06": Alltrim((ctempCon)->ENT06),;
										"ENT07": Alltrim((ctempCon)->ENT07),;
										"ENT08": Alltrim((ctempCon)->ENT08),;
										"ENT09": Alltrim((ctempCon)->ENT09),;
										"VALOR": (ctempCon)->SALDO,;
										"IDLANC": (ctempCon)->MSUIDT,;
										"DELETADO": (ctempCon)->DELETADO})
				(ctempCon)->(DbSkip())
				End

				(ctempCon)->(DBCLOSEAREA())
				oRest:appendKeyHeaderResponse("Content-Type","application/json")
				oRest:setStatusCode(oJConexao["codigo"])
				oRest:setResponse(oJRes:toJson())
			EndIf
		EndIf
	Else
		oRest:appendKeyHeaderResponse("Content-Type","application/json")
		oRest:setStatusCode(500)
		oRest:setResponse('{"msg":"Parse Json ERROR."}')
	Endif
Return
