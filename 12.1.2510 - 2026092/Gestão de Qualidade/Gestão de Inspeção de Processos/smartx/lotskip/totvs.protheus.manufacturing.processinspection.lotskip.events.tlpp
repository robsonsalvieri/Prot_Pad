#include "fw-tlpp-core.th"
#include "totvs.ch"
#include "totvs.framework.model.events.th"
#include "totvs.protheus.manufacturing.processinspection.lotskip.events.ch"

namespace totvs.protheus.manufacturing.processinspection

/*/{Protheus.doc} LotSkipEvents
Preserva as validacoes de persistencia da QIPA130.
@type class
@author brunno.costa / rafael.kleestadt
@since 13/08/2026
/*/
class LotSkipEvents
    public method new() as object

    @beforeCreateInTransaction()
    public method beforeCreateInTransaction(oData, oModel, oError) as logical

    @beforeUpdateInTransaction()
    public method beforeUpdateInTransaction(oData, oModel, oError) as logical

    @beforeDeleteInTransaction()
    public method beforeDeleteInTransaction(oData, oModel, oError) as logical

    private method validatePersistence(oData, oError) as logical
    private method setInvertedQuantity(oData as object)

    public method getNextSkipLotCodeValue() as character
    public method addNextSkipLotCodeInitializer(oModel as object)
endclass

/*/{Protheus.doc} new
Construtor da classe.
@author brunno.costa / rafael.kleestadt
@since 13/08/2026
@version P12.1.2610
@return self, objeto, instancia da classe
/*/
method new() as object class LotSkipEvents
return self

/*/{Protheus.doc} beforeCreateInTransaction
Valida inclusao conforme A130EnOK.
@type method
@author brunno.costa / rafael.kleestadt
@since 13/08/2026
@param oData, object, Dados da operacao
@param oModel, object, Modelo SmartX
@param oError, object, Retorno de erro
@return logical, Permissao para incluir
/*/
method beforeCreateInTransaction(oData as object, oModel as object, oError as object) as logical class LotSkipEvents
    self:setInvertedQuantity(oData)
return self:validatePersistence(oData, oError)

/*/{Protheus.doc} beforeUpdateInTransaction
Valida alteracao conforme A130EnOK.
@type method
@author brunno.costa / rafael.kleestadt
@since 13/08/2026
@param oData, object, Dados da operacao
@param oModel, object, Modelo SmartX
@param oError, object, Retorno de erro
@return logical, Permissao para alterar
/*/
method beforeUpdateInTransaction(oData as object, oModel as object, oError as object) as logical class LotSkipEvents
    self:setInvertedQuantity(oData)
return self:validatePersistence(oData, oError)

/*/{Protheus.doc} setInvertedQuantity
Preenche QPF_QTDINV conforme gravacao legada de A130ISkL.
@type method
@author brunno.costa / rafael.kleestadt
@since 13/08/2026
@param oData, object, Dados da operacao
/*/
method setInvertedQuantity(oData as object) class LotSkipEvents
    Local nQuantity := oData:getFieldValue("QPF", "QPF_QTDE") as numeric

    oData:setFieldValue("QPF", "QPF_QTDINV",, cValToChar(Inverte(StrZero(nQuantity, 4))))
return

/*/{Protheus.doc} addNextSkipLotCodeInitializer
Sugere o proximo codigo do Skip-Lote ao iniciar a inclusao.
@type method
@author brunno.costa / rafael.kleestadt
@since 13/08/2026
@param oModel, object, Modelo SmartX
/*/
method addNextSkipLotCodeInitializer(oModel as object) class LotSkipEvents

    Local oEvents      as object
    Local oSetFields   as object
    Local oAdvplAct    as object
    Local oTargetField as object

    oTargetField := totvs.framework.structure.interface.BuildTargetFieldStructure():new()
    oTargetField:setIdentifier("QPF_SKPLOT")
    oTargetField:setValue("{{$response.QPF_SKPLOT}}")
    oTargetField:setProperty("readOnly", .F.)

    oSetFields := totvs.framework.structure.interface.BuildSetFieldsAction():new()
    oSetFields:setLabel("setProcessLotSkipNextCode")
    oSetFields:setIdentifier("setProcessLotSkipNextCode")
    oSetFields:addTargetField(oTargetField:getStructure())

    oAdvplAct := totvs.framework.structure.interface.BuildAdvplAction():new()
    oAdvplAct:setLabel("getProcessLotSkipNextCode")
    oAdvplAct:setRoutine( ;
        "totvs.protheus.manufacturing.processinspection." + ;
        "getProcessLotSkipNextCodeInitializer" ;
    )
    oAdvplAct:setHasResponse(.T.)
    oAdvplAct:setAction(oSetFields:getAction())

    oEvents := totvs.framework.structure.interface.BuildEvents():new()
    oEvents:addOnLoad( {"dataNew"}, , oAdvplAct:getAction() )

    oModel:addInitializers(oEvents:getEvents())

return

/*/{Protheus.doc} getProcessLotSkipNextCodeInitializer
Faz a chamada do Advpl para obter o proximo codigo do Skip-Lote.
@type  Function
@author rafael.kleestadt
@since 14/08/2026
@version P12.1.2610
@return json, json, proximo codigo do Skip-Lote
@see https://tdn.totvs.com/x/fY--Pg
/*/
Function getProcessLotSkipNextCodeInitializer()

    Local jResponse      := JsonObject():new() as json
    Local oLotSkipEvents := LotSkipEvents():new() as object

    jResponse["QPF_SKPLOT"] := oLotSkipEvents:getNextSkipLotCodeValue()

return jResponse:ToJson()

/*/{Protheus.doc} getNextSkipLotCodeValue
Replica a sugestao de codigo da A130WhSk.
@type method
@author brunno.costa / rafael.kleestadt
@since 13/08/2026
@return character, Proximo codigo sugerido para QPF_SKPLOT
/*/
method getNextSkipLotCodeValue() as character class LotSkipEvents
    Local aArea := GetArea() as array
    Local cSkipLot := Space(2) as character

    DbSelectArea("QPF")
    DbSetOrder(1)

    If DbSeek(xFilial("QPF"))
        While !QPF->(Eof()) .And. QPF->QPF_FILIAL == xFilial("QPF")
            cSkipLot := QPF->QPF_SKPLOT
            QPF->(DbSkip())
        EndDo
    EndIf

    RestArea(aArea)
return StrZero(Val(cSkipLot) + 1, 2)

/*/{Protheus.doc} beforeDeleteInTransaction
Impede excluir Skip-Lote utilizado em QP6, conforme A130DSkL.
@type method
@author brunno.costa / rafael.kleestadt
@since 13/08/2026
@param oData, object, Dados da operacao
@param oModel, object, Modelo SmartX
@param oError, object, Retorno de erro
@return logical, Permissao para excluir
/*/
method beforeDeleteInTransaction(oData as object, oModel as object, oError as object) as logical class LotSkipEvents
    Local aArea := GetArea() as array
    Local cCode := oData:getFieldValue("QPF", "QPF_SKPLOT") as character
    Local lValid := .T. as logical

    DbSelectArea("QP6")
    DbGoTop()
    While lValid .And. !QP6->(Eof())
        If !QP6->(Deleted()) .And. QP6->QP6_SKPLOT == cCode
            //STR0001 - "Skip-Lote em uso."
            //STR0002 - "Existe relacionamento em QP6 para o Skip-Lote "
            oError:set(400, STR0001, STR0002 + cCode + ".")
            lValid := .F.
        EndIf
        QP6->(DbSkip())
    EndDo

    RestArea(aArea)
return lValid

/*/{Protheus.doc} validatePersistence
Preserva duplicidade Unidade/Frequencia e o Skip-Lote base obrigatorio de A130EnOK.
@type method
@author brunno.costa / rafael.kleestadt
@since 13/08/2026
@param oData, object, Dados da operacao
@param oError, object, Retorno de erro
@return logical, Resultado da validacao
/*/
method validatePersistence(oData as object, oError as object) as logical class LotSkipEvents
    Local aArea    := GetArea() as array
    Local cCode    := oData:getFieldValue("QPF", "QPF_SKPLOT") as character
    Local cUnit    := PadR(oData:getFieldValue("QPF", "QPF_UNSKLT"), TamSX3("QPF_UNSKLT")[1]) as character
    Local lValid   := .T. as logical
    Local nQty     := oData:getFieldValue("QPF", "QPF_QTDE") as numeric

    DbSelectArea("QPF")
    DbSetOrder(2)

    If DbSeek(xFilial("QPF") + cUnit + Str(nQty, 4)) .And. QPF->QPF_SKPLOT != cCode
        //STR0003 - "Skip-Lote duplicado."
        //STR0004 - "Já existe Skip-Lote com esta unidade e frequência."
        oError:set(400, STR0003, STR0004)
        lValid := .F.
    EndIf

    If lValid .And. !(cUnit == "1" .And. nQty == 1) .And. !DbSeek(xFilial("QPF") + "1" + Str(1, 4))
        //STR0005 - "Skip-Lote obrigatório."
        //STR0006 - "O Skip-Lote de unidade 1 e frequência 1 deve estar cadastrado."        
        oError:set(400, STR0005, STR0006)
        lValid := .F.
    EndIf

    RestArea(aArea)
return lValid
