#include "fw-tlpp-core.th"
#include "totvs.ch"
#include "totvs.framework.structure.model.th"
#include "totvs.protheus.manufacturing.processinspection.lotskip.valids.ch"

namespace totvs.protheus.manufacturing.processinspection

using namespace totvs.framework.structure.object
 
/*/{Protheus.doc} validateQPFSkipLot
Valida a chave QPF_SKPLOT.
@type function 
@author brunno.costa / rafael.kleestadt
@since 13/08/2026
@param xValue, variant, Valor 
@param cField, character, Campo 
@param aContextInfo, array, Contexto
@return json, Resultado
/*/
Function validateQPFSkipLot(xValue, cField, aContextInfo)
Return validateQPFValue(xValue, cField, aContextInfo, "QPF_SKPLOT")

/*/{Protheus.doc} validateQPFUnit
Valida o dominio 12 de QPF_UNSKLT.
@type function 
@author brunno.costa / rafael.kleestadt
@since 13/08/2026
@param xValue, variant, Valor 
@param cField, character, Campo 
@param aContextInfo, array, Contexto
@return json, Resultado
/*/
Function validateQPFUnit(xValue, cField, aContextInfo)
Return validateQPFValue(xValue, cField, aContextInfo, "QPF_UNSKLT")

/*/{Protheus.doc} validateQPFQuantity
Valida QPF_QTDE maior que zero.
@type function 
@author brunno.costa / rafael.kleestadt
@since 13/08/2026
@param xValue, variant, Valor 
@param cField, character, Campo 
@param aContextInfo, array, Contexto
@return json, Resultado
/*/
Function validateQPFQuantity(xValue, cField, aContextInfo)
Return validateQPFValue(xValue, cField, aContextInfo, "QPF_QTDE")

/*/{Protheus.doc} validateQPFValue
Executa a regra SX3 do campo QPF.
@type function 
@author brunno.costa / rafael.kleestadt
@since 13/08/2026
@param xValue, variant, Valor 
@param cField, character, Campo 
@param aContextInfo, array, Contexto
@param cExpectedField, character, Campo esperado
@return json, Resultado
/*/
Static Function validateQPFValue(xValue, cField, aContextInfo, cExpectedField)
    Local cMessage := STR0001 as character // "Não foi possível executar a validação porque o contexto recebido e inválido."
    Local lValid   := .F. as logical

    If ValType(cField) == "C" .And. ValType(aContextInfo) == "A" .And. Upper(AllTrim(cField)) == cExpectedField
        If cExpectedField == "QPF_SKPLOT" .And. ValType(xValue) == "C"
            lValid := ExistChav("QPF", xValue)
            cMessage := STR0002 // "Código de Skip-Lote inválido."
        ElseIf cExpectedField == "QPF_UNSKLT" .And. ValType(xValue) == "C"
            lValid := Len(xValue) == 1 .And. xValue $ "12"
            cMessage := STR0003 // "Unidade de Skip-Lote inválida. Valores permitidos: 1 ou 2."
        ElseIf cExpectedField == "QPF_QTDE" .And. ValType(xValue) == "N"
            lValid := xValue > 0
            cMessage := STR0004 // "A quantidade deve ser maior que zero."
        EndIf

        If lValid
            cMessage := ""
        EndIf
    EndIf

Return buildValidationResult(lValid, cMessage)

/*/{Protheus.doc} buildValidationResult
Monta o contrato de retorno de uma validacao de campo SmartX.
@type function
@author brunno.costa / rafael.kleestadt
@since 13/08/2026
@param lValid, logical, Indica se o valor informado e valido
@param cMessage, character, Mensagem apresentada em caso de falha
@return json, Contrato de retorno esperado pelo SmartX
/*/
Static Function buildValidationResult(lValid, cMessage)
    Local jResult as json

    jResult := JsonObject():new()
    jResult["return"] := lValid
    jResult["notValidMessage"] := cMessage

Return jResult
