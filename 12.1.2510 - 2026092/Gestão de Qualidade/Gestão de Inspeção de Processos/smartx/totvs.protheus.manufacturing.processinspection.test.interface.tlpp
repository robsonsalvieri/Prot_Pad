#include "fw-tlpp-core.th"
#include "totvs.ch"
#include "totvs.framework.structure.Interface.th"
#include "fweventviewconsts.ch"
#include "totvs.protheus.manufacturing.processinspection.test.interface.ch"
 
/*/-----------------------------------------------------------
{Protheus.doc} totvs.framework.interface.TestInterface
 
Classe de interface do Cadastro de Ensaios
 
@type Class
@author rafael.kleestadt
@version P12
-----------------------------------------------------------/*/

namespace totvs.protheus.manufacturing.processinspection
 
@totvsFrameworkStructureInterface(lookup = .F., country = "All")

/*/{Protheus.doc} TestInterface
Classe da interface de cadastro de ensaios, responsável por definir os componentes visuais, ações e eventos relacionados à tela.
@author rafael.kleestadt
@since 16/04/2026
@version P12
/*/
Class TestInterface
    Private Data oDataDetail as object
    Private Data oDataEdit   as object
    Private Data oDataNew    as object
    Private Data oDataView   as object
    Private Data oInterface  as object

    Public Method new() as object
    Public Method setInterface()
    Public Method getContract() as json
    Public Method retornaCoresLegendasCartas() as object
 
EndClass

/*/{Protheus.doc} new
Método construtor da Classe TestInterface.
É chamado automaticamente ao criar uma instância da Classe.
@author rafael.kleestadt
@since 16/04/2026
@version P12
@Return self, object, Retorna a própria instância da Classe (self).
/*/
Method new() as object Class TestInterface
Return Self
 
/*/{Protheus.doc} setInterface
Configura a interface do cadastro de ensaios, definindo os componentes visuais, ações e eventos relacionados à tela.
@author rafael.kleestadt
@since 16/04/2026
@version P12
/*/
Method setInterface() Class TestInterface
    Local aElements       := {} as array
    local cId             := "TestInterface" as character
    local cModel          := "totvs.protheus.manufacturing.processinspection.TestModel" as character
    local oComponent      := totvs.framework.structure.interface.BuildComponent():new() as object
    local oElementsHeader := totvs.framework.structure.interface.BuildElementsFromCode():new() As object
    local oElementsTexto  := totvs.framework.structure.interface.BuildElementsFromCode():new() As object
    local oGridSystem     := totvs.framework.structure.interface.BuildGridSystem():new() as object
    Local oSection1       := totvs.framework.structure.interface.BuildSectionsFromCode():new() As object

    // Configuração da interface de usuário para o cadastro de ensaios.
    // 1. Cria a interface com um identificador único (cId).
    // 2. Define o título exibido na interface.
    // 3. Associa um modelo de dados com leiaute automático.
    // 4. Especifica a versão da interface.
    Self:oInterface := totvs.framework.structure.interface.BuildContract():new(cId) //aciona model
    Self:oInterface:setTitle(STR0001) //"Cadastro de Ensaios"
    Self:oInterface:setModelId( cModel, .T./*leiaute automatico*/)
    Self:oInterface:setVersion( "2.0" )

    //Método utilizado para definir o tamanho do campo no grid system para o tamanho de tela XL, LG, MD, SM e XS
    oGridSystem:setColumnsXl(12)
    oGridSystem:setColumnsLg(12) 
    oGridSystem:setColumnsMd(12)
    oGridSystem:setColumnsSm(12)
    oComponent:setTextArea(10, STR0002, oGridSystem:getGridSystem()) //"Método"

    // Configuração das interfaces para as operações de ensaios:
    // - Self:oDataNew: Tela para incluir um novo ensaio.
    // - Self:oDataEdit: Tela para editar um ensaio existente.
    // - Self:oDataDetail: Tela para visualizar os detalhes de um ensaio.
    // - Self:oDataView: Tela para listar todos os ensaios.
    Self:oDataNew := totvs.framework.structure.interface.BuildDataNew():new("TestInterfaceNew", cModel)
    Self:oDataNew:setTitle(STR0003) //"Incluir Ensaio"
    Self:oDataNew:AddComponent( "QP1", "QA2TEXTO", oComponent:getTextArea())
    
    Self:oDataEdit := totvs.framework.structure.interface.BuildDataEdit():new("TestInterfaceEdit", cModel)
    Self:oDataEdit:setTitle(STR0004) //"Editar Ensaio"
    Self:oDataEdit:AddComponent( "QP1", "QA2TEXTO", oComponent:getTextArea())
    
    Self:oDataDetail := totvs.framework.structure.interface.BuildDataDetail():new("TestInterfaceDetail", cModel)
    Self:oDataDetail:setTitle(STR0005) //"Visualizar Ensaio"
    Self:oDataDetail:AddComponent( "QP1", "QA2TEXTO", oComponent:getTextArea())

    Self:oDataView := totvs.framework.structure.interface.BuildDataView():new("TestInterfaceView", cModel)
    Self:oDataView:setTitle(AllTrim(FWX2Nome("QP1"))) //"Ensaios"
    Self:oDataView:assignInvisibleFields() //Exibe apenas os campos configurados com X3_BROWSE = "S" no dicionário de dados.  
   
    // Configuração para exibir o campo QP1_CARTA como um label com cores, utilizando a função retornaCoresLegendasCartas para definir as cores das legendas.
    Self:oDataView:setFieldAsLabel("QP1","QP1_CARTA", Self:retornaCoresLegendasCartas():getObject(), .F. /* .T. Ajusta ordem para a primeira posição, .F. mantém ordenação atual do campo */)

    // Definição dos elementos da interface, organizando os campos em seções e configurando suas propriedades.
    oElementsHeader:addElements({"QP1_CARTA","QP1_DESCES","QP1_DESCIN","QP1_ENSAIO","QP1_DESCPO","QP1_DESCAR","QP1_QTDE","QP1_NIENSR","QP1_METODO", "QP1_TIPO","QP2"}, .F.)

    // Configuração de uma seção para agrupar os campos relacionados ao texto do método do ensaio, utilizando os elementos definidos em oElementsTexto.
    oElementsTexto:addElements({"QA2TEXTO"}, .F.)
    oSection1:addSections(STR0006, oElementsTexto:getElements()) //"Método do Ensaio"

    aElements := totvs.framework.structure.interface.BuildElementsFromCode():mergeElements(oElementsHeader:getElements(), {oSection1:getSections()} )

    Self:oDataNew:setElement( aElements )
    Self:oDataEdit:setElement( aElements)
    Self:oDataDetail:setElement( aElements )
    
    // Configuração dos dados da interface para diferentes modos de operação:
    // - Inclusão, Alteração, Visualização Detalhada e Navegação (Browse).
    // O segundo parâmetro (.f.) indica que não será feita a busca pelos folders do dicionário, exceto no modo Browse.
    Self:oInterface:setDataNew(Self:oDataNew:getDataNew(), .f.)           // Modo de inclusão
    Self:oInterface:setDataEdit(Self:oDataEdit:getDataEdit(), .f.)        // Modo de alteração
    Self:oInterface:setDataDetail(Self:oDataDetail:getDataDetail(), .f.)  // Modo de visualização detalhada
    Self:oInterface:setDataView(Self:oDataView:getDataView())             // Modo de navegação (Browse)
 
Return

/*/{Protheus.doc} getContract
Método que retorna o contrato da interface, contendo a definição dos componentes visuais, ações e eventos relacionados à tela de cadastro de ensaios.
@author framework
@since 16/04/2026
@version P12
@Return Return_var, Return_type, Return_description
/*/
Method getContract() as json Class TestInterface
Return Self:oInterface:getContract()

/*/{Protheus.doc} retornaCoresLegendasCartas
Método para obter as cores das legendas do campo QP1_CARTA
@type Method
@author rafael.kleestadt
@since 16/04/2026
@version P12
@Return oCores, object, Objeto contendo as cores das legendas
/*/
Method retornaCoresLegendasCartas() as object Class TestInterface
    
    local oCores := totvs.framework.structure.interface.LabelColors():new() as object

    oCores:bindColor("C",   "C",   "blue1")   //NUM. NAO CONFORMIDADES                                 
    oCores:bindColor("HIS", "HIS", "red1")    //HISTOGRAMA                                             
    oCores:bindColor("IND", "IND", "green3")  //INDIVIDUAIS                                            
    oCores:bindColor("NP",  "NP",  "purple1") //NUM. UNIDADES NAO CONFORME                             
    oCores:bindColor("P",   "P",   "yellow1") //PORC. UNID. NAO CONFORME                               
    oCores:bindColor("TXT", "TXT", "blue4")   //TEXTO                                                  
    oCores:bindColor("U",   "U",   "green1")  //NUM. NAO CONFORM. P/ UNID.                             
    oCores:bindColor("XBR", "XBR", "purple2") //MEDIAS E AMPLITUDES                                    
    oCores:bindColor("XBS", "XBS", "green4")  //MEDIAS E DESVIO PADRAO                                 
    oCores:bindColor("XMR", "XMR", "blue3")   //MEDIANAS E AMPLITUDES                                  

Return oCores
