#include "fw-tlpp-core.th"
#include "totvs.ch"
#include "totvs.framework.structure.model.th"
#include "totvs.protheus.manufacturing.incominginspection.reportedqualityindex.valids.ch"

namespace totvs.protheus.manufacturing.incominginspection

using namespace totvs.framework.structure.object

/*/{Protheus.doc} validateQE0Month
Valida o mês QE0_MES conforme o X3_VALID legado.
@type function
@author brunno.costa / rafael.kleestadt
@since 19/08/2026
@param xValue, variant, Valor do campo
@param cField, character, Campo em validação
@param aContextInfo, array, Contexto resolvido pelo cliente
@return json, Resultado da validação
/*/
Function validateQE0Month(xValue, cField, aContextInfo)
    Local lValid := .F. as logical
    Local nMonth := 0   as numeric

    If vldContext(xValue, cField, aContextInfo, "QE0_MES")
        nMonth := Val(xValue)
        lValid := (nMonth == Int(nMonth)) .And. (nMonth > 0 .And. nMonth < 13)
    EndIf
Return buildQE0Result(lValid, STR0001) // "Mês deve estar entre 01 e 12."

/*/{Protheus.doc} validateQE0Supplier
Valida o fornecedor QE0_FORNEC conforme o X3_VALID legado.
@type function
@author brunno.costa / rafael.kleestadt
@since 19/08/2026
@param xValue, variant, Valor do campo
@param cField, character, Campo em validação
@param aContextInfo, array, Contexto resolvido pelo cliente
@return json, Resultado da validação
/*/
Function validateQE0Supplier(xValue, cField, aContextInfo)
    Local lValid := .F. as logical

    If vldContext(xValue, cField, aContextInfo, "QE0_FORNEC")    
        lValid := ExistCpo("SA2", xValue)
    EndIf
Return buildQE0Result(lValid, STR0002) // "Fornecedor não cadastrado."

/*/{Protheus.doc} validateQE0Product
Valida o produto QE0_PRODUT conforme o X3_VALID legado.
@type function
@author brunno.costa / rafael.kleestadt
@since 19/08/2026
@param xValue, variant, Valor do campo
@param cField, character, Campo em validação
@param aContextInfo, array, Contexto resolvido pelo cliente
@return json, Resultado da validação
/*/
Function validateQE0Product(xValue, cField, aContextInfo)
    Local lValid := .F. as logical

    If vldContext(xValue, cField, aContextInfo, "QE0_PRODUT")
        lValid := ExistCpo("QE6", xValue)
    EndIf
Return buildQE0Result(lValid, STR0003) // "Produto não cadastrado."

/*/{Protheus.doc} validateQE0Index
Valida o índice informado conforme A280Obrig: o índice deve existir na
QF1 e ser do tipo Informado (QF1_CALC=="I"). A duplicidade da chave
ano+mês+fornecedor+produto+índice NÃO é verificada aqui, e sim nos
eventos de gravação beforeCreateInTransaction/beforeUpdateInTransaction
(ReportedQualityIndexEvents), onde o RECNO do registro em edição está
disponível para desconsiderar o próprio registro na alteração.
Chamado por meio do x3_vldsmx do campo QE0_INDICE
@type function
@author brunno.costa / rafael.kleestadt
@since 19/08/2026
@param xValue, variant, Valor do campo (QE0_INDICE)
@param cField, character, Campo em validação
@param aContextInfo, array, Contexto resolvido pelo cliente
@return json, Resultado da validação
/*/
Function validateQE0Index(xValue, cField, aContextInfo)
    Local aAreaQF1 := {} as array
    Local cMessage := "" as character
    Local lValid   := .F. as logical

    If vldContext(xValue, cField, aContextInfo, "QE0_INDICE")
        aAreaQF1 := QF1->(GetArea())
        QF1->(DbSetOrder(1))
        If !QF1->(DbSeek(xFilial("QF1") + xValue))
            cMessage := STR0004 // "índice não cadastrado."
        ElseIf QF1->QF1_CALC <> "I"
            cMessage := STR0005 // "índice não é do tipo informado."
        Else
            lValid := .T.
        EndIf
        RestArea(aAreaQF1)
    EndIf
Return buildQE0Result(lValid, cMessage)

/*/{Protheus.doc} validateQE0Value
Valida o valor percentual QE0_VALOR conforme o X3_VALID legado.
@type function
@author brunno.costa / rafael.kleestadt
@since 19/08/2026
@param xValue, variant, Valor do campo
@param cField, character, Campo em validação
@param aContextInfo, array, Contexto resolvido pelo cliente
@return json, Resultado da validação
/*/
Function validateQE0Value(xValue, cField, aContextInfo)
    Local lValid := .F. as logical

    If vldContext(xValue, cField, aContextInfo, "QE0_VALOR")
        lValid := xValue >= 0.00 .And. xValue <= 100.00
    EndIf
Return buildQE0Result(lValid, STR0007) // "Valor deve estar entre 0,00 e 100,00."

/*/{Protheus.doc} buildQE0Result
Monta o JSON de retorno padrão do contrato serverValidate do Smart X.
@type function
@author brunno.costa / rafael.kleestadt
@since 19/08/2026
@param lValid, logical, Resultado da validação
@param cMessage, character, Mensagem de falha (ignorada se lValid)
@return json, Contrato {return, notValidMessage}
/*/
Static Function buildQE0Result(lValid, cMessage)
    Local jResult := JsonObject():new() as json

    If lValid
        cMessage := ""
    EndIf
    jResult["return"] := lValid
    jResult["notValidMessage"] := cMessage
Return jResult

/*/{Protheus.doc} vldContext
Valida se o contexto recebido é válido para a validação de campo SmartX.
@type  Static Function
@author rafael.kleestadt
@since 19/08/2026
@version P12.1.2610
@param xValue, variante, Valor informado para o campo em validação
@param cField, character, Nome do campo em validação
@param aContextInfo, array, Informações adicionais do contexto SmartX
@param cExpectedField, character, Nome do campo esperado para a validação
@return lValid, Lógico, Indica se o contexto recebido é válido para a validação de campo SmartX
/*/
Static Function vldContext(xValue, cField, aContextInfo, cExpectedField)
    Local lValid := .F.

    Default aContextInfo := {}

    If ValType(cField) == "C" .And. ValType(xValue) == FWSX3Util():GetFieldType(cField) .And. ValType(aContextInfo) == "A" .And. Upper(AllTrim(cField)) == cExpectedField
        lValid := .T.
    EndIf
    
Return lValid
