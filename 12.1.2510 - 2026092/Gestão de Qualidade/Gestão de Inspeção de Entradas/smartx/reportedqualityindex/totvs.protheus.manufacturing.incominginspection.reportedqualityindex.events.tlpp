#include "fw-tlpp-core.th"
#include "totvs.ch"
#include "totvs.framework.model.events.th"
#include "totvs.framework.structure.interface.th"

namespace totvs.protheus.manufacturing.incominginspection

using namespace totvs.framework.structure.interface

/*/{Protheus.doc} ReportedQualityIndexEvents
Eventos SmartX do índice de qualidade informado.
@type class
@author brunno.costa / rafael.kleestadt
@since 19/08/2026
/*/
class ReportedQualityIndexEvents
    public method new() as object

    @Post("getQualityIndexSupplierDescription/:code")
    public method getSupplierDescription() as logical

    @Post("getQualityIndexProductDescription/:code")
    public method getProductDescription() as logical

    public method addDescriptionTriggers(oModel as object)

    @beforeCreateInTransaction()
    public method beforeCreateInTransaction(oData, oModel, oError) as logical

    @beforeUpdateInTransaction()
    public method beforeUpdateInTransaction(oData, oModel, oError) as logical

    private method validateKeyDuplicate(oData, oError, nCurRecno) as logical
endclass

/*/{Protheus.doc} new
Método construtor da classe.
@type method
@author brunno.costa / rafael.kleestadt
@since 19/08/2026
@return object, instância da classe
/*/
method new() as object class ReportedQualityIndexEvents
return self

/*/{Protheus.doc} addDescriptionTriggers
Registra as descrições derivadas de fornecedor e produto.
@type method
@author brunno.costa / rafael.kleestadt
@since 19/08/2026
@param oModel, object, Modelo SmartX
/*/
method addDescriptionTriggers(oModel as object) class ReportedQualityIndexEvents
    Local oSupplierCall   as object
    Local oProductCall    as object
    Local oSupplierSet    as object
    Local oProductSet     as object
    Local oSupplierTarget as object
    Local oProductTarget  as object
    Local oEvents         as object

    /*-----------Início da trigger da descrição do fornecedor-----------*/
    oSupplierCall := BuildApiCallAction():new()
    oSupplierCall:setLabel("getQualityIndexSupplierDescription")
    oSupplierCall:setIdentifier("getQualityIndexSupplierDescription")
    oSupplierCall:setHTTPMethod("POST")
    oSupplierCall:setEndpoint("../../../getQualityIndexSupplierDescription/{{$model.QE0_FORNEC}}")
    
    oSupplierTarget := BuildTargetFieldStructure():new()
    oSupplierTarget:setIdentifier("QE0_DESCFO")
    oSupplierTarget:setValue("{{$response.QE0_DESCFO}}")
    oSupplierTarget:setProperty("readOnly", .T.)

    oSupplierSet := BuildSetFieldsAction():new()
    oSupplierSet:setLabel("setQualityIndexSupplierDescription")
    oSupplierSet:setIdentifier("setQualityIndexSupplierDescription")
    oSupplierSet:addTargetField(oSupplierTarget:getStructure())

    oSupplierCall:setActionSuccess(oSupplierSet:getAction())
    /*-----------Fim da trigger da descrição do fornecedor-----------*/

    /*-----------Início da trigger da descrição do produto-----------*/
    oProductCall := BuildApiCallAction():new()
    oProductCall:setLabel("getQualityIndexProductDescription")
    oProductCall:setIdentifier("getQualityIndexProductDescription")
    oProductCall:setHTTPMethod("POST")
    oProductCall:setEndpoint("../../../getQualityIndexProductDescription/{{$model.QE0_PRODUT}}")
    
    oProductTarget := BuildTargetFieldStructure():new()
    oProductTarget:setIdentifier("QE0_DESCPR")
    oProductTarget:setValue("{{$response.QE0_DESCPR}}")
    oProductTarget:setProperty("readOnly", .T.)
    
    oProductSet := BuildSetFieldsAction():new()
    oProductSet:setLabel("setQualityIndexProductDescription")
    oProductSet:setIdentifier("setQualityIndexProductDescription")
    oProductSet:addTargetField(oProductTarget:getStructure())
    
    oProductCall:setActionSuccess(oProductSet:getAction())
    /*-----------Fim da trigger da descrição do produto-----------*/

    oEvents := BuildEvents():new()
    oEvents:addOnChange({"dataNew"},    {"QE0_FORNEC"}, oSupplierCall:getAction())
    oEvents:addOnChange({"dataEdit"},   {"QE0_FORNEC"}, oSupplierCall:getAction())

    oEvents:addOnChange({"dataNew"},    {"QE0_PRODUT"}, oProductCall:getAction())
    oEvents:addOnChange({"dataEdit"},   {"QE0_PRODUT"}, oProductCall:getAction())

    oModel:addTriggers(oEvents:getEvents())
return

/*/{Protheus.doc} getSupplierDescription
Retorna a descrição do fornecedor (SA2), reproduzindo a ramificação
"F" de A280Descr sem depender da variável global Inclui -- A280Descr
permanece inalterada no fonte legado para outros usos.
@type method
@author brunno.costa / rafael.kleestadt
@since 19/08/2026
@return logical, Atendimento REST concluído
/*/
method getSupplierDescription() as logical class ReportedQualityIndexEvents
    Local aArea     := SA2->(GetArea()) as array
    Local cCode     := "" as character
    Local cDesc     := "" as character
    Local jPath     := oRest:getPathParamsRequest() as json
    Local jResponse := JsonObject():new() as json

    cCode := jPath["code"]
    If !Empty(cCode)
        SA2->(DbSetOrder(1))
        If SA2->(DbSeek(xFilial("SA2") + cCode))
            cDesc := SA2->A2_NOME
        EndIf
    EndIf
    RestArea(aArea)

    jResponse["QE0_DESCFO"] := cDesc
    oRest:setKeyHeaderResponse("Content-Type", "application/json")
    oRest:setResponse(jResponse:ToJson())
return .T.

/*/{Protheus.doc} getProductDescription
Retorna a descrição do produto (QE6), reproduzindo a ramificação "P"
de A280Descr sem depender da variável global Inclui -- A280Descr
permanece inalterada no fonte legado para outros usos.
@type method
@author brunno.costa / rafael.kleestadt
@since 19/08/2026
@return logical, Atendimento REST concluído
/*/
method getProductDescription() as logical class ReportedQualityIndexEvents
    Local aArea     := QE6->(GetArea()) as array
    Local cCode     := "" as character
    Local cDesc     := "" as character
    Local jPath     := oRest:getPathParamsRequest() as json
    Local jResponse := JsonObject():new() as json

    cCode := jPath["code"]
    If !Empty(cCode)
        QE6->(DbSetOrder(1))
        If QE6->(DbSeek(xFilial("QE6") + cCode))
            cDesc := QE6->QE6_DESCPO
        EndIf
    EndIf
    RestArea(aArea)

    jResponse["QE0_DESCPR"] := cDesc
    oRest:setKeyHeaderResponse("Content-Type", "application/json")
    oRest:setResponse(jResponse:ToJson())
return .T.

/*/{Protheus.doc} beforeCreateInTransaction
Valida duplicidade da chave ano+mes+fornecedor+produto+indice na
inclusao, reproduzindo o Help legado JAGRAVADO de A280Obrig. Como e'
inclusao, nenhum registro e' desconsiderado (nCurRecno = 0).
@type method
@author brunno.costa / rafael.kleestadt
@since 19/08/2026
@param oData, object, Dados da operacao
@param oModel, object, Modelo SmartX
@param oError, object, Retorno de erro
@return logical, Permissao para incluir
/*/
method beforeCreateInTransaction(oData, oModel, oError) as logical class ReportedQualityIndexEvents
return self:validateKeyDuplicate(oData, oError, 0)

/*/{Protheus.doc} beforeUpdateInTransaction
Valida duplicidade da chave ano+mes+fornecedor+produto+indice na
alteracao, desconsiderando o proprio registro em edicao -- QE0 ja esta
posicionado no registro sendo alterado neste ponto da transacao, entao
QE0->(Recno()) identifica com seguranca qual linha excluir da checagem,
sem depender de M-> nem de reconstruir a chave original.
@type method
@author brunno.costa / rafael.kleestadt
@since 19/08/2026
@param oData, object, Dados da operacao
@param oModel, object, Modelo SmartX
@param oError, object, Retorno de erro
@return logical, Permissao para alterar
/*/
method beforeUpdateInTransaction(oData, oModel, oError) as logical class ReportedQualityIndexEvents
    Local nCurRecno := QE0->(Recno()) as numeric
return self:validateKeyDuplicate(oData, oError, nCurRecno)

/*/{Protheus.doc} validateKeyDuplicate
Bloqueia a gravacao quando ja existir outro registro na QE0 com a mesma
combinacao de ano+mes+fornecedor+produto+indice, desconsiderando
nCurRecno (0 na inclusao, recno do proprio registro na alteracao). Usa
a ordem 1 de QE0 (QE0_FILIAL+QE0_ANO+QE0_MES+QE0_FORNEC+QE0_PRODUT+
QE0_INDICE) e preenche cada campo com PadR ate o tamanho do dicionario
para o seek posicionar corretamente em campos de tamanho fixo. Preserva
o identificador de Help legado JAGRAVADO (STR0006 do modulo VALIDS).
@type method
@author brunno.costa / rafael.kleestadt
@since 19/08/2026
@param oData, object, Dados da operacao
@param oError, object, Retorno de erro
@param nCurRecno, numeric, Recno desconsiderado na checagem (0 = nenhum)
@return logical, Ausencia de duplicidade
/*/
method validateKeyDuplicate(oData, oError, nCurRecno) as logical class ReportedQualityIndexEvents
    Local aAreaQE0 := QE0->(GetArea())                          as array
    Local cFilQE0  := xFilial("QE0")                            as character
    Local cYear    := oData:getFieldValue("QE0", "QE0_ANO")     as character
    Local cMonth   := oData:getFieldValue("QE0", "QE0_MES")     as character
    Local cSupplier := oData:getFieldValue("QE0", "QE0_FORNEC") as character
    Local cProduct := oData:getFieldValue("QE0", "QE0_PRODUT")  as character
    Local cIndex   := oData:getFieldValue("QE0", "QE0_INDICE")  as character
    Local cKey     := ""                                        as character
    Local cMessage := FWI18NLang("TOTVS.PROTHEUS.MANUFACTURING.INCOMINGINSPECTION.REPORTEDQUALITYINDEX.VALIDS", "STR0006", 6) as character
    Local lValid   := .T.                                       as logical

    cKey := PadR(cYear,     TamSX3("QE0_ANO")[1])    + ;
            PadR(cMonth,    TamSX3("QE0_MES")[1])    + ;
            PadR(cSupplier, TamSX3("QE0_FORNEC")[1]) + ;
            PadR(cProduct,  TamSX3("QE0_PRODUT")[1]) + ;
            PadR(cIndex,    TamSX3("QE0_INDICE")[1])

    If !Empty(cYear) .And. !Empty(cMonth) .And. !Empty(cSupplier) .And. ;
        !Empty(cProduct) .And. !Empty(cIndex)

        QE0->(DbSetOrder(1)) //QE0_FILIAL+QE0_ANO+QE0_MES+QE0_FORNEC+QE0_PRODUT+QE0_INDICE
        If QE0->(DbSeek(cFilQE0 + cKey))
            If QE0->(Recno()) <> nCurRecno
                oError:set(400, "JAGRAVADO", cMessage)
                lValid := .F.
            EndIf
        EndIf
    EndIf

    RestArea(aAreaQE0)
return lValid
