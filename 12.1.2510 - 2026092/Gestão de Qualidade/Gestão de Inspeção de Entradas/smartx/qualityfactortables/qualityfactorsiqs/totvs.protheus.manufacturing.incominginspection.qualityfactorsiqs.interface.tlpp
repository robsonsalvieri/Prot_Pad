using namespace totvs.framework.structure.interface

/*/{Protheus.doc} QualityFactorsIQSInterface
Interface SmartX da tabela de Fatores I.Q.S. (QEJ, QEJ_CODTAB="2").
@type class
@author willian.ramalho
@since 10/09/2026
/*/
@totvsFrameworkStructureInterface(description="Fatores I.Q.S.")
class QualityFactorsIQSInterface
    private data oInterface as object
    public method new() as object
    public method setInterface()
    public method getContract() as json
endclass

/*/{Protheus.doc} new
Construtor da classe.
@type method
@author willian.ramalho
@since 10/09/2026
@return object, instancia da classe
/*/
method new() as object class QualityFactorsIQSInterface
return self

/*/{Protheus.doc} setInterface
Monta a interface de Fatores I.Q.S. via layout automatico.
@type method
@author willian.ramalho
@since 10/09/2026
/*/
method setInterface() class QualityFactorsIQSInterface
    Local cModel := "totvs.protheus.manufacturing.incominginspection.QualityFactorsIQSModel" as character

    ::oInterface := BuildContract():new("qualityfactorsiqs")
    ::oInterface:setModelId(cModel, .T.)
    ::oInterface:setTitle(STR0001) // STR0001 - "Fatores I.Q.S."
    ::oInterface:buildStandardView()
return

/*/{Protheus.doc} getContract
Retorna o contrato JSON da interface.
@type method
@author willian.ramalho
@since 10/09/2026
@return json, Contrato da interface
/*/
method getContract() as json class QualityFactorsIQSInterface
return ::oInterface:getContract()
