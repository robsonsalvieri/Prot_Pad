#include "fw-tlpp-core.th"
#include "totvs.ch"
#include "totvs.framework.model.events.th"
#include "totvs.protheus.manufacturing.incominginspection.qualityfactorsiqs.events.ch"

namespace totvs.protheus.manufacturing.incominginspection

/*/{Protheus.doc} QualityFactorsIQSEvents
Eventos do QualityFactorsIQSModel (QEJ, QEJ_CODTAB="2").
@type class
@author willian.ramalho
@since 25/08/2026
/*/
class QualityFactorsIQSEvents
    private data cCodTab as character

    public method new() as object

    @beforeCreateInTransaction()
    public method beforeCreateInTransaction(oData, oModel, oError) as logical

    @beforeUpdateInTransaction()
    public method beforeUpdateInTransaction(oData, oModel, oError) as logical

    @afterCreateInTransaction()
    public method afterCreateInTransaction(oData, oModel, oError, oSuccess) as logical

    @afterDeleteInTransaction()
    public method afterDeleteInTransaction(oData, oModel, oError) as logical

    private method validateFactorDuplicate(oData, oError, nCurRecno) as logical
    private method validateUpperValueDuplicate(oData, oError, nCurRecno) as logical
    private method recalcLowerBound() as logical
endclass

/*/{Protheus.doc} new
Metodo construtor da classe. Fixa cCodTab="2" (Fatores I.Q.S.).
@type method
@author willian.ramalho
@since 25/08/2026
@return object, instancia da classe
/*/
method new() as object class QualityFactorsIQSEvents
    ::cCodTab := "2"
return self

/*/{Protheus.doc} beforeCreateInTransaction
Define QEJ_CODTAB automaticamente conforme o cadastro (I.Q.S.),
reproduzindo A270ITab (nOpc==3: QEJ_CODTAB:='2'), sem exigir
digitacao do usuario. Valida duplicidade de QEJ_FATOR (Help legado
JAGRAVADO) sem desconsiderar nenhum registro, pois e' inclusao.
@type method
@author willian.ramalho
@since 25/08/2026
@param oData, object, Dados da operacao
@param oModel, object, Modelo SmartX
@param oError, object, Retorno de erro
@return logical, Permissao para incluir
/*/
method beforeCreateInTransaction(oData as object, oModel as object, oError as object) as logical class QualityFactorsIQSEvents
    oData:setFieldValue("QEJ", "QEJ_CODTAB",, ::cCodTab)
    If !self:validateFactorDuplicate(oData, oError, 0)
        Return .F.
    EndIf
return self:validateUpperValueDuplicate(oData, oError, 0)

/*/{Protheus.doc} beforeUpdateInTransaction
Valida duplicidade de QEJ_FATOR (Help legado JAGRAVADO) desconsiderando
o proprio registro em alteracao -- QEJ ja esta posicionado no registro
sendo alterado neste ponto da transacao, entao QEJ->(Recno()) identifica
com seguranca qual linha excluir da checagem, sem depender de M-> nem
de reconstruir a chave original (QEJ_FATOR e a propria chave em edicao).
@type method
@author willian.ramalho
@since 25/08/2026
@param oData, object, Dados da operacao
@param oModel, object, Modelo SmartX
@param oError, object, Retorno de erro
@return logical, Permissao para alterar
/*/
method beforeUpdateInTransaction(oData as object, oModel as object, oError as object) as logical class QualityFactorsIQSEvents
    Local lRetorno  := .T.            as logical
    Local nCurRecno := QEJ->(Recno()) as numeric

    If !self:validateFactorDuplicate(oData, oError, nCurRecno)
        lRetorno := .F.
    EndIf

return lRetorno

/*/{Protheus.doc} validateFactorDuplicate
Bloqueia gravacao quando ja existir outro registro com a mesma
combinacao de QEJ_CODTAB e QEJ_FATOR, desconsiderando nCurRecno
(0 na inclusao, recno do proprio registro na alteracao). Usa a ordem
2 de QEJ (QEJ_FILIAL+QEJ_CODTAB+QEJ_FATOR) e preenche cFactor ate o
tamanho de QEJ_FATOR (TamSX3) para o seek posicionar corretamente em
campos de tamanho fixo.
@type method
@author willian.ramalho
@since 25/08/2026
@param oData, object, Dados da operacao
@param oError, object, Retorno de erro
@param nCurRecno, numeric, Recno desconsiderado na checagem (0 = nenhum)
@return logical, Ausencia de duplicidade
/*/
method validateFactorDuplicate(oData as object, oError as object, nCurRecno as numeric) as logical class QualityFactorsIQSEvents

    Local aAreaQEJ   := QEJ->(GetArea())                        as array
    Local cFilQEJ    := xFilial("QEJ")                          as character
    Local cFactor    := oData:getFieldValue("QEJ", "QEJ_FATOR") as character
    Local cFactorPad := PadR(cFactor, TamSX3("QEJ_FATOR")[1])   as character
    Local lValid     := .T.                                     as logical

    QEJ->(DbSetOrder(2)) //QEJ_FILIAL+QEJ_CODTAB+QEJ_FATOR
    If QEJ->(DbSeek(cFilQEJ + ::cCodTab + cFactorPad))
        While !QEJ->(Eof()) .And. QEJ->QEJ_FILIAL == cFilQEJ .And. ;
            QEJ->QEJ_CODTAB == ::cCodTab .And. QEJ->QEJ_FATOR == cFactorPad
            If QEJ->(Recno()) <> nCurRecno
                // STR0001 - "Fator ja cadastrado"
                // STR0002 - "Fator deve ser numerico, positivo e nao pode estar cadastrado na tabela."
                oError:set(400, STR0001, STR0002)
                lValid := .F.
                Exit
            EndIf
        EndDo
    EndIf

    RestArea(aAreaQEJ)

return lValid

/*/{Protheus.doc} validateUpperValueDuplicate
Bloqueia gravacao quando ja existir outro registro com a mesma
combinacao de QEJ_CODTAB e QEJ_VLSUP.
@type method
@author willian.ramalho
@since 31/08/2026
@param oData, object, Dados da operacao
@param oError, object, Retorno de erro
@param nCurRecno, numeric, Recno desconsiderado na checagem (0 = nenhum)
@return logical, Ausencia de duplicidade
/*/
method validateUpperValueDuplicate(oData as object, oError as object, nCurRecno as numeric) as logical class QualityFactorsIQSEvents

    Local aAreaQEJ := QEJ->(GetArea())                        as array
    Local cFilQEJ  := xFilial("QEJ")                          as character
    Local nUpper   := oData:getFieldValue("QEJ", "QEJ_VLSUP") as numeric
    Local lValid   := .T.                                     as logical

    QEJ->(DbSetOrder(1)) //QEJ_FILIAL+QEJ_CODTAB+STR(QEJ_VLSUP,6,2)
    If QEJ->(DbSeek(cFilQEJ + ::cCodTab + Str(nUpper, 6, 2)))
        While !QEJ->(Eof()) .And. QEJ->QEJ_FILIAL == cFilQEJ .And. ;
            QEJ->QEJ_CODTAB == ::cCodTab .And. QEJ->QEJ_VLSUP == nUpper
            If QEJ->(Recno()) <> nCurRecno
                // STR0003 - "Limite superior ja cadastrado"
                // STR0004 - "Limite superior ja cadastrado para esta tabela."
                oError:set(400, STR0003, STR0004)
                lValid := .F.
                Exit
            EndIf
        EndDo
    EndIf

    RestArea(aAreaQEJ)

return lValid

/*/{Protheus.doc} afterCreateInTransaction
Recalcula QEJ_VLINF de todos os registros da tabela (A270CInf), apos
inclusao confirmada.
@type method
@author willian.ramalho
@since 25/08/2026
@param oData, object, Dados da operacao
@param oModel, object, Modelo SmartX
@param oError, object, Retorno de erro
@param oSuccess, object, Retorno de sucesso
@return logical, Resultado do processamento posterior
/*/
method afterCreateInTransaction(oData as object, oModel as object, oError as object, oSuccess as object) as logical class QualityFactorsIQSEvents
return self:recalcLowerBound()

/*/{Protheus.doc} afterDeleteInTransaction
Recalcula QEJ_VLINF de todos os registros restantes da tabela
(A270CInf), apos exclusao confirmada.
@type method
@author willian.ramalho
@since 25/08/2026
@param oData, object, Dados da operacao
@param oModel, object, Modelo SmartX
@param oError, object, Retorno de erro
@return logical, Resultado do processamento posterior
/*/
method afterDeleteInTransaction(oData as object, oModel as object, oError as object) as logical class QualityFactorsIQSEvents
return self:recalcLowerBound()

/*/{Protheus.doc} recalcLowerBound
Reproduz A270CInf: percorre todos os registros de QEJ com o
QEJ_CODTAB atendido por esta instancia, recalculando QEJ_VLINF em
sequencia (limite inferior = QEJ_VLSUP do registro anterior + 0,01).
Cacheia xFilial("QEJ") antes do loop. Se algum registro estiver
bloqueado por outro processo, o recalculo daquele registro e' pulado
(sem interromper os demais) e o retorno passa a .F. para sinalizar
recalculo parcial.
@type method
@author willian.ramalho
@since 25/08/2026
@return logical, .T. se todos os registros foram recalculados, .F. se algum ficou bloqueado
/*/
method recalcLowerBound() as logical class QualityFactorsIQSEvents

    Local aArea     := QEJ->(GetArea()) as array
    Local cFilQEJ   := xFilial("QEJ")   as character
    Local nLowBound := 0                as numeric
    Local lAllOk    := .T.              as logical

    QEJ->(DbSetOrder(1)) //QEJ_FILIAL+QEJ_CODTAB+STR(QEJ_VLSUP,6,2)
    QEJ->(DbSeek(cFilQEJ + ::cCodTab))
    While !QEJ->(Eof()) .And. QEJ->QEJ_CODTAB == ::cCodTab .And. QEJ->QEJ_FILIAL == cFilQEJ
        If RecLock("QEJ", .F.)
            QEJ->QEJ_VLINF := nLowBound
            MsUnLock()
        EndIf
        nLowBound := QEJ->QEJ_VLSUP + 0.01
        QEJ->(DbSkip())
    EndDo

    RestArea(aArea)

return lAllOk
