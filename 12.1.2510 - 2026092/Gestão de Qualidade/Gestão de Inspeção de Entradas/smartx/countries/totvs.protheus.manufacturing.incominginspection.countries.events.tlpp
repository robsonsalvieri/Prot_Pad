#include "fw-tlpp-core.th"
#include "totvs.ch"
#include "totvs.framework.model.events.th"
#include "totvs.protheus.manufacturing.incominginspection.countries.events.ch"

namespace totvs.protheus.manufacturing.incominginspection

/*/{Protheus.doc} CountriesEvents
Eventos transacionais do cadastro de Paises (SYA).
@type class
@author brunno.costa
@since 03/08/2026
/*/
class CountriesEvents
    public method new() as object

    @beforeDeleteInTransaction()
    public method beforeDeleteInTransaction(oData, oModel, oError, oSuccess) as logical

    private method hasLinkedSupplier(cCountry) as logical
endclass

method new() as object class CountriesEvents
return self

/*/{Protheus.doc} beforeDeleteInTransaction
Reproduz o bloqueio de exclusao do legado A290Del (QIEA290.PRW): impede
excluir o pais se existir Fornecedor (SA2) vinculado por A2_PAIS. O
legado varria SA2 inteira com dbGoTop/dbSkip; aqui o mesmo resultado e
obtido via QLTQueryManager():dbSeek com filtro bind em A2_PAIS (ver
hasLinkedSupplier), sem alterar a condicao de bloqueio.
@type method
@author brunno.costa
@since 03/08/2026
@param oData, object, Dados da operacao
@param oModel, object, Modelo SmartX
@param oError, object, Retorno de erro
@param oSuccess, object, Retorno de sucesso
@return logical, Permissao para excluir
/*/
method beforeDeleteInTransaction(oData as object, oModel as object, oError as object, oSuccess as object) as logical class CountriesEvents
    Local cCountry := oData:getFieldValue("SYA", "YA_CODGI") as character
    Local lValid   := .T. as logical

    If self:hasLinkedSupplier(cCountry)
        //STR0001 - "Fornecedor vinculado"
        //STR0002 - "Existe Fornecedor cadastrado para este pais."
        oError:set(400, STR0001, STR0002)
        lValid := .F.
    EndIf
return lValid

/*/{Protheus.doc} hasLinkedSupplier
Verifica se ha Fornecedor (SA2) vinculado ao pais informado. Reproduz
SA2->A2_PAIS==SYA->YA_CODGI do legado (A290Del), trocando o full-scan
original por filtro direto no campo via QLTQueryManager():dbSeek (bind
parametrizado, sem alterar a condicao de bloqueio).
@type method
@author brunno.costa
@since 03/08/2026
@param cCountry, character, Codigo do pais (YA_CODGI)
@return logical, Existe fornecedor vinculado
/*/
method hasLinkedSupplier(cCountry as character) as logical class CountriesEvents
    Local aFiltros := {} as array

    aAdd(aFiltros, {" A2_PAIS = ? ", {{cCountry, "S"}}})

return QLTQueryManager():dbSeek("SA2", "", aFiltros)
