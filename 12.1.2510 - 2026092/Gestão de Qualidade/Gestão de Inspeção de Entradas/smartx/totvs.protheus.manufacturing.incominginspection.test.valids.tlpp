/*/{Protheus.doc} buildValidationResult
Monta o contrato de retorno de uma validacao de campo SmartX.
@type function
@author rafael.kleestadt
@since 23/07/2026
@param lValid, logical, Indica se o valor informado e valido
@param cMessage, character, Mensagem apresentada em caso de falha
@return json, Contrato de retorno esperado pelo SmartX
/*/
Static Function buildValidationResult(lValid, cMessage)
    Local jResult as json

    jResult := JsonObject():new()
    jResult["return"] := lValid
    jResult["notValidMessage"] := cMessage

Return jResult

/*/{Protheus.doc} vldContext
Valida se o contexto recebido e valido para a validacao de campo SmartX.
@type  Static Function
@author rafael.kleestadt
@since 04/08/2026
@version P12.1.2610
@param xValue, variante, Valor informado para o campo em validacao
@param cField, character, Nome do campo em validacao
@param aContextInfo, array, Informacoes adicionais do contexto SmartX
@param cExpectedField, character, Nome do campo esperado para a validacao
@return lValid, Lógico, Indica se o contexto recebido e valido para a validacao de campo SmartX
/*/
Static Function vldContext(xValue, cField, aContextInfo, cExpectedField)
    Local lValid := .F. as logical

    If ValType(xValue) == "C" .And. ValType(cField) == "C" .And. ValType(aContextInfo) == "A" .And. Upper(AllTrim(cField)) == cExpectedField
        lValid := .T.
    EndIf
    
Return lValid
