#include "fw-tlpp-core.th"
#include "totvs.ch"
#include "totvs.framework.structure.model.th"
#include "totvs.protheus.manufacturing.incominginspection.test.valids.ch"

namespace totvs.protheus.manufacturing.incominginspection

using namespace totvs.framework.structure.object
 
/*/{Protheus.doc} validateQE1Ensaio
Valida o codigo do ensaio informado no SmartX.
@type function
@author rafael.kleestadt
@since 23/07/2026
@param xValue, variant, Valor informado para o campo QE1_ENSAIO
@param cField, character, Nome do campo em validacao
@param aContextInfo, array, Informacoes adicionais do contexto SmartX
@return json, Resultado da validacao e mensagem para o usuario
/*/
Function validateQE1Ensaio(xValue, cField, aContextInfo)
    Local cMessage := STR0001 as character //"Não foi possível executar a validação porque o contexto recebido e inválido."
    Local lValid   := .F. as logical

    If vldContext(xValue, cField, aContextInfo, "QE1_ENSAIO")
        If !ExistChav("QE1", xValue)
            cMessage := STR0002 //"O ensaio informado já está cadastrado."
        ElseIf !FreeForUse("QE1", xValue)
            cMessage := STR0003 //"O código de ensaio informado já esta em uso."
        Else
            lValid   := .T.
            cMessage := ""
        EndIf
    EndIf

Return buildValidationResult(lValid, cMessage)

/*/{Protheus.doc} validateQE1Carta
Valida o tipo de carta informado no SmartX.
@type function
@author rafael.kleestadt
@since 23/07/2026
@param xValue, variant, Valor informado para o campo QE1_CARTA
@param cField, character, Nome do campo em validacao
@param aContextInfo, array, Informacoes adicionais do contexto SmartX
@return json, Resultado da validacao e mensagem para o usuario
/*/
Function validateQE1Carta(xValue, cField, aContextInfo)
    Local cMessage := STR0001 as character //"Não foi possível executar a validação porque o contexto recebido e inválido."
    Local lValid   := .F. as logical

    If vldContext(xValue, cField, aContextInfo, "QE1_CARTA")
        lValid := !Empty(xValue) .And. ExistCpo("SX5", "Q4" + xValue)

        If lValid
            cMessage := ""
        Else
            cMessage := STR0004 //"Informe um tipo de carta válido cadastrado na tabela Q4."
        EndIf
    EndIf

Return buildValidationResult(lValid, cMessage)

/*/{Protheus.doc} validateQE1Qtde
Valida a quantidade conforme o tipo de carta informado no SmartX.
@type function
@author rafael.kleestadt
@since 23/07/2026
@param xValue, variant, Valor informado para o campo QE1_QTDE
@param cField, character, Nome do campo em validacao
@param aContextInfo, array, Tipo de carta informado na primeira posicao
@return json, Resultado da validacao e mensagem para o usuario
/*/
Function validateQE1Qtde(xValue, cField, aContextInfo)
    Local cCarta   := "" as character
    Local cMessage := STR0001 as character //"Não foi possível executar a validação porque o contexto recebido e inválido."
    Local lValid   := .F. as logical

    If ValType(xValue) == "N" .And. ValType(cField) == "C" .And. ValType(aContextInfo) == "A" .And. Len(aContextInfo) >= 1 .And. ValType(aContextInfo[1]) == "C" .And. Upper(AllTrim(cField)) == "QE1_QTDE"
        cCarta := Upper(AllTrim(aContextInfo[1]))

        If cCarta == "HIS" .Or. cCarta == "XBR" .Or. cCarta == "XBS" .Or. cCarta == "XMR" .Or. cCarta == "IND"
            lValid := xValue >= 2 .And. xValue <= 10

            If !lValid
                cMessage := STR0005 //"A quantidade deve estar entre 2 e 10 para o tipo de carta informado."
            EndIf
        ElseIf cCarta == "NP" .Or. cCarta == "C"
            lValid := xValue > 0

            If !lValid
                cMessage := STR0006 //"A quantidade deve ser maior que zero para o tipo de carta informado."
            EndIf
        Else
            lValid := xValue == 0

            If !lValid
                cMessage := STR0007 //"A quantidade deve ser zero para o tipo de carta informado."
            EndIf
        EndIf

        If lValid
            cMessage := ""
        EndIf
    EndIf

Return buildValidationResult(lValid, cMessage)

/*/{Protheus.doc} validateQE1Metodo
Valida o metodo informado no SmartX.
@type function
@author rafael.kleestadt
@since 23/07/2026
@param xValue, variant, Valor informado para o campo QE1_METODO
@param cField, character, Nome do campo em validacao
@param aContextInfo, array, Informacoes adicionais do contexto SmartX
@return json, Resultado da validacao e mensagem para o usuario
/*/
Function validateQE1Metodo(xValue, cField, aContextInfo)
    Local cMessage := STR0001 as character //"Não foi possível executar a validação porque o contexto recebido e inválido."
    Local lValid   := .F. as logical

    If vldContext(xValue, cField, aContextInfo, "QE1_METODO")
        lValid := ExistCpo("QDH", xValue)

        If lValid
            cMessage := ""
        Else
            cMessage := STR0008 //"O método informado não esta cadastrado."
        EndIf
    EndIf

Return buildValidationResult(lValid, cMessage)

/*/{Protheus.doc} validateQE2NaoCon
Valida a nao conformidade informada no cadastro de ensaios do SmartX.
@type function
@author rafael.kleestadt
@since 23/07/2026
@param xValue, variant, Valor informado para o campo QE2_NAOCON
@param cField, character, Nome do campo em validacao
@param aContextInfo, array, Informacoes adicionais do contexto SmartX
@return json, Resultado da validacao e mensagem para o usuario
/*/
Function validateQE2NaoCon(xValue, cField, aContextInfo)
    Local cMessage := STR0001 as character //"Não foi possível executar a validação porque o contexto recebido e inválido."
    Local lValid   := .F. as logical

    If vldContext(xValue, cField, aContextInfo, "QE2_NAOCON")
        lValid := ExistCpo("SAG", xValue)

        If lValid
            cMessage := ""
        Else
            cMessage := STR0009 //"A não conformidade informada não esta cadastrada."
