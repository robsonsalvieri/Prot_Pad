#include "fw-tlpp-core.th"
#include "totvs.ch"
#include "totvs.framework.structure.model.th"
#include "totvs.protheus.manufacturing.incominginspection.nonconformities.model.ch"

namespace totvs.protheus.manufacturing.incominginspection

using namespace totvs.framework.structure.object

/*/{Protheus.doc} NonconformitiesModel
Modelo do cadastro de Não Conformidades.
@type class
@author willian.ramalho
@since 18/08/2026
/*/
@totvsFrameworkStructureModel(description="Nao Conformidades")
class NonconformitiesModel from totvs.framework.structure.model.data
    public method new() as object
    public method setModel()
endclass

/*/{Protheus.doc} new
Metodo construtor da classe.
@type method
@author willian.ramalho
@since 18/08/2026
@return object, instancia da classe
/*/
method new() as object class NonconformitiesModel
    _Super:new(,,.T.)
return self

/*/{Protheus.doc} setModel
Monta o modelo de Não Conformidades (SAG), entidade unica sem
sub-modelos -- QIEA040.PRW so usa AddFields("SAGMASTER") obrigatorio,
sem AddGrid. Registra NonconformitiesEvents para os bloqueios de
alteracao/exclusao (Q040TudOk/A040ValNco).
@type method
@author willian.ramalho
@since 18/08/2026
/*/
method setModel() class NonconformitiesModel
    Local oEvents as object
    Local oObject as object

    oObject := ObjectFromMetadata():new("SAG",, {"AG_FILIAL", "AG_NAOCON"})
    ::setObject(oObject:getObject(), "SAG")

    oEvents := NonconformitiesEvents():new()
    ::setEvents(oEvents)
return
