#include "fw-tlpp-core.th"
#include "totvs.ch"

using namespace totvs.framework.application.smartx

/*/{Protheus.doc} qiea040SX
Abre o cadastro de Nao Conformidades na interface SmartX.
@type function
@author  willian.ramalho
@since 24/07/2026
@return variant, resultado da abertura da interface
/*/
Function qiea040SX()
    local lCompVer  := GetRPORelease() >= "12.1.2610"
    Local oLauncher := Nil

    If !lCompVer
        Return Nil
    EndIf

    oLauncher := launcher():new()
    oLauncher:setInterface("totvs.protheus.manufacturing.incominginspection.NonconformitiesInterface")
Return oLauncher:open()
