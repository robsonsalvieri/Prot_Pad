#include "fw-tlpp-core.th"
#include "totvs.ch"

/*/{Protheus.doc} qiea020SX
Função para lançamento da interface do cadastro de ensaios do Inspeção de Entradas em smart x
@type  Function
@author rafael.kleestadt
@since 13/05/2026
@version >= 12.1.2610
/*/
Function qiea020SX()
    
    Local lVersaoCompat as Logical
    Local oLauncher as Object

    lVersaoCompat := GetRPORelease() >= '12.1.2610'

    If lVersaoCompat

        //Lançamento da interface do cadastro de ensaios em smart x
        oLauncher := totvs.framework.application.smartx.launcher():new()
        oLauncher:setInterface("totvs.protheus.manufacturing.incominginspection.TestInterface")

    EndIf

Return IIf(lVersaoCompat .And. oLauncher != Nil, oLauncher:open(), Nil)
