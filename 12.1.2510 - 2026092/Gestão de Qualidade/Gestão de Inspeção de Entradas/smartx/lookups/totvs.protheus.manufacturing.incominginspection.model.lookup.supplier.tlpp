using namespace totvs.framework.structure.object

/*/{Protheus.doc} supplierLookup
Classe de lookup FORNECEDOR, que retorna os fornecedores ativos da filial do usuário logado, com as colunas de busca e exibição da consulta SXB original (Código, Loja, Nome, CNPJ/CPF).
@author rafael.kleestadt / brunno.costa
@since 20/08/2026
@version P12.1.2610
/*/
@totvsFrameworkStructureModel(lookup=.T., country="ALL", description="Fornecedor")
class supplierLookup from totvs.framework.structure.model.data
    public method new() as object
    public method setModel()
endclass

/*/{Protheus.doc} new
construtor da classe.
@author rafael.kleestadt / brunno.costa
@since 20/08/2026
@version P12.1.2610
@return self, objeto, instância da classe
/*/
method new() as object class supplierLookup
    _Super:new(,,.T.)
return self

/*/{Protheus.doc} setModel
Define o modelo de dados do lookup FORNECEDOR, que retorna os fornecedores ativos da filial do usuário logado, com as colunas de busca e exibição da consulta SXB original (Código, Loja, Nome, CNPJ/CPF).
@author rafael.kleestadt / brunno.costa
@since 20/08/2026
@version P12.1.2610
@return nil, nulo, sem retorno
/*/
method setModel() class supplierLookup
    Local oArray  as Object
    Local oField  as Object
    Local oFinder as Object
    Local oHeader as Object
    Local oIndex  as Object

    oHeader := BuildFromCode():new("FOR")

    oField := BuildFieldProperties():new("FOR_COD")
    oField:setType("C")
    oField:setTitle(AllTrim(FWX3Titulo("A2_COD"))) //Código
    oField:setDescription(AllTrim(FWSX3Util():GetDescription("A2_COD"))) //Código do fornecedor
    oField:setSize(FWSX3Util():GetFieldStruct("A2_COD")[3]) // tamanho do campo no dicionário
    oField:setOrder(1)
    oField:setRequired(.T.)
    oField:setUpperCase(.T.)
    oHeader:addFieldProperties(oField:getFieldProperties())

    oField := BuildFieldProperties():new("FOR_LOJA")
    oField:setType("C")
    oField:setTitle(AllTrim(FWX3Titulo("A2_LOJA"))) //Loja
    oField:setDescription(AllTrim(FWSX3Util():GetDescription("A2_LOJA"))) //Loja do fornecedor
    oField:setSize(FWSX3Util():GetFieldStruct("A2_LOJA")[3]) // tamanho do campo no dicionário
    oField:setOrder(2)
    oField:setUpperCase(.T.)
    oHeader:addFieldProperties(oField:getFieldProperties())

    oField := BuildFieldProperties():new("FOR_NOME")
    oField:setType("C")
    oField:setTitle(AllTrim(FWX3Titulo("A2_NOME"))) //Razão Social
    oField:setDescription(AllTrim(FWSX3Util():GetDescription("A2_NOME"))) //Nome Razão Social
    oField:setSize(FWSX3Util():GetFieldStruct("A2_NOME")[3]) // tamanho do campo no dicionário
    oField:setOrder(3)
    oHeader:addFieldProperties(oField:getFieldProperties())

    oField := BuildFieldProperties():new("FOR_CNPJ")
    oField:setType("C")
    oField:setTitle(AllTrim(FWX3Titulo("A2_CGC"))) //CNPJ/CPF
    oField:setDescription(AllTrim(FWSX3Util():GetDescription("A2_CGC"))) //CNPJ/CPF do cliente
    oField:setSize(FWSX3Util():GetFieldStruct("A2_CGC")[3]) // tamanho do campo no dicionário
    oField:setOrder(4)
    oHeader:addFieldProperties(oField:getFieldProperties())

    oHeader:setTitle(AllTrim(FWX3Titulo("QE0_FORNEC"))) //Fornecedor

    oIndex := BuildIndex():new("FOR" + cEmpAnt + "0")
    oIndex:setOrder("1")
    oIndex:setKeyFields({"FOR_COD"})
    oHeader:addIndexConstraint(oIndex:getIndex())

    oFinder := totvs.framework.structure.model.finder():new()
    oFinder:setFinder({"FOR_COD", "FOR_NOME", "FOR_CNPJ"}, "", .T.)
    oHeader:addFinder(oFinder:getFinder())

    oHeader:setUniqueKeyConstraint("FOR" + cEmpAnt + "0", {"FOR_COD"})

    oArray := supplierLookupDataArray():new()
    self:setObject(oHeader:getObject(), "FOR",,,,,, oArray)
    self:setOrder({{"FOR_COD", .F.}})
    self:LoadEventsFromMetadata()
return

/*/{Protheus.doc} supplierLookupDataArray
Classe de array de dados do lookup FORNECEDOR, que retorna os fornecedores ativos da filial do usuário logado, com as colunas de busca e exibição da consulta SXB original (Código, Loja, Nome, CNPJ/CPF).
@type class
@author rafael.kleestadt / brunno.costa
@since 20/08/2026
@version P12.1.2610
/*/
class supplierLookupDataArray
    public method new() as object
    public method getData() as array
endclass

/*/{Protheus.doc} new
construtor da classe.
@author rafael.kleestadt / brunno.costa
@since 20/08/2026
@version P12.1.2610
@return self, objeto, instância da classe
/*/
method new() as object class supplierLookupDataArray
return self

/*/{Protheus.doc} getData
Retorna os fornecedores ativos da filial do usuário logado, com as colunas de busca e exibição da consulta SXB original (Código, Loja, Nome, CNPJ/CPF).
@author rafael.kleestadt / brunno.costa
@since 20/08/2026
@version P12.1.2610
@return aData, array, array de fornecedores ativos da filial do usuário logado, com as colunas de busca e exibição da consulta SXB original (Código, Loja, Nome, CNPJ/CPF).
/*/
method getData() as array class supplierLookupDataArray
    Local aArea      := GetArea()               as array
    Local aBindParam := {}                      as array
    Local aData      := {}                      as array
    Local cAliasQry  := ""                      as character
    Local cCNPJ      := ""                      as character
    Local cCod       := ""                      as character
    Local cFilSA2    := xFilial("SA2")          as character
    Local cLoja      := ""                      as character
    Local cNome      := ""                      as character
    Local cQuery     := ""                      as character
    Local oQLTQueryM := QLTQueryManager():new() as object

    cQuery :=   " SELECT A2_COD, A2_LOJA, A2_NOME, A2_CGC "
    cQuery +=     " FROM " + RetSqlName("SA2")
    cQuery +=    " WHERE A2_FILIAL = ? "
    cQuery +=      " AND D_E_L_E_T_ = ? "
    cQuery += " ORDER BY A2_COD, A2_LOJA "

    aAdd(aBindParam, {cFilSA2, "S"})
    aAdd(aBindParam, {' ',     "S"})

	cQuery    := oQLTQueryM:changeQuery(cQuery)
	cAliasQry := oQLTQueryM:executeQueryWithBind(cQuery, aBindParam, .F.)

    While (cAliasQry)->(!Eof())
        cCod  := AllTrim((cAliasQry)->A2_COD)
        cLoja := AllTrim((cAliasQry)->A2_LOJA)
        cNome := AllTrim((cAliasQry)->A2_NOME)
        cCNPJ := AllTrim((cAliasQry)->A2_CGC)

        If !Empty(cCod)
            AAdd(aData, {cCod, cLoja, cNome, cCNPJ})
        EndIf

        (cAliasQry)->(dbSkip())
    EndDo

	(cAliasQry)->(DbCloseArea())

    RestArea(aArea)
return aData
