#include "msobject.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#Include "TOTVS.CH"

namespace totvs.protheus.backoffice.fin.gesplan

//-------------------------------------------------------------------
/*/{Protheus.doc} ProcedureFin006
    @description Classe específica de configuração da procedure Fin006 
    que compõe o pacote de procedures da integração Protheus x Gesplan.
    Responsável pelo processo "CRP - Contas a Receber Previsto"
    @author fabioh.andrade@totvs.com.br
    @since 13/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
class ProcedureFin006 from totvs.protheus.backoffice.fin.gesplan.FinGesplanProcedure
    public method new(cBuffer as character, cEnterPointType as character, cEnterpriseCode as character) as object

    protected method loadParserOracle()
    protected method loadParserSQLServer()
    protected method loadParserPostgres()
endClass

//-------------------------------------------------------------------
/*/{Protheus.doc} new
    @author fabioh.andrade@totvs.com.br
    @since 13/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method new(cBuffer as character, cEnterPointType as character, cEnterpriseCode as character) as object class ProcedureFin006
    _Super:new(cBuffer,cEnterPointType,cEnterpriseCode)
    self:cOriginFlexFields := "2"
    self:cTableFlexFields := "F7I"
return self

//-------------------------------------------------------------------
/*/{Protheus.doc} loadParserOracle
    @author fabioh.andrade@totvs.com.br
    @since 13/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method loadParserOracle() class ProcedureFin006
    _Super:loadParserOracle()    
    if self:lIsPosCompile
        aAdd( self:jParseDatabase[self:cEnterPointType], { "vcStamp  := (" , " " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "FROM F7J### F7J" , " INTO vcStamp FROM F7J### F7J " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "WHERE F7J.F7J_ALIAS  := 'CRP' );" , "WHERE F7J.F7J_ALIAS  = 'CRP' ;" } )

        aAdd( self:jParseDatabase[self:cEnterPointType], { "LOWER (TO_CHAR(HASHBYTES ('MD5' , CONCAT (TRIM (IN_mdmTenantId ), protheus_pk , E1_FILORIG )),'YY.MM.DD'))" , "LOWER(STANDARD_HASH( TRIM (IN_mdmTenantId ) || protheus_pk  || E1_FILORIG, 'MD5') )" } )

        aAdd( self:jParseDatabase[self:cEnterPointType], { "vF7I_DSCCCT  := (" , " " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "FROM CTT###" , "INTO vF7I_DSCCCT  FROM CTT### " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "WHERE CTT_FILIAL  := vfilialCTT  AND CTT_CUSTO  := vED_CCC  AND D_E_L_E_T_  := ' ' );" , "WHERE CTT_FILIAL  = vfilialCTT  AND CTT_CUSTO  = vED_CCC  AND D_E_L_E_T_  = ' ' ;" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "WHERE CTT_FILIAL  := vfilialCTT  AND CTT_CUSTO  := vE1_CCUSTO  AND D_E_L_E_T_  := ' ' );" , "WHERE CTT_FILIAL  = vfilialCTT  AND CTT_CUSTO  = vE1_CCUSTO  AND D_E_L_E_T_  = ' ' ;" } )

        //tempo 
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_CHAR(MSDATEADD_33_## (HOUR , -1 , GETUTCDATE ),'YYYY-MM-DD HH24:MI:SS.FF3');", "TO_CHAR( SYSTIMESTAMP AT TIME ZONE 'UTC' - INTERVAL '1' HOUR,'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.FF3');" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "MSDATEADD_33_## ('YEAR', -2 , SYSDATE ),'YYYYMMDD'", "ADD_MONTHS(SYSDATE, -24), 'YYYYMMDD'" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "FORMAT (TO_DATE(vE1_BAIXA ), 'yyyy-MM-ddTHH:mm:ss.fff' )", "TO_CHAR(TO_TIMESTAMP(vE1_BAIXA , 'YYYYMMDD'), 'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.FF3')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "FORMAT (TO_DATE(vF7I_EMIS1 ), 'yyyy-MM-ddTHH:mm:ss.fff' )", "TO_CHAR(TO_TIMESTAMP(vF7I_EMIS1 , 'YYYYMMDD'), 'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.FF3')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "MSDATEADD_33_## ('YEAR',", "ADD_MONTHS(SYSDATE, -24), 'YYYYMMDD')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "-2 , SYSDATE ),'YYYYMMDD')", " " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_DATE(vdelTransactTime ,'YYYY-MM-DD HH24:MI:SS.FF3')", "TO_TIMESTAMP(vdelTransactTime ,'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.FF3')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_DATE(vcStamp ,'YYYY-MM-DD HH24:MI:SS.FF3')", "TO_TIMESTAMP(vcStamp ,'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.FF3')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_CHAR(vF7I_STAMP ,'YYYY-MM-DD HH24:MI:SS.FF3')", "TO_CHAR(vF7I_STAMP ,'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.FF3')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "vF7I_STAMP DATE", "vF7I_STAMP TIMESTAMP" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "vmaxStagingCounter DATE", "vmaxStagingCounter TIMESTAMP" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "'YYYY-MM-DD HH24:MI:SS.FF3'","'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.FF3'" } )
    endIf
return 

/*/{Protheus.doc} loadParserPostgres
    @author fabioh.andrade@totvs.com.br
    @since 13/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method loadParserPostgres() class ProcedureFin006
    _Super:loadParserPostgres()    

    if self:lIsPosCompile
        aAdd( self:jParseDatabase[self:cEnterPointType], {"vcStamp  := (" , " " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], {"FROM F7J### F7J" , " INTO vcStamp FROM F7J### F7J " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], {"WHERE F7J.F7J_ALIAS  := 'CRP' );" , "WHERE F7J.F7J_ALIAS  = 'CRP' ;" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], {"LOWER (TO_CHAR(HASHBYTES ('MD5' , CONCAT (TRIM (IN_mdmTenantId )::bpchar , protheus_pk ," , "lower(md5(trim(in_mdmTenantId) || protheus_pk || E1_FILORIG)) as F7I_EXTCDH" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], {"E1_FILORIG )::bpchar ),'YY.MM.DD'))::bpchar  as F7I_EXTCDH" , " " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], {"vF7I_DSCCCT  := (" , " " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], {"FROM CTT###" , "INTO vF7I_DSCCCT  FROM CTT### " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], {"WHERE CTT_FILIAL  := vfilialCTT  AND CTT_CUSTO  := vED_CCC  AND D_E_L_E_T_  := ' ' );" , "WHERE CTT_FILIAL  = vfilialCTT  AND CTT_CUSTO  = vED_CCC  AND D_E_L_E_T_  = ' ' ;" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], {"WHERE CTT_FILIAL  := vfilialCTT  AND CTT_CUSTO  := vE1_CCUSTO  AND D_E_L_E_T_  := ' ' );" , "WHERE CTT_FILIAL  = vfilialCTT  AND CTT_CUSTO  = vE1_CCUSTO  AND D_E_L_E_T_  = ' ' ;" } )
    
        //tempo 
        aAdd( self:jParseDatabase[self:cEnterPointType], {"TO_CHAR(MSDATEADD_33_## ('YEAR', -2 , NOW() ),'YYYYMMDD')", "TO_CHAR(CURRENT_DATE - INTERVAL '2 years', 'YYYYMMDD')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], {"MSDATEADD_33_## ('YEAR', -2 , SYSDATE ),'YYYYMMDD'", "TO_CHAR(CURRENT_DATE - interval '2 years', 'YYYYMMDD')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], {"FORMAT (TO_DATE(vE1_BAIXA ), 'yyyy-MM-ddTHH:mm:ss.fff' )", "TO_CHAR(TO_DATE(vE1_BAIXA, 'YYYYMMDD')::timestamp, 'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.MS')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], {"FORMAT (TO_DATE(vF7I_EMIS1 ), 'yyyy-MM-ddTHH:mm:ss.fff' )", "TO_CHAR(TO_DATE(vF7I_EMIS1, 'YYYYMMDD')::timestamp, 'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.MS')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], {"MSDATEADD_33_## ('YEAR',", "ADD_MONTHS(SYSDATE, -24), 'YYYYMMDD')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], {"-2 , SYSDATE ),'YYYYMMDD')", " " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], {"TO_DATE(vdelTransactTime ,'YYYY-MM-DD HH24:MI:SS.FF3')", "vdelTransactTime::timestamp" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], {"TO_DATE(vcStamp ,'YYYY-MM-DD HH24:MI:SS.FF3')", "vcStamp::timestamp" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], {"TO_CHAR(vF7I_STAMP ,'YYYY-MM-DD HH24:MI:SS.FF3')", "TO_CHAR(vF7I_STAMP ,'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.MS')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], {"vF7I_STAMP DATE", "vF7I_STAMP TIMESTAMP" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], {"vmaxStagingCounter DATE", "vmaxStagingCounter TIMESTAMP" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], {"'YYYY-MM-DD HH24:MI:SS.FF3'","'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.MS'" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], {"TO_CHAR(MSDATEADD_33_## (HOUR , -1 , GETUTCDATE ),'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.MS')", "TO_CHAR((CURRENT_TIMESTAMP AT TIME ZONE 'UTC' - interval '1 hour'), 'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.MS')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], {"TO_DATE(se1_principal.E1_EMIS1", "TO_TIMESTAMP(se1_principal.E1_EMIS1 ,'YYYYMMDD'" } )
    endIf
return 

/*/{Protheus.doc} loadParserSQLServer
    @author fabioh.andrade@totvs.com.br
    @since 13/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method loadParserSQLServer() class ProcedureFin006
    _Super:loadParserSQLServer()
    if self:lIsPosCompile
        aAdd( self:jParseDatabase[self:cEnterPointType], { "and TRIM ( f7j.F7J_STAMP ) = CONVERT( Char( 26 ) ,se1_principal.stamp_se1 ,127 )" , "AND CONVERT( datetime ,f7j.F7J_STAMP ,127 ) = se1_principal.stamp_se1" } )
    endIf
return 
