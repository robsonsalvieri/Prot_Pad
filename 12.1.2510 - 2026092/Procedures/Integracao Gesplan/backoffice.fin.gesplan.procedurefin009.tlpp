#include "msobject.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#Include "TOTVS.CH"

namespace totvs.protheus.backoffice.fin.gesplan

//-------------------------------------------------------------------
/*/{Protheus.doc} ProcedureFin009
    @description Classe específica de configuração da procedure Fin009 
    que compõe o pacote de procedures da integração Protheus x Gesplan.
    Responsável pelo processo "CPR - Contas a Pagar Realizado"
    @author fabioh.andrade@totvs.com.br
    @since 15/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
class ProcedureFin009 from totvs.protheus.backoffice.fin.gesplan.FinGesplanProcedure
    public method new(cBuffer as character, cEnterPointType as character, cEnterpriseCode as character) as object

    protected method loadParserGeneralPre()
    protected method loadParserOracle()
    protected method loadParserSQLServer()
    protected method loadParserPostgres()
endClass

//-------------------------------------------------------------------
/*/{Protheus.doc} new
    @author fabioh.andrade@totvs.com.br
    @since 15/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method new(cBuffer as character, cEnterPointType as character, cEnterpriseCode as character) as object class ProcedureFin009
    _Super:new(cBuffer,cEnterPointType,cEnterpriseCode)
    self:cOriginFlexFields := "3"
    self:cTableFlexFields := "F7I"
return self


/*/{Protheus.doc} loadParserSQLServer
    @author fabioh.andrade@totvs.com.br
    @since 15/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method loadParserGeneralPre() class ProcedureFin009
    _Super:loadParserGeneralPre()
    if self:lIsPosCompile
        aAdd(self:jParseGeneralPre[self:cEnterPointType], { "'##ROW_NUMBER'", "ROW_NUMBER() OVER (PARTITION BY fk5.FK5_IDMOV, sev.EV_MSUID, sez.EZ_MSUID ORDER BY fk5.R_E_C_N_O_ DESC)" } )
        aAdd(self:jParseGeneralPre[self:cEnterPointType], { "CONVERT( datetime ,@F7I_EMIS1 ,127 )", "CONVERT( datetime ,@F7I_EMIS1 ,121 )" } )
    endIf
return 

//-------------------------------------------------------------------
/*/{Protheus.doc} loadParserOracle
    @author fabioh.andrade@totvs.com.br
    @since 15/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method loadParserOracle() class ProcedureFin009
    _Super:loadParserOracle()
    if self:lIsPosCompile
        aAdd( self:jParseDatabase[self:cEnterPointType], { "vcStamp  := (" , " " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "FROM F7J### F7J" , " INTO vcStamp FROM F7J### F7J " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "WHERE F7J.F7J_ALIAS  := 'CPR' )" , "WHERE F7J.F7J_ALIAS  = 'CPR' " } )

        aAdd( self:jParseDatabase[self:cEnterPointType], { "vF7I_DSCCCT  := (" , " " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "FROM CTT###" , "INTO vF7I_DSCCCT  FROM CTT### " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "WHERE CTT_FILIAL  := vfilialCTT  AND CTT_CUSTO  := vED_CCD  AND D_E_L_E_T_  := ' ' );" , "WHERE CTT_FILIAL  = vfilialCTT  AND CTT_CUSTO  = vED_CCD  AND D_E_L_E_T_  = ' ' ;" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "vF7I_DSCMDB  := (" , " " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "FROM SX6### SX6C" , "INTO vF7I_DSCMDB FROM SX6### SX6C " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "WHERE TRIM (SX6C.X6_VAR ) := CONCAT ('MV_MOEDA" , "WHERE TRIM (SX6C.X6_VAR ) = CONCAT ('MV_MOEDA" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { ") )) AND SX6C.D_E_L_E_T_  := ' ' )" , ") )) AND SX6C.D_E_L_E_T_  = ' ' " } )
        
        //tempo 
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_CHAR(MSDATEADD_33_## (HOUR , -1 , GETUTCDATE ),'YYYY-MM-DD HH24:MI:SS.FF3');", "TO_CHAR( SYSTIMESTAMP AT TIME ZONE 'UTC' - INTERVAL '1' HOUR,'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.FF3');" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "MSDATEADD_33_## ('YEAR', -2 , SYSDATE ),'YYYYMMDD'", "ADD_MONTHS(SYSDATE, -24), 'YYYYMMDD'" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_DATE(vdelTransactTime ,'YYYY-MM-DD HH24:MI:SS.FF3')", "TO_TIMESTAMP(vdelTransactTime ,'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.FF3')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_DATE(vcStamp ,'YYYY-MM-DD HH24:MI:SS.FF3')", "TO_TIMESTAMP(vcStamp ,'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.FF3')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "vmaxStagingCounter DATE", "vmaxStagingCounter TIMESTAMP" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "'YYYY-MM-DD HH24:MI:SS.FF3'","'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.FF3'" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { 'vse2_S_T_A_M_P_ DATE', 'vse2_S_T_A_M_P_ TIMESTAMP' } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { 'vfk7_S_T_A_M_P_ DATE', 'vfk7_S_T_A_M_P_ TIMESTAMP' } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { 'vfk2_S_T_A_M_P_ DATE', 'vfk2_S_T_A_M_P_ TIMESTAMP' } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { 'vfka_S_T_A_M_P_ DATE', 'vfka_S_T_A_M_P_ TIMESTAMP' } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { 'vfk5_S_T_A_M_P_ DATE', 'vfk5_S_T_A_M_P_ TIMESTAMP' } )

        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_DATE(stg_se2.E2_EMIS1", "TO_TIMESTAMP(stg_se2.E2_EMIS1 ,'YYYY-MM-DD' " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "fk5.FK5_IDDOC  = fk7.FK7_IDDOC" , "fk7.FK7_IDDOC = case when fk5.FK5_IDDOC = ' ' then fk5.FK5_IDFK7 else fk5.FK5_IDDOC end" } )
    endIf
return 

/*/{Protheus.doc} loadParserPostgres
    @author fabioh.andrade@totvs.com.br
    @since 15/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method loadParserPostgres() class ProcedureFin009
    _Super:loadParserPostgres()    

    if self:lIsPosCompile
        aAdd( self:jParseDatabase[self:cEnterPointType], { "vcStamp  := (" , " " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "FROM F7J### F7J" , " INTO vcStamp FROM F7J### F7J " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "WHERE F7J.F7J_ALIAS  := 'CPR' )" , "WHERE F7J.F7J_ALIAS  = 'CPR' " } )


        aAdd( self:jParseDatabase[self:cEnterPointType], { "vF7I_DSCCCT  := (" , " " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "FROM CTT###" , "INTO vF7I_DSCCCT  FROM CTT### " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "WHERE CTT_FILIAL  := vfilialCTT  AND CTT_CUSTO  := vED_CCD  AND D_E_L_E_T_  := ' ' );" , "WHERE CTT_FILIAL  = vfilialCTT  AND CTT_CUSTO  = vED_CCD  AND D_E_L_E_T_  = ' ' ;" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "vF7I_DSCMDB  := (" , " " } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "FROM SX6### SX6C" , "INTO vF7I_DSCMDB FROM SX6### SX6C " } )
        
        aAdd( self:jParseDatabase[self:cEnterPointType], { "WHERE TRIM (SX6C.X6_VAR )::bpchar  := CONCAT ('MV_MOEDA' , TRIM (" , "WHERE TRIM (SX6C.X6_VAR )::bpchar  = CONCAT ('MV_MOEDA' , TRIM (" } ) 
        aAdd( self:jParseDatabase[self:cEnterPointType], { " } ) )::bpchar )::bpchar  AND SX6C.D_E_L_E_T_  := ' ' )" , " } ) )::bpchar )::bpchar  AND SX6C.D_E_L_E_T_  = ' ' " } )
        
        //tempo 
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_CHAR(MSDATEADD_33_## ('YEAR', -2 , NOW() ),'YYYYMMDD')", "TO_CHAR(CURRENT_DATE - INTERVAL '2 years', 'YYYYMMDD')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_CHAR(MSDATEADD_33_## (HOUR , -1 , GETUTCDATE ),'YYYY-MM-DD HH24:MI:SS.FF3')", "TO_CHAR((CURRENT_TIMESTAMP AT TIME ZONE 'UTC' - interval '1 hour'), 'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.MS')" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_DATE(vdelTransactTime ,'YYYY-MM-DD HH24:MI:SS.FF3')", "vdelTransactTime::timestamp" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_DATE(vcStamp ,'YYYY-MM-DD HH24:MI:SS.FF3')", "vcStamp::timestamp" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "vmaxStagingCounter DATE", "vmaxStagingCounter TIMESTAMP" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "'YYYY-MM-DD HH24:MI:SS.FF3'","'YYYY-MM-DD"+'"T"'+"HH24:MI:SS.MS'" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { 'vse2_S_T_A_M_P_ DATE', 'vse2_S_T_A_M_P_ TIMESTAMP' } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { 'vfk7_S_T_A_M_P_ DATE', 'vfk7_S_T_A_M_P_ TIMESTAMP' } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { 'vfk2_S_T_A_M_P_ DATE', 'vfk2_S_T_A_M_P_ TIMESTAMP' } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { 'vfka_S_T_A_M_P_ DATE', 'vfka_S_T_A_M_P_ TIMESTAMP' } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { 'vfk5_S_T_A_M_P_ DATE', 'vfk5_S_T_A_M_P_ TIMESTAMP' } )
        
        aAdd( self:jParseDatabase[self:cEnterPointType], { "TO_DATE(stg_se2.E2_EMIS1", "TO_TIMESTAMP(stg_se2.E2_EMIS1 ,'YYYYMMDD'" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "fk5.FK5_IDDOC  = fk7.FK7_IDDOC" , "fk7.FK7_IDDOC = case when fk5.FK5_IDDOC = ' ' then fk5.FK5_IDFK7 else fk5.FK5_IDDOC end" } )
    endIf
return 

/*/{Protheus.doc} loadParserSQLServer
    @author fabioh.andrade@totvs.com.br
    @since 15/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method loadParserSQLServer() class ProcedureFin009
    _Super:loadParserSQLServer()
    if self:lIsPosCompile
        aAdd( self:jParseDatabase[self:cEnterPointType], { "and TRIM ( f7j.F7J_STAMP ) = CONVERT( Char( 26 ) ,fk5.S_T_A_M_P_ ,127 )" , "AND CONVERT( datetime ,f7j.F7J_STAMP ,127 ) = fk5.S_T_A_M_P_" } )
        aAdd( self:jParseDatabase[self:cEnterPointType], { "fk5.FK5_IDDOC  = fk7.FK7_IDDOC" , "fk7.FK7_IDDOC = case when fk5.FK5_IDDOC = ' ' then fk5.FK5_IDFK7 else fk5.FK5_IDDOC end" } )
    endIf
return 
