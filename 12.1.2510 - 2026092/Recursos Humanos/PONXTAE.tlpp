#INCLUDE "TOTVS.CH"
#INCLUDE "RESTFUL.CH"
#INCLUDE "PONXTAE.CH"
#INCLUDE "tlpp-core.th"

Static cOrgCfg := NIL
Static lCheckFil := .F.
Static cLastFil	:= NIL
Static oQryFunc := NIL

/*/{Protheus.doc} PONXTAE
Classe para integração de documentos com o TAE. 
@type Class
@author Cícero Alves
@since 11/06/2025
/*/
Class PONXTAE
	Public data lLogado			As logical

	Private data aDestinatarios	As array
	Private data aMensagens		As array
	Private data cRotina 		As character
	Private data cAssunto 		As character
	Private data cMensagem 		As character
	Private data cUser 			As character
	Private data cPWord 		As character
	Private data cLembrete 		As character
	Private data cVisao			As character
	Private data cTpNotTae		As character
	Private data cAuthToken		As character
	Private data lManuscrita 	As logical
	Private data lWorkflow 		As logical
	Private data lRejeita 		As logical
	Private data lMRHTae		As logical
	Private data nLimite 		As numeric
	Private data oClient		As object

	Public method New()
	Public method GetResponseCode()
	Public method GetTypeErro403()
	Public method SendMail()
	Public method chkSubType()
	Public method getDocument()
	Public method login()
	Public method validLogin()
	Public method getMensagens()
	Public method sendEsp()
	Public method gravaRS4()
	Public method uploadDoc()
	Public method statusDoc()
	Public method cancelDoc()
	Public method deleteDoc()

	Private method NotifFunc()
	Private method getDestinatarios()
	Private method loadData()
EndClass

/*/{Protheus.doc} PONXTAE::New
Método contrutor da classe
@type method
@author Cí­cero Alves
@since 11/06/2025
@param cRotina, character, código da rotina usado para busca das informações na tabela RR3
@param lLogin, logical, informa se deve realizar o login no TAE, caso seja .F. o login não será realizado
@return object, instância da classe 
/*/
Method New(cRotina, lLogin) class PONXTAE
	Local aArea		:= GetArea()						as Array
	Local cUrl		:= SuperGetMv('MV_SIGNURL',, "")	as Character
	
	Default cRotina	:= ""
	Default lLogin	:= .T.
	
	If !Empty(cUrl)
		::oClient := FwRest():New(cUrl)
		::lMRHTae := SuperGetMv("MV_MRHTAE",, .F.)
		::cTpNotTae	:= cValToChar(SuperGetMv("MV_RHTAENT", .F., 1))
		
		::cRotina := AllTrim(cRotina)
		
		::aMensagens := {}
		
		If ChkFile("RR3")
			lCheckFil := !Empty(xFilial("RR3"))
			cLastFil := cFilAnt
		EndIf
		
		::loadData()

		If lLogin
			::login()
		EndIf
	Else
		// "Não foi possível efetuar autenticação no TAE" - "Verifique os parâmetros MV_SIGNURL, MV_RHTAEUS e MV_RHTAEPW"
		Help( ,, "HELP",, STR0001, 1,,,,,,, {STR0002})
		lRet := .F.
	EndIf
	
	RestArea(aArea)

Return Self

/*/{Protheus.doc} PONXTAE::loadData
Inicializa as propriedades da classe com base nas tabelas RR3 e RR4
@type method
@author Cícero Alves
@since 13/02/2026
@param cFilBusca, character, Filial para busca das infomações
@return NIL, NIL
/*/
method loadData(cFilBusca) class PONXTAE
	
	Default cFilBusca := cFilAnt
	
	::aDestinatarios := {}
	
	// Valores padrão para os atributos
	::lWorkflow := .F.
	::nLimite := 0
	::lManuscrita := .F.
	::lRejeita := .T.
	::cAssunto := ""
	::cMensagem := ""
	::cUser := ""
	::cPWord := ""
	::cLembrete := "0"
	::cVisao := ""

	If !Empty(::cRotina) .And. ChkFile("RR3") .And. ChkFile("RR4")
		
		dbSelectArea("RR3")
		If dbSeek(xFilial("RR3", cFilBusca) + ::cRotina)
			
			::nLimite 		:= RR3->RR3_LIMITE
			::lManuscrita 	:= RR3->RR3_MANUAL == "1"
			::lWorkflow 	:= RR3->RR3_WRKFLW == "1"
			::lRejeita 		:= RR3->RR3_REFUSE == "1"
			::cAssunto 		:= AllTrim(RR3->RR3_SUB)
			::cMensagem 	:= AllTrim(RR3->RR3_MSG)
			::cUser 		:= AllTrim(RR3->RR3_USER)
			::cPWord 		:= AllTrim(RR3->RR3_PWORD)
			::cVisao 		:= RR3->RR3_VISAO
			
			Do Case
				Case RR3->RR3_REMIND == "4"
					::cLembrete := "5"
				Case RR3->RR3_REMIND == "5"
					::cLembrete := "7"
				Case RR3->RR3_REMIND == "6"
					::cLembrete := "14"
				Otherwise
					::cLembrete := RR3->RR3_REMIND
			EndCase
			
			dbSelectArea("RR4")
			dbSetOrder(1)
			cChave := xFilial("RR4", RR3->RR3_FILIAL) + ::cRotina
			dbSeek(cChave)
			While RR4->(!EoF()) .And. RR4->(RR4_FILIAL + AllTrim(RR4_ROTINA) == cChave)
				
				aAdd(::aDestinatarios, Array(10))
				
				aTail(::aDestinatarios)[01] := RR4->RR4_TPREG 
				aTail(::aDestinatarios)[02] := cValToChar(RR4->RR4_ORDEM)
				aTail(::aDestinatarios)[03] := RR4->RR4_FILFUN
				aTail(::aDestinatarios)[04] := RR4->RR4_MAT   
				aTail(::aDestinatarios)[05] := Alltrim(RR4->RR4_NOME)
				aTail(::aDestinatarios)[06] := RR4->RR4_ACAO  
				aTail(::aDestinatarios)[07] := Alltrim(RR4->RR4_EMAIL)
				aTail(::aDestinatarios)[08] := RR4->RR4_NOTDOC
				aTail(::aDestinatarios)[09] := If(RR4->RR4_NOTIFY == "3", "2", If(RR4->RR4_NOTIFY == "2", "3", RR4->RR4_NOTIFY))
				aTail(::aDestinatarios)[10] := RR4->RR4_KEY
				
				RR4->(dbSkip())
			EndDo
			
			//Ordena por tipo de registro + chave 
			aSort(::aDestinatarios,,, {|x, y| x[01] + x[10] <= y[01] + y[10]})
		EndIf
	Endif
	
	If Empty(::aDestinatarios) 
		// Adiciona o funcionário
		aAdd(::aDestinatarios, {"1", "1", "", "", "", "0", "", If(::cTpNotTae $ "1|3", "1", "2"), ::cTpNotTae, ""})
	EndIf
	
	//Caso não seja informado o usuário utiliza o dos parâmetros
	If Empty(::cUser)
		::cUser := AllTrim(GetMv('MV_RHTAEUS',, ""))
		::cPWord := AllTrim(GetMv('MV_RHTAEPW',, ""))
	EndIf	
Return

/*/{Protheus.doc} PONXTAE::Login
Realiza o login no TAE
@type method
@author Cícero Alves
@since 13/02/2026
@return logical, verdadeiro quando o login é realizado com sucesso
/*/
Method Login() class PONXTAE
	Local aHeader	:= {}					as array
	Local cBody		:= ""					as character
	Local cPath		:= ""					as character
	Local lRet		:= .T.					as logical
	Local lRespApi	:= .F.					as logical
	Local oResponse	:= JsonObject():New()	as Object

	::lLogado := .F.
	
	// Valida o usuário e senha informados
	If !Empty(::cUser) .And. !Empty(::cPWord) .And. ("@" $ rc4crypt(::cUser, "123456789", .F., .T.))
		// Define a API para realizar o login no TAE
		cPath := "identityintegration/v3/auth/login"

		// Motagem do body da requisição
		cBody := '{'
		cBody += 	'"username": "' + rc4crypt(::cUser, "123456789", .F., .T.) + '",'
		cBody += 	'"password": "' + rc4crypt(::cPWord, "123456789", .F., .T.) + '"'
		cBody += '}'

		// Header da requisição
		aAdd(aHeader, "accept: application/json")
		Aadd(aHeader, "Content-Type: application/json")

		// Define a API e parâmetros para login no TAE
		::oClient:SetPath(cPath)
		::oClient:SetPostParams(cBody)
		
		lRespApi := ::oClient:Post(aHeader)
		
		If lRespApi
			oResponse:FromJson(::oClient:GetResult())
		EndIf

		If lRespApi .And. oResponse:HasProperty("succeeded") .And. oResponse["succeeded"]
			::cAuthToken := oResponse["data", "token"]
			::lLogado := .T.
		Else
			// "Não foi possível efetuar autenticação no TAE" "Verifique os parâmetros MV_SIGNURL, MV_RHTAEUS e MV_RHTAEPW"
			Help( ,, "HELP",, STR0001, 1,,,,,,, {STR0002})
			lRet := .F.
		EndIf
	Else
		// "Verifique o usuário e senha informados nos parâmetros MV_RHTAEUS e MV_RHTAEPW"
		Help(,, "HELP",, STR0001, 1,,,,,,, {STR0003})
		lRet := .F.
	EndIf	
Return lRet

/*/{Protheus.doc} PONXTAE:GetResponseCode
Retrona o código HTTP recebido após realizar uma requisição
@type method
@author Cí­cero Alves
@since 11/06/2025
@return character, Código HTTP de retorno
/*/
Method GetResponseCode() class PONXTAE
Return ::oCLient:oResponseH:GetStatusCode()

/*/{Protheus.doc} PONXTAE:GetTypeErro403
Retorna qual o tipo do erro do Código 403 de acordo com as informações do ResposeHeader
@type method
@author Cícero Alves
@since 11/06/2025
@return Character, "1" = Erro de bloqueio do firewall; "2" = Usuário sem permissão
/*/
Method GetTypeErro403() class PONXTAE
	
	Local cRet := "" as Character
	
	If ::GetResponseCode() == "403"
		cRet := If(::oCLient:GetHeader("Server") == "CloudFront", "1", "2")
	EndIf
	
Return cRet

/*/{Protheus.doc} PONXTAE:SendMail
Envia email para os assinates pendentes do documento
@type method
@author Cí­cero Alves
@since 11/06/2025
@param cIdDoc, character, Id do documento no TAE
@return Logical, de acordo com o retorno da requisição
/*/
Method SendMail(cIdDoc) class PONXTAE
	
	Local aHeader 	:= {} 	as Array
	Local cBody		:= "" 	as Character
	Local cPath		:= "" 	as Character
	Local lret 		:= .F. 	as Logical
	
	Default cIdDoc := ""
	
	If !Empty(cIdDoc)
		
		cPath := "signintegration/v2/Publicacoes/reenvia-email-pendentes"
		
		cBody := '{"listaDocumentos": [' + cIdDoc + ']}'
		
		Aadd(aHeader, "Accept: application/json")
		Aadd(aHeader, "Content-Type: application/json")
		Aadd(aHeader, "Authorization: Bearer " + ::cAuthToken)
		
		::oClient:SetPath(cPath)
		::oClient:SetPostParams(cBody)
		
		lRet := ::oClient:Post(aHeader)
	EndIf
	
Return lRet

/*/{Protheus.doc} PONXTAE::NotifFunc
Envia solicitação de assinatura para os destinatários do documento
@type method
@author Marco Nakazawa
@since 17/07/2025
@param cIdDoc, character, Id do documento no TAE
@param cFilFunc, character, Filial do funcionário
@param cMatFunc, character, Matrícula do funcionário
@return Array, 1º posição logical - Sucesso ou falha (.T. ou .F.), 2º posição character, mensagem de erro caso houver
/*/
Method NotifFunc(cIdDoc, cFilFunc, cMatFunc, cDepto) class PONXTAE
	
	Local aHeader 	:= {} 			as Array
	Local aResp 	:= {}			as Array 
	Local cBody		:= "" 			as Character
	Local cPath		:= "" 			as Character
	Local cMsg		:= "" 			as Character
	Local lRet 		:= .F. 			as Logical
	Local aDest		:= {}			as Array
	Local aObserv	:= {}			as Array
	Local nI		:= 0			as Numeric
	Local nLenDest	:= 0			as Numeric
	Local oErro		:= NIL			as Object
	
	Default cIdDoc		:= ""
	Default cFilFunc	:= SRA->RA_FILIAL
	Default cMatFunc	:= SRA->RA_MAT
	Default cDepto		:= SRA->RA_DEPTO
	
	aResp := {.F., STR0004} // "Não foi possível realizar o envio da solicitação de assinatura para o funcionário"}
	
	If lCheckFil .And. !(cLastFil == cFilFunc)
		::loadData(cFilFunc)
		If ! ::Login()
			cLastFil := "********"
			aResp := {.F., STR0005 + " " + cFilFunc} // "Não foi possível realizar o login com o usuário informado para a filial"
			Return aResp
		EndIf
		
		cLastFil := cFilFunc
	EndIf
	
	aDest := ::GetDestinatarios(cFilFunc, cMatFunc, @aObserv, cDepto)
	
	If !Empty(cIdDoc) .And. !Empty(aDest)
		
		aAdd(aHeader, "content-type: application/json")
		
		cPath := "documents/v1/publicacoes"
		
		cBody := '{'
		cBody +=	'"idDocumento": ' + cIdDoc + ','
		cBody +=	'"utilizaworkflow": ' + If(::lWorkflow, 'true', 'false') + ','
		
		//  Opções Publicação
		cBody += '"publicacaoOpcoes": {
		cBody += 	'"solicitaAssinaturaManuscrita": ' 	+ If(::lManuscrita, 'true', 'false') + ','
		cBody += 	'"permiteRejeitarDocumento": ' 		+ If(::lRejeita, 'true', 'false') + ','
		cBody += 	'"intervaloLembrete": "' 			+ ::cLembrete + '",'
		
		If !Empty(::cAssunto)
			cBody += 	'"assuntoMensagem": "'			+ ::cAssunto + '",'
		EndIf
		
		If !Empty(::cMensagem)
			cBody += 	'"corpoMensagem": "' 			+ ::cMensagem + '",'
		EndIf
		
		If ::nLimite > 0
			cBody += 	'"dataExpiracao": "' 				+ FWTimeStamp(3, Date() + ::nLimite, "23:59:59") + '"'
		EndIf
		
		cBody += '},'
		
		//-- Destinatários
		cBody +=	'"destinatarios": ['
		
		nLenDest := Len(aDest)
		For nI := 1 To nLenDest
			cBody +=		'{'
			cBody +=			'"email": "' + aDest[nI][01] + '",'
			cBody +=			'"acao": "' + aDest[nI][02] + '",'
			cBody +=			'"tipoIdentificacao": "1",'
			cBody +=			'"nomeCompleto": "' + EncodeUTF8(aDest[nI][03]) + '",'
			cBody +=			'"identificacao": "' + aDest[nI][04] + '",'
			
			cBody +=			'"tipoAutenticacao": "' + If(::lMRHTae, "2", "1") + '",'
			
			If ::lWorkflow
				cBody +=			'"workflow": "' + aDest[nI][05] + '",'
			EndIf
			
			If ::lMRHTae
				cBody +=		'"tipoEnvioDocumento": ' + aDest[nI][06] + ','
				cBody +=		'"tipoEnvioCodigo": ' + aDest[nI][07]
				If !Empty(aDest[nI][08])
					cBody += ','
					cBody +=		'"telefone": "' + aDest[nI][08] + '"'
				EndIf
			EndIf
			
			cBody += If(nI < nLenDest, '},' , '}' )
		Next
		
		cBody +=	']'
		
		// Observadores
		If !Empty(aObserv)
			cBody +=	','
			cBody +=	'"observadores": ['
			
			nLenDest := Len(aObserv)
			For nI := 1 To nLenDest
				cBody +=		'{'
				cBody += '"email": "' + aObserv[nI] + '",'
				cBody += '"tipoEnvioDocumento": 1'
				
				cBody += If(nI < nLenDest, '},' , '}' )
			Next nI
			
			cBody +=	']'
		EndIf
		
		cBody += '}'
		
		Aadd(aHeader, "Accept: application/json")
		Aadd(aHeader, "Content-Type: application/json")
		Aadd(aHeader, "Authorization: Bearer " + ::cAuthToken)
		
		::oClient:SetPath(cPath)
		::oClient:SetPostParams(cBody)
		
		lRet := ::oClient:Post(aHeader)
		
		// Retorna apenas se deu erro de integração com o TAE
		If !lRet
			oErro := JsonObject():New()
			oErro:FromJSON(::oClient:cResult)
			oErro:ToJSON(::oClient:cResult)
			
			If ValType(oErro['errors']) == "A"
				cMsg := DecodeUTF8(oErro['errors'][1])
			EndIf
		EndIf
		
		aResp := {}
		aAdd(aResp, lRet)
		aAdd(aResp, cMsg)
	EndIf
	
Return aResp

/*/{Protheus.doc} PONXTAE:chkSubType
Verifica qual o tipo de assinatura do documento
@type method
@author Marco Nakazawa
@since 05/11/2025
@return Lógico, .T. se o download foi realizado com sucesso ou .F. caso contrário
/*/
Method chkSubType(cIdDoc) class PONXTAE
Local aHeader 	:= {}	as Array
Local cUrl		:= ""	as Character
Local cRet		:= ""	as Character
Local oJson				as object

Default cIdDoc	:= ""

If !Empty(cIdDoc)
	cUrl := "documents/v2/publicacoes/" + cIdDoc

	Aadd(aHeader, "Accept: application/json")
	Aadd(aHeader, "Authorization: Bearer " + ::cAuthToken)

	::oClient:SetPath(cUrl)
	::oClient:Get(aHeader)

	oJson := JsonObject():New()
	oJson:FromJSON(::oClient:cResult)

	If oJson["data"]["assinantes"][1]["statusTipoAssinatura"] <> Nil
		If (oJson["data"]["assinantes"][1]["statusTipoAssinatura"] == 0, cRet := "2",  cRet := "3")
	EndIf
EndIf
Return cRet

/*/{Protheus.doc} PONXTAE:getDocument
Realiza o donwload do arquivo do TAE assinado.
@type method
@author Marco Nakazawa
@since 05/11/2025
@return Lógico, .T. se o download foi realizado com sucesso ou .F. caso contrário
/*/
Method getDocument(cIdDoc, cPath, cTipoAssnt, cNomeArq) class PONXTAE
	Local aHeader 	:= {}					as array
	Local cPatch 	:= ""					as character
	Local cContent	:= ""					as character
	Local lRespApi	:= .F.					as logical
	Local lRet		:= .F.					as logical
	Local nHandle	:= 0					as numeric
	Local oResponse	:= JsonObject():New()	as object

	Default cIdDoc		:= ""
	Default cPath		:= ""
	Default cTipoAssnt	:= ""

	If !Empty(cIdDoc) .And. !Empty(cPath) .And. !Empty(cTipoAssnt) .And. !Empty(cNomeArq)
		// Define o endpoint da API para fazer o download do documento
		cPatch := "documents/v2/publicacoes/" + cIdDoc + "/download?tipoDownload=" + cTipoAssnt

		// Header da requisição
		Aadd(aHeader, "Accept: application/json")
		Aadd(aHeader, "Authorization: Bearer " + ::cAuthToken)
		
		// Define a API para fazer o download do documento
		::oClient:SetPath(cPatch)
		
		// Chama API utilizando o GET
		lRespApi := ::oClient:Get(aHeader)

		// Validações para pegar o retorno da API
		If lRespApi
			oResponse:FromJson(::oClient:GetResult())
		EndIf

		If lRespApi .And. oResponse:HasProperty("success") .And. oResponse["success"] .And. !Empty(oResponse["data"]["fileUrl"])
			If ExistDir(cPath)
				cContent := HttpGet(oResponse["data"]["fileUrl"])

				nHandle := FCreate(cPath + cNomeArq)
				If nHandle >= 0
					FWrite(nHandle, cContent, Len(cContent))
					FClose(nHandle)
					lRet := .T.
				EndIf
			EndIf
		EndIf
	EndIf
Return lRet

/*/{Protheus.doc} PONXTAE::GetDestinatarios
Retorna a lista de destinatários para o documento
@type method
@author Cícero Alves
@since 13/02/2026
@param cFilFunc, character, Filial do funcionário
@param cMatFunc, character, Matrícula do funcionário
@param aObserv, array, Lista com os emails do observadores - Deve se passado por referência
@return array, lista com as informações dos destinatários 
/*/
Method GetDestinatarios(cFilFunc, cMatFunc, aObserv, cDepto) class PONXTAE
	
	Local aArea			:= GetArea()
	Local aDest 		:= {}
	Local aGestor		:= {}
	Local nI			:= 0
	Local cFilAtu		:= ""
	Local cMatAtu		:= ""
	Local cEmpAtu		:= ""
	Local cQuery		:= ""
	Local cAliasFunc	:= GetNextAlias()
	
	Default cFilFunc	:= ""
	Default cMatFunc	:= ""
	Default aObserv		:= {}
	Default cDepto		:= ""
	
	Default cOrgCfg := SuperGetMv("MV_ORGCFG", NIL, "0" )
	
	If !Empty(cFilFunc) .And. !Empty(cMatFunc)
		
		For nI := 1 To Len(::aDestinatarios)
			
			cFilAtu := ""
			cMatAtu := ""
			cEmpAtu := ""
			
			If ! ::aDestinatarios[nI][01] == "4"
				If ::aDestinatarios[nI][01] == "1" 			// Funcionário
					
					cFilAtu := cFilFunc
					cMatAtu := cMatFunc
					cEmpAtu := cEmpAnt
					
				ElseIf ::aDestinatarios[nI][01] == "2"  	// Gestor
					
					If ::aDestinatarios[nI][10] == "01"
						aGestor := fBuscaSuperior(cFilFunc, cMatFunc, cDepto,, cOrgCfg, ::cVisao, cEmpAnt)
					ElseIf !Empty(aGestor)
						aGestor := fBuscaSuperior(aGestor[01][01], aGestor[01][02], aGestor[01][08],, cOrgCfg, ::cVisao, aGestor[01][9])
					EndIf 
					If !Empty(aGestor)
						cFilAtu := aGestor[01][01]
						cMatAtu := aGestor[01][02]
						cEmpAtu := aGestor[01][09]
					Else
						// "Não foi encontrado o gestor de nível" - "para o funcionário"
						aAdd(::aMensagens, STR0006 + " " + ::aDestinatarios[nI][10] + " " + STR0007 + cFilAtu + "-" + cMatAtu)
					EndIf
				ElseIf ::aDestinatarios[nI][01] == "3" 		// Assinante
					cFilAtu := ::aDestinatarios[nI][03]
					cMatAtu := ::aDestinatarios[nI][04]
					cEmpAtu := cEmpAnt
				EndIf
				
				If !Empty(cFilAtu) .And. !Empty(cMatAtu)
					
					If oQryFunc == NIL
						oQryFunc := FWPreparedStatement():New()
						
						cQuery := "SELECT RA_EMAIL, RA_NOME, RA_NOMECMP, RA_CIC, RA_DDDCELU, RA_NUMCELU"
						cQuery += " FROM ? SRA"
						cQuery += " WHERE SRA.RA_FILIAL = ?"
						cQuery += " AND SRA.RA_MAT = ?"
						cQuery += " AND SRA.D_E_L_E_T_ = ?"
						
						cQuery := ChangeQuery(cQuery)
						
						oQryFunc:SetQuery(cQuery)
					EndIf
					
					oQryFunc:SetUnsafe(1, RetFullName("SRA", cEmpAtu))
					oQryFunc:SetString(2, cFilAtu)
					oQryFunc:SetString(3, cMatAtu)
					oQryFunc:SetString(4, " ")
					
					cQuery := oQryFunc:getFixQuery()
					dbUseArea(.T., "TOPCONN", TcGenQry(,,cQuery), cAliasFunc)
					
					If (cAliasFunc)->(!EoF())
						If !Empty((cAliasFunc)->RA_EMAIL) 
							If ::aDestinatarios[nI][06] == "4"
								aAdd(aObserv, AllTrim((cAliasFunc)->RA_EMAIL))
							Else 
								aAdd(aDest, Array(8))
								
								aTail(aDest)[1] := Alltrim((cAliasFunc)->RA_EMAIL)
								aTail(aDest)[2] := ::aDestinatarios[nI][06]
								aTail(aDest)[3] := If(!Empty((cAliasFunc)->RA_NOMECMP), AllTrim((cAliasFunc)->RA_NOMECMP), Alltrim((cAliasFunc)->RA_NOME))
								aTail(aDest)[4] := (cAliasFunc)->RA_CIC
								aTail(aDest)[5] := ::aDestinatarios[nI][02]
								aTail(aDest)[6] := ::aDestinatarios[nI][08]
								aTail(aDest)[7] := ::aDestinatarios[nI][09]
								
								If (!::aDestinatarios[nI][08] == "1" .Or. !::aDestinatarios[nI][09] == "1") .And. !Empty((cAliasFunc)->RA_DDDCELU) .And. !Empty((cAliasFunc)->RA_NUMCELU)
									aTail(aDest)[8] := (cAliasFunc)->(RA_DDDCELU + RA_NUMCELU)
								Else
									aTail(aDest)[8] := ""
									If !::aDestinatarios[nI][08] == "1" .Or. !::aDestinatarios[nI][09] == "1"
										aAdd(::aMensagens, STR0008 + " " + cFilAtu + "-" + cMatAtu + " " + STR0009) // "Não possui celular cadastrado. As notificações serão enviadas por e-mail"
										::aDestinatarios[nI][08] := "1"
										::aDestinatarios[nI][09] := "1"
									EndIf
								EndIf
							EndIf
						Else
							aAdd(::aMensagens, STR0008 + " " + cFilAtu + "-" + cMatAtu + " " + STR0010) // "Não possui e-mail cadastrado"
						EndIf
					Else
						aAdd(::aMensagens, STR0011 + ": " + cFilAtu + "-" + cMatAtu) // "Funcionário não encontrado"
					EndIf
					(cAliasFunc)->(dbCloseArea())
				EndIf
				
			Else // Observadores
				aAdd(aObserv, ::aDestinatarios[nI][07])
			EndIf
			
		Next nI
	EndIf
	
	RestArea(aArea)
	
Return aDest

/*/{Protheus.doc} PONXTAE:getMensagens
Retorna as mensagens não impeditivas
@type method
@author Cícero Alves
@since 13/02/2026
@return array, Array de strings com as ocorrências
/*/
Method getMensagens() class PONXTAE
Return ::aMensagens

/*/{Protheus.doc} PONXTAE:sendEsp
Realiza o envio de um arquivo para o TAE e solicita a assinatura
@type method
@author Marco Nakazawa
@since 19/06/2026
@param cPathFile, Caractere, Diretório do arquivo a ser enviado
@param cNameFile, Caractere, Nome do Arquivo a ser enviado
@param cFilFunc, Caractere, Filial do funcionário
@param cMatFunc, Caractere, Matrícula do funcionário
@param dPerIni, Date, Período inicial
@param dPerFim, Date, Período final
@param cCodeBar, Caractere, Código de barras
@return array, Array de strings com as ocorrências
/*/
Method sendEsp(cPathFile, cNameFile, cFilFunc, cMatFunc, dPerIni, dPerFim, cCodeBar, lTae, cDepto) class PONXTAE
	local nId		:= 0
	Local cMsg		:= ""
	Local aResp		:= {}
	Local aRet		:= {{}, {}}
	Local aRetApi	:= .F.

	Default cPathFile	:= ""
	Default cNameFile	:= ""
	Default cFilFunc	:= ""
	Default cMatFunc	:= ""
	Default dPerIni		:= sToD(" / / ")
	Default dPerFim		:= sToD(" / / ")
	Default cCodeBar	:= ""
	Default lTae		:= .F.
	Default cDepto		:= ""

	aRetApi := ::uploadDoc(cPathFile, cNameFile)

	If aRetApi[1]
		nId := aRetApi[2]
		
		aResp := ::NotifFunc(cValToChar(nId), cFilFunc, cMatFunc, cDepto)

		If aResp[1]
			aAdd(aRet[1], cFilFunc + " - " + cMatFunc + ": " + STR0012) // "Solicitação de assinatura envida para o funcionário."
		Else 
			aAdd(aRet[2], cFilFunc + " - " + cMatFunc + ": " + aResp[2]) // "Erro retornado pela API do TAE"
		EndIf
		
		// Atualiza a tabela RS4
		::gravaRS4(cNameFile, nId, cFilFunc, cMatFunc, dPerIni, dPerFim, cCodeBar, lTae)
	Else
		cMsg := ::GetTypeErro403()
		cMsg := If(cMsg == "1", STR0013 + STR0014, "") // "Não foi possível realizar o upload do arquivo para o TAE." "O arquivo foi bloqueado pelo firewall do servidor onde o TAE está hospedado."
		
		If Empty(cMsg)
			cMsg := If(aRetApi[2] != NIL, aRetApi[2], STR0013 + STR0015) //"Não foi possível realizar o upload do arquivo para o TAE." "Verifique se o usuário utilizado para a integração possui permissão para enviar arquivos."
		EndIf
		
		aAdd(aRet[2], cFilFunc + " - " + cMatFunc + ": " + cMsg)
	EndIf
Return aRet

/*/{Protheus.doc} gravaRS4
Grava na tabela RS4 o controle dos arquivos gerados com código de barras ou que foram enviados para o TAE
@type Method
@author Marco Nakazawa
@since 19/06/2026
@param cNomeDoc, Caractere, Nome do arquivo
@param cID, Caractere, ID do arquivo no TAE
@param cFilFunc, Caractere, Filial do funcionário
@param cMatFunc, Caractere, Matrícula do funcionário
@param dPerIni, Date, Período inicial
@param dPerFim, Date, Período final
@param cCodeBar, Caractere, Código de barras
@param lTae, Logical, Se integra com TAE
/*/
Method gravaRS4(cNomeDoc, nId, cFilFunc, cMatFunc, dPerIni, dPerFim, cCodeBar, lTae) class PONXTAE
	Local aRS4Area		:= GetArea()
	Local cPerIni		:= ""
	Local cPerFim		:= ""
	Local cFilRS4		:= ""
	Local cChave		:= ""
	Local lCpoRS4		:= .F.
	Local lCpoRotRS4	:= .F.
	Local lAtualiza		:= .F.
	Local aStatusDoc	:= .F.
	Local lGrava		:= .T.
	Local lFound		:= .F.

	Default cNomeDoc	:= ""
	Default nId 		:= 0
	Default cFilFunc	:= ""
	Default cMatFunc	:= ""
	Default dPerIni		:= sToD(" / / ")
	Default dPerFim		:= sToD(" / / ")
	Default cCodeBar	:= ""
	Default lTae		:= .F.

	DbSelectArea("RS4")

	lCpoRS4 	:= RS4->(ColumnPos("RS4_TPDOC")) > 0
	lCpoRotRS4	:= RS4->(ColumnPos("RS4_ROTINA")) > 0
	cFilRS4		:= xFilial("RS4", cFilFunc)
	cPerIni := dToS(dPerIni)
	cPerFim := dToS(dPerFim)
	
	cChave := cFilRS4 + cMatFunc + cPerIni + cPerFim

	// Define a chave de busca baseado na rotina
	If lCpoRotRS4
		RS4->(DbSetOrder(RetOrder("RS4", "RS4_FILIAL+RS4_MAT+RS4_PER+RS4_ROTINA")))

		If ::cRotina == "PONR010"
			lFound := RS4->(DbSeek(cChave + ::cRotina)) .Or. RS4->(DbSeek(cChave + Space(TamSX3("RS4_ROTINA")[1])))
		Else
			lFound := RS4->(DbSeek(cChave + ::cRotina))
		EndIf
	Else
		RS4->(dbSetOrder(1))
		lFound := RS4->(DbSeek(cChave))
	EndIf

	If lCpoRS4
		fStatusTAE(cFilRS4, cMatFunc, .F., @Self, ::cRotina) // Atualiza o status dos documentos na RS4
	EndIf

	If lFound
		While !RS4->(EoF()) .And. RS4->(RS4_FILIAL + RS4_MAT + RS4_PER) == cChave
			If lCpoRotRS4 
				If ::cRotina == "PONR010"
					If (!Empty(RS4->RS4_ROTINA) .And. RS4->RS4_ROTINA <> ::cRotina)
						RS4->(DbSkip())
						Loop
					EndIf
				EndIf
			EndIf

			If RS4->RS4_STATUS == "2" //Pendente
				If !lCpoRS4 .Or. (lCpoRS4 .And. RS4->RS4_TPDOC == "2")
					lAtualiza := .T.
					EXIT
				ElseIf lTAE .And. lCpoRS4 .And. RS4->RS4_TPDOC == "1"
					// Verifica o Status do documento no TAE
					aStatusDoc := ::statusDoc(RS4->RS4_ID)
					
					If aStatusDoc[1] 
						If aStatusDoc[2] == 0 // Status Pendente cancela o documento
							If ::cancelDoc(RS4->RS4_ID) // 
								lAtualiza := .T.
								EXIT
							EndIf
						ElseIf aStatusDoc[2] == 5 // Status Rascunho exclui o documento
							If ::deleteDoc(RS4->RS4_ID) 
								lAtualiza := .T.
								EXIT
							EndIf
						EndIf
					EndIf
				EndIf
			EndIf
			RS4->(dbSkip())
		EndDo
	Else
		//Registro novo
		aStatusDoc := ::statusDoc(nId)

		If aStatusDoc[1] .And. aStatusDoc[2] == 5 // Rascunho
			If ::deleteDoc(nId) // Exclui o documento
				lGrava := .F.
			EndIf
		EndIf
	EndIf

	If lGrava
		RecLock("RS4", !lAtualiza)
			RS4->RS4_FILIAL := cFilFunc
			RS4->RS4_MAT	:= cMatFunc
			RS4->RS4_PER	:= cPerIni + cPerFim 
			RS4->RS4_DATAI	:= dPerIni
			RS4->RS4_DATAF	:= dPerFim
			RS4->RS4_CODEBA	:= cCodeBar
			RS4->RS4_STATUS	:= "2" //Pendente

			If lCpoRS4
				RS4->RS4_TPDOC	:= If(lTae, "1", "2")
				If lTae
					RS4->RS4_NDOC	:= cNomeDoc
					RS4->RS4_ID		:= nId
					RS4->RS4_DTINTE	:= Date()
				EndIf
			EndIf

			If lCpoRotRS4
				RS4->RS4_ROTINA := ::cRotina
			EndIf
		MsUnLock()
	EndIf

	RestArea(aRS4Area)
Return

/*/{Protheus.doc} uploadDoc
Realiza o upload do arquivo para o TAE
@type Method
@author Marco Nakazawa
@since 20/06/2026
@param cPath, Caractere, Caminho completo do arquivo
@param cFileName, Caractere, Nome do arquivo
/*/
Method uploadDoc(cPath, cFileName) class PONXTAE
	Local aHeader		:= {}					as array
	Local aRet			:= {.F., ""}			as array
	Local cBody			:= ""					as character
	Local cPatch		:= ""					as character
	Local cArqPdf		:= ""					as character
	Local cBoundary		:= "" 					as character
	Local cCRLF			:= Chr(13) + Chr(10) 	as character
	Local lRespApi		:= .F.					as logical
	Local nHnd			:= 0					as numeric
	Local nTamanho		:= 0					as numeric
	Local oResponse		:= JsonObject():New()	as object

	// Lê o conteúdo do PDF
	nHnd := FOpen(cPath, 0)

	If nHnd != -1
		nTamanho := FSeek(nHnd, 0, 2)
		FSeek(nHnd, 0, 0)
		
		cArqPdf := Space(nTamanho)
		FRead(nHnd, @cArqPdf, nTamanho)
		FClose(nHnd)

		// Define o endpoint da API para upload do documento
		cPatch := "documents/v1/envelopes/upload"

		// Monta o body multipart/form-data
		cBoundary := "--SigaponTae" + DToS(Date()) + StrTran(Time(), ":", "")

		// Campo NomeEnvelope (obrigatório)
		cBody := "--" + cBoundary + cCRLF
		cBody += 'Content-Disposition: form-data; name="NomeEnvelope"' + cCRLF + cCRLF
		cBody += cFileName + cCRLF

		// Campo Envelope (Arquivo PDF em binário)
		cBody += "--" + cBoundary + cCRLF
		cBody += 'Content-Disposition: form-data; name="Envelope"; filename="' + cFileName + '"' + cCRLF
		cBody += 'Content-Type: application/pdf' + cCRLF + cCRLF
		cBody += cArqPdf + cCRLF 
		cBody += "--" + cBoundary + "--" + cCRLF

		// Header da requisição
		aAdd(aHeader, "Content-Type: multipart/form-data; boundary=" + cBoundary)
		aAdd(aHeader, "Authorization: Bearer " + ::cAuthToken)

		// Define a API e parâmetros para upload do documento
		::oClient:SetPath(cPatch)
		::oClient:SetPostParams(cBody)

		// Chama API utilizando o POST
		lRespApi := ::oClient:Post(aHeader)

		// Validações para pegar o retorno da API
		oResponse:FromJson(::oClient:GetResult())

		If lRespApi .And. oResponse:HasProperty("success") .And. oResponse["success"]
			aRet[1] := .T.
			aRet[2] := oResponse["data"]
		Else
			If (oResponse:HasProperty("errors") .And. ValType(oResponse["errors"]) == "A" .And. ValType(oResponse["errors"][1]) == "C", aRet[2] := DecodeUTF8(oResponse["errors"][1]), aRet[2] := ::oClient:GetLastError())
		EndIf

		FreeObj(oResponse)
	Else
		aRet[2] := STR0016 // "Não foi possível abrir o arquivo PDF para envio ao TAE."
		Return aRet
	EndIf
Return aRet

/*/{Protheus.doc} statusDoc
Verifica o status do documento no TAE
@type Method
@author Marco Nakazawa
@since 20/06/2026
@param cPath, Caractere, Caminho completo do arquivo
@param cFileName, Caractere, Nome do arquivo
/*/
Method statusDoc(nId) class PONXTAE
	Local aHeader		:= {}					as array
	Local aRet			:= {.F., 0}				as array
	Local cPatch		:= ""					as character
	Local lRespApi		:= .F.					as logical
	Local oResponse		:= JsonObject():New()	as object

	Default nId	:= 0

	If nId > 0
		// Define o endpoint da API para consultar o status do documento
		cPatch := "documents/v2/publicacoes/" + cValToChar(nId)

		// Header da requisição
		aAdd(aHeader, "accept: application/json")
		aAdd(aHeader, "Authorization: Bearer " + ::cAuthToken)

		// Define a API para buscar o status do documento no TAE
		::oClient:SetPath(cPatch)

		// Chama API utilizando o GET
		lRespApi := ::oClient:Get(aHeader)

		// Validações para pegar o retorno da API
		oResponse:FromJSON(::oClient:GetResult())

		If lRespApi .And. oResponse:HasProperty("success") .And. oResponse["success"]
			aRet[1] := .T.
			aRet[2] := oResponse["data"]["status"]
		Else
			If (oResponse:HasProperty("errors") .And. ValType(oResponse["errors"]) == "A" .And. ValType(oResponse["errors"][1]) == "C", aRet[2] := DecodeUTF8(oResponse["errors"][1]), aRet[2] := ::oClient:GetLastError())
		EndIf

		FreeObj(oResponse)
	EndIf
Return aRet

/*/{Protheus.doc} cancelDoc
Realiza o cancelamento do documento no TAE
@type Method
@author Marco Nakazawa
@since 20/06/2026
@param nId, Numerico, ID do documento no TAE
/*/
Method cancelDoc(nId) class PONXTAE
	Local aHeader		:= {}					as array
	Local aRet			:= {.F.,""}				as array
	Local cPatch		:= ""					as character
	Local lRespApi		:= .F.					as logical
	Local lRet			:= .F.					as logical
	Local oResponse		:= JsonObject():New()	as object

	Default nId	:= 0

	If nId > 0
		// Define o endpoint da API para cancelar o documento
		cPatch := "documents/v1/publicacoes/" + cValToChar(nId) + "/cancelar"

		// Headers da requisição
		aAdd(aHeader, "accept: application/json")
		aAdd(aHeader, "Authorization: Bearer " + ::cAuthToken)

		// Define a API para cancelar o documento
		::oClient:SetPath(cPatch)

		// Chama API utilizando o POST
		lRespApi := ::oClient:Post(aHeader)

		// Validações para pegar o retorno da API
		oResponse:FromJSON(::oClient:GetResult())

		If lRespApi .And. oResponse:HasProperty("success") .And. oResponse["success"]
			lRet := oResponse["success"]
		Else
			If (oResponse:HasProperty("errors") .And. ValType(oResponse["errors"]) == "A" .And. ValType(oResponse["errors"][1]) == "C", aRet[2] := DecodeUTF8(oResponse["errors"][1]), aRet[2] := ::oClient:GetLastError())
		EndIf

		FreeObj(oResponse)
	EndIf
Return lRet

/*/{Protheus.doc} deleteDoc
Realiza a exclusão do documento no TAE
@type Method
@author Marco Nakazawa
@since 20/06/2026
@param nId, Numerico, ID do documento no TAE
/*/
Method deleteDoc(nId) class PONXTAE
	Local aHeader		:= {}					as array
	Local aRet			:= {.F.,""}				as array
	Local cPatch		:= ""					as character
	Local lRet			:= .F.					as logical
	Local lRespApi		:= .F.					as logical
	Local oResponse		:= JsonObject():New()	as object

	Default nId	:= 0

	If nId > 0
		// Define o endpoint da API para excluir o documento
		cPatch := "documents/v1/publicacoes/" + cValToChar(nId)

		// Header da requisição
		aAdd(aHeader, "accept: application/json")
		aAdd(aHeader, "Authorization: Bearer " + ::cAuthToken)

		// Define a API para exclusão do documento
		::oClient:SetPath(cPatch)

		// Chama API utilizando o DELETE
		lRespApi := ::oClient:Delete(aHeader)

		// Validações para pegar o retorno da API
		oResponse:FromJSON(::oClient:GetResult())

		If lRespApi .And. oResponse:HasProperty("success") .And. oResponse["success"]
			lRet := oResponse["success"]
		Else
			If (oResponse:HasProperty("errors") .And. ValType(oResponse["errors"]) == "A" .And. ValType(oResponse["errors"][1]) == "C", aRet[2] := DecodeUTF8(oResponse["errors"][1]), aRet[2] := ::oClient:GetLastError())
		EndIf	

		FreeObj(oResponse)
	EndIf
Return lRet

/*/{Protheus.doc} validLogin()
Realiza o login no TAE
@type method
@author Marco Nakazawa
@since 24/07/2026
@param cUser, Character, Usuário do TAE
@param cPassword, Character, Senha do TAE
@return logical, verdadeiro quando o login é válido
/*/
Method validLogin(cUser, cPassword) class PONXTAE
	Local aHeader		:= {}					as array
	Local cBody			:= ""					as character
	Local cPath			:= ""					as character
	Local lRet			:= .F.					as logical
	Local lRespApi		:= .F.					as logical
	Local oResponse		:= JsonObject():New()	as Object

	Default cUser		:= ""
	Default cPassword	:= ""
	
	// Valida o usuário e senha informados
	If !Empty(cUser) .And. !Empty(cPassword)
		// Define a API para realizar o login no TAE
		cPath := "identityintegration/v3/auth/login"

		// Motagem do body da requisição
		cBody := '{'
		cBody += 	'"username": "' + cUser + '",'
		cBody += 	'"password": "' + cPassword + '"'
		cBody += '}'

		// Header da requisição
		aAdd(aHeader, "accept: application/json")
		Aadd(aHeader, "Content-Type: application/json")

		// Define a API e parâmetros para login no TAE
		::oClient:SetPath(cPath)
		::oClient:SetPostParams(cBody)
		
		lRespApi := ::oClient:Post(aHeader)
		
		oResponse:FromJson(::oClient:GetResult())
		
		If lRespApi .And. oResponse:HasProperty("succeeded") .And. oResponse["succeeded"]
			lRet := .T.
		EndIf
	EndIf

	If !lRet
		// "Verifique o usuário e senha informados nos parâmetros MV_RHTAEUS e MV_RHTAEPW"
		Help(,, "HELP",, STR0001, 1,,,,,,, {STR0003})
	EndIf
Return lRet
