#include "protheus.sigagpe.postvacationrequest.post.ch"

namespace totvs.tools.sigagpe

//------------------------------------------------------------------
/*/{Protheus.doc} PostVacationRequest
Tool para criação de solicitações de férias
 
@author Bruno Costa
@since  10/08/2026
@version 1.0
/*/
//-------------------------------------------------------------------
@FWToolMCP(action="post", erpRelease="12.1.2610", routine="GPEM030", option=2, module="SIGAGPE")
class PostVacationRequest implements FWMCPTool
	public method new() as object
	public method getDescription() as character
	public method getNotes() as character
	public method getPayLoadSchema() as json
	public method getReturnSchema() as json
	public method process(jPayLoad as json) as json
    public method getMetrics() as array 
endclass

//------------------------------------------------------------------
/*/{Protheus.doc} new
Construtor da classe

@author Bruno Costa
@since  10/08/2026
@version 1.0
/*/
//-------------------------------------------------------------------
method new() as object class PostVacationRequest
return self
 
//------------------------------------------------------------------
/*/{Protheus.doc} getDescription
Informa a descrição da tool

