#include "protheus.sigagpe.getvacationrequest.get.ch"

namespace totvs.tools.sigagpe

//------------------------------------------------------------------
/*/{Protheus.doc} GetVacationRequest
Tool para consulta de solicitações de férias
 
@author Bruno Costa
@since  10/08/2026
@version 1.0
/*/
//-------------------------------------------------------------------
@FWToolMCP(action="get", erpRelease="12.1.2610", routine="GPEM030", option=2, module="SIGAGPE")
class GetVacationRequest implements FWMCPTool
	public method new() as object
	public method getDescription() as character
	public method getNotes() as character
	public method getPayLoadSchema() as json
	public method getReturnSchema() as json
	public method process(jPayLoad as json) as json
    public method getMetrics() as array 
endclass

//------------------------------------------------------------------
/*/{Protheus.doc} new
Construtor da classe

@author Bruno Costa
@since  10/08/2026
@version 1.0
/*/
//-------------------------------------------------------------------
method new() as object class GetVacationRequest
return self
 
//------------------------------------------------------------------
/*/{Protheus.doc} getDescription
Informa a descrição da tool

@return character, descrição da tool
@author Bruno Costa
@since  10/08/2026
@version 1.0
/*/
//-------------------------------------------------------------------
method getDescription() as character class GetVacationRequest
return FwNoAccent(STR0001) //"Valida se uma solicitação de férias pode ser realizada, considerando as regras legais e de negócio." 
 
//------------------------------------------------------------------
/*/{Protheus.doc} getNotes
Informa as notas adicioanais sobre a tool

@return character, notas sobre a tool
@author Bruno Costa
@since  10/08/2026
@version 1.0
/*/
//-------------------------------------------------------------------
method getNotes() as character class GetVacationRequest
return FwNoAccent(STR0002) //"Utilize esta tool antes da solicitação de férias. Ela valida período, dias, abono, 13º salário e demais regras legais e de negócio."
 
//------------------------------------------------------------------
/*/{Protheus.doc} getMetrics
Retorna as métricas de uso

@return array, métricas de uso da Tool
@author Bruno Costa
@since  10/08/2026
@version 1.0
/*/
//-------------------------------------------------------------------
method getMetrics() as array class GetVacationRequest
return {}
 
//------------------------------------------------------------------
/*/{Protheus.doc} getPayLoadSchema
Retorna o schema (payload) de entrada da tool

@return jSchema, json, Schema de entrada da tool
@author Bruno Costa
@since  10/08/2026
@version 1.0
/*/
//-------------------------------------------------------------------
method getPayLoadSchema() as json class GetVacationRequest
local jSchema as json

jSchema := totvs.framework.mcp.tools.getJsonSchema()

jSchema["properties"] := { ;
    "idManager":      { "type": "string"  }, ;
    "idEmployee":     { "type": "string"  }, ;
    "initVacation":   { "type": "string"  }, ;
    "endVacation":    { "type": "string"  }, ;
    "initPeriod":     { "type": "string"  }, ;
    "endPeriod":      { "type": "string"  }, ;
    "christmasBonus": { "type": "boolean" }, ;
    "days":           { "type": "integer" }, ;
    "vacationBonus":  { "type": "integer" }  ;
}

jSchema["required"] := { ;
    "idManager", ;
    "idEmployee", ;
    "initVacation", ;
    "endVacation", ;
    "initPeriod", ;
    "endPeriod", ;
    "christmasBonus", ;
    "days", ;
    "vacationBonus" ;
}

return jSchema
 
//------------------------------------------------------------------
/*/{Protheus.doc} getReturnSchema
Retorna o schema (payload) de entrada da tool

@return jSchema, json, Schema de entrada da tool
@author Bruno Costa
@since  10/08/2026
@version 1.0
/*/
//-------------------------------------------------------------------
method getReturnSchema() as json class GetVacationRequest
local jSchema as json

jSchema := totvs.framework.mcp.tools.getJsonSchema()

jSchema["properties"] := { ;
    "ok":      { "type": "boolean" }, ;
    "message": { "type": "string"  }  ;
}

jSchema["required"] := { ;
    "ok", ;
    "message" ;
}

return jSchema
 
//------------------------------------------------------------------
/*/{Protheus.doc} process
Método de processamento da tool, onde será gerada a resposta

@param jPayLoad, json, Parâmetros de entrada da tool
@return jResp, json, Resposta da tool
@author Bruno Costa
@since  10/08/2026
@version 1.0
/*/
//-------------------------------------------------------------------
method process(jPayLoad as json) as json class GetVacationRequest
local jResp as json
local aRequired as array
local cProperty as character
local cRestFault as character
local nI as numeric

jResp := JsonObject():new()

aRequired := { ;
    "idManager", ;
    "idEmployee", ;
    "initVacation", ;
    "endVacation", ;
    "initPeriod", ;
    "endPeriod", ;
    "christmasBonus", ;
    "days", ;
    "vacationBonus" ;
}

For nI := 1 To Len(aRequired)
    cProperty := aRequired[nI]
    If !jPayLoad:hasProperty(cProperty)
        jResp["ok"]      := .F.
        jResp["message"] := EncodeUTF8(STR0003) + cProperty
        Return jResp
    EndIf
Next nI

cRestFault := GPEM950(jPayLoad, .F.)

jResp["ok"]      := Empty(cRestFault)
jResp["message"] := If(!Empty(cRestFault), EncodeUTF8(cRestFault), EncodeUTF8(STR0004)) //"Solicitação de férias validada com sucesso."

return jResp
