Static Function When_NotEdit(oGrid)
Local lRet	:= .T.

If oGrid:GetLine() == 1 //.And. oGrid:GetValue("JS_TABELA") == "SRA" .And. oGrid:GetValue('JS_SEQ', nLinGrid) == "01" 
	lRet := .F.
EndIf
 
Return lRet
