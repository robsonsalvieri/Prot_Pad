Function GPEA062()

	Local oMBrowse
	Local cFiltraRh

//CHRIS
	oMBrowse := FWMBrowse():New()

	oMBrowse:SetAlias("SJQ")
	oMBrowse:SetDescription(OemToAnsi(STR0001)) //'Cadastro de Agrupamento de Benefícios'

	//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
	//³ Inicializa o filtro utilizando a funcao FilBrowse                      ³
	//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
	cFiltraRh := CHKRH("GPEA062","SJQ","1")
	oMBrowse:SetFilterDefault( cFiltraRh )

	If hasSmartX()
		oMBrowse:SetSmartX(1,.T.) // JQ_FILIAL + JQ_FILREF + JQ_PERINI — Fil. Ref. + Per. Inicial 
	Endif

	oMBrowse:Activate()

Return

