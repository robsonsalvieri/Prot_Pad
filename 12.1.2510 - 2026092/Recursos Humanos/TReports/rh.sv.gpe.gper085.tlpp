/*/{Protheus.doc} GPER085TReportsBusinessObject::getComboBox
    Retorna os valores de ComboBox do parâmetro requisitado.
    @type Method
    @version 12.1.2410
    @author caio.kretzer
    @since 30/09/2025
    @return Variant, Retorno nulo pré-fixado
    @obs Path parameters: param (nome do parâmetro solicitado)
/*/
Method getComboBox() As Variant Class GPER085TReportsBusinessObject
    // Declaração das variáveis locais
    Local jPath     As JSON    // Path parameters da requisição
    Local jResponse As JSON    // Resposta da requisição
    Local jItem     As JSON    // Item do valor do parâmetro
    Local nValues   As Numeric // Contador dos valores do parâmetro
    Local aValues   As Array   // Valores do parâmetro

    // Inicialização das variáveis
    jPath     := oRest:getPathParamsRequest()
    jResponse := JSONObject():New()
    jItem     := NIL
    nValues   := 0
    aValues   := {}

    // Captura os path parameters da requisição
    If (jPath != NIL)
        cParam := jPath["param"]
    EndIf

    // Cria o atributo data e nextPageUrl no JSON de resposta
    jResponse["data"]        := {}
    jResponse["nextPageUrl"] := NIL

    // Verifica qual parâmetro foi solicitado
    If (cParam == "PAR_TIPOREL")
        AAdd(aValues, FwHTTPEncode(STR0064)) // "Analítico"
        AAdd(aValues, FwHTTPEncode(STR0065)) // "Sintético"
    ElseIf (cParam == "PAR_LISTA")
        AAdd(aValues, FwHTTPEncode(STR0066)) // "Valores"
        AAdd(aValues, FwHTTPEncode(STR0067)) // "Horas"
    ElseIf (cParam == "PAR_ORIENT")
        AAdd(aValues, FwHTTPEncode(STR0068)) // "Vertical"
        AAdd(aValues, FwHTTPEncode(STR0069)) // "Horizontal"
    ElseIf (cParam == "PAR_GROUP")
        AAdd(aValues, FwHTTPEncode(STR0070)) // "Apenas Filial"
        AAdd(aValues, FwHTTPEncode(STR0071)) // "C. Custo"
        AAdd(aValues, FwHTTPEncode(STR0072)) // "Departamento"
        AAdd(aValues, FwHTTPEncode(STR0073)) // "C. Custo + Depto"
    EndIf

    If (Len(aValues) > 0)
        // Percorre os valores adicionando cada item no JSON de resposta
        For nValues := 1 To Len(aValues)
            jItem := {;
                "key":   CValToChar(nValues),;
                "label": aValues[nValues];
            }
            AAdd(jResponse["data"], jItem)
        Next nValues
    EndIf

    // Define a resposta da requisição
    oRest:setResponse(jResponse)
    oRest:setStatusCode(200)
    oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")
    oRest:setKeyHeaderResponse("Accept-Encoding", "UTF-8")

    // Libera os objetos da memória
    FwFreeObj(jPath)
    FwFreeObj(jResponse)
    FwFreeObj(jItem)
    FwFreeArray(aValues)
Return NIL

/*/{Protheus.doc} fQueryVisao
    Retorna os valores de ComboBox do parâmetro requisitado.
    @type Method
    @version 12.1.2410
    @author caio.kretzer
    @since 30/09/2025
    @return Variant, Retorno nulo pré-fixado
    @obs Path parameters: param (nome do parâmetro solicitado)
/*/
Static Function fQueryVisao(cCodVisao as Character, cDepVisao as Character)

	Local aChave	    := Array(2)
	Local cQuery 	    := ""
	Local cQryAlias	    := ""
    local nParamOrder   := 1

	cQuery := "SELECT RD4.RD4_CHAVE, RD4.RD4_FILIDE FROM " + RetSqlName("RD4") + " RD4 "
	cQuery += "INNER JOIN " + RetSqlName("RDK") + " RDK "
    cQuery += "  ON RDK.RDK_FILIAL  = RD4.RD4_FILIAL "
	cQuery += " AND RDK.RDK_CODIGO  = RD4.RD4_CODIGO "
	cQuery += " AND RDK.RDK_HIERAR  = ? "
	cQuery += " AND RDK.RDK_CODIGO  = ? "
    cQuery += " AND RDK.D_E_L_E_T_  = ? "
	cQuery += "WHERE RD4_CODIDE     = ? "
	cQuery += "AND RD4.D_E_L_E_T_   = ? "
    cQuery := ChangeQuery(cQuery)

    // Instancia a classe
    oStatement := FwExecStatement():New(cQuery)

    // Define o valor dos bind parameters
    oStatement:SetString(nParamOrder++, "1")                
    oStatement:SetString(nParamOrder++, cCodVisao)      
    oStatement:SetString(nParamOrder++, " ")     

    oStatement:SetString(nParamOrder++, cDepVisao)        
    oStatement:SetString(nParamOrder++, " ")      

    // Executa a query e retorna o alias criado
    cQryAlias := oStatement:OpenAlias()

	aChave := {(cQryAlias)->RD4_FILIDE, (cQryAlias)->RD4_CHAVE}

	(cQryAlias)->(DbCloseArea())

Return aChave
