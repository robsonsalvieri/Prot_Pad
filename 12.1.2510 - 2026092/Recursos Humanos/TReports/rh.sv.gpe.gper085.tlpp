#Include "totvs.framework.treports.integratedprovider.th"
#Include "tlpp-core.th"
#Include "tlpp-rest.th"
#Include "rh.sv.gpe.gper085.ch"

namespace totvs.protheus.rh.treportsintegratedprovider

/*/{Protheus.doc} GPER085TReportsBusinessObject:new()
    Classe do objeto de negócio do Relatório Valores por Verba no Período
    @type Class
    @version 12.1.2410
    @author caio.kretzer
    @since 24/09/2025
/*/
@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGAGPE", tables="SRA, SRC, SRD, SRJ, CTT", customTables="SRA, SRJ, CTT", name="Relatório Valores por Verba no Período", country="ALL", initialRelease="12.1.2310")
Class GPER085TReportsBusinessObject From totvs.framework.treports.integratedprovider.IntegratedProvider
    // Define os métodos da classe
    Public Method new()            As Object
    Public Method getDescription() As Character
    Public Method getData()        As Object
    Public Method getSchema()      As Object

    @Get("/api/rh/smartview/v1/options/GPER085/:param")
    Public Method getComboBox() As Variant
EndClass

/*/{Protheus.doc} GPER085TReportsBusinessObject:new()
    Instancia a classe do objeto de negócio.
    @type Method
    @version 12.1.2410
    @author caio.kretzer
    @since 24/09/2025
    @return Object, Instância do objeto de negócio
/*/
Method new() As Object Class GPER085TReportsBusinessObject
    // Chama o construtor da classe super
    _Super:new()

    // Define a Área
    self:appendArea(STR0001) // "RH"

    // Define o nome do objeto de negócio
    self:setDisplayName(STR0002) // "Valores por Verba no Período"

Return self

/*/{Protheus.doc} GPER085TReportsBusinessObject:getDescription()
    Retorna a descrição do objeto de negócio.
    @type Method
    @version 12.1.2410
    @author caio.kretzer
    @since 24/09/2025
    @return Character, Descrição do objeto de negócio
/*/
Method getDescription() As Character Class GPER085TReportsBusinessObject
Return STR0003 // "Este objeto de negócio traz as informações do Relatório de Valores por Verba no Período"

/*/{Protheus.doc} GPER085TReportsBusinessObject:getData()
    Captura os dados do objeto de negócio.
    @type Method
    @version 12.1.2410
    @author caio.kretzer
    @since 24/09/2025
    @return Object, Dados do objeto de negócio
/*/
Method getData(nPage As Numeric, oFilter As Object) As Object Class GPER085TReportsBusinessObject
    // Declaração das variáveis locais
    Local aOfusca               As Array     // Informações para ofuscar
    Local aFldRel               As Array     // Campos para validar acesso do usuário
    Local lBlqAcesso            As Logical   // Flag de acesso do usuário
    Local cQuery                As Character // Query do relatório
    Local cFilExec              As Character // Filial do usuário que está executando
    Local cEmpExec              As Character // Empresa do usuário que está executando
    Local cAlias                As Character // Alias do arquivo temporário
    Local JParams               As JSON      // Parâmetros do objeto de negócio
    Local cFilDe                As Character // Filial de
    Local cFilAte               As Character // Filial até
    Local cCCde                 As Character // Centro de custo de
    Local cCCAte                As Character // Centro de custo até
    Local cDeptoDe              As Character // Departamento de
    Local cDeptoAte             As Character // Departamento até
    Local cMatDe                As Character // Matrícula de
    Local cMatAte               As Character // Matrícula até
    Local cNomeDe               As Character // Nome de
    Local cNomeAte              As Character // Nome até
    Local aCategorias           As Array     // Categorias
    Local aSituacoes            As Array     // Situações
    Local cTipoRel              As Character // Tipo de relatório
    Local cRoteiro              As Character // Roteiro
    Local cProcesso             As Character // Processo
    Local cPeriodo              As Character // Período
    Local cNroPag               As Character // Período
    Local aVerbas               As Array     // Verbas
    Local cImpSalar             As Character // Imprime salário
    Local cImpTotEmp            As Character // Imprime total de empregados
    Local cImpTotLiq            As Character // Imprime total líquido
    Local cCodVisao             As Character // Código da visão
    Local cDepVisao             As Character // Departamento da visão
    Local cImpBases             As Character // Imprime bases
    Local cTipoLista            As Character // Tipo de lista
    Local cOrientacao           As Character // Orientação
    Local cAgrupament           As Character // Agrupamento
    Local oStatement            As Object    // Objeto usada para utilização da classe FwExecStatement
    Local nParamOrder           As Numeric   // Contador de parâmetros da query
    Local nX                    As Numeric   // Contador genérico

    Local cName                 As Character // Nome real do campo
    Local aPDFields             As Array     // Campos que podem ser exibidos de acordo com a LGPD
    Local aAllFields            As Array     // Estrutura de todos os campos do ON
    Local lObfuscated           As Logical   // Flag que indica se tem algum campo para ofuscar
    Local jData                 As JSON      // Informações a serem adicionadas no ON
    Local jLGPD                 As JSON      // Indica quais campos devem ser ofuscados
    Local nFields               As Numeric
    Local lUsaArqui             As Logical   // Se usa Arquitetura Organizadional (SIGAORG)
    Local cFilSRACTT            As Character
    Local cFilSRASQB            As Character
    Local cFilSRASRC            As Character
    Local cFilSRCSRV            As Character
    Local cFilSRASRD            As Character
    Local cFilSRDSRV            As Character
    Local lPrimeiraInt          As Logical   // Flag para identificar a primeira interação do loop principal
    Local cFilAnt               As Character // Filial anterior
    Local cPdAnt                As Character // Verba anterior
    Local cMatAnt               As Character // Matrícula anterior
    Local cGroup1Ant            As Character // Grupo 1 anterior
    Local cGroup2Ant            As Character // Grupo 2 anterior
    Local cGroup1               As Character // Grupo 1
    Local cGroup2               As Character // Grupo 2
    Local lAddReg               As Logical   // Flag para adicionar o registro no JSON
    Local aPdDesc               As Array     // Descrição das verbas
    Local jVA                   As JSON      // JSON Vertical Analítico
    Local jVS                   As JSON      // JSON Vertical Sintético
    Local jHA                   As JSON      // JSON Horizontal Analítico
    Local jHS                   As JSON      // JSON Horizontal Sintético

    // Inicialização das variáveis locais
    cQuery          := ""
    cFilExec        := AllTrim(FwFilialName())
    cEmpExec        := AllTrim(FwEmpName(cEmpAnt))
    cAlias          := ""
    
    aOfusca         := IIf(FindFunction("ChkOfusca"), ChkOfusca(), {.T., .F., {"", ""}})
    aFldRel         := {"RA_NOME", "RA_SALARIO"}
    lBlqAcesso      := aOfusca[2] .and. !Empty(FwProtectedDataUtil():UsrNoAccessFieldsInList(aFldRel))
    jParams         := oFilter:getParameters()
    cFilDe          := ""
    cFilAte         := ""
    cCCde           := ""
    cCCAte          := ""
    cDeptoDe        := ""
    cDeptoAte       := ""
    cMatDe          := ""
    cMatAte         := ""
    cNomeDe         := ""
    cNomeAte        := ""
    aCategorias     := {}
    aSituacoes      := {}
    cTipoRel        := ""
    cRoteiro        := ""
    cProcesso       := ""
    cPeriodo        := ""
    cNroPag         := ""
    aVerbas         := {}
    cImpSalar       := ""
    cImpTotEmp      := ""
    cImpTotLiq      := ""
    cCodVisao       := ""
    cDepVisao       := ""
    cImpBases       := ""
    cTipoLista      := ""
    cOrientacao     := ""
    cAgrupament     := ""
    oStatement      := NIL
    nParamOrder     := 1
    cName           := ""
    aPDFields       := {}
    aAllFields      := {}
    lObfuscated     := .F.
    jData           := NIL
    jLGPD           := JSONObject():New()
    lUsaArqui	    := Iif(SuperGetMv("MV_ORGCFG",.F.,"0")=="0",.F.,.T.)  // 0-Nao utiliza	1-Utiliza Postos e Deptos	2-Utiliza so Deptos.
    cFilSRACTT      := FwJoinFilial("SRA", "CTT")
    cFilSRASQB      := FwJoinFilial("SRA", "SQB")
    cFilSRASRC      := FwJoinFilial("SRA", "SRC")
    cFilSRCSRV      := FwJoinFilial("SRC", "SRV")
    cFilSRASRD      := FwJoinFilial("SRA", "SRD")
    cFilSRDSRV      := FwJoinFilial("SRD", "SRV")
    lPrimeiraInt    := .T.
    cFilAnt         := ""
    cPdAnt          := ""
    cMatAnt         := ""
    cGroup1Ant      := ""
    cGroup2Ant      := ""
    cGroup1         := ""
    cGroup2         := ""
    lAddReg         := .T.
    aPdDesc         := {}
    jVA             := JSONObject():New()
    jVS             := JSONObject():New()
    jHA             := JSONObject():New()
    jHS             := JSONObject():New()

	// Verifica se precisa fazer o tratamento para LGPD
    aPDFields   := FwProtectedDataUtil():UsrAccessPDField(__cUserID, self:getArrayFields())
    lObfuscated := Len(aPDFields) != Len(self:getArrayFields())
    aAllFields  := self:getStructFields()

    // Adiciona no JSON todos os campos como atributos e com o conteúdo sendo uma flag que indica se o campo deve ser ofuscado
    For nFields := 1 To Len(aAllFields)
        cName        := Trim(aAllFields[nFields]:getName())
        jLGPD[cName] := AScan(aPDFields, {|x| Trim(x) == cName}) <= 0
    Next nFields

    BEGIN SEQUENCE

        // Captura o valor dos parâmetros
        If (jParams != NIL)
            cFilDe      := IIf(jParams:hasProperty("PAR_FILIALDE")      .and. Len(jParams["PAR_FILIALDE"])  > 0 .and.!Empty(jParams["PAR_FILIALDE"][1]),    jParams["PAR_FILIALDE"][1],     "")
            cFilAte     := IIf(jParams:hasProperty("PAR_FILIALATE")     .and. Len(jParams["PAR_FILIALATE"]) > 0 .and.!Empty(jParams["PAR_FILIALATE"][1]),   jParams["PAR_FILIALATE"][1],    Replicate("Z", GetSX3Cache("RA_FILIAL", "X3_TAMANHO")))
            cCCde       := IIf(jParams:hasProperty("PAR_CCDE")          .and. Len(jParams["PAR_CCDE"])      > 0 .and.!Empty(jParams["PAR_CCDE"][1]),        jParams["PAR_CCDE"][1],         "")
            cCCAte      := IIf(jParams:hasProperty("PAR_CCATE")         .and. Len(jParams["PAR_CCATE"])     > 0 .and.!Empty(jParams["PAR_CCATE"][1]),       jParams["PAR_CCATE"][1],        Replicate("Z", GetSX3Cache("RA_CC", "X3_TAMANHO")))
            cDeptoDe    := IIf(jParams:hasProperty("PAR_DEPTODE")       .and. Len(jParams["PAR_DEPTODE"])   > 0 .and.!Empty(jParams["PAR_DEPTODE"][1]),     jParams["PAR_DEPTODE"][1],      "")
            cDeptoAte   := IIf(jParams:hasProperty("PAR_DEPTOATE")      .and. Len(jParams["PAR_DEPTOATE"])  > 0 .and.!Empty(jParams["PAR_DEPTOATE"][1]),    jParams["PAR_DEPTOATE"][1],     Replicate("Z", GetSX3Cache("RA_DEPTO", "X3_TAMANHO")))
            cMatDe      := IIf(jParams:hasProperty("PAR_MATDE")         .and. Len(jParams["PAR_MATDE"])     > 0 .and.!Empty(jParams["PAR_MATDE"][1]),       jParams["PAR_MATDE"][1],        "")
            cMatAte     := IIf(jParams:hasProperty("PAR_MATATE")        .and. Len(jParams["PAR_MATATE"])    > 0 .and.!Empty(jParams["PAR_MATATE"][1]),      jParams["PAR_MATATE"][1],       Replicate("Z", GetSX3Cache("RA_MAT", "X3_TAMANHO")))
            cNomeDe     := IIf(jParams:hasProperty("PAR_NOMEDE")        .and. Len(jParams["PAR_NOMEDE"])    > 0 .and.!Empty(jParams["PAR_NOMEDE"][1]),      jParams["PAR_NOMEDE"][1],       "")
            cNomeAte    := IIf(jParams:hasProperty("PAR_NOMEATE")       .and. Len(jParams["PAR_NOMEATE"])   > 0 .and.!Empty(jParams["PAR_NOMEATE"][1]),     jParams["PAR_NOMEATE"][1],      Replicate("Z", GetSX3Cache("RA_NOME", "X3_TAMANHO")))
            aSituacoes  := IIf(jParams:hasProperty("PAR_SIT"),          jParams["PAR_SIT"], {})
            aCategorias := IIf(jParams:hasProperty("PAR_CAT"),          jParams["PAR_CAT"], {})
            cRoteiro    := IIf(jParams:hasProperty("PAR_ROTEIRO")       .and. Len(jParams["PAR_ROTEIRO"])   > 0 .and.!Empty(jParams["PAR_ROTEIRO"][1]),     jParams["PAR_ROTEIRO"][1],      "")
            cProcesso   := IIf(jParams:hasProperty("PAR_PROCESSO")      .and. Len(jParams["PAR_PROCESSO"])  > 0 .and.!Empty(jParams["PAR_PROCESSO"][1]),    jParams["PAR_PROCESSO"][1],     "")
            cPeriodo    := IIf(jParams:hasProperty("PAR_PERIODO")       .and. Len(jParams["PAR_PERIODO"])   > 0 .and.!Empty(jParams["PAR_PERIODO"][1]),     jParams["PAR_PERIODO"][1],      "")
            cNroPag     := IIf(jParams:hasProperty("PAR_NROPAG")        .and. Len(jParams["PAR_NROPAG"])    > 0 .and.!Empty(jParams["PAR_NROPAG"][1]),      jParams["PAR_NROPAG"][1],       "1") // 1- Todas as páginas 2- Primeira página 3- Última página
            aVerbas     := IIf(jParams:hasProperty("PAR_VERBAS"),       jParams["PAR_VERBAS"], {}) // Array de verbas para filtro
            cImpSalar   := IIf(jParams:hasProperty("PAR_SALARIO")       .and. Len(jParams["PAR_SALARIO"])   > 0 .and.!Empty(jParams["PAR_SALARIO"][1]),     jParams["PAR_SALARIO"][1],      "1")
            cImpTotEmp  := IIf(jParams:hasProperty("PAR_TOTALEMP")      .and. Len(jParams["PAR_TOTALEMP"])  > 0 .and.!Empty(jParams["PAR_TOTALEMP"][1]),    jParams["PAR_TOTALEMP"][1],     "1")
            cImpTotLiq  := IIf(jParams:hasProperty("PAR_TOTALLIQ")      .and. Len(jParams["PAR_TOTALLIQ"])  > 0 .and.!Empty(jParams["PAR_TOTALLIQ"][1]),    jParams["PAR_TOTALLIQ"][1],     "1")
            cCodVisao   := IIf(jParams:hasProperty("PAR_CODVISAO")      .and. Len(jParams["PAR_CODVISAO"])  > 0 .and.!Empty(jParams["PAR_CODVISAO"][1]),    jParams["PAR_CODVISAO"][1],     "")
            cDepVisao   := IIf(jParams:hasProperty("PAR_DEPVISAO")      .and. Len(jParams["PAR_DEPVISAO"])  > 0 .and.!Empty(jParams["PAR_DEPVISAO"][1]),    jParams["PAR_DEPVISAO"][1],     "")
            cImpBases   := IIf(jParams:hasProperty("PAR_IMPBASES")      .and. Len(jParams["PAR_IMPBASES"])  > 0 .and.!Empty(jParams["PAR_IMPBASES"][1]),    jParams["PAR_IMPBASES"][1],     "1")
            cTipoLista  := IIf(jParams:hasProperty("PAR_LISTA")         .and. Len(jParams["PAR_LISTA"])     > 0 .and.!Empty(jParams["PAR_LISTA"][1]),       jParams["PAR_LISTA"][1],        "1")
            cTipoRel    := IIf(jParams:hasProperty("PAR_TIPOREL")       .and. Len(jParams["PAR_TIPOREL"])   > 0 .and.!Empty(jParams["PAR_TIPOREL"][1]),     jParams["PAR_TIPOREL"][1],      "")
            cOrientacao := IIf(jParams:hasProperty("PAR_ORIENT")        .and. Len(jParams["PAR_ORIENT"])    > 0 .and.!Empty(jParams["PAR_ORIENT"][1]),      jParams["PAR_ORIENT"][1],       "1")
            cAgrupament := IIf(jParams:hasProperty("PAR_GROUP")         .and. Len(jParams["PAR_GROUP"])     > 0 .and.!Empty(jParams["PAR_GROUP"][1]),       jParams["PAR_GROUP"][1],        "1")
        EndIf

        // Verifica se o intervalo de período e semana foi preenchido
        If (Empty(cPeriodo) .or. Empty(cNroPag))
            self:setErrorStatus(400, STR0004, STR0005) // "Atenção" | "O Período e Nro de Pagamento devem estar preenchidos."
            FwLogMsg("WARN", NIL, "SmartView", NIL, NIL, NIL, STR0005)
            BREAK
        EndIf

        If cOrientacao == "2" .AND. Len(aVerbas) == 0 .OR. (Len(aVerbas) > 9 .AND. cImpTotLiq == "1") .OR. (Len(aVerbas) > 10 .AND. cImpTotLiq == "2") // Se for orientação horizontal, escolher no maximo X verbas
            self:setErrorStatus(400, STR0004, STR0006) // "Acesso Restrito" | "Se for orientação horizontal, escolher no maximo X verbas"
            FwLogMsg("WARN", NIL, "SmartView", NIL, NIL, NIL, STR0006)
            BREAK
        EndIf

        // Tratamento de acesso a dados sensíveis
        If (lBlqAcesso)
            self:setErrorStatus(400, STR0004, STR0007) // "Acesso Restrito" | "Este usuário não possui permissão de acesso aos dados desta rotina!"
            FwLogMsg("WARN", NIL, "SmartView", NIL, NIL, NIL, STR0007)
            BREAK
        EndIf

        // Montagem da query de busca
        cQuery += "SELECT "
        cQuery +=     "SRA.RA_FILIAL, "
        cQuery +=     "SRA.RA_MAT, "
        cQuery +=     "SRA.RA_NOME, "
        cQuery +=     "SRA.RA_SALARIO, "
        cQuery +=     "SRA.RA_HRSMES, "
        cQuery +=     "SRA.RA_CC, "
        cQuery +=     "CTT.CTT_DESC01, "
        cQuery +=     "SRA.RA_DEPTO, "
        cQuery +=     "SQB.QB_DESCRIC, "
        cQuery +=     "SRV.RV_COD, "
        cQuery +=     "SRV.RV_DESC DESCPD, "
        cQuery +=     "SRV.RV_TIPOCOD TIPOCOD, "
        cQuery +=     "SRV.RV_TIPO TIPOPD, "
        cQuery +=     "SRC.RC_HORAS HORAS, "
        cQuery +=     "SRC.RC_VALOR VALOR "
        cQuery += "FROM "
        cQuery +=     RetSQLName("SRA") + " SRA "
        cQuery +=     "LEFT JOIN "
        cQuery +=         RetSQLName("SQB") + " SQB "
        cQuery +=         "ON "
        cQuery +=             "" + cFilSRASQB + " "
        cQuery +=             "AND SQB.QB_DEPTO    = SRA.RA_DEPTO "
        cQuery +=             "AND SQB.D_E_L_E_T_   = ? "
        cQuery +=     "INNER JOIN "
        cQuery +=         RetSQLName("CTT") + " CTT "
        cQuery +=         "ON "
        cQuery +=             "" + cFilSRACTT + " "
        cQuery +=             "AND CTT.CTT_CUSTO    = SRA.RA_CC "
        cQuery +=             "AND CTT.D_E_L_E_T_   = ? "
        cQuery +=     "INNER JOIN "
        cQuery +=         RetSQLName("SRC") + " SRC "
        cQuery +=         "ON "
        cQuery +=             "" + cFilSRASRC + " "
        cQuery +=             "AND SRC.RC_MAT       = SRA.RA_MAT "
        cQuery +=             "AND SRC.RC_PERIODO   = ? "
        cQuery +=             "AND SRC.RC_ROTEIR    = ? "
        cQuery +=             "AND SRC.RC_SEMANA    = ? "
        cQuery +=             "AND SRC.D_E_L_E_T_   = ? "
        cQuery +=     "INNER JOIN "
        cQuery +=         RetSQLName("SRV") + " SRV "
        cQuery +=         "ON "
        cQuery +=             "" + cFilSRCSRV + " "
        cQuery +=             "AND SRV.RV_COD       = SRC.RC_PD "
        If cImpBases == "2"
            cQuery +=         "AND SRV.RV_TIPOCOD   IN (?, ?) "
        Endif
        cQuery +=             "AND SRV.D_E_L_E_T_   = ? "
        
        If lUsaArqui .AND. (!Empty(cCodVisao) .OR. !Empty(cDepVisao))
            aChaveArq	:= fQueryVisao(cCodVisao, cDepVisao)
            cChaveArq	:= aChaveArq[2]

            cQuery	+= " INNER JOIN (SELECT RD4.RD4_FILIDE, RD4.RD4_CODIDE, RD4.RD4_CHAVE "
            cQuery	+= " FROM " + RetSqlName("RD4") + " RD4 "
            cQuery	+= " WHERE RD4_CHAVE LIKE '?%' AND RD4.D_E_L_E_T_ = ? ) TVRD4 "
            cQuery	+= " ON TVRD4.RD4_CODIDE = SRA.RA_DEPTO "
            If !Empty(aChaveArq[1])
                cQuery+= " AND TVRD4.RD4_FILIDE = SRA.RA_FILIAL "
            EndIf
        EndIf

        cQuery += "WHERE "
        cQuery +=     "SRA.RA_FILIAL     BETWEEN ? AND ? "             
        cQuery +=     "AND SRA.RA_MAT    BETWEEN ? AND ? " 
        cQuery +=     "AND SRA.RA_NOME   BETWEEN ? AND ? " 
        cQuery +=     "AND SRA.RA_CC     BETWEEN ? AND ? " 
        cQuery +=     "AND SRA.RA_DEPTO  BETWEEN ? AND ? " 
        cQuery +=     "AND SRA.RA_PROCES = ? "                                      
        cQuery +=     IIf(Len(aCategorias) > 0, " AND SRA.RA_CATFUNC IN (?) ", " ") 
        cQuery +=     IIf(Len(aSituacoes) > 0,  " AND SRA.RA_SITFOLH IN (?) ", " ") 
        cQuery +=     IIf(Len(aVerbas) > 0,  "    AND SRV.RV_COD IN (?) ", " ") 
        cQuery +=     "AND SRA.D_E_L_E_T_ = ? "

        cQuery += "UNION "
        
        cQuery += "SELECT "
        cQuery +=     "SRA.RA_FILIAL, "
        cQuery +=     "SRA.RA_MAT, "
        cQuery +=     "SRA.RA_NOME, "
        cQuery +=     "SRA.RA_SALARIO, "
        cQuery +=     "SRA.RA_HRSMES, "
        cQuery +=     "SRA.RA_CC, "
        cQuery +=     "CTT.CTT_DESC01, "
        cQuery +=     "SRA.RA_DEPTO, "
        cQuery +=     "SQB.QB_DESCRIC, "
        cQuery +=     "SRV.RV_COD, "
        cQuery +=     "SRV.RV_DESC DESCPD, "
        cQuery +=     "SRV.RV_TIPOCOD TIPOCOD, "
        cQuery +=     "SRV.RV_TIPO TIPOPD, "
        cQuery +=     "SRD.RD_HORAS HORAS, "
        cQuery +=     "SRD.RD_VALOR VALOR "
        cQuery += "FROM "
        cQuery +=     RetSQLName("SRA") + " SRA "
        cQuery +=     "LEFT JOIN "
        cQuery +=         RetSQLName("SQB") + " SQB "
        cQuery +=         "ON "
        cQuery +=             "" + cFilSRASQB + " "
        cQuery +=             "AND SQB.QB_DEPTO    = SRA.RA_DEPTO "
        cQuery +=             "AND SQB.D_E_L_E_T_   = ? "
        cQuery +=     "INNER JOIN "
        cQuery +=         RetSQLName("CTT") + " CTT "
        cQuery +=         "ON "
        cQuery +=             "" + cFilSRACTT + " "
        cQuery +=             "AND CTT.CTT_CUSTO    = SRA.RA_CC "
        cQuery +=             "AND CTT.D_E_L_E_T_   = ? "
        cQuery +=     "INNER JOIN "
        cQuery +=         RetSQLName("SRD") + " SRD "
        cQuery +=         "ON "
        cQuery +=             "" + cFilSRASRD + " "
        cQuery +=             "AND SRD.RD_MAT       = SRA.RA_MAT "
        cQuery +=             "AND SRD.RD_PERIODO   = ? "
        cQuery +=             "AND SRD.RD_ROTEIR    = ? "
        cQuery +=             "AND SRD.RD_SEMANA    = ? "
        cQuery +=             "AND SRD.D_E_L_E_T_   = ? "
        cQuery +=     "INNER JOIN "
        cQuery +=         RetSQLName("SRV") + " SRV "
        cQuery +=         "ON "
        cQuery +=             "" + cFilSRDSRV + " "
        cQuery +=             "AND SRV.RV_COD       = SRD.RD_PD "
        If cImpBases == "2"
            cQuery +=         "AND SRV.RV_TIPOCOD   IN (?, ?) "
        Endif
        cQuery +=             "AND SRV.D_E_L_E_T_   = ? "
        
        If lUsaArqui .AND. (!Empty(cCodVisao) .OR. !Empty(cDepVisao))
            aChaveArq	:= fQueryVisao(cCodVisao, cDepVisao)
            cChaveArq	:= aChaveArq[2]

            cQuery	+= " INNER JOIN (SELECT RD4.RD4_FILIDE, RD4.RD4_CODIDE, RD4.RD4_CHAVE "
            cQuery	+= " FROM " + RetSqlName("RD4") + " RD4 "
            cQuery	+= " WHERE RD4_CHAVE LIKE '?%' AND RD4.D_E_L_E_T_ = ? ) TVRD4 "
            cQuery	+= " ON TVRD4.RD4_CODIDE = SRA.RA_DEPTO "
            If !Empty(aChaveArq[1])
                cQuery+= " AND TVRD4.RD4_FILIDE = SRA.RA_FILIAL "
            EndIf
        EndIf

        cQuery += "WHERE "
        cQuery +=     "SRA.RA_FILIAL     BETWEEN ? AND ? "             
        cQuery +=     "AND SRA.RA_MAT    BETWEEN ? AND ? " 
        cQuery +=     "AND SRA.RA_NOME   BETWEEN ? AND ? " 
        cQuery +=     "AND SRA.RA_CC     BETWEEN ? AND ? " 
        cQuery +=     "AND SRA.RA_DEPTO  BETWEEN ? AND ? " 
        cQuery +=     "AND SRA.RA_PROCES = ? "                                      
        cQuery +=     IIf(Len(aCategorias) > 0, " AND SRA.RA_CATFUNC IN (?) ", " ") 
        cQuery +=     IIf(Len(aSituacoes) > 0,  " AND SRA.RA_SITFOLH IN (?) ", " ") 
        cQuery +=     IIf(Len(aVerbas) > 0,  "    AND SRV.RV_COD IN (?) ", " ") 
        cQuery +=     "AND SRA.D_E_L_E_T_ = ? "
        If cAgrupament == "1"
            cQuery +=     "ORDER BY SRA.RA_FILIAL, SRA.RA_MAT, SRV.RV_COD "
        ElseIf cAgrupament == "2"
            cQuery +=     "ORDER BY SRA.RA_FILIAL, SRA.RA_CC, SRA.RA_MAT, SRV.RV_COD "
        ElseIf cAgrupament == "3"
            cQuery +=     "ORDER BY SRA.RA_FILIAL, SRA.RA_DEPTO, SRA.RA_MAT, SRV.RV_COD "
        ElseIf cAgrupament == "4"
            cQuery +=     "ORDER BY SRA.RA_FILIAL, SRA.RA_CC, SRA.RA_DEPTO, SRA.RA_MAT, SRV.RV_COD "
        EndIf
        cQuery := ChangeQuery(cQuery)

        // Instancia a classe
        oStatement := FwExecStatement():New(cQuery)

        // Define o valor dos bind parameters
        oStatement:SetString(nParamOrder++, " ")
        oStatement:SetString(nParamOrder++, " ")
        oStatement:SetString(nParamOrder++, cPeriodo)
        oStatement:SetString(nParamOrder++, cRoteiro)
        oStatement:SetString(nParamOrder++, cNroPag)
        oStatement:SetString(nParamOrder++, " ")
        If cImpBases == "2"
            oStatement:SetString(nParamOrder++, "1")
            oStatement:SetString(nParamOrder++, "2")
        Endif
        oStatement:SetString(nParamOrder++, " ")
        If lUsaArqui .AND. (!Empty(cCodVisao) .OR. !Empty(cDepVisao))
            oStatement:SetUnsafe(nParamOrder++, AllTrim(cChaveArq))            
            oStatement:SetString(nParamOrder++, " ")      
        Endif
        oStatement:SetString(nParamOrder++, cFilDe)           
        oStatement:SetString(nParamOrder++, cFilAte)           
        oStatement:SetString(nParamOrder++, cMatDe)         
        oStatement:SetString(nParamOrder++, cMatAte)        
        oStatement:SetString(nParamOrder++, cNomeDe)        
        oStatement:SetString(nParamOrder++, cNomeAte)       
        oStatement:SetString(nParamOrder++, cCCDe)          
        oStatement:SetString(nParamOrder++, cCCAte)         
        oStatement:SetString(nParamOrder++, cDeptoDe)       
        oStatement:SetString(nParamOrder++, cDeptoAte)      
        oStatement:SetString(nParamOrder++, cProcesso)      

        If (Len(aCategorias) > 0)
            oStatement:SetIn(nParamOrder++, aCategorias) 
        EndIf

        If (Len(aSituacoes) > 0)
            oStatement:SetIn(nParamOrder++, aSituacoes) 
        EndIf

        If (Len(aVerbas) > 0)
            oStatement:SetIn(nParamOrder++, aVerbas) 
        EndIf
        oStatement:SetString(nParamOrder++, " ")            
        // Fim do primeiro select

        // Início do segundo select
        oStatement:SetString(nParamOrder++, " ")
        oStatement:SetString(nParamOrder++, " ")
        oStatement:SetString(nParamOrder++, cPeriodo)
        oStatement:SetString(nParamOrder++, cRoteiro)
        oStatement:SetString(nParamOrder++, cNroPag)
        oStatement:SetString(nParamOrder++, " ")
        If cImpBases == "2"
            oStatement:SetString(nParamOrder++, "1") 
            oStatement:SetString(nParamOrder++, "2") 
        Endif  
        oStatement:SetString(nParamOrder++, " ")            
        If lUsaArqui .AND. (!Empty(cCodVisao) .OR. !Empty(cDepVisao))
            oStatement:SetUnsafe(nParamOrder++, AllTrim(cChaveArq))            
            oStatement:SetString(nParamOrder++, " ")      
        Endif  
        oStatement:SetString(nParamOrder++, cFilDe)           
        oStatement:SetString(nParamOrder++, cFilAte)           
        oStatement:SetString(nParamOrder++, cMatDe)         
        oStatement:SetString(nParamOrder++, cMatAte)        
        oStatement:SetString(nParamOrder++, cNomeDe)        
        oStatement:SetString(nParamOrder++, cNomeAte)       
        oStatement:SetString(nParamOrder++, cCCDe)          
        oStatement:SetString(nParamOrder++, cCCAte)         
        oStatement:SetString(nParamOrder++, cDeptoDe)       
        oStatement:SetString(nParamOrder++, cDeptoAte)
        oStatement:SetString(nParamOrder++, cProcesso)

        If (Len(aCategorias) > 0)
            oStatement:SetIn(nParamOrder++, aCategorias)
        EndIf

        If (Len(aSituacoes) > 0)
            oStatement:SetIn(nParamOrder++, aSituacoes)
        EndIf

        If (Len(aVerbas) > 0)
            oStatement:SetIn(nParamOrder++, aVerbas)
        EndIf
        oStatement:SetString(nParamOrder++, " ")
        // Fim do segundo where

        // Executa a query e retorna o alias criado
        cAlias := oStatement:OpenAlias()

        jData := JSONObject():New()
        jData["FilialExec"]     := Trim(cFilExec)
        jData["EmpresaExec"]    := Trim(cEmpExec)
        jData["VertAnalitico"]  := {}
        jData["VertSintetico"]  := {}
        jData["HorizAnalitico"] := {}
        jData["HorizSintetico"] := {}

        If cOrientacao == "2"
            aPdDesc := {}
            For nX := 1 To Len(aVerbas)
                aAdd(aPdDesc, SubStr(aVerbas[nX] + " - " + DescPd(aVerbas[nX],xFilial("SRA")),1,11))
            Next nX
            
            For nX := Len(aVerbas)+1 To 10
                aAdd(aPdDesc, "")
            Next nX
            
            If cImpTotLiq == "1"
                aPdDesc[10] := STR0009
            Endif
        Endif

        While (!(cAlias)->(EOF()))

            lAddReg := .T.

            If cAgrupament == '1'
                cGroup1 := ""
                cGroup2 := ""
            ElseIf cAgrupament == '2'
                cGroup1 := (cAlias)->RA_CC
                cGroup2 := ""
            ElseIf cAgrupament == '3'
                cGroup1 := (cAlias)->RA_DEPTO
                cGroup2 := ""
            ElseIf cAgrupament == '4'
                cGroup1 := (cAlias)->RA_CC
                cGroup2 := (cAlias)->RA_DEPTO
            Endif

            If cTipoRel == "1" .AND. cOrientacao == "1" // Analítico Vertical

                jVA := JSONObject():New()
                jVA["BranchCodeVA"]         := (cAlias)->RA_FILIAL
                jVA["EmployeeCodeVA"]       := Iif(jLGPD["RA_MAT"], FwProtectedDataUtil():ValueAsteriskToAnonymize((cAlias)->RA_MAT), (cAlias)->RA_MAT)
                jVA["EmployeeNameVA"]       := Iif(jLGPD["RA_NOME"], FwProtectedDataUtil():ValueAsteriskToAnonymize((cAlias)->RA_NOME), (cAlias)->RA_NOME)
                jVA["DepartmentCodeVA"]     := AllTrim((cAlias)->RA_DEPTO)
                jVA["DepartmentNameVA"]     := AllTrim((cAlias)->QB_DESCRIC)
                jVA["CostCenterCodeVA"]     := AllTrim((cAlias)->RA_CC)
                jVA["CostCenterNameVA"]     := AllTrim((cAlias)->CTT_DESC01)
                jVA["EmployeeSalaryVA"]     := (cAlias)->RA_SALARIO
                jVA["EmployeeWorkloadVA"]   := (cAlias)->RA_HRSMES
                jVA["VerbaVA"]              := (cAlias)->RV_COD
                jVA["VerbaDescriptionVA"]   := (cAlias)->DESCPD
                jVA["HoursValueVA"]         := Iif((cAlias)->TIPOPD == "H",(cAlias)->HORAS,0)
                jVA["DaysValueVA"]          := Iif((cAlias)->TIPOPD == "D",(cAlias)->HORAS,0)
                jVA["ReferenceValueVA"]     := Iif((cAlias)->TIPOPD != "D" .AND. (cAlias)->TIPOPD != "D",(cAlias)->HORAS,0)
                jVA["EarningsVA"]           := IIf((cAlias)->TIPOCOD == "1", (cAlias)->VALOR, 0)
                jVA["DiscountVA"]           := IIf((cAlias)->TIPOCOD == "2", (cAlias)->VALOR, 0)
                jVA["Group01VA"]            := AllTrim(cGroup1)
                jVA["Group02VA"]            := AllTrim(cGroup2)

                aAdd(jData["VertAnalitico"], jVA)

            ElseIf cTipoRel == "2" .AND. cOrientacao == "1" // Sintético Vertical

                If lPrimeiraInt .OR. cFilAnt != (cAlias)->RA_FILIAL .OR. cPdAnt != (cAlias)->RV_COD;
                    .OR. cGroup1Ant != cGroup1 .OR. cGroup2Ant != cGroup2

                    If !lPrimeiraInt
                        aAdd(jData["VertSintetico"], jVS)
                    Endif

                    lPrimeiraInt := .F.

                    cFilAnt     := (cAlias)->RA_FILIAL
                    cPdAnt      := (cAlias)->RV_COD
                    cGroup1Ant  := cGroup1
                    cGroup2Ant  := cGroup2

                    jVS := JSONObject():New()
                    jVS["BranchCodeVS"]         := (cAlias)->RA_FILIAL
                    jVS["VerbaVS"]              := (cAlias)->RV_COD
                    jVS["VerbaDescriptionVS"]   := (cAlias)->DESCPD
                    jVS["Group01VS"]            := AllTrim(cGroup1)
                    jVS["Group02VS"]            := AllTrim(cGroup2)
                    jVS["HoursValueVS"]         := Iif((cAlias)->TIPOPD == "H",(cAlias)->HORAS,0)
                    jVS["DaysValueVS"]          := Iif((cAlias)->TIPOPD == "D",(cAlias)->HORAS,0)
                    jVS["ReferenceValueVS"]     := Iif((cAlias)->TIPOPD != "D" .AND. (cAlias)->TIPOPD != "D",(cAlias)->HORAS,0)
                    jVS["EarningsVS"]           := IIf((cAlias)->TIPOCOD == "1", (cAlias)->VALOR, 0)
                    jVS["DiscountVS"]           := IIf((cAlias)->TIPOCOD == "2", (cAlias)->VALOR, 0)
                Else
                    jVS["HoursValueVS"]         += Iif((cAlias)->TIPOPD == "H",(cAlias)->HORAS,0)
                    jVS["DaysValueVS"]          += Iif((cAlias)->TIPOPD == "D",(cAlias)->HORAS,0)
                    jVS["ReferenceValueVS"]     += Iif((cAlias)->TIPOPD != "D" .AND. (cAlias)->TIPOPD != "D",(cAlias)->HORAS,0)
                    jVS["EarningsVS"]           += IIf((cAlias)->TIPOCOD == "1", (cAlias)->VALOR, 0)
                    jVS["DiscountVS"]           += IIf((cAlias)->TIPOCOD == "2", (cAlias)->VALOR, 0)
                Endif

            ElseIf cTipoRel == "1" .AND. cOrientacao == "2" // Analítico Horizontal

                If lPrimeiraInt .OR. cFilAnt != (cAlias)->RA_FILIAL .OR. cMatAnt != (cAlias)->RA_MAT;
                    .OR. cGroup1Ant != cGroup1 .OR. cGroup2Ant != cGroup2
                    
                    cFilAnt     := (cAlias)->RA_FILIAL
                    cMatAnt     := (cAlias)->RA_MAT
                    cGroup1Ant  := cGroup1
                    cGroup2Ant  := cGroup2

                    If !lPrimeiraInt
                        aAdd(jData["HorizAnalitico"], jHA)
                    Endif

                    lPrimeiraInt := .F.

                    jHA := JSONObject():New()
                    jHA["BranchCodeHA"]     := (cAlias)->RA_FILIAL
                    jHA["EmployeeCodeHA"]   := Iif(jLGPD["RA_MAT"], FwProtectedDataUtil():ValueAsteriskToAnonymize((cAlias)->RA_MAT), (cAlias)->RA_MAT)
                    jHA["EmployeeNameHA"]   := Iif(jLGPD["RA_NOME"], FwProtectedDataUtil():ValueAsteriskToAnonymize((cAlias)->RA_NOME), (cAlias)->RA_NOME)
                    jHA["Group01HA"]        := AllTrim(cGroup1)
                    jHA["Group02HA"]        := AllTrim(cGroup2)
                    jHA["PD01DescHA"]       := aPdDesc[1]
                    jHA["PD02DescHA"]       := aPdDesc[2]
                    jHA["PD03DescHA"]       := aPdDesc[3]
                    jHA["PD04DescHA"]       := aPdDesc[4]
                    jHA["PD05DescHA"]       := aPdDesc[5]
                    jHA["PD06DescHA"]       := aPdDesc[6]
                    jHA["PD07DescHA"]       := aPdDesc[7]
                    jHA["PD08DescHA"]       := aPdDesc[8]
                    jHA["PD09DescHA"]       := aPdDesc[9]
                    jHA["PD10DescHA"]       := aPdDesc[10]
                    jHA["PD01HA"]           := 0
                    jHA["PD02HA"]           := 0
                    jHA["PD03HA"]           := 0
                    jHA["PD04HA"]           := 0
                    jHA["PD05HA"]           := 0
                    jHA["PD06HA"]           := 0
                    jHA["PD07HA"]           := 0
                    jHA["PD08HA"]           := 0
                    jHA["PD09HA"]           := 0
                    jHA["PD10HA"]           := 0

                    nPos := aScan( aVerbas , { |x| x == (cAlias)->RV_COD } )
                    If nPos > 0
                        jHA["PD" + StrZero(nPos,2) + "HA"] := Iif(cTipoLista=="1",(cAlias)->VALOR,(cAlias)->HORAS)
                        If cImpTotLiq == "1"
                            If (cAlias)->TIPOCOD == "1"
                                jHA["PD10HA"] += Iif(cTipoLista=="1",(cAlias)->VALOR,(cAlias)->HORAS)
                            ElseIf (cAlias)->TIPOCOD == "2"
                                jHA["PD10HA"] -= Iif(cTipoLista=="1",(cAlias)->VALOR,(cAlias)->HORAS)
                            Endif
                        Endif
                    Endif
                Else
                    nPos := aScan( aVerbas , { |x| x == (cAlias)->RV_COD } )
                    If nPos > 0
                        jHA["PD" + StrZero(nPos,2) + "HA"] += Iif(cTipoLista=="1",(cAlias)->VALOR,(cAlias)->HORAS)
                        If cImpTotLiq == "1"
                            If (cAlias)->TIPOCOD == "1"
                                jHA["PD10HA"] += Iif(cTipoLista=="1",(cAlias)->VALOR,(cAlias)->HORAS)
                            ElseIf (cAlias)->TIPOCOD == "2"
                                jHA["PD10HA"] -= Iif(cTipoLista=="1",(cAlias)->VALOR,(cAlias)->HORAS)
                            Endif
                        Endif
                    Endif
                Endif
            Else // Sintético Horizontal

                If lPrimeiraInt .OR. cFilAnt != (cAlias)->RA_FILIAL;
                    .OR. cGroup1Ant != cGroup1 .OR. cGroup2Ant != cGroup2

                    If !lPrimeiraInt
                        aAdd(jData["HorizSintetico"], jHS)
                    Endif

                    lPrimeiraInt := .F.

                    cFilAnt := (cAlias)->RA_FILIAL
                    cGroup1Ant  := cGroup1
                    cGroup2Ant  := cGroup2

                    jHS := JSONObject():New()
                    jHS["BranchCodeHS"]  := (cAlias)->RA_FILIAL
                    jHS["Group01HS"]     := AllTrim(cGroup1)
                    jHS["Group02HS"]     := AllTrim(cGroup2)
                    jHS["PD01DescHS"]    := aPdDesc[1]
                    jHS["PD02DescHS"]    := aPdDesc[2]
                    jHS["PD03DescHS"]    := aPdDesc[3]
                    jHS["PD04DescHS"]    := aPdDesc[4]
                    jHS["PD05DescHS"]    := aPdDesc[5]
                    jHS["PD06DescHS"]    := aPdDesc[6]
                    jHS["PD07DescHS"]    := aPdDesc[7]
                    jHS["PD08DescHS"]    := aPdDesc[8]
                    jHS["PD09DescHS"]    := aPdDesc[9]
                    jHS["PD10DescHS"]    := aPdDesc[10]
                    jHS["PD01HS"]        := 0
                    jHS["PD02HS"]        := 0
                    jHS["PD03HS"]        := 0
                    jHS["PD04HS"]        := 0
                    jHS["PD05HS"]        := 0
                    jHS["PD06HS"]        := 0
                    jHS["PD07HS"]        := 0
                    jHS["PD08HS"]        := 0
                    jHS["PD09HS"]        := 0
                    jHS["PD10HS"]        := 0

                    nPos := aScan( aVerbas , { |x| x == (cAlias)->RV_COD } )
                    If nPos > 0
                        jHS["PD" + StrZero(nPos,2) + "HS"] := Iif(cTipoLista=="1",(cAlias)->VALOR,(cAlias)->HORAS)
                        
                        If cImpTotLiq == "1"
                            If (cAlias)->TIPOCOD == "1"
                                jHS["PD10HS"] += Iif(cTipoLista=="1",(cAlias)->VALOR,(cAlias)->HORAS)
                            ElseIf (cAlias)->TIPOCOD == "2"
                                jHS["PD10HS"] -= Iif(cTipoLista=="1",(cAlias)->VALOR,(cAlias)->HORAS)
                            Endif
                        Endif
                    Endif
                    
                Else
                    nPos := aScan( aVerbas , { |x| x == (cAlias)->RV_COD } )
                    If nPos > 0
                        jHS["PD" + StrZero(nPos,2) + "HS"] += Iif(cTipoLista=="1",(cAlias)->VALOR,(cAlias)->HORAS)
                        If cImpTotLiq == "1"
                             If (cAlias)->TIPOCOD == "1"
                                jHS["PD10HS"] += Iif(cTipoLista=="1",(cAlias)->VALOR,(cAlias)->HORAS)
                            ElseIf (cAlias)->TIPOCOD == "2"
                                jHS["PD10HS"] -= Iif(cTipoLista=="1",(cAlias)->VALOR,(cAlias)->HORAS)
                            Endif
                        Endif
                    Endif
                Endif
            Endif

            // Pula para o próximo registro
            (cAlias)->(DBSkip())
        End

        If lAddReg
            If cTipoRel == "2" .AND. cOrientacao == "1" // Sintético Vertical
                aAdd(jData["VertSintetico"], jVS)
            ElseIf cTipoRel == "1" .AND. cOrientacao == "2" // Analítico Horizontal
                aAdd(jData["HorizAnalitico"], jHA)
            ElseIf cTipoRel == "2" .AND. cOrientacao == "2" // Sintético Horizontal
                aAdd(jData["HorizSintetico"], jHS)
            Endif
        Endif

        // Adiciona as informações da linha
        self:oData:appendData(jData)
    END SEQUENCE

    // Fecha a área da tabela temporária
    If !Empty(cAlias)
        (cAlias)->(DBCloseArea())
    Endif
    // Restaura a filial corrente

    // Limpa os objetos da memória
    FwFreeObj(jParams)
    FwFreeObj(oStatement)
    FwFreeArray(aCategorias)
    FwFreeArray(aSituacoes)
    FwFreeArray(aVerbas)
Return self:oData

/*/{Protheus.doc} GPER085TReportsBusinessObject:getSchema()
    Define o schema do objeto de negócio.
    @type Method
    @version 12.1.2410
    @author caio.kretzer
    @since 24/09/2025
    @return Object, Schema do objeto de negócio
/*/
Method getSchema() As Object Class GPER085TReportsBusinessObject

    // Define os parâmetros do relatório
    self:oSchema:addParameter("PAR_FILIALDE",   STR0011, "string", .F.)
    self:oSchema:addParameter("PAR_FILIALATE",  STR0012, "string", .F.)
    self:oSchema:addParameter("PAR_CCDE",       STR0013, "string", .F.)
    self:oSchema:addParameter("PAR_CCATE",      STR0014, "string", .F.)
    self:oSchema:addParameter("PAR_DEPTODE",    STR0015, "string", .F.)
    self:oSchema:addParameter("PAR_DEPTOATE",   STR0016, "string", .F.)
    self:oSchema:addParameter("PAR_MATDE",      STR0017, "string", .F.)
    self:oSchema:addParameter("PAR_MATATE",     STR0018, "string", .F.)
    self:oSchema:addParameter("PAR_NOMEDE",     STR0019, "string", .F.)
    self:oSchema:addParameter("PAR_NOMEATE",    STR0020, "string", .F.)
    self:oSchema:addParameter("PAR_SIT",        STR0021, "string", .T.)
    self:oSchema:addParameter("PAR_CAT",        STR0022, "string", .T.)
    self:oSchema:addParameter("PAR_ROTEIRO",    STR0024, "string", .F.)
    self:oSchema:addParameter("PAR_PROCESSO",   STR0025, "string", .F.)
    self:oSchema:addParameter("PAR_PERIODO",    STR0026, "string", .F.)
    self:oSchema:addParameter("PAR_NROPAG",     STR0027, "string", .F.)
    self:oSchema:addParameter("PAR_VERBAS",     STR0028, "string", .T.)
    self:oSchema:addParameter("PAR_SALARIO",    STR0029, "string", .F.)
    self:oSchema:addParameter("PAR_TOTALEMP",   STR0030, "string", .F.)
    self:oSchema:addParameter("PAR_TOTALLIQ",   STR0031, "string", .F.)
    self:oSchema:addParameter("PAR_CODVISAO",   STR0032, "string", .F.)
    self:oSchema:addParameter("PAR_DEPVISAO",   STR0033, "string", .F.)
    self:oSchema:addParameter("PAR_IMPBASES",   STR0034, "string", .F.)
    self:oSchema:addParameter("PAR_LISTA",      STR0035, "string", .F.)
    self:oSchema:addParameter("PAR_TIPOREL",    STR0023, "string", .F.)
    self:oSchema:addParameter("PAR_ORIENT",     STR0036, "string", .F.)
    self:oSchema:addParameter("PAR_GROUP",      STR0037, "string", .F.)

    // Define endpoints dos parâmetros de tipo lookup/combobox
    self:setCustomURL("PAR_FILIALDE",   "/api/rh/smartview/v1/options/GPEParams/getBranches",       2)
    self:setCustomURL("PAR_FILIALATE",  "/api/rh/smartview/v1/options/GPEParams/getBranches",       2)
    self:setCustomURL("PAR_CCDE",       "/api/framework/v1/genericLookupService/smartview/CTT",     2)
    self:setCustomURL("PAR_CCATE",      "/api/framework/v1/genericLookupService/smartview/CTT",     2)
    self:setCustomURL("PAR_DEPTODE",    "/api/framework/v1/genericLookupService/smartview/SQB",     2)
    self:setCustomURL("PAR_DEPTOATE",   "/api/framework/v1/genericLookupService/smartview/SQB",     2)
    self:setCustomURL("PAR_MATDE",      "/api/framework/v1/genericLookupService/smartview/SRA",     2)
    self:setCustomURL("PAR_MATATE",     "/api/framework/v1/genericLookupService/smartview/SRA",     2)
    self:setCustomURL("PAR_SIT",        "/api/rh/smartview/v1/options/GPEParams/getSX5/31",         2)
    self:setCustomURL("PAR_CAT",        "/api/rh/smartview/v1/options/GPEParams/getSX5/28",         2)
    self:setCustomURL("PAR_TIPOREL",    "/api/rh/smartview/v1/options/GPER085/PAR_TIPOREL",         1)
    self:setCustomURL("PAR_ROTEIRO",    "/api/framework/v1/genericLookupService/smartview/SRY",     2)
    self:setCustomURL("PAR_PROCESSO",   "/api/framework/v1/genericLookupService/smartview/RCJ",     2)
    self:setCustomURL("PAR_PERIODO",    "/api/framework/v1/genericLookupService/smartview/RCH08",   2)
    self:setCustomURL("PAR_VERBAS",     "/api/framework/v1/genericLookupService/smartview/SRV",     2)
    self:setCustomURL("PAR_SALARIO",    "/api/rh/smartview/v1/options/GPEParams/getSNOptions",      1)
    self:setCustomURL("PAR_TOTALEMP",   "/api/rh/smartview/v1/options/GPEParams/getSNOptions",      1)
    self:setCustomURL("PAR_TOTALLIQ",   "/api/rh/smartview/v1/options/GPEParams/getSNOptions",      1)
    self:setCustomURL("PAR_CODVISAO",   "/api/framework/v1/genericLookupService/smartview/RDK",     2)
    self:setCustomURL("PAR_DEPVISAO",   "/api/framework/v1/genericLookupService/smartview/RD4",     2)
    self:setCustomURL("PAR_IMPBASES",   "/api/rh/smartview/v1/options/GPEParams/getSNOptions",      1)
    self:setCustomURL("PAR_LISTA",      "/api/rh/smartview/v1/options/GPER085/PAR_LISTA",           1)
    self:setCustomURL("PAR_ORIENT",     "/api/rh/smartview/v1/options/GPER085/PAR_ORIENT",          1)
    self:setCustomURL("PAR_GROUP",      "/api/rh/smartview/v1/options/GPER085/PAR_GROUP",           1)
    
    self:oSchema:addProperty("FilialExec",          STR0038,    "string", STR0038,  STR0038 ,NIL, NIL, NIL, .F.)
    self:oSchema:addProperty("EmpresaExec",         STR0039,    "string", STR0039,  STR0039 ,NIL, NIL, NIL, .F.)

    // Adiciona as propriedades do objeto de negócio
    aFields := {}
    AAdd(aFields, {"BranchCodeVA",                  STR0040, "string", STR0040})
    AAdd(aFields, {"EmployeeCodeVA",                STR0041, "string", STR0041})
    AAdd(aFields, {"EmployeeNameVA",                STR0042, "string", STR0042})
