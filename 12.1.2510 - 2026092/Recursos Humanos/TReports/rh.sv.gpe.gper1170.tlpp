#Include 'TOTVS.ch'
#Include 'msobject.ch'
#Include "tlpp-core.th"
#Include "tlpp-rest.th"
#Include 'rh.sv.gpe.gper1170.ch'
#Include 'totvs.framework.treports.integratedprovider.th'

namespace totvs.protheus.rh.treportsintegratedprovider

//-------------------------------------------------------------------------------
/*{Protheus.doc} gper1170TReportsBusinessObject

	@description Clase para la creación del Objeto de Negocio para TReports
	@author oscar.lopez
	@since 20/08/2026
	@version 1.0
*/
//-------------------------------------------------------------------------------
@totvsFrameworkTReportsIntegratedProvider(active=.T., team='SIGAGPE', tables='SRA,RV0,RCH', name="Banco de Horas", country='ARG', initialRelease='12.1.2410', customTables='SRA,RV0,RCH')
class gper1170TReportsBusinessObject from totvs.framework.treports.integratedprovider.IntegratedProvider

	Public Method new() as object
	Public Method getData() as object
	Public Method getSchema() as object

	Protected data aFields		as array
	Protected data aStruct		as array
	Protected data jItems		as json
	Protected data cCposQry		as character

endclass

//-------------------------------------------------------------------
/*{Protheus.doc} new
	Método de instancia de la Clase

	@Return object: self
	@author oscar.lopez
	@since 20/08/2026
	@version 1.0
*/
//-------------------------------------------------------------------
Method new() class gper1170TReportsBusinessObject

	_Super:new()

	//Define o nome do Objeto de Negócio
	self:setDisplayName(STR0001)  // "Recibo de Pago"

	//Define a descrição do Objeto de Negócio
	self:setDescription(STR0001)  // "Recibo de Pago"

	// Define a Área
	self:appendArea(STR0002) // 'Gestión de Personal'

	// Define se as perguntas terao lookup
	self:setIsLookUp(.T.)

	self:aFields := {"RA_FILIAL", "RA_MAT", "RA_PRINOME", "RA_SECNOME", "RA_PRISOBR", "RA_SECSOBR", "RA_ADMISSA", "RA_CIC",;
					 "RCH_PER", "RCH_NUMPAG", "RCH_PROCES", "RCH_MES", "RCH_ANO", "RCH_DTINI", "RCH_DTFIM",;
					 "RV0_SALANT", "RV0_BCOHOR", "RV0_HORCOM", "RV0_SALDO" }

	self:aStruct := getStrutObj(self:aFields)

Return (self)

//-------------------------------------------------------------------
/*{Protheus.doc} getData
	Retorna los datos del objeto de negocio

	@param nPage, numérico, indica la pagina actual del relatório
	@param oFilter, objeto, contiene el filtro del TReports
	@return object: self:oData
	@author oscar.lopez
	@since 20/08/2026
	@version 1.0
*/
//------------------------------------------------------------------- 
Method getData( nPage as numeric, oFilter as object) as object class gper1170TReportsBusinessObject

	// Declaracion de variables locales
	Local oQryEmp		As Object
	Local jParams		As JSON
	Local cAlias		As Character
	Local cNomCampo		As Character
	Local cSucursal		As Character
	Local nPosCampo		As Numeric
	Local nIteracion	As Numeric
	Local aCposSuc		As Array
	Local aInfoSuc		As Array
	Local aCustField	As Array
	Local cCustField	As Character	// Campos personalizados para el query

	oQryEmp		:= Nil
	cAlias		:= ""
	cNomCampo	:= ""
	nPosCampo	:= 0
	nIteracion	:= 0
	aCposSuc	:= {}
	aInfoSuc	:= {}
	aCustField	:= {}
	cCustField	:= ""

	// Parámetros
	jParams		:= oFilter:getParameters()
	cSucursal	:= jParams["PAR_FILIAL"][1]

	// Si no se informa sucursal, se toma la sucursal actual a partir de tabla SRA (completamente exclusiva)
	If Empty(cSucursal)
		cSucursal := FWxFilial("SRA")
	EndIf

	// Inicializacion de las variables
	self:jItems	:= JsonObject():new()

	// Obtiene campos personalizados para el objeto comercial
	cCustField := GPESmartViewUtils():GetCustomFields(self:getCustomFields(), {"SRA", "RV0", "RCH"})
	If !Empty(cCustField)
		cCustField := ", " + cCustField
		// Añade los campos personalizados a la estructura de datos
		aCustField := self:getCustomFields()
		For nIteracion := 1 To Len( aCustField )
			aAdd( self:aStruct, { aCustField[nIteracion][1], aCustField[nIteracion][2], aCustField[nIteracion][3], aCustField[nIteracion][4], aCustField[nIteracion][1] } )
			aAdd( self:aFields, aCustField[nIteracion][1] )
		Next nIteracion
	EndIf

	If QryMovEmp(@oQryEmp, @cAlias, cSucursal, jParams, cCustField)

		aCposSuc := { "M0_NOMECOM", "M0_CGC", "M0_ENDENT", "M0_BAIRENT", "M0_CEPENT", "M0_ESTENT" }
		aInfoSuc := FWSM0Util():GetSM0Data(cEmpAnt, cSucursal, aCposSuc)

		DbSelectArea(cAlias)
		(cAlias)->(DbGoTop())

		While (cAlias)->(!Eof())
			self:jItems	:= JsonObject():new()

			// Información Empresa
			self:jItems["EMPRNOM"]	:= aInfoSuc[1][2]
			self:jItems["EMPRCGC"]	:= aInfoSuc[2][2]
			self:jItems["EMPRDOM"]	:= aInfoSuc[3][2]
			self:jItems["EMPRBAR"]	:= aInfoSuc[4][2]
			self:jItems["CEPENT"]	:= aInfoSuc[5][2]
			self:jItems["ESTENT"]	:= aInfoSuc[6][2]

			For nIteracion := 1 To Len(self:aStruct)
				cNomCampo := self:aStruct[nIteracion][5]
				nPosCampo := (cAlias)->(FieldPos(cNomCampo))
				If nPosCampo > 0
					If (self:aStruct[nIteracion][3] == 'date')
						self:jItems[self:aStruct[nIteracion][1]] := totvs.framework.treports.date.dateToTimeStamp(StoD((cAlias)->(FieldGet(nPosCampo))))
					Else
						self:jItems[self:aStruct[nIteracion][1]] := (cAlias)->(FieldGet(nPosCampo))
					EndIf
				EndIf
			Next nIteracion

			self:oData:appendData(self:jItems)

			// Se libera la memoria de los objetos al finalizar el procesamiento de cada empleado
			FreeObj(self:jItems)
			(cAlias)->(DbSkip())
		EndDo

		// Si no es el último registro indica que habrá una página siguiente
		self:setHasNext(.F.)

	EndIf

	// Cierra el Area y libera la memoria del objeto de consulta
	(cAlias)->(DbCloseArea())
	FwFreeObj(oQryEmp)

Return (self:oData)

//-------------------------------------------------------------------
/*{Protheus.doc} getSchema

@description Retorna la estructura de los campos
@return object: self:oSchema
@author oscar.lopez
@since 20/08/2026
@version 1.0
*/
//------------------------------------------------------------------- 
Method getSchema() as object class gper1170TReportsBusinessObject

	// Declaracion de las variables
	Local nIteration	As Numeric

	// Información Empresa
	self:addProperty("EMPRNOM"	, STR0009, "string", STR0009, "EMPRNOM")	// "Empresa Nombre"
	self:addProperty("EMPRCGC"	, STR0010, "string", STR0010, "EMPRCGC")	// "Empresa CNPJ o CPF"
	self:addProperty("EMPRDOM"	, STR0011, "string", STR0011, "EMPRDOM")	// "Empresa Domicilio"
	self:addProperty("EMPRBAR"	, STR0012, "string", STR0012, "EMPRBAR")	// "Empresa Barrio"
	self:addProperty("CEPENT"	, STR0013, "string", STR0013, "CEPENT")		// "Empresa Entidad"
	self:addProperty("ESTENT"	, STR0014, "string", STR0014, "ESTENT")		// "Empresa Estado"

	// Adiciona las propiedades de los campos que serán retornados para Smart View
	For nIteration := 1 To Len( self:aStruct )
		self:addProperty(self:aStruct[nIteration][1], self:aStruct[nIteration][2], self:aStruct[nIteration][3], self:aStruct[nIteration][4], self:aStruct[nIteration][5])
	Next nIteration

	//Define los parámetros del informe
	self:oSchema:addParameter("PAR_FILIAL"	, STR0003		, "string"	, .F.) // "Sucursal"
	self:oSchema:addParameter("PAR_PROCES"	, STR0004		, "string"	, .F.) // "Proceso"
	self:oSchema:addParameter("PAR_FECINI"	, STR0005		, "date"	, .F.) // "Fecha Inicial"
	self:oSchema:addParameter("PAR_FECFIN"	, STR0006		, "date"	, .F.) // "Fecha Final"
	self:oSchema:addParameter("PAR_MATINI"	, STR0007 		, "string"	, .F.) // "Matricula Ini."
	self:oSchema:addParameter("PAR_MATFIN"	, STR0008 		, "string"	, .F.) // "Matricula Fin."

	// Consultas para parámetros
	self:setCustomURL("PAR_FILIAL"	, "/api/rh/smartview/v1/options/GPEParams/getBranches"		, 2)
	self:setCustomURL("PAR_PROCES"	, "/api/framework/v1/genericLookupService/smartview/RCJ"	, 2)
	self:setCustomURL("PAR_MATINI"	, "/api/framework/v1/genericLookupService/smartview/SRA"	, 2)
	self:setCustomURL("PAR_MATFIN"	, "/api/framework/v1/genericLookupService/smartview/SRA"	, 2)

Return (self:oSchema)

/*/{Protheus.doc} QryMovEmp
	Manejo de la consulta de movimientos de empleados
	@type  Static Function
	@author oscar.lopez
	@since 22/06/2026
	@version 1.0
	@param oQryEmp, objeto, Objeto para la consulta de movimientos de empleados
	@param cAlias, caracter, Alias de la tabla generada por la consulta de movimientos de empleados
	@param cSucursal, caracter, Sucursal de la empresa para filtrar los movimientos de empleados
	@param jParams, json, Parámetros de filtro para la consulta de movimientos de empleados
	@param cCustField, caracter, Campos personalizados para la consulta de movimientos de empleados
	@return lRet, logico, Retorna .T.
	@example
		QryMovEmp(@oQryEmp, @cAlias, cSucursal, jParams, cCustField)
/*/
Static Function QryMovEmp(oQryEmp, cAlias, cSucursal, jParams, cCustField)

	Local lRet		:= .T.
	Local cQuery	:= ""
	Local cProceso	:= ""
	Local dFchIni	:= ""
	Local dFchFin	:= ""
	Local cMatrIni	:= ""
	Local cMatrFin	:= ""
	Local nParQry	:= 1

	Default oQryEmp		:= Nil
	Default cAlias		:= ""
	Default cSucursal	:= ""
	Default jParams		:= JsonObject():new()
	Default cCustField	:= ""

	cProceso	:= jParams["PAR_PROCES"][1]
	dFchIni		:= SToD(StrTran(Left(jParams["PAR_FECINI"][1], 10), "-", ""))
	dFchFin		:= SToD(StrTran(Left(jParams["PAR_FECFIN"][1], 10), "-", ""))
	cMatrIni	:= jParams["PAR_MATINI"][1]
	cMatrFin	:= jParams["PAR_MATFIN"][1]

	cQuery := " SELECT SRA.RA_FILIAL, SRA.RA_MAT, SRA.RA_PRINOME, SRA.RA_SECNOME, SRA.RA_PRISOBR, SRA.RA_SECSOBR, SRA.RA_ADMISSA, SRA.RA_CIC "
	cQuery += " , RCH.RCH_PER, RCH.RCH_NUMPAG, RCH.RCH_PROCES, RCH.RCH_MES, RCH.RCH_ANO, RCH.RCH_DTINI, RCH.RCH_DTFIM "
	cQuery += " , COALESCE(RV0.RV0_SALANT, 0) RV0_SALANT "
	cQuery += " , COALESCE(RV0.RV0_BCOHOR, 0) RV0_BCOHOR "
	cQuery += " , COALESCE(RV0.RV0_HORCOM, 0) RV0_HORCOM "
	cQuery += " , COALESCE(RV0.RV0_SALDO,  0) RV0_SALDO "
	cQuery += " ? "
	cQuery += " FROM ? SRA "
	cQuery += " CROSS JOIN ? RCH "
	cQuery += " LEFT JOIN ? RV0 "
	cQuery += " ON RV0.RV0_FILIAL = ?"
	cQuery += " AND RV0.RV0_MAT = SRA.RA_MAT "
	cQuery += " AND RV0.RV0_PER = RCH.RCH_PER "
	cQuery += " AND RV0.RV0_NUMPAG = RCH.RCH_NUMPAG "
	cQuery += " AND RV0.D_E_L_E_T_ = ? "
	cQuery += " WHERE RCH.RCH_DTINI >= SRA.RA_ADMISSA "
	cQuery += " AND SRA.RA_PROCES = RCH.RCH_PROCES "
	cQuery += " AND SRA.RA_FILIAL = ? "
	cQuery += " AND SRA.RA_PROCES = ? "
	cQuery += " AND SRA.RA_ACUMBH = ? "
	cQuery += " AND SRA.RA_DEMISSA = ? "
	cQuery += " AND SRA.RA_MAT BETWEEN ? AND ? "
	cQuery += " AND SRA.D_E_L_E_T_ = ? "
	cQuery += " AND RCH.RCH_FILIAL = ? "
	cQuery += " AND RCH.RCH_ROTEIR = ? "
	cQuery += " AND RCH.RCH_DTINI >= ? "
	cQuery += " AND RCH.RCH_DTFIM <= ? "
	cQuery += " AND RCH.RCH_STATUS = ? "
	cQuery += " AND RCH.D_E_L_E_T_ = ? "
	cQuery += " ORDER BY "
	cQuery += " SRA.RA_FILIAL, SRA.RA_MAT, RCH.RCH_DTINI "

	oQryEmp := FwExecStatement():New(cQuery)

	// SELECT
	oQryEmp:SetUnsafe(nParQry++	, cCustField		) // Campos personalizados
	// FROM
	oQryEmp:SetUnsafe(nParQry++	, RetSqlName("SRA")	)
	// CROSS JOIN
	oQryEmp:SetUnsafe(nParQry++	, RetSqlName("RCH")	)
	// LEFT JOIN
	oQryEmp:SetUnsafe(nParQry++	, RetSqlName("RV0")	)
	oQryEmp:SetString(nParQry++	, FWxFilial("RV0", cSucursal))
	oQryEmp:SetString(nParQry++	, Space(1)			) // RV0.D_E_L_E_T_
	// WHERE
	oQryEmp:SetString(nParQry++	, FWxFilial("SRA", cSucursal))
	oQryEmp:SetString(nParQry++	, cProceso			)
	oQryEmp:SetString(nParQry++	, 'S'				) // Empleados con Banco de Horas
	oQryEmp:SetString(nParQry++	, Space(8)			) // Empleados sin fecha de baja
	oQryEmp:SetString(nParQry++	, cMatrIni			)
	oQryEmp:SetString(nParQry++	, cMatrFin			)
	oQryEmp:SetString(nParQry++	, Space(1)			) // SRA.D_E_L_E_T_
	oQryEmp:SetString(nParQry++	, FWxFilial("RCH", cSucursal))
	oQryEmp:SetString(nParQry++	, fGetRotOrdinar(, cSucursal)) // Procedimiento Nomina Ordinaria
	oQryEmp:SetDate(nParQry++	, dFchIni			)
	oQryEmp:SetDate(nParQry++	, dFchFin			)
	oQryEmp:SetString(nParQry++	, '5'				) // Periodos cerrados
	oQryEmp:SetString(nParQry++	, Space(1)			) // RCH.D_E_L_E_T_

	cAlias := oQryEmp:OpenAlias()

Return lRet
