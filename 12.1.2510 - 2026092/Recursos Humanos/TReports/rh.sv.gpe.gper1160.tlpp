#Include "msobject.ch"
#Include "tlpp-core.th"
#Include "tlpp-rest.th"
#Include "totvs.framework.treports.integratedprovider.th"
#Include "rh.sv.gpe.gper1160.ch"

namespace totvs.protheus.rh.treportsintegratedprovider

//-------------------------------------------------------------------------------
/*{Protheus.doc} gper1160TReportsBusinessObject

	@description Clase para la creación del Objeto de Negocio para TReports
	@author oscar.lopez
	@since 15/04/2026
	@version 1.0
*/
//-------------------------------------------------------------------------------
@totvsFrameworkTReportsIntegratedProvider(active=.T., team='SIGAGPE', tables='SRA, SRC, SRD, SRV, RCH', name="Recibo de Pago", country='ARG', initialRelease='12.1.2410', customTables='SRA')
class gper1160TReportsBusinessObject from totvs.framework.treports.integratedprovider.IntegratedProvider

	Public Method new() as object
	Public Method getData() as object
	Public Method getSchema() as object

	Protected data aFields		as array
	Protected data aStruct		as array
	Protected data jItems		as json

	data cLogoEmp as Character

endclass

//-------------------------------------------------------------------
/*{Protheus.doc} new
	Método de instancia de la Clase

	@Return object: self
	@author oscar.lopez
	@since 15/04/2026
	@version 1.0
*/
//-------------------------------------------------------------------
Method new() class gper1160TReportsBusinessObject

	_Super:new()

	//Define o nome do Objeto de Negócio
	self:setDisplayName(STR0001)  // "Recibo de Pago"

	//Define a descrição do Objeto de Negócio
	self:setDescription(STR0001)  // "Recibo de Pago"

	// Define a Área
	self:appendArea(STR0002) // 'Gestión de Personal'

	// Define logo de la empresa
	self:cLogoEmp := GPESmartViewUtils():getLogoSV(cEmpAnt)

	// Define se as perguntas terao lookup
	self:setIsLookUp(.T.)

	self:aFields := { "RA_MAT"		, "RA_NOME"		, "RA_CIC"		, "RA_ADMISSA"	, "RA_DEMISSA"	, "RA_MODALID", "RA_SALARIO"	, "RA_CARGO"	, "RA_CC"		,;
					  "RA_BCDEPSA"	, "RA_CTDEPSA"	, "RA_DTREC"	, "RA_CODFUNC"	, "RA_CATFUNC"	, "RA_PRINOME", "RA_SECNOME"	, "RA_PRISOBR"	, "RA_SECSOBR"	,;
					  "RA_CFGOSOC"	, "RA_OPCAO"	, "Q3_DESCSUM"	, "CTT_DESC01"	, "RJ_DESC"		}

	self:aStruct := getStrutObj(self:aFields)

Return (self)

//-------------------------------------------------------------------
/*{Protheus.doc} getData
	Retorna los datos del objeto de negocio

	@param nPage, numérico, indica la pagina actual del relatório
	@param oFilter, objeto, contiene el filtro del TReports
	@return object: self:oData
	@author oscar.lopez
	@since 15/04/2026
	@version 1.0
*/
//------------------------------------------------------------------- 
Method getData( nPage as numeric, oFilter as object) as object class gper1160TReportsBusinessObject

	// Declaracion de variables locales
	Local oQryEmp		As Object
	Local jParams		As JSON
	Local jCposRCC		As JSON
	Local nIteracion	As Numeric
	Local cAlias		As Character
	Local aCposSuc		As Array
	Local aInfoSuc		As Array
	Local aConceptos	As Array
	Local cTabSR		As Character
	Local cAliasSR		As Character
	Local cFilRCH		As Character
	Local cFilSA6		As Character
	Local cMatTmp		As Character
	Local dFchpago		As Date
	Local cNumPago		As Character
	Local cMesPago		As Character
	Local cAnioPago		As Character
	Local cNomCampo		As Character
	Local nPosCampo		As Numeric
	Local cMensaje01	As Character
	Local cMensaje02	As Character
	Local cMensaje03	As Character
	Local nTotConLiq	As Numeric
	Local nTotConPat	As Numeric
	Local cCodBanco		As Character
	Local cAgeBanco		As Character
	Local aCustField	As Array
	Local nIteraSuc		As Numeric
	Local cSucursal		As Character
	Local cModoRCC		As Character
	Local cCodFil		As Character

	// Variables para filtros
	Local aSucursal		As Array
	Local cProceso		As Character
	Local cProcedim		As Character
	Local cPeriodo		As Character
	Local cSemana		As Character
	Local cSeqMsj01		As Character
	Local cSeqMsj02		As Character
	Local cSeqMsj03		As Character

	// Parámetros
	jParams		:= oFilter:getParameters()
	aSucursal	:= jParams["PAR_FILIAL"]
	cProceso	:= jParams["PAR_PROCES"][1]
	cProcedim	:= jParams["PAR_PROCED"][1]
	cPeriodo	:= jParams["PAR_PERIOD"][1]
	cSemana		:= jParams["PAR_NUMPAG"][1]
	cSeqMsj01	:= AllTrim(jParams["PAR_MENS01"][1])
	cSeqMsj02	:= AllTrim(jParams["PAR_MENS02"][1])
	cSeqMsj03	:= AllTrim(jParams["PAR_MENS03"][1])

	// Si no se informa sucursal, se toma la sucursal actual a partir de tabla SRA (completamente exclusiva)
	If Empty(aSucursal)
		AAdd(aSucursal, FWxFilial("SRA"))
	EndIf
	aSort(aSucursal)

	// Inicializacion de las variables
	self:jItems	:= JsonObject():new()
	jCposRCC	:= JsonObject():new()
	nIteraSuc	:= 0
	cModoRCC	:= FWModeAccess("RCC",1)+FWModeAccess("RCC",2)+FWModeAccess("RCC",3)

	DbSelectArea("SA6")
	SA6->(DbSetOrder(1)) //A6_FILIAL+A6_COD+A6_AGENCIA+A6_NUMCON
	DbSelectArea("RCH")
	RCH->(DbSetOrder(1)) //RCH_FILIAL+RCH_PROCES+RCH_PER+RCH_NUMPAG+RCH_ROTEIR


	InicDetCon(@self:jItems)

	// Añade campos personalizados a estructura del objeto comercial
	aCustField := self:getCustomFields()
	For nIteracion := 1 To Len( aCustField )
		aAdd( self:aStruct, { aCustField[nIteracion][1], aCustField[nIteracion][2], aCustField[nIteracion][3], aCustField[nIteracion][4], aCustField[nIteracion][1] } )
		aAdd( self:aFields, aCustField[nIteracion][1] )
	Next nIteracion

	For nIteraSuc := 1 To Len(aSucursal)

		cSucursal := aSucursal[nIteraSuc]

		cCodFil		:= 'TOTCOM' // Se utiliza un valor por defecto en caso de que la tabla RCC sea totalmente compartida
		If !(cModoRCC == 'CCC')
			// Si no es totalmente compartida, se utiliza la sucursal para filtrar los datos de la tabla RCC en 
			// el objeto JSON jCposRCC, de manera que se pueda almacenar la información de cada sucursal por separado
			cCodFil	:= FWxFilial("RCC", cSucursal)
		EndIf

		// Se valida si el periodo es un periodo abierto o cerrado
		cFilRCH := FWxFilial("RCH", cSucursal)

		If RCH->(MsSeek(cFilRCH+cProceso+cPeriodo+cSemana+cProcedim))
			// Reinicio de variables
			cFilSA6		:= FWxFilial("SA6", cSucursal)
			cTabSR		:= "SRD"
			cAliasSR	:= "RD"
			If RCH->RCH_STATUS <> "5" // Periodo Finalizado
				cTabSR	:= "SRC"
				cAliasSR:= "RC"
			EndIf
			dFchpago	:= RCH->RCH_DTPAGO
			cNumPago	:= RCH->RCH_NUMPAG
			cMesPago	:= RCH->RCH_MES
			cAnioPago	:= RCH->RCH_ANO

			If QryMovEmp(@oQryEmp, @cAlias, cTabSR, cAliasSR, cSucursal, jParams, aCustField)

				aCposSuc := { "M0_NOMECOM", "M0_CGC", "M0_ENDENT", "M0_BAIRENT", "M0_CEPENT", "M0_ESTENT" }
				aInfoSuc := FWSM0Util():GetSM0Data(cEmpAnt, cSucursal, aCposSuc)

				// Inicializa el objeto JSON para almacenar la información de las tablas alfanuméricas
				If jCposRCC[cCodFil] == Nil
					jCposRCC[cCodFil] := JsonObject():new()
					jCposRCC[cCodFil]["S002"] := JsonObject():new()
					jCposRCC[cCodFil]["S008"] := JsonObject():new()
					jCposRCC[cCodFil]["S052"] := JsonObject():new()
					jCposRCC[cCodFil]["S053"] := JsonObject():new()

					// Reinicia información de tablas alfanuméricas utilizadas en fPosTab()
					RstGpexIni()

					//Mensajes personalizados
					jCposRCC[cCodFil]["S052"]["01"] := fGetMejRCC(cSeqMsj01, "S052", 04, 05, cSucursal)
					jCposRCC[cCodFil]["S052"]["02"] := fGetMejRCC(cSeqMsj02, "S052", 04, 05, cSucursal)
					jCposRCC[cCodFil]["S052"]["03"] := fGetMejRCC(cSeqMsj03, "S052", 04, 05, cSucursal)

					// Obtiene configuración de conceptos para liquidación y aportes
					GetContS53(cSucursal, @jCposRCC[cCodFil]["S053"])
				EndIf

				cMensaje01	:= jCposRCC[cCodFil]["S052"]["01"]
				cMensaje02	:= jCposRCC[cCodFil]["S052"]["02"]
				cMensaje03	:= jCposRCC[cCodFil]["S052"]["03"]

				DbSelectArea(cAlias)
				(cAlias)->(DbGoTop())

				While (cAlias)->(!Eof())
					self:jItems	:= JsonObject():new()
					aConceptos	:= {{},{},{},{}}
					nTotConLiq	:= 0
					nTotConPat	:= 0
					cMatTmp		:= (cAlias)->RA_MAT

					For nIteracion := 1 To Len(self:aStruct)
						cNomCampo := self:aStruct[nIteracion][5]
						nPosCampo := (cAlias)->(FieldPos(cNomCampo))
						If nPosCampo > 0
							If (self:aStruct[nIteracion][3] == 'date')
								self:jItems[self:aStruct[nIteracion][1]] := totvs.framework.treports.date.dateToTimeStamp(StoD((cAlias)->(FieldGet(nPosCampo))))
							Else
								self:jItems[self:aStruct[nIteracion][1]] := (cAlias)->(FieldGet(nPosCampo))
							EndIf
						EndIf
					Next nIteracion

					// Informacion Periodo
					self:jItems["FCHPAGO"]	:= totvs.framework.treports.date.dateToTimeStamp(dFchpago)
					self:jItems["NUMPAGO"]	:= cNumPago
					self:jItems["MESPAGO"]	:= cMesPago
					self:jItems["ANIOPAGO"]	:= cAnioPago

					// Información Empresa
					self:jItems["EMPRNOM"]	:= aInfoSuc[1][2]
					self:jItems["EMPRCGC"]	:= aInfoSuc[2][2]
					self:jItems["EMPRDOM"]	:= aInfoSuc[3][2]
					self:jItems["EMPRBAR"]	:= aInfoSuc[4][2]
					self:jItems["CEPENT"]	:= aInfoSuc[5][2]
					self:jItems["ESTENT"]	:= aInfoSuc[6][2]
					self:jItems["LOGOEMP"]	:= self:cLogoEmp

					// Información Banco
					cCodBanco := SubStr((cAlias)->RA_BCDEPSA, 1, 3)
					cAgeBanco := SubStr((cAlias)->RA_BCDEPSA, 4, 5)
					self:jItems["BCOCOD"]	:= cCodBanco
					self:jItems["BCOAGE"]	:= cAgeBanco
					self:jItems["BCONOM"]	:= ""
					If SA6->(MsSeek(cFilSA6 + cCodBanco + cAgeBanco))
						self:jItems["BCONOM"]	:= AllTrim(SA6->A6_NOME)
					EndIf

					// Informacion adicional
					self:jItems["MENSAJE01"]:= cMensaje01
					self:jItems["MENSAJE02"]:= cMensaje02
					self:jItems["MENSAJE03"]:= cMensaje03

					// Obtiene información de tablas alfanuméricas y almacena en objeto JSON para no volver a consultar
					If jCposRCC[cCodFil]["S008"][(cAlias)->RA_MODALID] == Nil
						jCposRCC[cCodFil]["S008"][(cAlias)->RA_MODALID] := fGetMejRCC((cAlias)->RA_MODALID, "S008", 04, 07, cSucursal)
					EndIf
					If jCposRCC[cCodFil]["S002"][(cAlias)->RA_CFGOSOC] == Nil
						jCposRCC[cCodFil]["S002"][(cAlias)->RA_CFGOSOC] := fGetMejRCC((cAlias)->RA_CFGOSOC, "S002", 04, 07, cSucursal)
					EndIf
					cModalidad := jCposRCC[cCodFil]["S008"][(cAlias)->RA_MODALID]
					cObrSocial := jCposRCC[cCodFil]["S002"][(cAlias)->RA_CFGOSOC]

					self:jItems["DSCMODCON"]:= cModalidad
					self:jItems["DSCOBRSOC"]:= cObrSocial
					self:jItems["DSCCATFUN"]:= FWGetSX5("28", (cAlias)->RA_CATFUNC)[1][4]

					self:jItems["TOTAPORTE"]:= 0
					self:jItems["TOTEXENTO"]:= 0
					self:jItems["TOTDESCUE"]:= 0
					self:jItems["TOTALNETO"]:= 0
					self:jItems["COSTOTEMP"]:= 0

					// Se inicializan los registros de los miembros de datos
					InicDetCon(@self:jItems)

					While (cAlias)->(!Eof()) .And. (cAlias)->RA_MAT == cMatTmp
						If !((cAlias)->RV_COD == "901")
							// Se procesa la información de concepto
							ProcesaCon(cAlias, jCposRCC[cCodFil]["S053"], @self:jItems, aConceptos)
						EndIf
						(cAlias)->(DbSkip())
					EndDo

					// Sueldo Neto asignado al grafico
					self:jItems["COMPSAL"][7]["TOTRUB"] := self:jItems["TOTALNETO"]

					// Inserta información de conceptos en el objeto de datos
					InseDetCon(@self:jItems, aConceptos)
					self:oData:appendData(self:jItems)

					// Se libera la memoria de los objetos al finalizar el procesamiento de cada empleado
					FreeObj(self:jItems)
					FWFreeArray(aConceptos)

				EndDo

				// Si no es el último registro indica que habrá una página siguiente
				self:setHasNext(.F.)

				// Cierra el Area
				(cAlias)->(DbCloseArea())
			EndIf

			// libera la memoria del objeto de query
			FwFreeObj(oQryEmp)
		EndIf

	Next nIteraSuc

	// Libera la memoria del objeto JSON que almacena la información de las tablas alfanuméricas
	FwFreeObj(jCposRCC)

Return (self:oData)

//-------------------------------------------------------------------
/*{Protheus.doc} getSchema

@description Retorna la estructura de los campos
@return object: self:oSchema
@author oscar.lopez
@since 15/04/2026
@version 1.0
*/
//------------------------------------------------------------------- 
Method getSchema() as object class gper1160TReportsBusinessObject

	// Declaracion de las variables
	Local nIteration	As Numeric
	Local aFields		As Array
	Local aFielCompS	As Array

	// Adiciona las propiedades de los campos que serán retornados para Smart View
	For nIteration := 1 To Len( self:aStruct )
		self:addProperty(self:aStruct[nIteration][1], self:aStruct[nIteration][2], self:aStruct[nIteration][3], self:aStruct[nIteration][4], self:aStruct[nIteration][5])
	Next nIteration

	//Información Pago
	self:addProperty("FCHPAGO"	, fGetTitDsc(1, 'RCH_DTPAGO')	, "date"	, fGetTitDsc(2, 'RCH_DTPAGO')	, "FCHPAGO")
	self:addProperty("NUMPAGO"	, fGetTitDsc(1, 'RCH_NUMPAG')	, "string"	, fGetTitDsc(2, 'RCH_NUMPAG')	, "NUMPAGO")
	self:addProperty("MESPAGO"	, fGetTitDsc(1, 'RCH_MES')		, "string"	, fGetTitDsc(2, 'RCH_MES')		, "MESPAGO")
	self:addProperty("ANIOPAGO"	, fGetTitDsc(1, 'RCH_ANO')		, "string"	, fGetTitDsc(2, 'RCH_ANO')		, "ANIOPAGO")

	// Información Banco
	self:addProperty("BCOCOD"	, fGetTitDsc(1, 'A6_COD')		, "string"	, fGetTitDsc(2, 'A6_COD')		, "BCOCOD")
	self:addProperty("BCOAGE"	, fGetTitDsc(1, 'A6_AGENCIA')	, "string"	, fGetTitDsc(2, 'A6_AGENCIA')	, "BCOAGE")
	self:addProperty("BCONOM"	, fGetTitDsc(1, 'A6_NOME')		, "string"	, fGetTitDsc(2, 'A6_NOME')		, "BCONOM")

	// Información Empresa
	self:addProperty("EMPRNOM"	, STR0003, "string", STR0003, "EMPRNOM"	)	// "Empresa Nombre"
	self:addProperty("EMPRCGC"	, STR0004, "string", STR0004, "EMPRCGC"	)	// "Empresa CNPJ o CPF"
	self:addProperty("EMPRDOM"	, STR0005, "string", STR0005, "EMPRDOM"	)	// "Empresa Domicilio"
	self:addProperty("EMPRBAR"	, STR0006, "string", STR0006, "EMPRBAR"	)	// "Empresa Barrio"
	self:addProperty("CEPENT"	, STR0007, "string", STR0007, "CEPENT"	)	// "Empresa Entidad"
	self:addProperty("ESTENT"	, STR0008, "string", STR0008, "ESTENT"	)	// "Empresa Estado"
	self:addProperty("LOGOEMP"	, STR0053, "string", STR0053, "LOGOEMP"	)	// "Logo"

	//Informacion Adicional
	self:addProperty("MENSAJE01", STR0018, "string", STR0018, "MENSAJE01") // "Mensaje 1"
	self:addProperty("MENSAJE02", STR0019, "string", STR0019, "MENSAJE02") // "Mensaje 2"
	self:addProperty("MENSAJE03", STR0020, "string", STR0020, "MENSAJE03") // "Mensaje 3"
	self:addProperty("DSCMODCON", STR0023, "string", STR0023, "DSCMODCON") // "Desc. Mod. Contrat."
	self:addProperty("DSCCATFUN", STR0024, "string", STR0024, "DSCCATFUN") // "Desc. Cat. Funciones"
	self:addProperty("DSCOBRSOC", STR0025, "string", STR0025, "DSCOBRSOC") // "Desc. Obra Social"
	self:addProperty("TOTAPORTE", STR0026, "number", STR0026, "TOTAPORTE") // "Total Aportes"
	self:addProperty("TOTEXENTO", STR0027, "number", STR0027, "TOTEXENTO") // "Total Exentos"
	self:addProperty("TOTDESCUE", STR0028, "number", STR0028, "TOTDESCUE") // "Total Descuentos"
	self:addProperty("TOTALNETO", STR0029, "number", STR0029, "TOTALNETO") // "Neto a cobrar"
	self:addProperty("COSTOTEMP", STR0042, "number", STR0042, "COSTOTEMP") // "Costo Total Empleador"

	//Estructura para Conceptos Liquidados y Contribuciones Patronales
	aFields	:= {}

	// Adiciona las propiedades de los campos que serán retornados para Smart View
	aAdd(aFields, {"CODCON"	, fGetTitDsc(1, 'RC_PD')		, "string"	, fGetTitDsc(2, 'RC_PD')		})
	aAdd(aFields, {"TIPCOD"	, fGetTitDsc(1, 'RV_TIPOCOD')	, "string"	, fGetTitDsc(2, 'RV_TIPOCOD')	})
	aAdd(aFields, {"DESCRI"	, fGetTitDsc(1, 'RV_DESC')		, "string"	, fGetTitDsc(2, 'RV_DESC')		})
	aAdd(aFields, {"DESDET"	, fGetTitDsc(1, 'RV_DESCDET')	, "string"	, fGetTitDsc(2, 'RV_DESCDET')	})
	aAdd(aFields, {"CODFOL"	, fGetTitDsc(1, 'RV_CODFOL')	, "string"	, fGetTitDsc(2, 'RV_CODFOL')	})
	aAdd(aFields, {"CLASIF"	, fGetTitDsc(1, 'RV_CLASIF')	, "string"	, fGetTitDsc(2, 'RV_CLASIF')	})
	aAdd(aFields, {"COLIMP"	, fGetTitDsc(1, 'RV_COLIMP')	, "string"	, fGetTitDsc(2, 'RV_COLIMP')	})
	aAdd(aFields, {"HORAS"	, fGetTitDsc(1, 'RC_HORAS')		, "number"	, fGetTitDsc(2, 'RC_HORAS')		})
	aAdd(aFields, {"VALOR"	, fGetTitDsc(1, 'RC_VALOR')		, "number"	, fGetTitDsc(2, 'RC_VALOR')		})
	aAdd(aFields, {"BASECON", STR0033						, "number"	, STR0033						}) // "Base Concepto"
	aAdd(aFields, {"TIPOVAL", STR0034						, "string"	, STR0034						}) // "Tipo Valor"

	// Detalle de conceptos para agrupar contribuciones patronales
	self:addNestedProperty("CONTRPATR"	, "CONTRPATR"	, "CONTRPATR", , aFields)

	// Detalle de conceptos para agrupar por Conceptos de Liquidación
	self:addNestedProperty("CONCEPTOS"	, "CONCEPTOS"	, "CONCEPTOS", , aFields)
	
	//Estructura de conceptos de Composición Salarial
	aFielCompS := {}

	aAdd(aFielCompS, {"AGRUP"	, STR0035	, "string"	, STR0035	}) // "Agrupador" - Codigo Reservado para impresión de Grafico
	aAdd(aFielCompS, {"RUBRO"	, STR0036	, "string"	, STR0036	}) // "Rubro"
	aAdd(aFielCompS, {"APOEMP"	, STR0037	, "number"	, STR0037	}) // "Apo. Empleador"
	aAdd(aFielCompS, {"CONEMP"	, STR0038	, "number"	, STR0038	}) // "Con. Empleado"
	aAdd(aFielCompS, {"TOTRUB"	, STR0039	, "number"	, STR0039	}) // "Total Rubro"
	aAdd(aFielCompS, {"TITRUB"	, STR0049	, "string"	, STR0049	}) // "Título Rubro"

	// Detalle de conceptos por Composición Salarial para impresión de pie de pagina
	self:addNestedProperty("COMPSAL"	, "COMPSAL"		, "COMPSAL", , aFielCompS)

	//Define los parámetros del informe
	self:oSchema:addParameter("PAR_FILIAL"	, STR0009		, "string"	, .T.) // "Sucursal"
	self:oSchema:addParameter("PAR_PROCES"	, STR0010		, "string"	, .F.) // "Proceso"
	self:oSchema:addParameter("PAR_PROCED"	, STR0011		, "string"	, .F.) // "Tipo Proced."
	self:oSchema:addParameter("PAR_PERIOD"	, STR0012		, "string"	, .F.) // "Periodo"
	self:oSchema:addParameter("PAR_NUMPAG"	, STR0013		, "string"	, .F.) // "Num. de Pago"
	self:oSchema:addParameter("PAR_CCOINI"	, STR0014		, "string"	, .F.) // "C. Costo Ini."
	self:oSchema:addParameter("PAR_CCOFIN"	, STR0015		, "string"	, .F.) // "C. Costo Fin."
	self:oSchema:addParameter("PAR_MATINI"	, STR0016 		, "string"	, .F.) // "Matricula Ini."
	self:oSchema:addParameter("PAR_MATFIN"	, STR0017 		, "string"	, .F.) // "Matricula Fin."
	self:oSchema:addParameter("PAR_SITUAC"	, STR0051 		, "string"	, .T.) // "Situaciones a Imp."
	self:oSchema:addParameter("PAR_CATEGO"	, STR0052 		, "string"	, .T.) // "Categorias a Imp."
	self:oSchema:addParameter("PAR_MENS01"	, STR0018		, "string"	, .F.) // "Mensaje 1"
	self:oSchema:addParameter("PAR_MENS02"	, STR0019		, "string"	, .F.) // "Mensaje 2"
	self:oSchema:addParameter("PAR_MENS03"	, STR0020		, "string"	, .F.) // "Mensaje 3"
	self:oSchema:addParameter("PAR_TPPAGO"	, STR0021		, "string"	, .F.) // "Tipo Pago"
	self:oSchema:addParameter("PAR_ORDEN"	, STR0022		, "string"	, .F.) // "Orden"

	// Consultas para parámetros
	self:setCustomURL("PAR_FILIAL"	, "/api/rh/smartview/v1/options/gper1160/Consulta/Sucursal"	, 2)
	self:setCustomURL("PAR_PROCES"	, "/api/framework/v1/genericLookupService/smartview/RCJ"	, 2)
	self:setCustomURL("PAR_PROCED"	, "/api/framework/v1/genericLookupService/smartview/SRY"	, 2)
	self:setCustomURL("PAR_PERIOD"	, "/api/framework/v1/genericQuery?tables=RCH&fields=rch_filial,rhc_proces,rch_per,rch_numpag,rch_roteir&Format=smartview&KeyProperty=rch_per"		, 2)
	self:setCustomURL("PAR_NUMPAG"	, "/api/framework/v1/genericQuery?tables=RCH&fields=rch_filial,rhc_proces,rch_per,rch_numpag,rch_roteir&Format=smartview&KeyProperty=rch_numpag"	, 2)
	self:setCustomURL("PAR_CCOINI"	, "/api/framework/v1/genericLookupService/smartview/CTT"	, 2)
	self:setCustomURL("PAR_CCOFIN"	, "/api/framework/v1/genericLookupService/smartview/CTT"	, 2)
	self:setCustomURL("PAR_MATINI"	, "/api/framework/v1/genericLookupService/smartview/SRA"	, 2)
	self:setCustomURL("PAR_MATFIN"	, "/api/framework/v1/genericLookupService/smartview/SRA"	, 2)
	self:setCustomURL("PAR_SITUAC"	, "/api/rh/smartview/v1/options/GPEParams/getSX5/31"		, 2)
    self:setCustomURL("PAR_CATEGO"	, "/api/rh/smartview/v1/options/GPEParams/getSX5/28"		, 2)
	self:setCustomURL("PAR_MENS01"	, "/api/rh/smartview/v1/options/gper1160/Consulta/RCC"		, 2)
	self:setCustomURL("PAR_MENS02"	, "/api/rh/smartview/v1/options/gper1160/Consulta/RCC"		, 2)
	self:setCustomURL("PAR_MENS03"	, "/api/rh/smartview/v1/options/gper1160/Consulta/RCC"		, 2)
	self:setCustomURL("PAR_TPPAGO"	, "/api/rh/smartview/v1/options/gper1160/PAR_TPPAGO"		, 1)
	self:setCustomURL("PAR_ORDEN"	, "/api/rh/smartview/v1/options/gper1160/PAR_ORDEN"			, 1)

Return (self:oSchema)

/*/{Protheus.doc} QryMovEmp
	Manejo de la consulta de movimientos de empleados
	@type  Static Function
	@author oscar.lopez
	@since 22/06/2026
	@version 1.0
	@param oQryEmp, objeto, Objeto para la consulta de movimientos de empleados
	@param cAlias, caracter, Alias de la tabla generada por la consulta de movimientos de empleados
	@param cTabSR, caracter, Tabla de movimientos de empleados (SRC o SRD)
	@param cAliasSR, caracter, Alias de la tabla de movimientos de empleados (SRC o SRD)
	@param cSucursal, caracter, Sucursal de la empresa para filtrar los movimientos de empleados
	@param jParams, json, Parámetros de filtro para la consulta de movimientos de empleados
	@param aCustField, array, Campos personalizados para la consulta de movimientos de empleados
	@return lRet, logico, Retorna .T.
	@example
		QryMovEmp(@oQryEmp, @cAlias, cTabSR, cAliasSR, cSucursal, jParams, aCustField)
/*/
Static Function QryMovEmp(oQryEmp, cAlias, cTabSR, cAliasSR, cSucursal, jParams, aCustField)

	Local lRet		:= .T.
	Local nParQry	:= 1
	Local cQuery	:= ""
	Local cProceso	:= ""
	Local cProcedim	:= ""
	Local cPeriodo	:= ""
	Local cSemana	:= ""
	Local cCCosIni	:= ""
	Local cCCosFin	:= ""
	Local cMatrIni	:= ""
	Local cMatrFin	:= ""
	Local cTipoPago	:= ""
	Local cOrden	:= ""
	Local cOrderBy	:= ""
	Local cCpoSRA	:= ""
	Local aSituacion:= {}
	Local aCategoria:= {}

	Default oQryEmp		:= Nil
	Default cAlias		:= ""
	Default cTabSR		:= ""
	Default cAliasSR	:= ""
	Default cSucursal	:= ""
	Default jParams		:= JsonObject():new()
	Default aCustField	:= {}

	cProceso	:= jParams["PAR_PROCES"][1]
	cProcedim	:= jParams["PAR_PROCED"][1]
	cPeriodo	:= jParams["PAR_PERIOD"][1]
	cSemana		:= jParams["PAR_NUMPAG"][1]
	cCCosIni	:= jParams["PAR_CCOINI"][1]
	cCCosFin	:= jParams["PAR_CCOFIN"][1]
	cMatrIni	:= jParams["PAR_MATINI"][1]
	cMatrFin	:= jParams["PAR_MATFIN"][1]
	aSituacion	:= jParams["PAR_SITUAC"]
	aCategoria	:= jParams["PAR_CATEGO"]
	cTipoPago	:= AllTrim(jParams["PAR_TPPAGO"][1])
	cOrden		:= AllTrim(jParams["PAR_ORDEN"][1])

	cCpoSRA		:= getCpoUser( aCustField, 'SRA', 'RA', ',' )

	Do Case
		Case cOrden == "1"
			cOrderBy += " SRA.RA_CC, "
		Case cOrden == "2"
			cOrderBy += " SRA.RA_CC, SRA.RA_NOME, "
		Case cOrden == "4"
			cOrderBy += " SRA.RA_NOME, "
	EndCase
	cOrderBy += " SRA.RA_MAT, SRV.RV_TIPOCOD, SRV.RV_IMPRIPD, SRV.RV_COD "

	cQuery := " SELECT " + cTabSR + "." + cAliasSR + "_HORAS HORAS, " + cTabSR + "." + cAliasSR + "_VALOR VALOR, "
	cQuery += " SRA.RA_MAT, SRA.RA_NOME, SRA.RA_CIC, SRA.RA_ADMISSA, SRA.RA_DEMISSA, SRA.RA_SALARIO, SRA.RA_CARGO, SRA.RA_CC, SRA.RA_BCDEPSA, SRA.RA_CTDEPSA, SRA.RA_DTREC, SRA.RA_MODALID, "
	cQuery += " SRA.RA_CODFUNC, SRA.RA_CATFUNC, SRA.RA_PRINOME, SRA.RA_SECNOME, SRA.RA_PRISOBR, SRA.RA_SECSOBR, SRA.RA_CFGOSOC, SRA.RA_OPCAO, "
	cQuery += " ? " // Campos Personalizados de SRA
	cQuery += " SRV.RV_COD, SRV.RV_COLIMP, SRV.RV_DESC, SRV.RV_DESCDET, SRV.RV_TIPOCOD, SRV.RV_CLASIF, SRV.RV_CODFOL, SRV.RV_IMPRIPD, "
	cQuery += " SQ3.Q3_DESCSUM, CTT.CTT_DESC01, SRJ.RJ_DESC "
	cQuery += " FROM ? " + cTabSR
	// Inner Join SRA - Empleados
	cQuery += " INNER JOIN ? SRA "
	cQuery += " ON " + cTabSR + "." + cAliasSR + "_FILIAL = SRA.RA_FILIAL "
	cQuery += " AND " + cTabSR + "." + cAliasSR + "_MAT = SRA.RA_MAT "
	If !Empty(aSituacion)
		cQuery += " AND SRA.RA_SITFOLH IN (?) "
	EndIf
	If !Empty(aCategoria)
		cQuery += " AND SRA.RA_CATFUNC IN (?) "
	EndIf
	cQuery += " AND SRA.D_E_L_E_T_ = ? "
	// Inner Join SRV - Conceptos
	cQuery += " INNER JOIN ? SRV "
	cQuery += " ON " + cTabSR + "." + cAliasSR + "_PD = SRV.RV_COD "
	cQuery += " AND SRV.RV_FILIAL = ? "
	cQuery += " AND SRV.D_E_L_E_T_ = ? "
	// LeftJoin SQ3 - Cargos
	cQuery += " LEFT JOIN ? SQ3 "
	cQuery += " ON SQ3.Q3_FILIAL = ? "
	cQuery += " AND SQ3.Q3_CARGO = SRA.RA_CARGO "
	cQuery += " AND SQ3.D_E_L_E_T_ = ? "
	// LeftJoin CTT - Centro de Costo
	cQuery += " LEFT JOIN ? CTT "
	cQuery += " ON CTT.CTT_FILIAL = ? "
	cQuery += " AND CTT.CTT_CUSTO = SRA.RA_CC "
	cQuery += " AND CTT.D_E_L_E_T_ = ? "
	// LeftJoin SRJ - Funciones
	cQuery += " LEFT JOIN ? SRJ "
	cQuery += " ON SRJ.RJ_FILIAL = ? "
	cQuery += " AND SRJ.RJ_FUNCAO = SRA.RA_CODFUNC "
	cQuery += " AND SRJ.D_E_L_E_T_ = ? "
	// Where
	cQuery += " WHERE " + cTabSR + "." + cAliasSR + "_FILIAL = ? "
	cQuery += " AND " + cTabSR + "." + cAliasSR + "_PROCES = ? "
	cQuery += " AND " + cTabSR + "." + cAliasSR + "_ROTEIR = ? "
	cQuery += " AND " + cTabSR + "." + cAliasSR + "_PERIODO = ? "
	cQuery += " AND " + cTabSR + "." + cAliasSR + "_SEMANA = ? "
	cQuery += " AND " + cTabSR + "." + cAliasSR + "_VALOR <> ? "
	cQuery += " AND SRA.RA_CC BETWEEN ? AND ? "
	cQuery += " AND " + cTabSR + "." + cAliasSR + "_MAT BETWEEN ? AND ? "
	cQuery += " AND " + cTabSR + ".D_E_L_E_T_ = ? "
	cQuery += " ORDER BY " + cOrderBy

	oQryEmp := FwExecStatement():New(cQuery)

	// Campos adicionales
	oQryEmp:SetUnsafe(nParQry++, cCpoSRA			)

	// From SRC/RD
	oQryEmp:SetUnsafe(nParQry++	, RetSqlName(cTabSR))

	// Join SRA
	oQryEmp:SetUnsafe(nParQry++	, RetSqlName("SRA")	)
	If !Empty(aSituacion)
		oQryEmp:SetIn(nParQry++	, aSituacion		)
	EndIf
	If !Empty(aCategoria)
		oQryEmp:SetIn(nParQry++	, aCategoria		)
	EndIf
	oQryEmp:SetString(nParQry++	, Space(1)			) // SRA.D_E_L_E_T_

	// Join SRV
	oQryEmp:SetUnsafe(nParQry++	, RetSqlName("SRV")	)
	oQryEmp:SetString(nParQry++	, FWxFilial("SRV", cSucursal))
	oQryEmp:SetString(nParQry++	, Space(1)			) // SRV.D_E_L_E_T_

	// Left Join SQ3
	oQryEmp:SetUnsafe(nParQry++	, RetSqlName("SQ3")	)
	oQryEmp:SetString(nParQry++	, FWxFilial("SQ3", cSucursal))
	oQryEmp:SetString(nParQry++	, Space(1)			) // SQ3.D_E_L_E_T_

	// Left Join CTT
	oQryEmp:SetUnsafe(nParQry++	, RetSqlName("CTT")	)
	oQryEmp:SetString(nParQry++	, FWxFilial("CTT", cSucursal))
	oQryEmp:SetString(nParQry++	, Space(1)			) // CTT.D_E_L_E_T_

	// Left Join SRJ
	oQryEmp:SetUnsafe(nParQry++	, RetSqlName("SRJ")	)
	oQryEmp:SetString(nParQry++	, FWxFilial("SRJ", cSucursal))
	oQryEmp:SetString(nParQry++	, Space(1)			) // SRJ.D_E_L_E_T_

	// Parámetros Where
	oQryEmp:SetString(nParQry++	, cSucursal	)
	oQryEmp:SetString(nParQry++	, cProceso	)
	oQryEmp:SetString(nParQry++	, cProcedim	)
	oQryEmp:SetString(nParQry++	, cPeriodo	)
	oQryEmp:SetString(nParQry++	, cSemana	)
	oQryEmp:setNumeric(nParQry++, 0			)
	oQryEmp:SetString(nParQry++	, cCCosIni	)
	oQryEmp:SetString(nParQry++	, cCCosFin	)
	oQryEmp:SetString(nParQry++	, cMatrIni	)
	oQryEmp:SetString(nParQry++	, cMatrFin	)
	oQryEmp:SetString(nParQry++	, Space(1)	) // cTabSR.D_E_L_E_T_

	cAlias := oQryEmp:OpenAlias()

Return lRet

/*/{Protheus.doc} InicDetCon
	Genera la estructura de los objetos anidados para Conceptos de Liquidación y Contribuciones Patronales
	@type  Static Function
	@author oscar.lopez
	@since 23/06/2026
	@version 1.0
	@param jItems, json, Objeto JSON donde se almacenarán los objetos anidados
	@return Nil
	@example
		InicDetCon(@self:jItems)
/*/
Static Function InicDetCon(jItems)

	Local nIteracion	:= 0
	Local aCodRubros	:= Array(7)

	Default jItems		:= JsonObject():New()

	// Se añaden los çodigos para agrupar, y los títulos de los rubros de Composición Salarial
	aCodRubros[1] := {"COSSIN"	, STR0043} // "Costo Sindical"
	aCodRubros[2] := {"SEGSOC"	, STR0044} // "Seguridad Social"
	aCodRubros[3] := {"OBRSOC"	, STR0045} // "Obra Social"
	aCodRubros[4] := {"INSSJP"	, STR0046} // "Costo INSSJP"
	aCodRubros[5] := {"ART"		, STR0047} // "Costo ART"
	aCodRubros[6] := {"SCVO"	, STR0048} // "Costo SCVO"
	aCodRubros[7] := {"SUENET"	, STR0050} // "Sueldo Neto"

	 // Inicializa los miembros de datos
	jItems["CONTRPATR"]	:= {}
	jItems["CONCEPTOS"]	:= {}
	jItems["COMPSAL"]	:= Array(Len(aCodRubros))

	For nIteracion := 1 To Len(aCodRubros)
		jItems["COMPSAL"][nIteracion] := {;
			"AGRUP": "CS",;
			"RUBRO": aCodRubros[nIteracion][1],;
			"APOEMP": 0,;
			"CONEMP": 0,;
			"TOTRUB": 0,;
			"TITRUB": aCodRubros[nIteracion][2];
		}
	Next nIteracion

Return Nil

/*/{Protheus.doc} fGetTitDsc
	Retorna título o descripcion del campo proporcionado
	@author oscar.lopez
	@since 15/04/2026
	@version 1.0
	@param nOpc, numero, Numero de opcion
	@param cCampo, string, Nombre de campo en SX3 a consultar
	@return cRet, string, Título o descripción del campo proporcionado
	/*/
Static Function fGetTitDsc(nOpc, cCampo)

	Local cRet := ""

	Default nOpc	:= 0
	Default cCampo	:= ""

	If nOpc == 1 //Título campo
		cRet := FWSX3Util():GetDescription(cCampo)
	Else //Descripción campo
		cRet := FWX3Titulo(cCampo)
	EndIf

Return cRet

/*/{Protheus.doc} fGetMejRCC
	Obtiene mensaje de tabla alfanumérica
	@type  Function
	@author oscar.lopez
	@since 15/04/2026
	@version 1.0
	@param cSeqMsj, caracter, Contenido a buscar en tabla alfanumerica
	@param cTabAlfa, caracter, Tabla alfanumérica a ser consultada
	@param nColPesq, numerico, Columna de la tabla alfanumérica donde se realizará la búsqueda
	@param nColRet, numerico, Columna de la tabla alfanumérica de donde se retornará el resultado
	@param cSucursal, caracter, Sucursal de la empresa para filtrar tabla alfanumérica
	@return cRet, caracter, Mensaje correspondiente a la secuencia ingresada
	@example
		cMensaje := fGetMejRCC(cSeqMsj, cTabAlfa, nColPesq, nColRet, cSucursal)
	/*/
Function fGetMejRCC(cSeqMsj, cTabAlfa, nColPesq, nColRet, cSucursal)

	Local cRet := ""
	Local nPos := 0

	Default cSeqMsj		:= ""
	Default cTabAlfa	:= ""
	Default nColPesq	:= 4
	Default nColRet		:= 5
	Default cSucursal	:= ""

	If !Empty(cSeqMsj)
		nPos := fPosTab(cTabAlfa, cSeqMsj , "==", nColPesq, , , , , , , , cSucursal)
		If nPos > 0
			cRet := AllTrim(fTabela(cTabAlfa, nPos, nColRet, , cSucursal))
		EndIf
	EndIf

Return cRet

/*/{Protheus.doc} GetContS53
	Obtiene la informacion de la tabla alfanumerica S053 para agrupar rubros y definir comportamiento de conceptos.
	@type  Static Function
	@author oscar.lopez
	@since 22/06/2026
	@version 1.0
	@param cSucursal, caracter, Sucursal de la empresa para filtrar tabla alfanumérica
	@param jConTabS53, json, Objeto JSON con contenido de tabla alfanumérica
	@return lRet, logico, Indica si se obtuvo información de la tabla alfanumérica
	@example
		lInfoS053 := GetContS53(cSucursal, @jConTabS53)
/*/
Static Function GetContS53(cSucursal, jConTabS53)

	// Declaración de variables
	Local aArea			:= GetArea()
	Local lRet			:= .F.
	Local cFilRCB		:= ""
	Local cFilRCC		:= ""
	Local cCampo		:= ""
	Local cCodCon		:= ""
	Local cCodTab		:= "S053"
	Local nPosCodCon	:= 0
	Local nPosTipo		:= 0
	Local nPosRubro		:= 0
	Local nIteracion	:= 0
	Local aEstrS053		:= {}
	Local cContenido	:= ""
	Local aInfo			:= {}

	// Inicialización de parámetros
	Default cSucursal   := ""
	Default jConTabS53  := JsonObject():New() // Objeto JSON con contenido de tabla alfanumérica

	// Obtiene la estructura de la tabla desde RCB
	cFilRCB := FWxFilial("RCB", cSucursal)

	If ObtEstrTab(aEstrS053, cSucursal, cCodTab)
		// Identifica las posiciones de los campos relevantes
		For nIteracion := 1 To Len(aEstrS053)
			cCampo := aEstrS053[nIteracion][1]
			Do Case
				Case cCampo == "CODCON"
					nPosCodCon := nIteracion
				Case cCampo == "TIPO"
					nPosTipo := nIteracion
				Case cCampo == "RUBRO"
					nPosRubro := nIteracion
			EndCase
		Next nIteracion

		// Validación de posiciones
		If nPosCodCon > 0 .And. nPosTipo > 0 .And. nPosRubro > 0
			// Lee los datos de la tabla RCC
			cFilRCC := FWxFilial("RCC", cSucursal)
			DbSelectArea("RCC")
			RCC->(DbSetOrder(1)) // RCC_FILIAL+RCC_CODIGO+RCC_FIL+RCC_CHAVE+RCC_SEQUEN
			If RCC->(MSSeek(cFilRCC + cCodTab))
				While cFilRCC == RCC->RCC_FILIAL .And. cCodTab == RCC->RCC_CODIGO
					// Obtiene el contenido de RCC_CONTEU
					aInfo := {}
					cContenido := RCC->RCC_CONTEU

					// Divide el contenido según la estructura
					For nIteracion := 1 To Len(aEstrS053)
						AAdd(aInfo, AllTrim(SubStr(cContenido, aEstrS053[nIteracion][2], aEstrS053[nIteracion][3])))
					Next nIteracion

					// Usa CODCON como clave en el JSON
					cCodCon := aInfo[nPosCodCon]
					If jConTabS53[cCodCon] == Nil
						jConTabS53[cCodCon] := JsonObject():New()
					EndIf

					// Almacena los valores en el JSON
					jConTabS53[cCodCon]["TIPO"] := aInfo[nPosTipo]
					jConTabS53[cCodCon]["RUBRO"] := aInfo[nPosRubro]

					RCC->(DbSkip())
				EndDo
				lRet := .T.
			EndIf
		EndIf
	EndIf
	// Limpieza de variables
	FWFreeArray(aEstrS053)
	RestArea(aArea)

Return lRet

/*/{Protheus.doc} ObtEstrTab
	Retorna la estructura de la tabla alfanumérica consultada desde RCB, incluyendo nombre de campo, 
	posición inicial y tamaño de cada campo.
	@type  Static Function
	@author oscar.lopez
	@since 25/06/2026
	@version 1.0
	@param cSucursal, caracter, Sucursal de la empresa para filtrar tabla alfanumérica
	@param cCodTab, caracter, Código de tabla alfanumérica a consultar
	@return lRet, logico, Indica si se obtuvo información de la tabla alfanumérica
	@example
		lEst := ObtEstrTab(aEstTab, cSucursal, cCodTab)
/*/
Static Function ObtEstrTab(aEstTab, cSucursal, cCodTab)

	Local aArea			:= GetArea()
	Local cFilRCB		:= ""
	Local cCampo		:= ""
	Local nPosIniRCC	:= 1
	Local lRet			:= .F.

	Default aEstTab		:= {}
	Default cSucursal	:= ""
	Default cCodTab		:= ""

	cFilRCB	:= FWxFilial("RCB", cSucursal)

	// Lee la estructura de la tabla desde RCB
	DbSelectArea("RCB")
	RCB->(DbSetOrder(1)) // RCB_FILIAL+RCB_CODIGO	
	If !Empty(cCodTab) .And. RCB->(MSSeek(cFilRCB + cCodTab))
		While cFilRCB == RCB->RCB_FILIAL .And. cCodTab == RCB->RCB_CODIGO
			cCampo := AllTrim(RCB->RCB_CAMPOS)
			AAdd(aEstTab, {cCampo, nPosIniRCC, RCB->RCB_TAMAN}) // Guarda nombre del campo, posición inicial y tamaño
			nPosIniRCC += RCB->RCB_TAMAN
			RCB->(DbSkip())
		EndDo
		lRet := .T.
	EndIf
	RestArea(aArea)

Return lRet

/*/{Protheus.doc} ProcesaCon
	Valida y procesa los conceptos de liquidación y contribuciones patronales, antes de almacenarlos en
	en el json de los miembros de datos
	@type  Static Function
	@author oscar.lopez
	@since 29/06/2026
	@version 1.0
	@param cAlias, caracter, Alias de la tabla generada por la consulta de movimientos de empleados
	@param jConTabS53, json, Objeto JSON con contenido de tabla alfanumérica S053
	@param jItems, json, Objeto JSON de los miembros de datos donde se almacenarán los conceptos procesados
	@param aConceptos, arreglo, Arreglo de conceptos de liquidación y contribuciones patronales
	@return Nil
	@example
		ProcesaCon(cAlias, jConTabS53, jItems, aConceptos)
/*/
Static Function ProcesaCon(cAlias, jConTabS53, jItems, aConceptos)

	Local lConcLiqui	:= .F.
	Local lContPatr		:= .F.
	Local cAgrupTot		:= "" // Total de Aporte, Exento o Descuento
	Local cCompSal		:= "" // Concepto del Empleado (CONEMP) o Aporte Empleador (APOEMP)
	Local nCodRubro		:= 0
	Local nSumaResta	:= 1
	Local nValorCon		:= 0
	Local nPos			:= 0
	Local nPosTipo		:= 0

	Do Case
		// Concepto de Contribución Patronal (Aporte Empleador)
		Case (cAlias)->RV_COLIMP == "4"
			lContPatr	:= .T.
			cCompSal	:= "APOEMP"
			nPosTipo	:= 4
		// Concepto de Liquidacion - Aporte
		Case (cAlias)->RV_COLIMP $ "1|2" .And. (cAlias)->RV_TIPOCOD == "1" .And. (cAlias)->RV_CLASIF != "N"
			lConcLiqui	:= .T.
			cAgrupTot	:= "TOTAPORTE"
			cCompSal	:= "CONEMP"
			nPosTipo	:= 1
		// Concepto de Liquidacion - Exento
		Case (cAlias)->RV_COLIMP $ "1|2" .And. (cAlias)->RV_TIPOCOD == "1" .And. (cAlias)->RV_CLASIF == "N"
			lConcLiqui	:= .T.
			cAgrupTot	:= "TOTEXENTO"
			cCompSal	:= "CONEMP"
			nPosTipo	:= 2
		// Concepto de Liquidacion - Descuento
		Case (cAlias)->RV_COLIMP == "3" .And. (cAlias)->RV_TIPOCOD == "2"
			lConcLiqui	:= .T.
			cAgrupTot	:= "TOTDESCUE"
			cCompSal	:= "CONEMP"
			nSumaResta	:= -1
			nPosTipo	:= 3
	EndCase

	If lConcLiqui .Or. lContPatr

		AAdd(aConceptos[nPosTipo], JsonObject():New())
		nPos := Len(aConceptos[nPosTipo])
		aConceptos[nPosTipo][nPos]["CODCON"]	:= (cAlias)->RV_COD
		aConceptos[nPosTipo][nPos]["TIPCOD"]	:= (cAlias)->RV_TIPOCOD
		aConceptos[nPosTipo][nPos]["DESCRI"]	:= (cAlias)->RV_DESC
		aConceptos[nPosTipo][nPos]["DESDET"]	:= (cAlias)->RV_DESCDET
		aConceptos[nPosTipo][nPos]["CODFOL"]	:= (cAlias)->RV_CODFOL
		aConceptos[nPosTipo][nPos]["CLASIF"]	:= (cAlias)->RV_CLASIF
		aConceptos[nPosTipo][nPos]["COLIMP"]	:= (cAlias)->RV_COLIMP
		aConceptos[nPosTipo][nPos]["HORAS"]		:= (cAlias)->HORAS
		aConceptos[nPosTipo][nPos]["VALOR"]		:= (cAlias)->VALOR
		aConceptos[nPosTipo][nPos]["TIPOVAL"]	:= ""
		aConceptos[nPosTipo][nPos]["BASECON"]	:= 0
		nValorCon := (cAlias)->VALOR

		If lConcLiqui
			// Asigna el valor del concepto como Aporte, Exento o Descuento
			jItems[cAgrupTot] += nValorCon
			jItems["TOTALNETO"] += (nValorCon * nSumaResta)
		ElseIf lContPatr
			jItems["COSTOTEMP"] += nValorCon
		EndIf

		// Si existe informacion en tabla alfanumerica para el concepto, se asigna el rubro y el valor de la contribución patronal
		If jConTabS53[(cAlias)->RV_COD] != Nil
			// El número grabado en Rubro de S053 es la posición del miembro de Composición Salarial ("COMPSAL")
			nCodRubro := Val(jConTabS53[(cAlias)->RV_COD]["RUBRO"])
			jItems["COMPSAL"][nCodRubro][cCompSal] += nValorCon
			jItems["COMPSAL"][nCodRubro]["TOTRUB"] += nValorCon
			aConceptos[nPosTipo][nPos]["BASECON"] := (cAlias)->VALOR

			// Si es por porcentaje (P), el valor base se calcula por regla de tres
			If jConTabS53[(cAlias)->RV_COD]["TIPO"] == "P" .And. (cAlias)->HORAS > 0
				aConceptos[nPosTipo][nPos]["TIPOVAL"] := "P"
				aConceptos[nPosTipo][nPos]["BASECON"] := (((cAlias)->VALOR * 100) / (cAlias)->HORAS)
			EndIf
		EndIf
	EndIf

Return Nil

/*/{Protheus.doc} InseDetCon
	Inserta los conceptos de liquidación y contribuciones patronales en el objeto JSON jItems, 
	respetando el límite de registros por tipo
	@type  Static Function
	@author oscar.lopez
	@since 29/06/2026
	@version 1.0
	@param jItems, json, Objeto JSON donde se almacenarán los miembros de datos
	@param aConceptos, arreglo, Arreglo de conceptos de liquidación y contribuciones patronales
	@return return_var, Nil
	@example
		InseDetCon(jItems, aConceptos)
/*/
Static Function InseDetCon(jItems, aConceptos)

	Local nIteraA	:= 0
	Local nIteraB	:= 0
	Local nTotItems	:= 0
	Local cTipoCont	:= "CONCEPTOS"
	
	Default jItems		:= JsonObject():New()
	Default aConceptos	:= {}

	// Reiniciamos los arreglos como vacíos para que crezcan sin límite
	jItems["CONCEPTOS"] := {}
	jItems["CONTRPATR"] := {}

	// Recorre los tipos de conceptos (Aporte, Exento, Descuento y Contribución Patronal)
	For nIteraA := 1 To 4
		If nIteraA == 4
			cTipoCont := "CONTRPATR"
		EndIf

		nTotItems := Len(aConceptos[nIteraA])

		For nIteraB := 1 To nTotItems
			aAdd(jItems[cTipoCont], aConceptos[nIteraA][nIteraB])
		Next nIteraB

	Next nIteraA
	
Return Nil
