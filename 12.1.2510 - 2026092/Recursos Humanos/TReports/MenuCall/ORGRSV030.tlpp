//-------------------------------------------------------------------
/*/{Protheus.doc} ORGRSV030

Chamada do objeto de negócios rh.treports.orgr030 e relatório no Smart View pela função totvs.framework.treports.callTReports  

@author  emerson.grassi
@since   29/09/2023
@version 1.0
/*/

Function ORGRSV030()

    Local lSuccess As logical
    Local oSmartView as object
    
    If GetRpoRelease() > "12.1.2210"

        oSmartView := totvs.framework.smartview.callSmartView():new("rh.sv.org.orgr030.default.rep", "report")
        oSmartView:setShowWizard(.T.)
        lSuccess := oSmartView:executeSmartView(.T.)
    
        If !lSuccess
            Conout(oSmartView:getError())
        EndIf  
    
        oSmartView:destroy()

    EndIf

Return
