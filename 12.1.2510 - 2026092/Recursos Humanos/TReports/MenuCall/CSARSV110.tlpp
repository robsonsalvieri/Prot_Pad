//-------------------------------------------------------------------
/*/{Protheus.doc} CSARSV110 - Relatorio de Funcionários - Descrição Detalhada Cargo

Chamada do objeto de negócios rh.treports.csar110 e relatório no Smart View pela função totvs.framework.treports.callTReports

@author  emerson.grassi
@since   25/09/2025
@version 1.0
/*/

Function CSARSV110()

    Local lSuccess As logical
    Local oSmartView as object
    
    If GetRpoRelease() > "12.1.2210"

        oSmartView := totvs.framework.smartview.callSmartView():new("rh.sv.csa.csar110.default.rep", "report")
        oSmartView:setShowWizard(.T.)
        lSuccess := oSmartView:executeSmartView(.T.)
    
        If !lSuccess
            Conout(oSmartView:getError())
        EndIf  
    
        oSmartView:destroy()

    EndIf

Return
