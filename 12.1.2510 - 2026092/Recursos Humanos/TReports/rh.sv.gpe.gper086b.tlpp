#Include "totvs.framework.treports.integratedprovider.th"
#Include "tlpp-core.th"
#Include "tlpp-rest.th"
#Include "rh.sv.gpe.gper086b.ch"

namespace totvs.protheus.rh.treportsintegratedprovider

/*/{Protheus.doc} GPER086BTReportsBusinessObject:new()
    Classe do objeto de negócio do Relatório de Incidências por Verba no Período (Horizontal).
    @type Class
    @version 12.1.2410
    @author guilherme.suttanni
    @since 25/09/2025
/*/
@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGAGPE", tables="SRA, RGB, SRV, SQB, CTT", customTables="SRA", name="Incidências por Verba no Período (Horizontal))", country="ALL", initialRelease="12.1.2310") // "Incidências por Verba no Período (Horizontal))"
Class GPER086BTReportsBusinessObject From totvs.framework.treports.integratedprovider.IntegratedProvider
    // Define os métodos da classe
    Public Method new()            As Object
    Public Method getDescription() As Character
    Public Method getData()        As Object
    Public Method getSchema()      As Object

    @Get("/api/rh/smartview/v1/options/GPER086B/:param")
    public method getComboBox() as Variant
EndClass

/*/{Protheus.doc} GPER086BTReportsBusinessObject:new()
    Instancia a classe do objeto de negócio.
    @type Method
    @version 12.1.2410
    @author guilherme.suttanni
    @since 25/09/2025
    @return Object, Instância do objeto de negócio
/*/
Method new() As Object Class GPER086BTReportsBusinessObject
    _Super:new()

    self:appendArea(STR0001) // "RH"

    self:setDisplayName(STR0002) // "Incidências por Verba no Período (Horizontal))"
Return self

/*/{Protheus.doc} GPER086BTReportsBusinessObject:getDescription()
    Retorna a descrição do objeto de negócio.
    @type Method
    @version 12.1.2410
    @author guilherme.suttanni
    @since 25/09/2025
    @return Character, Descrição do objeto de negócio
/*/
Method getDescription() As Character Class GPER086BTReportsBusinessObject
Return STR0003 // "Relatório de Incidências por Verba no Período (Horizontal))"

/*/{Protheus.doc} GPER086BTReportsBusinessObject:getData()
    Captura os dados do objeto de negócio.
    @type Method
    @version 12.1.2410
    @author guilherme.suttanni
    @since 25/09/2025
    @return Object, Dados do objeto de negócio
/*/
Method getData(nPage As Numeric, oFilter As Object) As Object Class GPER086BTReportsBusinessObject
    Local cQuery                As Character // Query do relatório
    Local cAlias                As Character // Alias do arquivo temporário
    Local cFiltro               As Character // Filtro do objeto de negócio
    Local JParams               As JSON      // Parâmetros do objeto de negócio
    Local cFilDe                As Character // Filial de
    Local cFilAte               As Character // Filial até
    Local cCCde                 As Character // Centro de custo de
    Local cCCAte                As Character // Centro de custo até
    Local cDeptoDe              As Character // Departamento de
    Local cDeptoAte             As Character // Departamento até
    Local cMatDe                As Character // Matrícula de
    Local cMatAte               As Character // Matrícula até
    Local cNomeDe               As Character // Nome de
    Local cNomeAte              As Character // Nome até
    Local aSituacoes            As Array     // Situações
    Local aCategorias           As Array     // Categorias
    Local cProcesso             As Character // Processo
    Local cRoteiro              As Character // Roteiro
    Local cPeriodo              As Character // Período
    Local cPagamento            As Character // Pagamento
    Local aVerbas               As Array     // Verbas
    Local lImpEmpr              As Logical   // Imprimir total empresa
    Local lVlDiaHor             As Logical   // Imprime Valor ou Horas/Dias
    Local lImpLinFun            As Logical   // Imprimir um funcionário por linha
    Local cCodVisao             As Character // Código da visão
    Local cDepVisao             As Character // Departamento da visão
    Local oStatement            As Object    // Objeto usado para utilização da classe FwExecStatement
    Local nParamOrder           As Numeric   // Contador de parâmetros da query
    Local jData                 As JSON      // Informações a serem adicionadas no ON
    Local lUsaArqui             As Logical   // Se usa Arquitetura Organizacional (SIGAORG)
    Local cOrdem                As Character // Ordem da query
    Local cSitQuery             As Character // Query das situações
    Local cCatQuery             As Character // Query das categorias
    Local nReg                  As Numeric   // Contador
    Local cCodPesq              As Character // Código de pesquisa
    Local nPosx                 As Numeric   // Posição
    Local aAuxCods              As Array     // Array auxiliar de códigos
    Local cUnion                As Character // União das queries das verbas
    Local cSum                  As Character // Campos de soma
    Local cDiasHor              As Character // Campos de dias/horas
    Local aQryVerba             As Array     // Array de verbas para query
    Local aVerQry               As Array     // Array de queries das verbas
    Local cVerQry0              As Character // Query base das verbas
    Local nCont                 As Numeric   // Contador
    Local cCellVerba            As Character // Célula da verba
    Local jEmployee             As JSON      // Funcionário
    Local cFilExec              As Character // Filial de execução
    Local cEmpExec              As Character // Empresa de execução
    Local cFilialAnt            As Character // Filial anterior
    Local cMatAnt               As Character // Matrícula anterior
    Local nTotalEmp             As Numeric   // Total do funcionário
    Local nValorVerba           As Numeric   // Valor da verba
    Local nTotalPos             As Numeric   // Posição do total
    Local nOrdem                As Numeric   // Ordem de impressão
    Local cOrderDesc            As Character // Descrição da ordem
    Local lUsaKeyLoc            As Logical   // Usa campo RA_KEYLOC
    Local lUsaRegPat            As Logical   // Usa campo RA_CODRPAT
    Local aChaveArq             As Array     // Chave da arquitetura
    Local cChaveArq             As Character // Chave da arquitetura organizacional
    Local cOrgJoin              As Character // Join da arquitetura organizacional
    Local lShar                 As Logical   // Compartilhamento

    // Inicialização das variáveis locais
    cQuery          := ""
    cAlias          := ""
    cFiltro         := IIf(oFilter:hasFilter(), " AND " + oFilter:getSQLExpression(), "")
    jParams         := oFilter:getParameters()
    cFilDe          := ""
    cFilAte         := ""
    cCCde           := ""
    cCCAte          := ""
    cDeptoDe        := ""
    cDeptoAte       := ""
    cMatDe          := ""
    cMatAte         := ""
    cNomeDe         := ""
    cNomeAte        := ""
    aSituacoes      := {}
    aCategorias     := {}
    cProcesso       := ""
    cRoteiro        := ""
    cPeriodo        := ""
    cPagamento      := ""
    aVerbas         := {}
    lImpEmpr        := .F.
    lVlDiaHor       := .F.
    lImpLinFun      := .F.
    cCodVisao       := ""
    cDepVisao       := ""
    oStatement      := NIL
    nParamOrder     := 1
    jData           := NIL
    lUsaArqui	    := Iif(SuperGetMv("MV_ORGCFG",,"0")=="0",.F.,.T.)  // 0-Nao utiliza	1-Utiliza Postos e Deptos	2-Utiliza so Deptos.
    cOrdem          := "TRB.RA_FILIAL, TRB.RA_MAT" // Ordem fixa por matrícula
    cSitQuery       := ""
    cCatQuery       := ""
    nReg            := 0
    cCodPesq        := ""
    nPosx           := 0
    aAuxCods        := {}
    cUnion          := ""
    cSum            := ""
    cDiasHor        := ""
    aQryVerba       := {}
    aVerQry         := {}
    cVerQry0        := ""
    nCont           := 0
    cCellVerba      := ""
    jEmployee       := NIL
    cFilialAnt      := ""
    cMatAnt         := ""
    cFilExec        := AllTrim(FwFilialName())
    cEmpExec        := AllTrim(FwEmpName(cEmpAnt))
    nOrdem          := 1
    cOrderDesc      := ""
    lUsaKeyLoc      := SRA->(FieldPos("RA_KEYLOC")) > 0
    lUsaRegPat      := SRA->(FieldPos("RA_CODRPAT")) > 0
    aChaveArq       := {"", ""}
    cChaveArq       := ""
    cOrgJoin        := ""
    lShar           := .T.

    BEGIN SEQUENCE

        // Captura o valor dos parâmetros
        If (jParams != NIL)
            cFilDe      := IIf(jParams:hasProperty("PAR_FILIALDE")      .and. Len(jParams["PAR_FILIALDE"])  > 0 .and.!Empty(jParams["PAR_FILIALDE"][1]),    jParams["PAR_FILIALDE"][1],     "")
            cFilAte     := IIf(jParams:hasProperty("PAR_FILIALATE")     .and. Len(jParams["PAR_FILIALATE"]) > 0 .and.!Empty(jParams["PAR_FILIALATE"][1]),   jParams["PAR_FILIALATE"][1],    Replicate("Z", GetSX3Cache("RA_FILIAL", "X3_TAMANHO")))
            cCCde       := IIf(jParams:hasProperty("PAR_CCDE")          .and. Len(jParams["PAR_CCDE"])      > 0 .and.!Empty(jParams["PAR_CCDE"][1]),        jParams["PAR_CCDE"][1],         "")
            cCCAte      := IIf(jParams:hasProperty("PAR_CCATE")         .and. Len(jParams["PAR_CCATE"])     > 0 .and.!Empty(jParams["PAR_CCATE"][1]),       jParams["PAR_CCATE"][1],        Replicate("Z", GetSX3Cache("RA_CC", "X3_TAMANHO")))
            cDeptoDe    := IIf(jParams:hasProperty("PAR_DEPTODE")       .and. Len(jParams["PAR_DEPTODE"])   > 0 .and.!Empty(jParams["PAR_DEPTODE"][1]),     jParams["PAR_DEPTODE"][1],      "")
            cDeptoAte   := IIf(jParams:hasProperty("PAR_DEPTOATE")      .and. Len(jParams["PAR_DEPTOATE"])  > 0 .and.!Empty(jParams["PAR_DEPTOATE"][1]),    jParams["PAR_DEPTOATE"][1],     Replicate("Z", GetSX3Cache("RA_DEPTO", "X3_TAMANHO")))
            cMatDe      := IIf(jParams:hasProperty("PAR_MATDE")         .and. Len(jParams["PAR_MATDE"])     > 0 .and.!Empty(jParams["PAR_MATDE"][1]),       jParams["PAR_MATDE"][1],        "")
            cMatAte     := IIf(jParams:hasProperty("PAR_MATATE")        .and. Len(jParams["PAR_MATATE"])    > 0 .and.!Empty(jParams["PAR_MATATE"][1]),      jParams["PAR_MATATE"][1],       Replicate("Z", GetSX3Cache("RA_MAT", "X3_TAMANHO")))
            cNomeDe     := IIf(jParams:hasProperty("PAR_NOMEDE")        .and. Len(jParams["PAR_NOMEDE"])    > 0 .and.!Empty(jParams["PAR_NOMEDE"][1]),      jParams["PAR_NOMEDE"][1],       "")
            cNomeAte    := IIf(jParams:hasProperty("PAR_NOMEATE")       .and. Len(jParams["PAR_NOMEATE"])   > 0 .and.!Empty(jParams["PAR_NOMEATE"][1]),     jParams["PAR_NOMEATE"][1],      Replicate("Z", GetSX3Cache("RA_NOME", "X3_TAMANHO")))
            aSituacoes  := IIf(jParams:hasProperty("PAR_SIT"),          jParams["PAR_SIT"], {})
            aCategorias := IIf(jParams:hasProperty("PAR_CAT"),          jParams["PAR_CAT"], {})
            cProcesso   := IIf(jParams:hasProperty("PAR_PROCESSO")      .and. Len(jParams["PAR_PROCESSO"])  > 0 .and.!Empty(jParams["PAR_PROCESSO"][1]),    jParams["PAR_PROCESSO"][1],     "")
            cRoteiro    := IIf(jParams:hasProperty("PAR_ROTEIRO")       .and. Len(jParams["PAR_ROTEIRO"])   > 0 .and.!Empty(jParams["PAR_ROTEIRO"][1]),     jParams["PAR_ROTEIRO"][1],      "")
            cPeriodo    := IIf(jParams:hasProperty("PAR_PERIODO")       .and. Len(jParams["PAR_PERIODO"])   > 0 .and.!Empty(jParams["PAR_PERIODO"][1]),     jParams["PAR_PERIODO"][1],      "")
            cPagamento  := IIf(jParams:hasProperty("PAR_PAGAMENTO")     .and. Len(jParams["PAR_PAGAMENTO"]) > 0 .and.!Empty(jParams["PAR_PAGAMENTO"][1]),   jParams["PAR_PAGAMENTO"][1],    "")
            aVerbas     := IIf(jParams:hasProperty("PAR_VERBAS"),       jParams["PAR_VERBAS"], {}) // Array de verbas para filtro
            lImpEmpr    := IIf(jParams:hasProperty("PAR_TOTALEMP")      .and. Len(jParams["PAR_TOTALEMP"])  > 0 .and.!Empty(jParams["PAR_TOTALEMP"][1]),    jParams["PAR_TOTALEMP"][1] == "1", .F.)
            lVlDiaHor   := IIf(jParams:hasProperty("PAR_VLDIHOR")       .and. Len(jParams["PAR_VLDIHOR"])   > 0 .and.!Empty(jParams["PAR_VLDIHOR"][1]),     jParams["PAR_VLDIHOR"][1] == "1", .F.)
            lImpLinFun  := IIf(jParams:hasProperty("PAR_IMPLINFUN")     .and. Len(jParams["PAR_IMPLINFUN"]) > 0 .and.!Empty(jParams["PAR_IMPLINFUN"][1]),   jParams["PAR_IMPLINFUN"][1] == "1", .F.) // Imprimir um funcionário por linha
            cCodVisao   := IIf(jParams:hasProperty("PAR_CODVISAO")      .and. Len(jParams["PAR_CODVISAO"])  > 0 .and.!Empty(jParams["PAR_CODVISAO"][1]),    jParams["PAR_CODVISAO"][1],     "")
            cDepVisao   := IIf(jParams:hasProperty("PAR_DEPVISAO")      .and. Len(jParams["PAR_DEPVISAO"])  > 0 .and.!Empty(jParams["PAR_DEPVISAO"][1]),    jParams["PAR_DEPVISAO"][1],     "")
            nOrdem      := IIf(jParams:hasProperty("PAR_ORDEM")         .and. Len(jParams["PAR_ORDEM"])     > 0 .and.!Empty(jParams["PAR_ORDEM"][1]),       Val(jParams["PAR_ORDEM"][1]),   1)
        EndIf

        // Verifica se os parâmetros obrigatórios foram preenchidos
        If (Empty(cProcesso) .or. Empty(cRoteiro) .or. Empty(cPeriodo))
            self:setErrorStatus(400, STR0004, STR0005) // "Atenção" | "Os parâmetros Processo, Roteiro e Período são obrigatórios."
            FwLogMsg("WARN", NIL, "SmartView", NIL, NIL, NIL, STR0005)
            BREAK
        EndIf

        // Verifica verbas selecionadas
        If Len(aVerbas) == 0
            self:setErrorStatus(400, STR0004, STR0006) // "Atenção" | "Nenhuma verba foi selecionada para impressão."
            FwLogMsg("WARN", NIL, "SmartView", NIL, NIL, NIL, STR0006)
            BREAK
        EndIf

        If Len(aVerbas) > 10
            self:setErrorStatus(400, STR0004, STR0007) // "Atenção" | "Máximo de verbas para impressão é 10. Selecione os códigos"
            FwLogMsg("WARN", NIL, "SmartView", NIL, NIL, NIL, STR0007)
            BREAK
        EndIf

        // Remove duplicatas das verbas
        For nReg := 1 to Len(aVerbas)
            cCodPesq := PadR(aVerbas[nReg], 3)
            nPosx := aScan(aAuxCods, {|x| x == cCodPesq})
            If nPosx == 0
                aAdd(aAuxCods, cCodPesq)
                aAdd(aQryVerba, AllTrim(cCodPesq))
            EndIf
        Next nReg

        // Define a ordem da query baseada na seleção
        Do Case
            Case nOrdem == 1 // Matrícula
                cOrdem := "TRB.RA_FILIAL, TRB.RA_MAT"
                cOrderDesc := "Matrícula"
                
            Case nOrdem == 2 // Nome  
                cOrdem := "TRB.RA_FILIAL, TRB.RA_NOME, TRB.RA_MAT"
                cOrderDesc := "Nome"
                
            Case nOrdem == 3 // C.Custo + Matrícula
                cOrdem := "TRB.RA_FILIAL, TRB.CCUSTO, TRB.RA_MAT"
                cOrderDesc := "C.Custo + Matrícula"
                
            Case nOrdem == 4 // C.Custo + Nome
                cOrdem := "TRB.RA_FILIAL, TRB.CCUSTO, TRB.RA_NOME, TRB.RA_MAT"
                cOrderDesc := "C.Custo + Nome"

            Case nOrdem == 5 // Depto + Matrícula
                cOrdem := "TRB.RA_FILIAL, TRB.RA_DEPTO, TRB.RA_MAT"
                cOrderDesc := "Depto + Matrícula"

            Case nOrdem == 6 // Depto + Nome
                cOrdem := "TRB.RA_FILIAL, TRB.RA_DEPTO, TRB.RA_NOME, TRB.RA_MAT"
                cOrderDesc := "Depto + Nome"

            Case nOrdem == 7 // C.Custo + Depto + Matrícula
                cOrdem := "TRB.RA_FILIAL, TRB.CCUSTO, TRB.RA_DEPTO, TRB.RA_MAT"
                cOrderDesc := "C.Custo + Depto + Matrícula"
                
            Case nOrdem == 8 // C.Custo + Depto + Nome
                cOrdem := "TRB.RA_FILIAL, TRB.CCUSTO, TRB.RA_DEPTO, TRB.RA_NOME"
                cOrderDesc := "C.Custo + Depto + Nome"
        EndCase

        // Implementa Arquitetura Organizacional se configurada
        If lUsaArqui .And. !Empty(cCodVisao) .And. !Empty(cDepVisao)
            aChaveArq := fQueryVisao(cCodVisao, cDepVisao)
            cChaveArq := aChaveArq[2]
            lShar     := Empty(aChaveArq[1])
            
            cOrgJoin := " INNER JOIN (SELECT RD4.RD4_FILIDE, RD4.RD4_CODIDE, RD4.RD4_CHAVE "
            cOrgJoin += " FROM " + RetSqlName("RD4") + " RD4 "
            
            cOrgJoin += " WHERE RD4_CODIDE >= ? AND RD4.D_E_L_E_T_ = ? ) TVRD4 "
            
            cOrgJoin += " ON TRB.RA_DEPTO = TVRD4.RD4_CODIDE "
            If !lShar
                cOrgJoin += " AND TRB.RA_FILIAL = TVRD4.RD4_FILIDE "
            EndIf
        EndIf

        // Monta as queries das verbas seguindo o padrão do GPER105
        cVerQry0 := "SELECT SRA.RA_FILIAL, SRA.RA_MAT, SRA.RA_CC, SRA.RA_NOME, SRA.RA_DEPTO, "
        cVerQry0 += "SRA.RA_SITFOLH, RGB.RGB_FILIAL FILIAL, RGB.RGB_MAT MAT, RGB.RGB_CC CCUSTO, "

        aVerQry := Array(Len(aQryVerba))
        For nReg := 1 to Len(aVerQry)
            aVerQry[nReg] := cVerQry0
        Next

        For nReg := 1 to Len(aQryVerba)
            cSum += Iif(Empty(cSum), "", ", ")
            cDiasHor += Iif(Empty(cDiasHor), "", ", ")
            cSum += " SUM(V" + aQryVerba[nReg] + ") V" + aQryVerba[nReg]
            cDiasHor += " SUM(H" + aQryVerba[nReg] + ") H" + aQryVerba[nReg]

            For nCont := 1 to Len(aVerQry)
                If nReg == nCont
                    aVerQry[nReg] += "RGB.RGB_HORAS H" + aQryVerba[nReg] + ", " + "RGB.RGB_VALOR V" + aQryVerba[nReg] + ", "
                Else
                    aVerQry[nCont] += "0 H" + aQryVerba[nReg] + ", " + "0 V" + aQryVerba[nReg] + ", "
                EndIf
            Next
        Next

        // Monta a UNION das queries
        cUnion := Iif(!Empty(aVerQry[1]), " (" + aVerQry[1] + " RGB.RGB_SEMANA SEMANA, RGB.RGB_PROCES PROCES, RGB.RGB_PERIOD PERIODO, RGB.RGB_ROTEIR ROTEIR, RGB.RGB_SEQ SEQ", "")
        cUnion += " FROM " + RetSqlName("SRA") + " SRA"
        cUnion += " INNER JOIN " + RetSqlName("RGB") + " RGB ON SRA.RA_FILIAL = RGB.RGB_FILIAL AND SRA.RA_MAT = RGB.RGB_MAT"
        cUnion += " WHERE SRA.RA_FILIAL BETWEEN ? AND ?"
        cUnion += "   AND SRA.RA_MAT BETWEEN ? AND ?"
        cUnion += "   AND SRA.RA_CC BETWEEN ? AND ?"
        cUnion += "   AND SRA.RA_DEPTO BETWEEN ? AND ?"
        cUnion += "   AND SRA.RA_NOME BETWEEN ? AND ?"

        // Adiciona filtros obrigatórios baseados na ordem selecionada
        If nOrdem == 3 .Or. nOrdem == 4 .Or. nOrdem == 7 .Or. nOrdem == 8 // Ordens que incluem Centro de Custo
            cUnion += "   AND SRA.RA_CC <> ? AND SRA.RA_CC IS NOT NULL"
        EndIf

        If nOrdem == 5 .Or. nOrdem == 6 .Or. nOrdem == 7 .Or. nOrdem == 8 // Ordens que incluem Departamento
            cUnion += "   AND SRA.RA_DEPTO <> ? AND SRA.RA_DEPTO IS NOT NULL"
        EndIf

        // Adiciona filtro de situação com parâmetros individuais
        If Len(aSituacoes) > 0
            cUnion += "   AND SRA.RA_SITFOLH IN (?) "
        EndIf

        // Adiciona filtro de categoria com parâmetros individuais
        If Len(aCategorias) > 0
            cUnion += "   AND SRA.RA_CATFUNC IN (?) "
        EndIf

        cUnion += "   AND RGB.RGB_PROCES = ?"
        cUnion += "   AND RGB.RGB_PERIOD = ?"
        cUnion += "   AND RGB.RGB_ROTEIR = ?"

        If !Empty(cPagamento)
            cUnion += "   AND RGB.RGB_SEMANA = ?"
        EndIf

        cUnion += "   AND RGB.RGB_PD = ?"
        cUnion += "   AND SRA.D_E_L_E_T_ = ? AND RGB.D_E_L_E_T_ = ?"

        For nCont := 2 to Len(aVerQry)
            cUnion += " UNION ALL " + aVerQry[nCont] + " RGB.RGB_SEMANA SEMANA, RGB.RGB_PROCES PROCES, RGB.RGB_PERIOD PERIODO, RGB.RGB_ROTEIR ROTEIR, RGB.RGB_SEQ SEQ"
            cUnion += " FROM " + RetSqlName("SRA") + " SRA"
            cUnion += " INNER JOIN " + RetSqlName("RGB") + " RGB ON SRA.RA_FILIAL = RGB.RGB_FILIAL AND SRA.RA_MAT = RGB.RGB_MAT"
            cUnion += " WHERE SRA.RA_FILIAL BETWEEN ? AND ?"
            cUnion += "   AND SRA.RA_MAT BETWEEN ? AND ?"
            cUnion += "   AND SRA.RA_CC BETWEEN ? AND ?"
            cUnion += "   AND SRA.RA_DEPTO BETWEEN ? AND ?"
            cUnion += "   AND SRA.RA_NOME BETWEEN ? AND ?"

            // Adiciona filtros obrigatórios baseados na ordem selecionada (repetido para cada UNION)
            If nOrdem == 3 .Or. nOrdem == 4 .Or. nOrdem == 7 .Or. nOrdem == 8 // Ordens que incluem Centro de Custo
                cUnion += "   AND SRA.RA_CC <> ? AND SRA.RA_CC IS NOT NULL"
            EndIf

            If nOrdem == 5 .Or. nOrdem == 6 .Or. nOrdem == 7 .Or. nOrdem == 8 // Ordens que incluem Departamento
                cUnion += "   AND SRA.RA_DEPTO <> ? AND SRA.RA_DEPTO IS NOT NULL"
            EndIf

            // Adiciona filtro de situação com parâmetros individuais (repetido para cada UNION)
            If Len(aSituacoes) > 0
                cUnion += "   AND SRA.RA_SITFOLH IN (?) "
            EndIf

            // Adiciona filtro de categoria com parâmetros individuais (repetido para cada UNION)
            If Len(aCategorias) > 0
                cUnion += "   AND SRA.RA_CATFUNC IN (?) "
            EndIf

            cUnion += "   AND RGB.RGB_PROCES = ?"
            cUnion += "   AND RGB.RGB_PERIOD = ?"
            cUnion += "   AND RGB.RGB_ROTEIR = ?"

            If !Empty(cPagamento)
                cUnion += "   AND RGB.RGB_SEMANA = ?"
            EndIf

            cUnion += "   AND RGB.RGB_PD = ?"
            cUnion += "   AND SRA.D_E_L_E_T_ = ? AND RGB.D_E_L_E_T_ = ?"
        Next

        cUnion += ") TRB"

        // Adiciona join da arquitetura organizacional se necessário
        If !Empty(cOrgJoin)
            cUnion += cOrgJoin
        EndIf

        // Montagem da query final
        cQuery := "SELECT TRB.RA_FILIAL, TRB.RA_MAT, TRB.RA_CC, TRB.RA_NOME, TRB.RA_DEPTO, TRB.RA_SITFOLH, TRB.FILIAL, "
        cQuery += "TRB.MAT, TRB.CCUSTO, " + cDiasHor + ", " + cSum + ", TRB.SEMANA, TRB.PROCES, TRB.PERIODO, TRB.ROTEIR "
        cQuery += "FROM " + cUnion
        cQuery += " GROUP BY TRB.RA_FILIAL, TRB.RA_MAT, TRB.RA_CC, TRB.RA_NOME, TRB.RA_DEPTO, TRB.RA_SITFOLH, TRB.FILIAL, "
        cQuery += "TRB.MAT, TRB.CCUSTO, TRB.SEMANA, TRB.PROCES, TRB.PERIODO, TRB.ROTEIR"
        cQuery += cFiltro
        cQuery += " ORDER BY " + cOrdem

        cQuery := ChangeQuery(cQuery)

        // Instancia a classe
        oStatement := FwExecStatement():New(cQuery)

        // Define o valor dos bind parameters para cada UNION
        For nCont := 1 To Len(aQryVerba)
            oStatement:SetString(nParamOrder++, cFilDe)
            oStatement:SetString(nParamOrder++, cFilAte)
            oStatement:SetString(nParamOrder++, cMatDe)
            oStatement:SetString(nParamOrder++, cMatAte)
            oStatement:SetString(nParamOrder++, cCCde)
            oStatement:SetString(nParamOrder++, cCCAte)
            oStatement:SetString(nParamOrder++, cDeptoDe)
            oStatement:SetString(nParamOrder++, cDeptoAte)
            oStatement:SetString(nParamOrder++, cNomeDe)
            oStatement:SetString(nParamOrder++, cNomeAte)
            
            // Adiciona parâmetros dos filtros condicionais de Centro de Custo
            If nOrdem == 3 .Or. nOrdem == 4 .Or. nOrdem == 7 .Or. nOrdem == 8
                oStatement:SetString(nParamOrder++, "")  // RA_CC <> ''
            EndIf
            
            // Adiciona parâmetros dos filtros condicionais de Departamento
            If nOrdem == 5 .Or. nOrdem == 6 .Or. nOrdem == 7 .Or. nOrdem == 8
                oStatement:SetString(nParamOrder++, "")  // RA_DEPTO <> ''
            EndIf
            
            // Adiciona parâmetros das situações
            If Len(aSituacoes) > 0
                oStatement:SetIN(nParamOrder++, aSituacoes)
            EndIf
            
            // Adiciona parâmetros das categorias
            If Len(aCategorias) > 0
                oStatement:SetIN(nParamOrder++, aCategorias)
            EndIf

            oStatement:SetString(nParamOrder++, cProcesso)
            oStatement:SetString(nParamOrder++, cPeriodo)
            oStatement:SetString(nParamOrder++, cRoteiro)

            If !Empty(cPagamento)
                oStatement:SetString(nParamOrder++, cPagamento)
            EndIf
            
            oStatement:SetString(nParamOrder++, aQryVerba[nCont])  // RGB_PD
            oStatement:SetString(nParamOrder++, " ")              // SRA.D_E_L_E_T_
            oStatement:SetString(nParamOrder++, " ")              // RGB.D_E_L_E_T_
        Next nCont

        // Adiciona parâmetros da arquitetura organizacional se usada
        If lUsaArqui .And. !Empty(cCodVisao) .And. !Empty(cDepVisao)
            oStatement:SetString(nParamOrder++, cDepVisao)  // RD4_CODIDE
            oStatement:SetString(nParamOrder++, " ")        // RD4.D_E_L_E_T_
        EndIf

        // Executa a query e retorna o alias criado
        cAlias := oStatement:OpenAlias()

        jData := JSONObject():New()
        jData["FilialExec"] := RTrim(cFilExec)                      // "Filial de Execução"
        jData["EmpresaExec"] := RTrim(cEmpExec)                     // "Empresa de Execução"
        jData["Process"] := cProcesso      // "Processo"           
        jData["Period"] := cPeriodo        // "Período"
        jData["Payment"] := cPagamento     // "Pagamento"
        jData["Script"] := cRoteiro        // "Roteiro"
        jData["PrintCompanyTotal"] := lImpEmpr // "Imprimir Total Empresa"
        jData["PrintValueOrHours"] := lVlDiaHor // "Imprimir Valor ou Horas/Dias"
        jData["PrintEmployeePerLine"] := lImpLinFun // "Imprimir Funcionário por Linha"
        jData["Order"] := cOrderDesc  // "Matrícula + Incidências"
        jData["Incidences"] := {}          // "Incidências"

        While (!(cAlias)->(EOF()))

            // Verifica se mudou funcionário
            If (cFilialAnt + cMatAnt) != ((cAlias)->RA_FILIAL + (cAlias)->RA_MAT)

                // Se não é o primeiro, adiciona o funcionário anterior
                If !Empty(cMatAnt)
                    AAdd(jData["Incidences"], jEmployee)
                EndIf

                // Reinicia variáveis
                cFilialAnt := (cAlias)->RA_FILIAL
                cMatAnt := (cAlias)->RA_MAT

                // Cria novo funcionário
                jEmployee := JSONObject():New()
                jEmployee["BranchCode"] := AllTrim((cAlias)->RA_FILIAL)              // "Filial"
                jEmployee["EmployeeCode"] := AllTrim((cAlias)->RA_MAT)               // "Matrícula"
                jEmployee["EmployeeName"] := AllTrim((cAlias)->RA_NOME)              // "Nome"
                jEmployee["CostCenter"] := AllTrim((cAlias)->RA_CC)                  // "Centro de Custo"
                jEmployee["Department"] := AllTrim((cAlias)->RA_DEPTO)               // "Departamento"
                
                // Inicializa as 10 verbas fixas
                jEmployee["PD01"] := 0     // "Verba 01"
                jEmployee["PD02"] := 0     // "Verba 02"
                jEmployee["PD03"] := 0     // "Verba 03"
                jEmployee["PD04"] := 0     // "Verba 04"
                jEmployee["PD05"] := 0     // "Verba 05"
                jEmployee["PD06"] := 0     // "Verba 06"
                jEmployee["PD07"] := 0     // "Verba 07"
                jEmployee["PD08"] := 0     // "Verba 08"
                jEmployee["PD09"] := 0     // "Verba 09"
                jEmployee["PD10"] := 0     // "Verba 10"
                
                // Códigos das verbas para referência
                jEmployee["PD01Code"] := IIf(Len(aQryVerba) >= 1, aQryVerba[1], "")     // "Código Verba 01"
                jEmployee["PD02Code"] := IIf(Len(aQryVerba) >= 2, aQryVerba[2], "")     // "Código Verba 02"
                jEmployee["PD03Code"] := IIf(Len(aQryVerba) >= 3, aQryVerba[3], "")     // "Código Verba 03"
                jEmployee["PD04Code"] := IIf(Len(aQryVerba) >= 4, aQryVerba[4], "")     // "Código Verba 04"
                jEmployee["PD05Code"] := IIf(Len(aQryVerba) >= 5, aQryVerba[5], "")     // "Código Verba 05"
                jEmployee["PD06Code"] := IIf(Len(aQryVerba) >= 6, aQryVerba[6], "")     // "Código Verba 06"
                jEmployee["PD07Code"] := IIf(Len(aQryVerba) >= 7, aQryVerba[7], "")     // "Código Verba 07"
                jEmployee["PD08Code"] := IIf(Len(aQryVerba) >= 8, aQryVerba[8], "")     // "Código Verba 08"
                jEmployee["PD09Code"] := IIf(Len(aQryVerba) >= 9, aQryVerba[9], "")     // "Código Verba 09"
                jEmployee["PD10Code"] := IIf(Len(aQryVerba) >= 10, aQryVerba[10], "")   // "Código Verba 10"

                // Descrições das verbas para referência
                jEmployee["PD01Desc"] := IIf(Len(aQryVerba) >= 1, Left(DescPd(aQryVerba[1], (cAlias)->RA_FILIAL, 20), 7), "")   // "Descrição Verba 01"
                jEmployee["PD02Desc"] := IIf(Len(aQryVerba) >= 2, Left(DescPd(aQryVerba[2], (cAlias)->RA_FILIAL, 20), 7), "")   // "Descrição Verba 02"
                jEmployee["PD03Desc"] := IIf(Len(aQryVerba) >= 3, Left(DescPd(aQryVerba[3], (cAlias)->RA_FILIAL, 20), 7), "")   // "Descrição Verba 03"
                jEmployee["PD04Desc"] := IIf(Len(aQryVerba) >= 4, Left(DescPd(aQryVerba[4], (cAlias)->RA_FILIAL, 20), 7), "")   // "Descrição Verba 04"
                jEmployee["PD05Desc"] := IIf(Len(aQryVerba) >= 5, Left(DescPd(aQryVerba[5], (cAlias)->RA_FILIAL, 20), 7), "")   // "Descrição Verba 05"
                jEmployee["PD06Desc"] := IIf(Len(aQryVerba) >= 6, Left(DescPd(aQryVerba[6], (cAlias)->RA_FILIAL, 20), 7), "")   // "Descrição Verba 06"
                jEmployee["PD07Desc"] := IIf(Len(aQryVerba) >= 7, Left(DescPd(aQryVerba[7], (cAlias)->RA_FILIAL, 20), 7), "")   // "Descrição Verba 07"
                jEmployee["PD08Desc"] := IIf(Len(aQryVerba) >= 8, Left(DescPd(aQryVerba[8], (cAlias)->RA_FILIAL, 20), 7), "")   // "Descrição Verba 08"
                jEmployee["PD09Desc"] := IIf(Len(aQryVerba) >= 9, Left(DescPd(aQryVerba[9], (cAlias)->RA_FILIAL, 20), 7), "")   // "Descrição Verba 09"
                jEmployee["PD10Desc"] := IIf(Len(aQryVerba) >= 10, Left(DescPd(aQryVerba[10], (cAlias)->RA_FILIAL, 20), 7), "") // "Descrição Verba 10"

                // Preenche os valores das verbas baseado no que foi retornado na query
                nTotalEmp := 0  // Variável para acumular o total
                For nCont := 1 To Len(aQryVerba)
                    cCellVerba := aQryVerba[nCont]
                    nPos := nCont
                    
                    If nPos >= 1 .AND. nPos <= 10
                        nValorVerba := 0
                        If !lVlDiaHor
                            // Valor
                            nValorVerba := (cAlias)->&("V" + cCellVerba)
                            jEmployee["PD" + StrZero(nPos, 2)] := nValorVerba
                        Else
                            // Horas/Dias
                            nValorVerba := (cAlias)->&("H" + cCellVerba)
                            jEmployee["PD" + StrZero(nPos, 2)] := nValorVerba
                        EndIf
                        
                        // Acumula no total do funcionário
                        nTotalEmp += nValorVerba
                    EndIf
                Next nCont
                
                // Define o total na próxima posição disponível (se não for 10 verbas)
                nTotalPos := Len(aQryVerba) + 1
                If nTotalPos <= 10
                    jEmployee["PD" + StrZero(nTotalPos, 2)] := nTotalEmp
                    jEmployee["PD" + StrZero(nTotalPos, 2) + "Code"] := "TOTAL"
                    jEmployee["PD" + StrZero(nTotalPos, 2) + "Desc"] := ""
                EndIf
            EndIf

            (cAlias)->(DBSkip())
        End

        // Adiciona o último funcionário se existir
        If !Empty(cMatAnt)
            AAdd(jData["Incidences"], jEmployee)
        EndIf

        // Adiciona as informações da linha
        self:oData:appendData(jData)

    END SEQUENCE

    // Fecha a área da tabela temporária
    If !Empty(cAlias)
        (cAlias)->(DBCloseArea())
    Endif

    // Limpa os objetos da memória
    FwFreeObj(jParams)
    FwFreeObj(oStatement)
    FwFreeArray(aSituacoes)
    FwFreeArray(aCategorias)
    FwFreeArray(aVerbas)
    FwFreeArray(aAuxCods)
    FwFreeArray(aQryVerba)
    FwFreeArray(aVerQry)

Return self:oData

/*/{Protheus.doc} fQueryVisao
    Pesquisa Visão / Departamento para a Arquitetura Organizacional
    @type Static Function
    @author guilherme.suttanni
    @since 25/09/2025
    @param cCodVisao, Character, Código da visão
    @param cCodDepto, Character, Código do departamento
    @return Array, [1] - Filial, [2] - Chave
/*/
Static Function fQueryVisao(cCodVisao, cCodDepto)
    Local aArea         := GetArea()
    Local aChave        := {"", ""}
    Local cQuery        := ""
    Local cQryAlias     := ""
    Local oStatement    := NIL
    Local nParamOrder   := 1

    cQuery := "SELECT RD4.RD4_CHAVE, RD4.RD4_FILIDE FROM " + RetSqlName("RD4") + " RD4 "
    cQuery += "INNER JOIN " + RetSqlName("RDK") + " RDK "
    cQuery += "ON RD4_CODIGO = RDK_CODIGO AND RD4_FILIAL = RDK_FILIAL "
    cQuery += "WHERE RD4_CODIDE = ? AND RDK_HIERAR = ? AND RDK_CODIGO = ? "
    cQuery += "AND RD4.D_E_L_E_T_ = ? AND RDK.D_E_L_E_T_ = ? "
    cQuery := ChangeQuery(cQuery)

    // Instancia a classe FwExecStatement
    oStatement := FwExecStatement():New(cQuery)

    // Define o valor dos bind parameters
    oStatement:SetString(nParamOrder++, cCodDepto)  // RD4_CODIDE
    oStatement:SetString(nParamOrder++, "1")        // RDK_HIERAR
    oStatement:SetString(nParamOrder++, cCodVisao)  // RDK_CODIGO
    oStatement:SetString(nParamOrder++, " ")        // RD4.D_E_L_E_T_
    oStatement:SetString(nParamOrder++, " ")        // RDK.D_E_L_E_T_

    // Executa a query e retorna o alias criado
    cQryAlias := oStatement:OpenAlias()

    If !(cQryAlias)->(EOF())
        aChave[1] := (cQryAlias)->RD4_FILIDE
        aChave[2] := (cQryAlias)->RD4_CHAVE
    EndIf

    // Fecha a área da query
    If !Empty(cQryAlias)
        (cQryAlias)->(DbCloseArea())
    EndIf

    // Limpa o objeto da memória
    FwFreeObj(oStatement)
    
    RestArea(aArea)

Return aChave

/*/{Protheus.doc} GPER086BTReportsBusinessObject:getSchema()
    Define o schema do objeto de negócio.
    @type Method
    @version 12.1.2410
    @author guilherme.suttanni
    @since 25/09/2025
    @return Object, Schema do objeto de negócio
/*/
Method getSchema() As Object Class GPER086BTReportsBusinessObject
    Local aIncidenceFields as Array

    // Define os parâmetros do relatório
    self:oSchema:addParameter("PAR_PROCESSO",   STR0010,    "string", .F.)        // "Processo"
    self:oSchema:addParameter("PAR_ROTEIRO",    STR0013,    "string", .F.)        // "Roteiro"
    self:oSchema:addParameter("PAR_PERIODO",    STR0011,    "string", .F.)        // "Período"
    self:oSchema:addParameter("PAR_FILIALDE",   STR0056,    "string", .F.)        // "Filial de"
    self:oSchema:addParameter("PAR_FILIALATE",  STR0057,    "string", .F.)        // "Filial até"
    self:oSchema:addParameter("PAR_CCDE",       STR0058,    "string", .F.)        // "Centro de Custo de"
    self:oSchema:addParameter("PAR_CCATE",      STR0059,    "string", .F.)        // "Centro de Custo até"
    self:oSchema:addParameter("PAR_DEPTODE",    STR0060,    "string", .F.)        // "Departamento de"
    self:oSchema:addParameter("PAR_DEPTOATE",   STR0061,    "string", .F.)        // "Departamento até"
    self:oSchema:addParameter("PAR_MATDE",      STR0062,    "string", .F.)        // "Matrícula de"
    self:oSchema:addParameter("PAR_MATATE",     STR0063,    "string", .F.)        // "Matrícula até"
    self:oSchema:addParameter("PAR_NOMEDE",     STR0064,    "string", .F.)        // "Nome de"
    self:oSchema:addParameter("PAR_NOMEATE",    STR0065,    "string", .F.)        // "Nome até"
    self:oSchema:addParameter("PAR_SIT",        STR0066,    "string", .T.)        // "Situações"
    self:oSchema:addParameter("PAR_CAT",        STR0067,    "string", .T.)        // "Categorias"
    self:oSchema:addParameter("PAR_PAGAMENTO",  STR0012,    "string", .F.)        // "Pagamento"
    self:oSchema:addParameter("PAR_VERBAS",     STR0068,    "string", .T.)        // "Verbas"
    self:oSchema:addParameter("PAR_TOTALEMP",   STR0069,    "string", .F.)        // "Lista Total Empresa"
    self:oSchema:addParameter("PAR_VLDIHOR",    STR0016,    "string", .F.)        // "Imprime Valor ou Horas/Dias"
    self:oSchema:addParameter("PAR_IMPLINFUN",  STR0018,    "string", .F.)        // "Funcionário por Linha"
    self:oSchema:addParameter("PAR_CODVISAO",   STR0070,    "string", .F.)        // "Código da Visão"
    self:oSchema:addParameter("PAR_DEPVISAO",   STR0071,    "string", .F.)        // "Dept. por Visões"
    self:oSchema:addParameter("PAR_ORDEM",      STR0019,    "string", .F.)        // "Ordem"

    // Define endpoints dos parâmetros de tipo lookup/combobox
    self:setCustomURL("PAR_PROCESSO",   "/api/framework/v1/genericLookupService/smartview/RCJ",     2)
    self:setCustomURL("PAR_ROTEIRO",    "/api/framework/v1/genericLookupService/smartview/SRY",     2)
    self:setCustomURL("PAR_PERIODO",    "/api/framework/v1/genericLookupService/smartview/RCH08",   2)
    self:setCustomURL("PAR_FILIALDE",   "/api/rh/smartview/v1/options/GPEParams/getBranches",       2)
    self:setCustomURL("PAR_FILIALATE",  "/api/rh/smartview/v1/options/GPEParams/getBranches",       2)
    self:setCustomURL("PAR_CCDE",       "/api/framework/v1/genericLookupService/smartview/CTT",     2)
    self:setCustomURL("PAR_CCATE",      "/api/framework/v1/genericLookupService/smartview/CTT",     2)
    self:setCustomURL("PAR_DEPTODE",    "/api/framework/v1/genericLookupService/smartview/SQB",     2)
    self:setCustomURL("PAR_DEPTOATE",   "/api/framework/v1/genericLookupService/smartview/SQB",     2)
    self:setCustomURL("PAR_MATDE",      "/api/framework/v1/genericLookupService/smartview/SRA",     2)
    self:setCustomURL("PAR_MATATE",     "/api/framework/v1/genericLookupService/smartview/SRA",     2)
    self:setCustomURL("PAR_SIT",        "/api/rh/smartview/v1/options/GPEParams/getSX5/31",         2)
    self:setCustomURL("PAR_CAT",        "/api/rh/smartview/v1/options/GPEParams/getSX5/28",         2)
    self:setCustomURL("PAR_VERBAS",     "/api/framework/v1/genericLookupService/smartview/SRV",     2)
    self:setCustomURL("PAR_TOTALEMP",   "/api/rh/smartview/v1/options/GPEParams/getSNOptions",      1)
    self:setCustomURL("PAR_VLDIHOR",    "/api/rh/smartview/v1/options/GPER086B/getVlDiHorOptions",  1)
    self:setCustomURL("PAR_IMPLINFUN",  "/api/rh/smartview/v1/options/GPEParams/getSNOptions",      1)
    self:setCustomURL("PAR_CODVISAO",   "/api/framework/v1/genericLookupService/smartview/RDK",     2)
    self:setCustomURL("PAR_DEPVISAO",   "/api/framework/v1/genericLookupService/smartview/RD4",     2)
    self:setCustomURL("PAR_ORDEM",      "/api/rh/smartview/v1/options/GPER086B/getOrders",          1)

    // Propriedades principais do objeto
    self:oSchema:addProperty("FilialExec",          STR0008,    "string",   STR0008)        // "Filial de Execução"
    self:oSchema:addProperty("EmpresaExec",         STR0009,    "string",   STR0009)        // "Empresa de Execução"
    self:oSchema:addProperty("Process",             STR0010,    "string",   STR0010)        // "Processo"
    self:oSchema:addProperty("Period",              STR0011,    "string",   STR0011)        // "Período"
    self:oSchema:addProperty("Payment",             STR0012,    "string",   STR0012)        // "Pagamento"
    self:oSchema:addProperty("Script",              STR0013,    "string",   STR0013)        // "Roteiro"
    self:oSchema:addProperty("PrintCompanyTotal",   STR0015,    "boolean",  STR0014)        // "Imprimir Total Empresa"
    self:oSchema:addProperty("PrintValueOrHours",   STR0017,    "boolean",  STR0016)        // "Imprimir Valor ou H/D"
    self:oSchema:addProperty("PrintEmployeePerLine", STR0018,   "boolean",  STR0018)        // "Funcionário por Linha"
    self:oSchema:addProperty("Order",               STR0019,    "string",   STR0019)        // "Ordem"

    // Estrutura das incidências - agora sem TotalEmployee fixo
    aIncidenceFields := {}
    AAdd(aIncidenceFields, {"BranchCode",       STR0020,    "string", STR0020})           // "Filial"
    AAdd(aIncidenceFields, {"EmployeeCode",     STR0021,    "string", STR0021})           // "Matrícula"
    AAdd(aIncidenceFields, {"EmployeeName",     STR0022,    "string", STR0022})           // "Nome"
    AAdd(aIncidenceFields, {"CostCenter",       STR0023,    "string", STR0023})           // "Centro de Custo"
    AAdd(aIncidenceFields, {"Department",       STR0024,    "string", STR0024})           // "Departamento"
    
    // Verbas fixas (valores) - sempre 10 posições
    AAdd(aIncidenceFields, {"PD01",             STR0026,    "number", STR0026})           // "Verba 01"
    AAdd(aIncidenceFields, {"PD02",             STR0027,    "number", STR0027})           // "Verba 02"
    AAdd(aIncidenceFields, {"PD03",             STR0028,    "number", STR0028})           // "Verba 03"
    AAdd(aIncidenceFields, {"PD04",             STR0029,    "number", STR0029})           // "Verba 04"
    AAdd(aIncidenceFields, {"PD05",             STR0030,    "number", STR0030})           // "Verba 05"
    AAdd(aIncidenceFields, {"PD06",             STR0031,    "number", STR0031})           // "Verba 06"
    AAdd(aIncidenceFields, {"PD07",             STR0032,    "number", STR0032})           // "Verba 07"
    AAdd(aIncidenceFields, {"PD08",             STR0033,    "number", STR0033})           // "Verba 08"
    AAdd(aIncidenceFields, {"PD09",             STR0034,    "number", STR0034})           // "Verba 09"
    AAdd(aIncidenceFields, {"PD10",             STR0035,    "number", STR0035})           // "Verba 10"
    
    // Códigos das verbas (para referência)
    AAdd(aIncidenceFields, {"PD01Code",         STR0036,    "string", STR0036})           // "Código Verba 01"
    AAdd(aIncidenceFields, {"PD02Code",         STR0037,    "string", STR0037})           // "Código Verba 02"
    AAdd(aIncidenceFields, {"PD03Code",         STR0038,    "string", STR0038})           // "Código Verba 03"
    AAdd(aIncidenceFields, {"PD04Code",         STR0039,    "string", STR0039})           // "Código Verba 04"
    AAdd(aIncidenceFields, {"PD05Code",         STR0040,    "string", STR0040})           // "Código Verba 05"
    AAdd(aIncidenceFields, {"PD06Code",         STR0041,    "string", STR0041})           // "Código Verba 06"
    AAdd(aIncidenceFields, {"PD07Code",         STR0042,    "string", STR0042})           // "Código Verba 07"
    AAdd(aIncidenceFields, {"PD08Code",         STR0043,    "string", STR0043})           // "Código Verba 08"
    AAdd(aIncidenceFields, {"PD09Code",         STR0044,    "string", STR0044})           // "Código Verba 09"
    AAdd(aIncidenceFields, {"PD10Code",         STR0045,    "string", STR0045})           // "Código Verba 10"
    
    // Descrições das verbas (para referência)
    AAdd(aIncidenceFields, {"PD01Desc",         STR0046,    "string", STR0046})           // "Descrição Verba 01"
    AAdd(aIncidenceFields, {"PD02Desc",         STR0047,    "string", STR0047})           // "Descrição Verba 02"
    AAdd(aIncidenceFields, {"PD03Desc",         STR0048,    "string", STR0048})           // "Descrição Verba 03"
    AAdd(aIncidenceFields, {"PD04Desc",         STR0049,    "string", STR0049})           // "Descrição Verba 04"
    AAdd(aIncidenceFields, {"PD05Desc",         STR0050,    "string", STR0050})           // "Descrição Verba 05"
    AAdd(aIncidenceFields, {"PD06Desc",         STR0051,    "string", STR0051})           // "Descrição Verba 06"
    AAdd(aIncidenceFields, {"PD07Desc",         STR0052,    "string", STR0052})           // "Descrição Verba 07"
    AAdd(aIncidenceFields, {"PD08Desc",         STR0053,    "string", STR0053})           // "Descrição Verba 08"
    AAdd(aIncidenceFields, {"PD09Desc",         STR0054,    "string", STR0054})           // "Descrição Verba 09"
    AAdd(aIncidenceFields, {"PD10Desc",         STR0055,    "string", STR0055})           // "Descrição Verba 10"

    // Define a propriedade principal como nested (array de funcionários)
    self:addNestedProperty("Incidences", STR0025, STR0025, NIL, aIncidenceFields)        // "Incidências"

Return self:oSchema


/*/{Protheus.doc} GPER086BTReportsBusinessObject::getComboBox
    Retorna os valores de ComboBox do parâmetro requisitado.
    @type Method
    @version 12.1.2410
    @author guilherme.suttanni
    @since 29/09/2025
    @return Variant, Retorno nulo pré-fixado
    @obs Path parameters: param (nome do parâmetro solicitado)
/*/
Method getComboBox() As Variant Class GPER086BTReportsBusinessObject
    // Declaração das variáveis locais
    Local jPath     As JSON    // Path parameters da requisição
    Local jResponse As JSON    // Resposta da requisição
    Local jItem     As JSON    // Item do valor do parâmetro
    Local nValues   As Numeric // Contador dos valores do parâmetro
    Local aValues   As Array   // Valores do parâmetro
    Local cParam    As Character // Parâmetro requisitado
    Local aOrdens   As Array   // Array com as ordens disponíveis
    Local nX        As Numeric // Contador
    Local lUsaKeyLoc As Logical // Usa campo RA_KEYLOC
    Local lUsaRegPat As Logical // Usa campo RA_CODRPAT

    // Inicialização das variáveis
    jPath     := oRest:getPathParamsRequest()
    jResponse := JSONObject():New()
    jItem     := NIL
    nValues   := 0
    aValues   := {}
    aOrdens   := {}
    nX        := 0
    cParam    := ""
    lUsaKeyLoc := SRA->(FieldPos("RA_KEYLOC")) > 0
    lUsaRegPat := SRA->(FieldPos("RA_CODRPAT")) > 0

    // Captura os path parameters da requisição
    If (jPath != NIL)
        cParam := jPath["param"]
    EndIf

    // Cria o atributo data e nextPageUrl no JSON de resposta
    jResponse["data"]        := {}
    jResponse["nextPageUrl"] := NIL

    // Verifica qual parâmetro foi solicitado
    Do Case
        Case cParam == "getVlDiHorOptions"
            // Valor ou Horas/Dias - baseado no GPER105 original
            AAdd(aValues, STR0072)  // "Horas/Dias"
            AAdd(aValues, STR0073)  // "Valor"
            
            // Para parâmetros que usam aValues 
            If (Len(aValues) > 0)
                // Percorre os valores adicionando cada item no JSON de resposta
                For nValues := 1 To Len(aValues)
                    jItem := {;
                        "key":   CValToChar(nValues),;
                        "label": aValues[nValues];
                    }
                    AAdd(jResponse["data"], jItem)
                Next nValues
            EndIf
            
        Case cParam == "getOrders"
            // Monta array com todas as ordens (baseado no GPER105)
            AAdd(aOrdens, {"1", STR0021})  // "Matrícula"
            AAdd(aOrdens, {"2", STR0022})  // "Nome"
            AAdd(aOrdens, {"3", STR0074})  // "C.Custo + Matrícula"
            AAdd(aOrdens, {"4", STR0075})  // "C.Custo + Nome"
            AAdd(aOrdens, {"5", STR0076})  // "Depto + Matrícula"
            AAdd(aOrdens, {"6", STR0077})  // "Depto + Nome"
            AAdd(aOrdens, {"7", STR0078})  // "C.Custo + Depto + Matrícula"
            AAdd(aOrdens, {"8", STR0079})  // "C.Custo + Depto + Nome"

            // Percorre o array de ordens e adiciona cada item no JSON de resposta
            For nX := 1 To Len(aOrdens)
                jItem := {;
                    "key":   aOrdens[nX][1],;
                    "label": FwHTTPEncode(aOrdens[nX][2]);
                }
                AAdd(jResponse["data"], jItem)
            Next nX
    EndCase
    
    oRest:setResponse(jResponse)
    oRest:setStatusCode(200)
    oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")
    oRest:setKeyHeaderResponse("Accept-Encoding", "UTF-8")

    FwFreeObj(jPath)
    FwFreeObj(jResponse)
    FwFreeObj(jItem)
    FwFreeArray(aValues)
    FwFreeArray(aOrdens)
Return NIL
