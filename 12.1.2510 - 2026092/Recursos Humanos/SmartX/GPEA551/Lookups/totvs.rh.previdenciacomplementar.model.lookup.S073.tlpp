namespace totvs.rh.previdenciacomplementar.model.lookup

@totvsFrameworkStructureModel(lookup=.T., country="ALL", description="Tabela S073 - Fornecedores")

class S073 from totvs.framework.structure.model.data
    public method new() as object
    public method setModel()
EndClass

Method new() as object class S073
    _Super:new(,,.T.)
Return self

/*/{Protheus.doc} setModel
Definicao do modelo de dados para Tabela S073 - Fornecedores

@type method

@author  guilherme.suttanni
@since   15/01/2026
@version P12
/*/
method setModel() class S073
    Local oHeader  as Object
    Local oArray   as Object
    Local oField   as Object
    Local oIndex   as Object
    Local oFinder  as Object

    oHeader := totvs.framework.structure.object.BuildFromCode():new("XTX")

    // Campo Sequencia
    oField := totvs.framework.structure.object.BuildFieldProperties():new("XTX_SEQ")
    oField:setType("C")
    oField:setTitle(STR0002) // Sequencia
    oField:setDescription(STR0003) // Sequencia do Registro
    oField:setSize(3)
    oField:setOrder(1)
    oField:setRequired(.T.)
    oField:setUpperCase(.T.)
    oHeader:addFieldProperties(oField:getFieldProperties())

    // Campo Codigo
    oField := totvs.framework.structure.object.BuildFieldProperties():new("XTX_COD")
    oField:setType("C")
    oField:setTitle(STR0004) // Codigo
    oField:setDescription(STR0005) // Codigo do Fornecedor
    oField:setSize(2)
    oField:setOrder(2)
    oField:setRequired(.T.)
    oField:setUpperCase(.T.)
    oHeader:addFieldProperties(oField:getFieldProperties())

    // Campo CNPJ
    oField := totvs.framework.structure.object.BuildFieldProperties():new("XTX_CNPJ")
    oField:setType("C")
    oField:setTitle(STR0006) // CNPJ
    oField:setDescription(STR0007) // CNPJ do Fornecedor
    oField:setSize(14)
    oField:setOrder(3)
    oField:setRequired(.F.)
    oField:setUpperCase(.T.)
    oHeader:addFieldProperties(oField:getFieldProperties())

    // Campo Nome Empresarial
    oField := totvs.framework.structure.object.BuildFieldProperties():new("XTX_NOME")
    oField:setType("C")
    oField:setTitle(STR0008) // Nome Empresarial
    oField:setDescription(STR0009) // Nome Empresarial do Fornecedor
    oField:setSize(150)
    oField:setOrder(4)
    oField:setRequired(.T.)
    oField:setUpperCase(.T.)
    oHeader:addFieldProperties(oField:getFieldProperties())

    // Campo Tabela (oculto)
    oField := totvs.framework.structure.object.BuildFieldProperties():new("XTX_TAB")
    oField:setType("C")
    oField:setTitle(STR0010) // Tabela
    oField:setDescription(STR0010) // Tabela
    oField:setSize(4)
    oField:setOrder(5)
    oField:setRequired(.T.)
    oField:setUpperCase(.T.)
    oField:setInUse(.F.)
    oHeader:addFieldProperties(oField:getFieldProperties())

    oHeader:setTitle(STR0001) // Tabela S073 - Fornecedores

    oIndex := totvs.framework.structure.object.BuildIndex():new("XTX" + cEmpAnt + "0")
    oIndex:setOrder("1")
    oIndex:setKeyFields({"XTX_COD"})
    oHeader:addIndexConstraint(oIndex:getIndex())

    oFinder := totvs.framework.structure.model.finder():new()
    oFinder:setFinder({"XTX_COD", "XTX_CNPJ", "XTX_NOME"}, "", .T.)
    oHeader:addFinder(oFinder:getFinder())

    oHeader:setUniqueKeyConstraint("XTX" + cEmpAnt + "0", {"XTX_COD"})

    oArray := S073DataArray():new()

    self:setObject(oHeader:getObject(), "XTX",,,,,, oArray)

    self:setOrder({{"XTX_COD", .F.}})
    self:LoadEventsFromMetadata()
return

class S073DataArray
    public method new() as object
    public method getData() as array
endClass

method new() as object class S073DataArray
return self

/*/{Protheus.doc} getData
Monta array de dados da tabela RCC baseado na tabela S073

@type method

@author  guilherme.suttanni
@since   15/01/2026
@version P12

@return array, dados da tabela S073
/*/
method getData() as array class S073DataArray
    Local aData      := {}
    Local cTabela    := "S073"
    Local cQuery     := ""
    Local cAliasTmp  := ""
    Local oStatement := NIL
    Local nParamOrder
    Local cConteudo  
    Local cSequencia 
    Local aCampos    
    Local cCodigo 
    Local cCNPJ
    Local cNomeEmp
    
    cQuery := "SELECT RCC_SEQUEN, RCC_CONTEU "
    cQuery += "FROM " + RetSqlName("RCC") + " RCC "
    cQuery += "WHERE RCC.RCC_FILIAL = ? "
    cQuery += "  AND RCC.RCC_CODIGO = ? "
    cQuery += "  AND RCC.D_E_L_E_T_ = ? "
    cQuery += "ORDER BY RCC_SEQUEN "
    cQuery := ChangeQuery(cQuery)

    oStatement := FwExecStatement():New(cQuery)

    nParamOrder := 1
    oStatement:SetString(nParamOrder++, xFilial("RCC"))
    oStatement:SetString(nParamOrder++, cTabela)
    oStatement:SetString(nParamOrder++, " ")

    cAliasTmp := oStatement:OpenAlias()
    
    While (cAliasTmp)->(!Eof())
        cConteudo  := AllTrim((cAliasTmp)->RCC_CONTEU)
        cSequencia := AllTrim((cAliasTmp)->RCC_SEQUEN)
        
        aCampos := fExtraiCamposRCC(cConteudo, cTabela)
        
        If Len(aCampos) >= 3
            cCodigo  := PadR(aCampos[1], 2)        
            cCNPJ    := PadR(aCampos[2], 14)       
            cNomeEmp := PadR(aCampos[3], 150)      
            
            AAdd(aData, {cSequencia, cCodigo, cCNPJ, cNomeEmp, cTabela})
        EndIf
        
        (cAliasTmp)->(dbSkip())
    EndDo
    
    (cAliasTmp)->(dbCloseArea())
return aData

/*/{Protheus.doc} fExtraiCamposRCC
Extrai campos do conteudo RCC baseado na estrutura da tabela

@type function

@author  guilherme.suttanni
@since   15/01/2026
@version P12

@param cConteudo - Conteudo do campo RCC_CONTEU
@param cTabela - CCodigo da tabela
@return aCampos - Array com os campos extraidos
/*/
Static Function fExtraiCamposRCC(cConteudo, cTabela)
    Local aCampos    := {}
    Local aEstrutura := {}
    Local nI         := 1
    Local nPosIni    := 1
    Local cCampo     := ""
    
    aEstrutura := fObtemEstruturaTabela(cTabela)
    
    For nI := 1 To Len(aEstrutura)
        cCampo := SubStr(cConteudo, nPosIni, aEstrutura[nI][2])
        AAdd(aCampos, AllTrim(cCampo))
        nPosIni += aEstrutura[nI][2]
    Next nI
    
Return aCampos

/*/{Protheus.doc} fObtemEstruturaTabela
Obtem estrutura da tabela da RCB

@type function

@author  guilherme.suttanni
@since   15/01/2026
@version P12

@param cTabela - CCodigo da tabela
@return aEstrutura - Array com estrutura da tabela
/*/
Static Function fObtemEstruturaTabela(cTabela)
    Local aEstrutura := {}
    Local cFilRCB    := xFilial("RCB")
    
    dbSelectArea("RCB")
    dbSetOrder(1) // RCB_FILIAL + RCB_CODIGO + RCB_ORDEM
    
    If dbSeek(cFilRCB + cTabela)
        While !Eof() .And. RCB->RCB_FILIAL == cFilRCB .And. RCB->RCB_CODIGO == cTabela
            AAdd(aEstrutura, {RCB->RCB_CAMPOS, RCB->RCB_TAMAN})
            dbSkip()
        EndDo
    EndIf
    
Return aEstrutura
