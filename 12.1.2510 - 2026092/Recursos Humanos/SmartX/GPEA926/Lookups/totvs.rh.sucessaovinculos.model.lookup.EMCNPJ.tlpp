#include 'fw-tlpp-core.th'
#include "protheus.ch"
#include "totvs.framework.structure.model.th"
#include "totvs.rh.sucessaovinculos.model.lookup.EMCNPJ.ch"

namespace totvs.rh.sucessaovinculos.model.lookup

@totvsFrameworkStructureModel(lookup=.T., country="ALL", description="Empresas por CNPJ")

class EMCNPJ from totvs.framework.structure.model.data
    public method new() as object
    public method setModel()
EndClass

Method new() as object class EMCNPJ
    _Super:new(,,.T.)
Return self

method setModel() class EMCNPJ
    Local oHeader As Object
    Local oArray  As Object
    Local oField  As Object
    Local oIndex  As Object
    Local oFinder As Object

    oHeader := totvs.framework.structure.object.BuildFromCode():new("XTX")

    oField := totvs.framework.structure.object.BuildFieldProperties():new("XTX_CNPJ")
    oField:setType("C")
    oField:setTitle(STR0002) // "CNPJ"
    oField:setDescription(STR0002) // "CNPJ"
    oField:setSize(14)
    oField:setOrder(1)
    oField:setRequired(.T.)
    oField:setUpperCase(.T.)
    oHeader:addFieldProperties(oField:getFieldProperties())

    oField := totvs.framework.structure.object.BuildFieldProperties():new("XTX_DESC")
    oField:setType("C")
    oField:setTitle(STR0003) // "Descrição"
    oField:setDescription(STR0004) // "Descrição da empresa"
    oField:setSize(100)
    oField:setOrder(2)
    oHeader:addFieldProperties(oField:getFieldProperties())

    oHeader:setTitle(STR0001) // "Empresas por CNPJ"

    oIndex := totvs.framework.structure.object.BuildIndex():new("XTX" + cEmpAnt + "0")
    oIndex:setOrder("1")
    oIndex:setKeyFields({"XTX_CNPJ"})
    oHeader:addIndexConstraint(oIndex:getIndex())

    oFinder := totvs.framework.structure.model.finder():new()
    oFinder:setFinder({"XTX_CNPJ"}, "", .T.)
    oHeader:addFinder(oFinder:getFinder())

    oHeader:setUniqueKeyConstraint("XTX" + cEmpAnt + "0", {"XTX_CNPJ"})

    oArray := EMCNPJDataArray():new()
    self:setObject(oHeader:getObject(), "XTX",,,,,, oArray)
    self:setOrder({{"XTX_CNPJ", .F.}})
    self:LoadEventsFromMetadata()
return

class EMCNPJDataArray
    public method new() as object
    public method getData() as array
EndClass

Method new() as object class EMCNPJDataArray
Return self

method getData() as array class EMCNPJDataArray
    Local aData     As Array
    Local aArea     As Array
    Local cCNPJ     As Character
    Local cDesc     As Character

    aData := {}
    aArea := GetArea()

    dbSelectArea("SM0")
    SM0->(dbGoTop())

    While SM0->(!Eof())
        cCNPJ := AllTrim(SM0->M0_CGC)
        cDesc := AllTrim(SM0->M0_NOMECOM)

        If Empty(cDesc)
            cDesc := AllTrim(SM0->M0_NOME)
        EndIf

        If !Empty(cCNPJ) .And. AScan(aData, {|aItem| aItem[1] == cCNPJ}) == 0
            AAdd(aData, {cCNPJ, cDesc})
        EndIf

        SM0->(dbSkip())
    EndDo

    RestArea(aArea)
return aData
