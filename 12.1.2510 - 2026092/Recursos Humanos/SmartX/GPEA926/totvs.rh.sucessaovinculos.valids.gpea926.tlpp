#include 'fw-tlpp-core.th'
#include "protheus.ch"
#include "totvs.framework.model.events.th"
#include "totvs.rh.sucessaovinculos.valids.gpea926.ch"

namespace totvs.rh.sucessaovinculos.valids

/*/{Protheus.doc} vldTpAdmRFZ
Adapta a validacao de RFZ_TPADM para o serverValidate do SmartX.
Evita a execucao do X3_VALID legado, que depende de um modelo MVC ativo.
@type function
@author Guilherme Suttanni
@since 10/08/2026
@param xValue, variant, Valor informado
@param cField, character, Campo validado
@param aContextInfo, array, Contexto SmartX
@return json, Resultado valido para as opcoes fornecidas pelo lookup
/*/
Function vldTpAdmRFZ(xValue as variant, cField as character, aContextInfo as array) as json
    Local jRet As Json

    jRet := JsonObject():new()
    jRet["return"] := .T.
    jRet["notValidMessage"] := ""
return jRet

/*/{Protheus.doc} vldCnpjRFZ
Valida inscricoes de empresa anterior/cedente conforme tipo de inscricao e admissao.
@type function
@author Guilherme Suttanni
@since 28/07/2026
@param xValue, variant, Inscricao informada
@param cField, character, Campo validado
@param aContextInfo, array, Contexto: tipo de inscricao e tipo de admissao
@return json, Resultado da validacao
/*/
Function vldCnpjRFZ(xValue as variant, cField as character, aContextInfo as array) as json
    Local jRet      As Json
    Local lRet      As Logical
    Local cInsc     As Character
    Local cTpInsc   As Character
    Local cTpAdm    As Character
    Local cFieldAux As Character
    Local cMsg      As Character

    jRet      := JsonObject():new()
    cInsc     := gp926OnlyDigits(cValToChar(xValue))
    cTpInsc   := AllTrim(cValToChar(aContextInfo[1]))
    cTpAdm    := AllTrim(cValToChar(aContextInfo[2]))
    cFieldAux := AllTrim(cField)
    cMsg      := ""
    lRet      := .T.

    If cFieldAux == "RFZ_CNPJAN" .And. !gp926WhenFieldOk(cFieldAux, cTpAdm, xValue)
        lRet := .F.
        cMsg := STR0001 // "Este campo não deve ser preenchido para o Tipo de Admissão informado."
    ElseIf !Empty(cInsc)
        If cFieldAux == "RFZ_CNPJAN"
            If cInsc == "00000000000000"
                lRet := .F.
                cMsg := STR0003 // "O CNPJ informado não é válido!"
            ElseIf cTpInsc == "2"
                lRet := ChkCPF(cInsc) .And. Len(cInsc) == 11
                cMsg := STR0002 // "O CPF informado não é válido!"
            ElseIf cTpInsc == "1"
                lRet := CGC(cInsc) .And. Len(cInsc) == 14
                cMsg := STR0003 // "O CNPJ informado não é válido!"
            ElseIf cTpInsc == "5" .Or. cTpInsc == "6"
                lRet := Len(cInsc) == 14 .And. IsDigit(cInsc)
                cMsg := STR0006 // "A inscrição informada deve possuir 14 dígitos para o Tipo de Inscrição selecionado."
            Else
                lRet := .F.
                cMsg := STR0007 // "Selecione um Tipo de Inscrição válido antes de informar a inscrição da empresa."
            EndIf
        ElseIf Len(cInsc) == 11
            lRet := ChkCPF(cInsc)
            cMsg := STR0002 // "O CPF informado não é válido!"
        Else
            lRet := CGC(cInsc)
            cMsg := STR0003 // "O CNPJ informado não é válido!"
        EndIf
    EndIf

    If lRet
        cMsg := ""
    EndIf

    jRet["return"] := lRet
    jRet["notValidMessage"] := cMsg
return jRet

/*/{Protheus.doc} vldDtAdAntRFZ
Valida se a data do vinculo anterior e posterior a admissao atual.
@type function
@author Guilherme Suttanni
@since 28/07/2026
@param xValue, variant, Data informada
@param cField, character, Campo validado
@param aContextInfo, array, Contexto: RA_ADMISSA e tipo de admissao
@return json, Resultado da validacao
/*/
Function vldDtAdAntRFZ(xValue as variant, cField as character, aContextInfo as array) as json
    Local jRet    As Json
    Local lRet    As Logical
    Local dData   As Date
    Local dAdm    As Date
    Local cTpAdm  As Character
    Local cMsg    As Character

    jRet  := JsonObject():new()
    dData := gp926ToDate(xValue)
    dAdm  := CtoD("//")
    cTpAdm := ""
    cMsg  := ""
    lRet  := .T.

    If Len(aContextInfo) >= 1
        dAdm := gp926ToDate(aContextInfo[1])
    EndIf

    If Len(aContextInfo) >= 2
        cTpAdm := AllTrim(cValToChar(aContextInfo[2]))
    EndIf

    If cField == "RFZ_DTADAN" .And. !gp926WhenFieldOk(cField, cTpAdm, xValue)
        lRet := .F.
        cMsg := STR0001 // "Este campo não deve ser preenchido para o Tipo de Admissão informado."
    ElseIf !Empty(dData) .And. !Empty(dAdm) .And. dData > dAdm
        lRet := .F.
        // Regra de RFZ_DTADCE desativada enquanto o frame SmartX não disponibiliza o campo.
        // If cField == "RFZ_DTADCE"
        //     cMsg := STR0004 + DtoC(dAdm) // "A data de admissão do trabalhador no empregador de origem (cedente) deve ser anterior à data de admissão do trabalhador na empresa declarante. Funcionário admitido em: " + DtoC(dAdm)
        // Else
        cMsg := STR0005 + DtoC(dAdm) // "A data de início do vínculo trabalhista deve ser anterior à data de admissão do trabalhador na empresa declarante. Funcionário admitido em: " + DtoC(dAdm)
        // EndIf
    EndIf

    jRet["return"] := lRet
    jRet["notValidMessage"] := cMsg
return jRet

/*/{Protheus.doc} vldWhenTpAdmRFZ
Valida o preenchimento dos campos afetados pelo X3_WHEN conforme o tipo de admissao.
@type function
@author Guilherme Suttanni
@since 10/08/2026
@param xValue, variant, Valor informado
@param cField, character, Campo validado
@param aContextInfo, array, Contexto: tipo de admissao
@return json, Resultado da validacao
/*/
Function vldWhenTpAdmRFZ(xValue as variant, cField as character, aContextInfo as array) as json
    Local jRet   As Json
    Local lRet   As Logical
    Local cTpAdm As Character

    jRet   := JsonObject():new()
    cTpAdm := AllTrim(cValToChar(aContextInfo[1]))
    lRet   := gp926WhenFieldOk(AllTrim(cField), cTpAdm, xValue)

    jRet["return"] := lRet
    If lRet
        jRet["notValidMessage"] := ""
    Else
        jRet["notValidMessage"] := STR0001 // "Este campo não deve ser preenchido para o Tipo de Admissão informado."
    EndIf
return jRet

Static Function gp926WhenFieldOk(cField as character, cTpAdm as character, xValue as variant) as logical
    If Empty(xValue)
        Return .T.
    EndIf

    If cField $ "RFZ_CNPJAN*RFZ_MATANT*RFZ_DTADAN"
        Return cTpAdm == "2" .Or. cTpAdm == "3" .Or. cTpAdm == "4"
    ElseIf cField == "RFZ_ONUS"
        Return cTpAdm == "4"
    EndIf
return cTpAdm <> "1"

Static Function gp926ToDate(xVal as variant) as date
    Local dRet As Date
    Local cVal As Character

    dRet := CtoD("//")

    If ValType(xVal) == "C" .And. !Empty(xVal)
        cVal := StrTran(xVal, "-", "")
        dRet := StoD(cVal)
    EndIf
return dRet

Static Function gp926OnlyDigits(cValue as character) as character
    Local cRet As Character

    cRet := AllTrim(cValue)
    cRet := StrTran(cRet, ".", "")
    cRet := StrTran(cRet, "-", "")
    cRet := StrTran(cRet, "/", "")
    cRet := StrTran(cRet, " ", "")
return cRet
