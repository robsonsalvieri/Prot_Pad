method setModel() class gpea934b
    Local oRJ5      As Object
   
    oRJ5 := totvs.framework.structure.object.ObjectFromMetadata():new( "RJ5", {"RJ5_FILIAL", "RJ5_INI", "RJ5_CC", "RJ5_COD", "RJ5_TPIO", "RJ5_NIO", "RJ5_FILT"}, {"RJ5_FILIAL","RJ5_INI","RJ5_CC","RJ5_COD"} )
    self:setObject(oRJ5:getObject(), "RJ5" )

    // Força que a filial apareça na grid
    self:setProperty("RJ5_FILIAL", "hidden", .F., "RJ5")

     // Adiciona os eventos
    oEvents := totvs.rh.cttlotacoes.events.gpea934bEvents():new()
    self:setEvents( oEvents )

    FwFreeObj( oRJ5 )
    
return
