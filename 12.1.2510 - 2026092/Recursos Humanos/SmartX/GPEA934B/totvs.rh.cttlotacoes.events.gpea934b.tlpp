#include 'fw-tlpp-core.th'
#include "protheus.ch"
#include "totvs.framework.model.events.th"
#include "totvs.rh.cttlotacoes.events.gpea934b.ch"

namespace totvs.rh.cttlotacoes.events

class gpea934bEvents
    public method new() as object 

    @beforeCreateInTransaction()
    public method beforeCreateInTransaction(oData, oModel, oError, oSuccess) as logical

    @beforeUpdateInTransaction()
    public method beforeUpdateInTransaction(oData, oModel, oError, oSuccess) as logical

EndClass


Method new() as object class gpea934bEvents
Return self

/*/ {Protheus.doc} beforeCreateInTransaction
    Evento executado antes da inclusão
    @author raquel.andrade
    @since 14/11/2025
    @param oData - Dados do registro
    @param oModel - Modelo de dados
    @param oError - Objeto de erro
    @param oSuccess - Objeto de sucesso
    @return lRet - Se pode incluir
/*/
method beforeCreateInTransaction(oData as object, oModel as object, oError as object, oSuccess as object) as logical class gpea934bEvents
    Local lRet          := .T.
    Local lEncontrou    := .F.
    Local oDataRJ5      := oData:GetData()
    Local cChave        := ""
    Local cDtInicio     := ""
    Local cCTT          := ""
    Local cCodLot       := ""
    Local cTpObr        := ""
    Local cInsObr       := ""
    Local cFilTrab      := ""
    Local nTamIni	    := TamSx3("RJ5_INI")[1]
    Local nTamCC	    := TamSx3("RJ5_CC")[1]
    Local nTamCod	    := TamSx3("RJ5_COD")[1]
    Local nTamTpio	    := TamSx3("RJ5_TPIO")[1]
    Local nTamNio	    := TamSx3("RJ5_NIO")[1]
    Local nTamFilt	    := TamSx3("RJ5_FILT")[1]
    
    cDtInicio   := PadR(oDataRJ5["RJ5_INI"], nTamIni)
    cCTT        := PadR(oDataRJ5["RJ5_CC"], nTamCC)
    cCodLot     := PadR(oDataRJ5["RJ5_COD"], nTamCod)
    cTpObr      := PadR(oDataRJ5["RJ5_TPIO"], nTamTpio)
    cInsObr     := PadR(oDataRJ5["RJ5_NIO"], nTamNio)
    cFilTrab    := PadR(oDataRJ5["RJ5_FILT"], nTamFilt)
    
    cChave := cDtInicio+cCTT+cCodLot
    
    dbSelectArea("RJ5")
    RJ5->(dbSetOrder(1))
    If RJ5->(dbSeek(fwxFilial("RJ5") + cChave))
        // "Já existe um registro com a chave informada: RJ5_INI + RJ5_CC + RJ5_COD"
        // "Informe uma chave não existente na base de dados"
        oError:set(400, STR0001, STR0002)
        lRet := .F.
    EndIf

    If lRet
        cChave :=  (cDtInicio + cTpObr + cInsObr + cCTT)
        dbSelectArea( "RJ5" )
        RJ5->(dbSetOrder(3))
        If RJ5->(dbSeek(xFilial("RJ5") + cChave))   
            While ((RJ5->(!Eof())) .And. (RJ5->RJ5_FILIAL + RJ5->RJ5_INI + RJ5->RJ5_TPIO + RJ5->RJ5_NIO + RJ5->RJ5_CC == xFilial("RJ5") + cChave) .And. (!lEncontrou))
                lEncontrou := ((cFilTrab == RJ5->RJ5_FILT) .Or. (Empty(RJ5->RJ5_FILT)) .Or. (Empty(cFilTrab)))
                RJ5->(DbSkip())
            Enddo

            If (lEncontrou)
                // "Já existe um registro com a chave informada: RJ5_INI + RJ5_TPIO + RJ5_NIO + RJ5_CC"
                // "Informe uma chave não existente na base de dados"
                oError:set(400, STR0005, STR0002)
                lRet := .F.
            Endif
        EndIf
        
    EndIf

    If lRet
        If (!Empty(cTpObr) .And. Empty(cInsObr )) .Or. (Empty(cTpObr) .and. !Empty(cInsObr ))
            // "Conteúdo inválido do Tipo de Obra e Inscr. Obra"
            // "Informe o conteúdo dos dois campos ou defina-os como vazio"
            oError:set(400, STR0003, STR0004)
            lRet := .F.
        EndIf
    EndIf
    
return lRet

/*/ {Protheus.doc} beforeUpdateInTransaction
    Evento executado antes do update/alteração
    @author raquel.andrade
    @since 14/11/2025
    @param oData - Dados do registro
    @param oModel - Modelo de dados
    @param oError - Objeto de erro
    @param oSuccess - Objeto de sucesso
    @return lRet - Se pode alterar
/*/
method beforeUpdateInTransaction(oData as object, oModel as object, oError as object, oSuccess as object) as logical class gpea934bEvents
    Local lRet          := .T.
    Local lEncontrou    := .F.
    Local oDataRJ5      := oData:GetData()
    Local cChave        := ""
    Local cDtInicio     := ""
    Local cCTT          := ""
    Local cCodLot       := ""
    Local cTpObr        := ""
    Local cInsObr       := ""
    Local cFilTrab      := ""
    Local nTamIni	    := TamSx3("RJ5_INI")[1]
    Local nTamCC	    := TamSx3("RJ5_CC")[1]
    Local nTamCod	    := TamSx3("RJ5_COD")[1]
    Local nTamTpio	    := TamSx3("RJ5_TPIO")[1]
    Local nTamNio	    := TamSx3("RJ5_NIO")[1]
    Local nTamFilt	    := TamSx3("RJ5_FILT")[1]
    
    cDtInicio   := PadR(oDataRJ5["RJ5_INI"], nTamIni)
    cCTT        := PadR(oDataRJ5["RJ5_CC"], nTamCC)
    cCodLot     := PadR(oDataRJ5["RJ5_COD"], nTamCod)
    cTpObr      := PadR(oDataRJ5["RJ5_TPIO"], nTamTpio)
    cInsObr     := PadR(oDataRJ5["RJ5_NIO"], nTamNio)
    cFilTrab    := PadR(oDataRJ5["RJ5_FILT"], nTamFilt)

    cChave := cDtInicio+cCTT+cCodLot
   
    dbSelectArea( "RJ5" )
    RJ5->(dbSetOrder(1))
    RJ5->(dbSeek(fwxFilial("RJ5") + cChave))

    cChaveComp := RJ5->RJ5_INI + RJ5->RJ5_TPIO + RJ5->RJ5_NIO + RJ5->RJ5_CC

    cChave :=  (cDtInicio + cTpObr + cInsObr + cCTT)

    If cChaveComp != cChave // Se teve alteração na chave composta
        RJ5->(dbSetOrder(3))
        RJ5->(dbGoTop())
        If RJ5->(dbSeek(xFilial("RJ5") + cChave))
            While ((RJ5->(!Eof())) .And. (RJ5->RJ5_FILIAL + RJ5->RJ5_INI + RJ5->RJ5_TPIO + RJ5->RJ5_NIO + RJ5->RJ5_CC == xFilial("RJ5") + cChave) .And. (!lEncontrou))
                lEncontrou := ((cFilTrab == RJ5->RJ5_FILT) .Or. (Empty(RJ5->RJ5_FILT)) .Or. (Empty(cFilTrab)))
                RJ5->(DbSkip())
            Enddo

            If (lEncontrou)
                // "Já existe um registro com a chave informada: RJ5_INI + RJ5_TPIO + RJ5_NIO + RJ5_CC"
                // "Informe uma chave não existente na base de dados"
                oError:set(400, STR0005, STR0002)
                lRet := .F.
            Endif
        EndIf
    EndIf

    If lRet
        If (!Empty(cTpObr) .And. Empty(cInsObr )) .Or. (Empty(cTpObr) .and. !Empty(cInsObr ))
            // "Conteúdo inválido do Tipo de Obra e Inscr. Obra"
            // "Informe o conteúdo dos dois campos ou defina-os como vazio"
            oError:set(400, STR0003, STR0004)
            lRet := .F.
        EndIf
    EndIf

return lRet



