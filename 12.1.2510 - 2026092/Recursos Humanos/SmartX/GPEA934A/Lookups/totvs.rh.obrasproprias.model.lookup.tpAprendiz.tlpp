/*/{Protheus.doc} getData
Monta array de dados da carga do modelo

@type method

@author  isabel.noguti
@since   24/10/2025
@version P12
/*/
method getData() as array class tpAprendizDataArray
    local aData as array

    aData := {}

    // Baseado na função fTpIdAPD (GPEM017)
    AAdd(aData, {"0", "Dispensado de acordo com a lei"})
    AAdd(aData, {"1", "Dispensado, mesmo que parcialmente, em virtude de processo judicial"})
    AAdd(aData, {"2", "Obrigado"})

return aData
