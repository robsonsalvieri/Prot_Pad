/*/{Protheus.doc} getData
Monta array de dados da carga do modelo

@type method

@author  caio.kretzer
@since   03/12/2025
@version P12
/*/
method getData() as array class regPontoDataArray
    local aData as array

    aData := {}

    // Baseado na função fTpIdAPD (GPEM017)
    AAdd(aData, {"1", "Por intermedio de Entidade Educativa sem fins lucrativos"})
    AAdd(aData, {"2", "Nao se trata de Entidade Educativa sem fins lucrativos"})

    VarInfo("aData",aData)

return aData
