@totvsFrameworkStructureModel(lookup=.T., country="ALL", description="Indicativo de Contratação de Aprendiz")

class regPonto from totvs.framework.structure.model.data
    public method new() as object
    public method setModel()
EndClass

/*/{Protheus.doc} new
