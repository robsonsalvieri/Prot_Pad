#Include "fw-tlpp-core.th"
#Include "protheus.ch"
#Include "totvs.framework.model.events.th"
#Include "FWMVCDEF.ch"
#Include "totvs.rh.lotacoes.events.gpea934.ch"

namespace totvs.rh.lotacoes.events

Static lMiddleware := If(cPaisLoc == "BRA" .And. FindFunction("fVerMW"), fVerMW(), .F.)

class GPEA934Events
    public method new() as object

    @beforeCreateInTransaction()
    public method beforeCreateInTransaction(oData, oModel, oError, oSuccess) as logical

    @beforeUpdateInTransaction()
    public method beforeUpdateInTransaction(oData, oModel, oError, oSuccess) as logical

    @beforeDeleteInTransaction()
    public method beforeDeleteInTransaction(oData, oModel, oError, oSuccess) as logical
EndClass

Method new() as object class GPEA934Events
Return self

/*/ {Protheus.doc} beforeCreateInTransaction
    Valida a inclusao de registro de Lotacao eSocial.
    @author lidio.oliveira
    @since 06/11/2025
/*/
method beforeCreateInTransaction(oData as object, oModel as object, oError as object, oSuccess as object) as logical class GPEA934Events
    Local lRet      As Logical
    Local aLogError As Array
    Local aLogMsg   As Array
    Local oDataRJ3  As Json

    aLogError := {}
    aLogMsg   := {}
    oDataRJ3  := oData:GetData()

    lRet := fGpea934Valida(oData, @aLogError, MODEL_OPERATION_INSERT, .F.)

    If lRet
        lRet := fIntegra934(MODEL_OPERATION_INSERT, oDataRJ3, @aLogError, @aLogMsg)
    EndIf

    If !lRet
        fExibeLogMsg934(aLogError, aLogMsg, oError, oSuccess)
    ElseIf Len(aLogMsg) > 0
        fExibeLogMsg934(aLogError, aLogMsg, oError, oSuccess)
    EndIf

Return lRet

/*/ {Protheus.doc} beforeUpdateInTransaction
    Valida a alteracao de registro de Lotacao eSocial.
    @author lidio.oliveira
    @since 06/11/2025
/*/
method beforeUpdateInTransaction(oData as object, oModel as object, oError as object, oSuccess as object) as logical class GPEA934Events
    Local lRet      As Logical
    Local aLogError As Array
    Local aLogMsg   As Array
    Local oDataRJ3  As Json

    aLogError := {}
    aLogMsg   := {}
    oDataRJ3  := oData:GetData()

    lRet := fGpea934Valida(oData, @aLogError, MODEL_OPERATION_UPDATE, .T.)

    If lRet
        lRet := fIntegra934(MODEL_OPERATION_UPDATE, oDataRJ3, @aLogError, @aLogMsg)
    EndIf

    If !lRet
        fExibeLogMsg934(aLogError, aLogMsg, oError, oSuccess) //erro
    ElseIf Len(aLogMsg) > 0
        fExibeLogMsg934(aLogError, aLogMsg, oError, oSuccess) //sucesso
    EndIf

Return lRet

/*/ {Protheus.doc} beforeDeleteInTransaction
    Evento executado antes da exclusao de Lotacao eSocial.
    @author lidio.oliveira
    @since 06/11/2025
/*/
method beforeDeleteInTransaction(oData as object, oModel as object, oError as object, oSuccess as object) as logical class GPEA934Events
    Local lRet      As Logical
    Local aLogError As Array
    Local aLogMsg   As Array
    Local oDataRJ3  As Json

    aLogError := {}
    aLogMsg   := {}
    oDataRJ3  := oData:GetData()

    lRet := fIntegra934(MODEL_OPERATION_DELETE, oDataRJ3, @aLogError, @aLogMsg)

    If !lRet
        fExibeLogMsg934(aLogError, aLogMsg, oError, oSuccess)
    ElseIf Len(aLogMsg) > 0
        fExibeLogMsg934(aLogError, aLogMsg, oError, oSuccess)
    EndIf

Return lRet

/*/ {Protheus.doc} fGpea934Valida
    Centraliza todas as validacoes de negocio de inclusao e alteracao.
    @since 29/05/2026
    @param oData,      object,  Dados do evento SmartX
    @param oError,     object,  Objeto de erro SmartX
    @param nOpc,       numeric, MODEL_OPERATION_INSERT ou MODEL_OPERATION_UPDATE
    @param lChkChave,  logical, .T. valida chave apenas se foi alterada (UPDATE)
    @return lRet, logical
/*/
Static Function fGpea934Valida(oData as object, aLogError as array, nOpc as numeric, lChkChave as logical) as logical

    Local lRet        As Logical
    Local lIntAtiva   As Logical
    Local lFpasValido As Logical
    Local cChave      As Character
    Local cTpLot      As Character
    Local cTpInsc     As Character
    Local cNInscr     As Character
    Local cCod        As Character
    Local cTpInCo     As Character
    Local cNInsCo     As Character
    Local cTpInPr     As Character
    Local cNInsPr     As Character
    Local cFpas       As Character
    Local cTerc       As Character
    Local cEFDAvis    As Character
    Local cMsgErro    As Character
    Local aArea       As Array

    lRet      := .T.
    cCod      := oData:getFieldValue("RJ3", "RJ3_COD")
    cChave    := oData:getFieldValue("RJ3", "RJ3_INI") + cCod
    cTpLot    := oData:getFieldValue("RJ3", "RJ3_TPLOT")
    cTpInsc   := oData:getFieldValue("RJ3", "RJ3_TPINSC")
    cNInscr   := oData:getFieldValue("RJ3", "RJ3_NINSCR")
    cTpInCo   := oData:getFieldValue("RJ3", "RJ3_TPINCO")
    cNInsCo   := oData:getFieldValue("RJ3", "RJ3_NINSCO")
    cTpInPr   := oData:getFieldValue("RJ3", "RJ3_TPINPR")
    cNInsPr   := oData:getFieldValue("RJ3", "RJ3_NINSPR")
    cFpas     := oData:getFieldValue("RJ3", "RJ3_FPAS")
    cTerc     := oData:getFieldValue("RJ3", "RJ3_TERC")

    // ------------------------------------------------------------------
    // Validacao 1: Chave unica somente no INSERT (Gp934PosVal)
    // ------------------------------------------------------------------
    If !lChkChave
        dbSelectArea("RJ3")
        If dbSeek(xFilial("RJ3") + cChave)
            cMsgErro := STR0001 // "Ja existe um registro com a chave informada: RJ3_INI + RJ3_COD. Informe uma chave nao existente na base de dados."
            aAdd(aLogError, cMsgErro)
            lRet := .F.
        EndIf
    EndIf

    If !lRet
        Return lRet
    EndIf

    // X3_WHEN = !M->RJ3_TPLOT $ "01|10|21|24|90|91"
    // Campo bloqueado (nao editavel) quando TPLOT pertence a esses tipos.
    If AllTrim(cTpLot) $ "01|10|21|24|90|91" .And. !Empty(cTpInsc)
        cMsgErro := STR0002 + AllTrim(cTpLot) + STR0003 // "O campo 'Tp.Inscricao' (RJ3_TPINSC) deve estar em branco para o Tipo de Lotacao " + cTpLot + ". Os tipos 01, 10, 21, 24, 90 e 91 nao permitem Tipo de Inscricao."
        aAdd(aLogError, cMsgErro)
        lRet := .F.
    EndIf

    If !lRet
        Return lRet
    EndIf

    // Consistencia TPLOT x TPINSC no momento do Save
    If !Empty(cTpLot) .And. !Empty(cTpInsc)
        If AllTrim(cTpLot) $ "04|05|06|08" .And. !(AllTrim(cTpInsc) == "1")
            cMsgErro := STR0004 + AllTrim(cTpLot) + STR0005 // "Para o Tipo de Lotacao " + cTpLot + " o Tipo de Inscricao deve ser '1' (CNPJ)."
            aAdd(aLogError, cMsgErro)
            lRet := .F.
        ElseIf AllTrim(cTpLot) $ "03|07" .And. !(AllTrim(cTpInsc) == "2")
            cMsgErro := STR0004 + AllTrim(cTpLot) + STR0006 // "Para o Tipo de Lotacao " + cTpLot + " o Tipo de Inscricao deve ser '2' (CPF)."
            aAdd(aLogError, cMsgErro)
            lRet := .F.
        ElseIf AllTrim(cTpLot) == "02" .And. !(AllTrim(cTpInsc) == "4")
            cMsgErro := STR0007 // "Para o Tipo de Lotacao 02 o Tipo de Inscricao deve ser '4' (CNO)."
            aAdd(aLogError, cMsgErro)
            lRet := .F.
        ElseIf AllTrim(cTpLot) == "09" .And. !(AllTrim(cTpInsc) $ "1|2")
            cMsgErro := STR0008 // "Para o Tipo de Lotacao 09 o Tipo de Inscricao deve ser '1' (CNPJ) ou '2' (CPF)."
            aAdd(aLogError, cMsgErro)
            lRet := .F.
        EndIf
    EndIf

    If !lRet
        Return lRet
    EndIf

    // X3_WHEN = !Empty(M->RJ3_TPINSC)
    // Campo bloqueado quando TPINSC esta vazio.
    If Empty(cTpInsc) .And. !Empty(cNInscr)
        cMsgErro := STR0009 // "O campo 'Nm.Inscricao' (RJ3_NINSCR) deve estar em branco quando 'Tp.Inscricao' (RJ3_TPINSC) nao for informado."
        aAdd(aLogError, cMsgErro)
        lRet := .F.
    EndIf

    If !lRet
        Return lRet
    EndIf

    // X3_WHEN = M->RJ3_TPLOT == "02" campos visiveis somente para TPLOT "02".
    If AllTrim(cTpLot) <> "02"
        If !Empty(cTpInCo)
            cMsgErro := STR0010 // "O campo 'Tp.In.Contr.' (RJ3_TPINCO) e valido somente para o Tipo de Lotacao '02'."
            aAdd(aLogError, cMsgErro)
            lRet := .F.
        ElseIf !Empty(cNInsCo)
            cMsgErro := STR0011 // "O campo 'N.Insc.Contr' (RJ3_NINSCO) e valido somente para o Tipo de Lotacao '02'."
            aAdd(aLogError, cMsgErro)
            lRet := .F.
        ElseIf !Empty(cTpInPr)
            cMsgErro := STR0012 // "O campo 'Tp.I.Pro.CNO' (RJ3_TPINPR) e valido somente para o Tipo de Lotacao '02'."
            aAdd(aLogError, cMsgErro)
            lRet := .F.
        ElseIf !Empty(cNInsPr)
            cMsgErro := STR0013 // "O campo 'N.Insc.Prop.' (RJ3_NINSPR) e valido somente para o Tipo de Lotacao '02'."
            aAdd(aLogError, cMsgErro)
            lRet := .F.
        EndIf
    EndIf

    If !lRet
        Return lRet
    EndIf

    lIntAtiva := If(FindFunction("fVerMW") .And. cPaisLoc == "BRA", fVerMW(), .F.)
    If !lIntAtiva .And. FindFunction("fChkFMat")
        lIntAtiva := fChkFMat("S-1020")
    EndIf

    If lIntAtiva
        If AllTrim(cTpLot) == "02"
            If Empty(cTpInCo) .Or. Empty(cNInsCo)
                cMsgErro := STR0014 // "Os campos 'Tp. In. Contr.' e 'N.Insc.Contr.' sao de preenchimento obrigatorio quando o Tipo de Lotacao for igual a '02'."
                aAdd(aLogError, cMsgErro)
                lRet := .F.
            ElseIf (Empty(cNInsPr) .And. !Empty(cTpInPr)) .Or. (Empty(cTpInPr) .And. !Empty(cNInsPr))
                cMsgErro := STR0015 // "O campo 'N.Insc.Prop.' so deve ser informado conforme o preenchimento de 'Tp.I.Pro.CNO'."
                aAdd(aLogError, cMsgErro)
                lRet := .F.
            EndIf
        EndIf

        If !lRet
            Return lRet
        EndIf

        // (De fVldRJ3): campos obrigatorios por TPLOT
        If AllTrim(cTpLot) $ "03|04|05|06|07|08|09"
            If Empty(cCod) .Or. Empty(cTpInsc) .Or. Empty(cNInscr)
                cMsgErro := STR0016 + AllTrim(cTpLot) + STR0017 // "Existem campos necessarios ao eSocial em branco. Campos obrigatorios para o Tipo de Lotacao " + cTpLot + ": Cod.Lotacao (RJ3_COD), Tp.Inscricao (RJ3_TPINSC) e Nm.Inscricao (RJ3_NINSCR)."
                aAdd(aLogError, cMsgErro)
                lRet := .F.
            EndIf
        EndIf

        If !lRet
            Return lRet
        EndIf

        // FPAS + Codigo de Terceiros (C8A)
        If !Empty(cFpas) .And. !Empty(cTerc)
            cEFDAvis    := If(cPaisLoc == "BRA" .And. FindFunction("fEFDAviso"), fEFDAviso(), SuperGetMv("MV_EFDAVIS",, "0"))
            lFpasValido := .F.
            aArea       := GetArea()

            dbSelectArea("C8A")
            C8A->(dbSetOrder(2))
            C8A->(DbGotop())
            While !(C8A->(EOF()))
                If AllTrim(cFpas) == AllTrim(C8A->C8A_CDFPAS) .And. AllTrim(cTerc) == AllTrim(C8A->C8A_CODTER) .And. (C8A->C8A_VALIDA >= DDatabase .Or. Empty(C8A->C8A_VALIDA))
                    lFpasValido := .T.
                    Exit
                EndIf
                C8A->(dbSkip())
            End

            RestArea(aArea)

            If !lFpasValido .And. cEFDAvis == "1"
                cMsgErro := STR0018 + AllTrim(cFpas) + STR0019 + AllTrim(cTerc) + STR0020 // "O valor '" + cFpas + "' informado no campo FPAS somado ao valor '" + cTerc + "' informado no campo Cod.Terceiros FPAS nao corresponde a nenhum registro na tabela C8A (FPAS x Terceiros). Verifique o cadastro e corrija os campos RJ3_FPAS e RJ3_TERC."
                aAdd(aLogError, cMsgErro)
                lRet := .F.
            EndIf
        EndIf

    EndIf

Return lRet


/*/{Protheus.doc} fIntegra934
    Integracao TAF/Middleware para o evento S-1020 (Lotacoes eSocial).
    Porta a logica de integracao de fVldRJ3 (GPEM017.PRW) adaptada para SmartX:
/*/
Static Function fIntegra934(nOpc as numeric, oDataRJ3 as json, aLogError as array, aLogMsg as array) as logical

    Local lRet       As Logical
    Local lS1000     As Logical
    Local lNovoRJE   As Logical
    Local lAdmPubl   As Logical
    Local lContinua  As Logical
    Local lIntAtiva  As Logical
    Local aArea      As Array
    Local aFilInTaf  As Array
    Local aArrayFil  As Array
    Local aErros     As Array
    Local aInfos     As Array
    Local aDados     As Array
    Local cCodLot    As Character
    Local cMesAnoP   As Character
    Local cMes       As Character
    Local cAno       As Character
    Local cFilEnv    As Character
    Local cBkpFil    As Character
    Local cTpLot     As Character
    Local cTp2       As Character
    Local cInsEsoc   As Character
    Local cFPAS      As Character
    Local cTerc      As Character
    Local cTpInsCo   As Character
    Local cNrInsCo   As Character
    Local cTpInsPr   As Character
    Local cNrInsPr   As Character
    Local cTpInsc    As Character
    Local cNrInsc    As Character
    Local cChave     As Character
    Local cChaveTAF  As Character
    Local cXml       As Character
    Local cVersMid   As Character
    Local cRetKey    As Character
    Local cRetfNew   As Character
    Local cRetfRJE   As Character
    Local cRetfOld   As Character
    Local cOperNew   As Character
    Local cOperOld   As Character
    Local cOperRJE   As Character
    Local cStatNew   As Character
    Local cStatOld   As Character
    Local cStatus    As Character
    Local cMsgRJE    As Character
    Local cTpAmb     As Character
    Local cEFDAviso  As Character
    Local cIni       As Character
    Local cLotInsc   As Character
    Local cNrInscRJE As Character
    Local nOpcao     As Numeric
    Local nOpcAx     As Numeric
    Local nRecOld    As Numeric
    Local nRecRJE    As Numeric
    Local dDtGer     As Date
    Local cHrGer     As Character

    lRet       := .T.
    lS1000     := .F.
    lNovoRJE   := .F.
    lAdmPubl   := .F.
    lContinua  := .T.
    lIntAtiva  := .F.
    aArea      := GetArea()
    aFilInTaf  := {}
    aArrayFil  := {}
    aErros     := {}
    aInfos     := {}
    aDados     := {}
    nOpcao     := 3
    nOpcAx     := nOpc
    nRecOld    := 0
    nRecRJE    := 0
    cStatus    := "-1"
    cStatOld   := "-1"
    cOperRJE   := "I"
    cOperOld   := "I"
    cRetfOld   := "1"
    cMsgRJE    := ""
    cFilEnv    := ""
    cBkpFil    := cFilAnt
    cXml       := ""
    cVersMid   := ""
    cRetKey    := ""
    cRetfNew   := ""
    cOperNew   := ""
    cStatNew   := ""
    cTpAmb     := ""
    cTpInsc    := ""
    cNrInsc    := "0"
    cNrInscRJE := ""
    cLotInsc   := "02|03|04|05|06|07|08|09"
    dDtGer     := Date()
    cHrGer     := Time()
    cEFDAviso  := If(cPaisLoc == "BRA" .And. FindFunction("fEFDAviso"), fEFDAviso(), SuperGetMv("MV_EFDAVIS",, "0"))

    // Portao equivalente ao fVldRJ3 (GPEM017.PRW): fora do Middleware, o legado
    // tambem exige fChkFMat("S-1020") (checagem de compartilhamento de filial/matriz).
    lIntAtiva := lMiddleware
    If !lIntAtiva .And. (SuperGetMv("MV_RHTAF",, .F.) == .T.)
        lIntAtiva := FindFunction("fChkFMat") .And. fChkFMat("S-1020")
    EndIf

    If !lIntAtiva
        RestArea(aArea)
        Return lRet
    EndIf

    // Monta dados do registro a partir do JSON do SmartX
    cIni     := AllTrim(oDataRJ3["RJ3_INI"])
    cMes     := SubStr(cIni, 5, 2)
    cAno     := SubStr(cIni, 1, 4)
    cMesAnoP := cMes + cAno
    cTpLot   := AllTrim(oDataRJ3["RJ3_TPLOT"])
    cTp2     := AllTrim(oDataRJ3["RJ3_TPINSC"])
    cInsEsoc := AllTrim(oDataRJ3["RJ3_NINSCR"])
    cFPAS    := AllTrim(oDataRJ3["RJ3_FPAS"])
    cTerc    := AllTrim(oDataRJ3["RJ3_TERC"])
    cTpInsCo := AllTrim(oDataRJ3["RJ3_TPINCO"])
    cNrInsCo := AllTrim(oDataRJ3["RJ3_NINSCO"])
    cTpInsPr := AllTrim(oDataRJ3["RJ3_TPINPR"])
    cNrInsPr := AllTrim(oDataRJ3["RJ3_NINSPR"])
    cCodLot := xFilial("RJ3") + AllTrim(oDataRJ3["RJ3_COD"])

    If lMiddleware
        // -----------------------------------------------------------------------
        // Caminho Middleware: fVld1000 -> consulta RJE -> fCarrLot -> fGravaRJE
        // Porta a secao Middleware de fVldRJ3 (GPEM017.PRW)
        // -----------------------------------------------------------------------
        fVersEsoc("S-1020", .F., Nil, Nil, @cVersMid, Nil, @cTpAmb)
        fPosFil(cEmpAnt, cFilAnt)
        lS1000 := fVld1000(cIni, @cStatus)

        If lS1000 .Or. cEFDAviso $ "0|2"

            aInfos := fXMLInfos()
            If Len(aInfos) >= 4
                cTpInsc  := aInfos[1]
                lAdmPubl := aInfos[4]
                cNrInsc  := aInfos[2]
            Else
                cTpInsc  := ""
                lAdmPubl := .F.
                cNrInsc  := "0"
            EndIf

            // Chave RJE para o registro novo/alterado (S-1020)
            If !lAdmPubl .And. cTpInsc == "1"
                cNrInscRJE := SubStr(cNrInsc, 1, 8)
            Else
                cNrInscRJE := cNrInsc
            EndIf
            cChave := cTpInsc + PADR(cNrInscRJE, 14) + "S1020" + Padr(xFilial("RJ3", cFilAnt) + AllTrim(oDataRJ3["RJ3_COD"]), fTamRJEKey(), " ") + cIni
            cStatus := "-1"
            GetInfRJE(2, cChave, @cStatus, @cOperRJE, @cRetfRJE, @nRecRJE)

            // Para UPDATE: verifica tambem o registro original (chave antes da alteracao)
            If nOpcAx == MODEL_OPERATION_UPDATE
                cChave := cTpInsc + PADR(cNrInscRJE, 14) + "S1020" + Padr(xFilial("RJ3", cFilAnt) + AllTrim(oDataRJ3["RJ3_COD"]), fTamRJEKey(), " ") + cIni
                GetInfRJE(2, cChave, @cStatOld, @cOperOld, @cRetfOld, @nRecOld)
                If cStatOld $ "1|3"
                    cStatus  := cStatOld
                    cRetfRJE := cRetfOld
                    nRecRJE  := nRecOld
                EndIf
            EndIf

            // Determina operacao e valida restricoes de fila RJE
            If nOpcAx == MODEL_OPERATION_UPDATE .Or. nOpcAx == MODEL_OPERATION_DELETE

                If cStatus == "2" .Or. cStatOld == "2"
                    cMsgRJE := STR0021 /* "Operacao nao sera realizada pois o evento foi transmitido, mas o retorno esta pendente" */
                    lRet := .F.
                ElseIf nOpcAx == MODEL_OPERATION_UPDATE .And. cStatus != "2"
                    If cOperRJE == "E" .And. cStatus != "4"
                        cMsgRJE := STR0023 /* "Operacao nao sera realizada pois ha evento de exclusao que nao foi transmitido ou com retorno pendente" */
                        lRet := .F.
                    ElseIf cStatus == "-1"
                        nOpcao   := 3
                        cOperNew := "I"
                        cRetfNew := "1"
                        cStatNew := "1"
                        lNovoRJE := .T.
                    ElseIf cStatus $ "1|3"
                        If cOperRJE == "A"
                            nOpcao := 4
                        Else
                            nOpcao := 3
                        EndIf
                        cOperNew := cOperRJE
                        cRetfNew := cRetfRJE
                        cStatNew := "1"
                        lNovoRJE := .F.
                    ElseIf cOperRJE != "E" .And. cStatus == "4"
                        nOpcao   := 4
                        cOperNew := "A"
                        cRetfNew := "2"
                        cStatNew := "1"
                        lNovoRJE := .T.
                    ElseIf cOperRJE == "E" .And. cStatus == "4"
                        nOpcao   := 3
                        cOperNew := "I"
                        cRetfNew := "1"
                        cStatNew := "1"
                        lNovoRJE := .T.
                    EndIf
                ElseIf nOpcAx == MODEL_OPERATION_DELETE
                    nOpcao := 5
                    If cOperRJE == "E" .And. cStatus != "4"
                        cMsgRJE := STR0023 /* "Operacao nao sera realizada pois ha evento de exclusao que nao foi transmitido ou com retorno pendente" */
                        lRet := .F.
                    ElseIf cOperRJE != "E" .And. cStatus == "4"
                        cOperNew := "E"
                        cRetfNew := cRetfRJE
                        cStatNew := "1"
                        lNovoRJE := .T.
                    EndIf
                EndIf

            ElseIf nOpcAx == MODEL_OPERATION_INSERT

                If cStatus == "2"
                    cMsgRJE := STR0021 /* "Operacao nao sera realizada pois o evento foi transmitido, mas o retorno esta pendente" */
                    lRet := .F.
                ElseIf cOperRJE == "E" .And. cStatus != "4"
                    cMsgRJE := STR0023 /* "Operacao nao sera realizada pois ha evento de exclusao que nao foi transmitido ou com retorno pendente" */
                    lRet := .F.
                ElseIf cStatus $ "1|3"
                    If cOperRJE == "I"
                        nOpcao := 3
                    Else
                        nOpcao := 4
                    EndIf
                    cOperNew := cOperRJE
                    cRetfNew := cRetfRJE
                    cStatNew := "1"
                    lNovoRJE := .F.
                ElseIf cOperRJE != "E" .And. cStatus == "4"
                    cOperNew := "A"
                    cRetfNew := "2"
                    cStatNew := "1"
                    lNovoRJE := .T.
                Else
                    cOperNew := "I"
                    cRetfNew := "1"
                    cStatNew := "1"
                    lNovoRJE := .T.
                EndIf

            EndIf

            // Gera XML e atualiza fila RJE
            If lRet
                If fCarrLot(cCodLot, cMesAnoP, cTpLot, cLotInsc, cTp2, cInsEsoc, cFPAS, cTerc, cTpInsCo, cNrInsCo, cTpInsPr, cNrInsPr, nOpcao, @aErros, cFilEnv, .F., @cXml, cVersMid, @cRetKey, cTpAmb)

                    If cTpInsc == "1" .And. !lAdmPubl
                        cNrInscRJE := SubStr(cNrInsc, 1, 8)
                    Else
                        cNrInscRJE := cNrInsc
                    EndIf
                    aAdd(aDados, {xFilial("RJE", cFilAnt), xFilial("RJ3", cFilAnt), cTpInsc, cNrInscRJE, "S1020", cIni, xFilial("RJ3", cFilAnt) + AllTrim(oDataRJ3["RJ3_COD"]), cRetKey, cRetfNew, "12", cStatNew, dDtGer, cHrGer, cOperNew})

                    // Caso DELETE com status 4 + operRJE != E: cria novo registro de exclusao
                    // Caso DELETE com status 1/3 ou -1: fExcluiRJE ou nenhuma acao
                    // Demais casos (INSERT/UPDATE): fGravaRJE
                    If !(nOpcAx == MODEL_OPERATION_DELETE .And. ((cOperRJE == "E" .And. cStatus == "4") .Or. cStatus $ "-1|1|3"))
                        If fGravaRJE(aDados, cXml, lNovoRJE, nRecRJE)
                            aAdd(aLogMsg, STR0024 /* "Registro enviado ao Middleware com sucesso." */)
                        Else
                            cMsgRJE := STR0025 // "Ocorreu um erro na gravacao do registro na tabela RJE"
                            lRet := .F.
                        EndIf
                    ElseIf nOpcAx == MODEL_OPERATION_DELETE .And. cStatus != "-1" .And. !(cOperRJE == "E" .And. cStatus == "4")
                        If fExcluiRJE(nRecRJE)
                            aAdd(aLogMsg, STR0024 /* "Registro enviado ao Middleware com sucesso." */)
                        Else
                            cMsgRJE := STR0026 // "Ocorreu um erro na exclusao do registro na tabela RJE"
                            lRet := .F.
                        EndIf
                    EndIf

                Else
                    If Len(aErros) > 0
                        cMsgRJE := aErros[1]
                    Else
                        cMsgRJE := STR0027 /* "Problemas com evento S-1020" */
                    EndIf
                    lRet := .F.
                EndIf
            EndIf

        EndIf

        // Aplica MV_EFDAVIS se integracao Middleware falhou
        If !lRet .And. !Empty(cMsgRJE)
            If cEFDAviso == "0"
                aAdd(aLogMsg, cMsgRJE)
                aAdd(aLogMsg, STR0028 /* "O Registro sera salvo mas nao integrado com o Middleware. Para corrigir, volte alterando o registro e informe os campos necessarios." */)
                lRet := .T.
            ElseIf cEFDAviso == "1"
                aAdd(aLogError, cMsgRJE)
                aAdd(aLogError, STR0029 /* "O Registro nao sera salvo e nem integrado com o Middleware. Corrija os campos informados para prosseguir com o cadastro." */)
            ElseIf cEFDAviso == "2"
                lRet := .T.
            EndIf
        EndIf

        // S-1000 invalido: aplica EFDAVIS (STR0030-STR0034)
        If !lS1000 .And. cEFDAviso != "2"
            Do Case
                Case cStatus == "-1"
                    cMsgRJE := STR0030 // "Registro do evento S-1000 nao localizado na base de dados"
                Case cStatus == "1"
                    cMsgRJE := STR0031 // "Registro do evento S-1000 nao transmitido para o governo"
                Case cStatus == "2"
                    cMsgRJE := STR0032 // "Registro do evento S-1000 aguardando retorno do governo"
                Case cStatus == "3"
                    cMsgRJE := STR0033 // "Registro do evento S-1000 retornado com erro do governo"
                Otherwise
                    cMsgRJE := STR0034 // "Problemas com o evento S-1000"
            EndCase
            If cEFDAviso == "0"
                aAdd(aLogMsg, cMsgRJE)
                aAdd(aLogMsg, STR0028 /* "O Registro sera salvo mas nao integrado com o Middleware. Para corrigir, volte alterando o registro e informe os campos necessarios." */)
                lRet := .T.
            Else
                aAdd(aLogError, cMsgRJE)
                aAdd(aLogError, STR0029 /* "O Registro nao sera salvo e nem integrado com o Middleware. Corrija os campos informados para prosseguir com o cadastro." */)
                lRet := .F.
            EndIf
        EndIf

        fPosFil(cEmpAnt, cBkpFil)

    Else
        // -----------------------------------------------------------------------
        // Caminho TAF: fGp23Cons -> fVldFilEnv -> fVerExtemp -> fCarrLot
        // Porta a secao TAF de fVldRJ3 (GPEM017.PRW)
        // -----------------------------------------------------------------------
        fGp23Cons(@aFilInTaf, @aArrayFil, @cFilEnv)

        If Empty(cFilEnv) .And. Len(aFilInTaf) > 0
            If !fVldFilEnv(cFilAnt, aFilInTaf, cEFDAviso)
                If cEFDAviso == "0"
                    aAdd(aLogMsg, STR0035 /* "Nao foi encontrada a filial de referencia do TAF para a integracao do registro." */)
                    aAdd(aLogMsg, STR0036) // "O Registro sera salvo mas nao integrado com o TAF. Corrija o complemento cadastral para integrar o registro."
                    lRet := .T.
                ElseIf cEFDAviso == "1"
                    aAdd(aLogError, STR0035 /* "Nao foi encontrada a filial de referencia do TAF para a integracao do registro." */)
                    aAdd(aLogError, STR0037) // "O Registro nao sera salvo e nem integrado com o TAF."
                    aAdd(aLogError, STR0038) // "Corrija o complemento cadastral para prosseguir."
                    lRet := .F.
                EndIf
                RestArea(aArea)
                Return lRet
            EndIf
        EndIf

        If Empty(cFilEnv)
            cFilEnv := cFilAnt
        EndIf

        cChaveTAF := cCodLot + ";" + cMesAnoP
        nOpcao    := fVerExtemp("S-1020", cChaveTAF, nOpcAx, @cStatus, @lContinua)

        If nOpcao == 3 .And. cStatus == "4"
            // Registro ja existe no TAF: inclui apenas em RJ3
            aAdd(aLogMsg, STR0039) // "O registro ja existe no TAF, sera incluido apenas na tabela do SIGAGPE"
            lRet := lContinua
        ElseIf nOpcao > 0
            If nOpcao == 4 .And. cStatus == "4"
                aAdd(aLogMsg, STR0040) // "A Chave dos eventos de tabela e composta pelo codigo da tabela e a data de inicio da vigencia. Importante observar que, se informar uma data que ja exista fechamento da folha, sera necessario reabrir a folha de pagamento (evento S-1298) e retificar os eventos periodicos (S-1200 e S-1210)."
            EndIf

            If !(nOpcao == 5 .And. !(cStatus $ " |0|1|3|4"))
                If fCarrLot(cCodLot, cMesAnoP, cTpLot, cLotInsc, cTp2, cInsEsoc, cFPAS, cTerc, cTpInsCo, cNrInsCo, cTpInsPr, cNrInsPr, nOpcao, @aErros, cFilEnv, .F.)
                    aAdd(aLogMsg, STR0041) // "Registro enviado para o TAF com sucesso!"
                Else
                    If Len(aErros) > 0
                        cMsgRJE := aErros[1]
                    Else
                        cMsgRJE := STR0027 /* "Problemas com evento S-1020" */
                    EndIf
                    If cEFDAviso == "0"
                        aAdd(aLogMsg, cMsgRJE)
                        aAdd(aLogMsg, STR0042) // "O Registro sera salvo mas nao integrado com o TAF. Para corrigir, volte alterando o registro e informe os campos necessarios."
                    ElseIf cEFDAviso == "1"
                        aAdd(aLogError, cMsgRJE)
                        aAdd(aLogError, STR0043) // "O Registro nao sera salvo e nem integrado com o TAF. Corrija os campos informados para prosseguir com o cadastro."
                        lRet := .F.
                    EndIf
                    // cEFDAviso == "2": silencioso, lRet permanece .T.
                EndIf
            EndIf
        Else
            lRet := lContinua
        EndIf

    EndIf

    RestArea(aArea)

Return lRet


/*/{Protheus.doc} fExibeLogMsg934
    Transfere mensagens de integracao/validacao para os objetos oError e oSuccess
    do framework SmartX. Segue o padrao de fExibeLogMsg do GPEA934A.
    @since 15/07/2026
    @param aLogError  array   Mensagens de erro bloqueante
    @param aLogMsg    array   Mensagens informativas/aviso
    @param oError     object  Objeto de erro SmartX
    @param oSuccess   object  Objeto de sucesso SmartX (pode ser Nil)
/*/
Static Function fExibeLogMsg934(aLogError as array, aLogMsg as array, oError as object, oSuccess as object)

    Local cMsg As Character
    Local nI   As Numeric

    cMsg := ""

    If Len(aLogError) > 0
        For nI := 1 To Len(aLogError)
            cMsg += " | " + aLogError[nI]
            If nI < Len(aLogError)
                cMsg += ";"
            EndIf
        Next nI
        oError:set(400, STR0044, cMsg) // "Erro(s) na validacao:"
    ElseIf Len(aLogMsg) > 0
        For nI := 1 To Len(aLogMsg)
            cMsg += " | " + aLogMsg[nI]
            If nI < Len(aLogMsg)
                cMsg += ";"
            EndIf
        Next nI
        If oSuccess != Nil
            oSuccess:set(200, STR0045, cMsg) // "Integracao eSocial (S-1020):"
        EndIf
    EndIf

Return
