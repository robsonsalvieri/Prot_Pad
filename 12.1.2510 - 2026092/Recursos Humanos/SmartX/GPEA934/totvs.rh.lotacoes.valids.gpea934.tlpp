#include 'fw-tlpp-core.th'
#include "protheus.ch"
#include "totvs.framework.model.events.th"
#Include "totvs.rh.lotacoes.valids.gpea934.ch"

namespace totvs.rh.lotacoes.valids

Function vldTpInscRJ3(xValue as variant, cField as character, aContextInfo as array) as Json

    Local jRet    As Json
    Local lRet    As Logical
    Local cMsg    As Character
    Local cTpInsc As Character
    Local cTpLot  As Character
    Local cTipos  As Character
    Local cTipos2 As Character

    jRet    := JsonObject():new()
    lRet    := .T.
    cMsg    := ""
    cTpInsc := AllTrim(xValue)
    cTpLot  := ""
    cTipos  := ""
    cTipos2 := ""

    If Len(aContextInfo) >= 1
        cTpLot := AllTrim(aContextInfo[1])
    EndIf

    // Equivalente a fGp17VlLot so valida quando ambos estao preenchidos
    If !Empty(cTpLot) .And. !Empty(cTpInsc)
        If cTpLot $ "04|05|06|08" .And. !(cTpInsc == "1")
            lRet   := .F.
            cTipos := STR0004 // "04, 05, 06 e 08"
            cTipos2 := STR0005 // "1 (CNPJ)"
        ElseIf cTpLot $ "03|07" .And. !(cTpInsc == "2")
            lRet   := .F.
            cTipos := STR0006 // "03 e 07"
            cTipos2 := STR0007 // "2 (CPF)"
        ElseIf cTpLot == "02" .And. !(cTpInsc == "4")
            lRet   := .F.
            cTipos := "02"
            cTipos2 := STR0008 // "4 (CNO)"
        ElseIf cTpLot $ "09" .And. !(cTpInsc $ "1|2")
            lRet   := .F.
            cTipos := "09"
            cTipos2 := STR0009 // "1 (CNPJ) ou 2 (CPF)"
        EndIf
    EndIf

    If !lRet
        cMsg := STR0001 + cTipos + STR0002 + cTipos2 + STR0003 // "Tipo de inscricao invalido para os tipos de lotacao " + cTipos + " deve-se utilizar o tipo de inscricao " + cTipos2 + " para o eSocial."
    EndIf

    jRet["return"]           := lRet
    jRet["notValidMessage"] := cMsg

Return jRet

Function vldIniRJ3(xValue as variant, cField as character, aContextInfo as array) as Json

    Local jRet  As Json
    Local lRet  As Logical
    Local cPer  As Character
    Local nAno  As Numeric
    Local nMes  As Numeric

    jRet := JsonObject():new()
    lRet := .T.
    cPer := AllTrim(xValue)

    If Empty(cPer)
        lRet := .F.
    Else
        nAno := Val(SubStr(cPer, 1, 4))
        nMes := Val(SubStr(cPer, 5, 2))
        If (nAno < 1900 .Or. nAno > 3000) .Or. (nMes < 1 .Or. nMes > 12)
            lRet := .F.
        EndIf
    EndIf

    jRet["return"]          := lRet
    jRet["notValidMessage"] := If(lRet, "", STR0010) // "Periodo Invalido! Verifique o formato (AAAAMM)."

Return jRet
