@version P12
/*/
class S057DataArray
    public method new() as object
    public method getData() as array
endClass

/*{Protheus.doc} new
Instância do objeto da classe

@type method

@author  guilherme.suttanni
@since   04/12/2025
@version P12
/*/
method new() as object class S057DataArray
return self

/*/{Protheus.doc} getData
Monta array de dados da tabela S057

@type method

@author  guilherme.suttanni
@since   04/12/2025
@version P12

@return array, dados da tabela S057
/*/
method getData() as array class S057DataArray
    Local aData      := {}
    Local cFilRCC    := xFilial("RCC")
    Local cTabela    := "S057"
    Local cQuery     := ""
    Local cAliasTmp  := ""
    Local oStatement := NIL
    Local nParamOrder := 0
    Local cConteudo
    Local cSequencia
    Local aCampos
    Local cCodigo
    Local cDescri

    // Query baseada na lógica da GP310SXB original
    cQuery := "SELECT RCC_SEQUEN, RCC_CONTEU "
    cQuery += "FROM " + RetSqlName("RCC") + " RCC "
    cQuery += "WHERE RCC.RCC_FILIAL = ? "
    cQuery += "  AND RCC.RCC_CODIGO = ? "
    cQuery += "  AND RCC.D_E_L_E_T_ = ? "
    cQuery += "ORDER BY RCC_SEQUEN "
    cQuery := ChangeQuery(cQuery)

    oStatement := FwExecStatement():New(cQuery)

    nParamOrder := 1
    oStatement:SetString(nParamOrder++, cFilRCC)
    oStatement:SetString(nParamOrder++, cTabela)
    oStatement:SetString(nParamOrder++, " ")

    cAliasTmp := oStatement:OpenAlias()

    If (cAliasTmp)->(!Eof())
        While (cAliasTmp)->(!Eof())
            cConteudo   := AllTrim((cAliasTmp)->RCC_CONTEU)
            cSequencia  := AllTrim((cAliasTmp)->RCC_SEQUEN)
            aCampos     := {}
            cCodigo     := ""
            cDescri     := ""

            // Extrai os campos do conteúdo baseado na estrutura da tabela S057
            If !Empty(cConteudo)
                aCampos := fExtraiCamposRCC(cConteudo, cTabela)

                If Len(aCampos) >= 2
                    cCodigo := AllTrim(aCampos[1])
                    cDescri := AllTrim(aCampos[2])

                    // Adiciona ao array de dados - campos: Sequencia, Codigo, Descricao
                    AAdd(aData, {cSequencia, cCodigo, cDescri})
                EndIf
            EndIf

            (cAliasTmp)->(dbSkip())
        EndDo
    EndIf

    (cAliasTmp)->(dbCloseArea())
return aData

/*/{Protheus.doc} fExtraiCamposRCC
Extrai campos do conteúdo RCC baseado na estrutura da tabela

@type function

@author  guilherme.suttanni
@since   04/12/2025
@version P12

@param cConteudo - Conteúdo do campo RCC_CONTEU
@param cTabela - Código da tabela
@return aCampos - Array com os campos extraídos
/*/
Static Function fExtraiCamposRCC(cConteudo, cTabela)
    Local aCampos     := {}
    Local aStruTab    := {}
    Local nPos        := 1
    Local nI          := 0
    Local cCampo      := ""
    Local nTamCampo   := 0

    // Obtém estrutura da tabela S057 da RCB
    aStruTab := fObtemEstruturaTabela(cTabela)

    // Extrai cada campo baseado na estrutura
    For nI := 1 To Len(aStruTab)
        nTamCampo := aStruTab[nI][2] // Tamanho do campo

        If nPos <= Len(cConteudo)
            cCampo := SubStr(cConteudo, nPos, nTamCampo)
            AAdd(aCampos, cCampo)
            nPos += nTamCampo
        Else
            AAdd(aCampos, "")
        EndIf
    Next nI

Return aCampos

/*/{Protheus.doc} fObtemEstruturaTabela
Obtém estrutura da tabela da RCB

@type function

@author  guilherme.suttanni
@since   04/12/2025
@version P12

@param cTabela - Código da tabela
@return aEstrutura - Array com estrutura da tabela
/*/
Static Function fObtemEstruturaTabela(cTabela)
    Local aEstrutura := {}
    Local cFilRCB    := xFilial("RCB")
    Local aAreaRCB   := RCB->(GetArea())

    dbSelectArea("RCB")
    dbSetOrder(1) // RCB_FILIAL + RCB_CODIGO + RCB_ORDEM

    If RCB->(dbSeek(cFilRCB + cTabela))
        While RCB->(!Eof()) .And. RCB->(RCB_FILIAL + RCB_CODIGO) == (cFilRCB + cTabela)
            // Array: [Nome do Campo, Tamanho, Tipo]
            AAdd(aEstrutura, {AllTrim(RCB->RCB_CAMPOS), RCB->RCB_TAMAN, RCB->RCB_TIPO})
            RCB->(dbSkip())
        EndDo
    EndIf

    RestArea(aAreaRCB)

Return aEstrutura
