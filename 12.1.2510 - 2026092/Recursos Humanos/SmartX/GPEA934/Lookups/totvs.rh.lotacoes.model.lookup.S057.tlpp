#include "totvs.framework.structure.model.th"
#Include "totvs.rh.lotacoes.model.lookup.S057.ch"

namespace totvs.rh.lotacoes.model.lookup

@totvsFrameworkStructureModel(lookup=.T., country="ALL", description="Tabela S057 - Lotacoes Tributarias")

class S057 from totvs.framework.structure.model.data
    public method new() as object
    public method setModel()
EndClass

/*/{Protheus.doc} new
Instância do objeto da classe

@type method

@author  guilherme.suttanni
@since   04/12/2025
@version P12

@return object, objeto da classe
/*/
Method new() as object class S057
    _Super:new(,,.T.)
Return self

/*/{Protheus.doc} setModel
Definição do modelo de dados para Tabela S057 - Lotações Tributárias

@type method

@author  guilherme.suttanni
@since   04/12/2025
@version P12
/*/
method setModel() class S057
    Local oHeader as Object
    Local oArray  as Object
    Local oField  as Object
    Local oIndex  as Object
    Local oFinder as Object

    oHeader := totvs.framework.structure.object.BuildFromCode():new("XTX")

    // Campo Sequencia
    oField := totvs.framework.structure.object.BuildFieldProperties():new("XTX_SEQ")
    oField:setType("C")
    oField:setTitle(STR0001) // "Sequência"
    oField:setDescription(STR0001) // "Sequência"
    oField:setSize(3)
    oField:setOrder(1)
    oField:setRequired(.T.)
    oField:setUpperCase(.T.)
    oHeader:addFieldProperties(oField:getFieldProperties())

    // Campo Codigo da Lotacao
    oField := totvs.framework.structure.object.BuildFieldProperties():new("XTX_CODIGO")
    oField:setType("C")
    oField:setTitle(STR0002) // "Código"
    oField:setDescription(STR0003) // "Código da Lotação"
    oField:setSize(4)
    oField:setOrder(2)
    oField:setRequired(.T.)
    oField:setUpperCase(.T.)
    oHeader:addFieldProperties(oField:getFieldProperties())

    // Campo Descricao
    oField := totvs.framework.structure.object.BuildFieldProperties():new("XTX_DESCRI")
    oField:setType("C")
    oField:setTitle(STR0004) // "Descrição"
    oField:setDescription(STR0005) // "Descrição da Lotação Tributária"
    oField:setSize(100)
    oField:setOrder(3)
    oField:setRequired(.T.)
    oField:setUpperCase(.T.)
    oHeader:addFieldProperties(oField:getFieldProperties())

    oHeader:setTitle(STR0006) // "Tabela S057 - Lotações Tributárias"

    oIndex := totvs.framework.structure.object.BuildIndex():new("XTX" + cEmpAnt + "0")
    oIndex:setOrder("1")
    oIndex:setKeyFields({"XTX_CODIGO"})
    oHeader:addIndexConstraint(oIndex:getIndex())

    oFinder := totvs.framework.structure.model.finder():new()
    oFinder:setFinder({"XTX_CODIGO"}, "", .T.)
    oHeader:addFinder(oFinder:getFinder())

    oHeader:setUniqueKeyConstraint("XTX" + cEmpAnt + "0", {"XTX_CODIGO"})

    oArray := S057DataArray():new()

    self:setObject(oHeader:getObject(), "XTX",,,,,, oArray)

    self:setOrder({{"XTX_CODIGO", .F.}})
    self:LoadEventsFromMetadata()
return

