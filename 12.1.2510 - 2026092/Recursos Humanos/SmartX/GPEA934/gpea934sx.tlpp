#include "protheus.ch"
#include "GPEA934SX.CH"

Static lMiddleware := If( cPaisLoc == 'BRA' .AND. Findfunction("fVerMW"), fVerMW(), .F. )

function GPEA934SX()
    Local oLauncher  as Object
    Local aDados     := {} as Array

    //Primeiro parâmetro da VldRotTab, quais eventos validar {S-1005, S-1010, S-1020}
    If !VldRotTab({.F.,.F.,.T.},@aDados)
        Help( " ", 1, OemToAnsi(STR0001),, ;
            CRLF + aDados[1] + CRLF + CRLF + ;
            OemToAnsi(STR0002) + CRLF + ;
            OemToAnsi(STR0003), 1, 0 )
        Return
    EndIf

    oLauncher := totvs.framework.application.smartx.launcher():new()
    oLauncher:setInterface("totvs.rh.lotacoes.interface.gpea934")
    oLauncher:open()
Return
