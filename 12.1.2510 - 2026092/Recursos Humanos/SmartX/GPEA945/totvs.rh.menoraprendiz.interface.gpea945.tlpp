#include 'fw-tlpp-core.th'
#include "protheus.ch"
#include "totvs.framework.structure.interface.th"
#include "totvs.rh.menoraprendiz.interface.gpea945.ch"

namespace totvs.rh.menoraprendiz.interface

@totvsFrameworkStructureInterface(lookup=.F., country="BRA", description="Informacoes Complementares Menor Aprendiz")

class GPEA945
    private data oInterface     as object
    private data oDataNew       as object
    private data oDataEdit      as object
    private data oDataDetail    as object
    private data oDataView      as object

    public method new() as object
    public method setInterface()
    public method getContract() as json

EndClass

/*/{Protheus.doc} new
Construtor
@author caio.kretzer
@since 12/08/2026
/*/
Method new() as object class GPEA945
Return self

/*/{Protheus.doc} setInterface
Metodo para construir interface
@author caio.kretzer
@since 12/08/2026
/*/
Method setInterface() class GPEA945

    Local oElementsCabec    as object
    Local oElementsRU2      as object
    Local aElements         as array

    ::oInterface := totvs.framework.structure.interface.BuildContract():new("gpea945")
    ::oInterface:setTitle(STR0001)
    ::oInterface:setModelId("totvs.rh.menoraprendiz.model.gpea945", .t.)
    ::oInterface:setVersion("1.0")

    // CABECALHO - Matricula, Nome e Data de Admissao
    oElementsCabec := totvs.framework.structure.interface.BuildElementsFromCode():new()
    oElementsCabec:addElements({"RA_MAT", "RA_NOME", "RA_ADMISSA", "RA_CATEFD"}, .F.)

    // DETALHE - Campos do Menor Aprendiz (RU2)
    oElementsRU2 := totvs.framework.structure.interface.BuildElementsFromCode():new()
    oElementsRU2:addElements({"RU2"}, .F.)

    // Mescla cabecalho + detalhe
    aElements := totvs.framework.structure.interface.BuildElementsFromCode():mergeElements(;
        oElementsCabec:getElements(),;
        oElementsRU2:getElements();
    )

    // Mantemos apenas Alterar, Visualizar e Excluir
    ::oDataEdit := totvs.framework.structure.interface.BuildDataEdit():new("gpea945Edit", "totvs.rh.menoraprendiz.model.gpea945")
    ::oDataEdit:setTitle(STR0002)
    ::oDataEdit:setElement(aElements)

    ::oDataDetail := totvs.framework.structure.interface.BuildDataDetail():new("gpea945Detail", "totvs.rh.menoraprendiz.model.gpea945")
    ::oDataDetail:setTitle(STR0003)
    ::oDataDetail:setElement(aElements)

    ::oDataView := totvs.framework.structure.interface.BuildDataView():new("gpea945View", "totvs.rh.menoraprendiz.model.gpea945")
    ::oDataView:setModelId("totvs.rh.menoraprendiz.model.gpea945")
    ::oDataView:setTitle(STR0004)
    ::oDataView:assignInvisibleFields()
    ::oDataView:hideStandardPageAction("newAction")

    ::oInterface:setDataEdit(::oDataEdit:getDataEdit(), .f.)
    ::oInterface:setDataDetail(::oDataDetail:getDataDetail(), .f.)
    ::oInterface:setDataView(::oDataView:getDataView())

return

/*/{Protheus.doc} getContract
Retorna o contrato da interface
@author caio.kretzer
@since 12/08/2026
/*/
Method getContract() as json class GPEA945
return ::oInterface:getContract()
