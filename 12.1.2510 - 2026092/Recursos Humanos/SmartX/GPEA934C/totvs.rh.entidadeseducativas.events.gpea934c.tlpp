#Include "fw-tlpp-core.th"
#Include "protheus.ch"
#Include "totvs.framework.model.events.th"
#Include "TopConn.ch"
#Include "RestFul.ch"
#Include "Totvs.ch"
#Include "FWMVCDEF.ch"
#include "gpea934csx.ch"


namespace totvs.rh.entidadeseducativas.events

/*/ {Protheus.doc} GPEA934CEvents
    Eventos do cadastro de entidadeseducativas - SmartX
    @author guilherme.suttanni
    @since 16/09/2025
/*/
class GPEA934CEvents
    public method new() as object

    @beforeCreateInTransaction()
    public method beforeCreateInTransaction(oData, oModel, oError) as logical

    @beforeUpdateInTransaction()
    public method beforeUpdateInTransaction(oData, oModel, oError) as logical

    @beforeDeleteInTransaction()
    public method beforeDeleteInTransaction(oData, oModel, oError) as logical
EndClass

Method new() as object class GPEA934CEvents
Return self

/*/ {Protheus.doc} beforeCreateInTransaction
    Evento executado antes da inclusão
    @author guilherme.suttanni
    @since 23/09/2025
    @param oData - Dados do registro
    @param oModel - Modelo de dados
    @param oError - Objeto de erro
    @return lRet - Se pode incluir
/*/
method beforeCreateInTransaction(oData as object, oModel as object, oError as object) as logical class GPEA934CEvents
    Local lRet      := .T.
    Local oRJ6 as object

    oRJ6 := oData:GetData()
    VarInfo("oRJ6", oRJ6)

    DbSelectArea("RJ6")
    DbSetOrder(1)
    RJ6->(DbSeek(oRJ6:RJ6_FILIAL+oRJ6:RJ6_INI+oRJ6:RJ6_TPINSC+oRJ6:RJ6_NINSCR+oRJ6:RJ6_ENTEDU))

    if (!RJ6->(EOF()))
        //STR0001 - "Já existe um registro com a mesma Data Início, Tp. Inscrição, Nm. Inscrição e Entid. Educ."
        oError:set(400, STR0001)
            Return .F.
    endif   
return lRet

/*/ {Protheus.doc} beforeDeleteInTransaction
    Evento executado antes da exclusão
    @author guilherme.suttanni
    @since 19/09/2025
    @param oData - Dados do registro
    @param oModel - Modelo de dados
    @param oError - Objeto de erro
    @return lRet - Se pode excluir
/*/
method beforeDeleteInTransaction(oData as object, oModel as object, oError as object) as logical class GPEA934CEvents
    Local lRet       := .T.
return lRet
