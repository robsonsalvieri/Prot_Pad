#include "tlpp-core.th"
#include "totvs.ch"

using namespace totvs.framework.application.smartx

/*/{Protheus.doc} GPEA420SX
Abre o cadastro de processos no SmartX.
@type function
@author Guilherme Suttanni
@since 03/09/2026
/*/
Function GPEA420SX()
    Local oLauncher as object

    If cPaisLoc $ "BRA/RUS"
        GpIniProc()
    EndIf

    oLauncher := launcher():new()
    oLauncher:setInterface("totvs.rh.processo.interface.gpea420")
    oLauncher:open()
Return
