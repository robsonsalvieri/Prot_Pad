#include "tlpp-core.th"
#include "totvs.ch"
#include "totvs.framework.model.events.th"
#include "totvs.rh.processo.events.gpea420.ch"

using namespace totvs.framework.model.events

namespace totvs.rh.processo.events

/*/{Protheus.doc} GPEA420Events
Preserva as regras transacionais do cadastro de processos no SmartX.
@type class
@author Guilherme Suttanni
@since 03/09/2026
/*/
class GPEA420Events
    public method new() as object

    @beforeCreateInTransaction()
    public method beforeCreateInTransaction(oData as object, oModel as object, oError as object, oSuccess as object) as logical

    @beforeUpdateInTransaction()
    public method beforeUpdateInTransaction(oData as object, oModel as object, oError as object, oSuccess as object) as logical

    @beforeDeleteInTransaction()
    public method beforeDeleteInTransaction(oData as object, oModel as object, oError as object, oSuccess as object) as logical

    private method validarAlteracao(oData as object, oError as object) as logical
    private method possuiVinculos(cCodigo as character, aVinculos as array) as logical
    private method possuiPeriodos(cCodigo as character) as logical
    private method montarLogExclusao(cCodigo as character, aVinculos as array, lTemPeriodos as logical) as character
EndClass

/*/{Protheus.doc} GPEA420Events::new
Instancia os eventos do cadastro de processos.
@type method
@author Guilherme Suttanni
@since 03/09/2026
@return object, Instancia dos eventos
/*/
Method new() as object class GPEA420Events
Return self

/*/{Protheus.doc} GPEA420Events::beforeCreateInTransaction
Prepara e valida os dados antes da inclusao.
@type method
@author Guilherme Suttanni
@since 03/09/2026
@param oData, object, Dados da entidade
@param oModel, object, Modelo da operacao
@param oError, object, Retorno de erro
@param oSuccess, object, Retorno de sucesso
@return logical, Indica se a inclusao pode continuar
/*/
method beforeCreateInTransaction(oData as object, oModel as object, oError as object, oSuccess as object) as logical class GPEA420Events
    oData:setFieldValue("RCJ", "RCJ_FILIAL", "", xFilial("RCJ"))
    If MV_MODFOL == "1"
        oData:setFieldValue("RCJ", "RCJ_ORIGEM", "", "2")
    EndIf
Return .T.

/*/{Protheus.doc} GPEA420Events::beforeUpdateInTransaction
Valida os dados antes da alteracao.
@type method
@author Guilherme Suttanni
@since 03/09/2026
@param oData, object, Dados da entidade
@param oModel, object, Modelo da operacao
@param oError, object, Retorno de erro
@param oSuccess, object, Retorno de sucesso
@return logical, Indica se a alteracao pode continuar
/*/
method beforeUpdateInTransaction(oData as object, oModel as object, oError as object, oSuccess as object) as logical class GPEA420Events
Return ::validarAlteracao(oData, oError)

/*/{Protheus.doc} GPEA420Events::beforeDeleteInTransaction
Valida os vinculos antes da exclusao.
@type method
@author Guilherme Suttanni
@since 03/09/2026
@param oData, object, Dados da entidade
@param oModel, object, Modelo da operacao
@param oError, object, Retorno de erro
@param oSuccess, object, Retorno de sucesso
@return logical, Indica se a exclusao pode continuar
/*/
method beforeDeleteInTransaction(oData as object, oModel as object, oError as object, oSuccess as object) as logical class GPEA420Events
    Local aVinculos    := {} as array
    Local cCodigo      := oData:getFieldValue("RCJ", "RCJ_CODIGO") as character
    Local cDetalhes    := "" as character
    Local lTemPeriodos := .F. as logical
    Local lTemVinculos := .F. as logical

    If oData:getFieldValue("RCJ", "RCJ_ORIGEM") == "1"
        oError:set(400, STR0001, STR0002) // Cadastro de Processos | Não é possível Excluir um Processo de Sistema
        Return .F.
    EndIf

    lTemPeriodos := ::possuiPeriodos(cCodigo)
    lTemVinculos := ::possuiVinculos(cCodigo, @aVinculos)

    If lTemPeriodos .Or. lTemVinculos
        cDetalhes := ::montarLogExclusao(cCodigo, aVinculos, lTemPeriodos)
        oError:set(400, STR0004, cDetalhes) // Registro em Uso por outro Usuario
        Return .F.
    EndIf
Return .T.

method validarAlteracao(oData as object, oError as object) as logical class GPEA420Events
    Local aAreaRCJ   := RCJ->(GetArea()) as array
    Local cCodigo    := oData:getFieldValue("RCJ", "RCJ_CODIGO") as character
    Local cDescricao := oData:getFieldValue("RCJ", "RCJ_DESCRI") as character
    Local lRet       := .T. as logical

    RCJ->(DbSetOrder(1))
    RCJ->(DbSeek(xFilial("RCJ") + cCodigo))
    If MV_MODFOL == "1" .And. RCJ->RCJ_ORIGEM == "1" .And. ;
        !(RCJ->RCJ_DESCRI == cDescricao)
        oError:set(400, STR0001, STR0006) // Cadastro de Processos | Não é possível alterar um processo de Sistema
        lRet := .F.
    EndIf

    RestArea(aAreaRCJ)
Return lRet

method possuiVinculos(cCodigo as character, aVinculos as array) as logical class GPEA420Events
    Local aAreaRCJ     := RCJ->(GetArea()) as array
    Local lPodeExcluir := .T. as logical

    aVinculos := {}
    RCJ->(DbSetOrder(1))
    RCJ->(DbSeek(xFilial("RCJ") + cCodigo))
    lPodeExcluir := ChkDelRegs(;
        "RCJ",;
        RCJ->(Recno()),;
        5,;
        xFilial("RCJ"),;
        cCodigo,;
        NIL,;
        NIL,;
        NIL,;
        NIL,;
        .F.,;
        .F.,;
        @aVinculos,;
        NIL;
    )

    RestArea(aAreaRCJ)
Return !lPodeExcluir

method possuiPeriodos(cCodigo as character) as logical class GPEA420Events
    Local aAreaRCH    := RCH->(GetArea()) as array
    Local lTemPeriodo := .F. as logical

    RCH->(DbSetOrder(1))
    lTemPeriodo := RCH->(DbSeek(xFilial("RCH") + cCodigo))

    RestArea(aAreaRCH)
Return lTemPeriodo

method montarLogExclusao(cCodigo as character, aVinculos as array, lTemPeriodos as logical) as character class GPEA420Events
    Local aArquivos  := {} as array
    Local aDescricoes := {} as array
    Local cAlias     := "" as character
    Local cArquivo   := "" as character
    Local cArquivos  := "" as character
    Local cDetalhes  := "" as character
    Local cLinha     := "" as character
    Local nArquivo   := 0 as numeric

    For nArquivo := 1 To Len(aVinculos)
        If ValType(aVinculos[nArquivo]) == "C" .And. !Empty(aVinculos[nArquivo])
            cLinha := AllTrim(aVinculos[nArquivo])
            cAlias := Left(cLinha, 3)
            If Len(cLinha) > 3 .And. SubStr(cLinha, 4, 1) == " " .And. AliasInDic(cAlias)
                AAdd(aArquivos, cAlias)
            EndIf
        EndIf
    Next nArquivo

    If lTemPeriodos
        AAdd(aArquivos, "RCH")
    EndIf

    For nArquivo := 1 To Len(aArquivos)
        If AScan(aArquivos, aArquivos[nArquivo]) == nArquivo
            cArquivo := StrTran(STR0008, "%1", AllTrim(InfoSX2(aArquivos[nArquivo], "X2_NOME"))) // %1 (%2)
            cArquivo := StrTran(cArquivo, "%2", aArquivos[nArquivo])
            AAdd(aDescricoes, cArquivo)
        EndIf
    Next nArquivo

    For nArquivo := 1 To Len(aDescricoes)
        cArquivos += IIf(Empty(cArquivos), "", IIf(nArquivo == Len(aDescricoes), STR0010, STR0009)) + aDescricoes[nArquivo] // " e " | ", "
    Next nArquivo

    cDetalhes := StrTran(STR0007, "%1", AllTrim(cCodigo)) // O processo %1 não pode ser excluído, pois está sendo utilizado nos seguintes arquivos: %2.
    cDetalhes := StrTran(cDetalhes, "%2", cArquivos)
Return cDetalhes

/*/{Protheus.doc} gpea420Replicar
Executa a replicacao legada no contexto funcional do GPEA420.
@type function
@author Guilherme Suttanni
@since 03/09/2026
/*/
Function gpea420Replicar()
    Local cFuncao := FunName() as character

    SetFunName("GPEA420")
    GPEM941()
    SetFunName(cFuncao)
Return
