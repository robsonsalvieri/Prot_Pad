#INCLUDE "PONM050.CH"
#INCLUDE "PROTHEUS.CH"
#INCLUDE "PONCALEN.CH"

Static lPort1510 			:= Port1510() 	//Verifica se Portaria 1510/2009 esta em vigor.
Static __oFWSt				:= Nil
Static oESPN50Del
Static aSitQry				:= {}	
Static aCatQry				:= {}
Static cAcessaSRA			:= ""

/*/{Protheus.doc} PONM050
Exclusao de Informacoes geradas pelo SIGAPON
@type function
@author Cícero Alves
@since 12/12/2025
@return NIL, NIL
/*/
Function PONM050()
	
	Local aArea			:= GetArea()
	Local aSays   		:= {}
	Local aButtons		:= {}
	Local nOpcA			:= 0
	
	Private cCadastro   := OemToAnsi(STR0001 ) // 'Eliminação das Marcações'
	Private lBlind		:= IsBlind()
	
	If lPort1510
		cCadastro += fPortTit() // Complementa titulo da tela com dizeres referente a portaria.
	EndIf
	
	// Só Executa se os Modos de Acesso dos Arquivos Relacionados estiverm OK.
	If ValidArqPon()
		
		Pergunte('PNM050', .F.)
		
		If !lBlind
			
			aAdd(aSays, OemToAnsi(STR0003)) //	'Este programa tem como objetivo efetuar a Eliminação de :'
			aAdd(aSays, OemToAnsi(STR0004)) //	'- Marcações(SP8)________Acumulado de Marcações(SPG)'
			aAdd(aSays, OemToAnsi(STR0005)) //	'- Apontamentos(SPC)_____Acumulados Apontamentos(SPH)'
			aAdd(aSays, OemToAnsi(STR0006)) //	'- Refeições(SP5)________Acumulado de Refeições(SPN)'
			aAdd(aSays, OemToAnsi(STR0007)) //	'- Resultados(SPB)_______Abonos(SPK)'
			aAdd(aSays, OemToAnsi(STR0008)) //	'- Banco de Horas(SPI)___Abonos(SPK)'
			
			If lPort1510
				aAdd(aSays,OemToAnsi( STR0020 ) )	// 'Obs.: As marcações originais não serão eliminadas.'
			EndIf
			
			aAdd(aButtons, {5, .T., {| | Pergunte("PNM050", .T. )}})
			aAdd(aButtons, {1, .T., {|o| nOpcA := 1, If(GpConfOK(), FechaBatch(), nOpcA := 0 )}})
			aAdd(aButtons, {2, .T., {|o| FechaBatch()}})
			
			FormBatch( cCadastro, aSays, aButtons )
			
			If nOpcA == 1
				// Executa o Processo de Exclusao de Marcações
				Processa({|| Ponm050Proc()}, STR0001, , .F.)
			EndIf
		Else
			Ponm050Proc()
		EndIf
	EndIf
	
	CleanStatic()
	
	RestArea( aArea )
	
Return NIL

/*/{Protheus.doc} Ponm050Proc
Realiza a exclusão dos Registros
@type satic function
@author Cícero Alves
@since 12/12/2025
@return NIL, NIL
/*/
Static Function Ponm050Proc()
	Local aLog			:= {}
	Local aLogTitulo	:= {}
	Local cTipo     	:= ""
	Local lDtApo		:= .F.
	Local lSP8      	:= .F.
	Local lSPG      	:= .F.
	Local lSPC      	:= .F.
	Local lSPH      	:= .F.
	Local lSP5      	:= .F.
	Local lSPN      	:= .F.
	Local lSPB      	:= .F.
	Local lSPL			:= .F.
	Local lSPI      	:= .F.
	Local lSPK      	:= .F.
	Local lDeletFunc	:= .F. 
	Local nLimpa    	:= 2
	Local nTotal		:= 10
	Local nI			:= 1
	Local lErroQry		:= .F.
	
	Static cAliasErro := ""
	Static aLogSuces := {}
	Static aLogErro := {}
	
	// Carrega as Perguntas em Variaveis MV_PAR
	Pergunte( "PNM050", .F. )
	
	// Carregando as Perguntas
	lSP8      	:= ( MV_PAR13 == 2 .Or. MV_PAR13 == 4 )		// Excluir Marcacoes: 1=Nao; 2;Movimento; 4=Ambos
	lSPG      	:= ( MV_PAR13 == 3 .Or. MV_PAR13 == 4 )		// Excluir Marcacoes: 1=Nao; 3=Acumulado; 4=Ambos
	lSP5      	:= ( MV_PAR14 == 2 .Or. MV_PAR14 == 4 )		// Excluir Refeicoes: 1=Nao; 2=Movimento; 4=Ambos
	lSPN      	:= ( MV_PAR14 == 3 .Or. MV_PAR14 == 4 )		// Excluir Refeicoes: 1=Nao; 3=Acumulado; 4=Ambos
	lSPC      	:= ( MV_PAR15 == 2 .Or. MV_PAR15 == 4 )		// Excluir Apontamentos: 1=Nao; 2=Movimento; 4=Ambos
	lSPH      	:= ( MV_PAR15 == 3 .Or. MV_PAR15 == 4 )		// Excluir Apontamentos: 1=Nao; 3=Acumulado; 4=Ambos
	lSPB      	:= ( MV_PAR16 == 2 .Or. MV_PAR16 == 4 )		// Excluir Resultados: 1=Nao; 2=Movimento; 4=Ambos
	lSPL      	:= ( MV_PAR16 == 3 .Or. MV_PAR16 == 4 )		// Excluir Resultados: 1=Nao; 3=Acumulado; 4=Ambos
	lSPK      	:= ( MV_PAR17 == 1 )						// Excluir Abonos
	lSPI      	:= ( MV_PAR18 == 1 )						// Excluir Banco de Horas
	cTipo     	:= RetTipoExclu( MV_PAR19 )					// Tipo a Ser Excluido: 1=Gerado; 2=Informado; 3=Leitura; 4=Marcacao; 5=Classificado
	nLimpa    	:= MV_PAR20 								// Exclui Todos os Tipos: 1=Sim; 2=Nao
	
	lDtApo := (MV_PAR27 == 1) //-- Elimina marcacoes/refeicoes pela data de apontamento

	aSitQry := {}
	aCatQry := {}

	// Cria o array de situações para ser utilizado nas queries
	For nI := 1 to Len(MV_PAR25)
		aAdd(aSitQry, Subs(MV_PAR25, nI, 1)) 
	Next
	
	// Cria o array de categorias para ser utilizado nas queries
	For nI := 1 to Len(MV_PAR26)
		aAdd(aCatQry, Subs(MV_PAR26, nI, 1))
	Next

	// Cria a tabela temporário dos filtros de filiais.
	If oTempTable == NIL
		CreateTmpFil()
	EndIf

	cAcessaSRA := fSFiltrSQL(ChkRH("PONM050", "SRA", "2"))
	
	If !lBlind
		// Pergunta se deseja prosseguir com a exclusao de todos os registros do ponto do funcionario
		If lSP8 .And. lSPG .And. lSP5 .And. lSPN .And. lSPC .And. lSPH .And. lSPB .And. lSPL .And. lSPK .And. lSPI .And. nLimpa == 1
			// "Atenção"
			// "Se as opções 'Excluir Marcações', 'Excluir Refeiçoes', 'Excluir Apontamento', 'Excluir Resultados' estiverem definidas como 'Ambos' e as opções 'Excluir Abonos', 'Excl. Banco Horas' e 'Limpar Todos Tipos' estiverem definidas como 'Sim', todos os registros de ponto do funcionário serão excluídos caso não exista uma marcação original."
			// "Para mais detalhes, consulte a documentação em: "
			// "Deseja prosseguir?"
			lDeletFunc := MsgNoYes(STR0031 + CRLF + CRLF + STR0022 + "https://tdn.totvs.com/pages/viewpage.action?pageId=1005905635" + CRLF + CRLF + STR0023, STR0024)
		EndIf
	EndIf
	
	Begin Sequence
		
		// Processa a Exclusão
		If lDeletFunc
			nTotal++
		EndIf
		
		ProcRegua(nTotal)
		
		// Verifica e exclui todos os dados do ponto do funcionário
		If lDeletFunc
			IncProc(STR0033) // "Realizando a exclusão de todos os registros do Ponto...")
			DelFunc()
		EndIf
		
		// Deleta marcações de Refeição (SP5)
		IncProc(STR0034 + " SP5" + "...") // "Realizando a exclusão da tabela"
		If lSP5
			If !DelSp5SpnT("SP5", cTipo)
				cAliasErro := "SP5"
				BREAK
			EndIf
		EndIf
		
		// Deleta registros de Acumulados de Marcações de Refeição (SPN)
		IncProc(STR0034 + " SPN" + "...") // "Realizando a exclusão da tabela"
		If lSPN
			If !DelSp5SpnT("SPN", cTipo)
				cAliasErro := "SPN"
				BREAK
			EndIf
		EndIf
		
		// Deleta registros de Marcações (SP8)
		IncProc(STR0034 + " SP8" + "...") // "Realizando a exclusão da tabela"
		If lSP8 
			If !DeleteTop( "SP8", cTipo, lDtApo)
				cAliasErro := "SP8"
				BREAK
			EndIf
		EndIf
		
		// Deleta registros de Acumulados de Marcações (SPG)
		IncProc(STR0034 + " SPG" + "...") // "Realizando a exclusão da tabela"
		If lSPG
			If !DeleteTop( "SPG", cTipo, lDtApo)
				cAliasErro := "SPG"
				BREAK
			EndIf
		EndIf
		
		// Deleta registros de Apontamentos (SPC)
		IncProc(STR0034 + " SPC" + "...") // "Realizando a exclusão da tabela"
		If lSPC
			// Altera as marcações para não apontadas
			If !lSP8
				lErroQry := !SP8FlgAponta(lDtApo)
			EndIf
			If lErroQry .Or. !DeleteTop( "SPC", cTipo)
				cAliasErro := "SPC"
				BREAK
			EndIf
		EndIf
		
		// Deleta registros de Acumulado de Apontamentos (SPH)
		IncProc(STR0034 + " SPH" + "...") // "Realizando a exclusão da tabela"
		If lSPH
			If !DeleteTop( "SPH", cTipo)
				cAliasErro := "SPH"
				BREAK
			EndIf
		EndIf
		
		// Deleta registros de Resultados (SPB)
		IncProc(STR0034 + " SPB" + "...") // "Realizando a exclusão da tabela"
		If lSPB
			If !DeleteTop( "SPB", cTipo)
				cAliasErro := "SPB"
				BREAK
			EndIf
		EndIf
		
		// Deleta registros de Acumulado de Resultados (SPL)
		IncProc(STR0034 + " SPL" + "...") // "Realizando a exclusão da tabela"
		If lSPL
			If !DeleteTop( "SPL", cTipo)
				cAliasErro := "SPL"
				BREAK
			EndIf
		EndIf
		
		// Deleta registros de Banco de Horas (SPI)
		IncProc(STR0034 + " SPI" + "...") // "Realizando a exclusão da tabela"
		If lSPI
			If !DeleteTop( "SPI", cTipo)
				cAliasErro := "SPI"
				BREAK
			EndIf
		EndIf
		
		// Deleta registros de Abonos (SPK)
		IncProc(STR0034 + " SPK" + "...") // "Realizando a exclusão da tabela"
		If lSPK
			// Altera os apontamentos
			If !lSPC
				lErroQry := !SPCClearAbono(cTipo)
			EndIf
			
			If lErroQry .Or. !DeleteTop( "SPK", cTipo)
				cAliasErro := "SPK"
				BREAK
			EndIf
		EndIf
		
		RECOVER
			aAdd(aLogErro, STR0035 + cAliasErro ) // "Não foi possível realizar a exclusão da tabela "
			aAdd(aLogErro, STR0036 ) // "O processo foi encerrado."
			
	End Sequence
	
	If !Empty(aLogSuces)
		aAdd(aLogTitulo, STR0025 ) // "Exlusão realizada com sucesso:"
		aAdd(aLog, aClone(aLogSuces))
	EndIf
	
	If !Empty(aLogErro)
		aAdd(aLogTitulo, STR0026 ) // "Exlusão não realizada:"
		aAdd(aLog, aClone(aLogErro))
	EndIf
	
	// Gera o log de execução da exclusão
	If !lBlind
		fMakeLog(	aLog		,;	// Array que contem os Detalhes de Ocorrencia de Log
					aLogTitulo	,;	// Array que contem os Titulos de Acordo com as Ocorrencias
					"PNM050"	,;	// Pergunte a Ser Listado
					.T.			,;	// Se Havera "Display" de Tela
					FunName()	,;	// Nome Alternativo do Log
					NIL			,;	// Titulo Alternativo do Log
					"G"			,;	// Tamanho Vertical do Relatorio de Log ("P", "M", "G")
					"L"			,;	// Orientacao do Relatorio ("P" Retrato ou "L" Paisagem)
					NIL			,;	// Array com a Mesma Estrutura do aReturn
					NIL			,;	// Se deve Manter ( Adicionar ) no Novo Log o Log Anterior
					Nil			;	// Array com as perguntas selecionadas
					)
	EndIf
	
Return

/*/{Protheus.doc} DelSp5SpnT
Deleta os Dados do SP5 ou SPN
@type static function
@author Cícero Alves
@since 17/12/2025
@param cAlias, character, Tabela para a deleção dos registros (SP5 ou SPN)
@param cTipo, character, Tipo dos registros; campo XX_FLAG
@return logical, se a query foi executada corretamente
/*/
Static Function DelSp5SpnT(cAlias, cTipo)
	
	Local cPrefixo 		:= ""
	Local cQuery		:= ""
	Local cRetSqlName	:= InitSqlName(cAlias)
	Local lDeleted 		:= .F.
	Local oQryDelRef	:= NIL
	Local nParam		:= 1
	Local nLimpa 		:= MV_PAR20
	Local cNomeSGDB 	:= Upper(TCGetDB())
	
	cAlias := Upper(AllTrim(cAlias))
	cPrefixo := cAlias + "." + PrefixoCpo(cAlias) + "_"
	
	oQryDelRef := FWPreparedStatement():New()
	
	cQuery := "DELETE " 
	
	If Alltrim(cNomeSGDB) == "MSSQL"
		cQuery += "? "
	EndIf
	
	cQuery += "FROM ? ? "
	cQuery += "WHERE EXISTS( "
	cQuery += "SELECT 1 "
	cQuery += "FROM ? SRA "
	cQuery += "WHERE ? = SRA.RA_FILIAL "
	cQuery += "AND ? = SRA.RA_MAT "
	cQuery += "AND (SRA.RA_FILIAL >= ? AND SRA.RA_FILIAL <= ?) "
	cQuery += "AND (SRA.RA_CC >= ? AND SRA.RA_CC <= ?) "
	cQuery += "AND (SRA.RA_TNOTRAB >= ? AND SRA.RA_TNOTRAB <= ?) "
	cQuery += "AND (SRA.RA_MAT >= ? AND SRA.RA_MAT <= ?) "
	cQuery += "AND (SRA.RA_NOME >= ? AND SRA.RA_NOME <= ?) "
	cQuery += "AND SRA.RA_SITFOLH IN (?) "
	cQuery += "AND SRA.RA_CATFUNC IN (?) "
	cQuery += "AND SRA.D_E_L_E_T_ = ? "
	cQuery += "AND SRA.RA_FILIAL IN (SELECT TMP_FIL FROM ?) "
	
	If (!Empty(cAcessaSRA) .And. cAcessaSRA != ".T.", cQuery += "AND ? ", Nil)

	cQuery += ") "
	
	// Validações da tabela de lançamentos
	cQuery += "AND ? BETWEEN ? AND ? " // DATA
	cQuery += "AND ? >= ? " 			// TIPOREF De
	cQuery += "AND ? <= ? " 			// TIPOREF Até
	cQuery += "AND ? >= ? " 			// HORA De
	cQuery += "AND ? <= ? " 			// HORA Até
	
	If !nLimpa == 1
		cQuery += "AND ? = ? " // FLAG 
	EndIf
	
	oQryDelRef:SetQuery(cQuery)
	
	If Alltrim(cNomeSGDB) == "MSSQL"
		oQryDelRef:SetUnsafe(nParam++, cAlias) 				// Alias da tabela
	EndIf
	
	oQryDelRef:SetUnsafe(nParam++, cRetSqlName) 			// Nome físico da tabela
	oQryDelRef:SetUnsafe(nParam++, cAlias) 					// Alias da tabela
	oQryDelRef:SetUnsafe(nParam++, RetSQLName("SRA"))		// Nome fisico da tabela SRA
	oQryDelRef:SetUnsafe(nParam++, cPrefixo + "FILIAL") 	// Campo Filal
	oQryDelRef:SetUnsafe(nParam++, cPrefixo + "MAT") 		// Campo Matrícula
	oQryDelRef:SetString(nParam++, MV_PAR01)				// Filial De
	oQryDelRef:SetString(nParam++, MV_PAR02)				// Filial Até
	oQryDelRef:SetString(nParam++, MV_PAR03)				// Centro de Custo De
	oQryDelRef:SetString(nParam++, MV_PAR04)				// Centro de Custo Até
	oQryDelRef:SetString(nParam++, MV_PAR05)				// Turno De
	oQryDelRef:SetString(nParam++, MV_PAR06)				// Turno Até
	oQryDelRef:SetString(nParam++, MV_PAR07)				// Matrícula De
	oQryDelRef:SetString(nParam++, MV_PAR08)				// Matrícula Até
	oQryDelRef:SetString(nParam++, MV_PAR09)				// Nome De
	oQryDelRef:SetString(nParam++, MV_PAR10)				// Nome Até
	oQryDelRef:SetIn(nParam++, aSitQry) 					// Situações
	oQryDelRef:SetIn(nParam++, aCatQry)						// Categorias
	oQryDelRef:SetString(nParam++, " ") 					// Delete
	oQryDelRef:SetUnsafe(nParam++, oTempTable:GetRealName())	// Tabela temporária das filiais

	If (!Empty(cAcessaSRA) .And. cAcessaSRA != ".T.", oQryDelRef:SetUnsafe(nParam++, cAcessaSRA), Nil)				// Permissão de acesso da SRA
	
	// Validações da tabela de lançamentos
	oQryDelRef:SetUnsafe(nParam++, cPrefixo + "DATA") 		// Campo Data
	oQryDelRef:SetDate(nParam++, MV_PAR11) 					// Data De
	oQryDelRef:SetDate(nParam++, MV_PAR12) 					// Data Até
	oQryDelRef:SetUnsafe(nParam++, cPrefixo + "TIPOREF")	// Campo TIPOREF
	oQryDelRef:SetString(nParam++, MV_PAR23) 				// TIPOREF De
	oQryDelRef:SetUnsafe(nParam++, cPrefixo + "TIPOREF")	// Campo TIPOREF
	oQryDelRef:SetString(nParam++, MV_PAR24) 				// TIPOREF Até
	oQryDelRef:SetUnsafe(nParam++, cPrefixo + "HORA")		// Campo HORA
	oQryDelRef:SetNumeric(nParam++, MV_PAR21) 				// HORA De
	oQryDelRef:SetUnsafe(nParam++, cPrefixo + "HORA")		// Campo HORA
	oQryDelRef:SetNumeric(nParam++, MV_PAR22) 				// HORA Até
	
	If !nLimpa == 1
		oQryDelRef:SetUnsafe(nParam++, cPrefixo + "FLAG")	// Campo FLAG
		oQryDelRef:SetString(nParam++, cTipo) 				// FLAG
	EndIf 
	
	cQuery := oQryDelRef:getFixQuery()
	lDeleted := ((TcSqlExec(cQuery)) >= 0)
	
	oQryDelRef:Destroy()
	
Return lDeleted

/*/{Protheus.doc} DeleteToP
Exclui os registros no banco de dados
@type static function
@author Cícero Alves
@since 15/12/2025
@param cAlias, character, Tabela para a deleção dos registros
@param cTipo, character, Tipo dos registros; campo XX_FLAG ou XX_TIPO2
@param lDtApo, logical, Se utiliza a data de apontamento para busca das marcações
@return logical, se a query foi executada corretamente
/*/
Static Function DeleteToP(cAlias, cTipo, lDtApo)
	
	Local cPrefixo 		:= ""
	Local cQuery		:= ""
	Local cRetSqlName	:= InitSqlName( cAlias )
	Local lDeleted		:= .F.
	Local nParam		:= 1
	Local nLimpa 		:= MV_PAR20
	Local cNomeSGDB 	:= Upper(TCGetDB())
	
	Static oQryDel		:= NIL
	
	DEFAULT lDtApo := .F.
	
	cAlias		:= Upper(AllTrim(cAlias))
	cPrefixo	:= cAlias + "." + PrefixoCpo( cAlias ) + "_"
	
	If oQryDel == Nil
		
		oQryDel := FWPreparedStatement():New()
		
		cQuery := "DELETE " 
		
		If Alltrim(cNomeSGDB) == "MSSQL"
			cQuery += "? "
		EndIf
		
		cQuery += "FROM ? ? "
		cQuery += "WHERE EXISTS( "
		cQuery +=	"SELECT 1 "
		cQuery +=	"FROM ? SRA "
		cQuery +=	"WHERE ? = SRA.RA_FILIAL "
		cQuery +=		"AND ? = SRA.RA_MAT "
		cQuery +=		"AND (SRA.RA_FILIAL >= ? AND SRA.RA_FILIAL <= ?) "
		cQuery +=		"AND (SRA.RA_CC >= ? AND SRA.RA_CC <= ?) "
		cQuery +=		"AND (SRA.RA_TNOTRAB >= ? AND SRA.RA_TNOTRAB <= ?) "
		cQuery +=		"AND (SRA.RA_MAT >= ? AND SRA.RA_MAT <= ?) "
		cQuery +=		"AND (SRA.RA_NOME >= ? AND SRA.RA_NOME <= ?) "
		cQuery +=		"AND SRA.RA_SITFOLH IN (?) "
		cQuery +=		"AND SRA.RA_CATFUNC IN (?) "
		cQuery +=		"AND SRA.D_E_L_E_T_ = ? "
		cQuery +=		"AND SRA.RA_FILIAL IN (SELECT TMP_FIL FROM ?) "
		
		If (!Empty(cAcessaSRA) .And. cAcessaSRA != ".T.", cQuery += "AND ? ", Nil)
		
		cQuery += ") "
		
		// Validações da tabela de lançamentos
		cQuery += "AND ? BETWEEN ? AND ? " // DATA
		cQuery += "AND ? <> ? " // TIPOREG 'O'
		cQuery += "AND ? <> ? " // TIPOREG ' '
		
		If !nLimpa == 1
			cQuery += "AND ? = ? " // FLAG ou TIPO2
		EndIf
		
		oQryDel:SetQuery(cQuery)
	EndIf
	
	If Alltrim(cNomeSGDB) == "MSSQL"
		oQryDel:SetUnsafe(nParam++, cAlias)						// Alias da tabela
	EndIf
	
	oQryDel:SetUnsafe(nParam++, cRetSqlName)					// Nome físico da tabela
	oQryDel:SetUnsafe(nParam++, cAlias)							// Alias da tabela
	oQryDel:SetUnsafe(nParam++, RetSQLName("SRA"))				// Nome fisico da tabela SRA
	oQryDel:SetUnsafe(nParam++, cPrefixo + "FILIAL")			// Campo Filal Join
	oQryDel:SetUnsafe(nParam++, cPrefixo + "MAT")				// Campo Matrícula Join
	oQryDel:SetString(nParam++, MV_PAR01)						// Filial De
	oQryDel:SetString(nParam++, MV_PAR02)						// Filial Até
	oQryDel:SetString(nParam++, MV_PAR03)						// Centro de Custo De
	oQryDel:SetString(nParam++, MV_PAR04)						// Centro de Custo Até
	oQryDel:SetString(nParam++, MV_PAR05)						// Turno De
	oQryDel:SetString(nParam++, MV_PAR06)						// Turno Até
	oQryDel:SetString(nParam++, MV_PAR07)						// Matrícula De
	oQryDel:SetString(nParam++, MV_PAR08)						// Matrícula Até
	oQryDel:SetString(nParam++, MV_PAR09)						// Nome De
	oQryDel:SetString(nParam++, MV_PAR10)						// Nome Até
	oQryDel:SetIn(nParam++, aSitQry)							// Situações
	oQryDel:SetIn(nParam++, aCatQry)							// Categorias
	
	oQryDel:SetString(nParam++, " ")							// Delete
	oQryDel:SetUnsafe(nParam++, oTempTable:GetRealName())		// Tabela temporária das filiais

	If (!Empty(cAcessaSRA) .And. cAcessaSRA != ".T.", oQryDel:SetUnsafe(nParam++, cAcessaSRA), Nil)	// Permissão de acesso da SRA

	If lDtApo .And. cAlias $ "SP8|SPG"
		oQryDel:SetUnsafe(nParam++, cPrefixo + "DATAAPO") // Campo Data
	Else
		oQryDel:SetUnsafe(nParam++, cPrefixo + "DATA") // Campo Data
	EndIf
	
	oQryDel:SetDate(nParam++, MV_PAR11) // Data De
	oQryDel:SetDate(nParam++, MV_PAR12) // Data Até
	
	If lPort1510 .And. cAlias $ "SP8|SPG"
		oQryDel:SetUnsafe(nParam++, cPrefixo + "TIPOREG") 	// Campo TIPOREG
		oQryDel:SetString(nParam++, "O") 					// TIPOREG 'O'
		oQryDel:SetUnsafe(nParam++, cPrefixo + "TIPOREG") 	// Campo TIPOREG
		oQryDel:SetString(nParam++, " ")					// TIPOREG ' '
	Else
		oQryDel:SetString(nParam++, "1")
		oQryDel:SetString(nParam++, "2")
		oQryDel:SetString(nParam++, "1")
		oQryDel:SetString(nParam++, "2")
	EndIf
	
	If !nLimpa == 1
		If cAlias $ "SPB|SPL" // TIPO2
			oQryDel:SetUnsafe(nParam++, cPrefixo + "TIPO2")
			oQryDel:SetString(nParam++, cTipo)
		Else // FLAG
			oQryDel:SetUnsafe(nParam++, cPrefixo + "FLAG")
			If cAlias == "SPC" .AND. cTipo <> "I"
				oQryDel:SetString(nParam++, " ")
			Else
				oQryDel:SetString(nParam++, cTipo)
			EndIf
		EndIf
	EndIf
	
	cQuery := oQryDel:getFixQuery()
	lDeleted := ((TcSqlExec(cQuery)) >= 0)
	
Return lDeleted

/*/{Protheus.doc} SP8FlgAponta
Altera as marcações para não apontadas quando é selecionado para excluir o apontamento
@type static function
@author Cícero Alves
@since 16/12/2025
@param lDtApo, logical, determina se irá utilizar a data de apontamento para busca das marcações
@return logical, se a query foi executada corretamente
/*/
Static Function SP8FlgAponta(lDtApo)
	
	Local cQuery	 		:= ""
	Local oQryUpdSP8		:= NIL
	Local nParam			:= 1
	Local lUpdated			:= .F.
	Local cNomeSGDB 		:= Upper(TCGetDB())
	
	oQryUpdSP8 := FWPreparedStatement():New()
	
	If cNomeSGDB == "MSSQL"
		cQuery := "UPDATE SP8 " 
		cQuery += "SET SP8.P8_APONTA = ? "
		cQuery += "FROM ? SP8 "
	Else
		cQuery := "UPDATE ? SP8 " 
		cQuery += "SET P8_APONTA = ? "
	EndIf
	
	cQuery += "WHERE EXISTS( "
	cQuery += "SELECT 1 "
	cQuery += "FROM ? SRA "
	cQuery += "WHERE SP8.P8_FILIAL = SRA.RA_FILIAL "
	cQuery +=	"AND SP8.P8_MAT = SRA.RA_MAT "
	cQuery +=	"AND (SRA.RA_FILIAL >= ? AND SRA.RA_FILIAL <= ?) "
	cQuery +=	"AND (SRA.RA_CC >= ? AND SRA.RA_CC <= ?) "
	cQuery +=	"AND (SRA.RA_TNOTRAB >= ? AND SRA.RA_TNOTRAB <= ?) "
	cQuery +=	"AND (SRA.RA_MAT >= ? AND SRA.RA_MAT <= ?) "
	cQuery +=	"AND (SRA.RA_NOME >= ? AND SRA.RA_NOME <= ?) "
	cQuery +=	"AND SRA.RA_SITFOLH IN (?) "
	cQuery +=	"AND SRA.RA_CATFUNC IN (?) "
	cQuery +=	"AND SRA.D_E_L_E_T_ = ? "
	cQuery +=	"AND SRA.RA_FILIAL IN (SELECT TMP_FIL FROM ?) "
	
	If (!Empty(cAcessaSRA) .And. cAcessaSRA != ".T.", cQuery += "AND ? ", Nil)

	cQuery += ") "
	
	cQuery += "AND SP8.D_E_L_E_T_ = ? "
	cQuery += "AND ? BETWEEN ? AND ? "
	
	oQryUpdSP8:SetQuery(cQuery)
	
	If cNomeSGDB == "MSSQL"
		oQryUpdSP8:SetString(nParam++, "N")						// Conteúdo P8_APONTA
		oQryUpdSP8:SetUnsafe(nParam++, RetSQLName("SP8"))		// Nome físico da tabela SP8
	Else
		oQryUpdSP8:SetUnsafe(nParam++, RetSQLName("SP8"))		// Nome físico da tabela SP8
		oQryUpdSP8:SetString(nParam++, "N")						// Conteúdo P8_APONTA
	EndIf

	oQryUpdSP8:SetUnsafe(nParam++, RetSQLName("SRA"))			// Nome físico da tabela SRA
	oQryUpdSP8:SetString(nParam++, MV_PAR01)					// Filial De
	oQryUpdSP8:SetString(nParam++, MV_PAR02)					// Filial Até
	oQryUpdSP8:SetString(nParam++, MV_PAR03)					// Centro de Custo De
	oQryUpdSP8:SetString(nParam++, MV_PAR04)					// Centro de Custo Até
	oQryUpdSP8:SetString(nParam++, MV_PAR05)					// Turno De
	oQryUpdSP8:SetString(nParam++, MV_PAR06)					// Turno Até
	oQryUpdSP8:SetString(nParam++, MV_PAR07)					// Matrícula De
	oQryUpdSP8:SetString(nParam++, MV_PAR08)					// Matrícula Até
	oQryUpdSP8:SetString(nParam++, MV_PAR09)					// Nome De
	oQryUpdSP8:SetString(nParam++, MV_PAR10)					// Nome Até
	oQryUpdSP8:SetIn(nParam++, aSitQry)							// Situações
	oQryUpdSP8:SetIn(nParam++, aCatQry)							// Categorias
	oQryUpdSP8:SetString(nParam++, " ")							// Delete
	oQryUpdSP8:SetUnsafe(nParam++, oTempTable:GetRealName())	// Tabela temporária das filiais

	If (!Empty(cAcessaSRA) .And. cAcessaSRA != ".T.", oQryUpdSP8:SetUnsafe(nParam++, cAcessaSRA), Nil)	// Permissão de acesso da SRA

	oQryUpdSP8:SetString(nParam++, " ") // Delete SP8
	
	If lDtApo
		oQryUpdSP8:SetUnsafe(nParam++, "SP8.P8_DATAAPO") // Campo Data
	Else
		oQryUpdSP8:SetUnsafe(nParam++, "SP8.P8_DATA") // Campo Data
	EndIf
	
	oQryUpdSP8:SetDate(nParam++, MV_PAR11) // Data De
	oQryUpdSP8:SetDate(nParam++, MV_PAR12) // Data Até
	
	cQuery := oQryUpdSP8:getFixQuery()
	lUpdated := ((TcSqlExec(cQuery)) >= 0)
	
	oQryUpdSP8:Destroy()
	
Return lUpdated

/*/{Protheus.doc} SPCClearAbono
Altera os apontamentos excluindo a referência com a SPK
@type static function
@author Cícero Alves
@since 16/12/2025
@param cTipo, character, Tipo dos registros; campo XX_FLAG ou XX_TIPO2
@return logical, se a query foi executada com sucesso
/*/
Static Function SPCClearAbono(cTipo)
	
	Local cQuery	 		:= ""
	Local oQryUpdSPC		:= NIL
	Local nParam			:= 1
	Local lUpdated			:= .F.
	Local nLimpa 			:= MV_PAR20
	Local cNomeSGDB 		:= Upper(TCGetDB())
	
	oQryUpdSPC := FWPreparedStatement():New()
	
	If cNomeSGDB == "MSSQL"
		cQuery := "UPDATE SPC "
		cQuery += "SET SPC.PC_ABONO = ?, SPC.PC_QTABONO = ? "
		cQuery += "FROM ? SPC "
	Else
		cQuery := "UPDATE ? SPC "
		cQuery += "SET PC_ABONO = ?, PC_QTABONO = ? "
	EndIf
	
	cQuery += "WHERE EXISTS( "
	cQuery +=	"SELECT 1 "
	cQuery +=	"FROM ? SPK "
	cQuery +=	"INNER JOIN ? SRA ON SPK.PK_FILIAL = SRA.RA_FILIAL AND SPK.PK_MAT = SRA.RA_MAT "
	cQuery +=	"WHERE SPC.PC_FILIAL = SPK.PK_FILIAL "
	cQuery +=		"AND SPC.PC_MAT = SPK.PK_MAT "
	cQuery +=		"AND SPC.PC_ABONO = SPK.PK_CODABO "
	cQuery +=		"AND SPC.PC_DATA = SPK.PK_DATA "
	cQuery +=		"AND SPC.PC_CC = SPK.PK_CC "
	cQuery +=		"AND SPC.PC_TPMARCA = SPK.PK_TPMARCA "

	If !nLimpa == 1
		cQuery += "AND PK_FLAG = ? "
	EndIf

	cQuery += "AND SPK.D_E_L_E_T_ = ? "
	cQuery += "AND (SRA.RA_FILIAL >= ? AND SRA.RA_FILIAL <= ?) "
	cQuery += "AND (SRA.RA_CC >= ? AND SRA.RA_CC <= ?) "
	cQuery += "AND (SRA.RA_TNOTRAB >= ? AND SRA.RA_TNOTRAB <= ?) "
	cQuery += "AND (SRA.RA_MAT >= ? AND SRA.RA_MAT <= ?) "
	cQuery += "AND (SRA.RA_NOME >= ? AND SRA.RA_NOME <= ?) "
	cQuery += "AND SRA.RA_SITFOLH IN (?) "
	cQuery += "AND SRA.RA_CATFUNC IN (?) "
	cQuery += "AND SRA.D_E_L_E_T_ = ? "
	cQuery += "AND SRA.RA_FILIAL IN (SELECT TMP_FIL FROM ?) "

	If (!Empty(cAcessaSRA) .And. cAcessaSRA != ".T.", cQuery += "AND ? ", Nil)

	cQuery += ") "
	cQuery += "AND SPC.PC_ABONO <> ? "
	cQuery += "AND SPC.PC_DATA BETWEEN ? AND ? "
	cQuery += "AND SPC.D_E_L_E_T_ = ? "
	
	oQryUpdSPC:SetQuery(cQuery)

	If cNomeSGDB == "MSSQL"
		oQryUpdSPC:SetString(nParam++, " ")						// Conteúdo PC_ABONO
		oQryUpdSPC:SetNumeric(nParam++, 0)						// Conteúdo PC_QTABONO
		oQryUpdSPC:SetUnsafe(nParam++, RetSQLName("SPC"))		// Nome físico da tabela SPC
	Else
		oQryUpdSPC:SetUnsafe(nParam++, RetSQLName("SPC"))		// Nome físico da tabela SPC
		oQryUpdSPC:SetString(nParam++, " ")						// Conteúdo PC_ABONO
		oQryUpdSPC:SetNumeric(nParam++, 0)						// Conteúdo PC_QTABONO
	EndIf
	
	oQryUpdSPC:SetUnsafe(nParam++, RetSQLName("SPK"))			// Nome físico da tabela SPK
	oQryUpdSPC:SetUnsafe(nParam++, RetSQLName("SRA"))			// Nome físico da tabela SRA

	If !nLimpa == 1
		oQryUpdSPC:SetString(nParam++, cTipo)					// FLAG
	EndIf

	oQryUpdSPC:SetString(nParam++, " ") 						// Delete SPK
	oQryUpdSPC:SetString(nParam++, MV_PAR01)					// Filial De
	oQryUpdSPC:SetString(nParam++, MV_PAR02)					// Filial Até
	oQryUpdSPC:SetString(nParam++, MV_PAR03)					// Centro de Custo De
	oQryUpdSPC:SetString(nParam++, MV_PAR04)					// Centro de Custo Até
	oQryUpdSPC:SetString(nParam++, MV_PAR05)					// Turno De
	oQryUpdSPC:SetString(nParam++, MV_PAR06)					// Turno Até
	oQryUpdSPC:SetString(nParam++, MV_PAR07)					// Matrícula De
	oQryUpdSPC:SetString(nParam++, MV_PAR08)					// Matrícula Até
	oQryUpdSPC:SetString(nParam++, MV_PAR09)					// Nome De
	oQryUpdSPC:SetString(nParam++, MV_PAR10)					// Nome Até
	oQryUpdSPC:SetIn(nParam++, aSitQry)							// Situações
	oQryUpdSPC:SetIn(nParam++, aCatQry)							// Categorias
	oQryUpdSPC:SetString(nParam++, " ")							// Delete SRA
	oQryUpdSPC:SetUnsafe(nParam++, oTempTable:GetRealName())	// Tabela temporária das filiais

	If (!Empty(cAcessaSRA) .And. cAcessaSRA != ".T.", oQryUpdSPC:SetUnsafe(nParam++, cAcessaSRA), Nil)	// Permissão de acesso da SRA
	
	oQryUpdSPC:SetString(nParam++, " ")							// <> PC_ABONO
	oQryUpdSPC:SetDate(nParam++, MV_PAR11)						// Data De
	oQryUpdSPC:SetDate(nParam++, MV_PAR12)						// Data Até
	oQryUpdSPC:SetString(nParam++, " ")							// Delete SPC
	
	cQuery := oQryUpdSPC:getFixQuery()
	lUpdated := ((TcSqlExec(cQuery)) >= 0)
	
	oQryUpdSPC:Destroy()
	
Return lUpdated

/*/{Protheus.doc} RetTipoExclu
Retorna o tipo para exclusão
@type static function
@author Cícero Alves
@since 16/12/2025
@param nMvPar, numeric, tipo selecionado pelo usuário nas perguntas da rotina
@return character, Conteúdo do campo XX_FLAG ou XX_TIPO2 para filtro 
/*/
Static Function RetTipoExclu(nMvPar)
	
	Local cRet := ""
	
	Do Case
		Case nMvPar == 1
			cRet := "G"
		Case nMvPar == 2
			cRet := "I"
		Case nMvPar == 3
			cRet := "E"
		Case nMvPar == 4
			cRet := "M"
		Otherwise
			cRet := "A"
	EndCase
	
Return cRet

/*/{Protheus.doc} DelFunc
Realiza a exlusão de todas as informações do funcionário no SIGAPON
@type static function
@author Cícero Alves
@since 18/12/2025
@return NIL, NIL
/*/
Static Function DelFunc()
	Local cQuery	:= ""
	Local cAliasQry	:= GetNextAlias()
	Local oQrySRA 	:= FWPreparedStatement():New()
	Local nParamIni := 1
	
	cQuery += "SELECT SRA.RA_FILIAL, SRA.RA_MAT "
	cQuery += "FROM ? SRA "
	cQuery += "WHERE (SRA.RA_FILIAL >= ? AND SRA.RA_FILIAL <= ?) "
	cQuery +=	"AND (SRA.RA_CC >= ? AND SRA.RA_CC <= ?) "
	cQuery +=	"AND (SRA.RA_TNOTRAB >= ? AND SRA.RA_TNOTRAB <= ?) "
	cQuery +=	"AND (SRA.RA_MAT >= ? AND SRA.RA_MAT <= ?) "
	cQuery +=	"AND (SRA.RA_NOME >= ? AND SRA.RA_NOME <= ?) "
	cQuery +=	"AND SRA.RA_SITFOLH IN (?) "
	cQuery +=	"AND SRA.RA_CATFUNC IN (?) "
	cQuery +=	"AND SRA.D_E_L_E_T_ = ? "
	cQuery +=	"AND SRA.RA_FILIAL IN (SELECT TMP_FIL FROM ?) "

	If (!Empty(cAcessaSRA) .And. cAcessaSRA != ".T.", cQuery += "AND ? ", Nil)
	
	oQrySRA:SetQuery(cQuery)

	oQrySRA:SetUnsafe(nParamIni++, RetSQLName("SRA"))			// Nome físico da tabela SRA
	oQrySRA:SetString(nParamIni++, MV_PAR01)					// Filial De
	oQrySRA:SetString(nParamIni++, MV_PAR02)					// Filial Até
	oQrySRA:SetString(nParamIni++, MV_PAR03)					// Centro de Custo De
	oQrySRA:SetString(nParamIni++, MV_PAR04)					// Centro de Custo Até
	oQrySRA:SetString(nParamIni++, MV_PAR05)					// Turno De
	oQrySRA:SetString(nParamIni++, MV_PAR06)					// Turno Até
	oQrySRA:SetString(nParamIni++, MV_PAR07)					// Matrícula De
	oQrySRA:SetString(nParamIni++, MV_PAR08)					// Matrícula Até
	oQrySRA:SetString(nParamIni++, MV_PAR09)					// Nome De
	oQrySRA:SetString(nParamIni++, MV_PAR10)					// Nome Até
	oQrySRA:SetIn(nParamIni++, aSitQry)							// Situações
	oQrySRA:SetIn(nParamIni++, aCatQry)							// Categorias
	oQrySRA:SetString(nParamIni++, " ")							// Delete
	oQrySRA:SetUnsafe(nParamIni++, oTempTable:GetRealName())	// Tabela temporária das filiais

	If (!Empty(cAcessaSRA) .And. cAcessaSRA != ".T.", oQrySRA:SetUnsafe(nParamIni++, cAcessaSRA), Nil)	// Permissão de acesso da SRA
	
	cQuery := oQrySRA:GetFixQuery()
	
	dbUseArea(.T., "TOPCONN", TcGenQry(,, cQuery), cAliasQry)
	
	While (cAliasQry)->(!EoF())
		
		If !fVldDelete((cAliasQry)->RA_FILIAL, (cAliasQry)->RA_MAT)
			fDeletePon((cAliasQry)->RA_FILIAL, (cAliasQry)->RA_MAT)
			aAdd(aLogSuces, STR0027 + AllTrim((cAliasQry)->RA_FILIAL) + STR0028 + (cAliasQry)->RA_MAT + ".") // "Realizada a exclusão de todos os dados do ponto do funcionário da filial " " e matrícula "
		Else
			aAdd(aLogErro, STR0029 + AllTrim((cAliasQry)->RA_FILIAL) + STR0028 + (cAliasQry)->RA_MAT + STR0032) // "O funcionário da filial " " e matrícula " " possui marcação original. Apenas as informações inseridas manualmente ou geradas pelo sistema foram excluídas."
		EndIf
		
		(cAliasQry)->(dbSkip())
	EndDo
	
	(cAliasQry)->(DbCloseArea()) 
	oQrySRA:Destroy()
	
Return

/*/{Protheus.doc} fVldDelete
Valida se poderá excluir todos os registros do ponto do funcionário.
@type Static Function
@author Marco Nakazawa
@since 10/10/2025
/*/
Static Function fVldDelete(cFilFunc, cMatFunc)
	
	Local aArea			:= GetArea()
	Local cAliasQry		:= GetNextAlias()
	Local cQuery		:= ""
	Local lRet			:= .F.
	
	Default cFilFunc 	:= ""
	Default cMatFunc	:= ""
	
	If __oFWSt == Nil
		__oFWSt := FWPreparedStatement():New()
		
		cQuery := "SELECT SUM(CONTAGEM) AS CONTAGEM_TOTAL "
		cQuery += "FROM ( "
		cQuery += 	"SELECT COUNT(*) AS CONTAGEM "
		cQuery += 	"FROM " + RetSqlName("SRA") + " SRA "
		cQuery += 	"INNER JOIN " + RetSqlName("SP8") + " SP8 ON SP8.P8_FILIAL = SRA.RA_FILIAL AND SP8.P8_MAT = SRA.RA_MAT AND SP8.P8_TIPOREG = ? AND SP8.D_E_L_E_T_ = ? "
		cQuery += 	"WHERE SRA.RA_FILIAL = ? "
		cQuery += 	"AND SRA.RA_MAT = ? "
		cQuery += 	"UNION ALL "
		cQuery += 	"SELECT COUNT(*) AS CONTAGEM "
		cQuery += 	"FROM " + RetSqlName("SRA") + " SRA "
		cQuery += 	"INNER JOIN " + RetSqlName("SPG") + " SPG ON SPG.PG_FILIAL = SRA.RA_FILIAL AND SPG.PG_MAT = SRA.RA_MAT AND SPG.PG_TIPOREG = ? AND SPG.D_E_L_E_T_ = ? "
		cQuery += 	"WHERE SRA.RA_FILIAL = ? "
		cQuery += 	"AND SRA.RA_MAT = ? "
		cQuery += ") RESULTADO"
		
		cQuery := ChangeQuery(cQuery)
		
		__oFWSt:SetQuery(cQuery)
	EndIf
	
	__oFWSt:SetString(1, "O" )		// SP8.TIPOREG
	__oFWSt:SetString(2, " " )		// SP8.D_E_L_E_T_
	__oFWSt:SetString(3, cFilFunc ) // SRA.RA_FILIAL
	__oFWSt:SetString(4, cMatFunc ) // SRA.RA_MAT
	__oFWSt:SetString(5, "O" )		// SPG.TIPOREG
	__oFWSt:SetString(6, " " )		// SPG.D_E_L_E_T_
	__oFWSt:SetString(7, cFilFunc ) // SRA.RA_FILIAL
	__oFWSt:SetString(8, cMatFunc ) // SRA.RA_MAT
	
	cQuery := __oFWSt:getFixQuery()
	
	dbUseArea(.T., "TOPCONN", TcGenQry(,,cQuery), cAliasQry)
	
	lRet := (cAliasQry)->CONTAGEM_TOTAL > 0
	
	(cAliasQry)->(DbCloseArea())
	
	RestArea(aArea)
	
Return lRet

/*/{Protheus.doc} fDeletePon
Realiza a exclusão dos registros do ponto do funcionário.
@type Static Function
@author Marco Nakazawa
@since 10/10/2025
/*/
Static Function fDeletePon(cFilFunc, cMatFunc)
	
	Local aTabelas		:= {}
	Local nI			:= 0
	Local cQuery		:= ""
	
	Default cFilFunc 	:= ""
	Default cMatFunc	:= ""
	
	If !Empty(cFilFunc) .And. !Empty(cMatFunc)
		aAdd(aTabelas, {"RFG", "RFG_FILIAL"	,"RFG_MAT"	})
		aAdd(aTabelas, {"SPC", "PC_FILIAL"	,"PC_MAT"	})
		aAdd(aTabelas, {"SPI", "PI_FILIAL"	,"PI_MAT"	})
		aAdd(aTabelas, {"RF6", "RF6_FILIAL"	,"RF6_MAT"	})
		aAdd(aTabelas, {"RS4", "RS4_FILIAL"	,"RS4_MAT"	})
		aAdd(aTabelas, {"SPE", "PE_FILIAL"	,"PE_MAT"	})
		aAdd(aTabelas, {"RRE", "RRE_FILIAL"	,"RRE_MAT"	})
		aAdd(aTabelas, {"SPK", "PK_FILIAL"	,"PK_MAT"	})
		aAdd(aTabelas, {"SP2", "P2_FILIAL"	,"P2_MAT"	})
		aAdd(aTabelas, {"SPN", "PN_FILIAL"	,"PN_MAT"	})
		aAdd(aTabelas, {"SPH", "PH_FILIAL"	,"PH_MAT"	})
		aAdd(aTabelas, {"SPG", "PG_FILIAL"	,"PG_MAT"	})
		aAdd(aTabelas, {"SPL", "PL_FILIAL"	,"PL_MAT"	})
		aAdd(aTabelas, {"SPT", "PT_FILIAL"	,"PT_MAT"	})
		aAdd(aTabelas, {"RSZ", "RSZ_FILIAL"	,"RSZ_MAT"	})
		aAdd(aTabelas, {"RRS", "RRS_FILIAL"	,"RRS_MAT"	})
		aAdd(aTabelas, {"RF7", "RF7_FILIAL"	,"RF7_MAT"	})
		aAdd(aTabelas, {"SP5", "P5_FILIAL"	,"P5_MAT"	})
		aAdd(aTabelas, {"SP8", "P8_FILIAL"	,"P8_MAT"	})
		aAdd(aTabelas, {"SPY", "PY_FILIAL"	,"PY_MAT"	})
		aAdd(aTabelas, {"SPS", "PS_FILIAL"	,"PS_MAT"	})
		aAdd(aTabelas, {"RFF", "RFF_FILIAL"	,"RFF_MAT"	})
		aAdd(aTabelas, {"RF0", "RF0_FILIAL"	,"RF0_MAT"	})
		aAdd(aTabelas, {"SPB", "PB_FILIAL"	,"PB_MAT"	})
		aAdd(aTabelas, {"SPF", "PF_FILIAL"	,"PF_MAT"	})
		
		Begin Transaction
			If oESPN50Del == NIL
				oESPN50Del := FWPreparedStatement():New()
				
				cQuery := "DELETE FROM ? WHERE ? = ? AND ? = ?"
				
				oESPN50Del:SetQuery(cQuery)
			EndIf

			For nI := 1 To Len(aTabelas)
				oESPN50Del:SetUnsafe(1, RetSQLName(aTabelas[nI][1])) // Nome físico da tabela
				oESPN50Del:SetUnsafe(2, aTabelas[nI][2]) // Campo Filial
				oESPN50Del:SetString(3, cFilFunc) // Valor Filial	
				oESPN50Del:SetUnsafe(4, aTabelas[nI][3]) // Campo Matrícula
				oESPN50Del:SetString(5, cMatFunc) // Valor Matrícula
				
				cQuery := oESPN50Del:getFixQuery()
				
				TcSqlExec(cQuery)
			Next
		End Transaction
	EndIf
	
Return

/*/{Protheus.doc} CreateTmpFil
Cria uma tabela temporária com as filiais que o usuário tem acesso
@type static function
@author Cícero Alves
@since 17/12/2025
@return NIL, NIL
/*/
Static Function CreateTmpFil()
	
	Local aValidFil := StrToArray(fValidFil(), "/")
	Local cTmpAlias	:= GetNextAlias()
	Local aFields	:= {}
	Local nI		:= 0
	Local cTCAlias	:= ""
	
	Static oTempTable := NIL
	
	aAdd(aFields, {"TMP_FIL",  "C",  FWGETTAMFILIAL, 0})
	
	oTempTable := FWTemporaryTable():New(cTmpAlias)
	oTempTable:SetFields(aFields)
	oTempTable:AddIndex("1", {"TMP_FIL"})
	oTempTable:Create()
	
	cTCAlias := oTempTable:GetTableNameForTCFunctions()
	
	oBulk := FwBulk():New(cTCAlias, Len(aValidFil))
	
	oBulk:SetFields(aFields)
	
	For nI := 1 To Len(aValidFil)
		oBulk:AddData({aValidFil[nI]})
	Next
	
	oBulk:Close()
	oBulk:Destroy()
	oBulk := Nil
	
Return

/*/{Protheus.doc} CleanStatic
Reinicializa as variáveis static utilizadas na rotina
@type function
@author Cícero Alves
@since 19/12/2025
@return NIL, NIL
/*/
Static Function CleanStatic()
	
	cAliasErro := ""
	aLogSuces := {}
	aLogErro := {}
	
	If oQryDel != NIL
		oQryDel:Destroy()
		oQryDel := NIL
	EndIf
	
	If ValType(oTempTable) == "O"
		oTempTable:Delete()
		FwFreeObj(oTempTable)
		oTempTable := NIL
	EndIf
	
Return 
