#INCLUDE "PROTHEUS.CH"
#INCLUDE "FWLIBVERSION.CH"
#include "totvs.ch"
#include "msobject.ch"
#include "totvs.framework.treports.integratedprovider.th"
#include "tlpp-rest.th"
#include "tlpp-core.th"

namespace totvs.protheus.backoffice.sv.fat.salesordervscustomer.treportsintegratedprovider

@totvsFrameworkTReportsIntegratedProvider(active=.F., team="SIGAFAT", tables="SA1,SC5,SC6,SF4", name="Pedidos de Venda x Clientes", country="BRA")

/*/{Protheus.doc} salesordervscustomerSmartViewBusinessObjectBRA
    Classe para criação do Objeto de Negócio para Relacao de Pedidos de Vendas Brasil.
    @author Squad CRM/Faturamento
    @since 17/07/2023
    @version 1.0
*/
Class salesordervscustomerSmartViewBusinessObjectBRA from totvs.protheus.backoffice.sv.fat.salesordervscustomer.treportsintegratedprovider.salesordervscustomerSmartViewBusinessObject
    
    public method new() as object
    public method preData() as object
    public method processData() as object
    public method preSchema() as object
    public method FatSvOrderByTaxes() as array

Endclass

/*{Protheus.doc} new
    Método de instância da classe
    @return object: self
    @author Squad CRM/Faturamento
    @since 17/07/2023
    @version 1.0
*/
method new() class salesordervscustomerSmartViewBusinessObjectBRA 
	
    _Super:new()

return self

/*{Protheus.doc} preData
    Método chamado antes do getData do objeto principal
    @return object: self:oData
    @author Squad CRM/Faturamento
    @since 17/07/2023
    @version 1.0
*/
method preData() as object class salesordervscustomerSmartViewBusinessObjectBRA
Return self:oData

/*{Protheus.doc} processData
    Deverá ser chamado no momento do processamento da query
    @return object: self:oData
    @param nOperLoc Operação campos localizados
    @param cAliasPdv Alias temporário
    @param cCondicao Condição para filtro sql localizado
    @author Squad CRM/Faturamento
    @since 17/07/2023
    @version 1.0
*/
Method processData(nOperLoc as numeric,cAliasPdv as character,cCondicao as character) as object class salesordervscustomerSmartViewBusinessObjectBRA

    Default nOperLoc  := 0
    Default cAliasPdv := ""
    Default cCondicao  := ""
    
    // Operação 1 - Filtrar somente os pedidos de venda que pussuem vendedores vinculados.
    If nOperLoc == 1
        cCondicao := " <> ? AND "

    // Operação 2 - Complementar o Filtro da query se vai ou não trazer os dados com Agregação de impostos.
    ElseIf nOperLoc == 2
        self:FatSvOrderByTaxes(cAliasPdv)
    EndIf
Return

/*{Protheus.doc} preSchema
    Método chamada antes do getSchema do objeto principal
    @return object: self:oSchema
    @author Squad CRM/Faturamento
    @since 17/07/2023
    @version 1.0
*/
method preSchema() as object class salesordervscustomerSmartViewBusinessObjectBRA
    //Adição de novos campos personalizados (não existem na tabela)
return self:oSchema

/*{Protheus.doc} FatSvOrderByTaxes
    Método para cálculo de tributos

    @param cAliasPdv, string com o alias de retorno da query
    @return array: self:aItemTaxes
    @author Squad CRM/Faturamento
    @since 02/12/2025
    @version 2.0
*/
Method FatSvOrderByTaxes(cAliasPdv as character) as array Class salesordervscustomerSmartViewBusinessObjectBRA
    Local aItensJSON      := {} as array
    Local aKeys1          := {} as array
    Local aKeys2          := {} as array
    Local aPedidos        := {} as array
    Local aItens          := {} as array
    Local aItemTaxesTemp  := {} as array
    Local cChavePedido    := "" as character
    Local cChave1         := "" as character
    Local cChave2         := "" as character
    Local nZ              := 0  as numeric
    Local nX              := 0  as numeric
    Local nY              := 0  as numeric
    Local nItemRet        := 0  as numeric
    Local nTotalItens     := 0  as numeric
    Local oTaxes          := Nil as object
    Local oJsonResult     := Nil as object
    Local jTaxPayload     := Nil as json
    Local jPedido         := Nil as json
    Local jCabecalho      := Nil as json
    Local jItem           := Nil as json

    Default cAliasPdv := ""

    If !FindClass("totvs.protheus.backoffice.fiscal.calculation.TaxCalculationService") .Or. Empty(cAliasPdv)
        Return aItemTaxesTemp
    EndIf

    DbSelectArea(cAliasPdv)
    (cAliasPdv)->(DbGoTop())

    Do While (cAliasPdv)->(!Eof())

        nTotalItens++

        If cChavePedido != (cAliasPdv)->C5_FILIAL + (cAliasPdv)->C5_NUM

            If Len(aItens) > 0
                jPedido := JsonObject():New()
                jPedido["cabecalho"] := jCabecalho
                jPedido["itens"]     := aItens
                AAdd(aPedidos, jPedido)
                aItens := {}
            EndIf

            cChavePedido := (cAliasPdv)->C5_FILIAL + (cAliasPdv)->C5_NUM

            jCabecalho := JsonObject():New()
            jCabecalho["codParticipante"]       := (cAliasPdv)->C5_CLIENTE
            jCabecalho["lojaParticipante"]      := (cAliasPdv)->C5_LOJACLI
            jCabecalho["tipoParticipante"]      := "C"
            jCabecalho["tipoOperacao"]          := (cAliasPdv)->C5_TIPO
            jCabecalho["categoriaParticipante"] := (cAliasPdv)->C5_TIPOCLI
            jCabecalho["lCalcTG"]               := .T.

        EndIf

        // Adiciona item ao pedido corrente
        jItem := JsonObject():New()
        jItem["nItem"]          := (cAliasPdv)->C6_ITEM
        jItem["codigo"]         := (cAliasPdv)->C6_PRODUTO
        jItem["tes"]            := (cAliasPdv)->C6_TES
        jItem["quantidade"]     := (cAliasPdv)->C6_QTDVEN
        jItem["valorUnitario"]  := (cAliasPdv)->C6_PRCVEN
        jItem["desconto"]       := (cAliasPdv)->C6_DESCONT
        jItem["nfOri"]          := (cAliasPdv)->C6_NFORI
        jItem["serieOri"]       := (cAliasPdv)->C6_SERIORI
        jItem["recnoOri"]       := ""
        jItem["frete"]          := 0
        jItem["despesa"]        := 0
        jItem["seguro"]         := 0
        jItem["freteAutonomo"]  := 0
        jItem["valorTotal"]     := (cAliasPdv)->C6_VALOR
        jItem["cfop"]           := (cAliasPdv)->C6_CF
        jItem["origemProduto"]  := (cAliasPdv)->B1_ORIGEM
        jItem["tpOper"]         := (cAliasPdv)->C6_OPER

        AAdd(aItens, jItem)

        (cAliasPdv)->(DbSkip())

    EndDo

    // Finaliza o último pedido
    If Len(aItens) > 0
        jPedido := JsonObject():New()
        jPedido["cabecalho"] := jCabecalho
        jPedido["itens"]     := aItens
        AAdd(aPedidos, jPedido)
    EndIf

    // Inicializa o array global de tributos com o tamanho total de itens
    aSize(aItemTaxesTemp, nTotalItens)
    AEval(aItemTaxesTemp, {|x, i| aItemTaxesTemp[i] := Nil})

    nItemRet := 0 // Contador global para posição no array final

    For nZ := 1 To Len(aPedidos)

        jTaxPayload := aPedidos[nZ]
        aItensJSON  := aPedidos[nZ]["itens"]

        // Cria uma instância do motor fiscal por pedido
        oTaxes := totvs.protheus.backoffice.fiscal.calculation.TaxCalculationService():New(jTaxPayload)

        // Inicia e executa o motor de cálculo
        oTaxes:startCalculationEngine(.T.)
        oTaxes:runCalculationEngine()

        // Obtém o resultado diretamente como JsonObject
        oJsonResult := oTaxes:getGenericTaxesPerItem({"regras_escrituracao"})

        // Processa os tributos calculados
        If oJsonResult:HasProperty("dados_itens")
            aKeys1 := oJsonResult["dados_itens"]:GetNames()

            // Itera sobre cada item do pedido
            For nX := 1 To Len(aItensJSON)
                nItemRet++ // Incrementa posição global

                // Busca o tributo correspondente ao item
                cChave1 := AllTrim(Str(nX)) // Ex: "1", "2", "3"...
                
                // Verifica se existe tributação calculada para este item
                If AScan(aKeys1, {|x| AllTrim(x) == cChave1}) > 0
                    aKeys2 := oJsonResult["dados_itens"][cChave1]:GetNames()

                    For nY := 1 To Len(aKeys2)
                        cChave2 := aKeys2[nY] // Ex: "01", "02", ...

                        // Verifica se o índice está dentro dos limites do array e se a chave não representa um aviso de
                        // 'tributos não calculados pelo configurador de tributos'
                        If nItemRet > 0 .And. nItemRet <= Len(aItemTaxesTemp) .And. cChave2 <> "Aviso"
                            aItemTaxesTemp[nItemRet] := oJsonResult["dados_itens"][cChave1][cChave2]["regras_escrituracao"]["acao_tot_nf"]
                            Exit
                        EndIf
                    Next nY
                EndIf
            Next nX
        EndIf

        // Libera memória corretamente usando Destroy()
        If oTaxes != Nil
            oTaxes:finishCalculationEngine()
            oTaxes:Destroy()
            oTaxes := Nil
        EndIf

        If oJsonResult != Nil
            FwFreeObj(oJsonResult)
            oJsonResult := Nil
        EndIf

        aSize(aKeys1, 0)
        aSize(aKeys2, 0)
        aSize(aItensJSON, 0)

    Next nZ

    // Libera memória dos pedidos
    aSize(aPedidos, 0)

    self:aItemTaxes := aItemTaxesTemp

Return self:aItemTaxes
