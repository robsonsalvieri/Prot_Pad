#include "tlpp-core.th"

namespace totvs.protheus.backoffice.categories.productfeatures

Static __oInstance as object
Static __oActiveData as Object

//------------------------------------------------------------------------------
/*/{Protheus.doc} FeaturesService
	Disponibiliza um serviço de atributos de produtos
	@type       Class
	@sample     FeaturesService
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Class FeaturesService
	Public Method new() as Object
	Public Method getInstance() as Object
	Public Method getData() as Object
	Public Method getFeatures() as Json
	Public Method getCategFeatures() as Json

EndClass

//------------------------------------------------------------------------------
/*/{Protheus.doc} new
	Disponibiliza uma nova intancia do serviço atributos de Produtos.
	@type       method
	@sample     FeaturesService:New()
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method new() as Object Class FeaturesService
Return Self

//------------------------------------------------------------------------------
/*/{Protheus.doc} getInstance
	Retorna uma instancia do serviço
	@type       method
	@sample     FeaturesService:GetInstance()
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getInstance() as Object Class FeaturesService
	If (__oInstance == Nil)
		__oInstance := FeaturesService():New()
	EndIf
Return __oInstance

//------------------------------------------------------------------------------
/*/{Protheus.doc} getData
	Retorna o tipo de objeto utilizado para consulta.
	@type       method
	@return     __oActiveData, 
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getData() as Object class FeaturesService
	If __oActiveData == Nil
		__oActiveData := FeaturesProtheusData():new()
	EndIf
Return __oActiveData


//------------------------------------------------------------------------------
/*/{Protheus.doc} getFeatures
	Efetua a consulta de Atributos de Produtos
	@type       method
	@sample     oService:getFeatures(1, 10, {}, 'code, description', '-code', Nil)
	@param      nPage       , Numeric  , Número da página que será retornada
	@param      nPageSize   , Numeric  , Quantidade de registros por página
	@param      aURLFilter  , Array    , Lista de Filtros no padrão do FWAdapterBaseV2
	@param      cFields     , Character, Lista de campos que devem ser retornados
	@param      cSort       , Character, Ordernação do Response
	@param      cSearchText , Character, Texto de pesquisa
	@param      cCategory   , Character, Código da categoria para filtro de atributos
	@param      lInheritedAt, Logical  , Indica se deve retornar atributos herdados
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getFeatures(nPage as Numeric, nPageSize as Numeric, aURLFilter as Array, cFields as Character,;
 cSort as Character, cSearchText as Character) as Json Class FeaturesService
	Local oFeatures := ::getData()
	Local jResponse as Json

	Default nPage       := 1
	Default nPageSize   := 10
	Default aURLFilter  := {}
	Default cFields     := ""
	Default cSort       := ""
	Default cSearchText := ""

	oFeatures:GetFeatures(nPage, nPageSize, aURLFilter, cFields, cSort, cSearchText)

	jResponse := oFeatures:getJSONResponse()

	oFeatures:DeActivate()
	FreeObj(oFeatures)
Return jResponse

//------------------------------------------------------------------------------
/*/{Protheus.doc} getFeatures
	Efetua a consulta de Atributos de Produtos
	@type       method
	@sample     oService:getFeatures(1, 10, {}, 'code, description', '-code', Nil)
	@param      nPage       , Numeric  , Número da página que será retornada
	@param      nPageSize   , Numeric  , Quantidade de registros por página
	@param      aURLFilter  , Array    , Lista de Filtros no padrão do FWAdapterBaseV2
	@param      cFields     , Character, Lista de campos que devem ser retornados
	@param      cSort       , Character, Ordernação do Response
	@param      cSearchText , Character, Texto de pesquisa
	@param      cCategory   , Character, Código da categoria para filtro de atributos
	@param      lInheritedAt, Logical  , Indica se deve retornar atributos herdados
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getCategFeatures(nPage as Numeric, nPageSize as Numeric, aURLFilter as Array, cFields as Character,;
 cSort as Character, cSearchText as Character, cCategory as Character, lInheritedAt as Logical) as Json Class FeaturesService
	Local oFeatures := ::getData()
	Local jResponse as Json

	Default nPage        := 1
	Default nPageSize    := 10
	Default aURLFilter   := {}
	Default cFields      := ""
	Default cSort        := ""
	Default cSearchText  := ""
	Default cCategory    := ""
	Default lInheritedAt := .F.

	oFeatures:GetCategFeatures(nPage, nPageSize, aURLFilter, cFields, cSort, cSearchText, cCategory, lInheritedAt)

	jResponse := oFeatures:getJSONResponse()

	oFeatures:DeActivate()
	FreeObj(oFeatures)
Return jResponse
