/*/
//------------------------------------------------------------------------------
Method getParameter(cParameter as Character) as Json Class ProductCategoryCodificationService
	Local oData := ::getData()
	Local jResponse as Json

	Default cParameter := ""

	jResponse := oData:getParameter(cParameter)

	oData:DeActivate()
	FreeObj(oData)

Return jResponse

//------------------------------------------------------------------------------
/*/{Protheus.doc} putParameter
	Altera o conteúdo do parâmetro passado via parâmetro
	@type       method
	@sample     oService:putParameter('MV_EXAMPLE', 'New Value')
	@param      cParameter, Character, Nome do parâmetro a ser alterado.
	@param      xValuePar , Variant  , Novo valor do parâmetro.
	@return     jResponse, Json, Resultado da operação de alteração do parâmetro.
	@author     Jorge Martins / Squad Retail
	@since      12/02/2026
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method putParameter(cParameter as Character, xValuePar as Variant) as Json Class ProductCategoryCodificationService
	Local oData := ::getData()
	Local jResponse as Json

	Default cParameter := ""
	Default xValuePar  := ""

	jResponse := oData:putParameter(cParameter, xValuePar)

	oData:DeActivate()
	FreeObj(oData)

Return jResponse

//------------------------------------------------------------------------------
/*/{Protheus.doc} putAdjustEncoding
	Realiza o ajuste de codificação para os campos de categorias de produtos,
	@type       method
	@sample     oService:putAdjustEncoding()
	@return     jResponse, Json, Resultado da operação de ajuste de codificação.
	@author     Jorge Martins / Squad Retail
	@since      18/02/2026
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method putAdjustEncoding() as Json Class ProductCategoryCodificationService
	Local oData := ::getData()
	Local jResponse as Json

	jResponse := oData:putAdjustEncoding()

	oData:DeActivate()
	FreeObj(oData)

Return jResponse
