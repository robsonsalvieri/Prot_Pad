	@since      12/02/2026
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getInstance() as Object Class ProductCategoryCodificationService
	If (__oInstance == Nil)
		__oInstance := ProductCategoryCodificationService():New()
	EndIf
Return __oInstance

//------------------------------------------------------------------------------
/*/{Protheus.doc} getData
	Retorna o tipo de objeto utilizado para consulta.
	@type       method
	@return     __oActiveData, 
	@author     Jorge Martins / Squad Retail
	@since      12/02/2026
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getData() as Object class ProductCategoryCodificationService
	If __oActiveData == Nil
		__oActiveData := ProductCategoryCodificationData():new()
	EndIf
Return __oActiveData

//------------------------------------------------------------------------------
/*/{Protheus.doc} getFieldSize
	Busca o tamanho do campo passado via parâmetro, 
	o parâmetro deve ser informado no formato Tabela_Campo (ex: B1_COD, RD0_NOME, etc)
	@type       method
	@sample     oService:getFieldSize('B1_COD')
	@param      cField, Character, Nome do campo no formato Tabela_Campo.
	@return     jResponse, Json, Tamanho do campo consultado ou mensagem de erro.
	@author     Jorge Martins / Squad Retail
	@since      12/02/2026
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getFieldSize(cField as Character) as Json Class ProductCategoryCodificationService
	Local oData := ::getData()
	Local jResponse as Json

	Default cField := ""

	jResponse := oData:getFieldSize(cField)

	oData:DeActivate()
	FreeObj(oData)

Return jResponse

//------------------------------------------------------------------------------
/*/{Protheus.doc} getParameter
	Efetua a consulta do conteúdo do parâmetro passado via parâmetro
	@type       method
	@sample     oService:getParameter('MV_EXAMPLE')
	@param      cParameter, Character, Nome do parâmetro a ser consultado.
