#include "tlpp-core.th"
#include "backoffice.categories.productcategories.service.ch"

namespace totvs.protheus.backoffice.categories.productcategories

Static __oInstance as object
Static __oActiveData as Object

//------------------------------------------------------------------------------
/*/{Protheus.doc} CategoriesService
	Disponibiliza um serviço de Categorias de produtos
	@type       Class
	@sample     CategoriesService
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Class CategoriesService
	Public Method new() as Object
	Public Method getInstance() as Object
	Public Method getData() as Object
	Public Method getCategories() as Json
	Public Method getCategoriesbySearch() as Json
	Public Method getChildCategories() as Json
	Public Method getInactivatedCategories() as Json
	Public Method getRootName() as Json
	Public Method postActivateCategories() as Json

EndClass

//------------------------------------------------------------------------------
/*/{Protheus.doc} new
	Disponibiliza uma nova intancia do serviço Categorias de Produtos.
	@type       method
	@sample     CategoriesService:New()
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method new() as Object Class CategoriesService
Return Self

//------------------------------------------------------------------------------
/*/{Protheus.doc} getInstance
	Retorna uma instancia do serviço
	@type       method
	@sample     CategoriesService:GetInstance()
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getInstance() as Object Class CategoriesService
	If (__oInstance == Nil)
		__oInstance := CategoriesService():New()
	EndIf
Return __oInstance

//------------------------------------------------------------------------------
/*/{Protheus.doc} getData
	Retorna o tipo de objeto utilizado para consulta.
	@type       method
	@return     __oActiveData, 
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getData() as Object class CategoriesService
	If __oActiveData == Nil
		__oActiveData := CategoriesProtheusData():new()
	EndIf
Return __oActiveData

//------------------------------------------------------------------------------
/*/{Protheus.doc} getCategories
	Efetua a consulta de Categorias de Produtos
	@type       method
	@sample     oService:getCategories(1, 10, {}, 'code, description', '-code', Nil)
	@param      nPage       , Numeric  , Número da página que será retornada
	@param      nPageSize   , Numeric  , Quantidade de registros por página
	@param      aURLFilter  , Array    , Lista de Filtros no padrão do FWAdapterBaseV2
	@param      cFields     , Character, Lista de campos que devem ser retornados
	@param      cSort       , Character, Ordernação do Response
	@param      cSearchText , Character, Texto de pesquisa
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getCategories(nPage as Numeric, nPageSize as Numeric, aURLFilter as Array, cFields as Character,;
 cSort as Character, cSearchText as Character) as Json Class CategoriesService
	Local oCategories := ::getData()
	Local jResponse as Json

	Default nPage       := 1
	Default nPageSize   := 10
	Default aURLFilter  := {}
	Default cFields     := ""
	Default cSort       := ""
	Default cSearchText := ""

	oCategories:GetCategories(nPage, nPageSize, aURLFilter, cFields, cSort, cSearchText)

	jResponse := oCategories:getJSONResponse()

	oCategories:DeActivate()
	FreeObj(oCategories)

Return jResponse

//------------------------------------------------------------------------------
/*/{Protheus.doc} getInactivatedCategories
	Efetua a consulta de Categorias de Produtos Inativadas
	@type       method
	@sample     oService:getCategories(1, 10, {}, 'code, description', '-code', Nil)
	@param      nPage       , Numeric  , Número da página que será retornada
	@param      nPageSize   , Numeric  , Quantidade de registros por página
	@param      aURLFilter  , Array    , Lista de Filtros no padrão do FWAdapterBaseV2
	@param      cFields     , Character, Lista de campos que devem ser retornados
	@param      cSort       , Character, Ordernação do Response
	@param      cSearchText , Character, Texto de pesquisa
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getInactivatedCategories(nPage as Numeric, nPageSize as Numeric, aURLFilter as Array, cFields as Character,;
 cSort as Character, cSearchText as Character) as Json Class CategoriesService
	Local oCategories := ::getData()
	Local jResponse as Json

	Default nPage       := 1
	Default nPageSize   := 10
	Default aURLFilter  := {}
	Default cFields     := ""
	Default cSort       := ""
	Default cSearchText := ""

	oCategories:GetInactivatedCategories(nPage, nPageSize, aURLFilter, cFields, cSort, cSearchText)

	jResponse := oCategories:getJSONResponse()

	oCategories:DeActivate()
	FreeObj(oCategories)

Return jResponse

//------------------------------------------------------------------------------
/*/{Protheus.doc} postActivateCategories
	Efetua a ativação de Categorias de Produtos
	@type       method
	@sample     oService:postActivateCategories('CAT001', .T.)
	@param      cCategory   , Character, Código da categoria a ser ativada
	@param      lActivateSup, Logical  , Indica se as categorias superiores também devem ser ativadas
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method postActivateCategories(cCategory as Character, lActivateSup as Logical) as Json Class CategoriesService
	Local oCategories := ::getData()
	Local jResponse as Json

	Default cCategory    := ""
	Default lActivateSup := .F.

	jResponse := oCategories:PostActivateCategories(cCategory, lActivateSup)

	oCategories:DeActivate()
	FreeObj(oCategories)

Return jResponse

//------------------------------------------------------------------------------
/*/{Protheus.doc} getRootName
	Efetua a consulta do nome da categoria raiz
	@type       method
	@sample     oService:getRootName()
	@return     Json, Nome da categoria raiz
	@author     Jorge Martins / Squad Retail
	@since      12/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getRootName() as Json Class CategoriesService
	Local jResponse as Json
	Local cRaiz     as Character
	Local cParamSeg as Character

	cRaiz     := STR0001 // "Raiz"
	cParamSeg := SuperGetMV("MV_CATSEGM", .F., STR0001) // "Raiz"

	If !Empty(cParamSeg)
		cRaiz := cParamSeg
	EndIf

	jResponse := JsonObject():New()
	jResponse['rootName'] := Upper(cRaiz)

Return jResponse

//------------------------------------------------------------------------------
/*/{Protheus.doc} getChildCategories
	Efetua a consulta das categorias filhas de uma categoria pai
	@type       method
	@sample     oService:getChildCategories('CAT001')
	@param      cCategory   , Character, Código da categoria pai
	@param      lActivated  , Logical  , Indica se deve retornar categorias ativas
	@param      lInactivated, Logical  , Indica se deve retornar categorias inativas
	@author     Jorge Martins / Squad Retail
	@since      17/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getChildCategories(cCategory as Character, lActivated as Logical, lInactivated as Logical) as Json Class CategoriesService
	Local oCategories := ::getData()
	Local jResponse as Json

	Default cCategory    := ""
	Default lActivated   := .T.
	Default lInactivated := .F.

	jResponse := oCategories:getChildCategories(cCategory, lActivated, lInactivated)

	oCategories:DeActivate()
	FreeObj(oCategories)

Return jResponse
