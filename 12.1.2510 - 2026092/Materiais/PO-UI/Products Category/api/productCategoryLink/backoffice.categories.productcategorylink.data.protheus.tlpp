//------------------------------------------------------------------------------
/*/{Protheus.doc} Get
	Efetua a consulta de Amarrações Categoria x Grupo/Produto.

	@sample     ProductCategoryLinkProtheusData:Get(1, 10, {}, 'code, description', '-code')
	@type       method
	@param      nPage       , Numeric   , Número da página que será retornada
	@param      nPageSize   , Numeric   , Quantidade de registros por página
	@param      aURLFilter  , Array     , Lista de Filtros no padrão do FWAdapterBaseV2
	@param      cFields     , Character , Lista de campos que devem ser retornados
	@param      cSort       , Character , Ordenação do Response
	@param      cCategory   , Character , Código da categoria
	@param      cProduct    , Character , Código do produto
	@param      cGroup      , Character , Código do grupo
	@param      cGridRefer  , Character , Código da grade/referência
	@author     cruz.rafael / Squad Retail
	@since      12/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method get(nPage as Numeric, nPageSize as Numeric, aURLFilter as Array, cFields as Character, cSort as Character,;
 cCategory as Character, cProduct as Character, cGroup as Character, cGridRefer as Character) class ProductCategoryLinkProtheusData
	Local aArea as Array

	Default nPage       := 1
	Default nPageSize   := 10
	Default aURLFilter  := {}
	Default cFields     := ""
	Default cSort       := ""
	Default cCategory   := ""
	Default cProduct    := ""
	Default cGroup      := ""
	Default cGridRefer  := ""

	aArea := FWGetArea()

	::setPage(nPage)
	::setPageSize(nPageSize)
	::setQuery(GetQueryACV(::oMainExec))
	::setWhere(GetFilterACV(cCategory, cProduct, cGroup, cGridRefer))
	::setOrder("ACV_FILIAL, ACV_CATEGO, ACV_GRUPO, ACV_CODPRO")

	::setIsCaseSensitive(.T.) // Define a consulta como case sensitive, para que o filtro de pesquisa funcione corretamente

	AddMapFieldsACV( Self )

	If ValType( aURLFilter ) == "A" .And. Len( aURLFilter ) > 0
		::setUrlFilter( aURLFilter )
	Endif

	If !Empty( cSort )
		::setOrderQuery( cSort )
	EndIf

	If !Empty( cFields )
		::setFields( cFields )
	Endif

	If ::Execute()
		::FillGetResponse()
	EndIf

	FWRestArea( aArea )
	aSize( aArea, 0 )
Return Nil

//------------------------------------------------------------------------------
/*/{Protheus.doc} rowToJson
	Converte uma linha do recordset em um objeto JSON
	Adiciona o campo 'key' com InternalId codificado em Base64

	@sample     RowToJson(cAlias, aFields, lEmpty)
	@type       method
	@param      cAlias  , Character , Alias temporário da query
	@param      aFields , Array     , Array de campos
	@param      lEmpty  , Logical   , Indica se retorna vazio
	@return     Json object with record data
	@author     cruz.rafael / Squad Retail
	@since      12/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method rowToJson(cAlias as Character, aFields as Array, lEmpty as Logical) Class ProductCategoryLinkProtheusData
	Local nLoop    as Integer
	Local cContent as Character

	Default cAlias  := ""
	Default aFields := {}
	Default lEmpty  := .F.

	If !Empty(cAlias)
		// Adiciona o campo 'key' com o InternalId codificado em Base64
		If !Empty((cAlias)->internalid)
			Self:oJsonObj:setProp('key', Encode64((cAlias)->internalid), .F.)
		EndIf
		
		// Processa os demais campos
		For nLoop := 1 to Len(aFields)
			If lEmpty
				cContent := ''
			Else
				cContent := ::ValueToJson(aFields[nLoop, LABEL], (cAlias)->(&(aFields[nLoop, VALUE])))
			EndIf
			
			Self:oJsonObj:setProp(aFields[nLoop, LABEL], cContent, lEmpty)
		Next nLoop
	EndIf
	
Return Nil

//------------------------------------------------------------------------------
/*/{Protheus.doc} AddMapFieldsACV
	Cria o Mapa de campos Protheus x API para as Amarrações Categoria x Grupo/Produto.

	@sample     AddMapFieldsACV( self )
	@type       Function
	@param      oSelf, Object, Objeto com herança da classe FWAdapterBaseV2
	@author     cruz.rafael / Squad Retail
	@since      12/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Function AddMapFieldsACV(oSelf as Object)
	Local aInternalId := GetInternalId( { "ACV_FILIAL", "ACV_CATEGO","ACV_GRUPO","ACV_CODPRO","ACV_REFGRD" } )

	oSelf:AddMapFields("internalId"          , "internalId", .T., .T., { "internalId", 'C', aInternalId[1], 0 }, aInternalId[2])
	oSelf:AddMapFields("branchId"            , "ACV_FILIAL", .T., .T., { "ACV_FILIAL", 'C', GetFieldLength("ACV_FILIAL"), 0 })
	oSelf:AddMapFields("code"                , "ACV_CATEGO", .T., .T., { "ACV_CATEGO", 'C', GetFieldLength("ACV_CATEGO"), 0 })
	oSelf:AddMapFields("groupId"             , "ACV_GRUPO" , .T., .T., { "ACV_GRUPO" , 'C', GetFieldLength("ACV_GRUPO") , 0 })
	oSelf:AddMapFields("productId"           , "ACV_CODPRO", .T., .T., { "ACV_CODPRO", 'C', GetFieldLength("ACV_CODPRO"), 0 })
	oSelf:AddMapFields("gridReferId"         , "ACV_REFGRD", .T., .T., { "ACV_REFGRD", 'C', GetFieldLength("ACV_REFGRD"), 0 })
	oSelf:AddMapFields("productSeq"          , "ACV_SEQPRD", .T., .T., { "ACV_SEQPRD", 'C', GetFieldLength("ACV_SEQPRD"), 0 })
	oSelf:AddMapFields("productDescription"  , "B1_DESC"   , .T., .T., { "B1_DESC"   , 'C', GetFieldLength("B1_DESC"), 0 })
	oSelf:AddMapFields("groupDescription"    , "BM_DESC"   , .T., .T., { "BM_DESC"   , 'C', GetFieldLength("BM_DESC"), 0 })
	oSelf:AddMapFields("gridReferDescription", "B4_DESC"   , .T., .T., { "B4_DESC"   , 'C', GetFieldLength("B4_DESC"), 0 })
	oSelf:AddMapFields("categoryDescription" , "ACU_DESC"  , .T., .T., { "ACU_DESC"  , 'C', GetFieldLength("ACU_DESC"), 0 })
Return Nil

//------------------------------------------------------------------------------
/*/{Protheus.doc} handleProductCategoryLink
	Gerencia as operações de POST, PUT e DELETE com validações completas do FATA150

	@sample     handleProductCategoryLink(3, jBody)
	@type       method
	@param      nOperation  , Numeric   , Operação (3=INSERT, 4=UPDATE, 5=DELETE)
	@param      jBody       , Json      , Dados para inclusão/alteração
	@param      cInternalId , Character , InternalId para alteração/exclusão (Base64)
	@return     jResponse   , Json      , Response com resultado da operação
	@author     cruz.rafael / jesus.sjunior / Squad Retail
	@since      12/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method handleProductCategoryLink(nOperation as Numeric, jBody as Json, cInternalId as Character) as Json Class ProductCategoryLinkProtheusData
	Local lRet       as Logical
	Local aData      as Array
	Local cDecodedId as Character
	Local jResponse  as Json
	Local aItens     as Array
	Local nX         as Numeric
	Local nA         as Numeric

	Default nOperation  := 0
	Default jBody       := JsonObject():New()
	Default cInternalId := ""

	aData := {}

	lRet := .T.
	
	If nOperation <> 0

		::setHashFields() // Define os campos de hash

		jResponse := JsonObject():New()

		// nOperation == 3 -> Inclusão de Vínculo
		// nOperation == 4 -> Exclusão de Vínculo em lote
		// Para estas operações, a requisição envia um jBody que será tratado na função BuildData
		If nOperation == 3 .Or. nOperation == 4
			
			aItens := jBody:GetJsonObject("items")
			If !Empty(aItens) .AND. Len(aItens) > 0
				For nX := 1 To Len(aItens)
					aAdd(aData, BuildData(aItens[nX], self))
				Next
			EndIf

			FwFreeArray(aItens) // Libera array temporário
			
			If nOperation == 3
				jResponse := InsertLink(aData) // Efetua a inclusão do vínculo de produto na categoria
			EndIf

			// Efetua a exclusão de vínculos de produto na categoria
			// nOperation == 4 -> Exclusão de Vínculo em lote
			If nOperation == 4
				For nA := 1 To Len(aData)
					nPosId     := aScan(aData[nA],{|x| x[1] == "key"})
					cDecodedId := Decode64(aData[nA,nPosId,2])
					jResponse  := RemoveLink(cDecodedId) // Efetua e exclusão do vínculo de produto na categoria
				Next
			EndIf
			FwFreeArray(aData)
		EndIf

		// Para exclusão, busca o registro existente
		// nOperation == 5 -> Exclusão de Vínculo unitário
		If nOperation == 5
			// Verifico se o valor do cInternalId foi preenchido quando é o caso de exclusão unitária.
			If !Empty(cInternalId)
				cDecodedId := Decode64(cInternalId)
				jResponse  := RemoveLink(cDecodedId) // Efetua e exclusão do vínculo de produto na categoria
			EndIf
		EndIf
	EndIf
	
Return jResponse

//------------------------------------------------------------------------------
/*/{Protheus.doc} ProductCategoryLinkProtheusData::setHashFields
    Define os campos utilizados na operação de Incluir e Alterar.
	@type       method
	@author     cruz.rafael / Squad Retail
	@since      12/12/2025
/*/
//------------------------------------------------------------------------------
METHOD setHashFields() CLASS ProductCategoryLinkProtheusData
	Local aInternalId := GetInternalId( { "ACV_FILIAL", "ACV_CATEGO","ACV_GRUPO","ACV_CODPRO","ACV_REFGRD" } )

	::oHashFields := tHashMap():new()
	
	::oHashFields:Set("internalId" , aInternalId[2])
	::oHashFields:Set("key"        , "key")
	::oHashFields:Set("code"       , "ACV_CATEGO")
	::oHashFields:Set("groupId"    , "ACV_GRUPO" )
	::oHashFields:Set("productId"  , "ACV_CODPRO")
	::oHashFields:Set("gridReferId", "ACV_REFGRD")
	::oHashFields:Set("productSeq" , "ACV_SEQPRD")
	
Return Nil

//------------------------------------------------------------------------------
/*/{Protheus.doc} getAvailableProducts
	Lista produtos disponiveis para vinculo (excluindo os ja vinculados)
	@type       method
	@param      cCategoryCode, Character, Código da categoria para filtro dos produtos disponíveis
	@param      cGroupSearch , Character, Termo de busca para código ou descrição do produto
	@param      nPage        , Numeric, Número da página para paginação dos resultados
	@param      nPageSize    , Numeric, Quantidade de registros por página para paginação dos resultados
	@return     jResponse    , Json, Objeto JSON contendo a lista de produtos disponíveis e informações de paginação
	@author     cruz.rafael / Squad Retail
	@since      18/12/2025
/*/
//------------------------------------------------------------------------------
Method getAvailableProducts(cCategoryCode as Character, cGroupSearch as Character, nPage as Numeric, nPageSize as Numeric) as Json Class ProductCategoryLinkProtheusData
	Local cAliasQry as Character
	Local jResponse as Json
	Local jData     as Json
	Local aProducts as Array
	Local nTotal    as Numeric
	Local nOffset   as Numeric
	Local oMainExec as Object

	Default cCategoryCode := ""
	Default cGroupSearch  := ""
	Default nPage         := 1
	Default nPageSize     := 10
	
	jResponse := JsonObject():New()
	nOffset   := (nPage - 1) * nPageSize
	
	// Usa query parametrizada seguindo padrão GetQueryACV
	oMainExec := NIL
	cAliasQry := GetQueryAvailableProducts(oMainExec, cCategoryCode, cGroupSearch)
	
	aProducts := {}
	nTotal := 0
	
	While !(cAliasQry)->(Eof())
		nTotal++
		If nTotal > nOffset .And. Len(aProducts) < nPageSize
			jData := JsonObject():New()
			jData['productId']          := (cAliasQry)->B1_COD
			jData['productDescription'] := AllTrim((cAliasQry)->B1_DESC)
			aAdd(aProducts, jData)
		EndIf
		(cAliasQry)->(DbSkip())
	EndDo
	
	(cAliasQry)->(DbCloseArea())

	If nTotal >= 1 .And. Len(aProducts) > 0
		jResponse['hasNext']  := (nTotal > (nOffset + nPageSize))
		jResponse['items']    := aClone(aProducts)
		jResponse['total']    := nTotal
		jResponse['page']     := nPage
		jResponse['pageSize'] := nPageSize
	Else
		jResponse["error"] := FWHttpEncode(STR0006) // "Nenhum registro localizado."
	EndIf

	FwFreeArray(aProducts) // Libera array temporário
	
Return jResponse

