//------------------------------------------------------------------------------
/*/{Protheus.doc} GetQuery
	Obtém a query preparada para execução.

	@sample     GetQuery(cQuery)
	@type       Function
	@param      cQuery, Character, Expressão SQL
	@return     oPrepared, Object, Objeto de query preparada
	@author     Jorge Martins / Squad Retail
	@since      17/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Static Function GetQuery(cQuery as Character) as Object
	Local oPrepared    as Object
	Local nPosPrepared as Numeric
	Local cMD5         as Character
	
	Default cQuery := ""

	cMD5 := MD5(cQuery)
	If (nPosPrepared := Ascan(__aPrepared,{|x| x[2] == cMD5})) == 0
		cQuery := ChangeQuery(cQuery)
		Aadd(__aPrepared,{FwExecStatement():New(cQuery), cMD5})
		nPosPrepared := Len(__aPrepared)
	Endif

	oPrepared := __aPrepared[nPosPrepared][1]

Return oPrepared

//------------------------------------------------------------------------------
/*/{Protheus.doc} SetValue
	Função que seta os valores a serem incluídos/alterados no modelo

	@sample     setValue()
	@type       Function
	@param      aData , Array, Array de campos e valores a serem setados no modelo
	@param      oModel, Object, Modelo onde os valores serão setados
	@param      cTable, Character, Tabela da operação
	@return     lRet  , Logical, Indica se os valores foram setados com sucesso
	@author     cruz.rafael / Squad Retail
	@since      24/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Static Function SetValue(aData as Array, oModel as Object, cTable as Character) as Logical
	Local nA   as Numeric
	Local nX   as Numeric
	Local lRet as Logical

	Default aData  := {}
	Default oModel := Nil
	Default cTable := ""

	lRet := .T.
	For nA := 1 To Len(aData)
		If nA > 1
			oModel:AddLine()
		EndIf	
		For nX := 1 To Len(aData[nA])
			If (aData[nA,nX,1] != cTable + "_SEQPRD")
				If !oModel:SetValue(aData[nA,nX,1], aData[nA,nX,2])
					lRet := .F.
					Exit
				EndIf
			EndIf
		Next nX
	Next nA
Return lRet

//------------------------------------------------------------------------------
/*/{Protheus.doc} BuildData
	Retorna os campos alterados para utilizar no modelo

	@sample     BuildData()
	@type       Function
	@param      jBody, oData
	@return     aData, Array, Campos a serem alterados no Model
	@author     cruz.rafael / Squad Retail
	@since      24/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Static Function BuildData(jBody as Json, oData as Object) as Array
	Local aData   as Array
	Local aFields as Array
	Local cField  as Character
	Local nField  as Numeric

	aData   := {}
	aFields := {}
	
	aFields := jBody:GetNames()

	// Garante que campos obrigatórios existam no JSON (mesmo vazios)
	// Necessário para o Model funcionar corretamente
	If !jBody:HasProperty('productId')
		jBody['productId'] := ''
	EndIf
	If !jBody:HasProperty('groupId')
		jBody['groupId'] := ''
	EndIf
	If !jBody:HasProperty('gridReferId')
		jBody['gridReferId'] := ''
	EndIf

	For nField := 1 To Len(aFields)
		If oData:oHashFields:get( aFields[nField],@cField )
			aAdd(aData, {cField, jBody[aFields[nField]]})
		EndIf
	Next

	FwFreeArray(aFields) // Libera array temporário

Return aData

//------------------------------------------------------------------------------
/*/{Protheus.doc} GetQueryAvailableGrids
	Obtém a Query para buscar grades disponíveis para vinculação
	(exclui grades já vinculadas à categoria)

	@sample     GetQueryAvailableGrids()
	@type       Function
	@param      oMainExec, Object, Objeto de execução da query
	@param      cCategoryCode, Character, Código da categoria
	@param      cGroupSearch, Character, Termo de busca (código/descrição)
	@return     cAliasQry, Character, Alias da query aberta
	@author     cruz.rafael / Squad Retail
	@since      18/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Static Function GetQueryAvailableGrids(oMainExec as object, cCategoryCode as Character, cGroupSearch as Character) as character
	Local cQuery    as character
	Local nParam    as Numeric
	Local cAliasQry as Character

	Default oMainExec     := NIL
	Default cCategoryCode := ""
	Default cGroupSearch  := ""

	nParam := 1

	If oMainExec == NIL
	
		cQuery :=   " SELECT SB4.B4_COD, SB4.B4_DESC"
		cQuery +=     " FROM " + RetSqlName("SB4") + " SB4"
		cQuery +=    " WHERE SB4.D_E_L_E_T_ = ?" // #1
		cQuery +=      " AND SB4.B4_FILIAL = ?" // #2
		cQuery +=      " AND NOT EXISTS ("
		cQuery +=                        " SELECT 1 FROM " + RetSqlName("ACV") + " ACV"
		cQuery +=                         " WHERE ACV.ACV_FILIAL = ?" // #3
		cQuery +=                           " AND ACV.ACV_CATEGO = ?" // #4
		cQuery +=                           " AND ACV.ACV_REFGRD = SB4.B4_COD"
		cQuery +=                           " AND ACV.D_E_L_E_T_ = ?" // #5
		cQuery +=                      " )"
		
		If !Empty(cGroupSearch)
			cQuery += " AND (SB4.B4_COD LIKE ? OR SB4.B4_DESC LIKE ?)" // #6 e #7
		EndIf
		
		cQuery +=   " ORDER BY SB4.B4_COD"
		
		oMainExec := FWExecStatement():new(cQuery)
	
	EndIf

	// Parâmetros para WHERE principal
	oMainExec:setString(nParam++, Space(1)) // #1
	oMainExec:setString(nParam++, FWxFilial("SB4")) // #2
	
	// Parâmetros para NOT EXISTS
	oMainExec:setString(nParam++, FWxFilial("ACV")) // #3
	oMainExec:setString(nParam++, PadR(cCategoryCode, TamSX3("ACV_CATEGO")[1])) // #4
	oMainExec:setString(nParam++, Space(1)) // #5
	
	// Parâmetros para LIKE (se houver filtro de busca)
	If !Empty(cGroupSearch)
		oMainExec:setString(nParam++, "%" + Upper(AllTrim(cGroupSearch)) + "%") // #6
		oMainExec:setString(nParam++, "%" + Upper(AllTrim(cGroupSearch)) + "%") // #7
	EndIf

	cAliasQry := GetNextAlias()
	oMainExec:OpenAlias(cAliasQry)

Return cAliasQry

//------------------------------------------------------------------------------
/*/{Protheus.doc} GetQueryAvailableGroups
	Obtém a Query para buscar grupos disponíveis para vinculação
	(exclui grupos já vinculados à categoria)

	@sample     GetQueryAvailableGroups()
	@type       Function
	@param      oMainExec, Object, Objeto de execução da query
	@param      cCategoryCode, Character, Código da categoria
	@param      cGroupSearch, Character, Termo de busca (código/descrição)
	@return     cAliasQry, Character, Alias da query aberta
	@author     cruz.rafael / Squad Retail
	@since      18/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Static Function GetQueryAvailableGroups(oMainExec as object, cCategoryCode as Character, cGroupSearch as Character) as character
	Local cQuery    as Character
	Local nParam    as Numeric
	Local cAliasQry as Character

	Default oMainExec     := NIL
	Default cCategoryCode := ""
	Default cGroupSearch  := ""

	nParam := 1

	If oMainExec == NIL
	
		cQuery :=   " SELECT SBM.BM_GRUPO, SBM.BM_DESC"
		cQuery +=     " FROM " + RetSqlName("SBM") + " SBM"
		cQuery +=    " WHERE SBM.D_E_L_E_T_ = ?" // #1
		cQuery +=      " AND SBM.BM_FILIAL = ?" // #2
		cQuery +=      " AND NOT EXISTS ("
		cQuery +=                        " SELECT 1 FROM " + RetSqlName("ACV") + " ACV"
		cQuery +=                         " WHERE ACV.ACV_FILIAL = ?" // #3
		cQuery +=                           " AND ACV.ACV_CATEGO = ?" // #4
		cQuery +=                           " AND ACV.ACV_GRUPO = SBM.BM_GRUPO"
		cQuery +=                           " AND ACV.D_E_L_E_T_ = ?" // #5
		cQuery +=                      " )"
		
		If !Empty(cGroupSearch)
			cQuery += " AND (SBM.BM_GRUPO LIKE ? OR SBM.BM_DESC LIKE ?)" // #6 e #7
		EndIf
		
		cQuery +=   " ORDER BY SBM.BM_GRUPO"
		
		oMainExec := FWExecStatement():new(cQuery)
	
	EndIf

	// Parâmetros para WHERE principal
	oMainExec:setString(nParam++, Space(1)) // #1
	oMainExec:setString(nParam++, FWxFilial("SBM")) // #2
	
	// Parâmetros para NOT EXISTS
	oMainExec:setString(nParam++, FWxFilial("ACV")) // #3
	oMainExec:setString(nParam++, PadR(cCategoryCode, TamSX3("ACV_CATEGO")[1])) // #4
	oMainExec:setString(nParam++, Space(1)) // #5
	
	// Parâmetros para LIKE (se houver filtro de busca)
	If !Empty(cGroupSearch)
		oMainExec:setString(nParam++, "%" + Upper(AllTrim(cGroupSearch)) + "%") // #6
		oMainExec:setString(nParam++, "%" + Upper(AllTrim(cGroupSearch)) + "%") // #7
	EndIf

	cAliasQry := GetNextAlias()
	oMainExec:OpenAlias(cAliasQry)

Return cAliasQry

//------------------------------------------------------------------------------
/*/{Protheus.doc} GetQueryAvailableProducts
	Obtém a Query para buscar produtos disponíveis para vinculo
	(exclui produtos já vinculados à categoria)

	@sample     GetQueryAvailableProducts()
	@type       Function
	@param      oMainExec, Object, Objeto de execução da query
	@param      cCategoryCode, Character, Código da categoria
	@param      cGroupSearch, Character, Termo de busca (código/descrição)
	@return     cAliasQry, Character, Alias da query aberta
	@author     cruz.rafael / Squad Retail
	@since      18/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Static Function GetQueryAvailableProducts(oMainExec as object, cCategoryCode as Character, cGroupSearch as Character) as character
	Local cQuery    as Character
	Local nParam    as Numeric
	Local cAliasQry as Character

	Default oMainExec     := NIL
	Default cCategoryCode := ""
	Default cGroupSearch  := ""

	nParam := 1

	If oMainExec == NIL
	
		cQuery :=   " SELECT SB1.B1_COD, SB1.B1_DESC"
		cQuery +=     " FROM " + RetSqlName("SB1") + " SB1"
		cQuery +=    " WHERE SB1.D_E_L_E_T_ = ?" // #1
		cQuery +=      " AND SB1.B1_FILIAL = ?" // #2
		cQuery +=      " AND SB1.B1_MSBLQL <> ?" // #3
		cQuery +=      " AND NOT EXISTS ("
		cQuery +=                        " SELECT 1 FROM " + RetSqlName("ACV") + " ACV"
		cQuery +=                         " WHERE ACV.ACV_FILIAL = ?" // #4
		cQuery +=                           " AND ACV.ACV_CATEGO = ?" // #5
		cQuery +=                           " AND ACV.ACV_CODPRO = SB1.B1_COD"
		cQuery +=                           " AND ACV.ACV_REFGRD = ?" // #6
		cQuery +=                           " AND ACV.D_E_L_E_T_ = ?" // #7
		cQuery +=                     " )"
		
		If !Empty(cGroupSearch)
			cQuery += " AND (SB1.B1_COD LIKE ? OR SB1.B1_DESC LIKE ?)" // #8 e #9
		EndIf
		
		cQuery +=   " ORDER BY SB1.B1_COD"
		
		oMainExec := FWExecStatement():new(cQuery)
	
	EndIf

	// Parâmetros para WHERE principal
	oMainExec:setString(nParam++, Space(1)) // #1
	oMainExec:setString(nParam++, FWxFilial("SB1")) // #2
	oMainExec:setString(nParam++, "1") // #3
	
	// Parâmetros para NOT EXISTS
	oMainExec:setString(nParam++, FWxFilial("ACV")) // #4
	oMainExec:setString(nParam++, PadR(cCategoryCode, TamSX3("ACV_CATEGO")[1])) // #5
	oMainExec:setString(nParam++, Space(TamSX3("ACV_REFGRD")[1])) // #6
	oMainExec:setString(nParam++, Space(1)) // #7
	
	// Parâmetros para LIKE (se houver filtro de busca)
	If !Empty(cGroupSearch)
		oMainExec:setString(nParam++, "%" + Upper(AllTrim(cGroupSearch)) + "%") // #8
		oMainExec:setString(nParam++, "%" + Upper(AllTrim(cGroupSearch)) + "%") // #9
	EndIf

	cAliasQry := GetNextAlias()
	oMainExec:OpenAlias(cAliasQry)

Return cAliasQry

//------------------------------------------------------------------------------
/*/{Protheus.doc} GetQueryACV
	Obtém a Query customizada para buscar dados da ACV com JOINs nas tabelas 
	relacionadas (SB1, SBM, SB4, ACU) para trazer as descrições

	@sample     GetQueryACV()
	@type       Function
	@param      oMainExec, Object, Objeto de execução da query
	@return     cQuery, character, expressão SQL
	@author     cruz.rafael / Squad Retail
	@since      15/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Static Function GetQueryACV(oMainExec as object) as character
	Local cQuery as character
	Local nParam as Numeric

	Default oMainExec := NIL

	nParam := 1

	If oMainExec == NIL
	
		cQuery := " SELECT ?" // #1 - Campos do SELECT
		cQuery +=   " FROM " + RetSqlName("ACV") + " ACV"
		
		// LEFT JOIN com SB1 (Produtos)
		cQuery +=   " LEFT JOIN " + RetSqlName("SB1") + " SB1 "
		cQuery +=     " ON ?" // #2
		cQuery +=    " AND SB1.B1_COD = ACV.ACV_CODPRO "
		cQuery +=    " AND SB1.D_E_L_E_T_ = ?" // #3
		
		// LEFT JOIN com SBM (Grupos de Produtos)
		cQuery +=   " LEFT JOIN " + RetSqlName("SBM") + " SBM "
		cQuery +=     " ON ?" // #4
		cQuery +=    " AND SBM.BM_GRUPO = ACV.ACV_GRUPO "
		cQuery +=    " AND SBM.D_E_L_E_T_ = ?" // #5
		
		// LEFT JOIN com SB4 (Grades/Referências)
		cQuery +=   " LEFT JOIN " + RetSqlName("SB4") + " SB4 "
		cQuery +=     " ON ?" // #6
		cQuery +=    " AND SB4.B4_COD = ACV.ACV_REFGRD "
		cQuery +=    " AND SB4.D_E_L_E_T_ = ?" // #7
		
		// LEFT JOIN com ACU (Categorias)
		cQuery +=   " LEFT JOIN " + RetSqlName("ACU") + " ACU "
		cQuery +=     " ON ?" // #8
		cQuery +=    " AND ACU.ACU_COD = ACV.ACV_CATEGO "
		cQuery +=    " AND ACU.D_E_L_E_T_ = ?" // #9
		
		cQuery +=  " WHERE ?" // #10 - Condições do WHERE
		
		oMainExec := FWExecStatement():new(cQuery)
	
	EndIf

	// Parâmetros para SELECT
	oMainExec:setUnsafe(nParam++, "#QueryFields#") // #1
	
	// Parâmetros para JOIN SB1
	oMainExec:setUnsafe(nParam++, FWJoinFilial("SB1", "ACV")) // #2
	oMainExec:setString(nParam++, Space(1)) // #3
	
	// Parâmetros para JOIN SBM
	oMainExec:setUnsafe(nParam++, FWJoinFilial("SBM", "ACV")) // #4
	oMainExec:setString(nParam++, Space(1)) // #5
	
	// Parâmetros para JOIN SB4
	oMainExec:setUnsafe(nParam++, FWJoinFilial("SB4", "ACV")) // #6
	oMainExec:setString(nParam++, Space(1)) // #7
	
	// Parâmetros para JOIN ACU
	oMainExec:setUnsafe(nParam++, FWJoinFilial("ACU", "ACV")) // #8
	oMainExec:setString(nParam++, Space(1)) // #9
	
	// Parâmetro para WHERE
	oMainExec:setUnsafe(nParam++, "#QueryWhere#") // #10

	cQuery := oMainExec:getFixQuery()

Return cQuery

//------------------------------------------------------------------------------
/*/{Protheus.doc} GetFilterACV
	Obtem o filtro da ACV utilizado na query

	@sample     GetFilterACV()
	@type       Function
	@param      cSearchText , Character, Texto de pesquisa
	@return     cWhere      , Character, Expressão utilizada na consulta
	@author     Rafael Cruz / Jesus Junior / Squad Retail
	@since      04/02/2026
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Function GetFilterACV(cCategory as Character, cProduct as Character, cGroup as Character, cGridRefer as Character) as Character
	Local cWhere as Character

	Default cCategory  := ""
	Default cProduct   := ""
	Default cGroup     := ""
	Default cGridRefer := ""

	cWhere := " ACV.ACV_FILIAL = '" + FWxFilial("ACV") + "' AND ACV.D_E_L_E_T_ = ' '"
	
	// Filtros específicos
	If !Empty(cCategory)
		cWhere += " AND UPPER(ACV.ACV_CATEGO) = '" + Upper(PadR(cCategory, TamSX3("ACV_CATEGO")[1])) + "' "
	EndIf
	
	If !Empty(cProduct)
		cWhere += " AND UPPER(ACV.ACV_CODPRO) = '" + Upper(PadR(cProduct, TamSX3("ACV_CODPRO")[1])) + "' "
	EndIf
	
	If !Empty(cGroup)
		cWhere += " AND UPPER(ACV.ACV_GRUPO) = '" + Upper(PadR(cGroup, TamSX3("ACV_GRUPO")[1])) + "' "
	EndIf
	
	If !Empty(cGridRefer)
		cWhere += " AND UPPER(ACV.ACV_REFGRD) = '" + Upper(PadR(cGridRefer, TamSX3("ACV_REFGRD")[1])) + "' "
	EndIf

Return cWhere

//------------------------------------------------------------------------------
/*/{Protheus.doc} GetResponse
	Obtem o response após a operação de inclusão/alteração/exclusão

	@sample     GetResponse()
	@type       Function
	@param      aData       , Array, Array de dados enviados para o Model
	@param      nOpc        , Numeric, Tipo de operação (3 - Insert, 4 - Update, 5 - Delete)
	@return     jResponse   , Json, Objeto Json com o response formatado
	@author     Rafael Cruz / Jesus Junior / Squad Retail
	@since      04/02/2026
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Static Function GetResponse(aData as Array, nOpc as Numeric) as Json
Local jResponse  as Json
Local cFilialAux as Character
Local cCategAux  as Character
Local cGrupoAux  as Character
Local cProdAux   as Character
Local cRefGrdAux as Character
Local cMessage   as Character
Local nY         as Numeric
Local nPos       as Numeric
Local aResult    as Array
Local jItens     as Json

Default aData := {}
Default nOpc  := 0

	jResponse := JsonObject():New()

	// Monta chave de busca com os dados que foram setados
	cFilialAux := FWxFilial("ACV")
	cCategAux  := ""
	cGrupoAux  := ""
	cProdAux   := ""
	cRefGrdAux := ""
	aResult    := {}

	Do Case
		Case nOpc == 3
			cMessage := STR0002 // "Registro(s) incluído(s) com sucesso."
		Case nOpc == 5
			cMessage := STR0004 // "Registro(s) excluído(s) com sucesso."
	EndCase

	// Quando é inclusão ou alteração, 
	// pega valores do array aData que foi enviado ao Model
	If nOpc == 3
		For nY := 1 To Len(aData)
			For nPos := 1 To Len(aData[nY])
				If aData[nY][nPos,1] == "ACV_CATEGO"
					cCategAux  := aData[nY][nPos][2]
				ElseIf aData[nY][nPos,1] == "ACV_GRUPO"
					cGrupoAux  := aData[nY][nPos][2]
				ElseIf aData[nY][nPos,1] == "ACV_CODPRO"
					cProdAux   := aData[nY][nPos][2]
				ElseIf aData[nY][nPos,1] == "ACV_REFGRD"
					cRefGrdAux := aData[nY][nPos][2]
				EndIf
			Next nPos
			jItens := JsonObject():New()
			jItens['internalId']  := cFilialAux + cCategAux + cGrupoAux + cProdAux + cRefGrdAux
			jItens['key']         := Encode64(cFilialAux + cCategAux + cGrupoAux + cProdAux + cRefGrdAux)
			jItens['branchId']    := cFilialAux
			jItens['code']        := cCategAux
			jItens['groupId']     := cGrupoAux
			jItens['productId']   := cProdAux
			jItens['gridReferId'] := cRefGrdAux
			aAdd(aResult, jItens)
		Next nY
	EndIf

	jResponse['code']    := 201
	jResponse['message'] := FwHttpEncode(cMessage)
	jResponse['data']    := aClone(aResult)

	FwFreeArray(aResult)
	FwFreeObj(jItens)
Return jResponse

//------------------------------------------------------------------------------
/*/{Protheus.doc} InsertLink
	Função de inclusão de vínculo de produto na categoria

	@sample     InsertLink()
	@type       Function
	@param      aData     , Array, Array de dados enviados para o Model
	@return     jResponse , Json, Objeto Json com o response formatado
	@author     Rafael Cruz / Squad Retail
	@since      06/02/2026
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Static Function InsertLink(aData as Array) as Json
Local oModel     as Object
Local oModelGrid as Object
Local cErroMVC   as Character
Local aMsgErro   as Array
Local jResponse  as Json

Default aData := {}

	jResponse := JsonObject():New()
	
	// Processa com FWLoadModel para POST e PUT
	oModel := FWLoadModel("FATA150A")
	oModelGrid := oModel:GetModel("ACVDETAIL")
	
	oModel:setOperation(MODEL_OPERATION_INSERT)

	oModel:Activate()
	// Verifica se o Model foi ativado e se os valores foram setados corretamente
	If oModel:IsActive()
		SetValue(aData, oModelGrid, 'ACV')
	EndIf

	If oModel:VldData() .And. oModel:CommitData()
		// Sucesso - Busca dados direto da tabela após commit para retornar no response
		jResponse := GetResponse(aData, 3)
	Else
		aMsgErro := oModel:GetErrorMessage()
		If Len(aMsgErro) >= 6 .And. ValType(aMsgErro[6]) == "C" .and. !Empty(aMsgErro[6])
			cErroMVC := Alltrim(aMsgErro[6]) + " - " + Alltrim(aMsgErro[8])
			jResponse['error'] := FWHttpEncode(cErroMVC)
		EndIf

		aSize(aMsgErro, 0)
	EndIf

	oModel:DeActivate()
	FreeObj(oModelGrid)
	FreeObj(oModel)

Return jResponse

//------------------------------------------------------------------------------
/*/{Protheus.doc} RemoveLink
	Função de exclusão de vínculo de produto na categoria

	@sample     RemoveLink()
	@type       Function
	@param      cChave    , Caracter, String com a chave do registro
	@return     jResponse , Json, Objeto Json com o response formatado
	@author     Rafael Cruz / Squad Retail
	@since      06/02/2026
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Static Function RemoveLink(cChave as Character) as Json
Local aArea     as Array
Local aAreaACV  as Array
Local aChave    as Array
Local jResponse as Json
Local nOrdem    as Json
Local cChaveOrd as Character

Default cChave := ""

	If !Empty(cChave)
		aArea     := FWGetArea()
		aAreaACV  := ACV->(FWGetArea())
		jResponse := JsonObject():New()
		
		dbSelectArea("ACV")

		aChave    := GetChvACV(cChave)
		nOrdem    := aChave[1] // Ordem do índice definida conforme chave enviada (pode ser por chave de produto, grupo ou grade)
		cChaveOrd := aChave[2] // Chave formatada para busca conforme ordem dos campos no índice

		ACV->(dbSetOrder(nOrdem))
		
		If ACV->(MsSeek(cChaveOrd))
			If ACV->(SimpleLock())
				If RemoveD4X(ACV->ACV_CATEGO, ACV_CODPRO) // Remove vínculo com características na D4X quando for excluído o vínculo do produto com a categoria
					RecLock("ACV",.F.)
						ACV->(dbDelete())
					ACV->(MsUnlock())

					jResponse := GetResponse({}, 5)
				Else
					jResponse['error'] := FwHttpEncode(STR0005) // "Registro bloqueado. O registro foi bloqueado por outro usuário e não poderá ser excluído."
					ACV->(MsRUnlock())
				EndIf
			Else
				jResponse['error'] := FwHttpEncode(STR0005) // "Registro bloqueado. O registro foi bloqueado por outro usuário e não poderá ser excluído."
			EndIf
		Else
			jResponse['error'] := FwHttpEncode(STR0001) // "Registro não encontrado. Não foi encontrado registro com o InternalId informado."
		EndIf

		FWRestArea(aAreaACV)
		FWRestArea(aArea)
	EndIf

Return jResponse

//------------------------------------------------------------------------------
/*/{Protheus.doc} GetChvACV
	Define a ordem e chave de busca na ACV conforme os campos preenchidos na chave

	@sample     GetChvACV()
	@type       Function
	@param      cChave    , Caracter, String com a chave do registro
	@return     aRet      , Array, Array com a ordem e chave de busca formatada
	@author     Jorge Martins / Squad Retail
	@since      09/02/2026
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Static Function GetChvACV(cChave as Character) as Array
Local nTamFil   as Numeric
Local nTamCateg as Numeric
Local nTamProd  as Numeric
Local nTamGrupo as Numeric
Local nTamGrade as Numeric
Local nOrdem    as Numeric
Local cFilACV   as Character
Local cCateg    as Character
Local cProd     as Character
Local cGrupo    as Character
Local cGrade    as Character
Local cChaveOrd as Character
Local aRet      as Array

Default cChave := ""

	nTamFil   := GetSx3Cache("ACV_FILIAL", "X3_TAMANHO") // Tamanho da filial
	nTamCateg := GetSx3Cache("ACV_CATEGO", "X3_TAMANHO") // Tamanho da categoria
	nTamGrupo := GetSx3Cache("ACV_GRUPO" , "X3_TAMANHO") // Tamanho do grupo
	nTamProd  := GetSx3Cache("ACV_CODPRO", "X3_TAMANHO") // Tamanho do produto
	nTamGrade := GetSx3Cache("ACV_REFGRD", "X3_TAMANHO") // Tamanho da grade/referência

	cFilACV := SubStr(cChave, 1, nTamFil)
	cCateg  := SubStr(cChave, nTamFil + 1, nTamCateg)
	cGrupo  := SubStr(cChave, nTamFil + nTamCateg + 1, nTamGrupo)
	cProd   := SubStr(cChave, nTamFil + nTamCateg + nTamGrupo + 1, nTamProd)
	cGrade  := SubStr(cChave, nTamFil + nTamCateg + nTamGrupo + nTamProd + 1, nTamGrade)
	
	// Produto
	If !Empty(AllTrim(cProd))
		nOrdem    := 5 // ACV_FILIAL + ACV_CODPRO + ACV_CATEGO
		cChaveOrd := cFilACV + cProd + cCateg

	// Grupo
	ElseIf !Empty(AllTrim(cGrupo))
		nOrdem    := 1 // ACV_FILIAL + ACV_CATEGO + ACV_GRUPO + ACV_CODPRO
		cChaveOrd := cFilACV + cCateg + cGrupo + Space(nTamProd)

	// Grade
	ElseIf !Empty(AllTrim(cGrade))
		nOrdem    := 3 // ACV_FILIAL + ACV_CATEGO + ACV_GRUPO + ACV_REFGRD
		cChaveOrd := cFilACV + cCateg + Space(nTamGrupo) + cGrade
	EndIf

	aRet := {nOrdem, cChaveOrd}

Return aRet

//-------------------------------------------------------------------
/*/{Protheus.doc} RemoveD4X
Exclui o vínculo do produto com as características da categoria na tabela D4X
quando a característica é desvinculada da categoria

	@sample     RemoveD4X("CATEG1", "PROD1")
	@type       Function
	@param      cCategoria, Código da categoria
	@param      cProduto  , Código do produto
	@return     lValid    , Logical, Indica se a exclusão foi realizada com sucesso
	@author     Rafael Cruz / Squad Retail
	@since      05/03/2026
	@version    12.1.2610
/*/
//-------------------------------------------------------------------
Static Function RemoveD4X(cCategoria as Character, cProduto as Character) as Logical
Local lValid    As Logical
Local cQuery    As Character
Local cAliasExc As Character
Local oExc      As Object
Local nParam    As Numeric
Local aAreaExc  As Array
Local aAreaD4X  As Array
Local aCaract   As Array

Default cCategoria := ""
Default cProduto   := ""

	lValid := .T.

	If FwAliasInDic("D4X") .And. !Empty(cCategoria) .And. !Empty(cProduto) .And. FindFunction("Ft150Carac")

		aCaract := Ft150Carac(cCategoria)

		If Len(aCaract) > 0
	
			aAreaExc := FwGetArea()
			aAreaD4X := D4X->(FwGetArea())

			cAliasExc := GetNextAlias()

			cQuery :=   "SELECT D4X.R_E_C_N_O_ NRECNO"
			cQuery +=    " FROM " + RetSqlName("D4X") + " D4X"
			cQuery +=   " WHERE D4X.D4X_FILIAL = ?"  // #1
			cQuery +=     " AND D4X.D4X_CARAC IN (?)"  // #2
			cQuery +=     " AND D4X.D4X_PROD = ?"  // #3
			cQuery +=     " AND D4X.D_E_L_E_T_ = ?"  // #4

			oExc := GetQuery(cQuery) // Obtém o objeto de query preparada (FwExecStatement)

			nParam := 1
			oExc:SetString(nParam++, FWxFilial("D4X")) // #1
			oExc:SetIn(nParam++, aCaract) // #2
			oExc:SetString(nParam++, cProduto) // #3
			oExc:SetString(nParam++, Space(1)) // #4

			oExc:OpenAlias(cAliasExc)

			Begin Transaction

				While (cAliasExc)->(!EOF())
					D4X->(dbGoTo((cAliasExc)->NRECNO))
					If D4X->(SimpleLock())
						RecLock("D4X",.F.)
							D4X->(dbDelete())
						D4X->(MsUnlock())
					Else
						lValid    := .F.
						DisarmTransaction()
						Exit
					EndIf
					(cAliasExc)->(DbSkip())
				EndDo

			End Transaction

			(cAliasExc)->(DBCloseArea())

			FwRestArea(aAreaD4X)
			FwRestArea(aAreaExc)
		EndIf

	EndIf

Return lValid
