#include "tlpp-core.th"
#include "backoffice.categories.productcategorylink.controller.ch"

namespace totvs.protheus.backoffice.categories.productcategorylink
using namespace totvs.protheus.backoffice.categories.util

//------------------------------------------------------------------------------
/*/{Protheus.doc} productCategoryLinkController
	API para gerenciar Amarração Categoria x Grupo/Produto (ACV)
	@type       class
	@author     cruz.rafael / Squad Retail
	@since      12/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Class ProductCategoryLinkController
	Data jResponse  as Json
	Data nPage      as Numeric
	Data nPageSize  as Numeric
	Data oService   as Object

	Public Method new() as Object

	@Get("/api/categories/v1/productCategoryLink") // Listar Amarrações Categoria x Grupo/Produto
	Public Method getProductCategoryLink() as Logical
	
	@Get("/api/categories/v1/productCategoryLink/availableProducts") // Listar Produtos Disponíveis
	Public Method getAvailableProducts() as Logical
	
	@Get("/api/categories/v1/productCategoryLink/availableGroups") // Listar Grupos Disponíveis
	Public Method getAvailableGroups() as Logical
	
	@Get("/api/categories/v1/productCategoryLink/availableGrids") // Listar Grades Disponíveis
	Public Method getAvailableGrids() as Logical
	
	@POST("/api/categories/v1/productCategoryLink/batch") // Criar múltiplas Amarrações em lote
	Public Method postBatch() as Logical

	@DELETE("/api/categories/v1/productCategoryLink/:internalid") // Deletar Amarração Categoria x Grupo/Produto
	Public Method delete() as Logical

	@DELETE("/api/categories/v1/productCategoryLink/vinculos")
	Public Method delLink() as Logical

	@Get("/api/categories/v1/productCategoryLink/parameters/mvljcatpr") // Buscar parâmetro MV_LJCATPR
	Public Method getParameterMvLjCatPr() as Logical

endClass

//------------------------------------------------------------------------------
/*/{Protheus.doc} productCategoryLinkController:new() as Object
	Obtém uma nova instancia da classe productCategoryLinkController
	@type       method
	@return     object, retorna uma nova instancia da classe.
	@author     cruz.rafael / Squad Retail
	@since      12/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method new() as Object Class productCategoryLinkController
	::oService  := productCategoryLinkService():getInstance()
	::nPage     := 1
	::nPageSize := 10000
	::jResponse := JsonObject():new()
return self

//------------------------------------------------------------------------------
/*/{Protheus.doc} productCategoryLinkController:getProductCategoryLink() as Logical
	Obtem uma lista de amarrações categoria x grupo/produto, possibilitando filtrar (QueryParam - FILTER) 
	e permitindo retornar todos os campos ou somente os campos especificados no QueryParam FIELDS.
	Observação: Ao utilizar o getProductCategoryLink o campo DELETED não será retornado. 
	@type       method
	@return     logical, Verdadeiro
	@author     cruz.rafael / Squad Retail
	@since      12/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getProductCategoryLink() as Logical Class productCategoryLinkController
	Local aItems     as Array
	Local aURLFilter as Array
	Local cFields    as Character
	Local cSort      as Character
	Local cCategory  as Character
	Local cProduct   as Character
	Local cGroup     as Character
	Local cGridRefer as Character

	aURLFilter := GetFilterParam()
	cFields    := GetQueryParam('FIELDS')
	cSort      := GetQueryParam('SORT')
	cCategory  := GetQueryParam('CATEGORY')
	cProduct   := GetQueryParam('PRODUCT')
	cGroup     := GetQueryParam('GROUP')
	cGridRefer := GetQueryParam('GRIDREFER')

	oRest:setKeyHeaderResponse('content-type', 'application/json')
	
	getPageAndPageSize(@::nPage, @::nPageSize)
	::jResponse:fromJson(::oService:getProductCategoryLink(::nPage, ::nPageSize, aURLFilter, cFields, cSort, cCategory, cProduct, cGroup, cGridRefer))
	aItems := ::jResponse:GetJsonObject( "items" )

	If Empty( aURLFilter ) .Or. ( !Empty( aItems ) .And. Len( aItems ) > 0 )
		oRest:setResponse(::jResponse)
		aSize(aItems, 0)
	Else
		SetRestFault(404, FWHttpEncode(STR0001)) // "Nenhum registro localizado"
	EndIf
	
	FWFreeArray(aURLFilter)
	FWFreeArray(aItems)

return .T.

//------------------------------------------------------------------------------
/*/{Protheus.doc} productCategoryLinkController:postBatch() as Logical
	Inclui múltiplas amarrações categoria x grupo/produto em lote
	@type       method
	@return     logical, Verdadeiro
	@author     cruz.rafael / Squad Retail
	@since      17/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method postBatch() as Logical Class productCategoryLinkController
	Local cBody     as Character
	Local jBody     as JSon

	oRest:setKeyHeaderResponse('content-type', 'application/json')

	cBody := oRest:GetBodyRequest()
	jBody := JsonObject():New()
	
	If jBody:fromJson(cBody) == NIL .AND. jBody:HasProperty("items")
		::jResponse := ::oService:postBatch(jBody)
		If ::jResponse:HasProperty("error")
			SetRestFault(400, FWHttpEncode(::jResponse["error"]))
		Else
			oRest:setResponse(::jResponse)
		EndIf
	Else
		SetRestFault(400, FWHttpEncode(STR0002)) // "Corpo da requisição inválido"
	EndIf
return .T.

//------------------------------------------------------------------------------
/*/{Protheus.doc} productCategoryLinkController:delete() as Logical
	Exclui uma amarração categoria x grupo/produto
	@type       method
	@return     logical, Verdadeiro
	@author     cruz.rafael / Squad Retail
	@since      12/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method delete() as Logical Class productCategoryLinkController
	Local cInternalId as Character
	
	oRest:setKeyHeaderResponse('content-type', 'application/json')

	cInternalId := oRest:GetPathParamsRequest()[ 'internalid' ]
	::jResponse := ::oService:delete(5,cInternalId)

	If ::jResponse:HasProperty("error")
		SetRestFault(400, FWHttpEncode(::jResponse["error"]))
	Else
		oRest:setResponse(::jResponse)
	EndIf

return .T.

//------------------------------------------------------------------------------
/*/{Protheus.doc} productCategoryLinkController:getAvailableProducts() as Logical
	Lista produtos disponiveis para vinculacao em categoria (excluindo os ja vinculados)
	@type       method
	@return     logical, Verdadeiro
	@author     cruz.rafael / Squad Retail
	@since      18/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getAvailableProducts() as Logical Class productCategoryLinkController
	Local oQueryMap     as Object
	Local cCategoryCode as Character
	Local cGroupSearch  as Character
	Local nPage         as Numeric
	Local nPageSize     as Numeric
	
	oRest:setKeyHeaderResponse('content-type', 'application/json')
	
	oQueryMap := oRest:getQueryRequest()
	
	// Parametros obrigatorios
	cCategoryCode := oQueryMap['code']
	
	// Parametros opcionais
	cGroupSearch := ''
	nPage        := 1
	nPageSize    := 10000
	
	If oQueryMap['groupSearch'] != Nil
		cGroupSearch := oQueryMap['groupSearch']
	EndIf

	If oQueryMap['page'] != Nil
		nPage := Val(oQueryMap['page'])
	EndIf

	If oQueryMap['pageSize'] != Nil
		nPageSize := Val(oQueryMap['pageSize'])
	EndIf

	::jResponse := ::oService:getAvailableProducts(cCategoryCode, cGroupSearch, nPage, nPageSize)
	If ::jResponse:HasProperty("error")
		SetRestFault(400, FWHttpEncode(::jResponse["error"]))
	Else
		oRest:setResponse(::jResponse)
	EndIf

return .T.

