//------------------------------------------------------------------------------
/*/{Protheus.doc} delLink as Logical
	Exclui amarrações categoria x grupo/produto
	@type       method
	@return     logical, Verdadeiro
	@author     cruz.rafael / Squad Retail
	@since      18/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method delLink() as Logical Class productCategoryLinkController
	Local cBody     as Character
	Local jBody     as JSon

	oRest:setKeyHeaderResponse('content-type', 'application/json')

	cBody := oRest:GetBodyRequest()
	jBody := JsonObject():New()
	
	If jBody:fromJson(cBody) == NIL .AND. jBody:HasProperty("items")
		::jResponse := ::oService:delLink(jBody)
		If ::jResponse:HasProperty("error")
			SetRestFault(400, FWHttpEncode(::jResponse["error"]))
		Else
			oRest:setResponse(::jResponse)
		EndIf
	Else
		SetRestFault(400, FWHttpEncode(STR0002)) // "Corpo da requisição inválido"
	EndIf
return .T.

//------------------------------------------------------------------------------
/*/{Protheus.doc} getParameterMvLjCatPr as Logical
	Busca o valor do parâmetro MV_LJCATPR
	@type       method
	@return     logical, Verdadeiro
	@author     cruz.rafael / Squad Retail
	@since      18/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getParameterMvLjCatPr() as Logical Class productCategoryLinkController
	Local jResponse as Json
	Local lValue    as Logical

	oRest:setKeyHeaderResponse('content-type', 'application/json')

	jResponse := JsonObject():new()
	lValue    := SuperGetMV("MV_LJCATPR", .F., .F.)

	jResponse['mvljcatpr'] := lValue

	oRest:setResponse(jResponse)

	FWFreeObj(jResponse)
return .T.
