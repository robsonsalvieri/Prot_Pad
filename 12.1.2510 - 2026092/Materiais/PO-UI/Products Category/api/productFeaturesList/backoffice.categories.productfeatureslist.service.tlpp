#include "tlpp-core.th"

namespace totvs.protheus.backoffice.categories.productfeatureslist

Static __oInstance   as Object
Static __oActiveData as Object

//------------------------------------------------------------------------------
/*/{Protheus.doc} ProductFeaturesListService
	Disponibiliza um serviço de características de produtos
	@type       Class
	@sample     ProductFeaturesListService
	@author     cruz.rafael / Squad Retail
	@since      15/01/2026
	@version    12
/*/
//------------------------------------------------------------------------------
Class ProductFeaturesListService
	Public Data jResponse as Json

	Public Method new() as Object
	Public Method getInstance() as Object
	Public Method getData() as Object
	Public Method getPrdFeatures() as Json
	Public Method getFeatureList() as Json
	Public Method postUpdatePrdFeatureValues() as Json

EndClass

//------------------------------------------------------------------------------
/*/{Protheus.doc} New
	Disponibiliza uma nova intancia do serviço características de Produtos.
	@type       method
	@sample     ProductFeaturesListService:new()
	@author     cruz.rafael / Squad Retail
	@since      15/01/2026
	@version    12
/*/
//------------------------------------------------------------------------------
Method new() as Object Class ProductFeaturesListService
	::jResponse := JsonObject():New()
Return Self

//------------------------------------------------------------------------------
/*/{Protheus.doc} GetInstance
	Retorna uma instancia do serviço
	@type       method
	@sample     ProductFeaturesListService:GetInstance()
	@author     cruz.rafael / Squad Retail
	@since      15/01/2026
	@version    12
/*/
//------------------------------------------------------------------------------
Method getInstance() as Object Class ProductFeaturesListService
	If (__oInstance == Nil)
		__oInstance := ProductFeaturesListService():New()
	EndIf
Return __oInstance

//------------------------------------------------------------------------------
/*/{Protheus.doc} getData
	Retorna o tipo de objeto utilizado para consulta.
	@type       method
	@return     __oActiveData
	@author     cruz.rafael / Squad Retail
	@since      15/01/2026
	@version    12
/*/
//------------------------------------------------------------------------------
Method getData(cVerb as Character) as Object class ProductFeaturesListService
	If __oActiveData == Nil
		__oActiveData := ProductFeaturesListProtheusData():new(cVerb)
	EndIf
Return __oActiveData

//------------------------------------------------------------------------------
/*/{Protheus.doc} getPrdFeatures
	Efetua a consulta de características de Produtos
	@type       method
	@sample     oService:getPrdFeatures(1, 10, {}, 'code, description', '-code', Nil)
	@param      nPage       , Numeric  , Número da página que será retornada
	@param      nPageSize   , Numeric  , Quantidade de registros por página
	@param      aURLFilter  , Array    , Lista de Filtros no padrão do FWAdapterBaseV2
	@param      cFields     , Character, Lista de campos que devem ser retornados
	@param      cSort       , Character, Ordernação do Response
	@param      cSearchText , Character, Texto de pesquisa
	@param      cProductId  , Character, Código do produto para filtro de características
	@author     cruz.rafael / Squad Retail
	@since      15/01/2026
	@version    12
/*/
//------------------------------------------------------------------------------
Method getPrdFeatures(nPage as Numeric, nPageSize as Numeric, aURLFilter as Array, cFields as Character,;
cSort as Character, cSearchText as Character, cProductId as Character) as Json Class ProductFeaturesListService
	Local oFeatures as Object

	Default nPage       := 1
	Default nPageSize   := 10
	Default aURLFilter  := {}
	Default cFields     := ""
	Default cSort       := ""
	Default cSearchText := ""
	Default cProductId  := ""

	oFeatures := ::getData("GET")
	oFeatures:Get(nPage, nPageSize, aURLFilter, cFields, cSort, cSearchText, cProductId)

	::jResponse := oFeatures:getJsonResponse()

	oFeatures:DeActivate()
	FreeObj(oFeatures)
Return ::jResponse

//------------------------------------------------------------------------------
/*/{Protheus.doc} getFeatureList
	Efetua a consulta de lista de opções de características de Produtos
	@type       method
	@sample     oService:getFeatureList(1, 10, {}, 'code, description', '-code', Nil)
	@param      nPage       , Numeric  , Número da página que será retornada
	@param      nPageSize   , Numeric  , Quantidade de registros por página
	@param      aURLFilter  , Array    , Lista de Filtros no padrão do FWAdapterBaseV2
	@param      cFields     , Character, Lista de campos que devem ser retornados
	@param      cSort       , Character, Ordernação do Response
	@param      cSearchText , Character, Texto de pesquisa
	@param      cFeatureId  , Character, Código da característica para filtro de lista de opções
	@author     cruz.rafael / Squad Retail
	@since      15/01/2026
	@version    12
/*/
//------------------------------------------------------------------------------
Method getFeatureList(nPage as Numeric, nPageSize as Numeric, aURLFilter as Array, cFields as Character,;
cSort as Character, cSearchText as Character, cFeatureId as Character) as Json Class ProductFeaturesListService
	Local oFeatures as Object

	Default nPage       := 1
	Default nPageSize   := 10
	Default aURLFilter  := {}
	Default cFields     := ""
	Default cSort       := ""
	Default cSearchText := ""
	Default cFeatureId  := ""

	oFeatures := ::getData("GET")
	oFeatures:GetList(nPage, nPageSize, aURLFilter, cFields, cSort, cSearchText, cFeatureId)

	::jResponse := oFeatures:getJsonResponse()

	oFeatures:DeActivate()
	FreeObj(oFeatures)
Return ::jResponse
//------------------------------------------------------------------------------
/*/{Protheus.doc} postUpdatePrdFeatureValues
	Atualiza valores das características de produtos
	@type       method
	@sample     oService:postUpdatePrdFeatureValues(jBody)
	@param      jBody, Json, JSON contendo productId/productCode e array com características
	@return     Json, resposta da operação
	@author     cruz.rafael / Squad Retail
	@since      16/03/2026
	@version    12
/*/
//------------------------------------------------------------------------------
Method postUpdatePrdFeatureValues(jBody as Json) as Json Class ProductFeaturesListService
	Local oFeatures as Object

	Default jBody := JsonObject():new()

	oFeatures := ::getData("POST")
	::jResponse := oFeatures:postUpdatePrdFeatureValues(jBody)

	oFeatures:DeActivate()
	FreeObj(oFeatures)
Return ::jResponse
