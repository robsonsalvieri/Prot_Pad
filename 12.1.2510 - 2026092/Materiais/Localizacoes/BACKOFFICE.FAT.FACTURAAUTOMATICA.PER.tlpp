#include "tlpp-core.th"
#include "tlpp-object.th"
#include "backoffice.fat.facturaautomatica.per.ch"

namespace backoffice.fat.facturaautomatica.per


/*/{Protheus.doc} FacturaVenta
Clase para la generación de facturas automaticas de venta de Peru.
@type class
@version 12.1.2510
@author luis.samaniego
@since 05/2026
/*/
Class FacturaVenta From FacturaSalida

    Public Method New() Constructor
    Public Method DatosPedidoAFactura()
    Public Method DatosItemPedidoAFactura()
    Public Method DatosRemitoAFactura()
    Public Method DatosItemRemitoAFactura()
    Public Method CposCntrolFolios()
    Public Method CposConfAdicImp()

End Class

/*/{Protheus.doc} FacturaVenta::New
Inicializa la clase FacturaVenta
@type method
@version 12.1.2510
@author luis.samaniego
@since 05/2026
@param cPais, character, País
@return object, Objeto de la clase FacturaVenta
/*/
Method New(cPais as Character) Class FacturaVenta

Default cPais := "PER"

    _Super:New(cPais)

Return Self

/*/{Protheus.doc} FacturaVenta::DatosPedidoAFactura
Asigna los valores del pedido de venta a la factura.
@type method
@version 12.1.2510
@author luis.samaniego
@since 05/2026
@param cPedido, character, Numero de pedido
@param cCliente, character, Código de cliente
@param cLoja, character, Tienda de cliente
@param cSerieNF, character, Serie de la factura
@return array, Datos del encabezado de la factura
/*/
Method DatosPedidoAFactura(cPedido as Character, cCliente as Character, cLoja as Character, cSerieNF as Character) Class FacturaVenta
Local aArea     as Array
Local aDatosNf  as Array
Local cF2_TPDOC as Character
Local jCpos     as Json

Default cPedido  := ""
Default cCliente := ""
Default cLoja    := ""
Default cSerieNF := ""

    cF2_TPDOC := "01"
    aDatosNf  := {}
    jCpos     := Self:jCamposEncabezado
    aDatosNf  := Self:PedidoAFactura(cPedido, cCliente, cLoja, cSerieNF)

    aArea := FwGetArea()
    SC5->(dbSetOrder(1))
    If SC5->(MsSeek(xFilial("SC5")+ cPedido))

        aDatosNf[jCpos['F2_TIPOREM']] := SC5->C5_TIPOREM
        If jCpos:HasProperty('F2_TPDOC')
            If !Empty(SC5->C5_TPDOC)
                 cF2_TPDOC := SC5->C5_TPDOC
            EndIf
            aDatosNf[jCpos['F2_TPDOC']] := cF2_TPDOC
        EndIf
        If jCpos:HasProperty('F2_NUMORC')
           aDatosNf[jCpos['F2_NUMORC']] := SC5->C5_NUMORC
        EndIf
        If jCpos:HasProperty('F2_TIPONF')
            aDatosNf[jCpos['F2_TIPONF']] := SC5->C5_TIPONF
        EndIf
        If jCpos:HasProperty('F2_CODDOC')
            aDatosNf[jCpos['F2_CODDOC']] := SC5->C5_CODVGLP
        EndIf
        If jCpos:HasProperty('F2_MODCONS')
            aDatosNf[jCpos['F2_MODCONS']] := SC5->C5_MODANP
        EndIf
        self:CposCntrolFolios(@aDatosNf, jCpos, cSerieNF)

    EndIf

    FwRestArea(aArea)
    fwFreeArray(aArea)
    FreeObj(jCpos)

Return aClone(aDatosNf)

/*/{Protheus.doc} FacturaVenta::DatosItemPedidoAFactura
Asigna los valores de los ítems del pedido de venta a la factura.
@type method
@version 12.1.2510
@author luis.samaniego
@since 05/2026
@param nItem, numeric, Numero de item de la factura
@param nRecnoItem, numeric, Recno del ítem del pedido
@param cSerieNF, character, Serie de la factura
@return array, Item de la factura
/*/
Method DatosItemPedidoAFactura(nItem as Numeric, nRecnoItem as Numeric, cSerieNF as Character) Class FacturaVenta
Local aArea as Array
Local aItem as Array
Local jCpos as Json

Default nItem      := 1
Default nRecnoItem := 0
Default cSerieNF   := ""

    aItem := {}
    jCpos := self:jCamposItem

    aArea := FwGetArea()
    SC9->(MsGoTo(nRecnoItem))
    If SC6->(MsSeek(xFilial("SC6")+ SC9->C9_PEDIDO+SC9->C9_ITEM+SC9->C9_PRODUTO))

        aItem := Self:ItemPedidoAFactura(nItem, nRecnoItem, cSerieNF)
        If jCpos:HasProperty('D2_TIPOREM')
            SC5->(dbSetOrder(1))
            If SC5->( MsSeek(xFilial("SC5")+ SC9->C9_PEDIDO) )
                aItem[jCpos['D2_TIPOREM']] := SC5->C5_TIPOREM
            EndIf
        Endif
        self:CposConfAdicImp(@aItem, jCpos, aItem[jCpos['D2_TES']], aItem[jCpos['D2_COD']])

    EndIf

    FwRestArea(aArea)
    fwFreeArray(aArea)
    FreeObj(jCpos)

Return aClone(aItem)


/*/{Protheus.doc} FacturaVenta::DatosRemitoAFactura
Asigna los valores del Remito de venta a la factura.
@type method
@version 12.1.2510
@author luis.samaniego
@since 05/2026
@param cRemito, character, Numero de Remito
@param cSerie, character, Numero de Remito
@param cCliente, character, Código de cliente
@param cLoja, character, Tienda de cliente
@param cSerieNF, character, Serie de la factura
@return array, Datos del encabezado de la factura
/*/
Method DatosRemitoAFactura(cRemito as Character, cSerie as Character, cCliente as Character, cLoja as Character, cSerieNF as Character) Class FacturaVenta
Local aArea     as Array
Local aDatosNf  as Array
Local cF2_TPDOC as Character
Local jCpos     as Json

Default cRemito  := ""
Default cSerie   := ""
Default cCliente := ""
Default cLoja    := ""
Default cSerieNF := ""

    cF2_TPDOC := "01"
    aDatosNf  := {}
    jCpos     := Self:jCamposEncabezado
    aDatosNf  := Self:RemitoAFactura(cRemito, cSerie, cCliente, cLoja, cSerieNF)

    aArea := FwGetArea()
    SF2->(dbSetOrder(1)) //F2_FILIAL+F2_DOC+F2_SERIE+F2_CLIENTE+F2_LOJA+F2_FORMUL+F2_TIPO
    If SF2->(MsSeek(xFilial("SF2")+ cRemito + cSerie + cCliente + cLoja))

        If jCpos:HasProperty('F2_TPDOC')
            If !Empty(SF2->F2_TPDOC)
                cF2_TPDOC := SF2->F2_TPDOC
            EndIf
            aDatosNf[jCpos['F2_TPDOC']] := cF2_TPDOC
        EndIf
        If jCpos:HasProperty('F2_NUMORC')
            aDatosNf[jCpos['F2_NUMORC']] := SF2->F2_NUMORC
        EndIf
        If jCpos:HasProperty('F2_TIPONF')
            aDatosNf[jCpos['F2_TIPONF']] := SF2->F2_TIPONF
        EndIf
        If jCpos:HasProperty('F2_CODDOC')
            aDatosNf[jCpos['F2_CODDOC']] := SF2->F2_CODDOC
        EndIf
        If jCpos:HasProperty('F2_MODCONS')
            aDatosNf[jCpos['F2_MODCONS']] := SF2->F2_MODCONS
        EndIf
        self:CposCntrolFolios(@aDatosNf, jCpos, cSerieNF)

    EndIf

    FwRestArea(aArea)
    fwFreeArray(aArea)
    FreeObj(jCpos)

Return aClone(aDatosNf)

/*/{Protheus.doc} FacturaVenta::DatosItemRemitoAFactura
Asigna los valores de los ítems del pedido de venta a la factura.
@type method
@version 12.1.2510
@author luis.samaniego
@since 05/2026
@param nItem, numeric, Numero de item de la factura
@param nRecnoItem, numeric, Recno del ítem del pedido
@param cSerieNF, character, Serie de la factura
@return array, Item de la factura
/*/
Method DatosItemRemitoAFactura(nItem as Numeric, nRecnoItem as Numeric, cSerieNF as Character) Class FacturaVenta
Local aItem as Array
Local jCpos as Json

Default nItem      := 1
Default nRecnoItem := 0
Default cSerieNF   := ""

    aItem := {}
    jCpos := self:jCamposItem
    aItem := Self:ItemRemitoAFactura(nItem, nRecnoItem, cSerieNF)

    If !Empty(aItem[jCpos['D2_PEDIDO']])
        self:CposConfAdicImp(@aItem, jCpos, aItem[jCpos['D2_TES']], aItem[jCpos['D2_COD']])
    EndIf

    FreeObj(jCpos)

Return aClone(aItem)


/*/{Protheus.doc} FacturaVenta::CposCntrolFolios
Asigna los valores de control de folios a la factura.
@type method
@version 12.1.2510
@author luis.samaniego
@since 05/2026
@param aDatosNf, array, Datos del encabezado de la factura
@param jCpos, json, Posiciones de los campos del encabezado de la factura
@param cSerieNF, character, Serie de la factura
/*/
Method CposCntrolFolios(aDatosNf as array, jCpos as json, cSerieNF as character) Class FacturaVenta
Local aArea as Array

Default aDatosNf := aClone(self:aCamposEncabezado[2])
Default jCpos    := self:jCamposEncabezado
Default cSerieNF := ""

    
    aArea := FwGetArea()
    DbSelectArea("SFP")
    SFP->(DbSetOrder(5)) //FP_FILIAL+FP_FILUSO+FP_SERIE+FP_ESPECIE+FP_PV
    If (SFP->(DbSeek(xFilial("SFP") + cFilAnt + cSerieNF+'1')))
        If jCpos:HasProperty('F2_SERIE2')
            aDatosNf[jCpos['F2_SERIE2']] := SFP->FP_SERIE2
        EndIf
    EndIf

    FwRestArea(aArea)
    fwFreeArray(aArea)

Return

/*/{Protheus.doc} FacturaVenta::CposConfAdicImp
Asigna los valores adicionales de impuestos a la factura.
@type method
@version 12.1.2510
@author luis.samaniego
@since 05/2026
@param aItem, array, Datos del encabezado de la factura
@param jCpos, json, Posiciones de los campos del encabezado de la factura
@param cTES, character, Código de TES
@param cProducto, character, Código de producto
/*/
Method CposConfAdicImp(aItem as array, jCpos as json, cTES as character, cProducto as character) Class FacturaVenta
Local aArea      as Array
Local nB1_VLRISC as Numeric
Local nFF_VLRISC as Numeric

Default aItem     := aClone(self:aCamposItem[2])
Default jCpos     := self:jCamposItem
Default cTES      := ""
Default cProducto := ""

    nFF_VLRISC := 0
    nB1_VLRISC := 0

    aArea := FwGetArea()
    DbSelectArea("SFC")
    SFC->(DbSetOrder(2)) //FC_FILIAL+FC_TES+FC_IMPOSTO
    If jCpos:HasProperty('D2_VLRISC') .And. SFC->(MsSeek(xFilial("SFC")+ cTES + "ISC"))

        DbSelectArea("SFF")
        SFF->(DbSetOrder(3)) //FF_FILIAL+FF_IMPOSTO+FF_SERIENF+FF_CFO
        If SFF->(MsSeek(xFilial("SFF")+SFC->FC_IMPOSTO))
            If SFF->FF_VLRISC > 0
                nFF_VLRISC := SFF->FF_VLRISC
            EndIf
        EndIf
        If nFF_VLRISC > 0
            aItem[jCpos['D2_VLRISC']] := nFF_VLRISC
        EndIf

        DbSelectArea("SB1")
        SB1->(DbSetOrder(1)) //B1_FILIAL+B1_COD
        If nFF_VLRISC <= 0 .And. SB1->(MsSeek(xFilial("SB1") + cProducto))
            If SB1->B1_VLRISC > 0
                nB1_VLRISC := SB1->B1_VLRISC
            EndIf
        EndIf
        If nB1_VLRISC > 0
            aItem[jCpos['D2_VLRISC']] := nB1_VLRISC
        EndIf

    EndIf

    FwRestArea(aArea)
    fwFreeArray(aArea)

Return
