#include 'tlpp-core.th'
#include 'tlpp-rest.th'

using namespace gfin.util

//-------------------------------------------------------------------
/*/
{Protheus.doc} getCountry
Retorna el país del ambiente
@author Luis Enríquez
@since 11/08/2026
/*/
//-------------------------------------------------------------------
@Get('/api/pc/v1/country')
function getCountry()
	local response As Json
	local cPais As Character

	cPais	 := cPaisLoc

	response := JsonObject():New()
	response["result"]   := .T.
	response["response"] := JsonObject():New()
	response["response"]["country"] := cPais
	AnswerRest(response)
	FreeObj(response)
	response := nil
return
