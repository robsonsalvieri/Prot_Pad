/*/
Function DataInt( dData )
Local cData:=Space(8) 

If !Empty(dData)
	cData := Dtos(dData) // AAAAMMDD
	cData := Right(cData,2)+SubStr(cData,5,2)+Left(cData,4) // DDMMAAAA
End

Return(cData)

