Function TotDebitos( nMes17Ini,nMes17Fim )

Local nTotDebitos:=0
Local cVar
Local i

For i:=nMes17Ini To nMes17Fim
	cVar := "SI1->I1_DEBM"+StrZero(i,2)
	nTotDebitos += &cVar
Next
Return(nTotDebitos)

