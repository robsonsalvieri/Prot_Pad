#include 'tlpp-core.th'
#include 'tlpp-rest.th'
#include 'BACKOFFICE.PGC.CUSTOM.BUTTONS.CONTROLLER.CH'

namespace pgc.customButtonsController
using namespace pgc.utils

//-------------------------------------------------------------------
/*/{Protheus.doc} pgcCustomButtonsController
	API de botoes customizados via Ponto de Entrada para o PGC.
	Permite que clientes configurem botoes extras nas telas de
	Necessidade de Compras e Cotacoes, executando acoes customizadas.
@type Class
@author ali.neto
@since 20/08/2026
/*/
//-------------------------------------------------------------------
Class pgcCustomButtonsController
    public Method New()

    @Get("/api/com/v1/pgcCustomButtons/buttons")
    public Method getButtons()

    @Post("/api/com/v1/pgcCustomButtons/execute")
    public Method postExecute()
EndClass

//-------------------------------------------------------------------
/*/{Protheus.doc} New
	Metodo construtor.
@type Method
@author ali.neto
@since 20/08/2026
@return Self, object, instancia da classe.
/*/
//-------------------------------------------------------------------
Method New() Class pgcCustomButtonsController
Return Self

//-------------------------------------------------------------------
/*/{Protheus.doc} getButtons
	Retorna a lista de botoes customizados configurados para uma
	localizacao e timing especificos.
	Executa o Ponto de Entrada PE_PGCBTN passando location e timing.
	Se o PE nao existir ou retornar vazio, retorna lista vazia.
@type Method
@author ali.neto
@since 20/08/2026
@return lRet, logical, .T. indica que a requisicao foi processada.
/*/
//-------------------------------------------------------------------
Method getButtons() Class pgcCustomButtonsController
    Local cLocation    As Character
    Local cTiming      As Character
    Local aButtons     As Array
    Local oJsonQuery   As Object
    Local oJsonResp    As Object
    Local oJsonBtn     As Object
    Local cJsonResp    As Character
    Local nX           As Integer

    cLocation := ""
    cTiming   := ""
    aButtons  := {}

    oJsonQuery := oRest:getQueryRequest()

    If ValType(oJsonQuery) == "J"
        If oJsonQuery:hasProperty("location")
            cLocation := AllTrim(oJsonQuery["location"])
        EndIf
        If oJsonQuery:hasProperty("timing")
            cTiming := AllTrim(oJsonQuery["timing"])
        EndIf
    EndIf

    //-- Valida parametros obrigatorios
    If Empty(cLocation) .Or. Empty(cTiming)
        oJsonResp := JsonObject():New()
        oJsonResp["buttons"] := {}
        cJsonResp := FwJsonSerialize(oJsonResp)
        oRest:setKeyHeaderResponse("Content-Type", "application/json")
        oRest:SetResponse(cJsonResp)
        FreeObj(oJsonResp)
        Return .T.
    EndIf

    //-- Executa Ponto de Entrada PE_PGCBTN se existir
    If ExistBlock("PE_PGCBTN")
        aButtons := ExecBlock("PE_PGCBTN", .F., .F., {cLocation, cTiming})
    EndIf

    //-- Monta resposta JSON
    oJsonResp := JsonObject():New()
    oJsonResp["buttons"] := {}

    If ValType(aButtons) == "A" .And. Len(aButtons) > 0
        For nX := 1 To Len(aButtons)
            If ValType(aButtons[nX]) == "J"
                oJsonBtn := aButtons[nX]

                //-- Garante campos obrigatorios
                If oJsonBtn:hasProperty("id") .And. oJsonBtn:hasProperty("label") .And. oJsonBtn:hasProperty("action")
                    aAdd(oJsonResp["buttons"], oJsonBtn)
                EndIf
            EndIf
        Next nX
    EndIf

    cJsonResp := FwJsonSerialize(oJsonResp)
    oRest:setKeyHeaderResponse("Content-Type", "application/json")
    oRest:SetResponse(cJsonResp)

    FreeObj(oJsonResp)
    FwFreeArray(aButtons)
Return .T.

//-------------------------------------------------------------------
/*/{Protheus.doc} postExecute
	Executa uma acao customizada associada a um botao.
	Recebe action, location, timing e context no body JSON e executa o
	Ponto de Entrada PE_PGCEXE passando esses parametros.
	Retorna a resposta do PE ao front-end, incluindo filters quando
	timing=before.
@type Method
@author ali.neto
@since 20/08/2026
@return lRet, logical, .T. indica que a requisicao foi processada.
/*/
//-------------------------------------------------------------------
Method postExecute() Class pgcCustomButtonsController
    Local cBody        As Character
    Local cAction      As Character
    Local cLocation    As Character
    Local cTiming      As Character
    Local oContext     As Object
    Local oJsonRequest As Object
    Local oJsonResp    As Object
    Local oReturn      As Object
    Local cJsonResp    As Character
    Local lBodyHeader  As Logical

    cAction   := ""
    cLocation := ""
    cTiming   := ""
    oContext  := Nil

    //-- Obtem body da requisicao
    lBodyHeader := oRest:getHeaderRequest():hasProperty('body')
    If lBodyHeader
        cBody := oRest:getHeaderRequest()['body']
    Else
        cBody := oRest:getBodyRequest()
    EndIf

    oJsonRequest := JsonObject():New()

    //-- Valida parse do body
    If oJsonRequest:fromJson(cBody) <> Nil
        oJsonResp := JsonObject():New()
        oJsonResp["success"] := .F.
        oJsonResp["message"] := STR0001 //Erro ao interpretar o corpo da requisição
        oJsonResp["data"]    := JsonObject():New()

        cJsonResp := FwJsonSerialize(oJsonResp)
        oRest:setKeyHeaderResponse("Content-Type", "application/json")
        oRest:setStatusResponse(400, cJsonResp)

        FreeObj(oJsonRequest)
        FreeObj(oJsonResp)
        Return .T.
    EndIf

    //-- Extrai campos do body
    If oJsonRequest:hasProperty("action")
        cAction := AllTrim(oJsonRequest["action"])
    EndIf

    If oJsonRequest:hasProperty("location")
        cLocation := AllTrim(oJsonRequest["location"])
    EndIf

    If oJsonRequest:hasProperty("timing")
        cTiming := AllTrim(oJsonRequest["timing"])
    EndIf

    If oJsonRequest:hasProperty("context")
        oContext := oJsonRequest["context"]
    Else
        oContext := JsonObject():New()
    EndIf

    //-- Valida campos obrigatorios
    If Empty(cAction) .Or. Empty(cLocation) .Or. Empty(cTiming)
        oJsonResp := JsonObject():New()
        oJsonResp["success"] := .F.
        oJsonResp["message"] := STR0002 //Campos 'action', 'location' e 'timing' são obrigatórios
        oJsonResp["data"]    := JsonObject():New()

        cJsonResp := FwJsonSerialize(oJsonResp)
        oRest:setKeyHeaderResponse("Content-Type", "application/json")
        oRest:setStatusResponse(400, cJsonResp)

        FreeObj(oJsonRequest)
        FreeObj(oJsonResp)
        Return .T.
    EndIf

    //-- Executa Ponto de Entrada PE_PGCEXE se existir
    If ExistBlock("PE_PGCEXE")
        oReturn := ExecBlock("PE_PGCEXE", .F., .F., {cAction, cLocation, cTiming, oContext})
    Else
        //-- Fallback: PE nao configurado
        oReturn := JsonObject():New()
        oReturn["success"] := .F.
        oReturn["message"] := STR0004 //Ponto de entrada não configurado.
        oReturn["data"]    := JsonObject():New()
    EndIf

    //-- Monta resposta final
    oJsonResp := JsonObject():New()

    If ValType(oReturn) == "J"
        If oReturn:hasProperty("success")
            oJsonResp["success"] := oReturn["success"]
        Else
            oJsonResp["success"] := .F.
        EndIf

        If oReturn:hasProperty("message")
            oJsonResp["message"] := oReturn["message"]
        Else
            oJsonResp["message"] := ""
        EndIf

        //-- Inclui filters na resposta quando retornado pelo PE (timing=before)
        If oReturn:hasProperty("filters")
            oJsonResp["filters"] := oReturn["filters"]
        EndIf

        If oReturn:hasProperty("data")
            oJsonResp["data"] := oReturn["data"]
        Else
            oJsonResp["data"] := JsonObject():New()
        EndIf
    Else
        oJsonResp["success"] := .F.
        oJsonResp["message"] := STR0003 //Retorno inválido do ponto de entrada
        oJsonResp["data"]    := JsonObject():New()
    EndIf

    cJsonResp := FwJsonSerialize(oJsonResp)
    oRest:setKeyHeaderResponse("Content-Type", "application/json")
    oRest:SetResponse(cJsonResp)

    FreeObj(oJsonRequest)
    FreeObj(oJsonResp)
Return .T.
