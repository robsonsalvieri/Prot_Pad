#include "totvs.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "fwmvcdef.ch"
#include "retail.autoparts.catalog.productvehiclemodel.controller.ch"

namespace totvs.protheus.retail.autoparts.catalog.productvehiclemodel.controller

/*/{Protheus.doc} RetailAutopartsCatalogProductVehicleModelController
    API agregadora para a aba Modelo de Veiculo do Catalogo Geral de Produtos de Autopecas.
    Atua como fachada REST sobre os modelos MVC LOJA6060 (MF0) e LOJA6000 (MEC).
    @type    class
    @author  eduardo.FLima
    @since   07/07/2026
/*/
Class RetailAutopartsCatalogProductVehicleModelController

    public Method New() as Object

    private Method FindAvailableVehicleModels(cModelo as Character, cCodVei as Character, cCodTra as Character, cCodMot as Character, cFabIni as Character, cFabFim as Character) as Array
    private Method FindProductVehicleModels(cCodPro as Character, cUidmod as Character) as Array

    @Get("/api/retail/v1/retailAutopartsCatalogProductVehicleModel/getAvailableVehicleModels", description="Consulta os modelos de veiculo disponiveis para vinculo ao produto, com filtros opcionais por modelo, veiculo, transmissao, motorizacao e intervalos de fabricacao")
    public Method getAvailableVehicleModels() as Logical

    @Get("/api/retail/v1/retailAutopartsCatalogProductVehicleModel/getProductVehicleModels", description="Consulta os modelos de veiculo ja vinculados a um produto especifico do catalogo de autopecas")
    public Method getProductVehicleModels() as Logical

    @Post("/api/retail/v1/retailAutopartsCatalogProductVehicleModel/postProductVehicleModels", description="Vincula um ou mais modelos de veiculo a um produto do catalogo de autopecas de forma atomica via BEGIN TRANSACTION")
    public Method postProductVehicleModels() as Logical

    @Put("/api/retail/v1/retailAutopartsCatalogProductVehicleModel/putProductVehicleModel/:uidmod/:codpro", description="Vincula um Conjunto Sistema (MF0_CNJSIS) a uma aplicacao produto x modelo de veiculo existente. Recusa se o par uidmod+codpro+codcon ja existir.")
    public Method putProductVehicleModel() as Logical

    @Delete("/api/retail/v1/retailAutopartsCatalogProductVehicleModel/deleteProductVehicleModel/:uidmod/:codpro", description="Exclui um ou todos os vinculos produto x modelo de veiculo. Query params opcionais: filpro (filial do produto, padrao xFilial(SB1)) e codcon (conjunto de sistema - se omitido exclui todos em lote de forma atomica)")
    public Method deleteProductVehicleModel() as Logical

EndClass

/*/{Protheus.doc} New
    Metodo construtor
    @type   method
    @author eduardo.FLima
    @since  07/07/2026
    @return Object, Objeto instanciado da classe RetailAutopartsCatalogProductVehicleModelController
/*/
Method New() as Object Class RetailAutopartsCatalogProductVehicleModelController
Return Self

/*/{Protheus.doc} getAvailableVehicleModels
    Consulta os modelos de veiculo disponiveis (tabela MEC) para selecao na interface
    de vinculo de produto. Retorna dados enriquecidos com nome do veiculo via JOIN com ME6.
    @type    method
    @author  eduardo.FLima
    @since   07/07/2026
    @version p12
    @return  logical, .T. indicando se a execucao foi bem sucedida
/*/
Method getAvailableVehicleModels() as Logical Class RetailAutopartsCatalogProductVehicleModelController
    Local oJsonRespo    := JsonObject():New() as Object
    Local oJParametr    := oRest:getQueryRequest() as Object
    Local aItens        := {} as Array
    Local cModelo       := "" as Character
    Local cCodVei       := "" as Character
    Local cCodTra       := "" as Character
    Local cCodMot       := "" as Character
    Local cFabIni       := "" as Character
    Local cFabFim       := "" as Character

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    If oJParametr:hasProperty('modelo')
        cModelo := oJParametr['modelo']
    EndIf
    If oJParametr:hasProperty('codvei')
        cCodVei := oJParametr['codvei']
    EndIf
    If oJParametr:hasProperty('codtra')
        cCodTra := oJParametr['codtra']
    EndIf
    If oJParametr:hasProperty('codmot')
        cCodMot := oJParametr['codmot']
    EndIf
    If oJParametr:hasProperty('fabini')
        cFabIni := oJParametr['fabini']
    EndIf
    If oJParametr:hasProperty('fabfim')
        cFabFim := oJParametr['fabfim']
    EndIf

    aItens := Self:FindAvailableVehicleModels(cModelo, cCodVei, cCodTra, cCodMot, cFabIni, cFabFim)

    If Len(aItens) > 0
        oJsonRespo["items"] := aItens
        oRest:setStatusCode(200)  // HTTP 200 = Sucesso
    Else
        oJsonRespo["items"]   := {}
        oJsonRespo["message"] := STR0001 //"Dados não encontrados para o filtro informado"
        oRest:setStatusCode(404)  // HTTP 404 = Not Found
    EndIf

    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

Return .T.

/*/{Protheus.doc} getProductVehicleModels
    Consulta os modelos de veiculo ja vinculados a um produto especifico (tabela MF0),
    com dados enriquecidos de MEC e ME6 via JOIN.
    @type    method
    @author  eduardo.FLima
    @since   07/07/2026
    @version p12
    @return  logical, .T. indicando se a execucao foi bem sucedida
/*/
Method getProductVehicleModels() as Logical Class RetailAutopartsCatalogProductVehicleModelController
    Local oJsonRespo    := JsonObject():New() as Object
    Local oJParametr    := oRest:getQueryRequest() as Object
    Local aItens        := {} as Array
    Local cCodPro       := "" as Character
    Local cUidmod       := "" as Character
    Local lDadosOK      := .T. as Logical
    Local nX            := 0   as Numeric
    Local aHelp         := {}  as Array
    Local aArea := GetArea() as Array
    

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    If oJParametr:hasProperty('codpro')
        cCodPro := RTrim(oJParametr['codpro'])//Produto pode ter espacos a esquerda
    EndIf

    If oJParametr:hasProperty('uidmod')
        cUidmod := AllTrim(oJParametr['uidmod']) //uuid não pode ter espaços
    EndIf

    // ==========================================
    // Validacao: codpro Obrigatorio
    // ==========================================
    If Empty(cCodPro)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['message'] := STR0002 //"O parâmetro 'codpro' é obrigatório"
        lDadosOK := .F.
    EndIf

    // ==========================================
    // Validacao: Se existe uuid informado na tabela MEC
    // ==========================================
    If lDadosOK .and. !Empty(cUidmod) .and. !Lj6000VMec(cUidmod)
        oRest:setStatusCode(404)  // HTTP 404 = Not Found
        //Recupera help gerado pela rotina Lj6000VMec() para o uuid informado
        aHelp := FwGetUltHlp()
        oJsonRespo['message'] := aHelp[1]
        If ValType(aHelp[2]) == "A" 
            for nX := 1 to len(aHelp[2])
                oJsonRespo['message'] += + Chr(10)+ aHelp[2][nX]
            next nX
        EndIf
        If len(aHelp) > 2 .and. ValType(aHelp[3]) == "A" 
            for nX := 1 to len(aHelp[3])
                oJsonRespo['message'] += + Chr(10)+ aHelp[3][nX]
            next nX
        Endif         
        lDadosOK := .F.
    Endif 

    If lDadosOK
        SB1->(dbSetOrder(1))
        IF SB1->(dbSeek(xFilial("SB1") + cCodPro))
            oJsonRespo["codpro"] := RTRIM(SB1->B1_COD)
            oJsonRespo["despro"]   := RTRIM(SB1->B1_DESC)
            aItens := Self:FindProductVehicleModels(cCodPro, cUidmod)

            If Len(aItens) > 0
                oJsonRespo["items"] := aItens
                oRest:setStatusCode(200)  // HTTP 200 = Sucesso
            Else
                oJsonRespo["items"]   := {}
                oJsonRespo["message"] := STR0015 //"Aplicação não encontrada para o produto informado"
                oRest:setStatusCode(404)  // HTTP 404 = Not Found
            EndIf
        Else
            oRest:setStatusCode(404)  // HTTP 404 = Not Found
            oJsonRespo['message'] := STR0012 //"Produto não encontrado para o código informado"
        Endif 
    EndIf


    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)
    RestArea(aArea)
Return .T.

/*/{Protheus.doc} postProductVehicleModels
    Vincula um ou mais modelos de veiculo a um produto de forma atomica.
    Todas as gravacoes sao protegidas por BEGIN TRANSACTION: em caso de falha
    em qualquer UUID do lote, DisarmTransaction() reverte todas as operacoes
    anteriores e retorna o erro correspondente (409 Duplicidade / 400 Outros).
    @type    method
    @author  eduardo.FLima
    @since   07/07/2026
    @version p12
    @return  logical, .T. indicando se a execucao foi bem sucedida
/*/
Method postProductVehicleModels() as Logical Class RetailAutopartsCatalogProductVehicleModelController
    Local oJsBody       := JsonObject():New() as Object
    Local oJsonRespo    := JsonObject():New() as Object
    Local oModel        := Nil as Object
    Local oModelMF0     := Nil as Object
    Local oExecChk      := Nil as Object
    Local aModelos      := {} as Array
    Local aGravados     := {} as Array
    Local aErros        := {} as Array
    Local cCodPro       := "" as Character
    Local cCodCon       := "" as Character
    Local cUuid         := "" as Character
    Local cUuidErro     := "" as Character
    Local cMsgErro      := "" as Character
    Local cQryMecChk    := "" as Character
    Local cQryDupChk    := "" as Character
    Local lDadosOK      := .T. as Logical
    Local lGravouOK     := .F. as Logical
    Local lErro         := .F. as Logical
    Local nStatus       := 400 as Numeric
    Local nX            := 0 as Numeric
    Local nRecno        := 0 as Numeric
    Local nDupCnt       := 0 as Numeric

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    oJsBody:fromJson(oRest:GetBodyRequest())

    // ==========================================
    // Validacao: codpro Obrigatorio
    // ==========================================
    If oJsBody['codpro'] != Nil
        cCodPro := RTRIM(oJsBody['codpro'])
    EndIf

    If Empty(cCodPro)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['message'] := STR0002 //"O parâmetro 'codpro' é obrigatório"
        lDadosOK := .F.
    EndIf

    If lDadosOK
        SB1->(dbSetOrder(1))
        If !SB1->(dbSeek(xFilial("SB1") + RTRIM(cCodPro)))
            oRest:setStatusCode(404)
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0012  // "Produto não encontrado para o código informado"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        // Parametro opcional codcon (MF0_CNJSIS)
        If oJsBody['codcon'] != Nil
            cCodCon := AllTrim(oJsBody['codcon'])
        EndIf

        // ==========================================
        // Validacao: array 'modelos' nao vazio
        // ==========================================
        If ValType(oJsBody['modelos']) != "A" .or. Len(oJsBody['modelos']) == 0
            oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
            oJsonRespo['message'] := STR0003 //"O campo 'modelos' deve ser um array não vazio de UUIDs"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        aModelos := oJsBody['modelos']

        // ==========================================
        // Prepara queries reutilizadas no loop
        // ==========================================

        // Query: verifica existencia do UUID em MEC
        cQryMecChk := " SELECT MEC.R_E_C_N_O_ AS RECNO "
        cQryMecChk += " FROM " + RetSqlName("MEC") + " MEC "
        cQryMecChk += " WHERE MEC.MEC_FILIAL = ? "
        cQryMecChk += " AND MEC.MEC_MSUID = ? "
        cQryMecChk += " AND MEC.D_E_L_E_T_ = ? "
        cQryMecChk := ChangeQuery(cQryMecChk)

        // Query: verifica duplicidade em MF0 (uidmod + codpro + filpro)
        cQryDupChk := " SELECT COUNT(1) AS TOTAL "
        cQryDupChk += " FROM " + RetSqlName("MF0") + " MF0 "
        cQryDupChk += " WHERE MF0.MF0_FILIAL = ? "
        cQryDupChk += " AND MF0.MF0_UIDMOD = ? "
        cQryDupChk += " AND MF0.MF0_FILPRO = ? "
        cQryDupChk += " AND MF0.MF0_CODPRO = ? "
        cQryDupChk += " AND MF0.MF0_CNJSIS = ? "
        cQryDupChk += " AND MF0.D_E_L_E_T_ = ? "
        cQryDupChk := ChangeQuery(cQryDupChk)

        // ==========================================
        // Bloco atomico: grava todos ou nenhum
        // ==========================================
        BEGIN TRANSACTION

            For nX := 1 To Len(aModelos)
                cUuid := AllTrim(aModelos[nX])

                // ------------------------------------------
                // 1. Valida formato UUID
                // ------------------------------------------
                If !Lj6000VUid(cUuid)
                    lErro     := .T.
                    nStatus   := 422  // HTTP 422 = Unprocessable Entity
                    cMsgErro  := STR0004 + cUuid //"UUID inválido no array 'modelos': "
                    cUuidErro := cUuid
                    DisarmTransaction()
                    Break
                EndIf

                // ------------------------------------------
                // 2. Valida existencia do UUID em MEC
                // ------------------------------------------
                nRecno := 0

                oExecChk := FwExecStatement():New(cQryMecChk)
                oExecChk:SetString(1, xFilial("MEC"))
                oExecChk:SetString(2, PadR(cUuid, TamSx3("MEC_MSUID")[1]))
                oExecChk:SetString(3, Space(1))
                nRecno := Val(cValToChar(oExecChk:ExecScalar("RECNO")))

                oExecChk:Destroy()
                oExecChk := Nil

                If nRecno <= 0
                    lErro     := .T.
                    nStatus   := 400  // HTTP 400 = Bad Request
                    cMsgErro  := STR0005 + cUuid //"Modelo de veículo não encontrado na tabela MEC para o UUID: "
                    cUuidErro := cUuid
                    DisarmTransaction()
                    Break
                EndIf

                // ------------------------------------------
                // 3. Verifica duplicidade em MF0
                // ------------------------------------------
                nDupCnt := 0

                oExecChk := FwExecStatement():New(cQryDupChk)
                oExecChk:SetString(1, xFilial("MF0"))
                oExecChk:SetString(2, PadR(cUuid,   TamSx3("MF0_UIDMOD")[1]))
                oExecChk:SetString(3, xFilial("SB1"))
                oExecChk:SetString(4, PadR(cCodPro, TamSx3("MF0_CODPRO")[1]))
                If !Empty(cCodCon)
                    oExecChk:SetString(5, PadR(cCodCon, TamSx3("MF0_CNJSIS")[1]))
                Else
                    oExecChk:SetString(5, Space(1))
                EndIf
                oExecChk:SetString(6, Space(1))
                nDupCnt := Val(cValToChar(oExecChk:ExecScalar("TOTAL")))

                oExecChk:Destroy()
                oExecChk := Nil

                If nDupCnt > 0
                    lErro     := .T.
                    nStatus   := 409  // HTTP 409 = Conflict
                    cMsgErro  := STR0006 + cUuid //"Vínculo já existente para o modelo de veículo: "
                    cUuidErro := cUuid
                    DisarmTransaction()
                    Break
                EndIf

                // ------------------------------------------
                // 4. Carrega LOJA6060 e persiste o vinculo
                // ------------------------------------------
                oModel    := FWLoadModel("LOJA6060")
                oModel:SetOperation(MODEL_OPERATION_INSERT)
                oModel:Activate()

                oModelMF0 := oModel:GetModel("MF0MASTER")
                oModelMF0:SetValue("MF0_UIDMOD", cUuid)
                oModelMF0:SetValue("MF0_FILPRO", xFilial("SB1"))
                oModelMF0:SetValue("MF0_CODPRO", cCodPro)
                oModelMF0:SetValue("MF0_CNJSIS", cCodCon)

                If oModel:VldData()
                    lGravouOK := oModel:CommitData()
                Else
                    lGravouOK := .F.
                EndIf

                If !lGravouOK
                    lErro     := .T.
                    nStatus   := 400  // HTTP 400 = Bad Request
                    aErros    := oModel:GetErrorMessage()
                    cUuidErro := cUuid
                    cMsgErro  := IIf(!Empty(aErros[6]), aErros[6], STR0007) //"Erro ao cadastrar vínculo de modelo de veículo"

                    // Libera recursos antes do DisarmTransaction
                    oModelMF0:DeActivate()
                    oModel:DeActivate()
                    FreeObj(oModelMF0)
                    FreeObj(oModel)
                    oModelMF0 := Nil
                    oModel    := Nil

                    DisarmTransaction()
                    Break
                EndIf

                // Iteracao bem sucedida: acumula UUID gravado e libera recursos
                aAdd(aGravados, cUuid)

                oModelMF0:DeActivate()
                oModel:DeActivate()
                FreeObj(oModelMF0)
                FreeObj(oModel)
                oModelMF0 := Nil
                oModel    := Nil

            Next nX

        END TRANSACTION
        // ==========================================
        // Fim do bloco atomico
        // ==========================================

        If lErro
            oRest:setStatusCode(nStatus)
            oJsonRespo['success']    := .F.
            oJsonRespo['message']    := cMsgErro
            oJsonRespo['failedUuid'] := cUuidErro
            If nStatus == 400 .and. Len(aErros) > 0
                oJsonRespo['field']    := IIf(!Empty(aErros[4]), aErros[4], "")
                oJsonRespo['errorId']  := IIf(!Empty(aErros[5]), aErros[5], "")
                oJsonRespo['solution'] := IIf(!Empty(aErros[7]), aErros[7], "")
            EndIf
        Else
            oRest:setStatusCode(201)  // HTTP 201 = Created
            oJsonRespo['success'] := .T.
            oJsonRespo['message'] := STR0008 //"Vínculo(s) de modelo de veículo cadastrado(s) com sucesso"
            oJsonRespo['codpro']  := cCodPro
            oJsonRespo['modelos'] := aGravados
            oJsonRespo['total']   := Len(aGravados)
        EndIf
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsBody)
    FreeObj(oJsonRespo)

Return .T.

/*/{Protheus.doc} deleteProductVehicleModel
    Exclui um ou todos os vinculos produto x modelo de veiculo de forma atomica via LOJA6060.
    Se 'codcon' for informado (query param), exclui apenas o vinculo do conjunto especificado.
    Se 'codcon' nao for informado, exclui todos os vinculos do produto/modelo para a filial em lote.
    Toda a operacao e protegida por BEGIN TRANSACTION: falha em qualquer item reverte tudo.
    @type    method
    @author  eduardo.FLima
    @since   07/07/2026
    @version p12
    @return  logical, .T. indicando se a execucao foi bem sucedida
/*/
Method deleteProductVehicleModel() as Logical Class RetailAutopartsCatalogProductVehicleModelController
    Local oJsonRespo    := JsonObject():New() as Object
    Local oJPathParam   := oRest:getPathParamsRequest() as Object
    Local oJQueryParam  := oRest:getQueryRequest() as Object
    Local oQueryQry     := Nil as Object
    Local oModel        := Nil as Object
    Local aRegistros    := {} as Array
    Local aDeleted      := {} as Array
    Local aErros        := {} as Array
    Local cUidMod       := "" as Character
    Local cCodPro       := "" as Character
    Local cFilPro       := "" as Character
    Local cCodCon       := "" as Character
    Local cCnjSis       := "" as Character
    Local cQry          := "" as Character
    Local cAliasQry     := "" as Character
    Local cMsgErro      := "" as Character
    Local aArea         := GetArea() as Array
    Local lDadosOK      := .T. as Logical
    Local lCodConInf    := .F. as Logical
    Local lErro         := .F. as Logical
    Local lGravouOK     := .F. as Logical
    Local nStatus       := 400 as Numeric
    Local nX            := 0 as Numeric
    Local nSeq          := 1 as Numeric
    Local nRecno        := 0 as Numeric
    Local oErrBlock     := Nil as Object

    dbSelectArea("MF0")

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Path params (obrigatorios)
    If oJPathParam:hasProperty('uidmod')
        cUidMod := AllTrim(oJPathParam['uidmod'])
    EndIf
    If oJPathParam:hasProperty('codpro')
        cCodPro := RTRIM(oJPathParam['codpro'])
    EndIf

    // Query params (opcionais)
    If oJQueryParam:hasProperty('filpro')
        cFilPro := AllTrim(oJQueryParam['filpro'])
    EndIf
    If oJQueryParam:hasProperty('codcon')
        cCodCon    := AllTrim(oJQueryParam['codcon'])
        if !Empty(cCodCon)
            lCodConInf := .T.  // Sinaliza que codcon informado
        Endif
    EndIf

    // Default de filial do produto
    cFilPro := IIf(Empty(cFilPro), xFilial("SB1"), cFilPro)

    // ==========================================
    // Validacao: path params obrigatorios
    // ==========================================
    If Empty(cUidMod) .or. Empty(cCodPro)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['message'] := STR0009 //"Os parâmetros 'uidmod' e 'codpro' são obrigatórios"
        lDadosOK := .F.
    EndIf

    If lDadosOK
        SB1->(dbSetOrder(1))
        If !SB1->(dbSeek(xFilial("SB1") + cCodPro))
            oRest:setStatusCode(404)
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0012 //"Produto não encontrado para o código informado"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        If Lj6000VUid(cUidMod) // Caso não seja um uuid valido ja retorna não encontrado
            // ==========================================
            // Query inicial: localiza todos os registros
            // candidatos e armazena RECNOs em memoria
            // ==========================================
            cQry := " SELECT MF0.R_E_C_N_O_ AS RECNO, MF0.MF0_CNJSIS "
            cQry += " FROM " + RetSqlName("MF0") + " MF0 "
            cQry += " WHERE "
            cQry += " MF0.MF0_FILIAL = ? "
            cQry += " AND MF0.MF0_UIDMOD = ? "
            cQry += " AND MF0.MF0_CODPRO = ? "
            cQry += " AND MF0.MF0_FILPRO = ? "

            If lCodConInf
                cQry += " AND MF0.MF0_CNJSIS = ? "
            EndIf

            cQry += " AND MF0.D_E_L_E_T_ = ? "
            cQry += " ORDER BY MF0.MF0_CNJSIS "
            cQry := ChangeQuery(cQry)

            oQueryQry := FwExecStatement():New(cQry)

            oQueryQry:SetString(nSeq++, xFilial("MF0"))
            oQueryQry:SetString(nSeq++, PadR(cUidMod, TamSx3("MF0_UIDMOD")[1]))
            oQueryQry:SetString(nSeq++, PadR(cCodPro, TamSx3("MF0_CODPRO")[1]))
            oQueryQry:SetString(nSeq++, PadR(cFilPro, TamSx3("MF0_FILPRO")[1]))

            If lCodConInf
                oQueryQry:SetString(nSeq++, PadR(cCodCon, TamSx3("MF0_CNJSIS")[1]))
            EndIf

            oQueryQry:SetString(nSeq++, Space(1))  // MF0.D_E_L_E_T_

            cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

            While (cAliasQry)->(!EOF())
                aAdd(aRegistros, {(cAliasQry)->RECNO, AllTrim((cAliasQry)->MF0_CNJSIS)})
                (cAliasQry)->(dbSkip())
            EndDo

            (cAliasQry)->(dbCloseArea())
            oQueryQry:Destroy()
            oQueryQry := Nil

        Endif

        // ------------------------------------------
        // Nenhum registro encontrado: HTTP 404
        // ------------------------------------------
        If Len(aRegistros) == 0
            oRest:setStatusCode(404)  // HTTP 404 = Not Found
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0010 + AllTrim(cUidMod) + " / " + RTRIM(cCodPro) + STR0011 //Registro #  não encontrado para exclusão
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        // ==========================================
        // Bloco atomico: exclui todos ou nenhum
        // ==========================================
        BEGIN TRANSACTION

            For nX := 1 To Len(aRegistros)
                nRecno  := aRegistros[nX][1]
                cCnjSis := aRegistros[nX][2]

                // Posiciona MF0 pelo RECNO capturado na query inicial
                dbSelectArea("MF0")
                MF0->(dbGoTo(nRecno))

                // ------------------------------------------
                // Carrega LOJA6060 e executa DELETE
                // ------------------------------------------
                oModel := FWLoadModel("LOJA6060")
                oModel:SetOperation(MODEL_OPERATION_DELETE)
                oModel:Activate()

                
                lGravouOK := .F.
                cMsgErro := ""
                oErrBlock := ErrorBlock({|oErr| (lGravouOK := .F., cMsgErro := oErr:description, Break(oErr))})
                If oModel:VldData()
                    Begin Sequence
                        lGravouOK := oModel:CommitData()
                    End Sequence
                EndIf
                ErrorBlock(oErrBlock) 


                If !lGravouOK .or. !Empty(cMsgErro)
                    lErro    := .T.
                    nStatus  := 400  // HTTP 400 = Bad Request
                    aErros   := oModel:GetErrorMessage()
                    cMsgErro := IIf(!Empty(aErros[6]), aErros[6], cMsgErro + " | "+ cUidMod + " / " + cCodPro + IIf(!Empty(cCnjSis), " / " + cCnjSis,"") +" "+ STR0014) //"Erro ao excluir vínculo de modelo de veículo: "

                    // Libera recursos antes do DisarmTransaction
                    oModel:DeActivate()
                    FreeObj(oModel)
                    oModel := Nil

                    DisarmTransaction()
                    Break
                EndIf

                // Iteracao bem sucedida: acumula cnjsis excluido
                if !Empty(cCnjSis)
                    aAdd(aDeleted, cCnjSis)
                Endif

                oModel:DeActivate()
                FreeObj(oModel)
                oModel := Nil

            Next nX

        END TRANSACTION
        // ==========================================
        // Fim do bloco atomico
        // ==========================================

        If lErro
            oRest:setStatusCode(nStatus)
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := cMsgErro
            If nStatus == 400 .and. Len(aErros) > 0
                oJsonRespo['field']    := IIf(!Empty(aErros[4]), aErros[4], "")
                oJsonRespo['errorId']  := IIf(!Empty(aErros[5]), aErros[5], "")
                oJsonRespo['solution'] := IIf(!Empty(aErros[7]), aErros[7], "")
            EndIf
        Else
            oRest:setStatusCode(200)  // HTTP 200 = OK
            oJsonRespo['success']            := .T.
            oJsonRespo['message']            := STR0013 //"Vínculos de modelo de veículo removidos com sucesso"
            if Len(aDeleted) > 0
                oJsonRespo['deletedSystemsSets'] := aDeleted
            Endif 
        EndIf
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJPathParam)
    FreeObj(oJQueryParam)

    RestArea(aArea)

Return .T.

/*/{Protheus.doc} putProductVehicleModel
    Vincula um Conjunto Sistema (MF0_CNJSIS) a uma aplicacao produto x modelo de veiculo
    existente via MODEL_OPERATION_INSERT no LOJA6060. Retorna 409 se o vinculo
    uidmod+codpro+codcon ja existir em MF0.
    @type    method
    @author  eduardo.FLima
    @since   21/07/2026
    @version p12
    @return  logical, .T. indicando se a execucao foi bem sucedida
/*/
Method putProductVehicleModel() as Logical Class RetailAutopartsCatalogProductVehicleModelController
    Local oJsonRespo    := JsonObject():New() as Object
    Local oJPathParam   := oRest:getPathParamsRequest() as Object
    Local oJsBody       := JsonObject():New() as Object
    Local oModel        := Nil as Object
    Local oModelMF0     := Nil as Object
    Local aErros        := {} as Array
    Local cUidMod       := "" as Character
    Local cCodPro       := "" as Character
    Local cFilPro       := "" as Character
    Local cCodCon       := "" as Character
    Local cDescConj     := "" as Character
    Local aArea         := GetArea() as Array
    Local lDadosOK      := .T. as Logical
    Local lGravouOK     := .F. as Logical

    dbSelectArea("MF0")

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // ==========================================
    // Leitura dos Path Params (obrigatorios)
    // ==========================================
    If oJPathParam:hasProperty('uidmod')
        cUidMod := AllTrim(oJPathParam['uidmod'])
    EndIf
    If oJPathParam:hasProperty('codpro')
        cCodPro := RTRIM(oJPathParam['codpro'])
    EndIf

    // ==========================================
    // Leitura do Body
    // ==========================================
    oJsBody:fromJson(oRest:GetBodyRequest())

    If oJsBody['codcon'] != Nil
        cCodCon := AllTrim(oJsBody['codcon'])
    EndIf

    // Default de filial do produto
    If oJsBody['filpro'] != Nil
        cFilPro := AllTrim(oJsBody['filpro'])
    Else
        cFilPro := xFilial("SB1")
    Endif

    // ==========================================
    // Validacao: path params obrigatorios
    // ==========================================
    If Empty(cUidMod) .or. Empty(cCodPro)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['message'] := STR0009 //"Os parâmetros 'uidmod' e 'codpro' são obrigatórios"
        lDadosOK := .F.
    EndIf

    // ==========================================
    // Validacao: codcon obrigatorio no body
    // ==========================================
    If lDadosOK .and. Empty(cCodCon)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['message'] := STR0016 //"O parâmetro 'codcon' é obrigatório"
        lDadosOK := .F.
    EndIf

    // ==========================================
    // Validacao: UUID valido
    // ==========================================
    If lDadosOK .and. !Lj6000VUid(cUidMod)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['message'] := STR0021 + cUidMod //"UUID inválido para o parâmetro "
        lDadosOK := .F.
    EndIf

    If lDadosOK
        SB1->(dbSetOrder(1))
        If !SB1->(dbSeek(xFilial("SB1") + cCodPro))
            oRest:setStatusCode(404)
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0012 //"Produto não encontrado para o código informado"
            lDadosOK := .F.
        EndIf
    EndIf


    // ==========================================
    // Localiza registro MF0 e verifica se existe
    // Aplicação para o modelo e produto informados
    // ==========================================
    If lDadosOK
        MF0->(dbSetOrder(1))//MF0_FILIAL+MF0_UIDMOD+MF0_FILPRO+MF0_CODPRO+MF0_CNJSIS
        If !MF0->(dbSeek(xFilial("MF0") + PadR(cUidMod, TamSx3("MF0_UIDMOD")[1]) + padr(cFilPro,TamSx3("MF0_FILPRO")[1]) + PadR(cCodPro, TamSx3("MF0_CODPRO")[1])))
            oRest:setStatusCode(404)  // HTTP 404 = Not Found
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0017 //"Aplicação de produto não encontrada"
            lDadosOK := .F.
        EndIf
    EndIf

    // ==========================================
    // Localiza registro MF0 e verifica se ja
    // possui conjunto de sistema associado
    // ==========================================
    If lDadosOK
        MF0->(dbSetOrder(1))//MF0_FILIAL+MF0_UIDMOD+MF0_FILPRO+MF0_CODPRO+MF0_CNJSIS
        If MF0->(dbSeek(xFilial("MF0") + PadR(cUidMod, TamSx3("MF0_UIDMOD")[1]) + padr(cFilPro,TamSx3("MF0_FILPRO")[1]) + PadR(cCodPro, TamSx3("MF0_CODPRO")[1]) + PadR(cCodCon, TamSx3("MF0_CNJSIS")[1])))
            oRest:setStatusCode(409)  // HTTP 409 = Conflict
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0018 //"Aplicação já possui esse Conjunto Sistema associado: "
            lDadosOK := .F.
        EndIf
    EndIf

    // ==========================================
    // Insere o vinculo do Conjunto Sistema 
    // via LOJA6060
    // ==========================================
    If lDadosOK
        // Carrega LOJA6060 em modo de inclusão
        oModel := FWLoadModel("LOJA6060")
        oModel:SetOperation(MODEL_OPERATION_INSERT)
        oModel:Activate()

        oModelMF0 := oModel:GetModel("MF0MASTER")
        oModelMF0:SetValue("MF0_UIDMOD", cUidMod)
        oModelMF0:SetValue("MF0_FILPRO", cFilPro)
        oModelMF0:SetValue("MF0_CODPRO", cCodPro)
        oModelMF0:SetValue("MF0_CNJSIS", cCodCon)

        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        Else
            lGravouOK := .F.
        EndIf

        If lGravouOK
            // ------------------------------------------
            // Busca descricao do Conjunto Sistema em MI2
            // ------------------------------------------
            cDescConj := AllTrim(POSICIONE("MI2",1,xFilial("MI2") + PadR(cCodCon, TamSx3("MI2_CODCON")[1]),"MI2_DESCRI"))

            // ------------------------------------------
            // Retorno de sucesso
            // ------------------------------------------
            oRest:setStatusCode(200)  // HTTP 200 = OK
            oJsonRespo['success']  := .T.
            oJsonRespo['message']  := STR0019 //"Conjunto Sistema vinculado com sucesso"
            oJsonRespo['uidmod']   := AllTrim(cUidMod)
            oJsonRespo['codpro']   := RTRIM(cCodPro)
            oJsonRespo['codcon']   := AllTrim(cCodCon)
            oJsonRespo['descConj'] := cDescConj
        Else
            oRest:setStatusCode(400)  // HTTP 400 = Bad Request
            aErros := oModel:GetErrorMessage()
            oJsonRespo['success']  := .F.
            oJsonRespo['field']    := IIf(!Empty(aErros[4]), aErros[4], "")
            oJsonRespo['message'] := IIf(!Empty(aErros[6]), aErros[6], STR0020) //"Erro ao vincular o Conjunto Sistema"
            oJsonRespo['solution'] := IIf(!Empty(aErros[7]), aErros[7], "")
        EndIf
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    // ==========================================
    // Libera Recursos da Memoria
    // ==========================================
    If ValType(oModel) <> "U"
        oModelMF0:DeActivate()
        oModel:DeActivate()
        FreeObj(oModelMF0)
        FreeObj(oModel)
    EndIf

    FreeObj(oJsBody)
    FreeObj(oJsonRespo)
    FreeObj(oJPathParam)

    RestArea(aArea)

Return .T.

/*/{Protheus.doc} FindAvailableVehicleModels
    Consulta os modelos de veiculo disponiveis na tabela MEC com filtros opcionais.
    Realiza JOIN com ME6 para enriquecimento com nome do veiculo.
    @type    method
    @author  eduardo.FLima
    @since   07/07/2026
    @version p12
    @param   cModelo , Character , filtro por modelo (busca parcial LIKE, case-insensitive)
    @param   cCodVei , Character , filtro por codigo do veiculo (igualdade)
    @param   cCodTra , Character , filtro por codigo de transmissao (igualdade)
    @param   cCodMot , Character , filtro por codigo de motorizacao (igualdade)
    @param   cFabIni , Character , filtro por inicio de fabricacao - maior ou igual (>=)
    @param   cFabFim , Character , filtro por fim de fabricacao - menor ou igual (<=)
    @return  aItens  , Array     , array de objetos JSON com os modelos encontrados
/*/
Method FindAvailableVehicleModels(cModelo as Character, cCodVei as Character, cCodTra as Character, cCodMot as Character, cFabIni as Character, cFabFim as Character) as Array Class RetailAutopartsCatalogProductVehicleModelController
    Local oQueryQry     := Nil as Object
    Local jItem         := Nil as Object
    Local aItens        := {} as Array
    Local cQry          := "" as Character
    Local cAliasQry     := "" as Character
    Local nSeq          := 1 as Numeric
    Local aArea         := GetArea() as Array

    Default cModelo  := ""
    Default cCodVei  := ""
    Default cCodTra  := ""
    Default cCodMot  := ""
    Default cFabIni  := ""
    Default cFabFim  := ""

    dbSelectArea("MEC")

    cQry := " SELECT MEC.MEC_MSUID, MEC.MEC_CODVEI, MEC.MEC_MODELO, "
    cQry += " MEC.MEC_FABINI, MEC.MEC_FABFIM, MEC.MEC_GERACA, "
    cQry += " MEC.MEC_CODTRA, MEC.MEC_CODMOT, "
    cQry += " ME6.ME6_NOME AS NOMVEI "
    cQry += " FROM " + RetSqlName("MEC") + " MEC "
    cQry += " LEFT JOIN " + RetSqlName("ME6") + " ME6 ON ME6.ME6_FILIAL = ? AND ME6.ME6_CODVEI = MEC.MEC_CODVEI AND ME6.D_E_L_E_T_ = ? "
    cQry += " WHERE "
    cQry += " MEC.MEC_FILIAL = ? "

    If !Empty(cModelo)
        cQry += " AND UPPER(MEC.MEC_MODELO) LIKE ? "
    EndIf
    If !Empty(cCodVei)
        cQry += " AND MEC.MEC_CODVEI = ? "
    EndIf
    If !Empty(cCodTra)
        cQry += " AND MEC.MEC_CODTRA = ? "
    EndIf
    If !Empty(cCodMot)
        cQry += " AND MEC.MEC_CODMOT = ? "
    EndIf
    If !Empty(cFabIni)
        cQry += " AND MEC.MEC_FABINI >= ? "
    EndIf
    If !Empty(cFabFim)
        cQry += " AND MEC.MEC_FABFIM <= ? "
    EndIf

    cQry += " AND MEC.D_E_L_E_T_ = ? "
    cQry += " ORDER BY MEC.MEC_MODELO "
    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)

    // Parametros do LEFT JOIN ME6
    oQueryQry:SetString(nSeq++, xFilial("ME6"))  // ME6.ME6_FILIAL
    oQueryQry:SetString(nSeq++, Space(1))          // ME6.D_E_L_E_T_

    // Parametro do WHERE principal
    oQueryQry:SetString(nSeq++, xFilial("MEC"))  // MEC.MEC_FILIAL

    If !Empty(cModelo)
        oQueryQry:SetString(nSeq++, "%" + Upper(cModelo) + "%")
    EndIf
    If !Empty(cCodVei)
        oQueryQry:SetString(nSeq++, PadR(cCodVei, TamSx3("MEC_CODVEI")[1]))
    EndIf
    If !Empty(cCodTra)
        oQueryQry:SetString(nSeq++, PadR(cCodTra, TamSx3("MEC_CODTRA")[1]))
    EndIf
    If !Empty(cCodMot)
        oQueryQry:SetString(nSeq++, PadR(cCodMot, TamSx3("MEC_CODMOT")[1]))
    EndIf
    If !Empty(cFabIni)
        oQueryQry:SetString(nSeq++, PadR(cFabIni, TamSx3("MEC_FABINI")[1]))
    EndIf
    If !Empty(cFabFim)
        oQueryQry:SetString(nSeq++, PadR(cFabFim, TamSx3("MEC_FABFIM")[1]))
    EndIf

    oQueryQry:SetString(nSeq++, Space(1))  // MEC.D_E_L_E_T_

    cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

    While (cAliasQry)->(!EOF())
        jItem := JsonObject():New()
        jItem["msuid"]   := RTRIM((cAliasQry)->MEC_MSUID)
        jItem["codvei"]  := RTRIM((cAliasQry)->MEC_CODVEI)
        jItem["nomeVeic"]:= RTRIM((cAliasQry)->NOMVEI)
        jItem["codtra"]  := RTRIM((cAliasQry)->MEC_CODTRA)
        jItem["codmot"]  := RTRIM((cAliasQry)->MEC_CODMOT)
        jItem["modelo"]  := RTRIM((cAliasQry)->MEC_MODELO)
        jItem["fabini"]  := RTRIM((cAliasQry)->MEC_FABINI)
        jItem["fabfim"]  := RTRIM((cAliasQry)->MEC_FABFIM)
        jItem["geraca"]  := RTRIM((cAliasQry)->MEC_GERACA)
        aAdd(aItens, jItem)
        jItem := Nil
        (cAliasQry)->(dbSkip())
    EndDo

    (cAliasQry)->(dbCloseArea())
    oQueryQry:Destroy()
    oQueryQry := Nil

    RestArea(aArea)

Return(aItens)

/*/{Protheus.doc} FindProductVehicleModels
    Consulta os vinculos produto x modelo de veiculo da tabela MF0,
    com dados enriquecidos de MEC (modelo, fabricacao) e ME6 (nome veiculo) via JOIN.
    @type    method
    @author  eduardo.FLima
    @since   07/07/2026
    @version p12
    @param   cCodPro , Character , codigo do produto (MF0_CODPRO) - obrigatorio
    @param   cUidmod , Character , uuid do modelo de veiculo (MF0_UIDMOD) - opcional, filtra por modelo especifico
    @return  Array     , array de objetos JSON com os vinculos encontrados
    @obs     O retorno sera por aplicação (produtoXmodelo) e o conjuntos de sistemas sera um subdominio.
/*/
Method FindProductVehicleModels(cCodPro as Character, cUidmod as Character) as Array Class RetailAutopartsCatalogProductVehicleModelController
    Local oQueryQry     := Nil as Object
    Local jItem         := Nil as Object
    Local jSystemSet    := Nil as Object
    Local aItens        := {} as Array
    Local aSystemSets   := {} as Array
    Local cQry          := "" as Character
    Local cAliasQry     := "" as Character
    Local cUidAtual     := "" as Character
    Local cCnjSis       := "" as Character
    Local nSeq          := 1 as Numeric
    Local aArea         := GetArea() as Array

    Default cCodPro := ""

    dbSelectArea("MF0")

    cQry := " SELECT MF0.MF0_FILIAL, MF0.MF0_UIDMOD, MF0.MF0_CODPRO, MF0.MF0_CNJSIS, "
    cQry += " MI2.MI2_DESCRI, "
    cQry += " MEC.MEC_MODELO AS MODELO, "
    cQry += " MEC.MEC_FABINI AS FABINI, "
    cQry += " MEC.MEC_FABFIM AS FABFIM, "
    cQry += " ME6.ME6_NOME AS NOMVEI "
    cQry += " FROM " + RetSqlName("MF0") + " MF0 "
    cQry += " LEFT JOIN " + RetSqlName("MEC") + " MEC ON MEC.MEC_FILIAL = ? AND MEC.MEC_MSUID = MF0.MF0_UIDMOD AND MEC.D_E_L_E_T_ = ? "
    cQry += " LEFT JOIN " + RetSqlName("ME6") + " ME6 ON ME6.ME6_FILIAL = ? AND ME6.ME6_CODVEI = MEC.MEC_CODVEI AND ME6.D_E_L_E_T_ = ? "
    cQry += " LEFT JOIN " + RetSqlName("MI2") + " MI2 ON MI2.MI2_FILIAL = ? AND MI2.MI2_CODCON = MF0.MF0_CNJSIS  AND MI2.D_E_L_E_T_ = ? "
    cQry += " WHERE "
    cQry += " MF0.MF0_FILIAL = ? "
    cQry += " AND MF0.MF0_CODPRO = ? "
    if !Empty(cUidmod)
        cQry += " AND MF0.MF0_UIDMOD = ? "
    Endif
    cQry += " AND MF0.D_E_L_E_T_ = ? "
    cQry += " ORDER BY MF0.MF0_FILIAL, MF0.MF0_UIDMOD, MF0.MF0_CODPRO "
    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)

    // Parametros dos LEFT JOINs
    oQueryQry:SetString(nSeq++, xFilial("MEC"))     // MEC.MEC_FILIAL
    oQueryQry:SetString(nSeq++, Space(1))           // MEC.D_E_L_E_T_
    oQueryQry:SetString(nSeq++, xFilial("ME6"))     // ME6.ME6_FILIAL
    oQueryQry:SetString(nSeq++, Space(1))           // ME6.D_E_L_E_T_
    oQueryQry:SetString(nSeq++, xFilial("MI2"))     // MI2.MI2_FILIAL
    oQueryQry:SetString(nSeq++, Space(1))           // MI2.D_E_L_E_T_

    // Parametros do WHERE principal
    oQueryQry:SetString(nSeq++, xFilial("MF0"))                        // MF0.MF0_FILIAL
    oQueryQry:SetString(nSeq++, PadR(cCodPro, TamSx3("MF0_CODPRO")[1]))  // MF0.MF0_CODPRO
    If !Empty(cUidmod)
        oQueryQry:SetString(nSeq++, PadR(cUidmod, TamSx3("MF0_UIDMOD")[1]))  // MF0.MF0_UIDMOD
    EndIf
    oQueryQry:SetString(nSeq++, Space(1))                               // MF0.D_E_L_E_T_

    cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

    While (cAliasQry)->(!EOF())

        // ------------------------------------------
        // Quebra de nivel: detecta mudanca de UIDMOD
        // ------------------------------------------
        If AllTrim((cAliasQry)->MF0_UIDMOD) != cUidAtual

            // Fecha o grupo anterior (se houver)
            If jItem != Nil
                jItem["systemssets"] := aSystemSets
                aAdd(aItens, jItem)
                jItem := Nil
            EndIf

            // Inicia novo grupo
            cUidAtual   := AllTrim((cAliasQry)->MF0_UIDMOD)
            aSystemSets := {}

            jItem := JsonObject():New()
            jItem["uidmod"]  := RTRIM((cAliasQry)->MF0_UIDMOD)
            jItem["codpro"]  := RTRIM((cAliasQry)->MF0_CODPRO)
            jItem["modelo"]  := RTRIM((cAliasQry)->MODELO)
            jItem["nomeVeic"]:= RTRIM((cAliasQry)->NOMVEI)
            jItem["fabini"]  := RTRIM((cAliasQry)->FABINI)
            jItem["fabfim"]  := RTRIM((cAliasQry)->FABFIM)

        EndIf

        // Acumula o conjunto de sistema da linha corrente (apenas se nao vazio)
        cCnjSis := RTRIM((cAliasQry)->MF0_CNJSIS)
        If !Empty(cCnjSis)
            jSystemSet := JsonObject():New()
            jSystemSet["systemSetCode"] := cCnjSis
            jSystemSet["systemSetDesc"] := RTRIM((cAliasQry)->MI2_DESCRI)
            aAdd(aSystemSets, jSystemSet)
        EndIf

        (cAliasQry)->(dbSkip())
    EndDo

    // Fecha o ultimo grupo apos sair do loop
    If jItem != Nil
        jItem["systemssets"] := aSystemSets
        aAdd(aItens, jItem)
        jItem := Nil
    EndIf

    (cAliasQry)->(dbCloseArea())
    oQueryQry:Destroy()
    oQueryQry := Nil

    RestArea(aArea)

Return(aItens)

