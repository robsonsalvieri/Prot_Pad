#INCLUDE 'PROTHEUS.CH'
#INCLUDE 'tlpp-core.th'
#INCLUDE 'tlpp-rest.th'
#INCLUDE 'FWMVCDEF.CH'
#INCLUDE 'retail.autoparts.catalog.axle.controller.ch'

//               Nome do parâmetro no JSON      , Campo no SX3   , Tipo
Static aFields :=   { ;
                    {"code"                     , "MEB_CODEIX"   , "C"    },;
                    {"description"              , "MEB_DESCRI"   , "C"    },;
                    {"manufacturerBranch"       , "MEB_FILFAB"   , "C"    },;
                    {"manufacturerCode"         , "MEB_CODFAB"   , "C"    },;
                    {"manufacturerStore"        , "MEB_LOJFAB"   , "C"    },;
                    {"axleModelBranch"          , "MEB_FILMOD"   , "C"    },;
                    {"axleModelCode"            , "MEB_CODMOD"   , "C"    };
                    } as Array

namespace totvs.protheus.retail.autoparts.catalog.axle.controller

/*/{Protheus.doc} retailAutopartsCatalogAxleController
    API relacionada ao Cadastro de Eixo do catalogo de autopecas.
    @type    class
    @author  Alberto Deviciente
    @since   26/06/2026
    @version P12
/*/
Class retailAutopartsCatalogAxleController
    public Method New()
    private method FindAxle(cBranch as Character, cCode as Character, cDescri as Character, cFilFab as Character, cCodFab as Character, cLojFab as Character, cFilModelAxle as Character, cModelAxle as Character) as Array

    @Get("/api/retail/v1/retailAutopartsCatalogAxle/getDataForAxle", description="Consulta do cadastro de Eixo do catalogo de autopecas")
    public Method getDataForAxle()

    @Post("/api/retail/v1/retailAutopartsCatalogAxle/postDataForAxle", description="Cadastra um novo Eixo para o catalogo de autopecas")
    public Method postDataForAxle()

    @Put("/api/retail/v1/retailAutopartsCatalogAxle/putDataForAxle", description="Altera um Eixo existente no catalogo de autopecas")
    public Method putDataForAxle()

    @Delete("/api/retail/v1/retailAutopartsCatalogAxle/deleteDataForAxle/:code", description="Deleta um Eixo do catalogo de autopecas")
    public Method deleteDataForAxle()

EndClass

/*/{Protheus.doc} New
    Método   construtor
    @type    method
    @author  Alberto Deviciente
    @since   26/06/2026
    @version P12

    @return  Object, Objeto da classe
/*/
Method New() Class retailAutopartsCatalogAxleController
Return Self

/*/{Protheus.doc} getDataForAxle
    Retorna os Eixos do catalogo de auto pecas
    @type    method
    @author  Alberto Deviciente
    @since   26/06/2026
    @version P12

    @return  Logical, True (.T.)
/*/
Method getDataForAxle() Class retailAutopartsCatalogAxleController
    Local oJsonRespo    as Object
    Local oJParametr    as Object
    Local aArea         as Array
    Local aItens        as Array
    Local cBranch       as Character
    Local cCode         as Character
    Local cDescri       as Character
    Local cFilFab       as Character
    Local cCodFab       as Character
    Local cLojFab       as Character
    Local cFilModelAxle as Character
    Local cModelAxle    as Character
    Local nI            as Numeric

    oJsonRespo    := JsonObject():New()
    oJParametr    := Nil
    aArea         := GetArea()
    aItens        := {}
    cBranch       := xFilial("MEB")
    cCode         := ""
    cDescri       := ""
    cFilFab       := ""
    cCodFab       := ""
    cLojFab       := ""
    cFilModelAxle := ""
    cModelAxle    := ""
    nI            := 0

    DbSelectArea("MEB")

    oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

    // Obtém os dados enviados na Requisição (Via Query Params)
    oJParametr    := oRest:getQueryRequest()

    // Obtém os parâmetros informados na requisição via URL (query param)
  	If oJParametr:hasProperty('code')
        cCode := oJParametr['code']
    EndIf
    If oJParametr:hasProperty('description')
        cDescri := oJParametr['description']
    EndIf
    If oJParametr:hasProperty('manufacturerBranch')
        cFilFab := oJParametr['manufacturerBranch']
    EndIf
    If oJParametr:hasProperty('manufacturerCode')
        cCodFab := oJParametr['manufacturerCode']
    EndIf
    If oJParametr:hasProperty('manufacturerStore')
        cLojFab := oJParametr['manufacturerStore']
    EndIf
    If oJParametr:hasProperty('axleModelBranch')
        cFilModelAxle := oJParametr['axleModelBranch']
    EndIf
    If oJParametr:hasProperty('axleModelCode')
        cModelAxle := oJParametr['axleModelCode']
    EndIf
    
    aItens := self:FindAxle(cBranch, cCode, cDescri, cFilFab, cCodFab, cLojFab, cFilModelAxle, cModelAxle)
    
    If !empty(aItens)
        oJsonRespo["items"] := aItens
        oRest:setStatusCode(200)  // HTTP 200 = Sucesso
    Else
        oJsonRespo["items"]     := {}
        oJsonRespo["message"]   := EncodeUTF8(STR0001, "cp1252") //"Dados não encontrados para o filtro Informado"
        oRest:setStatusCode(404)  // HTTP 404 = Not Found
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    // ==========================================
    // Libera Recursos da Memoria
    // ==========================================
    FwFreeObj(oJsonRespo)
    FwFreeObj(oJParametr)

    //Libera o objeto da memória em cada posição do array
    For nI := 1 To Len(aItens)
        FwFreeObj(aItens[nI])
    Next nI
    aItens := {}

    RestArea(aArea)

Return .T.

/*/{Protheus.doc} FindAxle
    Consulta o cadastro de Eixo do catálogo de auto pecas
    @type    method
    @author  Alberto Deviciente
    @since   21/06/2026
    @version P12

    @param cBranch      , Character , filial a ser filtrada
    @param cCode        , Character , código a ser filtrado
    @param cDescri      , Character , descrição a ser filtrada
    @param cFilFab      , Character , filial fabricante a ser filtrada
    @param cCodFab      , Character , código fabricante a ser filtrado
    @param cLojFab      , Character , loja fabricante a ser filtrada
    @param cFilModelAxle, Character , filial do modelo de eixo
    @param cModelAxle   , Character , modelo de eixo a ser filtrado

    @return aItens      , Array     , array de itens encontrados
/*/
method FindAxle(cBranch as Character, cCode as Character, cDescri as Character, cFilFab as Character, cCodFab as Character, cLojFab as Character, cFilModelAxle as Character, cModelAxle as Character) as Array Class retailAutopartsCatalogAxleController
    Local oQueryQry		    as Object
    Local aItens            as Array
	Local cQry			    as Character
	Local nSeq			    as Numeric
    Local aArea             as Array
    Local cAliasQry         as Character
    Local jItem             as Object

    Default cBranch         := xFilial("MEB")
    Default cCode           := ""
    Default cDescri         := ""
    Default cFilFab         := ""
    Default cCodFab         := ""
    Default cLojFab         := ""
    Default cFilModelAxle   := xFilial("MG2")
    Default cModelAxle      := ""

    oQueryQry		  := Nil
    aItens            := {}
	cQry			  := ""
	nSeq			  := 1
    aArea             := GetArea()
    cAliasQry         := ""
    jItem             := Nil

    cQry	:= " SELECT MEB.MEB_FILIAL, MEB.MEB_CODEIX, MEB.MEB_DESCRI, MEB.MEB_FILFAB, MEB.MEB_CODFAB, MEB.MEB_LOJFAB, SA2.A2_NOME, MEB.MEB_FILMOD, MEB.MEB_CODMOD, MG2.MG2_NOME "
	cQry	+= " FROM "+ RetSqlName("MEB") +" MEB "
    cQry	+= " LEFT JOIN "+ RetSqlName("SA2") +" SA2 ON MEB.MEB_FILFAB = SA2.A2_FILIAL AND MEB.MEB_CODFAB = SA2.A2_COD AND MEB.MEB_LOJFAB = SA2.A2_LOJA AND SA2.D_E_L_E_T_ = ? "
    cQry	+= " LEFT JOIN "+ RetSqlName("MG2") +" MG2 ON MEB.MEB_FILMOD = MG2.MG2_FILIAL AND MEB.MEB_CODMOD = MG2.MG2_CODMOD AND MG2.D_E_L_E_T_ = ? "
	cQry	+= " WHERE "
    cQry	+= " MEB.MEB_FILIAL = ? "
    If !Empty(cCode)
        cQry	+= " AND MEB.MEB_CODEIX = ? "
    EndIf
    If !Empty(cDescri)
        cQry	+= " AND UPPER(MEB.MEB_DESCRI) LIKE ? "
    EndIf
    If Len(cFilFab) > 0
        cQry	+= " AND MEB.MEB_FILFAB = ? "
    EndIf
    If !Empty(cCodFab)
        cQry	+= " AND MEB.MEB_CODFAB = ? "
    EndIf
    If !Empty(cLojFab)
        cQry	+= " AND MEB.MEB_LOJFAB = ? "
    EndIf
    If Len(cFilModelAxle) > 0
        cQry	+= " AND MEB.MEB_FILMOD = ? "
    EndIf
    If !Empty(cModelAxle)
        cQry	+= " AND MEB.MEB_CODMOD = ? "
    EndIf
    cQry	+= " AND MEB.D_E_L_E_T_ = ? "

	cQry 	:= ChangeQuery(cQry)

	oQueryQry := FwExecStatement():New(cQry)
    oQueryQry:SetString(nSeq++,		Space(1))
    oQueryQry:SetString(nSeq++,		Space(1))
    oQueryQry:SetString(nSeq++,		cBranch)
    If !Empty(cCode)
        oQueryQry:SetString(nSeq++,		cCode)
    EndIf
    If !Empty(cDescri)
        oQueryQry:SetString(nSeq++, "%" + Upper(cDescri) + "%")
    EndIf
    If Len(cFilFab) > 0
        oQueryQry:SetString(nSeq++,		cFilFab)
    EndIf
    If !Empty(cCodFab)
        oQueryQry:SetString(nSeq++,		cCodFab)
    EndIf
    If !Empty(cLojFab)
        oQueryQry:SetString(nSeq++,		cLojFab)
    EndIf
    If Len(cFilModelAxle) > 0
        oQueryQry:SetString(nSeq++,		cFilModelAxle)
    EndIf
    If !Empty(cModelAxle)
        oQueryQry:SetString(nSeq++,		cModelAxle)
    EndIf
    oQueryQry:SetString(nSeq++,		Space(1))

	cAliasQry := oQueryQry:OpenAlias(GetNextAlias())
    
    While (cAliasQry)->( !EOF() )
        jItem := JsonObject():New()
        jItem["branch"]             := EncodeUTF8(AllTrim((cAliasQry)->MEB_FILIAL), "cp1252")
        jItem["code"]               := EncodeUTF8(AllTrim((cAliasQry)->MEB_CODEIX), "cp1252")
        jItem["description"]        := EncodeUTF8(AllTrim((cAliasQry)->MEB_DESCRI), "cp1252")
        jItem["manufacturerBranch"] := EncodeUTF8(AllTrim((cAliasQry)->MEB_FILFAB), "cp1252")
        jItem["manufacturerCode"]   := EncodeUTF8(AllTrim((cAliasQry)->MEB_CODFAB), "cp1252")
        jItem["manufacturerStore"]  := EncodeUTF8(AllTrim((cAliasQry)->MEB_LOJFAB), "cp1252")
        jItem["manufacturerName"]   := EncodeUTF8(AllTrim((cAliasQry)->A2_NOME), "cp1252")
        jItem["axleModelBranch"]    := EncodeUTF8(AllTrim((cAliasQry)->MEB_FILMOD), "cp1252")
        jItem["axleModelCode"]      := EncodeUTF8(AllTrim((cAliasQry)->MEB_CODMOD), "cp1252")
        jItem["axleModelName"]      := EncodeUTF8(AllTrim((cAliasQry)->MG2_NOME), "cp1252")

        // Adiciona o item no array de itens
        aAdd(aItens, jItem)
        jItem := Nil
        (cAliasQry)->(dbSkip())
    EndDo
	(cAliasQry)->(dbCloseArea())
    oQueryQry:Destroy()
    oQueryQry := Nil

    RestArea(aArea)

Return(aItens)

/*/{Protheus.doc} postDataForAxle
    Cadastro de Eixo para o catálogo de auto peças
    @type    method
    @author  Alberto Deviciente
    @since   26/06/2026
    @version P12

    @return  Logical, True (.T.)
/*/
Method postDataForAxle() Class retailAutopartsCatalogAxleController
    Local oJsBody       as Object
    Local oJsonRespo    as Object
    Local oModel        as Object
    Local oModelMEB     as Object
    Local lGravouOK     as Logical
    Local aErros        as Array
    Local lDadosOK      as Logical
    Local cParamName    as Character
    Local cFieldName    as Character
    Local lAnyParInf    as Logical // Se algum parametro de update foi informado
    Local nX            as Numeric
    Local cJsonUtf8     := "" as Character
    Local cJsonCP1252   := "" as Character

    oJsBody       := JsonObject():New()
    oJsonRespo    := JsonObject():New()
    oModel        := Nil
    oModelMEB     := Nil
    lGravouOK     := .F.
    aErros        := {}
    lDadosOK      := .T.
    cParamName    := ""
    cFieldName    := ""
    lAnyParInf    := .F.
    nX            := 0

    DbSelectArea("MEB")

    oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")
    
    // Obtém os dados enviados na Requisição (Via Body Params)
    cJsonUtf8 := oRest:GetBodyRequest()
    cJsonCP1252 := DecodeUTF8(cJsonUtf8, "cp1252")  // Converte UTF-8 para CP1252
    oJsBody:fromJson(cJsonCP1252)
    
    // ==========================================
    // Carrega o Model MVC
    // ==========================================
    oModel := FWLoadModel("LOJA6080")  // Carrega o modelo de dados
    oModel:SetOperation(MODEL_OPERATION_INSERT)  // Define operação de inclusão
    oModel:Activate()  // Ativa o modelo
    
    // ------------------------------------------
    // Obtém o SubModel da Tabela MEB
    // ------------------------------------------
    oModelMEB := oModel:GetModel("MEBMASTER")
    
    // ==========================================
    // Preenche os Campos do Model
    // ==========================================
    For nX := 1 To Len(aFields)
        cParamName := aFields[nX][1]  // Nome do parâmetro no JSON
        cFieldName := aFields[nX][2]  // Nome do campo no Model
        
        If oJsBody[cParamName] != Nil
            oModelMEB:SetValue(cFieldName, oJsBody[cParamName])
            lAnyParInf := .T.
        EndIf
    Next nX

    If !lAnyParInf
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['message'] := EncodeUTF8(STR0002, "cp1252") //"Nenhum parâmetro informado para cadastro"
        lDadosOK := .F.
    EndIf
    
    If lDadosOK
        // ==========================================
        // Valida e Grava os Dados
        // ==========================================
        
        // ------------------------------------------
        // Validação dos Dados
        // ------------------------------------------
        If oModel:VldData()
            // ------------------------------------------
            // Gravação (Commit)
            // ------------------------------------------
            lGravouOK := oModel:CommitData()
        Else
            // Validação falhou
            lGravouOK := .F.
        EndIf
        
        // ==========================================
        // Prepara a Resposta
        // ==========================================
        If lGravouOK
            oRest:setStatusCode(201)  // HTTP 201 = Created
            oJsonRespo['success']   := .T.
            oJsonRespo['message']   := EncodeUTF8(STR0003 + MEB->MEB_CODEIX + STR0004, "cp1252") //"Eixo " ### " cadastrado com sucesso"
            For nX := 1 to Len(aFields)
                cParamName := aFields[nX][1]  // Nome do parâmetro no JSON
                cFieldName := aFields[nX][2]  // Nome do campo no Model
                oJsonRespo[cParamName] := EncodeUTF8(AllTrim(&("MEB->"+cFieldName)), "cp1252")
            Next nX
            
        Else
            // ------------------------------------------
            // ERRO: Falha na Validação ou Gravação
            // ------------------------------------------
            oRest:setStatusCode(400)  // HTTP 400 = Bad Request
            
            // Captura os erros do Model
            aErros := oModel:GetErrorMessage()
            
            /*
            Estrutura do Array aErros:
            [1] = Id do formulário de origem
            [2] = Id do campo de origem
            [3] = Id do formulário de erro
            [4] = Id do campo de erro
            [5] = Id do erro
            [6] = Mensagem do erro
            [7] = Mensagem da solução
            [8] = Valor atribuído
            [9] = Valor anterior
            */
            oJsonRespo['success']   := .F.
            oJsonRespo['message']   := EncodeUTF8(IIf(!Empty(aErros[6]), aErros[6], STR0006), "cp1252") //"Erro ao cadastrar"
            If Len(aErros) >= 7
                oJsonRespo['field']     := EncodeUTF8(iif(!Empty(aErros[4]), aErros[4], ""), "cp1252")
                oJsonRespo['errorId']   := EncodeUTF8(iif(!Empty(aErros[5]), aErros[5], ""), "cp1252")
                oJsonRespo['solution']  := EncodeUTF8(iif(!Empty(aErros[7]), aErros[7], ""), "cp1252")
            EndIf
        EndIf

    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    // ==========================================
    // Libera Recursos da Memória
    // ==========================================
    oModel:DeActivate()
    FwFreeObj(oModel)
    FwFreeObj(oJsBody)
    FwFreeObj(oJsonRespo)
    
Return .T.

/*/{Protheus.doc} putDataForAxle
    Altera cadastro de Eixo do catálogo de auto peças
    @type    method
    @author  Alberto Deviciente
    @since   26/06/2026
    @version P12

    @return  Logical, True (.T.)
/*/
Method putDataForAxle() Class retailAutopartsCatalogAxleController
    Local oJsonRespo    as Object
    Local oJsBody       as Object
    Local oJParametr    as Object
    Local lFound        as Logical
    Local cBranch       as Character
    Local cCode         as Character
    Local aArea         as Array
    Local oModel        as Object
    Local oModelMEB     as Object
    Local lGravouOK     as Logical
    Local aErros        as Array
    Local nX            as Numeric
    Local cParamName    as Character
    Local cFieldName    as Character
    Local lAnyParInf    as Logical // Se algum parametro de update foi informado
    Local lDadosOK      as Logical
    Local nLenMEBCODEIX as Numeric
    Local cJsonUtf8     := "" as Character
    Local cJsonCP1252   := "" as Character

    oJsonRespo    := JsonObject():New()
    oJsBody       := JsonObject():New()
    oJParametr    := Nil
    lFound        := .F.
    cBranch       := xFilial("MEB")
    cCode         := ""
    aArea         := GetArea()
    oModel        := Nil
    oModelMEB     := Nil
    lGravouOK     := .F.
    aErros        := {}
    nX            := 0
    cParamName    := ""
    cFieldName    := ""
    lAnyParInf    := .F.
    lDadosOK      := .T.
    nLenMEBCODEIX := TamSx3("MEB_CODEIX")[1]

    oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

    // Obtém os dados enviados na Requisição (Via Query Params). Para localizar o registro a ser alterado.
    oJParametr  := oRest:getQueryRequest()

    // Obtém os dados enviados na Requisição (Via Body Params). Dados a serem atualizados
    cJsonUtf8 := oRest:getBodyRequest()
    cJsonCP1252 := DecodeUTF8(cJsonUtf8, "cp1252")  // Converte UTF-8 para CP1252
    oJsBody:fromJson(cJsonCP1252)

    // Obtém os parâmetros informados na requisição via URI (query param). Para localizar o registro a ser alterado.
    If oJParametr:hasProperty('code')
        cCode := oJParametr['code']
    EndIf

    // ==========================================
    // Validacao codigo Obrigatorio
    // ==========================================
    If Empty(cCode)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['message'] := EncodeUTF8(STR0012 + "'code'" + STR0015, "cp1252") //"Parâmetro " ### 'code' (código) ### " é obrigatório"
        lDadosOK := .F.
    EndIf

    If lDadosOK
        If Len(cCode) <> nLenMEBCODEIX
            oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
            oJsonRespo['message'] := EncodeUTF8(STR0012 + "'code'" + STR0013 + cValToChar(nLenMEBCODEIX) + STR0014, "cp1252") //"Parâmetro " ### "'code'" + " deve ter " + cValToChar(nLenMEBCODEIX) + " caracteres."
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        dbSelectArea('MEB')
        MEB->(dbSetOrder(1)) //MEB_FILIAL+MEB_CODEIX
        
        lFound := MEB->(dbSeek(cBranch + PadR(cCode,nLenMEBCODEIX)))
        
        // ------------------------------------------
        // Se não encontrou retorna erro 404
        // ------------------------------------------
        If !lFound
            oRest:setStatusCode(404)  // HTTP 404 = Not Found
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := EncodeUTF8(STR0008 + AllTrim(cCode) + STR0009, "cp1252") //"Registro " ### " não encontrado"
            lDadosOK := .F.
        EndIf
    EndIf
    
    If lDadosOK
        // ==========================================
        // Carrega o Model MVC para Alteração
        // ==========================================
        oModel := FWLoadModel("LOJA6080")  // Carrega o modelo de dados
        oModel:SetOperation(MODEL_OPERATION_UPDATE)  // Define operação de ALTERAÇÃO
        oModel:Activate()  // Ativa o modelo
        
        // ------------------------------------------
        // Obtém o SubModel da Tabela MEB
        // ------------------------------------------
        oModelMEB := oModel:GetModel("MEBMASTER")
        
        // ==========================================
        // Preenche os Campos do Model
        // ==========================================
        For nX := 1 To Len(aFields)
            cParamName := aFields[nX][1]  // Nome do parâmetro no JSON
            cFieldName := aFields[nX][2]  // Nome do campo no Model
            
            If oJsBody[cParamName] != Nil
                oModelMEB:SetValue(cFieldName, oJsBody[cParamName])
                lAnyParInf := .T.
            EndIf
        Next nX

        If !lAnyParInf
            oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
            oJsonRespo['message'] := EncodeUTF8(STR0010, "cp1252") //"Nenhum parâmetro informado para alteração"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        // ==========================================
        // Valida e Grava as Alterações
        // ==========================================
        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        Else
            lGravouOK := .F.
        EndIf
        
        If lGravouOK
            oRest:setStatusCode(200)  // HTTP 200 = OK
            oJsonRespo['success'] := .T.
            oJsonRespo['message'] := EncodeUTF8(STR0003 + AllTrim(cCode) + STR0005, "cp1252") //"Eixo " ### " atualizado com sucesso"
            oJsonRespo['code'] := cCode
            for nX := 1 to Len(aFields)
                cParamName := aFields[nX][1]  // Nome do parâmetro no JSON
                cFieldName := aFields[nX][2]  // Nome do campo no Model
                oJsonRespo[cParamName] := EncodeUTF8(AllTrim(&("MEB->"+cFieldName)), "cp1252")
            Next nX
            
        Else
            oRest:setStatusCode(400)  // HTTP 400 = Bad Request
            
            // Captura os erros do Model
            aErros := oModel:GetErrorMessage()
            
            /*
            Estrutura do Array aErros:
            [1] = Id do formulário de origem
            [2] = Id do campo de origem
            [3] = Id do formulário de erro
            [4] = Id do campo de erro
            [5] = Id do erro
            [6] = Mensagem do erro
            [7] = Mensagem da solução
            [8] = Valor atribuído
            [9] = Valor anterior
            */
            
            oJsonRespo['success']   := .F.
            oJsonRespo['message']   := EncodeUTF8(IIf(!Empty(aErros[6]), aErros[6], STR0011), "cp1252") //"Erro ao atualizar"
            If Len(aErros) >= 7
                oJsonRespo['field']     := EncodeUTF8(iif(!Empty(aErros[4]), aErros[4], ""), "cp1252")
                oJsonRespo['errorId']   := EncodeUTF8(iif(!Empty(aErros[5]), aErros[5], ""), "cp1252")
                oJsonRespo['solution']  := EncodeUTF8(iif(!Empty(aErros[7]), aErros[7], ""), "cp1252")
            EndIf
        EndIf
        
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())
    
    // ==========================================
    // Libera Recursos da Memória
    // ==========================================
    If ValType(oModel) <> "U"
        oModelMEB:DeActivate()  // Desativa o SubModel
        oModel:DeActivate()     // Desativa o Model
        
        FwFreeObj(oModelMEB)  // Libera objeto da memória
        FwFreeObj(oModel)     // Libera objeto da memória
    EndIf

    // ==========================================
    // Libera Recursos da Memória
    // ==========================================
    FwFreeObj(oJsBody)
    FwFreeObj(oJsonRespo)
    FwFreeObj(oJParametr)
    
    RestArea(aArea)
    
Return .T.

/*/{Protheus.doc} deleteDataForAxle
    Deleta Eixo do catalogo de autopecas
    @type    method
    @author  Alberto Deviciente
    @since   26/06/2026
    @version P12

    @return  Logical, True (.T.)
/*/
method deleteDataForAxle()  Class retailAutopartsCatalogAxleController
    Local oJsonRespo    as Object
    Local oJParametr    as Object
    Local lFound        as Logical
    Local cBranch       as Character
    Local cCode         as Character
    Local aArea         as Array
    Local oModel        as Object
    Local lGravouOK     as Logical
    Local lDadosOK      as Logical
    Local nLenMEBCODEIX as Numeric
    Local nStatusCode   as Numeric
    Local cMsg          as Character

    oJsonRespo    := JsonObject():New()
    lFound        := .F.
    cBranch       := xFilial("MEB")
    cCode         := ""
    aArea         := GetArea()
    oModel        := Nil
    lGravouOK     := .F.
    lDadosOK      := .T.
    nLenMEBCODEIX := TamSx3("MEB_CODEIX")[1]
    nStatusCode   := 400 // HTTP 400 = Bad Request
    cMsg          := STR0016 //"Erro ao tentar deletar"

    oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

    // Obtém os dados enviados na requisição (Via Path Parameters)
    oJParametr  := oRest:getPathParamsRequest()

    // Obtém os parâmetros informados na requisição via URL (path param)
    If oJParametr:hasProperty('code')
        cCode := oJParametr['code']
    EndIf

    If Empty(cCode)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := EncodeUTF8(STR0012 + "'code'" + STR0015, "cp1252") //"Parâmetro " ### 'code' (código) ### " é obrigatório"
        lDadosOK := .F.
    EndIf

    If lDadosOK
        If Len(cCode) <> nLenMEBCODEIX
            oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := EncodeUTF8(STR0012 + "'code'" + STR0013 + cValToChar(nLenMEBCODEIX) + STR0014, "cp1252") //"Parâmetro " ### "'code'" + " deve ter " + cValToChar(nLenMEBCODEIX) + " caracteres."
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        dbSelectArea('MEB')
        MEB->(dbSetOrder(1)) //MEB_FILIAL+MEB_CODEIX
        
        lFound := MEB->(dbSeek(cBranch + PadR(cCode,nLenMEBCODEIX)))

        // ------------------------------------------
        // Se nao encontrou retorna erro 404
        // ------------------------------------------
        If !lFound
            oRest:setStatusCode(404)  // HTTP 404 = Not Found
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := EncodeUTF8(STR0008 + AllTrim(cCode) + STR0009, "cp1252") //"Registro " ### " não encontrado"
            lDadosOK := .F.
        EndIf

        If lDadosOK
            // ==========================================
            // Carrega o Model MVC para Delete
            // ==========================================
            oModel := FWLoadModel("LOJA6080")  // Carrega o modelo de dados
            oModel:SetOperation(MODEL_OPERATION_DELETE)  // Define operacao de EXCLUSAO
            oModel:Activate()  // Ativa o modelo
            If oModel:VldData()
                lGravouOK := oModel:CommitData()
            EndIf

            If lGravouOK
                nStatusCode := 200  // HTTP 200 = OK
                cMsg        := EncodeUTF8(STR0003 + AllTrim(cCode) + STR0007, "cp1252") //"Eixo " ### " deletado com sucesso"
            EndIf
            
            oRest:setStatusCode(nStatusCode)
            oJsonRespo['success'] := lGravouOK
            oJsonRespo['message'] := cMsg
            
            // ==========================================
            // Libera Recursos da Memoria
            // ==========================================
            oModel:DeActivate()     // Desativa o Model
            FwFreeObj(oModel)     // Libera objeto da memoria

        EndIf

    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    // ==========================================
    // Libera Recursos da Memoria
    // ==========================================
    FwFreeObj(oJsonRespo)
    FwFreeObj(oJParametr)

    RestArea(aArea)

Return .T.
