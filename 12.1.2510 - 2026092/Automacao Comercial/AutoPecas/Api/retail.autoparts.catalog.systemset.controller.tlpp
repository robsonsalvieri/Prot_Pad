#include "tlpp-core.th"
#include "totvs.ch"
#include "tlpp-rest.th"
#include "fwmvcdef.ch"
#include "retail.autoparts.catalog.systemset.controller.ch"

namespace totvs.protheus.retail.autoparts.catalog.systemset.controller

/*/{Protheus.doc} RetailAutopartsCatalogSystemSetController
    API relacionadas ao cadastro de Conjunto Sistema do catalogo de autopecas
    @type    class
    @author  Bruno Almeida
    @since   22/05/2026
/*/
Class RetailAutopartsCatalogSystemSetController

    private Method FindSystemSet(cDescription as Character) as Array
    private Method CountSystemSet() as Numeric
    private Method CountSystemSetPG(cCodCon as Character, cDescr as Character) as Numeric
    private Method FindPagedSystemSets(cCodCon as Character, cDescr as Character, nPage as Numeric, nPageSize as Numeric) as Array
    private Method FindGroupsBatch(aCodsConList as Array) as Object

    public Method New() as Object

    @Get("/api/retail/v1/retailAutopartsCatalogSystemSet/getDataForSystemSet", description="Consulta os conjuntos sistema do catalogo de auto pecas.")
    public Method getDataForSystemSet() as Logical

    @Get("/api/retail/v1/retailAutopartsCatalogSystemSet/productgroup", description="Consulta paginada de Conjuntos Sistema com Grupos de Produtos.")
    public Method getSystemSetProductGroup() as Logical

    @Get("/api/retail/v1/retailAutopartsCatalogSystemSet/getCountDataForSystemSet", description="Consulta a quantidade total de conjuntos sistema do catalogo de auto pecas.")
    public Method getCountDataForSystemSet() as Logical

    @Post("/api/retail/v1/retailAutopartsCatalogSystemSet/postDataForSystemSet", description="Cadastra um novo conjunto sistema para o catalogo de autopecas")
    public Method postDataForSystemSet() as Logical

    @Put("/api/retail/v1/retailAutopartsCatalogSystemSet/putDataForSystemSet", description="Altera um conjunto sistema existente no catalogo de autopecas")
    public Method putDataForSystemSet() as Logical

    @Delete("/api/retail/v1/retailAutopartsCatalogSystemSet/deleteDataForSystemSet/:code", description="Deleta um conjunto sistema do catalogo de autopecas")
    public Method deleteDataForSystemSet() as Logical

EndClass

/*/{Protheus.doc} New
    Metodo construtor
    @type   method
    @author Bruno Almeida
    @since  22/05/2026
    @return object, Objeto instanciado da classe RetailAutopartsCatalogSystemSetController
/*/
Method New() as Object Class RetailAutopartsCatalogSystemSetController
Return Self

/*/{Protheus.doc} getDataForSystemSet
    Retorna os conjuntos sistema do catalogo de auto pecas
    @type    method
    @author  Bruno Almeida
    @since   22/05/2026
    @version p12
    @return  logical, .T. indicando se a execucao foi bem sucedida
/*/
Method getDataForSystemSet() as Logical Class RetailAutopartsCatalogSystemSetController
    Local oJsonRespo    as Object
    Local oJParametr    as Object
    Local aItens        as Array
    Local cDescription  as Character

    oJsonRespo   := JsonObject():New()
    aItens       := {}
    cDescription := ""

    oJParametr := oRest:getQueryRequest()

    oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

    If oJParametr['description'] == Nil .Or. Empty(oJParametr['description'])
        cDescription := ""
    Else
        cDescription := oJParametr['description']
    EndIf

    aItens := Self:FindSystemSet(cDescription)

    If Len(aItens) > 0
        oJsonRespo["items"] := aItens
        oRest:setStatusCode(200)
    Else
        oJsonRespo["items"]   := {}
        oJsonRespo["message"] := EncodeUTF8(STR0001, "cp1252") //__"Dados não encontrados para o filtro informado"
        oRest:setStatusCode(404)
    EndIf

    oRest:setResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

Return .T.

/*/{Protheus.doc} getCountDataForSystemSet
    Retorna a quantidade total de conjuntos sistema validos do catalogo de auto pecas
    @type    method
    @author  eduardo.Flima
    @since   01/06/2026
    @version p12
    @return  logical, .T. indicando se a execucao foi bem sucedida
/*/
Method getCountDataForSystemSet() as Logical Class RetailAutopartsCatalogSystemSetController
    Local oJsonRespo    as Object
    Local nTotal        as Numeric

    oJsonRespo := JsonObject():New()
    nTotal     := 0

    oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

    nTotal := Self:CountSystemSet()

    oJsonRespo["total"] := nTotal
    oRest:setStatusCode(200)

    oRest:setResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)

Return .T.

/*/{Protheus.doc} postDataForSystemSet
    Cadastro de conjunto sistema do catalogo de auto pecas
    @type    method
    @author  Bruno Almeida
    @since   22/05/2026
    @version p12
    @return  logical, .T. indicando se a execucao foi bem sucedida
/*/
Method postDataForSystemSet() as Logical Class RetailAutopartsCatalogSystemSetController
    Local oJsBody       as Object
    Local oJsonRespo    as Object
    Local oModel        as Object
    Local oModelMI2     as Object
    Local cDescription  as Character
    Local cJsonUtf8     as Character
    Local cJsonCP1252   as Character
    Local lGravouOK     as Logical
    Local aErros        as Array

    oJsonRespo  := JsonObject():New()
    oJsBody     := JsonObject():New()
    oModel      := Nil
    oModelMI2   := Nil
    cDescription := ""
    cJsonUtf8   := ""
    cJsonCP1252 := ""
    lGravouOK   := .F.
    aErros      := {}

    cJsonUtf8   := oRest:GetBodyRequest()
    cJsonCP1252 := DecodeUTF8(cJsonUtf8, "cp1252")
    oJsBody:fromJson(cJsonCP1252)

    oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

    If oJsBody['description'] == Nil .Or. Empty(oJsBody['description'])
        cDescription := ""
    Else
        cDescription := oJsBody['description']
    EndIf

    oModel := FWLoadModel("LOJA660")
    oModel:SetOperation(MODEL_OPERATION_INSERT)
    oModel:Activate()

    oModelMI2 := oModel:GetModel("MI2MASTER")

    oModelMI2:SetValue("MI2_DESCRI", Upper(cDescription))

    If oModel:VldData()
        lGravouOK := oModel:CommitData()
    EndIf

    If lGravouOK
        oRest:setStatusCode(201)
        oJsonRespo["success"] := .T.
        oJsonRespo["message"] := EncodeUTF8(STR0002 + AllTrim(Upper(cDescription)) + STR0003, "cp1252") //"Conjunto Sistema " # " cadastrado com sucesso"
    Else
        oRest:setStatusCode(400)
        aErros := oModel:GetErrorMessage()

        oJsonRespo["success"] := .F.
        oJsonRespo["message"] := EncodeUTF8(IIF(Len(aErros) >= 6, aErros[6], STR0004), "cp1252") //"Erro ao cadastrar"
    EndIf

    oRest:SetResponse(oJsonRespo:toJson())

    oModelMI2:DeActivate()
    oModel:DeActivate()

    oModelMI2:Destroy()
    oModel:Destroy()

    FreeObj(oJsonRespo)
    FreeObj(oJsBody)

Return .T.

/*/{Protheus.doc} putDataForSystemSet
    Altera o conjunto sistema do catalogo de auto pecas
    @type    method
    @author  Bruno Almeida
    @since   22/05/2026
    @version p12
    @return  logical, .T. indicando se a execucao foi bem sucedida
/*/
Method putDataForSystemSet() as Logical Class RetailAutopartsCatalogSystemSetController
    Local oJsonRespo    as Object
    Local oJsBody       as Object
    Local oModel        as Object
    Local oModelMI2     as Object
    Local lGravouOK     as Logical
    Local lContinua     as Logical
    Local cCode         as Character
    Local cDescription  as Character
    Local cJsonUtf8     as Character
    Local cJsonCP1252   as Character
    Local aArea         as Array
    Local aErros        as Array

    oJsonRespo   := JsonObject():New()
    oJsBody      := JsonObject():New()
    oModel       := Nil
    oModelMI2    := Nil
    lGravouOK    := .F.
    lContinua    := .T.
    cCode        := ""
    cDescription := ""
    cJsonUtf8    := ""
    cJsonCP1252  := ""
    aArea        := {}
    aErros       := {}

    cJsonUtf8   := oRest:GetBodyRequest()
    cJsonCP1252 := DecodeUTF8(cJsonUtf8, "cp1252")
    oJsBody:fromJson(cJsonCP1252)

    oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

    If oJsBody['code'] == Nil .Or. Empty(oJsBody['code'])
        cCode := ""
    Else
        cCode := oJsBody['code']
    EndIf

    If oJsBody['description'] == Nil .Or. Empty(oJsBody['description'])
        cDescription := ""
    Else
        cDescription := oJsBody['description']
    EndIf

    If Empty(cCode)
        oRest:setStatusCode(422)
        oJsonRespo["success"] := .F.
        oJsonRespo["message"] := EncodeUTF8(STR0005, "cp1252") //"Parâmetro 'code' e obrigatorio"
        lContinua := .F.
    EndIf

    If lContinua
        aArea := GetArea()
        dbSelectArea('MI2')
        MI2->(dbSetOrder(1)) //MI2_FILIAL+MI2_CODCON

        If !MI2->(dbSeek(xFilial("MI2") + PadR(cCode, TamSx3("MI2_CODCON")[1])))
            oRest:setStatusCode(404)
            oJsonRespo["success"] := .F.
            oJsonRespo["message"] := EncodeUTF8(STR0008 + AllTrim(cCode) + STR0009, "cp1252") //"Registro " # " não encontrado"
            lContinua := .F.
        EndIf

        If lContinua
            oModel := FWLoadModel("LOJA660")
            oModel:SetOperation(MODEL_OPERATION_UPDATE)
            oModel:Activate()

            oModelMI2 := oModel:GetModel("MI2MASTER")

            oModelMI2:SetValue("MI2_DESCRI", Upper(cDescription))

            If oModel:VldData()
                lGravouOK := oModel:CommitData()
            EndIf

            If lGravouOK
                oRest:setStatusCode(200)
                oJsonRespo["success"] := .T.
                oJsonRespo["message"] := EncodeUTF8(STR0002 + AllTrim(Upper(cDescription)) + STR0006, "cp1252") //"Conjunto Sistema " # " atualizado com sucesso"
            Else
                oRest:setStatusCode(400)
                aErros := oModel:GetErrorMessage()

                oJsonRespo["success"] := .F.
                oJsonRespo["message"] := EncodeUTF8(IIF(Len(aErros) >= 6, aErros[6], STR0007), "cp1252") //"Erro ao atualizar"
            EndIf

            oModelMI2:DeActivate()
            oModel:DeActivate()

            oModelMI2:Destroy()
            oModel:Destroy()
        EndIf

        RestArea(aArea)
    EndIf

    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJsBody)

Return .T.

/*/{Protheus.doc} deleteDataForSystemSet
    Deleta o conjunto sistema do catalogo de auto pecas
    @type    method
    @author  Bruno Almeida
    @since   22/05/2026
    @version p12
    @return  logical, .T. indicando se a execucao foi bem sucedida
/*/
Method deleteDataForSystemSet() as Logical Class RetailAutopartsCatalogSystemSetController
    Local oJsonRespo    as Object
    Local oJParametr    as Object
    Local oModel        as Object
    Local lGravouOK     as Logical
    Local lContinua     as Logical
    Local cCode         as Character
    Local aArea         as Array
    Local aErros        as Array

    oJsonRespo  := JsonObject():New()
    oModel      := Nil
    lGravouOK   := .F.
    lContinua   := .T.
    cCode       := ""
    aArea       := {}
    aErros      := {}

    oJParametr := oRest:getPathParamsRequest()

    oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

    cCode := oJParametr['code']

    aArea := GetArea()
    dbSelectArea('MI2')
    MI2->(dbSetOrder(1)) //MI2_FILIAL+MI2_CODCON

    If !MI2->(dbSeek(xFilial("MI2") + PadR(cCode, TamSx3("MI2_CODCON")[1])))
        oRest:setStatusCode(404)
        oJsonRespo["success"] := .F.
        oJsonRespo["message"] := EncodeUTF8(STR0008 + AllTrim(cCode) + STR0009, "cp1252") //"Registro " # " não encontrado"
        lContinua := .F.
    EndIf

    If lContinua
        oModel := FWLoadModel("LOJA660")
        oModel:SetOperation(MODEL_OPERATION_DELETE)
        oModel:Activate()

        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        EndIf

        If lGravouOK
            oRest:setStatusCode(200)
            oJsonRespo["success"] := .T.
            oJsonRespo["message"] := EncodeUTF8(STR0002 + AllTrim(cCode) + STR0010, "cp1252") //"Conjunto Sistema " # " deletado com sucesso"
        EndIf

        oModel:DeActivate()
        oModel:Destroy()
    EndIf

    RestArea(aArea)

    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

Return .T.

/*/{Protheus.doc} FindSystemSet
    Consulta conjuntos sistema do catalogo de auto pecas
    @type    method
    @author  Bruno Almeida
    @since   22/05/2026
    @version p12
    @param   cDescription , Character , filtro pela descricao do conjunto sistema
    @return  aItens       , Array     , array de itens encontrados
/*/
Method FindSystemSet(cDescription as Character) as Array Class RetailAutopartsCatalogSystemSetController
    Local oQueryQry     as Object
    Local jItem         as Object
    Local aItens        as Array
    Local cQry          as Character
    Local cAliasQry     as Character
    Local nSeq          as Numeric
    Local aArea         as Array

    Default cDescription := ""

    oQueryQry   := Nil
    jItem       := Nil
    nSeq        := 1
    aItens      := {}
    aArea       := GetArea()

    dbSelectArea("MI2")

    cQry := " SELECT MI2.MI2_FILIAL, MI2.MI2_CODCON, MI2.MI2_DESCRI "
    cQry += " FROM " + RetSqlName("MI2") + " MI2 "
    cQry += " WHERE "
    cQry += " MI2.MI2_FILIAL = ? "

    If !Empty(cDescription)
        cQry += " AND MI2.MI2_DESCRI LIKE ? "
    EndIf

    cQry += " AND MI2.D_E_L_E_T_ = ? "
    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)

    oQueryQry:SetString(nSeq++, xFilial("MI2"))

    If !Empty(cDescription)
        oQueryQry:SetString(nSeq++, "%" + Upper(cDescription) + "%")
    EndIf

    oQueryQry:SetString(nSeq++, Space(1))

    cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

    While (cAliasQry)->(!EOF())
        jItem := JsonObject():New()
        jItem["branch"]      := EncodeUTF8(AllTrim((cAliasQry)->MI2_FILIAL), "cp1252")
        jItem["code"]        := EncodeUTF8(AllTrim((cAliasQry)->MI2_CODCON), "cp1252")
        jItem["description"] := EncodeUTF8(AllTrim((cAliasQry)->MI2_DESCRI), "cp1252")
        aAdd(aItens, jItem)
        jItem := Nil
        (cAliasQry)->(dbSkip())
    EndDo

    (cAliasQry)->(dbCloseArea())

    RestArea(aArea)

    oQueryQry:Destroy()

Return(aItens)

/*/{Protheus.doc} CountSystemSet
    Consulta a quantidade total de conjuntos sistema validos
    @type    method
    @author  eduardo.Flima
    @since   01/06/2026
    @version p12
    @return  nTotal      , Numeric   , quantidade total de registros validos
/*/
Method CountSystemSet() as Numeric Class RetailAutopartsCatalogSystemSetController
    Local oQueryQry     as Object
    Local cQry          as Character
    Local nSeq          as Numeric
    Local nTotal        as Numeric
    Local aArea         as Array

    oQueryQry   := Nil
    nSeq        := 1
    nTotal      := 0
    aArea       := GetArea()


    cQry := " SELECT COUNT(1) AS TOTAL "
    cQry += " FROM " + RetSqlName("MI2") + " MI2 "
    cQry += " WHERE "
    cQry += " MI2.MI2_FILIAL = ? "
    cQry += " AND MI2.D_E_L_E_T_ = ? "
    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)

    oQueryQry:SetString(nSeq++, xFilial("MI2"))
    oQueryQry:SetString(nSeq++, Space(1))
    nTotal := Val(cValToChar(oQueryQry:ExecScalar('TOTAL')))//ExecScalar retorna xValue (variant); se o banco retornar Nil (query sem resultado ou erro), a atribuição a nTotal as Numeric pode causar comportamento indefinido na serialização JSON

    RestArea(aArea)

    oQueryQry:Destroy()

Return nTotal

/*/{Protheus.doc} getSystemSetProductGroup
    Retorna listagem paginada de Conjuntos Sistema com seus Grupos de Produtos
    @type    method
    @author  eduardo.Flima
    @since   06/08/2026
    @version p12
    @return  logical, .T. indicando se a execucao foi bem sucedida
/*/
Method getSystemSetProductGroup() as Logical Class RetailAutopartsCatalogSystemSetController
    Local oJsonRespo    as Object
    Local oJParametr    as Object
    Local aSets         as Array
    Local cCodCon       as Character
    Local cDescr        as Character
    Local nPage         as Numeric
    Local nPageSize     as Numeric
    Local nTotal        as Numeric
    Local nTotPages     as Numeric
    Local lHasNext      as Logical

    oJsonRespo  := JsonObject():New()
    aSets       := {}
    cCodCon     := ""
    cDescr      := ""
    nPage       := 1
    nPageSize   := 20
    nTotal      := 0
    nTotPages   := 0
    lHasNext    := .F.

    oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

    oJParametr := oRest:getQueryRequest()

    If oJParametr['codcon'] != Nil .And. !Empty(oJParametr['codcon'])
        cCodCon := AllTrim(oJParametr['codcon'])
    EndIf
    If oJParametr['description'] != Nil .And. !Empty(oJParametr['description'])
        cDescr := AllTrim(oJParametr['description'])
    EndIf
    If oJParametr['page'] != Nil .And. Val(oJParametr['page']) > 0
        nPage := Val(oJParametr['page'])
    EndIf
    If oJParametr['pagesize'] != Nil .And. Val(oJParametr['pagesize']) > 0
        nPageSize := Val(oJParametr['pagesize'])
    EndIf


    nTotal    := Self:CountSystemSetPG(cCodCon, cDescr)
    nTotPages := IIF(nTotal > 0, Int((nTotal + nPageSize - 1) / nPageSize), 0)

    If !(nTotal > 0 .And. nPage > nTotPages)
        lHasNext := (nPage * nPageSize) < nTotal
        aSets    := Self:FindPagedSystemSets(cCodCon, cDescr, nPage, nPageSize)
    EndIf

    if empty(aSets)
        oJsonRespo["items"]   := {}
        oJsonRespo["message"] := EncodeUTF8(STR0001, "cp1252") //"Dados não encontrados para o filtro informado"
        oRest:setStatusCode(404)
    Else
        oJsonRespo["items"]                          := aSets
        oJsonRespo["pagination"]                     := JsonObject():New()
        oJsonRespo["pagination"]["page"]             := nPage
        oJsonRespo["pagination"]["pagesize"]         := nPageSize
        oJsonRespo["pagination"]["totalitems"]       := nTotal
        oJsonRespo["pagination"]["totalpages"]       := nTotPages
        oJsonRespo["pagination"]["nextpage"]         := lHasNext
        oJsonRespo["pagination"]["previouspage"]     := nPage > 1
        oRest:setStatusCode(200)
    Endif 

    oRest:setResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

Return .T.

/*/{Protheus.doc} CountSystemSetPG
    Conta o total de Conjuntos Sistema que atendem aos filtros, sem JOIN
    @type    method
    @author  eduardo.Flima
    @since   06/08/2026
    @version p12
    @param   cCodCon , Character , filtro por codigo exato do conjunto (MI2_CODCON)
    @param   cDescr  , Character , filtro parcial pela descricao do conjunto (MI2_DESCRI)
    @return  nTotal  , Numeric   , quantidade de conjuntos distintos encontrados
/*/
Method CountSystemSetPG(cCodCon as Character, cDescr as Character) as Numeric Class RetailAutopartsCatalogSystemSetController
    Local oQueryQry as Object
    Local cQry      as Character
    Local nSeq      as Numeric
    Local nTotal    as Numeric
    Local aArea     as Array

    Default cCodCon := ""
    Default cDescr  := ""

    oQueryQry := Nil
    nSeq      := 1
    nTotal    := 0
    aArea     := GetArea()

    cQry := " SELECT COUNT(1) AS TOTAL "
    cQry += " FROM " + RetSqlName("MI2") + " MI2 "
    cQry += " WHERE MI2.MI2_FILIAL = ? "
    If !Empty(cCodCon)
        cQry += " AND MI2.MI2_CODCON = ? "
    EndIf
    If !Empty(cDescr)
        cQry += " AND UPPER(MI2.MI2_DESCRI) LIKE ? "
    EndIf
    cQry += " AND MI2.D_E_L_E_T_ = ? "
    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)
    oQueryQry:SetString(nSeq++, xFilial("MI2"))
    If !Empty(cCodCon)
        oQueryQry:SetString(nSeq++, PadR(cCodCon, TamSx3("MI2_CODCON")[1]))
    EndIf
    If !Empty(cDescr)
        oQueryQry:SetString(nSeq++, "%" + Upper(cDescr) + "%")
    EndIf
    oQueryQry:SetString(nSeq++, Space(1))

    nTotal := Val(cValToChar(oQueryQry:ExecScalar("TOTAL")))

    RestArea(aArea)
    oQueryQry:Destroy()

Return nTotal

/*/{Protheus.doc} FindPagedSystemSets
    Retorna a pagina de Conjuntos Sistema com seus Grupos de Produtos aninhados
    @type    method
    @author  eduardo.Flima
    @since   06/08/2026
    @version p12
    @param   cCodCon   , Character , filtro por codigo exato do conjunto (MI2_CODCON)
    @param   cDescr    , Character , filtro parcial pela descricao do conjunto (MI2_DESCRI)
    @param   nPage     , Numeric   , numero da pagina (default 1)
    @param   nPageSize , Numeric   , tamanho da pagina (default 20)
    @return  aItens    , Array     , array de JsonObjects com conjuntos e grupos aninhados
/*/
Method FindPagedSystemSets(cCodCon as Character, cDescr as Character, nPage as Numeric, nPageSize as Numeric) as Array Class RetailAutopartsCatalogSystemSetController
    Local oQueryQry    as Object
    Local jItem        as Object
    Local oGrupoDict   as Object
    Local aItens       as Array
    Local aCodsConList as Array
    Local cQry         as Character
    Local cAliasQry    as Character
    Local nSeq         as Numeric
    Local nRowStart    as Numeric
    Local nRowEnd      as Numeric
    Local nIdx         as Numeric
    Local cCodCurr     as Character
    Local aArea        as Array

    Default cCodCon   := ""
    Default cDescr    := ""
    Default nPage     := 1
    Default nPageSize := 20

    oQueryQry    := Nil
    oGrupoDict   := Nil
    nSeq         := 1
    nRowStart    := (nPage - 1) * nPageSize + 1
    nRowEnd      := nPage * nPageSize
    aItens       := {}
    aCodsConList := {}
    aArea        := GetArea()


    // PERF-002: ROW_NUMBER() para paginacao server-side, eliminando cursor O(n) via dbSkip
    cQry := " SELECT sub.MI2_CODCON, sub.MI2_DESCRI "
    cQry += " FROM ( "
    cQry += "   SELECT MI2.MI2_CODCON, MI2.MI2_DESCRI, "
    cQry += "          ROW_NUMBER() OVER (ORDER BY MI2.MI2_CODCON) AS RN "
    cQry += "   FROM " + RetSqlName("MI2") + " MI2 "
    cQry += "   WHERE MI2.MI2_FILIAL = ? "
    If !Empty(cCodCon)
        cQry += "   AND MI2.MI2_CODCON = ? "
    EndIf
    If !Empty(cDescr)
        cQry += "   AND UPPER(MI2.MI2_DESCRI) LIKE ? "
    EndIf
    cQry += "   AND MI2.D_E_L_E_T_ = ? "
    cQry += " ) sub "
    cQry += " WHERE sub.RN BETWEEN ? AND ? "
    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)
    oQueryQry:SetString(nSeq++, xFilial("MI2"))
    If !Empty(cCodCon)
        oQueryQry:SetString(nSeq++, PadR(cCodCon, TamSx3("MI2_CODCON")[1]))
    EndIf
    If !Empty(cDescr)
        oQueryQry:SetString(nSeq++, "%" + Upper(cDescr) + "%")
    EndIf
    oQueryQry:SetString(nSeq++, Space(1))
    oQueryQry:SetNumeric(nSeq++, nRowStart)
    oQueryQry:SetNumeric(nSeq++, nRowEnd)

    cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

    // Primeira passagem: coleta os dados da pagina sem disparar queries filhas
    While (cAliasQry)->(!EOF())
        jItem := JsonObject():New()
        jItem["codcon"] := EncodeUTF8(AllTrim((cAliasQry)->MI2_CODCON), "cp1252")
        jItem["description"] := EncodeUTF8(AllTrim((cAliasQry)->MI2_DESCRI), "cp1252")
        aAdd(aItens, jItem)
        aAdd(aCodsConList, AllTrim((cAliasQry)->MI2_CODCON))
        jItem := Nil
        (cAliasQry)->(dbSkip())
    EndDo

    (cAliasQry)->(dbCloseArea())
    oQueryQry:Destroy()

    // PERF-001: busca grupos de todos os conjuntos da pagina em uma unica query batch
    If Len(aCodsConList) > 0
        oGrupoDict := Self:FindGroupsBatch(aCodsConList)

        For nIdx := 1 To Len(aItens)
            cCodCurr := aItens[nIdx]["codcon"]
            If oGrupoDict[cCodCurr] != Nil
                aItens[nIdx]["productGroups"] := oGrupoDict[cCodCurr]
            Else
                aItens[nIdx]["productGroups"] := {}
            EndIf
        Next
        If oGrupoDict != Nil
            FreeObj(oGrupoDict)
        EndIf
    EndIf

    RestArea(aArea)

Return(aItens)


/*/{Protheus.doc} FindGroupsBatch
    Retorna em uma unica query os Grupos de Produtos de todos os Conjuntos Sistema da pagina
    @type    method
    @author  eduardo.Flima
    @since   07/08/2026
    @version p12
    @param   aCodsConList , Array  , array de codigos MI2_CODCON (trimados) da pagina corrente
    @return  oGrupoDict   , Object , JsonObject chave=MI2_CODCON valor=array de grupos (codgru+descGru)
/*/
Method FindGroupsBatch(aCodsConList as Array) as Object Class RetailAutopartsCatalogSystemSetController
    Local oQueryQry   as Object
    Local jGrp        as Object
    Local oGrupoDict  as Object
    Local cQry        as Character
    Local cInParams   as Character
    Local cAliasQry   as Character
    Local cCodAtual   as Character
    Local nSeq        as Numeric
    Local nIdx        as Numeric
    Local aArea       as Array
    Local nTamCodCon  as Numeric

    Default aCodsConList := {}

    oQueryQry  := Nil
    oGrupoDict := JsonObject():New()
    nSeq       := 1
    cInParams  := ""
    aArea      := GetArea()

    If Len(aCodsConList) > 0

        For nIdx := 1 To Len(aCodsConList)
            If nIdx > 1
                cInParams += ", "
            EndIf
            cInParams += "?"
        Next

        cQry := " SELECT MI4.MI4_CODCON, SBM.BM_GRUPO, SBM.BM_DESC "
        cQry += " FROM " + RetSqlName("MI4") + " MI4 "
        cQry += " LEFT JOIN " + RetSqlName("SBM") + " SBM "
        cQry += "   ON SBM.BM_FILIAL = ? AND SBM.BM_GRUPO = MI4.MI4_CODGRU AND SBM.D_E_L_E_T_ = ? "
        cQry += " WHERE MI4.MI4_FILIAL = ? "
        cQry += " AND MI4.MI4_CODCON IN (" + cInParams + ") "
        cQry += " AND MI4.D_E_L_E_T_ = ? "
        cQry += " ORDER BY MI4.MI4_CODCON, MI4.MI4_CODGRU "
        cQry := ChangeQuery(cQry)

        oQueryQry := FwExecStatement():New(cQry)
        oQueryQry:SetString(nSeq++, xFilial("SBM"))
        oQueryQry:SetString(nSeq++, Space(1))
        oQueryQry:SetString(nSeq++, xFilial("MI4"))
        
        nTamCodCon := TamSx3("MI4_CODCON")[1]
        For nIdx := 1 To Len(aCodsConList)
            oQueryQry:SetString(nSeq++, PadR(aCodsConList[nIdx], nTamCodCon))
        Next

        oQueryQry:SetString(nSeq++, Space(1))

        cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

        While (cAliasQry)->(!EOF())
            cCodAtual := AllTrim((cAliasQry)->MI4_CODCON)
            If oGrupoDict[cCodAtual] == Nil
                oGrupoDict[cCodAtual] := {}
            EndIf
            jGrp := JsonObject():New()
            jGrp["codgru"]  := EncodeUTF8(AllTrim((cAliasQry)->BM_GRUPO), "cp1252")
            jGrp["descriptionGroup"] := EncodeUTF8(AllTrim((cAliasQry)->BM_DESC), "cp1252")
            aAdd(oGrupoDict[cCodAtual], jGrp)
            jGrp := Nil
            
            (cAliasQry)->(dbSkip())
        EndDo

        (cAliasQry)->(dbCloseArea())
        RestArea(aArea)
        oQueryQry:Destroy()
    EndIf


Return(oGrupoDict)
