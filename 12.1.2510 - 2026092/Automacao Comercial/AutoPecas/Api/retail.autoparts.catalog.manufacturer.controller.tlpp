#include 'PROTHEUS.CH'
#include 'tlpp-core.th'
#include 'tlpp-rest.th'
#include 'FWMVCDEF.CH'
#include "retail.autoparts.catalog.manufacturer.controller.ch"

namespace totvs.protheus.retail.autoparts.catalog.manufacturer.controller
using namespace totvs.protheus.retail.autoparts.catalog.manufacturer.service

/*/{Protheus.doc} RetailAutopartsCatalogManufacturerController
API relacionadas a montadoras do catalogo de autopecas
@author Bruno Almeida
@since  13/04/2026   
/*/
Class RetailAutopartsCatalogManufacturerController
    
    private Method FindManufacturer(cName as Character) as Array

    public Method New()

    @Get("/api/retail/v1/retailAutopartsCatalogManufacturer/getDataForManufacturer", description="Consulta as montadoras do catalogo de auto peças.")
    public Method getDataForManufacturer()

    @Post("/api/retail/v1/retailAutopartsCatalogManufacturer/postDataForManufacturer", description="Cadastra uma nova montadora para o catalogo de autopecas")
    public Method postDataForManufacturer()

    @Put("/api/retail/v1/retailAutopartsCatalogManufacturer/putDataForManufacturer", description="Altera uma montadora existente no catalogo de autopecas")
    public Method putDataForManufacturer()

    @Delete("/api/retail/v1/retailAutopartsCatalogManufacturer/deleteDataForManufacturer/:codigo", description="Deleta uma montadora do catalogo de autopecas")
    public Method deleteDataForManufacturer()
    
EndClass


/*/{Protheus.doc} New
Metodo construtor
@author Bruno Almeida
@since  13/04/2026
/*/
Method New() Class RetailAutopartsCatalogManufacturerController
Return Self

/*/{Protheus.doc} getDataForManufacturer
    Retorna as montadoras do catalogo de auto peças
    @author  Bruno Almeida
    @since   13/04/2026
    @version p12
/*/
Method getDataForManufacturer() Class RetailAutopartsCatalogManufacturerController
    Local oJsonRespo    as Object
    Local oJParametr    as Object
    Local aItens        as Array                  
    Local cName   := ""

    oJsonRespo      := JsonObject():New()    
    oJParametr      := JsonObject():New()  
    aItens          := {}                 
    cName           := ""
    oJParametr      := oRest:getQueryRequest()
    
    //Obtém os filtros enviados na URL (se existirem)
    cName   := iif(oJParametr['nome'] == Nil .Or. Empty(oJParametr['nome']), "", DecodeUTF8(oJParametr['nome'], "cp1252"))
    aItens  := Self:FindManufacturer(cName)
    
    If Len(aItens) > 0
        oJsonRespo["Itens"] := aItens
        oRest:setStatusCode(200)
    Else
        oJsonRespo["Itens"]    := {}
        oJsonRespo["mensagem"] := EncodeUTF8(STR0005, "cp1252") //"Dados não encontrados para o filtro informado"
        oRest:setStatusCode(404)
    EndIf

    oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")
    oRest:setResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

Return .T.

/*/{Protheus.doc} postDataForManufacturer
    Cadastro de montadora do catalogo de auto peças
    @author  Bruno Almeida
    @since   13/04/2026
    @version p12
/*/
Method postDataForManufacturer()  Class RetailAutopartsCatalogManufacturerController
    Local oJsBody       AS Object
    Local oJsonRespo    AS Object
    Local oModel        AS Object
    Local oModelME0     AS Object    
    Local cName         AS Character
    Local lGravouOK     AS Logical
    Local aErros        AS Array
    
    oJsonRespo      := JsonObject():New()   
    oModel          := Nil                  
    oModelME0       := Nil                  
    lGravouOK       := .F.
    aErros          := {}
    oJsBody         := JsonObject():New() 

    oJsBody:fromJson( DecodeUTF8(oRest:GetBodyRequest(), "cp1252"))

    cName := iif(oJsBody['nome'] == Nil .Or. Empty(oJsBody['nome']), "", oJsBody['nome'])    
      
    //Carrega o Model MVC
    oModel := FWLoadModel("LOJA630")
    oModel:SetOperation(MODEL_OPERATION_INSERT)
    oModel:Activate()
    
    oModelME0 := oModel:GetModel("ME0MASTER")

    oModelME0:SetValue("ME0_NOME", upper(cName))
    
    If oModel:VldData()
        lGravouOK := oModel:CommitData()        
    Else
        //Validação falhou
        lGravouOK := .F.
    EndIf
   
    If lGravouOK

        oRest:setStatusCode(201)
        oJsonRespo['sucesso']   := .T.
        oJsonRespo['mensagem']  := EncodeUTF8(STR0006 + ME0->ME0_CODMON + STR0007, "cp1252") //"Montadora " # " cadastrada com sucesso"
        oJsonRespo['filial']    := EncodeUTF8(AllTrim(ME0->ME0_FILIAL), "cp1252")
        oJsonRespo['codigo']    := ME0->ME0_CODMON
        oJsonRespo['nome']      := EncodeUTF8(AllTrim(ME0->ME0_NOME), "cp1252")
        
    Else
        oRest:setStatusCode(400)
        aErros := oModel:GetErrorMessage()
        
        oJsonRespo['sucesso']  := .F.
        oJsonRespo['mensagem'] := EncodeUTF8(IIf(Len(aErros) >= 6, aErros[6], STR0008), "cp1252") //"Erro ao cadastrar"
                
    EndIf
    
    oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")
    oRest:SetResponse(oJsonRespo:toJson())
    
    oModelME0:DeActivate()
    oModel:DeActivate()
    
    FreeObj(oModelME0)
    FreeObj(oModel)
    FreeObj(oJsonRespo)
    FreeObj(oJsBody)

Return .T.


/*/{Protheus.doc} putDataForManufacturer
    Altera a montadora do catlogo de auto peças
    @author  Bruno Almeida
    @since   13/04/2026
    @version p12
/*/
method putDataForManufacturer()  Class RetailAutopartsCatalogManufacturerController
    Local oJsonRespo    AS Object
    Local oJsBody       AS Object
    Local lFound        AS Logical    
    Local cCode         AS Character
    Local cName         AS Character
    Local aArea         AS Array            
    Local oModel        AS Object
    Local oModelME0     AS Object
    Local lGravouOK     AS Logical
    Local aErros        AS Array
    Local lContinua     AS Logical

    oJsonRespo  := JsonObject():New() 
    cCode       := ""
    cName       := ""
    lFound      := .F.
    aArea       := {}
    oJsBody     := JsonObject():New()     
    oModel      := Nil
    oModelME0   := Nil
    lGravouOK   := .F.
    aErros      := {}
    lContinua   := .T.

    oJsBody:fromJson( DecodeUTF8(oRest:GetBodyRequest(), "cp1252"))

    cCode := iif(oJsBody['codigo'] == Nil .Or. Empty(oJsBody['codigo']), "", oJsBody['codigo'])
    cName := iif(oJsBody['nome'] == Nil .Or. Empty(oJsBody['nome']), "", oJsBody['nome'])

    If Empty(cCode)
        oRest:setStatusCode(422)
        oJsonRespo['sucesso']  := .F.
        oJsonRespo['mensagem'] := EncodeUTF8(STR0009, "cp1252") //"Parâmetro 'codigo' é obrigatório"
        lContinua := .F.
    EndIf

    If lContinua
        aArea := GetArea()
        dbSelectArea('ME0')
        dbSetOrder(1)  //ME0_FILIAL+ME0_CODMON                                                                                                                                           
        
        lFound := ME0->(dbSeek(xFilial("ME0") + padR(cCode, tamSx3("ME0_CODMON")[1])))
        
        // Se não encontrou retorna erro 404
        If !lFound
            oRest:setStatusCode(404)
            oJsonRespo['sucesso']  := .F.
            oJsonRespo['mensagem'] := EncodeUTF8(STR0010 + AllTrim(cCode) + STR0011, "cp1252") //"Registro " # " não encontrado"
            lContinua := .F.
            RestArea(aArea)
        EndIf
        
        If lContinua
            oModel := FWLoadModel("LOJA630")
            oModel:SetOperation(MODEL_OPERATION_UPDATE)
            oModel:Activate()
            
            oModelME0 := oModel:GetModel("ME0MASTER")
            oModelME0:SetValue("ME0_NOME", upper(cName))
            
            If oModel:VldData()
                lGravouOK := oModel:CommitData()               
            Else
                lGravouOK := .F.
            EndIf
            
            If lGravouOK
                oRest:setStatusCode(200)
                oJsonRespo['sucesso']  := .T.
                oJsonRespo['mensagem'] := EncodeUTF8(STR0006 + AllTrim(cCode) + STR0012, "cp1252") //"Montadora " # " atualizada com sucesso"
                oJsonRespo['filial']   := EncodeUTF8(AllTrim(ME0->ME0_FILIAL), "cp1252")
                oJsonRespo['codigo']   := ME0->ME0_CODMON
                oJsonRespo['nome']     := EncodeUTF8(AllTrim(ME0->ME0_NOME), "cp1252")
                
            Else
                oRest:setStatusCode(400)
                aErros := oModel:GetErrorMessage()
                
                oJsonRespo['sucesso']  := .F.
                oJsonRespo['mensagem'] := EncodeUTF8(iif(Len(aErros) >= 6, aErros[6], STR0013), "cp1252") //"Erro ao atualizar"
                oJsonRespo['solucao']  := EncodeUTF8(iif(Len(aErros) >= 7 .And. !Empty(aErros[7]), aErros[7], ""), "cp1252")
                oJsonRespo['campo']    := EncodeUTF8(iif(Len(aErros) >= 4 .And. !Empty(aErros[4]), aErros[4], ""), "cp1252")       
            EndIf

            oModelME0:DeActivate()
            oModel:DeActivate()
            
            FreeObj(oModelME0)  
            FreeObj(oModel)

        EndIf

    EndIf
    
    oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")
    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJsBody)
        
    RestArea(aArea)
    
Return .T.

/*/{Protheus.doc} deleteDataForManufacturer
    Deleta a montadora do catlogo de auto peças
    @author  Bruno Almeida
    @since   13/04/2026
    @version p12
/*/
Method deleteDataForManufacturer()  Class retailAutopartsCatalogManufacturerController
    Local oJsonRespo    AS Object
    Local oJParametr    AS Object
    Local lFound        AS Logical    
    Local cCode         AS Character
    Local aArea         AS Array
    Local oModel        AS Object
    Local lGravouOK     AS Logical
    Local aErros        AS Array
    Local lContinua     AS Logical

    oJsonRespo  := JsonObject():New() 
    oJParametr  := JsonObject():New()  
    cCode       := ""
    lFound      := .F.
    aArea       := {}   
    oJParametr  := oRest:getPathParamsRequest()
    oModel      := Nil
    lGravouOK   := .F.
    aErros      := {}
    cCode       := iif (oJParametr['codigo'] == Nil .Or. Empty(oJParametr['codigo']), "", oJParametr['codigo'])
    lContinua   := .T.

    aArea    := GetArea()
    dbSelectArea('ME0')
    dbSetOrder(1)  //ME0_FILIAL+ME0_CODMOD                                                                                                                                           
    
    lFound := ME0->(dbSeek(xFilial("ME0") + padR(cCode, tamSx3("ME0_CODMON")[1])))

    // Se não encontrou retorna erro 404
    If !lFound
        oRest:setStatusCode(404)
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := EncodeUTF8(STR0010 + AllTrim(cCode) + STR0011, "cp1252") //"Registro " # " não encontrado "
        lContinua := .F.
        RestArea(aArea)
    EndIf

    If lContinua 
        oModel := FWLoadModel("LOJA630")
        oModel:SetOperation(MODEL_OPERATION_DELETE)
        oModel:Activate()

        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        EndIf		

        If lGravouOK
            oRest:setStatusCode(200)
            oJsonRespo['sucesso'] := .T.
            oJsonRespo['mensagem'] := EncodeUTF8(STR0006 + AllTrim(cCode) + STR0014, "cp1252") //"Montadora " # " deletada com sucesso"
        EndIf
        
        oModel:DeActivate()
        FreeObj(oModel)
    EndIf
    
    oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")
    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)
       
    RestArea(aArea)

Return .T.

/*/{Protheus.doc} FindManufacturer
    Consulta montadora do catlogo de auto peças
    @author  Bruno Almeida
    @since   13/04/2026
    @version p12
    @param   cName   , Character , nome do filtro
    @return  aItens  , Array     , array de itens encontrados
    /*/
Method FindManufacturer(cName as Character) as Array Class RetailAutopartsCatalogManufacturerController
    Local oQueryQry		as Object
    Local jItem         as Object
    Local aItens        as Array
	Local cQry			as Character
	Local nSeq			as Numeric
    Local aArea         as Array

    Default cName     := ""

	nSeq   := 1    
    aItens := {}
    aArea  := GetArea()

    dbSelectArea("ME0")

	cQry := " SELECT ME0_FILIAL, ME0_CODMON, ME0_NOME "
	cQry += " FROM "+ RetSqlName("ME0") +" ME0 "
	cQry += " WHERE "
    cQry += " ME0.ME0_FILIAL = ? "

    If !Empty(cName)
        cQry += " AND ME0.ME0_NOME = ? "
    EndIf
    
    cQry += " AND ME0.D_E_L_E_T_ = ? " 
	cQry := ChangeQuery(cQry)

	oQueryQry := FwExecStatement():New(cQry)

	oQueryQry:SetString(nSeq++, xFilial("ME0")) 

    If !Empty(cName)
        oQueryQry:SetString(nSeq++, upper(cName))
    EndIf

    oQueryQry:SetString(nSeq++, Space(1))

	cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

	While (cAliasQry)->( !EOF() )
        jItem := JsonObject():New()
        jItem["filial"]  := EncodeUTF8(AllTrim((cAliasQry)->ME0_FILIAL), "cp1252")
        jItem["code"]    := (cAliasQry)->ME0_CODMON
        jItem["name"]    := EncodeUTF8(AllTrim((cAliasQry)->ME0_NOME), "cp1252")          

        aAdd(aItens, jItem)
        (cAliasQry)->(dbSkip())
	EndDo

	(cAliasQry)->(dbCloseArea())

    RestArea(aArea)
    
    FreeObj(jItem)
    FreeObj(oQueryQry)

Return(aItens)
