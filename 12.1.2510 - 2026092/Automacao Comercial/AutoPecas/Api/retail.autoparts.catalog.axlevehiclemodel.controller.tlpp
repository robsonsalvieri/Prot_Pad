#include "totvs.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "fwmvcdef.ch"
#include "retail.autoparts.catalog.axlevehiclemodel.controller.ch"

//               Nome do parametro no JSON     , Campo no SX3   , Tipo
Static aFields :=   { ;
                    {"vehicleModelUuid"        , "MFS_MECUID"   , "C"    },;
                    {"axleBranch"              , "MFS_FILEIX"   , "C"    },;
                    {"axleCode"                , "MFS_CODEIX"   , "C"    };
                    } as Array

namespace totvs.protheus.retail.autoparts.catalog.axlevehiclemodel.controller

/*/{Protheus.doc} RetailAutopartsCatalogAxleVehicleModelController
    API relacionada ao cadastro de eixo x modelo de veiculo do catalogo de autopecas
    @type    class
    @author  eduardo.FLima
    @since   06/07/2026
/*/
Class RetailAutopartsCatalogAxleVehicleModelController

    public Method New() as Object

    private Method PositionMFSByKey(cVehicleModelUuid as Character, cAxleBranch as Character, cAxleCode as Character) as Logical
    private Method FindAxleVehicleModel(cVehicleModelUuid as Character, cAxleBranch as Character, cAxleCode as Character) as Array
    private Method CountAxleVehicleModel() as Numeric

    @Get("/api/retail/v1/retailAutopartsCatalogAxleVehicleModel/getDataForAxleVehicleModel", description="Consulta os relacionamentos de eixo x modelo de veiculo do catalogo de autopecas, podendo filtrar por uuid do modelo, filial do eixo e codigo do eixo")
    public Method getDataForAxleVehicleModel() as Logical

    @Get("/api/retail/v1/retailAutopartsCatalogAxleVehicleModel/getCountDataForAxleVehicleModel", description="Consulta a quantidade total de relacionamentos de eixo x modelo de veiculo do catalogo de autopecas")
    public Method getCountDataForAxleVehicleModel() as Logical

    @Post("/api/retail/v1/retailAutopartsCatalogAxleVehicleModel/postDataForAxleVehicleModel", description="Cadastra um novo relacionamento de eixo x modelo de veiculo para o catalogo de autopecas")
    public Method postDataForAxleVehicleModel() as Logical

    @Put("/api/retail/v1/retailAutopartsCatalogAxleVehicleModel/putDataForAxleVehicleModel/:vehicleModelUuid/:axleCode", description="Altera um relacionamento de eixo x modelo de veiculo existente no catalogo de autopecas")
    public Method putDataForAxleVehicleModel() as Logical

    @Delete("/api/retail/v1/retailAutopartsCatalogAxleVehicleModel/deleteDataForAxleVehicleModel/:vehicleModelUuid/:axleCode", description="Deleta um relacionamento de eixo x modelo de veiculo do catalogo de autopecas")
    public Method deleteDataForAxleVehicleModel() as Logical

EndClass

/*/{Protheus.doc} New
    Metodo construtor
    @type   method
    @author eduardo.FLima
    @since  06/07/2026
    @return Object, Objeto instanciado da classe RetailAutopartsCatalogAxleVehicleModelController
/*/
Method New() as Object Class RetailAutopartsCatalogAxleVehicleModelController
Return Self

/*/{Protheus.doc} getDataForAxleVehicleModel
    Retorna os relacionamentos de eixo x modelo de veiculo do catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   06/07/2026
    @version p12
    @return  logical, .T. indicando se a execucao foi bem sucedida
/*/
Method getDataForAxleVehicleModel() as Logical Class RetailAutopartsCatalogAxleVehicleModelController
    Local oJsonRespo        := JsonObject():New() as Object
    Local oJParametr        := oRest:getQueryRequest() as Object
    Local aItens            := {} as Array
    Local cVehicleModelUuid := "" as Character
    Local cAxleBranch       := "" as Character
    Local cAxleCode         := "" as Character
    Local lSeek             := .T. as Logical

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    If oJParametr:hasProperty('vehicleModelUuid')
        cVehicleModelUuid := oJParametr['vehicleModelUuid']
        lSeek := Lj6000VUid(cVehicleModelUuid) // Valida se o UUID informado e valido
    EndIf
    If oJParametr:hasProperty('axleBranch')
        cAxleBranch := oJParametr['axleBranch']
    EndIf
    If oJParametr:hasProperty('axleCode')
        cAxleCode := oJParametr['axleCode']
    EndIf

    If lSeek // Se o UUID informado for valido, realiza a busca caso nao o retorno sera vazio
        aItens := Self:FindAxleVehicleModel(cVehicleModelUuid, cAxleBranch, cAxleCode)
    EndIf

    If Len(aItens) > 0
        oJsonRespo["items"] := aItens
        oRest:setStatusCode(200)  // HTTP 200 = Sucesso
    Else
        oJsonRespo["items"]   := {}
        oJsonRespo["message"] := STR0001 //"Dados não encontrados para o filtro informado"
        oRest:setStatusCode(404)  // HTTP 404 = Not Found
    EndIf

    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

Return .T.

/*/{Protheus.doc} getCountDataForAxleVehicleModel
    Retorna a quantidade total de relacionamentos validos de eixo x modelo de veiculo
    @type    method
    @author  eduardo.FLima
    @since   06/07/2026
    @version p12
    @return  logical, .T. indicando se a execucao foi bem sucedida
/*/
Method getCountDataForAxleVehicleModel() as Logical Class RetailAutopartsCatalogAxleVehicleModelController
    Local oJsonRespo    := JsonObject():New() as Object
    Local nTotal        := 0 as Numeric

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    nTotal := Self:CountAxleVehicleModel()

    oJsonRespo["total"] := nTotal
    oRest:setStatusCode(200)

    oRest:setResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)

Return .T.

/*/{Protheus.doc} postDataForAxleVehicleModel
    Cadastro de relacionamento de eixo x modelo de veiculo do catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   06/07/2026
    @version p12
    @return  logical, .T. indicando se a execucao foi bem sucedida
/*/
Method postDataForAxleVehicleModel() as Logical Class RetailAutopartsCatalogAxleVehicleModelController
    Local oJsBody       := JsonObject():New() as Object
    Local oJsonRespo    := JsonObject():New() as Object
    Local oModel        := Nil as Object
    Local oModelMFS     := Nil as Object
    Local lGravouOK     := .F. as Logical
    Local aErros        := {} as Array
    Local lDadosOK      := .T. as Logical
    Local cParamName    := "" as Character
    Local cFieldName    := "" as Character
    Local lAnyParInf    := .F. as Logical
    Local nX            := 0 as Numeric

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    oJsBody:fromJson(oRest:GetBodyRequest())

    If lDadosOK
        // ==========================================
        // Carrega o Model MVC
        // ==========================================
        oModel := FWLoadModel("LOJA6090")
        oModel:SetOperation(MODEL_OPERATION_INSERT)
        oModel:Activate()

        // ------------------------------------------
        // Obtem o SubModel da Tabela MFS
        // ------------------------------------------
        oModelMFS := oModel:GetModel("MFSMASTER")

        // ==========================================
        // Preenche os Campos do Model
        // ==========================================
        For nX := 1 To Len(aFields)
            cParamName := aFields[nX][1]
            cFieldName := aFields[nX][2]

            If oJsBody[cParamName] != Nil
                oModelMFS:SetValue(cFieldName, oJsBody[cParamName])
                lAnyParInf := .T.
            EndIf
        Next nX

        If !lAnyParInf
            oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
            oJsonRespo['message'] := STR0002 //"Nenhum parâmetro informado para cadastro"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        // ==========================================
        // Valida e Grava os Dados
        // ==========================================
        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        Else
            lGravouOK := .F.
        EndIf

        If lGravouOK
            dbSelectArea("MFS")
            oRest:setStatusCode(201)  // HTTP 201 = Created
            oJsonRespo['success'] := .T.
            oJsonRespo['message'] := STR0003 + AllTrim(MFS->MFS_MECUID) + "/" + AllTrim(MFS->MFS_CODEIX) + STR0004 //"Eixo x Modelo Veículo " ### " cadastrado com sucesso"
            For nX := 1 To Len(aFields)
                cParamName := aFields[nX][1]
                cFieldName := aFields[nX][2]
                oJsonRespo[cParamName] := AllTrim(MFS->(FieldGet(FieldPos(cFieldName))))
            Next nX
        Else
            oRest:setStatusCode(400)  // HTTP 400 = Bad Request
            aErros := oModel:GetErrorMessage()

            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := IIf(!Empty(aErros[6]), aErros[6], STR0006) //"Erro ao cadastrar Eixo x Modelo Veículo"
            oJsonRespo['field']   := IIf(!Empty(aErros[4]), aErros[4], "")
            oJsonRespo['errorId'] := IIf(!Empty(aErros[5]), aErros[5], "")
            oJsonRespo['solution']:= IIf(!Empty(aErros[7]), aErros[7], "")
        EndIf
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    // ==========================================
    // Libera Recursos da Memoria
    // ==========================================
    If ValType(oModel) <> "U"
        oModelMFS:DeActivate()
        oModel:DeActivate()
        FreeObj(oModelMFS)
        FreeObj(oModel)
    EndIf

    FreeObj(oJsBody)
    FreeObj(oJsonRespo)

Return .T.

/*/{Protheus.doc} putDataForAxleVehicleModel
    Altera cadastro de relacionamento de eixo x modelo de veiculo do catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   06/07/2026
    @version p12
    @return  logical, .T. indicando se a execucao foi bem sucedida
/*/
Method putDataForAxleVehicleModel() as Logical Class RetailAutopartsCatalogAxleVehicleModelController
    Local oJsonRespo        := JsonObject():New() as Object
    Local oJPathParam       := oRest:getPathParamsRequest() as Object
    Local oJsBody           := JsonObject():New() as Object
    Local oJParametr        := oRest:getQueryRequest() as Object
    Local lFound            := .F. as Logical
    Local cVehicleModelUuid := "" as Character
    Local cAxleBranch       := "" as Character
    Local cAxleCode         := "" as Character
    Local aArea             := GetArea() as Array
    Local oModel            := Nil as Object
    Local oModelMFS         := Nil as Object
    Local lGravouOK         := .F. as Logical
    Local aErros            := {} as Array
    Local nX                := 0 as Numeric
    Local cParamName        := "" as Character
    Local cFieldName        := "" as Character
    Local lAnyParInf        := .F. as Logical
    Local lDadosOK          := .T. as Logical

    dbSelectArea("MFS")

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    oJsBody:fromJson(oRest:GetBodyRequest())

    // Obtem vehicleModelUuid e axleCode dos path params
    If oJPathParam:hasProperty('vehicleModelUuid')
        cVehicleModelUuid := oJPathParam['vehicleModelUuid']
    EndIf
    If oJPathParam:hasProperty('axleCode')
        cAxleCode := oJPathParam['axleCode']
    EndIf

    // Obtem axleBranch opcional do query param
    If oJParametr:hasProperty('axleBranch')
        cAxleBranch := oJParametr['axleBranch']
    EndIf

    // ==========================================
    // Validacao: Parametros Obrigatorios
    // ==========================================
    If Empty(cVehicleModelUuid) .Or. Empty(cAxleCode)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['message'] := STR0007 //"Parâmetros 'vehicleModelUuid' e 'axleCode' são obrigatórios"
        lDadosOK := .F.
    EndIf

    If lDadosOK
        // Aplica default de filial do eixo para posicionamento
        cAxleBranch := IIf(Empty(cAxleBranch), xFilial("MEB"), cAxleBranch)

        lFound := Self:PositionMFSByKey(cVehicleModelUuid, cAxleBranch, cAxleCode)

        // ------------------------------------------
        // Se nao encontrou retorna erro 404
        // ------------------------------------------
        If !lFound
            oRest:setStatusCode(404)  // HTTP 404 = Not Found
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0008 + AllTrim(cVehicleModelUuid) + "/" + AllTrim(cAxleCode) + STR0009 //"Registro " ### " não encontrado para os parâmetros informados"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK

        // ==========================================
        // Carrega o Model MVC para Alteracao
        // ==========================================
        oModel := FWLoadModel("LOJA6090")
        oModel:SetOperation(MODEL_OPERATION_UPDATE)
        oModel:Activate()

        // ------------------------------------------
        // Obtem o SubModel da Tabela MFS
        // ------------------------------------------
        oModelMFS := oModel:GetModel("MFSMASTER")

        // ==========================================
        // Preenche os Campos do Model
        // ==========================================
        For nX := 1 To Len(aFields)
            cParamName := aFields[nX][1]
            cFieldName := aFields[nX][2]

            If oJsBody[cParamName] != Nil
                oModelMFS:SetValue(cFieldName, oJsBody[cParamName])
                lAnyParInf := .T.
            EndIf
        Next nX

        If !lAnyParInf
            oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
            oJsonRespo['message'] := STR0010 //"Nenhum parâmetro informado para alteração"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        // ==========================================
        // Valida e Grava as Alteracoes
        // ==========================================
        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        Else
            lGravouOK := .F.
        EndIf

        If lGravouOK
            dbSelectArea("MFS")
            oRest:setStatusCode(200)  // HTTP 200 = OK
            oJsonRespo['success'] := .T.
            oJsonRespo['message'] := STR0003 + AllTrim(cVehicleModelUuid) + "/" + AllTrim(cAxleCode) + STR0005 //"Eixo x Modelo Veículo " ### " atualizado com sucesso"
            For nX := 1 To Len(aFields)
                cParamName := aFields[nX][1]
                cFieldName := aFields[nX][2]
                oJsonRespo[cParamName] := AllTrim(MFS->(FieldGet(FieldPos(cFieldName))))
            Next nX
        Else
            oRest:setStatusCode(400)  // HTTP 400 = Bad Request
            aErros := oModel:GetErrorMessage()

            oJsonRespo['success']  := .F.
            oJsonRespo['field']    := IIf(!Empty(aErros[4]), aErros[4], "")
            oJsonRespo['message']  := IIf(!Empty(aErros[6]), aErros[6], STR0011) //"Erro ao atualizar Eixo x Modelo Veículo"
            oJsonRespo['solution'] := IIf(!Empty(aErros[7]), aErros[7], "")
        EndIf
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    // ==========================================
    // Libera Recursos da Memoria
    // ==========================================
    If ValType(oModel) <> "U"
        oModelMFS:DeActivate()
        oModel:DeActivate()
        FreeObj(oModelMFS)
        FreeObj(oModel)
    EndIf

    FreeObj(oJsBody)
    FreeObj(oJsonRespo)
    FreeObj(oJPathParam)
    FreeObj(oJParametr)

    RestArea(aArea)

Return .T.

/*/{Protheus.doc} deleteDataForAxleVehicleModel
    Deleta relacionamento de eixo x modelo de veiculo do catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   06/07/2026
    @version p12
    @return  logical, .T. indicando se a execucao foi bem sucedida
/*/
Method deleteDataForAxleVehicleModel() as Logical Class RetailAutopartsCatalogAxleVehicleModelController
    Local oJsonRespo        := JsonObject():New() as Object
    Local oJPathParam       := oRest:getPathParamsRequest() as Object
    Local oJQueryParam      := oRest:getQueryRequest() as Object
    Local lFound            := .F. as Logical
    Local cVehicleModelUuid := "" as Character
    Local cAxleBranch       := "" as Character
    Local cAxleCode         := "" as Character
    Local aArea             := GetArea() as Array
    Local oModel            := Nil as Object
    Local lGravouOK         := .F. as Logical
    Local lDadosOK          := .T. as Logical
    Local aErros            := {} as Array

    dbSelectArea("MFS")

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Obtem vehicleModelUuid e axleCode dos path params
    If oJPathParam:hasProperty('vehicleModelUuid')
        cVehicleModelUuid := oJPathParam['vehicleModelUuid']
    EndIf
    If oJPathParam:hasProperty('axleCode')
        cAxleCode := oJPathParam['axleCode']
    EndIf

    // Obtem axleBranch opcional do query param
    If oJQueryParam:hasProperty('axleBranch')
        cAxleBranch := oJQueryParam['axleBranch']
    EndIf

    // ==========================================
    // Validacao: Parametros Obrigatorios
    // ==========================================
    If Empty(cVehicleModelUuid) .Or. Empty(cAxleCode)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['message'] := STR0007 //"Parâmetros 'vehicleModelUuid' e 'axleCode' são obrigatórios"
        lDadosOK := .F.
    EndIf

    If lDadosOK
        // Aplica default de filial do eixo para posicionamento
        cAxleBranch := IIf(Empty(cAxleBranch), xFilial("MEB"), cAxleBranch)

        lFound := Self:PositionMFSByKey(cVehicleModelUuid, cAxleBranch, cAxleCode)

        // ------------------------------------------
        // Se nao encontrou retorna erro 404
        // ------------------------------------------
        If !lFound
            oRest:setStatusCode(404)  // HTTP 404 = Not Found
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0008 + AllTrim(cVehicleModelUuid) + "/" + AllTrim(cAxleCode) + STR0009 //"Registro " ### " não encontrado para os parâmetros informados"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        // ==========================================
        // Carrega o Model MVC para Delete
        // ==========================================
        oModel := FWLoadModel("LOJA6090")
        oModel:SetOperation(MODEL_OPERATION_DELETE)
        oModel:Activate()

        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        EndIf

        // Resposta default: erro (padrao defensivo)
        oRest:setStatusCode(400)  // HTTP 400 = Bad Request
        oJsonRespo['success'] := .F.
        aErros := oModel:GetErrorMessage()
        oJsonRespo['message']  := IIf(!Empty(aErros[6]), aErros[6], STR0012) //"Erro ao deletar Eixo x Modelo Veículo"
        oJsonRespo['field']    := IIf(!Empty(aErros[4]), aErros[4], "")
        oJsonRespo['solution'] := IIf(!Empty(aErros[7]), aErros[7], "")

        If lGravouOK
            oRest:setStatusCode(200)  // HTTP 200 = OK
            oJsonRespo['success'] := .T.
            oJsonRespo['message'] := STR0003 + AllTrim(cVehicleModelUuid) + "/" + AllTrim(cAxleCode) + STR0013 //"Eixo x Modelo Veículo " ### " deletado com sucesso"
            // Remove campos de erro caso tenha sucesso na delecao
            oJsonRespo:delName("field")
            oJsonRespo:delName("solution")
        EndIf

        // ==========================================
        // Libera Recursos da Memoria
        // ==========================================
        oModel:DeActivate()
        FreeObj(oModel)
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJPathParam)
    FreeObj(oJQueryParam)

    RestArea(aArea)

Return .T.

/*/{Protheus.doc} PositionMFSByKey
    Posiciona a tabela MFS pela chave unica sem dependencia de indice SIX
    @type    method
    @author  eduardo.FLima
    @since   06/07/2026
    @param   cVehicleModelUuid , Character , UUID do modelo de veiculo (MFS_MECUID)
    @param   cAxleBranch       , Character , Filial do eixo (MFS_FILEIX)
    @param   cAxleCode         , Character , Codigo do eixo (MFS_CODEIX)
    @return  Logical   , .T. se encontrou e posicionou
/*/
Method PositionMFSByKey(cVehicleModelUuid as Character, cAxleBranch as Character, cAxleCode as Character) as Logical Class RetailAutopartsCatalogAxleVehicleModelController
    Local lFound        := .F. as Logical
    Local oQueryQry     := Nil as Object
    Local cQry          := "" as Character
    Local cAliasQry     := "" as Character
    Local nSeq          := 1 as Numeric
    Local nRecno        := 0 as Numeric

    Default cVehicleModelUuid := ""
    Default cAxleBranch       := ""
    Default cAxleCode         := ""

    If !Empty(AllTrim(cVehicleModelUuid)) .and. Lj6000VUid(cVehicleModelUuid) // Valida se o UUID informado e valido
        cQry := " SELECT MFS.R_E_C_N_O_ AS RECNO "
        cQry += " FROM " + RetSqlName("MFS") + " MFS "
        cQry += " WHERE "
        cQry += " MFS.MFS_FILIAL = ? "
        cQry += " AND MFS.MFS_MECUID = ? "
        cQry += " AND MFS.MFS_FILEIX = ? "
        cQry += " AND MFS.MFS_CODEIX = ? "
        cQry += " AND MFS.D_E_L_E_T_ = ? "
        cQry := ChangeQuery(cQry)

        oQueryQry := FwExecStatement():New(cQry)

        oQueryQry:SetString(nSeq++, xFilial("MFS"))
        oQueryQry:SetString(nSeq++, PadR(cVehicleModelUuid, TamSx3("MFS_MECUID")[1]))
        oQueryQry:SetString(nSeq++, PadR(cAxleBranch,       TamSx3("MFS_FILEIX")[1]))
        oQueryQry:SetString(nSeq++, PadR(cAxleCode,         TamSx3("MFS_CODEIX")[1]))
        oQueryQry:SetString(nSeq++, Space(1))

        cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

        If (cAliasQry)->(!EOF())
            nRecno := (cAliasQry)->RECNO
        EndIf

        (cAliasQry)->(dbCloseArea())
        oQueryQry:Destroy()
        oQueryQry := Nil

        If nRecno > 0
            dbSelectArea("MFS")
            MFS->(dbGoTo(nRecno))
            lFound := !MFS->(EOF()) .And. nRecno == MFS->(Recno())
        EndIf
    EndIf

Return lFound

/*/{Protheus.doc} FindAxleVehicleModel
    Consulta relacionamentos de eixo x modelo de veiculo do catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   06/07/2026
    @version p12
    @param   cVehicleModelUuid , Character , filtro pelo UUID do modelo de veiculo (busca exata)
    @param   cAxleBranch       , Character , filtro pela filial do eixo (busca exata)
    @param   cAxleCode         , Character , filtro pelo codigo do eixo (busca exata)
    @return  Array     , array de itens encontrados
/*/
Method FindAxleVehicleModel(cVehicleModelUuid as Character, cAxleBranch as Character, cAxleCode as Character) as Array Class RetailAutopartsCatalogAxleVehicleModelController
    Local oQueryQry     := Nil as Object
    Local jItem         := Nil as Object
    Local aItens        := {} as Array
    Local cQry          := "" as Character
    Local cAliasQry     := "" as Character
    Local nSeq          := 1 as Numeric
    Local aArea         := GetArea() as Array

    Default cVehicleModelUuid := ""
    Default cAxleBranch       := ""
    Default cAxleCode         := ""

    dbSelectArea("MFS")

    cQry := " SELECT MFS.MFS_FILIAL, MFS.MFS_MECUID, MFS.MFS_FILEIX, "
    cQry += " MFS.MFS_CODEIX, "
    cQry += " MEC.MEC_MODELO AS DESMOD, "
    cQry += " MEB.MEB_DESCRI AS DESEIX "
    cQry += " FROM " + RetSqlName("MFS") + " MFS "
    cQry += " LEFT JOIN " + RetSqlName("MEC") + " MEC ON MEC.MEC_FILIAL = ? AND MEC.MEC_MSUID = MFS.MFS_MECUID AND MEC.D_E_L_E_T_ = ? "
    cQry += " LEFT JOIN " + RetSqlName("MEB") + " MEB ON MEB.MEB_FILIAL = MFS.MFS_FILEIX AND MEB.MEB_CODEIX = MFS.MFS_CODEIX AND MEB.D_E_L_E_T_ = ? "
    cQry += " WHERE "
    cQry += " MFS.MFS_FILIAL = ? "

    If !Empty(cVehicleModelUuid)
        cQry += " AND MFS.MFS_MECUID = ? "
    EndIf

    If !Empty(cAxleBranch)
        cQry += " AND MFS.MFS_FILEIX = ? "
    EndIf

    If !Empty(cAxleCode)
        cQry += " AND MFS.MFS_CODEIX = ? "
    EndIf

    cQry += " AND MFS.D_E_L_E_T_ = ? "
    cQry += " ORDER BY MFS.MFS_MECUID, MFS.MFS_CODEIX "
    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)

    // Parametros dos LEFT JOINs (filial + D_E_L_E_T_)
    oQueryQry:SetString(nSeq++, xFilial("MEC"))  // MEC.MEC_FILIAL
    oQueryQry:SetString(nSeq++, Space(1))        // MEC.D_E_L_E_T_
    oQueryQry:SetString(nSeq++, Space(1))        // MEB.D_E_L_E_T_

    // Parametro do WHERE principal
    oQueryQry:SetString(nSeq++, xFilial("MFS"))

    If !Empty(cVehicleModelUuid)
        oQueryQry:SetString(nSeq++, PadR(cVehicleModelUuid, TamSx3("MFS_MECUID")[1]))
    EndIf

    If !Empty(cAxleBranch)
        oQueryQry:SetString(nSeq++, PadR(cAxleBranch, TamSx3("MFS_FILEIX")[1]))
    EndIf

    If !Empty(cAxleCode)
        oQueryQry:SetString(nSeq++, PadR(cAxleCode, TamSx3("MFS_CODEIX")[1]))
    EndIf

    oQueryQry:SetString(nSeq++, Space(1))  // MFS.D_E_L_E_T_

    cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

    While (cAliasQry)->(!EOF())
        jItem := JsonObject():New()
        jItem["branch"]           := rTrim((cAliasQry)->MFS_FILIAL)
        jItem["vehicleModelUuid"] := rTrim((cAliasQry)->MFS_MECUID)
        jItem["vehicleModelDesc"] := rTrim((cAliasQry)->DESMOD)
        jItem["axleBranch"]       := rTrim((cAliasQry)->MFS_FILEIX)
        jItem["axleCode"]         := rTrim((cAliasQry)->MFS_CODEIX)
        jItem["axleDesc"]         := rTrim((cAliasQry)->DESEIX)
        aAdd(aItens, jItem)
        jItem := Nil
        (cAliasQry)->(dbSkip())
    EndDo

    (cAliasQry)->(dbCloseArea())
    oQueryQry:Destroy()
    oQueryQry := Nil

    RestArea(aArea)

Return(aItens)

/*/{Protheus.doc} CountAxleVehicleModel
    Consulta a quantidade total de relacionamentos validos de eixo x modelo de veiculo
    @type    method
    @author  eduardo.FLima
    @since   06/07/2026
    @version p12
    @return  Numeric   , quantidade total de registros validos
/*/
Method CountAxleVehicleModel() as Numeric Class RetailAutopartsCatalogAxleVehicleModelController
    Local oQueryQry     as Object
    Local cQry          as Character
    Local nSeq          as Numeric
    Local nTotal        as Numeric
    Local aArea         as Array

    oQueryQry   := Nil
    nSeq        := 1
    nTotal      := 0
    aArea       := GetArea()

    dbSelectArea("MFS")

    cQry := " SELECT COUNT(1) AS TOTAL "
    cQry += " FROM " + RetSqlName("MFS") + " MFS "
    cQry += " WHERE "
    cQry += " MFS.MFS_FILIAL = ? "
    cQry += " AND MFS.D_E_L_E_T_ = ? "
    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)

    oQueryQry:SetString(nSeq++, xFilial("MFS"))
    oQueryQry:SetString(nSeq++, Space(1))

    nTotal := Val(cValToChar(oQueryQry:ExecScalar('TOTAL')))


    RestArea(aArea)

    oQueryQry:Destroy()

Return nTotal
