#include "totvs.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "fwmvcdef.ch"
#include "retail.autoparts.catalog.systemsetxproductgroup.controller.ch"

namespace totvs.protheus.retail.autoparts.catalog.systemsetxproductgroup.controller


/*/{Protheus.doc} RetailAutopartsCatalogSystemSetXProductGroupController
    API relacionada ao cadastro de Conjunto de Sistema x Grupo de Produto do catalogo de autopecas.
     - GET: Consulta os registros de Conjunto de Sistema x Grupo de Produto do catalogo de autopecas.
     - POST: Cadastra novo registro de Conjunto de Sistema x Grupo de Produto
     - PUT: Altera registro de Conjunto de Sistema x Grupo de Produto
     - DELETE: Deleta registro de Conjunto de Sistema x Grupo de Produto
     @type   class
     @author Alberto Deviciente
     @since  15/06/2026
     @version P12
/*/
Class RetailAutopartsCatalogSystemSetXProductGroupController

    private Method FindSystemSetXProductGroup(cCodCon as Character, cCodGru as Character) as Array

    public Method New() as Object

    @Get("/api/retail/v1/retailAutopartsCatalogSystemSetXProductGroup/getDataForSystemSetXProductGroup", description="Consulta os registros de Conjunto de Sistema x Grupo de Produto do catalogo de autopecas.")
    public Method getDataForSystemSetXProductGroup() as Logical

    @Post("/api/retail/v1/retailAutopartsCatalogSystemSetXProductGroup/postDataForSystemSetXProductGroup", description="Cadastra novo registro de Conjunto de Sistema x Grupo de Produto")
    public Method postDataForSystemSetXProductGroup() as Logical

    @Put("/api/retail/v1/retailAutopartsCatalogSystemSetXProductGroup/putDataForSystemSetXProductGroup", description="Altera registro de Conjunto de Sistema x Grupo de Produto")
    public Method putDataForSystemSetXProductGroup() as Logical

    @Delete("/api/retail/v1/retailAutopartsCatalogSystemSetXProductGroup/deleteDataForSystemSetXProductGroup/:systemSetCode/:productGroupCode", description="Deleta registro de Conjunto de Sistema x Grupo de Produto")
    public Method deleteDataForSystemSetXProductGroup() as Logical

EndClass

/*/{Protheus.doc} New
    Metodo construtor
    @type   method
    @author Alberto Deviciente
    @since  15/06/2026
    @version P12
/*/
Method New() as Object Class RetailAutopartsCatalogSystemSetXProductGroupController
Return Self

/*/{Protheus.doc} getDataForSystemSetXProductGroup
    Retorna os registros de Conjunto de Sistema x Grupo de Produto do catalogo de autopecas
    @type    method
    @author  Alberto Deviciente
    @since   15/06/2026
    @version P12
/*/
Method getDataForSystemSetXProductGroup() as Logical Class RetailAutopartsCatalogSystemSetXProductGroupController
    Local oJsonRespo    as Object
    Local oJParametr    as Object
    Local aArea         as Array
    Local aItens        as Array
    Local cCodCon       as Character
    Local cCodGru       as Character

    oJsonRespo  := JsonObject():New()
    oJParametr  := Nil
    aArea       := GetArea()
    aItens      := {}
    cCodCon     := ""
    cCodGru     := ""

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Obtém os dados enviados na Requisição (Via Query Params)
    oJParametr := oRest:getQueryRequest()

    If oJParametr:hasProperty('systemSetCode')
        cCodCon := oJParametr['systemSetCode']
    EndIf
    If oJParametr:hasProperty('productGroupCode')
        cCodGru := oJParametr['productGroupCode']
    EndIf

    aItens := Self:FindSystemSetXProductGroup(cCodCon, cCodGru)

    If Len(aItens) > 0
        oJsonRespo['items'] := aItens
        oRest:setStatusCode(200)  // HTTP 200 = Sucesso
    Else
        oJsonRespo['items'] := {}
        oJsonRespo['message'] := STR0001 //"Dados não encontrados para o filtro informado"
        oRest:setStatusCode(404)  // HTTP 404 = Not Found
    EndIf

    RestArea(aArea)

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:setResponse(oJsonRespo:toJson())

    FwFreeObj(oJsonRespo)

Return .T.

/*/{Protheus.doc} postDataForSystemSetXProductGroup
    Cadastro de Conjunto de Sistema x Grupo de Produto no catalogo de autopecas
    @type    method
    @author  Alberto Deviciente
    @since   15/06/2026
    @version P12
/*/
Method postDataForSystemSetXProductGroup() as Logical Class RetailAutopartsCatalogSystemSetXProductGroupController
    Local oJsBody       as Object
    Local oJsonRespo    as Object
    Local oModel        as Object
    Local oModelMI4     as Object
    Local cCodCon       as Character
    Local cCodGru       as Character
    Local lGravouOK     as Logical
    Local aErros        as Array

    oJsBody     := JsonObject():New()
    oJsonRespo  := JsonObject():New()
    oModel      := Nil
    oModelMI4   := Nil
    cCodCon     := ""
    cCodGru     := ""
    lGravouOK   := .F.
    aErros      := {}

    dbSelectArea("MI4")

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Obtém os dados enviados na Requisição (Via Body Params)
    oJsBody:fromJson(oRest:GetBodyRequest())

    If oJsBody:hasProperty('systemSetCode')
        cCodCon := oJsBody['systemSetCode']
    EndIf
    If oJsBody:hasProperty('productGroupCode')
        cCodGru := oJsBody['productGroupCode']
    EndIf

    // ==========================================
    // Carrega o Model MVC
    // ==========================================
    oModel := FWLoadModel("LOJA6040")
    oModel:SetOperation(MODEL_OPERATION_INSERT)
    oModel:Activate()

    oModelMI4 := oModel:GetModel("MI4MASTER")

    // ==========================================
    // Alimenta os Campos do Model
    // ==========================================
    oModelMI4:SetValue("MI4_CODCON", cCodCon)
    oModelMI4:SetValue("MI4_CODGRU", cCodGru)

    // ==========================================
    // Valida os dados do Model
    // ==========================================
    If oModel:VldData()
        // ==========================================
        // Grava os dados do Model
        // ==========================================
        lGravouOK := oModel:CommitData()
    EndIf

    If lGravouOK
        oRest:setStatusCode(201)  // HTTP 201 = Created
        oJsonRespo['success']           := .T.
        oJsonRespo['message']           := STR0002 + AllTrim(cCodCon) + STR0003 + AllTrim(cCodGru) + STR0004 //"Conjunto de Sistema " ### " x Grupo de Produto " ### " cadastrado com sucesso"
        oJsonRespo['branch']            := AllTrim(MI4->MI4_FILIAL)
        oJsonRespo['systemSetCode']     := AllTrim(MI4->MI4_CODCON)
        oJsonRespo['productGroupCode']  := AllTrim(MI4->MI4_CODGRU)
    Else
        oRest:setStatusCode(400)  // HTTP 400 = Bad Request

        // Captura os erros do Model
        aErros := oModel:GetErrorMessage()

        /*
        Estrutura do Array aErros:
        [1] = Id do formulário de origem
        [2] = Id do campo de origem
        [3] = Id do formulário de erro
        [4] = Id do campo de erro
        [5] = Id do erro
        [6] = Mensagem do erro
        [7] = Mensagem da solução
        [8] = Valor atribuído
        [9] = Valor anterior
        */
        oJsonRespo['success']   := .F.
        oJsonRespo['message']   := IIf(Len(aErros) >= 6 .And. !Empty(aErros[6]), aErros[6], STR0008) //"Erro ao cadastrar"
        oJsonRespo['field']     := IIf(Len(aErros) >= 4 .And. !Empty(aErros[4]), aErros[4], "")
        oJsonRespo['errorId']   := IIf(Len(aErros) >= 5 .And. !Empty(aErros[5]), aErros[5], "")
        oJsonRespo['solution']  := IIf(Len(aErros) >= 7 .And. !Empty(aErros[7]), aErros[7], "")

    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    // ==========================================
    // Desativa o modelo de dados
    // ==========================================
    oModel:DeActivate()

    // ==========================================
    // Libera Recursos da Memória
    // ==========================================
    FwFreeObj(oModelMI4)
    FwFreeObj(oModel)
    FwFreeObj(oJsonRespo)
    FwFreeObj(oJsBody)

Return .T.

/*/{Protheus.doc} putDataForSystemSetXProductGroup
    Altera o registro de Conjunto de Sistema x Grupo de Produto no catalogo de autopecas
    @type    method
    @author  Alberto Deviciente
    @since   15/06/2026
    @version P12
/*/
Method putDataForSystemSetXProductGroup() as Logical Class RetailAutopartsCatalogSystemSetXProductGroupController
    Local oJsonRespo    as Object
    Local oJsBody       as Object
    Local oJParametr    as Object
    Local oModel        as Object
    Local oModelMI4     as Object
    Local lGravouOK     as Logical
    Local lContinua     as Logical
    Local cCodConPesq   as Character
    Local cCodGruPesq   as Character
    Local cCodCon       as Character
    Local cCodGru       as Character
    Local aArea         as Array
    Local aErros        as Array

    oJsonRespo  := JsonObject():New()
    oJsBody     := JsonObject():New()
    oJParametr  := Nil
    oModel      := Nil
    oModelMI4   := Nil
    lGravouOK   := .F.
    lContinua   := .T.
    cCodConPesq := ""
    cCodGruPesq := ""
    cCodCon     := ""
    cCodGru     := ""
    aArea       := {}
    aErros      := {}

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Obtém os dados enviados na Requisição (Via Query Params)
    oJParametr  := oRest:getQueryRequest()

    // Obtém os dados enviados na Requisição (Via Body Params)
    oJsBody:fromJson(oRest:GetBodyRequest())


    If oJParametr:hasProperty('systemSetCode')
        cCodConPesq := oJParametr['systemSetCode']
    EndIf
    If oJParametr:hasProperty('productGroupCode')
        cCodGruPesq := oJParametr['productGroupCode']
    EndIf

    If Empty(cCodConPesq) .Or. Empty(cCodGruPesq)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := STR0009 + "'systemSetCode' e 'productGroupCode'" + STR0010 //"Parâmetros " ### " para pesquisa são obrigatórios"
        lContinua := .F.
    EndIf

    If lContinua
        aArea := GetArea()
        dbSelectArea('MI4')
        MI4->(dbSetOrder(1)) //MI4_FILIAL+MI4_CODCON+MI4_CODGRU

        If !MI4->(dbSeek(xFilial("MI4") + PadR(cCodConPesq, TamSx3("MI4_CODCON")[1]) + PadR(cCodGruPesq, TamSx3("MI4_CODGRU")[1])))
            oRest:setStatusCode(404)  // HTTP 404 = Not Found
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0002 + AllTrim(cCodConPesq) + STR0003 + AllTrim(cCodGruPesq) + STR0005 //"Conjunto de Sistema " ### " x Grupo de Produto " ### " não encontrado"
            lContinua := .F.
        Else
            // Obtém os dados enviados na Requisição (Body)
            If oJsBody:hasProperty('systemSetCode')
                cCodCon := oJsBody['systemSetCode']
            EndIf
            If oJsBody:hasProperty('productGroupCode')
                cCodGru := oJsBody['productGroupCode']
            EndIf

            //Verifica se foram informados dados para alteração
            If Empty(cCodCon) .And. Empty(cCodGru)
                oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
                oJsonRespo['success'] := .F.
                oJsonRespo['message'] := STR0013 //"Nenhum parâmetro informado para alteração"
                lContinua := .F.
            EndIf
        EndIf

        If lContinua
            // ==========================================
            // Carrega o Model MVC para Alteração
            // ==========================================
            oModel := FWLoadModel("LOJA6040")
            oModel:SetOperation(MODEL_OPERATION_UPDATE)
            oModel:Activate()

            oModelMI4 := oModel:GetModel("MI4MASTER")

            oModelMI4:SetValue("MI4_CODCON", cCodCon)
            oModelMI4:SetValue("MI4_CODGRU", cCodGru)

            If oModel:VldData()
                lGravouOK := oModel:CommitData()
            EndIf

            If lGravouOK
                oRest:setStatusCode(200) // HTTP 200 = OK
                oJsonRespo['success']           := .T.
                oJsonRespo['message']           := STR0002 + AllTrim(cCodCon) + STR0003 + AllTrim(cCodGru) + STR0006 //"Conjunto de Sistema " ### " x Grupo de Produto " ### " atualizado com sucesso"
                oJsonRespo['branch']            := AllTrim(MI4->MI4_FILIAL)
                oJsonRespo['systemSetCode']     := AllTrim(MI4->MI4_CODCON)
                oJsonRespo['productGroupCode']  := AllTrim(MI4->MI4_CODGRU)
            Else
                aErros := oModel:GetErrorMessage()
                oRest:setStatusCode(400) // HTTP 400 = Bad Request
                oJsonRespo['success']  := .F.
                oJsonRespo['message']  := IIf(!Empty(aErros[6]), aErros[6], STR0011) //"Erro ao atualizar"
                oJsonRespo['field']    := IIf(!Empty(aErros[4]), aErros[4], "")
                oJsonRespo['solution'] := IIf(!Empty(aErros[7]), aErros[7], "")
            EndIf

            oModel:DeActivate()
            oModelMI4 := Nil

            // ==========================================
            // Libera Recursos da Memória
            // ==========================================
            FwFreeObj(oModel)
        EndIf

        RestArea(aArea)
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    // ==========================================
    // Libera Recursos da Memória
    // ==========================================
    FwFreeObj(oJsonRespo)
    FwFreeObj(oJsBody)

Return .T.

/*/{Protheus.doc} deleteDataForSystemSetXProductGroup
    Exclui o registro de Conjunto de Sistema x Grupo de Produto no catalogo de autopecas
    @type    method
    @author  Alberto Deviciente
    @since   15/06/2026
    @version P12
/*/
Method deleteDataForSystemSetXProductGroup() as Logical Class RetailAutopartsCatalogSystemSetXProductGroupController
    Local oJsonRespo    as Object
    Local oJParametr    as Object
    Local oModel        as Object
    Local lGravouOK     as Logical
    Local lContinua     as Logical
    Local cCodCon       as Character
    Local cCodGru       as Character
    Local aArea         as Array
    Local nStatusCode   as Numeric
    Local cMsg          as Character

    oJsonRespo  := JsonObject():New()
    oModel      := Nil
    lGravouOK   := .F.
    lContinua   := .T.
    cCodCon     := ""
    cCodGru     := ""
    aArea       := {}
    nStatusCode := 400 // HTTP 400 = Bad Request
    cMsg        := STR0012 //"Erro ao tentar deletar"

    // Obtém os dados enviados na requisição (Via Path Parameters)
    oJParametr  := oRest:getPathParamsRequest()

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Obtém os parâmetros informados na requisição
    If oJParametr:hasProperty('systemSetCode')
        cCodCon := oJParametr['systemSetCode']
    EndIf
    If oJParametr:hasProperty('productGroupCode')
        cCodGru := oJParametr['productGroupCode']
    EndIf

    If Empty(cCodCon) .Or. Empty(cCodGru)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := STR0009 + "'systemSetCode' e 'productGroupCode'" + STR0010 //"Parâmetros " ### " para pesquisa são obrigatórios"
        lContinua := .F.
    EndIf

    If lContinua
        aArea := GetArea()
        dbSelectArea('MI4')
        MI4->(dbSetOrder(1)) //MI4_FILIAL+MI4_CODCON+MI4_CODGRU

        If !MI4->(dbSeek(xFilial("MI4") + PadR(cCodCon, TamSx3("MI4_CODCON")[1]) + PadR(cCodGru, TamSx3("MI4_CODGRU")[1])))
            oRest:setStatusCode(404)  // HTTP 404 = Not Found
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0002 + AllTrim(cCodCon) + STR0003 + AllTrim(cCodGru) + STR0005 //"Conjunto de sistema " ### " x Grupo de produto " ### " não encontrado"
            lContinua := .F.
        EndIf

        If lContinua
            // ==========================================
            // Carrega o Model MVC para Deleção
            // ==========================================
            oModel := FWLoadModel("LOJA6040")
            oModel:SetOperation(MODEL_OPERATION_DELETE)
            oModel:Activate()

            If oModel:VldData()
                lGravouOK := oModel:CommitData()
            EndIf

            If lGravouOK
                nStatusCode := 200  // HTTP 200 = OK
                cMsg        := STR0002 + AllTrim(cCodCon) + STR0003 + AllTrim(cCodGru) + STR0007 //"Conjunto de sistema " ### " x Grupo de produto " ### " deletado com sucesso"
            EndIf
            
            oRest:setStatusCode(nStatusCode)
            oJsonRespo['success'] := lGravouOK
            oJsonRespo['message'] := cMsg

            oModel:DeActivate()
            FwFreeObj(oModel)
        EndIf

        RestArea(aArea)
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    // ==========================================
    // Libera Recursos da Memoria
    // ==========================================
    FwFreeObj(oJsonRespo)

Return .T.

/*/{Protheus.doc} FindSystemSetXProductGroup
    Consulta registros de Conjunto de Sistema x Grupo de Produto do catalogo de autopecas
    @type    method
    @author  Alberto Deviciente
    @since   15/06/2026
    @version P12
    @param   cCodCon  , Character , Filtro pelo codigo do conjunto de sistema
    @param   cCodGru  , Character , Filtro pelo codigo do grupo de produto
    @return  aItens   , Array     , Array de itens encontrados
/*/
Method FindSystemSetXProductGroup(cCodCon as Character, cCodGru as Character) as Array Class RetailAutopartsCatalogSystemSetXProductGroupController
    Local oQueryQry     as Object
    Local jItem         as Object
    Local nSeq          as Numeric
    Local aItens        as Array
    Local aArea         as Array
    Local cQry          as Character
    Local cAliasQry     as Character

    Default cCodCon  := ""
    Default cCodGru  := ""

    oQueryQry   := Nil
    jItem       := Nil
    nSeq        := 1
    aItens      := {}
    aArea       := GetArea()

    dbSelectArea("MI4")

    cQry := " SELECT MI4.MI4_FILIAL, MI4.MI4_CODCON, MI4.MI4_CODGRU, MI2.MI2_DESCRI, SBM.BM_DESC "
    cQry += " FROM " + RetSqlName("MI4") + " MI4 "
    cQry += " LEFT JOIN " + RetSqlName("MI2") + " MI2 ON MI2.MI2_FILIAL = ? AND MI2.MI2_CODCON = MI4.MI4_CODCON AND MI2.D_E_L_E_T_ = ' ' "
    cQry += " LEFT JOIN " + RetSqlName("SBM") + " SBM ON SBM.BM_FILIAL = ? AND SBM.BM_GRUPO = MI4.MI4_CODGRU AND SBM.D_E_L_E_T_ = ' ' "
    cQry += " WHERE "
    cQry += " MI4.MI4_FILIAL = ? "
    If !Empty(cCodCon)
        cQry += " AND MI4.MI4_CODCON = ? "
    EndIf
    If !Empty(cCodGru)
        cQry += " AND MI4.MI4_CODGRU = ? "
    EndIf
    cQry += " AND MI4.D_E_L_E_T_ = ? "
    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)

    oQueryQry:SetString(nSeq++, xFilial("MI2"))
    oQueryQry:SetString(nSeq++, xFilial("SBM"))
    oQueryQry:SetString(nSeq++, xFilial("MI4"))
    If !Empty(cCodCon)
        oQueryQry:SetString(nSeq++, cCodCon)
    EndIf
    If !Empty(cCodGru)
        oQueryQry:SetString(nSeq++, cCodGru)
    EndIf
    oQueryQry:SetString(nSeq++, Space(1))

    cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

    While (cAliasQry)->(!EOF())
        jItem := JsonObject():New()
        jItem["branch"]                  := AllTrim((cAliasQry)->MI4_FILIAL)
        jItem["systemSetCode"]           := AllTrim((cAliasQry)->MI4_CODCON)
        jItem["systemSetDescription"]    := AllTrim((cAliasQry)->MI2_DESCRI)
        jItem["productGroupCode"]        := AllTrim((cAliasQry)->MI4_CODGRU)
        jItem["productGroupDescription"] := AllTrim((cAliasQry)->BM_DESC)
        aAdd(aItens, jItem)
        jItem := Nil
        (cAliasQry)->(dbSkip())
    EndDo

    (cAliasQry)->(dbCloseArea())

    RestArea(aArea)

    // ==========================================
    // Libera Recursos da Memoria
    // ==========================================
    FwFreeObj(oQueryQry)

Return(aItens)
