#include "totvs.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "fwmvcdef.ch"
#include "retail.autoparts.catalog.referencecode.controller.ch"

//             Nome do parametro no JSON  , Campo SX3    , Tipo
Static aFields := { ;
                    {"referenceCode"      , "MG5_CODREF" , "C"},;
                    {"productCode"        , "MG5_CODPRD" , "C"},;
                    {"manufacturerCode"   , "MG5_CODMON" , "C"},;
                    {"substituteReference", "MG5_REFSUB" , "C"},;
                    {"mainReference"      , "MG5_REFPRI" , "C"};
                 } as Array

namespace totvs.protheus.retail.autoparts.catalog.referencecode.controller

/*/{Protheus.doc} RetailAutopartsCatalogReferenceCodeController
    API relacionada ao cadastro de Codigos Referenciais (MG5)
    @type    class
    @author  eduardo.FLima
    @since   09/06/2026
    @version P12
/*/
Class RetailAutopartsCatalogReferenceCodeController

    public Method New()

    private Method PositionMG5ByKey(cBranch as Character, cProductCode as Character, cReferenceCode as Character, cManufacturerCode as Character) as Logical
    private Method FindReferenceCode(cReferenceCode as Character, cMainReference as Character, cManufacturerCode as Character, cProductCode as Character, cSubstituteReference as Character) as Array
    private Method CountReferenceCode() as Numeric
    private Method IsDeleteAllowed(cBranch as Character, cProductCode as Character, cReferenceCode as Character, cManufacturerCode as Character) as Array
    private Method IsReferenceUsedAsSubstitute(cBranch as Character, cReferenceCode as Character) as Logical

    @Get("/api/retail/v1/retailAutopartsCatalogReferenceCode/getDataForReferenceCode", description="Consulta codigos referenciais, podendo filtrar por codigo de referencia, referencia principal, montadora, produto e referencia substituta")
    public Method getDataForReferenceCode()

    @Get("/api/retail/v1/retailAutopartsCatalogReferenceCode/getCountDataForReferenceCode", description="Consulta a quantidade total de codigos referenciais")
    public Method getCountDataForReferenceCode()

    @Post("/api/retail/v1/retailAutopartsCatalogReferenceCode/postDataForReferenceCode", description="Cadastra um novo codigo referencial")
    public Method postDataForReferenceCode()

    @Put("/api/retail/v1/retailAutopartsCatalogReferenceCode/putDataForReferenceCode", description="Altera um codigo referencial existente")
    public Method putDataForReferenceCode()

    @Delete("/api/retail/v1/retailAutopartsCatalogReferenceCode/deleteDataForReferenceCode/:productCode/:referenceCode/:manufacturerCode", description="Exclui logicamente um codigo referencial")
    public Method deleteDataForReferenceCode()

EndClass

/*/{Protheus.doc} New
    Metodo construtor
    @type   method
    @author eduardo.FLima
    @since  09/06/2026
    @version P12
    @return Object, Objeto da classe
/*/
Method New() Class RetailAutopartsCatalogReferenceCodeController
Return Self

/*/{Protheus.doc} getDataForReferenceCode
    Retorna os codigos referenciais filtrados
    @type    method
    @author  eduardo.FLima
    @since   09/06/2026
    @version P12
/*/
Method getDataForReferenceCode() Class RetailAutopartsCatalogReferenceCodeController
    Local oJsonRespo         := JsonObject():New() as Object
    Local oJParametr         := oRest:getQueryRequest() as Object
    Local aItens             := {} as Array
    Local cReferenceCode     := "" as Character
    Local cMainReference     := "" as Character
    Local cManufacturerCode  := "" as Character
    Local cProductCode       := "" as Character
    Local cSubstituteRef     := "" as Character

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    If oJParametr:hasProperty('referenceCode')
        cReferenceCode := oJParametr['referenceCode']
    EndIf
    If oJParametr:hasProperty('mainReference')
        cMainReference := oJParametr['mainReference']
    EndIf
    If oJParametr:hasProperty('manufacturerCode')
        cManufacturerCode := oJParametr['manufacturerCode']
    EndIf
    If oJParametr:hasProperty('productCode')
        cProductCode := oJParametr['productCode']
    EndIf
    If oJParametr:hasProperty('substituteReference')
        cSubstituteRef := oJParametr['substituteReference']
    EndIf

    aItens := Self:FindReferenceCode(cReferenceCode, cMainReference, cManufacturerCode, cProductCode, cSubstituteRef)

    If Len(aItens) > 0
        oJsonRespo['items'] := aItens
        oRest:setStatusCode(200)
    Else
        oJsonRespo['items'] := {}
        oJsonRespo['message'] := STR0001 //"Dados não encontrados para o filtro informado"
        oRest:setStatusCode(404)
    EndIf

    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

Return .T.

/*/{Protheus.doc} getCountDataForReferenceCode
    Retorna a quantidade total de codigos referenciais validos
    @type    method
    @author  eduardo.FLima
    @since   09/06/2026
    @version p12
/*/
Method getCountDataForReferenceCode() Class RetailAutopartsCatalogReferenceCodeController
    Local oJsonRespo := JsonObject():New() as Object

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    oJsonRespo['total'] := Self:CountReferenceCode()
    oRest:setStatusCode(200)
    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)

Return .T.

/*/{Protheus.doc} postDataForReferenceCode
    Cadastro de Codigo Referencial
    @type    method
    @author  eduardo.FLima
    @since   09/06/2026
    @version p12
/*/
Method postDataForReferenceCode() Class RetailAutopartsCatalogReferenceCodeController
    Local oJsBody       := JsonObject():New() as Object
    Local oJsonRespo    := JsonObject():New() as Object
    Local oModel        := Nil as Object
    Local oModelMG5     := Nil as Object
    Local aErros        := {} as Array
    Local lGravouOK     := .F. as Logical
    Local cParamName    := "" as Character
    Local cFieldName    := "" as Character
    Local lAnyParInf    := .F. as Logical
    Local nX            := 0 as Numeric

    oRest:setKeyHeaderResponse("Content-Type", "application/json")
    oJsBody:fromJson(oRest:GetBodyRequest())

    oModel := FWLoadModel('LOJA6010')
    oModel:SetOperation(MODEL_OPERATION_INSERT)
    oModel:Activate()

    oModelMG5 := oModel:GetModel('MG5MASTER')

    If oJsBody['mainReference'] == Nil .Or. Empty(oJsBody['mainReference'])
        oModelMG5:SetValue('MG5_REFPRI', '2')
    EndIf

    For nX := 1 To Len(aFields)
        cParamName := aFields[nX][1]
        cFieldName := aFields[nX][2]

        If oJsBody[cParamName] != Nil
            oModelMG5:SetValue(cFieldName, oJsBody[cParamName])
            lAnyParInf := .T.
        EndIf
    Next nX


    If !lAnyParInf
        oRest:setStatusCode(422)
            oJsonRespo['message'] := STR0002 //"Nenhum parâmetro de código referencial informado para cadastro"
        Else
            If oModel:VldData()
                lGravouOK := oModel:CommitData()
            EndIf

            If lGravouOK
                oRest:setStatusCode(201)
                oJsonRespo['success']          := .T.
                oJsonRespo['message']          := STR0003 //"Código referencial cadastrado com sucesso"
                oJsonRespo['branch']           := AllTrim(MG5->MG5_FILIAL)
                oJsonRespo['productCode']      := AllTrim(MG5->MG5_CODPRD)
                oJsonRespo['referenceCode']    := AllTrim(MG5->MG5_CODREF)
                oJsonRespo['manufacturerCode'] := AllTrim(MG5->MG5_CODMON)
                oJsonRespo['mainReference']    := AllTrim(MG5->MG5_REFPRI)
            Else
                aErros := oModel:GetErrorMessage()
                oRest:setStatusCode(400)
                oJsonRespo['success']  := .F.
                oJsonRespo['message']  := IIf(!Empty(aErros[6]), aErros[6], STR0004) //"Erro ao cadastrar código referencial"
                oJsonRespo['field']    := IIf(!Empty(aErros[4]), aErros[4], "")
                oJsonRespo['errorId']  := IIf(!Empty(aErros[5]), aErros[5], "")
                oJsonRespo['solution'] := IIf(!Empty(aErros[7]), aErros[7], "")
        EndIf
    EndIf

    oRest:SetResponse(oJsonRespo:toJson())

    oModelMG5:DeActivate()
    oModel:DeActivate()

    FreeObj(oModelMG5)
    FreeObj(oModel)
    FreeObj(oJsBody)
    FreeObj(oJsonRespo)

Return .T.

/*/{Protheus.doc} putDataForReferenceCode
    Altera Codigo Referencial por chave composta
    @type    method
    @author  eduardo.FLima
    @since   09/06/2026
    @version p12
/*/
Method putDataForReferenceCode() Class RetailAutopartsCatalogReferenceCodeController
    Local oJsonRespo      := JsonObject():New() as Object
    Local oJsBody         := JsonObject():New() as Object
    Local oJParametr      := oRest:getQueryRequest() as Object
    Local aArea           := GetArea() as Array
    Local oModel          := Nil as Object
    Local oModelMG5       := Nil as Object
    Local lFound          := .F. as Logical
    Local lGravouOK       := .F. as Logical
    Local aErros          := {} as Array
    Local cBranch         := "" as Character
    Local cProductCode    := "" as Character
    Local cReferenceCode  := "" as Character
    Local cManufacturer   := "" as Character
    Local lAnyParInf      := .F. as Logical
    Local lDadosOK        := .T. as Logical
    Local cParamName      := "" as Character
    Local cFieldName      := "" as Character
    Local nX               := 0 as Numeric


    DbSelectArea('MG5')

    oRest:setKeyHeaderResponse("Content-Type", "application/json")
    oJsBody:fromJson(oRest:GetBodyRequest())

    // Obtem os parametros informados na requisicao via URL (query param)
    cBranch := xFilial('MG5')

    If oJParametr:hasProperty('productCode')
        cProductCode := oJParametr['productCode']
    EndIf
    If oJParametr:hasProperty('referenceCode')
        cReferenceCode := oJParametr['referenceCode']
    EndIf
    If oJParametr:hasProperty('manufacturerCode')
        cManufacturer := oJParametr['manufacturerCode']
    EndIf

    // Validacao campos obrigatorios
    If Empty(cProductCode) .Or. Empty(cReferenceCode) .Or. Empty(cManufacturer)
        oRest:setStatusCode(422)
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := STR0005 //"Parâmetros de chave para pesquisa são obrigatórios: productCode, referenceCode e manufacturerCode"
        lDadosOK := .F.
    EndIf

    If lDadosOK
        lFound := Self:PositionMG5ByKey(cBranch, cProductCode, cReferenceCode, cManufacturer)

        If !lFound
            oRest:setStatusCode(404)
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0006 //"Registro não encontrado para os parâmetros informados"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        oModel := FWLoadModel('LOJA6010')
        oModel:SetOperation(MODEL_OPERATION_UPDATE)
        oModel:Activate()

        oModelMG5 := oModel:GetModel('MG5MASTER')

        // ==========================================
        // Preenche os Campos do Model
        // ==========================================
        For nX := 1 To Len(aFields)
            cParamName := aFields[nX][1]
            cFieldName := aFields[nX][2]

            If oJsBody[cParamName] != Nil
                oModelMG5:SetValue(cFieldName, oJsBody[cParamName])
                lAnyParInf := .T.
            EndIf
        Next nX

        If !lAnyParInf
            oRest:setStatusCode(422)
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0007 //"Nenhum parâmetro informado para alteração"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        EndIf

        If lGravouOK
            oRest:setStatusCode(200)
            oJsonRespo['success'] := .T.
            oJsonRespo['message'] := STR0008 //"Código referencial atualizado com sucesso"
            oJsonRespo['branch']           := AllTrim(MG5->MG5_FILIAL)
            For nX := 1 To Len(aFields)
                cParamName := aFields[nX][1]
                cFieldName := aFields[nX][2]
                If aFields[nX][3] == "C"
                    oJsonRespo[cParamName] := AllTrim(MG5->(FieldGet(FieldPos(cFieldName))))
                EndIf
            Next nX
        Else
            aErros := oModel:GetErrorMessage()
            oRest:setStatusCode(400)
            oJsonRespo['success']  := .F.
            oJsonRespo['message']  := IIf(!Empty(aErros[6]), aErros[6], STR0009) //"Erro ao atualizar código referencial"
            oJsonRespo['field']    := IIf(!Empty(aErros[4]), aErros[4], "")
            oJsonRespo['solution'] := IIf(!Empty(aErros[7]), aErros[7], "")
        EndIf
    EndIf

    oRest:SetResponse(oJsonRespo:toJson())

    If ValType(oModel) <> 'U'
        oModelMG5:DeActivate()
        oModel:DeActivate()
        FreeObj(oModelMG5)
        FreeObj(oModel)
    EndIf

    FreeObj(oJsonRespo)
    FreeObj(oJsBody)
    FreeObj(oJParametr)

    RestArea(aArea)

Return .T.

/*/{Protheus.doc} deleteDataForReferenceCode
    Exclui logicamente Codigo Referencial por chave composta
    @type    method
    @author  eduardo.FLima
    @since   09/06/2026
    @version p12
/*/
Method deleteDataForReferenceCode() Class RetailAutopartsCatalogReferenceCodeController
    Local oJsonRespo      := JsonObject():New() as Object
    Local oJPath          := oRest:getPathParamsRequest() as Object
    Local aArea           := GetArea() as Array
    Local oModel          := Nil as Object
    Local aErros          := {} as Array
    Local lGravouOK       := .F. as Logical
    Local lFound          := .F. as Logical
    Local lAllowed        := .T. as Logical
    Local lDadosOK        := .T. as Logical
    Local cBlockMessage   := "" as Character
    Local aDeleteRule     := {} as Array
    Local cBranch         := "" as Character
    Local cProductCode    := "" as Character
    Local cReferenceCode  := "" as Character
    Local cManufacturer   := "" as Character

    DbSelectArea('MG5')

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    cBranch := xFilial('MG5')

    // Obtem os parametros informados na requisicao via URL (path param)
    If oJPath:hasProperty('productCode')
        cProductCode := oJPath['productCode']
    EndIf
    If oJPath:hasProperty('referenceCode')
        cReferenceCode := oJPath['referenceCode']
    EndIf
    If oJPath:hasProperty('manufacturerCode')
        cManufacturer := oJPath['manufacturerCode']
    EndIf

    // Validacao campos obrigatorios
    If Empty(cProductCode) .Or. Empty(cReferenceCode) .Or. Empty(cManufacturer)
        oRest:setStatusCode(422)
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := STR0005 //"Parametros de chave para pesquisa são obrigatorios: productCode, referenceCode e manufacturerCode"
        lDadosOK := .F.
    EndIf

    If lDadosOK
        lFound := Self:PositionMG5ByKey(cBranch, cProductCode, cReferenceCode, cManufacturer)

        If !lFound
            oRest:setStatusCode(404)
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0006 //"Registro não encontrado para os parâmetros informados"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        aDeleteRule := Self:IsDeleteAllowed(cBranch, cProductCode, cReferenceCode, cManufacturer)
        lAllowed    := aDeleteRule[1]
        cBlockMessage := aDeleteRule[2]

        If !lAllowed
            oRest:setStatusCode(409)
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := cBlockMessage
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        oModel := FWLoadModel('LOJA6010')
        oModel:SetOperation(MODEL_OPERATION_DELETE)
        oModel:Activate()

        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        EndIf

        // Resposta default: erro (padrao defensivo)
        oRest:setStatusCode(400)  // HTTP 400 = Bad Request
        oJsonRespo['success'] := .F.
        aErros := oModel:GetErrorMessage()
        oJsonRespo['message']  := IIf(!Empty(aErros[6]), aErros[6], STR0011) //"Erro ao excluir código referencial"
        oJsonRespo['field']    := IIf(!Empty(aErros[4]), aErros[4], "")
        oJsonRespo['solution'] := IIf(!Empty(aErros[7]), aErros[7], "")

        If lGravouOK
            oRest:setStatusCode(200)
            oJsonRespo['success'] := .T.
            oJsonRespo['message'] := STR0010 //"Codigo referencial excluido com sucesso"
            // Remove campos de erro caso tenha sucesso na delecao
            oJsonRespo:delName("field")
            oJsonRespo:delName("solution")
        EndIf
    EndIf

    oRest:SetResponse(oJsonRespo:toJson())

    If ValType(oModel) <> 'U'
        oModel:DeActivate()
        FreeObj(oModel)
    EndIf

    FreeObj(oJsonRespo)
    FreeObj(oJPath)

    RestArea(aArea)

Return .T.

/*/{Protheus.doc} PositionMG5ByKey
    Posiciona MG5 pelos parâmetros informados
    @type    method
    @author  eduardo.FLima
    @since   09/06/2026
    @version P12
    @param   cBranch            , Character, Codigo da filial
    @param   cProductCode       , Character, Codigo do produto
    @param   cReferenceCode     , Character, Codigo de referencia
    @param   cManufacturerCode  , Character, Codigo do fabricante
    @return  Logical            , .T. se encontrado
/*/
Method PositionMG5ByKey(cBranch as Character, cProductCode as Character, cReferenceCode as Character, cManufacturerCode as Character) as Logical Class RetailAutopartsCatalogReferenceCodeController
    Local lFound := .F. as Logical

    MG5->(DbSetOrder(1)) // MG5_FILIAL+MG5_CODPRD+MG5_CODREF+MG5_CODMON

    lFound := MG5->(DbSeek(PadR(cBranch, TamSx3('MG5_FILIAL')[1]) + ;
                           PadR(cProductCode, TamSx3('MG5_CODPRD')[1]) + ;
                           PadR(cReferenceCode, TamSx3('MG5_CODREF')[1]) + ;
                           PadR(cManufacturerCode, TamSx3('MG5_CODMON')[1])))

Return lFound

/*/{Protheus.doc} FindReferenceCode
    Consulta codigos referenciais com filtros opcionais
    @type    method
    @author  eduardo.FLima
    @since   09/06/2026
    @version P12
    @param   cReferenceCode         , Character , Codigo de referencia
    @param   cMainReference         , Character , Codigo da referencia principal
    @param   cManufacturerCode      , Character , Codigo do fabricante
    @param   cProductCode           , Character , Codigo do produto
    @param   cSubstituteReference   , Character , Codigo da referencia substituta
    @return  Array                  , Array de objetos com os codigos referenciais encontrados
/*/
Method FindReferenceCode(cReferenceCode as Character, cMainReference as Character, cManufacturerCode as Character, cProductCode as Character, cSubstituteReference as Character) as Array Class RetailAutopartsCatalogReferenceCodeController
    Local oQueryQry    := Nil as Object
    Local cQry         := "" as Character
    Local cAliasQry    := "" as Character
    Local nSeq         := 1 as Numeric
    Local aItens       := {} as Array
    Local jItem        := Nil as Object
    Local aArea        := GetArea() as Array

    Default cReferenceCode     := ""
    Default cMainReference     := ""
    Default cManufacturerCode  := ""
    Default cProductCode       := ""
    Default cSubstituteReference := ""

    cQry := " SELECT MG5.MG5_FILIAL, MG5.MG5_CODREF, MG5.MG5_CODPRD, MG5.MG5_CODMON, MG5.MG5_REFSUB, MG5.MG5_REFPRI, "
    cQry += " SB1.B1_DESC AS PRODUCTDESC, ME0.ME0_NOME AS MANUFACTURERNAME "
    cQry += " FROM " + RetSqlName('MG5') + " MG5 "
    cQry += " LEFT JOIN " + RetSqlName('SB1') + " SB1 ON SB1.B1_FILIAL = ? AND SB1.B1_COD = MG5.MG5_CODPRD AND SB1.D_E_L_E_T_ = ? "
    cQry += " LEFT JOIN " + RetSqlName('ME0') + " ME0 ON ME0.ME0_FILIAL = ? AND ME0.ME0_CODMON = MG5.MG5_CODMON AND ME0.D_E_L_E_T_ = ? "
    cQry += " WHERE MG5.MG5_FILIAL = ? "

    If !Empty(cReferenceCode)
        cQry += " AND MG5.MG5_CODREF = ? "
    EndIf

    If !Empty(cMainReference)
        cQry += " AND MG5.MG5_REFPRI = ? "
    EndIf

    If !Empty(cManufacturerCode)
        cQry += " AND MG5.MG5_CODMON = ? "
    EndIf

    If !Empty(cProductCode)
        cQry += " AND MG5.MG5_CODPRD = ? "
    EndIf

    If !Empty(cSubstituteReference)
        cQry += " AND UPPER(MG5.MG5_REFSUB) LIKE ? "
    EndIf

    cQry += " AND MG5.D_E_L_E_T_ = ? "
    cQry += " ORDER BY MG5.MG5_CODREF "

    cQry := ChangeQuery(cQry)
    oQueryQry := FwExecStatement():New(cQry)

    oQueryQry:SetString(nSeq++, xFilial('SB1'))
    oQueryQry:SetString(nSeq++, Space(1))
    oQueryQry:SetString(nSeq++, xFilial('ME0'))
    oQueryQry:SetString(nSeq++, Space(1))
    oQueryQry:SetString(nSeq++, xFilial('MG5'))

    If !Empty(cReferenceCode)
        oQueryQry:SetString(nSeq++, PadR(cReferenceCode, TamSx3('MG5_CODREF')[1]))
    EndIf

    If !Empty(cMainReference)
        oQueryQry:SetString(nSeq++, PadR(cMainReference, TamSx3('MG5_REFPRI')[1]))
    EndIf

    If !Empty(cManufacturerCode)
        oQueryQry:SetString(nSeq++, PadR(cManufacturerCode, TamSx3('MG5_CODMON')[1]))
    EndIf

    If !Empty(cProductCode)
        oQueryQry:SetString(nSeq++, PadR(cProductCode, TamSx3('MG5_CODPRD')[1]))
    EndIf

    If !Empty(cSubstituteReference)
        oQueryQry:SetString(nSeq++, "%" + Upper(cSubstituteReference) + "%")
    EndIf

    oQueryQry:SetString(nSeq++, Space(1))

    cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

    While (cAliasQry)->(!EOF())
        jItem := JsonObject():New()

        jItem['branch']              := AllTrim((cAliasQry)->MG5_FILIAL)
        jItem['referenceCode']       := AllTrim((cAliasQry)->MG5_CODREF)
        jItem['productCode']         := AllTrim((cAliasQry)->MG5_CODPRD)
        jItem['productDescription']  := AllTrim((cAliasQry)->PRODUCTDESC)
        jItem['manufacturerCode']    := AllTrim((cAliasQry)->MG5_CODMON)
        jItem['manufacturerName']    := AllTrim((cAliasQry)->MANUFACTURERNAME)
        jItem['substituteReference'] := AllTrim((cAliasQry)->MG5_REFSUB)
        jItem['mainReference']       := AllTrim((cAliasQry)->MG5_REFPRI)

        aAdd(aItens, jItem)

        jItem := Nil
        (cAliasQry)->(DbSkip())
    EndDo

    (cAliasQry)->(DbCloseArea())
    oQueryQry:Destroy()
    oQueryQry := Nil

    RestArea(aArea)

Return aItens


/*/{Protheus.doc} CountReferenceCode
    Retorna quantidade total de registros MG5 validos
    @type    method
    @author  eduardo.FLima
    @since   09/06/2026
    @version P12
    @return  Numeric                 , Quantidade total de registros MG5 validos
/*/
Method CountReferenceCode() as Numeric Class RetailAutopartsCatalogReferenceCodeController
    Local oQueryQry   := Nil as Object
    Local cQry        := "" as Character
    Local nSeq        := 1 as Numeric
    Local nTotal      := 0 as Numeric
    Local aArea       := GetArea() as Array

    cQry := " SELECT COUNT(1) AS TOTAL "
    cQry += " FROM " + RetSqlName('MG5') + " MG5 "
    cQry += " WHERE MG5.MG5_FILIAL = ? "
    cQry += " AND MG5.D_E_L_E_T_ = ? "

    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)
    oQueryQry:SetString(nSeq++, xFilial('MG5'))
    oQueryQry:SetString(nSeq++, Space(1))
    nTotal := Val(cValToChar(oQueryQry:ExecScalar('TOTAL')))//ExecScalar retorna xValue (variant); se o banco retornar Nil (query sem resultado ou erro), a atribuição a nTotal as Numeric pode causar comportamento indefinido na serialização JSON

    RestArea(aArea)

    oQueryQry:Destroy()
    oQueryQry := Nil

Return nTotal


/*/{Protheus.doc} IsDeleteAllowed
    Regras de bloqueio para exclusao logica de codigo referencial
     - Verifica se existem movimentacoes vinculadas no ERP para o codigo referencial informado
     - Verifica se o codigo referencial esta sendo utilizado como referencia substituta em outro registro
     - Outras regras de negocio podem ser adicionadas futuramente conforme necessidade
    @type    method
    @author  eduardo.FLima
    @since   09/06/2026
    @version P12
    @param   cBranch            , Character, Codigo da filial
    @param   cProductCode       , Character, Codigo do produto
    @param   cReferenceCode     , Character, Codigo de referencia
    @param   cManufacturerCode  , Character, Codigo do fabricante
    @return  Array                  , Array[1] Logical indicando se a exclusao e permitida, Array[2] String com mensagem de bloqueio em caso de exclusao nao permitida
/*/
Method IsDeleteAllowed(cBranch as Character, cProductCode as Character, cReferenceCode as Character, cManufacturerCode as Character) as Array Class RetailAutopartsCatalogReferenceCodeController
    Local lAllowed := .T. as Logical
    Local cMessage := "" as Character
    Local aRet     := {} as Array

    If lAllowed .And. Self:IsReferenceUsedAsSubstitute(cBranch, cReferenceCode)
        lAllowed := .F.
        cMessage := STR0012 //"Exclusão bloqueada: o código referencial está sendo utilizado como referência substituta em outro registro"
    EndIf

    aRet := {lAllowed, cMessage}

Return aRet


/*/{Protheus.doc} IsReferenceUsedAsSubstitute
    Verifica se o codigo referencial e utilizado como MG5_REFSUB em outro registro
     - A consulta e direta na tabela MG5 buscando por registros ativos que tenham o codigo referencial informado no campo MG5_REFSUB
    @type    method
    @author  eduardo.FLima
    @since   09/06/2026
    @version P12
    @param   cBranch            , Character, Codigo da filial
    @param   cReferenceCode     , Character, Codigo de referencia
    @return  Logical            , Logical indicando se o codigo referencial e utilizado como referencia substituta em outro registro
/*/

Method IsReferenceUsedAsSubstitute(cBranch as Character, cReferenceCode as Character) as Logical Class RetailAutopartsCatalogReferenceCodeController
    Local lUsed        := .F. as Logical
    Local oQueryQry    := Nil as Object
    Local cQry         := "" as Character
    Local cAliasQry    := "" as Character
    Local nSeq         := 1 as Numeric

    cQry := " SELECT MG5.R_E_C_N_O_ AS RECNO "
    cQry += " FROM " + RetSqlName('MG5') + " MG5 "
    cQry += " WHERE MG5.MG5_FILIAL = ? "
    cQry += " AND MG5.MG5_REFSUB = ? "
    cQry += " AND MG5.D_E_L_E_T_ = ? "

    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)
    oQueryQry:SetString(nSeq++, PadR(cBranch, TamSx3('MG5_FILIAL')[1]))
    oQueryQry:SetString(nSeq++, PadR(cReferenceCode, TamSx3('MG5_CODREF')[1]))
    oQueryQry:SetString(nSeq++, Space(1))

    cAliasQry := oQueryQry:OpenAlias(GetNextAlias())
    lUsed := (cAliasQry)->(!EOF())

    (cAliasQry)->(DbCloseArea())

    oQueryQry:Destroy()
    oQueryQry := Nil

Return lUsed
