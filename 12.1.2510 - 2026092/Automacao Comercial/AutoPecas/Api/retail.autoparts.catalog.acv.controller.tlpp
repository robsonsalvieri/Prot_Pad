#include "tlpp-core.th"
#include "totvs.ch"
#include "tlpp-rest.th"
#include "fwmvcdef.ch"
#include "retail.autoparts.catalog.acv.controller.ch"

namespace totvs.protheus.retail.autoparts.catalog.acv.controller

/*/{Protheus.doc} RetailAutopartsCatalogAcvController
    API de Classificacao Mercadologica do Catalogo Geral (ACV)
    @type    class
    @author  fabio.favaretto
    @since   24/07/2026
    @version P12
/*/
Class RetailAutopartsCatalogAcvController

    private Method FindClassifications(cCodPro as Character) as Array
    private Method ExistsClassification(cCatego as Character, cCodPro as Character) as Logical
    private Method PositionACV(cCatego as Character, cCodPro as Character) as Logical
    private Method FindACVLineIndex(oModelACV as Object, cGrupo as Character, cCodPro as Character, cRefGrd as Character) as Numeric

    public Method New()

    @Get("/api/acv", description="Consulta classificacoes mercadologicas do produto (ACV JOIN ACU). Query: codpro")
    public Method getDataForAcv()

    @Post("/api/acv", description="Inclui classificacao mercadologica do produto na ACV")
    public Method postDataForAcv()

    @Delete("/api/acv/:catego/:codpro", description="Exclui logicamente classificacao mercadologica por catego e codpro")
    public Method deleteDataForAcv()

EndClass

/*/{Protheus.doc} New
    Metodo construtor
    @type   method
    @author fabio.favaretto
    @since  24/07/2026
    @version P12
/*/
Method New() Class RetailAutopartsCatalogAcvController
Return Self

/*/{Protheus.doc} getDataForAcv
    Retorna classificacoes mercadologicas do produto
    @type    method
    @author  fabio.favaretto
    @since   24/07/2026
    @version P12
    @return  Logical
/*/
Method getDataForAcv() Class RetailAutopartsCatalogAcvController
    Local oJsonRespo as Object
    Local oJParametr as Object
    Local aItens     as Array
    Local cCodPro    as Character
    Local lContinua  as Logical

    oJsonRespo := JsonObject():New()
    aItens     := {}
    oJParametr := oRest:getQueryRequest()
    cCodPro    := ""
    lContinua  := .T.

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    If oJParametr:hasProperty("codpro") .And. oJParametr["codpro"] != Nil .And. !Empty(oJParametr["codpro"])
        cCodPro := AllTrim(oJParametr["codpro"])
    EndIf

    If Empty(cCodPro)
        oRest:setStatusCode(400)
        oJsonRespo["success"] := .F.
        oJsonRespo["message"] := STR0001 //"Parametro codpro e obrigatorio"
        lContinua := .F.
    EndIf

    If lContinua .And. !ExistCpo("SB1", cCodPro)
        oRest:setStatusCode(404)
        oJsonRespo["success"] := .F.
        oJsonRespo["message"] := STR0002 //"Produto nao encontrado"
        lContinua := .F.
    EndIf

    If lContinua
        aItens := Self:FindClassifications(cCodPro)
        oJsonRespo["items"] := aItens
        oRest:setStatusCode(200)
    EndIf

    oRest:setResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

Return .T.

/*/{Protheus.doc} postDataForAcv
    Inclui classificacao mercadologica via modelo FATA150A (ACVDETAIL)
    @type    method
    @author  fabio.favaretto
    @since   24/07/2026
    @version P12
    @return  Logical
/*/
Method postDataForAcv() Class RetailAutopartsCatalogAcvController
    Local oJsBody    as Object
    Local oJsonRespo as Object
    Local oModel     as Object
    Local oModelACV  as Object
    Local cCodPro    as Character
    Local cCatego    as Character
    Local cGrupo     as Character
    Local lContinua  as Logical
    Local lGravouOK  as Logical
    Local aErros     as Array
    Local cMsgErro   as Character
    Local oError     as Object

    oJsBody    := JsonObject():New()
    oJsonRespo := JsonObject():New()
    oModel     := Nil
    oModelACV  := Nil
    oError     := Nil
    cCodPro    := ""
    cCatego    := ""
    cGrupo     := ""
    lContinua  := .T.
    lGravouOK  := .F.
    aErros     := {}
    cMsgErro   := ""

    oRest:setKeyHeaderResponse("Content-Type", "application/json")
    oJsBody:fromJson(oRest:GetBodyRequest())

    If oJsBody["codpro"] != Nil
        cCodPro := AllTrim(oJsBody["codpro"])
    EndIf

    If oJsBody["catego"] != Nil
        cCatego := AllTrim(oJsBody["catego"])
    EndIf

    If oJsBody["grupo"] != Nil .And. !Empty(oJsBody["grupo"])
        cGrupo := AllTrim(oJsBody["grupo"])
    EndIf

    If Empty(cCodPro) .Or. Empty(cCatego)
        oRest:setStatusCode(400)
        oJsonRespo["success"] := .F.
        oJsonRespo["message"] := STR0010 //"Campos codpro e catego sao obrigatorios"
        lContinua := .F.
    EndIf

    If lContinua .And. !ExistCpo("SB1", cCodPro)
        oRest:setStatusCode(404)
        oJsonRespo["success"] := .F.
        oJsonRespo["message"] := STR0002 //"Produto nao encontrado"
        lContinua := .F.
    EndIf

    If lContinua .And. !ExistCpo("ACU", cCatego)
        oRest:setStatusCode(400)
        oJsonRespo["success"] := .F.
        oJsonRespo["message"] := STR0011 //"Categoria nao encontrada"
        lContinua := .F.
    EndIf

    If lContinua .And. !Empty(cGrupo) .And. !ExistCpo("SBM", cGrupo)
        oRest:setStatusCode(400)
        oJsonRespo["success"] := .F.
        oJsonRespo["message"] := STR0003 //"Grupo de Produto nao encontrado"
        lContinua := .F.
    EndIf

    If lContinua .And. Self:ExistsClassification(cCatego, cCodPro)
        oRest:setStatusCode(409)
        oJsonRespo["success"] := .F.
        oJsonRespo["message"] := STR0004 //"Categoria ja classificada para este produto"
        lContinua := .F.
    EndIf

    If lContinua

        oModel := FWLoadModel("FATA150A")
        oModel:SetOperation(MODEL_OPERATION_INSERT)
        oModel:Activate()

        oModelACV := oModel:GetModel("ACVDETAIL")
        oModelACV:AddLine()
        oModelACV:SetValue("ACV_CATEGO", cCatego)
        oModelACV:SetValue("ACV_CODPRO", cCodPro)
        oModelACV:SetValue("ACV_GRUPO", cGrupo)
        oModelACV:SetValue("ACV_REFGRD", "")

        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        EndIf

        If lGravouOK
            oRest:setStatusCode(201)
            oJsonRespo["success"] := .T.
            oJsonRespo["message"] := STR0005 //"Classificacao mercadologica cadastrada com sucesso"
            oJsonRespo["catego"]  := AllTrim(ACV->ACV_CATEGO)
            oJsonRespo["refgrd"]  := AllTrim(ACV->ACV_REFGRD)
            oJsonRespo["codpro"]  := AllTrim(ACV->ACV_CODPRO)
            oJsonRespo["grupo"]   := AllTrim(ACV->ACV_GRUPO)
        EndIf

        If ValType(oModel) == "O"
            oModel:DeActivate()
            FreeObj(oModel)
            oModel := Nil
        EndIf
    EndIf

    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJsBody)

Return .T.

/*/{Protheus.doc} deleteDataForAcv
    Exclui logicamente classificacao mercadologica via FATA150A (DeleteLine no ACVDETAIL)
    @type    method
    @author  fabio.favaretto
    @since   24/07/2026
    @version P12
    @return  Logical
/*/
Method deleteDataForAcv() Class RetailAutopartsCatalogAcvController
    Local oJsonRespo as Object
    Local oJPath     as Object
    Local oModel     as Object
    Local oModelACV  as Object
    Local cCatego    as Character
    Local cCodPro    as Character
    Local cGrupo     as Character
    Local cRefGrd    as Character
    Local lContinua  as Logical
    Local lGravouOK  as Logical
    Local aArea      as Array
    Local aErros     as Array
    Local cMsgErro   as Character
    Local oError     as Object
    Local nLine      as Numeric

    oJsonRespo := JsonObject():New()
    oJPath     := oRest:getPathParamsRequest()
    oModel     := Nil
    oModelACV  := Nil
    oError     := Nil
    cCatego    := ""
    cCodPro    := ""
    cGrupo     := ""
    cRefGrd    := ""
    lContinua  := .T.
    lGravouOK  := .F.
    aArea      := GetArea()
    aErros     := {}
    cMsgErro   := ""
    nLine      := 0

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    If oJPath:hasProperty("catego") .And. oJPath["catego"] != Nil
        cCatego := AllTrim(oJPath["catego"])
    EndIf

    If oJPath:hasProperty("codpro") .And. oJPath["codpro"] != Nil
        cCodPro := AllTrim(oJPath["codpro"])
    EndIf

    If Empty(cCatego) .Or. Empty(cCodPro)
        oRest:setStatusCode(400)
        oJsonRespo["success"] := .F.
        oJsonRespo["message"] := STR0010 //"Campos codpro e catego sao obrigatorios"
        lContinua := .F.
    EndIf

    If lContinua .And. !Self:PositionACV(cCatego, cCodPro)
        oRest:setStatusCode(404)
        oJsonRespo["success"] := .F.
        oJsonRespo["message"] := STR0007 //"Classificacao nao encontrada"
        lContinua := .F.
    EndIf

    If lContinua
        cGrupo  := AllTrim(ACV->ACV_GRUPO)
        cRefGrd := AllTrim(ACV->ACV_REFGRD)

        oModel := FWLoadModel("FATA150A")
        oModel:SetOperation(MODEL_OPERATION_UPDATE)
        oModel:Activate()

        oModelACV := oModel:GetModel("ACVDETAIL")
        nLine := Self:FindACVLineIndex(oModelACV, cGrupo, cCodPro, cRefGrd)

        If nLine > 0
            oModelACV:GoLine(nLine)
            oModelACV:DeleteLine()

            If oModel:VldData()
                lGravouOK := oModel:CommitData()
            EndIf
        EndIf

        If lGravouOK
            oRest:setStatusCode(200)
            oJsonRespo["success"] := .T.
            oJsonRespo["message"] := STR0008 //"Classificacao mercadologica excluida com sucesso"
        EndIf

        If ValType(oModel) == "O"
            oModel:DeActivate()
            FreeObj(oModel)
            oModel := Nil
        EndIf
    EndIf

    RestArea(aArea)

    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJPath)

Return .T.

/*/{Protheus.doc} FindACVLineIndex
    Localiza a linha no grid ACVDETAIL pela chave grupo+produto+refgrd
    @type    method
    @author  fabio.favaretto
    @since   27/07/2026
    @version P12
    @param   oModelACV, Object, grid ACVDETAIL
    @param   cGrupo   , Character, ACV_GRUPO
    @param   cCodPro  , Character, ACV_CODPRO
    @param   cRefGrd  , Character, ACV_REFGRD
    @return  Numeric
/*/
Method FindACVLineIndex(oModelACV as Object, cGrupo as Character, cCodPro as Character, cRefGrd as Character) as Numeric Class RetailAutopartsCatalogAcvController
    Local nLine  as Numeric
    Local nTotal as Numeric
    Local nX     as Numeric

    nLine  := 0
    nTotal := oModelACV:Length()
    nX     := 0

    For nX := 1 To nTotal
        If AllTrim(oModelACV:GetValue("ACV_GRUPO", nX)) == AllTrim(cGrupo) .And. ;
           AllTrim(oModelACV:GetValue("ACV_CODPRO", nX)) == AllTrim(cCodPro) .And. ;
           AllTrim(oModelACV:GetValue("ACV_REFGRD", nX)) == AllTrim(cRefGrd)
            nLine := nX
            Exit
        EndIf
    Next nX

Return nLine

/*/{Protheus.doc} FindClassifications
    Lista classificacoes ACV do produto com dados da ACU
    @type    method
    @author  fabio.favaretto
    @since   24/07/2026
    @version P12
    @param   cCodPro, Character, codigo do produto
    @return  Array
/*/
Method FindClassifications(cCodPro as Character) as Array Class RetailAutopartsCatalogAcvController
    Local oQueryQry  as Object
    Local jItem      as Object
    Local aItens     as Array
    Local cQry       as Character
    Local cAliasQry  as Character
    Local nSeq       as Numeric
    Local aArea      as Array
    Local cCodPaiOut as Character

    aItens := {}
    nSeq   := 1
    aArea  := GetArea()

    cQry := " SELECT ACV.ACV_CATEGO, ACV.ACV_REFGRD, ACV.ACV_CODPRO, ACV.ACV_GRUPO, "
    cQry += " ACU.ACU_DESC AS DESCCATEG, ACU.ACU_CODPAI AS CODPAI "
    cQry += " FROM " + RetSqlName("ACV") + " ACV "
    cQry += " LEFT JOIN " + RetSqlName("ACU") + " ACU "
    cQry += "   ON ACU.ACU_FILIAL = ? AND ACU.ACU_COD = ACV.ACV_CATEGO AND ACU.D_E_L_E_T_ = ? "
    cQry += " WHERE ACV.ACV_FILIAL = ? "
    cQry += " AND ACV.ACV_CODPRO = ? "
    cQry += " AND ACV.D_E_L_E_T_ = ? "
    cQry += " ORDER BY ACV.ACV_CATEGO "
    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)
    oQueryQry:SetString(nSeq++, xFilial("ACU"))
    oQueryQry:SetString(nSeq++, Space(1))
    oQueryQry:SetString(nSeq++, xFilial("ACV"))
    oQueryQry:SetString(nSeq++, PadR(cCodPro, TamSx3("ACV_CODPRO")[1]))
    oQueryQry:SetString(nSeq++, Space(1))

    cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

    While (cAliasQry)->(!EOF())
        jItem := JsonObject():New()
        jItem["catego"]    := AllTrim((cAliasQry)->ACV_CATEGO)
        jItem["refgrd"]    := AllTrim((cAliasQry)->ACV_REFGRD)
        jItem["codpro"]    := AllTrim((cAliasQry)->ACV_CODPRO)
        jItem["grupo"]     := AllTrim((cAliasQry)->ACV_GRUPO)
        jItem["descCateg"] := AllTrim((cAliasQry)->DESCCATEG)

        cCodPaiOut := AllTrim((cAliasQry)->CODPAI)
        If Empty(cCodPaiOut)
            jItem["codpai"] := Nil
        Else
            jItem["codpai"] := cCodPaiOut
        EndIf

        aAdd(aItens, jItem)
        jItem := Nil
        (cAliasQry)->(DbSkip())
    EndDo

    (cAliasQry)->(DbCloseArea())
    oQueryQry:Destroy()
    oQueryQry := Nil

    RestArea(aArea)

Return aItens

/*/{Protheus.doc} ExistsClassification
    Verifica duplicidade ativa ACV_CATEGO + ACV_CODPRO
    @type    method
    @author  fabio.favaretto
    @since   24/07/2026
    @version P12
    @param   cCatego, Character, codigo da categoria
    @param   cCodPro, Character, codigo do produto
    @return  Logical
/*/
Method ExistsClassification(cCatego as Character, cCodPro as Character) as Logical Class RetailAutopartsCatalogAcvController
    Local oQueryQry as Object
    Local cQry      as Character
    Local cAliasQry as Character
    Local nSeq      as Numeric
    Local lExists   as Logical
    Local aArea     as Array

    lExists := .F.
    nSeq    := 1
    aArea   := GetArea()

    cQry := " SELECT ACV.R_E_C_N_O_ AS RECNO "
    cQry += " FROM " + RetSqlName("ACV") + " ACV "
    cQry += " WHERE ACV.ACV_FILIAL = ? "
    cQry += " AND ACV.ACV_CATEGO = ? "
    cQry += " AND ACV.ACV_CODPRO = ? "
    cQry += " AND ACV.D_E_L_E_T_ = ? "
    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)
    oQueryQry:SetString(nSeq++, xFilial("ACV"))
    oQueryQry:SetString(nSeq++, PadR(cCatego, TamSx3("ACV_CATEGO")[1]))
    oQueryQry:SetString(nSeq++, PadR(cCodPro, TamSx3("ACV_CODPRO")[1]))
    oQueryQry:SetString(nSeq++, Space(1))

    cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

    If (cAliasQry)->(!EOF())
        lExists := .T.
    EndIf

    (cAliasQry)->(DbCloseArea())
    oQueryQry:Destroy()
    oQueryQry := Nil

    RestArea(aArea)

Return lExists

/*/{Protheus.doc} PositionACV
    Posiciona ACV pelo par catego + codpro (registro ativo)
    @type    method
    @author  fabio.favaretto
    @since   24/07/2026
    @version P12
    @param   cCatego, Character, codigo da categoria
    @param   cCodPro, Character, codigo do produto
    @return  Logical
/*/
Method PositionACV(cCatego as Character, cCodPro as Character) as Logical Class RetailAutopartsCatalogAcvController
    Local oQueryQry as Object
    Local cQry      as Character
    Local cAliasQry as Character
    Local nSeq      as Numeric
    Local lFound    as Logical
    Local nRecno    as Numeric
    Local aArea     as Array

    lFound := .F.
    nSeq   := 1
    nRecno := 0
    aArea  := GetArea()

    cQry := " SELECT ACV.R_E_C_N_O_ AS RECNO "
    cQry += " FROM " + RetSqlName("ACV") + " ACV "
    cQry += " WHERE ACV.ACV_FILIAL = ? "
    cQry += " AND ACV.ACV_CATEGO = ? "
    cQry += " AND ACV.ACV_CODPRO = ? "
    cQry += " AND ACV.D_E_L_E_T_ = ? "
    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)
    oQueryQry:SetString(nSeq++, xFilial("ACV"))
    oQueryQry:SetString(nSeq++, PadR(cCatego, TamSx3("ACV_CATEGO")[1]))
    oQueryQry:SetString(nSeq++, PadR(cCodPro, TamSx3("ACV_CODPRO")[1]))
    oQueryQry:SetString(nSeq++, Space(1))

    cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

    If (cAliasQry)->(!EOF())
        nRecno := (cAliasQry)->RECNO
        lFound := .T.
    EndIf

    (cAliasQry)->(DbCloseArea())
    oQueryQry:Destroy()
    oQueryQry := Nil

    RestArea(aArea)

    If lFound
        DbSelectArea("ACV")
        ACV->(DbGoTo(nRecno))
    EndIf

Return lFound
