#include "totvs.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "fwmvcdef.ch"
#include "retail.autoparts.catalog.productmanufacturer.controller.ch"

namespace totvs.protheus.retail.autoparts.catalog.productmanufacturer.controller


/*/{Protheus.doc} RetailAutopartsCatalogProductManufacturerController
    API relacionadas ao cadastro de Produto x Fabricante do catalogo de autopecas
    @type    class
    @author  Alberto Deviciente
    @since   24/05/2026
    @version P12
/*/
Class RetailAutopartsCatalogProductManufacturerController

    private Method FindProductManufacturer(cCodProd as Character, cFilFab as Character, cCodFab as Character, cLojaFab as Character) as Array
    private Method ValidateFieldSize(cFieldJson as Character, cConteudoJson as Character, cFieldProt as Character, cMsg as Character) as Logical

    public Method New()

    @Get("/api/retail/v1/retailAutopartsCatalogProductManufacturer/getDataForProductManufacturer", description="Consulta os registros de Produto x Fabricante do catalogo de autopecas.")
    public Method getDataForProductManufacturer()

    @Post("/api/retail/v1/retailAutopartsCatalogProductManufacturer/postDataForProductManufacturer", description="Cadastra um novo registro de Produto x Fabricante no catalogo de autopecas.")
    public Method postDataForProductManufacturer()

    @Put("/api/retail/v1/retailAutopartsCatalogProductManufacturer/putDataForProductManufacturer", description="Altera um registro existente de Produto x Fabricante no catalogo de autopecas.")
    public Method putDataForProductManufacturer()

    @Delete("/api/retail/v1/retailAutopartsCatalogProductManufacturer/deleteDataForProductManufacturer/:productCode/:manufacturerCode/:manufacturerStore", description="Deleta um registro de Produto x Fabricante do catalogo de autopecas.")
    public Method deleteDataForProductManufacturer()

EndClass

/*/{Protheus.doc} New
    Metodo construtor
    @type    method
    @author  Alberto Deviciente
    @since   24/05/2026
    @version P12 
    @return  Object, Objeto da classe
/*/
Method New() Class RetailAutopartsCatalogProductManufacturerController
Return Self

/*/{Protheus.doc} getDataForProductManufacturer
    Retorna os registros de Produto x Fabricante do catalogo de autopecas
    @type    method
    @author  Alberto Deviciente
    @since   24/05/2026
    @version P12
    @return  Logical, True (.T.)
/*/
Method getDataForProductManufacturer() Class RetailAutopartsCatalogProductManufacturerController
    Local oJsonRespo    as Object
    Local oJParametr    as Object
    Local aArea         as Array
    Local aItens        as Array
    Local cCodProd      as Character
    Local cFilFab       as Character
    Local cCodFab       as Character
    Local cLojaFab      as Character
    Local cResposta     as Character

    oJsonRespo  := JsonObject():New()
    oJParametr  := JsonObject():New()
    aArea       := GetArea()
    aItens      := {}
    cCodProd    := ""
    cFilFab     := ""
    cCodFab     := ""
    cLojaFab    := ""
    cResposta   := ""
    
    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    oJParametr := oRest:getQueryRequest()

    // Obtém os parâmetros informados na requisição via URL (query param)
  	If oJParametr:hasProperty('productCode')
        cCodProd := oJParametr['productCode']
    EndIf
    If oJParametr:hasProperty('manufacturerBranch')
        cFilFab := oJParametr['manufacturerBranch']
    EndIf
    If oJParametr:hasProperty('manufacturerCode')
        cCodFab := oJParametr['manufacturerCode']
    EndIf
    If oJParametr:hasProperty('manufacturerStore')
        cLojaFab := oJParametr['manufacturerStore']
    EndIf

    aItens := Self:FindProductManufacturer(cCodProd, cFilFab, cCodFab, cLojaFab)

    If Len(aItens) > 0
        oJsonRespo["items"] := aItens
        oRest:setStatusCode(200)  // HTTP 200 = Sucesso
    Else
        oJsonRespo["items"]   := {}
        oJsonRespo["message"] := STR0001 //"Dados nao encontrados para o filtro informado"
        oRest:setStatusCode(404)  // HTTP 404 = Not Found
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    cResposta := oJsonRespo:toJson()
    oRest:setResponse(cResposta)

    FreeObj(oJParametr)
    FreeObj(oJsonRespo)

    RestArea(aArea)

Return .T.

/*/{Protheus.doc} postDataForProductManufacturer
    Cadastro de Produto x Fabricante no catalogo de autopecas
    @type    method
    @author  Alberto Deviciente
    @since   24/05/2026
    @version P12
    @return  Logical, True (.T.)
/*/
Method postDataForProductManufacturer() Class RetailAutopartsCatalogProductManufacturerController
    Local oJsBody       as Object
    Local oJsonRespo    as Object
    Local oModel        as Object
    Local oModelMG1     as Object
    Local cCodProd      as Character
    Local cFilFab       as Character
    Local cCodFab       as Character
    Local cLojaFab      as Character
    Local lGravouOK     as Logical
    Local aErros        as Array
    Local aArea         as Array
    Local cResposta     as Character

    oJsBody     := JsonObject():New()
    oJsonRespo  := JsonObject():New()
    oModel      := Nil
    oModelMG1   := Nil
    cCodProd    := ""
    cFilFab     := xFilial("SA2")
    cCodFab     := ""
    cLojaFab    := ""
    lGravouOK   := .F.
    aErros      := {}
    aArea       := GetArea()
    cResposta   := ""

    dbSelectArea("MG1")

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    oJsBody:fromJson(oRest:GetBodyRequest())

    // Obtém os dados enviados na Requisição (Body)
    If oJsBody:hasProperty('productCode')
        cCodProd := oJsBody['productCode']
    EndIf
    If oJsBody:hasProperty('manufacturerBranch')
        cFilFab := oJsBody['manufacturerBranch']
    EndIf
    If oJsBody:hasProperty('manufacturerCode')
        cCodFab := oJsBody['manufacturerCode']
    EndIf
    If oJsBody:hasProperty('manufacturerStore')
        cLojaFab := oJsBody['manufacturerStore']
    EndIf

    // ==========================================
    // Carrega o Model MVC
    // ==========================================
    oModel := FWLoadModel("LOJA680")
    oModel:SetOperation(MODEL_OPERATION_INSERT)
    oModel:Activate()

    oModelMG1 := oModel:GetModel("MG1MASTER")

    // ==========================================
    // Alimenta os Campos do Model
    // ==========================================
    oModelMG1:SetValue("MG1_CODPRD", cCodProd)
    oModelMG1:SetValue("MG1_FILFAB", cFilFab)
    oModelMG1:SetValue("MG1_CODFAB", cCodFab)
    oModelMG1:SetValue("MG1_LOJFAB", cLojaFab)

    // ==========================================
    // Valida os dados do Model
    // ==========================================
    If oModel:VldData()
        // ==========================================
        // Grava os dados do Model
        // ==========================================
        lGravouOK := oModel:CommitData()
    EndIf

    If lGravouOK
        oRest:setStatusCode(201)  // HTTP 201 = Created
        oJsonRespo['success'] := .T.
        oJsonRespo['message'] := STR0002 + AllTrim(cCodProd) + STR0003 + AllTrim(cCodFab) + "/" + AllTrim(cLojaFab) + STR0004 //"Produto " ### " x Fabricante/Loja " ### "/" ### " cadastrado com sucesso"
        oJsonRespo['productCode'] := cCodProd
        oJsonRespo['manufacturerBranch'] := cFilFab
        oJsonRespo['manufacturerCode'] := cCodFab
        oJsonRespo['manufacturerStore'] := cLojaFab  
    Else
        oRest:setStatusCode(400)  // HTTP 400 = Bad Request

        // Captura os erros do Model
        aErros := oModel:GetErrorMessage()

        /*
        Estrutura do Array aErros:
        [1] = Id do formulário de origem
        [2] = Id do campo de origem
        [3] = Id do formulário de erro
        [4] = Id do campo de erro
        [5] = Id do erro
        [6] = Mensagem do erro
        [7] = Mensagem da solução
        [8] = Valor atribuído
        [9] = Valor anterior
        */
        oJsonRespo['success']   := .F.
        oJsonRespo['message']   := STR0005 //"Erro ao cadastrar"
        If Len(aErros) >= 7
            If !Empty(aErros[6])
                oJsonRespo['message']   := aErros[6]
            EndIf
            // Adiciona detalhes do erro se disponiveis
            If !Empty(aErros[4])
                oJsonRespo['field']     := aErros[4]
            EndIf
        EndIf
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    cResposta := oJsonRespo:toJson()
    oRest:setResponse(cResposta)

    // ==========================================
    // Desativa o modelo de dados
    // ==========================================
    oModel:DeActivate()

    // ==========================================
    // Libera Recursos da Memória
    // ==========================================
    FreeObj(oModel)
    FreeObj(oJsonRespo)
    FreeObj(oJsBody)

    RestArea(aArea)

Return .T.

/*/{Protheus.doc} putDataForProductManufacturer
    Altera o registro de Produto x Fabricante no catalogo de autopecas
    @type    method
    @author  Alberto Deviciente
    @since   24/05/2026
    @version P12
    @return  Logical, True (.T.)
/*/
Method putDataForProductManufacturer() Class RetailAutopartsCatalogProductManufacturerController
    Local oJsonRespo    as Object
    Local oJsBody       as Object
    Local oJParametr    as Object
    Local oModel        as Object
    Local oModelMG1     as Object
    Local lGravouOK     as Logical
    Local lContinua     as Logical
    Local cCodProd      as Character
    Local cCodFab       as Character
    Local cLojaFab      as Character
    Local aArea         as Array
    Local cFilMG1       as Character
    Local cFilSA2       as Character
    Local cFilSB1       as Character
    Local aErros        as Array
    Local nStatusCode   as Numeric
    Local cMsg          as Character
    Local cPesqCodProd  as Character
    Local cPesqFilFab   as Character
    Local cPesqCodFab   as Character
    Local cPesqLojaFab  as Character
    Local cResposta     as Character

    oJsonRespo  := JsonObject():New()
    oJsBody     := JsonObject():New()
    oModel      := Nil
    oModelMG1   := Nil
    lGravouOK   := .F.
    lContinua   := .T.
    cCodProd    := ""
    cCodFab     := ""
    cLojaFab    := ""
    aArea       := {}
    aErros      := {}
    nStatusCode := 0
    cMsg        := STR0011 //"Erro ao atualizar"
    cFilMG1     := xFilial("MG1")
    cFilSA2     := xFilial("SA2")
    cFilSB1     := xFilial("SB1")
    cPesqCodProd:= ""
    cPesqFilFab := cFilSA2
    cPesqCodFab := ""
    cPesqLojaFab:= ""
    cResposta   := ""


    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Obtém os dados enviados na Requisição (Via Query Params). Para localizar o registro a ser alterado.
    oJParametr  := oRest:getQueryRequest()

    // Obtém os parâmetros informados na requisição via URI (query param). Para localizar o registro a ser alterado.
    If oJParametr:hasProperty('productCode')
        cPesqCodProd := oJParametr['productCode']
    EndIf
    If oJParametr:hasProperty('manufacturerBranch')
        cPesqFilFab := oJParametr['manufacturerBranch']
    EndIf
    If oJParametr:hasProperty('manufacturerCode')
        cPesqCodFab := oJParametr['manufacturerCode']
    EndIf
    If oJParametr:hasProperty('manufacturerStore')
        cPesqLojaFab := oJParametr['manufacturerStore']
    EndIf

    //Verifica se os campos obrigatório para busca do registro foram informados
    If Empty(cPesqCodProd) .Or. Empty(cPesqCodFab) .Or. Empty(cPesqLojaFab)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := STR0006 + "'productCode', 'manufacturerCode', 'manufacturerStore'" //"Para a busca do registro a ser alterado, é obrigatório na requisição informar os seguintes parâmetros (Via Query Params): " ### "'productCode', 'manufacturerCode', 'manufacturerStore'"
        lContinua := .F.
    EndIf

    //Verifica se os campos para busca do registro não ultrapassam o tamanho máximo permitido
    If lContinua
        If !self:ValidateFieldSize("productCode", cPesqCodProd, "MG1_CODPRD", @cMsg) .Or. ;
            !self:ValidateFieldSize("manufacturerCode", cPesqCodFab, "MG1_CODFAB", @cMsg) .Or. ;
            !self:ValidateFieldSize("manufacturerStore", cPesqLojaFab, "MG1_LOJFAB", @cMsg)

            oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := cMsg
            lContinua := .F.
        EndIf
    EndIf

    If lContinua
        // Obtém os dados enviados na Requisição (Via Body Params). Dados a serem atualizados
        oJsBody:fromJson(oRest:GetBodyRequest())

        // Obtém os dados enviados na Requisição (Body)
        If oJsBody:hasProperty('productCode')
            cCodProd := oJsBody['productCode']
        EndIf
        If oJsBody:hasProperty('manufacturerBranch')
            cFilSA2 := oJsBody['manufacturerBranch']
        EndIf
        If oJsBody:hasProperty('manufacturerCode')
            cCodFab := oJsBody['manufacturerCode']
        EndIf
        If oJsBody:hasProperty('manufacturerStore')
            cLojaFab := oJsBody['manufacturerStore']
        EndIf

        If Empty(cCodProd) .And. Empty(cCodFab) .And. Empty(cLojaFab)
            oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0014 + "'productCode', 'manufacturerCode', 'manufacturerStore'" //"Pelo menos um dos campos deve ser enviado na requisição (Via Body Params): " ### "'productCode', 'manufacturerCode', 'manufacturerStore'"
            lContinua := .F.
        EndIf
    EndIf

    If lContinua
        aArea := GetArea()

        cPesqCodProd := PadR(cPesqCodProd,  TamSx3("MG1_CODPRD")[1])
        cPesqFilFab  := PadR(cPesqFilFab,   TamSx3("MG1_FILFAB")[1])
        cPesqCodFab  := PadR(cPesqCodFab,   TamSx3("MG1_CODFAB")[1])
        cPesqLojaFab := PadR(cPesqLojaFab,  TamSx3("MG1_LOJFAB")[1])
        
        dbSelectArea('MG1')
        MG1->(dbSetOrder(1)) //MG1_FILIAL+MG1_FILFAB+MG1_CODFAB+MG1_LOJFAB+MG1_FILPRD+MG1_CODPRD

        If !MG1->(dbSeek(cFilMG1 + cPesqFilFab + cPesqCodFab + cPesqLojaFab + cFilSB1 + cPesqCodProd))
            oRest:setStatusCode(404)  // HTTP 404 = Not Found
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0002 + AllTrim(cPesqCodProd) + STR0003 + AllTrim(cPesqCodFab) + "/" + AllTrim(cPesqLojaFab) + STR0009 //"Produto " ### " x Fabricante/Loja " ### "/" ### " nao encontrado"
            lContinua := .F.
        EndIf

        If lContinua
            // ==========================================
            // Carrega o Model MVC para Alteração
            // ==========================================
            oModel := FWLoadModel("LOJA680")
            oModel:SetOperation(MODEL_OPERATION_UPDATE)
            oModel:Activate()

            oModelMG1 := oModel:GetModel("MG1MASTER")

            If !Empty(cCodProd)
                oModelMG1:SetValue("MG1_CODPRD", cCodProd)
            EndIf
            If !Empty(cCodFab)
                oModelMG1:SetValue("MG1_CODFAB", cCodFab)
            EndIf
            If !Empty(cLojaFab)
                oModelMG1:SetValue("MG1_LOJFAB", cLojaFab)
            EndIf

            // ==========================================
            // Valida os dados do Model
            // ==========================================
            If oModel:VldData()
                // ==========================================
                // Grava os dados do Model
                // ==========================================
                lGravouOK := oModel:CommitData()
            EndIf

            If lGravouOK
                nStatusCode := 200 // HTTP 200 = OK
                cMsg        := STR0002 + AllTrim(cPesqCodProd) + STR0003 + AllTrim(cPesqCodFab) + "/" + AllTrim(cPesqLojaFab) + STR0010 //"Produto " ### " x Fabricante/Loja " ### "/" ### " atualizado com sucesso
            Else
                nStatusCode := 400 //HTTP 400 = Bad Request

                // Captura os erros do Model
                aErros := oModel:GetErrorMessage()

                /*
                Estrutura do Array aErros:
                [1] = Id do formulário de origem
                [2] = Id do campo de origem
                [3] = Id do formulário de erro
                [4] = Id do campo de erro
                [5] = Id do erro
                [6] = Mensagem do erro
                [7] = Mensagem da solução
                [8] = Valor atribuído
                [9] = Valor anterior
                */
                If Len(aErros) >= 7
                    If !Empty(aErros[6])
                        cMsg   := aErros[6]
                    EndIf
                    // Adiciona detalhes do erro se disponiveis
                    If !Empty(aErros[4])
                        oJsonRespo['field']     := aErros[4]
                    EndIf
                EndIf
            EndIf
            
            oRest:setStatusCode(nStatusCode)
            oJsonRespo['success'] := lGravouOK
            oJsonRespo['message'] := cMsg
            oJsonRespo['productCode'] := If(!Empty(cCodProd), cCodProd, cPesqCodProd)
            oJsonRespo['manufacturerBranch'] := If(!Empty(cFilSA2), cFilSA2, cPesqFilFab)
            oJsonRespo['manufacturerCode'] := If(!Empty(cCodFab), cCodFab, cPesqCodFab)
            oJsonRespo['manufacturerStore'] := If(!Empty(cLojaFab),cLojaFab, cPesqLojaFab)

            oModel:DeActivate()

            // ==========================================
            // Libera Recursos da Memória
            // ==========================================
            FreeObj(oModel)
        EndIf

        RestArea(aArea)
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    cResposta := oJsonRespo:toJson()
    oRest:setResponse(cResposta)

    // ==========================================
    // Libera Recursos da Memória
    // ==========================================
    FreeObj(oJParametr)
    FreeObj(oJsonRespo)
    FreeObj(oJsBody)

Return .T.

/*/{Protheus.doc} deleteDataForProductManufacturer
    Deleta o registro de Produto x Fabricante do catalogo de autopecas
    @type    method
    @author  Alberto Deviciente
    @since   24/05/2026
    @version P12
    @return  Logical, True (.T.)
/*/
Method deleteDataForProductManufacturer() Class RetailAutopartsCatalogProductManufacturerController
    Local oJsonRespo    as Object
    Local oJParametr    as Object
    Local oModel        as Object
    Local lGravouOK     as Logical
    Local lContinua     as Logical
    Local cCodProd      as Character
    Local cCodFab       as Character
    Local cLojaFab      as Character
    Local aArea         as Array
    Local cFilMG1       as Character
    Local cFilSA2       as Character
    Local cFilSB1       as Character
    Local nStatusCode   as Numeric
    Local cMsg          as Character
    Local cResposta     as Character

    oJsonRespo  := JsonObject():New()
    oModel      := Nil
    lGravouOK   := .F.
    lContinua   := .T.
    cCodProd    := ""
    cCodFab     := ""
    cLojaFab    := ""
    aArea       := {}
    cFilMG1     := xFilial("MG1")
    cFilSA2     := xFilial("SA2")
    cFilSB1     := xFilial("SB1")
    nStatusCode := 400 // HTTP 400 = Bad Request
    cMsg        := STR0013 //"Erro ao deletar"
    cResposta   := ""

    oJParametr  := oRest:getPathParamsRequest()

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Obtém os parâmetros informados na requisição
    If oJParametr:hasProperty('productCode')
        cCodProd := oJParametr['productCode']
    EndIf
    If oJParametr:hasProperty('manufacturerCode')
        cCodFab := oJParametr['manufacturerCode']
    EndIf
    If oJParametr:hasProperty('manufacturerStore')
        cLojaFab := oJParametr['manufacturerStore']
    EndIf

    If Empty(cCodProd) .Or. Empty(cCodFab) .Or. Empty(cLojaFab)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := STR0007 + "'productCode', 'manufacturerCode', 'manufacturerStore'" //"Para a busca do registro a ser excluído, é obrigatório na requisição informar os seguintes parâmetros (Via Path Params): " ### "'productCode', 'manufacturerCode', 'manufacturerStore'"
        lContinua := .F.
    EndIf

    //Verifica se os campos para busca do registro não ultrapassam o tamanho máximo permitido
    If lContinua
        If !self:ValidateFieldSize("productCode", cCodProd, "MG1_CODPRD", @cMsg) .Or. ;
            !self:ValidateFieldSize("manufacturerCode", cCodFab, "MG1_CODFAB", @cMsg) .Or. ;
            !self:ValidateFieldSize("manufacturerStore", cLojaFab, "MG1_LOJFAB", @cMsg)

            oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := cMsg
            lContinua := .F.
        EndIf
    EndIf

    If lContinua
        aArea := GetArea()

        cCodFab  := PadR(cCodFab, TamSx3("MG1_CODFAB")[1])
        cLojaFab := PadR(cLojaFab, TamSx3("MG1_LOJFAB")[1])
        cCodProd := PadR(cCodProd, TamSx3("MG1_CODPRD")[1])

        dbSelectArea('MG1')
        MG1->(dbSetOrder(1)) //MG1_FILIAL+MG1_FILFAB+MG1_CODFAB+MG1_LOJFAB+MG1_FILPRD+MG1_CODPRD

        If !MG1->(dbSeek(cFilMG1 + cFilSA2 + cCodFab + cLojaFab + cFilSB1 + cCodProd))
            oRest:setStatusCode(404)  // HTTP 404 = Not Found
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0002 + AllTrim(cCodProd) + STR0003 + AllTrim(cCodFab) + "/" + AllTrim(cLojaFab) + STR0009 //"Produto " ### " x Fabricante/Loja " ### "/" ### " nao encontrado"
            lContinua := .F.
        EndIf

        If lContinua
            // ==========================================
            // Carrega o Model MVC para Deleção
            // ==========================================
            oModel := FWLoadModel("LOJA680")
            oModel:SetOperation(MODEL_OPERATION_DELETE)
            oModel:Activate()

            If oModel:VldData()
                lGravouOK := oModel:CommitData()
            EndIf

            If lGravouOK
                nStatusCode := 200  // HTTP 200 = OK
                cMsg        := STR0002 + AllTrim(cCodProd) + STR0003 + AllTrim(cCodFab) + "/" + AllTrim(cLojaFab) + STR0012 //"Produto " ### " x Fabricante/Loja " ### "/" ### " deletado com sucesso"
            EndIf

            oRest:setStatusCode(nStatusCode)
            oJsonRespo['success'] := lGravouOK
            oJsonRespo['message'] := cMsg

            oModel:DeActivate()
            FreeObj(oModel)
        EndIf

        RestArea(aArea)
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    cResposta := oJsonRespo:toJson()
    oRest:setResponse(cResposta)

    // ==========================================
    // Libera Recursos da Memoria
    // ==========================================
    FreeObj(oJParametr)
    FreeObj(oJsonRespo)

Return .T.

/*/{Protheus.doc} FindProductManufacturer
    Consulta registros de Produto x Fabricante do catalogo de autopecas
    @type    method
    @author  Alberto Deviciente
    @since   24/05/2026
    @version P12
    @param   cCodProd  , Character , filtro pelo codigo do produto
    @param   cFilFab   , Character , filtro pela filial do fabricante
    @param   cCodFab   , Character , filtro pelo codigo do fabricante
    @param   cLojaFab  , Character , filtro pela loja do fabricante
    @return  aItens    , Array     , array de itens encontrados
/*/
Method FindProductManufacturer(cCodProd as Character, cFilFab as Character, cCodFab as Character, cLojaFab as Character) as Array Class RetailAutopartsCatalogProductManufacturerController
    Local oQueryQry     as Object
    Local jItem         as Object
    Local nSeq          as Numeric
    Local aItens        as Array
    Local aArea         as Array
    Local cQry          as Character
    Local cAliasQry     as Character

    Default cCodProd  := ""
    Default cFilFab   := ""
    Default cCodFab   := ""
    Default cLojaFab  := ""

    oQueryQry   := Nil
    jItem       := Nil
    nSeq        := 1
    aItens      := {}
    aArea       := GetArea()

    dbSelectArea("MG1")

    cQry := " SELECT MG1.MG1_FILIAL, MG1.MG1_FILFAB, MG1.MG1_CODFAB, MG1.MG1_LOJFAB, MG1.MG1_FILPRD, MG1.MG1_CODPRD, "
    cQry += "        SB1.B1_DESC, SA2.A2_NOME, SA2.A2_NREDUZ, SA2.A2_CGC "
    cQry += " FROM " + RetSqlName("MG1") + " MG1 "
    cQry += " LEFT JOIN " + RetSqlName("SB1") + " SB1 ON SB1.B1_FILIAL = MG1.MG1_FILPRD AND SB1.B1_COD = MG1.MG1_CODPRD AND SB1.D_E_L_E_T_ = ' ' "
    cQry += " LEFT JOIN " + RetSqlName("SA2") + " SA2 ON SA2.A2_FILIAL = MG1.MG1_FILFAB AND SA2.A2_COD = MG1.MG1_CODFAB AND SA2.A2_LOJA = MG1.MG1_LOJFAB AND SA2.D_E_L_E_T_ = ' ' "
    cQry += " WHERE "
    cQry += " MG1.MG1_FILIAL = ? "
    If !Empty(cCodProd)
        cQry += " AND MG1.MG1_CODPRD = ? "
    EndIf
    If !Empty(cFilFab)
        cQry += " AND MG1.MG1_FILFAB = ? "
    EndIf
    If !Empty(cCodFab)
        cQry += " AND MG1.MG1_CODFAB = ? "
    EndIf
    If !Empty(cLojaFab)
        cQry += " AND MG1.MG1_LOJFAB = ? "
    EndIf
    cQry += " AND MG1.D_E_L_E_T_ = ? "
    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)

    oQueryQry:SetString(nSeq++, xFilial("MG1"))
    If !Empty(cCodProd)
        oQueryQry:SetString(nSeq++, cCodProd)
    EndIf
    If !Empty(cFilFab)
        oQueryQry:SetString(nSeq++, cFilFab)
    EndIf
    If !Empty(cCodFab)
        oQueryQry:SetString(nSeq++, cCodFab)
    EndIf
    If !Empty(cLojaFab)
        oQueryQry:SetString(nSeq++, cLojaFab)
    EndIf
    oQueryQry:SetString(nSeq++, Space(1))

    cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

    While (cAliasQry)->(!EOF())
        jItem := JsonObject():New()
        jItem["branch"]                 := AllTrim((cAliasQry)->MG1_FILIAL)
        jItem["productBranch"]          := AllTrim((cAliasQry)->MG1_FILPRD)
        jItem["productCode"]            := AllTrim((cAliasQry)->MG1_CODPRD)
        jItem["productDescription"]     := AllTrim((cAliasQry)->B1_DESC)
        jItem["manufacturerBranch"]     := AllTrim((cAliasQry)->MG1_FILFAB)
        jItem["manufacturerCode"]       := AllTrim((cAliasQry)->MG1_CODFAB)
        jItem["manufacturerStore"]      := AllTrim((cAliasQry)->MG1_LOJFAB)
        jItem["manufacturerName"]       := AllTrim((cAliasQry)->A2_NOME)
        jItem["manufacturerTradeName"]  := AllTrim((cAliasQry)->A2_NREDUZ)
        jItem["manufacturerCnpjCpf"]    := AllTrim((cAliasQry)->A2_CGC)
        aAdd(aItens, jItem)
        (cAliasQry)->(dbSkip())
    EndDo

    (cAliasQry)->(dbCloseArea())

    RestArea(aArea)

    // ==========================================
    // Libera Recursos da Memoria
    // ==========================================
    FreeObj(oQueryQry)

Return(aItens)

/*/{Protheus.doc} ValidateFieldSize
    Valida se o tamanho do campo informado no JSON não ultrapassa o tamanho máximo permitido no Protheus.
    @type    method
    @author  Alberto Deviciente
    @since   04/07/2026
    @version P12
    @param   cFieldJson, Character, Campo do JSON a ser verificado.
    @param   cConteudoJson, Character, Conteúdo do Campo do JSON a ser verificado.
    @param   cFieldProt, Character, Campo do Protheus correspodente ao campo do JSON a ser verificado.
    @param   cMsg, Character, mensagem de erro a ser exibida caso o campo ultrapasse o tamanho máximo permitido
    @return  Logical, True (.T.) se o campo estiver dentro do tamanho máximo permitido, False (.F.) caso contrário.
/*/
Method ValidateFieldSize(cFieldJson as Character, cConteudoJson as Character, cFieldProt as Character, cMsg as Character) as Logical Class RetailAutopartsCatalogProductManufacturerController
Local lRet      := .T. as Logical
Local nLenField := 0 as Numeric

nLenField := TamSx3(cFieldProt)[1]

If Len(cConteudoJson) > nLenField
    lRet := .F.
    cMsg := STR0015 + cFieldJson + ": " + cValToChar(nLenField) + STR0016 //"Tamanho máximo permitido para o campo " ### " : " ### " caracteres"
EndIf

Return lRet
