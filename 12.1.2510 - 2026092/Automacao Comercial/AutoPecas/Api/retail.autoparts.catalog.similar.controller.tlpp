#include "totvs.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "fwmvcdef.ch"
#include "retail.autoparts.catalog.similar.controller.ch"

//               Nome do parametro no JSON     , Campo no SX3   , Tipo
Static aFields :=   { ;
                    {"similarGroupCode"        , "MFY_CODGRP"   , "C"    },;
                    {"productBranch"           , "MFY_FILPRO"   , "C"    },;
                    {"productCode"             , "MFY_CODPRO"   , "C"    };
                    } as Array

namespace totvs.protheus.retail.autoparts.catalog.similar.controller

/*/{Protheus.doc} RetailAutopartsCatalogSimilarController
    API relacionada a Similares do catalogo de autopecas
    @type   class    
    @author eduardo.FLima
    @since  27/05/2026
/*/
Class RetailAutopartsCatalogSimilarController

    public Method New()

    private Method FindSimilar(cGroupCode as Character, cProductBranch as Character, cProductCode as Character, lGetByProduct as Logical) as Array

    private Method GetProductGroup(cProductCode as Character, cProductBranch as Character) as Character

    private Method SaveSimilarMFY(oJsBody  as Json) as Json

    @Get("/api/retail/v1/retailAutopartsCatalogSimilar/searchProducts", description="Busca produtos no catalogo SB1 por codigo, descricao ou codigo de barras, com exclusao de grupo de similares")
    public Method searchProducts()

    @Get("/api/retail/v1/retailAutopartsCatalogSimilar/getDataForSimilar", description="Consulta os similares do catalogo de autopecas, podendo filtrar por grupo, filial do produto ou codigo do produto")
    public Method getDataForSimilar()

    @Get("/api/retail/v1/retailAutopartsCatalogSimilar/getSimilarProducts", description="Retorna os produtos similares de um produto especifico, excluindo o proprio produto")
    public Method getSimilarProducts()

    @Post("/api/retail/v1/retailAutopartsCatalogSimilar/postDataForSimilar", description="Cadastra um novo similar para o catalogo de autopecas")
    public Method postDataForSimilar()

    @Post("/api/retail/v1/retailAutopartsCatalogSimilar/postBatchSimilar", description="Cadastra em lote os similares de um produto de referencia no catalogo de autopecas")
    public Method postBatchSimilar()


    @Put("/api/retail/v1/retailAutopartsCatalogSimilar/putDataForSimilar/:productCode", description="Altera um similar existente no catalogo de autopecas")
    public Method putDataForSimilar()

    @Delete("/api/retail/v1/retailAutopartsCatalogSimilar/deleteDataForSimilar/:productCode", description="Deleta um similar do catalogo de autopecas")
    public Method deleteDataForSimilar()

EndClass

/*/{Protheus.doc} New
    Metodo construtor
    @type   method
    @author eduardo.FLima
    @since  27/05/2026
    @return Object, Instancia da classe RetailAutopartsCatalogSimilarController    
/*/
Method New() Class RetailAutopartsCatalogSimilarController
Return Self

/*/{Protheus.doc} searchProducts
    Busca produtos no catalogo SB1 por codigo, descricao ou codigo de barras,
    excluindo o grupo de similares do produto de referencia quando informado
    @type    method
    @author  eduardo.FLima
    @since   24/07/2026
    @version p12
    @param   q           , Character , termo de busca livre (obrigatorio)
    @param   codprodRef  , Character , produto de referencia para exclusao de grupo (opcional)
    @param   filpro      , Character , filial do produto (opcional, default xFilial("SB1"))
    @return  Logical     , sempre .T.
/*/
Method searchProducts() Class RetailAutopartsCatalogSimilarController
    Local oJsonRespo    := JsonObject():New() as Object
    Local oJParametr    := oRest:getQueryRequest() as Object
    Local aItens        := {} as Array
    Local jItem         := Nil as Object
    Local cQuery        := "" as Character
    Local cQueryTerm    := "" as Character
    Local cFilPro       := "" as Character
    Local cProdRef      := "" as Character
    Local cGroupCode    := "" as Character
    Local cAliasQry     := "" as Character
    Local oQueryQry     := Nil as Object
    Local nSeq          := 1 as Numeric
    Local aArea         := GetArea() as Array

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // ==========================================
    // Obtem os parametros da requisicao (query param)
    // ==========================================
    If oJParametr:hasProperty('q')
        cQuery := oJParametr['q']
    EndIf
    If oJParametr:hasProperty('filpro')
        cFilPro := oJParametr['filpro']
    Else
        cFilPro := xFilial("SB1")
    EndIf
    If oJParametr:hasProperty('codprodRef')
        cProdRef := oJParametr['codprodRef']
    EndIf

    // ==========================================
    // Valida parametro obrigatorio
    // ==========================================
    If Empty(cQuery)
        oRest:setStatusCode(400)
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := STR0018 //"Parametro 'q' (termo de busca) e obrigatorio"
        oRest:SetResponse(oJsonRespo:toJson())
        RestArea(aArea)
        FreeObj(oJsonRespo)
        FreeObj(oJParametr)
        Return .T.
    EndIf

    // ==========================================
    // Descobre grupo do produto de referencia (se informado)
    // ==========================================
    If !Empty(cProdRef)
        cGroupCode := Self:GetProductGroup(cProdRef, cFilPro)
    EndIf

    // ==========================================
    // Monta termo de busca UPPER/LIKE
    // ==========================================
    cQueryTerm := "%" + Upper(AllTrim(cQuery)) + "%"

    // ==========================================
    // Monta SQL principal na SB1
    // ==========================================
    cQuery := " SELECT SB1.B1_FILIAL, SB1.B1_COD, SB1.B1_DESC, SB1.B1_TIPO, SB1.B1_CODBAR "
    cQuery += " FROM " + RetSqlName("SB1") + " SB1 "
    cQuery += " WHERE SB1.B1_FILIAL = ? "
    cQuery += " AND SB1.D_E_L_E_T_ = ? "
    cQuery += " AND ( UPPER(SB1.B1_COD)    LIKE ? "
    cQuery += "    OR UPPER(SB1.B1_DESC)   LIKE ? "
    cQuery += "    OR UPPER(SB1.B1_CODBAR) LIKE ? ) "

    If !Empty(cGroupCode)
        // Exclui todos os produtos do grupo de similares via subquery
        cQuery += " AND SB1.B1_COD NOT IN ( "
        cQuery += "     SELECT MFY.MFY_CODPRO FROM " + RetSqlName("MFY") + " MFY "
        cQuery += "     WHERE MFY.MFY_FILIAL = ? "
        cQuery += "     AND MFY.MFY_CODGRP = ? "
        cQuery += "     AND MFY.D_E_L_E_T_ = ? "
        cQuery += " ) "
    ElseIf !Empty(cProdRef)
        // Sem grupo, exclui apenas o produto de referencia
        cQuery += " AND SB1.B1_COD <> ? "
    EndIf

    cQuery += " ORDER BY SB1.B1_COD "

    cQuery := ChangeQuery(cQuery)

    oQueryQry := FwExecStatement():New(cQuery)

    oQueryQry:SetString(nSeq++, PadR(cFilPro, TamSx3("B1_FILIAL")[1]))   // SB1.B1_FILIAL
    oQueryQry:SetString(nSeq++, Space(1))                                  // SB1.D_E_L_E_T_
    oQueryQry:SetString(nSeq++, cQueryTerm)                                // UPPER(B1_COD) LIKE
    oQueryQry:SetString(nSeq++, cQueryTerm)                                // UPPER(B1_DESC) LIKE
    oQueryQry:SetString(nSeq++, cQueryTerm)                                // UPPER(B1_CODBAR) LIKE

    If !Empty(cGroupCode)
        oQueryQry:SetString(nSeq++, xFilial("MFY"))                        // MFY.MFY_FILIAL
        oQueryQry:SetString(nSeq++, PadR(cGroupCode, TamSx3("MFY_CODGRP")[1])) // MFY.MFY_CODGRP
        oQueryQry:SetString(nSeq++, Space(1))                              // MFY.D_E_L_E_T_
    ElseIf !Empty(cProdRef)
        oQueryQry:SetString(nSeq++, PadR(cProdRef, TamSx3("B1_COD")[1])) // SB1.B1_COD <>
    EndIf

    cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

    While (cAliasQry)->(!EOF())
        jItem := JsonObject():New()
        jItem["codprod"]  := RTrim((cAliasQry)->B1_COD)
        jItem["filpro"]  := RTrim((cAliasQry)->B1_FILIAL)        
        jItem["desc"]     := RTrim((cAliasQry)->B1_DESC)
        jItem["type"]     := RTrim((cAliasQry)->B1_TIPO)
        jItem["barcode"]  := RTrim((cAliasQry)->B1_CODBAR)
        aAdd(aItens, jItem)
        jItem := Nil
        (cAliasQry)->(dbSkip())
    EndDo

    (cAliasQry)->(dbCloseArea())
    oQueryQry:Destroy()
    oQueryQry := Nil

    // ==========================================
    // Retorna HTTP 200 sempre (mesmo array vazio)
    // ==========================================
    oRest:setStatusCode(200)
    oJsonRespo['items'] := aItens

    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)
    RestArea(aArea)

Return .T.

/*/{Protheus.doc} getDataForSimilar
    Retorna os similares do catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   27/05/2026
    @version p12
    @param   groupCode       , Character , codigo do grupo de similares (opcional)
    @param   productBranch   , Character , filial do produto (opcional, default xFilial("SB1"))
    @param   productCode     , Character , codigo do produto (opcional)
    @return  Logical     , sempre .T.
/*/
Method getDataForSimilar() Class RetailAutopartsCatalogSimilarController
    Local oJsonRespo    := JsonObject():New() as Object
    Local oJParametr    := oRest:getQueryRequest() as Object
    Local aItens        := {} as Array
    Local cGroupCode    := "" as Character
    Local cProductBranch:= "" as Character
    Local cProductCode  := "" as Character

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Obtem os parametros informados na requisicao via URL (query param)
    If oJParametr:hasProperty('groupCode')
        cGroupCode := oJParametr['groupCode']
    EndIf
    If oJParametr:hasProperty('productBranch')
        cProductBranch := oJParametr['productBranch']
    EndIf
    If oJParametr:hasProperty('productCode')
        cProductCode := oJParametr['productCode']
    EndIf

    aItens := Self:FindSimilar(cGroupCode, cProductBranch, cProductCode)

    If Len(aItens) > 0
        oJsonRespo["items"] := aItens
        oRest:setStatusCode(200)  // HTTP 200 = Sucesso
    Else
        oJsonRespo["items"]   := {}
        oJsonRespo["message"] := STR0001 //"Dados nao encontrados para o filtro informado"
        oRest:setStatusCode(404)  // HTTP 404 = Not Found
    EndIf

    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

Return .T.

/*/{Protheus.doc} getSimilarProducts
    Retorna os similares de um produto especifico, excluindo o proprio produto
    @type    method
    @author  eduardo.FLima
    @since   27/05/2026
    @version p12
/*/
Method getSimilarProducts() Class RetailAutopartsCatalogSimilarController
    Local oJsonRespo    := JsonObject():New() as Object
    Local oJParametr    := oRest:getQueryRequest() as Object
    Local aItens        := {} as Array
    Local cProductCode  := "" as Character
    Local cProductBranch:= "" as Character
    Local lProductExists:= .F. as Logical
    Local aArea         := GetArea() as Array

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // ==========================================
    // Obtem os parametros da requisicao (query param)
    // ==========================================
    If oJParametr:hasProperty('codprod')
        cProductCode := oJParametr['codprod']
    EndIf
    If oJParametr:hasProperty('filpro')
        cProductBranch := oJParametr['filpro']
    Else
        // Assume xFilial("SB1") caso filpro nao informado
        cProductBranch := xFilial("SB1")
    EndIf

    // ==========================================
    // Valida parametro obrigatorio
    // ==========================================
    If Empty(cProductCode)
        oRest:setStatusCode(400)  // HTTP 400 = Bad Request
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := STR0015 //"Parametro 'codprod' (codigo do produto) e obrigatorio"
        oRest:SetResponse(oJsonRespo:toJson())
        FreeObj(oJsonRespo)
        FreeObj(oJParametr)
        RestArea(aArea)
        Return .T.
    EndIf

    // ==========================================
    // Valida se produto existe na SB1
    // ==========================================
    // lProductExists := Self:ProductExists(cProductCode, cProductBranch)
    SB1->(dbSetOrder(1))//B1_FILIAL+B1_COD
    lProductExists := SB1->(dbSeek(PadR(cProductBranch, TamSx3("B1_FILIAL")[1]) + PadR(cProductCode, TamSx3("B1_COD")[1])))
    
    If !lProductExists
        oRest:setStatusCode(404)  // HTTP 404 = Not Found
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := STR0016 + RTrim(cProductCode) + STR0009 //"Produto " ### " nao encontrado"
        oRest:SetResponse(oJsonRespo:toJson())
        FreeObj(oJsonRespo)
        FreeObj(oJParametr)
        RestArea(aArea)
        Return .T.
    EndIf

    // ==========================================
    // Busca similares com exclusao do produto referencia
    // lGetByProduct = .T. ativa a logica especial
    // ==========================================
    aItens := Self:FindSimilar("",cProductBranch, cProductCode, .T.)

    // ==========================================
    // Retorna sucesso (HTTP 200) mesmo se vazio
    // ==========================================
    oRest:setStatusCode(200)  // HTTP 200 = OK
    oJsonRespo['items'] := aItens

    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)
    RestArea(aArea)

Return .T.

/*/{Protheus.doc} postDataForSimilar
    Cadastro de Similar para o catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   27/05/2026
    @version p12
/*/
Method postDataForSimilar() Class RetailAutopartsCatalogSimilarController
    Local oJsBody       := JsonObject():New() as Json
    Local oJsonRespo    := JsonObject():New() as Json
    Local lGravouOK     := .F. as Logical
    Local cGroupCode    := "" as Character
    Local jGrava        := Nil as Json
    Local nX            := 0 as Numeric
    Local cParamName    := "" as Character
    Local cFieldName    := "" as Character
    Local aErros        := {} as Array

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    oJsBody:fromJson(oRest:GetBodyRequest())

    // ==========================================
    // Gera UUID para o grupo caso nao informado
    // ==========================================
    If oJsBody['similarGroupCode'] == Nil .Or. Empty(oJsBody['similarGroupCode'])
        cGroupCode := FWUUIDV4(.T.)
        oJsBody['similarGroupCode'] := cGroupCode
    EndIf

    // ==========================================
    // Delega gravacao para SaveSimilarMFY
    // ==========================================
    jGrava := Self:SaveSimilarMFY(oJsBody)
    lGravouOK := jGrava["success"]

    If lGravouOK
        oRest:setStatusCode(201)  // HTTP 201 = Created
        oJsonRespo['success'] := .T.
        oJsonRespo['message'] := STR0003 + alltrim(MFY->MFY_FILPRO)+"/"+RTrim(MFY->MFY_CODPRO) + STR0004 //"Produto Similar " ### " cadastrado com sucesso"
        For nX := 1 To Len(aFields)
            cParamName := aFields[nX][1]
            cFieldName := aFields[nX][2]
            If aFields[nX][3] == "C"
                oJsonRespo[cParamName] := RTrim(MFY->(FieldGet(FieldPos(cFieldName))))
            EndIf
        Next nX
    Else
        oRest:setStatusCode(400)  // HTTP 400 = Bad Request
        aErros := jGrava["erros"]
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := IIf(!Empty(aErros[6]), aErros[6], STR0006) //"Erro ao cadastrar"
        oJsonRespo['field']   := IIf(!Empty(aErros[4]), aErros[4], "")
        oJsonRespo['errorId'] := IIf(!Empty(aErros[5]), aErros[5], "")
        oJsonRespo['solution']:= IIf(!Empty(aErros[7]), aErros[7], "")
    EndIf

    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsBody)
    FreeObj(oJsonRespo)

Return .T.

/*/{Protheus.doc} putDataForSimilar
    Altera cadastro de Similar do catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   27/05/2026
    @version p12
/*/
Method putDataForSimilar() Class RetailAutopartsCatalogSimilarController
    Local oJsonRespo    := JsonObject():New() as Object
    Local oJsBody       := JsonObject():New() as Object
    Local oJPathPar     := oRest:getPathParamsRequest() as Object
    Local oJParametr    := oRest:getQueryRequest() as Object
    Local lFound        := .F. as Logical
    Local cBranch       := "" as Character
    Local cProductBranch:= "" as Character
    Local cProductCode  := "" as Character
    Local aArea         := GetArea() as Array
    Local oModel        := Nil as Object
    Local oModelMFY     := Nil as Object
    Local lGravouOK     := .F. as Logical
    Local aErros        := {} as Array
    Local nX            := 0 as Numeric
    Local cParamName    := "" as Character
    Local cFieldName    := "" as Character
    Local lAnyParInf    := .F. as Logical
    Local lDadosOK      := .T. as Logical

    DbSelectArea("MFY")

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    oJsBody:fromJson(oRest:GetBodyRequest())

    cBranch := xFilial("MFY")

    // Obtem os parametros informados na requisicao via URL (path param)
    If oJPathPar:hasProperty('productCode')
        cProductCode := oJPathPar['productCode']
    EndIf

    // Obtem os parametros informados na requisicao via URL (query param)
    If oJParametr:hasProperty('productBranch')
        cProductBranch := oJParametr['productBranch']
    EndIf

    // Assume xFilial("SB1") caso productBranch nao informado
    If Empty(cProductBranch)
        cProductBranch := xFilial("SB1")
    EndIf

    If lDadosOK .And. Empty(cProductCode)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['message'] := STR0012 //"Parametro 'productCode' (codigo do produto) e obrigatorio"
        lDadosOK := .F.
    EndIf

    If lDadosOK
        dbSelectArea('MFY')
        MFY->(dbSetOrder(1)) //MFY_FILIAL+MFY_FILPRO+MFY_CODPRO

        lFound := MFY->(dbSeek(cBranch + PadR(cProductBranch, TamSx3("MFY_FILPRO")[1]) + PadR(cProductCode, TamSx3("MFY_CODPRO")[1])))

        // ------------------------------------------
        // Se nao encontrou retorna erro 404
        // ------------------------------------------
        If !lFound
            oRest:setStatusCode(404)  // HTTP 404 = Not Found
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0003 +   alltrim(cProductBranch)+"/"+RTrim(cProductCode) + STR0009 //"Produto Similar  " ### " nao encontrado"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        // ==========================================
        // Carrega o Model MVC para Alteracao
        // ==========================================
        oModel := FWLoadModel("LOJA690")
        oModel:SetOperation(MODEL_OPERATION_UPDATE)
        oModel:Activate()

        // ------------------------------------------
        // Obtem o SubModel da Tabela MFY
        // ------------------------------------------
        oModelMFY := oModel:GetModel("MFYMASTER")

        // ==========================================
        // Preenche os Campos do Model
        // ==========================================
        For nX := 1 To Len(aFields)
            cParamName := aFields[nX][1]
            cFieldName := aFields[nX][2]

            If oJsBody[cParamName] != Nil
                oModelMFY:SetValue(cFieldName, oJsBody[cParamName])
                lAnyParInf := .T.
            EndIf
        Next nX

        If !lAnyParInf
            oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
            oJsonRespo['message'] := STR0010 //"Nenhum parametro de similar informado para alteracao"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        // ==========================================
        // Valida e Grava as Alteracoes
        // ==========================================
        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        Else
            lGravouOK := .F.
        EndIf

        If lGravouOK
            oRest:setStatusCode(200)  // HTTP 200 = OK
            oJsonRespo['success'] := .T.
            oJsonRespo['message'] := STR0003 + alltrim(MFY->MFY_FILPRO)+"/"+RTrim(MFY->MFY_CODPRO) + STR0005 //"Produto Similar " ### " atualizado com sucesso"
            For nX := 1 To Len(aFields)
                cParamName := aFields[nX][1]
                cFieldName := aFields[nX][2]
                If aFields[nX][3] == "C"
                    oJsonRespo[cParamName] := RTrim(MFY->(FieldGet(FieldPos(cFieldName))))
                EndIf
            Next nX
        Else
            oRest:setStatusCode(400)  // HTTP 400 = Bad Request
            aErros := oModel:GetErrorMessage()

            oJsonRespo['success']  := .F.
            oJsonRespo['field']    := IIf(!Empty(aErros[4]), aErros[4], "")
            oJsonRespo['message']  := IIf(!Empty(aErros[6]), aErros[6], STR0011) //"Erro ao atualizar"
            oJsonRespo['solution'] := IIf(!Empty(aErros[7]), aErros[7], "")
        EndIf
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    // ==========================================
    // Libera Recursos da Memoria
    // ==========================================
    If ValType(oModel) <> "U"
        oModelMFY:DeActivate()
        oModel:DeActivate()

        FreeObj(oModelMFY)
        FreeObj(oModel)
    EndIf

    FreeObj(oJsBody)
    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

    RestArea(aArea)

Return .T.

/*/{Protheus.doc} deleteDataForSimilar
    Deleta similar do catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   27/05/2026
    @version p12
/*/
Method deleteDataForSimilar() Class RetailAutopartsCatalogSimilarController
    Local oJsonRespo    := JsonObject():New() as Object
    Local oJParametr    := oRest:getPathParamsRequest() as Object
    Local oJQuery       := oRest:getQueryRequest() as Object
    Local lFound        := .F. as Logical
    Local cBranch       := "" as Character
    Local cProductBranch:= "" as Character
    Local cProductCode  := "" as Character
    Local aArea         := GetArea() as Array
    Local oModel        := Nil as Object
    Local lGravouOK     := .F. as Logical
    Local lDadosOK      := .T. as Logical
    Local aErros        := {} as Array

    DbSelectArea("MFY")

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    cBranch := xFilial("MFY")

    // Obtem os parametros informados na requisicao via URL (path param)
    If oJParametr:hasProperty('productCode')
        cProductCode := oJParametr['productCode']
    EndIf

    // Obtem productBranch via query param (opcional)
    If oJQuery:hasProperty('productBranch')
        cProductBranch := oJQuery['productBranch']
    EndIf

    // Assume xFilial("SB1") caso productBranch nao informado
    If Empty(cProductBranch)
        cProductBranch := xFilial("SB1")
    EndIf

    // ==========================================
    // Validacao campos obrigatorios
    // ==========================================

    If lDadosOK .And. Empty(cProductCode)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['message'] := STR0012 //"Parametro 'productCode' (codigo do produto) e obrigatorio"
        lDadosOK := .F.
    EndIf

    If lDadosOK
        dbSelectArea('MFY')
        MFY->(dbSetOrder(1)) //MFY_FILIAL+MFY_FILPRO+MFY_CODPRO

        lFound := MFY->(dbSeek(cBranch + PadR(cProductBranch, TamSx3("MFY_FILPRO")[1]) + PadR(cProductCode, TamSx3("MFY_CODPRO")[1])))

        // ------------------------------------------
        // Se nao encontrou retorna erro 404
        // ------------------------------------------
        If !lFound
            oRest:setStatusCode(404)  // HTTP 404 = Not Found
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0003 + alltrim(cProductBranch)+"/"+RTrim(cProductCode) + STR0009 //"Produto Similar " ### " nao encontrado"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        // ==========================================
        // Carrega o Model MVC para Delete
        // ==========================================
        oModel := FWLoadModel("LOJA690")
        oModel:SetOperation(MODEL_OPERATION_DELETE)
        oModel:Activate()

        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        EndIf
       // Resposta default: erro (padrao defensivo)
        oRest:setStatusCode(400)  // HTTP 400 = Bad Request
        oJsonRespo['success'] := .F.
        aErros := oModel:GetErrorMessage()
        oJsonRespo['message']  := IIf(!Empty(aErros[6]), aErros[6], STR0014) //"Erro ao deletar"
        oJsonRespo['field']    := IIf(!Empty(aErros[4]), aErros[4], "")
        oJsonRespo['solution'] := IIf(!Empty(aErros[7]), aErros[7], "")

        If lGravouOK
            oRest:setStatusCode(200)  // HTTP 200 = OK
            oJsonRespo['success'] := .T.
            oJsonRespo['message'] := STR0003 + alltrim(cProductBranch)+"/" +RTrim(cProductCode) + STR0013 //"Similar grupo " ### " deletado com sucesso"
            // Remove campos de erro caso tenha sucesso na delecao
            oJsonRespo:delName("field")
            oJsonRespo:delName("solution")
        EndIf

        // ==========================================
        // Libera Recursos da Memoria
        // ==========================================
        oModel:DeActivate()
        FreeObj(oModel)
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)
    FreeObj(oJQuery)

    RestArea(aArea)

Return .T.


/*/{Protheus.doc} FindSimilar
    Consulta similares do catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   27/05/2026
    @version p12
    @param   cGroupCode      , Character , filtro pelo codigo do grupo de similares (busca exata)
    @param   cProductBranch  , Character , filtro pela filial do produto (busca exata)
    @param   cProductCode    , Character , filtro pelo codigo do produto (busca exata)
    @param   lGetByProduct   , Logical   , se verdadeiro, descobre grupo pelo produto e o exclui dos resultados
    @return  aItens          , Array     , array de itens encontrados
/*/
Method FindSimilar(cGroupCode as Character, cProductBranch as Character, cProductCode as Character, lGetByProduct as Logical ) as Array Class RetailAutopartsCatalogSimilarController
    Local oQueryQry     := Nil as Object
    Local jItem         := Nil as Object
    Local aItens        := {} as Array
    Local cQry          := "" as Character
    Local cAliasQry     := "" as Character
    Local nSeq          := 1 as Numeric
    Local aArea         := GetArea() as Array
    Local lSeek         := .T. as Logical

    Default cGroupCode      := ""
    Default cProductBranch  := ""
    Default cProductCode    := ""
    Default lGetByProduct     := .F.

    dbSelectArea("MFY")

    // ==========================================
    // Se lGetByProduct = .T., descobre grupo a partir do produto
    // ==========================================
    If lGetByProduct .And. !Empty(cProductCode)
        cGroupCode := Self:GetProductGroup(cProductCode, cProductBranch)
        lSeek := !Empty(cGroupCode)
    EndIf
    IF lSeek
        cQry := " SELECT MFY.MFY_FILIAL, MFY.MFY_CODGRP, MFY.MFY_FILPRO, MFY.MFY_CODPRO, "
        cQry += " SB1.B1_DESC AS DESPROD, SB1.B1_TIPO AS TIPO, SB1.B1_CODBAR AS CODBAR "
        cQry += " FROM " + RetSqlName("MFY") + " MFY "
        cQry += " LEFT JOIN " + RetSqlName("SB1") + " SB1 ON SB1.B1_FILIAL = MFY.MFY_FILPRO AND SB1.B1_COD = MFY.MFY_CODPRO AND SB1.D_E_L_E_T_ = ? "
        cQry += " WHERE "
        cQry += " MFY.MFY_FILIAL = ? "

        If !Empty(cGroupCode)
            cQry += " AND MFY.MFY_CODGRP = ? "
        EndIf

        If !Empty(cProductBranch) .and. !lGetByProduct
            cQry += " AND MFY.MFY_FILPRO = ? "
        EndIf

        If !Empty(cProductCode)
            // Se lGetByProduct = .T., exclui o produto referencia dos resultados
            If lGetByProduct
                cQry += " AND MFY.MFY_CODPRO <> ? "
            Else
                cQry += " AND MFY.MFY_CODPRO = ? "
            Endif
        EndIf

        cQry += " AND MFY.D_E_L_E_T_ = ? "
        cQry += " ORDER BY MFY.MFY_CODGRP, MFY.MFY_CODPRO "

        cQry := ChangeQuery(cQry)

        oQueryQry := FwExecStatement():New(cQry)

        // Parametro do LEFT JOIN (D_E_L_E_T_)
        oQueryQry:SetString(nSeq++, Space(1))  // SB1.D_E_L_E_T_

        // Parametro do WHERE principal
        oQueryQry:SetString(nSeq++, xFilial("MFY"))

        If !Empty(cGroupCode)
            oQueryQry:SetString(nSeq++, PadR(cGroupCode, TamSx3("MFY_CODGRP")[1]))
        EndIf

        If !Empty(cProductBranch) .and. !lGetByProduct
            oQueryQry:SetString(nSeq++, PadR(cProductBranch, TamSx3("MFY_FILPRO")[1]))
        EndIf

        // filtro em ambos casos, lGetByProduct = .T. ou .F. 
        //um produto especifico, seja para buscar similares ou para excluir o proprio produto dos resultados
        If !Empty(cProductCode)
            oQueryQry:SetString(nSeq++, PadR(cProductCode, TamSx3("MFY_CODPRO")[1]))
        EndIf

        oQueryQry:SetString(nSeq++, Space(1))  // MFY.D_E_L_E_T_

        cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

        While (cAliasQry)->(!EOF())
            jItem := JsonObject():New()
            jItem["codgrp"]     := RTrim((cAliasQry)->MFY_CODGRP)
            jItem["filpro"]     := RTrim((cAliasQry)->MFY_FILPRO)
            jItem["codprod"]    := RTrim((cAliasQry)->MFY_CODPRO)
            jItem["desc"]       := RTrim((cAliasQry)->DESPROD)
            jItem["type"]       := RTrim((cAliasQry)->TIPO)
            jItem["barcode"]     := RTrim((cAliasQry)->CODBAR)

            aAdd(aItens, jItem)
            jItem := Nil
            (cAliasQry)->(dbSkip())
        EndDo

        (cAliasQry)->(dbCloseArea())
        oQueryQry:Destroy()
        oQueryQry := Nil
    EndIf

    RestArea(aArea)

Return(aItens)

/*/{Protheus.doc} GetProductGroup
    Retorna o codigo do grupo de similares de um produto na tabela MFY
    @type    method
    @author  eduardo.FLima
    @since   24/07/2026
    @version p12
    @param   cProductCode   , Character , codigo do produto
    @param   cProductBranch , Character , filial do produto
    @return  cGroupCode     , Character , codigo do grupo (vazio se nao encontrado)
/*/
Method GetProductGroup(cProductCode as Character, cProductBranch as Character) as Character Class RetailAutopartsCatalogSimilarController
    Local cGroupCode := "" as Character

    Default cProductCode    := ""
    Default cProductBranch  := ""

    If !Empty(cProductCode)
        cGroupCode := Posicione("MFY", 1, FwXFilial("MFY") + PadR(cProductBranch, TamSx3("MFY_FILPRO")[1]) + PadR(cProductCode, TamSx3("MFY_CODPRO")[1]), "MFY->MFY_CODGRP")
    EndIf

Return(cGroupCode)

/*/{Protheus.doc} SaveSimilarMFY
    Grava um registro de similar na tabela MFY via MVC (LOJA690).    
    @type    method
    @author  eduardo.FLima
    @since   27/07/2026
    @version p12
    @param   oJsBody   , Json      , objeto JSON com os parametros do similar
    @return  Json      , objeto JSON com o resultado da gravacao
/*/
Method SaveSimilarMFY(oJsBody as Json) as Json Class RetailAutopartsCatalogSimilarController
    Local oModel    := Nil as Object
    Local oModelMFY := Nil as Object
    Local aErros        := {} as Array
    Local cParamName    := "" as Character
    Local cFieldName    := "" as Character
    Local nX            := 0 as Numeric
    Local jRet          := JsonObject():New() as Json
    Local lGravouOK     := .F. as Logical

    oModel := FWLoadModel("LOJA690")
    oModel:SetOperation(MODEL_OPERATION_INSERT)
    oModel:Activate()

    oModelMFY := oModel:GetModel("MFYMASTER")
    // ==========================================
    // Preenche os Campos do Model
    // ==========================================
    For nX := 1 To Len(aFields)
        cParamName := aFields[nX][1]  // Nome do parametro no JSON
        cFieldName := aFields[nX][2]  // Nome do campo no Model

        If oJsBody[cParamName] != Nil
            oModelMFY:SetValue(cFieldName, oJsBody[cParamName])
        EndIf
    Next nX


    // ==========================================
    // Valida e Grava os Dados
    // ==========================================
    If oModel:VldData()
        lGravouOK := oModel:CommitData()
    Else
        lGravouOK := .F.
    EndIf
    aErros := oModel:GetErrorMessage()
    jRet["success"]  := lGravouOK
    jRet["erros"]    := aErros

    oModel:DeActivate()
    FreeObj(oModelMFY)
    FreeObj(oModel)

Return jRet

/*/{Protheus.doc} postBatchSimilar
    Cadastra em lote os similares de um produto de referencia.
    Valida todos os itens antes de abrir transacao. Atomico: qualquer falha
    reverte todos os registros gravados no lote.
    @type    method
    @author  eduardo.FLima
    @since   27/07/2026
    @version p12
    @return  Logical , sempre .T.
/*/
Method postBatchSimilar() Class RetailAutopartsCatalogSimilarController
    Local oJsBody       := JsonObject():New() as Object
    Local oJsonRespo    := JsonObject():New() as Object
    Local oJsItem       := JsonObject():New() as Json 
    Local aSimilares    := {} as Array
    Local cCodProd      := "" as Character
    Local cFilPro       := "" as Character
    Local cGroupCode    := "" as Character
    Local cSimilarCod   := "" as Character
    Local lGravouOK     := .T. as Logical
    Local nX            := 0 as Numeric
    Local nTotal        := 0 as Numeric
    Local aArea         := GetArea() as Array
    Local jGrava        := Nil as Json
    Local lNovoGrupo    := .F. as Logical
    Local aErros        := {} as Array
    Local lProductExists  := .F. as Logical    
    Local cCodFalha := "" as Character

    oRest:setKeyHeaderResponse("Content-Type", "application/json")
    oJsBody:fromJson(oRest:GetBodyRequest())

    // ==========================================
    // Validacoes do payload
    // ==========================================

    // codprod obrigatorio
    If oJsBody['codprod'] == Nil .Or. Empty(oJsBody['codprod'])
        oRest:setStatusCode(400)
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := STR0019 //"Parametro 'codprod' (codigo do produto de referencia) e obrigatorio"
        oRest:SetResponse(oJsonRespo:toJson())
        FreeObj(oJsBody)
        FreeObj(oJsonRespo)
        RestArea(aArea)
        Return .T.
    EndIf
    cCodProd := AllTrim(oJsBody['codprod'])
    cCodFalha := cCodProd 

    // similares obrigatorio e nao vazio
    If oJsBody['similares'] == Nil .Or. ValType(oJsBody['similares']) != "A" .Or. Len(oJsBody['similares']) == 0
        oRest:setStatusCode(400)
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := STR0020 //"Parametro 'similares' (lista de similares) e obrigatorio e nao pode estar vazio"
        oRest:SetResponse(oJsonRespo:toJson())
        FreeObj(oJsBody)
        FreeObj(oJsonRespo)
        RestArea(aArea)
        Return .T.
    EndIf
    aSimilares := oJsBody['similares']

    // filpro: usa valor informado ou xFilial("SB1")
    If oJsBody['filpro'] != Nil .And. !Empty(oJsBody['filpro'])
        cFilPro := oJsBody['filpro']
    Else
        cFilPro := xFilial("SB1")
    EndIf

    SB1->(dbSetOrder(1))//B1_FILIAL+B1_COD
    lProductExists := SB1->(dbSeek(PadR(cFilPro, TamSx3("B1_FILIAL")[1]) + PadR(cCodProd, TamSx3("B1_COD")[1])))
    
    If !lProductExists //Produto de referência existe em SB1	404 — Produto não encontrado
        oRest:setStatusCode(404)  // HTTP 404 = Not Found
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := STR0016 + RTrim(cCodProd) + STR0009 //"Produto " ### " nao encontrado"
        oRest:SetResponse(oJsonRespo:toJson())
        FreeObj(oJsBody)
        FreeObj(oJsonRespo)
        RestArea(aArea)
        Return .T.
    EndIf

    // auto-referencia: codprod nao pode estar em similares
    For nX := 1 To Len(aSimilares)
        If AllTrim(aSimilares[nX]) == cCodProd
            oRest:setStatusCode(400)
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0021 //"O produto de referencia nao pode constar na lista de similares"
            oRest:SetResponse(oJsonRespo:toJson())
            FreeObj(oJsBody)
            FreeObj(oJsonRespo)
            RestArea(aArea)
            Return .T.
        EndIf
    Next nX

    // ==========================================
    // Determina grupo do codprod
    // ==========================================
    cGroupCode := Self:GetProductGroup(cCodProd, cFilPro)
    lNovoGrupo  := Empty(cGroupCode)
    If lNovoGrupo
        // Produto de referencia ainda nao tem grupo: gera novo UUID
        cGroupCode := FWUUIDV4(.T.)
    EndIf


    // ==========================================
    // Gravacao atomica em transacao
    // ==========================================
    Begin Transaction

        // Se codprod ainda nao tem grupo, grava o proprio produto de referencia primeiro
        If lNovoGrupo
            oJsItem['similarGroupCode'] := cGroupCode
            oJsItem['productCode'] := cCodProd
            oJsItem['productBranch'] := cFilPro            
            jGrava := Self:SaveSimilarMFY(oJsItem)
            lGravouOK := jGrava["success"]
        EndIf

        If lGravouOK
            For nX := 1 To Len(aSimilares)
                cSimilarCod := AllTrim(aSimilares[nX])
                cCodFalha := cSimilarCod
                oJsItem['similarGroupCode'] := cGroupCode
                oJsItem['productCode'] := cSimilarCod
                oJsItem['productBranch'] := cFilPro           

                jGrava := Self:SaveSimilarMFY(oJsItem)
                lGravouOK := jGrava["success"]
                If !lGravouOK
                    Exit
                EndIf
                nTotal++
            Next nX
        EndIf

        If lGravouOK
            oRest:setStatusCode(201)
            oJsonRespo['success']      := .T.
            oJsonRespo['codgrp']       := cGroupCode
            oJsonRespo['totalGravados']:= nTotal
            oJsonRespo['message']      := Str(nTotal, 3) + STR0022 //"N similares cadastrados com sucesso"
        Else
            
            DisarmTransaction()
            aErros := jGrava["erros"]
            if alltrim(aErros[5]) == "VLDMODEL" // verifica se o erro foi de duplicidade de registro
                oRest:setStatusCode(409)
            else
                oRest:setStatusCode(400)
            Endif                 
            oJsonRespo['success'] := .F.
            oJsonRespo['item'] := STR0006 + " " +cCodFalha + " " + STR0017//"Erro ao cadastrar" ## "Erro ao gravar lote de similares. Transacao revertida"
            oJsonRespo['message'] := IIf(!Empty(aErros[6]), aErros[6], STR0006) //"Erro ao cadastrar"
            oJsonRespo['field']   := IIf(!Empty(aErros[4]), aErros[4], "")
            oJsonRespo['errorId'] := IIf(!Empty(aErros[5]), aErros[5], "")
            oJsonRespo['solution']:= IIf(!Empty(aErros[7]), aErros[7], "")
        EndIf
    End Transaction
    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsBody)
    FreeObj(oJsonRespo)
    RestArea(aArea)
Return .T.
