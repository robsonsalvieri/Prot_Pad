#include "totvs.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "retail.autoparts.catalog.sx3cbox.controller.ch"

namespace totvs.protheus.retail.autoparts.catalog.sx3cbox.controller

/*/{Protheus.doc} RetailAutopartsCatalogSx3CboxController
    API de consulta a listas de opcoes (combobox) via dicionario de dados SX3 do catalogo de autopecas
    @type   class
    @author Bruno Almeida
    @since  26/06/2026
/*/
Class RetailAutopartsCatalogSx3CboxController

    private Method ParseCbox(cCampo as Character, cCbox as Character) as Array
    private Method FindSx3Cbox(cCampo as Character) as Object

    public Method New()

    @Get("/api/retail/v1/retailAutopartsCatalogSx3Cbox/getComboOptions", description="Consulta listas de opcoes (combobox) do dicionario de dados SX3 do catalogo de autopecas.")
    public Method getComboOptions()

EndClass

/*/{Protheus.doc} New
    Metodo construtor
    @type   method
    @author Bruno Almeida
    @since  26/06/2026
/*/
Method New() Class RetailAutopartsCatalogSx3CboxController
Return Self

/*/{Protheus.doc} getComboOptions
    Retorna as opcoes de combobox para um ou mais campos do dicionario de dados SX3
    @type    method
    @author  Bruno Almeida
    @since   26/06/2026
    @version p12
    @return  .T., Logical, sempre retorna verdadeiro
/*/
Method getComboOptions() Class RetailAutopartsCatalogSx3CboxController
    Local oJsonRespo    as Object
    Local oJParametr    as Object
    Local jItem         as Object
    Local aItens        as Array
    Local aCampos       as Array
    Local cCampos       as Character
    Local cCampo        as Character
    Local nIdx          as Numeric

    oJsonRespo  := JsonObject():New()
    oJParametr  := Nil
    jItem       := Nil
    aItens      := {}
    aCampos     := {}
    cCampos     := ""
    cCampo      := ""
    nIdx        := 0

    oJParametr := oRest:getQueryRequest()

    oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

    If oJParametr['fields'] == Nil .Or. Empty(oJParametr['fields'])
        oJsonRespo["success"] := .F.
        oJsonRespo["items"]   := {}
        oJsonRespo["message"] := STR0001 //"Parâmetro 'fields' é obrigatório"
        oRest:setStatusCode(400)
    Else
        cCampos := AllTrim(oJParametr['fields'])
        aCampos := StrTokArr2(cCampos, ",")

        For nIdx := 1 To Len(aCampos)
            cCampo := AllTrim(aCampos[nIdx])
            If !Empty(cCampo)
                jItem := Self:FindSx3Cbox(cCampo)
                aAdd(aItens, jItem)
                jItem := Nil
            EndIf
        Next nIdx

        If Len(aItens) > 0
            oJsonRespo["success"] := .T.
            oJsonRespo["items"]   := aItens
            oRest:setStatusCode(200)
        EndIf
    EndIf

    oRest:setResponse(EncodeUTF8(oJsonRespo:toJson()))

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

Return .T.

/*/{Protheus.doc} FindSx3Cbox
    Consulta o dicionario de dados SX3 e retorna o objeto com as opcoes de combobox do campo informado
    @type    method
    @author  Bruno Almeida
    @since   26/06/2026
    @version p12
    @param   cCampo , Character , nome tecnico do campo a ser consultado (X3_CAMPO)
    @return  jResult, Object   , objeto com as informacoes do campo e suas opcoes de combobox
/*/
Method FindSx3Cbox(cCampo as Character) as Object Class RetailAutopartsCatalogSx3CboxController
    Local jResult   as Object
    Local aCboxOpts as Array
    Local cCbox     as Character

    Default cCampo := ""

    jResult   := JsonObject():New()
    aCboxOpts := {}
    cCbox     := ""

    jResult["campo"]  := cCampo

    If Empty(GetSx3Cache(cCampo, "X3_CAMPO"))
        jResult["isList"] := .F.
        jResult["opcoes"] := {}
        jResult["erro"]   := STR0002 //"Campo não encontrado no dicionario de dados"
    Else
        cCbox := AllTrim(GetSx3Cache(cCampo, "X3_CBOX"))

        If Empty(cCbox)
            jResult["isList"] := .F.
            jResult["opcoes"] := {}
            jResult["erro"]   := STR0003 //"Campo não é uma lista"
        Else
            aCboxOpts := Self:ParseCbox(cCampo, cCbox)

            jResult["isList"] := .T.
            jResult["opcoes"] := aCboxOpts
            jResult["erro"]   := ""
        EndIf
    EndIf

Return jResult

/*/{Protheus.doc} ParseCbox
    Realiza o parse da string de combobox no formato "CHAVE=DESCRICAO;CHAVE=DESCRICAO" e retorna um array de objetos
    @type    method
    @author  Bruno Almeida
    @since   26/06/2026
    @version p12
    @param   cCampo , Character , nome tecnico do campo (usado para obter descricao localizada via X3CboxDesc)
    @param   cCbox  , Character , string do X3_CBOX no formato "CHAVE=DESCRICAO;CHAVE=DESCRICAO"
    @return  aOpcoes, Array    , array de objetos com as chaves "key" e "value"
/*/
Method ParseCbox(cCampo as Character, cCbox as Character) as Array Class RetailAutopartsCatalogSx3CboxController
    Local aTokens   as Array
    Local aOpcoes   as Array
    Local jOpcao    as Object
    Local cToken    as Character
    Local cKey      as Character
    Local cValue    as Character
    Local nIdx      as Numeric
    Local nSep      as Numeric

    Default cCampo := ""
    Default cCbox  := ""

    aTokens := StrTokArr2(cCbox, ";")
    aOpcoes := {}

    For nIdx := 1 To Len(aTokens)
        cToken := AllTrim(aTokens[nIdx])

        If !Empty(cToken)
            nSep := At("=", cToken)

            If nSep > 0
                cKey   := AllTrim(SubStr(cToken, 1, nSep - 1))
                cValue := AllTrim(X3CboxDesc(cCampo, cKey))

                jOpcao          := JsonObject():New()
                jOpcao["key"]   := cKey
                jOpcao["value"] := cValue
                aAdd(aOpcoes, jOpcao)
                jOpcao := Nil
            EndIf
        EndIf
    Next nIdx

Return aOpcoes
