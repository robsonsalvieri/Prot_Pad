#INCLUDE "TOTVS.CH"
#INCLUDE "TLPP-REST.TH"

namespace totvs.protheus.retail.rmi.api.pshcargadadosapi

using namespace totvs.protheus.retail.rmi.api.pshcargadadosobj

//-------------------------------------------------------------------
/*/{Protheus.doc} api/retail/v1/pshcargadados/consulta
Api para consulta de status da carga de dados baseada na tabela MIN

@type    API
@method  GET
@return  Dados do processo de carga de dados baseado na tabela MIN
@author  Rafael Tenorio da Costa
@version 12.1.2610
/*/
//-------------------------------------------------------------------
@Get("/api/retail/v1/pshcargadados/consulta")
Function consulta()

    Local oCargaDados := PshCargaDados():new(oRest)

    oCargaDados:get()

Return oRest:setResponse( oCargaDados:getReturn() )
