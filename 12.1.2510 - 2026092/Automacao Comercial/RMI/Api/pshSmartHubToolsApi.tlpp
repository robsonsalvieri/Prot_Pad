#INCLUDE "TOTVS.CH"
#INCLUDE "TLPP-REST.TH"

namespace totvs.protheus.retail.rmi.api.pshsmarthubtoolsapi

using namespace totvs.protheus.retail.rmi.api.pshsmarthubtoolsobj

//-------------------------------------------------------------------
/*/{Protheus.doc} api/retail/v1/pshsmarthubtools/consultaprocessos
Api para consulta de processos integrados ativos onde a origem do dado é o protheus

@type    API
@method  GET
@return  Dados do processo e as quantidades de registros para integrar de cada processo
@author  Rafael Tenorio da Costa
@version 12.1.2610
/*/
//-------------------------------------------------------------------
@Get("api/retail/v1/pshsmarthubtools/consultaprocessos")
Function consultaProcessos()

    Local oSmartHubTools := PshSmartHubTools():new(oRest)
    Local cRetorno       := ""

    oSmartHubTools:get()

    cRetorno := oSmartHubTools:getReturn()

    fwFreeObj(oSmartHubTools)

Return oRest:setResponse(cRetorno)

//-------------------------------------------------------------------
/*/{Protheus.doc} api/retail/v1/pshsmarthubtools/iniciacarga
Api para iniciar processo de carga de dados no Protheus

@type    API
@method  POST
@return  Resultado da operação de início de carga com dados do processo e as quantidades de registros para integrar de cada processo
@author  Rafael Tenorio da Costa
@version 12.1.2610
/*/
//-------------------------------------------------------------------
@Post("api/retail/v1/pshsmarthubtools/iniciacarga")
Function iniciaCarga()
    Local oSmartHubTools := PshSmartHubTools():new(oRest)
    Local cRetorno       := ""

    oSmartHubTools:post(.F.)

    cRetorno := oSmartHubTools:getReturn()

    fwFreeObj(oSmartHubTools)

Return oRest:setResponse(cRetorno)
