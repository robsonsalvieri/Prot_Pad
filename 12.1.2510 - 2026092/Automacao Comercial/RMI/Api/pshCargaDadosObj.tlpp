#INCLUDE "TOTVS.CH"

namespace totvs.protheus.retail.rmi.api.pshcargadadosobj

//-------------------------------------------------------------------
/*/{Protheus.doc} Classe PshCargaDados
    Classe da API para consulta de status da carga de dados baseada na tabela MIN
/*/
//-------------------------------------------------------------------
Class PshCargaDados From LojRestObj20

	Public Method new()             as Object
    Public Method getReturn()       as Character

    Protected Method setFields()    as Variant
    Protected Method validation()   as Variant

EndClass

//-------------------------------------------------------------------
/*/{Protheus.doc} new
Método construtor da Classe

@param oWsRestObj - Objeto WSRESTFUL da API

@author  Rafael Tenorio da Costa
@version 12.1.2610
*/
//-------------------------------------------------------------------
Method new(oWsRestObj As Object) as Object Class PshCargaDados

    _Super:new(oWsRestObj, /*jParans*/, /*cBody*/)

    self:setSelect("MIN")
    
Return self

//-------------------------------------------------------------------
/*/{Protheus.doc} setFields
Carrega os campos que serão retornados

@author  Rafael Tenorio da Costa
@version 12.1.2610
*/
//-------------------------------------------------------------------
Method setFields() as Variant Class PshCargaDados

                        //Tag - ID        Campo         Expressão que será executada para gerar o retorno  Tag que será utilizada para preencher o objeto de retorno  Tipo do Campo   Expressão de busca
   HmAdd(self:oFields, {"DATAINICIO"    , "MIN_DTINIC", "alltrim(MIN_DTINIC)"                            , "dataInicio"                                             , "C"           , ""}               , 1, 3)
   HmAdd(self:oFields, {"TOTALREGISTROS", "MIN_QTDTOT", "MIN_QTDTOT"                                     , "totalRegistros"                                         , "N"           , ""}               , 1, 3)
   HmAdd(self:oFields, {"PROCESSO"      , "MIN_CPROCE", "allTrim(MIN_CPROCE)"                            , "processo"                                               , "C"           , ""}               , 1, 3)

Return Nil

//-------------------------------------------------------------------
/*/{Protheus.doc} validation
Metodo para validações executado no momento do get

@author  Rafael Tenorio da Costa
@version 12.1.2610
*/
//-------------------------------------------------------------------
Method validation(cOrigem as Character) as Variant Class PshCargaDados

    _Super:validation()

    If self:lSuccess .and. cOrigem == "GET"

        if !self:jParans:hasProperty("idRetaguardaLoja") .or. Empty( self:jparans['idRetaguardaLoja'] )

            self:lSuccess   := .F.
            self:cError     := I18n("Ops! #1 não enviado(s) ou inválido(s).", {"idRetaguardaLoja"} )  //"Ops! #1 não enviado(s) ou inválido(s)."
        else

            self:cWhere += " AND ( MIN_LJDEST = '" + self:jparans['idRetaguardaLoja'] + "' OR MIN_LJDEST = '" + space( tamSx3("MIN_LJDEST")[1] ) + "' )" 
        EndIf
    EndIf

Return Nil

//-------------------------------------------------------------------
/*/{Protheus.doc} getReturn
Retorna json com resultado da consulta

@author  Rafael Tenorio da Costa
@version 12.1.2610
*/
//-------------------------------------------------------------------
Method getReturn() as Character Class PshCargaDados

    Local jRetorno      as Object 
    Local cRetorno      as Character
    Local cAssinante    as Character
    Local oAux          as Object
    Local nData         as Numeric

    jRetorno:= JsonObject():new()
    jRetorno:fromJson( _Super:getReturn() )

    //Carrega tipo do processo
    cAssinante  := padR("PDVSYNC", tamSx3("MHP_CASSIN")[1])
    oAux        := JsonObject():new()
    MHP->( dbSetOrder(5) )  //MHP_FILIAL, MHP_CASSIN, MHP_TIPO, MHP_ATIVO, R_E_C_N_O_, D_E_L_E_T_
    if MHP->( dbSeek( xFilial("MHP") + cAssinante + "1" ) )

        while !MHP->( eof() ) .and. MHP->MHP_FILIAL == xFilial("MHP") .and. MHP->MHP_CASSIN == cAssinante .and. MHP->MHP_TIPO == "1"

            //Verifica se o json de configuração esta valido
            if oAux:fromJson( allTrim(MHP->MHP_CONFIG) ) == nil

                if ( nData := aScan( jRetorno["data"], {|x| x["processo"] == allTrim(MHP->MHP_CPROCE)} ) ) > 0
                    If oAux:hasProperty("codigotipo")
                        jRetorno["data"][nData]["tipo"] := val( oAux["codigotipo"] )
                    endif
                endif
            endIf
            
            MHP->( dbSkip() )
        endDo
    endIf
    
    cRetorno := encodeUtf8( jRetorno:toJson() )

    ljGrvLog(/*cNumControl*/, "Retorno da API PshCargaDados:", cRetorno)

    fwFreeObj(oAux)
    fwFreeObj(jRetorno)

Return cRetorno
