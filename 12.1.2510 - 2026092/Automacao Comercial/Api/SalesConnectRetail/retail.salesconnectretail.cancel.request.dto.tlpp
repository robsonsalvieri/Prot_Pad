#include "totvs.ch"
#include "tlpp-core.th"
#include "retail.salesconnectretail.cancel.obj.ch"

namespace totvs.protheus.retail.salesconnectretail.dto

/*/{Protheus.doc} SalesConnectRetailCancelRequestDto
DTO do payload JSON (1 venda) para POST /api/retail/v1/SalesConnectRetail/cancel/
(DVARPV-6460). Identificacao da venda (serie+numero; filial via tenantId) + dados
do cancelamento ja ocorrido na SEFAZ (protocolo, documento, data/hora, operador).
NAO recebe XML: todos os dados vem no body (camelCase).
@author Thalys Augusto Alves Juvenal
@since  22/06/2026
@version 1.0
@type class
/*/
Class SalesConnectRetailCancelRequestDto
    Public Data cDocumentSeries  as Character   // L1_SERIE (localiza a venda)
    Public Data cDocumentNumber  as Character   // L1_DOC   (localiza a venda)
    Public Data cCancelProtocol  as Character   // cProtoNfce -> LJ140EXC (pula TSS)
    Public Data cCancelDocNumber as Character   // cNumCancDoc -> LJ140EXC
    Public Data cCancelDate      as Character   // cancelDate ISO (YYYY-MM-DD) -> DtoS
    Public Data cCancelTime      as Character   // cancelTime (HH:MM:SS)
    Public Data cOperator        as Character   // cOperador
    Public Data cCancelReason    as Character   // xJust (auditoria, opcional)

    Public Method New() as Object
    Public Method fromJson(cJson as Character) as Object
    Public Method missingField() as Character
    Protected Method QStr(oJson as Json, cKey as Character) as Character
EndClass

/*/{Protheus.doc} New
Construtor: inicializa todos os campos vazios.
@type   method
@author Thalys Augusto Alves Juvenal
@since  22/06/2026
@return object, Self
/*/
Method New() as Object Class SalesConnectRetailCancelRequestDto
    ::cDocumentSeries  := ""
    ::cDocumentNumber  := ""
    ::cCancelProtocol  := ""
    ::cCancelDocNumber := ""
    ::cCancelDate      := ""
    ::cCancelTime      := ""
    ::cOperator        := ""
    ::cCancelReason    := ""
Return Self

/*/{Protheus.doc} QStr
Le um texto do JsonObject tolerando chave AUSENTE (GetJsonText de chave inexistente
retorna "null" neste build) - normaliza para "" + AllTrim.
@param  oJson, json,      JsonObject (tipo J - usar 'as Json')
@param  cKey,  character, chave a ler
@return character, valor (ou "" se ausente / "null")
@type   method
@author Thalys Augusto Alves Juvenal
@since  22/06/2026
/*/
Method QStr(oJson as Json, cKey as Character) as Character Class SalesConnectRetailCancelRequestDto
    Local cVal := oJson:GetJsonText(cKey)
    If ValType(cVal) != "C" .Or. cVal == "null"
        cVal := ""
    EndIf
Return AllTrim(cVal)

/*/{Protheus.doc} fromJson
Desserializa o body JSON preenchendo os campos. Lanca erro (Throw) em JSON
invalido, capturavel pelo Try/Catch do chamador (SalesConnectRetailCancelObj:ParseRequest).
@type   method
@author Thalys Augusto Alves Juvenal
@since  22/06/2026
@param  cJson, character, payload JSON cru do cancelamento
@return object, Self
/*/
Method fromJson(cJson as Character) as Object Class SalesConnectRetailCancelRequestDto
    Local oJson  as Json
    Local cErr   as Character
    Local oError as Object

    // Body ausente/vazio e cenario distinto de JSON malformado - mensagem especifica
    // (ainda sem instanciar oJson, entao nao ha o que liberar). Empty() nao trata CR/LF/TAB
    // como vazio, entao limpa essas quebras antes (body "vazio" costuma vir com \n).
    If Empty(StrTran(StrTran(StrTran(cJson, Chr(13), ""), Chr(10), ""), Chr(9), ""))
        oError := ErrorClass():New()
        oError:description := STR0002 + ": body vazio"   // "Body JSON invalido: body vazio"
        Throw oError
    EndIf

    oJson := JsonObject():New()
    cErr  := oJson:fromJson(cJson)
    If !Empty(cErr)
        oError := ErrorClass():New()
        oError:description := STR0002 + ": " + cErr   // "Body JSON invalido"
        FWFreeObj(oJson)                              // libera antes do Throw (evita leak)
        Throw oError
    EndIf

    ::cDocumentSeries  := ::QStr(oJson, "documentSeries")
    ::cDocumentNumber  := ::QStr(oJson, "documentNumber")
    ::cCancelProtocol  := ::QStr(oJson, "cancelProtocol")
    ::cCancelDocNumber := ::QStr(oJson, "cancelDocNumber")
    ::cCancelDate      := ::QStr(oJson, "cancelDate")
    ::cCancelTime      := ::QStr(oJson, "cancelTime")
    ::cOperator        := ::QStr(oJson, "operator")
    ::cCancelReason    := ::QStr(oJson, "cancelReason")
    FWFreeObj(oJson)                                  // libera no caminho de sucesso
Return Self

/*/{Protheus.doc} missingField
Retorna o nome do primeiro campo OBRIGATORIO ausente (ou "" se todos preenchidos).
Obrigatorios: documentSeries, documentNumber, cancelProtocol, cancelDocNumber.
cancelDate/Time tem default no dispatch; operator/cancelReason sao opcionais.
@type   method
@author Thalys Augusto Alves Juvenal
@since  22/06/2026
@return character, nome do campo ausente (camelCase) ou "" se valido
/*/
Method missingField() as Character Class SalesConnectRetailCancelRequestDto
    Local cRet := "" as Character

    If Empty(::cDocumentSeries)
        cRet := "documentSeries"
    ElseIf Empty(::cDocumentNumber)
        cRet := "documentNumber"
    ElseIf Empty(::cCancelProtocol)
        cRet := "cancelProtocol"
    ElseIf Empty(::cCancelDocNumber)
        cRet := "cancelDocNumber"
    EndIf
Return cRet
