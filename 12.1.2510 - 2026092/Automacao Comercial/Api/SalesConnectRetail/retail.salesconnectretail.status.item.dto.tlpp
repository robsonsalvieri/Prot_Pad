#include "totvs.ch"
#include "tlpp-core.th"

namespace totvs.protheus.retail.salesconnectretail.dto

/*/{Protheus.doc} SalesConnectRetailStatusItemDto
DTO de um item (linha SL1) na resposta do GET /api/retail/v1/SalesConnectRetail/status/.
@author Thalys Augusto Alves Juvenal
@since  09/06/2026
@version 1.0
@type class
/*/
Class SalesConnectRetailStatusItemDto
    Public Data cBranch         as Character
    Public Data cDocumentNumber as Character
    Public Data cFiscalNumber   as Character
    Public Data cSeries         as Character
    Public Data cAccessKey      as Character
    Public Data cIssueDate      as Character
    Public Data cStatus         as Character
    Public Data cErrorMessage   as Character

    Public Method New(cBranch as Character, cDocumentNumber as Character, cFiscalNumber as Character, cSeries as Character, cAccessKey as Character, cIssueDate as Character, cStatus as Character, cErrorMessage as Character) as Object
    Public Method toJsonObject() as Json
EndClass

/*/{Protheus.doc} New
Construtor do item de status (1 linha da SL1). Parametro ausente (Nil) assume
"" via Default (os valores chegam ja como Character da consulta SL1).
@type   method
@author Thalys Augusto Alves Juvenal
@since  09/06/2026
@param  cBranch,         character, filial (L1_FILIAL)
@param  cDocumentNumber, character, numero do orcamento/cupom (L1_NUM)
@param  cFiscalNumber,   character, numero fiscal (L1_DOC)
@param  cSeries,         character, serie (L1_SERIE)
@param  cAccessKey,      character, chave de acesso NFC-e/NF-e (L1_KEYNFCE)
@param  cIssueDate,      character, data de emissao ISO "YYYY-MM-DD" (L1_EMISSAO)
@param  cStatus,         character, situacao da venda (L1_SITUA)
@param  cErrorMessage,   character, mensagem de erro de processamento (L1_ERGRVBT)
@return object, Self
/*/
Method New(cBranch as Character, cDocumentNumber as Character, cFiscalNumber as Character, cSeries as Character, cAccessKey as Character, cIssueDate as Character, cStatus as Character, cErrorMessage as Character) as Object Class SalesConnectRetailStatusItemDto
    Default cBranch         := ""
    Default cDocumentNumber := ""
    Default cFiscalNumber   := ""
    Default cSeries         := ""
    Default cAccessKey      := ""
    Default cIssueDate      := ""
    Default cStatus         := ""
    Default cErrorMessage   := ""

    ::cBranch         := cBranch
    ::cDocumentNumber := cDocumentNumber
    ::cFiscalNumber   := cFiscalNumber
    ::cSeries         := cSeries
    ::cAccessKey      := cAccessKey
    ::cIssueDate      := cIssueDate
    ::cStatus         := cStatus
    ::cErrorMessage   := cErrorMessage
Return Self

/*/{Protheus.doc} toJsonObject
Monta e retorna o JsonObject do item (sem serializar para string), para o
envelope do GET agregar diretamente.
@type   method
@author Thalys Augusto Alves Juvenal
@since  09/06/2026
@return object, JsonObject com branch/documentNumber/fiscalNumber/series/accessKey/issueDate/status/errorMessage
/*/
Method toJsonObject() as Json Class SalesConnectRetailStatusItemDto
    Local oJson := JsonObject():New() as Json
    oJson["branch"]         := ::cBranch
    oJson["documentNumber"] := ::cDocumentNumber
    oJson["fiscalNumber"]   := ::cFiscalNumber
    oJson["series"]         := ::cSeries
    oJson["accessKey"]      := ::cAccessKey
    oJson["issueDate"]      := ::cIssueDate
    oJson["status"]         := ::cStatus
    oJson["errorMessage"]   := ::cErrorMessage
Return oJson
