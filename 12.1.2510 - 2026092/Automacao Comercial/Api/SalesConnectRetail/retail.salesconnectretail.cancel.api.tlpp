#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "retail.salesconnectretail.cancel.api.ch"

namespace totvs.protheus.retail.salesconnectretail

using namespace totvs.protheus.retail.salesconnectretail.obj

/*/{Protheus.doc} PostCancelVendaVarejo
API POST para recebimento de venda CANCELADA na SEFAZ (DVARPV-6460). Recebe 1
venda por vez (sem lote) e replica o cancelamento na retaguarda via ExecAuto
LJ140EXC, de forma sincrona. Nao reprocessa o TSS (o documento ja foi cancelado
no PDV/SEFAZ - protocolo informado no body).

Function thin: extrai o header X-PASS-KEY e o body raw e delega TODO o
processamento para SalesConnectRetailCancelObj (autentica, valida, localiza a
venda, valida L1_SITUA e dispara o cancelamento).

Autenticacao em duas camadas:
  1) Framework REST do Protheus valida usuario/senha do ERP (header padrao).
  2) X-PASS-KEY (validado dentro do SalesConnectRetailCancelObj:Authenticate)
     comparado contra o token fixo da API.

Empresa/Filial (multi-tenant): definidas pelo header padrao
  "tenantId: <grupoEmpresas>,<filial>" (sem RpcSetEnv/PrepareEnv).

Endpoint: POST /api/retail/v1/SalesConnectRetail/cancel/
Headers:
  - tenantId    : <grupoEmpresas>,<filial>   (padrao plataforma - obrigatorio)
  - X-PASS-KEY  : <token>                    (token API adicional)
Body (camelCase, sem XML):
  { documentSeries, documentNumber, cancelProtocol, cancelDocNumber,
    cancelDate, cancelTime, operator, cancelReason }
Respostas:
  - 200 OK -> { branch, documentNumber, status, message }
  - 400    -> 0001 body invalido / campo obrigatorio ausente
  - 401    -> 0002 X-PASS-KEY invalido ou ausente
  - 404    -> 0010 venda nao encontrada na retaguarda
  - 409    -> 0011 venda nao integrada (L1_SITUA != OK) / 0012 venda ja cancelada
  - 500    -> 0099 falha no cancelamento

@author  Thalys Augusto Alves Juvenal
@since   22/06/2026
@version 1.0
@history DVARPV-6460 - POST de cancelamento de venda Varejo
@type    function
@return  Nil, a resposta e enviada via oRest (setStatusCode/setResponse); sem retorno de valor
/*/
@Post("/api/retail/v1/SalesConnectRetail/cancel/")
Function PostCancelVendaVarejo()
    Local oObj  as Object
    Local cAuth as Character
    Local cBody as Character

    cBody := oRest:getBodyRequest()
    cAuth := oRest:getHeaderRequest("X-PASS-KEY")

    LjGrvLog("/api/retail/v1/SalesConnectRetail/cancel/", "Body recebido (chars):", cValToChar(Len(cBody)))

    oObj := SalesConnectRetailCancelObj():New(cAuth, cBody)
    oObj:Process()

    // setStatusCode define o codigo HTTP REAL (o header 'Status' nao altera o status).
    oRest:setStatusCode(oObj:nHttpStatus)
    oRest:setKeyHeaderResponse('Content-Type', 'application/json; charset=utf-8')
    // FWHttpEncode trata o encode independente do Accept-Charset do client.
    oRest:setResponse( FWHttpEncode(oObj:cReturn) )

    LjGrvLog("/api/retail/v1/SalesConnectRetail/cancel/", "Status retornado: " + cValToChar(oObj:nHttpStatus), oObj:cUuid)
    FWFreeObj(oObj)
Return
