#include "totvs.ch"
#include "tlpp-core.th"

namespace totvs.protheus.retail.salesconnectretail.dto

/*/{Protheus.doc} SalesConnectRetailCreditResponseDto
DTO do envelope de resposta (HTTP 200) do GET .../credit/.
@author Thalys Augusto Alves Juvenal
@since  31/07/2026
@version 1.0
@type class
/*/
Class SalesConnectRetailCreditResponseDto
    Public Data aItems        as Array
    Public Data nTotal        as Numeric
    Public Data nPage         as Numeric
    Public Data nPageSize     as Numeric
    Public Data nTotalBalance as Numeric

    Public Method New(aItems as Array, nTotal as Numeric, nPage as Numeric, nPageSize as Numeric, nTotalBalance as Numeric) as Object
    Public Method toJson() as Character
EndClass

/*/{Protheus.doc} New
Constructor do envelope de credito. aItems e sempre um Array (preenchido por QuerySE1).
@param aItems,        array,   lista de SalesConnectRetailCreditItemDto
@param nTotal,        numeric, total de creditos que casam o filtro (sem paginacao)
@param nPage,         numeric, pagina corrente
@param nPageSize,     numeric, itens por pagina
@param nTotalBalance, numeric, soma de E1_SALDO de todos os creditos que casam o filtro
@return object, Self
@type method
/*/
Method New(aItems as Array, nTotal as Numeric, nPage as Numeric, nPageSize as Numeric, nTotalBalance as Numeric) as Object Class SalesConnectRetailCreditResponseDto
    Default nTotalBalance := 0
    ::aItems        := aItems
    ::nTotal        := nTotal
    ::nPage         := nPage
    ::nPageSize     := nPageSize
    ::nTotalBalance := nTotalBalance
Return Self

/*/{Protheus.doc} toJson
Serializa o envelope: items[], hasNext, remainingRecords, total, totalBalance.
@return character, JSON { items[], hasNext, remainingRecords, total, totalBalance }
@type method
/*/
Method toJson() as Character Class SalesConnectRetailCreditResponseDto
    Local oJson      as Json
    Local aJsonItems as Array
    Local nI         as Numeric
    Local cRet       as Character

    oJson      := JsonObject():New()
    aJsonItems := {}
    For nI := 1 To Len(::aItems)
        aAdd(aJsonItems, ::aItems[nI]:toJsonObject())
    Next nI
    oJson["items"]            := aJsonItems
    oJson["hasNext"]          := (::nPage * ::nPageSize) < ::nTotal
    oJson["remainingRecords"] := Max(::nTotal - (::nPage * ::nPageSize), 0)
    oJson["total"]            := ::nTotal
    oJson["totalBalance"]     := ::nTotalBalance
    cRet := oJson:toJson()
    FWFreeObj(oJson)
Return cRet
