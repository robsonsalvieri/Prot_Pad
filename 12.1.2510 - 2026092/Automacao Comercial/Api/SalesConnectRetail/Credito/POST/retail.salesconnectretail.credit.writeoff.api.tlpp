#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "retail.salesconnectretail.credit.writeoff.api.ch"

namespace totvs.protheus.retail.salesconnectretail

using namespace totvs.protheus.retail.salesconnectretail.obj
using namespace totvs.protheus.retail.salesconnectretail.dto

/*/{Protheus.doc} PostVendaVarejoBaixaCredito
API POST de baixa (compensacao) de creditos NCC do cliente (SE1) via IPaaS (DVARPV-7982).
Recebe o cabecalho da venda (sale) + as NCCs consumidas (credits[]) e compensa reaproveitando
a rotina nativa STWBOBxNCC (cria o titulo CR da venda e compensa via MaIntBxCR, respeitando
MV_LJCPNCC e gerando troco-NCC). 1 chamada = 1 venda (atomico). Compensacao na filial do tenantId.

Function thin: extrai o header X-PASS-KEY e o corpo bruto e delega a SalesConnectRetailCreditWriteOffObj.
Autenticacao em duas camadas: framework REST do ERP + X-PASS-KEY (token fixo). Empresa/filial pelo tenantId.

Endpoint: POST /api/retail/v1/SalesConnectRetail/credit/writeoff/
Respostas:
  - 200 OK -> { status, saleDocument, creditTitle, changeNccGenerated, credits[], uuid }
  - 400    -> 0001 JSON | 0006 sale/credits ausentes | 0007 campo da venda | 0009 nao-NCC/nao encontrado | 0010 valor>saldo | 0011 filial | 0012 totais inconsistentes
  - 401    -> 0002 X-PASS-KEY invalido/ausente
  - 500    -> 0099 erro na compensacao (STWBOBxNCC)

@author  Thalys Augusto Alves Juvenal
@since   06/08/2026
@version 2.0
@history DVARPV-7982 - Baixa/Compensacao de NCC (Credito de Cliente) via STWBOBxNCC
@type function
@return Nil, a resposta e enviada via oRest
/*/
@Post("/api/retail/v1/SalesConnectRetail/credit/writeoff/")
Function PostVendaVarejoBaixaCredito()
    Local oObj       as Object
    Local cAuth      as Character
    Local cBodyJson  as Character
    Local oErr       as Object
    Local oResp      as Object

    cAuth     := oRest:getHeaderRequest("X-PASS-KEY")
    cBodyJson := oRest:getBodyRequest()

    LjGrvLog("/api/retail/v1/SalesConnectRetail/credit/writeoff/", "Body recebido:", cBodyJson)

    oObj := SalesConnectRetailCreditWriteOffObj():New(cAuth, cBodyJson)

    // Rede de seguranca do controller thin: qualquer excecao nao tratada no pipeline do
    // objeto (ex.: macro de MV_LJPREF, acesso a tabela) vira HTTP 500 - do contrario a
    // resposta HTTP ficaria indefinida e o objeto vazaria (FWFreeObj nao executaria).
    Try
        oObj:Process()
        oRest:setStatusCode(oObj:nHttpStatus)
        oRest:setKeyHeaderResponse('Content-Type', 'application/json; charset=utf-8')
        oRest:setResponse( FWHttpEncode(oObj:cReturn) )
        LjGrvLog("/api/retail/v1/SalesConnectRetail/credit/writeoff/", "Status: " + cValToChar(oObj:nHttpStatus), oObj:cUuid)
    Catch oErr
        oResp := SalesConnectRetailErrorDto():New("0099", STR0001) // Erro interno ao processar a baixa de NCC
        oRest:setStatusCode(500)
        oRest:setKeyHeaderResponse('Content-Type', 'application/json; charset=utf-8')
        oRest:setResponse( FWHttpEncode(oResp:toJson()) )
        FWFreeObj(oResp)
        LjGrvLog("/api/retail/v1/SalesConnectRetail/credit/writeoff/", "500: excecao nao tratada: " + oErr:Description, oObj:cUuid)
    EndTry

    FWFreeObj(oObj)
Return
