#include "totvs.ch"
#include "tlpp-core.th"

namespace totvs.protheus.retail.salesconnectretail.dto

/*/{Protheus.doc} SalesConnectRetailCreditWriteOffRequestDto
DTO do corpo do POST .../credit/writeoff/: o cabecalho da venda que usa o credito
+ o array credits[] das NCCs consumidas.
@author Thalys Augusto Alves Juvenal
@since  07/08/2026
@version 2.0
@type class
/*/
Class SalesConnectRetailCreditWriteOffRequestDto
    Public Data cDocument       as Character
    Public Data cSeries         as Character
    Public Data cOperator       as Character
    Public Data cCustomerCode   as Character
    Public Data cCustomerStore  as Character
    Public Data cIssueDate      as Character   // ISO yyyy-mm-dd
    Public Data nCreditUsed     as Numeric
    Public Data nChangeGenerated as Numeric
    Public Data aCredits        as Array

    Public Method New() as Object
    Public Method fromJson(cJson as Character) as Object
    Public Method hasSale() as Logical
    Public Method hasCredits() as Logical
    Public Method missingSaleField() as Character
    Protected Method JStr(oJson as Json, cKey as Character) as Character
    Protected Method JNum(oJson as Json, cKey as Character) as Numeric
EndClass

/*/{Protheus.doc} JStr
Le texto tolerando ausencia ("null" -> "") - padrao provado deste build.
@type method
@author Thalys Augusto Alves Juvenal
@since  07/08/2026
@param oJson, json, objeto JSON de origem
@param cKey, character, nome da chave a ler
@return character, texto sem espacos (vazio quando ausente/vazio/"null")
/*/
Method JStr(oJson as Json, cKey as Character) as Character Class SalesConnectRetailCreditWriteOffRequestDto
    Local cVal := oJson:GetJsonText(cKey) as Character
    // Empty(cVal) cobre explicitamente chave ausente (GetJsonText -> "" neste build);
    // cVal == "null" cobre o valor JSON null. Sem depender de comportamento nao-documentado.
    If ValType(cVal) != "C" .Or. cVal == "null" .Or. Empty(cVal)
        cVal := ""
    EndIf
    cVal := AllTrim(cVal)
Return cVal

/*/{Protheus.doc} JNum
Le numero via Val(GetJsonText).
@type method
@author Thalys Augusto Alves Juvenal
@since  07/08/2026
@param oJson, json, objeto JSON de origem
@param cKey, character, nome da chave a ler
@return numeric, valor numerico (0 quando ausente/invalido)
/*/
Method JNum(oJson as Json, cKey as Character) as Numeric Class SalesConnectRetailCreditWriteOffRequestDto
    Local nRet := 0 as Numeric
    nRet := Val(::JStr(oJson, cKey))
Return nRet

/*/{Protheus.doc} New
Construtor: campos vazios, credits vazio.
@type method
@author Thalys Augusto Alves Juvenal
@since  07/08/2026
@return object, Self
/*/
Method New() as Object Class SalesConnectRetailCreditWriteOffRequestDto
    ::cDocument        := ""
    ::cSeries          := ""
    ::cOperator        := ""
    ::cCustomerCode    := ""
    ::cCustomerStore   := ""
    ::cIssueDate       := ""
    ::nCreditUsed      := 0
    ::nChangeGenerated := 0
    ::aCredits         := {}
Return Self

/*/{Protheus.doc} fromJson
Desserializa o corpo: objeto sale{} + array credits[]. Le sale via indexer
(oJson["sale"]) e credits via indexer (oJson["credits"]) - sem HasProperty.
JSON malformado dispara Throw (mapeado para 400/0001 pelo chamador).
@type method
@author Thalys Augusto Alves Juvenal
@since  07/08/2026
@param cJson, character, corpo bruto da requisicao
@return object, Self
/*/
Method fromJson(cJson as Character) as Object Class SalesConnectRetailCreditWriteOffRequestDto
    Local oJson    as Json
    Local oSale    as Json
    Local aRaw     as Array
    Local nI       as Numeric
    Local oItem    as Object
    Local cErr     as Character
    Local oError   as Object

    oJson := JsonObject():New()
    // JsonObject:fromJson retorna string de erro em falha (nao lanca excecao neste build).
    // Sem checar, um JSON malformado passaria como campos vazios (viraria 0006 em vez de
    // 0001). Verifica e faz Throw -> ParseBody:Catch mapeia para 400/0001.
    cErr := oJson:fromJson(cJson)
    If !Empty(cErr)
        oError := ErrorClass():New()
        oError:description := "Body JSON invalido: " + cErr
        FWFreeObj(oJson)
        Throw oError
    EndIf
    If ValType(oJson["sale"]) == "J"
        oSale := oJson["sale"]
        ::cDocument        := ::JStr(oSale, "document")
        ::cSeries          := ::JStr(oSale, "series")
        ::cOperator        := ::JStr(oSale, "operator")
        ::cCustomerCode    := ::JStr(oSale, "customerCode")
        ::cCustomerStore   := ::JStr(oSale, "customerStore")
        ::cIssueDate       := ::JStr(oSale, "issueDate")
        ::nCreditUsed      := ::JNum(oSale, "creditUsed")
        ::nChangeGenerated := ::JNum(oSale, "changeGenerated")
    EndIf
    If ValType(oJson["credits"]) == "A"
        aRaw := oJson["credits"]
        For nI := 1 To Len(aRaw)
            oItem := SalesConnectRetailCreditWriteOffItemDto():New()
            oItem:fromJson(aRaw[nI])
            AAdd(::aCredits, oItem)
        Next nI
    EndIf
    FWFreeObj(oJson)
Return Self

/*/{Protheus.doc} hasSale
Indica se o objeto sale trouxe ao menos o documento.
@type method
@author Thalys Augusto Alves Juvenal
@since  07/08/2026
@return logical, .T. se ha documento da venda
/*/
Method hasSale() as Logical Class SalesConnectRetailCreditWriteOffRequestDto
    Local lRet := .F. as Logical
    lRet := !Empty(::cDocument)
Return lRet

/*/{Protheus.doc} hasCredits
Indica se ha ao menos um credito.
@type method
@author Thalys Augusto Alves Juvenal
@since  07/08/2026
@return logical, .T. se ha ao menos um item em credits[]
/*/
Method hasCredits() as Logical Class SalesConnectRetailCreditWriteOffRequestDto
    Local lRet := .F. as Logical
    lRet := (Len(::aCredits) > 0)
Return lRet

/*/{Protheus.doc} missingSaleField
Retorna o nome do 1o campo obrigatorio da venda ausente (ou "").
@type method
@author Thalys Augusto Alves Juvenal
@since  07/08/2026
@return character, nome do campo obrigatorio ausente, ou "" se todos presentes
/*/
Method missingSaleField() as Character Class SalesConnectRetailCreditWriteOffRequestDto
    Local cRet := "" as Character
    Do Case
        Case Empty(::cDocument)      ; cRet := "document"
        Case Empty(::cSeries)        ; cRet := "series"
        Case Empty(::cOperator)      ; cRet := "operator"
        Case Empty(::cCustomerCode)  ; cRet := "customerCode"
        Case Empty(::cCustomerStore) ; cRet := "customerStore"
        Case Empty(::cIssueDate)     ; cRet := "issueDate"
        Case ::nCreditUsed <= 0      ; cRet := "creditUsed"
    EndCase
Return cRet
