#include "totvs.ch"
#include "tlpp-core.th"

namespace totvs.protheus.retail.salesconnectretail.dto

/*/{Protheus.doc} SalesConnectRetailCreditWriteOffItemDto
DTO de UM credito (NCC) consumido na venda: request (id=RECNO da SE1 + valor) e
resultado (valor compensado + saldo residual). Parte do POST .../credit/writeoff/.
@author Thalys Augusto Alves Juvenal
@since  07/08/2026
@version 2.0
@type class
/*/
Class SalesConnectRetailCreditWriteOffItemDto
    Public Data nId               as Numeric   // RECNO da SE1 (da Consulta 7981)
    Public Data nAmount           as Numeric   // valor da NCC usado
    Public Data nAmountWrittenOff as Numeric   // resultado
    Public Data nResidualBalance  as Numeric   // resultado

    Public Method New() as Object
    Public Method fromJson(oJson as Json) as Object
    Public Method setResult(nWritten as Numeric, nResidual as Numeric) as Object
    Public Method toJsonObject() as Json
    Protected Method JNum(oJson as Json, cKey as Character) as Numeric
EndClass

/*/{Protheus.doc} JNum
Le numero via Val(GetJsonText) - padrao provado deste build (ausente/"null" -> 0).
@type method
@author Thalys Augusto Alves Juvenal
@since  07/08/2026
@param oJson, json, objeto JSON de origem
@param cKey, character, nome da chave a ler
@return numeric, valor numerico (0 quando a chave esta ausente/vazia/"null")
/*/
Method JNum(oJson as Json, cKey as Character) as Numeric Class SalesConnectRetailCreditWriteOffItemDto
    Local cVal := oJson:GetJsonText(cKey) as Character
    Local nRet := 0 as Numeric
    // Empty(cVal) cobre explicitamente chave ausente (GetJsonText -> "" neste build);
    // cVal == "null" cobre o valor JSON null. Sem depender de comportamento nao-documentado.
    If ValType(cVal) != "C" .Or. cVal == "null" .Or. Empty(cVal)
        cVal := ""
    EndIf
    nRet := Val(AllTrim(cVal))
Return nRet

/*/{Protheus.doc} New
Construtor: request/result zerados.
@type method
@author Thalys Augusto Alves Juvenal
@since  07/08/2026
@return object, Self
/*/
Method New() as Object Class SalesConnectRetailCreditWriteOffItemDto
    ::nId               := 0
    ::nAmount           := 0
    ::nAmountWrittenOff := 0
    ::nResidualBalance  := 0
Return Self

/*/{Protheus.doc} fromJson
Preenche id/amount a partir de um item de credits[].
@type method
@author Thalys Augusto Alves Juvenal
@since  07/08/2026
@param oJson, json, item do array credits[]
@return object, Self
/*/
Method fromJson(oJson as Json) as Object Class SalesConnectRetailCreditWriteOffItemDto
    ::nId     := ::JNum(oJson, "id")
    ::nAmount := ::JNum(oJson, "amount")
Return Self

/*/{Protheus.doc} setResult
Preenche o resultado (valor compensado + saldo residual relido).
@type method
@author Thalys Augusto Alves Juvenal
@since  07/08/2026
@param nWritten, numeric, valor efetivamente compensado (amountWrittenOff)
@param nResidual, numeric, saldo remanescente do titulo apos a baixa (residualBalance)
@return object, Self
/*/
Method setResult(nWritten as Numeric, nResidual as Numeric) as Object Class SalesConnectRetailCreditWriteOffItemDto
    ::nAmountWrittenOff := nWritten
    ::nResidualBalance  := nResidual
Return Self

/*/{Protheus.doc} toJsonObject
Monta o JsonObject do resultado do credito (id/amountWrittenOff/residualBalance).
@type method
@author Thalys Augusto Alves Juvenal
@since  07/08/2026
@return object, JsonObject do item de resultado
/*/
Method toJsonObject() as Json Class SalesConnectRetailCreditWriteOffItemDto
    Local oJson := JsonObject():New() as Json
    oJson["id"]               := ::nId
    oJson["amountWrittenOff"] := ::nAmountWrittenOff
    oJson["residualBalance"]  := ::nResidualBalance
Return oJson
