#INCLUDE "TLPP-CORE.TH"
#INCLUDE "TLPP-REST.TH"

namespace totvs.protheus.retail.rmi.api.ljbaixatituloapi

using namespace totvs.protheus.retail.rmi.api.ljbaixatituloobj


/*/{Protheus.doc} tituloConsulta
API para Baixa de Titulos a Receber, mediante parâmetros
@type function
@author Carlos Chigres
@/api/retail/v1/ljbaixaTitulo
@since 4/24/2026
/*/
@Post("/api/retail/v1/ljbaixaTitulo")
Function baixatituloreceber(jParams as Json,cBody as Character)

    Local cReturn       := ""
    Local obaixatitulo  := Nil

    obaixatitulo := baixatituloobj():New(oRest, jParams, cBody)
    
    obaixatitulo:Get()    
    cReturn := obaixatitulo:getReturn()    
    LjGrvLog("/api/retail/v1/ljbaixaTitulo","Return: ",cReturn)

    IIf(Empty(cReturn),Eval({|| oRest:setStatusCode(500), cReturn := "Ops! A consulta não retornou um json válido. Por favor, verifique os logs do Protheus (Console, LogLoja) para analisar o ocorrido."}),) 
        
    oRest:setResponse(cReturn)   

Return
