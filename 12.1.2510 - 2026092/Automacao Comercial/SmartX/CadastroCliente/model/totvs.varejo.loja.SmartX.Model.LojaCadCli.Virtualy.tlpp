#include "protheus.ch"
#include 'tlpp-core.th'


namespace totvs.varejo.loja.SmartX.Model.LojaCadCli.Virtualy

/*/{Protheus.doc} class Virtualy
Classe para definição dos campos virtuais 

@type class

@author Mayki Lima  
@since 04/2026
@version P12

/*/

#DEFINE STR0001 "Nome do e-mail"

#DEFINE STR0002 "Domínio do e-mail"

class Virtualy
    
    private data oObject as object

    public  method new() as object
    public  method get() as json
    private method setFields()
    private method setIndex()
    private method setFinder()

    public method GetDominiosOptions() as array

endClass

Method new() as object class Virtualy
Return ( self )

/*/{Protheus.doc} setFields
Define os campos do objeto
/*/
Method setFields() class Virtualy
   
Local oField as object
Local aDados as array
                 
::oObject := totvs.framework.structure.object.BuildFromCode():new( "EMULADOR" )

// Parte do e-mail (antes do @)
oField := totvs.framework.structure.object.BuildFieldProperties():new( "A1_MAILDIG" )
oField:setType(Valtype("C"))
oField:setTitle(STR0001)
oField:setSize(TamSx3( 'A1_EMAIL' )[1])  
oField:setOrder(1)
oField:setUpperCase(.F.)

::oObject:addFieldProperties( oField:getFieldProperties() )

aDados := ::GetDominiosOptions()

// Domínio (depois do @)
oField := totvs.framework.structure.object.BuildFieldProperties():new( "A1_DOMMAIL" )
oField:setType(Valtype("C"))
oField:setTitle(STR0002)
oField:setSize(TamSx3( 'A1_EMAIL' )[1])  
oField:setOrder(2)
if aDados != NIL
   oField:setOptionsList(aDados)
endif   
oField:setUpperCase(.F.)
::oObject:addFieldProperties( oField:getFieldProperties() )

Return ( ) 

/*/{Protheus.doc} setIndex
Define os index do objeto
/*/
Method setIndex() class Virtualy
    Local oIndex as object

    oIndex := totvs.framework.structure.object.BuildIndex():new( "EMULADOR" + cEmpAnt + "0" )
    oIndex:setOrder("1")
    oIndex:setKeyFields({"A1_MAILDIG", "A1_DOMMAIL"}) 

    ::oObject:addIndexConstraint( oIndex:getIndex() )

    ::oObject:setUniqueKeyConstraint( "EMULADOR" + cEmpAnt + "0", { "A1_MAILDIG", "A1_DOMMAIL" } )

Return()

/*/{Protheus.doc} setFinder
Define o finder do objeto
/*/
Method setFinder() class Virtualy
    Local oFinder as object

    oFinder := totvs.framework.structure.model.finder():new()
    oFinder:setFinder({ "A1_MAILDIG", "A1_DOMMAIL" }, "", .T.)

    ::oObject:addFinder( oFinder:getFinder() )

return

/*/{Protheus.doc} get
Retorna o objeto

/*/
Method get() as json class Virtualy
    ::setFields()
    ::setIndex()
    ::setFinder()
Return( ::oObject:getObject() )


Method GetDominiosOptions() as array class Virtualy

    Local aRet      := {}
    Local cDominios := SuperGetMV("MV_LJDMAIL", .F., "")
    Local aLista    := {}
    Local nI        := 0

    If Empty(cDominios)
        Return( NIL )
    EndIf
    // quebra por ;
    aLista := StrTokArr(cDominios, ";")

    For nI := 1 To Len(aLista)
        AAdd(aRet, { cValToChar(nI), AllTrim(aLista[nI]) })
    Next

Return aRet

