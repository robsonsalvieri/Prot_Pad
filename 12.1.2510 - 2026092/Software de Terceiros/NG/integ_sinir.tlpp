#include 'tlpp-core.th'

//-------------------------------------------------------------------
/*/{Protheus.doc} SendSGAMTR
Envia manifesto para Sinir

@type   Function

@author Eduardo Mussi
@since  19/12/2024
@param  [cJsonMTR], caracter, Json com os dados do manifesto
@param  nOption   , Numerico, opção do sinir
                            1 - Criar Manifesto
                            2 - Cancelar Manifesto
                            3 - Retornar Manifesto( Consulta de Manifesto )
                            4 - Retornar Manifesto em lote
@param  cCodsin   , Caracter, Código do Sinir
@param  [cNumMTR] , Caracter, Código do Manifesto

@return Indefinido, nOption == 1 Retorna o código do manifesto gerado.
                    nOption == 2 Define se o manifesto foi cancelado.
                    nOption == 3 Retorna dados do manifesto consultado.
                    nOption == 4 Define se o manifesto foi retornado.
/*/
//-------------------------------------------------------------------
Function SendSGAMTR( cJsonMTR, nOption, cCodSin, cNumMTR )

    Local cToken := GetTokenSN( cCodSin )
    Local xReturn

    Default cJsonMTR := ''
    Default cNumMTR  := '' // Usado apenas no processo de consulta do manifesto
       
    If !Empty( cToken )
        
        If nOption == 1
            
            xReturn := SGARegManifest( cToken, cJsonMTR )

        ElseIf nOption == 2
            
            xReturn := SGACanManifest( cToken, cJsonMTR )

        ElseIf nOption == 3
            
            xReturn := SGARetManifest( cToken, cNumMTR )

        ElseIf nOption == 4
            
            xReturn := SendSGALoteRetMTR( cToken, cJsonMTR )

        EndIf

    EndIf

Return xReturn

//-------------------------------------------------------------------
/*/{Protheus.doc} GetTokenSN
Busca token de autentição no SINIR

@type   Function

@author Eduardo Mussi
@since  20/12/2024
@param  cCodSin, caracter, código do sinir

@return caracter, retorna token de acesso
/*/
//-------------------------------------------------------------------
Function GetTokenSN( cCodSin )
    
    Local cToken    := ''
    Local cError    := ''
    Local cResponse := ''
    Local cJsonData := ''
    Local nStatus   := 0
    Local oResponse
    
    Default cCodSin := ''

    // Busca na tabela de cruzamento Protheus SINIR se o usuário logado possui registro de acesso ao SINIR
    cJsonData := fGetUser( cCodSin )  

    If !Empty( cJsonData )
        
        cResponse := HTTPPost( 'https://admin.sinir.gov.br/apiws/rest/gettoken', /*cGetParms*/, cJsonData, /*nTimeOut*/, { 'Content-Type: application/json' } )
        nStatus   := HTTPGetStatus( @cError )

        If nStatus == 200
        
            // Converte a resposta JSON para um objeto AdvPL
            FWJsonDeserialize( cResponse, @oResponse )

            If oResponse[ 'erro' ]
                
                Help( '', , 'Falha na autenticação', NIL, oResponse[ 'mensagem' ], 1, 0 )
                
            Else

                cToken := oResponse[ 'objetoResposta' ]
                
            EndIf

        Else
            conout( 'cJsonData - ' + cJsonData )
            conout( 'cResponse - ' + cResponse )
            Conout( 'Erro nStatus - ' + cValToChar( nStatus ) )

            Help( '', , "Erro na requisição de token!", NIL, cError, 1, 0 )
            
        EndIf
        
    Else
        
        Help( '', , 'Atenção', NIL, 'Este usuário não possui permissão!', 1, 0 )

    EndIf

Return cToken

//-------------------------------------------------------------------
/*/{Protheus.doc} SGARegManifest
Função responsável por gerar o manifesto no sinir com os dados do protheus

@type   Function

@author Eduardo Mussi
@since  17/12/2024

@param  cToken, caracter, Token de acesso ao SINIR
@param  cJsonMTR, caracter, JSON com os dados a serem transmitidos

@return cReturn, caso executado com sucesso retorna código do manifesto.
/*/
//-------------------------------------------------------------------
Function SGARegManifest( cToken, cJsonMTR )

    // Realiza a requisição POST
    Local cError    := ''
    Local cReturn   := ''
    Local cResponse := HTTPPost( 'https://admin.sinir.gov.br/apiws/rest/salvarManifestoLote', /*cGetParms*/, cJsonMTR, /*nTimeOut*/, { 'Content-Type: application/json', 'Authorization: ' + cToken } )
    Local nStatus   := HTTPGetStatus( @cError )
    Local oModel    := FWModelActive()
    Local oResponse

    If nStatus == 200
    
        // Converte a resposta JSON para um objeto AdvPL
        FWJsonDeserialize( cResponse, @oResponse )

        If !oResponse:respostaApiwsManifestoDTO[ 1 ]:restResponseValido
            
            //Help( '', , 'Erro ao criar Manifesto', NIL, oResponse:respostaApiwsManifestoDTO[ 1 ]:restResponseMensagem, 1, 0 )
            oModel:SetErrorMessage( '', '', '', '', 'Erro ao criar Manifesto', DecodeUTF8( oResponse:respostaApiwsManifestoDTO[ 1 ]:restResponseMensagem ) )

        Else
            cReturn := oResponse:respostaApiwsManifestoDTO[ 1 ]:manifestoNumeroNacional
            Help( '', , 'Atenção', NIL, 'Manifesto ' + oResponse:respostaApiwsManifestoDTO[ 1 ]:manifestoNumeroNacional + ' criado com sucesso!', 1, 0 )
            
            // Após retornar o código do manifesto, abre tela pro usuário salvar o PDF.
            ManDownDoc( oResponse:respostaApiwsManifestoDTO[ 1 ]:manifestoNumeroNacional )

        EndIf

    Else

        Conout( '+-----------------------------------------------------------+' )
        Conout( '| Erro nStatus - ' + cValToChar( nStatus ) )
        Conout( '+-----------------------------------------------------------+' )
        conout( '' )
        Conout( '+-----------------------------------------------------------+' )
        conout( 'cJsonMTR - ' + cJsonMTR )
        Conout( '+-----------------------------------------------------------+' )
        conout( '' )
        Conout( '+-----------------------------------------------------------+' )
        conout( 'cResponse - ' + cResponse )
        Conout( '+-----------------------------------------------------------+' )

        Help( '', , 'Atenção', NIL, 'Erro ao criar manifesto!', 1, 0 )

        // Avaliar cenário se deverá ser impeditivo a criação no protheus ou não
        //oModel:SetErrorMessage( '', '', '', '', 'Erro ao criar Manifesto', DecodeUTF8( oResponse:respostaApiwsManifestoDTO[ 1 ]:restResponseMensagem ) )

    EndIf

    FwFreeObj( oResponse )
    
Return cReturn


//-------------------------------------------------------------------
/*/{Protheus.doc} SGACanManifest
Realiza o cancelamento de um manifesto.

@type   Function

@author Eduardo Mussi
@since  17/12/2024

@param  cToken  , caracter, Token de acesso ao SINIR
@param  cJsonMTR, caracter, JSON com os dados a serem transmitidos

@return Lógico, Retorna se o cancelamento foi efetuado
/*/
//-------------------------------------------------------------------
Function SGACanManifest( cToken, cJsonMTR )

    // Realiza a requisição POST
    Local cError    := ''
    Local cResponse := HTTPPost( 'https://admin.sinir.gov.br/apiws/rest/cancelarManifesto', /*cGetParms*/, cJsonMTR, /*nTimeOut*/, { 'Content-Type: application/json', 'Authorization: ' + cToken } )
    Local nStatus   := HTTPGetStatus( @cError )
    Local lReturn   := .T.
    Local oModel    := FWModelActive()
    Local oResponse

    If nStatus == 200
    
        // Converte a resposta JSON para um objeto AdvPL
        FWJsonDeserialize( cResponse, @oResponse )

        If !oResponse[ 'erro' ]
            
            Help( '', , 'Atenção', NIL, oResponse[ 'mensagem' ], 1, 0 )

        Else

            oModel:SetErrorMessage( '', '', '', '', 'Atenção', 'Ocorreu um erro e o manifesto não foi cancelado. Favor contatar o administrador do sistema.' )
            lReturn := .F. 

        EndIf

    Else

        Conout( '+-----------------------------------------------------------+' )
        Conout( '| Erro nStatus - ' + cValToChar( nStatus ) )
        Conout( '+-----------------------------------------------------------+' )
        conout( '' )
        Conout( '+-----------------------------------------------------------+' )
        conout( 'cJsonMTR - ' + cJsonMTR )
        Conout( '+-----------------------------------------------------------+' )
        conout( '' )
        Conout( '+-----------------------------------------------------------+' )
        conout( 'cResponse - ' + cResponse )
        Conout( '+-----------------------------------------------------------+' )

        oModel:SetErrorMessage( '', '', '', '', 'Atenção', 'Erro ao cancelar manifesto!' )
        lReturn := .F.

    EndIf

    FwFreeObj( oResponse )
    
Return lReturn

//-------------------------------------------------------------------
/*/{Protheus.doc} SGARetManifest
Busca dados de um determinado manifesto

@type   Function

@author Eduardo Mussi
@since  17/04/2025

@param  cToken , caracter, Token de acesso ao SINIR
@param  cNumMTR, Caracter, Numero do MTR a ser pesquisado

@return Objeto, retorna objeto com todas as infomrmações do manifesto
/*/
//-------------------------------------------------------------------
Function SGARetManifest( cToken, cNumMTR )

    Local cError     := ''
    Local cResponse  := HTTPGet( 'https://admin.sinir.gov.br/apiws/rest/retornaManifesto/' + cNumMTR, /*cGetParms*/, /*nTimeOut*/, { 'Content-Type: application/json', 'Authorization: ' + cToken } )
    Local nStatus    := HTTPGetStatus( @cError )
    Local oResponse  := JsonObject():New()
    Local oObjReturn := JsonObject():New()
    
    oResponse:FromJson( cResponse )
    
    If oResponse:hasProperty( 'erro' )
        
        oObjReturn[ 'erro' ] := oResponse[ 'erro' ]
        oObjReturn[ 'ObjetoResposta' ] := oResponse[ 'ObjetoResposta' ]
    
     Else

        oObjReturn[ 'erro' ] := .T.

    EndIf

    Conout( '+-----------------------------------------------------------+' )
    Conout( '| Valor nStatus - ' + cValToChar( nStatus ) )
    Conout( '+-----------------------------------------------------------+' )
    conout( '' )
    Conout( '+-----------------------------------------------------------+' )
    conout( 'cNumMTR - ' + cNumMTR )
    Conout( '+-----------------------------------------------------------+' )
    conout( '' )
    Conout( '+-----------------------------------------------------------+' )
    conout( 'cResponse - ' + cResponse )
    Conout( '+-----------------------------------------------------------+' )

Return oResponse

//-------------------------------------------------------------------
/*/{Protheus.doc} SGAGetClass
Busca as classes do sinir e as inclui no protheus

@type   Function

@author Eduardo Mussi
@since  20/12/2024

@return Nil
/*/
//-------------------------------------------------------------------
Function SGAGetClass()
    
    Local cToken    := GetTokenSN()
    Local cError    := ''
    Local cResponse := ''
    Local nStatus   := 0
    Local nClass    := 0
    Local oResponse
    
    If !Empty( cToken )
        
        cResponse := HTTPGet( 'https://admin.sinir.gov.br/apiws/rest/retornaListaClasse', /*cGetParms*/, /*nTimeOut*/, { 'Content-Type: application/json', 'Authorization: ' + cToken } )
        nStatus   := HTTPGetStatus( @cError )

        If nStatus == 200
        
            // Converte a resposta JSON para um objeto AdvPL
            FWJsonDeserialize( cResponse, @oResponse )

            If oResponse[ 'erro' ]

                Help( '', , 'Erro ao buscar classes', NIL, oResponse[ 'mensagem' ], 1, 0 )

            Else

                dbSelectArea( 'TCS' )
                dbSetOrder( 1 )

                For nClass := 1 To Len( oResponse:objetoResposta )
                    
                    // Verifica se o registro já existe
                    If MsSeek( FwxFilial( 'TCS' ) + cValToChar( oResponse:objetoResposta[ nClass ]:claCodigo ) )
                        
                        RecLock( 'TCS', .F. ) // Atualiza registro existente
                        TCS->TCS_DESCRIC := oResponse:objetoResposta[ nClass ]:claCodigo
                        TCS->( MsUnLock() )

                    Else

                        RecLock( 'TCS', .T. ) // Adiciona novo registro
                        TCS->TCS_FILIAL  := FwxFilial( 'TCS' )
                        TCS->TCS_CLASSE  := cValToChar( oResponse:objetoResposta[ nClass ]:claCodigo )
                        TCS->TCS_DESCRIC := oResponse:objetoResposta[ nClass ]:claDescricao //+ oResponse:objetoResposta[ nClass ]:claResolucao AVALIAR NECESSIDADE
                        TCS->( MsUnLock() )

                    EndIf

                Next nClass
                
            EndIf

        Else
            
            Conout( 'Mensagem de erro - ' + cError )
            Conout( 'Erro nStatus - ' + cValToChar( nStatus ) )
            
            Help( '', , 'Atenção', NIL, 'Erro na requisição de classes!', 1, 0 )

        EndIf
        
        FwFreeObj( oResponse )

    EndIf

Return

//-------------------------------------------------------------------
/*/{Protheus.doc} fGetUser
Busca informações do usuário do Sinir com base no usuário logado

@type   Function

@author Eduardo Mussi
@since  20/12/2024
@param  cCodSin, caracter, código do sinir

@return caracter, retorna as informações de acesso do Sinir
/*/
//-------------------------------------------------------------------
Static Function fGetUser( cCodSin )

    Local aKey      := {}
    Local cAliasQry := ''
    Local cCpf      := ''
    Local cKey      := ''
    Local cJsonUser := ''

    // Caso código do sinir não venha preenchido, faz a busca de forma generica
    If Empty( cCodSin )

        dbSelectArea( 'TH5' )
        dbSetOrder( 2 )
        If MsSeek( FwxFilial( 'TH5' ) + __cUserID )
        
            dbSelectArea( 'TH6' )
            dbSetOrder( 1 )
            If MsSeek( FwxFilial( 'TH6' ) + TH5->TH5_CODIGO )
                
                cKey := AllTrim( TH5->TH5_SENHAC )
                cCpf := TH5->TH5_CPF
                cCod := TH6->TH6_CODSIN

            EndIf

        EndIf

    Else
        
        // trecho responsável por procurar um código do sinir onde possuir mais
        // de 1 registro cadastrado para o mesmo usuário protheus
        cAliasQry := GetNextAlias()

        BeginSQL Alias cAliasQry
        
            SELECT TH5_SENHAC, TH5_CPF, TH6_CODSIN FROM %table:TH5% TH5
                INNER JOIN %table:TH6% TH6
                    ON  TH5.TH5_CODIGO = TH6.TH6_CODIGO
                    AND TH6.TH6_CODSIN = %exp:cCodSin%
                    AND TH6.%NotDel%
            WHERE TH5.TH5_CODUSR = %exp:__cUserID%
            AND TH5.%NotDel%
        
        EndSQL

        If (cAliasQry)->( !EoF() )
            cKey := AllTrim( (cAliasQry)->TH5_SENHAC )
            cCpf := (cAliasQry)->TH5_CPF
            cCod := (cAliasQry)->TH6_CODSIN
        EndIf
        
        (cAliasQry)->( dbCloseArea() )

    EndIf

    If !Empty( cKey )
        
        // Pega os 3 itens do processamento de descriptografia
        aAdd( aKey, SUBSTR( cKey, 1, AT( "p.s", cKey ) - 1 ) )

        cKey := StrTran( cKey, aKey[ 1 ] + 'p.s', '' )

        aAdd( aKey, SUBSTR( cKey, 1, AT( "p.s", cKey ) - 1 ) )

        cKey := StrTran( cKey, aKey[ 2 ] + 'p.s', '' )

        aAdd( aKey, AllTrim( cKey ) )
        
        cJsonUser := '{"cpfCnpj":"' + cCpf + '","senha":"' + AESDecrypt( 0, aKey[ 1 ], aKey[ 2 ], aKey[ 3 ] )[ 2 ] + '","unidade":"' + AllTrim(cCod) + '"}'

        Conout(cJsonUser)

    EndIf

    FwFreeArray( aKey )
    
Return cJsonUser

//-------------------------------------------------------------------
/*/{Protheus.doc} ProtheusDoc
Responsável por abrir opção de salvar PDF ao usuário

@type   Function

@author Eduardo Mussi
@since  02/07/2025
@param  cCodMan, caracter, código do Manifesto

@return Nil
/*/
//-------------------------------------------------------------------
Function ManDownDoc( cCodMan )
    
    Local cToken   := ''
    Local cPathPDF := ''

    File( getTempPath() )
    cPathPDF := tFileDialog( 'All(*)', 'Selecionar diretório',, getTempPath(), .F., GETF_RETDIRECTORY )
	
    ConOut( cPathPDF )

	If !Empty( cPathPDF )
        
        cToken   := GetTokenSN()

        If !Empty( cToken ) .And. !Empty( cCodMan )
            
            FWMsgRun( , { || fDownload( cToken, cCodMan, cPathPDF ) }, 'Processando', "Baixando arquivo, por favor aguarde!")
            
        EndIf

    EndIf

Return

//-------------------------------------------------------------------
/*/{Protheus.doc} fDownload
Responsável por fazer o download o PDF e salvar localmente

@type   Function

@author Eduardo Mussi
@since  02/07/2025
@param  cToken, caracter, Token de acesso SINIR
@param  cCodMan, caracter, Código do manifesto
@param  cPathPDF, caracter, Local a ser salvo o arquivo pdf

@return Nil
/*/
//-------------------------------------------------------------------
Static Function fDownload( cToken, cCodMan, cPathPDF )

    Local aHeader   := { 'Content-Type: application/json', 'Authorization: ' + cToken }
    Local cURL      := 'https://admin.sinir.gov.br/apiws/rest/'
    Local cPath     := 'downloadManifesto/'
    Local nHandle   := 0
    Local lSaveFile := .F.
    Local oRest

    oRest := FwRest():New( cURL )
    oRest:SetPath( cPath + cCodMan )

    If oRest:Post( aHeader )
        
        // Caso já possua um arquivo com o mesmo numero, pergunta ao usuário se deve sobrescrever o arquivo existente
        If File( cPathPDF + 'Manitfesto-' + cCodMan + '.pdf' )
            
            If MsgYesNo( 'Arquivo já existente, deseja sobrescrever?', 'Atenção'  )

                FErase( cPathPDF + 'Manitfesto-' + cCodMan + '.pdf' )
                lSaveFile := .T.

            EndIf

        Else
            
            lSaveFile := .T.

        EndIf

        If lSaveFile
            
            nHandle := FCreate( cPathPDF + 'Manitfesto-' + cCodMan + '.pdf' )
            FWrite( nHandle, 'Manitfesto-' + oRest:GetResult() )
            FClose( nHandle )

            If File( cPathPDF + 'Manitfesto-' + cCodMan + '.pdf' )
                
                ConOut('Arquivo Manitfesto-' + cCodMan + '.pdf foi criado com sucesso! ')

            Else
                
                ConOut( 'Arquivo não salvo!' )

            EndIf

        EndIf

    Else

        ConOut('Não foi possível acessar API' + oRest:GetLastError() )

    EndIf

    FwFreeArray( aHeader )
    FwFreeObj( oRest )

Return

//-------------------------------------------------------------------
/*/{Protheus.doc} ProtheusDoc
Responsável por realizar o retorno em lote do manifesto

@type   Function

@author Eduardo Mussi
@since  04/07/2025
@param  cToken  , caracter, Token de acesso SINIR
@param  cJsonMTR, caracter, Json com os dados do recebimento

@return Lógico, define se o processo foi executado com sucesso
/*/
//-------------------------------------------------------------------
Static Function SendSGALoteRetMTR( cToken, cJsonMTR )
    
    Local aHeader   := { 'Content-Type: application/json', 'Authorization: ' + cToken }
    Local cURL      := 'https://admin.sinir.gov.br/apiws/rest/'
    Local cPath     := 'receberManifestoLote'
    Local lReturn   := .T.
    Local oModel    := FWModelActive()
    Local oResult   := JsonObject():new()
    Local oRest

    oRest := FwRest():New( cURL )
    oRest:SetPath( cPath )
    oRest:SetPostParams( cJsonMTR )

    If oRest:Post( aHeader )
        
        Conout( 'Passou com sucesso pela requisição' )

        oResult:FromJson( oRest:GetResult() )
        
        If !oResult[ 'objetoResposta', 1, 'restResponseValido' ]

            // Seta erro encontrado no retorno da resquisição no Modelo MVC ativo        
            oModel:SetErrorMessage( '', '', '', '', 'Atenção', DecodeUTF8( oResult[ 'objetoResposta', 1, 'restResponseMensagem' ] ) )
            lReturn := .F.

        EndIf

    Else
        
        oResult:FromJson( oRest:GetLastError() )
        
        // Seta erro encontrado no retorno da resquisição no Modelo MVC ativo
        oModel:SetErrorMessage( '', '', '', '', 'Atenção', DecodeUTF8( oResult[ 'objetoResposta', 1, 'restResponseMensagem' ] ) )
        lReturn := .F.

    EndIf
    
    FwFreeArray( aHeader )
    FwFreeObj( oResult )
    FwFreeObj( oRest )

Return lReturn
