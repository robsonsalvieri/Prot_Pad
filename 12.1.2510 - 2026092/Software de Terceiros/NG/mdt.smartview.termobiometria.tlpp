//-------------------------------------------------------------------
/*/{Protheus.doc} GetData
Método responsável pelo processamento dos dados enviados pelo 
Objeto de Negócio
@type Método

@author Eloisa Anibaletto
@since 17/06/2026
@version P11

@param nPage, numerico, Número da página atual
@param oFilter, objeto, Filtros aplicados pelo usuário

@return objeto, Retorna o próprio objeto
/*/
//-------------------------------------------------------------------
method getData( nPage as numeric, oFilter as object ) as object class TermoBiometriaSmartViewBusinessObject

    Local cAlias    as character
    Local cQueryTM0 as character
    Local cNumFic   as character
    Local cMat      as character
    Local cNomFic   as character
    Local cCpf      as character

    Local jParams   as json

    Local oExec     as object

    jParams := oFilter:getParameters() // metodo para retorno do json dos parâmetros

    cAlias  := GetNextAlias()

    cQueryTM0 := " SELECT TM0.TM0_FILIAL, TM0.TM0_NUMFIC, TM0.TM0_MAT, TM0.TM0_NOMFIC, TM0.TM0_CPF "
    cQueryTM0 += " FROM " + RetSqlName( "TM0" ) + " TM0 "
    cQueryTM0 += " WHERE TM0.TM0_MAT != ' ' "
    cQueryTM0 += " AND TM0.TM0_FILIAL BETWEEN '" + jParams[ "MV_PAR01", 1 ] + "' AND '" + jParams[ "MV_PAR02", 1 ] + "'"
    cQueryTM0 += " AND TM0.TM0_NUMFIC BETWEEN '" + jParams[ "MV_PAR03", 1 ] + "' AND '" + jParams[ "MV_PAR04", 1 ] + "'"
    cQueryTM0 += " AND TM0.D_E_L_E_T_ = ?"
    cQueryTM0 := ChangeQuery( cQueryTM0 )

    oExec := FwExecStatement():New( cQueryTM0 )
    oExec:SetString( 1, ' ' )

    cAlias := oExec:OpenAlias()

    // Paginação
    If nPage == 1

        ( cAlias )->( dbGoTop() )

    EndIf

    DbSelectArea( cAlias )
    dbGoTop()

    While !( cAlias )->( Eof() )

        cNumFic := MDTHideCpo( ( cAlias )->TM0_NUMFIC, 'TM0_NUMFIC' )
        cMat    := MDTHideCpo( ( cAlias )->TM0_MAT   , 'TM0_MAT'    )
        cNomFic := MDTHideCpo( ( cAlias )->TM0_NOMFIC, 'TM0_NOMFIC' )
        cCpf    := MDTHideCpo( ( cAlias )->TM0_CPF   , 'RA_CIC'     )

        self:oData:appendData( { 'TM0_NUMFIC' : cNumFic, ;
            'TM0_MAT'   : cMat   , ;
            'TM0_NOMFIC': cNomFic, ;
            'TM0_CPF'   : cCpf } )

        ( cAlias )->( dbSkip() )

    Enddo

    self:setHasNext( ( cAlias )->( !Eof() ) )

    ( cAlias )->( DBCloseArea() )

    oExec:Destroy()
    oExec := Nil

return self:oData


//-------------------------------------------------------------------
/*/{Protheus.doc} getSchema
Método responsável por informar as características dos campos e 
também os parâmetros quando esses não são adicionados pela SX1
@type Método

@author Eloisa Anibaletto
@since 17/06/2026
@version P11

@return objeto, Retorna a si mesmo
/*/
//-------------------------------------------------------------------
method getSchema() as object class TermoBiometriaSmartViewBusinessObject

    self:AddParameter( 'MV_PAR01', 'De Filial?'     , 'string', .F. )
    self:AddParameter( 'MV_PAR02', 'Até Filial?'    , 'string', .F. )
    self:AddParameter( 'MV_PAR03', 'De Ficha?'      , 'string', .F. )
    self:AddParameter( 'MV_PAR04', 'Até Ficha?'     , 'string', .F. )

    self:setCustomURL( 'MV_PAR01', 'api/framework/v1/genericLookupService/smartview/SM0', 2 )
    self:setCustomURL( 'MV_PAR02', 'api/framework/v1/genericLookupService/smartview/SM0', 2 )
    self:setCustomURL( 'MV_PAR03', 'api/framework/v1/genericLookupService/smartview/TM0', 2 )
    self:setCustomURL( 'MV_PAR04', 'api/framework/v1/genericLookupService/smartview/TM0', 2 )

    self:addProperty( 'TM0_NUMFIC', 'Número da Ficha Médica', 'string', 'Ficha Médica'       , 'TM0_NUMFIC' )
    self:addProperty( 'TM0_MAT'   , 'Matrícula'             , 'string', 'Matrícula'          , 'TM0_MAT'    )
    self:addProperty( 'TM0_NOMFIC', 'Nome'                  , 'string', 'Nome do Colaborador', 'TM0_NOMFIC' )
    self:addProperty( 'TM0_CPF'   , 'CPF'                   , 'string', 'CPF'                , 'TM0_CPF'    )

return self:oSchema
