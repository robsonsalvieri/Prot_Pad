#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "mntmanut.ch"

//------------------------------------------------------------------------------
/*/{Protheus.doc} mntManut
Função executada pela rota "mnt-insight/new-maintenance/:equipment/:service"
Realiza a inclusão de uma manutenção via ExecAuto

@type Function

@author João Ricardo Santini Zandoná
@since 12/11/2025

@return Nil  
/*/ 
//------------------------------------------------------------------------------
@Post ( endpoint = 'mnt-insight/new-maintenance/:equipment/:service' )
function mntManut()

    Local oError
	Local bLastError
    Local aSerData   := {}
    Local aResponse  := { Nil ,200 }
    Local jRespJson  := JsonObject():New()
    Local jPathParam := oRest:GetPathParamsRequest()

	bLastError := ErrorBlock( { | oError | MntWSError( oError ), .F., Break( oError ) } )

    Begin Sequence

        If jPathParam:HasProperty( 'equipment' ) .And. ValType( jPathParam[ 'equipment' ] ) == 'C' .And. !Empty( jPathParam[ 'equipment' ] ) .And.;
        jPathParam:HasProperty( 'service' ) .And. ValType( jPathParam[ 'service' ] ) == 'C' .And. !Empty( jPathParam[ 'service' ] )

            aSerData := fSerialize( oRest, jPathParam[ 'equipment' ] )

            // Se o array tiver apenas duas posições elas são código e mensagem e um erro aconteceu na serialização
            If Len( aSerData ) > 2

                aResponse := fExecAuto( aSerData, jPathParam[ 'service' ] )

            Else

                aResponse := aSerData

            EndIf

        Else

            aResponse[1] := STR0001 // "O equipamento deve ser informado!"
            aResponse[2] := 400
            
        EndIf

        jRespJson['message'] := DecodeUTF8( aResponse[ 1 ] )

        If jRespJson['message'] == Nil
            jRespJson['message'] := aResponse[ 1 ]
        EndIf

        oRest:SetStatusCode( aResponse[ 2 ] )
        oRest:SetResponse( jRespJson )

	End Sequence
    
    ErrorBlock( bLastError )

return

@Put ( endpoint = 'mnt-insight/update-maintenance/:equipment/:service/:seqrela' )
function mntManutUpdate()

    Local oError
	Local bLastError
    Local aSerData   := {}
    Local aResponse  := { Nil ,200 }
    Local jRespJson  := JsonObject():New()
    Local jPathParam := oRest:GetPathParamsRequest()

	bLastError := ErrorBlock( { | oError | MntWSError( oError ), .F., Break( oError ) } )

    Begin Sequence

        If jPathParam:HasProperty( 'equipment' ) .And. ValType( jPathParam[ 'equipment' ] ) == 'C' .And. !Empty( jPathParam[ 'equipment' ] ) .And.;
        jPathParam:HasProperty( 'service' ) .And. ValType( jPathParam[ 'service' ] ) == 'C' .And. !Empty( jPathParam[ 'service' ] ) .And.;
        jPathParam:HasProperty( 'seqrela' ) .And. ValType( jPathParam[ 'seqrela' ] ) == 'C' .And. !Empty( jPathParam[ 'seqrela' ] ) 

            aSerData := fSerialize( oRest, jPathParam[ 'equipment' ], jPathParam[ 'service' ], jPathParam[ 'seqrela' ] )

            // Se o array tiver apenas duas posições elas são código e mensagem e um erro aconteceu na serialização
            If Len( aSerData ) > 2

                aSerData := fMontaManut( aSerData, jPathParam[ 'equipment' ], jPathParam[ 'service' ], jPathParam[ 'seqrela' ] )

                aResponse := fExecAuto( aSerData, jPathParam[ 'service' ], 4 )

            Else

                aResponse := aSerData

            EndIf

        Else

            aResponse[1] := STR0001 // "O equipamento deve ser informado!"
            aResponse[2] := 400
            
        EndIf

        jRespJson['message'] := DecodeUTF8( aResponse[ 1 ] )

        If jRespJson['message'] == Nil
            jRespJson['message'] := aResponse[ 1 ]
        EndIf

        oRest:SetStatusCode( aResponse[ 2 ] )
        oRest:SetResponse( jRespJson )

	End Sequence
    
    ErrorBlock( bLastError )

return

//------------------------------------------------------------------------------
/*/{Protheus.doc} fSerialize
Responsável por serializar os dados recebidos da requisição para o formato
esperado pelo ExecAuto

@type Function

@author João Ricardo Santini Zandoná
@since 12/11/2025
@param, oRest, Objeto, Objeto de requisição REST
@param, cBem, Caractere, Código do bem

@return Nil  
/*/ 
//------------------------------------------------------------------------------
static function fSerialize( oRest, cBem, cServico, cSeqRela )

    Local oReq       := JsonObject():New()
    Local cReq       := oRest:getBodyRequest()
    Local aProps     := {}
    Local aPropsTar  := {}
    Local aPropsItem := {}
    Local aItem      := {}
    Local aTarefa    := {}
    Local aExec      := {}
    Local aTamSx3    := {}
    Local nService   := 0
    Local nTar       := 0
    Local nI         := 0
    Local nX         := 0
    Local nY         := 0
    Local nZ         := 0
    Local nPosTbl    := 0
    Local nST5       := 0

    Default cServico := ''
    Default cSeqRela := ''

    dbSelectArea( 'ST9' )
    dbSetOrder( 1 ) // T9_FILIAL + T9_CODBEM
    If msSeek( FWxFilial( 'ST9' ) + cBem )

        aAdd( aExec, oReq:FromJson( cReq ) )

        If !Empty( aExec[ 1 ] )


            aExec[ 1 ] := STR0002 // "Corpo da requisição inválido."
            aAdd( aExec, 400 )
            
        Else
            
            // Array que vai pro MNTA120 tem o tamanho setado
            aExec := { {}, {}, {}, {}, {} }

            aProps := oReq:GetNames()

            aAdd( aExec[ 1 ], { 'TF_CODBEM', PadR( cBem, FwTamSX3( 'TF_CODBEM' )[ 1 ] ), Nil } )
            
            If !Empty( cServico )

                aAdd( aExec[ 1 ], { 'TF_SERVICO', PadR( cServico, FwTamSX3( 'TF_SERVICO' )[ 1 ] ), Nil } )

            EndIf

            If !Empty( cSeqRela )

                aAdd( aExec[ 1 ], { 'TF_SEQRELA', PadR( cSeqRela, FwTamSX3( 'TF_SEQRELA' )[ 1 ] ), Nil } )

            EndIf

            // Um loop para campos da STF e um para as Tarefas garante que os dados sejam gravados corretamente independente da ordem do JSON
            For nI := 1 To Len( aProps )

                // Se for array indica que é um campo da STF
                If ValType( oReq[ aProps[ nI ] ] ) <> 'A'

                    aTamSx3 := FwTamSX3( Upper( aProps[ nI ] ) )

                    // Garante que o campo pertence a STF
                    If At( 'TF_', Upper( aProps[ nI ] ) ) > 0 .And. Len( aTamSx3 ) > 0 .And. aScan( aExec[ 1 ], { |x| Upper( x[ 1 ] ) == Upper( aProps[ nI ] ) } ) == 0
                        
                        If aTamSx3[ 3 ] == 'C'

                            aAdd( aExec[1], { Upper( aProps[ nI ] ), PadR( oReq[ aProps[ nI ] ], aTamSx3[ 1 ] ), Nil } )

                        ElseIf aTamSx3[ 3 ] == 'D'

                            aAdd( aExec[1], { Upper( aProps[ nI ] ), STOD( oReq[ aProps[ nI ] ] ), Nil } )

                        Else

                            aAdd( aExec[1], { Upper( aProps[ nI ] ), oReq[ aProps[ nI ] ], Nil } )
                        
                        EndIf

                    EndIf

                EndIf

            Next nI

            // Tipo de acompanhamento padrão
            If aScan( aExec[ 1 ], { | x | x[ 1 ] == 'TF_TIPACOM' } ) == 0

                 aAdd( aExec[ 1 ], { 'TF_TIPACOM', PadR( 'T', FwTamSX3( 'TF_TIPACOM' )[ 1 ] ), Nil } )

            EndIf

            // Unidade de tempo padrão
            If aScan( aExec[ 1 ], { | x | x[ 1 ] == 'TF_UNENMAN' } ) == 0 .And. aExec[ 1, aScan( aExec[ 1 ], { | x | x[ 1 ] == 'TF_TIPACOM' } ), 2 ] == 'T'

                 aAdd( aExec[ 1 ], { 'TF_UNENMAN', PadR( 'D', FwTamSX3( 'TF_UNENMAN' )[ 1 ] ), Nil } )

            EndIf

            // Garante que o serviço foi informado
            nService := aScan( aExec[ 1 ], { | x | x[ 1 ] == 'TF_SERVICO' } )

            If nService > 0

                nST5 := aScan( aProps, { | x | Upper( x ) == 'ST5' } )

                If nST5 > 0 .And. ValType( oReq[ aProps[ nST5 ] ] ) == 'A'

                    If Upper( aProps[ nST5 ] ) == 'ST5'

                        For nI := 1 To Len( oReq[ aProps[ nST5 ] ] )
                            
                            If ValType( oReq[ aProps[ nST5 ], nI ] ) == 'J'

                                aTarefa := {}

                                aPropsTar := oReq[ aProps[ nST5 ], nI ]:GetNames()

                                nTar := aScan( aPropsTar, { | x | Upper( x ) == 'T5_TAREFA' } )

                                aAdd( aTarefa, { 'T5_CODBEM', PadR( cBem, FwTamSx3( 'T5_CODBEM' )[ 1 ] ), Nil } )
                                aAdd( aTarefa, { 'T5_SERVICO', PadR( aExec[ 1, nService, 2 ], FwTamSx3( 'T5_SERVICO' )[ 1 ] ), Nil } )

                                For nX := 1 To Len( aPropsTar )

                                    // Dentro da tarefa podem ter campos ou registros
                                    If ValType( oReq[ aProps[ nST5 ], nI, aPropsTar[ nX ] ] ) == 'A'

                                        If Upper( aPropsTar[ nX ] ) == 'STM' .Or. Upper( aPropsTar[ nX ] ) == 'STG';
                                         .Or. Upper( aPropsTar[ nX ] ) == 'STH'

                                            Do Case 
                                                Case Upper( aPropsTar[ nX ] ) == 'STM'
                                                    nPosTbl := 3
                                                Case Upper( aPropsTar[ nX ] ) == 'STG'
                                                    nPosTbl := 4
                                                Case Upper( aPropsTar[ nX ] ) == 'STH'
                                                    nPosTbl := 5
                                            EndCase

                                            For nY := 1 To Len( oReq[ aProps[ nST5 ], nI, aPropsTar[ nX ] ] )

                                                If ValType( oReq[ aProps[ nST5 ], nI, aPropsTar[ nX ], nY ] ) == 'J'

                                                    aPropsItem := oReq[ aProps[ nST5 ], nI, aPropsTar[ nX ], nY ]:GetNames()

                                                    aItem := {}

                                                    Do Case 
                                                        Case nPosTbl == 3
                                                            aAdd( aItem, { 'TM_CODBEM', PadR( cBem, FwTamSX3( 'TM_CODBEM' )[1] ), Nil } )
                                                            aAdd( aItem, { 'TM_SERVICO', PadR( aExec[ 1, nService, 2 ], FwTamSX3( 'TM_SERVICO' )[1] ), Nil } )
                                                            aAdd( aItem, { 'TM_TAREFA', PadR( oReq[ aProps[ nST5 ], nI, aPropsTar[ nTar ] ], FwTamSX3( 'TM_TAREFA' )[1] ), Nil } )
                                                        Case nPosTbl == 4
                                                            aAdd( aItem, { 'TG_CODBEM', PadR( cBem, FwTamSX3( 'TG_CODBEM' )[1] ), Nil } )
                                                            aAdd( aItem, { 'TG_SERVICO', PadR( aExec[ 1, nService, 2 ], FwTamSX3( 'TG_SERVICO' )[1] ), Nil } )
                                                            aAdd( aItem, { 'TG_TAREFA', PadR( oReq[ aProps[ nST5 ], nI, aPropsTar[ nTar ] ], FwTamSX3( 'TG_TAREFA' )[1] ), Nil } )
                                                        Case nPosTbl == 5
                                                            aAdd( aItem, { 'TH_CODBEM', PadR( cBem, FwTamSX3( 'TH_CODBEM' )[1] ), Nil } )
                                                            aAdd( aItem, { 'TH_SERVICO', PadR( aExec[ 1, nService, 2 ], FwTamSX3( 'TH_SERVICO' )[1] ), Nil } )
                                                            aAdd( aItem, { 'TH_TAREFA', PadR( oReq[ aProps[ nST5 ], nI, aPropsTar[ nTar ] ], FwTamSX3( 'TH_TAREFA' )[1] ), Nil } )
                                                    EndCase


                                                    For nZ := 1 To Len( aPropsItem )

                                                        aTamSx3 := FwTamSX3( Upper( aPropsItem[ nZ ] ) )

                                                        If (At( 'TM_', Upper( aPropsItem[ nZ ] ) ) > 0 .Or. At( 'TG_', Upper( aPropsItem[ nZ ] ) ) > 0 .Or. At( 'TH_', Upper( aPropsItem[ nZ ] ) ) > 0) .And. Len( aTamSx3 ) > 0

                                                            If aTamSx3[ 3 ] == 'C'

                                                                aAdd( aItem, { Upper( aPropsItem[ nZ ] ), PadR( oReq[ aProps[ nST5 ], nI, aPropsTar[ nX ], nY, aPropsItem[ nZ ] ], aTamSx3[1] ), Nil } )

                                                            ElseIf aTamSx3[ 3 ] == 'D'

                                                                aAdd( aItem, { Upper( aPropsItem[ nZ ] ), STOD( oReq[ aProps[ nST5 ], nI, aPropsTar[ nX ], nY, aPropsItem[ nZ ] ] ), Nil } )

                                                            Else

                                                                aAdd( aItem, { Upper( aPropsItem[ nZ ] ), oReq[ aProps[ nST5 ], nI, aPropsTar[ nX ], nY, aPropsItem[ nZ ] ], Nil } )

                                                            EndIf

                                                        Else

                                                            If Upper( aPropsItem[ nZ ] ) == 'DELETE'

                                                                If (ValType( oReq[ aProps[ nST5 ], nI, aPropsTar[ nX ], nY, aPropsItem[ nZ ] ] ) == 'L' .And. oReq[ aProps[ nST5 ], nI, aPropsTar[ nX ], nY, aPropsItem[ nZ ] ]);
                                                                .Or. (ValType( oReq[ aProps[ nST5 ], nI, aPropsTar[ nX ], nY, aPropsItem[ nZ ] ] ) == 'C' .And. oReq[ aProps[ nST5 ], nI, aPropsTar[ nX ], nY, aPropsItem[ nZ ] ] == 'S')
                                                                    
                                                                    aAdd( aItem, { 'AUTDELETA', 'S', Nil } )

                                                                EndIf

                                                            ElseIf Upper( aPropsItem[ nZ ] ) == 'RECNO'

                                                                aAdd( aItem, { Upper( SubStr( aPropsTar[ nX ], 2, 2 ) ) + '_ALI_WT', Upper( aPropsTar[ nX ] ), Nil } )
                                                                aAdd( aItem, { Upper( SubStr( aPropsTar[ nX ], 2, 2 ) ) + '_REC_WT', oReq[ aProps[ nST5 ], nI, aPropsTar[ nX ], nY, aPropsItem[ nZ ] ], Nil } )

                                                            EndIf

                                                        EndIf

                                                    Next nZ

                                                    If Len( aItem ) > 2

                                                        aAdd( aExec[ nPosTbl ], aItem )
                                                    
                                                    EndIf

                                                EndIf

                                            Next nY

                                        EndIf

                                    Else

                                        aTamSx3 := FwTamSX3( Upper( aPropsTar[ nX ] ) )

                                        If (At( 'T5_', Upper( aPropsTar[ nX ] ) ) > 0) .And. Len( aTamSx3 ) > 0

                                            If aTamSx3[ 3 ] == 'C'

                                                aAdd( aTarefa, { Upper( aPropsTar[ nX ] ), PadR( oReq[ aProps[ nST5 ], nI, aPropsTar[ nX ] ], aTamSx3[1] ), Nil } )

                                            ElseIf aTamSx3[ 3 ] == 'D'

                                                aAdd( aTarefa, { Upper( aPropsTar[ nX ] ), STOD( oReq[ aProps[ nST5 ], nI, aPropsTar[ nX ] ] ), Nil } )

                                            Else

                                                aAdd( aTarefa, { Upper( aPropsTar[ nX ] ), oReq[ aProps[ nST5 ], nI, aPropsTar[ nX ] ], Nil } )

                                            EndIf

                                        Else

                                            If Upper( aPropsTar[ nX ] ) == 'DELETE'

                                                If (ValType( oReq[ aProps[ nST5 ], nI, aPropsTar[ nX ] ] ) == 'L' .And. oReq[ aProps[ nST5 ], nI, aPropsTar[ nX ] ]);
                                                .Or. (ValType( oReq[ aProps[ nST5 ], nI, aPropsTar[ nX ] ] ) == 'C' .And. oReq[ aProps[ nST5 ], nI, aPropsTar[ nX ] ] == 'S')
                                                    
                                                    aAdd( aTarefa, { 'AUTDELETA', 'S', Nil } )

                                                EndIf

                                            ElseIf Upper( aPropsTar[ nX ] ) == 'RECNO'

                                                aAdd( aTarefa, { 'T5_ALI_WT', 'ST5', Nil } )
                                                aAdd( aTarefa, { 'T5_REC_WT', oReq[ aProps[ nST5 ], nI, aPropsTar[ nX ] ], Nil } )

                                            EndIf

                                        EndIf

                                    EndIf

                                Next nX

                                aAdd( aExec[2], aTarefa )

                            EndIf

                        Next nI

                    EndIf

                EndIf

            Else

                aExec := { STR0003, 400 } // "O campo TF_SERVICO é obrigatório."

            EndIf

        EndIf
    
    Else

        aAdd( aExec, STR0006 ) // Equipamento informado inexistente!
        aAdd( aExec, 400 )

    EndIf

return aExec

//------------------------------------------------------------------------------
/*/{Protheus.doc} fExecAuto
Realize a Execução do ExecAuto do MNTA120

@type Function

@author João Ricardo Santini Zandoná
@since 12/11/2025
@param, aDados, Array, Dados da manutenção
@param, cServico, caractere, Serviço da manutenção na I21
@param, nOp, Numerico, Operação que deve ser realizada

@return array, array contendo o código HTTP do retorno e a mensagem  
/*/ 
//------------------------------------------------------------------------------
static function fExecAuto( aDados, cServico, nOp )

    Local aResponse := { STR0004, 200 } // "Manutenção cadastrada com sucesso!"

    Default nOp := 3

    lMSHelpAuto := .T. // Impede que mostre as mensagens na Tela

    lMSErroAuto := .F.

    // Executa o MNTA120 via ExecAuto
    MSExecAuto( { | v, x, y | MNTA120( v, x, y ) }, , aDados, nOp )
 
    If lMsErroAuto
 
        aResponse[1] := MostraErro( GetSrvProfString( 'Startpath', '' ), 'API-MNTA120EXEC_' + DTOS( DATE() ) + '_' + ;
                      Left( Time(), 2 ) + SubStr( Time(), 4, 2 ) + '.LOG' )
        aResponse[2] := 500

    Else

        If !fSetCompletedStatus( aDados, cServico )

            aResponse := { STR0005, 200 } // "Manutenção cadastrada porém não foi possível realizar a alteração na I21!"

        EndIf

    EndIf

return aResponse

//------------------------------------------------------------------------------
/*/{Protheus.doc} fSetCompletedStatus
Realize a altereação do status do registro na I21

@type Function

@author João Ricardo Santini Zandoná
@since 12/11/2025
@param, aDados, Array, Dados da manutenção
@param, cServico, caractere, Serviço da manutenção na I21

@return logica, indica se foi possível alterar o registro da I21
/*/ 
//------------------------------------------------------------------------------
static function fSetCompletedStatus( aDados, cServico )

    Local oPaylod   := JsonObject():New()
    Local cQuery    := ''
    Local cAliasQry := ''
    Local nI        := 1
    Local lRet      := .F.
    Local cBem      := aDados[ 1, aScan( aDados[1], { |x| x[1] == 'TF_CODBEM'  } ), 2 ]

    cAliasQry := GetNextAlias()

    cQuery := 'SELECT '
    cQuery +=   'I21.R_E_C_N_O_ AS REC '
    cQuery += 'FROM ' + RetSqlName( 'I21' ) + ' I21 '
    cQuery += 'WHERE '
    cQuery +=   'I21.I21_KEY = ' + ValToSQL( cEmpAnt + '|' + AllTrim( FWxFilial( 'ST9' ) ) + '|' + cBem ) + ' '
    cQuery +=   "AND I21.I21_INSIGT = 'SuggestPreventives' "
    cQuery +=   "AND I21.D_E_L_E_T_ = ' ' "
    cQuery += 'ORDER BY I21.I21_DTPROC DESC '

    cQuery := ChangeQuery( cQuery )

    dbUseArea( .T.,'TOPCONN',TcGenQry( , , cQuery ), cAliasQry, .T., .T. )

    dbSelectArea( cAliasQry )
    dbGoTop()
    If (cAliasQry)->( !Eof() )

        dbSelectArea( 'I21' )
        dbGoTo( (cAliasQry)->REC )

        oPaylod:FromJson( StrTran( SubStr( I21->I21_PAYLOD, 2, ( Len( I21->I21_PAYLOD ) - 2 ) ), '\','' ) )

        If len( oPaylod ) > 0

            For nI := 1 To Len( oPaylod )

                If AllTrim( oPaylod[ nI, 'service' ] ) == AllTrim( cServico )

                    oPaylod[ nI, 'status' ] := 'completed'

                    Exit

                EndIf

            Next nI

            RecLock( 'I21', .F. )
            I21_PAYLOD := '[' + oPaylod:ToJSON() + ']'
            I21->( MsUnLock() )
            lRet := .T.

        EndIf

    EndIf

return lRet

//------------------------------------------------------------------------------
/*/{Protheus.doc} fMontaManut
Realize o carregamento de registros não enviados nos folders

@type Function

@author João Ricardo Santini Zandoná
@since 24/11/2025
@param, aDados, Array, Dados da manutenção
@param, cBem, caractere, Código do Bem
@param, cServico, caractere, Código do Serviço
@param, cSeqRela, caractere, SeqRela da Manutenção

@return array, retorna um array na mesma estrutura do aDados porém também com os dados não enviados na API
/*/ 
//------------------------------------------------------------------------------
static function fMontaManut( aDados, cBem, cServico, cSeqRela )

    Local aManut := {}
    Local cAliasQry := ''
    Local cQuery    := ''
    Local nX        := 0
    Local nI        := 0
    Local aReg      := 0
    Local nLenArr   := 0
    Local nPosRec   := 0
    Local cRecnoWh  := ''
    Local aFields   := {}
    Local aTabela   := {{ 2, 'ST5', 'ST5.T5_', 'T5_TAREFA' }, { 3, 'STM', 'STM.TM_', 'TM_DEPENDE' },;
                        { 4, 'STG', 'STG.TG_', 'TG_CODIGO' }, { 5, 'STH', 'STH.TH_', 'TH_ETAPA' }}

    aManut := aDados

    // Executa o processo para todos os Folders da rotina
    For nX := 1 To Len( aTabela )

        // Deve carregar apenas quando ao menos um registro do Folder for alterado
        If !Empty( aDados[ aTabela[ nX, 1 ] ] ) .And. Len( aDados[ aTabela[ nX, 1 ] ] ) > 0

            nLenArr := Len( aDados[ aTabela[ nX, 1 ] ] )
            cRecnoWh  := ''

            cAliasQry := GetNextAlias()
            cQuery := 'SELECT '
            cQuery +=   'R_E_C_N_O_ AS REC '
            cQuery += 'FROM ' + RetSQLName( aTabela[ nX, 2 ] ) + ' ' + aTabela[ nX, 2 ] +' '
            cQuery += 'WHERE '
            cQuery += aTabela[ nX, 3 ] + 'CODBEM = ' + ValToSQL( cBem ) + ' '
            cQuery += 'AND ' + aTabela[ nX, 3 ] + 'SERVICO = ' + ValToSQL( cServico ) + ' '
            cQuery += 'AND ' + aTabela[ nX, 3 ] + 'SEQRELA = ' + ValToSQL( cSeqRela ) + ' '

            // Tira registros que foram informados pelo usuário
            For nI := 1 To nLenArr

                nPosRec := aScan( aDados[ aTabela[ nX, 1 ], nI ], { |x| x[ 1 ] == SubStr( aTabela[ nX, 3 ], At( '.', aTabela[ nX, 3 ] ) + 1, 3 ) + 'REC_WT' } )

                If nPosRec > 0

                    If Empty( cRecnoWh )

                        cRecnoWh := 'AND ' + aTabela[ nX, 2 ] + '.R_E_C_N_O_ NOT IN ('
                    
                    EndIf
                    
                    cRecnoWh += cValToChar( aDados[ aTabela[ nX, 1 ], nI, nPosRec, 2 ] ) + ','

                EndIf

            Next nI

            // Retirando a última virgula
            If Substr(cRecnoWh, Len( cRecnoWh ), 1) == ','
                
                cRecnoWh := SubStr( cRecnoWh, 1, Len( cRecnoWh ) - 1 ) 
            
            EndIf

            If !Empty( cRecnoWh )

                cRecnoWh += ') '
                cQuery += ' ' + cRecnoWh
            
            EndIf

            cQuery +=   'AND ' + aTabela[ nX, 2 ] + ".D_E_L_E_T_ = ' ' "

            cQuery := ChangeQuery( cQuery )

            dbUseArea( .T., 'TOPCONN', TCGENQRY( , , cQuery ), cAliasQry, .F., .T. )

            While (cAliasQry)->( !Eof() )

                DbSelectArea( aTabela[ nX, 2 ] )
                DbGoTo( (cAliasQry)->REC )

                aFields := &(aTabela[ nX, 2 ])->( DBStruct() )

                aReg := {}

                // Preenche todos os campos com os valores do banco
                For nI := 1 To Len( aFields )

                    If ValType( &(aTabela[ nX, 2 ] + '->'+aFields[ nI, 1 ]) ) <> 'U' .And. !Empty( &(aTabela[ nX, 2 ] + '->'+aFields[ nI, 1 ]) )

                        aAdd( aReg, { aFields[ nI, 1 ], &(aTabela[ nX, 2 ] + '->'+aFields[ nI, 1 ]), Nil } )

                    EndIf

                Next nI

                aAdd( aManut[aTabela[ nX, 1 ]], aReg )

                (cAliasQry)->(dbSkip())

            End

            (cAliasQry)->(dbCloseArea())

        EndIf

    Next nX

return aManut
