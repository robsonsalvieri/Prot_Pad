#include "tlpp-core.th"
#include "totvs.ch"
#INCLUDE "FWMVCDEF.CH"

//static lDebug := .T.

/*/{Protheus.doc} OFSoBank
	Classe com os dados de Bancos (Bank) para comunicação com o Blackbird

	@type function
	@author Rubens Takahashi
	@since 10/01/2022
/*/
class OFSoBank from VERegistroSql
	Public Method New()
	Public Method ToJsonApi()
	Public Method ToJson()
	Public Method GetRefId()
	Public Method Fill()
	Public Method FindByRecnoDel()
	Public Method DocVersion()
	//Private Method checkForeignKey()
end class


/*/{Protheus.doc} New 
	Construtor basico

	@type function
	@author Rubens Takahashi
	@since 13/01/2022
/*/
method New() class OFSoBank
	_Super:New('VKA')

	::AddFields({"R_E_C_N_O_", "VKA_REFID", "VKA_CODIGO","VKA_NOME","VKA_DESCRI" })

	::SetPKField("VKA_REFID")

	//if lDebug
	//	Conout(" ")
	//	Conout( "OFSoBank:NEW " + Str(Procline(1),5) + " - " + ProcName(1) )
	//	Conout(" ")
	//endif

return self


/*/{Protheus.doc} FindByRecnoDel
	Busca pelo recno

	@type function
	@author Rubens Takahashi
	@since 13/01/2022
/*/
Method FindByRecnoDel(nRecno) Class OFSoBank
	self:Select();
		:_From(self:cAlias);
		:AndEq('R_E_C_N_O_', nRecno)

	// busca primeiro registro
	oReg := self:First()

	// limpa a query interna
	self:Clear()
Return oReg

/*/{Protheus.doc} GetRefId
	Retorna o reference id para usar no SO

	@type function
	@author Rubens Takahashi
	@since 13/01/2022
/*/
Method GetRefId() Class OFSoBank
Return self:Get("VKA_REFID")

/*/{Protheus.doc} ToJson
	retorna um json object

	@type method
	@author Rubens Takahashi
	@since 02/07/2021
/*/
Method ToJson(cOperation) Class OFSoBank
Return self:ToJsonApi(cOperation)

/*/{Protheus.doc} ToJsonApi
	Retorna um JSON para enviar a API

	@type function
	@author Rubens Takahashi
	@since 13/01/2022
/*/
Method ToJsonApi(cOperation) Class OFSoBank
	local jJson := JsonObject():New()
	local jJsonBank := JsonObject():New()

	jJsonBank["referenceId"] := FGX_SetVlJson("BK-" + self:get("VKA_REFID") )
	if cOperation == 'added' .or. cOperation == 'modified'
		jJsonBank["name"]        := FGX_SetVlJson( self:get("VKA_NOME") )
		jJsonBank["description"] := FGX_SetVlJson( self:get("VKA_DESCRI") )
	endif
	jJson[cOperation] := {}
	aadd( jJson[cOperation] , jJsonBank )

	//if lDebug
	//	
	//	Conout( "-----------------------------------------------------------------------")
	//	// Conout( "OFSoBank toJsonApi " + Str(Procline(1),5) + " - " + ProcName(1))
	//
	//	nCont := 2
	//	While !Empty(ProcName(nCont))
	//		// Conout( "                       " + Str(Procline(nCont),5) + " - " + ProcName(nCont) )
	//		nCont++
	//	EndDo
	//	Conout( "-----------------------------------------------------------------------")
	//	Conout(" ")
	//
	//endif

Return jJson
