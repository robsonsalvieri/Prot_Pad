#DEFINE STR0001 "Parts cannot be trasnfer from the service order."


/*/{Protheus.doc} OFSworkOrderPartsTransferRequestedInFieldServiceInteractor
	Classe que vai tratar a criacao de modelos no field service
	
	@type class
	@author Iury Soares Azevedo
	@since 09/06/2025
/*/
Class OFSworkOrderPartsTransferRequestedInFieldServiceInteractor 
	public data OFSoWorkOrder as object

	Public Method New() CONSTRUCTOR
	Public Method Process()
EndClass

/*/{Protheus.doc} New
	Construtor Simples

	@type method
	@author Iury Soares Azevedo
	@since 09/06/2025
/*/
Method New() Class OFSworkOrderPartsTransferRequestedInFieldServiceInteractor
	self:OFSoWorkOrder := OFSoWorkOrder():New()
Return SELF

/*/{Protheus.doc} Process
	processa a criacao
	@type method
	@author Iury Soares Azevedo
	@since 09/06/2025
/*/
Method Process(jSoRequestBody) Class OFSworkOrderPartsTransferRequestedInFieldServiceInteractor
	local jRet as json
	
	jRet :=  OFSoRestErrorResponse():BadRequest("WorkOrderPartsTransferRequestedInFieldService", 0, STR0001, "")	// "Parts cannot be trasnfer from the service order."
	
return jRet

