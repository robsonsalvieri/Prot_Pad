/*/{Protheus.doc} OFScaniaClient
    Classe responsável pelas requisições HTTP na api SCOB de veículos da SCANIA
    @author Renan Migliaris
    @since 29/09/2025
    @version version
    /*/
Class OFScaniaClient
    
    public data jResult as json

    protected data cUrlBaseAuthApi as character
    protected data cAuthPath as character
    protected data cClientId as character
    protected data cSecret as character
    protected data cGrantType as character
    protected data oDmsRequestLogger as object
    protected data cScope as character

    private data cUrlBaseRequests as character
    private data cEndPoint as character
    private data jTokenResponse as json
    private data aGetParams as array
    private data oJsonReq as json
    private data lTokenSuccess as logical

    public method new() as object
    public method setUrlBaseAuthApi(cUrlBaseAuthApi, cAuthPath) as object
    public method setUrlBaseRequests(cUrlBaseRequests) as object
    public method setEndPoint(cEndPoint) as object
    public method setClientId(cClientId) as object
    public method setSecret(cSecret) as object
    public method setGetParams(aParams) as object
    public method getEndpointResult(cVerb) as json
    public method setOriginAsScob() as object
    public method setOriginAsArms() as Object 
    public method setTypeAsScob() as object
    public method setTypeAsArms() as object
    public method setGrantType() as object
    public method setScope(cScope) as object

    protected method _getToken() as logical

    private method _paramsHandler() as character
    private method _setVk5Log() as logical
    private method _setJsonLog() as logical
    private method _setTokenSuccess(lSuccess) as logical
EndClass

/*/{Protheus.doc} new
    Método construtor da classe
    @author Renan Migliaris
    @since 29/09/2025
    @version version
    /*/
Method new() class OFScaniaClient
    self:oDmsRequestLogger := OFDMSRequest():new()
    self:jResult := JsonObject():new()
    self:jTokenResponse := JsonObject():new()
    self:oJsonReq := JsonObject():new()
Return self

