/*/{Protheus.doc} _getToken
    Recupera o token de autenticação na Api
    @author Renan Migliaris
    @since 29/09/2025
    /*/
Method _getToken() class OFScaniaClient
    local lRet := .t.
    local oRest := FwRest():new(self:cUrlBaseAuthApi)
    local aHeader := {}
    local cBody := ''
    local cAuth := ''
    local cUserSecretBase64 := ''
    local lSuccess := .f.

    cAuth := self:cClientId + ":"  + self:cSecret
    cUserSecretBase64 := Encode64(cAuth)

    aadd(aHeader, "Authorization: Basic " + cUserSecretBase64) //TODO authorization também não poderá ser chumbado - lógica para trocar de acordo com o que foi configurado na VRN
    aadd(aHeader, "Content-Type: application/x-www-form-urlencoded") //TODO content-type também não poderá ser chumbado
       
    cBody := "grant_type="+Lower(self:cGrantType)

    if !Empty(self:cScope)
        cBody += "&scope=" +Lower(self:cScope)
    endif

    oRest:setPath(self:cAuthPath)
    oRest:SetPostParams(cBody)
    lSuccess := oRest:post(aHeader)
    self:_setTokenSuccess(lSuccess)
    if lSuccess
        self:jTokenResponse:FromJson(oRest:getResult())
        lRet := .t.
    else
        self:jTokenResponse["error"] := oRest:getLastError()
        lRet := .f.
    endIf
    
    self:jTokenResponse["status_code_res"] := oRest:getHttpCode()
    self:_setJsonLog(aHeader, cBody)
    self:_setVk5Log(.t.)
    freeObj(oRest)
Return lRet

/*/{Protheus.doc} _paramsHandler
    Aqui eu monto os params dos gets que serão enviados para os requests
    Vou receber um par {{param, valor}, {param2, valor2}} 
    A partir desse par eu monto a string 
    @author renan migliaris
    @since 30/09/2025
    /*/
Method _paramsHandler() class OFScaniaClient
    local cParams := ""
    local aParam  := {}
    local nI      := 0

    if Len(self:aGetParams) > 0
        for nI := 1 to Len(self:aGetParams)
            aParam := self:aGetParams[nI]

            if Empty(cParams)
                cParams := "?" + AllTrim(aParam[1]) + "=" + AllTrim(aParam[2])
            else
                cParams += "&" + AllTrim(aParam[1]) + "=" + AllTrim(aParam[2])
            endif
        next
    endif

Return cParams

Method _setTokenSuccess(lSuccess) class OFScaniaClient
    self:lTokenSuccess := lSuccess
Return self:lTokenSuccess

/*/{Protheus.doc} getEndpointResult
    Retorna o resultado do endpoint que foi solicitado pelo client 
    @author Renan Migliaris
    @since 29/09/2025
    /*/

Method getEndpointResult(cVerb) class OFScaniaClient
    local oRest := FwRest():new(self:cUrlBaseRequests)
    local aHeader := {}
    local cToken := ''
    local lOk := .t.
    local cAuth := " " 
    local cContentType := "Content-Type: application/json" 
    
    if self:_getToken()
        cVerb := upper(alltrim(cVerb))
        cToken := self:jTokenResponse["access_token"]
        cAuth := "Authorization: Bearer " + cToken
        aadd(aHeader, cAuth)
        aadd(aHeader, cContentType)


        Do Case
        
            Case cVerb == "POST"
                oRest:setPath(self:cEndPoint + self:_paramsHandler())
                lOk := oRest:post(aHeader, '') //TODO POST sem body (verificar se vai aceitar vazio)
            
            Case cVerb == "GET"
                oRest:setPath(self:cEndPoint + self:_paramsHandler())
                lOk := oRest:get(aHeader)       
        
        EndCase

        if lOk
            self:jResult:FromJson(DeCodeUTF8(oRest:getResult()))
        else
            self:jResult["erro"] := oRest:getLastError()
        endif

        self:jResult["status_code_res"] := oRest:getHttpCode()

        self:_setJsonLog(aHeader)
        self:_setVk5Log()
    endIf

    if !self:lTokenSuccess
        self:jResult := self:jTokenResponse
    endif
    freeObj(oRest)
Return self:jResult

/*/{Protheus.doc} _setVk5Log
    Método que vai logar na VK5 dependendo do tipo de retorno que eu tiver na api 
    @author Renan Migliaris
    @since 01/10/2025
    /*/
Method _setVk5Log(lToken) class OFScaniaClient
    local lOk := .t.
    default lToken := .f.
    self:oDmsRequestLogger:set("VK5_ORIKEY", FunName())
    self:oDmsRequestLogger:set("VK5_REQHEA", self:oJsonReq["header_req"])
    self:oDmsRequestLogger:set("VK5_REQBOD", self:oJsonReq["body_req"])
    if !lToken
        self:oDmsRequestLogger:set("VK5_RESBOD", self:jResult:toJson())
        self:oDmsRequestLogger:set("VK5_RESCOD", val(self:jResult["status_code_res"]))
    else
        self:oDmsRequestLogger:set("VK5_RESBOD", self:jTokenResponse:toJson())
        self:oDmsRequestLogger:set("VK5_RESCOD", val(self:jTokenResponse["status_code_res"]))
    endif
    self:oDmsRequestLogger:save()
Return lOK

/*/{Protheus.doc} _setJsonLog
    Monta o json para ser utilizado no _setVk5Log
    @author Renan Migliaris
    @since 01/10/2025
    /*/
method _setJsonLog(aHeader, cBody) class OFScaniaClient
    local lRet := .t.
    local nx := 0 
    local oHeader := JsonObject():new()
    default aHeader := {""}
    default cBody := ''

    for nx := 1 to len(aHeader)
        oHeader["header" + cValToChar(nx)] := aHeader[nx]
    next
    self:oJsonReq["header_req"] := oHeader:toJson()
    self:oJsonReq["body_req"] := cBody

    freeObj(oHeader)
return lRet 
