#include 'totvs.ch'
#Include "FWMVCDEF.CH"
//#include "OFSOPARTSSEARCHSERVICEINTERACTOR.CH"

#DEFINE STR0001 "Invalid body data, please check pageSize/pageNumber"


/*/{Protheus.doc} OFSoPartsSearchInteractor
	Classe que vai tratar a criacao de modelos no field service
	
	@type class
	@author Vinicius Gati
	@since 29/09/2022
/*/
Class OFSoPartsSearchInteractor
	Public Method New() CONSTRUCTOR
	Public Method Process()
EndClass

/*/{Protheus.doc} New
	Construtor Simples

	@type method
	@author Vinicius Gati
	@since 29/09/2022
/*/
Method New() Class OFSoPartsSearchInteractor
Return SELF

/*/{Protheus.doc} Process
	processa a criacao
	@type method
	@author Vinicius Gati
	@since 29/09/2022
/*/
Method Process(jSoRequestBody) Class OFSoPartsSearchInteractor
	Local jBody 		:= jSoRequestBody:jBody
	Local cPartNumber 	:= ""
	Local npageSize 	:= jBody["data"]["paging"]["pageSize"]
	Local npageNumber 	:= jBody["data"]["paging"]["pageNumber"]

	Local jRet as json
	
	If !Empty(jBody["data"]["paging"]["pageSize"]) .AND. !Empty(jBody["data"]["paging"]["pageNumber"])
		cPartNumber 	:= ""
		cDescription	:= ""
		If jBody["data"]["criteria"]:HasProperty("partNumber")
			If !Empty(jBody["data"]["criteria"]["partNumber"])
				cPartNumber := jBody["data"]["criteria"]["partNumber"]
			EndIf
		EndIf
		If jBody["data"]["criteria"]:HasProperty("description")
			If !Empty(jBody["data"]["criteria"]["description"])
				cDescription := jBody["data"]["criteria"]["description"]
			EndIf
		EndIf
		npageSize 	:= jBody["data"]["paging"]["pageSize"]
		npageNumber := jBody["data"]["paging"]["pageNumber"]

		jRet := OFSoResponseBody():New(200, jSoRequestBody, GetJson(npageSize,npageNumber,cPartNumber,cDescription))

	Else
		jRet := OFSoRestErrorResponse():BadRequest("PartsSearch", 0, STR0001, "")	//"Invalid body data, please check pageSize/pageNumber"
	EndIf

	
Return jRet



/*/{Protheus.doc} GetJson
	Efetua a construcao do json de retorno
	@type Function
	@author Marcos Vieira
	@since 10/06/2025
/*/
Static Function GetJson(npageSize,npageNumber,cPartNumber,cDescription)
	Local jData := JsonObject():New() as json
	local lTemMaisPaginas

	jData["parts"] := GetParts(npageSize,npageNumber,cPartNumber,cDescription, @lTemMaisPaginas)
	jData["hasMoreRecords"] := lTemMaisPaginas
	
Return jData



/*/{Protheus.doc} GetParts
	Busca os itens relacionados
	@type method
	@author Marcos Vieira
	@since 10/06/2025
/*/
Static Function GetParts(npageSize,npageNumber,cPartNumber,cDescription, lTemMaisPaginas)
	Local aRet := {} as array
	Local jItem as json
	local nOffSet
	local nContReg := 0

	Local cWhere := ""

	Pergunte("MTA260",.F.)
	
	nOffSet := (npageNumber - 1) * npageSize
	npageSize += 1 // Soma 1 para verificar se tem mais registros

	If !Empty(cPartNumber)
		cWhere += " AND SB1.B1_COD LIKE '%"+Upper(AllTrim(cPartNumber))+"%' "
	EndIf

	If !Empty(cDescription)
		cWhere += " AND SB1.B1_DESC LIKE '%"+Upper(AllTrim(cDescription))+"%' "
	EndIF
	cWhere += " AND SB1.B1_GRUPO <> '" + Alltrim(GetMv("MV_GRUVEI")) + "' "

	if SB1->(FieldPos("B1_MSBLQL") > 0)
		cWhere += " AND SB1.B1_MSBLQL IN (' ','2') "
	endif

	cWhere := '%'+cWhere+'%'

	Conout(" __   ___ ___  __        __  ___  __  ")
	Conout("/ _` |__   |  |__)  /\  |__)  |  /__` ")
	Conout("\__> |___  |  |    /~~\ |  \  |  .__/ ")
	Conout("                                      ")
	Conout(cWhere)
	Conout("                                      ")

//			SB1.B1_GRUPO, SB1.B1_CODITE, SB1.B1_DESC, SB1.B1_LOCPAD, SB1.B1_PRV1, SB2.R_E_C_N_O_ B2RECNO

	BeginSql Alias 'TMPSB1'

		SELECT 
			SB1.R_E_C_N_O_ B1RECNO, SB2.R_E_C_N_O_ B2RECNO
		FROM 
			%Table:SB1% SB1
			LEFT JOIN %Table:SB2% SB2 ON SB2.B2_FILIAL = %xfilial:SB2% AND SB2.B2_COD = SB1.B1_COD AND SB2.B2_LOCAL = SB1.B1_LOCPAD AND SB2.%NotDel%
		WHERE
			SB1.%NotDel%
			AND SB1.B1_FILIAL = %xfilial:SB1%
			%Exp:cWhere%
		ORDER BY 
			SB1.B1_CODITE
		OFFSET %exp:nOffSet% ROWS FETCH NEXT %exp:npageSize% ROWS ONLY

	EndSql

	npageSize -= 1 // Retira o +1 que foi adicionado

	VPD->(dbSelectArea("VPD"))
	VPD->(dbSetOrder(1))
	
	VB1->(dbSelectArea("VB1"))
	VB1->(dbSetOrder(2))
	
	VE9->(dbSelectArea("VE9"))
	VE9->(dbSetOrder(3))

	While !TMPSB1->(Eof())
		++nContReg
		if nContReg > npageSize
			Exit
		endif

		jItem := PartsJson()

		aadd(aRet,jItem)
		TMPSB1->(DbSkip())
	EndDo
	TMPSB1->(DbCloseArea())

	lTemMaisPaginas := (nContReg > npageSize)

Return aRet




/*/{Protheus.doc} PartsJson
	Converte o projeto para json
	@type Function
	@author Marcos Vieira
	@since 11/06/2025
/*/
Static Function PartsJson()
	Local jRet := JsonObject():New() as json
	Local nSaldo := 0
	Local oFSoFranchise := OFSoFranchise():New() as object
	Local oLocation := OFSoLocation():New(cEmpAnt, cFilAnt)

	SB1->(dbGoTo(TMPSB1->B1RECNO))

	ConOut("Part Number: " + Alltrim(SB1->B1_CODITE) + " - " + Alltrim(SB1->B1_DESC) )

	if TMPSB1->B2RECNO > 0
		SB2->(dbGoTo(TMPSB1->B2RECNO))
		ConOut( "    Estoque: " + SB2->B2_COD + " - Local: " + Alltrim(SB2->B2_LOCAL) )
		nSaldo := SaldoMov(nil, nil, nil, If(mv_par03 == 1, .F., Nil), nil, nil, nil, nil)
		Conout( "    Saldo..: " + cvaltochar(nSaldo) )
	endif

	// | Campo                  | Obrigatório | Tipo                             | Enum/Descrição                                                                    |
	// |------------------------|-------------|----------------------------------|-----------------------------------------------------------------------------------|
	// | partNumber             | Sim         | string <= 100 caracteres         | O número da peça.                                                                 |
	// | itemType               | Sim         | string                           | Enum: "Part", "NonQuantityPart" - O tipo do item, ex.: peça, peça sem quantidade. |
	// | partType               | Não         | string ou null <= 100 caracteres | Enum: "ExchangePart", "CorePart", "RegularPart" - O tipo da peça.                 |
	// | description            | Não         | string ou null <= 500 caracteres | A descrição da peça.                                                              |
	// | locationReferenceId    | Sim         | string <= 100 caracteres         | O ID único de referência da localização da peça.                                  |
	// | locationName           | Sim         | string <= 100 caracteres         | O nome da localização da peça.                                                    |
	// | franchiseReferenceId   | Não         | string ou null <= 100 caracteres | O ID único de referência da franquia da peça.                                     |
	// | franchiseName          | Não         | string ou null <= 100 caracteres | O nome da franquia da peça.                                                       |
	// | vendorReferenceId      | Não         | string ou null <= 100 caracteres | O ID único de referência do fornecedor da peça.                                   |
	// | vendorName             | Não         | string ou null <= 100 caracteres | O nome do fornecedor da peça.                                                     |
	// | binQuantity            | Não         | number ou null <decimal>         | A quantidade atual no compartimento da peça.                                      |
	// | sellPrice              | Não         | number ou null <decimal>         | O preço de venda da peça.                                                         |
	// | hasRelated             | Não         | boolean ou null                  | Indicador que especifica se a peça possui peças relacionadas.                     |
	// | hasAlternate           | Não         | boolean ou null                  | Indicador que especifica se a peça possui peças alternativas.                     |
	// | hasSubstitute          | Não         | boolean ou null                  | Indicador que especifica se a peça possui peças substitutas.                      |

	jRet["partNumber"]           := Alltrim(SB1->B1_CODITE)
	jRet["itemType"]             := "Part" // Part, NonQuantityPart
	jRet["partType"]             := "RegularPart" // RegularPart, ExchangePart, CorePart
	jRet["description"]          := Alltrim(SB1->B1_DESC)
	jRet["locationReferenceId"]  := oLocation:GetReferenceId()
	jRet["locationName"]         := oLocation:GetName()

	oFSoFranchise := oFSoFranchise:FindByGroup(SB1->B1_GRUPO)
	If !Empty(oFSoFranchise)
		jRet["franchiseReferenceId"] := "FR-" + oFSoFranchise:Get('VKB_REFID')
		jRet["franchiseName"] := oFSoFranchise:Get('VKB_NOME')
	EndIf

	//jRet["vendorReferenceId"]    := ""
	//jRet["vendorName"]           := ""
	jRet["binQuantity"]          := nSaldo
	jRet["sellPrice"]            := SB1->B1_PRV1
	jRet["hasRelated"]           := VPD->(MsSeek(xFilial("VPD")+SB1->B1_COD))
	jRet["hasAlternate"]         := VB1->(MsSeek(xFilial("VB1")+SB1->B1_COD))
	jRet["hasSubstitute"]        := VE9->(MsSeek(xFilial("VE9")+SB1->B1_COD))
	
Return jRet
