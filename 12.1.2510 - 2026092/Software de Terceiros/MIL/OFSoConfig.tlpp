#include 'totvs.ch'

/*/{Protheus.doc} OFSoConfig
	Classe de configurao da integrao com o Dynamics da John Deere
	
	@type function
	@author Rubens Takahashi
	@since 14/01/2020
/*/
Class OFSoConfig
	public Data cCodigo
	public Data oConfig
	public Data oArrHlp
	public Data cChaveS
	public Data cChaveP
	public Data cEndS
	public Data cEndP

	public Data aMappedFils
	Public Data aFilHabilitadas
	public Data aFilSA1Habilitadas
	data cSecret

	Public Method New() CONSTRUCTOR
	Public Method GetFiliais()
	Public Method FilialHabilitada()
	Public Method GetHabilitadas()
	Public Method Habilitado()
	Public Method EmpresaDaFilial()
	//Public Method GetSA1Habilitadas()
	Public Method ClienteFilialHabilitada()

	Public Method SaveConfig()
	Public Method GetConfig()
	Public Method GetTypeTime()

	Public Method GetSubscriptionKey()
	Public Method GetSoUrl()
	Public Method GetDealerId()
	Public Method isValid()
EndClass

/*/{Protheus.doc} New
	Construtor Simples

	@type function
	@author Rubens Takahashi
	@since 17/01/2020
/*/
Method New() Class OFSoConfig
	::cSecret := GetEnv("DMS_AUTH_SECRET")

	if empty(::cSecret)
		::cSecret := "DMSAUTHSECRET"
		conout("Varivel de ambiente DMS_AUTH_SECRET  obrigatria e no foi definida, seus dados esto em risco.")
	endif

	::cCodigo := "OFIA261"
	::oArrHlp := DMS_ArrayHelper():New()
	::cChaveS := GetNewPar("MV_MIL0195", "")
	::cChaveP := GetNewPar("MV_MIL0196", "")
	::cEndS   := GetNewPar("MV_MIL0197", "")
	::cEndP   := GetNewPar("MV_MIL0198", "")
	::aFilHabilitadas := {}
	::aFilSA1Habilitadas := {}
	::GetConfig()
Return SELF

/*/{Protheus.doc} SaveConfig
	Salva a configuracao no lugar da atual

	@type function
	@author Rubens Takahashi
	@since 17/01/2020
/*/
Method SaveConfig(jConfig) Class OFSoConfig
	local cJson := ""
	

	VRN->(dbSetOrder(1))
	if VRN->(dbSeek(xFilial("VRN") + self:cCodigo))
		If jConfig:hasProperty("SENHA1");
			.AND. !Empty(jConfig["SENHA1"])
			jConfig["SENHA1"] :=  rc4crypt(allTrim(jConfig['SENHA1']), ::cSecret, .T.)
		EndIf
		If jConfig:hasProperty("SENHA2");
			.AND. !Empty(jConfig["SENHA2"])
			jConfig["SENHA2"] := rc4crypt(allTrim(jConfig['SENHA2']), ::cSecret, .T.)
		EndIf

		cJson := jConfig:toJson()
		reclock("VRN", .F.)
		VRN->VRN_CONFIG := cJson
		VRN->(MsUnlock())
		self:oConfig := jConfig
	else
		return .f.
	endif
return .t.

/*/{Protheus.doc} GetDealerId
	Retorna o dealer Id da filial enviado por parametro

	@type method
	@author Vinicius Gati
	@since 12/08/2021
/*/
Method GetDealerId() Class OFSoConfig
Return self:oConfig["DEALERID"]

/*/{Protheus.doc} GetTypeTime
	Retorna o tipo de tempo de acordo jobCodeType
	Cliente: Retail 
	Interno: Internal 
	Garantia: Warranty 

	@type method
	@author Vinicius Gati
	@since 12/08/2021
/*/
Method GetTypeTime(cJobCodeType) Class OFSoConfig
	Local cRet := ""
	If cJobCodeType == "Retail"
		cRet := self:oConfig["TTCLIENTE"]
	ElseIf cJobCodeType == "Internal"
		cRet := self:oConfig["TTINTERNO"]
	ElseIf cJobCodeType == "Warranty"
		cRet := self:oConfig["TTGARANTIA"]
	EndIf
Return cRet

/*/{Protheus.doc} GetConfig
	Pega a configuracao em formato de data container

	@type function
	@author Rubens Takahashi
	@since 17/01/2020
/*/
Method GetConfig() Class OFSoConfig
	local oUtil   := Nil
	local oConfig := JsonObject():New()

	VRN->(dbSetOrder(1))
	if VRN->(dbSeek(xFilial("VRN") + self:cCodigo))
		oConfig:FromJson(VRN->VRN_CONFIG)

		Do Case
		Case oConfig["AMBIENTE"] == '1'
			oConfig["URL"] := self:cEndS
		Case oConfig["AMBIENTE"] == '2'
			oConfig["URL"] := self:cEndP
		EndCase

		if !oConfig:hasProperty("AUTENTIC")
			//propriedades adicionadas depois do ambiente configurado caso nao existirem devem ser inicializadas
			oConfig["AUTENTIC"] := "1"
			oConfig['SRVAUT1'] := Space(250)
			oConfig['SRVAUT2'] := Space(250)
			oConfig['USUARIO1'] := space(100)
			oConfig['USUARIO2'] := space(100)
			oConfig['SENHA1'] := space(100)
			oConfig['SENHA2'] := space(100)
			oConfig['ESCOPO1'] := space(100)
			oConfig['ESCOPO2'] := space(100)
		Else
    		If !Empty(oConfig['SENHA1'])
				oConfig['SENHA1'] := rc4crypt(allTrim(oConfig['SENHA1']), ::cSecret, .F., .T.)
			EndIf
    		If !Empty(oConfig['SENHA2'])
				oConfig['SENHA2'] := rc4crypt(allTrim(oConfig['SENHA2']), ::cSecret, .F., .T.)
			EndIf
		EndIf
		if !oConfig:hasProperty("TTCLIENTE")
			oConfig['TTCLIENTE'] := space(GetSx3Cache("VOI_TIPTEM", "X3_TAMANHO"))
			oConfig['TTINTERNO'] := space(GetSx3Cache("VOI_TIPTEM", "X3_TAMANHO"))
			oConfig['TTGARANTIA'] := space(GetSx3Cache("VOI_TIPTEM", "X3_TAMANHO"))
		endiF
	else
		oConfig["MATRIZID"] := ''
		oConfig["DEALERID"] := ''
		oConfig["AMBIENTE"] := '1'
		oConfig["URL"] := ''
		oConfig["FILIAIS"] := {}
		oConfig["VV2_CATVEI"] := ''
		oConfig["VV2_TIPVEI"] := ''
		oConfig["VV2_ESPVEI"] := ''
		oConfig["AUTENTIC"] := '1'
		oConfig['SRVAUT1'] := space(250)
		oConfig['SRVAUT2'] := space(250)
		oConfig['USUARIO1'] := space(100)
		oConfig['USUARIO2'] := space(100)
		oConfig['SENHA1'] := space(100)
		oConfig['SENHA2'] := space(100)
		oConfig['ESCOPO1'] := space(100)
		oConfig['ESCOPO2'] := space(100)
		oConfig['TTCLIENTE'] := space(GetSx3Cache("VOI_TIPTEM", "X3_TAMANHO"))
		oConfig['TTINTERNO'] := space(GetSx3Cache("VOI_TIPTEM", "X3_TAMANHO"))
		oConfig['TTGARANTIA'] := space(GetSx3Cache("VOI_TIPTEM", "X3_TAMANHO"))

		reclock("VRN", .T.)
		VRN->VRN_FILIAL := xFilial("VRN")
		VRN->VRN_CODIGO := self:cCodigo
		oUtil := oConfig:toJson()
		VRN->VRN_CONFIG := oUtil
		VRN->(MsUnlock())
	endif
	self:oConfig := oConfig
Return oConfig

/*/{Protheus.doc} GetFiliais
	Filiais que participam do Blackbird

	@type function
	@author Rubens Takahashi
	@since 14/01/2020
/*/
Method GetFiliais() Class OFSoConfig
	// Processar filiais
	if valtype(self:aMappedFils) == "U"
		self:aMappedFils := self:oArrHlp:Map(self:oConfig["FILIAIS"], {|oEl| oEl["FILIAL"] })
	endif
Return self:aMappedFils

/*/{Protheus.doc} Habilitado
	Verifica se o SO est habilitado no sistema

	@type method
	@author Vinicius Gati
	@since 28/07/2023
/*/
Method Habilitado() Class OFSoConfig
Return ! Empty(self:cChaveS)

/*/{Protheus.doc} FilialHabilitada
	Verifica se a filial do parametro est habilitada na configurao

	@type method
	@author Vinicius Gati
	@since 28/07/2023
/*/
Method FilialHabilitada(cFilAnt) Class OFSoConfig
Return ASCAN(self:oConfig["FILIAIS"], { |jFil| jFil["FILIAL"] == cFilAnt .and. jFil["HABILITADA"] == "1" }) > 0

/*/{Protheus.doc} EmpresaDaFilial
	Retorna a Empresa do registro da filial passada.

	@type method
	@author Mauro Yokota
	@since 16/08/2023
/*/
Method EmpresaDaFilial(cFilCode) Class OFSoConfig
	local aFilEmp 
	cFilCode := PADR(cFilCode, GetSx3Cache("VS3_FILIAL","X3_TAMANHO"))
	aFilEmp := self:oArrHlp:First(self:oConfig["FILIAIS"], {|oEl| oEl["FILIAL"] == cFilCode })
Return IIF(VALTYPE(aFilEmp) != "U", aFilEmp["EMPRESA"] , Nil)

/*/{Protheus.doc} GetHabilitadas
	Retorna as filiais habilitadas em array, o retorno  um array com os cdigos somente

	@type method
	@author Vinicius Gati
	@since 28/07/2023
/*/
Method GetHabilitadas() Class OFSoConfig
	if Len(self:aFilHabilitadas) == 0
		self:aFilHabilitadas := self:oArrHlp:Select(self:oConfig["FILIAIS"], {|oEl| oEl["HABILITADA"] == "1" })
	endif
Return self:aFilHabilitadas


