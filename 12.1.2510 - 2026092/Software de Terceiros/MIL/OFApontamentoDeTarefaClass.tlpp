/*/{Protheus.doc} pausaApontamento
    Pausa apontamentos selecionados

    @type method
    @author Bruno Forcato
    @since 01/07/2026
/*/
Method pausaApontamento(jRequest) Class OFApontamentoDeTarefaClass
Return _ProcessaEncerramento(jRequest, .t.)

Method apontarTarefa(jRequest) Class OFApontamentoDeTarefaClass
	local jRet := JsonObject():New()

	local cNumOS := AllTrim(jRequest['numosv'])
	local cCodTec := AllTrim(jRequest['codtec'])
	local cDataHora := AllTrim(jRequest['dataHora'])
	Local cMotPausa := ""
	local lPausaApontamento := .f.
	local lFinalizaApontamento := .f.
	local linicializaApontamento := .f.

	Local nI, nJ

	local dData := _ConverteData(cDataHora)
	local nHora := _ConverteHora(cDataHora)

	local aCabVO4 := {}
	local aIteVO4 := {}

	if jRequest:HasProperty("pausaApontamento")
		lPausaApontamento := jRequest['pausaApontamento']
		cMotPausa := jRequest['motivoPausa']
	EndIf

	if jRequest:HasProperty("finalizaApontamento")
		lFinalizaApontamento := jRequest['finalizaApontamento']
	EndIf

	if jRequest:HasProperty("inicializaApontamento")
		linicializaApontamento := jRequest['inicializaApontamento']
	EndIf


/*
	
{
  "codtec": "000123",
  "numosv": "000456",
  "dataHora": "08-07-2026 16:59",
  'tarefas': [
    ["000001", ["000002", "000003"]],
    ["000004", ["000005"]]
  ]
}

2. Pausa

