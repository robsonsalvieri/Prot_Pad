/*/{Protheus.doc} buscaTarefas
    Faz a busca de tarefas

    @type method
    @author Bruno Forcato
    @since 27/01/2026
/*/
Method buscaTarefas(cNumOS) Class OFApontamentoDeTarefaClass
	local cAlias := GetNextAlias()
	Local cQuery    := ""
	local cFixQuery := ""
	local oStatement := FWPreparedStatement():new()
	local jTarefa := JsonObject():New()
	local aTarefas := {}
	local jServico := JsonObject():New()
	local cTarefaAtual := ""

	cQuery += "	SELECT "
	cQuery +=          " DISTINCT VST_SEQINC, VST_DESINC, VO6_CODSER, "
	cQuery +=          " VO6_DESSER, VO4_TEMPAD "
	cQuery += " FROM " + RetSQLName("VO4") + " VO4 "
	cQuery += " JOIN " + RetSQLName("VST") + " VST "
	cQuery +=      " ON VST.VST_FILIAL = '" + FWxFilial("VST") + "' AND VST.VST_TIPO = '2' AND VST.VST_CODIGO = VO4.VO4_NUMOSV AND VST.VST_SEQINC = VO4.VO4_SEQINC AND VST.D_E_L_E_T_ = ' '"
	cQuery += " JOIN " + RetSQLName("VO6") + " VO6 "
	cQuery +=      " ON VO6.VO6_FILIAL = '" + FWxFilial("VO6") + "' AND VO6_CODSER = VO4.VO4_CODSER AND VO6.VO6_GRUSER = VO4.VO4_GRUSER AND VO6.D_E_L_E_T_ = ' '"
	cQuery += " JOIN " + RetSQLName("VOK") + " VOK "
	cQuery +=     " ON VOK.VOK_FILIAL = '" + FWxFilial("VOK") + "' AND VOK.VOK_TIPSER = VO4.VO4_TIPSER AND VOK.VOK_INCMOB NOT IN ('3', '5')"
	cQuery += " WHERE VO4.VO4_FILIAL = '" + FWxFilial("VO4") + "' "
	cQuery +=   " AND VO4.VO4_NUMOSV = ?"
	cQuery +=   " AND VO4.VO4_DATCAN = ' ' AND VO4.VO4_DATFEC = ' ' AND VO4.VO4_DATDIS = ' '"
	cQuery +=   " AND VO4.D_E_L_E_T_ = ' '"
	cQuery += " ORDER BY VST.VST_SEQINC, VO6_CODSER"

	oStatement:setQuery(cQuery)
	oStatement:setString(1, cNumOS)

	cFixQuery := oStatement:getFixQuery()
	dbUseArea( .T., "TOPCONN", TcGenQry( ,, cFixQuery ), cAlias, .F. , .T. )
	While !(cAlias)->(EoF())

		If cTarefaAtual <> AllTrim((cAlias)->VST_SEQINC)
			If !Empty(jTarefa['id'])
				AAdd(aTarefas, jTarefa)
			EndIf

			cTarefaAtual := AllTrim((cAlias)->VST_SEQINC)

			jTarefa := JsonObject():New()
			jTarefa['id']    := AllTrim((cAlias)->VST_SEQINC)
			jTarefa['descricao'] := encodeUTF8(AllTrim((cAlias)->VST_DESINC))
			jTarefa['tempo']     := (cAlias)->VO4_TEMPAD
			jTarefa['servicos']  := {}
		EndIf

		jServico := JsonObject():New()
		jServico['id'] := AllTrim((cAlias)->VO6_CODSER)
		jServico['descricao'] := encodeUTF8(AllTrim((cAlias)->VO6_DESSER))
		jServico['tempo']     := (cAlias)->VO4_TEMPAD

		AAdd(jTarefa['servicos'], jServico)

		(cAlias)->(DbSkip())
	End

	If !Empty(jTarefa['id'])
		AAdd(aTarefas, jTarefa)
	EndIf

	(cAlias)->(DbCloseArea())
Return aTarefas

/*/{Protheus.doc} buscaConfig
    Busca as configurações necessarias para fazer o apontamento

    @type method
    @author Bruno Forcato
    @since 30/01/2026
/*/
Method buscaConfig() Class OFApontamentoDeTarefaClass
	local jConfig := JsonObject():New()
	local aAreaVAI := VAI->(GetArea())

	VAI->(DbSetOrder(4))
	if !VAI->(MsSeek(xFilial("VAI") + __cUserID))
		jConfig['erro'] := STR0001 // "Usuário sem cadastro na equipe técnica"
		VAI->(RestArea(aAreaVAI))
		return jConfig
	endif

	jConfig["alteraApontamento"] := VAI->VAI_ALTAPO
	VAI->(RestArea(aAreaVAI))
Return jConfig

/*/{Protheus.doc} buscaApontamentoAtivo
    Busca o apontamento ativo do mecanico

    @type method
    @author Bruno Forcato
    @since 01/07/2026
/*/
Method buscaApontamentoAtivo(cCodTec) Class OFApontamentoDeTarefaClass
	local cAlias := GetNextAlias()
	Local cQuery := ""
	local cFixQuery := ""
	local oStatement := FWPreparedStatement():new()
	local jRet := JsonObject():New()
	local jOrdemServico := JsonObject():New()
	local jTarefa := JsonObject():New()
	local jServico := JsonObject():New()
	local cNumOS := ""
	local cTarefaAtual := "*******"
	local lTarefaInicializada := .f.
	default cCodTec := ""

	jRet['ativo'] := .f.
	jRet['tarefas'] := {}

	cQuery += " SELECT "
	cQuery += "     VO4.VO4_NUMOSV, VO4.VO4_SEQUEN, VO4.VO4_SEQINC, "
	cQuery += "     VO4.VO4_CODSER, VO4.VO4_DATINI, VO4.VO4_HORINI, VO4.VO4_TEMPAD, "
	cQuery += "     VO1.VO1_LOJPRO, VO1.VO1_PROVEI, VO1.VO1_STATUS, VO1.VO1_CHASSI, VO1.VO1_PLAVEI, VO1.VO1_DATABE, "
	cQuery += "     VST.VST_DESINC, VO6.VO6_DESSER "
	cQuery += " FROM " + RetSQLName("VO4") + " VO4 "
	cQuery += " JOIN " + RetSQLName("VO1") + " VO1 ON VO1.VO1_FILIAL = ? AND VO1.VO1_NUMOSV = VO4.VO4_NUMOSV AND VO1.D_E_L_E_T_ = ' ' "
	cQuery += " LEFT JOIN " + RetSQLName("VST") + " VST ON VST.VST_FILIAL = ? AND VST.VST_TIPO = '2' AND VST.VST_CODIGO = VO4.VO4_NUMOSV AND VST.VST_SEQINC = VO4.VO4_SEQINC AND VST.D_E_L_E_T_ = ' ' "
	cQuery += " LEFT JOIN " + RetSQLName("VO6") + " VO6 ON VO6.VO6_FILIAL = ? AND VO6.VO6_CODSER = VO4.VO4_CODSER AND VO6.VO6_GRUSER = VO4.VO4_GRUSER AND VO6.D_E_L_E_T_ = ' ' "
	cQuery += " WHERE VO4.VO4_FILIAL = ? "
	cQuery += "   AND VO4.VO4_CODPRO = ? "
	cQuery += "   AND VO4.VO4_DATFIN = ' ' "
	cQuery += "   AND VO4.VO4_DATCAN = ' ' AND VO4.VO4_DATFEC = ' ' AND VO4.VO4_DATDIS = ' '"
	cQuery += "   AND VO4.D_E_L_E_T_ = ' ' "
	cQuery += " ORDER BY VO4.VO4_NUMOSV, VO4.VO4_SEQINC, VO4.VO4_SEQUEN "

	oStatement:setQuery(cQuery)
	oStatement:setString(1, FWxFilial("VO1"))
	oStatement:setString(2, FWxFilial("VST"))
	oStatement:setString(3, FWxFilial("VO6"))
	oStatement:setString(4, FWxFilial("VO4"))
	oStatement:setString(5, PadR(AllTrim(cCodTec), TamSX3("VO4_CODPRO")[1]))

	cFixQuery := oStatement:getFixQuery()
	dbUseArea( .T., "TOPCONN", TcGenQry( ,, cFixQuery ), cAlias, .F. , .T. )
	While !(cAlias)->(EoF())
		If Empty(cNumOS)
			cNumOS := AllTrim((cAlias)->VO4_NUMOSV)

			dbSelectArea("SA1")
			dbSetOrder(1)
			dbSeek(xFilial("SA1")+(cAlias)->VO1_PROVEI+(cAlias)->VO1_LOJPRO)

			jOrdemServico['numosv'] := cNumOS
			jOrdemServico['cliente'] := encodeUTF8(alltrim(SA1->A1_NOME))
			jOrdemServico['status'] := alltrim((cAlias)->VO1_STATUS)
			jOrdemServico['chassi'] := alltrim((cAlias)->VO1_CHASSI)
			jOrdemServico['placa'] := alltrim((cAlias)->VO1_PLAVEI)
			jOrdemServico['dataAbertura'] := alltrim((cAlias)->VO1_DATABE)

			jRet['ativo'] := .t.
			jRet['ordemServico'] := jOrdemServico
		EndIf

		If cNumOS <> AllTrim((cAlias)->VO4_NUMOSV)
			(cAlias)->(DbSkip())
			Loop
		EndIf

		If !lTarefaInicializada .Or. cTarefaAtual <> AllTrim((cAlias)->VO4_SEQINC)
			If lTarefaInicializada
				AAdd(jRet['tarefas'], jTarefa)
			EndIf

			cTarefaAtual := AllTrim((cAlias)->VO4_SEQINC)
			jTarefa := JsonObject():New()
			jTarefa['id'] := cTarefaAtual
			jTarefa['descricao'] := IIf(Empty(cTarefaAtual), STR0005, encodeUTF8(AllTrim((cAlias)->VST_DESINC))) // "Sem tarefa"
			jTarefa['tempo'] := (cAlias)->VO4_TEMPAD
			jTarefa['servicos'] := {}
			lTarefaInicializada := .t.
		EndIf

		jServico := JsonObject():New()
		jServico['id'] := AllTrim((cAlias)->VO4_SEQUEN)
		jServico['codigo'] := AllTrim((cAlias)->VO4_CODSER)
		jServico['sequencia'] := AllTrim((cAlias)->VO4_SEQUEN)
		jServico['seqinc'] := AllTrim((cAlias)->VO4_SEQINC)
		jServico['descricao'] := encodeUTF8(AllTrim((cAlias)->VO6_DESSER))
		jServico['tempo'] := (cAlias)->VO4_TEMPAD
		jServico['dataInicio'] := Transform((cAlias)->VO4_DATINI, "@D")
		jServico['horaInicio'] := Transform((cAlias)->VO4_HORINI, "@R 99:99")

		AAdd(jTarefa['servicos'], jServico)
		(cAlias)->(DbSkip())
	End

	If lTarefaInicializada
		AAdd(jRet['tarefas'], jTarefa)
	EndIf

	(cAlias)->(DbCloseArea())
Return jRet

/*/{Protheus.doc} buscaMotivosPausa
    Busca motivos de pausa cadastrados

    @type method
    @author Bruno Forcato
    @since 01/07/2026
/*/
Method buscaMotivosPausa() Class OFApontamentoDeTarefaClass
	local aMotivosOFA := OFA210MOT("000006", "2", "", "", .f.)
	local aMotivos := {}
	local jMotivo := JsonObject():New()
	local nI := 0
	local nPos := 0
	local cMotivo := ""
	local cDescricao := ""

	For nI := 1 To Len(aMotivosOFA)
		If ValType(aMotivosOFA[nI]) == "C"
			nPos := At("=", aMotivosOFA[nI])
			If nPos > 0
				cMotivo := AllTrim(SubStr(aMotivosOFA[nI], 1, nPos - 1))
				cDescricao := AllTrim(SubStr(aMotivosOFA[nI], nPos + 1))
			Else
				cMotivo := AllTrim(aMotivosOFA[nI])
				cDescricao := ""
			EndIf
		ElseIf ValType(aMotivosOFA[nI]) == "A" .And. Len(aMotivosOFA[nI]) >= 2
			cMotivo := AllTrim(aMotivosOFA[nI, 1])
			cDescricao := AllTrim(aMotivosOFA[nI, 2])
		Else
			Loop
		EndIf

		If Empty(cMotivo)
			Loop
		EndIf

		jMotivo := JsonObject():New()
		jMotivo['codigo'] := cMotivo
		jMotivo['descricao'] := encodeUTF8(cDescricao)
		AAdd(aMotivos, jMotivo)
	Next nI
Return aMotivos

/*/{Protheus.doc} finalizaApontamento
    Finaliza apontamentos selecionados

    @type method
    @author Bruno Forcato
