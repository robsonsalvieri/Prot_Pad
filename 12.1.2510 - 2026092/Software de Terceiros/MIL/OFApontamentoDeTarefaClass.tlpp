/*/{Protheus.doc} OFApontamentoDeTarefaClass
    Classe para uso do Apontamento de Tarefa
    
    @type class
    @author Bruno Forcato
    @since 21/01/2026
/*/
Class OFApontamentoDeTarefaClass
	Public Method New() as object
	Public Method buscaOS() as array
	Public Method buscaMecanicos() as array
	Public Method buscaTarefas() as array
	Public Method buscaConfig() as Json
	Public Method buscaApontamentoAtivo() as Json
	Public Method buscaMotivosPausa() as array
	Public Method finalizaApontamento() as Json
	Public Method pausaApontamento() as Json
	Public Method apontarTarefa() as Json
EndClass

/*/{Protheus.doc} New
    Construtor Simples

    @type method
    @author Bruno Forcato
    @since 21/01/2026
/*/
Method New() Class OFApontamentoDeTarefaClass
Return SELF

/*/{Protheus.doc} buscaOS
    Faz a busca de ordens de serviço

    @type method
    @author Bruno Forcato
    @since 21/01/2026
/*/
Method buscaOS(cData, cChassi, cPlaca) Class OFApontamentoDeTarefaClass
	local cAlias := GetNextAlias()
	Local cQuery    := ""
	local cFixQuery := ""
	local oStatement := FWPreparedStatement():new()
	local nParam := 1
	local jOrdemServico := nil
	local aOrdemsDeServicos := {}
	default cData := ""
	default cChassi := ""
	default cPlaca := ""

	cQuery += " SELECT "
	cQuery += "     VO1.VO1_NUMOSV, "
	cQuery += "     VO1.VO1_LOJPRO, "
	cQuery += "     VO1.VO1_PROVEI, "
	cQuery += "     VO1.VO1_STATUS, "
	cQuery += "     VO1.VO1_CHASSI, "
	cQuery += "     VO1.VO1_PLAVEI, "
	cQuery += "     VO1.VO1_DATABE "
	cQuery += " FROM " + RetSQLName("VO1") + " VO1 "
	cQuery += " WHERE VO1.VO1_FILIAL = ? "
	cQuery += "   AND VO1.VO1_STATUS = ? "
	cQuery += "   AND EXISTS ( "
	cQuery += "       SELECT 1 "
	cQuery += "       FROM " + RetSQLName("VO2") + " VO2 "
	cQuery += "       JOIN " + RetSQLName("VO4") + " VO4 ON VO2.VO2_NOSNUM = VO4.VO4_NOSNUM "
	cQuery += "       JOIN " + RetSQLName("VOK") + " VOK ON VOK.VOK_TIPSER = VO4.VO4_TIPSER "
	cQuery += "       WHERE VO2.VO2_NUMOSV = VO1.VO1_NUMOSV "
	cQuery += "         AND VOK.VOK_INCMOB NOT IN ('2', '5') "
	cQuery += "   ) "

	If !Empty(cData)
		cQuery += " AND VO1.VO1_DATABE = ? "
	EndIf

	If !Empty(cChassi)
		cQuery += " AND RTRIM(LTRIM(VO1.VO1_CHASSI)) = ? "
	EndIf

	If !Empty(cPlaca)
		cQuery += " AND UPPER(VO1.VO1_PLAVEI) = ? "
	EndIf

	oStatement:setQuery(cQuery)
	oStatement:setString(nParam++, FWxFilial("VO1"))
	oStatement:setString(nParam++, "A")

	If !Empty(cData)
		oStatement:setString(nParam++, cData)
	EndIf

	If !Empty(cChassi)
		oStatement:setString(nParam++, AllTrim(cChassi))
	EndIf

	If !Empty(cPlaca)
		oStatement:setString(nParam++, Upper(AllTrim(cPlaca)))
	EndIf

	cFixQuery := oStatement:getFixQuery()
	dbUseArea( .T., "TOPCONN", TcGenQry( ,, cFixQuery ), cAlias, .F. , .T. )
	While !(cAlias)->(EoF())
		dbSelectArea("SA1")
		dbSetOrder(1)
		dbSeek(xFilial("SA1")+(cAlias)->VO1_PROVEI+(cAlias)->VO1_LOJPRO)

		jOrdemServico := JsonObject():New()
		jOrdemServico['numosv'] := alltrim((cAlias)->VO1_NUMOSV)
		jOrdemServico['cliente'] := encodeUTF8(alltrim(SA1->A1_NOME))
		jOrdemServico['status'] := alltrim((cAlias)->VO1_STATUS)
		jOrdemServico['chassi'] := alltrim((cAlias)->VO1_CHASSI)
		jOrdemServico['placa'] := alltrim((cAlias)->VO1_PLAVEI)
		jOrdemServico['dataAbertura'] := alltrim((cAlias)->VO1_DATABE)

		AAdd(aOrdemsDeServicos,jOrdemServico)
		(cAlias)->(dbSkip())
	End
	(cAlias)->(DbCloseArea())
Return aOrdemsDeServicos

