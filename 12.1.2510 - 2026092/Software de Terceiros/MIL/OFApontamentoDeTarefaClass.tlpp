}

3. Finalizacao

{
  "codtec": "000123",
  "numosv": "000456",
  "dataHora": "08-07-2026 18:10",
  'tarefas': [
    ["000001", ["000002", "000003"]],
    ["000004", ["000005"]]
  ],
  "finalizaApontamento": true
}
	/*
	if jRequest:HasProperty('tarefas') .and. valtype(jRequest['tarefas']) == "A"
		For nI := 1 To Len(jRequest['tarefas'])
			
			// jRequest['tarefas'][nI] contém, por exemplo: ["000001", ["000002", "000003"]]
			// Vamos extrair a tarefa principal e a lista de subtarefas
			aSubTar := {}
			
			// Se o segundo elemento do array interno também for um array (as subtarefas)
			If ValType(jRequest['tarefas'][nI][2]) == "A"
					For nJ := 1 To Len(jRequest['tarefas'][nI][2])
						AAdd(aSubTar, jRequest['tarefas'][nI][2][nj])
					Next nJ
			EndIf

			// Adiciona no nosso array final no formato: { "000001", { "000002", "000003" } }
			AAdd(aTarefas, { jRequest['tarefas'][nI][1], aClone(aSubTar) })
			
		Next nI
	endif
*/

	aTarefas := {}
	if jRequest:HasProperty('tarefas') .and. valtype(jRequest['tarefas']) == "A"
		aAuxTarefas := jRequest['tarefas']
		
		For nI := 1 To Len(aAuxTarefas)
			conout("Tarefa: " + cvaltochar(nI))
			oTarefa := aAuxTarefas[nI]
			
			// Validação para o item do array (cada tarefa)
			If ValType(oTarefa) == "J" .and. oTarefa:HasProperty("id")
			
				conout("Tarefa ID: " + oTarefa["id"])

				aSrvcTarefa := {}
				// Validação segura para a lista de serviços da tarefa
				If oTarefa:HasProperty("servicos") .and. ValType(oTarefa["servicos"]) == "A"
					aAuxServicos := oTarefa["servicos"]
					For nJ := 1 To Len(aAuxServicos)

						conout("Serviço: " + cvaltochar(nI) + " - " + cvaltochar(nj))

						oServico := aAuxServicos[nJ]

						// Validação segura para o serviço]
						If ValType(oServico) == "J" .and. oServico:HasProperty("id")
							conout("  -> Serviço: " + oServico["id"])
							AAdd(aSrvcTarefa, oServico["id"])
						EndIf

					Next nJ
				EndIf

				Aadd(aTarefas, { oTarefa["id"], aClone(aSrvcTarefa) })
			EndIf
		Next nI
	endif

	If validaFuturo(dData, nHora)
		jRet['erro'] := STR0006 // "Não é permitido apontar em uma data ou hora futura."
		Return jRet
	EndIf
	If !_UsuarioAutorizado(cCodTec)
		jRet['erro'] := STR0007 // "Usuário não autorizado!"
		Return jRet
	EndIf
	Conout(" ")
	Conout("cNumOS    : " + cvaltochar(cNumOS))
	Conout("cCodTec   : " + cvaltochar(cCodTec))
	Conout("cDataHora : " + cvaltochar(cDataHora))
	Conout("dData     : " + cvaltochar(dData))
	Conout("nHora     : " + cvaltochar(nHora))
	Conout("Pausa     : " + cvaltochar(lpausaApontamento))
	Conout("Motivo    : " + cvaltochar(cMotPausa))
	Conout("Finaliza  : " + cvaltochar(lFinalizaApontamento))
	Conout(" ")

	varInfo("aTarefas",aTarefas)

	AADD( aCabVO4 , { "AUTAPONT" , .t. , nil } )
	AADD( aCabVO4 , { "VO4_CODPRO" , cCodTec , nil } )
	
	if linicializaApontamento
		AADD( aCabVO4 , { "VO4_DATINI" , dData , nil } )
		AADD( aCabVO4 , { "VO4_HORINI" , nHora , nil } )
	endif

	if lFinalizaApontamento .or. lpausaApontamento
		AADD( aCabVO4 , { "VO4_DATFIN" , dData , nil } )
		AADD( aCabVO4 , { "VO4_HORFIN" , nHora , nil } )
	endif

	if len(aTarefas) > 0
		AADD( aCabVO4 , { "APONTTAR" , aTarefas , nil } )
	endif

	if ! empty(cMotPausa)
		AADD( aCabVO4 , { "VO4_MPAUSA" , cMotPausa , nil } )
	endif

	varinfo("aCabVO4",aCabVO4)

	lMSHelpAuto := .t.
	lMsErroAuto := .f.

	VO1->(dbSetOrder(1))
	if ! VO1->(dbSeek(xFilial("VO1") + cNumOS))
		jRet['erro'] := STR0008 + xfilial("VO1") + "-" + cNumOS // "Ordem de serviço não encontrada: "
		return jRet
	endif

	MSExecAuto({|x,y,z| OFIOM030(,,x,y,z)},aCabVO4,aIteVO4,2)

	if lMsErroAuto
		jRet['erro'] := STR0009 + mostraerro("\") // "Erro ExecAuto: "
	Endif
	
	jRet['processados'] := 1
Return jRet

/*/{Protheus.doc} _UsuarioAutorizado
    Valida se o usuario logado pode apontar para o tecnico informado.
    Aplica a mesma regra da FS_VALDPRO da rotina OFIOM030.

    @type function
    @param cCodTec, character, Codigo do tecnico selecionado
    @return logical, Indica se o usuario possui autorizacao
    @author Bruno Forcato
    @since 24/07/2026
/*/
Static Function _UsuarioAutorizado(cCodTec)
	local aAreaVAI := VAI->(GetArea())
	local lAutorizado := .f.

	VAI->(DbSetOrder(4))
	If VAI->(MsSeek(xFilial("VAI") + __cUserID))
		lAutorizado := AllTrim(VAI->VAI_CODTEC) == AllTrim(cCodTec) .Or. VAI->VAI_ALTAPO == "1"
	EndIf

	VAI->(RestArea(aAreaVAI))
Return lAutorizado

/*/{Protheus.doc} _ProcessaEncerramento
    Grava finalizacao ou pausa dos apontamentos

    @type function
    @author Bruno Forcato
    @since 01/07/2026
/*/
Static Function _ProcessaEncerramento(jRequest, lPausa)
	local jRet := JsonObject():New()
	local aServicos := jRequest['servicos']
	local cNumOS := AllTrim(jRequest['numosv'])
	local cCodTec := AllTrim(jRequest['codtec'])
	local cDataHora := AllTrim(jRequest['dataHora'])
	local cMotivo := ""
	local dDataFim := _ConverteData(cDataHora)
	local nHoraFim := _ConverteHora(cDataHora)
	local nI := 0
	local cSeqInc := ""
	local cCodSer := ""
	local nProcessados := 0
	local lEncontrou := .f.

	If lPausa
		cMotivo := AllTrim(jRequest['motivoPausa'])
	EndIf

	If Empty(cNumOS) .Or. Empty(cCodTec) .Or. Empty(cDataHora) .Or. Empty(aServicos)
		jRet['erro'] := STR0002 // "Parâmetros inválidos, tente novamente!"
		Return jRet
	EndIf

	If lPausa .And. Empty(cMotivo)
		jRet['erro'] := STR0003 // "Informe o motivo da pausa."
		Return jRet
	EndIf

	If validaFuturo(dDataFim, nHoraFim)
		jRet['erro'] := STR0006 // "Não é permitido apontar em uma data ou hora futura."
		Return jRet
	EndIf

	If !_UsuarioAutorizado(cCodTec)
		jRet['erro'] := STR0007 // "Usuário não autorizado!"
		Return jRet
	EndIf

	For nI := 1 To Len(aServicos)
		cSeqInc := AllTrim(aServicos[nI]['seqinc'])
		cCodSer := AllTrim(aServicos[nI]['codigo'])
		lEncontrou := .f.

		dbSelectArea("VO4")
		dbSetOrder(10) // VO4_FILIAL + VO4_NUMOSV + VO4_TIPTEM + VO4_NOSNUM
		dbSeek(xFilial("VO4") + cNumOS)
		While !VO4->(Eof()) .And. VO4->VO4_FILIAL + VO4->VO4_NUMOSV == xFilial("VO4") + cNumOS
			If AllTrim(VO4->VO4_SEQINC) == cSeqInc .And. AllTrim(VO4->VO4_CODSER) == cCodSer .And. AllTrim(VO4->VO4_CODPRO) == cCodTec .And. Empty(VO4->VO4_DATFIN) .And. Empty(VO4->VO4_DATCAN)
				lEncontrou := .t.
				// Os dados dDataFim, nHoraFim e cMotivo (na pausa) vêm do front-end
				nProcessados++
				Exit
			EndIf
			VO4->(DbSkip())
		End

		If !lEncontrou
			jRet['erro'] := STR0004 // "Serviço em andamento não encontrado."
			Return jRet
		EndIf
	Next nI

	jRet['processados'] := nProcessados
Return jRet

/*/{Protheus.doc} validaFuturo
    Valida se a data e hora informadas estao no futuro.

    @type function
    @param dData, date, Data informada no apontamento
    @param nHora, numeric, Hora no formato HHMM
    @return logical, Indica se o valor esta no futuro
    @author Bruno Forcato
    @since 24/07/2026
/*/
Static Function validaFuturo(dData, nHora)
	local nHoraAtual := Val(StrTran(SubStr(Time(), 1, 5), ":", ""))
Return dData > Date() .Or. (dData == Date() .And. nHora > nHoraAtual)

/*/{Protheus.doc} _ConverteData
    Converte data do payload para data Protheus

    @type function
    @author Bruno Forcato
    @since 01/07/2026
/*/
Static Function _ConverteData(cDataHora)
	local cData := SubStr(cDataHora, 7, 4) + SubStr(cDataHora, 4, 2) + SubStr(cDataHora, 1, 2)
Return SToD(cData)

/*/{Protheus.doc} _ConverteHora
    Converte hora do payload para numerico HHMM

    @type function
    @author Bruno Forcato
    @since 01/07/2026
/*/
Static Function _ConverteHora(cDataHora)
Return Val(StrTran(SubStr(cDataHora, 12, 5), ":", ""))
