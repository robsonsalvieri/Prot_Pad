/*/{Protheus.doc} getFilUser
   Retorna as filiais que o usuario tem permissão

   @type  Function
   @author user
   @since 07/10/2024
   @version version
   @param param_name, param_type, param_descr
   @return return_var, return_type, return_description
   @example
   (examples)
   @see (links_or_references)
/*/
function getFilUser(aRetFils)
   local cFiltFil  := ""
   local aFilUser  := {}
   local nLenFil   := 0
   local nFil      := 0

   default aRetFils   := {}

   nLenFil := len(aRetFils)
   aFilUser := FwLoadSM0(,.T.)
   for nFil := 1 to len(aFilUser)
      if len(aFilUser[nFil]) >= 11 .and. aFilUser[nFil][11]
         if nLenFil == 0 .or. aScan(aRetFils, { |Y| Y == aFilUser[nFil][2]} ) == 0
            aAdd(aRetFils , aFilUser[nFil][2])
         endif
         cFiltFil += "'" + aFilUser[nFil][2] + "', "
      endif
   next
   cFiltFil := subStr(cFiltFil, 1, len(cFiltFil) - 2)

return cFiltFil

/*/{Protheus.doc} EasyRetAut
   Função para validar a autenticação no portal único

   @type  Function
   @author user
   @since 07/10/2024
   @version version
   @param param_name, param_type, param_descr
   @return return_var, return_type, return_description
   @example
   (examples)
   @see (links_or_references)
/*/
function EasyRetAut(cRetorno, cMsgError, cMsgSol)
   local lRet       := .F.
   local nPos       := 0

   default cRetorno  := ""

   lRet := alltrim(cRetorno) == 'AUTENTICADO_OK'

   if !lRet
      nPos := at("O token gerado deve ser reaproveitado", cRetorno)
      cMsgError := if( nPos > 0 , substr(cRetorno, 1, nPos-1), cRetorno)
      cMsgSol := if( nPos > 0 , STR0003, "") // "Realize a integração novamente após 60 segundos."

      nPos := at("Failed to fetch", cRetorno)
      if nPos > 0
         cMsgError := STR0004 // "Falha de autenticação"
         cMsgSol := STR0005 // "Verifique o certificado selecionado para a integração com o Portal Único."
      endif
   endif

return lRet

/*/{Protheus.doc} filterLoteOrigemComex
    Função para setar o filtro na rotina  de origem COMEX

    @type  Function
    @author Wilsimar Fabricio
    @since 17/11/2025
    @version version
    @param param_name, param_type, param_descr
    @return Filtro com os títulos que não devem ser exibidos na rotina de baixa em lote do contas a pagar (fina080)
    @example
    (examples)
    @see (links_or_references)
/*/
function filterLoteOrigemComex()
local cOrigemComex as character

    //qualquer título gerado pelo SIGAEFF
    cOrigemComex := " .AND. !('SIGAEFF' $ E2_ORIGEM"

    //Títulos INV gerados pelo câmbio de importação
    cOrigemComex += " .OR. ('SIGAEIC' $ E2_ORIGEM .AND. E2_TIPO = 'INV')"

    //Títulos NF gerados pelo SIGAEEC, em moeda estrangeira
    cOrigemComex += " .OR. ('SIGAEEC' $ E2_ORIGEM .AND. E2_MOEDA > 1) )"

return cOrigemComex

/*/{Protheus.doc} getSX9CDom
    Função para obter os contra dominios de uma tabela a partir da SX9

    @type  Function
    @author Wilsimar Fabricio
    @since 17/11/2025
    @version version
    @param param_name, param_type, param_descr
    @return Filtro com os títulos que não devem ser exibidos na rotina de baixa em lote do contas a pagar (fina080)
    @example
    (examples)
    @see (links_or_references)
/*/
function getSX9CDom(cTabDom)
    local aTabCDom as array
    local aAreaSX9 as array

    aAreaSX9 := SX9->(getArea())

    aTabCDom := {}
    SX9->(dbSetOrder(1)) // X9_DOM
    if SX9->(dbSeek(cTabDom))
        while !SX9->(Eof()) .and. SX9->X9_DOM == cTabDom
            // Caso seja necessário passar a filial para a validação, utilizar a segunda posição
            if aScan( aTabCDom, { |X| X[1] == SX9->X9_CDOM} ) == 0
                aAdd( aTabCDom, {SX9->X9_CDOM , {}} )
            endif
            SX9->(dbSkip())
        end
    endif
    restArea(aAreaSX9)

return aTabCDom

/*/{Protheus.doc} getFile
    Função para retornar um diretorio ou um arquivo selecionado pelo usuário pela função cGetFile
    https://tdn.totvs.com/display/tec/cGetFile   

    @type  Function
    @author user
    @since 03/07/2026
    @version version
    @param
        cRotina, character, Indica o nome da rotina que será gravado o diretório selecionado de acordo com o usuário.
        cMascara, character, Indica o nome do arquivo ou máscara.
        cTitulo, character, Indica o título da janela. Caso o parâmetro não seja especificado, o título padrão será apresentado.
        nMascPadrao, integer, Indica o número da máscara.
        cDirInicial, character, Indica o diretório inicial.
        lAbrir, logical, Indica se é um "open dialog" (.T.) ou um "save dialog" (.F.).
        nOpcoes, integer, Indica a opção de funcionamento. Para mais informações das funcionalidades disponíveis, consulte a área Observações.
        lArvore, logical, Indica se, verdadeiro (.T.), apresenta o árvore do servidor; caso contrário, falso (.F.).
        lKeepCase, logical, Indica se, verdadeiro (.T.), mantém o case original; caso contrário, falso (.F.).
        lGravaDir, logical, Indica se, verdadeiro (.T.), grava o diretório selecionado de acordo com o usuario; caso contrário, falso (.F.).
        lDir, logical, Indica se, verdadeiro (.T.), grava o diretório (.T.) ou arquivo selecionado (.F.).
    @return cReturn, character, Caminho do diretório ou arquivo selecionado pelo usuário
    @example
    (examples)
    @see (links_or_references)
/*/
function getFile(cRotina, cMascara, cTitulo, nMascPadrao, cDirInicial, lAbrir, nOpcoes, lArvore, lKeepCase, lGravaDir, lDir )
    local cReturn as character
    local cBarra as character
    local oUserCFG as object
    local cDirIni as character

    default lGravaDir  := .T.
    default lDir       := .T.
    default nOpcoes    := GETF_LOCALHARD+GETF_NETWORKDRIVE

    private cCustomTXT := "" // Utilizado no ponto de entrada GETFILE - retorno do arquivo escolhido pelo usuário na customização
    private lGetFile   := .T. // Utilizado no ponto de entrada GETFILE - define se usa o padrão .T. ou customizado .F. 
    private lGrvCust   := .T. // Utilizado no ponto de entrada GETFILE - define se grava o diretório selecionado de acordo com o usuario (.T.); caso contrário, falso (.F.).

    if(EasyEntryPoint("Comex_Generics"),ExecBlock("Comex_Generics",.F.,.F.,"GETFILE"),)
    cReturn := cCustomTXT

    if lGravaDir .and. lGrvCust
        cBarra := if(IsSrvUnix(), "/", "\")
        oUserCFG := EASYUSERCFG():New(cRotina) // default -> ProcName(1), cUserName, xFilial("EWQ")
        cDirIni := oUserCFG:LoadParam("GETFILE", "", ,.T.)
        cDirInicial := cDirIni
    endif

    if lGetFile // não foi utilizado a variavel cCustomTXT, pois o usuario pode cancelar cGetFile
        cReturn := cGetFile(cMascara, cTitulo, nMascPadrao, cDirInicial, lAbrir, nOpcoes, lArvore, lKeepCase)
    endif

    if lGravaDir .and. lGrvCust .and. !empty(cReturn)
        cDirIni := substr(cReturn, 1, rat(cBarra, cReturn))
        oUserCFG:SetParam("GETFILE", cDirIni)
    endif

return cReturn

/*/{Protheus.doc} NewCtrNum
   Novo controle de numeração de documentos fiscais
   https://tdn.totvs.com/pages/releaseview.action?pageId=975771112

   @type  Function
   @author user
   @since 18/05/2026
   @version version
   @param 
   @return logical, .T. se existir novo número controle de numeração, .F. caso contrário
   @example
   (examples)
   @see (links_or_references)
/*/
function NewCtrNum()
   local lNewInvoic := .F.
      lNewInvoic := Iif(__RpoRelease >= '12.1.2410',;
		tlpp.ffunc("backoffice.fat.documento.UsaNewInvoice") .And.;
		tlpp.call('backoffice.fat.documento.UsaNewInvoice()'),.F.)
return lNewInvoic

