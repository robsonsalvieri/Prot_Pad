#include "tlpp-core.th"
#include "tlpp-rest.th"

namespace totvs.protheus.backoffice.pif.fiscal.insight.purchaseorderssuggested
using namespace totvs.protheus.backoffice.pif.util

//------------------------------------------------------------------------------
/*/ {Protheus.doc} PurchaseOrdersSuggestedController
    API utilizada para retoornar os dados dos pedidos de compra sugeridos na 
    tela do Monitor de compras

    @author Squad PIF
    @version 1.0
/*/
//------------------------------------------------------------------------------
Class PurchaseOrdersSuggestedController

    Public Method new() Constructor
    
    @Get("/api/pif/purchaseorderssuggested")
    Public Method getPurchaseOrdersSuggested()

    @Get("/api/pif/purchaseorderssuggested/items")
    Public Method getPurchaseOrdersSuggestedItems()

    @Get("/api/pif/purchaseordersmanually")
    Public Method getPurchaseOrdersManually()

    @Get("/api/pif/purchaseordersmanually/items")
    Public Method getPurchaseOrdersManuallyItems()

    @Get("/api/pif/purchaseorderslinked")
    Public Method getPurchaseOrdersLinked()

    @Get("/api/pif/purchaseorderslinked/items")
    Public Method getPurchaseOrdersLinkedItems()
    
endClass

//------------------------------------------------------------------------------
/*/ {Protheus.doc} new
    Metodo construtor

    @author Squad PIF
    @version 1.0
    @return Object, retorna o objeto criado
/*/
//------------------------------------------------------------------------------
Method new() Class PurchaseOrdersSuggestedController
Return Self

//------------------------------------------------------------------------------
/*/ {Protheus.doc} getPurchaseOrdersSuggested
    Método que executa a chamada da API

    @type Method
    @author Squad PIF
    @return Nil
/*/
//------------------------------------------------------------------------------
Method getPurchaseOrdersSuggested() class PurchaseOrdersSuggestedController

	Local oService      As Object
	Local JResponse     As Json
	Local cDocument     As Character
	Local cSerial       As Character
    Local cSupplier     As Character
    Local cStore        As Character
	Local cBranch       As Character

	cBranch     := ""
	cDocument   := ""
	cSerial     := ""
    cSupplier   := ""
    cStore      := ""

	JResponse := getNoAccessResponse()

    if canAccess("PIFA020")
        
        If  (oRest:getQueryRequest():GetJsonText("branch") != "null") .And. (oRest:getQueryRequest():GetJsonText("document") != "null") .And. ;
		 	(oRest:getQueryRequest():GetJsonText("serial") != "null") .And. (oRest:getQueryRequest():GetJsonText("supplier") != "null") .And. ;
			(oRest:getQueryRequest():GetJsonText("store") != "null") 

			cBranch     := oRest:getQueryRequest():GetJsonText("branch")
            cDocument   := oRest:getQueryRequest():GetJsonText("document")
            cSerial     := oRest:getQueryRequest():GetJsonText("serial")
            cSupplier   := oRest:getQueryRequest():GetJsonText("supplier")
            cStore      := oRest:getQueryRequest():GetJsonText("store")          

            oService   := PurchaseOrdersSuggestedService():New()
            JResponse  := oService:getPurchaseOrdersSuggested(cBranch, cDocument, cSerial, cSupplier, cStore)
        
        Endif

	EndIf

	answerRest(JResponse)

	FWFreeObj(oService)
	FreeObj(JResponse)
    
Return

//------------------------------------------------------------------------------
/*/ {Protheus.doc} getPurchaseOrdersSuggestedItems
    Método que executa a chamada da API

    @type Method
    @author Squad PIF
    @return Nil
/*/
//------------------------------------------------------------------------------
Method getPurchaseOrdersSuggestedItems() class PurchaseOrdersSuggestedController

	Local oService      As Object
	Local JResponse     As Json
	Local cDocument     As Character
	Local cSerial       As Character
    Local cSupplier     As Character
    Local cStore        As Character
    Local cProduct      As Character
    Local lItems        As Logical

	cBranch     := ""
	cDocument   := ""
	cSerial     := ""
    cSupplier   := ""
    cStore      := ""
    cProduct    := ""
    lItems      := .T.
	JResponse := getNoAccessResponse()

    if canAccess("PIFA020")
    
        If  (oRest:getQueryRequest():GetJsonText("branch") != "null") .And. (oRest:getQueryRequest():GetJsonText("document") != "null") .And. ;
		 	(oRest:getQueryRequest():GetJsonText("serial") != "null") .And. (oRest:getQueryRequest():GetJsonText("supplier") != "null") .And. ;
			(oRest:getQueryRequest():GetJsonText("store") != "null") 

            cBranch     := oRest:getQueryRequest():GetJsonText("branch")
            cDocument   := oRest:getQueryRequest():GetJsonText("document")
            cSerial     := oRest:getQueryRequest():GetJsonText("serial")
            cSupplier   := oRest:getQueryRequest():GetJsonText("supplier")
            cStore      := oRest:getQueryRequest():GetJsonText("store")     
            cProduct    := oRest:getQueryRequest():GetJsonText("product")     

            oService   := PurchaseOrdersSuggestedService():New()
            JResponse  := oService:getPurchaseOrdersSuggested(cBranch, cDocument, cSerial, cSupplier, cStore, cProduct, lItems)
        
        Endif

	EndIf

	answerRest(JResponse)

	FWFreeObj(oService)
	FreeObj(JResponse)
    
Return

//------------------------------------------------------------------------------
/*/ {Protheus.doc} getPurchaseOrdersManually
    Método que executa a chamada da API para retornar os Pedidos de Compra Manualmente

    @type Method
	@param lItems, Logical, indica se será por item
    @author Squad PIF
    @return Nil
/*/
//------------------------------------------------------------------------------
Method getPurchaseOrdersManually(lItems As Logical) class PurchaseOrdersSuggestedController

	Local oService    As Object
	Local jResponse   As Json
	Local nPage       As Numeric
	Local nPageSize   As Numeric
    Local cFilter     As Character
	Local cBranch 	  As Character

	Default lItems := .F.

	cBranch      := ""
  	cFilter      := ""
	nPage        := 1
	nPageSize    := 10

	jResponse := getNoAccessResponse()

	If canAccess("PIFA020")
		getPageAndPageSize(@nPage, @nPageSize)

		If (oRest:getQueryRequest():GetJsonText("branch") != "null")
			cBranch := oRest:getQueryRequest():GetJsonText("branch")
      	EndIf

		If (oRest:getQueryRequest():GetJsonText("$filter") != "null")
       		cFilter := AllTrim(oRest:getQueryRequest():GetJsonText("$filter"))
      	EndIf


	    oService   := PurchaseOrdersSuggestedService():New()
        JResponse  := oService:getPurchaseOrdersManually(cBranch, nPage, nPageSize, cFilter, lItems)
	EndIf

	answerRest(jResponse)

	FWFreeObj(oService)
	FreeObj(jResponse)
    
Return


//------------------------------------------------------------------------------
/*/ {Protheus.doc} getPurchaseOrdersManuallyItems
    Método que executa a chamada da API para retornar os Items de Pedidos de Compra Manualmente

    @type Method
    @author Squad PIF
    @return Nil
/*/
//------------------------------------------------------------------------------
Method getPurchaseOrdersManuallyItems() class PurchaseOrdersSuggestedController
	::getPurchaseOrdersManually(.T.)
Return


//------------------------------------------------------------------------------
/*/ {Protheus.doc} getPurchaseOrdersLinked
    Método que executa a chamada da API para retornar os pedidos de compra vinculados

    @type Method
	@param lItems, Logical, indica se será por item
    @author Squad PIF
    @return Nil
/*/
//------------------------------------------------------------------------------
Method getPurchaseOrdersLinked(lItems As Logical) class PurchaseOrdersSuggestedController

	Local oService    As Object
	Local jResponse   As Json
	Local nPage       As Numeric
	Local nPageSize   As Numeric
    Local cFilter     As Character
	Local cBranch 	  As Character

	Default lItems := .F.

	cBranch        := ""
  	cFilter        := ""
	nPage          := 1
	nPageSize      := 10

	jResponse := getNoAccessResponse()

	If canAccess("PIFA020")
		getPageAndPageSize(@nPage, @nPageSize)

		If (oRest:getQueryRequest():GetJsonText("branch") != "null")
			cBranch := oRest:getQueryRequest():GetJsonText("branch")
	  	EndIf

		If (oRest:getQueryRequest():GetJsonText("$filter") != "null")
       		cFilter := AllTrim(oRest:getQueryRequest():GetJsonText("$filter"))
      	EndIf

	    oService   := PurchaseOrdersSuggestedService():New()
        JResponse  := oService:getPurchaseOrdersLinked(cBranch, nPage, nPageSize, cFilter, lItems)
	EndIf

	answerRest(jResponse)

	FWFreeObj(oService)
	FreeObj(jResponse)
    
Return

//------------------------------------------------------------------------------
/*/ {Protheus.doc} getPurchaseOrdersLinkedItems
    Método que executa a chamada da API para retornar os items de pedidos de compra ja vinculados ao documento

    @type Method
    @author Squad PIF
    @return Nil
/*/
//------------------------------------------------------------------------------
Method getPurchaseOrdersLinkedItems() class PurchaseOrdersSuggestedController
	::getPurchaseOrdersLinked(.T.)
