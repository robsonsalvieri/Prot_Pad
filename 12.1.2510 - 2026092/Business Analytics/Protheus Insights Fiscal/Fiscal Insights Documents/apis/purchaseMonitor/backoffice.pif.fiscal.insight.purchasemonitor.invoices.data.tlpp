/* {Protheus.doc} getInvoicesItems
    Método que busca os dados dos ítens das notas fiscais para serem disponibilizados pela API.

    @param nPage, Numeric, Número da página a ser retornada
    @param nPageSize, Numeric, Tamanho da página a ser retornada
    @param cFilter, character, Texto a ser usado na busca.
    @return nil
/*/
//------------------------------------------------------------------------------

Method getInvoicesItems(nPage as Numeric, nPageSize as Numeric, cFilter as Character) class PurchaseMonitorInvoicesData

    Local cWhere        As Character
    Local aArea         As Array
    Local aUrlFilter    As Array

    Default nPage     := 1
    Default nPageSize := 10

    aArea      := FWGetArea()
    cWhere     := " "
    aUrlFilter := {}

    AddMapFieldsInvoicesItems(self)
    ::setUseSpaces(.T.)
    ::setPage(nPage)
    ::setPageSize(nPageSize)
    ::SetQuery( getInvoicesItemsQuery() )
    cWhere += "  SDT.D_E_L_E_T_ = ' ' AND "
    cWhere += "  SDS.D_E_L_E_T_ = ' ' AND " 
    cWhere += "  CKO.D_E_L_E_T_ = ' ' "
    ::SetWhere(cWhere)
    ::SetOrder("SDT.DT_FILIAL,SDT.DT_DOC,SDT.DT_SERIE,SDT.DT_ITEM")

    if !Empty(cFilter)
        aUrlFilter := {{"FILTER", cFilter}}
        ::SetUrlFilter(aUrlFilter)
    endif
    If ::Execute()
        ::FillGetResponse()
    EndIf

    FWRestArea(aArea)
    FwFreeArray(aArea)
    FwFreeArray(aUrlFilter)

Return

//------------------------------------------------------------------------------
/*/{Protheus.doc} AddMapFieldsInvoicesItems
    Função que adiciona os campos mapeados para a consulta dos itens das notas 
    fiscais recebidas

    @author Squad PIF
    @version 1.0
    @param oSelf, object, Objeto - Objeto com herança da classe FWAdapterBaseV2
    @return Nil 
/*/
//------------------------------------------------------------------------------
Static Function AddMapFieldsInvoicesItems(oSelf as Object)

    oSelf:addMapFields('branch'            , "DT_FILIAL" , .T., .F., {"DT_FILIAL" ,"C",TamSX3('DT_FILIAL')[1], 0}, "") 
    oSelf:addMapFields('branchName'        , "M0_FILIAL" , .T., .F., {"M0_FILIAL" ,"C",30, 0 }, "")
    oSelf:addMapFields('invoiceNumber'     , "DT_DOC"    , .T., .T., {"DT_DOC"    ,"C",TamSX3('DT_DOC')[1], 0}, "")
    oSelf:addMapFields('serialNumber'      , "DT_SERIE"  , .T., .T., {"DT_SERIE"  ,"C",TamSX3('DT_SERIE')[1], 0}, "")
    oSelf:addMapFields('itemNumber'        , "DT_ITEM"   , .T., .T., {"DT_ITEM"   ,"N",TamSX3('DT_ITEM')[1], 0}, "")
    oSelf:addMapFields('supplierCode'      , "DT_FORNEC" , .T., .F., {"DT_FORNEC" ,"C",TamSX3('DT_FORNEC')[1],    0}, "")
    oSelf:addMapFields('supplierStore'     , "DT_LOJA"   , .T., .F., {"DT_LOJA"   ,"C",TamSX3('DT_LOJA')[1],    0}, "")
    oSelf:addMapFields('productCode'       , "DT_COD"    , .T., .F., {"DT_COD"    ,"C",TamSX3('DT_COD')[1], 0}, "")
    oSelf:addMapFields('productsSupCode'   , "DT_PRODFOR", .T., .F., {"DT_PRODFOR","C",TamSX3('DT_PRODFOR')[1], 0}, "")
    oSelf:addMapFields('productDescription', "DT_DESCFOR", .T., .F., {"DT_DESCFOR","C",TamSX3('DT_DESCFOR')[1], 0}, "")
    oSelf:addMapFields('measurementUnit'   , "DT_UM"     , .T., .F., {"DT_UM"     ,"C",TamSX3('DT_UM')[1], 0}, "")
    oSelf:addMapFields('quantity'          , "DT_QUANT"  , .T., .F., {"DT_QUANT"  ,"N",TamSX3('DT_QUANT')[1] ,TamSX3('DT_QUANT')[2]}, "")
    oSelf:addMapFields('unitPrice'         , "DT_VUNIT"  , .T., .F., {"DT_VUNIT"  ,"N",TamSX3('DT_VUNIT')[1] ,TamSX3('DT_VUNIT')[2]}, "")
    oSelf:addMapFields('totalPrice'        , "DT_TOTAL"  , .T., .F., {"DT_TOTAL"  ,"N",TamSX3('DT_TOTAL')[1],TamSX3('DT_TOTAL')[2]}, "")
    oSelf:addMapFields('poNumber'          , "DT_PEDIDO" , .T., .F., {"DT_PEDIDO" ,"C",TamSX3('DT_PEDIDO')[1], 0}, "")
    oSelf:addMapFields('poItem'            , "DT_ITEMPC" , .T., .F., {"DT_ITEMPC" ,"C",TamSX3('DT_ITEMPC')[1], 0}, "")

Return 

//------------------------------------------------------------------------------
/*/ {Protheus.doc} getInvoicesItemsQuery
    Função que gera a query SQL completa para consulta dos itens das notas fiscais 
    recebidas

    @author Squad PIF
    @version 1.0
    @return cQuery, character, String contendo a query  
/*/
//------------------------------------------------------------------------------    
Static Function getInvoicesItemsQuery()
    
    Local cQuery   As Character

    cQuery := " SELECT #QueryFields# "
    cQuery += " FROM " + RetSqlName("SDT") + " SDT "
    cQuery += " INNER JOIN " + RetSqlName("SDS") + " SDS "
	cQuery += "     ON	SDS.DS_FILIAL	= SDT.DT_FILIAL AND "
	cQuery += "     	SDS.DS_FORNEC	= SDT.DT_FORNEC AND "
	cQuery += "     	SDS.DS_LOJA		= SDT.DT_LOJA AND "
	cQuery += "     	SDS.DS_DOC		= SDT.DT_DOC  AND "
	cQuery += "     	SDS.DS_SERIE	= SDT.DT_SERIE "
    cQuery += " INNER JOIN " + RetSqlName("CKO") + " CKO "    
    cQuery += "     ON RTRIM(CKO.CKO_ARQUIV)	= RTRIM(SDS.DS_ARQUIVO) "
    cQuery += " INNER JOIN SYS_COMPANY SM0  " 
    cQuery += "     ON  SDT.DT_FILIAL = SM0.M0_CODFIL AND "
    cQuery += "     SM0.M0_CODIGO		= CKO.CKO_EMPPRO "
    cQuery += " WHERE #QueryWhere# "

Return cQuery

//------------------------------------------------------------------------------
/* {Protheus.doc} postInvoicesExportXml
    Método que busca o arquivo XML das notas fiscais do Monitor de Compras.

    @author Squad PIF
    @version 1.0
    @param JBody, Json , Arquivo Json com a lista de arquivos a serem exportados
    @return Json, Objeto Json com os arquivos em base64
/*/
//------------------------------------------------------------------------------

Method postInvoicesExportXml(jBody As Json) class PurchaseMonitorInvoicesData
    Local oDocument     := Nil           As Object
    Local jResponse     := Nil           As Json
    Local oExec         := Nil           As Object
    Local nX            := 0             As Numeric
    Local nParam        := 1             As Numeric
    Local cQuery        := ""            As Character
    Local cAlias        := ""            As Character
    Local cXmlRet       := ""            As Character

    cQuery := " SELECT CKO_ARQUIV "
    cQuery += " FROM " + RetSqlName("CKO") + " CKO "
    cQuery += " WHERE CKO.D_E_L_E_T_ = ? "
    cQuery += "   AND CKO.CKO_FILPRO = ? "
    cQuery += "   AND CKO.CKO_DOC    = ? "
    cQuery += "   AND CKO.CKO_SERIE  = ? "

    cQuery := ChangeQuery(cQuery)

    For nX := 1 to Len(jBody["documents"])
        oDocument := jBody["documents"][nX]
        nParam    := 1
        cXmlRet   := ""
        oExec := FwExecStatement():New(cQuery)
        oExec:SetString(nParam++, " ")
        oExec:SetString(nParam++, oDocument["branch"])
        oExec:SetString(nParam++, AllTrim(Str(Val(oDocument["document"]))))
        oExec:SetString(nParam++, oDocument["serie"])

        cAlias := oExec:OpenAlias()

        If !(cAlias)->(Eof())
            cXmlRet := GetAdvFVal("CKO", "CKO_XMLRET", (cAlias)->CKO_ARQUIV, 1)
        EndIf

        (cAlias)->(DbCloseArea())
        FWFreeObj(oExec)

        If !Empty(cXmlRet)
            oDocument["xmlfile"] := Encode64(cXmlRet)
            oDocument["status"]  := STR0172
        Else
            oDocument["xmlfile"] := ""
            oDocument["status"]  := STR0173
            oDocument["message"] := STR0174
        EndIf

    Next nX

    jResponse := getSuccessReponse(jBody)

Return jResponse

//------------------------------------------------------------------------------
/* {Protheus.doc} getSchedulesIndicators
    Método que responsável por obter as informações dos schedules indicadores
    
    @author Squad PIF
    @version 1.0
    @return jResponse, json, retorna o objeto json contendo os dados dos indicadores schedules
    @see https://tdn.totvs.com/pages/releaseview.action?pageId=908346692
/*/
//------------------------------------------------------------------------------
Method getSchedulesIndicators() class PurchaseMonitorInvoicesData
    Local jResponse          As Json
    Local oScheduleInfo      As Object
    Local lIsSmartSchedule   As Logical
    Local lIsOldtSchedule    As Logical
    Local lIsRunning         As Logical
    Local aEnvRunning        As Array
    Local aRoutines          As Array

    jResponse        := JsonObject():New()
    oScheduleInfo    := totvs.framework.schedule.information.ScheduleInformation():New()
    lIsSmartSchedule := oScheduleInfo:getSmartScheduleIsRunning()
    lIsOldtSchedule  := oScheduleInfo:getOldScheduleIsRunning()
    lIsRunning       := lIsSmartSchedule .Or. lIsOldtSchedule
    aEnvRunning      := oScheduleInfo:getEnvironmentsScheduleRunning(Iif(lIsOldtSchedule, 1, 2))
    aRoutines        := {"SCHEDIMPTRA", "SCHEDUPDTRA", "SCHEDCOMCOL"}

    jResponse["schedule"]                         := JsonObject():New()
    jResponse["schedule"]["isRunning"]            := lIsRunning
    jResponse["schedule"]["isSmartSchedule"]      := lIsSmartSchedule
    jResponse["schedule"]["environmentsRunning"]  := aEnvRunning
    jResponse["services"]                         := GetSchedulesStatusByRoutines(aRoutines)
    jResponse["message"]                          := Iif(lIsRunning, Nil, STR0177) // "Smart Schedule não configurado, habilite para utilizar essa funcionalidade."

    jResponse := getSuccessReponse(jResponse)

    FWFreeObj(oScheduleInfo)
    FwFreeArray(aRoutines)
    FwFreeArray(aEnvRunning)

Return jResponse


//------------------------------------------------------------------------------
/*/{Protheus.doc} GetSchedulesStatusByRoutines
    Função que retorna o status dos schedules das rotinas informadas.

    @type  Static Function
    @author Squad PIF
    @version 1.0
    @param aRoutines, Array, Array de character com os nomes das rotinas que irá retornar o status no schedule
    @return aRet, Array, Array com os status do
/*/
//------------------------------------------------------------------------------
Static Function GetSchedulesStatusByRoutines(aRoutines As Array) As Array
    Local aRet              As Array
    Local oScheduleInfo     As Object
    Local nX                As Numeric
    Local cRoutine          As Character
    Local jScheduleInfo     As Json
    Local aScheduleInfo     As Array
    Local cTaskID           As Character
    Local aLastExec         As Array
    Local cLastDayExec      As Character
    Local cLastTimeExec     As Character
    Local cStatus           As Character

    oScheduleInfo  := totvs.framework.schedule.information.ScheduleInformation():New()
    aRet           := {}

    For nX := 1 To Len(aRoutines)

        cRoutine      := aRoutines[nX]
        jScheduleInfo := JsonObject():New()
        aScheduleInfo := oScheduleInfo:getSchedulesByRoutine(cRoutine)

        jScheduleInfo["id"]            := cRoutine
        jScheduleInfo["status"]        := "2" // 1=Inicializado 2=Parado
        jScheduleInfo["lastDayExec"]   := ""
        jScheduleInfo["lastTimeExec"]  := ""

        If Len(aScheduleInfo) > 0
            cTaskID       := aScheduleInfo[1][1]["CID"]
            aLastExec     := LastExecSched(cTaskID)
            cLastDayExec  := aLastExec[1]
            cLastTimeExec := aLastExec[2]
            cStatus       := Iif(aScheduleInfo[1][1]:CSTATUS $ "1|3", "2", "1")

            jScheduleInfo["status"]        := cStatus
            jScheduleInfo["lastDayExec"]   := cLastDayExec
            jScheduleInfo["lastTimeExec"]  := cLastTimeExec
        EndIf

        aAdd(aRet, jScheduleInfo)
    Next


    FWFreeObj(oScheduleInfo)

Return aRet


//------------------------------------------------------------------------------
/*/{Protheus.doc} LastExecSched
	Retorna um array com a data e hora da ultima execução do JOB

	@type  Static Function
    @author Squad PIF
	@version 1.0
	@param cTaskID, Character, ID da Rotina que será verificada no Schedule
	@return aLastExec, Array, Array contendo data e hora da ultima execução
/*/
//------------------------------------------------------------------------------
Static Function LastExecSched(cTaskID As Character) As Array
	Local aLastExec    As Array
	Local cAlias       As Character
	Local cQuery	   As Character
	Local oExec	       As Object
    Local nParam	   As Numeric

	Default cTaskID := ""

    aLastExec := {"", ""}

    cQuery := " SELECT TSK_DIA, TSK_HORA "
    cQuery += " FROM SCHDTSK "
    cQuery += " WHERE "
    cQuery += 	" TSK_CODIGO = ? "
    cQuery += 	" AND TSK_STATUS <> ? "
    cQuery += 	" AND D_E_L_E_T_ = ? "
    cQuery += " ORDER BY R_E_C_N_O_ DESC "

    cQuery := ChangeQuery(cQuery)
    oExec  := FwExecStatement():New(cQuery)

    nParam := 1
	oExec:SetString(nParam++, cTaskID)
	oExec:SetString(nParam++, '0')
	oExec:SetString(nParam++, ' ')

	cAlias := oExec:OpenAlias()

	If (cAlias)->(!Eof())
        aLastExec[1] := Dtoc(Stod((cAlias)->TSK_DIA))
        aLastExec[2] := (cAlias)->TSK_HORA
	Endif

	(cAlias)->(DbCloseArea())

    FWFreeObj(oExec)

Return aLastExec

//------------------------------------------------------------------------------
/* {Protheus.doc} getParticipantName
    Busca o nome do cliente quando o tipo da nota for devolucao ou beneficiamento caso contrario busca o nome do fornecedor
    
    @author Squad PIF
    @version 1.0
    @return cName, character, Nome do cliente ou fornecedor dependendo do tipo da nota fiscal
/*/
//------------------------------------------------------------------------------
Static Function getParticipantName() As Character

    Local cQuery As Character

    cQuery := " CASE "
    cQuery += "   WHEN "
    cQuery += "     SDS.DS_TIPO IN ('D','B') OR (SDS.DS_TIPO = '5' AND SDS.DS_TPCOMPL = '03') "
    cQuery += "   THEN "
    cQuery += "     COALESCE(NULLIF(RTRIM(SA1.A1_NOME),''), CKO.CKO_NOMFOR) "
    cQuery += "   ELSE COALESCE(NULLIF(RTRIM(SA2.A2_NOME),''), CKO.CKO_NOMFOR) "
    cQuery += " END "

Return cQuery

//------------------------------------------------------------------------------
/* {Protheus.doc} getSchedulesExecutions
    Método que retorna os status e informações de execução das rotinas agendadas no schedule
    
    @author Squad PIF
    @version 1.0
    @return jResponse, Json, retorna o objeto json contendo os dados dos indicadores schedules
    @see https://tdn.totvs.com/pages/releaseview.action?pageId=908346692
/*/
//------------------------------------------------------------------------------
Method getSchedulesExecutions() class PurchaseMonitorInvoicesData
    Local jResponse       As Json
    Local aRoutines       As Array 
    Local oScheduleInfo	  As Object
    Local oExec	          As Object
    Local cAlias	      As Character
    Local cQuery	      As Character
    Local nParam	      As Numeric
    Local aItems          As Array
    Local cScheduleId     As Character
    Local cTaskId         As Character
    Local oSchdTask       As Object
    Local jExecution      As Json

    jResponse           := JsonObject():New()
    aItems              := {}
    jResponse["items"]  := aItems
    aRoutines           := {"SCHEDIMPTRA", "SCHEDUPDTRA", "SCHEDCOMCOL"}
    oScheduleInfo       := totvs.framework.schedule.information.ScheduleInformation():New()

    cQuery := " SELECT TSK_CODIGO, TSK_ITEM     " 
    cQuery += " FROM (     " 
    cQuery += "     SELECT      " 
    cQuery += "         TSK_CODIGO,     " 
    cQuery += "         TSK_ITEM,     " 
    cQuery += "         ROW_NUMBER() OVER (PARTITION BY TSK_ROTINA ORDER BY R_E_C_N_O_ DESC) AS RN     " 
    cQuery += "     FROM SCHDTSK     " 
    cQuery += "     WHERE      " 
    cQuery += "         TSK_ROTINA IN (?)      " 
    cQuery += "         AND D_E_L_E_T_ = ?    " 
    cQuery += " ) sub     " 
    cQuery += " WHERE RN <= 3     " 
    cQuery += " ORDER BY TSK_CODIGO, RN " 

    cQuery := ChangeQuery(cQuery)
    oExec  := FwExecStatement():New(cQuery)

    nParam := 1
    oExec:setIn(nParam++, aRoutines)
    oExec:SetString(nParam++, "")

    cAlias := oExec:OpenAlias()

    While (cAlias)->(!Eof())
        cScheduleId  := (cAlias)->TSK_CODIGO
        cTaskId      := (cAlias)->TSK_ITEM

        oSchdTask := oScheduleInfo:getTaskById(cScheduleId, cTaskId)

        If ValType(oSchdTask) == "O"
            jExecution                  := JsonObject():New()
            jExecution["service"]       := AllTrim(oSchdTask["CFUNCTION"])
            jExecution["status"]        := oSchdTask["CSTATUS"]
            jExecution["scheduleId"]    := cScheduleId
            jExecution["taskId"]        := cTaskId
            jExecution["environment"]   := AllTrim(oSchdTask:OFWBOENV:CENV)
            jExecution["company"]       := AllTrim(oSchdTask:OFWBOENV:CEMP)
            jExecution["branch"]        := AllTrim(oSchdTask:OFWBOENV:CFIL)
            jExecution["userId"]        := AllTrim(oSchdTask:CUSERID)
            jExecution["userName"]      := AllTrim(UsrRetName(oSchdTask:CUSERID))
            jExecution["execDate"]      := DToC(oSchdTask:DDATE)
            jExecution["execTime"]      := oSchdTask:CTIME

            aAdd(aItems, jExecution)
        EndIF

        (cAlias)->(DbSkip())
    End

    (cAlias)->(DbCloseArea())

    jResponse := getSuccessReponse(jResponse)

    FWFreeObj(oScheduleInfo)
    FWFreeObj(oExec)
    FwFreeArray(aRoutines)
    
Return jResponse


//------------------------------------------------------------------------------
/* {Protheus.doc} getDashboardInvoicesByStatus
    Metodo que consolida o volume de notas fiscais por status para o dashboard
    "Volume de NF por Status", utilizando a estrutura FWAdapterBaseV2.

    @author Squad PIF
    @version 1.0
    @param cFilter, character, Filtro opcional ($filter) a ser aplicado na consulta
    @return nil
*/
//------------------------------------------------------------------------------
Method getDashboardInvoicesByStatus(cFilter as Character) class PurchaseMonitorInvoicesData

	Local cWhere     As Character
	Local aArea      As Array
	Local aUrlFilter As Array

	Default cFilter := ""

	aArea      := FWGetArea()
	aUrlFilter := {}

	cWhere := " 1 = 1 "

	AddMapFieldsDashboardStatus(self)
	::setUseSpaces(.F.)
	::setPage(1)
	::setPageSize(10)
	::SetQuery( getDashboardStatusQuery() )
	::SetWhere(cWhere)
	::SetOrder("CODE")

	if !Empty(cFilter)
		aUrlFilter := {{"FILTER", cFilter}}
		::SetUrlFilter(aUrlFilter)
	endif

	If ::Execute()
		::FillGetResponse()
	EndIf

	FWRestArea(aArea)
	FwFreeArray(aArea)
	FwFreeArray(aUrlFilter)

Return

//------------------------------------------------------------------------------
/*/{Protheus.doc} AddMapFieldsDashboardStatus
    Funcao que adiciona os campos mapeados para a consulta consolidada de volume
    de notas fiscais por status.

    @author Squad PIF
    @version 1.0
    @param oSelf, object, Objeto com heranca da classe FWAdapterBaseV2
    @return Nil
/*/
//------------------------------------------------------------------------------
Static Function AddMapFieldsDashboardStatus(oSelf as Object)

	// Campos exportados no Json
	oSelf:addMapFields('code' , "CODE"  , .T., .T., {"CODE"  , "C", 1 , 0}, "")
	oSelf:addMapFields('value', "QTDDOC", .T., .T., {"QTDDOC", "N", 15, 0}, "")

	oSelf:addMapFields('branch'       , "BRANCH" , .F., .F., {"BRANCH" , "C", TamSX3('DS_FILIAL')[1], 0}, "")
	oSelf:addMapFields('referenceDate', "REFDATE", .F., .F., {"REFDATE", "C", 8, 0}, "")

Return

//------------------------------------------------------------------------------
/*/{Protheus.doc} getDashboardStatusQuery
    Funcao que gera a query SQL para consolidar o volume de documentos por status.

    @author Squad PIF
    @version 1.0
    @return character, String contendo a query
/*/
//------------------------------------------------------------------------------
Static Function getDashboardStatusQuery() As Character

	Local cQuery As Character

	cQuery := " SELECT #QueryFields# "
	cQuery += "   FROM ( "
	cQuery += "          SELECT BASE.STCODE  AS CODE, "
	cQuery += "                 COUNT(*)     AS QTDDOC, "
	cQuery += "                 MAX(BASE.BRANCH)  AS BRANCH, "
	cQuery += "                 MAX(BASE.REFDATE) AS REFDATE "
	cQuery += "            FROM ( "
	cQuery += "                   SELECT " + getStatusIntegration() + " AS STCODE, "
	cQuery += "                          COALESCE(NULLIF(RTRIM(SDS.DS_FILIAL),''), CKO.CKO_FILPRO) AS BRANCH, "
	cQuery += "                          COALESCE(NULLIF(RTRIM(SDS.DS_EMISSA),''), CKO.CKO_DT_IMP) AS REFDATE "
	cQuery += "                     FROM " + RetSqlName("CKO") + " CKO "
	cQuery += "                     LEFT JOIN " + RetSqlName("SDS") + " SDS "
	cQuery += "                       ON RTRIM(SDS.DS_ARQUIVO) = RTRIM(CKO.CKO_ARQUIV) "
	cQuery += "                      AND SDS.D_E_L_E_T_ = ' ' "
	cQuery += "                     INNER JOIN SYS_COMPANY SM0 "
	cQuery += "                       ON  CKO.CKO_EMPPRO = SM0.M0_CODIGO "
	cQuery += "                      AND CKO.CKO_FILPRO = SM0.M0_CODFIL "
	cQuery += "                      AND SM0.D_E_L_E_T_ = ' ' "
	cQuery += "                     LEFT JOIN " + RetSqlName("SF1") + " SF1 "
	cQuery += "                       ON " + FWJoinFilial("SDS", "SF1") + " "
	cQuery += "                      AND SDS.DS_DOC    = SF1.F1_DOC "
	cQuery += "                      AND SDS.DS_SERIE  = SF1.F1_SERIE "
	cQuery += "                      AND SDS.DS_FORNEC = SF1.F1_FORNECE "
	cQuery += "                      AND SDS.DS_LOJA   = SF1.F1_LOJA "
	cQuery += "                      AND SF1.D_E_L_E_T_ = ' ' "
	cQuery += "                    WHERE CKO.D_E_L_E_T_ = ' ' "
	cQuery += "                 ) BASE "
	cQuery += "           WHERE #QueryWhere# "
	cQuery += "           GROUP BY BASE.STCODE "
	cQuery += "         ) TMP "

Return cQuery


//------------------------------------------------------------------------------
/* {Protheus.doc} getDashboardInvoicesBySpecie
    Metodo que consolida o valor financeiro dos documentos por especie de documento
    fiscal (dashboard "Impacto por Especie de Documento"), utilizando FWAdapterBaseV2.

    @author Squad PIF
    @version 1.0
    @param cFilter, character, Filtro opcional ($filter) a ser aplicado na consulta
    @return nil
*/
//------------------------------------------------------------------------------
Method getDashboardInvoicesBySpecie(cFilter as Character) class PurchaseMonitorInvoicesData

	Local cWhere     As Character
	Local aArea      As Array
	Local aUrlFilter As Array

	Default cFilter := ""

	aArea      := FWGetArea()
	aUrlFilter := {}

	cWhere := " 1 = 1 "

	AddMapFieldsDashboardSpecie(self)
	::setUseSpaces(.F.)
	::setPage(1)
	::setPageSize(10)
	::SetQuery( getDashboardSpecieQuery() )
	::SetWhere(cWhere)
	::SetOrder("CODE")

	if !Empty(cFilter)
		aUrlFilter := {{"FILTER", cFilter}}
		::SetUrlFilter(aUrlFilter)
	endif

	If ::Execute()
		::FillGetResponse()
	EndIf

	FWRestArea(aArea)
	FwFreeArray(aArea)
	FwFreeArray(aUrlFilter)

Return

//------------------------------------------------------------------------------
/*/{Protheus.doc} AddMapFieldsDashboardSpecie
    Funcao que adiciona os campos mapeados para a consulta consolidada de impacto
    financeiro por especie de documento fiscal.

    @author Squad PIF
    @version 1.0
    @param oSelf, object, Objeto com heranca da classe FWAdapterBaseV2
    @return Nil
/*/
//------------------------------------------------------------------------------
Static Function AddMapFieldsDashboardSpecie(oSelf as Object)

	// Campos exportados no Json
	oSelf:addMapFields('code' , "CODE"  , .T., .T., {"CODE"  , "C", 6 , 0}, "")
	oSelf:addMapFields('value', "VLRTOT", .T., .T., {"VLRTOT", "N", 16, 2}, "")

	// Filtros fundidos (COALESCE SDS -> CKO), expostos no nivel TMP via MAX()
	oSelf:addMapFields('branch'       , "BRANCH" , .F., .F., {"BRANCH" , "C", TamSX3('CKO_FILPRO')[1], 0}, "")
	oSelf:addMapFields('referenceDate', "REFDATE", .F., .F., {"REFDATE", "C", 8, 0}, "")

Return

//------------------------------------------------------------------------------
/*/{Protheus.doc} getDashboardSpecieQuery
    Funcao que gera a query SQL para consolidar o impacto financeiro por especie.

    @author Squad PIF
    @version 1.0
    @return character, String contendo a query
/*/
//------------------------------------------------------------------------------
Static Function getDashboardSpecieQuery() As Character

	Local cQuery As Character

	cQuery := " SELECT #QueryFields# "
	cQuery += "   FROM ( "
	cQuery += "          SELECT BASE.CODE    AS CODE, "
	cQuery += "                 SUM(BASE.VLRTOT)  AS VLRTOT, "
	cQuery += "                 MAX(BASE.BRANCH)  AS BRANCH, "
	cQuery += "                 MAX(BASE.REFDATE) AS REFDATE "
	cQuery += "            FROM ( "
	cQuery += "                   SELECT CASE "
	cQuery += "                            WHEN CKO.CKO_CODEDI = '109' THEN 'NF-E' "
	cQuery += "                            WHEN CKO.CKO_CODEDI = '214' THEN 'CT-E' "
	cQuery += "                            WHEN CKO.CKO_CODEDI = '273' THEN 'CTE-OS' "
	cQuery += "                            WHEN CKO.CKO_CODEDI = '319' THEN 'NFS-E' "
	cQuery += "                            ELSE 'OUTROS' "
	cQuery += "                          END AS CODE, "
	cQuery += "                          COALESCE(SDS.DS_TOTAL, 0) AS VLRTOT, "
	cQuery += "                          COALESCE(NULLIF(RTRIM(SDS.DS_FILIAL),''), CKO.CKO_FILPRO) AS BRANCH, "
	cQuery += "                          COALESCE(NULLIF(RTRIM(SDS.DS_EMISSA),''), CKO.CKO_DT_IMP) AS REFDATE "
	cQuery += "                     FROM " + RetSqlName("CKO") + " CKO "
	cQuery += "                     LEFT JOIN " + RetSqlName("SDS") + " SDS "
	cQuery += "                       ON RTRIM(SDS.DS_ARQUIVO) = RTRIM(CKO.CKO_ARQUIV) "
	cQuery += "                      AND SDS.D_E_L_E_T_ = ' ' "
	cQuery += "                     INNER JOIN SYS_COMPANY SM0 "
	cQuery += "                       ON  CKO.CKO_EMPPRO = SM0.M0_CODIGO "
	cQuery += "                      AND CKO.CKO_FILPRO = SM0.M0_CODFIL "
	cQuery += "                      AND SM0.D_E_L_E_T_ = ' ' "
	cQuery += "                     LEFT JOIN " + RetSqlName("SF1") + " SF1 "
	cQuery += "                       ON " + FWJoinFilial("SDS", "SF1") + " "
	cQuery += "                      AND SDS.DS_DOC    = SF1.F1_DOC "
	cQuery += "                      AND SDS.DS_SERIE  = SF1.F1_SERIE "
	cQuery += "                      AND SDS.DS_FORNEC = SF1.F1_FORNECE "
	cQuery += "                      AND SDS.DS_LOJA   = SF1.F1_LOJA "
	cQuery += "                      AND SF1.D_E_L_E_T_ = ' ' "
	cQuery += "                    WHERE CKO.D_E_L_E_T_ = ' ' "
	cQuery += "                      AND CKO.CKO_CODEDI IN ('109','214','273','319') "
	cQuery += "                      AND (NULLIF(RTRIM(CKO.CKO_CODERR),'') IS NULL OR RTRIM(CKO.CKO_CODERR) NOT IN ('COM055','COM056')) "
	cQuery += "                 ) BASE "
	cQuery += "           WHERE #QueryWhere# "
	cQuery += "           GROUP BY BASE.CODE "
	cQuery += "         ) TMP "

Return cQuery


//------------------------------------------------------------------------------
/* {Protheus.doc} getDashboardTaxComparison
    Metodo que consolida os valores dos tributos de UM UNICO documento fiscal para
    o dashboard "Comparativo de Tributos".

    @author Squad PIF
    @version 1.0
    @param cFilter, character, Filtro ($filter) que identifica o documento
    @return nil
*/
//------------------------------------------------------------------------------
Method getDashboardTaxComparison(cFilter as Character) class PurchaseMonitorInvoicesData

	Local cWhere     As Character
	Local aArea      As Array
	Local aUrlFilter As Array
	Local lHasDKM    As Logical

	Default cFilter := ""

	lHasDKM    := FwAliasInDic("DKM") .And. ChkFile("DKM")

	aArea      := FWGetArea()
	aUrlFilter := {}

	cWhere := " 1 = 1 "

	AddMapFieldsTaxComparison(self, lHasDKM)
	::setUseSpaces(.F.)
	::setPage(1)
	::setPageSize(10)
	::SetQuery( getTaxComparisonQuery(lHasDKM) )
	::SetWhere(cWhere)
	::SetOrder("XMLICMS")

	if !Empty(cFilter)
		aUrlFilter := {{"FILTER", cFilter}}
		::SetUrlFilter(aUrlFilter)
	endif

	If ::Execute()
		::FillGetResponse()
	EndIf

	FWRestArea(aArea)
	FwFreeArray(aArea)
	FwFreeArray(aUrlFilter)

Return

//------------------------------------------------------------------------------
/*/{Protheus.doc} AddMapFieldsTaxComparison
    Funcao que adiciona os campos mapeados para a consulta do comparativo de
    tributos de um documento fiscal.

    @author Squad PIF
    @version 1.0
    @param oSelf, object, Objeto com heranca da classe FWAdapterBaseV2
    @param lHasDKM, logical, Indica se a tabela DKM (IBS/CBS) existe no dicionario
    @return Nil
/*/
//------------------------------------------------------------------------------
Static Function AddMapFieldsTaxComparison(oSelf as Object, lHasDKM as Logical)

	Default lHasDKM := .F.

	// Valores dos tributos exportados no Json (XML x ERP/TES)
	oSelf:addMapFields('xmlicms'  , "XMLICMS"  , .T., .T., {"XMLICMS"  , "N", 16, 2}, "")
	oSelf:addMapFields('erpicms'  , "ERPICMS"  , .T., .T., {"ERPICMS"  , "N", 16, 2}, "")
	oSelf:addMapFields('xmlicmsst', "XMLICMSST", .T., .T., {"XMLICMSST", "N", 16, 2}, "")
	oSelf:addMapFields('erpicmsst', "ERPICMSST", .T., .T., {"ERPICMSST", "N", 16, 2}, "")
	oSelf:addMapFields('xmlipi'   , "XMLIPI"   , .T., .T., {"XMLIPI"   , "N", 16, 2}, "")
	oSelf:addMapFields('erpipi'   , "ERPIPI"   , .T., .T., {"ERPIPI"   , "N", 16, 2}, "")
	oSelf:addMapFields('xmlpis'   , "XMLPIS"   , .T., .T., {"XMLPIS"   , "N", 16, 2}, "")
	oSelf:addMapFields('erppis'   , "ERPPIS"   , .T., .T., {"ERPPIS"   , "N", 16, 2}, "")
	oSelf:addMapFields('xmlcofins', "XMLCOFINS", .T., .T., {"XMLCOFINS", "N", 16, 2}, "")
	oSelf:addMapFields('erpcofins', "ERPCOFINS", .T., .T., {"ERPCOFINS", "N", 16, 2}, "")
	oSelf:addMapFields('xmliss'   , "XMLISS"   , .T., .T., {"XMLISS"   , "N", 16, 2}, "")
	oSelf:addMapFields('erpiss'   , "ERPISS"   , .T., .T., {"ERPISS"   , "N", 16, 2}, "")

	// Tributos da reforma tributaria (DKM): IBS = IBSUF + IBSMUN, CBS
	If lHasDKM
		oSelf:addMapFields('xmlibs', "XMLIBS", .T., .T., {"XMLIBS", "N", 16, 2}, "")
		oSelf:addMapFields('erpibs', "ERPIBS", .T., .T., {"ERPIBS", "N", 16, 2}, "")
		oSelf:addMapFields('xmlcbs', "XMLCBS", .T., .T., {"XMLCBS", "N", 16, 2}, "")
		oSelf:addMapFields('erpcbs', "ERPCBS", .T., .T., {"ERPCBS", "N", 16, 2}, "")
	EndIf

	// Identificacao do documento - apenas para filtro ($filter), nao exportados
	oSelf:addMapFields('branch'        , "BRANCH"  , .F., .F., {"BRANCH"  , "C", TamSX3('DT_FILIAL')[1], 0}, "")
	oSelf:addMapFields('invoiceNumber' , "INVNUM"  , .F., .F., {"INVNUM"  , "C", TamSX3('DT_DOC')[1]   , 0}, "")
	oSelf:addMapFields('serialNumber'  , "INVSERIE", .F., .F., {"INVSERIE", "C", TamSX3('DT_SERIE')[1] , 0}, "")
	oSelf:addMapFields('supplierCode'  , "SUPPLIER", .F., .F., {"SUPPLIER", "C", TamSX3('DT_FORNEC')[1], 0}, "")
	oSelf:addMapFields('supplierStore' , "STORE"   , .F., .F., {"STORE"   , "C", TamSX3('DT_LOJA')[1]  , 0}, "")
	oSelf:addMapFields('documentType'  , "DOCTYPE" , .F., .F., {"DOCTYPE" , "C", TamSX3('DS_TIPO')[1]  , 0}, "")

Return

//------------------------------------------------------------------------------
/*/{Protheus.doc} getTaxComparisonQuery
    Funcao que gera a query SQL do comparativo de tributos de um documento.

    @author Squad PIF
    @version 1.0
    @param lHasDKM, logical, Indica se a tabela DKM (IBS/CBS) existe no dicionario
    @return character, String contendo a query
/*/
//------------------------------------------------------------------------------
Static Function getTaxComparisonQuery(lHasDKM as Logical) As Character

	Local cQuery As Character

	Default lHasDKM := .F.

	cQuery := " SELECT #QueryFields# "
	cQuery += "   FROM ( "
	cQuery += "          SELECT SUM(BASE.XMLICMS)   AS XMLICMS, "
	cQuery += "                 SUM(BASE.ERPICMS)   AS ERPICMS, "
	cQuery += "                 SUM(BASE.XMLICMSST) AS XMLICMSST, "
	cQuery += "                 SUM(BASE.ERPICMSST) AS ERPICMSST, "
	cQuery += "                 SUM(BASE.XMLIPI)    AS XMLIPI, "
	cQuery += "                 SUM(BASE.ERPIPI)    AS ERPIPI, "
	cQuery += "                 SUM(BASE.XMLPIS)    AS XMLPIS, "
	cQuery += "                 SUM(BASE.ERPPIS)    AS ERPPIS, "
	cQuery += "                 SUM(BASE.XMLCOFINS) AS XMLCOFINS, "
	cQuery += "                 SUM(BASE.ERPCOFINS) AS ERPCOFINS, "
	cQuery += "                 SUM(BASE.XMLISS)    AS XMLISS, "
	cQuery += "                 SUM(BASE.ERPISS)    AS ERPISS, "
	cQuery += "                 MAX(BASE.BRANCH)    AS BRANCH, "
	cQuery += "                 MAX(BASE.INVNUM)    AS INVNUM, "
	cQuery += "                 MAX(BASE.INVSERIE)  AS INVSERIE, "
	cQuery += "                 MAX(BASE.SUPPLIER)  AS SUPPLIER, "
	cQuery += "                 MAX(BASE.STORE)     AS STORE, "
	cQuery += "                 MAX(BASE.DOCTYPE)   AS DOCTYPE "

	// IBS/CBS ja vem totalizados por documento na subquery da DKM, por isso MAX()
	If lHasDKM
		cQuery += "                ,MAX(BASE.XMLIBS) AS XMLIBS "
		cQuery += "                ,MAX(BASE.ERPIBS) AS ERPIBS "
		cQuery += "                ,MAX(BASE.XMLCBS) AS XMLCBS "
		cQuery += "                ,MAX(BASE.ERPCBS) AS ERPCBS "
	EndIf

	cQuery += "            FROM ( "
	cQuery += "                   SELECT COALESCE(SDT.DT_XMLICM ,0) AS XMLICMS, "
	cQuery += "                          COALESCE(SDT.DT_TESICM ,0) AS ERPICMS, "
	cQuery += "                          COALESCE(SDT.DT_XMLICST,0) AS XMLICMSST, "
	cQuery += "                          COALESCE(SDT.DT_TESICST,0) AS ERPICMSST, "
	cQuery += "                          COALESCE(SDT.DT_XMLIPI ,0) AS XMLIPI, "
	cQuery += "                          COALESCE(SDT.DT_TESIPI ,0) AS ERPIPI, "
	cQuery += "                          COALESCE(SDT.DT_XMLPIS ,0) AS XMLPIS, "
	cQuery += "                          COALESCE(SDT.DT_TESPIS ,0) AS ERPPIS, "
	cQuery += "                          COALESCE(SDT.DT_XMLCOF ,0) AS XMLCOFINS, "
	cQuery += "                          COALESCE(SDT.DT_TESCOF ,0) AS ERPCOFINS, "
	cQuery += "                          COALESCE(SDT.DT_XMLISS ,0) AS XMLISS, "
	cQuery += "                          COALESCE(SDT.DT_TESISS ,0) AS ERPISS, "
	cQuery += "                          SDT.DT_FILIAL AS BRANCH, "
	cQuery += "                          SDT.DT_DOC    AS INVNUM, "
	cQuery += "                          SDT.DT_SERIE  AS INVSERIE, "
	cQuery += "                          SDT.DT_FORNEC AS SUPPLIER, "
	cQuery += "                          SDT.DT_LOJA   AS STORE, "
	cQuery += "                          SDS.DS_TIPO   AS DOCTYPE "

	If lHasDKM
		cQuery += "                         ,COALESCE(DKM.XMLIBS,0) AS XMLIBS "
		cQuery += "                         ,COALESCE(DKM.ERPIBS,0) AS ERPIBS "
		cQuery += "                         ,COALESCE(DKM.XMLCBS,0) AS XMLCBS "
		cQuery += "                         ,COALESCE(DKM.ERPCBS,0) AS ERPCBS "
	EndIf

	cQuery += "                     FROM " + RetSqlName("SDT") + " SDT "
	cQuery += "                     INNER JOIN " + RetSqlName("SDS") + " SDS "
	cQuery += "                       ON  SDS.DS_FILIAL = SDT.DT_FILIAL "
	cQuery += "                      AND SDS.DS_FORNEC = SDT.DT_FORNEC "
	cQuery += "                      AND SDS.DS_LOJA   = SDT.DT_LOJA "
	cQuery += "                      AND SDS.DS_DOC    = SDT.DT_DOC "
	cQuery += "                      AND SDS.DS_SERIE  = SDT.DT_SERIE "
	cQuery += "                      AND SDS.D_E_L_E_T_ = ' ' "
	cQuery += "                     INNER JOIN " + RetSqlName("CKO") + " CKO "
	cQuery += "                       ON  RTRIM(CKO.CKO_ARQUIV) = RTRIM(SDS.DS_ARQUIVO) "
	cQuery += "                      AND CKO.D_E_L_E_T_ = ' ' "
	cQuery += "                     INNER JOIN SYS_COMPANY SM0 "
	cQuery += "                       ON  CKO.CKO_EMPPRO = SM0.M0_CODIGO "
	cQuery += "                      AND CKO.CKO_FILPRO = SM0.M0_CODFIL "
	cQuery += "                      AND SM0.D_E_L_E_T_ = ' ' "

	If lHasDKM
		cQuery += getTaxReformJoin()
	EndIf

	cQuery += "                    WHERE SDT.D_E_L_E_T_ = ' ' "
	cQuery += "                 ) BASE "
	cQuery += "           WHERE #QueryWhere# "
	cQuery += "         ) TMP "

Return cQuery

//------------------------------------------------------------------------------
/*/{Protheus.doc} getTaxReformJoin
    Funcao que gera o LEFT JOIN com a DKM (tributos da reforma tributaria) para
    obter os valores de IBS e CBS do documento.

    @author Squad PIF
    @version 1.0
    @return character, String contendo o trecho do JOIN
/*/
//------------------------------------------------------------------------------
Static Function getTaxReformJoin() As Character

	Local cJoin As Character

	cJoin := "                     LEFT JOIN ( "
	cJoin += "                            SELECT DKM_FILIAL, "
	cJoin += "                                   DKM_DOC, "
	cJoin += "                                   DKM_SERIE, "
	cJoin += "                                   DKM_FORNEC, "
	cJoin += "                                   DKM_LOJA, "
	cJoin += "                                   DKM_ESPECI, "
	cJoin += "                                   SUM(CASE WHEN UPPER(RTRIM(DKM_TRIB)) IN ('IBSUF','IBSMUN') THEN COALESCE(DKM_XMLVLR,0) ELSE 0 END) AS XMLIBS, "
	cJoin += "                                   SUM(CASE WHEN UPPER(RTRIM(DKM_TRIB)) IN ('IBSUF','IBSMUN') THEN COALESCE(DKM_VALOR ,0) ELSE 0 END) AS ERPIBS, "
	cJoin += "                                   SUM(CASE WHEN UPPER(RTRIM(DKM_TRIB)) = 'CBS' THEN COALESCE(DKM_XMLVLR,0) ELSE 0 END) AS XMLCBS, "
	cJoin += "                                   SUM(CASE WHEN UPPER(RTRIM(DKM_TRIB)) = 'CBS' THEN COALESCE(DKM_VALOR ,0) ELSE 0 END) AS ERPCBS "
	cJoin += "                              FROM " + RetSqlName("DKM") + " "
	cJoin += "                             WHERE D_E_L_E_T_ = ' ' "
	cJoin += "                             GROUP BY DKM_FILIAL, DKM_DOC, DKM_SERIE, DKM_FORNEC, DKM_LOJA, DKM_ESPECI "
	cJoin += "                          ) DKM "
	cJoin += "                       ON  " + FWJoinFilial("DKM", "SDS") + " "
	cJoin += "                      AND DKM.DKM_DOC    = SDS.DS_DOC "
	cJoin += "                      AND DKM.DKM_SERIE  = SDS.DS_SERIE "
	cJoin += "                      AND DKM.DKM_FORNEC = SDS.DS_FORNEC "
	cJoin += "                      AND DKM.DKM_LOJA   = SDS.DS_LOJA "
	cJoin += "                      AND DKM.DKM_ESPECI = SDS.DS_ESPECI "

Return cJoin


//------------------------------------------------------------------------------
/* {Protheus.doc} getDashboardPendingClassification
    Metodo que consulta os documentos fiscais pendentes de classificacao ha mais tempo,
    considerando documentos no Monitor (SDS/SDT) sem classificacao ou em Pre-Nota
    (SF1/SD1 com F1_STATUS = ' '), excluindo documentos classificados, cancelados
    e rejeitados.

    Cada documento e retornado apenas uma vez (consulta por cabecalho), ordenado
    por quantidade de dias sem classificacao (mais antigos primeiro).

    @author Squad PIF
    @since 26/08/2026
    @version 1.0
    @param nPage, Numeric, Numero da pagina a ser retornada
    @param nPageSize, Numeric, Tamanho da pagina a ser retornada
    @param cFilter, character, Filtro opcional ($filter) a ser aplicado
    @return Nil,
*/
//------------------------------------------------------------------------------
Method getDashboardPendingClassification(nPage as Numeric, nPageSize as Numeric, cFilter as Character) class PurchaseMonitorInvoicesData

    Local cWhere     As Character
    Local aArea      As Array
    Local aUrlFilter As Array

    Default nPage     := 1
    Default nPageSize := 10
    Default cFilter   := ""

    aArea      := FWGetArea()
    aUrlFilter := {}

    cWhere := " 1 = 1 "

    AddMapFieldsPendingClassification(self)
    ::setUseSpaces(.F.)
    ::setPage(nPage)
    ::setPageSize(nPageSize)
    ::SetQuery( getPendingClassificationQuery() )
    ::SetWhere(cWhere)
    ::SetOrder("DAYSPENDING DESC, DOCKEY")

    if !Empty(cFilter)
        aUrlFilter := {{"FILTER", cFilter}}
        ::SetUrlFilter(aUrlFilter)
    endif

    If ::Execute()
        ::FillGetResponse()
    EndIf

    FWRestArea(aArea)
    FwFreeArray(aArea)
    FwFreeArray(aUrlFilter)

Return

//------------------------------------------------------------------------------
/*/{Protheus.doc} AddMapFieldsPendingClassification
    Funcao que adiciona os campos mapeados para a consulta de documentos
    pendentes de classificacao.

    @author Squad PIF
    @version 1.0
    @param oSelf, object, Objeto com heranca da classe FWAdapterBaseV2
    @return Nil
/*/
//------------------------------------------------------------------------------
Static Function AddMapFieldsPendingClassification(oSelf as Object)

    Local nTamFilial  := TamSX3('DS_FILIAL')[1]
    Local nTamChave   := TamSX3('CKO_CHVDOC')[1]
    Local nTamDoc     := TamSX3('DS_DOC')[1]
    Local nTamSerie   := TamSX3('DS_SERIE')[1]
    Local nTamFornec  := TamSX3('DS_FORNEC')[1]
    Local nTamLoja    := TamSX3('DS_LOJA')[1]
    Local nTamNome    := TamSX3('A2_NOME')[1]
    Local nTamTotal   := TamSX3('DS_TOTAL')[1]
    Local nDecTotal   := TamSX3('DS_TOTAL')[2]

    // Campos exportados no Json
    oSelf:addMapFields('branch'           , "BRANCH"         , .T., .F., {"BRANCH"         , "C", nTamFilial, 0}, "")
    oSelf:addMapFields('documentKey'      , "DOCKEY"         , .T., .T., {"DOCKEY"         , "C", nTamChave , 0}, "")
    oSelf:addMapFields('invoiceNumber'    , "INVNUM"         , .T., .T., {"INVNUM"         , "C", nTamDoc   , 0}, "")
    oSelf:addMapFields('serialNumber'     , "SERNUM"         , .T., .T., {"SERNUM"         , "C", nTamSerie , 0}, "")
    oSelf:addMapFields('specie'           , "SPECIE"         , .T., .T., {"SPECIE"         , "C", 8 , 0}, "")
    oSelf:addMapFields('supplierCode'     , "SUPPCODE"       , .T., .F., {"SUPPCODE"       , "C", nTamFornec, 0}, "")
    oSelf:addMapFields('supplierStore'    , "SUPPSTORE"      , .T., .F., {"SUPPSTORE"      , "C", nTamLoja  , 0}, "")
    oSelf:addMapFields('supplierName'     , "SUPPNAME"       , .T., .F., {"SUPPNAME"       , "C", nTamNome  , 0}, "")
    oSelf:addMapFields('documentDate'     , "DOCDATE"        , .T., .F., {"DOCDATE"        , "C", 8 , 0}, "")
    oSelf:addMapFields('integrationDate'  , "INTDATE"        , .T., .F., {"INTDATE"        , "C", 8 , 0}, "")
    oSelf:addMapFields('dayspending'      , "DAYSPENDING"    , .T., .T., {"DAYSPENDING"    , "N", 10, 0}, "")
    oSelf:addMapFields('totalValue'       , "TOTVAL"         , .T., .F., {"TOTVAL"         , "N", nTamTotal , nDecTotal}, "")
    oSelf:addMapFields('statusInvoice'    , "STATUSINV"      , .T., .F., {"STATUSINV"      , "C", 1, 0}, "")
    oSelf:addMapFields('statusIntegration', "STATUSINT"      , .T., .F., {"STATUSINT"      , "C", 1, 0}, "")
    oSelf:addMapFields('supplier'         , "SUPPFILTER"     , .F., .F., {"SUPPFILTER"     , "C", nTamFornec, 0}, "")

Return

//------------------------------------------------------------------------------
/* {Protheus.doc} DATEDIFFDAY
    Funcao que gera o calculo cross-database de diferenca de dias entre uma data
    (no formato YYYYMMDD) e a data atual, adaptando-se ao SGBD em uso.

    @author Squad PIF
    @version 1.0
    @param cDateField, character, Nome do campo de data no formato YYYYMMDD
    @return character, String contendo o calculo SQL para diferenca em dias
/*/
//------------------------------------------------------------------------------
Static Function DATEDIFFDAY(cDateField as Character) As Character

    Local cRet     As Character
    Local cDBType  As Character

    cDBType := Upper(AllTrim(TCGetDB()))

    cRet := Iif(cDBType $ "MSSQL|MSSQL7", ;
                " DATEDIFF(DAY, CONVERT(DATE, COALESCE(" + cDateField + ",'19000101'), 112), GETDATE()) ", ;
                Iif(cDBType $ "ORACLE", ;
                    " TRUNC(SYSDATE) - TO_DATE(COALESCE(" + cDateField + ",'19000101'), 'YYYYMMDD') ", ;
                    " CURRENT_DATE - TO_DATE(COALESCE(" + cDateField + ",'19000101'), 'YYYYMMDD') "))

Return cRet

//------------------------------------------------------------------------------
/*/{Protheus.doc} getPendingClassificationQuery
    Funcao que gera a query SQL para consultar os documentos pendentes de classificacao,
    consolidando documentos do Monitor (SDS/SDT) e Pre-Notas (SF1/SD1 com F1_STATUS = ' '),
    e excluindo documentos ja classificados (F1_STATUS = 'A'), cancelados (COM055) e
    rejeitados (COM056).

    A query retorna apenas o cabecalho (uma linha por documento), calculando os dias
    pendentes como diferenca entre a data atual e a data de emissao. A ordenacao
    (mais antigos primeiro) e aplicada pelo metodo chamador via ::SetOrder().

    @important Documentos ainda sem registro na SDS (estagio CKO-only) sao mantidos
        pelo LEFT JOIN. Nesses casos SDS.DS_FORNEC e SDS.DS_LOJA sao NULL, por isso
        SUPPCODE, SUPPSTORE e SUPPFILTER usam COALESCE com ' ' (espaco) em vez de ''.
        Em Oracle a string vazia equivale a NULL, o que anularia o COALESCE; o espaco
        e a representacao de campo character vazio no padrao Protheus e funciona em
        MSSQL, Oracle e PostgreSQL.

    @author Squad PIF
    @version 1.0
    @return character, String contendo a query
/*/
//------------------------------------------------------------------------------
Static Function getPendingClassificationQuery() As Character

    Local cQuery      As Character
    Local cSpecieCase As Character
    Local cDaysCalc   As Character

    cSpecieCase := getinvoiceType()

    cDaysCalc := " CASE "
    cDaysCalc += "   WHEN NULLIF(RTRIM(SDS.DS_EMISSA),'') IS NOT NULL "
    cDaysCalc += "     THEN " + DATEDIFFDAY("SDS.DS_EMISSA") + " "
    cDaysCalc += "   WHEN NULLIF(RTRIM(CKO.CKO_DT_IMP),'') IS NOT NULL "
    cDaysCalc += "     THEN " + DATEDIFFDAY("CKO.CKO_DT_IMP") + " "
    cDaysCalc += "   ELSE 0 "
    cDaysCalc += " END "

    cQuery := " SELECT #QueryFields# "
    cQuery += "   FROM ( "
    cQuery += "          SELECT "
    cQuery += "                 CKO.CKO_CHVDOC                                          AS DOCKEY, "
    cQuery += "                 CASE WHEN NULLIF(RTRIM(SDS.DS_DOC),'') IS NOT NULL "
    cQuery += "                      THEN SDS.DS_DOC "
    cQuery += "                      ELSE CKO.CKO_DOC END                                AS INVNUM, "
    cQuery += "                 CASE WHEN NULLIF(RTRIM(SDS.DS_SERIE),'') IS NOT NULL "
    cQuery += "                      THEN SDS.DS_SERIE "
    cQuery += "                      ELSE CKO.CKO_SERIE END                              AS SERNUM, "
    cQuery += "                 " + cSpecieCase + "                                     AS SPECIE, "
    cQuery += "                 COALESCE(SDS.DS_FORNEC, ' ')                            AS SUPPCODE, "
    cQuery += "                 COALESCE(SDS.DS_LOJA  , ' ')                            AS SUPPSTORE, "
    cQuery += "                 CASE WHEN NULLIF(RTRIM(SA2.A2_NOME),'') IS NOT NULL "
    cQuery += "                      THEN SA2.A2_NOME "
    cQuery += "                      ELSE CKO.CKO_NOMFOR END                             AS SUPPNAME, "
    cQuery += "                 CASE WHEN NULLIF(RTRIM(SDS.DS_EMISSA),'') IS NOT NULL "
    cQuery += "                      THEN SDS.DS_EMISSA "
    cQuery += "                      ELSE CKO.CKO_DT_IMP END                             AS DOCDATE, "
    cQuery += "                 CASE WHEN CKO.CKO_DT_IMP IS NOT NULL "
    cQuery += "                      THEN CKO.CKO_DT_IMP "
    cQuery += "                      ELSE SDS.DS_EMISSA END                              AS INTDATE, "
    cQuery += "                 CASE WHEN SDS.DS_TOTAL IS NOT NULL THEN SDS.DS_TOTAL ELSE 0 END AS TOTVAL, "
    cQuery += "                 " + getStatusInvoice() + "                              AS STATUSINV, "
    cQuery += "                 " + getStatusIntegration() + "                          AS STATUSINT, "
    cQuery += "                 CASE WHEN NULLIF(RTRIM(SDS.DS_FILIAL),'') IS NOT NULL "
    cQuery += "                      THEN SDS.DS_FILIAL "
    cQuery += "                      ELSE CKO.CKO_FILPRO END                             AS BRANCH, "
    cQuery += "                 " + cDaysCalc + "                                       AS DAYSPENDING, "
    cQuery += "                 COALESCE(SDS.DS_FORNEC, ' ')                            AS SUPPFILTER "
    cQuery += "            FROM " + RetSqlName("CKO") + " CKO "
    cQuery += "            LEFT JOIN " + RetSqlName("SDS") + " SDS "
    cQuery += "              ON RTRIM(SDS.DS_ARQUIVO) = RTRIM(CKO.CKO_ARQUIV) "
    cQuery += "             AND SDS.D_E_L_E_T_ = ' ' "
    cQuery += "            LEFT JOIN " + RetSqlName("SA2") + " SA2 "
    cQuery += "              ON " + FWJoinFilial("SA2", "SDS") + " "
    cQuery += "             AND SA2.A2_COD  = SDS.DS_FORNEC "
    cQuery += "             AND SA2.A2_LOJA = SDS.DS_LOJA "
    cQuery += "             AND SA2.A2_MSBLQL <> '1' "
    cQuery += "             AND SA2.D_E_L_E_T_ = ' ' "
    cQuery += "            INNER JOIN SYS_COMPANY SM0 "
    cQuery += "              ON  CKO.CKO_EMPPRO = SM0.M0_CODIGO "
    cQuery += "             AND CKO.CKO_FILPRO = SM0.M0_CODFIL "
    cQuery += "             AND SM0.D_E_L_E_T_ = ' ' "
    cQuery += "            LEFT JOIN " + RetSqlName("SF1") + " SF1 "
    cQuery += "              ON " + FWJoinFilial("SDS", "SF1") + " "
    cQuery += "             AND SDS.DS_DOC    = SF1.F1_DOC "
    cQuery += "             AND SDS.DS_SERIE  = SF1.F1_SERIE "
    cQuery += "             AND SDS.DS_FORNEC = SF1.F1_FORNECE "
    cQuery += "             AND SDS.DS_LOJA   = SF1.F1_LOJA "
    cQuery += "             AND SF1.D_E_L_E_T_ = ' ' "
    cQuery += "           WHERE CKO.D_E_L_E_T_ = ' ' "
    cQuery += "             AND CKO.CKO_CODEDI IN ('109','214','273','319') "
    cQuery += "             AND (NULLIF(RTRIM(CKO.CKO_CODERR),'') IS NULL OR RTRIM(CKO.CKO_CODERR) NOT IN ('COM055','COM056')) "
    cQuery += "             AND ( "
    cQuery += "                   (NULLIF(RTRIM(SDS.DS_DOC),'') IS NOT NULL AND NULLIF(RTRIM(SF1.F1_STATUS),'') IS NULL) "
    cQuery += "                   OR "
    cQuery += "                   (NULLIF(RTRIM(SDS.DS_DOC),'') IS NULL) "
    cQuery += "                 ) "
    cQuery += "             AND (NULLIF(RTRIM(SF1.F1_STATUS),'') IS NULL OR RTRIM(SF1.F1_STATUS) <> 'A') "
    cQuery += "        ) BASE "
    cQuery += "  WHERE #QueryWhere# "

Return cQuery

//------------------------------------------------------------------------------
/*/ {Protheus.doc} getDashboardPendingClassificationChart
    Metodo que prepara e executa a consulta agregada de documentos pendentes de
    classificacao agrupados por faixas de tempo (dashboard "Documentos ha Mais Tempo
    sem Classificacao" - Grafico).

    Retorna a quantidade de documentos agrupada nas 4 faixas fixas: ATE_10, 11_20,
    21_30, ACIMA_30.

    Reutiliza a mesma base de dados de getDashboardPendingClassification(), aplicando
    GROUP BY por faixas de dias calculadas com DATEDIFFDAY() cross-database.

    @author Squad PIF
    @since 02/09/2026
    @version 1.0
    @return Nil
/*/
//------------------------------------------------------------------------------
Method getDashboardPendingClassificationChart() class PurchaseMonitorInvoicesData

    Local cWhere        As Character
    Local aArea         As Array

    aArea      := FWGetArea()
    cWhere     := " 1 = 1 "

    AddMapFieldsPendingClassificationChart(self)
    ::setUseSpaces(.F.)
    ::setPage(1)
    ::setPageSize(999)
    ::SetQuery( getPendingClassificationChartQuery() )
    ::SetWhere(cWhere)
    ::SetOrder("")

    If ::Execute()
        ::FillGetResponse()
    EndIf

    FWRestArea(aArea)
    FwFreeArray(aArea)

Return


//------------------------------------------------------------------------------
/*/{Protheus.doc} AddMapFieldsPendingClassificationChart
    Funcao que adiciona os campos mapeados para a consulta agregada de documentos
    pendentes agrupados por faixas de tempo.

    @author Squad PIF
    @since 02/09/2026
    @version 1.0
    @param oSelf, object, Objeto com heranca da classe FWAdapterBaseV2
    @return Nil
/*/
//------------------------------------------------------------------------------
Static Function AddMapFieldsPendingClassificationChart(oSelf as Object)

    oSelf:addMapFields('range'    , "RANGE"   , .T., .F., {"RANGE"   , "C", 10, 0}, "")
    oSelf:addMapFields('quantity' , "QUANTITY", .T., .F., {"QUANTITY", "N", 10, 0}, "")

Return


//------------------------------------------------------------------------------
/*/{Protheus.doc} getPendingClassificationChartQuery
    Funcao que gera a query SQL agregada para agrupar documentos pendentes de
    classificacao por faixas de tempo (ATE_10, 11_20, 21_30, ACIMA_30).

    Reutiliza a mesma logica de getPendingClassificationQuery(), mas aplica GROUP BY
    nas faixas de dias calculadas com DATEDIFFDAY() cross-database (MSSQL, Oracle,
    PostgreSQL).

    O calculo de dias usa a data de emissao (SDS.DS_EMISSA) ou, quando indisponivel,
    a data de importacao (CKO.CKO_DT_IMP).

    @author Squad PIF
    @since 02/09/2026
    @version 1.0
    @return character, String contendo a query
/*/
//------------------------------------------------------------------------------
Static Function getPendingClassificationChartQuery() As Character

    Local cQuery      As Character
    Local cDaysCalc   As Character
    Local cFaixaCase  As Character

    // Calculo cross-database da diferenca de dias
    cDaysCalc := " CASE "
    cDaysCalc += "   WHEN NULLIF(RTRIM(SDS.DS_EMISSA),'') IS NOT NULL "
    cDaysCalc += "     THEN " + DATEDIFFDAY("SDS.DS_EMISSA") + " "
    cDaysCalc += "   WHEN NULLIF(RTRIM(CKO.CKO_DT_IMP),'') IS NOT NULL "
    cDaysCalc += "     THEN " + DATEDIFFDAY("CKO.CKO_DT_IMP") + " "
    cDaysCalc += "   ELSE 0 "
    cDaysCalc += " END "

    // CASE para classificar em faixas fixas
    cFaixaCase := " CASE "
    cFaixaCase += "   WHEN (" + cDaysCalc + ") <= 10 "
    cFaixaCase += "     THEN 'ATE_10' "
    cFaixaCase += "   WHEN (" + cDaysCalc + ") BETWEEN 11 AND 20 "
    cFaixaCase += "     THEN '11_20' "
    cFaixaCase += "   WHEN (" + cDaysCalc + ") BETWEEN 21 AND 30 "
    cFaixaCase += "     THEN '21_30' "
    cFaixaCase += "   ELSE 'ACIMA_30' "
    cFaixaCase += " END "

    cQuery := " SELECT #QueryFields# "
    cQuery += "   FROM ( "
    cQuery += "          SELECT " + cFaixaCase + " AS RANGE, "
    cQuery += "                 COUNT(*) AS QUANTITY "
    cQuery += "            FROM " + RetSqlName("CKO") + " CKO "
    cQuery += "            LEFT JOIN " + RetSqlName("SDS") + " SDS "
    cQuery += "              ON RTRIM(SDS.DS_ARQUIVO) = RTRIM(CKO.CKO_ARQUIV) "
    cQuery += "             AND SDS.D_E_L_E_T_ = ' ' "
    cQuery += "            LEFT JOIN " + RetSqlName("SA2") + " SA2 "
    cQuery += "              ON " + FWJoinFilial("SA2", "SDS") + " "
    cQuery += "             AND SA2.A2_COD  = SDS.DS_FORNEC "
    cQuery += "             AND SA2.A2_LOJA = SDS.DS_LOJA "
    cQuery += "             AND SA2.A2_MSBLQL <> '1' "
    cQuery += "             AND SA2.D_E_L_E_T_ = ' ' "
    cQuery += "            INNER JOIN SYS_COMPANY SM0 "
    cQuery += "              ON  CKO.CKO_EMPPRO = SM0.M0_CODIGO "
    cQuery += "             AND CKO.CKO_FILPRO = SM0.M0_CODFIL "
    cQuery += "             AND SM0.D_E_L_E_T_ = ' ' "
    cQuery += "            LEFT JOIN " + RetSqlName("SF1") + " SF1 "
    cQuery += "              ON " + FWJoinFilial("SDS", "SF1") + " "
    cQuery += "             AND SDS.DS_DOC    = SF1.F1_DOC "
    cQuery += "             AND SDS.DS_SERIE  = SF1.F1_SERIE "
    cQuery += "             AND SDS.DS_FORNEC = SF1.F1_FORNECE "
    cQuery += "             AND SDS.DS_LOJA   = SF1.F1_LOJA "
    cQuery += "             AND SF1.D_E_L_E_T_ = ' ' "
    cQuery += "           WHERE CKO.D_E_L_E_T_ = ' ' "
    cQuery += "             AND CKO.CKO_CODEDI IN ('109','214','273','319') "
    cQuery += "             AND (NULLIF(RTRIM(CKO.CKO_CODERR),'') IS NULL OR RTRIM(CKO.CKO_CODERR) NOT IN ('COM055','COM056')) "
    cQuery += "             AND ( "
    cQuery += "                   (NULLIF(RTRIM(SDS.DS_DOC),'') IS NOT NULL AND NULLIF(RTRIM(SF1.F1_STATUS),'') IS NULL) "
    cQuery += "                   OR "
    cQuery += "                   (NULLIF(RTRIM(SDS.DS_DOC),'') IS NULL) "
    cQuery += "                 ) "
    cQuery += "             AND (NULLIF(RTRIM(SF1.F1_STATUS),'') IS NULL OR RTRIM(SF1.F1_STATUS) <> 'A') "
    cQuery += "           GROUP BY " + cFaixaCase + " "
    cQuery += "        ) AGRUPADO "
    cQuery += "  WHERE #QueryWhere# "

Return cQuery
