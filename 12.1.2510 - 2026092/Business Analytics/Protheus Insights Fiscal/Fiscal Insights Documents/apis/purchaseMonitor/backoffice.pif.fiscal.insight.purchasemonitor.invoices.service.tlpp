//------------------------------------------------------------------------------
/*/ {Protheus.doc} getInvoicesList
	Método que prepara e executa a consulta da lista das notas fiscais com base nos parâmetros recebidos.

	@author Squad PIF
	@version 1.0
	@param nPage, Numeric, Número da página a ser retornada
	@param nPageSize, Numeric, Tamanho da página a ser retornada
	@param cFilter, character, Texto a ser usado na busca.
	@return Json, retorna o objeto json contendo os dados recebidos
/*/
//------------------------------------------------------------------------------    
Method getInvoicesList(nPage as Numeric, nPageSize as Numeric, cFilter as Character)  As Json Class PurchaseMonitorInvoicesService

	Local oInvoicesListData := PurchaseMonitorInvoicesData():New()  As Object
	Local oError            := ErrorClass():New()                   As Object
	Local jResponse         := JsonObject():New()                   As Json
	Local jInvoiceList      := JsonObject():New()                   As Json
	Local cResponse         := ""                                   As Character
	Local xDecode           := ""                                   As Character

	oInvoicesListData:getInvoicesList(nPage, nPageSize, cFilter)

	oError:genCode     := oInvoicesListData:getCode()
	oError:description := oInvoicesListData:getMessage()

	jResponse  := getBadRequestResponse({oError})

	If oInvoicesListData:lOk
		cResponse := oInvoicesListData:GetJSONResponse()
		xDecode   := DecodeUTF8(cResponse)

		If ValType(xDecode) == "C"
			cResponse := xDecode
		EndIf

		jInvoiceList:FromJson(cResponse)

        // Processa cada item da lista de notas fiscais, verificando erros e adicionando detalhes
		aEval(jInvoiceList["items"], {|jItem| ProcessInvoiceItem(jItem) })

		jResponse  := getSuccessReponse(jInvoiceList)
	EndIf

	oInvoicesListData:DeActivate()
	FWFreeObj(oInvoicesListData)

Return jResponse

//------------------------------------------------------------------------------
/*/ {Protheus.doc} ProcessInvoiceItem
	Método que processa cada item da nota fiscal, verificando erros e adicionando detalhes.

	@author Squad PIF
	@version 1.0
	@param jItem, json, Objeto JSON da nota fiscal atual
/*/
//------------------------------------------------------------------------------
Static Function ProcessInvoiceItem(jItem as Json)
	Local cErrorCode         As Character
    Local cBranch            As Character
    Local cSupplierCode      As Character
    Local cSupplierStore     As Character
	Local jErrorInfo         As Json

	cErrorCode      := ""
	jErrorInfo      := JsonObject():New()
    cBranch         := PadR(jItem["branch"], TamSX3("A2_FILIAL")[1])
    cSupplierCode   := PadR(jItem["suppliercode"], TamSX3("A2_COD")[1])
    cSupplierStore  := PadR(jItem["supplierstore"], TamSX3("A2_LOJA")[1])

	cErrorCode      := jItem:GetJsonText("errorcode")
	cErrorCode      := Iif(cErrorCode == "null","",cErrorCode)

	jItem["detailError"] := JsonObject():New()

	//Se não ocorreu erro, grava os campos como vazio
	If Empty(cErrorCode)
		jItem["detailError"]["descriptionError"] := " "
		jItem["detailError"]["solutionError"]    := " "
		jItem["detailError"]["errorCategory"]    := " "

		FWFreeObj(jErrorInfo)
	Else
		//Em caso de erro, chama o método GetErrorInfo para atribuir ao objeto
		//json a descrição (descriptionError), solução (solutionError) e categoria do erro (errorCategory)
		jErrorInfo := PurchaseMonitorInvoicesData():GetErrorInfo(cErrorCode)
		jItem["detailError"]   := jErrorInfo
	EndIf
	
Return


//------------------------------------------------------------------------------
/*/ {Protheus.doc} getInvoicesItems
	Método que prepara e executa a consulta daos ítens das notas fiscais com base nos parâmetros recebidos.

	@author Squad PIF
	@version 1.0
	@param nPage, Numeric, Número da página a ser retornada
	@param nPageSize, Numeric, Tamanho da página a ser retornada
	@param cFilter, character, Texto a ser usado na busca.
	@return Json, retorna o objeto json contendo os dados recebidos
/*/
//------------------------------------------------------------------------------
Method getInvoicesItems(nPage as Numeric, nPageSize as Numeric, cFilter as Character)  As Json Class PurchaseMonitorInvoicesService

	Local oInvoicesItemsData                       As Object
	Local oError            := ErrorClass():New()  As Object
	Local jResponse         := JsonObject():New()  As Json
	Local cResponse         := ""                  As Character
	Local xDecode           := ""                  As Character

	oInvoicesItemsData := PurchaseMonitorInvoicesData():New()
	oInvoicesItemsData:getInvoicesItems(nPage, nPageSize, cFilter)

	oError:genCode     := oInvoicesItemsData:getCode()
	oError:description := oInvoicesItemsData:getMessage()

	jResponse  := getBadRequestResponse({oError})

	If oInvoicesItemsData:lOk
		cResponse := oInvoicesItemsData:GetJSONResponse()
		xDecode   := DecodeUTF8(cResponse)

		If ValType(xDecode) == "C"
			cResponse := xDecode
		EndIf

		//Se retornou com sucesso, formata o response
		jResponse:FromJson(cResponse)
		jResponse := getSuccessReponse(jResponse)
	EndIf

	oInvoicesItemsData:DeActivate()
	FWFreeObj(oInvoicesItemsData)

Return jResponse


