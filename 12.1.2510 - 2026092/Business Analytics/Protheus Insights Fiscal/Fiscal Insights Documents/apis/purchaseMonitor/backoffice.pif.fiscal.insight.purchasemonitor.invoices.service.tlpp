//------------------------------------------------------------------------------
/*/ {Protheus.doc} getDashboardInvoicesByStatus
	Metodo que prepara e executa a consulta consolidada do volume de notas fiscais
	por status (dashboard "Volume de NF por Status").

	Consolida a quantidade de documentos por status utilizando a camada de dados
	e garante o retorno fixo dos 6 status previstos, preenchendo
	com zero os status sem movimentacao, para manter a estrutura fixa do grafico.

	@author Squad PIF
	@version 1.0
	@param cFilter, character, Filtro opcional ($filter) a ser aplicado na consulta
	@return Json, retorna o objeto json no formato { items: [ { code, value } ] }
/*/
//------------------------------------------------------------------------------
Method getDashboardInvoicesByStatus(cFilter as Character) As Json Class PurchaseMonitorInvoicesService

	Local oDashboardData := PurchaseMonitorInvoicesData():New()  As Object
	Local oError         := ErrorClass():New()                   As Object
	Local jResponse      := JsonObject():New()                   As Json
	Local jResult        := JsonObject():New()                   As Json
	Local cResponse      := ""                                   As Character
	Local aItems         := {}                                   As Array

	Default cFilter := ""

	oDashboardData:getDashboardInvoicesByStatus(cFilter)

	oError:genCode     := oDashboardData:getCode()
	oError:description := oDashboardData:getMessage()

	jResponse := getBadRequestResponse({oError})

	If oDashboardData:lOk
		cResponse := oDashboardData:GetJSONResponse()

		jResult:FromJson(cResponse)

		If jResult:hasProperty("items") .And. ValType(jResult["items"]) == "A"
			aItems := jResult["items"]
		EndIf

		jResponse := getSuccessReponse( BuildStatusChart(aItems) )
	EndIf

	oDashboardData:DeActivate()
	FWFreeObj(oDashboardData)
	FWFreeObj(oError)
	FWFreeObj(jResult)

Return jResponse

//------------------------------------------------------------------------------
/*/ {Protheus.doc} BuildStatusChart
	Monta a estrutura fixa do grafico de volume por status, garantindo os 6 status
	previstos e convertendo o codigo do status para numerico.

	@important Status previstos:
		1 - Exportada             (Na CKO, sem SDS/SDT)
		2 - Exportada com Erros   (Na CKO com erro - CKO_MSGERR)
		3 - Importada             (Gravado na SDS/SDT)
		4 - Importada com Divergencias (Gravado na SDS/SDT com erro de validacao)
		5 - Integrada             (Pre-Nota de Entrada gerada)
		6 - Classificada

	@author Squad PIF
	@version 1.0
	@param aItems, array, Array de objetos json com code/value retornados pela consulta
	@return Json, objeto json no formato { items: [ { code, value } ] }
/*/
//------------------------------------------------------------------------------
Static Function BuildStatusChart(aItems as Array) As Json

	Local jChart  := JsonObject():New()   As Json
	Local aStatus := {1, 2, 3, 4, 5, 6}   As Array
	Local aResult := {}                   As Array
	Local jItem                           As Json
	Local nX      := 0                    As Numeric
	Local nY      := 0                    As Numeric
	Local nCode   := 0                    As Numeric
	Local nValue  := 0                    As Numeric

	Default aItems := {}

	For nX := 1 To Len(aStatus)

		nCode  := aStatus[nX]
		nValue := 0

		For nY := 1 To Len(aItems)
			If Val(cValToChar(aItems[nY]["code"])) == nCode
				nValue := aItems[nY]["value"]
				Exit
			EndIf
		Next nY

		jItem := JsonObject():New()
		jItem["code"]  := nCode
		jItem["value"] := nValue

		aAdd(aResult, jItem)

	Next nX

	jChart["items"] := aResult

Return jChart


//------------------------------------------------------------------------------
/*/ {Protheus.doc} getDashboardInvoicesBySpecie
	Metodo que prepara e executa a consulta consolidada do impacto financeiro
	por especie de documento fiscal (dashboard "Impacto por Especie de Documento").

	Retorna totalValue (valor total geral) e items com code (especie), value
	(valor financeiro) e percentage (participacao percentual sobre o total).

	@author Squad PIF
	@version 1.0
	@param cFilter, character, Filtro opcional ($filter) a ser aplicado na consulta
	@return Json, retorna o objeto json no formato { totalValue, items: [{code, value, percentage}] }
/*/
//------------------------------------------------------------------------------
Method getDashboardInvoicesBySpecie(cFilter as Character) As Json Class PurchaseMonitorInvoicesService

	Local oDashboardData := PurchaseMonitorInvoicesData():New()  As Object
	Local oError         := ErrorClass():New()                   As Object
	Local jResponse      := JsonObject():New()                   As Json
	Local jResult        := JsonObject():New()                   As Json
	Local cResponse      := ""                                   As Character
	Local aItems         := {}                                   As Array

	Default cFilter := ""

	oDashboardData:getDashboardInvoicesBySpecie(cFilter)

	oError:genCode     := oDashboardData:getCode()
	oError:description := oDashboardData:getMessage()

	jResponse := getBadRequestResponse({oError})

	If oDashboardData:lOk
		cResponse := oDashboardData:GetJSONResponse()

		jResult:FromJson(cResponse)

		If jResult:hasProperty("items") .And. ValType(jResult:GetJsonObject("items")) == "A"
			aItems := jResult["items"]
		EndIf

		jResponse := getSuccessReponse( BuildSpecieChart(aItems) )
	EndIf

	oDashboardData:DeActivate()
	FWFreeObj(oDashboardData)
	FWFreeObj(oError)
	FWFreeObj(jResult)

Return jResponse

//------------------------------------------------------------------------------
/*/ {Protheus.doc} BuildSpecieChart
	Monta a estrutura do grafico de impacto por especie de documento,
	calculando o percentual de participacao de cada especie sobre o total,
	e garantindo os 4 tipos previstos (NF-E, NFS-E, CT-E, CTE-OS) com
	valor zero quando sem movimentacao.

	@author Squad PIF
	@version 1.0
	@param aItems, array, Array de objetos json com code/value retornados pela consulta
	@return Json, objeto json no formato { totalValue, items: [{code, value, percentage}] }
/*/
//------------------------------------------------------------------------------
Static Function BuildSpecieChart(aItems as Array) As Json

	Local jChart      := JsonObject():New()  As Json
	Local aSpecies    := {"NF-E", "NFS-E", "CT-E", "CTE-OS"}  As Array
	Local aResult     := {}                  As Array
	Local jItem                              As Json
	Local nX          := 0                   As Numeric
	Local nY          := 0                   As Numeric
	Local nTotalValue := 0                   As Numeric
	Local nValue      := 0                   As Numeric
	Local nPercentage := 0                   As Numeric
	Local cCode       := ""                  As Character

	Default aItems := {}

	// Primeiro passo: calcular o total geral
	For nX := 1 To Len(aItems)
		nTotalValue += aItems[nX]["value"]
	Next nX

	// Segundo passo: montar o array com os 4 tipos fixos
	For nX := 1 To Len(aSpecies)

		cCode      := aSpecies[nX]
		nValue     := 0
		nPercentage := 0

		For nY := 1 To Len(aItems)
			If Upper(AllTrim(aItems[nY]["code"])) == cCode
				nValue := aItems[nY]["value"]
				Exit
			EndIf
		Next nY

		If nTotalValue > 0
			nPercentage := Round((nValue / nTotalValue) * 100, 2)
		EndIf

		jItem := JsonObject():New()
		jItem["code"]       := cCode
		jItem["value"]      := nValue
		jItem["percentage"] := nPercentage

		aAdd(aResult, jItem)

	Next nX

	jChart["totalValue"] := nTotalValue
	jChart["items"]      := aResult

Return jChart


//------------------------------------------------------------------------------
/*/ {Protheus.doc} getDashboardTaxComparison
	Metodo que prepara e executa a consulta do comparativo de tributos de UM UNICO
	documento fiscal (dashboard "Comparativo de Tributos").

	O documento e identificado pelo filtro recebido via $filter. Os campos
	disponiveis para o filtro sao: branch, invoiceNumber, serialNumber,
	supplierCode, supplierStore e documentType.

	Retorna, para cada tributo, o valor recebido no XML (valueReceived) e o valor
	calculado/persistido pelo ERP via TES (valueCalculated).

	@author Squad PIF
	@version 1.0
	@param cFilter, character, Filtro ($filter) que identifica o documento
	@return Json, retorna o objeto json no formato { items: [{taxDescription, valueReceived, valueCalculated}] }
/*/
//------------------------------------------------------------------------------
Method getDashboardTaxComparison(cFilter as Character) As Json Class PurchaseMonitorInvoicesService

	Local oTaxData   := PurchaseMonitorInvoicesData():New()  As Object
	Local oError     := ErrorClass():New()                   As Object
	Local jResponse  := JsonObject():New()                   As Json
	Local jResult    := JsonObject():New()                   As Json
	Local cResponse  := ""                                   As Character
	Local xDecode    := Nil                                  As Variant
	Local jTotals    := Nil                                  As Json

	Default cFilter := ""

	oTaxData:getDashboardTaxComparison(cFilter)

	oError:genCode     := oTaxData:getCode()
	oError:description := oTaxData:getMessage()

	jResponse := getBadRequestResponse({oError})

	If oTaxData:lOk
		cResponse := oTaxData:GetJSONResponse()
		xDecode   := DecodeUTF8(cResponse)

		If ValType(xDecode) == "C"
			cResponse := xDecode
		EndIf

		jResult:FromJson(cResponse)

		// A consulta e agregada e retorna uma unica linha com os totais do documento
		If jResult:hasProperty("items") .And. ValType(jResult:GetJsonObject("items")) == "A"
			If Len(jResult["items"]) > 0
				jTotals := jResult["items"][1]
			EndIf
		EndIf

		// Documento sem tributos ou nao encontrado retorna a estrutura zerada,
		// mantendo o contrato estavel para o grafico do frontend
		jResponse := getSuccessReponse( BuildTaxComparisonChart(jTotals) )
	EndIf

	oTaxData:DeActivate()
	FWFreeObj(oTaxData)
	FWFreeObj(oError)
	FWFreeObj(jResult)

Return jResponse

//------------------------------------------------------------------------------
/*/ {Protheus.doc} BuildTaxComparisonChart
	Monta a estrutura do grafico de comparativo de tributos, transpondo os totais
	do documento (uma linha com os valores agregados) para a lista de tributos.

	Garante a estrutura fixa com os tributos previstos, retornando zero quando o
	tributo nao possuir valor no documento.

	@important IBS e CBS sao obtidos da tabela DKM (tributos do Configurador de
		Tributos), pois nao possuem campos na SDT. O IBS e a soma dos registros
		IBSUF (estadual) e IBSMUN (municipal). Quando a DKM nao existe no
		dicionario, esses tributos retornam zero automaticamente, pois as
		propriedades nao sao mapeadas pela camada de dados.

	@author Squad PIF
	@version 1.0
	@param jTotals, json, Objeto json com os totais agregados do documento
	@return Json, objeto json no formato { items: [{taxDescription, valueReceived, valueCalculated}] }
/*/
//------------------------------------------------------------------------------
Static Function BuildTaxComparisonChart(jTotals as Json) As Json

	Local jChart  := JsonObject():New()  As Json
	Local aTaxes  := {}                  As Array
	Local aResult := {}                  As Array
	Local jItem                          As Json
	Local nX      := 0                   As Numeric

	// {descricao do tributo, propriedade do valor do XML, propriedade do valor do ERP}
	// ICMS, ICMS ST, IPI, PIS, COFINS e ISS vem da SDT (pares DT_XML*/DT_TES*)
	// IBS e CBS vem da DKM (DKM_XMLVLR/DKM_VALOR), sendo IBS = IBSUF + IBSMUN
	aTaxes := {;
		{"ICMS"   , "xmlicms"  , "erpicms"  },;
		{"ICMS ST", "xmlicmsst", "erpicmsst"},;
		{"IPI"    , "xmlipi"   , "erpipi"   },;
		{"PIS"    , "xmlpis"   , "erppis"   },;
		{"COFINS" , "xmlcofins", "erpcofins"},;
		{"IBS"    , "xmlibs"   , "erpibs"   },;
		{"CBS"    , "xmlcbs"   , "erpcbs"   },;
		{"ISS"    , "xmliss"   , "erpiss"   } ;
	}

	For nX := 1 To Len(aTaxes)

		jItem := JsonObject():New()
		jItem["taxDescription"]  := aTaxes[nX][1]
		jItem["valueReceived"]   := GetTaxValue(jTotals, aTaxes[nX][2])
		jItem["valueCalculated"] := GetTaxValue(jTotals, aTaxes[nX][3])

		aAdd(aResult, jItem)

	Next nX

	jChart["items"] := aResult

	FwFreeArray(aTaxes)

Return jChart

//------------------------------------------------------------------------------
/*/ {Protheus.doc} GetTaxValue
	Funcao utilitaria que recupera, de forma segura, o valor de um tributo no
	objeto json de totais. Retorna zero quando a propriedade nao existe ou quando
	o tributo nao possui campo correspondente no dicionario.

	@author Squad PIF
	@version 1.0
	@param jTotals, json, Objeto json com os totais agregados do documento
	@param cProperty, character, Nome da propriedade a ser recuperada
	@return numeric, Valor do tributo ou zero
/*/
//------------------------------------------------------------------------------
Static Function GetTaxValue(jTotals as Json, cProperty as Character) As Numeric

	Local nValue := 0 As Numeric

	If Empty(cProperty) .Or. ValType(jTotals) != "J" ; Return nValue ; EndIf

	If jTotals:hasProperty(cProperty) .And. ValType(jTotals[cProperty]) == "N"
		nValue := jTotals[cProperty]
	EndIf

Return nValue


//------------------------------------------------------------------------------
/*/ {Protheus.doc} getDashboardPendingClassification
	Metodo que prepara e executa a consulta dos documentos pendentes de classificacao
	ha mais tempo (dashboard "Documentos a mais tempo sem classificacao").

	Retorna documentos que estao no Monitor (SDS/SDT sem classificacao) ou em
	Pre-Nota (SF1/SD1 com F1_STATUS = ' '), ordenados por dias sem classificacao
	(quantidade de dias desde a emissao ate hoje).

	Cada documento e retornado apenas uma vez, independentemente da quantidade de
	itens. Filtros opcionais: branch, minDaysPending, supplier, specie, startDate, endDate.

	@author Squad PIF
	@version 1.0
	@param nPage, Numeric, Numero da pagina a ser retornada
	@param nPageSize, Numeric, Tamanho da pagina a ser retornada
	@param cFilter, character, Filtro opcional ($filter) a ser aplicado na consulta
	@return Json, retorna o objeto json com items: [{documentKey, invoiceNumber, serialNumber, specie, supplierCode, supplierName, documentDate, integrationDate, daysPending, totalValue, currentStatus, branch, responsibleArea}]
/*/
//------------------------------------------------------------------------------
Method getDashboardPendingClassification(nPage as Numeric, nPageSize as Numeric, cFilter as Character) As Json Class PurchaseMonitorInvoicesService

	Local oPendingData := PurchaseMonitorInvoicesData():New()  As Object
	Local oError       := ErrorClass():New()                   As Object
	Local jResponse    := JsonObject():New()                   As Json
	Local jResult      := JsonObject():New()                   As Json
	Local cResponse    := ""                                   As Character
	Local aItems       := {}                                   As Array
	Local xDecode                                              As Variant

	Default nPage     := 1
	Default nPageSize := 10
	Default cFilter   := ""

	oPendingData:getDashboardPendingClassification(nPage, nPageSize, cFilter)

	oError:genCode     := oPendingData:getCode()
	oError:description := oPendingData:getMessage()

	jResponse := getBadRequestResponse({oError})

	If oPendingData:lOk
		cResponse := oPendingData:GetJSONResponse()
		xDecode   := DecodeUTF8(cResponse)

		If ValType(xDecode) == "C"
			cResponse := xDecode
		EndIf

		jResult:FromJson(cResponse)

		// Ordena do mais antigo para o mais recente (maior quantidade de dias)
		If jResult:hasProperty("items") .And. ValType(jResult["items"]) == "A"
			aItems := jResult["items"]
			aSort(aItems, , , {|x,y| Val(cValToChar(x["dayspending"])) > Val(cValToChar(y["dayspending"])) })
			jResult["items"] := aItems
		EndIf

		jResponse := getSuccessReponse(jResult)
	EndIf

	oPendingData:DeActivate()
	FWFreeObj(oPendingData)
	FWFreeObj(oError)

Return jResponse


//------------------------------------------------------------------------------
/*/ {Protheus.doc} getDashboardPendingClassificationChart
	Metodo que prepara e executa a consulta agregada de documentos pendentes de
	classificacao agrupados por faixas de tempo (dashboard "Documentos a mais tempo
	sem classificacao" - Grafico).

	Retorna a quantidade de documentos agrupada em 4 faixas fixas: ATE_10, 11_20,
	21_30, ACIMA_30.

	Reutiliza a mesma base de dados de getDashboardPendingClassification(), aplicando
	GROUP BY por faixas de dias calculadas via DATEDIFFDAY() cross-database.

	@author Squad PIF
	@since 02/09/2026
	@version 1.0
	@return Json, retorna o objeto json no formato { items: [{range, description, quantity}] }
/*/
//------------------------------------------------------------------------------
Method getDashboardPendingClassificationChart() As Json Class PurchaseMonitorInvoicesService

	Local oChartData := PurchaseMonitorInvoicesData():New()  As Object
	Local oError     := ErrorClass():New()                   As Object
	Local jResponse  := JsonObject():New()                   As Json
	Local jResult    := JsonObject():New()                   As Json
	Local cResponse  := ""                                   As Character
	Local aItems     := {}                                   As Array
	Local xDecode                                            As Variant

	oChartData:getDashboardPendingClassificationChart()

	oError:genCode     := oChartData:getCode()
	oError:description := oChartData:getMessage()

	jResponse := getBadRequestResponse({oError})

	If oChartData:lOk
		cResponse := oChartData:GetJSONResponse()
		xDecode   := DecodeUTF8(cResponse)

		If ValType(xDecode) == "C"
			cResponse := xDecode
		EndIf

		jResult:FromJson(cResponse)

		If jResult:hasProperty("items") .And. ValType(jResult["items"]) == "A"
			aItems := jResult["items"]
		EndIf

		// Transforma os dados agregados em estrutura para o grafico
		jResponse := getSuccessReponse( BuildPendingClassificationChart(aItems) )
	EndIf

	oChartData:DeActivate()
	FWFreeObj(oChartData)
	FWFreeObj(oError)
	FWFreeObj(jResult)

Return jResponse


//------------------------------------------------------------------------------
/*/ {Protheus.doc} BuildPendingClassificationChart
	Monta a estrutura do grafico de documentos pendentes por faixas de tempo.

	Garante as 4 faixas fixas (ATE_10, 11_20, 21_30, ACIMA_30) mesmo quando a query
	nao retornar dados para alguma faixa. Adiciona descricoes legiveis e ordena do
	menor para o maior intervalo.

	@author Squad PIF
	@since 02/09/2026
	@version 1.0
	@param aItems, array, Array com os dados agregados da consulta {range, quantity}
	@return Json, objeto json no formato { items: [{range, description, quantity}] }
/*/
//------------------------------------------------------------------------------
Static Function BuildPendingClassificationChart(aItems as Array) As Json

	Local jChart   := JsonObject():New()  As Json
	Local aRanges  := {}                  As Array
	Local aResult  := {}                  As Array
	Local jItem                           As Json
	Local nX       := 0                   As Numeric
	Local nPos     := 0                   As Numeric
	Local nQtd     := 0                   As Numeric

	aRanges := {;
		{"ATE_10"  , STR0001     },;
		{"11_20"   , STR0002  	 },;
		{"21_30"   , STR0003  	 },;
		{"ACIMA_30", STR0004 	 } ;
	}

	For nX := 1 To Len(aRanges)

		jItem := JsonObject():New()

		// Busca a quantidade da faixa nos dados retornados pela query
		nQtd := 0
		If ValType(aItems) == "A" .And. Len(aItems) > 0
			nPos := aScan(aItems, {|x| AllTrim(x["range"]) == aRanges[nX][1] })
			If nPos > 0
				nQtd := aItems[nPos]["quantity"]
			EndIf
		EndIf

		jItem["range"]       := aRanges[nX][1]
		jItem["description"] := aRanges[nX][2]
		jItem["quantity"]    := nQtd

		aAdd(aResult, jItem)

	Next nX

	jChart["items"] := aResult

	FwFreeArray(aRanges)

Return jChart


