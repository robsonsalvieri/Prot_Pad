#include "tlpp-core.th"
#include "tlpp-rest.th"

namespace totvs.protheus.backoffice.pif.fiscal.insight.ncm
using namespace totvs.protheus.backoffice.pif.util


//------------------------------------------------------------------------------
/* {Protheus.doc} NcmGroupsController
    API responsável por consultar os grupos de NCM e os produtos relacionados a esses grupos com movimentação nos últimos 12 meses.

    @type Class
    @author Squad PIF
    @version 1.0
*/
//------------------------------------------------------------------------------
Class NcmGroupsController

	Public Method new() Constructor

	@Get("/api/pif/ncm/groups")
	Public Method getNcmGroups()

	@Get("/api/pif/ncm/groups/:cGroupCode/products")
	Public Method getProductsByNcmGroup()

	@Get("/api/pif/ncm/cclasstrib/:cProductCode")
	Public Method getCClassTribByProduct()

endClass


//------------------------------------------------------------------------------
/* {Protheus.doc} new
    Metodo construtor

    @type Method
    @author Squad PIF
    @version 1.0
    @return Object, retorna o objeto criado
*/
//------------------------------------------------------------------------------
Method New() Class NcmGroupsController
Return Self


//------------------------------------------------------------------------------
/* {Protheus.doc} getNcmGroups
    Método responsável por retornar a lista de grupos de NCM dos produtos com movimentação nos últimos 12 meses.

    @type Method
    @author Squad PIF
    @version 1.0
*/
//------------------------------------------------------------------------------
Method getNcmGroups() class NcmGroupsController
	Local oService         As Object
	Local JResponse        As Json
	Local nPage            As Numeric
	Local nPageSize        As Numeric
	Local cFilter          As Character
	Local cTempTable       As Character

	nPage        := 1
	nPageSize    := 10
	cFilter      := ""
	cTempTable   := ""

	JResponse := getNoAccessResponse()

	if canAccess("PIFA010")
		getPageAndPageSize(@nPage, @nPageSize)

		// Pega o nome da tabela temporária
		If (oRest:getQueryRequest():GetJsonText("tempTable") != "null")
       		cTempTable := AllTrim(oRest:getQueryRequest():GetJsonText("tempTable"))
      	EndIf

		// Pegando os filtros
		If (oRest:getQueryRequest():GetJsonText("$filter") != "null")
       		cFilter := AllTrim(oRest:getQueryRequest():GetJsonText("$filter"))
      	EndIf

		oService  := NcmGroupsService():New()
		JResponse := oService:getNcmGroups(nPage, nPageSize, cFilter, cTempTable)
	endIF

	answerRest(JResponse)

	FWFreeObj(oService)
	FWFreeObj(JResponse)

Return


//------------------------------------------------------------------------------
/* {Protheus.doc} getCClassTribByProduct
    Método responsável por retornar as sugestões de classificação tributária (cClassTrib)
    de acordo com o código do produto informado.

    @type Method
    @author Squad PIF
    @version 1.0
*/
//------------------------------------------------------------------------------
Method getCClassTribByProduct() class NcmGroupsController
	Local oService     As Object
	Local JResponse    As Json
	Local JPath        As Json
	Local nPage        As Numeric
	Local nPageSize    As Numeric
	Local cProductCode As Character

	jPath        := oRest:getPathParamsRequest()
	nPage        := 1
	nPageSize    := 10
	cProductCode := ""

	JResponse := getNoAccessResponse()

	if canAccess("PIFA010")
		getPageAndPageSize(@nPage, @nPageSize)

		if JPath:GetJsonText("cProductCode") != "null"
			cProductCode := AllTrim(JPath:GetJsonText("cProductCode"))
		endif

		oService  := NcmGroupsService():New()
		JResponse := oService:getCClassTribByProduct(cProductCode, nPage, nPageSize)
	endIf

	answerRest(JResponse)

	FWFreeObj(oService)
	FWFreeObj(JResponse)

Return
//------------------------------------------------------------------------------
/* {Protheus.doc} getProductsByNcmGroup
    Método responsável por retornar a lista de produtos de acordo com o grupo de NCM informado.

    @type Method
    @author Squad PIF
    @version 1.0
*/
//------------------------------------------------------------------------------
Method getProductsByNcmGroup() class NcmGroupsController
	Local oService          As Object
	Local JResponse         As Json
	Local nPage             As Numeric
	Local nPageSize         As Numeric
	Local JPath             As Json
	Local cGroupCode        As Character
	Local cFilter           As Character
	Local cTempTable        As Character

	nPage       := 1
	nPageSize   := 10
	jPath       := oRest:getPathParamsRequest()
	cGroupCode  := ""
	cFilter     := ""
	cTempTable  := ""

	JResponse := getNoAccessResponse()

	if canAccess("PIFA010")
		getPageAndPageSize(@nPage, @nPageSize)

		// Pega o nome da tabela temporária, caso não seja passado não poderá seguir com a requisição.
		If (oRest:getQueryRequest():GetJsonText("tempTable") != "null")
       		cTempTable := AllTrim(oRest:getQueryRequest():GetJsonText("tempTable"))
      	EndIf

		if JPath:GetJsonText("cGroupCode") != "null"
			cGroupCode := PadR(JPath:GetJsonText("cGroupCode"), 4)
		endif

		// Pegando os filtros
		If (oRest:getQueryRequest():GetJsonText("$filter") != "null")
       		cFilter := AllTrim(oRest:getQueryRequest():GetJsonText("$filter"))
      	EndIf

		oService  := NcmGroupsService():New()
		JResponse := oService:getProductsByNcmGroup(nPage, nPageSize, cGroupCode, cFilter, cTempTable)
	endIf

	answerRest(JResponse)

	FWFreeObj(oService)
	FWFreeObj(JResponse)

Return
