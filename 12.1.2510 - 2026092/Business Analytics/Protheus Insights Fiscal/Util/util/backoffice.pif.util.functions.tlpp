#include "tlpp-core.th"

namespace totvs.protheus.backoffice.pif.util

//------------------------------------------------------------------------------
/*/{Protheus.doc} CanAccess
    Verifica se o usuario possui permissao de acesso a uma determinada funcao no contexto informado.

    @type   Function
    @author Squad PIF
    @since  15/05/2026
    @param  cContext, character, Contexto ou identificador da funcao a ser verificada
    @return logical, Verdadeiro se o usuario possui acesso, Falso caso contrario
/*/
//------------------------------------------------------------------------------
Function CanAccess(cContext As Character) As Logical
	Local lAccess   := .F. As Logical
	Local lImpXTra  := .F. As Logical

	Do Case
	Case cContext == 'PIFA020'
		lImpXTra   := ImpXTra()
		lAccess    := (findFunction(cContext) .And. lImpXTra) .Or. findClass("PIFUtilResponseTestSuite")
	Otherwise
		lAccess    := findFunction(cContext) .And. (findClass("PIFUtilResponseTestSuite"))
	EndCase

Return lAccess
