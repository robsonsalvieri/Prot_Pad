#INCLUDE "totvs.ch"
#INCLUDE "tlpp-core.th"
#INCLUDE "backoffice.ba.dta.core.dtaflowsucceed.ch"

USING NAMESPACE totvs.protheus.backoffice.ba.insights

//-------------------------------------------------------------------
/*/{Protheus.doc} DtaFlowSucceedMessageReader
Consumer DtaFlowSucceed

@author  Victor Vieira
@since   23/04/2025
/*/
//-------------------------------------------------------------------
Class DtaFlowSucceedMessageReader

    Public Method New()
    Public Method Read( oLinkMessage As Object ) As Logical

EndClass

//-------------------------------------------------------------------
/*/{Protheus.doc} New
Metodo construtor da classe 

@author  Victor Vieira
@since   23/04/2025
/*/
//-------------------------------------------------------------------
Method New() Class DtaFlowSucceedMessageReader 
Return Self

//-------------------------------------------------------------------
/*/{Protheus.doc} Read
Metodo que realiza a leitura da mensagem recebida 

@author  Victor Vieira
@since   23/04/2025
/*/
//-------------------------------------------------------------------
Method Read( oLinkMessage As Object) As Logical Class DtaFlowSucceedMessageReader
    Local aDictSX2          As Array
    Local cAliasI19         As Character
    Local cRawMsg           As Character
    Local cInsightResolv    As Character
    Local lReadOk           As Logical
    Local nStart            As Numeric
    Local oJsonMessage      As Object
    Local oInsightMessage   As Object
    Local xJsonParse        As Variant

    nStart := Seconds()

    Try 
        cRawMsg         := oLinkMessage:RawMessage()
        oJsonMessage    := JsonObject():New()
        xJsonParse      := oJsonMessage:fromJson( cRawMsg )
        cInsightResolv  := oJsonMessage["type"] 

        aDictSX2    := FwSX2Util():GetSX2Data("I19", {"X2_ARQUIVO"}, .T.)
        cAliasI19   := Alltrim(aDictSX2[1][2])

        If !Empty(cAliasI19) .And. TCCanOpen(cAliasI19)
            oInsightMessage                     := InsightMessage():New()
            oInsightMessage:cMsgTransId         := oJsonMessage["correlationid"]
            oInsightMessage:cMsgTenantId        := oJsonMessage["data"]["tenantId"]
            oInsightMessage:cMsgInsight         := cInsightResolv
            oInsightMessage:cMsgPayload         := DecodeUTF8(oJsonMessage["data"]["content"])
            oInsightMessage:cMsgReceivedDate    := FWTIMESTAMP(5)
            oInsightMessage:cMsgMessId          := oJsonMessage["data"]["sessionId"]
            
            oInsightMessage:InsertMessage()
        EndIf
        
        lReadOk := .T.
    
    Catch oException
        
        FwLogMsg( "ERROR", Nil, "ProtheusInsights", "DtaMessageConsumer",, "", STR0001,, Seconds() - nStart, ;    //"Exceção ocorrida ao processar a mensagem de insight generativo"
            {;
                { "Message", STR0001 },;   //"Exceção ocorrida ao processar a mensagem de insight generativo"
                { "ErrorCode", oException:genCode },;
                { "ErrorMessage", oException:description };
            })

        lReadOk := .T. // Retorna verdadeiro para limpar a mensagem da fila

    Finally
        FreeObj( oJsonMessage )
    EndTry

Return lReadOk
