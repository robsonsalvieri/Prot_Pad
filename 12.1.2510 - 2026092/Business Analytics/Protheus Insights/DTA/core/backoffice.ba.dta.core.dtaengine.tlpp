#INCLUDE "totvs.ch"
#INCLUDE "tlpp-core.th"
#INCLUDE "backoffice.ba.dta.core.dtaengine.ch"

//-------------------------------------------------------------------
/*/{Protheus.doc} DtaEngine
Classe DtaEngine - Motor para execução dinâmica de tools

@author  Victor Vieira
@since   23/04/2025
/*/
//-------------------------------------------------------------------
Class DtaEngine

    Public DATA aParams                  // Array com os parâmetros dinâmicos
    Public DATA cToolName   AS CHARACTER // Nome da tool a ser executada
    Public DATA cFrequency  AS CHARACTER // Periodo Informado
    Public DATA cSysDate    AS CHARACTER // Data parametrizada no sistema
    Public DATA cInitDate   AS CHARACTER // Data inicial formatada
    Public DATA cEndDate    AS CHARACTER // Data final formatada
    Public DATA oError      AS OBJECT   // Objeto de erro

    Public METHOD New( cTool )
    Public METHOD Execute()
    Public METHOD ValidateTool()
    Public METHOD SetFrequency( cFrequency, cSysDate )

    Public METHOD GetToolName()                // método para retorna o nome da Tool que será executada
    Public METHOD SetSysDate()                 // metodo para setar a database do insight
    Public METHOD GetSysDate()                 // metodo para retornar a database do insight
    Public METHOD SetParameters(aParameters)   // metodo para definir as propriedades padrão do array de parametros auxiliares
    Public METHOD GetParameters()              // metodo para obter o array de parametros default
    Public METHOD SetInitDate(cDate)           // metodo para definir a data inicial
    Public METHOD GetInitDate()                // metodo para retornar a data inicial
    Public METHOD SetEndDate(cDate)            // metodo para definir a data final
    Public METHOD GetEndDate()                 // metodo para retornar a data final

    Public METHOD GetInterval()
    Public METHOD SetError( cMessage, cDetail )// método para gerenciar erros
    Public METHOD HasError()                   // método para verificar existência de erros
    Public METHOD GetError()                   // método para obter os detalhes do erro

EndClass

//-------------------------------------------------------------------
/*/{Protheus.doc} DtaEngine
Metodo construtor da classe

@param cTool, character, Nome da Tool que sera executada

@return Self, Instancia da Classe

@author Victor Vieira
@since 23/04/2025
/*/
//-------------------------------------------------------------------
Method New(cTool) Class DtaEngine
    Default cTool := ''

    ::cToolName := cTool
    ::aParams   := ::SetParameters( { FWGrpCompany(), FWCodFil(), __cUserID } )
    ::cFrequency:= ''
    ::cSysDate  := ''
    ::cInitDate := ''
    ::cEndDate  := ''
    ::oError    := Nil

Return Self

