//-------------------------------------------------------------------
/*/{Protheus.doc} methodName
    Método para validar se a tool existe

    @return lExists, Logical, Retorna se a Tool existe no Rpo

    @author Victor Vieira
    @since 23/04/2025
/*/
//-------------------------------------------------------------------
Method ValidateTool() CLASS DtaEngine

    Local lExists := .F.

    lExists := FindFunction(::cToolName)

    If !lExists
        ::SetError(STR0001, I18N(STR0002,{::cToolName})) // A tool #1  não foi encontrada no sistema
    EndIf

Return lExists

//-------------------------------------------------------------------
/*/{Protheus.doc} Method Execute(cToolName) Class DtaEngine
    Metodo que executa a Tool e retorna Payload para o DTA.

    @return cPayload, Character, Retornar o payload para o DTA

    @author Victor Vieira
    @since 24/07/2025
/*/
//-------------------------------------------------------------------
Method Execute(cToolName) Class DtaEngine
    Local cPayload      := ""
    Local aInterval     := {}
    Local aToolParams   := {}

     // Valida se a tool existe
    If !::ValidateTool()
        Return ::GetError()
    EndIf

    // Obtém o intervalo de datas e Adiciona as datas de intervalo
    aInterval := ::GetInterval()
    If Len(aInterval) == 2
        ::aParams["initDate"] := aInterval[1]
        ::aParams["endDate"] := aInterval[2]
    EndIf

    // Adiciona os parâmetros adicionais formatados
    aToolParams := ::aParams

    // Tenta executar a tool com os parâmetros montados usando TRY...CATCH
    TRY
        cPayload := execCommand(::cToolName,@aToolParams) 
    CATCH oError
        ::SetError(STR0003, oError:Description) // "Erro na execução"
    ENDTRY

     // Se ocorreu erro na execução
    IF ::HasError()
        Return ::GetError()
    ENDIF

return cPayload

//-----------------------------------------------------------------------------------------------------------
/*/{Protheus.doc} SetFrequency
    Retorna o intervalo de datas que define o periodo solicitado pelo usuário

    @param cFrequency, character, Periodo que deseja buscar os dados S - Semanal, M - Mensal, T - Trimestral

    @return lSucess, logical, Variavel controle de sucesso ou erro

    @author Victor Vieira
    @since 22/04/2025
/*/
//-------------------------------------------------------------------------------------------------------------
Method SetFrequency(cFrequency,cSysDate) Class DtaEngine
    Local nDayOfWeek := 0
    Local nDaySub    := CTOD("")
    Local nDaySum    := CTOD("")
    Local lSuccess   := .T.
	Local dDataRef	 := dDataBase
    Local cYear      := ''
    Local cMonth     := ''

    If !Empty(cSysDate)
        If cFrequency == "D"
            cSysDate := StrTran( cSysDate, "/", "" )
            cSysDate := StrTran( cSysDate, "-", "" )

            cMonth := StrZero( Month( dDataRef ), 2 )
            cYear  := cValToChar( Year( dDataRef ) )

            If Len(cSysDate) == 2
                cSysDate := cYear + cMonth + cSysDate
            ElseIf Len(cSysDate) == 4
                cSysDate := cYear + SubStr(cSysDate, 3, 2) + SubStr(cSysDate, 1, 2)
            EndIf
        ElseIf cFrequency == "A"
            cYear    := cValToChar( Year( dDataRef ) )
            cSysDate := cYear + "0101"
        EndIf

        dDataRef	 := SToD(cSysDate)
    EndIf

    ::cFrequency := cFrequency

    Do Case
        Case cFrequency == "S"
            // Determina o dia da semana (1=Domingo, 2=Segunda, ..., 7=Sábado)
            nDayOfWeek  := Dow( dDataRef )
            nDaySub     := DaySub( dDataRef, nDayOfWeek - 1 )
            nDaySum     := DaySum( nDaySub, 6 )

            ::cInitDate := DToS( nDaySub )                      // início da semana (Domingo)
            ::cEndDate  := DToS( nDaySum )                      // fim da semana (Sábado)

        Case cFrequency == "M"

            ::cInitDate := DToS( FirstDay( dDataRef ) )         // Primeiro dia do mês atual
            ::cEndDate  := DToS( LastDay( dDataRef ) )          // Último dia do mês atual

        Case cFrequency == "T"

            cMonth := StrZero( Month( dDataRef ), 2 )
            cYear  := cValToChar( Year( dDataRef ) )

            If cMonth $ "01,02,03"     // primeiro trimestre
                ::cInitDate := cYear + "0101"
                ::cEndDate  := cYear + "0331"
            ElseIf cMonth $ "04,05,06" // segundo trimestre
                ::cInitDate := cYear + "0401"
                ::cEndDate  := cYear + "0630"
            ElseIf cMonth $ "07,08,09" // terceiro trimestre
                ::cInitDate := cYear + "0701"
                ::cEndDate  := cYear + "0930"
            ElseIf cMonth $ "10,11,12" // quarto trimestre
                ::cInitDate := cYear + "1001"
                ::cEndDate  := cYear + "1231"
            EndIf

        Case cFrequency == "A"      // anual

            cYear  := cValToChar( Year( dDataRef ) )

            ::cInitDate := cYear + "0101"
            ::cEndDate  := cYear + "1231"

        Case cFrequency == "Q"      // quinzenal

            cMonth  := StrZero( Month( dDataRef ), 2 )
            cYear   := cValToChar( Year( dDataRef ) )

            If Day( dDataRef ) <= 15
                ::cInitDate := DToS( FirstDay( dDataRef ) )         // Primeiro dia do mês atual
                ::cEndDate  := cYear + cMonth + "15"                // Dia 15 do mês atual
            Else
                ::cInitDate := cYear + cMonth + "16"                // Dia 16 do mês atual
                ::cEndDate  := DToS( LastDay( dDataRef ) )          // Último dia do mês atual
            EndIf

        Case cFrequency == "D"      // dia especifico

            ::cInitDate := DToS( dDataRef )
            ::cEndDate  := DToS( dDataRef )

        Case cFrequency == "X"      // semestral

            If Month( dDataRef ) <= 6
                cYear  := cValToChar( Year( dDataRef ) )

                ::cInitDate := cYear + "0101"
                ::cEndDate  := cYear + "0630"
            Else
                cYear  := cValToChar( Year( dDataRef ) )

                ::cInitDate := cYear + "0701"
                ::cEndDate  := cYear + "1231"
            EndIf

        Otherwise

            ::SetError(STR0004, STR0005) // "Frequência inválida", "Parâmetros esperados: S - Semanal, M - Mensal, T - Trimestral, A - Anual, Q - Quinzenal, D - Dia específico, X - Semestral"
            lSuccess := .F.
    EndCase
Return lSuccess

//-------------------------------------------------------------------
/*/{Protheus.doc} GetInterval
    Método para obter o intervalo de datas

    @return aInterval, Array com as datas de início e fim formatadas

    @author Victor Vieira
    @since 23/04/2025
/*/
//-------------------------------------------------------------------
METHOD GetInterval() CLASS DtaEngine
    Local aInterval := {}

    IF !Empty(::cInitDate) .AND. !Empty(::cEndDate)
        aInterval := {::cInitDate, ::cEndDate}
    ENDIF

RETURN aInterval

//-------------------------------------------------------------------
/*/{Protheus.doc} SetError
    Método para configurar um erro

    @param cMessage - Mensagem de erro principal
    @param cDetail - Detalhes adicionais do erro

    @return .T. sempre, para facilitar o uso em retornos de métodos

    @author Victor Vieira
    @since 23/04/2025
/*/
//-------------------------------------------------------------------
METHOD SetError(cMessage, cDetail) CLASS DtaEngine
    DEFAULT cDetail := ""

    // Cria o objeto de erro, se ainda não existir
    IF ::oError == NIL
        ::oError := JsonObject():New()
    ENDIF

    // Configura as propriedades do erro
    ::oError["error"] := .T.
    ::oError["message"] := cMessage
    ::oError["detailedMessage"] := cDetail

    // Registra o erro no log do sistema
    ConOut("[ToolEngine][ERROR] " + cMessage + " - " + cDetail)

Return .T.

//-------------------------------------------------------------------
/*/{Protheus.doc} HasError
    Método para verificar se há erro registrado

    @return .T. se existe um erro, .F. caso contrário

    @author Victor Vieira
    @since 23/04/2025
/*/
//-------------------------------------------------------------------
METHOD HasError() CLASS DtaEngine
Return (::oError != NIL)

/*/{Protheus.doc} GetError
    Método para obter o objeto de erro atual

    @return ::oError, Objeto JSON com os detalhes do erro ou NIL

    @author Victor Vieira
    @since 23/04/2025
/*/
METHOD GetError() CLASS DtaEngine
Return ::oError

//-------------------------------------------------------
/*/{Protheus.doc} execCommand
    Realiza Macro execução da tool informada 
    
    @param cToolExec, Caracter, Nome da tool que sera executada
    @param aToolParams, Array, Array que contém os parametoros que serão passados para a tool

    @return &(cExecCmd), Macro Execução , Retorna o resultado da execução da tool
    
    @author Victor Vieira 
    @since 02/09/2025
    
/*/
//-------------------------------------------------------
Static Function execCommand(cToolExec,aToolParams)
    Local cExecCmd  := ''
    Local cParamStr := "aToolParams"
    Local cRetorno  := ""

    Default cToolExec := "" 

    If !Empty( cToolExec )
    // Prepara o comando de execução
        cExecCmd := cToolExec + "(" + cParamStr + ")"
        cRetorno := &(cExecCmd)
    EndIf
Return cRetorno
