#Include "tlpp-core.th"
#Include "tlpp-rest.th"
#Include "totvs.ch"
#Include "rh.sigagpe.integration.retif1210.ch"

Static oVincSRA
Static oSt1210

class GPERetifS1210
	//Retorna a lista de CPFs que possuem S-1210 transmitidos no ano anterior
	@Get("api/rh/v1/RetifPerAnt")
	public method getListaTrabs1210()

	//Altera os meses a serem retificados
	@Put("api/rh/v1/RetifPerAnt/:id")
	public method putRetifRUW()

	public method new() constructor
endclass

/*/{Protheus.doc} new
Inicializador da classe
@type		Method
@version	12.1.2510
@author		isabel.noguti
@since		09/01/2026
/*/
method new() class GPERetifS1210
return self

/*/{Protheus.doc} getListaTrabs1210
Busca os trabalhadores com S-1210 transmitidos no ano anterior
@type		Method
@version	12.1.2510
@author		isabel.noguti
@since		09/01/2026
@return Variant, Retorno nulo pre-fixado
/*/
method getListaTrabs1210() class GPERetifS1210
    Local jQueryParams 	:= oRest:getQueryRequest()	as Json
    Local nErroCod 		:= 0 						as Numeric
    Local cMsg			:= ""						as Character
    Local cMsgDesc		:= ""						as Character
    Local cMsgTipo		:= ""						as Character
    Local nParamOrder	:= 1						as Numeric
    Local cAlias		:= ""						as Character
    Local cQuery		:= ""						as Character
    Local oStatement	:= NIL						as Object
    Local oItem			:= NIL						as Object
    Local nPage			:= 1						as Numeric
    Local nPageSize		:= 999						as Numeric
    Local nTotal		:= 0						as Numeric
    Local nCount		:= 1						as Numeric
    Local lHasNext		:= .F.						as Logical
	Local aFilBusc		:= {}						as Array
	Local cAnoBusc		:= ""						as Character
	Local cAnoRetf		:= ""						as Character
	Local cCpfBusc		:= ""						as Character
	Local cCatsTCV		:= fCatTrabEFD("TCV")		as Character
	Local cFuncType		:= ""						as Character
	Local cNome			:= ""						as Character
	Local aPerAnts		:= {}						as Array
	Local nI			:= 0						as Numeric
	Local aCategs		:= {}						as Array
	Local aFiliais		:= {}						as Array
	Local aMesesRUW		:= {}						as Array
	Local lTCV			:= .F.						as Logical
	Local lTSV			:= .F.						as Logical
	Local lMiddleware := SuperGetMv("MV_MID",,.F.)	as Logical
	Local nEstab		:= 0						as Numeric
	Local cBaseCNPJ		:= ""						as Character
	Local cEstabCNPJ	:= ""						as Character
	Local aSM0			:= {}						as Array
	Local cMatriz		:= ""						as Character

    Private oResponse := JsonObject():New()			as Json

    oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

    BEGIN SEQUENCE
        If jQueryParams:hasProperty("forcaErro")
            BREAK
        Endif

        oResponse["items"] := {}

        // Verifica se a tabela RUV existe
        If !AliasInDic("RUW")
            oResponse["lHasNext"] := .F.
            nErroCod 	:= 400
            cMsg 		:= STR0002//"Tabela não encontrada"
            cMsgDesc 	:= STR0003//"A tabela RUW não foi encontrada no dicionário de dados"
            cMsgTipo	:= "error"
            BREAK
        Endif

		If jQueryParams:hasProperty("yearRectif") .And. !Empty(jQueryParams['yearRectif'])
			cAnoRetf := jQueryParams['yearRectif']
			cAnoBusc := cValtoChar(Val(cAnoRetf) - 1)
			cCpfBusc := If( jQueryParams:hasProperty("registrationNumber"), jQueryParams['registrationNumber'], "")

			If jQueryParams:hasProperty("branchCode")
				aFilBusc	:= StrTokArr(jQueryParams['branchCode'],',')
				cBaseCNPJ	:= FWSM0Util():GetSM0Data( cEmpAnt, aFilBusc[1] , {"M0_CGC"} )[1,2]
				If Len(aFilBusc) > 1	//conferir cnpj das selecionadas
					For nEstab := 2 to Len(aFilBusc)
						cEstabCNPJ := FWSM0Util():GetSM0Data( cEmpAnt, aFilBusc[nEstab] , {"M0_CGC"} )[1,2]
						If Left(cBaseCNPJ, 8) <> Left(cEstabCNPJ, 8)
							oResponse["lHasNext"] := .F.
							nErroCod 	:= 400
							cMsg 		:= STR0004	//"Selecione apenas estabelecimentos com mesma raiz de CNPJ"
							cMsgDesc 	:= STR0005 +aFilBusc[1]+ " (" +Transform(cBaseCNPJ, "@R! NN.NNN.NNN/NNNN-99")+ ") e " +aFilBusc[nEstab]+ " (" +Transform(cEstabCNPJ, "@R! NN.NNN.NNN/NNNN-99")+ STR0006 //"Filiais a1 e aX possuem raízes de CNPJ distintas, verifique os registros selecionados."
							cMsgTipo	:= "error"
							BREAK
						EndIf
					Next
				EndIf
			Else//caso nao informe nao tem a property, filtrar filiais com mesma raiz da logada
				cBaseCNPJ := FWSM0Util():GetSM0Data( cEmpAnt, cFilAnt, {"M0_CGC"} )[1,2]
			EndIf
			aSM0 := FWLoadSM0()
			For nEstab := 1 to Len(aSM0)
				If aSM0[nEstab,1] == cEmpAnt .And. Left(cBaseCNPJ, 8) == Left(aSM0[nEstab,18], 8)
					aAdd(aFilBusc, aSM0[nEstab,2])
				EndIf
			Next

			cMatriz := PadR( fVldMatriz(aFilBusc[1]), FWSizeFilial() )

			nPage := IIf(jQueryParams:hasProperty("page") .AND. Val(jQueryParams["page"]) > 0, Val(jQueryParams["page"]), nPage)
			nPageSize := IIf(jQueryParams:hasProperty("pageSize") .AND. Val(jQueryParams["pageSize"]) > 0, Val(jQueryParams["pageSize"]), nPageSize)

			cQuery := "SELECT SRA.RA_CIC, RUW.RUW_MESES, MAX(SRA.RA_NOMECMP) RA_NOMECMP, MAX(SRA.RA_NOME) RA_NOME, "
			cQuery += " MIN(SRA.RA_FILIAL) RA_FILIAL, COUNT(DISTINCT SRA.RA_FILIAL) FILIS, MAX(SRA.RA_CATEFD) RA_CATEFD, COUNT(DISTINCT SRA.RA_CATEFD) CATS "
			cQuery += "FROM " +RetSqlName("SRA")+ " SRA "
			cQuery += "LEFT JOIN " +RetSqlName("RUW")+ " RUW ON RUW.RUW_CPF = SRA.RA_CIC "
			cQuery += " AND RUW.RUW_FILIAL = ? "
			cQuery += " AND RUW.RUW_ANO = ? "
			cQuery += " AND RUW.D_E_L_E_T_ = ? "
			cQuery += "WHERE EXISTS( SELECT "
			If !lMiddleware
				cQuery += "T3P_ID FROM " +RetSqlName("T3P")+ " T3P "
				cQuery += "WHERE SRA.RA_CIC=T3P.T3P_CPF "
				cQuery += "AND T3P.T3P_ATIVO = ?  "
				cQuery += "AND T3P.T3P_STATUS = ? "
				cQuery += "AND T3P.T3P_PERAPU LIKE ? "
				cQuery += "AND T3P.D_E_L_E_T_ = ? )"
			Else
				cQuery += "RJE_RETKEY FROM " +RetSqlName("RJE")+ " RJE "
				cQuery += "WHERE SRA.RA_CIC=SUBSTRING(RJE_KEY,8,11) "
				cQuery += "AND RJE.RJE_EVENTO = ? "
				cQuery += "AND RJE.RJE_INSCR = ? "
				cQuery += "AND RJE.RJE_EXC = ? "
				cQuery += "AND RJE.RJE_STATUS = ? "
				cQuery += "AND RJE.RJE_INI LIKE ? "
				cQuery += "AND RJE.D_E_L_E_T_ = ? )"
			EndIf
			If !Empty(cCpfBusc)
				cQuery += "AND SRA.RA_CIC = ? "
			EndIf
			If !Empty(aFilBusc)
				cQuery += "AND SRA.RA_FILIAL IN (?) "
			EndIf
			cQuery += "AND SRA.D_E_L_E_T_ = ? "

			cQuery += " GROUP BY SRA.RA_CIC, RUW.RUW_MESES "
			cQuery += " ORDER BY RA_FILIAL, SRA.RA_CIC "
			cQuery := ChangeQuery(cQuery)

			// Instancia a classe
			oStatement := FwExecStatement():New(cQuery)

			oStatement:SetString(nParamOrder++, cMatriz)
			oStatement:SetString(nParamOrder++, cAnoRetf)
			oStatement:SetString(nParamOrder++, " ")
			If lMiddleware
				oStatement:SetString(nParamOrder++, "S1210")
				oStatement:SetString(nParamOrder++, Left(cBaseCNPJ, 8) )
			EndIf
			oStatement:SetString(nParamOrder++, If(lMiddleware, " ","1"))
			oStatement:SetString(nParamOrder++, "4")
			oStatement:SetString(nParamOrder++, cAnoBusc + "%")
			oStatement:SetString(nParamOrder++, " ")

			If !Empty(cCpfBusc)
				oStatement:SetString(nParamOrder++, cCpfBusc)
			EndIf
			If !Empty(aFilBusc)
				oStatement:SetIN(nParamOrder++, aFilBusc)
			Endif
			oStatement:SetString(nParamOrder++, " ")

			// Executa a query e retorna o alias criado
			cAlias 	:= oStatement:OpenAlias()

			// Conta a quantidade total de registros da query
			Count To nTotal
			If (nPage > 1)
				(cAlias)->(DBSkip((nPage - 1) * nPageSize))
			EndIf

			While ((cAlias)->(!EOF()) .and. nCount <= nPageSize)

				aFiliais := {}
				aCategs  := {}
				aMesesRUW := {}

				If (cAlias)->FILIS > 1 .Or. (cAlias)->CATS > 1 //MV
					GetVincs((cAlias)->RA_CIC, @aFiliais, @aCategs, aFilBusc)
				Endif

				cFuncType := If( (cAlias)->RA_CATEFD $ cCatsTCV, "Funcionário", "Prestador" )
				If (cAlias)->CATS > 1 .And. Left((cAlias)->RA_CATEFD, 1) > "1"
					lTCV := aScan(aCategs, {|x| x $ cCatsTCV}) > 0
					lTSV := aScan(aCategs, {|x| !(x $ cCatsTCV)}) > 0
					cFuncType := If( !lTSV, "Funcionário", If( !lTCV, "Prestador", "Funcionário/Prestador") )
				EndIf

				cNome := If( Empty((cAlias)->RA_NOMECMP), (cAlias)->RA_NOME , (cAlias)->RA_NOMECMP )

				aPerAnts := GetPerAnts((cAlias)->RA_CIC, cAnoBusc, aFilBusc, lMiddleware, Left(cBaseCNPJ,8) )

				If !Empty((cAlias)->RUW_MESES)
					aMesesRUW := StrTokArr((cAlias)->RUW_MESES, '|')
					For nI := 1 to Len(aMesesRUW)
						aMesesRUW[nI] := Val(aMesesRUW[nI])
					Next
				EndIf

				oItem := JSonObject():new()

				oItem["id"] 				:= cAnoRetf + "-" + (cAlias)->RA_CIC
				oItem["yearRectif"] 		:= Val(cAnoRetf)
				oItem["companyCode"] 		:= cEmpAnt
				oItem["branchCode"] 		:= cMatriz
				oItem["type"]				:= cFuncType
				oItem["registrationNumber"]	:= (cAlias)->RA_CIC
				oItem["name"] 				:= cNome
				oItem["enableMonths"] 		:= aPerAnts
				oItem["months"] 			:= aMesesRUW

				aadd(oResponse["items"], oItem)

				(cAlias)->(DbSkip())
				nCount++
			End

			lHasNext := (nCount > nPageSize .AND.!(cAlias)->(EOF()))
			oResponse["HasNext"] := lHasNext
			oResponse["total"] := nCount-1

			(cAlias)->(DbCloseArea())
		EndIf

    RECOVER
        If nErroCod == 0  // Só sobrescreve se ainda não houver erro definido
            nErroCod 	:= 500
            cMsg 		:= STR0001//"Erro"
            cMsgDesc 	:= "Internal Server Error"
            cMsgTipo	:= "error"
        Endif


    END SEQUENCE

    fSetResponse(nErroCod, cMsg, cMsgDesc, cMsgTipo)
Return

/*/{Protheus.doc} putRetifRUW
	Grava os meses a serem retificados na RUW
@type		Method
@version	12.1.2510
@author		isabel.noguti
@since		09/01/2026
@return Variant, Retorno nulo pre-fixado
/*/
method putRetifRUW() class GPERetifS1210
    Local jBParams 		:= JsonObject():New()			as Json
    Local nErroCod 		:= 0 							as Numeric
    Local cMsg			:= ""							as Character
    Local cMsgDesc		:= ""							as Character
    Local cMsgTipo		:= ""							as Character
	Local cId			:= ""							as Character
	Local cMeses		:= ""							as Character
	Local cFilRUW		:= ""							as Character

    Private oResponse := JsonObject():New()			as Json

	jBParams:fromJson( oRest:getBodyRequest() )
    oRest:updateKeyHeaderResponse("Content-Type", "text/plain; charset=utf-8")

    BEGIN SEQUENCE
        If jBParams:hasProperty("forcaErro")
            BREAK
        Endif

        // Verifica se a tabela RUV existe
        If !AliasInDic("RUW")
            nErroCod 	:= 400
            cMsg 		:= STR0002//"Tabela não encontrada"
            cMsgDesc 	:= STR0003//"A tabela RUW não foi encontrada no dicionário de dados"
            cMsgTipo	:= "error"
            BREAK
        Endif

		If jBParams:hasProperty("id") .And. !Empty(jBParams['id'])
			cId := jBParams['id']

			If jBParams:hasProperty("branchCode") .AND. !Empty(jBParams['branchCode'])
				cFilRUW := jBParams['branchCode']
			EndIf

			If jBParams:hasProperty("months") .AND. !Empty(jBParams['months'])
				cMeses := ArrTokStr(jBParams['months'])
			EndIf

			DbSelectArea("RUW")//RUW_FILIAL+RUW_ANO+RUW_CPF
			If RUW->(dbseek(cFilRUW + StrTran(cId, "-") ))
				If RUW->RUW_MESES <> cMeses
					Reclock("RUW",.F.)
					If( Empty(cMeses), RUW->(dbDelete()), RUW->RUW_MESES := cMeses )
					MsUnlock()
				EndIf
			ElseIf !Empty(cMeses) //grava do zero
				Reclock("RUW",.T.)

				RUW->RUW_FILIAL := cFilRUW

				If jBParams:hasProperty("yearRectif") .AND. !Empty(jBParams['yearRectif'])
					RUW->RUW_ANO := cValtoChar(jBParams['yearRectif'])
				EndIf
				If jBParams:hasProperty("registrationNumber") .AND. !Empty(jBParams['registrationNumber'])
					RUW->RUW_CPF := jBParams['registrationNumber']
				EndIf
				RUW->RUW_MESES	:= cMeses

				MsUnlock()
			EndIf
		EndIf


    RECOVER
        If nErroCod == 0  // Só sobrescreve se ainda não houver erro definido
            nErroCod 	:= 500
            cMsg 		:= STR0001//"Erro"
            cMsgDesc 	:= "Internal Server Error"
            cMsgTipo	:= "error"
        Endif


    END SEQUENCE

    fSetResponse(nErroCod, cMsg, cMsgDesc, cMsgTipo)
return

/*/{Protheus.doc} fSetResponse
	Seta a resposta para o PO-UI.
	@type Method
	@version 12.1.2410
	@author Caio Kretzer
	@since 10/12/2025
	@return Variant, Retorno nulo pre-fixado
	@obs Foi necessaria a criacao para passar no issue x cobertura de todas as APIs.
/*/
Static Function fSetResponse(nErroCod As Numeric, cMsg As Character, cMsgDesc As Character, cMsgTipo As Character)
	if nErroCod > 0
		oRest:setStatusCode(nErroCod)
		oRest:setFault(fGetJsonErro(nErroCod, cMsg, cMsgDesc, cMsgTipo))
	else
		oRest:setResponse(fGetJsonMsg(cMsg, cMsgDesc, cMsgTipo))
	endif
Return

/*/{Protheus.doc} fGetJsonErro
	Retorna o json de erro para o POUI.
	@type Method
	@version 12.1.2410
	@author Caio Kretzer
	@since 10/12/2025
	@param nErroCod, Numeric, Código do erro
	@param cMsg, Character, Mensagem do erro
	@param cMsgDesc, Character, Descrição detalhada do erro
	@param cMsgTipo, Character, Tipo da mensagem
	@return Character, Mensagem de erro
/*/
Static Function fGetJsonErro(nErroCod As Numeric, cMsg As Character, cMsgDesc As Character, cMsgTipo As Character) As Character
	Local oPouiError 	:= JsonObject():new() as Json

	oPouiError["message"]         	:= cMsg
	oPouiError["detailedMessage"] 	:= cMsgDesc
	oPouiError["code"]            	:= nErroCod
	oPouiError["type"]            	:= cMsgTipo
Return EncodeUTF8(FwCutOff(oPouiError:toJson()))

/*/{Protheus.doc} fGetJsonMsg
	Retorna o JSON para o POUI (com alguma mensagem, se necessario).
