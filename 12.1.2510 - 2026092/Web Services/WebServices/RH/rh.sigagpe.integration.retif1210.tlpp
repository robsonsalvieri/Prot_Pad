	// 	oItemMsg["type"]            := cMsgTipo

	// 	aadd(oResponse["_messages"],oItemMsg)
	// Endif
Return EncodeUTF8(FwCutOff(oResponse:toJson()))


/*/{Protheus.doc} GetVincs
Busca os demais vínculos em caso de múltiplas filiais ou categorias
@version	12.1.2510
@author		isabel.noguti
@since		14/01/2026
@param cCpf, Character, cpf a ser pesquisado
@param aFils, array, retorno com as filiais encontradas
@param aCats, array, retorno com as categorias encontradas
@param aFilQry, array, filtro de filiais caso selecionado no lookup
@return Variant, Retorno nulo pre-fixado
/*/
Static Function GetVincs(cCpf, aFils, aCats, aFilQry)
	Local cQuery	:= ""
	Local cQrAlias	:= ""

	Default cCpf	:= ""
	Default aFils	:= {}
	Default aCats	:= {}
	Default aFilQry	:= {}
	Default oVincSRA := Nil

	If !Empty(cCpf)
		If oVincSRA == Nil
			cQuery := "SELECT RA_FILIAL, RA_MAT, RA_CATEFD "
			cQuery += "FROM "+ RetSqlName("SRA") + " SRA "
			cQuery += "WHERE SRA.RA_CIC = ? "
			cQuery += " AND SRA.D_E_L_E_T_ = ? "
			If !Empty(aFilQry)
				cQuery += "AND SRA.RA_FILIAL IN (?) "
			EndIf

			cQuery := ChangeQuery(cQuery)
			oVincSRA := FwExecStatement():New(cQuery)
		EndIf

		oVincSRA:SetString(1, cCpf )
		oVincSRA:SetString(2, " " )
		If !Empty(aFilQry)
			oVincSRA:SetIN(3, aFilQry)
		Endif

		cQrAlias := oVincSRA:OpenAlias()

		While (cQrAlias)->(!Eof())
			aAdd(aFils, (cQrAlias)->RA_FILIAL )
			If( !Empty((cQrAlias)->RA_CATEFD), aAdd(aCats, (cQrAlias)->RA_CATEFD), ) //cCats += (cQrAlias)->RA_CATEFD)
			(cQrAlias)->(DBSkip())
		EndDo
		(cQrAlias)->(DbCloseArea())
	EndIf

Return

/*/{Protheus.doc} GetPerAnts
Busca os períodos que possui S-1210 transmitido
@version	12.1.2510
@author		isabel.noguti
@since		14/01/2026
@param cCpf, Character, cpf a ser pesquisado
@param cAnoB, Character, ano a ser pesquisado
@param aFilQry, array, filtro de filiais caso selecionado no lookup
@return aMeses, array, retorno com os meses encontrados em formato numérico
/*/
Static Function GetPerAnts(cCpf, cAnoB, aFilQry, lMiddleware, cRaizCnpj )
	Local cQuery	:= ""
	Local cQrAlias	:= ""
	Local aMeses 	:= {}
	Local nParamOrd	:= 1

	Default cCpf		:= ""
	Default cAnoB		:= ""
	Default aFilQry		:= {}
	Default oSt1210		:= Nil
	Default lMiddleware	:= .F.
	Default cRaizCnpj	:= ""

	If !Empty(cCpf)
		If oSt1210 == Nil
			If lMiddleware
				cQuery := "SELECT DISTINCT RJE_INI AS T3P_PERAPU "
				cQuery += "FROM "+ RetSqlName("RJE") + " RJE "
				cQuery += "WHERE RJE_EVENTO = ? "
				cQuery += " AND RJE_INSCR = ? "
				cQuery += " AND SUBSTRING(RJE_KEY,8,11) = ? "
				cQuery += " AND RJE_INI LIKE ? "
				cQuery += " AND RJE_EXC = ? "
				cQuery += " AND RJE_STATUS = ? "
				cQuery += " AND D_E_L_E_T_ = ? "
				If !Empty(aFilQry)
					cQuery += "AND RJE_FIL IN (?) "
				EndIf
			Else
				cQuery := "SELECT T3P_PERAPU "
				cQuery += "FROM "+ RetSqlName("T3P") + " T3P "
				cQuery += "WHERE T3P_CPF = ? "
				cQuery += " AND T3P_PERAPU LIKE ? "
				cQuery += " AND T3P_ATIVO = ? "
				cQuery += " AND T3P_STATUS = ? "
				cQuery += " AND D_E_L_E_T_ = ? "
				If !Empty(aFilQry)
					cQuery += "AND T3P_FILIAL IN (?) "
				EndIf
			EndIf

			cQuery := ChangeQuery(cQuery)
			oSt1210 := FwExecStatement():New(cQuery)
		EndIf

		If lMiddleware
			oSt1210:SetString(nParamOrd++, "S1210" )
			oSt1210:SetString(nParamOrd++, cRaizCnpj )
		EndIf
		oSt1210:SetString(nParamOrd++, cCpf )
		oSt1210:SetString(nParamOrd++, cAnoB + "%")
		oSt1210:SetString(nParamOrd++, If(lMiddleware, " ", "1") )
		oSt1210:SetString(nParamOrd++, "4" )
		oSt1210:SetString(nParamOrd++, " " )
		If !Empty(aFilQry)
			oSt1210:SetIN(nParamOrd++, aFilQry)
		Endif

		cQrAlias := oSt1210:OpenAlias()

		While (cQrAlias)->(!Eof())
			aAdd(aMeses, Val(Right((cQrAlias)->T3P_PERAPU,2)) )
			(cQrAlias)->(DBSkip())
		EndDo
		(cQrAlias)->(DbCloseArea())
	EndIf

Return aMeses
