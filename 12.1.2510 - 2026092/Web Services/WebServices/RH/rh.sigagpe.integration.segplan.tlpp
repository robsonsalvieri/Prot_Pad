#Include "tlpp-core.th"
#Include "tlpp-rest.th"
#Include "totvs.ch"
#Include "FWLIBVERSION.ch"
#Include "rh.sigagpe.integration.segplan.ch"

class GPESegPlan
	@Get("api/rh/v1/segundo-plano/log-execucoes")
	public method getLogExecucoesSegPlan()

	@Get("api/rh/v1/segundo-plano/log-execucoes/arquivo/:NREGRUV")
	public method getArquivoSegPlano()

	public method new() constructor
endclass

/*/{Protheus.doc} new
	Inicializador da classe.
	@type Method
	@version 12.1.2410
	@author Caio Kretzer
	@since 10/12/2025
	@return Variant, Instancia da classe
/*/
method new() class GPESegPlan
return self

/*/{Protheus.doc} getLogExecucoesSegPlan
	Retorna o log de execuções do segundo plano 
	@type Method
	@version 12.1.2410
	@author Caio Kretzer
	@since 10/12/2025
	@return Variant, Retorno nulo pre-fixado
/*/
method getLogExecucoesSegPlan() class GPESegPlan
    Local jQueryParams 	:= oRest:getQueryRequest()	as Json
    Local nErroCod 		:= 0 						as Numeric
    Local cMsg			:= ""						as Character
    Local cMsgDesc		:= ""						as Character
    Local cMsgTipo		:= ""						as Character
    Local nParamOrder	:= 1						as Numeric
    Local cAlias		:= ""						as Character
    Local cQuery		:= ""						as Character
    Local oStatement	:= NIL						as Object
    Local oItem			:= NIL						as Object
    Local nPage			:= 1						as Numeric
    Local nPageSize		:= 999						as Numeric
    Local nTotal		:= 0						as Numeric
    Local nCount		:= 1						as Numeric
    Local lHasNext		:= .F.						as Logical

    Private oResponse := JsonObject():New()			as Json

    oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

    BEGIN SEQUENCE
        If jQueryParams:hasProperty("forcaErro")
            BREAK
        Endif

        oResponse["items"] := {}

        // Verifica se a tabela RUV existe
        If !AliasInDic("RUV")
            oResponse["lHasNext"] := .F.
            nErroCod 	:= 400
            cMsg 		:= STR0003
            cMsgDesc 	:= STR0004
            cMsgTipo	:= "error"
            BREAK
        Endif

        nPage := IIf(jQueryParams:hasProperty("page") .AND. Val(jQueryParams["page"]) > 0, Val(jQueryParams["page"]), nPage)
        nPageSize := IIf(jQueryParams:hasProperty("pageSize") .AND. Val(jQueryParams["pageSize"]) > 0, Val(jQueryParams["pageSize"]), nPageSize)
        
        cQuery := " SELECT RUV.RUV_FILIAL, RUV.RUV_CODIGO, RUV.RUV_DATA, RUV.RUV_HORA, RUV.RUV_DESC, RUV.RUV_DOWNL, RUV.RUV_ARQUIV, RUV.R_E_C_N_O_ REGRUV "
        cQuery += " FROM "+RetSqlName("RUV")+" RUV "
        cQuery += " WHERE RUV.RUV_FILIAL = ? "
        cQuery += "   AND RUV.RUV_USER   = ? "

        If jQueryParams:hasProperty("DRUVDATADE") .AND. !Empty(jQueryParams['DRUVDATADE'])
            cQuery += " AND RUV.RUV_DATA >= ? "
        Endif

        If jQueryParams:hasProperty("DRUVDATAATE") .AND. !Empty(jQueryParams['DRUVDATAATE'])
            cQuery += " AND RUV.RUV_DATA <= ? "
        Endif

        cQuery += "   AND RUV.D_E_L_E_T_ = ? "
        cQuery += " ORDER BY RUV.RUV_DATA DESC, RUV.RUV_HORA DESC "
        cQuery := ChangeQuery(cQuery)

        // Instancia a classe
        oStatement := FwExecStatement():New(cQuery)

        oStatement:SetString(nParamOrder++, xFilial("RUV"))
        oStatement:SetString(nParamOrder++, __cUserID)

        If jQueryParams:hasProperty("DRUVDATADE") .AND. !Empty(jQueryParams['DRUVDATADE'])
            oStatement:SetString(nParamOrder++, StrTran(SubStr(jQueryParams["DRUVDATADE"],  1, 10), "-", ""))
        Endif

        If jQueryParams:hasProperty("DRUVDATAATE") .AND. !Empty(jQueryParams['DRUVDATAATE'])
            oStatement:SetString(nParamOrder++, StrTran(SubStr(jQueryParams["DRUVDATAATE"],  1, 10), "-", ""))
        Endif

        oStatement:SetString(nParamOrder++, " ")

        // Executa a query e retorna o alias criado
        cAlias 	:= oStatement:OpenAlias()

        // Conta a quantidade total de registros da query
        Count To nTotal
        If (nPage > 1)
            (cAlias)->(DBSkip((nPage - 1) * nPageSize))
        EndIf

        While (!(cAlias)->(EOF()) .and. nCount <= nPageSize)

            oItem := JSonObject():new()
            oItem["CRUVFILIAL"] 	:= RTrim((cAlias)->RUV_FILIAL)
            oItem["CRUVCODIGO"] 	:= RTrim((cAlias)->RUV_CODIGO)
            oItem["CRUVDESC"] 		:= RTrim((cAlias)->RUV_DESC)
            oItem["CRUVDOWNL"] 		:= RTrim((cAlias)->RUV_DOWNL)
            oItem["CRUVARQUIV"]		:= RTrim((cAlias)->RUV_ARQUIV)
            oItem["DRUVDATA"] 		:= fDateToJson(StoD((cAlias)->RUV_DATA))
            oItem["CRUVHORA"] 		:= RTrim((cAlias)->RUV_HORA)
            oItem["NREGRUV"] 		:= (cAlias)->REGRUV

            aadd(oResponse["items"], oItem)

            (cAlias)->(DbSkip())
            nCount++
        End

        lHasNext := (nCount > nPageSize .AND.!(cAlias)->(EOF()))
        oResponse["lHasNext"] := lHasNext

        (cAlias)->(DbCloseArea())
    RECOVER
        If nErroCod == 0  // Só sobrescreve se ainda não houver erro definido
            nErroCod 	:= 500
            cMsg 		:= STR0001
            cMsgDesc 	:= "Internal Server Error"
            cMsgTipo	:= "error"
        Endif

        (cAlias)->(dbCloseArea())
    END SEQUENCE

    fSetResponse(nErroCod, cMsg, cMsgDesc, cMsgTipo)
Return

/*/{Protheus.doc} getArquivoSegPlano
	Retorna o arquivo para download
	@type Method
	@version 12.1.2410
	@author Caio Kretzer
	@since 10/12/2025
	@return Variant, Retorno nulo pre-fixado
/*/
method getArquivoSegPlano() class GPESegPlan
    Local jPathParams 	:= oRest:getPathParamsRequest()	as Json
    Local jQueryParams 	:= oRest:getQueryRequest()		as Json
    Local nErroCod 		:= 0 							as Numeric
    Local cMsg			:= ""							as Character
    Local cMsgDesc		:= ""							as Character
    Local cMsgTipo		:= ""							as Character
    Local cFilePath		:= ""							as Character
    Local cFile											as Character
    Local oFile											as Object

    Private oResponse := JsonObject():New()			as Json

    oRest:updateKeyHeaderResponse("Content-Type", "text/plain; charset=utf-8")

    BEGIN SEQUENCE
        If jQueryParams:hasProperty("forcaErro")
            BREAK
        Endif

        // Verifica se a tabela RUV existe
        If !AliasInDic("RUV")
            nErroCod 	:= 400
            cMsg 		:= STR0003
            cMsgDesc 	:= STR0004
            cMsgTipo	:= "error"
            BREAK
        Endif

        DbSelectArea("RUV")
        RUV->(DbGoTo(Val(jPathParams["NREGRUV"])))
        
        cFilePath := RUV->RUV_ARQUIV
        oFile := FwFileReader():New(cFilePath)
        
        RecLock("RUV",.F.)
        RUV->RUV_DOWNL = '1'
        If oFile:open()
            cFile := oFile:fullRead()
            // Converte de CP1252 (Windows ANSI) para UTF-8
            cFile := EncodeUTF8(cFile)
            oRest:setResponse(cFile)
        Else
            RUV->RUV_ARQUIV = ''
            nErroCod 	:= 401
            cMsg 		:= STR0001
            cMsgDesc 	:= STR0002
            cMsgTipo	:= "error"
        Endif
        MsUnlock()
        oFile:close()
        FreeObj(oFile)
    RECOVER
        If nErroCod == 0  // Só sobrescreve se ainda não houver erro definido
            nErroCod 	:= 500
            cMsg 		:= STR0001
            cMsgDesc 	:= "Internal Server Error"
            cMsgTipo	:= "error"
        Endif

        (cAlias)->(dbCloseArea())
    END SEQUENCE

    fSetResponse(nErroCod, cMsg, cMsgDesc, cMsgTipo)
return

/*/{Protheus.doc} fSetResponse
	Seta a resposta para o PO-UI.
	@type Method
	@version 12.1.2410
	@author Caio Kretzer
	@since 10/12/2025
	@return Variant, Retorno nulo pre-fixado
	@obs Foi necessaria a criacao para passar no issue x cobertura de todas as APIs.
/*/
Static Function fSetResponse(nErroCod As Numeric, cMsg As Character, cMsgDesc As Character, cMsgTipo As Character)
	if nErroCod > 0
		oRest:setStatusCode(nErroCod)
		oRest:setFault(fGetJsonErro(nErroCod, cMsg, cMsgDesc, cMsgTipo))
	else
		oRest:setResponse(fGetJsonMsg(cMsg, cMsgDesc, cMsgTipo))
	endif
Return

/*/{Protheus.doc} fGetJsonErro
	Retorna o json de erro para o POUI.
	@type Method
	@version 12.1.2410
	@author Caio Kretzer
	@since 10/12/2025
	@param nErroCod, Numeric, Código do erro
	@param cMsg, Character, Mensagem do erro
	@param cMsgDesc, Character, Descrição detalhada do erro
	@param cMsgTipo, Character, Tipo da mensagem
	@return Character, Mensagem de erro
/*/
Static Function fGetJsonErro(nErroCod As Numeric, cMsg As Character, cMsgDesc As Character, cMsgTipo As Character) As Character
	Local oPouiError 	:= JsonObject():new() as Json

	oPouiError["message"]         	:= cMsg
	oPouiError["detailedMessage"] 	:= cMsgDesc
	oPouiError["code"]            	:= nErroCod
	oPouiError["type"]            	:= cMsgTipo
Return EncodeUTF8(FwCutOff(oPouiError:toJson()))

/*/{Protheus.doc} fGetJsonMsg
	Retorna o JSON para o POUI (com alguma mensagem, se necessario).
	@type Method
	@version 12.1.2410
