#include "tlpp-core.th"
#include "totvs.ch"

namespace totvs.protheus.backoffice.fiscal.tss.util.integration

static lCanUpSerDoc := nil as variant
static lSPEDTamDoc  := existFunc("SPEDTamDoc") as logical

/*/{Protheus.doc} getTSSId
Função que recebe um JSON com as informações do documento e retorna o ID a ser utilizado na integração com o TSS
@type function
@version 12.1.2510
@author fs.martinez
@since 3/31/2026
@param oInfoDoc, json, JSON contendo as informações do documento, como série, número, modelo, entre outros. 
O JSON pode conter as seguintes chaves: "serie", "doc", "dfe" (tipo de documento fiscal eletrônico), e "legacyid" (ID legado
@return character, ID do TSS
/*/
function getTSSId(oInfoDoc as json) as character
    local cTSSID        := ""           as character
    local cDFe          := ""           as character //NFS-NFE-CTE-NFCE
    local nSerTam       := 3            as integer
    local nDocTam       := 9            as integer
    local aTamDoc       := {}           as array

    //mantem ID do legado
    if oInfoDoc:hasProperty("legacyid")
	    cTSSID := oInfoDoc["legacyid"]
    endIf
    if canUpSerDoc() .and. oInfoDoc:hasProperty("serie") .and. oInfoDoc:hasProperty("doc")
        if oInfoDoc:hasProperty("dfe")
            cDFe := oInfoDoc["dfe"]
        endIf
        if lSPEDTamDoc
            aTamDoc	:= SPEDTamDoc(cDFe)
            nSerTam := aTamDoc[1]
            nDocTam := aTamDoc[2]
		    aTamDoc := aSize(aTamDoc, 0)
        endIf
		cTSSID := padr(oInfoDoc["serie"],nSerTam) + padr(oInfoDoc["doc"],nDocTam)
    endIf
   
return cTSSID

/*/{Protheus.doc} getErpId
Função que recebe o ID do TSS e retorna o número do documento e série no formato do ERP, 
considerando os tamanhos configurados para cada um dos sistemas. 
Exemplo: Recebe um ID do TSS no formato "001000000001" e retorna "001" como série e "000000001" como número do documento, 
caso os tamanhos sejam 3 para série e 9 para documento. A função também considera a possibilidade de ter tamanhos 
diferentes configurados para o TSS e para o ERP, ajustando a extração e formatação dos valores conforme necessário.
@type function
@version 12.1.2510
@author fs.martinez
@since 4/30/2026
@param cIDTSS, character, ID do TSS a ser convertido para o formato do ERP
@param cModelo, character, modelo do documento (NFS, NFE, CTE, NFCE)
@return array, array contendo o ID do ERP, série e número do documento
/*/
function getErpId(cIDTSS, cModelo)
	local cSerieERP 	:= ""
	local cDocERP 		:= ""
	local aTamDoc	    := {}
	local nTamSerTSS	:= 3
	local nTamDocTSS    := 9
	local nTamSerERP	:= 3
	local nTamDocERP    := 9

    if lSPEDTamDoc
        //recupera tamanho TSS
        aTamDoc := SPEDTamDoc(cModelo)
        nTamSerTSS := aTamDoc[1]
	    nTamDocTSS := aTamDoc[2]

        //Recupera tamanho ERP
        aTamDoc := SPEDTamDoc(cModelo, .T.)
        nTamSerERP := aTamDoc[1]
	    nTamDocERP := aTamDoc[2]
        aTamDoc := aSize(aTamDoc,0)
    endIf
	
    //extrai valores com base no tamanhos do ID do TSS
	cSerieERP 	:= padr(subStr(cIDTSS, 1, nTamSerTSS), nTamSerTSS)
	cDocERP 	:= padr(allTrim(subStr(cIDTSS, nTamSerTSS+1)), nTamDocTSS)
    
    //Transforma nos tamanhos do ERP
    cSerieERP   := padr(cSerieERP, nTamSerERP)
    cDocERP     := padr(cDocERP, nTamDocERP)

return {cSerieERP+cDocERP, cSerieERP, cDocERP}

/*/{Protheus.doc} canUpSerDoc
Funcao que indica se é possível atualizar série e documento, considerando a versão do RPO ou a configuração de MV.
@type function
@version 12.1.210
@author fs.martinez
@since 5/4/2026
@return logical, Indica se é possível atualizar série e documento
/*/
function canUpSerDoc()
    if lCanUpSerDoc == nil
        lCanUpSerDoc := GetRpoRelease() >= "12.1.2610" .or. alltrim(supergetmv("MV_NIDTSS", .F., "0")) == "1"
    endIf
return lCanUpSerDoc
