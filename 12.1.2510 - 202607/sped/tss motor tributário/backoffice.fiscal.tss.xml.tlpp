/*{Protheus.doc}
Gera tags do subgrupo gIBSCBSMono() do grupo IBSCBS
@type method
@version  P12 V1.2410
@author Carlos Eduardo Boy
@since 22/05/2025*/
Method getXmlgIBSCBSMono(oJsIbsMonoPadrao as json,;
						 oJsCbsMonoPadrao as json,;
						 oJsIbsMonoRetencao as json,;
						 oJsCbsMonoRetencao as json,;
						 oJsIbsMonoRetido as json,;
						 oJsCbsMonoRetido as json,; 
						 oJsIbsMonoDiferimento as json,;
						 oJsCbsMonoDiferimento as json) as character class TaxInformation
    Local cXml as character
    Local lIbsMonoPadrao 		:= valtype(oJsIbsMonoPadrao) == 'J' as logical
    Local lCbsMonoPadrao 		:= valtype(oJsCbsMonoPadrao) == 'J' as logical
	Local lIbsMonoRetencao 		:= valtype(oJsIbsMonoRetencao) == 'J' as logical
	Local lCbsMonoRetencao 		:= valtype(oJsCbsMonoRetencao) == 'J' as logical
	Local lIbsMonoRetido 		:= valtype(oJsIbsMonoRetido) == 'J' as logical
	Local lCbsMonoRetido 		:= valtype(oJsCbsMonoRetido) == 'J' as logical
	Local lIbsMonoDiferimento 	:= valtype(oJsIbsMonoDiferimento) == 'J' as logical
	Local lCbsMonoDiferimento 	:= valtype(oJsCbsMonoDiferimento) == 'J' as logical
	Local nTotalValorIbsMono as numeric
	Local nTotalValorCbsMono as numeric

    //Verifica se algum dos tributos monofásicos foram encontrados
	if lIbsMonoPadrao .or. lCbsMonoPadrao .or. lIbsMonoRetencao .or. lCbsMonoRetencao .or. lIbsMonoRetido .or. lCbsMonoRetido .or. lIbsMonoDiferimento .or. lCbsMonoDiferimento
        cXml += '<gIBSCBSMono>'
		cXml +=     self:getXmlMonoPadrao(oJsIbsMonoPadrao, lIbsMonoPadrao, oJsCbsMonoPadrao, lCbsMonoPadrao, @nTotalValorIbsMono, @nTotalValorCbsMono)
		cXml +=     self:getXmlMonoRetencao(oJsIbsMonoRetencao, lIbsMonoRetencao, oJsCbsMonoRetencao, lCbsMonoRetencao, @nTotalValorIbsMono, @nTotalValorCbsMono)
		cXml +=     self:getXmlMonoRetido(oJsIbsMonoRetido, lIbsMonoRetido, oJsCbsMonoRetido, lCbsMonoRetido, @nTotalValorIbsMono, @nTotalValorCbsMono)
		cXml +=     self:getXmlMonoDiferimento(oJsIbsMonoDiferimento, lIbsMonoDiferimento, oJsCbsMonoDiferimento, lCbsMonoDiferimento, @nTotalValorIbsMono, @nTotalValorCbsMono)
        cXml +=     '<vTotIBSMonoItem>' + ltrim(str(nTotalValorIbsMono,13,2)) + '</vTotIBSMonoItem>'
        cXml +=     '<vTotCBSMonoItem>' + ltrim(str(nTotalValorCbsMono,13,2))  + '</vTotCBSMonoItem>'
        cXml += '</gIBSCBSMono>'
    endif
return cXml

