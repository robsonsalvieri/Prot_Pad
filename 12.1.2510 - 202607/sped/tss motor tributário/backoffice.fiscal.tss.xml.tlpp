/*/{Protheus.doc}
Totaliza o valor dos tributos para geração das tags de total do XML
@type method
@version  P12 V1.2410
@author Carlos Eduardo Boy
@since 02/07/2025
/*/
Method setTotalTaxByTotvsId(oJsTax as json, lXmlgIBSCBS as logical, cCondSusPreIbs as character, cCondSusPreCbs as character ) class TaxInformation
	Local cIdTotvsTrib as character
	Default lXmlgIBSCBS := .T.
	Default cCondSusPreIbs := ""
	Default cCondSusPreCbs := ""

	if oJsTax != nil
		cIdTotvsTrib := oJsTax['codigo_tributo_relacionado']

		if !::oTotalTaxByTotvsId:HasProperty(cIdTotvsTrib)
			::oTotalTaxByTotvsId[cIdTotvsTrib] := JsonObject():New()
			::oTotalTaxByTotvsId[cIdTotvsTrib]['total_diferimento'] 	:= 0
			::oTotalTaxByTotvsId[cIdTotvsTrib]['total_tributo']     	:= 0
			::oTotalTaxByTotvsId[cIdTotvsTrib]['total_estorno_cred']	:= 0
		endif

		if cIdTotvsTrib $ (IBS_ESTADUAL + '|' +  IBS_MUNICIPAL + '|' + CBS_FEDERAL) .and. !::lTagEstCred
			::oTotalTaxByTotvsId[cIdTotvsTrib]['total_diferimento'] += oJsTax['dados_escriturados']['valor_diferido']
		endif

		::oTotalTaxByTotvsId[cIdTotvsTrib]['total_estorno_cred'] += oJsTax['dados_escriturados']['valor_tributado']
		
		If !::lTagEstCred
			::oTotalTaxByTotvsId[cIdTotvsTrib]['total_tributo'] += oJsTax['dados_escriturados']['valor_tributado']
		EndIf

		if cIdTotvsTrib == IBS_CRED_PRESUMIDO
			::oTotalTaxByTotvsId[cIdTotvsTrib]['presumido_cond_suspen'] := cCondSusPreIbs
		endif

		if cIdTotvsTrib == CBS_CRED_PRESUMIDO
			::oTotalTaxByTotvsId[cIdTotvsTrib]['presumido_cond_suspen'] := cCondSusPreCbs
		endif

		if !lXmlgIBSCBS
			::oTotalTaxByTotvsId[cIdTotvsTrib]['total_tributo'] += 0
		endif
	endif

return

/*/{Protheus.doc}
Libera os recursos utilizados pela instância da classe
@type method
@version  P12 V1.2410
@author Carlos Eduardo Boy
@since 03/07/2025
/*/
Method Destroy() class TaxInformation
	FreeObj(::oTotalTaxByTotvsId)
	::oTotalTaxByTotvsId := nil
Return

/*/{Protheus.doc} getXmlTotalIbsCbsIs
Gera a tag principal do total dos  tributos CBS/IBS/IS.
@type method
@author Evandro Italo,
@since 21/05/2025
/*/
Method getXmlTotalIbsCbsIs() as character Class TaxInformation
	Local cXml as character

	cXml += self:getXmlTotalIs()
	cXml += self:getXmlTotalIbsCbs()

Return cXml

/*/{Protheus.doc} getXmlTotalIs
Gera a tag do total do imposto seletivo (IS) 
@type method
@author Evandro Italo,
@since 21/05/2025
/*/
Method getXmlTotalIs() as character class TaxInformation
	Local cXml as character

	if ::oTotalTaxByTotvsId:HasProperty(IMPOSTO_SELETIVO)
		cXml += '<ISTot>'
		cXml +=     '<vIS>' + alltrim(str(::oTotalTaxByTotvsId[IMPOSTO_SELETIVO]['total_tributo'],13,2)) + '</vIS>'
		cXml += '</ISTot>'
	endif

return cXml

/*/{Protheus.doc} getXmlTotalIbsCbs
Gera as tags dos totais dos tributos IBS e CBS
@type method
@author Evandro Italo,
@since 21/05/2025
/*/
Method getXmlTotalIbsCbs() as character class TaxInformation
	Local cXml 	      as character
	Local cXmlIbs     as character
	Local cXmlCbs     as character
	Local cXmlMono    as character
	Local cXmlEstCred as character
	Local lGeraGrupo  as logical


	if ::oTotalTaxByTotvsId:HasProperty(IBS_ESTADUAL) .or. ::oTotalTaxByTotvsId:HasProperty(IBS_MUNICIPAL) 
		cXmlIbs := self:getXmlTotalgIBS()
		lGeraGrupo := .t.
	endif	

	if ::oTotalTaxByTotvsId:HasProperty(CBS_FEDERAL)
		cXmlCbs := self:getXmlTotalgCbs()
		lGeraGrupo := .t.
	endif		

	if self:getXmlTotalgMono(@cXmlMono)
		lGeraGrupo := .t.
	endif	

	if ::lTagEstCred .And. !::lXmlEnv
		cXmlEstCred := self:getXmlTotalgEstornoCred()
		lGeraGrupo  := .t.
	endif
	
	if lGeraGrupo
		cXml += '<IBSCBSTot>'
		cXml +=     '<vBCIBSCBS>'+ lTrim(str(::nTotalBaseIbsCbs,13,2)) +'</vBCIBSCBS>'
		cXml +=  	cXmlIbs   
		cXml +=  	cXmlCbs
		cXml +=  	cXmlMono   
		cXml +=     cXmlEstCred
		cXml += '</IBSCBSTot>'
	endif

return cXml

/*/{Protheus.doc} getXmlTotalDFE
Gera a tag vTotDFe somando o Total da NF com os tributos IBS e CBS
@type method
@author Rodrigo Pirolo
@since 21/05/2025
/*/

Method getXmlTotalDFE( nVNF ) as character class TaxInformation
	Local cXml 		as character
	Local nTotTrib 	as Numeric
	Local nIBSEst 	as Numeric
	Local nIBSMun 	as Numeric
	Local nCBS 		as Numeric

	Default nVNF := 0

	If ::oTotalTaxByTotvsId:HasProperty( IBS_ESTADUAL )
        nIBSEst := ::oTotalTaxByTotvsId[IBS_ESTADUAL]["total_tributo"]
    EndIf

	If ::oTotalTaxByTotvsId:HasProperty( IBS_MUNICIPAL )
        nIBSMun := ::oTotalTaxByTotvsId[IBS_MUNICIPAL]["total_tributo"]
    EndIf

	If ::oTotalTaxByTotvsId:HasProperty( CBS_FEDERAL )
        nCBS := ::oTotalTaxByTotvsId[CBS_FEDERAL]["total_tributo"]
    EndIf

	nTotTrib := nIBSEst + nIBSMun + nCBS

	If nTotTrib > 0
		cXml += '<vTotDFe>' + LTrim( Str( nVNF + nTotTrib, 13, 2 ) ) + '</vTotDFe>'
	EndIf

return cXml

/*/{Protheus.doc} getXmlTotalgIBS
Gera as tags de totalização do do subgrupo gIBS
@type method
@author Evandro Italo
@since 21/05/2025
/*/
Method getXmlTotalgIBS() as character Class TaxInformation
	Local cXml as character
	Local nTotalIbs as numeric

	cXml += '<gIBS>' // Tag W36
	cXml +=     self:getXmlTotalgIbsUf(@nTotalIbs)
	cXml +=     self:getXmlTotalgIbsMun(@nTotalIbs)
	cXml +=     '<vIBS>' + lTrim(Str(nTotalIbs,13,2)) + '</vIBS>'
	if self:cModelo $ "55-56"
		if ::oTotalTaxByTotvsId:HasProperty(IBS_CRED_PRESUMIDO)
			if ::oTotalTaxByTotvsId[IBS_CRED_PRESUMIDO]['presumido_cond_suspen'] != "S"
				cXml +=     '<vCredPres>' + lTrim(Str(::oTotalTaxByTotvsId[IBS_CRED_PRESUMIDO]['total_tributo'],13,2)) + '</vCredPres>' 
				cXml +=     '<vCredPresCondSus>' + lTrim(Str(0,13,2)) + '</vCredPresCondSus>' //Envio de valor zerado devido a falha no eschema se não enviar a TAG
			else
				cXml +=     '<vCredPres>' + lTrim(Str(0,13,2)) + '</vCredPres>' //Envio de valor zerado devido a falha no eschema se não enviar a TAG
				cXml +=     '<vCredPresCondSus>' + lTrim(Str(::oTotalTaxByTotvsId[IBS_CRED_PRESUMIDO]['total_tributo'],13,2)) + '</vCredPresCondSus>' 
			endif
		else
			cXml +=     '<vCredPres>' + lTrim(str(0, 13, 2)) + '</vCredPres>' 
			cXml +=     '<vCredPresCondSus>' + lTrim(str(0, 13, 2)) + '</vCredPresCondSus>'
		endif
	endIf
	cXml += '</gIBS>'

Return cXml

/*/{Protheus.doc}getXmlTotalgIbsUf
Gera as tags de totalização do subgrupo gIBSUF
@type method
@author Evandro Italo
@since 21/05/2025
/*/
Method getXmlTotalgIbsUf(nTotalIbs as numeric) as character Class TaxInformation
	Local cXml as character
	Local nTotalDiferimento as numeric
	Local nTotalDevolucaoTributo as numeric
	Local nTotalTributo as numeric

	if ::oTotalTaxByTotvsId:HasProperty(IBS_ESTADUAL)
		nTotalDiferimento := ::oTotalTaxByTotvsId[IBS_ESTADUAL]['total_diferimento']
		nTotalDevolucaoTributo := 0 //::oTotalTaxByTotvsId[IBS_ESTADUAL]['total_devolucao_tributo']
		nTotalTributo := ::oTotalTaxByTotvsId[IBS_ESTADUAL]['total_tributo']
	endif

	cXml += '<gIBSUF>'
	cXml +=     '<vDif>' + lTrim(str( nTotalDiferimento,13,2)) + '</vDif>'
	cXml +=     '<vDevTrib>' + lTrim(str(nTotalDevolucaoTributo, 13, 2)) + '</vDevTrib>'
	cXml +=     '<vIBSUF>' + lTrim(str(nTotalTributo,13,2)) + '</vIBSUF>'
	cXml += '</gIBSUF>'

	nTotalIbs += nTotalTributo
Return cXml

/*/{Protheus.doc}getXmlTotalgIbsMun
Gera as tags de totalização do subgrupo gIBSMun
@type method
@author Evandro Italo
@since 21/05/2025
/*/
Method getXmlTotalgIbsMun(nTotalIbs as numeric) as character Class TaxInformation
	Local cXml as character
	Local nTotalDiferimento as numeric
	Local nTotalDevolucaoTributo as numeric
	Local nTotalTributo as numeric

	if ::oTotalTaxByTotvsId:HasProperty(IBS_MUNICIPAL)
		nTotalDiferimento := ::oTotalTaxByTotvsId[IBS_MUNICIPAL]['total_diferimento']
		nTotalDevolucaoTributo := 0 //::oTotalTaxByTotvsId[IBS_MUNICIPAL]['total_devolucao_tributo']
		nTotalTributo := ::oTotalTaxByTotvsId[IBS_MUNICIPAL]['total_tributo']
	endif

	cXml += '<gIBSMun>'
	cXml +=     '<vDif>' + lTrim(Str(nTotalDiferimento,13,2)) + '</vDif>'
	cXml +=     '<vDevTrib>' + lTrim(str(nTotalDevolucaoTributo, 13, 2)) + '</vDevTrib>' //lTrim(str(nTotalDevolucaoTributo, 13, 2))
	cXml +=     '<vIBSMun>' + lTrim(Str(nTotalTributo,13,2)) + '</vIBSMun>'
	cXml += '</gIBSMun>'

	nTotalIbs += nTotalTributo

Return cXml

/*/{Protheus.doc} getXmlTotalgCbs()
Gera as tags de totalização do subgrupo gCBS
@type method
@author Evandro Italo
@since 21/05/2025
/*/
Method getXmlTotalgCbs() as character Class TaxInformation
	Local cXml as character

	cXml += '<gCBS>'
	cXml +=     '<vDif>' + lTrim(Str(::oTotalTaxByTotvsId[CBS_FEDERAL]['total_diferimento'],13,2)) + '</vDif>'
	cXml +=     '<vDevTrib>' + lTrim(str(0, 13, 2)) + '</vDevTrib>'
	cXml +=     '<vCBS>' + lTrim(Str(::oTotalTaxByTotvsId[CBS_FEDERAL]['total_tributo'],13,2)) +  '</vCBS>'
	if self:cModelo $ "55-56"
		if ::oTotalTaxByTotvsId:HasProperty(CBS_CRED_PRESUMIDO)
			if ::oTotalTaxByTotvsId[CBS_CRED_PRESUMIDO]['presumido_cond_suspen'] != "S"
				cXml +=     '<vCredPres>' + lTrim(Str(::oTotalTaxByTotvsId[CBS_CRED_PRESUMIDO]['total_tributo'],13,2)) + '</vCredPres>' 
				cXml +=     '<vCredPresCondSus>' + lTrim(Str(0,13,2)) + '</vCredPresCondSus>' //Envio de valor zerado devido a falha no eschema se não enviar a TAG
			else
				cXml +=     '<vCredPres>' + lTrim(Str(0,13,2)) + '</vCredPres>' //Envio de valor zerado devido a falha no eschema se não enviar a TAG
				cXml +=     '<vCredPresCondSus>' + lTrim(Str(::oTotalTaxByTotvsId[CBS_CRED_PRESUMIDO]['total_tributo'],13,2)) + '</vCredPresCondSus>' 
			endif
		else
			cXml +=     '<vCredPres>' + lTrim(str(0, 13, 2)) + '</vCredPres>' 
			cXml +=     '<vCredPresCondSus>' + lTrim(str(0, 13, 2)) + '</vCredPresCondSus>'
		endif
	endIf
	// GEstornoCred foi incluida no schema novo
	cXml += '</gCBS>'

Return cXml

/*/	{Protheus.doc} TaxInformation::getXmlTotalgMono()
	Gera as tags de totalização do subgrupo getXmlTotalgMono
	@type method
	@author Evandro Italo
	@since 21/05/2025
/*/
Method getXmlTotalgMono(cXmlMono as character) as logical Class TaxInformation
    Local lTributado as logical
    Local nTotalIbsMonoPadrao as numeric
    Local nTotalCbsMonoPadrao as numeric
    Local nTotalIbsMonoRetencao as numeric
    Local nTotalCbsMonoRetencao as numeric
    Local nTotalIbsMonoRetido as numeric
    Local nTotalCbsMonoRetido as numeric

	/*Verifica se tem valor tributado para todos os tipos de monofásicos, isso é necessário
	  porque a reforma tributária permite mais de um tipo para um mesmo item 				*/
	if ::oTotalTaxByTotvsId:HasProperty(IBS_MONO_PADRAO)
		nTotalIbsMonoPadrao := ::oTotalTaxByTotvsId[IBS_MONO_PADRAO]['total_tributo']
		lTributado := .t.
    endif
	if ::oTotalTaxByTotvsId:HasProperty(IBS_MONO_RETENCAO)
		nTotalIbsMonoRetencao := ::oTotalTaxByTotvsId[IBS_MONO_RETENCAO]['total_tributo']
		lTributado := .t.
	endif
	if ::oTotalTaxByTotvsId:HasProperty(IBS_MONO_RETIDO)
		nTotalIbsMonoRetido := ::oTotalTaxByTotvsId[IBS_MONO_RETIDO]['total_tributo']
		lTributado := .t.
	endif
	if ::oTotalTaxByTotvsId:HasProperty(CBS_MONO_PADRAO)
		nTotalCbsMonoPadrao := ::oTotalTaxByTotvsId[CBS_MONO_PADRAO]['total_tributo']
		lTributado := .t.
	endif
	if ::oTotalTaxByTotvsId:HasProperty(CBS_MONO_RETENCAO)
		nTotalCbsMonoRetencao := ::oTotalTaxByTotvsId[CBS_MONO_RETENCAO]['total_tributo']
		lTributado := .t.
	endif
	if ::oTotalTaxByTotvsId:HasProperty(CBS_MONO_RETIDO)
		nTotalCbsMonoRetido := ::oTotalTaxByTotvsId[CBS_MONO_RETIDO]['total_tributo']
		lTributado := .t.
    endif
    
    if lTributado
        cXmlMono += '<gMono>' 
        cXmlMono +=     '<vIBSMono>'      + lTrim(str(nTotalIbsMonoPadrao,13,2))    + '</vIBSMono>' 
        cXmlMono +=     '<vCBSMono>'      + lTrim(str(nTotalCbsMonoPadrao,13,2))    + '</vCBSMono>' 
        cXmlMono +=     '<vIBSMonoReten>' + lTrim(str(nTotalIbsMonoRetencao,13,2))  + '</vIBSMonoReten>'  
        cXmlMono +=     '<vCBSMonoReten>' + lTrim(str(nTotalCbsMonoRetencao,13,2))  + '</vCBSMonoReten>'  
        cXmlMono +=     '<vIBSMonoRet>'   + lTrim(str(nTotalIbsMonoRetido,13,2)) 	+ '</vIBSMonoRet>'    
        cXmlMono +=     '<vCBSMonoRet>'   + lTrim(str(nTotalCbsMonoRetido,13,2)) 	+ '</vCBSMonoRet>'    
        cXmlMono += '</gMono>'
    endif    

Return lTributado

/*/{Protheus.doc} setTotalBaseIbsCbs
	Soma a base de calculo dos impostos IBS e CBS por item
	@type method
	@author Carlos Eduardo Boy
	@since 21/05/2025
/*/
Method setTotalBaseIbsCbs(cValorBaseItem as numeric) class TaxInformation
    ::nTotalBaseIbsCbs += cValorBaseItem

return

/*/{Protheus.doc} setTotalBaseIbsCbs
	Deve gerar IBS/CBS para estes CST
	@type method
	@author Rodrigo Pirolo
	@since 8/10/2025
/*/

Method setIbsCBSbyCST( cCST as character ) as logical class TaxInformation

	Local cXMLCst	:= AllTrim( SuperGetMv( "MV_CSTGXML", .F., "000/200/210/220/510/550/830" ) ) as character // CST que devem gerar IBS/CBS no xml
	Local lRet		:= .F. as logical

	If cCST $ cXMLCst
    	lRet := .T.
	EndIf

Return lRet

/*/{Protheus.doc} TaxInformation::getCstIbsCbs
description
@type method
@version  
@author l.barbosa
@since 10/13/2025
@param cDocumentItemId, character, param_description
@return logical, return_description
/*/
Method getCstIbsCbs( cDocumentItemId as character, oNfTciIntg as object ) as character class TaxInformation

	Local cCst := '' as character 

	Private oJsIbsEstadual 	:= oNfTciIntg:GetTax( cDocumentItemId, 'IBS_ESTADUAL' ) as json
	Private oJsIbsMunicipal := oNfTciIntg:GetTax( cDocumentItemId, 'IBS_MUNICIPAL') as json
	Private oJsCbs 			:= oNfTciIntg:GetTax( cDocumentItemId, 'CBS_FEDERAL'  ) as json
	
	if oJsIbsEstadual != nil
		cCst := oJsIbsEstadual['dados_escriturados']['cst']
	elseif oJsIbsMunicipal != nil
		cCst := oJsIbsMunicipal['dados_escriturados']['cst']
	endif

	if empty(cCst) .and. oJsCbs != nil
		cCst := oJsCbs['dados_escriturados']['cst']
	endif

Return cCst

/*/{Protheus.doc}
Gera Grupo de informações da Tributação Monofásica Padrão
@type method
@version  P12 V1.2410
@author Carlos Eduardo Boy
@since 06/01/2026
/*/
Method getXmlMonoPadrao(oJsIbsMonoPadrao as json, lIbsMono, oJsCbsMonoPadrao as json, lCbsMono, nTotalValorIbsMono, nTotalValorCbsMono ) as character class TaxInformation
	Local cXml as character
	Local nQuantTributada as numeric

	if lIbsMono .or. lCbsMono

		nQuantTributada := iif(lIbsMono,oJsIbsMonoPadrao['base_quantidade_tributo'],oJsCbsMonoPadrao['base_quantidade_tributo'])

		cXml += '<gMonoPadrao>'
		cXml +=     '<qBCMono>' + lTrim(str(nQuantTributada, 16, 2)) + '</qBCMono>'
		cXml +=     '<adRemIBS>' + iif(lIbsMono,lTrim(str(oJsIbsMonoPadrao['aliquota_tributo'],8,4)),'0') + '</adRemIBS>'
		cXml +=     '<adRemCBS>' + iif(lCbsMono,lTrim(str(oJsCbsMonoPadrao['aliquota_tributo'],8,4)),'0') + '</adRemCBS>'
		cXml +=     '<vIBSMono>' + iif(lIbsMono,lTrim(str(oJsIbsMonoPadrao['valor_tributo'],13,2)),'0')   + '</vIBSMono>'
		cXml +=     '<vCBSMono>' + iif(lCbsMono,lTrim(str(oJsCbsMonoPadrao['valor_tributo'],13,2)),'0')   + '</vCBSMono>'
		cXml += '</gMonoPadrao>'

		nTotalValorIbsMono += iif(lIbsMono,oJsIbsMonoPadrao['valor_tributo'],0)
		nTotalValorCbsMono += iif(lCbsMono,oJsCbsMonoPadrao['valor_tributo'],0)
	endif	
return cXml

/*/{Protheus.doc}
Gera Grupo de informações da Tributação Monofásica Sujeita à Retenção
@type method
@version  P12 V1.2410
@author Carlos Eduardo Boy
@since 06/01/2026
/*/
Method getXmlMonoRetencao(oJsIbsMonoRetencao as json, lIbsMono as logical, oJsCbsMonoRetencao as json, lCbsMono as logical, nTotalValorIbsMono as numeric, nTotalValorCbsMono as numeric) as character class TaxInformation
	Local cXml as character
	Local nQuantTributada as numeric

	if lIbsMono .or. lCbsMono

		nQuantTributada := iif(lIbsMono,oJsIbsMonoRetencao['base_quantidade_tributo'],oJsCbsMonoRetencao['base_quantidade_tributo'])

		cXml +=     '<gMonoReten>
		cXml +=         '<qBCMonoReten>'  + lTrim(str(nQuantTributada, 16, 2)) + '</qBCMonoReten>'
		cXml +=         '<adRemIBSReten>' + iif(lIbsMono,lTrim(str(oJsIbsMonoRetencao['aliquota_tributo'],8,4)),'0') + '</adRemIBSReten>'
		cXml +=         '<vIBSMonoReten>' + iif(lIbsMono,lTrim(str(oJsIbsMonoRetencao['valor_tributo'],13,2)),'0') 	 + '</vIBSMonoReten>'
		cXml +=         '<adRemCBSReten>' + iif(lCbsMono,lTrim(str(oJsCbsMonoRetencao['aliquota_tributo'],8,4)),'0') + '</adRemCBSReten>'
		cXml +=         '<vCBSMonoReten>' + iif(lCbsMono,lTrim(str(oJsCbsMonoRetencao['valor_tributo'],13,2)),'0') 	 + '</vCBSMonoReten>'
		cXml +=     '</gMonoReten>'

		nTotalValorIbsMono += iif(lIbsMono,oJsIbsMonoRetencao['valor_tributo'],0)
		nTotalValorCbsMono += iif(lCbsMono,oJsCbsMonoRetencao['valor_tributo'],0)
	endif	
return cXml

/*/{Protheus.doc}
Gera Grupo de informações da Tributação Monofásica Retida Anteriormente
@type method
@version  P12 V1.2410
@author Carlos Eduardo Boy
@since 06/01/2026
/*/
Method getXmlMonoRetido(oJsIbsMonoRetido as json, lIbsMono as logical, oJsCbsMonoRetido as json, lCbsMono as logical, nTotalValorIbsMono as numeric, nTotalValorCbsMono as numeric ) as character class TaxInformation
	Local cXml as character
	Local nQuantTributada as numeric

	if lIbsMono .or. lCbsMono
		
		nQuantTributada := iif(lIbsMono,oJsIbsMonoRetido['base_quantidade_tributo'],oJsCbsMonoRetido['base_quantidade_tributo'])

		cXml +=     '<gMonoRet>
		cXml +=         '<qBCMonoRet>' + lTrim(str(nQuantTributada, 16, 2)) + '</qBCMonoRet>'
		cXml +=         '<adRemIBSRet>' + iif(lIbsMono,lTrim(str(oJsIbsMonoRetido['aliquota_tributo'],8,4)),'0') + '</adRemIBSRet>'
		cXml +=         '<vIBSMonoRet>' + iif(lIbsMono,lTrim(str(oJsIbsMonoRetido['valor_tributo'],13,2)),'0')   + '</vIBSMonoRet>'
		cXml +=         '<adRemCBSRet>' + iif(lCbsMono,lTrim(str(oJsCbsMonoRetido['aliquota_tributo'],8,4)),'0') + '</adRemCBSRet>'
		cXml +=         '<vCBSMonoRet>' + iif(lCbsMono,lTrim(str(oJsCbsMonoRetido['valor_tributo'],13,2)),'0')   + '</vCBSMonoRet>'
		cXml +=     '</gMonoRet>'

		nTotalValorIbsMono += iif(lIbsMono,oJsIbsMonoRetido['valor_tributo'],0)
		nTotalValorCbsMono += iif(lCbsMono,oJsCbsMonoRetido['valor_tributo'],0)
	endif	
return cXml

/*/{Protheus.doc}
Gera Grupo de informações do Diferimento da Tributação Monofásica
@type method
@version  P12 V1.2410
@author Carlos Eduardo Boy
@since 06/01/2026
/*/
Method getXmlMonoDiferimento(oJsIbsMonoDiferimento as json, lIbsMono as logical, oJsCbsMonoDiferimento as json, lCbsMono as logical, nTotalValorIbsMono as numeric, nTotalValorCbsMono as numeric) as character class TaxInformation
	Local cXml as character
	/*
	if lIbsMono .or. lCbsMono
		cXml +=     '<gMonoDif>
		cXml +=         '<pDifIBS>'     + iif(lIbsMono, lTrim(str(oJsIbsMonoDiferimento['dados_escriturados']['perc_diferido'],8,4)), '0')   + '</pDifIBS>'
		cXml +=         '<vIBSMonoDif>' + iif(lIbsMono, lTrim(str(oJsIbsMonoDiferimento['dados_escriturados']['valor_diferido'],13,2)), '0') + '</vIBSMonoDif>'
		cXml +=         '<pDifCBS>'     + iif(lCbsMono, lTrim(str(oJsCbsMonoDiferimento['dados_escriturados']['perc_diferido'],8,4)), '0')   + '</pDifCBS>'
		cXml +=         '<vCBSMonoDif>' + iif(lCbsMono, lTrim(str(oJsCbsMonoDiferimento['dados_escriturados']['valor_diferido'],13,2)), '0') + '</vCBSMonoDif>'
		cXml +=     '</gMonoDif>'

		nTotalValorIbsMono += iif(lIbsMono,oJsIbsMonoDiferimento['valor_tributo'],0)
		nTotalValorCbsMono += iif(lCbsMono,oJsCbsMonoDiferimento['valor_tributo'],0)
	endif
	*/
return cXml

/*/{Protheus.doc}
Consulta dados comum da tributação monofásica
@type method
@version  P12 V1.2410
@author Carlos Eduardo Boy
@since 12/01/2026
/*/
Method getDadosMonofasico(oJsMonofasico as json, cCst as character, cClassTrib as character, lXmlMonofasico as logical) class TaxInformation
	cCst := oJsMonofasico['dados_escriturados']['cst']
	cClassTrib := iif( lExistCJ3_CCT, oJsMonofasico['dados_escriturados']['cclasstrib'], '' )
	self:setTotalTaxByTotvsId(oJsMonofasico)
	lXmlMonofasico := .t.
return

/*{Protheus.doc}
Gera as tags do gEstornoCred
@type method
@version  P12 V1.2410
@author William Palma Alves
@since 19/11/2025
*/

Method getXmlgEstornoCred(oJsIbsEstadual as json, oJsCbs as json) as character class TaxInformation
    Local cXml as character

	If oJsIbsEstadual != nil .And. oJsCbs != nil
		cXml +=	'<gEstornoCred>'
		cXml +=     '<vIBSEstCred>' + lTrim(str(oJsIbsEstadual['dados_escriturados']['valor_tributado'], 13, 2)) + '</vIBSEstCred>'
		cXml +=     '<vCBSEstCred>' + lTrim(str(oJsCbs['dados_escriturados']['valor_tributado'], 13, 2)) + '</vCBSEstCred>'
		cXml +=	'</gEstornoCred>'
	EndIF

return cXml

/*{Protheus.doc}
Gera as tags do gEstornoCred
@type method
@version  P12 V1.2410
@author William Palma Alves
@since 19/11/2025
*/

Method getXmlTotalgEstornoCred() as character Class TaxInformation
    Local cXml as character
    
	If ::lTagEstCred
		cXml += '<gEstornoCred>' 
		cXml +=     '<vIBSEstCred>' + lTrim(str(::oTotalTaxByTotvsId[IBS_ESTADUAL]['total_estorno_cred'], 13, 2)) + '</vIBSEstCred>' 
		cXml +=     '<vCBSEstCred>' + lTrim(str(::oTotalTaxByTotvsId[CBS_FEDERAL]['total_estorno_cred'], 13, 2)) + '</vCBSEstCred>' 
		cXml += '</gEstornoCred>'
	EndIf

Return cXml

/*/{Protheus.doc}
Gera tags do grupo gIBSCBS
@type method
@version  P12 V1.2410
@author William Palma Alves
@since 19/11/2025*/
Method getXmlgIBSCBSCredPres(oJsIbsCreditoPresumido as json, oJsCbsCreditoPresumido as json, cDocumentItemId as character) as character class TaxInformation
	Local cXml 			as character
	Local oAddData 		:= totvs.protheus.backoffice.fiscal.additionalData.TCAdditionalData():New()
    Local cReturn 		as character
	Local aIDs 			as array
	Local oResultPreIBS := JsonObject():New() as json
	Local oResultPreCBS := JsonObject():New() as json
	Local nCredPres 	as numeric
	Local lTagCredPres	:= .T. as logical
	
	Local cCondSusPreIbs 	:= "N" as character
	Local cCondSusPreCbs	:= "N" as character

	aIDs := {cDocumentItemId}
 
    oAddData:setDataMode("Written")
    oAddData:setId(aIDs)
    cReturn := oAddData:getAdditionalData()

    oAddData:destroy()

	If oJsIbsCreditoPresumido != nil .Or. oJsCbsCreditoPresumido != nil
		
		cXml += '<gCredPresOper>'
		If oJsIbsCreditoPresumido != nil
			If !Empty(cReturn)
				oResultPreIBS:FromJSON(cReturn)
				If oResultPreIBS[cDocumentItemId][oJsIbsCreditoPresumido['dados_escriturados']['codigo_tributo']]["regra calculo"]["dados adicionais"]["CCREDPRES"] != Nil
					nCredPres 	:= Val(oResultPreIBS[cDocumentItemId][oJsIbsCreditoPresumido['dados_escriturados']['codigo_tributo']]["regra calculo"]["dados adicionais"]["CCREDPRES"]["conteudo"])
				EndIF
				If oResultPreIBS[cDocumentItemId][oJsIbsCreditoPresumido['dados_escriturados']['codigo_tributo']]["regra calculo"]["dados adicionais"]["CONDSUSPRE"] != Nil
					cCondSusPreIbs := oResultPreIBS[cDocumentItemId][oJsIbsCreditoPresumido['dados_escriturados']['codigo_tributo']]["regra calculo"]["dados adicionais"]["CONDSUSPRE"]["conteudo"]
				EndIf
			Endif
			cXml +=     '<vBCCredPres>' + ltrim(str(oJsIbsCreditoPresumido['base_tributo'],13,2)) + '</vBCCredPres>'
			cXml +=     '<cCredPres>' + lTrim(strZero(nCredPres, 2)) + '</cCredPres>'
			lTagCredPres	:= .F.
		EndIf

		If oJsCbsCreditoPresumido != nil
			If !Empty(cReturn)
				oResultPreCBS:FromJSON(cReturn)
				If oResultPreCBS[cDocumentItemId][oJsCbsCreditoPresumido['dados_escriturados']['codigo_tributo']]["regra calculo"]["dados adicionais"]["CCREDPRES"] != Nil
					nCredPres 	:= Val(oResultPreCBS[cDocumentItemId][oJsCbsCreditoPresumido['dados_escriturados']['codigo_tributo']]["regra calculo"]["dados adicionais"]["CCREDPRES"]["conteudo"])
				EndIF
				If oResultPreCBS[cDocumentItemId][oJsCbsCreditoPresumido['dados_escriturados']['codigo_tributo']]["regra calculo"]["dados adicionais"]["CONDSUSPRE"] != Nil
					cCondSusPreCbs := oResultPreCBS[cDocumentItemId][oJsCbsCreditoPresumido['dados_escriturados']['codigo_tributo']]["regra calculo"]["dados adicionais"]["CONDSUSPRE"]["conteudo"]
				EndIf
			Endif
			If  lTagCredPres
				cXml +=     '<vBCCredPres>' + ltrim(str(oJsCbsCreditoPresumido['base_tributo'],13,2)) + '</vBCCredPres>'
				cXml +=     '<cCredPres>' + lTrim(strZero(nCredPres, 2)) + '</cCredPres>'
			Endif
		EndIf
		If oJsIbsCreditoPresumido != nil
			cXml += '<gIBSCredPres>'
			cXml +=     '<pCredPres>' + ltrim(str(oJsIbsCreditoPresumido['aliquota_tributo'],8,4)) + '</pCredPres>'
			If cCondSusPreIbs != "S"
				cXml +=     '<vCredPres>' + ltrim(str(oJsIbsCreditoPresumido['valor_tributo'],13,2)) + '</vCredPres>'
			Else
				cXml +=     '<vCredPresCondSus>' + ltrim(str(oJsIbsCreditoPresumido['valor_tributo'],13,2)) + '</vCredPresCondSus>'
			EndIf
			cXml += '</gIBSCredPres>'
		EndIf

		If oJsCbsCreditoPresumido != nil
			cXml += '<gCBSCredPres>'
			cXml +=     '<pCredPres>' + ltrim(str(oJsCbsCreditoPresumido['aliquota_tributo'],8,4)) + '</pCredPres>'
			If cCondSusPreCbs != "S"
				cXml +=     '<vCredPres>' + ltrim(str(oJsCbsCreditoPresumido['valor_tributo'],13,2)) + '</vCredPres>'
			Else
				cXml +=     '<vCredPresCondSus>' + ltrim(str(oJsCbsCreditoPresumido['valor_tributo'],13,2)) + '</vCredPresCondSus>'
			EndIf
			cXml += '</gCBSCredPres>''
		EndIf
		cXml += '</gCredPresOper>'

		self:setTotalTaxByTotvsId(oJsIbsCreditoPresumido, , cCondSusPreIbs)
		self:setTotalTaxByTotvsId(oJsCbsCreditoPresumido, , , cCondSusPreCbs)
	EndIf

	FWFreeObj(oResultPreIBS)
	FWFreeObj(oResultPreCBS)
return cXml

