#include "tlpp-core.th"
#include "tlpp-rest.th"

#define IBS_ESTADUAL        '000060'
#define IBS_MUNICIPAL       '000061'
#define CBS_FEDERAL         '000062'
#define IMPOSTO_SELETIVO    '000063'
#define IBS_EST_REGULAR     '000064'
#define IBS_MUN_REGULAR     '000065'
#define CBS_REGULAR         '000066'
#define IBS_CRED_PRESUMIDO  '000067'
#define CBS_CRED_PRESUMIDO  '000068'
#define IBS_MONO_PADRAO     '000069'
#define CBS_MONO_PADRAO     '000070'
#define IBS_MONO_RETENCAO   '000073'
#define CBS_MONO_RETENCAO   '000074'
#define IBS_MONO_RETIDO     '000075'
#define CBS_MONO_RETIDO     '000076'
//#define IBS_MONO_DIFERIMENTO '000000'
//#define CBS_MONO_DIFERIMENTO '000000'

static lExistCJ3_CCT := len(FWSX3Util():GetFieldStruct('CJ3_CCT')) > 0 as logical

namespace totvs.protheus.backoffice.tss.engine.xml

/*/{Protheus.doc} IBSCBSNFE
Classe responsável por gerar no XML para o grupo UB - Informações dos tributos IBS / CBS e Imposto Seletivo da NFe/NFCe.
@type class
@version  P12 V1.2410
@author Carlos Eduardo Boy
@since 21/05/2025
/*/
Class TaxInformation

	//Propriedades
	public  data nTotalBaseIbsCbs 			as numeric
	public  data oTotalTaxByTotvsId 		as object
	private data cModelo					as character
	private data lTagEstCred 				as logical
	
	//atributos necessários para controle e alutinacao dos valores para NFS-e
	private data lAglutinaItens 			as logical
	private data lXmlEnv		 			as logical
	private data nBaseIbsCbsAglut 			as numeric
	private data nValorTributoUBSUFaglut 	as numeric
	private data vDifaglut 					as numeric
	private data nValorTributoAglut 		as numeric
	private data nValorTributoCBSAglut 		as numeric
	private data nValorTribRegIbsUfAglut 	as numeric
	private data nValorTribRegIbsMunAglut 	as numeric
	private data nValorTribRegCbsAglut 		as numeric
	private data nValorTributoISAglut 		as numeric
	private data nvISAglut			 		as numeric
	private data nValorCredPresCBSAglut		as numeric
	private data nValorCredPresIBSAglut		as numeric

	//Metodos get
	public  method New() as object
	public  method getXmlIS(cDocumentItemId as character, oNfTciIntg as object) as character
	public  method getXmlIBSCBS(cDocumentItemId as character, oNfTciIntg as object, oItensReforma as json, oItensRefNfe as json) as character
	private method getXmlgIBSCBS(cDocumentItemId as character, nBaseIbsCbs as numeric, oNfTciIntg as object, lXmlgIBSCBS as logical, oJsCbs as json, oJsIbsEstadual as json, oJsIbsMunicipal as json) as character
	private method getXmlgIBSUF(oStateTax as json, nTotalIbs as numeric) as character
	private method getXmlgDif(oTax as json, lGeraDifZero as logical) as character
	private method getXmlgDevTrib(oTax as json) as character
	private method getXmlgRed(oTax as json) as character
	private method getXmlgIBSMun(oMunicipalTax as json, nTotalIbs as numeric, oJsIbsEstadual as json) as character
	private method getXmlgCBS(oTax as json) as character
	private method getXmlgTribRegular() as character
	private method getXmlgEstornoCred() as character
	private method getXmlgIBSCBSCredPres(oJsIbsCreditoPresumido, oJsCbsCreditoPresumido, cDocumentItemId) as character

	private method getXmlgIBSCredPres(oJsIbsCreditoPresumido) as character
	private method getXmlgCBSCredPres(oJsCbsCreditoPresumido) as character

	//public  method getXmlgTribCompraGov() as character
	private method getXmlgIBSCBSMono(oJsIbsMonoPadrao as json, oJsCbsMonoPadrao as json, oJsIbsMonoRetencao as json, oJsCbsMonoRetencao as json, oJsIbsMonoRetido as json, oJsCbsMonoRetido as json, oJsIbsMonoDiferimento as json, oJsCbsMonoDiferimento as json) as character
	//private method getXmlgTransfCred() as character
	//private method getXmlgCredPresIBSZFM() as character



	//Se for criado um id totvs para cada tipo de monofasico, o ideal é criar metodos separados para cada um deles
	private method getDadosMonofasico(oJsMonofasico as json, cCst as character, cClassTrib as character, lXmlMono as logical) 
	private method getXmlMonoPadrao(oJsIbsMonoPadrao as json, lIbsMono as logical, oJsCbsMonoPadrao as json, lCbsMono as logical, nTotalValorIbsMono as numeric, nTotalValorCbsMono as numeric) as character
	private method getXmlMonoRetencao(oJsIbsMonoRetencao as json, lIbsMono as logical, oJsCbsMonoRetencao as json, lCbsMono as logical, nTotalValorIbsMono as numeric, nTotalValorCbsMono as numeric) as character
	private method getXmlMonoRetido(oJsIbsMonoRetido as json, lIbsMono as logical, oJsCbsMonoRetido as object, json as logical, nTotalValorIbsMono as numeric, nTotalValorCbsMono as numeric) as character
	private method getXmlMonoDiferimento(oJsIbsMonoDiferimento as json, lIbsMono as logical, oJsCbsMonoDiferimento as json, lCbsMono as logical, nTotalValorIbsMono as numeric, nTotalValorCbsMono as numeric) as character

	public  method getXmlTotalIbsCbsIs() as character
	public  method getXmlTotalIs() as character
	public  method getXmlTotalIbsCbs() as character
	public  method getXmlTotalDFE() as character

	private method getXmlTotalgIBS() as character
	private method getXmlTotalgIbsUf(nTotalIbs as numeric) as character
	private method getXmlTotalgIbsMun(nTotalIbs as numeric) as character
	private method getXmlTotalgCbs() as character
	private method getXmlTotalgMono(cXmlMono as character) as logical
	private method getXmlTotalgEstornoCred() as character

	//metodos set
	private method setTotalTaxByTotvsId()
	private method setTotalBaseIbsCbs(nBaseIbsCbs as numeric)
	public method setIbsCBSbyCST() as logical
	public method getCstIbsCbs( cDocumentItemId as character, oNfTciIntg as object ) as character

	public method Destroy()

EndClass

/*/{Protheus.doc} New
Metodo construtor da classe TaxInformation, recebe o id do documento que 
será utilizado para gerar as tags de tributos.
@type method
@version  P12 V1.2410
@param cDocumentItemId, Id do documento atual
@author Carlos Eduardo Boy
@since 21/05/2025
/*/
Method New(cMod, lModXmlEnv) as object class TaxInformation

	Default cMod 	:= "55"
	Default lModXmlEnv := .F. //Gerar as tag no grupo impostoibscbs para o IBS/CBS padrao TSSNFSEXMLENV|NFSEXMLENV

	::cModelo				:= cMod
	::oTotalTaxByTotvsId 	:= JsonObject():New()
	self:lAglutinaItens 	:= self:cModelo == "56" //quando NFS-e, não há grupo por item mas sim um grupo geral dos itens aglutinados
	self:lXmlEnv			:= lModXmlEnv 
	::lTagEstCred 			:= .F.

Return self

/*/{Protheus.doc} IBSCBSBPE::GeraIS
Gera tags do imposto IS.
@type method
@version  P12 V1.2410
@author Carlos Eduardo Boy
@since 21/05/2025/*/
Method getXmlIS(cDocumentItemId as character, oNfTciIntg as object) as character class TaxInformation
	Local oJsImpSel := oNfTciIntg:GetTax( cDocumentItemId, 'IMPOSTO_SELETIVO') as json
	Local cXmlImpSel as character
	Local cAliasDoc as character
	Local cAlsField as character
	Local cClassTrib as character
	Local aDadosItem  as array
	Local cXmlOpen as character
	Local cXmlClose as character
	Local nIndice := 18 as numeric
	local nvBCIS as numeric
	local nvIS as numeric

	if oJsImpSel != nil

		//Tratamento temporário, posteriormente a classe TciWritten deve retornar esses valores para seram passados para o XML
		cAliasDoc   := GetAdvFVal('F2D', 'F2D_TABELA', xFilial('F2D')+cDocumentItemId+oJsImpSel['dados_escriturados']['codigo_tributo'], 2 )
		cAlsField   := substr(cAliasDoc,2,2)
		If cAliasDoc == 'SD1'
			nIndice := 23
		Endif
		aDadosItem  := GetAdvFVal(cAliasDoc, {cAlsField+'_UM',cAlsField+'_QUANT'}, xFilial(cAliasDoc)+cDocumentItemId, nIndice )

		//Proteção para o caso de não existir o campo CJ3_CCT
		if lExistCJ3_CCT
			cClassTrib := oJsImpSel['dados_escriturados']['cclasstrib']
		endif
		If ::cModelo == "55"
			cXmlOpen := '<imposto>'
			cXmlOpen +=     '<codigo>IS</codigo>'
			cXmlOpen += 	'<Tributo>'

			cXmlClose := 	'</Tributo>'
			cXmlClose += '</imposto>'
		
		ElseIf ::cModelo == "56"
			if ::lXmlEnv
				cXmlOpen := "<impostois>"
			endif
			cXmlOpen += '<codigo>IS</codigo>'
			cXmlOpen += '<Tributo>'

			cXmlClose := '</Tributo>'
			if ::lXmlEnv
				cXmlClose += '</impostois>'
			endif
		Else
			cXmlOpen := '<IS>'

			cXmlClose := '</IS>'
		EndIf

		nvBCIS := oJsImpSel['base_tributo']
		nvIS := oJsImpSel['dados_escriturados']['valor_tributado']
		if self:lAglutinaItens
			self:nValorTributoISAglut += nvBCIS
			nvBCIS := self:nValorTributoISAglut
			self:nvISAglut += nvIS
			nvIS := self:nvISAglut
		endIf
		
		cXmlImpSel += cXmlOpen
		cXmlImpSel += 	'<CSTIS>' + oJsImpSel['dados_escriturados']['cst'] + '</CSTIS>'
		cXmlImpSel +=   '<cClassTribIS>' + cClassTrib + '</cClassTribIS>'
		cXmlImpSel +=   '<vBCIS>' + ltrim(str(nvBCIS,13,2)) + '</vBCIS>'
		cXmlImpSel +=   '<pIS>' + ltrim(str(oJsImpSel['aliquota_tributo'],8,4)) + '</pIS>'
		cXmlImpSel +=   '<pISEspec>' + lTrim(str(0, 8, 4)) + '</pISEspec>'
		cXmlImpSel +=   '<uTrib>' + aDadosItem[1] + '</uTrib>'
		cXmlImpSel +=   '<qTrib>' + lTrim(str(aDadosItem[2],16,4)) + '</qTrib>'
		cXmlImpSel +=   '<vIS>' + ltrim(str(nvIS,13 ,2)) + '</vIS>'
		cXmlImpSel += cXmlClose

		self:setTotalTaxByTotvsId(oJsImpSel)

	endif

Return cXmlImpSel

/*/{Protheus.doc} IBSCBSBPE::GeraIBSCBS
Gera tags dos imposto IBS e CBS.
@type method
@version  P12 V1.2410
@author Carlos Eduardo Boy
@since 21/05/2025
/*/
Method getXmlIBSCBS(cDocumentItemId as character , oNfTciIntg as object, oItensReforma as json, oItensRefNfe as json) as character class TaxInformation
	Local lGeraXml := .F. as logical
	Local lXmlMono := .F. as logical
	Local cXmlCbsIbs as character
	Local cCst as character
	Local cClassTrib as character
	Local nBaseIbsCbs as numeric
	Local oJsIbsMonoPadrao 	 := oNfTciIntg:GetTax( cDocumentItemId, 'IBS_MONO_PADRAO'  ) as json
	Local oJsCbsMonoPadrao 	 := oNfTciIntg:GetTax( cDocumentItemId, 'CBS_MONO_PADRAO'  ) as json
	Local oJsIbsMonoRetencao := oNfTciIntg:GetTax( cDocumentItemId, 'IBS_MONO_RETENCAO') as json
	Local oJsCbsMonoRetencao := oNfTciIntg:GetTax( cDocumentItemId, 'CBS_MONO_RETENCAO') as json
	Local oJsIbsMonoRetido   := oNfTciIntg:GetTax( cDocumentItemId, 'IBS_MONO_RETIDO'  ) as json
	Local oJsCbsMonoRetido   := oNfTciIntg:GetTax( cDocumentItemId, 'CBS_MONO_RETIDO'  ) as json
	//Local oJsIbsMonoDiferimento := oNfTciIntg:GetTax( cDocumentItemId, 'IBS_MONO_DIFERIMENTO') as json
	//Local oJsCbsMonoDiferimento := oNfTciIntg:GetTax( cDocumentItemId, 'CBS_MONO_DIFERIMENTO') as json
	Local oJsCbs 		   	 := oNfTciIntg:GetTax( cDocumentItemId, 'CBS_FEDERAL'	   ) as json
	Local oJsIbsEstadual   	 := oNfTciIntg:GetTax( cDocumentItemId, 'IBS_ESTADUAL' 	   ) as json
	Local oJsIbsMunicipal  	 := oNfTciIntg:GetTax( cDocumentItemId, 'IBS_MUNICIPAL'	   ) as json
	Local oJsIbsCreditoPresumido := oNfTciIntg:GetTax( cDocumentItemId, 'IBS_CRED_PRESUMIDO') as json
	Local oJsCbsCreditoPresumido := oNfTciIntg:GetTax( cDocumentItemId, 'CBS_CRED_PRESUMIDO') as json
	Local cXmlOpen as character
	Local cXmlClose as character
	Local cIndOp as character
	Local lXmlgIBSCBS := .F. as logical
	Local lExistCJ3_INDOP as logical
	Local cServTpOper	:= AllTrim( SuperGetMv( "MV_INDOPER", .F., "" ) ) as character // CST que devem gerar IBS/CBS no xml
	Local oJsDoacao as json
	Local lDoacao as logical

	Private oOtherInfo
	Private oNFeOtherInfo

	Default oItensReforma   := nil
	Default oItensRefNfe	:= nil

	oOtherInfo := oItensReforma
	oNFeOtherInfo := oItensRefNfe

	lExistCJ3_INDOP := len(FWSX3Util():GetFieldStruct('CJ3_INDOP')) > 0

	//Busca os dados de CST, cClassTrib e Base de Cálculo do IBS
	if ( oJsIbsEstadual != nil .and. valtype(oJsIbsEstadual['regras_escrituracao']) == 'J') .or. ( oJsIbsMunicipal != nil .and. valtype(oJsIbsMunicipal['regras_escrituracao']) == 'J' )

		cCst := iif(oJsIbsEstadual != nil, oJsIbsEstadual['dados_escriturados']['cst'], oJsIbsMunicipal['dados_escriturados']['cst'])
		lXmlgIBSCBS := Self:setIbsCBSbyCST( cCST )

		//Pego do estadual pois sempre existIrão os dois tributos(Estadual e municipal)
		if lXmlgIBSCBS
			nBaseIbsCbs := iif(oJsIbsEstadual != nil, oJsIbsEstadual['base_tributo'], oJsIbsMunicipal['base_tributo'])
			self:setTotalBaseIbsCbs(nBaseIbsCbs)
		endif

		//Proteção para o caso de não existir o campo CJ3_CCT
		if lExistCJ3_CCT
			cClassTrib := iif(oJsIbsEstadual != nil, oJsIbsEstadual['dados_escriturados']['cclasstrib'], oJsIbsMunicipal['dados_escriturados']['cclasstrib'])
		endif

		if lExistCJ3_INDOP
			if oJsIbsEstadual != nil
				cIndOp := oJsIbsEstadual['dados_escriturados']['indicador_operacao']
			else
				cIndOp := oJsIbsMunicipal['dados_escriturados']['indicador_operacao']
			endif
		endif

		oJsDoacao := iif(oJsIbsEstadual != nil, oJsIbsEstadual, oJsIbsMunicipal)	
		lDoacao :=  oJsDoacao['dados_adicionais']['perfil de operacao']['dados adicionais']:HasProperty('INDDOACAO') .and. oJsDoacao['dados_adicionais']['perfil de operacao']['dados adicionais']['INDDOACAO']['conteudo'] == '1'

		lGeraXml := .T.
	endif

	//Busca os dados de CST, cClassTrib e Base de Cálculo do CBS
	if oJsCbs != nil .and. valtype(oJsCbs['regras_escrituracao']) == 'J'

		if empty(cCst) .and. empty(cClassTrib)
		
			cCst := oJsCbs['dados_escriturados']['cst']
			lXmlgIBSCBS := Self:setIbsCBSbyCST( cCST )

			if nBaseIbsCbs = 0 .and. lXmlgIBSCBS
				nBaseIbsCbs := oJsCbs['base_tributo']
				self:setTotalBaseIbsCbs(nBaseIbsCbs)
			endif

			//Proteção para o caso de não existir o campo CJ3_CCT
			if lExistCJ3_CCT
				cClassTrib := oJsCbs['dados_escriturados']['cclasstrib']
			endif

			if lExistCJ3_INDOP .and. empty(cIndOp)
				cIndOp := oJsCbs['dados_escriturados']['indicador_operacao']
			endif

			lDoacao := oJsCbs['dados_adicionais']['perfil de operacao']['dados adicionais']:HasProperty('INDDOACAO') .and. oJsCbs['dados_adicionais']['perfil de operacao']['dados adicionais']['INDDOACAO']['conteudo'] == '1'

		endif

		lGeraXml := .T.
	endif

	//Busca os dados de CST e cClassTrib caso tenha sido gerado algum IBS/CBS monofásico
	if oJsIbsMonoPadrao != nil .and. valtype(oJsIbsMonoPadrao['regras_escrituracao']) == 'J'
		self:getDadosMonofasico(oJsIbsMonoPadrao, @cCst , @cClassTrib, @lXmlMono)
	endif
	
	if oJsCbsMonoPadrao != nil .and. valtype(oJsCbsMonoPadrao['regras_escrituracao']) == 'J'
		self:getDadosMonofasico(oJsCbsMonoPadrao, @cCst , @cClassTrib, @lXmlMono)
	endif

	if oJsIbsMonoRetencao != nil .and. valtype(oJsIbsMonoRetencao['regras_escrituracao']) == 'J'
		self:getDadosMonofasico(oJsIbsMonoRetencao, @cCst , @cClassTrib, @lXmlMono)
	endif
	
	if oJsCbsMonoRetencao != nil .and. valtype(oJsCbsMonoRetencao['regras_escrituracao']) == 'J'
		self:getDadosMonofasico(oJsCbsMonoRetencao, @cCst , @cClassTrib, @lXmlMono)
	endif

	if oJsIbsMonoRetido != nil .and. valtype(oJsIbsMonoRetido['regras_escrituracao']) == 'J'
		self:getDadosMonofasico(oJsIbsMonoRetido, @cCst , @cClassTrib, @lXmlMono)
	endif

	if oJsCbsMonoRetido != nil .and. valtype(oJsCbsMonoRetido['regras_escrituracao']) == 'J'
		self:getDadosMonofasico(oJsCbsMonoRetido, @cCst , @cClassTrib, @lXmlMono)
	endif
	
	//if oJsIbsMonoDiferimento != nil .and. valtype(oJsIbsMonoDiferimento['regras_escrituracao']) == 'J'
	//	self:getDadosMonofasico(oJsIbsMonoDiferimento, @cCst , @cClassTrib, @lXmlMono)
	//endif
    //
	//elseif oJsCbsMonoDiferimento != nil .and. valtype(oJsCbsMonoDiferimento['regras_escrituracao']) == 'J'
	//	self:getDadosMonofasico(oJsCbsMonoDiferimento, @cCst , @cClassTrib, @lXmlMono)
	//endif
	

	if lGeraXml .or. lXmlMono

		If ::cModelo == "55"
			cXmlOpen := '<imposto>'
			cXmlOpen +=     '<codigo>IBSCBS</codigo>'
			cXmlOpen += 	'<Tributo>'

			cXmlClose := 	'</Tributo>'
			cXmlClose += '</imposto>'
		ElseIf ::cModelo == "56"
			cXmlOpen := '<codigo>IBSCBS</codigo>'

			IF ::lXmlEnv
				cXmlOpen += '<finnfse>0</finnfse>' //Indicador da finalidade da emissão de NFS-e | Manual so tem a opcao 0
				if type("oOtherInfo['aDest']") <> "U" .and. len(oOtherInfo['aDest']) > 30 .and. oOtherInfo['aDest'][31] == "F"
					cXmlOpen += "<indfinal>1</indfinal>"
                Else
                    cXmlOpen += "<indfinal>0</indfinal>"
				endif
			ENDIF

			If !empty(cIndOp)
				cXmlOpen += '<cindop>'+ cIndOp +'</cindop>'
			Endif

			If ::lXmlEnv
				If ( ValType(oOtherInfo['aNota']) <> "U" .And. len(oOtherInfo['aNota']) > 10 .And. allTrim(oOtherInfo['aNota'][11]) $ "12345" ) // Indicadores de tipo de operação que devem ser considerados para geração da tag tpOper	
					If !empty(cServTpOper) ;
						.and. valtype(oOtherInfo['aProd']) <> "U" ;
						.and. len(oOtherInfo['aProd']) > 0 ;
						.and. len(oOtherInfo['aProd'][1]) > 42;
						.and. allTrim(oOtherInfo['aProd'][1][43]) $ cServTpOper
                    	cXmlOpen += "<tpoper>"+alltrim(oOtherInfo['aNota'][11])+"</tpoper>" 
                	Endif
				Endif

				if type("oOtherInfo['aDest']") <> "U" .and. len(oOtherInfo['aDest']) > 27 .and. !Empty(allTrim(oOtherInfo['aDest'][28]))
					cXmlOpen += "<tpentegov>"+alltrim(oOtherInfo['aDest'][28])+"</tpentegov>" 
				endif

				If lDoacao .And. ::lXmlEnv
					cXmlOpen += "<inddoacao>" + '1' + "</inddoacao>"
				EndIf

				If type("oOtherInfo['aEntrega']") <> "U" .and. type("oOtherInfo['aDest']") <> "U" .and. oOtherInfo['aEntrega'][1] <> oOtherInfo['aDest'][1]
                    cXmlOpen += "<inddest>1</inddest>"
                Else
                    cXmlOpen += "<inddest>0</inddest>"
                EndIf
			ENDIF
			cXmlOpen += '<Tributo>'

			cXmlClose := '<pRedutor>0</pRedutor>'
			cXmlClose += '</Tributo>'
	
		Else
			cXmlOpen := '<IBSCBS>'

			cXmlClose := '</IBSCBS>'
		EndIf
		IF ::lXmlEnv
			cXmlCbsIbs := "<impostoibscbs>"
		Endif
		cXmlCbsIbs += cXmlOpen
		cXmlCbsIbs +=         '<CST>' + cCst + '</CST>'
		cXmlCbsIbs +=         '<cClassTrib>' + cClassTrib + '</cClassTrib>'
		If lDoacao .And. !::lXmlEnv
			cXmlCbsIbs += "<indDoacao>" + '1' + "</indDoacao>"
		EndIf

		lXmlgIBSCBS := Self:setIbsCBSbyCST( cCST )

		::lTagEstCred := cClassTrib $ "410026|410030" .And. !::lXmlEnv .or. (type("oNFeOtherInfo['aNota']") == "A" .and. len(oNFeOtherInfo['aNota']) >= 11 .and. allTrim(oNFeOtherInfo['aNota'][5]) == "6" .and. allTrim(oNFeOtherInfo['aNota'][11]) == "7")
		
		if lGeraXml
			cXmlCbsIbs += self:getXmlgIBSCBS( cDocumentItemId, nBaseIbsCbs, oNfTciIntg, lXmlgIBSCBS , oJsCbs, oJsIbsEstadual, oJsIbsMunicipal)
		endif

		if lXmlMono
			cXmlCbsIbs += self:getXmlgIBSCBSMono(oJsIbsMonoPadrao, oJsCbsMonoPadrao, oJsIbsMonoRetencao, oJsCbsMonoRetencao, oJsIbsMonoRetido, oJsCbsMonoRetido /*, oJsIbsMonoDiferimento, oJsCbsMOnoDiferimento*/)
		endif
			
		If ::lTagEstCred
			cXmlCbsIbs += self:getXmlgEstornoCred(oJsIbsEstadual, oJsCbs)
		EndIf
		
		If !::cModelo == "56"
			cXmlCbsIbs += self:getXmlgIBSCBSCredPres(oJsIbsCreditoPresumido, oJsCbsCreditoPresumido, cDocumentItemId)
		EndIf		

		//cXmlCbsIbs += self:getXmlgTransfCred()
		//Apenas para o CST 811? gAjusteCompet novo grupo do novo schema
		//gEstornoCred novo grupo do novo schema
		//gCredPresOper novo grupo do novo schema
		//cXmlCbsIbs += self:getXmlgCredPresIBSZFM()
		cXmlCbsIbs += cXmlClose
		IF ::lXmlEnv
			cXmlCbsIbs += "</impostoibscbs>"
		Endif


	endif

	FreeObj(oJsIbsEstadual)
	oJsIbsEstadual := nil

	FreeObj(oJsIbsMunicipal)
	oJsIbsMunicipal := nil

	FreeObj(oJsCbs)
	oJsCbs := nil

	FreeObj(oJsIbsMonoPadrao)
	oJsIbsMonoPadrao := nil

	FreeObj(oJsCbsMonoPadrao)
	oJsCbsMonoPadrao := nil

	FreeObj(oJsIbsMonoRetencao)
	oJsIbsMonoRetencao := nil

	FreeObj(oJsCbsMonoRetencao)
	oJsCbsMonoRetencao := nil

	FreeObj(oJsIbsMonoRetido)
	oJsIbsMonoRetido := nil

	FreeObj(oJsCbsMonoRetido)
	oJsCbsMonoRetido := nil

	FreeObj(oJsIbsCreditoPresumido)
	oJsIbsCreditoPresumido := nil

	FreeObj(oJsCbsCreditoPresumido)
	oJsCbsCreditoPresumido := nil

	//FreeObj(oJsIbsMonoDiferimento)
	//oJsIbsMonoDiferimento := nil

	//FreeObj(oJsCbsMonoDiferimento)
	//oJsCbsMonoDiferimento := nil
	
	FreeObj(oOtherInfo)
	oOtherInfo := nil
	
	FreeObj(oNFeOtherInfo)
	oNFeOtherInfo := nil

	FreeObj(oJsDoacao)
	oJsDoacao := nil

Return cXmlCbsIbs

/*/{Protheus.doc} 
Gera tags do subgrupo gIBSCBS do grupo IBSCBS
@type method
@version  P12 V1.2410
@author Carlos Eduardo Boy
@since 21/05/2025
/*/
Method getXmlgIBSCBS(cDocumentItemId as character, nBaseIbsCbs as numeric, oNfTciIntg as object, lXmlgIBSCBS as logical, oJsCbs as json, oJsIbsEstadual as json, oJsIbsMunicipal as json) as character class TaxInformation
	Local cXml as character
	Local nTotalIbsItem as numeric
	Local oJsIbsEstadualRegular 	:= oNfTciIntg:GetTax( cDocumentItemId, 'IBS_EST_REGULAR'	) as json
	Local oJsIbsMunicipalRegular 	:= oNfTciIntg:GetTax( cDocumentItemId, 'IBS_MUN_REGULAR'	) as json
	Local oJsCbsRegular 			:= oNfTciIntg:GetTax( cDocumentItemId, 'CBS_REGULAR'		) as json
	Local oJsIbsCreditoPresumido 	:= oNfTciIntg:GetTax( cDocumentItemId, 'IBS_CRED_PRESUMIDO'	) as json
	Local oJsCbsCreditoPresumido 	:= oNfTciIntg:GetTax( cDocumentItemId, 'CBS_CRED_PRESUMIDO'	) as json

	if self:lAglutinaItens
		self:nBaseIbsCbsAglut += nBaseIbsCbs
		nBaseIbsCbs := self:nBaseIbsCbsAglut
	endIf

	cXml += '<gIBSCBS>'
	cXml +=     '<vBC>' + ltrim(str(nBaseIbsCbs,13,2)) + '</vBC>'
	cXml +=     self:getXmlgIBSUF(oJsIbsEstadual, @nTotalIbsItem, lXmlgIBSCBS)
	cXml +=     self:getXmlgIBSMun(oJsIbsMunicipal, @nTotalIbsItem, oJsIbsEstadual)
	If ::cModelo $ "55-62"
		cXml +=     '<vIBS>' + lTrim(str(nTotalIbsItem,13,2)) + '</vIBS>'
	EndIf
	cXml +=     self:getXmlgCBS(oJsCbs, lXmlgIBSCBS)
	cXml +=     self:getXmlgTribRegular(oJsIbsEstadualRegular, oJsIbsMunicipalRegular, oJsCbsRegular)
	If ::cModelo == "56"
		cXml +=     self:getXmlgIBSCredPres(oJsIbsCreditoPresumido)
		cXml +=     self:getXmlgCBSCredPres(oJsCbsCreditoPresumido)
	EndIf
	//cXml +=     self:getXmlgTribCompraGov()
	cXml += '</gIBSCBS>'
	
	If !lXmlgIBSCBS // Se o CST não deve gerar o grupo gIBSCBS, zera a variável para que nada seja retornado
		cXml := ''
	EndIf
		
	FreeObj(oJsIbsEstadualRegular)
	oJsIbsEstadualRegular := nil

	FreeObj(oJsIbsMunicipalRegular)
	oJsIbsMunicipalRegular := nil

	FreeObj(oJsCbsRegular)
	oJsCbsRegular := nil

	FreeObj(oJsIbsCreditoPresumido)
	oJsIbsCreditoPresumido := nil

	FreeObj(oJsCbsCreditoPresumido)
	oJsCbsCreditoPresumido := nil

return cXml

/*/{Protheus.doc} 
Gera tags do subgrupo gIBSUF do grupo gIbSCBS
@type method
@version  P12 V1.2410
@author Carlos Eduardo Boy
@since 21/05/2025
/*/
Method getXmlgIBSUF(oStateTax as json, nTotalIbs as numeric, lXmlgIBSCBS as logical) as character class TaxInformation
	Local cXml as character
	Local nAliquotaTributo as numeric
	Local nValorTributo    as numeric

	if oStateTax != nil
		if  oStateTax['dados_escriturados']['perc_red_aliquota'] > 0
			nAliquotaTributo := oStateTax['dados_escriturados']['perc_aliquota_original']
		else
			nAliquotaTributo := oStateTax['aliquota_tributo']
		endif
		nValorTributo    := oStateTax['dados_escriturados']['valor_tributado']
	endif

	if self:lAglutinaItens
		self:nValorTributoUBSUFaglut += nValorTributo
		nValorTributo := self:nValorTributoUBSUFaglut
	endIf

	cXml += '<gIBSUF>'
	cXml +=     '<pIBSUF>' + ltrim(str(nAliquotaTributo,8,4)) + '</pIBSUF>'
	cXml +=     self:getXmlgDif(oStateTax)
	cXml +=     self:getXmlgDevTrib(oStateTax)
	cXml +=     self:getXmlgRed(oStateTax)
	cXml +=     '<vIBSUF>' + ltrim(str(nValorTributo,16,2)) + '</vIBSUF>'
	cXml += '</gIBSUF>'

	nTotalIbs += nValorTributo

	self:setTotalTaxByTotvsId(oStateTax, lXmlgIBSCBS)

return cXml

/*/{Protheus.doc} 
Gera tags do subgrupo gDif do grupo gIBSUF
@type method
@version  P12 V1.2410
@author Carlos Eduardo Boy
@since 22/05/2025
/*/
Method getXmlgDif(oTax as json, lGeraDifZero as logical) as character class TaxInformation
	Local cXml := "" as character
	Local pDif := 0	 as numeric
	Local vDif := 0  as numeric
	
	default lGeraDifZero := .F.

	if (oTax != nil) .and. (oTax['dados_escriturados']['valor_diferido'] != nil)
		if ( oTax['dados_escriturados']['perc_diferido'] > 0 )
			pDif := oTax['dados_escriturados']['perc_diferido']
			vDif := oTax['dados_escriturados']['valor_diferido']
		endif
	endif

	if lGeraDifZero .or. pDif > 0 .or. vDif > 0
		if self:lAglutinaItens
			self:vDifaglut += vDif
			vDif := self:vDifaglut
		endIf

		cXml += '<gDif>'
		cXml +=     '<pDif>' + ltrim(str(pDif,8,4)) + '</pDif>'
		cXml +=     '<vDif>' + ltrim(str(vDif,13,2)) + '</vDif>'
		cXml += '</gDif>'
	endIf

return cXml

/*/{Protheus.doc} 
Gera tags do subgrupo gDevTrib do grupo gIBSUF
@type method
@version  P12 V1.2410
@author Carlos Eduardo Boy
@since 22/05/2025
/*/
Method getXmlgDevTrib(oTax as json) as character class TaxInformation
	Local cXml as character
	if oTax != nil
		cXml += '<gDevTrib>'
		cXml +=     '<vDevTrib>' + lTrim(str(0, 13, 2)) + '</vDevTrib>'
		cXml += '</gDevTrib>'
	endif

return cXml

/*/{Protheus.doc} 
Gera tags do subgrupo gRed(Grupo de informações da redução da alíquota) do grupo gIBSUF
@type method
@version  P12 V1.2410
@author Carlos Eduardo Boy
@since 22/05/2025
/*/
Method getXmlgRed(oTax as json) as character class TaxInformation
	Local cXml as character
	if oTax != nil .and. oTax['dados_escriturados']['perc_red_aliquota'] > 0
		cXml += '<gRed>'
		cXml +=     '<pRedAliq>' +  lTrim(str(oTax['dados_escriturados']['perc_red_aliquota'],8,4)) + '</pRedAliq>'
		cXml +=     '<pAliqEfet>' + lTrim(str(oTax['aliquota_tributo'],8,4)) + '</pAliqEfet>'
		cXml += '</gRed>'
	endif
return cXml

/*/{Protheus.doc} 
Gera tags do subgrupo gIBSMun() do grupo gIBSCBS
@type method
@version  P12 V1.2410
@author Carlos Eduardo Boy
@since 22/05/2025
/*/
Method getXmlgIBSMun(oMunicipalTax as json, nTotalIbs as numeric, oJsIbsEstadual as json) as character class TaxInformation

	Local cXml 				as character
	Local nAliquotaTributo	as numeric
	Local nValorTributo		as numeric
	local lGeraDifMunZero 	as logical

	default oJsIbsEstadual := nil

	if oMunicipalTax != nil
		if oMunicipalTax['dados_escriturados']['perc_red_aliquota'] > 0
			nAliquotaTributo := oMunicipalTax['dados_escriturados']['perc_aliquota_original']
		else
			nAliquotaTributo := oMunicipalTax['aliquota_tributo']
		endif
		nValorTributo    := oMunicipalTax['dados_escriturados']['valor_tributado']
	endif

	if self:lAglutinaItens
		self:nValorTributoAglut += nValorTributo
		nValorTributo := self:nValorTributoAglut
	endIf

	lGeraDifMunZero := oJsIbsEstadual != nil .and. oJsIbsEstadual['dados_escriturados']['valor_diferido'] > 0

	cXml += '<gIBSMun>'
	cXml +=     '<pIBSMun>' + ltrim(str(nAliquotaTributo,8,4)) + '</pIBSMun>'
	cXml +=     self:getXmlgDif(oMunicipalTax, lGeraDifMunZero)
	cXml +=     self:getXmlgDevTrib(oMunicipalTax)
	cXml +=     self:getXmlgRed(oMunicipalTax)
	cXml +=     '<vIBSMun>' + ltrim(str(nValorTributo,13,2)) + '</vIBSMun>'
	cXml += '</gIBSMun>'

	nTotalIbs += nValorTributo

	self:setTotalTaxByTotvsId(oMunicipalTax)

return cXml

/*/{Protheus.doc} 
Gera tags do subgrupo gCBS() do grupo gIBSCBS
@type method
@version  P12 V1.2410
@author Carlos Eduardo Boy
@since 22/05/2025
/*/
Method getXmlgCBS(oTax as json, lXmlgIBSCBS as logical) as character class TaxInformation
	Local cXml as character
	Local nAliquotaTributo as numeric
	Local nValorTributo    as numeric

	if oTax != nil
		if oTax['dados_escriturados']['perc_red_aliquota'] > 0
			nAliquotaTributo := oTax['dados_escriturados']['perc_aliquota_original']
		else
			nAliquotaTributo := oTax['aliquota_tributo']
		endif
		nValorTributo    := oTax['dados_escriturados']['valor_tributado']
	endif

	if self:lAglutinaItens
		self:nValorTributoCBSAglut += nValorTributo
		nValorTributo := self:nValorTributoCBSAglut
	endIf

	cXml += '<gCBS>'
	cXml +=     '<pCBS>' + ltrim(str(nAliquotaTributo,8,4)) + '</pCBS>'
	cXml +=     self:getXmlgDif(oTax)
	cXml +=     self:getXmlgDevTrib(oTax)
	cXml +=     self:getXmlgRed(oTax)
	cXml +=     '<vCBS>' + ltrim(str(nValorTributo,13,2)) + '</vCBS>'
	cXml += '</gCBS>'

	self:setTotalTaxByTotvsId(oTax, lXmlgIBSCBS)

return cXml

/*/{Protheus.doc}
Gera tags do subgrupo gTribRegular() do grupo gIBSCBS
@type method
@version  P12 V1.2410
@author Carlos Eduardo Boy
@since 22/05/2025
/*/
Method getXmlgTribRegular(oJsIbsEstadualRegular as json, oJsIbsMunicipalRegular as json, oJsCbsRegular as json) as character class TaxInformation
	Local cXml as character
	Local nAliqEfetRegIbsUf as numeric
	Local nAliqEfetRegIbsMun as numeric
	Local nAliqEfetRegCbs as numeric
	Local nValorTribRegIbsUf as numeric
	Local nValorTribRegIbsMun as numeric
	Local nValorTribRegCbs as numeric
	Local lTributoRegular := oJsIbsEstadualRegular != nil .or. oJsIbsMunicipalRegular != nil .or. oJsCbsRegular != nil as logical
	Local cCstTributoRegular as character
	Local cClassTributoRegular as character

	if lTributoRegular

		//Verifica se o imposto estadual regular foi informado
		if oJsIbsEstadualRegular != nil
			nAliqEfetRegIbsUf := oJsIbsEstadualRegular['aliquota_tributo']
			nValorTribRegIbsUf := oJsIbsEstadualRegular['dados_escriturados']['valor_tributado']

			cCstTributoRegular := oJsIbsEstadualRegular['dados_escriturados']['cst']
			cClassTributoRegular := oJsIbsEstadualRegular['dados_escriturados']['cclasstrib']

			self:setTotalTaxByTotvsId(oJsIbsEstadualRegular)
		endif

		//Verifica se o imposto municipal regular foi informado
		if oJsIbsMunicipalRegular != nil
			nAliqEfetRegIbsMun := oJsIbsMunicipalRegular['aliquota_tributo']
			nValorTribRegIbsMun := oJsIbsMunicipalRegular['dados_escriturados']['valor_tributado']
			if empty(cCstTributoRegular)
				cCstTributoRegular := oJsIbsMunicipalRegular['dados_escriturados']['cst']
				cClassTributoRegular := oJsIbsMunicipalRegular['dados_escriturados']['cclasstrib']
			endif

			self:setTotalTaxByTotvsId(oJsIbsMunicipalRegular)
		endif

		//Verifica se o imposto federal regular foi informado
		if oJsCbsRegular != nil
			nAliqEfetRegCbs := oJsCbsRegular['aliquota_tributo']
			nValorTribRegCbs := oJsCbsRegular['dados_escriturados']['valor_tributado']
			if empty(cCstTributoRegular)
				cCstTributoRegular := oJsCbsRegular['dados_escriturados']['cst']
				cClassTributoRegular := oJsCbsRegular['dados_escriturados']['cclasstrib']
			endif

			self:setTotalTaxByTotvsId(oJsCbsRegular)
		endif

		if self:lAglutinaItens
			self:nValorTribRegIbsUfAglut += nValorTribRegIbsUf
			nValorTribRegIbsUf := self:nValorTribRegIbsUfAglut

			self:nValorTribRegIbsMunAglut += nValorTribRegIbsMun
			nValorTribRegIbsMun := self:nValorTribRegIbsMunAglut

			self:nValorTribRegCbsAglut += nValorTribRegCbs
			nValorTribRegCbs := self:nValorTribRegCbsAglut
		endIf

		cXml += '<gTribRegular>'
		cXml +=     '<CSTReg>' + cCstTributoRegular + '</CSTReg>'
		cXml +=     '<cClassTribReg>' + cClassTributoRegular + '</cClassTribReg>'
		cXml +=     '<pAliqEfetRegIBSUF>' + lTrim(str(nAliqEfetRegIbsUf ,8,4)) + '</pAliqEfetRegIBSUF>'
		cXml +=     '<vTribRegIBSUF>' + lTrim(str(nValorTribRegIbsUf,13,2)) + '</vTribRegIBSUF>'
		cXml +=     '<pAliqEfetRegIBSMun>' + '0' + '</pAliqEfetRegIBSMun>' //lTrim(str(nAliqEfetRegIbsMun,8,4))
		cXml +=     '<vTribRegIBSMun>' + '0' + '</vTribRegIBSMun>' //lTrim(str(nValorTribRegIbsMun,13,2))
		cXml +=     '<pAliqEfetRegCBS>' + lTrim(str(nAliqEfetRegCbs,8,4)) + '</pAliqEfetRegCBS>'
		cXml +=     '<vTribRegCBS>' + lTrim(str(nValorTribRegCbs,13,2)) + '</vTribRegCBS>'
		cXml += '</gTribRegular>'

	endif

return cXml

/*/{Protheus.doc}
Gera tags do subgrupo gIBSCredPres() do grupo gIBSCBS
@type method
@version  P12 V1.2410
@author Carlos Eduardo Boy
@since 22/05/2025
/*/
Method getXmlgIBSCredPres(oJsIbsCreditoPresumido as json) as character class TaxInformation
	Local cXml 		   as character
	Local nCodCredPres as character
	Local nvCredPres   as numeric


	If( oJsIbsCreditoPresumido != nil .And. ::lXmlEnv)
		nvCredPres := oJsIbsCreditoPresumido['dados_escriturados']['valor_tributado']
		nCodCredPres := Val(oJsIbsCreditoPresumido['dados_adicionais']['regra calculo']['dados adicionais']['CCREDPRES']['conteudo'])
		If self:lAglutinaItens
			self:nValorCredPresIBSAglut += nvCredPres
			nvCredPres := self:nValorCredPresIBSAglut
		EndIf

		cXml += '<gIBSCredPres>'
		cXml +=     '<cCredPres>' + lTrim(strZero(nCodCredPres, 2)) + '</cCredPres>' //Código de Classificação do Crédito Presumido
		//cXml +=     '<pCredPres>' + ltrim(str(oJsIbsCreditoPresumido['aliquota_tributo'],8,4)) + '</pCredPres>'
		cXml +=     '<vCredPres>' + ltrim(str(nvCredPres,13,2)) + '</vCredPres>'
		//cXml +=     '<vCredPresCondSus>' + lTrim(str(0, 13, 2)) + '</vCredPresCondSus>'
		cXml += '</gIBSCredPres>'

		self:setTotalTaxByTotvsId(oJsIbsCreditoPresumido)
	EndIf
return cXml


/*/{Protheus.doc}
Gera tags do subgrupo gCBSCredPres() do grupo gIBSCBS
@type method
@version  P12 V1.2410
@author Carlos Eduardo Boy
@since 22/05/2025
/*/
Method getXmlgCBSCredPres(oJsCbsCreditoPresumido as json) as character class TaxInformation
	Local cXml as character
	Local nCodCredPres as character
	Local nvCredPres as numeric

	If( oJsCbsCreditoPresumido != nil .And. ::lXmlEnv )
		nvCredPres := oJsCbsCreditoPresumido['dados_escriturados']['valor_tributado']
		nCodCredPres := Val(oJsCbsCreditoPresumido['dados_adicionais']['regra calculo']['dados adicionais']['CCREDPRES']['conteudo'])
		If self:lAglutinaItens
			self:nValorCredPresCBSAglut += nvCredPres
			nvCredPres := self:nValorCredPresCBSAglut
		EndIf

		cXml += '<gCBSCredPres>'
		cXml +=     '<cCredPres>' + lTrim(strZero(nCodCredPres, 2)) + '</cCredPres>' //Código de Classificação do Crédito Presumido
		//cXml +=     '<pCredPres>' + ltrim(str(oJsCbsCreditoPresumido['aliquota_tributo'],8,4)) + '</pCredPres>'
		cXml +=     '<vCredPres>' + ltrim(str(nvCredPres,13,2)) + '</vCredPres>'
		//cXml +=     '<vCredPresCondSus>' + lTrim(str(0, 13, 2)) + '</vCredPresCondSus>'
		cXml += '</gCBSCredPres>'

		self:setTotalTaxByTotvsId(oJsCbsCreditoPresumido)
	EndIf
return cXml


