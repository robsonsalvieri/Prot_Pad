#include "totvs.ch"
#include "tlpp-rest.th"
#include "tlpp-core.th"

namespace totvs.protheus.backoffice.apps.grr.integration.plans

//------------------------------------------------------------------
/*/{Protheus.doc} PlansIntegration
    @description Classe com implementações de processamento dos Planos.
    @author claudio.yoshio@totvs.com.br
    @since 16/03/2026
    @version 12.1.2510
*/
//------------------------------------------------------------------
class PlansIntegration
    static method getBranchesToProcess(cCompanyGroup as character, aOrganizations as array) as array
endClass

//------------------------------------------------------------------
/*/{Protheus.doc} getBranchesToProcess
    @description Retorna as filiais que devem ser processadas, de acordo
                 com as filiais ativas para integração no Protheus x
                 filias configuradas para o plano na plataforma.
    @type method
    @author claudio.yoshio@totvs.com.br
	@since 16/03/2026
    @version 12.1.2510
/*/
//------------------------------------------------------------------
method getBranchesToProcess(cCompanyGroup as character, aOrganizations as array) as array Class PlansIntegration
    local aBranchesToProcess := {} as array
    local aActiveBranches as array
    local jSplittedBranch := jsonObject():new() as json
    local nLenActiveBranches as numeric
    local nX as numeric

    aActiveBranches := totvs.protheus.backoffice.apps.grr.general.Util():getActiveBranches(cCompanyGroup)
    
    nLenActiveBranches := len(aActiveBranches)
    for nX:=1 to nLenActiveBranches
        jSplittedBranch := totvs.protheus.backoffice.apps.grr.general.Util():splitBranchCode(aActiveBranches[nX])

        cCompanyGroupIntegrationId := cCompanyGroup + "|"
        cCompanyIntegrationId := cCompanyGroupIntegrationId + jSplittedBranch['company']
        cUnityIntegrationId := cCompanyIntegrationId + jSplittedBranch['unity']
        cBranchIntegrationId := cUnityIntegrationId + jSplittedBranch['branch']

        if aScan(aOrganizations, {|x| allTrim(x:organizationIntegrationId) == allTrim(cBranchIntegrationId)} ) > 0 .or.;
           aScan(aOrganizations, {|x| allTrim(x:organizationIntegrationId) == allTrim(cUnityIntegrationId)} ) > 0 .or.;
           aScan(aOrganizations, {|x| allTrim(x:organizationIntegrationId) == allTrim(cCompanyIntegrationId)} ) > 0 .or.;
           aScan(aOrganizations, {|x| allTrim(x:organizationIntegrationId) == allTrim(cCompanyGroupIntegrationId)} ) > 0

            aAdd(aBranchesToProcess, jSplittedBranch['company'] + jSplittedBranch['unity'] + jSplittedBranch['branch'])
        endIf

    next nX

    jSplittedBranch:fromJson("{}")
    freeObj(jSplittedBranch)

    aSize(aActiveBranches, 0)
    aActiveBranches := NIL
return aBranchesToProcess
