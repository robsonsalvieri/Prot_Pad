#include "totvs.ch"
#include "tlpp-core.th"

namespace totvs.protheus.backoffice.apps.grr.messages
using namespace totvs.protheus.backoffice.apps.grr.general

//-------------------------------------------------------------------
/*/{Protheus.doc} PaymentOrderProtheusMessageHandler
    @author claudio.yoshio@totvs.com.br
    @since 11/05/2026
    @version 12.1.2510
*/
//-------------------------------------------------------------------
class PaymentOrderProtheusMessageHandler from totvs.protheus.backoffice.apps.grr.messages.HandleMessage
    public method new() as object
    protected method processMessage(jData as json) as logical
endClass

//------------------------------------------------------------------
/*/{Protheus.doc} new
    @type method
    @author claudio.yoshio@totvs.com.br
	@since 11/05/2026
    @version 12.1.2510
/*/
//-------------------------------------------------------------------
method new() as object class PaymentOrderProtheusMessageHandler
    local jMandatoryProperties := JsonObject():new() as json

    _Super:new()

    jMandatoryProperties["organizationIntegrationId"] := {"type": "C", "notEmpty": .T.}
    jMandatoryProperties["billIntegrationId"]         := {"type": "C", "notEmpty": .T.}
    jMandatoryProperties["billId"]                    := {"type": "C", "notEmpty": .T.}
    jMandatoryProperties["chargeId"]                  := {"type": "C", "notEmpty": .T.}
    jMandatoryProperties["source"]                    := {"type": "C", "notEmpty": .T.}
    jMandatoryProperties["currency"]                  := {"type": "C", "notEmpty": .T.}
    jMandatoryProperties["paymentMethod"]             := {"type": "N", "notEmpty": .T.}
    jMandatoryProperties["customerIntegrationId"]     := {"type": "C", "notEmpty": .T.}
    jMandatoryProperties["totalAmount"]               := {"type": "N", "notEmpty": .T.}
    jMandatoryProperties["dueDate"]                   := {"type": "C", "notEmpty": .T.}

    self:setMandatoryProperties(jMandatoryProperties)
return self

//------------------------------------------------------------------
/*/{Protheus.doc} processMessage
    @type method
    @author claudio.yoshio@totvs.com.br
	@since 11/05/2026
    @version 12.1.2510
/*/
//-------------------------------------------------------------------
method processMessage(jData as json) as logical class PaymentOrderProtheusMessageHandler
    local lSuccess := .F. as logical
    local cIdDoc as character
    local cChargeId as character
    local oPaymentOrder as object
    local jCreatePaymentOrder as json

    if jData['source'] == "GRRI110"    
        cChargeId := jData['chargeId']
        cIdDoc := jData['billIntegrationId']

        oPaymentOrder := totvs.protheus.backoffice.apps.grr.integration.paymentorder.PaymentOrderIntegration():new(cChargeId)
        jCreatePaymentOrder := oPaymentOrder:createPaymentOrderIntegration(cChargeId, cIdDoc)
        lSuccess := jCreatePaymentOrder['status'] == "true"
    endIf
return lSuccess
