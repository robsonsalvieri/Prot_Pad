//-------------------------------------------------------------------
/*/{Protheus.doc} aliasToJsonArray
    Retorna um vetor de JSON com o conteúdo dos campos informados no parâmetro todos os registros do alias.
    @author guilherme.sordi@totvs.com.br
    @since 20/11/2024
    @version 12.1.2410
*/
//-------------------------------------------------------------------
method aliasToJsonArray(cAlias as character, aFields as array) as array class Util
    local aList := {} as array
    local jRecord as json
    local nX as numeric

    (cAlias)->(DbGoTop())
    while !(cAlias)->(eof())
        jRecord := JsonObject():new()
        for nX := 1 to len(aFields)
            jRecord[lower(aFields[nX])] := (cAlias)->&(aFields[nX])
        next    
        aAdd(aList, jRecord)
        (cAlias)->(dbSkip())
    endDo
return aList
