#include "tlpp-core.th"
#include "tlpp-rest.th"

namespace totvs.protheus.backoffice.apps.grr.general

class ControllerBase
    public method new() as object
    
    protected method checkMandatoryFields(jData as json, aMandatoryFields as array) as logical
    protected method getBody() as json
endClass

//-------------------------------------------------------------------
/*/{Protheus.doc} new
    @author guilherme.sordi@totvs.com.br
    @since 27/04/2026
    @type method
    @version 12.1.2410
/*/
//-------------------------------------------------------------------
method new() as object class ControllerBase
return self

//-------------------------------------------------------------------
/*/{Protheus.doc} checkMandatoryFields
    @description Valida se os campos obrigatorios foram enviados no json informado.
    @author guilherme.sordi@totvs.com.br
    @since 27/04/2026
    @type method
    @version 12.1.2410
/*/
//-------------------------------------------------------------------
method checkMandatoryFields(jData as json, aMandatoryFields as array) as logical class ControllerBase
    local nX as numeric
    local cField as character

    for nX := 1 to len(aMandatoryFields)
        cField := aMandatoryFields[nX]
        if empty(jData[cField])
           throw FlowControl():newException('Field ' + cField + ' is mandatory', 400)
        endIf
    next
return

//-------------------------------------------------------------------
/*/{Protheus.doc} getBody
    @description Retorna o corpo da requisicao REST convertido para json.
    @author guilherme.sordi@totvs.com.br
    @since 27/04/2026
    @type method
    @version 12.1.2410
/*/
//-------------------------------------------------------------------
method getBody() as json class ControllerBase
    local jBody := JsonObject():new() as json
    local cBody := oRest:getBodyRequest() as character

    if !empty(cBody)
        jBody:fromJson(cBody)
    endIf

return jBody
