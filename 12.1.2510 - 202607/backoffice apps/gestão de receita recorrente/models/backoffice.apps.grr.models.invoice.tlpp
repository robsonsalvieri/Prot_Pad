#include "totvs.ch"
#include "tlpp-rest.th"
#include "tlpp-core.th"

namespace totvs.protheus.backoffice.apps.grr.models
using namespace totvs.protheus.backoffice.apps.grr.general

//------------------------------------------------------------------
/*/{Protheus.doc} InvoiceIntegrationModel
    @description Classe responsável por adequar dados do Protheus
    à entidade Invoice do GR.
    @author claudio.yoshio@totvs.com.br
    @since 10/02/2025
    @version 12.1.2510
*/
//------------------------------------------------------------------
class InvoiceIntegrationModel from totvs.protheus.backoffice.apps.grr.models.DefaultModel
    private data cAlias as character
    private data cSalesOrderBranch as character
    private data cSalesOrderCode as character
    private data oExec as object
    private data nParamOrder as numeric
    private data lIsB2B as logical
    private data aSalesOrderItems as array

    public method new(cSalesOrderBranch as character, cSalesOrderCode as character) as object
    public method clear()
    public method setInvoice(cSalesOrderBranch as character, cSalesOrderCode as character)
    public method getJson() as json

    protected method openAlias()
    protected method closeAlias()
    protected method getCustomerJson() as json
    protected method getDueDate() as date
    protected method calculateAddOnTaxes() as numeric
endClass

//------------------------------------------------------------------
/*/{Protheus.doc} new
    @type method
    @author claudio.yoshio@totvs.com.br
	@since 06/01/2026
    @version 12.1.2510
/*/
//------------------------------------------------------------------
method new(cSalesOrderBranch as character, cSalesOrderCode as character) as object class InvoiceIntegrationModel
    _Super:new()

    self:clear()
    if valType(cSalesOrderBranch) == "C" .and. valType(cSalesOrderCode) == "C" .and. !empty(cSalesOrderCode)
        self:setInvoice(cSalesOrderBranch, cSalesOrderCode)
    endIf
return self

//------------------------------------------------------------------
/*/{Protheus.doc} clear
    @type method
    @author claudio.yoshio@totvs.com.br
	@since 06/01/2026
    @version 12.1.2510
/*/
//------------------------------------------------------------------
method clear() class InvoiceIntegrationModel
    self:closeAlias()
    self:cSalesOrderBranch := ""
    self:cSalesOrderCode := ""
    self:nParamOrder := 1
    self:lIsB2B := .F.
    self:aSalesOrderItems := array(0)
return

//------------------------------------------------------------------
/*/{Protheus.doc} setInvoice
    @type method
    @author claudio.yoshio@totvs.com.br
	@since 06/01/2026
    @version 12.1.2510
/*/
//------------------------------------------------------------------
method setInvoice(cSalesOrderBranch as character, cSalesOrderCode as character) class InvoiceIntegrationModel
    self:cSalesOrderBranch := cSalesOrderBranch
    self:cSalesOrderCode := cSalesOrderCode
return

//------------------------------------------------------------------
/*/{Protheus.doc} getJson
    @type method
    @author claudio.yoshio@totvs.com.br
	@since 06/01/2026
    @version 12.1.2510
/*/
//------------------------------------------------------------------
method getJson() as json class InvoiceIntegrationModel
    local jInvoice := JsonObject():new() as json
return jInvoice

//------------------------------------------------------------------
/*/{Protheus.doc} openAlias
    @type method
    @author claudio.yoshio@totvs.com.br
	@since 06/01/2026
    @version 12.1.2510
/*/
//------------------------------------------------------------------
method openAlias() class InvoiceIntegrationModel
    self:cAlias := self:oExec:openAlias()
return

//------------------------------------------------------------------
/*/{Protheus.doc} closeAlias
    @type method
    @author claudio.yoshio@totvs.com.br
	@since 06/01/2026
    @version 12.1.2510
/*/
//------------------------------------------------------------------
method closeAlias() class InvoiceIntegrationModel
    if !empty(self:cAlias) .and. Select(self:cAlias) > 0
        (self:cAlias)->(DbCloseArea())
    EndIf
    self:cAlias := ""
return

//------------------------------------------------------------------
/*/{Protheus.doc} getCustomerJson
    @description Retorna os dados do cliente do Pedido de Venda em formato JSON
    @type method
    @author claudio.yoshio@totvs.com.br
	@since 06/01/2026
    @version 12.1.2510
/*/
//------------------------------------------------------------------
method getCustomerJson() as json class InvoiceIntegrationModel
    local aArea := fwGetArea() as array
    local aAreaSa1 := SA1->(fwGetArea()) as array
    local aAreaSc5 := SC5->(fwGetArea()) as array
    local aAreaAi0 := AI0->(fwGetArea()) as array
    local aEmail := {} as array
    local cKeySa1 as character
    local cKeyAi0 as character
    local jCustomer as json

    SC5->(DbSetOrder(1)) //C5_FILIAL+C5_NUM
    if SC5->(MsSeek(self:cSalesOrderBranch + self:cSalesOrderCode))
        cKeySa1 := xFilial("SA1") + SC5->C5_CLIENT + SC5->C5_LOJACLI
        SA1->(dbSetOrder(1))
        if SA1->(dbSeek(cKeySa1))
            jCustomer := GRRI040J()
        endIf

        if valType(jCustomer) == "J"
            if jCustomer:hasProperty('emails') .and. valType(jCustomer['emails']) == "A"
                aEmail := jCustomer['emails']
            endIf

            AI0->(dbSetOrder(1))
            cKeyAi0 := xFilial("AI0") + SC5->C5_CLIENT + SC5->C5_LOJACLI
            if AI0->(dbSeek(cKeyAi0))
                //A plataforma do GR somente possui tratamento para o type 1 (Personal)
                if !empty(AI0->AI0_EMABOL)
                    aAdd(aEmail,{"type": 1, "emailAddress": EncodeUTF8(allTrim(AI0->AI0_EMABOL))}) // 1=Personal;2=Work;3=Home;4=Business;5=Billing 
                endIf
                if !empty(AI0->AI0_EMAPIX)
                    aAdd(aEmail,{"type": 1, "emailAddress": EncodeUTF8(allTrim(AI0->AI0_EMAPIX))}) // 1=Personal;2=Work;3=Home;4=Business;5=Billing 
                endIf
            endIf

            if len(aEmail) > 0
                jCustomer['emails'] := aEmail
            endIf
        endIf
    endIf

    fwRestArea(aAreaAi0)
    fwRestArea(aAreaSa1)
    fwRestArea(aAreaSc5)
    fwRestArea(aArea)
    
    aSize(aArea, 0)
    aArea := NIL
    aSize(aAreaSa1, 0)
    aAreaSa1 := NIL
    aSize(aAreaSc5, 0)
    aAreaSc5 := NIL
    aSize(aAreaAi0, 0)
    aAreaAi0 := NIL
return jCustomer

//------------------------------------------------------------------
/*/{Protheus.doc} getDueDate
    @description Retorna a data de vencimento do Pedido de Venda
    @type method
    @author claudio.yoshio@totvs.com.br
	@since 06/01/2026
    @version 12.1.2510
/*/
//------------------------------------------------------------------
method getDueDate() as date class InvoiceIntegrationModel
    local aArea := GetArea() as array
    local aAreaSC5 := SC5->(GetArea()) as array
    local aAreaSC9 := SC9->(GetArea()) as array
    local aAreaSE4 := SE4->(GetArea()) as array
    local aInstallments := {} as array
    local dDueDate := Date() as date
    local dStart as date

    SC5->(DbSetOrder(1)) //C5_FILIAL+C5_NUM
    if SC5->(MsSeek(self:cSalesOrderBranch + self:cSalesOrderCode))
        SE4->(DbSetOrder(1)) //E4_FILIAL+E4_CODIGO
        if SE4->(MsSeek(xFilial("SE4") + SC5->C5_CONDPAG))
            if SE4->E4_TIPO == "9"
                dDueDate := SC5->C5_DATA1
            else
                dStart := SC5->C5_EMISSAO

                SC9->(DbSetOrder(1)) //C9_FILIAL+C9_PEDIDO+C9_ITEM+C9_SEQUEN+C9_PRODUTO+C9_BLEST+C9_BLCRED        
                if SC9->(MSSeek(xFilial("SC9") + self:cSalesOrderCode))
                    dStart := SC9->C9_DATALIB
                endIf
                
                aInstallments := Condicao(1, SC5->C5_CONDPAG, , dStart)
                If !Empty(aInstallments)
                    dDueDate := aInstallments[1, 1]
                endIf
            endIf
        endIf
    endIf

    restArea(aAreaSC5)
    restArea(aAreaSC9)
    restArea(aAreaSE4)
    restArea(aArea)

    aSize(aArea, 0)
    aArea := NIL
    aSize(aAreaSC5, 0)
    aAreaSC5 := NIL
    aSize(aAreaSC9, 0)
    aAreaSC9 := NIL
    aSize(aAreaSE4, 0)
    aAreaSE4 := NIL
    
    fwFreeArray(aInstallments)    
return dDueDate

//------------------------------------------------------------------
/*/{Protheus.doc} calculateAddOnTaxes
    @description Calcula os impostos adicionais (impostos que não estão embutidos no preço dos itens)
    @type method
    @return nTotalAddOnTaxes, numeric, total de impostos adicionais calculados
    @author claudio.yoshio@totvs.com.br
	@since 06/01/2026
    @version 12.1.2510
/*/
//------------------------------------------------------------------
method calculateAddOnTaxes() as numeric class InvoiceIntegrationModel
    local nTotalAddOnTaxes := 0 as numeric
    local nAddOnTaxPerLine := 0 as numeric
    local nAddOnTaxPerUnit := 0 as numeric
    local jTaxes as json
    local nX as numeric

    if !self:lIsB2B .or. len(self:aSalesOrderItems) == 0
        return 0
    endif
    
    jTaxes := GrrTaxes():GetTaxes()

    if ValType(jTaxes) <> 'J' .or. !jTaxes:HasProperty('total_impostos') .or. !jTaxes:HasProperty('total_impostos_embutidos') .or. jTaxes['total_impostos'] <= jTaxes['total_impostos_embutidos']
        return 0
    endif

    nTotalAddOnTaxes := jTaxes['total_impostos'] - jTaxes['total_impostos_embutidos']
    nAddOnTaxPerLine := (nTotalAddOnTaxes / Len(self:aSalesOrderItems))

    for nX := 1 to Len(self:aSalesOrderItems)                        
        nAddOnTaxPerUnit := (nAddOnTaxPerLine / self:aSalesOrderItems[nX]['quantity']) //Soma o imposto por item

        self:aSalesOrderItems[nX]['baseValue'] += nAddOnTaxPerUnit
        self:aSalesOrderItems[nX]['value'] += nAddOnTaxPerUnit
        self:aSalesOrderItems[nX]['totalAmount'] += nAddOnTaxPerLine
    next

    jTaxes:fromJson("{}")
    fwFreeObj(jTaxes)
return nTotalAddOnTaxes
