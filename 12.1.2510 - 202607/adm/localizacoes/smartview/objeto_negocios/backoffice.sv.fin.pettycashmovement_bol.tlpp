#include "totvs.ch"
#INCLUDE 'topconn.ch'
#include "msobject.ch"
#include "tlpp-rest.th"
#include "tlpp-core.th"
#include "totvs.framework.treports.integratedprovider.th"
#include "backoffice.sv.fin.pettycashmovement.ch"

namespace totvs.protheus.backoffice.fin.smartView.integratedProvider

@totvsFrameworkTReportsIntegratedProvider(active=.F., team="SIGAFIN", tables="SEU", name="Movimientos de Caja Chica",;
customTables="SEU", country="BOL")

//-------------------------------------------------------------------
/*/{Protheus.doc} PettyCashMovementSmartViewBusinessObjectBOL
Clase para la creación del Objeto de Negocio - Localización Bolivia
@author gilberto.frohlich 
@since 29/10/2025
@version 12.1.2510  
*/  
//-------------------------------------------------------------------
class PettyCashMovementSmartViewBusinessObjectBOL from totvs.protheus.backoffice.fin.smartView.integratedProvider.PettyCashMovementSmartViewBusinessObject

	public method new() as object
	public method preData() as object
	public method processData() as object
	public method preSchema() as object

endclass

method new() class PettyCashMovementSmartViewBusinessObjectBOL

    public cCaixa as character
    public nSaldoAtual as numeric
    nSaldoAtual := 0
    cCaixa := ""

	_Super:new()

return self

method preData() as object class PettyCashMovementSmartViewBusinessObjectBOL
return self:oData

method processData() as object class PettyCashMovementSmartViewBusinessObjectBOL

    If cCaixa <> self:jData["EU_CAIXA"]
        cCaixa := self:jData["EU_CAIXA"]
        nSaldoAtual := self:jData["SALDO"]
    Endif

    If !(self:cAlias)->EU_TIPO  $ "12"
        nSaldoAtual += self:jData["EU_VALOR"]
    else
        nSaldoAtual -= self:jData["EU_VALOR"]
        self:jData["EU_VALOR"] *= -1
    Endif
    self:jData['SALATU'] := nSaldoAtual

Return

method preSchema() as object class PettyCashMovementSmartViewBusinessObjectBOL

    self:finAddProperty( "SALATU" , FWX3Titulo("FIJ_SALDO") , "number" ) 
    
Return self:oSchema
