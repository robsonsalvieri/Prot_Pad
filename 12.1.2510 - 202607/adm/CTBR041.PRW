Function Ctbr041()
    
    PRIVATE titulo		:= ""
    PRIVATE nomeprog	:= "CTBR041"
    PRIVATE aSelFil		:= {}

	//Validação de aviso/bloqueio do relatório em Release 12.1.2510 e superiores
