#include "totvs.ch"
#include "msobject.ch"
#include "tlpp-rest.th"
#include "tlpp-core.th"
#include "totvs.framework.treports.integratedprovider.th"
#include "backoffice.sv.fin.debitsettlement.ch"

namespace totvs.protheus.backoffice.fin.smartView.integratedProvider

@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGAFIN", tables="SE1",  name="Quitação de débitos", country="BRA")

//-------------------------------------------------------------------
    /*/{Protheus.doc} DebitSettlementSmartViewBusinessObject
    Classe do Objeto de Negócio
    @author matheus.monteiro@totvs.com.br
    @since 24/02/2026
    @version 12.1.2610
    */
//-------------------------------------------------------------------

class DebitSettlementSmartViewBusinessObject from totvs.protheus.backoffice.fin.smartView.integratedProvider.FinIntegratedProvider
    public method new() as object
    public method mySetSchema()

    protected method loadParameters()
    protected method loadDefaultParameters()
    protected method handleData()
    protected method initializeBusinessObject()
    protected method loadStatement()
    protected method handleStatement()

    protected method applyCustomText()  as character
    protected method applyCustomQuery() as character
    protected method applyCustomTitle() as character
    protected method getCurrencySymbol() as character 

    protected data cCustomerFrom as character
    protected data cCustomerTo as character
    protected data cBranchFrom  as character
    protected data cBranchTo as character
    protected data cBaseYear as character
    protected data cSGBD as character 

    protected data nParamOrder as numeric
    protected data nPettyCashCurrency as numeric

    protected data lFIN127TXT as logical  
    protected data lFIN127QRY as logical 
    protected data lFIN127TIT as logical
    protected data lPartialSettlement as logical
    protected data lConsolidatedBalance as logical

endclass

//-------------------------------------------------------------------
/*{Protheus.doc} new
Método de instância da classe

@return object: self

@author Fábio Henrique Andrade
@since 19/05/2023
@version 1.0
*/
//-------------------------------------------------------------------
method new() class DebitSettlementSmartViewBusinessObject
    _Super:new()

    self:initializeBusinessObject()
    self:setBranchFilter(.F., .F.)
    self:setAllTrim(.T.)
    self:setCompleteData(.T.)    
    self:setIsCBoxLookup(.T., .T.)

    self:lFIN127TXT  := ExistBlock("FIN127TXT")
    self:lFIN127QRY  := ExistBlock("FIN127QRY")
    self:lFIN127TIT  := ExistBlock("FIN127TIT") 

    self:nParamOrder := 1
    self:nPettyCashCurrency := 1

    self:cSGBD := Upper(TcGetDb())
    
return self

//-------------------------------------------------------------------
/*{Protheus.doc} initializeBusinessObject
@author matheus.monteiro@totvs.com.br
@since 24/02/2026
@version 12.1.2610
*/
//-------------------------------------------------------------------
method initializeBusinessObject() class DebitSettlementSmartViewBusinessObject
    self:setDisplayName(STR0001) 
    self:setDescription(STR0001) 
    self:setPergunte("FINT037")  
return

//-------------------------------------------------------------------
    /*{Protheus.doc} loadDefaultParameters
    @author matheus.monteiro@totvs.com.br
    @since 24/02/2026
    @version 12.1.2610
    */
//-------------------------------------------------------------------
method loadDefaultParameters() class DebitSettlementSmartViewBusinessObject
    self:cCustomerFrom := ''
    self:cCustomerTo := ''
    self:cBranchFrom := ''
    self:cBranchTo := ''
    self:cBaseYear := ''
    self:lPartialSettlement := .T.
    self:lConsolidatedBalance := .T.
return

//-------------------------------------------------------------------
/*/{Protheus.doc} FinIntegratedProvider
    @author matheus.monteiro@totvs.com.br   
    @since 24/02/2026
    @version 12.1.2610
*/
//-------------------------------------------------------------------
method loadParameters() class DebitSettlementSmartViewBusinessObject
    If self:oCurrentFilter != Nil
        self:cCustomerFrom := MV_PAR01
        self:cCustomerTo := MV_PAR02
        self:cBranchFrom := MV_PAR03
        self:cBranchTo := MV_PAR04
        self:cBaseYear := MV_PAR05
        self:lPartialSettlement := MV_PAR06 == 1
        self:lConsolidatedBalance := MV_PAR07 == 1 
    EndIf
return 

//-------------------------------------------------------------------
/*/{Protheus.doc} mySetSchema 
    Define o schema do objeto de negócio.
    Será implementado no objeto de negócio.
    @author matheus.monteiro@totvs.com.br
    @since 25/02/2026
    @version 1.0
*/
//-------------------------------------------------------------------
method mySetSchema() class DebitSettlementSmartViewBusinessObject
    self:finAddProperty("CUSTOMER", STR0002, "string") //"Cliente"
    self:finAddProperty("CUSTOMER_UNIT", STR0003, "string") //"Loja"
    self:finAddProperty("NAME", STR0004, "string") //"Nome"
    self:finAddProperty("DECLARATION", STR0005, "string") //"Declaração"
    self:finAddProperty("QUANTITY", STR0006, "number") //"Quantidade"
    self:finAddProperty("MONTH", STR0007, "string") //"Mês"
    self:finAddProperty("BALANCE", STR0008 , "number") //"Saldo"
    self:finAddProperty("PAY_BALANCE", STR0009, "number") //"Saldo Pago"
    self:finAddProperty("REPORT_TITLE", STR0014, "string") //"Título do relatório"
    self:finAddProperty("DECLARATION_TITLE", STR0020, "string") //"Título da declaração"
    self:finAddProperty("CURRENCY_SYMBOL", STR0021, "string") //"Símbolo da moeda"
    self:finAddProperty("JURIDICE", STR0022, "string") //"Juridico"
    self:finAddProperty("BRANCH_NAMES", STR0024, "string") //"Nomes das filiais"
return self:oSchema

//-------------------------------------------------------------------
/*/{Protheus.doc} handleData
    @author guilherme.sordi@totvs.com.br
    @since 01/09/2023
    @version 12.1.2210
*/
//-------------------------------------------------------------------
method handleData() class DebitSettlementSmartViewBusinessObject
    local cYear             := self:cBaseYear as character
    local cCompany          := Alltrim(SM0->M0_NOME) as character
    local cTitleReport      := "" as character
    local cTitleDeclaration := "" as character
    local cTextDeclaration  := "" as character
    Local cCustomerName     := Alltrim((self:cAlias)->(NOME)) as character
    Local cBranchNames      := Alltrim(FWGrpName(cEmpAnt)) + STR0025 + Alltrim(FWFilialName(cEmpAnt,cFilAnt,1)) as character

    If self:lFIN127TIT
        cTitleReport := self:applyCustomTitle(STR0001)
    Else 
        cTitleReport := STR0001 //"Quitação anual de débitos"
    EndIf
    
    If (self:cAlias)->JURIDICO_CLIENTE <> 1
        cTitleDeclaration := STR0018 //"Declaração anual de quitação de débitos"                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
        //	cTexto 	:= "Em cumprimento à Lei 12.007, de 29 de julho de 2009, o "+cEmpresa+" declara que o cliente "+Alltrim((cAlias)->(NOME))+" está quite com as  está quite quanto às faturas com vencimento no ano de
        // ""+cAno+". Esta declaração substitui, para comprovação do cumprimento das obrigações docliente, as quitações dos pagamentos mensais das faturas do ano de "+cAno+", bem comodos anos anteriores. "
        cTextDeclaration := STR0010 + cCompany + STR0011 + cCustomerName + STR0012 + cYear + STR0013 + cYear + STR0026
    Else
        cTitleDeclaration := STR0019 //"Declaração parcial de quitação de débitos" 
        //	cTexto 	:= "Em cumprimento à Lei 12.007, de 29 de julho de 2009, o "+cEmpresa+" declara que o cliente "+Alltrim((cAlias)->(NOME))+" está quite com as obrigações financeiras exigíveis referentes aos serviços prestados no período de "+;
        // ""+cAno+" + "". Informamos que existem débitos desse período em discussão judicial, razão pela qual esta declaração caracteriza quitação parcial, não abrangendo os valores em aberto. "                                                                                                                                                                                                                                                                                                                                         
        cTextDeclaration := STR0010 + cCompany + STR0011 + cCustomerName + STR0027 + cYear + STR0015
    EndIf

    If self:lFIN127TXT
        cTextDeclaration := self:applyCustomText(cTextDeclaration, cCustomerName, cYear)
    EndIf

    self:jData["BRANCH_NAMES"] := cBranchNames
    self:jData["REPORT_TITLE"] := cTitleReport
    self:jData["DECLARATION_TITLE"] := cTitleDeclaration
    self:jData["DECLARATION"] := cTextDeclaration
    self:jData["QUANTITY"] := (self:cAlias)->QTD 
    self:jData["CUSTOMER"] := (self:cAlias)->E1_CLIENTE      
    self:jData["CUSTOMER_UNIT"] := (self:cAlias)->E1_LOJA
    self:jData["NAME"] := (self:cAlias)->NOME

    If !self:lConsolidatedBalance
        self:jData["MONTH"] := MesExtenso(Val((self:cAlias)->MES))
    EndIf

    self:jData["BALANCE"] := (self:cAlias)->SALDO 
    self:jData["PAY_BALANCE"] := (self:cAlias)->VALOR 
    self:jData["CURRENCY_SYMBOL"] := self:getCurrencySymbol()

    If self:lPartialSettlement .And. (self:cAlias)->JURIDICO $ "1" 
        self:jData["JURIDICE"] := STR0023 //Juridico
    EndIf

return

//-------------------------------------------------------------------
/*{Protheus.doc} loadStatement
Cria o objeto self:oStatement da classe FWExecStatement com a query principal 
do objeto de negócio.

@author matheus.monteiro@totvs.com.br
@since 25/02/2026
@version 1.0
*/
//-------------------------------------------------------------------
method loadStatement() class DebitSettlementSmartViewBusinessObject
    local cQuery := "" as character

    cQuery := " SELECT "  
    cQuery += "  COUNT(SE1.E1_CLIENTE) QTD, SE1.E1_CLIENTE, SE1.E1_LOJA, SA1.A1_NOME NOME, SUM(SE1.E1_SALDO) SALDO,
    cQuery += "  SUM(CASE WHEN SE1.E1_SALDO = 0 THEN SE1.E1_VALOR  ELSE 0 END) VALOR, "

    If !self:lConsolidatedBalance 
        If self:cSGBD == 'ORACLE'
            cQuery += "  SUBSTR(SE1.E1_VENCREA,5,2) MES,
        Else       
            cQuery += "  SUBSTRING(SE1.E1_VENCREA,5,2) MES, 
        EndIf
    EndIf

    cQuery += "  CAST(MAX(CASE WHEN FRV.FRV_JURIDC = '1' THEN 1 ELSE 0 END) AS VARCHAR(1)) AS JURIDICO,
    cQuery += "  CASE WHEN EXISTS ( "
    cQuery += "   SELECT 1 "
    cQuery += "   FROM " + RetSqlName("SE1") + " SE1J "
    cQuery += "   LEFT JOIN " + RetSqlName("FRV") + " FRVJ "
    cQuery += "     ON FRVJ.FRV_CODIGO = SE1J.E1_SITUACA "
    cQuery += "     AND FRVJ.D_E_L_E_T_ = ? " 
    cQuery += "   WHERE SE1J.E1_CLIENTE = SE1.E1_CLIENTE "
    cQuery += "     AND SE1J.E1_LOJA = SE1.E1_LOJA "
    cQuery += "     AND FRVJ.FRV_JURIDC = ? "

    If self:cSGBD == 'ORACLE'
        cQuery += "  AND SUBSTR(SE1J.E1_VENCREA,1,4) = ? "
    Else       
        cQuery += "  AND SUBSTRING(SE1J.E1_VENCREA,1,4) = ? "
    EndIf

    cQuery += "  AND SE1J.D_E_L_E_T_ = ?) THEN 1 ELSE 0 END AS JURIDICO_CLIENTE "
    cQuery += " FROM " + RetSqlName('SE1') + " SE1 "
    cQuery += " JOIN " + RetSqlName("SA1") + " SA1 "
    cQuery += " ON " + FWJoinFilial("SA1", "SE1") 
    cQuery += "  AND SE1.E1_CLIENTE = SA1.A1_COD "
    cQuery += "  AND SE1.E1_LOJA = SA1.A1_LOJA "
    cQuery += "  AND SA1.D_E_L_E_T_ = ? "
    cQuery += " LEFT JOIN ( SELECT E5_NUMERO, E5_PREFIXO, E5_PARCELA, E5_TIPO, E5_CLIFOR, E5_LOJA, E5_DATA, MAX(E5_MOTBX) AS E5_MOTBX, MAX(E5_TIPODOC) AS E5_TIPODOC "
    cQuery += " FROM " + RetSqlName("SE5") + " SE5 
    cQuery += " WHERE E5_DTCANBX = ? "
    cQuery += "  AND E5_SITUACA <> ? "
    cQuery += "  AND D_E_L_E_T_ = ? "
    cQuery += " GROUP BY E5_NUMERO, E5_PREFIXO, E5_PARCELA, E5_TIPO, E5_CLIFOR, E5_LOJA, E5_DATA) "
    cQuery += " SE5 ON SE1.E1_NUM = SE5.E5_NUMERO "
    cQuery += " AND SE1.E1_PREFIXO = SE5.E5_PREFIXO "
    cQuery += " AND SE1.E1_PARCELA = SE5.E5_PARCELA "
    cQuery += " AND SE1.E1_TIPO = SE5.E5_TIPO "
    cQuery += " AND SE1.E1_CLIENTE = SE5.E5_CLIFOR "
    cQuery += " AND SE1.E1_LOJA = SE5.E5_LOJA "
    cQuery += " AND SE1.E1_BAIXA = SE5.E5_DATA "
    cQuery += " LEFT JOIN " + RetSqlName("FRV") + " FRV "
    cQuery += "  ON FRV.FRV_CODIGO = SE1.E1_SITUACA "
    cQuery += "  AND FRV.D_E_L_E_T_ = ? "

    cQuery += " WHERE "
    cQuery += "  SA1.A1_FILIAL = ? "
    cQuery += "  AND SE1.E1_CLIENTE BETWEEN ? AND ? "         
    cQuery += "  AND SE1.E1_LOJA BETWEEN ? AND ? " 

    If self:cSGBD == 'ORACLE'
        cQuery += "  AND SUBSTR(SE1.E1_VENCREA,1,4) = ? "
    Else       
        cQuery += "  AND SUBSTRING(SE1.E1_VENCREA,1,4) = ? "
    EndIf

    cQuery += "  AND SE1.E1_TIPOLIQ = ? " 
    cQuery += "  AND SE1.E1_TIPOFAT = ? " 
    cQuery += "  AND SE1.E1_TIPO NOT IN (?) " 
    cQuery += "  AND (SE5.E5_MOTBX IS NULL OR SE5.E5_MOTBX NOT IN (?)) "
    cQuery += "  AND (SE5.E5_TIPODOC IS NULL OR SE5.E5_TIPODOC NOT IN (?)) "

    If !self:lPartialSettlement
        cQuery += "AND NOT EXISTS ( "
        cQuery += " SELECT 1 "
        cQuery += " FROM " + RetSqlName("SE1") + " SE1B "
        cQuery += " WHERE SE1B.E1_CLIENTE = SE1.E1_CLIENTE "
        cQuery += "  AND SE1B.E1_LOJA = SE1.E1_LOJA "
        cQuery += "  AND SE1B.E1_SALDO > ? "

        If self:cSGBD == 'ORACLE'
            cQuery += "  AND SUBSTR(SE1B.E1_VENCREA,1,4) = ? "
        Else       
            cQuery += "  AND SUBSTRING(SE1B.E1_VENCREA,1,4) = ? "
        EndIf

        cQuery += "  AND SE1B.E1_TIPO NOT IN (?) "
        cQuery += "  AND " + FWJoinFilial("SA1", "SE1", "SA1", "SE1B")
        cQuery += "  AND SE1B.D_E_L_E_T_ = ? ) "
        cQuery += "  AND SE1.E1_SALDO = ? "
    Else 
        cQuery += "AND EXISTS ( "
        cQuery += "SELECT 1 "
        cQuery += "FROM " + RetSqlName("SE1") + " SE1X "
        cQuery += "INNER JOIN " + RetSqlName("FRV") + " FRVX ON FRVX.FRV_CODIGO = SE1X.E1_SITUACA AND FRVX.D_E_L_E_T_ = ? "
        cQuery += "WHERE SE1X.E1_CLIENTE = SE1.E1_CLIENTE "
        cQuery += " AND SE1X.E1_LOJA = SE1.E1_LOJA "
        cQuery += " AND SE1X.E1_SALDO > ? "
        cQuery += " AND FRVX.FRV_JURIDC = ? "
        cQuery += " AND " + FWJoinFilial("SA1", "SE1", "SA1", "SE1X") 

        If self:cSGBD == 'ORACLE'
            cQuery += " AND SUBSTR(SE1X.E1_VENCREA,1,4) = ? "
        Else       
            cQuery += " AND SUBSTRING(SE1X.E1_VENCREA,1,4) = ? "
        EndIf

        cQuery += " AND SE1X.D_E_L_E_T_ = ?) "
        cQuery += " AND NOT EXISTS ( "
        cQuery += " SELECT 1 "
        cQuery += " FROM SE1T10 SE1Z "
        cQuery += " LEFT JOIN FRVT10 FRVZ ON FRVZ.FRV_CODIGO = SE1Z.E1_SITUACA AND FRVZ.D_E_L_E_T_ = ? "
        cQuery += " WHERE SE1Z.E1_CLIENTE = SE1.E1_CLIENTE "
        cQuery += "  AND SE1Z.E1_LOJA = SE1.E1_LOJA "

        If self:cSGBD == 'ORACLE'
            cQuery += " AND SUBSTR(SE1Z.E1_VENCREA,1,4) = ? "
        Else       
            cQuery += " AND SUBSTRING(SE1Z.E1_VENCREA,1,4) = ? "
        EndIf

        cQuery += "  AND SE1Z.E1_SALDO > ? "
        cQuery += "  AND COALESCE(FRVZ.FRV_JURIDC, ?) = ? "
        cQuery += "  AND " + FWJoinFilial("SA1", "SE1", "SA1", "SE1Z") 
        cQuery += "  AND SE1Z.D_E_L_E_T_ = ?) "
        cQuery += " AND ((SE1.E1_SALDO > ? AND FRV.FRV_JURIDC = ?) " 
        cQuery += " OR (SE1.E1_SALDO = ? AND ISNULL(FRV.FRV_JURIDC, ?) <> ? )) "
    EndIf

    cQuery += "  AND SE1.D_E_L_E_T_ = ? " 

    If self:lConsolidatedBalance 
        cQuery += " GROUP BY A1_NOME,E1_CLIENTE,E1_LOJA "
        cQuery += " ORDER BY A1_NOME,E1_CLIENTE,E1_LOJA "
    Else 
        cQuery += " GROUP BY A1_NOME,E1_CLIENTE,E1_LOJA,SUBSTRING(SE1.E1_VENCREA,5,2) "
        cQuery += " ORDER BY A1_NOME,E1_CLIENTE,E1_LOJA, MES "
    EndIf

    cQuery := ChangeQuery(cQuery)

    self:oStatement := FWExecStatement():New(cQuery)

    self:handleStatement()

    If self:lFIN127QRY
        cQuery := self:applyCustomQuery()
        self:oStatement := FWExecStatement():New(cQuery)
    EndIf
return

//-------------------------------------------------------------------
/*{Protheus.doc} handleStatement
    @author matheus.monteiro@totvs.com.br
    @since 25/02/2026
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method handleStatement() class DebitSettlementSmartViewBusinessObject
    self:oStatement:SetString(self:nParamOrder++, ' ')
    self:oStatement:SetString(self:nParamOrder++, '1')
    self:oStatement:SetString(self:nParamOrder++, self:cBaseYear)
    self:oStatement:SetString(self:nParamOrder++, ' ')
    self:oStatement:SetString(self:nParamOrder++, ' ')
    self:oStatement:SetString(self:nParamOrder++, ' ')
    self:oStatement:SetString(self:nParamOrder++, 'C')
    self:oStatement:SetString(self:nParamOrder++, ' ')
    self:oStatement:SetString(self:nParamOrder++, ' ')
    self:oStatement:SetString(self:nParamOrder++, FWxFilial("SA1"))
    self:oStatement:SetString(self:nParamOrder++, self:cCustomerFrom)
    self:oStatement:SetString(self:nParamOrder++, self:cCustomerTo)
    self:oStatement:SetString(self:nParamOrder++, self:cBranchFrom)
    self:oStatement:SetString(self:nParamOrder++, self:cBranchTo)
    self:oStatement:SetString(self:nParamOrder++, self:cBaseYear)
    self:oStatement:SetString(self:nParamOrder++, ' ')
    self:oStatement:SetString(self:nParamOrder++, ' ')
    self:oStatement:SetIn(self:nParamOrder++, {'RA ', 'NCC', 'AB-','IR-', 'IN-','IS-','PI-','CF-','CS-','FU-','FE-','PR'})
    self:oStatement:SetIn(self:nParamOrder++, {'DSD','LIQ','FAT','REN'})
    self:oStatement:SetIn(self:nParamOrder++, { 'DC','JR' ,'MT','CM' ,'CX','DB' })

    If !self:lPartialSettlement
        self:oStatement:SetNumeric(self:nParamOrder++, 0)
        self:oStatement:SetString(self:nParamOrder++, self:cBaseYear)
        self:oStatement:SetIn(self:nParamOrder++, {'RA ', 'NCC', 'AB-','IR-', 'IN-','IS-','PI-','CF-','CS-','FU-','FE-','PR'})
        self:oStatement:SetString(self:nParamOrder++, ' ')
        self:oStatement:SetNumeric(self:nParamOrder++, 0)
    Else 
        self:oStatement:SetString(self:nParamOrder++, ' ')
        self:oStatement:SetNumeric(self:nParamOrder++, 0)
        self:oStatement:SetString(self:nParamOrder++, '1')
        self:oStatement:SetString(self:nParamOrder++, self:cBaseYear)
        self:oStatement:SetString(self:nParamOrder++, ' ')

        self:oStatement:SetString(self:nParamOrder++, ' ')
        self:oStatement:SetString(self:nParamOrder++, self:cBaseYear)
        self:oStatement:SetNumeric(self:nParamOrder++, 0)
        self:oStatement:SetString(self:nParamOrder++, ' ')
        self:oStatement:SetString(self:nParamOrder++, ' ')
        self:oStatement:SetString(self:nParamOrder++, ' ')
        self:oStatement:SetNumeric(self:nParamOrder++, 0)
        self:oStatement:SetString(self:nParamOrder++, '1')
        self:oStatement:SetNumeric(self:nParamOrder++, 0)
        self:oStatement:SetString(self:nParamOrder++, ' ')
        self:oStatement:SetString(self:nParamOrder++, '1')
    EndIf

    self:oStatement:SetString(self:nParamOrder++, ' ')
return

//-------------------------------------------------------------------
/*{Protheus.doc} getTiposMovimento
Retorna query customizada caso o PE lFIN127QRY esteja ativo.

@return array: cQuery
@author matheus.monteiro@totvs.com.br
@since 25/02/2026
@version 1.0
*/
//-------------------------------------------------------------------
method applyCustomQuery() as character class DebitSettlementSmartViewBusinessObject
    Local cQuery := self:oStatement:GetFixQuery() as character
    
    cQuery := ExecBlock("FIN127QRY", .F.,.F., {cQuery,MV_PAR01,MV_PAR02,MV_PAR03,MV_PAR04,MV_PAR05,MV_PAR06,MV_PAR07})
return cQuery

//-------------------------------------------------------------------
/*{Protheus.doc} getTiposMovimento
Permite alterar o texto principal do objeto de negócio.

@return array: cBills
@author matheus.monteiro@totvs.com.br
@since 25/02/2026
@version 1.0
*/ 
//-------------------------------------------------------------------
method applyCustomTitle(cNewTitle as character) as character class DebitSettlementSmartViewBusinessObject
     cNewTitle := ExecBlock("FIN127TIT", .F.,.F., {cNewTitle})
return cNewTitle

//-------------------------------------------------------------------
/*{Protheus.doc} getTiposMovimento
Permite alterar o texto principal do objeto de negócio.

@return array: cBills
@author matheus.monteiro@totvs.com.br
@since 25/02/2026
@version 1.0
*/
//-------------------------------------------------------------------
method applyCustomText(cNewTextDeclaration as character, cCustomerName as character, cYear as character) as character class DebitSettlementSmartViewBusinessObject
    cNewTextDeclaration := ExecBlock("FIN127TXT", .F.,.F., {cNewTextDeclaration,cCustomerName,cYear})
return cNewTextDeclaration


//-------------------------------------------------------------------
/*/{Protheus.doc} FinIntegratedProvider
    @author matheus.monteiro@totvs.com.br
    @since 06/03/2026
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method getCurrencySymbol() as character class DebitSettlementSmartViewBusinessObject
    local cCurrencySymbol := ""

    cCurrencySymbol := SuperGetMv("MV_SIMB" + CValToChar(self:nPettyCashCurrency), .F., "")
return cCurrencySymbol


