    Aadd(aCampos,{"IRRF",.T.})
    Aadd(aEstrutura,{"IRRF_ALIQ"    , "IRRF_ALIQUOTA"                       , "N", FWSX3Util():GetFieldStruct("FT_ALIQIRR")[3], FWSX3Util():GetFieldStruct("FT_ALIQIRR")[4],""})
    Aadd(aEstrutura,{"IRRF_LF_VB"   , "IRRF_LF_VLR_BASE"                    , "C", 10, 0 ,""})
    Aadd(aEstrutura,{"IRRF_LF_V"    , "IRRF_LF_VALOR"                       , "C", 10, 0 ,""})
Return

/*/{Protheus.doc} AdicionaINSS
    Adiciona campos relacionados ao INSS nos arrays de estrutura e campos, incluindo alíquota, base de cálculo e valor retido da contribuição previdenciária.
    
    @type  Static Function
    @author Squad Fiscal - TOTVS
    @since 01/11/2025
    @version 12.1.2510
    @param aCampos, array, Array passado por referência que receberá o indicador do imposto INSS
    @param aEstrutura, array, Array passado por referência que receberá estrutura de 3 campos do INSS
    @return nil, Não retorna valor, apenas popula arrays por referência
    @obs Campos adicionados: INSS_ALIQ (usa FT_ALIQINS do SX3), INSS_LF_VB, INSS_LF_V. INSS é contribuição previdenciária retida
/*/
Static Function AdicionaINSS(aCampos, aEstrutura)
    Aadd(aCampos,{"INSS",.T.})
    Aadd(aEstrutura,{"INSS_ALIQ"    , "INSS_ALIQUOTA"                       , "N", FWSX3Util():GetFieldStruct("FT_ALIQINS")[3], FWSX3Util():GetFieldStruct("FT_ALIQINS")[4],""})
    Aadd(aEstrutura,{"INSS_LF_VB"   , "INSS_LF_VLR_BASE"                    , "C", 10, 0 ,""})
    Aadd(aEstrutura,{"INSS_LF_V"    , "INSS_LF_VALOR"                       , "C", 10, 0 ,""})
Return

//-------------------------------------------------------------------
/*/{Protheus.doc} MontaAgrup
    Processa opções de ordenação/agrupamento marcadas e monta cláusulas SQL SELECT, GROUP BY, ORDER BY e JOIN necessárias para agrupamento por NCM ou Perfil de Operação na query.
    
    @type  Static Function
    @author Squad Fiscal - TOTVS
    @since 01/11/2025
    @version 12.1.2510
    @param oObjtForm, object, Objeto FwFormBrowse contendo as opções de ordenação marcadas
    @param cSelect, character, String SQL SELECT passada por referência que receberá campos de agrupamento
    @param cGroup, character, String SQL GROUP BY passada por referência que receberá campos de agrupamento
    @param cOrder, character, String SQL ORDER BY passada por referência que receberá campos de ordenação
    @param cJoin, character, String SQL JOIN passada por referência que receberá joins necessários (ex: F20/F23 para Perfil Operação)
    @return character, cRet, Código da opção de ordenação selecionada ("NCM" ou "PERFIL_OPER")
    @obs Para NCM: adiciona FT_POSIPI. Para PERFIL_OPER: adiciona F23_CODIGO, F20_DESC e LEFT JOIN com F20/F23
/*/
//-------------------------------------------------------------------
Static Function MontaAgrup(oObjtForm, cSelect, cGroup, cOrder, cJoin)

    Local aAcols := {} as array
    Local nX := 0 as numeric
    Local nLen := 0 as numeric
    Local cRet := "" as character
    Local lPass := .F. as logical

    aAcols:= oObjtForm:oData:aArray
    if len(aAcols)>0
        nLen := len(aAcols[1])
        for nX:=1 to len(aAcols)
            if aAcols[nX][nLen] == "1" //Verifico se o campo está marcado
                cRet := alltrim(aAcols[nX][2])
                if cRet == "NCM"
                    cSelect +=" FT_POSIPI, "
                    cGroup  +=" FT_POSIPI, "
                    cOrder  +=" FT_POSIPI "
                    cJoin   += " " 

                    lPass := .T.

                elseif cRet ==  "PERFIL_OPER"
                    If lPass
                        cSelect += ","
                    Endif
                    cSelect +=" F23_CODIGO AS COD_OPER, "
		            cSelect +=" F20_DESC, "
                    cGroup  +=" F23_CODIGO, "
                    cGroup  +=" F20_DESC, "
                    cOrder  +=" F23_CODIGO "

                    cJoin +="    LEFT JOIN (
                    cJoin +="    SELECT 
                    cJoin +="        F23_CODIGO,F23_CFOP,F20_DESC  
                    cJoin +="    FROM 
                    cJoin +="        F20T10 F20
                    cJoin +="    JOIN 
                    cJoin +="        F23T10 F23 	ON F20_CODIGO=F23_CODIGO AND F20_TIPO=F23_TIPOPF AND F23_FILIAL='"+xFilial("F23")+"' AND F23.D_E_L_E_T_=' '
                    cJoin +="    WHERE 
                    cJoin +="        F20_FILIAL='"+xFilial("F23")+"' AND F20_DESC NOT LIKE 'TOD%' AND F20.D_E_L_E_T_=' '
                    cJoin +="    ) AS F20F23 ON F23_CFOP = FT_CFOP
                endif

            endif
        next
        
        FwFreeArray(aAcols)
    endif


Return(cRet)

//-------------------------------------------------------------------
/*/{Protheus.doc} MontaWhere
    Monta cláusula WHERE da query SQL com filtros específicos conforme impostos selecionados, aplicando regras de negócio para SPED Fiscal (ICMS/IPI), EFD Contribuições (PIS/COFINS/CSLL) e ISS.
    
    @type  Static Function
    @author Squad Fiscal - TOTVS
    @since 01/11/2025
    @version 12.1.2510
    @param oObjtForm, object, Objeto FwFormBrowse contendo os impostos marcados
    @param cWhere, character, String SQL WHERE passada por referência que receberá os filtros
    @return nil, Não retorna valor, apenas popula cWhere por referência
    @obs Aplica filtros específicos: ICMS/IPI (exclui CF sem IPI, BPR com PDV), PIS/COFINS (regras EFD Contribuições), ISS (apenas serviços FT_TIPO='S')
/*/
//-------------------------------------------------------------------
Static Function MontaWhere(oObjtForm, cWhere)
    Local nX := 0 as numeric
    Local aAcols := aClone(oObjtForm:oData:aArray) as array
    Local lSped := .F. as logical
    Local lEFD := .F. as logical
    Local lISS := .F. as logical

        if len(aAcols)>0
            nLen := len(aAcols[1])
            for nX:=1 to len(aAcols)
                if aAcols[nX][nLen] == "1" //Verifico se o campo está marcado

                    if !lSped .and. alltrim(aAcols[nX][2]) $ ("ICMS/IPI")
                        cWhere += " AND (SFT.FT_ESPECIE <> 'CF' OR (SFT.FT_ESPECIE = 'CF' AND SFT.FT_VALIPI > 0)) "
	                    cWhere += " AND (SFT.FT_ESPECIE <> 'BPR' OR (SFT.FT_ESPECIE = 'BPR' AND SFT.FT_PDV = ' ')) "
                        lSped:= .T.
                    elseif !lEFD .and. alltrim(aAcols[nX][2]) $ "PIS_APUR/COFINS_APUR/CSLL_APUR"
                        cWhere += " AND (FT_TIPOMOV = 'S' AND "
                        cWhere += " (( (SFT.FT_BASEPIS > 0  OR  SFT.FT_BASEPS3 > 0 ) OR SFT.FT_CSTPIS IN ('01','05','07','08','09','49')) OR "
                        cWhere += "     ( (SFT.FT_BASECOF > 0  OR  SFT.FT_BASECF3 > 0 ) OR SFT.FT_CSTCOF IN ('01','05','07','08','09','49')))  AND "
                        cWhere += "     ((SFT.FT_ESPECIE <> 'BPR') OR (SFT.FT_ESPECIE = 'BPR' AND SFT.FT_PDV = ' ')) "
                        cWhere += " ) OR "
                        cWhere += " (FT_TIPOMOV = 'E' AND "
                        cWhere += "     ( "
                        cWhere += "     (F4.F4_ATUATF <> 'S' AND (((SFT.FT_BASEPIS > 0  OR  SFT.FT_BASEPS3 > 0) OR SFT.FT_CSTPIS IN ('70','71','72','73','74','98','99'))  OR "
                        cWhere += "     ((SFT.FT_BASECOF > 0  OR  SFT.FT_BASECF3 > 0) OR SFT.FT_CSTCOF IN ('70','71','72','73','74','98','99')))) OR "
                        cWhere += "     (F4.F4_ATUATF   = 'S' AND ((SFT.FT_CSTCOF IN ('70','71','72','73','74','98','99')) OR "
                        cWhere += "     (SFT.FT_CSTPIS IN ('70','71','72','73','74','98','99')))) "
                        cWhere += " ) "
                        cWhere += " ) "
                        lEFD:= .T.                                    
                    elseif !lISS .and. alltrim(aAcols[nX][2]) == "ISS"
                        cWhere += " AND FT_TIPO='S' "
                        lISS:= .T.
                    endif

                endif
            next
            
            FwFreeArray(aAcols)
        endif

Return

//-------------------------------------------------------------------
/*/{Protheus.doc} QueryMov
    Monta query SQL completa para consulta de movimentações fiscais, incluindo campos selecionados, impostos, joins, filtros WHERE, agrupamentos GROUP BY e ordenação, consultando tabelas SFT, SF4, SB1, SA1, SA2, SF7.
    
    @type  Static Function
    @author Squad Fiscal - TOTVS
    @since 01/11/2025
    @version 12.1.2510
    @param aCampos, array, Array com campos selecionados que farão parte da query
    @param aEstrutura, array, Array com estrutura dos campos (nome, tipo, tamanho)
    @param cSelect, character, Cláusula SELECT adicional com campos de agrupamento
    @param cGroup, character, Cláusula GROUP BY adicional com campos de agrupamento
    @param cOrder, character, Cláusula ORDER BY para ordenação dos resultados
    @param cJoin, character, Cláusulas JOIN adicionais (ex: F20/F23 para perfil de operação)
    @param cWhere, character, Cláusula WHERE com filtros específicos por imposto
    @return character, cQry, String SQL completa montada com BEGINCONTENT/ENDCONTENT
    @obs Utiliza BEGINCONTENT para montar SQL complexa com múltiplos joins e campos dinâmicos conforme impostos selecionados
/*/
//-------------------------------------------------------------------
Static Function QueryMov(aCampos, aEstrutura , cSelect, cGroup, cOrder, cJoin , cWhere)
	local cQry := "" as character
    local cCamposAdc := "" as character
    Local cCampoGroup := "" as character
    Local nX := 0 as numeric
    Local cTabSFT := RetSqlName("SFT") as character
    Local cTabSF4 := RetSqlName("SF4") as character
    Local cTabSB1 := RetSqlName("SB1") as character
    Local cTabSA1 := RetSqlName("SA1") as character
    Local cTabSA2 := RetSqlName("SA2") as character
    Local cTabSF7 := RetSqlName("SF7") as character
    Local cFilSFT := "'"+xFilial("SFT")+"'" as character
    Local cFilSF4 := "'"+xFilial("SF4")+"'" as character
    Local cFilSB1 := "'"+xFilial("SB1")+"'" as character
    Local cFilSA1 := "'"+xFilial("SA1")+"'" as character
    Local cFilSA2 := "'"+xFilial("SA2")+"'" as character
    Local cFilSF7 := "'"+xFilial("SF7")+"'" as character
    Local cDataDe := "'"+DtoS(dDataDeSFT)+"'" as character
    Local cDataAte := "'"+DtoS(dDataAteSFT)+"'" as character
    Local cIniSelect := cSelect as character
    Local cIniGroup := cGroup as character
    Local cIniOrder := iif(empty(cOrder)," 1 ",cOrder) as character
    

    for nX:=1 to len(aCampos)
        if aCampos[nX][1] == "ICMS"
            cCamposAdc += ", " + "SUBSTRING( FT_CLASFIS, 2, 2 ) AS ICMS_CST"
            cCamposAdc += ", " + "FT_ALIQICM AS ICMS_ALIQ"
            cCamposAdc += ", " + "(CASE WHEN FT_BASEICM>0 THEN 'Tem valor' ELSE 'Zerado' END ) AS ICMS_LF_VB"
            cCamposAdc += ", " + "(CASE WHEN F4_BASEICM>0 THEN 'Tem valor' ELSE 'Zerado' END ) AS ICMS_TES_P"
            cCamposAdc += ", " + "(CASE WHEN FT_VALICM >0 THEN 'Tem valor' ELSE 'Zerado' END ) AS ICMS_LF_V"
            cCamposAdc += ", " + "(CASE WHEN FT_ISENICM>0 THEN 'Tem valor' ELSE 'Zerado' END ) AS ICMS_LF_VI"
            cCamposAdc += ", " + "(CASE WHEN FT_OUTRICM>0 THEN 'Tem valor' ELSE 'Zerado' END ) AS ICMS_LF_VO"
            cCamposAdc += ", " + "(CASE WHEN FT_ICMSCOM>0 THEN 'Tem valor' ELSE 'Zerado' END ) AS ICMS_LF_CO"
            cCamposAdc += ", " + "(CASE WHEN FT_ICMSDIF>0 THEN 'Tem valor' ELSE 'Zerado' END ) AS ICMS_LF_DI"

            cCampoGroup += ", " + "SUBSTRING( FT_CLASFIS, 2, 2 )"
            cCampoGroup += ", " + "FT_ALIQICM"
            cCampoGroup += ", " + "(CASE WHEN FT_BASEICM>0 THEN 'Tem valor' ELSE 'Zerado' END )"
            cCampoGroup += ", " + "(CASE WHEN F4_BASEICM>0 THEN 'Tem valor' ELSE 'Zerado' END )"
            cCampoGroup += ", " + "(CASE WHEN FT_VALICM >0 THEN 'Tem valor' ELSE 'Zerado' END )"
            cCampoGroup += ", " + "(CASE WHEN FT_ISENICM>0 THEN 'Tem valor' ELSE 'Zerado' END )"
            cCampoGroup += ", " + "(CASE WHEN FT_OUTRICM>0 THEN 'Tem valor' ELSE 'Zerado' END )"
            cCampoGroup += ", " + "(CASE WHEN FT_ICMSCOM>0 THEN 'Tem valor' ELSE 'Zerado' END )"
            cCampoGroup += ", " + "(CASE WHEN FT_ICMSDIF>0 THEN 'Tem valor' ELSE 'Zerado' END )"
        elseif aCampos[nX][1] == "IPI"
            cCamposAdc += ", " + "FT_CTIPI AS IPI_CST"
            cCamposAdc += ", " + "FT_ALIQIPI AS IPI_ALIQ"
            cCamposAdc += ", " + "(CASE WHEN FT_BASEIPI>0 THEN 'Tem valor' ELSE 'Zerado' END ) AS IPI_LF_VB"
            cCamposAdc += ", " + "(CASE WHEN FT_VALIPI >0 THEN 'Tem valor' ELSE 'Zerado' END ) AS IPI_LF_V"
            cCamposAdc += ", " + "(CASE WHEN FT_ISENIPI>0 THEN 'Tem valor' ELSE 'Zerado' END ) AS IPI_LF_VI"
            cCamposAdc += ", " + "(CASE WHEN FT_OUTRIPI>0 THEN 'Tem valor' ELSE 'Zerado' END ) AS IPI_LF_VO"

            cCampoGroup += ", " + "FT_CTIPI"
            cCampoGroup += ", " + "FT_ALIQIPI"
            cCampoGroup += ", " + "(CASE WHEN FT_BASEIPI>0 THEN 'Tem valor' ELSE 'Zerado' END )"
            cCampoGroup += ", " + "(CASE WHEN FT_VALIPI >0 THEN 'Tem valor' ELSE 'Zerado' END )"
            cCampoGroup += ", " + "(CASE WHEN FT_ISENIPI>0 THEN 'Tem valor' ELSE 'Zerado' END )"
            cCampoGroup += ", " + "(CASE WHEN FT_OUTRIPI>0 THEN 'Tem valor' ELSE 'Zerado' END )"

        elseif aCampos[nX][1] == "PIS_APUR"
            cCamposAdc += ", " + "FT_CSTPIS AS PIS_CST"
		    cCamposAdc += ", " + "FT_ALIQPIS AS PIS_AP_ALI"
		    cCamposAdc += ", " + "(CASE WHEN FT_BASEPIS>0 THEN 'Tem valor' ELSE 'Zerado' END ) AS PIS_AP_VB"
		    cCamposAdc += ", " + "(CASE WHEN FT_VALPIS >0 THEN 'Tem valor' ELSE 'Zerado' END ) AS PIS_AP_V"

            cCampoGroup += ", " + "FT_CSTPIS"
		    cCampoGroup += ", " + "FT_ALIQPIS"
		    cCampoGroup += ", " + "(CASE WHEN FT_BASEPIS>0 THEN 'Tem valor' ELSE 'Zerado' END )"
		    cCampoGroup += ", " + "(CASE WHEN FT_VALPIS >0 THEN 'Tem valor' ELSE 'Zerado' END )"
        elseif aCampos[nX][1] == "COFINS_APUR"
            cCamposAdc += ", " + "FT_CSTCOF AS COF_CST"
		    cCamposAdc += ", " + "FT_ALIQCOF AS COF_AP_ALI"
		    cCamposAdc += ", " + "(CASE WHEN FT_BASECOF>0 THEN 'Tem valor' ELSE 'Zerado' END ) AS COF_AP_VB"
		    cCamposAdc += ", " + "(CASE WHEN FT_VALCOF >0 THEN 'Tem valor' ELSE 'Zerado' END ) AS COF_AP_V"

            cCampoGroup += ", " + "FT_CSTCOF"
		    cCampoGroup += ", " + "FT_ALIQCOF"
		    cCampoGroup += ", " + "(CASE WHEN FT_BASECOF>0 THEN 'Tem valor' ELSE 'Zerado' END )"
		    cCampoGroup += ", " + "(CASE WHEN FT_VALCOF >0 THEN 'Tem valor' ELSE 'Zerado' END )"
        elseif aCampos[nX][1] == "CSLL_APUR"
		    cCamposAdc += ", " + "FT_ALIQCSL AS CSL_AP_ALI"
		    cCamposAdc += ", " + "(CASE WHEN FT_BASECSL>0 THEN 'Tem valor' ELSE 'Zerado' END ) AS CSL_AP_VB"
		    cCamposAdc += ", " + "(CASE WHEN FT_VALCSL >0 THEN 'Tem valor' ELSE 'Zerado' END ) AS CSL_AP_V"

		    cCampoGroup += ", " + "FT_ALIQCSL"
		    cCampoGroup += ", " + "(CASE WHEN FT_BASECSL>0 THEN 'Tem valor' ELSE 'Zerado' END )"
		    cCampoGroup += ", " + "(CASE WHEN FT_VALCSL >0 THEN 'Tem valor' ELSE 'Zerado' END )"
        elseif aCampos[nX][1] == "PIS_RETE"
            cCamposAdc += ", " + "FT_CSTPIS AS PIS_CST"
		    cCamposAdc += ", " + "FT_ARETPIS AS PIS_RT_ALI"
		    cCamposAdc += ", " + "(CASE WHEN FT_BRETPIS>0 THEN 'Tem valor' ELSE 'Zerado' END ) AS PIS_RT_VB"
		    cCamposAdc += ", " + "(CASE WHEN FT_VRETPIS>0 THEN 'Tem valor' ELSE 'Zerado' END ) AS PIS_RT_V"

            cCampoGroup += ", " + "FT_CSTPIS"
		    cCampoGroup += ", " + "FT_ARETPIS"
		    cCampoGroup += ", " + "(CASE WHEN FT_BRETPIS>0 THEN 'Tem valor' ELSE 'Zerado' END )"
		    cCampoGroup += ", " + "(CASE WHEN FT_VRETPIS>0 THEN 'Tem valor' ELSE 'Zerado' END )"
        elseif aCampos[nX][1] == "COFINS_RETE"
            cCamposAdc += ", " + "FT_CSTCOF AS COF_CST"
		    cCamposAdc += ", " + "FT_ARETCOF AS COF_RT_ALI"
		    cCamposAdc += ", " + "(CASE WHEN FT_BRETCOF>0 THEN 'Tem valor' ELSE 'Zerado' END ) AS COF_RT_VB"
		    cCamposAdc += ", " + "(CASE WHEN FT_VRETCOF>0 THEN 'Tem valor' ELSE 'Zerado' END ) AS COF_RT_V"

            cCampoGroup += ", " + "FT_CSTCOF"
		    cCampoGroup += ", " + "FT_ARETCOF"
		    cCampoGroup += ", " + "(CASE WHEN FT_BRETCOF>0 THEN 'Tem valor' ELSE 'Zerado' END )"
		    cCampoGroup += ", " + "(CASE WHEN FT_VRETCOF >0 THEN 'Tem valor' ELSE 'Zerado' END )"
        elseif aCampos[nX][1] == "CSLL_RETE"
		    cCamposAdc += ", " + "FT_ARETCSL AS CSL_RT_ALI"
		    cCamposAdc += ", " + "(CASE WHEN FT_BRETCSL>0 THEN 'Tem valor' ELSE 'Zerado' END ) AS CSL_RT_VB"
		    cCamposAdc += ", " + "(CASE WHEN FT_VRETCSL>0 THEN 'Tem valor' ELSE 'Zerado' END ) AS CSL_RT_V"

		    cCampoGroup += ", " + "FT_ARETCSL"
		    cCampoGroup += ", " + "(CASE WHEN FT_BRETCSL>0 THEN 'Tem valor' ELSE 'Zerado' END )"
		    cCampoGroup += ", " + "(CASE WHEN FT_VRETCSL>0 THEN 'Tem valor' ELSE 'Zerado' END )"
        elseif aCampos[nX][1] == "ISS"
		    cCamposAdc += ", " + "FT_CODISS"
            cCamposAdc += ", " + "FT_RECISS"
            cCamposAdc += ", " + "FT_CNAE"
            cCamposAdc += ", " + "FT_TRIBMUN AS COD_T_MUNI"
            cCamposAdc += ", " + "FT_CSTISS AS ISS_CST"
            cCamposAdc += ", " + "FT_ALIQICM AS ISS_ALIQ"
		    cCamposAdc += ", " + "(CASE WHEN FT_BASEICM>0 THEN 'Tem valor' ELSE 'Zerado' END ) AS ISS_LF_VB"
		    cCamposAdc += ", " + "(CASE WHEN FT_VALICM>0 THEN 'Tem valor' ELSE 'Zerado' END ) AS ISS_LF_V"

		    cCampoGroup += ", " + "FT_CODISS"
            cCampoGroup += ", " + "FT_RECISS"
            cCampoGroup += ", " + "FT_CNAE"
            cCampoGroup += ", " + "FT_TRIBMUN"
            cCampoGroup += ", " + "FT_CSTISS"
            cCampoGroup += ", " + "FT_ALIQICM"
		    cCampoGroup += ", " + "(CASE WHEN FT_BASEICM>0 THEN 'Tem valor' ELSE 'Zerado' END )"
		    cCampoGroup += ", " + "(CASE WHEN FT_VALICM>0 THEN 'Tem valor' ELSE 'Zerado' END )"
        elseif aCampos[nX][1] == "IRRF"
            cCamposAdc += ", " + "FT_ALIQIRR AS IRRF_ALIQ"
		    cCamposAdc += ", " + "(CASE WHEN FT_BASEIRR>0 THEN 'Tem valor' ELSE 'Zerado' END ) AS IRRF_LF_VB"
		    cCamposAdc += ", " + "(CASE WHEN FT_VALIRR>0 THEN 'Tem valor' ELSE 'Zerado' END ) AS IRRF_LF_V"

            cCampoGroup += ", " + "FT_ALIQIRR"
		    cCampoGroup += ", " + "(CASE WHEN FT_BASEIRR>0 THEN 'Tem valor' ELSE 'Zerado' END )"
		    cCampoGroup += ", " + "(CASE WHEN FT_VALIRR >0 THEN 'Tem valor' ELSE 'Zerado' END )"
        elseif aCampos[nX][1] == "INSS"
            cCamposAdc += ", " + "FT_ALIQINS AS INSS_ALIQ"
		    cCamposAdc += ", " + "(CASE WHEN FT_BASEINS>0 THEN 'Tem valor' ELSE 'Zerado' END ) AS INSS_LF_VB"
		    cCamposAdc += ", " + "(CASE WHEN FT_VALINS>0 THEN 'Tem valor' ELSE 'Zerado' END ) AS INSS_LF_V"

            cCampoGroup += ", " + "FT_ALIQINS"
		    cCampoGroup += ", " + "(CASE WHEN FT_BASEINS>0 THEN 'Tem valor' ELSE 'Zerado' END )"
		    cCampoGroup += ", " + "(CASE WHEN FT_VALINS >0 THEN 'Tem valor' ELSE 'Zerado' END )"
        else
            if aCampos[nX][2]//empty(aEstrutura[nX][6]) //para não adicionar de novo os campos fixos
                cCamposAdc += ", " + aCampos[nX][1]
                cCampoGroup += ", " + aCampos[nX][1]
            endif
        endif
    next

    cCamposAdc += ", " + "COUNT(*) AS QTD_REPETI"

	BEGINCONTENT var cQry
            SELECT  %Exp:cIniSelect%
                FT_ESTADO,
                FT_TIPO,
                FT_TIPOMOV,
                FT_CFOP,
                FT_CFPS,
                FT_CLIEFOR,
                FT_LOJA,
                FT_CLIENT,
                SUBSTRING( FT_CLASFIS, 1, 1 )AS ORIGEM,
                (CASE WHEN FT_VALCONT>0 THEN 'Tem valor' ELSE 'Zerado' END ) AS FT_VALCONT,
                FT_ESPECIE,
                FT_PRODUTO,
                FT_TES
                /*ICMS*/
                %Exp:cCamposAdc%
            FROM 
                %Exp:cTabSFT% SFT
            %Exp:cJoin%
            INNER JOIN 
                %Exp:cTabSF4% F4 ON F4.F4_FILIAL=%Exp:cFilSF4% AND F4.F4_CODIGO=SFT.FT_TES AND F4.D_E_L_E_T_=' '
            INNER JOIN 
                %Exp:cTabSB1% B1 ON B1.B1_FILIAL=%Exp:cFilSB1% AND B1.B1_COD = FT_PRODUTO AND B1.D_E_L_E_T_=' '
            LEFT JOIN 
                %Exp:cTabSA1% SA1
                    ON SA1.A1_FILIAL=%Exp:cFilSA1% AND SA1.A1_COD = FT_CLIEFOR
                    AND SA1.A1_LOJA = FT_LOJA
                    AND SA1.D_E_L_E_T_ = ' '
                    AND (FT_TIPOMOV = 'S' OR (FT_TIPOMOV = 'E' AND FT_TIPO IN ('DB')))
            LEFT JOIN 
                %Exp:cTabSA2% SA2
                    ON SA2.A2_FILIAL=%Exp:cFilSA2% AND SA2.A2_COD = FT_CLIEFOR
                    AND SA2.A2_LOJA = FT_LOJA
                    AND SA2.D_E_L_E_T_ = ' '
                    AND (FT_TIPOMOV = 'E' OR (FT_TIPOMOV = 'S' AND FT_TIPO IN ('DB')))
            LEFT JOIN 
                %Exp:cTabSF7% F7 
                    ON F7.F7_FILIAL = %Exp:cFilSF7% AND F7.F7_GRTRIB = B1.B1_GRTRIB AND F7.F7_EST = SFT.FT_ESTADO
                    AND F7_GRPCLI = (CASE WHEN F7_GRPCLI <> '' THEN 
                                    (CASE WHEN (FT_TIPOMOV = 'S' OR (FT_TIPOMOV = 'E' AND FT_TIPO IN ('DB'))) THEN SA1.A1_GRPTRIB ELSE SA2.A2_GRPTRIB END) 
                                    ELSE '' END)
                    AND F7.D_E_L_E_T_ = ' '
            WHERE 
                SFT.FT_FILIAL=%Exp:cFilSFT%
                AND SFT.FT_ENTRADA BETWEEN %Exp:cDataDe% AND %Exp:cDataAte%
                %Exp:cWhere%
                AND SFT.D_E_L_E_T_ = ' '
            GROUP BY
                %Exp:cIniGroup%
                FT_ESTADO,
                FT_TIPO,
                FT_TIPOMOV,
                FT_CFOP,
                FT_CFPS,
                FT_CLIEFOR,
                FT_LOJA,
                FT_CLIENT,
                SUBSTRING(FT_CLASFIS, 1, 1),
                /* FT_VALCONT*/
                (CASE WHEN FT_VALCONT>0 THEN 'Tem valor' ELSE 'Zerado' END ),
                FT_ESPECIE,
                FT_PRODUTO,
                FT_TES
                /*ICMS_CST*/
                %Exp:cCampoGroup%
                
            ORDER BY %Exp:cIniOrder%

	ENDCONTENT

return cQry

//-------------------------------------------------------------------
/*/{Protheus.doc} GeraExcel
    Executa a query SQL de movimentações fiscais através do changeQuery() e chama MontaExcel() para gerar planilha Excel com os resultados da consulta.
    
    @type  Static Function
    @author Squad Fiscal - TOTVS
    @since 01/11/2025
    @version 12.1.2510
    @param aCampos, array, Array com campos selecionados (não utilizado diretamente, passado para QueryMov)
    @param aEstrutura, array, Array com estrutura dos campos para montagem das colunas do Excel
    @param oSay, object, Objeto TSay para exibição de mensagens de progresso
    @param cSelect, character, Cláusula SELECT adicional
    @param cGroup, character, Cláusula GROUP BY adicional
    @param cOrder, character, Cláusula ORDER BY
    @param cJoin, character, Cláusulas JOIN adicionais
    @param cWhere, character, Cláusula WHERE com filtros
    @return nil, Não retorna valor, apenas gera arquivo Excel
    @obs Utiliza changeQuery() para compatibilidade com diferentes bancos de dados antes de executar
/*/
//-------------------------------------------------------------------
Static Function GeraExcel(aCampos, aEstrutura, oSay, cSelect, cGroup, cOrder , cJoin, cWhere)
    Local cTituloAux := "Operações Fiscais" as character
    Local cQuery := changeQuery(QueryMov(aCampos, aEstrutura, cSelect, cGroup, cOrder, cJoin, cWhere)) as character
    Default cQryAux := ""

    AtualizaMsg( oSay, "Processamento dados da query!")
    MontaExcel(cQuery, cTituloAux, aEstrutura, oSay)

Return

//-------------------------------------------------------------------
/*/{Protheus.doc} MontaExcel
    Executa query SQL via FwExecStatement, processa os dados retornados e gera planilha Excel (XML) utilizando FWMSExcel com todas as colunas e registros, abrindo automaticamente o arquivo se MS Excel estiver instalado.
    
    @type  Static Function
    @author Squad Fiscal - TOTVS
    @since 01/11/2025
    @version 12.1.2510
    @param cQuery, character, String SQL completa a ser executada
    @param cTituloAux, character, Título da planilha Excel ("Operações Fiscais")
    @param aEstruturaColunas, array, Array com estrutura dos campos [1]Campo, [2]Título, [3]Tipo, [4]Tamanho, [5]Decimal
    @param oSay, object, Objeto TSay para exibição de mensagens de progresso durante processamento
    @return nil, Não retorna valor, apenas gera arquivo Excel no diretório temporário
    @obs Utiliza FwExecStatement para execução, FWMSExcel para geração XML, TCSetField para campos Date, ApOleClient para detectar Excel instalado
/*/
//-------------------------------------------------------------------
Static Function MontaExcel(cQuery, cTituloAux, aEstruturaColunas, oSay)
    Local aArea := GetArea() as array
    Local nAux := 0 as numeric
    Local oFWMsExcel as object
    Local oExcel as object
    Local cDiretorio := GetTempPath() as character
    Local cArquivo := 'Rel_operacoes_fiscais'+alltrim(CriaTrab(NIL, .F.))+'.xml' as character
    Local cArqFull := cDiretorio + cArquivo as character
    Local cWorkSheet := "Aba - Principal" as character
    Local cTable := "" as character
    Local aColunas := {} as array
    Local aLinhaAux := {} as array
    Local cTitulo := "" as character
    Local nTotal := 0 as numeric
    Local nAtual := 0 as numeric
    Local oQryImp := NIL as object
    Local cAliasQry := "" as character
    Default cQuery := ""
    Default cTituloAux := "Título"
     
    cTable := cTituloAux
     
    //Se tiver a consulta
    If !Empty(cQuery)
        oQryImp := FwExecStatement():New(cQuery)
        cAliasQry := oQryImp:OpenAlias()
        
        if !empty(cAliasQry)
            
            nTotal := (cAliasQry)->(LastRec())

            For nAux := 1 To Len(aEstruturaColunas)
                cTitulo := ""
                
                if aEstruturaColunas[nAux][3] == "D"
                    TCSetField(cAliasQry, aEstruturaColunas[nAux][3], "D")
                endif
                cTitulo := Alltrim(aEstruturaColunas[nAux][2])

                //Adicionando nas colunas
                aAdd(aColunas, cTitulo)
            Next
            
            //Criando o objeto que irá gerar o conteúdo do Excel
            oFWMsExcel := FWMSExcel():New()
            oFWMsExcel:AddworkSheet(cWorkSheet)
            oFWMsExcel:AddTable(cWorkSheet, cTable)
                
            //Adicionando as Colunas
            For nAux := 1 To Len(aColunas)
                oFWMsExcel:AddColumn(cWorkSheet, cTable, aColunas[nAux], 1, 1)
            Next
                
            //Definindo o total da barra
            DbSelectArea(cAliasQry)
            nAtual := 0

            While !(cAliasQry)->(EoF())
                nAtual++
                AtualizaMsg( oSay, "Processando registro "+cValToChar(nAtual)+" de "+cValToChar(nTotal)+"...")
                //Criando a linha
                aLinhaAux := Array(Len(aColunas))
                For nAux := 1 To Len(aEstruturaColunas)
                    aLinhaAux[nAux] := &("(cAliasQry)->"+aEstruturaColunas[nAux][1])
                Next
                    
                //Adiciona a linha no Excel
                oFWMsExcel:AddRow(cWorkSheet, cTable, aLinhaAux)
                    
                (cAliasQry)->(DbSkip())
            EndDo
                
            //Ativando o arquivo e gerando o xml
            oFWMsExcel:Activate()
            oFWMsExcel:GetXMLFile(cArqFull)
            
            //Se tiver o excel instalado
            If ApOleClient("msexcel")
                oExcel := MsExcel():New()
                oExcel:WorkBooks:Open(cArqFull)
                oExcel:SetVisible(.T.)
                oExcel:Destroy()         
            EndIf
            
            (cAliasQry)->(DbCloseArea())

        endif
    EndIf
    oQryImp:Destroy()
    oQryImp:= Nil
    RestArea(aArea)
Return

