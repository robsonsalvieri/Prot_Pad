#INCLUDE "tlpp-core.th"
#INCLUDE "PROTHEUS.CH"
#INCLUDE "FILEIO.CH"
#INCLUDE "FWMBROWSE.CH"
#INCLUDE "FWMVCDEF.CH"

Namespace totvs.protheus.backoffice.fiscal.configurador.consult.tax.operations

//-------------------------------------------------------------------
/*/{Protheus.doc} OperationReport
Relatório de Operações Fiscais - Consulta Parametrizável de Livros Fiscais

@description
Função principal que constrói um assistente (Wizard) interativo para 
geração de relatório customizável de operações fiscais. Permite ao usuário 
selecionar campos de diversas tabelas (Produtos, Clientes, Fornecedores, 
TES, Exceções Fiscais), impostos específicos e critérios de ordenação, 
gerando automaticamente uma planilha Excel com os dados consolidados da 
tabela SFT (Livros Fiscais).

@type User Function
@author Squad Fiscal - TOTVS
@since 01/11/2025
@version 12.1.2510

@obs Principais funcionalidades:
- Wizard com múltiplas etapas de seleção de dados
- Seleção dinâmica de campos das tabelas SB1, SA1, SA2, SF4, SF7
- Seleção de impostos: ICMS, IPI, PIS, COFINS, CSLL, ISS, IRRF, INSS
- Filtros por período (Data De/Até)
- Opções de ordenação: NCM, Perfil de Operação
- Geração automática de query SQL otimizada
- Exportação para Excel (.xml)

@history
- 01/11/2025 - Criação inicial da função

@example
U_OperationReport()

@see
- MontaQRY() - Monta queries SQL
- GeraExcel() - Gera arquivo Excel
- FiltraSFT() - Aplica filtros na SFT
- CamposBrw() - Define campos do browse

@return Nil

@obs Tabelas envolvidas:
- SFT - Livros Fiscais (principal)
- SB1 - Produtos
- SA1 - Clientes
- SA2 - Fornecedores
- SF4 - TES
- SF7 - Exceções Fiscais
- F20/F23 - Perfil de Operações

@obs Performance:
- Utiliza FWWizardControl para interface moderna
- Browses com marcação otimizada (FWFormBrowse)
- Queries SQL parametrizadas e agrupadas
- Exportação direta para Excel sem gravar em banco

@obs Segurança:
- Validação de filtros de data obrigatórios
- Controle de seleção de campos (prevent SQL injection)
- Tratamento de erros na geração da query
/*/
//-------------------------------------------------------------------
User Function OperationReport()

    Local oNewPag         := NIL as object
    Local oStepWiz        := NIL as object
    Local aCoords         := FWGetDialogSize() as array
    Local nSteps          := 0 as numeric
    Local lAllSelect    := .T. as logical // Variável para controlar a seleção de todos os itens
    Local lAllImp       := .T. as logical // Variável para controlar a seleção de todos os impostos
    Local aCampos       := {} as array
    Local aEstrutura    := {} as array

    Private oFont18       := TFont():New('Arial',,18,,.F.,,,,,.F.,.F.) as object // Fonte do texto
    Private lAllPerfil    := .T. as logical
    // Browses dos Resumos
    Private aResumoTax    := {} as array
    Private aDadosOrdem := {} as array
    Private oMarkOrdem  := NIL as object
    Private oImposto    := NIL as object
    Private oMarkSA1    := NIL as object
    Private oMarkSB1    := NIL as object
    Private oMarkSA2    := NIL as object
    Private oMarkSF4    := NIL as object
    Private oMarkSF7    := NIL as object
    Private oMarkCFC    := NIL as object

    oStepWiz:= FWWizardControl():New(,{aCoords[3] * 0.8, aCoords[4] * 0.8})
    oStepWiz:ActiveUISteps()

    //----------------------
    // Pagina 1 - Início
    //----------------------
    nSteps +=1

    oNewPag := oStepWiz:AddStep(cValToChar(nSteps))
    //Altera a descrição do step
    oNewPag:SetStepDescription("Início") //"Início"
    //Define o bloco de construção
    oNewPag:SetConstruction({|Panel|TelaAprest(Panel)})
    oNewPag:SetNextAction({||.T. }) 
    //------------------------------
    // Pagina 2 - Cadastro de produtos
    //-----------------------------

    nSteps +=1
    oNewPag := oStepWiz:AddStep(cValToChar(nSteps))
    //Altera a descrição do step
    oNewPag:SetStepDescription("Produto") //"Produto"
    //Define o bloco de construção
    oNewPag:SetConstruction({|Panel|MarkTabela(Panel, "SB1", @lAllSelect, @oMarkSB1)})
    oNewPag:SetNextAction({||.T. }) 

    //------------------------------
    // Pagina 3 - Cadastro de Clientes
    //-----------------------------

    nSteps +=1
    oNewPag := oStepWiz:AddStep(cValToChar(nSteps))
    //Altera a descrição do step
    oNewPag:SetStepDescription("Cliente") //"Cliente"
    //Define o bloco de construção
    oNewPag:SetConstruction({|Panel|MarkTabela(Panel, "SA1", @lAllSelect, @oMarkSA1)})
    oNewPag:SetNextAction({||.T. }) 
    //Define o bloco ao clicar no botão Próximo

    //------------------------------
    // Pagina 4 - Cadastro de Fornecedores
    //-----------------------------

    nSteps +=1
    oNewPag := oStepWiz:AddStep(cValToChar(nSteps))
    //Altera a descrição do step
    oNewPag:SetStepDescription("Fornecedor") //"Fornecedor"
    //Define o bloco de construção
    oNewPag:SetConstruction({|Panel|MarkTabela(Panel, "SA2", @lAllSelect, @oMarkSA2)})
    oNewPag:SetNextAction({||.T. }) 
    //Define o bloco ao clicar no botão Próximo


    //------------------------------
    // Pagina 5 - Cadastro de TES
    //-----------------------------

    nSteps +=1
    oNewPag := oStepWiz:AddStep(cValToChar(nSteps))
    //Altera a descrição do step
    oNewPag:SetStepDescription("TES") //"Fornecedor"
    //Define o bloco de construção
    oNewPag:SetConstruction({|Panel|MarkTabela(Panel, "SF4", @lAllSelect, @oMarkSF4)})
    oNewPag:SetNextAction({||.T. }) 
    //Define o bloco ao clicar no botão Próximo


    //------------------------------
    // Pagina 6 - Cadastro de Exceção Fiscal
    //-----------------------------

    nSteps +=1
    oNewPag := oStepWiz:AddStep(cValToChar(nSteps))
    //Altera a descrição do step
    oNewPag:SetStepDescription("Exceção Fiscal") //"Fornecedor"
    //Define o bloco de construção
    oNewPag:SetConstruction({|Panel|MarkTabela(Panel, "SF7", @lAllSelect, @oMarkSF7)})
    oNewPag:SetNextAction({||.T. }) 
    //Define o bloco ao clicar no botão Próximo
 
    //------------------------------
    // Pagina 7 - Selecione o Imposto
    //-----------------------------

    nSteps +=1
    oNewPag := oStepWiz:AddStep(cValToChar(nSteps))
    //Altera a descrição do step
    oNewPag:SetStepDescription("Impostos") //"Fornecedor"
    //Define o bloco de construção
    oNewPag:SetConstruction({|Panel|SelectTax(Panel, @lAllImp,@oImposto)})
    oNewPag:SetNextAction({||.T. }) 
    //Define o bloco ao clicar no botão Próximo

    //------------------------------
    // Pagina 8 - Filtros
    //----------------------------- 

    nSteps +=1
    oNewPag := oStepWiz:AddStep(cValToChar(nSteps))
    //Altera a descrição do step
    oNewPag:SetStepDescription("Filtros") //"Filtros"
    //Define o bloco de construção
    oNewPag:SetConstruction({|Panel|FiltraSFT(Panel,@oMarkOrdem)})
    oNewPag:SetNextAction({||FwMsgRun(,{|oSay| Concluir( aCampos, aEstrutura, oSay,oMarkSB1,oMarkSA1,oMarkSA2,oMarkSF4,oMarkSF7,oMarkCFC,oImposto,oMarkOrdem ) },"Processando Informações...","") .OR. .T. }) //"Processando Informações..."

 
    oStepWiz:Activate()
    oStepWiz:Destroy()

Return NIL

//-------------------------------------------------------------------
/*/{Protheus.doc} TelaAprest
Tela de apresentação inicial do wizard de operações fiscais

@description Constrói a tela de boas-vindas (step 1) do assistente,
exibindo mensagem explicativa sobre o relatório e suas funcionalidades.

@type Static Function
@param oPanel, Object, Painel fornecido pelo FWWizardControl
@return Nil
@author Squad Fiscal - TOTVS
@since 01/11/2025
/*/
//-------------------------------------------------------------------
Static Function TelaAprest(oPanel)

    Local cTexto    := "" as character
    Local oPanel1   := NIL as object 
    Local oLayer    := NIL as object
    Local oSayIntro := NIL as object

    cTexto += "<table width='100%' border=0 cellpadding='15' cellspacing='5' align:'justify'>"
    cTexto += "<tr>"
    cTexto += "<td colspan='5'>"

    cTexto += "<p>O relatório de operações fiscais permite a personalização por meio da inclusão de campos adicionais, <br><br>"
    cTexto += "conforme as regras e particularidades do ambiente tributário da empresa. Ele é gerado automaticamente a partir das informações contidas na tabela de livros fiscais." + "<br><br>"

    cTexto += "</td>"
    cTexto += "</tr>"
    cTexto += "</table>"

    oLayer := FWLayer():New()
    oLayer:Init(oPanel, .F.)
    oLayer:AddLine('LIN1', 60, .F.)

    oPanel1  := oLayer:getLinePanel('LIN1')

    oSayIntro := TSay():New(5,5,{||cTexto},oPanel1,,oFont18,,,,.T.,,,(oPanel1:nWidth / 2) - 10,(oPanel1:nHeight / 2) - 10,,,,,,.T.)

Return NIL


//-------------------------------------------------------------------
/*/{Protheus.doc} FiltraSFT
Monta a interface de filtros da SFT e opções de ordenação

@type Static Function
@author Squad Fiscal - TOTVS
@since 01/11/2025
@version 12.1.2510
@param oPanel, Object, Painel fornecido pelo FWWizardControl
@param oMarkOrdem, Object, Objeto FWFormBrowse de ordenação (passado por referência)
@return Nil
/*/
//-------------------------------------------------------------------
Static Function FiltraSFT(oPanel,oMarkOrdem)

    Local oSayOrigem := NIL as object
    Local oSayTitulo := NIL as object

    Local oLayer := FWLayer():New() as object
    Local oPanel0 := NIL as object
    Local oPanel1 := NIL as object
    Local oPanel2 := NIL as object

    Local aFields := {} as array
    Local aEstrut := {} as array

    Local aCamposOrdem := {} as array
    Local aCmpBrw := {} as array

    Local oGetsSFT := NIL as object

    oLayer:Init(oPanel,.F.)
    oLayer:AddLine('LIN0', 10, .F.)
    oLayer:AddLine('LIN1', 45, .F.)
    oLayer:addCollumn('LIN1_COL1',100,.F.,'LIN1')
    oLayer:AddLine('LIN2', 45, .F.)
    oLayer:addCollumn('LIN2_COL1',100,.F.,'LIN2')
    oLayer:AddWindow('LIN2_COL1','W1',"Ordem de geração",100,.F.,.F.,,'LIN2') //"Ordem de geração"

    oPanel0 := oLayer:getLinePanel('LIN0')
    oPanel1 := oLayer:getColPanel('LIN1_COL1', 'LIN1')
    oPanel2 := oLayer:getWinPanel('LIN2_COL1', 'W1', 'LIN2')

    // Título da página
    oSayTitulo := TSay():New(5,5,{||"Utilize os filtros abaixo para selecionar as operações do livro fiscal"},oPanel0,,oFont18,,,,.T.,,,(oPanel0:nWidth / 2) - 10,(oPanel0:nHeight / 2) - 10) //"Utilize os filtros abaixo para selecionar os produtos que serão adicionados ou removidos do(s) perfil(is) selecionado(s)"

    // Montagem da MsMGet
    aEstrut := MontaEstrut('SFT')
    aEval(aEstrut, {|x| aAdd(aFields, x[2])})
    oGetsSFT := MsmGet():New(,,3,,,,aFields,{0,3,(oPanel1:nClientHeight-4)/2,(oPanel1:nClientWidth/2)-5},,,,,,oPanel1,,,.T.,,,.T.,aEstrut,,,,,.T.)

    // Seleção das origens
    oSayOrigem := TSay():New(0,0,{|| "Selecione a ordenação a ser considerada"},oPanel2,,oFont18,,,,.T.,,,15,0,,,,,,.T.) //"Selecione a ordenação a ser considerada"

    //Monta os campos do cliente
    aCmpBrw  := CamposBrw('aDadosOrdem', 'oMarkOrdem', 'ORDENACAO')

    aCamposOrdem    := HeaderMark(aCmpBrw, .F.)

    //Monta array de resumo dos clientes selecionados
    aDadosOrdem  := LoadTax('ORDENACAO')

    //Browse de cliente
    ADDBrwArrayMark(@oMarkOrdem, .T.,aCamposOrdem, aDadosOrdem, oPanel2,.F.,.T.)


Return


//-------------------------------------------------------------------
/*/{Protheus.doc} MontaEstrut
Monta a estrutura de campos para os filtros das MsGet utilizadas no wizard

@description Função responsável por construir a estrutura de campos (array de propriedades) 
necessários para montagem dos objetos MsGet que compõem os filtros do relatório. 
Define campos do tipo data para filtro de período (Data De/Até) da tabela SFT (Livros Fiscais).
Cada campo é configurado com título, nome da variável, tipo, tamanho, picture e valor inicial.

@type Static Function
@author Squad Fiscal - TOTVS
@since 01/11/2025
@version 12.1.2510

@param cTpEstrut, Character, Tipo de estrutura a ser montada. Valores aceitos: "SFT" (filtros da tabela de Livros Fiscais)

@return Array, Estrutura de campos formatada para uso em MsGet contendo:
[n][01] - Título do campo (exibido na tela)
[n][02] - Nome da variável (Private)
[n][03] - Tipo do campo (C/N/D/L)
[n][04] - Tamanho do campo
[n][05] - Decimais (para campos numéricos)
[n][06] - Picture de formatação
[n][07] - Bloco de validação
[n][08] - Campo obrigatório (.T./.F.)
[n][09] - Nível de acesso
[n][10] - Inicializador padrão
[n][11] - Consulta F3
[n][12] - Bloco When
[n][13] - Visual apenas
[n][14] - Campo chave
[n][15] - Opções de combo
[n][16] - Folder
[n][17] - Não alterável
[n][18] - Picture variável
[n][19] - Gatilho

@obs Campos criados:
- dDataDeSFT: Data inicial do período (FT_ENTRADA)
- dDataAteSFT: Data final do período (FT_ENTRADA)

Ambos os campos são criados como variáveis Private no namespace da função principal.
/*/
//-------------------------------------------------------------------
Static Function MontaEstrut(cTpEstrut)

    Local aRet := {} as array
    Local nPos := 0 as numeric
    Local nTamData := FWSX3Util():GetFieldStruct("FT_ENTRADA")[3] as numeric


    Do Case

        Case cTpEstrut == "SFT"
            
            // Estrutura para o filtro da SFT

            nPos := AddStruct(@aRet)

            aRet[nPos][01] := "Data de"
            aRet[nPos][02] := 'dDataDeSFT'
            aRet[nPos][03] := 'D'
            aRet[nPos][04] := nTamData
            aRet[nPos][06] := PesqPict("SFT", "FT_ENTRADA")
            aRet[nPos][10] := CriaVar('FT_ENTRADA')

            _SetNamedPrvt( "dDataDeSFT" , CTOD("//"), 'totvs.protheus.backoffice.fiscal.configurador.consult.tax.operations.U_OperationReport')

            // Descrição

            nPos := AddStruct(@aRet)

            aRet[nPos][01] := "Data Ate"
            aRet[nPos][02] := 'dDataAteSFT'
            aRet[nPos][03] := 'D'
            aRet[nPos][04] := nTamData
            aRet[nPos][06] := PesqPict("SFT", "FT_ENTRADA")
            aRet[nPos][10] := CriaVar('FT_ENTRADA')

            _SetNamedPrvt( "dDataAteSFT" , CTOD("//"), 'totvs.protheus.backoffice.fiscal.configurador.consult.tax.operations.U_OperationReport')

        
    EndCase

Return aRet

//-------------------------------------------------------------------
/*/{Protheus.doc} AddStruct
Adiciona um novo item de estrutura com valores padrão ao array de estruturas

@description Função auxiliar que cria e inicializa um novo elemento de estrutura no array 
aEstruct, preenchendo-o com 19 posições contendo valores DEFAULT para todos os atributos 
de um campo. Este item será posteriormente customizado pela função MontaEstrut() para 
composição dos objetos MsGet utilizados nas telas de filtro do wizard.
A estrutura criada segue o padrão ADVPL para definição de campos em enchoices/MsGet.

@type Static Function
@author Squad Fiscal - TOTVS
@since 01/11/2025
@version 12.1.2510

@param aEstruct, Array, Array de estruturas que receberá o novo item (passado por referência)

@return Numeric, Posição do item recém-adicionado no array (Len(aEstruct))

@obs Estrutura do array criado (19 posições):
[1]  - Título do campo (vazio por padrão)
[2]  - Nome da variável/campo (vazio por padrão)
[3]  - Tipo do campo: C/N/D/L (vazio por padrão)
[4]  - Tamanho do campo (0 por padrão)
[5]  - Decimais para campos numéricos (0 por padrão)
[6]  - Picture de formatação (vazio por padrão)
[7]  - Bloco de validação ({|| .T.} por padrão - sempre válido)
[8]  - Campo obrigatório (.F. por padrão)
[9]  - Nível de acesso (1 por padrão)
[10] - Inicializador padrão (vazio por padrão)
[11] - Consulta F3 (vazio por padrão)
[12] - Bloco When ({|| } por padrão - vazio)
[13] - Visual apenas (.F. por padrão)
[14] - Campo chave (.F. por padrão)
[15] - Opções de combo (vazio por padrão)
[16] - Folder (0 por padrão)
[17] - Não alterável (.F. por padrão)
[18] - Picture variável (vazio por padrão)
[19] - Gatilho ('N' por padrão - sem gatilho)
/*/
//-------------------------------------------------------------------
Static Function AddStruct(aEstruct)

    Local nPosicao := 0 as numeric

    DEFAULT aEstruct := {}

    Aadd(aEstruct,{})
    nPosicao := Len(aEstruct)

    Aadd(aEstruct[nPosicao],'')			// 01 - Titulo
    Aadd(aEstruct[nPosicao],'')			// 02 - Campo
    Aadd(aEstruct[nPosicao],'')			// 03 - Tipo
    Aadd(aEstruct[nPosicao],0)			// 04 - Tamanho
    Aadd(aEstruct[nPosicao],0)			// 05 - Decimal
    Aadd(aEstruct[nPosicao],'')			// 06 - Picture
    Aadd(aEstruct[nPosicao],{|| .T. })	// 07 - Valid
    Aadd(aEstruct[nPosicao],.F.)		// 08 - Obrigat
    Aadd(aEstruct[nPosicao],1)			// 09 - Nivel
    Aadd(aEstruct[nPosicao],'')			// 10 - Inicializador Padrão
    Aadd(aEstruct[nPosicao],'')			// 11 - F3
    Aadd(aEstruct[nPosicao],{|| })		// 12 - When
    Aadd(aEstruct[nPosicao],.F.)		// 13 - Visual
    Aadd(aEstruct[nPosicao],.F.)		// 14 - Chave
    Aadd(aEstruct[nPosicao],'')			// 15 - Box - Opção do combo
    Aadd(aEstruct[nPosicao],0)			// 16 - Folder
    Aadd(aEstruct[nPosicao],.F.)		// 17 - Não Alterável
    Aadd(aEstruct[nPosicao],'')			// 18 - PictVar
    Aadd(aEstruct[nPosicao],'N')		// 19 - Gatilho

Return nPosicao


//-------------------------------------------------------------------
/*/{Protheus.doc} MarkTabela
    Realiza a montagem de um browse com opção de marcação (mark) para seleção de registros, criando uma interface visual com FWLayer e FWMarkBrowse.
    
    @type  Static Function
    @author Squad Fiscal - TOTVS
    @since 01/11/2025
    @version 12.1.2510
    @param oPanel, object, Objeto do painel onde o browse será montado
    @param cTabela, character, Nome da tabela (alias) a ser exibida no browse
    @param lAllPerfil, logical, Indica se deve exibir todos os perfis disponíveis
    @param oMark, object, Objeto FWMarkBrowse para controle da marcação de registros
    @return object, oMark, Retorna o objeto FWMarkBrowse configurado com os dados da tabela
    @obs Utiliza FWLayer para organizar layout e monta query dinâmica com campos do SX3
/*/
//-------------------------------------------------------------------
Static Function MarkTabela(oPanel, cTabela, lAllPerfil,oMark)

    Local cAliasF20 := GetNextAlias() as character
    Local cQuery := "" as character
    Local aCampos := {} as array
    Local aColumns := {} as array
    Local oLayer := FWLayer():new() as object
    Local oPanel1 := NIL as object
    Local oPanel2 := NIL as object
    Local oSayTitulo := NIL as object

    //Chama função para montar query e array com os campos do Header
    cQuery := MontaQRY("SX3", {cTabela}, @aCampos)

    //Chama função para montar as colunas do aHeader
    aColumns  := HeaderMark(aCampos)

    //Cria Layer
    oLayer:Init(oPanel,.F.)

    // Adicionando linhas
    oLayer:AddLine('L1',10,.F.)
    oLayer:AddLine('L2',90,.F.)
    oPanel1 := oLayer:getLinePanel('L1')
    oPanel2 := oLayer:getLinePanel('L2')

    //Crio o TSay na primeira linha da Layer
    oSayTitulo := TSay():New(5,5,{||"Selecione os campos da tabela de " + DescTabela(cTabela) + " que serão incluídos na consulta" },oPanel1,,oFont18,,,,.T.,,,(oPanel1:nWidth / 2) - 10,(oPanel1:nHeight / 2) - 10) 

    //Criando o Browse
    AddMarkBro(oPanel2, @lAllPerfil, aCampos, aColumns, cQuery, cAliasF20, @oMark)

Return

//-------------------------------------------------------------------
/*/{Protheus.doc} MontaQRY
    Centraliza a construção e execução de queries SQL dinâmicas para os diferentes tipos de consultas utilizadas nos painéis do configurador fiscal, montando SELECT com campos customizados e filtros específicos.
    
    @type  Static Function
    @author Squad Fiscal - TOTVS
    @since 01/11/2025
    @version 12.1.2510
    @param cTpQuery, character, Tipo da query a ser executada (ex: "SX3", "F20", "F21", etc.)
    @param aParamQry, array, Array com parâmetros específicos para montagem da query (filtros, códigos, tabelas)
    @param aCampos, array, Array passado por referência que será preenchido com os campos do browse
    @param cArrayRes, character, Nome do array de resultado para composição dos campos (opcional)
    @param cObjRes, character, Nome do objeto de resultado para composição dos campos (opcional)
    @param cCodF20, character, Código F20 para filtros específicos em queries relacionadas (opcional)
    @return character, cQuery, String SQL completa montada conforme tipo e parâmetros informados
    @obs Utiliza CamposBrw() para obter campos do SX3 e ValToSql() para conversão segura de valores
/*/
//-------------------------------------------------------------------
Static Function MontaQRY(cTpQuery, aParamQry, aCampos, cArrayRes, cObjREs,cCodF20)

    Local cQuery := "" as character
    Local nX := 0 as numeric

    DEFAULT cArrayRes := ''
    DEFAULT cObjREs   := ''
    DEFAULT cCodF20   := ''

    aCampos := CamposBrw(cArrayRes, cObjRes, "SX3")

        cQuery  := "SELECT 0 OK"

    //Adiciona os campos do Header na seção do select
    For nX := 1 to Len(aCampos)
        cQuery  += " , " + aCampos[nX][1]
    Next nX

    Do Case

        Case cTpQuery == "SX3"

            cQuery  += " FROM " + RETSQLNAME("SX3") + " SX3 WHERE SX3.X3_ARQUIVO = " + ValToSql(aParamQry[1]) + " AND SX3.X3_TIPO <> 'M'"
            cQuery  += " AND SX3.X3_CONTEXT = 'R' AND SX3.D_E_L_E_T_ = ' ' "
    EndCase

Return cQuery

//-------------------------------------------------------------------
/*/{Protheus.doc} HeaderMark
    Cria as colunas do header do browse (FWBrwColumn) configurando propriedades de exibição como título, tipo, tamanho, picture, alinhamento e origem dos dados (query ou array).
    
    @type  Static Function
    @author Squad Fiscal - TOTVS
    @since 01/11/2025
    @version 12.1.2510
    @param aCampos, array, Array com estrutura dos campos contendo: [1]Nome, [2]Título, [3]Tipo, [4]Tamanho, [5]Picture, [6]Alinhamento, [7]CodeBlock
    @param lQuery, logical, Indica se os dados virão de query SQL (.T.) ou de array (.F.) - Default: .T.
    @return array, aColumns, Array de objetos FWBrwColumn configurados para o browse
    @obs Utiliza FWBrwColumn para criar cada coluna com suas propriedades e macro substituição (&) para definir a origem dos dados
/*/
//-------------------------------------------------------------------
Static Function HeaderMark(aCampos, lQuery)

    Local oColuna := NIL as object
    Local aColumns := {} as array
    Local nX := 0 as numeric

    DEFAULT lQuery  := .T.

    For nX  := 1 to Len(aCampos)
        oColuna := FWBrwColumn():New()	    // Cria objeto
        oColuna:SetEdit(.F.)    	   	    // Indica se <E9> editavel
        oColuna:SetTitle(aCampos[nX][2])	// Define titulo
        oColuna:SetType(aCampos[nX][3])	    // Define tipo
        oColuna:SetSize(aCampos[nX][4])	    // Define tamanho
        oColuna:SetPicture(aCampos[nX][5])  // Define picture
        oColuna:SetAlign(aCampos[nX][6])    // Define alinhamento
        If lQuery
            oColuna:SetData(&('{||'+aCampos[nX][1]+'}'))
        Else
            oColuna:SetData(&(aCampos[nX][7]))
        EndIf
        Aadd(aColumns,oColuna)
    Next nX

Return aColumns

//-------------------------------------------------------------------
/*/{Protheus.doc} SetMarkAll
    Realiza marcação ou desmarcação em massa de todas as linhas do browse, percorrendo todo o alias e atualizando o campo OK conforme o estado de marcação solicitado.
    
    @type  Static Function
    @author Squad Fiscal - TOTVS
    @since 01/11/2025
    @version 12.1.2510
    @param oObjMark, object, Objeto FWMarkBrowse que contém os dados a serem marcados/desmarcados
    @param lMarkAll, logical, Indica se deve marcar (.T.) ou desmarcar (.F.) todas as linhas do browse
    @return nil, Não retorna valor, apenas atualiza o browse e inverte o estado da variável lMarkAll
    @obs Percorre todas as linhas do alias, atualiza campo OK (1=marcado, 0=desmarcado) e executa Refresh() duplo para garantir atualização visual
/*/
//-------------------------------------------------------------------
Static Function SetMarkAll( oObjMark, lMarkAll )

    Local cMarkABB := '' as character

    //Busco o Alias do Browse
    cMarkABB := oObjMark:cAlias

    //Percorro todoas as linhas e marco/desmarco todas as linhas
    (cMarkABB)->( DbGoTop() )
    While (cMarkABB)->( !EOF() )
        (cMarkABB)->OK := Iif(lMarkAll,1,0)
        (cMarkABB)->( DbSkip() )
    EndDo

    //Retorno para a primeira linha
    (cMarkABB)->( DbGoTop() )

    //Atualizo a variável de controle e do refresh no Browse
    lMarkAll := !lMarkAll
    oObjMark:Refresh(,.T.)
    oObjMark:Refresh(,.T.)

Return

//-------------------------------------------------------------------
/*/{Protheus.doc} SetArMaAll
    Realiza marcação ou desmarcação em massa de todas as linhas de um array (aCols), atualizando o campo de marcação na última posição de cada linha do array.
    
    @type  Static Function
    @author Squad Fiscal - TOTVS
    @since 01/11/2025
    @version 12.1.2510
    @param aCols, array, Array bidimensional contendo os dados das linhas, onde última posição é o campo de marcação
    @param oObjMark, object, Objeto do browse que será atualizado visualmente após marcação
    @param lMarkAll, logical, Indica se deve marcar (.T. = "1") ou desmarcar (.F. = "0") todas as linhas
    @return nil, Não retorna valor, apenas atualiza o array aCols e o browse
    @obs Assume que o campo de marcação está sempre na última posição de cada linha do array (len(aCols[1]))
/*/
//-------------------------------------------------------------------
Static Function SetArMaAll(aCols,oObjMark, lMarkAll)

	Local nCount := 0 as numeric
    Local nPosMark := len(aCols[1]) as numeric //Posição do campo de marcação
	
	For nCount := 1 To Len(aCols)
		If lMarkAll
			aCols[nCount][nPosMark] := "1"
		Else
			aCols[nCount][nPosMark] := "0"
		EndIf
	Next
	lMarkAll := !lMarkAll

    oObjMark:Refresh(,.T.)


Return Nil


//-------------------------------------------------------------------
/*/{Protheus.doc} DescTabela
    Retorna a descrição formatada do nome da tabela, obtendo a descrição do SX2 através do FwSX2Util e aplicando capitalização e remoção de espaços.
    
    @type  Static Function
    @author Squad Fiscal - TOTVS
    @since 01/11/2025
    @version 12.1.2510
    @param cTabela, character, Alias da tabela (ex: "SA1", "SB1") para buscar a descrição no dicionário SX2
    @return character, cRet, Descrição da tabela formatada com Capital() e Trim() (ex: "Clientes", "Produtos")
    @obs Utiliza FwSX2Util():GetX2Name() para buscar descrição no dicionário de dados e formata com Capital() e Trim()
/*/
//-------------------------------------------------------------------
Static Function DescTabela(cTabela)
    Local cRet := Capital(Trim(FwSX2Util():GetX2Name(cTabela))) as character
Return cRet

//-------------------------------------------------------------------
/*/{Protheus.doc} AddMarkBro
    Cria e configura o objeto FwFormBrowse com funcionalidades de marcação (mark), definindo colunas de marcação, query de dados, eventos de clique e desabilitando opções desnecessárias como detalhes, relatórios e configuração.
    
    @type  Static Function
    @author Squad Fiscal - TOTVS
    @since 01/11/2025
    @version 12.1.2510
    @param oPanel, object, Objeto do painel onde o browse será montado e ativado
    @param lAllMark, logical, Variável de controle passada por referência para marcar/desmarcar todos os registros
    @param aCampos, array, Array com estrutura dos campos do browse (não utilizado diretamente, mas parte do contexto)
    @param aColumns, array, Array de objetos FWBrwColumn com as colunas configuradas para exibição
    @param cQuery, character, String SQL com a query que alimentará o browse
    @param cAliasTab, character, Nome do alias temporário para a query executada
    @param oMark, object, Objeto FwFormBrowse passado por referência que será configurado e ativado
    @return nil, Não retorna valor, apenas configura e ativa o objeto oMark
    @obs Configura codeblocks para marcação (bMark, bMarkOne, bMarkAll), desabilita detalhes/relatórios/config e posiciona no primeiro registro
/*/
//-------------------------------------------------------------------
Static Function AddMarkBro(oPanel, lAllMark, aCampos, aColumns, cQuery, cAliasTab, oMark)

    Local bMark := {||IIf((oMark:cAlias)->OK == 1, "LBOK", "LBNO")} as codeblock
    Local bMarkOne := {||IIf((oMark:cAlias)->OK == 0,(oMark:cAlias)->OK := 1, (oMark:cAlias)->OK := 0 )} as codeblock
    Local bMarkAll := {||SetMarkAll(@oMark, @lAllMark)} as codeblock

    oMark := FwFormBrowse():New()
    oMark:AddMarkColumns(bMark,bMarkOne,bMarkAll)
    oMark:SetDataQuery(.T.)
    oMark:SetQuery(cQuery)
    oMark:SetAlias(cAliasTab)
    oMark:SetOwner(oPanel)
    oMark:SetColumns(aColumns)
    oMark:SetDoubleClick(bMarkOne)
    oMark:DisableDetails()
    oMark:DisableReport()
    oMark:DisableConfig()
    oMark:Activate()
    oMark:GoTop(.T.)
    oMark:SetFocus()

Return

//-------------------------------------------------------------------
/*/{Protheus.doc} CamposBrw
    Monta array com estrutura dos campos que farão parte do browse, definindo propriedades como nome do campo, descrição, tipo, tamanho, picture, alinhamento e codeblock para exibição, conforme o alias especificado (SX3, IMPOSTO, ORDENACAO).
    
    @type  Static Function
    @author Squad Fiscal - TOTVS
    @since 01/11/2025
    @version 12.1.2510
    @param cArrayRes, character, Nome do array de resultado para montagem do codeblock de exibição (opcional)
    @param cObjRes, character, Nome do objeto de resultado para montagem do codeblock de exibição (opcional)
    @param cAlias, character, Tipo de alias que define quais campos serão montados: "SX3", "IMPOSTO", "ORDENACAO"
    @return array, aRet, Array com estrutura dos campos [1]Nome, [2]Descrição, [3]Tipo, [4]Tamanho, [5]Picture, [6]Alinhamento, [7]CodeBlock
    @obs Utiliza Do Case para determinar estrutura específica de campos conforme alias informado
/*/
//-------------------------------------------------------------------
Static Function CamposBrw(cArrayRes, cObjRes, cAlias)

    Local aRet := {} as array

    DEFAULT cArrayRes   := ''
    DEFAULT cObjRes     := ''

    Do Case

        Case cAlias == "SX3"

            //Campos que farão parte da seção select da query e do Header
            aAdd(aRet,{;
            "X3_CAMPO",; //Campo
            "Campo",;//Descrição
            "C",;//Tipo
            10,;//Tamanho
            "@!",;//Picture;
            "LEFT",;//Alinhamento
            '{|| ' + cArrayRes + '[' + cObjRes +':At()][1] }'})//Bloco de Código para exibição do resumo

            aAdd(aRet,{;
            "X3_TITULO",; //Campo
            "Título",;//Descrição
            "C",;//Tipo
            12,;//Tamanho
            "@!",;//Picture;
            "LEFT",;//Alinhamento
            '{|| ' + cArrayRes + '[' + cObjRes +':At()][2] }'})//Bloco de Código para exibição do resumo

            aAdd(aRet,{;
            "X3_DESCRIC",; //Campo
            "Descrição",;//Descrição
            "C",;//Tipo
            25,;//Tamanho
            "@!",;//Picture;
            "LEFT",;//Alinhamento
            '{|| ' + cArrayRes + '[' + cObjRes +':At()][2] }'})//Bloco de Código para exibição do resumo

        Case cAlias == "IMPOSTO"

            //Campos que farão parte da seção select da query e do Header
            aAdd(aRet,{;
            "TRB_IMPOST",; //Campo
            "Imposto",;//Descrição
            "C",;//Tipo
            20,;//Tamanho
            "@!",;//Picture;
            "LEFT",;//Alinhamento
            '{|| ' + cArrayRes + '[' + cObjRes +':At()][1] }'})//Bloco de Código para exibição do resumo

        Case cAlias == "ORDENACAO"

            //Campos que farão parte da seção select da query e do Header
            aAdd(aRet,{;
            "TRX_ORDEM",; //Campo
            "Ordenação",;//Descrição
            "C",;//Tipo
            20,;//Tamanho
            "@!",;//Picture;
            "LEFT",;//Alinhamento
            '{|| ' + cArrayRes + '[' + cObjRes +':At()][1] }'})//Bloco de Código para exibição do resumo
    
    EndCase

Return aRet

//------------------------------------------------------------------
/*/{Protheus.doc} AtualizaMsg
    Atualiza a mensagem exibida em um objeto TSay (barra de status) e processa mensagens pendentes da fila de eventos do sistema para garantir a atualização visual imediata.
    
    @type  Static Function
    @author Squad Fiscal - TOTVS
    @since 01/11/2025
    @version 12.1.2510
    @param oSay, object, Objeto TSay que terá sua mensagem (cCaption) atualizada
    @param cMsg, character, Texto da mensagem a ser exibida no objeto TSay
    @return nil, Não retorna valor, apenas atualiza o objeto TSay e processa mensagens
    @obs Utiliza ProcessMessages() para forçar atualização imediata da interface visual
/*/
//------------------------------------------------------------------
Static Function AtualizaMsg( oSay, cMsg )

    oSay:cCaption := (cMsg)
    ProcessMessages()

Return

//-------------------------------------------------------------------
/*/{Protheus.doc} SelectTax
    Cria interface para seleção de impostos utilizando FWLayer e browse com marcação, permitindo ao usuário escolher quais impostos (ICMS, IPI, PIS, COFINS, etc.) serão incluídos na consulta fiscal.
    
    @type  Static Function
    @author Squad Fiscal - TOTVS
    @since 01/11/2025
    @version 12.1.2510
    @param oPanel, object, Objeto do painel onde a interface de seleção de impostos será montada
    @param lAllImp, logical, Variável de controle passada por referência para marcar/desmarcar todos os impostos
    @param oImposto, object, Objeto FwFormBrowse passado por referência para o browse de seleção de impostos
    @return nil, Não retorna valor, apenas cria a interface visual de seleção
    @obs Utiliza LoadTax() para carregar lista de impostos e ADDBrwArrayMark() para montar browse com marcação
/*/
//-------------------------------------------------------------------
Static Function SelectTax(oPanel,lAllImp,oImposto)

    Local oLayer := FWLayer():new() as object
    Local oSayTitulo := NIL as object
    Local oPanel1 := NIL as object
    Local oPanel2 := NIL as object
    Local oPanel3 := NIL as object
    Local aCmpBrw := {} as array
    Local aColsTax := {} as array

    //Criando a Layer
    oLayer:Init(oPanel,.F.)

    // Adicionando linhas
    oLayer:AddLine('L1',10,.F.)
    oLayer:AddLine('L2',90,.F.)
    oPanel1 := oLayer:getLinePanel('L1')
    oPanel2 := oLayer:getLinePanel('L2')
    //Adicionando colunas
    oLayer:addCollumn('C1',100,.F.,'L2')
    //Adicionando Window
    oLayer:AddWindow('C1','W1',"Impostos",100,.F.,.F.,,'L2') //"Impostos"
    //Painel 
    oPanel3 := oLayer:getWinPanel('C1','W1','L2')

    //Crio o TSay na primeira linha da Layer
    oSayTitulo := TSay():New(5,5,{||"Selecione os impostos que serão adicionados" },oPanel1,,oFont18,,,,.T.,,,(oPanel1:nWidth / 2) - 10,(oPanel1:nHeight / 2) - 10) //"Selecione os impostos que serão adicionados"

    //Monta os campos 
    aCmpBrw  := CamposBrw('aResumoTax', 'oImposto', 'IMPOSTO')

    aColsTax    := HeaderMark(aCmpBrw, .F.)

   //Monta array de resumo dos selecionados
    aResumoTax  := LoadTax('IMPOSTO')

    //Browse 
    ADDBrwArrayMark(@oImposto, @lAllImp,aColsTax, aResumoTax, oPanel3,.T.,.F.)

Return

//-------------------------------------------------------------------
/*/{Protheus.doc} LoadTax
    Carrega array com lista de impostos disponíveis ou opções de ordenação conforme tipo especificado, retornando array com código, descrição e flag de marcação inicial (não marcado).
    
    @type  Static Function
    @author Squad Fiscal - TOTVS
    @since 01/11/2025
    @version 12.1.2510
    @param cTab, character, Tipo de dados a carregar: "IMPOSTO" (lista de impostos) ou "ORDENACAO" (opções de agrupamento)
    @return array, aRet, Array tridimensional com [1]Descrição, [2]Código, [3]Flag de marcação ("0"=não marcado)
    @obs Para IMPOSTO: retorna ICMS, IPI, PIS, COFINS, CSLL, ISS, IRRF, INSS. Para ORDENACAO: retorna NCM, PERFIL_OPER
/*/
//-------------------------------------------------------------------
Static Function LoadTax(cTab)
    Local aRet := {} as array

    If cTab == 'IMPOSTO'
        Aadd(aRet,{"ICMS"               ,"ICMS"         ,"0"})
        Aadd(aRet,{"IPI"                ,"IPI"          ,"0"})
        Aadd(aRet,{"PIS Apuração"       ,"PIS_APUR"     ,"0"})
        Aadd(aRet,{"COFINS Apuração"    ,"COFINS_APUR"  ,"0"})
        Aadd(aRet,{"CSLL Apuração"      ,"CSLL_APUR"    ,"0"})
        Aadd(aRet,{"PIS Retenção"       ,"PIS_RETE"     ,"0"})
        Aadd(aRet,{"COFINS Retenção"    ,"COFINS_RETE"  ,"0"})
        Aadd(aRet,{"CSLL Retenção"      ,"CSLL_RETE"    ,"0"})
        Aadd(aRet,{"ISS"                ,"ISS"          ,"0"})
        Aadd(aRet,{"IRRF"               ,"IRRF"         ,"0"})
        Aadd(aRet,{"INSS"               ,"INSS"         ,"0"})
    Elseif cTab == "ORDENACAO"

        Aadd(aRet,{"NCM"                ,"NCM"          ,"0"})
        Aadd(aRet,{"Perfil Operação"    ,"PERFIL_OPER"  ,"0"})
    
    endif

Return aRet

//-------------------------------------------------------------------
/*/{Protheus.doc} ADDBrwArrayMark
    Cria e configura browse baseado em array (FwFormBrowse) com funcionalidade de marcação, definindo colunas de marcação, dados do array, eventos de clique e desabilitando opções desnecessárias.
    
    @type  Static Function
    @author Squad Fiscal - TOTVS
    @since 01/11/2025
    @version 12.1.2510
    @param oBrowse, object, Objeto FwFormBrowse passado por referência que será configurado
    @param lAllMark, logical, Variável de controle passada por referência para marcar/desmarcar todos os registros
    @param aColsBrw, array, Array de objetos FWBrwColumn com as colunas configuradas para exibição
    @param aArrayBrw, array, Array bidimensional com os dados a serem exibidos no browse
    @param oOwner, object, Objeto pai (painel) onde o browse será montado
    @param lOpcAllMark, logical, Flag que habilita (.T.) ou desabilita (.F.) a opção de marcar todos os registros
    @return nil, Não retorna valor, apenas configura e ativa o objeto oBrowse
    @obs Campo de marcação deve estar na última posição de cada linha do array (len(aArrayBrw[1]))
/*/
//-------------------------------------------------------------------
Static Function ADDBrwArrayMark(oBrowse, lAllMark,aColsBrw, aArrayBrw, oOwner,lOpcAllMark,lDisableMark)
    Local nPosMark := len(aArrayBrw[1]) as numeric
    Local bMark := {||IIf(aArrayBrw[oBrowse:At()][nPosMark] == "0","LBNO","LBOK") } as codeblock
    Local bMarkOne := {||iif(lDisableMark,SetArMaAll(aArrayBrw,@oBrowse, .F.),),IIf(aArrayBrw[oBrowse:At()][nPosMark] == "0",aArrayBrw[oBrowse:At()][nPosMark] := "1", aArrayBrw[oBrowse:At()][nPosMark] := "0" )} as codeblock
    Local bMarkAll := {||IIf(lOpcAllMark,SetArMaAll(aArrayBrw,@oBrowse, @lAllMark),.F.)} as codeblock

    oBrowse := FwFormBrowse():New()
    oBrowse:AddMarkColumns(bMark,bMarkOne,bMarkAll)
    oBrowse:SetColumns(aColsBrw)
    oBrowse:SetDataArray()
    oBrowse:SetArray(aArrayBrw)
    oBrowse:SetOwner(oOwner)
    oBrowse:DisableDetails()
    oBrowse:DisableReport()
    oBrowse:DisableConfig()
    oBrowse:Activate()
    oBrowse:SetFocus()
    oBrowse:Refresh(.T.)

Return

//-------------------------------------------------------------------
/*/{Protheus.doc} Concluir
    Finaliza o processo de configuração da consulta, consolidando todos os campos selecionados nos diferentes browses (produtos, clientes, fornecedores, TES, impostos, ordenação) e gerando planilha Excel com os resultados da query.
    
    @type  Static Function
    @author Squad Fiscal - TOTVS
    @since 01/11/2025
    @version 12.1.2510
    @param aCampos, array, Array com lista de campos selecionados que farão parte da consulta
    @param aEstrutura, array, Array com estrutura detalhada dos campos (nome, tipo, tamanho, decimais)
    @param oSay, object, Objeto TSay para exibição de mensagens de progresso
    @param oMarkSB1, object, Objeto FwFormBrowse com campos selecionados da tabela SB1 (Produtos)
    @param oMarkSA1, object, Objeto FwFormBrowse com campos selecionados da tabela SA1 (Clientes)
    @param oMarkSA2, object, Objeto FwFormBrowse com campos selecionados da tabela SA2 (Fornecedores)
    @param oMarkSF4, object, Objeto FwFormBrowse com campos selecionados da tabela SF4 (TES)
    @param oMarkSF7, object, Objeto FwFormBrowse com campos selecionados da tabela SF7 (Exceções Fiscais)
    @param oMarkCFC, object, Objeto FwFormBrowse com campos selecionados da tabela CFC
    @param oImposto, object, Objeto FwFormBrowse com impostos selecionados
    @param oMarkOrdem, object, Objeto FwFormBrowse com opções de ordenação/agrupamento selecionadas
    @return logical, .T., Sempre retorna verdadeiro indicando conclusão com sucesso
    @obs Executa MontaAgrup(), CamposFixos(), MontaSelecao(), MontaWhere() e GeraExcel() para processar e exportar dados
/*/
//-------------------------------------------------------------------
Static Function Concluir(aCampos,aEstrutura,oSay,oMarkSB1,oMarkSA1,oMarkSA2,oMarkSF4,oMarkSF7,oMarkCFC,oImposto, oMarkOrdem)
    Local cSelect := "" as character
    Local cGroup := "" as character
    Local cOrder := "" as character
    Local cOpcOrdem := "" as character
    Local cJoin := "" as character
    Local cWhere := "" as character


    if Valtype(oMarkOrdem) == "O"
        cOpcOrdem:=MontaAgrup(oMarkOrdem, @cSelect, @cGroup, @cOrder, @cJoin)
    endif

    CamposFixos(@aCampos, @aEstrutura, cOpcOrdem)

    AdicionaSelecao(oMarkSB1, @aCampos, @aEstrutura)
    AdicionaSelecao(oMarkSA1, @aCampos, @aEstrutura)
    AdicionaSelecao(oMarkSA2, @aCampos, @aEstrutura)
    AdicionaSelecao(oMarkSF4, @aCampos, @aEstrutura)
    AdicionaSelecao(oMarkSF7, @aCampos, @aEstrutura)
    AdicionaSelecao(oMarkCFC, @aCampos, @aEstrutura)

    if Valtype(oImposto) == "O"
        MontaSelecao(oImposto, "IMPOSTO", @aCampos, @aEstrutura)
        MontaWhere(oImposto, @cWhere)
    endif

    MontaSelecao(, "FINAL", @aCampos, @aEstrutura)

    GeraExcel(aCampos, aEstrutura, oSay, cSelect, cGroup, cOrder, cJoin, cWhere)

    AtualizaMsg( oSay, "Processamento Concluído com Sucesso!") //"Processamento Concluído com Sucesso!"

Return .T.

/*/{Protheus.doc} AdicionaSelecao
    Função auxiliar para evitar repetição de código na função Concluir()
    @type  Static Function
    @author Squad Fiscal - TOTVS
    @since 01/11/2025
    @version 12.1.2510
    @param oMark, object, Objeto FwFormBrowse com campos selecionados
    @param aCampos, array, Array passado por referência que receberá os campos selecionados
    @param aEstrutura, array, Array passado por referência que receberá a estrutura dos
    @return return, return_type, return_description

    /*/
Static Function AdicionaSelecao(oMark,aCampos,aEstrutura)
    if Valtype(oMark) == "O"
        MontaSelecao(oMark, "SX3", @aCampos, @aEstrutura)
    endif
Return

//-------------------------------------------------------------------
/*/{Protheus.doc} CamposFixos
    Adiciona campos fixos obrigatórios nos arrays aCampos e aEstrutura conforme opção de ordenação selecionada, incluindo campos da tabela SFT (Livros Fiscais) e campos específicos para NCM ou Perfil de Operação.
    
    @type  Static Function
    @author Squad Fiscal - TOTVS
    @since 01/11/2025
    @version 12.1.2510
    @param aCampos, array, Array passado por referência que receberá os campos fixos [1]Nome, [2]Selecionado
    @param aEstrutura, array, Array passado por referência que receberá a estrutura dos campos [1]Nome, [2]Título, [3]Tipo, [4]Tamanho, [5]Decimal, [6]Origem
    @param cOpcOrdem, character, Opção de ordenação: "NCM" (adiciona FT_POSIPI) ou "PERFIL_OPER" (adiciona F23_CODIGO e F20_DESC)
    @return nil, Não retorna valor, apenas popula os arrays aCampos e aEstrutura por referência
    @obs Utiliza FWSX3Util():GetFieldStruct() para obter metadados dos campos e marca origem como "FIXO"
/*/
//-------------------------------------------------------------------
Static Function CamposFixos(aCampos, aEstrutura, cOpcOrdem)
    
    if cOpcOrdem=="NCM"
        AddCamposEstrutura(@aCampos,@aEstrutura,"FT_POSIPI","FT_POSIPI","FT_POSIPI")
    elseif cOpcOrdem=="PERFIL_OPER"
        AddCamposEstrutura(@aCampos,@aEstrutura,"F23_CODIGO","COD_OPER","CODIGO_PERFIL_OPER")

        AddCamposEstrutura(@aCampos,@aEstrutura,"F20_DESC","F20_DESC","DESC_PERFIL_OPERACAO")
    endif

    AddCamposEstrutura(@aCampos,@aEstrutura,"FT_ESTADO","FT_ESTADO","FT_ESTADO")  
    AddCamposEstrutura(@aCampos,@aEstrutura,"FT_TIPO","FT_TIPO","FT_TIPO")
    AddCamposEstrutura(@aCampos,@aEstrutura,"FT_TIPOMOV","FT_TIPOMOV","FT_TIPOMOV")
    AddCamposEstrutura(@aCampos,@aEstrutura,"FT_CFOP","FT_CFOP","FT_CFOP")  
    AddCamposEstrutura(@aCampos,@aEstrutura,"FT_CFPS","FT_CFPS","FT_CFPS")
    AddCamposEstrutura(@aCampos,@aEstrutura,"FT_CLIEFOR","FT_CLIEFOR","FT_CLIEFOR")
    AddCamposEstrutura(@aCampos,@aEstrutura,"FT_LOJA","FT_LOJA","FT_LOJA")
    AddCamposEstrutura(@aCampos,@aEstrutura,"FT_CLIENT","FT_CLIENT","FT_CLIENT")
    AddCamposEstrutura(@aCampos,@aEstrutura,"FT_CLASFIS","ORIGEM","ORIGEM")
    AddCamposEstrutura(@aCampos,@aEstrutura,"FT_VALCONT","FT_VALCONT","FT_VALCONT")
    AddCamposEstrutura(@aCampos,@aEstrutura,"FT_ESPECIE","FT_ESPECIE","FT_ESPECIE")
    AddCamposEstrutura(@aCampos,@aEstrutura,"FT_PRODUTO","FT_PRODUTO","FT_PRODUTO")
    AddCamposEstrutura(@aCampos,@aEstrutura,"FT_TES","FT_TES","FT_TES")
    
Return

/*/{Protheus.doc} AddCamposEstrutura
    Adiciona um campo fixo nos arrays de estrutura e campos utilizando as informações do dicionário de dados (SX3).
    
    @type  Static Function
    @author Squad Fiscal - TOTVS
    @since 01/11/2025
    @version 12.1.2510
    @param aCampos, array, Array passado por referência para adicionar o campo [1]Nome, [2]Selecionado (sempre .F. para campos fixos)
    @param aEstrutura, array, Array passado por referência com estrutura do campo [1]Campo, [2]Descrição, [3]Tipo, [4]Tamanho, [5]Decimal, [6]"FIXO"
    @param cCampoSX3, character, Nome do campo no dicionário SX3 para obter tipo, tamanho e decimais
    @param cCampo, character, Nome/alias do campo que será usado no array de estrutura
    @param cDescricao, character, Descrição/título do campo para exibição
    @return nil, Não retorna valor, apenas popula arrays por referência
    @obs Utiliza FWSX3Util():GetFieldStruct para obter metadados do campo. O array aSX3Info é limpo ao final para liberar memória
/*/
Static Function AddCamposEstrutura(aCampos,aEstrutura,cCampoSX3,cCampo,cDescricao)
    Local aSX3Info := FWSX3Util():GetFieldStruct(cCampoSX3) as array

    Aadd(aCampos,{cCampo,.F.})
    Aadd(aEstrutura,{cCampo, cDescricao, aSX3Info[2], aSX3Info[3], aSX3Info[4] ,"FIXO"}) 

    aSize(aSX3Info,0) //Limpa o array

Return 

//-------------------------------------------------------------------
/*/{Protheus.doc} MontaSelecao
    Processa campos marcados nos browses de seleção e adiciona nos arrays aCampos e aEstrutura conforme tipo: SX3 (campos de tabelas), IMPOSTO (impostos selecionados) ou FINAL (campo de totalizadores).
    
    @type  Static Function
    @author Squad Fiscal - TOTVS
    @since 01/11/2025
    @version 12.1.2510
    @param oObjtForm, object, Objeto FwFormBrowse contendo os registros marcados (browse ou array)
    @param cTab, character, Tipo de processamento: "SX3" (campos de tabelas), "IMPOSTO" (impostos), "FINAL" (totalizadores)
    @param aCampos, array, Array passado por referência que receberá os campos selecionados [1]Nome, [2]Selecionado
    @param aEstrutura, array, Array passado por referência que receberá estrutura dos campos [1]Campo, [2]Título, [3]Tipo, [4]Tamanho, [5]Decimal, [6]Origem
    @return nil, Não retorna valor, apenas popula arrays por referência
    @obs Para IMPOSTO: adiciona múltiplos campos por imposto (CST, alíquota, base, valor). Para SX3: percorre alias com campos marcados (OK==1)
/*/
//-------------------------------------------------------------------
Static Function MontaSelecao(oObjtForm, cTab, aCampos, aEstrutura)

    Local cAls := " " as character
    Local aAcols := {} as array
    Local nX := 0 as numeric
    Local nLen := 0 as numeric
    Local aSX3Info := {} as array

    If cTab == 'SX3'
        cAls:= oObjtForm:cAlias
        if select(cAls) > 0
        //Percorro todoas as linhas e marco/desmarco todas as linhas
            (cAls)->( DbGoTop() )
            While (cAls)->( !EOF() )
                If (cAls)->OK == 1
                    aSX3Info:= FWSX3Util():GetFieldStruct((cAls)->X3_CAMPO)
                    Aadd(aCampos,{(cAls)->X3_CAMPO,.T.}) 
                    Aadd(aEstrutura,{(cAls)->X3_CAMPO, (cAls)->X3_CAMPO, aSX3Info[2], aSX3Info[3], aSX3Info[4],"" })     
                EndIF
                (cAls)->( DbSkip() )
            EndDo

            //Volto para primeiro registro e atualizo o componente
            (cAls)->( DbGoTop() )
            FwFreeArray(aSX3Info)
        endif

    ElseIf cTab == 'IMPOSTO'

        aAcols:= aClone(oObjtForm:oData:aArray)
        if len(aAcols)>0
            nLen := len(aAcols[1])
            for nX:=1 to len(aAcols)
                if aAcols[nX][nLen] == "1" //Verifico se o campo está marcado

                    if alltrim(aAcols[nX][2]) == "ICMS"
                        AdicionaICMS(@aCampos, @aEstrutura)
                    elseif alltrim(aAcols[nX][2]) == "IPI"
                        AdicionaIPI(@aCampos, @aEstrutura)
                    elseif alltrim(aAcols[nX][2]) == "PIS_APUR"
                        AdicionaPISAPUR(@aCampos, @aEstrutura)
                    elseif alltrim(aAcols[nX][2]) == "COFINS_APUR"
                        AdicionaCOFINSAPUR(@aCampos, @aEstrutura)
                    elseif alltrim(aAcols[nX][2]) == "CSLL_APUR"
                        AdicionaCSLLAPUR(@aCampos, @aEstrutura)
                    elseif alltrim(aAcols[nX][2]) == "PIS_RETE"
                        AdicionaPISRETE(@aCampos, @aEstrutura)
                    elseif alltrim(aAcols[nX][2]) == "COFINS_RETE"
                        AdicionaCOFINSRETE(@aCampos, @aEstrutura)
                    elseif alltrim(aAcols[nX][2]) == "CSLL_RETE"
                        AdicionaCSLLRETE(@aCampos, @aEstrutura)
                    elseif alltrim(aAcols[nX][2]) == "ISS"
                        AdicionaISS(@aCampos, @aEstrutura)
                    elseif alltrim(aAcols[nX][2]) == "IRRF"
                        AdicionaIRRF(@aCampos, @aEstrutura)
                    elseif alltrim(aAcols[nX][2]) == "INSS"
                        AdicionaINSS(@aCampos, @aEstrutura)
                    endif

                endif
            next
            
            FwFreeArray(aAcols)
        endif
    ElseIf cTab == 'FINAL'
        Aadd(aCampos,{"QTD_REPETI",.F.}) 
        Aadd(aEstrutura,{"QTD_REPETI"   , "QTD_REPETICOES"                      , "N", 14, 0 ,"FIXO"})
    EndIF


Return

/*/{Protheus.doc} AdicionaICMS
    Adiciona campos relacionados ao ICMS nos arrays de estrutura e campos, incluindo CST, alíquota e valores do livro fiscal (base, valor, isento, outro, complementar, diferido).
    
    @type  Static Function
    @author Squad Fiscal - TOTVS
    @since 01/11/2025
    @version 12.1.2510
    @param aCampos, array, Array passado por referência que receberá o indicador do imposto ICMS
    @param aEstrutura, array, Array passado por referência que receberá estrutura de 10 campos do ICMS
    @return nil, Não retorna valor, apenas popula arrays por referência
    @obs Campos adicionados: ICMS_CST, ICMS_ALIQ (usa FT_ALIQICM do SX3), ICMS_LF_VB, ICMS_TES_P, ICMS_LF_V, ICMS_LF_VI, ICMS_LF_VO, ICMS_LF_CO, ICMS_LF_DI
/*/
Static Function AdicionaICMS(aCampos, aEstrutura)
    Aadd(aCampos,{"ICMS",.T.})
    Aadd(aEstrutura,{"ICMS_CST"     , "ICMS_CST"                            , "C", 2, 0 ,""})
    Aadd(aEstrutura,{"ICMS_ALIQ"    , "ICMS_ALIQUOTA"                       , "N", FWSX3Util():GetFieldStruct("FT_ALIQICM")[3], FWSX3Util():GetFieldStruct("FT_ALIQICM")[4],""})
    Aadd(aEstrutura,{"ICMS_LF_VB"   , "ICMS_LF_VLR_BASE"                    , "C", 10, 0 ,""})
    Aadd(aEstrutura,{"ICMS_TES_P"   , "ICMS_TES_PERCENTUAL_REDUCAO_BASE"    , "C", 10, 0 ,""})
    Aadd(aEstrutura,{"ICMS_LF_V"    , "ICMS_LF_VALOR"                       , "C", 10, 0 ,""})
    Aadd(aEstrutura,{"ICMS_LF_VI"   , "ICMS_LF_VALOR_ISENTO"                , "C", 10, 0 ,""})
    Aadd(aEstrutura,{"ICMS_LF_VO"   , "ICMS_LF_VALOR_OUTRO"                 , "C", 10, 0 ,""})
    Aadd(aEstrutura,{"ICMS_LF_CO"   , "ICMS_LF_VALOR_COMPLEMENTAR"          , "C", 10, 0 ,""})
    Aadd(aEstrutura,{"ICMS_LF_DI"   , "ICMS_LF_VALOR_DIFERIDO"              , "C", 10, 0 ,""})
Return

