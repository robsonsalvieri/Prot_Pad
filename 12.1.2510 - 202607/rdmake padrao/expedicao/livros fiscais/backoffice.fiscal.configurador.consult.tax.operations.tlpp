    Aadd(aEstrutura,{"COD_T_MUNI"   , "COD_TRIB_MUNICIPAL"                  , "C", FWSX3Util():GetFieldStruct("FT_TRIBMUN")[3]  , FWSX3Util():GetFieldStruct("FT_TRIBMUN")[4],""})
    Aadd(aEstrutura,{"ISS_CST"      , "ISS_CST"                             , "C", FWSX3Util():GetFieldStruct("FT_CSTISS")[3]   , FWSX3Util():GetFieldStruct("FT_CSTISS")[4] ,""})
    Aadd(aEstrutura,{"ISS_ALIQ"     , "ISS_ALIQUOTA"                        , "N", FWSX3Util():GetFieldStruct("FT_ALIQICM")[3]  , FWSX3Util():GetFieldStruct("FT_ALIQICM")[4],""})
    Aadd(aEstrutura,{"ISS_LF_VB"    , "ISS_LF_VLR_BASE"                     , "C", 10, 0 ,""})
    Aadd(aEstrutura,{"ISS_LF_V"     , "ISS_LF_VALOR"                        , "C", 10, 0 ,""})
Return

