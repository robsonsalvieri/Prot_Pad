#include "totvs.ch"

namespace backoffice.stock.averagecost.creditnote

/*/{Protheus.doc} getSF1ComplementType(ckeySF1)
retorna o valor do tipo de complemento (F1_TPCOMPL) utilizando a chave da nota fiscal de entrada para busca

@type function
@author reynaldo
@since 28.04.2026
@version 12.1.2025
@param ckeySF1, caracter, valores dos campos da chave unica da tabela SF1
@return cF1_TPCOMPL, caracter, retorno o conteudo do campo SF1->F1_TPCOMPL 

/*/
static function getSF1ComplementType(ckeySF1)
Local cF1_TPCOMPL := ""
Local aAreaSF1 := {}

	if cPaisLoc == "BRA"
		aAreaSF1 := SF1->(GetArea())
		SF1->(dbSetOrder(1))
		if SF1->(MsSeek(xFilial('SF1')+ckeySF1))
			cF1_TPCOMPL := SF1->F1_TPCOMPL
		EndIf
		restArea(aAreaSF1)
	EndIf
return cF1_TPCOMPL

/*/{Protheus.doc} IsNotaCredito( ckeySF1, cTipoNF, cF1_TPCOMPL)
Confirma se é uma nota de credito, a ser tratada no estoque

@type function
@author reynaldo
@since 28.04.2026
@version 12.1.2025
@param ckeySF1, caracter, valores dos campos da chave unica da tabela SF1
@param cTipoNF, caracter, Codigo do tipo de nota de entrada
@param cF1_TPCOMPL, caracter, Codigo do tipo de complemento. Este parametro tera o seu conteudo alterado pela funcao
@return logical, .T. se for uma nota de credito do tipo complemento 3 ou 6

/*/
function IsNotaCredito( ckeySF1, cTipoNF, cF1_TPCOMPL)
Local lRet := .F.
default cF1_TPCOMPL := ""

	if cTipoNf $ "5;6" // credito ou debito

		if Empty(cF1_TPCOMPL)
			cF1_TPCOMPL := getSF1ComplementType(ckeySF1)
		EndIf
		
		lRet := validaNotaCredito( cTipoNF, cF1_TPCOMPL)

	EndIf

return lRet

/*/{Protheus.doc} validaNotaCredito( cTipoNF, cF1_TPCOMPL)
valida se o tipo de nota e tipo de complemento é uma nota de credito valida pro estoque

@type function
@author reynaldo
@since 28.04.2026
@version 12.1.2025
@param cTipoNF, caracter, Codigo do tipo de nota de entrada
@param cF1_TPCOMPL, caracter, Codigo do tipo de complemento
@return logical, .T. se for uma nota de credito do tipo complemento 3 ou 6

/*/
function validaNotaCredito( cTipoNF, cF1_TPCOMPL)
Local lRet := .F.

	If cPaisLoc == "BRA" 
		if cTipoNf == "5" // credito
			if cF1_TPCOMPL $"3;6" // Recusa total/recusa parcial
				lRet := .T.
			endif
		EndIf
	EndIf
Return lRet

/*/{Protheus.doc} buscaNfvinc( cDOC, cSERIE, cFORNECE, cLOJA, cITEM, cTipo, cTpCompl )
busca a chave do documento de referencia (origem) do documento atual

@type function
@author reynaldo
@since 28.04.2026
@version 12.1.2025
@param cDOC, caracter, numero do documento
@param cSERIE, caracter, serie
@param cFORNECE, caracter , codigo do fornecedor
@param cLOJA, caracter, loja do fornecedor
@param cITEM, caracter,  item da nota fiscal de entrada
@param cTipo, caracter, tipo de nota fiscal de entrada
@param cTpCompl, caracter,  tipo de complemnto da nota fiscal de eentrada
@return logical, .T. se for uma nota de credito do tipo complemento 3 ou 6

/*/
function buscaNfvinc( cDOC, cSERIE, cFORNECE, cLOJA, cITEM, cTipo, cTpCompl )
local aKeyNFOrig
Local aAreaDKN := {}
Local cItemCredNF := ""
Local nValor
Local cItConv
Local nX

	if backoffice.stock.averagecost.creditnote.validanotacredito( cTipo, cTPCompl)
		aAreaDKN := DKN->(GetArea())

		cItemCredNF := cITEM
		if cTPCompl == '3'
			cItemCredNF := space(TamSX3("D1_ITEM")[1])
		EndIf
		
		DKN->(DbSetOrder(2)) // -- DKN_FILIAL+DKN_DOC+DKN_SERIE+DKN_CLIFOR+DKN_LOJA+DKN_ITEMNF+DKN_TPMOV
		if DKN->(DbSeek(fwxFilial("DKN") + cDOC+cSERIE+cFORNECE+cLOJA+cItemCredNF + "2"))

			aKeyNFOrig := {DKN->DKN_DOCREF,DKN->DKN_SERREF,DKN->DKN_ITNFRE}

			// atraves do item da SD1, descubro o item da SD2
			// Jah que ambas estão gravadas na mesma ordem
			if cTPCompl == '3'
				nValor := DecodSoma1(cItem)
				cItConv := StrZero(0,TamSX3('D2_ITEM')[1])
				For nX := 1 to nValor
					cItConv := Soma1(cItConv,TamSX3('D2_ITEM')[1])
				Next nX

				aKeyNFOrig[3] := cItConv // item da SD2

			EndIf

		endIf
		RestArea(aAreaDKN) 
	endIf
return aKeyNFOrig
