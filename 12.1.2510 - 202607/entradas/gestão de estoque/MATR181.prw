/*/
    
Function MATR181()
    Local cReport	:= "MATR181"	//Nome do Programa
    Local cAlias	:= "SB5"		//Alias da tabela
    Local cTitle	:= STR0001		//Titulo do relatório apresentado no cabeçalho
    Local cDesc		:= STR0002		//Descrição do relatório
    Local lInd		:= .T.			// Retorna Indice SIX

    //Validação de aviso/bloqueio do relatório em Release 12.1.2510 ou superiores
    If ExistFunc("VldDescRel")
	    If !VldDescRel()
	    	Return
	    EndIf
    EndIf    
    MPReport(cReport,cAlias,cTitle,cDesc,,lInd)

Return
