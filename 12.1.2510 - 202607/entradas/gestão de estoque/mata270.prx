±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ´±±
±±³ Uso      ³ Generico                                                   ³±±
±±ÀÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ±±
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß
*/
Function A270Autom(cAlias)

Local bBlNewProc := {|oCenterPanel|a270ProSel(oCenterPanel)}
Local cCadastro  := OemtoAnsi(STR0019) //"Seleção Automática do Inventário"
Local cPerg	     := "MTA270"
Local nOpca  	 := 0
Local oDlg
Local lUsaNewPrc := UsaNewPrc()

If l270Auto
	a270ProSel()
ElseIf lUsaNewPrc
	tNewProcess():New("MATA270",cCadastro,bBlNewProc,OemtoAnsi(STR0020)+OemtoAnsi(STR0021)+OemtoAnsi(STR0022)+OemtoAnsi(STR0023),cPerg)
Else
	DEFINE MSDIALOG oDlg FROM  96,4 TO 355,625 TITLE cCadastro PIXEL
	@ 18, 9 TO 99, 300 LABEL "" OF oDlg  PIXEL
	@ 29, 15 Say OemToAnsi(STR0020) SIZE 275, 10 OF oDlg PIXEL	//"Este programa ir  selecionar e gravar contagens como OK, quando houverem múltiplas contagens "
	@ 38, 15 Say OemToAnsi(STR0021) SIZE 275, 10 OF oDlg PIXEL	//"e dados de quantidade, lote e endereço estiverem iguais em contagens do mesmo produto na data. "
	@ 58, 15 Say OemToAnsi(STR0022) SIZE 255, 10 OF oDlg PIXEL	//"Nota: Será considerado apenas o estoque inventariado na data p/ seleção automática (parâmetros). "
	@ 78, 35 Say OemToAnsi(STR0023) SIZE 275, 10 OF oDlg PIXEL	//"Verifique em parâmetros a data p/ seleção automática. "

	DEFINE SBUTTON FROM 108,209 TYPE 5 ACTION Pergunte(cPerg,.T.) ENABLE OF oDlg
	DEFINE SBUTTON FROM 108,238 TYPE 1 ACTION (nOpca:=1,oDlg:End()) ENABLE OF oDlg
	DEFINE SBUTTON FROM 108,267 TYPE 2 ACTION oDlg:End() ENABLE OF oDlg
	ACTIVATE MSDIALOG oDlg
EndIf

If nOpca == 1 .And. !lUsaNewPrc
	a270ProSel()
EndIf

Return Nil


/*
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
±±ÚÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄ¿±±
±±³Fun‡…o    ³A270ProSel³ Autor ³Ricardo Berti          ³ Data ³ 24/05/08 ³±±
