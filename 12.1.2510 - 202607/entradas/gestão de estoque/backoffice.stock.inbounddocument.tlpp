#include "totvs.ch"
#include "msobject.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"

namespace backoffice.stock.inbounddocument


/*/{Protheus.doc} validateTesCreditDebit
   Valida a TES para documento de debito e credito e seus complementos no documento de entrada 
   podem movimentar o estoque ou não
   @type  Function
   @author reynaldo
   @since 10/04/2026
   @version 1.0
   @param cMovEstoque, character, Se a tes utilizada no item do documento de entrada permite (S) ou não (N) movimentar o estoque(F4_ESTOQUE)
   @param cTipoNF, character, Identifica o tipo de documento de entrada (F1_TIPO/cTipo)
   @param cComplNF, character, Identifica o tipo de complmento do documento de entrada (F1_TPCOMPL/cTpCompl)
   @return lBloqueia, logical, se para este item de nf permite ou não o uso da TES informada
   @example
   (examples)
   @see (links_or_references)
   /*/
Function validateTesCreditDebit(cMovEstoque, cTipoNF, cComplNF)
Local lBloqueia := .F.

   // 5 - Nota de debito
   // 6 - Nota de credito
   if cTipoNF $ '5/6'

      // se a TES movimenta Estoque
      if cMovEstoque == "S"

         // se movimenta estoque. As notas de debito e credito, a principio, não devem permitir movimentar estoque
         lBloqueia := .T. 

         // 5 - Nota de credito
         if cTipoNF $ '5'
            // “03=Retorno por Recusa Total na Entrega ou Por Não Localização do Destinatário na Tentativa de Entrega”
            // “06=Retorno por Recusa Parcial na Entrega”
            if cComplNF $ '3/6'
               lBloqueia := .F.
            EndIf
         endIf
      EndIf
   EndIf

return lBloqueia

/*/{Protheus.doc} isReverseFlow()
Indica se o documento de entrada subtrai o estoque, devido ser do tipo: "credito", complemento: "reducao de valores"

@type function
@author marcos pires
@since 11.06.2026
@version 12.1.2025
@param cD1_TIPO, caracter, tipo do documento de entrada (F1_TIPO)
@param cD1_TIPODOC, caracter, tipo do complemento do documento de entrada (F1_TIPO + F1_TPCOMPL)
@param cD1_FORMUL, caracter, indica se é formulario proprio (F1_FORMUL)
@return logical, indica se o documento de entrada é do tipo reverso, ou seja, subtrai o estoque

/*/
Function isReverseFlow(cD1_TIPO, cD1_TIPODOC, cD1_FORMUL) as logical
Local lRet := .F. as logical

Default cD1_TIPO    := ""
Default cD1_TIPODOC := ""
Default cD1_FORMUL  := ""

If cPaisLoc == "BRA"
	If cD1_TIPO == "5"
      If cD1_TIPODOC == "54" .And. cD1_FORMUL <> "S"
         lRet := .T.
      EndIf
	EndIf
EndIf

Return lRet

/*/{Protheus.doc} getTipoDoc()
Obtem a informacao referente ao D1_TIPODOC concatenando F1_TIPO + F1_TPCOMPL
Para casos onde a base do cliente nao possua essa informacao (legado)

@type function
@author marcos pires
@since 19.06.2026
@version 12.1.2025
@param cChvSF1, caracter, chave da SF1 referente ao indice 1
@return caracter, tipo de complemento (F1_TPO + F1_TPCOMPL)

/*/
Function getTipoDoc(cChvSF1 as character) as character
Local cTipoDoc := "" as character

Default cChvSF1 := ""

If cPaisLoc == "BRA"
   If !Empty(cChvSF1)
      If cChvSF1 == SF1->(F1_FILIAL+F1_DOC+F1_SERIE+F1_FORNECE+F1_LOJA+F1_TIPO)
         cTipoDoc := "5" + SF1->F1_TPCOMPL
      Else
         cTipoDoc := "5" + GetAdvFVal("SF1","F1_TPCOMPL", cChvSF1)
      EndIf
   EndIf
EndIf

Return cTipoDoc
