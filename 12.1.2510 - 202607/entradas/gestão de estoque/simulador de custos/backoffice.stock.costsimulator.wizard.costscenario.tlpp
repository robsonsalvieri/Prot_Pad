/*/{Protheus.doc} InsertD52
    Realiza a gravação da tabela D52 com base na stored procedure 26
    @type Function
    @author Squad Entradas
    @since 20/02/2026
    @version 12.1.2510
/*/
//----------------------------------------------------------------------------------
Static Function InsertD52(cCenario, aCCusto, cDataDe, cDataAte)
    Local aSaldos   as array
    Local cUsaGrupo := '0' as character
    Local cGrupo    := ""  as character
    Local cCTBIni   := ""  as character
    Local cCTBFim   := ""  as character
    Local cConta    := ""  as character
    Local cItemC    := ""  as character
    Local cClVlr    := ""  as character
    Local cCTB250   as character

    Local nJ        as numeric
    Local cFilDoCC  as character
    Local cCodCC    as character
    Local dIni      := SToD(cDataDe)  as date
    Local dFim      := SToD(cDataAte) as date
    Local nSldCalc  := 0 as numeric
    Local cFilD52   := FWxFilial("D52") as character
    Local nInsert   := 0 as numeric

    If SPSMigrated()
        M330Proced()
    EndIf

    cCTB250 := "CTB250"
    If FindFunction("GetSPName")
        cCTB250 := GetSPName("CTB250", "26") 
    EndIf

    DbSelectArea("D52")

    For nJ := 1 To Len(aCCusto)
        
        cFilDoCC := aCCusto[nJ][1]
        cCodCC   := aCCusto[nJ][2]
        nSldCalc := 0

        aSaldos := TCSPExec( xProcedures(cCTB250),;
                            cFilDoCC,;
                            cCodCC,;
                            Dtos(dIni),; 
                            Dtos(dFim),;
                            cUsaGrupo,; 
                            cGrupo,; 
                            cCTBIni,; 
                            cCTBFim,; 
                            cConta,; 
                            cItemC,; 
                            cClVlr,; 
                            '0')

        If ValType(aSaldos) == "A" .And. Len(aSaldos) >= 1
            nSldCalc := aSaldos[1]
        EndIf

        RecLock("D52", .T.)
        D52->D52_FILIAL := cFilD52
        D52->D52_FILORI := cFilDoCC
        D52->D52_CODCEN := cCenario
        D52->D52_CODCC  := cCodCC
        D52->D52_SLDORI := nSldCalc
        D52->D52_SLDSIM := nSldCalc
        D52->D52_VARIA  := 0
        D52->(MsUnlock())

        nInsert++

    Next nJ

Return

//----------------------------------------------------------------------------------
/*/{Protheus.doc} SetStatusD50
    Função que atualiza o status do registro do cenário
    @type Function
    @author Squad Entradas
    @since 20/02/2026
    @version 12.1.2510
/*/
//----------------------------------------------------------------------------------
Static Function SetStatusD50(cCenario, cStatus)
    Local aArea    := GetArea()
    Local aAreaD50 := D50->(GetArea())

    DbSelectArea("D50")
    D50->(DbSetOrder(1))
    
    If D50->(DbSeek(FWxFilial("D50") + PadR(cCenario, TamSx3("D50_COD")[1])))
        RecLock("D50", .F.)
        D50->D50_STATUS := cStatus
        D50->(MsUnlock())
    EndIf

    RestArea(aAreaD50)
    RestArea(aArea)
Return

//----------------------------------------------------------------------------------
/*/{Protheus.doc} InsertD58
    Realiza a gravação da tabela D58 com os dados da InputD58
    @type Function
    @author Squad Entradas
    @since 16/04/2026
    @version 12.1.2510
/*/
//----------------------------------------------------------------------------------
Static Function InsertD58(cCenario, aFiliais)
    Local oBulkD58 As Object
    Local aFields  As Array
    Local cAlias   As Character
    Local cFilD58  As Character
    Local nInsert  := 0 as Numeric
    Local aData    As Array

    cAlias := InputD58(aFiliais)
    
    cFilD58 := FWxFilial("D58")

    oBulkD58 := FWBulk():New(RetSqlName("D58"), 500)
    
    If oBulkD58:CanBulk()
        aFields := {}
        AAdd(aFields, {"D58_FILIAL"})
        AAdd(aFields, {"D58_FILORI"})
        AAdd(aFields, {"D58_CODCEN"})
        AAdd(aFields, {"D58_CODIGO"})
        AAdd(aFields, {"D58_MAOOBR"})
        AAdd(aFields, {"D58_CCUSTO"})
        AAdd(aFields, {"D58_GCUSTO"})
        oBulkD58:SetFields(aFields)

        Do While !(cAlias)->(Eof())
            
            aData := {}
            AAdd(aData, cFilD58)             
            AAdd(aData, (cAlias)->H1_FILIAL)
            AAdd(aData, cCenario)
            AAdd(aData, (cAlias)->H1_CODIGO)
            AAdd(aData, (cAlias)->H1_MAOOBRA)
            AAdd(aData, (cAlias)->H1_CCUSTO)
            AAdd(aData, (cAlias)->H1_GCCUSTO)
            If !oBulkD58:AddData(aData)
                UserException(STR0060 + ProcName(0) + ": " + oBulkD58:GetError())
            EndIf
            nInsert++
            (cAlias)->(DbSkip())
        EndDo

    EndIf

    If !oBulkD58:Close()
        UserException(STR0060 + ProcName(0) + ": " + oBulkD58:GetError())
    Endif

    If Select(cAlias) > 0
        (cAlias)->(DbCloseArea())
    EndIf

    oBulkD58:Destroy()
    oBulkD58 := Nil

Return

//----------------------------------------------------------------------------------
/*/{Protheus.doc} InputD58
    Cria a tabela temporária com os registros da SH1
    @type Function
    @author Squad Entradas
    @since 16/04/2026
    @version 12.1.2510
/*/
//----------------------------------------------------------------------------------
Static Function InputD58(aFiliais)
    Local oQuery   As Object
    Local cQuery   As Character
    Local cAliTemp As Character
    Local aFilFmt  := {} as Array
    Local nI       As Integer
    
    For nI := 1 To Len(aFiliais)
        AAdd(aFilFmt, aFiliais[nI])
    Next nI

    cQuery := " SELECT SH1.H1_FILIAL, SH1.H1_CODIGO, SH1.H1_MAOOBRA, "
    cQuery += " SH1.H1_CCUSTO, SH1.H1_GCCUSTO "
    cQuery += " FROM " + RetSqlName("SH1") + " SH1 "
    cQuery += " WHERE SH1.H1_FILIAL IN (?) "
    cQuery += "       AND SH1.D_E_L_E_T_ = ? "
    cQuery += " ORDER BY SH1.H1_FILIAL, SH1.H1_CODIGO"

    cQuery := ChangeQuery(cQuery)
    oQuery := FWExecStatement():New(cQuery)

    oQuery:SetIn(1, aFilFmt)
    oQuery:SetString(2, " ")

    cAliTemp := oQuery:OpenAlias()

    oQuery:Destroy()
    FwFreeObj(oQuery)

Return cAliTemp
