#INCLUDE "TOTVS.CH"
#INCLUDE 'tlpp-core.th'
#include "fweventviewconsts.ch"
#INCLUDE 'backoffice.stock.costsimulator.wizard.costscenario.ch'

//----------------------------------------------------------------------------------
/*/{Protheus.doc} WizESTA100
    Wizard para copia das tabelas relacionadas do cenário de custo
    @type Function
    @author Squad Entradas
    @since 20/02/2026
    @version 12.1.2510 
/*/
//----------------------------------------------------------------------------------
Function WizESTA100()
    Local oStepWiz      as object
    Local oDlg          as object
    Local oPanel        as object

    Static cAliasFil    := "" as character
    Static cAliasCTT    := "" as character
    Static cMarkFil     := "" as character
    Static cMarkCtt     := "" as character
    Static dProdDe      := CtoD("") as date
    Static dProdAte     := CtoD("") as date
    Static aFilSel      := {} as array
    Static aCttSel      := {} as array
    
    Private nWidGen     := 380 as integer
    Private nHeiGen     := 20 as integer
    Private cCodCen     := Space(TamSX3("D50_COD")[1]) as character
    Private cDescCen    := Space(TamSX3("D50_DESC")[1]) as character

    DEFINE DIALOG oDlg TITLE STR0001 PIXEL // Assistente de Criação de Cenário de Simulação

    // Define tamanho da Dialog que comportará o Wizard
    oDlg:nWidth  := 850
    oDlg:nHeight := 640

    // Define o tamanho do painel do Wizard
    oPanel:= tPanel():New(0,0,"",oDlg,,,,,,300,300)
    oPanel:Align := CONTROL_ALIGN_ALLCLIENT

    // Instancia a classe FWWizard
    oStepWiz:= FWWizardControl():New(oPanel)
    oStepWiz:ActiveUISteps()

    // Adiciona novos steps ao wizard
    AddPages(@oStepWiz,@oDlg,oPanel)
    
    ACTIVATE DIALOG oDlg CENTER

    oStepWiz:Destroy()

    // Fecha as tabelas temporárias para liberar memória do servidor
    If !Empty(cAliasFil) .And. Select(cAliasFil) > 0
        (cAliasFil)->(DbCloseArea())
    EndIf
    
    If !Empty(cAliasCTT) .And. Select(cAliasCTT) > 0
        (cAliasCTT)->(DbCloseArea())
    EndIf
    
    // Zera todas as variáveis estáticas e de controle
    cAliasFil := ""
    cAliasCTT := ""
    cMarkFil  := ""
    cMarkCtt  := ""
    dProdDe   := CtoD("")
    dProdAte  := CtoD("")
    aFilSel   := {}
    aCttSel   := {}
    cCodCen   := Space(TamSX3("D50_COD")[1])
    cDescCen  := Space(TamSX3("D50_DESC")[1])

Return

//----------------------------------------------------------------------------------
/*/{Protheus.doc} AddPages
    Cria novas paginas do wizard
    @type Function
    @author Squad Entradas
    @since 20/02/2026
    @version 12.1.2510
/*/
//----------------------------------------------------------------------------------
Static Function AddPages(oStepWiz,oDlg,oPanel)
    Local oPage1 as object
    Local oPage2 as object
    Local oPage3 as object
    Local oPage4 as object

    // Pagina 1
    oPage1 := oStepWiz:AddStep("1")
    oPage1:SetStepDescription(STR0002) // "Cenario"
    oPage1:SetConstruction({|oPanel| CriaPage1(oPanel)})
    oPage1:SetNextAction({|| ValidPage1() })
    oPage1:SetCancelAction({|| oDlg:End(), .T. })
    
    // Pagina 2
    oPage2 := oStepWiz:AddStep("2")
    oPage2:SetStepDescription(STR0003) // "Filial"
    oPage2:SetConstruction({|oPanel| CriaPage2(oPanel)})
    oPage2:SetNextAction({|| ValidPage2() })
    oPage2:SetPrevAction({|| .T. })
    oPage2:SetCancelAction({|| oDlg:End(), .T. })
    oPage2:SetPrevTitle(STR0005) // "Voltar"

    // Pagina 3
    oPage3 := oStepWiz:AddStep("3")
    oPage3:SetStepDescription(STR0039) // "Centro de Custo"
    oPage3:SetConstruction({|oPanel| CriaPage3(oPanel)})
    oPage3:SetNextAction({|| ValidPage3() })
    oPage3:SetPrevAction({|| .T. })
    oPage3:SetCancelAction({|| oDlg:End(), .T. })
    oPage3:SetPrevTitle(STR0005) // "Voltar"
    
    // Pagina 4
    oPage4 := oStepWiz:AddStep("4")
    oPage4:SetStepDescription(STR0004) // "Copia"
    oPage4:SetConstruction({|oPanel| CriaPage4(oPanel)})
    oPage4:SetNextAction({|| FinalizWiz(oDlg) })
    oPage4:SetPrevAction({|| .T. })
    oPage4:SetCancelAction({|| oDlg:End(), .T. })
    oPage4:SetPrevTitle(STR0005) // "Voltar"
    oPage4:SetNextTitle(STR0006) // "Copiar Dados"
    
    oStepWiz:Activate()
Return

//----------------------------------------------------------------------------------
/*/{Protheus.doc} CriaPage1
    Cria a Pagina 1 do Wizard
    @type Function
    @author Squad Entradas
    @since 20/02/2026
    @version 12.1.2510
/*/
//----------------------------------------------------------------------------------
Static Function CriaPage1(oPanel)
    Local oSay     as object
    Local oLayer1  as object
    Local oGetCod  as object
    Local oGetDesc as object
    Local oGetDe    as object
    Local oGetAte   as object

    oLayer1 := FWLayer():new()
    oLayer1:Init(oPanel,.F.)

    oSay := TSay():New(10,10,{|| STR0007},oPanel,,,,,,.T.,,,nWidGen,nHeiGen,,,,,,.T.) // "Bem-vindo ao Assistente de Simulação de Custos!"
    oSay := TSay():New(30,10,{|| STR0008},oPanel,,,,,,.T.,,,nWidGen,nHeiGen,,,,,,.T.) // "Utilize esta rotina para configurar a base da sua simulação. Aqui definiremos o período produtivo, as filiais e os centros de custo que serão copiados para o novo cenário."
    oSay := TSay():New(50,10,{|| STR0009},oPanel,,,,,,.T.,,,nWidGen,nHeiGen,,,,,,.T.) // "Para começar, defina um Código e uma Descrição para o cenário:"

    // Campo: Código
    oSay := TSay():New(80,10, {|| STR0010}, oPanel,,,,,,.T.,,, 40, 10,,,,,,.T.) // "Código:"
    oGetCod := TGet():New(77, 50, {|u| If(PCount()>0, cCodCen:=u, cCodCen)}, oPanel, 60, 10, PesqPict("D50","D50_COD"), {|| ValidCod(cCodCen) },,,,,, .T.,,, {|| .T.})
    // Campo: Descrição
    oSay := TSay():New(100,10, {|| STR0011}, oPanel,,,,,,.T.,,, 40, 10,,,,,,.T.) // "Descrição:"
    oGetDesc := TGet():New(97, 50, {|u| If(PCount()>0, cDescCen:=u, cDescCen)}, oPanel, 150, 10, PesqPict("D50","D50_DESC"), {|| .T.},,,,,, .T.,,, {|| .T.})

    oSay := TSay():New(130,10,{|| STR0012},oPanel,,,,,,.T.,,,nWidGen,nHeiGen,,,,,,.T.) // "Periodo de Produção: Defina o período de referência para consolidar volumes de produção,saldos contábeis e valores de compra."

    // Campo: Produção De:
    TSay():New(160, 10, {|| STR0013}, oPanel,,,,,,.T.,,, 50, 10,,,,,,.T.) // "Produção De:"
    oGetDe := TGet():New(157, 65, {|u| If(PCount()>0, dProdDe:=u, dProdDe)}, oPanel, 60, 10, "@D", {|| .T.},,,,,, .T.,,, {|| .T.})
    // Campo: Produção Até:
    TSay():New(160, 140, {|| STR0014}, oPanel,,,,,,.T.,,, 50, 10,,,,,,.T.) // "Produção Até:"
    oGetAte := TGet():New(157, 195, {|u| If(PCount()>0, dProdAte:=u, dProdAte)}, oPanel, 60, 10, "@D", {|| .T.},,,,,, .T.,,, {|| .T.})
Return

//----------------------------------------------------------------------------------
/*/{Protheus.doc} CriaPage2
    Cria a Pagina 2 do Wizard
    @type Function
    @author Squad Entradas
    @since 20/02/2026
    @version 12.1.2510
/*/
//----------------------------------------------------------------------------------
Static Function CriaPage2(oPanel)
    Local oLayer2   as object
    Local oWinTop   as object
    Local oWinFil   as object
    Local oMarkFil  as object
    Local aSeekFil  as array
  
    If Empty(cMarkFil)
        cMarkFil := GetMark()
    EndIf
    LoadFil()

    aSeekFil := {}
    AAdd(aSeekFil,{STR0020, {{"","C",FwSizeFilial(), 0, STR0020,"@!"}}, 1, .T. } ) // "Codigo"

    oLayer2 := FWLayer():new()
    oLayer2:Init(oPanel,.F.)
    
    oLayer2:AddLine('LINTOP', 15, .F.)
    oLayer2:AddLine('LINBOT', 85, .F.)
    
    oLayer2:AddCollumn('COLTOP', 100, .F., 'LINTOP')
    oLayer2:AddCollumn('COLFIL', 100, .F., 'LINBOT') 

    oWinTop := oLayer2:GetColPanel('COLTOP', 'LINTOP')

    oLayer2:AddWindow('COLFIL', 'WINFIL', STR0042, 100, .F., .F.,, 'LINBOT') // "Filiais de Origem"
    oWinFil := oLayer2:getWinPanel('COLFIL', 'WINFIL', 'LINBOT')

    TSay():New(10, 10, {|| STR0040}, oWinTop,,,,,,.T.,,, nWidGen, nHeiGen,,,,,,.T.) // "Selecione abaixo as Filiais de Origem que terão os dados copiados para o cenário:"

    oMarkFil := FWMarkBrowse():New()
    oMarkFil:SetOwner(oWinFil)
    oMarkFil:SetAlias(cAliasFil)
    oMarkFil:SetFieldMark("FIL_OK")
    oMarkFil:SetMark(cMarkFil, cAliasFil, "FIL_OK")
    oMarkFil:SetMenuDef("")
    oMarkFil:SetColumns(AddColFil())
    oMarkFil:SetSeek(.T.,aSeekFil)
    oMarkFil:DisableFilter()
    oMarkFil:DisableConfig()
    oMarkFil:DisableReport()
    oMarkFil:DisableSaveConfig()
    oMarkFil:Activate()

Return

//----------------------------------------------------------------------------------
/*/{Protheus.doc} CriaPage3
    Cria a Pagina 3 do Wizard
    @type Function
    @author Squad Entradas
    @since 20/02/2026
    @version 12.1.2510
/*/
//----------------------------------------------------------------------------------
Static Function CriaPage3(oPanel)
    Local oLayer3   as object
    Local oWinCTT   as object
    Local oMarkCTT  as object
    Local aSeekCTT  as array

    If Empty(cMarkCtt)
        cMarkCtt := GetMark()
    EndIf
    LoadCTT()

    aSeekCTT := {}
    AAdd(aSeekCTT, {STR0022, {{"", "C", TamSx3("CTT_CUSTO")[1] , 0, STR0022   , "@!"}}, 1, .T. } ) // "Codigo"
    AAdd(aSeekCTT, {STR0023, {{"", "C", TamSx3("CTT_DESC01")[1], 0, STR0023, "@!"}}, 2, .T. } ) // "Centro de Custo"

    oLayer3 := FWLayer():new()
    oLayer3:Init(oPanel,.F.)
    
    oLayer3:AddLine('LINTOP', 15, .F.)
    oLayer3:AddLine('LINBOT', 85, .F.)

    oLayer3:AddCollumn('COLTOP', 100, .F., 'LINTOP')
    oLayer3:AddCollumn('COLCTT', 100, .F., 'LINBOT')

    oWinTop := oLayer3:GetColPanel('COLTOP', 'LINTOP')

    oLayer3:AddWindow('COLCTT', 'WINCTT', STR0017, 100, .F., .F.,, 'LINBOT') // "Centros de Custo"
    oWinCTT := oLayer3:getWinPanel('COLCTT', 'WINCTT', 'LINBOT')

    TSay():New(10, 10, {|| STR0041}, oWinTop,,,,,,.T.,,, nWidGen, nHeiGen,,,,,,.T.) // "Selecione os Centros de Custo que terão os saldos copiados para o cenário:"

    oMarkCTT := FWMarkBrowse():New()
    oMarkCTT:SetOwner(oWinCTT)
    oMarkCTT:SetAlias(cAliasCTT)
    oMarkCTT:SetFieldMark("CTT_OK")
    oMarkCTT:SetMark(cMarkCtt, cAliasCTT, "CTT_OK")
    oMarkCTT:SetMenuDef("")
    oMarkCTT:SetColumns(AddColCTT())
    oMarkCTT:SetSeek(.T.,aSeekCTT)
    oMarkCTT:DisableFilter()
    oMarkCTT:DisableConfig()
    oMarkCTT:DisableReport()
    oMarkCTT:DisableSaveConfig()
    oMarkCTT:Activate()

Return

//----------------------------------------------------------------------------------
/*/{Protheus.doc} CriaPage4
    Cria a Pagina 4 do Wizard
    @type Function
    @author Squad Entradas
    @since 20/02/2026
    @version 12.1.2510
/*/
//----------------------------------------------------------------------------------
Static Function CriaPage4(oPanel)
    Local oSay       as object
    Local oLayer1    as object
    Local oSayResumo as object

    oLayer1 := FWLayer():new()
    oLayer1:Init(oPanel,.F.)

    oSay := TSay():New(10, 10, {|| STR0015}, oPanel,,,,,,.T.,,, nWidGen, nHeiGen,,,,,,.T.) // Ao finalizar, a criação do cenário e a cópia dos dados ocorrerão em segundo plano.

    oSayResumo := TSay():New(30, 10, {|| STR0016 + cValToChar(Len(aFilSel))}, oPanel,,,,,,.T., CLR_BLUE,, nWidGen, nHeiGen,,,,,,.T.) // Filiais: 
    oSayResumo := TSay():New(45, 10, {|| STR0017 + cValToChar(Len(aCttSel))}, oPanel,,,,,,.T., CLR_BLUE,, nWidGen, nHeiGen,,,,,,.T.) // Centros de Custo: 
    oSayResumo := TSay():New(60, 10, {|| STR0018 + DToC(dProdDe) + STR0019 + DToC(dProdAte)}, oPanel,,,,,,.T., CLR_BLUE,, nWidGen, nHeiGen,,,,,,.T.) // Período de Produção:   // até

Return

//----------------------------------------------------------------------------------
/*/{Protheus.doc} AddColFil
    Adiciona as colunas da filial no browser da pagina 2
    @type Function
    @author Squad Entradas
    @since 20/02/2026
    @version 12.1.2510
/*/
//----------------------------------------------------------------------------------
Static Function AddColFil()
    Local aColunas  := {} as array
    Local oColumn   as object

    oColumn := FWBrwColumn():New()
    oColumn:SetData({|| (cAliasFil)->FIL_COD })
    oColumn:SetTitle(STR0020) // Codigo
    oColumn:SetSize( FwSizeFilial() )
    AAdd(aColunas, oColumn)

    oColumn := FWBrwColumn():New()
    oColumn:SetData({|| (cAliasFil)->FIL_NOME })
    oColumn:SetTitle(STR0021) // Filial
    oColumn:SetSize(Len(SM0->M0_FILIAL))
    AAdd(aColunas, oColumn)
Return aColunas

//----------------------------------------------------------------------------------
/*/{Protheus.doc} AddColCTT
    Adiciona as colunas do centro de custo no browser da pagina 2
    @type Function
    @author Squad Entradas
    @since 20/02/2026
    @version 12.1.2510
/*/
//----------------------------------------------------------------------------------
Static Function AddColCTT()
    Local aColunas  := {} as array
    Local oColumn   as object

    oColumn := FWBrwColumn():New()
    oColumn:SetData({|| (cAliasCTT)->CTT_FILIAL }) 
    oColumn:SetTitle("Filial") 
    oColumn:SetSize( TamSx3("CTT_FILIAL")[1] )
    AAdd(aColunas, oColumn)

    oColumn := FWBrwColumn():New()
    oColumn:SetData({|| (cAliasCTT)->CTT_COD }) 
    oColumn:SetTitle(STR0022) // Codigo
    oColumn:SetSize( TamSx3("CTT_CUSTO")[1] )
    AAdd(aColunas, oColumn)

    oColumn := FWBrwColumn():New()
    oColumn:SetData({|| (cAliasCTT)->CTT_DESC01 }) 
    oColumn:SetTitle(STR0023) // Centro de Custo
    oColumn:SetSize( TamSx3("CTT_DESC01")[1] )
    AAdd(aColunas, oColumn)
Return aColunas

//----------------------------------------------------------------------------------
/*/{Protheus.doc} LoadFil
    Cria a tabela temporária com a relação de filiais utilizada na pagina 2
    @type Function
    @author Squad Entradas
    @since 23/02/2026
    @version 12.1.2510
/*/
//----------------------------------------------------------------------------------
Static Function LoadFil()
    Local oTemp     as object
    Local aCampos   := {} as array
    Local aSM0      := FWLoadSM0()
    Local nI        As Integer

    cAliasFil := GetNextAlias()

    AAdd(aCampos, {"FIL_OK"  , "C", 2, 0}) 
    AAdd(aCampos, {"FIL_COD" , "C", FwSizeFilial(cEmpAnt), 0})
    AAdd(aCampos, {"FIL_NOME", "C", Len(SM0->M0_FILIAL), 0})

    oTemp := FWTemporaryTable():New(cAliasFil)
    oTemp:SetFields(aCampos)
    oTemp:AddIndex("1", {"FIL_COD"})
    oTemp:Create()

    For nI := 1 To Len(aSM0)
        If aSM0[nI][1] == cEmpAnt
            RecLock(cAliasFil, .T.)
            (cAliasFil)->FIL_OK   := "  " 
            (cAliasFil)->FIL_COD  := aSM0[nI][2]
            (cAliasFil)->FIL_NOME := aSM0[nI][7]
            (cAliasFil)->(MsUnlock())
        EndIf
    Next nI
    
    (cAliasFil)->(DbGoTop())
Return

//----------------------------------------------------------------------------------
/*/{Protheus.doc} LoadCTT
    Cria a tabela temporária com a relação dos centros de custo (CTT) utilizado na pagina 3
    @type Function
    @author Squad Entradas
    @since 23/02/2026
    @version 12.1.2510
/*/
//----------------------------------------------------------------------------------
Static Function LoadCTT()
    Local oTemp     as object
    Local aCampos   := {} as array
    Local cQuery    as character
    Local cAlsQry   as character
    Local oQuery    as object

    cAliasCTT := GetNextAlias()

    AAdd(aCampos, {"CTT_OK"    , "C", 2, 0})
    AAdd(aCampos, {"CTT_FILIAL", "C", TamSx3("CTT_FILIAL")[1], 0})
    AAdd(aCampos, {"CTT_COD"   , "C", TamSx3("CTT_CUSTO")[1] , 0}) 
    AAdd(aCampos, {"CTT_DESC01", "C", TamSx3("CTT_DESC01")[1], 0}) 

    oTemp := FWTemporaryTable():New(cAliasCTT)
    oTemp:SetFields(aCampos)
    oTemp:AddIndex("1", {"CTT_COD"})
    oTemp:AddIndex("2", {"CTT_DESC01"})
    oTemp:Create()

    cQuery := " SELECT CTT_FILIAL, CTT_CUSTO, CTT_DESC01 "
    cQuery += " FROM " + RetSqlName("CTT") + " CTT "
    cQuery += " WHERE CTT.D_E_L_E_T_ = ? "
    cQuery += " AND CTT_BLOQ = ? "
    cQuery += " ORDER BY CTT_FILIAL "
    
    cQuery := ChangeQuery(cQuery)
    
    oQuery := FWExecStatement():New(cQuery)
    
    oQuery:SetString(1, " ")
    oQuery:SetString(2, "2")
    
    cAlsQry := oQuery:OpenAlias()

    While !(cAlsQry)->(Eof())
        
        RecLock(cAliasCTT, .T.)
        (cAliasCTT)->CTT_OK     := "  "
        (cAliasCTT)->CTT_FILIAL := (cAlsQry)->CTT_FILIAL
        (cAliasCTT)->CTT_COD    := (cAlsQry)->CTT_CUSTO
        (cAliasCTT)->CTT_DESC01 := (cAlsQry)->CTT_DESC01
        MsUnlock()
        
        (cAlsQry)->(DbSkip())
    EndDo
    
    (cAlsQry)->(DbCloseArea())
    oQuery:Destroy()
    FwFreeObj(oQuery)

    (cAliasCTT)->(DbGoTop())

Return

//----------------------------------------------------------------------------------
/*/{Protheus.doc} ValidPage1
    Validações da pagina 1 do wizard
    @type Function
    @author Squad Entradas
    @since 23/02/2026
    @version 12.1.2510
/*/
//----------------------------------------------------------------------------------
Static Function ValidPage1()

    If Empty(cCodCen)
        FWAlertInfo(STR0024, STR0025) // O campo 'Código' é de preenchimento obrigatório.
        Return .F.
    EndIf

    If Empty(cDescCen)
        FWAlertInfo(STR0026, STR0025) // O campo 'Descrição' é de preenchimento obrigatório.
        Return .F.
    EndIf

    If Empty(dProdDe) .Or. Empty(dProdAte)
        FWAlertInfo(STR0032, STR0025) // Por favor, preencha o período de produção (De / Até).
        Return .F.
    ElseIf dProdDe > dProdAte
        FWAlertInfo(STR0033, STR0025) // A data 'Produção De' não pode ser maior que a data 'Produção Até'.
        Return .F.
    EndIf

Return .T.

//----------------------------------------------------------------------------------
/*/{Protheus.doc} ValidCod
    Valida a entrada do código do cenário no wizard
    @type Function
    @author Squad Entradas
    @since 23/02/2026
    @version 12.1.2510
/*/
//----------------------------------------------------------------------------------
Static Function ValidCod(cCodigo)
    Local lRet := .T. as logical

    DbSelectArea("D50")
    D50->(DbSetOrder(1))
    
    If D50->(DbSeek(xFilial("D50") + cCodigo))
        MsgAlert(STR0027 + rtrim(cCodigo) + STR0028, STR0029) // O código ' // ' já está em uso! // Cenário já existe
        lRet := .F.
    EndIf

Return lRet

//----------------------------------------------------------------------------------
/*/{Protheus.doc} ValidPage2
    Validação da página 2 do wizard
    @type Function
    @author Squad Entradas
    @since 20/02/2026
    @version 12.1.2510
/*/
//----------------------------------------------------------------------------------
Static Function ValidPage2()
    Local lRet  := .T.
    Local aArea := GetArea()

    aFilSel := {}

    (cAliasFil)->(DbGoTop())
    While !(cAliasFil)->(Eof())
        If (cAliasFil)->FIL_OK == cMarkFil
            AAdd(aFilSel, (cAliasFil)->FIL_COD)
        EndIf
        (cAliasFil)->(DbSkip())
    EndDo

    If Len(aFilSel) == 0
        FWAlertInfo(STR0030, STR0025) // "Selecione pelo menos uma Filial de Origem"
        lRet := .F.
    EndIf

    RestArea(aArea)
Return lRet

//----------------------------------------------------------------------------------
/*/{Protheus.doc} ValidPage3
    Validação da página 3 do wizard
    @type Function
    @author Squad Entradas
    @since 20/02/2026
    @version 12.1.2510
/*/
//----------------------------------------------------------------------------------
Static Function ValidPage3()
    Local lRet  := .T.
    Local aArea := GetArea()

    aCttSel := {}

    (cAliasCTT)->(DbGoTop())
    While !(cAliasCTT)->(Eof())
        If (cAliasCTT)->CTT_OK == cMarkCtt
            AAdd(aCttSel, { (cAliasCTT)->CTT_FILIAL, (cAliasCTT)->CTT_COD, (cAliasCTT)->CTT_DESC01 })
        EndIf
        (cAliasCTT)->(DbSkip())
    EndDo

    If Len(aCttSel) == 0
        FWAlertInfo(STR0031, STR0025) // "Selecione pelo menos um Centro de Custo"
        lRet := .F.
    EndIf

    RestArea(aArea)
Return lRet

//----------------------------------------------------------------------------------
/*/{Protheus.doc} FinalizWiz
    Finaliza o wizard, valida, grava o cenário e chama o orquestrador de jobs
    @type Function
    @author Squad Entradas
    @since 20/02/2026
    @version 12.1.2510
/*/
//----------------------------------------------------------------------------------
Static Function FinalizWiz(oDlg)
    Local oTask      := Nil as object
    Local cUserCode  := RetCodUsr() as character
    Local aParSch    := {} as array 
    Local nModule    := 4 as numeric
    Local cFunction  := 'ESTA100Job' as character
    Local cEnvSched  := GetEnvServer() as character
    Local cGrCompany := FWGrpCompany() as character
    Local cFil       := FWCodFil() as character

    If !MsgYesNo(STR0035 + Trim(cCodCen) + STR0036, STR0025) // "Deseja gravar o cenário" "e processar os dados em segundo plano?" "Atenção"
        Return .F.
    EndIf

    // Grava o cenário
    DbSelectArea("D50")
    D50->(DbSetOrder(1)) // D50_FILIAL+D50_COD
    
    If !D50->(DbSeek(FWxFilial("D50") + cCodCen))
        RecLock("D50", .T.)
        D50->D50_FILIAL := FWxFilial("D50")
        D50->D50_COD    := cCodCen
        D50->D50_DESC   := cDescCen
        D50->D50_DTCAD  := dDatabase
        D50->(MsUnlock())
    EndIf

    SetStatusD50(cCodCen, "3") // Altera o status para cópia

    AAdd(aParSch, cCodCen)
    AAdd(aParSch, aFilSel)
    AAdd(aParSch, aCttSel)
    AAdd(aParSch, DToS(dProdDe))
    AAdd(aParSch, DToS(dProdAte))
    AAdd(aParSch, cEmpAnt)
    AAdd(aParSch, cFilAnt)

    oTask := totvs.framework.schedule.utils.createTask( cEnvSched,;
                                                cGrCompany,;
                                                cFil,;
                                                cFunction,;
                                                nModule,;
                                                cUserCode,;
                                                /*uParam*/,;
                                                aParSch,;
                                                /*lReuse*/;
                                                .F.,;
                                                .T.)

    If !empty(oTask:cID)
        cMessage := STR0043 + CRLF + CRLF // "Rotina inserida na fila de processamento com sucesso!"    
        cMessage += STR0044 + cFunction + CRLF // "Nome da Rotina: "   
        cMessage += STR0045 + oTask:cID + CRLF + CRLF // "ID Tarefa: "
        cMessage += STR0046
        FwAlertSuccess(cMessage, STR0047) // "Sucesso"
    EndIf
    
    oDlg:End()

    FreeObj(oTask)
    FWFreeArray(aParSch)

Return .T.

//----------------------------------------------------------------------------------
/*/{Protheus.doc} ESTA100Job
    Orquestrador dos jobs de cópia sem
    @type Function
    @author Squad Entradas
    @since 20/02/2026
    @version 12.1.2510
/*/
//----------------------------------------------------------------------------------
Function ESTA100Job(aParSch)
    Local cCenario  := "" as character
    Local aFiliais  := {} as array
    Local aCCusto   := {} as array
    Local cDataDe   := "" as character
    Local cDataAte  := "" as character
    Local cEmp      := "" as character
    Local cFil      := "" as character
    Local cFunName  := "ESTA100" as character

    Default aParSch := {}

    If Len(aParSch) > 0
        cCenario := aParSch[1]
        aFiliais := aParSch[2]
        aCCusto  := aParSch[3]
        cDataDe  := aParSch[4]
        cDataAte := aParSch[5]
        
        cEmp := aParSch[6]
        cFil := aParSch[7]
    EndIf

    if RpcSetEnv(cEmp, cFil)

        SetFunName(cFunName) // Defino o nome da função para log de processamento

        BatchProcess(STR0048, STR0051, "", { || ; // "Copia do Cenario", "Simulador de Custos"
            Processa({|| ;
                ProcRegua(7), ;
                IncProc(STR0052), ; // "Copiando Volumes de Producao"
                InsertD51(cCenario, aFiliais, cDataDe, cDataAte), ;
                IncProc(STR0053), ; // "Copiando Saldos de Centro de Custo"
                InsertD52(cCenario, aCCusto, cDataDe, cDataAte), ;
                IncProc(STR0054), ; // "Copiando Cadastro de Produtos"
                InsertD53(cCenario, aFiliais), ;
                IncProc(STR0055), ; // "Copiando Estrutura de Produtos"
                InsertD54(cCenario, aFiliais), ;
                IncProc(STR0056), ; // "Copiando Roteiro de Operacoes"
                InsertD55(cCenario, aFiliais), ;
                IncProc(STR0057), ; // "Copiando Precos de Entrada"
                InsertD57(cCenario, aFiliais), ;
                IncProc(STR0058), ; // "Copiando Recursos"
                InsertD58(cCenario, aFiliais), ;
                SetStatusD50(cCenario, "4"), ;
            }, STR0051, STR0059, .F.) ; // "Simulador de Custos" , "Processando copia de cenario"
        })

    EndIf

    RpcClearEnv()
Return

//----------------------------------------------------------------------------------
/*/{Protheus.doc} InputD51
    Cria a tabela temporária com os registros da SD3 PR0/PR1
    @type Function
    @author Squad Entradas
    @since 20/02/2026
    @version 12.1.2510
/*/
//----------------------------------------------------------------------------------
Static Function InputD51(aFiliais, cDataDe, cDataAte)
    Local oQuery   As Object
    Local cQuery   As Character
    Local cAliTemp As Character
    Local aFilFmt  := {}
    Local nI       As Integer
    
    // Formata o array de filiais
    For nI := 1 To Len(aFiliais)
        AAdd(aFilFmt, aFiliais[nI]) 
    Next nI

    cQuery := " SELECT D3_FILIAL AS FILIAL, D3_COD AS PRODUTO, SUM(D3_QUANT) AS TOTAL "
    cQuery += " FROM " + RetSqlName("SD3") + " SD3 "
    cQuery += " WHERE D3_FILIAL IN (?) "
    cQuery += " AND D3_EMISSAO BETWEEN ? AND ? "
    cQuery += " AND D3_CF IN ('PR0', 'PR1') "
    cQuery += " AND D3_ESTORNO = ? "
    cQuery += " AND D_E_L_E_T_ = ? "
    cQuery += " GROUP BY D3_FILIAL, D3_COD "
    cQuery += " ORDER BY D3_COD "

    cQuery := ChangeQuery(cQuery)
    oQuery := FWExecStatement():New(cQuery)

    oQuery:SetIn(1, aFilFmt)     
    oQuery:SetString(2, cDataDe) 
    oQuery:SetString(3, cDataAte)
    oQuery:SetString(4, " ")     
    oQuery:SetString(5, " ")     

    cAliTemp := oQuery:OpenAlias()

    oQuery:Destroy()
    FwFreeObj(oQuery)

Return cAliTemp

//----------------------------------------------------------------------------------
/*/{Protheus.doc} InsertD51
    Realiza a gravação da tabela D51 com os dados da InputD51
    @type Function
    @author Squad Entradas
    @since 20/02/2026
    @version 12.1.2510
/*/
//----------------------------------------------------------------------------------
Static Function InsertD51(cCenario, aFiliais, cDataDe, cDataAte)
    Local oBulkD51 As Object
    Local aFields  As Array
    Local cAlias   As Character
    Local cFilD51  As Character
    Local nInsert  := 0
    Local aData    As Array

    cAlias := InputD51(aFiliais, cDataDe, cDataAte)
    
    cFilD51 := FWxFilial("D51")

    oBulkD51 := FWBulk():New(RetSqlName("D51"), 500)
    
    If oBulkD51:CanBulk()
        aFields := {}
        AAdd(aFields, {"D51_FILIAL"})
        AAdd(aFields, {"D51_FILORI"})
        AAdd(aFields, {"D51_CODCEN"})
        AAdd(aFields, {"D51_COD"})
        AAdd(aFields, {"D51_VOLORI"}) 
        AAdd(aFields, {"D51_VOLSIM"})
        oBulkD51:SetFields(aFields)

        Do While !(cAlias)->(Eof())
            
            aData := {}
            AAdd(aData, cFilD51)          
            AAdd(aData, (cAlias)->FILIAL) 
            AAdd(aData, cCenario)         
            AAdd(aData, (cAlias)->PRODUTO)
            AAdd(aData, (cAlias)->TOTAL)  
            AAdd(aData, (cAlias)->TOTAL)  
            If !oBulkD51:AddData(aData)
                UserException(STR0060 + ProcName(0) + ": " + oBulkD51:GetError())
            EndIf
            nInsert++
            (cAlias)->(DbSkip())
        EndDo

    EndIf

    If !oBulkD51:Close()
        UserException(STR0060 + ProcName(0) + ": " + oBulkD51:GetError())
    Endif

    If Select(cAlias) > 0
        (cAlias)->(DbCloseArea())
    EndIf

    oBulkD51:Destroy()
    oBulkD51 := Nil

Return

//----------------------------------------------------------------------------------
/*/{Protheus.doc} InputD53
    Cria a tabela temporária com os registros da SB1/SB2
    @type Function
    @author Squad Entradas
    @since 20/02/2026
    @version 12.1.2510
/*/
//----------------------------------------------------------------------------------
Static Function InputD53(aFiliais)
    Local oQuery   As Object
    Local cQuery   As Character
    Local cAliTemp As Character
    Local aFilFmt  := {} as array
    Local nI       As Integer
    
    For nI := 1 To Len(aFiliais)
        AAdd(aFilFmt, aFiliais[nI])
    Next nI

    cQuery := " SELECT SB1.B1_FILIAL, SB1.B1_COD, SB1.B1_DESC, SB1.B1_TIPO, "
    cQuery += " SB1.B1_LOCPAD, SB1.B1_GRUPO, SB1.B1_CUSTD, "
    cQuery += " SB1.B1_OPERPAD, SB1.B1_CCCUSTO, SB1.B1_GCCUSTO, SB1.B1_QB, SB1.B1_TIPODEC, "
    cQuery += " SB2.B2_CM1, SB2.B2_CM2, SB2.B2_CM3, SB2.B2_CM4, SB2.B2_CM5 "
    cQuery += " FROM " + RetSqlName("SB1") + " SB1 "
    cQuery += " LEFT JOIN " + RetSqlName("SB2") + " SB2 ON "
    cQuery += "     SB2.B2_FILIAL = SB1.B1_FILIAL "
    cQuery += "     AND SB2.B2_COD = SB1.B1_COD "
    cQuery += "     AND SB2.B2_LOCAL = SB1.B1_LOCPAD "
    cQuery += "     AND SB2.D_E_L_E_T_ = ? "
    cQuery += " WHERE SB1.B1_FILIAL IN (?) "
    cQuery += " AND SB1.D_E_L_E_T_ = ? "
    cQuery += " ORDER BY SB1.B1_COD "

    cQuery := ChangeQuery(cQuery)
    oQuery := FWExecStatement():New(cQuery)

    oQuery:SetString(1, " ")   
    oQuery:SetIn(2, aFilFmt)   
    oQuery:SetString(3, " ")   

    cAliTemp := oQuery:OpenAlias()

    oQuery:Destroy()
    FwFreeObj(oQuery)

Return cAliTemp

