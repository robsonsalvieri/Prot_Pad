Static Function InsertD53(cCenario, aFiliais)
    Local oBulkD53 As Object
    Local aFields  As Array
    Local cAlias   As Character
    Local cFilD53  As Character
    Local nInsert  := 0
    Local aData    As Array

    cAlias := InputD53(aFiliais)
    
    cFilD53 := FWxFilial("D53")

    oBulkD53 := FWBulk():New(RetSqlName("D53"), 500)
    
    If oBulkD53:CanBulk()
        aFields := {}
        AAdd(aFields, {"D53_FILIAL"})
        AAdd(aFields, {"D53_FILORI"})
        AAdd(aFields, {"D53_CODCEN"})
        AAdd(aFields, {"D53_COD"})
        AAdd(aFields, {"D53_DESC"})
        AAdd(aFields, {"D53_TIPO"})
        AAdd(aFields, {"D53_LOCPAD"})
        AAdd(aFields, {"D53_GRUPO"})
        AAdd(aFields, {"D53_CUSTD"})
        AAdd(aFields, {"D53_ROTPAD"})
        AAdd(aFields, {"D53_CCUSTO"})
        AAdd(aFields, {"D53_GCUSTO"})
        AAdd(aFields, {"D53_QB"})
        AAdd(aFields, {"D53_TIPDEC"})
        AAdd(aFields, {"D53_CM1"})
        AAdd(aFields, {"D53_CM2"})
        AAdd(aFields, {"D53_CM3"})
        AAdd(aFields, {"D53_CM4"})
        AAdd(aFields, {"D53_CM5"})
        oBulkD53:SetFields(aFields)

        Do While !(cAlias)->(Eof())
            
            aData := {}
            AAdd(aData, cFilD53)            
            AAdd(aData, (cAlias)->B1_FILIAL)
            AAdd(aData, cCenario)           
            AAdd(aData, (cAlias)->B1_COD)   
            AAdd(aData, (cAlias)->B1_DESC)  
            AAdd(aData, (cAlias)->B1_TIPO)  
            AAdd(aData, (cAlias)->B1_LOCPAD)
            AAdd(aData, (cAlias)->B1_GRUPO) 
            AAdd(aData, (cAlias)->B1_CUSTD) 
            AAdd(aData, (cAlias)->B1_OPERPAD)
            AAdd(aData, (cAlias)->B1_CCCUSTO)
            AAdd(aData, (cAlias)->B1_GCCUSTO)
            AAdd(aData, (cAlias)->B1_QB)
            AAdd(aData, (cAlias)->B1_TIPODEC)
            AAdd(aData, (cAlias)->B2_CM1)   
            AAdd(aData, (cAlias)->B2_CM2)   
            AAdd(aData, (cAlias)->B2_CM3)   
            AAdd(aData, (cAlias)->B2_CM4)   
            AAdd(aData, (cAlias)->B2_CM5)
            If !oBulkD53:AddData(aData)
                UserException(STR0060 + ProcName(0) + ": " + oBulkD53:GetError())
            EndIf
            nInsert++
            (cAlias)->(DbSkip())
        EndDo

    EndIf

    If !oBulkD53:Close()
        UserException(STR0060 + ProcName(0) + ": " + oBulkD53:GetError())
    Endif

    If Select(cAlias) > 0
        (cAlias)->(DbCloseArea())
    EndIf

    oBulkD53:Destroy()
    oBulkD53 := Nil

Return

