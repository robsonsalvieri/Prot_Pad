#include "tlpp-core.th"
#include "totvs.ch"
#include "backoffice.stock.costsimulator.absorptiontax.ch"

/*/{Protheus.doc} AbsorptionTax
    Classe responsavel pelo calculo da taxa de absorcao
    @author Squad.Entradas
    @since 10/04/2026
    @version 1.0
    /*/
Class AbsorptionTax

    Public Data oQueryPrd  as object
    Public Data oQueryEst  as object
    Public Data oQueryRot  as object
    Public Data cCenario   as character
    Public Data cMaoObra   as character
    Public Data cTipoSetup as character

    Public Method new()
    Public Method calculate()
    Public Method deleteD56()
    Public Method sqlExec()
    Public Method insertD56()
    Public Method getProductsAndVolumes()
    Public Method getJoinFilOri()
    Public Method setLaborTime()
    Public Method getStructure()
    Public Method getResources()
    Public Method accumulateLaborTime()
    Public Method setAbsorptionTax()

EndClass

/*/{Protheus.doc} new
    Instancia a classe TaxaAbsorcao
    @author Squad.Entradas
    @since 10/04/2026
    @version 1.0
    @return self, self, instancia da classe TaxaAbsorcao
    /*/
Method new(cCenario, cMaoObra, cTipoSetup) Class AbsorptionTax

    ::cCenario   := cCenario
    ::cMaoObra   := cMaoObra
    ::cTipoSetup := cTipoSetup
    ::oQueryPrd  := Nil
    ::oQueryEst  := Nil
    ::oQueryRot  := Nil

Return self

/*/{Protheus.doc} methodName
    (long_description)
    @author user
    @since 06/05/2026
    @version version
    @param param_name, param_type, param_descr
    @return return_var, return_type, return_description
    /*/
Method calculate() Class AbsorptionTax
    Local cAliasPrd as character

    // Limpa a tabela de taxas de absorcao para o cenario
    ::deleteD56()

    // Inicializa tabela de taxas de absorcao com os centros de custo e saldos
    ::insertD56()

    // Obtem os produtos e volumes de producao do cenario
    cAliasPrd := ::getProductsAndVolumes()

    // Calcula o tempo de mao de obra por centro de custo
    ::setLaborTime(cAliasPrd)

    // Calcula a taxa de absorcao e atualiza a tabela D56
    ::setAbsorptionTax(cAliasPrd)

Return

/*/{Protheus.doc} deleteD56
    Limpa a tabela de taxas de absorcao para o cenario
    @author Squad.Entradas
    @since 07/05/2026
    @version 1.0
    /*/
Method deleteD56() Class AbsorptionTax
    Local oQueryD56 as object
    Local cQueryD56 as character
    Local cQuery    as character

    cQueryD56 := " DELETE FROM " + RetSqlName("D56")
    cQueryD56 += " WHERE D56_FILIAL = ? "
    cQueryD56 += "   AND D56_CODCEN = ? "

    oQueryD56 := FWExecStatement():New(cQueryD56)

    oQueryD56:SetString(1, FWxFilial("D56"))
    oQueryD56:SetString(2, ::cCenario)

    cQuery := oQueryD56:GetFixQuery()

    ::sqlExec(cQuery)

    oQueryD56:Destroy()
    FreeObj(oQueryD56)
    oQueryD56 := Nil

Return

/*/{Protheus.doc} sqlExec
    Executa query SQL
    @author Squad.Entradas
    @since 07/05/2026
    @version 1.0
    @param cQuery, character, query a executar
    @param lAdvpr, logical, indica chamada via ADVPR
    @return return_var, return_type, return_description
    /*/
Method sqlExec(cQuery, lAdvpr) Class AbsorptionTax
    Local cErrorSQL as character

    Default lAdvpr := .F.

    If TcSqlExec(cQuery) < 0
        cErrorSQL := TCSQLError()
        If !lAdvpr
            UserException(STR0025 + ProcName(1) + ": " + cErrorSQL) // "Erro na execução "
        EndIf
    EndIf

Return

/*/{Protheus.doc} insertD56
    Inicializa a tabela D56 com os centros de custo do cenario
    @author Squad.Entradas
    @since 10/04/2026
    @version 1.0
    /*/
Method insertD56() Class AbsorptionTax
    Local oQueryCC as object
    Local oBulkD56 as object
    Local aFields  as array
    Local aData    as array
    Local cQuery   as character
    Local lOk      as logical

    cQuery := " SELECT D52_FILORI FILORI, ' ' PRODUT, D52_CODCC CODCC, D52_SLDSIM SALDO
    cQuery += " FROM " + RetSqlName("D52") + " D52 "
    cQuery += " WHERE D52.D52_FILIAL = ? "
    cQuery += "   AND D52.D52_CODCEN = ? "
    cQuery += "   AND D52.D_E_L_E_T_ = ? "

    oQueryCC := FWExecStatement():New(cQuery)

    oQueryCC:SetString(1, FWxFilial("D52"))
    oQueryCC:SetString(2, ::cCenario)
    oQueryCC:SetString(3, " ")

    cAliasCC := oQueryCC:OpenAlias()

    oBulkD56 := FWBulk():New(RetSQLName("D56"), 500)

    lCanBulkD56 := oBulkD56:CanBulk()

    If lCanBulkD56
        aFields := {}
        aAdd(aFields, {"D56_FILIAL"})
        aAdd(aFields, {"D56_FILORI"})
        aAdd(aFields, {"D56_CODCEN"})
        aAdd(aFields, {"D56_PRODUT"})
        aAdd(aFields, {"D56_CODCC"})
        aAdd(aFields, {"D56_HORAS"})
        aAdd(aFields, {"D56_TOTAL"})
        aAdd(aFields, {"D56_TAXA"})
        oBulkD56:SetFields(aFields)
    EndIf

    While (cAliasCC)->(!Eof())
        If lCanBulkD56
            aData := {}
            aAdd(aData, FWxFilial("D52"))
            aAdd(aData, (cAliasCC)->FILORI)
            aAdd(aData, ::cCenario)
            aAdd(aData, (cAliasCC)->PRODUT)
            aAdd(aData, (cAliasCC)->CODCC)
            aAdd(aData, 0)
            aAdd(aData, (cAliasCC)->SALDO)
            aAdd(aData, 0)
            lOk := oBulkD56:AddData(aData)
            If !lOk
                UserException(STR0025 + ProcName(0) + ": " + oBulkD56:GetError()) // "Erro na execução "
            EndIf
        EndIf

        (cAliasCC)->(DbSkip())
    End

    (cAliasCC)->(DbCloseArea())

    oQueryCC:Destroy()
    FreeObj(oQueryCC)
    oQueryCC := Nil

    If lCanBulkD56
        If !oBulkD56:Close()
            UserException(STR0025 + ProcName(0) + ": " + oBulkD56:GetError()) // "Erro na execução "
        EndIf
        oBulkD56:Destroy()
        FreeObj(oBulkD56)
        oBulkD56 := Nil
    EndIf

    aSize(aFields, 0)
    aFields := Nil

    aSize(aData, 0)
    aData := Nil

Return

/*/{Protheus.doc} getProductsAndVolumes
    Seleciona produtos e seus volumes de producao para o cenario
    @author Squad.Entradas
    @since 22/04/2026
    @version 1.0
    @return cAliasPrd, character, alias dos produtos
    /*/
Method getProductsAndVolumes() Class AbsorptionTax
    Local cQuery      as character
    Local cJoinString as character
    Local cAliasPrd   as character

    cQuery := " SELECT D51.D51_COD COD, SUM(D51.D51_VOLSIM) VOLUME, "
    cQuery += " D53.D53_ROTPAD ROTEIRO "
    cQuery += " FROM " + RetSqlName("D51") + " D51 "
    cQuery += " INNER JOIN " + RetSqlName("D53") + " D53 "
    cQuery += "     ON  D53.D53_FILIAL = ? AND "
    cJoinString := ::getJoinFilOri("SB1", "SD3", "D53", "D51")
    cQuery += cJoinString
    cQuery += "     AND D53.D53_CODCEN = D51.D51_CODCEN "
    cQuery += "     AND D53.D53_COD    = D51.D51_COD "
    cQuery += "     AND D53.D_E_L_E_T_ = ? "
    cQuery += " WHERE D51.D51_FILIAL = ? "
    cQuery += "   AND D51.D51_CODCEN = ? "
    cQuery += "   AND D51.D_E_L_E_T_ = ? "
    cQuery += " GROUP BY D51.D51_COD, D53.D53_ROTPAD "

    ::oQueryPrd := FWExecStatement():New(cQuery)

    ::oQueryPrd:SetString(1, FWxFilial("D53"))
    ::oQueryPrd:SetString(2, " ")
    ::oQueryPrd:SetString(3, FWxFilial("D51"))
    ::oQueryPrd:SetString(4, ::cCenario)
    ::oQueryPrd:SetString(5, " ")

    cAliasPrd := ::oQueryPrd:OpenAlias()

Return cAliasPrd

/*/{Protheus.doc} getJoinFilOri
    (long_description)
    @author Squad.Entradas
    @since 07/05/2026
    @version 1.0
    @param cTabOri1, character, tabela original 1
    @param cTabOri2, character, tabela original 2
    @param cTabDest1, character, tabela destino 1
    @param cTabDest2, character, tabela destino 2
    @return cJoin, character, join formatado para as tabelas do cenario
    /*/
Method getJoinFilOri(cTabOri1, cTabOri2, cTabDest1, cTabDest2) Class AbsorptionTax
    Local cJoin     as character
    Local cStrOri1  as character
    Local cStrOri2  as character
    Local cStrDest1 as character
    Local cStrDest2 as character

    cJoin := FwJoinFilial(cTabOri1, cTabOri2)

    cStrDest1 := cTabDest1 + "." + cTabDest1 + "_FILORI"
    cStrDest2 := cTabDest2 + "." + cTabDest2 + "_FILORI"

    // Caso o prefixo do campo FILIAL tenha 2 digitos
    cStrOri1 := cTabOri1 + "." + SubStr(cTabOri1, 2, 2) + "_FILIAL"
    cJoin := StrTran(cJoin, cStrOri1, cStrDest1)
    cStrOri2 := cTabOri2 + "." + SubStr(cTabOri2, 2, 2) + "_FILIAL"
    cJoin := StrTran(cJoin, cStrOri2, cStrDest2)

    // Caso o prefixo do campo FILIAL tenha 3 digitos
    cStrOri1 := cTabOri1 + "." + cTabOri1 + "_FILIAL"
    cJoin := StrTran(cJoin, cStrOri1, cStrDest1)
    cStrOri2 := cTabOri2 + "." + cTabOri2 + "_FILIAL"
    cJoin := StrTran(cJoin, cStrOri2, cStrDest2)

Return cJoin

/*/{Protheus.doc} setLaborTime
    Define o tempo de mao de obra por centro de custo
    @since 06/05/2026
    @version 1.0
    @param cAliasPrd, character, Alias dos produtos
    /*/
Method setLaborTime(cAliasPrd) Class AbsorptionTax
    Local cAliasEst  as character
    Local cUnidMod   as character
    Local cFixVar    as character
    Local cCodCC     as character
    Local cAliasRot  as character
    Local cRoteiro   as character
    Local cProdMod   as character
    Local nQuant     as numeric
    Local nG1Quant   as numeric
    Local nQtdCampo  as numeric
    Local nQuantItem as numeric
    Local nQtdPerda  as numeric
    Local nQBase     as numeric
    Local nQtdBase   as numeric
    Local nQuantDec  as numeric
    Local nDecimal   as numeric
    Local nTamCC     as numeric
    Local nLotePad   as numeric
    Local nTempoPad  as numeric
    Local nMaoObra   as numeric
    Local nTempSetup as numeric
    Local nTempoProp as numeric
    Local nTempoTot  as numeric
    Local nTemp      as numeric
    Local nQuantAloc as numeric
    Local nQtdRest   as numeric

    Private cTipoTemp := SuperGetMV("MV_TPHR", .F., "C")

    // Inicializa variaveis
    cAliasEst  := ""
    cUnidMod   := SuperGetMV("MV_UNIDMOD", .F., "H")
    cFixVar    := ""
    cCodCC     := ""
    nQuant     := 0
    nG1Quant   := 0
    nQtdCampo  := 0
    nQuantItem := 0
    nQtdPerda  := 0
    nQBase     := 0
    nQtdBase   := 0
    nQuantDec  := 0
    nDecimal   := TamSX3("D54_QUANT")[2]
    nTamCC     := TamSX3("CTT_CUSTO")[1]
    cAliasRot  := ""
    cRoteiro   := ""
    nLotePad   := 0
    nTempoPad  := 0
    nMaoObra   := 0
    nTempSetup := 0
    nTempoProp := 0
    nTempoTot  := 0
    nTemp      := 0
    nQuantAloc := 0
    nQtdRest   := 0

    While (cAliasPrd)->(!Eof())

        // Volume de producao
        nQuant := (cAliasPrd)->VOLUME

        DbSelectArea("D56")
        DbSetOrder(2) // D56_FILIAL+D56_FILORI+D56_CODCEN+D56_CODCC

        If ::cMaoObra == "1" .Or. ::cMaoObra == "3" // Considera mao de obra da estrutura ou ambos

            // Obtem a estrutura do produto
            cAliasEst := ::getStructure((cAliasPrd)->COD)

            While (cAliasEst)->(!Eof())

                If IsProdMod((cAliasEst)->COMP)

                    nG1Quant  := (cAliasEst)->QUANT
                    nQtdCampo := (cAliasEst)->QUANT
                    cFixVar   := (cAliasEst)->FIXVAR
                    nQtdPerda := (cAliasEst)->PERDA
                    nQBase    := (cAliasEst)->QB

                    // Tipo de hora (Normal ou Centesimal)
                    If cTipoTemp == "N"
                        nG1Quant := Int(nG1Quant)
                        nG1Quant += ((nQtdCampo - nG1Quant) / 60) * 100
                    EndIf

                    // Quantidade fixa ou variavel
                    If cFixVar $ " V"
                        // Unidade de medida da mao de obra. H = Horas por peca / P = Pecas por hora
                        If cUnidMod != "H"
                            nQuantItem := ((nQuant / nG1Quant) / (100 - nQtdPerda)) * 100
                        Else
                            nQuantItem := ((nQuant * nG1Quant) / (100 - nQtdPerda)) * 100
                        EndIf
                        If nQBase <= 0
                            nQtdBase := 1
                        Else
                            nQtdBase := nQBase
                        EndIf
                        nQuantItem := nQuantItem / nQtdBase
                    Else
                        If cUnidMod != "H"
                            nQuantItem := (nG1Quant / (100 - nQtdPerda)) * 100
                        Else
                            nQuantItem := (nG1Quant / (100 - nQtdPerda)) * 100
                        EndIf
                    EndIf

                    nQuantItem := Round(nQuantItem, nDecimal)

                    Do Case
                        Case (cAliasEst)->TIPODEC == "A"
                            nTemp := Round(nQuantItem, 0)
                        Case (cAliasEst)->TIPODEC == "I"
                            If (nQuantItem - Int(nQuantItem)) > 0
                                nQuantDec := 1
                            Else
                                nQuantDec := 0
                            EndIf
                            nTemp := Int(nQuantItem) + nQuantDec
                        Case (cAliasEst)->TIPODEC == "T"
                            nTemp := Int(nQuantItem)
                        OtherWise
                            nTemp := nQuantItem
                    EndCase

                    // Recupera o codigo do centro de custo da mao de obra
                    If Upper(SubStr((cAliasEst)->COMP, 1, 3)) == "MOD"
                        cCodCC := SubStr((cAliasEst)->COMP, 4, nTamCC)
                    Else
                        cCodCC := (cAliasEst)->CCUSTO
                    EndIf

                    // Acumula o tempo de mao de obra por centro de custo
                    ::accumulateLaborTime((cAliasEst)->FILORI, (cAliasEst)->COMP, cCodCC, nTemp)

                EndIf

                (cAliasEst)->(DbSkip())
            End

            (cAliasEst)->(DbCloseArea())
            If ::oQueryEst != Nil
                ::oQueryEst:Destroy()
                FreeObj(::oQueryEst)
            EndIf
        EndIf

        If ::cMaoObra == "2" .Or. ::cMaoObra == "3" // Considera mao de obra do roteiro de operacoes ou ambos

            // Roteiro de operacoes padrao
            cRoteiro := (cAliasPrd)->ROTEIRO
            If Empty(cRoteiro)
                cRoteiro := "01"
            EndIf

            // Obtem os recursos do roteiro de operacoes do produto
            cAliasRot := ::getResources((cAliasPrd)->COD, cRoteiro)

            While (cAliasRot)->(!Eof())

                // Lote padrao
                If (cAliasRot)->LOTPAD == 0
                    nLotePad := 1
                Else
                    nLotePad := (cAliasRot)->LOTPAD
                EndIf

                // Tempo padrao
                If (cAliasRot)->TEMPAD == 0
                    nTempoPad := 1
                Else
                    nTempoPad := A690HoraCt((cAliasRot)->TEMPAD)
                EndIf

                // Mao de obra (Eficiencia) 
                If Empty((cAliasRot)->MAOOBRA)
                    nMaoObra := 1
                Else
                    nMaoObra := (cAliasRot)->MAOOBRA
                EndIf

                If (cAliasRot)->TPOPER $ " 1" // Normal
                    // Tempo de setup
                    nTempSetup := A690HoraCt((cAliasRot)->SETUP)

                    // Sobre o tempo de setup
                    If ::cTipoSetup == "3" // Soma tempo proporcional
                        nTempoProp := nTempSetup / nLotePad
                    EndIf
                    If ::cTipoSetup == "2" // Soma tempo total
                        nTempoTot  := nTempSetup
                    EndIf

                    nTemp := Round((nQuant * (nTempoProp + nTempoPad / nLotePad) + nTempoTot ), 5)
                    If (cAliasRot)->MAOOBRA # 0
                        nTemp := Round(nTemp / (cAliasRot)->MAOOBRA, 5)
                    EndIf
                ElseIf (cAliasRot)->TPOPER == "4" // Tempo minimo
                    nQuantAloc := nQuant % nLotePad
                    If nQuantAloc > 0
                        nQtdRest := nLotePad - nQuantAloc
                    EndIf
                    nQuantAloc := Int(nQuant) + nQtdRest
                    nTemp := Round(nQuantAloc * (nTempoPad / nLotePad), 5)
                    If (cAliasRot)->MAOOBRA # 0
                        nTemp := Round(nTemp / (cAliasRot)->MAOOBRA, 5)
                    EndIf
                ElseIf (cAliasRot)->TPOPER == "2" .Or. (cAliasRot)->TPOPER == "3" // Tempo fixo ou ilimitada
                    nTemp := nTempoPad
                EndIf
                nTemp := nTemp * nMaoObra

                cProdMod := APrModRec((cAliasRot)->CODIGO)

                // Acumula o tempo de mao de obra por centro de custo
                ::accumulateLaborTime((cAliasRot)->FILORI, cProdMod, (cAliasRot)->CCUSTO, nTemp)

                (cAliasRot)->(DbSkip())
            End

            (cAliasRot)->(DbCloseArea())
            If ::oQueryRot != Nil
                ::oQueryRot:Destroy()
                FreeObj(::oQueryRot)
            EndIf

        EndIf

        (cAliasPrd)->(DbSkip())
    End

    (cAliasPrd)->(DbCloseArea())
    If ::oQueryPrd != Nil
        ::oQueryPrd:Destroy()
        FreeObj(::oQueryPrd)
    EndIf

Return

/*/{Protheus.doc} getStructure
    Obtem a estrutura do produto
    @since 06/05/2026
    @version 1.0
    @param cProduto, character, Codigo do produto
    @return cAliasEst, character, Alias da estrutura do produto
    /*/
Method getStructure(cProduto) Class AbsorptionTax
    Local cQuery      as character
    Local cJoinString as character
    Local cAliasEst   as character

    If ::oQueryEst == Nil
        cQuery := " SELECT D54.D54_FILORI FILORI, D54.D54_COMP COMP, D54.D54_QUANT QUANT, D54.D54_FIXVAR FIXVAR, D54.D54_PERDA PERDA, "
        cQuery += " D53.D53_QB QB, D53.D53_TIPDEC TIPODEC, D53.D53_CCUSTO CCUSTO "
        cQuery += " FROM " + RetSqlName("D54") + " D54 "
        cQuery += " INNER JOIN " + RetSqlName("D53") + " D53 "
        cQuery += "     ON  D53.D53_FILIAL = ? AND "
        cJoinString := ::getJoinFilOri("SB1", "SG2", "D53", "D54")
        cQuery += cJoinString
        cQuery += "     AND D53.D53_CODCEN = D54.D54_CODCEN "
        cQuery += "     AND D53.D53_COD    = D54.D54_COMP "
        cQuery += "     AND D53.D_E_L_E_T_ = ? "
        cQuery += " WHERE D54.D54_FILIAL = ? "
        cQuery += "   AND D54.D54_CODCEN = ? "
        cQuery += "   AND D54.D54_COD    = ? "
        cQuery += "   AND D54.D_E_L_E_T_ = ? "

        ::oQueryEst := FWExecStatement():New(cQuery)
    EndIf

    ::oQueryEst:SetString(1, FWxFilial("D53"))
    ::oQueryEst:SetString(2, " ")
    ::oQueryEst:SetString(3, FWxFilial("D54"))
    ::oQueryEst:SetString(4, ::cCenario)
    ::oQueryEst:SetString(5, cProduto)
    ::oQueryEst:SetString(6, " ")

    cAliasEst := ::oQueryEst:OpenAlias()

Return cAliasEst

/*/{Protheus.doc} getResources
    Obtem os recursos do roteiro de operacoes do produto
    @since 06/05/2026
    @version 1.0
    @param cProduto, character, Codigo do produto
    @param cRoteiro, character, Codigo do roteiro
    @return cAliasRot, character, Alias dos roteiros e recursos
    /*/
Method getResources(cProduto, cRoteiro) Class AbsorptionTax
    Local cQuery      as character
    Local cJoinString as character
    Local cAliasRot   as character

    If ::oQueryRot == Nil
        cQuery := " SELECT D55.D55_TPOPER TPOPER, D55.D55_SETUP SETUP, D55.D55_LOTPAD LOTPAD, D55.D55_TEMPAD TEMPAD, "
        cQuery += " D58.D58_CODIGO CODIGO, D58.D58_MAOOBR MAOOBRA, D58.D58_CCUSTO CCUSTO, "
        cQuery += " D52.D52_FILORI FILORI "
        cQuery += " FROM " + RetSqlName("D55") + " D55 "
        cQuery += " INNER JOIN " + RetSqlName("D58") + " D58 "
        cQuery += "     ON  D58.D58_FILIAL = ? AND "
        cJoinString := ::getJoinFilOri("SH1", "SG2", "D58", "D55")
        cQuery += cJoinString
        cQuery += "     AND D58.D58_CODCEN = D55.D55_CODCEN "
        cQuery += "     AND D58.D58_CODIGO = D55.D55_RECURS "
        cQuery += "     AND D58.D_E_L_E_T_ = ? "
        cQuery += " INNER JOIN " + RetSqlName("D52") + " D52 "
        cQuery += "     ON  D52.D52_FILIAL = ? AND "
        cJoinString := ::getJoinFilOri("CTT", "SH1", "D52", "D58")
        cQuery += cJoinString
        cQuery += "     AND D52.D52_CODCEN = D58.D58_CODCEN "
        cQuery += "     AND D52.D52_CODCC  = D58.D58_CCUSTO "
        cQuery += "     AND D52.D_E_L_E_T_ = ? "
        cQuery += " WHERE D55.D55_FILIAL = ? "
        cQuery += "   AND D55.D55_CODCEN = ? "
        cQuery += "   AND D55.D55_PRODUT = ? "
        cQuery += "   AND D55.D55_CODIGO = ? "
        cQuery += "   AND D55.D_E_L_E_T_ = ? "

        ::oQueryRot := FWExecStatement():New(cQuery)
    EndIf

    ::oQueryRot:SetString(1, FWxFilial("D58"))
    ::oQueryRot:SetString(2, " ")
    ::oQueryRot:SetString(3, FWxFilial("D52"))
    ::oQueryRot:SetString(4, " ")
    ::oQueryRot:SetString(5, FWxFilial("D55"))
    ::oQueryRot:SetString(6, ::cCenario)
    ::oQueryRot:SetString(7, cProduto)
    ::oQueryRot:SetString(8, cRoteiro)
    ::oQueryRot:SetString(9, " ")

    cAliasRot := ::oQueryRot:OpenAlias()

Return cAliasRot

/*/{Protheus.doc} accumulateLaborTime
    Acumula o tempo de mao de obra por centro de custo
    @author Squad.Entradas
    @since 06/05/2026
    @version 1.0
    @param cFilOri, character, filial origem
    @param cProduto, character, cOdigo do produto
    @param cCCusto, character, centro de custo
    @param nTemp, numeric, tempo de mao de obra
    /*/
Method accumulateLaborTime(cFilOri, cProduto, cCCusto, nTemp) Class AbsorptionTax
    Local nAccumulated as numeric

    If D56->(DbSeek(FWxFilial("D56") + cFilOri + ::cCenario + cCCusto))
        nAccumulated := D56->D56_HORAS + nTemp
        RecLock("D56", .F.)
        D56->D56_HORAS := nAccumulated
        D56->D56_PRODUT := cProduto
        D56->(MsUnlock())
    EndIf

Return

/*/{Protheus.doc} setAbsorptionTax
    Calcula a taxa de absorcao e atualiza a tabela D56
    @author Squad.Entradas
    @since 07/05/2026
    @version 1.0
    /*/
Method setAbsorptionTax() Class AbsorptionTax
    Local oQueryTax as object
    Local cQuery    as character
    Local cAliasTax as character

    cQuery := " SELECT D56.D56_HORAS HORAS, D56.D56_TOTAL TOTAL, D56.R_E_C_N_O_ RECNO
    cQuery += " FROM " + RetSqlName("D56") + " D56 "
    cQuery += " WHERE D56.D56_FILIAL = ? "
    cQuery += "   AND D56.D56_CODCEN = ? "
    cQuery += "   AND D56.D_E_L_E_T_ = ? "

    oQueryTax := FWExecStatement():New(cQuery)

    oQueryTax:SetString(1, FWxFilial("D56"))
    oQueryTax:SetString(2, ::cCenario)
    oQueryTax:SetString(3, " ")

    cAliasTax := oQueryTax:OpenAlias()

    While (cAliasTax)->(!Eof())
        nTotal := (cAliasTax)->TOTAL
        nHoras := (cAliasTax)->HORAS
        If nHoras > 0
            nTaxa := Round(nTotal / nHoras, 5)
            D56->(DbGoTo((cAliasTax)->RECNO))
            RecLock("D56", .F.)
            D56->D56_TAXA := nTaxa
            D56->(MsUnlock())
        EndIf

        (cAliasTax)->(DbSkip())
    End

    (cAliasTax)->(DbCloseArea())

    oQueryTax:Destroy()
    FreeObj(oQueryTax)
    oQueryTax := Nil

Return

/*/{Protheus.doc} EST100Taxa
    Recalcula taxas de absorcao
    @type  Function
    @author Squad.Entradas
    @since 16/04/2026
    @version 1.0
    /*/
Function EST100Taxa()
    Local oTask      as object
    Local aParDialog as array
    Local aParSched  as array 
    Local nModule    as numeric
    Local cCodCen    as character
    Local cMaoObra   as character
    Local cTipoSetup as character
    Local cFunction  as character
    Local cCodUser   as character
    Local cMessage   as character

    oTask      := Nil
    aParSched  := {}

    // Modal para confirmacao e entrada de parametros do recalculo das taxas de absorcao
    aParDialog := EST100Diag()

    If aParDialog[1] // Confirmacao da modal

        If MsgYesNo(STR0002, STR0001) // "O recálculo das taxas de absorção será processado em segundo plano. Durante o processamento, o cenário de custo ficará bloqueado para novas simulações. Deseja prosseguir?" , ""Atenção"

            nModule    := 4
            cCodCen    := D50->D50_COD
            cMaoObra    := aParDialog[2]
            cTipoSetup  := aParDialog[3]
            cFunction  := "EST100JTax"
            cCodUser   := RetCodUsr()

            aAdd(aParSched, cCodCen)
            aAdd(aParSched, cMaoObra)
            aAdd(aParSched, cTipoSetup)

            // Cria tarefa pendente de execucao na fila do Schedule
            oTask := totvs.framework.schedule.utils.createTask(/*cEnvironment*/, /*cEmpAnt*/, /*cFilAnt*/, cFunction, nModule, cCodUser, , aParSched)

            If !Empty(oTask:cID)
                EST100Stat(cCodCen, "5") // Altera o status para Recalculando taxas
                cMessage := STR0003 + CRLF + CRLF // "Rotina inserida na fila de processamento com sucesso!"
                cMessage += STR0004 + cFunction + CRLF // "Nome da Rotina: "
                cMessage += STR0005 + oTask:cID + CRLF + CRLF // "ID Tarefa: "
                cMessage += STR0006 // "Status: Concluído"
                FwAlertSuccess(cMessage, STR0007) // "Sucesso"
            EndIf
        EndIf
    EndIf

    FreeObj(oTask)
    FWFreeArray(aParDialog)
    FWFreeArray(aParSched)

Return

/*/{Protheus.doc} EST100Stat
    Atualiza status do cenario de custo
    @type  Function
    @author Squad.Entradas
    @since 13/05/2026
    @version 1.0
    @param cCenario, character, codigo do cenario de custo
    @param cStatus, character, novo status do cenario de custo
    /*/
Function EST100Stat(cCenario, cStatus)
    Local aArea    := GetArea()
    Local aAreaD50 := D50->(GetArea())

    DbSelectArea("D50")
    D50->(DbSetOrder(1))
    
    If D50->(DbSeek(FWxFilial("D50") + PadR(cCenario, TamSx3("D50_COD")[1])))
        RecLock("D50", .F.)
        D50->D50_STATUS := cStatus
        D50->(MsUnlock())
    EndIf

    RestArea(aAreaD50)
    RestArea(aArea)
Return

/*/{Protheus.doc} EST100JTax
    Job para recalculo das taxas de absorcao
    @type  Function
    @author Squad.Entradas
    @since 16/04/2026
    @version 1.0
    @param aParSched, array, parametros da schedule
    @return Nil
    /*/
Function EST100JTax(aParSched)
    Local oAbsorptionTax as object
    Local cCodCen   as character
    Local cMaoObra   as character
    Local cTipoSetup as character
    Local cEmp      as character
    Local cFil      as character
    Local cFunName  as character

    Default aParSched := {}

    If Len(aParSched) > 0
        cCodCen   := aParSched[1]
        cMaoObra   := aParSched[2]
        cTipoSetup := aParSched[3]
        cEmp      := aParSched[4]
        cFil      := aParSched[5]
        cFunName  := "ESTA100"
        oAbsorptionTax := AbsorptionTax():new(cCodCen, cMaoObra, cTipoSetup)

        If RpcSetEnv(cEmp, cFil)
            RPCSetType(3)

            SetFunName(cFunName) // Nome da funcao para log de processamento

            BatchProcess(STR0008, STR0009, "", { ||; // "Taxas de absorcao", "Execucao do recalculo das Taxas de Absorcao"
                Processa({||;
                    ProcRegua(1),;
                    IncProc(STR0010),; // "Processando recálculo das Taxas de Absorcao"
                    oAbsorptionTax:calculate(),;
                    EST100Stat(cCodCen, "4");
                }, STR0011, STR0010, .F.); // , "Processando recálculo das Taxas de Absorcao"
            })

            RpcClearEnv()
        EndIf

    EndIf

    FreeObj(oAbsorptionTax)
    oAbsorptionTax := Nil

Return

/*/{Protheus.doc} EST100Diag
    Cria um FWDialogModal para entrada dos dados necessarios para
    o calculo das taxas de absorcao
    @type  Function
    @author Squad.Entradas
    @since 07/05/2026
    @version 1.0
    @return return_var, return_type, return_description
    @see https://tdn.totvs.com/display/public/framework/FwDialogModal
    /*/
Static Function EST100Diag()
    Local oModal     as object
    Local oContainer as object
    Local oFontTit   as object
    Local oFontSub   as object
    Local oSayTit    as object
    Local oSaySub    as object
    Local oSayMaoObr as object
    Local oCboMaoObr as object
    Local oSaySetup  as object
    Local oCboSetup  as object
    Local oSayHelp   as object
    Local aOptMaoObr as array
    Local aOptSetup  as array
    Local cMaoObra    as character
    Local aRet       as array
    Local cTipoSetup  as character
    Local lOk        as logical
 
    aOptMaoObr := {STR0012, STR0013, STR0014} // "1 - Da Estrutura", "2 - Roteiro de Operacoes", "3 - Ambos"
    aOptSetup  := {STR0015, STR0016, STR0017} // "1 - Ignora", "2 - Soma Tempo Total", "3 - Soma Tempo Proporcional"
    aRet       := {}
    cMaoObra    := "1"
    cTipoSetup  := "1"
    lOk        := .T.

    oModal := FWDialogModal():New()
    oModal:SetSize(240, 240)
    oModal:SetEscClose(.T.)
    oModal:SetBackground(.T.)
    oModal:CreateDialog()
    oContainer := TPanel():New(,,, oModal:GetPanelMain())
    oContainer:Align := CONTROL_ALIGN_ALLCLIENT

    // Titulo
    oSayTit := TSay():New(10, 15, {|| STR0018}, oContainer, , , , , , .T., , , 150, 12, , , , , , .T.) // "Recalcular taxas de absorção"
    oFontTit := TFont():New("Arial", , -16, .T.)
    oSayTit:oFont := oFontTit
    // Subtitulo
    oSaySub := TSay():New(25, 15, {|| STR0019}, oContainer, , , , , , .T., , , 200, 10, , , , , , .T.) // "Informe os parâmetros para efetuar o recálculo das taxas de absorção."
    oFontSub := TFont():New("Arial", , -12, .F.)
    oSaySub:oFont := oFontSub
    oSaySub:nClrText := CLR_GRAY
    // Considera mao de obra
    oSayMaoObr := TSay():New(65, 15, {|| STR0020}, oContainer, , , , , , .T., , , 80, 10, , , , , , .T.) // "Considerar mão de obra:"
    oCboMaoObr := TComboBox():New(62, 90, {|x| IIf(PCount()==0, cMaoObra, cMaoObra := x)}, aOptMaoObr, 105, 10, oContainer, , , , , , .T.)
    oCboMaoObr:bChange := {|| If(Left(cMaoObra, 1) == "1", oCboSetup:Disable(), oCboSetup:Enable())}
    // Tempo de Setup
    oSaySetup := TSay():New(95, 15, {|| STR0021}, oContainer, , , , , , .T., , , 80, 10, , , , , , .T.) // "Tempo de Setup:"
    oCboSetup := TComboBox():New(92, 90, {|x| IIf(PCount()==0, cTipoSetup, cTipoSetup := x)}, aOptSetup, 105, 10, oContainer, , , , , , .T.)
    oCboSetup:Disable()
    oSayHelp := TSay():New(110, 15, {|| STR0022}, oContainer, , , , , , .T., , , 200, 15, , , , , , .T.) // "Indica se o tempo do setup deve ser somado no calculo da quantidade de MOD por roteiro."
    oSayHelp:oFont := oFontSub
    oSayHelp:nClrText := CLR_GRAY

    oModal:AddOkButton({|| lOk := .T., oModal:DeActivate()}, STR0023) // "Confirmar"
    oModal:AddCloseButton({|| lOk := .F., oModal:DeActivate()}, STR0024) // "Cancelar"

    oModal:Activate()

    aRet := {lOk, Left(cMaoObra, 1), Left(cTipoSetup, 1)}

Return aRet
