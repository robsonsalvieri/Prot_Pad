#include "totvs.ch"
#include 'tlpp-core.th'

// Definição do Namespace para organizar o projeto e evitar conflitos
namespace backoffice.stock.invoice

/*/{Protheus.doc} Entity
Classe em TL++ para identificar a entidade (Cliente/Fornecedor) com base no tipo de documento e tipo de operacao 
e retornar campos cadastrais de forma dinâmica com base no campo solicitado.
@author    reynaldo
@since     13/06/2026
/*/
class Entity
    // Propriedades de Entrada com Tipagem Forte
    public data cDocType       as character
    public data cDocOperation  as character
    public data cDocComplement as character
    public data lFormPropNum   as logical
    public data cEntityCode    as character
    public data cEntityStore   as character

    // Propriedades de Controle Interno
    public data cEntityType    as character
    public data cEntityAlias   as character
    public data nEntityIndex   as numeric
    public data cPrefix        as character
    public data lFound         as logical

    // CACHE EM MEMÓRIA: Guarda os dados textuais de negócio isolados do banco
    private data oCache        as json

    // Declaração dos Métodos e seus Retornos
    public method New(cDocType as character, cDocOperation as character, cDocComplement as character, lFormPropNum as logical, cEntityCode as character, cEntityStore as character) as object
    public method FetchData() as logical
    public method GetTypeDescription() as character
    public method GetBusinessData(cPropertyName as character) as variant
    public method GetAlias() as character
endclass

/*/{Protheus.doc} New
Construtor da classe utilizando tipagem nativa do TL++.

@type Method
@param cDocType - Character. Tipo de documento: "E" = Entrada, "S" = Saída
@param cDocOperation - Character. Código da operação documental
@param cDocComplement - Character. Código do Complemento do documento
@param lFormPropNum - Logical. Indica se formulário próprio está em uso
@param cEntityCode - Character. Código da entidade (Cliente ou Fornecedor)
@param cEntityStore - Character. Código da loja da entidade
@return Object - Instância inicializada da classe `Entity`
/*/
method New(cDocType as character, cDocOperation as character, cDocComplement as character, lFormPropNum as logical, cEntityCode as character, cEntityStore as character) as object class Entity
    ::cDocType       := Upper(cDocType) // "E" = Entrada, "S" = Saída
    ::cDocOperation  := cDocOperation
    ::cDocComplement := cDocComplement
    ::lFormPropNum   := lFormPropNum
    ::cEntityCode    := cEntityCode
    ::cEntityStore   := cEntityStore
    ::cEntityType    := "U"
    ::cEntityAlias   := ""
    ::nEntityIndex   := 0
    ::cPrefix        := ""
    ::lFound         := .F.
    ::oCache         := JsonObject():New() // Cache para armazenar dados da entidade após busca
return self

/*/{Protheus.doc} FetchData
Identifica o Alias/Prefixo correto e posiciona o registro no banco de dados (SA1 ou SA2).

@type Method
@return Logical - .T. se o registro da entidade foi localizado e posicionada a área; .F. caso contrário
/*/
method FetchData() class Entity
    local aArea       as array
    local aAreaEntity as array
    
    // 'E' = Documento de Entrada 
    if ::cDocType == "E"

        do case
            case ::cDocOperation $ "D;B" // Tipo de operacao devolucao ou beneficiamento
                ::cEntityType  := "C"

            case ::cDocOperation == "5" // Tipo de operacao credito

                If ::cDocComplement $ "53|56"
                    ::cEntityType  := "C"

                ElseIf ::cDocComplement == "54" 
                    ::cEntityType := Iif(::lFormPropNum, "C", "F")

                EndIf

            otherwise // Tipo de operacao qualquer
                ::cEntityType  := "F"
        Endcase

    // 'S' = Documento de Saída 
    elseif ::cDocType == "S"
        do case
            case ::cDocOperation $ "D;B" // Tipo de operacao devolucao ou beneficiamento
                ::cEntityType  := "F"
            otherwise
                ::cEntityType  := "C"
        endcase
    endif
 
    if ::cEntityType  == "C"
        ::nEntityIndex := 1
        ::cEntityAlias := "SA1"
    Else
        ::nEntityIndex := 1
        ::cEntityAlias := "SA2"
    endif

    // Se identificou um alias válido, tenta posicionar o registro
    if !Empty(::cEntityAlias)
        aArea       := GetArea() 
        aAreaEntity := (::cEntityAlias)->(GetArea())
        DbSelectArea(::cEntityAlias)
        (::cEntityAlias)->(DbSetOrder(::nEntityIndex)) // Filial + Codigo + Loja
        
        if (::cEntityAlias)->(DbSeek(xFilial(::cEntityAlias) + ::cEntityCode + ::cEntityStore))
            ::lFound := .T.
            if ::cEntityType == "C"
                ::oCache["BRANCHTOTRANSFER"] := (::cEntityAlias)->A1_FILTRF // Filial para transferência
                ::oCache["TAXID"]            := (::cEntityAlias)->A1_CGC // CNPJ ou CPF
                ::oCache["STATEREGISTRATION"] := (::cEntityAlias)->A1_INSCR // Inscrição Estadual
                ::oCache["NAME"]             := (::cEntityAlias)->A1_NOME // Razão Social / Nome
                ::oCache["SHORTNAME"]        := (::cEntityAlias)->A1_NREDUZ // Nome Reduzido
                ::oCache["ADDRESS"]          := (::cEntityAlias)->A1_END // Endereco
                ::oCache["CITY"]             := (::cEntityAlias)->A1_MUN // Municipio/Cidade
                ::oCache["ZIPCODE"]          := (::cEntityAlias)->A1_CEP // CEP
                ::oCache["DISTRICT"]         := (::cEntityAlias)->A1_BAIRRO // Bairro
                ::oCache["STATE"]            := (::cEntityAlias)->A1_EST // Estado / UF
                ::oCache["COUNTRY"]          := (::cEntityAlias)->A1_PAIS // País
                ::oCache["AREACODE"]         := (::cEntityAlias)->A1_DDD // DDD
                ::oCache["PHONE"]            := (::cEntityAlias)->A1_TEL // Telefone
                ::oCache["PAYMENTTERM"]      := (::cEntityAlias)->A1_COND // Condição de Pagamento Padrão
            else
                ::oCache["BRANCHTOTRANSFER"] := (::cEntityAlias)->A2_FILTRF // Filial para transferência
                ::oCache["TAXID"]            := (::cEntityAlias)->A2_CGC // CNPJ ou CPF
                ::oCache["STATEREGISTRATION"] := (::cEntityAlias)->A2_INSCR // Inscrição Estadual
                ::oCache["NAME"]             := (::cEntityAlias)->A2_NOME // Razão Social / Nome
                ::oCache["SHORTNAME"]        := (::cEntityAlias)->A2_NREDUZ // Nome Reduzido
                ::oCache["ADDRESS"]          := (::cEntityAlias)->A2_END // Endereco
                ::oCache["CITY"]             := (::cEntityAlias)->A2_MUN // Municipio/Cidade
                ::oCache["ZIPCODE"]          := (::cEntityAlias)->A2_CEP // CEP
                ::oCache["DISTRICT"]         := (::cEntityAlias)->A2_BAIRRO // Bairro
                ::oCache["STATE"]            := (::cEntityAlias)->A2_EST // Estado / UF
                ::oCache["COUNTRY"]          := (::cEntityAlias)->A2_PAIS // País
                ::oCache["AREACODE"]         := (::cEntityAlias)->A2_DDD // DDD
                ::oCache["PHONE"]            := (::cEntityAlias)->A2_TEL // Telefone
                ::oCache["PAYMENTTERM"]      := (::cEntityAlias)->A2_COND // Condição de Pagamento Padrão
            endif
        endif
        (::cEntityAlias)->(restArea(aAreaEntity))
        restArea(aArea)
    endif

return ::lFound

/*/{Protheus.doc} GetTypeDescription
Retorna a descrição textual do tipo da entidade.

@type Method
@return Character - "Fornecedor", "Cliente" ou "Desconhecido"
/*/
method GetTypeDescription() class Entity
    local cDesc as character 

    cDesc := "Desconhecido"
    
    if ::cEntityType == "F"
        cDesc := "Fornecedor"
    elseif ::cEntityType == "C"
        cDesc := "Cliente"
    endif
return cDesc

/*/{Protheus.doc} GetBusinessData
Método abstrato que traduz termos de negócio para os campos reais da SA1 ou SA2.
Garante que o desenvolvedor não precise memorizar os nomes das colunas físicas do Protheus.

@type Method
@param cPropertyName - Character. Nome legível da propriedade (Ex: "TaxID", "Name", "PaymentTerm")
@return Variant - Conteúdo do campo correspondente
/*/
method GetBusinessData(cPropertyName as character) class Entity
local uRet      as variant   
local cPropLook as character // Mantém o Camelcase padrão do Json

    uRet      := nil
    cPropLook := AllTrim(cPropertyName)
    
    if ::lFound .and. ::oCache:hasProperty(cPropLook)
        uRet := ::oCache[cPropLook]
    endif
return uRet

/*/{Protheus.doc} GetAlias
Retorna o alias (area) onde os dados da entidade estão posicionados.

@type Method
@return Character - Alias da entidade (ex.: "SA1" ou "SA2")
@since 13/06/2026
/*/
method GetAlias() class Entity
return ::cEntityAlias

