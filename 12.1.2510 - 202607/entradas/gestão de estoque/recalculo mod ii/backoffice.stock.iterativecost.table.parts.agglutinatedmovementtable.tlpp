#Include 'Totvs.ch'
#include 'tlpp-core.th'

Using namespace totvs.protheus.backoffice.stock.iterativecost.table.manager
Using Namespace totvs.protheus.backoffice.stock.iterativecost.table.analyticalmovementtable
Using Namespace totvs.protheus.backoffice.stock.iterativecost.table.parts.analyticalmovementtable
Using Namespace totvs.protheus.backoffice.stock.iterativecost.table.aglutinattedmovementtable

namespace totvs.protheus.backoffice.stock.iterativecost.table.parts.agglutinatedMovementPartsTable

/*/{Protheus.doc} AgglutinatedMovementPartsTable
    Classe responsável por retornar a estrutura da tabela de mov. aglutinado do custo em partes (TRLCP)
    @type Class
    @author Squad Entradas
    @since 16/05/2025
/*/
Class AgglutinatedMovementPartsTable From TableManager

    public method New() 

    Static method TableFields()
    Static method TableIndexes()
    Static method TableName()

    public method AgglMovement()


    Public Data   cCusFil As character
    Public Data   oQueryLastKey As Object

endclass

/*/{Protheus.doc} New
    Instância da classe
    @type Method
    @author Squad Entradas
    @since 16/05/2025
/*/
Method New(aFil) Class AgglutinatedMovementPartsTable

    ::cCusFil  := SuperGetMv("MV_CUSFIL", .F., "A")
    ::oQueryLastKey       := Nil

    If ::cCusFil == 'E'
        _Super:New(aFil, 'E', 'C', 'C' )
    Else
        _Super:New(aFil, 'E', 'E', 'E')
    EndIf
    ::TableManager(::TableName(),::TableFields(),::TableIndexes())

Return


/*/{Protheus.doc} TableFields
    Campos da tabela de movimentação analítica em partes sendo replicada para a tabela de movimentação aglutinada
    @type Method
    @author Squad Entradas
    @since 16/05/2025
/*/
Method TableFields() Class AgglutinatedMovementPartsTable
    Local aFields   := {} as array

    aFields := AnalyticalMovementPartsTable():TableFields()
    aAdd(aFields, {"LOCARM",    "C" , TamSX3('D3_LOCAL')[1],   0})
    AAdd(aFields, {"CHVAGL",    "N", 14, 0})

Return aFields

/*/{Protheus.doc} TableIndexes
    Índices da tabela de movimentação aglutinada
    @type Method
    @author Squad Entradas
    @since 16/05/2025
/*/
Method TableIndexes() Class AgglutinatedMovementPartsTable
    Local aIndexAnl := {} As Array
    Local aIndex    := {} As Array
    Local nIndex    := 0 As Numeric 

    aIndexAnl := AnalyticalMovementPartsTable():TableIndexes()

    For nIndex := 1 To Len(aIndexAnl)
        AAdd(aIndex, {AgglutinatedMovementPartsTable():TableName()+"_"+StrZero(nIndex, 2), aIndexAnl[nIndex, 2]})
    Next

    FWFreeArray(aIndexAnl)
Return aIndex

/*/{Protheus.doc} TableName
    Retorna o nome da tabela aglutinada
    @type Method
    @author Squad Entradas
    @since 16/05/2025
/*/
Method TableName() Class AgglutinatedMovementPartsTable
    Local cAlias as character

    cAlias := "TRLCP"+cEmpAnt+"SP"

Return cAlias

/*/{Protheus.doc} AgglMovement
    Aglutina movimentos de custo em partes 
    @author Squad Entradas
    @since 16/05/2025
    @type Method
/*/

Method AgglMovement(cFilProc) Class AgglutinatedMovementPartsTable
    Local aBind    := {}
    Local cQuery   := ""
    Local cCampos  := ""
    Local nBind    := 0
    Local oQryIns  := Nil

    //Insere os movimentos aglutinados
    cCampos := " RECPAI, "
    cCampos += " FILPROC, "
    cCampos += " FILIAL, "
    If ::cCusFil == 'A' //colocar apenas na query se houver, tabela de origem nao tem o campo
        cCampos += " LOCARM, "
    EndIf
    cCampos += " CODPAR, "
    cCampos += " MOEDA, "
    cCampos += " CHVAGL, "
    cCampos += " CUSTO, "
    cCampos += " CSTORI "
 
    //Query aglutinação
    cQuery := " Select "
    cQuery += " TRL.R_E_C_N_O_ RECPAI, "
    cQuery += " MOV.FILPROC, "
    If ::cCusFil == 'E'
        If ::lPostgres
            cQuery += " Char("+cValToChar(FWSizeFilial())+") "
        EndIf
        cQuery += " '"+PadR(FWCompany(), FWSizeFilial())+"' FILIAL, "
    Else 
        cQuery += " MOV.FILIAL, "
    EndIf
    If ::cCusFil == 'A'
        cQuery += " MOV.LOCARM, "
    EndIf
    cQuery += " MOVCP.CODPAR, "
    cQuery += " MOVCP.MOEDA, "
    cQuery += " MOV.CHVAGL, "
    cQuery += " Sum(MOVCP.CUSTO) CUSTO, "
    cQuery += " Sum(MOVCP.CSTORI) CSTORI "
    cQuery += " From " + AnalyticalMovementTable():TableName() + " MOV "
    cQuery += " Inner Join " + AnalyticalMovementPartsTable():TableName() + " MOVCP "
    cQuery += " On MOVCP.RECPAI = MOV.R_E_C_N_O_ "
    cQuery += " Inner Join " + AgglutinatedMovementTable():TableName() + " TRL "
    cQuery += " On TRL.FILPROC = MOV.FILPROC "
    If ::cCusFil != 'E'
        cQuery += " And TRL.FILIAL = MOV.FILIAL "
    EndIf
    cQuery += " And TRL.CHVAGL = MOV.CHVAGL "
    cQuery += " Where "
    cQuery += "     MOV.FILPROC = ? "
    cQuery += " And MOV.IGNORE  = ? " //N
    cQuery += " Group By "
    cQuery += " TRL.R_E_C_N_O_, "
    cQuery += " MOV.FILPROC, "
    If ::cCusFil != 'E'
        cQuery += " MOV.FILIAL, "
    EndIf

    If ::cCusFil == 'A'
        cQuery += " MOV.LOCARM, "
    EndIf
    cQuery += " MOVCP.CODPAR, "
    cQuery += " MOVCP.MOEDA, "
    cQuery += " MOV.CHVAGL "

    cQuery := ChangeQuery(cQuery)

    oQryIns := FWExecStatement():New(cQuery)

    nBind := 1
    oQryIns:SetString(nBind++, cFilProc)
    oQryIns:SetString(nBind++, 'N')

    cQuery := oQryIns:GetFixQuery()

    cQuery := ::FormatCTE(cCampos, cQuery)
    
    ::RunQuery(cQuery)

    FWFreeArray(aBind) 
Return
