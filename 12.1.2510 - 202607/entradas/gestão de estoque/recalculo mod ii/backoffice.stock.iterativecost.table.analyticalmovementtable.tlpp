#Include 'Totvs.ch'
#include 'tlpp-core.th'

Using namespace totvs.protheus.backoffice.stock.iterativecost.table.manager
Using Namespace totvs.protheus.backoffice.stock.iterativecost.table.processingtable
Using namespace totvs.protheus.backoffice.stock.iterativecost.view.acquisitioncost
Using Namespace totvs.protheus.backoffice.stock.iterativecost.view.transferinvoice
Using Namespace totvs.protheus.backoffice.stock.iterativecost.view.acquisitioncost
Using namespace totvs.protheus.backoffice.stock.iterativecost.table.productstructleveltable

namespace totvs.protheus.backoffice.stock.iterativecost.table.analyticalmovementtable

/*/{Protheus.doc} AnalyticalMovementTable
    Classe responsável por retornar a estrutura da tabela de mov. analítica (TRG)
    @author Squad Entradas
    @since 27/08/2024
/*/
Class AnalyticalMovementTable From TableManager

    public method New() 

    Static method TableFields()
    Static method TableIndexes()
    Static method TableName()

    public method Query()
    Public Method InsertMovTable()

    Public Method setUnaffectedCostMovements()
    Public Method IgnoreTransferMovements()
    Public Method IgnoreThirdPartyMovements()
    Public Method IgnorePurchaseReturn()
    Public Method IgnoreSalesReturn()
    Public Method generateSeqcalc()
    Public Method prepareSeqcalcStatement()
    Public Method generateSeqcalcForAnalyticalMovements()
    Public Method lastSeqCalc()

    Public Data   oQueryMov                 As Object
    Public Data   oQueryUnaffected          As Object
    Public Data   oQueryTransf              As Object
    Public Data   oQueryPurchRetProc        As Object
    Public Data   oQueryPurchRet            As Object
    Public Data   oQueryPurchRetPrev        As Object
    Public Data   oQueryPurchRetPrevProc    As Object
    Public Data   oQueryOtherInflowRetProc  As Object
    Public Data   oQueryOtherInflowRet      As Object
    Public Data   oQuerySalesRetProc        As Object
    Public Data   oQuerySalesRet            As Object
    Public Data   oQuerySalesRetPrevProc    As Object
    Public Data   oQuerySalesRetPrev        As Object
    Public Data   oQueryThirdParty          As Object
    Public Data   oPrepSeqcalc              As Object
    Public Data   olastSeqCalc               As Object
    Public Data   jVwAcquistCstParams       As Json
    Public Data   cViewAcquisCst            As Character
    Public Data   cCusFil                   As Character
    Public Data   jParams                   As Json
    Public Data   jDecCM                    As Json
    Public Data   jDecCst                   As Json
    Public Data   nlastSeqCalc               As Numeric

endclass

/*/{Protheus.doc} New
    Instância da classe
    @author Squad Entradas
    @since 27/08/2024
/*/
Method New(aFil, jParams) Class AnalyticalMovementTable
    Local nMoeda, cMoeda

    ::oQueryMov := Nil
    ::cCusFil  := SuperGetMv("MV_CUSFIL", .F., "A")
    ::jParams   := jParams

    ::jVwAcquistCstParams := JsonObject():New()
    ::jDecCM              := JsonObject():New()
    ::jDecCst             := JsonObject():New()

    D4D->(DbSetOrder(1)) //D4D_FILIAL+D4D_IDVIEW
    If D4D->(DbSeek(FWXFilial('D4D')+ViewAcquisitionCost():GetViewID()))
        ::cViewAcquisCst := D4D->D4D_VWNAME
        ::jVwAcquistCstParams:FromJson(D4D->D4D_PARAM)
    EndIf
    ::nlastSeqCalc := 0

    For nMoeda := 1 To 5
        cMoeda := cValToChar(nMoeda)
        ::jDecCM[cMoeda]  := TamSX3("B2_CMFIM"+cMoeda)[2] 
        ::jDecCst[cMoeda] := TamSX3("B2_VFIM"+cMoeda)[2] 
    Next

    _Super:New(aFil)
    ::TableManager(::TableName(),::TableFields(),::TableIndexes())
Return

/*/{Protheus.doc} TableFields
    Campos da tabela de movimentação analítica
    @author Squad Entradas
    @since 27/08/2024
/*/
Method TableFields() Class AnalyticalMovementTable
    Local aFields   := {} as array
    Local nTamAlias := 3 as numeric
    Local nTamCM    := 1 as numeric
    Local nTamRec   := 10 as numeric

    aAdd(aFields, {"FILPROC",   "C" , TamSX3('D3_FILIAL')[1],  0})
    aAdd(aFields, {"FILIAL",    "C" , TamSX3('D3_FILIAL')[1],  0})
    aAdd(aFields, {"FILTRF",    "C" , TamSX3('F4_TRANFIL')[1], 0})
    aAdd(aFields, {"COD",       "C" , TamSX3('D3_COD')[1],     0})
    aAdd(aFields, {"LOCARM",    "C" , TamSX3('D3_LOCAL')[1],   0})
    aAdd(aFields, {"TM",        "C" , TamSX3('D3_TM')[1],      0})
    AAdd(aFields, {"PODER3",    "C" , 1, 0})
    AAdd(aFields, {"IDENTB6",   "C" , 6, 0})
    AAdd(aFields, {"TIPONF",    "C" , 1, 0})
    aAdd(aFields, {"CF",        "C" , TamSX3('D3_CF')[1],      0})
    aAdd(aFields, {"OP",        "C" , TamSX3('D3_OP')[1],      0})
    aAdd(aFields, {"SEQ",       "C" , TamSX3('D3_NUMSEQ')[1],  0})
    aAdd(aFields, {"ALIAS",     "C" , nTamAlias,               0})
    aAdd(aFields, {"RECNO",     "N" , nTamRec,                 0})
    aAdd(aFields, {"QUANT",     "N" , TamSX3('D3_QUANT')[1],  TamSX3('D3_QUANT')[2]})
    aAdd(aFields, {"QTSEGUM",   "N" , TamSX3('D3_QTSEGUM')[1], TamSX3('D3_QTSEGUM')[2]})
    aAdd(aFields, {"PERDA",     "N" , TamSX3('D3_PERDA')[1],  TamSX3('D3_PERDA')[2]})
    aAdd(aFields, {"PARCTOT",   "C" , TamSX3('D3_PARCTOT')[1], 0})
    aAdd(aFields, {"CUSTO1",    "N" , TamSX3('D3_CUSTO1')[1], TamSX3('D3_CUSTO1')[2]})
    aAdd(aFields, {"CUSTO2",    "N" , TamSX3('D3_CUSTO2')[1], TamSX3('D3_CUSTO2')[2]})
    aAdd(aFields, {"CUSTO3",    "N" , TamSX3('D3_CUSTO3')[1], TamSX3('D3_CUSTO3')[2]})
    aAdd(aFields, {"CUSTO4",    "N" , TamSX3('D3_CUSTO4')[1], TamSX3('D3_CUSTO4')[2]})
    aAdd(aFields, {"CUSTO5",    "N" , TamSX3('D3_CUSTO5')[1], TamSX3('D3_CUSTO5')[2]})
    aAdd(aFields, {"RATEIO",    "N" , TamSX3('D3_RATEIO')[1], TamSX3('D3_RATEIO')[2]})
    aAdd(aFields, {"QTDORI",    "N" , TamSX3('D3_QUANT')[1],  TamSX3('D3_QUANT')[2]})
    aAdd(aFields, {"CSTOR1",    "N" , TamSX3('D3_CUSTO1')[1], TamSX3('D3_CUSTO1')[2]})
    aAdd(aFields, {"CSTOR2",    "N" , TamSX3('D3_CUSTO2')[1], TamSX3('D3_CUSTO2')[2]})
    aAdd(aFields, {"CSTOR3",    "N" , TamSX3('D3_CUSTO3')[1], TamSX3('D3_CUSTO3')[2]})
    aAdd(aFields, {"CSTOR4",    "N" , TamSX3('D3_CUSTO4')[1], TamSX3('D3_CUSTO4')[2]})
    aAdd(aFields, {"CSTOR5",    "N" , TamSX3('D3_CUSTO5')[1], TamSX3('D3_CUSTO5')[2]})
    aAdd(aFields, {"CSTRE1",    "N" , TamSX3('D3_CUSTO1')[1], TamSX3('D3_CUSTO1')[2]})
    aAdd(aFields, {"CSTRE2",    "N" , TamSX3('D3_CUSTO2')[1], TamSX3('D3_CUSTO2')[2]})
    aAdd(aFields, {"CSTRE3",    "N" , TamSX3('D3_CUSTO3')[1], TamSX3('D3_CUSTO3')[2]})
    aAdd(aFields, {"CSTRE4",    "N" , TamSX3('D3_CUSTO4')[1], TamSX3('D3_CUSTO4')[2]})
    aAdd(aFields, {"CSTRE5",    "N" , TamSX3('D3_CUSTO5')[1], TamSX3('D3_CUSTO5')[2]})
    aAdd(aFields, {"CALCREQ",   "C", 1, 0})
    aAdd(aFields, {"ENTSAI",    "C", 1, 0})
    aAdd(aFields, {"CUSTOMEDIO","C" , nTamCM,                  0})
    AAdd(aFields, {"IGNORE",    "C", 1, 0})
    AAdd(aFields, {"PREPROC",   "C", 1, 0})
    AAdd(aFields, {"DEVCM",     "C", 1, 0})
    aAdd(aFields, {"NUMCQ",     "C" , TamSX3('D7_NUMERO')[1],  0})
    aAdd(aFields, {"IDENT",     "C" , TamSX3('D3_IDENT')[1],  0})
    aAdd(aFields, {"ORIGLAN",   "C" , TamSX3('D7_ORIGLAN')[1], 0})
    aAdd(aFields, {"LOCDEST",   "C" , TamSX3('D7_LOCDEST')[1],  0})
    aAdd(aFields, {"CMFIXO",    "N" , TamSX3('D3_CMFIXO')[1],  TamSX3('D3_CMFIXO')[2]})
    aAdd(aFields, {"MOEDA",     "C" , TamSX3('D3_MOEDA')[1],   0})
    aAdd(aFields, {"RECORISD1", "N" , nTamRec,                 0})
    aAdd(aFields, {"RECORISD2", "N" , nTamRec,                 0})
    aAdd(aFields, {"CODORI",    "C" , TamSX3('D3_COD')[1],     0})
    aAdd(aFields, {"LOCORI",    "C" , TamSX3('D3_LOCAL')[1],   0})
    AAdd(aFields, {"CHVAGL",    "N", 14, 0})
    aAdd(aFields, {"SEQCALC",   "N" , TamSX3('D3_SEQCALC')[1], 0})
    
Return aFields

/*/{Protheus.doc} TableIndexes
    Índices da tabela de movimentação analítica
    @author Squad Entradas
    @since 27/08/2024
/*/
Method TableIndexes() Class AnalyticalMovementTable
    Local aIndex := {} as array
    Local cTable := AnalyticalMovementTable():TableName()

    aAdd(aIndex, {cTable+'_01', 'FILPROC+IGNORE+FILIAL+LOCARM+COD+CUSTOMEDIO'})
    aAdd(aIndex, {cTable+'_02', 'FILPROC+IGNORE+FILIAL+COD+CUSTOMEDIO'})
    aAdd(aIndex, {cTable+'_03', 'FILPROC+IGNORE+COD+CUSTOMEDIO'})
    aAdd(aIndex, {cTable+'_04', 'FILPROC+IGNORE+CHVAGL+FILIAL+LOCARM+COD'})
    aAdd(aIndex, {cTable+'_05', 'FILPROC+IGNORE+CHVAGL+FILIAL+COD'})
    aAdd(aIndex, {cTable+'_06', 'FILPROC+IGNORE+CHVAGL+COD'})
    aAdd(aIndex, {cTable+'_07', 'FILPROC+IGNORE+CHVAGL+TM+CUSTOMEDIO'})
    aAdd(aIndex, {cTable+'_08', 'FILPROC+FILIAL+COD+ENTSAI+CUSTOMEDIO'})
    aAdd(aIndex, {cTable+'_09', 'FILPROC+CF+FILIAL'})
    aAdd(aIndex, {cTable+'_10', 'FILPROC+FILIAL+IDENTB6+PODER3'})
    aAdd(aIndex, {cTable+'_11', 'FILPROC+ALIAS+RECNO'})
    aAdd(aIndex, {cTable+'_12', 'FILPROC+FILIAL+COD+LOCARM+CODORI+LOCORI'})
    aAdd(aIndex, {cTable+'_13', 'FILPROC+FILIAL+COD+CODORI'})
    aAdd(aIndex, {cTable+'_14', 'FILPROC+COD+CODORI'})
    aAdd(aIndex, {cTable+'_15', 'FILPROC+FILIAL+CF+SEQ'})
    aAdd(aIndex, {cTable+'_16', 'FILPROC+CHVAGL'})

Return aIndex

/*/{Protheus.doc} TableName
    Retorna o nome da tabela de movimentação analítica
    @author Squad Entradas
    @since 27/08/2024
/*/
Method TableName() Class AnalyticalMovementTable
    Local cAlias as character

    cAlias := "TRG"+cEmpAnt+"SP"

Return cAlias

/*/{Protheus.doc} Query
    Retorna a query da tabela de movimentação analítica
    @author Squad Entradas
    @since 27/08/2024
    @type Method
    @dDtIni - Data inicial de processamento
    @dDtFim - Data final de processamento
    @cEmpAtu - Empresa atual
    @cFilAtu - Filial atual
/*/
Method Query(dDtIni,dDtFim,cFilProc,cFilAtu) Class AnalyticalMovementTable
    Local cLocCQ    as character
    Local cProdMNT  as character
    Local cQuery    as character
    Local cCampos   as character
    Local cViewSD1  as character
    Local cEmpAtu := cEmpAnt As Character
    Local aBind := {} As Array
    Local nI        As Numeric
    Local lD3NumCQ  as logical
    Default cFilAtu := cFilAnt

    //Inicializa as variáveis
    cLocCQ    := GetMvNNR('MV_CQ','98')
    cProdMNT  := SuperGetMv("MV_PRODMNT",.F.,"MANUTENCAO")
    cViewSD1  := "VW_" + ViewAcquisitionCost():GetViewID() + "_" + cEmpAtu
    cCampos   := "FILPROC, FILIAL, FILTRF, COD, LOCARM, TM, PODER3, IDENTB6, TIPONF, "
    cCampos   += " CF, OP, SEQ, ALIAS, QUANT, QTSEGUM, QTDORI, PERDA, PARCTOT, " 
    cCampos   += "CUSTO1, CUSTO2, CUSTO3, CUSTO4, CUSTO5, "
    cCampos   += "CSTOR1, CSTOR2, CSTOR3, CSTOR4, CSTOR5, "
    cCampos   += "RATEIO, RECNO, ENTSAI, CUSTOMEDIO, IGNORE, "
    cCampos   += "PREPROC, NUMCQ, IDENT, ORIGLAN, LOCDEST , "
    cCampos   += "CMFIXO, MOEDA, RECORISD1, RECORISD2, CODORI, LOCORI "
    lD3NumCQ  := SD3->(FieldPos("D3_NUMCQ")) > 0

    If ::oQueryMov == Nil
        //SELECT SD1 - NOTAS FISCAIS DE COMPRA
        cQuery := " SELECT "
        If ::lPostgres
            cQuery += " Char("+cValToChar(FWSizeFilial())+") "
        EndIf
        cQuery += " '"+cFilProc+"' FILPROC, "
        cQuery += " SD1.D1_FILIAL FILIAL, "
        cQuery += " SF4.F4_TRANFIL FILTRF, "
        cQuery += " SD1.D1_COD COD,    "
        cQuery += " SD1.D1_LOCAL LOCARM, "
        cQuery += " SD1.D1_TES TM, "
        cQuery += " SF4.F4_PODER3 PODER3, "
        cQuery += " CASE WHEN "
        cQuery += " SD1.D1_TIPO = 'C' AND SD1.D1_QUANT = 0 AND SF4.F4_PODER3 = 'R' THEN " +MatIsNull()+"(SB6C.B6_IDENTB6,' ') " 
        cQuery += " ELSE SD1.D1_IDENTB6 "
        cQuery += " END IDENTB6, "
        cQuery += " SD1.D1_TIPO TIPONF, "
        cQuery += " ' ' CF, "
        cQuery += " SD1.D1_OP OP, "
        cQuery += " SD1.D1_NUMSEQ SEQ, "
        cQuery += "'SD1' ALIAS, "
        cQuery += " SD1.R_E_C_N_O_ RECNO, "
        cQuery += " SD1.D1_QUANT QUANT, " 
        cQuery += " SD1.D1_QUANT QTDORI, "
        cQuery += " SD1.D1_QTSEGUM QTSEGUM, "
        cQuery += " 0 PERDA, "
        cQuery += " ' ' PARCTOT, "
        cQuery += " SD1.D1_CUSTO  CUSTO1, "
        cQuery += " SD1.D1_CUSTO2 CUSTO2, "
        cQuery += " SD1.D1_CUSTO3 CUSTO3, "
        cQuery += " SD1.D1_CUSTO4 CUSTO4, "
        cQuery += " SD1.D1_CUSTO5 CUSTO5, "
        cQuery += " SD1.D1_CUSTO  CSTOR1, "
        cQuery += " SD1.D1_CUSTO2 CSTOR2, "
        cQuery += " SD1.D1_CUSTO3 CSTOR3, "
        cQuery += " SD1.D1_CUSTO4 CSTOR4, "
        cQuery += " SD1.D1_CUSTO5 CSTOR5, "
        cQuery += " 0 RATEIO, "
        cQuery += " 'E' ENTSAI, "
        cQuery += " 'N' CUSTOMEDIO, "
        cQuery += " CASE WHEN SD1.D1_OP <> ' ' THEN 'S' ELSE 'N' END IGNORE, "
        cQuery += " 'N' PREPROC, "
        cQuery += " ' ' NUMCQ, "
        cQuery += " ' ' IDENT, "
        cQuery += " ' ' ORIGLAN, "
        cQuery += " ' ' LOCDEST, "
        cQuery += " 0 CMFIXO, "
        cQuery += " ' ' MOEDA, "
        cQuery += " 0 RECORISD1, "
        cQuery += ::cCoalesce+"(SD2.R_E_C_N_O_,0) RECORISD2, "
        cQuery += " ' ' CODORI, "
        cQuery += " ' ' LOCORI "
        cQuery += " FROM "+RetSQLName("SD1")+" SD1 "
        cQuery += " JOIN "+RetSQLName("SF4")+" SF4 "
        cQuery += " ON SF4.F4_FILIAL = ? "
        cQuery += " AND SF4.F4_CODIGO = SD1.D1_TES "
        cQuery += " AND SF4.F4_ESTOQUE = ? "
        cQuery += " AND SF4.D_E_L_E_T_ = ? "
        cQuery += " LEFT OUTER JOIN " + cViewSD1 + " VW "
        cQuery += " ON SD1.R_E_C_N_O_ = VW.D1RECNO "
        cQuery += " LEFT JOIN "+RetSQLName("SB6")+" SB6C "
        cQuery += " ON SB6C.B6_FILIAL = ? "
        cQuery += " AND SB6C.B6_PRODUTO = SD1.D1_COD "
        cQuery += " AND SB6C.B6_CLIFOR = SD1.D1_FORNECE "
        cQuery += " AND SB6C.B6_LOJA = SD1.D1_LOJA "
        cQuery += " AND SB6C.B6_IDENT = SD1.D1_IDENTB6 "
        cQuery += " AND SB6C.B6_PODER3 = ? "
        cQuery += " AND SB6C.D_E_L_E_T_ = ? "
        cQuery += " LEFT JOIN "+RetSQLName("SD2")+" SD2 ON "
		cQuery += " SD2.D2_FILIAL = SD1.D1_FILIAL AND "
		cQuery += " SD2.D2_DOC   = SD1.D1_NFORI AND "
		cQuery += " SD2.D2_SERIE = SD1.D1_SERIORI AND "
		cQuery += " SD2.D2_ITEM  = SD1.D1_ITEMORI AND "
		cQuery += " SD2.D2_CLIENTE = SD1.D1_FORNECE AND "
		cQuery += " SD2.D2_LOJA = SD1.D1_LOJA AND "
        cQuery += " SD2.D_E_L_E_T_ = ? "
        cQuery += " WHERE SD1.D1_FILIAL = ? "
        cQuery += " AND SD1.D1_DTDIGIT BETWEEN ? AND ? "
        cQuery += " AND SD1.D1_TES <> ? "
        cQuery += " AND SD1.D1_ORIGLAN <> ? "
        cQuery += " AND SD1.D1_REMITO = ? " //Ignora remitos independente da localização
        cQuery += " AND SD1.D_E_L_E_T_ = ? "
        cQuery += " AND VW.D1RECNO IS NULL "
        cQuery += " UNION ALL "

        //SELECT SD2 - NOTAS FISCAIS DE SAÍDA
        cQuery += " SELECT "
        If ::lPostgres
            cQuery += " Char("+cValToChar(FWSizeFilial())+") "
        EndIf
        cQuery += " '"+cFilProc+"' FILPROC, "
        cQuery += " SD2.D2_FILIAL FILIAL,"
        cQuery += " SF4.F4_TRANFIL FILTRF, "
        cQuery += " SD2.D2_COD COD, "
        cQuery += " SD2.D2_LOCAL LOCARM, "
        cQuery += " SD2.D2_TES TM, "
        cQuery += " SF4.F4_PODER3 PODER3, "
        cQuery += " SD2.D2_IDENTB6 IDENTB6, "
        cQuery += " SD2.D2_TIPO TIPONF, "
        cQuery += " ' ' CF, "
        cQuery += " SD2.D2_OP OP, "
        cQuery += " SD2.D2_NUMSEQ SEQ, "
        cQuery += " 'SD2' ALIAS, "
        cQuery += " SD2.R_E_C_N_O_ RECNO, "
        cQuery += " SD2.D2_QUANT QUANT, "
        cQuery += " SD2.D2_QUANT QTDORI, "
        cQuery += " SD2.D2_QTSEGUM QTSEGUM, "
        cQuery += " 0 PERDA, "
        cQuery += " ' ' PARCTOT, "
        cQuery += " SD2.D2_CUSTO1 CUSTO1, "
        cQuery += " SD2.D2_CUSTO2 CUSTO2, "
        cQuery += " SD2.D2_CUSTO3 CUSTO3, "
        cQuery += " SD2.D2_CUSTO4 CUSTO4, "
        cQuery += " SD2.D2_CUSTO5 CUSTO5, "
        cQuery += " SD2.D2_CUSTO1 CSTOR1, "
        cQuery += " SD2.D2_CUSTO2 CSTOR2, "
        cQuery += " SD2.D2_CUSTO3 CSTOR3, "
        cQuery += " SD2.D2_CUSTO4 CSTOR4, "
        cQuery += " SD2.D2_CUSTO5 CSTOR5, "
        cQuery += " 0 RATEIO, "
        cQuery += " 'S' ENTSAI, "
        cQuery += " CASE WHEN SD2.D2_TIPO IN ('N','B','C') "
        cQuery += " AND SF4.F4_PODER3 IN ('N','R') " 
        cQuery += " THEN 'S' ELSE 'N' END CUSTOMEDIO, "
        cQuery += " 'N' IGNORE, "
        cQuery += " 'N' PREPROC, "
        cQuery += " ' ' NUMCQ, "
        cQuery += " ' ' IDENT, "
        cQuery += " ' ' ORIGLAN, "
        cQuery += " ' ' LOCDEST, "
        cQuery += " 0 CMFIXO, "
        cQuery += " ' ' MOEDA, "
        cQuery += ::cCoalesce+"(SD1.R_E_C_N_O_,0) RECORISD1, "
        cQuery += " 0 RECORISD2, "
        cQuery += " ' ' CODORI, "
        cQuery += " ' ' LOCORI "
        cQuery += " FROM "+RetSQLName("SD2")+" SD2 "
        cQuery += " JOIN "+RetSQLName("SF4")+" SF4 "
        cQuery += " ON SF4.F4_FILIAL = ? "
        cQuery += " AND SF4.F4_CODIGO = SD2.D2_TES "
        cQuery += " AND SF4.F4_ESTOQUE = ? "
        cQuery += " AND SF4.D_E_L_E_T_ = ? "
        cQuery += " LEFT JOIN "+RetSQLName("SD1")+" SD1 ON "
		cQuery += " SD1.D1_FILIAL = SD2.D2_FILIAL AND "
		cQuery += " SD1.D1_DOC = SD2.D2_NFORI AND "
		cQuery += " SD1.D1_SERIE = SD2.D2_SERIORI AND "
		cQuery += " SD1.D1_ITEM  = SD2.D2_ITEMORI AND "
		cQuery += " SD1.D1_FORNECE = SD2.D2_CLIENTE AND "
		cQuery += " SD1.D1_LOJA = SD2.D2_LOJA AND "
        cQuery += " SD1.D_E_L_E_T_ = ? "
        cQuery += " WHERE SD2.D2_FILIAL = ? "
        cQuery += " AND SD2.D2_EMISSAO BETWEEN ? AND ? "
        cQuery += " AND SD2.D2_ORIGLAN <> ? "
        cQuery += " AND SD2.D2_REMITO = ? "
        cQuery += " AND SD2.D_E_L_E_T_ = ? "
        cQuery += " UNION ALL "

        //SELECT SD3 - MOVIMENTOS INTERNOS
        cQuery += " SELECT "
        If ::lPostgres
            cQuery += " Char("+cValToChar(FWSizeFilial())+") "
        EndIf
        cQuery += " '"+cFilProc+"' FILPROC, "
        cQuery += " SD3.D3_FILIAL FILIAL, "
        cQuery += " ' ' FILTRF, "
        cQuery += " SD3.D3_COD COD, "
        cQuery += " SD3.D3_LOCAL LOCARM, "
        cQuery += " SD3.D3_TM TM, "
        cQuery += " ' ' PODER3, "
        cQuery += " ' ' IDENTB6, "
        cQuery += " ' ' TIPONF, "
        cQuery += " SD3.D3_CF CF, "
        cQuery += " SD3.D3_OP OP, "
        cQuery += " SD3.D3_NUMSEQ SEQ, "
        cQuery += " 'SD3' ALIAS, "
        cQuery += " SD3.R_E_C_N_O_ RECNO, "
        cQuery += " SD3.D3_QUANT QUANT, "
        cQuery += " SD3.D3_QUANT QTDORI, "
        cQuery += " SD3.D3_QTSEGUM QTSEGUM, "
        cQuery += " SD3.D3_PERDA PERDA, "
        cQuery += " SD3.D3_PARCTOT PARCTOT, "
        cQuery += " SD3.D3_CUSTO1 CUSTO1, "
        cQuery += " SD3.D3_CUSTO2 CUSTO2, "
        cQuery += " SD3.D3_CUSTO3 CUSTO3, "
        cQuery += " SD3.D3_CUSTO4 CUSTO4, "
        cQuery += " SD3.D3_CUSTO5 CUSTO5, "
        cQuery += " SD3.D3_CUSTO1 CSTOR1, "
        cQuery += " SD3.D3_CUSTO2 CSTOR2, "
        cQuery += " SD3.D3_CUSTO3 CSTOR3, "
        cQuery += " SD3.D3_CUSTO4 CSTOR4, "
        cQuery += " SD3.D3_CUSTO5 CSTOR5, "
        cQuery += " SD3.D3_RATEIO RATEIO, "
        cQuery += " CASE WHEN SD3.D3_TM <= '500' THEN 'E' ELSE 'S' END ENTSAI, "
        cQuery += " CASE WHEN SD3.D3_CF IN "
        cQuery += " ('DE4', 'DE6', 'DE7', 'PR0', 'PR1', 'RE5', 'RE6', 'REA', 'DEA') THEN 'N' "
        cQuery += " ELSE 'S' END CUSTOMEDIO, "
        cQuery += " CASE WHEN SD3.D3_CF IN ('RE5','REA','DEA') THEN 'S' ELSE 'N' END IGNORE, "
        cQuery += " 'N' PREPROC, "
        cQuery += ::cCoalesce + "(SD7.D7_NUMERO, '" + Space(TamSX3("D7_NUMERO")[1]) + "') NUMCQ, "
        cQuery += " SD3.D3_IDENT IDENT, "
        cQuery += ::cCoalesce + "(SD7.D7_ORIGLAN, '" + Space(TamSX3("D7_ORIGLAN")[1]) + "') ORIGLAN, "
        cQuery += ::cCoalesce + "(SD7.D7_LOCDEST, '" + Space(TamSX3("D7_LOCDEST")[1]) + "') LOCDEST, "
        cQuery += " SD3.D3_CMFIXO CMFIXO, "
        cQuery += " SD3.D3_MOEDA MOEDA, "
        cQuery += " 0 RECORISD1, "
        cQuery += " 0 RECORISD2, "
        cQuery += " Coalesce(SD3REQ.D3_COD, ' ')   CODORI, "
        cQuery += " Coalesce(SD3REQ.D3_LOCAL, ' ') LOCORI "
        cQuery += " FROM "+RetSQLName("SD3")+" SD3 "
        cQuery += " LEFT JOIN " + RetSQLName("SD7") + " SD7 "
        cQuery += "     ON  SD7.D7_FILIAL = ? "
        cQuery += "     AND SD7.D7_NUMERO = "
        If lD3NumCQ
            If ::lOracle
                cQuery += "Cast("
            EndIf
            cQuery += ::cCoalesce + "(NULLIF(D3_NUMCQ,'" + Space(TamSX3("D3_NUMCQ")[1]) + "'),D3_DOC) "
            If ::lOracle
                cQuery+= " As Char ("+cValToChar(TamSX3("D7_NUMERO")[1])+") )"
            EndIf
        Else
            cQuery += " SD3.D3_DOC "
        EndIf
        cQuery += "     AND SD7.D7_PRODUTO = SD3.D3_COD "
        cQuery += "     AND SD7.D7_LOCAL = ? "
        cQuery += "     AND SD7.D7_NUMSEQ = SD3.D3_NUMSEQ "
        cQuery += "     AND SD7.D_E_L_E_T_ = ? "
        cQuery += " LEFT JOIN "+RetSQLName('SD3')+" SD3REQ "
        cQuery += "      ON SD3REQ.D3_FILIAL  = SD3.D3_FILIAL "
        cQuery += "     AND SD3REQ.D3_NUMSEQ  = SD3.D3_NUMSEQ "
        cQuery += "     AND SD3REQ.D3_CF      = ? "
        cQuery += "     AND SD3REQ.D3_ESTORNO = ? "
        cQuery += "     AND SD3REQ.D_E_L_E_T_ = ? "
        cQuery += "     AND SD3.D3_CF = ? "
        cQuery += " WHERE SD3.D3_FILIAL = ? "
        cQuery += " AND SD3.D3_EMISSAO BETWEEN ? AND ? "
        cQuery += " AND SD3.D3_ESTORNO = ? "
        cQuery += " AND SD3.D_E_L_E_T_ = ? "

        cQuery := ChangeQuery(cQuery)

        ::oQueryMov := FWExecStatement():New(cQuery)
    EndIf

    aBind := {}
    //SD1
    AAdd(aBind, FWXFilial("SF4",cFilAtu)) //F4_FILIAL
    AAdd(aBind, 'S') //F4_ESTOQUE
    AAdd(aBind, ' ') //SF4.D_E_L_E_T_
    AAdd(aBind, FWxFilial("SB6")) //B6_FILIAL
    AAdd(aBind, 'R') //B6_PODER3
    AAdd(aBind, ' ') //SB6.D_E_L_E_T_
    AAdd(aBind, ' ') //SD2.D_E_L_E_T_
    AAdd(aBind, FWXFilial("SD1",cFilAtu)) //D1_FILIAL
    AAdd(aBind, DtoS(dDtIni)) //D1_DTDIGIT
    AAdd(aBind, DtoS(dDtFim)) //D1_DTDIGIT
    AAdd(aBind, ' ') //D1_TES
    AAdd(aBind, 'LF') //D1_ORIGLAN
    AAdd(aBind, ' ') //D1_REMITO
    //AAdd(aBind, 'D') //D1_TIPO
    //AAdd(aBind, 'R') //F4_PODER3
    //AAdd(aBind, 'D') //F4_PODER3
    //AAdd(aBind, ' ') //D1_OP
    AAdd(aBind, ' ') //SD1.D_E_L_E_T_

    //SD2
    AAdd(aBind, FWXFilial("SF4",cFilAtu)) //F4_FILIAL
    AAdd(aBind, 'S') //F4_ESTOQUE
    AAdd(aBind, ' ') //SF4.D_E_L_E_T_
    AAdd(aBind, ' ') //SD1.D_E_L_E_T_
    AAdd(aBind, FWXFilial("SD2",cFilAtu)) //D2_FILIAL
    AAdd(aBind, DtoS(dDtIni)) //D2_EMISSAO
    AAdd(aBind, DtoS(dDtFim)) //D2_EMISSAO
    AAdd(aBind, 'LF') //D2_ORIGLAN
    AAdd(aBind, ' ') //D2_REMITO
    AAdd(aBind, ' ') //SD2.D_E_L_E_T_

    //SD7
    AAdd(aBind, FWXFilial("SD7",cFilAtu)) //D7_FILIAL
    AAdd(aBind, cLocCQ) //D7_LOCAL
    AAdd(aBind, ' ') //SD7.D_E_L_E_T_

    //SD3REQ
    AAdd(aBind, 'RE4') //SD3REQ.D3_CF
    AAdd(aBind, ' ') //SD3REQ.D3_ESTORNO
    AAdd(aBind, ' ') //SD3REQ.D_E_L_E_T_
    AAdd(aBind, 'DE4') //SD3.D3_CF

    //SD3
    AAdd(aBind, FWXFilial("SD3",cFilAtu)) //D3_FILIAL
    AAdd(aBind, DtoS(dDtIni)) //D3_EMISSAO
    AAdd(aBind, DtoS(dDtFim)) //D3_EMISSAO
    AAdd(aBind, ' ') //D3_ESTORNO
    AAdd(aBind, ' ') //SD3.D_E_L_E_T_
 
    For nI := 1 To Len(aBind)
        ::oQueryMov:SetString(nI, aBind[nI])
    Next nI

    cQuery := ::oQueryMov:GetFixQuery()

    //Montagem da query com CTE (Common Table Expression)
    cQuery := ::FormatCTE(cCampos, cQuery)
    
    FWFreeArray(aBind)
Return cQuery

Method InsertMovTable(cFilProc, dDtIni, dDtFim) Class AnalyticalMovementTable
    Local cQuery     := ""
    Local nFil       := 0

    For nFil := 1 To Len(::aFilProc)
        cQuery := ::Query(dDtIni, dDtFim, cFilProc, ::aFilProc[nFil, 1])
        ::RunQuery(cQuery)
    Next nFil

Return

/*/{Protheus.doc} setUnaffectedCostMovements
    Marca os movimentos do periodo que nao tem seu custo medio afetado
    por outras movimentacoes e podem ser ignorados e/ou pre-processados
    Ex: Notas de revenda
    @author Squad Entradas
    @since 24/09/2024
    /*/
Method setUnaffectedCostMovements(cFilProc) Class AnalyticalMovementTable
    Local cQuery  := ""
    Local cUpdate := ""
    Local cCTE    := ""
    Local nFil    := ""
    Local cFilAtu := ""
    Local aBind   := {}
    Local nI      := 0

    If !::lOracle
        cCTE := " With TEMPTABLE As "
    Else
        cCTE := " Merge Into "+::TableName()+" Using "
    EndIf

    If ::oQueryUnaffected == Nil
        cQuery := " Select A.R_E_C_N_O_ RECNUMBER "
        cQuery += " From "+::TableName()+" A "
        cQuery += " Left Outer Join "+::TableName()+" B On "
        cQuery += " B.FILPROC  = A.FILPROC And "
        cQuery += " B.IGNORE   = ? And "
        If ::cCusFil != 'E'
            cQuery += " B.FILIAL   = A.FILIAL  And "
        EndIf
        If ::cCusFil == 'A'
            cQuery += " B.LOCARM   = A.LOCARM  And "
        EndIf
        cQuery += " B.COD      = A.COD     And "
        cQuery += " B.CUSTOMEDIO = ? " //Se houverem movimentos valorizados, o produto não pode ter o custo pré apurado
        cQuery += " Where "
        cQuery += " A.FILPROC = ? And "
        cQuery += " A.IGNORE  = ? And  "
        If ::cCusFil != 'E'
            cQuery += " A.FILIAL  = ?  And "
        EndIf
        cQuery += " A.CUSTOMEDIO  = ? And  "
        cQuery += " B.FILPROC Is Null "

        cQuery := ChangeQuery(cQuery)

        ::oQueryUnaffected := FWExecStatement():New(cQuery)
    EndIf

    For nFil := 1 To Len(::aFilProc)
        cFilAtu := ::aFilProc[nFil, 1]

        FWFreeArray(aBind)
        aBind := {}
        AAdd(aBind, 'N') //IGNORE
        AAdd(aBind, 'N') //CUSTOMEDIO
        AAdd(aBind, cFilProc) //FILPROC
        AAdd(aBind, 'N') //IGNORE
        If ::cCusFil != 'E'
            AAdd(aBind, cFilAtu) //FILIAL
        EndIf
        AAdd(aBind, 'S') //CUSTOMEDIO

        For nI := 1 To Len(aBind)
            ::oQueryUnaffected:SetString(nI, aBind[nI])
        Next nI

        cQuery := " ( "+::oQueryUnaffected:GetFixQuery()+" ) "

        If ::lOracle
            cQuery += " TEMPTABLE "
            cQuery += " On ("
            cQuery += " "+::TableName()+".R_E_C_N_O_ = TEMPTABLE.RECNUMBER"
            cQuery += " ) "
            cQuery += " When Matched Then "
        EndIf

        If !::lOracle
            cUpdate := " Update "+::TableName()+" "
        Else
            cUpdate := " Update "
        EndIf
        cUpdate += "    Set "
        cUpdate += " IGNORE = 'S', "
        cUpdate += " PREPROC = 'S' "

        If !::lOracle
            cUpdate += " From TEMPTABLE "
        EndIf
        cUpdate += " Where "
        cUpdate += " "+::TableName()+".R_E_C_N_O_ = TEMPTABLE.RECNUMBER"

        ::RunQuery(cCTE+cQuery+cUpdate)

        If ::cCusFil == 'E'
            Exit
        EndIf
    Next nFil

    FWFreeArray(aBind)
Return

/*/{Protheus.doc} IgnoreTransferMovements
    Marca os movimentos de transferência no período que não afetam o custo médio
    @author Squad Entradas
    @since 24/09/2024
    /*/
Method IgnoreTransferMovements(cFilProc, dDtIni, dDtFim) Class AnalyticalMovementTable
    Local cQuery  := ""
    Local cUpdate := ""
    Local cMoeda  := ""
    Local cCTE    := ""
    Local nFil    := ""
    Local cFilAtu := ""
    Local aBind   := {}
    Local nI      := 0
    Local cViewID := ""
    local lRound    := SuperGetMV("MV_CMROUND",.F.,.F.) as logical
    Local cProcTable := ProcessingTable():TableName()

    If !::lOracle
        cCTE := " With TEMPTABLE As "
    Else
        cCTE := " Merge Into "+::TableName()+" Using "
    EndIf

    If ::oQueryTransf == Nil
        cQuery := " Select "
        For nI := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nI]
            cQuery += ::formatRound(lRound, 'TRH.CMPROC'+cMoeda, ::jDecCM[cMoeda]) 
            cQuery += " * ORIG.QTDORI CUSTO"+cMoeda+", "
        Next nI
        cQuery += " ORIG.R_E_C_N_O_ RORI, "
        cQuery += " DEST.R_E_C_N_O_ RDES  "
        cQuery += " From "+::TableName()+" ORIG "
        cQuery += " Inner Join "+::TableName()+" DEST "
        cQuery += " On  DEST.FILPROC = ORIG.FILPROC "
        cQuery += " And DEST.IGNORE  = ? "
        cQuery += " And DEST.FILIAL  = ORIG.FILIAL "
        cQuery += " And DEST.COD     = ORIG.COD "
        If ::cCusFil == 'A'
            cQuery += " And DEST.LOCARM = ORIG.LOCARM "
        EndIf
        cQuery += " And DEST.SEQ    = ORIG.SEQ"
        cQuery += " And DEST.ALIAS  = ? "
        cQuery += " And DEST.CF     = ? "
        cQuery += " Inner Join "+cProcTable+" TRH On "
        cQuery += "     TRH.FILPROC   = ORIG.FILPROC "
        If ::cCusFil != 'E'
            cQuery += " And TRH.FILIAL    = ORIG.FILIAL  "
        EndIf
        cQuery += " And TRH.COD       = ORIG.COD "
        If ::cCusFil == 'A'
            cQuery += " And TRH.ARMAZEM   = ORIG.LOCARM "
        EndIf
        cQuery += " Where ORIG.FILPROC = ? "
        cQuery += "   And ORIG.IGNORE  = ? "
        cQuery += "   And ORIG.FILIAL  = ? "
        cQuery += "   And ORIG.ALIAS   = ? "
        cQuery += "   And ORIG.CF      = ? "
        If ::cCusFil == 'E'
            cViewID := "VW_"+ViewTransferInvoice():GetViewID() + "_" + cEmpAnt
            cQuery += " Union All "
            cQuery += " Select "
            For nI := 1 To Len(::jParams['moedas'])
                cMoeda := ::jParams['moedas',nI]
                cQuery += ::formatRound(lRound, 'TRH.CMPROC'+cMoeda, ::jDecCM[cMoeda]) 
                cQuery += " * ORIG.QTDORI CUSTO"+cMoeda+", "
            Next nI
            cQuery += " ORIG.R_E_C_N_O_ RORI, "
            cQuery += " DEST.R_E_C_N_O_ RDES  "
            cQuery += " From "+::TableName()+" DEST "
            cQuery += " Inner Join "+cViewID+" TRF "
            cQuery += "    On TRF.RECDES = DEST.RECNO "
            cQuery += "   And TRF.D2_EMISSAO >= ? "
            cQuery += "   And TRF.D2_EMISSAO <= ? "
            cQuery += " Inner Join "+::TableName()+" ORIG "
            cQuery += "    On ORIG.FILPROC = DEST.FILPROC "
            cQuery += "   And ORIG.IGNORE  = ? "
            cQuery += "   And ORIG.FILIAL  = TRF.FILORI"
            cQuery += "   And ORIG.ALIAS = ? "
            cQuery += "   And ORIG.FILTRF = ? "
            cQuery += "   And ORIG.RECNO = TRF.RECORI "
            cQuery += " Inner Join "+cProcTable+" TRH On "
            cQuery += "     TRH.FILPROC   = ORIG.FILPROC "
            cQuery += " And TRH.COD       = ORIG.COD "
            cQuery += " Where DEST.FILPROC = ? "
            cQuery += "   And DEST.IGNORE  = ? "
            cQuery += "   And DEST.FILIAL  = ? "
            cQuery += "   And DEST.ALIAS   = ? "
            cQuery += "   And DEST.FILTRF  = ? "
        EndIf

        cQuery := ChangeQuery(cQuery)

        ::oQueryTransf := FWExecStatement():New(cQuery)
    EndIf

    For nFil := 1 To Len(::aFilProc)
        cFilAtu := ::aFilProc[nFil, 1]

        FWFreeArray(aBind)
        aBind := {}
        AAdd(aBind, 'N') //IGNORE
        AAdd(aBind, 'SD3') //ALIAS
        AAdd(aBind, 'DE4') //CF
        AAdd(aBind, cFilProc) //ORIG.FILPROC
        AAdd(aBind, 'N') //ORIG.IGNORE
        AAdd(aBind, cFilAtu) //ORIG.FILIAL
        AAdd(aBind, 'SD3') //ORIG.ALIAS
        AAdd(aBind, 'RE4') //ORIG.CF
        If ::cCusFil == 'E'
            AAdd(aBind, DToS(dDtIni)) // TRF.D2_EMISSAO
            AAdd(aBind, DToS(dDtFim)) // TRF.D2_EMISSAO
            AAdd(aBind, 'N') // ORIG.IGNORE
            AAdd(aBind, 'SD2') // ORIG.ALIAS
            AAdd(aBind, '1') // ORIG.FILTRF
            AAdd(aBind, cFilProc) //DEST.FILPROC
            AAdd(aBind, 'N') //DEST.IGNORE
            AAdd(aBind, cFilAtu) //DEST.FILIAL
            AAdd(aBind, 'SD1') //DEST.ALIAS
            AAdd(aBind, '1') //DEST.FILTRF
        EndIf

        For nI := 1 To Len(aBind)
            ::oQueryTransf:SetString(nI, aBind[nI])
        Next nI

        cQuery := " ( "+::oQueryTransf:GetFixQuery()+" ) "

        If ::lOracle
            cQuery += " TEMPTABLE "
            cQuery += " On ("
            cQuery += " "+::TableName()+".R_E_C_N_O_ = TEMPTABLE.RORI Or "
            cQuery += " "+::TableName()+".R_E_C_N_O_ = TEMPTABLE.RDES "
            cQuery += " ) "
            cQuery += " When Matched Then "
        EndIf

        If !::lOracle
            cUpdate := " Update "+::TableName()+" "
        Else
            cUpdate := " Update "
        EndIf
        cUpdate += "    Set "
        For nI := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nI]
            cUpdate += " CSTOR"+cMoeda+" = TEMPTABLE.CUSTO"+cMoeda+", "
        Next nI
        cUpdate += " IGNORE = 'S' "

        If !::lOracle
            cUpdate += " From TEMPTABLE "
        EndIf
        cUpdate += " Where "
        cUpdate += " "+::TableName()+".R_E_C_N_O_ = TEMPTABLE.RORI Or "
        cUpdate += " "+::TableName()+".R_E_C_N_O_ = TEMPTABLE.RDES "

        ::RunQuery(cCTE+cQuery+cUpdate)
    Next nFil

    FWFreeArray(aBind)
Return

/*/{Protheus.doc} IgnoreThirdPartyMovements
    Marca os movimentos de terceiros que não serão considerados no loop de processamento
    quando existir a remessa no mesmo período da devolução e quando a remessa foi totalmente
    baixada
    @author Squad Entradas
    @since 17/01/2025
/*/
Method IgnoreThirdPartyMovements(cFilProc) Class AnalyticalMovementTable
    local cFieldsUpd    as character
    local cMatchFilter  as character
    local cCteStatement as character
    local cQuery        as character
    local cFilAtu       as character
    local cMoeda        as character
    local cTableMov     := ::TableName() as character
    local nFil          as numeric
    local nX            as numeric

    /*Query que calcula o saldo total devolvido para comparar, caso exista, com
    a quantidade e custo original da remessa e complemento*/
    If ::oQueryThirdParty == Nil
        cQuery := " SELECT A.FILPROC,A.FILIAL,A.IDENTB6, "
        cQuery += " MAX(CASE WHEN A.PODER3 = 'R' AND A.QUANT > 0 THEN 'S' ELSE 'N' END) REMESSANOPERIODO, "
        cQuery += " SUM(CASE WHEN A.PODER3 = 'R' THEN A.QUANT ELSE 0 END) QTDORIG, "
        cQuery += " SUM(CASE WHEN A.PODER3 = 'R' THEN A.CUSTO1 ELSE 0 END) CUSTOORI1, "
        cQuery += " SUM(CASE WHEN A.PODER3 = 'R' THEN A.CUSTO2 ELSE 0 END) CUSTOORI2, "
        cQuery += " SUM(CASE WHEN A.PODER3 = 'R' THEN A.CUSTO3 ELSE 0 END) CUSTOORI3, "
        cQuery += " SUM(CASE WHEN A.PODER3 = 'R' THEN A.CUSTO4 ELSE 0 END) CUSTOORI4, "
        cQuery += " SUM(CASE WHEN A.PODER3 = 'R' THEN A.CUSTO5 ELSE 0 END) CUSTOORI5, "
        cQuery += " SUM(CASE WHEN A.PODER3 = 'D' THEN A.QUANT ELSE 0 END) QTDDEV, "
        cQuery += " SUM(CASE WHEN A.PODER3 = 'D' THEN A.CUSTO1 ELSE 0 END) CUSTODEV1, "
        cQuery += " SUM(CASE WHEN A.PODER3 = 'D' THEN A.CUSTO2 ELSE 0 END) CUSTODEV2, "
        cQuery += " SUM(CASE WHEN A.PODER3 = 'D' THEN A.CUSTO3 ELSE 0 END) CUSTODEV3, "
        cQuery += " SUM(CASE WHEN A.PODER3 = 'D' THEN A.CUSTO4 ELSE 0 END) CUSTODEV4, "
        cQuery += " SUM(CASE WHEN A.PODER3 = 'D' THEN A.CUSTO5 ELSE 0 END) CUSTODEV5 "
        cQuery += " FROM " +cTableMov+" A "
        cQuery += " WHERE A.FILPROC = ? AND "
        cQuery += " A.FILIAL = ? AND "
        cQuery += " A.IDENTB6 <> ? "
        cQuery += " GROUP BY A.FILPROC,A.FILIAL,A.IDENTB6 "

        cQuery := ChangeQuery(cQuery)

        ::oQueryThirdParty := FWExecStatement():New(cQuery)
    EndIf

    /*Update que marca o campo ignore com S para as devoluções de terceiro caso
    a remessa esteja no período e marca a remessa também caso tenha sido devolvido total*/
    cFieldsUpd := " IGNORE = CASE WHEN "
    cFieldsUpd += " (("+cTableMov+".PODER3 = 'D' OR ("+cTableMov+".TIPONF = 'C' AND "+cTableMov+".QUANT = 0) OR TEMPTABLE.QTDORIG = TEMPTABLE.QTDDEV) AND TEMPTABLE.REMESSANOPERIODO = 'S') THEN 'S' ELSE 'N' END, "
    cFieldsUpd += " QUANT = CASE WHEN "+cTableMov+".PODER3 = 'R' AND "+cTableMov+".QUANT > 0 THEN TEMPTABLE.QTDORIG - TEMPTABLE.QTDDEV ELSE "+cTableMov+".QUANT END "
    For nX := 1 to 5
        cMoeda  := cValToChar(nX)
        cFieldsUpd += " ,CUSTO"+cMoeda+" = CASE WHEN "+cTableMov+".PODER3 = 'R' AND "+cTableMov+".QUANT > 0 AND "+cTableMov+".CUSTO"+cMoeda+" > 0 THEN TEMPTABLE.CUSTOORI"+cMoeda+" - TEMPTABLE.CUSTODEV"+cMoeda+" ELSE "+cTableMov+".CUSTO"+cMoeda+" END "
    Next nX

    cMatchFilter := cTableMov+".FILPROC = TEMPTABLE.FILPROC AND 
    cMatchFilter += cTableMov+".FILIAL = TEMPTABLE.FILIAL AND "
    cMatchFilter += cTableMov+".IDENTB6 = TEMPTABLE.IDENTB6 "

    For nFil := 1 to Len(::aFilProc)
        cFilAtu := ::aFilProc[nFil, 1]

        ::oQueryThirdParty:SetString(1,cFilProc)
        ::oQueryThirdParty:SetString(2,cFilAtu)
        ::oQueryThirdParty:SetString(3,' ')
        
        cQuery := ::oQueryThirdParty:GetFixQuery()
        cCteStatement := ::buildCteStatement(cTableMov,cFieldsUpd,cMatchFilter,cQuery)
        ::RunQuery(cCteStatement)
    Next nFil

Return

/*/{Protheus.doc} IgnorePurchaseReturn
    - Marca os movimentos de devolução de compras onde a compra ocorreu no mesmo período
    para serem ignorados. 
    - Abate o custo e quantidade da tabela de processamento
    - Quando a compra aconteceu fora do período, executa a mesma regra do MATA330
    com o parâmetro MV_ADEVCOM ligado:
        - Se houver saldo histórico suficiente (inicial+compras), realiza a devolução total do custo/quantidade
        - Se não houver saldo histórico suficiente, realiza a devolução a custo médio.
    Abate do valor histórico da tabela de processamento e marca as devoluções como ignoradas
    @author Squad Entradas
    @type method
    @since 23/01/2024
    /*/
Method IgnorePurchaseReturn(cFilProc, dDtIni, dDtFim) Class AnalyticalMovementTable
    Local cQuery  := ""
    Local cUpdate := ""
    Local cCTE    := ""
    Local nFil    := ""
    Local cFilAtu := ""
    Local aBind   := {}
    Local nI      := 0
    Local cProcTable := ProcessingTable():TableName()
    Local nMoeda  := 0
    Local cMoeda  := ''
    Local cNull      := MatIsNull()
    Local cExpr   := ""
    Local cSum    := ""

    If !::lOracle
        cCTE := " With TEMPTABLE As "
    Else
        cCTE := " Merge Into "+::TableName()+" Using "
    EndIf

    //Nota origem dentro do período
    //Marca as notas de devolução como ignoradas e atualiza o custo na tabela analitica
    If ::oQueryPurchRet == Nil
        cQuery := " Select "
        For nMoeda := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nMoeda]
            cQuery += " SD1.D1_CUSTO"
            If nMoeda > 1
                cQuery += cMoeda+" "
            EndIf
            cQuery += " D1CUSTO"+cMoeda+", "
        Next nMoeda
        cQuery += " SD1.D1_QUANT D1QUANT, "
        cQuery += " DEV.QUANT DEVQUANT, "
        cQuery += " DEV.R_E_C_N_O_ RECNUMBER "
        cQuery += " From "+RetSQLName("SD2")+" SD2 "
        cQuery += " Inner Join "+::cViewAcquisCst+" SD1 On "
        cQuery += " SD1.D1_FILIAL  = SD2.D2_FILIAL  And "
        cQuery += " SD1.D1_DOC     = SD2.D2_NFORI   And "
        cQuery += " SD1.D1_SERIE   = SD2.D2_SERIORI And "
        cQuery += " SD1.D1_ITEM    = SD2.D2_ITEMORI And "
        cQuery += " SD1.D1_FORNECE = SD2.D2_CLIENTE And "
        cQuery += " SD1.D1_LOJA    = SD2.D2_LOJA    And "
        cQuery += " SD1.D1_DTDIGIT >= ? And "
        cQuery += " SD1.D1_DTDIGIT <= ? "
        If  ::jVwAcquistCstParams["SF4_EMPRESA"] != FWModeAccess("SD1", 1) .Or. ;
            ::jVwAcquistCstParams["SF4_UNIDADE"] != FWModeAccess("SD1", 2) .Or. ;
            ::jVwAcquistCstParams["SF4_FILIAL"]  != FWModeAccess("SD1", 3)
            cQuery += " And SD1.F4_FILIAL = ? "
        EndIf
        cQuery += " Inner Join "+::TableName()+" DEV On "
        cQuery += " DEV.FILPROC = ? And "
        cQuery += " DEV.ALIAS   = ? And "
        cQuery += " DEV.RECNO   = SD2.R_E_C_N_O_ "
        cQuery += " Where "
        cQuery += " SD2.D2_FILIAL   = ? And "
        cQuery += " SD2.D2_EMISSAO >= ? And "
        cQuery += " SD2.D2_EMISSAO <= ? And "
        cQuery += " SD2.D2_TIPO     = ? And "
        cQuery += " SD2.D_E_L_E_T_  = ? "
       
        cQuery := ChangeQuery(cQuery)

        ::oQueryPurchRet := FWExecStatement():New(cQuery)
    EndIf

    For nFil := 1 To Len(::aFilProc)
        cFilAtu := ::aFilProc[nFil, 1]

        FWFreeArray(aBind)
        aBind := {}
        AAdd(aBind, DToS(dDtIni)) //D1_DTDIGIT
        AAdd(aBind, DToS(dDtFim)) //D1_DTDIGIT
        If  ::jVwAcquistCstParams["SF4_EMPRESA"] != FWModeAccess("SD1", 1) .Or. ;
            ::jVwAcquistCstParams["SF4_UNIDADE"] != FWModeAccess("SD1", 2) .Or. ;
            ::jVwAcquistCstParams["SF4_FILIAL"]  != FWModeAccess("SD1", 3)
            AAdd(aBind, FWXFilial('SF4', cFilAtu)) //F4_FILIAL
        EndIf
        AAdd(aBind, cFilProc) //FILPROC
        AAdd(aBind, 'SD2') //ALIAS
        AAdd(aBind, cFilAtu) //D2_FILIAL
        AAdd(aBind, DToS(dDtIni)) //D2_EMISSAO
        AAdd(aBind, DToS(dDtFim)) //D2_EMISSAO
        AAdd(aBind, 'D') //D2_TIPO
        AAdd(aBind, ' ') //D_E_L_E_T_

        For nI := 1 To Len(aBind)
            ::oQueryPurchRet:SetString(nI, aBind[nI])
        Next nI

        cQuery := " ( "+::oQueryPurchRet:GetFixQuery()+" ) "

        If ::lOracle
            cQuery += " TEMPTABLE "
            cQuery += " On ("
            cQuery += " "+::TableName()+".R_E_C_N_O_ = TEMPTABLE.RECNUMBER "
            cQuery += " ) "
            cQuery += " When Matched Then "
        EndIf

        If !::lOracle
            cUpdate := " Update "+::TableName()+" "
        Else
            cUpdate := " Update "
        EndIf
        cUpdate += "    Set "
        For nMoeda := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nMoeda]
            cUpdate += " CUSTO"+cMoeda+" = "
            cUpdate += " Case "
            cUpdate += "    When TEMPTABLE.D1QUANT <> 0 Then "
            cUpdate += "       TEMPTABLE.DEVQUANT * (TEMPTABLE.D1CUSTO"+cMoeda+"/TEMPTABLE.D1QUANT) "
            cUpdate += "    Else " //Notas de devolução de complemento de preço
            cUpdate += "       TEMPTABLE.D1CUSTO"+cMoeda+" "
            cupdate += " End, "

            cUpdate += " CSTOR"+cMoeda+" = "
            cUpdate += " Case "
            cUpdate += "    When TEMPTABLE.D1QUANT <> 0 Then "
            cUpdate += "       TEMPTABLE.DEVQUANT * (TEMPTABLE.D1CUSTO"+cMoeda+"/TEMPTABLE.D1QUANT) "
            cUpdate += "    Else " //Notas de devolução de complemento de preço
            cUpdate += "       TEMPTABLE.D1CUSTO"+cMoeda+" "
            cupdate += " End, "
        Next nMoeda
        cUpdate += " IGNORE     = 'S', "
        cUpdate += " CUSTOMEDIO = 'N', "
        cUpdate += " PREPROC    = 'S' "

        If !::lOracle
            cUpdate += " From TEMPTABLE "
        EndIf
        cUpdate += " Where "
        cUpdate += " "+::TableName()+".R_E_C_N_O_ = TEMPTABLE.RECNUMBER "

        ::RunQuery(cCTE+cQuery+cUpdate)
    Next nFil

    //Abate o saldo devolvido da tabela de processamento
    If !::lOracle
        cCTE := " With TEMPTABLE As "
    Else
        cCTE := " Merge Into "+cProcTable+" Using "
    EndIf

    If ::oQueryPurchRetProc == Nil
        cQuery := " Select "
        cQuery += " DEV.FILPROC, "
        If ::cCusFil != "E"
            cQuery += " DEV.FILIAL, "
        EndIf
        cQuery += " DEV.COD, "
        If ::cCusFil == "A"
            cQuery += " DEV.LOCARM, "
        EndIf
        For nMoeda := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nMoeda]
            cQuery += " -Sum(DEV.CUSTO"+cMoeda+") CUSTO"+cMoeda+", "
        Next nMoeda
        cQuery += " -Sum(DEV.QUANT) QUANT "
        cQuery += " From "+RetSQLName("SD2")+" SD2 "
        cQuery += " Inner Join "+::cViewAcquisCst+" SD1 On "
        cQuery += " SD1.D1_FILIAL  = SD2.D2_FILIAL  And "
        cQuery += " SD1.D1_DOC     = SD2.D2_NFORI   And "
        cQuery += " SD1.D1_SERIE   = SD2.D2_SERIORI And "
        cQuery += " SD1.D1_ITEM    = SD2.D2_ITEMORI And "
        cQuery += " SD1.D1_FORNECE = SD2.D2_CLIENTE And "
        cQuery += " SD1.D1_LOJA    = SD2.D2_LOJA    And "
        cQuery += " SD1.D1_DTDIGIT >= ? And "
        cQuery += " SD1.D1_DTDIGIT <= ? "
        If  ::jVwAcquistCstParams["SF4_EMPRESA"] != FWModeAccess("SD1", 1) .Or. ;
            ::jVwAcquistCstParams["SF4_UNIDADE"] != FWModeAccess("SD1", 2) .Or. ;
            ::jVwAcquistCstParams["SF4_FILIAL"]  != FWModeAccess("SD1", 3)
            cQuery += " And SD1.F4_FILIAL = ? "
        EndIf
        cQuery += " Inner Join "+::TableName()+" DEV On "
        cQuery += " DEV.FILPROC = ? And "
        cQuery += " DEV.ALIAS   = ? And "
        cQuery += " DEV.RECNO   = SD2.R_E_C_N_O_ "
        cQuery += " Where "
        cQuery += " SD2.D2_FILIAL   = ? And "
        cQuery += " SD2.D2_EMISSAO >= ? And "
        cQuery += " SD2.D2_EMISSAO <= ? And "
        cQuery += " SD2.D2_TIPO     = ? And "
        cQuery += " SD2.D_E_L_E_T_  = ? "
        cQuery += " Group By "
        cQuery += " DEV.FILPROC, "
        If ::cCusFil != "E"
            cQuery += " DEV.FILIAL, "
        EndIf
        cQuery += " DEV.COD "
        If ::cCusFil == "A"
            cQuery += " , DEV.LOCARM "
        EndIf
       
        cQuery := ChangeQuery(cQuery)

        ::oQueryPurchRetProc := FWExecStatement():New(cQuery)
    EndIf

    For nFil := 1 To Len(::aFilProc)
        cFilAtu := ::aFilProc[nFil, 1]

        FWFreeArray(aBind)
        aBind := {}
        AAdd(aBind, DToS(dDtIni)) //D1_DTDIGIT
        AAdd(aBind, DToS(dDtFim)) //D1_DTDIGIT
        If  ::jVwAcquistCstParams["SF4_EMPRESA"] != FWModeAccess("SD1", 1) .Or. ;
            ::jVwAcquistCstParams["SF4_UNIDADE"] != FWModeAccess("SD1", 2) .Or. ;
            ::jVwAcquistCstParams["SF4_FILIAL"]  != FWModeAccess("SD1", 3)
            AAdd(aBind, FWXFilial('SF4', cFilAtu)) //F4_FILIAL
        EndIf
        AAdd(aBind, cFilProc) //FILPROC
        AAdd(aBind, 'SD2') //ALIAS
        AAdd(aBind, cFilAtu) //D2_FILIAL
        AAdd(aBind, DToS(dDtIni)) //D2_EMISSAO
        AAdd(aBind, DToS(dDtFim)) //D2_EMISSAO
        AAdd(aBind, 'D') //D2_TIPO
        AAdd(aBind, ' ') //D_E_L_E_T_

        For nI := 1 To Len(aBind)
            ::oQueryPurchRetProc:SetString(nI, aBind[nI])
        Next nI

        cQuery := " ( "+::oQueryPurchRetProc:GetFixQuery()+" ) "

        If ::lOracle
            cQuery += " TEMPTABLE "
            cQuery += " On ("
            cQuery += " "+cProcTable+".FILPROC = TEMPTABLE.FILPROC And "
            If ::cCusFil != "E"
                cQuery += " "+cProcTable+".FILIAL  = TEMPTABLE.FILIAL  And "
            EndIf
            cQuery += " "+cProcTable+".COD     = TEMPTABLE.COD     "
            If ::cCusFil == 'A'
                cQuery += " And "+cProcTable+".ARMAZEM = TEMPTABLE.LOCARM "
            EndIf
            cQuery += " ) "
            cQuery += " When Matched Then "
        EndIf

        If !::lOracle
            cUpdate := " Update "+cProcTable+" "
        Else
            cUpdate := " Update "
        EndIf
        cUpdate += "    Set "

        cUpdate += "QTDHIST = "+cNull
        cUpdate += "("+cProcTable+".QTDHIST + TEMPTABLE.QUANT, 0),"
        cUpdate += "QTDPROC = "+cNull
        cUpdate += "("+cProcTable+".QTDPROC + TEMPTABLE.QUANT, 0),"
        For nMoeda := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nMoeda]
            cUpdate += "CSTHIST"+cMoeda+" = "+cNull
            cUpdate += "("+cProcTable+".CSTHIST"+cMoeda+" + TEMPTABLE.CUSTO"+cMoeda+", 0),"
            cUpdate += "CSTPROC"+cMoeda+" = "+cNull
            cUpdate += "("+cProcTable+".CSTPROC"+cMoeda+" + TEMPTABLE.CUSTO"+cMoeda+", 0),"
        Next nMoeda

        For nMoeda := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nMoeda]
            cUpdate += " CMHIST"+cMoeda+" = "
            cUpdate += " Case "
            cUpdate += "     When ("+cProcTable+".QTDHIST + TEMPTABLE.QUANT) <> 0 "
            cUpdate += "         Then "
            cUpdate += "             (("+cProcTable+".CSTHIST"+cMoeda+" + TEMPTABLE.CUSTO"+cMoeda+")"
            cUpdate += "              / "
            cUpdate += "              ("+cProcTable+".QTDHIST + TEMPTABLE.QUANT))"
            cUpdate += "         Else "+cProcTable+".CMHIST"+cMoeda+" "
            cUpdate += "     End, "

            cUpdate += " CMPROC"+cMoeda+" = "
            cUpdate += " Case "
            cUpdate += "     When ("+cProcTable+".QTDPROC + TEMPTABLE.QUANT) <> 0 "
            cUpdate += "         Then "
            cUpdate += "             (("+cProcTable+".CSTPROC"+cMoeda+" + TEMPTABLE.CUSTO"+cMoeda+")"
            cUpdate += "              / "
            cUpdate += "              ("+cProcTable+".QTDPROC + TEMPTABLE.QUANT))"
            cUpdate += "         Else "+cProcTable+".CMPROC"+cMoeda+" "
            cUpdate += "     End,"
        Next nMoeda
        cUpdate := Substr(cUpdate, 1, Len(cUpdate)-1)

        If !::lOracle
            cUpdate += " From TEMPTABLE "
        EndIf
        cUpdate += " Where "
        cUpdate += " "+cProcTable+".FILPROC = '"+cFilProc+"'   And "
        If ::cCusFil != "E"
            cUpdate += " "+cProcTable+".FILIAL  = TEMPTABLE.FILIAL And "
        EndIf
        cUpdate += " "+cProcTable+".COD     = TEMPTABLE.COD     "
        If ::cCusFil == 'A'
            cUpdate += " And "+cProcTable+".ARMAZEM = TEMPTABLE.LOCARM "
        EndIf

        ::RunQuery(cCTE+cQuery+cUpdate)
    Next nFil

    //Avalia as devoluções de compras que ocorreram fora do período

    //Marca as notas de devolução de compra fora do período como ignoradas
    //avalia se elas serão devolvidas com o custo integral, ou com o custo médio
    //conforme a regra do parâmetro MV_ADEVCOM = .T. (ver descrição do método)
    //através de subquery.
    //atualiza o custo conforme retorno da subquery e grava o campo DEVCM para indicar
    //que o retorno foi a custo médio ou custo original
    If !::lOracle
        cCTE := " With TEMPTABLE As "
    Else
        cCTE := " Merge Into "+::TableName()+" Using "
    EndIf

    If ::oQueryPurchRetPrev == Nil
        cQuery := " Select "
        cQuery += " DEV.R_E_C_N_O_ RECDEV, "
        cQuery += " DEV.QUANT DEVQUANT, "
        //Dados da nota original, caso retorne pelo custo total
        cQuery += " SD1.D1_QUANT D1QUANT, "
        For nMoeda := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nMoeda]
            cQuery += " SD1.D1_CUSTO"
            If nMoeda > 1
                cQuery += cMoeda+" "
            EndIf
            cQuery += " D1CUSTO"+cMoeda+", "
        Next nMoeda
        //Dados de custo médio, caso retorne pelo custo médio
        For nMoeda := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nMoeda]
            cQuery += " PRC.CMHIST"+cMoeda+" CMHIST"+cMoeda+", "
        Next nMoeda
        //Subquery para determinar se existe saldo suficiente para retornar o custo total,
        //ou se retornará pelo custo médio.
        //Cláusula Sum -> Custo total a ser devolvido neste período com base na nota de compra original
        cQuery += " ( "

        cSum := " Sum ( "
        cSum += "    Case "
        cSum += "    When "
        cSum += "         SUBSD1.D1_QUANT <> 0 "
        cSum += "    Then "
        cSum += "         SUBDEV.QUANT*(SUBSD1.D1_CUSTO###/SUBSD1.D1_QUANT) "
        cSum += "    Else "
        cSum += "         SUBSD1.D1_CUSTO### "
        cSum += "    End ) "
        cQuery += " Select "
        cQuery += " Case "
        cQuery += "    When "
        For nMoeda := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nMoeda]
            If nMoeda == 1
                cQuery += StrTran(cSum, "###", "")
            Else
                cQuery += StrTran(cSum, "###", cMoeda)
            EndIf
            cQuery += " > SUBPRC.CSTHIST"+cMoeda+" "
            cQuery += " Or "
        Next nMoeda
        cQuery += " Sum(SUBDEV.QUANT) > SUBPRC.QTDHIST "
        cQuery += "    Then 'S' "
        cQuery += "    Else 'N' "
        cQuery += " End " //Flag indicando se a devolução será a custo médio ou não
        cQuery += " From "
        cQuery += RetSQLName("SD2")+" SUBSD2 "
        cQuery += " Inner Join "+::TableName()+" SUBDEV On "
        cQuery += " SUBDEV.FILPROC    = ? And "
        cQuery += " SUBDEV.ALIAS      = ? And " //SD2
        cQuery += " SUBDEV.RECNO      = SUBSD2.R_E_C_N_O_ "
        cQuery += " Inner Join "+RetSQLName("SD1")+" SUBSD1 On "
        cQuery += " SUBSD1.D1_FILIAL  = SUBSD2.D2_FILIAL  And "
        cQuery += " SUBSD1.D1_DOC     = SUBSD2.D2_NFORI   And "
        cQuery += " SUBSD1.D1_SERIE   = SUBSD2.D2_SERIORI And "
        cQuery += " SUBSD1.D1_ITEM    = SUBSD2.D2_ITEMORI And "
        cQuery += " SUBSD1.D1_FORNECE = SUBSD2.D2_CLIENTE And "
        cQuery += " SUBSD1.D1_LOJA    = SUBSD2.D2_LOJA    And "
        cQuery += " SUBSD1.D1_DTDIGIT < ? "
        cQuery += " Inner Join "+RetSQLName('SF4')+" SUBSF4 On "
        cQuery += " SUBSF4.F4_FILIAL  = ? And "
        cQuery += " SUBSF4.F4_CODIGO  = SUBSD1.D1_TES And "
        cQuery += " SUBSF4.F4_ESTOQUE = ? And "
        cQuery += " SUBSF4.F4_PODER3  In (?, ?) And " //Poder de 3º será trabalhado em outro método
        cQuery += " SUBSF4.D_E_L_E_T_ = ? "
        cQuery += " Inner Join "+cProcTable+" SUBPRC On "
        cQuery += " SUBPRC.FILPROC = SUBDEV.FILPROC And "
        If ::cCusFil != "E"
            cQuery += " SUBPRC.FILIAL  = SUBDEV.FILIAL  And "
        EndIf
        cQuery += " SUBPRC.COD     = SUBDEV.COD      "
        If ::cCusFil == 'A'
            cQuery += " And SUBPRC.ARMAZEM = SUBDEV.LOCARM  "
        EndIf
        cQuery += " Where "
        cQuery += " SUBSD2.D2_FILIAL  =  ? And "
        cQuery += " SUBSD2.D2_EMISSAO >= ? And "
        cQuery += " SUBSD2.D2_EMISSAO <= ? And "
        cQuery += " SUBSD2.D2_TIPO    =  ? And "
        cQuery += " SUBSD2.D_E_L_E_T_ =  ? And "
        //Vínculo com a query principal
        cQuery += " SUBPRC.FILPROC    = PRC.FILPROC And "
        If ::cCusFil != "E"
            cQuery += " SUBPRC.FILIAL  = PRC.FILIAL  And "
        EndIf
        cQuery += " SUBPRC.COD     = PRC.COD      "
        If ::cCusFil == 'A'
            cQuery += " And SUBPRC.ARMAZEM = PRC.ARMAZEM "
        EndIf
        cQuery += " Group By "
        cQuery += " SUBDEV.FILPROC, "
        If ::cCusFil != "E"
            cQuery += " SUBDEV.FILIAL, "
        EndIf
        cQuery += " SUBDEV.COD, "
        If ::cCusFil == "A"
            cQuery += " SUBDEV.LOCARM, "
        EndIf
        For nMoeda := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nMoeda]
            cQuery += " SUBPRC.CSTHIST"+cMoeda+", "
        Next nMoeda
        cQuery += " SUBPRC.QTDHIST "
        cQuery += " ) DEVCUSTOMEDIO " //Fim Subquery
        cQuery += " From "+RetSQLName("SD2")+" SD2 "
        cQuery += " Inner Join "+::TableName()+" DEV On "
        cQuery += " DEV.FILPROC = ? And "
        cQuery += " DEV.ALIAS   = ? And "
        cQuery += " DEV.RECNO   = SD2.R_E_C_N_O_ "
        cQuery += " Inner Join "+RetSQLName("SD1")+" SD1 On "
        cQuery += " SD1.D1_FILIAL  = SD2.D2_FILIAL  And "
        cQuery += " SD1.D1_DOC     = SD2.D2_NFORI   And "
        cQuery += " SD1.D1_SERIE   = SD2.D2_SERIORI And "
        cQuery += " SD1.D1_ITEM    = SD2.D2_ITEMORI And "
        cQuery += " SD1.D1_FORNECE = SD2.D2_CLIENTE And "
        cQuery += " SD1.D1_LOJA    = SD2.D2_LOJA    And "
        cQuery += " SD1.D1_DTDIGIT < ? "
        cQuery += " Inner Join "+RetSQLName('SF4')+" SF4 On "
        cQuery += " SF4.F4_FILIAL  = ? And "
        cQuery += " SF4.F4_CODIGO  = SD1.D1_TES And "
        cQuery += " SF4.F4_ESTOQUE = ? And "
        cQuery += " SF4.F4_PODER3  In (?, ?) And " //Poder de 3º será trabalhado em outro método
        cQuery += " SF4.D_E_L_E_T_ = ? "
        cQuery += " Inner Join "+cProcTable+" PRC On "
        cQuery += " PRC.FILPROC = DEV.FILPROC And "
        If ::cCusFil != "E"
            cQuery += " PRC.FILIAL  = DEV.FILIAL  And "
        EndIf
        cQuery += " PRC.COD     = DEV.COD      "
        If ::cCusFil == 'A'
            cQuery += " And PRC.ARMAZEM = DEV.LOCARM  "
        EndIf
        cQuery += " Where "
        cQuery += " SD2.D2_FILIAL   = ? And "
        cQuery += " SD2.D2_EMISSAO >= ? And "
        cQuery += " SD2.D2_EMISSAO <= ? And "
        cQuery += " SD2.D2_TIPO     = ? And "
        cQuery += " SD2.D_E_L_E_T_  = ? "

        cQuery := ChangeQuery(cQuery)

        ::oQueryPurchRetPrev := FWExecStatement():New(cQuery)
    EndIf

    For nFil := 1 To Len(::aFilProc)
        cFilAtu := ::aFilProc[nFil, 1]

        FWFreeArray(aBind)
        aBind := {}
        //Filtro subquery
        AAdd(aBind, cFilProc) //SUB.FILPROC
        AAdd(aBind, 'SD2') //SUB.ALIAS
        AAdd(aBind, DToS(dDtIni)) //SUBSD1.D1_DTDIGIT
        AAdd(aBind, FWXFilial('SF4', cFilAtu)) //SUBSF4.F4_FILIAL
        AAdd(aBind, 'S') //SUBSF4.F4_ESTOQUE
        AAdd(aBind, ' ') //SUBSF4.F4PODER3
        AAdd(aBind, 'N') //SUBSF4.F4PODER3
        AAdd(aBind, ' ') //SUBSF4.D_E_L_E_T_
        AAdd(aBind, cFilAtu) //SD2SUB.D2_FILIAL
        AAdd(aBind, DToS(dDtIni)) //SD2SUB.D2_EMISSAO
        AAdd(aBind, DToS(dDtFim)) //SD2SUB.D2_EMISSAO
        AAdd(aBind, 'D') //SD2SUB.D2_TIPO
        AAdd(aBind, ' ') //SD2SUB.D_E_L_E_T_
        //filtro query principal
        AAdd(aBind, cFilProc) //FILPROC
        AAdd(aBind, 'SD2') //ALIAS
        AAdd(aBind, DToS(dDtIni)) //SD1.D1_DTDIGIT
        AAdd(aBind, FWXFilial('SF4', cFilAtu)) //F4_FILIAL
        AAdd(aBind, 'S') //SF4.F4_ESTOQUE
        AAdd(aBind, ' ') //SF4.F4PODER3
        AAdd(aBind, 'N') //SF4.F4PODER3
        AAdd(aBind, ' ') //SF4.D_E_L_E_T_
        AAdd(aBind, cFilAtu) //SD2.D2_FILIAL
        AAdd(aBind, DToS(dDtIni)) //SD2.D2_EMISSAO
        AAdd(aBind, DToS(dDtFim)) //SD2.D2_EMISSAO
        AAdd(aBind, 'D') //SD2.D2_TIPO
        AAdd(aBind, ' ') //SD2.D_E_L_E_T_

        For nI := 1 To Len(aBind)
            ::oQueryPurchRetPrev:SetString(nI, aBind[nI])
        Next nI

        cQuery := " ( "+::oQueryPurchRetPrev:GetFixQuery()+" ) "

        If ::lOracle
            cQuery += " TEMPTABLE "
            cQuery += " On ( "
            cQuery += " "+::TableName()+".R_E_C_N_O_ = TEMPTABLE.RECDEV "
            cQuery += " ) "
            cQuery += " When Matched Then "
        EndIf

        If !::lOracle
            cUpdate := " Update "+::TableName()+" "
        Else
            cUpdate := " Update "
        EndIf
        cUpdate += "    Set "
        For nMoeda := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nMoeda]
            cUpdate += " CUSTO"+cMoeda+" = "
            cUpdate += " Case "
            cUpdate += "    When TEMPTABLE.DEVCUSTOMEDIO = 'S' "
            cUpdate += "    Then "
            cUpdate += "    TEMPTABLE.DEVQUANT*TEMPTABLE.CMHIST"+cMoeda+" "
            cUpdate += "    Else "
            cUpdate += "    Case "
            cUpdate += "        When TEMPTABLE.D1QUANT <> 0 Then "
            cUpdate += "            TEMPTABLE.DEVQUANT * "
            cUpdate += "                (TEMPTABLE.D1CUSTO"+cMoeda+"/TEMPTABLE.D1QUANT) "
            cUpdate += "        Else " //Notas de devolução de complemento de preço
            cUpdate += "        TEMPTABLE.D1CUSTO"+cMoeda+" "
            cupdate += "    End "
            cupdate += " End, "

            cUpdate += " CSTOR"+cMoeda+" = "
            cUpdate += " Case "
            cUpdate += "    When TEMPTABLE.DEVCUSTOMEDIO = 'S' "
            cUpdate += "    Then "
            cUpdate += "    TEMPTABLE.DEVQUANT*TEMPTABLE.CMHIST"+cMoeda+" "
            cUpdate += "    Else "
            cUpdate += "    Case "
            cUpdate += "        When TEMPTABLE.D1QUANT <> 0 Then "
            cUpdate += "            TEMPTABLE.DEVQUANT * "
            cUpdate += "                (TEMPTABLE.D1CUSTO"+cMoeda+"/TEMPTABLE.D1QUANT) "
            cUpdate += "        Else " //Notas de devolução de complemento de preço
            cUpdate += "        TEMPTABLE.D1CUSTO"+cMoeda+" "
            cupdate += "    End "
            cupdate += " End, "
        Next nMoeda
        cUpdate += " IGNORE     = 'S', "
        cUpdate += " CUSTOMEDIO = 'N', "
        cUpdate += " PREPROC    = 'S', "
        cUpdate += " DEVCM      = TEMPTABLE.DEVCUSTOMEDIO "

        If !::lOracle
            cUpdate += " From TEMPTABLE "
        EndIf
        cUpdate += " Where "
        cUpdate += " "+::TableName()+".R_E_C_N_O_ = TEMPTABLE.RECDEV "

        ::RunQuery(cCTE+cQuery+cUpdate)
    Next nFil 

    //Abate o saldo devolvido da tabela de processamento
    If !::lOracle
        cCTE := " With TEMPTABLE As "
    Else
        cCTE := " Merge Into "+cProcTable+" Using "
    EndIf

    If ::oQueryPurchRetPrevProc == Nil
        cQuery := " Select "
        cQuery += " DEV.FILPROC   FILPROC, "
        If ::cCusFil != "E"
            cQuery += " DEV.FILIAL    FILIAL, "
        EndIf
        cQuery += " DEV.COD       COD, "
        If ::cCusFil == "A"
            cQuery += " DEV.LOCARM    LOCARM, "
        EndIf
        For nMoeda := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nMoeda]
            cQuery += " Sum(DEV.CUSTO"+cMoeda+") CUSTO"+cMoeda+", "
        Next nMoeda
        //Agora, com base no flag DEVCUSTOMEDIO, será verificada a regra descrita no cabeçalho,
        //conforme MV_ADEVCOM = .T.
        //Se houver saldo suficiente para ser retornado em todas as moedas e de quantidade,
        //o saldo será retornado integralmente. Se não houver saldo, será devolvido a custo médio.
        cQuery += " DEV.DEVCM DEVCUSTOMEDIO, " //Flag indicando se a devolução será a custo médio ou não
        cQuery += " Sum(DEV.QUANT) QTDDEV_TOTAL "
        cQuery += " From "
        cQuery += RetSQLName("SD2")+" SD2 "
        cQuery += " Inner Join "+::TableName()+" DEV On "
        cQuery += " DEV.FILPROC    = ? And "
        cQuery += " DEV.ALIAS      = ? And " //SD2
        cQuery += " DEV.RECNO      = SD2.R_E_C_N_O_ "
        cQuery += " Inner Join "+RetSQLName("SD1")+" SD1 On "
        cQuery += " SD1.D1_FILIAL  = SD2.D2_FILIAL  And "
        cQuery += " SD1.D1_DOC     = SD2.D2_NFORI   And "
        cQuery += " SD1.D1_SERIE   = SD2.D2_SERIORI And "
        cQuery += " SD1.D1_ITEM    = SD2.D2_ITEMORI And "
        cQuery += " SD1.D1_FORNECE = SD2.D2_CLIENTE And "
        cQuery += " SD1.D1_LOJA    = SD2.D2_LOJA    And "
        cQuery += " SD1.D1_DTDIGIT < ? "
        cQuery += " Inner Join "+RetSQLName('SF4')+" SF4 On "
        cQuery += " SF4.F4_FILIAL  = ? And "
        cQuery += " SF4.F4_CODIGO  = SD1.D1_TES And "
        cQuery += " SF4.F4_ESTOQUE = ? And "
        cQuery += " SF4.F4_PODER3  In (?, ?) And " //Poder de 3º será trabalhado em outro método
        cQuery += " SF4.D_E_L_E_T_ = ? "        
        cQuery += " Inner Join "+cProcTable+" PRC On "
        cQuery += " PRC.FILPROC = DEV.FILPROC And "
        If ::cCusFil != "E"
            cQuery += " PRC.FILIAL  = DEV.FILIAL  And "
        EndIf
        cQuery += " PRC.COD     = DEV.COD      "
        If ::cCusFil == 'A'
            cQuery += " And PRC.ARMAZEM = DEV.LOCARM  "
        EndIf
        cQuery += " Where "
        cQuery += " SD2.D2_FILIAL  =  ? And "
        cQuery += " SD2.D2_EMISSAO >= ? And "
        cQuery += " SD2.D2_EMISSAO <= ? And "
        cQuery += " SD2.D2_TIPO    =  ? And "
        cQuery += " SD2.D_E_L_E_T_ =  ? "
        cQuery += " Group By "
        cQuery += " DEV.FILPROC, "
        If ::cCusFil != "E"
            cQuery += " DEV.FILIAL, "
        EndIf
        cQuery += " DEV.COD, "
        If ::cCusFil == "A"
            cQuery += " DEV.LOCARM, "
        EndIf
        cQuery += " DEV.DEVCM "
       
        cQuery := ChangeQuery(cQuery)

        ::oQueryPurchRetPrevProc := FWExecStatement():New(cQuery)
    EndIf

    For nFil := 1 To Len(::aFilProc)
        cFilAtu := ::aFilProc[nFil, 1]

        FWFreeArray(aBind)
        aBind := {}
        AAdd(aBind, cFilProc) //FILPROC
        AAdd(aBind, 'SD2') //ALIAS
        AAdd(aBind, DToS(dDtIni)) //D1_DTDIGIT
        AAdd(aBind, FWXFilial('SF4', cFilAtu)) //F4_FILIAL
        AAdd(aBind, 'S') //SF4.F4_ESTOQUE
        AAdd(aBind, ' ') //SF4.F4PODER3
        AAdd(aBind, 'N') //SF4.F4PODER3
        AAdd(aBind, ' ') //SF4.D_E_L_E_T_
        AAdd(aBind, cFilAtu) //D2_FILIAL
        AAdd(aBind, DToS(dDtIni)) //D2_EMISSAO
        AAdd(aBind, DToS(dDtFim)) //D2_EMISSAO
        AAdd(aBind, 'D') //D2_TIPO
        AAdd(aBind, ' ') //D_E_L_E_T_

        For nI := 1 To Len(aBind)
            ::oQueryPurchRetPrevProc:SetString(nI, aBind[nI])
        Next nI

        cQuery := " ( "+::oQueryPurchRetPrevProc:GetFixQuery()+" ) "

        If ::lOracle
            cQuery += " TEMPTABLE "
            cQuery += " On ("
            cQuery += " "+cProcTable+".FILPROC = TEMPTABLE.FILPROC And "
            If ::cCusFil != "E"
                cQuery += " "+cProcTable+".FILIAL  = TEMPTABLE.FILIAL  And "
            EndIf
            cQuery += " "+cProcTable+".COD     = TEMPTABLE.COD     "
            If ::cCusFil == 'A'
                cQuery += " And "+cProcTable+".ARMAZEM = TEMPTABLE.LOCARM "
            EndIf
            cQuery += " ) "
            cQuery += " When Matched Then "
        EndIf

        If !::lOracle
            cUpdate := " Update "+cProcTable+" "
        Else
            cUpdate := " Update "
        EndIf
        cUpdate += "    Set "

        cExpr := " "+cProcTable+".CSTHIST### - TEMPTABLE.CUSTO### "

        cUpdate += " QTDHIST = "+cNull
        cUpdate += " ("+cProcTable+".QTDHIST - TEMPTABLE.QTDDEV_TOTAL, 0),"
        cUpdate += " QTDPROC = "+cNull
        cUpdate += " ("+cProcTable+".QTDPROC - TEMPTABLE.QTDDEV_TOTAL, 0),"
        For nMoeda := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nMoeda]
            cUpdate += "CSTHIST"+cMoeda+" = "
            cUpdate += StrTran(cExpr, "###", cMoeda)+","
            cUpdate += "CSTPROC"+cMoeda+" = " //Nesta etapa, custo histórico e processo são iguais.
            cUpdate += StrTran(cExpr, "###", cMoeda)+","
        Next nMoeda

        For nMoeda := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nMoeda]
            cUpdate += " CMHIST"+cMoeda+" = "
            cUpdate += " Case "
            cUpdate += "     When ("+cProcTable+".QTDHIST - TEMPTABLE.QTDDEV_TOTAL) <> 0 "
            cUpdate += "         Then "
            cUpdate += "("+StrTran(cExpr, "###", cMoeda)+")"
            cUpdate += "              / "
            cUpdate += "              ("+cProcTable+".QTDHIST - TEMPTABLE.QTDDEV_TOTAL)"
            cUpdate += "         Else "+cProcTable+".CMHIST"+cMoeda+" "
            cUpdate += "     End, "

            cUpdate += " CMPROC"+cMoeda+" = "
            cUpdate += " Case "
            cUpdate += "     When ("+cProcTable+".QTDHIST - TEMPTABLE.QTDDEV_TOTAL) <> 0 "
            cUpdate += "         Then "
            cUpdate += "("+StrTran(cExpr, "###", cMoeda)+")"
            cUpdate += "              / "
            cUpdate += "              ("+cProcTable+".QTDHIST - TEMPTABLE.QTDDEV_TOTAL)"
            cUpdate += "         Else "+cProcTable+".CMPROC"+cMoeda+" "
            cUpdate += "     End,"
        Next nMoeda
        cUpdate := Substr(cUpdate, 1, Len(cUpdate)-1)

        If !::lOracle
            cUpdate += " From TEMPTABLE "
        EndIf
        cUpdate += " Where "
        cUpdate += " "+cProcTable+".FILPROC = '"+cFilProc+"'   And "
        If ::cCusFil != "E"
            cUpdate += " "+cProcTable+".FILIAL  = TEMPTABLE.FILIAL And "
        EndIf
        cUpdate += " "+cProcTable+".COD     = TEMPTABLE.COD     "
        If ::cCusFil == 'A'
            cUpdate += " And "+cProcTable+".ARMAZEM = TEMPTABLE.LOCARM "
        EndIf

        ::RunQuery(cCTE+cQuery+cUpdate)
    Next nFil


    //Para notas não pré processadas pela View de custo de aquisição:
    //  Se a devolução ocorrer no período, deve:
    //      Marcar a nota de devolução como ingorada
    //      Abater o saldo proporcional da nota de compras e ajustar custo
    //  Se a devolução ocorrer fora do período, deve:
    //      Avaliar a regra do parâmetro MV_ADEVCOM para definir se a nota será devolvida
    //      com o custo original ou o custo médio
    //      Abater o saldo devolvido da tabela de processamento

    //Notas dentro do período
    //Marca as notas de devolução como ignoradas e calcula o custo proporcional da devolução
    If !::lOracle
        cCTE := " With TEMPTABLE As "
    Else
        cCTE := " Merge Into "+::TableName()+" Using "
    EndIf

    If ::oQueryOtherInflowRet == Nil
        cQuery := " Select "
        cQuery += " SD1.D1_QUANT D1QUANT, "
        For nMoeda := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nMoeda]
            cQuery += " D1_CUSTO"
            If nMoeda > 1
                cQuery += cMoeda
            EndIf
            cQuery += " D1CUSTO"+cMoeda+" , "
        Next nMoeda
        cQuery += " DEV.QUANT DEVQUANT, "
        cQuery += " DEV.R_E_C_N_O_ RECNUMBER "
        cQuery += " From "+::TableName()+" DEV "
        cQuery += " Inner Join "+RetSQLName("SD2")+" SD2 On "
        cQuery += " SD2.R_E_C_N_O_ = DEV.RECNO "
        cQuery += " Inner Join "+RetSQLName("SD1")+" SD1 On "
        cQuery += " SD1.D1_FILIAL  = SD2.D2_FILIAL  And "
        cQuery += " SD1.D1_DOC     = SD2.D2_NFORI   And "
        cQuery += " SD1.D1_SERIE   = SD2.D2_SERIORI And "
        cQuery += " SD1.D1_ITEM    = SD2.D2_ITEMORI And "
        cQuery += " SD1.D1_FORNECE = SD2.D2_CLIENTE And "
        cQuery += " SD1.D1_LOJA    = SD2.D2_LOJA    And "
        cQuery += " SD1.D1_EMISSAO >= ? And "
        cQuery += " SD1.D1_EMISSAO <= ? And "
        cQuery += " SD1.D_E_L_E_T_ = ? "
        cQuery += " Inner Join "+::TableName()+" COM On "
        cQuery += " COM.FILPROC = ? And "
        cQuery += " COM.ALIAS = ? And "
        cQuery += " COM.RECNO = SD1.R_E_C_N_O_ "
        cQuery += " Where "
        cQuery += " DEV.FILPROC = ? And "
        cQuery += " DEV.ALIAS   = ? And "
        cQuery += " DEV.FILIAL  = ? And "
        cQuery += " DEV.TIPONF  = ? " //D2_TIPO = D
       
        cQuery := ChangeQuery(cQuery)

        ::oQueryOtherInflowRet := FWExecStatement():New(cQuery)
    EndIf

    For nFil := 1 To Len(::aFilProc)
        cFilAtu := ::aFilProc[nFil, 1]

        FWFreeArray(aBind)
        aBind := {}
        AAdd(aBind, DToS(dDtIni)) //D1_EMISSAO
        AAdd(aBind, DToS(dDtFim)) //D1_EMISSAO
        AAdd(aBind, ' ') //D_E_L_E_T_
        AAdd(aBind, cFilProc) //FILPROC
        AAdd(aBind, 'SD1') //ALIAS
        AAdd(aBind, cFilProc) //FILPROC
        AAdd(aBind, 'SD2') //ALIAS
        AAdd(aBind, cFilAtu) //FILIAL
        AAdd(aBind, 'D') //TIPONF        

        For nI := 1 To Len(aBind)
            ::oQueryOtherInflowRet:SetString(nI, aBind[nI])
        Next nI

        cQuery := " ( "+::oQueryOtherInflowRet:GetFixQuery()+" ) "

        If ::lOracle
            cQuery += " TEMPTABLE "
            cQuery += " On ("
            cQuery += " "+::TableName()+".R_E_C_N_O_ = TEMPTABLE.RECNUMBER "
            cQuery += " ) "
            cQuery += " When Matched Then "
        EndIf

        If !::lOracle
            cUpdate := " Update "+::TableName()+" "
        Else
            cUpdate := " Update "
        EndIf
        cUpdate += "    Set "
        For nMoeda := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nMoeda]
            cUpdate += " CUSTO"+cMoeda+" = "
            cUpdate += " Case "
            cUpdate += "    When TEMPTABLE.D1QUANT <> 0 Then "
            cUpdate += "       TEMPTABLE.DEVQUANT * (TEMPTABLE.D1CUSTO"+cMoeda+"/TEMPTABLE.D1QUANT) "
            cUpdate += "    Else " //Notas de devolução de complemento de preço
            cUpdate += "       TEMPTABLE.D1CUSTO"+cMoeda+" "
            cupdate += " End, "

            cUpdate += " CSTOR"+cMoeda+" = "
            cUpdate += " Case "
            cUpdate += "    When TEMPTABLE.D1QUANT <> 0 Then "
            cUpdate += "       TEMPTABLE.DEVQUANT * (TEMPTABLE.D1CUSTO"+cMoeda+"/TEMPTABLE.D1QUANT) "
            cUpdate += "    Else " //Notas de devolução de complemento de preço
            cUpdate += "       TEMPTABLE.D1CUSTO"+cMoeda+" "
            cupdate += " End, "
        Next nMoeda
        cUpdate += " IGNORE      = 'S', "
        cUpdate += " CUSTOMEDIO  = 'N', "
        cUpdate += " "
        cUpdate += " PREPROC     = 'N' "

        If !::lOracle
            cUpdate += " From TEMPTABLE "
        EndIf
        cUpdate += " Where "
        cUpdate += " "+::TableName()+".R_E_C_N_O_ = TEMPTABLE.RECNUMBER "

        ::RunQuery(cCTE+cQuery+cUpdate)
    Next nFil

    //Abate o saldo das notas de devolução nas notas de compras
    If !::lOracle
        cCTE := " With TEMPTABLE As "
    Else
        cCTE := " Merge Into "+::TableName()+" Using "
    EndIf

    If ::oQueryOtherInflowRetProc == Nil
        cQuery := " Select "
        cQuery += " COM.R_E_C_N_O_ COMRECNO, "
        For nMoeda := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nMoeda]
            cQuery += " Sum(DEV.CUSTO"+cMoeda+") DEVCUSTO"+cMoeda+", "
        Next nMoeda
        cQuery += " Sum(DEV.QUANT) DEVQUANT "
        cQuery += " From "+::TableName()+" DEV "
        cQuery += " Inner Join "+RetSQLName("SD2")+" SD2 On "
        cQuery += " SD2.R_E_C_N_O_ = DEV.RECNO "
        cQuery += " Inner Join "+RetSQLName("SD1")+" SD1 On "
        cQuery += " SD1.D1_FILIAL  = SD2.D2_FILIAL  And "
        cQuery += " SD1.D1_DOC     = SD2.D2_NFORI   And "
        cQuery += " SD1.D1_SERIE   = SD2.D2_SERIORI And "
        cQuery += " SD1.D1_ITEM    = SD2.D2_ITEMORI And "
        cQuery += " SD1.D1_FORNECE = SD2.D2_CLIENTE And "
        cQuery += " SD1.D1_LOJA    = SD2.D2_LOJA    And "
        cQuery += " SD1.D1_EMISSAO >= ? And "
        cQuery += " SD1.D1_EMISSAO <= ? And "
        cQuery += " SD1.D_E_L_E_T_ = ?"
        cQuery += " Inner Join "+::TableName()+" COM On "
        cQuery += " COM.FILPROC = ? And "
        cQuery += " COM.ALIAS   = ? And " //SD1
        cQuery += " COM.RECNO   = SD1.R_E_C_N_O_ "
        cQuery += " Where "
        cQuery += " DEV.FILPROC = ? And "
        cQuery += " DEV.FILIAL  = ? And "
        cQuery += " DEV.ALIAS   = ? And " //SD2
        cQuery += " DEV.TIPONF  = ? " //D-Devolução
        cQuery += " Group By "
        cQuery += " COM.R_E_C_N_O_ "
       
        cQuery := ChangeQuery(cQuery)

        ::oQueryOtherInflowRetProc := FWExecStatement():New(cQuery)
    EndIf

    For nFil := 1 To Len(::aFilProc)
        cFilAtu := ::aFilProc[nFil, 1]

        FWFreeArray(aBind)
        aBind := {}
        AAdd(aBind, DToS(dDtIni)) //D1_EMISSAO
        AAdd(aBind, DToS(dDtFim)) //D1_EMISSAO
        AAdd(aBind, ' ') //D_E_L_E_T_
        AAdd(aBind, cFilProc) //FILPROC
        AAdd(aBind, 'SD1') //ALIAS
        AAdd(aBind, cFilProc) //FILPROC
        AAdd(aBind, cFilAtu) //FILIAL
        AAdd(aBind, 'SD2') //ALIAS
        AAdd(aBind, 'D') //TIPONF

        For nI := 1 To Len(aBind)
            ::oQueryOtherInflowRetProc:SetString(nI, aBind[nI])
        Next nI

        cQuery := " ( "+::oQueryOtherInflowRetProc:GetFixQuery()+" ) "

        If ::lOracle
            cQuery += " TEMPTABLE "
            cQuery += " On ("
            cQuery += " "+::TableName()+".R_E_C_N_O_ = TEMPTABLE.COMRECNO "
            cQuery += " ) "
            cQuery += " When Matched Then "
        EndIf

        If !::lOracle
            cUpdate := " Update "+::TableName()+" "
        Else
            cUpdate := " Update "
        EndIf
        cUpdate += "    Set "
        For nMoeda := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nMoeda]
            cUpdate += " CUSTO"+cMoeda+" = "
            cUpdate += ::TableName()+".CUSTO"+cMoeda+" - TEMPTABLE.DEVCUSTO"+cMoeda+", "
        Next nMoeda
        cUpdate += " QUANT  = "+::TableName()+".QUANT - TEMPTABLE.DEVQUANT, "
        cUpdate += " IGNORE = "
        cUpdate += " Case "
        cUpdate += "   When "+::TableName()+".QUANT - TEMPTABLE.DEVQUANT <= 0 "
        cUpdate += "   Then 'S' "
        cUpdate += "   Else 'N' "
        cUpdate += " End " 

        If !::lOracle
            cUpdate += " From TEMPTABLE "
        EndIf
        cUpdate += " Where "
        cUpdate += " "+::TableName()+".R_E_C_N_O_ = TEMPTABLE.COMRECNO "

        ::RunQuery(cCTE+cQuery+cUpdate)
    Next nFil



    FWFreeArray(aBind)
Return

/*/{Protheus.doc} IgnoreSalesReturn
    Marca os movimentos de devolução de vendas onde a venda ocorreu no mesmo período. 
    Abate o custo e quantidade do movimento de venda, eventualmente marcando-o como ignorado.
    Quando a venda ocorre fora do período, avalia o parâmetro MV_CUSTDEV para definir se o custo
    devolvido será o custo original ou custo médio.

    O campo F4_DEVZERO não terá implementação inicial, pois a sua regra não se adequa a execução com loop.
    @type Method
    @author Squad Entradas
    @since 24/01/2024
    /*/
Method IgnoreSalesReturn(cFilProc, dDtIni, dDtFim) Class AnalyticalMovementTable
    Local cQuery  := ""
    Local cUpdate := ""
    Local cCTE    := ""
    Local nFil    := ""
    Local cFilAtu := ""
    Local aBind   := {}
    Local nI      := 0
    Local nMoeda  := 0
    Local cMoeda  := ''
    Local cProcTable := ProcessingTable():TableName()
    Local cNull      := MatIsNull()

    //Notas dentro do período
    //Marca as notas de devolução como ignoradas e valorizadas a custo médio
    If !::lOracle
        cCTE := " With TEMPTABLE As "
    Else
        cCTE := " Merge Into "+::TableName()+" Using "
    EndIf

    If ::oQuerySalesRet == Nil
        cQuery := " Select "
        cQuery += " DEV.R_E_C_N_O_ RECNUMBER "
        cQuery += " From "+::TableName()+" DEV "
        cQuery += " Inner Join "+RetSQLName("SD1")+" SD1 On "
        cQuery += " SD1.R_E_C_N_O_ = DEV.RECNO "
        cQuery += " Inner Join "+RetSQLName("SD2")+" SD2 On "
        cQuery += " SD2.D2_FILIAL  = SD1.D1_FILIAL  And "
        cQuery += " SD2.D2_DOC     = SD1.D1_NFORI   And "
        cQuery += " SD2.D2_SERIE   = SD1.D1_SERIORI And "
        cQuery += " SD2.D2_ITEM    = SD1.D1_ITEMORI And "
        cQuery += " SD2.D2_CLIENTE = SD1.D1_FORNECE And "
        cQuery += " SD2.D2_LOJA    = SD1.D1_LOJA    And "
        cQuery += " SD2.D2_EMISSAO >= ? And "
        cQuery += " SD2.D2_EMISSAO <= ? And "
        cQuery += " SD2.D_E_L_E_T_ = ?"
        cQuery += " Where "
        cQuery += " DEV.FILPROC = ? And "
        cQuery += " DEV.ALIAS   = ? And "
        cQuery += " DEV.FILIAL  = ? And "
        cQuery += " DEV.TIPONF  = ? " //D1_TIPO = D
       
        cQuery := ChangeQuery(cQuery)

        ::oQuerySalesRet := FWExecStatement():New(cQuery)
    EndIf

    For nFil := 1 To Len(::aFilProc)
        cFilAtu := ::aFilProc[nFil, 1]

        FWFreeArray(aBind)
        aBind := {}
        AAdd(aBind, DToS(dDtIni)) //D2_EMISSAO
        AAdd(aBind, DToS(dDtFim)) //D2_EMISSAO
        AAdd(aBind, ' ') //D_E_L_E_T_
        AAdd(aBind, cFilProc) //FILPROC
        AAdd(aBind, 'SD1') //ALIAS
        AAdd(aBind, cFilAtu) //FILIAL
        AAdd(aBind, 'D') //TIPONF        

        For nI := 1 To Len(aBind)
            ::oQuerySalesRet:SetString(nI, aBind[nI])
        Next nI

        cQuery := " ( "+::oQuerySalesRet:GetFixQuery()+" ) "

        If ::lOracle
            cQuery += " TEMPTABLE "
            cQuery += " On ("
            cQuery += " "+::TableName()+".R_E_C_N_O_ = TEMPTABLE.RECNUMBER "
            cQuery += " ) "
            cQuery += " When Matched Then "
        EndIf

        If !::lOracle
            cUpdate := " Update "+::TableName()+" "
        Else
            cUpdate := " Update "
        EndIf
        cUpdate += "    Set "
        cUpdate += " IGNORE      = 'S', "
        cUpdate += " CUSTOMEDIO  = 'S', "
        cUpdate += " PREPROC     = 'N' "

        If !::lOracle
            cUpdate += " From TEMPTABLE "
        EndIf
        cUpdate += " Where "
        cUpdate += " "+::TableName()+".R_E_C_N_O_ = TEMPTABLE.RECNUMBER "

        ::RunQuery(cCTE+cQuery+cUpdate)
    Next nFil

    //Abate o saldo devolvido das vendas na tabela de movimento
    If !::lOracle
        cCTE := " With TEMPTABLE As "
    Else
        cCTE := " Merge Into "+::TableName()+" Using "
    EndIf

    If ::oQuerySalesRetProc == Nil
        cQuery := " Select "
        cQuery += " VEN.R_E_C_N_O_ VENRECNO, "
        cQuery += " Sum(SD1.D1_QUANT) DEVQUANT "
        cQuery += " From "+::TableName()+" DEV "
        cQuery += " Inner Join "+RetSQLName("SD1")+" SD1 On "
        cQuery += " SD1.R_E_C_N_O_ = DEV.RECNO "
        cQuery += " Inner Join "+RetSQLName("SD2")+" SD2 On "
        cQuery += " SD2.D2_FILIAL  = SD1.D1_FILIAL  And "
        cQuery += " SD2.D2_DOC     = SD1.D1_NFORI   And "
        cQuery += " SD2.D2_SERIE   = SD1.D1_SERIORI And "
        cQuery += " SD2.D2_ITEM    = SD1.D1_ITEMORI And "
        cQuery += " SD2.D2_CLIENTE = SD1.D1_FORNECE And "
        cQuery += " SD2.D2_LOJA    = SD1.D1_LOJA    And "
        cQuery += " SD2.D2_EMISSAO >= ? And "
        cQuery += " SD2.D2_EMISSAO <= ? And "
        cQuery += " SD2.D_E_L_E_T_ = ?"
        cQuery += " Inner Join "+::TableName()+" VEN On "
        cQuery += " VEN.FILPROC = ? And "
        cQuery += " VEN.ALIAS   = ? And " //SD2
        cQuery += " VEN.RECNO   = SD2.R_E_C_N_O_ "
        cQuery += " Where "
        cQuery += " DEV.FILPROC = ? And "
        cQuery += " DEV.FILIAL  = ? And "
        cQuery += " DEV.ALIAS   = ? And " //SD1
        cQuery += " DEV.TIPONF  = ? " //D-Devolução
        cQuery += " Group By "
        cQuery += " VEN.R_E_C_N_O_ "
       
        cQuery := ChangeQuery(cQuery)

        ::oQuerySalesRetProc := FWExecStatement():New(cQuery)
    EndIf

    For nFil := 1 To Len(::aFilProc)
        cFilAtu := ::aFilProc[nFil, 1]

        FWFreeArray(aBind)
        aBind := {}
        AAdd(aBind, DToS(dDtIni)) //D2_EMISSAO
        AAdd(aBind, DToS(dDtFim)) //D2_EMISSAO
        AAdd(aBind, ' ') //D_E_L_E_T_
        AAdd(aBind, cFilProc) //FILPROC
        AAdd(aBind, 'SD2') //ALIAS
        AAdd(aBind, cFilProc) //FILPROC
        AAdd(aBind, cFilAtu) //FILIAL
        AAdd(aBind, 'SD1') //ALIAS
        AAdd(aBind, 'D') //TIPONF

        For nI := 1 To Len(aBind)
            ::oQuerySalesRetProc:SetString(nI, aBind[nI])
        Next nI

        cQuery := " ( "+::oQuerySalesRetProc:GetFixQuery()+" ) "

        If ::lOracle
            cQuery += " TEMPTABLE "
            cQuery += " On ("
            cQuery += " "+::TableName()+".R_E_C_N_O_ = TEMPTABLE.VENRECNO "
            cQuery += " ) "
            cQuery += " When Matched Then "
        EndIf

        If !::lOracle
            cUpdate := " Update "+::TableName()+" "
        Else
            cUpdate := " Update "
        EndIf
        cUpdate += "    Set "
        cUpdate += " QUANT  = "+::TableName()+".QUANT - TEMPTABLE.DEVQUANT, "
        cUpdate += " IGNORE = "
        cUpdate += " Case "
        cUpdate += "   When "+::TableName()+".QUANT - TEMPTABLE.DEVQUANT <= 0 "
        cUpdate += "   Then 'S' "
        cUpdate += "   Else 'N' "
        cUpdate += " End " 

        If !::lOracle
            cUpdate += " From TEMPTABLE "
        EndIf
        cUpdate += " Where "
        cUpdate += " "+::TableName()+".R_E_C_N_O_ = TEMPTABLE.VENRECNO "

        ::RunQuery(cCTE+cQuery+cUpdate)
    Next nFil

    //Avalia as devoluções de vendas que ocorreram fora do período
    If !::lOracle
        cCTE := " With TEMPTABLE As "
    Else
        cCTE := " Merge Into "+::TableName()+" Using "
    EndIf

    If ::oQuerySalesRetPrev == Nil
        cQuery := " Select "
        cQuery += " DEV.QUANT QUANT, "
        cQuery += " SD2.D2_QUANT D2_QUANT, "
        For nMoeda := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nMoeda]
            cQuery += " SD2.D2_CUSTO"+cMoeda+" D2_CUSTO"+cMoeda+", "
        Next nMoeda
        cQuery += " DEV.R_E_C_N_O_ RECNUMBER "
        cQuery += " From "+::TableName()+" DEV "
        cQuery += " Inner Join "+RetSQLName("SD1")+" SD1 On "
        cQuery += " SD1.R_E_C_N_O_ = DEV.RECNO "
        cQuery += " Inner Join "+RetSQLName("SD2")+" SD2 On "
        cQuery += " SD2.D2_FILIAL  = SD1.D1_FILIAL  And "
        cQuery += " SD2.D2_DOC     = SD1.D1_NFORI   And "
        cQuery += " SD2.D2_SERIE   = SD1.D1_SERIORI And "
        cQuery += " SD2.D2_ITEM    = SD1.D1_ITEMORI And "
        cQuery += " SD2.D2_CLIENTE = SD1.D1_FORNECE And "
        cQuery += " SD2.D2_LOJA    = SD1.D1_LOJA    And "
        cQuery += " SD2.D2_EMISSAO < ? And "
        cQuery += " SD2.D_E_L_E_T_ = ?"
        cQuery += " Where "
        cQuery += " DEV.FILPROC = ? And "
        cQuery += " DEV.ALIAS   = ? And "
        cQuery += " DEV.FILIAL  = ? And "
        cQuery += " DEV.TIPONF  = ? " //D1_TIPO = D
       
        cQuery := ChangeQuery(cQuery)

        ::oQuerySalesRetPrev := FWExecStatement():New(cQuery)
    EndIf

    For nFil := 1 To Len(::aFilProc)
        cFilAtu := ::aFilProc[nFil, 1]

        FWFreeArray(aBind)
        aBind := {}
        AAdd(aBind, DToS(dDtIni)) //D2_EMISSAO
        AAdd(aBind, ' ') //D_E_L_E_T_
        AAdd(aBind, cFilProc) //FILPROC
        AAdd(aBind, 'SD1') //ALIAS
        AAdd(aBind, cFilAtu) //FILIAL        
        AAdd(aBind, 'D') //TIPONF        

        For nI := 1 To Len(aBind)
            ::oQuerySalesRetPrev:SetString(nI, aBind[nI])
        Next nI

        cQuery := " ( "+::oQuerySalesRetPrev:GetFixQuery()+" ) "

        If ::lOracle
            cQuery += " TEMPTABLE "
            cQuery += " On ("
            cQuery += " "+::TableName()+".R_E_C_N_O_ = TEMPTABLE.RECNUMBER "
            cQuery += " ) "
            cQuery += " When Matched Then "
        EndIf

        If !::lOracle
            cUpdate := " Update "+::TableName()+" "
        Else
            cUpdate := " Update "
        EndIf
        cUpdate += "    Set "

        If ::jParams["MV_CUSTDEV"] // custo médio
            cUpdate += " IGNORE = 'N', "
            cUpdate += " CUSTOMEDIO  = 'S', "
        Else //custo original
            cUpdate += " IGNORE = 'S', "
            cUpdate += " CUSTOMEDIO = 'N', "
        EndIf
        For nMoeda := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nMoeda]
            cUpdate += " CUSTO"+cMoeda+" = "
            If ::jParams["MV_CUSTDEV"] // custo médio, vai ser processado no loop
                cUpdate += " "+::TableName()+".CUSTO"+cMoeda
            Else // custo original
                cUpdate += " Case "
                cUpdate += "     When TEMPTABLE.D2_QUANT <> 0 "
                cUpdate += "     Then TEMPTABLE.QUANT * "
                cUpdate += "          (TEMPTABLE.D2_CUSTO"+cMoeda+" / TEMPTABLE.D2_QUANT) "
                cUpdate += "     Else TEMPTABLE.D2_CUSTO"+cMoeda+" "
                cUpdate += " End "
            EndIf
            cUpdate += " , "

            cUpdate += " CSTOR"+cMoeda+" = "
            If ::jParams["MV_CUSTDEV"] // custo médio, vai ser processado no loop
                cUpdate += " "+::TableName()+".CUSTO"+cMoeda
            Else // custo original
                cUpdate += " Case "
                cUpdate += "     When TEMPTABLE.D2_QUANT <> 0 "
                cUpdate += "     Then TEMPTABLE.QUANT * "
                cUpdate += "          (TEMPTABLE.D2_CUSTO"+cMoeda+" / TEMPTABLE.D2_QUANT) "
                cUpdate += "     Else TEMPTABLE.D2_CUSTO"+cMoeda+" "
                cUpdate += " End "
            EndIf
            cUpdate += " , "
        Next nMoeda
        cUpdate += " PREPROC     = 'N' "

        If !::lOracle
            cUpdate += " From TEMPTABLE "
        EndIf
        cUpdate += " Where "
        cUpdate += " "+::TableName()+".R_E_C_N_O_ = TEMPTABLE.RECNUMBER "

        ::RunQuery(cCTE+cQuery+cUpdate)
    Next nFil

    //Atualizar a tabela de processamento com as notas devolvidas com o custo original
    //ou com o custo zerado.
    If !::lOracle
        cCTE := " With TEMPTABLE As "
    Else
        cCTE := " Merge Into "+cProcTable+" Using "
    EndIf

    If ::oQuerySalesRetPrevProc == Nil
        cQuery := " Select "
        cQuery += " DEV.FILPROC, "
        If ::cCusFil != "E"
            cQuery += " DEV.FILIAL, "
        EndIf
        cQuery += " DEV.COD, "
        If ::cCusFil == "A"
            cQuery += " DEV.LOCARM, "
        EndIf
        For nMoeda := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nMoeda]
            cQuery += " Sum(DEV.CUSTO"+cMoeda+") CUSTO"+cMoeda+", "
        Next nMoeda
        cQuery += " Sum(DEV.QUANT) QUANT "       
        cQuery += " From "+::TableName()+" DEV "
        cQuery += " Inner Join "+RetSQLName("SD1")+" SD1 On "
        cQuery += " SD1.R_E_C_N_O_ = DEV.RECNO "
        cQuery += " Inner Join "+RetSQLName("SD2")+" SD2 On "
        cQuery += " SD2.D2_FILIAL  = SD1.D1_FILIAL  And "
        cQuery += " SD2.D2_DOC     = SD1.D1_NFORI   And "
        cQuery += " SD2.D2_SERIE   = SD1.D1_SERIORI And "
        cQuery += " SD2.D2_ITEM    = SD1.D1_ITEMORI And "
        cQuery += " SD2.D2_CLIENTE = SD1.D1_FORNECE And "
        cQuery += " SD2.D2_LOJA    = SD1.D1_LOJA    And "
        cQuery += " SD2.D2_EMISSAO < ? And "
        cQuery += " SD2.D_E_L_E_T_ = ?"
        cQuery += " Where "
        cQuery += " DEV.FILPROC = ? And "
        cQuery += " DEV.ALIAS   = ? And " //ALIAS = SD1
        cQuery += " DEV.FILIAL  = ? And "
        cQuery += " DEV.TIPONF  = ? And " //D1_TIPO = D
        cQuery += " DEV.IGNORE  = ? And " //IGNORE = S
        cQuery += " DEV.CUSTOMEDIO = ? "  //CUSTOMEDIO = N
        cQuery += " Group By "
        cQuery += " DEV.FILPROC, "
        If ::cCusFil != "E"
            cQuery += " DEV.FILIAL, "
        EndIf
        cQuery += " DEV.COD "
        If ::cCusFil == "A"
            cQuery += ", DEV.LOCARM "
        EndIf
       
        cQuery := ChangeQuery(cQuery)

        ::oQuerySalesRetPrevProc := FWExecStatement():New(cQuery)
    EndIf

    For nFil := 1 To Len(::aFilProc)
        cFilAtu := ::aFilProc[nFil, 1]

        FWFreeArray(aBind)
        aBind := {}
        AAdd(aBind, DToS(dDtIni)) //D2_EMISSAO
        AAdd(aBind, ' ') //D_E_L_E_T_
        AAdd(aBind, cFilProc) //FILPROC
        AAdd(aBind, 'SD1') //ALIAS
        AAdd(aBind, cFilAtu) //DEV.FILIAL
        AAdd(aBind, 'D') //DEV.TIPONF
        AAdd(aBind, 'S') //DEV.IGNORE
        AAdd(aBind, 'N') //DEV.CUSTOMEDIO

        For nI := 1 To Len(aBind)
            ::oQuerySalesRetPrevProc:SetString(nI, aBind[nI])
        Next nI

        cQuery := " ( "+::oQuerySalesRetPrevProc:GetFixQuery()+" ) "

        If ::lOracle
            cQuery += " TEMPTABLE "
            cQuery += " On ("
            cQuery += " "+cProcTable+".FILPROC = TEMPTABLE.FILPROC And "
            If ::cCusFil != "E"
                cQuery += " "+cProcTable+".FILIAL  = TEMPTABLE.FILIAL  And "
            EndIf
            cQuery += " "+cProcTable+".COD     = TEMPTABLE.COD     "
            If ::cCusFil == 'A'
                cQuery += " And "+cProcTable+".ARMAZEM = TEMPTABLE.LOCARM "
            EndIf
            cQuery += " ) "
            cQuery += " When Matched Then "
        EndIf

        If !::lOracle
            cUpdate := " Update "+cProcTable+" "
        Else
            cUpdate := " Update "
        EndIf
        cUpdate += "    Set "

        cUpdate += "QTDHIST = "+cNull
        cUpdate += "("+cProcTable+".QTDHIST + TEMPTABLE.QUANT, 0),"
        cUpdate += "QTDPROC = "+cNull
        cUpdate += "("+cProcTable+".QTDPROC + TEMPTABLE.QUANT, 0),"
        For nMoeda := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nMoeda]
            cUpdate += "CSTHIST"+cMoeda+" = "+cNull
            cUpdate += "("+cProcTable+".CSTHIST"+cMoeda+" + TEMPTABLE.CUSTO"+cMoeda+", 0),"
            cUpdate += "CSTPROC"+cMoeda+" = "+cNull
            cUpdate += "("+cProcTable+".CSTPROC"+cMoeda+" + TEMPTABLE.CUSTO"+cMoeda+", 0),"
        Next nMoeda

        For nMoeda := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nMoeda]
            cUpdate += " CMHIST"+cMoeda+" = "
            cUpdate += " Case "
            cUpdate += "     When ("+cProcTable+".QTDHIST + TEMPTABLE.QUANT) <> 0 "
            cUpdate += "         Then "
            cUpdate += "             (("+cProcTable+".CSTHIST"+cMoeda+" + TEMPTABLE.CUSTO"+cMoeda+")"
            cUpdate += "              / "
            cUpdate += "              ("+cProcTable+".QTDHIST + TEMPTABLE.QUANT))"
            cUpdate += "         Else "+cProcTable+".CMHIST"+cMoeda+" "
            cUpdate += "     End, "

            cUpdate += " CMPROC"+cMoeda+" = "
            cUpdate += " Case "
            cUpdate += "     When ("+cProcTable+".QTDPROC + TEMPTABLE.QUANT) <> 0 "
            cUpdate += "         Then "
            cUpdate += "             (("+cProcTable+".CSTPROC"+cMoeda+" + TEMPTABLE.CUSTO"+cMoeda+")"
            cUpdate += "              / "
            cUpdate += "              ("+cProcTable+".QTDPROC + TEMPTABLE.QUANT))"
            cUpdate += "         Else "+cProcTable+".CMPROC"+cMoeda+" "
            cUpdate += "     End,"
        Next nMoeda
        cUpdate := Substr(cUpdate, 1, Len(cUpdate)-1)

        If !::lOracle
            cUpdate += " From TEMPTABLE "
        EndIf
        cUpdate += " Where "
        cUpdate += " "+cProcTable+".FILPROC = '"+cFilProc+"'   And "
        If ::cCusFil != "E"
            cUpdate += " "+cProcTable+".FILIAL  = TEMPTABLE.FILIAL And "
        EndIf
        cUpdate += " "+cProcTable+".COD     = TEMPTABLE.COD     "
        If ::cCusFil == 'A'
            cUpdate += " And "+cProcTable+".ARMAZEM = TEMPTABLE.LOCARM "
        EndIf

        ::RunQuery(cCTE+cQuery+cUpdate)
    Next nFil

    FWFreeArray(aBind)
Return

/*/{Protheus.doc} GenerateSeqcalc
    Gera o seqcalc das movimentacoes
    @author Squad.Entradas
    @since 03/06/2026
    @version 1.0
    @param cFilProc, character, filial onde o processamento foi iniciado
    /*/
Method generateSeqcalc(cFilProc) Class AnalyticalMovementTable
    Local cIgnored as character

    // Prepara query para atualizacao do seqcalc
    ::prepareSeqcalcStatement()

    // Gera o seqcalc na tabela de movimentos analiticos
    // primeiro para registros com IGNORE = S pois sao pre-processados
    cIgnored := "S"
    ::generateSeqcalcForAnalyticalMovements(cFilProc, cIgnored)

    cIgnored := "N"
    ::generateSeqcalcForAnalyticalMovements(cFilProc, cIgnored)

Return

/*/{Protheus.doc} PrepareSeqcalcStatement
    Gera o seqcalc para registros com IGNORE = S
    @author Squad.Entradas
    @since 05/06/2026
    @version 1.0
    /*/
Method prepareSeqcalcStatement() Class AnalyticalMovementTable
    Local cQuery as character

    If ::oPrepSeqcalc == Nil
        cQuery := "SELECT ROW_NUMBER() OVER (ORDER BY MIN(NIV.NIVINV), ANL.COD, ANL.ENTSAI, ANL.CUSTOMEDIO) SEQCALC, "
        cQuery += "       ANL.R_E_C_N_O_ RECNO "
        cQuery += "FROM " + ::TableName() + " ANL "
        cQuery += "INNER JOIN " + ProductStructLevelTable():TableName() + " NIV "
        cQuery += "    ON  NIV.FILPROC = ANL.FILPROC "
        If ::cCusFil == "E"
            cQuery += "AND NIV.FILIAL  = ? "
        Else
            cQuery += "AND NIV.FILIAL  = ANL.FILIAL "
        EndIf
        cQuery += "    AND NIV.COD     = ANL.COD "
        cQuery += "WHERE ANL.FILPROC = ? "
        cQuery += "  AND ANL.FILIAL  = ? "
        cQuery += "  AND ANL.IGNORE  = ? "
        cQuery += "GROUP BY ANL.COD, ANL.ENTSAI, ANL.CUSTOMEDIO, ANL.R_E_C_N_O_ "
        cQuery := ChangeQuery(cQuery)

        ::oPrepSeqcalc := FWExecStatement():New(cQuery)
    EndIf

Return

/*/{Protheus.doc} GenerateSeqcalcForAnalyticalMovements
    Gera o seqcalc para a tabela de movimentos analiticos
    @author Squad.Entradas
    @since 05/06/2026
    @version 1.0
    @param cFilProc, character, filial onde o processamento foi iniciado
    @param cIgnored, character, conteudo para filtrar pelo campo IGNORE
    /*/
Method generateSeqcalcForAnalyticalMovements(cFilProc, cIgnored) Class AnalyticalMovementTable
    Local aMatch  as array
    Local aUpdate as array
    Local cFilAtu as character
    Local cQuery  as character
    Local cMerge  as character
    Local nFil    as numeric
    Local nX      as numeric

    aMatch := {}
    aAdd(aMatch, {"RECNO", "R_E_C_N_O_"})

    For nFil := 1 To Len(::aFilProc)
        cFilAtu := ::aFilProc[nFil, 1]

        // Pesquisa ultimo numseq gerado para ser somado a contagem seguinte
        ::lastSeqCalc()
        aUpdate := {}
        aAdd(aUpdate, "SEQCALC = ORIGEM.SEQCALC + " + cValToChar(::nlastSeqCalc))

        nX := 1
        If ::cCusFil == "E"
            ::oPrepSeqcalc:SetString(nX++, PadR(FWCompany(), FWSizeFilial()))
        EndIf
        ::oPrepSeqcalc:SetString(nX++, cFilProc)
        ::oPrepSeqcalc:SetString(nX++, cFilAtu)
        ::oPrepSeqcalc:SetString(nX++, cIgnored)

        cQuery := ::oPrepSeqcalc:GetFixQuery()

        cMerge := ::MergeStatement(::TableName(), cQuery, aMatch, aUpdate)

        ::RunQuery(cMerge)

    Next nFil

Return

/*/{Protheus.doc} lastSeqCalc
    Pesquisa ultimo seqcalc gerado para ser somado a contagem seguinte
    @author Squad.Entradas
    @since 08/06/2026
    @version 1.0
    /*/
Method lastSeqCalc() Class AnalyticalMovementTable
    Local cQuery as character

    If ::olastSeqCalc == Nil
        cQuery := "SELECT MAX(SEQCALC) SEQCALC FROM " + ::TableName()

        ::olastSeqCalc := FWExecStatement():New(cQuery)
    EndIf

    ::nlastSeqCalc := ::olastSeqCalc:ExecScalar("SEQCALC")

Return
