#include "msobject.ch"
#include "protheus.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "backoffice.sv.est.costofrequisitionsvsproductions.ch"
#include "totvs.framework.treports.integratedprovider.th"

#DEFINE SX1GRUPO 'ESTT046'

namespace totvs.protheus.backoffice.est.CostOfRequisitionsVsProductions.integratedprovider

using namespace totvs.framework.treports.integratedprovider

@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGAEST", tables="SB1,SB2,SB9,SD1,SD2,SD3", name="Custo Requisições x Produções", country="ALL")

//-------------------------------------------------------------------
/*{Protheus.doc} CostOfRequisitionsVsProductionsSmartViewBusinessObject
Classe para criação do Objeto de Negócio de Custo de Requisições x Produções
 
@author Leonardo Kichitaro
@since 01/2026
@version 1.0
*/
//-------------------------------------------------------------------  
Class CostOfRequisitionsVsProductionsSmartViewBusinessObject From totvs.protheus.backoffice.est.smartView.integratedProvider.EstIntegratedProvider

	Public Method new()				as object
	Public Method getData()			as object

	Protected Method oNGetSchema()
	Protected data jItems		  as json
	Protected data cWhere		  as character
	Protected data aFields		  as array
	Protected data lExistPergunte as logical

EndClass
 
//-------------------------------------------------------------------
/*{Protheus.doc} new
Método de instância da classe
 
@return object: self
 
@author Leonardo Kichitaro
@since 01/2026
@version 1.0
*/
//-------------------------------------------------------------------   
Method new() Class CostOfRequisitionsVsProductionsSmartViewBusinessObject

	Local lExecute	as logical

	_Super:new()

	//Define a Área
	self:appendArea(STR0001) //"Estoque/Custos"

	//Define o nome do Objeto de Negócio
	self:setDisplayName(STR0002) //"Custo Requisições x Produções"
 
	//Define a descrição do Objeto de Negócio
	self:setDescription(STR0003) //"Emite uma relação dos custo requisições x produções."

	//Indica o pergunte que será utilizado no relatório
	lExecute  := FnVldCMod2()
    self:lExistPergunte := (self:setPergunte( SX1GRUPO ) .And. lExecute)
	If !self:lExistPergunte
		self:setErrorStatus(400,STR0004,i18n(STR0005,{SX1GRUPO}))//O Grupo de perguntas #1 não existe
		FWLogMsg('WARN', , 'SmartView', , , , i18n(STR0005,{SX1GRUPO}), , , )//O Grupo de perguntas #1 não existe
	EndIf
    
	//Indica que o LookUp será do tipo padrão LookUp
    self:setIsLookUp(.T.)

Return self

//-------------------------------------------------------------------
/*{Protheus.doc} getData
Retorna os dados do objeto de negócio
 
@param nPage, numérico, indica a página atual do relatório
@param oFilter, objeto, contém o filtro do TReports
 
@return object: self:oData
 
@author Leonardo Kichitaro
@since 01/2026
@version 1.0
*/
//-------------------------------------------------------------------   
Method getData( nPage as Numeric, oFilter as object) as object Class CostOfRequisitionsVsProductionsSmartViewBusinessObject

	Local oQuery						as object

	Local cQuery						as character
	Local cFields						as character
	Local cAliasTmp						as character
	Local cBkpFil						as character
	Local nX							as numeric
	Local nFil							as numeric
	Local jParams						as json
	Local cMoeda						as character
	Local lValDif						as logical

	//Valida o pergunte
	If !self:lExistPergunte	
		return self:oData
	Endif

	//Metodo para retorno do json dos parâmetros
    jParams := oFilter:getParameters()

    //Retorno da tela de multi filiais com as filiais selecionadas ou somente a filial corrente
    self:aFils := self:retFils(jParams['SV_MULTBRANCH'], oFilter)

	If jParams['MV_PAR11'][1] == 0
		cMoeda := '1'
	Else
		cMoeda := StrZero(jParams['MV_PAR11'][1], 1)
	EndIf

	If jParams['MV_PAR12'][1] == 0 .Or. jParams['MV_PAR12'][1] == 1
		lValDif := .T.
	Else
		lValDif := .F.
	EndIf

	//Campos Query
	cFields := 'SD3RE1.D3_FILIAL FILIAL, '
	cFields += 'SD3RE1.D3_COD PRODUTO, '
	cFields += 'SB1.B1_TIPO TIPO, '
	cFields += 'SB1.B1_GRUPO GRUPO, '
	cFields += 'SB1.B1_DESC DESCRICAO, '
	cFields += 'SB1.B1_UM UM, '
	cFields += 'SD3PR0.D3_LOCAL LOCALPROD, '
	cFields += 'COALESCE(SD3RE1.CM_MOVIMENTO, 0) CM_MOVIMENTO, '
	cFields += 'SB2.B2_CMFIM'+cMoeda+' CM_APURADO '

	//Query
	cQuery := "SELECT ? "

	//Normaliza SD3PR0 para não duplicar
	cQuery += " FROM ( "
	cQuery += "         SELECT PR0.D3_FILIAL, PR0.D3_COD, PR0.D3_LOCAL "
	cQuery += "         FROM "+RetSQLName('SD3')+" PR0 "
	cQuery += "         WHERE PR0.D3_FILIAL = ? "
	cQuery += "           AND PR0.D3_COD >= ? AND PR0.D3_COD <= ? "
	cQuery += "           AND PR0.D3_LOCAL >= ? AND PR0.D3_LOCAL <= ? "
	cQuery += "           AND PR0.D3_CF IN (?) "
	cQuery += "           AND (PR0.D3_OP <> ? AND PR0.D3_OP >= ? AND PR0.D3_OP <= ?) "
	cQuery += "           AND PR0.D3_ESTORNO = ? "
	cQuery += "           AND PR0.D_E_L_E_T_ = ? "
	cQuery += "         GROUP BY PR0.D3_FILIAL, PR0.D3_COD, PR0.D3_LOCAL "
	cQuery += " ) SD3PR0 "

	//Cálculo do CM_MOVIMENTO
	cQuery += " LEFT JOIN ( "
	cQuery += "         SELECT RE1.D3_FILIAL, RE1.D3_COD, RE1.D3_LOCAL, "
	cQuery += "                CASE "
	cQuery += "                    WHEN SUM(RE1.D3_QUANT) <> 0  "
	cQuery += "                    THEN SUM(RE1.D3_CUSTO"+cMoeda+") / SUM(RE1.D3_QUANT) "
	cQuery += "                    ELSE 0 "
	cQuery += "                END CM_MOVIMENTO "
	cQuery += "         FROM "+RetSQLName('SD3')+" RE1 "
	cQuery += "         WHERE RE1.D3_QUANT > ? "
	cQuery += "           AND RE1.D3_CF IN (?) "
	cQuery += "           AND RE1.D3_ESTORNO = ? "
	cQuery += "           AND RE1.D_E_L_E_T_ = ? "
	cQuery += "         GROUP BY RE1.D3_FILIAL, RE1.D3_COD, RE1.D3_LOCAL "
	cQuery += " ) SD3RE1 "
	cQuery += "    ON SD3RE1.D3_FILIAL = SD3PR0.D3_FILIAL "
	cQuery += "   AND SD3RE1.D3_COD    = SD3PR0.D3_COD "
	cQuery += "   AND SD3RE1.D3_LOCAL  = SD3PR0.D3_LOCAL "

	cQuery += " INNER JOIN "+RetSQLName('SB2')+" SB2 "
	cQuery += "         ON SB2.B2_FILIAL = SD3PR0.D3_FILIAL "
	cQuery += "        AND SB2.B2_COD = SD3PR0.D3_COD "
	cQuery += "        AND SB2.B2_LOCAL = SD3PR0.D3_LOCAL "
	cQuery += "        AND SB2.D_E_L_E_T_ = ? "

	cQuery += " INNER JOIN "+RetSQLName('SB1')+" SB1 "
	cQuery += "         ON SB1.B1_FILIAL = ? "
	cQuery += "        AND SB1.B1_TIPO >= ? AND SB1.B1_TIPO <= ? "
	cQuery += "        AND SB1.B1_COD = SD3PR0.D3_COD "
	cQuery += "        AND SB1.B1_GRUPO >= ? AND SB1.B1_GRUPO <= ? "
	cQuery += "        AND SB1.D_E_L_E_T_ = ? "

	cQuery += " WHERE SD3RE1.CM_MOVIMENTO IS NOT NULL "
	cQuery += "   AND SD3RE1.CM_MOVIMENTO <> ? "
	cQuery += " ORDER BY SD3PR0.D3_FILIAL, SD3PR0.D3_COD, SD3PR0.D3_LOCAL "

	cQuery := ChangeQuery(cQuery)

	//Montagem da query para execução
	oQuery := FwExecStatement():New(cQuery)

	cBkpFil := cFilAnt

	For nFil :=1 to len(self:aFils)
		cFilAnt := self:aFils[nFil]

		//Binding
		oQuery:SetUnsafe(1, cFields)
		oQuery:SetString(2, FWxFilial("SD3"))
		oQuery:SetString(3, jParams['MV_PAR03'][1])
		oQuery:SetString(4, jParams['MV_PAR04'][1])
		oQuery:SetString(5, jParams['MV_PAR09'][1])
		oQuery:SetString(6, jParams['MV_PAR10'][1])
		oQuery:SetIn(7, {'PR0','PR1'})
		oQuery:SetString(8, ' ')
		oQuery:SetString(9, jParams['MV_PAR01'][1])
		oQuery:SetString(10, jParams['MV_PAR02'][1])
		oQuery:SetString(11, ' ')
		oQuery:SetString(12, ' ')
		oQuery:SetNumeric(13, 0)
		oQuery:SetIn(14, {'RE0','RE1'})
		oQuery:SetString(15, ' ')
		oQuery:SetString(16, ' ')
		oQuery:SetString(17, ' ')
		oQuery:SetString(18, FWxFilial("SB1"))
		oQuery:SetString(19, jParams['MV_PAR05'][1])
		oQuery:SetString(20, jParams['MV_PAR06'][1])
		oQuery:SetString(21, jParams['MV_PAR07'][1])
		oQuery:SetString(22, jParams['MV_PAR08'][1])
		oQuery:SetString(23, ' ')
		oQuery:SetNumeric(24, 0)

		cAliasTmp := oQuery:OpenAlias()

		(cAliasTmp)->(dbGoTop())
		While !(cAliasTmp)->(Eof())
			If lValDif .And. ((cAliasTmp)->CM_MOVIMENTO - (cAliasTmp)->CM_APURADO) == 0
				(cAliasTmp)->(DBSkip())
				Loop
			EndIf

			self:jItems := JsonObject():New()
			For nX := 1 To Len(self:aFields)
				self:jItems[self:aFields[nX]] := (cAliasTmp)->&(self:aFields[nX])
			Next nX
			self:jItems['DIFVALOR'] := ABS((cAliasTmp)->CM_MOVIMENTO - (cAliasTmp)->CM_APURADO)

			self:processData()
			self:oData:appendData(self:jItems)

			(cAliasTmp)->(DBSkip())
		EndDo

		(cAliasTmp)->( DBCloseArea() )
	Next

	cFilAnt := cBkpFil

	oQuery:Destroy()

return self:oData

//-------------------------------------------------------------------
/*{Protheus.doc} getSchema
Retorna a estrutura dos campos
 
@return object: self:oSchema
 
@author Leonardo Kichitaro
@since 01/2026
@version 1.0
*/
//-------------------------------------------------------------------   
Method oNGetSchema() Class CostOfRequisitionsVsProductionsSmartViewBusinessObject

	self:aFields := {"FILIAL", "PRODUTO", "TIPO", "GRUPO", "DESCRICAO", "UM", "LOCALPROD", "CM_MOVIMENTO", "CM_APURADO"}

	self:addProperty( "FILIAL"		, STR0006, "string", STR0006, "FILIAL")		//"Filial"
	self:addProperty( "PRODUTO"		, STR0007, "string", STR0007, "PRODUTO")	//"Produto"
	self:addProperty( "TIPO"		, STR0008, "string", STR0008, "TIPO")		//"Tipo"
	self:addProperty( "GRUPO"		, STR0009, "string", STR0009, "GRUPO")		//"Grupo"
	self:addProperty( "DESCRICAO"	, STR0010, "string", STR0010, "DESCRICAO")	//"Descrição"
	self:addProperty( "UM"			, STR0011, "string", STR0011, "UM")			//"Unidade"
	self:addProperty( "LOCALPROD"	, STR0012, "string", STR0012, "LOCALPROD")	//"Local"
	self:addProperty( "CM_MOVIMENTO", STR0013, "number", STR0013, "CM_MOVIMENTO")	//"Custo Médio das Requisições"
	self:addProperty( "CM_APURADO"	, STR0014, "number", STR0014, "CM_APURADO")	//"Custo Médio das Produções"
	self:addProperty( "DIFVALOR"	, STR0015, "number", STR0015, "DIFVALOR")	//"Diferença entre os valores"

Return
