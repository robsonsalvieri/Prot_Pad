#Include 'Totvs.ch'
#include 'tlpp-core.th'
#include 'backoffice.stock.iterativecost.preprocessing.validations.ch'

namespace totvs.protheus.backoffice.stock.iterativecost.valids.environmentvalidator

Using Namespace totvs.protheus.backoffice.stock.iterativecost.table.manager

/*/{Protheus.doc} EnvironmentValidator
    Classe responsável por fazer as validações do ambiente
    @author Squad Entradas
    @since 12/08/2025
/*/
Class EnvironmentValidator

    public method New()
    public method runEnvironmentChecks()
    public method validPMSIntegration()
    public method validInternationalMarket()
    public method validCostMethod()
    public method validModeAcess()
    public method Execute()
    public method kardexFilterValidation()
    public method preValidations()

    public data aFiliais      as array
    public data lOk           as logical
    public data cErrorMessage as character
    
endclass

/*/{Protheus.doc} New
    Instância da classe
    @author Squad Entradas
    @since 13/08/2025
/*/
Method New(aFiliais) Class EnvironmentValidator

    ::aFiliais := aFiliais
    ::lOk      := .T.

Return

/*/{Protheus.doc} runEnvironmentChecks
    Valida se a integração com o PMS está habilitada (MV_INTPMS)
    @author Squad Entradas
    @since 13/08/2025
/*/
Method runEnvironmentChecks() Class EnvironmentValidator
    
    //Valida se alguma filial do roteiro está com o PMS habilitado (MV_INTPMS)
    ::validPMSIntegration()

    //Valida se alguma filial do roteiro está com o MV_PAISLOC diferente de BRA
    ::validInternationalMarket()

    //Valida se alguma filial do roteiro utiliza custo FIFO ou LIFO
    ::validCostMethod()
    
    //Valida o compartilhamento das tabelas do Estoque
    ::validModeAcess()

Return ::lOK

/*/{Protheus.doc} validPMSIntegration
    Valida se a integração com o PMS está habilitada (MV_INTPMS)
    @author Squad Entradas
    @since 13/08/2025
/*/
Method validPMSIntegration() Class EnvironmentValidator
    local cParam      := "MV_INTPMS" as character
    local cHelp       := "EST330PMS" as character
    local cMessage    := STR0001 as character //"Existem filiais no roteiro de cálculo integradas ao PMS (parâmetro MV_INTPMS). Devido a essa condição, não será possivel continuar com o processamento."
    local cExpResult  := "N" as character

    //Preenche as variáveis para execução do método Run
    If ::lOk
        ::lOK := ::Execute(cParam,cMessage,cHelp,cExpResult)
    EndIf

Return

/*/{Protheus.doc} validInternationalMarket
    Valida se o ambiente utilizado é do Brasil (MV_PAISLOC)
    @author Squad Entradas
    @since 13/08/2025
/*/
Method validInternationalMarket() Class EnvironmentValidator
    local cParam   := "MV_PAISLOC" as character
    local cHelp    := "EST330VLDMI" as character
    local cMessage := STR0002 as character //"O processamento é permitido apenas para ambientes configurados com o parâmetro MV_PAISLOC igual a BRA. Não será permitido continuar devido à existência de filiais no roteiro com configuração diferente."
    local cPaisLoc := "BRA" as character

    //Preenche as variáveis para execução do método Run
    If ::lOK
        ::lOK := ::Execute(cParam,cMessage,cHelp,cPaisLoc)
    EndIf

Return

/*/{Protheus.doc} validCostMethod
    Valida se o ambiente está configurado para utilizar custo FIFO ou LIFO
    @author Squad Entradas
    @since 13/08/2025
/*/
Method validCostMethod() Class EnvironmentValidator
    local nX       as integer
    local cParam   as character
    local cHelp    as character
    local cMessage as character
    local aVar     := {} as array 
    local lresult  := .F. as logical

    //Preenche as variáveis para execução do método Run
    If ::lOK
        AADD(aVar,{"MV_CUSFIFO",STR0004,"EST330FIFO"}) //"O processamento não poderá ser continuado, pois existem filiais no roteiro de cálculo com o custo FIFO habilitado (parâmetro MV_CUSFIFO)."
        AADD(aVar,{"MV_CUSLIFO",STR0005,"EST330LIFO"}) //"O processamento não poderá ser continuado, pois existem filiais no roteiro de cálculo com o custo LIFO habilitado (parâmetro MV_CUSLIFO)."

        For nX := 1 to Len(aVar)
            cParam   := aVar[nX][1]
            cMessage := aVar[nX][2]
            cHelp    := aVar[nX][3]

            ::lOK := ::Execute(cParam,cMessage,cHelp,lresult)

            If !::lOK
                Exit
            EndIf
        Next nX
    EndIf

Return

/*/{Protheus.doc} validModeAcess
    Instância da classe
    @author Squad Entradas
    @since 13/08/2025
/*/
Method validModeAcess() Class EnvironmentValidator
    local nX       as integer
    local cMode    as character
    local cHelp    := "EST330CHK" as character
    local cMessage := STR0003 //"O processamento não é permitido em ambientes com as tabelas SB2, SB6, SB9, SC2, SD1, SD2 e/ou SD3 configuradas como compartilhadas."
    local aTables  := {"SB2","SB6","SB9","SC2","SD1","SD2","SD3"} as array

    If ::lOk
        For nX := 1 to Len(aTables)
            cMode := FWModeAccess(aTables[nX],3)
            If cMode == "C"
                ::lOk := .F.
                Help('',1,cHelp,,cMessage,1,0)
                Exit
            EndIf
        Next nX
    EndIf

Return

/*/{Protheus.doc} Execute
    Executa as validações
    @author Squad Entradas
    @since 12/08/2025
/*/
Method Execute(cParam,cMessage,cHelp,xResult) Class EnvironmentValidator
    local nX   as integer
    local xVar as variant
    local lRet := .T. as logical

    For nX := 1 to Len(::aFiliais)
        xVar := SuperGetMV(cParam,.F.,.F.,::aFiliais[nX])
        If !Empty(xVar) .And. xVar <> xResult
            Help('',1,cHelp,,cMessage,1,0,,,,,,{STR0006})
            ::cErrorMessage := cMessage
            lRet := .F.
            Exit
        EndIf
    Next nX

Return lRet

/*/{Protheus.doc} kardexFilterValidation
    Valida o filtro do kardex caso tenha selecionado a opcao
    para exibir dados do custo em partes
    @author Squad.Entradas
    @since 15/10/2025
    @version 1.0
    @param aBranches, array, filiais selecionadas para gerar o kardex
    @param cDataIni, character, data inicial do filtro
    @param cDataFim, character, data final do filtro
    @return lRet, logical, filtro valido ou nao
    /*/
Method kardexFilterValidation(aBranches, cDataIni, cDataFim) Class EnvironmentValidator
    Local oQueryD4I as object
    Local oQueryD4L as object
    Local oQueryD4M as object
    Local oQueryD4N as object
    Local oQueryD4O as object
    Local nFilial   as numeric
    Local nTamTesD1 as numeric
    Local nTamTesD2 as numeric
    Local nContador as numeric
    Local cFilAtu   as character
    Local cQuery    as character
    Local cAlias    as character
	Local cRevisao  as character
    Local lRet      as logical

    nTamTesD1 := TamSX3("D1_TES")[1]
    nTamTesD2 := TamSX3("D2_TES")[1]
    lRet := .T.

    For nFilial := 1 To Len(aBranches)

        cFilAtu := aBranches[nFilial]

        If oQueryD4I == Nil
            cQuery := "SELECT DISTINCT D4I_REVISA "
            cQuery += "FROM " + RetSqlName("D4I") + " "
            cQuery += "WHERE D4I_FILIAL = ? "
            cQuery += "AND D4I_DATA BETWEEN ? AND ? "
            cQuery += "AND D_E_L_E_T_ = ? "

            oQueryD4I := FWExecStatement():New(cQuery)
        EndIf
        oQueryD4I:SetString(1, FWxFilial("D4I", cFilAtu))
        oQueryD4I:SetString(2, cDataIni)
        oQueryD4I:SetString(3, cDataFim)
        oQueryD4I:SetString(4, " ")

        cAlias := oQueryD4I:OpenAlias()

        nContador := 0
        While (cAlias)->(!Eof())
            nContador++
            cRevisao := (cAlias)->D4I_REVISA
            If nContador > 1
                lRet := .F.
                Exit
            EndIf
            (cAlias)->(DbSkip())
        End
        (cAlias)->(DbCloseArea())
        If !lRet
            Exit
        EndIf

        If oQueryD4L == Nil
            cQueryD4L := "SELECT DISTINCT D4L.D4L_REVISA "
            cQueryD4L += "FROM " + RetSQLName("D4L") + " D4L "
            cQueryD4L += "INNER JOIN " + RetSQLName("SD1") + " SD1 "
            cQueryD4L += "    ON  SD1.D1_FILIAL  = ? "
            cQueryD4L += "    AND SD1.D1_DOC     = D4L.D4L_DOC "
            cQueryD4L += "    AND SD1.D1_SERIE   = D4L.D4L_SERIE "
            cQueryD4L += "    AND SD1.D1_FORNECE = D4L.D4L_FORNEC "
            cQueryD4L += "    AND SD1.D1_LOJA    = D4L.D4L_LOJA "
            cQueryD4L += "    AND SD1.D1_ITEM    = D4L.D4L_ITEM "
            cQueryD4L += "    AND SD1.D1_FORMUL  = D4L.D4L_FORMUL "
            cQueryD4L += "    AND SD1.D1_ITEMGRD = D4L.D4L_ITEMGR "
            cQueryD4L += "    AND SD1.D1_TES    <> ? "
            cQueryD4L += "    AND SD1.D_E_L_E_T_ = ? "
            cQueryD4L += "WHERE SD1.D1_DTDIGIT BETWEEN ? AND ? "
            cQueryD4L += "    AND D4L.D4L_FILIAL = ? "
            cQueryD4L += "    AND D4L.D_E_L_E_T_ = ? "

            oQueryD4L := FWExecStatement():New(cQueryD4L)
        EndIf
        oQueryD4L:SetString(1, FWxFilial("SD1", cFilAtu))
        oQueryD4L:SetString(2, Space(nTamTesD1))
        oQueryD4L:SetString(3, " ")
        oQueryD4L:SetString(4, cDataIni)
        oQueryD4L:SetString(5, cDataFim)
        oQueryD4L:SetString(6, FWxFilial("D4L", cFilAtu))
        oQueryD4L:SetString(7, " ")

        cAlias := oQueryD4L:OpenAlias()

        nContador := 0
        While (cAlias)->(!Eof())
            nContador++
            cRevisao := (cAlias)->D4L_REVISA
            If nContador > 1
                lRet := .F.
                Exit
            EndIf
            (cAlias)->(DbSkip())
        End
        (cAlias)->(DbCloseArea())
        If !lRet
            Exit
        EndIf

        If oQueryD4M == Nil
            cQueryD4M := "SELECT DISTINCT D4M.D4M_REVISA "
            cQueryD4M += "FROM " + RetSQLName("D4M") + " D4M "
            cQueryD4M += "INNER JOIN " + RetSQLName("SD2") + " SD2 "
            cQueryD4M += "	ON	SD2.D2_FILIAL  = ? "
            cQueryD4M += "	AND SD2.D2_DOC     = D4M.D4M_DOC "
            cQueryD4M += "	AND SD2.D2_SERIE   = D4M.D4M_SERIE "
            cQueryD4M += "	AND SD2.D2_CLIENTE = D4M.D4M_CLIENT "
            cQueryD4M += "	AND SD2.D2_LOJA    = D4M.D4M_LOJA "
            cQueryD4M += "	AND SD2.D2_ITEM    = D4M.D4M_ITEM "
            cQueryD4M += "	AND SD2.D2_TES    <> ? "
            cQueryD4M += "	AND SD2.D_E_L_E_T_ = ? "
            cQueryD4M += "WHERE SD2.D2_EMISSAO BETWEEN ? AND ? "
            cQueryD4M += "    AND D4M.D4M_FILIAL = ? "
            cQueryD4M += "    AND D4M.D_E_L_E_T_ = ? "

            oQueryD4M := FWExecStatement():New(cQueryD4M)
        EndIf
        oQueryD4M:SetString(1, FWxFilial("SD2", cFilAtu))
        oQueryD4M:SetString(2, Space(nTamTesD2))
        oQueryD4M:SetString(3, " ")
        oQueryD4M:SetString(4, cDataIni)
        oQueryD4M:SetString(5, cDataFim)
        oQueryD4M:SetString(6, FWxFilial("D4M", cFilAtu))
        oQueryD4M:SetString(7, " ")

        cAlias := oQueryD4M:OpenAlias()

        nContador := 0
        While (cAlias)->(!Eof())
            nContador++
            cRevisao := (cAlias)->D4M_REVISA
            If nContador > 1
                lRet := .F.
                Exit
            EndIf
            (cAlias)->(DbSkip())
        End
        (cAlias)->(DbCloseArea())
        If !lRet
            Exit
        EndIf

        If oQueryD4N == Nil
            cQueryD4N := "SELECT DISTINCT D4N.D4N_REVISA "
            cQueryD4N += "FROM " + RetSQLName("SD3") + " SD3 "
            cQueryD4N += "INNER JOIN " + RetSQLName("D4N") + " D4N "
            cQueryD4N += "	ON	D4N.D4N_FILIAL  = ? "
            cQueryD4N += " AND  D4N.D4N_IDSD3 = SD3.D3_MSUID "
            cQueryD4N += "	AND D4N.D_E_L_E_T_ = ? "
            cQueryD4N += "WHERE SD3.D3_FILIAL = ? "
            cQueryD4N += "    AND SD3.D3_EMISSAO BETWEEN ? AND ? "
            cQueryD4N += "    AND SD3.D3_ESTORNO = ? "
            cQueryD4N += "    AND SD3.D_E_L_E_T_ = ? "

            oQueryD4N := FWExecStatement():New(cQueryD4N)
        EndIf
        oQueryD4N:SetString(1, FWxFilial("D4N", cFilAtu))
        oQueryD4N:SetString(2, " ")
        oQueryD4N:SetString(3, FWxFilial("SD3", cFilAtu))
        oQueryD4N:SetString(4, cDataIni)
        oQueryD4N:SetString(5, cDataFim)
        oQueryD4N:SetString(6, " ")
        oQueryD4N:SetString(7, " ")

        cAlias := oQueryD4N:OpenAlias()

        nContador := 0
        While (cAlias)->(!Eof())
            nContador++
            cRevisao := (cAlias)->D4N_REVISA
            If nContador > 1
                lRet := .F.
                Exit
            EndIf
            (cAlias)->(DbSkip())
        End
        (cAlias)->(DbCloseArea())
        If !lRet
            Exit
        EndIf

        If oQueryD4O == Nil
            cQuery := "SELECT DISTINCT D4O_REVISA "
            cQuery += "FROM " + RetSqlName("D4O") + " "
            cQuery += "WHERE D4O_FILIAL = ? "
            cQuery += "AND D4O_DATA BETWEEN ? AND ? "
            cQuery += "AND D_E_L_E_T_ = ? "

            oQueryD4O := FWExecStatement():New(cQuery)
        EndIf
        oQueryD4O:SetString(1, FWxFilial("D4O", cFilAtu))
        oQueryD4O:SetString(2, cDataIni)
        oQueryD4O:SetString(3, cDataFim)
        oQueryD4O:SetString(4, " ")

        cAlias := oQueryD4O:OpenAlias()

        nContador := 0
        While (cAlias)->(!Eof())
            nContador++
            cRevisao := (cAlias)->D4O_REVISA
            If nContador > 1
                lRet := .F.
                Exit
            EndIf
            (cAlias)->(DbSkip())
        End
        (cAlias)->(DbCloseArea())
        If !lRet
            Exit
        EndIf

    Next nFilial

Return {lRet,cRevisao}

/*/{Protheus.doc} preValidations
    Executa a pré validação, verificando a existencia de procedure instalada no ambiente do 
    cliente.
    @type method
    @author Squad Entradas
    @since 14/04/2026
    @param cProcName, character, nome da procedure
/*/
Method preValidations(cProcName As Character) Class EnvironmentValidator

    Local cHelp As Character
    Local cMessage As Character

    cHelp    := "EST330PROC"
    cMessage := STR0007 // #Para apagar os movimentos de estornos, é necessária a instalação do pacote de procedures referente ao processo 19 - Recalculo de Custo Médio.

    ::lOk := ExistProc(cProcName, EngSPS19Signature())

    If !::lOk
        Help('',1,cHelp,,cMessage,1,0)
        ::cErrorMessage := cMessage
    EndIf
    
Return
