/*/{Protheus.doc} GetQuery
    Retorna a query estruturada da instalação da View com base nos parâmetros informados
    @author g.moreira
    @since 13/08/2024
    /*/
Method GetQuery(cEmpAtu As Character, jParam As Json) Class ViewLaborProduct
    Local cQuery  As Character
    Local cIDView As Character
    Local cNomFis As Character
    Local cDbType As Character
    Local cVersao As Character
    Local nTamCC  As Numeric
    Local nTamGr  As Numeric
    
	cIDView := ::GetViewID()
    cNomFis := "VW_"+cIDView+"_"+cEmpAtu
    cDbType := TCGetDB()
    cVersao := ::GetVersion()
    nTamCC  := TamSX3('B1_CCCUSTO')[1]
    nTamGr  := TamSX3('B1_GCCUSTO')[1]

    cQuery := " Create View "+cNomFis+" As "
    cQuery += " Select "
    If cDbType $ 'POSTGRES'
        cQuery += " Char(4) "
    EndIf
    cQuery += "'"+cVersao+"' ASSINATURA, "
    cQuery += " B1_FILIAL, B1_COD, B1_CCCUSTO, B1_GCCUSTO, "
    If cDbType $ 'POSTGRES'
        cQuery += " Char(1) "
    EndIf
    cQuery += " '2' MODELO "
    cQuery += " From "+RetSQLName('SB1')+" SB1 "
    cQuery += " Where "
    cQuery += " B1_COD NOT LIKE 'MOD%' "
	cQuery += " And B1_CCCUSTO <> ' ' "
    cQuery += " And SB1.D_E_L_E_T_ = ' ' "

    cQuery += " Union All"
    cQuery += " Select "
    If cDbType $ 'POSTGRES'
        cQuery += " Char(4) "
    EndIf
    cQuery += "'"+cVersao+"' ASSINATURA, "
    cQuery += " B1_FILIAL, B1_COD, "
    cQuery += " Cast("
    If cDbType $ 'ORACLE'
        cQuery += " SubStr "
    Else
        cQuery += " SubString "
    EndIf
    cQuery += " (B1_COD, 4, "+cValToChar(nTamCC)+" ) "
    cQuery += " As Char("+cValToChar(nTamCC)+") ) B1_CCCUSTO, "
    If cDbType $ 'POSTGRES'
        cQuery += " Char("+cValToChar(nTamGr)+") "
    EndIf
    cQuery += " '"+Space(nTamGr)+"' B1_GCCUSTO, "
    If cDbType $ 'POSTGRES'
        cQuery += " Char(1) "
    EndIf
    cQuery += " '1' MODELO "
    cQuery += " From "+RetSQLName('SB1')+" SB1 "
    cQuery += " Where "
    cQuery += " B1_COD LIKE 'MOD%' "
    cQuery += " And SB1.D_E_L_E_T_ = ' ' "
Return cQuery
