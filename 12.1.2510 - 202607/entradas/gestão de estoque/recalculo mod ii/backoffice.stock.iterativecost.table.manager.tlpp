#Include 'Totvs.ch'
#Include 'tlpp-core.th'

namespace totvs.protheus.backoffice.stock.iterativecost.table.manager

/*/{Protheus.doc} TableManager
    Classe responsável por criar/limpar as tabelas do recálculo
    @author Squad Entradas
    @since 14/03/2024
/*/
Class TableManager

    public data cErrorSQL as character
    public data cFilProc  as character

    Public Data aFilProc  As Array

    Public Data cModo     As Character
    Public Data cModoUn   As Character
    Public Data cModoEmp  As Character
    Public Data lOracle   As Logical
    Public Data lPostgres As Logical
    Public Data lMSSQL    As Logical
    Public Data lADVPR    As Logical
    Public Data cCoalesce As Character
    Public Data oIndMatch As Object
    Public Data oRegex1   As Object
    Public Data oRegex2   As Object
    Public Data oRegex3   As Object
    Public Data lCustomDelete As Logical

    public method New() 

    Static Method TableName()

    public method TableManager()
    Static method UseArea()
    public method CloseArea()

    public method RunQuery()
    Public Method FormatCTE()
    Public method buildCteStatement()
    Public Method MergeStatement()
	Static Method formatRound()
	Public Method castToChar()
    Static Method IntToB36()

    Public Method genSqlPlan()

    method CriaTab()
    method DeletaTab()
    method AtualizaTab()

    method CheckStru()
    
    Public method DeletaReg()

endclass

/*/{Protheus.doc} New
    Instância da classe
    @author Squad Entradas
    @since 14/03/2024
/*/
Method New(aFil, cModoEmp, cModoUn, cModo, lADVPR) Class TableManager
    Local nSM0     as numeric
    Local nFil     as numeric
    Local aFilProc As Array
    Local aSM0     As Array
    Local cFilProc As Character
    Local nSizeFil As Numeric
    Local nSizeUn  As Numeric
    Local nSizeEmp As Numeric
    Local nX       As Numeric
    
    Default cModo    := 'E'
    Default cModoUn  := 'E'
    Default cModoEmp := 'E'
    Default lADVPR   := .F.

    ::cModo     := cModo
    ::cModoUn   := cModoUn
    ::cModoEmp  := cModoEmp
    ::lOracle   := TCGetDB() $ 'ORACLE'
    ::lPostgres := TCGetDB() $ 'POSTGRES'
    ::lMSSQL    := TCGetDB() $ 'MSSQL'
    ::lADVPR    := lADVPR
    ::cCoalesce := MatIsNull()
    ::oIndMatch := tlpp.regex.Regex():New("STR[\(](.*?)[,](.*?)[\)]")
    ::oRegex1   := tlpp.regex.Regex():New("STR\([ ]*")
    ::oRegex2   := tlpp.regex.Regex():New("[ ]*,[ ]*[0-9]+[ ]*\)")
    ::oRegex3   := tlpp.regex.Regex():New("[ ]*,[ ]*[0-9]+")
    ::lCustomDelete := .F.

    aSM0 := FWLoadSM0()
    aFilProc := {}

    //Monta o campo filial
    For nFil := 1 To Len(aFil)
        nSM0 := AScan(aSM0, {|x| x[SM0_GRPEMP] == cEmpAnt .And. x[SM0_CODFIL] == aFil[nFil]})
        If nSM0 > 0
            nSizeEmp := Len(aSM0[nSM0, SM0_LEIAEMP])
            nSizeFil := Len(aSM0[nSM0, SM0_LEIAFIL])
            nSizeUn  := Len(aSM0[nSM0, SM0_LEIAUN])
            
            If     ::cModoEmp == 'E' .And. ::cModoUn == 'E' .And. ::cModo == 'E'
                cFilProc := PadR(aSM0[nSM0, SM0_CODFIL], FWSizeFilial())
            ElseIf ::cModoEmp == 'E' .And. ::cModoUn == 'E' .And. ::cModo == 'C'
                cFilProc := PadR(aSM0[nSM0, SM0_EMPRESA], nSizeEmp)
                cFilProc += PadR(aSM0[nSM0, SM0_UNIDNEG], nSizeUn)
                cFilProc += Space(nSizeFil)
            ElseIf ::cModoEmp == 'E' .And. ::cModoUn == 'C' .And. ::cModo == 'C'
                cFilProc := PadR(aSM0[nSM0, SM0_EMPRESA], nSizeEmp)
                cFilProc += Space(nSizeUn)
                cFilProc += Space(nSizeFil)
            ElseIf ::cModoEmp == 'C' .And. ::cModoUn == 'C' .And. ::cModo == 'C'
                cFilProc := Space(FWSizeFilial())
            Else
                If ::lAdvPR
                    ::aFilProc := {{"", ""}}
                    Return Self
                Else
                    UserException("Modo de compartilhamento inválido.")
                EndIf
            EndIf

            AAdd(aFilProc, {aFil[nFil], cFilProc})
        EndIf
    Next nFil

    ::aFilProc := aFilProc
    ::cFilProc := ""

    If !Empty(aFilProc)
        For nX := 1 to Len(aFilProc)
            If !(aFilProc[nX, 1] $ ::cFilProc)
                ::cFilProc += "'" + aFilProc[nX, 1] + "',"
            EndIf
            If !(aFilProc[nX, 2] $ ::cFilProc)
                ::cFilProc += "'" + aFilProc[nX, 2] + "',"
            EndIf
        Next nX
        ::cFilProc := Substr(::cFilProc,1,Len(::cFilProc)-1)
    EndIf

    FWFreeArray(aSM0)
Return Self

/*/{Protheus.doc} TableManager
    Método responsável por criar/alterar a tabela
    @author Squad Entradas
    @since 14/03/2024
/*/
Method TableManager(cAlias, aCampos, aIndices, aFil, lCloseArea, cUnique) Class TableManager
    Local lRet as logical

    Default aFil       := {}
    Default lCloseArea := .F.
    Default cUnique    := ""

    If FnVldCMod2()
        lRet := ::CriaTab(cAlias, aCampos, aIndices, cUnique)

        If !lRet
            ::AtualizaTab(cAlias, aCampos, aIndices, aFil, cUnique)
        EndIf

        If lCloseArea
            ::CloseArea(cAlias)
        EndIf
    EndIf

Return

/*/{Protheus.doc} CriaTab
    Cria a tabela caso não exista no DB
    @author Squad Entradas
    @since 14/03/2024
/*/
Method CriaTab(cAlias, aCampos, aIndices, cUnique) Class TableManager
    Local nI    as numeric
    Local lRet  As Logical
    
    Default cUnique := ''

    If !TCCanOpen(cAlias)
        EngSPSWorkTable("",cAlias,aCampos,.T.)
        DbUseArea(.T.,"TOPCONN",cAlias,cAlias,.T.)

        If !Empty(cUnique)
            (cAlias)->(DbCloseArea())
            DbUseArea(.T.,"TOPCONN",cAlias,cAlias,.F.) //Abre exclusivo
            TCUnique(cAlias, cUnique)
            (cAlias)->(DbCloseArea())
            DbUseArea(.T.,"TOPCONN",cAlias,cAlias,.T.) //compartilhado
        EndIf

        For nI := 1 To Len(aIndices)
            (cAlias)->(DBCreateIndex(aIndices[nI, 1], aIndices[nI, 2]))
        Next

        (cAlias)->(DBClearIndex())
        For nI := 1 To Len (aIndices)
			(cAlias)->(DBSetIndex(aIndices[nI, 1]))
		Next nX

        lRet := .T.
    Else
        lRet := .F. //Tabela já existe, checa estrutura
    EndIf

Return lRet

/*/{Protheus.doc} DeletaTab
    Deleta a tabela do DB
    @author Squad Entradas
    @since 14/03/2024
/*/
Method DeletaTab(cAlias) Class TableManager
    If Select(cAlias) > 0
        (cAlias)->(DbCloseArea())
    EndIf
    
    If TCCanOpen(cAlias)
        TcDelIndex(cAlias,"")
        TCDelFile(cAlias)
    EndIf
Return

/*/{Protheus.doc} AtualizaTab
    Método responsável por recriar a tabela caso a estrutura esteja
    diferente da fornecida, ou limpar caso a estrutura seja igual
    @author Squad Entradas
    @since 14/03/2024
/*/
Method AtualizaTab(cAlias,aCampos,aIndices,aFil,cUnique) Class TableManager
    Default cUnique := ""
    
    If TCCanOpen(cAlias)
        ::UseArea(cAlias, aIndices)
        lRet := ::CheckStru(cAlias,aCampos,aIndices)

        //Se a estrutura for igual, deleta os registros
        If lRet
            ::DeletaReg(cAlias,aFil)
        //Se a estrutura for diferente, deleta toda a tabela e recria
        Else
            ::DeletaTab(cAlias)
            ::CriaTab(cAlias,aCampos,aIndices,cUnique)
        EndIf
    EndIf

Return

/*/{Protheus.doc} CheckStru
    Valida se a estrutura da tabela é igual a estrutura informada
    @author Squad Entradas
    @since 14/03/2024
/*/
Method CheckStru(cAlias,aCampos,aIndices) Class TableManager
    Local nX            as numeric
    Local lRet := .T.   as logical
    Local aEstruFis     as array
    Local cIndex        as character

    DbSelectArea(cAlias)
    aEstruFis := (cAlias)->(dbStruct())

    // Valida se os indices da tabela são iguais ao indices fornecidos
    For nX := 1 to Len(aIndices)
        If TCCanOpen(cAlias,aIndices[nX][1])
            (cAlias)->(DbSetOrder(nX))
            cIndex := (cAlias)->(IndexKey())
            ::oRegex1:RemoveAll(@cIndex) //Remove "STR("
            ::oRegex2:RemoveAll(@cIndex) //Remove ",xx)"
            ::oRegex3:RemoveAll(@cIndex) //Remove ",xx"
            If !Empty(cIndex) .And. cIndex <> aIndices[nX][2]
                lRet := .F.
                Exit
            EndIf
        Else
            lRet := .F.
            Exit
        EndIf
    Next nX

    //Caso os indices estejam corretos, valida a estrutura de campos
    If lRet
        If Len(aCampos) == Len(aEstruFis)
            aSort(aCampos,,,{|x,y| x[1] < y[1]})
            aSort(aEstruFis,,,{|x,y| x[1] < y[1]})
            For nX := 1 To Len(aCampos)
                If !(aCampos[nX,2] == aEstruFis[nX,2] .And. aCampos[nX,3] == aEstruFis[nX,3] .And. aCampos[nX,4] == aEstruFis[nX,4])
                    lRet := .F.
                    Exit
                EndIf
            Next nX
        Else
            lRet := .F.
        EndIf
    EndIf

Return lRet

/*/{Protheus.doc} DeletaReg
    Deleta os registro da tabela
    @author Squad Entradas
    @since 14/03/2024
/*/
Method DeletaReg(cTable) Class TableManager
    Local cQuery as character
    Local lRet   As Logical

    lRet := .T.

    If !::lCustomDelete
	    cQuery := " DELETE FROM " + cTable
	    If !Empty(::cFilProc)
	        cQuery += " WHERE FILIAL IN ( " + ::cFilProc + ")"
	    EndIf
	
	    lRet := ::RunQuery(cQuery)
    EndIf
Return lRet

/*/{Protheus.doc} UseArea
    Abre a tabela de dados
    @author Squad Entradas
    @since 14/03/2024
/*/
Method UseArea(cAlias, aIndex) Class TableManager
    Local nI As Integer

    If !Empty(cAlias) .And. Select(cAlias) == 0
        DbUseArea(.T.,"TOPCONN",cAlias,cAlias,.T.)

        For nI := 1 To Len(aIndex)
            If TCCanOpen(cAlias, aIndex[nI,1])
                (cAlias)->(DbSetIndex(aIndex[nI,1]))
            EndIf
        Next nI
    EndIf

Return

/*/{Protheus.doc} CloseArea
    Deleta os registro da tabela
    @author Squad Entradas
    @since 14/03/2024
/*/
Method CloseArea(cAlias) Class TableManager

    If Select(cAlias) > 0
        (cAlias)->(DbCloseArea())
    EndIf

Return

/*/{Protheus.doc} FormatCTE
    Prepara a query da Common Table Expression
    @author Squad Entradas
    @since 06/09/2024
    /*/
Method FormatCTE(cCampos, cQuery, lWith) Class TableManager
    Local cInsert As character

    Default lWith := .T.

    If ::lOracle
        cInsert := " INSERT INTO " + ::TableName()
        cInsert += " ( " + cCampos + " ) "
        cInsert += " WITH TEMPTABLE AS ( " + cQuery + " ) "
        cInsert += " SELECT " + cCampos
        cInsert += " FROM TEMPTABLE "
    Else
        If lWith
            cInsert := " WITH "
        EndIf
        cInsert += " TEMPTABLE AS ( " + cQuery + " ) "
        cInsert += " INSERT INTO " + ::TableName()
        cInsert += " ( " + cCampos + " ) "
        cInsert += " SELECT " + cCampos
        cInsert += " FROM TEMPTABLE "
    EndIf
Return cInsert

/*/{Protheus.doc} RunQuery
    Executa uma query com TCSQLExec
    Caso ocorra erro, grava no atributo cErrorSQL
    @author Squad Entradas
    @since 06/09/2024
    /*/
Method RunQuery(cQuery)  Class TableManager
    Local lRet

    If TcSqlExec(cQuery) < 0
        ::cErrorSQL := TCSQLError()
        lRet := .F.
        If !::lADVPR
            UserException("TableManagerSQLError: "+::cErrorSQL)
        EndIf
    EndIf
Return lRet

/*/{Protheus.doc} buildCteStatement
    Monta update para atualizacao dos valores
    @author Squad.Entradas
    @since 11/11/2024
    @version 1.0
    @param  cTableName, character, tabela a atualizar
            cFieldsUpd, character, campos que serao atualizados
            cMatchFilter, character, filtro do update
            cQryStatement, character, query utilizada no Cte
    @return cCteStatement, character, cQuery
    /*/
Method buildCteStatement(cTableName, cFieldsUpd, cMatchFilter, cQryStatement) class TableManager
    Local cCTE          := ""
    Local cUpdate       := ""
    Local cQuery        := ""
    Local cCteStatement := ""

    If !::lOracle
        cCTE := "WITH TEMPTABLE AS "
        cUpdate := "UPDATE " + cTableName + " "
    Else
        cCTE := "MERGE INTO " + cTableName + " USING "
        cUpdate := "UPDATE "
    EndIf

    cUpdate += "SET "
    cUpdate += cFieldsUpd

    If !::lOracle
        cUpdate += " FROM TEMPTABLE"
    EndIf

    cUpdate += " WHERE "
    cUpdate += cMatchFilter

    cQuery := "("
    cQuery += cQryStatement
    cQuery += ") "

    If ::lOracle
        cQuery += "TEMPTABLE "
        cQuery += "ON ("
        cQuery += cMatchFilter
        cQuery += ")"
        cQuery += " WHEN MATCHED THEN "
    EndIf

    cCteStatement := cCTE + cQuery + cUpdate

Return cCteStatement


/*/{Protheus.doc} MergeStatement
    Prepara o comando merge para cada banco de dados.
    Realiza alteração caso encontre registro na tabela destino, a partir da origem,
    ou inclui caso não exista.
    @author Squad Entradas
    @since 29/03/2025
    @version 1
    @Type Method
    @param cTabDestino, Character, Nome da tabela destino
    @param cQryOrigem, Character, Consulta dos dados de origem
    @param aMatch, Lista de expressões para vinculo entre origem e destino. Ex:
                {{"FILPROC", "'D MG 01 '"}, {"COD","PRODUTO"}}
    @param aUpdate, Lista de expressões de update da tabela destino. 
                    Não deve conter expressões atualizando os campos contidos na expressão de Match
                    Utilizar os alias "Origem" e "Destino" nas expressões para acessar os campos
                 {{"QUANT = Origem.QUANT + Destino.QUANT"},
                  {"CUSTO = Origem.CUSTO + Destino.CUSTO"}}   
    @param aCpoDest, Lista de campos da tabela destino a serem inclusos. Campos omitidos serão preenchidos com o constraint do campo conforme criado no banco de dados
                 {"FILIAL","QUANT","CUSTO","CUSTOMEDIO"}
    @param aInsert, Expressão da query origem ou constantes a serem preenchidas nos campos informados na aCpoDest. Deve ser informado na mesma ordem
                 {"'D MG 01 '","Origem.QUANT","Origem.CUSTO","Origem.CUSTO/Origem.QUANT"}
    @return cMerge, Expressão merge para ser executada
    /*/
Method MergeStatement(cTabDestino, cQryOrigem, aMatch, aUpdate, aCpoDest, aInsert, lDelete) Class TableManager
    Local cMerge := ""
    Local nI     := 0

    Default aUpdate  := {}
    Default aCpoDest := {}
    Default aInsert  := {}
    Default lDelete  := .F.

    cMerge := " Merge "
    If ::lOracle .Or. ::lPostgres
        cMerge += " Into "
    EndIf
    cMerge += cTabDestino +" Destino "
    cMerge += " Using "
    cMerge += " ("+cQryOrigem+") Origem "
    cMerge += " On "
    cMerge += " ( "
    For nI := 1 To Len(aMatch)
        If !("'" $ aMatch[nI, 1]) //é um campo
            cMerge += "Origem."
        EndIf
        cMerge += aMatch[nI, 1]
        cMerge += " = "
        If !("'" $ aMatch[nI, 2]) //é um campo
            cMerge += "Destino."
        EndIf
        cMerge += aMatch[nI, 2]
        If nI < Len(aMatch)
            cMerge += " And "
        EndIf
    Next nI
    cMerge += " ) "
    If !lDelete
        If Len(aUpdate) > 0
            cMerge += " When Matched Then "
            cMerge += " Update Set "
            For nI := 1 To Len(aUpdate)
                If ::lMSSQL .Or. ::lOracle
                    cMerge += "Destino."
                EndIf
                cMerge += AllTrim(aUpdate[nI])
                If nI < Len(aUpdate)
                    cMerge += ", "
                EndIf
            Next nI
        EndIf
        If Len(aCpoDest) > 0 .And. Len(aInsert) > 0
            cMerge += " When Not Matched Then "
            cMerge += " Insert "
            cMerge += " ( "
            For nI := 1 To Len(aCpoDest)
                cMerge += aCpoDest[nI]
                If nI < Len(aCpoDest)
                    cMerge += ", "
                EndIf
            Next nI
            cMerge += " ) "
            cMerge += " Values "
            cMerge += " ( "
            For nI := 1 To Len(aInsert)
                cMerge += aInsert[nI]
                If nI < Len(aInsert)
                    cMerge += ", "
                EndIf
            Next nI
            cMerge += " )"
        EndIf
    EndIf

    If lDelete
        cMerge += " When Matched Then "
        If ::lOracle
            cMerge += " Update Set Destino.D_E_L_E_T_ = '*', Destino.R_E_C_D_E_L_ = Destino.R_E_C_N_O_ "
        Else
            cMerge += " Delete "
        EndIf
    EndIf

    If ::lMSSQL
        cMerge += ";"
    EndIf
        
    cMerge += " "


Return Upper(cMerge)

/*/{Protheus.doc} formatRound
    Trata a função Round dependendo de cada banco de dados utilizado, conforme tratamento
    do MV_CMROUND (arredondamento ou truncamento)
    @Type Method
    @author Squad.Entradas
    @since 07/10/2025
    @version 1.0
    /*/
Method formatRound(lRound, cCampo, nDecCM) class TableManager
    Local cRound := ""
    Local cDecCM := ""

    cDecCM  := cValToChar(nDecCM)

    If lRound
        cRound := " Round("+cCampo+", "+cDecCM+") "
    Else
        If TCGetDB() $ 'ORACLE'
            cRound := " Trunc("+cCampo+", "+cDecCM+") "
        ElseIf TCGetDB() $ 'POSTGRES'
            cRound := " Trunc(Cast("+cCampo+" As Numeric), "+cDecCM+") "
        Else
            cRound := " Round("+cCampo+", "+cDecCM+", 1) "
        EndIf
    EndIf

Return cRound

/*/{Protheus.doc} joinMSUID
    Centraliza os tratamentos de join do MSUID num método
    @author Squad Entradas
    @since 16/04/2026
    @version version
    @param cFieldLeft, character, campo à esquerda do join, isto é, o campo que não precisa ter o tipo alterado
    @param cFieldRight, character, campo à direita do join, isto é, o campo que tem o tipo alterado
    @param lForceChar, logical, força o cast do campo à direita do join como caractere
    @param lForceUUID, logical, força o cast do campo à direita do join como UUID
    @return cJoin, character, Join alterado
    /*/
Function joinMSUID(cFieldLeft as Character, cFieldRight as Character, lForceChar as Logical, lForceUUID as Logical) as character
    Local cJoin as Character

    cJoin := cFieldLeft+" = "+cFieldRight

    Default lForceChar  := .F.
    Default lForceUUID  := .F.

    If lForceChar
        If TCGetDB() $ 'MSSQL'
            cJoin := cFieldLeft+" = CAST("+cFieldRight+" AS VARCHAR(36))"
        ElseIf TCGetDB() $ 'POSTGRES'
            cJoin := cFieldLeft+" = UPPER(CAST("+cFieldRight+" AS CHARACTER(36)))"
        ElseIf TCGetDB() $ 'ORACLE'
            cJoin := cFieldLeft+" = CAST("+cFieldRight+" AS CHAR(36))"
        EndIf
    EndIf

    If lForceUUID
        If TCGetDB() $ 'MSSQL'
            cJoin := cFieldLeft+" = CAST("+cFieldRight+" AS uniqueidentifier)"
        ElseIf TCGetDB() $ 'POSTGRES'
            cJoin := cFieldLeft+" = CAST("+cFieldRight+" AS uuid)"
        ElseIf TCGetDB() $ 'ORACLE'
            cJoin := cFieldLeft+" = HEXTORAW(REPLACE(TRIM("+cFieldRight+"), '-', ''))"
        EndIf
    EndIf

Return cJoin

/*/{Protheus.doc} castToChar
    Força o cast do campo conforme sintaxe de cada banco de dados
    @author Squad Entradas
    @since 02/06/2026
    /*/
Method castToChar(cField, nSize) class TableManager
    Local cString := ''

    cString := " Cast("+cField+" As Char("+cValToChar(nSize)+"))"

Return cString

/*/{Protheus.doc} TableName
    Método a ser sobrescrito pelas classes filhas 
    @type Method
    @author Squad Entradas
    @since 19/05/2026
/*/
Method tableName() Class TableManager
Return

/*/{Protheus.doc} IntToB36
    Converte um numero inteiro para Base36 com 6 posicoes exatas
    @author Squad.Entradas
    @since 09/06/2026
    @version 1.0
    @param nNumero, Number, Numero a ser convertido para base 36
    @return cRet, String, Representacao em base 36 do numero fornecido
    /*/
Method IntToB36(nNumero) Class TableManager
    Local cMapa := "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    Local cRet  := ""
    Local nPos1, nPos2, nPos3, nPos4, nPos5, nPos6

    // Posição 1 (Esquerda): (Numero / 36^5) % 36
    nPos1 := Mod(Int(nNumero / 60466176), 36) + 1

    // Posição 2: (Numero / 36^4) % 36
    nPos2 := Mod(Int(nNumero / 1679616), 36) + 1

    // Posição 3: (Numero / 36^3) % 36
    nPos3 := Mod(Int(nNumero / 46656), 36) + 1

    // Posição 4: (Numero / 36^2) % 36
    nPos4 := Mod(Int(nNumero / 1296), 36) + 1

    // Posição 5: (Numero / 36^1) % 36
    nPos5 := Mod(Int(nNumero / 36), 36) + 1

    // Posição 6 (Direita): Numero % 36
    nPos6 := Mod(nNumero, 36) + 1

    // Concatena buscando no mapa de caracteres
    cRet := SubStr(cMapa, nPos1, 1) + ;
            SubStr(cMapa, nPos2, 1) + ;
            SubStr(cMapa, nPos3, 1) + ;
            SubStr(cMapa, nPos4, 1) + ;
            SubStr(cMapa, nPos5, 1) + ;
            SubStr(cMapa, nPos6, 1)

Return cRet
