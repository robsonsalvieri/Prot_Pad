#include 'tlpp-core.th'
#include 'backoffice.stock.iterativecost.processing.mainprogram.ch'

//Numero maximo de produtos por thread
#Define NMAXPROD 50

namespace totvs.protheus.backoffice.stock.iterativecost.processing.mainprogram

using namespace totvs.protheus.backoffice.stock.iterativecost.table.balancebyproductionorder
using namespace totvs.protheus.backoffice.stock.iterativecost.view.transferinvoice
using namespace totvs.protheus.backoffice.stock.iterativecost.accounting.laborproductvalue
using namespace totvs.protheus.backoffice.stock.iterativecost.table.manager
using namespace totvs.protheus.backoffice.stock.iterativecost.table.analyticalmovementtable
using namespace totvs.protheus.backoffice.stock.iterativecost.view.manager
using namespace totvs.protheus.backoffice.stock.iterativecost.table.productstructleveltable
using namespace totvs.protheus.backoffice.stock.iterativecost.table.processingtable
using namespace totvs.protheus.backoffice.stock.iterativecost.table.balancebywarehouse
using namespace totvs.protheus.backoffice.stock.iterativecost.table.aglutinattedmovementtable
using namespace totvs.protheus.backoffice.stock.iterativecost.table.laborbycostcenter
using namespace totvs.protheus.backoffice.stock.iterativecost.table.productgrouping
using namespace totvs.protheus.backoffice.stock.iterativecost.processing.movementprocess
using namespace totvs.protheus.backoffice.stock.iterativecost.processing.threads
using namespace totvs.protheus.backoffice.stock.iterativecost.table.parts.processingtable
using namespace totvs.protheus.backoffice.stock.iterativecost.table.parts.analyticalmovementtable
using namespace totvs.protheus.backoffice.stock.iterativecost.table.parts.balancebyproductionorderparts
using namespace totvs.protheus.backoffice.stock.iterativecost.table.parts.agglutinatedMovementPartsTable
using namespace totvs.protheus.backoffice.stock.iterativecost.table.parts.laborbycostcenterparts
using namespace totvs.protheus.backoffice.stock.iterativecost.accounting.parts.laborproductpartsvalue
using namespace totvs.protheus.backoffice.stock.iterativecost.update.parts.movement
using namespace totvs.protheus.backoffice.stock.iterativecost.update.movement
using namespace totvs.protheus.backoffice.stock.iterativecost.processing.requestcost
using namespace totvs.protheus.backoffice.stock.iterativecost.processing.parts.requestcost
using namespace totvs.protheus.backoffice.stock.iterativecost.valids.environmentvalidator
using namespace totvs.protheus.backoffice.stock.iterativecost.processing.averagecostrecalculation
using namespace ac.Results.Analysis.Service
using namespace totvs.protheus.backoffice.stock.iterativecost.processing.stockcostroundingadjuster
using namespace totvs.protheus.backoffice.stock.iterativecost.processing.parts.stockcostroundingadjuster

/*/{Protheus.doc} IterativeCostMain
    Classe principal com a chamada dos métodos para execução do recálculo.
    @type Class
    @author Squad Entradas
    @since 18/11/2024
    /*/
Class IterativeCostMain
    Data jParams                As Json
    Data oProc                  As Object
    Data oJourneyLog            As Object
    Data lJourney               As Logical
    Data lAutoAccounting        As Logical
    Data lIsNewProc             As Logical
    Data cFilProc               As Character
    Data aFiliais               As Array
    Data aRoteiro               As Array
    Data nNumExec               As Integer
    Data oQueryInit             As Object
    Data aAcumulador            As array
    Data nTotalRecords          As numeric
    Data nRecordsInThread       As numeric
    Data nMaxProductsPerThread  As numeric
    Data aFilCalc               As array
    Data aE330ParamZX           As Array
    Data cSPMAT013              As Character

    Public Method New()

    Public Method GetParamSX6()
    Public Method GetParamSX1()
    Public Method SetParamSX1()
    Public Method Run()
    Public Method ValidParam()
    Public Method runCalculation()
    Public Method ThreadLoop()
    Public Method WaitThread()
    Public Method InitSD3UUID()
    Public Method lockSemaphore()
    Public Method unlockSemaphore()
    Public Method logProAtu()
    Public Method E330Analysis()
    Public Method E330Accounting()

    Private Method GetFiliais()
    Public Method IncRegua1()
    Public Method IncRegua2()
    Private Method EmitAlert()
    Private Method ExecuteThread()
    Private Method ControlVariablesCleaner()
    Private Method deleteReversalMovements()

    Static Method buildJsonMov()
EndClass

/*/{Protheus.doc} New
    Retorna instância da classe
    @type Method
    @author Squad Entradas
    @since 18/11/2024
    /*/
Method New(oProccess, oJourney) Class IterativeCostMain
    ::oProc       := oProccess
    If oJourney <> Nil
        ::lJourney        := .T.
        ::oJourneyLog     := oJourney["oJourneyLog"]
        ::aE330ParamZX    := oJourney["paramsSX1"]
        ::lAutoAccounting := oJourney["autoAccounting"]
    Else
        ::lJourney        := .F.
        ::oJourneyLog     := acJourneyLog():New()
        ::aE330ParamZX    := Array(8)
        ::lAutoAccounting := .F.
        ::oJourneyLog:idMovD3X()
        ::oJourneyLog:setThreadId(StrZero(ThreadId(),15))
        ::oJourneyLog:envValid(::lJourney, .T.)
    EndIf
    ::oJourneyLog:logIni(,,,.T.)
    ::lIsNewProc  := ::oProc != Nil
    ::cFilProc    := cFilAnt
    ::jParams     := {"MV_ULMES":""}
    ::jParams['IDEXEC'] := FWUUIDV4(.T.)
    ::nNumExec    := 0
    ::aFiliais    := {}
    ::aRoteiro    := {}
    ::aAcumulador := {}
    ::aFilCalc    := {}
    ::nMaxProductsPerThread := 0
    ::nTotalRecords         := 0
    ::nRecordsInThread      := 0
    ::cSPMAT013             := GetSPName("MAT013", "19")

Return Self

/*/{Protheus.doc} GetParamSX6
    Guarda os parâmetros da SX6 para posterior consulta nas demais classes
    @author Squad Entradas
    @since 18/11/2024
    @type Method
    /*/
Method GetParamSX6() Class IterativeCostMain
    Local nI   As Integer
    ::jParams["MV_ULMES"]   := GetMV('MV_ULMES')
    ::jParams["dataini"]    := ::jParams["MV_ULMES"]+1
    ::jParams["MV_CUSFIL"]  := SuperGetMV("MV_CUSFIL", .F., 'A')
    ::jParams["MV_MOEDACM"] := SuperGetMV("MV_MOEDACM", .F., '2345')
    ::jParams["moedas"]     := {'1'}
    For nI := 2 To 5
        If cValToChar(nI) $ ::jParams["MV_MOEDACM"]
            AAdd(::jParams["moedas"], cValToChar(nI))
        EndIf
    Next nI
    ::jParams["MV_CUSTDEV"] := SuperGetMV("MV_CUSTDEV", .F., .F.)
    ::jParams["MV_E330GRD"] := SuperGetMV("MV_E330GRD", .F., 2)
    ::jParams["MV_M330THR"] := SuperGetMV("MV_M330THR", .F., 1)
    ::jParams["MV_E330REA"] := SuperGetMV("MV_E330REA", .F., .F.)
    ::jParams["revisao_vigente"] := E330RevAti()

Return

/*/{Protheus.doc} GetParamSX1
    Guarda os parâmetros da SX1 para posterior consulta nas demais classes
    Usado na execução por tela da rotina
    @type Method
    @author Squad Entradas
    @since 18/11/2024 
    /*/
Method GetParamSX1() Class IterativeCostMain
    Local nX := 0
    
    Pergunte('EST330', .F.)

    For nX := 1 To Len(::aE330ParamZX)
        If ::lJourney
            &("MV_PAR"+StrZero(nX,2)) := ::aE330ParamZX[nX]
        Else
            ::aE330ParamZX[nX] := &("MV_PAR"+StrZero(nX,2))
        EndIf
    Next nX

    ::jParams["roteiro"] := MV_PAR01
    ::jParams["datafin"] := MV_PAR02
    ::jParams["percmod"] := MV_PAR03
    ::jParams["contini"] := MV_PAR04
    ::jParams["contfin"] := MV_PAR05
    ::jParams["apagest"] := MV_PAR06
    ::jParams["calcmod"] := MV_PAR07
    ::jParams["calccp"]  := MV_PAR08
    
Return

/*/{Protheus.doc} Run
    Executa o recálculo
    @type Method
    @author Squad Entradas
    @since 18/11/2024
    /*/
Method Run() Class IterativeCostMain
    Local dDtIni             As Date
    Local dDtFim             As Date
    Local oView              As Object
    Local oTabProc           As Object
    Local oTabProcCP         As Object
    Local oTabMov            As Object
    Local oTabMovCP          As Object
    Local oTabCC             As Object
    Local oTabCCCP           As Object
    Local oAccountLabor      As Object
    Local oAccountLaborParts As Object
    Local oTabSldPorArmz     As Object
    Local oTabNiv            As Object
    Local oAdjDelete         As Object
    Local oAdjDeleteCP       As Object
    Local oTabSldOP          As Object
    Local oTabSldOPCP        As Object
    Local oTabAglPar         As Object
    Local oUpdPartsMov       As Object
    Local oValidEnvironment  As object
    Local oRequestCost       As Object
    Local oPartsReqCost      As Object
    Local oMovREA            As object

    dDtIni   := ::jParams["MV_ULMES"]+1
    dDtFim   := ::jParams["datafin"]
    ::GetFiliais(::jParams["roteiro"])

    //Valida as restrições do ambiente
    oValidEnvironment := EnvironmentValidator():New(::aFiliais)
    If !oValidEnvironment:runEnvironmentChecks()
        ::IncRegua1(oValidEnvironment:cErrorMessage)
        ::logProAtu(STR0041, oValidEnvironment:cErrorMessage, oValidEnvironment:cErrorMessage, "ER") // ERRO
        Return .F.
    EndIf

    If !::ValidParam()
        Return .F.
    EndIf

    //Cria o semáforo de processamento
    If !::lockSemaphore()
        Return .F.
    EndIf

    If ::jParams["apagest"] == 1
        oValidEnvironment:preValidations(::cSPMAT013)
        If !oValidEnvironment:lOk
            ::IncRegua1(oValidEnvironment:cErrorMessage)
            ::logProAtu(STR0041, oValidEnvironment:cErrorMessage, oValidEnvironment:cErrorMessage, "ER") // ERRO
            Return .F.
        EndIf
    EndIf

    If ::lJourney
        If ::oJourneyLog:processHasStarted(::oJourneyLog:cIdParent, ::oJourneyLog:cIdChild, STR0042) // EST330
		    ::oJourneyLog:attStatus(STR0043, .T.) // PROCESSING
        EndIf
    EndIf
    ::logProAtu(STR0044) // INICIO
    ::logProAtu(STR0045) // AMBIENTE

    ::IncRegua1(STR0060) //Iniciando processamento

    If ::jParams["calccp"] == 1
        ::InitSD3UUID(::aFiliais, dDtIni, dDtFim)
    EndIf

    oRequestCost := RequestCost():New(::cFilProc, ::aFiliais, ::jParams)
    If ::jParams["calccp"] == 1
        oPartsReqCost := PartsRequestCost():New(::cFilProc, ::aFiliais, ::jParams)
    EndIf

    ::IncRegua1(STR0001) //"Instalando Views"
    ::logProAtu(STR0046, STR0001, STR0001, "2") // MENSAGEM
    oView    := ViewManager():New(::aFiliais)
    oView:Install()
    ::IncRegua1(STR0002) //"Views Instaladas"
    ::logProAtu(STR0046, STR0002, STR0002) // MENSAGEM

    ::IncRegua1(STR0003) //"Populando a tabela de processamento"
    ::logProAtu(STR0046, STR0003, STR0003) // MENSAGEM
    oTabProc := ProcessingTable():New(::aFiliais)
    oTabProc:TableManager()
    oTabProc:insertProcTable(::cFilProc, dDtIni, dDtFim)
    ::IncRegua1(STR0004) //"Tabela de processamento populada"
    ::logProAtu(STR0046, STR0004, STR0004) // MENSAGEM

    If ::jParams["apagest"] == 1
        // Deleta os movimentos de estornos.
        ::deleteReversalMovements(::aFiliais, dDtIni, dDtFim)
    EndIf

    If ::jParams["calccp"] == 1
        //Deleta os movimentos de ajuste de arredondamento existentes no período para o custo em partes
        oAdjDeleteCP := StockCostRoundingAdjusterCP():New(::cFilProc,,dDtIni,dDtFim)
        oAdjDeleteCP:deleteRecDecRecordsForPeriod(::aFiliais)
    EndIf

    //Deleta os movimentos de ajuste de arredondamento existentes no período
    oAdjDelete := StockCostRoundingAdjuster():New(::cFilProc,::jParams["moedas"],dDtIni,dDtFim)
    oAdjDelete:deleteRecDecRecordsForPeriod(::aFiliais)

    If ::jParams["calccp"] == 1
        ::IncRegua1(STR0031) //"Populando a tabela de processamento do custo em partes"
        ::logProAtu(STR0046, STR0031, STR0031) // MENSAGEM
        oTabProcCP := PartsProcessingTable():New(::aFiliais,::jParams)
        oTabProcCP:TableManager()
        oTabProcCP:InitialStockPartsBalance(::cFilProc)
        oTabProcCP:AcquisitionPartsCost(::cFilProc, dDtIni, dDtFim)
        ::IncRegua1(STR0032) //"Tabela de processamento em partes populada"
        ::logProAtu(STR0046, STR0032, STR0032) // MENSAGEM
    EndIf

    ::IncRegua1(STR0005) //"Populando a tabela de movimentos (analítica)"
    ::logProAtu(STR0046, STR0005, STR0005) // MENSAGEM
    oTabMov := AnalyticalMovementTable():New(::aFiliais,::jParams)
    oTabMov:InsertMovTable(::cFilProc, dDtIni, dDtFim)
    ::IncRegua1(STR0006) //"Tabela de movimentos (analítica) populada"
    ::logProAtu(STR0046, STR0006, STR0006) // MENSAGEM

    If ::jParams["calccp"] == 1
        ::IncRegua1(STR0033) //"Populando a tabela de movimentos analítica do custo em partes"
        ::logProAtu(STR0046, STR0033, STR0033) // MENSAGEM
        oTabMovCP := AnalyticalMovementPartsTable():New(::aFiliais,::jParams)
        oTabMovCP:TableManager()
        oTabMovCP:GetPartsCost(::cFilProc)
        ::IncRegua1(STR0034) //"Tabela de movimentos analítica em partes populada"
        ::logProAtu(STR0046, STR0034, STR0034) // MENSAGEM
        //Prepara atualizacao das tabelas de custo em partes
        oUpdPartsMov := updatePartsMovement():new(::jParams, ::cFilProc, ::aFiliais, .F., " ")
    EndIf

    ::IncRegua1(STR0007) //"Populando a tabela de saldos por centro de custos"
    ::logProAtu(STR0046, STR0007, STR0007) // MENSAGEM
    oTabCC := LaborByCostCenter():New(::aFiliais)
    oTabCC:InsLaborByCC(::cFilProc, dDtIni, dDtFim)
    ::IncRegua1(STR0008) //"Tabela de saldos por centro de custos populada"
    ::logProAtu(STR0046, STR0008, STR0008) // MENSAGEM

    If ::jParams["calccp"] == 1
        ::IncRegua1(STR0035) //"Populando a tabela de saldos por centro de custos em partes"
        ::logProAtu(STR0046, STR0035, STR0035) // MENSAGEM
        oTabCCCP := LaborByCostCenterParts():New(::aFiliais, ::jParams)
        oTabCCCP:TableManager()
        oTabCCCP:InsLaborByCC(::cFilProc, dDtIni, dDtFim)
        ::IncRegua1(STR0036) //"Tabela de saldos por centro de custos em partes populada"
        ::logProAtu(STR0046, STR0036, STR0036) // MENSAGEM
    EndIf

    ::IncRegua1(STR0009) //"Processando Mão de obra"
    ::logProAtu(STR0046, STR0009, STR0009) // MENSAGEM
    oAccountLabor := LaborProductValue():New(oTabCC, ::jParams)
    oAccountLabor:InstallProc()
    oAccountLabor:UpdProcTableCostCenterAvgCost(::cFilProc, dDtIni, dDtFim)
    oAccountLabor:UpdMovements(::cFilProc, dDtIni, dDtFim)
    ::IncRegua1(STR0010) //"Mão de obra processada"
    ::logProAtu(STR0046, STR0010, STR0010) // MENSAGEM

    If ::jParams["calccp"] == 1
        ::IncRegua1(STR0037) //"Processando Mão de obra - custo em partes"
        ::logProAtu(STR0046, STR0037, STR0037) // MENSAGEM
        oAccountLaborParts := LaborProductPartsValue():New(oTabCCCP, ::jParams)
        oAccountLaborParts:UpdProcTableCostCenterAvgCost(::cFilProc, dDtIni, dDtFim, ::aFiliais)
        oAccountLaborParts:UpdMovements(::cFilProc, dDtIni, dDtFim)
        ::IncRegua1(STR0038) //"Mão de obra - custo em partes processada"
        ::logProAtu(STR0046, STR0038, STR0038) // MENSAGEM
    EndIf

    ::IncRegua1(STR0011) //"Populando a tabela de saldos por armazém"
    ::logProAtu(STR0046, STR0011, STR0011) // MENSAGEM
    oTabSldPorArmz := BalanceByWarehouse():New(::cFilProc, ::aFiliais, oTabProc, ::jParams)
    oTabSldPorArmz:insertSQL(::cFilProc, dDtIni, dDtFim)
    If oTabSldPorArmz != Nil .And. MethIsMemberOf(oTabSldPorArmz, "SaldoNegativo")
     If !oTabSldPorArmz:SaldoNegativo(::cFilProc,::aFiliais, Self) //Verifica saldo negativos na TRK
         Return .F.
      EndIf
    EndIf
    ::IncRegua1(STR0012) //"Tabela de saldos por armazém populada"
    ::logProAtu(STR0046, STR0012, STR0012) // MENSAGEM

    ::IncRegua1(STR0013) //"Calculando níveis de estrutura"
    ::logProAtu(STR0046, STR0013, STR0013) // MENSAGEM
    oTabNiv := ProductStructLevelTable():New(::aFiliais, ::jParams)
    oTabNiv:insertSQL(::cFilProc, dDtIni, dDtFim)
    ::IncRegua1(STR0014) //"Níveis calculados"
    ::logProAtu(STR0046, STR0014, STR0014) // MENSAGEM

    oTabGrp := ProductGroupingTable():New(::aFiliais, ::cFilProc, ::jParams)
    oTabGrp:insertSQL()

    ::IncRegua1(STR0015) //"Avaliando movimentos de transferência"
    ::logProAtu(STR0046, STR0015, STR0015) // MENSAGEM
    oTabMov:IgnoreTransferMovements(::cFilProc, dDtIni, dDtFim)

    ::IncRegua1(STR0016) //"Avaliando requisições a custo médio"
    ::logProAtu(STR0046, STR0016, STR0016) // MENSAGEM
    oTabMov:setUnaffectedCostMovements(::cFilProc)

    ::IncRegua1(STR0028) //"Avaliando devoluções de compras"
    ::logProAtu(STR0046, STR0028, STR0028) // MENSAGEM
    oTabMov:IgnorePurchaseReturn(::cFilProc, dDtIni, dDtFim)
    If ::jParams["calccp"] == 1
        oTabMovCP:IgnorePurchaseReturn(::cFilProc)
    EndIf
    ::IncRegua1(STR0039) //"Devoluções de compra avaliadas"
    ::logProAtu(STR0046, STR0039, STR0039) // MENSAGEM

    ::IncRegua1(STR0029) //"Avaliando devoluções de vendas"
    ::logProAtu(STR0046, STR0029, STR0029) // MENSAGEM
    oTabMov:IgnoreSalesReturn(::cFilProc, dDtIni, dDtFim)
    If ::jParams["calccp"] == 1
        oTabMovCP:IgnoreSalesReturn(::cFilProc)
    EndIf
    ::IncRegua1(STR0040) //"Devoluções de venda avaliadas"
    ::logProAtu(STR0046, STR0040, STR0040) // MENSAGEM

    ::IncRegua1(STR0027) //"Atualizando movimentações de terceiros"
    ::logProAtu(STR0046, STR0027, STR0027) // MENSAGEM
    oTabMov:IgnoreThirdPartyMovements(::cFilProc)

    If ::jParams["calccp"] == 1
        oTabMovCP:InitAvgCost(::cFilProc)
    EndIf

    ::IncRegua1(STR0061) //"Gerando sequencia de calculo das movimentacoes"
    ::logProAtu(STR0046, STR0061, STR0061) // MENSAGEM
    oTabMov:generateSeqcalc(::cFilProc)

    ::IncRegua1(STR0017) //"Populando a tabela de movimentos (aglutinada)"
    ::logProAtu(STR0046, STR0017, STR0017) // MENSAGEM
    oTabAgl := AgglutinatedMovementTable():New(::aFiliais)
    oTabAgl:AvgCostMov(::cFilProc, .F.)
    ::IncRegua1(STR0018) //"Requisições a custo médio aglutinadas"
    ::logProAtu(STR0046, STR0018, STR0018) // MENSAGEM
    oTabAgl:AvgCostMov(::cFilProc, .T.)
    ::IncRegua1(STR0019) //"Devoluções a custo médio aglutinadas"
    ::logProAtu(STR0046, STR0019, STR0019) // MENSAGEM
    oTabAgl:DE4CostMov(::cFilProc)
    ::IncRegua1(STR0062) //"Devoluções de transferência aglutinadas"
    ::logProAtu(STR0046, STR0062, STR0062) // MENSAGEM
    oTabAgl:CopyMov(::cFilProc)
    ::IncRegua1(STR0020) //"Demais movimentos copiados"
    ::logProAtu(STR0046, STR0020, STR0020) // MENSAGEM

    If ::jParams["calccp"] == 1
        ::IncRegua1(STR0030) //"Populando a tabela aglutinada em partes"
        ::logProAtu(STR0046, STR0030, STR0030) // MENSAGEM
        oTabAglPar := AgglutinatedMovementPartsTable():New(::aFiliais)
        oTabAglPar:AgglMovement(::cFilProc)
    EndIf
    
    ::IncRegua1(STR0025) //"Inicializando saldos por OP"
    ::logProAtu(STR0046, STR0025, STR0025) // MENSAGEM
    oTabSldOP := BalanceByProductionOrder():New(::aFiliais, ::cFilProc, ::jParams['moedas'], oRequestCost)
    oTabSldOP:TableManager()
    oTabSldOP:dataLoader(oTabSldOP:TableName(),dDtIni,dDtFim)

    //Calcula o custo dos movimentos de reavaliação
    If ::jParams["MV_E330REA"]
        oMovREA := AverageCostRecalculation():New(::cFilProc,::jParams["moedas"],::jParams["MV_CUSFIL"],::jParams["MV_E330REA"])
        oMovREA:adjustAverageCostInMovTable()
        oMovREA:adjustAverageCostInProcTable()
    EndIf

    If ::jParams["calccp"] == 1
        oTabSldOPCP := BalanceByProductionOrderParts():New(::aFiliais,::cFilProc, ::jParams, oPartsReqCost)
        oTabSldOPCP:tableManager()
        oTabSldOPCP:initializeBalancesFromPreviousPeriod(::aFiliais,::jParams["MV_ULMES"],::jParams["datafin"])
        oTabSldOPCP:initializeBalancesFromMovements(::aFiliais)
    EndIf
    ::IncRegua1(STR0026) //"Saldos por OP inicializados"
    ::logProAtu(STR0046, STR0026, STR0026) // MENSAGEM

    ::runCalculation(oTabProc,oTabMov,oTabCC,oAccountLabor,oTabSldPorArmz,oTabNiv,oTabAgl,;
                     oTabSldOP, oTabSldOPCP, dDtIni, dDtFim, oTabProcCP, oUpdPartsMov, oRequestCost)

    If ::lJourney
        If ::oJourneyLog:processHasStarted(::oJourneyLog:cIdParent, ::oJourneyLog:cIdChild, STR0042)
            ::oJourneyLog:updateD3YPositi(STR0042)  // EST330
		    ::oJourneyLog:attStatus(STR0047, .F.) // FINISHED
        EndIf
    EndIf

    ::logProAtu(STR0048)

    If ::lJourney
        // Chama processo de analise e revisao apos termino do recalculo
        If !::lAutoAccounting
            ::E330Analysis()
        EndIf

        // Chama processo de contabilizacao automatica apos termino do recalculo
        If ::lAutoAccounting
            ::E330Accounting()
        EndIf
    EndIf

Return .T.

/*/{Protheus.doc} ValidParam
    Valida os parâmetros iniciais da rotina
    @type Method
    @author Squad Entradas
    @since 18/11/2024
    /*/
Method ValidParam()  Class IterativeCostMain 
    Local lRet       As Logical
    Local cFilBkp    As Character
    Local aParCheck  As Array 
    Local nFil       As Integer
    Local nPar       As Integer
    Local uPar       As Variant

    lRet := .T.
    cFilBkp := cFilAnt
    aParCheck := {}
    AAdd(aParCheck, {"MV_CQ"     , "98", "98"})
    //AAdd(aParCheck, {"MV_CUSTEXC", "S" , "S"})
    //AAdd(aParCheck, {"MV_CUSFIFO", .F. , .F.})
    AAdd(aParCheck, {"MV_CUSFIL" , "A" , "A"})
    AAdd(aParCheck, {"MV_CUSMED" , "M" , "M"})
    AAdd(aParCheck, {"MV_CUSZERO", "N" , "N"})
    //AAdd(aParCheck, {"MV_GERIMPV", "N" , "N"})
    AAdd(aParCheck, {"MV_LOCPROC", "99", "99"})
    AAdd(aParCheck, {"MV_PRODPR0", 1   , 1})
    AAdd(aParCheck, {"MV_ULMES"		,""		,"" 	})
    //AAdd(aParCheck, {"MV_M330THR"	,1 		,1  	})

    If lRet .And. Empty(::jParams["roteiro"])
        lRet := .F.
        ::EmitAlert(STR0022) //"Informe um roteiro de cálculo."
    EndIf
    D4E->(DbSetOrder(1)) //D4E_FILIAL+D4E_CODIGO+D4E_ORDEM
    If lRet .And. !D4E->(DBSeek(FWXFilial('D4E')+::jParams["roteiro"]))
        lRet := .F.
        ::EmitAlert(STR0023) //"O roteiro de cálculo informado não existe."
    EndIf

    For nFil := 1 To Len(::aFiliais)
        cFilAnt := ::aFiliais[nFil]
        If nFil == 1
            For nPar := 1 To Len(aParCheck)
                If GetMv(aParCheck[nPar, 1], .T.)
                    aParCheck[nPar, 2] := GetMv(aParCheck[nPar, 1])
                EndIf
            Next nPar
        Else
            For nPar := 1 To Len(aParCheck)
                If GetMv(aParCheck[nPar, 1], .T.)
                    uPar := GetMv(aParCheck[nPar, 1])
                Else
                    uPar := aParCheck[nPar, 3]
                EndIf
                If uPar != aParCheck[nPar, 2]
                    lRet := .F.
                    ::EmitAlert(I18N(STR0024,{aParCheck[nPar, 1]})) //"Diferença no conteúdo do parâmetro #1[MV_ULMES]# entre as filiais indicadas no roteiro selecionado."
                    Exit
                EndIf
            Next nPar
        EndIf
        If !lRet
            Exit
        EndIf
    Next nFil
    cFilAnt := cFilBkp

    If lRet .And. ::jParams["MV_ULMES"] >= ::jParams["datafin"]
        lRet := .F.
        ::EmitAlert(STR0021) //"A data limite final informada para execução da rotina de recalculo do custo medio e menor ou igual a data de inicio de processamento do parametro MV_ULMES. Favor verificar a data informada para processamento."
    EndIf
    
Return lRet

/*/{Protheus.doc} GetFiliais
    Recupera as filiais envolvidas no cálculo a partir do roteiro selecionado
    @type Method
    @author Squad Entradas
    @since 18/11/2024
    /*/
Method GetFiliais(cRoteiro As Character) Class IterativeCostMain 
    Local cQuery     As Character
    Local cAlTmp     As Character
    Local oQuery     As Object
    Local nBind      As Integer

    cQuery := " Select D4E_FILEXE, D4E_NUMEXE, D4E_NUMITE "
    cQuery += " From "+RetSQLName("D4E")
    cQuery += " Where "
    cQuery += " D4E_FILIAL = ? And "
    cQuery += " D4E_CODIGO = ? And "
    cQuery += " D_E_L_E_T_ = ? "
    cQuery := ChangeQuery(cQuery)

    oQuery := FwExecStatement():New(cQuery)
    nBind := 1
    oQuery:SetString(nBind++, FWXFilial('D4E'))
    oQuery:SetString(nBind++, cRoteiro)
    oQuery:SetString(nBind++, ' ')

    cAlTmp := oQuery:OpenAlias()

    ::aFiliais := {}
    ::aRoteiro := {}
    While !(cAlTmp)->(EoF())
        If ::jParams["MV_CUSFIL"] != "E"
            If AScan(::aFiliais, {|x| x == (cAlTmp)->D4E_FILEXE}) == 0
                AAdd(::aFiliais, (cAlTmp)->D4E_FILEXE)
            EndIf
        EndIf
        AAdd(::aRoteiro, {(cAlTmp)->D4E_FILEXE, (cAlTmp)->D4E_NUMITE})

        ::nNumExec := (cAlTmp)->D4E_NUMEXE

        (cAlTmp)->(DbSkip())
    EndDo
    (cAlTmp)->(DbCloseArea())

    If ::jParams["MV_CUSFIL"] == "E"
        If 'E' $ FWSM0Layout()
            ::aFiliais := FWAllFilial(FWCompany(),,cEmpAnt,.F.)            
        Else
            ::aFiliais := FWAllFilial(,,cEmpAnt,.F.)
        EndIf
    EndIf

Return 

/*/{Protheus.doc} IncRegua1
    Seta a régua 1 do TNewProccess ou grava o log
    @type Method
    @author Squad entradas
    @since 18/11/2024
    /*/
Method IncRegua1(cMessage As Character) Class IterativeCostMain 
    
    If ::lIsNewProc 
        ::oProc:IncRegua1(OemToAnsi(cMessage))
        ::oProc:SaveLog(OemToAnsi(cMessage))
    Else
    EndIf
Return

/*/{Protheus.doc} IncRegua2
    Seta a régua 2 do TNewProccess ou grava o log
    @type Method
    @author Squad entradas
    @since 18/11/2024
    /*/
Method IncRegua2(cMessage As Character) Class IterativeCostMain 
    
    If ::lIsNewProc 
        ::oProc:IncRegua2(OemToAnsi(cMessage))
        ::oProc:SaveLog(OemToAnsi(cMessage))
    Else
    EndIf
Return

/*/{Protheus.doc} EmitAlert
    Apresenta help ou grava o log
    @type Method
    @author Squad entradas
    @since 18/11/2024
    /*/
Method EmitAlert(cMessage As Character) Class IterativeCostMain 
    
    If ::lIsNewProc 
        Help('',1,'EST330VLD',,cMessage,1,0)
    Else
        Help('',1,'EST330VLD',,cMessage,1,0)
    EndIf
Return

Method runCalculation(oTabProc,oTabMov,oTabCC,oAccountLabor,oTabSldPorArmz,oTabNiv,oTabAgl,oTabSldOP,oTabSldOPCP,dDtIni,dDtFim, oTabProcCP, oUpdPartsMov, oRequestCost) Class IterativeCostMain
    local cNivel       as character
    local cNivInv      as character
    local cFilAtu      as character
    local cTabNivel    as character
    local cTabMovAgl   as character
    local lExistsTRM   as logical
    local nIter        as numeric
    local nI           as numeric
    local nExec        as integer
    local oThrManager  as object
    local oMovement    as object
    local oMovREA      as object
    local oAdj         as object
    local lRet         as logical
    local lUpdateTRM   as logical
    Local jMessage     as json
    Local nMoeda       as integer
    Local nFil         as integer

    oThrManager := ThreadManager():New(::jParams["MV_E330GRD"], "EST330_"+cEmpAnt, ::jParams['IDEXEC'])

    lRet := oThrManager:Prepare()
    If !lRet
        //Gravar log e finalizar
        UserException(oThrManager:GetError())
    EndIf

    //Seta o índice da tabela de movimentos aglutinados
    cTabMovAgl := oTabAgl:tableName()
    DbSelectArea(cTabMovAgl)
    (cTabMovAgl)->(DbSetOrder(8)) //FILPROC+FILIAL+COD+ENTSAI+CUSTOMEDIO

    //Obtem o numero maximo de produtos que serao processados simultaneamente
    If oThrManager:nTotThread > 1
        ::nMaxProductsPerThread := NMAXPROD * oThrManager:nTotThread
    EndIf

    //Laço de execuções do roteiro
    For nExec := 1 To ::nNumExec

        jMessage := JsonObject():New()
        jMessage:FromJson("{}")
        jMessage["roteiro"] := I18N(STR0049,{::aE330ParamZX[1], cValToChar(nExec), cValToChar(::nNumExec)}) // Executando roteiro de calculo #1[000001]# - Execucao #2[1]# de #3[2]#
        ::logProAtu(STR0046, STR0057, jMessage:ToJson(), "3") // MENSAGEM - Execucao do roteiro de calculo
        ::IncRegua1(jMessage["roteiro"])
        //Laço de filiais
        For nI := 1 To Len(::aRoteiro)
            nIter      := 1
            lUpdateTRM := .T.
            cFilAtu := ::aRoteiro[nI, 1]

            jMessage["filial"] := I18N(STR0050,{::aRoteiro[nI, 1], cValToChar(nI), cValToChar(Len(::aRoteiro))}) // Processando filial #1[D MG 01 ] - #2[1] de #3[2]
            ::logProAtu(STR0046, STR0058, jMessage:ToJson(), "4", cFilAtu) // MENSAGEM - Processamento das filiais
            ::IncRegua1(jMessage["filial"])

            lExistsTRM := oTabSldOP:existsProductionOrder(cFilAtu,oTabSldOP:tableName())

            //Totaliza os apontamentos de produção
            If lExistsTRM
                oTabSldOP:productionEntryTotalizer(oTabSldOP:tableName())
            EndIf

            cTabNivel := oTabNiv:LoopNivel(::cFilProc, cFilAtu)

            //Laço de iterações
            Do While nIter <= ::aRoteiro[nI, 2]
                (cTabNivel)->(DbGoTop())

                jMessage["iteracao"] := I18N(STR0051,{cValToChar(nIter), cValToChar(::aRoteiro[nI, 2])}) // Executando iteração #1[1] de #2[2]"
                ::logProAtu(STR0046, STR0059, jMessage:ToJson(), "5", cFilAtu) // MENSAGEM - Execucao das iteracoes
                ::IncRegua1(jMessage["iteracao"])

                //Calcula o custo das requisições de desmontagem uma vez por iteração
                oRequestCost:DisassembleRequestCost(cFilAtu)

                //Laço de níveis
                Do While !(cTabNivel)->(EoF())
                    cNivel     := (cTabNivel)->(NIVEL)
                    cNivInv    := (cTabNivel)->(NIVINV)
                                        
                    ::ThreadLoop(oTabNiv, oTabSldOP, oTabSldOPCP, oTabMov, oTabProc, lExistsTRM, cFilAtu, nExec, nIter, cNivel, cNivInv, oThrManager, oTabProcCP)

                    (cTabNivel)->(DbSkip())

                    //Executa a thread ao trocar de nivel
                    If !Empty(::aAcumulador)
                        ::ExecuteThread(::jParams["MV_E330GRD"], oThrManager, cFilAtu, nExec, nIter, cNivInv)
                        ::ControlVariablesCleaner()
                        ::WaitThread(oThrManager)
                    EndIf
                EndDo
                nIter++
            EndDo
            (cTabNivel)->(DbCloseArea())

            If jMessage:HasProperty("iteracao")
                jMessage:DelName("iteracao")
            EndIf

            //Atualiza os saldos finais da SC2
            //Conout("Atualizando SC2")
            If lExistsTRM
                oTabSldOP:finalBalanceUpdater(::cFilProc, cFilAtu)
            EndIf
        Next nI
    Next nExec

    ::logProAtu(STR0046, STR0052, STR0052) // MENSAGEM - Termino da execucao do roteiro
    ::IncRegua1(STR0052)

    oThrManager:Terminate()

    //Atualiza o custo dos movimentos SD1/SD2/SD3
    ::logProAtu(STR0046, STR0053, STR0053, "6") // MENSAGEM - Gravacao das tabelas finais - Inicio
    ::IncRegua1(STR0053)
    oMovement := Movement():New(::cFilProc, ::aFiliais,::jParams["moedas"], ::jParams, Self)
    oMovement:updateStockMovements(::jParams['dataini'],::jParams['datafin'])

    //Calcula o custo dos movimentos de reavaliação
    If !::jParams["MV_E330REA"]
        oMovREA := AverageCostRecalculation():New(::cFilProc,::jParams["moedas"],::jParams["MV_CUSFIL"],::jParams["MV_E330REA"])
        oMovREA:adjustAverageCostInMovTable()
        oMovREA:adjustAverageCostInProcTable()
        oMovREA:updateRevaluationMovement(oMovement,::jParams['dataini'])
    EndIf

    //Processa o custo na SB2
    oTabSldPorArmz:SaldoFimSB2(oTabProc:tableName(), Self)
    ::logProAtu(STR0046, STR0054, STR0054, "6") // MENSAGEM - Gravacao das tabelas finais - Termino
    ::IncRegua1(STR0054)

    //Grava o custo nas tabelas de partes
    If ::jParams["calccp"] == 1
        ::logProAtu(STR0046, STR0055, STR0055, "7") // MENSAGEM - Gravacao das tabelas do custo em partes - Inicio
        ::IncRegua1(STR0055)
        oUpdPartsMov:insertTable()
        ::logProAtu(STR0046, STR0056, STR0056, "7") // MENSAGEM - Gravacao das tabelas do custo em partes - Termino
        ::IncRegua1(STR0056)
    EndIf

    //Inclui os movimentos de ajuste de arredondamento
    oAdj := StockCostRoundingAdjuster():New(::cFilProc,::jParams["moedas"],::jParams['dataini'],::jParams['datafin'],oMovement:nCountNFs)
    oAdj:fetchProductsForProcessing()
    oAdj:compareBalances()

    //Inclui os movimentos de ajuste de arredondamento para o custo em partes
    If ::jParams["calccp"] == 1
        oAdjCP := StockCostRoundingAdjusterCP():New(::cFilProc, ::jParams["moedas"],::jParams['dataini'],::jParams['datafin'],::jParams["revisao_vigente"],oAdj:cDocumento,oAdj:cSeqCalc)
        For nFil := 1 To Len(::aFiliais)
            For nMoeda := 1 To Len(::jParams["moedas"])
                oAdjCP:fetchProductsForProcessing(::aFiliais[nFil], ::jParams["moedas", nMoeda])
                oAdjCP:compareBalances()
            Next nMoeda
        Next nFil
    EndIf

    //Limpa tabela de threads
    oThrManager:CleanUp(::jParams["IDEXEC"])

    //Limpa o semáforo de processamento
    ::unlockSemaphore()
Return

/*/{Protheus.doc} buildJsonMov
    Monta json com movimentos a serem processados
    @type Method
    @author Squad Entradas
    @since 22/11/2024
    @version 1.0
    @param  cCustoMedio, character, mov. a custo medio
            cCF, character, CF do mov.
            cAlias, character, alias do mov.
            nRecno, numeric, recno do mov.            
    @return jMovements, object, objeto com mov. a processar
    /*/
Method buildJsonMov(cCustoMedio, cCF, cAlias, nRecno) Class IterativeCostMain
    Local jMovements As Json

    jMovements := JsonObject():New()
    jMovements:FromJson('{"movement":[]}')
    aAdd(jMovements["movement"], JsonObject():New())
    jMovements["movement"][Len(jMovements["movement"])]["customedio"] := cCustoMedio
    jMovements["movement"][Len(jMovements["movement"])]["cf"]         := cCF
    jMovements["movement"][Len(jMovements["movement"])]["alias"]      := cAlias
    jMovements["movement"][Len(jMovements["movement"])]["r_e_c_n_o_"] := nRecno

Return jMovements

/*/{Protheus.doc} ThreadLoop
    Implementa o controle de threads sobre o loop de produtos
    @author user
    @since 06/12/2024
    @type Method
    @param param_name, param_type, param_descr
    @return return_var, return_type, return_description
    /*/
Method ThreadLoop(oTabNiv, oTabSldOP, oTabSldOPCP, oTabMov, oTabProc, lExistsTRM, cFilAtu, nExec, nIter, cNivel, cNivInv, oThrManager, oTabProcCP) Class IterativeCostMain
    local cProduto      as character
    local cAlGrp        as character
    local cAliasPrd     as character
    local nGrupo        as integer
    local nTipo         as integer
    local nGroupSize    as integer
    local lProcessa     as logical
    local lMultiThread  as logical
    local lSkip         := .T.

    cAlGrp       := oTabNiv:LoopGrupo(::cFilProc, cFilAtu, cNivInv)
    nTipo        := ::jParams["MV_E330GRD"]
	lMultiThread := nTipo == 3

    //Atualiza o valor final das OP's
    If lExistsTRM
        If ::jParams["calccp"] == 1
            oTabSldOPCP:openingBalancesToFinal(cFilAtu)
            oTabSldOPCP:updateOPBalancePerProcessingLevel(cFilAtu, cNivInv)
        EndIf
        oTabSldOP:updateFinalValueAndProductionEntries(cFilAtu, oTabMov:tableName(),oTabSldOP:tableName(), oTabProc:TableName(),cNivInv)
    EndIf

    While !(cAlGrp)->(EoF())
        nGrupo := (cAlGrp)->GRUPO
        lSkip  := .T.

        //Conout("Grupo "+cValToChar(nGrupo)+"  ")

        cAliasPrd  := oTabNiv:LoopProd(::cFilProc, cFilAtu, cNivInv, nGrupo) 
        nGroupSize := (cAliasPrd)->(NREC)

        //Valida se ha espaço suficiente na thread para considerar os produtos do nivel
        //atual. Caso negativo, atualiza as variáveis de controle para execucao da thread 
        If !Empty(::aAcumulador) .And. (nGroupSize+::nTotalRecords > ::nMaxProductsPerThread)
            lProcessa := .T.
            lSkip     := .F.
        EndIf

        While !(cAliasPrd)->(EoF()) .And. !lProcessa

            cProduto := (cAliasPrd)->COD
            ::nTotalRecords++

            oTabProc:InitStockBalance(::cFilProc, cFilAtu, cProduto, nIter)
            
             If ::jParams["calccp"] == 1
                oTabProcCP:RetrieveProcessingTable(::cFilProc, cFilAtu, cProduto, nIter)
             EndIf

            //Conout("Produto "+cProduto+"  ")
            
            //Agrupa os produtos sem grupo, para chamar menos threads
            If lMultiThread
                ::nRecordsInThread++
                //Inicializa o array se estiver vazio
                If Empty(::aAcumulador)
                    AAdd(::aAcumulador, {cProduto})
                Else
                    //Divide os produtos que não possuem grupo em threads
                    If nGrupo == 0 .And. ::nRecordsInThread > NMAXPROD
                        AAdd(::aAcumulador, {cProduto})
                        ::nRecordsInThread := 1
                    Else
                        //Se tiver grupo, todos os produtos do mesmo nivel vao
                        //para a mesma thread, independente do tamanho
                        AAdd(::aAcumulador[Len(::aAcumulador)],cProduto)
                    EndIf
                EndIf
                (cAliasPrd)->(DbSkip())
                Loop
            Else
                AAdd(::aAcumulador, cProduto)
            
                If nGrupo == 0 .And. ::nTotalRecords >= NMAXPROD
                    ::ExecuteThread(nTipo, oThrManager, cFilAtu, nExec, nIter, cNivInv)
                    ::ControlVariablesCleaner()
                    ::WaitThread(oThrManager)
                EndIf
                (cAliasPrd)->(DbSkip())
            EndIf
    EndDo

        (cAliasPrd)->(DbCloseArea())
        
        If !Empty(::aAcumulador) .And. (::nTotalRecords >= ::nMaxProductsPerThread .Or. lProcessa)
            ::ExecuteThread(nTipo, oThrManager, cFilAtu, nExec, nIter, cNivInv)
            ::ControlVariablesCleaner()
            ::WaitThread(oThrManager)
        EndIf

        If lSkip
            (cAlGrp)->(DbSkip())
        EndIf
    EndDo
    (cAlGrp)->(DbCloseArea())    
    
Return

/*/{Protheus.doc} EST330Thr
    Função de teste de thread.
    @type  Function
    @author user
    @since 06/12/2024
    /*/
Function EST330Thr(aParams)
    Local cFilP    := aParams[1]
    Local jParams  := aParams[2]
    Local aFil     := aParams[3]
    Local cFilAtu  := aParams[4]
    Local nExec    := aParams[5]
    Local nIter    := aParams[6]
    Local nTipo    := aParams[7]
    Local aProd    := aParams[8]
    Local cNivInv  := aParams[9]
    Local nI
    Local cTabMovAgl
    Local jMovements As Json
    Local oTabSldOP
    Local dDtIni := jParams['dataini']
    Local dDtFim := jParams['datafin']
    Local oThrManager
    Local oRequestCost := Nil As Object

    If nTipo == 3
        oThrManager := totvs.protheus.backoffice.stock.iterativecost.processing.threads.GetThrManager()
        For nI := 1 to Len(aProd)
            oThrManager:Execute("totvs.protheus.backoffice.stock.iterativecost.processing.mainprogram.EST330Thr", {cFilP, jParams, aFil, cFilAtu, nExec, nIter, 2, aProd[nI],cNivInv})
        Next nI
        IterativeCostMain():WaitThread(oThrManager)
    Else    
        dDtIni := SToD(StrTran(dDtIni,"/",""))
        dDtFim := SToD(StrTran(dDtFim,"/",""))

        oTabSldOP  := BalanceByProductionOrder():New(aFil, cFilP, jParams['moedas'])
        cTabMovAgl := AgglutinatedMovementTable():TableName()
        TableManager():UseArea(cTabMovAgl, AgglutinatedMovementTable():TableIndexes() )
        oRequestCost := RequestCost():New(cFilP, aFil, jParams)
        oProcMovement := movementProcess():New(aFil, cFilP, jParams, oRequestCost)

        (cTabMovAgl)->(DbSetOrder(8)) //FILPROC+FILIAL+COD+ENTSAI+CUSTOMEDIO

        For nI := 1 To Len(aProd)
            cProduto := aProd[nI]

            //Processa os movimentos do produto
            If (cTabMovAgl)->(DbSeek(cFilP+cFilAtu+cProduto))
                //Laço de produtos
                While !(cTabMovAgl)->(EoF()) .And.;
                    cFilP+cFilAtu+cProduto == (cTabMovAgl)->(FILPROC+FILIAL+COD)
                    
                        //Processa o movimento
                        jMovements := IterativeCostMain():buildJsonMov((cTabMovAgl)->(CUSTOMEDIO),(cTabMovAgl)->(CF),(cTabMovAgl)->(ALIAS),(cTabMovAgl)->(RECNO()))
                        oProcMovement:procMovement(jMovements, oTabSldOP, aParams[2]['moedas'], cFilAtu, dDtIni, dDtFim, nExec, nIter)

                    (cTabMovAgl)->(DbSkip())
                EndDo
            EndIf

            //Grava histórico das iterações
            /*If ValType(jVariacao:FromJson((oTabProc:tableName())->HISTVAR)) == 'C'
                jVariacao:FromJson('{"historico":[{}]}')
            Else
                AAdd(jVariacao['historico'], JsonObject():New())
            EndIf

            RecLock(oTabProc:tableName(), .F.)
            (oTabProc:tableName())->VARIACAO := (oTabProc:tableName())->(Abs(CMPROC1-CMHIST1))
            jVariacao['historico', Len(jVariacao['historico']), 'iteracao']   := (oTabProc:tableName())->ITERACAO
            jVariacao['historico', Len(jVariacao['historico']), 'variacao']   := (oTabProc:tableName())->VARIACAO
            jVariacao['historico', Len(jVariacao['historico']), 'customedio'] := (oTabProc:tableName())->CMPROC1
            (oTabProc:tableName())->HISTVAR  := jVariacao:ToJson()
            (oTabProc:tableName())->CMHIST1  := (oTabProc:tableName())->CMPROC1
            (oTabProc:tableName())->(MsUnlock())*/

        Next nI
    EndIf
Return 

/*/{Protheus.doc} WaitThread
    Método responsável por aguardar a finalização da thread e interromper
    caso ocorra algum tipo de erro durante o processamento
    @author Squad Entradas
    @since 31/03/2025
    @version 1.0
    oThrManager, objeto da thread manager
/*/
Method WaitThread(oThrManager) Class IterativeCostMain
    Local cErro := ""

    While Empty(cErro)
        cErro := oThrManager:CheckForErrors()
        
        If oThrManager:CheckIfDone()
            Exit
        EndIf
        Sleep(500)
    End

    If cErro != ""
        oThrManager:Terminate()
        
        //Gravar tabela de log
        UserException(oThrManager:cError+oThrManager:cErrorStack+oThrManager:cErrorEnv)
    EndIf

Return

/*/{Protheus.doc} ControlVariablesCleaner
    Método responsável reiniciar as variáveis de controle de threads
    @author Squad Entradas
    @since 31/03/2025
    @version 1.0
/*/
Method ControlVariablesCleaner() Class IterativeCostMain
    ASize(::aAcumulador, 0)
    ::aAcumulador      := {}
    ::nTotalRecords    := 0
    ::nRecordsInThread := 0
Return

/*/{Protheus.doc} ExecuteThread
    Executa as threads quando utilizado multithreads
    @author Squad Entradas
    @since 31/03/2025
    @version 1.0
/*/
Method ExecuteThread(nTipo, oThrManager, cFilAtu, nExec, nIter, cNivInv) Class IterativeCostMain

    oThrManager:Execute("totvs.protheus.backoffice.stock.iterativecost.processing.mainprogram.EST330Thr", {::cFIlProc, ::jParams, ::aFiliais, cFilAtu, nExec, nIter, nTipo, ::aAcumulador, cNivInv})

Return

/*/{Protheus.doc} InitSD3UUID Class IterativeCostMain
    Popula o campo D3_MSUID com o identificador único
    @Type Method
    @author Squad Entradas
    @since 02/04/2025
    /*/
Method InitSD3UUID(aFil, dDtIni, dDtFim, cRevis) Class IterativeCostMain
    Local cQuery := ""
    Local nI     := 0

    For nI := 1 To Len(aFil)
        cQuery := " Update "+RetSQLName("SD3")
        cQuery += " Set "
        If 'MSSQL' $ TCGetDB()
            cQuery += " D3_MSUID = (newid()) "
        ElseIf TCGetDB() $ 'ORACLE'
            cQuery += " D3_MSUID = SYS_GUID() "
        ElseIf TCGetDB() $ 'POSTGRES'
            cQuery += " D3_MSUID = uuid_generate_v4() "
        EndIf
        cQuery += " Where "
        cQuery += " D3_FILIAL  = '"+FWXFilial('SD3', aFil[nI])+"' And "
        cQuery += " D3_EMISSAO >= '"+DToS(dDtIni)+"' And "
        cQuery += " D3_EMISSAO <= '"+DToS(dDtFim)+"' And "
        cQuery += " D3_MSUID   Is Null And "
        cQuery += " D3_ESTORNO = ' ' And "
        cQuery += " D_E_L_E_T_ = ' ' "
        TableManager():RunQuery(cQuery)
    Next nI

Return 

/*/{Protheus.doc} lockSemaphore
    Cria um semáforo de processamento para as filiais do roteiro
    @Type Method
    @author Squad Entradas
    @since 21/08/2025
    /*/
Method lockSemaphore() Class IterativeCostMain
    local nX       as numeric
    local lRet     as logical
    local cFilBack := cFilAnt

    For nX := 1 to Len(::aFiliais)
        AAdd(::aFilCalc,{.T.,::aFiliais[nX],.F.,.F.,.F.})
    Next nX

    lRet := M330331Lk(@::aFilCalc)

    //Restaurado a cFilAnt pois a função M330331Lk altera a filial corrente 
    cFilAnt := cFilBack

Return lRet

/*/{Protheus.doc} unlockSemaphore
    Desbloqueia as filiais do semáforo ao término do processamento
    @Type Method
    @author Squad Entradas
    @since 21/08/2025
    /*/
Method unlockSemaphore() Class IterativeCostMain
    local cFilBack := cFilAnt

    M330331ULk(::aFilCalc)

    //Restaurado a cFilAnt pois a função M330331ULk altera a filial corrente
    cFilAnt := cFilBack

Return

/*/{Protheus.doc} logProAtu
    Grava os logs de execucao na tabela D3X
    @author Squad.Entradas
    @since 01/10/2025
    @version 1.0
    @param cType, character, Tipo da mensagem a ser gravado no campo D3X_INFO
    @param cText, character, Texto da mensagem a ser gravada no campo D3X_MSG
    @param cDetail, character, Texto detalhado a ser gravada no campo D3X_DET
    @param cStatus, character, Status do processamento a ser gravado no campo D3X_STATUS
    @param cFilAtu, character, Filial processada a ser gravada no campo D3X_FILLOG
    /*/
Method logProAtu(cType, cText, cDetail, cStatus, cFilAtu) Class IterativeCostMain

    Default cFilAtu := cFilAnt

    ::oJourneyLog:LogProAtu(cType, cText, cDetail, ::cFilProc, cStatus, ::jParams["datafin"], cFilAtu, ::lJourney, .F., ::aE330ParamZX)

Return

/*/{Protheus.doc} E330Analysis
    Chama processo de analise e revisao apos termino do recalculo
    @type Method
    @author Squad.Entradas
    @since 22/10/2025
    @version 1.0
    /*/
Method E330Analysis() Class IterativeCostMain
    Local oAnalysis    := acResultsAnalysisService():new()
    Local oItemBranch  := JsonObject():New()
    Local oBranches    := JsonObject():New()
    Local aFilAnalysis := {}
    Local aFilterAna   := {{"FILTER", ''}}
    Local nX := 0

    For nX := 1 To Len(::aFiliais)
        aAdd(aFilAnalysis, JsonObject():New())
        aFilAnalysis[nX]["Code"]		:= ::aFiliais[nX]
        aFilAnalysis[nX]["Description"] := ""
        aFilAnalysis[nX]["Cgc"]	        := ""
    Next nX

    oItemBranch["items"] := aFilAnalysis
    oBranches["branches"] := oItemBranch
    oBranches["calculationModel"] := "2"
    oBranches["cusfil"] := ::jParams["MV_CUSFIL"]

    oAnalysis:doTheAnalysis(::oJourneyLog:cIdParent, .F., .T., 1, 10, aFilterAna, oBranches)

Return

/*/{Protheus.doc} E330Accounting
    Chama processo de contabilizacao automatica apos termino do recalculo
    @type Method
    @author Squad.Entradas
    @since 23/10/2025
    @version 1.0
    /*/
Method E330Accounting() Class IterativeCostMain
    Local aListaFil := {}
    Local nX        := 0

    For nX := 1 To Len(::aFiliais)
        aAdd(aListaFil, {.T., ::aFiliais[nX], Nil, Nil, Nil})
    Next nX

    M330startC(aListaFil, ::oJourneyLog:cIdParent, cFilAnt, FWGrpCompany())

Return

/*/{Protheus.doc} deleteReversalMovements
    Deleta os movimentos de estornos.
    @type Method
    @author Squad Entradas
    @since 10/04/2026
    @param aFil, array, filiais para processamento
    @param dInicio, date, data inicial do processamento
    @param dFim, date, data final do processamento
    /*/
Method deleteReversalMovements(aFil, dInicio, dFim) Class IterativeCostMain 
    
    Local lWmsNew := SuperGetMV("MV_WMSNEW", .F., .F.)
    Local nI      := 0
    Local cFilBkp := cFilAnt

    For nI := 1 To Len(aFil)
        cFilAnt := aFil[nI]

        TCSpExec(xProcedures(::cSPMAT013),;
            cFilAnt,;                              // 01. Filial a processar.
            SuperGetMV("MV_RASTRO", .F., "N")   ,; // 02. Parametro MV_RASTRO.
            SuperGetMV("MV_LOCALIZ", .F., "N")  ,; // 03. Parametro MV_LOCALIZ.
            DToS(dInicio)                       ,; // 04. Data inicial do processamento.
            DToS(dFim)                          ,; // 05. Data final do processamento.
            IIF(lWmsNew, '1', '0')              ,; // 06. Parametro MV_WMSNEW.
            SuperGetMV("MV_ARQPROD", .F., "SB1"))  // 07. Parametro MV_ARQPROD.
    Next nI

    // Restaura filial original após o processamento.
    cFilAnt := cFilBkp

Return
