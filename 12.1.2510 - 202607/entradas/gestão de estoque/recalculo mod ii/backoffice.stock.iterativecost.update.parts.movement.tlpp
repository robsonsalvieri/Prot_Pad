#include "tlpp-core.th"
#include "totvs.ch"

namespace totvs.protheus.backoffice.stock.iterativecost.update.parts.movement

using namespace totvs.protheus.backoffice.stock.iterativecost.table.manager
using namespace totvs.protheus.backoffice.stock.iterativecost.table.analyticalmovementtable
using namespace totvs.protheus.backoffice.stock.iterativecost.table.parts.analyticalmovementtable
using namespace totvs.protheus.backoffice.stock.iterativecost.table.aglutinattedmovementtable
using namespace totvs.protheus.backoffice.stock.iterativecost.table.parts.agglutinatedMovementPartsTable
using namespace totvs.protheus.backoffice.stock.iterativecost.table.processingtable
using namespace totvs.protheus.backoffice.stock.iterativecost.table.parts.processingtable
using namespace totvs.protheus.backoffice.stock.iterativecost.table.balancebywarehouse
using namespace totvs.protheus.backoffice.stock.iterativecost.table.balancebyproductionorder
using namespace totvs.protheus.backoffice.stock.iterativecost.table.parts.balancebyproductionorderparts
using namespace totvs.protheus.backoffice.stock.iterativecost.view.acquisitioncost
using namespace totvs.protheus.backoffice.stock.iterativecost.view.parts.acquisitioncost

/*/{Protheus.doc} updatePartsMovement
    Classe resposavel por gravar os valores do custo em partes
    dos movimentos nas respectivas tabelas
    @author Squad.Entradas
    @since 11/06/2025
    @version 1.0
    /*/
Class UpdatePartsMovement from TableManager

    public data oStatement      as object
    public data oStatementAcq   as object
    public data oStatementSldAtu as object
    public data oStatementSldOP  as object
    public data oBulkD4L        as object
    public data oBulkD4M        as object
    public data oBulkD4N        as object
    public data oBulkD4J        as object
    public data oBulkD4I         as object
    public data oBulkD4O         as object
    public data aStructD4L      as array
    public data aStructD4M      as array
    public data aStructD4N      as array
    public data aStructD4J      as array
    public data aStructD4I       as array
    public data aStructD4O       as array
    public data lCanBulkD4L     as logical
    public data lCanBulkD4M     as logical
    public data lCanBulkD4N     as logical
    public data lCanBulkD4J     as logical
    public data lCanBulkD4I      as logical
    public data lCanBulkD4O      as logical
    public data lClosing         as logical
    public data aMoedas         as array
    public data aFiliais        as array
    public data cCusfil         as character
    public data cRevisao        as character
    public data cDtIni          as character
    public data cDtFim          as character
    public data cFilProc        as character
    public data cViewPartAcq    as character
    public data cDataFec         as character
    public data jVwAcqCstParams as Json
    public data nDecCM          as numeric
    public data nDecCst         as numeric

    public method new()
    public method insertTable()
    private method getQueryMov()
    private method getQueryD4J()
    private method getQueryAcqCost()
    private method prepBulkInsert()
    private method bulkPrepare()
    private method bulkInsert()
    private method bulkInsertD4J()
    private method bulkClose()
    public method deleteD4X()
    private method getAliasSldAtu()
    private method bulkInsertD4I()
    private method getAliasSldOP()
    private method bulkInsertD4O()

EndClass

/*/{Protheus.doc} new
    Metodo construtor da classe
    @author Squad.Entradas
    @since 11/06/2025
    @version 1.0
    @param jParams, json, json de parametros
    /*/
Method new(jParams, cFilProc, aFiliais, lClosing, cDataFec) class UpdatePartsMovement
    _Super:New({})
    ::aMoedas     := jParams["moedas"]
    ::cCusfil     := jParams["MV_CUSFIL"]
    ::cRevisao    := jParams["revisao_vigente"]
    ::cDtIni      := DToS(jParams["dataini"])
    ::cDtFim      := DToS(jParams["datafin"])
    ::cFilProc    := cFilProc
    ::aFiliais    := aFiliais
    ::lCanBulkD4L := .F.
    ::lCanBulkD4M := .F.
    ::lCanBulkD4N := .F.
    ::lCanBulkD4J := .F.
    ::lCanBulkD4I := .F.
    ::lCanBulkD4O := .F.
    ::lClosing    := lClosing
    ::cDataFec    := cDataFec
    If D4D->(DbSeek(FWXFilial('D4D')+ViewPartsAcquisitionCost():GetViewID()))
        ::cViewPartAcq := D4D->D4D_VWNAME
    EndIf
    ::jVwAcqCstParams := JsonObject():New()
    If D4D->(DbSeek(FWXFilial('D4D')+ViewAcquisitionCost():GetViewID()))
        ::jVwAcqCstParams:FromJson(D4D->D4D_PARAM)
    EndIf
    ::nDecCM            := TamSX3("D4K_UNITAR")[2]
    ::nDecCst           := TamSX3("D4K_TOTAL")[2] 
Return

/*/{Protheus.doc} insertTable
    Metodo resposavel por inserir os valores do custo em partes
    dos movimentos nas respectivas tabelas
    @author Squad.Entradas
    @since 18/06/2025
    @version 1.0
    /*/
Method insertTable() class UpdatePartsMovement
    Local cQueryMov  as character
    Local cQueryAcq  as character
    Local cQueryOP   As character
    Local cAliasOP   as character
    Local cAliasTemp as character
    Local cAliasAcq  as character
    Local cMoeda     as character
    Local cFilAtu    as character
    Local nMoeda     as numeric
    Local nFilial    as numeric

    ::bulkPrepare()

    If !::lClosing
        ::deleteD4X()

        cQueryMov := ::getQueryMov()
        cQueryAcq := ::getQueryAcqCost()
        cQueryOP  := ::getQueryD4J()

        //Inclui os registros das tabelas D4L, D4M e D4N
        For nFilial := 1 To Len(::aFiliais)
            cFilAtu := ::aFiliais[nFilial]
            For nMoeda := 1 To Len(::aMoedas)
                cMoeda := ::aMoedas[nMoeda]

                cAliasTemp := ::prepBulkInsert(cQueryMov, cMoeda, .F., cFilAtu)
                ::bulkInsert(cAliasTemp)

                cAliasAcq  := ::prepBulkInsert(cQueryAcq, cMoeda, .T., cFilAtu)
                ::bulkInsert(cAliasAcq)

                //Inclui os registros da tabela D4J (Ordens de Produção)
                ::bulkInsertD4J(cQueryOP, cMoeda, cFilAtu)
            Next nMoeda
        Next nFilial        

    Else
        // Insere os registros na tabela D4I (Saldos Iniciais - Custo em partes)
        // na virada dos saldos
        cAliasTemp := ::getAliasSldAtu()
        ::bulkInsertD4I(cAliasTemp)

        // Insere os registros na tabela D4O (Sld.Inicial OP - Custo em partes)
        // na virada dos saldos
        cAliasTemp := ::getAliasSldOP()
        ::bulkInsertD4O(cAliasTemp)
    EndIf

    ::bulkClose()

Return

/*/{Protheus.doc} getQueryMov
    Retorna query para busca dos valores do custo em partes
    @author Squad.Entradas
    @since 11/06/2025
    @version 1.0
    @return cQuery, character, query
    /*/
Method getQueryMov() class UpdatePartsMovement
    Local cOutros     as character
    Local cTableAnl   as character
    Local cTableAnlCP as character
    Local cTableAgl   as character
    Local cTableAglCP as character
    Local cTablePro   as character
    Local cTableProCP as character
    Local cQuery      as character

    cOutros     := Replicate("9", TamSX3("D4G_CODPAR")[1])
    cTableAnl   := AnalyticalMovementTable():TableName()
    cTableAnlCP := AnalyticalMovementPartsTable():TableName()
    cTableAgl   := AgglutinatedMovementTable():TableName()
    cTableAglCP := AgglutinatedMovementPartsTable():TableName()
    cTablePro   := ProcessingTable():TableName()
    cTableProCP := PartsProcessingTable():TableName()

    cQuery := "SELECT "
    cQuery += "TRG.ALIAS TAB, " 
    cQuery += "TRG.RECNO RECNO, "
    cQuery += "CASE "
    cQuery += "    WHEN TRG.ALIAS = 'SD1' "
    cQuery += "        THEN 'D4L' "
    cQuery += "    WHEN TRG.ALIAS = 'SD2' "
    cQuery += "        THEN 'D4M' "
    cQuery += "    WHEN TRG.ALIAS = 'SD3' "
    cQuery += "        THEN 'D4N' "
    cQuery += "END TABCP, "
    cQuery += "COALESCE(TRGCP.CODPAR, TRHCP.CODPAR, '" + cOutros + "' ) CODPAR, "
    cQuery += "COALESCE(TRGCP.MOEDA, ?) MOEDA, "
    //Custo de requisição
    cQuery += "Case "
    cQuery += "    When TRG.CALCREQ = 'S' "
    cQuery += "         Then TRGCP.CSTRECP "
    //Demais custos
    cQuery += "Else "
    cQuery += "CASE "
    cQuery += "    WHEN TRG.CUSTOMEDIO = 'S' "
    cQuery += "        THEN "
    cQuery += "            CASE"
    cQuery += "                WHEN TRHCP.FILIAL IS NULL "
    cQuery += "                    THEN TRG.QTDORI * TRH.CMPROC? "
    cQuery += "                ELSE TRG.QTDORI * TRHCP.CMPROC "
    cQuery += "            END "
    cQuery += "    ELSE "
    cQuery += "        CASE "
    cQuery += "            WHEN TRL.FILIAL IS NULL "
    cQuery += "                THEN "
    cQuery += "                    CASE "
    cQuery += "                        WHEN TRGCP.FILIAL IS NULL "
    cQuery += "                            THEN "
    cQuery += "                                CASE "
    cQuery += "                                    WHEN TRG.QUANT > 0 "
    cQuery += "                                        THEN TRG.CUSTO?/TRG.QUANT * TRG.QTDORI "
    cQuery += "                                    ELSE TRG.CUSTO? "
    cQuery += "                                END "
    cQuery += "                        ELSE "
    cQuery += "                            CASE "
    cQuery += "                                WHEN TRG.QUANT > 0 "
    cQuery += "                                    THEN TRGCP.CUSTO/TRG.QUANT * TRG.QTDORI "
    cQuery += "                                ELSE TRGCP.CUSTO "
    cQuery += "                            END "
    cQuery += "                    END "
    cQuery += "            ELSE "
    cQuery += "                CASE "
    cQuery += "                    WHEN TRLCP.FILIAL IS NULL "
    cQuery += "                        THEN "
    cQuery += "                            CASE "
    cQuery += "                                WHEN TRL.QUANT > 0 "
    cQuery += "                                    THEN TRL.CUSTO?/TRL.QUANT * TRG.QTDORI "
    cQuery += "                                ELSE TRL.CUSTO? "
    cQuery += "                            END "
    cQuery += "                    ELSE "
    cQuery += "                        CASE "
    cQuery += "                            WHEN TRL.QUANT > 0 "
    cQuery += "                                THEN TRLCP.CUSTO/TRL.QUANT * TRG.QTDORI "
    cQuery += "                            ELSE TRLCP.CUSTO "
    cQuery += "                        END "
    cQuery += "                END "
    cQuery += "        END "
    cQuery += "End "
    cQuery += "END CUSTO "
    cQuery += "FROM " + cTableAnl + " TRG "
    cQuery += "LEFT JOIN " + cTableAnlCP + " TRGCP "
    cQuery += "    ON  TRGCP.FILPROC = TRG.FILPROC "
    cQuery += "    AND TRGCP.FILIAL  = TRG.FILIAL "
    cQuery += "    AND TRGCP.RECPAI  = TRG.R_E_C_N_O_ "
    cQuery += "    AND TRGCP.MOEDA   = ? "
    cQuery += "LEFT JOIN " + cTableAgl + " TRL "
    cQuery += "    ON  TRL.FILPROC = TRG.FILPROC "
    cQuery += "    AND TRL.CHVAGL  = TRG.CHVAGL "
    cQuery += "LEFT JOIN " + cTableAglCP + " TRLCP "
    cQuery += "    ON  TRLCP.FILPROC = TRL.FILPROC "
    cQuery += "    AND TRLCP.FILIAL  = TRL.FILIAL "
    cQuery += "    AND TRLCP.RECPAI  = TRL.R_E_C_N_O_ "
    cQuery += "    AND TRLCP.MOEDA   = ? "
    cQuery += "    AND (TRLCP.CODPAR = TRGCP.CODPAR OR TRGCP.CODPAR IS NULL) "
    cQuery += "INNER JOIN " + cTablePro + " TRH "
    cQuery += "    ON  TRH.FILPROC = TRG.FILPROC "
    If ::cCusFil != "E"
        cQuery += "AND TRH.FILIAL  = TRG.FILIAL "
    EndIf
    cQuery += "    AND TRH.COD     = TRG.COD "
    If ::cCusFil == "A"
        cQuery += "AND TRH.ARMAZEM = TRG.LOCARM "
    EndIf
    cQuery += "LEFT JOIN " + cTableProCP + " TRHCP "
    cQuery += "    ON  TRHCP.FILPROC = TRH.FILPROC "
    If ::cCusFil != "E"
        cQuery += "AND TRHCP.FILIAL  = TRH.FILIAL "
    EndIf
    cQuery += "    AND TRHCP.COD     = TRH.COD "
    If ::cCusFil == "A"
        cQuery += "AND TRHCP.ARMAZEM = TRH.ARMAZEM "
    EndIf
    cQuery += "    AND TRHCP.CODPAR  = COALESCE(TRGCP.CODPAR, TRLCP.CODPAR) "
    cQuery += "    AND TRHCP.MOEDA   = ? "
    cQuery += "WHERE TRG.FILPROC = ? "
    cQuery += "    AND TRG.FILIAL = ? "

Return cQuery

/*/{Protheus.doc} getQueryAcquisitionCost
    Retorna query para busca dos valores do custo de aquisicao em partes
    @author Squad.Entradas
    @since 26/06/2025
    @version 1.0
    @return cQuery, character, query
    /*/
Method getQueryAcqCost() class UpdatePartsMovement
    Local cQuery as character

    cQuery := "SELECT "
    cQuery += "? TAB, "
    cQuery += "SD1.D1RECNO RECNO, "
    cQuery += "? TABCP, "
    cQuery += "SD1.D4G_CODPAR CODPAR, "
    cQuery += "? MOEDA, "
    cQuery += "SD1.D1_CUSTO? CUSTO "
    cQuery += "FROM " + ::cViewPartAcq + " SD1 "
    cQuery += " WHERE SD1.D1_FILIAL = ? "
    cQuery += " AND SD1.D1_DTDIGIT >= ? "
    cQuery += " AND SD1.D1_DTDIGIT <= ? "
    If  ::jVwAcqCstParams["SF4_EMPRESA"] != FWModeAccess("SD1", 1) .Or. ;
        ::jVwAcqCstParams["SF4_UNIDADE"] != FWModeAccess("SD1", 2) .Or. ;
        ::jVwAcqCstParams["SF4_FILIAL"]  != FWModeAccess("SD1", 3)
        cQuery += " AND SD1.F4_FILIAL = ? "
    EndIf
    cQuery += " AND (SD1.D4G_REVIS = ? OR SD1.D4G_REVIS IS NULL) "

Return cQuery

/*/{Protheus.doc} prepBulkInsert
    Prepara a query para ser executada
    e chama o metodo para inserir nas tabelas via bulk
    @author Squad.Entradas
    @since 18/06/2025
    @version 1.0
    @param  cQuery, character, query
            cMoeda, moeda em execucao
    @return cAliasTemp, character, alias aberto
    /*/
Method prepBulkInsert(cQuery, cMoeda, lAcqCost, cFilAtu) class UpdatePartsMovement
    Local cMoedaStr  as character
    Local cAliasTemp as character

    Default cFilAtu := ::cFilProc

    If !lAcqCost
        If ::oStatement == Nil
            ::oStatement := FwExecStatement():New(cQuery)
        EndIf
    Else
        If ::oStatementAcq == Nil
            ::oStatementAcq := FwExecStatement():New(cQuery)
        EndIf
    EndIf

    cMoedaStr := StrZero(Val(cMoeda), 2)

    If !lAcqCost
        ::oStatement:SetString(1, cMoedaStr)
        ::oStatement:SetUnsafe(2, cMoeda)
        ::oStatement:SetUnsafe(3, cMoeda)
        ::oStatement:SetUnsafe(4, cMoeda)
        ::oStatement:SetUnsafe(5, cMoeda)
        ::oStatement:SetUnsafe(6, cMoeda)
        ::oStatement:SetString(7, cMoedaStr)
        ::oStatement:SetString(8, cMoedaStr)
        ::oStatement:SetString(9, cMoedaStr)
        ::oStatement:SetString(10, ::cFilProc)
        ::oStatement:SetString(11, cFilAtu)

        cAliasTemp := ::oStatement:OpenAlias()
    Else
        ::oStatementAcq:SetString(1, "SD1")
        ::oStatementAcq:SetString(2, "D4L")
        ::oStatementAcq:SetString(3, cMoedaStr)
        ::oStatementAcq:SetUnsafe(4, cMoeda)
        ::oStatementAcq:SetString(5, FWXFilial("SD1", cFilAtu))
        ::oStatementAcq:SetString(6, ::cDtIni)
        ::oStatementAcq:SetString(7, ::cDtFim)
        If  ::jVwAcqCstParams["SF4_EMPRESA"] != FWModeAccess("SD1", 1) .Or. ;
            ::jVwAcqCstParams["SF4_UNIDADE"] != FWModeAccess("SD1", 2) .Or. ;
            ::jVwAcqCstParams["SF4_FILIAL"]  != FWModeAccess("SD1", 3)
            ::oStatementAcq:SetString(8, FWXFilial("SF4", cFilAtu))
            ::oStatementAcq:SetString(9, ::cRevisao)
        Else
            ::oStatementAcq:SetString(8, ::cRevisao)
        EndIf

        cAliasTemp := ::oStatementAcq:OpenAlias()
    EndIf

Return cAliasTemp

/*/{Protheus.doc} bulkPrepare
    Inicializa bulk
    @author Squad.Entradas
    @since 11/06/2025
    @version 1.0
    /*/
Method bulkPrepare() class UpdatePartsMovement

    If !::lClosing
    If ::oBulkD4L == Nil
        ::oBulkD4L := FWBulk():New(RetSQLName("D4L"), 500)

        ::lCanBulkD4L := ::oBulkD4L:CanBulk()

        If ::lCanBulkD4L
            ::aStructD4L := D4L->(DBStruct())
            ::oBulkD4L:SetFields(::aStructD4L)
        EndIf
    EndIf

    If ::oBulkD4M == Nil
        ::oBulkD4M := FWBulk():New(RetSQLName("D4M"), 500)

        ::lCanBulkD4M := ::oBulkD4M:CanBulk()

        If ::lCanBulkD4M
            ::aStructD4M := D4M->(DBStruct())
            ::oBulkD4M:SetFields(::aStructD4M)
        EndIf
    EndIf

    If ::oBulkD4N == Nil
        ::oBulkD4N := FWBulk():New(RetSQLName("D4N"), 500)

        ::lCanBulkD4N := ::oBulkD4N:CanBulk()

        If ::lCanBulkD4N
            ::aStructD4N := D4N->(DBStruct())
            ::oBulkD4N:SetFields(::aStructD4N)
        EndIf
    EndIf

    If ::oBulkD4J == Nil
        ::oBulkD4J := FWBulk():New(RetSQLName("D4J"), 500)

        ::lCanBulkD4J := ::oBulkD4J:CanBulk()

        If ::lCanBulkD4J
            ::aStructD4J := D4J->(DBStruct())
            ::oBulkD4J:SetFields(::aStructD4J)
        EndIf
    EndIf
    Else
        If ::oBulkD4I == Nil
            ::oBulkD4I := FWBulk():New(RetSQLName("D4I"), 500)

            ::lCanBulkD4I := ::oBulkD4I:CanBulk()

            If ::lCanBulkD4I
                ::aStructD4I := D4I->(DBStruct())
                ::oBulkD4I:SetFields(::aStructD4I)
            EndIf
        EndIf

        If ::oBulkD4O == Nil
            ::oBulkD4O := FWBulk():New(RetSQLName("D4O"), 500)

            ::lCanBulkD4O := ::oBulkD4O:CanBulk()

            If ::lCanBulkD4O
                ::aStructD4O := D4O->(DBStruct())
                ::oBulkD4O:SetFields(::aStructD4O)
            EndIf
        EndIf
    EndIf

Return

/*/{Protheus.doc} bulkInsert
    Atualiza custo nas tabelas de partes
    @author Squad.Entradas
    @since 11/06/2025
    @version 1.0
    @param cAliasTemp, character, alias que sera percorrido no bulk
    /*/
Method bulkInsert(cAliasTemp) class UpdatePartsMovement
    Local cAliasOri as character
    Local cAliasCP  as character
    Local aData     as array
    Local nX        as numeric

    While (cAliasTemp)->(!Eof())
        cAliasOri := AllTrim((cAliasTemp)->TAB)
        (cAliasOri)->(DbGoTo((cAliasTemp)->RECNO))
        If (cAliasOri)->(!Eof())
            cAliasCP := AllTrim((cAliasTemp)->TABCP)
            If cAliasCP == "D4L"
                If ::lCanBulkD4L
                    aData := {}
                    For nX := 1 To Len(::aStructD4L)
                        Do Case
                            Case ::aStructD4L[nX][1] == "D4L_FILIAL"
                                aAdd(aData, FWXFilial("D4L", SD1->D1_FILIAL))
                            Case ::aStructD4L[nX][1] == "D4L_DOC"
                                aAdd(aData, SD1->D1_DOC)
                            Case ::aStructD4L[nX][1] == "D4L_SERIE"
                                aAdd(aData, SD1->D1_SERIE)
                            Case ::aStructD4L[nX][1] == "D4L_FORNEC"
                                aAdd(aData, SD1->D1_FORNECE)
                            Case ::aStructD4L[nX][1] == "D4L_LOJA"
                                aAdd(aData, SD1->D1_LOJA)
                            Case ::aStructD4L[nX][1] == "D4L_ITEM"
                                aAdd(aData, SD1->D1_ITEM)
                            Case ::aStructD4L[nX][1] == "D4L_FORMUL"
                                aAdd(aData, SD1->D1_FORMUL)
                            Case ::aStructD4L[nX][1] == "D4L_ITEMGR"
                                aAdd(aData, SD1->D1_ITEMGRD)
                            Case ::aStructD4L[nX][1] == "D4L_REVISA"
                                aAdd(aData, ::cRevisao)
                            Case ::aStructD4L[nX][1] == "D4L_PARTE"
                                aAdd(aData, RTrim((cAliasTemp)->CODPAR))
                            Case ::aStructD4L[nX][1] == "D4L_MOEDA"
                                aAdd(aData, RTrim((cAliasTemp)->MOEDA))
                            Case ::aStructD4L[nX][1] == "D4L_TOTAL"
                                (cAliasTemp)->(TcSetField(cAliasTemp, "CUSTO", ::aStructD4L[nX][2], ::aStructD4L[nX][3], ::aStructD4L[nX][4]))
                                aAdd(aData, (cAliasTemp)->CUSTO)
                        EndCase
                    Next nX
                    lOk := ::oBulkD4L:AddData(aData)
                    If !lOk
                        UserException("Erro inclusão D4L: " + ::oBulkD4L:GetError())
                    EndIf
                EndIf
            ElseIf cAliasCP == "D4M"
                If ::lCanBulkD4M
                    aData := {}
                    For nX := 1 To Len(::aStructD4M)
                        Do Case
                            Case ::aStructD4M[nX][1] == "D4M_FILIAL"
                                aAdd(aData, FWXFilial("D4M", SD2->D2_FILIAL))
                            Case ::aStructD4M[nX][1] == "D4M_DOC"
                                aAdd(aData, SD2->D2_DOC)
                            Case ::aStructD4M[nX][1] == "D4M_SERIE"
                                aAdd(aData, SD2->D2_SERIE)
                            Case ::aStructD4M[nX][1] == "D4M_CLIENT"
                                aAdd(aData, SD2->D2_CLIENTE)
                            Case ::aStructD4M[nX][1] == "D4M_LOJA"
                                aAdd(aData, SD2->D2_LOJA)
                            Case ::aStructD4M[nX][1] == "D4M_ITEM"
                                aAdd(aData, SD2->D2_ITEM)
                            Case ::aStructD4M[nX][1] == "D4M_REVISA"
                                aAdd(aData, ::cRevisao)
                            Case ::aStructD4M[nX][1] == "D4M_PARTE"
                                aAdd(aData, RTrim((cAliasTemp)->CODPAR))
                            Case ::aStructD4M[nX][1] == "D4M_MOEDA"
                                aAdd(aData, RTrim((cAliasTemp)->MOEDA))
                            Case ::aStructD4M[nX][1] == "D4M_TOTAL"
                                (cAliasTemp)->(TcSetField(cAliasTemp, "CUSTO", ::aStructD4M[nX][2], ::aStructD4M[nX][3], ::aStructD4M[nX][4]))
                                aAdd(aData, (cAliasTemp)->CUSTO)
                        EndCase
                    Next nX
                    lOk := ::oBulkD4M:AddData(aData)
                    If !lOk
                        UserException("Erro inclusão D4M: " + ::oBulkD4M:GetError())
                    EndIf
                EndIf
            ElseIf cAliasCP == "D4N"
                If ::lCanBulkD4N
                    aData := {}
                    For nX := 1 To Len(::aStructD4N)
                        Do Case
                            Case ::aStructD4N[nX][1] == "D4N_FILIAL"
                                aAdd(aData, FWXFilial("D4N", SD3->D3_FILIAL))
                            Case ::aStructD4N[nX][1] == "D4N_IDSD3"
                                aAdd(aData, Upper(SD3->D3_MSUID))
                            Case ::aStructD4N[nX][1] == "D4N_REVISA"
                                aAdd(aData, ::cRevisao)
                            Case ::aStructD4N[nX][1] == "D4N_PARTE"
                                aAdd(aData, RTrim((cAliasTemp)->CODPAR))
                            Case ::aStructD4N[nX][1] == "D4N_MOEDA"
                                aAdd(aData, RTrim((cAliasTemp)->MOEDA))
                            Case ::aStructD4N[nX][1] == "D4N_TOTAL"
                                (cAliasTemp)->(TcSetField(cAliasTemp, "CUSTO", ::aStructD4N[nX][2], ::aStructD4N[nX][3], ::aStructD4N[nX][4]))
                                aAdd(aData, (cAliasTemp)->CUSTO)
                        EndCase
                    Next nX
                    lOk := ::oBulkD4N:AddData(aData)
                    If !lOk
                        UserException("Erro inclusão D4N: " + ::oBulkD4N:GetError())
                    EndIf
                EndIf
            EndIf
        EndIf
        (cAliasTemp)->(DbSkip())
    End

    (cAliasTemp)->(DbCloseArea())

Return

/*/{Protheus.doc} bulkClose
    Finaliza bulk
    @author Squad.Entradas
    @since 18/06/2025
    @version 1.0
    /*/
Method bulkClose() class UpdatePartsMovement

    If ::lCanBulkD4L
        If !::oBulkD4L:Close()
            UserException("Erro inclusão D4L: " + ::oBulkD4L:GetError())
        EndIf
        ::oBulkD4L:Destroy()
        FreeObj(::oBulkD4L)
        ::oBulkD4L := Nil

        aSize(::aStructD4L, 0)
        ::aStructD4L := Nil
    EndIf

    If ::lCanBulkD4M
        If !::oBulkD4M:Close()
            UserException("Erro inclusão D4M: " + ::oBulkD4M:GetError())
        EndIf
        ::oBulkD4M:Destroy()
        FreeObj(::oBulkD4M)
        ::oBulkD4M := Nil

        aSize(::aStructD4M, 0)
        ::aStructD4M := Nil
    EndIf

    If ::lCanBulkD4N
        If !::oBulkD4N:Close()
            UserException("Erro inclusão D4N: " + ::oBulkD4N:GetError())
        EndIf
        ::oBulkD4N:Destroy()
        FreeObj(::oBulkD4N)
        ::oBulkD4N := Nil

        aSize(::aStructD4N, 0)
        ::aStructD4N := Nil
    EndIf

    If ::lCanBulkD4J
        If !::oBulkD4J:Close()
            UserException("Erro inclusão D4J: " + ::oBulkD4J:GetError())
        EndIf
        ::oBulkD4J:Destroy()
        FreeObj(::oBulkD4J)
        ::oBulkD4J := Nil

        aSize(::aStructD4J, 0)
        ::aStructD4J := Nil
    EndIf

    If ::lCanBulkD4I
        If !::oBulkD4I:Close()
            UserException("Erro inclusão D4I: " + ::oBulkD4I:GetError())
        EndIf
        ::oBulkD4I:Destroy()
        FreeObj(::oBulkD4I)
        ::oBulkD4I := Nil

        aSize(::aStructD4I, 0)
        ::aStructD4I := Nil
    EndIf

    If ::lCanBulkD4O
        If !::oBulkD4O:Close()
            UserException("Erro inclusão D4O: " + ::oBulkD4O:GetError())
        EndIf
        ::oBulkD4O:Destroy()
        FreeObj(::oBulkD4O)
        ::oBulkD4O := Nil

        aSize(::aStructD4O, 0)
        ::aStructD4O := Nil
    EndIf

    If ::oStatement != Nil
    ::oStatement:Destroy()
    FreeObj(::oStatement)
    ::oStatement := Nil
    EndIf

    If ::oStatementAcq != Nil
    ::oStatementAcq:Destroy()
    FreeObj(::oStatementAcq)
    ::oStatementAcq := Nil
    EndIf

    If ::oStatementSldAtu != Nil
        ::oStatementSldAtu:Destroy()
        FreeObj(::oStatementSldAtu)
        ::oStatementSldAtu := Nil
    EndIf

    If ::oStatementSldOP != Nil
        ::oStatementSldOP:Destroy()
        FreeObj(::oStatementSldOP)
        ::oStatementSldOP := Nil
    EndIf

Return

/*/{Protheus.doc} deleteD4X
    Deleta os registros de custo em partes das movimentacoes do periodo e orfaos
    @author Squad.Entradas
    @since 23/06/2025
    @version 1.0
    /*/
Method deleteD4X() class UpdatePartsMovement
    Local oQueryD4L  as object
    Local oQryDelD4L as object
    Local oQueryD4M  as object
    Local oQryDelD4M as object
    Local oQueryD4N  as object
    Local oQryDelD4N as object
    Local oQueryD4J  as object
    Local oQryDelD4J as object
    Local cQueryD4L  as character
    Local cQryDelD4L as character
    Local cQueryD4M  as character
    Local cQryDelD4M as character
    Local cQueryD4N  as character
    Local cQryDelD4N as character
    Local cQueryD4J  as character
    Local cQryDelD4J as character
    Local cQuery     as character
    Local cMerge     as character
    Local cFilAtu    as character
    Local nFilial    as numeric
    Local nTamTesD1  as numeric
    Local nTamTesD2  as numeric
    Local aMatch     as array
    Local lDelete    as logical
    Local lOracle    as logical

    // Campo origem, campo destino
    aMatch := {}
    aAdd(aMatch, {"RECORI" , "R_E_C_N_O_"})
    nTamTesD1 := TamSX3("D1_TES")[1]
    nTamTesD2 := TamSX3("D2_TES")[1]
    lDelete   := .T.
    lOracle   := TCGetDB() $ "ORACLE"

    For nFilial := 1 To Len(::aFiliais)

        cFilAtu := ::aFiliais[nFilial]

        If oQueryD4L == Nil
            cQueryD4L := "SELECT D4L.R_E_C_N_O_ RECORI "
            cQueryD4L += "FROM " + RetSQLName("D4L") + " D4L "
            cQueryD4L += "LEFT JOIN " + RetSQLName("SD1") + " SD1 "
            cQueryD4L += "    ON  SD1.D1_FILIAL  = ? "
            cQueryD4L += "    AND SD1.D1_DOC     = D4L.D4L_DOC "
            cQueryD4L += "    AND SD1.D1_SERIE   = D4L.D4L_SERIE "
            cQueryD4L += "    AND SD1.D1_FORNECE = D4L.D4L_FORNEC "
            cQueryD4L += "    AND SD1.D1_LOJA    = D4L.D4L_LOJA "
            cQueryD4L += "    AND SD1.D1_ITEM    = D4L.D4L_ITEM "
            cQueryD4L += "    AND SD1.D1_FORMUL  = D4L.D4L_FORMUL "
            cQueryD4L += "    AND SD1.D1_ITEMGRD = D4L.D4L_ITEMGR "
            cQueryD4L += "    AND SD1.D1_TES    <> ? "
            cQueryD4L += "    AND SD1.D_E_L_E_T_ = ? "
            cQueryD4L += "WHERE  (SD1.D1_DTDIGIT BETWEEN ? AND ? OR SD1.D1_FILIAL IS NULL) "
            cQueryD4L += "    AND D4L.D4L_FILIAL = ? "
            cQueryD4L += "    AND D4L.D_E_L_E_T_ = ? "

            oQueryD4L := FWExecStatement():New(cQueryD4L)
        EndIf
        oQueryD4L:SetString(1, FWxFilial("SD1", cFilAtu))
        oQueryD4L:SetString(2, Space(nTamTesD1))
        oQueryD4L:SetString(3, " ")
        oQueryD4L:SetString(4, ::cDtIni)
        oQueryD4L:SetString(5, ::cDtFim)
        oQueryD4L:SetString(6, FWxFilial("D4L", cFilAtu))
        oQueryD4L:SetString(7, " ")

        cQuery := oQueryD4L:GetFixQuery()

        cMerge := ::MergeStatement(RetSQLName("D4L"), cQuery, aMatch, , , , lDelete)

        ::RunQuery(cMerge)

        If lOracle
            If oQryDelD4L == Nil
                cQryDelD4L := "DELETE FROM " + RetSQLName("D4L") + " WHERE D4L_FILIAL = ? AND D4L_D_E_L_E_T_ = ? "

                oQryDelD4L := FWExecStatement():New(cQryDelD4L)
            EndIf

            oQryDelD4L:SetString(1, FWxFilial("D4L", cFilAtu))
            oQryDelD4L:SetString(2, "*")

            cQuery := oQueryD4L:GetFixQuery()

            ::RunQuery(cQuery)

        EndIf

        If oQueryD4M == Nil
            cQueryD4M := "SELECT D4M.R_E_C_N_O_ RECORI "
            cQueryD4M += "FROM " + RetSQLName("D4M") + " D4M "
            cQueryD4M += "LEFT JOIN " + RetSQLName("SD2") + " SD2 "
            cQueryD4M += "	ON	SD2.D2_FILIAL  = ? "
            cQueryD4M += "	AND SD2.D2_DOC     = D4M.D4M_DOC "
            cQueryD4M += "	AND SD2.D2_SERIE   = D4M.D4M_SERIE "
            cQueryD4M += "	AND SD2.D2_CLIENTE = D4M.D4M_CLIENT "
            cQueryD4M += "	AND SD2.D2_LOJA    = D4M.D4M_LOJA "
            cQueryD4M += "	AND SD2.D2_ITEM    = D4M.D4M_ITEM "
            cQueryD4M += "	AND SD2.D2_TES    <> ? "
            cQueryD4M += "	AND SD2.D_E_L_E_T_ = ? "
            cQueryD4M += "WHERE  (SD2.D2_EMISSAO BETWEEN ? AND ? OR SD2.D2_FILIAL IS NULL) "
            cQueryD4M += "    AND D4M.D4M_FILIAL = ? "
            cQueryD4M += "    AND D4M.D_E_L_E_T_ = ? "

            oQueryD4M := FWExecStatement():New(cQueryD4M)
        EndIf
        oQueryD4M:SetString(1, FWxFilial("SD2", cFilAtu))
        oQueryD4M:SetString(2, Space(nTamTesD2))
        oQueryD4M:SetString(3, " ")
        oQueryD4M:SetString(4, ::cDtIni)
        oQueryD4M:SetString(5, ::cDtFim)
        oQueryD4M:SetString(6, FWxFilial("D4M", cFilAtu))
        oQueryD4M:SetString(7, " ")

        cQuery := oQueryD4M:GetFixQuery()

        cMerge := ::MergeStatement(RetSQLName("D4M"), cQuery, aMatch, , , , lDelete)

        ::RunQuery(cMerge)

        If lOracle
            If oQryDelD4M == Nil
                cQryDelD4M := "DELETE FROM " + RetSQLName("D4M") + " WHERE D4M_FILIAL = ? AND D4M_D_E_L_E_T_ = ? "

                oQryDelD4M := FWExecStatement():New(cQryDelD4M)
            EndIf

            oQryDelD4M:SetString(1, FWxFilial("D4M", cFilAtu))
            oQryDelD4M:SetString(2, "*")

            cQuery := oQueryD4M:GetFixQuery()

            ::RunQuery(cQuery)

        EndIf

        If oQueryD4N == Nil
            cQueryD4N := "SELECT D4N.R_E_C_N_O_ RECORI "
            cQueryD4N += "FROM " + RetSQLName("D4N") + " D4N "
            cQueryD4N += "LEFT JOIN " + RetSQLName("SD3") + " SD3 "
            cQueryD4N += "	ON	SD3.D3_FILIAL  = ? "
            cQueryD4N += "  AND SD3.D3_MSUID   = D4N.D4N_IDSD3 "
            cQueryD4N += "	AND SD3.D3_ESTORNO = ? "
            cQueryD4N += "	AND SD3.D_E_L_E_T_ = ? "
            cQueryD4N += "WHERE  (SD3.D3_EMISSAO BETWEEN ? AND ? OR SD3.D3_FILIAL IS NULL) "
            cQueryD4N += "    AND D4N.D4N_FILIAL = ? "
            cQueryD4N += "    AND D4N.D_E_L_E_T_ = ? "

            oQueryD4N := FWExecStatement():New(cQueryD4N)
        EndIf
        oQueryD4N:SetString(1, FWxFilial("SD3", cFilAtu))
        oQueryD4N:SetString(2, " ")
        oQueryD4N:SetString(3, " ")
        oQueryD4N:SetString(4, ::cDtIni)
        oQueryD4N:SetString(5, ::cDtFim)
        oQueryD4N:SetString(6, FWxFilial("D4N", cFilAtu))
        oQueryD4N:SetString(7, " ")

        cQuery := oQueryD4N:GetFixQuery()

        cMerge := ::MergeStatement(RetSQLName("D4N"), cQuery, aMatch, , , , lDelete)

        ::RunQuery(cMerge)

        If lOracle
            If oQryDelD4N == Nil
                cQryDelD4N := "DELETE FROM " + RetSQLName("D4N") + " WHERE D4N_FILIAL = ? AND D4N_D_E_L_E_T_ = ? "

                oQryDelD4N := FWExecStatement():New(cQryDelD4N)
            EndIf

            oQryDelD4N:SetString(1, FWxFilial("D4N", cFilAtu))
            oQryDelD4N:SetString(2, "*")

            cQuery := oQueryD4N:GetFixQuery()

            ::RunQuery(cQuery)

        EndIf

        If oQueryD4J == Nil
            cQueryD4J := " Delete From "+RetSQLName("D4J")
            cQueryD4J += " Where "
            cQueryD4J += " D4J_FILIAL = ? And "
            cQueryD4J += " D4J_REVISA = ? "

            oQueryD4J := FWExecStatement():New(cQueryD4J)
        EndIf

        oQueryD4J:SetString(1, FWxFilial("D4J", cFilAtu))
        oQueryD4J:SetString(2, ::cRevisao)

        cQuery := oQueryD4J:GetFixQuery()

        ::RunQuery(cQuery)

    
    Next nFilial

    aMatch := {}
    FWFreeArray(aMatch)

Return

/*/{Protheus.doc} getQueryD4J
    Retorna o alias com os registros que serão gravados na D4J
    @author Squad.Entradas
    @since 28/07/2025
    @version 1.0
/*/
Method getQueryD4J() Class UpdatePartsMovement
    local cQuery       as character
    local cTableTRM    as character
    local cTableTRMCP  as character

    cTableTRM   := BalanceByProductionOrder():TableName()
    cTableTRMCP := BalanceByProductionOrderParts():TableName()

    cQuery := " SELECT 'SC2' TAB, SC2.R_E_C_N_O_ RECNO, TRM.FILIAL, "
    cQuery += " SC2.C2_NUM NUM, SC2.C2_ITEM ITEM, "
    cQuery += " SC2.C2_SEQUEN SEQUEN, SC2.C2_ITEMGRD ITEMGRD, "
    cQuery += " TRMCP.OP, TRMCP.PARTE, TRMCP.MOEDA,"
    cQuery += " MAX(TRMCP.APRINI) APRINI, MAX(TRMCP.APRFIN) APRFIN, "
    cQuery += " MAX(TRMCP.TOTINI) TOTINI, MAX(TRMCP.TOTFIN) TOTFIN "
    cQuery += " FROM "+cTableTRM+" TRM "
    cQuery += " INNER JOIN "+cTableTRMCP+" TRMCP ON "
    cQuery += " TRMCP.FILPROC = TRM.FILPROC And "
    cQuery += " TRMCP.FILIAL  = TRM.FILIAL  And"
    cQuery += " TRMCP.MOEDA   = ? And "
    cQuery += " TRMCP.RECPAI  = TRM.R_E_C_N_O_ "
    cQuery += " INNER JOIN "+RetSqlName("SC2")+" SC2 ON "
    cQuery += " SC2.R_E_C_N_O_ = TRM.SC2RECNO "
    cQuery += " WHERE "
    cQuery += " TRM.FILPROC = ? And "
    cQuery += " TRM.FILIAL  = ? "
    cQuery += " GROUP BY SC2.R_E_C_N_O_, TRM.FILIAL, SC2.C2_NUM, SC2.C2_ITEM, SC2.C2_SEQUEN, "
    cQuery += " SC2.C2_ITEMGRD, TRMCP.OP, TRMCP.PARTE, TRMCP.MOEDA "

    cQuery := ChangeQuery(cQuery)    

Return cQuery

/*/{Protheus.doc} bulkInsertD4J
    Inclui os registros na tabela D4J através do bulk
    @author Squad.Entradas
    @since 28/07/2025
    @version 1.0
    /*/
Method bulkInsertD4J(cQuery, cMoeda, cFilAtu) Class UpdatePartsMovement
    local nX    as integer
    local aData as array
    local lOk   as logical
    local oStatementOP as object

    oStatementOP := FwExecStatement():New(cQuery)
    oStatementOP:SetString(1, StrZero(Val(cMoeda), 2))
    oStatementOP:SetString(2, ::cFilProc)
    oStatementOP:SetString(3, cFilAtu)

    cAliasTemp := oStatementOP:OpenAlias()
    
    If ::lCanBulkD4J
        Do While (cAliasTemp)->(!Eof())
            aData := {}
            For nX := 1 To Len(::aStructD4J)
                Do Case
                    Case ::aStructD4J[nX][1] == "D4J_FILIAL"
                        aAdd(aData, FWXFilial("D4J", (cAliasTemp)->FILIAL))
                    Case ::aStructD4J[nX][1] == "D4J_NUM"
                        aAdd(aData, (cAliasTemp)->NUM)
                    Case ::aStructD4J[nX][1] == "D4J_ITEM"
                        aAdd(aData, (cAliasTemp)->ITEM)
                    Case ::aStructD4J[nX][1] == "D4J_SEQUEN"
                        aAdd(aData, (cAliasTemp)->SEQUEN)
                    Case ::aStructD4J[nX][1] == "D4J_ITEMGR"
                        aAdd(aData, (cAliasTemp)->ITEMGRD)
                    Case ::aStructD4J[nX][1] == "D4J_REVISA"
                        aAdd(aData, ::cRevisao)
                    Case ::aStructD4J[nX][1] == "D4J_PARTE"
                        aAdd(aData, (cAliasTemp)->PARTE)
                    Case ::aStructD4J[nX][1] == "D4J_MOEDA"
                        aAdd(aData, (cAliasTemp)->MOEDA)
                    Case ::aStructD4J[nX][1] == "D4J_OP"
                        aAdd(aData, (cAliasTemp)->OP)
                    Case ::aStructD4J[nX][1] == "D4J_APRINI"
                        (cAliasTemp)->(TcSetField(cAliasTemp, "APRINI", ::aStructD4J[nX][2], ::aStructD4J[nX][3], ::aStructD4J[nX][4]))
                        aAdd(aData, (cAliasTemp)->APRINI)
                    Case ::aStructD4J[nX][1] == "D4J_APRFIN"
                        (cAliasTemp)->(TcSetField(cAliasTemp, "APRFIN", ::aStructD4J[nX][2], ::aStructD4J[nX][3], ::aStructD4J[nX][4]))
                        aAdd(aData, (cAliasTemp)->APRFIN)
                    Case ::aStructD4J[nX][1] == "D4J_TOTINI"
                        (cAliasTemp)->(TcSetField(cAliasTemp, "TOTINI", ::aStructD4J[nX][2], ::aStructD4J[nX][3], ::aStructD4J[nX][4]))
                        aAdd(aData, (cAliasTemp)->TOTINI)
                    Case ::aStructD4J[nX][1] == "D4J_TOTFIN"
                        (cAliasTemp)->(TcSetField(cAliasTemp, "TOTFIN", ::aStructD4J[nX][2], ::aStructD4J[nX][3], ::aStructD4J[nX][4]))
                        aAdd(aData, (cAliasTemp)->TOTFIN)
                EndCase
            Next nX
            
            lOk := ::oBulkD4J:AddData(aData)
            If !lOk
                UserException("Erro inclusão D4J: " + ::oBulkD4J:GetError())
            EndIf

            (cAliasTemp)->(DbSkip())
        EndDo
    EndIf

    (cAliasTemp)->(DbCloseArea())

Return

/*/{Protheus.doc} getAliasSldAtu
    Retorna alias com valores do custo em partes
    da tabela de saldo atual
    @author Squad.Entradas
    @since 25/08/2025
    @version 1.0
    @return cQuery, character, query
    /*/
Method getAliasSldAtu() class UpdatePartsMovement
    Local cDecCM     as character
    Local cTabSaldo  as character
    Local cTabProcCP as character
    Local cQuery     as character
    Local cAliasTemp as character
    Local lRound     as logical

    If ::oStatementSldAtu == Nil
        cDecCM     := cValToChar(TamSX3("D4K_UNITAR")[2])
        lRound     := SuperGetMV("MV_CMROUND", .F., .F.)
        cTabSaldo  := BalanceByWarehouse():TableName()
        cTabProcCP := PartsProcessingTable():TableName()

        cQuery := "SELECT  TRK.FILIAL FILIAL, "
        cQuery += "        TRK.COD COD, " 
        cQuery += "        TRK.ARMAZEM ARMAZEM, "
        cQuery += "        TRHCP.CODPAR PARTE, "
        cQuery += "        TRHCP.MOEDA MOEDA, "
        cQuery += ::FormatRound(lRound, 'TRHCP.CMPROC', ::nDecCM)+" UNITAR, "
        cQuery += ::FormatRound(lRound, 'TRHCP.CMPROC', ::nDecCM)+" * TRK.QUANT TOTAL "  
        cQuery += "FROM " + cTabSaldo + " TRK "
        cQuery += "INNER JOIN " + cTabProcCP + " TRHCP "
        cQuery += "    ON  TRHCP.FILPROC = TRK.FILPROC "
        If ::cCusfil != "E"
            cQuery += "AND TRHCP.FILIAL  = TRK.FILIAL "
        EndIf
        cQuery += "    AND TRHCP.COD     = TRK.COD "
        If ::cCusfil == "A"
            cQuery += "AND TRHCP.ARMAZEM = TRK.ARMAZEM "
        EndIf
        cQuery += "WHERE TRK.FILIAL = ? "

        ::oStatementSldAtu := FwExecStatement():New(cQuery)
    EndIf

    ::oStatementSldAtu:SetString(1, ::cFilProc)

    cAliasTemp := ::oStatementSldAtu:OpenAlias()

Return cAliasTemp

/*/{Protheus.doc} bulkInsertD4I
    Insere os registros na tabela D4I via bulk
    @author Squad.Entradas
    @since 25/08/2025
    @version 1.0
    /*/
Method bulkInsertD4I(cAliasTemp) Class UpdatePartsMovement
    local aData as array
    local nX    as integer
    local lOk   as logical

    If ::lCanBulkD4I
        While (cAliasTemp)->(!Eof())
            aData := {}
            For nX := 1 To Len(::aStructD4I)
                Do Case
                    Case ::aStructD4I[nX][1] == "D4I_FILIAL"
                        aAdd(aData, FWXFilial("D4I", (cAliasTemp)->FILIAL))
                    Case ::aStructD4I[nX][1] == "D4I_COD"
                        aAdd(aData, (cAliasTemp)->COD)
                    Case ::aStructD4I[nX][1] == "D4I_LOCAL"
                        aAdd(aData, (cAliasTemp)->ARMAZEM)
                    Case ::aStructD4I[nX][1] == "D4I_DATA"
                        aAdd(aData, ::cDataFec)
                    Case ::aStructD4I[nX][1] == "D4I_REVISA"
                        aAdd(aData, ::cRevisao)
                    Case ::aStructD4I[nX][1] == "D4I_PARTE"
                        aAdd(aData, (cAliasTemp)->PARTE)
                    Case ::aStructD4I[nX][1] == "D4I_MOEDA"
                        aAdd(aData, (cAliasTemp)->MOEDA)
                    Case ::aStructD4I[nX][1] == "D4I_UNITAR"
                        (cAliasTemp)->(TcSetField(cAliasTemp, "UNITAR", ::aStructD4I[nX][2], ::aStructD4I[nX][3], ::aStructD4I[nX][4]))
                        aAdd(aData, (cAliasTemp)->UNITAR)
                    Case ::aStructD4I[nX][1] == "D4I_TOTAL"
                        (cAliasTemp)->(TcSetField(cAliasTemp, "TOTAL", ::aStructD4I[nX][2], ::aStructD4I[nX][3], ::aStructD4I[nX][4]))
                        aAdd(aData, (cAliasTemp)->TOTAL)
                    Case ::aStructD4I[nX][1] == "D4I_MANUAL"
                        aAdd(aData, "N")
                EndCase
            Next nX

            lOk := ::oBulkD4I:AddData(aData)
            If !lOk
                UserException("Erro inclusão D4I: " + ::oBulkD4I:GetError())
            EndIf

            (cAliasTemp)->(DbSkip())
        End
    EndIf

    (cAliasTemp)->(DbCloseArea())

Return

/*/{Protheus.doc} getAliasSldOP
    Retorna alias com valores do custo em partes
    da tabela de saldos por OP
    @author Squad.Entradas
    @since 25/08/2025
    @version 1.0
    @return cQuery, character, query
    /*/
Method getAliasSldOP() class UpdatePartsMovement
    Local cQuery     as character
    Local cTabTRM  as character
    Local cTabTRMCP  as character
    Local cAliasTemp as character

    If ::oStatementSldOP == Nil
        cTabTRM   := BalanceByProductionOrder():TableName()
        cTabTRMCP := BalanceByProductionOrderParts():TableName()

        cQuery := "SELECT TRM.FILIAL FILIAL, "
        cQuery += "       SC2.C2_NUM NUM, "
        cQuery += "       SC2.C2_ITEM ITEM, "
        cQuery += "       SC2.C2_SEQUEN SEQUEN, "
        cQuery += "       SC2.C2_ITEMGRD ITEMGR, "
        cQuery += "       TRM.OP OP, "
        cQuery += "       TRMCP.PARTE PARTE, "
        cQuery += "       TRMCP.MOEDA MOEDA, "
        cQuery += "       MAX(TRMCP.TOTFIN) TOTFIN, "
        cQuery += "       MAX(TRMCP.APRFIN) APRFIN "
        cQuery += "FROM " + cTabTRM + " TRM "
        cQuery += "INNER JOIN " + cTabTRMCP + " TRMCP "
        cQuery += "    ON  TRMCP.FILPROC  = TRM.FILPROC "
        cQuery += "    AND TRMCP.FILIAL   = TRM.FILIAL "
        cQuery += "    AND TRMCP.RECPAI   = TRM.R_E_C_N_O_ "
        cQuery += "INNER JOIN " + RetSQLName("SC2") + " SC2 "
        cQuery += "    ON  SC2.C2_FILIAL  = ? "
        cQuery += "    AND SC2.R_E_C_N_O_ = TRM.SC2RECNO "
        cQuery += "    AND SC2.D_E_L_E_T_ = ? "
        cQuery += "WHERE TRM.FILIAL = ? "
        cQuery += "GROUP BY TRM.FILIAL, SC2.C2_NUM, SC2.C2_ITEM, SC2.C2_SEQUEN, SC2.C2_ITEMGRD, TRM.OP, TRMCP.PARTE, TRMCP.MOEDA "

        ::oStatementSldOP := FwExecStatement():New(cQuery)
    EndIf

    ::oStatementSldOP:SetString(1, FWxFilial("SC2", ::cFilProc))
    ::oStatementSldOP:SetString(2, " ")
    ::oStatementSldOP:SetString(3, ::cFilProc)

    cAliasTemp := ::oStatementSldOP:OpenAlias()

Return cAliasTemp

/*/{Protheus.doc} bulkInsertD4O
    Insere os registros na tabela D4O via bulk
    @author Squad.Entradas
    @since 25/08/2025
    @version 1.0
    /*/
Method bulkInsertD4O(cAliasTemp) Class UpdatePartsMovement
    local aData as array
    local nX    as integer
    local lOk   as logical

    If ::lCanBulkD4O
        While (cAliasTemp)->(!Eof())
            aData := {}
            For nX := 1 To Len(::aStructD4O)
                Do Case
                    Case ::aStructD4O[nX][1] == "D4O_FILIAL"
                        aAdd(aData, FWXFilial("D4O", (cAliasTemp)->FILIAL))
                    Case ::aStructD4O[nX][1] == "D4O_NUM"
                        aAdd(aData, (cAliasTemp)->NUM)
                    Case ::aStructD4O[nX][1] == "D4O_ITEM"
                        aAdd(aData, (cAliasTemp)->ITEM)
                    Case ::aStructD4O[nX][1] == "D4O_SEQUEN"
                        aAdd(aData, (cAliasTemp)->SEQUEN)
                    Case ::aStructD4O[nX][1] == "D4O_ITEMGR"
                        aAdd(aData, (cAliasTemp)->ITEMGR)
                    Case ::aStructD4O[nX][1] == "D4O_OP"
                        aAdd(aData, (cAliasTemp)->OP)
                    Case ::aStructD4O[nX][1] == "D4O_DATA"
                        aAdd(aData, ::cDataFec)
                    Case ::aStructD4O[nX][1] == "D4O_REVISA"
                        aAdd(aData, ::cRevisao)
                    Case ::aStructD4O[nX][1] == "D4O_PARTE"
                        aAdd(aData, (cAliasTemp)->PARTE)
                    Case ::aStructD4O[nX][1] == "D4O_MOEDA"
                        aAdd(aData, (cAliasTemp)->MOEDA)
                    Case ::aStructD4O[nX][1] == "D4O_SLDINI"
                        (cAliasTemp)->(TcSetField(cAliasTemp, "TOTFIN", ::aStructD4O[nX][2], ::aStructD4O[nX][3], ::aStructD4O[nX][4]))
                        aAdd(aData, (cAliasTemp)->TOTFIN)
                    Case ::aStructD4O[nX][1] == "D4O_APRINI"
                        (cAliasTemp)->(TcSetField(cAliasTemp, "APRFIN", ::aStructD4O[nX][2], ::aStructD4O[nX][3], ::aStructD4O[nX][4]))
                        aAdd(aData, (cAliasTemp)->APRFIN)
                    Case ::aStructD4O[nX][1] == "D4O_MANUAL"
                        aAdd(aData, "N")
                EndCase
            Next nX

            lOk := ::oBulkD4O:AddData(aData)
            If !lOk
                UserException("Erro inclusão D4O: " + ::oBulkD4O:GetError())
            EndIf

            (cAliasTemp)->(DbSkip())
        End
    EndIf

    (cAliasTemp)->(DbCloseArea())

Return
