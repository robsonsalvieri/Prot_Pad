/*/{Protheus.doc} Grid
Função de testes do protótipo da classe
@type user function
@author user
@since 11/03/2025
/*/
/*
User Function Grid()
    Local oThrManager
    Local lRet  := .F.
    Local nI  := 0

    RPCSetEnv('T1','D MG 01 ',,,'EST')

    oThrManager := ThreadManager():New(2, "IDTESTE")

    lRet := oThrManager:Prepare()

    If lRet
        For nI := 1 To 200
            lRet := oThrManager:Execute("totvs.protheus.backoffice.stock.iterativecost.processing.threads.TESTEEXEC", {"TESTE PARAMETRO", nI})
        Next
        While !oThrManager:CheckIfDone()
            Conout("[GRID] AINDA ESTA EM EXECUCAO")
            Sleep(100)
        End
    EndIf

    oThrManager:Terminate()

Return 
*/

