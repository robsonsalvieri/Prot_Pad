#Include 'Totvs.ch'
#include 'tlpp-core.th'

//Manter o namespace do fonte atual nos defines
#Define PREPFUNC "totvs.protheus.backoffice.stock.iterativecost.processing.threads.PREPARE"
#Define EXECFUNC "totvs.protheus.backoffice.stock.iterativecost.processing.threads.EXECUTE"

namespace totvs.protheus.backoffice.stock.iterativecost.processing.threads
Using namespace totvs.protheus.backoffice.stock.iterativecost.table.manager

/*/{Protheus.doc} ThreadManager
    Classe responsável por gerenciar as threads de um processo
    encapsula os métodos GridServer e ManualJob
    @Type Class
    @author Squad Entradas
    @since 28/02/2025
    @version version
    /*/
Class ThreadManager From TableManager
    
    Public Method New()
    Public Method Prepare()
    Public Method Execute()
    Public Method GetError()
    Public Method Terminate()
    Static method TableFields()
    Static method TableIndexes()
    Static method TableName()
    Public Method CheckIfDone()
    Public Method CheckForErrors()
    Public Method IsThreadRunning()
    Public Method CleanUp()

    Public Method GetTableName()
    Public Method GetIdJob()

    Public Data lIsGrid As Logical
    Public Data lIsManualJob As Logical
    Public Data lIsBoth  As Logical
    Public Data cIdJob   As Character
    Public Data cPrepare As Character
    Public Data cExecute As Character
    Public Data cPrepPar As Character
    Public Data cFunPrep As Character
    Public Data nThreadPai As Numeric
    Public Data nSeqThr As Numeric
    Public Data cTmpTableName As Character
    Public Data oTmpTable As Object
    Public Data cTmpAlias As character
    Public Data oQryDone As Object
    Public Data oQryError As Object
    Public Data oQryRun As Object
    Public Data cError As Character
    Public Data cErrorStack As Character
    Public Data cErrorEnv As Character

    Public Data oGrid As Object
    Public Data nTotThread As Numeric
    Public Data nMinThread As Numeric
    Public Data nMaxThread As Numeric
    Public Data nFreeThread As Numeric
    Public Data nIncThread As Numeric
    Public Data cIdJobManual As Character
    Public Data cUUID As Character
    Public Data cIdExec As Character
EndClass

/*/{Protheus.doc} New
    Instância da classe
    @author user
    @since 28/02/2025
    /*/
Method New(nType As Numeric, cIdJob As Character, cIDExec As Character, cFunPrep) Class ThreadManager
    _Super:New({}, 'C', 'C', 'C')

    ::cIdJob     := cIdJob
    ::lIsGrid    := .F.
    ::lIsManualJob := .F.
    ::lIsBoth    := .F.
    ::cPrepare   := PREPFUNC
    ::cExecute   := EXECFUNC
    ::nThreadPai := ThreadID()
    ::nSeqThr    := 0
    ::nTotThread := SuperGetMV("MV_M330THR",.F.,1)
    ::cIdJobManual := ::cIdJob+Str(::nThreadPai, 15)
    ::cFunPrep   := cFunPrep
    ::lCustomDelete := .T.
    ::cUUID      := FWUUIDV4(.T.)
    ::cIdExec    := cIDExec

    If nType == 1 //Grid
        ::lIsGrid := .T.
    ElseIf nType == 2 //ManualJob
        ::lIsManualJob := .T.
    ElseIf nType == 3 //Manualjob dentro do Grid
        ::lIsBoth := .T.
        ::lIsGrid := .T. //passa pelo fluxo do Grid
    EndIf

    If nType == 2 .Or. nType == 3
        If ::nTotThread > 10
		    ::nTotThread := 10
		ElseIf ::nTotThread == 9
			::nTotThread := 10
		Else
			::nTotThread := ::nTotThread+2
		EndIf
    EndIf

    ::TableManager(::TableName(),::TableFields(),::TableIndexes())
    ::cTmpTableName := ::TableName()
    ::cTmpAlias     := ::TableName()
    ::UseArea(::cTmpTableName, ::TableIndexes())

    //Parâmetros de abertura do ambiente
    ::cPrepPar := cEmpAnt+Chr(255)
    ::cPrepPar += cFilAnt+Chr(255)
    ::cPrepPar += ::cTmpTableName+Chr(255)
    ::cPrepPar += ::cIdExec+Chr(255)
    ::cPrepPar += ::cUUID+Chr(255)
    ::cPrepPar += cValToChar(nType)
    If !Empty(::cFunPrep)
        ::cPrepPar += Chr(255)+::cFunPrep
    EndIf
    
    If ::lIsGrid
        ::oGrid := GridClient():New()
    ElseIf ::lIsManualJob
        ::nMinThread := Val(GetSrvProfString( "ThreadMinOrdem", cValToChar(::nTotThread) ))
		::nMaxThread := Val(GetSrvProfString( "ThreadMaxOrdem", "30" ))
		::nFreeThread := 2
		::nIncThread := 2

        ManualJob(::cIdJobManual/*Nome do indentificador do job*/,;
				GetEnvServer()/*Ambiente que vc vai abrir este cara*/,;
				"IPC"/*Tipo do job. Mantenha como Ipc*/,;
				::cPrepare/*Função que será chamada quando uma nova thread subir*/,;
				::cExecute/*Função que será chamada toda vez que vc mandar um ipcgo para ela*/,;
				"AlwaysTrue"/*Função que será invocada quando a thread cair pelo timeout dela*/,;
				::cPrepPar/*Não alterar. É o SessionKey*/,;
				300 /*Tempo em segundos que a thread será reavaliada e irá cair. Vamos manter 5 minutos. Se não receber nada ela morre*/,;
				::nMinThread /*Minimo de threads inicias. Vamos deixar 0 para que quando cair por timeout ele acabe*/,;
				::nMaxThread /*máximo de threads que ele vai subir*/,;
				::nFreeThread /*mínimo de threads livres*/,;
				::nIncThread /*incremento de threads livres*/,;
      		)
    EndIf

Return Self

/*/{Protheus.doc} TableFields
    Campos da table
    @author Squad Entradas
    @since 28/02/2025
    /*/
Method TableFields() Class ThreadManager
    Local aFields   := {} as array

    aAdd(aFields, {"FILPROC",   "C" , TamSX3('D3_FILIAL')[1],  0})
    aAdd(aFields, {"FILIAL",    "C" , TamSX3('D3_FILIAL')[1],  0})
    AAdd(aFields, {"IDEXEC",    "C" , 36, 0})
    AAdd(aFields, {"THRUUID",   "C" , 36, 0})
    AAdd(aFields, {"IDJOB",     "C" , 15, 0})
    AAdd(aFields, {"THRPAI",    "N" , 15, 0})
    AAdd(aFields, {"PARAMETROS","M" , 10, 0})
    AAdd(aFields, {"SEQTHR",    "N" , 15, 0})
    AAdd(aFields, {"THRFIL",    "N" , 15, 0})
    AAdd(aFields, {"STATUSTHR", "C" , 2,  0})
    AAdd(aFields, {"ERROTHR",   "M",  10, 0})
    AAdd(aFields, {"ERROSTACK",   "M",  10, 0})
    AAdd(aFields, {"ERROENV",   "M",  10, 0})

Return aFields

/*/{Protheus.doc} TableIndexes
    Indices da table
    @author Squad Entradas
    @since 28/02/2025
    /*/
Method TableIndexes() Class ThreadManager
    Local aIndex := {} as array
    Local cTable := ThreadManager():TableName()

    aAdd(aIndex, {cTable+'_01', 'THRUUID+IDJOB+THRPAI+SEQTHR'})
    aAdd(aIndex, {cTable+'_02', 'THRUUID+IDJOB+THRPAI+STATUSTHR'})
    aAdd(aIndex, {cTable+'_03', 'IDEXEC'})

Return aIndex

/*/{Protheus.doc} TableName
    Retorna o nome da tabela
    @author Squad Entradas
    @since 27/08/2024
/*/
Method TableName() Class ThreadManager
    Local cAlias as character

    cAlias := "THJM"+cEmpAnt+"SP"

Return cAlias

/*/{Protheus.doc} CheckIfDone
    Verifica se todos os processos criados foram finalizados
    @author Squad Entradas
    @since 13/03/2025
    /*/
Method CheckIfDone() Class ThreadManager
    Local lDone   := .F.
    Local cQuery := ""

    If ::oQryDone == Nil
        cQuery := " Select Count(1) CNT From "+::cTmpTableName
        cQuery += " Where "
        cQuery += " IDJOB = ? And "
        cQuery += " THRPAI = ? And "
        cQuery += " STATUSTHR In (?, ?) " //00, 01
        cQuery := ChangeQuery(cQuery)

        ::oQryDone := FWExecStatement():New(cQuery)
    EndIf

    ::oQryDone:SetString(1, ::cIdJob)
    ::oQryDone:SetNumeric(2, ::nThreadPai)
    ::oQryDone:SetString(3, '00')
    ::oQryDone:SetString(4, '01')

    lDone := ::oQryDone:ExecScalar("CNT") <= 0    
Return lDone


/*/{Protheus.doc} IsThreadRunning
    Verifica se uma thread está em execução
    @author Squad Entradas
    @since 13/03/2025
    /*/
Method IsThreadRunning(nThreadFilha) Class ThreadManager
    Local lIsRunning  := .F.
    Local cQuery := ""

    If ::oQryRun == Nil
        cQuery := " Select '1' THREAD From "+::cTmpTableName
        cQuery += " Where "
        cQuery += " THRUUID = ? And "
        cQuery += " IDJOB = ? And "
        cQuery += " THRPAI = ? And "
        cQuery += " THRFIL = ? And "
        cQuery += " STATUSTHR In (?, ?) " //00, 01
        cQuery := ChangeQuery(cQuery)

        ::oQryRun := FWExecStatement():New(cQuery)
    EndIf

    ::oQryRun:SetString(1, ::cUUID)
    ::oQryRun:SetString(2, ::cIdJob)
    ::oQryRun:SetNumeric(3, ::nThreadPai)
    ::oQryRun:SetNumeric(4, nThreadFilha)
    ::oQryRun:SetString(5, '00')
    ::oQryRun:SetString(6, '01')

    lIsRunning := ::oQryRun:ExecScalar("THREAD") == '1'  
Return lIsRunning

/*/{Protheus.doc} CheckForErrors
    Verifica se ocorreu erro em algum processo
    @author Squad Entradas
    @since 13/03/2025
    /*/
Method CheckForErrors() Class ThreadManager
    Local cQuery  := ""
    Local nRec    := 0

    If ::oQryError == Nil
        cQuery := " Select R_E_C_N_O_ REC From "+::cTmpTableName
        cQuery += " Where "
        cQuery += " THRUUID   = ? And "
        cQuery += " IDJOB = ? And "
        cQuery += " THRPAI = ? And "
        cQuery += " STATUSTHR = ? " 
        cQuery := ChangeQuery(cQuery)

        ::oQryError := FWExecStatement():New(cQuery)
    EndIf

    ::oQryError:SetString(1, ::cUUID)
    ::oQryError:SetString(2, ::cIdJob)
    ::oQryError:SetNumeric(3, ::nThreadPai)
    ::oQryError:SetString(4, '03')

    nRec := ::oQryError:ExecScalar("REC")
    If nRec > 0
        (::cTmpAlias)->(DbGoTo(nRec))
        ::cError := (::cTmpAlias)->ERROTHR
        ::cErrorStack := (::cTmpAlias)->ERROSTACK
        ::cErrorEnv := (::cTmpAlias)->ERROENV
    EndIf
Return ::cError

/*/{Protheus.doc} Prepare
    Prepara o ambiente das threads. O método de execução deve ser chamado
    antes do timeout, ou a thread será derrubada.
    @author Squad Entradas
    @since 11/03/2025
    /*/
Method Prepare() Class ThreadManager 
    Local lRet    := .T.
    Local cError  := ""
    Local cError2 := ""

    If ::lIsGrid
        lRet := ::oGrid:Prepare(::cPrepare, {::cPrepPar}, ::cExecute)
    ElseIf ::lIsManualJob
        lRet := .T. //A manualjob faz a preparação do ambiente no momento da sua chamada
    EndIf
    If !lRet
        cError := ::GetError()
        lRet := ::Terminate(@cError2)
        If lRet
            UserException("Erro ao preparar threads: "+cError)
        Else
            cError := "Erro ao finalizar threads: "+cError2+" Erro anterior ao preparar threads: "+cError
            UserException(cError)
        EndIf
    EndIf
Return lRet

/*/{Protheus.doc} Execute
    Executa a função na thread filha
    @author Squad Entradas
    @since 11/03/2025
    /*/
Method Execute(cFunExec As Character, aParams As Array) Class ThreadManager
    Local lRet    := .T.
    Local jJson  := JsonObject():New()
    Local nSeq   := 0
    Local nTries := 0
    Local nI     := 0
    Local cError := ""

    jJson["PARAMS"] := {cFunExec, aParams}
    nSeq := ::nSeqThr

    If Select(::cTmpAlias) > 0
        RecLock(::cTmpAlias, .T.)
        (::cTmpAlias)->IDEXEC  := ::cIdExec
        (::cTmpAlias)->THRUUID := ::cUUID
        (::cTmpAlias)->IDJOB  := ::cIdJob
        (::cTmpAlias)->THRPAI := ::nThreadPai
        (::cTmpAlias)->SEQTHR := nSeq
        (::cTmpAlias)->PARAMETROS := jJson:ToJson()
        (::cTmpAlias)->STATUSTHR := "00" //Thread solicitada
        (::cTmpAlias)->(MsUnLock())

        ::nSeqThr++
    Else
        lRet := .F.
    EndIf

    If ::lIsGrid
        lRet := ::oGrid:Execute({::cTmpTableName, ::cUUID, ::cIdJob, ::nThreadPai, nSeq})
        If !lRet
            cError := ""
            If !Empty(::oGrid:aErrorProc)          
                // Houve um ou mais erros fatais que abortaram o processo          
                // [1] : Número sequencial da instrução enviada que não foi processada          
                // [2] : Parâmetro enviado para processamento          
                // [3] : Identificação do Agente onde ocorreu o erro          
                // [4] : Detalhes da ocorrência de erro
                For nI := 1 To Len(::oGrid:aErrorProc)
                    cError += "Houve um ou mais erros fatais que abortaram o processo"+CRLF
                    cError += AsString(::oGrid:aErrorProc[nI, 2])+CRLF
                    cError += ::oGrid:aErrorProc[nI, 4]+CRLF
                Next nI    
            Endif   
            If !Empty(::oGrid:aErrorProc)          
                // retorna lista de chamadas que foram enviadas e não foram executadas          
                // [1] Número sequencial da instrução          
                // [2] Parâmetro de envio          
                // [3] Identificação do Agente que recebeu a requisição  
                For nI := 1 To Len(::oGrid:aSendProc)
                    cError += "Houve uma ou mais chamadas não executadas: "+CRLF
                    cError += AsString(::oGrid:aErrorProc[nI, 2])+CRLF
                    cError += ::oGrid:aErrorProc[nI, 3]+CRLF
                Next nI
                cError += ::GetError()  
            Endif
            ::Terminate()
            UserException(cError)
        EndIf
    ElseIf ::lIsManualJob
        nTries := 0
        While !(lRet := IPCGo(::cIdJobManual, {::cTmpTableName, ::cUUID, ::cIdJob, ::nThreadPai, nSeq}))
            Sleep(2000)
        EndDo
    EndIf

    nTries := 0
    (::cTmpAlias)->(DbSetOrder(1)) //THRUUID+IDJOB+THRPAI+SEQTHR
    While .T.
        If (::cTmpAlias)->(DbSeek(PadR(::cUUID,36)+PadR(::cIdJob,15)+Str(::nThreadPai,15)+Str(nSeq,15)))
            If (::cTmpAlias)->STATUSTHR != "00"
                Exit //Subiu a thread com sucesso
            EndIf
        EndIf
        Sleep(100)
        nTries++
        If nTries > 1000
            ::Terminate()
            UserException("Não foi possível realizar a subida das threads de processamento.")
        EndIf
    End
Return lRet


/*/{Protheus.doc} Terminate
    Finaliza o controle de multithreads
    @author Squad Entradas
    @since 12/03/2025
    /*/
Method Terminate(cError) Class ThreadManager
    Local aUsers := {}
    Local nI     := 0
    Local nThrFilha := 0
    Local lRet   := .T.
    
    If ::lIsGrid
        If ::oGrid:Terminate()
	        While .T.
	            If ::CheckIfDone()
	                Exit
	            EndIf
	            Sleep(500)
	        EndDo
	    Else
	    	lRet   := .F.
	    	cError := ::oGrid:GetError()
	    EndIf
	    ::oGrid := Nil
    ElseIf ::lIsManualJob
        ManualJob(::cIdJobManual/*Nome do indentificador do job*/,;
				GetEnvServer()/*Ambiente que vc vai abrir este cara*/,;
				"IPC"/*Tipo do job. Mantenha como Ipc*/,;
				::cPrepare/*Função que será chamada quando uma nova thread subir*/,;
				::cExecute/*Função que será chamada toda vez que vc mandar um ipcgo para ela*/,;
				"AlwaysTrue"/*Função que será invocada quando a thread cair pelo timeout dela*/,;
				::cPrepPar/*Não alterar. É o SessionKey*/,;
				300 /*Tempo em segundos que a thread será reavaliada e irá cair. Vamos manter 5 minutos. Se não receber nada ela morre*/,;
				0 /*Minimo de threads inicias. Vamos deixar 0 para que quando cair por timeout ele acabe*/,;
				0 /*máximo de threads que ele vai subir*/,;
				0 /*mínimo de threads livres*/,;
				0 /*incremento de threads livres*/,;
      		)

        While .T.
            aUsers := GetUserInfoArray()
            
            For nI := 1 to len(aUsers)
                If aUsers[nI][1] == ::cIdJobManual // semaforo
                    nThrFilha := aUsers[nI][3]
                    If !::IsThreadRunning(nThrFilha)
                        IPCGo( ::cIdJobManual,"##QUIT##")
                    EndIf
                EndIf
            Next nI
            aUsers := aSize(aUsers,0)

            If ::CheckIfDone()
                Exit
            EndIf
            Sleep(500)
        EndDo
    EndIf

    //Conout("[TERMINATE] Classe encerrada "+cValtoChar(ThreadID()))

    If ::oQryDone != Nil
        ::oQryDone:Destroy()
        ::oQryDone := Nil
    EndIf
    If ::oQryError != Nil
        ::oQryError:Destroy()
        ::oQryError := Nil
    EndIf
    If ::oQryRun != Nil 
        ::oQryRun:Destroy()
        ::oQryRun := Nil
    EndIf
Return lRet

/*/{Protheus.doc} CleanUp
    Limpa as threads da tabela de controle
    @author Squad Entradas
    @since 19/05/2026
    /*/
Method CleanUp(cIdExec) Class ThreadManager
    Local cQuery := ''

    cQuery := " Delete From "+::TableName()
    cQuery += " Where IDEXEC = '"+cIdExec+"' "

    ::RunQuery(cQuery)
Return

/*/{Protheus.doc} GetError
    Encapsula os métodos de retorno de erro
    @author Squad entradas
    @since 13/03/2025
    @version version
    @param param_name, param_type, param_descr
    @return return_var, return_type, return_description
    /*/
Method GetError() Class ThreadManager
    Local cError := ""

    If ::lIsGrid
        cError := ::oGrid:GetError()
    ElseIf ::lIsManualJob

    EndIf
Return cError

/*/{Protheus.doc} GetIdJob
    Retorna o ID do job

    @Type Method
    @author Squad Entradas
    @since 14/03/2025
    /*/
Method GetIdJob() Class ThreadManager
Return ::cIdJob

Static __oThrManager := Nil

Function GetThrManager()
Return __oThrManager

/*/{Protheus.doc} Prepare
Função de abertura do ambiente
@type function
@author Squad Entradas
@since 11/03/2025
/*/
Function Prepare(xParams)
    Local aParams       := {}
    Local cParams       := ""
    Local cEmpJob       := ""
    Local cFilJob       := ""
    Local cTmpTableName := ""
    Local cIdExec       := ""
    Local cUUID         := ""
    Local cType         := ""
    Local cFunPrep      := Nil

    If ValType(xParams) == 'A'
        cParams := xParams[1]
    Else
        cParams := xParams
    EndIf

    aParams := StrTokArr(cParams, chr(255))
    cEmpJob := aParams[1]
    cFilJob := aParams[2]
    cTmpTableName := aParams[3]
    cIdExec := aParams[4]
    cUUID   := aParams[5]
    cType   := aParams[6]
    If Len(aParams) >= 7
        cFunPrep := aParams[7]
    EndIf

    //Conout("[Function PREPARE] Antes da abertura do ambiente "+cValtoChar(ThreadID()))

    RPCSetEnv(cEmpJob,cFilJob,,,'EST')
    RPCSetType(3)

    //Conout("[Function PREPARE] Ambiente aberto com sucesso "+cValtoChar(ThreadID()))

    If TCCanOpen(cTmpTableName)
        DbUseArea(.T.,"TOPCONN", cTmpTableName , cTmpTableName, .T.)
        (cTmpTableName)->(dbSetIndex(cTmpTableName+'_01'))
        (cTmpTableName)->(dbSetIndex(cTmpTableName+'_02'))
        (cTmpTableName)->(dbSetIndex(cTmpTableName+'_03'))
        (cTmpTableName)->(DbSetOrder(1))

        //Conout("[Function PREPARE] "+cValtoChar(ThreadID())+" Abertura "+cTmpTableName)
    EndIf

    If cType == "3" //Instancia a classe dentro do grid para rodar em manualjob
        If __oThrManager == Nil
            __oThrManager := ThreadManager():New(2, "EST330GRD_"+cEmpAnt, cIdExec, cFunPrep)

            lRet := __oThrManager:Prepare()
            If !lRet
                //Gravar log e finalizar
                UserException(__oThrManager:GetError())
            EndIf
        EndIf
    EndIf

    If !Empty(cFunPrep)
        Eval({|x| &(cFunPrep+'(x)')})
    EndIf

    ASize(aParams, 0)
    aParams := Nil
Return .T.

/*/{Protheus.doc} Execute
Função principal de execução, com os controles da tabela de threads
@type function
@author Squad Entradas
@since 11/03/2025
/*/
Function Execute(xParams) ///xparams
    Local cTmpTableName := ""
    Local cUUID         := ""
    Local cIdJob        := ""
    Local nThreadPai    := 0
    Local nSeq          := 0
    Local nThreadFilha  := ThreadID()
    Local jParams       := JsonObject():New()
    Local aParamThr     := {}
    Local cFunExec      := ''
    Local aParams       := {}
    Local cError        := ''
    Local lError        := .F.
    Local aAreaTmp      := {}

    //Conout("[Function EXECUTE] "+cValtoChar(ThreadID()))

    If ValType(xParams) == 'A'
        cTmpTableName := xParams[1]
        cUUID         := xParams[2]
        cIdJob        := xParams[3]
        nThreadPai    := xParams[4]
        nSeq          := xParams[5]
    Else
        If xParams == '##QUIT##' //finalizar o manualjob
            killapp(.T.)
        EndIf
    EndIf
    
    (cTmpTableName)->(DbSetOrder(1)) //THRUUID+IDJOB+THRPAI+SEQTHR

    If (cTmpTableName)->(DbSeek(PadR(cUUID,36)+PadR(cIdJob, 15)+Str(nThreadPai, 15)+Str(nSeq, 15)))
        RecLock(cTmpTableName, .F.)
        (cTmpTableName)->STATUSTHR := '01' //Em processamento
        (cTmpTableName)->THRFIL    := nThreadFilha
        (cTmpTableName)->(MsUnlock())

        jParams:FromJson((cTmpTableName)->PARAMETROS)
        aParamThr := jParams["PARAMS"]
        cFunExec  := aParamThr[1]
        aParams   := aParamThr[2]

        //Conout("[GRID] Iniciando processamento - parametros: "+AsString(aParamThr))

        Try
            aAreaTmp := (cTmpTableName)->(FWGetArea())
            Eval({|x| &(cFunExec+'(x)')}, aParams)
            (cTmpTableName)->(FWRestArea(aAreaTmp))

            If !lError
                //Conout("[GRID] Executado com sucesso "+cValtoChar(ThreadID()))
                RecLock(cTmpTableName, .F.)
                (cTmpTableName)->STATUSTHR := '02' //Sucesso
                (cTmpTableName)->(MsUnlock())
                //Conout("[GRID] Status atualizado para 02 "+cValtoChar(ThreadID()))
            EndIf
        Catch oError
            lError := .T.
            cError := "["+cValToChar(oError:genCode)+"]"
            cError += oError:Description

            RecLock(cTmpTableName, .F.)
            (cTmpTableName)->STATUSTHR := '03' //Erro
            (cTmpTableName)->ERROTHR   := cError
            (cTmpTableName)->ERROSTACK := oError:ErrorStack
            (cTmpTableName)->ERROENV   := oError:ErrorEnv

            (cTmpTableName)->(MsUnlock())
        EndTry

        
    EndIf
    
Return



