/*/{Protheus.doc} GetQuery
    Retorna a query estruturada da instalação da View com base nos parâmetros informados
    @author g.moreira
    @since 22/07/2024
    /*/
Method GetQuery(cEmpAtu As Character, jParam As Json) Class ViewInitialStockBalance
    Local cQuery  As Character
    Local cIDView As Character
    Local cNomFis As Character
    Local cDbType As Character
    Local cVersao As Character
    
	cIDView := ::GetViewID()
    cNomFis := "VW_"+cIDView+"_"+cEmpAtu
    cDbType := TCGetDB()
    cVersao := ::GetVersion()

    cQuery := " Create View "+cNomFis+" As "
    cQuery += " Select "
    If cDbType $ 'POSTGRES'
        cQuery += " Char(4) "
    EndIf
    cQuery += "'"+cVersao+"' ASSINATURA, "
    cQuery += " B9_FILIAL, B9_COD, B9_LOCAL, B9_DATA, B9_QINI, B9_QISEGUM, "
	cQuery += " B9_VINI1, B9_VINI2,	B9_VINI3, B9_VINI4, B9_VINI5, "
	cQuery += " B9_CM1,	  B9_CM2,   B9_CM3,   B9_CM4,   B9_CM5 "
    cQuery += " From "+RetSQLName('SB9')+" A "
    cQuery += " Where "
    cQuery += " A.B9_DATA = ( " 
    cQuery += "     Select Max(B9_DATA) "
    cQuery += "     From "+RetSQLName('SB9')+" B "
    cQuery += "     Where A.B9_FILIAL = B.B9_FILIAL "
    cQuery += "       And A.B9_COD    = B.B9_COD "
    cQuery += "       And A.B9_LOCAL  = B.B9_LOCAL "
    cQuery += "       And B.D_E_L_E_T_ = ' ') And "
    cQuery += " A.D_E_L_E_T_ = ' ' "
Return cQuery
