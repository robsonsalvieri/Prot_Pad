#Include 'Totvs.ch'
#Include 'tlpp-core.th'

Using Namespace totvs.protheus.backoffice.stock.iterativecost.table.manager
Using Namespace totvs.protheus.backoffice.stock.iterativecost.view.initialstockbalance
Using Namespace totvs.protheus.backoffice.stock.iterativecost.view.acquisitioncost
Using Namespace totvs.protheus.backoffice.stock.iterativecost.view.laborproduct
namespace totvs.protheus.backoffice.stock.iterativecost.table.processingtable

/*/{Protheus.doc} ProcessingTable
    Classe responsável por retornar a estrutura da tabela de processamento (TRH)
    @author Squad Entradas
    @since 14/03/2024
/*/
Class ProcessingTable From TableManager

    public method New() 

    static method CamposProc()
    static method IndicesProc()
    static method TableName()
    Public Method TableManager()
    Public Method QueryStartProcTable()
    public method queryInitProcTable()
    public method queryAgglutinated()
    public method insertProcTable()
    Public Method InitStockBalance()

    Public data   cCusFil        As character
    Public Data   lA330GRV As Logical
    Public Data   cViewAcquisCst As Character
    Public Data   cViewInitBal   As Character
    Public Data   cViewSB1MOD    As Character
    Public Data   jVwAcquistCstParams As Json
    Public Data   jVwInitBalParams As Json
    Public Data   jVwSB1MOD           As Json
    Public Data   oQueryStart As Object
    Public Data   aQueryUpdate As Array
    Public Data   oQueryInit     As Object

endclass

/*/{Protheus.doc} New
    Instância da classe
    @author Squad Entradas
    @since 14/03/2024
/*/
Method New(aFil) Class ProcessingTable

    ::cCusFil  := SuperGetMv("MV_CUSFIL", .F., "A")
    ::lA330GRV := SuperGetMv("MV_A330GRV", .F., .T.)
    ::jVwAcquistCstParams := JsonObject():New()
    ::jVwInitBalParams    := JsonObject():New()
    ::jVwSB1MOD           := JsonObject():New()
    ::oQueryStart  := Nil
    ::aQueryUpdate := {}

    D4D->(DbSetOrder(1)) //D4D_FILIAL+D4D_IDVIEW
    If D4D->(DbSeek(FWXFilial('D4D')+ViewAcquisitionCost():GetViewID()))
        ::cViewAcquisCst := D4D->D4D_VWNAME
        ::jVwAcquistCstParams:FromJson(D4D->D4D_PARAM)
    EndIf
    If D4D->(DbSeek(FWXFilial('D4D')+ViewInitialStockBalance():GetViewID()))
        ::cViewInitBal := D4D->D4D_VWNAME
        ::jVwInitBalParams:FromJson(D4D->D4D_PARAM)
    EndIf   
    If D4D->(DbSeek(FWXFilial('D4D')+ViewLaborProduct():GetViewID()))
        ::cViewSB1MOD := D4D->D4D_VWNAME
        ::jVwSB1MOD:FromJson(D4D->D4D_PARAM)
    EndIf   

    If ::cCusFil == 'E'
        _Super:New(aFil, 'E', 'C', 'C' )
    Else
        _Super:New(aFil, 'E', 'E', 'E')
    EndIf

Return

Method TableManager() Class ProcessingTable
    _Super:TableManager(::TableName(),::CamposProc(),::IndicesProc())
Return

/*/{Protheus.doc} CamposProc
    Campos da tabela de processamento
    @author Squad Entradas
    @since 14/03/2024
/*/
Method CamposProc() Class ProcessingTable
    Local aFields   := {} as array
    Local nTamQFIM  := TamSX3('B2_QFIM')[1]   as numeric
    Local nDecQFIM  := TamSX3('B2_QFIM')[2]   as numeric
    Local nTamVFIM  := TamSX3('B2_VFIM1')[1]  as numeric
    Local nDecVFIM  := TamSX3('B2_VFIM1')[2]  as numeric
    Local nTamCMFIM := TamSX3('B2_CMFIM1')[1] as numeric
    Local nDecCMFIM := TamSX3('B2_CMFIM1')[2] as numeric

    aAdd(aFields, {"FILPROC",   "C" , TamSX3('B2_FILIAL')[1] , 0})
    aAdd(aFields, {"ITERACAO",  "N" , TamSX3('D4E_NUMITE')[1], 0})
    aAdd(aFields, {"FILIAL",    "C" , TamSX3('B2_FILIAL')[1] , 0})
    aAdd(aFields, {"COD",       "C" , TamSX3('B2_COD')[1]    , 0})
    aAdd(aFields, {"ARMAZEM",   "C" , TamSX3('B2_LOCAL')[1]  , 0})
    aAdd(aFields, {"QTDHIST",   "N" , nTamQFIM,  nDecQFIM})
    aAdd(aFields, {"QTDPROC",   "N" , nTamQFIM,  nDecQFIM})
    aAdd(aFields, {"CSTHIST1",  "N" , nTamVFIM,  nDecVFIM})
    aAdd(aFields, {"CSTPROC1",  "N" , nTamVFIM,  nDecVFIM})
    aAdd(aFields, {"CMHIST1",   "N" , nTamCMFIM, nDecCMFIM})
    aAdd(aFields, {"CMPROC1",   "N" , nTamCMFIM, nDecCMFIM})
    aAdd(aFields, {"CSTHIST2",  "N" , nTamVFIM,  nDecVFIM})
    aAdd(aFields, {"CSTPROC2",  "N" , nTamVFIM,  nDecVFIM})
    aAdd(aFields, {"CMHIST2",   "N" , nTamCMFIM, nDecCMFIM})
    aAdd(aFields, {"CMPROC2",   "N" , nTamCMFIM, nDecCMFIM})
    aAdd(aFields, {"CSTHIST3",  "N" , nTamVFIM,  nDecVFIM})
    aAdd(aFields, {"CSTPROC3",  "N" , nTamVFIM,  nDecVFIM})
    aAdd(aFields, {"CMHIST3",   "N" , nTamCMFIM, nDecCMFIM})
    aAdd(aFields, {"CMPROC3",   "N" , nTamCMFIM, nDecCMFIM})
    aAdd(aFields, {"CSTHIST4",  "N" , nTamVFIM,  nDecVFIM})
    aAdd(aFields, {"CSTPROC4",  "N" , nTamVFIM,  nDecVFIM})
    aAdd(aFields, {"CMHIST4",   "N" , nTamCMFIM, nDecCMFIM})
    aAdd(aFields, {"CMPROC4",   "N" , nTamCMFIM, nDecCMFIM})
    aAdd(aFields, {"CSTHIST5",  "N" , nTamVFIM,  nDecVFIM})
    aAdd(aFields, {"CSTPROC5",  "N" , nTamVFIM,  nDecVFIM})
    aAdd(aFields, {"CMHIST5",   "N" , nTamCMFIM, nDecCMFIM})
    aAdd(aFields, {"CMPROC5",   "N" , nTamCMFIM, nDecCMFIM})
    aAdd(aFields, {"VARIACAO",  "N" , nTamCMFIM, nDecCMFIM})
    aAdd(aFields, {"HISTVAR",   "M",  10, 0})
    
Return aFields

/*/{Protheus.doc} IndicesProc
    Índices da tabela de processamento
    @author Squad Entradas
    @since 14/03/2024
/*/
Method IndicesProc() Class ProcessingTable
    Local aIndex := {} as array

    aAdd(aIndex, {ProcessingTable():TableName()+'_01', 'FILPROC+FILIAL+COD+ARMAZEM'})
    aAdd(aIndex, {ProcessingTable():TableName()+'_02', 'FILPROC+COD'})

Return aIndex

/*/{Protheus.doc} TableName
    Retorna o nome da tabela de processamento
    @author Squad Entradas
    @since 14/03/2024
/*/
Method TableName() Class ProcessingTable
    Local cAlias as character

    cAlias := "TRH"+cEmpAnt+"SP"

Return cAlias

/*/{Protheus.doc} QueryStartProcTable
    Query para inicializar tabela de processamento
    de acordo com a SB2 ou movimentações do periodo,
    dependendo do parâmetro MV_A330GRV e MV_CUSFIL

    @Type Method
    @author Squad.Entradas
    @since 16/09/2024
    @version 1.0
    @param  cViewInitBal, character, view de saldos iniciais
    @return cQuery, character, query
    /*/
Method QueryStartProcTable(cFilProc, cFilAtu, dDtIni, dDtFim) Class ProcessingTable
    Local cQuery := ""
    Local nI     := 0
    Local aBind  := {}

    If ::oQueryStart == Nil
        cQuery := " Select "
        If ::lPostgres
            cQuery += " Char("+cValToChar(FWSizeFilial())+") "
        EndIf
        cQuery += " '"+cFilProc+"' FILPROC, "
        If ::cCusFil == "E"
            If ::lPostgres
                cQuery += " Char("+cValToChar(FWSizeFilial())+") "
            EndIf
            cQuery += " '"+PadR(FWCompany(), FWSizeFilial())+"' FILIAL, "
        Else
            cQuery += " B2_FILIAL FILIAL, "
        EndIf
        cQuery += " B2_COD COD "
        If ::cCusFil == "A"
            cQuery += " , B2_LOCAL ARMAZEM "
        EndIf
        cQuery += " From "+RetSQLName("SB2")+" SB2 "
        cQuery += " Inner Join "+RetSQLName("SB1")+" SB1 "
        cQuery += "    On SB1.B1_FILIAL  = ? "
        cQuery += "   And SB1.B1_COD     = SB2.B2_COD "
        cQuery += "   And SB1.D_E_L_E_T_ = ? "
        cQuery += " Where "
        cQuery += " SB2.B2_FILIAL = ? "
        cQuery += " And SB2.D_E_L_E_T_ = ? "
        If !::lA330GRV
            cQuery += " And ( "
            cQuery += "     SB2.B2_QFIM  <> 0 "
            cQuery += "  Or SB2.B2_VFIM1 <> 0 "
            cQuery += "  Or SB2.B2_VFIM2 <> 0 "
            cQuery += "  Or SB2.B2_VFIM3 <> 0 "
            cQuery += "  Or SB2.B2_VFIM4 <> 0 "
            cQuery += "  Or SB2.B2_VFIM5 <> 0 "
            cQuery += "  Or (SubString(SB1.B1_COD, 1, 3) = ? or SB1.B1_CCCUSTO <> ?) "
            cQuery += "  Or "
            cQuery += "     Exists ( "
            cQuery += "         Select 1 From "+RetSQLName('SB9')+" SB9 "
            cQuery += "         Where SB9.B9_FILIAL  = ? "
            cQuery += "           And SB9.B9_COD     = SB2.B2_COD "
            cQuery += "           And SB9.B9_LOCAL   = SB2.B2_LOCAL "
            cQuery += "           And (SB9.B9_DATA   = ? Or SB9.B9_DATA   = ?) "
            cQuery += "           And SB9.D_E_L_E_T_ = ? "
            cQuery += "           And ( "
            cQuery += "                 SB9.B9_QINI  <> 0 "
            cQuery += "              Or SB9.B9_VINI1 <> 0 "
            cQuery += "              Or SB9.B9_VINI2 <> 0 "
            cQuery += "              Or SB9.B9_VINI3 <> 0 "
            cQuery += "              Or SB9.B9_VINI4 <> 0 "
            cQuery += "              Or SB9.B9_VINI5 <> 0) "
            cQuery += "     ) "
            cQuery += "  Or "
            cQuery += "     Exists ( "
            cQuery += "         Select 1 From "+RetSQLName('SD1')+" SD1 "
            cQuery += "            Inner Join "+RetSQLName('SF4')+" SF4 "
            cQuery += "            On SF4.F4_FILIAL  = ? "
            cQuery += "           And SF4.F4_CODIGO  = SD1.D1_TES "
            cQuery += "           And SF4.F4_ESTOQUE = ? "
            cQuery += "           And SF4.D_E_L_E_T_ = ? "
            cQuery += "         Where SD1.D1_FILIAL  = ? "
            cQuery += "           And SD1.D1_COD     = SB2.B2_COD "
            cQuery += "           And SD1.D1_LOCAL   = SB2.B2_LOCAL "
            cQuery += "           And SD1.D1_DTDIGIT >= ? "
            cQuery += "           And SD1.D1_DTDIGIT <= ? "
            cQuery += "           And SD1.D1_ORIGLAN <> ? "
            cQuery += "           And SD1.D_E_L_E_T_ = ? "
            cQuery += "     ) "
            cQuery += "  Or "
            cQuery += "     Exists ( "
            cQuery += "         Select 1 From "+RetSQLName('SD2')+" SD2 "
            cQuery += "            Inner Join "+RetSQLName('SF4')+" SF4 "
            cQuery += "            On SF4.F4_FILIAL  = ? "
            cQuery += "           And SF4.F4_CODIGO  = SD2.D2_TES "
            cQuery += "           And SF4.F4_ESTOQUE = ? "
            cQuery += "           And SF4.D_E_L_E_T_ = ? "
            cQuery += "         Where SD2.D2_FILIAL  = ? "
            cQuery += "           And SD2.D2_COD     = SB2.B2_COD "
            cQuery += "           And SD2.D2_LOCAL   = SB2.B2_LOCAL "
            cQuery += "           And SD2.D2_EMISSAO >= ? "
            cQuery += "           And SD2.D2_EMISSAO <= ? "
            cQuery += "           And SD2.D2_ORIGLAN <> ? "
            cQuery += "           And SD2.D_E_L_E_T_ = ? "
            cQuery += "     ) "
            cQuery += "  Or "
            cQuery += "     Exists ( "
            cQuery += "         Select 1 From "+RetSQLName('SD3')+" SD3 "
            cQuery += "         Where SD3.D3_FILIAL  = ? "
            cQuery += "           And SD3.D3_COD     = SB2.B2_COD "
            cQuery += "           And SD3.D3_LOCAL   = SB2.B2_LOCAL "
            cQuery += "           And SD3.D3_EMISSAO >= ? "
            cQuery += "           And SD3.D3_EMISSAO <= ? "
            cQuery += "           And SD3.D3_ESTORNO = ? "
            cQuery += "           And SD3.D_E_L_E_T_ = ? "
            cQuery += "     ) "
            cQuery += " ) "
        EndIf

        //Tratamento para registros que existem em mais de uma filial - MV_CUSFIL = E
        //Dentro da mesma filial, o Group By resolve
        If ::cCusFil == 'E'
            cQuery += " And Not Exists ("
            cQuery += "    Select 1 From "+::TableName()+" TRH "
            cQuery += "     Where TRH.FILPROC    = ? "
            cQuery += "       And TRH.FILIAL     = ? "
            cQuery += "       And TRH.COD        = SB2.B2_COD "
            cQuery += "       And TRH.D_E_L_E_T_ = ? "
            cQuery += " )"
        EndIf

        cQuery += " Group By "
        If ::cCusFil != "E"
            cQuery += " B2_FILIAL, "
        EndIf
        cQuery += " B2_COD "
        If ::cCusFil == "A"
            cQuery += ", B2_LOCAL"
        EndIf

        cQuery := ChangeQuery(cQuery)

        ::oQueryStart := FWExecStatement():New(cQuery)
    EndIf

    ASize(aBind, 0)
    aBind := {}

    //SB1
    AAdd(aBind, FWXFilial('SB1', cFilAtu)) //B1_FILIAL
    AAdd(aBind, ' ') //SB1.D_E_L_E_T_

    //SB2
    AAdd(aBind, FWXFilial('SB2', cFilAtu)) //B2_FILIAL
    AAdd(aBind, ' ') //SB2.D_E_L_E_T_

    If !::lA330GRV
        //SB1
        AAdd(aBind, 'MOD') //B1_COD
        AAdd(aBind, ' ') //B1_CCCUSTO

        //SB9
        AAdd(aBind, FWXFilial('SB9', cFilAtu)) //B9_FILIAL
        AAdd(aBind, DToS(dDtIni)) //B9_DATA
        AAdd(aBind, ' ') //B9_DATA
        AAdd(aBind, ' ') //D_E_L_E_T_

        //SD1		
        AAdd(aBind, FWXFilial('SF4', cFilAtu)) //F4_FILIAL
        AAdd(aBind, 'S') //F4_ESTOQUE
        AAdd(aBind, ' ') //D_E_L_E_T_
        AAdd(aBind, FWXFilial('SD1', cFilAtu)) //D1_FILIAL
        AAdd(aBind, DToS(dDtIni)) //D1_DTDIGIT
        AAdd(aBind, DToS(dDtFim)) //D1_DTDIGIT
        AAdd(aBind, 'LF') //D1_ORIGLAN
        AAdd(aBind, ' ') //D_E_L_E_T_

        //SD2		
        AAdd(aBind, FWXFilial('SF4', cFilAtu)) //F4_FILIAL
        AAdd(aBind, 'S') //F4_ESTOQUE
        AAdd(aBind, ' ') //D_E_L_E_T_
        AAdd(aBind, FWXFilial('SD2', cFilAtu)) //D2_FILIAL
        AAdd(aBind, DToS(dDtIni)) //D2_EMISSAO
        AAdd(aBind, DToS(dDtFim)) //D2_EMISSAO
        AAdd(aBind, 'LF') //D2_ORIGLAN
        AAdd(aBind, ' ') //D_E_L_E_T_

        //SD3
        AAdd(aBind, FWXFilial('SD3', cFilAtu)) //D3_FILIAL
        AAdd(aBind, DToS(dDtIni)) //D3_EMISSAO
        AAdd(aBind, DToS(dDtFim)) //D3_EMISSAO
        AAdd(aBind, ' ') //D3_ESTORNO
        AAdd(aBind, ' ') //D_E_L_E_T_
    EndIf

    If ::cCusFil == 'E'
        AAdd(aBind, cFilProc) //TRH.FILPROC
        AAdd(aBind, PadR(FWCompany(), FWSizeFilial())) //TRH.FILIAL
        AAdd(aBind, ' ') //TRH.D_E_L_E_T_
    EndIf

    For nI := 1 To Len(aBind)
        ::oQueryStart:SetString(nI, aBind[nI])
    Next nI

    cQuery := ::oQueryStart:GetFixQuery()

    FWFreeArray(aBind)

Return cQuery

/*/{Protheus.doc} queryInitProcTable
    Query para inicializar tabela de processamento
    de acordo com views de saldo inicial e custo de aquisicao
    @author Squad.Entradas
    @since 30/08/2024
    @version 1.0
    @param  cViewInitBal, character, view de saldos iniciais
    @return cQuery, character, query
    /*/
Method queryInitProcTable(cFilProc, cFilAtu, dDtIni, dDtFim, cCusUnif) Class ProcessingTable
    Local aBind  := {}
    Local cQuery := ""
    Local cDtIni := DToS(dDtIni)
    Local cDtFim := DToS(dDtFim)
    Local nI     := 0
    Local cMD5   := ""
    Local nQry   := 0

    Default cCusUnif := ::cCusFil

    cQuery := "SELECT "
    If cCusUnif != "E"
        cQuery += "SB9.B9_FILIAL FILIAL, "
    EndIf
    cQuery +=   "SB9.B9_COD COD, "
    If cCusUnif == "A"
        cQuery += "SB9.B9_LOCAL ARMAZEM, "
    EndIf
    cQuery +=   "SUM(SB9.B9_QINI) QTDHIST, "
    cQuery +=   "SUM(SB9.B9_QINI) QTDPROC, "
    cQuery +=   "SUM(SB9.B9_QISEGUM) QISEGUM, "
    cQuery +=   "SUM(SB9.B9_VINI1) CSTHIST1, "
    cQuery +=   "SUM(SB9.B9_VINI1) CSTPROC1, "
    cQuery +=   "SUM(SB9.B9_VINI2) CSTHIST2, "
    cQuery +=   "SUM(SB9.B9_VINI2) CSTPROC2, "
    cQuery +=   "SUM(SB9.B9_VINI3) CSTHIST3, "
    cQuery +=   "SUM(SB9.B9_VINI3) CSTPROC3, "
    cQuery +=   "SUM(SB9.B9_VINI4) CSTHIST4, "
    cQuery +=   "SUM(SB9.B9_VINI4) CSTPROC4, "
    cQuery +=   "SUM(SB9.B9_VINI5) CSTHIST5, "
    cQuery +=   "SUM(SB9.B9_VINI5) CSTPROC5, "
    //Custo histórico
    cQuery +=   "AVG(SB9.B9_CM1) CMHIST1, "
    cQuery +=   "AVG(SB9.B9_CM1) CMPROC1, "
    cQuery +=   "AVG(SB9.B9_CM2) CMHIST2, "
    cQuery +=   "AVG(SB9.B9_CM2) CMPROC2, "
    cQuery +=   "AVG(SB9.B9_CM3) CMHIST3, "
    cQuery +=   "AVG(SB9.B9_CM3) CMPROC3, "
    cQuery +=   "AVG(SB9.B9_CM4) CMHIST4, "
    cQuery +=   "AVG(SB9.B9_CM4) CMPROC4, "
    cQuery +=   "AVG(SB9.B9_CM5) CMHIST5, "
    cQuery +=   "AVG(SB9.B9_CM5) CMPROC5 "
    cQuery += " FROM " + ::cViewInitBal + " SB9 "
    cQuery += " Left Outer Join "+::cViewSB1MOD+" SB1 "
    cQuery += " On "
    If  FWModeAccess("SB1", 1) == FWModeAccess("SB9", 1) .And. ;
        FWModeAccess("SB1", 2) == FWModeAccess("SB9", 2) .And. ;
        FWModeAccess("SB1", 3) == FWModeAccess("SB9", 3)
        cQuery += " SB1.B1_FILIAL = SB9.B9_FILIAL And "
    Else
        cQuery += " SB1.B1_FILIAL = ? And "
    EndIf
    cQuery += " SB1.B1_COD = SB9.B9_COD "
    cQuery += " Where "
    cQuery += " SB9.B9_FILIAL = ? "
    cQuery += " And SB1.B1_CCCUSTO Is Null " //Ignora produtos MOD
    cQuery += "GROUP BY "
    If cCusUnif != "E"
        cQuery += "SB9.B9_FILIAL, "
    EndIf
    cQuery += "SB9.B9_COD"
    If cCusUnif == "A"
        cQuery += ", SB9.B9_LOCAL"
    EndIf
    cQuery += " UNION ALL "
    cQuery += "SELECT "
    If cCusUnif != "E"
        cQuery += "SD1.D1_FILIAL FILIAL, "
    EndIf
    cQuery +=   "SD1.D1_COD COD, "
    If cCusUnif == "A"
        cQuery += "SD1.D1_LOCAL ARMAZEM, "
    EndIf
    cQuery +=   "SUM(SD1.D1_QUANT) QTDHIST, "
    cQuery +=   "SUM(SD1.D1_QUANT) QTDPROC, "
    cQuery +=   "SUM(SD1.D1_QTSEGUM) QISEGUM, "
    cQuery +=   "SUM(SD1.D1_CUSTO) CSTHIST1, "
    cQuery +=   "SUM(SD1.D1_CUSTO) CSTPROC1, "
    cQuery +=   "SUM(SD1.D1_CUSTO2) CSTHIST2, "
    cQuery +=   "SUM(SD1.D1_CUSTO2) CSTPROC2, "
    cQuery +=   "SUM(SD1.D1_CUSTO3) CSTHIST3, "
    cQuery +=   "SUM(SD1.D1_CUSTO3) CSTPROC3, "
    cQuery +=   "SUM(SD1.D1_CUSTO4) CSTHIST4, "
    cQuery +=   "SUM(SD1.D1_CUSTO4) CSTPROC4, "
    cQuery +=   "SUM(SD1.D1_CUSTO5) CSTHIST5, "
    cQuery +=   "SUM(SD1.D1_CUSTO5) CSTPROC5, "
    cQuery +=   "0 CMHIST1, "
    cQuery +=   "0 CMPROC1, "
    cQuery +=   "0 CMHIST2, "
    cQuery +=   "0 CMPROC2, "
    cQuery +=   "0 CMHIST3, "
    cQuery +=   "0 CMPROC3, "
    cQuery +=   "0 CMHIST4, "
    cQuery +=   "0 CMPROC4, "
    cQuery +=   "0 CMHIST5, "
    cQuery +=   "0 CMPROC5 "
    cQuery += " FROM " + ::cViewAcquisCst + " SD1 "
    cQuery += " Where "
    cQuery += " SD1.D1_FILIAL  = ? And "
    cQuery += " SD1.D1_DTDIGIT >= ? And "
    cQuery += " SD1.D1_DTDIGIT <= ? "
    If  ::jVwAcquistCstParams["SF4_EMPRESA"] != FWModeAccess("SD1", 1) .Or. ;
        ::jVwAcquistCstParams["SF4_UNIDADE"] != FWModeAccess("SD1", 2) .Or. ;
        ::jVwAcquistCstParams["SF4_FILIAL"]  != FWModeAccess("SD1", 3)
        cQuery += " And SD1.F4_FILIAL = ? "
    EndIf
    cQuery += "GROUP BY "
    If cCusUnif != "E"
        cQuery += "SD1.D1_FILIAL, "
    EndIf
    cQuery += "SD1.D1_COD"
    If cCusUnif == "A"
        cQuery += ", SD1.D1_LOCAL"
    EndIf

    cMD5  := MD5(cQuery)

    nQry := AScan(::aQueryUpdate, {|x| x[1] == cMD5})
    If nQry == 0
		AAdd(::aQueryUpdate, {cMD5, FwExecStatement():New()})

		nQry := Len(::aQueryUpdate)
		::aQueryUpdate[nQry, 2]:SetQuery(ChangeQuery(cQuery))
	EndIf

    ASize(aBind, 0)
    aBind := {}
    //Saldos iniciais
    If  FWModeAccess("SB1", 1) != FWModeAccess("SB9", 1) .Or. ;
        FWModeAccess("SB1", 2) != FWModeAccess("SB9", 2) .Or. ;
        FWModeAccess("SB1", 3) != FWModeAccess("SB9", 3)
        AAdd(aBind, FWXFilial('SB1', cFilAtu)) //B1_FILIAL
    EndIf
    AAdd(aBind, FWXFilial('SB9', cFilAtu)) //B9_FILIAL
    AAdd(aBind, FWXFilial('SD1', cFilAtu)) //D1_FILIAL
    AAdd(aBind, cDtIni) //D1_DTDIGIT
    AAdd(aBind, cDtFim) //D1_DTDIGIT
    If  ::jVwAcquistCstParams["SF4_EMPRESA"] != FWModeAccess("SD1", 1) .Or. ;
        ::jVwAcquistCstParams["SF4_UNIDADE"] != FWModeAccess("SD1", 2) .Or. ;
        ::jVwAcquistCstParams["SF4_FILIAL"]  != FWModeAccess("SD1", 3)
        AAdd(aBind, FWXFilial('SF4', cFilAtu)) //F4_FILIAL
    EndIf

    For nI := 1 To Len(aBind)
        ::aQueryUpdate[nQry, 2]:SetString(nI, aBind[nI])
    Next nI

    cQuery := ::aQueryUpdate[nQry, 2]:GetFixQuery()

    FWFreeArray(aBind)

Return cQuery

/*/{Protheus.doc} queryAgglutinated
    Query para inicializar tabela de processamento aglutinada
    @author Squad.Entradas
    @since 30/08/2024
    @version 1.0
    @param  cViewInitBal, character, view de saldos iniciais
    @return cQueryAglut, character, query
    /*/
Method queryAgglutinated(cFilProc, cFilAtu, dDtIni, dDtFim, cCusUnif) Class ProcessingTable
    Local cQuery := ""
    Local cQueryAglut := ""
    Local nMoeda := 0
    Local cMoeda := ""

    Default cCusUnif := ::cCusFil

    cQuery := ::queryInitProcTable(cFilProc, cFilAtu, dDtIni, dDtFim, cCusUnif)

    cQueryAglut := "SELECT "
    If ::lPostgres
        cQueryAglut += " Char("+cValToChar(FWSizeFilial())+") "
    EndIf
    cQueryAglut += " '"+cFilProc+"' FILPROC, "
    If cCusUnif == "E"
        If ::lPostgres
            cQueryAglut += " Char("+cValToChar(FWSizeFilial())+") "
        EndIf
        cQueryAglut += " '"+PadR(FWCompany(), FWSizeFilial())+"' FILIAL, "
    Else
        cQueryAglut += "FILIAL, "
    EndIf
    cQueryAglut +=  "COD, "
    If cCusUnif == "A"
        cQueryAglut +=   "ARMAZEM, "
    EndIf
    cQueryAglut +=  "SUM(QTDHIST) QTDHIST, "
    cQueryAglut +=  "SUM(QTDPROC) QTDPROC, "
    cQueryAglut +=  "SUM(QISEGUM) QISEGUM, "
    For nMoeda := 1 To 5   
        cMoeda := cValToChar(nMoeda)
        cQueryAglut +=  "SUM(CSTHIST"+cMoeda+") CSTHIST"+cMoeda+", "
        cQueryAglut +=  "SUM(CSTPROC"+cMoeda+") CSTPROC"+cMoeda+", "
        cQueryAglut +=  "MAX(CMHIST"+cMoeda+") CMHIST"+cMoeda+","
        cQueryAglut +=  "MAX(CMPROC"+cMoeda+") CMPROC"+cMoeda+","
    Next nMoeda
    cQueryAglut := SubStr(cQueryAglut, 1, Len(cQueryAglut)-1)
    cQueryAglut += " FROM (" + cQuery + ") AGLUTINADA "
    cQueryAglut += " GROUP BY "
    If cCusUnif != "E"
        cQueryAglut += "FILIAL, "
    EndIf
    cQueryAglut += "COD"
    If cCusUnif == "A"
        cQueryAglut += ", ARMAZEM "
    EndIf

Return cQueryAglut

/*/{Protheus.doc} insertProcTable
    Inicializa tabela de processamento com views de saldo inicial e custo de aquisicao aglutinadas
    @author Squad.Entradas
    @since 30/08/2024
    @version 1.0
    @param  cViewInitBal, character, view de saldos iniciais
    /*/
Method insertProcTable(cFilProc, dDtIni, dDtFim) Class ProcessingTable

    Local cQuery     := ""
    Local cCampos    := ""
    Local aCampos    := {}
    Local cInsert    := ""
    Local cUpdate    := ""
    Local cCTE       := ""
    Local nFil       := 0
    Local nMoeda     := 0
    Local cMoeda     := ""
    Local nI         := 0
    Local cNull      := MatIsNull()

    cCampos := "FILPROC, "
    cCampos += "FILIAL, "
    cCampos += "COD "
    If ::cCusFil == "A"
        cCampos += ", ARMAZEM "
    EndIf

    //Inicializa os produtos com saldo zerado
    For nFil := 1 To Len(::aFilProc)
        cQuery := ::QueryStartProcTable(cFilProc, ::aFilProc[nFil, 1], dDtIni, dDtFim)
        cInsert := ::FormatCTE(cCampos, cQuery)
        ::RunQuery(cInsert)
    Next nFil

    //Processa as views de custo de aquisição e saldo inicial
    If !::lOracle
        cCTE := " With TEMPTABLE As "
    Else
        cCTE := " Merge Into "+::TableName()+" Using "
    EndIf

    For nFil := 1 To Len(::aFilProc)
        cQuery  := "("+::queryAgglutinated(cFilProc, ::aFilProc[nFil, 1], dDtIni, dDtFim)+")"

        If ::lOracle
            cQuery += " TEMPTABLE "
            cQuery += " On ("
            cQuery += " "+::TableName()+".FILPROC = TEMPTABLE.FILPROC And "
            cQuery += " "+::TableName()+".FILIAL  = TEMPTABLE.FILIAL  And "
            cQuery += " "+::TableName()+".COD     = TEMPTABLE.COD     "
            If ::cCusFil == 'A'
                cQuery += " And "+::TableName()+".ARMAZEM = TEMPTABLE.ARMAZEM "
            EndIf
            cQuery += " ) "
            cQuery += " When Matched Then "
        EndIf

        If !::lOracle
            cUpdate := " Update "+::TableName()+" "
        Else
            cUpdate := " Update "
        EndIf
        cUpdate += "    Set "

        aCampos := {}
        AAdd(aCampos, 'QTDHIST')
        AAdd(aCampos, 'QTDPROC')
        For nMoeda := 1 To 5   
            cMoeda := cValToChar(nMoeda)
            AAdd(aCampos, 'CSTHIST'+cMoeda)
            AAdd(aCampos, 'CSTPROC'+cMoeda)
        Next

        For nI := 1 To Len(aCampos)
            cUpdate += aCampos[nI]+" = "+cNull
            cUpdate += "("+::TableName()+"."+aCampos[nI]+" + TEMPTABLE."+aCampos[nI]+", 0),"
        Next nI

        For nMoeda := 1 To 5
            cMoeda := cValToChar(nMoeda)
            cUpdate += " CMHIST"+cMoeda+" = "
            cUpdate += " Case "
            cUpdate += "     When ("+::TableName()+".QTDHIST + TEMPTABLE.QTDHIST) > 0 "
            cUpdate += "         Then "
            cUpdate += "             (("+::TableName()+".CSTHIST"+cMoeda+" + TEMPTABLE.CSTHIST"+cMoeda+")"
            cUpdate += "              / "
            cUpdate += "              ("+::TableName()+".QTDHIST + TEMPTABLE.QTDHIST))"
            cUpdate += "         Else TEMPTABLE.CMHIST"+cMoeda+" "
            cUpdate += "     End, "

            cUpdate += " CMPROC"+cMoeda+" = "
            cUpdate += " Case "
            cUpdate += "     When ("+::TableName()+".QTDPROC + TEMPTABLE.QTDPROC) > 0 "
            cUpdate += "         Then "
            cUpdate += "             (("+::TableName()+".CSTPROC"+cMoeda+" + TEMPTABLE.CSTPROC"+cMoeda+")"
            cUpdate += "              / "
            cUpdate += "              ("+::TableName()+".QTDPROC + TEMPTABLE.QTDPROC))"
            cUpdate += "         Else TEMPTABLE.CMPROC"+cMoeda+" "
            cUpdate += "     End,"
        Next nMoeda
        cUpdate := Substr(cUpdate, 1, Len(cUpdate)-1)

        If !::lOracle
            cUpdate += " From TEMPTABLE "
        EndIf
        cUpdate += " Where "
        cUpdate += " "+::TableName()+".FILPROC = '"+cFilProc+"'   And "
        cUpdate += " "+::TableName()+".FILIAL  = TEMPTABLE.FILIAL And "
        cUpdate += " "+::TableName()+".COD     = TEMPTABLE.COD     "
        If ::cCusFil == 'A'
            cUpdate += " And "+::TableName()+".ARMAZEM = TEMPTABLE.ARMAZEM "
        EndIf

        ::RunQuery(cCTE+cQuery+cUpdate)
    Next nFil    

Return 


/*/{Protheus.doc} InitStockBalance
    Inicializa o saldo de quantidade e custo do produto a cada iteração
    @author Squad Entradas
    @since 25/11/2024
    /*/
Method InitStockBalance(cFilProc, cFilAtu, cCod, nIter) Class ProcessingTable
    Local cCTE    As Character
    Local cQuery  As Character
    Local nBind   As Integer
    Local cUpdate As Character
    Local nMoeda  As Integer
    Local cMoeda  As Character

    If !::lOracle
        cCTE := " With TEMPTABLE As "
    Else
        cCTE := " Merge Into "+::TableName()+" Using "
    EndIf

    If ::oQueryInit == Nil
        cQuery := " Select R_E_C_N_O_ RECNUMBER "
        cQuery += " From "+::TableName()+" "
        cQuery += " Where "
        cQuery += " FILPROC = ? And "
        cQuery += " FILIAL  = ? And "
        cQuery += " COD     = ? "

        cQuery := ChangeQuery(cQuery)

        ::oQueryInit := FWExecStatement():New(cQuery)
    EndIf

    nBind := 1
    ::oQueryInit:SetString(nBind++, cFilProc)
    ::oQueryInit:SetString(nBind++, cFilAtu)
    ::oQueryInit:SetString(nBind++, cCod)

    cQuery := " ( "+::oQueryInit:GetFixQuery()+" ) "

    If ::lOracle
        cQuery += " TEMPTABLE "
        cQuery += " On ("
        cQuery += " "+::TableName()+".R_E_C_N_O_ = TEMPTABLE.RECNUMBER"
        cQuery += " ) "
        cQuery += " When Matched Then "
    EndIf

    If !::lOracle
        cUpdate := " Update "+::TableName()+" "
    Else
        cUpdate := " Update "
    EndIf
    cUpdate += "    Set "
    cUpdate += " QTDPROC  = QTDHIST, "
    For nMoeda := 1 To 5
        cMoeda := cValToChar(nMoeda)
        cUpdate += " CSTPROC"+cMoeda+" = CSTHIST"+cMoeda+", "
    Next nMoeda
    cUpdate += " ITERACAO = "+cValToChar(nIter)+" "

    If !::lOracle
        cUpdate += " From TEMPTABLE "
    EndIf
    cUpdate += " Where "
    cUpdate += " "+::TableName()+".R_E_C_N_O_ = TEMPTABLE.RECNUMBER"

    ::RunQuery(cCTE+cQuery+cUpdate)

Return 
