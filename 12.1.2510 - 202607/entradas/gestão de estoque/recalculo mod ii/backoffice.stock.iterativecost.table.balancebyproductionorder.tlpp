/*/{Protheus.doc} BalanceByProductionOrder
    Classe responsável por retornar o saldo das ordens de produções (TRM)
    @author Squad Entradas
    @since 23/10/2024
/*/
Class BalanceByProductionOrder From TableManager

    public method New()

    static method tableFields()
    static method tableIndexes()
    static method tableName()

    public method dataLoader()
    public method updateFinalValueAndProductionEntries()
    public method finalBalanceUpdater()
    public method productionProportionalizer()
    public method productionEntryTotalizer()
    public method existsProductionOrder()
    public method retQueryRE5()
    Public Method TableManager()
    Public method retSizeFieldsSC2()
    
    method balanceUpdaterByEntry()
    method GetOriginalBranch()

    public data nProdPR0  as numeric
    public data aMoedas   as array
    Public data cCusFil   as Character
    public data jQuery    as object
