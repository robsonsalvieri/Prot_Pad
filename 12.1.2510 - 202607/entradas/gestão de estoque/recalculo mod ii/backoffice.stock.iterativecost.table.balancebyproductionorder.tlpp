Endclass

/*/{Protheus.doc} New
    Instância da classe
    @author Squad Entradas
    @since 23/10/2024
/*/
Method new(aFil, cFProc, aMoedas, oRequestCost) Class BalanceByProductionOrder

    ::nProdPR0       := SuperGetMV('MV_PRODPR0',.F., 1)
    ::cCusFil        := SuperGetMv('MV_CUSFIL',.F.,"A")
    ::aMoedas        := aMoedas
    ::oQryOrigBranch := Nil
    ::oQryExist      := Nil
    ::oQryPOValue    := Nil
    ::cFProc         := cFProc
    ::oRequestCost   := oRequestCost

    _Super:New(aFil)

Return

/*/{Protheus.doc} TableManager
    Método responsável por criar/alterar a tabela
    @author Squad Entradas
    @since 23/10/2024
/*/
Method TableManager() Class BalanceByProductionOrder

    _Super:TableManager(::TableName(),::TableFields(),::TableIndexes())

Return

/*/{Protheus.doc} TableFields
    Campos da tabela de saldos por ordem de produção
    @author Squad Entradas
    @since 23/10/2024
/*/
Method tableFields() Class BalanceByProductionOrder
    Local aFields      := {} as array
    Local nTamQtd      := TamSX3('B2_QFIM')[1]  as numeric 
    Local nTamQtdDec   := TamSX3('B2_QFIM')[2]  as numeric

    aAdd(aFields, {"FILPROC",   "C" , TamSX3('B2_FILIAL')[1], 0})
    aAdd(aFields, {"FILIAL",    "C" , TamSX3('B2_FILIAL')[1], 0})
    aAdd(aFields, {"COD",       "C" , TamSX3('B2_COD')[1]   , 0})
    aAdd(aFields, {"OP",        "C" , TamSX3('D3_OP')[1]    , 0})
    aAdd(aFields, {"DATRF",     "D" , 8, 0})
    aAdd(aFields, {"QTDMOV",    "N" , nTamQtd, nTamQtdDec})
    aAdd(aFields, {"PERDAMOV",  "N" , nTamQtd, nTamQtdDec})
    aAdd(aFields, {"QTDORIG",   "N" , nTamQtd, nTamQtdDec})
    aAdd(aFields, {"PERDAOP",   "N" , nTamQtd, nTamQtdDec})
    aAdd(aFields, {"QTDJAENT",  "N" , nTamQtd, nTamQtdDec})
    aAdd(aFields, {"QTDAPONT",  "N" , nTamQtd, nTamQtdDec})
    aAdd(aFields, {"QTDTOTAL",  "N" , nTamQtd, nTamQtdDec})
    aAdd(aFields, {"TOTALPERDA","N" , nTamQtd, nTamQtdDec})
    aAdd(aFields, {"VINI1",     "N" , TamSX3('C2_VINI1')[1],   TamSX3('C2_VINI1')[2]})
    aAdd(aFields, {"VFIM1",     "N" , TamSX3('C2_VFIM1')[1],   TamSX3('C2_VFIM1')[2]})
    aAdd(aFields, {"APRINI1",   "N" , TamSX3('C2_APRINI1')[1], TamSX3('C2_APRINI1')[2]})
    aAdd(aFields, {"APRFIM1",   "N" , TamSX3('C2_APRFIM1')[1], TamSX3('C2_APRFIM1')[2]})
    aAdd(aFields, {"VINI2",     "N" , TamSX3('C2_VINI2')[1],   TamSX3('C2_VINI2')[2]})
    aAdd(aFields, {"VFIM2",     "N" , TamSX3('C2_VFIM2')[1],   TamSX3('C2_VFIM2')[2]})
    aAdd(aFields, {"APRINI2",   "N" , TamSX3('C2_APRINI2')[1], TamSX3('C2_APRINI2')[2]})
    aAdd(aFields, {"APRFIM2",   "N" , TamSX3('C2_APRFIM2')[1], TamSX3('C2_APRFIM2')[2]})
    aAdd(aFields, {"VINI3",     "N" , TamSX3('C2_VINI3')[1],   TamSX3('C2_VINI3')[2]})
    aAdd(aFields, {"VFIM3",     "N" , TamSX3('C2_VFIM3')[1],   TamSX3('C2_VFIM3')[2]})
    aAdd(aFields, {"APRINI3",   "N" , TamSX3('C2_APRINI3')[1], TamSX3('C2_APRINI3')[2]})
    aAdd(aFields, {"APRFIM3",   "N" , TamSX3('C2_APRFIM3')[1], TamSX3('C2_APRFIM3')[2]})
    aAdd(aFields, {"VINI4",     "N" , TamSX3('C2_VINI4')[1],   TamSX3('C2_VINI4')[2]})
    aAdd(aFields, {"VFIM4",     "N" , TamSX3('C2_VFIM4')[1],   TamSX3('C2_VFIM4')[2]})
    aAdd(aFields, {"APRINI4",   "N" , TamSX3('C2_APRINI4')[1], TamSX3('C2_APRINI4')[2]})
    aAdd(aFields, {"APRFIM4",   "N" , TamSX3('C2_APRFIM4')[1], TamSX3('C2_APRFIM4')[2]})
    aAdd(aFields, {"VINI5",     "N" , TamSX3('C2_VINI5')[1],   TamSX3('C2_VINI5')[2]})
    aAdd(aFields, {"VFIM5",     "N" , TamSX3('C2_VFIM5')[1],   TamSX3('C2_VFIM5')[2]})
    aAdd(aFields, {"APRINI5",   "N" , TamSX3('C2_APRINI5')[1], TamSX3('C2_APRINI5')[2]})
    aAdd(aFields, {"APRFIM5",   "N" , TamSX3('C2_APRFIM5')[1], TamSX3('C2_APRFIM5')[2]})
    aAdd(aFields, {"SC2RECNO",  "N" , 10, 0})

Return aFields

/*/{Protheus.doc} TableIndexes
    Índices da tabela de saldos por ordem de produção
    @author Squad Entradas
    @since 23/10/2024
/*/
Method tableIndexes() Class BalanceByProductionOrder
    Local aIndex := {}

    aAdd(aIndex, {BalanceByProductionOrder():TableName()+'_01', 'FILPROC+FILIAL+OP'})
    aAdd(aIndex, {BalanceByProductionOrder():TableName()+'_02', 'FILPROC+FILIAL+COD'})
    aAdd(aIndex, {BalanceByProductionOrder():TableName()+'_03', 'FILPROC+OP'})

Return aIndex

/*/{Protheus.doc} TableName
    Retorna o nome da tabela de saldos por ordem de produção
    @author Squad Entradas
    @since 23/10/2024
/*/
Method tableName() Class BalanceByProductionOrder
    Local cAlias as character

    cAlias := "TRM"+cEmpAnt+"SP"

Return cAlias

/*/{Protheus.doc} dataLoader
    Método responsável por inicializar a tabela Saldos por OP
    @author Squad Entradas
    @since 30/10/2024
/*/
Method dataLoader(cTabSldOP, dDtIni, dDtFim) Class BalanceByProductionOrder
    Local cQuery    as character
    Local cQueryRE5 as character
    Local cCampos   as character
    Local oQuery    as object
    Local nX        as integer
    Local nY        := 1 as integer
    Local aSize     as array

    aSize   := ::retSizeFieldsSC2()

    cQueryRE5 := ::retQueryRE5()

    cCampos := "FILPROC,FILIAL,COD,OP,QTDMOV,PERDAMOV,DATRF,QTDORIG,PERDAOP,QTDJAENT,"
    cCampos += "QTDTOTAL,TOTALPERDA,SC2RECNO"
    For nX := 1 to Len(::aMoedas)
        cCampos += ",VINI"+::aMoedas[nX]+",APRINI"+::aMoedas[nX]
    Next nX

    cQuery := " SELECT TRG.FILPROC, TRG.FILIAL FILIAL, SC2.C2_PRODUTO COD, "
    cQuery += " TRG.OP OP, MAX(C2_DATRF) DATRF, MAX(C2_QUANT) QTDORIG, "
    cQuery += " SUM(CASE WHEN TRG.CF IN ('PR0','PR1') THEN TRG.QUANT ELSE 0 END) QTDMOV, "
    cQuery += " SUM(TRG.PERDA) PERDAMOV, MAX(C2_PERDA) PERDAOP, MAX(C2_QUJE) QTDJAENT, "
    cQuery += " 0 QTDTOTAL, 0 TOTALPERDA, MAX(SC2.R_E_C_N_O_) SC2RECNO  "
    For nX := 1 to Len(::aMoedas)
        //Soma o VINI + RE5(fixo)
        cQuery += ",MAX(C2_VINI"+::aMoedas[nX]+")+MAX("+::cCoalesce+"(SD3.CUSTO"+::aMoedas[nX]+",0)) VINI"+::aMoedas[nX]
        cQuery += ",MAX(C2_APRINI"+::aMoedas[nX]+") APRINI"+::aMoedas[nX]
    Next nX
    cQuery += " FROM " + AnalyticalMovementTable():tableName() + " TRG "
    cQuery += " INNER JOIN "+RetSQLName('SC2')+" SC2 "
    cQuery += " ON C2_FILIAL = TRG.FILIAL "
    cQuery += " AND C2_NUM = ? "
    cQuery += " AND C2_ITEM = ? "
    cQuery += " AND C2_SEQUEN = ? "
    cQuery += " AND C2_ITEMGRD = ? "
    cQuery += " AND SC2.D_E_L_E_T_ = ? "
    cQuery += " LEFT JOIN ("+cQueryRE5+") SD3 "
    cQuery += " ON SD3.FILIAL = TRG.FILIAL "
    cQuery += " AND SD3.OP = TRG.OP "
    cQuery += " GROUP BY TRG.FILPROC,TRG.FILIAL,C2_PRODUTO,TRG.OP "

    cQuery := ChangeQuery(cQuery)

    oQuery := FWExecStatement():New(cQuery)

    oQuery:SetUnsafe(nY++,aSize[01])
    oQuery:SetUnsafe(nY++,aSize[02])
    oQuery:SetUnsafe(nY++,aSize[03])
    oQuery:SetUnsafe(nY++,aSize[04])
    oQuery:SetString(nY++,' ')

    cQuery := oQuery:GetFixQuery()

    cQuery := ::FormatCTE(cCampos,cQuery,.T.)

    ::RunQuery(cQuery)

Return

/*/{Protheus.doc} updateFinalValueAndProductionEntries
    Método responsável por atualizar os campos de quantidade apontada
    e valor final (VFIM e APRFIM) dos produtos consumidos para a OP a cada iteração
    @author Squad Entradas
    @since 30/10/2024
    @type method
/*/
Method updateFinalValueAndProductionEntries(cFilAtu, cTabAnl, cTabSldOP, cTabProc, cNivInv) Class BalanceByProductionOrder
    Local nX     as integer
    Local cQuery as character
    Local cUpdate := ""
    Local cCTE    := ""
    Local nBind   AS Integer
    Local cTabAgl As character
    Local aMatch := {} 
    Local aUpdate := {}
    Local aCpoDest := {}
    Local aInsert := {}

    cTabAgl := AgglutinatedMovementTable():TableName()
    cTabNiv := ProductStructLevelTable():TableName()

    If !::lOracle
        cCTE := " With TEMPTABLE As "
    Else
        cCTE := " Merge Into "+cTabSldOP+" Using "
    EndIf

    If ::oQryPOValue == Nil
        cQuery += " SELECT MOV.FILPROC, MOV.FILIAL, MOV.OP "
        For nX := 1 to Len(::aMoedas)        
            cQuery += " ,SUM( "
            cQuery += " CASE "
            cQuery += "     WHEN CF IN ('RE5','PR0','PR1') "
            cQuery += "         THEN 0 "
            cQuery += "     WHEN TM > '500' AND CUSTOMEDIO = 'N' "
            cQuery += "         THEN MOV.CUSTO"+::aMoedas[nX]+"  "
            cQuery += "     WHEN TM <= '500' AND CUSTOMEDIO = 'N' "
            cQuery += "         THEN -MOV.CUSTO"+::aMoedas[nX]+" "
            cQuery += "     WHEN TM > '500' AND CUSTOMEDIO = 'S' "
            cQuery += "         THEN MOV.QUANT * PRO.CMPROC"+::aMoedas[nX]+" "
            cQuery += "     WHEN TM <= '500' AND CUSTOMEDIO = 'S' "
            cQuery += "         THEN -(MOV.QUANT * PRO.CMPROC"+::aMoedas[nX]+") "
            cQuery += " END) CUSTO"+::aMoedas[nX]+" "
        Next nX
        cQuery += " FROM " + cTabAnl + " MOV "
        cQuery += " INNER JOIN "+cTabProc+" PRO ON "
        cQuery +=     "    PRO.FILPROC = MOV.FILPROC "
        If ::cCusFil != 'E'
            cQuery +=     "AND PRO.FILIAL  = MOV.FILIAL "
        EndIf
        cQuery +=     "AND PRO.COD     = MOV.COD "
        If ::cCusFil == 'A'
            cQuery +=     "AND PRO.ARMAZEM = MOV.LOCARM "
        EndIf
        cQuery += " INNER JOIN "+::TableName()+" TRM ON "
		cQuery += " TRM.FILPROC = MOV.FILPROC "
		cQuery += " AND TRM.FILIAL = MOV.FILIAL "
		cQuery += " AND TRM.OP = MOV.OP "
        cQuery += " WHERE "
        cQuery += " MOV.FILPROC = ? And "
        If ::cCusFil != 'E'
            cQuery += " MOV.FILIAL = ? AND "
        EndIf
        cQuery += " MOV.ALIAS = ? AND "
        cQuery += " MOV.CF NOT IN (?, ?) "
        cQuery += " GROUP BY " 
        cQuery += " MOV.FILPROC, "
        cQuery += " MOV.FILIAL, "
        cQuery += " MOV.OP "

        cQuery := ChangeQuery(cQuery)

        ::oQryPOValue := FWExecStatement():New(cQuery)
    EndIf

    nBind := 1
    ::oQryPOValue:SetString(nBind++, ::cFProc)
    If ::cCusFil != 'E'
        ::oQryPOValue:SetString(nBind++, cFilAtu)
    EndIf
    ::oQryPOValue:SetString(nBind++, 'SD3')
    ::oQryPOValue:SetString(nBind++, 'DE9')
    ::oQryPOValue:SetString(nBind++, 'RE9')

    cQuery := " ( "+::oQryPOValue:GetFixQuery()+" ) "

    If ::lOracle
        cQuery += " TEMPTABLE "
        cQuery += " ON ( "
        cQuery += " "+cTabSldOP+".FILPROC = TEMPTABLE.FILPROC AND "
        cQuery += " "+cTabSldOP+".FILIAL  = TEMPTABLE.FILIAL  AND " 
        cQuery += " "+cTabSldOP+".OP      = TEMPTABLE.OP) "
        cQuery += " When Matched Then "
    EndIf

    If !::lOracle
        cUpdate := " Update "+cTabSldOP+" "
    Else
        cUpdate := " Update "
    EndIf
    cUpdate += " SET "
    For nX := 1 to Len(::aMoedas)
        cUpdate += " VFIM"+::aMoedas[nX]+ " = TEMPTABLE.CUSTO"+::aMoedas[nX]+" + "+::TableName()+".VINI"+::aMoedas[nX]
        cUpdate += " ,APRFIM"+::aMoedas[nX]+" = APRINI"+::aMoedas[nX]+","
    Next nX
    cUpdate += " QTDAPONT = 0 "

    If !::lOracle
        cUpdate += " From TEMPTABLE "
    EndIf
    cUpdate += " Where "
    cUpdate += " "+cTabSldOP+".FILPROC = TEMPTABLE.FILPROC AND "
    cUpdate += " "+cTabSldOP+".FILIAL  = TEMPTABLE.FILIAL  AND "
    cUpdate += " "+cTabSldOP+".OP      = TEMPTABLE.OP "

    ::RunQuery(cCTE+cQuery+cUpdate)

    //Grava o custo Requisitado para a OP 
    If ::oRequestCost <> Nil //<- tratamento para automação de testes unitários
        ::oRequestCost:ProductionRequestCost(cFilAtu, cNivInv)
    EndIf
Return

/*/{Protheus.doc} productionProportionalizer
    Método responsável pela proporcionalização do apontamento de produção
    conforme configuração do parâmetro MV_PRODPR0
    @author Squad Entradas
    @since 30/10/2024
/*/
Method productionProportionalizer(cFilOrig, dDtFim, cTabMov) Class BalanceByProductionOrder
    Local aCusto      := {0,0,0,0,0}
    Local nX          as integer
    Local nQtdTot     as numeric
    Local nQtdJaEnt   as numeric
    Local nPerdaOP    as numeric
    Local nQtdMov     as numeric
    Local nPerdaMov   as numeric
    Local nCustoFinal as numeric
    Local lOPEncParc  as logical
    Local dDataRF     as date
    Local cOP         := (cTabMov)->OP
    Local nQtdAp      := (cTabMov)->QUANT
    Local nQtdPerda   := (cTabMov)->PERDA
    Local nRateio     := (cTabMov)->RATEIO
    Local lParcial    := (cTabMov)->PARCTOT == "P"
    Local cFilAtu     := cFilOrig
    Local cTabSldOP   := ::TableName()

    If ::cCusFil == 'E'
        cFilAtu := ::GetOriginalBranch((cTabMov)->(Recno()), cTabMov, AnalyticalMovementTable():tableName())
    EndIf

    If Select(cTabSldOP) <= 0
        ::UseArea(cTabSldOP, ::TableIndexes())
    EndIf

    (cTabSldOP)->(DbSetOrder(1)) //FILPROC+FILIAL+OP
    (cTabSldOP)->(DbSeek(::cFProc+cFilAtu+cOP))
	nQtdTot     := (cTabSldOP)->QTDORIG
    nQtdJaEnt   := (cTabSldOP)->QTDJAENT
    nPerdaOP    := (cTabSldOP)->PERDAOP
    dDataRF     := (cTabSldOP)->DATRF
    nQtdMov     := (cTabSldOP)->QTDMOV
    nPerdaMov   := (cTabSldOP)->PERDAMOV
    nCustoFinal := (cTabSldOP)->VFIM1

    If lParcial
        If ::nProdPR0 == 1
            ::nProporcao := (nQtdAp + nQtdPerda) / (((cTabSldOP)->QTDTOTAL + (cTabSldOP)->TOTALPERDA) - (cTabSldOP)->QTDAPONT)
        ElseIf ::nProdPR0 == 2 .Or. ::nProdPR0 == 3
            //Verifica se a ordem de produção foi encerrada parcialmente no perÃ­odo
			lOPEncParc := ::nProdPR0 == 3 .And. (!Empty(dDataRF) .And. dDataRF <= dDtFim) .And. nQtdJaEnt > 0 .And. (nQtdJaEnt + nPerdaOP) < nQtdTot

            If QtdComp((cTabSldOP)->APRFIM1) > QtdComp(0) .And. !lOPEncParc
				::nProporcao := 1-((cTabSldOP)->APRFIM1 / (nCustoFinal + (cTabSldOP)->APRFIM1))
                If ::nProdPR0 == 2
                    ::nProporcao := (nRateio / 100) / ::nProporcao
                Else
                    ::nProporcao := (nQtdAp + nQtdPerda ) / MAX(nQtdTot,nQtdJaEnt) / ::nProporcao
                EndIf
            Else
				If !lOPEncParc
                    If ::nProdPR0 == 2
                        ::nProporcao := (nRateio / 100)
                    Else
                        ::nProporcao := (nQtdAp + nQtdPerda ) / MAX(nQtdTot,nQtdJaEnt)
                    EndIf
                Else
					::nProporcao := (nQtdAp + nQtdPerda) / ((nQtdMov + nPerdaMov) - ((cTabSldOP)->(QTDTOTAL) + (cTabSldOP)->(TOTALPERDA)))
				EndIf
			EndIf

            If lOPEncParc
				Reclock(cTabSldOP,.F.)
				Replace QTDTOTAL   With (cTabSldOP)->(QTDTOTAL) + nQtdAp
				Replace TOTALPERDA With (cTabSldOP)->(TOTALPERDA) + nQtdPerda
				(cTabSldOP)->(MsUnlock())
			EndIf
        EndIf
    Else
        ::nProporcao := 1
    EndIf

    If lParcial
        ::nProporcao := Min(1,::nProporcao)
        aCusto[01] := ::nProporcao * nCustoFinal
    Else
        aCusto[1] := nCustoFinal
    EndIf

    For nX := 1 to Len(::aMoedas)
        If lParcial
            aCusto[nX] := ::nProporcao * (cTabSldOP)->&("VFIM"+::aMoedas[nX])
        Else
            aCusto[nX] := (cTabSldOP)->&("VFIM"+::aMoedas[nX])
        EndIf
    Next nX

    ::balanceUpdaterByEntry(cFilAtu,cTabSldOP,cOP,nQtdAp,nQtdPerda,aCusto)

Return aCusto

/*/{Protheus.doc} finalBalanceUpdater
    Atualiza o saldo final das ordens de produções na SC2
    @author Squad Entradas
    @since 30/10/2024
/*/
Method finalBalanceUpdater(cFilAtu) Class BalanceByProductionOrder
    local nX            as integer
    local cTabSC2       := RetSqlName("SC2") as character
    local cFieldsUpd    as character
    local cMatchFilter  as character
    local cQryStatement as character
    Local cCteStatement as Character

    //Monta os campos que serao atualizados no update
    For nX := 1 to Len(::aMoedas)
        If nX > 1
            cFieldsUpd += ","
        EndIf
        cFieldsUpd += " C2_VFIM"+::aMoedas[nX]+" = TEMPTABLE.VFIM"+::aMoedas[nX]
        cFieldsUpd += ",C2_APRFIM"+::aMoedas[nX]+" = TEMPTABLE.APRFIM"+::aMoedas[nX]
    Next nX

    cQryStatement := " SELECT SC2RECNO "
    For nX := 1 to Len(::aMoedas)
        cQryStatement += ",SUM(TRM.VFIM"+::aMoedas[nX]+") VFIM"+::aMoedas[nX]+",SUM(TRM.APRFIM"+::aMoedas[nX]+") APRFIM"+::aMoedas[nX]
    Next nX
    cQryStatement += " FROM "+::tableName()+" TRM "
    cQryStatement += " WHERE FILPROC = '" + ::cFProc + "' AND "
    cQryStatement += " FILIAL  = '" + cFilAtu + "' "
    cQryStatement += " GROUP BY SC2RECNO "

    cMatchFilter := " "+cTabSC2+".R_E_C_N_O_ = TEMPTABLE.SC2RECNO "

    cCteStatement := ::buildCteStatement(cTabSC2,cFieldsUpd,cMatchFilter,cQryStatement)

    ::RunQuery(cCteStatement)

Return

/*/{Protheus.doc} productionEntryTotalizer
    Totaliza os apontamentos de produção, independente do armazem
    @author Squad Entradas
    @since 30/10/2024
/*/
Method productionEntryTotalizer(cTabSldOP) Class BalanceByProductionOrder
    local cFieldsUpd    as character
    local cMatchFilter  as character
    local cQryStatement as character
    Local cCteStatement as Character

    If ::nProdPR0 == 1
        cFieldsUpd := " QTDTOTAL   = TEMPTABLE.QTDMOV, "
        cFieldsUpd += " TOTALPERDA = TEMPTABLE.PERDAMOV "

        cQryStatement := " SELECT FILPROC, FILIAL, OP, "
        cQryStatement += " SUM(QTDMOV) QTDMOV, SUM(PERDAMOV) PERDAMOV "
        cQryStatement += " FROM " + cTabSldOP + " TRM "
        cQryStatement += " GROUP BY FILPROC, FILIAL, OP "

        cMatchFilter := " "+cTabSldOP+".FILPROC = TEMPTABLE.FILPROC And "
        cMatchFilter += " "+cTabSldOP+".FILIAL  = TEMPTABLE.FILIAL  And "
        cMatchFilter += " "+cTabSldOP+".OP      = TEMPTABLE.OP "

        cCteStatement := ::buildCteStatement(cTabSldOP,cFieldsUpd,cMatchFilter,cQryStatement)

        ::RunQuery(cCteStatement)
    EndIf
Return

/*/{Protheus.doc} balanceUpdaterByEntry
    Atualiza os saldos finais do apontamento da produçao
    @author Squad Entradas
    @since 30/10/2024
/*/
Method balanceUpdaterByEntry(cFilAtu,cTabSldOP,cOP,nQtdAp,nQtdPerda,aCusto) Class BalanceByProductionOrder
    Local nX             as integer
    Local cQuery         as character

    cQuery := " UPDATE " + cTabSldOP + " SET QTDAPONT = " + cValToChar((cTabSldOP)->QTDAPONT + (nQtdAp + nQtdPerda))
    
    For nX := 1 to Len(::aMoedas)
        cQuery += " ,APRFIM" + ::aMoedas[nX] + " = " + cValToChar((cTabSldOP)->&("APRFIM"+::aMoedas[nX]) + aCusto[nX])
        cQuery += " ,VFIM" + ::aMoedas[nX] + " = " + cValToChar((cTabSldOP)->&("VFIM"+::aMoedas[nX]) - aCusto[nX])
    Next nX
    
    cQuery += " WHERE "
    cQuery += " FILPROC = '" + ::cFProc + "' AND "
    cQuery += " FILIAL  = '" + cFilAtu + "' AND "
    cQuery += " OP = '" + cOP + "' "

    ::RunQuery(cQuery)

Return

/*/{Protheus.doc} existsProductionOrder
    Retorna a existência de registros na tabela TRM
    @author Squad Entradas
    @since 30/10/2024
/*/
Method existsProductionOrder(cFilAtu,cTabMov) Class BalanceByProductionOrder
    local lRet   as logical
    Local nBind  As Integer

    If ::oQryExist == Nil
        cQuery := " SELECT COUNT(1) CNT " 
        cQuery += " FROM " + cTabMov
        cQuery += " WHERE "
        cQuery += " FILPROC = ? "
        If ::cCusFil != 'E'
            cQuery += " AND FILIAL = ? "
        EndIf
        cQuery := ChangeQuery(cQuery)

        ::oQryExist := FWExecStatement():New(cQuery)
    EndIf

    nBind := 1
    ::oQryExist:SetString(nBind++, ::cFProc)
    If ::cCusFil != 'E'
        ::oQryExist:SetString(nBind++, cFilAtu)
    EndIf

    lRet := ::oQryExist:ExecScalar('CNT') > 0

Return lRet

/*/{Protheus.doc} retSizeFieldsSC2
    Retorna o tamanho dos campos de ordem de produção na SC2
    @author Squad Entradas
    @since 30/10/2024
/*/
Method retSizeFieldsSC2() Class BalanceByProductionOrder
    local cNumOP   as character
    local cItemOP  as character
    local cSeqOP   as character
    local cItGrdOP as character
    local cSubs    as character
    local nNumOP   := TamSX3("C2_NUM")[1]     as numeric
    local nItemOP  := TamSX3("C2_ITEM")[1]    as numeric
    local nSeqOP   := TamSX3("C2_SEQUEN")[1]  as numeric
    local nItGrdOP := TamSX3("C2_ITEMGRD")[1] as numeric

    If ::lOracle
        cSubs := "SUBSTR"
    Else
        cSubs := "SUBSTRING"
    EndIf

    cNumOP   := cSubs + "(TRG.OP,1," + cValToChar(nNumOP) + ")"
    cItemOP  := cSubs + "(TRG.OP," + cValToChar(nNumOP + 1) + "," + cValToChar(nItemOP) + ")"
    cSeqOP   := cSubs + "(TRG.OP," + cValToChar(nNumOP + nItemOP + 1) + "," + cValToChar(nSeqOP) + ")"
    cItGrdOP := cSubs + "(TRG.OP," + cValToChar(nNumOP + nItemOP + nSeqOP + 1) + "," + cValToChar(nItGrdOP) + ")"

Return {cNumOP,cItemOP,cSeqOP,cItGrdOP}


/*/{Protheus.doc} GetOriginalBranch
    Retorna a filial original do movimento PR0 quando o custo é unificado
    por empresa
    @author Squad Entradas
    @since 28/11/2024
    /*/
Method GetOriginalBranch(nRecAgl, cTabAgl, cTabAnl) Class BalanceByProductionOrder
    Local cQuery := ""

    If ::oQryOrigBranch == Nil
        cQuery := " Select "
        cQuery += " ANL.FILIAL FILIAL "
        cQuery += " From "+cTabAnl+" ANL"
        cQuery += " Inner Join "+cTabAgl+" AGL "
        cQuery += " On "
        cQuery += " AGL.FILPROC = ANL.FILPROC And "
        cQuery += " AGL.CHVAGL  = ANL.CHVAGL "
        cQuery += " Where "
        cQuery += " AGL.R_E_C_N_O_ = ? "
        cQuery += " Group By "
        cQuery += " ANL.FILIAL "
        cQuery := ChangeQuery(cQuery)

        ::oQryOrigBranch := FWExecStatement():New(cQuery)
    EndIf

    ::oQryOrigBranch:SetNumeric(1, nRecAgl)

    cFilOrig := ::oQryOrigBranch:ExecScalar('FILIAL')

Return cFilOrig

/*/{Protheus.doc} retQueryRE5
    Retorna a query responsavel por filtrar os movimentos RE5
    por empresa
    @author Squad Entradas
    @since 28/11/2024
/*/
Method retQueryRE5() Class BalanceByProductionOrder
    local cQuery as character
    local cCusto as character
    local oQuery as object
    local nX     as integer
    local nY     := 1 as integer

    For nX := 1 to Len(::aMoedas) 
        cCusto += "SUM(CUSTO"+::aMoedas[nX]+") CUSTO"+::aMoedas[nX]+","
    Next nX
    cCusto := SubStr(cCusto, 1, Len(cCusto)-1)

    cQuery := " SELECT FILIAL,OP,"+cCusto
    cQuery += " FROM " + AnalyticalMovementTable():tableName() + " TRG "
    cQuery += " WHERE FILPROC = ? "
    cQuery += " AND CF = ? "
    cQuery += " GROUP BY FILPROC, FILIAL, OP "

    oQuery := FWExecStatement():New(cQuery)

    oQuery:SetString(nY++,::cFProc)
    oQuery:SetString(nY++,'RE5')

    cQuery := oQuery:GetFixQuery()

Return cQuery
