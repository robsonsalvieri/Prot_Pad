#Include 'totvs.ch'
#Include 'tlpp-core.th'

using namespace totvs.protheus.backoffice.stock.iterativecost.table.manager
Using namespace totvs.protheus.backoffice.stock.iterativecost.view.laborproduct
Using Namespace totvs.protheus.backoffice.stock.iterativecost.view.laborrequests
Using Namespace totvs.protheus.backoffice.stock.iterativecost.table.analyticalmovementtable
Using Namespace totvs.protheus.backoffice.stock.iterativecost.table.laborbycostcenter
Using Namespace totvs.protheus.backoffice.stock.iterativecost.table.processingtable
Using Namespace totvs.protheus.backoffice.stock.iterativecost.accounting.laborproductvalue
Using Namespace totvs.protheus.backoffice.stock.iterativecost.table.parts.laborbycostcenterparts
Using Namespace totvs.protheus.backoffice.stock.iterativecost.table.parts.processingtable
Using Namespace totvs.protheus.backoffice.stock.iterativecost.view.parts.laborrequests

namespace totvs.protheus.backoffice.stock.iterativecost.accounting.parts.laborproductpartsvalue


/*/{Protheus.doc} LaborProductPartsValue
    Classe responsável pela integração do custo do centro de custos para os produtos MOD
    @type Class
    @author Squad Entradas
    @since 28/04/2025
    @version 1
    /*/
Class LaborProductPartsValue From LaborProductValue
    public method new()

    public method UpdProcTableCostCenterAvgCost()

    Private Method SelectCostByProductBySD3()
    Private Method SelectCostByProductBySB2()
    Private Method RetCostBelow()

    Public Data cAssProc26 As Character
    Public Data cCTB250    As Character
    Public Data oCTB250    As Object
    Public Data lCTB250    As Logical
    Public Data oTabCCP    As Object
    Public Data oQryUpdD3  As Object
    Public Data oQryUpdB2  As Object
    Public Data oQryZera   As Object
    Public Data cCusFil    As Character
    Public Data lOracle    As Logical
    Public Data jParams    As Json

    Private Data aQryCost  As Array

EndClass

/*/{Protheus.doc} New
    Instância da classe
    @type Method
    @author Squad Entradas
    @since 28/04/2025
/*/
Method New(oTabCC, jParams) Class LaborProductPartsValue

    _Super:New(oTabCC, jParams)
    ::InstallProc()
    ::oTabCCP  := oTabCC
    ::lOracle := ::oTabCCP:lOracle
    ::cCusFil  := SuperGetMv("MV_CUSFIL", .F., "A")
    ::oQryUpdD3 := Nil

    ::cAssProc26 := EngSPS26Signature("26")

    ::cCTB250 := "CTB250"
    If FindFunction("GetSPName")
        ::cCTB250   := GetSPName("CTB250","26")
    EndIf
    ::oCTB250   := EngSPSStatus('26', cEmpAnt)
    ::lCTB250   := ::oCTB250['signature'] == ::cAssProc26
    ::jParams   := jParams

    ::aQryCost  := {}

    
Return Self

/*/{Protheus.doc} UpdProcTableCostCenterAvgCost
    Atualiza o custo médio dos produtos MOD na tabela de processamento
    @type Method
    Parâmetro:
    Calcula MOD?
        1-Sim --> Busca o custo do centro de custo na CT2
        2-Não --> Busca o custo da tabela SB2
    @author Squad Entradas
    @since 30/10/2024
    /*/
Method UpdProcTableCostCenterAvgCost(cFilProc, dDtIni, dDtFim, aFiliais) Class LaborProductPartsValue
    Local cQuery      As Character
    Local nMoeda      As Numeric
    Local nFil        As Numeric
    Local cTabProc     As Character
    Local cTabProcCP    As Character
    Local cAlTRCCP    As Character
    Local cTabCC     As Character
    Local cTabCCCP    As Character
    Local cUpdate     As Character
    Local cMoeda      As Character
    Local cNull       As Character
    Local nPercInc    As Numeric
    Local cFilAtu     As Character
    Local nTamConta   As Numeric
    Local aMatch   := {} As Array
    Local aUpdate  := {} As Array
    Local aCpoDest := {} As Array
    Local aInsert  := {} As Array
    Local cMerge   := "" As Character
    Local cItemC      As Character
    Local cClVlr      As Character
    Local cGrupo      As Character
    Local cCodCC      As Character
    Local cCTBIni     As Character
    Local cCTBFim     As Character
    Local cCodPar     As Character
    Local cRevis      As Character
    Local cOutros     As Character
    Local cViewSB1MOD
    Local nCusto      As Numeric
    Local nCstAprop   As Numeric
    Local oQryLoop    As Object
    Local nCalcula    As Integer
    
    cNull := MatIsNull()

    cTabProc   := ProcessingTable():TableName()
    cTabProcCP := PartsProcessingTable():TableName()
    nTamConta  := TamSX3('CT1_CONTA')[1]
    nPercInc   := 100+::jParams["percmod"]
    cCTBIni    := ::jParams["contini"]
    cCTBFim    := ::jParams["contfin"]
    cRevis     := ::jParams["revisao_vigente"]
    cOutros    := Replicate('9', TamSX3('D4G_CODPAR')[1])
    nCalcula   := ::jParams["calcmod"]

    D4D->(DbSetOrder(1)) //D4D_FILIAL+D4D_IDVIEW
    If D4D->(DbSeek(FWXFilial('D4D')+ViewLaborProduct():GetViewID()))
        cViewSB1MOD := D4D->D4D_VWNAME
    EndIf

    If nCalcula == 1
        //Pega o custo do centro de custo para a tabela de saldos por CC
        cTabCCCP := LaborByCostCenterParts():TableName()
        cTabCC  := LaborByCostCenter():TableName()
        TableManager():UseArea(cTabCCCP, LaborByCostCenterParts():tableIndexes())

        cQuery := " Select FILPROC, FILIAL, CCUSTO, GCC, ITEMC, CLVLR, CODPAR, MOEDA, "
        cQuery += " R_E_C_N_O_ REC "
        cQuery += " From "+cTabCCCP
        cQuery += " Where "
        cQuery += " FILPROC = ? "
        cQuery += " Order By "
        cQuery += " FILPROC Desc, "
        cQuery += " FILIAL  Desc, "
        cQuery += " CCUSTO  Desc, "
        cQuery += " GCC     Desc, "
        cQuery += " ITEMC   Desc, "
        cQuery += " CLVLR   Desc, "
        cQuery += " CODPAR      , " //Se houver duas partes iguais, a prioridade é a menor
        cQuery += " MOEDA   Desc "
        cQuery := ChangeQuery(cQuery)

        oQryLoop := FWExecStatement():New(cQuery)

        oQryLoop:SetString(1, cFilProc)

        cAlTRCCP := oQryLoop:OpenAlias()

        //(cAlTRCCP)->(DbSetOrder(1)) //FILPROC+FILIAL+CCUSTO+GCC+ITEMC+CLVLR+CODPAR+MOEDA
        //(cAlTRCCP)->(DbSeek(cFilProc))
        While !(cAlTRCCP)->(EoF()) //.And. (cAlTRCCP)->FILPROC == cFilProc
            cFilAtu := (cAlTRCCP)->FILIAL
            cCodCC  := (cAlTRCCP)->CCUSTO
            cGrupo  := (cAlTRCCP)->GCC
            cItemC  := (cAlTRCCP)->ITEMC
            cClVlr  := (cAlTRCCP)->CLVLR
            cCodPar := (cAlTRCCP)->CODPAR
            
            aSaldos := ::GetValueByCostCenter(cFilAtu, cCodCC, dDtIni, dDtFim, cGrupo, cCTBIni, cCTBFim, , cItemC, cClVlr)

            While !(cAlTRCCP)->(EoF()) .And.;
            (cAlTRCCP)->(FILPROC+FILIAL+CCUSTO+GCC+ITEMC+CLVLR+CODPAR) == ;
            cFilProc+cFilAtu+cCodCC+cGrupo+cItemC+cClVlr+cCodPar
                cMoeda := (cAlTRCCP)->(MOEDA)
                nMoeda := Val(cMoeda)
                nCusto := aSaldos[nMoeda] * (nPercInc/100)
                nCstAprop := ::RetCostBelow(cTabCCCP, cFilProc, cFilAtu, cCodCC, cGrupo, cItemC, cClVlr, cMoeda)

                (cTabCCCP)->(DbGoto((cAlTRCCP)->REC))
                RecLock(cTabCCCP, .F.)
                (cTabCCCP)->CUSTO := nCusto - nCstAprop
                (cTabCCCP)->(MsUnlock())

                (cAlTRCCP)->(DbSkip())
            EndDo
            //(cAlTRCCP)->(DbSkip())
        EndDo
        (cAlTRCCP)->(DbCloseArea())

        For nFil := 1 To Len(::oTabCCP:aFilProc)
            cFilAtu := ::oTabCCP:aFilProc[nFil, 1]
            cQuery := ::SelectCostByProductBySD3(cFilProc, cFilAtu, dDtIni, dDtFim, cRevis)

            //Filtro
            ASize(aMatch, 0)
            aMatch := {}
            AAdd(aMatch, {"FILPROC", "FILPROC"})
            AAdd(aMatch, {"FILIAL", "FILIAL"})
            AAdd(aMatch, {"COD", "COD"})
            If ::cCusFil == 'A'
                AAdd(aMatch, {"ARMAZEM", "ARMAZEM"})
            EndIf
            AAdd(aMatch, {"CODPAR", "CODPAR"})
            AAdd(aMatch, {"MOEDA", "MOEDA"})

            //Expressões de update
            ASize(aUpdate, 0)
            aUpdate := {}
            AAdd(aUpdate, "QTDHIST = Destino.QTDHIST + Origem.QUANT")
            AAdd(aUpdate, "QTDPROC = Destino.QTDPROC + Origem.QUANT")
            AAdd(aUpdate, "CSTHIST = Destino.CSTHIST + Origem.CUSTO")
            AAdd(aUpdate, "CSTPROC = Destino.CSTPROC + Origem.CUSTO")
            cUpdate := "CMHIST = "
            cUpdate += " Case "
            cUpdate += " When (Destino.QTDHIST + Origem.QUANT) > 0 "
            cUpdate += "    Then "
            cUpdate += "   ((Destino.CSTHIST + Origem.CUSTO)"
            cUpdate += "   / "
            cUpdate += "   (Destino.QTDHIST + Origem.QUANT))"
            cUpdate += "   Else Destino.CMHIST "
            cUpdate += " End "
            AAdd(aUpdate, cUpdate)
            cUpdate := "CMPROC = "
            cUpdate += " Case "
            cUpdate += " When (Destino.QTDPROC + Origem.QUANT) > 0 "
            cUpdate += "    Then "
            cUpdate += "   ((Destino.CSTPROC + Origem.CUSTO)"
            cUpdate += "   / "
            cUpdate += "   (Destino.QTDPROC + Origem.QUANT))"
            cUpdate += "   Else Destino.CMPROC "
            cUpdate += " End "
            AAdd(aUpdate, cUpdate)
            
            //Expressões de insert
            ASize(aCpoDest, 0)
            aCpoDest := {}
            AAdd(aCpoDest, "FILPROC")
            AAdd(aCpoDest, "FILIAL")
            AAdd(aCpoDest, "COD")
            If ::cCusFil == 'A'
                AAdd(aCpoDest, "ARMAZEM")
            EndIf
            AAdd(aCpoDest, "CODPAR")
            AAdd(aCpoDest, "MOEDA")
            AAdd(aCpoDest, "QTDHIST")
            AAdd(aCpoDest, "QTDPROC")
            AAdd(aCpoDest, "CSTHIST")
            AAdd(aCpoDest, "CSTPROC")
            AAdd(aCpoDest, "CMHIST")
            AAdd(aCpoDest, "CMPROC")
            
            ASize(aInsert, 0)
            aInsert := {}
            AAdd(aInsert, "Origem.FILPROC")
            AAdd(aInsert, "Origem.FILIAL")
            AAdd(aInsert, "Origem.COD")
            If ::cCusFil == 'A'
                AAdd(aInsert, "Origem.ARMAZEM")
            EndIf
            AAdd(aInsert, "Origem.CODPAR")
            AAdd(aInsert, "Origem.MOEDA")
            AAdd(aInsert, "Origem.QUANT")
            AAdd(aInsert, "Origem.QUANT")
            AAdd(aInsert, "Origem.CUSTO")
            AAdd(aInsert, "Origem.CUSTO")
            cInsert := "Case "
            cInsert += "When Origem.QUANT > 0 "
            cInsert += "Then (Origem.CUSTO / Origem.QUANT ) "
            cInsert += "Else 0 "
            cInsert += "End "
            AAdd(aInsert, cInsert)
            AAdd(aInsert, cInsert)
            
            cMerge := ::oTabCCP:MergeStatement(cTabProcCP, cQuery, aMatch, aUpdate, aCpoDest, aInsert)

            ::oTabCCP:RunQuery(cMerge)

        Next nFil

        //Zera saldo de quantidade/custo de MOD
        For nFil := 1 To Len(::oTabCCP:aFilProc)
            cFilAtu := ::oTabCCP:aFilProc[nFil, 1]
            
            If ::oQryZera == Nil
                cQuery := " Select "
                cQuery += " PRC.FILPROC, "
                cQuery += " PRC.FILIAL, "
                cQuery += " PRC.COD, "
                cQuery += " PRC.ARMAZEM, "
                cQuery += " PRC.CODPAR, "
                cQuery += " PRC.MOEDA "
                cQuery += " From "+cTabProcCP+" PRC "
                cQuery += " Inner Join "+cViewSB1MOD+" SB1 On "
                cQuery += " SB1.B1_FILIAL = ? And "
                cQuery += " SB1.B1_COD    = PRC.COD "
                cQuery := ChangeQuery(cQuery)

                ::oQryZera := FWExecStatement():New(cQuery)
            EndIf

            ::oQryZera:SetString(1, FWXFilial("SB1", cFilAtu))

            cQuery := ::oQryZera:GetFixQuery()

            //Filtro
            ASize(aMatch, 0)
            aMatch := {}
            AAdd(aMatch, {"FILPROC", "FILPROC"})
            AAdd(aMatch, {"FILIAL", "FILIAL"})
            AAdd(aMatch, {"COD", "COD"})
            AAdd(aMatch, {"ARMAZEM", "ARMAZEM"})
            AAdd(aMatch, {"CODPAR", "CODPAR"})
            AAdd(aMatch, {"MOEDA", "MOEDA"})

            //Expressões de update
            ASize(aUpdate, 0)
            aUpdate := {}
            AAdd(aUpdate, "QTDHIST = 0")
            AAdd(aUpdate, "QTDPROC = 0")
            AAdd(aUpdate, "CSTHIST = 0")
            AAdd(aUpdate, "CSTPROC = 0")
            
            //Expressões de insert
            ASize(aCpoDest, 0)
            aCpoDest := {}
            AAdd(aCpoDest, "FILPROC")
            AAdd(aCpoDest, "FILIAL")
            AAdd(aCpoDest, "COD")
            AAdd(aCpoDest, "ARMAZEM")
            AAdd(aCpoDest, "CODPAR")
            AAdd(aCpoDest, "MOEDA")
            AAdd(aCpoDest, "QTDHIST")
            AAdd(aCpoDest, "QTDPROC")
            AAdd(aCpoDest, "CSTHIST")
            AAdd(aCpoDest, "CSTPROC")
            
            ASize(aInsert, 0)
            aInsert := {}
            AAdd(aInsert, "Origem.FILPROC")
            AAdd(aInsert, "Origem.FILIAL")
            AAdd(aInsert, "Origem.COD")
            AAdd(aInsert, "Origem.ARMAZEM")
            AAdd(aInsert, "Origem.CODPAR")
            AAdd(aInsert, "Origem.MOEDA")
            AAdd(aInsert, "0")
            AAdd(aInsert, "0")
            AAdd(aInsert, "0")
            AAdd(aInsert, "0")
            
            cMerge := ::oTabCCP:MergeStatement(cTabProcCP, cQuery, aMatch, aUpdate, aCpoDest, aInsert)

            ::oTabCCP:RunQuery(cMerge)

        Next nFil
        Else
        //Expressões de update
        ASize(aUpdate, 0)
        aUpdate := {}
        AAdd(aUpdate, "CMPROC = ORIGEM.CMPROC")

        //Filtro do Update
        AAdd(aMatch, {"FILPROC", "FILPROC"})
        AAdd(aMatch, {"FILIAL" , "FILIAL"})
        AAdd(aMatch, {"COD"    , "COD"})
        AAdd(aMatch, {"ARMAZEM", "ARMAZEM"})
        AAdd(aMatch, {"CODPAR" , "CODPAR"})
        AAdd(aMatch, {"MOEDA"  , "MOEDA"})

        //Conteúdo dos campos
        AAdd(aInsert, "Origem.FILPROC")
        AAdd(aInsert, "Origem.FILIAL")
        AAdd(aInsert, "Origem.COD")
        AAdd(aInsert, "Origem.ARMAZEM")
        AAdd(aInsert, "Origem.CODPAR")
        AAdd(aInsert, "Origem.MOEDA")
        AAdd(aInsert, "Origem.CMPROC")

        //Campos que receberão valor
        AAdd(aCpoDest, "FILPROC")
        AAdd(aCpoDest, "FILIAL")
        AAdd(aCpoDest, "COD")
        AAdd(aCpoDest, "ARMAZEM")
        AAdd(aCpoDest, "CODPAR")
        AAdd(aCpoDest, "MOEDA")
        AAdd(aCpoDest, "CMPROC")

        For nFil := 1 to Len(aFiliais)
            For nMoeda := 1 To Len(::jParams['moedas'])
                cFilAtu := aFiliais[nFil]
                cQuery := ::SelectCostByProductBySB2(cFilProc, cFilAtu, cRevis, cTabProc, ::jParams['moedas'][nMoeda])
            
                cMerge := ::oTabCCP:MergeStatement(cTabProcCP, cQuery , aMatch, aUpdate, aCpoDest, aInsert)

                //Executa o merge
                ::oTabCCP:RunQuery(cMerge)
            Next nMoeda
        Next nFil
    EndIf
Return

/*/{Protheus.doc} SelectCostByProductBySD3
    Monta o select para pegar o custo por produto MOD com base na SD3
    @type Method
    @author Squad Entradas
    @since 30/10/2024
    /*/
Method SelectCostByProductBySD3(cFilProc, cFilAtu, dDtIni, dDtFim, cRevis) Class LaborProductPartsValue
    Local cQuery      As Character
    Local cViewSD3MOD As Character
    Local nBind       As Numeric

    D4D->(DbSetOrder(1)) //D4D_FILIAL+D4D_IDVIEW
    If D4D->(DbSeek(FWXFilial('D4D')+ViewLaborRequestsParts():GetViewID()))
        cViewSD3MOD := D4D->D4D_VWNAME
    EndIf

    If ::oQryUpdD3 == Nil
        cQuery := " Select "
        cQuery += " TRCC.FILPROC FILPROC, "
        If ::cCusFil != 'E'
            cQuery += " TRCC.FILIAL FILIAL, "
        Else
            cQuery += " Cast('"+PadR(FWCompany(), FWSizeFilial())+"' As"
            cQuery += " Char("+cValToChar(FWSizeFilial())+")) FILIAL, "
        EndIf
        cQuery += " SD3.D3_COD COD, "
        If ::cCusFil == 'A'
            cQuery += ' SD3.D3_LOCAL ARMAZEM, '
        EndIf
        cQuery += " TRCC.CODPAR CODPAR, "
        cQuery += " TRCC.MOEDA  MOEDA, "
        cQuery += " Abs(Sum(SD3.D3_QUANT)) QUANT, "
        cQuery += " Sum(SD3.D3_QUANT * (TRCC.CUSTO / TRCC.QUANT)) CUSTO,"
        cQuery := SubStr(cQuery, 1, Len(cQuery)-1)
        cQuery += " From "+cViewSD3MOD+" SD3 "
        cQuery += " Inner Join "+::oTabCCP:TableName()+" TRCC On "
        cQuery += " TRCC.FILPROC = ? And "
        cQuery += " TRCC.FILIAL = SD3.D3_FILIAL   And "
        cQuery += " TRCC.CCUSTO = SD3.B1_CCCUSTO  And "
        cQuery += " TRCC.GCC    = SD3.B1_GCCUSTO  And "
        cQuery += " TRCC.CODPAR = SD3.D4G_CODPAR  And "
        cQuery += " TRCC.QUANT <> ? "
        cQuery += " Where "
        cQuery += " SD3.D3_FILIAL   = ? And "
        cQuery += " SD3.D3_EMISSAO >= ? And "
        cQuery += " SD3.D3_EMISSAO <= ? And "
        cQuery += " (SD3.D4G_REVIS   = ? Or "
        cQuery += " SD3.D4G_REVIS    = ? )"
        If  FWModeAccess("SB1", 1) != FWModeAccess("SD3", 1) .Or. ;
            FWModeAccess("SB1", 2) != FWModeAccess("SD3", 2) .Or. ;
            FWModeAccess("SB1", 3) != FWModeAccess("SD3", 3)
            cQuery += " And SD3.B1_FILIAL = ? "
        EndIf
        cQuery += " Group By "
        cQuery += " TRCC.FILPROC, "
        If ::cCusFil != 'E'
            cQuery += " TRCC.FILIAL, "
        EndIf
        cQuery += " SD3.D3_COD"
        If ::cCusFil == 'A'
            cQuery += ' ,SD3.D3_LOCAL '
        EndIf
        cQuery += " ,TRCC.CODPAR, "
        cQuery += " TRCC.MOEDA "
        cQuery := ChangeQuery(cQuery)

        ::oQryUpdD3 := FWExecStatement():New(cQuery)
    EndIf

    nBind := 1
    ::oQryUpdD3:SetString(nBind++, cFilProc) //TRCC.FILPROC
    ::oQryUpdD3:SetNumeric(nBind++, 0) //TRCC.QUANT
    ::oQryUpdD3:SetString(nBind++, FWXFilial('SD3', cFilAtu)) //SD3.D3_FILIAL
    ::oQryUpdD3:SetString(nBind++, DToS(dDtIni)) //D3_EMISSAO
    ::oQryUpdD3:SetString(nBind++, DToS(dDtFim)) //D3_EMISSAO
    ::oQryUpdD3:SetString(nBind++, cRevis) //D4G_REVIS
    ::oQryUpdD3:SetString(nBind++, Space(Len(cRevis))) //D4G_REVIS
    If  FWModeAccess("SB1", 1) != FWModeAccess("SD3", 1) .Or. ;
        FWModeAccess("SB1", 2) != FWModeAccess("SD3", 2) .Or. ;
        FWModeAccess("SB1", 3) != FWModeAccess("SD3", 3)
        ::oQryUpdD3:SetString(nBind++, FWXFilial('SB1', cFilAtu))
    EndIf

    cQuery := ::oQryUpdD3:GetFixQuery()
Return cQuery

/*/{Protheus.doc} SelectCostByProductBySB2
    Monta o select para pegar o custo em partes do produt MOD
    @type Method
    @author Squad Entradas
    @since 30/10/2024
    /*/
Method SelectCostByProductBySB2(cFilProc, cFilAtu, cRevis, cTabProc, cMoeda) Class LaborProductPartsValue
    Local cQuery      as character
    Local cViewSB1MOD as character
    Local cCoalesce   := MatIsNull()

    D4D->(DbSetOrder(1)) //D4D_FILIAL+D4D_IDVIEW
    If D4D->(DbSeek(FWXFilial('D4D')+ViewLaborProduct():GetViewID()))
        cViewSB1MOD := D4D->D4D_VWNAME
    EndIf

    If ::oQryUpdB2 == Nil
        cQuery := " SELECT TRH.FILPROC,TRH.FILIAL,TRH.COD,TRH.ARMAZEM, "
        cQuery += cCoalesce+"(D4G.D4G_CODPAR,'99') CODPAR, "
        cQuery += " ? MOEDA, TRH.CMPROC? CMPROC "
        cQuery += " FROM "+cTabProc+" TRH "
        cQuery += " INNER JOIN "+cViewSB1MOD+" SB1 ON "
        cQuery += " SB1.B1_FILIAL = ? AND "
        cQuery += " SB1.B1_COD = TRH.COD "
        cQuery += " LEFT JOIN "+RetSQLName('D4G')+" D4G ON "
        cQuery += " D4G.D4G_FILIAL = ? AND "
        cQuery += " D4G.D4G_PRODUT = TRH.COD AND "
        cQuery += " D4G.D4G_REVIS = ? AND "
        cQuery += " D4G.D_E_L_E_T_ = ? "
        cQuery += " WHERE TRH.FILPROC  = ? AND "
        cQuery += " TRH.FILIAL = ? "
        
        cQuery := ChangeQuery(cQuery)

        ::oQryUpdB2 := FWExecStatement():New(cQuery)
    EndIf

    ::oQryUpdB2:SetString(1, StrZero(Val(cMoeda),2))
    ::oQryUpdB2:SetUnsafe(2, cMoeda)
    ::oQryUpdB2:SetString(3, FWxFilial("SB1",cFilAtu))
    ::oQryUpdB2:SetString(4, FWxFilial("D4G",cFilAtu))
    ::oQryUpdB2:SetString(5, cRevis)
    ::oQryUpdB2:SetString(6, ' ')
    ::oQryUpdB2:SetString(7, cFilProc)
    ::oQryUpdB2:SetString(8, cFilAtu)

    cQuery := ::oQryUpdB2:GetFixQuery()

Return cQuery


/*/{Protheus.doc} RetCostBelow
    Retorna o custo já processado das entidades contábeis abaixo da entidade informada
    @author Squad Entradas
    @since 06/05/2025
    @Type Method
    /*/
Method RetCostBelow(cTabCCCP, cFilProc, cFilAtu, cCodCC, cGrupo, cItemC, cClVlr, cMoeda) Class LaborProductPartsValue
    Local cQuery As Character
    Local nCusto As Numeric
    Local cMD5   As Character
    Local nPos   As Integer
    Local nBind  As Integer

    cQuery := " Select "
    cQuery += " Sum(CUSTO) CUSTO "
    cQuery += " From "+cTabCCCP
    cQuery += " Where "
    cQuery += "     FILPROC = ? "
    cQuery += " And FILIAL  = ? "
    cQuery += " And CCUSTO  = ? "
    If !Empty(cGrupo)
        cQuery += " And GCC = ? "
    EndIf
    If !Empty(cItemC)
        cQuery += " And ITEMC = ? "
    EndIf
    If !Empty(cClVlr)
        cQuery += " And CLVLR = ? "
    EndIf
    If Empty(cClVlr) 
        cQuery += " And CODPAR <> ? "
    EndIf
    cQuery += " And MOEDA = ? "

    cMD5 := MD5(cQuery)
    If (nPos := ASCan(::aQryCost, {|x| x[2] == cMD5})) == 0
        AAdd(::aQryCost, {FWExecStatement():New(ChangeQuery(cQuery)), cMD5})
        nPos := Len(::aQryCost)
    EndIf

    nBind := 1
    ::aQryCost[nPos, 1]:SetString(nBind++, cFilProc)
    ::aQryCost[nPos, 1]:SetString(nBind++, cFilAtu)
    ::aQryCost[nPos, 1]:SetString(nBind++, cCodCC)
    If !Empty(cGrupo)
        ::aQryCost[nPos, 1]:SetString(nBind++, cGrupo)
    EndIf
    If !Empty(cItemC)
        ::aQryCost[nPos, 1]:SetString(nBind++, cItemC)
    EndIf
    If !Empty(cClVlr)
        ::aQryCost[nPos, 1]:SetString(nBind++, cClVlr)
    EndIf
    //A parte ZZ são todas as combinações possíveis de Item contábil x Classe Valor
    If Empty(cClVlr) 
        ::aQryCost[nPos, 1]:SetString(nBind++, "ZZ")
    EndIf
    ::aQryCost[nPos, 1]:SetString(nBind++, cMoeda)

    nCusto := ::aQryCost[nPos, 1]:ExecScalar('CUSTO')

Return nCusto
