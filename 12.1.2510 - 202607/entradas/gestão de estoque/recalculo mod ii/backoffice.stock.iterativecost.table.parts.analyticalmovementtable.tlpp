#Include 'Totvs.ch'
#include 'tlpp-core.th'

Using namespace totvs.protheus.backoffice.stock.iterativecost.table.manager
Using Namespace totvs.protheus.backoffice.stock.iterativecost.table.processingtable
Using Namespace totvs.protheus.backoffice.stock.iterativecost.table.analyticalmovementtable
Using Namespace totvs.protheus.backoffice.stock.iterativecost.table.parts.processingtable
Using namespace totvs.protheus.backoffice.stock.iterativecost.view.acquisitioncost
Using Namespace totvs.protheus.backoffice.stock.iterativecost.view.transferinvoice
Using Namespace totvs.protheus.backoffice.stock.iterativecost.view.acquisitioncost
Using Namespace totvs.protheus.backoffice.stock.iterativecost.view.parts.acquisitioncost

namespace totvs.protheus.backoffice.stock.iterativecost.table.parts.analyticalmovementtable

/*/{Protheus.doc} AnalyticalMovementPartsTable
    Classe responsável por retornar a estrutura da tabela de mov. analítica (TRG)
    @type Class
    @author Squad Entradas
    @since 27/08/2024
/*/
Class AnalyticalMovementPartsTable From TableManager

    public method New() 

    Static method TableFields()
    Static method TableIndexes()
    Static method TableName()
    Static Method TableUniqueKey()

    Public Method TableManager()
    public method GetPartsCost()
    Public Method InitAvgCost()

    Public Method IgnorePurchaseReturn()
    Public Method IgnoreSalesReturn()

    Public Data   oQueryFixCostMov          As Object
    Public Data   oQueryAvgCostMov          As Object
    Public Data   oQueryPurchRetProc        As Object
    Public Data   oQueryPurchRet            As Object
    Public Data   oQueryPurchRetPrev        As Object
    Public Data   oQueryPurchRetPrevProc    As Object
    Public Data   oQueryOtherInflowRetProc  As Object
    Public Data   oQueryOtherInflowRet      As Object
    Public Data   oQuerySalesRetProc        As Object
    Public Data   oQuerySalesRet            As Object
    Public Data   oQuerySalesRetPrevProc    As Object
    Public Data   oQuerySalesRetPrev        As Object
    Public Data   jVwAcquistCstParams       As Json
    Public Data   jVwAcquistCstPartsParams  As Json
    Public Data   cViewAcquisCst            As Character
    Public Data   cViewAcquisCstParts       As Character
    Public Data   cCusFil                   As Character
    Public Data   jParams                   As Json

endclass

/*/{Protheus.doc} New
    Instância da classe
    @type Method
    @author Squad Entradas
    @since 27/08/2024
/*/
Method New(aFil, jParams) Class AnalyticalMovementPartsTable

    ::oQueryFixCostMov := Nil
    ::jParams  := jParams
    ::cCusFil  := ::jParams["MV_CUSFIL"]

    ::jVwAcquistCstParams := JsonObject():New()
    ::jVwAcquistCstPartsParams := JsonObject():New()

    D4D->(DbSetOrder(1)) //D4D_FILIAL+D4D_IDVIEW
    If D4D->(DbSeek(FWXFilial('D4D')+ViewAcquisitionCost():GetViewID()))
        ::cViewAcquisCst := D4D->D4D_VWNAME
        ::jVwAcquistCstParams:FromJson(D4D->D4D_PARAM)
    EndIf
    If D4D->(DbSeek(FWXFilial('D4D')+ViewPartsAcquisitionCost():GetViewID()))
        ::cViewAcquisCstParts := D4D->D4D_VWNAME
        ::jVwAcquistCstPartsParams:FromJson(D4D->D4D_PARAM)
    EndIf

    _Super:New(aFil)
Return

Method TableManager() Class AnalyticalMovementPartsTable
    _Super:TableManager(::TableName(), ::TableFields(), ::TableIndexes(),,, ::TableUniqueKey())
Return

/*/{Protheus.doc} TableFields
    Campos da tabela de movimentação analítica
    @type Method
    @author Squad Entradas
    @since 27/08/2024
/*/
Method TableFields() Class AnalyticalMovementPartsTable
    Local aFields   := {} as array
    Local nTamRec   := 10 as numeric

    aAdd(aFields, {"RECPAI",    "N" , nTamRec,  0})
    aAdd(aFields, {"FILPROC",   "C" , TamSX3('D3_FILIAL')[1],  0})
    aAdd(aFields, {"FILIAL",    "C" , TamSX3('D3_FILIAL')[1],  0})
    aAdd(aFields, {"CODPAR",    "C" , TamSX3('D4G_CODPAR')[1], 0})
    aAdd(aFields, {"MOEDA",     "C" , TamSX3('D4I_MOEDA')[1], 0})
    aAdd(aFields, {"CUSTO",     "N" , TamSX3('D3_CUSTO1')[1], TamSX3('D3_CUSTO1')[2]})
    aAdd(aFields, {"CSTORI",    "N" , TamSX3('D3_CUSTO1')[1], TamSX3('D3_CUSTO1')[2]})
    aAdd(aFields, {"CSTRECP",   "N" , TamSX3('D3_CUSTO1')[1], TamSX3('D3_CUSTO1')[2]})
    
Return aFields

/*/{Protheus.doc} TableIndexes
    Índices da tabela de movimentação analítica
    @type Method
    @author Squad Entradas
    @since 27/08/2024
/*/
Method TableIndexes() Class AnalyticalMovementPartsTable
    Local aIndex := {} as array
    Local cTable := AnalyticalMovementPartsTable():TableName()

    aAdd(aIndex, {cTable+'_01', 'RECPAI+CODPAR+MOEDA'})
    aAdd(aIndex, {cTable+'_02', 'FILPROC+FILIAL'}) //Index usado para limpeza no inicio do processamento
    aAdd(aIndex, {cTable+'_03', 'RECPAI'})

Return aIndex

/*/{Protheus.doc} TableName
    Retorna o nome da tabela de movimentação analítica
    @type Method
    @author Squad Entradas
    @since 27/08/2024
/*/
Method TableName() Class AnalyticalMovementPartsTable
    Local cAlias as character

    cAlias := "TRGCP"+cEmpAnt+"SP"

Return cAlias

/*/{Protheus.doc} TableUniqueKey
    Retorna a chave única da tabela
    @author Squad Entradas
    @since 05/06/2025
    /*/
Method TableUniqueKey()  Class AnalyticalMovementPartsTable
    Local cUnique As character
    
    cUnique := "RECPAI+CODPAR+MOEDA"
Return cUnique

/*/{Protheus.doc} GetPartsCost
    Inicializa a tabela de movimentações analitica em partes, com movimentos
    que possuem o custo fixo, e terão o custo atribuído a parte vinculada ao produto.
    @author Squad Entradas
    @since 27/08/2024
    @type Method
/*/
Method GetPartsCost(cFilProc) Class AnalyticalMovementPartsTable
    Local cQuery    as character
    Local aBind := {} As Array
    Local nI        As Numeric
    Local cOutros := Replicate('9', TamSX3('D4G_CODPAR')[1])
    Local dDtIni    As date
    Local dDtFim    As date
    Local cMovAnlTab := AnalyticalMovementTable():TableName()
    Local cProcTable := ProcessingTable():TableName()
    Local cProcTabCP := PartsProcessingTable():TableName()
    Local cRevAtiv  := ""
    Local cMoedaIns := ""
    Local cMoeda    := ""
    Local nMoeda    := 0
    Local cFilAtu   := ""
    Local nFil      := 0
    Local aMatch    := {}
    Local aUpdate   := {}
    Local aCpoDest  := {}
    Local aInsert   := {}

    dDtIni := ::jParams['dataini']
    dDtFim := ::jParams['datafin']
    cRevAtiv := ::jParams['revisao_vigente']

    Default cFilAtu := cFilAnt

    If ::oQueryFixCostMov == Nil
        //SELECT SD1 - NOTAS FISCAIS DE COMPRA
        cQuery := " Select "
        cQuery += " ANL.R_E_C_N_O_ RECPAI, "
        cQuery += " ANL.FILPROC FILPROC, "
        cQuery += " ANL.FILIAL FILIAL, "
        cQuery += " Coalesce(D4G.D4G_CODPAR, '"+cOutros+"') CODPAR, "
        cQuery += " SD1.D1_CUSTO  CUSTO1, "
        cQuery += " SD1.D1_CUSTO2 CUSTO2, "
        cQuery += " SD1.D1_CUSTO3 CUSTO3, "
        cQuery += " SD1.D1_CUSTO4 CUSTO4, "
        cQuery += " SD1.D1_CUSTO5 CUSTO5 "
        cQuery += " From "+cMovAnlTab+" ANL "
        cQuery += " Inner Join "+RetSQLName("SD1")+" SD1 "
        cQuery += " On "
        cQuery += " SD1.R_E_C_N_O_ = ANL.RECNO "
        cQuery += " Left Join "+RetSQLName("D4G")+" D4G "
        cQuery += " On "
        cQuery += " D4G.D4G_FILIAL = ? And "
        cQuery += " D4G.D4G_PRODUT = SD1.D1_COD And "
        cQuery += " D4G.D4G_REVIS  = ? And"
        cQuery += " D4G.D_E_L_E_T_ = ? "
        cQuery += " Left Join "+RetSQLName("D4F")+" D4F "
        cQuery += " On "
        cQuery += " D4F.D4F_FILIAL = ? And "
        cQuery += " D4F.D4F_REVIS  = ? And "
        cQuery += " D4F.D4F_CODPAR = D4G.D4G_CODPAR And "
        cQuery += " D4F.D4F_TIPO   = ? And "
        cQuery += " D4F.D_E_L_E_T_ = ? "
        cQuery += " Where "
        cQuery += " ANL.FILPROC = ? And "
        cQuery += " ANL.FILIAL  = ? And "
        cQuery += " ANL.ALIAS   = ? And "
        cQuery += " ANL.CUSTOMEDIO = ? And "
        cQuery += " ANL.PODER3  In (?, ?, ?) And "
        cQuery += " ANL.FILTRF  = ? And "
        cQuery += " ANL.TIPONF  <> ? "
        
        cQuery += " Union All "

        cQuery += " Select "
        cQuery += " ANL.R_E_C_N_O_ RECPAI, "
        cQuery += " ANL.FILPROC FILPROC, "
        cQuery += " ANL.FILIAL FILIAL, "
        cQuery += " Coalesce(D4G.D4G_CODPAR, '"+cOutros+"') CODPAR, "
        cQuery += " SD3.D3_CUSTO1 CUSTO1, "
        cQuery += " SD3.D3_CUSTO2 CUSTO2, "
        cQuery += " SD3.D3_CUSTO3 CUSTO3, "
        cQuery += " SD3.D3_CUSTO4 CUSTO4, "
        cQuery += " SD3.D3_CUSTO5 CUSTO5 "
        cQuery += " From "+cMovAnlTab+" ANL "
        cQuery += " Inner Join "+RetSQLName("SD3")+" SD3 "
        cQuery += " On "
        cQuery += " SD3.R_E_C_N_O_ = ANL.RECNO "
        cQuery += " Left Join "+RetSQLName("SD7")+" SD7 "
        cQuery += " On "
        cQuery += " SD7.D7_FILIAL  = ? And "
        cQuery += " SD7.D7_PRODUTO = SD3.D3_COD And "
        cQuery += " SD7.D7_NUMSEQ  = SD3.D3_NUMSEQ And "
        cQuery += " SD7.D7_NUMERO  = SD3.D3_DOC And "
        cQuery += " SD7.D_E_L_E_T_ = ? "
        cQuery += " Left Join "+RetSQLName("D4G")+" D4G "
        cQuery += " On "
        cQuery += " D4G.D4G_FILIAL = ? And "
        cQuery += " D4G.D4G_PRODUT = SD3.D3_COD And "
        cQuery += " D4G.D4G_REVIS  = ? And "
        cQuery += " D4G.D_E_L_E_T_ = ? "
        cQuery += " Left Join "+RetSQLName("D4F")+" D4F "
        cQuery += " On "
        cQuery += " D4F.D4F_FILIAL = ? And "
        cQuery += " D4F.D4F_REVIS  = ? And "
        cQuery += " D4F.D4F_CODPAR = D4G.D4G_CODPAR And "
        cQuery += " D4F.D4F_TIPO   = ? And "
        cQuery += " D4F.D_E_L_E_T_ = ? "
        cQuery += " Where "
        cQuery += " ANL.FILPROC = ? And "
        cQuery += " ANL.FILIAL  = ? And "
        cQuery += " ANL.ALIAS   = ? And "
        cQuery += " ANL.CUSTOMEDIO = ? And "
        cQuery += " ANL.CF  In (?, ?) And "
        cQuery += " SD7.D7_FILIAL Is Null "

        cQuery := ChangeQuery(cQuery)

        ::oQueryFixCostMov := FWExecStatement():New(cQuery)
    EndIf

    For nFil := 1 To Len(::aFilProc)
        cFilAtu := ::aFilProc[nFil, 1]
        For nMoeda := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nMoeda]
            cMoedaIns := StrZero(Val(cMoeda), 2)

            ASize(aBind, 0)
            aBind := {}

            //SD1
            AAdd(aBind, FWXFilial("D4G",cFilAtu)) //D4G_FILIAL
            AAdd(aBind, cRevAtiv) //D4G_REVIS
            AAdd(aBind, ' ') //D4G.D_E_L_E_T_
            AAdd(aBind, FWXFilial("D4F",cFilAtu)) //D4F_FILIAL
            AAdd(aBind, cRevAtiv) //D4F_REVIS
            AAdd(aBind, '1') //D4F_TIPO
            AAdd(aBind, ' ') //D4F.D_E_L_E_T_
            AAdd(aBind, cFilProc) //FILPROC
            AAdd(aBind, cFilAtu) //FILIAL
            AAdd(aBind, 'SD1') //ALIAS
            AAdd(aBind, 'N') //CUSTOMEDIO
            AAdd(aBind, ' ') //PODER3
            AAdd(aBind, 'N') //PODER3
            AAdd(aBind, 'R') //PODER3
            AAdd(aBind, '2') //FILTRF
            AAdd(aBind, 'D') //TIPONF

            //SD3
            AAdd(aBind, FWXFilial("SD7",cFilAtu)) //D7_FILIAL
            AAdd(aBind, ' ') //SD7.D_E_L_E_T_
            AAdd(aBind, FWXFilial("D4G",cFilAtu)) //D4G_FILIAL
            AAdd(aBind, cRevAtiv) //D4G_REVIS
            AAdd(aBind, ' ') //D4G.D_E_L_E_T_
            AAdd(aBind, FWXFilial("D4F",cFilAtu)) //D4F_FILIAL
            AAdd(aBind, cRevAtiv) //D4F_REVIS
            AAdd(aBind, '1') //D4F_TIPO
            AAdd(aBind, ' ') //D4F.D_E_L_E_T_
            AAdd(aBind, cFilProc) //FILPROC
            AAdd(aBind, cFilAtu) //FILIAL
            AAdd(aBind, 'SD3') //ALIAS
            AAdd(aBind, 'N') //CUSTOMEDIO
            AAdd(aBind, 'RE6') //CF
            AAdd(aBind, 'DE6') //CF
 
            For nI := 1 To Len(aBind)
                ::oQueryFixCostMov:SetString(nI, aBind[nI])
            Next nI

            cQuery := ::oQueryFixCostMov:GetFixQuery()

            //Filtro
            ASize(aMatch, 0)
            aMatch := {}
            AAdd(aMatch, {"RECPAI", "RECPAI"})
            AAdd(aMatch, {"CODPAR", "CODPAR"})
            AAdd(aMatch, {"'"+cMoedaIns+"'", "MOEDA"})
            AAdd(aMatch, {"FILPROC", "FILPROC"})
            AAdd(aMatch, {"FILIAL", "FILIAL"})

            //Expressões de update
            ASize(aUpdate, 0)
            aUpdate := {}
            cUpdate := "CUSTO = Origem.CUSTO"+cMoeda+" "
            AAdd(aUpdate, cUpdate)
            cUpdate := "CSTORI = Origem.CUSTO"+cMoeda+" "
            AAdd(aUpdate, cUpdate)

            //Expressões de insert
            ASize(aCpoDest, 0)
            aCpoDest := {}
            AAdd(aCpoDest, "FILPROC")
            AAdd(aCpoDest, "FILIAL")
            AAdd(aCpoDest, "RECPAI")
            AAdd(aCpoDest, "CODPAR")
            AAdd(aCpoDest, "MOEDA")
            AAdd(aCpoDest, "CUSTO")
            AAdd(aCpoDest, "CSTORI")
            
            ASize(aInsert, 0)
            aInsert := {}
            AAdd(aInsert, "Origem.FILPROC")
            AAdd(aInsert, "Origem.FILIAL")
            AAdd(aInsert, "Origem.RECPAI")
            AAdd(aInsert, "Origem.CODPAR")
            AAdd(aInsert, "'"+cMoedaIns+"'")
            AAdd(aInsert, "Origem.CUSTO"+cMoeda)
            AAdd(aInsert, "Origem.CUSTO"+cMoeda)

            cMerge := ::MergeStatement(::TableName(), cQuery, aMatch, aUpdate, aCpoDest, aInsert)

            ::RunQuery(cMerge)

        Next nMoeda
    Next nFil

    FWFreeArray(aBind)
    FWFreeArray(aInsert)
    FWFreeArray(aCpoDest)
    FWFreeArray(aUpdate)
    FWFreeArray(aMatch)
Return

/*/{Protheus.doc} IgnorePurchaseReturn
    - Marca os movimentos de devolução de compras onde a compra ocorreu no mesmo período
    para serem ignorados. 
    - Abate o custo e quantidade da tabela de processamento
    - Quando a compra aconteceu fora do período, executa a mesma regra do MATA330
    com o parâmetro MV_ADEVCOM ligado:
        - Se houver saldo histórico suficiente (inicial+compras), realiza a devolução total do custo/quantidade
        - Se não houver saldo histórico suficiente, realiza a devolução a custo médio.
    Abate do valor histórico da tabela de processamento e marca as devoluções como ignoradas
    @author Squad Entradas
    @since 08/04/2024
    @type Method
    /*/
Method IgnorePurchaseReturn(cFilProc) Class AnalyticalMovementPartsTable
    Local cQuery  := ""
    Local nFil    := ""
    Local cFilAtu := ""
    Local aBind   := {}
    Local nI      := 0
    Local cProcTable := ProcessingTable():TableName()
    Local cProcTabCP := PartsProcessingTable():TableName()
    Local cMovAnlTab := AnalyticalMovementTable():TableName()
    Local nMoeda  := 0
    Local cMoeda  := ''
    Local cMoedaIns := ''
    Local aMatch  := {}
    Local aUpdate := {}
    Local cUpdate := "" 
    Local aCpoDest := {}
    Local aInsert  := {}
    Local cInsert  := ''
    Local cMerge  := ""
    Local cOutros := Replicate('9', TamSX3('D4G_CODPAR')[1])
    Local dDtIni    As date
    Local dDtFim    As date
    Local cRevAtiv  := ""

    dDtIni := ::jParams['dataini']
    dDtFim := ::jParams['datafin']
    cRevAtiv := ::jParams['revisao_vigente']

    //Nota origem dentro do período
    //Marca as notas de devolução como ignoradas e atualiza o custo na tabela analitica em partes
    //Considera a regra padrão de valorização da nota de compras: 
    //O custo total da nota é atribuído à parte de custo vinculada ao produto
    If ::oQueryPurchRet == Nil
        cQuery := " Select "
        cQuery += " SD1.D1_FILIAL FILIAL, "
        For nMoeda := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nMoeda]
            cQuery += " SD1.D1_CUSTO"+cMoeda
            cQuery += " D1CUSTO"+cMoeda+", "
        Next nMoeda
        cQuery += " SD1.D1_QUANT D1QUANT, "
        cQuery += " SD1.D4G_CODPAR CODPAR, "
        cQuery += " DEV.QUANT DEVQUANT, "
        cQuery += " DEV.R_E_C_N_O_ RECNUMBER "
        cQuery += " From "+RetSQLName("SD2")+" SD2 "
        cQuery += " Inner Join "+::cViewAcquisCstParts+" SD1 On "
        cQuery += " SD1.D1_FILIAL  = SD2.D2_FILIAL  And "
        cQuery += " SD1.D1_DOC     = SD2.D2_NFORI   And "
        cQuery += " SD1.D1_SERIE   = SD2.D2_SERIORI And "
        cQuery += " SD1.D1_ITEM    = SD2.D2_ITEMORI And "
        cQuery += " SD1.D1_FORNECE = SD2.D2_CLIENTE And "
        cQuery += " SD1.D1_LOJA    = SD2.D2_LOJA    And "
        cQuery += " SD1.D1_DTDIGIT >= ? And "
        cQuery += " SD1.D1_DTDIGIT <= ? And "
        cQuery += " (SD1.D4G_REVIS  = ? Or SD1.D4G_REVIS Is Null) "
        If  ::jVwAcquistCstParams["SF4_EMPRESA"] != FWModeAccess("SD1", 1) .Or. ;
            ::jVwAcquistCstParams["SF4_UNIDADE"] != FWModeAccess("SD1", 2) .Or. ;
            ::jVwAcquistCstParams["SF4_FILIAL"]  != FWModeAccess("SD1", 3)
            cQuery += " And SD1.F4_FILIAL = ? "
        EndIf
        cQuery += " Inner Join "+cMovAnlTab+" DEV On "
        cQuery += " DEV.FILPROC = ? And "
        cQuery += " DEV.ALIAS   = ? And "
        cQuery += " DEV.RECNO   = SD2.R_E_C_N_O_ "
        cQuery += " Where "
        cQuery += " SD2.D2_FILIAL   = ? And "
        cQuery += " SD2.D2_EMISSAO >= ? And "
        cQuery += " SD2.D2_EMISSAO <= ? And "
        cQuery += " SD2.D2_TIPO     = ? And "
        cQuery += " SD2.D_E_L_E_T_  = ? "
       
        cQuery := ChangeQuery(cQuery)

        ::oQueryPurchRet := FWExecStatement():New(cQuery)
    EndIf

    For nFil := 1 To Len(::aFilProc)
        cFilAtu := ::aFilProc[nFil, 1]
        For nMoeda := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nMoeda]
            cMoedaIns := StrZero(Val(cMoeda), 2)

            ASize(aBind, 0)
            aBind := {}
            AAdd(aBind, DToS(dDtIni)) //D1_DTDIGIT
            AAdd(aBind, DToS(dDtFim)) //D1_DTDIGIT
            AAdd(aBind, cRevAtiv) //D4G_REVIS
            //AAdd(aBind, ::jVwAcquistCstPartsParams['REVIS_DEFAULT']) //D4G_REVIS
            If  ::jVwAcquistCstParams["SF4_EMPRESA"] != FWModeAccess("SD1", 1) .Or. ;
                ::jVwAcquistCstParams["SF4_UNIDADE"] != FWModeAccess("SD1", 2) .Or. ;
                ::jVwAcquistCstParams["SF4_FILIAL"]  != FWModeAccess("SD1", 3)
                AAdd(aBind, FWXFilial('SF4', cFilAtu)) //F4_FILIAL
            EndIf
            AAdd(aBind, cFilProc) //FILPROC
            AAdd(aBind, 'SD2') //ALIAS
            AAdd(aBind, cFilAtu) //D2_FILIAL
            AAdd(aBind, DToS(dDtIni)) //D2_EMISSAO
            AAdd(aBind, DToS(dDtFim)) //D2_EMISSAO
            AAdd(aBind, 'D') //D2_TIPO
            AAdd(aBind, ' ') //D_E_L_E_T_

            For nI := 1 To Len(aBind)
                ::oQueryPurchRet:SetString(nI, aBind[nI])
            Next nI

            cQuery := ::oQueryPurchRet:GetFixQuery()

            //Filtro
            ASize(aMatch, 0)
            aMatch := {}
            AAdd(aMatch, {"RECNUMBER", "RECPAI"})
            AAdd(aMatch, {"CODPAR", "CODPAR"})
            AAdd(aMatch, {"'"+cMoedaIns+"'", "MOEDA"})
            AAdd(aMatch, {"'"+cFilProc+"'", "FILPROC"})
            AAdd(aMatch, {"FILIAL", "FILIAL"})

            //Expressões de update
            ASize(aUpdate, 0)
            aUpdate := {}
            cUpdate := " CUSTO = "
            cUpdate += " Case "
            cUpdate += "    When Origem.D1QUANT <> 0 Then "
            cUpdate += "       Origem.DEVQUANT * (Origem.D1CUSTO"+cMoeda+"/Origem.D1QUANT) "
            cUpdate += "    Else " //Notas de devolução de complemento de preço
            cUpdate += "       Origem.D1CUSTO"+cMoeda+" "
            cupdate += " End "
            AAdd(aUpdate, cUpdate)
            cUpdate := " CSTORI = "
            cUpdate += " Case "
            cUpdate += "    When Origem.D1QUANT <> 0 Then "
            cUpdate += "       Origem.DEVQUANT * (Origem.D1CUSTO"+cMoeda+"/Origem.D1QUANT) "
            cUpdate += "    Else " //Notas de devolução de complemento de preço
            cUpdate += "       Origem.D1CUSTO"+cMoeda+" "
            cupdate += " End "
            AAdd(aUpdate, cUpdate)

            //Expressões de insert
            ASize(aCpoDest, 0)
            aCpoDest := {}
            AAdd(aCpoDest, "FILPROC")
            AAdd(aCpoDest, "FILIAL")
            AAdd(aCpoDest, "RECPAI")
            AAdd(aCpoDest, "CODPAR")
            AAdd(aCpoDest, "MOEDA")
            AAdd(aCpoDest, "CUSTO")
            AAdd(aCpoDest, "CSTORI")
            
            ASize(aInsert, 0)
            aInsert := {}
            AAdd(aInsert, "'"+cFilProc+"'")
            AAdd(aInsert, "Origem.FILIAL")
            AAdd(aInsert, "Origem.RECNUMBER")
            AAdd(aInsert, "Origem.CODPAR")
            AAdd(aInsert, "'"+cMoedaIns+"'")
            cInsert := " Case "
            cInsert += "    When Origem.D1QUANT <> 0 Then "
            cInsert += "       Origem.DEVQUANT * (Origem.D1CUSTO"+cMoeda+"/Origem.D1QUANT) "
            cInsert += "    Else " //Notas de devolução de complemento de preço
            cInsert += "       Origem.D1CUSTO"+cMoeda+" "
            cInsert += " End "
            AAdd(aInsert, cInsert)
            AAdd(aInsert, cInsert)

            cMerge := ::MergeStatement(::TableName(), cQuery, aMatch, aUpdate, aCpoDest, aInsert)

            ::RunQuery(cMerge)
        Next nMoeda
    Next nFil

    //Abate o saldo devolvido da tabela de processamento em partes
    If ::oQueryPurchRetProc == Nil
        cQuery := " Select "
        cQuery += " DEV.FILPROC FILPROC, "
        If ::cCusFil != "E"
            cQuery += " DEV.FILIAL FILIAL, "
        Else
            If ::lPostgres
                cQuery += " Char("+cValToChar(FWSizeFilial())+") "
            EndIf
            cQuery += " '"+PadR(FWCompany(), FWSizeFilial())+"' FILIAL, "
        EndIf
        cQuery += " DEV.COD COD, "
        If ::cCusFil == "A"
            cQuery += " DEV.LOCARM ARMAZEM, "
        EndIf
        cQuery += " DEVCP.CODPAR CODPAR, "
        cQuery += " DEVCP.MOEDA MOEDA, "
        cQuery += " Sum(DEV.QUANT) QUANT, "
        cQuery += " Sum(DEVCP.CUSTO) CUSTO "
        cQuery += " From "+RetSQLName("SD2")+" SD2 "
        cQuery += " Inner Join "+::cViewAcquisCstParts+" SD1 On "
        cQuery += " SD1.D1_FILIAL  = SD2.D2_FILIAL  And "
        cQuery += " SD1.D1_DOC     = SD2.D2_NFORI   And "
        cQuery += " SD1.D1_SERIE   = SD2.D2_SERIORI And "
        cQuery += " SD1.D1_ITEM    = SD2.D2_ITEMORI And "
        cQuery += " SD1.D1_FORNECE = SD2.D2_CLIENTE And "
        cQuery += " SD1.D1_LOJA    = SD2.D2_LOJA    And "
        cQuery += " SD1.D1_DTDIGIT >= ? And "
        cQuery += " SD1.D1_DTDIGIT <= ? And "
        cQuery += " (SD1.D4G_REVIS  = ? Or SD1.D4G_REVIS Is Null) "
        If  ::jVwAcquistCstParams["SF4_EMPRESA"] != FWModeAccess("SD1", 1) .Or. ;
            ::jVwAcquistCstParams["SF4_UNIDADE"] != FWModeAccess("SD1", 2) .Or. ;
            ::jVwAcquistCstParams["SF4_FILIAL"]  != FWModeAccess("SD1", 3)
            cQuery += " And SD1.F4_FILIAL = ? "
        EndIf
        cQuery += " Inner Join "+cMovAnlTab+" DEV On "
        cQuery += " DEV.FILPROC = ? And "
        cQuery += " DEV.ALIAS   = ? And "
        cQuery += " DEV.RECNO   = SD2.R_E_C_N_O_ "
        cQuery += " Inner Join "+::TableName()+" DEVCP On " //<- Inner join para atualizar somente os que existirem, demais já seriam custo zero e não fariam diferença no cálculo
        cQuery += " DEVCP.RECPAI = DEV.R_E_C_N_O_  "
        cQuery += " Where "
        cQuery += " SD2.D2_FILIAL   = ? And "
        cQuery += " SD2.D2_EMISSAO >= ? And "
        cQuery += " SD2.D2_EMISSAO <= ? And "
        cQuery += " SD2.D2_TIPO     = ? And "
        cQuery += " SD2.D_E_L_E_T_  = ? "
        cQuery += " Group By "
        cQuery += " DEV.FILPROC, "
        If ::cCusFil != "E"
            cQuery += " DEV.FILIAL, "
        EndIf
        cQuery += " DEV.COD "
        If ::cCusFil == "A"
            cQuery += " , DEV.LOCARM "
        EndIf
        cQuery += " , DEVCP.CODPAR, "
        cQuery += " DEVCP.MOEDA "
       
        cQuery := ChangeQuery(cQuery)

        ::oQueryPurchRetProc := FWExecStatement():New(cQuery)
    EndIf

    For nFil := 1 To Len(::aFilProc)
        cFilAtu := ::aFilProc[nFil, 1]


        ASize(aBind, 0)
        aBind := {}
        AAdd(aBind, DToS(dDtIni)) //D1_DTDIGIT
        AAdd(aBind, DToS(dDtFim)) //D1_DTDIGIT
        AAdd(aBind, cRevAtiv) //D4G_REVIS
        If  ::jVwAcquistCstParams["SF4_EMPRESA"] != FWModeAccess("SD1", 1) .Or. ;
            ::jVwAcquistCstParams["SF4_UNIDADE"] != FWModeAccess("SD1", 2) .Or. ;
            ::jVwAcquistCstParams["SF4_FILIAL"]  != FWModeAccess("SD1", 3)
            AAdd(aBind, FWXFilial('SF4', cFilAtu)) //F4_FILIAL
        EndIf
        AAdd(aBind, cFilProc) //FILPROC
        AAdd(aBind, 'SD2') //ALIAS
        AAdd(aBind, cFilAtu) //D2_FILIAL
        AAdd(aBind, DToS(dDtIni)) //D2_EMISSAO
        AAdd(aBind, DToS(dDtFim)) //D2_EMISSAO
        AAdd(aBind, 'D') //D2_TIPO
        AAdd(aBind, ' ') //D_E_L_E_T_

        For nI := 1 To Len(aBind)
            ::oQueryPurchRetProc:SetString(nI, aBind[nI])
        Next nI

        cQuery := ::oQueryPurchRetProc:GetFixQuery()

        //Filtro
        ASize(aMatch, 0)
        aMatch := {}
        AAdd(aMatch, {"FILPROC", "'"+cFilProc+"'"})
        If ::cCusFil != "E"
            AAdd(aMatch, {"FILIAL", "FILIAL"})
        EndIf
        AAdd(aMatch, {"COD", "COD"})
        If ::cCusFil == "A"
            AAdd(aMatch, {"ARMAZEM", "ARMAZEM"})
        EndIf
        AAdd(aMatch, {"CODPAR", "CODPAR"})
        AAdd(aMatch, {"MOEDA", "MOEDA"})

        //Expressões de update
        ASize(aUpdate, 0)
        aUpdate := {}
        AAdd(aUpdate, "CSTHIST = Destino.CSTHIST - Origem.CUSTO")
        AAdd(aUpdate, "CSTPROC = Destino.CSTPROC - Origem.CUSTO")
        AAdd(aUpdate, "QTDHIST = Destino.QTDHIST - Origem.QUANT")
        AAdd(aUpdate, "QTDPROC = Destino.QTDPROC - Origem.QUANT")
        cUpdate := "CMHIST = "
        cUpdate += "Case "
        cUpdate += "   When (Destino.QTDHIST - Origem.QUANT) <> 0 "
        cUpdate += "   Then (Destino.CSTHIST - Origem.CUSTO) "
        cUpdate += "   / (Destino.QTDHIST - Origem.QUANT) "
        cUpdate += "   Else Destino.CMHIST "
        cUpdate += "End"
        AAdd(aUpdate, cUpdate)
        cUpdate := "CMPROC = "
        cUpdate += "Case "
        cUpdate += "   When (Destino.QTDPROC - Origem.QUANT) <> 0 "
        cUpdate += "   Then (Destino.CSTPROC - Origem.CUSTO) "
        cUpdate += "   / (Destino.QTDPROC - Origem.QUANT) "
        cUpdate += "   Else Destino.CMPROC "
        cUpdate += "End"
        AAdd(aUpdate, cUpdate)

        //Expressões de insert
        ASize(aCpoDest, 0)
        aCpoDest := {}
        AAdd(aCpoDest, "FILPROC")
        AAdd(aCpoDest, "FILIAL")
        AAdd(aCpoDest, "COD")
        If ::cCusFil == "A"
            AAdd(aCpoDest, "ARMAZEM")
        EndIf
        AAdd(aCpoDest, "CODPAR")
        AAdd(aCpoDest, "MOEDA")
        AAdd(aCpoDest, "QTDHIST")
        AAdd(aCpoDest, "QTDPROC")
        AAdd(aCpoDest, "CSTHIST")
        AAdd(aCpoDest, "CSTPROC")
        AAdd(aCpoDest, "CMHIST")
        AAdd(aCpoDest, "CMPROC")       
        
        ASize(aInsert, 0)
        aInsert := {}
        AAdd(aInsert, "'"+cFilProc+"'")
        AAdd(aInsert, "Origem.FILIAL")
        AAdd(aInsert, "Origem.COD")
        If ::cCusFil == "A"
            AAdd(aInsert, "Origem.ARMAZEM")
        EndIf
        AAdd(aInsert, "Origem.CODPAR")
        AAdd(aInsert, "Origem.MOEDA")
        AAdd(aInsert, "-Origem.QUANT")
        AAdd(aInsert, "-Origem.QUANT")
        AAdd(aInsert, "-Origem.CUSTO")
        AAdd(aInsert, "-Origem.CUSTO")
        cInsert := "Case "
        cInsert += "When Origem.QUANT <> 0 "
        cInsert += "Then Origem.CUSTO/Origem.QUANT "
        cInsert += "Else 0 "
        cInsert += "End"
        AAdd(aInsert, cInsert)
        cInsert := "Case "
        cInsert += "When Origem.QUANT <> 0 "
        cInsert += "Then Origem.CUSTO/Origem.QUANT "
        cInsert += "Else 0 "
        cInsert += "End"
        AAdd(aInsert, cInsert)

        cMerge := ::MergeStatement(cProcTabCP, cQuery, aMatch, aUpdate, aCpoDest, aInsert)

        ::RunQuery(cMerge)
    Next nFil

    //Avalia as devoluções de compras que ocorreram fora do período

    //Marca as notas de devolução de compra fora do período como ignoradas
    //avalia se elas serão devolvidas com o custo integral, ou com o custo médio
    //conforme a regra do parâmetro MV_ADEVCOM = .T. (ver descrição do método)
    //através de do flag DEVCM gravado na tabela analitica
    //atualiza o custo conforme flag DEVCM
    If ::oQueryPurchRetPrev == Nil
        cQuery := " Select "
        cQuery += " DEV.FILIAL FILIAL, "
        cQuery += " DEV.R_E_C_N_O_ RECDEV, "
        cQuery += " DEV.DEVCM DEVCUSTOMEDIO, "
        cQuery += " DEV.QUANT DEVQUANT, "

        //Dados da nota original, caso retorne pelo custo total
        cQuery += " SD1.D1_QUANT D1QUANT, "
        cQuery += " Coalesce(SD1CP.D4L_TOTAL, 0) D1CUSTO, "
        cQuery += " Case "
        cQuery += "    When DEV.DEVCM = 'S' "
        cQuery += "    Then Coalesce(PRCCP.CODPAR,    '"+cOutros+"') "
        cQuery += "    Else Coalesce(SD1CP.D4L_PARTE, '"+cOutros+"') "
        cQuery += " End CODPAR, "
        cQuery += " Case "
        cQuery += "    When DEV.DEVCM = 'S' "
        cQuery += "    Then Coalesce(PRCCP.MOEDA,     ?) "
        cQuery += "    Else Coalesce(SD1CP.D4L_MOEDA, ?) "
        cQuery += " End MOEDA, "
        
        //Dados de custo médio, caso retorne pelo custo médio
        cQuery += " Coalesce(PRCCP.CMHIST, 0) CMHIST "
        cQuery += " From "+RetSQLName("SD2")+" SD2 "
        cQuery += " Inner Join "+cMovAnlTab+" DEV On "
        cQuery += " DEV.FILPROC = ? And "
        cQuery += " DEV.ALIAS   = ? And "
        cQuery += " DEV.RECNO   = SD2.R_E_C_N_O_ "
        cQuery += " Inner Join "+RetSQLName("SD1")+" SD1 On "
        cQuery += " SD1.D1_FILIAL  = SD2.D2_FILIAL  And "
        cQuery += " SD1.D1_DOC     = SD2.D2_NFORI   And "
        cQuery += " SD1.D1_SERIE   = SD2.D2_SERIORI And "
        cQuery += " SD1.D1_ITEM    = SD2.D2_ITEMORI And "
        cQuery += " SD1.D1_FORNECE = SD2.D2_CLIENTE And "
        cQuery += " SD1.D1_LOJA    = SD2.D2_LOJA    And "
        cQuery += " SD1.D1_DTDIGIT < ? " 
        cQuery += " Left Join "+RetSQLName('D4L')+" SD1CP On "
        cQuery += " SD1CP.D4L_FILIAL  = SD1.D1_FILIAL  And "
        cQuery += " SD1CP.D4L_DOC     = SD1.D1_DOC     And "
        cQuery += " SD1CP.D4L_SERIE   = SD1.D1_SERIE   And "
        cQuery += " SD1CP.D4L_FORNEC  = SD1.D1_FORNECE And "
        cQuery += " SD1CP.D4L_LOJA    = SD1.D1_LOJA    And "
        cQuery += " SD1CP.D4L_ITEM    = SD1.D1_ITEM    And "
        cQuery += " SD1CP.D4L_FORMUL  = SD1.D1_FORMUL  And "
        cQuery += " SD1CP.D4L_ITEMGR  = SD1.D1_ITEMGRD And "
        cQuery += " SD1CP.D4L_MOEDA   = ? And "
        cQuery += " SD1CP.D_E_L_E_T_  = ? "
        cQuery += " Inner Join "+RetSQLName('SF4')+" SF4 On "
        cQuery += " SF4.F4_FILIAL  = ? And "
        cQuery += " SF4.F4_CODIGO  = SD1.D1_TES And "
        cQuery += " SF4.F4_ESTOQUE = ? And "
        cQuery += " SF4.F4_PODER3  In (?, ?) And " //Poder de 3º será trabalhado em outro método
        cQuery += " SF4.D_E_L_E_T_ = ? "
        cQuery += " Inner Join "+cProcTable+" PRC On "
        cQuery += " PRC.FILPROC = DEV.FILPROC And "
        If ::cCusFil != "E"
            cQuery += " PRC.FILIAL  = DEV.FILIAL  And "
        EndIf
        cQuery += " PRC.COD     = DEV.COD      "
        If ::cCusFil == 'A'
            cQuery += " And PRC.ARMAZEM = DEV.LOCARM  "
        EndIf
        cQuery += " Left Join "+cProcTabCP+" PRCCP On "
        cQuery += " PRCCP.FILPROC = DEV.FILPROC And "
        If ::cCusFil != "E"
            cQuery += " PRCCP.FILIAL  = DEV.FILIAL  And "
        EndIf
        cQuery += " PRCCP.COD     = DEV.COD      "
        If ::cCusFil == 'A'
            cQuery += " And PRCCP.ARMAZEM = DEV.LOCARM  "
        EndIf
        cQuery += " And PRCCP.MOEDA = ? "
        cQuery += " Where "
        cQuery += " SD2.D2_FILIAL   = ? And "
        cQuery += " SD2.D2_EMISSAO >= ? And "
        cQuery += " SD2.D2_EMISSAO <= ? And "
        cQuery += " SD2.D2_TIPO     = ? And "
        cQuery += " SD2.D_E_L_E_T_  = ? "

        cQuery := ChangeQuery(cQuery)

        ::oQueryPurchRetPrev := FWExecStatement():New(cQuery)
    EndIf

    For nFil := 1 To Len(::aFilProc)
        cFilAtu := ::aFilProc[nFil, 1]

        For nMoeda := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nMoeda]
            cMoedaIns := StrZero(Val(cMoeda), 2)

            ASize(aBind, 0)
            aBind := {}
            AAdd(aBind, cMoedaIns)
            AAdd(aBind, cMoedaIns)
            //filtro query principal
            AAdd(aBind, cFilProc) //FILPROC
            AAdd(aBind, 'SD2') //ALIAS
            AAdd(aBind, DToS(dDtIni)) //SD1.D1_DTDIGIT
            AAdd(aBind, cMoedaIns) //SD1CP.D4L_MOEDA
            AAdd(aBind, ' ') //SD1CP.D_E_L_E_T_
            AAdd(aBind, FWXFilial('SF4', cFilAtu)) //F4_FILIAL
            AAdd(aBind, 'S') //SF4.F4_ESTOQUE
            AAdd(aBind, ' ') //SF4.F4PODER3
            AAdd(aBind, 'N') //SF4.F4PODER3
            AAdd(aBind, ' ') //SF4.D_E_L_E_T_
            AAdd(aBind, cMoedaIns) //PRCCP.MOEDA
            AAdd(aBind, cFilAtu) //SD2.D2_FILIAL
            AAdd(aBind, DToS(dDtIni)) //SD2.D2_EMISSAO
            AAdd(aBind, DToS(dDtFim)) //SD2.D2_EMISSAO
            AAdd(aBind, 'D') //SD2.D2_TIPO
            AAdd(aBind, ' ') //SD2.D_E_L_E_T_

            For nI := 1 To Len(aBind)
                ::oQueryPurchRetPrev:SetString(nI, aBind[nI])
            Next nI

            cQuery := ::oQueryPurchRetPrev:GetFixQuery()

            //Filtro
            ASize(aMatch, 0)
            aMatch := {}
            AAdd(aMatch, {"RECDEV", "RECPAI"})
            AAdd(aMatch, {"CODPAR", "CODPAR"})
            AAdd(aMatch, {"MOEDA", "MOEDA"})
            AAdd(aMatch, {"'"+cFilProc+"'", "FILPROC"})
            AAdd(aMatch, {"FILIAL", "FILIAL"})

            //Expressões de update
            ASize(aUpdate, 0)
            aUpdate := {}
            cUpdate := " CUSTO = "
            cUpdate += " Case "
            cUpdate += "    When Origem.DEVCUSTOMEDIO = 'S' "
            cUpdate += "    Then "
            cUpdate += "        Origem.DEVQUANT*Origem.CMHIST "
            cUpdate += "    Else "
            cUpdate += "    Case "
            cUpdate += "        When Origem.D1QUANT <> 0 Then "
            cUpdate += "            Origem.DEVQUANT * "
            cUpdate += "                (Origem.D1CUSTO/Origem.D1QUANT) "
            cUpdate += "        Else " //Notas de devolução de complemento de preço
            cUpdate += "            Origem.D1CUSTO "
            cupdate += "    End "
            cupdate += " End "
            AAdd(aUpdate, cUpdate)
            cUpdate := " CSTORI = "
            cUpdate += " Case "
            cUpdate += "    When Origem.DEVCUSTOMEDIO = 'S' "
            cUpdate += "    Then "
            cUpdate += "        Origem.DEVQUANT*Origem.CMHIST "
            cUpdate += "    Else "
            cUpdate += "    Case "
            cUpdate += "        When Origem.D1QUANT <> 0 Then "
            cUpdate += "            Origem.DEVQUANT * "
            cUpdate += "                (Origem.D1CUSTO/Origem.D1QUANT) "
            cUpdate += "        Else " //Notas de devolução de complemento de preço
            cUpdate += "            Origem.D1CUSTO "
            cupdate += "    End "
            cupdate += " End "
            AAdd(aUpdate, cUpdate)

            //Expressões de insert
            ASize(aCpoDest, 0)
            aCpoDest := {}
            AAdd(aCpoDest, "FILPROC")
            AAdd(aCpoDest, "FILIAL")
            AAdd(aCpoDest, "RECPAI")
            AAdd(aCpoDest, "CODPAR")
            AAdd(aCpoDest, "MOEDA")
            AAdd(aCpoDest, "CUSTO")
            AAdd(aCpoDest, "CSTORI")

            ASize(aInsert, 0)
            aInsert := {}
            AAdd(aInsert, "'"+cFilProc+"'")
            AAdd(aInsert, "Origem.FILIAL")
            AAdd(aInsert, "Origem.RECDEV")
            AAdd(aInsert, "Origem.CODPAR")
            AAdd(aInsert, "Origem.MOEDA")
            cInsert := " Case "
            cInsert += "    When Origem.DEVCUSTOMEDIO = 'S' "
            cInsert += "    Then "
            cInsert += "        Origem.DEVQUANT*Origem.CMHIST "
            cInsert += "    Else "
            cInsert += "    Case "
            cInsert += "        When Origem.D1QUANT <> 0 Then "
            cInsert += "            Origem.DEVQUANT * "
            cInsert += "                (Origem.D1CUSTO/Origem.D1QUANT) "
            cInsert += "        Else " //Notas de devolução de complemento de preço
            cInsert += "        Origem.D1CUSTO "
            cInsert += "    End "
            cInsert += " End "
            AAdd(aInsert, cInsert)
            AAdd(aInsert, cInsert)

            cMerge := ::MergeStatement(::TableName(), cQuery, aMatch, aUpdate, aCpoDest, aInsert)

            ::RunQuery(cMerge)
        Next nMoeda
    Next nFil

    //Abate o saldo devolvido da tabela de processamento
    If ::oQueryPurchRetPrevProc == Nil
        cQuery := " Select "
        cQuery += " DEV.FILPROC   FILPROC, "
        If ::cCusFil != "E"
            cQuery += " DEV.FILIAL    FILIAL, "
        Else
            If ::lPostgres
                cQuery += " Char("+cValToChar(FWSizeFilial())+") "
            EndIf
            cQuery += " '"+PadR(FWCompany(), FWSizeFilial())+"' FILIAL, "
        EndIf
        cQuery += " DEV.COD       COD, "
        If ::cCusFil == "A"
            cQuery += " DEV.LOCARM    ARMAZEM, "
        EndIf
        cQuery += " DEVCP.CODPAR CODPAR, "
        cQuery += " DEVCP.MOEDA MOEDA, "
        cQuery += " Sum(DEVCP.CUSTO) CUSTO, "
        cQuery += " Sum(DEV.QUANT) QUANT "
        cQuery += " From "
        cQuery += RetSQLName("SD2")+" SD2 "
        cQuery += " Inner Join "+cMovAnlTab+" DEV On "
        cQuery += " DEV.FILPROC    = ? And "
        cQuery += " DEV.ALIAS      = ? And " //SD2
        cQuery += " DEV.RECNO      = SD2.R_E_C_N_O_ "
        cQuery += " Inner Join "+::TableName()+" DEVCP On " //<- Inner join para atualizar somente os que existirem, demais já seriam custo zero e não fariam diferença no cálculo
        cQuery += " DEVCP.RECPAI = DEV.R_E_C_N_O_  "
        cQuery += " Inner Join "+RetSQLName("SD1")+" SD1 On "
        cQuery += " SD1.D1_FILIAL  = SD2.D2_FILIAL  And "
        cQuery += " SD1.D1_DOC     = SD2.D2_NFORI   And "
        cQuery += " SD1.D1_SERIE   = SD2.D2_SERIORI And "
        cQuery += " SD1.D1_ITEM    = SD2.D2_ITEMORI And "
        cQuery += " SD1.D1_FORNECE = SD2.D2_CLIENTE And "
        cQuery += " SD1.D1_LOJA    = SD2.D2_LOJA    And "
        cQuery += " SD1.D1_DTDIGIT < ? "
        cQuery += " Inner Join "+RetSQLName('SF4')+" SF4 On "
        cQuery += " SF4.F4_FILIAL  = ? And "
        cQuery += " SF4.F4_CODIGO  = SD1.D1_TES And "
        cQuery += " SF4.F4_ESTOQUE = ? And "
        cQuery += " SF4.F4_PODER3  In (?, ?) And " //Poder de 3º será trabalhado em outro método
        cQuery += " SF4.D_E_L_E_T_ = ? "        
        cQuery += " Inner Join "+cProcTable+" PRC On "
        cQuery += " PRC.FILPROC = DEV.FILPROC And "
        If ::cCusFil != "E"
            cQuery += " PRC.FILIAL  = DEV.FILIAL  And "
        EndIf
        cQuery += " PRC.COD     = DEV.COD      "
        If ::cCusFil == 'A'
            cQuery += " And PRC.ARMAZEM = DEV.LOCARM  "
        EndIf
        cQuery += " Left Join "+cProcTabCP+" PRCCP On "
        cQuery += " PRCCP.FILPROC = DEV.FILPROC And "
        If ::cCusFil != "E"
            cQuery += " PRCCP.FILIAL  = DEV.FILIAL  And "
        EndIf
        cQuery += " PRCCP.COD     = DEV.COD      "
        If ::cCusFil == 'A'
            cQuery += " And PRCCP.ARMAZEM = DEV.LOCARM  "
        EndIf
        cQuery += " And "
        cQuery += " PRCCP.CODPAR = DEVCP.CODPAR And "
        cQuery += " PRCCP.MOEDA  = DEVCP.MOEDA "
        cQuery += " Where "
        cQuery += " SD2.D2_FILIAL  =  ? And "
        cQuery += " SD2.D2_EMISSAO >= ? And "
        cQuery += " SD2.D2_EMISSAO <= ? And "
        cQuery += " SD2.D2_TIPO    =  ? And "
        cQuery += " SD2.D_E_L_E_T_ =  ? "
        cQuery += " Group By "
        cQuery += " DEV.FILPROC, "
        If ::cCusFil != "E"
            cQuery += " DEV.FILIAL, "
        EndIf
        cQuery += " DEV.COD, "
        If ::cCusFil == "A"
            cQuery += " DEV.LOCARM, "
        EndIf
        cQuery += " DEVCP.CODPAR, "
        cQuery += " DEVCP.MOEDA "
       
        cQuery := ChangeQuery(cQuery)

        ::oQueryPurchRetPrevProc := FWExecStatement():New(cQuery)
    EndIf

    For nFil := 1 To Len(::aFilProc)
        cFilAtu := ::aFilProc[nFil, 1]

        ASize(aBind, 0)
        aBind := {}
        AAdd(aBind, cFilProc) //FILPROC
        AAdd(aBind, 'SD2') //ALIAS
        AAdd(aBind, DToS(dDtIni)) //D1_DTDIGIT
        AAdd(aBind, FWXFilial('SF4', cFilAtu)) //F4_FILIAL
        AAdd(aBind, 'S') //SF4.F4_ESTOQUE
        AAdd(aBind, ' ') //SF4.F4PODER3
        AAdd(aBind, 'N') //SF4.F4PODER3
        AAdd(aBind, ' ') //SF4.D_E_L_E_T_
        AAdd(aBind, cFilAtu) //D2_FILIAL
        AAdd(aBind, DToS(dDtIni)) //D2_EMISSAO
        AAdd(aBind, DToS(dDtFim)) //D2_EMISSAO
        AAdd(aBind, 'D') //D2_TIPO
        AAdd(aBind, ' ') //D_E_L_E_T_

        For nI := 1 To Len(aBind)
            ::oQueryPurchRetPrevProc:SetString(nI, aBind[nI])
        Next nI

        cQuery := ::oQueryPurchRetPrevProc:GetFixQuery()

        //Filtro
        ASize(aMatch, 0)
        aMatch := {}
        AAdd(aMatch, {"FILPROC", "'"+cFilProc+"'"})
        If ::cCusFil != "E"
            AAdd(aMatch, {"FILIAL", "FILIAL"})
        EndIf
        AAdd(aMatch, {"COD", "COD"})
        If ::cCusFil == "A"
            AAdd(aMatch, {"ARMAZEM", "ARMAZEM"})
        EndIf
        AAdd(aMatch, {"CODPAR", "CODPAR"})
        AAdd(aMatch, {"MOEDA", "MOEDA"})

        //Expressões de update
        ASize(aUpdate, 0)
        aUpdate := {}
        AAdd(aUpdate, "CSTHIST = Destino.CSTHIST - Origem.CUSTO")
        AAdd(aUpdate, "CSTPROC = Destino.CSTPROC - Origem.CUSTO")
        AAdd(aUpdate, "QTDHIST = Destino.QTDHIST - Origem.QUANT")
        AAdd(aUpdate, "QTDPROC = Destino.QTDPROC - Origem.QUANT")
        cUpdate := "CMHIST = "
        cUpdate += "   Case "
        cUpdate += "       When (Destino.QTDHIST - Origem.QUANT) <> 0"
        cUpdate += "       Then (Destino.CSTHIST - Origem.CUSTO) "
        cUpdate += "       / (Destino.QTDHIST - Origem.QUANT) "
        cUpdate += "       Else Destino.CMHIST"
        cUpdate += "   End "
        AAdd(aUpdate, cUpdate)
        cUpdate := "CMPROC = "
        cUpdate += "   Case "
        cUpdate += "       When (Destino.QTDPROC - Origem.QUANT) <> 0"
        cUpdate += "       Then (Destino.CSTPROC - Origem.CUSTO) "
        cUpdate += "       / (Destino.QTDPROC - Origem.QUANT) "
        cUpdate += "       Else Destino.CMPROC"
        cUpdate += "   End "
        AAdd(aUpdate, cUpdate)

        //Expressões de insert
        ASize(aCpoDest, 0)
        aCpoDest := {}
        AAdd(aCpoDest, "FILPROC")
        AAdd(aCpoDest, "FILIAL")
        AAdd(aCpoDest, "COD")
        If ::cCusFil == "A"
            AAdd(aCpoDest, "ARMAZEM")
        EndIf
        AAdd(aCpoDest, "CODPAR")
        AAdd(aCpoDest, "MOEDA")
        AAdd(aCpoDest, "QTDHIST")
        AAdd(aCpoDest, "QTDPROC")
        AAdd(aCpoDest, "CSTHIST")
        AAdd(aCpoDest, "CSTPROC")
        AAdd(aCpoDest, "CMHIST")
        AAdd(aCpoDest, "CMPROC")

        ASize(aInsert, 0)
        aInsert := {}
        AAdd(aInsert, "'"+cFilProc+"'")
        AAdd(aInsert, "Origem.FILIAL")
        AAdd(aInsert, "Origem.COD")
        If ::cCusFil == "A"
            AAdd(aInsert, "Origem.ARMAZEM")
        EndIf
        AAdd(aInsert, "Origem.CODPAR")
        AAdd(aInsert, "Origem.MOEDA")
        AAdd(aInsert, "-Origem.QUANT")
        AAdd(aInsert, "-Origem.QUANT")
        AAdd(aInsert, "-Origem.CUSTO")
        AAdd(aInsert, "-Origem.CUSTO")
        cInsert := "Case "
        cInsert += "When Origem.QUANT <> 0 "
        cInsert += "Then Origem.CUSTO/Origem.QUANT "
        cInsert += "Else 0 "
        cInsert += "End"
        AAdd(aInsert, cInsert)
        cInsert := "Case "
        cInsert += "When Origem.QUANT <> 0 "
        cInsert += "Then Origem.CUSTO/Origem.QUANT "
        cInsert += "Else 0 "
        cInsert += "End"
        AAdd(aInsert, cInsert)

        cMerge := ::MergeStatement(cProcTabCP, cQuery, aMatch, aUpdate, aCpoDest, aInsert)

        ::RunQuery(cMerge)
    Next nFil

    //Para notas não pré processadas pela View de custo de aquisição:
    //  Se a devolução ocorrer no período, deve:
    //      Marcar a nota de devolução como ingorada
    //      Abater o saldo proporcional da nota de compras e ajustar custo
    //  Se a devolução ocorrer fora do período, deve:
    //      Avaliar a regra do parâmetro MV_ADEVCOM para definir se a nota será devolvida
    //      com o custo original ou o custo médio
    //      Abater o saldo devolvido da tabela de processamento

    //Notas dentro do período
    //Marca as notas de devolução como ignoradas e calcula o custo proporcional da devolução
    If ::oQueryOtherInflowRet == Nil
        cQuery := " Select "
        cQuery += " DEV.FILIAL FILIAL, "
        cQuery += " SD1.D1_QUANT D1QUANT, "
        For nMoeda := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nMoeda]
            cQuery += " D1_CUSTO"
            If nMoeda > 1
                cQuery += cMoeda
            EndIf
            cQuery += " D1CUSTO"+cMoeda+" , "
        Next nMoeda
        cQuery += " Coalesce(D4G.D4G_CODPAR, '"+cOutros+"') CODPAR, "
        cQuery += " DEV.QUANT DEVQUANT, "
        cQuery += " DEV.R_E_C_N_O_ RECNUMBER "
        cQuery += " From "+cMovAnlTab+" DEV "
        cQuery += " Inner Join "+RetSQLName("SD2")+" SD2 On "
        cQuery += " SD2.R_E_C_N_O_ = DEV.RECNO "
        cQuery += " Inner Join "+RetSQLName("SD1")+" SD1 On "
        cQuery += " SD1.D1_FILIAL  = SD2.D2_FILIAL  And "
        cQuery += " SD1.D1_DOC     = SD2.D2_NFORI   And "
        cQuery += " SD1.D1_SERIE   = SD2.D2_SERIORI And "
        cQuery += " SD1.D1_ITEM    = SD2.D2_ITEMORI And "
        cQuery += " SD1.D1_FORNECE = SD2.D2_CLIENTE And "
        cQuery += " SD1.D1_LOJA    = SD2.D2_LOJA    And "
        cQuery += " SD1.D1_EMISSAO >= ? And "
        cQuery += " SD1.D1_EMISSAO <= ? And "
        cQuery += " SD1.D_E_L_E_T_ = ? "
        cQuery += " Left Join "+RetSQLName('D4G')+" D4G On "
        cQuery += " D4G.D4G_FILIAL  = ?  And "
        cQuery += " D4G.D4G_PRODUT  = SD1.D1_COD     And "
        cQuery += " D4G.D_E_L_E_T_  = ? "
        cQuery += " Inner Join "+cMovAnlTab+" COM On "
        cQuery += " COM.FILPROC = ? And "
        cQuery += " COM.ALIAS = ? And "
        cQuery += " COM.RECNO = SD1.R_E_C_N_O_ "
        cQuery += " Where "
        cQuery += " DEV.FILPROC = ? And "
        cQuery += " DEV.ALIAS   = ? And "
        cQuery += " DEV.FILIAL  = ? And "
        cQuery += " DEV.TIPONF  = ? " //D2_TIPO = D
       
        cQuery := ChangeQuery(cQuery)

        ::oQueryOtherInflowRet := FWExecStatement():New(cQuery)
    EndIf

    For nFil := 1 To Len(::aFilProc)
        cFilAtu := ::aFilProc[nFil, 1]
        For nMoeda := 1 To Len(::jParams['moedas'])
            cMoeda := ::jParams['moedas',nMoeda]
            cMoedaIns := StrZero(Val(cMoeda), 2)

            ASize(aBind, 0)
            aBind := {}
            AAdd(aBind, DToS(dDtIni)) //D1_EMISSAO
            AAdd(aBind, DToS(dDtFim)) //D1_EMISSAO
            AAdd(aBind, ' ') //D_E_L_E_T_
            AAdd(aBind, FWXFilial('D4G', cFilAtu)) //D4G_FILIAL
            AAdd(aBind, ' ') //D_E_L_E_T_
            AAdd(aBind, cFilProc) //FILPROC
            AAdd(aBind, 'SD1') //ALIAS
            AAdd(aBind, cFilProc) //FILPROC
            AAdd(aBind, 'SD2') //ALIAS
            AAdd(aBind, cFilAtu) //FILIAL
            AAdd(aBind, 'D') //TIPONF        

            For nI := 1 To Len(aBind)
                ::oQueryOtherInflowRet:SetString(nI, aBind[nI])
            Next nI

            cQuery := ::oQueryOtherInflowRet:GetFixQuery()

            //Filtro
            ASize(aMatch, 0)
            aMatch := {}
            AAdd(aMatch, {"RECNUMBER", "RECPAI"})
            AAdd(aMatch, {"CODPAR", "CODPAR"})
            AAdd(aMatch, {"'"+cMoedaIns+"'", "MOEDA"})
            AAdd(aMatch, {"'"+cFilProc+"'", "FILPROC"})
            AAdd(aMatch, {"FILIAL", "FILIAL"})

            //Expressões de update
            ASize(aUpdate, 0)
            aUpdate := {}
            cUpdate := " CUSTO = "
            cUpdate += " Case "
            cUpdate += "    When Origem.D1QUANT <> 0 Then "
            cUpdate += "       Origem.DEVQUANT * (Origem.D1CUSTO"+cMoeda+"/Origem.D1QUANT) "
            cUpdate += "    Else " //Notas de devolução de complemento de preço
            cUpdate += "       Origem.D1CUSTO"+cMoeda+" "
            cupdate += " End "
            AAdd(aUpdate, cUpdate)

            cUpdate := " CSTORI = "
            cUpdate += " Case "
            cUpdate += "    When Origem.D1QUANT <> 0 Then "
            cUpdate += "       Origem.DEVQUANT * (Origem.D1CUSTO"+cMoeda+"/Origem.D1QUANT) "
            cUpdate += "    Else " //Notas de devolução de complemento de preço
            cUpdate += "       Origem.D1CUSTO"+cMoeda+" "
            cupdate += " End "
            AAdd(aUpdate, cUpdate)

            //Expressões de insert
            ASize(aCpoDest, 0)
            aCpoDest := {}
            AAdd(aCpoDest, "FILPROC")
            AAdd(aCpoDest, "FILIAL")
            AAdd(aCpoDest, "RECPAI")
            AAdd(aCpoDest, "CODPAR")
            AAdd(aCpoDest, "MOEDA")
            AAdd(aCpoDest, "CUSTO")
            AAdd(aCpoDest, "CSTORI")
            
            ASize(aInsert, 0)
            aInsert := {}
            AAdd(aInsert, "'"+cFilProc+"'")
            AAdd(aInsert, "Origem.FILIAL")
            AAdd(aInsert, "Origem.RECNUMBER")
            AAdd(aInsert, "Origem.CODPAR")
            AAdd(aInsert, "'"+cMoedaIns+"'")
            cInsert := " Case "
            cInsert += "    When Origem.D1QUANT <> 0 Then "
            cInsert += "       Origem.DEVQUANT * (Origem.D1CUSTO"+cMoeda+"/Origem.D1QUANT) "
            cInsert += "    Else " //Notas de devolução de complemento de preço
            cInsert += "       Origem.D1CUSTO"+cMoeda+" "
            cInsert += " End "
            AAdd(aInsert, cInsert)
            AAdd(aInsert, cInsert)

            cMerge := ::MergeStatement(::TableName(), cQuery, aMatch, aUpdate, aCpoDest, aInsert)

            ::RunQuery(cMerge)
        Next nMoeda
    Next nFil

    //Abate o saldo das notas de devolução nas notas de compras
    If ::oQueryOtherInflowRetProc == Nil
        cQuery := " Select "
        cQuery += " COM.FILPROC FILPROC, "
        cQuery += " COM.FILIAL FILIAL, "
        cQuery += " COM.R_E_C_N_O_ COMRECNO, "
        cQuery += " Coalesce(DEVCP.CODPAR, '"+cOutros+"') CODPAR, "
        cQuery += " Coalesce(DEVCP.MOEDA, '01') MOEDA, "
        cQuery += " Sum(DEVCP.CUSTO) DEVCUSTO "
        cQuery += " From "+cMovAnlTab+" DEV "
        cQuery += " Left Join "+::TableName()+" DEVCP On "
        cQuery += " DEVCP.RECPAI = DEV.R_E_C_N_O_ "
        cQuery += " Inner Join "+RetSQLName("SD2")+" SD2 On "
        cQuery += " SD2.R_E_C_N_O_ = DEV.RECNO "
        cQuery += " Inner Join "+RetSQLName("SD1")+" SD1 On "
        cQuery += " SD1.D1_FILIAL  = SD2.D2_FILIAL  And "
        cQuery += " SD1.D1_DOC     = SD2.D2_NFORI   And "
        cQuery += " SD1.D1_SERIE   = SD2.D2_SERIORI And "
        cQuery += " SD1.D1_ITEM    = SD2.D2_ITEMORI And "
        cQuery += " SD1.D1_FORNECE = SD2.D2_CLIENTE And "
        cQuery += " SD1.D1_LOJA    = SD2.D2_LOJA    And "
        cQuery += " SD1.D1_EMISSAO >= ? And "
        cQuery += " SD1.D1_EMISSAO <= ? And "
        cQuery += " SD1.D_E_L_E_T_ = ?"
        cQuery += " Inner Join "+cMovAnlTab+" COM On "
        cQuery += " COM.FILPROC = ? And "
        cQuery += " COM.ALIAS   = ? And " //SD1
        cQuery += " COM.RECNO   = SD1.R_E_C_N_O_ "
        cQuery += " Where "
        cQuery += " DEV.FILPROC = ? And "
        cQuery += " DEV.FILIAL  = ? And "
        cQuery += " DEV.ALIAS   = ? And " //SD2
        cQuery += " DEV.TIPONF  = ? " //D-Devolução
        cQuery += " Group By "
        cQuery += " COM.FILPROC, "
        cQuery += " COM.FILIAL, "
        cQuery += " COM.R_E_C_N_O_, "
        cQuery += " DEVCP.CODPAR, "
        cQuery += " DEVCP.MOEDA "
       
        cQuery := ChangeQuery(cQuery)

        ::oQueryOtherInflowRetProc := FWExecStatement():New(cQuery)
    EndIf

    For nFil := 1 To Len(::aFilProc)
        cFilAtu := ::aFilProc[nFil, 1]

        ASize(aBind, 0)
        aBind := {}
        AAdd(aBind, DToS(dDtIni)) //D1_EMISSAO
        AAdd(aBind, DToS(dDtFim)) //D1_EMISSAO
        AAdd(aBind, ' ') //D_E_L_E_T_
        AAdd(aBind, cFilProc) //FILPROC
        AAdd(aBind, 'SD1') //ALIAS
        AAdd(aBind, cFilProc) //FILPROC
        AAdd(aBind, cFilAtu) //FILIAL
        AAdd(aBind, 'SD2') //ALIAS
        AAdd(aBind, 'D') //TIPONF

        For nI := 1 To Len(aBind)
            ::oQueryOtherInflowRetProc:SetString(nI, aBind[nI])
        Next nI

        cQuery := ::oQueryOtherInflowRetProc:GetFixQuery()

        //Filtro
        ASize(aMatch, 0)
        aMatch := {}
        AAdd(aMatch, {"COMRECNO", "RECPAI"})
        AAdd(aMatch, {"CODPAR", "CODPAR"})
        AAdd(aMatch, {"MOEDA", "MOEDA"})
        AAdd(aMatch, {"FILPROC", "FILPROC"})
        AAdd(aMatch, {"FILIAL", "FILIAL"})

        //Expressões de update
        ASize(aUpdate, 0)
        aUpdate := {}
        cUpdate := "CUSTO = Destino.CUSTO - Origem.DEVCUSTO"
        AAdd(aUpdate, cUpdate)

        //Expressões de insert
        ASize(aCpoDest, 0)
        aCpoDest := {}
        AAdd(aCpoDest, "FILPROC")
        AAdd(aCpoDest, "FILIAL")
        AAdd(aCpoDest, "RECPAI")
        AAdd(aCpoDest, "CODPAR")
        AAdd(aCpoDest, "MOEDA")
        AAdd(aCpoDest, "CUSTO")
        //Custo original já deverá estar preenchido
        
        ASize(aInsert, 0)
        aInsert := {}
        AAdd(aInsert, "Origem.FILPROC")
        AAdd(aInsert, "Origem.FILIAL")
        AAdd(aInsert, "Origem.COMRECNO")
        AAdd(aInsert, "Origem.CODPAR")
        AAdd(aInsert, "Origem.MOEDA")
        AAdd(aInsert, "-Origem.DEVCUSTO")

        cMerge := ::MergeStatement(::TableName(), cQuery, aMatch, aUpdate, aCpoDest, aInsert)

        ::RunQuery(cMerge)
    Next nFil

    FWFreeArray(aBind)
    FWFreeArray(aInsert)
    FWFreeArray(aCpoDest)
    FWFreeArray(aUpdate)
    FWFreeArray(aMatch)
Return

/*/{Protheus.doc} InitAvgCost
    Grava os movimentos valorizados a custo médio na tabela analitica em partes

    @type Method
    @author Squad Entradas
    @since 11/03/2025
    /*/
Method InitAvgCost(cFilProc) Class AnalyticalMovementPartsTable
    Local cQuery  := ""
    Local cUpdate := ""
    Local cCTE    := ""
    Local nFil    := ""
    Local cFilAtu := ""
    Local aBind   := {}
    Local nI      := 0
    Local cNull      := MatIsNull()
    Local cProcTable := ProcessingTable():TableName()
    Local cProcTabCP := PartsProcessingTable():TableName()
    Local cMovAnlTab := AnalyticalMovementTable():TableName()
    Local nMoeda  := 0
    Local cMoeda  := ''
    Local cMoedaIns := ''
    Local aMatch  := {}
    Local aUpdate := {}
    Local cUpdate := "" 
    Local aCpoDest := {}
    Local aInsert  := {}
    Local cInsert  := ''
    Local cMerge  := ""
    Local cOutros := Replicate('9', TamSX3('D4G_CODPAR')[1])
    Local cRevAtiv := ""
    Local dDtIni    As date
    Local dDtFim    As date

    If ::oQueryAvgCostMov == Nil
        cQuery := " Select "
        cQuery += " ANL.R_E_C_N_O_ RECPAI, "
        cQuery += " ANL.FILPROC FILPROC, "
        cQuery += " ANL.FILIAL FILIAL, "
        cQuery += " PRCCP.CODPAR CODPAR, "
        cQuery += " PRCCP.MOEDA MOEDA, "
        cQuery += " (ANL.QUANT * PRCCP.CMHIST) CUSTO, "
        cQuery += " (ANL.QTDORI * PRCCP.CMHIST) CSTORI "
        cQuery += " From "+cMovAnlTab+" ANL "
        cQuery += " Inner Join "+cProcTabCP+" PRCCP "
        cQuery += " On "
        cQuery += " PRCCP.FILPROC = ANL.FILPROC And "
        If ::cCusFil != "E"
            cQuery += " PRCCP.FILIAL  = ANL.FILIAL  And "
        EndIf
        cQuery += " PRCCP.COD     = ANL.COD      "
        If ::cCusFil == "A"
            cQuery += " And PRCCP.ARMAZEM = ANL.LOCARM   "
        EndIf
        cQuery += " Where "
        cQuery += " ANL.FILPROC = ? And "
        cQuery += " ANL.FILIAL  = ? And "
        cQuery += " ANL.CUSTOMEDIO = ? "

        cQuery := ChangeQuery(cQuery)

        ::oQueryAvgCostMov := FWExecStatement():New(cQuery)
    EndIf

    For nFil := 1 To Len(::aFilProc)
        cFilAtu := ::aFilProc[nFil, 1]
        ASize(aBind, 0)
        aBind := {}
        AAdd(aBind, cFilProc) //FILPROC
        AAdd(aBind, cFilAtu) //FILIAL
        AAdd(aBind, 'S') //CUSTOMEDIO

        For nI := 1 To Len(aBind)
            ::oQueryAvgCostMov:SetString(nI, aBind[nI])
        Next nI

        cQuery := ::oQueryAvgCostMov:GetFixQuery()

        //Filtro
        ASize(aMatch, 0)
        aMatch := {}
        AAdd(aMatch, {"RECPAI", "RECPAI"})
        AAdd(aMatch, {"CODPAR", "CODPAR"})
        AAdd(aMatch, {"MOEDA", "MOEDA"})
        AAdd(aMatch, {"FILPROC", "FILPROC"})
        AAdd(aMatch, {"FILIAL", "FILIAL"})

        //Expressões de update
        ASize(aUpdate, 0)
        aUpdate := {}
        cUpdate := " CUSTO = Origem.CUSTO "
        cUpdate := " CSTORI = Origem.CSTORI "
        AAdd(aUpdate, cUpdate)

        //Expressões de insert
        ASize(aCpoDest, 0)
        aCpoDest := {}
        AAdd(aCpoDest, "FILPROC")
        AAdd(aCpoDest, "FILIAL")
        AAdd(aCpoDest, "RECPAI")
        AAdd(aCpoDest, "CODPAR")
        AAdd(aCpoDest, "MOEDA")
        AAdd(aCpoDest, "CUSTO")
        AAdd(aCpoDest, "CSTORI")
        
        ASize(aInsert, 0)
        aInsert := {}
        AAdd(aInsert, "Origem.FILPROC")
        AAdd(aInsert, "Origem.FILIAL")
        AAdd(aInsert, "Origem.RECPAI")
        AAdd(aInsert, "Origem.CODPAR")
        AAdd(aInsert, "Origem.MOEDA")
        AAdd(aInsert, "Origem.CUSTO")
        AAdd(aInsert, "Origem.CSTORI")

        cMerge := ::MergeStatement(::TableName(), cQuery, aMatch, aUpdate, aCpoDest, aInsert)

        ::RunQuery(cMerge)
    Next nFil

    FWFreeArray(aBind)
    FWFreeArray(aInsert)
    FWFreeArray(aCpoDest)
    FWFreeArray(aUpdate)
    FWFreeArray(aMatch)
Return

/*/{Protheus.doc} IgnoreSalesReturn
    Marca os movimentos de devolução de vendas onde a venda ocorreu no mesmo período. 
    Abate o custo e quantidade do movimento de venda, eventualmente marcando-o como ignorado.
    Quando a venda ocorre fora do período, avalia o parâmetro MV_CUSTDEV para definir se o custo
    devolvido será o custo original ou custo médio.

    O campo F4_DEVZERO não terá implementação inicial, pois a sua regra não se adequa a execução com loop.
    @type Method
    @author Squad Entradas
    @since 24/01/2024
    /*/
Method IgnoreSalesReturn(cFilProc) Class AnalyticalMovementPartsTable
    Local cQuery  := ""
    Local cUpdate := ""
    Local cCTE    := ""
    Local nFil    := ""
    Local cFilAtu := ""
    Local aBind   := {}
    Local nI      := 0
    Local cNull      := MatIsNull()
    Local cProcTable := ProcessingTable():TableName()
    Local cProcTabCP := PartsProcessingTable():TableName()
    Local cMovAnlTab := AnalyticalMovementTable():TableName()
    Local nMoeda  := 0
    Local cMoeda  := ''
    Local cMoedaIns := ''
    Local aMatch  := {}
    Local aUpdate := {}
    Local cUpdate := "" 
    Local aCpoDest := {}
    Local aInsert  := {}
    Local cInsert  := ''
    Local cMerge  := ""
    Local cOutros := Replicate('9', TamSX3('D4G_CODPAR')[1])
    Local cRevAtiv := ""
    Local dDtIni    As date
    Local dDtFim    As date

    //Notas dentro do período são valorizadas a custo médio, não é necessário pré
    //calcular o custo em partes delas.
    //Os tratamentos de quantidade/flags já foram feitos na IgnoreSalesReturn
    //da table.analyticalmoevementtable

    If ::jParams["MV_CUSTDEV"] 
        //As dev. vendas fora do período retornam com custo médio
        //logo, as notas de dev. vendas serão processadas dentro do loop.
        //Não deve ser ajustado nenhum custo na tabela de processamento.
        //Os tratamentos de quantidade/flags já foram feitos na IgnoreSalesReturn
        //da table.analyticalmoevementtable
        Return
    EndIf

    dDtIni := ::jParams['dataini']
    dDtFim := ::jParams['datafin']
    cRevAtiv := ::jParams['revisao_vigente']  
    
    //Avalia as devoluções de vendas que ocorreram fora do período
    If ::oQuerySalesRetPrev == Nil
        cQuery := " Select "
        cQuery += " DEV.FILPROC FILPROC, "
        cQuery += " DEV.FILIAL FILIAL, "
        cQuery += " DEV.QUANT DEVQUANT, "
        cQuery += " SD2.D2_QUANT QTDORI, "
        cQuery += " SD2CP.D4M_PARTE CODPAR, "
        cQuery += " SD2CP.D4M_MOEDA MOEDA, "
        cQuery += " SD2CP.D4M_TOTAL CUSTO, "
        cQuery += " DEV.R_E_C_N_O_ RECNUMBER "
        cQuery += " From "+cMovAnlTab+" DEV "
        cQuery += " Inner Join "+RetSQLName("SD1")+" SD1 On "
        cQuery += " SD1.R_E_C_N_O_ = DEV.RECNO "
        cQuery += " Inner Join "+RetSQLName("SD2")+" SD2 On "
        cQuery += " SD2.D2_FILIAL  = SD1.D1_FILIAL  And "
        cQuery += " SD2.D2_DOC     = SD1.D1_NFORI   And "
        cQuery += " SD2.D2_SERIE   = SD1.D1_SERIORI And "
        cQuery += " SD2.D2_ITEM    = SD1.D1_ITEMORI And "
        cQuery += " SD2.D2_CLIENTE = SD1.D1_FORNECE And "
        cQuery += " SD2.D2_LOJA    = SD1.D1_LOJA    And "
        cQuery += " SD2.D2_EMISSAO < ? And "
        cQuery += " SD2.D_E_L_E_T_ = ? "
        cQuery += " Inner Join "+RetSQLName("D4M")+" SD2CP On "
        cQuery += " SD2CP.D4M_FILIAL = SD2.D2_FILIAL  And "
        cQuery += " SD2CP.D4M_DOC    = SD2.D2_DOC     And "
        cQuery += " SD2CP.D4M_SERIE  = SD2.D2_SERIE   And "
        cQuery += " SD2CP.D4M_ITEM   = SD2.D2_ITEM    And "
        cQuery += " SD2CP.D4M_CLIENT = SD2.D2_CLIENTE And "
        cQuery += " SD2CP.D4M_LOJA   = SD2.D2_LOJA    And "
        cQuery += " SD2CP.D_E_L_E_T_ = ? "
        cQuery += " Where "
        cQuery += " DEV.FILPROC = ? And "
        cQuery += " DEV.ALIAS   = ? And "
        cQuery += " DEV.FILIAL  = ? And "
        cQuery += " DEV.TIPONF  = ? " //D1_TIPO = D
       
        cQuery := ChangeQuery(cQuery)

        ::oQuerySalesRetPrev := FWExecStatement():New(cQuery)
    EndIf

    For nFil := 1 To Len(::aFilProc)
        cFilAtu := ::aFilProc[nFil, 1]

        ASize(aBind, 0)
        aBind := {}
        AAdd(aBind, DToS(dDtIni)) //D2_EMISSAO
        AAdd(aBind, ' ') //D_E_L_E_T_
        AAdd(aBind, ' ') //D_E_L_E_T_
        AAdd(aBind, cFilProc) //FILPROC
        AAdd(aBind, 'SD1') //ALIAS
        AAdd(aBind, cFilAtu) //FILIAL        
        AAdd(aBind, 'D') //TIPONF        

        For nI := 1 To Len(aBind)
            ::oQuerySalesRetPrev:SetString(nI, aBind[nI])
        Next nI

        cQuery := ::oQuerySalesRetPrev:GetFixQuery()

        //Filtro
        ASize(aMatch, 0)
        aMatch := {}
        AAdd(aMatch, {"RECNUMBER", "RECPAI"})
        AAdd(aMatch, {"CODPAR", "CODPAR"})
        AAdd(aMatch, {"MOEDA", "MOEDA"})
        AAdd(aMatch, {"FILPROC", "FILPROC"})
        AAdd(aMatch, {"FILIAL", "FILIAL"})

        //Expressões de update
        ASize(aUpdate, 0)
        aUpdate := {}
        cUpdate := "CUSTO = "
        cUpdate += " Case "
        cUpdate += "     When Origem.QTDORI <> 0 "
        cUpdate += "     Then Origem.DEVQUANT * "
        cUpdate += "          (Origem.CUSTO / Origem.QTDORI) "
        cUpdate += "     Else Origem.CUSTO "
        cUpdate += " End "
        AAdd(aUpdate, cUpdate)
        cUpdate := "CSTORI = "
        cUpdate += " Case "
        cUpdate += "     When Origem.QTDORI <> 0 "
        cUpdate += "     Then Origem.DEVQUANT * "
        cUpdate += "          (Origem.CUSTO / Origem.QTDORI) "
        cUpdate += "     Else Origem.CUSTO "
        cUpdate += " End "
        AAdd(aUpdate, cUpdate)

        //Expressões de insert
        ASize(aCpoDest, 0)
        aCpoDest := {}
        AAdd(aCpoDest, "FILPROC")
        AAdd(aCpoDest, "FILIAL")
        AAdd(aCpoDest, "RECPAI")
        AAdd(aCpoDest, "CODPAR")
        AAdd(aCpoDest, "MOEDA")
        AAdd(aCpoDest, "CUSTO")
        AAdd(aCpoDest, "CSTORI")
        
        ASize(aInsert, 0)
        aInsert := {}
        AAdd(aInsert, "Origem.FILPROC")
        AAdd(aInsert, "Origem.FILIAL")
        AAdd(aInsert, "Origem.RECNUMBER")
        AAdd(aInsert, "Origem.CODPAR")
        AAdd(aInsert, "Origem.MOEDA")
        cInsert := " Case "
        cInsert += "     When Origem.QTDORI <> 0 "
        cInsert += "     Then Origem.DEVQUANT * "
        cInsert += "          (Origem.CUSTO / Origem.QTDORI) "
        cInsert += "     Else Origem.CUSTO "
        cInsert += " End "
        AAdd(aInsert, cInsert)
        AAdd(aInsert, cInsert)

        cMerge := ::MergeStatement(::TableName(), cQuery, aMatch, aUpdate, aCpoDest, aInsert)

        ::RunQuery(cMerge)
    Next nFil

    //Atualizar a tabela de processamento com as notas devolvidas com o custo original
    If ::oQuerySalesRetPrevProc == Nil
        cQuery := " Select "
        cQuery += " DEV.FILPROC FILPROC, "
        If ::cCusFil != "E"
            cQuery += " DEV.FILIAL FILIAL, "
        Else
            If ::lPostgres
                cQuery += " Char("+cValToChar(FWSizeFilial())+") "
            EndIf
            cQuery += " '"+PadR(FWCompany(), FWSizeFilial())+"' FILIAL, "
        EndIf
        cQuery += " DEV.COD COD, "
        If ::cCusFil == "A"
            cQuery += " DEV.LOCARM ARMAZEM, "
        EndIf
        cQuery += " DEVCP.CODPAR CODPAR, "
        cQuery += " DEVCP.MOEDA MOEDA, "
        cQuery += " Sum(DEV.QUANT) QUANT, "
        cQuery += " Sum(DEVCP.CUSTO) CUSTO "
        cQuery += " From "+cMovAnlTab+" DEV "
        cQuery += " Inner Join "+::TableName()+" DEVCP On "
        cQuery += " DEVCP.RECPAI = DEV.R_E_C_N_O_ "
        cQuery += " Inner Join "+RetSQLName("SD1")+" SD1 On "
        cQuery += " SD1.R_E_C_N_O_ = DEV.RECNO "
        cQuery += " Inner Join "+RetSQLName("SD2")+" SD2 On "
        cQuery += " SD2.D2_FILIAL  = SD1.D1_FILIAL  And "
        cQuery += " SD2.D2_DOC     = SD1.D1_NFORI   And "
        cQuery += " SD2.D2_SERIE   = SD1.D1_SERIORI And "
        cQuery += " SD2.D2_ITEM    = SD1.D1_ITEMORI And "
        cQuery += " SD2.D2_CLIENTE = SD1.D1_FORNECE And "
        cQuery += " SD2.D2_LOJA    = SD1.D1_LOJA    And "
        cQuery += " SD2.D2_EMISSAO < ? And "
        cQuery += " SD2.D_E_L_E_T_ = ?"
        cQuery += " Where "
        cQuery += " DEV.FILPROC = ? And "
        cQuery += " DEV.ALIAS   = ? And " //ALIAS = SD1
        cQuery += " DEV.FILIAL  = ? And "
        cQuery += " DEV.TIPONF  = ? And " //D1_TIPO = D
        cQuery += " DEV.IGNORE  = ? And " //IGNORE = S
        cQuery += " DEV.CUSTOMEDIO = ? "  //CUSTOMEDIO = N
        cQuery += " Group By "
        cQuery += " DEV.FILPROC, "
        If ::cCusFil != "E"
            cQuery += " DEV.FILIAL, "
        EndIf
        cQuery += " DEV.COD "
        If ::cCusFil == "A"
            cQuery += ", DEV.LOCARM "
        EndIf
        cQuery += ", DEVCP.CODPAR, "
        cQuery += " DEVCP.MOEDA "
       
        cQuery := ChangeQuery(cQuery)

        ::oQuerySalesRetPrevProc := FWExecStatement():New(cQuery)
    EndIf

    For nFil := 1 To Len(::aFilProc)
        cFilAtu := ::aFilProc[nFil, 1]

        ASize(aBind, 0)
        aBind := {}
        AAdd(aBind, DToS(dDtIni)) //D2_EMISSAO
        AAdd(aBind, ' ') //D_E_L_E_T_
        AAdd(aBind, cFilProc) //FILPROC
        AAdd(aBind, 'SD1') //ALIAS
        AAdd(aBind, cFilAtu) //DEV.FILIAL
        AAdd(aBind, 'D') //DEV.TIPONF
        AAdd(aBind, 'S') //DEV.IGNORE
        AAdd(aBind, 'N') //DEV.CUSTOMEDIO

        For nI := 1 To Len(aBind)
            ::oQuerySalesRetPrevProc:SetString(nI, aBind[nI])
        Next nI

        cQuery := ::oQuerySalesRetPrevProc:GetFixQuery()

        //Filtro
        ASize(aMatch, 0)
        aMatch := {}
        AAdd(aMatch, {"FILPROC", "FILPROC"})
        If ::cCusFil != "E"
            AAdd(aMatch, {"FILIAL", "FILIAL"})
        EndIf
        AAdd(aMatch, {"COD", "COD"})
        If ::cCusFil == "A"
            AAdd(aMatch, {"ARMAZEM", "ARMAZEM"})
        EndIf
        AAdd(aMatch, {"CODPAR", "CODPAR"})
        AAdd(aMatch, {"MOEDA", "MOEDA"})

        //Expressões de update
        ASize(aUpdate, 0)
        aUpdate := {}
        AAdd(aUpdate, "CSTHIST = Destino.CSTHIST + Origem.CUSTO")
        AAdd(aUpdate, "CSTPROC = Destino.CSTPROC + Origem.CUSTO")
        AAdd(aUpdate, "QTDHIST = Destino.QTDHIST + Origem.QUANT")
        AAdd(aUpdate, "QTDPROC = Destino.QTDPROC + Origem.QUANT")
        cUpdate := "CMHIST = "
        cUpdate += "Case "
        cUpdate += "   When (Destino.QTDHIST + Origem.QUANT) <> 0 "
        cUpdate += "   Then (Destino.CSTHIST + Origem.CUSTO) "
        cUpdate += "   / (Destino.QTDHIST + Origem.QUANT) "
        cUpdate += "   Else Destino.CMHIST "
        cUpdate += "End"
        AAdd(aUpdate, cUpdate)
        cUpdate := "CMPROC = "
        cUpdate += "Case "
        cUpdate += "   When (Destino.QTDPROC + Origem.QUANT) <> 0 "
        cUpdate += "   Then (Destino.CSTPROC + Origem.CUSTO) "
        cUpdate += "   / (Destino.QTDPROC + Origem.QUANT) "
        cUpdate += "   Else Destino.CMPROC "
        cUpdate += "End"
        AAdd(aUpdate, cUpdate)

        //Expressões de insert
        ASize(aCpoDest, 0)
        aCpoDest := {}
        AAdd(aCpoDest, "FILPROC")
        AAdd(aCpoDest, "FILIAL")
        AAdd(aCpoDest, "COD")
        If ::cCusFil == "A"
            AAdd(aCpoDest, "ARMAZEM")
        EndIf
        AAdd(aCpoDest, "CODPAR")
        AAdd(aCpoDest, "MOEDA")
        AAdd(aCpoDest, "QTDHIST")
        AAdd(aCpoDest, "QTDPROC")
        AAdd(aCpoDest, "CSTHIST")
        AAdd(aCpoDest, "CSTPROC")
        AAdd(aCpoDest, "CMHIST")
        AAdd(aCpoDest, "CMPROC")       
        
        ASize(aInsert, 0)
        aInsert := {}
        AAdd(aInsert, "'"+cFilProc+"'")
        AAdd(aInsert, "Origem.FILIAL")
        AAdd(aInsert, "Origem.COD")
        If ::cCusFil == "A"
            AAdd(aInsert, "Origem.ARMAZEM")
        EndIf
        AAdd(aInsert, "Origem.CODPAR")
        AAdd(aInsert, "Origem.MOEDA")
        AAdd(aInsert, "Origem.QUANT")
        AAdd(aInsert, "Origem.QUANT")
        AAdd(aInsert, "Origem.CUSTO")
        AAdd(aInsert, "Origem.CUSTO")
        cInsert := "Case "
        cInsert += "When Origem.QUANT <> 0 "
        cInsert += "Then Origem.CUSTO/Origem.QUANT "
        cInsert += "Else 0 "
        cInsert += "End"
        AAdd(aInsert, cInsert)
        cInsert := "Case "
        cInsert += "When Origem.QUANT <> 0 "
        cInsert += "Then Origem.CUSTO/Origem.QUANT "
        cInsert += "Else 0 "
        cInsert += "End"
        AAdd(aInsert, cInsert)

        cMerge := ::MergeStatement(cProcTabCP, cQuery, aMatch, aUpdate, aCpoDest, aInsert)

        ::RunQuery(cMerge)
    Next nFil

    FWFreeArray(aBind)
    FWFreeArray(aInsert)
    FWFreeArray(aCpoDest)
    FWFreeArray(aUpdate)
    FWFreeArray(aMatch)
Return

