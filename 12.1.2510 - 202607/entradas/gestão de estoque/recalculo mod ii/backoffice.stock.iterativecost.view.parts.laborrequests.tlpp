#include "Totvs.ch"
#include "tlpp-core.th"

Namespace totvs.protheus.backoffice.stock.iterativecost.view.parts.laborrequests

/*/{Protheus.doc} ViewLaborRequestsParts
    View SD3MOD - Produtos Mão de Obra - custo em partes
    @type Class
    @author SquadEntradas
    @since 23/04/2025
    /*/
Class ViewLaborRequestsParts //Implements IterativeCostView
    Public Method New()

    Static Method GetVersion()
    Static Method GetViewID()
    Public Method GetParams()
    Public Method GetQuery()
EndClass

/*/{Protheus.doc} New
    Instância
    @type Method
    @author SquadEntradas
    @since 23/04/2025
    /*/
Method New() Class ViewLaborRequestsParts
Return Self

/*/{Protheus.doc} GetVersion
    Versão da View
    @type Method
    @author SquadEntradas
    @since 23/04/2025
    /*/
Method GetVersion() Class ViewLaborRequestsParts
Return "0001"

/*/{Protheus.doc} GetViewID
    ID da View
    Não alterar após entrar em produção
    @type Method
    @author SquadEntradas
    @since 23/04/2025
    /*/
Method GetViewID() Class ViewLaborRequestsParts
Return "VWD3PMO"

/*/{Protheus.doc} GetParams
    Retorna Json contendo os codeblock executáveis para obter os parâmetros da View
    @type Method
    @author SquadEntradas
    @since 23/04/2025
    /*/
Method GetParams() Class ViewLaborRequestsParts
    Local jExec := JsonObject():New() As Json

    jExec["VWB1MODP_NOME"] := {|| Posicione('D4D',1,FWXFilial('D4D')+'VWB1PMO','D4D_VWNAME')}
    jExec["SB1_EMPRESA"]  := {|| FWModeAccess('SB1', 1)}
    jExec["SB1_UNIDADE"]  := {|| FWModeAccess('SB1', 2)}
    jExec["SB1_FILIAL"]   := {|| FWModeAccess('SB1', 3)}
    jExec["SD3_EMPRESA"]  := {|| FWModeAccess('SD3', 1)}
    jExec["SD3_UNIDADE"]  := {|| FWModeAccess('SD3', 2)}
    jExec["SD3_FILIAL"]   := {|| FWModeAccess('SD3', 3)}
Return jExec

/*/{Protheus.doc} GetQuery
    Retorna a query estruturada da instalação da View com base nos parâmetros informados
    @type Method
    @author SquadEntradas
    @since 23/04/2025
    /*/
Method GetQuery(cEmpAtu As Character, jParam As Json) Class ViewLaborRequestsParts
    Local cQuery  As Character
    Local cIDView As Character
    Local cNomFis As Character
    Local cDbType As Character
    Local cVersao As Character
    
	cIDView := ::GetViewID()
    cNomFis := "VW_"+cIDView+"_"+cEmpAtu
    cDbType := TCGetDB()
    cVersao := ::GetVersion()

    cQuery := " Create View "+cNomFis+" As "
    cQuery += " Select "
    cQuery += " Cast('"+cVersao+"' As Char(4)) ASSINATURA, "
    cQuery += " SD3.D3_FILIAL, SD3.D3_COD, SD3.D3_LOCAL, SD3.D3_EMISSAO, "
    cQuery += " SD3.R_E_C_N_O_ SD3RECNO, "
    cQuery += " SB1.B1_FILIAL, SB1.B1_CCCUSTO, SB1.B1_GCCUSTO, "
    cQuery += " SB1.D4G_REVIS, SB1.D4G_CODPAR, SB1.D4F_TIPO,"
    cQuery += " SB1.D4F_ITEMC, SB1.D4F_CLVLR, "
    cQuery += " Case "
    cQuery += "     When SD3.D3_TM > '500' Then SD3.D3_QUANT*-1 "
    cQuery += "     Else SD3.D3_QUANT "
    cQuery += " End "
    cQuery += " D3_QUANT "
    cQuery += " From "+RetSQLName('SD3')+" SD3 "
    cQuery += " Inner Join "+jParam["VWB1MODP_NOME"]+" SB1 "
    cQuery += " On "
    If  FWModeAccess("SB1", 1) == FWModeAccess("SD3", 1) .And. ;
        FWModeAccess("SB1", 2) == FWModeAccess("SD3", 2) .And. ;
        FWModeAccess("SB1", 3) == FWModeAccess("SD3", 3)
        cQuery += " SB1.B1_FILIAL = SD3.D3_FILIAL And "
    EndIf
    cQuery += " SB1.B1_COD = SD3.D3_COD"
    cQuery += " Where "
    cQuery += " D3_ESTORNO = ' ' And "
	cQuery += " D3_CF NOT IN('PR0', 'PR1') "
    cQuery += " And SD3.D_E_L_E_T_ = ' ' "

Return cQuery
