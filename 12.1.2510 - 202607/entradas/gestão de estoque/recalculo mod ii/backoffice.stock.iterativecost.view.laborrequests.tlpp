#include "Totvs.ch"
#include "tlpp-core.th"

Namespace totvs.protheus.backoffice.stock.iterativecost.view.laborrequests

/*/{Protheus.doc} ViewLaborRequests
    View SD3MOD - Produtos Mão de Obra
    @author SquadEntradas
    @since 25/10/2024
    @version version
    /*/
Class ViewLaborRequests //Implements IterativeCostView
    Public Method New()

    Static Method GetVersion()
    Static Method GetViewID()
    Public Method GetParams()
    Public Method GetQuery()
EndClass

/*/{Protheus.doc} New
    Instância
    @author SquadEntradas
    @since 25/10/2024
    /*/
Method New() Class ViewLaborRequests
Return Self

/*/{Protheus.doc} GetVersion
    Versão da View
    @author SquadEntradas
    @since 25/10/2024
    /*/
Method GetVersion() Class ViewLaborRequests
Return "0001"

/*/{Protheus.doc} GetViewID
    ID da View
    Não alterar após entrar em produção
    @author SquadEntradas
    @since 25/10/2024
    /*/
Method GetViewID() Class ViewLaborRequests
Return "VWD3MOD"

/*/{Protheus.doc} GetParams
    Retorna Json contendo os codeblock executáveis para obter os parâmetros da View
    @author SquadEntradas
    @since 25/10/2024
    /*/
Method GetParams() Class ViewLaborRequests
    Local jExec := JsonObject():New() As Json

    jExec["VWB1MOD_NOME"] := {|| Posicione('D4D',1,FWXFilial('D4D')+'VWB1MOD','D4D_VWNAME')}
    jExec["SB1_EMPRESA"]  := {|| FWModeAccess('SB1', 1)}
    jExec["SB1_UNIDADE"]  := {|| FWModeAccess('SB1', 2)}
    jExec["SB1_FILIAL"]   := {|| FWModeAccess('SB1', 3)}
    jExec["SD3_EMPRESA"]  := {|| FWModeAccess('SD3', 1)}
    jExec["SD3_UNIDADE"]  := {|| FWModeAccess('SD3', 2)}
    jExec["SD3_FILIAL"]   := {|| FWModeAccess('SD3', 3)}
Return jExec

/*/{Protheus.doc} GetQuery
    Retorna a query estruturada da instalação da View com base nos parâmetros informados
    @author SquadEntradas
    @since 25/10/2024
    /*/
Method GetQuery(cEmpAtu As Character, jParam As Json) Class ViewLaborRequests
    Local cQuery  As Character
    Local cIDView As Character
    Local cNomFis As Character
    Local cDbType As Character
    Local cVersao As Character
    
	cIDView := ::GetViewID()
    cNomFis := "VW_"+cIDView+"_"+cEmpAtu
    cDbType := TCGetDB()
    cVersao := ::GetVersion()

    cQuery := " Create View "+cNomFis+" As "
    cQuery += " Select "
    If cDbType $ 'POSTGRES'
        cQuery += " Char(4) "
    EndIf
    cQuery += "'"+cVersao+"' ASSINATURA, "
    cQuery += " D3_FILIAL, D3_COD, D3_LOCAL, D3_EMISSAO, "
    cQuery += " SD3.R_E_C_N_O_ SD3RECNO, "
    cQuery += " B1_FILIAL, B1_CCCUSTO, B1_GCCUSTO, "
    cQuery += " Case "
    cQuery += "     When D3_TM > '500' Then D3_QUANT*-1 "
    cQuery += "     Else D3_QUANT "
    cQuery += " End "
    cQuery += " D3_QUANT "
    cQuery += " From "+RetSQLName('SD3')+" SD3 "
    cQuery += " Inner Join "+jParam["VWB1MOD_NOME"]+" SB1 "
    cQuery += " On "
    If  FWModeAccess("SB1", 1) == FWModeAccess("SD3", 1) .And. ;
        FWModeAccess("SB1", 2) == FWModeAccess("SD3", 2) .And. ;
        FWModeAccess("SB1", 3) == FWModeAccess("SD3", 3)
        cQuery += " SB1.B1_FILIAL = SD3.D3_FILIAL And "
    EndIf
    cQuery += " SB1.B1_COD = SD3.D3_COD"
    cQuery += " Where "
    cQuery += " D3_ESTORNO = ' ' And "
	cQuery += " D3_CF NOT IN('PR0', 'PR1') "
    cQuery += " And SD3.D_E_L_E_T_ = ' ' "

Return cQuery
