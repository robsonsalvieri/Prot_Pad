Namespace totvs.protheus.backoffice.stock.iterativecost.view.parts.composecalancebyproduct

/*/{Protheus.doc} ViewComposeBalanceByProduct
    View D4I/D4L/D4M/D4N - Compor o saldo do custo em partes por produto/armazém/parte/moeda
    @author Leonardo Kichitaro
    @Type Classe
    @since 28/10/2025
    @version 1
    /*/
Class ViewComposeBalanceByProduct //Implements IterativeCostView
    Public Method New()

    Static Method GetVersion()
    Static Method GetViewID()
    Public Method GetParams()
    Public Method GetQuery()
EndClass

/*/{Protheus.doc} New
    Instância
    @author Leonardo Kichitaro
    @Type Method
    @since 28/10/2025
    /*/
Method New() Class ViewComposeBalanceByProduct
Return Self

