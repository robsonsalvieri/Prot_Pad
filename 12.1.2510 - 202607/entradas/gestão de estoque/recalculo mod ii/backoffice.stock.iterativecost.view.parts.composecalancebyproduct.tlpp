Method GetVersion() Class ViewComposeBalanceByProduct
Return "0001"

/*/{Protheus.doc} GetViewID
    ID da View
    Não alterar após entrar em produção
    @author Leonardo Kichitaro
    @Type Method
    @since 28/10/2025
    /*/
Method GetViewID() Class ViewComposeBalanceByProduct
Return "VWSB1CPCOMPOSE"

/*/{Protheus.doc} GetParams
    Retorna Json contendo os codeblock executáveis para obter os parâmetros da View
    @author Leonardo Kichitaro
    @Type Method
    @since 28/10/2025
    /*/
Method GetParams() Class ViewComposeBalanceByProduct
    Local jExec := JsonObject():New() As Json

    jExec["VWSB9CP_NOME"]    := {|| Posicione('D4D',1,FWXFilial('D4D')+'VWSB9CP','D4D_VWNAME')}
    jExec["VWD1SDITCP_NOME"] := {|| Posicione('D4D',1,FWXFilial('D4D')+'VWD1SDITCP','D4D_VWNAME')}
    jExec["VWD2SDITCP_NOME"] := {|| Posicione('D4D',1,FWXFilial('D4D')+'VWD2SDITCP','D4D_VWNAME')}
    jExec["VWD3SDPRCP_NOME"] := {|| Posicione('D4D',1,FWXFilial('D4D')+'VWD3SDPRCP','D4D_VWNAME')}
    jExec["TAM_PARTE"]       := {|| TamSX3('D4I_PARTE')[1]}
    jExec["TAM_REVIS"]       := {|| TamSX3('D4I_REVISA')[1]}
    jExec["TAM_MOEDA"]       := {|| TamSX3('D4I_MOEDA')[1]}
Return jExec

/*/{Protheus.doc} GetQuery
    Retorna a query estruturada da instalação da View com base nos parâmetros informados
    @author Leonardo Kichitaro
    @Type Method
    @since 28/10/2025
    /*/
Method GetQuery(cEmpAtu As Character, jParam As Json) Class ViewComposeBalanceByProduct
    Local cQuery  As Character
    Local cIDView As Character
    Local cNomFis As Character
    Local cDbType As Character
    Local cVersao As Character
    Local cOutros As Character
    Local cTamPar As Character
    Local cRevisa As Character
    Local cTamRev As Character
    Local cMoeda  As Character
    Local cTamMoe As Character

	cIDView := ::GetViewID()
    cNomFis := "VW_"+cIDView+"_"+cEmpAtu
    cDbType := TCGetDB()
    cVersao := ::GetVersion()
    cOutros := Replicate('9', jParam["TAM_PARTE"])
    cTamPar := cValToChar(jParam["TAM_PARTE"])
    cRevisa := Replicate(' ', jParam["TAM_REVIS"])
    cTamRev := cValToChar(jParam["TAM_REVIS"])
    cMoeda  := Replicate(' ', jParam["TAM_MOEDA"])
    cTamMoe := cValToChar(jParam["TAM_MOEDA"])

    cQuery := " Create View "+cNomFis+" As "
    cQuery += " Select "
    If cDbType $ 'POSTGRES'
        cQuery += " Char(4) "
    EndIf
    cQuery += "'"+cVersao+"' ASSINATURA, "
    cQuery += " D4I.B9_FILIAL, D4I.B9_COD, D4I.B9_LOCAL, D4I.B9_DATA,  "
    cQuery += " D4I.B9_QINI, D4I.B9_QISEGUM, "
    cQuery += " D4I.B9_VINI1, D4I.B9_VINI2, D4I.B9_VINI3,  "
    cQuery += " D4I.B9_VINI4, D4I.B9_VINI5, "
	cQuery += " D4I.B9_CM1, D4I.B9_CM2, D4I.B9_CM3, D4I.B9_CM4, D4I.B9_CM5, "
    cQuery += " Coalesce(D4I.D4I_PARTE, Cast('"+cOutros+"' As Char("+cTamPar+"))) D4I_PARTE, "
    cQuery += " Coalesce(D4I.D4I_REVISA, Cast('"+cRevisa+"' As Char("+cTamRev+"))) D4I_REVISA, "
    cQuery += " Coalesce(D4I.D4I_MOEDA, Cast('"+cMoeda+"' As Char("+cTamMoe+"))) D4I_MOEDA, "
    cQuery += " Coalesce(D4I.D4I_UNITAR, 0) D4I_UNITAR, "
    cQuery += " Coalesce(D4I.D4I_TOTAL, 0) "
    cQuery += " + Coalesce(D4L.D4L_TOTAL, 0) " //soma D4L
    cQuery += " - Coalesce(D4M.D4M_TOTAL, 0) " //subtrai D4M
    cQuery += " + Coalesce( "
    cQuery += "     CASE "
    cQuery += "         WHEN D4N.D3_TM <= '500' THEN  D4N.D4N_TOTAL " //soma se TM <= 500
    cQuery += "         WHEN D4N.D3_TM >  '500' THEN -D4N.D4N_TOTAL " //subtrai se TM > 500
    cQuery += "     END "
    cQuery += "   , 0) D4I_TOTAL "
    cQuery += " From "+jParam["VWSB9CP_NOME"] +" D4I "
    cQuery += " Left Join "+jParam["VWD1SDITCP_NOME"]+" D4L On "
    cQuery += " D4L.D1_FILIAL  = D4I.B9_FILIAL  And "
    cQuery += " D4L.D1_COD     = D4I.B9_COD     And "
    cQuery += " D4L.D1_LOCAL   = D4I.B9_LOCAL   And "
    cQuery += " D4L.D4L_REVISA = D4I.D4I_REVISA And "
    cQuery += " D4L.D4L_PARTE  = D4I.D4I_PARTE  And "
    cQuery += " D4L.D4L_MOEDA  = D4I.D4I_MOEDA "
    cQuery += " Left Join "+jParam["VWD2SDITCP_NOME"]+" D4M On "
    cQuery += " D4M.D2_FILIAL  = D4I.B9_FILIAL  And "
    cQuery += " D4M.D2_COD     = D4I.B9_COD     And "
    cQuery += " D4M.D2_LOCAL   = D4I.B9_LOCAL   And "
    cQuery += " D4M.D4M_REVISA = D4I.D4I_REVISA And "
    cQuery += " D4M.D4M_PARTE  = D4I.D4I_PARTE  And "
    cQuery += " D4M.D4M_MOEDA  = D4I.D4I_MOEDA "
    cQuery += " Left Join "+jParam["VWD3SDPRCP_NOME"]+" D4N On "
    cQuery += " D4N.D3_FILIAL  = D4I.B9_FILIAL  And "
    cQuery += " D4N.D3_COD     = D4I.B9_COD     And "
    cQuery += " D4N.D3_LOCAL   = D4I.B9_LOCAL   And "
    cQuery += " D4N.D4N_REVISA = D4I.D4I_REVISA And "
    cQuery += " D4N.D4N_PARTE  = D4I.D4I_PARTE  And "
    cQuery += " D4N.D4N_MOEDA  = D4I.D4I_MOEDA "
Return cQuery
