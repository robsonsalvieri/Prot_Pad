/*/{Protheus.doc} GetQuery
    Retorna a query estruturada da instalação da View com base nos parâmetros informados
    @author g.moreira
    @since 22/07/2024
    /*/
Method GetQuery(cEmpAtu As Character, jParam As Json) Class ViewInflowInvoiceNumberedItem
    Local cQuery  As Character
    Local cIDView As Character
    Local cNomFis As Character
    Local cDbType As Character
    Local cVersao As Character
    Local cCollation As Character

	cIDView := ::GetViewID()
    cNomFis := "VW_"+cIDView+"_"+cEmpAtu
    cDbType := TCGetDB()
    cVersao := ::GetVersion()

	cCollation := "Latin1_General_100_bin" 
    If cDbType $ "ORACLE"
        cCollation := "ASCII7"
    ElseIf cDbType $ "POSTGRES"
        cCollation := '"C"'
    EndIf

    cQuery := " Create View "+cNomFis+" As "
    cQuery += " Select "
    If cDbType $ 'POSTGRES'
        cQuery += " Char(4) "
    EndIf
    cQuery += "'"+cVersao+"' ASSINATURA, "
    cQuery += " Row_Number() Over (Partition by  " 
    cQuery += " D1_FILIAL, D1_DOC, D1_SERIE, D1_FORNECE, D1_LOJA "
    cQuery += " Order by D1_ITEM Collate "+cCollation+") D1_ITEMNR, "
    cQuery += " D1_FILIAL, D1_DOC, D1_SERIE, D1_FORNECE, D1_LOJA, "
    cQuery += " D1_COD, D1_ITEM, D1_TES, R_E_C_N_O_, "
    cQuery += " D1_DTDIGIT, D1_QUANT, D1_QTSEGUM, "
    cQuery += " D1_CUSTO, D1_CUSTO2, D1_CUSTO3, D1_CUSTO4, D1_CUSTO5, D1_ICMSRET "
    cQuery += " From (Select "
    cQuery += " D1_FILIAL, D1_DOC, D1_SERIE, D1_FORNECE, D1_LOJA,"
    cQuery += " D1_COD, D1_ITEM, D1_TES, R_E_C_N_O_, "
    cQuery += " D1_DTDIGIT, D1_QUANT, D1_QTSEGUM, "
    cQuery += " D1_CUSTO, D1_CUSTO2, D1_CUSTO3, D1_CUSTO4, D1_CUSTO5, D1_ICMSRET "
    cQuery += " From "+RetSQLName('SD1')+" " 
    cQuery += " Where D_E_L_E_T_ = ' '  ) A "
Return cQuery
