#include "Totvs.ch"
#include "tlpp-core.th"

Namespace totvs.protheus.backoffice.stock.iterativecost.view.parts.internaltransactions
using namespace totvs.protheus.backoffice.stock.iterativecost.table.manager

/*/{Protheus.doc} ViewInternalTransactionsParts
    View SB1MODP - Movimentos internos - custo em partes
    @author Leonardo Kichitaro
    @Type Method
    @since 28/10/2025
    @version 1
    /*/
Class ViewInternalTransactionsParts //Implements IterativeCostView
    Public Method New()

    Static Method GetVersion()
    Static Method GetViewID()
    Public Method GetParams()
    Public Method GetQuery()
EndClass

/*/{Protheus.doc} New
    Instância
    @author Leonardo Kichitaro
    @Type Method
    @since 28/10/2025
    /*/
Method New() Class ViewInternalTransactionsParts

    Select('D4N')

Return Self

/*/{Protheus.doc} GetVersion
    Versão da View
    @author Leonardo Kichitaro
    @Type Method
    @since 28/10/2025
    /*/
Method GetVersion() Class ViewInternalTransactionsParts
Return "0001"

/*/{Protheus.doc} GetViewID
    ID da View
    Não alterar após entrar em produção
    @author Leonardo Kichitaro
    @Type Method
    @since 28/10/2025
    /*/
Method GetViewID() Class ViewInternalTransactionsParts
Return "VWD3SDPRCP"

/*/{Protheus.doc} GetParams
    Retorna Json contendo os codeblock executáveis para obter os parâmetros da View
    @author Leonardo Kichitaro
    @Type Method
    @since 28/10/2025
    /*/
Method GetParams() Class ViewInternalTransactionsParts
    Local jExec := JsonObject():New() As Json

    jExec["TAM_CODPAR"]  := {|| TamSX3('D4N_PARTE')[1]}
Return jExec

/*/{Protheus.doc} GetQuery
    Retorna a query estruturada da instalação da View com base nos parâmetros informados
    @author Leonardo Kichitaro
    @Type Method
    @since 28/10/2025
    /*/
Method GetQuery(cEmpAtu As Character, jParam As Json) Class ViewInternalTransactionsParts

    Local cQuery  As Character
    Local cIDView As Character
    Local cNomFis As Character
    Local cDbType As Character
    Local cVersao As Character
    Local nTamPar := jParam["TAM_CODPAR"]
    Local cOutros := Replicate('9', nTamPar)
    Local cTamPar := cValToChar(nTamPar)

	cIDView := ::GetViewID()
    cNomFis := "VW_"+cIDView+"_"+cEmpAtu
    cDbType := AllTrim(Upper(TcGetDb()))
    cVersao := ::GetVersion()

    cQuery := " Create View "+cNomFis+" As "
    cQuery += " Select "
    cQuery += " Cast('"+cVersao+"' As Char(4)) ASSINATURA, "
    cQuery += " D3_FILIAL, D3_TM, D3_CF, D3_OP, D3_EMISSAO, "
    cQuery += " D3_COD, D3_TIPO, D3_UM, D3_LOCAL, D3_GRUPO, D3_QUANT, D3_QTSEGUM, "
    cQuery += " D3_CUSTO1, D3_CUSTO2, D3_CUSTO3, D3_CUSTO4, D3_CUSTO5, SD3.R_E_C_N_O_, "
    cQuery += " D4N_FILIAL, D4N_REVISA, "
    cQuery += " Cast(Coalesce(D4N_PARTE, '"+cOutros+"') As Char("+cTamPar+")) D4N_PARTE, "
    cQuery += " D4N_MOEDA, D4N_TOTAL "
    cQuery += " From "+RetSQLName('SD3')+" SD3 "
    cQuery += " Inner Join "+RetSQLName('D4N')+" D4N On "
    cQuery += " D4N.D4N_FILIAL = SD3.D3_FILIAL And "
    cQuery += " D4N.D4N_IDSD3  = SD3.D3_MSUID "
    cQuery += " And D4N.D_E_L_E_T_ = ' ' " 
    cQuery += " Where SD3.D3_ESTORNO = ' ' And SD3.D_E_L_E_T_ = ' ' "

Return cQuery
