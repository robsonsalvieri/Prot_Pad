#Include 'Totvs.ch'
#Include 'tlpp-core.th'
#Include 'backoffice.stock.iterativecost.table.balancebywarehouse.ch'

using namespace totvs.protheus.backoffice.stock.iterativecost.table.manager
Using namespace totvs.protheus.backoffice.stock.iterativecost.view.laborproduct
using namespace totvs.protheus.backoffice.stock.iterativecost.processing.threads
using namespace totvs.protheus.backoffice.stock.iterativecost.table.processingtable
using namespace totvs.protheus.backoffice.stock.iterativecost.table.parts.processingtable

namespace totvs.protheus.backoffice.stock.iterativecost.table.balancebywarehouse

#Define THIS "totvs.protheus.backoffice.stock.iterativecost.table.balancebywarehouse."

/*/{Protheus.doc} BalanceByWarehouse
    Classe responsável por retornar o saldo dos produtos por armazém (TRK)
    @type Method
    @author Squad Entradas
    @since 15/09/2024
/*/
Class BalanceByWarehouse From TableManager

	public method New()

	static method tableFields()
	static method tableIndexes()
	static method tableName()

	method queryMov()
	method queryAGL()
	public method insertSQL()
	Public Method SaldoNegativo()
	Public Method SaldoFimSB2()
	Public Method DeleteD4K()
	Public Method BulkD4K()

	Public Data oProcessingTable As Object
	Public Data jParams  As Json
	Public Data cFilProc As Character
endclass

/*/{Protheus.doc} New
    Instância da classe
    @type Method
    @author Squad Entradas
    @since 15/09/2024
/*/
Method new(cFilProc, aFil, oProcessingTable, jParams) Class BalanceByWarehouse

	_Super:New(aFil)
	::TableManager(::TableName(),::TableFields(),::TableIndexes())

	::cFilProc := cFilProc
	::oProcessingTable := oProcessingTable
	::jParams := jParams
Return

/*/{Protheus.doc} TableFields
    Campos da tabela de saldos por armazém
    @type Method
    @author Squad Entradas
    @since 15/09/2024
/*/
Method tableFields() Class BalanceByWarehouse
	Local aFields := {}

	aAdd(aFields, {"FILPROC", "C" , TamSX3('B2_FILIAL')[1], 0})
	aAdd(aFields, {"FILIAL",  "C" , TamSX3('B2_FILIAL')[1], 0})
	aAdd(aFields, {"COD",     "C" , TamSX3('B2_COD')[1], 0})
	aAdd(aFields, {"ARMAZEM", "C" , TamSX3('B2_LOCAL')[1], 0})
	aAdd(aFields, {"QUANT",   "N" , TamSX3('B2_QFIM')[1], TamSX3('B2_QFIM')[2]})
	aAdd(aFields, {"QTSEGUM", "N" , TamSX3('B2_QFIM2')[1], TamSX3('B2_QFIM2')[2]})
	aAdd(aFields, {"QTDINI",  "N" , TamSX3('B2_QFIM')[1], TamSX3('B2_QFIM')[2]})
	aAdd(aFields, {"GRVSB2",  "C" , 1, 0})

Return aFields

/*/{Protheus.doc} TableIndexes
    Índices da tabela de saldos por armazém
    @type Method
    @author Squad Entradas
    @since 15/09/2024
/*/
Method tableIndexes() Class BalanceByWarehouse
	Local aIndex := {}

	aAdd(aIndex, {BalanceByWarehouse():TableName()+'_01', 'FILPROC+FILIAL+COD+ARMAZEM'})
	aAdd(aIndex, {BalanceByWarehouse():TableName()+'_02', 'FILPROC+GRVSB2'})
    aAdd(aIndex, {BalanceByWarehouse():TableName()+'_03', 'FILPROC+FILIAL+QUANT'})

Return aIndex

/*/{Protheus.doc} TableName
    Retorna o nome da tabela de saldos por armazém
    @type Method
    @author Squad Entradas
    @since 15/09/2024
/*/
Method tableName() Class BalanceByWarehouse
	Local cAlias as character

	cAlias := "TRK"+cEmpAnt+"SP"

Return cAlias

/*/{Protheus.doc} queryMov
    Retorna o saldo das movimentações e o saldo de processamento
    @type Method
    @author Squad Entradas
    @since 15/09/2024
/*/
Method queryMov(cFilProc, cFilAtu, dDtIni, dDtFim) Class BalanceByWarehouse
	Local oQuery     as object
	Local cQuery     as character
	Local cAliasMov  as character
	Local cCusUnif   as Character

	cAliasMov  := totvs.protheus.backoffice.stock.iterativecost.table.analyticalmovementtable.AnalyticalMovementTable():TableName()

	cCusUnif := 'A' //Cria a query sem aglutinar o armazém

	cQuery := " SELECT TRG.FILIAL FILIAL, TRG.COD COD, TRG.LOCARM ARMAZEM, "
	cQuery += " SUM(CASE WHEN TRG.TM > '500' THEN -TRG.QTDORI ELSE TRG.QTDORI END) QUANT, "
	cQuery += " SUM(CASE WHEN TRG.TM > '500' THEN -TRG.QTSEGUM ELSE TRG.QTSEGUM END) QTSEGUM, "
	cQuery += " 0 QTDINI "
	cQuery += " FROM "+cAliasMov+" TRG "
	cQuery += " WHERE "
	cQuery += " TRG.FILPROC = ? "
	cQuery += " And TRG.FILIAL = ?  "
	cQuery += " GROUP BY TRG.FILIAL,TRG.COD,TRG.LOCARM "
	cQuery += " UNION ALL "
	cQuery += " SELECT PROCTABLE.FILIAL FILIAL, PROCTABLE.COD COD, PROCTABLE.ARMAZEM ARMAZEM, PROCTABLE.QTDHIST QUANT, PROCTABLE.QISEGUM QISEGUM, PROCTABLE.QTDHIST QTDINI "
	cQuery += " FROM ("+::oProcessingTable:queryAgglutinated(cFilProc, cFilAtu, dDtIni, dDtFim, cCusUnif)
	cQuery += " ) PROCTABLE "
	cQuery += " Inner Join "+::oProcessingTable:TableName()+" TRH On "
	cQuery += " TRH.FILPROC = PROCTABLE.FILPROC And "
	cQuery += " TRH.FILIAL  = "
	If ::jParams["MV_CUSFIL"] == "E"
		cQuery += " '"+PadR(FWCompany(), FWSizeFilial())+"' "
	Else
		cQuery += "PROCTABLE.FILIAL "
	EndIf
	cQuery +=  " And "
	cQuery += " TRH.COD = PROCTABLE.COD "
	If ::jParams["MV_CUSFIL"] == "A"
		cQuery += " And "
		cQuery += " TRH.ARMAZEM = PROCTABLE.ARMAZEM "
	EndIf

	cQuery := ChangeQuery(cQuery)

	oQuery := FwExecStatement():New(cQuery)

	oQuery:SetString(1, cFilProc)
	oQuery:SetString(2, cFilAtu)

	cQuery := oQuery:GetFixQuery()

Return cQuery

/*/{Protheus.doc} queryAGL
    Aglutina o saldo de processamento com o saldo das movimentações
    @type Method
    @author Squad Entradas
    @since 15/09/2024
/*/
Method queryAGL(cFilProc, cFilAtu, dDtIni, dDtFim) Class BalanceByWarehouse
	Local cQuery as character

	cQuery := " SELECT "
	If ::lPostgres
		cQuery += " Char("+cValToChar(FWSizeFilial())+") "
	EndIf
	cQuery += " '"+cFilProc+"' FILPROC, "
	cQuery += " FILIAL, COD, ARMAZEM, SUM(QUANT) QUANT, SUM(QTSEGUM) QTSEGUM, SUM(QTDINI) QTDINI "
	cQuery += " FROM ("+::queryMov(cFilProc, cFilAtu, dDtIni, dDtFim)+") AGLUTINADA "
	cQuery += " GROUP BY FILIAL, COD, ARMAZEM "

Return cQuery

/*/{Protheus.doc} insertSQL
    Retorna o insert formatado com CTE
    @Type Method
    @author Squad Entradas
    @since 15/09/2024
/*/
Method insertSQL(cFilProc, dDtIni, dDtFim) Class BalanceByWarehouse
	Local cCampos := "FILPROC, FILIAL, COD, ARMAZEM, QUANT, QTSEGUM, QTDINI "
	Local nFil    as integer

	For nFil := 1 To Len(::aFilProc)
		cQuery := ::queryAGL(cFilProc, ::aFilProc[nFil, 1], dDtIni, dDtFim)
		cQuery := ::FormatCTE(cCampos, cQuery)
		::RunQuery(cQuery)
	Next nFil

Return

/*/{Protheus.doc} SaldoNegativo
    Método responsável por atualizar os saldos finais na tabela SB2
    ao final do processamento
	@author Squad Entradas
	@type Method
    @since 08/06/2026
/*/
Method SaldoNegativo(cFilProc,aFilProc,oProc) Class BalanceByWarehouse

	Local nFil       As integer
	Local cTabSaldo  As Character
	Local cQuery     As Character
	Local oQryNeg    As Object
	Local nQtdNeg    As Numeric
	Local cMsg       As Character
	Local cTabSB1MOD As Character

	If D4D->(DbSeek(FWXFilial('D4D')+ViewLaborProduct():GetViewID()))
		cTabSB1MOD := D4D->D4D_VWNAME
	EndIf

	cTabSaldo := ::TableName()

	cQuery := "  SELECT "
	cQuery += "    Count(1) QTDNEG "
	cQuery += " FROM " + cTabSaldo + " TRK "
	cQuery += " WHERE  TRK.FILPROC = ? "
	cQuery += " AND TRK.FILIAL = ? "
	cQuery += " AND TRK.QUANT < ? "
	cQuery += " AND NOT EXISTS ( "
	cQuery += "    SELECT 1  "
	cQuery += "   FROM "+cTabSB1MOD+" VMB "
	cQuery += "    WHERE VMB.B1_COD = TRK.COD "
	If !Empty(FWxFilial("SB1"))
		cQuery += " AND VMB.B1_FILIAL = ? "
	EndIf
	cQuery += " ) "
	cQuery += " AND TRK.D_E_L_E_T_ = ? "
	cQuery := ChangeQuery(cQuery)

    oQryNeg := FwExecStatement():New(cQuery)

	For nFil := 1 To Len(::aFilProc)
		
		oQryNeg:SetString(1, cFilProc)
		oQryNeg:SetString(2, aFilProc[nFil])
		oQryNeg:SetNumeric(3, 0)
		oQryNeg:SetString(4, FWXFilial("SB1", aFilProc[nFil]))
		oQryNeg:SetString(5, '')
		nQtdNeg := oQryNeg:ExecScalar("QTDNEG")

		If nQtdNeg > 0
			cMsg := STR0010 //"Devido ao método de calculo iterativo, o modelo 2 não é recomendado para ambientes que possuem movimentação físicas negativas. "
			cMsg += STR0011 //"Através do SmartView Posição de Estoque(ESTSV020),você pode identificar tais produtos para corrigir a movimentação, caso essa esteja incorreta, ou trabalhar com o modelo 1 de cálculo, recomendado para esse cenário"

			If oProc != Nil
				oProc:IncRegua1(I18N(cMsg, {cTabSaldo}))
				oProc:logProAtu(STR0007, STR0010, I18N(cMsg, {cTabSaldo}), "ER") // ERRO
			EndIf

			Help(NIL, NIL, 'EST330NG', NIL, STR0010, 1, 0, NIL, NIL, NIL, NIL, NIL, {STR0011})

			Return .F.
		EndIf

	Next nFil

Return .T.


/*/{Protheus.doc} SaldoFimSB2
    Método responsável por atualizar os saldos finais na tabela SB2
    ao final do processamento
	@author Squad Entradas
	@type Method
    @since 25/11/2024
/*/
Method SaldoFimSB2(cTabProc, oProc) Class BalanceByWarehouse
	Local cTabSaldo As Character
	Local cQuery    As Character
	Local oThrManager As Object
	Local oQryTRK   As Object
	Local oQryQtd   As Object
	Local cAlTRK    As Character
	Local nCount    As Integer
	Local aRecTRK   As Array
	Local nTries    As Integer
	Local cError    As Character
	Local cCusFil   As Character
	Local nLeft     As Integer
	Local aMoedas   As Array
	Local nCalcCP   As Integer
	Local cRevis    As Character

	cTabSaldo := ::TableName()
	aRecTRK   := {}
	cCusFil   := ::jParams["MV_CUSFIL"]
	aMoedas   := ::jParams["moedas"]
	nCalcCP   := ::jParams["calccp"]
	cRevis    := ::jParams["revisao_vigente"]

	If nCalcCP == 1
		::DeleteD4K(cRevis)
	EndIf

	cQuery := " Select R_E_C_N_O_ REC "
	cQuery += " From "+cTabSaldo+" "
	cQuery += " Where "
	cQuery += " FILPROC = ? And "
	cQuery += " GRVSB2  = ? "
	cQuery := ChangeQuery(cQuery)

	oQryTRK := FwExecStatement():New(cQuery)

	oThrManager := ThreadManager():New(2, "EST330FIM_"+cEmpAnt, ::jParams["IDEXEC"], THIS+"PrepThr")

	lRet := oThrManager:Prepare()
	If !lRet
		//Gravar log e finalizar
		oProc:IncRegua1(oThrManager:GetError())
		UserException(oThrManager:GetError())
	EndIf

	cQuery := " Select Count(1) QTD "
	cQuery += " From "+cTabSaldo+" "
	cQuery += " Where "
	cQuery += " FILPROC = ? And "
	cQuery += " GRVSB2  = ? "
	cQuery := ChangeQuery(cQuery)

	oQryQtd := FwExecStatement():New(cQuery)

	oQryQtd:SetString(1, ::cFilProc)
	oQryQtd:SetString(2, ' ')

	oProc:IncRegua1(STR0001) //"Iniciando a gravação dos saldos finais (SB2)"
	oProc:logProAtu(STR0006, STR0001, STR0001) // MENSAGEM

	While (nLeft := oQryQtd:ExecScalar("QTD")) > 0
		If nTries > 0
			oProc:IncRegua1(I18N(STR0002, {Transform(nTries, "@E 999"), Transform(nLeft, "@E 999,999,999,999")})) //"Tentativa #1[5]#: Registros pendentes: #2[10.234]#"
			oProc:logProAtu(STR0006, STR0008, I18N(STR0002, {Transform(nTries, "@E 999"), Transform(nLeft, "@E 999,999,999,999")})) // MENSAGEM
		Else
			oProc:IncRegua1(I18N(STR0003, {Transform(nLeft, "@E 999,999,999,999")})) //"Registros a gravar: #1[10.234]#"
			oProc:logProAtu(STR0006, STR0008, I18N(STR0003, {Transform(nLeft, "@E 999,999,999,999")})) // MENSAGEM
		EndIf
		oQryTRK:SetString(1, ::cFilProc)
		oQryTRK:SetString(2, ' ')

		cAlTRK := oQryTRK:OpenAlias()
		While !(cAlTRK)->(EoF())
			nCount++
			If nCount <= 1000
				AAdd(aRecTRK, (cAlTRK)->REC)
			EndIf

			If nCount == 1000
				oThrManager:Execute(THIS+"GrvB2Fim", {aRecTRK, cCusFil, aMoedas, nCalcCP, cRevis})

				ASize(aRecTRK, 0)
				aRecTRK := {}
				nCount := 0
			EndIf

			(cAlTRK)->(DbSkip())
		EndDo

		If nCount > 0
			oThrManager:Execute(THIS+"GrvB2Fim", {aRecTRK, cCusFil, aMoedas, nCalcCP, cRevis})

			ASize(aRecTRK, 0)
			aRecTRK := {}
			nCount := 0
		EndIf
		(cAlTRK)->(DbCloseArea())

		nTries++

		cError := ""
		While Empty(cError)
			cError := oThrManager:CheckForErrors()

			If oThrManager:CheckIfDone()
				Exit
			EndIf
			Sleep(500)
		EndDo

		If cError != ""
			oThrManager:Terminate()

			//Gravar tabela de log
			oProc:IncRegua1(oThrManager:cError+oThrManager:cErrorStack+oThrManager:cErrorEnv)
			UserException(oThrManager:cError+oThrManager:cErrorStack+oThrManager:cErrorEnv)
		EndIf

		If nTries > 1
			Sleep(30000)
		EndIf
		If nTries > 10
			oProc:IncRegua1(I18N(STR0004, {::TableName()})) //"Não foi possível efetuar a gravação de um ou mais registros na SB2, pois está(ão) bloqueado(s) por outro(s) usuário(s). Verifique a tabela #1[TRKT1SP]# para identificar os registros não gravados."
			oProc:logProAtu(STR0007, STR0009, I18N(STR0004, {::TableName()}), "ER") // ERRO
			Exit
		EndIf
	EndDo

	oThrManager:Terminate()

	oProc:IncRegua1(STR0005) //"Finalizada a gravação dos saldos finais (SB2)"
	oProc:logProAtu(STR0006, STR0005, STR0005) // MENSAGEM

Return

/*/{Protheus.doc} PrepThr
    Faz a abertura das tabelas utilizadas nas threads
    @type  Function
    @author Squad Entradas
    @since 20/05/2025
    /*/
Function PrepThr()

	TableManager():UseArea(ProcessingTable():TableName(), ProcessingTable():IndicesProc())
	TableManager():UseArea(BalanceByWarehouse():TableName(), BalanceByWarehouse():TableIndexes())
Return

/*/{Protheus.doc} GrvB2Fim
    Faz a gravação dos saldos finais na SB2
    @type  Function
    @author Squad Entradas
    @since 20/05/2025
    /*/
	Static __oQryGrvB2 := Nil
Function GrvB2Fim(aParams)
	Local cTabSaldo   As Character
	Local cTabProc    As Character
	Local cQuery      As Character
	Local cAlTRK      As Character
	Local nTRK        As Integer
	Local nRecTRK     As Integer
	Local cCusFil     As Character
	Local aMoedas     As Array
	Local nMoeda      As Integer
	Local aB2_VFIM    As Array
	Local aB2_CMFIM   As Array
	Local cMoeda      As Character
	Local lRound      As Logical
	Local cDecCM      As Character
	Local aTot        As Array
	Local aCM         As Array
	Local nCalcCP     As Integer
	Local cRevis      As Character

	cCusFil   := aParams[2]
	aMoedas   := aParams[3]
	nCalcCP   := aParams[4]
	cRevis    := aParams[5]

	cTabSaldo := BalanceByWarehouse():TableName()
	cTabProc  := ProcessingTable():TableName()

	//Cuidado ao alterar a ordem dos campos na query, para não
	//bagunçar o FieldGet
	If __oQryGrvB2 == Nil
		lRound    := SuperGetMV("MV_CMROUND", .F., .F.)

		cQuery := " Select "
		For nMoeda := 1 To Len(aMoedas)
			cMoeda := aMoedas[nMoeda]
			cDecCM := cValToChar(TamSX3("B2_CMFIM"+cMoeda)[2])
			If lRound
				cQuery += " Round(TRH.CMPROC"+cMoeda+", "+cDecCM+") "
				cQuery += " B2_CMFIM"+cMoeda+", "
				cQuery += " Round(TRH.CMPROC"+cMoeda+", "+cDecCM+") * TRK.QUANT "
				cQuery += " B2_VFIM"+cMoeda+", "
			Else
				If 'MSSQL' $ TCGetDB()
					cQuery += " Round(TRH.CMPROC"+cMoeda+", "+cDecCM+", 1) "
					cQuery += " B2_CMFIM"+cMoeda+", "
					cQuery += " Round(TRH.CMPROC"+cMoeda+", "+cDecCM+", 1) * TRK.QUANT "
					cQuery += " B2_VFIM"+cMoeda+", "
				ElseIf TCGetDB() $ 'ORACLE'
					cQuery += " Trunc(TRH.CMPROC"+cMoeda+", "+cDecCM+") "
					cQuery += " B2_CMFIM"+cMoeda+", "
					cQuery += " Trunc(TRH.CMPROC"+cMoeda+", "+cDecCM+") * TRK.QUANT "
					cQuery += " B2_VFIM"+cMoeda+", "
				ElseIf TCGetDB() $ 'POSTGRES'
					cQuery += " Trunc(Cast(TRH.CMPROC"+cMoeda+" As Numeric), "+cDecCM+") "
					cQuery += " B2_CMFIM"+cMoeda+", "
					cQuery += " Trunc(Cast(TRH.CMPROC"+cMoeda+" As Numeric), "+cDecCM+") * TRK.QUANT "
					cQuery += " B2_VFIM"+cMoeda+", "
				EndIf
			EndIf
		Next
		cQuery += " TRK.QUANT B2_QFIM "
		cQuery += " From "+cTabSaldo+" TRK"
		cQuery += " Inner Join "+cTabProc+" TRH On "
		cQuery += " TRH.FILPROC = TRK.FILPROC And "
		If cCusFil != 'E'
			cQuery += " TRH.FILIAL  = TRK.FILIAL  And "
		EndIf
		cQuery += " TRH.COD     = TRK.COD "
		If cCusFil == 'A'
			cQuery += "And TRH.ARMAZEM = TRK.ARMAZEM "
		EndIf
		cQuery += " Where "
		cQuery += " TRK.R_E_C_N_O_ = ? "
		cQuery := ChangeQuery(cQuery)

		__oQryGrvB2 := FwExecStatement():New(cQuery)
	EndIf

	SB2->(DbSetOrder(1)) //B2_FILIAL+B2_COD+B2_LOCAL

	//Pega a posição física dos campos na tabela, para cada moeda
	//para evitar a chamada da FieldPos dentro do loop
	aB2_VFIM  := {}
	aB2_CMFIM := {}
	For nMoeda := 1 To Len(aMoedas)
		cMoeda := aMoedas[nMoeda]
		AAdd(aB2_VFIM,  SB2->(FieldPos("B2_VFIM"+cMoeda)))
		AAdd(aB2_CMFIM, SB2->(FieldPos("B2_CMFIM"+cMoeda)))
	Next nMoeda

	For nTRK := 1 To Len(aParams[1])
		nRecTRK := aParams[1, nTRK]
		(cTabSaldo)->(DbGoto(nRecTRK))

		__oQryGrvB2:SetNumeric(1, nRecTRK)

		cAlTRK := __oQryGrvB2:OpenAlias()
		aCM  := {}
		aTot := {}

		If !(cAlTRK)->(EoF())
			For nMoeda := 1 To Len(aMoedas)
				cMoeda := aMoedas[nMoeda]
				AAdd(aCM,  (cAlTRK)->(FieldGet(2*nMoeda - 1)))
				AAdd(aTot, (cAlTRK)->(FieldGet(2*nMoeda - 0)))
			Next
		EndIf
		(cAlTRK)->(DbCloseArea())

		If SB2->(DbSeek((cTabSaldo)->(FILIAL+COD+ARMAZEM)))
			If SB2->(SimpleLock())
				RecLock('SB2', .F.)
				SB2->B2_QFIM   := Max(0, (cTabSaldo)->QUANT)
				SB2->B2_QFIM2  := Max(0, (cTabSaldo)->QTSEGUM)
				For nMoeda := 1 To Len(aMoedas)
					SB2->(FieldPut(aB2_VFIM[nMoeda], Max(0, aTot[nMoeda])))
					SB2->(FieldPut(aB2_CMFIM[nMoeda], Max(0, aCM[nMoeda]) ))
				Next

				SB2->(MsUnlock())

				RecLock(cTabSaldo, .F.)
				(cTabSaldo)->GRVSB2 := "1"
				(cTabSaldo)->(MsUnlock())

				If nCalcCP == 1
					GrvD4KFim(nRecTRK, cRevis, cCusFil)
				EndIf
			EndIf
		Else
			RecLock(cTabSaldo, .F.)
			(cTabSaldo)->GRVSB2 := "2"
			(cTabSaldo)->(MsUnlock())
		EndIf
	Next nTRK

	If __lCanBulk
		If !__oBulkD4K:Close()
			UserException("Erro inclusão D4K: "+__oBulkD4K:GetError())
		EndIf
		__oBulkD4K:Destroy()
		FreeObj(__oBulkD4K)
		__oBulkD4K := Nil
		__lCanBulk := Nil
	EndIf

Return .T.

/*/{Protheus.doc} DeleteD4K(cRevis)
    Apaga os saldos finais em partes
    @Type Method
    @author Squad Entrads
    @since 26/05/2025
    @param cRevis, character, Revisão
    @return Nil, Nil, Nil
    /*/
Method DeleteD4K(cRevis) Class BalanceByWarehouse
	Local cQuery As Character
	Local nFil   As Integer

	For nFil := 1 To Len(::aFilProc)
		cQuery := " Delete From "+RetSQLName("D4K")
		cQuery += " Where "
		cQuery += " D4K_FILIAL = '"+FWXFilial("D4K", ::aFilProc[nFil, 1])+"' And "
		cQuery += " D4K_REVISA = '"+cRevis+"' "

		::RunQuery(cQuery)
	Next nFil

Return

/*/{Protheus.doc} GrvD4KFim
    Grava os saldos finais na D4K
    @type  Function
    @author Squad Entradas
    @since 26/05/2025
    @param param_name, param_type, param_descr
    @return return_var, return_type, return_description
    @example
    (examples)
    @see (links_or_references)
/*/
	Static __oQryGrvD4K := Nil
	Static __oBulkD4K   := Nil
	Static __lCanBulk   := Nil
Static Function GrvD4KFim(nRecTRK, cRevis, cCusFil)
	Local cDecCM    As Character
	Local cTabSaldo As Character
	Local cTabProc  As Character
	Local cAlTRK    As Character
	Local nCpo      As Integer
	Local aSX3      As Array
	Local aFields   As Array
	Local aData     As Array

	If __oQryGrvD4K == Nil
		cTabSaldo := BalanceByWarehouse():TableName()
		cTabProc  := PartsProcessingTable():TableName()
		lRound    := SuperGetMV("MV_CMROUND", .F., .F.)

		cDecCM := cValToChar(TamSX3("D4K_UNITAR")[2])
		cQuery := " Select "
		If lRound
			cQuery += " Round(TRHCP.CMPROC, "+cDecCM+") "
			cQuery += " D4K_UNITAR, "
			cQuery += " Round(TRHCP.CMPROC, "+cDecCM+") * TRK.QUANT "
			cQuery += " D4K_TOTAL, "
		Else
			If 'MSSQL' $ TCGetDB()
				cQuery += " Round(TRHCP.CMPROC, "+cDecCM+", 1) "
				cQuery += " D4K_UNITAR, "
				cQuery += " Round(TRHCP.CMPROC, "+cDecCM+", 1) * TRK.QUANT "
				cQuery += " D4K_TOTAL, "
			ElseIf TCGetDB() $ 'ORACLE'
				cQuery += " Trunc(TRHCP.CMPROC, "+cDecCM+") "
				cQuery += " D4K_UNITAR, "
				cQuery += " Trunc(TRHCP.CMPROC, "+cDecCM+") * TRK.QUANT "
				cQuery += " D4K_TOTAL, "
			ElseIf TCGetDB() $ 'POSTGRES'
				cQuery += " Trunc(Cast(TRHCP.CMPROC As Numeric), "+cDecCM+") "
				cQuery += " D4K_UNITAR, "
				cQuery += " Trunc(Cast(TRHCP.CMPROC As Numeric), "+cDecCM+") * TRK.QUANT "
				cQuery += " D4K_TOTAL, "
			EndIf
		EndIf
		cQuery += " TRK.FILIAL   D4K_FILIAL, "
		cQuery += " TRK.COD      D4K_COD, "
		cQuery += " TRK.ARMAZEM  D4K_LOCAL, "
		cQuery += " TRHCP.MOEDA  D4K_MOEDA, "
		cQuery += " TRHCP.CODPAR D4K_PARTE "
		cQuery += " From "+cTabSaldo+" TRK"
		cQuery += " Inner Join "+cTabProc+" TRHCP On "
		cQuery += " TRHCP.FILPROC = TRK.FILPROC And "
		If cCusFil != 'E'
			cQuery += " TRHCP.FILIAL  = TRK.FILIAL  And "
		EndIf
		cQuery += " TRHCP.COD     = TRK.COD "
		If cCusFil == 'A'
			cQuery += "And TRHCP.ARMAZEM = TRK.ARMAZEM "
		EndIf
		cQuery += " Where "
		cQuery += " TRK.R_E_C_N_O_ = ? "
		cQuery := ChangeQuery(cQuery)

		__oQryGrvD4K := FwExecStatement():New(cQuery)
	EndIf

	__oQryGrvD4K:SetNumeric(1, nRecTRK)

	cAlTRK := __oQryGrvD4K:OpenAlias()

	//TCSetField para arredondar os campos numéricos
	For nCpo := 1 To D4K->(FCount())
		aSX3 := TamSX3(D4K->(FieldName(nCpo)))
		If !(aSX3[3] $ "CM")
			(cAlTRK)->(TcSetField(cAlTRK, D4K->(FieldName(nCpo)), aSX3[3], aSX3[1], aSX3[2]))
		EndIf
	Next nCpo

	If __oBulkD4K == Nil
		__oBulkD4K := FWBulk():New(RetSQLName("D4K"), 500)

		__lCanBulk := __oBulkD4K:CanBulk()
		If __lCanBulk
			aFields := {}
			AAdd(aFields, {"D4K_FILIAL"})
			AAdd(aFields, {"D4K_COD"})
			AAdd(aFields, {"D4K_LOCAL"})
			AAdd(aFields, {"D4K_REVISA"})
			AAdd(aFields, {"D4K_PARTE"})
			AAdd(aFields, {"D4K_MOEDA"})
			AAdd(aFields, {"D4K_UNITAR"})
			AAdd(aFields, {"D4K_TOTAL"})
			__oBulkD4K:SetFields(aFields)
		EndIf
	EndIf

	If __lCanBulk
		While !(cAlTRK)->(EoF())
			aData := {}
			AAdd(aData, (cAlTRK)->D4K_FILIAL)
			AAdd(aData, (cAlTRK)->D4K_COD)
			AAdd(aData, (cAlTRK)->D4K_LOCAL)
			AAdd(aData, cRevis)
			AAdd(aData, (cAlTRK)->D4K_PARTE)
			AAdd(aData, (cAlTRK)->D4K_MOEDA)
			AAdd(aData, (cAlTRK)->D4K_UNITAR)
			AAdd(aData, (cAlTRK)->D4K_TOTAL)
			If !__oBulkD4K:AddData(aData)
				UserException("Erro inclusão D4K: "+__oBulkD4K:GetError())
			EndIf
			(cAlTRK)->(DbSkip())
		EndDo
	EndIf
	(cAlTRK)->(DbCloseArea())

Return
