/*/{Protheus.doc} movementValuation
    Classe responsavel por calcular e valorizar os movimentos em partes
    @author Squad Entradas
    @since 25/04/2025
/*/
Class movementProcessParts from TableManager

    public method new()
    public method valueMovementParts()
    public method updateProcTableParts()
    public method buildQryStatement()
    public method productDisassemblyQueryBuilder()
    public method updateAverageCostInAllParts()
	public method thirdPartiesQueryBuilder()
    public method existsMovementInPeriod()
    public method balanceUpdaterByEntryCP()

    Public Data cAgglutTable                       as character
    Public Data cAgglutTableCP                     as character
    Public Data cProcTableCP                       as character
    Public Data cProcTable                         as character
    Public Data cAnalyTable                        as character
    Public Data cAnalyTableCP                      as character
    Public Data cTableOPCP                         as character
    Public Data cRevisao                           as character
    Public Data cFProc                             as character
    Public Data cViewTransfer                      as character
    Public Data cOutros                            as character
    Public Data cCusFil                            as character
    Public Data obuildQryStatementDE7              as object
    Public Data oBuildQryStatementByAvgCost        as object
    Public Data obuildQryStatementByValuated       as object
    Public Data obuildQryStatementByValuation      as object
    Public Data oBuildQryupdateProcTableParts      as object
    Public Data oBuildQryStatementByTransfer       as object
    Public Data oBuildQryStatementUpdAllParts      as object
    Public Data oBuildQryByEntriesInPeriod         as object
    Public Data oBuildQryByEntriesOutPeriodSeekSD2 as object
    Public Data oBuildQryByEntriesOutPeriodKeepSD1 as object
	Public Data oBuildQryStatementTrdPartiesSD1    as object
    Public Data oBuildQryStatementTrdPartiesSD2    as object
    Public Data obuildQryStatementCQSD1Normal      as object
    Public Data obuildQryStatementCQSD1Comp        as object
    Public Data obuildQryStatementCQPR0Found       as object
    Public Data obuildQryStatementCQPR0NotFound    as object
    Public Data obuildQryStatementCQTRFound        as object
    Public Data obuildQryStatementCQTRNotFound     as object
    Public Data obuildQryStatementSC2              as object
    Public Data oExistsMovementInPeriod            as object
    Public Data oQueryBalanceUpdate                as object

End Class

/*/{Protheus.doc} new
    Instacia a classe
    @author Squad.Entradas
    @since 25/04/2025
    @version 1.0
    @return self, object, self
    /*/
Method new(cFProc, cCusFil) class movementProcessParts

    ::cFProc           := cFProc
    ::cAgglutTable     := AgglutinatedMovementTable():TableName()
    ::cAgglutTableCP   := AgglutinatedMovementPartsTable():TableName()
    ::cAnalyTable      := AnalyticalMovementTable():TableName()
    ::cAnalyTableCP    := AnalyticalMovementPartsTable():TableName()
    ::cProcTable       := ProcessingTable():TableName()
    ::cProcTableCP     := PartsProcessingTable():TableName()
    ::cTableOPCP       := BalanceByProductionOrderParts():TableName() 
    ::cRevisao         := E330RevAti()
    ::cViewTransfer    := "VW_" + ViewTransferInvoice():GetViewID() + "_" + cEmpAnt
    ::cOutros          := Replicate("9", TamSX3("D4F_CODPAR")[1])
    ::cCusFil          := cCusFil

    _Super:New({})

Return self

/*/{Protheus.doc} valueMovementParts
    Atualiza o custo do movimento na tabela de movimentação aglutinada por CP
    @author Squad.Entradas
    @since 25/04/2025
    @version 1.0
    @param  oMovement, object, objeto com dados do movimento
            cFilAtu, character, filial corrente
            aMoedas, array, moedas utilizadas
            dDtIni, date, data inicio processamento
            dDtFim, date, data fim processamento
    /*/
Method valueMovementParts(oTabSldOP,oMovement,cFilAtu,aMoedas,dDtIni,dDtFim) class movementProcessParts
    local cQuery        as character
    local cMerge        as character
    local nX            as numeric
    local aMatch        := {}
    local aUpdate       := {}
    local aCpoDest      := {}
    local aInsert       := {}
    
    //Campos que serao atualizados
    AAdd(aUpdate, "CUSTO = ORIGEM.CUSTO")

    //Filtro do Update
    AAdd(aMatch, {"FILPROC", "FILPROC"})
    AAdd(aMatch, {"FILIAL" , "FILIAL"})
    AAdd(aMatch, {"CODPAR" , "CODPAR"})
    AAdd(aMatch, {"MOEDA"  , "MOEDA"})
    AAdd(aMatch, {"RECPAI" , "RECPAI"})

    //Campos que receberão valor
    AAdd(aCpoDest, "RECPAI")
    AAdd(aCpoDest, "FILPROC")
    AAdd(aCpoDest, "FILIAL")
    AAdd(aCpoDest, "CODPAR")
    AAdd(aCpoDest, "MOEDA")
    AAdd(aCpoDest, "CUSTO")
    AAdd(aCpoDest, "LOCARM")
    AAdd(aCpoDest, "CHVAGL")

    //Conteúdo dos campos
    AAdd(aInsert, "ORIGEM.RECPAI")
    AAdd(aInsert, "ORIGEM.FILPROC")
    AAdd(aInsert, "ORIGEM.FILIAL")
    AAdd(aInsert, "ORIGEM.CODPAR")
    AAdd(aInsert, "ORIGEM.MOEDA")
    AAdd(aInsert, "ORIGEM.CUSTO")
    AAdd(aInsert, "ORIGEM.LOCARM")
    AAdd(aInsert, "ORIGEM.CHVAGL")

    For nX := 1 to Len(aMoedas)

        //retorna a query para o merge
        cQuery := ::buildQryStatement(oTabSldOP,oMovement,aMoedas[nX],cFilAtu,dDtIni,dDtFim)

        //retorna o merge pronto para execucao
        cMerge := ::MergeStatement(::cAgglutTableCP, cQuery, aMatch, aUpdate, aCpoDest, aInsert)

        //Executa o merge
        ::RunQuery(cMerge)
    Next nX

Return

/*/{Protheus.doc} updateProcTableParts
    Atualiza o saldo do produto na tabela de processamento em partes
    @author Squad.Entradas
    @since 25/04/2025
    @version 1.0
    @param  oMovement, object, objeto com dados do movimento
            cFilAtu, character, filial corrente
    /*/
Method updateProcTableParts(oMovement, cFilAtu, nIter) class movementProcessParts
    local cQuery        as character
    local cMerge        as character
    local cUpdate       as character
    local aMatch        := {}
    local aUpdate       := {}
    local aCpoDest      := {}
    local aInsert       := {}

    //Query principal do CTE
    If ::oBuildQryupdateProcTableParts == Nil
        cQuery := " SELECT AGLCP.FILPROC,AGLCP.FILIAL,AGLCP.CODPAR,AGLCP.MOEDA,AGL.COD,AGL.LOCARM, "
        cQuery += " CASE WHEN AGL.TM > '500' THEN AGL.QUANT * -1 ELSE AGL.QUANT END QUANT, "
        cQuery += " CASE WHEN AGL.TM > '500' THEN AGLCP.CUSTO * -1 ELSE AGLCP.CUSTO END CUSTO, "
        cQuery += ::cCoalesce+"(PROCP.R_E_C_N_O_,0) PRORECNUMBER "
        cQuery += " FROM " + ::cAgglutTableCP + " AGLCP "
        cQuery += " INNER JOIN " +::cAgglutTable+ " AGL ON "
        cQuery += " AGL.R_E_C_N_O_ = AGLCP.RECPAI "
        cQuery += " LEFT JOIN " +::cProcTableCP+ " PROCP ON "
        cQuery += " PROCP.FILPROC = AGLCP.FILPROC AND "
        cQuery += " PROCP.FILIAL = AGLCP.FILIAL AND "
        cQuery += " PROCP.COD = AGL.COD AND "
        cQuery += " PROCP.ARMAZEM = AGLCP.LOCARM AND "
        cQuery += " PROCP.CODPAR = AGLCP.CODPAR AND "
        cQuery += " PROCP.MOEDA = AGLCP.MOEDA "
        cQuery += " WHERE AGLCP.RECPAI = ? "

        cQuery := ChangeQuery(cQuery)

        ::oBuildQryupdateProcTableParts := FWExecStatement():New(cQuery)
    EndIf

    ::oBuildQryupdateProcTableParts:SetNumeric(1, oMovement["r_e_c_n_o_"])

    //Retorna a query com a substituicao dos binds
    cQuery := ::oBuildQryupdateProcTableParts:GetFixQuery()

    AAdd(aMatch, {"PRORECNUMBER", "R_E_C_N_O_"})

    cUpdate := " CSTPROC = CASE "
    cUpdate += " WHEN ((DESTINO.CSTPROC + ORIGEM.CUSTO) < 0) THEN 0 "
    cUpdate += " ELSE (DESTINO.CSTPROC + ORIGEM.CUSTO) "
    cUpdate += " END "
    AAdd(aUpdate, cUpdate)
    cUpdate := " CMPROC  = CASE "
    cUpdate += " WHEN ( DESTINO.QTDPROC + ORIGEM.QUANT ) > 0 THEN "
    cUpdate += " CASE "
    cUpdate += " WHEN ( ( DESTINO.CSTPROC + ORIGEM.CUSTO ) / ( "
    cUpdate += " DESTINO.QTDPROC + ORIGEM.QUANT ) ) < 0 "
    cUpdate += " THEN 0 "
    cUpdate += " ELSE ( ( DESTINO.CSTPROC + ORIGEM.CUSTO ) / ( "
    cUpdate += " DESTINO.QTDPROC + ORIGEM.QUANT ) ) "
    cUpdate += " END "
    cUpdate += " ELSE DESTINO.CMPROC "
    cUpdate += " END "
    AAdd(aUpdate, cUpdate)
    cUpdate := " QTDPROC = CASE "
    cUpdate += " WHEN DESTINO.QTDPROC + ORIGEM.QUANT < 0 THEN 0 "
    cUpdate += " ELSE DESTINO.QTDPROC + ORIGEM.QUANT END "
    AAdd(aUpdate, cUpdate)
    AAdd(aUpdate, "ITERACAO = "+cValToChar(nIter))

    AAdd(aCpoDest, "FILPROC")
    AAdd(aCpoDest, "FILIAL")
    AAdd(aCpoDest, "ITERACAO")
    AAdd(aCpoDest, "COD")
    AAdd(aCpoDest, "ARMAZEM")
    AAdd(aCpoDest, "CODPAR")
    AAdd(aCpoDest, "MOEDA")
    AAdd(aCpoDest, "QTDHIST")
    AAdd(aCpoDest, "QTDPROC")
    AAdd(aCpoDest, "CSTHIST")
    AAdd(aCpoDest, "CSTPROC")
    AAdd(aCpoDest, "CMHIST")
    AAdd(aCpoDest, "CMPROC")

    AAdd(aInsert, "ORIGEM.FILPROC")
    AAdd(aInsert, "ORIGEM.FILIAL")
    AAdd(aInsert, cValToChar(nIter))
    AAdd(aInsert, "ORIGEM.COD")
    AAdd(aInsert, "ORIGEM.LOCARM")
    AAdd(aInsert, "ORIGEM.CODPAR")
    AAdd(aInsert, "ORIGEM.MOEDA")
    AAdd(aInsert, "0")
    AAdd(aInsert, "ORIGEM.QUANT")
    AAdd(aInsert, "0")
    AAdd(aInsert, "ORIGEM.CUSTO")
    AAdd(aInsert, "0")
    AAdd(aInsert, "CASE WHEN ORIGEM.QUANT > 0 THEN ORIGEM.CUSTO / ORIGEM.QUANT ELSE 0 END")

    cMerge := ::MergeStatement(::cProcTableCP, cQuery, aMatch, aUpdate, aCpoDest, aInsert)

    //Executa o CTE
    ::RunQuery(cMerge)

Return

/*/{Protheus.doc} buildQryStatement
    Retorna a query para ser utilizada no merge do metodo valueMovementParts
    @author Squad.Entradas
    @since 25/04/2025
    @version 1.0
    @param  oMovement, object, objeto com dados do movimento
            cMoeda, character, moeda em execucao
            cFilAtu, character, filial corrente
            dDtIni, date, data inicio processamento
            dDtFim, date, data fim processamento
    /*/
Method buildQryStatement(oTabSldOP,oMovement,cMoeda,cFilAtu,dDtIni,dDtFim) class movementProcessParts
    local cQuery    := ""                     as character
    local cMoedaStr := StrZero(Val(cMoeda),2) as character
    Local nX        := 1 as integer
    local nRecnoSD3 as integer
    local lFound    as logical

    If oMovement["customedio"] == "S"
        If ::oBuildQryStatementByAvgCost == Nil
            cQuery := " SELECT AGL.R_E_C_N_O_ RECPAI,AGL.FILPROC,AGL.FILIAL,AGL.QUANT, "
            cQuery += " AGL.LOCARM,AGL.CHVAGL, "
            cQuery += " (AGL.QUANT * TRHCP.CMPROC) CUSTO, "
            cQuery += " TRHCP.CODPAR CODPAR,TRHCP.MOEDA "
            cQuery += " FROM " + ::cAgglutTable + " AGL "
            cQuery += " INNER JOIN " + ::cProcTableCP +" TRHCP "
            cQuery += " ON TRHCP.FILPROC = AGL.FILPROC "
			cQuery += " AND TRHCP.FILIAL = AGL.FILIAL "
			cQuery += " AND TRHCP.COD = AGL.COD "
			cQuery += " AND TRHCP.ARMAZEM = AGL.LOCARM "
            cQuery += " WHERE AGL.R_E_C_N_O_ = ? "

            cQuery := ChangeQuery(cQuery)

            ::oBuildQryStatementByAvgCost := FWExecStatement():New(cQuery)
        EndIf

        ::oBuildQryStatementByAvgCost:SetNumeric(1, oMovement["r_e_c_n_o_"])

        cQuery := ::oBuildQryStatementByAvgCost:GetFixQuery()
    ElseIf oMovement["cf"] $ "DE6|RE6"
        If !Empty((::cAgglutTable)->NUMCQ)
            //Movimento originado por um lançamento de compra (SD1) 
            If (::cAgglutTable)->ORIGLAN == "CP"
                //Documento de compra
                If (::cAgglutTable)->QUANT > 0
                    If ::obuildQryStatementCQSD1Normal == Nil
                        cQuery := " SELECT AGL.R_E_C_N_O_ RECPAI,AGL.FILPROC,AGL.FILIAL,AGL.QUANT, "
                        cQuery += " AGL.LOCARM,AGL.CHVAGL, "
                        cQuery += " CASE WHEN AGL.QUANT = SD1.D1_QUANT THEN SD1.D1_CUSTO? "
                        cQuery += " ELSE (SD1.D1_CUSTO? / SD1.D1_QUANT) * AGL.QUANT "
                        cQuery += " END CUSTO, "
                        cQuery += ::cCoalesce+"(D4G.D4G_CODPAR,'99') CODPAR, "
                        cQuery += " ? MOEDA "
                        cQuery += " FROM "+::cAgglutTable+" AGL "
                        
                        //Localiza a nota fiscal de entrada para obter a quantidade original do mov.
                        cQuery += " INNER JOIN "+RetSQLName("SD1")+" SD1 "
                        cQuery += " ON SD1.D1_FILIAL = AGL.FILIAL "
                        cQuery += " AND SD1.D1_COD = AGL.COD "
                        cQuery += " AND SD1.D1_NUMSEQ = AGL.IDENT "
                        cQuery += " AND SD1.D_E_L_E_T_ = ? "

                        //Localiza o cadastro na D4G, utilizado para todas as nf's
                        cQuery += " LEFT JOIN "+RetSQLName("D4G")+" D4G "
                        cQuery += " ON D4G.D4G_FILIAL = ? "
                        cQuery += " AND D4G.D4G_REVIS = ? "
                        cQuery += " AND D4G.D4G_PRODUT = AGL.COD "
                        cQuery += " AND D4G.D_E_L_E_T_ = ? "

                        //Recno do movimento na tabela aglutinada
                        cQuery += " WHERE AGL.R_E_C_N_O_ = ? "

                        cQuery := ChangeQuery(cQuery)

                        ::obuildQryStatementCQSD1Normal := FWExecStatement():New(cQuery)
                    EndIf

                    If cMoeda == "1"
                        ::obuildQryStatementCQSD1Normal:SetUnsafe(nX++, ' ')
                        ::obuildQryStatementCQSD1Normal:SetUnsafe(nX++, ' ')
                    Else
                        ::obuildQryStatementCQSD1Normal:SetUnsafe(nX++, cMoeda)
                        ::obuildQryStatementCQSD1Normal:SetUnsafe(nX++, cMoeda)
                    EndIf
                    
                    ::obuildQryStatementCQSD1Normal:SetString(nX++, cMoedaStr)
                    ::obuildQryStatementCQSD1Normal:SetString(nX++, ' ')                    
                    ::obuildQryStatementCQSD1Normal:SetString(nX++, FWxFilial("D4G"))
                    ::obuildQryStatementCQSD1Normal:SetString(nX++, ::cRevisao)
                    ::obuildQryStatementCQSD1Normal:SetString(nX++, ' ')
                    ::obuildQryStatementCQSD1Normal:SetNumeric(nX++, oMovement["r_e_c_n_o_"])

                    cQuery := ::obuildQryStatementCQSD1Normal:GetFixQuery()
                Else
                    //Documento de complemento
                    If ::obuildQryStatementCQSD1Comp == Nil
                        cQuery := " SELECT AGL.R_E_C_N_O_ RECPAI,AGL.FILPROC,AGL.FILIAL,AGL.QUANT, "
                        cQuery += " AGL.LOCARM,AGL.CHVAGL, "
                        cQuery += " CASE WHEN SD1.D1_TIPO = 'C' AND SD7.D7_QTDE = SD1CP.D1_QUANT THEN SD1.D1_CUSTO? "
                        cQuery += " ELSE ( SD1.D1_CUSTO? / SD1CP.D1_QUANT ) * SD7.D7_QTDE "
                        cQuery += " END CUSTO, "
                        cQuery += ::cCoalesce+"(D4G.D4G_CODPAR,'99') CODPAR, "
                        cQuery += " ? MOEDA "
                        cQuery += " FROM "+::cAgglutTable+" AGL "
                        
                        //Obtem o custo total da nf de complemento
                        cQuery += " INNER JOIN "+RetSQLName("SD1")+" SD1 "
                        cQuery += " ON SD1.D1_FILIAL = AGL.FILIAL "
                        cQuery += " AND SD1.D1_COD = AGL.COD "
                        cQuery += " AND SD1.D1_NUMSEQ = AGL.IDENT "
                        cQuery += " AND SD1.D_E_L_E_T_ = ? "

                        //Obtem a quantidade total da nota de compra
                        cQuery += " INNER JOIN "+RetSQLName("SD1")+" SD1CP "
                        cQuery += " ON SD1CP.D1_FILIAL = SD1.D1_FILIAL "
                        cQuery += " AND SD1CP.D1_DOC = SD1.D1_NFORI "
                        cQuery += " AND SD1CP.D1_SERIE = SD1.D1_SERIORI "
                        cQuery += " AND SD1CP.D1_FORNECE = SD1.D1_FORNECE "
                        cQuery += " AND SD1CP.D1_LOJA = SD1.D1_LOJA "
                        cQuery += " AND SD1CP.D1_ITEM = SD1.D1_ITEMORI "
                        cQuery += " AND SD1CP.D1_LOCAL = SD1.D1_LOCAL "
                        cQuery += " AND SD1CP.D_E_L_E_T_ = ? "

                        //Como o movimento possui quantidade 0 na TRL, busca a quantidade liberada da SD7
                        cQuery += " INNER JOIN "+RetSQLName("SD7")+" SD7 "
                        cQuery += " ON SD7.D7_FILIAL = AGL.FILIAL "
                        cQuery += " AND SD7.D7_PRODUTO = AGL.COD "
                        cQuery += " AND SD7.D7_NUMSEQ = AGL.SEQ "
                        cQuery += " AND SD7.D7_ESTORNO = ? "
                        cQuery += " AND SD7.D_E_L_E_T_ = ? "

                        //Localiza a parte na tabela D4G para valorização da parte
                        cQuery += " LEFT JOIN "+RetSQLName("D4G")+" D4G "
                        cQuery += " ON D4G.D4G_FILIAL = ? "
                        cQuery += " AND D4G.D4G_REVIS = ? "
                        cQuery += " AND D4G.D4G_PRODUT = AGL.COD "
                        cQuery += " AND D4G.D_E_L_E_T_ = ? "

                        //Recno do movimento na tabela aglutinada
                        cQuery += " WHERE AGL.R_E_C_N_O_ = ? "

                        cQuery := ChangeQuery(cQuery)

                        ::obuildQryStatementCQSD1Comp := FWExecStatement():New(cQuery)
                    EndIf

                    If cMoeda == "1"
                        ::obuildQryStatementCQSD1Comp:SetUnsafe(nX++, ' ')
                        ::obuildQryStatementCQSD1Comp:SetUnsafe(nX++, ' ')
                    Else
                        ::obuildQryStatementCQSD1Comp:SetUnsafe(nX++, cMoeda)
                        ::obuildQryStatementCQSD1Comp:SetUnsafe(nX++, cMoeda)
                    EndIf
                    ::obuildQryStatementCQSD1Comp:SetString(nX++, cMoedaStr)
                    ::obuildQryStatementCQSD1Comp:SetString(nX++, ' ')
                    ::obuildQryStatementCQSD1Comp:SetString(nX++, ' ')                    
                    ::obuildQryStatementCQSD1Comp:SetString(nX++, ' ')
                    ::obuildQryStatementCQSD1Comp:SetString(nX++, ' ')
                    ::obuildQryStatementCQSD1Comp:SetString(nX++, FWxFilial("D4G"))
                    ::obuildQryStatementCQSD1Comp:SetString(nX++, ::cRevisao)
                    ::obuildQryStatementCQSD1Comp:SetString(nX++, ' ')
                    ::obuildQryStatementCQSD1Comp:SetNumeric(nX++, oMovement["r_e_c_n_o_"])

                    cQuery := ::obuildQryStatementCQSD1Comp:GetFixQuery()
                EndIf
            ElseIf (::cAgglutTable)->ORIGLAN == "PR"
                //Movimento originado por um lançamento de produção (SD3)
                lFound := ::existsMovementInPeriod(@nRecnoSD3,cFilAtu,dDtIni,dDtFim,.T.)
                If (lFound .And. ::obuildQryStatementCQPR0Found == Nil) .Or. (!lFound .And. ::obuildQryStatementCQPR0NotFound == Nil)
                    cQuery := " SELECT AGL.R_E_C_N_O_ RECPAI,AGL.FILPROC,AGL.FILIAL,AGL.QUANT, "
                    cQuery += " AGL.LOCARM,AGL.CHVAGL, "
	                If lFound
                        cQuery += " CASE WHEN AGL.QUANT = SD3.D3_QUANT THEN TRLCP.CUSTO ELSE "
	                    cQuery += " (TRLCP.CUSTO / SD3.D3_QUANT) * AGL.QUANT END CUSTO, "
                        cQuery += " TRLCP.CODPAR CODPAR, "
	                Else
                        cQuery += " CASE WHEN AGL.QUANT = SD3.D3_QUANT THEN COALESCE(D4N.D4N_TOTAL,SD3.D3_CUSTO?,0) ELSE "
	                    cQuery += " (COALESCE(D4N.D4N_TOTAL,SD3.D3_CUSTO?,0) / SD3.D3_QUANT * AGL.QUANT) END CUSTO, "
                        cQuery += ::cCoalesce+"(D4N.D4N_PARTE,'99') CODPAR, "
                    EndIf
                    cQuery += " ? MOEDA "
                    cQuery += " FROM "+::cAgglutTable+" AGL "

                    //Localiza o apontamento de produção para obter a quantidade original do mov.
	                cQuery += " INNER JOIN "+RetSQLName("SD3")+" SD3 "
                    cQuery += " ON SD3.R_E_C_N_O_ = ?

                    If lFound
                        //Se o movimento estiver no mesmo período da liberação/rejeição, o apontamento não estará na
                        //D4N, então é obtido o custo em partes do apontamento da TRLCP
                        cQuery += " INNER JOIN " +::cAgglutTable+" TRL ON "
                        cQuery += " TRL.FILPROC = AGL.FILPROC AND "
                        cQuery += " TRL.FILIAL = AGL.FILIAL AND "
                        cQuery += " TRL.CF = SD3.D3_CF AND "
                        cQuery += " TRL.RECNO = SD3.R_E_C_N_O_ "
                        cQuery += " INNER JOIN " +::cAgglutTableCP+" TRLCP ON "
                        cQuery += " TRLCP.RECPAI = TRL.R_E_C_N_O_ AND "
                        cQuery += " TRLCP.MOEDA = ? "
                    Else
                        //Verifico se o apontamento existe na D4N para obter o custo em partes origem
                        cQuery += " LEFT JOIN "+RetSQLName("D4N")+" D4N "
                        cQuery += " ON D4N.D4N_FILIAL = AGL.FILIAL "
                        cQuery += " AND "+joinMSUID('D4N.D4N_IDSD3', 'SD3.D3_MSUID')
                        cQuery += " AND D4N.D4N_MOEDA = ? "
                        cQuery += " AND D4N.D_E_L_E_T_ = ? "
                    EndIf

                    //Recno do movimento na tabela aglutinada
                    cQuery += " WHERE AGL.R_E_C_N_O_ = ? "

                    cQuery := ChangeQuery(cQuery)

                    If lFound
                        ::obuildQryStatementCQPR0Found    := FWExecStatement():New(cQuery)
                    Else
                        ::obuildQryStatementCQPR0NotFound := FWExecStatement():New(cQuery)
                    EndIf
                EndIf

                If lFound
                    ::obuildQryStatementCQPR0Found:SetString(nX++, cMoedaStr)
                    ::obuildQryStatementCQPR0Found:SetNumeric(nX++, nRecnoSD3)
                    ::obuildQryStatementCQPR0Found:SetString(nX++, cMoedaStr)
                    ::obuildQryStatementCQPR0Found:SetNumeric(nX++, oMovement["r_e_c_n_o_"])
                    cQuery := ::obuildQryStatementCQPR0Found:GetFixQuery()
                Else
                    ::obuildQryStatementCQPR0NotFound:SetUnsafe(nX++, cMoeda)
                    ::obuildQryStatementCQPR0NotFound:SetUnsafe(nX++, cMoeda)
                    ::obuildQryStatementCQPR0NotFound:SetString(nX++, cMoedaStr)
                    ::obuildQryStatementCQPR0NotFound:SetNumeric(nX++, nRecnoSD3)
                    ::obuildQryStatementCQPR0NotFound:SetString(nX++, cMoedaStr)
                    ::obuildQryStatementCQPR0NotFound:SetString(nX++, ' ')
                    ::obuildQryStatementCQPR0NotFound:SetNumeric(nX++, oMovement["r_e_c_n_o_"])
                    cQuery := ::obuildQryStatementCQPR0NotFound:GetFixQuery()
                EndIf
            Else
                //Movimento originado por transferência (ORIGLAN = TR)
                lFound := ::existsMovementInPeriod(@nRecnoSD3,cFilAtu,dDtIni,dDtFim,.F.)
                If (lFound .And. ::obuildQryStatementCQTRFound == Nil) .Or. (!lFound .And. ::obuildQryStatementCQTRNotFound == Nil)
                    cQuery := " SELECT AGL.R_E_C_N_O_ RECPAI,AGL.FILPROC,AGL.FILIAL,AGL.QUANT, "
                    cQuery += " AGL.LOCARM,AGL.CHVAGL, "
                    If lFound
                        cQuery += " CASE WHEN SD3.D3_CF = 'RE4' THEN ( TRHCP.CMPROC * AGL.QUANT ) "
                        cQuery += " ELSE (TRHCP.CMPROC * AGL.QUANT * (SD3.D3_RATEIO/100) ) END CUSTO, "
                        cQuery += " TRHCP.CODPAR, "
                    Else
                        cQuery += " CASE WHEN AGL.QUANT = SD3.D3_QUANT THEN "+::cCoalesce+"(D4N.D4N_TOTAL,SD3.D3_CUSTO?,0) ELSE "
                        cQuery += "("+::cCoalesce+"(D4N.D4N_TOTAL,SD3.D3_CUSTO?,0) / SD3.D3_QUANT) * AGL.QUANT END CUSTO, "
                        cQuery += ::cCoalesce+"(D4N.D4N_PARTE,'99') CODPAR, "
                    EndIf
                    cQuery += " ? MOEDA "
                    cQuery += " FROM "+::cAgglutTable+" AGL "

                    //Localiza o movimento origem da transferência para obter a quantidade original do mov.
                    cQuery += " INNER JOIN "+RetSQLName("SD3")+" SD3 "
                    cQuery += " ON SD3.R_E_C_N_O_ = ?

                    //Localiza o movimento origem da transferencia na TRL quando os movimentos
                    //estao no mesmo periodo
                    If lFound
                        cQuery += " INNER JOIN " +::cProcTableCP+" TRHCP ON "
                        cQuery += " TRHCP.FILPROC = AGL.FILPROC AND "
                        cQuery += " TRHCP.FILIAL = AGL.FILIAL AND "
                        cQuery += " TRHCP.COD = SD3.D3_COD AND "
                        cQuery += " TRHCP.ARMAZEM = SD3.D3_LOCAL AND "
                        cQuery += " TRHCP.MOEDA = ? "
                    Else
                        //Localiza o apontamento na D4N para obter o custo em partes origem
                        cQuery += " LEFT JOIN "+RetSQLName("D4N")+" D4N "
                        cQuery += " ON D4N.D4N_FILIAL = AGL.FILIAL "
                        cQuery += " AND "+joinMSUID('D4N.D4N_IDSD3', 'SD3.D3_MSUID')
                        cQuery += " AND D4N.D4N_MOEDA = ? "
                        cQuery += " AND D4N.D_E_L_E_T_ = ? "
                    EndIf

                    cQuery += " WHERE AGL.R_E_C_N_O_ = ? "

                    cQuery := ChangeQuery(cQuery)

                    If lFound
                        ::obuildQryStatementCQTRFound := FWExecStatement():New(cQuery)
                    Else
                        ::obuildQryStatementCQTRNotFound := FWExecStatement():New(cQuery)
                    EndIf
                EndIf

                If lFound
                    ::obuildQryStatementCQTRFound:SetString(nX++, cMoedaStr)
                    ::obuildQryStatementCQTRFound:SetNumeric(nX++, nRecnoSD3)
                    ::obuildQryStatementCQTRFound:SetString(nX++, cMoedaStr)
                    ::obuildQryStatementCQTRFound:SetNumeric(nX++, oMovement["r_e_c_n_o_"])
                    cQuery := ::obuildQryStatementCQTRFound:GetFixQuery()
                Else
                    ::obuildQryStatementCQTRNotFound:SetUnsafe(nX++, cMoeda)
                    ::obuildQryStatementCQTRNotFound:SetUnsafe(nX++, cMoeda)
                    ::obuildQryStatementCQTRNotFound:SetString(nX++, cMoedaStr)
                    ::obuildQryStatementCQTRNotFound:SetNumeric(nX++, nRecnoSD3)
                    ::obuildQryStatementCQTRNotFound:SetString(nX++, cMoedaStr)
                    ::obuildQryStatementCQTRNotFound:SetString(nX++, ' ')
                    ::obuildQryStatementCQTRNotFound:SetNumeric(nX++, oMovement["r_e_c_n_o_"])
                    cQuery := ::obuildQryStatementCQTRNotFound:GetFixQuery()
                EndIf
            EndIf
        Else
            If ::obuildQryStatementByValuated == Nil
                cQuery := " SELECT AGL.R_E_C_N_O_ RECPAI,AGL.FILPROC,AGL.FILIAL,AGL.QUANT, "
                cQuery += " AGL.LOCARM,AGL.CHVAGL, AGL.CUSTO? CUSTO,"
                cQuery += ::cCoalesce+"(D4G.D4G_CODPAR, '99') CODPAR, "
                cQuery += " ? MOEDA "
                cQuery += " FROM " + ::cAgglutTable + " AGL "
                cQuery += " LEFT JOIN " + RetSqlName("D4G") + " D4G ON "
                cQuery += " D4G.D4G_FILIAL = ? AND "
                cQuery += " D4G.D4G_REVIS = ? AND "
                cQuery += " D4G.D4G_PRODUT = AGL.COD AND "
                cQuery += " D4G.D_E_L_E_T_ = ? "
                cQuery += " WHERE AGL.R_E_C_N_O_ = ? "

                cQuery := ChangeQuery(cQuery)

                ::obuildQryStatementByValuated := FWExecStatement():New(cQuery)
            EndIf

            ::obuildQryStatementByValuated:SetUnsafe(1, cMoeda)
            ::obuildQryStatementByValuated:SetString(2, cMoedaStr)
            ::obuildQryStatementByValuated:SetString(3, FWxFilial("D4G",cFilAtu))
            ::obuildQryStatementByValuated:SetString(4, ::cRevisao)
            ::obuildQryStatementByValuated:SetString(5, ' ')
            ::obuildQryStatementByValuated:SetNumeric(6, oMovement["r_e_c_n_o_"])

            cQuery := ::obuildQryStatementByValuated:GetFixQuery()
        EndIf
    ElseIf oMovement["cf"] == "DE4"
        If ::oBuildQryStatementByTransfer  == NIL
            cQuery := " SELECT AGL.R_E_C_N_O_ RECPAI "
            cQuery += "     ,AGL.FILPROC "
            cQuery += "     ,AGL.FILIAL "
            cQuery += "     ,PROCP.CODPAR CODPAR "
            cQuery += "     ,PROCP.MOEDA MOEDA "
            cQuery += "     ,(AGL.QUANT * PROCP.CMPROC) CUSTO "
            cQuery += "     ,AGL.LOCARM "
            cQuery += "     ,AGL.QUANT "
            cQuery += "     ,AGL.CHVAGL  "
            cQuery += " FROM " + ::cAgglutTable + " AGL "
            cQuery += " INNER JOIN " + ::cProcTableCP + " PROCP "
            cQuery += "     ON  PROCP.FILPROC = AGL.FILPROC "
            If ::cCusFil != 'E'
                cQuery += "     AND PROCP.FILIAL  = AGL.FILIAL "
            EndIf
            cQuery += "     AND PROCP.COD     = AGL.CODORI "
            If ::cCusFil == 'A'
                cQuery += "     AND PROCP.ARMAZEM = AGL.LOCORI "
            EndIf
            cQuery += "     AND PROCP.MOEDA = ? " //1
            cQuery += " WHERE AGL.R_E_C_N_O_ = ? " //2

            cQuery := ChangeQuery(cQuery)

            ::oBuildQryStatementByTransfer := FWExecStatement():New(cQuery)
        EndIf

        ::oBuildQryStatementByTransfer:SetString(1, cMoedaStr )
        ::oBuildQryStatementByTransfer:SetNumeric(2, oMovement["r_e_c_n_o_"] )

        cQuery := ::oBuildQryStatementByTransfer:GetFixQuery()
    ElseIf oMovement['cf'] == "DE7"
        cQuery := ::productDisassemblyQueryBuilder(oMovement["r_e_c_n_o_"],cMoedaStr)
	Elseif !Empty((::cAgglutTable)->(IDENTB6)) .And. (::cAgglutTable)->(PODER3) == 'D'
        cQuery := ::thirdPartiesQueryBuilder(oMovement['alias'],oMovement["r_e_c_n_o_"],cMoedaStr)
    ElseIf oMovement["alias"] == "SD1" .And. (::cAgglutTable)->(FILTRF) == "1"
        If oMovement["samePeriod"]
            If ::oBuildQryByEntriesInPeriod == Nil
                cQuery := " SELECT AGL.R_E_C_N_O_ RECPAI, "
                cQuery += "        AGL.FILPROC FILPROC, "
                cQuery += "        AGL.FILIAL FILIAL, "
                cQuery +=          ::cCoalesce + "(ANLCP.CODPAR, '" + ::cOutros + "') CODPAR, "
                cQuery +=          ::cCoalesce + "(ANLCP.MOEDA, ?) MOEDA, "
                cQuery += "        AGL.LOCARM LOCARM, "
                cQuery += "        AGL.CHVAGL CHVAGL, "
                cQuery += "        CASE "
                cQuery += "            WHEN ORIG.CUSTOMEDIO = 'S' "
                cQuery += "                THEN " + ::cCoalesce + "((ORIG.QUANT * PROCP.CMPROC), ORIG.CUSTO?)"
                cQuery += "            ELSE " + ::cCoalesce + "(ANLCP.CUSTO, ORIG.CUSTO?)"
                cQuery += "        END CUSTO "
                cQuery += " FROM " + ::cAgglutTable + " AGL "
                cQuery += " INNER JOIN " + ::cAnalyTable + " DEST "
                cQuery += " 	ON  DEST.FILPROC = AGL.FILPROC "
                cQuery += " 	AND DEST.FILIAL = AGL.FILIAL "
                cQuery += " 	AND DEST.COD = AGL.COD "
                cQuery += " 	AND DEST.LOCARM = AGL.LOCARM "
                cQuery += " 	AND DEST.CHVAGL = AGL.CHVAGL "
                cQuery += " INNER JOIN " + ::cViewTransfer + " TRF "
                cQuery += "     ON  TRF.RECDES = DEST.RECNO "
                cQuery += "     AND TRF.D2_EMISSAO >= ? "
                cQuery += " 	AND TRF.D2_EMISSAO <= ? "
                cQuery += " INNER JOIN " + ::cAnalyTable + " ORIG "
                cQuery += " 	ON  ORIG.FILPROC = DEST.FILPROC "
                cQuery += " 	AND ORIG.FILIAL = TRF.FILORI "
                cQuery += " 	AND ORIG.ALIAS = ? "
                cQuery += " 	AND ORIG.FILTRF = ? "
                cQuery += " 	AND ORIG.RECNO = TRF.RECORI "
                cQuery += " LEFT JOIN " + ::cAnalyTableCP + " ANLCP "
                cQuery += " 	ON  ANLCP.RECPAI = ORIG.R_E_C_N_O_ "
                cQuery += " 	AND ANLCP.MOEDA = ? "
                cQuery += " LEFT JOIN " + ::cProcTableCP + " PROCP "
                cQuery += " 	ON	PROCP.FILPROC = ORIG.FILPROC "
                cQuery += " 	AND PROCP.FILIAL = ORIG.FILIAL "
                cQuery += " 	AND PROCP.COD = ORIG.COD "
                cQuery += " 	AND PROCP.ARMAZEM = ORIG.LOCARM "
                cQuery += " 	AND PROCP.CODPAR = ANLCP.CODPAR "
                cQuery += " 	AND PROCP.MOEDA = ? "
                cQuery += " WHERE AGL.R_E_C_N_O_ = ? "

                cQuery := ChangeQuery(cQuery)

                ::oBuildQryByEntriesInPeriod := FWExecStatement():New(cQuery)
            EndIf
            ::oBuildQryByEntriesInPeriod:SetString(1, cMoedaStr)
            ::oBuildQryByEntriesInPeriod:SetUnsafe(2, cMoeda)
            ::oBuildQryByEntriesInPeriod:SetUnsafe(3, cMoeda)
            ::oBuildQryByEntriesInPeriod:SetString(4, dToS(dDtIni))
            ::oBuildQryByEntriesInPeriod:SetString(5, dToS(dDtFim))
            ::oBuildQryByEntriesInPeriod:SetString(6, "SD2")
            ::oBuildQryByEntriesInPeriod:SetString(7, "1")
            ::oBuildQryByEntriesInPeriod:SetString(8, cMoedaStr)
            ::oBuildQryByEntriesInPeriod:SetString(9, cMoedaStr)
            ::oBuildQryByEntriesInPeriod:SetNumeric(10, oMovement["r_e_c_n_o_"])

            cQuery := ::oBuildQryByEntriesInPeriod:GetFixQuery()

        Else
            If oMovement["mv_m330trf"]
                If ::oBuildQryByEntriesOutPeriodSeekSD2 == Nil
                    cQuery := " SELECT AGL.R_E_C_N_O_ RECPAI, "
                    cQuery += "        AGL.FILPROC FILPROC, "
                    cQuery += "        AGL.FILIAL FILIAL, "
                    cQuery +=          ::cCoalesce + "(SD2CP.D4M_PARTE, '" + ::cOutros + "') CODPAR, "
                    cQuery +=          ::cCoalesce + "(SD2CP.D4M_MOEDA, ?) MOEDA, "
                    cQuery += "        AGL.LOCARM LOCARM, "
                    cQuery += "        AGL.CHVAGL CHVAGL, "
                    cQuery +=          ::cCoalesce + "(SD2CP.D4M_TOTAL, TRF.D2_CUSTO?) CUSTO "
                    cQuery += " FROM " + ::cAgglutTable + " AGL "
                    cQuery += " INNER JOIN " + ::cAnalyTable + " DEST "
                    cQuery += "     ON	DEST.FILPROC = AGL.FILPROC "
                    cQuery += "     AND DEST.FILIAL = AGL.FILIAL "
                    cQuery += "     AND DEST.COD = AGL.COD "
                    cQuery += "     AND DEST.LOCARM = AGL.LOCARM "
                    cQuery += "     AND DEST.CHVAGL = AGL.CHVAGL "
                    cQuery += " INNER JOIN " + ::cViewTransfer + " TRF "
                    cQuery += "     ON  TRF.RECDES = DEST.RECNO "
                    cQuery += "     AND TRF.D1_DTDIGIT >= ? "
                    cQuery += "     AND TRF.D1_DTDIGIT <= ? "
                    cQuery += " LEFT JOIN " + RetSQLName("D4M") + " SD2CP "
                    cQuery += "     ON  SD2CP.D4M_FILIAL = TRF.FILORI "
                    cQuery += "     AND SD2CP.D4M_DOC = TRF.DOCORI "
                    cQuery += "     AND SD2CP.D4M_SERIE = TRF.SERIEORI "
                    cQuery += "     AND SD2CP.D4M_ITEM = TRF.ITEMORI "
                    cQuery += "     AND SD2CP.D4M_CLIENT = TRF.CLIORI "
                    cQuery += "     AND SD2CP.D4M_LOJA = TRF.LOJAORI "
                    cQuery += "     AND SD2CP.D4M_MOEDA = ? "
                    cQuery += "     AND SD2CP.D_E_L_E_T_ = ? "
                    cQuery += " WHERE AGL.R_E_C_N_O_ = ? "

                    cQuery := ChangeQuery(cQuery)

                    ::oBuildQryByEntriesOutPeriodSeekSD2 := FWExecStatement():New(cQuery)
                EndIf
                ::oBuildQryByEntriesOutPeriodSeekSD2:SetString(1, cMoedaStr)
                ::oBuildQryByEntriesOutPeriodSeekSD2:SetUnsafe(2, cMoeda)
                ::oBuildQryByEntriesOutPeriodSeekSD2:SetString(3, dToS(dDtIni))
                ::oBuildQryByEntriesOutPeriodSeekSD2:SetString(4, dToS(dDtFim))
                ::oBuildQryByEntriesOutPeriodSeekSD2:SetString(5, cMoedaStr)
                ::oBuildQryByEntriesOutPeriodSeekSD2:SetString(6, " ")
                ::oBuildQryByEntriesOutPeriodSeekSD2:SetNumeric(7, oMovement["r_e_c_n_o_"])

                cQuery := ::oBuildQryByEntriesOutPeriodSeekSD2:GetFixQuery()
            Else
                If ::oBuildQryByEntriesOutPeriodKeepSD1 == Nil
                    cQuery := " SELECT AGL.R_E_C_N_O_ RECPAI, "
                    cQuery += "        AGL.FILPROC FILPROC, "
                    cQuery += "        AGL.FILIAL FILIAL, "
                    cQuery +=          ::cCoalesce + "(D4G.D4G_CODPAR, '" + ::cOutros + "') CODPAR, "
                    cQuery += "        ? MOEDA, "
                    cQuery += "        AGL.LOCARM LOCARM, "
                    cQuery += "        AGL.CHVAGL CHVAGL, "
                    cQuery += "        TRF.D1_CUSTO? CUSTO "
                    cQuery += " FROM " + ::cAgglutTable + " AGL "
                    cQuery += " INNER JOIN " + ::cAnalyTable + " DEST "
                    cQuery += "     ON	DEST.FILPROC = AGL.FILPROC "
                    cQuery += "     AND DEST.FILIAL = AGL.FILIAL "
                    cQuery += "     AND DEST.COD = AGL.COD "
                    cQuery += "     AND DEST.LOCARM = AGL.LOCARM "
                    cQuery += "     AND DEST.CHVAGL = AGL.CHVAGL "
                    cQuery += " INNER JOIN " + ::cViewTransfer + " TRF "
                    cQuery += "     ON  TRF.RECDES = DEST.RECNO "
                    cQuery += "     AND TRF.D1_DTDIGIT >= ? "
                    cQuery += "     AND TRF.D1_DTDIGIT <= ? "
                    cQuery += " LEFT JOIN " + RetSQLName("D4G") + " D4G "
                    cQuery += "     ON D4G.D4G_FILIAL = ? "
                    cQuery += "     AND D4G.D4G_PRODUT = TRF.CODDES "
                    cQuery += "     AND D4G.D4G_REVIS = ? "
                    cQuery += "     AND D4G.D_E_L_E_T_ = ? "
                    cQuery += " LEFT JOIN " + RetSQLName("D4F") + " D4F "
                    cQuery += "     ON  D4F.D4F_FILIAL = '" + FWXFilial("D4F") + "' "
                    cQuery += "     AND D4F.D4F_REVIS = D4G.D4G_REVIS "
                    cQuery += "     AND D4F.D4F_CODPAR = D4G.D4G_CODPAR "
                    cQuery += "     AND D4F.D4F_TIPO = ? "
                    cQuery += "     AND D4F.D_E_L_E_T_ = ? "
                    cQuery += " WHERE AGL.R_E_C_N_O_ = ? "

                    cQuery := ChangeQuery(cQuery)

                    ::oBuildQryByEntriesOutPeriodKeepSD1 := FWExecStatement():New(cQuery)
                EndIf
                ::oBuildQryByEntriesOutPeriodKeepSD1:SetString(1, cMoedaStr)
                If cMoeda == "1"
                    ::oBuildQryByEntriesOutPeriodKeepSD1:SetUnsafe(2, " ")
                Else
                    ::oBuildQryByEntriesOutPeriodKeepSD1:SetUnsafe(2, cMoeda)
                EndIf
                ::oBuildQryByEntriesOutPeriodKeepSD1:SetString(3, dToS(dDtIni))
                ::oBuildQryByEntriesOutPeriodKeepSD1:SetString(4, dToS(dDtFim))
                ::oBuildQryByEntriesOutPeriodKeepSD1:SetString(5, FWxFilial("D4G",cFilAtu))
                ::oBuildQryByEntriesOutPeriodKeepSD1:SetString(6, ::cRevisao)
                ::oBuildQryByEntriesOutPeriodKeepSD1:SetString(7, " ")
                ::oBuildQryByEntriesOutPeriodKeepSD1:SetString(8, "1")
                ::oBuildQryByEntriesOutPeriodKeepSD1:SetString(9, " ")
                ::oBuildQryByEntriesOutPeriodKeepSD1:SetNumeric(10, oMovement["r_e_c_n_o_"])

                cQuery := ::oBuildQryByEntriesOutPeriodKeepSD1:GetFixQuery()
            EndIf
        EndIf

    ElseIf oMovement["cf"] $ "PR0|PR1"
        If ::obuildQryStatementSC2 == Nil
            cQuery := " SELECT AGL.R_E_C_N_O_ RECPAI,AGL.FILPROC,AGL.FILIAL,TRMCP.PARTE CODPAR, "
            cQuery += " ? MOEDA, TRMCP.TOTFIN * ? CUSTO,AGL.LOCARM,AGL.CHVAGL "
            cQuery += " FROM "+::cAgglutTable+" AGL "
            cQuery += " INNER JOIN " + ::cAnalyTable + " ANL ON "
            cQuery += " ANL.FILPROC = AGL.FILPROC And "
            cQuery += " ANL.CHVAGL = AGL.CHVAGL "
            cQuery += " INNER JOIN " + ::cTableOPCP + " TRMCP ON "
            cQuery += " TRMCP.FILPROC = AGL.FILPROC AND "
            //If ::cCusFil != 'E'
                cQuery += " TRMCP.FILIAL  = ANL.FILIAL AND "
            //EndIf
            cQuery += " TRMCP.OP      = ANL.OP AND "
            cQuery += " TRMCP.MOEDA = ? "
            cQuery += " WHERE AGL.R_E_C_N_O_ = ? "

            cQuery := ChangeQuery(cQuery)

            ::obuildQryStatementSC2 := FWExecStatement():New(cQuery)
        EndIf

        ::obuildQryStatementSC2:SetString(1, cMoedaStr)
        ::obuildQryStatementSC2:SetNumeric(2, oTabSldOP:nProporcao)
        ::obuildQryStatementSC2:SetString(3, cMoedaStr)
        ::obuildQryStatementSC2:SetNumeric(4, oMovement["r_e_c_n_o_"])
        cQuery := ::obuildQryStatementSC2:GetFixQuery()
    Else
        If ::obuildQryStatementByValuation == Nil
            cQuery := " SELECT AGL.R_E_C_N_O_ RECPAI,AGL.FILPROC,AGL.FILIAL,AGL.QUANT, "
            cQuery += " AGL.LOCARM,AGL.CHVAGL, AGL.CUSTO? CUSTO,"
            cQuery += " COALESCE(AGLCP.CODPAR,D4G.D4G_CODPAR,'99') CODPAR, "
            cQuery += ::cCoalesce+"(AGLCP.MOEDA,?) MOEDA "
            cQuery += " FROM " + ::cAgglutTable + " AGL "
            cQuery += " LEFT JOIN " + RetSqlName("D4G") + " D4G ON "
            cQuery += " D4G.D4G_FILIAL = ? AND "
            cQuery += " D4G.D4G_REVIS = ? AND "
            cQuery += " D4G.D4G_PRODUT = AGL.COD AND "
            cQuery += " D4G.D_E_L_E_T_ = ? "
            cQuery += " LEFT JOIN " +::cAgglutTableCP+ " AGLCP ON "
            cQuery += " AGLCP.FILPROC  = AGL.FILPROC And "
            cQuery += " AGLCP.FILIAL   = AGL.FILIAL  And"
            cQuery += " AGLCP.RECPAI = AGL.R_E_C_N_O_ AND "
            cQuery += " AGLCP.MOEDA = ? "
            cQuery += " WHERE AGL.R_E_C_N_O_ = ? "

            cQuery := ChangeQuery(cQuery)

            ::obuildQryStatementByValuation := FWExecStatement():New(cQuery)
        EndIf

        ::obuildQryStatementByValuation:SetUnsafe(1, cMoeda)
        
        ::obuildQryStatementByValuation:SetString(2, cMoedaStr)
        ::obuildQryStatementByValuation:SetString(3, FWxFilial("D4G",cFilAtu))
        ::obuildQryStatementByValuation:SetString(4, ::cRevisao)
        ::obuildQryStatementByValuation:SetString(5, ' ')
        ::obuildQryStatementByValuation:SetString(6, cMoedaStr)
        ::obuildQryStatementByValuation:SetNumeric(7, oMovement["r_e_c_n_o_"])

        cQuery := ::obuildQryStatementByValuation:GetFixQuery()
    EndIf

Return cQuery

/*/{Protheus.doc} productDisassemblyQueryBuilder
    Retorna a query dos movimentos DE7 (desmontagem)
    @author Squad.Entradas
    @since 05/05/2025
    @version 1.0
    @param  nRecno, Recno do movimento
    /*/
Method productDisassemblyQueryBuilder(nRecno,cMoeda) class movementProcessParts
    local cQuery as character

    If ::obuildQryStatementDE7 == Nil
        cQuery := " SELECT AGL.R_E_C_N_O_ RECPAI,AGL.FILPROC,AGL.FILIAL,AGL.COD, "
        cQuery += " AGL.QUANT,AGL.LOCARM,TRHCP.CODPAR,TRHCP.MOEDA,AGL.CHVAGL, "
        cQuery += " (AGL.QUANT * TRHCP.CMPROC * (AGL.RATEIO/100) ) CUSTO "
        cQuery += " FROM " + ::cAgglutTable + " AGL "
        cQuery += " INNER JOIN " + ::cAnalyTable + " TRG ON "
        cQuery += " TRG.FILIAL = AGL.FILIAL "
        cQuery += " AND TRG.FILPROC = AGL.FILPROC "
        cQuery += " AND TRG.SEQ = AGL.SEQ "
        cQuery += " AND TRG.CF = ? "
        cQuery += " INNER JOIN " + ::cProcTableCP + " TRHCP ON "
        cQuery += " TRHCP.FILIAL = AGL.FILIAL "
        cQuery += " AND TRHCP.FILPROC = AGL.FILPROC "
        cQuery += " AND TRHCP.COD = TRG.COD "
        cQuery += " AND TRHCP.ARMAZEM = TRG.LOCARM "
        cQuery += " AND TRHCP.MOEDA = ? "
        cQuery += " WHERE AGL.R_E_C_N_O_ = ? "

        cQuery := ChangeQuery(cQuery)

        ::obuildQryStatementDE7 := FWExecStatement():New(cQuery)
    EndIf

    ::obuildQryStatementDE7:SetString(1, "RE7")
    ::obuildQryStatementDE7:SetString(2, cMoeda)
    ::obuildQryStatementDE7:SetNumeric(3, nRecno)

    cQuery := ::obuildQryStatementDE7:GetFixQuery()

Return cQuery

/*/{Protheus.doc} updateAverageCostInAllParts
    Atualiza o custo medio do produto em todas as partes
    @author Squad.Entradas
    @since 05/05/2025
    @version 1.0
    @param  cFilAtu, Filial atual
            cProd,   Codigo do Produto
            cLocal,  Codigo do Armazem
    /*/
Method updateAverageCostInAllParts(cFilAtu,cProd,cLocal) class movementProcessParts
    local cFieldsUpd    as character
    local cQryStatement as character
    local cMatchFilter  as character
    local cCteStatement as character
	
    If ::oBuildQryStatementUpdAllParts == Nil
        cQryStatement := " SELECT TRH.FILPROC,TRH.FILIAL,TRH.COD,TRH.ARMAZEM,TRH.QTDPROC "
        cQryStatement += " FROM "+::cProcTable+" TRH "
        cQryStatement += " WHERE TRH.FILPROC = ? AND "
        cQryStatement += " TRH.FILIAL = ? AND "
        cQryStatement += " TRH.COD = ? AND "
        cQryStatement += " TRH.ARMAZEM = ? "

        cQryStatement := ChangeQuery(cQryStatement)

        ::oBuildQryStatementUpdAllParts := FWExecStatement():New(cQryStatement)
    EndIf

    ::oBuildQryStatementUpdAllParts:SetString(1, ::cFProc)
    ::oBuildQryStatementUpdAllParts:SetString(2, cFilAtu)
    ::oBuildQryStatementUpdAllParts:SetString(3, cProd)
    ::oBuildQryStatementUpdAllParts:SetString(4, cLocal)

    cQryStatement := ::oBuildQryStatementUpdAllParts:GetFixQuery()

    cFieldsUpd := " QTDPROC = TEMPTABLE.QTDPROC, "
    cFieldsUpd += " CMPROC = CASE WHEN TEMPTABLE.QTDPROC > 0 THEN "+::cProcTableCP+".CSTPROC / TEMPTABLE.QTDPROC ELSE "+::cProcTableCP+".CMPROC END "

    cMatchFilter := ::cProcTableCP+".FILPROC = TEMPTABLE.FILPROC AND "
    cMatchFilter += ::cProcTableCP+".FILIAL = TEMPTABLE.FILIAL AND "
    cMatchFilter += ::cProcTableCP+".COD = TEMPTABLE.COD AND "
    cMatchFilter += ::cProcTableCP+".ARMAZEM = TEMPTABLE.ARMAZEM "

    cCteStatement := ::buildCteStatement(::cProcTableCP, cFieldsUpd, cMatchFilter, cQryStatement)
    ::RunQuery(cCteStatement)

Return

/*/{Protheus.doc} thirdPartiesQueryBuilder
    Atualiza o custo das devolucoes de/em terceiros
    @author Squad.Entradas
    @since 12/05/2025
    @version 1.0
    @param  cAlias, Tabela do movimento (SD1/SD2)
            nRecno, Recno do movimento na tabela de movimentacao aglutinada
            cMoeda, Moeda que esta sendo processada
    /*/
Method thirdPartiesQueryBuilder(cAlias,nRecno,cMoeda) class movementProcessParts
    local cQuery as character
    local nMoeda := Val(cMoeda)
    
    If cAlias == "SD1"
        If ::oBuildQryStatementTrdPartiesSD1 == Nil
            cQuery := " SELECT AGL.R_E_C_N_O_ RECPAI,AGL.FILPROC,AGL.FILIAL,AGL.QUANT,AGL.LOCARM, AGL.CHVAGL,"
            cQuery += " CASE WHEN D4M.D4M_TOTAL IS NULL THEN SD1.D1_CUSTO? "
            cQuery += " ELSE CASE WHEN AGL.QUANT = SB6.B6_QUANT THEN D4M.D4M_TOTAL "
            cQuery += " ELSE ( D4M.D4M_TOTAL / SB6.B6_QUANT ) * AGL.QUANT END "
            cQuery += " END CUSTO, "
            cQuery += ::cCoalesce+"(D4M.D4M_PARTE,'99') CODPAR,"
            cQuery += ::cCoalesce+"(D4M.D4M_MOEDA,?) MOEDA "
            cQuery += " FROM " + ::cAgglutTable + " AGL "
            cQuery += " INNER JOIN "+RetSqlName("SD1")+" SD1 ON "
            cQuery += " SD1.R_E_C_N_O_ = AGL.RECNO AND "
            cQuery += " SD1.D_E_L_E_T_ = ? "
            cQuery += " INNER JOIN "+RetSqlName("SB6")+" SB6 ON "
            cQuery += " SB6.B6_FILIAL = AGL.FILIAL AND "
            cQuery += " SB6.B6_IDENT = AGL.IDENTB6 AND "
            cQuery += " SB6.B6_PRODUTO = AGL.COD AND "
            cQuery += " SB6.B6_PODER3 = ? AND "
            cQuery += " SB6.D_E_L_E_T_ = ? "
            cQuery += " LEFT JOIN "+RetSqlName("D4M")+" D4M ON "
            cQuery += " D4M.D4M_FILIAL = SB6.B6_FILIAL AND "
            cQuery += " D4M.D4M_DOC = SB6.B6_DOC AND "
            cQuery += " D4M.D4M_SERIE = SB6.B6_SERIE AND "
            cQuery += " D4M.D4M_CLIENT = SB6.B6_CLIFOR AND "
            cQuery += " D4M.D4M_LOJA = SB6.B6_LOJA AND "
            cQuery += " D4M.D4M_ITEM = SD1.D1_ITEMORI AND "
            cQuery += " D4M.D4M_MOEDA = ? AND "
            cQuery += " D4M.D_E_L_E_T_ = ? "
            cQuery += " WHERE AGL.R_E_C_N_O_ = ? "

            cQuery := ChangeQuery(cQuery)

            ::oBuildQryStatementTrdPartiesSD1 := FWExecStatement():New(cQuery)
        EndIf

        If nMoeda > 1
            ::oBuildQryStatementTrdPartiesSD1:SetNumeric(1, nMoeda )
        Else
            ::oBuildQryStatementTrdPartiesSD1:SetUnsafe(1, ' ' )
        EndIf
        ::oBuildQryStatementTrdPartiesSD1:SetString(2, cMoeda )
        ::oBuildQryStatementTrdPartiesSD1:SetString(3, ' ' )
        ::oBuildQryStatementTrdPartiesSD1:SetString(4, 'R' )
        ::oBuildQryStatementTrdPartiesSD1:SetString(5, ' ' )
        ::oBuildQryStatementTrdPartiesSD1:SetString(6, cMoeda )
        ::oBuildQryStatementTrdPartiesSD1:SetString(7, ' ' )
        ::oBuildQryStatementTrdPartiesSD1:SetNumeric(8, nRecno )

        cQuery := ::oBuildQryStatementTrdPartiesSD1:GetFixQuery()
    Else
        If ::oBuildQryStatementTrdPartiesSD2 == Nil
            cQuery := " SELECT AGL.R_E_C_N_O_ RECPAI,AGL.FILPROC,AGL.FILIAL,AGL.QUANT,AGL.LOCARM, AGL.CHVAGL, "
            cQuery += " CASE WHEN D4L.D4L_TOTAL IS NULL THEN SD2.D2_CUSTO? "
            cQuery += " ELSE CASE WHEN AGL.QUANT = SB6.B6_QUANT THEN D4L.D4L_TOTAL "
            cQuery += " ELSE ( D4L.D4L_TOTAL / SB6.B6_QUANT ) * AGL.QUANT END "
            cQuery += " END CUSTO, "
            cQuery += ::cCoalesce+"(D4L.D4L_PARTE,'99') CODPAR, "
            cQuery += ::cCoalesce+"(D4L.D4L_MOEDA,?) MOEDA "
            cQuery += " FROM " + ::cAgglutTable + " AGL "
            cQuery += " INNER JOIN "+RetSqlName("SD2")+" SD2 ON "
            cQuery += " SD2.R_E_C_N_O_ = AGL.RECNO AND "
            cQuery += " SD2.D_E_L_E_T_ = ? "
            cQuery += " INNER JOIN "+RetSqlName("SB6")+" SB6 ON "
            cQuery += " SB6.B6_FILIAL = AGL.FILIAL AND "
            cQuery += " SB6.B6_IDENT = AGL.IDENTB6 AND "
            cQuery += " SB6.B6_PRODUTO = AGL.COD AND "
            cQuery += " SB6.B6_PODER3 = ? "
            cQuery += " LEFT JOIN "+RetSqlName("D4L")+" D4L ON "
            cQuery += " D4L.D4L_FILIAL = SB6.B6_FILIAL AND "
            cQuery += " D4L.D4L_DOC = SB6.B6_DOC AND "
            cQuery += " D4L.D4L_SERIE = SB6.B6_SERIE AND "
            cQuery += " D4L.D4L_FORNEC = SB6.B6_CLIFOR AND "
            cQuery += " D4L.D4L_LOJA = SB6.B6_LOJA AND "
            cQuery += " D4L.D4L_ITEM = SD2.D2_ITEMORI AND "
            cQuery += " D4L.D4L_MOEDA = ? AND "
            cQuery += " D4L.D_E_L_E_T_ = ? "
            cQuery += " WHERE AGL.R_E_C_N_O_ = ? "

            cQuery := ChangeQuery(cQuery)

            ::oBuildQryStatementTrdPartiesSD2 := FWExecStatement():New(cQuery)
        EndIf

        ::oBuildQryStatementTrdPartiesSD2:SetNumeric(1, nMoeda )
        ::oBuildQryStatementTrdPartiesSD2:SetString(2, cMoeda )
        ::oBuildQryStatementTrdPartiesSD2:SetString(3, ' ' )
        ::oBuildQryStatementTrdPartiesSD2:SetString(4, 'R' )
        ::oBuildQryStatementTrdPartiesSD2:SetString(5, cMoeda )
        ::oBuildQryStatementTrdPartiesSD2:SetString(6, ' ' )
        ::oBuildQryStatementTrdPartiesSD2:SetNumeric(7, nRecno )

        cQuery := ::oBuildQryStatementTrdPartiesSD2:GetFixQuery()
    EndIf

Return cQuery

/*/{Protheus.doc} existsMovementInPeriod
    Retorna se o movimento interno existe no período de processamento
    @author Squad.Entradas
    @since 01/06/2025
    @version 1.0
    /*/
Method existsMovementInPeriod(nRecno,cFilAtu,dDtIni,dDtFim,lProducao) class movementProcessParts
    local cQuery as character
    local cAlias as character
    local lRet   as logical

    //Reinicializa o recno
    nRecno := 0

    If ::oExistsMovementInPeriod == Nil
        cQuery := " SELECT SD3.R_E_C_N_O_ RECNO, SD3.D3_EMISSAO EMISSAO "
        cQuery += " FROM "+RetSQLName("SD3")+" SD3 "
        cQuery += " WHERE SD3.D3_FILIAL = ? "
        cQuery += " AND SD3.D3_NUMSEQ = ? "
        cQuery += " AND SD3.D3_CF IN (?) "
        cQuery += " AND SD3.D3_ESTORNO = ? "
        cQuery += " AND SD3.D_E_L_E_T_ = ? "

        cQuery := ChangeQuery(cQuery)

        ::oExistsMovementInPeriod := FWExecStatement():New(cQuery)
    EndIf

    ::oExistsMovementInPeriod:SetString(1, cFilAtu )
    ::oExistsMovementInPeriod:SetString(2, (::cAgglutTable)->IDENT )
    If lProducao
        ::oExistsMovementInPeriod:SetIn(3, {"PR0","PR1"} )
    Else
        ::oExistsMovementInPeriod:SetIn(3, {'RE4','DE7'})
    EndIf
    ::oExistsMovementInPeriod:SetString(4, ' ' )
    ::oExistsMovementInPeriod:SetString(5, ' ' )

    cAlias := ::oExistsMovementInPeriod:OpenAlias()

    If (cAlias)->(!Eof())
        nRecno := (cAlias)->(RECNO)
        If (cAlias)->(EMISSAO) >= DtoS(dDtIni) .And. (cAlias)->(EMISSAO) <= DtoS(dDtFim)
            lRet   := .T.
        EndIf
    EndIf

    (cAlias)->(DbCloseArea())

Return lRet


/*/{Protheus.doc} balanceUpdaterByEntryCP
    Atualiza os saldos finais do apontamento da produçao
    @author Squad Entradas
    @since 30/10/2024
/*/
Method balanceUpdaterByEntryCP(cFilAtu,cOP,nRecno) Class movementProcessParts
    local cQuery       as character
    local cMatchFilter as character
    local cFieldsUpd   as character

    cMatchFilter := ::cTableOPCP+".RECPAI = TEMPTABLE.RECNO AND "
    cMatchFilter += ::cTableOPCP+".PARTE = TEMPTABLE.CODPAR AND "
    cMatchFilter += ::cTableOPCP+".MOEDA = TEMPTABLE.MOEDA "

    cFieldsUpd := " TOTFIN = TOTFIN - TEMPTABLE.CUSTO, "
    cFieldsUpd += " APRFIN = APRFIN + TEMPTABLE.CUSTO "

    If ::oQueryBalanceUpdate == Nil
        cQuery := " SELECT TRMCP.RECPAI RECNO,TRLCP.FILPROC,TRLCP.FILIAL,TRLCP.CODPAR,TRLCP.MOEDA,TRLCP.CUSTO "
        cQuery += " FROM "+::cAgglutTable+" TRL "
        cQuery += " INNER JOIN "+::cAgglutTableCP+" TRLCP ON "
        cQuery += " TRLCP.RECPAI = TRL.R_E_C_N_O_ "
        cQuery += " INNER JOIN "+::cTableOPCP+" TRMCP ON "
        cQuery += " TRMCP.FILIAL = TRL.FILIAL AND "
        cQuery += " TRMCP.FILPROC = TRL.FILPROC AND "
        cQuery += " TRMCP.OP = TRL.OP AND "
        cQuery += " TRMCP.PARTE = TRLCP.CODPAR AND "
        cQuery += " TRMCP.MOEDA = TRLCP.MOEDA"
        cQuery += " WHERE TRL.FILIAL = ? "
        cQuery += " AND TRL.FILPROC = ? "
        cQuery += " AND TRL.R_E_C_N_O_ = ? "

        ::oQueryBalanceUpdate := FWExecStatement():New(cQuery)
    EndIf

    ::oQueryBalanceUpdate:SetString(1,cFilAtu)
    ::oQueryBalanceUpdate:SetString(2,::cFProc)
    ::oQueryBalanceUpdate:SetNumeric(3,nRecno)

    cQuery := ::oQueryBalanceUpdate:GetFixQuery()

    cQuery := ::buildCteStatement(::cTableOPCP, cFieldsUpd, cMatchFilter, cQuery)

    ::RunQuery(cQuery)

Return
