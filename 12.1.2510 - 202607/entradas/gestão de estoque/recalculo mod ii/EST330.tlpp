#include 'tlpp-core.th'
#Include 'Totvs.ch'
#Include 'RWMake.ch'
#Include 'EST330.ch'

using namespace totvs.protheus.backoffice.stock.iterativecost.processing.mainprogram


/*/{Protheus.doc} EST330Main
    Chamada de Menu da classe principal
    @type  Function
    @author Squad Entradas
    @since 18/11/2024
    /*/
Function EST330Main()
    Local oProcess As Object
    Local bProcess As CodeBlock
    Local cDesc    As Character
    Local cTitle   As Character
    Local lExecute  := FnVldCMod2()

    If !lExecute
        Help('',1,'MOD 2',,'Recálculo do Custo Médio Modelo II não disponível',1,0)
        Return
    EndIf

    bProcess := {|oProc| E330Begin(oProc)}
    cTitle   := I18N(STR0001, {"2"}) //"Recálculo do Custo Médio Modelo II"
    cDesc    := STR0002 //"Esta funcionalidade permite calcular o custo médio dos produtos em estoque com maior precisão em alguns cenários, principalmente os que envolvem recursividade entre as movimentações do produto. "
    cDesc    += CRLF
    cDesc    += STR0003 //"A quantidade de iterações e ordem de processamentos das filiais selecionadas deve ser realizada através da rotina Roteiros de Cálculo (EST330A)."
    cDesc    += CRLF
    cDesc    += STR0004 //"Configurações de 'Perguntas': As opções ajustadas nesta seção serão aplicadas automaticamente durante o cálculo."
    cDesc    += CRLF
    cDesc    += CRLF
    cDesc    += STR0005+DToC(SuperGetMv("MV_ULMES",.F.,SToD("19961231"))+1) //"Data Inicial de processamento: "   

    oProcess := tNewProcess():New("EST330Main"                     ,;
                              cTitle,;
                              bProcess/*bProcess*/     ,;
                              cDesc/*cDescription*/ ,;
                              'EST330'/*cPerg*/,;
                              {},;
                              .F.                               /*lPanelAux*/    ,;
                              0                                 /*nSizePanelAux*/,;
                              ""    /*cDescriAux*/   ,;
                              .T.                               /*lViewExecute*/ ,;
                              .F.                               /*lOneMeter*/    ,;
                              .F.                               /*lSchedAuto*/) 
Return


/*/{Protheus.doc} E330Begin
    Instancia a classe principal
    @type  Static Function
    @author Squad Entradas
    @since 18/11/2024
/*/
Static Function E330Begin(oProc)
    Local oItCost  As Object
    Local lRet     As Logical

    lRet := .T.

    oItCost := IterativeCostMain():New(oProc)
    oItCost:GetParamSX1()
    oItCost:GetParamSX6()
    lRet := oItCost:Run()
Return lRet
