#Include 'Totvs.ch'
#include 'tlpp-core.th'

Using namespace totvs.protheus.backoffice.stock.iterativecost.table.manager
Using Namespace totvs.protheus.backoffice.stock.iterativecost.table.processingtable
using namespace totvs.protheus.backoffice.stock.iterativecost.table.analyticalmovementtable
using namespace totvs.protheus.backoffice.stock.iterativecost.table.aglutinattedmovementtable
Using namespace totvs.protheus.backoffice.stock.iterativecost.table.balancebyproductionorder
using namespace totvs.protheus.backoffice.stock.iterativecost.table.productstructleveltable
Using namespace totvs.protheus.backoffice.stock.iterativecost.view.acquisitioncost
Using Namespace totvs.protheus.backoffice.stock.iterativecost.view.transferinvoice
Using Namespace totvs.protheus.backoffice.stock.iterativecost.view.acquisitioncost
Using Namespace totvs.protheus.backoffice.stock.iterativecost.processing.requestcost
Using Namespace totvs.protheus.backoffice.stock.iterativecost.table.parts.agglutinatedMovementPartsTable
Using Namespace totvs.protheus.backoffice.stock.iterativecost.table.parts.analyticalmovementtable
Using Namespace totvs.protheus.backoffice.stock.iterativecost.table.parts.processingtable

namespace totvs.protheus.backoffice.stock.iterativecost.processing.parts.requestcost

/*/{Protheus.doc} PartsRequestCost
    Classe responsável pela tabela que registra o custo em partes dos movimentos de requisição das transferências internas, entre filiais, desmontagem e liberação de CQ.

    @type Class
    @author Squad Entradas
    @since 12/08/2025
/*/
Class PartsRequestCost From TableManager

    public method New() 

    Public Method ProductionPartsRequestCost()

    Public Data cTabAnl As Character
    Public Data cTabAgl As Character
    Public Data cTabPro As Character
    Public Data cTabOp  As Character
    Public Data cTabNiv As Character
    Public Data cTabAnlCP As Character
    Public Data cTabAglCP As Character
    Public Data cTabProCP As Character

    Public Data jVwAcquistCstParams       As Json
    Public Data cViewAcquisCst            As Character
    Public Data cCusFil                   As Character
    Public Data jParams                   As Json
    Public Data cFProc                    As Character

    Private Data oQryPR0Req As Object

endclass

/*/{Protheus.doc} New
    Instância da classe

    @type method
    @author Squad Entradas
    @since 12/08/2025
/*/
Method New(cFilProc, aFil, jParams) Class PartsRequestCost

    ::cCusFil   := jParams["MV_CUSFIL"]
    ::jParams   := jParams
    ::cTabAnl   := AnalyticalMovementTable():TableName()
    ::cTabAgl   := AgglutinatedMovementTable():TableName()
    ::cTabPro   := ProcessingTable():TableName()
    ::cTabOp    := BalanceByProductionOrder():TableName()
    ::cTabNiv   := ProductStructLevelTable():TableName()
    ::cTabAnlCP := AnalyticalMovementPartsTable():TableName()
    ::cTabAglCP := AgglutinatedMovementPartsTable():TableName()
    ::cTabProCP := PartsProcessingTable():TableName()
    ::cFProc    := cFilProc

    _Super:New(aFil)
Return


/*/{Protheus.doc} ProductionPartsRequestCost
    Atualiza o custo dos movimentos requisitados para a OP
    @author Squad Entradas
    @since 12/08/2025
    @type method
    /*/
Method ProductionPartsRequestCost(cFilAtu, cNivInv) Class PartsRequestCost
    Local cQuery    as character
    Local aMatch    := {} as array
    Local aUpdate   := {} as array
    Local aInsert   := {} as array
    Local aCpoDest  := {} as array
    Local nBind           as integer
    Local cOutro          as character
    Local cMoeda          as character
    Local cMoedaIns       as character
    Local nI              as integer
    
    If ::oQryPR0Req == Nil
        cOutro := Replicate('9', TamSX3('D4G_CODPAR')[1])
        cQuery := " Select "
        cQuery += " ANL.FILPROC     FILPROC, "
        cQuery += " ANL.FILIAL      FILIAL, "
        cQuery += " ANL.R_E_C_N_O_  RECPAI, "
        cQuery += " Coalesce(PROCP.CODPAR, '"+cOutro+"') CODPAR, "
        cQuery += " Coalesce(PROCP.MOEDA, ?)              MOEDA, "
        cQuery += " Case "
        cQuery += "    When ANL.CUSTOMEDIO = 'S' Then "
        cQuery += "         ANL.QUANT * Coalesce(PROCP.CMPROC, 0) "
        cQuery += "    Else Coalesce(ANLCP.CUSTO, 0) "
        cQuery += " End CSTRECP, "
        cQuery += " ANLCP.R_E_C_N_O_ MOVREC "
        cQuery += " From "+::cTabNiv+" NIV "
        cQuery += " Inner Join "+::cTabOp+" SLDOP On "
        cQuery += " SLDOP.FILPROC = NIV.FILPROC AND "
        If ::cCusFil != 'E'
            cQuery += " SLDOP.FILIAL  = NIV.FILIAL  AND "
        EndIf
        cQuery += " SLDOP.COD     = NIV.COD "
        cQuery += " Inner Join "+::cTabAnl+" ANL On "
        cQuery += " ANL.FILPROC = SLDOP.FILPROC AND "
        If ::cCusFil != 'E'
            cQuery += " ANL.FILIAL  = SLDOP.FILIAL  AND "
        EndIf
        cQuery += " ANL.OP      = SLDOP.OP And "
        cQuery += " ANL.CF Not In ('PR0','PR1') "
        cQuery += " Left Join "+::cTabPro+" PRO On "      
        cQuery +=     "    PRO.FILPROC = ANL.FILPROC "
        If ::cCusFil != 'E'
            cQuery +=     "AND PRO.FILIAL  = ANL.FILIAL "
        EndIf
        cQuery +=     "AND PRO.COD     = ANL.COD "
        If ::cCusFil == 'A'
            cQuery +=     "AND PRO.ARMAZEM = ANL.LOCARM "
        EndIf
        cQuery += " Left Join "+::cTabProCP+" PROCP On "      
        cQuery +=     "    PROCP.FILPROC = ANL.FILPROC "
        If ::cCusFil != 'E'
            cQuery +=     "AND PROCP.FILIAL  = ANL.FILIAL "
        EndIf
        cQuery +=     "AND PROCP.COD     = ANL.COD "
        If ::cCusFil == 'A'
            cQuery +=     "AND PROCP.ARMAZEM = ANL.LOCARM "
        EndIf
        cQuery += " Left Join "+::cTabAnlCP+" ANLCP On "
        cQuery += "      ANLCP.RECPAI = ANL.R_E_C_N_O_ "
        cQuery += " And (ANLCP.CODPAR = PROCP.CODPAR Or PROCP.CODPAR is Null)  "
        cQuery += " And (ANLCP.MOEDA  = PROCP.MOEDA  Or PROCP.MOEDA  is Null) "
        cQuery += " Where "
        cQuery += " NIV.FILPROC = ? And "
        cQuery += " NIV.FILIAL  = ? And "
        cQuery += " NIV.NIVINV  = ? And "
        cQuery += " (PROCP.MOEDA = ? Or PROCP.MOEDA is Null)"
        cQuery += " Group By "
        cQuery += " ANLCP.R_E_C_N_O_, "
        cQuery += " ANLCP.CODPAR, "
        cQuery += " ANLCP.MOEDA, "
        cQuery += " ANLCP.CUSTO, "
        cQuery += " PROCP.CMPROC, "
        cQuery += " ANL.QUANT, "
        cQuery += " ANL.CUSTOMEDIO, "
        cQuery += " ANL.R_E_C_N_O_, "
        cQuery += " ANL.FILPROC, "
        cQuery += " ANL.FILIAL, "
        cQuery += " PROCP.CODPAR, "
        cQuery += " PROCP.MOEDA  "

        ::oQryPR0Req := FWExecStatement():New(cQuery)
    EndIf

    For nI := 1 To Len(::jParams["moedas"])
        cMoeda := ::jParams["moedas"][nI]
        cMoedaIns := StrZero(Val(cMoeda), 2)

    	nBind := 1
        ::oQryPR0Req:SetString(nBind++, cMoedaIns) //Coalesce(PROCP.MOEDA, ?)
	    ::oQryPR0Req:SetString(nBind++, ::cFProc) //NIV.FILPROC
	    If ::cCusFil == 'E'
	        ::oQryPR0Req:SetString(nBind++, PadR(FWCompany(), FWSizeFilial()))
	    Else
	        ::oQryPR0Req:SetString(nBind++, cFilAtu) //NIV.FILIAL
	    EndIf
	    ::oQryPR0Req:SetString(nBind++, cNivInv) //NIV.NIVINV
        ::oQryPR0Req:SetString(nBind++, cMoedaIns) //PROCP.MOEDA

	    cQuery := ::oQryPR0Req:GetFixQuery()
	
	    //Filtro
	    ASize(aMatch, 0)
	    aMatch := {}
	    AAdd(aMatch, {"MOVREC", "R_E_C_N_O_"})
	    
	    //Expressões de update
	    ASize(aUpdate, 0)
	    aUpdate := {}
	    AAdd(aUpdate, "CSTRECP = Origem.CSTRECP")
	        
	    //Expressões de insert
	    ASize(aCpoDest, 0)
	    aCpoDest := {}
	    AAdd(aCpoDest, "FILPROC")
	    AAdd(aCpoDest, "FILIAL")
	    AAdd(aCpoDest, "RECPAI")
	    AAdd(aCpoDest, "CODPAR")
	    AAdd(aCpoDest, "MOEDA")
	    AAdd(aCpoDest, "CSTRECP")
	    
	    ASize(aInsert, 0)
	    aInsert := {}
	    AAdd(aInsert, "Origem.FILPROC")
	    AAdd(aInsert, "Origem.FILIAL")
	    AAdd(aInsert, "Origem.RECPAI")
	    AAdd(aInsert, "Origem.CODPAR")
	    AAdd(aInsert, "Origem.MOEDA")
	    AAdd(aInsert, "Origem.CSTRECP")
	        
	    cMerge := ::MergeStatement(::cTabAnlCP, cQuery, aMatch, aUpdate, aCpoDest, aInsert)

    	::RunQuery(cMerge)
    Next
Return 
