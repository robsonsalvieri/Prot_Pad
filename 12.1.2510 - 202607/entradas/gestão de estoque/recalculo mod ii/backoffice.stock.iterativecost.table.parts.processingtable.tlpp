#Include 'Totvs.ch'
#Include 'tlpp-core.th'

Using Namespace totvs.protheus.backoffice.stock.iterativecost.table.manager
Using Namespace totvs.protheus.backoffice.stock.iterativecost.view.parts.initialstockbalance
Using Namespace totvs.protheus.backoffice.stock.iterativecost.view.laborproduct
Using Namespace totvs.protheus.backoffice.stock.iterativecost.view.parts.acquisitioncost
Using Namespace totvs.protheus.backoffice.stock.iterativecost.view.acquisitioncost
Using Namespace totvs.protheus.backoffice.stock.iterativecost.table.processingtable

namespace totvs.protheus.backoffice.stock.iterativecost.table.parts.processingtable

/*/{Protheus.doc} PartsProcessingTable
    Classe responsável por retornar a estrutura da tabela de processamento (TRH)
    @author Squad Entradas
    @since 28/03/2025
/*/
Class PartsProcessingTable From TableManager

    public method New() 

    static method CamposProc()
    static method IndicesProc()
    static method TableName()
    Public Method TableManager()
    Public Method InitialStockPartsBalance()
    Public Method AcquisitionPartsCost()
    Public Method updateAverageCostInAllParts()
    Public Method RetrieveProcessingTable()

    Public data   cCusFil         As Character
    Public Data   cViewPartInit   As Character
    Public Data   cViewSB1MOD     As Character
    Public Data   cViewPartAcq    As Character
    Public Data   jVwAcqCstParams As Json
    Public Data   jParams         As Json
    Public Data   oQryInitBal     As Object
    Public Data   oQryAcqCost     As Object
    Public Data   oRecProcess     As Object
    Public Data   oBuildQryStatementUpdAllParts As Object
    Public Data   cProcTable     As Character

endclass

/*/{Protheus.doc} New
    Instância da classe
    @author Squad Entradas
    @since 28/03/2025
/*/
Method New(aFil, jParams) Class PartsProcessingTable

    ::cCusFil    := SuperGetMv("MV_CUSFIL", .F., "A")
    ::jVwAcqCstParams := JsonObject():New()
    ::jParams    := jParams

    If D4D->(DbSeek(FWXFilial('D4D')+ViewPartsInitialStockBalance():GetViewID()))
        ::cViewPartInit := D4D->D4D_VWNAME
    EndIf
    If D4D->(DbSeek(FWXFilial('D4D')+ViewLaborProduct():GetViewID()))
        ::cViewSB1MOD := D4D->D4D_VWNAME
    EndIf
    If D4D->(DbSeek(FWXFilial('D4D')+ViewPartsAcquisitionCost():GetViewID()))
        ::cViewPartAcq := D4D->D4D_VWNAME
    EndIf
    If D4D->(DbSeek(FWXFilial('D4D')+ViewAcquisitionCost():GetViewID()))
        ::jVwAcqCstParams:FromJson(D4D->D4D_PARAM)
    EndIf

    ::cProcTable := ProcessingTable():TableName()

    If ::cCusFil == 'E'
        _Super:New(aFil, 'E', 'C', 'C' )
    Else
        _Super:New(aFil, 'E', 'E', 'E')
    EndIf

Return

Method TableManager() Class PartsProcessingTable
    _Super:TableManager(::TableName(),::CamposProc(),::IndicesProc())
Return

/*/{Protheus.doc} CamposProc
    Campos da tabela de processamento
    @author Squad Entradas
    @since 28/03/2025
/*/
Method CamposProc() Class PartsProcessingTable
    Local aFields   := {} as array
    Local nTamQFIM  := TamSX3('B2_QFIM')[1]   as numeric
    Local nDecQFIM  := TamSX3('B2_QFIM')[2]   as numeric
    Local nTamVFIM  := TamSX3('B2_VFIM1')[1]  as numeric
    Local nDecVFIM  := TamSX3('B2_VFIM1')[2]  as numeric
    Local nTamCMFIM := TamSX3('B2_CMFIM1')[1] as numeric
    Local nDecCMFIM := TamSX3('B2_CMFIM1')[2] as numeric

    aAdd(aFields, {"FILPROC",   "C" , TamSX3('B2_FILIAL')[1] , 0})
    aAdd(aFields, {"FILIAL",    "C" , TamSX3('B2_FILIAL')[1] , 0})
    aAdd(aFields, {"ITERACAO",  "N" , TamSX3('D4E_NUMITE')[1], 0})
    aAdd(aFields, {"COD",       "C" , TamSX3('B2_COD')[1]    , 0})
    aAdd(aFields, {"ARMAZEM",   "C" , TamSX3('B2_LOCAL')[1]  , 0})
    aAdd(aFields, {"CODPAR",    "C" , TamSX3('D4G_CODPAR')[1], 0})
    aAdd(aFields, {"MOEDA",     "C" , TamSX3('D4I_MOEDA')[1], 0})
    aAdd(aFields, {"QTDHIST",   "N" , nTamQFIM,  nDecQFIM})
    aAdd(aFields, {"QTDPROC",   "N" , nTamQFIM,  nDecQFIM})
    aAdd(aFields, {"CSTHIST",   "N" , nTamVFIM,  nDecVFIM})
    aAdd(aFields, {"CSTPROC",   "N" , nTamVFIM,  nDecVFIM})
    aAdd(aFields, {"CMHIST",    "N" , nTamCMFIM, nDecCMFIM})
    aAdd(aFields, {"CMPROC",    "N" , nTamCMFIM, nDecCMFIM})
    
Return aFields

/*/{Protheus.doc} IndicesProc
    Índices da tabela de processamento
    @author Squad Entradas
    @since 28/03/2025
/*/
Method IndicesProc() Class PartsProcessingTable
    Local aIndex := {} as array

    aAdd(aIndex, {PartsProcessingTable():TableName()+'_01', 'FILPROC+FILIAL+COD+ARMAZEM+CODPAR+MOEDA'})
    aAdd(aIndex, {PartsProcessingTable():TableName()+'_02', 'FILPROC+COD'})

Return aIndex

/*/{Protheus.doc} TableName
    Retorna o nome da tabela de processamento
    @author Squad Entradas
    @since 28/03/2025
/*/
Method TableName() Class PartsProcessingTable
    Local cAlias as character

    cAlias := "TRHCP"+cEmpAnt+"SP"

Return cAlias

/*/{Protheus.doc} InitialStockPartsBalance
    Inicializa o saldo de quantidade e custo do produto a cada iteração
    @author Squad Entradas
    @since 29/03/2025
    /*/
Method InitialStockPartsBalance(cFilProc) Class PartsProcessingTable
    Local cQuery  As Character
    Local nBind   As Integer
    Local nMoeda  As Integer
    Local cMoeda  As Character
    Local cMerge  As Character
    Local aMatch := {}  As Array 
    Local aUpdate := {} As Array
    Local cUpdate As Character
    Local aCpoDest := {} As Array
    Local aInsert := {} As Array
    Local cInsert As Character
    Local cFilAtu As Character
    Local nFil    As Integer

    For nFil := 1 To Len(::aFilProc)
        cFilAtu := ::aFilProc[nFil, 1]

        For nMoeda := 1 To Len(::jParams["moedas"])
            cMoeda := ::jParams["moedas", nMoeda]
            If ::oQryInitBal == Nil
                cQuery := " Select "
                cQuery += " '"+cFilProc+"' FILPROC, "
                If ::jParams["MV_CUSFIL"] != "E"
                    cQuery += "SB9.B9_FILIAL FILIAL, "
                Else
                    If ::lPostgres
                        cQuery += " Char("+cValToChar(FWSizeFilial())+") "
                    EndIf
                    cQuery += " '"+PadR(FWCompany(), FWSizeFilial())+"' FILIAL, "
                EndIf
                cQuery +=   "SB9.B9_COD COD, "
                If ::jParams["MV_CUSFIL"] == "A"
                    cQuery += "SB9.B9_LOCAL ARMAZEM, "
                EndIf
                cQuery +=   "D4I_PARTE CODPAR, "
                cQuery +=   "Cast(? As Char(2)) MOEDA, "
                cQuery +=   "SUM(SB9.B9_QINI) QTDHIST, "
                cQuery +=   "SUM(SB9.B9_QINI) QTDPROC, "
                cQuery +=   "SUM(Coalesce(SB9.D4I_TOTAL, SB9.B9_VINI?)) CSTHIST, "
                cQuery +=   "SUM(Coalesce(SB9.D4I_TOTAL, SB9.B9_VINI?)) CSTPROC, "
                //Custo histórico
                cQuery +=   "AVG(Coalesce(SB9.D4I_UNITAR, SB9.B9_CM?)) CMHIST, "
                cQuery +=   "AVG(Coalesce(SB9.D4I_UNITAR, SB9.B9_CM?)) CMPROC "
                cQuery += " FROM " + ::cViewPartInit + " SB9 "
                cQuery += " Left Outer Join "+::cViewSB1MOD+" SB1 "
                cQuery += " On "
                If  FWModeAccess("SB1", 1) == FWModeAccess("SB9", 1) .And. ;
                    FWModeAccess("SB1", 2) == FWModeAccess("SB9", 2) .And. ;
                    FWModeAccess("SB1", 3) == FWModeAccess("SB9", 3)
                    cQuery += " SB1.B1_FILIAL = SB9.B9_FILIAL And "
                Else
                    cQuery += " SB1.B1_FILIAL = ? And "
                EndIf
                cQuery += " SB1.B1_COD = SB9.B9_COD "
                cQuery += " Where "
                cQuery += " SB9.B9_FILIAL  = ? And "
                cQuery += " (SB9.D4I_MOEDA  = ? Or SB9.D4I_MOEDA  Is Null) "
                cQuery += " And SB1.B1_CCCUSTO Is Null " //Ignora produtos MOD
                cQuery += "GROUP BY "
                If ::jParams["MV_CUSFIL"] != "E"
                    cQuery += "SB9.B9_FILIAL, "
                EndIf
                cQuery += "SB9.B9_COD"
                If ::jParams["MV_CUSFIL"] == "A"
                    cQuery += ", SB9.B9_LOCAL"
                EndIf
                cQuery += ",D4I_PARTE"
                //cQuery += "D4I_MOEDA"
                ::oQryInitBal := FWExecStatement():New(cQuery)
            EndIf

            nBind := 1
            ::oQryInitBal:SetString(nBind++, StrZero(Val(cMoeda),2)) //MOEDA
            ::oQryInitBal:SetUnsafe(nBind++, cMoeda) //CSTHIST
            ::oQryInitBal:SetUnsafe(nBind++, cMoeda) //CSTPROC
            ::oQryInitBal:SetUnsafe(nBind++, cMoeda) //CMHIST
            ::oQryInitBal:SetUnsafe(nBind++, cMoeda) //CMPROC
            If  FWModeAccess("SB1", 1) != FWModeAccess("SB9", 1) .Or. ;
                FWModeAccess("SB1", 2) != FWModeAccess("SB9", 2) .Or. ;
                FWModeAccess("SB1", 3) != FWModeAccess("SB9", 3)
                ::oQryInitBal:SetString(nBind++, FWXFilial('SB1', cFilAtu)) //B1_FILIAL
            EndIf
            ::oQryInitBal:SetString(nBind++, FWXFilial('SB9', cFilAtu)) //B9_FILIAL
            ::oQryInitBal:SetString(nBind++, StrZero(Val(cMoeda),2)) //D4I_MOEDA

            cQuery := ::oQryInitBal:GetFixQuery()

            //Filtro
            ASize(aMatch, 0)
            aMatch := {}
            AAdd(aMatch, {"FILPROC", "'"+cFilProc+"'"})
            AAdd(aMatch, {"FILIAL", "FILIAL"})
            AAdd(aMatch, {"COD", "COD"})
            If ::jParams["MV_CUSFIL"] == "A"
                AAdd(aMatch, {"ARMAZEM", "ARMAZEM"})
            EndIf
            AAdd(aMatch, {"CODPAR", "CODPAR"})
            AAdd(aMatch, {"MOEDA", "MOEDA"})

            //Expressões de update
            ASize(aUpdate, 0)
            aUpdate := {}
            AAdd(aUpdate, "CSTHIST = Destino.CSTHIST + Origem.CSTHIST")
            AAdd(aUpdate, "CSTPROC = Destino.CSTPROC + Origem.CSTPROC")
            AAdd(aUpdate, "QTDHIST = Destino.QTDHIST + Origem.QTDHIST")
            AAdd(aUpdate, "QTDPROC = Destino.QTDPROC + Origem.QTDPROC")
            cUpdate := "CMHIST = "
            cUpdate += "Case "
            cUpdate += "   When Origem.QTDHIST + Destino.QTDHIST > 0 "
            cUpdate += "   Then (Origem.CSTHIST + Destino.CSTHIST) "
            cUpdate += "   / (Origem.QTDHIST + Destino.QTDHIST) "
            cUpdate += "   Else Origem.CMHIST "
            cUpdate += "End"
            AAdd(aUpdate, cUpdate)
            cUpdate := "CMPROC = "
            cUpdate += "Case "
            cUpdate += "   When Origem.QTDPROC + Destino.QTDPROC > 0 "
            cUpdate += "   Then (Origem.CSTPROC + Destino.CSTPROC) "
            cUpdate += "   / (Origem.QTDPROC + Destino.QTDPROC) "
            cUpdate += "   Else Origem.CMPROC "
            cUpdate += "End"
            AAdd(aUpdate, cUpdate)
            //Expressões de insert
            ASize(aCpoDest, 0)
            aCpoDest := {}
            AAdd(aCpoDest, "FILPROC")
            AAdd(aCpoDest, "FILIAL")
            AAdd(aCpoDest, "COD")
            If ::jParams["MV_CUSFIL"] == "A"
                AAdd(aCpoDest, "ARMAZEM")
            EndIf
            AAdd(aCpoDest, "CODPAR")
            AAdd(aCpoDest, "MOEDA")
            AAdd(aCpoDest, "QTDHIST")
            AAdd(aCpoDest, "QTDPROC")
            AAdd(aCpoDest, "CSTHIST")
            AAdd(aCpoDest, "CSTPROC")
            AAdd(aCpoDest, "CMHIST")
            AAdd(aCpoDest, "CMPROC")

            ASize(aInsert, 0)
            aInsert := {}
            AAdd(aInsert, "'"+cFilProc+"'")
            AAdd(aInsert, "Origem.FILIAL")
            AAdd(aInsert, "Origem.COD")
            If ::jParams["MV_CUSFIL"] == "A"
                AAdd(aInsert, "Origem.ARMAZEM")
            EndIf
            AAdd(aInsert, "Origem.CODPAR")
            AAdd(aInsert, "Origem.MOEDA")
            AAdd(aInsert, "Origem.QTDHIST")
            AAdd(aInsert, "Origem.QTDPROC")
            AAdd(aInsert, "Origem.CSTHIST")
            AAdd(aInsert, "Origem.CSTPROC")
            cInsert := "Case "
            cInsert += "When Origem.QTDHIST > 0 "
            cInsert += "Then Origem.CSTHIST/Origem.QTDHIST "
            cInsert += "Else Origem.CMHIST "
            cInsert += "End"
            AAdd(aInsert, cInsert)
            cInsert := "Case "
            cInsert += "When Origem.QTDPROC > 0 "
            cInsert += "Then Origem.CSTPROC/Origem.QTDPROC "
            cInsert += "Else Origem.CMPROC "
            cInsert += "End"
            AAdd(aInsert, cInsert)

            cMerge := ::MergeStatement(::TableName(), cQuery, aMatch, aUpdate, aCpoDest, aInsert)

            ::RunQuery(cMerge)
        Next nMoeda
    Next nFil

Return 


/*/{Protheus.doc} ProcessingTable::RetrieveProcessingTable
Recupera a tabela de processamento para cada iteraçao, retornando os valores de custo e quantidade histórico para o processado.
@type method
@version 1.0 
@author Squad Entradas
@since 4/28/2025
@param cFilProc, character, filial de processamento
@param cFilAtu, character, filial de atualizacao
@param cCod, character, código do produto
@param nIter, numeric, numero da iteração
/*/
Method RetrieveProcessingTable(cFilProc as Character, cFilAtu as Character, cCod as Character, nIter as Integer) Class PartsProcessingTable
    Local cCTE    As Character
    Local cQuery  As Character
    Local nBind   As Integer
    Local cUpdate As Character

    If !::lOracle
        cCTE := " With TEMPTABLE As "
    Else
        cCTE := " Merge Into "+::TableName()+" Using "
    EndIf

    If ::oRecProcess == Nil
        cQuery := " Select R_E_C_N_O_ RECNUMBER "
        cQuery += " From "+::TableName()+" "
        cQuery += " Where "
        cQuery += " FILPROC = ? And "
        cQuery += " FILIAL  = ? And "
        cQuery += " COD     = ? "

        cQuery := ChangeQuery(cQuery)

        ::oRecProcess := FWExecStatement():New(cQuery)
    EndIf

    nBind := 1
    ::oRecProcess:SetString(nBind++, cFilProc)
    ::oRecProcess:SetString(nBind++, cFilAtu)
    ::oRecProcess:SetString(nBind++, cCod)

    cQuery := " ( "+::oRecProcess:GetFixQuery()+" ) "

    If ::lOracle
        cQuery += " TEMPTABLE "
        cQuery += " On ("
        cQuery += " "+::TableName()+".R_E_C_N_O_ = TEMPTABLE.RECNUMBER"
        cQuery += " ) "
        cQuery += " When Matched Then "
    EndIf

    If !::lOracle
        cUpdate := " Update "+::TableName()+" "
    Else
        cUpdate := " Update "
    EndIf
    cUpdate += "    Set "
    cUpdate += " QTDPROC  = QTDHIST, "
    cUpdate += " CSTPROC  = CSTHIST, "
    cUpdate += " ITERACAO = "+cValToChar(nIter)+" "

    If !::lOracle
        cUpdate += " From TEMPTABLE "
    EndIf
    cUpdate += " Where "
    cUpdate += " "+::TableName()+".R_E_C_N_O_ = TEMPTABLE.RECNUMBER"

    ::RunQuery(cCTE+cQuery+cUpdate)

Return 


/*/{Protheus.doc} AcquisitionPartsCost
    Agrega custo de aquisicao na tabela de processamento em partes
    @author Squad.Entradas
    @since 08/04/2025
    @version 1.0
    @param cFilProc, character, Filial de processamento
    /*/
Method AcquisitionPartsCost(cFilProc, dDtIni, dDtFim) Class PartsProcessingTable
    Local aBind    := {} As Array
    Local aMatch   := {} As Array
    Local aUpdate  := {} As Array
    Local aCpoDest := {} As Array
    Local aInsert  := {} As Array
    Local nFil     := 0  As Integer
    Local nX       := 0  As Integer
    Local nMoeda   := 0  As Integer
    Local cFilAtu  := "" As Character
    Local cMoeda   := "" As Character
    Local cQuery   := "" As Character
    Local cUpdate  := "" As Character
    Local cInsert  := "" As Character
    Local cMerge   := "" As Character

    If ::oQryAcqCost == Nil
        cQuery := " SELECT "
        If ::jParams["MV_CUSFIL"] != "E"
            cQuery += "SD1.D1_FILIAL FILIAL, "
        Else
            If ::lPostgres
                cQuery += " Char("+cValToChar(FWSizeFilial())+") "
            EndIf
            cQuery += " '"+PadR(FWCompany(), FWSizeFilial())+"' FILIAL, "
        EndIf
        cQuery += "SD1.D1_COD COD, "
        If ::jParams["MV_CUSFIL"] == "A"
            cQuery += "SD1.D1_LOCAL ARMAZEM, "
        EndIf
        cQuery += "SUM(SD1.D1_QUANT) QUANT, "
        For nMoeda := 1 To Len(::jParams["moedas"])
            cMoeda := ::jParams["moedas", nMoeda]
            cQuery += "SUM(SD1.D1_CUSTO" + cMoeda + ") CUSTO" + cMoeda + ", "
        Next nMoeda
        cQuery += "SD1.D4G_CODPAR PARTE "
        cQuery += "FROM " + ::cViewPartAcq + " SD1 "
        cQuery += " WHERE SD1.D1_FILIAL = ? "
        cQuery += " AND SD1.D1_DTDIGIT >= ? "
        cQuery += " AND SD1.D1_DTDIGIT <= ? "
        If  ::jVwAcqCstParams["SF4_EMPRESA"] != FWModeAccess("SD1", 1) .Or. ;
            ::jVwAcqCstParams["SF4_UNIDADE"] != FWModeAccess("SD1", 2) .Or. ;
            ::jVwAcqCstParams["SF4_FILIAL"]  != FWModeAccess("SD1", 3)
            cQuery += " AND SD1.F4_FILIAL = ? "
        EndIf
        cQuery += " AND (SD1.D4G_REVIS = ? OR SD1.D4G_REVIS IS NULL) "
        cQuery += "GROUP BY "
        cQuery += "SD1.D1_FILIAL, "
        cQuery += "SD1.D1_COD, "
        If ::jParams["MV_CUSFIL"] == "A"
            cQuery += "SD1.D1_LOCAL, "
        EndIf
        cQuery += "SD1.D4G_CODPAR "

        ::oQryAcqCost := FWExecStatement():New(ChangeQuery(cQuery))
    EndIf

    For nFil := 1 To Len(::aFilProc)
        cFilAtu := ::aFilProc[nFil, 1]

        aSize(aBind, 0)
        aBind := {}
        aAdd(aBind, FWXFilial("SD1", cFilAtu))
        aAdd(aBind, DToS(dDtIni))
        aAdd(aBind, DToS(dDtFim))
        If  ::jVwAcqCstParams["SF4_EMPRESA"] != FWModeAccess("SD1", 1) .Or. ;
            ::jVwAcqCstParams["SF4_UNIDADE"] != FWModeAccess("SD1", 2) .Or. ;
            ::jVwAcqCstParams["SF4_FILIAL"]  != FWModeAccess("SD1", 3)
            aAdd(aBind, FWXFilial("SF4", cFilAtu))
        EndIf
        aAdd(aBind, ::jParams["revisao_vigente"])

        For nX := 1 To Len(aBind)
            ::oQryAcqCost:SetString(nX, aBind[nX])
        Next nX

        cQuery := ::oQryAcqCost:GetFixQuery()

        For nMoeda := 1 To Len(::jParams["moedas"])
            cMoeda := ::jParams["moedas", nMoeda]
            cMoedaIns := StrZero(Val(cMoeda), 2)

            //Filtro
            aSize(aMatch, 0)
            aMatch := {}
            aAdd(aMatch, {"'" + cFilProc + "'", "FILPROC"})
            aAdd(aMatch, {"FILIAL", "FILIAL"})
            aAdd(aMatch, {"COD", "COD"})
            If ::jParams["MV_CUSFIL"] == "A"
                aAdd(aMatch, {"ARMAZEM", "ARMAZEM"})
            EndIf
            aAdd(aMatch, {"PARTE", "CODPAR"})
            aAdd(aMatch, {"'" + cMoedaIns + "'", "MOEDA"})

            //Expressões de update
            aSize(aUpdate, 0)
            aUpdate := {}
            aAdd(aUpdate, "CSTHIST = DESTINO.CSTHIST + ORIGEM.CUSTO" + cMoeda)
            aAdd(aUpdate, "CSTPROC = DESTINO.CSTPROC + ORIGEM.CUSTO" + cMoeda)
            aAdd(aUpdate, "QTDHIST = DESTINO.QTDHIST + ORIGEM.QUANT")
            aAdd(aUpdate, "QTDPROC = DESTINO.QTDPROC + ORIGEM.QUANT")
            cUpdate := "CMHIST = "
            cUpdate += "CASE "
            cUpdate += "    WHEN (DESTINO.QTDHIST + ORIGEM.QUANT) > 0 "
            cUpdate += "        THEN (DESTINO.CSTHIST + ORIGEM.CUSTO" + cMoeda + ") / "
            cUpdate += "             (DESTINO.QTDHIST + ORIGEM.QUANT) "
            cUpdate += "    ELSE DESTINO.CMHIST "
            cUpdate += "END"
            aAdd(aUpdate, cUpdate)
            cUpdate := "CMPROC = "
            cUpdate += "CASE "
            cUpdate += "    WHEN (DESTINO.QTDPROC + ORIGEM.QUANT) > 0 "
            cUpdate += "        THEN (DESTINO.CSTPROC + ORIGEM.CUSTO" + cMoeda + ") / "
            cUpdate += "             (DESTINO.QTDPROC + ORIGEM.QUANT) "
            cUpdate += "    ELSE DESTINO.CMPROC "
            cUpdate += "END"
            aAdd(aUpdate, cUpdate)
            //Expressões de insert
            aSize(aCpoDest, 0)
            aCpoDest := {}
            aAdd(aCpoDest, "FILPROC")
            aAdd(aCpoDest, "FILIAL")
            aAdd(aCpoDest, "COD")
            If ::jParams["MV_CUSFIL"] == "A"
                aAdd(aCpoDest, "ARMAZEM")
            EndIf
            aAdd(aCpoDest, "CODPAR")
            aAdd(aCpoDest, "MOEDA")
            aAdd(aCpoDest, "QTDHIST")
            aAdd(aCpoDest, "QTDPROC")
            aAdd(aCpoDest, "CSTHIST")
            aAdd(aCpoDest, "CSTPROC")
            aAdd(aCpoDest, "CMHIST")
            aAdd(aCpoDest, "CMPROC")

            aSize(aInsert, 0)
            aInsert := {}
            aAdd(aInsert, "'"+cFilProc+"'")
            aAdd(aInsert, "ORIGEM.FILIAL")
            aAdd(aInsert, "ORIGEM.COD")
            If ::jParams["MV_CUSFIL"] == "A"
                aAdd(aInsert, "ORIGEM.ARMAZEM")
            EndIf
            aAdd(aInsert, "ORIGEM.PARTE")
            aAdd(aInsert, "'" + cMoedaIns + "'")
            aAdd(aInsert, "ORIGEM.QUANT")
            aAdd(aInsert, "ORIGEM.QUANT")
            aAdd(aInsert, "ORIGEM.CUSTO" + cMoeda)
            aAdd(aInsert, "ORIGEM.CUSTO" + cMoeda)
            cInsert := "CASE "
            cInsert += "    WHEN ORIGEM.QUANT > 0 "
            cInsert += "        THEN ORIGEM.CUSTO" + cMoeda + " / ORIGEM.QUANT "
            cInsert += "    ELSE 0 "
            cInsert += "END"
            aAdd(aInsert, cInsert)
            cInsert := "CASE "
            cInsert += "    WHEN ORIGEM.QUANT > 0 "
            cInsert += "        THEN ORIGEM.CUSTO" + cMoeda + " / ORIGEM.QUANT "
            cInsert += "    ELSE 0 "
            cInsert += "END"
            aAdd(aInsert, cInsert)

            cMerge := ::MergeStatement(::TableName(), cQuery, aMatch, aUpdate, aCpoDest, aInsert)

            ::RunQuery(cMerge)

        Next nMoeda
    Next nFil

Return

/*/{Protheus.doc} updateAverageCostInAllParts
    Equaliza a quantidade e custo médio em todas as partes
    @author Squad Entradas
    @since 17/06/2026
    @version version
    @param param_name, param_type, param_descr
    @return return_var, return_type, return_description
    /*/
Method updateAverageCostInAllParts(cFilProc) Class PartsProcessingTable
    local cFieldsUpd    as character
    local cQryStatement as character
    local cMatchFilter  as character
    local cCteStatement as character
    Local nFil          as integer
	
    If ::oBuildQryStatementUpdAllParts == Nil
        cQryStatement := " SELECT TRH.FILPROC, TRH.FILIAL, TRH.COD, TRH.ARMAZEM, "
        cQryStatement += " TRH.QTDPROC, TRH.QTDHIST "
        cQryStatement += " FROM "+::cProcTable+" TRH "
        cQryStatement += " WHERE TRH.FILPROC = ? AND "
        cQryStatement += " TRH.FILIAL = ? "

        cQryStatement := ChangeQuery(cQryStatement)

        ::oBuildQryStatementUpdAllParts := FWExecStatement():New(cQryStatement)
    EndIf

    For nFil := 1 To Len(::aFilProc)
        cFilAtu := ::aFilProc[nFil, 1]

        ::oBuildQryStatementUpdAllParts:SetString(1, cFilProc)
        ::oBuildQryStatementUpdAllParts:SetString(2, cFilAtu)

        cQryStatement := ::oBuildQryStatementUpdAllParts:GetFixQuery()

        cFieldsUpd := " QTDPROC = TEMPTABLE.QTDPROC, "
        cFieldsUpd += " CMPROC  = CASE WHEN TEMPTABLE.QTDPROC > 0 THEN "+::TableName()+".CSTPROC / TEMPTABLE.QTDPROC ELSE "+::TableName()+".CMPROC END, "
        cFieldsUpd += " QTDHIST = TEMPTABLE.QTDHIST, "
        cFieldsUpd += " CMHIST  = CASE WHEN TEMPTABLE.QTDHIST > 0 THEN "+::TableName()+".CSTHIST / TEMPTABLE.QTDHIST ELSE "+::TableName()+".CMHIST END "

        cMatchFilter := ::TableName()+".FILPROC = TEMPTABLE.FILPROC AND "
        cMatchFilter += ::TableName()+".FILIAL = TEMPTABLE.FILIAL AND "
        cMatchFilter += ::TableName()+".COD = TEMPTABLE.COD AND "
        cMatchFilter += ::TableName()+".ARMAZEM = TEMPTABLE.ARMAZEM "

        cCteStatement := ::buildCteStatement(::TableName(), cFieldsUpd, cMatchFilter, cQryStatement)
        ::RunQuery(cCteStatement)
    Next nFil
Return 
