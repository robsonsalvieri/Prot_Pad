/*/{Protheus.doc} destroy
Limpa da memória as variáveis (objeto, array e json) da clase
@type method
@version 12.1.2510
@author gabriel.lakatos
@since 27/03/2026
/*/
method destroy() class CadBenefApiProspecting

	freeObj(self:jBody)
	freeObj(self:jResponse)
	freeObj(self:jStatusCodeMessage)
	fwFreeArray(self:aParams)

return

/*/{Protheus.doc} generateProspectingFile
Método responsável por gerar o arquivo de prospecção de vendas
@type method
@version 12.1.2610
@author gabriel.lakatos 
@since 27/03/2026
/*/
method generateProspectingFile(cContract as character, cOperation as character, cTransactionCode as character, jContractData as json) class CadBenefApiProspecting

	local lSuccess := .F. as logical

	self:jBody := JsonObject():new()
	self:cContract := cContract
	self:cUnimedOrigin := jContractData["healthInsurerCode"]
	self:cOperation := cOperation
	self:jContractData := jContractData
	self:cProtocolNumber := jContractData["protocolNumber"]

	self:openUsedTables()
	self:loadHeader(cTransactionCode)
	self:loadContractsData()
	self:loadPlanData()
	if self:jContractData["alias"] == "BQC"
		self:loadBeneficiariesData()
	else
		self:loadBeneficiaryData()
	endif
	self:loadAgreementData()

	if !self:lIsError
		lSuccess := .T.
	endif

return lSuccess

/*/{Protheus.doc} openUsedTables
Abri as tabelas a serem utilizadas na montagem do json de envio
@type method
@version 12.1.2510
@author gabriel.lakatos
@since 27/03/2026

/*/
method openUsedTables() class CadBenefApiProspecting

	if self:jContractData["alias"] == "BA3"
		BA1->(dbSetOrder(1)) // BA1_FILIAL+BA1_CODINT+BA1_CODEMP+BA1_MATRIC+BA1_TIPUSU+BA1_TIPREG+BA1_DIGITO
		BA1->(dbSeek(xFilial("BA1") + BA3->(BA3_CODINT + BA3_CODEMP + BA3_MATRIC) + GetNewPar("MV_PLCDTIT")))
		BG9->(dbSetOrder(1))
		BG9->(dbSeek(xFilial("BG9") + BA3->(BA3_CODINT + BA3_CODEMP)))
	else
		BG9->(dbSetOrder(1))
		BG9->(dbSeek(xFilial("BG9") + BQC->(BQC_CODIGO)))
	endif

	if self:jContractData["alias"] == "BQC"
		BA3->(dbSetOrder(7)) // BA3_FILIAL+BA3_CODINT+BA3_CODEMP+BA3_CONEMP+BA3_VERCON+BA3_SUBCON+BA3_VERSUB+BA3_MATRIC
		BA3->(dbSeek(xFilial("BA3") + BQC->(BQC_CODIGO + BQC_NUMCON + BQC_VERCON + BQC_SUBCON + BQC_VERSUB)))

		// Necessário percorrer a BA3 para localizar a primeira família sem bloqueio para posicionar a BI3 a partir do produto saúde daquela família
		while !BA3->(eof()) .and.;
			BA3->(BA3_FILIAL + BA3_CODINT + BA3_CODEMP + BA3_CONEMP + BA3_VERCON + BA3_SUBCON + BA3_VERSUB) == BQC->(BQC_FILIAL + BQC_CODIGO + BQC_NUMCON + BQC_VERCON + BQC_SUBCON + BQC_VERSUB)
			
			if empty(BA3->BA3_DATBLO)
				BI3->(dbSetOrder(1)) // BI3_FILIAL+BI3_CODINT+BI3_CODIGO+BI3_VERSAO
				BI3->(dbSeek(xFilial("BI3") + BA3->(BA3_CODINT + BA3_CODPLA + BA3_VERSAO)))
				exit
			endif

			BA3->(dbSkip())
		end
	else
		BI3->(dbSetOrder(1)) // BI3_FILIAL+BI3_CODINT+BI3_CODIGO+BI3_VERSAO
		BI3->(dbSeek(xFilial("BI3") + BA3->(BA3_CODINT + BA3_CODPLA + BA3_VERSAO)))
	endif

return 

/*/{Protheus.doc} loadHeader
Carrega os dados do cabeçalho na requisição (body) a ser enviado para o validador comercial unimed.
@type method
@version 12.1.2510
@author gabriel.lakatos
@since 27/03/2026
@param cTransactionCode, character, código da transação gerado
/*/
method loadHeader(cTransactionCode as character) class CadBenefApiProspecting

	local cOrigin := "cabecalho" as character

	self:jBody["cabecalho"] := JsonObject():new()
	self:setAttribute({"body": self:jBody["cabecalho"], "attribute": "codigoControleTransacao", "value": cTransactionCode, "type": "character", "required": REQUIRED, "origin": cOrigin,;
					   "errorDetailedMessage": STR0001}) // Regra: Não deve ser repetido
	
	self:setAttribute({"body": self:jBody["cabecalho"], "attribute": "codigoVersaoPTU", "value": "001", "type": "character", "required": REQUIRED, "origin": cOrigin,;
					"errorDetailedMessage": STR0002}) // F"001"

	self:jBody["cabecalho"]["unimed"] := JsonObject():new()
	self:setAttribute({"body": self:jBody["cabecalho"]["unimed"], "attribute": "codigoUnimedOrigem", "value": self:cUnimedOrigin, "type": "character", "required": REQUIRED, "origin": cOrigin,;
					"errorDetailedMessage": STR0003})

	self:setAttribute({"body": self:jBody["cabecalho"], "attribute": "dataGeracao", "value": dDataBase, "type": "date1", "required": REQUIRED, "origin": cOrigin,;
					"errorDetailedMessage": STR0005})

return

/*/{Protheus.doc} loadContractsData
Carrega os dados do contrato na requisição (body) a ser enviado para o validador comercial unimed.
@type method
@version 12.1.2510
@author gabriel.lakatos
@since 27/03/2026
/*/
method loadContractsData() class CadBenefApiProspecting

	local cOrigin := "dadosEmpresaContratante" as character
	local cCompanyName := "" as character
	local lCnpjRequired :=  .f. as logical

	self:jBody["dadosEmpresaContratante"] := JsonObject():new()

	self:loadTypeContractor()

	if self:jContractData["alias"] == "BA3"
		cCompanyName := BG9->BG9_DESCRI
	else
		cCompanyName := iif(empty(BQC->BQC_DESCRI), BG9->BG9_DESCRI, BQC->BQC_DESCRI)
	endif

	lCnpjRequired :=  self:jBody["dadosEmpresaContratante"]["tipoContratante"]:hasProperty("cnpj")

	self:setAttribute({"body": self:jBody["dadosEmpresaContratante"], "attribute": "nomeEmpresa",;
					   "value": cCompanyName, "type": "character", "required":lCnpjRequired, "origin": cOrigin,;
					   "errorDetailedMessage": STR0008})

	self:loadAddressCompany()
	
	self:setAttribute({"body": self:jBody["dadosEmpresaContratante"], "attribute": "indicadorCessaoRede",;
					"value": .F., "type": "logical", "required": REQUIRED, "origin": cOrigin,;
					"errorDetailedMessage": ""})

	self:setAttribute({"body": self:jBody["dadosEmpresaContratante"], "attribute": "registroANSAutoGestao",;
					"value": "", "type": "character", "required": self:jBody["dadosEmpresaContratante"]["indicadorCessaoRede"], "origin": cOrigin,;
					"errorDetailedMessage": ""}, .T.)

	self:setAttribute({"body": self:jBody["dadosEmpresaContratante"], "attribute": "indicadorAdmBeneficios",;
					"value": iif(!empty(BQC->BQC_CNPADM), .T., .F.), "type": "logical", "required": REQUIRED, "origin": cOrigin,;
					"errorDetailedMessage": STR0035})

	self:setAttribute({"body": self:jBody["dadosEmpresaContratante"], "attribute": "registroANSAdmBeneficios",;
					"value": BQC->BQC_ANSADM, "type": "character", "required": self:jBody["dadosEmpresaContratante"]["indicadorAdmBeneficios"], "origin": cOrigin,;
					"errorDetailedMessage": STR0036}, .T.)		   

return

/*/{Protheus.doc} loadTypeContractor
Carrega os dados de tipo do Contratante na requisição (body) a ser enviado para o cadBenef.
@type method
@version 12.1.2510
@author gabriel.lakatos
@since 27/03/2026
/*/
method loadTypeContractor() class CadBenefApiProspecting

	local jContractorType as json
	local cOrigin := "tipoContratante" as character

	self:jBody["dadosEmpresaContratante"]["tipoContratante"] := JsonObject():new()

	jContractorType := getContractorType(self:jContractData["alias"])

	// Regras: Obrigatório o preenchimento de um dos campos
	self:setAttribute({"body": self:jBody["dadosEmpresaContratante"]["tipoContratante"], "attribute": "caepf",;
					   "value": jContractorType["caepf"], "type": "character", "required": empty(jContractorType["cpf"]) .AND. empty(jContractorType["cnpj"]) , "origin": cOrigin,;
					   "errorDetailedMessage": STR0025}) 
 
	self:setAttribute({"body": self:jBody["dadosEmpresaContratante"]["tipoContratante"], "attribute": "cnpj",;
					   "value": jContractorType["cnpj"], "type": "character", "required": empty(jContractorType["cpf"]) .AND. empty(jContractorType["caepf"]), "origin": cOrigin,;
					   "errorDetailedMessage": STR0006}) 

	self:setAttribute({"body": self:jBody["dadosEmpresaContratante"]["tipoContratante"], "attribute": "cpf",;
					   "value": jContractorType["cpf"], "type": "character", "required": empty(jContractorType["cnpj"]) .AND.  empty(jContractorType["caepf"]), "origin": cOrigin,;
					   "errorDetailedMessage": STR0007})

	freeObj(jContractorType)

return

/*/{Protheus.doc} setAttribute
Defini os campos a ser adicionado no body para comunicar com o CadBenef.
@type method
@version 12.1.2510
@author gabriel.lakatos
@since 27/03/2026
@param jData, json, dados do campo a ser adicionado body da requisição
/*/
method setAttribute(jData as json, lForceEmpty) class CadBenefApiProspecting

	local lEmpty as logical
	local aDetails := {} as array

	default lForceEmpty := .F.

	lEmpty := ((valtype(jData["value"]) <> "L" .and. empty(jData["value"])) .or. (jData["type"] == "logical" .and. valtype(jData["value"]) <> "L" ))

	if !empty(jData["value"]) .or. lForceEmpty

		do case
			case jData["type"] == "numeric"
				if valType(jData["value"]) == "C"
					jData["value"] := val(jData["value"])
				endif

			case jData["type"] == "character"
				if valType(jData["value"]) == "C"
					jData["value"] := alltrim(jData["value"])
				endif
			
			case jData["type"] == "date1" // Formato dd/mm/aaaa-hh:mm:ss
				if valType(jData["value"]) == "D"
					jData["value"] := fwTimeStamp(6, jData["value"])
					// Necessário fazer tratamentos abaixo pois é o formato aceito pela Unimed Brasil
					jData["value"] := strTran(jData["value"], "T", "")
					jData["value"] := strTran(jData["value"], "-", "/")
				endif
		endcase
	endif

	// Mandatório (Obrigatório envio da informação)
	if jData["required"] .and. lEmpty
		aAdd(aDetails, {"code": "400.001", "message": STR0012 + jData["attribute"] + STR0013, "detailedMessage": iif(jData:hasProperty("errorDetailedMessage"), jData["errorDetailedMessage"], "")}) // "O campo ";" é obrigatório." 

		self:setError("400.001",;
					   STR0014,; // "Existem campos obrigatórios do beneficiário que não foram preenchidos."
					   STR0015,; // "Verifique a lisata de erros para mais detalhes."
				      aDetails)
	else
		if !lEmpty .or. lForceEmpty
			jData["body"][jData["attribute"]] := jData["value"]
		endif
	endif

	fwFreeArray(aDetails)

return

/*/{Protheus.doc} setError
Defini os dados de erro no json de resposta
@type method
@version 12.1.2510
@author gabriel.lakatos
@since 27/03/2026
@param cCode, character, código do erro (status code)
@param cMessage, character, mensagem do erro
@param cDetailedMessage, character, detalhes do erro
@param aDetails, character, lista de objetos de erro com mais detalhes sobre o erro principal
@return json, objeto json de resposta
/*/
method setError(cCode as character, cMessage as character, cDetailedMessage as character, aDetails as array) as json class CadBenefApiProspecting

	local nCount as numeric

	default aDetails := {}

	self:jResponse["code"] := cCode
	self:jResponse["message"] := cMessage
	self:jResponse["detailedMessage"] := cDetailedMessage

	if len(aDetails) > 0
		if self:jResponse:hasProperty("details")
			for nCount := 1 to len(aDetails)
				aAdd(self:jResponse["details"], aDetails[nCount])
			next nCount
		else
			self:jResponse["details"] = aClone(aDetails)
		endif
	endif

	self:lIsError := .T.
	self:cMessage := cMessage

return self:jResponse

/*/{Protheus.doc} getCompanyType
Obter os dados de cnpj ou cpf da empresa contratante
@type function
@version 12.1.2510
@author gabriel.lakatos
@since 27/03/2026
@return json, dados do tipo da empresa contratante
/*/
static function getContractorType(cAlias as character) as json

	local cCnpj  := "" as character
	local cCaepf := "" as character
	local cCpf   := "" as character
	local jContractorType as json

	if cAlias == "BA3"
		if !empty(BA3->BA3_GRPFAM)

			cCpf := GetAdvFVal("BA1","BA1_CPFUSR", xFilial("BA1") + BA3->BA3_GRPFAM, 1, "")

			cCpf := strZero(val(cCpf), 11)
		else
			cCpf := strZero(val(BA1->BA1_CPFUSR), 11)
		endif
	else
		do case

			case !empty(BQC->BQC_CNPJ)
				cCnpj := strZero(val(BQC->BQC_CNPJ), 14)
			case !empty(BQC->BQC_CAEPF)	
				cCaepf := strZero(val(BQC->BQC_CAEPF), 14)
			otherwise
				SA1->(dbSetOrder(1))
				if SA1->(msSeek(xFilial("SA1") + BQC->(BQC_CODCLI + BQC_LOJA))) .and. !empty(SA1->A1_CGC)
					cCnpj := strZero(val(SA1->A1_CGC), 14)
				endif

		endcase
	endif

	jContractorType := {"cnpj": cCnpj,"caepf": cCaepf , "cpf": cCpf}

return jContractorType

/*/{Protheus.doc} loadAddressCompany
Carrega os dados do contrato na requisição (body).
@type method
@version 12.1.2610
@author gabriel.lakatos
@since 27/03/2026
/*/
method loadAddressCompany() class CadBenefApiProspecting

	local lHasValue as logical
	local cOrigin := "endereco" as character

	lHasValue := !empty(BQC->BQC_LOGRAD) .or. !empty(BQC->BQC_COMPLE) .or. !empty(BQC->BQC_NUMERO) .or.;
				 !empty(BQC->BQC_BAIRRO) .or. !empty(BQC->BQC_CODMUN) .or. !empty(BQC->BQC_CEP)

	if lHasValue
		self:jBody["dadosEmpresaContratante"]["endereco"] := JsonObject():new()

		self:setAttribute({"body": self:jBody["dadosEmpresaContratante"]["endereco"], "attribute": "logradouroPrincipal",;
						   "value": BQC->BQC_LOGRAD, "type": "character", "size": 80, "required": REQUIRED, "origin": cOrigin,;
						   "errorDetailedMessage": ""})

		self:setAttribute({"body": self:jBody["dadosEmpresaContratante"]["endereco"], "attribute": "numeroLogradouro",;
						   "value": iif(empty(BQC->BQC_NUMERO), "S/N", BQC->BQC_NUMERO), "type": "character", "required": REQUIRED, "origin": cOrigin,;
						   "errorDetailedMessage": ""})

		self:setAttribute({"body": self:jBody["dadosEmpresaContratante"]["endereco"], "attribute": "bairro",;
						   "value": BQC->BQC_BAIRRO, "type": "character", "size": 45, "required": OPTIONAL, "origin": cOrigin,;
						   "errorDetailedMessage": ""})

		self:setAttribute({"body": self:jBody["dadosEmpresaContratante"]["endereco"], "attribute": "codigoMunicipio",;
						   "value": BQC->BQC_CODMUN, "type": "numeric", "required": OPTIONAL, "origin": cOrigin,;
						   "errorDetailedMessage": ""})

		self:setAttribute({"body": self:jBody["dadosEmpresaContratante"]["endereco"], "attribute": "uf",;
						   "value": subStr(BQC->BQC_CODMUN, 1, 2), "type": "numeric", "required": OPTIONAL, "origin": cOrigin,;
						   "errorDetailedMessage": ""})
	endif
	
return


/*/{Protheus.doc} loadPlanData
Carrega os dados do produto na requisição (body).
@type method
@version 12.1.2510
@author gabriel.lakatos 
@since 27/03/2026
/*/
method loadPlanData() class CadBenefApiProspecting

	local cOrigin := "dadosPlano" as character
	local jScope as json
	local cTipoContratacao := "" as character

	self:jBody["dadosPlano"] := JsonObject():new()

	if BI3->BI3_CLAPLS == "1"
		cTipoContratacao := "2"
	elseif BI3->BI3_CLAPLS == "2"
		cTipoContratacao := "3"
	elseif BI3->BI3_CLAPLS == "3"
		cTipoContratacao := "4"
	endif

	self:setAttribute({"body": self:jBody["dadosPlano"], "attribute": "tipoContratacao",;
					   "value": cTipoContratacao, "type": "numeric", "required": REQUIRED, "origin": cOrigin,;
					   "errorDetailedMessage": STR0037})

	self:setAttribute({"body": self:jBody["dadosPlano"], "attribute": "tipoAbrangencia",;
					"value": posicione("BF7", 1, xFilial("BF7") + BI3->BI3_ABRANG, "BF7_CODEDI"), "type": "numeric", "required": REQUIRED, "origin": cOrigin,;
					"errorDetailedMessage": STR0026})

	BF7->(dbSetOrder(1))
	if BF7->(dbSeek(xFilial("BF7") + BI3->BI3_ABRANG))
		do case
			case BF7->BF7_CODEDI == "2" // Regional A - Grupo de Estados
				B9C->(dbSetOrder(1))
				if B9C->(dbSeek(xFilial("B9C") + BF7->BF7_CODORI))
					self:jBody["dadosPlano"]["abrangencias"] := {}

					while !B9C->(Eof()) .and. B9C->B9C_FILIAL + B9C->B9C_CODORI == xFilial("B9C") + BF7->BF7_CODORI
						jScope := JsonObject():new()

						self:setAttribute({"body": jScope, "attribute": "uf", "value": B9C->B9C_ESTADO, "type": "uf", "required": iif(self:jBody["dadosPlano"]["tipoAbrangencia"] == 2, .T., .F.), "origin": cOrigin,;
										   "errorDetailedMessage": STR0027}) // Regra: Obrigatório quando tp_abrangencia = 2

						aAdd(self:jBody["dadosPlano"]["abrangencias"], jScope)

						B9C->(dbSkip())
					enddo
				endif

			case BF7->BF7_CODEDI == "4" // Regional B - Grupo de Municípios
				B9B->(dbSetOrder(1))
				if B9B->(dbSeek(xFilial("B9B") + BF7->BF7_CODORI))
					self:jBody["dadosPlano"]["abrangencias"] := {}

					while !B9B->(Eof()) .and. B9B->B9B_FILIAL + B9B->B9B_CODORI == xFilial("B9B") + BF7->BF7_CODORI
						jScope := JsonObject():new()

						self:setAttribute({"body": jScope, "attribute": "codigoMunicipio", "value": B9B->B9B_CODMUN, "type": "numeric", "required": iif(self:jBody["dadosPlano"]["tipoAbrangencia"] == 4, .T., .F.), "origin": cOrigin,;
										   "errorDetailedMessage": STR0028}) // Regra: Obrigatório quando tp_abrangencia = 4

						aAdd(self:jBody["dadosPlano"]["abrangencias"], jScope)

						B9B->(dbSkip())
					enddo
				endif
		endcase
	endif
	
return

/*/{Protheus.doc} loadBeneficiaryData
Carrega os dados do beneficiário na requisição (body).
@type method
@version 12.1.2510
@author gabriel.lakatos 
@since 27/03/2026
/*/
method loadBeneficiaryData() class CadBenefApiProspecting

	local cOrigin := "dadosBeneficiario" as character
	local cDependencyCode as character
	
	self:jBody["dadosBeneficiario"] := JsonObject():new()

	cDependencyCode := getDependencyCode()

	self:setAttribute({"body": self:jBody["dadosBeneficiario"], "attribute": "nomeCompletoBeneficiario",;
					   "value": alltrim(BTS->BTS_NOMUSR) + " " + alltrim(BTS->BTS_SOBRN), "type": "character", "size": 70, "required": REQUIRED, "origin": cOrigin,;
					   "errorDetailedMessage": STR0029})

	self:setAttribute({"body": self:jBody["dadosBeneficiario"], "attribute": "cpf",;
					"value": BA1->BA1_CPFUSR, "type": "character", "required": REQUIRED, "origin": cOrigin,;
					"errorDetailedMessage": STR0030})

	self:setAttribute({"body": self:jBody["dadosBeneficiario"], "attribute": "dependencia",;
					"value": cDependencyCode, "type": "character", "required": REQUIRED, "origin": cOrigin,;
					"errorDetailedMessage": STR0031})

	self:loadAddressBeneficiary()
	
return

/*/{Protheus.doc} loadAddressBeneficiary
Carrega os dados do endereço do beneficiário na requisição (body).
@type method
@version 12.1.2510
@author gabriel.lakatos 
@since 27/03/2026
/*/
method loadAddressBeneficiary(lIsArray as logical) class CadBenefApiProspecting

	local cOrigin := "endereco" as character
	local cPropertyVar := ""

	default lIsArray := .F.

	if lIsArray
		cPropertyVar := 'self:jBody["dadosBeneficiario"][len(self:jBody["dadosBeneficiario"])]["endereco"]'
	else
		cPropertyVar := 'self:jBody["dadosBeneficiario"]["endereco"]'
	endif

	&(cPropertyVar) := JsonObject():new()

	self:setAttribute({"body": &(cPropertyVar), "attribute": "logradouroPrincipal",;
						"value": BA1->BA1_ENDERE, "type": "character", "size": 80, "required": REQUIRED, "origin": cOrigin,;
						"errorDetailedMessage": STR0032})

	self:setAttribute({"body": &(cPropertyVar), "attribute": "numeroLogradouro",;
						"value": iif(empty(BA1->BA1_NR_END), "S/N", BA1->BA1_NR_END), "type": "character", "required": REQUIRED, "origin": cOrigin,;
						"errorDetailedMessage": STR0033})

	self:setAttribute({"body": &(cPropertyVar), "attribute": "bairro",;
						"value": BA1->BA1_BAIRRO, "type": "character", "size": 45, "required": OPTIONAL, "origin": cOrigin,;
						"errorDetailedMessage": ""})

	self:setAttribute({"body": &(cPropertyVar), "attribute": "codigoMunicipio",;
						"value": BA1->BA1_CODMUN, "type": "numeric", "required": OPTIONAL, "origin": cOrigin,;
						"errorDetailedMessage": ""})

	self:setAttribute({"body": &(cPropertyVar), "attribute": "uf",;
						"value": subStr(BA1->BA1_CODMUN, 1, 2), "type": "numeric", "required": OPTIONAL, "origin": cOrigin,;
						"errorDetailedMessage": STR0034})
	
return

/*/{Protheus.doc} getDependencyCode
Obter o código PTU do grau de parentesco
@type function
@version 12.1.2610 
@author gabriel.lakatos 
@since 27/03/2026
@return character, código de dependencia do beneficiário
/*/
static function getDependencyCode() as character

	local cCode := "" as character

	BRP->(dbSetOrder(1))
	if BRP->(dbSeek(xFilial("BRP") + BA1->BA1_GRAUPA))
		cCode := BRP->BRP_CODPTU
	endif

return cCode

/*/{Protheus.doc} loadBeneficiariesData
Carrega os dados do beneficiário na requisição (body).
@type method
@version 12.1.2510
@author gabriel.lakatos 
@since 27/03/2026
/*/
method loadBeneficiariesData() class CadBenefApiProspecting

	local cOrigin := "dadosBeneficiario" as character
	local cDependencyCode as character
	local nTamBenef as numeric
	
	self:jBody["dadosBeneficiario"] := {}

	BA3->(dbSetOrder(7)) // BA3_FILIAL+BA3_CODINT+BA3_CODEMP+BA3_CONEMP+BA3_VERCON+BA3_SUBCON+BA3_VERSUB+BA3_MATRIC
	BA3->(dbSeek(xFilial("BA3") + BQC->(BQC_CODIGO+BQC_NUMCON+BQC_VERCON+BQC_SUBCON+BQC_VERSUB)))

	while !BA3->(eof()) .and.;
		 BA3->(BA3_FILIAL+BA3_CODINT+BA3_CODEMP+BA3_CONEMP+BA3_VERCON+BA3_SUBCON+BA3_VERSUB) == BQC->(BQC_FILIAL+BQC_CODIGO+BQC_NUMCON+BQC_VERCON+BQC_SUBCON+BQC_VERSUB)

		BA1->(dbSetOrder(1)) // BA1_FILIAL+BA1_CODINT+BA1_CODEMP+BA1_MATRIC+BA1_TIPUSU+BA1_TIPREG+BA1_DIGITO
		BA1->(dbSeek(xFilial("BA1") + BA3->(BA3_CODINT + BA3_CODEMP + BA3_MATRIC)))
		while !BA1->(eof()) .and. BA1->(BA1_FILIAL + BA1_CODINT + BA1_CODEMP + BA1_MATRIC) == BA3->(BA3_FILIAL+BA3_CODINT + BA3_CODEMP + BA3_MATRIC)

			if !empty(BA1->BA1_DATBLO)
				BA1->(dbSkip())
				loop
			endif

			BTS->(dbSetOrder(1)) // BTS_FILIAL+BTS_MATVID
			if BTS->(dbSeek(xFilial("BTS") + BA1->BA1_MATVID))

				aadd(self:jBody["dadosBeneficiario"], JsonObject():new())
				
				nTamBenef := len(self:jBody["dadosBeneficiario"])

				cDependencyCode := getDependencyCode()

				self:setAttribute({"body": self:jBody["dadosBeneficiario"][nTamBenef], "attribute": "nomeCompletoBeneficiario",;
								"value": alltrim(BTS->BTS_NOMUSR) + " " + alltrim(BTS->BTS_SOBRN), "type": "character", "size": 70, "required": REQUIRED, "origin": cOrigin,;
								"errorDetailedMessage": STR0029})

				self:setAttribute({"body": self:jBody["dadosBeneficiario"][nTamBenef], "attribute": "cpf",;
								"value": BA1->BA1_CPFUSR, "type": "character", "required": REQUIRED, "origin": cOrigin,;
								"errorDetailedMessage": STR0030})

				self:setAttribute({"body": self:jBody["dadosBeneficiario"][nTamBenef], "attribute": "dependencia",;
								"value": cDependencyCode, "type": "character", "required": REQUIRED, "origin": cOrigin,;
								"errorDetailedMessage": STR0031})

				self:loadAddressBeneficiary(.T.)
			endif

			BA1->(dbSkip())
		end
		
		BA3->(dbSkip())
	end

return

/*/{Protheus.doc} loadAgreementData
Carrega os dados do endereço do beneficiário na requisição (body).
@type method
@version 12.1.2510
@author gabriel.lakatos 
@since 27/03/2026
/*/
method loadAgreementData() class CadBenefApiProspecting

	local cOrigin := "dadosAcordo" as character

	self:jBody["dadosAcordo"] := JsonObject():new()

	self:setAttribute({"body": self:jBody["dadosAcordo"], "attribute": "indicadorAcordo",;
					   "value": .F., "type": "logical", "required": REQUIRED, "origin": cOrigin,;
					   "errorDetailedMessage": ""})

	self:setAttribute({"body": self:jBody["dadosAcordo"], "attribute": "arquivoAcordo",;
					"value": "", "type": "character", "required": OPTIONAL, "origin": cOrigin,;
					"errorDetailedMessage": ""}, .T.)

return
