Class HealthApiChatService

	Data cGuia as Character
	Data oRest as Object
	Data oJsonReq as Object
	Data oError as Object

	public method New() Constructor
	public method setGuia(cGuia)
	public method setJsonReq(oJsonReq)
	public method procAuditingPut()
	public method setError(nStatus, cCode, cMessage, cDetailedMessage)
	public method getError()
	public method getMensageriaPls()
	public method getJustifications(cRecno)
	public method addItem(oJson, cBbrSeq, cGuia, cDateTime, cMsg, nType, cItmSeq, cProcFull)
	public method getAttachment(cAttachKey,cFil)
	public method setUpdMsg(cChave,cAlias,cSequen)

EndClass

Method New(oRest) Class HealthApiChatService

	self:oRest  := oRest
	self:oError := JsonObject():new()
	self:cGuia  := ''

Return self

Method setGuia(cGuia) class HealthApiChatService
	self:cGuia := cGuia
Return

Method setJsonReq(oJsonReq) class HealthApiChatService
	self:oJsonReq := oJsonReq
Return

Method procAuditingPut() Class HealthApiChatService

	Local lRet   := .T.
	Local oAudit := nil

	B53->(DbSetOrder(1)) //B53_FILIAL+B53_NUMGUI+B53_ORIMOV
	if B53->(DbSeek(xFilial("B53")+self:cGuia))
		if ValType(self:oJsonReq['chatStatus']) == "C"
			Do Case
			Case B53->B53_MSGSTA == '3'
				self:setError(400, 400, 'Falha ao alterar o status da sala', 'A guia informadada ja esta com a sala encerrada')
				lRet := .F.
			Case !self:oJsonReq['chatStatus'] $ '123'
				self:setError(400, 400, 'Falha ao alterar o status da sala', 'Status informado e invalido')
				lRet := .F.
			Otherwise
				oAudit := PLMensCont():new()
				oAudit:setStatB53(self:cGuia,self:oJsonReq['chatStatus'])
				if self:oJsonReq['mensageriaPls']
					lRet := PLSAINTE('','AD', '', '', '', '', self:oJsonReq, .T.)
					if ValType(lRet) == "L" .and. !lRet
						self:setError(400, 400, 'Ação Negada', 'Não existe solicitação do auditor para este procedimento.')
					else
						lRet := .T.
					endif
				endif
				oAudit:destroy()
			EndCase
		endIf
	else
		self:setError(400, 400, 'Guia informada nao encontrada', 'Nao foi encontrada a guia informada no alias B53')
		lRet := .F.
	endIf

Return lRet

Method setError(nStatus, cCode, cMessage, cDetailedMessage) class HealthApiChatService

	Default nStatus  := 400
	Default cCode    := '0002'
	Default cMessage := 'Bad Request'
	Default cDetailedMessage := 'O servidor nao foi capaz de entender a solicitacao'

	self:oError['status'] := nStatus
	self:oError['code'] := cCode
	self:oError['message'] := cMessage
	self:oError['detailedMessage'] := cDetailedMessage

Return

Method getError() class HealthApiChatService
Return self:oError

Method getMensageriaPls(cGuia) Class HealthApiChatService
	local oJson         := JsonObject():new()
	local cDateTime     := ""
	local aData         := {}
	local nRecAtual     := 0
	local cAliasIte     := ""
	local cCodPro       := ""
	local nPosProc      := 0
	local cCodOpe       := ""
	local cCodAno       := ""
	local cCodMes       := ""
	local cCodNum       := ""
	local cProcDesc     := ""
	local cSequen       := ""
	local cCodPad       := ""
	local aTabDup       := PlsBusTerDup(SuperGetMv("MV_TISSCAB", .F. ,"87"))
	local cCodTabTiss   := ""
	local cCodProTiss   := ""
	local lRet          := .T.
	local aRet          := { .T., "" }
	local aItemsRev     := {}
	local nItem         := 0
	local lCanAnswer    := .F.

	oJson['items']      := {}
	oJson['procedures'] := {}

	BBR->(DbSetOrder(1))

	if BBR->(DbSeek(xFilial("BBR") + cGuia))

		While !BBR->(Eof()) .and. BBR->BBR_FILIAL == xFilial("BBR") .and. (BBR->BBR_CODOPE+BBR->BBR_ANOAUT+BBR->BBR_MESAUT+BBR->BBR_NUMAUT) == cGuia

			if BBR->BBR_TPDIRP <> 'P' //Retorna apenas procedimentos marcados como Prestador
				BBR->(DbSkip())
				Loop
			EndIf

			nRecAtual := BBR->(RecNo())
			aData     := self:getJustifications(nRecAtual)
			cCodPro   := AllTrim(BBR->BBR_CODPRO)

			cProcDesc   := ""
			cSequen     := ""
			cCodTabTiss := ""
			cCodProTiss := ""

			cAliasIte := ""
			Do Case
			Case BBR->BBR_ALIMOV == "BE4" ; cAliasIte := "BEJ"
			Case BBR->BBR_ALIMOV == "BEA" ; cAliasIte := "BE2"
			Case BBR->BBR_ALIMOV == "B4A" ; cAliasIte := "B4C"
			Case BBR->BBR_ALIMOV == "B4Q" ; cAliasIte := "BQV"
			EndCase

			if cAliasIte == "BQV" .or. cAliasIte == "BEJ"
				cCodOpe := cAliasIte+"_CODOPE"
				cCodAno := cAliasIte+"_ANOINT"
				cCodMes := cAliasIte+"_MESINT"
				cCodNum := cAliasIte+"_NUMINT"
			else
				cCodOpe := cAliasIte+"_OPEMOV"
				cCodAno := cAliasIte+"_ANOAUT"
				cCodMes := cAliasIte+"_MESAUT"
				cCodNum := cAliasIte+"_NUMAUT"
			endif

			if !Empty(cAliasIte)
				(cAliasIte)->(DbSetOrder(1))

				if (cAliasIte)->(DbSeek(xFilial(cAliasIte) + cGuia))
					While !(cAliasIte)->(Eof()) .and. (cAliasIte)->(&(cAliasIte+"_FILIAL")) == xFilial(cAliasIte) ;
							.and. ( (cAliasIte)->(&(cCodOpe)) + (cAliasIte)->(&(cCodAno)) + ;
							(cAliasIte)->(&(cCodMes)) + (cAliasIte)->(&(cCodNum)) ) == cGuia

						if (cAliasIte)->(&(cAliasIte+"_CODPRO")) == BBR->BBR_CODPRO

							cCodPad := Alltrim((cAliasIte)->(&(cAliasIte+"_CODPAD")))
							cSequen := (cAliasIte)->(&(cAliasIte+"_SEQUEN"))

							cCodTabTiss := PLSGETVINC("BTU_CDTERM", "BR4", .F., "87", cCodPad, .T.)
							cCodProTiss := PLSGETVINC("BTU_CDTERM", "BR8", .F., cCodPad, cCodPad + cCodPro, .F. , aTabDup, @cCodTabTiss, .T.)

							cProcDesc := AllTrim(IIF(!Empty(cCodTabTiss), cCodTabTiss, cCodPad)) + " - " + ;
								AllTrim(IIF(!Empty(cCodProTiss), cCodProTiss, cCodPro)) + " - " + ;
								AllTrim((cAliasIte)->(&(cAliasIte+"_DESPRO")))

							if aScan(oJson['procedures'], {|x| AllTrim(x['code']) == AllTrim(BBR->BBR_CODPRO)}) == 0
								nPosProc := Len(oJson['procedures']) + 1
								aadd(oJson['procedures'], JsonObject():new())

								oJson['procedures'][nPosProc]['sequential']  := cSequen
								oJson['procedures'][nPosProc]['table']       := AllTrim(IIF(!Empty(cCodTabTiss), cCodTabTiss, cCodPad))
								oJson['procedures'][nPosProc]['code']    :=  AllTrim(IIF(!Empty(cCodProTiss), cCodProTiss, cCodPro))
								oJson['procedures'][nPosProc]['description'] :=  AllTrim((cAliasIte)->(&(cAliasIte+"_DESPRO")))
								oJson['procedures'][nPosProc]['hasAttachment'] := self:getAttachment(cGuia+cSequen, cAliasIte)
                                oJson['procedures'][nPosProc]['alias'] := cAliasIte
							endif
							Exit
						endif
						(cAliasIte)->(DbSkip())
					EndDo
				endif
			endif

			cDateTime := SubStr(dtos(BBR->BBR_DTITER), 1, 4) + "-" + ;
				SubStr(dtos(BBR->BBR_DTITER), 5, 2) + "-" + ;
				SubStr(dtos(BBR->BBR_DTITER), 7, 2) + " " + ;
				BBR->BBR_HRITER + ":00.000"

			if BBR->BBR_RESPRE //Indica que aguarda resposta escrita do prestador
				lCanAnswer := Empty(aData[2])
			else //Indica que aguarda envio de anexo do prestador
				lCanAnswer := !BBR->BBR_ANEXAD
			endIf

			if !Empty(aData[1])
				self:addItem(oJson, BBR->BBR_SEQUEN, cGuia, cDateTime, aData[1], iif(Empty(BBR->BBR_RESPRE),3,1),;
					cSequen, cProcDesc, AllTrim(IIF(!Empty(cCodProTiss), cCodProTiss, cCodPro)),;
					nRecAtual, lCanAnswer)
			endif

			if !Empty(aData[2])
				self:addItem(oJson, BBR->BBR_SEQUEN, cGuia, cDateTime, aData[2], 2,;
					cSequen, cProcDesc, AllTrim(IIF(!Empty(cCodProTiss), cCodProTiss, cCodPro)),;
					nRecAtual, lCanAnswer)
			endif

			BBR->(DbSkip())
		EndDo

		//Ordena a ordem dos registros items para o modelo esperado pelo HAT (registros mais recentes primeiro)
		if Len(oJson['items']) > 1
			for nItem := Len(oJson['items']) to 1 step -1
				aadd(aItemsRev, oJson['items'][nItem])
			next
			oJson['items'] := aItemsRev
		endif

		lRet := .T.
		aRet[1] := lRet
		aRet[2] := oJson:toJson()
	else
		self:setError(400, 400, 'Guia nao encontrada', 'Nao encontrada no alias BBR')
		lRet := .F.
		aRet[1] := lRet
		aRet[2] := ""
	endIf

return aRet

Method addItem(oJson, cBbrSeq, cGuia, cDateTime, cMsg, nType, cItmSeq, cProcFull, cCode, nMsgId, lCanAnswer) Class HealthApiChatService
	local nPos := 0
	aadd(oJson['items'], JsonObject():new())
	nPos := Len(oJson['items'])

	oJson['items'][nPos]['id']           := cGuia + AllTrim(cBbrSeq)
	oJson['items'][nPos]['roomId']       := 'PLS'
	oJson['items'][nPos]['creationTime'] := cDateTime
	oJson['items'][nPos]['message']      := cMsg
	oJson['items'][nPos]['type']         := nType
	oJson['items'][nPos]['status']       := 2
	oJson['items'][nPos]['procedure']    := cProcFull     // Label Tabela - Cod - Desc
	oJson['items'][nPos]['code']         := AllTrim(IIF(!Empty(cCode), cCode, ""))
	oJson['items'][nPos]['sequential']   := cItmSeq
	oJson['items'][nPos]['messageId']    := cValToChar(nMsgId)
	oJson['items'][nPos]['allowedAnswer'] := lCanAnswer

	// Atributo type
	// 1 - Pergunta do Auditor aguardando resposta do Prestador
	// 2 - Resposta do Prestador
	// 3 - Mensagem do Prestador solicitando Anexos
Return

method getJustifications(cRecno) class HealthApiChatService

	local cMessage    := ''
	local cResp   := ''

	BBR->(dbgoto(cRecno))
	cMessage := BBR->BBR_OBSERV
	cResp := BBR->BBR_RESPOS

Return { cMessage, cResp }

method getAttachment(cAttachKey,cFil) class HealthApiChatService

	local cSql := ""
	local lRet := .F.

	cSql := " SELECT ACB_CODOBJ, ACB_OBJETO, ACB_DESCRI FROM " + RetSqlName("ACB")
	cSql += " WHERE ACB_FILIAL = '" + xFilial("ACB") + "' "
	cSql += " AND ACB_CODOBJ IN ( "
	cSql += " SELECT AC9_CODOBJ FROM " + RetSqlName("AC9")
	cSql += "   WHERE AC9_CODENT = '" + xFilial( cFil ) + cAttachKey +"' "
	cSql += "   AND D_E_L_E_T_ = ' ' ) "
	cSql += " AND D_E_L_E_T_ = ' ' "

	dbUseArea(.t.,"TOPCONN",tcGenQry(,,cSql),"cAliasAC9",.f.,.t.)

	lRet := !cAliasAC9->(Eof())

	cAliasAC9->(dbCloseArea())

return lRet

method setUpdMsg(cChave,cAlias,cSequen) Class HealthApiChatService

	local cAliasPai := ""
	local lRet      := .F.
	local lIntRespo := .F.
	local cSetorAt  := GetNewPar("MV_SETORAT","00")
	local cMsg      := ''
	local nRecno    := 0

	Do Case
		Case cAlias == "BEJ" ; cAliasPai := "BE4"
		Case cAlias == "BE2" ; cAliasPai := "BEA"
		Case cAlias == "B4C" ; cAliasPai := "B4A"
		Case cAlias == "BQV" ; cAliasPai := "B4Q"
	EndCase

	Begin Transaction

	BBR->(dbSetOrder(1))
	if BBR->(msSeek(xFilial("BBR") + cChave))
		while (BBR->(!Eof()) .AND. BBR->(BBR_FILIAL+BBR_CODOPE+BBR_ANOAUT+BBR_MESAUT+BBR_NUMAUT) == (xFilial("BBR") + cChave))

			if !BBR->BBR_RESPRE .AND. BBR->BBR_SEQPRO == cSequen
				BBR->(RecLock("BBR",.F.))
				BBR->BBR_ANEXAD := .T. //Altero a flag para atualizar todas a interações do procedimento
				//BBR->BBR_TPDIRP := "" //No HAT vamos exibir o historico completo de mensagens
				BBR->(MsUnLock())
			endIf

			if BBR->BBR_RESPRE .And. EMPTY(BBR->BBR_RESPOS) .And. !lIntRespo
				lIntRespo := .T.
			endIf
			BBR->(dbSkip())
		endDo

		if lIntRespo
			cMsg := "Existem interacoes em aberto que necessitam de uma resposta descritiva."
			lRet := .F.
		else
			cMsg := "Anexos confirmados."
			lRet := .T.

            oAudit := PLMensCont():new()
			oAudit:setStatB53(cChave,'1')
            oAudit:destroy()
    
			if(cAliasPai == "BEA")
				BEA->(DbSetOrder(1))
				If BEA->(MsSeek(xFilial("BEA") + cChave))
					nRecno := BEA->(Recno())
					BEA->(RecLock("BEA",.F.))
					BEA->BEA_STTISS := "2" //Altero o status tiss para "em análise"
					BEA->(MsUnLock())
				EndIf
			elseif(cAliasPai == "BE4")
				BE4->(DbSetOrder(2))
				If BE4->(MsSeek(xFilial("BE4") + cChave))
					nRecno := BE4->(Recno())
					BE4->(RecLock("BE4",.F.))
					BE4->BE4_STTISS := "2" //Altero o status tiss para "em análise"
					BE4->(MsUnLock())
				EndIf
			elseif(cAliasPai == "B4A")
				B4A->(DbSetOrder(1))
				If B4A->(MsSeek(xFilial("B4A") + cChave))
					nRecno := B4A->(Recno())
					B4A->(RecLock("B4A",.F.))
					B4A->B4A_STTISS := "2" //Altero o status tiss para "em análise"
					B4A->(MsUnLock())
				EndIf
			elseif(cAliasPai == "B4Q")
				B4Q->(DbSetOrder(1))
				If B4Q->(MsSeek(xFilial("B4Q") + cChave))
					nRecno := B4Q->(Recno())
					B4Q->(RecLock("B4Q",.F.))
					B4Q->B4Q_STTISS := "2" //Altero o status tiss para "em análise"
					B4Q->(MsUnLock())
				EndIf
			endIf

			B53->(dbSetOrder(4)) //B53_FILIAL+B53_ALIMOV+B53_RECMOV
			if B53->(MsSeek(xFilial('B53') + cAliasPai + cValToChar(nRecno)))
				B53->(RecLock("B53",.F.))
				B53->B53_CODDEP := cSetorAt
				B53->(MsUnLock())

				if B53->B53_ALIMOV == "B4Q"
					B4Q->(DbSetOrder(1))
					if B4Q->(MsSeek(xFilial("B4Q")+B53->(B53_NUMGUI)))
						B4Q->(RecLock("B4Q",.F.))
						B4Q->B4Q_STTISS := "2" //altero o status tiss para "em análise"
						B4Q->(MsUnLock())
					endIf
				endif

				//Atualizar tabela de Encaminhamento - B71
				if !empty(cSetorAt)
					PLSICB71(B53->B53_ALIMOV, B53->B53_RECMOV, cSetorAt, "Arquivo enviado com sucesso." )
				endIf
			endIf

		endIf
	else
		cMsg := "Guia informada nao foi encontrada na lista de interacoes."
		lRet := .F.
	endIf

	End Transaction

return {lRet,cMsg}
