#Include 'tlpp-core.th'
#Include 'tlpp-rest.th'
#Include "FWLIBVERSION.CH"

//-------------------------------------------------------------------
/*/{Protheus.doc} health.api.benef.photo.request
Grava a foto do beneficiário no repositório de imagens e atualiza a BTS

@author  Nicole Luna
@version P12
@since   25/11/2025

/*/
//-------------------------------------------------------------------

@Post("/totvshealthplans/v1/beneficiaryElegibility/photo")
function healthPostBenefPhoto()
    local oRequest  := HealthBenefElegPhoto():new(oRest,'BenefElegPhoto')

    if oRequest:valida()
        oRequest:procPost()
    endif 
    
    oRequest:endRequest()

return

class HealthBenefElegPhoto from CenRequest 

    Public Method new()
    Public Method valida()
    Public Method procPost()
    
endClass

Method New(oRest, cApi) class HealthBenefElegPhoto
    _Super:new(oRest,cApi,.t.)
Return self

Method valida() class HealthBenefElegPhoto
Return _Super:checkBody(.t.)

Method procPost() class HealthBenefElegPhoto
    Local nI           := 0
    Local oImgRepo     := FWBmpRep():New()
    Local cFilePath    := ''
    Local nIndexFile   := 0
    Local nIndexData   := 0
    Local cMatVid      := ''
    Local oBenfElegDao := PLSBenefElegDao():New()

    //Valida se os campos obrigatórios foram enviados
    If Len(self:jRequest["Elements"]) == 0 .OR.; 
       aScan( self:jRequest["Elements"], { |e| Upper(e["Name"]) == "FILES" } ) == 0 .OR.; 
       aScan( self:jRequest["Elements"], { |e| Upper(e["Name"]) == "DATA" } ) == 0 
        self:lSuccess       := .F.
        self:nFault         := 400
        self:nStatus        := 400
        self:cFaultDesc     := "Corpo da requisição inválido!"
        self:cFaultDetail   := "Obrigatórios: 'files' e 'data'"
    else 
        For nI := 1 To Len(self:jRequest["Elements"])
            If Upper(self:jRequest["Elements"][nI]["Name"]) == "FILES"
                nIndexFile := nI
                Loop
            EndIf

            If Upper(self:jRequest["Elements"][nI]["Name"]) == "DATA"
                nIndexData := nI
                Loop
            EndIf
        Next 

        cMatVid := self:jRequest["Elements"][nIndexData]['Value']
        cMatVid := StrTran(cMatVid, '"', "")
        BTS->(DbSetOrder(1))
		if BTS->(DbSeek(xFilial()+cMatVid))
            oImgRepo:OpenRepository()

            if oImgRepo:ExistBmp(cMatVid)
                oImgRepo:DeleteBmp(cMatVid)
            endif 

            cFilePath := StrTran(StrTran(SubStr(self:jrequest['Elements'][nIndexFile]['UploadDir'], At("protheus_data", self:jrequest['Elements'][nIndexFile]['UploadDir']) + Len("protheus_data")), "./", ""), "/", "\") + self:jrequest['Elements'][nIndexFile]['UploadName']
            oImgRepo:InsertBmp(cFilePath, cMatVid, @self:lSuccess)

            self:lSuccess := oImgRepo:ExistBmp(cMatVid)
            self:cFaultDesc     := iif(!self:lSuccess, "Não foi possível salvar a imagem para o beneficiário!", '')
            self:cFaultDetail   := iif(!self:lSuccess, "Ocorreu um ao salvar a imagem no repositório!", '') 
            
            if self:lSuccess
                BTS->( RecLock("BTS",.F.) )
			    BTS->BTS_BITMAP := cMatVid	            	
			    BTS->( MsUnLock() ) 

                self:oRespBody['base64BenefImage'] := oBenfElegDao:searchPhotoByLifeRecord(.T.)	
            endif              
        else 
            self:lSuccess       := .F.
            self:cFaultDesc     := "Beneficiário não encontrado!"
            self:cFaultDetail   := "Não foi possível localizar o beneficiário pelo código da vida informado (BTS_MATVID)!"
        endif 
       
        if !self:lSuccess
            self:nFault         := 400
            self:nStatus        := 400
        endif

        self:cResponse := self:oRespBody:tojson()

    Endif 

    FreeObj(oImgRepo)
    oImgRepo := nil

    FreeObj(oBenfElegDao)
    oBenfElegDao := nil

Return 
