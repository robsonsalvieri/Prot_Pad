#INCLUDE "TOTVS.CH"

#Define DBFIELD 1
#Define JSONFIELD 2

//Tipo de guias PLS
#DEFINE G_SOL_INTER "03"
#DEFINE SQLSERVER "MSSQL"
#DEFINE ORACLE "ORACLE"
#DEFINE POSTGRES "POSTGRES"

Class HealthApiAuthorizationsDao from CenDao

    Data cTipGui as Character
    Data cQtdRowPage as Character
    Data cGrvTAE as Character
    Data lOculSer as Logical
    Data dDataLim as Date

    public method New(aFields) Constructor
    public method get(cCodRda)
    public method hasNext(nRecno)
    public method loadOrder()
    public method getWhere()
    public method getAliasQry(jRequest,cAlias) 
    public method endQuery()

EndClass

//------------------------------------------------------------------------------------------
/*/{Protheus.doc} New
    Construtor

@type  Class
@author Lucas Nonato
@since 01/03/2020
/*/
//------------------------------------------------------------------------------------------
Method New(aFields) Class HealthApiAuthorizationsDao
	_Super:New(aFields)
    self:cfieldOrder := "BEA.R_E_C_N_O_ DESC"
    self:cAlias      := "BEAQRY"  
    self:cTipGui     := ""
    self:cRowName    := iif(Upper(self:cDB) == POSTGRES,"ROW_NUM","ROW#")
    self:cQtdRowPage := ""
    self:cGrvTAE     := GetNewPar("MV_PLTPTAE", '')
    self:lOculSer    := GetNewPar("MV_PLDTSER", .F.)
    self:dDataLim    := Ctod(GetNewPar("MV_PLDTFAT", ""))
    self:loadOrder()    
Return self

//-------------------------------------------------------------------
/*/{Protheus.doc} get
Query que retorna todos os customers

@author    Lucas Nonato
@version   V12
@since     01/03/2021
/*/
Method get(jRequest) Class HealthApiAuthorizationsDao

local cSql      := ""

local lPendMsg  := !empty(cvaltochar(jRequest['filterOnlyPendentMessenger']))
local nX        := 0
local aParam    := {}
local oObj      := nil
local lIntern   := .T.
local lMensageriaPls := !empty(cvaltochar(jRequest['mensageriaPls']))

self:cQtdRowPage := cValToChar((val(self:cPageSize) * val(self:cNumPage)) + 1)

if lPendMsg .or. lMensageriaPls
    self:cAlias := "B53QRY"
endif 

//Separar o TIPGUI
if !empty(cvaltochar(jRequest['authorizationType']))
    aParam := Strtokarr2( jRequest['authorizationType'],',')
    oObj := PLSProcAuthDao():new('',nil)    
    for nX := 1 to len(aParam)
        self:cTipGui += "'"+iif(aParam[nX]=='9','13',oObj:guideType(aParam[nX]))+"',"
    next
endIf

lIntern := empty(self:cTipGui) .Or. G_SOL_INTER $ self:cTipGui

cSql += " WITH GUIASQRY AS ( "
cSql += " SELECT * FROM ( SELECT " + self:getAliasQry(jRequest,"BEA") + " ) BEAQRY "

//Query BE4 se necessario
if lIntern
    cSql += " UNION "
    cSql += " SELECT * FROM ( SELECT " + self:getAliasQry(jRequest,"BE4") + " ) BE4QRY "
endIf
cSql += self:endQuery()

if existBlock("PLAUTLI1")
    cSql := execBlock("PLAUTLI1",.F.,.F.,{ cSql, jRequest, self:cGrvTAE, self:lOculSer, self:dDataLim } )
endIf

self:setQuery(self:queryBuilder(cSql))
lFound := self:executaQuery()
return lFound


//------------------------------------------------------------------------------------------
/*/{Protheus.doc} getAliasQry
 Retorna as querys separadas por Alias BEA e BE4
@type  Class
@since 01/03/2020
/*/
//------------------------------------------------------------------------------------------
Method getAliasQry(jRequest,cAlias) Class HealthApiAuthorizationsDao

    Local cSql := ""
    local lPendMsg  := !empty(cvaltochar(jRequest['filterOnlyPendentMessenger']))
    local cSubstr   := iif(upper(TCGetDB()) $ "ORACLE|DB2|POSTGRES|INFORMIX", "SUBSTR", "SUBSTRING")
    local lUsesBCI  := (!empty(cvaltochar(jRequest['procPegTransfer'])) .And. cvaltochar(jRequest['procPegTransfer']) == "1") .Or. ;
                       (!empty(cvaltochar(jRequest['billingHAT'])) .And. cvaltochar(jRequest['billingHAT']) == "1")
    local lMensageriaPls := !empty(cvaltochar(jRequest['mensageriaPls']))
    local cConcat := Iif(AllTrim(TcGetDB()) $ "DB2/ORACLE/POSTGRES","||","+")
    Local cAssinatura := cValToChar(jRequest['assinaturaEletronica']) as character
    Local cStatusIn   := "" as character
    default cAlias := "BEA"

    //Seleciona top de registros SQL Server
    cSql += iif(Upper(self:cDB) == SQLSERVER," TOP " + self:cQtdRowPage,"")

    cSql += " BEA.R_E_C_N_O_, BEA.BEA_OPEMOV, BEA.BEA_ANOAUT, BEA.BEA_MESAUT, BEA.BEA_NUMAUT, BEA.BEA_OPEUSR, BEA.BEA_CODEMP, BEA.BEA_MATRIC, " 
    cSql += " BEA.BEA_TIPREG, BEA.BEA_DIGITO, BEA.BEA_DATSOL, BEA.BEA_STATUS ,BEA.BEA_TIPGUI, BEA.BEA_NOMUSR, BEA.BEA_NOMSOC, BEA.BEA_VALSEN, "
    cSql += " BEA.BEA_DATPRO, BEA.BEA_CANCEL, BEA.BEA_LIBERA, BEA.BEA_CODRDA, BEA.BEA_SENHA,  BEA.BEA_NRLBOR,"
    cSql += " BE4.BE4_DIASIN, BE4.BE4_CODRDA, BE4.BE4_PRVINT, BE4.BE4_DTALTA, BE4.BE4_HRALTA, BE4.BE4_DATPRO, BE4.BE4_HORPRO, BE4.BE4_SENHA, "
    cSql += " BE4.BE4_DATVAL, BE4.BE4_FASE, "
    
    cSql += " BD5.BD5_FASE "

    if !empty(cAssinatura)
        cSql += ", BQ6_FILTERED.BQ6_STATUS "
    else
        cSql += " , '' AS BQ6_STATUS "
    endIf

    if lMensageriaPls
        cSql += ", B53_MSGSTA "
    else
        cSql += " , '' AS B53_MSGSTA "
    endIf

    if self:lOculSer
        cSql += " , CASE "
        cSql += " WHEN EXISTS ( "
        cSql += "     SELECT 1 "
        cSql += "     FROM " + RetSqlName("BE2") + " BE2"
        cSql += "     INNER JOIN " + RetSqlName("BR8") + " BR8"
        cSql += "     ON BR8_FILIAL = '"  + xFilial("BR8") + "' "
        cSql += "     	AND BR8_CODPAD = BE2_CODPAD "
        cSql += "     	AND BR8_CODPSA = BE2_CODPRO "
        cSql += "     	AND BR8.D_E_L_E_T_ = ' ' "
        cSql += "     INNER JOIN " + RetSqlName("BJE") + " BJE"
        cSql += "     ON BJE_FILIAL = '"  + xFilial("BJE") + "' "
        cSql += "     	AND BJE_CODIGO = BR8_CLASSE "
        cSql += "     	AND BJE_TIPO = '2' "
        cSql += "     	AND BJE.D_E_L_E_T_ = ' ' "
        cSql += "     WHERE BE2_FILIAL = '"  + xFilial("BE2")+ "' "
        cSql += "       AND BE2_OPEMOV = BEA_OPEMOV "
        cSql += "       AND BE2_ANOAUT = BEA_ANOAUT "
        cSql += "       AND BE2_MESAUT = BEA_MESAUT "
        cSql += "       AND BE2_NUMAUT = BEA_NUMAUT "
        cSql += "       AND BE2.D_E_L_E_T_ = ' ' "
        cSql += " ) THEN 1 "
        cSql += "   ELSE 0 "
        cSql += " END AS TEMBJE "
    else
        cSql += " , 0 AS TEMBJE "
    endif

    cSql += " FROM " + iif(lPendMsg .and. !lMensageriaPls, RetSqlName('B53') + ' B53 ', RetSqlName('BEA') + ' BEA ')

    // Especifico guias pendentes do Chat
    if lPendMsg .and. !lMensageriaPls
        cSql += " LEFT JOIN " + RetSqlName("BEA") + " BEA"
        cSql += " ON BEA_FILIAL = '"  + xFilial("BEA")+ "' "
        cSql += " AND " + cSubstr + "(B53_NUMGUI, 1, 4) = BEA.BEA_OPEMOV "
        cSql += " AND " + cSubstr + "(B53_NUMGUI, 5, 4) = BEA.BEA_ANOAUT "
        cSql += " AND " + cSubstr + "(B53_NUMGUI, 9, 2) = BEA.BEA_MESAUT "
        cSql += " AND " + cSubstr + "(B53_NUMGUI, 11, 8) = BEA.BEA_NUMAUT "
        cSql += " AND BEA.BEA_OPERDA = '" + plsintpad() + "' "
        cSql += " AND BEA.BEA_TIPGUI NOT IN ('11') "
        cSql += " AND BEA.BEA_CODRDA = '" + jRequest['healthProvider'] + "' "
        cSql += " AND BEA.D_E_L_E_T_ = ' ' "
    endif

    if lMensageriaPls
        cSql += " LEFT JOIN " + RetSqlName("B53") + " B53"
        cSql += " ON BEA_FILIAL = '"  + xFilial("B53")+ "' "
        cSql += " AND B53.B53_NUMGUI = BEA.BEA_OPEMOV " + cConcat + " BEA.BEA_ANOAUT " + cConcat + " BEA.BEA_MESAUT " + cConcat + " BEA.BEA_NUMAUT "
        cSql += " AND B53.B53_CODOPE = '" + plsintpad() + "' "
        cSql += " AND B53.B53_CODRDA = '" + jRequest['healthProvider'] + "' "
        cSql += " AND B53.D_E_L_E_T_ = ' ' "
    endif

    // Join BE4
    cSql += " LEFT JOIN " + RetSqlName("BE4") + " BE4"
    cSql += " ON BE4.BE4_FILIAL = '"  + xFilial("BE4")+ "' "
    cSql += " AND BEA.BEA_OPEMOV = BE4.BE4_CODOPE "
    cSql += " AND BEA.BEA_ANOAUT = BE4.BE4_ANOINT "
    cSql += " AND BEA.BEA_MESAUT = BE4.BE4_MESINT "
    cSql += " AND BEA.BEA_NUMAUT = BE4.BE4_NUMINT "
    cSql += iif(lPendMsg, " AND BE4.BE4_CODRDA = '" + jRequest['healthProvider'] + "' ", "")
    cSql += " AND BE4.D_E_L_E_T_ = ' ' "

    // Join BCI
    if lUsesBCI
        cSql += " LEFT JOIN " + RetSqlName("BCI") + " BCI"
        cSql += " ON BCI_FILIAL = '"  + xFilial("BCI") + "' "
        cSql += " 	AND BEA.BEA_CODPEG = BCI.BCI_CODPEG "
        cSql += " 	AND BCI.D_E_L_E_T_ = ' ' "
    endIf

    // Join BD5
    cSql += " LEFT JOIN " + RetSqlName("BD5") + " BD5"
    cSql += " ON BD5.BD5_FILIAL = '"  + xFilial("BD5") + "' "
    cSql += " 	AND BEA.BEA_OPEMOV = BD5.BD5_OPEMOV "
    cSql += " 	AND BEA.BEA_ANOAUT = BD5.BD5_ANOAUT "
    cSql += " 	AND BEA.BEA_MESAUT = BD5.BD5_MESAUT "
    cSql += " 	AND BEA.BEA_NUMAUT = BD5.BD5_NUMAUT "
    cSql += " 	AND BD5.D_E_L_E_T_ = ' ' "

    // Especifico para o TAE
    if (!empty(cvaltochar(jRequest['billingHAT'])) .or. !empty(cAssinatura))  .and. !empty(self:cGrvTAE)
        cSql += " LEFT JOIN ( "
        cSql += "     SELECT BQ6.BQ6_NUMGUI, BQ6.BQ6_STATUS "
        cSql += "     FROM " + RetSqlName("BQ6") + " BQ6"
        cSql += "     WHERE BQ6.BQ6_FILIAL = '"  + xFilial("BQ6")+ "' "
        cSql += "     AND BQ6.BQ6_TPSIGN = '1' "
        cSql += "     AND BQ6.D_E_L_E_T_ = ' ' "
        cSql += " ) BQ6_FILTERED ON "
        cSql += "     BEA.BEA_OPEMOV = "+cSubstr+"(BQ6_FILTERED.BQ6_NUMGUI, 1, 4) "
        cSql += " AND BEA.BEA_ANOAUT = "+cSubstr+"(BQ6_FILTERED.BQ6_NUMGUI, 5, 4) "
        cSql += " AND BEA.BEA_MESAUT = "+cSubstr+"(BQ6_FILTERED.BQ6_NUMGUI, 9, 2) "
        cSql += " AND BEA.BEA_NUMAUT = "+cSubstr+"(BQ6_FILTERED.BQ6_NUMGUI, 11, 8) "
    endif

    // Especifico guias pendentes do Chat
    if lPendMsg
        cSql += " LEFT JOIN ( "
        cSql += " SELECT GUIAREF FROM ( "
        cSql += " SELECT B4A_GUIREF AS GUIAREF FROM " + RetSqlName("B53") + " B53 "
        cSql += "   INNER JOIN " + RetSqlName("B4A") + " B4A "
        cSql += "       ON B4A_FILIAL = '" + xFilial('B4A') + "' "
        cSql += "       AND B4A_OPEMOV = "+cSubstr+"(B53_NUMGUI, 1, 4) "
        cSql += "       AND B4A_ANOAUT = "+cSubstr+"(B53_NUMGUI, 5, 4) "
        cSql += "       AND B4A_MESAUT = "+cSubstr+"(B53_NUMGUI, 9, 2) "
        cSql += "       AND B4A_NUMAUT = "+cSubstr+"(B53_NUMGUI, 11, 8) "
        cSql += "       AND B4A.D_E_L_E_T_ = ' ' "
        cSql += " 	WHERE B53_FILIAL = '" + xFilial('B53') + "' "
        cSql += " 	    AND B53_ALIMOV NOT IN ('BEA','BE4') "
        cSql += " 	    AND B53_MSGSTA = '2' "
        cSql += " 		AND B53.D_E_L_E_T_ = ' ' "
        
        cSql += " UNION ALL "
        cSql += " SELECT B4Q_GUIREF AS GUIAREF FROM " + RetSqlName("B53") + " B53 "
        cSql += "   INNER JOIN " + RetSqlName("B4Q") + " B4Q "
        cSql += "       ON B4Q_FILIAL = '" + xFilial('B4Q') + "' "
        cSql += "       AND B4Q_OPEMOV = "+cSubstr+"(B53_NUMGUI, 1, 4) "
        cSql += "       AND B4Q_ANOAUT = "+cSubstr+"(B53_NUMGUI, 5, 4) "
        cSql += "       AND B4Q_MESAUT = "+cSubstr+"(B53_NUMGUI, 9, 2) "
        cSql += "       AND B4Q_NUMAUT = "+cSubstr+"(B53_NUMGUI, 11, 8) "
        cSql += "       AND B4Q.D_E_L_E_T_ = ' ' "
        cSql += " 	WHERE B53_FILIAL = '" + xFilial('B53') + "' "
        cSql += " 	    AND B53_ALIMOV NOT IN ('BEA','BE4') "
        cSql += " 	    AND B53_MSGSTA = '2' "
        cSql += " 		AND B53.D_E_L_E_T_ = ' ' "
        cSql += " ) AS QRYAUX "
        cSql += " GROUP BY GUIAREF "

        cSql += " ) AS GUIAREFERENCIA "
        cSql += "   ON BEA_FILIAL = '" + xFilial('BEA') + "' "
        cSql += "   AND BEA_OPEMOV = "+cSubstr+"(GUIAREFERENCIA.GUIAREF, 1, 4) "
        cSql += "   AND BEA_ANOAUT = "+cSubstr+"(GUIAREFERENCIA.GUIAREF, 5, 4) "
        cSql += "   AND BEA_MESAUT = "+cSubstr+"(GUIAREFERENCIA.GUIAREF, 9, 2) "
        cSql += "   AND BEA_NUMAUT = "+cSubstr+"(GUIAREFERENCIA.GUIAREF, 11, 8) "
    endIf

    // Especifico guias pendentes do Chat
    if lPendMsg
        cSql += " WHERE B53_FILIAL = '" + xFilial('B53') + "' "
        cSql += " 	    AND B53_MSGSTA = '2' "
        cSql += " AND B53_CODRDA = '" + jRequest['healthProvider'] + "' "
        cSql += " AND B53.D_E_L_E_T_ = ' ' "

    // Filtro padrao
    else 
        cSql += " WHERE BEA_FILIAL = '" + xFilial('BEA') + "' "
        cSql += " AND BEA_OPERDA = '" + plsintpad() + "' "
        cSql += " AND " + iif(cAlias == "BE4","BE4_RDACON","BEA_CODRDA") + " = '" + jRequest['healthProvider'] + "' "
        cSql += " AND BEA_TIPGUI NOT IN ('11') "
        cSql += " AND BEA.D_E_L_E_T_ = ' ' "
    endif 

    if (!empty(cvaltochar(jRequest['billingHAT'])).or.!empty(cAssinatura)) .and. !empty(self:cGrvTAE)
        if !empty(cvaltochar(jRequest['billingHAT']))
            cSql += " AND (BQ6_FILTERED.BQ6_NUMGUI IS NULL OR BQ6_FILTERED.BQ6_STATUS = '2') "
        ElseIf !Empty(cAssinatura)
            cStatusIn := "'" + StrTran(cAssinatura, ",", "', '") + "'"

            If "0" $ cAssinatura
                cSql += " AND (BQ6_FILTERED.BQ6_STATUS in (" + cStatusIn + ") OR BQ6_FILTERED.BQ6_STATUS IS NULL) "
            Else
                cSql += " AND BQ6_FILTERED.BQ6_STATUS in (" + cStatusIn + ") "
            EndIf
        endif
    endif

    //Filtro geral
    cSql += iif(lPendMsg,'',self:getWhere(jRequest))

    // Filtros de Faturamento
    if !empty(cvaltochar(jRequest['procPegTransfer'])) .And. cvaltochar(jRequest['procPegTransfer']) == "1"
        cSql += " AND BCI.BCI_LOTHAT = '1' "
    elseIf !empty(cvaltochar(jRequest['billingHAT'])) .And. cvaltochar(jRequest['billingHAT']) == "1"
        cSql += " AND BCI.BCI_LOTHAT <> '1' "
    endIf

    //Criacao do parametro MV_PLDTFAT, para ser a data de inicio de busca de guias no faturamento
    if !empty(self:dDataLim) .AND. !empty(cvaltochar(jRequest['billingHAT'])) .And. ;
        cvaltochar(jRequest['billingHAT']) == "1" .AND. empty(cvaltochar(jRequest['batchCode']))

        cSql += " AND BEA_DATPRO >= '" + DTOS(self:dDataLim) + "' "
    endif

    cSql += " ORDER BY BEA.R_E_C_N_O_ DESC "

    //Seleciona top de registros Oracle
    cSql += iif(Upper(self:cDB) == ORACLE," FETCH FIRST " + self:cQtdRowPage + " ROWS ONLY","")
    
    //Seleciona top de registros Postgres
    cSql += iif(Upper(self:cDB) == POSTGRES," LIMIT " + self:cQtdRowPage,"")

Return cSql


Method endQuery() Class HealthApiAuthorizationsDao

    Local cSql := ""
    Local cNumIni := alltrim(str((val(self:cNumPage ) - 1) * val(self:cPageSize)))
	Local cNumFim := alltrim(str(((val(self:cNumPage )) * val(self:cPageSize)) + 1))

    cSql += " ) SELECT * FROM ( "
    cSql += " 	SELECT ROW_NUMBER() OVER (ORDER BY R_E_C_N_O_ DESC) AS "+self:cRowName+", "
    cSql += "     QRYFINAL.* FROM GUIASQRY QRYFINAL "
    cSql += " ) QRYSQL "
    cSql += " WHERE "+self:cRowName+" > " +cNumIni
    cSql += " AND "+self:cRowName+" <= " + cNumFim

Return cSql

//------------------------------------------------------------------------------------------
/*/{Protheus.doc} getWhere

@type  Class
@author Lucas Nonato
@since 01/03/2020
/*/
//------------------------------------------------------------------------------------------
Method getWhere(jRequest) Class HealthApiAuthorizationsDao
local cStatus       := ''
local cCancel       := ''
local cSql          := ''
local nX            := 1
local aParam        := 1

if !empty(cvaltochar(jRequest['authorizationStatus']))
    aParam := Strtokarr2( jRequest['authorizationStatus'],',')
    for nX:=1 to len(aParam)
        if aParam[nX] == 'C'
            cCancel = '1'
        else
            cStatus += "'"+aParam[nX]+"',"
        endif
    next

    cSql += ' AND ( ' 
    cSql += iif(!empty(cStatus), 'BEA_STATUS IN (' +substr(cStatus,1,len(cStatus)-1)+ ") ", "")
    cSql += iif(!empty(cStatus) .and. !empty(cCancel), ' OR ', '')
    cSql += iif(!empty(cCancel), "BEA_CANCEL = '1' ", "")
    cSql += ' ) '
endif

if !empty(self:cTipGui)
    cSql += ' AND BEA_TIPGUI IN (' +substr(self:cTipGui,1,len(self:cTipGui)-1)+ ")"
endif

if !empty(cvaltochar(jRequest['idOnHealthInsurer']))
    cSql += " AND BEA_OPEMOV = '"+substr(jRequest['idOnHealthInsurer'],1,4)+"' "
	cSql += " AND BEA_ANOAUT = '"+substr(jRequest['idOnHealthInsurer'],5,4)+"' "
	cSql += " AND BEA_MESAUT = '"+substr(jRequest['idOnHealthInsurer'],9,2)+"' "
	cSql += " AND BEA_NUMAUT = '"+substr(jRequest['idOnHealthInsurer'],11,8)+"' "
endif

if !empty(cvaltochar(jRequest['subscriberId']))
    cSql += "   AND BEA_OPEUSR = '" + substr(jRequest['subscriberId'],1,4 ) + "' "
	cSql += "   AND BEA_CODEMP = '" + substr(jRequest['subscriberId'],5,4 ) + "' "
	cSql += "   AND BEA_MATRIC = '" + substr(jRequest['subscriberId'],9,6 ) + "' "
	cSql += "   AND BEA_TIPREG = '" + substr(jRequest['subscriberId'],15,2) + "' "
	cSql += "   AND BEA_DIGITO = '" + substr(jRequest['subscriberId'],17,1) + "' "
endif

if !empty(cvaltochar(jRequest['dateFrom']))
    cSql += " AND BEA_DATPRO >= '" + strtran(cvaltochar(jRequest['dateFrom']),'-','') + "' "
endif

if !empty(cvaltochar(jRequest['dateTo']))
    cSql += " AND BEA_DATPRO <= '" + strtran(cvaltochar(jRequest['dateTo']),'-','') + "' "
endif

if !empty(cvaltochar(jRequest['locationCode']))
    cSql += " AND BEA_CODLOC = '" + jRequest['locationCode'] + "' "
endif

if !empty(cvaltochar(jRequest['attendanceLocation']))
    cSql += " AND BEA_LOCAL = '" + jRequest['attendanceLocation'] + "' "
endif

if !empty(cvaltochar(jRequest['password']))
    cSql += " AND (BEA_SENHA = '" + jRequest['password'] + "' OR  BE4_SENHA = '" + jRequest['password'] + "') "   
endif

if !empty(cvaltochar(jRequest['beneficiaryCPF']))
    cSql += " AND BEA_CPFUSR = '" + strtran(strtran(cvaltochar(jRequest['beneficiaryCPF']),'.',''),'-','') + "' "
endif

if !empty(cvaltochar(jRequest['hospitalizationDate']))
    cSql += " AND BE4_DATPRO = '" + strtran(cvaltochar(jRequest['hospitalizationDate']),'-','') + "' "
endif

if !empty(cvaltochar(jRequest['dischargedDate']))
    cSql += " AND BE4_DTALTA = '" + strtran(cvaltochar(jRequest['dischargedDate']),'-','') + "' "
endif

if !empty(cvaltochar(jRequest['oldRegistration']))
    cSql += " AND BEA_MATANT = '" + jRequest['oldRegistration'] + "' "
endif

if !empty(cvaltochar(jRequest['billingHAT']))
    cSql += " AND BEA_CODPEG <> ' ' "
    cSql += " AND BEA_LIBERA <> '1' "
    if !empty(cvaltochar(jRequest['batchCode']))
        cSql += " AND BEA_LOTHAT = '" + jRequest['batchCode'] + "' "
    else 
        cSql += " AND BEA_LOTHAT = ' ' "
    endif
endif

Return cSql


//------------------------------------------------------------------------------------------
/*/{Protheus.doc} hasNext
    hasNext especifico

@type  Class
@author Lucas Nonato
@since 01/03/2020
/*/
//------------------------------------------------------------------------------------------
Method hasNext(nRecno) Class HealthApiAuthorizationsDao
    Local lTemProx := .F.
    If self:aliasSelected()
        lTemProx := !(self:getAliasTemp())->(Eof())
    EndIf
return lTemProx

//------------------------------------------------------------------------------------------
/*/{Protheus.doc} loadOrder
    Adicona campos para ordenacao

@type  Class
@author Lucas Nonato
@since 01/03/2020
/*/
//------------------------------------------------------------------------------------------
Method loadOrder() Class HealthApiAuthorizationsDao

    self:oHashOrder:set("idOnHealthInsurer",   "BEA_OPEMOV+BEA_ANOAUT+BEA_MESAUT+BEA_NUMAUT")

Return
