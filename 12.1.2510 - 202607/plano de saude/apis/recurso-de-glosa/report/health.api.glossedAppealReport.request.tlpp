#Include "PROTHEUS.CH"
#Include "TOTVS.CH"
#Include 'tlpp-core.th'
#Include 'tlpp-rest.th'
#Include "FWLIBVERSION.CH"

//-------------------------------------------------------------------
/*/{Protheus.doc} HealthApiGlossedAppealReportRequest
.
@author  Sakai
@version P12
@since   02/02/2026
/*/
//-------------------------------------------------------------------
Class HealthApiGlossedAppealReportRequest from CenRequest

    data oSvc as Object
    public method New(oRest,cSvcName) Constructor
    public method destroy()

    public method valida()
    public method processa()
    public method setError()
    public method buscaProtocolo()

EndClass

Method New(oRest, cSvcName) Class HealthApiGlossedAppealReportRequest
    _Super:New(oRest,cSvcName)
    self:oSvc := HealthApiGlossedAppealReportService():New(oRest)
Return self

Method destroy()  Class HealthApiGlossedAppealReportRequest
    _Super:destroy()
Return 

Method valida() Class HealthApiGlossedAppealReportRequest

    local cFaultDesc   := ""
    local cFaultDetail := ""
    Local lVirgula     := .F.
    local lRet := .T.
    
    if empty(self:oRest:appealProtocol)
        cFaultDesc   := "Atributos obrigatorios nao informados: "
        cFaultDetail += iif(lVirgula,",","")
        cFaultDetail += " appealProtocol "
        lRet     := .F.
        lVirgula := .T.
    endif

    if empty(self:oRest:healthProviderCode)
        cFaultDesc   := "Atributos obrigatorios nao informados: "
        cFaultDetail += iif(lVirgula,",","")
        cFaultDetail += " healthProviderCode "
        lRet     := .F.
        lVirgula := .T.
    endif

    if !lRet
        self:setError(400,400,cFaultDesc,cFaultDetail)
    endIf

Return self:lSuccess

Method buscaProtocolo() Class HealthApiGlossedAppealReportRequest

    if self:lSuccess
        if !self:oSvc:buscaProtocolo()
            self:setError(400,400,'Solicitacao nao processada','Protocolo informado nos atributos appealProtocole e healthProviderCode nao encontrado')
        endIf
    endIf

Return self:lSuccess

Method processa() Class HealthApiGlossedAppealReportRequest

    local aRet := {}

    if self:lSuccess
        aRet := self:oSvc:processa()
        if aRet[1]
            self:cResponse := aRet[2,1]:toJson()
            self:nStatus   := aRet[2,2]
        else
            self:setError(400,400,'Solicitacao nao processada','Nao foram encontrados eventos para o protocolo solicitado.')
        endIf
    endIf

Return self:lSuccess

method setError(nFault,nStatus,cFaultDesc,cFaultDefault) Class HealthApiGlossedAppealReportRequest
    
    self:nFault       := 400
    self:nStatus      := 400
    self:cFaultDesc   := cFaultDesc
    self:cFaultDetail := cFaultDefault
    self:lSuccess     := .F.

return
