#include "tlpp-core.th"
#include "tlpp-rest.th"

namespace totvs.protheus.health.plan.api.portal.config

using namespace totvs.protheus.health.plan.api.util

/*/{Protheus.doc} ManifestController
Classe responsável por controlar o endpoint de manifesto do portal de planos de saúde.
@type class
@version 12.1.2610
@author vinicius.queiros
@since 03/03/2026
*/
class ManifestController from BaseController

    public method new() constructor
    public method destroy()

    @GET("/totvsHealthPlans/portal/v1/manifest")
    public method apiGetManifest()

endclass

/*/{Protheus.doc} new
Construtor da classe ManifestController. Inicializa a instância do controller.
@type method
@version 12.1.2610
@author vinicius.queiros
@since 03/03/2026
@return object, Instância inicializada do controller
*/
method new() class ManifestController

    _Super:new()

return self

/*/{Protheus.doc} destroy
Destrutor da classe ManifestController. Libera recursos utilizados pela instância.
@type method
@version 12.1.2610
@author vinicius.queiros
@since 03/03/2026
*/
method destroy() class ManifestController

    _Super:destroy()

return

/*/{Protheus.doc} apiGetManifest
Executa o endpoint GET para retornar o manifesto de configuração do portal de planos de saúde.
@type method
@version 12.1.2610
@author vinicius.queiros
@since 03/03/2026
*/
method apiGetManifest() class ManifestController

    local jParams := oRest:getQueryRequest() as json
    local oService as object

    oService := ManifestService():new()

    if self:validateRequiredParams(jParams, {"typePortal"})
        oService:setQueryParams(jParams)

        if oService:getManifest()
            oRest:setResponse(oService:getJsonResult())
        else
            oRest:setFault(oService:getJsonResult())
        endif
    endif

    oRest:setStatusCode(oService:getStatusCode())
    oRest:setKeyHeaderResponse("Content-Type", "application/manifest+json; charset=utf-8")

    oService:destroy()
    self:destroy()

    freeObj(jParams)
    freeObj(oService)

return
