#include "tlpp-core.th"
#include "tlpp-rest.th"

namespace totvs.protheus.health.plan.api.portal.access

using namespace totvs.protheus.health.plan.api.util

/*/{Protheus.doc} ProductController
Classe controladora das APIs de Planos de Saúde
@type class
@version 12.1.2510
@author luca.spiller   
@since 05/11/2025
/*/
class ProductController from BaseController

	public method new() constructor

    @GET("/totvsHealthPlans/portal/v1/healthProductsBeneficiary/:subscriberId")
	public method apiGetHealthProducts()

endclass

/*/{Protheus.doc} new
Construtor da classe ProductController. Inicializa os atributos e configurações necessárias para o controle de Planos de Saúde.
@type method
@version 12.1.2510
@author luca.spiller
@since 05/11/2025
/*/
method new() class ProductController

	_Super:new()

return self

/*/{Protheus.doc} apiGetHealthProducts
Método responsável por retornar os planos de saúde
@type method
@version 12.1.2510
@author luca.spiller
@since 06/11/2025
/*/
method apiGetHealthProducts() class ProductController

	local oController as object

	if self:validateRequiredParams(oRest:getPathParamsRequest(), {"subscriberId"})	
		if self:validatePortalUserAccess() .and. self:hasAccessToBeneficiary(oRest:getPathParamsRequest()["subscriberId"])
			oController := totvs.protheus.health.plans.api.attendanceNetwork.healthProduct.healthProductsController():new()
			oController:apiGetHealthProductsBeneficiary()
		endif
	endif

	freeObj(oController)
	self:destroy()

return
