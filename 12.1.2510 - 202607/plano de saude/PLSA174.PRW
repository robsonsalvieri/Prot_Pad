Function PLSA174FISI()

//ฺฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฟ
//ณ Declaracao de Variaveis                                             ณ
//ภฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤู
Local cFiltro
Local aCores := { ;
	{"(nOk := Plsa660Blq()) = 4", 'BR_PRETO'},;
	{"nOk = 3", 'BR_AMARELO'},;
	{".T.", 'BR_VERDE'}}

Private cString := "BG9"
Private cCadastro := "Cadastro de Familias - Pessoa Fisica"
Private aRotina := MenuDef()
PRIVATE aCdCores := { ;
	{'BR_VERDE'  ,'Empresa OK'},;
	{'BR_AMARELO','Familia(s) Bloqueada(s) Parcial(s)'},;
	{'BR_PRETO'  ,'Familia(s) Bloqueada(s)'}}

(cString)->(dbSetOrder(1))
cFiltro := "BG9_FILIAL = '"+xFilial("BG9")+"' AND BG9_TIPO = '1' AND D_E_L_E_T_ = ' '"
(cString)->(DbSeek(xFilial()))

//ฺฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฟ
//ณ Coloca o subcontrato em EOF() por causa dos inicializadores padroes ณ
//ภฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤฤู
BQC->(dbGoto(LastRec()+1))
mBrowse(6, 1, 22, 75, cString,,,,,, aCores,,,,,,,, cFiltro)

Return()

/*/{Protheus.doc} pl260AltSub
Botใo customizado de atalho acionado a partir da rotina de Grupo Familiar (PLSA260). 
A fun็ใo valida o posicionamento do Subcontrato (BQC), e prepara as chaves de 
mem๓ria (variแveis Private cFiltro, cChave e cChaveBQC) para simular o escopo de navega็ใo. 
Em seguida, chama a rotina PLS660Var em modo de Altera็ใo.
@version 12.1.2610
@author iuri.souza
@since 15/06/2026
@return nil/*/

Function pl260AltSub()

    Private cFiltro   
    Private cChave    
    Private cChaveBQC 
    
    BG9->(DbSetOrder(1))
    BG9->(MsSeek(xFilial("BG9") + BQC->BQC_CODIGO))

    BT5->(DbSetOrder(1))
    BT5->(MsSeek(xFilial("BT5") + BQC->BQC_CODIGO + BQC->BQC_NUMCON + BQC->BQC_VERCON))

    cFiltro   := ".T." 
    cChave    := BT5->(BT5_CODINT + BT5_CODIGO + BT5_NUMCON + BT5_VERSAO)
	cChaveBQC := cChave

    FwMsgRun( Nil, {|oWait| PLS660Var("BQC", BQC->(RecNo()), K_Alterar) }, STR0006, STR0007 ) // "Carregando a tela do Subcontrato..." # "Por favor, aguarde."

Return

/*/
