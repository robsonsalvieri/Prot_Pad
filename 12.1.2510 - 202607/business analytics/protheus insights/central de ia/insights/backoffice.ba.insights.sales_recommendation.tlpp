#include 'tlpp-core.th'
#include 'InsightDefs.ch'

REGISTER INSIGHT sales_recommendation

Class sales_recommendation from PinsConfig
	Public Method New() CONSTRUCTOR
	Public Method Config()
	Public Method Struct()
	Public Method FromToMock()
EndClass

Method New() class sales_recommendation
	_Super:New( 'sales_recommendation', 'FAT' )
Return Self

Method Config() class sales_recommendation
    ::SetHasKey( .T. )
	::SetHasFilter( .T. )
	::SetPriority( .T. )

	::SetTagDateFrom("mdmCreated")
	::SetTagDateTo("expirationDate")
    ::SetKey( "key" )
Return


//-------------------------------------------------------------------
/*/{Protheus.doc} Struct
Indica os campos que fazem parte da tabela temporária e como estas 
informações serão tratadas.

A estrutura a ser definida deve ter a seguinte estrutura:
	[1] - nome da propriedade na mensagem ( campo memo da tabela I21 )
	[2] - estrutura de campo da tabela temporária
		[1] - Nome da coluna
		[2] - tipo
		[3] - tamanho
		[4] - decimal
	[3] - Indica se a coluna pode ser usada no filtro de pesquisa
	[4] - Texto apresentado

@author  Marcia Junko
@since   02/06/2025
/*/
//-------------------------------------------------------------------
Method Struct() class sales_recommendation
	Local aStruct := {}

	aStruct := PINC010Fld()
	aStruct := PINSDebugFields( aStruct )

	_Super:SetStruct( aStruct )

Return


//-----------------------------------------------------------------------------------------------------
/*/{Protheus.doc} FromToMock
	Função  que retorna o De/Para Mock estrutura antiga x nova 
	
	@return aPropMock, Array, Propriedades estrutura antiga x nova que devem ser utilizadas no Mock
	O Retorno do De/Para tem a seguinte estrutura:
	[1] - nome da propriedade na estrutura antiga 
	[2] - nome da propriedade na estrutura nova

	@author Victor Vieira 
	@since 02/06/2026
/*/
//-----------------------------------------------------------------------------------------------------
Method FromToMock() class sales_recommendation

	Local aPropMock	as Array
	
	aPropMock	:= {}
	
	aadd(aPropMock, {"cust_nam" 			, "customer_name"				})
	aadd(aPropMock, {"sales_per" 			, "sales_person"				})
	aadd(aPropMock, {"pers_name"			, "sales_person_name"			})	
	aadd(aPropMock, {"descrip"				, "product_description"			})
	aadd(aPropMock, {"prod_grp" 	 		, "product_group" 				})
	aadd(aPropMock, {"grp_desc"  			, "product_group_description"	})
	aadd(aPropMock, {"tpe"					, "product_type" 				})
	aadd(aPropMock, {"tp_desc"				, "product_type_description" 	})
	aadd(aPropMock, {"pot_vl"				, "potential_value" 			})
	aadd(aPropMock, {"type_rec"				, "recommendation_type" 		})
	aadd(aPropMock, {"ctrl_numb"			, "control_number" 				})
	aadd(aPropMock, {"stck_qtt"				, "stock_quantity"				})
	aadd(aPropMock, {"cust_code"			, ""							})
	aadd(aPropMock, {"cust_store"			, ""							})
	aadd(aPropMock, {"key_cust"				, ""							})	
	aadd(aPropMock, {"prod_code"			, ""							})	
	aadd(aPropMock, {"sales_code"			, ""							})	
	aadd(aPropMock, {"order_numb"			, ""							})	
	aadd(aPropMock, {"dt_create"			, ""							})	
	aadd(aPropMock, {"user_gen"				, ""							})	
	aadd(aPropMock, {"dt_discard"			, ""							})	
	aadd(aPropMock, {"user_dsc"				, ""							})	
	aadd(aPropMock, {"reason"				, ""							})	
			
Return aPropMock
