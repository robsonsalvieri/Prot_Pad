#INCLUDE 'totvs.ch'
#INCLUDE 'tlpp-core.th'
#INCLUDE 'backoffice.ba.dta.dtaflowreq.ch'

//----------------------------------------------------------
/*/{Protheus.doc} SendDtaFlowResponse
    Envia requisição para SmartLink DTA

    @param aParams, Array, Parametros da requisição

    @return lSucess, Logico, Controle de sucesso ou erro 

    @author Victor Vieira 
    @since 10/04/2025
/*/
//----------------------------------------------------------
Function dtaFlowRequest(aParams as Array)
    Local oSmartLink as Object 
    Local lSucess as Logical
    
    Default aParams := {}

    lSucess := .F.
    
    //Content sera da informação que vira do front end
    cMessage := '{'+;
                '"userId":"' + aParams[1] + '",' +;
                '"companyGroup":"' + FWGrpCompany() + '",' +;
                '"branch":"' + cFilAnt + '",' +;
                '"sessionId":"' + aParams[2] + '",' +;
                '"type":"' + aParams[3] + '",' +;
                '"appCode":"' + aParams[4] + '",' +;
                '"tenantId":"' + aParams[5] + '",' +;
                '"correlationId":"' + aParams[6] + '",' +;
                '"content":"' + aParams[7] + '",' +;
                '"data_base":"' + DTOS(dDataBase) + '",' +;
                '"contextType":' + aParams[8] +;
                '}'

    oSmartLink := FwTotvsLinkClient():New()
    lSucess := oSmartLink:Send("DtaFlowRequest", cMessage)

Return lSucess

//----------------------------------------------------------
/*/{Protheus.doc} SendDtaFlowResponse
    Envia requisição para SmartLink DTA

    @param aParams, Array, Parametros da requisição

    @return lSucess, Logico, Controle de sucesso ou erro 

    @author Victor Vieira 
    @since 10/04/2025
/*/
//----------------------------------------------------------
Function sendDtaFlowResponse( aParams as Array )
    Local oSmartLink as Object 
    Local lSucess as Logical
    
    Default aParams := {}

    lSucess := .F.

    oSmartLink := FwTotvsLinkClient():New()

    cMessage := '{'+;
                '"appCode":"'+ aParams[1] + '",' +;
                '"sessionId":"'+ aParams[2] + '",' +;
                '"correlationId":"'+ aParams[3] + '",' +;
                '"tenantId":"'+ aParams[4] + '",' +;
                '"type":"'+aParams[5] + '",' +;
                '"content":'+ aParams[6]+ ;
                '}'

    lSucess := oSmartLink:Send("DtaFlowToolResponse", cMessage)

Return lSucess

//----------------------------------------------------------
/*/{Protheus.doc} dtaFlowResponse
    Procura via query mensagem retorno do DTA na I19.

    @param cTenantId, character, codigo tenant do cliente
    @param cMessageId, character, codigo da mensagem gravada na I19

    @return cMessage, character, mensagem respondida pelo DTA.

    @author Lucas Lima
    @since 22/05/2025
/*/
//----------------------------------------------------------
Function dtaFlowResponse( cTenantId as character, cMessageId as character )
    Local cMessage := '' as Character
    Local nRecnoI19 := 0 as Numeric
    Local lLoop := .T. as Logical
    Local nAttempts := 0 as Numeric
    Local nMaxAttempts := 24 as Numeric// 24 tentativas de buscar o recno (até 2 minutos)
    Local nTime := 5000 as Numeric     // 5 segundos

    Default cTenantId := ''
    Default cMessageId := ''

    If !Empty( cTenantId ) .And. !Empty( cMessageId )

        While nRecnoI19 == 0 .And. lLoop
            Sleep( nTime )

            nAttempts++
            lLoop := nAttempts <= nMaxAttempts

            nRecnoI19 := getRecno( cMessageId, cTenantId )
        EndDo

        // busca a mensagem gravada no campo I19_PAYLOD
        If nRecnoI19 > 0
            cMessage := getMessage(nRecnoI19)
        EndIf
    EndIf

Return cMessage
//-------------------------------------------------------------------
/*/{Protheus.doc} getRecno
    Busca o recno da mensagem do chat na Central de IA.

    @param nI19Recno, recno da mensagem

    @return nRecno, Recno com Resposta na tabela I19
    @author Lucas Lima
    @since 22/05/2025
/*/
//-------------------------------------------------------------------
Static Function getRecno( cMessageId, cTenantId )
    Local oStatement    As Object
    Local cQuery        As Character
    Local cAlias        As Character
    Local nRecno := 0   As Numeric

    cQuery := " SELECT I19.R_E_C_N_O_ "
    cQuery += " FROM ? I19 "
    cQuery += " WHERE I19.I19_FILIAL = ? "
    cQuery += " AND I19.I19_INSIGT = ? "
    cQuery += " AND I19.I19_TIDMSG = ? "
    cQuery += " AND I19.I19_TENANT = ? "
    cQuery += " AND I19.D_E_L_E_T_ = ? "

    cQuery := ChangeQuery( cQuery )

    oStatement := FwExecStatement():New( cQuery )
    oStatement:setUnsafe( 1, RetSqlName( "I19" ) )
    oStatement:setString( 2, xFilial( "I19" ) )
    oStatement:setString( 3, "DtaFlowSucceed" )
    oStatement:setString( 4, cMessageId )
    oStatement:setString( 5, cTenantId )
    oStatement:setString( 6, ' ' )
    
    cAlias := oStatement:OpenAlias()

    If ( cAlias )->( !Eof() )
        nRecno := ( cAlias )->R_E_C_N_O_
    EndIf
    ( cAlias )->( dbCloseArea() )

    FreeObj( oStatement )
Return nRecno
//-------------------------------------------------------------------
/*/{Protheus.doc} getMessage
    Retorna mensagem gravada no chat na Central de IA sobre Pedido de compras.

    @param nI19Recno, recno da mensagem

    @return cMessage, Resposta salva na tabela I19 campo I19_PAYLOAD
    @author Lucas Lima
    @since 22/05/2025
/*/
//-------------------------------------------------------------------
Static Function getMessage( nI19Recno )
    Local aAreaI19 := {}
    Local cMessage := ''

    DbSelectArea( "I19" )
    aAreaI19 := I19->( GetArea() )

    I19->( DbGoTo( nI19Recno ) )

    cMessage := I19->I19_PAYLOD

    I19->( RestArea( aAreaI19 ) )
    ASize( aAreaI19, 0 )
    aAreaI19 := NIL

Return cMessage
