#INCLUDE "totvs.ch"
#INCLUDE "tlpp-core.th"
#INCLUDE "backoffice.ba.dta.core.dtaflowproxytool.ch"

//-------------------------------------------------------------------
/*/{Protheus.doc} DtaFlowToolMessageReader
Consumer DtaFlowToolResponse

@author  Victor Vieira
@since   23/04/2025
/*/
//-------------------------------------------------------------------

Class DtaFlowToolMessageReader

    Public Method New()
    Public Method Read( oLinkMessage As Object ) As Logical

EndClass

//-------------------------------------------------------------------
/*/{Protheus.doc} New
Metodo construtor da classe

@author  Victor Vieira
@since   23/04/2025
/*/
//-------------------------------------------------------------------
Method New() Class DtaFlowToolMessageReader
Return Self

//-------------------------------------------------------------------
/*/{Protheus.doc} Read
Metodo que realiza a leitura da mensagem recebida

@author  Victor Vieira
@since   23/04/2025
/*/
//-------------------------------------------------------------------
Method Read( oLinkMessage As Object ) As Logical Class DtaFlowToolMessageReader
    Local aParamsSend       As Array
    Local cToolName         As Character
    Local cRawMsg           As Character
    Local cInsightResolv    As Character
    Local cContent := ""    As Character
    Local cSysDate          As Character
    Local lReadOk           As Logical
    Local nStart            As Numeric
    Local oDta              As Object
    Local oJsonMessage      As Object
    Local xJsonParse        As Variant
    Local xRetorno          As Variant
    Local cFrequency := "T" // precisa pedir para ser enviado

    aParamsSend := {}

    nStart := Seconds()

    Try
        cRawMsg         := oLinkMessage:RawMessage()
        oJsonMessage    := JsonObject():New()
        xJsonParse      := oJsonMessage:fromJson( cRawMsg )
        cInsightResolv  := oJsonMessage["type"]
        cToolName       := oJsonMessage["data"]["tool"]
        aParams         := oJsonMessage["data"]["parameters"]
        If valtype(oJsonMessage["data"]["parameters"]["frequency"]) == "C"
            cFrequency  := oJsonMessage["data"]["parameters"]["frequency"]
        Endif
        If valtype(oJsonMessage["data"]["parameters"]["data_base"]) == "C"
            cSysDate    := oJsonMessage["data"]["parameters"]["data_base"]
        Endif

        // Faz o send retornando o cPayload da tool executada
        oDta := DtaEngine():New( cToolName )
        oDta:SetParameters( aParams )
        oDta:SetSysDate( cSysDate )
        // Define a frequência e calcula as datas de intervalo
        If !Empty( cFrequency )
            oDta:SetFrequency( cFrequency, cSysDate )
        EndIf
        xRetorno := oDta:Execute()

        aadd( aParamsSend, oJsonMessage[ "data" ][ "appCode" ] )
        aadd( aParamsSend, oJsonMessage[ "data" ][ "sessionId" ] )
        aadd( aParamsSend, oJsonMessage[ "correlationid" ] )
        aadd( aParamsSend, oJsonMessage[ "tenantid" ] )
        aadd( aParamsSend, "DtaFlowToolResponse " )

        If ValType( xRetorno ) == "A"
            cContent := FWJsonSerialize( xRetorno, .F., .F., .T. )
        Else
            If ValType( xRetorno ) == "J"
                cContent := FWJsonSerialize( xRetorno, .F., .F., .T. )
            EndIf
        Endif

        aadd(aParamsSend,cContent)

        // retorno da tool
        SendDtaFlowResponse(aParamsSend)
        lReadOk := .T.
    Catch oException

        FwLogMsg( "ERROR", Nil, "ProtheusInsights", "InsightMessageConsumer",, "", STR0002,, Seconds() - nStart, ;    //"Exceção ocorrida ao processar a mensagem de insight"
            {;
                { "Message", STR0002 },;   //"Exceção ocorrida ao processar a mensagem de insight"
                { "ErrorCode", oException:genCode },;
                { "ErrorMessage", oException:description };
            })

        lReadOk := .T. // Retorna verdadeiro para limpar a mensagem da fila

    Finally
        FreeObj( oJsonMessage )
    EndTry
Return lReadOk
