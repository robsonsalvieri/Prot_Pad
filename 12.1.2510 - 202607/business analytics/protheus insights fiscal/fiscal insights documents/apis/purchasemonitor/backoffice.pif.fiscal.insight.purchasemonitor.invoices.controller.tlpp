#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "backoffice.pif.fiscal.insight.purchasemonitor.invoices.data.ch"

namespace totvs.protheus.backoffice.pif.fiscal.insight.purchasemonitor.invoices
using namespace totvs.protheus.backoffice.pif.util

//------------------------------------------------------------------------------
/* {Protheus.doc} PurchaseMonitorInvoicesController
    API utilizada para consultar as requisições da tela de importação de XML de compras

    @author Squad PIF
    @version 1.0
*/
//------------------------------------------------------------------------------

Class PurchaseMonitorInvoicesController

    Public Method new() Constructor
    
    @Get("/api/pif/purchasemonitor/invoices")
    Public Method getInvoicesList()

    @Get("/api/pif/purchasemonitor/invoices/items")
    Public Method getInvoicesItems()

    @Post("/api/pif/purchasemonitor/invoices/export/xml")
    Public Method postInvoicesExportXml()

    @Get("/api/pif/purchasemonitor/schedules/indicators")
    Public Method getSchedulesIndicators()

    @Get("/api/pif/purchasemonitor/schedules/executions")
    Public Method getSchedulesExecutions()
    
endClass

//------------------------------------------------------------------------------
/* {Protheus.doc} new
    Metodo construtor

    @author Squad PIF
    @version 1.0
    @return Object, retorna o objeto criado
*/
Method New() Class PurchaseMonitorInvoicesController
Return Self

//------------------------------------------------------------------------------
/* {Protheus.doc} getInvoicesList
    Método que executa a chamada da API

    @type Method
    @author Squad PIF
    @return Nil
*/
//------------------------------------------------------------------------------
Method getInvoicesList() class PurchaseMonitorInvoicesController

	Local oService      As Object
	Local jResponse     As Json
    Local nPage         As Numeric
	Local nPageSize     As Numeric
	Local cFilter       As Character

	nPage     := 1
	nPageSize := 10
	cFilter   := ""

	jResponse := getNoAccessResponse()

    if canAccess("PIFA020")
        getPageAndPageSize(@nPage, @nPageSize)

        If (oRest:getQueryRequest():GetJsonText("$filter") != "null")
            cFilter := AllTrim(oRest:getQueryRequest():GetJsonText("$filter"))
        EndIf

        oService     := PurchaseMonitorInvoicesService():New()
        jResponse   := oService:getInvoicesList(@nPage, @nPageSize, cFilter)
        
	EndIf

	answerRest(jResponse)

	FWFreeObj(oService)
	FWFreeObj(jResponse)

Return

//------------------------------------------------------------------------------
/* {Protheus.doc} getInvoicesItems
    Método que retorna os itens das notas fiscais de fornecedores
    processadas pelo TOTVS Transmite via importação xml, para exibição no Monitor de Compras.

    @type Method
    @author Squad PIF
    @return Nil
*/  
//------------------------------------------------------------------------------
Method getInvoicesItems() class PurchaseMonitorInvoicesController

    Local oService      As Object
    Local jResponse    As Json
    Local nPage         As Numeric
    Local nPageSize     As Numeric
    Local cFilter       As Character

    nPage     := 1
    nPageSize := 10
    cFilter   := ""

    jResponse := getNoAccessResponse()

    if canAccess("PIFA020")
        getPageAndPageSize(@nPage, @nPageSize)

        If (oRest:getQueryRequest():GetJsonText("$filter") != "null")
            cFilter := AllTrim(oRest:getQueryRequest():GetJsonText("$filter"))
        EndIf

        oService     := PurchaseMonitorInvoicesService():New()
        jResponse   := oService:getInvoicesItems(@nPage, @nPageSize, cFilter)
    
    EndIf

    answerRest(jResponse)

    FWFreeObj(oService)
    FWFreeObj(jResponse)

Return

//------------------------------------------------------------------------------
/* {Protheus.doc} postInvoicesExportXml
    Método que retorna o arquivo XML das notas fiscais do Monitor de Compras.

    @type Method
    @author Squad PIF
    @return Nil
*/  
//------------------------------------------------------------------------------
Method postInvoicesExportXml() class PurchaseMonitorInvoicesController
    Local oService      As Object
    Local oItem         As Json
    Local jResponse     As Json
    Local uRet          As Variant
    Local cBody         := oRest:getBodyRequest()                  As Character
    Local jBody         := JsonObject():New()                      As Json
    Local oError        := ErrorClass():New()                      As Object
    Local nX            := 1                                       As Numeric
    Local lValid        := .T.                                     As Logical

    oService  := PurchaseMonitorInvoicesService():New()
    jResponse := getNoAccessResponse()

    if canAccess("PIFA020") 
        if ValType(cBody) == "C"
            
            uRet := jBody:FromJson(cBody)
                //trata o retorno da conversão do json, caso haja algum erro de formatação ou tipo de dado, é retornado um bad request
                if ValType(uRet) != "U"
                    answerRest(getBadRequestResponse({}))
                    Return jResponse
                EndIf

                if jBody:hasProperty("documents") .And. ValType(jBody["documents"]) == "A"
                    
                    if Len(jBody["documents"]) > 0
                        For nX := 1 to Len(jBody["documents"])
                            oItem := jBody["documents"][nX]
                            // Valida se todos os itens possuem as propriedades obrigatórias                            
                            lValid := oItem:hasProperty("branch") .And. !Empty(oItem["branch"]) .And. ;
                                      oItem:hasProperty("document") .And. !Empty(oItem["document"]) .And. oItem:hasProperty("serie") .And.;
                                      oItem:hasProperty("supplier")  .And. oItem:hasProperty("store")               
                        Next nX
                        if lValid
                            jResponse := oService:postInvoicesExportXml(jBody)
                        else
                            //Retorno referente a validação de parâmetros obrigatórios
                            oError:genCode     := 400
                            oError:description := STR0176
                            jResponse := getBadRequestResponse({oError})
                        endif
                    endif
                endif
            endif
        EndIf

    answerRest(jResponse)
	FWFreeObj(oService)
	FWFreeObj(oError)
	FWFreeObj(jBody)

Return jResponse


//------------------------------------------------------------------------------
/* {Protheus.doc} getSchedulesIndicators
    Método que retorna os indicadores dos serviços

    @type Method
    @author Squad PIF
    @return Nil
*/  
//------------------------------------------------------------------------------
Method getSchedulesIndicators() class PurchaseMonitorInvoicesController
    Local oService       As Object
    Local jResponse      As Json
    
    jResponse := getNoAccessResponse()

    if canAccess("PIFA020")

        oService    := PurchaseMonitorInvoicesService():New()
        jResponse   := oService:getSchedulesIndicators()
    
    EndIf

    answerRest(jResponse)
    FWFreeObj(oService)

Return jResponse


//------------------------------------------------------------------------------
/* {Protheus.doc} getSchedulesExecutions
    Método que retorna os status e informações de execução das rotinas agendadas no schedule

    @type Method
    @author Squad PIF
    @return Nil
*/  
//------------------------------------------------------------------------------
Method getSchedulesExecutions() class PurchaseMonitorInvoicesController
    Local oService       As Object
    Local jResponse      As Json
    
    jResponse := getNoAccessResponse()

    if canAccess("PIFA020")

        oService    := PurchaseMonitorInvoicesService():New()
        jResponse   := oService:getSchedulesExecutions()
    
    EndIf

    answerRest(jResponse)
    FWFreeObj(oService)

Return jResponse
