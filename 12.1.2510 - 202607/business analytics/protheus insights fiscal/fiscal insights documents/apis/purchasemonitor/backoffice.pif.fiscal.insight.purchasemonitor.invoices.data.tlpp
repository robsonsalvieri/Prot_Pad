//------------------------------------------------------------------------------
/* {Protheus.doc} PurchaseMonitorInvoicesData
    Classe responsável pela consulta de dados das notas fiscais de fornecedores e
    processadas pelo TOTVS Transmite via importação xml, para exibição no Monitor de Compras.

    @author Squad PIF
    @version 1.0
    @see FWAdapterBaseV2
/*/
//------------------------------------------------------------------------------

Class PurchaseMonitorInvoicesData From FWAdapterBaseV2
    
    Private Data oErrorMap  as Object

    Public Method new() Constructor
    Public Method getInvoicesList()
    Public Method getInvoicesItems()
    Public Method postInvoicesExportXml()
    Static Method GetErrorInfo()
    Public Method getSchedulesIndicators()
    Public Method getSchedulesExecutions()
    
EndClass

//------------------------------------------------------------------------------
/* {Protheus.doc} new
    Metodo construtor
    
    @author Squad PIF
    @version 1.0
    @param cMethod, Character, tipo de verbo HTTP
    @param lList, Logical, indica o retorno de lista de valores
    @return Object, retorna o objeto criado
/*/
//------------------------------------------------------------------------------

Method New(cMethod as Character, lList as Logical) Class PurchaseMonitorInvoicesData

	Default cMethod := "GET"
	Default lList   := .T.

    _Super:New(cMethod, lList)

Return Self

//------------------------------------------------------------------------------
/* {Protheus.doc} getInvoicesList
    Método que busca os dados das notas fiscais para serem disponibilizados pela API.

    @author Squad PIF
    @version 1.0
    @param nPage, Numeric, Número da página a ser retornada
    @param nPageSize, Numeric, Tamanho da página a ser retornada
    @param cFilter, character, Texto a ser usado na busca.
    @return nil
/*/
//------------------------------------------------------------------------------

Method getInvoicesList(nPage as Numeric, nPageSize as Numeric, cFilter as Character) class PurchaseMonitorInvoicesData

    Local cWhere        As Character
    Local aArea         As Array
    Local aUrlFilter    As Array

	Default nPage     := 1
	Default nPageSize := 10

	aArea      := FWGetArea()
	cWhere     := " "
	aUrlFilter := {}

	AddMapFieldsInvoices(self)
	::setUseSpaces(.F.)
	::setPage(nPage)
	::setPageSize(nPageSize)
	::SetQuery( getInvoicesQuery() )
    cWhere += "  CKO.D_E_L_E_T_ = ' ' "
	::SetWhere(cWhere)
	::SetOrder("CKO.CKO_FILPRO, SDS.DS_EMISSA DESC, CKO.CKO_DT_IMP DESC")

	if !Empty(cFilter)

		aUrlFilter := {;
			{"FILTER", cFilter};
			}
		::SetUrlFilter(aUrlFilter)
	endif

	If ::Execute()
		::FillGetResponse()
	EndIf

	FWRestArea(aArea)
	FwFreeArray(aArea)
    FwFreeArray(aUrlFilter)
Return

//------------------------------------------------------------------------------
/*/{Protheus.doc} AddMapFieldsInvoices
    Função que adiciona os campos mapeados para a consulta de notas fiscais

    @author Squad PIF
    @version 1.0
    @param oSelf, object, Objeto - Objeto com herança da classe FWAdapterBaseV2
    @return Nil 
/*/
//------------------------------------------------------------------------------
Static Function AddMapFieldsInvoices(oSelf as Object)

    oSelf:addMapFields('branch'           , "CKO_FILPRO"        , .T., .F., {"CKO_FILPRO"        ,"C"    , TamSX3('CKO_FILPRO')[1], 0}, "") 
    oSelf:addMapFields('branchName'       , "M0_FILIAL"         , .T., .F., {"M0_FILIAL"         ,"C"    , 30, 0}, "") 
    oSelf:addMapFields('statusInvoice'    , "STATUS_DOC"        , .T., .F., {"STATUS_DOC"        ,"C"    , 30, 0}, getStatusInvoice()) 
    oSelf:addMapFields('statusIntegration', "STATUS_INTEGRATION", .T., .F., {"STATUS_INTEGRATION","C"    , 30, 0}, getStatusIntegration()) 
    oSelf:addMapFields('specie'           , "TIPO_DOC"          , .T., .F., {"TIPO_DOC"          ,"C"    , 8 , 0}, getinvoiceType())
    oSelf:addMapFields('invoiceType'      , "DS_TIPO"           , .T., .F., {"DS_TIPO"           ,"C"    , TamSX3('DS_TIPO')[1], 0}, "")    
    oSelf:addMapFields('invoiceKey'       , "CKO_CHVDOC"        , .T., .T., {"CKO_CHVDOC"        ,"C"    , TamSX3('CKO_CHVDOC')[1], 0}, "")
    oSelf:addMapFields('invoiceNumber'    , "DS_DOC"            , .T., .T., {"DS_DOC"            ,"C"    , TamSX3('DS_DOC')[1],     0}, getInvoiceNumber())
    oSelf:addMapFields('serialNumber'     , "DS_SERIE"          , .T., .T., {"DS_SERIE"          ,"C"    , TamSX3('DS_SERIE')[1],   0}, getSerialNumber()) 
    oSelf:addMapFields('supplierName'     , "CKO_NOMFOR"        , .T., .F., {"CKO_NOMFOR"        ,"C"    , 40, 0}, getParticipantName() )    
    oSelf:addMapFields('clientCode'       , "DS_FORNEC"         , .T., .F., {"DS_FORNEC"         ,"C"    , TamSX3('DS_FORNEC')[1],  0}, "")  
    oSelf:addMapFields('supplierCode'     , "DS_FORNEC"         , .T., .F., {"DS_FORNEC"         ,"C"    , TamSX3('DS_FORNEC')[1],  0}, "")
    oSelf:addMapFields('supplierStore'    , "DS_LOJA"           , .T., .F., {"DS_LOJA"           ,"C"    , TamSX3('DS_LOJA')[1],    0}, "")
    oSelf:addMapFields('supplierDocument' , "DS_CNPJ"           , .T., .F., {"DS_CNPJ"           ,"N"    , TamSX3('DS_CNPJ')[1],    0}, "")
    oSelf:addMapFields('invoiceTotal'     , "DS_TOTAL"          , .T., .F., {"DS_TOTAL"          ,"N"    , TamSX3('DS_TOTAL')[1], TamSX3('DS_TOTAL')[2]}, "")
    oSelf:addMapFields('documentDate'     , "DS_EMISSA"         , .T., .F., {"DS_EMISSA"         ,"D"    , TamSX3('DS_EMISSA')[1],  0}, "") 
    oSelf:addMapFields('integrationDate'  , "CKO_DT_IMP"        , .T., .F., {"CKO_DT_IMP"        ,"D"    , TamSX3('CKO_DT_IMP')[1], 0}, "") 
    oSelf:addMapFields('releaseSefaz'     , "CKO_DT_RET"        , .T., .F., {"CKO_DT_RET"        ,"D"    , TamSX3('CKO_DT_RET')[1], 0}, "")
    oSelf:addMapFields('errorCode'        , "CKO_CODERR"        , .T., .F., {"CKO_CODERR"        ,"C"    , TamSX3('CKO_CODERR')[1], 0}, "")

Return

//------------------------------------------------------------------------------
/* {Protheus.doc} getInvoiceNumber
    Função que gera o trecho da query SQL com a cláusula CASE para o campo invoiceNumber

    @author Squad PIF
    @version 1.0
    @return character, String contendo o trecho da query
/*/
//------------------------------------------------------------------------------
Static Function getInvoiceNumber() As Character 

    Local cQuery As Character

    cQuery := " CASE "
    cQuery += "     WHEN DS_DOC IS NOT NULL AND DS_DOC <> ' ' "
    cQuery += "     THEN DS_DOC "
    cQuery += "     ELSE CKO_DOC "
    cQuery += " END "

Return cQuery

//------------------------------------------------------------------------------
/* {Protheus.doc} getSerialNumber
    Função que gera o trecho da query SQL com a cláusula CASE para o campo getSerialNumber

    @author Squad PIF
    @version 1.0
    @return character, String contendo o trecho da query
/*/
//------------------------------------------------------------------------------
Static Function getSerialNumber() As Character 

    Local cQuery As Character

    cQuery := " CASE "
    cQuery += "     WHEN DS_DOC IS NOT NULL AND DS_DOC <> ' ' "
    cQuery += "     THEN DS_SERIE "
    cQuery += "     ELSE CKO_SERIE "
    cQuery += " END "

Return cQuery

//------------------------------------------------------------------------------
/* {Protheus.doc} getinvoiceType
    Função que gera o trecho da query SQL com a cláusula CASE para o campo invoiceType 
    (TIPO_DOC)

    @author Squad PIF
    @version 1.0
    @return character, String contendo o trecho da query
/*/
//------------------------------------------------------------------------------
Static Function getinvoiceType() As Character 

    Local cQuery As Character

    cQuery := " CASE "
    cQuery += "   WHEN CKO_CODEDI = '109' "
    cQuery += "   THEN 'NF-e' "
    cQuery += "   WHEN CKO_CODEDI = '214' "
    cQuery += "   THEN 'CT-e' " 
    cQuery += "   WHEN CKO_CODEDI = '273' " 
    cQuery += "   THEN 'CTE-OS' "
    cQuery += "   WHEN CKO_CODEDI = '319' " 
    cQuery += "   THEN 'NFS-e' "
    cQuery += " END "

Return cQuery

//------------------------------------------------------------------------------
/*/ {Protheus.doc} getStatusIntegration
    Função que gera o trecho da query SQL com a cláusula CASE para o campo statusIntegration 
    (coluna STATUS_INTEGRATION).

    @important getStatusIntegration 
        1 - Exportada - Chegou na CKO e ainda não tem SDS/SDT
        2 - Exportada com Erros - Chegou na CKO com erro em CKO_MSGERR 
        3 - Importada - Chegou na SDS/SDT 
        4 - Importada com Divergencias - Chegou na SDS/SDT mas não dá pra gravar
        5 - Integrada - Gerou Pré-Nota 
        6 - Classificada
    @author Squad PIF
    @version 1.0
    @return character, String contendo o trecho da query
/*/
//------------------------------------------------------------------------------
Static Function getStatusIntegration() As Character

    Local cQuery As Character

    cQuery := " CASE "
    cQuery += "     WHEN SDS.DS_STATUS = 'P' AND SF1.F1_STATUS = 'A' "
    cQuery += "     THEN '6' "
    cQuery += "     WHEN SDS.DS_STATUS = 'P' AND SF1.F1_STATUS = ' ' "
    cQuery += "     THEN '5' "
    cQuery += "     WHEN SDS.DS_STATUS = 'B' "
    cQuery += "     THEN '4' "
    cQuery += "     WHEN SDS.DS_DOC IS NOT NULL AND SDS.DS_DOC <> ' '  "
    cQuery += "     THEN '3' "
    cQuery += "     WHEN (CKO.CKO_CODERR <> ' ' OR CKO.CKO_MSGERR <> ' ') "
    cQuery += "     AND (SDS.DS_EMISSA = ' ' OR SDS.DS_EMISSA IS NULL) "    
    cQuery += "     THEN '2' "
    cQuery += "     WHEN SDS.DS_DOC IS NULL "
    cQuery += "     THEN '1' "
    cQuery += "     ELSE '1' "
    cQuery += " END "

Return cQuery

//------------------------------------------------------------------------------
/*/ {Protheus.doc} getStatusInvoice
    Função que gera o trecho da query SQL com a cláusula CASE para o campo statusInvoice 
    (coluna STATUS_DOC).

    @important getStatusIntegration - Return detailled 1 - Autorizada, 2 - NF Importada e cancelada, 3 - CTe/CTeOS Importada e cancelada 
    @author Squad PIF
    @version 1.0
    @return character, String contendo o trecho da query
/*/
//------------------------------------------------------------------------------
Static Function getStatusInvoice() As Character

    Local cQuery As Character

    cQuery := " CASE "
    cQuery += "     WHEN CKO_CODERR = 'COM055' "
    cQuery += "     THEN '2' "
    cQuery += "     WHEN CKO_CODERR = 'COM056' "
    cQuery += "     THEN '3' "
    cQuery += "     ELSE '1' "
    cQuery += " END "

Return cQuery

//------------------------------------------------------------------------------
/*/{Protheus.doc} getInvoicesQuery
    Função que gera a query SQL completa para consulta das notas fiscais recebidas

    @author Squad PIF
    @version 1.0
    @return character, String contendo a query
/*/
//------------------------------------------------------------------------------

Static Function getInvoicesQuery() As Character
	
    Local cQuery   As Character

    cQuery := " SELECT #QueryFields# "
    cQuery += "   FROM " + RetSqlName("CKO") + " CKO "
    cQuery += "   LEFT JOIN " + RetSqlName("SDS") + " SDS "
    cQuery += "     ON SDS.DS_ARQUIVO = CKO.CKO_ARQUIV "
    cQuery += "     AND SDS.D_E_L_E_T_ = ' ' "
    cQuery += "   LEFT JOIN " + RetSqlName("SA1") + " SA1 "
    cQuery += "     ON " + FWJoinFilial("SA1", "SDS") + " "
    cQuery += "     AND SA1.A1_COD  = SDS.DS_FORNEC "
    cQuery += "     AND SA1.A1_LOJA = SDS.DS_LOJA "
    cQuery += "     AND SA1.D_E_L_E_T_ = ' ' "
    cQuery += "   LEFT JOIN " + RetSqlName("SA2") + " SA2 "
    cQuery += "     ON " + FWJoinFilial("SA2", "SDS") + " "
    cQuery += "     AND SA2.A2_COD     = SDS.DS_FORNEC "
    cQuery += "     AND SA2.A2_LOJA    = SDS.DS_LOJA "
    cQuery += "     AND SA2.D_E_L_E_T_ = ' ' "
    cQuery += " INNER JOIN SYS_COMPANY SM0  " 
    cQuery += "     ON  CKO.CKO_EMPPRO = SM0.M0_CODIGO "
    cQuery += "     AND CKO.CKO_FILPRO = SM0.M0_CODFIL "    
    cQuery += "     AND SM0.D_E_L_E_T_ = ' ' "
    cQuery += " LEFT JOIN " + RetSqlName("SF1") + " SF1 ON " + FWJoinFilial("SDS", "SF1") + " "
    cQuery += " AND SDS.DS_DOC = SF1.F1_DOC "
    cQuery += " AND SDS.DS_SERIE = SF1.F1_SERIE "
    cQuery += " AND SDS.DS_FORNEC = SF1.F1_FORNECE "
    cQuery += " AND SDS.DS_LOJA = SF1.F1_LOJA "
    cQuery += " AND SF1.D_E_L_E_T_ = ' ' " 
    cQuery += " WHERE #QueryWhere# "

Return cQuery

