    oJsonError["COM050"]['Category']          := STR0144 
    
    oJsonError["COM051"] := JsonObject():New()
    oJsonError["COM051"]['descriptionError']  := STR0145 
    oJsonError["COM051"]['solutionError']     := STR0146 
    oJsonError["COM051"]['Category']          := STR0147

    oJsonError["COM052"] := JsonObject():New()
    oJsonError["COM052"]['descriptionError']  := STR0148 
    oJsonError["COM052"]['solutionError']     := STR0149 
    oJsonError["COM052"]['Category']          := STR0150 
    
    oJsonError["COM053"] := JsonObject():New()
    oJsonError["COM053"]['descriptionError']  := STR0151 
    oJsonError["COM053"]['solutionError']     := STR0152 
    oJsonError["COM053"]['Category']          := STR0153 
    oJsonError["COM055"] := JsonObject():New()
    oJsonError["COM055"]['descriptionError']  := STR0154 
    oJsonError["COM055"]['solutionError']     := STR0155 
    oJsonError["COM055"]['Category']          := STR0156

    oJsonError["COM056"] := JsonObject():New()
    oJsonError["COM056"]['descriptionError']  := STR0157 
    oJsonError["COM056"]['solutionError']     := STR0158 
    oJsonError["COM056"]['Category']          := STR0159

    oJsonError["COM057"] := JsonObject():New()
    oJsonError["COM057"]['descriptionError']  := STR0160 
    oJsonError["COM057"]['solutionError']     := STR0161 
    oJsonError["COM057"]['Category']          := STR0162 
    
    oJsonError["COM058"] := JsonObject():New()
    oJsonError["COM058"]['descriptionError']  := STR0163 
    oJsonError["COM058"]['solutionError']     := STR0164 
    oJsonError["COM058"]['Category']          := STR0165

    oJsonError["COM059"] := JsonObject():New()
    oJsonError["COM059"]['descriptionError']  := STR0166 
    oJsonError["COM059"]['solutionError']     := STR0167 
    oJsonError["COM059"]['Category']          := STR0168 

    oJsonError["COM060"] := JsonObject():New()
    oJsonError["COM060"]['descriptionError']  := STR0180
    oJsonError["COM060"]['solutionError']     := STR0181
    oJsonError["COM060"]['Category']          := STR0168
 
    oJErrorDefault := JsonObject():New()
    oJErrorDefault['descriptionError']  := STR0169 
    oJErrorDefault['solutionError']     := STR0170 
    oJErrorDefault['errorCategory']     := STR0171 

    oJRet := Iif(ValType(oJsonError[cErrorCode]) == "J",oJsonError[cErrorCode],oJErrorDefault)
    FWFreeObj(oJsonError)

Return oJRet

//
//------------------------------------------------------------------------------
/* {Protheus.doc} getInvoicesItems
    Método que busca os dados dos ítens das notas fiscais para serem disponibilizados pela API.

    @param nPage, Numeric, Número da página a ser retornada
    @param nPageSize, Numeric, Tamanho da página a ser retornada
    @param cFilter, character, Texto a ser usado na busca.
    @return nil
/*/
//------------------------------------------------------------------------------

Method getInvoicesItems(nPage as Numeric, nPageSize as Numeric, cFilter as Character) class PurchaseMonitorInvoicesData

    Local cWhere        As Character
    Local aArea         As Array
    Local aUrlFilter    As Array

    Default nPage     := 1
    Default nPageSize := 10

    aArea      := FWGetArea()
    cWhere     := " "
    aUrlFilter := {}

    AddMapFieldsInvoicesItems(self)
    ::setUseSpaces(.T.)
    ::setPage(nPage)
    ::setPageSize(nPageSize)
    ::SetQuery( getInvoicesItemsQuery() )
    cWhere += "  SDT.D_E_L_E_T_ = ' ' AND "
    cWhere += "  SDS.D_E_L_E_T_ = ' ' AND " 
    cWhere += "  CKO.D_E_L_E_T_ = ' ' "
    ::SetWhere(cWhere)
    ::SetOrder("SDT.DT_FILIAL,SDT.DT_DOC,SDT.DT_SERIE,SDT.DT_ITEM")

    if !Empty(cFilter)
        aUrlFilter := {{"FILTER", cFilter}}
        ::SetUrlFilter(aUrlFilter)
    endif
    If ::Execute()
        ::FillGetResponse()
    EndIf

    FWRestArea(aArea)
    FwFreeArray(aArea)
    FwFreeArray(aUrlFilter)

Return

//------------------------------------------------------------------------------
/*/{Protheus.doc} AddMapFieldsInvoicesItems
    Função que adiciona os campos mapeados para a consulta dos itens das notas 
    fiscais recebidas

    @author Squad PIF
    @version 1.0
    @param oSelf, object, Objeto - Objeto com herança da classe FWAdapterBaseV2
    @return Nil 
/*/
//------------------------------------------------------------------------------
Static Function AddMapFieldsInvoicesItems(oSelf as Object)

    oSelf:addMapFields('branch'            , "DT_FILIAL" , .T., .F., {"DT_FILIAL" ,"C",TamSX3('DT_FILIAL')[1], 0}, "") 
    oSelf:addMapFields('branchName'        , "M0_FILIAL" , .T., .F., {"M0_FILIAL" ,"C",30, 0 }, "")
    oSelf:addMapFields('invoiceNumber'     , "DT_DOC"    , .T., .T., {"DT_DOC"    ,"C",TamSX3('DT_DOC')[1], 0}, "")
    oSelf:addMapFields('serialNumber'      , "DT_SERIE"  , .T., .T., {"DT_SERIE"  ,"C",TamSX3('DT_SERIE')[1], 0}, "")
    oSelf:addMapFields('itemNumber'        , "DT_ITEM"   , .T., .T., {"DT_ITEM"   ,"N",TamSX3('DT_ITEM')[1], 0}, "")
    oSelf:addMapFields('supplierCode'      , "DT_FORNEC" , .T., .F., {"DT_FORNEC" ,"C",TamSX3('DT_FORNEC')[1],    0}, "")
    oSelf:addMapFields('supplierStore'     , "DT_LOJA"   , .T., .F., {"DT_LOJA"   ,"C",TamSX3('DT_LOJA')[1],    0}, "")
    oSelf:addMapFields('productCode'       , "DT_COD"    , .T., .F., {"DT_COD"    ,"C",TamSX3('DT_COD')[1], 0}, "")
    oSelf:addMapFields('productsSupCode'   , "DT_PRODFOR", .T., .F., {"DT_PRODFOR","C",TamSX3('DT_PRODFOR')[1], 0}, "")
    oSelf:addMapFields('productDescription', "DT_DESCFOR", .T., .F., {"DT_DESCFOR","C",TamSX3('DT_DESCFOR')[1], 0}, "")
    oSelf:addMapFields('measurementUnit'   , "DT_UM"     , .T., .F., {"DT_UM"     ,"C",TamSX3('DT_UM')[1], 0}, "")
    oSelf:addMapFields('quantity'          , "DT_QUANT"  , .T., .F., {"DT_QUANT"  ,"N",TamSX3('DT_QUANT')[1] ,TamSX3('DT_QUANT')[2]}, "")
    oSelf:addMapFields('unitPrice'         , "DT_VUNIT"  , .T., .F., {"DT_VUNIT"  ,"N",TamSX3('DT_VUNIT')[1] ,TamSX3('DT_VUNIT')[2]}, "")
    oSelf:addMapFields('totalPrice'        , "DT_TOTAL"  , .T., .F., {"DT_TOTAL"  ,"N",TamSX3('DT_TOTAL')[1],TamSX3('DT_TOTAL')[2]}, "")
    oSelf:addMapFields('poNumber'          , "DT_PEDIDO" , .T., .F., {"DT_PEDIDO" ,"C",TamSX3('DT_PEDIDO')[1], 0}, "")
    oSelf:addMapFields('poItem'            , "DT_ITEMPC" , .T., .F., {"DT_ITEMPC" ,"C",TamSX3('DT_ITEMPC')[1], 0}, "")

Return 

//------------------------------------------------------------------------------
/*/ {Protheus.doc} getInvoicesItemsQuery
    Função que gera a query SQL completa para consulta dos itens das notas fiscais 
    recebidas

    @author Squad PIF
    @version 1.0
    @return cQuery, character, String contendo a query  
/*/
//------------------------------------------------------------------------------    
Static Function getInvoicesItemsQuery()
    
    Local cQuery   As Character

    cQuery := " SELECT #QueryFields# "
    cQuery += " FROM " + RetSqlName("SDT") + " SDT "
    cQuery += " INNER JOIN " + RetSqlName("SDS") + " SDS "
	cQuery += "     ON	SDS.DS_FILIAL	= SDT.DT_FILIAL AND "
	cQuery += "     	DS_FORNEC		= DT_FORNEC AND "
	cQuery += "     	DS_LOJA			= DT_LOJA AND "
	cQuery += "     	DS_DOC			= DT_DOC  AND "
	cQuery += "     	DS_SERIE		= DT_SERIE "
    cQuery += " INNER JOIN " + RetSqlName("CKO") + " CKO "    
    cQuery += "     ON CKO.CKO_ARQUIV	= SDS.DS_ARQUIVO "
    cQuery += " INNER JOIN SYS_COMPANY SM0  " 
    cQuery += "     ON  SDT.DT_FILIAL = SM0.M0_CODFIL AND "
    cQuery += "     SM0.M0_CODIGO		= CKO_EMPPRO "
    cQuery += " WHERE #QueryWhere# "

Return cQuery

//------------------------------------------------------------------------------
/* {Protheus.doc} postInvoicesExportXml
    Método que busca o arquivo XML das notas fiscais do Monitor de Compras.

    @author Squad PIF
    @version 1.0
    @param JBody, Json , Arquivo Json com a lista de arquivos a serem exportados
    @return Json, Objeto Json com os arquivos em base64
/*/
//------------------------------------------------------------------------------

Method postInvoicesExportXml(jBody As Json) class PurchaseMonitorInvoicesData
    Local oDocument     := Nil           As Object
    Local jResponse     := Nil           As Json
    Local oExec         := Nil           As Object
    Local nX            := 0             As Numeric
    Local nParam        := 1             As Numeric
    Local cQuery        := ""            As Character
    Local cAlias        := ""            As Character
    Local cXmlRet       := ""            As Character

    cQuery := " SELECT CKO_ARQUIV "
    cQuery += " FROM " + RetSqlName("CKO") + " CKO "
    cQuery += " WHERE CKO.D_E_L_E_T_ = ? "
    cQuery += "   AND CKO.CKO_FILPRO = ? "
    cQuery += "   AND CKO.CKO_DOC    = ? "
    cQuery += "   AND CKO.CKO_SERIE  = ? "

    cQuery := ChangeQuery(cQuery)

    For nX := 1 to Len(jBody["documents"])
        oDocument := jBody["documents"][nX]
        nParam    := 1
        cXmlRet   := ""
        oExec := FwExecStatement():New(cQuery)
        oExec:SetString(nParam++, " ")
        oExec:SetString(nParam++, oDocument["branch"])
        oExec:SetString(nParam++, AllTrim(Str(Val(oDocument["document"]))))
        oExec:SetString(nParam++, oDocument["serie"])

        cAlias := oExec:OpenAlias()

        If !(cAlias)->(Eof())
            cXmlRet := GetAdvFVal("CKO", "CKO_XMLRET", (cAlias)->CKO_ARQUIV, 1)
        EndIf

        (cAlias)->(DbCloseArea())
        FWFreeObj(oExec)

        If !Empty(cXmlRet)
            oDocument["xmlfile"] := Encode64(cXmlRet)
            oDocument["status"]  := STR0172
        Else
            oDocument["xmlfile"] := ""
            oDocument["status"]  := STR0173
            oDocument["message"] := STR0174
        EndIf

    Next nX

    jResponse := getSuccessReponse(jBody)

Return jResponse

//------------------------------------------------------------------------------
/* {Protheus.doc} getSchedulesIndicators
    Método que responsavél por obter as informações dos schedules indicadores
    
    @author Squad PIF
    @version 1.0
    @return jResponse, json, retorna o objeto json contendo os dados dos indicadores schedules
    @see https://tdn.totvs.com/pages/releaseview.action?pageId=908346692
/*/
//------------------------------------------------------------------------------
Method getSchedulesIndicators() class PurchaseMonitorInvoicesData
    Local jResponse          As Json
    Local oScheduleInfo      As Object
    Local lIsSmartSchedule   As Logical
    Local lIsOldtSchedule    As Logical
    Local lIsRunning         As Logical
    Local aEnvRunning        As Array
    Local aRoutines          As Array

    jResponse        := JsonObject():New()
    oScheduleInfo    := totvs.framework.schedule.information.ScheduleInformation():New()
    lIsSmartSchedule := oScheduleInfo:getSmartScheduleIsRunning()
    lIsOldtSchedule  := oScheduleInfo:getOldScheduleIsRunning()
    lIsRunning       := lIsSmartSchedule .Or. lIsOldtSchedule
    aEnvRunning      := oScheduleInfo:getEnvironmentsScheduleRunning(Iif(lIsOldtSchedule, 1, 2))
    aRoutines        := {"SCHEDIMPTRA", "SCHEDUPDTRA", "SCHEDCOMCOL"}

    jResponse["schedule"]                         := JsonObject():New()
    jResponse["schedule"]["isRunning"]            := lIsRunning
    jResponse["schedule"]["isSmartSchedule"]      := lIsSmartSchedule
    jResponse["schedule"]["environmentsRunning"]  := aEnvRunning
    jResponse["services"]                         := GetSchedulesStatusByRoutines(aRoutines)
    jResponse["message"]                          := Iif(lIsRunning, Nil, STR0177) // "Smart Schedule não configurado, habilite para utilizar essa funcionalidade."

    jResponse := getSuccessReponse(jResponse)

    FWFreeObj(oScheduleInfo)
    FwFreeArray(aRoutines)
    FwFreeArray(aEnvRunning)

Return jResponse


//------------------------------------------------------------------------------
/*/{Protheus.doc} GetSchedulesStatusByRoutines
    Função que retorna o status dos schedules das rotinas informadas.

    @type  Static Function
    @author Squad PIF
    @version 1.0
    @param aRoutines, Array, Array de character com os nomes das rotinas que irá retornar o status no schedule
    @return aRet, Array, Array com os status do
/*/
//------------------------------------------------------------------------------
Static Function GetSchedulesStatusByRoutines(aRoutines As Array) As Array
    Local aRet              As Array
    Local oScheduleInfo     As Object
    Local nX                As Numeric
    Local cRoutine          As Character
    Local jScheduleInfo     As Json
    Local aScheduleInfo     As Array
    Local cTaskID           As Character
    Local aLastExec         As Array
    Local cLastDayExec      As Character
    Local cLastTimeExec     As Character
    Local cStatus           As Character

    oScheduleInfo  := totvs.framework.schedule.information.ScheduleInformation():New()
    aRet           := {}

    For nX := 1 To Len(aRoutines)

        cRoutine      := aRoutines[nX]
        jScheduleInfo := JsonObject():New()
        aScheduleInfo := oScheduleInfo:getSchedulesByRoutine(cRoutine)

        jScheduleInfo["id"]            := cRoutine
        jScheduleInfo["status"]        := "2" // 1=Inicializado 2=Parado
        jScheduleInfo["lastDayExec"]   := ""
        jScheduleInfo["lastTimeExec"]  := ""

        If Len(aScheduleInfo) > 0
            cTaskID       := aScheduleInfo[1][1]["CID"]
            aLastExec     := LastExecSched(cTaskID)
            cLastDayExec  := aLastExec[1]
            cLastTimeExec  := aLastExec[2]
            cStatus       := Iif(aScheduleInfo[1][1]:CSTATUS $ "1|3", "2", "1")

            jScheduleInfo["status"]        := cStatus
            jScheduleInfo["lastDayExec"]   := cLastDayExec
            jScheduleInfo["lastTimeExec"]  := cLastTimeExec
        EndIf

        aAdd(aRet, jScheduleInfo)
    Next


    FWFreeObj(oScheduleInfo)

Return aRet


//------------------------------------------------------------------------------
/*/{Protheus.doc} LastExecSched
	Retorna um array com a data e hora da ultima execução do JOB

	@type  Static Function
    @author Squad PIF
	@version 1.0
	@param cTaskID, Character, ID da Rotina que será verificada no Schedule
	@return aLastExec, Array, Array contendo data e hora da ultima execução
/*/
//------------------------------------------------------------------------------
Static Function LastExecSched(cTaskID As Character) As Array
	Local aLastExec    As Array
	Local cAlias       As Character
	Local cQuery	   As Character
	Local oExec	       As Object
    Local nParam	   As Numeric

	Default cTaskID := ""

    aLastExec := {"", ""}

    cQuery := " SELECT TSK_DIA, TSK_HORA "
    cQuery += " FROM SCHDTSK "
    cQuery += " WHERE "
    cQuery += 	" TSK_CODIGO = ? "
    cQuery += 	" AND TSK_STATUS <> ? "
    cQuery += 	" AND D_E_L_E_T_ = ? "
    cQuery += " ORDER BY R_E_C_N_O_ DESC "

    cQuery := ChangeQuery(cQuery)
    oExec  := FwExecStatement():New(cQuery)

    nParam := 1
	oExec:SetString(nParam++, cTaskID)
	oExec:SetString(nParam++, '0')
	oExec:SetString(nParam++, '')

	cAlias := oExec:OpenAlias()

	If (cAlias)->(!Eof())
        aLastExec[1] := Dtoc(Stod((cAlias)->TSK_DIA))
        aLastExec[2] := (cAlias)->TSK_HORA
	Endif

	(cAlias)->(DbCloseArea())

    FWFreeObj(oExec)

Return aLastExec

//------------------------------------------------------------------------------
/* {Protheus.doc} getParticipantName
    Busca o nome do cliente quando o tipo da nota for devolucao ou beneficiamento caso contrario busca o nome do fornecedor
    
    @author Squad PIF
    @version 1.0
    @return cName, character, Nome do cliente ou fornecedor dependendo do tipo da nota fiscal
/*/
//------------------------------------------------------------------------------

Static Function getParticipantName() As Character

    Local cQuery As Character

    cQuery := " CASE "
    cQuery += "   WHEN "
    cQuery += "     SDS.DS_TIPO IN ('D','B') OR (SDS.DS_TIPO = '5' AND SDS.DS_TPCOMPL = '03') "
    cQuery += "   THEN "
    cQuery += "     COALESCE(NULLIF(SA1.A1_NOME,' '), CKO.CKO_NOMFOR) "
    cQuery += "   ELSE COALESCE(NULLIF(SA2.A2_NOME,' '), CKO.CKO_NOMFOR) "
    cQuery += " END "

Return cQuery

//------------------------------------------------------------------------------
/* {Protheus.doc} getSchedulesExecutions
    Método que retorna os status e informações de execução das rotinas agendadas no schedule
    
    @author Squad PIF
    @version 1.0
    @return jResponse, Json, retorna o objeto json contendo os dados dos indicadores schedules
    @see https://tdn.totvs.com/pages/releaseview.action?pageId=908346692
/*/
//------------------------------------------------------------------------------
Method getSchedulesExecutions() class PurchaseMonitorInvoicesData
    Local jResponse       As Json
    Local aRoutines       As Array 
    Local oScheduleInfo	  As Object
    Local oExec	          As Object
    Local cAlias	      As Character
    Local cQuery	      As Character
    Local nParam	      As Numeric
    Local aItems          As Array
    Local cScheduleId     As Character
    Local cTaskId         As Character
    Local oSchdTask       As Object
    Local jExecution      As Json

    jResponse           := JsonObject():New()
    aItems              := {}
    jResponse["items"]  := aItems
    aRoutines           := {"SCHEDIMPTRA", "SCHEDUPDTRA", "SCHEDCOMCOL"}
    oScheduleInfo       := totvs.framework.schedule.information.ScheduleInformation():New()

    cQuery := " SELECT TSK_CODIGO, TSK_ITEM     " 
    cQuery += " FROM (     " 
    cQuery += "     SELECT      " 
    cQuery += "         TSK_CODIGO,     " 
    cQuery += "         TSK_ITEM,     " 
    cQuery += "         ROW_NUMBER() OVER (PARTITION BY TSK_ROTINA ORDER BY R_E_C_N_O_ DESC) AS rn     " 
    cQuery += "     FROM SCHDTSK     " 
    cQuery += "     WHERE      " 
    cQuery += "         TSK_ROTINA IN (?)      " 
    cQuery += "         AND D_E_L_E_T_ = ?    " 
    cQuery += " ) AS sub     " 
    cQuery += " WHERE rn <= 3     " 
    cQuery += " ORDER BY TSK_CODIGO, rn;     " 

    cQuery := ChangeQuery(cQuery)
    oExec  := FwExecStatement():New(cQuery)

    nParam := 1
    oExec:setIn(nParam++, aRoutines)
    oExec:SetString(nParam++, "")

    cAlias := oExec:OpenAlias()

    While (cAlias)->(!Eof())
        cScheduleId  := (cAlias)->TSK_CODIGO
        cTaskId      := (cAlias)->TSK_ITEM

        oSchdTask := oScheduleInfo:getTaskById(cScheduleId, cTaskId)

        If ValType(oSchdTask) == "O"
            jExecution                  := JsonObject():New()
            jExecution["service"]       := AllTrim(oSchdTask["CFUNCTION"])
            jExecution["status"]        := oSchdTask["CSTATUS"]
            jExecution["scheduleId"]    := cScheduleId
            jExecution["taskId"]        := cTaskId
            jExecution["environment"]   := AllTrim(oSchdTask:OFWBOENV:CENV)
            jExecution["company"]       := AllTrim(oSchdTask:OFWBOENV:CEMP)
            jExecution["branch"]        := AllTrim(oSchdTask:OFWBOENV:CFIL)
            jExecution["userId"]        := AllTrim(oSchdTask:CUSERID)
            jExecution["userName"]      := AllTrim(UsrRetName(oSchdTask:CUSERID))
            jExecution["execDate"]      := DToC(oSchdTask:DDATE)
            jExecution["execTime"]      := oSchdTask:CTIME

            aAdd(aItems, jExecution)
        EndIF

        (cAlias)->(DbSkip())
    End

    (cAlias)->(DbCloseArea())

    jResponse := getSuccessReponse(jResponse)

    FWFreeObj(oScheduleInfo)
    FWFreeObj(oExec)
    FwFreeArray(aRoutines)
    
Return jResponse
