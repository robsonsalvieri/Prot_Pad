#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "protheus.ch"
#include "totvs.ch"

namespace totvs.protheus.backoffice.pif.fiscal.insight.purchaseorderssuggested
using namespace totvs.protheus.backoffice.pif.util

//------------------------------------------------------------------------------
/*/ {Protheus.doc} PurchaseOrdersSuggestedData
    Classe responsável por retornar a lista de pedidos de compra sugeridos por 
    documento fiscal, e classificados por critérios de relevância (acurácia).

    @author Squad PIF
    @version 1.0
/*/
//------------------------------------------------------------------------------
Class PurchaseOrdersSuggestedData From FWAdapterBaseV2
    
    Public Method new() Constructor
    Public Method getPurchaseOrdersSuggested()
    Public Method getPurchaseOrdersManually()
    Public Method getPurchaseOrdersLinked()

EndClass
    
//------------------------------------------------------------------------------
/*/ {Protheus.doc} new
    Metodo construtor
    
    @author Squad PIF
    @version 1.0
    @param cMethod, Character, tipo de verbo HTTP
    @param lList, Logical, indica o retorno de lista de valores
    @return Json, Objeto json de retorno do endpoint
/*/
//------------------------------------------------------------------------------
Method New() Class PurchaseOrdersSuggestedData
	_Super:New( "GET", .T. )
return self

//------------------------------------------------------------------------------
/*/ {Protheus.doc} getPurchaseOrdersSuggested
    Método que seleciona os pedidos de compra sugeridos para o documento fiscal

    @author Squad PIF
    @version 1.0
    @param cBranch, Character, filial do documento fiscal
    @param cDocument, Character, numero do documento fiscal
    @param cSerial, Character, serie do documento fiscal   
    @param cSupplier, Character, fornecedor do documento fiscal      
    @param cStore, Character, loja do documento fiscal
    @param lItems, Logical, indica se a pesquisa retornará os dados por item do pedido
    @return Object, retorna o objeto criado
/*/
//------------------------------------------------------------------------------
Method getPurchaseOrdersSuggested(cBranch As Character, cDocument As Character, cSerial As Character, cSupplier as Character, cStore as Character, cProduct as Character, lItems as Logical) class PurchaseOrdersSuggestedData
    Local JResponse                                   As Json
    Local JRespAux                                    As Json
    Local oQuery                                      As Object
    Local cQuery                                      As Character
    Local cAlias                                      As Character
    Local nParam        := 1                          As Numeric
    Local nCount                                      As Numeric
    Local aPoList       := {}                         As Array
    Local nI                                          As Numeric
    Local nJ                                          As Numeric
    Local JSuggestedPO                                As Json
    Local aProduct      := {}                         As Array
    Local nCKORecno                                   As Numeric
    Local nSDSRecno                                   As Numeric
    Local dIssueDate                                  As Date
    Local cSupplierName                               As Character    
    Local cSupplier                                   As Character
    Local cStore                                      As Character
    Local cType                                       As Character
    Local nMaxItems    := 5                           As Numeric
    Local nSizeItems                                  As Numeric
    Local jTypeDoc                                    As Json
    Local nTamDoc      := TamSx3("DS_DOC")[1]         As Numeric
    Local cDocSds      := PadL(cDocument,nTamDoc,"0") As Character
    Local cFilBkp      := cFilAnt                     As Character
    
    Default lItems     := .F. 
    Default cProduct   := ""
    
    JResponse   := JsonObject():New()
    JRespAux    := JsonObject():New()

    cFilAnt     := cBranch
    
    If lItems .And. !Empty(cProduct)
        AADD(aProduct, (cProduct))
    Else
        aProduct    := getProducts(cBranch, cDocSds, cSerial, cSupplier, cStore)
    Endif
    cQuery := "SELECT "
    cQuery += "     SDT.DT_FILIAL, SDT.DT_FORNEC, SDT.DT_LOJA, SDT.DT_DOC, SDT.DT_SERIE, "
    cQuery += "     SDT.DT_COD, SDT.DT_ITEM, SDS.DS_ARQUIVO, CKO_CODEDI, CKO.R_E_C_N_O_ AS RECNO_CKO, SDS.R_E_C_N_O_ AS RECNO_SDS "
    cQuery += "FROM " + RetSqlName("SDT") + " SDT "
    cQuery += "INNER JOIN " + RetSqlName("SDS") + " SDS ON "
    cQuery += "       ? AND "
    cQuery += "       SDS.DS_CNPJ   = SDT.DT_CNPJ   AND "
    cQuery += "       SDS.DS_FORNEC = SDT.DT_FORNEC AND "
    cQuery += "       SDS.DS_LOJA   = SDT.DT_LOJA   AND "
    cQuery += "       SDS.DS_DOC    = SDT.DT_DOC    AND "
    cQuery += "       SDS.DS_SERIE  = SDT.DT_SERIE "
    cQuery += "INNER JOIN " + RetSqlName("CKO") + " CKO ON "
    cQuery += "       ? AND "
    cQuery += "       CKO.CKO_ARQUIV = SDS.DS_ARQUIVO AND "
    cQuery += "       CKO.CKO_STATUS = ? AND "
    cQuery += "       CKO.D_E_L_E_T_ = ? "
    cQuery += "WHERE  DT_FILIAL = ? "
    cQuery += "  AND  DT_DOC    = ? "
    cQuery += "  AND  DT_SERIE  = ? "
    cQuery += "  AND  DT_FORNEC = ? "
    cQuery += "  AND  DT_LOJA   = ? "
    cQuery += "  AND  DT_PEDIDO = ? "
    If !Empty(cProduct) .And. lItems
        cQuery += "  AND  DT_COD    = ? "
    Endif
    cQuery += "  AND  SDS.D_E_L_E_T_ = ? "
    cQuery += "  AND  SDT.D_E_L_E_T_ = ? "
    cQuery += "  ORDER BY DT_COD "

    cQuery := ChangeQuery(cQuery)
    oQuery := FwExecStatement():New(cQuery)

    oQuery:SetUnsafe(nParam++, FWJoinFilial("SDS", "SDT"))
    oQuery:SetUnsafe(nParam++, FWJoinFilial("CKO", "SDS"))
    oQuery:SetString(nParam++, "2") 
    oQuery:SetString(nParam++, " ")    
    oQuery:SetString(nParam++, FWxFilial("SDT", cBranch))
    oQuery:SetString(nParam++, cDocSds)
    oQuery:SetString(nParam++, cSerial)
    oQuery:SetString(nParam++, cSupplier)
    oQuery:SetString(nParam++, cStore)
    oQuery:SetString(nParam++, "")
    If !Empty(cProduct) .And. lItems
        oQuery:SetString(nParam++, cProduct)
    Endif
    oQuery:SetString(nParam++, " ")
    oQuery:SetString(nParam++, " ")

    cAlias := oQuery:OpenAlias()

    JRespAux["items"]   := {}
    JResponse["items"]  := {}
    //Verifica o tipo de documento fiscal
    jTypeDoc := JsonObject():New()
    jTypeDoc["109"] := "NFE"
    jTypeDoc["214"] := "CTE"
    jTypeDoc["273"] := "CTEOS"
    jTypeDoc["319"] := "NFSE"

    (cAlias)->(dbGoTop())
    While (cAlias)->(!Eof()) .And. Len(aProduct) > 0

        cType := IIF(ValType(jTypeDoc[(cAlias)->CKO_CODEDI]) == "C",jTypeDoc[(cAlias)->CKO_CODEDI],"" )

        cSupplier       := (cAlias)->DT_FORNEC
        cStore          := (cAlias)->DT_LOJA
        nCKORecno       := (cAlias)->RECNO_CKO
        nSDSRecno       := (cAlias)->RECNO_SDS     
        cSupplierName   := Alltrim(Posicione("SA2",1,FWxFilial("SA2", cBranch)+cSupplier+cStore,"A2_NOME"))
        cStore          := (cAlias)->DT_LOJA
        nCount++

        If nCount == 1               
            If cType == "NFE" // Realiza a busca dos pedidos a partir do XML do documento fiscal
                aPoList := SearchPOxmltag(cBranch, nCKORecno, nSDSRecno,aProduct,cSupplier,cStore,lItems)             
                If Len(aPoList) == 0 //Caso não encontre pedidos de compra, realiza outro método de busca
                    aPoList := SearchPoSameSupplier(cBranch, aProduct, cSupplier, cStore,lItems, nSDSRecno)
                Endif
            Else  //Para documentos fiscais diferente de NFS, realiza outro método de busca
                aPoList := SearchPoSameSupplier(cBranch,aProduct, cSupplier, cStore,lItems, nSDSRecno)             
            Endif

            For nI := 1 to Len(aPoList)
                dIssueDate   := FWTimeStamp(5,aPoList[nI][2], "00:00:00")
                JSuggestedPO := JsonObject():New()
                JSuggestedPO["purchaseOrder"]    := aPoList[nI][1]
                JSuggestedPO["supplierCode"]     := cSupplier
                JSuggestedPO["supplierStore"]    := cStore
                JSuggestedPO["supplierName"]     := cSupplierName

                If lItems //Retorna os dados por pedido de compra e item 
                    JSuggestedPO["product"]      := aPoList[nI][6]
                    JSuggestedPO["description"]  := AllTrim(Posicione("SB1", 1, FWxFilial("SB1") + aPoList[nI][6], "B1_DESC"))  
                    JSuggestedPO["poitem"]       := aPoList[nI][7]                             
                Endif

                JSuggestedPO["issueDate"]        := dIssueDate
                JSuggestedPO["totalValue"]       := aPoList[nI][3]
                JSuggestedPO["quantityItems"]    := aPoList[nI][4]
                JSuggestedPO["matchpercentage"]  := aPoList[nI][5]
                aAdd(JRespAux["items"], JSuggestedPO)   
            Next nI
            
        EndIf
        (cAlias)->(dbSkip())
    Enddo

    If lItems 
        nMaxItems := 3
    EndIf

    nSizeItems := Min(Len(JRespAux["items"]), nMaxItems )
    For nJ := 1 To nSizeItems
        AAdd(JResponse["items"], JRespAux["items"][nJ])
    Next

    (cAlias)->(DbCloseArea())

    oQuery:Destroy()

    cFilAnt := cFilBkp

    FWFreeArray(aProduct)
    FWFreeArray(aPoList)
    FWFreeObj(oQuery)
    FwFreeObj(JRespAux)
    FreeObj(jTypeDoc)

Return JResponse

//------------------------------------------------------------------------------
/*/ {Protheus.doc} getProducts
    Função que retorna os codigos de produtos dos itens do documento fiscal.

    @author Squad PIF
    @version 1.0
    @param cBranch, Character, filial do documento fiscal
    @param cDocSds, Character, numero do documento fiscal na tabela SDS
    @param cSerial, Character, serie do documento fiscal   
    @param cSupplier, Character, fornecedor do documento fiscal      
    @param cStore, Character, loja do documento fiscal
    @return Array, Array os codigos de produtos
/*/
//------------------------------------------------------------------------------
Static Function getProducts(cBranch As Character, cDocSds As Character, cSerial As Character, cSupplier as Character, cStore as Character )

    Local oQrySDT               As Object
    Local cQrySDT               As Character
    Local cAliasSDT             As Character
    Local nParam        := 1    As Numeric
    Local aProduct      := {}   As Array

    cQrySDT := " SELECT DISTINCT DT_COD AS PRODUTO FROM " + RetSqlName("SDT") + " "
    cQrySDT += " WHERE DT_FILIAL = ? "
    cQrySDT += "   AND DT_DOC    = ? AND DT_SERIE  = ? AND DT_FORNEC = ? AND DT_LOJA = ? "
    cQrySDT += "   AND DT_COD    <> ? "
    cQrySDT += "   AND D_E_L_E_T_ = ? "
    
    cQrySDT := ChangeQuery(cQrySDT)
    oQrySDT := FwExecStatement():New(cQrySDT)
    
    oQrySDT:SetString(nParam++, FWxFilial("SDT", cBranch))
    oQrySDT:SetString(nParam++, cDocSds)
    oQrySDT:SetString(nParam++, cSerial)
    oQrySDT:SetString(nParam++, cSupplier) 
    oQrySDT:SetString(nParam++, cStore   )
    oQrySDT:SetString(nParam++, " ")
    oQrySDT:SetString(nParam++, " ")
    
    cAliasSDT := oQrySDT:OpenAlias()

    (cAliasSDT)->(dbGoTop())
    While (cAliasSDT)->(!Eof())
        aAdd(aProduct, Alltrim((cAliasSDT)->PRODUTO))  
        (cAliasSDT)->(dbSkip())
    EndDo    
    (cAliasSDT)->(DbCloseArea())

    oQrySDT:Destroy()
    FWFreeObj(oQrySDT)

Return aProduct

//------------------------------------------------------------------------------
/*/ {Protheus.doc} SearchPOxmltag
    Função que retorna os pedido de compra informados na tag <xPed> do documento 
    fiscal.

    @author Squad PIF
    @version 1.0
    @param cBranch, Character, filial do documento fiscal
    @param nCKORecno, Numeric, número do registro na tabela CKO
    @param nSDSRecno, Numeric, número do registro na tabela SDS
    @param aProduct, Array, lista dos produtos (itens) do documento fiscal
    @param cSupplier, Character, serie do fornecedor do documento fiscal     
    @param cStore, Character, loja do fornecedor do documento fiscal
    @param lItems, Logical, indica se a pesquisa retornará os dados por item do pedido
    @return Array, Array os pedidos de compra encontrados
/*/
//------------------------------------------------------------------------------
Static Function SearchPOxmltag(cBranch, nCKORecno As Numeric, nSDSRecno As Numeric, aProduct As Array, cSupplier As Character, cStore As Character, lItems as Logical)

    Local lFound                As Logical
    Local oXml                  As Object
    Local oAuxXML               As Object
    Local aXmlDet   := {}       As Array
    Local nI                    As Numeric
    Local nX                    As Numeric
    Local cXmlFile              As Character
    Local cPoXmlTag             As Character
    Local cPoProdXmlTag         As Character
    Local cPoItemXmlTag         As Character
    Local cError                As Character 
    Local cWarning              As Character
    Local aPoXml    := {}       As Array
    Local nMatch    := 100      As Numeric     
    Local aRetPo    := {}       As Array
    Local nQtyItems             As Numeric
    Local nPos                  As Numeric
    Local aTotPO    := {}       As Array  
    Local nSizeProdField        := TamSx3("C7_PRODUTO")[1]  As Numeric
    Local nSizePoField          := TamSx3("C7_NUM")[1]  As Numeric   
    Local nSizePoItemField      := TamSx3("C7_ITEM")[1]  As Numeric
    Local cQryPoXml             As Character
    Local oQryPoXml             As Object
    Local cAliasPoXml           As Character
    Local nParam                As Numeric
    Local aPoXmlAux    := {}    As Array 
           
    DbSelectArea("CKO")
    CKO->(DbGoTo(nCKORecno))
    cXmlFile := CKO->CKO_XMLRET

    If ("</NFE>" $ Upper(cXmlFile)) 
        If ("</XPED>" $ Upper(cXmlFile))
            oXML := XmlParser(cXmlFile,"_",@cError,@cWarning) 
            If !Empty(oXML) .and. Empty(cError)
                lFound := .F.
                While !lFound
                    oAuxXML := XmlChildEx(oAuxXML,"_NFE")
                    If !(lFound := oAuxXML # NIL)
                        For nI := 1 To XmlChildCount(oXML)
                            oAuxXML  := XmlChildEx(XmlGetchild(oXML,nI),"_NFE")
                            lFound := oAuxXML:_InfNfe# Nil
                            If lFound
                                oXML := oAuxXML
                                Exit
                            EndIf
                        Next nX
                    EndIf				
                    If lFound
                        Exit
                    EndIf
                EndDo			
                //Armazena os itens da tag DET do XML no array
                aXmlDet := IIF(ValType(oXML:_InfNfe:_Det) == "O",{oXML:_InfNfe:_Det},oXML:_InfNfe:_Det)
                                          
                For nI := 1 to Len(aXmlDet)
                    //Forma os valores dos campos informados no XML
                    If ValType(XmlChildEx(aXmlDet[nI]:_Prod,"_XPED")) == "O" 
                        cPoXmlTag :=  aXmlDet[nI]:_Prod:_xPed:Text
                        cPoXmlTag := Iif (Len(cPoXmlTag) > nSizePoField,LEFT(cPoXmlTag,nSizePoField), PADR(cPoXmlTag,nSizePoField) )
                    EndIf  
                    If ValType(XmlChildEx(aXmlDet[nI]:_Prod,"_NITEMPED")) == "O"
                        cPoItemXmlTag := aXmlDet[nI]:_Prod:_nItemPed:Text
                        cPoItemXmlTag := Iif (Len(cPoItemXmlTag) > nSizePoItemField,LEFT(cPoItemXmlTag,nSizePoItemField), PADL(cPoItemXmlTag,nSizePoItemField,"0") )                                          
                    EndIf                                   
                    If ValType(XmlChildEx(aXmlDet[nI]:_Prod,"_CPROD")) == "O"
                        cPoProdXmlTag   := aXmlDet[nI]:_Prod:_cProd:Text
                        cPoProdXmlTag   := Iif (Len(cPoProdXmlTag) > nSizeProdField,LEFT(cPoProdXmlTag,nSizeProdField), PADR(cPoProdXmlTag,nSizeProdField) )
                    EndIf                
                    For nX := 1 to Len(aProduct) //Verifica se o produto do item do XML está na lista de produtos do documento fiscal                     
                        If Alltrim(cPoProdXmlTag) == aProduct[nX]
                            //Cria um array auxiliar só com os itens encontrados no XML e que correspondem aos produtos do documento fiscal
                            AADD(aPoXmlAux,{ cPoXmlTag, cPoItemXmlTag, cPoProdXmlTag } ) //1-Pedido de Compra, 2-Item do Pedido, 3-Produto
                            Exit
                        EndIf
                    Next                   
                Next nI  
                //Percorre o array com os pedidos de compra do XML e busca os dados na tabela SC7                
                For nI := 1 to Len(aPoXmlAux)   
                    cQryPoXml := " SELECT C7_NUM, C7_EMISSAO, C7_TOTAL, C7_QUANT, C7_ITEM, C7_PRODUTO "
                    cQryPoXml += " FROM " + RetSqlName("SC7") + " SC7 "
                    cQryPoXml += " WHERE SC7.C7_FILIAL = ? "
                    cQryPoXml += "   AND SC7.C7_NUM = ? "
                    
                    If lItems //Pesquisa por item do pedido de compra
                        cQryPoXml += "   AND SC7.C7_PRODUTO = ? "
                    Endif
                    
                    cQryPoXml += "   AND SC7.D_E_L_E_T_ = ? "
                    cQryPoXml += "   AND NOT EXISTS ( "
                    cQryPoXml += "       SELECT 1 "
                    cQryPoXml += "       FROM " + RetSqlName("SDS") + " SDS "
                    cQryPoXml += "       INNER JOIN " + RetSqlName("SDT") + " SDT "
                    cQryPoXml += "         ON SDT.DT_DOC       = SDS.DS_DOC "
                    cQryPoXml += "         AND SDT.DT_SERIE  = SDS.DS_SERIE "
                    cQryPoXml += "         AND SDT.DT_FORNEC = SDS.DS_FORNEC "
                    cQryPoXml += "         AND SDT.DT_LOJA   = SDS.DS_LOJA "
                    cQryPoXml += "         AND SDT.DT_PEDIDO = SC7.C7_NUM "

                    If lItems //Pesquisa por item do pedido de compra
                        cQryPoXml += "     AND SDT.DT_ITEMPC = SC7.C7_ITEM "
                    Endif

                    cQryPoXml += "        WHERE SDS.R_E_C_N_O_ = ?   "
                    cQryPoXml += "        AND SDT.D_E_L_E_T_   = ?   "
                    cQryPoXml += "        AND SDS.D_E_L_E_T_   = ? ) "

                    cQryPoXml := ChangeQuery(cQryPoXml)
                    oQryPoXml := FwExecStatement():New(cQryPoXml)  

                    nParam    := 1
                    oQryPoXml:SetString(nParam++, FWxFilial("SC7", cBranch) )
                    oQryPoXml:SetString(nParam++, aPoXmlAux[nI][1] )

                    If lItems //Pesquisa por item do pedido de compra
                        oQryPoXml:SetString(nParam++, aPoXmlAux[nI][3] )
                    Endif

                    oQryPoXml:SetString(nParam++, " " )
                    oQryPoXml:SetNumeric(nParam++, nSDSRecno )
                    oQryPoXml:SetString(nParam++, " " )
                    oQryPoXml:SetString(nParam++, " " )
                    
                    cAliasPoXml := oQryPoXml:OpenAlias()
                    
                    (cAliasPoXml)->(dbGoTop())
                    While (cAliasPoXml)->(!Eof())  
                        aAdd(aPoXml,{ (cAliasPoXml)->C7_NUM,;//1-Pedido de Compra
                        STOD((cAliasPoXml)->C7_EMISSAO),;    //2-Emissão
                        (cAliasPoXml)->C7_TOTAL,;            //3-Total  (do item)
                        (cAliasPoXml)->C7_QUANT,;            //4-Quantidade (do item)
                        0,;                                  //5-Percentual de correspondencia
                        (cAliasPoXml)->C7_PRODUTO,;          //6-Produto
                        (cAliasPoXml)->C7_ITEM })            //7-Item  
                        (cAliasPoXml)->(dbSkip())                        
                    Enddo
                Next nI
 
            EndIf
        Endif
    EndIf   
    If Len(aPoXml) > 0
        aSort(aPoXml,,,{|x,y| x[1] < y[1] })
        nQtyItems := 0
        For nI := 1 to Len(aPoXml)   
            If !lItems //Retorna os dados por pedido compra
                aTotPO  := getTotalPo(cBranch, aPoXml[nI][1])         
                nPos    := aScan( aRetPo, { |x| x[1] == aPoXml[nI][1] } )
                If  nPos == 0 //Monta array com os dados do pedido de compra
                    aAdd(aRetPo,{aPoXml[nI][1],; //1-Pedido
                        aPoXml[nI][2],;          //2-Data de emissao
                        aTotPO[1],;              //3-Valor total (dos itens)
                        aTotPO[2],;              //4-Qtd (soma) itens do pedido
                        nMatch,;                 //5-Percentual de correspondencia
                        "",;                     //6-Produto
                        ""})                     //7-Item 
                EndIf
            Else //Retorna os dados por pedido de compra e item
                aAdd(aRetPo,{aPoXml[nI][1],;     //1-Pedido
                    aPoXml[nI][2],;              //2-Data de emissao
                    aPoXml[nI][3],;              //3-Valor total (do item)
                    aPoXml[nI][4],;              //4-Qtd (do item)
                    nMatch,;                     //5-Percentual de correspondencia
                    aPoXml[nI][6],;              //6-Produto
                    aPoXml[nI][7]})              //7-Item                                 
            Endif
        Next nI
    Endif   
    If !lItems
        ASort(aRetPo,,,{|x,y| x[5] > y[5] }) //Ordena pelo percentual de correspondencia
    Else
        ASort(aRetPo,,,{|x,y| x[7] > y[7] }) //Ordena pelo item do pedido
    Endif
    FWFreeArray(aXmlDet)
    FWFreeArray(aPoXml)
    FWFreeArray(aTotPO)
    FWFreeArray(aPoXmlAux)
    FWFreeObj(oXml)
    FWFreeObj(oAuxXML)

Return aRetPo

//------------------------------------------------------------------------------
/*/ {Protheus.doc} getTotalPo
    Função que retorna o valor total e quantidade de itens do pedido de compra.

    @author Squad PIF
    @version 1.0
    @param cPoNumber, Character, numero do pedido de compra
    @return Array, Array com valor total do pedido e total de itens do pedido 
/*/
//------------------------------------------------------------------------------
Static Function getTotalPo(cBranch As Character, cPoNumber As Character )

    Local oQryTot               As Object
    Local cQryTot               As Character
    Local cAliasTot             As Character
    Local nParam        := 1    As Numeric
    Local nTot                  As Numeric
    Local nQty                  As Numeric

    cQryTot := " SELECT SUM(SC7.C7_TOTAL) AS TOTAL, COUNT(*) AS QTY "
    cQryTot += " FROM " + RetSqlName("SC7") + " SC7 "
    cQryTot += " WHERE SC7.C7_FILIAL  = ? "
    cQryTot += "   AND SC7.C7_NUM     = ? "
    cQryTot += "   AND SC7.D_E_L_E_T_ = ? "

    cQryTot := ChangeQuery(cQryTot)
    oQryTot := FwExecStatement():New(cQryTot)
    
    oQryTot:SetString(nParam++, FWxFilial("SC7", cBranch))
    oQryTot:SetString(nParam++, cPoNumber)
    oQryTot:SetString(nParam++, " ")
    
    cAliasTot := oQryTot:OpenAlias()

    If (cAliasTot)->(!Eof())
        nTot := (cAliasTot)->TOTAL
        nQty := (cAliasTot)->QTY
    Endif

    (cAliasTot)->(DbCloseArea())
    
    oQryTot:Destroy()
    FWFreeObj(oQryTot)

Return {nTot, nQty}

//------------------------------------------------------------------------------
/*/ {Protheus.doc} SearchPoSameSupplier
    Função que retorna os pedido de compra do mesmo fornecedor/produto quando 
    não for possivel localizar pelo xml do documento fiscal

    @author Squad PIF
    @version 1.0
    @param cBranch, Character, filial do documento fiscal
    @param aProduct, Array, lista dos produtos (itens) do documento fiscal
    @param cSupplier, Character, serie do fornecedor do documento fiscal     
    @param cStore, Character, loja do fornecedor do documento fiscal
    @param lItems, Logical, indica se a pesquisa retornará os dados por item do pedido    
    @param nSDSRecno, Numeric, número de registro do documento fiscal
    @return Array, Array os pedidos de compra encontrados
/*/
//------------------------------------------------------------------------------

Static Function SearchPoSameSupplier(cBranch As Character,aProduct As Array, cSupplier as Character, cStore as Character, lItems as Logical, nSDSRecno as Numeric)

    Local oExec                                     As Object
    Local cQuery                                    As Character
    Local cAlias                                    As Character
    Local cFilSC7   := FWxFilial("SC7", cBranch)    As Character
    Local aPoFound  := {}                           As Array
    Local nParam    := 1                            As Numeric
    Local nValPerc  := 98.0                         As Numeric 
    Local nMatch                                    As Numeric            

    cQuery := " SELECT C7_NUM, C7_EMISSAO, " 
    If !lItems //Pesquisa por pedido compra
        cQuery += " SUM(C7_TOTAL) AS TOTAL_PO, COUNT(C7_ITEM) AS QTY_ITEMS "
    Else //Pesquisa por pedido e item
        cQuery += " C7_TOTAL , C7_QUANT, C7_ITEM, C7_PRODUTO , "
        cQuery += " (SELECT B1_DESC FROM " + RetSqlName("SB1") + " SB1 "
        cQuery += "  WHERE B1_COD = C7_PRODUTO AND D_E_L_E_T_ = ? ) AS B1_DESC " 
    Endif
    cQuery += " FROM " + RetSqlName("SC7") + " SC7 "
    cQuery += " WHERE SC7.C7_FILIAL     = ?  "
    cQuery += "   AND SC7.C7_PRODUTO  IN (?) "
    cQuery += "   AND SC7.C7_FORNECE  = ? "
    cQuery += "   AND SC7.C7_LOJA     = ? " 
    cQuery += "   AND SC7.D_E_L_E_T_  = ? "

    If !lItems
        cQuery += " AND NOT EXISTS ( "
        cQuery += "     SELECT 1 "
        cQuery += "     FROM " + RetSqlName("SDS") + " SDS "
        cQuery += "     INNER JOIN " + RetSqlName("SDT") + " SDT "
        cQuery += "       ON SDT.DT_DOC      = SDS.DS_DOC "
        cQuery += "       AND SDT.DT_SERIE   = SDS.DS_SERIE "
        cQuery += "       AND SDT.DT_FORNEC  = SDS.DS_FORNEC "
        cQuery += "       AND SDT.DT_LOJA    = SDS.DS_LOJA "
        cQuery += "       AND SDT.DT_PEDIDO  = SC7.C7_NUM "
        cQuery += "       AND SDT.D_E_L_E_T_   = ?   "
        cQuery += "     WHERE SDS.R_E_C_N_O_   = ?   "
        cQuery += "       AND SDS.D_E_L_E_T_   = ? ) "
        cQuery += " GROUP BY C7_NUM, C7_EMISSAO " 
        cQuery += " HAVING SUM(CASE WHEN (C7_QUANT - C7_QUJE) > ? AND (C7_RESIDUO IS NULL OR C7_RESIDUO = ?) THEN 1 ELSE ? END) > ? "
        cQuery += " ORDER BY C7_EMISSAO, C7_NUM "
    Else
        cQuery += " AND (C7_QUANT - C7_QUJE) > ? AND (C7_RESIDUO IS NULL OR C7_RESIDUO = ?) "
        cQuery += " AND SC7.D_E_L_E_T_  = ? "
        cQuery += " AND NOT EXISTS ( "
        cQuery += "     SELECT 1 "
        cQuery += "     FROM " + RetSqlName("SDS") + " SDS "
        cQuery += "     INNER JOIN " + RetSqlName("SDT") + " SDT "
        cQuery += "       ON SDT.DT_DOC      = SDS.DS_DOC "
        cQuery += "       AND SDT.DT_SERIE   = SDS.DS_SERIE "
        cQuery += "       AND SDT.DT_FORNEC  = SDS.DS_FORNEC "
        cQuery += "       AND SDT.DT_LOJA    = SDS.DS_LOJA "
        cQuery += "       AND SDT.DT_PEDIDO  = SC7.C7_NUM "
        cQuery += "       AND SDT.DT_ITEMPC  = SC7.C7_ITEM "
        cQuery += "       AND SDT.D_E_L_E_T_ = ?   "
        cQuery += "     WHERE SDS.R_E_C_N_O_ = ?   "
        cQuery += "       AND SDS.D_E_L_E_T_ = ? ) "
        cQuery += " ORDER BY C7_NUM, C7_ITEM "
    Endif

    cQuery  := ChangeQuery(cQuery)
    oExec   := FwExecStatement():New(cQuery)  

    If lItems
        oExec:SetString(nParam++, ' ')  
    Endif

    oExec:SetString(nParam++, cFilSC7)
    oExec:setIn( nParam++ , aProduct)
    oExec:SetString(nParam++, cSupplier)
    oExec:SetString(nParam++, cStore)
    oExec:SetString(nParam++, ' ')

    If !lItems
        oExec:SetString(nParam++, ' ')
        oExec:SetNumeric(nParam++, nSDSRecno)
        oExec:SetString(nParam++, ' ')
        oExec:SetNumeric(nParam++, 0)
        oExec:SetString(nParam++, ' ')
        oExec:SetNumeric(nParam++, 0)
        oExec:SetNumeric(nParam++, 0)
    Else
        oExec:SetNumeric(nParam++, 0)
        oExec:SetString(nParam++, ' ')
        oExec:SetString(nParam++, ' ')
        oExec:SetString(nParam++, ' ')
        oExec:SetNumeric(nParam++, nSDSRecno)
        oExec:SetString(nParam++, ' ')
    Endif

    cAlias := oExec:OpenAlias()

    If (cAlias)->(!Eof())
        While (cAlias)->(!Eof())       
            nMatch          := getPercentagePoMatch(cFilSC7, aProduct,cSupplier,cStore,(cAlias)->C7_NUM,nValPerc)
            If !lItems //Retorna a pesquisa por pedido compra
                aAdd(aPoFound,{(cAlias)->C7_NUM,;//1-Pedido               
                    STOD((cAlias)->C7_EMISSAO),; //2-Data de emissao
                    (cAlias)->TOTAL_PO,;         //3-Valor Total (do Pedido)
                    (cAlias)->QTY_ITEMS,;        //4-Qtd Total (do Pedido)
                    nMatch,;                    //5-Percentual de correspondencia
                    "",;                        //6-Produto
                    "",;                        //7-Item
                    })
            Else //Retorna a pesquisa por pedido compra e item
                aAdd(aPoFound,{(cAlias)->C7_NUM,;//1-Pedido
                    STOD((cAlias)->C7_EMISSAO),; //2-Data de emissao
                    (cAlias)->C7_TOTAL,;         //3-Valor total (do item)
                    (cAlias)->C7_QUANT,;         //4-Qtd (do item)
                    nMatch,;                     //5-Percentual de correspondencia
                    Alltrim((cAlias)->C7_PRODUTO),;//6-Produto
                    (cAlias)->C7_ITEM,;          //7-Item
                    } )  
            Endif           
            (cAlias)->(dbSkip())      
        Enddo        
    Else
        //Se não encontrar, pesquisa pela amarração de entrega por terceiros
        aPoFound := SearchPoSupplierCPX(cFilSC7, aProduct, cSupplier, cStore, lItems, nSDSRecno)
    Endif  
    If Len(aPoFound) > 1
        ASort(aPoFound,,,{|x,y| x[5] > y[5] })   
    Endif
    (cAlias)->(DbCloseArea())

   oExec:Destroy()
   FWFreeObj(oExec)

Return aPoFound

//------------------------------------------------------------------------------
/*/ {Protheus.doc} SearchPoSupplierCPX
    Função que retorna pedidos de compra de outros fornecedores que possuam
    amarração dentro da rotina de entrega por terceiros (COMA001).

    @author Squad PIF
    @version 1.0
    @param cBranch, Character, filial do documento fiscal
    @param aProduct, Array, lista dos produtos (itens) do documento fiscal
    @param cSupplier, Character, serie do fornecedor do documento fiscal     
    @param cStore, Character, loja do fornecedor do documento fiscal
    @param lItems, Logical, indica se a pesquisa retornará os dados por item do pedido  
    @param nSDSRecno, Numeric, recno da SDS
    @return Array, Array os pedidos de compra encontrados
/*/
//------------------------------------------------------------------------------
Static Function SearchPoSupplierCPX(cBranch As Character, aProduct As Array, cSupplier as Character, cStore as Character, lItems as Logical, nSDSRecno as Numeric)

    Local oSearchPoSupplierCPX                   As Object
    Local cQuery                   As Character
    Local cAliasPoSupplierCPX                    As Character
    Local cFilSC7   := FwxFilial("SC7", cBranch) As Character
    Local cFilSA5   := FwxFilial("SA5", cBranch) As Character
    Local aPoFound  := {}                        As Array
    Local nParam    := 1                         As Numeric
    Local nMatch                                 As Numeric
	Local nMinPercMatch := 0                     As Numeric 

    cQuery := " SELECT  C7_NUM, C7_EMISSAO, " 
    If !(lItems) //Pesquisa por pedido compra
        cQuery += " SUM(C7_TOTAL) AS TOTAL_PO, "
        cQuery += " CASE "
        cQuery += "   WHEN( SUM(C7_QUJE) > ? ) THEN ? ELSE ? END AS MIN_PERCENT, COUNT(C7_ITEM) AS QTY_ITEMS "
    Else //Pesquisa por pedido de compra e item
        cQuery += " CASE WHEN(C7_QUJE) > ?  THEN ? ELSE ? END AS MIN_PERCENT, "
        cQuery += " C7_TOTAL , C7_QUANT, C7_ITEM, C7_PRODUTO, "
        cQuery += " (SELECT B1_DESC FROM " + RetSqlName("SB1") + " SB1 "
        cQuery += " WHERE B1_COD = C7_PRODUTO AND D_E_L_E_T_ = ? ) AS B1_DESC " 
    Endif

    cQuery += " FROM " + RetSqlName("SC7") + " SC7 "
    cQuery += " WHERE SC7.C7_FILIAL     = ?  "
    cQuery += "     AND SC7.C7_PRODUTO IN (" 
    cQuery += "       SELECT A5_PRODUTO FROM " + RetSqlName("SA5") + " SA5 " 
    cQuery += "       WHERE A5_FILIAL  = ? AND A5_FORNECE = ? AND A5_LOJA = ? "    
    cQuery += "           AND A5_PRODUTO IN (?) "    
    cQuery += "           AND SA5.D_E_L_E_T_  = ?  "    
    cQuery += "       )  "     
    cQuery += "     AND SC7.C7_FORNECE  " 
    cQuery += "     IN ( "
	cQuery += "		SELECT CPX_CODFOR FROM  " + RetSqlName("CPX") + " CPX " 
	cQuery += "		WHERE CPX_CODIGO = ? AND CPX_LOJA = ? ) "

    If !(lItems) //Pesquisa por pedido compra
        cQuery += " AND SC7.D_E_L_E_T_  = ? "
        cQuery += " AND NOT EXISTS ( "
        cQuery += "     SELECT 1 "
        cQuery += "     FROM " + RetSqlName("SDS") + " SDS "
        cQuery += "     INNER JOIN " + RetSqlName("SDT") + " SDT "
        cQuery += "       ON SDT.DT_DOC      = SDS.DS_DOC "
        cQuery += "       AND SDT.DT_SERIE   = SDS.DS_SERIE "
        cQuery += "       AND SDT.DT_FORNEC  = SDS.DS_FORNEC "
        cQuery += "       AND SDT.DT_LOJA    = SDS.DS_LOJA "
        cQuery += "       AND SDT.DT_PEDIDO  = SC7.C7_NUM "
        cQuery += "       AND SDT.D_E_L_E_T_ = ?   "
        cQuery += "     WHERE SDS.R_E_C_N_O_ = ?   "
        cQuery += "       AND SDS.D_E_L_E_T_ = ? ) "
        cQuery += " GROUP BY C7_NUM, C7_EMISSAO " 
        cQuery += " HAVING SUM(CASE WHEN (C7_QUANT - C7_QUJE) > ? AND (C7_RESIDUO IS NULL OR C7_RESIDUO = ?) THEN 1 ELSE ? END) > ? "
        cQuery += " ORDER BY C7_EMISSAO, C7_NUM "
    Else //Pesquisa por pedido de compra e item
        cQuery += " AND (C7_QUANT - C7_QUJE) > ? AND (C7_RESIDUO IS NULL OR C7_RESIDUO = ?) "
        cQuery += " AND SC7.D_E_L_E_T_  = ? "
        cQuery += " AND NOT EXISTS ( "
        cQuery += "     SELECT 1 "
        cQuery += "     FROM " + RetSqlName("SDS") + " SDS "
        cQuery += "     INNER JOIN " + RetSqlName("SDT") + " SDT "
        cQuery += "       ON SDT.DT_DOC      = SDS.DS_DOC "
        cQuery += "       AND SDT.DT_SERIE   = SDS.DS_SERIE "
        cQuery += "       AND SDT.DT_FORNEC  = SDS.DS_FORNEC "
        cQuery += "       AND SDT.DT_LOJA    = SDS.DS_LOJA "
        cQuery += "       AND SDT.DT_PEDIDO  = SC7.C7_NUM "
        cQuery += "       AND SDT.DT_ITEMPC  = SC7.C7_ITEM "
        cQuery += "       AND SDT.D_E_L_E_T_ = ?   "
        cQuery += "     WHERE SDS.R_E_C_N_O_ = ?   "
        cQuery += "       AND SDS.D_E_L_E_T_ = ? ) "
        cQuery += " ORDER BY C7_NUM, C7_ITEM "
    Endif

    cQuery := ChangeQuery(cQuery)
    oSearchPoSupplierCPX := FwExecStatement():New(cQuery)  
    oSearchPoSupplierCPX:SetNumeric(nParam++, 0)
    oSearchPoSupplierCPX:SetNumeric(nParam++, 83.0)
    oSearchPoSupplierCPX:SetNumeric(nParam++, 89.0)

    If lItems
        oSearchPoSupplierCPX:SetString(nParam++, ' ')
    Endif   

    oSearchPoSupplierCPX:SetString(nParam++, cFilSC7) 
    oSearchPoSupplierCPX:SetString(nParam++, cFilSA5)  
    oSearchPoSupplierCPX:SetString(nParam++, cSupplier)
    oSearchPoSupplierCPX:SetString(nParam++, cStore)           
    oSearchPoSupplierCPX:setIn(nParam++ , aProduct)
    oSearchPoSupplierCPX:SetString(nParam++, ' ')    
    oSearchPoSupplierCPX:SetString(nParam++, cSupplier)
    oSearchPoSupplierCPX:SetString(nParam++, cStore)  

    If !(lItems)   
        oSearchPoSupplierCPX:SetString(nParam++, ' ')
        oSearchPoSupplierCPX:SetString(nParam++, ' ')
        oSearchPoSupplierCPX:SetNumeric(nParam++, nSDSRecno)
        oSearchPoSupplierCPX:SetString(nParam++, ' ')
        oSearchPoSupplierCPX:SetNumeric(nParam++, 0)
        oSearchPoSupplierCPX:SetString(nParam++, ' ')
        oSearchPoSupplierCPX:SetNumeric(nParam++, 0)
        oSearchPoSupplierCPX:SetNumeric(nParam++, 0)
    Else
        oSearchPoSupplierCPX:SetNumeric(nParam++, 0)
        oSearchPoSupplierCPX:SetString(nParam++, ' ')
        oSearchPoSupplierCPX:SetString(nParam++, ' ')
        oSearchPoSupplierCPX:SetString(nParam++, ' ')
        oSearchPoSupplierCPX:SetNumeric(nParam++, nSDSRecno)
        oSearchPoSupplierCPX:SetString(nParam++, ' ')
    Endif

    cAliasPoSupplierCPX := oSearchPoSupplierCPX:OpenAlias()    
    (cAliasPoSupplierCPX)->(dbGoTop())

    While (cAliasPoSupplierCPX)->(!Eof())     
        nMinPercMatch   := Val((cAliasPoSupplierCPX)->MIN_PERCENT)
        cSupplier       := Alltrim(Posicione("SC7",1,cFilSC7+(cAliasPoSupplierCPX)->C7_NUM,"C7_FORNECE"))
        cStore          := Alltrim(Posicione("SC7",1,cFilSC7+(cAliasPoSupplierCPX)->C7_NUM,"C7_LOJA"))
        nMatch          := getPercentagePoMatch(cBranch, aProduct,cSupplier,cStore,(cAliasPoSupplierCPX)->C7_NUM, nMinPercMatch )
        If !lItems
            aAdd(aPoFound,{(cAliasPoSupplierCPX)->C7_NUM,;   //1-Pedido 
                 STOD((cAliasPoSupplierCPX)->C7_EMISSAO),;   //2-Data de emissao
                 (cAliasPoSupplierCPX)->TOTAL_PO,;           //3-Valor Total (do Pedido)
                 (cAliasPoSupplierCPX)->QTY_ITEMS,;          //4-Qtd total (do Pedido)
                 nMatch,;                                    //5-Percentual de correspondencia
                 "",;                                        //6-Produto
                 "",;                                        //7-Item
                 })
        Else   
            aAdd(aPoFound,{(cAliasPoSupplierCPX)->C7_NUM,;  //1-Pedido
                STOD((cAliasPoSupplierCPX)->C7_EMISSAO),;   //2-Data de emissao
                (cAliasPoSupplierCPX)->C7_TOTAL,;           //3-Valor total (do item)
                (cAliasPoSupplierCPX)->C7_QUANT,;           //4-Qtd (do item)
                nMatch,;                                    //5-Percentual de correspondencia
                (cAliasPoSupplierCPX)->C7_PRODUTO,;         //6-Produto
                (cAliasPoSupplierCPX)->C7_ITEM,;            //7-Item
                })
        Endif       
        (cAliasPoSupplierCPX)->(dbSkip())      
    Enddo
    
    ASort(aPoFound,,,{|x,y| x[5] > y[5] })

    oSearchPoSupplierCPX:Destroy()
    FWFreeObj(oSearchPoSupplierCPX)

Return aPoFound

//------------------------------------------------------------------------------
/*/ {Protheus.doc} getPercentagePoMatch
    Função que retorna os percentual de correspondencia do pedido de compra com
    o documento fiscal a ser importado

    @author Squad PIF
    @version 1.0
    @param cBranch, Character, filial do documento fiscal
    @param aProduct, Array, lista dos produtos (itens) do documento fiscal
    @param cSupplier, Character, serie do fornecedor do documento fiscal     
    @param cStore, Character, loja do fornecedor do documento fiscal
    @param cPoNumber, Character, pedido de compra a ser pesquisado
    @param nValPerc, Numeric, Percentual base de correspondencia
    @return Numeric, valor percentual de correspondencia do pedido
/*/
//------------------------------------------------------------------------------
Static Function getPercentagePoMatch(cBranch As Character, aProduct As Array, cSupplier as Character, cStore as Character, cPoNumber As Character, nValPerc as Numeric)

    Local nI                    As Numeric       
    Local cProduto              As Character
    Local nMatch     := 0       As Numeric
    Local nNotFounds := 0       As Numeric
    Local lFound     := .F.     As Logical

    DbSelectArea("SC7")
    SC7->(dbSetOrder(1)) //produto + fornecedor + loja + pedido

    cBranch    := PadR(FWxFilial("SC7", cBranch), TamSx3("C7_FILIAL")[1])
    cSupplier  := PadR(cSupplier, TamSx3("C7_FORNECE")[1])
    cStore     := PadR(cStore, TamSx3("C7_LOJA")[1])
    cPoNumber  := PadR(cPoNumber, TamSx3("C7_NUM")[1])

    For nI := 1 to Len(aProduct)
        
        cProduto := aProduct[nI] 
        cProduto := PadR(aProduct[nI] , TamSx3("C7_PRODUTO")[1])
        lFound   := .F. 

        If SC7->(dbSeek(FWxFilial("SC7", cBranch) + cPoNumber))          
            While SC7->(!Eof()) .And. SC7->C7_FILIAL == FWxFilial("SC7", cBranch) .And. SC7->C7_NUM == cPoNumber
                If SC7->C7_PRODUTO == cProduto .And. (SC7->C7_QUANT - SC7->C7_QUJE) > 0 .And. EMPTY(SC7->C7_RESIDUO)
                    lFound := .T.
                    Exit
                EndIf          
                    
                SC7->(dbSkip())
            EndDo
        EndIf     

        If !lFound
            nNotFounds++ // Deduz 1 ponto
        EndIf       
    Next nI
    nMatch := nValPerc - nNotFounds

Return nMatch

//------------------------------------------------------------------------------
/*{Protheus.doc} getPurchaseOrdersManually
    Metodo responsável por obter a lista de Pedidos de Compra em aberto

    @type Method
    @author Squad PIF
    @version 1.0
    @param cBranch, Character, filial do documento fiscal
    @param nPage, numeric, numero da pagina
	@param nPageSize, numeric, Quantidade de registros por pagina
    @param cFilter, Character, filtro
    @param lItems, Logical, indica o retorno de items do Pedido 
    @return Json, retorna o objeto json contendo os NCM Ajustados
*/
//------------------------------------------------------------------------------
Method getPurchaseOrdersManually(cBranch As Character, nPage As Numeric, nPageSize As Numeric, cFilter As Character, lItems As Logical) class PurchaseOrdersSuggestedData
	Local cWhere       As Character
	Local aArea        As Array
    Local aURLFilter   As Array
    Local lLinked      As Logical

	Default nPage      := 1
	Default nPageSize  := 10
    Default lItems     := .F.

	aArea      := FWGetArea()
	cWhere     := ""
    aURLFilter := {}
    lLinked    := .F.

	addMapFieldsPurchaseOrders(self, lItems, lLinked)

	::setUseSpaces(.T.)
	::setPage(nPage)
	::setPageSize(nPageSize)
	If !Empty(cFilter)
		aUrlFilter := {;
			{"FILTER", cFilter};
			}
		::SetUrlFilter(aUrlFilter)
	EndIf 
	::SetQuery(getOrdersManuallyQuery(lItems))

    cWhere += "  SC7.C7_FILIAL = '" + FWxFilial("SC7", cBranch) + "' "
    cWhere += "  AND SC7.C7_EMITIDO = '' "
    cWhere += "  AND SC7.C7_ENCER = '' "
    cWhere += "  AND (SC7.C7_QUANT - SC7.C7_QUJE - SC7.C7_QTDACLA) > 0 AND SC7.C7_ENCER = ' ' AND SC7.C7_RESIDUO <> 'S' "
    cWhere += "  AND SC7.C7_CONAPRO <> 'B' "
    cWhere += "  AND SC7.D_E_L_E_T_ = '' "

	::SetWhere(cWhere)
	::SetOrder(IIF(lItems, "SC7.C7_FILIAL, SC7.C7_EMISSAO, SC7.C7_NUM, SC7.C7_PRODUTO, SC7.C7_ITEM", "SC7.C7_FILIAL, SC7.C7_EMISSAO DESC "))

	If ::Execute()
		::FillGetResponse()
	EndIf

	FWRestArea(aArea)
	FwFreeArray(aArea)
    FwFreeArray(aURLFilter)

Return

//------------------------------------------------------------------------------
/*/{Protheus.doc} addMapFieldsPurshaseOrders
    Metodo responsável por adicionar os campos mapeados para a consulta de Pedidos de Compra

    @type  Static Function
    @author Squad PIF
    @version 1.0
    @param oSelf, Objeto, Instancia da classe PurchaseOrdersSuggestedData
    @param lItems, Logical, indica o retorno de items do Pedido
    @return Nil
/*/
//------------------------------------------------------------------------------
Static Function addMapFieldsPurchaseOrders(oSelf as Object, lItems as Logical, lLinked as Logical)

    oSelf:addMapFields("branchId"    , "C7_FILIAL" , .T., .F., {"C7_FILIAL" , "C", GetSx3Cache("C7_FILIAL", "X3_TAMANHO"), 0}, "SC7.C7_FILIAL")
    oSelf:addMapFields("order"       , "C7_NUM"    , .T., .F., {"C7_NUM"    , "C", GetSx3Cache("C7_NUM","X3_TAMANHO")    , 0}, "SC7.C7_NUM")
    oSelf:addMapFields("date"        , "C7_EMISSAO", .T., .F., {"C7_EMISSAO", "D", GetSx3Cache("C7_EMISSAO","X3_TAMANHO"), 0}, "SC7.C7_EMISSAO")
    
    If lLinked
        oSelf:addMapFields("document"    , "DT_DOC"    , .T., .F., {"DT_DOC"    , "C", GetSx3Cache("DT_DOC","X3_TAMANHO")    , 0}, "SDT.DT_DOC")
        oSelf:addMapFields("serial"      , "DT_SERIE"  , .T., .F., {"DT_SERIE"  , "C", GetSx3Cache("DT_SERIE","X3_TAMANHO")  , 0}, "SDT.DT_SERIE")    
        oSelf:addMapFields("supplier"    , "DT_FORNEC" , .T., .F., {"DT_FORNEC", "C", GetSx3Cache("DT_FORNEC","X3_TAMANHO"), 0}, "SDT.DT_FORNEC")
        oSelf:addMapFields("store"       , "DT_LOJA"   , .T., .F., {"DT_LOJA"   , "C", GetSx3Cache("DT_LOJA","X3_TAMANHO")   , 0}, "SDT.DT_LOJA")
        
        if lItems
            oSelf:addMapFields("itemDoc"     , "DT_ITEM"   , .T., .F., {"DT_ITEM"   , "C", GetSx3Cache("DT_ITEM","X3_TAMANHO")   , 0}, "SDT.DT_ITEM")
        endif
    Else
        oSelf:addMapFields("supplier"    , "C7_FORNECE", .T., .F., {"C7_FORNECE", "C", GetSx3Cache("C7_FORNECE","X3_TAMANHO"), 0}, "SC7.C7_FORNECE")
        oSelf:addMapFields("store"       , "C7_LOJA"   , .T., .F., {"C7_LOJA"   , "C", GetSx3Cache("C7_LOJA","X3_TAMANHO")   , 0}, "SC7.C7_LOJA")
    Endif

    oSelf:addMapFields("supplierName", "A2_NOME"   , .T., .F., {"A2_NOME"   , "C", GetSx3Cache("A2_NOME","X3_TAMANHO")   , 0}, "SA2.A2_NOME")

    If lItems
        oSelf:addMapFields("product"     , "C7_PRODUTO", .T., .F., {"C7_PRODUTO", "C", GetSx3Cache("C7_PRODUTO","X3_TAMANHO"), 0}, "SC7.C7_PRODUTO")
        oSelf:addMapFields("description" , "B1_DESC"   , .T., .F., {"B1_DESC"   , "C", GetSx3Cache("B1_DESC","X3_TAMANHO")   , 0}, "SB1.B1_DESC")
        oSelf:addMapFields("item"        , "C7_ITEM"   , .T., .F., {"C7_ITEM"   , "C", GetSx3Cache("C7_ITEM","X3_TAMANHO")   , 0}, "SC7.C7_ITEM")
        oSelf:addMapFields("value"       , "C7_PRECO"  , .T., .F., {"C7_PRECO"  , "N", GetSx3Cache("C7_PRECO","X3_TAMANHO")  , GetSx3Cache("C7_PRECO", "X3_DECIMAL")}, "SC7.C7_PRECO")
        oSelf:addMapFields("quantity"    , "C7_QUANT"  , .T., .F., {"C7_QUANT"  , "N", GetSx3Cache("C7_QUANT","X3_TAMANHO")  , GetSx3Cache("C7_QUANT", "X3_DECIMAL")}, "SC7.C7_QUANT")
        oSelf:addMapFields("total"       , "C7_TOTAL"  , .T., .F., {"C7_TOTAL"  , "N", GetSx3Cache("C7_TOTAL","X3_TAMANHO")  , GetSx3Cache("C7_TOTAL", "X3_DECIMAL")}, "SC7.C7_TOTAL")
    Else
        oSelf:addMapFields("value"       , "C7_PRECO"  , .T., .F., {"C7_PRECO"  , "N", GetSx3Cache("C7_PRECO","X3_TAMANHO")  , GetSx3Cache("C7_PRECO", "X3_DECIMAL")}, "SUM(SC7.C7_PRECO)")
        oSelf:addMapFields("quantity"    , "C7_QUANT"  , .T., .F., {"C7_QUANT"  , "N", GetSx3Cache("C7_QUANT","X3_TAMANHO")  , GetSx3Cache("C7_QUANT", "X3_DECIMAL")}, "SUM(SC7.C7_QUANT)")
        oSelf:addMapFields("total"       , "C7_TOTAL"  , .T., .F., {"C7_TOTAL"  , "N", GetSx3Cache("C7_TOTAL","X3_TAMANHO")  , GetSx3Cache("C7_TOTAL", "X3_DECIMAL")}, "SUM(SC7.C7_TOTAL)")
    EndIf 
Return

//------------------------------------------------------------------------------
/*/{Protheus.doc} getOrdersManuallyQuery
    Metodo responsável por obter a query para a consulta de Pedidos de Compras em Aberto

    @type  Static Function
    @author Squad PIF
    @version 1.0
    @param lItems, Logical, indica o retorno de items do Pedido
    @return Character, retorna a query
/*/
//------------------------------------------------------------------------------
Static Function getOrdersManuallyQuery(lItems as Logical)

	Local cQuery    As Character
   
    Default lItems := .F.

	cQuery := " SELECT #QueryFields# "
	cQuery += " FROM " + RetSqlName("SC7") + " SC7 "
    cQuery += " LEFT JOIN " + RetSqlName("SA2") + " SA2 ON " + FWJoinFilial("SC7", "SA2") + " "
    cQuery += " AND SC7.C7_FORNECE = SA2.A2_COD "
    cQuery += " AND SC7.C7_LOJA    = SA2.A2_LOJA "
    cQuery += " AND SA2.D_E_L_E_T_  = ' ' "
    cQuery += " LEFT JOIN " + RetSqlName("SB1") + " SB1 ON " + FWJoinFilial("SC7", "SB1") + " "
    cQuery += " AND SC7.C7_PRODUTO = SB1.B1_COD "
    cQuery += " AND SB1.D_E_L_E_T_ = ' ' "
	cQuery += " WHERE #QueryWhere# "
    IIF(!lItems,cQuery += " GROUP BY SC7.C7_FILIAL, SC7.C7_NUM, SC7.C7_EMISSAO, SC7.C7_FORNECE, SC7.C7_LOJA, SA2.A2_NOME "," ")

Return cQuery


//------------------------------------------------------------------------------
/*{Protheus.doc} getPurchaseOrdersLinked
    Metodo responsável por obter a lista de Pedidos de Compra ja vinculados ao documento

    @type Method
    @author Squad PIF
    @version 1.0
    @param cBranch, Character, filial do documento fiscal
    @param nPage, numeric, numero da pagina
	@param nPageSize, numeric, Quantidade de registros por pagina
    @param cFilter, Character, filtro
    @param lItems, Logical, indica o retorno de items do Pedido 
    @return Json, retorna o objeto json com os Pedidos de Compra vinculados
*/    
//------------------------------------------------------------------------------
Method getPurchaseOrdersLinked(cBranch As Character, nPage As Numeric, nPageSize As Numeric, cFilter As Character, lItems As Logical) class PurchaseOrdersSuggestedData
	Local cWhere        As Character
	Local aArea         As Array
    Local aURLFilter    As Array
    Local lLinked       As Logical

	Default nPage      := 1
	Default nPageSize  := 10
    Default lItems     := .F.

	aArea      := FWGetArea()
	cWhere     := ""
    aURLFilter := {}
    lLinked    := .T.

	addMapFieldsPurchaseOrders(self, lItems, lLinked)

	::setUseSpaces(.T.)
	::setPage(nPage)
	::setPageSize(nPageSize)
	If !Empty(cFilter)
		aUrlFilter := {;
			{"FILTER", cFilter};
			}
		::SetUrlFilter(aUrlFilter)
	EndIf 
	::SetQuery(getPoLinkedQuery(lItems))

    cWhere += "  SC7.C7_FILIAL = '" + FWxFilial("SC7", cBranch) + "' "
    cWhere += "  AND SC7.D_E_L_E_T_ = '' "

	::SetWhere(cWhere)
    ::SetOrder(IIF(lItems, "SC7.C7_FILIAL, SC7.C7_EMISSAO, SC7.C7_NUM, SC7.C7_PRODUTO, SC7.C7_ITEM", "SC7.C7_FILIAL, SC7.C7_EMISSAO DESC "))

	If ::Execute()
		::FillGetResponse()
	EndIf

	FWRestArea(aArea)
	FwFreeArray(aArea)
    FwFreeArray(aURLFilter)

Return

//------------------------------------------------------------------------------
/*/{Protheus.doc} getPoLinkedQuery
    Metodo responsável por obter a query para a consulta de Pedidos de Compras ja vinculados ao documento

    @type  Static Function
    @author Squad PIF
    @version 1.0
    @param lItems, Logical, indica o retorno de items do Pedido
    @return Character, retorna a query
/*/
//------------------------------------------------------------------------------
Static Function getPoLinkedQuery(lItems as Logical)

	Local cQuery    As Character
   
    Default lItems := .F.

	cQuery := " SELECT #QueryFields# "
	cQuery += " FROM " + RetSqlName("SC7") + " SC7 "
    cQuery += " LEFT JOIN " + RetSqlName("SA2") + " SA2 ON " + FWJoinFilial("SC7", "SA2") + " "
    cQuery += " AND SC7.C7_FORNECE = SA2.A2_COD "
    cQuery += " AND SC7.C7_LOJA    = SA2.A2_LOJA "
    cQuery += " AND SA2.D_E_L_E_T_  = '' "
    cQuery += " LEFT JOIN " + RetSqlName("SB1") + " SB1 ON " + FWJoinFilial("SC7", "SB1") + " "
    cQuery += " AND SC7.C7_PRODUTO = SB1.B1_COD "
    cQuery += " AND SB1.D_E_L_E_T_ = '' "
    cQuery += " LEFT JOIN " + RetSqlName("SDT") + " SDT ON " + FWJoinFilial("SC7", "SDT") + " "
    cQuery += " AND SC7.C7_NUM = SDT.DT_PEDIDO "
    cQuery += " AND SC7.C7_ITEM = SDT.DT_ITEMPC "
    cQuery += " AND SDT.D_E_L_E_T_ = '' "
	cQuery += " WHERE #QueryWhere# "
    IIF(!lItems,cQuery += " GROUP BY SC7.C7_FILIAL, SC7.C7_NUM, SC7.C7_EMISSAO, SDT.DT_FORNEC, SDT.DT_LOJA, SA2.A2_NOME , SDT.DT_DOC, SDT.DT_SERIE "," ")

Return cQuery
