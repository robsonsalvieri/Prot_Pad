#include "tlpp-core.th"
#include "backoffice.pif.fiscal.insight.ncm.confirm.suggestion.controller.ch"

namespace totvs.protheus.backoffice.pif.fiscal.insight.ncm
using namespace totvs.protheus.backoffice.pif.util

//------------------------------------------------------------------------------
/* {Protheus.doc} ConfirmSuggestionController
    API utilizada para confirmação de sugestões, consulta de ncms aceitos e reversão de ncms Ajustado
    @type Class
    @author Squad PIF
    @return Nil
*/
//------------------------------------------------------------------------------
Class ConfirmSuggestionController

	Public Method new() Constructor

	@Get("/api/pif/ncm/adjusteds")
	Public Method getAdjusteds()

	@Post("/api/pif/ncm/confirm")
	Public Method postConfirmSuggestion()

EndClass

//------------------------------------------------------------------------------
/* {Protheus.doc} new
    Metodo construtor

    @type Method
    @author Squad PIF
    @return Object, retorna o objeto criado
*/
//------------------------------------------------------------------------------
Method New() Class ConfirmSuggestionController
Return Self

//------------------------------------------------------------------------------
/* {Protheus.doc} postConfirmSuggestion
    Método responsável por confirmar, reverter ou ignorar as sugestões de NCM

    @type Method
    @author Squad PIF
    @return Nil
*/
//------------------------------------------------------------------------------
Method postConfirmSuggestion() class ConfirmSuggestionController
	Local oService       := ConfirmSuggestionService():New()   As Object
	Local jResponse      := JsonObject():New()                 As Json
	Local cBody          := oRest:getBodyRequest()             As Character
	Local JBody         := JsonObject():New()                 As Json
	Local oError         := ErrorClass():New()                 As Object
	Local nX             := 1                                  As Numeric
	local lContinue      := .T.                                As Logical

	jResponse := getNoAccessResponse()

	if canAccess("PIFA010")
		if ValType(cBody) == "C"
			uRet := JBody:FromJson(cBody)

			if ValType(uRet) == "U"
				if JBody:hasProperty("products") .And. ValType(JBody["products"]) == "A"

					if Len(JBody["products"]) > 0

						// Valida se todos os itens possuem as propriedades obrigatórias
						for nX := 1 to Len(JBody["products"])
							if !(JBody["products"][nX]:hasProperty("id") .And. JBody["products"][nX]:hasProperty("codProd") .And. JBody["products"][nX]:hasProperty("ncm") .And. JBody["products"][nX]:hasProperty("ncmProposed") .And. JBody["products"][nX]:hasProperty("reason") .And. JBody["products"][nX]:hasProperty("status"))
								lContinue := .F.
								loop
							endif
						next

						if lContinue
							jResponse   := oService:postConfirmSuggestion(JBody)
						endif
					endif
				endif
			endif
		endif

		if jResponse:getJsonObject("statusCode") >= 400
			oError:genCode     := 400
			oError:description := STR0001 //"Conteúdo do corpo da requisição inválido."

			jResponse := getBadRequestResponse({oError})
		endif
	endif

	answerRest(jResponse)

	FWFreeObj(oService)
	FWFreeObj(oError)
	FreeObj(jResponse)
	FreeObj(JBody)

Return

//------------------------------------------------------------------------------
/* {Protheus.doc} getAdjusteds
    Método responsável por retornar os ncms ajustados

    @type Method
    @author Squad PIF
    @version 1.0
*/
//------------------------------------------------------------------------------
Method getAdjusteds() Class ConfirmSuggestionController
	Local oService    As Object
	Local jResponse   As Json
	Local nPage       As Numeric
	Local nPageSize   As Numeric
	Local cTempTable  As Character
	Local cFilter     As Character

	nPage        := 1
	nPageSize    := 10
	cTempTable   := ""
	cFilter      := ""

	jResponse := getNoAccessResponse()

	If canAccess("PIFA010")
		getPageAndPageSize(@nPage, @nPageSize)

		// Pega o nome da tabela temporária
		If (oRest:getQueryRequest():GetJsonText("tempTable") != "null")
       		cTempTable := AllTrim(oRest:getQueryRequest():GetJsonText("tempTable"))
      	EndIf

		// Pegando os filtros
		If (oRest:getQueryRequest():GetJsonText("$filter") != "null")
       		cFilter := AllTrim(oRest:getQueryRequest():GetJsonText("$filter"))
      	EndIf

		oService  := ConfirmSuggestionService():New()
		jResponse := oService:getAdjusteds(@nPage, @nPageSize, cFilter, cTempTable)
	EndIf

	answerRest(jResponse)

	FWFreeObj(oService)
	FreeObj(jResponse)

Return
