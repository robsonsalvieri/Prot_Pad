#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "backoffice.pif.fiscal.insight.ncm.groups.data.ch"

namespace totvs.protheus.backoffice.pif.fiscal.insight.ncm
using namespace totvs.protheus.backoffice.pif.util

//------------------------------------------------------------------------------
/* {Protheus.doc} NcmGroupsData
    Classe responsável pela consulta de dados de grupos de NCM

    @type Class
    @author Squad PIF
    @version 1.0
*/
//------------------------------------------------------------------------------
Class NcmGroupsData From FWAdapterBaseV2

	Public Method new() Constructor
	Public Method getNcmGroups()                        As Json
	Public Method formatNcmGroupsResponse()             As Json
	Public Method formatProductsByNcmGroupResponse()     As Json
	Public Method getProductsByNcmGroup()               As Json
	Public Method getCClassTribByProduct()              As Logical 
	Public Method formatCClassTribByProductResponse()   As Json
	
	Protected Method getDescriptionByNcm()              As Character
	Protected Method getNcmGroupDescription() 		 	As Character	

EndClass

//------------------------------------------------------------------------------
/*{Protheus.doc} New
    Metodo construtor

    @type Method
    @author Squad PIF
    @version 1.0
    @param cMethod, Character, tipo de verbo HTTP
    @param lList, Logical, indica o retorno de lista de valores
    @return Object, retorna o objeto criado
*/
//------------------------------------------------------------------------------
Method new(cMethod as Character, lList as Logical) Class NcmGroupsData

	Default cMethod := "GET"
	Default lList   := .T.

	_Super:New(cMethod, lList)

Return Self


//------------------------------------------------------------------------------
/*{Protheus.doc} getNcmGroups
    Metodo responsável por obter a lista de grupos de NCM dos produtos com movimentação nos últimos 12 meses

    @type Method
    @author Squad PIF
    @version 1.0
    @param nPage, numeric, numero da pagina
	@param nPageSize, numeric, Quantidade de registros por pagina
	@param cFilter, Character, Filtro a ser aplicado na consulta
	@param cTempTable, Character, Alias da tabela temporária
    @return Json, retorna o objeto json contendo os dados dos grupos de NCM
*/
//------------------------------------------------------------------------------
Method getNcmGroups(nPage as Numeric, nPageSize as Numeric, cFilter as Character, cTempTable as character) As Json class NcmGroupsData
	Local cWhere     As Character
	Local aArea      As Array
	Local aUrlFilter As Array
	Local cBranch	 As Character

	Default nPage     := 1
	Default nPageSize := 10

	aArea      := FWGetArea()
	aUrlFilter := {}

	AddMapFieldsNcmGroups(self)

	::setUseSpaces(.T.)
	::setPage(nPage)
	::setPageSize(nPageSize)
	::SetQuery( getNcmGroupsQuery(cTempTable) )

	// Filtro para trazer apenas grupos de NCM válidos
	cWhere := " CURNCMGRP <> ' ' "
	// Caso não seja informado a filial nos filtros irá utilizar a filial posicionada
	if !("BRANCH" $ cFilter)
		cBranch := FwxFilial("SB1")
		cWhere += " AND BRANCH = '" + cBranch + "' "
	endif

	::SetWhere(cWhere)
	::SetOrder("CURNCMGRP")

	if !Empty(cFilter)

		aUrlFilter := {;
			{"FILTER", cFilter};
			}
		::SetUrlFilter(aUrlFilter)
	endif
	If ::Execute()
		::FillGetResponse()
	EndIf

	FWRestArea(aArea)
	FwFreeArray(aArea)
	
Return


//------------------------------------------------------------------------------
/*/{Protheus.doc} AddMapFieldsNcmGroups
    Metodo responsável por adicionar os campos mapeados para a consulta de grupos de NCM

    @type  Static Function
    @author Squad PIF
    @version 1.0
/*/
//------------------------------------------------------------------------------
Static Function AddMapFieldsNcmGroups(oSelf as Object)

	oSelf:addMapFields("B1_POSIPI", "B1_POSIPI", .T., .F., {"B1_POSIPI", "C", 4, 0}, "CURNCMGRP")
Return

//------------------------------------------------------------------------------
/*/{Protheus.doc} getNcmGroupsQuery
    Metodo responsável por obter a query de grupos de NCM

    @type  Static Function
    @author Squad PIF
    @version 1.0
/*/
//------------------------------------------------------------------------------
Static Function getNcmGroupsQuery(cTempTable)
	Local cQuery   As Character

	cQuery := "SELECT DISTINCT #QueryFields# "
	cQuery += "FROM " + cTempTable + " TMP "
	cQuery += "INNER JOIN " + RetSqlName("I21") + " I21 "
	cQuery += " ON I21.R_E_C_N_O_ = TMP.RECNOI21 "
	cQuery += " AND I21.I21_STATUS = ' ' "
	cQuery += " AND I21.I21_KEY NOT LIKE 'cClassTrib%' "
	cQuery += "WHERE #QueryWhere# "
	cQuery += "GROUP BY CURNCMGRP, CURNCMGRPD"

Return cQuery

//------------------------------------------------------------------------------
/*/{Protheus.doc} getProductsByNcmGroupQuery
    Metodo responsável por obter a query de produtos de acordo com o grupo de NCM informado

    @type  Static Function
    @author Squad PIF
    @version 1.0
	@return cQuery, Character, Query
/*/
//------------------------------------------------------------------------------
Static Function getProductsByNcmGroupQuery(cTempTable As Character)
	Local cQuery   As Character

    cQuery := "SELECT DISTINCT #QueryFields# "
    cQuery += "FROM " + cTempTable + " TMP "
    cQuery += "INNER JOIN " + RetSqlName("I21") + " I21 "
    cQuery += "ON I21.R_E_C_N_O_ = TMP.RECNOI21 "
    cQuery += "AND I21.I21_STATUS = ' ' "
    cQuery += "AND I21.I21_KEY NOT LIKE 'cClassTrib%' "
    cQuery += "AND I21.D_E_L_E_T_ = ' ' "
    cQuery += "WHERE #QueryWhere# "
    cQuery += "GROUP BY TMP.CURNCMGRP, TMP.PRODCODE, TMP.CURNCM, TMP.CURNCMDESC "
    
Return cQuery


//------------------------------------------------------------------------------
/*{Protheus.doc} formatNcmGroupsResponse
    Metodo responsável por retornar o objeto json formatado com os dados dos grupos de NCM

    @type  Private Method
    @author Squad PIF
    @version 1.0
    @return Json, retorna o objeto json contendo os dados dos grupos de NCM
*/
//------------------------------------------------------------------------------
Method formatNcmGroupsResponse(cTempTable As Character) As Json Class NcmGroupsData
    Local jResponse    := JsonObject():New() As Json
	Local cNcmCode     := "" As character

    jResponse:FromJson(::getJSONResponse())
    
	aEval(jResponse:GetJsonObject("items"), {|x| cNcmCode := x:GetJsonText("b1_posipi"),;
		x["ncmGroup"]            := cNcmCode + ".XX.XX",;
		x["ncmGroupDescription"] := ::getNcmGroupDescription(cTempTable,cNcmCode),;
		x:DelName("b1_posipi");
	})

Return jResponse

//------------------------------------------------------------------------------
/*{Protheus.doc} getProductsByNcmGroup
    Metodo responsável por retornar os dados dos produtos de acordo com o grupo de NCM informado

    @type Method
    @author Squad PIF
    @version 1.0
    @param nPage, numeric, numero da pagina
	@param nPageSize, numeric, Quantidade de registros por pagina
    @param cGroupCode, Character, Código do grupo de NCM
	@param cFilter, Character, Filtro a ser aplicado na consulta
	@param cTempTable, Character, Alias da tabela temporária
    @return Json, retorna o objeto json contendo os dados dos grupos de NCM
*/
//------------------------------------------------------------------------------
Method getProductsByNcmGroup(nPage as Numeric, nPageSize as Numeric, cGroupCode as Character, cFilter as Character, cTempTable as character) As Json class NcmGroupsData
	Local cWhere     As Character
	Local aArea      As Array
	Local aUrlFilter As Array

	Default nPage     := 1
	Default nPageSize := 10

	aArea      := FWGetArea()
	aUrlFilter := {}

	addMapFieldsByNcmGroupProducts(self)

	::setUseSpaces(.T.)
	::setPage(nPage)
	::setPageSize(nPageSize)
	::SetQuery( getProductsByNcmGroupQuery(cTempTable) )
	
	cWhere := " TMP.CURNCMGRP LIKE '" + cGroupCode + "%' "
	cWhere += " AND TMP.D_E_L_E_T_ = ' ' "

	// Caso não seja informado a filial nos filtros irá utilizar a filial posicionada
	if !("BRANCH" $ cFilter)
		cWhere += " AND TMP.BRANCH = '" + FwxFilial("SB1") + "' "
	endif

	::SetWhere(cWhere)
	::SetOrder("TMP.CURNCMGRP")

	if !Empty(cFilter)
		aUrlFilter := {;
			{"FILTER", cFilter};
			}
		::SetUrlFilter(aUrlFilter)
	endif

	If ::Execute()
		::FillGetResponse()
	EndIf

	FWRestArea(aArea)
	FwFreeArray(aArea)

Return


//------------------------------------------------------------------------------
/*{Protheus.doc} getCClassTribByProduct
    Metodo responsável por retornar as sugestões de classificação tributária (cClassTrib)
    de acordo com o código do produto informado.
    Consulta diretamente a tabela I21 (sem dependência de tabela temporária),
    filtrando pela última mensagem de insight via I19.

    @type Method
    @author Squad PIF
    @version 1.0
    @param cProductCode, Character, Código do produto
    @param nPage, Numeric, Número da página
    @param nPageSize, Numeric, Tamanho da página
    @return Logical, .T. se executou com sucesso
*/
//------------------------------------------------------------------------------
Method getCClassTribByProduct(cProductCode As Character, nPage As Numeric, nPageSize As Numeric) As Logical Class NcmGroupsData
	Local aArea As Array
	Local lExec := .F. As Logical

	Default nPage     := 1
	Default nPageSize := 10

	aArea := FWGetArea()

	addMapFieldsCClassTrib(self)

	::setUseSpaces(.T.)
	::setPage(nPage)
	::setPageSize(nPageSize)
	::SetQuery(getCClassTribQuery())
	::SetWhere(getCClassTribWhere(AllTrim(cProductCode)))
	::SetOrder("I21.R_E_C_N_O_")

	lExec := ::Execute()

	If lExec
		::FillGetResponse()
		::lOk := .T.
	EndIf

	FWRestArea(aArea)
	FwFreeArray(aArea)

Return lExec


//------------------------------------------------------------------------------
/*{Protheus.doc} formatCClassTribByProductResponse
    Metodo responsável por retornar o objeto json formatado com as sugestões de cClassTrib
    de um produto específico.

    @type Method
    @author Squad PIF
    @version 1.0
    @return Json, objeto json com os itens de cClassTrib
*/
//------------------------------------------------------------------------------
Method formatCClassTribByProductResponse() As Json Class NcmGroupsData
	Local jResponse  := JsonObject():New() As Json
	Local aItems     As Array
	Local oItem      As Object
	Local jIns       As Json
	Local xDeco      As Variant
	Local nX         := 0 As Numeric

	jResponse:FromJson(::getJSONResponse())
	aItems := jResponse:GetJsonObject("items")

	For nX := 1 To Len(aItems)
		oItem := aItems[nX]

		jIns := JsonObject():New()
		jIns:FromJson(oItem:GetJsonText("i21_paylod"))

		oItem["id"]                              := AllTrim(oItem:GetJsonText("i21_uidins"))
		oItem["productCode"]                     := AllTrim(jIns:GetJsonText("productCode"))
		oItem["productDescription"]              := AllTrim(jIns:GetJsonText("productDescription"))
		oItem["ncmCode"]                         := AllTrim(jIns:GetJsonText("ncmCode"))
		oItem["cfop"]                            := AllTrim(jIns:GetJsonText("cfop"))
		oItem["cfopDescription"]                 := AllTrim(jIns:GetJsonText("cfopDescription"))
		oItem["proposedCclasstribCode"]          := AllTrim(jIns:GetJsonText("proposedCclasstribCode"))

		xDeco := DecodeUTF8(jIns:GetJsonText("proposedCclasstribDescription"))
		oItem["proposedCclasstribDescription"] := xDeco

		xDeco := DecodeUTF8(jIns:GetJsonText("proposedCclastribAnalyseContext"))
		oItem["proposedCclastribAnalyseContext"] := xDeco

		oItem:DelName("i21_uidins")
		oItem:DelName("i21_paylod")

		FWFreeObj(jIns)
	Next nX

Return jResponse


//------------------------------------------------------------------------------
/*{Protheus.doc} formatProductsResponse
    Metodo responsável por formatar a resposta de produtos por grupo de NCM
    com as sugestões de NCM (ncm_suggestion).

    @type Method
    @author Squad PIF
    @version 1.0
	@param cTempTable, Character, Alias da tabela temporária
    @return Json, retorna o objeto json formatado
*/
//------------------------------------------------------------------------------
Method formatProductsByNcmGroupResponse(cTempTable As Character) As Json Class NcmGroupsData
	Local aArea      := FWGetArea()
	Local jResponse  := JsonObject():New() As Json
	Local aItems     As Array
	Local oItem      As Object
	Local cNcm       := "" As Character
	Local cCodProd   := "" As Character
	Local nX         := 0  As Numeric
	Local cFilSB1    := "" As Character
	Local cDescProd  := "" As Character
	
	jResponse:FromJson(::getJSONResponse())
	aItems := jResponse:GetJsonObject("items")

	cFilSB1    := FwxFilial("SB1")
	
	DbSelectArea("SB1")
	SB1->(DbSetOrder(1))
	For nX := 1 To Len(aItems)
		oItem    := aItems[nX]
		cNcm     := oItem:GetJsonText("b1_posipi")
		cCodProd := oItem:GetJsonText("b1_cod")
		
		If SB1->(DbSeek(cFilSB1 + AllTrim(cCodProd)))
			cDescProd := AllTrim(SB1->B1_DESC)
		else
			cDescProd := STR0001 // "Sem descrição"
		Endif

		oItem["productCode"]        := AllTrim(cCodProd)
		oItem["productDescription"] := cDescProd
		oItem["ncmCode"]            := Transf(AllTrim(cNcm), "@R 9999.99.99")
		oItem["ncmDescription"]     := ::getDescriptionByNcm(cTempTable, cNcm)
		oItem["suggestedNcmList"]   := getNcmSuggestion(cTempTable, AllTrim(cCodProd))

		oItem:DelName("b1_posipi")
		oItem:DelName("b1_cod")
	Next nX

	FWRestArea(aArea)
	FwFreeArray(aArea)

Return jResponse


//------------------------------------------------------------------------------
/*/{Protheus.doc} addMapFieldsCClassTrib
    Função responsável por adicionar os campos mapeados para a consulta de sugestões cClassTrib

    @type  Static Function
    @author Squad PIF
    @version 1.0
/*/
//------------------------------------------------------------------------------
Static Function addMapFieldsCClassTrib(oSelf As Object)
	oSelf:addMapFields("I21_UIDINS", "I21_UIDINS", .T., .F., {"I21_UIDINS", "C", TamSX3('I21_UIDINS')[1], 0}, "I21.I21_UIDINS")
	oSelf:addMapFields("I21_PAYLOD", "I21_PAYLOD", .T., .F., {"I21_PAYLOD", "M", TamSX3('I21_PAYLOD')[1], 0}, "I21.I21_PAYLOD")
Return


//------------------------------------------------------------------------------
/*/{Protheus.doc} getCClassTribQuery
    Função responsável por retornar a query base para consulta de sugestões cClassTrib na I21

    @type  Static Function
    @author Squad PIF
    @version 1.0
    @return Character, query com placeholders #QueryFields# e #QueryWhere#
/*/
//------------------------------------------------------------------------------
Static Function getCClassTribQuery()
	Local cQuery As Character

	cQuery := "SELECT DISTINCT #QueryFields# "
	cQuery += "FROM " + RetSqlName("I21") + " I21 "
	cQuery += "WHERE #QueryWhere# "

Return cQuery


//------------------------------------------------------------------------------
/*/{Protheus.doc} getCClassTribWhere
    Função responsável por retornar o filtro WHERE para a consulta de sugestões cClassTrib,
    filtrando pelo código do produto e pela última mensagem de insight via I19.

    @type  Static Function
    @author Squad PIF
    @version 1.0
    @param cProductCode, Character, Código do produto
    @return Character, cláusula WHERE
/*/
//------------------------------------------------------------------------------
Static Function getCClassTribWhere(cProductCode As Character)
	Local cWhere As Character

	cWhere := " I21.I21_UIDMSG IN ( "
	cWhere += "   SELECT I19.I19_UIDMSG "
	cWhere += "   FROM " + RetSqlName("I19") + " I19 "
	cWhere += "   WHERE I19.I19_MESSID = ( "
	cWhere += "     SELECT I19_MESSID "
	cWhere += "     FROM ( "
	cWhere += "       SELECT ROW_NUMBER() OVER( ORDER BY I191.R_E_C_N_O_ DESC ) LINHA, I19_MESSID "
	cWhere += "       FROM " + RetSqlName("I19") + " I191 "
	cWhere += "       WHERE I191.D_E_L_E_T_ = '' "
	cWhere += "       AND I191.I19_INSIGT   = 'ncm_suggestion' "
	cWhere += "       AND I191.I19_MESSID  <> '' "
	cWhere += "     ) AUX WHERE LINHA = 1 "
	cWhere += "   AND I19.D_E_L_E_T_ = '' ) "
	cWhere += " ) "
	cWhere += " AND I21.I21_INSIGT = 'ncm_suggestion' "
	cWhere += " AND I21.I21_KEY    LIKE 'cClassTrib%|" + cProductCode + "|%' "
	cWhere += " AND I21.D_E_L_E_T_ = '' "

Return cWhere

//------------------------------------------------------------------------------
/*/{Protheus.doc} addMapFieldsByNcmGroupProducts
    Metodo responsável por adicionar os campos mapeados para a consulta de produtos de acordo com o grupo de NCM

    @type  Static Function
    @author Squad PIF
    @version 1.0
/*/
//------------------------------------------------------------------------------
Static Function addMapFieldsByNcmGroupProducts(oSelf as Object)

	oSelf:addMapFields("B1_POSIPI", "B1_POSIPI", .T., .F., {"B1_POSIPI", "C", TamSX3('B1_POSIPI')[1], 0}, "CURNCM")
	oSelf:addMapFields("B1_COD", "B1_COD", .T., .F., {"B1_COD", 'C', TamSX3('B1_COD')[1], 0}, "PRODCODE")
	oSelf:addMapFields("ncmDescription", "curNcmDesc", .F., .F., {"curNcmDesc", "C", 255, 0}, "CURNCMDESC")

Return


//------------------------------------------------------------------------------
/*{Protheus.doc} getNcmSuggestion
    Função responsável por obter as sugestões de NCM

    @type Static Function
    @author Squad PIF
    @version 1.0
	@param cCodProd, character, Código do produto
	@param cTempTable, Character, Alias da tabela temporária
    @return character, descrição do grupo de NCM
*/
//------------------------------------------------------------------------------
Static Function getNcmSuggestion(cTempTable As Character, cCodProd As Character)
	Local aRet           := {}  As Array
	Local nParam         := 0   As Numeric
	Local cQuery         := ""  As Character
	Local oStatement     As Object
	Local cAlias         As Character
	Local JSuggestedNcm  As Json
	Local cDescProp      := ""  As Character

	cQuery := " SELECT TMP.PROPNCMCD, TMP.PRODCODE, TMP.ID, TMP.RECNOI21, "
	cQuery += " TMP.PROPNCMCDD "
	cQuery += " FROM ? TMP "
	cQuery += " INNER JOIN " + RetSqlName("I21") + " I21 "
	cQuery += " ON I21.R_E_C_N_O_ = TMP.RECNOI21 "
	cQuery += " WHERE TMP.BRANCH   = ? "
	cQuery += " AND TMP.PRODCODE   = ? "
	cQuery += " AND TMP.STATUS     = ? "
	cQuery += " AND TMP.D_E_L_E_T_ = ? "
	cQuery += " AND I21.D_E_L_E_T_ = ? "
	cQuery += " AND I21.I21_KEY NOT LIKE 'cClassTrib%' "
	cQuery := ChangeQuery(cQuery)

	nParam := 1
	oStatement := FwExecStatement():New( cQuery )
	oStatement:setUnsafe(nParam++, cTempTable )
	oStatement:setString(nParam++, FWxFilial("SB1") )
	oStatement:setString(nParam++, AllTrim(cCodProd) )
	oStatement:setString(nParam++, ' ' )
	oStatement:setString(nParam++, ' ' )
	oStatement:setString(nParam++, ' ' )

	cAlias := oStatement:OpenAlias()

	While (cAlias)->(!Eof())
		cDescProp := (cAlias)->PROPNCMCDD				
		JSuggestedNcm                           := JsonObject():New()
		JSuggestedNcm["id"]                     := (cAlias)->ID
		JSuggestedNcm["proposedNcmCode"]        := Transf( (cAlias)->PROPNCMCD, "@R 9999.99.99" )
		JSuggestedNcm["proposedNcmDescription"] := Alltrim(cDescProp)
		JSuggestedNcm["productCode"]            := AllTrim(cCodProd)

		aAdd(aRet, JSuggestedNcm)

		(cAlias)->(dbSkip())
	Enddo

	(cAlias)->(DbCloseArea())
	oStatement:Destroy()
	FWFreeObj(oStatement)


Return aRet


//------------------------------------------------------------------------------
/*{Protheus.doc} getDescriptionByNcm
    Metodo responsável por obter a descrição de um ncm

    @type Method
    @author Squad PIF
    @version 1.0
	@param cTempTable, character, tabela temporária
	@param cNcm, character, código do NCM
    @return character, descrição do NCM
*/
//------------------------------------------------------------------------------
Method getDescriptionByNcm(cTempTable As Character, cNcm As Character) As Character Class NcmGroupsData
    Local cQuery   := "" as character
    Local cAlias   := "" as character
    Local cDesc    := "" as character
    Local oExec    as object

	cDesc := STR0001 //"Sem descrição"

    cQuery := " SELECT CURNCMDESC "
    cQuery += " FROM ? TMP "
    cQuery += " WHERE BRANCH      = ? "
    cQuery += "   AND CURNCM   	  = ? "
    cQuery += "   AND D_E_L_E_T_  = ? "
    cQuery := ChangeQuery(cQuery)

    oExec := FwExecStatement():New(cQuery)
    oExec:setUnsafe(1, cTempTable)
    oExec:setString(2, FWxFilial("SB1"))
    oExec:setString(3, cNcm)
    oExec:setString(4, ' ')

    cAlias := oExec:OpenAlias()
    If !(cAlias)->(Eof())
        cDesc := AllTrim((cAlias)->CURNCMDESC)
    EndIf

    (cAlias)->(DbCloseArea())
	oExec:Destroy()
	FWFreeObj(oExec)
Return cDesc

//------------------------------------------------------------------------------
/*/{Protheus.doc} getNcmGroupDescription
    Metodo responsável por obter a descrição do grupo de ncm

    @type Method
    @author Squad PIF
    @version 1.0
	@param cTempTable, character, tabela temporária
	@param cNcmGroup, character, código do grupo de NCM
    @return character, descrição do grupo de NCM
/*/
//------------------------------------------------------------------------------
Method getNcmGroupDescription(cTempTable as character, cNcmGroup as character) As Character Class NcmGroupsData
    Local cQuery   := "" as character
    Local cAlias   := "" as character
    Local cDesc    := "" as character
    Local oStmt    as object

	cDesc := STR0001 //"Sem descrição"

    cQuery := " SELECT CURNCMGRPD "
    cQuery += " FROM ? TMP "
    cQuery += " WHERE BRANCH      = ? "
    cQuery += "   AND CURNCMGRP   = ? "
    cQuery += "   AND D_E_L_E_T_  = ? "
    cQuery := ChangeQuery(cQuery)

    oStmt := FwExecStatement():New(cQuery)
    oStmt:setUnsafe(1, cTempTable)
    oStmt:setString(2, FWxFilial("SB1"))
    oStmt:setString(3, cNcmGroup)
    oStmt:setString(4, ' ')

    cAlias := oStmt:OpenAlias()
    If !(cAlias)->(Eof())
        cDesc := AllTrim((cAlias)->CURNCMGRPD)
    EndIf

    (cAlias)->(DbCloseArea())
	oStmt:Destroy()
	FWFreeObj(oStmt)
	
Return cDesc
