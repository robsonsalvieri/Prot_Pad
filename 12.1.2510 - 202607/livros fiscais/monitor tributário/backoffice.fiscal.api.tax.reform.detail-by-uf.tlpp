#INCLUDE "tlpp-core.th"
#INCLUDE "tlpp-rest.th"
#INCLUDE "totvs.ch"
#INCLUDE "FISA318.CH"

/*/{Protheus.doc} TITDetailByUfTaxReform
    Endpoint REST para obter detalhamento por UF da Reforma Tributária.
    Processa requisição GET validando parâmetros obrigatórios e retorna dados consolidados
    de tributos (CBS, IBS, ISS, ICMS, IPI, PIS, COFINS) por estado.

    @type  Function
    @author Caique Carlos
    @since 13/11/2025
    @version 1.0
    @param Nenhum (recebe parâmetros via Query String: branches, periodStart, periodEnd, movimentType, page, pageSize)
    @return Nil, Resposta JSON configurada via oRest:setResponse()
    @example
    GET /api/fiscal/tax-monitor/v1/tax-reform/detail-by-uf?branches=0101,0102&periodStart=2025-01-01&periodEnd=2025-01-31&movimentType=E&page=1&pageSize=10
    @see https://code.engpro.totvs.com.br/totvs-fiscal/monitor-tributario/wiki/%2Ftax-reform-detail-by-uf
/*/
@get(endpoint='/api/fiscal/tax-monitor/v1/tax-reform/detail-by-uf', description='API de Detalhamento por UF da Reforma Tributária')
Function TITDetailByUfTaxReform()
    Local oJsResponse         := JsonObject():new()                        as json
    Local oQryStr             := oRest:getQueryRequest()                   as json
    Local aRequiredProperties := {}                                        as array

    aRequiredProperties	:= {;
        {'branches',400,;   
        STR0069,;           //"O parâmetro 'branches' é obrigatório e não foi informado."
        STR0070},;          //"Informar Código de Filiais separadas por vírgula."
        {'periodStart',400,;
        STR0071,;           //"Nenhuma Data foi informada no parâmetro 'periodStart'."
        STR0072},;          //"Informar a data desejada para o período"
        {'periodEnd',400,;
        STR0073,;           //"Nenhuma Data foi informada no parâmetro 'periodEnd'."
        STR0072},;          //"Informar a data desejada para o período"
        {'movimentType',400,;
        STR0085,;           //"O parâmetro 'movimentType' é obrigatório e não foi informado."
        STR0086};           //"Informar S Para Movimentos de Saída ou E Para Movimentos de Entrada."
    }

    If FISA318F6HasApiRequiredProperties(aRequiredProperties, oQryStr, @oJsResponse) 
        oJsResponse := ResponseDetailByUfTaxReform(;
                                                    oQryStr['branches'], oQryStr['periodStart'], oQryStr['periodEnd'],;
                                                    oQryStr['movimentType'], oQryStr['page'], oQryStr['pageSize'];
                                                )   
    EndIf  

    oRest:setKeyHeaderResponse('Content-Type', 'application/json')
    oRest:setResponse(oJsResponse)

    FwFreeArray(aRequiredProperties) 
    FWFreeObj(oJsResponse)
    FWFreeObj(oQryStr)
Return 

/*/{Protheus.doc} ResponseDetailByUfTaxReform
    Monta o JSON de resposta com detalhamento por UF da Reforma Tributária.
    Consolida valores de tributos por estado e inclui detalhamento por município.
    
    @type  Function
    @author Caique Carlos
    @since 13/11/2025
    @version 1.0
    @param cBranches, character, Códigos das filiais separados por vírgula
    @param cPeriodStart, character, Data inicial do período (formato YYYY-MM-DD)
    @param cPeriodEnd, character, Data final do período (formato YYYY-MM-DD)
    @param cMovimentType, character, Tipo de movimento: 'E' para Entrada, 'S' para Saída
    @param cPage, character, Página atual do relatório (padrão 1)
    @param cPageSize, character, Tamanho da página (padrão 10)
    @return oJsResult, json, Objeto JSON com items (array de UFs), código e hasNext
    @example
    oResponse := ResponseDetailByUfTaxReform("0101,0102", "2025-01-01", "2025-01-31", "E", "1", "10")
/*/
Function ResponseDetailByUfTaxReform(cBranches as character, cPeriodStart as character, cPeriodEnd as character, cMovimentType as character, cPage as character, cPageSize as character)
    Local oJsResult   := JsonObject():new() as json
    Local cAlias      := GetNextAlias()     as character
    Local cAlias2     := GetNextAlias()     as character
    Local aJsonDetail := {}                 as array
    Local lHasNext    := .F.                as logical
    Local nPos        := 0                  as numeric
    Local nTaxesTotal := 0                  as numeric
    Local nIbsTotal   := 0                  as numeric
    Local nPage       := 1                  as numeric
    Local nPageSize   := 10                 as numeric
    Local nPageAux    := 0                  as numeric

    Default cPage     := CValToChar(nPage)
    Default cPageSize := CValToChar(nPageSize)

    nPage       := Val(cPage)
    nPageSize   := Val(cPageSize)

    GetResumeByUfTaxReform(cBranches, cPeriodStart, cPeriodEnd, cMovimentType, @cAlias, nPage, nPageSize)
    If (cAlias)->(!Eof())
        While (cAlias)->(!EoF())
            nPageAux++

            If nPageAux == 1
                oJsResult["items"] := {}
            Endif
            If nPageAux <= nPageSize
                aAdd( oJsResult["items"], JsonObject():New() )

                nPos ++
                nTaxesTotal :=  (cAlias)->CBS_SUBTOTAL  +;
                                (cAlias)->IBS_SUBTOTAL  + (cAlias)->ISS_SUBTOTAL   +;
                                (cAlias)->ICMS_SUBTOTAL + (cAlias)->IPI_SUBTOTAL   +;
                                (cAlias)->PIS_SUBTOTAL  + (cAlias)->COFINS_SUBTOTAL

                oJsResult["items"][nPos]["uf"]         := Alltrim((cAlias)->UF)
                oJsResult["items"][nPos]["cbs"]        := (cAlias)->CBS_SUBTOTAL
                oJsResult["items"][nPos]["ibsTotal"]   := (cAlias)->IBS_SUBTOTAL
                oJsResult["items"][nPos]["iss"]        := (cAlias)->ISS_SUBTOTAL
                oJsResult["items"][nPos]["icms"]       := (cAlias)->ICMS_SUBTOTAL
                oJsResult["items"][nPos]["ipi"]        := (cAlias)->IPI_SUBTOTAL
                oJsResult["items"][nPos]["pis"]        := (cAlias)->PIS_SUBTOTAL
                oJsResult["items"][nPos]["cofins"]     := (cAlias)->COFINS_SUBTOTAL
                oJsResult["items"][nPos]["taxesTotal"] := nTaxesTotal

                GetDetailedByUfTaxReform(cBranches, cPeriodStart, cPeriodEnd, Alltrim((cAlias)->UF), cMovimentType, @cAlias2)

                While (cAlias2)->(!EoF())
                    aAdd( aJsonDetail, JsonObject():New() )

                    nIbsTotal := (cAlias2)->IBS_UF + (cAlias2)->IBS_MUN

                    aJsonDetail[Len(aJsonDetail)]["uf"]           := Alltrim((cAlias)->UF)
                    aJsonDetail[Len(aJsonDetail)]["municipality"] := Alltrim((cAlias2)->MUNICIPIO)
                    aJsonDetail[Len(aJsonDetail)]["cbs"]          := (cAlias2)->CBS
                    aJsonDetail[Len(aJsonDetail)]["ibsUf"]        := (cAlias2)->IBS_UF
                    aJsonDetail[Len(aJsonDetail)]["ibsMun"]       := (cAlias2)->IBS_MUN
                    aJsonDetail[Len(aJsonDetail)]["ibsTotal"]     := nIbsTotal

                    (cAlias2)->(DbSkip())
                EndDo

                If !Empty(aJsonDetail) 
                    oJsResult["items"][nPos]["detail"] := aClone(aJsonDetail) 
                    aSize(aJsonDetail, 0)
                EndIf

                (cAlias)->(DbSkip())
            Else
                lHasNext := .T.
            Exit
            EndIf
        EndDo

        oJsResult["hasNext"] := lHasNext
        (cAlias2)->(DbCloseArea())
    Else
        oJsResult["code"]    := "200"
        oJsResult["items"]   := {}
        oJsResult["hasNext"] := lHasNext
    EndIf

    (cAlias)->(DbCloseArea())
    FwFreeArray(aJsonDetail)
Return oJsResult

/*/{Protheus.doc} GetResumeByUfTaxReform
    Executa query consolidada para obter resumo de tributos por UF.
    Monta CTE (Common Table Expression) unificando dados de múltiplas tabelas fiscais
    (CJX-IPI, CJY-ISS, CJZ-ICMS, CK0-PIS/COFINS, CLC-IBS/CBS) e agrupa por estado.
    Utiliza FWExecStatement com prepared statements para segurança e performance.
    
    @type  Static Function
    @author Caique Carlos
    @since 13/11/2025
    @version 1.0
    @param cBranches, character, Códigos das filiais separados por vírgula
    @param cPeriodStart, character, Data inicial do período (formato YYYY-MM-DD)
    @param cPeriodEnd, character, Data final do período (formato YYYY-MM-DD)
    @param cMovimentType, character, Tipo de movimento: 'E' para Entrada, 'S' para Saída
    @param cAlias, character, Variável passada por referência que receberá o alias do resultado
    @param nPage, numeric, Página atual do relatório (padrão 1)
    @param nPageSize, numeric, Tamanho da página (padrão 10)
    @return Nil, Retorna alias via passagem por referência
    @example
    GetResumeByUfTaxReform("0101,0102", "2025-01-01", "2025-01-31", "1", @cAlias, 1, 10)
/*/
Static Function GetResumeByUfTaxReform(cBranches as character, cPeriodStart as character, cPeriodEnd as character, cMovimentType as character, cAlias as character, nPage as numeric, nPageSize as numeric)
    Local oQryResume  := FWExecStatement():New()               as object
    Local nIndice     := 0                                     as numeric
    Local nBind       := 1                                     as numeric
    Local cQuery      := ""                                    as character
    Local cTributo    := ""                                    as character
    Local cTabela     := ""                                    as character
    Local cCampo      := ""                                    as character
    Local aCodTributo := {"000060","000061","000062"}          as array
    Local aTributos   := {;
                            { "IPI",    "CJX", "VALIPI"},;
                            { "ISS",    "CJY", "VALICM"},;
                            { "ICMS",   "CJZ", "VALICM"},;
                            { "PIS",    "CK0", "VALPIS"},;
                            { "COFINS", "CK0", "VALCOF"},;   
                            { "IBS",    "CLC", "VALIMP"},;  // 000060 e 000061 (IBS UF e MUN)
                            { "CBS",    "CLC", "VALIMP"} ;  // 000062 
                        } as array

    For nIndice := 1 to Len(aTributos)
        cTributo := aTributos[nIndice, 1]
        cTabela  := aTributos[nIndice, 2]
        cCampo   := aTributos[nIndice, 3]

        If nIndice == 1
            cQuery += "WITH RESULT AS ("
        ElseIf nIndice > 1
            cQuery += " UNION ALL "
        EndIf

        cQuery += GetResumeBaseQuery(cTributo, cTabela, cCampo)
    Next nIndice

    cQuery += ") SELECT " 
    cQuery +=   "UF, "
    cQuery +=   "COALESCE(SUM(CASE WHEN TRIBUTO = 'CBS' THEN SUBTOTAL END), 0) AS CBS_SUBTOTAL, "
    cQuery +=   "COALESCE(SUM(CASE WHEN TRIBUTO = 'IBS' THEN SUBTOTAL END), 0) AS IBS_SUBTOTAL, "
    cQuery +=   "COALESCE(SUM(CASE WHEN TRIBUTO = 'IPI' THEN SUBTOTAL END), 0) AS IPI_SUBTOTAL, "
    cQuery +=   "COALESCE(SUM(CASE WHEN TRIBUTO = 'ISS' THEN SUBTOTAL END), 0) AS ISS_SUBTOTAL, "
    cQuery +=   "COALESCE(SUM(CASE WHEN TRIBUTO = 'ICMS' THEN SUBTOTAL END), 0) AS ICMS_SUBTOTAL, "
    cQuery +=   "COALESCE(SUM(CASE WHEN TRIBUTO = 'PIS' THEN SUBTOTAL END), 0) AS PIS_SUBTOTAL, "
    cQuery +=   "COALESCE(SUM(CASE WHEN TRIBUTO = 'COFINS' THEN SUBTOTAL END), 0) AS COFINS_SUBTOTAL "
    cQuery += "FROM RESULT "
    cQuery += "GROUP BY UF "
    cQuery += "ORDER BY UF "
    cQuery += "OFFSET ( ? * ? ) ROWS "                  // nPage-1 * 10
    cQuery += "FETCH NEXT ? ROWS ONLY "                 // 10 + 1

    oQryResume:SetQuery(cQuery)

    For nIndice := 1 To 5
        oQryResume:SetIn(nBind++, StrTokArr(cBranches, "," ))
        oQryResume:SetString(nBind++, cMovimentType)
        oQryResume:SetString(nBind++, StrTran(cPeriodStart, "-", ""))
        oQryResume:SetString(nBind++, StrTran(cPeriodEnd, "-", ""))
        oQryResume:SetNumeric(nBind++, 0)
        oQryResume:SetString(nBind++, " ")
    Next nIndice

    For nIndice := 1 to Len(aCodTributo)
        oQryResume:SetIn(nBind++, StrTokArr(cBranches, "," ))
        oQryResume:SetString(nBind++, cMovimentType)
        oQryResume:SetString(nBind++, StrTran(cPeriodStart, "-", ""))
        oQryResume:SetString(nBind++, StrTran(cPeriodEnd, "-", ""))
        oQryResume:SetNumeric(nBind++, 0)
        If nIndice == 1 
            oQryResume:SetIn(nBind++, {"000060", "000061"})
            nIndice ++
        Else
            oQryResume:SetIn(nBind++, {aCodTributo[nIndice]})
        EndIf

        oQryResume:SetString(nBind++, " ")
    Next nIndice

    oQryResume:SetNumeric(nBind++, cValToChar(nPage-1))
    oQryResume:SetNumeric(nBind++, cValToChar(nPageSize))
    oQryResume:SetNumeric(nBind++, cValToChar(nPageSize+1))

    oQryResume:cBaseQuery := oQryResume:GetFixQuery()
    cAlias := oQryResume:OpenAlias()

    FwFreeObj(oQryResume)
    FwFreeArray(aCodTributo)
    FwFreeArray(aTributos)
Return

/*/{Protheus.doc} GetResumeBaseQuery
    Monta query base SQL para um tributo específico.
    Gera SELECT com agrupamento por UF e placeholder (?) para prepared statement.
    Trata diferenças estruturais entre tabelas (CJX usa TIPMOV, demais usam TIPOMO).
    Tributos da Reforma (IBS/CBS) requerem filtro adicional por código de imposto.
    
    @type  Static Function
    @author Caique Carlos
    @since 13/11/2025
    @version 1.0
    @param cTributo, character, Nome do tributo (IPI, ISS, ICMS, PIS, COFINS, IBS, CBS)
    @param cTabela, character, Código da tabela (CJX, CJY, CJZ, CK0, CLC)
    @param cCampo, character, Sufixo do campo de valor (VALIPI, VALICM, VALPIS, VALCOF, VALIMP)
    @return cBaseQry, character, String SQL com SELECT, WHERE e GROUP BY
    @example
    cSQL := GetResumeBaseQuery("IPI", "CJX", "VALIPI")
/*/
Static Function GetResumeBaseQuery(cTributo as character, cTabela as character, cCampo as character)
    Local cBaseQry    := ""                     as character
    Local cBaseWhere  := ""                     as character
    Local cAliasTable := FIS319SqlName(cTabela)    as character

    cBaseWhere += cTabela + "_FILIAL IN (?) AND "

    If cTabela == "CJX"
        cBaseWhere += cTabela + "_TIPMOV = ? AND "
    Else
        cBaseWhere += cTabela + "_TIPOMO = ? AND "
    EndIf

    cBaseWhere += cTabela + "_ENTRAD BETWEEN ? AND ? AND "
    cBaseWhere += cTabela + "_" + cCampo + " > ? AND "

    If cTributo $ "IBS|CBS"
        cBaseWhere += cTabela + "_IMP IN (?) AND "
    EndIf

    cBaseWhere += "D_E_L_E_T_ = ? "

    cBaseQry += "SELECT "
    cBaseQry +=     cTabela + "_ESTADO AS UF, "
    cBaseQry +=     "'" + cTributo + "' AS TRIBUTO, "
    cBaseQry +=     "SUM(" + cTabela + "_" + cCampo + ") AS SUBTOTAL "
    cBaseQry += "FROM " + cAliasTable + " WHERE " + cBaseWhere
    cBaseQry += "GROUP BY " + cTabela + "_ESTADO "

Return cBaseQry

/*/{Protheus.doc} GetDetailedByUfTaxReform
    Executa query detalhada por município para obter tributos da Reforma Tributária por UF.
    Monta CTE única com classificação dos impostos (IBS_UF, IBS_MUN, CBS) através de CASE WHEN.
    Diferencia IBS por origem: código 000060 (UF) e 000061 (Município).
    Utiliza LEFT JOIN com SA1 (clientes) e SA2 (fornecedores) através de FWJoinFilial.
    O município é determinado por CASE WHEN: Entrada (A2_MUN) ou Saída (A1_MUN).
    Agrupa por UF e município calculado, depois faz PIVOT dos tributos em colunas separadas.
    
    @type  Static Function
    @author Caique Carlos
    @since 13/11/2025
    @version 1.0
    @param cBranches, character, Códigos das filiais separados por vírgula
    @param cPeriodStart, character, Data inicial do período (formato YYYY-MM-DD)
    @param cPeriodEnd, character, Data final do período (formato YYYY-MM-DD)
    @param cUF, character, Sigla da UF para filtrar (ex: "SP", "RJ", "MG")
    @param cMovimentType, character, Tipo de movimento: 'E' para Entrada, 'S' para Saída
    @param cAlias2, character, Variável passada por referência que receberá o alias do resultado
    @return Nil, Retorna alias via passagem por referência
    @example
    GetDetailedByUfTaxReform("0101,0102", "2025-01-01", "2025-01-31", "SP", "E", @cAlias2)
/*/
Static Function GetDetailedByUfTaxReform(cBranches as character, cPeriodStart as character, cPeriodEnd as character, cUF as character, cMovimentType as character, cAlias2 as character)
    Local oQryDetail  := FWExecStatement():New() as object
    Local nBind       := 1                       as numeric
    Local cQuery      := ""                      as character
    Local cTableSD    := ""                      as character
    Local cCampoSD    := ""                      as character
    Local cAliasSD    := ""                      as character
    Local cTableSA    := ""                      as character
    Local cAliasSA    := ""                      as character

    If cMovimentType == 'E'
        cTableSD := "SD1"
        cCampoSD := "D1_FORNECE"
        cAliasSD := "D1"
        cTableSA := "SA2"
        cAliasSA := "A2"
    Else
        cTableSD := "SD2"
        cCampoSD := "D2_CLIENTE"
        cAliasSD := "D2"
        cTableSA := "SA1"
        cAliasSA := "A1"
    EndIf

    cQuery += "WITH RESULT AS ("
    cQuery += "SELECT "
    cQuery +=   "CLC_ESTADO AS UF, "
    cQuery +=   cAliasSA +"_MUN AS MUNICIPIO, "
    cQuery +=   "CASE "
    cQuery +=       "WHEN CLC_IMP = '000062' THEN 'CBS' "
    cQuery +=       "WHEN CLC_IMP = '000060' THEN 'IBS_UF' "
    cQuery +=       "WHEN CLC_IMP = '000061' THEN 'IBS_MUN' "
    cQuery +=   "END AS TRIBUTO,"
    cQuery +=   "SUM(CLC_VALIMP) AS SUBTOTAL "
    cQuery += "FROM " + FIS319SqlName("CLC") + " CLC "                                              // CLCT10  
    cQuery +=   "JOIN " + RetSqlName(cTableSD) + " " + cTableSD + " ON "                         // SD1T10, SD1
    cQuery +=       cAliasSD + "_FILIAL = CLC_FILIAL AND "                                       // D1_FILIAL
    cQuery +=       cAliasSD + "_DOC = CLC_NFISCA AND "                                          // D1_DOC
    cQuery +=       cAliasSD + "_SERIE = CLC_SERIE AND "                                         // D1_SERIE
    cQuery +=       cCampoSD + " = CLC_CLIEFO AND "                                              // D1_FORNECE
    cQuery +=       cAliasSD + "_LOJA = CLC_LOJA AND "                                           // D1_LOJA
    cQuery +=       cTableSD + ".D_E_L_E_T_ = ? "                                                // SD1.D_E_L_E_T_
    cQuery +=   "JOIN " + RetSqlName(cTableSA) + " " + cTableSA + " ON "                         // SA2T10, SA2
    cQuery +=       FWJoinFilial(cTableSA, cTableSD) + " AND "                                   // A2_FILIAL = D1_FILIAL
    cQuery +=       cAliasSA + "_COD = " + cCampoSD + " AND "                                    // A2_COD = D1_FORNECE
    cQuery +=       cAliasSA + "_LOJA = " + cAliasSD + "_LOJA AND "                              // A2_LOJA = D1_LOJA
    cQuery +=       cTableSA + ".D_E_L_E_T_ = ? "                                                // SA2.D_E_L_E_T_          
    cQuery += "WHERE CLC_FILIAL IN (?) AND "                                                     // XIFIS26
    cQuery +=   "CLC_TIPOMO IN (?) AND "                                                         // E
    cQuery +=   "CLC_ENTRAD BETWEEN ? AND ? AND "                                                // 20250101 AND 20250131
    cQuery +=   "CLC_VALIMP > ? AND "                                                            // 0
    cQuery +=   "CLC_IMP IN (?) AND "                                                            // 000060, 000061, 000062
    cQuery +=   "CLC_ESTADO = ? AND "                                                            // SP
    cQuery +=   "CLC.D_E_L_E_T_ = ? "                                                            // ' '
    cQuery += "GROUP BY CLC_ESTADO, " + cAliasSA + "_MUN, CLC_IMP) "                             // A2_MUN
    cQuery += "SELECT "
    cQuery +=    "UF, "
    cQuery +=    "MUNICIPIO, "
    cQuery +=    "COALESCE(SUM(CASE WHEN TRIBUTO = 'IBS_UF' THEN SUBTOTAL END),0) AS IBS_UF, "
    cQuery +=    "COALESCE(SUM(CASE WHEN TRIBUTO = 'IBS_MUN' THEN SUBTOTAL END),0) AS IBS_MUN, "
    cQuery +=    "COALESCE(SUM(CASE WHEN TRIBUTO = 'CBS' THEN SUBTOTAL END),0) AS CBS "
    cQuery += "FROM RESULT "
    cQuery += "GROUP BY UF, MUNICIPIO "
    cQuery += "ORDER BY UF, MUNICIPIO "

    oQryDetail:SetQuery(cQuery)

    oQryDetail:SetString(nBind++, " ")
    oQryDetail:SetString(nBind++, " ")
    oQryDetail:SetIn(nBind++, StrTokArr(cBranches, "," ))
    oQryDetail:SetString(nBind++, cMovimentType)
    oQryDetail:SetString(nBind++, StrTran(cPeriodStart, "-", ""))
    oQryDetail:SetString(nBind++, StrTran(cPeriodEnd, "-", ""))
    oQryDetail:SetNumeric(nBind++, 0)
    oQryDetail:SetIn(nBind++, {"000060","000061","000062"})
    oQryDetail:SetString(nBind++, cUF)
    oQryDetail:SetString(nBind++, " ")

    oQryDetail:cBaseQuery := oQryDetail:GetFixQuery()
    cAlias2 := oQryDetail:OpenAlias()

    FwFreeObj(oQryDetail)
Return
