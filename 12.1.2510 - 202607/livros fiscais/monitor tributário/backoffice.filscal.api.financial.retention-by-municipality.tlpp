#INCLUDE "tlpp-core.th"
#INCLUDE "tlpp-rest.th"
#INCLUDE "totvs.ch"
#INCLUDE "FISA318.CH"

/*/ {Protheus.doc} TITFinancialRetentionByMunicipality
    Endpoint REST para processar a requisição da API TOP 10 total de retenções por Município.
    @type  Function
    @author Caique Carlos
    @since 19/01/2026
    @version 1.0
    @param branches, character, Código das filiais separadas por vírgula (via query parameter)
    @param periodStart, character, Data inicial do período no formato YYYY-MM-DD (via query parameter)
    @param periodEnd, character, Data final do período no formato YYYY-MM-DD (via query parameter)
    @return Nil, nulo, Resposta enviada via framework oRest
    @example
        GET /api/fiscal/tax-monitor/v1/financial/municipal/retention-by-municipality?branches=D MG 01,D RJ 02&periodStart=2024-01-01&periodEnd=2024-12-31
/*/
@get(endpoint='/api/fiscal/tax-monitor/v1/financial/municipal/retention-by-municipality', description='API TOP 10 total de retenções por Município')
Function TITFinancialRetentionByMunicipality()
    Local oJsResponse := JsonObject():new()                as json
    Local oQryStr     := oRest:getQueryRequest()           as json
    Local aRequiredProperties                              as array

    aRequiredProperties	:= {;
        {'branches',400,;   //PROPERTY //ERROR_CODE
        STR0069,;           //"O parâmetro 'branches' é obrigatório e não foi informado."
        STR0070},;          //"Informar Código de Filiais separadas por vírgula."
        {'periodStart',400,;
        STR0071,;           //"Nenhuma Data foi informada no parâmetro 'periodStart'."
        STR0072},;          //"Informar a data desejada para o período"
        {'periodEnd',400,;
        STR0073,;           //"Nenhuma Data foi informada no parâmetro 'periodEnd'."
        STR0072};           //"Informar a data desejada para o período"
    }

    If FISA318F6HasApiRequiredProperties(aRequiredProperties, oQryStr, @oJsResponse) 
        oJsResponse := GetJsonFinancialRetentionByMunicipality(;
                                                oQryStr['branches'],;
                                                oQryStr['periodStart'],;
                                                oQryStr['periodEnd'];
                                                )  
    EndIf

    oRest:setKeyHeaderResponse('Content-Type', 'application/json')
    oRest:setResponse(oJsResponse)

    FwFreeArray(aRequiredProperties)
    FWFreeObj(oJsResponse)
    FWFreeObj(oQryStr)
Return

/*/{Protheus.doc} GetJsonFinancialRetentionByMunicipality
    Função para obter os dados e montar json de resposta.
    @type  Function
    @author Caique Carlos
    @since 19/01/2026
    @version 1.0
    @param cBranches, character, Código das filiais separadas por vírgula
    @param cPeriodStart, character, Data inicial do período no formato YYYY-MM-DD
    @param cPeriodEnd, character, Data final do período no formato YYYY-MM-DD
    @return cJsonResponse, character, Dados processados em formato JSON string
    @example
        GetJsonFinancialRetentionByMunicipality("D MG 01,D RJ 02", "2024-01-01", "2024-12-31")
/*/
Static Function GetJsonFinancialRetentionByMunicipality(cBranches as character, cPeriodStart as character, cPeriodEnd as character) as json
    Local oJsResult    := JsonObject():New() as json
    Local cAlias       := GetNextAlias()     as character
    Local nLenJsonResp := 0                  as numeric

    GetValuesRetention(@cAlias, cBranches, cPeriodStart, cPeriodEnd)

    If (cAlias)->(!EoF())
        oJsResult["items"] := {}

        While (cAlias)->(!Eof())
            aAdd( oJsResult["items"], JsonObject():New() )
            nLenJsonResp := Len(oJsResult["items"])
            oJsResult["items"][nLenJsonResp]["municipality"]   := AllTrim((cAlias)->MUNICIPIO)
            oJsResult["items"][nLenJsonResp]["totalRetained"]  := (cAlias)->TOTAL_RETIDO
            oJsResult["items"][nLenJsonResp]["amountPaid"]     := (cAlias)->TOTAL_PAGO
            oJsResult["items"][nLenJsonResp]["amountToPay"]    := (cAlias)->TOTAL_PAGAR

            (cAlias)->(DbSkip())
        EndDo

        oJsResult["hasNext"] := .F.
    Else
        oJsResult["items"]   := {}
        oJsResult["hasNext"] := .F.
    EndIf

    (cAlias)->(DbCloseArea())
Return oJsResult:toJson()

/*/{Protheus.doc} GetValuesRetention
    Função que monta e executa query para obter o resultado TOP 10 Retenções.
    @type  Static Function
    @author Caique Carlos
    @since 08/01/2026
    @version 1.0
    @param cAlias, character, Alias do cursor para manipulação dos dados retornados
    @param cBranches, character, Código das filiais separadas por vírgula
    @param cPeriodStart, character, Data inicial do período no formato YYYY-MM-DD
    @param cPeriodEnd, character, Data final do período no formato YYYY-MM-DD
    @return Nil, nulo, Dados retornados via alias temporário
    @example
        GetValuesRetention(@cAlias, "D MG 01,D RJ 02", "2024-01-01", "2024-12-31")
/*/
Static Function GetValuesRetention(cAlias as character, cBranches as character, cPeriodStart as character, cPeriodEnd as character)
    Local oQryValues  := FWExecStatement():New()    as object
    Local nBind       := 1                          as numeric
    Local cQuery      := ""                         as character
    Local cJoinFilial := FwJoinFilial("SA2","SE2") as character

    cJoinFilial := StrTran(StrTran(cJoinFilial, "SE2.", "CIW."),"E2_","CIW_") // Ajusta o prefixo para tabela CIW

    cQuery := "SELECT "
    cQuery +=   "SA2.A2_MUN MUNICIPIO, "
    cQuery +=   "SUM(CIW.CIW_VALOR) TOTAL_RETIDO, "
    cQuery +=   "SUM((CIW.CIW_VALOR - CIW.CIW_SALDO)) TOTAL_PAGO, "
    cQuery +=   "SUM(CASE WHEN CIW.CIW_SALDO > 0 THEN CIW.CIW_SALDO ELSE 0 END) TOTAL_PAGAR "
    cQuery += "FROM ? CIW "
    cQuery +=   "INNER JOIN " + RetSqlName("SA2") + " SA2 ON ?"                                 // SA2.A2_FILIAL = CIW.CIW_FILIAL        
    cQuery +=   " AND SA2.A2_COD = CIW.CIW_PARTIC AND SA2.A2_LOJA = CIW.CIW_LOJA "
    cQuery += "WHERE CIW.CIW_FILIAL IN ( ? ) "                                                  // D MG 01,D RJ 02
    cQuery +=   "AND CIW.CIW_EMISSA BETWEEN ? AND ? "                                           // 20240101 AND 20241231
    cQuery +=   "AND CIW.CIW_ESFERA = ? "                                                       // 3 (Municipal)
    cQuery +=   "AND CIW.CIW_VALOR > ? "                                                        // 0
    cQuery +=   "AND CIW.D_E_L_E_T_ = ? "                                                       // ' '
    cQuery +=   "AND SA2.D_E_L_E_T_ = ? "                                                       // ' '
    cQuery += "GROUP BY SA2.A2_MUN, CIW_PARTIC, CIW_LOJA "
    cQuery += "ORDER BY SUM(CIW.CIW_VALOR) DESC "                                               // Ordenação Decrescente para obter o TOP 10
    cQuery += "OFFSET 0 ROWS "                                                                  // Valores fixos para manter o ANSI
    cQuery += "FETCH FIRST 10 ROWS ONLY"

    oQryValues:SetQuery(ChangeQuery(cQuery))

    oQryValues:SetUnsafe(nBind++, FIS319SqlName("CIW"))
    oQryValues:SetUnsafe(nBind++, cJoinFilial)
    oQryValues:SetIn(nBind++, StrTokArr(cBranches, ","))
    oQryValues:SetString(nBind++, StrTran(cPeriodStart, "-", ""))
    oQryValues:SetString(nBind++, StrTran(cPeriodEnd, "-", ""))
    oQryValues:SetString(nBind++, "3")
    oQryValues:SetNumeric(nBind++, 0)
    oQryValues:SetString(nBind++, " ")
    oQryValues:SetString(nBind++, " ")

    oQryValues:cBaseQuery := oQryValues:GetFixQuery()
    cAlias := oQryValues:OpenAlias()

    FWFreeObj(oQryValues)
Return Nil
