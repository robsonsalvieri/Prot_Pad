#INCLUDE "tlpp-core.th"
#INCLUDE "tlpp-rest.th"
#INCLUDE "totvs.ch"
#INCLUDE "FISA318.CH"

/*/{Protheus.doc} TITMonthlyTaxEvolution
    API REST para consulta de valores de entrada e saída da Reforma Tributária.
    Endpoint que processa requisições GET para obter dados de carga tributária
    da reforma, validando parâmetros obrigatórios e retornando resposta em JSON.
    @type  Function
    @author Caique Carlos
    @since 28/08/2025
    @version 1.0
    @parâmetros de entrada do endpoint: cBranches, cPeriodStart, cPeriodEnd, movimentType, typeOfData
    @return Nil, nulo, Não possui retorno direto, resposta enviada via oRest
    @example
        GET /api/fiscal/tax-monitor/v1/tax-reform/tax-burden-reform?branches=01,02&periodStart=2024-01-01&periodEnd=2024-12-31&taxedMovements=1
/*/
@get(endpoint='/api/fiscal/tax-monitor/v1/tax-reform/monthly-tax-evolution', description='API Evolução Tributária Mensal')
Function TITMonthlyTaxEvolution()
    Local oJsResponse := JsonObject():new()      as json
    Local oQryStr     := oRest:getQueryRequest() as json
    Local aRequiredProperties                    as array

    aRequiredProperties	:= {;
        {'branches',400,;   //PROPERTY //ERROR_CODE
        STR0069,;           //"O parâmetro 'branches' é obrigatório e não foi informado."
        STR0070},;          //"Informar Código de Filiais separadas por vírgula."
        {'periodStart',400,;
        STR0071,;           //"Nenhuma Data foi informada no parâmetro 'periodStart'."
        STR0072},;          //"Informar a data desejada para o período"
        {'periodEnd',400,;
        STR0073,;           //"Nenhuma Data foi informada no parâmetro 'periodEnd'."
        STR0072},;          //"Informar a data desejada para o período"
        {'movimentType',400,;
        STR0085,;           //"O parâmetro 'movimentType' é obrigatório e não foi informado."
        STR0086},;          //"Informar S Para Movimentos de Saída ou E Para Movimentos de Entrada."
        {'typeOfData',400,;
        STR0094,;           //"O parâmetro 'typeOfData' é obrigatório e não foi informado."
        STR0095};           //"O parâmetro deve conter o tipo de dados. Conforme manual de utilização."
    }

    If FISA318F6HasApiRequiredProperties(aRequiredProperties, oQryStr, @oJsResponse) 
        oJsResponse := GetMonthlyTaxEvolution(oQryStr['branches'], oQryStr['periodStart'], oQryStr['periodEnd'], oQryStr['movimentType'], oQryStr['typeOfData'])   
    EndIf  

    oRest:setKeyHeaderResponse('Content-Type', 'application/json')
    oRest:setResponse(oJsResponse)

    FwFreeArray(aRequiredProperties) 
    FWFreeObj(oJsResponse)
    FWFreeObj(oQryStr)
Return 

/*/{Protheus.doc} GetMonthlyTaxEvolution
    Função estática para processar e retornar a evolução tributária mensal em formato JSON.
    Processa os dados de entrada e saída da reforma tributária, organizando-os por mês e ano.
    @type  Static Function
    @author Caique Carlos
    @since 23/10/2025
    @version 1.0
    @param cBranches, character, Código das filiais separadas por vírgula.
    @param cPeriodStart, character, Data inicial do período no formato YYYY-MM-DD.
    @param cPeriodEnd, character, Data final do período no formato YYYY-MM-DD.
    @param cMovimentType, character, Tipo de movimentação: 'E' para entrada ou 'S' para saída.
    @param cTypeOfData, character, Tipo de dados: '1' para dados reais ou '2' para dados simulados.
    @return oJsonResp:toJson(), json, Retorna os dados processados em formato JSON.
    @example
        Local cJson := GetMonthlyTaxEvolution("01,02", "2024-01-01", "2024-12-31", "E", "1")
/*/
Static Function GetMonthlyTaxEvolution(cBranches as character, cPeriodStart as character, cPeriodEnd as character, cMovimentType as character, cTypeOfData as character)
    Local oJsonResp   := JsonObject():New() as json
    Local aJsonLegacy := {}                 as array
    Local aJsonReform := {}                 as array
    Local cAlias      := GetNextAlias()     as character
    Local nPos        := 0                  as numeric
    Local lStop       := .F.                as logical
    Local lHasNext    := .F.                as logical

    GetResultMonthlyTaxEvolution(@cAlias, cBranches, cPeriodStart, cPeriodEnd, cMovimentType, cTypeOfData)

    If (cAlias)->(!EoF())
        oJsonResp["items"] := {}

        While (cAlias)->(!EoF())
            aAdd( oJsonResp["items"], JsonObject():New() )
            nPos ++
            oJsonResp["items"][nPos]["month"]       := Alltrim((cAlias)->MES)
            oJsonResp["items"][nPos]["year"]        := Alltrim(cValtoChar((cAlias)->ANO))
            oJsonResp["items"][nPos]["operational"] := ""

            lStop := .F.
            aJsonLegacy := {}
            aJsonReform := {}

            While lStop == .F.
                If Alltrim((cAlias)->TRIBUTO) $ 'ICMS|IPI|ISS|PIS|COFINS'
                    aAdd( aJsonLegacy, JsonObject():New() )
                    aJsonLegacy[Len(aJsonLegacy)]["tax"]   := Alltrim((cAlias)->TRIBUTO)
                    aJsonLegacy[Len(aJsonLegacy)]["value"] := (cAlias)->VAL_IMPOSTO

                ElseIf Alltrim((cAlias)->TRIBUTO) $ 'IBS_MUN|IBS_UF|CBS|IS'
                    aAdd( aJsonReform, JsonObject():New() )
                    aJsonReform[Len(aJsonReform)]["tax"]   := Alltrim((cAlias)->TRIBUTO)
                    aJsonReform[Len(aJsonReform)]["value"] := (cAlias)->VAL_IMPOSTO

                ElseIf Alltrim((cAlias)->TRIBUTO) == 'Z_OPERACIONAL'
                    oJsonResp["items"][nPos]["operational"] := (cAlias)->VAL_IMPOSTO
                    lStop := .T.
                EndIf
                (cAlias)->(DbSkip())
            EndDo

            oJsonResp["items"][nPos]["taxes"]           := JsonObject():New()
            oJsonResp["items"][nPos]["taxes"]["legacy"] := aJsonLegacy
            oJsonResp["items"][nPos]["taxes"]["reform"] := aJsonReform
        EndDo
        oJsonResp["hasNext"] := lHasNext
    Else
        oJsonResp["code"]    := "200"
        oJsonResp["items"]   := {}
        oJsonResp["hasNext"] := lHasNext
    EndIf

    FwFreeArray(aJsonLegacy)
    FwFreeArray(aJsonReform)
Return oJsonResp:toJson()

/*/{Protheus.doc} GetResultMonthlyTaxEvolution
    Função estática para executar a consulta SQL e obter os dados detalhados da evolução tributária mensal.
    Constrói e executa a query com base nos parâmetros fornecidos e retorna os resultados.
    @type  Static Function
    @author Caique Carlos
    @since 24/10/2025
    @version 1.0
    @param cAlias, character, Alias do cursor para manipulação dos dados retornados.
    @param cBranches, character, Código das filiais separadas por vírgula.
    @param cPeriodStart, character, Data inicial do período no formato YYYY-MM-DD.
    @param cPeriodEnd, character, Data final do período no formato YYYY-MM-DD.
    @param cMovimentType, character, Tipo de movimentação: 'E' para entrada ou 'S' para saída.
    @param cTypeOfData, character, Tipo de dados: '1' para dados reais ou '2' para dados simulados.
    @return cAlias, character, Retorna o alias com os dados da consulta.
    @example
        GetResultMonthlyTaxEvolution(@cAlias, "01,02", "2024-01-01", "2024-12-31", "E", "1")
/*/
Static Function GetResultMonthlyTaxEvolution(cAlias as character, cBranches as character, cPeriodStart as character, cPeriodEnd as character, cMovimentType as character, cTypeOfData as character)
    Local oQueryEvolution := FWExecStatement():New() as object

    Local cDataBase       := TcGetDb()               as character
    Local cQuery          := ""                      as character
    Local cTributo        := ""                      as character
    Local cTabela         := ""                      as character
    Local cCampo          := ""                      as character
    Local cAno            := ""                      as character

    Local nBind           := 1                       as numeric
    Local nLimite         := 0                       as numeric
    Local nI              := 0                       as numeric
    Local nAliquota       := 0                       as numeric

    Local aTaxes       := { "IBS_UF", "IBS_MUN", "CBS", "IS" } as array
    Local aTaxesByYear := {;
                            { "CBS",     "2026", 0.009 },;
                            { "IBS",     "2026", 0.001 },;
                            { "CBS",     "2027", 0.009 },;
                            { "IBS_UF",  "2027", 0.005 },;
                            { "IBS_MUN", "2027", 0.005 },;
                            { "IS",      "2027", 0.005 };
                        } as array
    Local aTributosLegacy := {;
                            { "IPI",    "CJX", "VALIPI"},;
                            { "ISS",    "CJY", "VALICM"},;
                            { "ICMS",   "CJZ", "VALICM"},;
                            { "PIS",    "CK0", "VALPIS"},;
                            { "COFINS", "CK0", "VALCOF"};
                        } as array

    cQuery += "WITH DETALHAMENTO AS ( "

    For nI := 1 To Len(aTributosLegacy)
        cTributo := aTributosLegacy[nI, 1]
        cTabela  := aTributosLegacy[nI, 2]
        cCampo   := aTributosLegacy[nI, 3]

        If nI > 1
            cQuery += "UNION ALL "
        EndIf

        If cDataBase $ "MSSQL"
            cQuery += ReturnQueryEvolutionMSSQL(1, cTabela, cCampo, cTributo)
        ElseIf cDataBase $ "ORACLE"
            cQuery += ReturnQueryEvolutionORACLE(1, cTabela, cCampo, cTributo)
        ElseIf cDataBase $ "POSTGRESQL"
            cQuery += ReturnQueryEvolutionPostgre(1, cTabela, cCampo, cTributo)
        EndIf
    Next nI

    If cTypeOfData == "1"
        For nI := 1 To Len(aTaxes)
            cTributo := aTaxes[nI]

            If cDataBase $ "MSSQL"
                cQuery += ReturnQueryEvolutionMSSQL(2,,, cTributo)
            ElseIf cDataBase $ "ORACLE"
                cQuery += ReturnQueryEvolutionORACLE(2,,, cTributo)
            ElseIf cDataBase $ "POSTGRESQL"
                cQuery += ReturnQueryEvolutionPostgre(2,,, cTributo)
            EndIf
        Next nI
    ElseIf cTypeOfData == "2"
        For nI := 1 To Len(aTaxesByYear)
            cTributo  := aTaxesByYear[nI, 1]
            cAno      := aTaxesByYear[nI, 2]
            nAliquota := aTaxesByYear[nI, 3]

            If cDataBase $ "MSSQL"
                cQuery += ReturnQueryEvolutionMSSQL(3,,, cTributo, cAno, nAliquota)
            ElseIf cDataBase $ "ORACLE"
                cQuery += ReturnQueryEvolutionORACLE(3,,, cTributo, cAno, nAliquota)
            ElseIf cDataBase $ "POSTGRESQL"
                cQuery += ReturnQueryEvolutionPostgre(3,,, cTributo, cAno, nAliquota)
            EndIf
        Next nI
    EndIf

    cQuery += ") "
    cQuery += "SELECT TRIBUTO, MES, ANO, VAL_IMPOSTO, DATA_EMI FROM DETALHAMENTO "
    cQuery += "UNION ALL "
    cQuery += "SELECT "
    cQuery +=   "'Z_OPERACIONAL' as TRIBUTO, "
    cQuery +=   "MES, "
    cQuery +=   "ANO, "
    cQuery +=   "SUM(VAL_IMPOSTO) AS VAL_IMPOSTO, "
    cQuery +=   "DATA_EMI "
    cQuery += "FROM DETALHAMENTO "
    cQuery += "WHERE DETALHAMENTO.MES = MES AND DETALHAMENTO.ANO = ANO "
    cQuery += "GROUP BY MES, ANO, DATA_EMI "

    If cTypeOfData == "1"
        cQuery += "ORDER BY DATA_EMI, TRIBUTO ASC"
    ElseIf cTypeOfData == "2"
        cQuery += "ORDER BY ANO, DATA_EMI, TRIBUTO ASC"
    EndIf

    oQueryEvolution:SetQuery(cQuery)

    For nLimite := 1 To 5
        oQueryEvolution:SetIn(nBind++, StrTokArr(cBranches, "," ))
        oQueryEvolution:SetString(nBind++, cMovimentType)
        oQueryEvolution:SetString(nBind++, StrTran(cPeriodStart, "-", ""))
        oQueryEvolution:SetString(nBind++, StrTran(cPeriodEnd, "-", ""))
        oQueryEvolution:SetNumeric(nBind++, 0)
        oQueryEvolution:SetString(nBind++, " ")
    Next nLimite

    If cTypeOfData == "1"
        For nLimite := 1 To 4
            oQueryEvolution:SetIn(nBind++, StrTokArr(cBranches, "," )) 
            oQueryEvolution:SetString(nBind++, cMovimentType)
            oQueryEvolution:SetString(nBind++, StrTran(cPeriodStart, "-", ""))
            oQueryEvolution:SetString(nBind++, StrTran(cPeriodEnd, "-", ""))
            oQueryEvolution:SetString(nBind++, "00006" + cValtoChar(nLimite-1))
            oQueryEvolution:SetNumeric(nBind++, 0)
            oQueryEvolution:SetString(nBind++, " ")
        Next nLimite
    ElseIf cTypeOfData == "2"
        For nLimite := 1 To 6
            oQueryEvolution:SetIn(nBind++, StrTokArr(cBranches, "," ))
            oQueryEvolution:SetString(nBind++, cMovimentType)
            oQueryEvolution:SetString(nBind++, "2025" + SubStr(StrTran(cPeriodStart, "-", ""),5,5))
            oQueryEvolution:SetString(nBind++, "2025" + SubStr(StrTran(cPeriodEnd, "-", ""),5,5))
            oQueryEvolution:SetNumeric(nBind++, 0)
            oQueryEvolution:SetNumeric(nBind++, 0)
            oQueryEvolution:SetNumeric(nBind++, 0)
            oQueryEvolution:SetNumeric(nBind++, 0)
            oQueryEvolution:SetNumeric(nBind++, 0)
            oQueryEvolution:SetString(nBind++, " ")
            oQueryEvolution:SetString(nBind++, " ")
        Next nLimite
    EndIf

    oQueryEvolution:cBaseQuery := oQueryEvolution:GetFixQuery()
    cAlias := oQueryEvolution:OpenAlias()

    FwFreeObj(aTaxes)
    FwFreeObj(aTributosLegacy)
    FwFreeObj(aTaxesByYear)
    FwFreeObj(oQueryEvolution)
Return

/*/{Protheus.doc} ReturnQueryEvolutionMSSQL
    Função estática para construir e retornar a query SQL para o banco de dados MSSQL.
    @type  Static Function
    @author Caique Carlos
    @since 29/10/2025
    @version 1.0
    @param nQuery, numeric, Tipo de query a ser gerada (1, 2 ou 3).
        1 - Query de retorno de tributos legados (icms, pis, cofins, ipi, iss)
        2 - Query de retorno de tributos reforma tributária escriturado (IBS_UF, IBS_MUN, CBS, IS)
        3 - Query de retorno de tributos reforma tributária simulados (IBS_UF, IBS_MUN, CBS, IS)
    @param cTabela, character, Nome da tabela a ser consultada.
    @param cCampo, character, Nome do campo a ser somado.
    @param cTributo, character, Nome do tributo a ser filtrado.
    @param cAno, character, Ano para cálculo de alíquota (opcional).
    @param nAliquota, numeric, Alíquota para cálculo (opcional).
    @return cQuery, character, Query SQL gerada.
    @example
        Local cQuery := ReturnQueryEvolutionMSSQL(1, "CJX", "VALIPI", "IPI", "2026", 0.009)
/*/
Static Function ReturnQueryEvolutionMSSQL(nQuery as numeric, cTabela as character, cCampo as character, cTributo as character, cAno as character, nAliquota as numeric)
    Local cQuery := "" as character

    Default nAliquota := 0
    Default cAno      := ""
    Default cTabela   := ""
    default cCampo    := ""
    Default cTributo  := ""

    If nQuery == 1
        cQuery += "SELECT "
        cQuery +=   "'" + cTributo + "' AS TRIBUTO, "                                      // IPI, ISS, ICMS, PIS, COFINS    
        cQuery +=   "DATENAME(MONTH, CAST(" + cTabela + "_ENTRAD AS DATE)) AS MES, "       // CJX, CJY, CJZ, CK0
        cQuery +=   "YEAR(CAST(" + cTabela + "_ENTRAD AS DATE)) AS ANO, "
        cQuery +=   "COALESCE(SUM(" + cTabela + "_" + cCampo + "), 0) AS VAL_IMPOSTO, "    // VALIPI, VALICM, VALPIS, VALCOF
        cQuery +=   "LEFT(" + cTabela + "_ENTRAD, 6) AS DATA_EMI "
        cQuery += "FROM " + FIS319SqlName(cTabela)
        cQuery += " WHERE " + cTabela + "_FILIAL IN (?) "                                  // D MG 01, XIFIS26
        cQuery +=   "AND " + cTabela + IIF(cTabela <> "CJX", "_TIPOMO = ? ", "_TIPMOV = ? ") // E ou S
        cQuery +=   "AND " + cTabela + "_ENTRAD BETWEEN ? AND ? "                          // 20240101 a 20241231
        cQuery +=   "AND " + cTabela + "_" + cCampo + " > ? "                              // maior que 0
        cQuery +=   "AND D_E_L_E_T_ = ? "
        cQuery += "GROUP BY "
        cQuery +=   "DATENAME(MONTH, CAST(" + cTabela + "_ENTRAD AS DATE)), "
        cQuery +=   "YEAR(CAST(" + cTabela + "_ENTRAD AS DATE)), "
        cQuery +=   "LEFT(" + cTabela + "_ENTRAD, 6) "

    ElseIf nQuery == 2
        cQuery += "UNION ALL "
        cQuery +=   "SELECT "
        cQuery +=   "'" + cTributo + "' AS TRIBUTO, "                                 // IBS_UF, IBS_MUN, CBS, IS
        cQuery +=   "DATENAME(MONTH, CAST(CLC_ENTRAD AS DATE)) AS MES, "
        cQuery +=   "YEAR(CAST(CLC_ENTRAD AS DATE)) AS ANO, "
        cQuery +=   "COALESCE(SUM(CLC_VALIMP), 0) AS VAL_IMPOSTO, "
        cQuery +=   "LEFT(CLC_ENTRAD, 6) AS DATA_EMI "
        cQuery += "FROM " + FIS319SqlName("CLC")
        cQuery += " WHERE CLC_FILIAL IN (?) "                                         // D MG 01, XIFIS26
        cQuery +=   "AND CLC_TIPOMO = ? "                                             // E ou S
        cQuery +=   "AND CLC_ENTRAD BETWEEN ? AND ? "                                 // 20240101 a 20241231
        cQuery +=   "AND CLC_IMP = ? "                                                // 000060, 000062 ...
        cQuery +=   "AND CLC_VALIMP > ? "                                             // maior que 0
        cQuery +=   "AND D_E_L_E_T_ = ? "
        cQuery += "GROUP BY  "
        cQuery +=   "DATENAME(MONTH, CAST(CLC_ENTRAD AS DATE)), "
        cQuery +=   "YEAR(CAST(CLC_ENTRAD AS DATE)), "
        cQuery +=   "LEFT(CLC_ENTRAD, 6) "

    ElseIf nQuery == 3
        cQuery += "UNION ALL "
        cQuery += "SELECT "
        cQuery +=   "'" + cTributo + "' AS TRIBUTO, "                                                         // IBS_UF, IBS_MUN, CBS, IS
        cQuery +=   "DATENAME(MONTH, CAST(FT_ENTRADA AS DATE)) AS MES, "
        cQuery +=   "'" + cAno + "' AS ANO, "                                                                 // 2026, 2027
        cQuery +=   "COALESCE(SUM(FT_VALCONT), 0) * " + AllTrim(Str(nAliquota,10,3)) + " AS VAL_IMPOSTO, "    // Aliquota conforme ano e tributo
        cQuery +=   "LEFT(FT_ENTRADA, 6) AS DATA_EMI "
        cQuery += "FROM " + RetSQLName("SFT") + " SFT "
        cQuery += "WHERE FT_FILIAL IN (?) "                                                                   // D MG 01, XIFIS26
        cQuery +=   "AND FT_TIPOMOV = ? "                                                                     // E ou S                                
        cQuery +=   "AND FT_ENTRADA BETWEEN ? AND ? "                                                         // 20250101 a 20251231                
        cQuery +=   "AND FT_VALCONT > ? "                                                                     // maior que 0
        cQuery +=   "AND (FT_VALICM > ? OR FT_VALPIS > ? OR FT_VALCOF > ?) AND FT_VALCONT > ? "               // maior que 0
        cQuery +=   "AND FT_DTCANC = ? "                                                                      // vazio
        cQuery +=   "AND D_E_L_E_T_ = ? "
        cQuery += "GROUP BY "
        cQuery +=   "DATENAME(MONTH, CAST(FT_ENTRADA AS DATE)), "
        cQuery +=   "YEAR(CAST(FT_ENTRADA AS DATE)), "
        cQuery +=   "LEFT(FT_ENTRADA, 6) "
    EndIf

Return cQuery

/*/{Protheus.doc} ReturnQueryEvolutionORACLE
    Função estática para construir e retornar a query SQL para o banco de dados Oracle.
    @type  Static Function
    @author Caique Carlos
    @since 29/10/2025
    @version 1.0
    @param nQuery, numeric, Tipo de query a ser gerada (1, 2 ou 3).
        1 - Query de retorno de tributos legados (icms, pis, cofins, ipi, iss)
        2 - Query de retorno de tributos reforma tributária escriturado (IBS_UF, IBS_MUN, CBS, IS)
        3 - Query de retorno de tributos reforma tributária simulados (IBS_UF, IBS_MUN, CBS, IS)
    @param cTabela, character, Nome da tabela a ser consultada.
    @param cCampo, character, Nome do campo a ser somado.
    @param cTributo, character, Nome do tributo a ser filtrado.
    @param cAno, character, Ano para cálculo de alíquota (opcional).
    @param nAliquota, numeric, Alíquota para cálculo (opcional).
    @return cQuery, character, Query SQL gerada.
    @example
        Local cQuery := ReturnQueryEvolutionORACLE(1, "CJX", "VALIPI", "IPI", "2026", 0.009)
/*/
Static Function ReturnQueryEvolutionORACLE(nQuery as numeric, cTabela as character, cCampo as character, cTributo as character, cAno as character, nAliquota as numeric)
    Local cQuery := "" as character

    Default nAliquota := 0
    Default cAno      := ""
    Default cTabela   := ""
    default cCampo    := ""
    Default cTributo  := ""

    If nQuery == 1
        cQuery += "SELECT "
        cQuery +=   "'" + cTributo + "' AS TRIBUTO, "                                           // IPI, ISS, ICMS, PIS, COFINS    
        cQuery +=   "TO_CHAR(TO_DATE(" + cTabela + "_ENTRAD, 'YYYYMMDD'), 'MONTH') AS MES, " 
        cQuery +=   "TO_CHAR(TO_DATE(" + cTabela + "_ENTRAD, 'YYYYMMDD'), 'YYYY') AS ANO, "
        cQuery +=   "NVL(SUM(" + cTabela + "_" + cCampo + "), 0) AS VAL_IMPOSTO, "              // VALIPI, VALICM, VALPIS, VALCOF
        cQuery +=   "SUBSTR(" + cTabela + "_ENTRAD, 1, 6) AS DATA_EMI "
        cQuery += "FROM " + FIS319SqlName(cTabela)
        cQuery += " WHERE " + cTabela + "_FILIAL IN (?) "                                       // D MG 01, XIFIS26
        cQuery +=   "AND " + cTabela + IIF(cTabela <> "CJX", "_TIPOMO = ? ", "_TIPMOV = ? ")    // E ou S
        cQuery +=   "AND " + cTabela + "_ENTRAD BETWEEN ? AND ? "                               // 20240101 a 20241231
        cQuery +=   "AND " + cTabela + "_" + cCampo + " > ? "                                   // maior que 0
        cQuery +=   "AND D_E_L_E_T_ = ? "
        cQuery += "GROUP BY "
        cQuery +=   "TO_CHAR(TO_DATE(" + cTabela + "_ENTRAD, 'YYYYMMDD'), 'MONTH'), "
        cQuery +=   "TO_CHAR(TO_DATE(" + cTabela + "_ENTRAD, 'YYYYMMDD'), 'YYYY'), "
        cQuery +=   "SUBSTR(" + cTabela + "_ENTRAD, 1, 6) "

    ElseIf nQuery == 2
        cQuery += "UNION ALL "
        cQuery += "SELECT "
        cQuery +=   "'" + cTributo + "' AS TRIBUTO, "                                   // IBS_UF, IBS_MUN, CBS, IS
        cQuery +=   "TO_CHAR(TO_DATE(CLC_ENTRAD, 'YYYYMMDD'), 'MONTH') AS MES, "
        cQuery +=   "TO_CHAR(TO_DATE(CLC_ENTRAD, 'YYYYMMDD'), 'YYYY') AS ANO, "
        cQuery +=   "NVL(SUM(CLC_VALIMP), 0) AS VAL_IMPOSTO, "
        cQuery +=   "SUBSTR(CLC_ENTRAD, 1, 6) AS DATA_EMI "
        cQuery += "FROM " + FIS319SqlName("CLC") + " "
        cQuery += "WHERE CLC_FILIAL IN (?) "                                            // D MG 01, XIFIS26
        cQuery +=   "AND CLC_TIPOMO = ? "                                               // E ou S
        cQuery +=   "AND CLC_ENTRAD BETWEEN ? AND ? "                                   // 20240101 a 20241231
        cQuery +=   "AND CLC_IMP = ? "                                                  // 000060, 000062 ...
        cQuery +=   "AND CLC_VALIMP > ? "                                               // maior que 0
        cQuery +=   "AND D_E_L_E_T_ = ? "
        cQuery += "GROUP BY "
        cQuery +=   "TO_CHAR(TO_DATE(CLC_ENTRAD, 'YYYYMMDD'), 'MONTH'), "
        cQuery +=   "TO_CHAR(TO_DATE(CLC_ENTRAD, 'YYYYMMDD'), 'YYYY'), "
        cQuery +=   "SUBSTR(CLC_ENTRAD, 1, 6) "

    ElseIf nQuery == 3
        cQuery += "UNION ALL "
        cQuery += "SELECT "
        cQuery +=   "'" + cTributo + "' AS TRIBUTO, "                                                          // IBS_UF, IBS_MUN, CBS, IS
        cQuery +=   "TO_CHAR(TO_DATE(FT_ENTRADA, 'YYYYMMDD'), 'MONTH') AS MES, "
        cQuery +=   "'" + cAno + "' AS ANO, "                                                                  // 2026, 2027
        cQuery +=   "NVL(SUM(FT_VALCONT), 0) * " + AllTrim(Str(nAliquota,10,3)) + " AS VAL_IMPOSTO, "          // Aliquota conforme ano e tributo
        cQuery +=   "SUBSTR(FT_ENTRADA, 1, 6) AS DATA_EMI "
        cQuery += "FROM " + RetSQLName("SFT") + " SFT "
        cQuery += "WHERE FT_FILIAL IN (?) "                                                                    // D MG 01, XIFIS26
        cQuery +=   "AND FT_TIPOMOV = ? "                                                                      // E ou S                                
        cQuery +=   "AND FT_ENTRADA BETWEEN ? AND ? "                                                          // 20250101 a 20251231                
        cQuery +=   "AND FT_VALCONT > ? "                                                                      // maior que 0
        cQuery +=   "AND (FT_VALICM > ? OR FT_VALPIS > ? OR FT_VALCOF > ?) AND FT_VALCONT > ? "                // maior que 0
        cQuery +=   "AND FT_DTCANC = ? "                                                                       // vazio
        cQuery +=   "AND D_E_L_E_T_ = ? "
        cQuery += "GROUP BY "
        cQuery +=   "TO_CHAR(TO_DATE(FT_ENTRADA, 'YYYYMMDD'), 'MONTH'), "
        cQuery +=   "TO_CHAR(TO_DATE(FT_ENTRADA, 'YYYYMMDD'), 'YYYY'), "
        cQuery +=   "SUBSTR(FT_ENTRADA, 1, 6) "

    EndIf

Return cQuery

/*/{Protheus.doc} ReturnQueryEvolutionPostgre
    Função estática para construir e retornar a query SQL para o banco de dados PostgreSQL.
    @type  Static Function
    @author Caique Carlos
    @since 29/10/2025
    @version 1.0
    @param nQuery, numeric, Tipo de query a ser gerada (1, 2 ou 3).
        1 - Query de retorno de tributos legados (icms, pis, cofins, ipi, iss)
        2 - Query de retorno de tributos reforma tributária escriturado (IBS_UF, IBS_MUN, CBS, IS)
        3 - Query de retorno de tributos reforma tributária simulados (IBS_UF, IBS_MUN, CBS, IS)
    @param cTabela, character, Nome da tabela a ser consultada.
    @param cCampo, character, Nome do campo a ser somado.
    @param cTributo, character, Nome do tributo a ser filtrado.
    @param cAno, character, Ano para cálculo de alíquota (opcional).
    @param nAliquota, numeric, Alíquota para cálculo (opcional).
    @return cQuery, character, Query SQL gerada.
    @example
        Local cQuery := ReturnQueryEvolutionPostgre(1, "CJX", "VALIPI", "IPI", "2026", 0.009)
/*/
Static Function ReturnQueryEvolutionPostgre(nQuery as numeric, cTabela as character, cCampo as character, cTributo as character, cAno as character, nAliquota as numeric)
    Local cQuery := "" as character

    Default nAliquota := 0
    Default cAno      := ""
    Default cTabela   := ""
    default cCampo    := ""
    Default cTributo  := ""

    If nQuery == 1
        cQuery += "SELECT "
        cQuery +=   "'" + cTributo + "' AS TRIBUTO, "                                           // IPI, ISS, ICMS, PIS, COFINS    
        cQuery +=   "TO_CHAR(TO_DATE(" + cTabela + "_ENTRAD, 'YYYYMMDD'), 'Month') AS MES, "    // Nome do mês
        cQuery +=   "LEFT(" + cTabela + "_ENTRAD, 4) AS ANO, "
        cQuery +=   "COALESCE(SUM(" + cTabela + "_" + cCampo + "), 0) AS VAL_IMPOSTO, "         // VALIPI, VALICM, VALPIS, VALCOF
        cQuery +=   "LEFT(" + cTabela + "_ENTRAD, 6) AS DATA_EMI "
        cQuery += "FROM " + FIS319SqlName(cTabela)
        cQuery += " WHERE " + cTabela + "_FILIAL IN (?) "                                       // D MG 01, XIFIS26
        cQuery +=   "AND " + cTabela + IIF(cTabela <> "CJX", "_TIPOMO = ?", "_TIPMOV = ? ")     // E ou S
        cQuery +=   " AND " + cTabela + "_ENTRAD BETWEEN ? AND ? "                              // 20240101 a 20241231
        cQuery +=   "AND " + cTabela + "_" + cCampo + " > ? "                                   // maior que 0
        cQuery +=   "AND D_E_L_E_T_ = ? "
        cQuery += "GROUP BY "
        cQuery +=   "TO_CHAR(TO_DATE(" + cTabela + "_ENTRAD, 'YYYYMMDD'), 'Month'), "
        cQuery +=   "LEFT(" + cTabela + "_ENTRAD, 4), "
        cQuery +=   "LEFT(" + cTabela + "_ENTRAD, 6) "

    ElseIf nQuery == 2
        cQuery += "UNION ALL "
        cQuery += "SELECT "
        cQuery +=   "'" + cTributo + "' AS TRIBUTO, "                                       // IBS_UF, IBS_MUN, CBS, IS
        cQuery +=   "TO_CHAR(TO_DATE(CLC_ENTRAD, 'YYYYMMDD'), 'Month') AS MES, "
        cQuery +=   "LEFT(CLC_ENTRAD, 4) AS ANO, "
        cQuery +=   "COALESCE(SUM(CLC_VALIMP), 0) AS VAL_IMPOSTO, "
        cQuery +=   "LEFT(CLC_ENTRAD, 6) AS DATA_EMI "
        cQuery += "FROM " + FIS319SqlName("CLC")
        cQuery += " WHERE CLC_FILIAL IN (?) "                                               // D MG 01, XIFIS26
        cQuery +=   "AND CLC_TIPOMO = ? "                                                   // E ou S
        cQuery +=   "AND CLC_ENTRAD BETWEEN ? AND ? "                                       // 20240101 a 20241231
        cQuery +=   "AND CLC_IMP = ? "                                                      // 000060, 000062 ...
        cQuery +=   "AND CLC_VALIMP > ? "                                                   // maior que 0
        cQuery +=   "AND D_E_L_E_T_ = ? "
        cQuery += "GROUP BY "
        cQuery +=   "TO_CHAR(TO_DATE(CLC_ENTRAD, 'YYYYMMDD'), 'Month'), "
        cQuery +=   "LEFT(CLC_ENTRAD, 4), "
        cQuery +=   "LEFT(CLC_ENTRAD, 6) "

    ElseIf nQuery == 3
        cQuery += "UNION ALL "
        cQuery += "SELECT "
        cQuery +=   "'" + cTributo + "' AS TRIBUTO, "                                                      // IBS_UF, IBS_MUN, CBS, IS
        cQuery +=   "TO_CHAR(TO_DATE(FT_ENTRADA, 'YYYYMMDD'), 'Month') AS MES, "
        cQuery +=   "'" + cAno + "' AS ANO, "                                                              // 2026, 2027
        cQuery +=   "COALESCE(SUM(FT_VALCONT), 0) * " + AllTrim(Str(nAliquota,10,3)) + " AS VAL_IMPOSTO, " // Aliquota conforme ano e tributo
        cQuery +=   "LEFT(FT_ENTRADA, 6) AS DATA_EMI "
        cQuery += "FROM " + RetSQLName("SFT") + " SFT "
        cQuery += "WHERE FT_FILIAL IN (?) "                                                                // D MG 01, XIFIS26 
        cQuery +=   "AND FT_TIPOMOV = ? "                                                                  // E ou S                                
        cQuery +=   "AND FT_ENTRADA BETWEEN ? AND ? "                                                      // 20250101 a 20251231                
        cQuery +=   "AND FT_VALCONT > ? "                                                                  // maior que 0
        cQuery +=   "AND (FT_VALICM > ? OR FT_VALPIS > ? OR FT_VALCOF > ?) AND FT_VALCONT > ? "            // maior que 0
        cQuery +=   "AND FT_DTCANC = ? "                                                                   // vazio
        cQuery +=   "AND D_E_L_E_T_ = ? "
        cQuery += "GROUP BY "
        cQuery +=   "TO_CHAR(TO_DATE(FT_ENTRADA, 'YYYYMMDD'), 'Month'), "
        cQuery +=   "LEFT(FT_ENTRADA, 4), "
        cQuery +=   "LEFT(FT_ENTRADA, 6) "

    EndIf
Return cQuery
