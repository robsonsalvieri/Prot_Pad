#INCLUDE "TOTVS.CH"
#INCLUDE "PROTHEUS.CH"
#INCLUDE "FISA318.CH"
#include "totvs.framework.treports.integratedprovider.th"

namespace totvs.protheus.backoffice.sv.fiscal.auditintegration.treports.integratedprovider

/*/{Protheus.doc} TributesNatureBusinessObject
    Objeto de Negócio SmartView para Relatório SV integração ao TIT.

    @type  Class
    @author Caique Carlos
    @since 26/01/2026
    @version 1.0
    @see https://tdn.totvs.com/pages/releaseview.action?pageId=625448935
/*/
@totvsFrameworkTReportsIntegratedProvider(;
    active=.T.,;
    team="SIGAFIS",;
    name="TITAuditDataIntegrationBusinessObject",;
    country="BRA",;
    initialRelease="12.1.2310";
)
Class TITAuditDataIntegrationBusinessObject From totvs.framework.treports.integratedprovider.IntegratedProvider
    Public Method new()         as object
    Public Method getData()     as object
    Public Method getSchema()   as object
EndClass

/*/{Protheus.doc} new
    Construtor da classe - Define área, nome de exibição e descrição do Objeto de Negócio.
    Utiliza helper FISA318F4GetDisplayNameComplement() para sufixo com timestamp.
    Antes de tudo, valida se o ambiente tem todos os requisitos mínimos para execução.

    @type   Method
    @author Caique Carlos
    @since  26/01/2026
    @version 1.0
    @return object, self (instância da classe)
*/  
Method new() as object Class TITAuditDataIntegrationBusinessObject
    _Super:new()
    ::appendArea(STR0006) //"Monitor Tributário"
    ::setDisplayName(STR0131 + FISA318F4GetDisplayNameComplement()) // Auditoria-Integracao-TIT_
    ::setDescription(STR0132) //"Auditoria dos dados a serem integrados/já integrados ao TOTVS Inteligência Tributária no formato Visão de Dados da Tecnologia SmartView"
Return self

/*/{Protheus.doc} getData
    Retorna dados do objeto de negócio.
    Consome função getDataIntegrationTIT() que retornará os dados para
    montagem do Data do SV.
    
    @type   Method
    @author Caique Carlos
    @since 26/01/2026
    @version 1.0
    @param  oFilter, object, Objeto FWFilter com parâmetros do SmartView (branches, periodStart, periodEnd)
    @return object, self:oData (array de hashmaps com dados consolidados)
/*/
Method getData(nPage as numeric, oFilter as object) as object Class TITAuditDataIntegrationBusinessObject
    Local oIntegrationData := JsonObject():new() as object
    Local oFilterParams    := Nil                as object
    Local cAliasTaxes      := GetNextAlias()     as character

    oFilterParams := oFilter:getParameters()

    getDataIntegrationTIT(  @cAliasTaxes                                   ,;
                            oFilterParams["branches"]                      ,;
                            SubStr(oFilterParams["periodStart"][1], 1, 10) ,;
                            SubStr(oFilterParams["periodEnd"][1], 1, 10)   ,;
                            cValToChar(oFilterParams["taxedMovements"][1])     ;
                        )

    If (cAliasTaxes)->(!EoF())    
        While (cAliasTaxes)->(!Eof())
            oIntegrationData["branch"]                := AllTrim((cAliasTaxes)->FILIAL)
            oIntegrationData["entry"]                 := FWTimeStamp(5, STod((cAliasTaxes)->ENTRADA), "00:00:00")
            oIntegrationData["dataInvoice"]           := AllTrim((cAliasTaxes)->NOTA_FISCAL)
            oIntegrationData["integrationStatus"]     := (cAliasTaxes)->STATUS_INTEGRACAO
            oIntegrationData["cfop"]                  := AllTrim((cAliasTaxes)->CFOP)
            oIntegrationData["cclasstrib"]            := AllTrim((cAliasTaxes)->CCLASSTRIB)
            oIntegrationData["taxId"]                 := AllTrim((cAliasTaxes)->ID_TRIBUTO)
            oIntegrationData["series"]                := AllTrim((cAliasTaxes)->SERIE)
            oIntegrationData["operationalValue"]      := (cAliasTaxes)->VALOR_OPERACIONAL
            oIntegrationData["clientSupplierCode"]    := AllTrim((cAliasTaxes)->CLIENTE_FORNECEDOR)
            oIntegrationData["dashIpi"]               := (cAliasTaxes)->TEM_IPI
            oIntegrationData["dashIss"]               := (cAliasTaxes)->TEM_ISS
            oIntegrationData["dashIcms"]              := (cAliasTaxes)->TEM_ICMS
            oIntegrationData["dashPisCof"]            := (cAliasTaxes)->TEM_PISCOF
            oIntegrationData["dashReform"]            := (cAliasTaxes)->TEM_REFORMA
            oIntegrationData["item"]                  := (cAliasTaxes)->ITEM
            oIntegrationData["product"]               := AllTrim((cAliasTaxes)->PRODUTO)
            oIntegrationData["quantity"]              := (cAliasTaxes)->QUANTIDADE
            oIntegrationData["unitValue"]             := (cAliasTaxes)->VALOR_UNITARIO
            oIntegrationData["discount"]              := (cAliasTaxes)->DESCONTO
            oIntegrationData["typeLaunch"]            := AllTrim((cAliasTaxes)->LANCAMENTO)
            oIntegrationData["typeMovement"]          := AllTrim((cAliasTaxes)->MOVIMENTO)
            oIntegrationData["species"]               := AllTrim((cAliasTaxes)->ESPECIE)
            oIntegrationData["clientSupplierName"]    := AllTrim((cAliasTaxes)->CLI_FORN_NOME)
            oIntegrationData["clientSupplierStore"]   := AllTrim((cAliasTaxes)->CLI_FORN_LOJA)
            oIntegrationData["clientSupplierType"]    := AllTrim((cAliasTaxes)->CLI_FORN_TIPO)
            oIntegrationData["clientSupplierCountry"] := AllTrim((cAliasTaxes)->CLI_FORN_PAIS)
            oIntegrationData["clientSupplierSimpNac"] := AllTrim((cAliasTaxes)->CLI_FORN_SIMPNAC)
            oIntegrationData["clientSupplierState"]   := AllTrim((cAliasTaxes)->CLI_FORN_UF)
            oIntegrationData["clientSupplierCity"]    := AllTrim((cAliasTaxes)->CLI_FORN_MUN)

            ::appendData(oIntegrationData)
            (cAliasTaxes)->(DbSkip())
        EndDo
    EndIf

    FwFreeObj(oIntegrationData)
    FwFreeObj(oFilterParams)
    (cAliasTaxes)->(DbCloseArea())
Return ::oData

/*/{Protheus.doc} getSchema
    Retorna estrutura dos campos (schema) do Objeto de Negócio.
    Define parâmetros de filtro (branches, periodStart, periodEnd)
    e colunas de dados.
    Parametros de data inicializado com valores padrão.
    Parametro branches com URL customizada para seleção de filiais (Lookup).

    @type   Method
    @author Caique Carlos
    @since 26/01/2026
    @version 1.0 
    @return object, self:oSchema (definição de parâmetros e colunas)
    @see 
        https://tdn.totvs.com/display/public/framework/GenericLookupService
        https://tdn.totvs.com/pages/releaseview.action?pageId=799256136
/*/  
Method getSchema() as object Class TITAuditDataIntegrationBusinessObject
    ::addParameter("branches", STR0002, "string", .T.) //Filiais
    ::setCustomURL("branches", "api/framework/v1/genericLookupService/smartview/SM0", 2)

    ::addParameter("periodStart", STR0003, "date", .F.,"",,,,,,,{totvs.framework.treports.date.dateToTimeStamp(Date()-365)}) //"Período Inicial"
    ::addParameter("periodEnd",   STR0004, "date", .F.,"",,,,,,,{totvs.framework.treports.date.dateToTimeStamp(Date())})     //"Período Final"

    ::addParameter("taxedMovements", "Considera Movimentos Tributados", "number", .F.)     //"Considera Movimentos Tributados"
    ::setCustomURL("taxedMovements", "/api/fiscal/tax-monitor/v1/generic-functions/values-combo/auditintegration/TITSvValuesParamComboAuditIntegration", 1)

    ::addProperty("branch"               , STR0010                          , "string", STR0010                          , "branch"               ) //"Filial"
    ::addProperty("entry"                , STR0133                          , "date"  , STR0133                          , "entry"                ) //"Entrada"
    ::addProperty("dataInvoice"          , STR0134                          , "string", STR0134                          , "dataInvoice"          ) //"Número da NF"
    ::addProperty("integrationStatus"    , STR0130                          , "string", STR0130                          , "integrationStatus"    ) //"Status"
    ::addProperty("cfop"                 , STR0015                          , "string", STR0015                          , "cfop"                 ) //"CFOP"
    ::addProperty("cclasstrib"           , STR0135                          , "string", STR0135                          , "cclasstrib"           ) //"cClassTrib"
    ::addProperty("taxId"                , STR0136                          , "string", STR0136                          , "taxId"                ) //"ID Tributo"
    ::addProperty("series"               , STR0137                          , "string", STR0137                          , "series"               ) //"Série"
    ::addProperty("operationalValue"     , STR0027                          , "number", STR0027                          , "operationalValue"     ) //"Valor Operacional"
    ::addProperty("clientSupplierCode"   , STR0138                          , "string", STR0138                          , "clientSupplierCode"   ) //"Cliente Fornecedor"
    ::addProperty("dashIpi"              , STR0139 + STR0017                , "string", STR0139 + STR0017                , "dashIpi"              ) //"Dash IPI"
    ::addProperty("dashIss"              , STR0139 + STR0029                , "string", STR0139 + STR0029                , "dashIss"              ) //"Dash ISS"
    ::addProperty("dashIcms"             , STR0139 + STR0028                , "string", STR0139 + STR0028                , "dashIcms"             ) //"Dash ICMS"
    ::addProperty("dashPisCof"           , STR0139 + STR0030 + " " + STR0031, "string", STR0139 + STR0030 + " " + STR0031, "dashPisCof"           ) //"Dash PIS COFINS"
    ::addProperty("dashReform"           , STR0139 + STR0140                , "string", STR0139 + STR0140                , "dashReform"           ) //"Dash Reforma"
    ::addProperty("item"                 , STR0147                          , "string", STR0147                          , "item"                 ) //"Item"
    ::addProperty("product"              , STR0016                          , "string", STR0016                          , "product"              ) //"Produto"
    ::addProperty("quantity"             , STR0148                          , "number", STR0148                          , "quantity"             ) //"Quantidade"
    ::addProperty("unitValue"            , STR0149                          , "number", STR0149                          , "unitValue"            ) //"Valor Unitário"
    ::addProperty("discount"             , STR0150                          , "number", STR0150                          , "discount"             ) //"Desconto"
    ::addProperty("typeLaunch"           , STR0151                          , "string", STR0151                          , "typeLaunch"           ) //"Tipo de Lançamento"
    ::addProperty("typeMovement"         , STR0005                          , "string", STR0005                          , "typeMovement"         ) //"Tipo de Movimento"
    ::addProperty("species"              , STR0152                          , "string", STR0152                          , "species"              ) //"Espécie"
    ::addProperty("clientSupplierName"   , STR0153 + " " + STR0157          , "string", STR0153 + " " + STR0157          , "clientSupplierName"   ) //"Nome Cliente/Fornecedor"
    ::addProperty("clientSupplierStore"  , STR0122 + " " + STR0157          , "string", STR0122 + " " + STR0157          , "clientSupplierStore"  ) //"Loja Cliente/Fornecedor"
    ::addProperty("clientSupplierType"   , STR0154 + " " + STR0157          , "string", STR0154 + " " + STR0157          , "clientSupplierType"   ) //"Tipo Cliente/Fornecedor"
    ::addProperty("clientSupplierCountry", STR0155 + " " + STR0157          , "string", STR0155 + " " + STR0157          , "clientSupplierCountry") //"País Cliente/Fornecedor"
    ::addProperty("clientSupplierSimpNac", STR0156 + " " + STR0157          , "string", STR0156 + " " + STR0157          , "clientSupplierSimpNac") //"SimpNac Cliente/Fornecedor"
    ::addProperty("clientSupplierState"  , STR0056 + " " + STR0157          , "string", STR0056 + " " + STR0157          , "clientSupplierState"  ) //"Estado Cliente/Fornecedor"
    ::addProperty("clientSupplierCity"   , STR0026 + " " + STR0157          , "string", STR0026 + " " + STR0157          , "clientSupplierCity"   ) //"Cidade Cliente/Fornec
Return ::oSchema

/*/{Protheus.doc} getDataIntegrationTIT
    Executa query para obtenção dos dados de auditoria do TIT.
    @type  Static Function
    @author Caique Carlos
    @since 26/01/2026
    @version 1.0
    @param cAliasTaxes, character, alias utilizado para query referenciado
    @param aBranches, array, array de filiais
    @param cPeriodStart, character, data inicial do período
    @param cPeriodEnd, character, data final do período
    @param cTaxedMovements, character, indica se considera movimentos tributados
    @example
        getDataIntegrationTIT(@cAliasTaxes, {'D MG 01'}, '2025-01-01', '2025-12-31', '1')
/*/
Static Function getDataIntegrationTIT(cAliasTaxes as character, aBranches as array, cPeriodStart, cPeriodEnd, cTaxedMovements)
    Local oExtMnt	 := Nil	                                            as object
    Local cCodRSef   := StrTran( xFUNCodSef({"D","I"},.F.)," ", "" )	as character
    Local cQuery     := ""											    as character
	Local cFixQuery  := ""												as character
	Local cGroup     := "TOTVSInteligenciaTributaria"					as character

    Default aBranches       := { cFilAnt }
    Default cPeriodStart    := DToS(Date()-365)
    Default cPeriodEnd      := DToS(Date())
    Default cTaxedMovements := "3"

    cQuery += "SELECT "
    cQuery +=    "SFT.FT_FILIAL FILIAL, "
    cQuery +=    "SFT.FT_ENTRADA ENTRADA, "
    cQuery +=    "SFT.FT_NFISCAL NOTA_FISCAL, "
    cQuery +=    "SFT.FT_SERIE SERIE, "
	cQuery +=    "SFT.FT_ITEM ITEM, "
	cQuery +=    "SFT.FT_PRODUTO PRODUTO, "
	cQuery +=    "SFT.FT_QUANT QUANTIDADE, "
	cQuery +=    "SFT.FT_DESCONT DESCONTO, "
	cQuery +=    "SFT.FT_PRCUNIT VALOR_UNITARIO, "
	cQuery +=    "SFT.FT_TIPO LANCAMENTO, "
	cQuery +=    "SFT.FT_TIPOMOV MOVIMENTO, "
	cQuery +=    "SFT.FT_ESPECIE ESPECIE, "
    cQuery +=    "SFT.FT_CFOP CFOP, "
    cQuery +=    "COALESCE(CJ3.CJ3_CCT, ' ') CCLASSTRIB, "
    cQuery +=    "SFT.FT_IDTRIB ID_TRIBUTO, "
    cQuery +=    "SFT.FT_VALCONT VALOR_OPERACIONAL, "
    cQuery +=    "SFT.FT_CLIEFOR CLIENTE_FORNECEDOR, "
    
    cQuery += "CASE WHEN ( SFT.FT_VALICM > 0 OR SFT.FT_VALIPI > 0 OR SFT.FT_VALPIS > 0 OR SFT.FT_VALCOF > 0 ) AND SFT.FT_VALCONT > 0 "
    cQuery +=   "AND ("
    cQuery +=         "COALESCE(CJX.CJX_NFISCA, ' ')    = ' ' AND COALESCE(CJY.CJY_NFISCA, ' ') = ' ' "
    cQuery +=         "AND COALESCE(CJZ.CJZ_NFISCA, ' ') = ' ' AND COALESCE(CK0.CK0_NFISCA, ' ') = ' ' "
    cQuery +=         "AND COALESCE(CLC.CLC_NFISCA, ' ') = ' ') THEN '" + STR0142 + "' "
    cQuery +=   "WHEN ( SFT.FT_VALICM > 0 OR SFT.FT_VALIPI > 0 OR SFT.FT_VALPIS > 0 OR SFT.FT_VALCOF > 0 ) AND SFT.FT_VALCONT > 0 "
    cQuery +=    "AND ("
	cQuery +=         "COALESCE(CJX.CJX_NFISCA, ' ')    <> ' ' OR COALESCE(CJY.CJY_NFISCA, ' ') <> ' ' "
	cQuery +=         "OR COALESCE(CJZ.CJZ_NFISCA, ' ') <> ' ' OR COALESCE(CK0.CK0_NFISCA, ' ') <> ' ' "
	cQuery +=         "OR COALESCE(CLC.CLC_NFISCA, ' ') <> ' ') THEN '" + STR0141 + "' "
    cQuery +=   "WHEN SFT.FT_VALICM = 0 AND SFT.FT_VALIPI = 0 AND SFT.FT_VALPIS = 0 AND SFT.FT_VALCOF = 0 AND SFT.FT_VALCONT > 0 "
	cQuery +=     "THEN '" + STR0145 + "' "
    cQuery += "END STATUS_INTEGRACAO, "

    cQuery += "COALESCE(SA2.A2_NOME, SA1.A1_NOME, '') CLI_FORN_NOME, "
    cQuery += "COALESCE(SA2.A2_LOJA, SA1.A1_LOJA, '') CLI_FORN_LOJA, "
    cQuery += "COALESCE(SA2.A2_TIPO, SA1.A1_TIPO, '') CLI_FORN_TIPO, "
    cQuery += "COALESCE(SA2.A2_PAIS, SA1.A1_PAIS, '') CLI_FORN_PAIS, "
    cQuery += "COALESCE(SA2.A2_SIMPNAC, SA1.A1_SIMPNAC, '') CLI_FORN_SIMPNAC, "
    cQuery += "COALESCE(SA2.A2_EST, SA1.A1_EST, '') CLI_FORN_UF, "
    cQuery += "COALESCE(SA2.A2_MUN, SA1.A1_MUN, '') CLI_FORN_MUN, "

    cQuery += "CASE WHEN (COALESCE(CJX.CJX_NFISCA, ' ') <> ' ') THEN '" + STR0143 + "' ELSE '" + STR0144 + "' END TEM_IPI, "
    cQuery += "CASE WHEN (COALESCE(CJY.CJY_NFISCA, ' ') <> ' ') THEN '" + STR0143 + "' ELSE '" + STR0144 + "' END TEM_ISS, "
    cQuery += "CASE WHEN (COALESCE(CJZ.CJZ_NFISCA, ' ') <> ' ') THEN '" + STR0143 + "' ELSE '" + STR0144 + "' END TEM_ICMS, "
    cQuery += "CASE WHEN (COALESCE(CK0.CK0_NFISCA, ' ') <> ' ') THEN '" + STR0143 + "' ELSE '" + STR0144 + "' END TEM_PISCOF, "
    cQuery += "CASE WHEN (COALESCE(CLC.CLC_NFISCA, ' ') <> ' ') THEN '" + STR0143 + "' ELSE '" + STR0144 + "' END TEM_REFORMA "

    cQuery += "FROM " + RetSqlName("SFT") + " SFT "
    cQuery += "INNER JOIN " + RetSqlName('SF3') + " SF3 ON " + FwJoinFilial("SF3", "SFT") + " "
    cQuery +=   "AND SF3.F3_SERIE   = SFT.FT_SERIE AND SF3.F3_NFISCAL      = SFT.FT_NFISCAL "
    cQuery +=   "AND SF3.F3_CLIEFOR = SFT.FT_CLIEFOR AND SF3.F3_LOJA       = SFT.FT_LOJA "
    cQuery +=   "AND SF3.F3_CFO     = SFT.FT_CFOP AND SF3.F3_TIPO          = SFT.FT_TIPO "
    cQuery +=   "AND SF3.F3_IDENTFT = SFT.FT_IDENTF3  AND SF3.F3_ENTRADA   = SFT.FT_ENTRADA "
    cQuery +=   "AND SF3.F3_ESPECIE = SFT.FT_ESPECIE  AND SF3.F3_ALIQICM   = SFT.FT_ALIQICM "
    cQuery +=   "AND SF3.F3_DTCANC  = ?  AND SF3.F3_CODRSEF NOT IN (?) "                                                                                   // 1 , 2
    cQuery +=   "AND SF3.D_E_L_E_T_ = ? "                                                                                                                  // 3				                                                                                                

    cQuery += "LEFT JOIN " + RetSqlName("CJ3") + " CJ3 ON " + FwJoinFilial("SFT", "CJ3") + " AND CJ3.CJ3_IDTGEN = SFT.FT_IDTRIB AND CJ3.D_E_L_E_T_ = ? "   // 4
    cQuery += "LEFT JOIN " + RetSqlName("SA1") + " SA1 ON " + FwJoinFilial("SA1", "SFT") + " AND SA1.A1_COD = SFT.FT_CLIEFOR "
    cQuery +=   "AND SA1.A1_LOJA = SFT.FT_LOJA AND SA1.D_E_L_E_T_ = ? "                                                                                    // 5
    cQuery += "LEFT JOIN " + RetSqlName("SA2") + " SA2 ON " + FwJoinFilial("SA2", "SFT") + " AND SA2.A2_COD = SFT.FT_CLIEFOR "
    cQuery +=   "AND SA2.A2_LOJA = SFT.FT_LOJA AND SA2.D_E_L_E_T_ = ? "                                                                                    // 6

    cQuery += "LEFT JOIN " + FIS319SqlName("CJX") + " CJX ON CJX.CJX_FILIAL = SFT.FT_FILIAL " 
    cQuery +=   "AND CJX.CJX_TIPMOV = SFT.FT_TIPOMOV AND CJX.CJX_NFISCA  = SFT.FT_NFISCAL "
    cQuery +=   "AND CJX.CJX_SERIE  = SFT.FT_SERIE   AND CJX.CJX_CLIFOR  = SFT.FT_CLIEFOR "
    cQuery +=   "AND CJX.CJX_LOJA   = SFT.FT_LOJA    AND CJX.CJX_ITEM    = SFT.FT_ITEM "
    cQuery +=   "AND CJX.CJX_PRODUT = SFT.FT_PRODUTO AND CJX.D_E_L_E_T_  = ? "                                                                             // 7

    cQuery += "LEFT JOIN " + FIS319SqlName("CJY") + " CJY ON CJY.CJY_FILIAL = SFT.FT_FILIAL "
    cQuery +=   "AND CJY.CJY_TIPOMO = SFT.FT_TIPOMOV AND CJY.CJY_NFISCA  = SFT.FT_NFISCAL "
    cQuery +=   "AND CJY.CJY_SERIE  = SFT.FT_SERIE   AND CJY.CJY_CLIEFO  = SFT.FT_CLIEFOR "
    cQuery +=   "AND CJY.CJY_LOJA   = SFT.FT_LOJA    AND CJY.CJY_ITEM    = SFT.FT_ITEM "
    cQuery +=   "AND CJY.CJY_PRODUT = SFT.FT_PRODUTO AND CJY.D_E_L_E_T_  = ? "                                                                             // 8

    cQuery += "LEFT JOIN " + FIS319SqlName("CJZ") + " CJZ ON CJZ.CJZ_FILIAL = SFT.FT_FILIAL "
    cQuery +=   "AND CJZ.CJZ_TIPOMO = SFT.FT_TIPOMOV AND CJZ.CJZ_NFISCA  = SFT.FT_NFISCAL "
    cQuery +=   "AND CJZ.CJZ_SERIE  = SFT.FT_SERIE   AND CJZ.CJZ_CLIEFO  = SFT.FT_CLIEFOR "
    cQuery +=   "AND CJZ.CJZ_LOJA   = SFT.FT_LOJA    AND CJZ.CJZ_ITEM    = SFT.FT_ITEM "
    cQuery +=   "AND CJZ.CJZ_PRODUT = SFT.FT_PRODUTO AND CJZ.D_E_L_E_T_  = ? "                                                                             // 9

    cQuery += "LEFT JOIN " + FIS319SqlName("CK0") + " CK0 ON CK0.CK0_FILIAL = SFT.FT_FILIAL "
    cQuery +=   "AND CK0.CK0_TIPOMO = SFT.FT_TIPOMOV AND CK0.CK0_NFISCA  = SFT.FT_NFISCAL "
    cQuery +=   "AND CK0.CK0_SERIE  = SFT.FT_SERIE   AND CK0.CK0_CLIEFO  = SFT.FT_CLIEFOR "
    cQuery +=   "AND CK0.CK0_LOJA   = SFT.FT_LOJA    AND CK0.CK0_ITEM    = SFT.FT_ITEM "
    cQuery +=   "AND CK0.CK0_PRODUT = SFT.FT_PRODUTO AND CK0.D_E_L_E_T_  = ? "                                                                             // 10

    cQuery += "LEFT JOIN " + FIS319SqlName("CLC") + " CLC ON CLC.CLC_FILIAL = SFT.FT_FILIAL "
    cQuery +=   "AND CLC.CLC_TIPOMO = SFT.FT_TIPOMOV AND CLC.CLC_NFISCA  = SFT.FT_NFISCAL "
    cQuery +=   "AND CLC.CLC_SERIE  = SFT.FT_SERIE   AND CLC.CLC_CLIEFO  = SFT.FT_CLIEFOR "
    cQuery +=   "AND CLC.CLC_LOJA   = SFT.FT_LOJA    AND CLC.CLC_ITEM    = SFT.FT_ITEM "
    cQuery +=   "AND CLC.CLC_PRODUT = SFT.FT_PRODUTO AND CLC.D_E_L_E_T_  = ? "                                                                             // 11

    cQuery += "WHERE SFT.FT_FILIAL IN (?) "                                                                                                                // 12
    cQuery +=   "AND SFT.FT_DTCANC = ? "                                                                                                                   // 13
    cQuery +=   "AND SFT.FT_ENTRADA BETWEEN ? AND ? "                                                                                                      // 14 , 15

    If cTaxedMovements = "1" // Considera apenas movimentos tributados
        cQuery +=   "AND (SFT.FT_VALICM > ? OR SFT.FT_VALIPI > ? OR SFT.FT_VALPIS > ? OR SFT.FT_VALCOF > ?) AND SFT.FT_VALCONT > ? "                       // 16, 17, 18, 19, 20
        cQuery +=   "AND SFT.D_E_L_E_T_ = ? "                                                                                                              // 21
    ElseIf cTaxedMovements = "2" // Considera apenas movimentos não tributados
        cQuery +=   "AND (SFT.FT_VALICM  = ? AND SFT.FT_VALIPI  = ? AND SFT.FT_VALPIS = ? AND SFT.FT_VALCOF = ?) AND  SFT.FT_VALCONT > ? "                 // 16, 17, 18, 19, 20
        cQuery +=   "AND SFT.D_E_L_E_T_ = ? "                                                                                                              // 21
    Else // Considera ambos os tipos de movimentos
        cQuery +=  "AND SFT.FT_VALCONT > ? "                                                                                                               // 16
        cQuery +=  "AND SFT.D_E_L_E_T_ = ? "                                                                                                               // 17
    EndIf

    cQuery += "ORDER BY SFT.FT_FILIAL, SFT.FT_ENTRADA "

    oExtMnt := FWExecStatement():New()
    oExtMnt:SetQuery(ChangeQuery(cQuery))

    oExtMnt:SetString(1, " ")
    oExtMnt:SetIn(2, StrTokArr(cCodRSef, "," ))
    oExtMnt:SetString(3, " ")
    oExtMnt:SetString(4, " ")
    oExtMnt:SetString(5, " ")
    oExtMnt:SetString(6, " ")
    oExtMnt:SetString(7, " ")
    oExtMnt:SetString(8, " ")
    oExtMnt:SetString(9, " ")
    oExtMnt:SetString(10, " ")
    oExtMnt:SetString(11, " ")

    oExtMnt:SetIn(12, aBranches)
    oExtMnt:SetString(13, " ")
    oExtMnt:SetString(14, StrTran(cPeriodStart,"-",""))
    oExtMnt:SetString(15, StrTran(cPeriodEnd,"-",""))

    If cTaxedMovements = "1"
        oExtMnt:SetNumeric(16, 0)
        oExtMnt:SetNumeric(17, 0)
        oExtMnt:SetNumeric(18, 0)
        oExtMnt:SetNumeric(19, 0)
        oExtMnt:SetNumeric(20, 0)
        oExtMnt:SetString(21, " ")
    ElseIf cTaxedMovements = "2"
        oExtMnt:SetNumeric(16, 0)
        oExtMnt:SetNumeric(17, 0)
        oExtMnt:SetNumeric(18, 0)
        oExtMnt:SetNumeric(19, 0)
        oExtMnt:SetNumeric(20, 0)
        oExtMnt:SetString(21, " ")
    Else
        oExtMnt:SetNumeric(16, 0)
        oExtMnt:SetString(17, " ")
    EndIf

    cAliasTaxes := oExtMnt:OpenAlias()
	cFixQuery   := oExtMnt:GetFixQuery()
    FWLogMsg("DEBUG",, cGroup, FunName(),,, cFixQuery)

    FwFreeObj(oExtMnt)
Return

/*/{Protheus.doc} TITSvValuesParamComboAuditIntegration
    Função para retornar os valores do combo "Considera Movimentos Tributados" do filtro do SmartView.
    É consumido pela classe útil onde o serviço disponibiliza os valores para o combo do SmartView
    através de URL customizada definida no método getSchema().
    @type  Function
    @author Caique Carlos
    @since 13/02/2026
    @version 1.0
    @return return_var, array, retorna array de strings com os valores do combo do SmartView
/*/
Function TITSvValuesParamComboAuditIntegration() as array
Return {STR0143, STR0144, STR0146} // #SIM, #NÃO, #AMBOS
