#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "totvs.framework.treports.integratedprovider.th"
#include "FISA318.CH"

namespace totvs.framework.treports.integratedprovider

/*/{Protheus.doc} TributesNatureBusinessObject
    Objeto de Negócio SmartView para Tributos x Natureza de rendimentos.

    @type  Class
    @author Caique Carlos
    @since 15/01/2026
    @version 1.0
    @see https://tdn.totvs.com/pages/releaseview.action?pageId=625448935
/*/
@totvsFrameworkTReportsIntegratedProvider(;
    active=.T.,;
    team="SIGAFIS",;
    name="TributesNatureBusinessObject",;
    country="BRA",;
    initialRelease="12.1.2310";
)
Class TributesNatureBusinessObject From totvs.framework.treports.integratedprovider.IntegratedProvider
    Public Method new()         as object
    Public Method getData()     as object
    Public Method getSchema()   as object
EndClass

/*/{Protheus.doc} new
    Construtor da classe - Define área, nome de exibição e descrição do Objeto de Negócio.
    Utiliza helper FISA318F4GetDisplayNameComplement() para sufixo com timestamp.
    
    @type   Method
    @author Caique Carlos
    @since  15/01/2026
    @version 1.0
    @return object, self (instância da classe)
*/  
Method new() as object Class TributesNatureBusinessObject
    _Super:new()

    ::appendArea(STR0006) //"Monitor Tributário"
    ::setDisplayName(STR0125 + FISA318F4GetDisplayNameComplement()) //"CARD_VISAO-TRIBUTOS-NATUREZA-RENDIMENTO_"
    ::setDescription(STR0126) //"Abertura dos dados do Card de Visao de Tributos x Natureza de Rendimentos - TOTVS Inteligência Tributária no formato Visão de Dados da Tecnologia SmartView"
Return self

/*/{Protheus.doc} getData
    Retorna dados do objeto de negócio.
    Consome função GetJsonFinancialTributesViewNatureIncome() da API REST interna.
    Processa JSON de resposta expandindo hierarquia principal e detalhes.
    
    @type   Method
    @author Caique Carlos
    @since 15/01/2026
    @version 1.0
    @param  oFilter, object, Objeto FWFilter com parâmetros do SmartView (branches, periodStart, periodEnd)
    @return object, self:oData (array de hashmaps com dados consolidados)
/*/  
Method getData(nPage as numeric, oFilter as object) as object Class TributesNatureBusinessObject
    Local oFuncResponse  := JsonObject():New() as object
    Local oTaxesData     := JsonObject():new() as object
    Local oSynthetic                           as object
    Local oAnalytical                          as object
    Local oFilterParams                        as object
    Local nAnalytical    := 0                  as numeric
    Local nSynthetic     := 0                  as numeric
    Local cIssueDate     := ""                 as character
    Local aTaxesItems                          as array

    oFilterParams := oFilter:getParameters()

    oFuncResponse:FromJson( GetJsonFinancialTaxesNaturePerformance(;
                            oFilterParams["branches"][1],;
                            oFilterParams["periodStart"][1],;
                            oFilterParams["periodEnd"][1],;
                            "federal",;
                            "1",;
                            "999999";
                        ))

    If !Empty(oFuncResponse["items"])    
        aTaxesItems := oFuncResponse["items"]

        For nSynthetic := 1 To Len(aTaxesItems)
            oSynthetic := aTaxesItems[nSynthetic]

            oTaxesData["branch"]        := oSynthetic["branch"]
            oTaxesData["monthYear"]     := oSynthetic["monthYear"]
            oTaxesData["tax"]           := oSynthetic["tax"]
            oTaxesData["nature"]        := oSynthetic["nature"]
            oTaxesData["description"]   := oSynthetic["description"]
            oTaxesData["withheldTotal"] := oSynthetic["withheldTotal"]
            oTaxesData["valuePaid"]     := oSynthetic["valuePaid"]
            oTaxesData["valueToPay"]    := oSynthetic["valueToPay"]

            For nAnalytical := 1 To Len(oSynthetic["detail"])
                oAnalytical := oSynthetic["detail"][nAnalytical]
                cIssueDate  := StrTran(oAnalytical["issueDate"], "-", "")

                oTaxesData["competence"]  := oAnalytical["competence"]
                oTaxesData["issueDate"]   := FWTimeStamp(5, StoD(cIssueDate), "00:00:00")
                oTaxesData["titleNumber"] := oAnalytical["titleNumber"]
                oTaxesData["type"]        := oAnalytical["type"]
                oTaxesData["prefix"]      := oAnalytical["prefix"]
                oTaxesData["total"]       := oAnalytical["total"]
                oTaxesData["balance"]     := oAnalytical["balance"]
                oTaxesData["status"]      := oAnalytical["status"]

                ::appendData(oTaxesData)
            Next nAnalytical

        Next nSynthetic
    EndIf

    FwFreeObj(oSynthetic)
    FwFreeObj(oAnalytical)
    FwFreeObj(oTaxesData)
    FwFreeObj(oFilterParams)
    FwFreeObj(oFuncResponse)
    FwFreeArray(aTaxesItems)
Return ::oData

/*/{Protheus.doc} getSchema
    Retorna estrutura dos campos (schema) do Objeto de Negócio.
    Define parâmetros de filtro (branches, periodStart, periodEnd)
    e colunas de dados.
    Utiliza helper FISA318F2SVGetParametersByDashboard() para obter parâmetros padrão.

    @type   Method
    @author Caique Carlos
    @since 04/11/2025
    @version 1.0
    @return object, self:oSchema (definição de parâmetros e colunas)
/*/  
Method getSchema() as object Class TributesNatureBusinessObject
    Local aSVParams  as array

    aSVParams := FISA318F2SVGetParametersByDashboard()
    aEval(aSVParams, {|aParam| ::addParameter(aParam[1], aParam[2], aParam[3], aParam[4])})

    // Colunas do ON - Nível Sintético (totalizadores principais)
    ::addProperty("branch"       , STR0010, "string", STR0010, "branch"        ) //"Filial"
    ::addProperty("monthYear"    , STR0109, "string", STR0109, "monthYear"     ) //"Mês/Ano"
    ::addProperty("tax"          , STR0110, "string", STR0110, "tax"           ) //"Tributo"
    ::addProperty("nature"       , STR0127, "string", STR0127, "nature"        ) //"Natureza"
    ::addProperty("description"  , STR0128, "string", STR0128, "description"   ) //"Descrição"
    ::addProperty("withheldTotal", STR0112, "number", STR0112, "withheldTotal" ) //"Total Retido"
    ::addProperty("valuePaid"    , STR0113, "number", STR0113, "valuePaid"     ) //"Valor Pago"
    ::addProperty("valueToPay"   , STR0114, "number", STR0114, "valueToPay"    ) //"Valor a Pagar"

    // Colunas do ON - Nível Analítico (detalhe de documentos)
    ::addProperty("competence"   , STR0129, "string", STR0129, "competence"    ) //"Competência"
    ::addProperty("issueDate"    , STR0118, "date"  , STR0118, "issueDate"     ) //"Data Emissão"
    ::addProperty("titleNumber"  , STR0115, "string", STR0115, "titleNumber"   ) //"Número Documento"
    ::addProperty("type"         , STR0116, "string", STR0116, "type"          ) //"Tipo Documento"
    ::addProperty("prefix"       , STR0117, "string", STR0117, "prefix"        ) //"Prefixo"
    ::addProperty("total"        , STR0120, "number", STR0120, "total"         ) //"Valor Total"
    ::addProperty("balance"      , STR0121, "number", STR0121, "balance"       ) //"Saldo"
    ::addProperty("status"       , STR0130, "string", STR0130, "status"        ) //"Status"

    FwFreeArray(aSVParams)
Return ::oSchema
