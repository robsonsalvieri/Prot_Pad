#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "totvs.framework.treports.integratedprovider.th"
#include "FISA318.CH"

namespace totvs.framework.treports.integratedprovider

/*/{Protheus.doc} VisionMunicipalTaxesBusinessObject
    Objeto de Negócio SmartView para Visão Tributos Municipais.
    Abre em formato Visão de Dados os tributos municipais (ISS e outros) consolidados
    por filial, período e prefeitura, com drill-down para documentos fiscais.
    Processa dados da API /financial/municipal/tributes-by-municipality e expõe visão hierárquica:
    Filial > Prefeitura > Período > Tributo >  Documentos (SE2)
    
    @type  Class
    @author Caique Carlos
    @since 04/12/2025
    @version 1.0
    @see https://tdn.totvs.com/pages/releaseview.action?pageId=625448935
/*/
@totvsFrameworkTReportsIntegratedProvider(;
    active=.T.,;
    team="SIGAFIS",;
    name="VisionMunicipalTaxesBusinessObject",;
    country="BRA",;
    initialRelease="12.1.2310";
)
Class VisionMunicipalTaxesBusinessObject From totvs.framework.treports.integratedprovider.IntegratedProvider
    Public Method new()         as object
    Public Method getData()     as object
    Public Method getSchema()   as object
EndClass

/*/{Protheus.doc} new
    Construtor da classe - Define área, nome de exibição e descrição do Objeto de Negócio.
    Utiliza helper FISA318F4GetDisplayNameComplement() para sufixo com timestamp.
    
    @type   Method
    @author Caique Carlos
    @since  04/12/2025
    @version 1.0
    @return object, self (instância da classe)
*/  
Method new() as object Class VisionMunicipalTaxesBusinessObject
    _Super:new()

    ::appendArea(STR0006) //"Monitor Tributário"
    ::setDisplayName(STR0107 + FISA318F4GetDisplayNameComplement()) //"CARD_VISAO-TRIBUTOS-MUNICIPAIS_"
    ::setDescription(STR0108) //"Abertura dos dados do Card de Visao de Tributos Municipais - TOTVS Inteligência Tributária no formato Visão de Dados da Tecnologia SmartView"
Return self

/*/{Protheus.doc} getData
    Retorna dados do objeto de negócio consolidados de Tributos Municipais.
    Consome função GetVisionMunicipalTaxes() da API REST interna.
    Processa JSON de resposta expandindo hierarquia principal e detalhes.
    Cada linha representa um tributo municipal com totalizadores e array de documentos.
    
    @type   Method
    @author Caique Carlos
    @since 04/12/2025
    @version 1.0
    @param  nPage, numeric, Página atual do relatório (não utilizado - retorna dataset completo)
    @param  oFilter, object, Objeto FWFilter com parâmetros do SmartView (branches, periodStart, periodEnd)
    @return object, self:oData (array de hashmaps com dados consolidados)
/*/  
Method getData(nPage as numeric, oFilter as object) as object Class VisionMunicipalTaxesBusinessObject
    Local aMunicipalItems                      as array
    Local oSynthetic                           as object
    Local oAnalytical                          as object
    Local oFilterParams                        as object
    Local oFuncResponse  := JsonObject():New() as object
    Local oMunicipalData := JsonObject():new() as object
    Local nIAnalytical   := 0                  as numeric
    Local nISynthetic    := 0                  as numeric
    Local cIssueDate     := ""                 as character
    Local cDueDate       := ""                 as character

    oFilterParams := oFilter:getParameters()

    oFuncResponse:FromJson( GetVisionMunicipalTaxes(;
                            oFilterParams["branches"][1],;
                            oFilterParams["periodStart"][1],;
                            oFilterParams["periodEnd"][1],;
                            "1",;
                            "999999";
                        ))

    If !Empty(oFuncResponse["items"])    
        aMunicipalItems := oFuncResponse["items"]

        For nISynthetic := 1 To Len(aMunicipalItems)
            oSynthetic := aMunicipalItems[nISynthetic]

            oMunicipalData["branch"]        := oSynthetic["branch"]
            oMunicipalData["monthYear"]     := oSynthetic["monthYear"]
            oMunicipalData["tribute"]       := oSynthetic["tribute"]
            oMunicipalData["cityHall"]      := oSynthetic["cityHall"]
            oMunicipalData["totalRetained"] := oSynthetic["totalRetained"]
            oMunicipalData["amountPaid"]    := oSynthetic["amountPaid"]
            oMunicipalData["amountPayable"] := oSynthetic["amountPayable"]

            If oSynthetic["detail"] <> Nil
                For nIAnalytical := 1 To Len(oSynthetic["detail"])
                    oAnalytical := oSynthetic["detail"][nIAnalytical]
                    cIssueDate  := StrTran(oAnalytical["issueDate"], "-", "")
                    cDueDate    := StrTran(oAnalytical["dueDate"], "-", "")

                    oMunicipalData["documentNumber"] := oAnalytical["documentNumber"]
                    oMunicipalData["installment"]    := oAnalytical["installment"]
                    oMunicipalData["documentType"]   := oAnalytical["documentType"]
                    oMunicipalData["prefix"]         := oAnalytical["prefix"]
                    oMunicipalData["issueDate"]      := FWTimeStamp(5, StoD(cIssueDate), "00:00:00")
                    oMunicipalData["dueDate"]        := FWTimeStamp(5, StoD(cDueDate), "00:00:00")
                    oMunicipalData["totalValue"]     := oAnalytical["totalValue"]
                    oMunicipalData["balance"]        := oAnalytical["balance"]
                    oMunicipalData["participant"]    := oAnalytical["participant"]
                    oMunicipalData["store"]          := oAnalytical["store"]

                    ::appendData(oMunicipalData)
                Next nIAnalytical
            EndIf

        Next nISynthetic
    EndIf

    FwFreeObj(oSynthetic)
    FwFreeObj(oAnalytical)
    FwFreeObj(oMunicipalData)
    FwFreeObj(oFilterParams)
    FwFreeObj(oFuncResponse)
    FwFreeArray(aMunicipalItems)
Return ::oData

/*/{Protheus.doc} getSchema
    Retorna estrutura dos campos (schema) do Objeto de Negócio.
    Define parâmetros de filtro (branches, periodStart, periodEnd)
    e colunas de dados (filial, período, tributo, prefeitura, valores e detalhes de documentos).
    Utiliza helper FISA318F2SVGetParametersByDashboard() para obter parâmetros padrão.

    @type   Method
    @author Caique Carlos
    @since 04/11/2025
    @version 1.0
    @return object, self:oSchema (definição de parâmetros e colunas)
/*/  
Method getSchema() as object Class VisionMunicipalTaxesBusinessObject
    Local aSVParams  as array

    aSVParams := FISA318F2SVGetParametersByDashboard()
    aEval(aSVParams, {|aParam| ::addParameter(aParam[1], aParam[2], aParam[3], aParam[4])})

    // Colunas do ON - Nível Sintético (totalizadores principais)
    ::addProperty("branch"        , STR0010, "string", STR0010, "branch"        ) //"Filial"
    ::addProperty("monthYear"     , STR0109, "string", STR0109, "monthYear"     ) //"Mês/Ano"
    ::addProperty("tribute"       , STR0110, "string", STR0110, "tribute"       ) //"Tributo"
    ::addProperty("cityHall"      , STR0111, "string", STR0111, "cityHall"      ) //"Prefeitura"
    ::addProperty("totalRetained" , STR0112, "number", STR0112, "totalRetained" ) //"Total Retido"
    ::addProperty("amountPaid"    , STR0113, "number", STR0113, "amountPaid"    ) //"Valor Pago"
    ::addProperty("amountPayable" , STR0114, "number", STR0114, "amountPayable" ) //"Valor a Pagar"
    
    // Colunas do ON - Nível Analítico (detalhe de documentos)
    ::addProperty("documentNumber", STR0115, "string", STR0115, "documentNumber") //"Número Documento"
    ::addProperty("installment"   , STR0124, "string", STR0124, "installment"   ) //"Parcela"
    ::addProperty("documentType"  , STR0116, "string", STR0116, "documentType"  ) //"Tipo Documento"
    ::addProperty("prefix"        , STR0117, "string", STR0117, "prefix"        ) //"Prefixo"
    ::addProperty("issueDate"     , STR0118, "date",   STR0118, "issueDate"     ) //"Data Emissão"
    ::addProperty("dueDate"       , STR0119, "date",   STR0119, "dueDate"       ) //"Data Vencimento"
    ::addProperty("totalValue"    , STR0120, "number", STR0120, "totalValue"    ) //"Valor Total"
    ::addProperty("balance"       , STR0121, "number", STR0121, "balance"       ) //"Saldo"
    ::addProperty("participant"   , STR0022, "string", STR0022, "participant"   ) //"Participante"
    ::addProperty("store"         , STR0122, "string", STR0122, "store"         ) //"Loja"

    FwFreeArray(aSVParams)
Return ::oSchema
