#INCLUDE "tlpp-core.th"
#INCLUDE "totvs.ch"
#INCLUDE "TOPCONN.CH"
#INCLUDE "PROTHEUS.CH"
#INCLUDE "FISA319.CH"

#DEFINE CGROUP  'TOTVSInteligenciaTributaria'

/*---------------------------------------------------------------------
{Protheus.doc} FIS319FinancialExtrator()
(Responsável por gravar os dados da financeiros nas tabelas Fato do Montrib)
@author Pâmela Bernardo

@parâmetros de entrada
cDtStart = data inicial do período a ser filtrado
cDtEnd = data final do período a ser filtrado

@Return:
lRet - Indica se havia dados no período solicitado e se gravou todos os dados sem erros

@since 19/09/2025
//-------------------------------------------------------------------*/
Function FIS319FinancialExtrator(cDtStart as character,cDtEnd as character)
	Local lRet 			:= .T. 					as logical
	Local dDataRef  	:= CtoD( ('15/' + StrZero(Month(dDataBase),2) + '/' + StrZero(Year(dDataBase),4) ) ) - 365 as date
	Local oBulkCIW		:= Nil					as object
	Local cAliasCIW 	:= "" 					as character
	Local nQtdFlush 	:= 1000					as numeric
	Local aFieldBulk    := {} 					as array
	Local cErrorTab 	:= ""					as character
	Local cMsgErro  	:= ''					as character
	Local nQtdProc  	:= 0					as numeric
	Local nParcial  	:= 0					as numeric
	Local nPercent  	:= 60					as numeric		// considerando que 60% do processamento será no Bulk
	Local nEvolucao 	:= 100-nPercent			as numeric
		
	Default cDtStart:= StrZero(Year(dDataRef),4) + StrZero(Month(dDataRef),2) + '01'
	Default cDtEnd  := DtoS(dDataBase)

	cDtStart := StrTran(cDtStart, "-", "")
	cDtEnd   := StrTran(cDtEnd  , "-", "")

	FISA318F3SendInfoToExtractionProgressBar(STR0022, .T., 0) //"Iniciando Extração dos dados financeiros..."
	cAliasCIW:= FIS319FinancialQuery(cDtStart,cDtEnd,@nParcial)
	nParcial := Int(nParcial/(nPercent/10))
	If nParcial > 0
		lRet := TITDelQryRT(cDtStart,cDtEnd,"CIW", "_EMISSA")
	EndIf
	If lRet .And. !Empty(cAliasCIW)
		oBulkCIW := FwBulk():New(FIS319SqlName("CIW"),nQtdFlush)

		aFieldBulk := {	{'CIW_FILIAL'}, {'CIW_ESFERA'},  {'CIW_IDDOC'},  {'CIW_PREFIX'},;
						{'CIW_NUMERO'}, {'CIW_PARCEL'} , {'CIW_TIPO'},   {'CIW_PARTIC'},;
						{'CIW_LOJA'},   {'CIW_CODMUN'},  {'CIW_ESTADO'}, {'CIW_NATURE'},;
						{'CIW_EMISSA'}, {'CIW_VENCTO'},  {'CIW_VALOR'},  {'CIW_SALDO'},;
						{'CIW_NATREN'}, {'CIW_IDPAI'},   {'CIW_ORIGEM'}, {'CIW_FILORI'} }
		
		oBulkCIW:setFields( aFieldBulk )

		FISA318F3SendInfoToExtractionProgressBar(STR0006, .T., 50)//"Gravando registros..."

		While (cAliasCIW)->(!Eof())

			lRet := oBulkCIW:addData(	{	(cAliasCIW)->E2_FILIAL	,;
										(cAliasCIW)->ESFERA			,;
										(cAliasCIW)->IDDOC			,;
										(cAliasCIW)->E2_PREFIXO		,;
										(cAliasCIW)->E2_NUM		,;
										(cAliasCIW)->E2_PARCELA,;
										(cAliasCIW)->E2_TIPO		,;
										(cAliasCIW)->E2_FORNECE		,;
										(cAliasCIW)->E2_LOJA		,;
										(cAliasCIW)->A2_COD_MUN	,;
										(cAliasCIW)->A2_EST		,;
										(cAliasCIW)->E2_NATUREZ	,;
										(cAliasCIW)->E2_EMISSAO		,;
										(cAliasCIW)->E2_VENCTO		,;
										(cAliasCIW)->E2_VALOR		,;
										(cAliasCIW)->E2_SALDO		,;
										(cAliasCIW)->NATREN	,;
										(cAliasCIW)->IDPAI	,;
										(cAliasCIW)->E2_ORIGEM	,;
										(cAliasCIW)->E2_FILORIG	;
										}	)
				nQtdProc++
				If !lRet
					cErrorTab += "|CIW|" + (cAliasCIW)->E2_FILORIG + (cAliasCIW)->E2_PREFIXO + (cAliasCIW)->E2_NUM + (cAliasCIW)->E2_PARCELA + (cAliasCIW)->E2_TIPO + (cAliasCIW)->E2_FORNECE + (cAliasCIW)->E2_LOJA
				EndIf
				If lRet
					If nQtdProc >= nParcial
						If nEvolucao < 80
							nEvolucao += 10
						Else
							nEvolucao += 5
						EndIf
						FISA318F3SendInfoToExtractionProgressBar(STR0006, lRet, nEvolucao)//"Gravando registros..."
						nQtdProc := 0
					EndIf
				Else
					cMsgErro := "Erro FwBulk: " + oBulkCIW:getError() 
					FWLogMsg("ERROR",, CGROUP, FunName(), , , cMsgErro + cErrorTab)
					FISA318F3SendInfoToExtractionProgressBar(cMsgErro + cErrorTab, lRet, 0)
					Exit
				EndIf
			(cAliasCIW)->(DbSkip())
		EndDo

		lRet:= oBulkCIW:Close()
		If !lRet
			cMsgErro := "Erro FwBulk: " + oBulkCIW:getError() 	
			FWLogMsg("ERROR",, CGROUP, FunName(), , , cMsgErro + cErrorTab)
			FISA318F3SendInfoToExtractionProgressBar(cMsgErro + cErrorTab, lRet, 0)
		EndIf
		oBulkCIW:Destroy()
		FWFreeObj(oBulkCIW)
	EndIf

	FwFreeArray(aFieldBulk)
Return lRet

/*---------------------------------------------------------------------
{Protheus.doc} FIS319FinancialQuery()
(Responsável criar a tabela temporária para gravação dos dados financeiro)
@author Pâmela Bernardo

@parâmetros de entrada
cDtStart = data inicial do período a ser filtrado
cDtEnd = data final do período a ser filtrado
nParcial = Define a quantidade total de registros que serão gravados

@Return:
cAliasfin - Tabela temporária com dados para gravação

@since 19/09/2025
//-------------------------------------------------------------------*/
Static Function FIS319FinancialQuery(cDtStart as character,cDtEnd as character, nParcial as numeric)
	Local cAliasfin := "" as character
	Local cQuery	:= "" 	as character
	Local cQueryFix	:= "" 	as character
	Local cWhere	:= "" 	as character
	Local cCount	:= "" 	as character
	Local oQueryFin	:= Nil 	as object
	Local dDataRef  := CtoD( ('15/' + StrZero(Month(dDataBase),2) + '/' + StrZero(Year(dDataBase),4) ) ) - 365 as date
	Local cFornecedorFederal := GetMv("MV_UNIAO")+","+GetMv("MV_FORINSS")+","+ GetMv("MV_FORSEST") as character
	Local cFornecedorEstadual := GetMv("MV_RECEST") as character
	Local cNatureza := FIS319Naureza() as character
	Local nOrdem 	:= 1 as integer
	Local cTipo 	:= FIS319TipoTitulo() as character
	Local cOrigem 	:= 'FINA376,FINA378,FINA381,FINA382' as character
	Local nFrom     := 0 as numeric
	
	Default cDtStart:= StrZero(Year(dDataRef),4) + StrZero(Month(dDataRef),2) + '01'
	Default cDtEnd  := DtoS(dDataBase)

	cQuery := "SELECT SE2.E2_FILIAL, "
	cQuery += "CASE  "
	cQuery += "	WHEN SE2.E2_FORNECE IN (?) THEN '1'  "
	cQuery += "	WHEN SE2.E2_FORNECE IN (?)  THEN '2'  "
	cQuery += "	ELSE '3'  "
	cQuery += "END ESFERA,  "
	cQuery += "COALESCE(FK7.FK7_IDDOC, '') IDDOC,  "
	cQuery += "SE2.E2_FILORIG,  "
	cQuery += "SE2.E2_PREFIXO,  "
	cQuery += "SE2.E2_NUM,  "
	cQuery += "SE2.E2_PARCELA,  "
	cQuery += "SE2.E2_TIPO,  "
	cQuery += "SE2.E2_FORNECE,  "
	cQuery += "SE2.E2_LOJA,  "
	cQuery += "SA2.A2_COD_MUN,  "
	cQuery += "SA2.A2_EST,  "
	cQuery += "SE2.E2_NATUREZ,  "
	cQuery += "SE2.E2_EMISSAO,  "
	cQuery += "SE2.E2_VENCTO,  "
	cQuery += "CASE   "
	cQuery += " WHEN FKW.FKW_TPIMP IN ('PIS','COF', 'CSL', 'IRF')  "
	cQuery += " THEN FKW.FKW_VLIMP  "
	cQuery += " ELSE SE2.E2_VALOR  "
	cQuery += "END E2_VALOR,  "
	cQuery += "CASE   "
	cQuery += " WHEN FKW.FKW_TPIMP IN ('PIS','COF', 'CSL', 'IRF')  "
	cQuery += " THEN ROUND(SE2.E2_SALDO * (FKW.FKW_PERC/100),2)  "
	cQuery += " ELSE SE2.E2_SALDO  "
	cQuery += "END E2_SALDO,  "
	cQuery += "COALESCE(FKW.FKW_NATREN, ' ') NATREN,  "
	cQuery += "COALESCE(FK7.FK7_IDPAI, '') IDPAI,  "
	cQuery += "SE2.E2_ORIGEM   "
	cQuery += "FROM "+RetSqlName('SE2') +" SE2  "
	cQuery += "LEFT JOIN "+RetSqlName('FK7') +" FK7 ON FK7.FK7_FILTIT = SE2.E2_FILIAL "
	cQuery += "AND FK7.FK7_PREFIX = SE2.E2_PREFIXO  "
	cQuery += "AND FK7.FK7_NUM = SE2.E2_NUM  "
	cQuery += "AND FK7.FK7_PARCEL = SE2.E2_PARCELA  "
	cQuery += "AND FK7.FK7_TIPO = SE2.E2_TIPO  "
	cQuery += "AND FK7.FK7_CLIFOR = SE2.E2_FORNECE  "
	cQuery += "AND FK7.FK7_LOJA = SE2.E2_LOJA  "
	cQuery += "AND FK7.FK7_ALIAS = ?  "
	cQuery += "AND FK7.D_E_L_E_T_ = ? "
	cQuery += "LEFT JOIN "+RetSqlName('FKW') +" FKW ON FKW.FKW_FILIAL = FK7.FK7_FILTIT "
	cQuery += "AND FKW.FKW_IDDOC = FK7.FK7_IDPAI  "
	cQuery += "AND SE2.E2_NATUREZ = (CASE  "
	cQuery += "WHEN FKW.FKW_TPIMP = 'PIS'  "
	cQuery += "THEN ?  "
	cQuery += "WHEN FKW.FKW_TPIMP = 'COF'  "
	cQuery += "THEN ?  "
	cQuery += "WHEN FKW.FKW_TPIMP = 'CSL'  "
	cQuery += "THEN ?  "
	cQuery += "WHEN FKW.FKW_TPIMP = 'IRF'  "
	cQuery += "THEN ?  "
	cQuery += "END) "
	//cQuery += "AND FKW.FKW_IDDOC = FK7.FK7_IDPAI  "
	cQuery += "AND FKW.FKW_CGC = (CASE "
    cQuery += " WHEN FKW.FKW_CGC = ? THEN ? "
	cQuery += " ELSE SE2.E2_CNPJRET
	cQuery += "	END) "
	cQuery += "AND FKW.D_E_L_E_T_ = ?  "
	cQuery += "INNER JOIN "+RetSqlName('SA2') +" SA2 ON "+ FWJoinFilial("SA2", "SE2") 
	cQuery += " AND SA2.A2_COD = SE2.E2_FORNECE  "
	cQuery += "AND SA2.A2_LOJA = SE2.E2_LOJA  "
	cQuery += "AND SA2.D_E_L_E_T_ = ? "
	cQuery += "WHERE "
	cQuery += " SE2.E2_TIPO IN (?)   "
	cQuery += "AND SE2.E2_NATUREZ IN (?) "
	cQuery += "AND SE2.E2_ORIGEM NOT IN (?)  "
	cQuery += "AND SE2.E2_EMISSAO BETWEEN ? AND ?  "
	cQuery += "AND SE2.D_E_L_E_T_ = ? "

	oQueryFin := FWExecStatement():New()
	oQueryFin:SetQuery(ChangeQuery(cQuery))

	FISA318F3SendInfoToExtractionProgressBar(STR0023, .T., 5) //"Selecionando registros Financeiros..."
	

	oQueryFin:SetIn(nOrdem++, StrTokArr(cFornecedorFederal, ','))
	oQueryFin:SetIn(nOrdem++, StrTokArr(cFornecedorEstadual, ','))
	oQueryFin:SetString(nOrdem++, 'SE2')
	oQueryFin:SetString(nOrdem++, " ")
	oQueryFin:SetString(nOrdem++, AllTrim(GetMv("MV_PISNAT")))
	oQueryFin:SetString(nOrdem++, AllTrim(GetMv("MV_COFINS")))
	oQueryFin:SetString(nOrdem++, AllTrim(GetMv("MV_CSLL")))
	oQueryFin:SetString(nOrdem++, AllTrim(&(GetMv("MV_IRF"))))
	oQueryFin:SetString(nOrdem++, " ")
	oQueryFin:SetString(nOrdem++, " ")
	oQueryFin:SetString(nOrdem++, " ")
	oQueryFin:SetString(nOrdem++, " ")
	oQueryFin:SetIn(nOrdem++, StrTokArr(cTipo, ','))
	oQueryFin:SetIn(nOrdem++, StrTokArr(cNatureza, ','))
	oQueryFin:SetIn(nOrdem++, StrTokArr(cOrigem, ','))
	oQueryFin:SetString(nOrdem++, cDtStart)
	oQueryFin:SetString(nOrdem++, cDtEnd)
	oQueryFin:SetString(nOrdem++, " ")

	cAliasfin := oQueryFin:OpenAlias()
	cQueryFix := oQueryFin:GetFixQuery()
	FISA318F3SendInfoToExtractionProgressBar(STR0023, .T., 20)


	nFrom := AT("FROM",cQueryFix,1) + 5
	cWhere := SubSTR(cQueryFix, nFrom)
	cCount := " SELECT COUNT(SE2.R_E_C_N_O_) TOTALREG FROM "

	nParcial := MpSysExecScalar(cCount+cWhere,"TOTALREG")

Return cAliasfin

/*---------------------------------------------------------------------
{Protheus.doc} FIS319Naureza()
(função que retorna as naturezas de impostos)
@author Pâmela Bernardo

@Return:
cNatureza - Todas as naturezas de impostos concatenadas

@since 19/09/2025
//-------------------------------------------------------------------*/
Static Function FIS319Naureza()
	Local cNatureza := "" as Character
	cNatureza := &(GetMv("MV_IRF"))+",";
				+ GetMv("MV_PISNAT")+","+GetMv("MV_COFINS")+","+GetMv("MV_CSLL")+",";
				+","+ &(GetMv("MV_INSS"))+","+ GetMv("MV_SEST")+","+ GetMv("MV_CIDE");
				+","+ GetMv("MV_CSS")+","+ &(GetMv("MV_INSP"))+","+ GetMv("MV_FMPNAT");
				+","+ &(GetMv("MV_ISS"))+","+ GetMv("MV_FETNAT")+","+ GetMv("MV_IMANAT");
				+","+ GetMv("MV_FABNAT")+","+ GetMv("MV_FACNAT");
				+","+ GetMv("MV_FAMNAT")+","+ GetMv("MV_APTPDP")

Return cNatureza

/*---------------------------------------------------------------------
{Protheus.doc} FIS319TipoTitulo()
(função que retorna os tipos de títulos de impostos)
@author Pâmela Bernardo

@Return:
cTipo - Todos os tipos de títulos de impostos concatenadas

@since 19/09/2025
//-------------------------------------------------------------------*/
Static Function FIS319TipoTitulo()
	Local cTipo := "" as Character
	
	cTipo := MVTAXA+","+MVISS+","+ MVTXA+","+ MVIRF+","+ MVINSS+","+ MVCOFINS+","+ MVPIS+","+MVCS

Return cTipo
/*---------------------------------------------------------------------
{Protheus.doc} FIS319FinancialReprocess()
(Responsável por atualizar o campo CIW_SALDO)
@author Pâmela Bernardo

@Return:
lRet - Indica se havia dados no período solicitado e se gravou todos os dados sem erros

@since 08/10/2025
//-------------------------------------------------------------------*/
Function FIS319FinancialReprocess()
	Local cQuery	:= "" as character
	Local cError	:= "" as character
	Local oQueryFin	:= Nil 	as object
	Local lRet 		:= .T. as logical
	Local nOrdem := 1 as integer

	cQuery := "UPDATE CIW SET CIW.CIW_SALDO = ( "
	cQuery += "CASE   "
	cQuery += " WHEN FKW.FKW_TPIMP IN ('PIS','COF', 'CSL', 'IRF')  "
	cQuery += " THEN ROUND(SE2.E2_SALDO * (FKW.FKW_PERC/100),2)  "
	cQuery += " ELSE SE2.E2_SALDO  "
	cQuery += "END) "
	cQuery += " FROM "+FIS319SqlName("CIW") +" CIW "
	cQuery += " JOIN "+RetSqlName('SE2') +" SE2 ON "
	cQuery += " SE2.E2_FILIAL = CIW.CIW_FILIAL "
	cQuery += " AND SE2.E2_PREFIXO = CIW.CIW_PREFIX "
	cQuery += " AND SE2.E2_NUM = CIW.CIW_NUMERO "
	cQuery += " AND SE2.E2_PARCELA = CIW.CIW_PARCEL "
	cQuery += " AND SE2.E2_TIPO = CIW.CIW_TIPO "
	cQuery += " AND SE2.E2_FORNECE = CIW.CIW_PARTIC "
	cQuery += " AND SE2.E2_LOJA = CIW.CIW_LOJA "
	cQuery += " AND SE2.D_E_L_E_T_ = ? "
	cQuery += "LEFT JOIN "+RetSqlName('FKW') +" FKW ON FKW.FKW_FILIAL = CIW.CIW_FILIAL "
	cQuery += "AND FKW.FKW_IDDOC = CIW.CIW_IDPAI  "
	cQuery += "AND FKW.FKW_NATREN = CIW.CIW_NATREN "
	cQuery += "AND SE2.E2_NATUREZ = (CASE  "
	cQuery += "WHEN FKW.FKW_TPIMP = 'PIS'  "
	cQuery += "THEN ?  "
	cQuery += "WHEN FKW.FKW_TPIMP = 'COF'  "
	cQuery += "THEN ?  "
	cQuery += "WHEN FKW.FKW_TPIMP = 'CSL'  "
	cQuery += "THEN ?  "
	cQuery += "WHEN FKW.FKW_TPIMP = 'IRF'  "
	cQuery += "THEN ?  "
	cQuery += "END) "
	cQuery += "AND FKW.D_E_L_E_T_ = ?  "
	cQuery += " WHERE CIW.CIW_SALDO > ?  "
	cQuery += " AND CIW.D_E_L_E_T_ = ? "
	
	oQueryFin := FwExecStatement():New(cQuery) 
	

	oQueryFin:SetString(nOrdem++, " ")
	oQueryFin:SetString(nOrdem++, AllTrim(GetMv("MV_PISNAT")))
	oQueryFin:SetString(nOrdem++, AllTrim(GetMv("MV_COFINS")))
	oQueryFin:SetString(nOrdem++, AllTrim(GetMv("MV_CSLL")))
	oQueryFin:SetString(nOrdem++, AllTrim(&(GetMv("MV_IRF"))))
	oQueryFin:SetString(nOrdem++, " ")
	oQueryFin:SetNumeric(nOrdem++, 0)
	oQueryFin:SetString(nOrdem++, " ")

	cQuery := oQueryFin:GetFixQuery()
	If !TAFExecQuery(cQuery, .T., @cError)
		FWLogMsg("ERROR",, CGROUP, FunName(), , ,cError)
		lRet := .F.
	EndIf


Return lRet
