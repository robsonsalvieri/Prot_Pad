    self:addProperty("FA_VALICCO",      "Valor Parcela ICMS Complementar",              "number",   "Val. Parc. ICMS Comp.","FA_VALICCO",   /*cComboValues*/ ,  /*lIsRequired*/,    /*cRenameField*/ )
