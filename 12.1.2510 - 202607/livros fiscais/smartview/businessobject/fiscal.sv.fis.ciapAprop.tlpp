//-------------------------------------------------------------------
/*/{Protheus.doc} temFreteJoin
Monta fragmento LEFT JOIN para identificar nota complementar de frete.
Substitui o EXISTS que causava injeção indevida de ITEM_ORDER pelo framework SmartView.
@param aFiliais, array, contém as filiais para filtro
@return character, fragmento SQL de LEFT JOIN para frete
@type method
@author Flavio Mateus
@since 11/05/2026
*/
//-------------------------------------------------------------------
method temFreteJoin(aFiliais as array) as character class ciapApropSmartviewBusinessObject
    Local cJoin as character
    cJoin := " LEFT JOIN ( "
    cJoin += "     SELECT SF8F.F8_FILIAL, SF8F.F8_NFORIG, SF8F.F8_SERORIG, SF8F.F8_FORNECE, SF8F.F8_LOJA, SD1F.D1_VALICM AS VALICM_FRETE "
    cJoin += "     FROM " + RetSqlName("SF8") + " SF8F "
    cJoin += "     INNER JOIN " + RetSqlName("SD1") + " SD1F "
    cJoin += "         ON SD1F.D1_FILIAL = SF8F.F8_FILIAL "
    cJoin += "        AND SD1F.D1_DOC = SF8F.F8_NFDIFRE AND SD1F.D1_SERIE = SF8F.F8_SEDIFRE "
    cJoin += "        AND SD1F.D1_FORNECE = SF8F.F8_FORNECE AND SD1F.D1_LOJA = SF8F.F8_LOJA "
    cJoin += "        AND SD1F.D1_TIPO = 'C' AND SD1F.D_E_L_E_T_ = ' ' "
    cJoin += "     WHERE SF8F.D_E_L_E_T_ = ' ' "
    // Mantido conforme solicitação de não mexer no filtro de filial interno, mas preparado para ser estático no SQL do Smartview
    cJoin += " ) FRETE_NF ON FRETE_NF.F8_FILIAL = SF9.F9_FILIAL "
    cJoin += "     AND FRETE_NF.F8_NFORIG = SF9.F9_DOCNFE AND FRETE_NF.F8_SERORIG = SF9.F9_SERNFE "
    cJoin += "     AND FRETE_NF.F8_FORNECE = SF9.F9_FORNECE AND FRETE_NF.F8_LOJA = SF9.F9_LOJAFOR "
    cJoin += "     AND FRETE_NF.VALICM_FRETE = SF9.F9_VALFRET AND SF9.F9_VALFRET > 0 "

return cJoin

//-------------------------------------------------------------------
/*/{Protheus.doc} sumD1NJoin
Monta fragmento LEFT JOIN com soma de D1_VALICM para notas do tipo N (nota fiscal).
@param aFiliais, array, contém as filiais para filtro
@return character, fragmento SQL de LEFT JOIN para soma SD1 tipo N
@type method
@author Flavio Mateus
@since 11/05/2026
*/
//-------------------------------------------------------------------
method sumD1NJoin(aFiliais as array) as character class ciapApropSmartviewBusinessObject
    Local cJoin    as character
    Local cFiltFil as character

    // Montar IN com os mesmos valores de filial
    cFiltFil := ""
    If Len(aFiliais) > 0
        cFiltFil := " AND D1_FILIAL IN ('" + cValToChar(aFiliais[1]) + "') " // Usar bind via FWPreparedStatement
    EndIf

    cJoin := " LEFT JOIN ( "
    cJoin += "     SELECT SD1.D1_FILIAL, SD1.D1_DOC, SD1.D1_SERIE, SD1.D1_FORNECE, SD1.D1_LOJA, SD1.D1_ITEM, SUM(SD1.D1_VALICM) AS SOMA_N "
    cJoin += "     FROM " + RetSqlName("SD1") + " SD1 "
    cJoin += "     INNER JOIN " + RetSqlName("SF9") + " SF9F ON "
    cJoin += "         SD1.D1_FILIAL = SF9F.F9_FILIAL AND "
    cJoin += "         SD1.D1_DOC = SF9F.F9_DOCNFE AND "
    cJoin += "         SD1.D1_SERIE = SF9F.F9_SERNFE AND "
    cJoin += "         SD1.D1_FORNECE = SF9F.F9_FORNECE AND "
    cJoin += "         SD1.D1_LOJA = SF9F.F9_LOJAFOR AND "
    cJoin += "         SD1.D1_ITEM = SF9F.F9_ITEMNFE AND "
    cJoin += "         SF9F.D_E_L_E_T_ = ' ' "
    cJoin += "     WHERE SD1.D1_TIPO = 'N' AND SD1.D_E_L_E_T_ = ' ' "

    cJoin += "     GROUP BY SD1.D1_FILIAL, SD1.D1_DOC, SD1.D1_SERIE, SD1.D1_FORNECE, SD1.D1_LOJA, SD1.D1_ITEM "
    cJoin += " ) SUM_D1N ON SUM_D1N.D1_FILIAL = SF9.F9_FILIAL "
    cJoin += "     AND SUM_D1N.D1_DOC = SF9.F9_DOCNFE AND SUM_D1N.D1_SERIE = SF9.F9_SERNFE "
    cJoin += "     AND SUM_D1N.D1_FORNECE = SF9.F9_FORNECE AND SUM_D1N.D1_LOJA = SF9.F9_LOJAFOR "
    cJoin += "     AND SUM_D1N.D1_ITEM = SF9.F9_ITEMNFE "

return cJoin

//-------------------------------------------------------------------
/*/{Protheus.doc} sumD1IJoin
Monta fragmento LEFT JOIN com soma de D1_VALICM para notas do tipo I (importação/complemento).
@param aFiliais, array, contém as filiais para filtro
@return character, fragmento SQL de LEFT JOIN para soma SD1 tipo I
@type method
@author Flavio Mateus
@since 11/05/2026
*/
//-------------------------------------------------------------------
method sumD1IJoin(aFiliais as array) as character class ciapApropSmartviewBusinessObject
    Local cJoin    as character
    Local cFiltFil as character

    // Montar IN com os mesmos valores de filial
    cFiltFil := ""
    If Len(aFiliais) > 0
        cFiltFil := " AND D1_FILIAL IN ('" + cValToChar(aFiliais[1]) + "') " // Usar bind via FWPreparedStatement
    EndIf

    cJoin := " LEFT JOIN ( "
    cJoin += "     SELECT SD1.D1_FILIAL, SD1.D1_NFORI, SD1.D1_SERIORI, SD1.D1_FORNECE, SD1.D1_LOJA, SUM(SD1.D1_VALICM) AS SOMA_I "
    cJoin += "     FROM "  + RetSqlName("SD1") + " SD1 "
    cJoin += "     INNER JOIN " + RetSqlName("SF9") + " SF9F ON "
    cJoin += "         SD1.D1_FILIAL = SF9F.F9_FILIAL AND "
    cJoin += "         SD1.D1_NFORI = SF9F.F9_DOCNFE AND "
    cJoin += "         SD1.D1_SERIORI = SF9F.F9_SERNFE AND "
    cJoin += "         SD1.D1_FORNECE = SF9F.F9_FORNECE AND "
    cJoin += "         SD1.D1_LOJA = SF9F.F9_LOJAFOR AND "
    cJoin += "         SF9F.D_E_L_E_T_ = ' ' "
    cJoin += "     WHERE SD1.D1_TIPO = 'I' AND SD1.D_E_L_E_T_ = ' ' " + cFiltFil
    cJoin += "     GROUP BY SD1.D1_FILIAL, SD1.D1_NFORI, SD1.D1_SERIORI, SD1.D1_FORNECE, SD1.D1_LOJA "
    cJoin += " ) SUM_D1I ON SUM_D1I.D1_FILIAL = SF9.F9_FILIAL "
    cJoin += "     AND SUM_D1I.D1_NFORI = SF9.F9_DOCNFE AND SUM_D1I.D1_SERIORI = SF9.F9_SERNFE "
    cJoin += "     AND SUM_D1I.D1_FORNECE = SF9.F9_FORNECE AND SUM_D1I.D1_LOJA = SF9.F9_LOJAFOR "

return cJoin

//-------------------------------------------------------------------
/*/{Protheus.doc} ajustaValICMS
Monta expressão CASE para valor ajustado de ICMS usando aliases dos JOINs (FRETE_NF, SUM_D1N, SUM_D1I).
@return character, expressão SQL CASE para F9_VALICMS ajustado
@type method
@author Flavio Mateus
@since 11/05/2026
*/
//-------------------------------------------------------------------
method ajustaValICMS() as character class ciapApropSmartviewBusinessObject
    Local cExprSoma as character
    Local cExpr     as character

    // Soma dos valores de ICMS de SD1 (tipo N + tipo I) via JOINs
    cExprSoma := "( COALESCE(SUM_D1N.SOMA_N, 0) + COALESCE(SUM_D1I.SOMA_I, 0) ) "

    // FRETE_NF.F8_NFORIG IS NOT NULL = encontrou nota complementar de frete com VALICM = F9_VALFRET
    cExpr := "( CASE "
    cExpr += "     WHEN FRETE_NF.F8_NFORIG IS NOT NULL THEN SF9.F9_VALICMS "
    cExpr += "     WHEN " + cExprSoma + " > 0 "
    cExpr += "      AND " + cExprSoma + " <= SF9.F9_VALICMS THEN " + cExprSoma + " "
    cExpr += "     ELSE SF9.F9_VALICMS "
    cExpr += " END ) "

return cExpr

//-------------------------------------------------------------------
/*/{Protheus.doc} calcValorParcelaCIAP
Monta expressão CASE para cálculo do valor da parcela CIAP.
@return character, expressão SQL CASE para FA_VALOR calculado
@type method
@author Flavio Mateus
@since 11/05/2026
*/
//-------------------------------------------------------------------
method calcValorParcelaCIAP() as character class ciapApropSmartviewBusinessObject
    Local cExprValICMS as character
    Local cExpr        as character

    cExprValICMS := self:ajustaValICMS()

    cExpr := "( CASE "
    cExpr += "     WHEN SF9.F9_QTDPARC > 0 AND " + cExprValICMS + " > 0 "
    cExpr += "     THEN (" + cExprValICMS + " / SF9.F9_QTDPARC) "
    cExpr += "     ELSE SFA.FA_VALOR "
    cExpr += " END ) "

return cExpr

//-------------------------------------------------------------------
/*/{Protheus.doc} buildBindAndExecute
Monta expressão CASE para cálculo do valor da parcela CIAP.
@param cQuery, character, query SQL com placeholders '?' para bind de parâmetros
@param aBind, array, valores para bind dos parâmetros na query
@return character, expressão SQL CASE para FA_VALOR calculado
@type private method
@author Flavio Mateus
@since 11/05/2026
*/
//-------------------------------------------------------------------
Method buildBindAndExecute(cQuery As Character, aBind As Array) As Character Class ciapApropSmartviewBusinessObject
    Local nlA       := 0   As Numeric
    Local oPrepare  := nil As object

    oPrepare := FWPreparedStatement():New( ChangeQuery(cQuery) )
    For nlA := 1 To Len(aBind)
        If Valtype(aBind[nlA]) == 'A'
            oPrepare:setIn( nlA, aBind[nlA] )
        Elseif Valtype(aBind[nlA]) == 'D'
            oPrepare:setDate( nlA, aBind[nlA] )
        Else
            oPrepare:setString( nlA, aBind[nlA] )
        Endif
    Next nlA

    cQuery := oPrepare:getFixQuery()
    self:setQuery(cQuery)
    oPrepare:Destroy()

Return cQuery

