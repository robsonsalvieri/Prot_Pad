#include 'tlpp-core.th'
#include 'backoffice.fiscal.configurador.profiles.lib.controller.ch'

#define HTTP_CODE_OK 200 // (OK): Requisição bem-sucedida.
#define HTTP_CODE_NOT_FOUND 404 // (Not Found): Recurso não encontrado.
#define HTTP_CODE_INTERNAL_SERVER_ERROR 500 // (Internal Server Error): Erro interno do servidor.

#define BASE_URL '/api/fiscal/tax-configurator/v1/profiles/lib'

namespace totvs.protheus.backoffice.fiscal.configurador.profiles.lib.controller
using namespace totvs.protheus.backoffice.fiscal.configurador.profiles.lib.service
using namespace totvs.protheus.backoffice.fiscal.lib
using namespace totvs.protheus.backoffice.fiscal.configurador.profiles.profileoptimizer

/*/{Protheus.doc} ProfilesLibController
Controller para gerenciamento dos endpoints de funcionalidades genéricas dos perfis.
@type class
@version 12.1.2510
@author Juliano Fernandes
@since 20/11/2025
/*/
class ProfilesLibController

    private data oExceptions as object
    private data oService as object
    private data oProfileOptimizer as object
    private data jPathParamsRequest as json
    private data jQueryParamsRequest as json
    private data nStatusCode as numeric
    private data jResponse as json

    public method new() constructor

    @get(;
        endpoint = BASE_URL + '/lookup-data/:code',;
        description = 'Realiza a busca de dados de consultas padrão')
    public method getLookupData()

    @get(;
        endpoint = BASE_URL + '/params-sx6/:code',;
        description = 'Realiza a busca de dados de parâmetros SX6')
    public method getParamSX6()

    private method setErrorResponse(cMessage as character, oError as object)     
    private method destroy()

endclass

/*/{Protheus.doc} ProfilesLibController::new
Construtor da classe ProfilesLibController.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 16/10/2025
@return object, Instância da classe ProfilesLibController
/*/
method new() class ProfilesLibController

    oRest:updateKeyHeaderResponse('Content-Type','application/json; charset=utf-8')

    self:oExceptions := FisExceptions():new()
    self:oService := ProfilesLibService():new(self:oExceptions)
    self:oProfileOptimizer := ProfileOptimizer():new()
    self:jPathParamsRequest := JsonObject():new()
    self:jQueryParamsRequest := JsonObject():new()
    self:jResponse := JsonObject():new()
    self:nStatusCode := HTTP_CODE_INTERNAL_SERVER_ERROR

return self

/*/{Protheus.doc} ProfilesLibController::getLookupData
Método para obtenção de dados de consultas padrão.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 20/11/2025
/*/
method getLookupData() class ProfilesLibController

    try
        self:jPathParamsRequest:fromJson(oRest:getPathParamsRequest():toJson())
        self:jQueryParamsRequest:fromJson(oRest:getQueryRequest():toJson())

        self:oProfileOptimizer:changeBranch(self:jQueryParamsRequest['branchCode'])

        self:jResponse := self:oService:getLookupData(self:jPathParamsRequest['code'],self:jQueryParamsRequest)

        self:nStatusCode := HTTP_CODE_OK
    catch oError
        self:setErrorResponse(STR0001,oError) // 'Erro ao buscar dados da consulta padrão'
    finally
        oRest:setStatusCode(self:nStatusCode)
        oRest:setResponse(self:jResponse:toJson())

        self:oProfileOptimizer:restoreBranch()

        self:destroy()
    endtry

return

/*/{Protheus.doc} ProfilesLibController::getParamSX6
Método para obtenção de dados de parametros SX6.
@type method
@version 12.1.2510
@author Matheus Bispo
@since 09/12/2025
/*/
method getParamSX6() class ProfilesLibController

    self:jPathParamsRequest:fromJson(oRest:getPathParamsRequest():toJson())
    self:jQueryParamsRequest:fromJson(oRest:getQueryRequest():toJson())

    self:oProfileOptimizer:changeBranch(self:jQueryParamsRequest['branchCode'])

    self:jResponse := self:oService:getParamSX6(self:jPathParamsRequest['code'])

    self:nStatusCode := HTTP_CODE_OK
    oRest:setStatusCode(self:nStatusCode)
    oRest:setResponse(self:jResponse:toJson())

    self:oProfileOptimizer:restoreBranch()

    self:destroy()

return

/*/{Protheus.doc} ProfilesLibController::setErrorResponse
Método para definir a resposta de erro.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 20/11/2025
@param cMessage, character, Mensagem de erro
@param oError, object, Objeto de erro capturado na exceção
/*/
method setErrorResponse(cMessage as character, oError as object) class ProfilesLibController

    if ( oError:genCode == HTTP_CODE_NOT_FOUND )
        self:nStatusCode := oError:genCode
    endif

    self:jResponse['success'] := .F.
    self:jResponse['message'] := fwHttpEncode(cMessage)

    if ( !empty(oError:description) )
        self:jResponse['detailedMessage'] := fwHttpEncode(oError:description)
    endif

return

/*/{Protheus.doc} ProfilesLibController::destroy
Método destrutor da classe ProfilesLibController.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 20/11/2025
/*/
method destroy() class ProfilesLibController

    self:oExceptions:destroy()
    fwFreeObj(self:oExceptions)

    self:oService:destroy()
    fwFreeObj(self:oService)

    self:oProfileOptimizer:destroy()
    fwFreeObj(self:oProfileOptimizer)

    fwFreeObj(self:jPathParamsRequest)
    self:jPathParamsRequest := nil

    fwFreeObj(self:jQueryParamsRequest)
    self:jQueryParamsRequest := nil

    fwFreeObj(self:jResponse)
    self:jResponse := nil

return
