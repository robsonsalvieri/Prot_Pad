#include 'tlpp-core.th'

namespace totvs.protheus.backoffice.fiscal.configurador.profiles.lib.repository

/*/{Protheus.doc} ProfilesLibRepository
Repository para gerenciamento das funcionalidades genéricas dos perfis.
@type class
@version 12.1.2510
@author Juliano Fernandes
@since 20/11/2025
/*/
class ProfilesLibRepository

    private data cTable as character
    private data cPrefix as character
    private data aFields as array
    private data cOrder as character

    public method new() constructor

    public method findLookup(cCode as character) as logical

    public method getLookupData(cCode as character, cFilter as character, cKeys as character, cKeyField as character, cSearchType as character, nPage as numeric, nPageSize as numeric, lHasNext as logical) as array

    private method setFilters(cFilter as character, cQuery as character, aBind as array)
    private method getTableField(cJsonField as character) as character
    public method destroy()

endclass

/*/{Protheus.doc} ProfilesLibRepository::new
Método construtor da classe ProfilesLibRepository.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 20/11/2025
@return object, Instância da classe ProfilesLibRepository
/*/
method new() class ProfilesLibRepository

    self:cTable := ''
    self:cPrefix := ''
    self:aFields := {}
    self:cOrder := ''

return self

/*/{Protheus.doc} ProfilesLibRepository::findLookup
Método que verifica se a consulta padrão existe.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 25/11/2025
@param cCode, character, Código da consulta padrão
@return logical, Indica se os dados predefinidos para a consulta padrão foram localizados
/*/
method findLookup(cCode as character) as logical class ProfilesLibRepository

    self:cTable := ''
    self:cPrefix := ''
    self:aFields := {}
    self:cOrder := ''

    do case
        case ( cCode $ '12/A2/02/60/21/S0')
            self:cTable := 'SX5'
            self:cPrefix := 'X5_'
            self:aFields := {{'chave','X5_CHAVE'},{'descri','X5_DESCRI'}}
            self:cOrder := 'X5_CHAVE'

        case ( cCode == 'SYA' )
            self:cTable := 'SYA'
            self:cPrefix := 'YA_'
            self:aFields := {{'descr','YA_DESCR'},{'codgi','YA_CODGI'}}
            self:cOrder := 'YA_DESCR'

        case ( cCode == 'CC2SA1' .or. cCode == 'CC2SA2' )
            self:cTable := 'CC2'
            self:cPrefix := 'CC2_'
            self:aFields := {{'est','CC2_EST'},{'codmun','CC2_CODMUN'},{'mun','CC2_MUN'}}
            self:cOrder := 'CC2_EST'

        case ( cCode == 'SE4' )
            self:cTable := 'SE4'
            self:cPrefix := 'E4_'
            self:aFields := {{'tipo','E4_TIPO'},{'descri','E4_DESCRI'},{'codigo','E4_CODIGO'}}
            self:cOrder := 'E4_TIPO'

        case ( cCode == 'SA4' )
            self:cTable := 'SA4'
            self:cPrefix := 'A4_'
            self:aFields := {{'cod','A4_COD'},{'nome','A4_NOME'},{'cgc','A4_CGC'}}
            self:cOrder := 'A4_COD'

        case ( cCode == 'SA3' )
            self:cTable := 'SA3'
            self:cPrefix := 'A3_'
            self:aFields := {{'cod','A3_COD'},{'nome','A3_NOME'},{'cgc','A3_CGC'}}
            self:cOrder := 'A3_COD'

        case ( cCode == 'ACY' )
            self:cTable := 'ACY'
            self:cPrefix := 'ACY_'
            self:aFields := {{'grpven','ACY_GRPVEN'},{'descri','ACY_DESCRI'}}
            self:cOrder := 'ACY_GRPVEN'

        case ( cCode == 'F0G' )
            self:cTable := 'F0G'
            self:cPrefix := 'F0G_'
            self:aFields := {{'cest','F0G_CEST'},{'descr2','F0G_DESCR2'}}
            self:cOrder := 'F0G_CEST'

        case ( cCode == 'WD2' )
            self:cTable := 'SYD'
            self:cPrefix := 'YD_'
            self:aFields := {{'desc_p','YD_DESC_P'},{'tec','YD_TEC'},{'ex_ncm','YD_EX_NCM'},{'ex_nbm','YD_EX_NBM'}}
            self:cOrder := 'YD_TEC'

        case ( cCode == 'F08' )
            self:cTable := 'F08'
            self:cPrefix := 'F08_'
            self:aFields := {{'codigo','F08_CODIGO'},{'grpcst','F08_GRPCST'}}
            self:cOrder := 'F08_CODIGO'

        case ( cCode == 'SBM' )
            self:cTable := 'SBM'
            self:cPrefix := 'BM_'
            self:aFields := {{'grupo','BM_GRUPO'},{'desc','BM_DESC'},{'codmar','BM_CODMAR'}}
            self:cOrder := 'BM_GRUPO'
        
        case ( cCode == 'NNR' )
            self:cTable := 'NNR'
            self:cPrefix := 'NNR_'
            self:aFields := {{'codigo','NNR_CODIGO'},{'descri','NNR_DESCRI'}}
            self:cOrder := 'NNR_CODIGO'

        case ( cCode == 'SYD4' )
            self:cTable := 'SYD'
            self:cPrefix := 'YD_'
            self:aFields := {{'tec','YD_TEC'},{'desc_p','YD_DESC_P'}}
            self:cOrder := 'YD_TEC'

        case ( cCode == 'SF4' )
            self:cTable := 'SF4'
            self:cPrefix := 'F4_'
            self:aFields := {{'codigo','F4_CODIGO'},{'tipo','F4_TIPO'},{'cf','F4_CF'},{'duplic','F4_DUPLIC'},{'estoque','F4_ESTOQUE'},{'texto','F4_TEXTO'}}
            self:cOrder := 'F4_CODIGO'

        case ( cCode == 'EL0' )
            self:cTable := 'EL0'
            self:cPrefix := 'EL0_'
            self:aFields := {{'cod','EL0_COD'},{'desc','EL0_DESC'}}
            self:cOrder := 'EL0_COD'

    endcase

return ( !empty(self:cTable) .and. !empty(self:cPrefix) .and. len(self:aFields) > 0 .and. !empty(self:cOrder) )

/*/{Protheus.doc} ProfilesLibRepository::getLookupData
Método para busca de dados de consultas padrão.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 20/11/2025
@param cCode, character, Código da consulta padrão
@param cFilter, character, Filtro para busca dos dados
@param cKeys, character, Valores para busca dos dados
@param cKeyField, character, Nome do campo chave para busca dos dados
@param cSearchType, character, Tipo de busca (KEY ou ALL)
@param nPage, numeric, Número da página para paginação dos resultados
@param nPageSize, numeric, Tamanho da página para paginação dos resultados
@param lHasNext, logical, Indica se há mais registros
@return array, Array com os dados da consulta padrão
/*/
method getLookupData(cCode as character, cFilter as character, cKeys as character, cKeyField as character, cSearchType as character, nPage as numeric, nPageSize as numeric, lHasNext as logical) as array class ProfilesLibRepository

    local oStatement as object
    local cFields as character
    local nPosJsonField := 1 as numeric
    local nPosQueryField := 2 as numeric
    local aBind := {} as array
    local nI as numeric
    local cAlias as character
    local cQuery as character
    local nCount as numeric
    local nInitial as numeric
    local nFinal as numeric    
    local aItems := {} as array
    local jItem as json
    local aKeys as array
    local aKey as array

    aeval(self:aFields, {|aField| cFields += aField[nPosQueryField] + ','})
    cFields := substr(cFields,1,len(cFields) - 1)    

    nInitial := ( ( nPage - 1 ) * nPageSize ) + 1
    nFinal := ( nPage * nPageSize ) + 1            

    cQuery := ' SELECT ? '
    aadd(aBind, {'U',cFields})

    cQuery += ' FROM ( '
    cQuery += '     SELECT ROW_NUMBER() OVER(ORDER BY ?) LINE_NUMBER, ? '
    aadd(aBind, {'U',self:cOrder})
    aadd(aBind, {'U',cFields})

    cQuery += '     FROM ' + retSqlName(self:cTable)
    cQuery += '     WHERE ? = ? '
    aadd(aBind, {'U',self:cPrefix + 'FILIAL'})
    aadd(aBind, {'C',fwxFilial(self:cTable)})

    if ( self:cTable == 'SX5' )
        cQuery += '     AND ? = ? '
        aadd(aBind, {'U',self:cPrefix + 'TABELA'})
        aadd(aBind, {'C',cCode})
    endif

    if ( !empty(cFilter) )
        cQuery += '     AND ('
        self:setFilters(cFilter, @cQuery, @aBind)
        cQuery += '     ) '
    elseif ( !empty(cSearchType) .and. !empty(cKeys) .and. !empty(cKeyField) )
        cQuery += ' AND ('

        if ( cSearchType == 'ALL' )
            self:setFilters(cKeys, @cQuery, @aBind)
        else
            if ( cCode == 'CC2SA1' .or. cCode ==  'CC2SA2' )
                aKeys := strTokArr2(cKeys,';')

                for nI := 1 to len(aKeys)
                    if ( nI > 1 )
                        cQuery += ' OR '
                    endif

                    aKey := strTokArr2(aKeys[nI],'-')

                    if ( len(aKey) == 2 )
                        cQuery += ' (CC2_EST = ? AND CC2_CODMUN = ?) '
                        aadd(aBind,{'C',aKey[1]})
                        aadd(aBind,{'C',aKey[2]})
                    endif

                    fwFreeArray(aKey)
                next nI

                fwFreeArray(aKeys)
            else
                cQuery += ' UPPER( ? ) IN ( ? )'
                aadd(aBind, {'U',self:getTableField(cKeyField)})
                aadd(aBind, {'A',strTokArr2(cKeys,';')})
            endif
        endif

        cQuery += ' ) '
    endif

    cQuery += '     AND D_E_L_E_T_ = ? '
    aadd(aBind, {'C',' '})

    cQuery += ' ) TAB '
    cQuery += ' WHERE LINE_NUMBER BETWEEN ? AND ? '
    aadd(aBind, {'N', nInitial})
    aadd(aBind, {'N', nFinal})

    oStatement := fwExecStatement():new(changeQuery(cQuery))

    for nI := 1 to len(aBind)
        do case
            case ( aBind[nI][1] == 'C' )
                oStatement:setString(nI, aBind[nI][2])
            case ( aBind[nI][1] == 'N' )
                oStatement:setNumeric(nI, aBind[nI][2])
            case ( aBind[nI][1] == 'A' )
                oStatement:setIn(nI, aBind[nI][2])                    
            case ( aBind[nI][1] == 'U' )
                oStatement:setUnsafe(nI, aBind[nI][2])
        endcase
    next nI

    cAlias := oStatement:openAlias()

    while !(cAlias)->(eof()) .and. nCount < nPageSize
        nCount++

        jItem := jsonObject():new()
        aeval(self:aFields, {|aField| jItem[aField[nPosJsonField]] := allTrim((cAlias)->&(aField[nPosQueryField])) })

        if ( cCode == 'CC2SA1' .or. cCode ==  'CC2SA2' )
            jItem['estcodmun'] := (cAlias)->CC2_EST + '-' + (cAlias)->CC2_CODMUN
        endif

        if cCode == "F0G"
            jItem['descri'] := MSMM((cAlias)->F0G_DESCR2)
        endif

        if jItem:hasProperty('descr2')
            jItem['descr2'] := encodeUtf8(jItem['descr2'])
        endIf

        if jItem:hasProperty('desc_p')
            jItem['desc_p'] := encodeUtf8(jItem['desc_p'])
        endIf

        if jItem:hasProperty('grpcst')
            jItem['grpcst'] := encodeUtf8(jItem['grpcst'])
        endIf

        if jItem:hasProperty('desc')
            jItem['desc'] := encodeUtf8(jItem['desc'])
        endIf

        if jItem:hasProperty('descri')
            jItem['descri'] := encodeUtf8(jItem['descri'])
        endIf

        if jItem:hasProperty('desc_p')
            jItem['desc_p'] := encodeUtf8(jItem['desc_p'])
        endIf

        if jItem:hasProperty('texto')
            jItem['texto'] := encodeUtf8(jItem['texto'])
        endIf    

        aadd(aItems,jItem)

        (cAlias)->(dbSkip())
    enddo

    lHasNext := !(cAlias)->(eof())

    (cAlias)->(dbCloseArea())

    oStatement:destroy()
    fwFreeObj(oStatement)

return aItems

/*/{Protheus.doc} ProfilesLibRepository::setFilters
Método para definir os filtros da consulta.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 11/20/2025
@param cFilter, character, Filtro para busca dos dados
@param cQuery, character, Query que está sendo montada (referência)
@param aBind, array, Bind dos parâmetros da query
/*/
method setFilters(cFilter as character, cQuery as character, aBind as array) class ProfilesLibRepository

    local aFilter := {} as array
    local nI as numeric
    local nJ as numeric
    local nPosQueryField := 2 as numeric

    cFilter := upper(allTrim(decodeUtf8(cFilter)))

    aFilter := {cFilter}

    if ( ';' $ cFilter )
        aFilter := strTokArr2(cFilter,';')
    endif

    for nI := 1 to len(aFilter)
        if ( nI > 1 )
            cQuery += ' OR'
        endif

        if ( len(self:aFields) > 1 )
            cQuery += ' ('
        endif

        for nJ := 1 to len(self:aFields)
            if ( nJ > 1 )
                cQuery += ' OR'
            endif

            cQuery += ' UPPER( ? ) LIKE ? '
            aadd(aBind,{'U',self:aFields[nJ][nPosQueryField]})
            aadd(aBind,{'C','%' + aFilter[nI] + '%'})
        next nJ

        if ( len(self:aFields) > 1 )
            cQuery += ' )'
        endif
    next nI

    fwFreeArray(aFilter)

return

/*/{Protheus.doc} ProfilesLibRepository::getTableField
Método para obter o nome do campo da tabela a partir do nome do campo na json.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 20/11/2025
@param cJsonField, character, Nome do campo no json
@return character, Nome do campo da tabela
/*/
method getTableField(cJsonField as character) as character class ProfilesLibRepository

    local cTableField as character
    local cFieldPrefix := allTrim(self:cTable) + '_' as character

    if ( left(allTrim(self:cTable),1) == 'S' )
        cFieldPrefix := right(allTrim(self:cTable),2) + '_'
    endif
    
    cTableField := cFieldPrefix + allTrim(upper(cJsonField))

return cTableField

/*/{Protheus.doc} ProfilesLibRepository::destroy
Método destrutor da classe ProfilesLibRepository.
@type method
@version 12.1.2510
@author Juliano Fernandes
@since 25/11/2025
/*/
method destroy() class ProfilesLibRepository

    fwFreeArray(self:aFields)

return
