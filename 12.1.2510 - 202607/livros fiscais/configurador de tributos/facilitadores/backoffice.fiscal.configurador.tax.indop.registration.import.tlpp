#INCLUDE "tlpp-core.th"
#INCLUDE "PROTHEUS.CH"
#INCLUDE "FISCAL.CONFIGURADOR.TAX.INDOP.REGISTRATION.IMPORT.CH"
#INCLUDE "FILEIO.CH"

Namespace totvs.protheus.backoffice.fiscal.configurador.tax.indop.registration.import

Static nElemArq	:= 5 as numeric
Static aOptions := {}

/*/{Protheus.doc} ImpIndOp
Importacao da Tabela para Codigos de Operacao (IndOp)
@parametros de entrada cArquivo - arquivo .CSV que será utilizado para importar os dados
@author Douglas Dourado
@since 03/11/2025
@return lRet - Lógico, indicando se concluiu o processamento corretamente (.T.).
/*/
Function ImpIndOp(cArquivo as character) as logical

	Local cFile	:= ""  as character
	Local lRet  := .T. as logical

	Default cArquivo   := Nil

	ChangeFile(.T.,@cFile,cArquivo)

	If ! Empty(cFile)
		Processa({|| lRet := AtuCI1(cFile)},STR0001) //'Processando...'
	EndIf

Return lRet

/*/{Protheus.doc} AtuCI1
Importacao da Tabela para os Codigos de Operacao (IndOp)

@author Douglas Dourado
@since 03/11/2025
@parâmetros de entrada
cFile - arquivo .CSV que será utilizado para importar os dados
@return
lRet - Lógico, indicando se concluiu o processamento corretamente (.T.).
/*/
Static Function AtuCI1(cFile as character) as logical

	Local aCSVFile 	:= {}                 as array
	Local aFile     := {}                 as array
	Local aCampos   := {}                 as array
	Local jLastCpo  as json
	Local nRegs		:= 0                  as numeric
	Local nX 		:= 0                  as numeric
	Local nColArt11 := 1 				  as numeric
	Local lRet 		:= .F.                as logical
	Local nElemIndOp  := 0                  as numeric
	Local nElemLocPre  := 0                  as numeric
	Local nColIndOp := 0                  as numeric

	aCampos := getCI1Fields() // Define os campos da CI1 e os respectivos campos do arquivo
	
	If ExistCI1("CI1")
		
		aCSVFile := LerCSV(cFile,@aCampos) //Grava o arquivo CSV em array
		aFile := MontaArraybyCSV(aCSVFile,nColArt11) // Monta o array final, tratando os campos mesclados
		nRegs := Len(aFile)
		lRet  := (nRegs > 0)

		If lRet
			DbSelectArea("CI1")
			
			nElemIndOp  := aScan(aCampos, {|x| x[1] == 'CI1_CODIGO'}) // Posição do campo Código IndOp no array de campos 
			nElemLocPre  := aScan(aCampos, {|x| x[1] == 'CI1_LOCPRE' }) // Posição do campo Local de Prestação no array de campos
			nColIndOp := aCampos[nElemIndOp][nElemArq]

			ProcRegua(nRegs)
			jLastCpo := JsonObject():new()			

			// Processa arquivo
			For nX := 2 to  Len(aFile)     // comeca em 2 porque 1a linha eh cabecalho
				If len(aFile[nX]) >= nColIndOp // Verifica se a linha possui o número mínimo de colunas
					ProcRegCI1(nRegs, aCampos, aFile, nX, @jLastCpo , cFile , nElemLocPre , nColIndOp)
				Endif
			Next
			MSGINFO( STR0007 , STR0003 ) // "Atualização Tabela Indicadores de Operação Serviço" , "Importação da Tabela concluída!"
		EndIf
	EndIf

	aCSVFile := aSize(aCSVFile,0)
	aCSVFile := Nil
	aFile := aSize(aFile,0)
	aFile := Nil
	aCampos := aSize(aCampos,0)
	aCampos := Nil
	FwFreeObj(jLastCpo)

Return lRet

/*/{Protheus.doc} ProcRegCI1
Processa o registro atual do arquivo para importação na CI1
@author Douglas Dourado
@since 03/11/2025
@parâmetros de entrada @param nRegs - número total de registros do arquivo @param aCampos - array com os campos da CI1 e os respectivos campos do arquivo @param aFile - array com os dados do arquivo
@param nX - linha atual do arquivo que está sendo processada
@param jLastCpo - Json com os últimos valores lidos para campos que podem ser mesclados no arquivo
@return nil
/*/
Static Function ProcRegCI1( nRegs as numeric , aCampos as array , aFile as array , nX as numeric , jLastCpo as json , cFile as character , nElemLocPre as numeric , nColIndOp as numeric)
	Local cDescLocPre as character
	Local cLocPre	as character
	Local cIndOp    as character
	
	cIndOp  := Alltrim(aFile[nX][ nColIndOp ])
	cLocPre := ""

	If nElemLocPre > 0 // Se o campo Local de Prestação foi mapeado, pega o texto do local de prestação
		cDescLocPre := Alltrim(aFile[nX][ aCampos[nElemLocPre][nElemArq] ])
		If !Empty(cDescLocPre) // Se o campo não estiver vazio, tenta buscar o código correspondente do combobox do CI1_LOCPRE
			cLocPre := getLocPreOption(cDescLocPre)					
		EndIf
	EndIf

	IncProc(STR0005 + alltrim(str(nX)) + ' / ' + alltrim(str(nRegs)) + STR0006 + cFile) // "Processando Registro : " , " do arquivo "

	If ValidCI1( cIndOp , cLocPre ) // Verifica se o campo Código IndOp não está vazio e possui 6 caracteres e se o Local de Prestação foi encontrado
		GravaCI1(cIndOp, cLocPre, aCampos, aFile, nX, @jLastCpo)					
	Endif

Return

/*/{Protheus.doc} ValidCI1
Função que valida os campos obrigatórios do CI1
@author Douglas Dourado
@since 03/11/2025
@param cIndOp - Código do Indicador de Operação
@param cLocPre - Código do Local de Prestação de Serviço
@return logical, Retorna .T. se a validação for bem sucedida.
/*/
Static Function ValidCI1( cIndOp as character , cLocPre as character ) as logical
return !Empty(cIndOp) .and. ( len(cIndOp) >= 1 .and. len(cIndOp) <= 6 ) .and. !Empty(cLocPre)


/*/{Protheus.doc} GravaCI1
Grava os dados na CI1
@author Douglas Dourado
@since 04/11/2025
@parâmetros de entrada
cIndOp - Código do Indicador de Operação cLocPre - Código do Local de Prestação de Serviço aCampos - Array com os campos da CI1 e os respectivos campos do arquivo aFile - Array com os dados do arquivo lido
nX - Linha atual do arquivo que está sendo processada
jLastCpo - Json com os últimos valores lidos para campos que podem ser mesclados no arquivo
@return nil
/*/
Static Function GravaCI1( cIndOp as character, cLocPre as character, aCampos as array, aFile as array, nX as numeric, jLastCpo as json)
	Local nCont		:= 0                  as numeric
	Local lInclui	:= .F.                as logical
	
	DbSelectArea("CI1")
	CI1->(DbSetOrder(1))

	lInclui := ( ! CI1->(dbSeek(xFilial("CI1") + cIndOp )) )

	RecLock('CI1',lInclui)

	If lInclui
		CI1->CI1_FILIAL	:= xFilial("CI1")
		CI1->CI1_CODIGO	:= PadL(alltrim(cIndOp), TamSX3("CI1_CODIGO")[1] ,"0")
		CI1->CI1_DTINI 	:= dDataBase
	EndIf

	CI1->CI1_LOCPRE	:= cLocPre					

	For nCont := 1 To Len(aCampos)
		If aCampos[nCont][3] .And. aCampos[nCont][nElemArq] > 0 // Caso o campo deve ser processado dinamicamente e o campo exista no arquivo
			If !Empty(aFile[nX][aCampos[nCont][nElemArq]]) 
				CI1->&(aCampos[nCont][1]) := Alltrim(aFile[nX][aCampos[nCont][nElemArq]])
				jLastCpo[aCampos[nCont][1]] := Alltrim(aFile[nX][aCampos[nCont][nElemArq]]) // Armazena o último valor lido, para possível uso em próximas linhas
			Elseif Empty(aFile[nX][aCampos[nCont][nElemArq]]) .and. jLastCpo:hasproperty(aCampos[nCont][1]) .and. !empty(jLastCpo[aCampos[nCont][1]]) // Se o campo estiver vazio, verifica se existe valor armazenado
				CI1->&(aCampos[nCont][1]) := jLastCpo[aCampos[nCont][1]] // Atribui o último valor lido para o campo (para campos vazios por causa do mesclar da planilha)
			EndIf
		EndIf
	Next

	CI1->(MsUnlock())

	CI1->(dbCloseArea())

Return

/*/{Protheus.doc} getCI1Fields
Retorna os campos da CI1 e os respectivos campos do arquivo .csv

@author Douglas Dourado
@since 03/11/2025
@parâmetros de entrada nil
@return array com os campos da CI1 e os respectivos campos do arquivo .csv
/*/
Static Function getCI1Fields() as array

	Local aCampos := {} as array

	// aCampos[x][1] := Campo na CI1
	// aCampos[x][2] := Campo no arquivo ".csv"
	// aCampos[x][3] := Se está ou não no For..Next de gravação
	// aCampos[x][4] := Se é um campo exigido no arquivo ".csv". Uma forma de validar o arquivo ".csv"
	// aCampos[x][5] := Elemento correspondente no array gerado na leitura do arquivo ".csv"
    Aadd( aCampos , { 'CI1_CODIGO' , 'Código indOp'                                   , .F., .T., 0 } )
	Aadd( aCampos , { 'CI1_LOCPRE' , 'Local do fornecimento a ser identificado no Dfe', .F., .T., 0 } )
	Aadd( aCampos , { 'CI1_ART'    , 'Art. 11'    		                              , .T., .T., 0 } )
	Aadd( aCampos , { 'CI1_TPOPER' , 'Tipo de operação'	                              , .T., .T., 0 } )
	Aadd( aCampos , { 'CI1_CARAC'  , 'Característica do fornecimento'	              , .T., .T., 0 } )    

Return aCampos

/*/{Protheus.doc} MontaArraybyCSV
Cria um array multidimensional com os dados do arquivo .csv, tratando os campos mesclados
@author Douglas Dourado
@since 03/11/2025
@parâmetros de entrada  aCSVFile - array com as linhas do arquivo lido nColArt11 - coluna do campo Art. 11 no arquivo .csv
@return array multidimensional com os dados do arquivo .csv
/*/
Static Function MontaArraybyCSV(aCSVFile as array , nColArt11 as numeric) as array

	Local aFile     := {} as array
	Local aAux      := {} as array
	Local cTexto    as character
	Local nX        as numeric
	Local nX2       as numeric

	For nX := 1 to Len(aCSVFile) // Percorre as linhas do arquivo

		aAux   := {}
		cTexto := ''

		For nX2 := 1 to Len(aCSVFile[nX]) // Percorre as colunas da linha atual ...
			cTexto += aCSVFile[nX][nX2]

			// A primeira coluna pode vir vazia (por causa do mesclar da planilha), entao pode ser inserida manualmente para manter a estrutura ( Descarta a primeira linha (cabecalho): nX != 1 )
			If nX != 1 .and. nX2 == nColArt11 .And. !("INC." $ UPPER(cTexto)) // Nao é o inciso (CI1_ART)					
				Aadd( aAux,'' )
			EndIf					

			If Left( cTexto , 1 ) <> '"' .Or. Right( cTexto , 1 ) == '"' // Verifica se o campo não está entre aspas (caso tenha ponto e vírgula dentro do campo)
				Aadd( aAux, cTexto )
				cTexto := ''
			EndIf
		Next

		For nX2 := ( Len(aAux)+1 ) To Len(aCSVFile[1]) // Completa com campos vazios caso tenha menos colunas que o cabecalho
			Aadd( aAux,'' )
		Next

		If Len(aAux) > 0 // Adiciona a linha montada no array final
			Aadd( aFile,aAux )
		EndIf
		
	Next

	aAux := aSize(aAux,0)
	aAux := Nil

Return aFile

/*/{Protheus.doc} getLocPreOption
Retorna o código do Local de Prestação de Serviço conforme a descrição recebida
@author Douglas Dourado
@since 03/11/2025
@parâmetros de entrada cDescLocPre - Descrição do Local de Prestação de Serviço
@return  cCodLocPre - Código do Local de Prestação de Serviço
/*/
Static Function getLocPreOption(cDescLocPre as character) as character

	Local cCodLocPre as character
	Local nPos as numeric

	If Empty(aOptions) // Só pega as opções uma vez (cache com Static)
		aOptions := totvs.protheus.backoffice.fiscal.configurador.tax.indop.registration.fisaLocPres(.T.) // Retorna as opções de Local de Prestaçao de Serviço em array
	EndIf

	nPos := aScan(aOptions, {|x| cDescLocPre $ x })	// Procura a descrição no array de opções

	If nPos > 0 // Se encontrou, retorna o código correspondente para gravar no CI1_LOCPRE
		cCodLocPre := alltrim(str(nPos))
	EndIF

Return cCodLocPre

/*/{Protheus.doc} ChangeFile
Apresentar tela de seleção do arquivo .csv para importação da Classificação Tributária do IBS/CBS
@author Douglas Dourado
@since 03/11/2025
@parâmetros de entrada lOpen - indica se é "open dialog" (.T.) ou "save dialog" (.F.) cFile - variavel enviada por referência, que conterá o nome do arquivo para importação dos dados.
cFileChg - arquivo a ser processado (atender à automação). Abaixo segue descrição das opções do 6º parâmetro da função cGetFile(),
           o qual indica as opções de funcionamento:
		   GETF_LOCALHARD   : Apresenta a unidade de disco local 
		   GETF_NETWORKDRIVE: Apresenta as unidades de rede (mapeamento). Ao executar o SmartClient com um usuário diferente do  
		                      usuário logado na sessão no Windows, os drives de Rede não serão apresentados.
@return nil
/*/
Static Function ChangeFile(lOpen as logical, cFile as character, cFileChg as character)

	Local cType      := OemToAnsi("CSV|")+'*.CSV' as character

	Default lOpen    := .T.
	Default cFileChg := cGetFile(cType, OemToAnsi(STR0003), 1,, lOpen, GETF_LOCALHARD + GETF_NETWORKDRIVE, .T.)

	If ! Empty(cFileChg)
		If "." $ cFileChg
			cFileChg := Substr(cFileChg,1,rat(".", cFileChg)-1)
		Endif

		cFileChg := alltrim(cFileChg)
		cFile    := Alltrim(cFileChg+Right(cType,4))
	Endif

Return


/*/{Protheus.doc} LerCSV
Abrir e ler o arquivo passado por parâmetro e retornar um arrary multidimensional, onde cada elemento
representa uma linha do arquivo e cada elemento possui uma dimensão com os campos
@author Douglas Dourado
@since 13/06/2025
@parâmetros de entrada cFileCSV - variavel enviada que conterá o nome do arquivo para leitura dos dados.
@return aRet - array com as linhas do arquivo lido
/*/
Static Function LerCSV(cFileCSV as character, aCampos as array) as array

	Local cMemo             as character
	Local cBuffer           as character
	Local cBufGet           as character
	Local cChrSepFil        as character
	Local cTarget           as character
	Local cReplace          as character
	Local aLinha            as array
	Local aRet       := {}  as array
	Local nTamArq           as numeric
	Local nBytes            as numeric
	Local nQtdBytes  := 512 as numeric
	Local nBcoHdl           as numeric
	Local nI                as numeric
	Local lArqOK     := .T. as logical

	Default aCampos := {}

	cChrSepFil := ";"
	cTarget    := cChrSepFil+cChrSepFil
	cReplace   := cChrSepFil + Space( 3 ) + cChrSepFil

	If ValidArqImp(cFileCSV,@nBcoHdl) // Verifica se o arquivo existe e pode ser aberto

		nTamArq := FSEEK( nBcoHdl, 0, FS_END )
		FSEEK( nBcoHdl, 0, FS_SET )
		aRet	:= {}
		cBuffer := ""

		While lArqOK .And. nBytes < nTamArq // ³ Enquanto não chegar ao final do arquivo ³

			FREAD( nBcoHdl, @cBufGet, nQtdBytes ) 
			cBuffer += cBufGet

			Do While lArqOK .And. ( nI := AT( CHR(13)+CHR(10), cBuffer ) ) > 0 //³ Execute ate encontrar os caracteres de final de linha ³

				cMemo := SubStr( cBuffer, 1, nI+1 )

				If !Empty( SubStr( cMemo, 1, Len( cMemo ) - 2 ) ) // ³ Se a linha não estiver vazia ³

					Do While AT( cTarget, cMemo ) > 0
						cMemo := StrTran( cMemo, cTarget, cReplace) 
					EndDo

					If Len(aRet) == 0         // 1ª linha do arquivo (nomes dos campos)
						cMemo := UPPER(cMemo) // deixar em maiúscula
					EndIf

					aLinha := StrTokArr( StrTran( SubStr( cMemo, 1, Len( cMemo ) - 2 ), cTarget, cReplace), cChrSepFil )

					aAdd( aRet, aLinha )

					If Len(aRet) == 1 .And. Len(aCampos) > 0
						lArqOK := VerCampos(aRet[1],@aCampos) // Verifica se o arquivo possui os campos necessários
					Endif

				EndIf

				cBuffer	:= SubStr( cBuffer, nI + 2 )

			EndDo

			nBytes += nQtdBytes
		EndDo
		fClose( nBcoHdl )

	EndIf

	If ! lArqOK // Se o arquivo não for válido, retorna array vazio
		aRet := {}
		MSGStop(STR0009,STR0003) // "Arquivo inválido. Ausência de campos necessários" , "Atualização Tabela Indicadores de Operação Serviço"
	EndIf

Return aRet

/*/{Protheus.doc} VerCampos
Fazer a relação dos campos da CI1 com os campos do arquivo que está sendo lido, além de validar se o arquivo
é válido exigindo a existência de 4 campos específicos (códigos e descrição da Classificação Tributária)
@author Douglas Dourado
@since 04/07/2025
@parâmetros de entrada aRet - array com os campos na 1ª linha do arquivo aCampos - campos da CI1 e os respectivos campos do arquivo
@return lRet - Lógico, indicando se o arquivo possui os campos exigidos
/*/
Static Function VerCampos(aRet as array ,aCampos as array) as logical

	Local nX          as numeric
	Local lRet := .T. as logical

	For nX := 1 To Len (aCampos)
		aCampos[nX][nElemArq] := aScan( aRet, UPPER(aCampos[nX][2]) )

		lRet := aCampos[nX][nElemArq] > 0 .Or. (! aCampos[nX][4])
		If ! lRet
			Exit
		EndIf
	Next

Return lRet

/*/{Protheus.doc} ExistCI1
Verifica se o alias recebido existe no dicionário
@author Douglas Dourado
@since 18/06/2025
@parâmetros de entrada cAlias - alias da tabela para verificar se existe no dicionário
@return lRet - Lógico, indicando se realizou o procedimento com sucesso
/*/
Function ExistCI1(cAlias) as logical

	Local lRet as logical

	lRet := AliasInDic(cAlias)

	If ! lRet
		MSGStop(STR0002,STR0003) // 'Códigos Indicadores de Operação.' , 'Dicionário desatualizado, verifique as atualizações do configurador de tributos fiscal.'
	EndIf

Return lRet

/*/{Protheus.doc} ValidArqImp
Verifica o arquivo para importação existe e pode ser aberto
@author Douglas Dourado
@since 18/06/2025
@parâmetros de entrada cArquivo - arquivo texto para ser aberto nHandle - resultado da abertura do arquivo recebido. Deve ser passado por referência para ser fechado na rotina que solicitou
@return lRet - Lógico, indicando se realizou o procedimento com sucesso
/*/
Function ValidArqImp(cArquivo as character , nHandle as numeric) as logical

	Local lRet as logical

	Default nHandle := -1

	nHandle := FOpen(cArquivo,FO_READ+FO_COMPAT)
	lRet    := (nHandle >= 0)

	If ! lRet
		MSGStop(STR0004,STR0003) // "O arquivo está vazio ou não pode ser aberto!" , "Atualização Tabela Indicadores de Operação Serviço"
	EndIf

Return lRet
