    self:jLegacyTaxIds["000034"] := {"TG_IT_BASE": "IT_BSCP20"   , "TG_IT_ALIQUOTA": "IT_ALCP20"   , "TG_IT_VALOR": "IT_VLCP20"}
    self:jLegacyTaxIds["000035"] := {"TG_IT_BASE": "IT_BSCP25"   , "TG_IT_ALIQUOTA": "IT_ALCP25"   , "TG_IT_VALOR": "IT_VLCP25"}
