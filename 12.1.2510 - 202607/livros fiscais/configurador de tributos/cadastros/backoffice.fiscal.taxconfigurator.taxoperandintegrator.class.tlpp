/*/{Protheus.doc} HasWarning
    Verifica se houve algum aviso ou erro durante o processamento dos tributos, retornando o valor do flag interno.
    Esse método é utilizado para controlar o fluxo de validação e processamento, indicando se o processamento deve ser interrompido ou não.

    @author rhuan.carvalho
    @since 17/09/2025
    @version 1.0
    @param , , Não recebe parâmetros.
    @return lWarning, logical, Retorna .T. se houve aviso/erro no processamento, .F. caso contrário.
    /*/
Method HasWarning() as logical Class TaxOperandIntegrator    
Return self:lWarning

/*/{Protheus.doc} CheckTaxItem
    Verifica se o Id do tributo informado está amarrado na operação do item fiscal, ou seja, se existe na configuração de tributos do item.
    Utiliza a função MafisRet para buscar os tributos configurados e compara o ID informado. Retorna verdadeiro se o tributo está presente, falso caso contrário.

    @author rhuan.carvalho
    @since 17/09/2025
    @version 1.0
    @param cIdTrib, character, Identificador do tributo a ser verificado
    @param nItem, numeric, Número do item do documento fiscal
    @return lOk, logical, Retorna .T. se o tributo está amarrado na operação, .F. caso contrário
    /*/
Method CheckTaxItem(cIdTrib as character, nItem as numeric) as logical Class TaxOperandIntegrator
    Local lOk             := .F. as logical
    Local aTaxConfig      := {}  as json
    Local nPosTx          := 0   as numeric

    If MaFisFound("IT", nItem)
        aTaxConfig      := MafisRet(nItem, "IT_TRIBGEN")

        If Len(aTaxConfig) > 0 .and. !Empty(cIdTrib)
            If (nPosTx := aScan(aTaxConfig, {|x| AllTrim(x[TG_IT_IDTRIB]) == AllTrim(cIdTrib)})) > 0
                lOk := .T.
            EndIf
        EndIf

        aSize(aTaxConfig, 0)
    EndIf 
   
Return lOk

/*/{Protheus.doc} ImputTaxOnMatxfis
    Realiza a inclusão dos valores dos tributos na estrutura interna MATXFIS, posicionando e atualizando as referências conforme o JSON recebido.
    Só executa o processamento caso não haja avisos ou erros prévios, garantindo a integridade dos dados.
    Este método é chamado após as validações de schema e existência dos operandos de integração.

    @author rhuan.carvalho
    @since 17/09/2025
    @version 1.0
    @param , , Não recebe parâmetros.
    @return , void, Não retorna valor. Apenas atualiza os dados internos da MATXFIS.
    /*/
Method ImputTaxOnMatxfis() Class TaxOperandIntegrator

    If !self:HasWarning()
        self:PositionAndUpdateTaxReferences()
    EndIf

return

/*/{Protheus.doc} PositionAndUpdateTaxReferences
    Percorre os itens do JSON de tributos recebido, identifica os tributos de cada item e posiciona os dados nas referências corretas do sistema.
    Processa primeiro os tributos legados e depois os tributos novos, garantindo a ordem correta de processamento.
    Para cada tributo encontrado, chama o método responsável por atualizar as referências internas, garantindo que os dados sejam inseridos corretamente na estrutura de integração.

    @rhuan.carvalho
    @since 17/09/2025
    @version 1.1
    @param , , Não recebe parâmetros.
    @return cIDTAB, character, Retorna o identificador da tabela de referência utilizada (se aplicável).
    /*/
Method PositionAndUpdateTaxReferences() Class TaxOperandIntegrator
    Local aItems         := self:jImputDataTax:GetNames()
    Local aTributos      := {} as array
    Local aTributosLegacy := {} as array
    Local aTributosNew    := {} as array
    Local jTributo       := JsonObject():New()
    Local cIDTrib        := "" as character
    Local nItem          := 0  as numeric
    Local nTributo       := 0  as numeric

    // Processa cada item
    For nItem := 1 to Len(aItems)
        aTributos := self:jImputDataTax[aItems[nItem]]:GetNames()
        
        // Separa os tributos entre legados e novos
        aSize(aTributosLegacy, 0)
        aSize(aTributosNew, 0)
        
        For nTributo := 1 to Len(aTributos)
            cIDTrib := aTributos[nTributo]
            
            If self:jLegacyTaxIds:hasProperty(cIDTrib)
                aAdd(aTributosLegacy, cIDTrib)
            Else
                aAdd(aTributosNew, cIDTrib)
            EndIf
        Next nTributo
        
        // Processa primeiro os tributos LEGADOS
        For nTributo := 1 to Len(aTributosLegacy)
            cIDTrib := aTributosLegacy[nTributo]
            jTributo := self:jImputDataTax[aItems[nItem]][cIDTrib]
            self:UpdateInternalReferences(cIDTrib, val(aItems[nItem]), jTributo)
        Next nTributo
        
        // Depois processa os tributos NOVOS
        For nTributo := 1 to Len(aTributosNew)
            cIDTrib := aTributosNew[nTributo]
            jTributo := self:jImputDataTax[aItems[nItem]][cIDTrib]
            self:UpdateInternalReferences(cIDTrib, val(aItems[nItem]), jTributo)
        Next nTributo
        
    Next nItem
    
    self:SetSuccessStatus("success", "referencias dos tributos atualizadas com sucesso.")
    
    // Limpa os arrays
    aSize(aItems, 0)
    aSize(aTributos, 0)
    aSize(aTributosLegacy, 0)
    aSize(aTributosNew, 0)
    FreeObj(jTributo)

return

/*/{Protheus.doc} UpdateInternalReferences
    Atualiza as referências internas dos tributos para cada item processado, percorrendo as propriedades do tributo e posicionando os valores nas estruturas corretas do sistema.
    Realiza a integração dos dados conforme o tipo de referência, utilizando os métodos apropriados para cada propriedade.

    @author rhuan.carvalho
    @since 18/09/2025
    @version 1.0
    @param cIdTrib, character, Identificador do tributo a ser atualizado
    @param nItem, numeric, Número do item do documento fiscal
    @param jProperties, json, Objeto JSON contendo as propriedades e valores do tributo
    @return , void, Não retorna valor
    /*/
Method UpdateInternalReferences(cIdTrib as character, nItem as numeric, jProperties as json) Class TaxOperandIntegrator
    Local aProperties := jProperties:GetNames()
    Local cReference  := "" as character
    Local nProperty   := 0  as numeric
    Local aTaxConfig  := MafisRet(nItem, "IT_TRIBGEN")
    Local nPosTx      := aScan(aTaxConfig, {|x| AllTrim(x[TG_IT_IDTRIB]) == AllTrim(cIdTrib)})
    Local nPosCmp     := 0  as numeric
    Local nPosRef     := 0  as numeric
    Local aNfItem     := GetANfITem() 
    Local xContent     as variant   

    self:SetIncidenceOption(aNfItem, nItem, nPosTx, jProperties)

    MafisLoad("IT_CLASS_UPDATE", .T., nItem)

    For nProperty := 1 to Len(aProperties)
        cReference    := self:GetReference(aProperties[nProperty])
        xContent        := jProperties[aProperties[nProperty]]

        If aProperties[nProperty] $ "base_quantidade|vl_majoracao|pc_majorcao" 
            If cReference == "TG_IT_BASE" .and. jProperties["base_quantidade"] > 0 .and. !Empty(jProperties["base_quantidade"])
                Mafisalt("IT_TRIBGEN", xContent , nItem,,,,,,,{aTaxConfig[nPosTx][TG_IT_SIGLA],cReference})
                nPosCmp := self:jPosFieldRef["TG_BAS_VLORI"]
                nPosRef := self:jPosFieldRef["TG_IT_REGRA_BAS"]
                aNfItem[nItem][IT_TRIBGEN][nPosTx][nPosRef][nPosCmp] := '02'
            EndIf
            If cReference == "TG_IT_VALOR" .and. jProperties["vl_majoracao"] > 0 .and. !Empty(jProperties["vl_majoracao"])
                If !Empty(aNfItem[nItem][IT_TRIBGEN][nPosTx][TG_IT_TRB_MAJ])               
                    nPosCmp := self:jPosFieldRef["TG_IT_VALOR"]
                    aNfItem[nItem][IT_TRIBGEN][nPosTx][nPosCmp] := xContent
                EndIf
            EndIf
            If cReference == "TG_IT_ALIQUOTA" .and. jProperties["pc_majorcao"] > 0 .and. !Empty(jProperties["pc_majorcao"])               
                If !Empty(aNfItem[nItem][IT_TRIBGEN][nPosTx][TG_IT_TRB_MAJ])
                    nPosCmp := self:jPosFieldRef["TG_IT_ALIQUOTA"]
                    aNfItem[nItem][IT_TRIBGEN][nPosTx][nPosCmp] := xContent
                EndIf
            End
            Loop
        EndIf

        Do Case
            Case cReference $ "TG_IT_BASE|TG_IT_ALIQUOTA|TG_IT_VALOR"
                If !self:jLegacyTaxIds:hasProperty(cIDTrib)
                    Mafisalt("IT_TRIBGEN", xContent , nItem,,,,,,,{aTaxConfig[nPosTx][TG_IT_SIGLA],cReference})
                Else
                    If !self:jLegacyTaxIds[cIDTrib][cReference] == "Null"
                        Mafisalt(self:jLegacyTaxIds[cIDTrib][cReference], xContent , nItem)
                    EndIf
                EndIf
            Case cReference $ "TG_IT_MVA|TG_IT_AUX_MVA|TG_IT_PAUTA|TG_IT_MAJ|TG_IT_AUX_MAJ|TG_IT_DED_DEP|TG_IT_ALIQTR""
                nPosRef := self:jPosFieldRef[cReference]
                aNfItem[nItem][IT_TRIBGEN][nPosTx][nPosRef] := xContent
            Case cReference == "TG_BAS_UM"
                nPosCmp := self:jPosFieldRef[cReference]
                nPosRef := self:jPosFieldRef["TG_IT_REGRA_BAS"]
                aNfItem[nItem][IT_TRIBGEN][nPosTx][nPosRef][nPosCmp] := xContent            
            Case cReference $ "TG_LF_CSTCAB|TG_LF_CST|TG_LF_CCT"
                nPosCmp := self:jPosFieldRef[cReference]
                nPosRef := self:jPosFieldRef["TG_IT_LF"]
                aNfItem[nItem][IT_TRIBGEN][nPosTx][nPosRef][nPosCmp] := xContent
                If cReference == "TG_LF_CST"
                    nPosCmp := self:jPosFieldRef["RE_CST"]
                    nPosRef := self:jPosFieldRef["TG_IT_REGRA_ESCR"]
                    aNfItem[nItem][IT_TRIBGEN][nPosTx][nPosRef][nPosCmp] := xContent
                ElseIf cReference == "TG_LF_CSTCAB"
                    nPosCmp := self:jPosFieldRef["RE_CSTCAB"]
                    nPosRef := self:jPosFieldRef["TG_IT_REGRA_ESCR"]
                    aNfItem[nItem][IT_TRIBGEN][nPosTx][nPosRef][nPosCmp] := xContent
                ElseIf cReference == "TG_LF_CCT"
                    nPosCmp := self:jPosFieldRef["RE_CCT"]
                    nPosRef := self:jPosFieldRef["TG_IT_REGRA_ESCR"]
                    aNfItem[nItem][IT_TRIBGEN][nPosTx][nPosRef][nPosCmp] := xContent
                EndIf
            Otherwise
                nPosCmp := self:jPosFieldRef[cReference]
                nPosRef := self:jPosFieldRef["TG_IT_LF"]
                aNfItem[nItem][IT_TRIBGEN][nPosTx][nPosRef][nPosCmp] := xContent
        EndCase

    Next nProperty
    aSize(aProperties, 0)
return

/*/{Protheus.doc} GetReference
    Retorna o nome da referência interna do sistema correspondente à propriedade informada do tributo.
    
    @author rhuan.carvalho
    @since 18/09/2025
    @version 1.0
    @param cProperty, character, Nome da propriedade do tributo a ser mapeada
    @return cReference, character, Nome da referência interna correspondente à propriedade informada
    /*/
Method GetReference(cProperty as character) Class TaxOperandIntegrator
return self:jRetReference[cProperty]

/*/{Protheus.doc} ExistsOperandIntegration
    Verifica se cada tributo informado no JSON possui operando de integração cadastrado na estrutura do item fiscal.
    Para tributos legados, valida se pelo menos um dos operandos está presente. Para tributos novos, valida também a regra de escrituração.
    Caso não encontre o operando de integração, registra mensagem de erro e interrompe o processamento.

    @author rhuan.carvalho
    @since 24/10/2025
    @version 1.0
    @param , , Não recebe parâmetros.
    @return , void, Não retorna valor. Em caso de erro, preenche o objeto de erro e ativa o flag de aviso.
    /*/
Method ExistsOperandIntegration() Class TaxOperandIntegrator
    Local aItems          := self:jImputDataTax:GetNames()
    Local aTributos       := {}  as array
    Local aITTribGen      := {}  as array
    Local cIDTrib         := ""  as character
    Local nItem           := 0   as numeric
    Local nTributo        := 0   as numeric
    Local nPosTrib        := 0   as numeric
    Local lOPIntgrRegBase := .F. as logical
    Local lOPIntgrRegAlq  := .F. as logical
    Local lOPIntgrValor   := .F. as logical
    Local cOpIntgrEscr    := ""  as character

    If !self:HasWarning()

        For nItem := 1 to Len(aItems)
            aITTribGen := MafisRet(val(aItems[nItem]), "IT_TRIBGEN")
            aTributos := self:jImputDataTax[aItems[nItem]]:GetNames()
            For nTributo := 1 to Len(aTributos)
                cIDTrib := aTributos[nTributo]
                nPosTrib := aScan(aITTribGen, {|x| AllTrim(x[TG_IT_IDTRIB]) == AllTrim(cIdTrib)})
                
                lOPIntgrRegBase := aITTribGen[nPosTrib][TG_IT_REGRA_BAS][TG_BAS_OPINTEG]
                lOPIntgrRegAlq  := aITTribGen[nPosTrib][TG_IT_REGRA_ALQ][TG_ALQ_OPINTEG]
                lOPIntgrValor   := aITTribGen[nPosTrib][TG_IT_OPINTEG]
                cOpIntgrEscr    := aITTribGen[nPosTrib][TG_IT_REGRA_ESCR][RE_INCIDE]
                
                If self:HasBookkeepingProperty(val(aItems[nItem]), cIDTrib)
                    If !(lOPIntgrRegBase .and. lOPIntgrRegAlq .and. lOPIntgrValor .and. cOpIntgrEscr == "8")
                        self:SetPropertyMesageError("warning","O tributo "+cIDTrib+" do item "+cValToChar(nItem)+" não possui operando de integração cadastrado na regra de escrituração.")
                        return
                    EndIf
                Else
                    If !(lOPIntgrRegBase .and. lOPIntgrRegAlq .and. lOPIntgrValor)
                        self:SetPropertyMesageError("warning","O tributo"+cIDTrib+" do item "+cValToChar(nItem)+" não possui operando de integração cadastrado.")
                        return
                    EndIf
                EndIf
            Next nTributo
        Next nItem
        aSize(aItems, 0)
        aSize(aTributos, 0)
        aSize(aITTribGen, 0)
    EndIf
return

/*/{Protheus.doc} HasBookkeepingProperty
    Verifica se o tributo legado informado possui a propriedade de escrituração no JSON de entrada.
    Essa verificação é importante para determinar se o tributo deve ser considerado na validação dos operandos de integração mantendo a obrigatoriedade do [RE_INCIDE].

    @author rhuan.carvalho
    @since 24/10/2025
    @version 1.0
    @param nItem, numeric, Número do item do documento fiscal
    @param cIdTrib, character, Identificador do tributo a ser verificado
    @return lHasProperty, logical, Retorna .T. se a propriedade de escrituração está presente, .F. caso contrário.
    /*/
method HasBookkeepingProperty(nItem as numeric, cIdTrib as character) as logical Class TaxOperandIntegrator
   Local lOk         := .F. as logical
   Local jProperties := self:jImputDataTax[cValToChar(nItem)][cIdTrib]

   If jProperties:hasProperty("esc_tab_CST") .or. jProperties:hasProperty("esc_CST") .or. jProperties:hasProperty("esc_vl_tributado") .or. ;
        jProperties:hasProperty("esc_vl_isento") .or. jProperties:hasProperty("esc_vl_outros") .or. jProperties:hasProperty("esc_vl_diferido") .or. ;
        jProperties:hasProperty("esc_pc_diferido") .or. jProperties:hasProperty("esc_pc_reducao_base") .or. jProperties:hasProperty("esc_base_original") .or. ;
        jProperties:hasProperty("esc_pc_reducao_aliq") .or. jProperties:hasProperty("esc_aliquota_original") .or. jProperties:hasProperty("esc_vl_nao_tributado") .or. ;
        jProperties:hasProperty("esc_vl_majorado") .or. jProperties:hasProperty("esc_pc_majoracao") .or. jProperties:hasProperty("esc_vl_pauta") .or. ;
        jProperties:hasProperty("esc_vl_mva") .or. jProperties:hasProperty("esc_vl_aux_mva") .or. jProperties:hasProperty("esc_vl_aux_majoracao") .or. ;
        jProperties:hasProperty("esc_aliquota_tributada") .or. jProperties:hasProperty("esc_CCT")
        
        lOk := .T.
    EndIf

return lOk

/*/{Protheus.doc} SetSuccessStatus
    Configura uma mensagem de sucesso no objeto JSON de retorno, associando o status e a mensagem informados.
    Este método é utilizado para registrar mensagens de sucesso após o processamento dos tributos, permitindo que o resultado seja retornado em formato JSON.

    @author rhuan.carvalho
    @since 02/10/2025
    @version 1.0
    @param status, character, Status do processamento (ex: "success")
    @param cMessage, character, Mensagem de sucesso a ser registrada
    @return , void, Não retorna valor. Apenas atualiza o objeto de sucesso interno.
    /*/
Method SetSuccessStatus(status as character, cMessage as character) Class TaxOperandIntegrator
    self:jReturnSuccess[status] := cMessage
Return
/*/{Protheus.doc} SetIncidenceOption
    Define a opção de incidência do tributo baseado nos valores de tributado, isento e outros.
    Utiliza um sistema de bitmap para mapear as combinações possíveis dos valores de escrituração.
    
    @author rhuan.carvalho
    @since 01/11/2025
    @version 1.0
    @param aNfItem, array, Array de itens da nota fiscal
    @param nItem, numeric, Posição do item no array
    @param nPosTx, numeric, Posição do tributo no array IT_TRIBGEN
    @param jProperties, json, Objeto JSON contendo as propriedades de escrituração do tributo
    @return void
    @obs As propriedades já foram validadas anteriormente no método CheckItemTaxJsonSchema
    /*/

Method SetIncidenceOption(aNfItem as array, nItem as numeric, nPosTx as numeric, jProperties as json) Class TaxOperandIntegrator
    Local nBitMap := 0 as numeric
    Local cOption := "" as character
    
    // Cria um bitmap das propriedades: bit 1 = tributado, bit 2 = isento, bit 4 = outros
    If jProperties["esc_vl_tributado"] > 0
        nBitMap += 1
    EndIf
    If jProperties["esc_vl_isento"] > 0
        nBitMap += 2
    EndIf
    If jProperties["esc_vl_outros"] > 0
        nBitMap += 4
    EndIf
    
    // Mapeia diretamente o bitmap para a opção
    Do Case
        Case nBitMap == 7  // todos os três
            cOption := "7"
        Case nBitMap == 6  // isento + outros
            cOption := "6"
        Case nBitMap == 5  // tributado + outros
            cOption := "5"
        Case nBitMap == 3  // tributado + isento
            cOption := "4"
        Case nBitMap == 4  // apenas outros
            cOption := "3"
        Case nBitMap == 2  // apenas isento
            cOption := "2"
        Case nBitMap == 1  // apenas tributado
            cOption := "1"
    EndCase
    
    If !Empty(cOption)
        aNfItem[nItem][IT_TRIBGEN][nPosTx][TG_IT_REGRA_ESCR][RE_INCIDE] := cOption
    EndIf

return

/*/{Protheus.doc} destroy
    responável por liberar os objetos JSON utilizados na classe, garantindo que não haja vazamento de memória.
    Esse método é chamado automaticamente no final do processamento dos dados da classe.
    @author rhuan.carvalho
    @since 02/10/2025
    @version version
    @param param_name, param_type, param_descr
    @return return_var, return_type, return_description
    /*/
Method destroy() Class TaxOperandIntegrator

    FreeObj(self:jReturnError)
    self:jReturnError := nil
    FreeObj(self:jReturnSuccess)
    self:jReturnSuccess := nil
    FreeObj(self:jPropertiesTax)
    self:jPropertiesTax := nil
    FreeObj(self:jImputDataTax)
    self:jImputDataTax := nil
    FreeObj(self:jLegacyTaxIds)
    self:jLegacyTaxIds := nil
    FreeObj(self:jPosFieldRef)
    self:jPosFieldRef := nil
    FreeObj(self:jRetReference)
    self:jRetReference := nil

Return 
