#INCLUDE "tlpp-core.th"
#INCLUDE "MATXDEF.CH"

namespace totvs.protheus.backoffice.fiscal.taxoperandintegrator

/*/{Protheus.doc} TaxOperandIntegrator

    Classe responsável por realizar a recepção dos tributos com operando de integração.
    Processa o JSON de tributos dos itens fiscais, valida o schema, verifica a existência dos operandos de integração,
    realiza a inclusão dos valores dos tributos na estrutura interna e atualiza as referências conforme as regras de escrituração.
    Permite o controle de avisos e erros durante o processamento, retornando mensagens detalhadas em formato JSON.
    Suporta tanto tributos legados quanto novos, com mapeamento dinâmico das propriedades e referências utilizadas.

    @author rhuan.carvalho
    @since 16/09/2025
    @version 1.0
    /*/
Class TaxOperandIntegrator
    Private Data jReturnError     as json //Objeto JSON para armazenar json de erro
    Private Data jReturnSuccess   as json //Objeto JSON para armazenar json de sucesso
    Private Data jPropertiesTax   as json //Objeto JSON para armazenar as propriedades esperadas no JSON de tributos
    Private Data jLegacyTaxIds    as json //Objeto JSON para armazenar os IDs dos tributos processados
    Private Data jImputDataTax    as json //Objeto JSON para armazenar o JSON de tributos recebido
    Private Data jPosFieldRef     as json //Objeto JSON para armazenar a posição da referência dos campos no array de referências
    Private Data lWarning         as logical //Flag para indicar se houve aviso durante o processamento
    Private Data jRetReference    as json //Objeto JSON para armazenar o mapeamento das referências dos campos
    
    Public Method new() CONSTRUCTOR //Método construtor da classe TaxOperandIntegrator
    Public Method ProcessItemTaxJson(jData as json) //Método público para processar o JSON de tributos do item

    Private Method CheckItemTaxJsonSchema(jData as json) //Método privado para validar o schema do JSON   
    Private Method SetPropertyMesageError(cProperty as character, cMessage as character) as json //Método privado para configurar a propriedade de mensagem de erro
    Private Method ChargePropertyTax() as json //Método privado para carregar as propriedades esperadas no JSON
    Private Method CheckTaxItem(cIdTrib as character, nItem as numeric) as logical //Método privado para verificar se o ID do tributo esta no processamento da matxfis
    Private Method HasWarning() as logical //Método privado para verificar se houve aviso durante o processamento
    Private Method ExistsOperandIntegration() //Método privado para verificar se o tributo possui operando de integração
    Private Method ImputTaxOnMatxfis() //Método privado para realizar incluir os valores dos tributos na MATXFIS
    Private Method PositionAndUpdateTaxReferences() //Método privado para atualizar os dados na tabela F2D
    Private Method GetReference(cProperty as character)//Método privado para retornar a posição da referência do tributo no array de referências
    Private Method UpdateInternalReferences(cIdTrib as character, nItem as numeric, jPropertiesTax as json) //Método privado para inserir os dados na tabela F2D dos tributos legados
    Private Method HasBookkeepingProperty(nItem as numeric, cIdTrib as character) as logical //Método privado para verificar se o tributo possui a propriedade de regra de escrituração
    Private Method SetSuccessStatus(status as character, cMessage as character) //Método privado para configurar a propriedade de mensagem de sucesso
    Private Method SetIncidenceOption(aNfItem as array, nItem as numeric, nPosTx as numeric, jProperties as json) //Método privado para configurar a opção de incidência dos tributos
    Private Method destroy() //Método privado para destruir os objetos JSON criados

EndClass

/*/{Protheus.doc} new
    Inicializa os atributos da classe TaxOperandIntegrator, criando os objetos JSON necessários, o array de referências de tributos e o flag de aviso.
    Também carrega as propriedades esperadas para o processamento dos tributos.

    @author user
    @since 16/09/2025
    @version 1.0
    @param , , Não recebe parâmetros.
    @return , void, Não retorna valor.
    /*/
Method new() Class TaxOperandIntegrator
    self:lWarning         := .F.
    self:jReturnError     := JsonObject():New()
    self:jReturnSuccess   := JsonObject():New()
    self:jPropertiesTax   := JsonObject():New()
    self:jImputDataTax    := JsonObject():New()
    self:jLegacyTaxIds    := JsonObject():New()
    self:jPosFieldRef     := JsonObject():New()
    self:jRetReference    := JsonObject():New()

    self:ChargePropertyTax()
Return 

/*/{Protheus.doc} ProcessItemTaxJson
    Processa o JSON de tributos do item, realizando as validações de schema, verificando a existência de operandos de integração e incluindo os valores dos tributos na MATXFIS.
    Retorna o resultado do processamento em formato JSON, contendo mensagens de sucesso ou erro.

    @author rhuan.carvalho
    @since 16/09/2025
    @version 1.0
    @param json, json, JSON contendo os dados dos tributos dos itens a serem processados
    @return cReturnProcess, character, JSON com o resultado do processamento (sucesso ou erro)
    /*/
Method ProcessItemTaxJson(jData as json) Class TaxOperandIntegrator
    Local cReturnProcess := ""
    
    self:CheckItemTaxJsonSchema(jData)
    self:ExistsOperandIntegration()
    self:ImputTaxOnMatxfis()
    
    If self:HasWarning()
        cReturnProcess := self:jReturnError:ToJson()
    Else
        cReturnProcess := self:jReturnSuccess:ToJson()
    EndIf

    self:destroy()
    
Return cReturnProcess

/*/{Protheus.doc} CheckItemTaxJsonSchema
    Valida o schema do JSON de tributos recebido, verificando se os itens e tributos estão corretos, se possuem as propriedades obrigatórias e se não há propriedades inválidas.
    Caso encontre inconsistências, registra mensagem de aviso e interrompe o processamento.

    @rhuan.carvalho
    @since 16/09/2025
    @version 1.0
    @param json, json, JSON contendo os dados dos tributos dos itens a serem processados
    @return , void, Não retorna valor. Em caso de erro, preenche o objeto de erro e ativa o flag de aviso.
    /*/
Method CheckItemTaxJsonSchema(jData as Json) Class TaxOperandIntegrator
    Local aItems         := {} as array
    Local aTributos      := {} as array
    Local aProperties    := {} as array
    Local cIDTrib        := "" as character
    Local nItem          := 0  as numeric
    Local nTributo       := 0  as numeric
    Local nPropertNw     := 0  as numeric
    Local nPropertLg      := 0  as numeric
    Local jPropertiesReq := JsonObject():New()

    If Valtype(jData) <> "J"
        self:SetPropertyMesageError("warning","É Necessário enviar um Json.")
        return
    EndIf
    
    aItems := jData:GetNames()   
    If Len(aItems) == 0 
        self:SetPropertyMesageError("warning","O JSON informado não contém itens.")
        return
    EndIf
    
    For nItem := 1 to Len(aItems)
        aTributos := jData[aItems[nItem]]:GetNames()
        For nTributo := 1 to Len(aTributos)
            cIDTrib := aTributos[nTributo]
            // Verfica se o ID do tributo está no processamento da matxfis
            If !self:CheckTaxItem(cIDTrib, val(aItems[nItem]))
                self:SetPropertyMesageError("warning","O JSON informado contém o ID "+cIDTrib+", não esta amarrado na operação ou a matxfis não esta inicializada.")
                return
            EndIf
            
            self:jImputDataTax := jData  
            aProperties    := self:jImputDataTax[aItems[nItem]][cIDTrib]:GetNames()
            jPropertiesReq := self:jImputDataTax[aItems[nItem]][cIDTrib]
            
            If Len(aProperties) == 0 
                self:SetPropertyMesageError("warning","O JSON informado não contém propriedades para o tributo: "+aTributos[nTributo])
                return
            EndIf
            
            If !self:jLegacyTaxIds:hasProperty(cIDTrib)
                // Verifica se há propriedades inválidas para os novos tributos
                For nPropertNw := 1 to Len(aProperties)
                    If !self:jPropertiesTax["Propriedades"]["new"]:hasProperty(aProperties[nPropertNw])
                        self:SetPropertyMesageError("warning","O JSON informado contém a propriedade inválida: "+aProperties[nPropertNw])
                        return       
                    EndIf
                Next nPropertNw
            Else
                // Verifica se há propriedades inválidas para os tributos legados
                For nPropertLg := 1 to Len(aProperties)
                    If !self:jPropertiesTax["Propriedades"]["legacy"]:hasProperty(aProperties[nPropertLg])
                        self:SetPropertyMesageError("warning","O JSON informado contém a propriedade inválida: "+aProperties[nPropertLg])
                        return       
                    EndIf
                Next nPropertLg
            EndIf
            
            // Verifica se todas as propriedades mínimas obrigatórias para os tributos estão presentes
            If !(jPropertiesReq:hasProperty("base_valor") .and. jPropertiesReq:hasProperty("aliquota") .and. jPropertiesReq:hasProperty("valor"))
                self:SetPropertyMesageError("warning","O JSON informado não contém as propriedades mínimas obrigatórias (base_valor, aliquota e valor) para o tributo: "+aTributos[nTributo])
                return
            EndIf
            
            // Verifica se o json do tributo possui propriedade de regra de escrituração e se todas as propriedades obrigatórias estão presentes
            If self:HasBookkeepingProperty(val(aItems[nItem]), cIDTrib)
                If !(jPropertiesReq:hasProperty("esc_vl_tributado") .and. jPropertiesReq:hasProperty("esc_vl_isento") .and. jPropertiesReq:hasProperty("esc_vl_outros"))
                    self:SetPropertyMesageError("warning","O JSON informado não contém todas as propriedades obrigatórias para o tributo com regra de escrituração: "+aTributos[nTributo])
                    return
                EndIf
            Endif
        Next nTributo
    Next nItem
    
    aSize(aItems, 0)
    aSize(aTributos, 0)
    aSize(aProperties, 0)
    FreeObj(jPropertiesReq)   
return

/*/{Protheus.doc} SetPropertyMesageError
    Configura uma mensagem de erro no objeto JSON de retorno, associando a mensagem à propriedade informada e ativa o flag de aviso para indicar que houve erro no processamento.

    @author user
    @since 16/09/2025
    @version 1.0
    @param cProperty, character, Nome da propriedade onde será registrada a mensagem de erro
    @param cMessage, character, Mensagem de erro a ser registrada
    @return self, json, Retorna o próprio objeto da classe para permitir encadeamento
    /*/
Method SetPropertyMesageError(cProperty as character, cMessage as character) as json Class TaxOperandIntegrator
    
    self:jReturnError[cProperty]    := cMessage
    self:lWarning                   := .T.
    
Return self

