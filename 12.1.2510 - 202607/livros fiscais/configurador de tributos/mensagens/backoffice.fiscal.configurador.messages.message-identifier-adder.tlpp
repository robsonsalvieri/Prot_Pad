#Include 'Protheus.ch'
#Include 'FWMVCDef.ch'
#Include 'tlpp-core.th'

/*/{Protheus.doc} MessageIdentifierAdder
Classe que adiciona os identificadores de mensagens na tabela CK6.
Esta classe é utilizada no fonte FISA170, na carga inicial.
@type class
@version 12.1.2410
@author Juliano Fernandes
@since 30/04/2025
/*/
Class MessageIdentifierAdder

    Private Data aMessages as array
    Private Data oStatement as object

    Public Method new() Constructor
    Public Method getMessages() as array
    Public Method setMessages()
    Public Method createMessages(aMessages as array)
    Public Method exists(cCode as character) as logical
    Public Method destroy()

EndClass

/*/{Protheus.doc} MessageIdentifierAdder::new
Método construtor da classe MessageIdentifierAdder.
@type method
@version 12.1.2410
@author Juliano Fernandes
@since 30/04/2025
@return object, Objeto MessageIdentifierAdder
/*/
Method new() Class MessageIdentifierAdder
Return self

/*/{Protheus.doc} MessageIdentifierAdder::getMessages
Método que retorna os identificadores de mensagens a serem incluídos.
@type method
@version 12.1.2410
@author Juliano Fernandes
@since 30/04/2025
@return array, Retorna os identificadores de mensagens a serem incluídos
/*/
Method getMessages() as array Class MessageIdentifierAdder
Return self:aMessages

/*/{Protheus.doc} MessageIdentifierAdder::setMessages
Método que define os identificadores de mensagens a serem incluídos.
@type method
@version 12.1.2410
@author Juliano Fernandes
@since 30/04/2025
/*/
Method setMessages() Class MessageIdentifierAdder

    self:aMessages := {}

    /* Exemplo de dados a serem incluídos
    Aadd(self:aMessages,{                                                                   ;
        '0000000001',                                                                       ; // [1] CK6_CODIGO
        'Código da informação complementar (Tabela de Informações Complementares do Sped)', ; // [2] CK6_DESC
        '01',                                                                               ; // [3] CK6_OBRACE (01=SPED Fiscal | 02=EFD Contribuições | 03=NF-e)
        'Registro 0450',                                                                    ; // [4] CK6_FINALI
        'SPED_FISCAL_REGISTRO_0450_COD_INF'                                                 ; // [5] CK6_ID (CK6_OBRACE + CK6_FINALI)
    })
    */

Return

/*/{Protheus.doc} MessageIdentifierAdder::createMessages
Método que inclui os identificadores de mensagens na tabela CK6.
@type method
@version 12.1.2410
@author Juliano Fernandes
@since 30/04/2025
@param aMessages, array, Array contendo os identificadores de mensagens a serem incluídos
/*/
Method createMessages(aMessages as array) Class MessageIdentifierAdder

    Local i as integer

    Default aMessages := self:aMessages

    For i := 1 To Len(aMessages)
        If ( !self:exists(aMessages[i][1]) )
            Reclock('CK6',.T.)

            CK6->CK6_FILIAL := FWxFilial('CK6')
            CK6->CK6_CODIGO := aMessages[i][1]
            CK6->CK6_DESC := aMessages[i][2]
            CK6->CK6_OBRACE := aMessages[i][3]
            CK6->CK6_FINALI := aMessages[i][4]
            CK6->CK6_ID := aMessages[i][5]
            CK6->CK6_PROPRI := '0' // 0=Sistema;1=Usuário

            CK6->(MsUnlock())
        EndIf
    Next i

Return

/*/{Protheus.doc} MessageIdentifierAdder::exists
Método que verifica se o identificador de mensagem já existe na tabela CK6.
@type method
@version 12.1.2410
@author Juliano Fernandes
@since 30/04/2025
@param cCode, character, Código do identificador de mensagem a ser verificado
@return logical, Retorna .T. se o identificador de mensagem já existir, caso contrário retorna .F.
/*/
Method exists(cCode as character) as logical Class MessageIdentifierAdder

    Local cQry as character

    If ( self:oStatement == Nil )
        cQry += ' SELECT CK6_CODIGO '
        cQry += ' FROM ' + RetSQLName('CK6')
        cQry += ' WHERE CK6_FILIAL = ? '
        cQry += '     AND CK6_CODIGO = ? '
        cQry += '     AND D_E_L_E_T_ = ? '

        self:oStatement := FWExecStatement():New(ChangeQuery(cQry))
    EndIf

    self:oStatement:SetString(1, FWxFilial('CK6'))
    self:oStatement:SetString(2, cCode)
    self:oStatement:SetString(3, ' ')
   
Return !Empty(self:oStatement:ExecScalar('CK6_CODIGO'))

/*/{Protheus.doc} MessageIdentifierAdder::destroy
Método destrutor da classe MessageIdentifierAdder.
@type method
@version 12.1.2410
@author Juliano Fernandes
@since 30/04/2025
/*/
Method destroy() Class MessageIdentifierAdder

    If ( self:aMessages != Nil )
        ASize(self:aMessages, 0)
        self:aMessages := Nil
    EndIf

    If ( self:oStatement != Nil )
        self:oStatement:Destroy()
        self:oStatement := Nil
    EndIf

Return
