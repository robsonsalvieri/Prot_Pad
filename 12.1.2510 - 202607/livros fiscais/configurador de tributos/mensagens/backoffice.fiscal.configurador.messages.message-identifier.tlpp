#Include 'Protheus.ch'
#Include 'FWMBrowse.ch'
#Include 'FWMVCDef.ch'
#Include 'MessageIdentifier.ch'
#Include 'tlpp-core.th'

Namespace totvs.protheus.backoffice.fiscal.configurador.messages.messageidentifier

Static cProgram := 'totvs.protheus.backoffice.fiscal.configurador.messages.messageidentifier.messageIdentifier'
Static lIndMsgSpd :=  FindFunction("IndMsgSpd") // função do time de arquivos para opções da finalidade para a EFD ICMS/IPI
Static lIndMsgDFe :=  FindFunction("IndMsgDFe") // função do time de TSS para opções da finalidade para a DF-e

/*/{Protheus.doc} messageIdentifier
Função que cria o cadastro de Identificadores de Mensagens.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 24/04/2025
/*/
Function messageIdentifier()

    Local oBrowse as object

    If ( AliasIndic('CK6') ) .and. (lIndMsgSpd .or. lIndMsgDFe) .and. (CK6->(FieldPos("CK6_OBRACE")) > 0)
        oBrowse := FWMBrowse():New()
        oBrowse:SetAlias('CK6')
        oBrowse:SetDescription(STR0001) // 'Cadastro de Identificadores de Mensagens'
        oBrowse:Activate()
    Else
        Help('',1,'Help','Help',STR0002,1,0) // 'Dicionário desatualizado, verifique as atualizações do motor tributário fiscal.'
    EndIf

Return

/*/{Protheus.doc} menuDef
Função que cria o menu dos Identificadores de Mensagens.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 24/04/2025
@return array, Menu dos Identificadores de Mensagens
/*/
Function menuDef() as array
Return FWMVCMenu(cProgram)

/*/{Protheus.doc} modelDef
Função que cria o modelo de dados dos Identificadores de Mensagens.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 24/04/2025
@return object, Modelo de Dados dos Identificadores de Mensagens
/*/
Function modelDef() as object

    Local oModel as object
    Local oStruct as object

    // Cria o objeto do Modelo de Dados
    oModel := MPFormModel():New('MESSAGEIDENTIFIER',,{|oModel| postValidation(oModel)},{|oModel| saveMessageIdentifier(oModel)})

    oStruct := FWFormStruct(1,'CK6')

    //oStruct:SetProperty('CK6_FINALI',MODEL_FIELD_VALID,{|| validCK6FINALI()})

    // Adiciona ao modelo uma estrutura de formulário de edição por campo
    oModel:AddFields('MESSAGEIDENTIFIER',,oStruct)

    oModel:SetPrimaryKey({'CK6_FILIAL','CK6_CODIGO'})

    // Adiciona a descricao do Modelo de Dados
    oModel:SetDescription(STR0001) // 'Cadastro de Identificadores de Mensagens'

Return oModel

/*/{Protheus.doc} viewDef
Função que cria a View dos Identificadores de Mensagens.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 24/04/2025
@return object, View dos Identificadores de Mensagens
/*/
Function viewDef() as object

    Local oModel := FWLoadModel(cProgram) as object
    Local oView := FWFormView():New() as object
    Local oStruct as object
    Local aValues as array

    // Define qual o Modelo de dados será utilizado
    oView:SetModel(oModel)

    oStruct := FWFormStruct(2,'CK6')

    aValues := oStruct:getProperty('CK6_OBRACE', MVC_VIEW_COMBOBOX)

    oStruct:RemoveField('CK6_PROPRI')
    oStruct:RemoveField('CK6_ID')

    oStruct:SetProperty('CK6_CODIGO',MVC_VIEW_TITULO,STR0003) // 'Código do Identificador'
    oStruct:SetProperty('CK6_DESC',MVC_VIEW_TITULO,STR0004) // 'Descrição do Identificador'
    oStruct:SetProperty('CK6_OBRACE', MVC_VIEW_COMBOBOX, obraceComboValues(aValues))

    // Adiciona no nosso View um controle do tipo FormFields(antiga enchoice)
    oView:AddField('VIEW_MESSAGEIDENTIFIER',oStruct,'MESSAGEIDENTIFIER')

    oView:EnableTitleView('VIEW_MESSAGEIDENTIFIER',STR0001) // 'Cadastro de Identificadores de Mensagens'

    oView:SetFieldAction('CK6_OBRACE', { |oView| setId(oView), tagRegComboValues(oView) })
    oView:SetFieldAction('CK6_FINALI', { |oView| setId(oView) })

    oView:SetAfterViewActivate({ |oView| tagRegComboValues(oView) })

Return oView

/*/{Protheus.doc} postValidation
Função que valida o registro após a edição.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 07/05/2025
@param oModel, object, Modelo de Dados dos Identificadores de Mensagens
@return logical, Retorna .T. se a validação for bem sucedida, caso contrário retorna .F.
/*/
Static Function postValidation(oModel as object) as logical

	Local lValid := .T. as logical

    If ( oModel:GetOperation() != MODEL_OPERATION_INSERT .And. oModel:GetValue('MESSAGEIDENTIFIER','CK6_PROPRI') == '0' ) // 0=Sistema
        lValid := .F.
        Help(,,'Help',,STR0005,1,0)  // 'Não é possível modificar Identificadores de Mensagem gerados pelo sistema.'
    EndIf

Return lValid

/*/{Protheus.doc} saveMessageIdentifier
Função que salva o registro do Identificador de Mensagens.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 07/05/2025
@param oModel, object, Modelo de Dados dos Identificadores de Mensagens
@return logical, Retorna .T. se o registro for salvo com sucesso
/*/
Static Function saveMessageIdentifier(oModel as object) as logical

	Local nOperation := oModel:GetOperation() as numeric

	Begin Transaction

		Do Case
			Case nOperation == MODEL_OPERATION_INSERT
				createMessageIdentifier(oModel)
			Case nOperation == MODEL_OPERATION_UPDATE
				updateMessageIdentifier(oModel)
			Case nOperation == MODEL_OPERATION_DELETE
				deleteMessageIdentifier(oModel)
		EndCase

	End Transaction

Return .T.

/*/{Protheus.doc} createMessageIdentifier
Função que cria o registro do Identificador de Mensagens.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 07/05/2025
@param oModel, object, Modelo de Dados dos Identificadores de Mensagens
/*/
Static Function createMessageIdentifier(oModel as object)

	CK6->(Reclock('CK6',.T.))

	CK6->CK6_FILIAL := FWxFilial('CK6')
	CK6->CK6_CODIGO := oModel:GetValue('MESSAGEIDENTIFIER','CK6_CODIGO')
	CK6->CK6_DESC := oModel:GetValue('MESSAGEIDENTIFIER','CK6_DESC')
	CK6->CK6_PROPRI := '1' // 1=Usuário
    CK6->CK6_OBRACE := oModel:GetValue('MESSAGEIDENTIFIER','CK6_OBRACE')
    CK6->CK6_FINALI := oModel:GetValue('MESSAGEIDENTIFIER','CK6_FINALI')
    CK6->CK6_ID := oModel:GetValue('MESSAGEIDENTIFIER','CK6_ID')

	CK6->(MsUnlock())

Return

/*/{Protheus.doc} updateMessageIdentifier
Função que atualiza o registro do Identificador de Mensagens.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 07/05/2025
@param oModel, object, Modelo de Dados dos Identificadores de Mensagens
/*/
Static Function updateMessageIdentifier(oModel as object)

	CK6->(Reclock('CK6',.F.))

	CK6->CK6_DESC := oModel:GetValue('MESSAGEIDENTIFIER','CK6_DESC')
    CK6->CK6_OBRACE := oModel:GetValue('MESSAGEIDENTIFIER','CK6_OBRACE')
    CK6->CK6_FINALI := oModel:GetValue('MESSAGEIDENTIFIER','CK6_FINALI')
    CK6->CK6_ID := oModel:GetValue('MESSAGEIDENTIFIER','CK6_ID')

	CK6->(MsUnlock())

Return

/*/{Protheus.doc} deleteMessageIdentifier
Função que deleta o registro do Identificador de Mensagens.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 07/05/2025
@param oModel, object, Modelo de Dados dos Identificadores de Mensagens
/*/
Static Function deleteMessageIdentifier(oModel as object)

	CK6->(Reclock('CK6',.F.))

	CK6->(DbDelete())

	CK6->(MsUnlock())

Return

/*/{Protheus.doc} setId
Função que define o ID do Identificador de Mensagens.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 10/07/2025
@param oModel, object, Modelo de Dados dos Identificadores de Mensagens
@return uRet, Nil, sem retorno
/*/
Static Function setId(oView as object)
	Local oMessageIdentifier := oView:GetModel():GetModel("MESSAGEIDENTIFIER") as object
	Local cAncillaryObligation := oMessageIdentifier:GetValue('CK6_OBRACE') as character
	Local cPurpose := oMessageIdentifier:GetValue('CK6_FINALI') as character
	Local cId as character

	If ( !Empty(cAncillaryObligation) .And. ;
         !Empty(cPurpose))

        cId := StrTran(Upper(getAncillaryObligationDescription(cAncillaryObligation) + '_' + AllTrim(cPurpose)),' ','_')
        oMessageIdentifier:SetValue('CK6_ID',cId)
        oView:Refresh()
	EndIf
Return

/*/{Protheus.doc} getAncillaryObligationDescription
Função que retorna a descrição da Obrigação Acessória.
@type function
@version 12.1.2410
@author Juliano Fernandes
@since 10/07/2025
@param cAncillaryObligationCode, character, Código da Obrigação Acessória
@return character, Descrição da Obrigação Acessória
/*/
Static Function getAncillaryObligationDescription(cAncillaryObligationCode as character) as character
    Local aCombo as array
    Local nPos as numeric
    Local cAncillaryObligationDescription as character

    /*
        Retorna um array multidimensional onde cada elemento tem 3 posições, sendo:
        [1] Opção completa (ex. F=Fisica)
        [2] Código da opção (ex. F)
        [3] Descrição da opção (ex. Fisica)
    */
    aCombo := RetSX3Box(GetSX3Cache('CK6_OBRACE','X3_CBOX'),,,1)

    If ( (nPos := AScan(aCombo,{|aX| cAncillaryObligationCode + '=' == Left(aX[1],3)})) > 0 )
        cAncillaryObligationDescription := aCombo[nPos,3]
    EndIf

    FwFreeArray(aCombo)

Return Alltrim(cAncillaryObligationDescription)


/*/{Protheus.doc} obraceComboValues
    Retorna as opções para o campo CK6_OBRACE conforme a existência das funções
    criadas pelos outros times para preenchimento das opções do campo CK6_FINALI.

    Caso alguma função não exista, se tira a opção equivalente no campo CK6_OBRACE.

    Exemplo:
        O campo CK6_OBRACE é um combo box com 3 opções definidas diretamente no
        dicionário. Esse campo se relaciona diretamente com CK6_FINALI.
        Quando se escolhe uma opção de CK6_OBRACE se carrega opções de combo box
        equivalentes em CK6_FINALI. Porém, pode ser que não haja implementado as
        opções equivalentes em CK6_FINALI. Para evitar problemas, essa função
        mantém apenas as opções em CK6_OBRACE que tenham correspondentes implementados
        em CK6_FINALI.

    @type  Function
    @author anedino.santos
    @since 07/10/2025
    @version 12.1.2510
    @param aValues, array, lista de opções do campo CK6_OBRACE
    @return aRet, array, nova lista de opções para o campo CK6_OBRACE
/*/
function obraceComboValues(aValues as array)
    local aRet := {}

    if lIndMsgSpd // se existir a função de arquivos para opções do campo Finalidade referente a EFD ICMS/IPI
        // mantém no CK6_OBRACE a opção 01
        aAdd(aRet, aValues[1])
    endIf

    if lIndMsgDFe // se existir a função do TSS para opções do campo Finalidade referente a DF-e
        // mantém no CK6_OBRACE a opção 03
        aAdd(aRet, aValues[3])
    endif

    aAdd(aRet, aValues[4])

return aRet



/*/{Protheus.doc} tagRegComboValues
    Retorna as opções para o campo CK6_FINALI conforme escolha do campo CK6_OBRACE.

    @type  Function
    @author anedino.santos
    @since 07/10/2025
    @version 12.1.2510
    @param oView, object, objeto da view MVC
    @return aValues, array, lista com as opções disponíves para o campo
/*/
Function tagRegComboValues(oView as object)
    Local aValues := {}
    Local oModel := Nil
    Local nOperation := Nil
    Local cValue := ""

    if (lIndMsgSpd .or. lIndMsgDFe)
        if (ValType(oView) == "O" .and. oView:IsActive())
            oModel :=  oView:getModel()
            nOperation := oModel:getOperation()
            cOpt := oModel:getModel("MESSAGEIDENTIFIER"):getValue("CK6_OBRACE")

            if Empty(cOpt)
                return tagRegAllComboValues()
            ElseIf cOpt $ "01" .and. lIndMsgSpd // Função de arquivos para se obter as opções do EFD ICMS/IPI
                aValues := IndMsgSpd()
            Elseif cOpt $ "03" .and. lIndMsgDFe // Função do TSS para se obter as opções
                aValues := IndMsgDFe()
            Endif

            if nOperation == MODEL_OPERATION_UPDATE
                cValue := AllTrim(oModel:getModel("MESSAGEIDENTIFIER"):getValue("CK6_FINALI"))
            endif

            oView:SetFieldProperty("VIEW_MESSAGEIDENTIFIER","CK6_FINALI","COMBOVALUES",{aValues})

            if !Empty(cValue)
                oModel:getModel("MESSAGEIDENTIFIER"):setValue("CK6_FINALI", cValue)
            endif

            oView:Refresh()
        // é preciso ter todos os valores possíveis nas opções se não a validação
        // nativa do modelo para campos combobox irá impedir a gravação
        else
            return tagRegAllComboValues()
        endif
    endif
Return aValues


/*/{Protheus.doc} tagRegAllComboValues
    Retorna todas as  opções dispopníveis para o campo CK6_FINALI conforme funções
    dos outros times (Arquivos e TSS).

    @type  Function
    @author anedino.santos
    @since 07/10/2025
    @version 12.1.2510
    @return cValues, character, string com todas as opções disponíves para o campo
/*/
static function tagRegAllComboValues()
    local cRet as character

    if lIndMsgSpd
        cRet += ArrTokStr(IndMsgSpd(), ";")+";"
    endif

    if lIndMsgDFe
        cRet += ArrTokStr(IndMsgDFe(), ";")+";"
    endif

return cRet


/*/{Protheus.doc} validatePurpose
    Valida as opções disponíveis para o campo CK6_FINALI. Essa função tem como
    propósito principal ser utilizada no valid do campo direto no dicionário.
    Caso as possíveis opções não sejam carregadas, deixa aberto para se colocar qualquer valor.

    @type  Function
    @author anedino.santos
    @since 05/11/2025
    @version 12.1.2510
    @return lRet, logical, retorna se o valor do campo pertence às opções disponíveis no combobox
/*/
function validatePurpose()
    local aCombo := StrTokArr(tagRegAllComboValues(), ";")
    local nI := 0
    local cPertence := ""

    // Caso não venha nada em aCombo quer dizer que não foi encontrada as funções dos outros times para o campo de Finalidade.
    // Desta forma o campo de finalidade fica aberto para se colocar o que quiser.
    // if len(aCombo) == 0
    //     return .T.
    // endif

    // Aqui extraímos as opções e validamos com as opções possíveis.
    // Fazemos isso para evitar que o campo fique em branco.
    for nI := 1 to len(aCombo)
        // extrai o numeral da opção adicionando espaço pois o campo tem tamanho 2
        cPertence += StrTokArr(aCombo[nI], "=")[1] + " "
    next nI
    FwFreeArray(aCombo)
return Pertence(cPertence)
