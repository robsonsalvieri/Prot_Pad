#include "tlpp-core.th"
#include "totvs.ch"
#include "fileio.ch"

#DEFINE _BUFFER     	 16384
#DEFINE _SEPARADOR		CHR(59) // ;
#DEFINE _SEPA2		    CHR(44) // ;
#define	_PERIODO  1
#DEFINE _CUIT 2
#DEFINE _RAZONSOC 3
#DEFINE _JURIS    4
#DEFINE _CRC      5
#DEFINE _ALIC     6
#DEFINE _CAMPO7   7


Static cMes        := StrZero(Month(dDataBase),2)
Static cMesIni	   := StrZero(Month(dDataBase),2)
Static cAnoIni	   := StrZero(Year(dDataBase),4)
Static cTabEqAliq  := Space(5) 
Static cTabEqJur   := Space(5) 
Static cTabEqPosJ  := Space(5) 
Static cFile     := ""
Static dDataIni  := CTOD("\\")
Static dDataFim  := CTOD("\\")
Static lFor      := .F.
Static lCli      := .F.
Static lImp      := .F.
Static cAliasPdr := GetNextAlias()
Static cSA1      := ""
Static cSA2      := ""
Static oQryExFech:= Nil
Static oBulkSFH		:= Nil
Static nTamNome		:= GetSX3Cache("FH_NOME","X3_TAMANHO")
Static oJTabAliq	:=  JsonObject():New() 
Static oJTabJuris	:=  JsonObject():New() 
Static oJTabPosJ	:=  JsonObject():New() 
Static oJSFB		:=  JsonObject():New() 

/**Variables para usar en exportación**/
Static	dPedIni	:=	dDataBase
Static	dPedFin	:=	dDataBase
Static	cDesdeProv	:=	""
Static	cHastaProv	:=	""
Static	cDesdeCli	:=	""
Static	cHastaCli	:=	""
Static	cDesdeLoja	:=	""
Static	cHastaLoja	:=	""
Static	cDir		:=	""
Static	cNombArch	:=	""
Static	cCliPadr	:=	0
Static	nSelSuc		:=	0
Static	nAglu		:=	0


Static	oTmpTable1  := NiL
Static  cTRBn       :=GetNextAlias()

/***/

/*/{Protheus.doc} FISA848
    Lanza la pantalla para introducir información del padron a cargar
    @type  Function
    @author adrian.perez
    @since 20/05/2026
  	@param cFileSel , character, Archivo a ser utilizado para carga del padrón (Uso para automatizados)
    @param cTipoSel, character, Selección del clientes o proveedores (Uso para automatizados) - Opción de aCombo
    @param cMesSel , character, Mes de carga del padrón (Uso para automatizados)
    @param cAnoSel , character, Año de carga del padrón (Uso para automatizados)
    @param aTab , array  , Indica tablas de equivalencia (Uso para automatizados)
   
	@return nil
    /*/  

Function FISA848(cFileSel, cTipoSel, cMesSel, cAnoSel,aTab,nOp)

	
	Local aCombo	:= {}
	Local oDlg		:= Nil
	Local oFld		:= Nil
	Local oCombo	:= Nil
	Local lAutomato := IsBlind()
	
	DEFAULT cFileSel	:= ""
	DEFAULT cTipoSel:= ""
	DEFAULT cMesSel	:= ""
	DEFAULT cAnoSel	:= ""
	DEFAULT aTab	:= {}
	DEFAULT nOp		:= 1
	

	aAdd( aCombo, STR0002 ) //"1- Proveedor"
	aAdd( aCombo, STR0003 ) //"2- Cliente"
	aAdd( aCombo, STR0004 ) //"3- Ambos  "


IF fValDicc()

	If !lAutomato

		//Pimer pantalla
			DEFINE MSDIALOG oDlg TITLE STR0005 FROM -10,0 TO 300,555 PIXEL // Ventana más pequeña

			@ 006,006 TO 0150,275 LABEL STR0005 OF oDlg PIXEL //STR0005 SIRCIP"
			@ 025,020 SAY STR0078 SIZE 240,210 PIXEL OF oFld // STR0078 "SIRCIP (Sistema Informático de Recaudación, Control e Información de Agentes de Percepción) es un sistema que tiene como objetivo armonizar y simplificar los regimenes de percepción locales del impuesto sobre los Ingresos Brutos de las jurisdicciones adheridas.      "

			@ 055,020 SAY STR0079 SIZE 240,210 PIXEL OF oFld // STR0079 "Con la nueva legislación SIRCIP se agrega las funcionalidades principales: 1. Importación del Padrón SIRCIP y 2. Exportación de datos para SIRCIP    " 
		
			 


			@ 090,030 BUTTON STR0016 SIZE 060,020 PIXEL OF oDlg ACTION fImportar() // Importar

			@ 090,110 BUTTON STR0059 SIZE 060,020 PIXEL OF oDlg ACTION fExportar() // Exportar

			@ 090,190 BUTTON STR0017 SIZE 060,020 PIXEL OF oDlg ACTION oDlg:End() // Salir

			ACTIVATE MSDIALOG oDlg CENTER
		// fin primer pantalla

			FwFreeObj(oDlg)
			FwFreeObj(oFld)
			FwFreeObj(oCombo)
	Else
		cMesIni := cMesSel
		cAnoIni := cAnoSel
		IF nOp==1
			cFile   := cFileSel
			cTabEqAliq :=aTab[1]
			cTabEqJur := aTab[2]
			cTabEqPosJ:= aTab[3]
			ImpArq(aCombo, cTipoSel)
		ELSE
			fExportar()
		ENDIF

	EndIF
		

		FreeObj(oJTabAliq)
		FreeObj(oJTabJuris)	
		FreeObj(oJTabPosJ)	
		FreeObj(oJSFB)	
		
		aSize(aCombo,0)

ENDIF

Return Nil



/*/{Protheus.doc} ImpArq
    Inicializa la importación del archivo
    @type  Function
    @author adrian.perez
    @since 20/05/2026
    @param  aCombo, array ,    combo cliente/proveedor amnos.
    @param  cCombo, character, opción seleccionado
    @return nil
    /*/  

Static Function ImpArq(aCombo, cCombo)

	Local   nPos        := 0
	Local 	lAutomato   := IsBlind()
	Local  	cStartPath 	:= GetSrvProfString("StartPath","")
	Local 	cExt		:= ""
	Local 	cNewFile	:= ""
	Local	lCopy		:= .F.
	Local   lRet		:=.T.
	Local   name1	    :=NIL
	Local   name2	    :=NIL
	Local   name3	    :=NIL
	
	Default aCombo		:= {}
	Default cCombo		:= ""

	cCombo := Substr(AllTrim(cCombo),1,1)
	nPos := aScan(aCombo,{|x| Substr(AllTrim(x),1,1) == cCombo})
	
	If nPos == 1 		// proveedor
		lFor := .T.
		lCli := .F.
	ElseIf nPos == 2 	// Cliente
		lCli := .T.
		
		lFor := .F.
	ElseIf nPos == 3 	// Ambos
		lFor := .T.
		lCli := .T.
		
	EndIf
	oJTabAliq:= getDataEq(cTabEqAliq)
	oJTabJuris:=getDataEq(cTabEqJur)
	oJTabPosJ:= getDataEq(cTabEqPosJ)
	
	If !lAutomato
		cFile := FGetFile()
		cStartPath := StrTran(cStartPath,"/","\")
		If !(Right(cStartPath,1)=="\")
			cStartPath += "\"
		EndIf
		If !Empty(cFile) 	
			If !(cFile $ cStartPath)
				If ":" $ cFile
					SplitPath(cFile,/*cDrive*/,/*cPath*/, @cNewFile,@cExt)
					If CpyT2S(cFile, cStartPath,.T.)
						lCopy:=.T.
						cFile := cStartPath + cNewFile + cExt
					ENDIF
				Endif
			EndIf
		EndIF
	EndIf
	If Empty(cFile)
		MsgStop(STR0024) //STR0024 "Seleccione un archivo e intente nuevamente."
		Return Nil
	EndIf

	If !File(cFile)
		MsgStop(STR0034) //STR0034 'No existe archivo'
		Return Nil
	EndIf
    
	
	
	name1 :=oJTabAliq:GetNames()
	name2 :=oJTabJuris:GetNames()
	name3 :=oJTabPosJ:GetNames()
	IF (len(name1)==0 ).OR. (len(name2)==0 ).OR. (len(name3)==0)
		lRet:=.F.
	ENDIF
	IF lRet
		If VldArch() 
			If !lAutomato
				MsAguarde({|| Import(cFile)} ,STR0018,STR0019 ,.T.) //"STR0018 Leyendo archivo, espere... STR0019 'Actualización de registros'
			Else
				Import(cFile)
			EndIf
		EndIf

		If lCopy
			FERASE(cFile)
		EndIf

		If (lImp ) .and. !lAutomato
			MsgAlert(STR0021,"") //STR0021 '¡Datos importados!'
			lImp:=.F.
		EndIf
		IF oQryExFech!=NIL
			oQryExFech:Destroy()
			oQryExFech:=Nil
		ENDIF
		
	endif
Return Nil


/*/{Protheus.doc} FGetFile
    Pantalla para seleccionar archivo
    @type  Function
    @author adrian.perez
    @since 20/05/2026
    @return cRet,character, directorio del archivo seleccionado.
    /*/  

Static Function FGetFile()
	Local oDlg01 := Nil
	Local oGet01 := Nil
	Local oBtn01 := Nil
	Local oBtn02 := Nil
	Local oBtn03 := Nil
	Local cRet := Space(50)

	oDlg01 := MSDialog():New(000,000,100,500,STR0022,,,,,,,,,.T.)//STR0022 "Selecionar archivo"

	oGet01 := TGet():New(010,010,{|u| If(PCount()>0,cRet:=u,cRet)},oDlg01,215,10,,,,,,,,.T.,,,,,,,,,,"cRet")
	oBtn01 := TBtnBmp2():New(017,458,025,028,"folder6","folder6",,,{|| FGetDir(oGet01)},oDlg01,STR0022,,.T.)// STR0022 "Selecionar archivo"

	oBtn02 := SButton():New(035,185,1,{|| oDlg01:End() }         ,oDlg01,.T.,,)
	oBtn03 := SButton():New(035,215,2,{|| cRet:="",oDlg01:End() },oDlg01,.T.,,)

	oDlg01:Activate(,,,.T.,,,)

	FwFreeObj(oDlg01)
	FwFreeObj(oGet01)
	FwFreeObj(oBtn01)
	FwFreeObj(oBtn02)
	FwFreeObj(oBtn03)

Return cRet


/*/{Protheus.doc} FGetDir
    Pantalla para buscar y seleccionar el archivo en los directorios
    locais/servidor/unidades mapeadas.
    @type  Function
    @author adrian.perez
    @since 20/05/2026
    @param  oTGet, object, TGet que ira receber o local e o arquivo
    @return nil
    /*/  
Static Function FGetDir(oTGet)

	Local cDir := ""

	DEFAULT oTGet := Nil

	cDir := cGetFile(,STR0022,,,.T.,GETF_LOCALFLOPPY+GETF_LOCALHARD+GETF_NETWORKDRIVE)//STR0022 "Selecionar archivo"
	If !Empty(cDir)
		oTGet:cText := cDir
		oTGet:Refresh()
	Endif
	oTGet:SetFocus()

Return Nil


/*/{Protheus.doc} VldArch
    Validacion del archivo
    @type  Function
    @author adrian.perez
    @since 20/05/2026    
    @return logical, .F. si genera error
    /*/  

Static Function VldArch()

	Local cErro		:= STR0023 //STR0023 'Ocurrió un error al procesar un registro seleccionado. Verifique si el contenido está correcto e intente nuevamente.'
	Local cSolucao 	:= STR0024 //STR0024 "Seleccione un registro e intente nuevamente."
	Local cTitulo	:= STR0001 //STR0001 "Atención"
	Local oFile		:= Nil
	Local cLine		:=""
	Local aAux		:={}
	
	oFile := FWFileReader():New(cFile)
	if (oFile:Open())
		If oFile:hasLine()
			cLine:=oFile:GetLine()
			aAux:= StrTokArr2(cLine,_SEPARADOR)
			If !(_SEPARADOR $ (cLine)) .OR. LEN(aAux[1]) <>6 .OR. LEN(aAux)!=7 .OR. Empty(aAux[7]) 
				xMagHelpFis(cTitulo,cErro,cSolucao)
				Return .F.
			EndIf
			IF SubStr(StrTokArr2(cLine,_SEPARADOR)[_PERIODO],5,2)!=cMesIni .OR. cAnoIni !=SubStr(StrTokArr2(cLine,_SEPARADOR)[_PERIODO],1,4)
				xMagHelpFis(cTitulo,STR0028, STR0028) //STR0028 "Periodo no coincide entre padrón e informado"  //STR0029 "Verifique periodo"
				Return .F.
			EndIF
		EndIf
	EndIf


	dDataIni := CTOD("01/"+cMesIni+"/"+cAnoIni)
	dDataFim := LastDay(dDataIni)
	oFile:Close()
	FwFreeObj(oFile)
	aSize(aAux,0)

Return .T.


/*/{Protheus.doc} Import
    Función para realizar la importación del archivo.
    @type  Function
    @author adrian.perez
    @since 21/05/2026
    @param  cFile, character, archivo a ser importado
    @return lReturn,logical, Indica si se completo el proceso.
    /*/  

Static Function Import(cFile)

	Local lReturn   	:= .T.
	Local lAutomato 	:= IsBlind()

	DEFAULT cFile		:= ""

	If F848LeePad(cFile)
		If !lAutomato
			Processa({|| lReturn := GeraTemp(cFile)})
		Else
			lReturn := GeraTemp(cFile)
		EndIf
	EndIf

Return lReturn


/*/{Protheus.doc} GeraTemp
    Función para realizar la busqueda de todos los proveedores y clientes para verificar si existe en el archivo TXT de importación.
    @type  Function
    @author adrian.perez
    @since 20/05/2026
    @param  cArqProc , character, archivo a ser importado
    @return  lReturn,	logical  , retorna .T. si la importación no tuvo errores.
    /*/  

Static Function GeraTemp(cArqProc)
	
	Local cQuery	 := ""
	Local cCGCEmp	 := FWArrFilAtu()[18] // SM0->M0_CGC
	Local lReturn    := .T.
	Local nParamA1   := 1
	Local nParamA2   := 1
	Local oQryExecA1 := Nil
	Local oQryExecA2 := Nil
	Local nTotal	 := 0
	Local aCampo7	 :={}
	Local nI		 :=0
	Local cAuxJus	 :=""
	Local cAuxProv   :=""
	Local cTipo      :=""
	Local aNames       :=  {}

	Default cArqProc := ""

	IF lCli .OR. lFor
		
		oJSFB	 := getDataSFB()
		aNames	 :=oJSFB:GetNames()
	ENDIF
	IF LEN(aNames)>0
		If lCli
			cQuery := ""
			cQuery := "SELECT A1.A1_COD, A1.A1_LOJA, A1.A1_CGC, A1.A1_NOME , A1.A1_EST"
			cQuery += "FROM                         "+RetSqlName("SA1")+" A1 "
			cQuery += " WHERE A1.A1_FILIAL        = ?    "
			cQuery += "   AND A1.A1_CGC          <> ?    "
			cQuery += "   AND A1.D_E_L_E_T_       = ?    "
			cQuery += " ORDER BY A1.A1_CGC  ASC          "
			cQuery := ChangeQuery(cQuery)
			oQryExecA1 := FwExecStatement():New(cQuery)
			oQryExecA1:SetString(nParamA1++, xFilial("SA1"))
			oQryExecA1:SetString(nParamA1++, Space(1))
			oQryExecA1:SetString(nParamA1++, Space(1))
			cSA1 := oQryExecA1:OpenAlias()
		
		EndIf

		If lFor
			cQuery := ""
			cQuery := "SELECT A2.A2_COD, A2.A2_LOJA, A2.A2_CGC, A2.A2_NOME"
			cQuery += "FROM                           "+RetSqlName("SA2")+" A2 "
			cQuery += " WHERE A2.A2_FILIAL          = ?    "
			cQuery += "   AND A2.A2_CGC            <> ?    "
			cQuery += "   AND A2.D_E_L_E_T_         = ?    "
			cQuery := ChangeQuery(cQuery)
			oQryExecA2 := FwExecStatement():New(cQuery)
			oQryExecA2:SetString(nParamA2++, xFilial("SA2"))
			oQryExecA2:SetString(nParamA2++, Space(1))
			oQryExecA2:SetString(nParamA2++, Space(1))
			cSA2 := oQryExecA2:OpenAlias()
			
		EndIf

	
	
		nTotal := F848TotReg(lCli, lFor)
		ProcRegua(nTotal)
		oBulkSFH := FwBulk():New(RetSqlName("SFH"),1000)
		oBulkSFH:setFields({  {"FH_FILIAL"}, {"FH_AGENTE"}, {"FH_ZONFIS"}, ;
							{"FH_FORNECE"},{"FH_CLIENTE"}, {"FH_LOJA"},  ;
							{"FH_NOME"}, {"FH_IMPOSTO"}, {"FH_PERCIBI"}, ;
							{"FH_ISENTO"}, {"FH_APERIB"}, {"FH_ALIQ"},   ;
							{"FH_PERCENT"}, {"FH_TIPO"}, {"FH_INIVIGE"}, ;
							{"FH_FIMVIGE"}, {"FH_COEFMUL"}, {"FH_SITUACA"},;
							{"FH_PADSIR"} , {"FH_CRC"} , {"FH_LETALI"},; 
							{"FH_CAMPO7"}, {"FH_ALIVNI"},{"FH_ALISIJ"},{"FH_ALICPC"};
							})
		
		
		If lCli 
			
			(cSA1)->(dbGoTop())
			
			While (cSA1)->(!EOF())
				IncProc(STR0018)  //"Procesando archivo..."
				If (cAliasPdr)->(MsSeek((cSA1)->A1_CGC))

					aCampo7	:=	getCampo7((cAliasPdr)->CAMPO7)
					cTipo	:=  getTipo(aCampo7,.T.)
				
					For nI := 2 To len(aCampo7)
						IF oJTabPosJ[cTabEqPosJ][ALLTRIM(str(nI))]!=NIL
							cAuxJus :=	oJTabPosJ[cTabEqPosJ][ALLTRIM(str(nI))]
							cAuxProv:=	oJTabJuris[cTabEqJur][cAuxJus]
							
							fCliPer(.T.,cAuxProv,(cAliasPdr)->CRC,(cAliasPdr)->ALIQ,aCampo7[nI],VAL(oJTabAliq[cTabEqAliq][(cAliasPdr)->ALIQ]),cTipo)
						EndIF	
					Next nI
				
				Else
				
					For nI := 1 To len(aNames)
						IF oJSFB[aNames[nI]]!=NIL
							IF oJSFB[aNames[nI]]["SIRCIP"]=="1" .AND. !Empty(oJSFB[aNames[nI]]["CCOZONFIS"])
								fCliPer(.F.,oJSFB[aNames[nI]]["CCOZONFIS"],"","","",0,"N")
								
							EndIF
						ENDIF
					Next
					
				EndIf
				
				(cSA1)->(dbSkip())
			Enddo


		EndIf
		If lFor
			IF lCli .AND. oQryExFech!=NIL
				oQryExFech:Destroy()// cuando es ambos deja fijo el campo FH_CLIENTE y no cambia a FH_FORNECE
				oQryExFech:=Nil
			ENDIF
			
			(cSA2)->(dbGoTop())

			If (cAliasPdr)->(MsSeek(cCGCEmp))
				aCampo7	:=	getCampo7((cAliasPdr)->CAMPO7)
				cTipo	:=  getTipo(aCampo7,.T.)
				Do While (cSA2)->(!EOF())
				IncProc(STR0018)  //"Procesando archivo..."

					For nI := 2 To len(aCampo7)
						IF oJTabPosJ[cTabEqPosJ][ALLTRIM(str(nI))]!=NIL
							cAuxJus :=	oJTabPosJ[cTabEqPosJ][ALLTRIM(str(nI))]
							cAuxProv:=	oJTabJuris[cTabEqJur][cAuxJus]
							
							fProvPer(.T.,cAuxProv,(cAliasPdr)->CRC,(cAliasPdr)->ALIQ,aCampo7[nI],VAL(oJTabAliq[cTabEqAliq][(cAliasPdr)->ALIQ]),cTipo)
						EndIF	
					Next nI
					(cSA2)->(dbSkip())
				EndDo
		
		
			Else
				Do While (cSA2)->(!EOF())
				IncProc(STR0018)  //"Procesando archivo..."
					
					For nI := 1 To len(aNames)
						IF oJSFB[aNames[nI]]!=NIL
							IF oJSFB[aNames[nI]]["SIRCIP"]=="1" .AND. !Empty(oJSFB[aNames[nI]]["CCOZONFIS"])
								fProvPer(.F.,oJSFB[aNames[nI]]["CCOZONFIS"],"","","",0,"N")
							EndIF
						ENDIF
					Next
				(cSA2)->(dbSkip())
				EndDo
			EndIf

				lImp := .T.
		EndIf
		
		SFH->(dbCloseArea())
		(cAliasPdr)->(dbCloseArea())
			
		//Se limpia el buffer para evitar que queden registros sin procesar en caso de que la cantidad de registros del archivo no sea múltiplo de la cantidad definida en el bulk.
		oBulkSFH:Flush()
		oBulkSFH:Close()
		oBulkSFH:Destroy()
		FwFreeObj(oBulkSFH)
		oBulkSFH := nil
		aSize(aNames,0)
		aSize(aCampo7,0)
	
		If lCli 
			(cSA1)->(dbCloseArea())
			oQryExecA1:Destroy()
			oQryExecA1:=Nil
		EndIf
		If lFor 
			(cSA2)->(dbCloseArea())
			oQryExecA2:Destroy()
			oQryExecA2:=Nil
		EndIf
	ELSE
		Help(" ",1,STR0032,,STR0080 + FWCodFil(),4,5)// // STR0032 "Atención"  //STR0080 Verificar configuraciones SFB y CCO en :
	ENDIF
	
Return(lReturn)



/*/{Protheus.doc} CreaTabla
    Función para realizar la geracion de la tabla temporal del padron con todos los datos del archivo TXT de importación.
    @type  Function
    @author adrian.perez
    @since 21/05/2026
    @param  cArqProc,	character, archivo a ser importado
    @return lRetu,		 logical, 	retorna .T. si la importación no tuvo errores.
    /*/  

Static Function CreaTabla(cArqProc)
	Local aInforma    := {} // Array auxiliar com as informacoes da linha lida no arquivo XLS
	Local cMsg        := STR0018 //STR0018 'Leyendo archivo, espere...'
	Local aStru     := {}
	Local lRetu       := .T.
	Local nTotArq     := 0
	Local nProcArq    := 0
	Local nPerProc    := 0
	Local oFile       := Nil
	Local oBulk       := Nil
	Local lCanUseBulk := .F.
	Local cIndex      := ""
	Local nTamRazonS  := 70

	DEFAULT cArqProc := ""

	AADD(aStru,{ "PERIODO"  ,"C", 6,   0}) //1
	AADD(aStru,{ "CUIT"     ,"C", 16,  0}) //2
	AADD(aStru,{ "RAZONSOC" ,"C", 70,  0}) //3
	AADD(aStru,{ "JURIS"    ,"C", 3,   0}) //4
	AADD(aStru,{ "CRC"      ,"C", 14,  0}) //5
	AADD(aStru,{ "ALIQ"     ,"C", 1,   0}) //6
	AADD(aStru,{ "CAMPO7"   ,"C", 25,   0}) //7



		If Select(cAliasPdr) <> 0
			(cAliasPdr)->(dbCloseArea())
		EndIf
		If TCCanOpen(cAliasPdr)
			If !TCDelFile(cAliasPdr)
				MsgAlert( STR0027 + TCSqlError() ) //STR0027 Error de borrado de tabla padrón.
				lRetu := .F.
			EndIf
		EndIf

		FWDBCreate(cAliasPdr, aStru , 'TOPCONN' , .T.)
		
		oFile := FWFileReader():New(cArqProc)
		oFile:Open()
		nTotArq := oFile:getFileSize()
		oBulk := FwBulk():New(cAliasPdr,600)
		lCanUseBulk := FwBulk():CanBulk() // Este método não depende da classe FWBulk ser inicializada por NEW
		If lCanUseBulk
			oBulk:SetFields(aStru)
			ProcRegua(100)
			while (oFile:hasLine())
				aInforma := StrTokArr2(oFile:GetLine(),_SEPARADOR)
				If Len(aInforma) == 7
				
					aInforma[_RAZONSOC] := Replace(PadR(aInforma[_RAZONSOC], nTamRazonS),'"',"")
					oBulk:AddData({;
						aInforma[_PERIODO],; 
						aInforma[_CUIT],;
						aInforma[_RAZONSOC],; 
						aInforma[_JURIS],; 
						aInforma[_CRC],;
						aInforma[_ALIC],;
						aInforma[_CAMPO7]})

						///
						aSize(aInforma,0)
						nProcArq := oFile:getBytesRead()
						nProcArq := NoRound((nProcArq*100)/nTotArq,0)
						If nProcArq > nPerProc
							nPerProc := nProcArq
							IncProc(cMsg + str(nProcArq) + "%")
						EndIf
				EndIf

			EndDo
			oBulk:Flush()
			oBulk:Close()
			oBulk:Destroy()
			oBulk := nil
		EndIf
		
		If Select(cAliasPdr) == 0
			DbUseArea(.T.,"TOPCONN",cAliasPdr,cAliasPdr,.T.)
			cIndex := cAliasPdr+"1"
			If ( !MsFile(cAliasPdr,cIndex, "TOPCONN") )
				DbCreateIndex(cIndex,"CUIT",{|| "CUIT" })
			EndIf
			Set Index to (cIndex)
		EndIf
		oFile:Close()	
		FwFreeObj(oFile)
		aSize(aInforma,0)
		aSize(aStru,0)

Return lRetu



/*/{Protheus.doc} fCliPer
    Función para realizar la buscqueda de verificaciones y actualización de los registros en la tabla SFH para clientes.
    @type  Function
    @author adrian.perez
    @since 20/05/2026
   	@param	lPadron	Lógico		Indica si se encuentra en el padrón.
	@param	cProv	Carácter 	Código de provincia. Se utiliza para buscar la configuración de impuestos en oJSFB.
	@param	cCRC	Carácter 	Código (CRC).
	@param	cLETALI	Carácter 	Letra de alícuota .
	@param	cCAMPO7	Carácter 	Campo7 Valores por Jurisdicción  .
	@param	nALICPC	Numérico	Alícuota base inicial que se usará para el cálculo del impuesto.
	@param	cTipo	Carácter	Tipo SFH

    @return nil
    /*/  

Static Function fCliPer(lPadron,cProv,cCRC,cLETALI,cCAMPO7,nALICPC,cTipo)
	
	
	Local  oImpos  :=NIL
	Local  cAuxImpos  :=""
	Local  nAliq   :=0
	Local  nAuxAli1:=0
	Local  nAuxAli2:=0
	Local  nRec    := 0

	DEFAULT lPadron := .F.
	DEFAULT cProv := ""
	DEFAULT cCRC:=""
	DEFAULT cLETALI:=""
	DEFAULT cCAMPO7:=""
	DEFAULT nALICPC:=0
	DEFAULT cTipo:=""

	If lCli 
		cProv:=ALLTRIM(cProv)
		oImpos:=oJSFB[cProv]
		If lPadron
			
				IF (oImpos)!=NIL

					IF oImpos["CCOZONFIS"]==cProv
						cCRC:=ALLTRIM(cCRC)
						
						nAuxAli1:=oImpos["ALIVNI"] // FB_ALIVNI 2%
						nAuxAli2:=oImpos["ALISIJ"] // FB_ALISIJ  1%
						nAliq:= nALICPC

						cAuxImpos:=oImpos["IMPOSTO"]
						nRec:= getRegExit((cSA1)->A1_COD,(cSA1)->A1_LOJA,cAuxImpos,cProv,.T.,cCampo7,"1",cCRC,cLETALI)
						If nRec==0
							
							IF cCampo7!="2"
								nAuxAli2:= 0
							ENDIF
							nAliq+= nAuxAli2
							NewSFH("N",(cSA1)->A1_COD,cTipo,(cSA1)->A1_LOJA,"S","S",cProv,cAuxImpos,nAliq,0,0,"N","","SA1",(cSA1)->A1_NOME,"1",cCRC,cLETALI,cCAMPO7,0,nAuxAli2,nALICPC)
						ELSE
							SFH->(DbGoTo(nRec))
							IF SFH->FH_CAMPO7!="2"
								nAuxAli2:= 0
							ENDIF
							If (SFH->FH_FIMVIGE < dDataFim .Or. Empty(SFH->FH_FIMVIGE))  .AND. SFH->FH_ALISIJ ==nAuxAli2
							 	RecLock("SFH", .F.)
							
								SFH->FH_FIMVIGE := dDataFim
								SFH->(MsUnlock())
							ENDIF
						ENDIF
					ENDIF
				ENDIF
		
		ELSE
			IF (oImpos)!=NIL
				
				nAuxAli1:=oImpos["ALIVNI"] // FB_ALIVNI 2%
				nAuxAli2:=oImpos["ALISIJ"] // FB_ALISIJ  1%
				cAuxImpos:=oImpos["IMPOSTO"]
				nRec:=getRegExit((cSA1)->A1_COD,(cSA1)->A1_LOJA,cAuxImpos,cProv,.T.,"","2","","")
			
				nAliq+= nAuxAli1
				IF nRec==0
					
					NewSFH("N",(cSA1)->A1_COD,cTipo,(cSA1)->A1_LOJA,"S","S",cProv,cAuxImpos,nAliq,0,0,"N","","SA1",(cSA1)->A1_NOME,"2",cCRC,cLETALI,cCAMPO7,nAuxAli1,0,nALICPC)
				ELSE

					SFH->(DbGoTo(nRec))
					IF !(SFH->FH_TIPO $ "E|X|F|M")

							IF SFH->FH_ALIVNI ==nAuxAli1
								RecLock("SFH", .F.)
								SFH->FH_FIMVIGE:=dDataFim
								SFH->(MsUnlock())
							ELSE
								NewSFH("N",(cSA1)->A1_COD,cTipo,(cSA1)->A1_LOJA,"S","S",cProv,cAuxImpos,nAliq,0,0,"N","","SA1",(cSA1)->A1_NOME,"2",cCRC,cLETALI,cCAMPO7,nAuxAli1,0,nALICPC)
							EndIf

					ENDIF

				ENDIF
			ENDIF

		ENDIF
		lImp := .T.
		FreeObj(oImpos)	
	EndIf 

Return Nil

/*/{Protheus.doc} NewSFH
    Función para realizar la creacion de nuevos registros en la tabla SFH.
    @type  Function
    @author adiran.perez
    @since 21/05/2026
    @param  cAgente , character, indica si es agente.
    @param  cCOD    , character, codigo del proveedor o cliente.
	@param  cTipo   , character, indica el tipo.
    @param  cLoja   , character, indica la surcursal.
	@param  cPercIBI, character, indica si paga impuesto en esta zona.
    @param  cAPERIB , character, indica si paga IB.
	@param  cZonaFis, character, indica la zona.
    @param  cImpost , character, indica el impuesto.
	@param  nAliq   , numeric, indica el valor de la alicuota.
    @param  nPercent, numeric, incida la porcentaje de exencion
    @param  nCoefMul, numeric, indica el valor de la alicuota.
	@param  cIsento,  character, indica si es exento
	@param  nSituaca, numeric; indica el valor de la situación de acuerdo a la SFH
    @param  cTable  , character, indica la tabla si es A1 o A2, cliente o proveedor.
    @param  cNome   , character, indica el nombre del proveedor o cliente.
	@param	cPADSIR , Carácter 	Indica si estaba en padrón.
	@param	cCRC	, Carácter 	Código (CRC).
	@param	cLETALI	, Carácter 	Letra de alícuota .
	@param	cCAMPO7	,Carácter 	Campo7 Valores por Jurisdicción  .
	@param	nALIVNI	, Numérico	Alícuota No Inscripto SIRCIP.
	@param	nALISIJ	, Numérico	Alícuota No alta jurisdicción SIRCIP en el cálculo del impuesto.
	@param	nALICPC	, Numérico	Alícuota que viene del padron(letra convertida).
	
    @return nil
    /*/  

Static Function NewSFH(cAgente,cCOD,cTipo,cLoja,cPercIBI,cAPERIB,cZonaFis,cImpost,nAliq,nPercent,nCoefMul,cIsento,cSituaca,cTable,cNome,cPADSIR,cCRC,cLETALI,cCAMPO7,nALIVNI,nALISIJ,nALICPC)

Local cCodSA2 := " "
Local cCodSA1 := " "
	DEFAULT cAgente := ""
	DEFAULT cCOD    := ""
	DEFAULT cTipo   := ""
	DEFAULT cLoja   := ""
	DEFAULT cPercIBI := ""
	DEFAULT cAPERIB  := ""
	DEFAULT cZonaFis := ""
	DEFAULT cImpost  := ""
	DEFAULT nAliq    := 0
	DEFAULT nPercent := 0
	DEFAULT nCoefMul := 0
	DEFAULT cIsento	 := ""
	Default cSituaca :=""
	DEFAULT cTable   := ""
	DEFAULT cNome    := ""
	DEFAULT cPADSIR  :=""
	DEFAULT cCRC	 :=""
	DEFAULT	cLETALI  :=""
	DEFAULT cCAMPO7  :=""
	DEFAULT  nALIVNI:=0
	DEFAULT nALISIJ	 :=0
	DEFAULT nALICPC  :=0

	If cTable == "SA2"
		cCodSA2 := cCOD
	Else
		cCodSA1 := cCOD
	EndIf
	cNome := PadR(cNome, nTamNome)

	oBulkSFH:addData({xFilial("SFH"),cAgente,cZonaFis,cCodSA2,cCodSA1,cLoja,cNome,cImpost,cPercIBI,cIsento,cAPERIB,nAliq,nPercent,cTipo,dDataIni,dDataFim,nCoefMul,cSituaca ,cPADSIR,cCRC,cLETALI,cCAMPO7,nALIVNI,nALISIJ,nALICPC})
	
	

Return Nil

/*/{Protheus.doc} getRegExit
    Función para realizar la busqueda del registro en la tabla SFH de mayor fecha fin vigencia.
    @type  Function
    @author adrian.perez
    @since 25/05/2026
    @param  cCod     , character, codigo del proveedor o cliente.
    @param  cLoja    , character, indica la surcursal.
	@param  cImpuesto, character, indica el impuesto.
	@param  lForCli   , logical  , indica si la busqueda es para proveedor o cliente.
	@param	cCAMPO7	,Carácter 	Campo7 Valores por Jurisdicción  .
	@param	cPADSIR , Carácter 	Indica si estaba en padrón.
	@param	cCRC	, Carácter 	Código (CRC).
	@param	cLETALI	, Carácter 	Letra de alícuota .
    @return nAux      ,numeric  , retorna el recno del registro de mayor fecha fin vigencia.
    /*/  

Static Function getRegExit(cCod,cLoja,cImpuesto,cProv,lForCli,cCampo7,cPADSIR,cCRC,cLETALI)

	Local cQuery    := ""
	Local nParam	:=1
	Local nAux		:=0
	DEFAULT cCod      := ""
	DEFAULT cLoja     := ""
	DEFAULT cImpuesto := ""
	DEFAULT cProv	  := ""
	DEFAULT lForCli   := .F.
	DEFAULT cCampo7   :=""
	DEFAULT cPADSIR   :=""
	DEFAULT cCRC       :=""
	DEFAULT cLETALI   :=""

	IF cCod!="".AND. cLoja!="" .AND. cImpuesto!="" .AND. cProv !=""
		IF oQryExFech==NIL
			cQuery := ""
			cQuery := "SELECT  FH_FIMVIGE AS FECHA,R_E_C_N_O_ AS NUM,FH_INIVIGE AS INI"
			cQuery += " FROM                     "+ RetSqlName("SFH")+ " SFH"
			cQuery += "  WHERE FH_FILIAL       = ? "
			If lForCli
				cQuery += "    AND FH_CLIENTE  = ? "
			Else
				cQuery += "    AND FH_FORNECE  = ? "
			EndIf
			cQuery += "    AND FH_LOJA         = ? "
			cQuery += "    AND FH_IMPOSTO      = ? "
			cQuery += "    AND FH_ZONFIS       = ? "
			cQuery += "    AND FH_CAMPO7       = ? "
			cQuery += "    AND FH_PADSIR	   = ? "
			cQuery += "    AND FH_CRC		   = ? "
			cQuery += "    AND FH_LETALI	   = ? " 
			
			cQuery += "    AND D_E_L_E_T_      = ? "
			cQuery += " ORDER BY "
			cQuery += " CASE "
			cQuery += " When FH_FIMVIGE = '' THEN '99999999' "
			cQuery += " Else FH_FIMVIGE "
			cQuery += " End DESC, "
			cQuery += " FH_INIVIGE DESC "

			cQuery := ChangeQuery(cQuery)
			oQryExFech := FwExecStatement():New(cQuery)
		EndIf

		
		oQryExFech:SetString(nParam++, xFilial("SFH"))
		oQryExFech:SetString(nParam++, cCod)
		oQryExFech:SetString(nParam++, cLoja)
		oQryExFech:SetString(nParam++, cImpuesto)
		oQryExFech:SetString(nParam++, cProv)
		oQryExFech:SetString(nParam++, cCampo7)
		oQryExFech:SetString(nParam++, cPADSIR)
		oQryExFech:SetString(nParam++, cCRC)
		oQryExFech:SetString(nParam++, cLETALI)
		
		oQryExFech:SetString(nParam++, Space(1))
		nAux:=oQryExFech:ExecScalar('NUM') 

 	EndIF
Return nAux 

/*/{Protheus.doc} fProvPer
    Función para realizar la busqueda, verificaciones y actualizacion de los registros en la tabla SFH para proveedores.
    @type  Function
    @author adrian.perez
    @since 20/05/2026
   	@param	lPadron	Lógico		Indica si se encuentra en el padrón.
	@param	cProv	Carácter 	Código de provincia. Se utiliza para buscar la configuración de impuestos en oJSFB.
	@param	cCRC	Carácter 	Código (CRC).
	@param	cLETALI	Carácter 	Letra de alícuota .
	@param	cCAMPO7	Carácter 	Campo7 Valores por Jurisdicción  .
	@param	nALICPC	Numérico	Alícuota base inicial que se usará para el cálculo del impuesto.
	@param	cTipo	Carácter	Tipo SFH

    @return nil
  
    /*/  

Static Function fProvPer(lPadron,cProv,cCRC,cLETALI,cCAMPO7,nALICPC,cTipo)
	
	
	Local  oImpos  :=NIL
	Local  cAuxImpos  :=""
	Local  nAliq   :=0
	Local  nAuxAli1:=0
	Local  nAuxAli2:=0
	Local  nRec    := 0

	DEFAULT lPadron := .F.
	DEFAULT cProv := ""
	DEFAULT cCRC:=""
	DEFAULT cLETALI:=""
	DEFAULT cCAMPO7:=""
	DEFAULT nALICPC:=0
	DEFAULT cTipo:=""

	If lFor 
		cProv:=ALLTRIM(cProv)
		oImpos:=oJSFB[cProv]
		If lPadron
			
				IF (oImpos)!=NIL

					IF oImpos["CCOZONFIS"]==cProv
						cCRC:=ALLTRIM(cCRC)
						
						nAuxAli1:=oImpos["ALIVNI"] // FB_ALIVNI 2%
						nAuxAli2:=oImpos["ALISIJ"] // FB_ALISIJ  1%
						nAliq:= nALICPC

						cAuxImpos:=oImpos["IMPOSTO"]
						nRec:= getRegExit((cSA2)->A2_COD,(cSA2)->A2_LOJA,cAuxImpos,cProv,.F.,cCampo7,"1",cCRC,cLETALI)
						
						If nRec==0
							
							IF cCampo7!="2"
								nAuxAli2:= 0
							ENDIF
							nAliq+= nAuxAli2
							NewSFH("N",(cSA2)->A2_COD,cTipo,(cSA2)->A2_LOJA,"S","S",cProv,cAuxImpos,nAliq,0,0,"N","","SA2",(cSA2)->A2_NOME,"1",cCRC,cLETALI,cCAMPO7,0,nAuxAli2,nALICPC)
						ELSE
							SFH->(DbGoTo(nRec))
							IF SFH->FH_CAMPO7!="2"
								nAuxAli2:= 0
							ENDIF
							If (SFH->FH_FIMVIGE < dDataFim .Or. Empty(SFH->FH_FIMVIGE))  .AND. SFH->FH_ALISIJ ==nAuxAli2
							 	RecLock("SFH", .F.)
							
								SFH->FH_FIMVIGE := dDataFim
								SFH->(MsUnlock())
							ENDIF
						ENDIF
					ENDIF
				ENDIF
		
		ELSE
			IF (oImpos)!=NIL
				
				nAuxAli1:=oImpos["ALIVNI"] // FB_ALIVNI 2%
				nAuxAli2:=oImpos["ALISIJ"] // FB_ALISIJ  1%
				cAuxImpos:=oImpos["IMPOSTO"]
				nRec:=getRegExit((cSA2)->A2_COD,(cSA2)->A2_LOJA,cAuxImpos,cProv,.F.,"","2","","")
				nAliq+= nAuxAli1
				IF nRec==0
					
					NewSFH("N",(cSA2)->A2_COD,cTipo,(cSA2)->A2_LOJA,"S","S",cProv,cAuxImpos,nAliq,0,0,"N","","SA2",(cSA2)->A2_NOME,"2",cCRC,cLETALI,cCAMPO7,nAuxAli1,0,nALICPC)
				ELSE

					SFH->(DbGoTo(nRec))
					IF !(SFH->FH_TIPO $ "E|X|F|M")

							IF SFH->FH_ALIVNI ==nAuxAli1
								RecLock("SFH", .F.)
								SFH->FH_FIMVIGE:=dDataFim
								SFH->(MsUnlock())
							ELSE
								NewSFH("N",(cSA2)->A2_COD,cTipo,(cSA2)->A2_LOJA,"S","S",cProv,cAuxImpos,nAliq,0,0,"N","","SA2",(cSA2)->A2_NOME,"2",cCRC,cLETALI,cCAMPO7,nAuxAli1,0,nALICPC)
							EndIf

					ENDIF

				ENDIF
			ENDIF

		ENDIF
		FreeObj(oImpos)	
	EndIf // fin prove

Return Nil



/*/{Protheus.doc} F848LeePad
    Función para realizar la geracion de la tabla temporal del padron con todos los datos del archivo TXT de importación.
	Función intermedida para poder realizar el uso de la función Processa y mostrar correctamente el avance.
    @type  Function
    @author adrian.perez
    @since 20/05/2026
    @param  cArqProc,	character, archivo a ser importado
    @return lArqValido,		 logical, 	retorna .T. si la importación no tuvo errores.
    /*/  
Static Function F848LeePad(cArqProc)
Local lArqValido	:= .F.	
Local lAutomato 	:= IsBlind()

Default cArqProc := ""

	If File(cArqProc)
		If !lAutomato
			Processa({|| lArqValido := CreaTabla(cArqProc)})
		Else
			lArqValido := CreaTabla(cArqProc)
		EndIf
	EndIf

Return lArqValido

/*/{Protheus.doc} F848TotReg
    Función para obtener el total de registros a ser procesados en la importación, para poder mostrar el avance correcto en la barra de progreso.
    @type  Function
    @author adrian.perez
    @since 20/05/2026
    @param  
	lCli, logical, indica si se debe contabilizar los clientes.
	lFor, logical, indica si se debe contabilizar los proveedores.
	
    @return 
	nTotal, numeric, total de registros a ser procesados en la importación.
    /*/  
Static Function F848TotReg(lCli, lFor)
Local nTotal	 := 0
Local nReg 		 := 0
Local cQuery	 := ""
Local nParamA1   := 1
Local nParamA2   := 1
Local oQryExec	 := Nil

Default lCli 	:= .F.
Default lFor 	:= .F.


	If lCli 
		cQuery := ""
		cQuery := "SELECT COUNT(*) TOTAL"
		cQuery += "FROM                         "+RetSqlName("SA1")+" A1 "
		cQuery += " WHERE A1.A1_FILIAL        = ?    "
		cQuery += "   AND A1.A1_CGC          <> ?    "
		cQuery += "   AND A1.D_E_L_E_T_       = ?    "
		cQuery := ChangeQuery(cQuery)
		oQryExec := FwExecStatement():New(cQuery)
		oQryExec:SetString(nParamA1++, xFilial("SA1"))
		oQryExec:SetString(nParamA1++, ' ')
		oQryExec:SetString(nParamA1++, ' ')
		nReg := oQryExec:ExecScalar('TOTAL')
		oQryExec:Destroy()
		oQryExec := nil 
		nTotal += nReg
	EndIf


	If lFor 
		cQuery := ""
		cQuery := "SELECT COUNT(*) TOTAL"
		cQuery += "FROM                           "+RetSqlName("SA2")+" A2 "
		cQuery += " WHERE A2.A2_FILIAL          = ?    "
		cQuery += "   AND A2.A2_CGC            <> ?    "
		cQuery += "   AND A2.D_E_L_E_T_         = ?    "
		cQuery := ChangeQuery(cQuery)
		oQryExec := FwExecStatement():New(cQuery)
		oQryExec:SetString(nParamA2++, xFilial("SA2"))
		oQryExec:SetString(nParamA2++, ' ')
		oQryExec:SetString(nParamA2++, ' ')
		nReg := oQryExec:ExecScalar('TOTAL')
		oQryExec:Destroy()
		oQryExec := nil 
		nTotal += nReg
		
	EndIf

Return nTotal

/*/{Protheus.doc} getCampo7
    Función getCampo7 toma la cadena cCampo7, la descompone en caracteres individuales y luego los reorganiza en orden inverso..
    @type  Function
    @author adrian.perez
    @since 27/05/2026
	@param	cCAMPO7	Carácter 	Campo7 Valores por Jurisdicción  .
    @return aDatos arreglo con las posiciones del campo7
  
    /*/  

Static Function getCampo7(cCampo7)

    
    Local nI := 0
	Local nTam:=0
	Local aPosiciones := {}
	Local aDatos:={}

	Default cCampo7:=""

    For nI := 1 To Len(cCampo7)
        aAdd(aPosiciones, SubStr(cCampo7, nI, 1))
    Next nI

	nTam:=len(aPosiciones)
  // Intercambiar posiciones Se lee de derecha a izquierda la ultima posicion siempre es cero y es control
    For nI := 1 To len(aPosiciones)
      
         aAdd(aDatos, aPosiciones[nTam - nI + 1])
      
    Next nI

Return aDatos

/*/{Protheus.doc} getDataEq
    Función getDataEq sirve para mapear o traducir valores (origen ? destino) basándose en configuraciones de la tabla CCP
    @type  Function
    @author adrian.perez
    @since 27/05/2026
	@param	cCod	Cadena	Código que se utiliza como filtro en la consulta SQL (CCP_COD). Determina qué registros se recuperan de la tabla y sirve como clave 
					para estructurar el objeto JSON de salida.
	@param  lInverso logico indica si hay que invertir valores origen destino
	@param  cSucursal cadena  sucursal donde se usa la CCP
    @return oJEqui  objeto Json con los datos de la tabla de equivalencia.
  
    /*/  

STATIC FUNCTION getDataEq(cCod,lInverso,cSucursal)

	Local cQryT 	:= ""
	Local oQryEx 	:= nil
	Local nOrd 		:= 1
	Local oJEqui	:=  JsonObject():New() 
	Local cAlias	:=""
	Default cCod 	:= ""
	Default lInverso:=.F.
	Default cSucursal:= FWCodFil()

	
		cQryT := "SELECT  CCP.CCP_COD,CCP.CCP_VORIGE,CCP.CCP_VDESTI FROM "
		cQryT += RetSqlName("CCP")+" CCP WHERE  CCP.CCP_FILIAL = ? AND CCP.CCP_COD = ? AND CCP.D_E_L_E_T_ = ?"

		cQryT:= ChangeQuery(cQryT)
		oQryEx := FwExecStatement():New(cQryT)
	
	nOrd := 1
	oQryEx:SetString(nOrd++, xFilial("CCP",cSucursal))
	oQryEx:SetString(nOrd++,cCod)
	oQryEx:SetString(nOrd++,SPACE(1))

	cAlias := oQryEx:OpenAlias()
	
	While !( (cAlias)->(Eof()) ) 
		IF  !oJEqui:HasProperty(cCod)
			oJEqui[cCod]:=JsonObject():New()
			IF !lInverso
				oJEqui[cCOD][AllTrim((cAlias)->CCP_VORIGE)]:=alltrim((cAlias)->CCP_VDESTI)
			ELSE
				oJEqui[cCOD][AllTrim((cAlias)->CCP_VDESTI)]:=alltrim((cAlias)->CCP_VORIGE)
			ENDIF
		ELSE
			IF !lInverso
				oJEqui[cCOD][AllTrim((cAlias)->CCP_VORIGE)]:=alltrim((cAlias)->CCP_VDESTI)
			ELSE
				oJEqui[cCOD][AllTrim((cAlias)->CCP_VDESTI)]:=alltrim((cAlias)->CCP_VORIGE)
			Endif
		ENDIF
		(cAlias)->(DbSkip())
	End

    (cAlias)->(DbCloseArea())
	oQryEx:Destroy()
	oQryEx:=Nil

	If !oJEqui:HasProperty(cCod) 
		Help(" ",1,STR0032,,STR0033 + cCod,4,5)// // STR0032 "Atención"  //STR0033 No existe tabla de equivalencia
	EndIf

Return oJEqui

/*/{Protheus.doc} getDataSFB
    Función  getDataSFB sirve para consultar de los impuestos  desde la base de datos y organizarla en un objeto JSON estructurado por provincia.
    @type  Function
    @author adrian.perez
    @since 27/05/2026
    @return oJSFB  objeto Json con los datos de la tabla de equivalencia.
  
    /*/  

STATIC FUNCTION getDataSFB()

	Local cQryT := ""
	Local oQryEx := nil

	Local nOrd := 1
	Local oJSFB	:=  JsonObject():New() 
	Local oJAUX	:=  JsonObject():New() 
	Local cAlias:=  ""
	

	cQryT := "SELECT  SFB.FB_ESTADO,SFB.FB_CLASSIF,SFB.FB_CLASSE,SFB.FB_CODIGO,SFB.FB_ALIVNI,SFB.FB_ALISIJ,CCO.CCO_CODPRO,CCO.CCO_SIRCIP FROM "
	cQryT += RetSqlName("SFB")+" SFB  INNER JOIN "+RetSqlName("CCO")+" CCO ON CCO.CCO_CODPRO =  SFB.FB_ESTADO  "
	cQryT +="   WHERE SFB.FB_FILIAL= ? AND CCO.CCO_FILIAL= ? AND SFB.FB_CLASSIF= ? AND SFB.FB_CLASSE=? AND SFB.FB_TIPO=? AND SFB.D_E_L_E_T_ = ?"

	cQryT:= ChangeQuery(cQryT)
	oQryEx := FwExecStatement():New(cQryT)
	nOrd := 1

	oQryEx:SetString(nOrd++, xFilial("SFB"))
	oQryEx:SetString(nOrd++, xFilial("CCO"))
	oQryEx:SetString(nOrd++,"1")
	oQryEx:SetString(nOrd++,"P")
	oQryEx:SetString(nOrd++,"P")
	oQryEx:SetString(nOrd++,SPACE(1))

	cAlias := oQryEx:OpenAlias()
	
	While !( (cAlias)->(Eof()) ) 
		IF !Empty((cAlias)->FB_ESTADO) 
			IF  !oJSFB:HasProperty((cAlias)->FB_ESTADO)
			
				oJSFB[(cAlias)->FB_ESTADO]:=JsonObject():New()
				oJAUX:=JsonObject():New()
				oJAUX['IMPOSTO']:=alltrim((cAlias)->FB_CODIGO)
				oJAUX['ALIVNI']:=(cAlias)->FB_ALIVNI
				oJAUX['ALISIJ']:=(cAlias)->FB_ALISIJ
				oJAUX['SIRCIP']:=(cAlias)->CCO_SIRCIP
				oJAUX['CCOZONFIS']:=(cAlias)->CCO_CODPRO
				oJSFB[AllTrim((cAlias)->FB_ESTADO)]:=oJAUX

			ENDIF
			
		ENDIF
		(cAlias)->(DbSkip())
	End

    (cAlias)->(DbCloseArea())
	oQryEx:Destroy()
	oQryEx:=Nil
	FreeObj(oJAUX)	
Return oJSFB


/*/{Protheus.doc} getTipo
    Función  getTipo sirve para consultar de los impuestos  desde la base de datos y organizarla en un objeto JSON estructurado por provincia.
    @type  Function
    @author adrian.perez
    @since 27/05/2026
	aCampo7	Arreglo	 datos del campo 7 Se utiliza para contar cuántas posiciones contienen "1" 
	lPadron	Lógico	 Indicador que define si se debe evaluar el contenido del arreglo. Si es .T., se analiza aCampo7 para determinar el tipo; si es .F., no se realiza validación.
    @return cTipo    Carácter regresa el tipo a para usar en el campo FH_TIPO
  
    /*/  

STATIC FUNCTION getTipo(aCampo7,lPadron)

Local nI:=0
Local  cTipo:= "I"
Local nCuenta:=0

DEFAULT aCampo7:={}
DEFAULT lPadron:=.F.

	IF lPadron
		For nI := 1 To Len(aCampo7)
			IF (aCampo7[nI])=="1"
				nCuenta++
				IF nCuenta>1
					EXIT 
				ENDIF
			EndIF
		Next nI

		IF nCuenta>1
			cTipo:="V"
		EndIF
	EndIF


return cTipo

/*/{Protheus.doc} fBoxALSC
