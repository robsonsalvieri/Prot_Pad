/*/{Protheus.doc} fValCamp
    Función  fValCamp Valida los tamaños y tipos de los nuevos campos
    @type  Function
    @author adrian.perez
    @since 31/05/2026
	
    @return lRet    booleano .T. indica no que existe errores , .F. indica que existe errores
  
    /*/  

function fValCamp()

Local aCamp:={"FH_PADSIR","FH_CRC","FH_LETALI","FH_CAMPO7","FH_ALIVNI","FH_ALISIJ","FH_ALICPC"}
Local aTam :={ 1,2,1,1,5,5,5}
Local aTip :={ "C","C","C","C","N","N","N"}

Local nI:=0
Local cTipo:=""
Local nTam:=0
Local nCon:=0
Local lRet:=.T.
	For nI := 1 To Len(aCamp)
 		
		
		nTam:=GetSx3Cache( aCamp[nI], "X3_TAMANHO" ) 
		cTipo:=GetSx3Cache( aCamp[nI], "X3_TIPO" ) 

		IF nTam!=aTam[nI]
			nCon++
		ENDIF

		IF cTipo!=aTip[nI]
			nCon++
		ENDIF
		if nCon>0
			lRet:=.F.
			exit
		endif
		
	Next
	aSize(aCamp,0)
	aSize(aTam,0)
	aSize(aTip,0)
return lRet


/*/{Protheus.doc} fImportar
    Función  Función para mostrar pantalla para ingresar datos para importar txt
    @type  Function
    @author adrian.perez
    @since 03/06/2026
    @return nil 
    /*/  
function fImportar()
	
	Local cCombo	:= ""
	Local aCombo	:= {}
	Local oDlg		:= Nil
	Local oFld		:= Nil
	Local oCombo	:= Nil
	
	aAdd( aCombo, STR0002 ) //"1- Proveedor"
	aAdd( aCombo, STR0003 ) //"2- Cliente"
	aAdd( aCombo, STR0004 ) //"3- Ambos  "


	DEFINE MSDIALOG oDlg TITLE STR0005  FROM 0,0 TO 370,555 OF oDlg PIXEL // STR0005 'SIRCIP' 

	
//+----------------------
//| Campos Folder 1
//+----------------------

	@ 006,006 TO 040,200 LABEL STR0006 OF oDlg PIXEL //STR0006 "Info. Preliminar"
	@ 011,010 SAY STR0007 SIZE 065,008 PIXEL OF oFld // STR0007 "Registro"
	@ 025,010 COMBOBOX oCombo VAR cCombo ITEMS aCombo SIZE 65,8 PIXEL OF oFld 


	@ 041,006 FOLDER oFld OF oDlg PROMPT STR0008 PIXEL SIZE 195,145 //STR0008 'Importación de archivo TXT'
//+----------------
//| Campos Folder 2
//+----------------
	@ 005,005 SAY STR0009 SIZE 150,008 PIXEL OF oFld:aDialogs[1] //STR0009 "El SIRCIP (Sistema Informático de Recaudación, Control "                                                                                                                                                                                                                                                                                                                                                                                                                                                           
	@ 014,005 SAY STR0010 SIZE 150,010 PIXEL OF oFld:aDialogs[1] //STR0010 " " e Información de Percepciones) unifica los regímenes "
	@ 024,005 SAY STR0011 SIZE 170,008 PIXEL OF oFld:aDialogs[1] //STR0011 " de percepción de Ingresos Brutos en jurisdicciones adheridas"

	@ 051,005 SAY STR0015  SIZE 150,008 PIXEL OF oFld:aDialogs[1] //STR0015 "Informe o periodo:"
	@ 049,117 MSGET cMesIni PICTURE "@E 99" VALID !Empty(cMesIni) SIZE  015,008 PIXEL OF oFld:aDialogs[1]
	@ 051,131 SAY " /" SIZE  150, 8 PIXEL OF oFld:aDialogs[1]
	@ 049,136 MSGET cAnoIni PICTURE "@E 9999" VALID !Empty(cAnoIni) SIZE 020,008 PIXEL OF oFld:aDialogs[1]

	@ 062,005 SAY   STR0012 SIZE 150,008 PIXEL OF oFld:aDialogs[1] //STR0012 "Tabla equivalencia Alícuota"
	@ 060,120 MSGET cTabEqAliq PICTURE "@!"  F3 'CCP'  VALID !Empty(cTabEqAliq)  SIZE  035,008 PIXEL OF oFld:aDialogs[1]

	@ 072,005 SAY STR0013   SIZE 150,008 PIXEL OF oFld:aDialogs[1] //STR0013 "Tabla equivalencia Juridisciones" 
	@ 070,120 MSGET cTabEqJur  PICTURE "@!" F3 'CCP'  VALID !Empty(cTabEqJur)    SIZE  035,008 PIXEL OF oFld:aDialogs[1]

	@ 082,005 SAY  STR0014  SIZE 150,008 PIXEL OF oFld:aDialogs[1] //STR0014 Tabla equivalencia Posiciones Juridisciones
	@ 080,120 MSGET cTabEqPosJ PICTURE "@!" F3 'CCP'  VALID !Empty(cTabEqPosJ) SIZE  035,008 PIXEL OF oFld:aDialogs[1]
//+-------------------
//| Boton de MSDialog
//+-------------------
	@ 070,202 BUTTON STR0016 SIZE 036,016 PIXEL ACTION ImpArq(aCombo,cCombo)  //STR0016 "Importar"
	@ 090,202 BUTTON STR0017 SIZE 036,016 PIXEL ACTION oDlg:End() //STR0017 "salir"

	ACTIVATE MSDIALOG oDlg CENTER

		FwFreeObj(oDlg)
		FwFreeObj(oFld)
		FwFreeObj(oCombo)
return nil

/*/{Protheus.doc} fValDicc
    Función  para validar datos del diccionario para el SIRCIP
    @type  Function
    @author adrian.perez
    @since 03/06/2026
    @return lRet    booleano .T. indica no que existe errores , .F. indica que existe errores
    /*/  

function fValDicc()

Local lRet:=.T.

	if (CCO->(ColumnPos("CCO_SIRCIP")) > 0 ).AND.	( SFH->(ColumnPos("FH_PADSIR")>0)) ;
	    .AND. (SFH->(ColumnPos("FH_CRC"))>0 )    .AND.( SFH->(ColumnPos("FH_LETALI")>0 )) .AND.(SFH->(ColumnPos("FH_CAMPO7")>0 )) .AND.;
		(SFH->(ColumnPos("FH_ALIVNI")>0 ))  .AND. ;
		(SFH->(ColumnPos("FH_ALISIJ")>0 )) .AND. ;
		(SFH->(ColumnPos("FH_ALICPC")>0 )) .AND. ;
		(SFB->(ColumnPos("FB_ALIVNI")>0 )) .AND. (SFB->(ColumnPos("FB_ALISIJ")>0)  ) .AND. fValCamp()

			lRet:=.T.
	ELSE
		Help(STR0032,1,STR0032 , NIL,STR0030, 1, 0, NIL, NIL, NIL, NIL, NIL,{STR0031}) // STR0030 "Error diccionario "	//STR0031"'Verifique campos de las tablas CCO,SFH y SFB para el SIRCIP'                " // STR0032 "Atención"  
		lRet:=.F.

	EndIF

return lRet

/*/{Protheus.doc} fExportar
    Función  para ingresar datos mediante una interfzas y comenzar exportación de datos
    @type  Function
    @author adrian.perez
    @since 03/06/2026
    @return nil  sin retorno
    /*/  
function fExportar()

Local   cPerg:=STR0077 //STR0077 FIS848
Local   nFil:=0
Local lAutomato := IsBlind()
Local aFilsCalc:={}
Local aSucursal:={}
		Pergunte(cPerg, .T. )


		dPedIni		:=            MV_PAR01           		 // 1	¿Periodo Inicial?                      
		dPedFin		:=            MV_PAR02                   // 2	¿Periodo Final?           
		cDesdeProv	:=         	  ALLTRIM(MV_PAR03)          // 3 	¿Desde Provincia?             
		cHastaProv	:=            ALLTRIM(MV_PAR04)          // 4   ¿Hasta Provincia?      
		cDesdeCli	:=            ALLTRIM(MV_PAR05)          // 5	¿Desde cliente?    
		cHastaCli   :=            ALLTRIM(MV_PAR06)          // 6	¿Hasta cliente?
		cDesdeLoja  :=			  ALLTRIM(MV_PAR07)          // 7   ¿Desde tienda?
		cHastaLoja  :=			  ALLTRIM(MV_PAR08)          // 8   ¿Hasta tienda?
		cDir		:=            ALLTRIM(MV_PAR09)          // 9	¿Directorio destino?              
		cNombArch	:=         	  ALLTRIM( MV_PAR10 )	     // 10	¿Nombre del archivo?   
		cCliPadr    :=            ALLTRIM(STR(MV_PAR11))                    //11	Cliente con Padrón  
		nSelSuc		:=            MV_PAR12                    //12	¿Selecciona sucursales?               
		nAglu		:=            MV_PAR13                    //13	¿Agrupa obligación?     
		cTabEqJur   :=			  MV_PAR14					  //14 Tabla Eq. adhesiones SIRCIP   
		 IF nSelSuc==1
			aFilsCalc:= MatFilCalc(.T.)
        	
			For nFil:=1 to len(aFilsCalc) //se revisa que surcusales fueron seleccionadas		 
				If aFilsCalc[nFil,1] == .T. // se crea arreglo con las sucursales seleccionadas										
				 aadd(aSucursal,aFilsCalc[nFil][2])															
				EndIf
			Next nFil
			aSize(aFilsCalc,0)
    	Else
       		 aadd(aSucursal,FWCodFil())
   		ENDIF

		IF !lAutomato 
			Processa({||  fFI848Dat(aSucursal)})
			
		ELSE
			fFI848Dat(aSucursal)
        ENDIF
		
return nil

/*/{Protheus.doc} fFI848Dat
    Función  para extraer los datos a exportar
    @type  Function
    @author adrian.perez
    @since 03/06/2026
	@param aSucursal arreglo sucursales seleccionadas
    @return nil  sin retorno
    /*/  
function fFI848Dat(aSucursal)

Local 	oQryExec	:= 	NIL
Local 	cQry	  	:=	""
Local   cAuxfb		:=	""
Local   cAlias		:=	""
Local   nI			:=	0
Local   nA			:=  0
Local 	nOrd 		:= 	1	
Local   aAux        := {}
Local   aAux1       := {}
Local   aAuxFH		:= {}
Local   aPV         :={}
Local   aBas		:={}
Local   aVal		:={}
Local lAutomato 	:= IsBlind()
Local nBas:=0
Local nVal:=0
Local  aPosBas		:={}
Local  aPosVal		:={}
Local  nZ			:=1
Local  nAuxSobre	:=0
Local  oQryExFH		:=NIL
Local  oQrySucSFB	:= NIL

Local  dEmision		:=CTOD("\\")
Local  cSerie		:=""	
Local nTotSF3Reg	:=0
Local nTot:=0


DEFAULT aSucursal	:= {}

		IF nAglu==1
			fTablaTXT(cTRBn)
		endif
		
		For nI := 1 To len(aSucursal)
			
			aAux	:= fSF3CAMPSU(aSucursal[nI],cDesdeProv,cHastaProv,@oQrySucSFB)
			
			cAuxfb  := aAux[1]
			aAux1   := aAux[2]

			IF LEN(aAux1)>0 
				aBas:=aAux[3]
				aVal:=aAux[4]
				oJTabJuris:=getDataEq(cTabEqJur,.T.,aSucursal[nI])
				IF nAglu==2
					If Select(cTRBn) <> 0
						(cTRBn)->(dbCloseArea())
						
					EndIf
					fTablaTXT(cTRBn)
				endif
				
				nTotSF3Reg:=fToSF3(aSucursal[nI],dPedIni,dPedFin,cDesdeCli,cHastaCli,cDesdeLoja,cHastaLoja,cAuxfb)
				ProcRegua(nTotSF3Reg)
				nOrd := 1
				
					cQry := " SELECT SA1.A1_CGC, SF3.F3_ESPECIE,SF3.F3_SERIE,SF3.F3_CLIEFOR,SF3.F3_LOJA, SF3.F3_NFISCAL,SF3.F3_EMISSAO "
					cQry +=" ? "
						
					cQry += " FROM      	"+RetSqlName("SF3")+" SF3 "	
			
					cQry += " LEFT JOIN 	"+RetSqlName("SA1")+" SA1 ON    SA1.A1_COD=F3_CLIEFOR  AND SA1.A1_LOJA =SF3.F3_LOJA "
					cQry += "  WHERE SF3.F3_FILIAL = ? "
					cQry += "  AND   SA1.A1_FILIAL = ? "
					cQry += "  AND SF3.F3_EMISSAO     >= ?  AND SF3.F3_EMISSAO   <= ? "	
					cQry +="   AND SF3.F3_CLIEFOR     >= ?  AND SF3.F3_CLIEFOR   <= ? "
					cQry +="   AND SF3.F3_LOJA        >= ?  AND SF3.F3_LOJA      <= ? "
						
					cQry+="    AND SF3.D_E_L_E_T_ = ?  "
					cQry+="    AND SA1.D_E_L_E_T_ = ?  " 
					cQry := ChangeQuery(cQry)
					oQryExec := FwExecStatement():New(cQry)
				

				oQryExec:SetUnsafe(nOrd++, cAuxfb)						     //campos SFB- relacion campo Impuesto campo libro(FB_CPOLVRO)
			
				oQryExec:SetString(nOrd++, xFilial("SF3",aSucursal[nI]))     // filial SF3
				oQryExec:SetString(nOrd++, xFilial("SA1",aSucursal[nI]))     // filial SA1
		
				oQryExec:SetString(nOrd++, DTOS(dPedIni))        		      //Fecha inicial
				oQryExec:SetString(nOrd++, DTOS(dPedFin))        		      //Fecha final
				oQryExec:SetString(nOrd++, cDesdeCli	)        			  //Desde cliente
				oQryExec:SetString(nOrd++, cHastaCli	)        			  //Hasta cliente
				oQryExec:SetString(nOrd++, cDesdeLoja	)        			  //Desde tienda
				oQryExec:SetString(nOrd++, cHastaLoja	)        			  //Hasta tienda
				oQryExec:SetString(nOrd++, SPACE(1)		) 					  //SF3.D_E_L_E_T_
				oQryExec:SetString(nOrd++, SPACE(1)		) 					  //SA1.D_E_L_E_T_

				cAlias := oQryExec:OpenAlias()

				
				For nZ:=1 to len(aAux1) 
					aadd(aPosBas,((cAlias)->(FieldPos(aBas[nZ]))))
					aadd(aPosVal,((cAlias)->(FieldPos(aVal[nZ]))))
				NEXT
				
				While !( (cAlias)->(Eof()) ) 
				nTot++
				IncProc(STR0082+ aSucursal[nI] + cValToChar(nTot))  //STR0082 "'Procesando datos ...'"
				
								dEmision:=STOD((cAlias)->F3_EMISSAO) 
								cSerie:=SUBSTR((cAlias)->F3_SERIE,1,1)
								For nA:=1 to len(aAux1) 
									nBas:=	 (cAlias)->(fieldget(aPosBas[nA]))
									nVal:=	 (cAlias)->(fieldget(aPosVal[nA]))
									If nBas !=0	
										
										aAuxFH:=fGetSFH(aSucursal[nI],(cAlias)->F3_EMISSAO,(cAlias)->F3_CLIEFOR,(cAlias)->F3_LOJA,aAux1[nA],cCliPadr,@oQryExFH)		
										if 	LEN(aAuxFH)>0 .AND. oJTabJuris[cTabEqJur][aAuxFH[2]] !=NIL	
											aPV:=fgetNumPV((cAlias)->F3_NFISCAL)
											IF cCliPadr=="1"					
												IF aAuxFH[3]!="2"
												FIS848UP(cTRBn,;
																(cAlias)->A1_CGC,;	 						    	//Col 1  CUIT 
																aAuxFH[1],;  										//col 2   CRC
																dEmision,;   						//Col 3  FECHA Percepción 
																1,;                    								//Col 4  Por el momento el único valor posible es '1'  "1-Régimen General”
																1,;                    								//Col 5  1-Percepción 4-No Inscripto, 5-Sobretasa       
																0,;                    								//Col 6  Por el momento el único valor posible es '0', “0 - Inexistente”
																VAL(oJTabJuris[cTabEqJur][aAuxFH[2]]),;   			//Col 7  Jurisdicción donde se realizó la operación 
																(cAlias)->F3_ESPECIE,;								//Col 8  Tipo de Comprobante   1-  Factura 2-  Nota de Débito 102-Nota Crédito 
																cSerie,;                    //Col 9  F3_SERIE  Letra del Comprobante 
																aPV[2],;                   							//Col 10  PV
																aPV[1],;                  							//Col 11  Número de Comprobante
																nBas,;     											//Col 12  F3_BASIMP
																aAuxFH[5],;                							//Col 13 FH_ALIQ
																nVal,;      							//Col 14  F3_VALIMP 
																"",; 												//COL 15 Vacio por el momento Número de comprobante original (sólo para lasAnulaciones/Devoluciones) 
																"",; 												//COL 16 Vacio por el momento CRC del padrón de devoluciones  
																"A"; 											    //COL 17 default "A"  ABM (Indica si es un registro de Alta, Modificación o Baja) 
															)	
												ELSE
														
													

															// Linea sin sobretasa alicuota del padron(letra)
														nAuxSobre:=FIS848UP(cTRBn,;
																(cAlias)->A1_CGC,;	 						    	//Col 1 CUIT
																aAuxFH[1],;  									    //col 2  CRC
																dEmision,;   						//Col 3  FECHA Percepción 
																1,;                    								//Col 4  Por el momento el único valor posible es '1'  "1-Régimen General”
																1,;                    								//Col 5  1-Percepción 4-No Inscripto, 5-Sobretasa 
																0,;                    								//Col 6  Por el momento el único valor posible es '0', “0 - Inexistente”
																VAL(oJTabJuris[cTabEqJur][aAuxFH[2]]),;             //Col 7  Jurisdicción donde se realizó la operación 
																(cAlias)->F3_ESPECIE,;								//Col 8  Tipo de Comprobante   1-  Factura 2-  Nota de Débito 102-Nota Crédito  
																cSerie,;                    //Col 9  F3_SERIE  Letra del Comprobante 
																aPV[2],;                   							//Col 10  PV
																aPV[1],;                  							//Col 11  Número de Comprobante
																nBas,; 								     			//Col 12 F3_BASIMP
																aAuxFH[5]-aAuxFH[6],;                				//Col 13  FH_ALIQ- FH_ALISIJ
																nVal,;  					      			//Col 14  TOTAL 
																"",; 												//COL 15 Vacio por el momento Número de comprobante original (sólo para lasAnulaciones/Devoluciones) 
																"",; 												//COL 16 Vacio por el momento CRC del padrón de devoluciones  
																"A",; 											    //COL 17 default "A"  ABM (Indica si es un registro de Alta, Modificación o Baja) 
																.T.;
															)

																//linea sobretasa
															FIS848UP(cTRBn,;
																(cAlias)->A1_CGC,;	 						    	//Col 1 CUIT
																aAuxFH[1],;  										//col 2 CRC
																dEmision,;   						//Col 3 FECHA Percepción
																1,;                    								//Col 4  Por el momento el único valor posible es '1'  "1-Régimen General”
																5,;                    								//Col 5  1-Percepción 4-No Inscripto, 5-Sobretasa  
																0,;                    								//Col 6  Por el momento el único valor posible es '0', “0 - Inexistente”
																VAL(oJTabJuris[cTabEqJur][aAuxFH[2]]),;   			//Col 7  Jurisdicción donde se realizó la operación 
																(cAlias)->F3_ESPECIE,;								//Col 8  Tipo de Comprobante   1-  Factura 2-  Nota de Débito 102-Nota Crédito  
																cSerie,;                    //Col 9  F3_SERIE  Letra del Comprobante 
																aPV[2],;                   							//Col 10 PV
																aPV[1],;                   							//Col 11 Número de Comprobante
																nBas,;     			//Col 12 F3_BASIMP
																aAuxFH[6],;               							//Col 13 FH_ALISIJ
																nVal,;       			//Col 14  TOTAL 
																"",; 												//COL 15 Vacio por el momento Número de comprobante original (sólo para lasAnulaciones/Devoluciones) 
																"",; 												//COL 16 Vacio por el momento CRC del padrón de devoluciones  
																"A",; 											    //COL 17 default "A"  ABM (Indica si es un registro de Alta, Modificación o Baja) 
																.T.,;
																nAuxSobre;
																)
												ENDIF
											ELSE
														FIS848UP(cTRBn,;
																(cAlias)->A1_CGC,;	 						    	//Col 1  CUIT 
																aAuxFH[1],;  										//col 2   CRC
																dEmision,;   						//Col 3  FECHA Percepción 
																1,;                    								//Col 4  Por el momento el único valor posible es '1'  "1-Régimen General”
																4,;                    								//Col 5  1-Percepción 4-No Inscripto, 5-Sobretasa       
																0,;                    								//Col 6  Por el momento el único valor posible es '0', “0 - Inexistente”
																VAL(oJTabJuris[cTabEqJur][aAuxFH[2]]),;   			//Col 7  Jurisdicción donde se realizó la operación 
																(cAlias)->F3_ESPECIE,;								//Col 8  Tipo de Comprobante   1-  Factura 2-  Nota de Débito 102-Nota Crédito 
																cSerie,;                    //Col 9  F3_SERIE  Letra del Comprobante 
																aPV[2],;                   							//Col 10  PV
																aPV[1],;                  							//Col 11  Número de Comprobante
																nBas,;     			//Col 12  F3_BASIMP
																aAuxFH[5],;               							//Col 13 FH_ALIQ
																nVal,;      			//Col 14  F3_VALIMP 
																"",; 												//COL 15 Vacio por el momento Número de comprobante original (sólo para lasAnulaciones/Devoluciones) 
																"",; 												//COL 16 Vacio por el momento CRC del padrón de devoluciones  
																"A"; 											    //COL 17 default "A"  ABM (Indica si es un registro de Alta, Modificación o Baja) 
															)	
											ENDIF	
											
										ENDIF	
										
																	
									EndIf
									
								Next nA
					
					(cAlias)->(DbSkip())
					
					

				End
			
				(cAlias)->(DbCloseArea())
				
				IF !lAutomato .AND.nAglu==2
					FE848TRIS(cTRBn)
				ENDIF

				IF nAglu==2
					dbSelectArea(cTRBn)
					(cTRBn)->(dbGoTop())
					fCreaArch(cDir, STRTRAN(ALLTRIM(aSucursal[nI])," ","_")+"_"+cNombArch,cTRBn)
					(cTRBn)->(dbCloseArea())
				ENDIF

				aSize( 	aPosBas ,0)
				aSize(  aPosVal ,0 )
				asize(	aAux1   ,0)
				asize(	aAux    ,0)
				aSize(  aAuxFH  ,0)
				asize(	aPV     ,0)
				asize(	aBas	,0)
				asize(	aVal	,0)
				FreeObj(oJTabJuris)	
				IF oQryExFH!=NIL
					oQryExFH:Destroy()
					oQryExFH:= NIL
				ENDIF
			else
					Help(" ",1,STR0032,,STR0080 + aSucursal[nI],4,5)// // STR0032 "Atención"  //STR0080 Verificar configuraciones SFB y CCO en :
			ENDIF

			IF oQryExec!=NIL
				oQryExec:Destroy()
				oQryExec:= NIL
			endif
			IF oQrySucSFB!=NIL
				oQrySucSFB:Destroy()
				oQrySucSFB:=NIL
			ENDIF
			
		Next		
		IF nAglu==1
			FE848TRIS(cTRBn)
			
			dbSelectArea(cTRBn)
			(cTRBn)->(dbGoTop())
			fCreaArch(cDir,cNombArch,cTRBn)
			(cTRBn)->(dbCloseArea())
	
		ENDIF
return nil


/*/{Protheus.doc} fSF3CAMPSU
    Función  para extraer los datos de los campos que corresponden a alícuota, base y valor (F3_ALQIMP, F3_BASIMP, F3_VALIMP)
    @type  Function
    @author adrian.perez
    @since 06/06/2026
	@param	cFILIAL					Carácter	Código de filial utilizado para filtrar la información de las tablas SFB y CCO.
	@param	cDesdeProv				Carácter	Código inicial de provincia o estado utilizado como límite inferior en el filtro de búsqueda (FB_ESTADO >= cDesdeProv).
	@param	cHastaProv				Carácter	Código final de provincia o estado utilizado como límite superior en el filtro de búsqueda (FB_ESTADO <= cHastaProv).
	@param   oQrySucSFB				objeto 		Guarda el objeto del FwExecStatement para la query y sus filtros
    @return {cAuxfb,aAuxCamp}		Arreglo		Retorna un arreglo con dos posiciones:  cAuxfb: cadena de caracteres que contiene los nombres de los campos de alícuota, base y valor (F3_ALQIMP, F3_BASIMP, F3_VALIMP).  aAuxCamp: arreglo con los códigos FB_CPOLVRO.
    /*/  
Static Function fSF3CAMPSU(cFILIAL,cDesdeProv,cHastaProv,oQrySucSFB)


Local   cAliq	   :=""
Local   cBase	   :=""
Local   cVal	   :=""
Local   cAuxfb     :=""
Local   cAlias     :=""
Local   aAuxCamp   :={}
Local   cQryT	   	:=""
Local   nOrd 		:= 1
Local   aBas:={}
Local   aVal:={}

Default cFILIAL  	:= ""
Default cDesdeProv	:=""
Default cHastaProv	:=""
Default oQrySucSFB:= NIL

    IF oQrySucSFB==Nil

		cQryT := "SELECT SFB.FB_CPOLVRO , SFB.FB_ESTADO,SFB.FB_CLASSIF,SFB.FB_CLASSE,SFB.FB_CODIGO,SFB.FB_ALIVNI,SFB.FB_ALISIJ,CCO.CCO_CODPRO,CCO.CCO_SIRCIP FROM "
		cQryT += RetSqlName("SFB")+" SFB  INNER JOIN "+RetSqlName("CCO")+" CCO ON CCO.CCO_CODPRO =  SFB.FB_ESTADO  "
		cQryT +="   WHERE SFB.FB_FILIAL= ? AND CCO.CCO_FILIAL= ? AND SFB.FB_CLASSIF= ? AND SFB.FB_CLASSE=? AND SFB.FB_TIPO=? "
		cQryT +="	AND SFB.FB_ESTADO>=?   "
		cQryT +="	AND SFB.FB_ESTADO<=?   "
		cQryT +=" 	AND SFB.D_E_L_E_T_ = ?"
		cQryT +=" 	AND CCO.D_E_L_E_T_ = ?"
		cQryT +=" 	ORDER BY SFB.FB_ESTADO ASC "

		cQryT:= ChangeQuery(cQryT)
		oQrySucSFB := FwExecStatement():New(cQryT)
	ENDIF



	oQrySucSFB:SetString(nOrd++, xFilial("SFB",cFILIAL))
	oQrySucSFB:SetString(nOrd++, xFilial("CCO",cFILIAL))
	oQrySucSFB:SetString(nOrd++,"1")
	oQrySucSFB:SetString(nOrd++,"P")
	oQrySucSFB:SetString(nOrd++,"P")
	oQrySucSFB:SetString(nOrd++,cDesdeProv)
	oQrySucSFB:SetString(nOrd++,cHastaProv)
	oQrySucSFB:SetString(nOrd++,SPACE(1))
	oQrySucSFB:SetString(nOrd++,SPACE(1))
	
	cAlias := oQrySucSFB:OpenAlias()
	
	While !( (cAlias)->(Eof()) ) 
		IF !Empty((cAlias)->FB_ESTADO) .AND. !Empty((cAlias)->CCO_CODPRO)
			cAliq	+=" F3_ALQIMP"+(cAlias)->FB_CPOLVRO+"," 
			cBase	+=" F3_BASIMP"+(cAlias)->FB_CPOLVRO+"," 
			cVal	+=" F3_VALIMP"+(cAlias)->FB_CPOLVRO+"," 
			aAdd(aAuxCamp,(cAlias)->FB_CPOLVRO)
			AADD(aVal,"F3_VALIMP"+(cAlias)->FB_CPOLVRO)
			AADD(aBas,"F3_BASIMP"+(cAlias)->FB_CPOLVRO)
			
		ENDIF
		(cAlias)->(DbSkip())
	End

    (cAlias)->(DbCloseArea())
	
	IF !Empty(cVal)
		cVal   :=SUBSTR(cVal,  1, len(cVal)-1)	
		cAuxfb+= " , "+cAliq+cBase+cVal
	ENDIF

 
Return {cAuxfb,aAuxCamp,aBas,aVal}


/*/{Protheus.doc} fGetSFH
    Función  para extraer los datos de la SFH 
    @type  Function
    @author adrian.perez
    @since 07/06/2026
	@param	cSucursal	Carácter	Código de la sucursal o filial utilizado para consultar las tablas SFH y SFB.
	@param	cPedIni		Carácter	Período inicial en formato AAAAMM, utilizado para calcular el rango de fechas de vigencia.
	@param	cCli		Carácter	Código del cliente a consultar.
	@param	cLoja		Carácter	Código de la tienda o sucursal del cliente.
	@param	cCampo		Carácter	Código fiscal (FB_CPOLVRO) utilizado como filtro de búsqueda.
	@param  cCliPadr    numerico    Indica si filtra por aquellos que vienen de padron(TXT) o no 
    @param  oQryExFH    objeto      Guarda el objeto del FwExecStatement para la query y sus filtros
	@return aAux		Arreglo		Retorna un arreglo con dos posiciones:  1	FH_CRC	Código CRC asociado al impuesto.
																			2	FH_ZONFIS	Zona fiscal del cliente.
																			3	FH_CAMPO7	Campo fiscal complementario.
																			4	FH_IMPOSTO	Código del impuesto.
																			5	FH_ALIQ	Alícuota principal aplicada.
																			6	FH_ALISIJ	Alícuota SIF/SIJ.
																			7	FH_ALIVNI	Alícuota VNI.
	@return nil
    /*/  
Static function	fGetSFH(cSucursal,cPedIni,cCli,cLoja,cCampo,cCliPadr,oQryExFH)

Local   cQryFH		:=  ""
Local 	nOrd 		:= 	1	
Local   dDataIni    :=CTOD("\\")
Local   dDataFim    :=CTOD("\\")
Local   cSFH		:=""
Local  aAux:={}
DEFAULT cSucursal	:=""
DEFAULT cPedIni		:=""
DEFAULT cCli		:=""
DEFAULT cLoja		:=""
DEFAULT cCampo		:=""
DEFAULT cCliPadr	:=""
DEFAULT oQryExFH    :=NIL


	dDataIni := CTOD("01/"+SUBSTR(cPedIni,5,2)+"/"+SUBSTR(cPedIni,1,4))
	dDataFim := LastDay(dDataIni)
	
	
	
	

			if oQryExFH==NIL
				cQryFH += "SELECT SFH.FH_PADSIR , SFH.FH_IMPOSTO, SFH.FH_CRC,SFH.FH_ZONFIS,SFH.FH_CAMPO7 ,"
				cQryFH += " SFH.FH_ALIQ,SFH.FH_ALISIJ,SFH.FH_ALIVNI , SFB.FB_CPOLVRO"
				cQryFH += " FROM      	"+RetSqlName("SFH")+" SFH "	
				cQryFH += " INNER JOIN 	"+RetSqlName("SFB")+" SFB ON SFB.FB_CODIGO=SFH.FH_IMPOSTO AND SFB.FB_ESTADO=FH_ZONFIS  "
				cQryFH += "  WHERE SFH.FH_FILIAL = ? "
				cQryFH += "  AND SFB.FB_FILIAL= ? "
				cQryFH += "  AND SFH.FH_INIVIGE     >= ?  AND SFH.FH_FIMVIGE   <= ? "	
				cQryFH +="   AND SFH.FH_CLIENTE    = ? " 
				cQryFH +="   AND SFH.FH_LOJA        = ? " 
				cQryFH +="   AND  SFB.FB_CPOLVRO     =?"
				cQryFH +="   AND  SFH.FH_PADSIR=? "
				cQryFH +="   AND SFB.FB_CLASSIF= ? AND SFB.FB_CLASSE=? AND SFB.FB_TIPO=? "
				cQryFH+="    AND SFH.D_E_L_E_T_ = ?  "
				cQryFH+="   AND SFB.D_E_L_E_T_ = ? "
				cQryFH += " ORDER BY "
				cQryFH += " CASE "
				cQryFH += " When FH_FIMVIGE = '' THEN '99999999' "
				cQryFH += " Else FH_FIMVIGE "
				cQryFH += " End DESC, "
				cQryFH += " FH_INIVIGE DESC "

				cQryFH := ChangeQuery(cQryFH)
				oQryExFH := FwExecStatement():New(cQryFH)
			ENDIF
		
			oQryExFH:SetString(nOrd++, xFilial("SFH",cSucursal))       // filial SFH
			oQryExFH:SetString(nOrd++, xFilial("SFB",cSucursal))       //filial   SFB
			oQryExFH:SetString(nOrd++, DTOS(dDataIni))        		   //Fecha inicial
			oQryExFH:SetString(nOrd++, DTOS(dDataFim))        		   //Fecha final
			oQryExFH:SetString(nOrd++, cCli	)        			       //Desde cliente		
			oQryExFH:SetString(nOrd++, cLoja	)        			   //Desde tienda
			oQryExFH:SetString(nOrd++, cCampo	)        			   //Desde tienda
			oQryExFH:SetString(nOrd++, cCliPadr)		   // cCliPadr	
			oQryExFH:SetString(nOrd++,"1")
			oQryExFH:SetString(nOrd++,"P")
			oQryExFH:SetString(nOrd++,"P")
			oQryExFH:SetString(nOrd++, SPACE(1)		) 				   //SFH.D_E_L_E_T_
			oQryExFH:SetString(nOrd++, SPACE(1)		) 				   //SFB.D_E_L_E_T_
			
			cSFH := oQryExFH:OpenAlias()

			If !(cSFH)->(Eof())
				 
				aadd(aAux,(cSFH)->FH_CRC  )
				aadd(aAux,(cSFH)->FH_ZONFIS  )
				aadd(aAux,(cSFH)->FH_CAMPO7  )
				aadd(aAux,(cSFH)->FH_IMPOSTO )
				aadd(aAux,(cSFH)->FH_ALIQ )
				aadd(aAux,(cSFH)->FH_ALISIJ  )
				aadd(aAux,(cSFH)->FH_ALIVNI 	 )

			
			ENDIF

			
			If Select(cSFH) > 0
				(cSFH)->(DbCloseArea())
			EndIf

RETURN aAux

/*/{Protheus.doc} fTablaTXT
Función para la definición de la estructura de la tabla temporal para guardar datos
@type Function
@author adrian.perez
@since 04/06/2026
@param  cTRBn: Contiene el alias de la tabla temporal para el archivo
@return  nil
 /*/
Static function fTablaTXT(cTRBn)
Local aStr		:={}
Local aOrdem	:= {}
Local oTmpTable1:= NIL
DEFAULT  cTRBn:=""

	aAdd(aStr, {"CUIT"	    , "C", 16	, 0}) 
	aAdd(aStr, {"CRC"	    , "C", 02	, 0}) 
	aAdd(aStr, {"FECHA"  	, "D", 10	, 0})
	aAdd(aStr, {"TipoReg"	, "N", 01	, 0}) 
	aAdd(aStr, {"TipoPer"	, "N", 02	, 0}) 
	aAdd(aStr, {"CodOpe"	, "N", 02	, 0}) 
	aAdd(aStr, {"Juris"	    , "N", 03	, 0}) 
	aAdd(aStr, {"TipoComp"	, "N", 03	, 0}) 
	aAdd(aStr, {"LeComp"	, "C", 01	, 0}) 
	aAdd(aStr, {"PV"	    , "C", 05	, 0}) 
	aAdd(aStr, {"NUM"	    , "C", 13	, 0}) 
	aAdd(aStr, {"BASE"	    , "N", 18	, 2}) 
	aAdd(aStr, {"ALIQ"	    , "N", 5	, 2}) 
	aAdd(aStr, {"VAL"	    , "N", 18	, 2}) 
	aAdd(aStr, {"NumComp"	, "C", 01	, 1}) 
	aAdd(aStr, {"CRC1"		, "C", 01	, 1})  
	aAdd(aStr, {"ABM"		, "C", 01	, 1}) 
	aOrdem := {"CUIT"}//llave primaria de la tabla temporal

	oTmpTable1:= FWTemporaryTable():New(cTRBn)
	oTmpTable1:SetFields(aStr)
	oTmpTable1:AddIndex("IN1", aOrdem)
	oTmpTable1:Create()

	FreeObj(oTmpTable1)

return nil


/*/{Protheus.doc} FIS848UP
Función para guardar en tabla temporal
@type Function
@author adrian.perez
@since 05/06/2026
@	param	cTRBn		Carácter		Alias de la tabla temporal o área de trabajo donde se insertará el registro.
@	param	cCUIT		Carácter		CUIT del contribuyente.
@	param	cCRC		Carácter		Código CRC asociado al registro.
@	param	dFecha		Fecha			Fecha del documento.
@	param	nTipoReg	Numérico		Tipo de registro el único valor posible es “1 - Régimen General”
@	param	nTipoPer	Numérico		Tipo de percepción 1-Percepción 4-No Inscripto, 5-Sobretasa   
@	param	nCodOpe		Numérico		Código de operación Por el momento el único valor posible es “0 - Inexistente”
@	param	nJuris		Numérico		Código de jurisdicción fiscal (901,902,etc).
@	param	cTipo		Numérico		Tipo de documento por el momento solo existe 1-  Factura ,2-  Nota de Débito 102-Nota Crédito 
@	param	cLeComp		Carácter		Letra del documento.
@	param	cPV			Carácter		Punto de venta .
@	param	cNum		Carácter		Número del documento.
@	param	nBase		Numérico		Base imponible utilizada para calcular la percepción.
@	param	nAliq		Numérico		Alícuota aplicada al cálculo.
@	param	nVal		Numérico		Valor de percepción informado .
@	param	cNumC		Carácter		Número de comprobante original   Por ahora se lleva en blanco pq no tenemos documentos de devolución.
@	param	cCRC1		Carácter		Código CRC secundario o complementario en blanco por el momento
@	param	cABM		Carácter		Indicador de Alta, Baja o Modificación del registro por el momento A
@	param	lSobretasa	Lógico			Indica si aplica sobretasa (.T. = Sí, .F. = No).
@	param	nValorRe	Numérico		Valor adicional relacionado con recálculos o sobretasas.
@return     nValReg     Numérico		Valor percepcion 
	
 /*/
Function FIS848UP(cTRBn,cCUIT,cCRC,dFecha,nTipoReg,nTipoPer,nCodOpe,nJuris,cTipo,cLeComp,cPV,cNum,nBase,nAliq,nVal,cNumC,cCRC1,cABM,lSobretasa,nValorRe)
	
	Local nValReg:=0 
	Local nTipo	:=1
	Local nTotal:=0
	Local nDif:=0
	Default cTRBn   	:= ""
	Default cCUIT		:=""
	Default cCRC		:=""
	Default dFecha		:= CTOD("\\")
	Default nTipoReg	:= 0
	Default nTipoPer	:= 0
	Default nCodOpe		:= 0
	Default nJuris		:= 0
	Default nTipo       := 0
	Default cLeComp		:=""
	Default cPV			:=""
	Default cNum		:=""
	Default nBase		:= 0
	Default nAliq		:=0
	Default nVal		:=0
	Default cNumC		:=""
	Default cCRC1		:=""
	Default cABM		:=""
	Default lSobretasa	:=.F.
	Default nValorRe	:=0
	
	nValReg:= nBase* (nAliq/100)  
	nValReg:= Round(nValReg,MsDecimais(1))
	if nValReg!=nVal .AND. !lSobretasa
		nValReg:=nVal
	ENDIF
	If lSobretasa .AND. nValorRe>0
		nTotal:=nValReg+nValorRe
		IF nTotal>nVal
			nDif:=Abs(nTotal-nVal)
		
			if nValReg>= nDif 
				nValReg-=nDif
			endif

		ENDIF
	ENDIF

	IF cTipo $ "NC"
		nTipo:=2
	ENDIF
	IF cTipo $ "ND"
		nTipo:=102
	ENDIF

	If !Empty(cTRBn)
		RecLock(cTRBn,.T.)
	
		(cTRBn)->CUIT 		:= cCUIT	
		(cTRBn)->CRC 		:= cCRC	
		(cTRBn)->FECHA 		:= dFecha	
		(cTRBn)->TipoReg 	:= nTipoReg	
		(cTRBn)->TipoPer 	:= nTipoPer
		(cTRBn)->CodOpe 	:= nCodOpe
		(cTRBn)->Juris  	:= nJuris
		(cTRBn)->TipoComp   := nTipo
		(cTRBn)->LeComp     := cLeComp
		(cTRBn)->PV     	:= cPV
		(cTRBn)->NUM     	:= cNum
		(cTRBn)->BASE     	:= nBase
		(cTRBn)->ALIQ     	:= nAliq
		(cTRBn)->VAL     	:= nValReg
		(cTRBn)->NumComp    := cNumC
		(cTRBn)->CRC1	    := cCRC1
		(cTRBn)->ABM	    := cABM

		(cTRBn)->(MsUnlock())
	EndIf
	

Return nValReg


/*/{Protheus.doc} FD848DERE
Función para la definición de la estructura del reporte
@type Function
@author adrian.perez
@since 05/06/2026
@param 
	cTRBn: Contiene el alias de la tabla temporal para el archivo
@return 
	olReport: Objeto con la estructura del reporte a generar
 /*/
Static Function FD848DERE(cTRBn)
	
    Local olReport := nil
    Local oSection := nil

	Default cTRBn := ""

    olReport:=TReport():New(STR0005,STR0005,,{|olReport| FP848IMRE(olReport,cTRBn)},"SEPA2") //"NOMBRE DEL ARCHIVO A GENERAR" //"REPORTE DE IVA SIMPLE - "

    oSection:=TRSection():new(olReport,"SEPA_4",{cTRBn})//"NOMBRE DEL ARCHIVO A GENERAR"
    olReport:SetLandScape(.T.)
		
	TRCell():New(oSection, STR0060		, , ,"@!"			, 16,,,"CENTER",,"CENTER")  			// STR0060 -'CUIT'
	TRCell():New(oSection, STR0061		, , ,"@!"			, 02,,,,,"CENTER") 						// STR0061-'CRC'
	TRCell():New(oSection, STR0062		, , ,"@!"			, 10,,,,,"CENTER") 						// STR0062-'Fecha'
	TRCell():New(oSection, STR0063		, , ,"@E 9"			, 01,,,,,"CENTER") 						// STR0063-'TipoReg'
	TRCell():New(oSection, STR0064		, , ,"@E 99"		, 02,,,,,"CENTER") 						// STR0064-'TipoPer'
	TRCell():New(oSection, STR0065		, , ,"@E 99"		, 02,,,,,"CENTER") 						// STR0065- 'CodOpe'
	TRCell():New(oSection, STR0066		, , ,"@E 999"		, 03,,,,,"CENTER") 						// STR0066- 'Jurisdicción'
	TRCell():New(oSection, STR0067		, , ,"@E 999"		, 03,,,,,"CENTER") 						// STR0067- 'Tipo comprobante'
	TRCell():New(oSection, STR0068		, , ,"@!"			, 01,,,"CENTER",,"CENTER") 				// STR0068- 'Letra comprobante'
	TRCell():New(oSection, STR0069	    , , ,"@!"			, 05,,,,,"CENTER") 						// STR0069-'Punto Venta'
	TRCell():New(oSection, STR0070		, , ,"@!"			, 13,,,,,"CENTER") 						// STR0070-'Número comp.'
	TRCell():New(oSection, STR0071		, , ,"@E 999999999999999999.99"	, 20,,,,,"CENTER") 			// STR0071-'Monto Suj. a Perc.' 
	TRCell():New(oSection, STR0072		, , ,"@E 999.99"				, 20,,,,,"CENTER")			// STR0072- 'Alícuota' 
	TRCell():New(oSection, STR0073		, , ,"@E 999999999999999999.99"	, 20) 						// STR0073-"Monto Perc./Dev."
	TRCell():New(oSection, STR0074 		, , ,"@!"	, 1,,,,,"CENTER") 								// STR0074-N. Ori (Anul./Dev.) 	 
	TRCell():New(oSection, STR0075 		, , ,"@!"	, 1,,,,,"CENTER")								// STR0075-CRC Dev.								
	TRCell():New(oSection, STR0076 		, , ,"@!"	, 1,,,,,"CENTER")								// STR0076 -ABM

Return olReport



/*/{Protheus.doc} FP848IMRE
Función para la impresión del reporte
@type Function
@author adrian.perez
@since 05/06/2026
@param  olReport Objeto con la estructura del reporte a generar
@param  cAlias   caracter alias de la tabla a usar para extraer información y generar reporte
@return nil
@param 
@return nil /*/
Static Function FP848IMRE(olReport,cAlias)
   
    Local olSection := olReport:Section(1)

	DEFAULT olReport:=NIL
	DEFAULT cAlias	:=""

	olReport:Section(1):Cell(STR0060):SetBlock		({|| (cAlias)->CUIT	     })     // STR0060 -'CUIT'
	olReport:Section(1):Cell(STR0061):SetBlock		({|| (cAlias)->CRC	 	 })     // STR0061-'CRC'
	olReport:Section(1):Cell(STR0062):SetBlock		({|| (cAlias)->Fecha	 })     // STR0062-'Fecha'	
	olReport:Section(1):Cell(STR0063):SetBlock		({|| (cAlias)->TipoReg	 })     // STR0063-'TipoReg'	
	olReport:Section(1):Cell(STR0064):SetBlock		({|| (cAlias)->TipoPer	 })     // STR0064-'TipoPer'	
	olReport:Section(1):Cell(STR0065):SetBlock		({|| (cAlias)->CodOpe	 })     // STR0065- 'CodOpe'	
	olReport:Section(1):Cell(STR0066):SetBlock		({|| (cAlias)->Juris 	 })     // STR0066- 'Jurisdicción'	
	olReport:Section(1):Cell(STR0067):SetBlock		({|| (cAlias)->TipoComp 	 })     // STR0067- 'Tipo comprobante'	
	olReport:Section(1):Cell(STR0068):SetBlock		({|| (cAlias)->LeComp 	 })     // STR0068- 'Letra comprobante'	
	olReport:Section(1):Cell(STR0069):SetBlock		({|| (cAlias)->PV	 	 })     // STR0069-'Punto Venta'	
	olReport:Section(1):Cell(STR0070):SetBlock		({|| (cAlias)->NUM	 	 })     // STR0070-'Número comp.'                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
	olReport:Section(1):Cell(STR0071):SetBlock		({|| (cAlias)->BASE	 	 })     // STR0071-'Monto Suj. a Perc.' 		
	olReport:Section(1):Cell(STR0072):SetBlock		({|| (cAlias)->ALIQ	 	 })     // STR0072- 'Alícuota'	
	olReport:Section(1):Cell(STR0073):SetBlock		({|| (cAlias)->VAL	 	 })     // STR0073-"Monto Perc./Dev."
	olReport:Section(1):Cell(STR0074):SetBlock		({|| (cAlias)->NumComp	 })     // STR0074-N. Ori (Anul./Dev.) 	 
	olReport:Section(1):Cell(STR0075):SetBlock		({|| (cAlias)->CRC1	 	 })     // STR0075-CRC Dev.			
	olReport:Section(1):Cell(STR0076):SetBlock		({|| (cAlias)->ABM	 	 })     // STR0076 -ABM
    olSection:Print()

Return Nil

/*/{Protheus.doc} FE848TRIS
Función para para la exportación del informe del texto de Iva Simple
@type Function
@author adrian.perez
@since 05/06/2026
@param 
	cArq = Alias de la tabla temporal a usar
@return nil /*/

Static Function FE848TRIS(cArq)

    Local olReport := nil

	Default cArq := ""

    If TRepInUse()
        olReport := FD848DERE(cArq)
        olReport:PrintDialog()
    EndIf
	
Return Nil



/*/{Protheus.doc} fgetNumPV
	Obtiene el número de documento y el PV
	@author adrian.perez
	@since 05/06/2026
	@version version
	@param 	cDoc,Carácter, número de documento fiscal
	@return {cDoc,cPV},arreglo, {número de documento fiscal, punto de venta}
	
	/*/
Static Function fgetNumPV(cDoc)

Local  nTamC	:= GetSX3Cache("F3_NFISCAL","X3_TAMANHO")
Local  cDocAux	:=cDoc
Local 	cPV		:=""

DEFAULT cDoc:=""

	IF  nTamC >12
		cDoc:=SUBSTR(ALLTRIM(cDoc),6,nTamC)
		cPV:=SUBSTR(ALLTRIM(cDocAux),1,5)
	ELSE
		cDoc:=SUBSTR(ALLTRIM(cDoc),5,nTamC)
		cPV:=SUBSTR(ALLTRIM(cDocAux),1,4)
	ENDIF
		
Return {cDoc,cPV}

/*/{Protheus.doc} fCreaArch
	
	Genera un archivo de texto plano a partir de los registros de una tabla
	concatenando los campos separados por el delimitador definido en la
	constante `_SEPARADOR`.

	@author adrian.perez
	@since 04/06/2026
	
	@param cDir       Carácter Directorio donde se generará el archivo.
	@param cNombArch  Carácter Nombre del archivo a crear.
	@param cTRBn      Carácter  Alias de la tabla temporal table a recorrer.
	@return Nil       No retorna valor.	
	/*/

STATIC function fCreaArch(cDir,cNombArch,cTRBn)

Local cArchivo:= ""
Local cDato:=""
Local cFecha:=""
Local oFile := Nil
Local  nTot:=0
DEFAULT cDir		:=""
DEFAULT cNombArch	:=""
DEFAULT cTRBn		:=""

	
	IF !Empty(cNombArch) .AND. !Empty(cDir)
		cArchivo:=cDir+cNombArch
		oFile :=FWFileWriter():New(cArchivo, .T.,_BUFFER)
		ProcRegua((cTRBn)->(RecCount()) )
		While !( (cTRBn)->(Eof()) ) 
			nTot++
			IncProc(STR0081+ cValToChar(nTot)) // STR0081 "Grabando en txt registro "
			
			cFecha :=	StrZero(Day((cTRBn)->FECHA ),2) + "/" + ;
						StrZero(Month((cTRBn)->FECHA ),2) + "/" + ;
						CValToChar(Year((cTRBn)->FECHA ))

			cDato+=ALLTRIM(			(cTRBn)->CUIT 		 	)+_SEPA2
			cDato+=ALLTRIM(			(cTRBn)->CRC 		 	)+_SEPA2
			cDato+=ALLTRIM(			cFecha					)+_SEPA2
			cDato+=ALLTRIM(			STR((cTRBn)->TipoReg) 	)+_SEPA2
			cDato+=ALLTRIM(			STR((cTRBn)->TipoPer) 	)+_SEPA2
			cDato+=ALLTRIM(			STR((cTRBn)->CodOpe)	)+_SEPA2
			cDato+=ALLTRIM(			STR((cTRBn)->Juris)  	)+_SEPA2
			cDato+=ALLTRIM(			STR((cTRBn)->TipoComp)  )+_SEPA2
			cDato+=ALLTRIM(			(cTRBn)->LeComp     	)+_SEPA2
			cDato+=ALLTRIM(			(cTRBn)->PV     		)+_SEPA2
			cDato+=ALLTRIM(			(cTRBn)->NUM     		)+_SEPA2
			cDato+=ALLTRIM(			STR((cTRBn)->BASE,20,2)     	)+_SEPA2
			cDato+=ALLTRIM(			STR((cTRBn)->ALIQ,20,2)     	)+_SEPA2
			cDato+=ALLTRIM(			STR((cTRBn)->VAL,20,2)     	)+_SEPA2
			cDato+=ALLTRIM(			(cTRBn)->NumComp    	)+_SEPA2
			cDato+=ALLTRIM(			(cTRBn)->CRC1	    	)+_SEPA2
			cDato+=ALLTRIM(			(cTRBn)->ABM	    	)+_SEPA2
			cDato+= CHR(13) + CHR(10)
		
			(cTRBn)->(dbSkip())
		END
		If !oFile:Exists()
			oFile:Create()
		else
			oFile:Clear(.T.)
		EndIf
		
		
		if oFile:Write(cDato)
			oFile:Close() 
		endif 
		
		
	
		FreeObj(oFile)

	ENDIF

return nil


/*/{Protheus.doc} fToSF3
	Extrae el total de los registros de la SFH que coinciden con los criterios para exportación
	@author adrian.perez
	@since 16/06/2026
	
	@param	cSucursal	Carácter		Código de sucursal/filial utilizado para filtrar los datos en las tablas SF3 y SA1 (mediante la función xFilial).
	@param	dPedIni		Fecha		Fecha inicial del rango de emisión (F3_EMISSAO) para los registros a consultar.
	@param	dPedFin		Fecha		Fecha final del rango de emisión (F3_EMISSAO).
	@param	cDesdeCli	Carácter	Código de cliente inicial (rango “desde”) para filtrar F3_CLIEFOR.
	@param	cHastaCli	Carácter	Código de cliente final (rango “hasta”) para filtrar F3_CLIEFOR.
	@param	cDesdeLoja	Carácter	Código de tienda/sucursal del cliente inicial (rango “desde”) para filtrar F3_LOJA.
	@param	cHastaLoja	Carácter	Código de tienda/sucursal del cliente final (rango “hasta”) para filtrar F3_LOJA.
	@param	cAuxfb		Carácter	Parámetro auxiliar no utilizado dentro de la función. (Posiblemente reservado para lógica futura o compatibilidad).

	@return nTotal      Numérico 	total de regisros SF3	
	/*/



function fToSF3(cSucursal,dPedIni,dPedFin,cDesdeCli,cHastaCli,cDesdeLoja,cHastaLoja,cAuxfb)
Local cQry:=""
Local oQryExec:=NIL
Local nOrd := 1
Local nTotal:=0

Default cSucursal:=""
Default dPedIni:= CTOD("\\")
Default dPedFin:= CTOD("\\")
Default cDesdeCli:= ""
Default cHastaCli:=""
Default cDesdeLoja:=""
Default cHastaLoja:=""
Default cAuxfb:=""


				
		cQry := " SELECT COUNT(*) TOTAL "	
		cQry += " FROM      	"+RetSqlName("SF3")+" SF3 "	
		cQry += " LEFT JOIN 	"+RetSqlName("SA1")+" SA1 ON    SA1.A1_COD=F3_CLIEFOR  AND SA1.A1_LOJA =SF3.F3_LOJA "
		cQry += "  WHERE SF3.F3_FILIAL = ? "
		cQry += "  AND   SA1.A1_FILIAL = ? "
		cQry += "  AND SF3.F3_EMISSAO     >= ?  AND SF3.F3_EMISSAO   <= ? "	
		cQry +="   AND SF3.F3_CLIEFOR     >= ?  AND SF3.F3_CLIEFOR   <= ? "
		cQry +="   AND SF3.F3_LOJA        >= ?  AND SF3.F3_LOJA      <= ? "
						
		cQry+="    AND SF3.D_E_L_E_T_ = ?  "
		cQry+="    AND SA1.D_E_L_E_T_ = ?  " 
		cQry := ChangeQuery(cQry)
		oQryExec := FwExecStatement():New(cQry)
	
		oQryExec:SetString(nOrd++, xFilial("SF3",cSucursal))     	// filial SF3
		oQryExec:SetString(nOrd++, xFilial("SA1",cSucursal))     	// filial SA1
		
		oQryExec:SetString(nOrd++, DTOS(dPedIni))        		      //Fecha inicial
		oQryExec:SetString(nOrd++, DTOS(dPedFin))        		      //Fecha final
		oQryExec:SetString(nOrd++, cDesdeCli	)        			  //Desde cliente
		oQryExec:SetString(nOrd++, cHastaCli	)        			  //Hasta cliente
		oQryExec:SetString(nOrd++, cDesdeLoja	)        			  //Desde tienda
		oQryExec:SetString(nOrd++, cHastaLoja	)        			  //Hasta tienda
		oQryExec:SetString(nOrd++, SPACE(1)		) 					  //SF3.D_E_L_E_T_
		oQryExec:SetString(nOrd++, SPACE(1)		) 					  //SA1.D_E_L_E_T_

		nTotal := oQryExec:ExecScalar('TOTAL')
		oQryExec:Destroy()
		oQryExec:=NIL

return nTotal
