#INCLUDE "PROTHEUS.ch"
#INCLUDE "TOPCONN.ch"
#INCLUDE "TLPP-CORE.TH"
#INCLUDE "PROTHEUS.CH"
#INCLUDE "TBICONN.CH"
#INCLUDE 'FILEIO.CH'
#INCLUDE "BACKOFFICE.FISCAL.FISA845.CH"

	Static aConfSFB:= {}
	Static nLoop := 1
	Static cNTSuC	:=_aTotal[6][1][3] //sujeto comprador
	Static cNTAli	:=_aTotal[6][1][4] //alicuota
	Static cNTCoC	:=_aTotal[6][1][5] //conceptos credito
	Static cNTCDe	:=_aTotal[6][1][6] //conceptos debito 1
	Static cNTCRD	:=_aTotal[6][1][7] //conceptos debito 2
	Static oJEq3:=  JsonObject():New() //Json para tab temporal de la tabla de equivalencia alicuotas 
	Static oJEq2:=  JsonObject():New() //Json para tab temporal de la tabla de equivalencia conceptos archivo 1
	Static oJEq1:=  JsonObject():New() //Json para tab temporal de la tabla de equivalencia conceptos archivo 2
	Static oJEq4:=  JsonObject():New() //Json para tab temporal de la tabla de equivalencia conceptos archivo 3
	Static oJEq5:=  JsonObject():New() //Json para tab temporal de la tabla de equivalencia conceptos archivo 4
	Static oTmpTable3 := Nil //Tabla temporal del archivo 3
	Static oTmpTable4 := Nil //Tabla temporal del archivo 4
	Static oTmpTable1 := Nil //Tabla temporal del archivo 1
	Static oTmpTable2 := Nil //Tabla temporal del archivo 2

/*/{Protheus.doc} IVASIM
Generación Archivos de Iva Simple 
@type Function
@author brenda.ramirez
@since 07/10/2025
@param no aplica
@return 
	aArqTrab: Area de trabajo
/*/
Function IVASIM()
	Local aStr:={}
	Local aStr1:={}
    Local aStrDBFI := {}//Array con la estructura del 3 archivo
	Local aStrRDBFI := {}//Array con la estructura del 4 archivo
    Local cOpc := SubStr(_aTotal[6][1][1],1,1)//Auxiliar para saber el archivo seleccionado
	Local aOrdem	:= {}//Array con el orden a tomar de los archivos
	Local aSucEmp := {} //Arreglo con la información de las sucursales seleccionadas
	Local nAux := 1 //Auxiliar para recorrido de las sucursales
	Local nProsFil := 1	//Auxiliar para el recorrido del conteo de cuantas sucursales existentes
	Local nAuxO:=1 //Auxiliar para identificar las sucursales ocupadas
	Local nPos := 0 //Trae la posición de la sucursal en el arreglo de sucursales
	
	Private aArqTrab	:= {} //Array del area de trabajo
	Private cTRB3    := 'IS3OPGDEB' //Nombre de la tabla temporal del archivo 3
	Private cTRB4    := 'IS4OPGRDE' //Nombre de la tabla temporal del archivo 4
	Private cTRB1    := 'IV1CFNFND' //Nombre de la tabla temporal del archivo 1
	Private cTRB2    := 'IV2CFNCP' //Nombre de la tabla temporal del archivo 2
	Static	lError := .T. //Variable auxiliar para saber cuando alguna de las tablas de equivalencia no existe

	//Estructura para el archivo 3 - Operaciones que generan débito fiscal
	aAdd(aStrDBFI, {"LLAVE1"	, "C", 15	, 0}) //Actividad*
	aAdd(aStrDBFI, {"ACTDEC"	, "C", 06	, 0}) //Actividad*
	aAdd(aStrDBFI, {"TPVENT"	, "C", 01	, 0}) //Tipo de operación*
	aAdd(aStrDBFI, {"TIPO"		, "C", 01	, 0}) //Tipo de sujeto comprador*
	aAdd(aStrDBFI, {"ALICUOTA"	, "C", 12	, 0}) //Código de alícuota*
	aAdd(aStrDBFI, {"MONGRA"	, "N", 15	, 2}) //Monto neto gravado 
	aAdd(aStrDBFI, {"DEBFIS"	, "N", 15	, 2}) //Débito fiscal facturado
	aAdd(aStrDBFI, {"DEFIOP"	, "N", 15	, 2}) //Débito fiscal operación en pago
	aAdd(aStrDBFI, {"MONEX"		, "N", 15	, 2}) //Monto neto excento o no gravado

	aOrdem := {"LLAVE1"}//llave primaria de la tabla temporal

	oTmpTable3 := FWTemporaryTable():New(cTRB3)
	oTmpTable3:SetFields(aStrDBFI)
	oTmpTable3:AddIndex("IN1", aOrdem)
	oTmpTable3:Create()

	aAdd(aArqTrab,{'oTmpTable3',cTRB3})

	//Estructura para el archivo 3 - Operaciones que generan débito fiscal
	aAdd(aStrRDBFI, {"LLAVE1"	, "C", 15	, 0}) //Actividad*
	aAdd(aStrRDBFI, {"ACTDEC"	, "C", 06	, 0}) //Actividad*
	aAdd(aStrRDBFI, {"TPVENT"	, "C", 01	, 0}) //Tipo de operación*
	aAdd(aStrRDBFI, {"TIPO"		, "C", 01	, 0}) //Tipo de sujeto comprador*
	aAdd(aStrRDBFI, {"ALICUOTA"	, "C", 12	, 0}) //Código de alícuota*
	aAdd(aStrRDBFI, {"MONGRA"	, "N", 15	, 2}) //Monto neto gravado 
	aAdd(aStrRDBFI, {"DEBFIS"	, "N", 15	, 2}) //Débito fiscal facturado
	aAdd(aStrRDBFI, {"MONEX"	, "N", 15	, 2}) //Monto neto excento o no gravado

	aOrdem := {"LLAVE1"}//llave primaria de la tabla temporal

	oTmpTable4 := FWTemporaryTable():New(cTRB4)
	oTmpTable4:SetFields(aStrRDBFI)
	oTmpTable4:AddIndex("IN1", aOrdem)
	oTmpTable4:Create()

	aAdd(aArqTrab,{'oTmpTable4',cTRB4})


	//Estructura para el archivo 3 - Operaciones que generan débito fiscal
	aAdd(aStr, {"LLAVE1"	, "C", 06	, 0}) //Actividad*
	aAdd(aStr, {"TPVENT"	, "C", 01	, 0}) //Tipo de operación*
	aAdd(aStr, {"ALICUOTA"	, "C", 04	, 0}) //Código de alícuota*
	aAdd(aStr, {"BASE"		, "N", 15	, 2}) //Monto neto gravado 
	aAdd(aStr, {"VAL1"		, "N", 15	, 2}) //Crédito fiscal facturado
	aAdd(aStr, {"VAL2"		, "N", 15	, 2}) //Crédito fiscal computable

	aOrdem := {"LLAVE1"}//llave primaria de la tabla temporal

	oTmpTable1 := FWTemporaryTable():New(cTRB1)
	oTmpTable1:SetFields(aStr)
	oTmpTable1:AddIndex("IN1", aOrdem)
	oTmpTable1:Create()

	aAdd(aArqTrab,{'oTmpTable1',cTRB1})

	//Estructura para el archivo 3 - Operaciones que generan débito fiscal
	aAdd(aStr1, {"LLAVE1"	, "C", 06	, 0}) //Actividad*
	aAdd(aStr1, {"TPVENT"	, "C", 01	, 0}) //Tipo de operación*
	aAdd(aStr1, {"ALICUOTA"	, "C", 04	, 0}) //Código de alícuota*
	aAdd(aStr1, {"BASE"		, "N", 15	, 2}) //Monto neto gravado 
	aAdd(aStr1, {"VAL1"		, "N", 15	, 2}) //Crédito fiscal facturado
	

	aOrdem := {"LLAVE1"}//llave primaria de la tabla temporal

	oTmpTable2 := FWTemporaryTable():New(cTRB2)
	oTmpTable2:SetFields(aStr1)
	oTmpTable2:AddIndex("IN1", aOrdem)
	oTmpTable2:Create()

	aAdd(aArqTrab,{'oTmpTable2',cTRB2})

	


	 IF MV_PAR07==1
        //Verifica las sucursales que se ocuparan
		For nProsFil:=1 to len(aFilsCalc) //se revisa que surcusales fueron seleccionadas		 
			If aFilsCalc[nProsFil,1] == .T. // se crea arreglo con las sucursales seleccionadas										
				 aadd(aSucEmp,aFilsCalc[nProsFil][2])															
			EndIf
		Next nProsFil
    Else
        aadd(aSucEmp,FWCodFil())
    ENDIF

	IF !FG845JEQU(cNTAli,@oJEq1)//Json para tab temporal de la tabla de equivalencia alicuotas IS1A
		lError := .F.
	EndIf
	If !FG845JEQU(cNTCoC,@oJEq2)//Json para tab temporal de la tabla de equivalencia conceptos archivo 1
		lError := .F.
	EndIf
	If !FG845JEQU(cNTCDe,@oJEq3)//Json para tab temporal de la tabla de equivalencia conceptos archivo 3
		lError := .F.
	EndIf
	If !FG845JEQU(cNTCRD,@oJEq4)//Json para tab temporal de la tabla de equivalencia conceptos archivo 4
		lError := .F.
	EndIf
	If !FG845JEQU(cNTSuC,@oJEq5)//Json para tab temporal de la tabla de equivalencia sujeto comprador
		lError := .F.
	EndIf

	IF lError
		IF cOpc == '1' //1 - Crédito Fiscal
			
			F845TAB1(cTRB1,aSucEmp)
			FE845TRIS(cTRB1)
		ElseIf cOpc == '2'//2 - Restitución Crédito Fiscal
			F845TAB2(cTRB2,aSucEmp)
			FE845TRIS(cTRB2)
		ElseIf cOpc == '3'//3 - Débito Fiscal
			FG845DEFI(cTRB3,aSucEmp)
			FE845TRIS(cTRB3)
		ElseIf cOpc == '4'//4 - Restitución Débito Fiscal
			FG845RDEFI(cTRB4,aSucEmp)
			FE845TRIS(cTRB4)
		ElseIf cOpc == '5'//5 - Reporte Simplificado del Iva Simple
			Help(" ",1,STR0012,,STR0013,4,5)
			lError := .F.
		EndIf
	EndIf
	
	IF MV_PAR07 == 1
		FOR nAuxO:=1 to len(aSucEmp)
			aFilsCalc[nAuxO,1] := .F.
		NEXT
	ELSE
		nPos   := ASCAN(aFilsCalc, { |x| (x[2]) == aSucEmp[nAux] })//Sirve para saber la sucursal actual por eso queda fijo el nAux
		IF nPos > 0 .and. aFilsCalc[nPos,1] == .T.
			aFilsCalc[nPos,1] := .F.
		ENDIF
	ENDIF

Return aArqTrab 

/*/{Protheus.doc} FG845DEFI
Genera Archivo de Débito Fiscal - Iva simple
@type Function
@author brenda.ramirez
@since 07/10/2025
@param 
	cTRBn: Contiene el alias de la tabla temporal para el archivo 3.
	aSucursal: Array con las sucursales seleccionadas
@return nil /*/
Static Function FG845DEFI(cTRBn,aSucursal)

    Local cQry := "" //Query de para obtener la info necesaria para la tabla
	Local nOrd := 1	//numero de ? para sustituir en la query de acuerdo con el FWStament
    Local nI := 1 //Auxiliar para el recorrido de las sucursales
	Local cEspecie1:="NF" //Filtro de los documentos para el archivo 3.
	Local cEspecie2:="NDC" //Filtro de los documentos para el archivo 3.
	Local lErrorfb := .T.
	Local oQryExec := Nil //objeto para la query
	Local cAusfb := ""
	Static oJEAcu:=  JsonObject():New() //acumulados
	Static nQtdFil := 1 //Auxiliar para el conteo de sucursales seleccionadas
	Static aColIVA :={} //Arreglo de las columnas para el impuesto IVA 
	Static cColIVA :="" //Auxiliar para las columnas correspondientes al IVA
	Static cTF3AlqIVA:="" //Auxiliar para el armado del query de las columnas para el campo D2_ALQIMP?
	Static cTF3BaseIVA:="" //Auxiliar para el armado del query de las columnas para el campo D2_BASIMP?
	Static cTF3VrIVA:="" //Auxiliar para el armado del query de las columnas para el campo D2_VALIMP?
	Default cTRBn := "" //Nombre de la tabla temporal del archivo 3
	Default aSucursal:= {} //Array con las sucursales seleccionadas

    For nI := 1 To len(aSucursal)
		lErrorfb:=.T.
        lErrorfb:= FO845OIFB(aSucursal[nI])//Función que obtiene las columnas relacionadas con el IVA
		cAusfb := cTF3AlqIVA+","+cTF3BaseIVA+","+cTF3VrIVA
	
		If lErrorfb
			//Se obtienen los registros de la SD2, SA1, SB1 y SF2 que correspondan a tipo NF o NDC en las fechas estipuladas en los parámetros iniciales
			cQry := "SELECT SB1.B1_ACTDEC, SF2.F2_TPVENT, SA1.A1_TIPO, SD2.D2_ESPECIE ESPECIE, SD2.D2_TOTAL, SF2.F2_MOEDA, SF2.F2_TXMOEDA, SF2.F2_SERIE SERIE, SF2.F2_DOC DOCNUM, SF2.F2_LOJA LOJA, SF2.F2_CLIENTE CLIFOR, SD2.D2_ITEM ITEM, "
			cQry += " ? "
			cQry += " FROM "+RetSqlName("SD2")+" SD2"
			cQry += " LEFT JOIN "+RetSqlName("SB1")+" SB1 ON SB1.B1_COD = SD2.D2_COD"
			cQry += " LEFT JOIN "+RetSqlName("SF2")+" SF2 ON SF2.F2_DOC = SD2.D2_DOC AND SF2.F2_CLIENTE = SD2.D2_CLIENTE AND SF2.F2_LOJA = SD2.D2_LOJA AND SF2.F2_ESPECIE = SD2.D2_ESPECIE AND SF2.F2_SERIE = SD2.D2_SERIE"
			cQry += " LEFT JOIN "+RetSqlName("SA1")+" SA1 ON SA1.A1_COD = SF2.F2_CLIENTE AND SA1.A1_LOJA = SF2.F2_LOJA "
			cQry += " WHERE SD2.D2_FILIAL = ? AND SB1.B1_FILIAL = ? AND SF2.F2_FILIAL = ? AND SA1.A1_FILIAL = ?"
			cQry += " AND SF2.F2_ESPECIE IN (?) AND SB1.B1_ACTDEC != ? AND SD2.D2_EMISSAO >= ? AND SD2.D2_EMISSAO <= ?"	
			cQry+=" AND SD2.D_E_L_E_T_ = ? AND SB1.D_E_L_E_T_ = ? AND SA1.D_E_L_E_T_ = ? AND SF2.D_E_L_E_T_ = ?"

			cQry := ChangeQuery(cQry)
			nOrd := 1
			oQryExec := FwExecStatement():New(cQry)
			oQryExec:SetUnsafe(nOrd++, cAusfb)
			oQryExec:SetString(nOrd++,xFilial("SD2",aSucursal[nI]))
			oQryExec:SetString(nOrd++,xFilial("SB1",aSucursal[nI]))
			oQryExec:SetString(nOrd++,xFilial("SF2",aSucursal[nI]))
			oQryExec:SetString(nOrd++,xFilial("SA1",aSucursal[nI]))
			oQryExec:SetIn(nOrd++, {cEspecie1,cEspecie2}) //Especie(NF,NCC)
			oQryExec:SetString(nOrd++,' ')
			oQryExec:SetString(nOrd++,DTOS(MV_PAR01))
			oQryExec:SetString(nOrd++,DTOS(MV_PAR02))
			oQryExec:SetString(nOrd++,' ')
			oQryExec:SetString(nOrd++,' ')
			oQryExec:SetString(nOrd++,' ')
			oQryExec:SetString(nOrd++,' ')
			
			FL845ACUM(oQryExec, cTRBn, "V") //Acumula los registros encontrados de acuerdo con la actividad, tipo de venta, tipo cliente, alicuota
			
			IF MV_PAR07 == 2
				FreeObj(oJEAcu)
				oJEAcu:=  JsonObject():New() 
			ENDIF

		EndIf
		aSize(aColIVA,0)
		cTF3AlqIVA:=""
		cTF3BaseIVA:=""
		cTF3VrIVA:=""
    Next
	IF lErrorfb
		oQryExec:Destroy()
		oQryExec := nil
	EndIf

Return Nil

/*/{Protheus.doc} FG845RDEFI
Genera Archivo de Restitución Crédito Fiscal - Iva simple
@type Function
@author brenda.ramirez
@since 07/10/2025
@param
	cTRBn: Contiene el alias de la tabla temporal para el archivo 4
	aSucursal: Array con las sucursales seleccionadas
@return nil /*/
Static Function FG845RDEFI(cTRBn,aSucursal) //FG845RDEFI
	Local cQry := "" //Query de para obtener la info necesaria para la tabla
	Local nOrd := 1	//numero de ? para sustituir en la query de acuerdo con el FWStament
	Local cEspecie1:="NCC" //Filtro de los documentos para el archivo 4.
	Local oQryExec := Nil //objeto para la query
	Local nI := 1 //Auxiliar para el recorrido de las sucursales
	Local lErrorfb := .T.
	Local cAusfb:=""//Auxiliar para juntar los campos necesarios de la SFB
	Static oJEAcu:=  JsonObject():New() //acumulados  
	Static nQtdFil := 1 //Auxiliar para el conteo de sucursales seleccionadas
	Static aColIVA :={} //Arreglo de las columnas para el impuesto IVA 
	Static cColIVA :="" //Auxiliar para las columnas del impuesto IVA
	Static cTF3AlqIVA:="" //Auxiliar para el armado del query de las columnas para el campo D2_ALQIMP?
	Static cTF3BaseIVA:="" //Auxiliar para el armado del query de las columnas para el campo D2_BASIMP?
	Static cTF3VrIVA:="" //Auxiliar para el armado del query de las columnas para el campo D2_VALIMP?
	Default cTRBn := "" //Nombre de la tabla temporal del archivo 4
	Default aSucursal:= {} //Array con las sucursales seleccionadas

	For nI := 1 To len(aSucursal)
		lErrorfb:=.T.
		lErrorfb:= FO845OIFB(aSucursal[nI])//Función que obtiene las columnas relacionadas con el IVA

		cAusfb:= cTF3AlqIVA+","+cTF3BaseIVA+","+cTF3VrIVA

		IF lErrorfb
			//Se obtienen los registros de la SD1, SA1, SB1 y SF1 que correspondan a tipo NF o NDC en las fechas estipuladas en los parámetros iniciales
			cQry := "SELECT SB1.B1_ACTDEC, SF1.F1_TPVENT, SA1.A1_TIPO, SD1.D1_ESPECIE ESPECIE, SD1.D1_TOTAL, SF1.F1_MOEDA, SF1.F1_TXMOEDA, SF1.F1_SERIE SERIE, SF1.F1_DOC DOCNUM, SF1.F1_LOJA LOJA, SF1.F1_FORNECE CLIFOR, SD1.D1_ITEM ITEM, "
			cQry +=" ? "
			cQry += " FROM "+RetSqlName("SD1")+" SD1"
			cQry += " LEFT JOIN "+RetSqlName("SB1")+" SB1 ON SB1.B1_COD = SD1.D1_COD"
			cQry += " LEFT JOIN "+RetSqlName("SF1")+" SF1 ON SF1.F1_DOC = SD1.D1_DOC AND SF1.F1_FORNECE = SD1.D1_FORNECE AND SF1.F1_LOJA = SD1.D1_LOJA AND SF1.F1_ESPECIE = SD1.D1_ESPECIE AND SF1.F1_SERIE = SD1.D1_SERIE"
			cQry += " LEFT JOIN "+RetSqlName("SA1")+" SA1 ON SA1.A1_COD = SF1.F1_FORNECE AND SA1.A1_LOJA = SF1.F1_LOJA "
			cQry += " WHERE SD1.D1_FILIAL = ? AND SB1.B1_FILIAL = ? AND SF1.F1_FILIAL = ? AND SA1.A1_FILIAL = ?"
			cQry += " AND SF1.F1_ESPECIE IN (?) AND SB1.B1_ACTDEC != ? AND SD1.D1_EMISSAO >= ? AND SD1.D1_EMISSAO <= ?"	
			cQry+=" AND SD1.D_E_L_E_T_ = ? AND SB1.D_E_L_E_T_ = ? AND SA1.D_E_L_E_T_ = ? AND SF1.D_E_L_E_T_ = ?"

			cQry := ChangeQuery(cQry)
			nOrd := 1
			oQryExec := FwExecStatement():New(cQry)
			oQryExec:SetUnsafe(nOrd++, cAusfb)
			oQryExec:SetString(nOrd++,xFilial("SD1",aSucursal[nI]))
			oQryExec:SetString(nOrd++,xFilial("SB1",aSucursal[nI]))
			oQryExec:SetString(nOrd++,xFilial("SF1",aSucursal[nI]))
			oQryExec:SetString(nOrd++,xFilial("SA1",aSucursal[nI]))
			oQryExec:SetIn(nOrd++, {cEspecie1}) //Especie(NCC)
			oQryExec:SetString(nOrd++,' ')
			oQryExec:SetString(nOrd++,DTOS(MV_PAR01))
			oQryExec:SetString(nOrd++,DTOS(MV_PAR02))
			oQryExec:SetString(nOrd++,' ')
			oQryExec:SetString(nOrd++,' ')
			oQryExec:SetString(nOrd++,' ')
			oQryExec:SetString(nOrd++,' ')

			FL845ACUM(oQryExec,cTRBn, "V") //Acumula los registros encontrados de acuerdo con la actividad, tipo de venta, tipo cliente, alicuota
			
			IF MV_PAR07 == 2
				FreeObj(oJEAcu)
				oJEAcu:=  JsonObject():New() 
			ENDIF

		ENDIF
		aSize(aColIVA,0)
		cTF3AlqIVA:=""
		cTF3BaseIVA:=""
		cTF3VrIVA:=""
    Next
	IF lErrorfb
		oQryExec:Destroy()
		oQryExec := nil
	EndIF

Return Nil

/*/{Protheus.doc} FL845ACUM
Función para el llenado de la tabla temporal final con los acumulados de acuerdo a la llave primaria
@type Function
@author brenda.ramirez
@since 16/10/2025
@param
	cTRBn: Contiene el alias de la tabla temporal para el archivo a generar
	oQryExec: Contiene el objeto donde se guarda la query generada
	cTipoMov: Contiene el tipo de movimiento (V-venta / C-compra)
@return nil /*/
Static Function FL845ACUM(oQryExec, cTRBn, cTipoMov)
	Local cAux1 := "" //Auxiliar actividad 
	Local cAux2 := "" //Auxiliar tipo de venta / tipo de operación
	Local cAux3 := "" //Auxiliar tipo cli/prov / tipo de sujeto
	Local cAux4 := "" //Auxiliar alicuota
	Local cLog := "" //Log que guarda los errores donde falta alguna equivalencia
	Local nAuxMerc:= 0 //Auxiliar para traer el valor del campo D2_TOTAL O D1_TOTAL
	Local nAuxBas:= 0 //Auxiliar para la sumatoria de las columnas encontrados para el campo D2_BASIMP? O D1_BASIMP?
	Local nAuxVal:= 0 //Auxiliar para la sumatoria de las columnas encontrados para el campo D2_VALIMP? O D1_VALIMP?
	Local nAuxAli:= 0 //Auxiliar para la sumatoria de las columnas encontrados para el campo D2_ALQIMP? O D1_ALQIMP?
	Local nZ := 1 //Auxiliar para recorrido de las columnas encontrados en la SFB para el impuesto IVA
	Local cKey :="" //Llave primaria de la tabla conforme a la tab de equivalencia (B1_ACTDEC+F2_TPVENT+A2_TIPO+ D2_ALQIMP? O B1_ACTDEC+F1_TPVENT+A2_TIPO+ D1_ALQIMP?)
	Local aConM1:={}
	Local cAlias := ""
	Local lF845Act	:= ExistBlock("F845ACT")	 //Verifica si existe el PE para la actividad
	Local cActAux	:= "" //Auxiliar para la actividad
	Default oQryExec:= nil //Objeto que contiene la información de la query
	Default cTRBn := ""
	Default cTipoMov := "V"

	If oQryExec != nil
	
		cAlias := oQryExec:OpenAlias()
			
		While !( (cAlias)->(Eof()) ) 
			nAuxAli:=0
			nAuxBas:=0
			nAuxVal:=0
			nAuxMerc:=0
			for nZ := 1 to len(aColIVA)
				IF SubStr(_aTotal[6][1][1],1,1) == '3'
					IF (cAlias)->F2_MOEDA != 1
						aConM1:= FC845CMO1(&("(cAlias)->D2_BASIMP"+aColIVA[nZ]),&("(cAlias)->D2_ALQIMP"+aColIVA[nZ]),(cAlias)->F2_TXMOEDA,(cAlias)->F2_MOEDA)
						nAuxAli+=&("(cAlias)->D2_ALQIMP"+aColIVA[nZ])//aux alicuota
						nAuxBas+=aConM1[1]//aux base
						nAuxVal+=aConM1[2]//aus val imp
					ELSE
						nAuxAli+=&("(cAlias)->D2_ALQIMP"+aColIVA[nZ])//aux alicuota
						nAuxBas+=&("(cAlias)->D2_BASIMP"+aColIVA[nZ])//aux base
						nAuxVal+=&("(cAlias)->D2_VALIMP"+aColIVA[nZ])//aus val imp
					ENDIF
				ELSEIF SubStr(_aTotal[6][1][1],1,1) == '4' 
					IF (cAlias)->F1_MOEDA != 1
						aConM1:=FC845CMO1(&("(cAlias)->D1_BASIMP"+aColIVA[nZ]),&("(cAlias)->D1_ALQIMP"+aColIVA[nZ]),(cAlias)->F1_TXMOEDA,(cAlias)->F1_MOEDA)
						nAuxAli+=&("(cAlias)->D1_ALQIMP"+aColIVA[nZ])//aux alicuota
						nAuxBas+=aConM1[1]//aux base
						nAuxVal+=aConM1[2]//aus val imp
					ELSE
						nAuxAli+=&("(cAlias)->D1_ALQIMP"+aColIVA[nZ])//aux alicuota
						nAuxBas+=&("(cAlias)->D1_BASIMP"+aColIVA[nZ])//aux base
						nAuxVal+=&("(cAlias)->D1_VALIMP"+aColIVA[nZ])//aus val imp
					ENDIF
				ENDIF
			next

			IF nAuxBas == 0 .and. SubStr(_aTotal[6][1][1],1,1) == '3'
				IF (cAlias)->F2_MOEDA != 1
					nAuxMerc := xMoeda((cAlias)->D2_TOTAL,(cAlias)->F2_MOEDA,1,nil,MsDecimais(1),(cAlias)->F2_TXMOEDA)
				ELSE
					nAuxMerc := (cAlias)->D2_TOTAL
				ENDIF
			ELSEIF nAuxBas == 0 .and. SubStr(_aTotal[6][1][1],1,1) == '4'
				IF (cAlias)->F1_MOEDA != 1
					nAuxMerc := xMoeda((cAlias)->D1_TOTAL,(cAlias)->F1_MOEDA,1,nil,MsDecimais(1),(cAlias)->F1_TXMOEDA)
				ELSE
					nAuxMerc := (cAlias)->D1_TOTAL
				ENDIF
			ENDIF
			
			cAux1:=AllTrim((cAlias)->B1_ACTDEC) //actividad
			If lF845Act
				cActAux := ExecBlock("F845ACT",.F.,.F.,{(cAlias)->ESPECIE, cTipoMov, (cAlias)->SERIE, (cAlias)->DOCNUM, (cAlias)->CLIFOR, (cAlias)->LOJA, (cAlias)->ITEM, cAux1})
				If Valtype(cActAux) == "C" .and. !Empty(cActAux)
					cAux1 := cActAux
				EndIf
			EndIf
			IF SubStr(_aTotal[6][1][1],1,1) == '3'
				cAux2:=oJEq3[cNTCDe][AllTrim((cAlias)->F2_TPVENT)]//tipo venta
			ELSE
				cAux2:=oJEq4[cNTCRD][AllTrim((cAlias)->F1_TPVENT)]//tipo venta
			ENDIF
			cAux3:=oJEq5[cNTSuC][AllTrim((cAlias)->A1_TIPO)]//tipo cliente
			cAux4:=oJEq1[cNTAli][AllTrim(str(nAuxAli))]//alicuota
			If !Empty(cAux1) .and. !Empty(cAux2) .and. !Empty(cAux3) .and. !Empty(cAux4)
				cKey:=cAux1+cAux2+cAux3+cAux4
				IF  !oJEAcu:HasProperty(ckey)
					oJEAcu[ckey]:=JsonObject():New()
					FL845LLEN(ckey, cAux1, cAux2, cAux3, cAux4, nAuxBas, nAuxVal, nAuxMerc, cTRBn) //llena la tabla temporal final con los acumulados correspondientes
					oJEAcu[ckey]['base']:= nAuxBas
					oJEAcu[ckey]['debito']:=nAuxVal
					IF SubStr(_aTotal[6][1][1],1,1) == '3'
						oJEAcu[ckey]['debito2']:=nAuxVal
					ENDIF
					IF nAuxBas > 0
						oJEAcu[ckey]['exento']:=0
					ELSE
						oJEAcu[ckey]['exento']:=nAuxMerc
					ENDIF
				ELSE
					oJEAcu[ckey]['base']+=nAuxBas
					oJEAcu[ckey]['debito']+=nAuxVal
					IF SubStr(_aTotal[6][1][1],1,1) == '3'
						oJEAcu[ckey]['debito2']+=nAuxVal
					ENDIF
					IF nAuxBas > 0
						oJEAcu[ckey]['exento']+=0
					ELSE
						oJEAcu[ckey]['exento']+=nAuxMerc
					ENDIF
					FL845LLEN(ckey, cAux1, cAux2, cAux3, cAux4, oJEAcu[ckey]['base'], oJEAcu[ckey]['debito'], oJEAcu[ckey]['exento'], cTRBn,2)
				Endif
			ElseIf Empty(cAux2)
				cLog += STR0016
				IF SubStr(_aTotal[6][1][1],1,1) == '3'
					cLog += "'"+ AllTrim((cAlias)->F2_TPVENT) + "' "
				ELSE
					cLog += "'"+ AllTrim((cAlias)->F1_TPVENT) + "' "
				ENDIF
			ElseIf Empty(cAux3)
				cLog += STR0017 + "'"+ AllTrim((cAlias)->A1_TIPO) + "' "
			ElseIf Empty(cAux4)
				cLog += STR0018 + "'"+ AllTrim(str(nAuxAli)) + "' "
			EndIf
			(cAlias)->(DbSkip())
		End
		(cAlias)->(DbCloseArea())
		If !Empty(cLog)
			Help(" ",1,STR0015,,cLog + STR0019,1,0)
		EndIf
	EndIf
Return nil

/*/{Protheus.doc} FC845CMO1
Función para conversión de moneda diferente de moneda 1
@type Function
@author brenda.ramirez
@since 20/10/2025
@param
	nBamo: Valor de la base del impuesto en moneda N
	nAli: Valor de la alicuota
	nTaMo: Valor de la tasa de la moneda N
	nNuMo: Numero de moneda origen
@return 
	nBaMo1: Valor de la base convertida a moneda 1
	nVaIm1: Valor del impuesto convertida a moneda 1
	nVaMe1: Valor de mercado convertido a moneda 1
 /*/
Function FC845CMO1(nBaMo,nAli,nTaMo,nNuMo)
	Local nBaMo1 := 0
	Local nVaIm1 := 0
	Local nMedaDest := 1
	Default nBaMo := 0
	Default nAli := 0
	Default nTaMo := 0
	Default nVaMe2 := 0
	Default nNuMo := 0

	nBaMo1 := xMoeda(nBaMo,nNuMo,nMedaDest,nil,MsDecimais(nMedaDest),nTaMo)
	nVaIm1 := Round((nBaMo1 * (nAli/100)),MsDecimais(nMedaDest))

Return {nBaMo1,nVaIm1}

/*/{Protheus.doc} FE845TRIS
Función para para la exportación del informe del texto de Iva Simple
@type Function
@author brenda.ramirez
@since 16/10/2025
@param 
	cArq = Alias de la tabla temporal a usar
@return nil /*/
Static Function FE845TRIS(cArq)

    Local olReport := nil
    Private cArqTrab := cArq
	Default cArq := ""

    If TRepInUse()
        olReport := FD845DERE(cArq)
        olReport:PrintDialog()
    EndIf

Return Nil

/*/{Protheus.doc} FD845DERE
Función para la definición de la estructura del reporte
@type Function
@author brenda.ramirez
@since 16/10/2025
@param 
	cTRBn: Contiene el alias de la tabla temporal para el archivo
@return 
	olReport: Objeto con la estructura del reporte a generar
 /*/
Static Function FD845DERE(cTRBn)
	Local cOp:=SubStr(_aTotal[6][1][1],1,1)
    Local olReport := nil
    Local oSection := nil
	Default cTRBn := ""

    olReport:=TReport():New(_aTotal[6][1][1],_aTotal[6][1][1],,{|olReport| FP845IMRE(olReport,cTRBn)},STR0001+_aTotal[6][1][1]) //"NOMBRE DEL ARCHIVO A GENERAR" //"REPORTE DE IVA SIMPLE - "
    
    oSection:=TRSection():new(olReport,_aTotal[6][1][1],{cArqTrab})//"NOMBRE DEL ARCHIVO A GENERAR"
    
    olReport:SetLandScape(.T.)
	IF !cOp $"1|2"
		TRCell():New(oSection, STR0002	, , ,"@!"				, 06) //"Actividad"
		TRCell():New(oSection, STR0003	, , ,"@!"				, 01) //"Tipo de operación"
		TRCell():New(oSection, STR0004	, , ,"@!"				, 01) //"Tipo de sujeto comprador"
		TRCell():New(oSection, STR0005	, , ,"@!"				, 12) //"Código alícuota"
		TRCell():New(oSection, STR0006	, , ,"@E 99,999,999.99"	, 15) //"Monto neto grabado"
		TRCell():New(oSection, STR0007	, , ,"@E 99,999,999.99"	, 15) //"Debito fiscal facturado"
		IF cOp == '3'
			TRCell():New(oSection, STR0008	, , ,"@E 99,999,999.99"	, 15) //"Debito fiscal op dac pag"
		ENDIF
		TRCell():New(oSection, STR0009	, , ,"@E 99,999,999.99"	, 15)     //  "Monto neto exento o no grabado"
	ELSE
		

		TRCell():New(oSection, STR0023	, , ,"@!"				, 01) // Concepto
		TRCell():New(oSection, STR0005	, , ,"@!"				, 04) //"Código alícuota"
		TRCell():New(oSection, STR0006	, , ,"@E 99,999,999.99"	, 15) //"Monto neto grabado"
		TRCell():New(oSection, STR0024	, , ,"@E 99,999,999.99"	, 15) //"Crédito fiscal facturado"
		IF cOp == '1'
			TRCell():New(oSection, STR0025	, , ,"@E 99,999,999.99"	, 15) //"Crédito fiscal Computable"
		ENDIF
	ENDIF
    
Return olReport

/*/{Protheus.doc} FP845IMRE
Función para la impresión del reporte
@type Function
@author brenda.ramirez
@since 16/10/2025
@param 
@return nil /*/
Static Function FP845IMRE(olReport,cAlias)
    Local cOp:=SubStr(_aTotal[6][1][1],1,1)
    Local olSection := olReport:Section(1)
		IF !cOp $"1|2"
			olReport:Section(1):Cell(STR0002):SetBlock({|| (cAlias)->ACTDEC	})    //"Actividad" 
			olReport:Section(1):Cell(STR0003):SetBlock({|| (cAlias)->TPVENT	})    //"Tipo de operación"
			olReport:Section(1):Cell(STR0004):SetBlock({|| (cAlias)->TIPO	})    //"Tipo de sujeto comprador"
			olReport:Section(1):Cell(STR0005):SetBlock({|| (cAlias)->ALICUOTA})    //"Código alícuota"
			olReport:Section(1):Cell(STR0006):SetBlock({|| (cAlias)->MONGRA	})    //"Monto neto grabado"
			olReport:Section(1):Cell(STR0007):SetBlock({|| (cAlias)->DEBFIS	})    //"Debito fiscal facturado"
			IF cOp == '3'  
				olReport:Section(1):Cell(STR0008):SetBlock({|| (cAlias)->DEFIOP	})   //"Debito fiscal op dac pag"
			ENDIF 
			olReport:Section(1):Cell(STR0009):SetBlock({|| (cAlias)->MONEX	})      //  "Monto neto exento o no grabado"
		ELSE

			
			olReport:Section(1):Cell(STR0023):SetBlock({|| (cAlias)->TPVENT	 })     // Concepto
			olReport:Section(1):Cell(STR0005):SetBlock({|| (cAlias)->ALICUOTA})     //"Código alícuota"
			olReport:Section(1):Cell(STR0006):SetBlock({|| (cAlias)->BASE	 })    //"Monto neto grabado"
			olReport:Section(1):Cell(STR0024):SetBlock({|| (cAlias)->VAL1	 })    //"Crédito fiscal facturado"
			IF cOp == '1' 
				olReport:Section(1):Cell(STR0025):SetBlock({|| (cAlias)->VAL2	 }) //"Crédito fiscal Computable"
			ENDIF 


		ENDIF
    
    olSection:Print()

Return Nil

/*/{Protheus.doc} FL845LLEN
Función para el llenado de los acumulados
@type Function
@author brenda.ramirez
@since 16/10/2025
@param 
	cLlave: Llave primaria para la tabla
	cActdec: Actividad del producto
	cTpvent: Concepto del tipo de venta de acuerdo a la tabla de equivalencia correspondiente
	cTipo: Tipo de sujeto comprador (tipo cliente) de acuerdo a la tabla de equivalencia correspondiente
	cAlicuota: Codigo alicuota del registro correspondiente de acuerdo a la tabla de equivalencia correspondiente
	nMongra: Valor del monto gravado (base del impuesto correspondiente) 
	nDebfis: Valor del debito fiscal (valor del impuesto calculado de acuerdo a la alicuota)
	nMonex: Valor del monto excento
	cTRBn: Contiene el alias de la tabla temporal para el archivo
	nOp: Auxiliar para saber si es una actualización o una insersión
@return nil /*/
Static Function FL845LLEN(cLlave, cActdec, cTpvent, cTipo, cAlicuota, nMongra, nDebfis, nMonex,cTRBn,nOp) 
	Default cLlave := ""
	Default cActdec := ""
	Default cTpvent := ""
	Default cTipo := ""
	Default cAlicuota := ""
	Default nMongra := 0
	Default nDebfis := 0
	Default nMonex := 0
	Default cTRBn :=""
	Default nOp:= 1

	IF nOp == 1
		RecLock(cTRBn,.T.)
		(cTRBn)->LLAVE1 := cLlave
		(cTRBn)->ACTDEC := cActdec
		(cTRBn)->TPVENT := cTpvent
		(cTRBn)->TIPO := cTipo
		(cTRBn)->ALICUOTA := cAlicuota
		(cTRBn)->MONGRA := nMongra
		(cTRBn)->DEBFIS := nDebfis
		IF SubStr(_aTotal[6][1][1],1,1) == '3'
			(cTRBn)->DEFIOP := nDebfis
		ENDIF
		(cTRBn)->MONEX := nMonex
		(cTRBn)->(MsUnlock())
	ELSE
		DbSelectArea(cTRBn)
		DbSetOrder(1)
		IF DBSeek(cLlave)
			RecLock(cTRBn,.F.)
			(cTRBn)->MONGRA := nMongra
			(cTRBn)->DEBFIS := nDebfis
			IF SubStr(_aTotal[6][1][1],1,1) == '3'
				(cTRBn)->DEFIOP := nDebfis
			ENDIF
			(cTRBn)->MONEX := nMonex
			(cTRBn)->(MsUnlock())
		END
	ENDIF

Return Nil

/*/{Protheus.doc} FO845OIFB
Función que obtiene las columnas del impuesto IVA de la tabla SFB
@type Function
@author brenda.ramirez
@since 11/10/2025
@param
	cSucursal: Sucursal con la que se esta trabajando
@return nil /*/
Static Function FO845OIFB(cSucursal)
Local lErrorfb  :=.T.
Local cOp:=SubStr(_aTotal[6][1][1],1,1)
Default cSucursal := ""

	SFB->(DBGOTOP())
	While !SFB->(EOF())
		If SFB->FB_FILIAL+SFB->FB_CLASSIF+SFB->FB_CLASSE==xFilial("SFB", cSucursal)+"3I" 
			If SFB->FB_CLASSE=="I"
				cColIVA   :=SFB->FB_CPOLVRO  
				IF LEN(AllTrim(SFB->FB_CPOLVRO))<>0
					If Len(aColIVA)<>0
						If ASCAN(aColIVA,SFB->FB_CPOLVRO)==0
							AADD(aColIVA,SFB->FB_CPOLVRO)
							IF cOp == '3'
								cTF3AlqIVA+="SD2.D2_ALQIMP"+SFB->FB_CPOLVRO+" ,"
								cTF3BaseIVA+="SD2.D2_BASIMP"+SFB->FB_CPOLVRO+" ,"
								cTF3VrIVA+= "SD2.D2_VALIMP"+SFB->FB_CPOLVRO+" ,"
							ELSEIF cOp=='4'
								cTF3AlqIVA+="SD1.D1_ALQIMP"+SFB->FB_CPOLVRO+" ,"
								cTF3BaseIVA+="SD1.D1_BASIMP"+SFB->FB_CPOLVRO+" ,"
								cTF3VrIVA+= "SD1.D1_VALIMP"+SFB->FB_CPOLVRO+" ,"
							ELSE
								cTF3AlqIVA  +="SF3.F3_ALQIMP"+SFB->FB_CPOLVRO+" ,"
								cTF3BaseIVA +="SF3.F3_BASIMP"+SFB->FB_CPOLVRO+" ,"
								cTF3VrIVA   +="SF3.F3_VALIMP"+SFB->FB_CPOLVRO+" ,"
							ENDIF
						Endif
					Else 
						AADD(aColIVA,SFB->FB_CPOLVRO)
						IF cOp == '3'
							cTF3AlqIVA+="SD2.D2_ALQIMP"+SFB->FB_CPOLVRO+" ,"
							cTF3BaseIVA+="SD2.D2_BASIMP"+SFB->FB_CPOLVRO+" ,"
							cTF3VrIVA+= "SD2.D2_VALIMP"+SFB->FB_CPOLVRO+" ,"
						ELSEIF cOp =='4'
							cTF3AlqIVA+="SD1.D1_ALQIMP"+SFB->FB_CPOLVRO+" ,"
							cTF3BaseIVA+="SD1.D1_BASIMP"+SFB->FB_CPOLVRO+" ,"
							cTF3VrIVA+= "SD1.D1_VALIMP"+SFB->FB_CPOLVRO+" ,"
						ELSE
							cTF3AlqIVA  +="SF3.F3_ALQIMP"+SFB->FB_CPOLVRO+" ,"
							cTF3BaseIVA +="SF3.F3_BASIMP"+SFB->FB_CPOLVRO+" ,"
							cTF3VrIVA   +="SF3.F3_VALIMP"+SFB->FB_CPOLVRO+" ,"
						ENDIF 
					Endif       
				ELSE
					lErrorfb:=.F.
					Help(" ",1,STR0021,,STR0022+cSucursal,4,5)
				ENDIF         
			Endif
		Endif
		SFB->(DBSkip())
	Enddo
	cTF3AlqIVA:=SUBSTR(cTF3AlqIVA, 1, len(cTF3AlqIVA)-1)
	cTF3BaseIVA:=SUBSTR(cTF3BaseIVA, 1, len(cTF3BaseIVA)-1)
	cTF3VrIVA:=SUBSTR(cTF3VrIVA, 1, len(cTF3VrIVA)-1)
	
	IF LEN(aColIVA)==0
		Help(" ",1,STR0014,,STR0020+cSucursal,4,5)
		lErrorfb:=.F.
	ENDIF     

Return lErrorfb

/*/{Protheus.doc} FG845JEQU
Función que genera un json con las equivalencias correspondientes de acuerdo a las tablas de equivalencia informadas en los parametros
@type Function
@author brenda.ramirez
@since 11/10/2025
@param
	cCod: Codigo de la tabla de equivalencia
	oJEqui: Json que sera llenado con los registros con las equivalencias correspondientes
@return 
	lAux: Auxiliar lógico que infica cuando el codido de la tabla de equivalencia no existe
/*/
STATIC FUNCTION FG845JEQU(cCod, oJEqui)
	Local cQryT := ""
	Local oQryEx := nil
	Local lAux := .T.
	Local nOrd := 1
	Default cCod := ""
	Default oJEqui := nil

	cQryT := "SELECT  CCP.CCP_COD,CCP.CCP_VORIGE,CCP.CCP_VDESTI FROM "
	cQryT += RetSqlName("CCP")+" CCP WHERE CCP.CCP_COD = ? AND CCP.D_E_L_E_T_ = ?"

	cQryT:= ChangeQuery(cQryT)
	oQryEx := FwExecStatement():New(cQryT)
	nOrd := 1

	oQryEx:SetString(nOrd++,cCod)
	oQryEx:SetString(nOrd++,' ')

	cAlias := oQryEx:OpenAlias()
	
	While !( (cAlias)->(Eof()) ) 
		IF  !oJEqui:HasProperty(cCod)
			oJEqui[cCod]:=JsonObject():New()
			oJEqui[cCOD][AllTrim((cAlias)->CCP_VORIGE)]:=alltrim((cAlias)->CCP_VDESTI)
		ELSE
			oJEqui[cCOD][AllTrim((cAlias)->CCP_VORIGE)]:=alltrim((cAlias)->CCP_VDESTI)
		ENDIF
		(cAlias)->(DbSkip())
	End

    (cAlias)->(DbCloseArea())

	If !oJEqui:HasProperty(cCod) 
		Help(" ",1,STR0010,,STR0011 + cCod,4,5)
		lAux := .F.
	EndIf

Return lAux

/*/{Protheus.doc} FE845ETTE
Función que elimina todos las tablas temporales ocupadas para la generación del archivo
@type Function
@author brenda.ramirez
@since 11/10/2025
@param
	aArqTrab: Area de trabajo 
@return nil /*/      
Function FE845ETTE(aArqTrab)
	Local nI:=1
	Local lAux:= .F.
	Local nArq := 0
	Default aArqTrab := {}

	For nArq := 1 To Len(aArqTrab)
		dbSelectArea(aArqTrab[nArq, 2])
		dbCloseArea()
		&(aArqTrab[nArq, 1]):Delete()
		&(aArqTrab[nArq, 1]) := Nil
	Next	

	FOR nI:=1 to len(aFilsCalc)
		If aFilsCalc[nI,1] == .T.
			lAux := .T.
			Exit
		EndIf
	NEXT
	IF !lAux
		FreeObj(oJEq1)
		FreeObj(oJEq2)
		FreeObj(oJEq3)
		FreeObj(oJEq4)
		FreeObj(oJEq5)
	ENDIF

Return Nil

/*/{Protheus.doc}
F845TAB1 sirve para consultar y acumular información relacionada con documentos fiscales (NF y NDP) en la tabla SF3  , 
aplicando filtros por sucursal, especie y tipo de movimiento, y luego actualizar una tabla temporal con esos datos

@author adrian.perez
@since 31/10/2025

@param cTRBn			Caracter		Nombre de la tabla temporal se utiliza para acumular datos y actualizar la tabla.
@param aSucursal		Arreglo			Arreglo que contiene las sucursales seleccionadas.

@return nil /*/ 
Static Function F845TAB1(cTRBn,aSucursal)

Local oJEAcu:=   JsonObject():New() //acumulados
Local oQryExec:= Nil
Local nI:=1
Local cEspecie1:="NF"
Local cEspecie2:="NDP"
Local cTipoMov:= "C"
Local cAusfb:=""
Local lErrorfb := .T.
Local cQry:=""
Local nOrd:=1

Static cTF3AlqIVA:="" //Auxiliar para el armado del query de las columnas para el campo F3_ALQIMP?
Static cTF3BaseIVA:="" //Auxiliar para el armado del query de las columnas para el campo F3_BASIMP?
Static cTF3VrIVA:="" //Auxiliar para el armado del query de las columnas para el campo F3_VALIMP?

Default cTRBn := "" //Nombre de la tabla temporal 
Default aSucursal:= {} //Array con las sucursales seleccionadas

	If !Empty(cTRBn)
		For nI := 1 To len(aSucursal)
			lErrorfb:=.T.
			lErrorfb:= FO845OIFB(aSucursal[nI])//Función que obtiene las columnas relacionadas con el IVA

			cAusfb:= cTF3AlqIVA+","+cTF3BaseIVA+","+cTF3VrIVA

			IF lErrorfb

				
				cQry := " SELECT SF3.F3_ESPECIE,SF3.F3_TIPOMOV,SF3.F3_CLIEFOR,SF3.F3_LOJA, SF3.F3_NFISCAL,  SF1.F1_TPVENT TIPV , "
				cQry +=" ? "
				cQry += " FROM "+RetSqlName("SF3")+" SF3 "	
				
				cQry += " LEFT JOIN  "+RetSqlName("SF1")+" SF1 ON SF1.F1_DOC = SF3.F3_NFISCAL " 
				cQry += "  AND  SF1.F1_FORNECE=SF3.F3_CLIEFOR AND SF1.F1_LOJA=SF3.F3_LOJA "

			
				cQry += " WHERE  SF3.F3_FILIAL = ? AND SF1.F1_FILIAL = ?   AND "
				cQry+=" F3_ESPECIE IN ( ? ) AND F3_TIPOMOV= ? "
				cQry += "  AND SF3.F3_EMISSAO >= ? AND SF3.F3_EMISSAO <= ? "	
				cQry+=" AND SF3.D_E_L_E_T_ = ? AND SF1.D_E_L_E_T_ = ? "
			
				cQry := ChangeQuery(cQry)
				nOrd := 1
				oQryExec := FwExecStatement():New(cQry)
				oQryExec:SetUnsafe(nOrd++, cAusfb)						//campos SFB- relacion campo Impuesto campo libro(FB_CPOLVRO)
				oQryExec:SetString(nOrd++,xFilial("SF3",aSucursal[nI])) // filial
				oQryExec:SetString(nOrd++,xFilial("SF1",aSucursal[nI])) // filial
				oQryExec:SetIn(nOrd++, {cEspecie1,cEspecie2})   	    // Espcie NF, NDP
				oQryExec:SetString(nOrd++,cTipoMov)				 		//Tipo movimiento C= compras
				oQryExec:SetString(nOrd++,DTOS(MV_PAR01))        		//Fecha inicial
				oQryExec:SetString(nOrd++,DTOS(MV_PAR02))        		//Fecha final
				oQryExec:SetString(nOrd++,' ') 					 		//SF3.D_E_L_E_T_
				oQryExec:SetString(nOrd++,' ') 					 		//SF1.D_E_L_E_T_
				
				F845ACUMF3(oQryExec,@oJEAcu,cTRBn)
				FA845ACTA(cTRBn,oJEAcu,SubStr(_aTotal[6][1][1],1,1))

			ENDIF


			aSize(aColIVA,0)
			cTF3AlqIVA:=""
			cTF3BaseIVA:=""
			cTF3VrIVA:=""
		NEXT
		IF oQryExec!=Nil
			oQryExec:Destroy()
			oQryExec := nil
			
		EndIF
		IF oJEAcu!=Nil
			FreeObj(oJEAcu)
		ENDIF
	EndIF
	
Return  Nil

/*/{Protheus.doc}
F845TAB2 sirve para consultar y acumular información relacionada con documentos fiscales (NCP) en la tabla SF3  , 
aplicando filtros por sucursal, especie y tipo de movimiento, y luego actualizar una tabla temporal con esos datos

@author adrian.perez
@since 31/10/2025

@param cTRBn			Caracter		Nombre de la tabla temporal se utiliza para acumular datos y actualizar la tabla.
@param aSucursal		Arreglo			Arreglo que contiene las sucursales seleccionadas.

@return nil /*/ 
Static Function  F845TAB2(cTRBn,aSucursal)

Local oJEAcu:=   JsonObject():New() //acumulados
Local oQryExec:= Nil
Local nI:=1
Local cEspecie1:="NCP"
Local cTipoMov:= "C"
Local cAusfb:=""
Local lErrorfb := .T.
Local cQry:=""
Local nOrd:=1

Static cTF3AlqIVA:="" //Auxiliar para el armado del query de las columnas para el campo F3_ALQIMP?
Static cTF3BaseIVA:="" //Auxiliar para el armado del query de las columnas para el campo F3_BASIMP?
Static cTF3VrIVA:="" //Auxiliar para el armado del query de las columnas para el campo F3_VALIMP?

Default cTRBn := "" //Nombre de la tabla temporal 
Default aSucursal:= {} //Array con las sucursales seleccionadas

	If !Empty(cTRBn)
		For nI := 1 To len(aSucursal)
			lErrorfb:=.T.
			lErrorfb:= FO845OIFB(aSucursal[nI])//Función que obtiene las columnas relacionadas con el IVA

			cAusfb:= cTF3AlqIVA+","+cTF3BaseIVA+","+cTF3VrIVA

			IF lErrorfb

				
				cQry := " SELECT SF3.F3_ESPECIE,SF3.F3_TIPOMOV,SF3.F3_CLIEFOR,SF3.F3_LOJA, SF3.F3_NFISCAL,  SF2.F2_TPVENT TIPV , "
				cQry +=" ? "
				cQry += " FROM "+RetSqlName("SF3")+" SF3 "	
				
				cQry += " LEFT JOIN  "+RetSqlName("SF2")+" SF2 ON SF2.F2_DOC = SF3.F3_NFISCAL " 
				cQry += "  AND  SF2.F2_CLIENTE=SF3.F3_CLIEFOR AND SF2.F2_LOJA=SF3.F3_LOJA "

				cQry += " WHERE  SF3.F3_FILIAL = ? AND SF2.F2_FILIAL = ?   AND "
				cQry += " F3_ESPECIE IN ( ? ) AND F3_TIPOMOV= ? "
				cQry += "  AND SF3.F3_EMISSAO >= ? AND SF3.F3_EMISSAO <= ? "	
				cQry+=" AND SF3.D_E_L_E_T_ = ? AND SF2.D_E_L_E_T_ = ? "

			
				cQry := ChangeQuery(cQry)
				nOrd := 1
				oQryExec := FwExecStatement():New(cQry)
				oQryExec:SetUnsafe(nOrd++, cAusfb)   					//campos SFB- relacion campo Impuesto campo libro(FB_CPOLVRO)
				oQryExec:SetString(nOrd++,xFilial("SF3",aSucursal[nI])) // filial
				oQryExec:SetString(nOrd++,xFilial("SF2",aSucursal[nI])) //filial
				oQryExec:SetIn(nOrd++, {cEspecie1})  					//especie NCP
				oQryExec:SetString(nOrd++,cTipoMov)  					//Tipo movimiento C= compras
				oQryExec:SetString(nOrd++,DTOS(MV_PAR01)) 				//Fecha inicial
				oQryExec:SetString(nOrd++,DTOS(MV_PAR02))				//fecha final
				oQryExec:SetString(nOrd++,' ')							//SF3.D_E_L_E_T_
				oQryExec:SetString(nOrd++,' ')							//SF2.D_E_L_E_T_
			
				F845ACUMF3(oQryExec,@oJEAcu,cTRBn)
				FA845ACTA(cTRBn,oJEAcu,SubStr(_aTotal[6][1][1],1,1))

			ENDIF


			aSize(aColIVA,0)
			cTF3AlqIVA:=""
			cTF3BaseIVA:=""
			cTF3VrIVA:=""
		NEXT

		IF oQryExec!=Nil
			oQryExec:Destroy()
			oQryExec := nil
			
		EndIF
		IF oJEAcu!=Nil
			FreeObj(oJEAcu)
		ENDIF
	ENDIF
		
Return  Nil
/*/{Protheus.doc}

F845ACUMF3  acumula los valores de impuestos (base imponible y valor del impuesto) agrupados por una clave compuesta 
 que depende del tipo de venta y la alícuota, a partir de los datos obtenidos en una consulta (oQryExec).

@author adrian.perez
@since 31/10/2025

@param  oQryExec	Objeto		Objeto que contiene la información de la query. Se utiliza para abrir alias y recorrer registros.
@paramo oJEAcu		Objeto		Acumulador (tipo JSON) donde se guardan los resultados agrupados por clave.     
@param cTRBn		Carácter	Nombre de la tabla temporal se utiliza para actualizar acumulados.

@return nil /*/ 
*/
Static Function F845ACUMF3(oQryExec,oJEAcu,cTRBn)
	
	Local cLog := "" //Log que guarda los errores donde falta alguna equivalencia
	Local nAuxBas:= 0 //Auxiliar para la sumatoria de las columnas encontrados para el campo F3_BASIMP? 
	Local nAuxVal:= 0 //Auxiliar para la sumatoria de las columnas encontrados para el campo F3_VALIMP? 
	Local nAuxAli:= 0 //Auxiliar para la sumatoria de las columnas encontrados para el campo F3_ALQIMP? 
	Local nZ := 1 //Auxiliar para recorrido de las columnas encontrados en la SFB para el impuesto IVA
	Local cKey :="" //Llave primaria de la tabla conforme a la tab de equivalencia (F1_TPVENT/F2_TPVENT+ F3_ALQIMP?)
	Local cAlias := ""
    Local cAliq:=""
	Local cTpvent:=""
	Local cOp:=SubStr(_aTotal[6][1][1],1,1)

	Default oQryExec:= nil //Objeto que contiene la información de la query
	Default oJEAcu:= nil
	Default cTRBn := ""

	If oQryExec != Nil .AND. !Empty(cTRBn) .AND. oJEAcu != Nil
	
		cAlias := oQryExec:OpenAlias()
			
		While !( (cAlias)->(Eof()) ) 
			nAuxAli:=0
			nAuxBas:=0
			nAuxVal:=0
			
			for nZ := 1 to len(aColIVA)
				
				nAuxAli+=&("(cAlias)->F3_ALQIMP"+aColIVA[nZ])//aux alicuota
				nAuxBas+=&("(cAlias)->F3_BASIMP"+aColIVA[nZ])//aux base
				nAuxVal+=&("(cAlias)->F3_VALIMP"+aColIVA[nZ])//aus val imp
				
			next

			
			cTpvent :=oJEq2[cNTCoC][AllTrim((cAlias)->TIPV)]//tipo venta o concepto
			
			
			cAliq	:=oJEq1[cNTAli][AllTrim(str(nAuxAli))]//alicuota
			
			If !Empty(cTpvent) .and. !Empty(cAliq) 
				cKey:=cTpvent+cAliq
				IF  !oJEAcu:HasProperty(ckey)
					IF nAuxBas>0
						oJEAcu[ckey]:=JsonObject():New()
						oJEAcu[ckey]['base']:= nAuxBas
						oJEAcu[ckey]['crefis']:=nAuxVal
						
						
						f845DATTAB(cTRBn,cKey, cTpvent,cAliq, oJEAcu[ckey]['base'], oJEAcu[ckey]['crefis'],cOp) 
					endIf
					
				ELSE
					IF nAuxBas>0
						oJEAcu[ckey]['base']+= nAuxBas
						oJEAcu[ckey]['crefis']+=nAuxVal
					ENDIF
				

				Endif
			ElseIf Empty(cTpvent)
				cLog += STR0016
				cLog += "'"+ AllTrim((cAlias)->TIPV) + "' "			 //STR0016 "No existe una equivalencia asociada para el tipo de venta "
			ElseIF Empty(cAliq)
				cLog += STR0018 + "'"+ AllTrim(str(nAuxAli)) + "' " //STR0018"No existe una equivalencia asociada para la alícuota "
			EndIf
			(cAlias)->(DbSkip())
		End
		
		(cAlias)->(DbCloseArea())
		If !Empty(cLog)
			Help(" ",1,STR0015,,cLog + STR0019,1,0)  //STR0015"Equivalencias asociadas inexistentes" STR0019"Registrar equivalencias correspondientes"
		EndIf

	EndIf
Return nil

/*/
f845DATTAB 		sirve para actualizar los campos de la tabla indicada.

@author adrian.perez
@since 03/11/2025

@param 	cTRBn	Carácter	Alias de la tabla donde se actualizarán los datos.
@param	cLlave	Carácter	Valor que se asignará al campo LLAVE1. Representa la clave principal del registro.
@param	cTpvent	Carácter	Valor para el campo TPVENT indica el tipo de venta asociado al registro.
@param	cAli	Carácter	Valor para el campo ALICUOTA.
@param	nBse	Numérico	Valor para el campo BASE
@param 	nVal	Numérico	Valor para los campos VAL1 y VAL2; importe calculado.
@param 	cOp		Carácter	Indica si se usa la tabla 1 o 2 para actualizar el campo VAL2 que solo corresponde a la tabla 1

@return nil 
/*/
Static Function f845DATTAB(cTRBn,cLlave, cTpvent,cAli, nBse, nVal,cOp) 
    Default cTRBn :=""
	Default cLlave := ""
	Default cTpvent := ""
	Default cAli := ""
	Default nBse := 0
	Default nVal := 0
	Default cOp :=""

	If !Empty(cTRBn)
		RecLock(cTRBn,.T.)
	
		(cTRBn)->LLAVE1 := cLlave
		(cTRBn)->TPVENT := cTpvent
		(cTRBn)->ALICUOTA := cAli
		(cTRBn)->BASE   := nBse
		(cTRBn)->VAL1 := nVal
		IF cOp=="1"
			(cTRBn)->VAL2 := nVal
		ENDIF
		
		(cTRBn)->(MsUnlock())
	EndIf


Return Nil


/*/
 FA845ACTA	Actualiza registros en la tabla indicada por cTRBn usando valores del objeto oJEAcu.
@author adrian.perez
@since 03/11/2025

@param  cTRBn		Carácter	Nombre de la tabla temporal a actualizar.
@param  oJEAcu		Objeto 		Acumulador (tipo JSON) donde se guardan los resultados agrupados por clave. 
@param 	cOp		    Carácter	Indica si se usa la tabla 1 o 2 para actualizar el campo VAL2 que solo corresponde a la tabla 1
@return nil   
/*/
Function FA845ACTA(cTRBn,oJEAcu,cOp)
	
	Local ckey	:="" 
	Local nBase :=0
	Default cTRBn   := ""
	Default oJEAcu:= Nil
	Default cOp :=""

	If !Empty(cTRBn) .AND.  oJEAcu != Nil
		dbSelectArea(cTRBn)
		(cTRBn)->(dbSetOrder(1))
		(cTRBn)->(dbGoTop())
		While !( (cTRBn)->(Eof()) )   
			
				ckey:=AllTrim((cTRBn)->LLAVE1)
				IF  oJEAcu:HasProperty(ckey)
					nBase:=oJEAcu[ckey]['base']
					if nBase>0
						RecLock(cTRBn,.F.)
						
						(cTRBn)->BASE :=nBase
						(cTRBn)->VAL1 := oJEAcu[ckey]['crefis']
						IF cOp=="1"
							(cTRBn)->VAL2 := oJEAcu[ckey]['crefis']
						EndIF
						MsUnlock()
					endIf
				EndIF
		
			(cTRBn)->(DbSkip())
		End
	EndIf

Return Nil
