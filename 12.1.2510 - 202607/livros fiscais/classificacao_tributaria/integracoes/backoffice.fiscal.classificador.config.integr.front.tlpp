#Include "Protheus.ch"
#Include "RwMake.ch"
#Include "FwBrowse.ch"
#Include "FwMvcDef.ch"
#Include "TOPCONN.ch"
#INCLUDE "TBICONN.CH"
#include 'tlpp-core.th'
#include 'tlpp-rest.th'
#include 'classificadorfiscal.ch'

Using Namespace totvs.protheus.backoffice.fiscal.Classifier

Function classFis()

	Local lExtCJHCJF := AliasInDic("CJH") .And. AliasInDic("CJF")
	Local lExistCJE := AliasInDic("CJE")
	Local lExistCJK  := AliasInDic("CJK")
	Local jParam := Nil
	Local lAutomato := IsBlind()

	If lExtCJHCJF .And. lExistCJE .And. lExistCJK

		//Abertura das tabelas da classificação Tributária
		AbertTabela()

		//Importação dos parametros iniciais do classificador
		ParametrosClassifis(lAutomato)

		//Importação do De/Para de formulas de base de calculo
		ImpDeParaFormul()

		//Importação da natureza de operação e finalidade
		ImpNatOper(lAutomato)

		//Importação dos enquadramentos
		ImpEnquad()

		jParam := GetParamCJE()

		If &(jParam:INTEGRAREGRA) .And. !Empty(jParam:USERNAMEDEFAULT) .And. !Empty(jParam:SENHADEFAULT)
			//Importação das regras
			oGetRegra := FISRetornaRegra():new()

			Processa({|| oGetRegra:FISRetornaRegra()}, STR0213 + "...", STR0214) //"Aguarde" "Atualizando as Regras"

			oIntegrRegras := FISGetRegrasClassificador():new()

			Processa({|| oIntegrRegras:IntegrConfig()}, STR0213 + "...", STR0215) //"Aguarde" "Integrando as Regras"

		EndIf

		If !lAutomato
			//Abertura do classificador fiscal
			FwCallApp("clasfis")
		EndIf
	Else
		MsgAlert(STR0216) //"Dicionário desatualizado, favor baixar o último pacote!"
	EndIf

return

/*/{Protheus.doc ParametrosClassifis
	Função responsavel pela importação da tabela de parametros iniciais
	@type  Function
	@author Erich Buttner
	@since 23/11/2022
	@version version
	@param param_name, param_type, param_descr
	@return return_var, return_type, return_description
	@example
	(examples)
	@see (links_or_references)
    /*/
Function ParametrosClassifis(lAutomato)

	Local aParam    := {}
	Local aUser     := {"",""}

	Local cIntRegra := ".F."

	Default lAutomato := .F.

	If lAutomato
		aUser     := {"TESTE","1234"}
		cIntRegra := ".T."
	EndIf


	//Parametro   Conteudo
	aParam := { {"URLREGRA",            "https://api-gateway.systax.com.br"     },;
		{"USERNAMEDEFAULT",     aUser[1]                                },;
		{"SENHADEFAULT",        aUser[2]                                },;
		{"CODREGALIQ",          "001"                                   },;
		{"CODREGBASE",          "001"                                   },;
		{"CODREGREGRA",         "001"                                   },;
		{"URLPRINCIPAL",        "https://app.systax.com.br"             },;
		{"INTEGRAREGRA",        cIntRegra                               },;
		{"INTEGRANCM",          ".F."                                   },;
		{"CODPERFOPER",         "001"                                   },;
		{"CODREGCST",           "001"                                   },;
		{"URLREGRA2",           "https://wscockpit.systax.com.br/api"   },;
		{"GRVLOGENVPRODSYSTAX", ".T."                                   } }


	FISImportCarga():ImpParamClassif(aParam)

	FWFreeArray(aParam)

Return

/*/{Protheus.doc ImpDeParaFormul
	Função responsavel pela importação
	da tabela de De/Para de formulas de
	base de calculo do classificador e configurador
	@type  Function
	@author Erich Buttner
	@since 23/11/2022
	@version version
	@param param_name, param_type, param_descr
	@return return_var, return_type, return_description
	@example
	(examples)
	@see (links_or_references)
    /*/
Function ImpDeParaFormul()

	Local aDeParaForm := {}

	//Formula Systax     Formula Configurador
	aDeParaForm := { {"qTrib * vUnTrib",        "O:VAL_MERCADORIA"          },;
		{"vFrete",                 "O:FRETE"                   },;
		{"vSeg",                   "O:SEGURO"                  },;
		{"vDesc",                  "O:DESCONTO"                },;
		{"vOutros",                "O:DESPESAS"                },;
		{"vOutro",                 "O:DESPESAS"                },;
		{"qBCProd",                "O:QUANTIDADE"              },;
		{"p_red_bc",               "I:PERC_REDUCAO_BASE"       },;
		{"pRedBCST",               "I:PERC_REDUCAO_BASE"       },;
		{"pRedBC",                 "I:PERC_REDUCAO_BASE"       },;
		{"qTrib * valor_pauta",    "O:QUANTIDADE * I:PAUTA"    },;
		{"pMVAST",                 "I:MVA"                     },;
		{"valor_pauta * qTrib",    "O:QUANTIDADE * I:PAUTA"    },;
		{"qTrib x vUnTrib",        "O:VAL_MERCADORIA"          },;
		{"pRedBC",                 "I:PERC_REDUCAO_BASE"       },;
		{"qUnid",                  "O:QUANTIDADE"              },;
		{"qTrib*vProdUni",         "O:VAL_MERCADORIA"          },;
		{"qTrib*vUnTrib",          "O:VAL_MERCADORIA"          },;
		{"vIPI",                   "TRIBIPI"                   },;
		{"VICMS",                  "TRIBICMS"                  },;
		{"vPIS",                   "TRIBPIS"                   },;
		{"vCOFINS",                "TRIBCOFINS"                },;
		{"pICMS",                  "ALIQICMS"                  },;
		{"(1 - (pICMS / 100))",    "ALIQICMS"                  },;
		{"vAliqProd",              "ALIQTRIB"                  } }


	FISImportCarga():ImpDeParaFormul(aDeParaForm)

	FWFreeArray(aDeParaForm)

Return


