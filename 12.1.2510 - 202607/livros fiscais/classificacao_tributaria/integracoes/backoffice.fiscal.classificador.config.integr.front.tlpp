/*/{Protheus.doc GetParamCJE
	Função responsavel pela importação da tabela de Enquadramento
	@type  Function
	@author Erich Buttner
	@since 23/08/2023
	@version version
	@param param_name, param_type, param_descr
	@return return_var, return_type, return_description
	@example
	(examples)
	@see (links_or_references)
    /*/
Static Function GetParamCJE()

	Local aParam := {"INTEGRAREGRA","USERNAMEDEFAULT","SENHADEFAULT"}
	Local cParametro := GetConfigClassif(aParam)
	Local jParam := JsonObject():New()

	jParam:FromJson(cParametro)

	FWFreeArray(aParam)

Return jParam

/*/{Protheus.doc AbertTabela
	Função responsavel pela importação da tabela de Enquadramento
	@type  Function
	@author Erich Buttner
	@since 23/08/2023
	@version version
	@param param_name, param_type, param_descr
	@return return_var, return_type, return_description
	@example
	(examples)
	@see (links_or_references)
    /*/
Static Function AbertTabela()

	DbselectArea("CJB")
	CJB->(DbCloseArea())

	DbselectArea("CJC")
	CJC->(DbCloseArea())

	DbselectArea("CJD")
	CJD->(DbCloseArea())

	DbselectArea("CJE")
	CJE->(DbCloseArea())

	DbselectArea("CJF")
	CJF->(DbCloseArea())

	DbselectArea("CJG")
	CJG->(DbCloseArea())

	DbselectArea("CJH")
	CJH->(DbCloseArea())

	DbselectArea("CJI")
	CJI->(DbCloseArea())

	DbselectArea("CJK")
	CJK->(DbCloseArea())


Return
