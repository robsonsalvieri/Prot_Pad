#include "totvs.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "fwmvcdef.ch"
#include "retail.autoparts.catalog.productcharacteristic.controller.ch"

namespace totvs.protheus.retail.autoparts.catalog.productcharacteristic.controller

/*/{Protheus.doc} RetailAutopartsCatalogProductCharacteristicController
    API relacionadas as caracteristicas de produto do catalogo de autopecas
    @type    class
    @author  Bruno Almeida
    @since   16/06/2026
/*/
Class RetailAutopartsCatalogProductCharacteristicController

    private Method FindProductCharacteristics(cProduct as Character) as Array

    public Method New()

    @Get("/api/retail/v1/retailAutopartsCatalogProductCharacteristic/getDataForProductCharacteristic", description="Consulta as caracteristicas do produto no catalogo de auto pecas.")
    public Method getDataForProductCharacteristic()

    @Post("/api/retail/v1/retailAutopartsCatalogProductCharacteristic/postDataForProductCharacteristic", description="Cadastra uma nova caracteristica de produto")
    public Method postDataForProductCharacteristic()

    @Put("/api/retail/v1/retailAutopartsCatalogProductCharacteristic/putDataForProductCharacteristic", description="Altera uma caracteristica de produto existente")
    public Method putDataForProductCharacteristic()

    @Delete("/api/retail/v1/retailAutopartsCatalogProductCharacteristic/deleteDataForProductCharacteristic/:product/:characteristic/:value", description="Deleta uma caracteristica de produto")
    public Method deleteDataForProductCharacteristic()

EndClass

/*/{Protheus.doc} New
    Metodo construtor
    @type    method
    @author  Bruno Almeida
    @since   16/06/2026
    @version p12
/*/
Method New() Class RetailAutopartsCatalogProductCharacteristicController
Return Self

/*/{Protheus.doc} getDataForProductCharacteristic
    Retorna as caracteristicas de um produto do catalogo de auto pecas
    @type    method
    @author  Bruno Almeida
    @since   16/06/2026
    @version p12
/*/
Method getDataForProductCharacteristic() Class RetailAutopartsCatalogProductCharacteristicController
    Local oJsonRespo    as Object
    Local oJParametr    as Object
    Local aItens        as Array
    Local cProduct      as Character
    Local lContinua     as Logical

    oJsonRespo  := JsonObject():New()
    oJParametr  := JsonObject():New()
    aItens      := {}
    cProduct    := ""
    lContinua   := .T.

    oJParametr := oRest:getQueryRequest()

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    If oJParametr['product'] == Nil .Or. Empty(oJParametr['product'])
        oRest:setStatusCode(422)
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := STR0001 //"Parâmetro 'product' é obrigatório"
        lContinua := .F.
    Else
        cProduct := oJParametr['product']
    EndIf

    If lContinua
        aItens := Self:FindProductCharacteristics(cProduct)

        If Len(aItens) > 0
            oJsonRespo['success'] := .T.
            oJsonRespo["items"]   := aItens
            oRest:setStatusCode(200)
        Else
            oJsonRespo['success'] := .F.
            oJsonRespo["items"]   := {}
            oJsonRespo["message"] := STR0002 //"Dados não encontrados para o filtro informado"
            oRest:setStatusCode(404)
        EndIf

    EndIf
    
    oRest:setResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

Return .T.

/*/{Protheus.doc} postDataForProductCharacteristic
    Cadastra uma nova caracteristica de produto no catalogo de auto pecas
    @type    method
    @author  Bruno Almeida
    @since   16/06/2026
    @version p12
/*/
Method postDataForProductCharacteristic() Class RetailAutopartsCatalogProductCharacteristicController
    Local oJsBody       as Object
    Local oJsonRespo    as Object
    Local oModel        as Object
    Local oModelD4X     as Object
    Local cProduct      as Character
    Local cCharact      as Character
    Local cValor        as Character
    Local cExiPdv       as Character
    Local lGravouOK     as Logical
    Local aErros        as Array
    Local cMsgErro      as Character

    oJsonRespo  := JsonObject():New()
    oJsBody     := JsonObject():New()
    oModel      := Nil
    oModelD4X   := Nil
    cProduct    := ""
    cCharact    := ""
    cValor      := ""
    cExiPdv     := ""
    lGravouOK   := .T.
    aErros      := {}

    oJsBody:fromJson(oRest:GetBodyRequest())

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    If oJsBody['product'] == Nil .Or. Empty(oJsBody['product'])
        lGravouOK := .F.
        cMsgErro  := STR0003 //"Tag 'product' é obrigatório"
    Else
        cProduct := oJsBody['product']
    EndIf

    If lGravouOK
        If oJsBody['characteristic'] == Nil .Or. Empty(oJsBody['characteristic'])
            lGravouOK := .F.
            cMsgErro  := STR0004 //"Tag 'characteristic' é obrigatório"
        Else
            cCharact := oJsBody['characteristic']
        EndIf
    EndIf

    If lGravouOK
        If oJsBody['value'] == Nil .Or. Empty(oJsBody['value'])
            lGravouOK := .F.
            cMsgErro  := STR0005 //"Tag 'value' é obrigatório"
        Else
            cValor := oJsBody['value']
        EndIf
    EndIf

    If lGravouOK
        If oJsBody['showonpdv'] == Nil .Or. Empty(oJsBody['showonpdv'])
            lGravouOK := .F.
            cMsgErro  := STR0006 //"Tag 'showonpdv' é obrigatório"
        Else
            cExiPdv := oJsBody['showonpdv']
        EndIf
    EndIf

    If lGravouOK
        oModel := FWLoadModel("LOJA6050")
        oModel:SetOperation(MODEL_OPERATION_INSERT)
        oModel:Activate()

        oModelD4X := oModel:GetModel("D4XMASTER")

        oModelD4X:SetValue("D4X_PROD",   cProduct)
        oModelD4X:SetValue("D4X_CARAC",  cCharact)
        oModelD4X:SetValue("D4X_VALOR",  cValor)
        oModelD4X:SetValue("D4X_EXIPDV", cExiPdv)

        lGravouOK := oModel:VldData()

        If lGravouOK
            lGravouOK := oModel:CommitData()
        EndIf

        If lGravouOK
            oRest:setStatusCode(201)
            oJsonRespo['success'] := .T.
            oJsonRespo['message'] := STR0007 //"Caracteristica cadastrada com sucesso"
        Else
            oRest:setStatusCode(400)
            aErros := oModel:GetErrorMessage()
            oJsonRespo['success'] := .F.
            If Len(aErros) >= 6 .And. !Empty(aErros[6])
                oJsonRespo['message'] := aErros[6]
            Else
                oJsonRespo['message'] := STR0008 //"Erro ao processar a requisição de inclusão"
            EndIf
        EndIf

        oModelD4X:DeActivate()
        oModel:DeActivate()

        FreeObj(oModelD4X)
        FreeObj(oModel)
    Else
        oRest:setStatusCode(422)
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := cMsgErro
    EndIf

    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJsBody)

Return .T.

/*/{Protheus.doc} putDataForProductCharacteristic
    Altera uma caracteristica de produto existente no catalogo de auto pecas
    @type    method
    @author  Bruno Almeida
    @since   16/06/2026
    @version p12
/*/
Method putDataForProductCharacteristic() Class RetailAutopartsCatalogProductCharacteristicController
    Local oJsBody       as Object
    Local oJsonRespo    as Object
    Local oJParametr    as Object
    Local oModel        as Object
    Local oModelD4X     as Object
    Local cProduct      as Character
    Local cCharact      as Character
    Local cValor        as Character
    Local cExiPdv       as Character
    Local cNewExiPdv    as Character
    Local lContinua     as Logical
    Local aArea         as Array
    Local aErros        as Array
    Local cMsgErro      as Character

    oJsonRespo  := JsonObject():New()
    oJsBody     := JsonObject():New()
    oJParametr  := JsonObject():New()
    oModel      := Nil
    oModelD4X   := Nil
    cProduct    := ""
    cCharact    := ""
    cValor      := ""
    cExiPdv     := ""
    lContinua   := .T.
    aArea       := {}
    aErros      := {}

    oJParametr := oRest:getQueryRequest()
    oJsBody:fromJson(oRest:GetBodyRequest())

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    If oJParametr['product'] == Nil .Or. Empty(oJParametr['product'])
        lContinua := .F.
        cMsgErro  := STR0001 //"Parâmetro 'product' é obrigatório"
    Else
        cProduct := padR(oJParametr['product'], TamSx3("D4X_PROD")[1])
    EndIf

    If lContinua
        If oJParametr['characteristic'] == Nil .Or. Empty(oJParametr['characteristic'])
            lContinua := .F.
            cMsgErro  := STR0009 //"Parâmetro 'characteristic' é obrigatório"
        Else
            cCharact := padR(oJParametr['characteristic'], TamSx3("D4X_CARAC")[1])
        EndIf
    EndIf

    If lContinua
        If oJParametr['value'] == Nil .Or. Empty(oJParametr['value'])
            lContinua := .F.
            cMsgErro  := STR0010 //"Parâmetro 'value' é obrigatório"
        Else
            cValor := padR(oJParametr['value'], TamSx3("D4X_VALOR")[1])
        EndIf
    EndIf

    //---------------------------
    //-- Inicio - Json do Request
    //---------------------------
    If lContinua
        If oJsBody['showonpdv'] == Nil .Or. Empty(oJsBody['showonpdv'])
            lContinua := .F.
            cMsgErro  := STR0006 //"Tag 'showonpdv' é obrigatório"
        Else
            cNewExiPdv := oJsBody['showonpdv']
        EndIf
    EndIf
    //------------------------
    //-- Fim - Json do Request
    //------------------------


    If lContinua
        aArea := GetArea()
        dbSelectArea('D4X')
        D4X->(dbSetOrder(1)) //D4X_FILIAL+D4X_PROD+D4X_CARAC+D4X_VALOR+D4X_CATEGO

        If !D4X->(dbSeek(xFilial("D4X") + cProduct + cCharact + cValor))
            oRest:setStatusCode(404)
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0011 //"Registro não encontrado"
            lContinua := .F.
        EndIf

        If lContinua
            oModel := FWLoadModel("LOJA6050")
            oModel:SetOperation(MODEL_OPERATION_UPDATE)
            oModel:Activate()

            oModelD4X := oModel:GetModel("D4XMASTER")            
            oModelD4X:SetValue("D4X_EXIPDV", cNewExiPdv)

            lContinua := oModel:VldData()

            If lContinua
                lContinua := oModel:CommitData()
            EndIf

            If lContinua
                oRest:setStatusCode(200)
                oJsonRespo['success'] := .T.
                oJsonRespo['message'] := STR0012 //"Caracteristica atualizada com sucesso"
            Else
                oRest:setStatusCode(400)
                aErros := oModel:GetErrorMessage()
                oJsonRespo['success'] := .F.
                If Len(aErros) >= 6 .And. !Empty(aErros[6])
                    oJsonRespo['message'] := aErros[6]
                Else
                    oJsonRespo['message'] := STR0013 //"Erro ao processar a requisição"
                EndIf
            EndIf

            oModelD4X:DeActivate()
            oModel:DeActivate()

            FreeObj(oModelD4X)
            FreeObj(oModel)
        EndIf

        RestArea(aArea)
    Else
        oRest:setStatusCode(422)
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := cMsgErro
    EndIf

    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJsBody)
    FreeObj(oJParametr)

Return .T.

/*/{Protheus.doc} deleteDataForProductCharacteristic
    Exclui uma caracteristica de produto do catalogo de auto pecas
    @type    method
    @author  Bruno Almeida
    @since   16/06/2026
    @version p12
/*/
Method deleteDataForProductCharacteristic() Class RetailAutopartsCatalogProductCharacteristicController
    Local oJsonRespo    as Object
    Local oJParametr    as Object
    Local oModel        as Object
    Local cProduct      as Character
    Local cCharact      as Character
    Local cValor        as Character
    Local lContinua     as Logical
    Local aArea         as Array
    Local aErros        as Array

    oJsonRespo  := JsonObject():New()
    oJParametr  := JsonObject():New()
    oModel      := Nil
    lContinua   := .T.
    aArea       := {}
    aErros      := {}

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    oJParametr := oRest:getPathParamsRequest()

    If oJParametr['product'] == Nil .Or. Empty(oJParametr['product'])
        cProduct := ""
    Else
        cProduct := padR(oJParametr['product'], TamSx3("D4X_PROD")[1])
    EndIf

    If oJParametr['characteristic'] == Nil .Or. Empty(oJParametr['characteristic'])
        cCharact := ""
    Else
        cCharact := padR(oJParametr['characteristic'], TamSx3("D4X_CARAC")[1])
    EndIf

    If oJParametr['value'] == Nil .Or. Empty(oJParametr['value'])
        cValor := ""
    Else
        cValor := padR(oJParametr['value'], TamSx3("D4X_VALOR")[1])
    EndIf

    If Empty(cProduct) .Or. Empty(cCharact) .Or. Empty(cValor)
        oRest:setStatusCode(422)
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := STR0014 //"Parâmetro 'product', 'characteristic' e 'value' são obrigatórios"
        lContinua := .F.
    EndIf

    If lContinua
        aArea := GetArea()
        dbSelectArea('D4X')
        D4X->(dbSetOrder(1)) //D4X_FILIAL+D4X_PROD+D4X_CARAC+D4X_VALOR+D4X_CATEGO

        If !D4X->(dbSeek(xFilial("D4X") + cProduct + cCharact + cValor))
            oRest:setStatusCode(404)
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0011 //"Registro não encontrado"
            lContinua := .F.
        EndIf

        If lContinua
            oModel := FWLoadModel("LOJA6050")
            oModel:SetOperation(MODEL_OPERATION_DELETE)
            oModel:Activate()

            lContinua := oModel:VldData()

            If lContinua
                lContinua := oModel:CommitData()
            EndIf

            If lContinua
                oRest:setStatusCode(200)
                oJsonRespo['success'] := .T.
                oJsonRespo['message'] := STR0015 //"Característica excluída com sucesso"
            EndIf

            oModel:DeActivate()
            FreeObj(oModel)
        EndIf

        RestArea(aArea)
    EndIf

    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

Return .T.

/*/{Protheus.doc} FindProductCharacteristics
    Consulta as caracteristicas de um produto no catalogo de auto pecas
    @type    method
    @author  Bruno Almeida
    @since   16/06/2026
    @version p12
    @param   cProduct , Character , codigo do produto a filtrar
    @return  Array    , Array     , array de itens encontrados
/*/
Method FindProductCharacteristics(cProduct as Character) as Array Class RetailAutopartsCatalogProductCharacteristicController
    Local oQueryQry     as Object
    Local jItem         as Object
    Local aItens        as Array
    Local cQry          as Character
    Local cAliasQry     as Character
    Local nSeq          as Numeric
    Local aArea         as Array

    Default cProduct := ""

    oQueryQry   := Nil
    jItem       := Nil
    nSeq        := 1
    aItens      := {}
    aArea       := GetArea()

    dbSelectArea("D4X")

    cQry := " SELECT D4X.D4X_FILIAL, D4X.D4X_PROD, D4X.D4X_CARAC, D4X.D4X_VALOR, D4X.D4X_EXIPDV, D4V.D4V_NOME "
    cQry += " FROM " + RetSqlName("D4X") + " D4X "
    cQry += " LEFT JOIN " + RetSqlName("D4V") + " D4V ON D4V.D4V_FILIAL = ? AND D4V.D4V_COD = D4X.D4X_CARAC AND D4V.D_E_L_E_T_ = ? "
    cQry += " WHERE D4X.D4X_FILIAL = ? "
    cQry += " AND D4X.D4X_PROD = ? "
    cQry += " AND D4X.D_E_L_E_T_ = ? "
    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)

    oQueryQry:SetString(nSeq++, xFilial("D4V"))
    oQueryQry:SetString(nSeq++, Space(1))
    oQueryQry:SetString(nSeq++, xFilial("D4X"))
    oQueryQry:SetString(nSeq++, AllTrim(cProduct))
    oQueryQry:SetString(nSeq++, Space(1))

    cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

    While (cAliasQry)->(!EOF())
        jItem := JsonObject():New()
        jItem["characteristiccode"] := AllTrim((cAliasQry)->D4X_CARAC)
        jItem["characteristicname"] := AllTrim((cAliasQry)->D4V_NOME)
        jItem["value"]              := AllTrim((cAliasQry)->D4X_VALOR)

        If AllTrim((cAliasQry)->D4X_EXIPDV) == "1"
            jItem["showonpdv"] := "Sim"
        ElseIf AllTrim((cAliasQry)->D4X_EXIPDV) == "2"
            jItem["showonpdv"] := "Não"
        Else
            jItem["showonpdv"] := ""
        EndIf

        aAdd(aItens, jItem)
        jItem := Nil
        (cAliasQry)->(dbSkip())
    EndDo

    (cAliasQry)->(dbCloseArea())

    RestArea(aArea)

    oQueryQry:Destroy()
    oQueryQry := Nil

Return(aItens)
