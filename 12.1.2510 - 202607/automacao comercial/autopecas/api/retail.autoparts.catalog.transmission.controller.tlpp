#INCLUDE 'PROTHEUS.CH'
#INCLUDE 'tlpp-core.th'
#INCLUDE 'tlpp-rest.th'
#INCLUDE 'FWMVCDEF.CH'
#INCLUDE 'retail.autoparts.catalog.transmission.controller.ch'

//               Nome do parâmetro no JSON     , Campo no SX3   , Tipo
Static aFields :=   { ;
                    {"transmissionModelCode"   , "ME9_CODMOD"   , "C"    },;
                    {"manufacturerBranch"      , "ME9_FILFAB"   , "C"    },;
                    {"manufacturerCode"        , "ME9_CODFAB"   , "C"    },;
                    {"manufacturerStore"       , "ME9_LOJFAB"   , "C"    },;
                    {"transmissionDescription" , "ME9_DESCRI"   , "C"    },;
                    {"transmissionType"        , "ME9_TIPO"     , "C"    },;
                    {"numberOfGears"           , "ME9_NUMMRC"   , "N"    };
                    } as Array

namespace totvs.protheus.retail.autoparts.catalog.transmission.controller
using namespace totvs.protheus.retail.autoparts.catalog.transmission.service

/*/{Protheus.doc} retailAutopartsCatalogTransmissionController
API relacionada a Transmissão do catalogo de autopecas
@author eduardo.Flima
@since 09/04/2026
/*/
Class retailAutopartsCatalogTransmissionController
    public Method New()
    private method FindTransmission(cBranch as Character, cCode as Character, cModel as Character, cFilFab as Character, cCodFab as Character, cLojFab as Character, cDescri as Character, cTipo as Character, cNumMrch as Character) as Array

    @Get("/api/retail/v1/retailAutopartsCatalogTransmission/getDataForTransmission", description="Consulta as transmissoes do catalogo de autopecas, podendo filtrar por filial, modelo, fabricante, descricao, tipo e numero de mercadoria")
    public Method getDataForTransmission()

    @Post("/api/retail/v1/retailAutopartsCatalogTransmission/postDataForTransmission", description="Cadastra uma nova transmissao para o catalogo de autopecas")
    public Method postDataForTransmission()

    @Put("/api/retail/v1/retailAutopartsCatalogTransmission/putDataForTransmission", description="Altera uma transmissao existente no catalogo de autopecas")
    public Method putDataForTransmission()

    @Delete("/api/retail/v1/retailAutopartsCatalogTransmission/deleteDataForTransmission/:code", description="Deleta uma transmissao do catalogo de autopecas")
    public Method deleteDataForTransmission()

EndClass

/*/{Protheus.doc} New
Método construtor
@author eduardo.Flima
@since 09/04/2026
/*/
Method New() Class retailAutopartsCatalogTransmissionController
Return Self

/*/{Protheus.doc} getDataForTransmission
    Retorna as transmissoes do catalogo de auto pecas
    @author eduardo.Flima
    @since 09/04/2026
    @version p12
/*/
Method getDataForTransmission() Class retailAutopartsCatalogTransmissionController
    Local oJsonRespo    := JsonObject():New() as Object
    Local oJParametr    := oRest:getQueryRequest() as Object
    Local aItens        := {} as Array
    Local cBranch       := xFilial("ME9") as Character
    Local cCode         := "" as Character
    Local cDescri       := "" as Character
    Local cNumMrch      := "" as Character
    Local cTipo         := "" as Character
    Local cFilFab       := "" as Character
    Local cCodFab       := "" as Character
    Local cLojFab       := "" as Character
    Local cModel        := "" as Character    

    DbSelectArea("ME9")

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Obtém os parâmetros informados na requisição via URL (query param)
  	If oJParametr:hasProperty('code')
        cCode := oJParametr['code']
    EndIf
    If oJParametr:hasProperty('transmissionDescription')
        cDescri := oJParametr['transmissionDescription']
    EndIf
    If oJParametr:hasProperty('numberOfGears')
        cNumMrch := oJParametr['numberOfGears']
    EndIf
    If oJParametr:hasProperty('transmissionType')
        cTipo := oJParametr['transmissionType']
    EndIf
    If oJParametr:hasProperty('manufacturerBranch')
        cFilFab := oJParametr['manufacturerBranch']
    EndIf
    If oJParametr:hasProperty('manufacturerCode')
        cCodFab := oJParametr['manufacturerCode']
    EndIf
    If oJParametr:hasProperty('manufacturerStore')
        cLojFab := oJParametr['manufacturerStore']
    EndIf
    If oJParametr:hasProperty('transmissionModelCode')
        cModel := oJParametr['transmissionModelCode']
    EndIf
    
    aItens := self:FindTransmission(cBranch, cCode, cModel, cFilFab, cCodFab, cLojFab, cDescri, cTipo, cNumMrch)
    
    if !empty(aItens)
        oJsonRespo["items"] := aItens
        oRest:setStatusCode(200)  // HTTP 200 = Sucesso
    else
        oJsonRespo["items"]     := {}
        oJsonRespo["message"]   := STR0001 //"Dados não encontrados para o filtro Informado"
        oRest:setStatusCode(404)  // HTTP 404 = Not Found
    endif

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    // ==========================================
    // Libera Recursos da Memoria
    // ==========================================
    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

Return .T.

/*/{Protheus.doc} FindTransmission
    Consulta a Transmissão do catálogo de auto pecas
    @author eduardo.Flima
    @since 09/04/2026
    @version p12

    @param cBranch  , Character , filial a ser filtrada
    @param cCode    , Character , código a ser filtrado
    @param cModel   , Character , modelo a ser filtrado
    @param cFilFab  , Character , filial fabricante a ser filtrada
    @param cCodFab  , Character , código fabricante a ser filtrado
    @param cLojFab  , Character , loja fabricante a ser filtrada
    @param cDescri  , Character , descrição a ser filtrada
    @param cTipo    , Character , tipo a ser filtrado
    @param cNumMrch , Character , numero de marchas a ser filtrado

    @return aItens  , Array     , array de itens encontrados
/*/
method FindTransmission(cBranch as Character, cCode as Character, cModel as Character, cFilFab as Character, cCodFab as Character, cLojFab as Character, cDescri as Character, cTipo as Character, cNumMrch as Character) as Array Class retailAutopartsCatalogTransmissionController
    Local oQueryQry		:= Nil as Object
    Local aItens        := {} as Array
	Local cQry			:= "" as Character
	Local nSeq			:= 1 as Numeric
    Local aArea         := GetArea() as Array
    Local cAliasQry     := "" as Character
    Local jItem         := Nil as Object
    Local cFilMEW       := xFilial("MEW")

    Default cBranch     := xFilial("ME9")
    Default cCode       := ""
    Default cModel      := ""
    Default cFilFab     := ""
    Default cCodFab     := ""
    Default cLojFab     := ""
    Default cDescri     := ""
    Default cTipo       := ""
    Default cNumMrch    := ""

    cQry	:= " SELECT ME9.ME9_FILIAL, ME9.ME9_CODTRA, ME9.ME9_DESCRI, ME9.ME9_NUMMRC, ME9.ME9_TIPO, ME9.ME9_FILFAB, ME9.ME9_CODFAB, ME9.ME9_LOJFAB, ME9.ME9_CODMOD "
	cQry	+= " FROM "+ RetSqlName("ME9") +" ME9 "
	cQry	+= " WHERE "
    cQry	+= " ME9.ME9_FILIAL = ? "
    If !Empty(cCode)
        cQry	+= " AND ME9.ME9_CODTRA = ? "
    Endif
    If !Empty(cModel)
        cQry	+= " AND ME9.ME9_CODMOD = ? "
    Endif
    If !Empty(cFilFab)
        cQry	+= " AND ME9.ME9_FILFAB = ? "
    Endif
    If !Empty(cCodFab)
        cQry	+= " AND ME9.ME9_CODFAB = ? "
    Endif
    If !Empty(cLojFab)
        cQry	+= " AND ME9.ME9_LOJFAB = ? "
    Endif
    If !Empty(cDescri)
        cQry	+= " AND ME9.ME9_DESCRI = ? "
    Endif
    If !Empty(cTipo)
        cQry	+= " AND ME9.ME9_TIPO = ? "
    Endif
    If !Empty(cNumMrch)
        cQry	+= " AND ME9.ME9_NUMMRC = ? "
    Endif
    cQry	+= " AND ME9.D_E_L_E_T_ = ? "

	cQry 	:= ChangeQuery(cQry)

	oQueryQry := FwExecStatement():New(cQry)
    oQueryQry:SetString(nSeq++,		cBranch)
    If !Empty(cCode)
        oQueryQry:SetString(nSeq++,		cCode)
    EndIf
    if !Empty(cModel)
        oQueryQry:SetString(nSeq++,		cModel)
    Endif
    if !Empty(cFilFab)
        oQueryQry:SetString(nSeq++,		cFilFab)
    Endif
    if !Empty(cCodFab)
        oQueryQry:SetString(nSeq++,		cCodFab)
    Endif
    if !Empty(cLojFab)
        oQueryQry:SetString(nSeq++,		cLojFab)
    Endif
    if !Empty(cDescri)
        oQueryQry:SetString(nSeq++,		cDescri)
    Endif
    if !Empty(cTipo)
        oQueryQry:SetString(nSeq++,		cTipo)
    Endif
    if !Empty(cNumMrch)
        oQueryQry:SetString(nSeq++,		cNumMrch)
    Endif
    oQueryQry:SetString(nSeq++,		Space(1))

	cAliasQry := oQueryQry:OpenAlias(GetNextAlias())
    
    WHILE (cAliasQry)->( !EOF() )
        jItem := JsonObject():New()
        jItem["branch"]                 := AllTrim((cAliasQry)->ME9_FILIAL)
        jItem["code"]                   := AllTrim((cAliasQry)->ME9_CODTRA)
        jItem["transmissionModelCode"]  := AllTrim((cAliasQry)->ME9_CODMOD)
        jItem["transmissionModelName"]  := AllTrim(POSICIONE("MEW",1,cFilMEW+(cAliasQry)->ME9_CODMOD,"MEW_NOME"))
        jItem["manufacturerBranch"]     := AllTrim((cAliasQry)->ME9_FILFAB)
        jItem["manufacturerCode"]       := AllTrim((cAliasQry)->ME9_CODFAB)
        jItem["manufacturerStore"]      := AllTrim((cAliasQry)->ME9_LOJFAB)
        jItem["manufacturerName"]       := AllTrim(POSICIONE("SA2",1,(cAliasQry)->ME9_FILFAB+(cAliasQry)->ME9_CODFAB+(cAliasQry)->ME9_LOJFAB,"A2_NOME"))
        jItem["transmissionDescription"]:= AllTrim((cAliasQry)->ME9_DESCRI)
        jItem["transmissionType"]       := AllTrim((cAliasQry)->ME9_TIPO)
        jItem["numberOfGears"]          := (cAliasQry)->ME9_NUMMRC

        // Adiciona o item no array de itens
        aAdd(aItens, jItem)
        
        (cAliasQry)->(dbSkip())
    ENDDO
	(cAliasQry)->(dbCloseArea())
    oQueryQry:Destroy()
    oQueryQry := Nil
    
    RestArea(aArea)

Return(aItens)

/*/{Protheus.doc} postDataForTransmission
    Cadastro de Transmissão para o catálogo de auto peças
    @author Eduardo.Flima
    @since 10/04/2026
    @version P12
    /*/
Method postDataForTransmission() Class retailAutopartsCatalogTransmissionController
    Local oJsBody       := JsonObject():New() as Object
    Local oJsonRespo    := JsonObject():New() as Object
    Local oModel        := Nil as Object
    Local oModelME9     := Nil as Object
    Local lGravouOK     := .F. as Logical
    Local aErros        := {} as Array
    Local lDadosOK      := .T. as Logical
    Local cParamName    := "" as Character
    Local cFieldName    := "" as Character
    Local lAnyParInf    := .F. as Logical // Se algum parametro de update foi informado
    Local nX            := 0 as Numeric

    DbSelectArea("ME9")

    oRest:setKeyHeaderResponse("Content-Type", "application/json")
    
    oJsBody:fromJson( oRest:GetBodyRequest())
    
    // ==========================================
    // Carrega o Model MVC
    // ==========================================
    oModel := FWLoadModel("LOJA620")  // Carrega o modelo de dados
    oModel:SetOperation(MODEL_OPERATION_INSERT)  // Define operação de inclusão
    oModel:Activate()  // Ativa o modelo
    
    // ------------------------------------------
    // Obtém o SubModel da Tabela MEW (Modelo de Transmissão)
    // ------------------------------------------
    oModelME9 := oModel:GetModel("ME9MASTER")
    
    // ==========================================
    // Preenche os Campos do Model
    // ==========================================
    For nX := 1 To Len(aFields)
        cParamName := aFields[nX][1]  // Nome do parâmetro no JSON
        cFieldName := aFields[nX][2]  // Nome do campo no Model
        
        If oJsBody[cParamName] != Nil
            oModelME9:SetValue(cFieldName, oJsBody[cParamName])
            lAnyParInf := .T.
        EndIf
    Next nX

    If !lAnyParInf
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['message'] := STR0002 //"Nenhum parâmetro de transmissão informado para cadastro"
        lDadosOK := .F.
    EndIf
    
    If lDadosOK
        // ==========================================
        // Valida e Grava os Dados
        // ==========================================
        
        // ------------------------------------------
        // Etapa 1: Validação dos Dados
        // ------------------------------------------
        If oModel:VldData()
            // ------------------------------------------
            // Etapa 2: Tentativa de Gravação (Commit)
            // ------------------------------------------
            lGravouOK := oModel:CommitData()
        Else
            // Validação falhou
            lGravouOK := .F.
        EndIf
        
        // ==========================================
        // Prepara a Resposta
        // ==========================================
        If lGravouOK
            oRest:setStatusCode(201)  // HTTP 201 = Created
            oJsonRespo['success']   := .T.
            oJsonRespo['message']   := STR0003 + ME9->ME9_CODTRA + STR0004 //"Transmissão " ### " cadastrada com sucesso"
            For nX := 1 to Len(aFields)
                cParamName := aFields[nX][1]  // Nome do parâmetro no JSON
                cFieldName := aFields[nX][2]  // Nome do campo no Model
                If aFields[nX][3] == "C"  // Se for campo do tipo Character, tira os espaços em branco
                    oJsonRespo[cParamName] := AllTrim(&("ME9->"+cFieldName))
                Else
                    oJsonRespo[cParamName] := &("ME9->"+cFieldName)
                EndIf
            Next nX
            
        Else
            // ------------------------------------------
            // ERRO: Falha na Validação ou Gravação
            // ------------------------------------------
            oRest:setStatusCode(400)  // HTTP 400 = Bad Request
            
            // Captura os erros do Model
            aErros := oModel:GetErrorMessage()
            
            /*
            Estrutura do Array aErros:
            [1] = Id do formulário de origem
            [2] = Id do campo de origem
            [3] = Id do formulário de erro
            [4] = Id do campo de erro
            [5] = Id do erro
            [6] = Mensagem do erro
            [7] = Mensagem da solução
            [8] = Valor atribuído
            [9] = Valor anterior
            */
            oJsonRespo['success']   := .F.
            oJsonRespo['message']   := IIf(!Empty(aErros[6]), aErros[6], STR0006) //"Erro ao cadastrar"
            oJsonRespo['field']     := iif(!Empty(aErros[4]), aErros[4], "")
            oJsonRespo['errorId']   := iif(!Empty(aErros[5]), aErros[5], "")
            oJsonRespo['solution']  := iif(!Empty(aErros[7]), aErros[7], "")
        EndIf

    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    // ==========================================
    // Libera Recursos da Memória
    // ==========================================
    oModelME9:DeActivate()
    oModel:DeActivate()
    FreeObj(oModelME9)
    FreeObj(oModel)
    FreeObj(oJsBody)
    FreeObj(oJsonRespo)
    
Return .T.

/*/{Protheus.doc} putDataForTransmission
    Altera cadastro de Transmissão do catálogo de auto peças
    @author eduardo.Flima
    @since 10/04/2026
    @version p12
/*/
Method putDataForTransmission() Class retailAutopartsCatalogTransmissionController
    Local oJsonRespo    := JsonObject():New() as Object
    Local oJsBody       := JsonObject():New() as Object
    Local oJParametr    := oRest:getQueryRequest() as Object
    Local lFound        := .F. as Logical
    Local cBranch       := "" as Character
    Local cCode         := "" as Character
    Local aArea         := GetArea() as Array
    Local oModel        := Nil as Object
    Local oModelME9     := Nil as Object
    Local lGravouOK     := .F. as Logical
    Local aErros        := {} as Array
    Local nX            := 0 as Numeric
    Local cParamName    := "" as Character
    Local cFieldName    := "" as Character
    Local lAnyParInf    := .F. as Logical // Se algum parametro de update foi informado
    Local lDadosOK      := .T. as Logical

    DbSelectArea("ME9")

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    oJsBody:fromJson( oRest:GetBodyRequest())

    cBranch := xFilial("ME9")

    // Obtém os parâmetros informados na requisição via URL (query param)
    If oJParametr:hasProperty('code')
        cCode := oJParametr['code']
    EndIf

    oRest:setKeyHeaderResponse("Content-Type", "application/json")
    
    // ==========================================
    // Validacao codigo Obrigatorio
    // ==========================================
    If Empty(cCode)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['message'] := STR0007 //"Parâmetro 'code' (código) é obrigatório"
        lDadosOK := .F.
    EndIf

    If lDadosOK
        dbSelectArea('ME9')
        ME9->(dbSetOrder(1)) //ME9_FILIAL+ME9_CODTRA
        
        lFound := ME9->(dbSeek(cBranch + PadR(cCode,TamSx3("ME9_CODTRA")[1])))
        
        // ------------------------------------------
        // Se não encontrou retorna erro 404
        // ------------------------------------------
        If !lFound
            oRest:setStatusCode(404)  // HTTP 404 = Not Found
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0008 + AllTrim(cCode) + STR0009 //"Registro " ### " nao encontrado "
            lDadosOK := .F.
        EndIf
    EndIf
    
    If lDadosOK
        // ==========================================
        // Carrega o Model MVC para Alteração
        // ==========================================
        oModel := FWLoadModel("LOJA620")  // Carrega o modelo de dados
        oModel:SetOperation(MODEL_OPERATION_UPDATE)  // Define operação de ALTERAÇÃO
        oModel:Activate()  // Ativa o modelo
        
        // ------------------------------------------
        // Obtém o SubModel da Tabela ME9
        // ------------------------------------------
        oModelME9 := oModel:GetModel("ME9MASTER")
        
        // ==========================================
        // Preenche os Campos do Model
        // ==========================================
        For nX := 1 To Len(aFields)
            cParamName := aFields[nX][1]  // Nome do parâmetro no JSON
            cFieldName := aFields[nX][2]  // Nome do campo no Model
            
            If oJsBody[cParamName] != Nil
                oModelME9:SetValue(cFieldName, oJsBody[cParamName])
                lAnyParInf := .T.
            EndIf
        Next nX

        If !lAnyParInf
            oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
            oJsonRespo['message'] := STR0010 //"Nenhum parâmetro de transmissão informado para alteração"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        // ==========================================
        // Valida e Grava as Alterações
        // ==========================================
        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        Else
            lGravouOK := .F.
        EndIf
        
        If lGravouOK
            oRest:setStatusCode(200)  // HTTP 200 = OK
            oJsonRespo['success'] := .T.
            oJsonRespo['message'] := STR0003 + AllTrim(cCode) + STR0005 //"Transmissão " ### " atualizada com sucesso"
            oJsonRespo['code'] := cCode
            for nX := 1 to Len(aFields)
                cParamName := aFields[nX][1]  // Nome do parâmetro no JSON
                cFieldName := aFields[nX][2]  // Nome do campo no Model
                If aFields[nX][3] == "C"  // Se for campo do tipo Character, tira os espaços em branco
                    oJsonRespo[cParamName] := AllTrim(&("ME9->"+cFieldName))
                Else
                    oJsonRespo[cParamName] := &("ME9->"+cFieldName)
                EndIf
            Next nX
            
        Else
            oRest:setStatusCode(400)  // HTTP 400 = Bad Request
            
            // Captura os erros do Model
            aErros := oModel:GetErrorMessage()
            
            /*
            Estrutura do Array aErros:
            [1] = Id do formulário de origem
            [2] = Id do campo de origem
            [3] = Id do formulário de erro
            [4] = Id do campo de erro
            [5] = Id do erro
            [6] = Mensagem do erro
            [7] = Mensagem da solução
            [8] = Valor atribuído
            [9] = Valor anterior
            */
            
            oJsonRespo['success']   := .F.
            oJsonRespo['field']     := iif(!Empty(aErros[4]), aErros[4], "")
            oJsonRespo['message']   := IIf(!Empty(aErros[6]), aErros[6], STR0011) //"Erro ao atualizar"
            oJsonRespo['solution']  := iif(!Empty(aErros[7]), aErros[7], "")
        EndIf
        
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())
    
    // ==========================================
    // Libera Recursos da Memória
    // ==========================================
    If ValType(oModel) <> "U"
        oModelME9:DeActivate()  // Desativa o SubModel
        oModel:DeActivate()     // Desativa o Model
        
        FreeObj(oModelME9)  // Libera objeto da memória
        FreeObj(oModel)     // Libera objeto da memória
    EndIf

    // ==========================================
    // Libera Recursos da Memória
    // ==========================================
    FreeObj(oJsBody)
    FreeObj(oJsonRespo)
    FreeObj(oJParametr)
    
    RestArea(aArea)
    
Return .T.

/*/{Protheus.doc} deleteDataForTransmission
    Deleta transmissão do catlogo de autopecas
    @author eduardo.Flima
    @since 09/04/2026
    @version p12
/*/
method deleteDataForTransmission()  Class retailAutopartsCatalogTransmissionController
    Local oJsonRespo    := JsonObject():New() as Object
    Local oJParametr    := oRest:getPathParamsRequest() as Object
    Local lFound        := .F. as Logical
    Local cBranch       := "" as Character
    Local cCode         := "" as Character
    Local aArea         := GetArea() as Array
    Local oModel        := Nil as Object
    Local lGravouOK     := .F. as Logical
    Local lDadosOK      := .T. as Logical

    DbSelectArea("ME9")

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    cBranch := xFilial("ME9")

    // Obtém os parâmetros informados na requisição via URL (path param)
    If oJParametr:hasProperty('code')
        cCode := oJParametr['code']
    EndIf

    If Empty(cCode)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['message'] := STR0007 //"Parâmetro 'code' (código) é obrigatório"
        lDadosOK := .F.
    EndIf

    If lDadosOK
        dbSelectArea('ME9')
        ME9->(dbSetOrder(1)) //ME9_FILIAL+ME9_CODTRA
        
        lFound := ME9->(dbSeek(cBranch + PadR(cCode,TamSx3("ME9_CODTRA")[1])))

        // ------------------------------------------
        // Se nao encontrou retorna erro 404
        // ------------------------------------------
        If !lFound
            oRest:setStatusCode(404)  // HTTP 404 = Not Found
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0008 + AllTrim(cCode) + STR0009 //"Registro " ### " nao encontrado "
            lDadosOK := .F.
        EndIf

    EndIf

    If lDadosOK
        // ==========================================
        // Carrega o Model MVC para Delete
        // ==========================================
        oModel := FWLoadModel("LOJA620")  // Carrega o modelo de dados
        oModel:SetOperation(MODEL_OPERATION_DELETE)  // Define operacao de EXCLUSAO
        oModel:Activate()  // Ativa o modelo
        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        EndIf
        
        If lGravouOK
            oRest:setStatusCode(200)  // HTTP 200 = OK
            oJsonRespo['success'] := .T.
            oJsonRespo['message'] := STR0003 + AllTrim(cCode) + STR0012 //"Transmissão " ### " deletada com sucesso"
        EndIf
        
        // ==========================================
        // Libera Recursos da Memoria
        // ==========================================
        oModel:DeActivate()     // Desativa o Model
        FreeObj(oModel)     // Libera objeto da memoria

    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    // ==========================================
    // Libera Recursos da Memoria
    // ==========================================
    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

    RestArea(aArea)

Return .T.
