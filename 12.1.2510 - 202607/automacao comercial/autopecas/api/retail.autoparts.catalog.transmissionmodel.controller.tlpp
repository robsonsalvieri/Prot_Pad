#INCLUDE 'PROTHEUS.CH'
#INCLUDE 'tlpp-core.th'
#INCLUDE 'tlpp-rest.th'
#INCLUDE 'FWMVCDEF.CH'
#INCLUDE 'retail.autoparts.catalog.transmissionmodel.controller.ch'

namespace totvs.protheus.retail.autoparts.catalog.transmissionmodel.controller
using namespace retail.autoparts.catalog.transmissionmodel.service

/*/{Protheus.doc} retailAutopartsCatalogTransmissionModelController
API relacionada ao Modelo de transmissão de dados do catalogo de autopecas
@author eduardo.Flima
@since 09/04/2026   
/*/
Class retailAutopartsCatalogTransmissionModelController
    public Method New()
    private method FindModelTransmission(cBranch as Character, cCode as Character,cName as Character) as Array

    @Get("/api/retail/v1/retailAutopartsCatalogTransmissionModel/getDataForTransmissionModel", description="Consulta os modelos de transmissao do catalogo de autopecas, podendo filtrar por filial, codigo e nome")
    public Method getDataForTransmissionModel()

    @Post("/api/retail/v1/retailAutopartsCatalogTransmissionModel/postDataForTransmissionModel", description="Cadastra um novo modelo de transmissao para o catalogo de autopecas")
    public Method postDataForTransmissionModel()

    @Put("/api/retail/v1/retailAutopartsCatalogTransmissionModel/putDataForTransmissionModel", description="Altera um modelo de transmissao existente no catalogo de autopecas")
    public Method putDataForTransmissionModel()

    @Delete("/api/retail/v1/retailAutopartsCatalogTransmissionModel/deleteDataForTransmissionModel/:code", description="Deleta um modelo de transmissao do catalogo de autopecas")
    public Method deleteDataForTransmissionModel()

EndClass

/*/{Protheus.doc} New
Método construtor
@author eduardo.Flima
@since 09/04/2026
/*/
Method New() Class retailAutopartsCatalogTransmissionModelController
Return Self

/*/{Protheus.doc} getDataForTransmissionModel
    Retorna os modelos de transmissão do catalogo de auto peças
    @author eduardo.Flima
    @since 09/04/2026
    @version p12
/*/
Method getDataForTransmissionModel() Class retailAutopartsCatalogTransmissionModelController
    Local oJsonRespo    := JsonObject():New() as Object
    Local oJParametr    := oRest:getQueryRequest() as Object
    Local aItens        := {} as Array                  
    Local cBranch       := xFilial("MEW") as Character
    Local cCode         := "" as Character
    Local cName         := "" as Character

    DbSelectArea("MEW")

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Obtém os parâmetros informados na requisição via URI (query param)
	If oJParametr:hasProperty('code')
		cCode := oJParametr['code']
	EndIf
    If oJParametr:hasProperty('name')
        cName := oJParametr['name']
    EndIf

    aItens := self:FindModelTransmission(cBranch, cCode, cName)    
    
    if !empty(aItens)
        oJsonRespo["items"] := aItens
        oRest:setStatusCode(200)  // HTTP 200 = Sucesso
    else
        oJsonRespo["items"] := {}
        oJsonRespo["message"] := STR0001 //"Dados não encontrados para o filtro Informado"
        oRest:setStatusCode(404)  // HTTP 404 = Not Found
    endif

    oRest:setResponse(oJsonRespo:toJson())

    // ==========================================
    // Libera Recursos da Memoria
    // ==========================================
    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

Return .T.

/*/{Protheus.doc} postDataForTransmissionModel
    Cadastra Modelo de transmissão do catlogo de autopecas
    @author eduardo.Flima
    @since 09/04/2026
    @version p12
/*/
method postDataForTransmissionModel()  Class retailAutopartsCatalogTransmissionModelController
    Local oJsBody       := JsonObject():New() as Object
    Local oJsonRespo    := JsonObject():New() as Object
    Local oModel        := Nil as Object
    Local oModelMEW     := Nil as Object    
    Local cName         := "" as Character
    Local lGravouOK     := .F. as Logical
    Local aErros        := {} as Array
    Local lDadosOK      := .T. as Logical

    DbSelectArea("MEW")

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    oJsBody:fromJson(oRest:GetBodyRequest())

    // Obtém os dados enviados na Requisição (Body)
    If oJsBody:hasProperty('name')
        cName := oJsBody['name']
    EndIf

    // ==========================================
    // Validacao nome Obrigatorio
    // ==========================================
    If Empty(cName)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := STR0002 //"Parâmetro 'name' (nome) é obrigatório"
        lDadosOK := .F.
    EndIf
    
    If lDadosOK
        // ==========================================
        // Carrega o Model MVC
        // ==========================================
        oModel := FWLoadModel("LOJA610")  // Carrega o modelo de dados
        oModel:SetOperation(MODEL_OPERATION_INSERT)  // Define operação de inclusão
        oModel:Activate()  // Ativa o modelo
        
        // ------------------------------------------
        // Obtém o SubModel da Tabela MEW (Modelo de Transmissão)
        // ------------------------------------------
        oModelMEW := oModel:GetModel("MEWMASTER")
        
        // ==========================================
        // Preenche os Campos do Model
        // ==========================================
        oModelMEW:SetValue("MEW_NOME", cName)
        
        // ==========================================
        // Valida e Grava os Dados
        // ==========================================
        
        // ------------------------------------------
        // Etapa 1: Validação dos Dados
        // ------------------------------------------
        If oModel:VldData()
            // ------------------------------------------
            // Etapa 2: Tentativa de Gravação (Commit)
            // ------------------------------------------
            lGravouOK := oModel:CommitData()
        Else
            // Validação falhou
            lGravouOK := .F.
        EndIf
        
        // ==========================================
        // Prepara a Resposta
        // ==========================================
        If lGravouOK
            oRest:setStatusCode(201)  // HTTP 201 = Created
            oJsonRespo['success']   := .T.
            oJsonRespo['message']   := STR0003 + MEW->MEW_CODMOD + STR0004 //"Modelo de Transmissao " ### " cadastrado com sucesso"
            oJsonRespo['branch']    := AllTrim(MEW->MEW_FILIAL)
            oJsonRespo['code']      := MEW->MEW_CODMOD
            oJsonRespo['name']      := AllTrim(MEW->MEW_NOME)
        Else
            // ------------------------------------------
            // ERRO: Falha na Validação ou Gravação
            // ------------------------------------------
            oRest:setStatusCode(400)  // HTTP 400 = Bad Request
            
            // Captura os erros do Model
            aErros := oModel:GetErrorMessage()
            
            /*
            Estrutura do Array aErros:
            [1] = Id do formulário de origem
            [2] = Id do campo de origem
            [3] = Id do formulário de erro
            [4] = Id do campo de erro
            [5] = Id do erro
            [6] = Mensagem do erro
            [7] = Mensagem da solução
            [8] = Valor atribuído
            [9] = Valor anterior
            */
            
            oJsonRespo['success']   := .F.
            oJsonRespo['message']   := IIf(!Empty(aErros[6]), aErros[6], STR0005) //"Erro ao cadastrar"
            // Adiciona detalhes do erro se disponi­veis
            oJsonRespo['solution']  := IIf(!Empty(aErros[7]), aErros[7], "")
            oJsonRespo['field']     := IIf(!Empty(aErros[4]), aErros[4], "")
        EndIf
        
        // ==========================================
        // Libera Recursos da Memória
        // ==========================================
        oModelMEW:DeActivate()  // Desativa o SubModel
        oModel:DeActivate()     // Desativa o Model
        
        FreeObj(oModelMEW)
        FreeObj(oModel)

    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())
        
    // ==========================================
    // Libera Recursos da Memória
    // ==========================================
    FreeObj(oJsBody)
    FreeObj(oJsonRespo)

Return .T.

/*/{Protheus.doc} putDataForTransmissionModel
    Altera Modelo de Transmissão do Catálogo de auto peças
    @author eduardo.Flima
    @since 09/04/2026
    @version p12
/*/
method putDataForTransmissionModel()  Class retailAutopartsCatalogTransmissionModelController
    Local oJsonRespo    := JsonObject():New() as Object
    Local oJsBody       := JsonObject():New() as Object
    Local oJParametr    := oRest:getQueryRequest() as Object
    Local lFound        := .F. as Logical
    Local aArea         := GetArea() as Array
    Local cBranch       := xFilial("MEW") as Character
    Local cCode         := "" as Character
    Local cName         := "" as Character
    Local oModel        := Nil as Object
    Local oModelMEW     := Nil as Object
    Local lGravouOK     := .F. as Logical
    Local aErros        := {} as Array
    Local lDadosOK      := .T. as Logical

    DbSelectArea("MEW")

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    oJsBody:fromJson(oRest:GetBodyRequest())

    // Obtém os parâmetros informados na requisição via URI (query param)
	If oJParametr:hasProperty('code')
		cCode := oJParametr['code']
	EndIf
    // Obtém os dados enviados na Requisição (Body)
    If oJsBody:hasProperty('name')
        cName := oJsBody['name']
    EndIf

    // ==========================================
    // Validacao codigo Obrigatorio
    // ==========================================
    If Empty(cCode)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := STR0006 //"Parâmetro 'code' (código) é obrigatório"
        lDadosOK := .F.
    EndIf

    If lDadosOK .And. Empty(cName)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := STR0002 //"Parâmetro 'name' (nome) é obrigatório"
        lDadosOK := .F.
    EndIf

    If lDadosOK
        dbSelectArea('MEW')
        MEW->(dbSetOrder(1)) //MEW_FILIAL+MEW_CODMOD
        
        lFound := MEW->(dbSeek(cBranch + PadR(cCode,TamSx3("MEW_CODMOD")[1])))
        
        // ------------------------------------------
        // Se não encontrou retorna erro 404
        // ------------------------------------------
        If !lFound
            oRest:setStatusCode(404)  // HTTP 404 = Not Found
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0007 + AllTrim(cCode) + STR0008 //"Registro " ### " nao encontrado"
            lDadosOK := .F.
        EndIf
    EndIf
    
    If lDadosOK
        // ==========================================
        // Carrega o Model MVC para Alteração
        // ==========================================
        oModel := FWLoadModel("LOJA610")  // Carrega o modelo de dados
        oModel:SetOperation(MODEL_OPERATION_UPDATE)  // Define operação de ALTERAÇÃO
        oModel:Activate()  // Ativa o modelo
        
        // ------------------------------------------
        // Obtém o SubModel da Tabela MEW
        // ------------------------------------------
        oModelMEW := oModel:GetModel("MEWMASTER")
        
        // ==========================================
        // Atualiza os Campos Informados
        // (Apenas os campos que foram enviados)
        // ==========================================
        oModelMEW:SetValue("MEW_NOME", cName)
        
        // ==========================================
        // Valida e Grava as Alterações
        // ==========================================
        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        Else
            lGravouOK := .F.
        EndIf
        
        If lGravouOK
            oRest:setStatusCode(200)  // HTTP 200 = OK
            oJsonRespo['success'] := .T.
            oJsonRespo['message'] := STR0003 + AllTrim(cCode) + STR0009 //"Modelo de Transmissao " ### " atualizado com sucesso"
            oJsonRespo['branch']  := AllTrim(MEW->MEW_FILIAL)
            oJsonRespo['code']    := MEW->MEW_CODMOD
            oJsonRespo['name']    := AllTrim(MEW->MEW_NOME)
        Else
            oRest:setStatusCode(400)  // HTTP 400 = Bad Request
            
            // Captura os erros do Model
            aErros := oModel:GetErrorMessage()
            
            /*
            Estrutura do Array aErros:
            [1] = Id do formulário de origem
            [2] = Id do campo de origem
            [3] = Id do formulário de erro
            [4] = Id do campo de erro
            [5] = Id do erro
            [6] = Mensagem do erro
            [7] = Mensagem da solução
            [8] = Valor atribuído
            [9] = Valor anterior
            */
            
            oJsonRespo['success']   := .F.
            oJsonRespo['message']   := IIf(!Empty(aErros[6]), aErros[6], STR0010) //"Erro ao atualizar"
            // Adiciona detalhes do erro se disponi­veis
            oJsonRespo['solution']  := iif(!Empty(aErros[7]), aErros[7], "")
            oJsonRespo['field']     := iif(!Empty(aErros[4]), aErros[4], "")
        EndIf
        
        // ==========================================
        // Libera Recursos da Memória
        // ==========================================
        oModelMEW:DeActivate()  // Desativa o SubModel
        oModel:DeActivate()     // Desativa o Model
        
        FreeObj(oModelMEW)  // Libera objeto da memória
        FreeObj(oModel)     // Libera objeto da memória
        
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())
        
    // ==========================================
    // Libera Recursos da Memória
    // ==========================================
    FreeObj(oJsBody)
    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

    RestArea(aArea)

Return .T.

/*/{Protheus.doc} deleteDataForTransmissionModel
    Deleta Modelo de Transmissão do Catálogo de auto peças
    @author eduardo.Flima
    @since 09/04/2026
    @version p12
/*/
method deleteDataForTransmissionModel()  Class retailAutopartsCatalogTransmissionModelController

    Local oJsonRespo    := JsonObject():New() as Object
    Local oJParametr    := oRest:getPathParamsRequest() as Object
    Local lFound        := .F. as Logical
    Local cBranch       := xFilial("MEW") as Character
    Local aArea         := GetArea()as Array
    Local oModel        := Nil as Object
    Local lGravouOK     := .F. as Logical
    Local lDadosOK      := .T. as Logical
    Local cCode         := "" as Character

    DbSelectArea("MEW")

    oRest:setKeyHeaderResponse("Content-Type", "application/json")
    
    // Obtém os parâmetros informados na requisição via URI (path param)
	If oJParametr:hasProperty('code')
		cCode := oJParametr['code']
	EndIf

    If Empty(cCode)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := STR0006 //"Parâmetro 'code' (código) é obrigatório"
        lDadosOK := .F.
    EndIf

    If lDadosOK
        dbSelectArea('MEW')
        MEW->(dbSetOrder(1)) //MEW_FILIAL+MEW_CODMOD
        
        lFound := MEW->(dbSeek(cBranch + PadR(cCode,TamSx3("MEW_CODMOD")[1])))

        // ------------------------------------------
        // Se nao encontrou retorna erro 404
        // ------------------------------------------
        If !lFound
            oRest:setStatusCode(404)  // HTTP 404 = Not Found
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0007 + AllTrim(cCode) + STR0008 //"Registro " ### " nao encontrado"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        // ==========================================
        // Carrega o Model MVC para Alteracao
        // ==========================================
        oModel := FWLoadModel("LOJA610")  // Carrega o modelo de dados
        oModel:SetOperation(MODEL_OPERATION_DELETE)  // Define operação de EXCLUSÃO
        oModel:Activate()  // Ativa o modelo

        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        EndIf

        If lGravouOK
            oRest:setStatusCode(200)  // HTTP 200 = OK
            oJsonRespo['success'] := .T.
            oJsonRespo['message'] := STR0011 + AllTrim(cCode) + STR0012 //"Modelo de Transmissão " ### " deletado com sucesso"
        EndIf
        
        // ==========================================
        // Libera Recursos da Memoria
        // ==========================================
        oModel:DeActivate()     // Desativa o Model
        FreeObj(oModel)     // Libera objeto da memoria

    EndIf
    
    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    // ==========================================
    // Libera Recursos da Memoria
    // ==========================================
    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

    RestArea(aArea)

Return .T.

/*/{Protheus.doc} FindModelTransmission
    Consulta Modelo de Transmissão do Catálogo de auto peças
    @author eduardo.Flima
    @since 09/04/2026
    @version p12
    @param cBranch  , Character , filial a ser filtrada
    @param cCode    , Character , codigo a ser filtrado
    @param cName    , Character , nome a ser filtrado
    @return aItens  , Array     , array de itens encontrados
/*/
method FindModelTransmission(cBranch as Character, cCode as Character, cName as Character) as Array Class retailAutopartsCatalogTransmissionModelController
    Local oQueryQry		as Object
    Local aItens        as Array
	Local cQry			as Character
	Local nSeq			as Numeric
    Local cAliasQry     as Character
    Local jItem         as Object

    Default cBranch     := xFilial("MEW")
    Default cCode       := ""
    Default cName       := ""

	nSeq		:= 1
    aItens      := {}

	cQry	:= " SELECT MEW.MEW_FILIAL, MEW.MEW_CODMOD, MEW.MEW_NOME"
	cQry	+= " FROM "+ RetSqlName("MEW") +" MEW "
	cQry	+= " WHERE "
	cQry	+= " MEW.MEW_FILIAL = ? "
    If !Empty(cCode)
        cQry	+= " AND MEW.MEW_CODMOD = ? "
    Endif
    If !Empty(cName)
        cQry	+= " AND MEW.MEW_NOME = ? "
    Endif
    cQry	+= " AND MEW.D_E_L_E_T_ = ? "
	cQry 	:= ChangeQuery(cQry)
	oQueryQry := FwExecStatement():New(cQry)
    oQueryQry:SetString(nSeq++,		cBranch)
    if !Empty(cCode)
        oQueryQry:SetString(nSeq++,		cCode)
    EndIF
    if !Empty(cName)
        oQueryQry:SetString(nSeq++,		cName)
    Endif
	oQueryQry:SetString(nSeq++,		Space(1))
	
	cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

	While (cAliasQry)->( !EOF() )
        jItem := JsonObject():New()
        jItem["branch"] := AllTrim((cAliasQry)->MEW_FILIAL)
        jItem["code"]   := AllTrim((cAliasQry)->MEW_CODMOD)
        jItem["name"]   := AllTrim((cAliasQry)->MEW_NOME)
        // Adiciona o item no array de itens
        aAdd(aItens, jItem)
        (cAliasQry)->(dbSkip())
	EndDo

	(cAliasQry)->(dbCloseArea())
    oQueryQry:Destroy()
    oQueryQry := Nil

Return(aItens)
