#include "totvs.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "fwmvcdef.ch"
#include "retail.autoparts.catalog.similar.controller.ch"

//               Nome do parametro no JSON     , Campo no SX3   , Tipo
Static aFields :=   { ;
                    {"similarGroupCode"        , "MFY_CODGRP"   , "C"    },;
                    {"productBranch"           , "MFY_FILPRO"   , "C"    },;
                    {"productCode"             , "MFY_CODPRO"   , "C"    };
                    } as Array

namespace totvs.protheus.retail.autoparts.catalog.similar.controller

/*/{Protheus.doc} RetailAutopartsCatalogSimilarController
    API relacionada a Similares do catalogo de autopecas
    @type   class    
    @author eduardo.FLima
    @since  27/05/2026
/*/
Class RetailAutopartsCatalogSimilarController

    public Method New()

    private Method FindSimilar(cGroupCode as Character, cProductBranch as Character, cProductCode as Character) as Array

    @Get("/api/retail/v1/retailAutopartsCatalogSimilar/getDataForSimilar", description="Consulta os similares do catalogo de autopecas, podendo filtrar por grupo, filial do produto ou codigo do produto")
    public Method getDataForSimilar()

    @Post("/api/retail/v1/retailAutopartsCatalogSimilar/postDataForSimilar", description="Cadastra um novo similar para o catalogo de autopecas")
    public Method postDataForSimilar()

    @Put("/api/retail/v1/retailAutopartsCatalogSimilar/putDataForSimilar", description="Altera um similar existente no catalogo de autopecas")
    public Method putDataForSimilar()

    @Delete("/api/retail/v1/retailAutopartsCatalogSimilar/deleteDataForSimilar/:groupCode/:productCode", description="Deleta um similar do catalogo de autopecas")
    public Method deleteDataForSimilar()

EndClass

/*/{Protheus.doc} New
    Metodo construtor
    @type   method
    @author eduardo.FLima
    @since  27/05/2026
    @return Object, Instancia da classe RetailAutopartsCatalogSimilarController    
/*/
Method New() Class RetailAutopartsCatalogSimilarController
Return Self

/*/{Protheus.doc} getDataForSimilar
    Retorna os similares do catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   27/05/2026
    @version p12
/*/
Method getDataForSimilar() Class RetailAutopartsCatalogSimilarController
    Local oJsonRespo    := JsonObject():New() as Object
    Local oJParametr    := oRest:getQueryRequest() as Object
    Local aItens        := {} as Array
    Local cGroupCode    := "" as Character
    Local cProductBranch:= "" as Character
    Local cProductCode  := "" as Character

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Obtem os parametros informados na requisicao via URL (query param)
    If oJParametr:hasProperty('groupCode')
        cGroupCode := oJParametr['groupCode']
    EndIf
    If oJParametr:hasProperty('productBranch')
        cProductBranch := oJParametr['productBranch']
    EndIf
    If oJParametr:hasProperty('productCode')
        cProductCode := oJParametr['productCode']
    EndIf

    aItens := Self:FindSimilar(cGroupCode, cProductBranch, cProductCode)

    If Len(aItens) > 0
        oJsonRespo["items"] := aItens
        oRest:setStatusCode(200)  // HTTP 200 = Sucesso
    Else
        oJsonRespo["items"]   := {}
        oJsonRespo["message"] := STR0001 //"Dados nao encontrados para o filtro informado"
        oRest:setStatusCode(404)  // HTTP 404 = Not Found
    EndIf

    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

Return .T.

/*/{Protheus.doc} postDataForSimilar
    Cadastro de Similar para o catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   27/05/2026
    @version p12
/*/
Method postDataForSimilar() Class RetailAutopartsCatalogSimilarController
    Local oJsBody       := JsonObject():New() as Object
    Local oJsonRespo    := JsonObject():New() as Object
    Local oModel        := Nil as Object
    Local oModelMFY     := Nil as Object
    Local lGravouOK     := .F. as Logical
    Local aErros        := {} as Array
    Local cParamName    := "" as Character
    Local cFieldName    := "" as Character
    Local nX            := 0 as Numeric
    Local cGroupCode    := "" as Character


    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    oJsBody:fromJson(oRest:GetBodyRequest())

    // ==========================================
    // Gera UUID para o grupo caso nao informado
    // ==========================================
    If oJsBody['similarGroupCode'] == Nil .Or. Empty(oJsBody['similarGroupCode'])
        cGroupCode := FWUUIDV4(.T.)
        oJsBody['similarGroupCode'] := cGroupCode
    EndIf

    // ==========================================
    // Carrega o Model MVC
    // ==========================================
    oModel := FWLoadModel("LOJA690")
    oModel:SetOperation(MODEL_OPERATION_INSERT)
    oModel:Activate()

    // ------------------------------------------
    // Obtem o SubModel da Tabela MFY (Similares)
    // ------------------------------------------
    oModelMFY := oModel:GetModel("MFYMASTER")

    // ==========================================
    // Preenche os Campos do Model
    // ==========================================
    For nX := 1 To Len(aFields)
        cParamName := aFields[nX][1]  // Nome do parametro no JSON
        cFieldName := aFields[nX][2]  // Nome do campo no Model

        If oJsBody[cParamName] != Nil
            oModelMFY:SetValue(cFieldName, oJsBody[cParamName])
        EndIf
    Next nX


    // ==========================================
    // Valida e Grava os Dados
    // ==========================================
    If oModel:VldData()
        lGravouOK := oModel:CommitData()
    Else
        lGravouOK := .F.
    EndIf

    If lGravouOK
        oRest:setStatusCode(201)  // HTTP 201 = Created
        oJsonRespo['success'] := .T.
        oJsonRespo['message'] := STR0003 + RTrim(MFY->MFY_CODGRP) + STR0004 //"Similar grupo " ### " cadastrado com sucesso"
        For nX := 1 To Len(aFields)
            cParamName := aFields[nX][1]
            cFieldName := aFields[nX][2]
            If aFields[nX][3] == "C"
                oJsonRespo[cParamName] := RTrim(MFY->(FieldGet(FieldPos(cFieldName))))
            EndIf
        Next nX
    Else
        oRest:setStatusCode(400)  // HTTP 400 = Bad Request
        aErros := oModel:GetErrorMessage()

        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := IIf(!Empty(aErros[6]), aErros[6], STR0006) //"Erro ao cadastrar"
        oJsonRespo['field']   := IIf(!Empty(aErros[4]), aErros[4], "")
        oJsonRespo['errorId'] := IIf(!Empty(aErros[5]), aErros[5], "")
        oJsonRespo['solution']:= IIf(!Empty(aErros[7]), aErros[7], "")

    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    // ==========================================
    // Libera Recursos da Memoria
    // ==========================================
    oModelMFY:DeActivate()
    oModel:DeActivate()
    FreeObj(oModelMFY)
    FreeObj(oModel)
    FreeObj(oJsBody)
    FreeObj(oJsonRespo)

Return .T.

/*/{Protheus.doc} putDataForSimilar
    Altera cadastro de Similar do catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   27/05/2026
    @version p12
/*/
Method putDataForSimilar() Class RetailAutopartsCatalogSimilarController
    Local oJsonRespo    := JsonObject():New() as Object
    Local oJsBody       := JsonObject():New() as Object
    Local oJParametr    := oRest:getQueryRequest() as Object
    Local lFound        := .F. as Logical
    Local cBranch       := "" as Character
    Local cGroupCode    := "" as Character
    Local cProductBranch:= "" as Character
    Local cProductCode  := "" as Character
    Local aArea         := GetArea() as Array
    Local oModel        := Nil as Object
    Local oModelMFY     := Nil as Object
    Local lGravouOK     := .F. as Logical
    Local aErros        := {} as Array
    Local nX            := 0 as Numeric
    Local cParamName    := "" as Character
    Local cFieldName    := "" as Character
    Local lAnyParInf    := .F. as Logical
    Local lDadosOK      := .T. as Logical

    DbSelectArea("MFY")

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    oJsBody:fromJson(oRest:GetBodyRequest())

    cBranch := xFilial("MFY")

    // Obtem os parametros informados na requisicao via URL (query param)
    If oJParametr:hasProperty('groupCode')
        cGroupCode := oJParametr['groupCode']
    EndIf
    If oJParametr:hasProperty('productBranch')
        cProductBranch := oJParametr['productBranch']
    EndIf
    If oJParametr:hasProperty('productCode')
        cProductCode := oJParametr['productCode']
    EndIf

    // Assume xFilial("SB1") caso productBranch nao informado
    If Empty(cProductBranch)
        cProductBranch := xFilial("SB1")
    EndIf

    // ==========================================
    // Validacao campos obrigatorios
    // ==========================================
    If Empty(cGroupCode)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['message'] := STR0007 //"Parametro 'groupCode' (codigo do grupo) e obrigatorio"
        lDadosOK := .F.
    EndIf

    If lDadosOK .And. Empty(cProductCode)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['message'] := STR0012 //"Parametro 'productCode' (codigo do produto) e obrigatorio"
        lDadosOK := .F.
    EndIf

    If lDadosOK
        dbSelectArea('MFY')
        MFY->(dbSetOrder(1)) //MFY_FILIAL+MFY_CODGRP+MFY_FILPRO+MFY_CODPRO

        lFound := MFY->(dbSeek(cBranch + PadR(cGroupCode, TamSx3("MFY_CODGRP")[1]) + PadR(cProductBranch, TamSx3("MFY_FILPRO")[1]) + PadR(cProductCode, TamSx3("MFY_CODPRO")[1])))

        // ------------------------------------------
        // Se nao encontrou retorna erro 404
        // ------------------------------------------
        If !lFound
            oRest:setStatusCode(404)  // HTTP 404 = Not Found
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0008 + RTrim(cGroupCode) + "/" + RTrim(cProductCode) + STR0009 //"Registro " ### " nao encontrado"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        // ==========================================
        // Carrega o Model MVC para Alteracao
        // ==========================================
        oModel := FWLoadModel("LOJA690")
        oModel:SetOperation(MODEL_OPERATION_UPDATE)
        oModel:Activate()

        // ------------------------------------------
        // Obtem o SubModel da Tabela MFY
        // ------------------------------------------
        oModelMFY := oModel:GetModel("MFYMASTER")

        // ==========================================
        // Preenche os Campos do Model
        // ==========================================
        For nX := 1 To Len(aFields)
            cParamName := aFields[nX][1]
            cFieldName := aFields[nX][2]

            If oJsBody[cParamName] != Nil
                oModelMFY:SetValue(cFieldName, oJsBody[cParamName])
                lAnyParInf := .T.
            EndIf
        Next nX

        If !lAnyParInf
            oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
            oJsonRespo['message'] := STR0010 //"Nenhum parametro de similar informado para alteracao"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        // ==========================================
        // Valida e Grava as Alteracoes
        // ==========================================
        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        Else
            lGravouOK := .F.
        EndIf

        If lGravouOK
            oRest:setStatusCode(200)  // HTTP 200 = OK
            oJsonRespo['success'] := .T.
            oJsonRespo['message'] := STR0003 + RTrim(cGroupCode) + STR0005 //"Similar grupo " ### " atualizado com sucesso"
            For nX := 1 To Len(aFields)
                cParamName := aFields[nX][1]
                cFieldName := aFields[nX][2]
                If aFields[nX][3] == "C"
                    oJsonRespo[cParamName] := RTrim(MFY->(FieldGet(FieldPos(cFieldName))))
                EndIf
            Next nX
        Else
            oRest:setStatusCode(400)  // HTTP 400 = Bad Request
            aErros := oModel:GetErrorMessage()

            oJsonRespo['success']  := .F.
            oJsonRespo['field']    := IIf(!Empty(aErros[4]), aErros[4], "")
            oJsonRespo['message']  := IIf(!Empty(aErros[6]), aErros[6], STR0011) //"Erro ao atualizar"
            oJsonRespo['solution'] := IIf(!Empty(aErros[7]), aErros[7], "")
        EndIf
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    // ==========================================
    // Libera Recursos da Memoria
    // ==========================================
    If ValType(oModel) <> "U"
        oModelMFY:DeActivate()
        oModel:DeActivate()

        FreeObj(oModelMFY)
        FreeObj(oModel)
    EndIf

    FreeObj(oJsBody)
    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

    RestArea(aArea)

Return .T.

/*/{Protheus.doc} deleteDataForSimilar
    Deleta similar do catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   27/05/2026
    @version p12
/*/
Method deleteDataForSimilar() Class RetailAutopartsCatalogSimilarController
    Local oJsonRespo    := JsonObject():New() as Object
    Local oJParametr    := oRest:getPathParamsRequest() as Object
    Local oJQuery       := oRest:getQueryRequest() as Object
    Local lFound        := .F. as Logical
    Local cBranch       := "" as Character
    Local cGroupCode    := "" as Character
    Local cProductBranch:= "" as Character
    Local cProductCode  := "" as Character
    Local aArea         := GetArea() as Array
    Local oModel        := Nil as Object
    Local lGravouOK     := .F. as Logical
    Local lDadosOK      := .T. as Logical
    Local aErros        := {} as Array

    DbSelectArea("MFY")

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    cBranch := xFilial("MFY")

    // Obtem os parametros informados na requisicao via URL (path param)
    If oJParametr:hasProperty('groupCode')
        cGroupCode := oJParametr['groupCode']
    EndIf
    If oJParametr:hasProperty('productCode')
        cProductCode := oJParametr['productCode']
    EndIf

    // Obtem productBranch via query param (opcional)
    If oJQuery:hasProperty('productBranch')
        cProductBranch := oJQuery['productBranch']
    EndIf

    // Assume xFilial("SB1") caso productBranch nao informado
    If Empty(cProductBranch)
        cProductBranch := xFilial("SB1")
    EndIf

    // ==========================================
    // Validacao campos obrigatorios
    // ==========================================
    If Empty(cGroupCode)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['message'] := STR0007 //"Parametro 'groupCode' (codigo do grupo) e obrigatorio"
        lDadosOK := .F.
    EndIf

    If lDadosOK .And. Empty(cProductCode)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['message'] := STR0012 //"Parametro 'productCode' (codigo do produto) e obrigatorio"
        lDadosOK := .F.
    EndIf

    If lDadosOK
        dbSelectArea('MFY')
        MFY->(dbSetOrder(1)) //MFY_FILIAL+MFY_CODGRP+MFY_FILPRO+MFY_CODPRO

        lFound := MFY->(dbSeek(cBranch + PadR(cGroupCode, TamSx3("MFY_CODGRP")[1]) + PadR(cProductBranch, TamSx3("MFY_FILPRO")[1]) + PadR(cProductCode, TamSx3("MFY_CODPRO")[1])))

        // ------------------------------------------
        // Se nao encontrou retorna erro 404
        // ------------------------------------------
        If !lFound
            oRest:setStatusCode(404)  // HTTP 404 = Not Found
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0008 + RTrim(cGroupCode) + "/" + RTrim(cProductCode) + STR0009 //"Registro " ### " nao encontrado"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        // ==========================================
        // Carrega o Model MVC para Delete
        // ==========================================
        oModel := FWLoadModel("LOJA690")
        oModel:SetOperation(MODEL_OPERATION_DELETE)
        oModel:Activate()

        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        EndIf
       // Resposta default: erro (padrao defensivo)
        oRest:setStatusCode(400)  // HTTP 400 = Bad Request
        oJsonRespo['success'] := .F.
        aErros := oModel:GetErrorMessage()
        oJsonRespo['message']  := IIf(!Empty(aErros[6]), aErros[6], STR0014) //"Erro ao deletar"
        oJsonRespo['field']    := IIf(!Empty(aErros[4]), aErros[4], "")
        oJsonRespo['solution'] := IIf(!Empty(aErros[7]), aErros[7], "")

        If lGravouOK
            oRest:setStatusCode(200)  // HTTP 200 = OK
            oJsonRespo['success'] := .T.
            oJsonRespo['message'] := STR0003 + RTrim(cGroupCode) + "/" + RTrim(cProductCode) + STR0013 //"Similar grupo " ### " deletado com sucesso"
            // Remove campos de erro caso tenha sucesso na delecao
            oJsonRespo:delName("field")
            oJsonRespo:delName("solution")
        EndIf

        // ==========================================
        // Libera Recursos da Memoria
        // ==========================================
        oModel:DeActivate()
        FreeObj(oModel)
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)
    FreeObj(oJQuery)

    RestArea(aArea)

Return .T.

/*/{Protheus.doc} FindSimilar
    Consulta similares do catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   27/05/2026
    @version p12
    @param   cGroupCode      , Character , filtro pelo codigo do grupo de similares (busca exata)
    @param   cProductBranch  , Character , filtro pela filial do produto (busca exata)
    @param   cProductCode    , Character , filtro pelo codigo do produto (busca exata)
    @return  aItens          , Array     , array de itens encontrados
/*/
Method FindSimilar(cGroupCode as Character, cProductBranch as Character, cProductCode as Character) as Array Class RetailAutopartsCatalogSimilarController
    Local oQueryQry     := Nil as Object
    Local jItem         := Nil as Object
    Local aItens        := {} as Array
    Local cQry          := "" as Character
    Local cAliasQry     := "" as Character
    Local nSeq          := 1 as Numeric
    Local aArea         := GetArea() as Array

    Default cGroupCode      := ""
    Default cProductBranch  := ""
    Default cProductCode    := ""

    dbSelectArea("MFY")

    cQry := " SELECT MFY.MFY_FILIAL, MFY.MFY_CODGRP, MFY.MFY_FILPRO, MFY.MFY_CODPRO, "
    cQry += " SB1.B1_DESC AS DESPROD "
    cQry += " FROM " + RetSqlName("MFY") + " MFY "
    cQry += " LEFT JOIN " + RetSqlName("SB1") + " SB1 ON SB1.B1_FILIAL = MFY.MFY_FILPRO AND SB1.B1_COD = MFY.MFY_CODPRO AND SB1.D_E_L_E_T_ = ? "
    cQry += " WHERE "
    cQry += " MFY.MFY_FILIAL = ? "

    If !Empty(cGroupCode)
        cQry += " AND MFY.MFY_CODGRP = ? "
    EndIf

    If !Empty(cProductBranch)
        cQry += " AND MFY.MFY_FILPRO = ? "
    EndIf

    If !Empty(cProductCode)
        cQry += " AND MFY.MFY_CODPRO = ? "
    EndIf

    cQry += " AND MFY.D_E_L_E_T_ = ? "
    cQry += " ORDER BY MFY.MFY_CODGRP, MFY.MFY_CODPRO "

    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)

    // Parametro do LEFT JOIN (D_E_L_E_T_)
    oQueryQry:SetString(nSeq++, Space(1))  // SB1.D_E_L_E_T_

    // Parametro do WHERE principal
    oQueryQry:SetString(nSeq++, xFilial("MFY"))

    If !Empty(cGroupCode)
        oQueryQry:SetString(nSeq++, PadR(cGroupCode, TamSx3("MFY_CODGRP")[1]))
    EndIf

    If !Empty(cProductBranch)
        oQueryQry:SetString(nSeq++, PadR(cProductBranch, TamSx3("MFY_FILPRO")[1]))
    EndIf

    If !Empty(cProductCode)
        oQueryQry:SetString(nSeq++, PadR(cProductCode, TamSx3("MFY_CODPRO")[1]))
    EndIf

    oQueryQry:SetString(nSeq++, Space(1))  // MFY.D_E_L_E_T_

    cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

    While (cAliasQry)->(!EOF())
        jItem := JsonObject():New()
        jItem["branch"]             := RTrim((cAliasQry)->MFY_FILIAL)
        jItem["similarGroupCode"]   := RTrim((cAliasQry)->MFY_CODGRP)
        jItem["productBranch"]      := RTrim((cAliasQry)->MFY_FILPRO)
        jItem["productCode"]        := RTrim((cAliasQry)->MFY_CODPRO)
        jItem["productDescription"] := RTrim((cAliasQry)->DESPROD)

        aAdd(aItens, jItem)
        jItem := Nil
        (cAliasQry)->(dbSkip())
    EndDo

    (cAliasQry)->(dbCloseArea())
    oQueryQry:Destroy()
    oQueryQry := Nil

    RestArea(aArea)

Return(aItens)
