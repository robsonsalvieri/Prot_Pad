#include "totvs.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "fwmvcdef.ch"
#include "retail.autoparts.catalog.vehicle.controller.ch"

namespace totvs.protheus.retail.autoparts.catalog.vehicle.controller

/*/{Protheus.doc} RetailAutopartsCatalogVehicleController
    API relacionadas a veiculos do catalogo de autopecas
    @author Bruno Almeida
    @since  14/05/2026
/*/
Class RetailAutopartsCatalogVehicleController

    private Method FindVehicle(cName as Character) as Array

    public Method New()

    @Get("/api/retail/v1/retailAutopartsCatalogVehicle/getDataForVehicle", description="Consulta os veiculos do catalogo de auto pecas.")
    public Method getDataForVehicle()

    @Post("/api/retail/v1/retailAutopartsCatalogVehicle/postDataForVehicle", description="Cadastra um novo veiculo para o catalogo de autopecas")
    public Method postDataForVehicle()

    @Put("/api/retail/v1/retailAutopartsCatalogVehicle/putDataForVehicle", description="Altera um veiculo existente no catalogo de autopecas")
    public Method putDataForVehicle()

    @Delete("/api/retail/v1/retailAutopartsCatalogVehicle/deleteDataForVehicle/:code", description="Deleta um veiculo do catalogo de autopecas")
    public Method deleteDataForVehicle()

EndClass

/*/{Protheus.doc} New
    Metodo construtor
    @type   method
    @author Bruno Almeida
    @since  14/05/2026
/*/
Method New() Class RetailAutopartsCatalogVehicleController
Return Self

/*/{Protheus.doc} getDataForVehicle
    Retorna os veiculos do catalogo de auto pecas
    @type    method
    @author  Bruno Almeida
    @since   14/05/2026
    @version p12
/*/
Method getDataForVehicle() Class RetailAutopartsCatalogVehicleController
    Local oJsonRespo    as Object
    Local oJParametr    as Object
    Local aItens        as Array
    Local cName         as Character

    oJsonRespo  := JsonObject():New()
    oJParametr  := JsonObject():New()
    aItens      := {}
    cName       := ""

    oJParametr := oRest:getQueryRequest()

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    If oJParametr['name'] == Nil .Or. Empty(oJParametr['name'])
        cName := ""
    Else
        cName := oJParametr['name']
    EndIf

    aItens := Self:FindVehicle(cName)

    If Len(aItens) > 0
        oJsonRespo["items"] := aItens
        oRest:setStatusCode(200)
    Else
        oJsonRespo["items"]    := {}
        oJsonRespo["message"] := STR0001 //"Dados não encontrados para o filtro informado"
        oRest:setStatusCode(404)
    EndIf

    oRest:setResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

Return .T.

/*/{Protheus.doc} postDataForVehicle
    Cadastro de veiculo do catalogo de auto pecas
    @type    method
    @author  Bruno Almeida
    @since   14/05/2026
    @version p12
/*/
Method postDataForVehicle() Class RetailAutopartsCatalogVehicleController
    Local oJsBody       as Object
    Local oJsonRespo    as Object
    Local oModel        as Object
    Local oModelME6     as Object
    Local cCodMon       as Character
    Local cNome         as Character
    Local cTpChass      as Character
    Local cTpVeic       as Character
    Local cClassi       as Character
    Local lGravouOK     as Logical
    Local aErros        as Array

    oJsonRespo  := JsonObject():New()
    oJsBody     := JsonObject():New()
    oModel      := Nil
    oModelME6   := Nil
    lGravouOK   := .F.
    aErros      := {}

    oJsBody:fromJson(oRest:GetBodyRequest())

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    If oJsBody['codmon'] == Nil .Or. Empty(oJsBody['codmon'])
        cCodMon := ""
    Else
        cCodMon := oJsBody['codmon']
    EndIf

    If oJsBody['name'] == Nil .Or. Empty(oJsBody['name'])
        cNome := ""
    Else
        cNome := oJsBody['name']
    EndIf

    If oJsBody['tpchass'] == Nil .Or. Empty(oJsBody['tpchass'])
        cTpChass := ""
    Else
        cTpChass := oJsBody['tpchass']
    EndIf

    If oJsBody['tpveic'] == Nil .Or. Empty(oJsBody['tpveic'])
        cTpVeic := ""
    Else
        cTpVeic := oJsBody['tpveic']
    EndIf

    If oJsBody['classi'] == Nil .Or. Empty(oJsBody['classi'])
        cClassi := ""
    Else
        cClassi := oJsBody['classi']
    EndIf

    oModel := FWLoadModel("LOJA650")
    oModel:SetOperation(MODEL_OPERATION_INSERT)
    oModel:Activate()

    oModelME6 := oModel:GetModel("ME6MASTER")

    oModelME6:SetValue("ME6_CODMON", cCodMon)
    oModelME6:SetValue("ME6_NOME",   Upper(cNome))
    oModelME6:SetValue("ME6_TPCHSS", cTpChass)
    oModelME6:SetValue("ME6_TPVEIC", cTpVeic)
    oModelME6:SetValue("ME6_CLASSI", cClassi)

    If oModel:VldData()
        lGravouOK := oModel:CommitData()
    EndIf

    If lGravouOK
        oRest:setStatusCode(201)
        oJsonRespo['success']  := .T.
        oJsonRespo['message'] := STR0002 + AllTrim(Upper(cNome)) + STR0003 //"Veículo " # " cadastrado com sucesso"
    Else
        oRest:setStatusCode(400)
        aErros := oModel:GetErrorMessage()

        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := IIF(Len(aErros) >= 6, aErros[6], STR0004) //"Erro ao cadastrar"
    EndIf
    
    oRest:SetResponse(oJsonRespo:toJson())

    oModelME6:DeActivate()
    oModel:DeActivate()

    FreeObj(oModelME6)
    FreeObj(oModel)
    FreeObj(oJsonRespo)
    FreeObj(oJsBody)

Return .T.

/*/{Protheus.doc} putDataForVehicle
    Altera o veículo do catálogo de autopeças
    @type    method
    @author  Bruno Almeida
    @since   14/05/2026
    @version p12
/*/
Method putDataForVehicle() Class RetailAutopartsCatalogVehicleController
    Local oJsonRespo    as Object
    Local oJsBody       as Object
    Local oModel        as Object
    Local oModelME6     as Object
    Local lGravouOK     as Logical
    Local lContinua     as Logical
    Local cCode         as Character
    Local cCodMon       as Character
    Local cNome         as Character
    Local cTpChass      as Character
    Local cTpVeic       as Character
    Local cClassi       as Character
    Local aArea         as Array
    Local aErros        as Array

    oJsonRespo  := JsonObject():New()
    oJsBody     := JsonObject():New()
    oModel      := Nil
    oModelME6   := Nil
    lGravouOK   := .F.
    lContinua   := .T.
    cCode       := ""
    cCodMon     := ""
    cNome       := ""
    cTpChass    := ""
    cTpVeic     := ""
    cClassi     := ""
    aArea       := {}
    aErros      := {}

    oJsBody:fromJson(oRest:GetBodyRequest())

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    If oJsBody['codvei'] == Nil .Or. Empty(oJsBody['codvei'])
        cCode := ""
    Else
        cCode := oJsBody['codvei']
    EndIf

    If oJsBody['codmon'] == Nil .Or. Empty(oJsBody['codmon'])
        cCodMon := ""
    Else
        cCodMon := oJsBody['codmon']
    EndIf

    If oJsBody['name'] == Nil .Or. Empty(oJsBody['name'])
        cNome := ""
    Else
        cNome := oJsBody['name']
    EndIf

    If oJsBody['tpchass'] == Nil .Or. Empty(oJsBody['tpchass'])
        cTpChass := ""
    Else
        cTpChass := oJsBody['tpchass']
    EndIf

    If oJsBody['tpveic'] == Nil .Or. Empty(oJsBody['tpveic'])
        cTpVeic := ""
    Else
        cTpVeic := oJsBody['tpveic']
    EndIf

    If oJsBody['classi'] == Nil .Or. Empty(oJsBody['classi'])
        cClassi := ""
    Else
        cClassi := oJsBody['classi']
    EndIf

    If Empty(cCode)
        oRest:setStatusCode(422)
        oJsonRespo['success']  := .F.
        oJsonRespo['message'] := STR0005 //"Parâmetro 'codvei' e obrigatório"
        lContinua := .F.
    EndIf

    If lContinua
        aArea := GetArea()
        dbSelectArea('ME6')
        ME6->(dbSetOrder(1)) //ME6_FILIAL+ME6_CODVEI

        If !ME6->(dbSeek(xFilial("ME6") + padR(cCode, TamSx3("ME6_CODVEI")[1])))
            oRest:setStatusCode(404)
            oJsonRespo['success']  := .F.
            oJsonRespo['message'] := STR0006 + AllTrim(cCode) + STR0007 //"Registro " # " não encontrado"
            lContinua := .F.
        EndIf

        If lContinua
            oModel := FWLoadModel("LOJA650")
            oModel:SetOperation(MODEL_OPERATION_UPDATE)
            oModel:Activate()

            oModelME6 := oModel:GetModel("ME6MASTER")

            oModelME6:SetValue("ME6_CODMON", cCodMon)
            oModelME6:SetValue("ME6_NOME",   Upper(cNome))
            oModelME6:SetValue("ME6_TPCHSS", cTpChass)
            oModelME6:SetValue("ME6_TPVEIC", cTpVeic)
            oModelME6:SetValue("ME6_CLASSI", cClassi)

            If oModel:VldData()
                lGravouOK := oModel:CommitData()
            EndIf

            If lGravouOK
                oRest:setStatusCode(200)
                oJsonRespo['success']  := .T.
                oJsonRespo['message'] := STR0002 + AllTrim(Upper(cNome)) + STR0008 //"Veiculo " # " atualizado com sucesso"
            Else
                oRest:setStatusCode(400)
                aErros := oModel:GetErrorMessage()

                oJsonRespo['success'] := .F.
                oJsonRespo['message'] := IIF(Len(aErros) >= 6, aErros[6], STR0009) //"Erro ao atualizar"
            EndIf

            oModelME6:DeActivate()
            oModel:DeActivate()

            FreeObj(oModelME6)
            FreeObj(oModel)

        EndIf

        RestArea(aArea)
    EndIf

    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJsBody)

Return .T.

/*/{Protheus.doc} deleteDataForVehicle
    Deleta o veiculo do catalogo de auto pecas
    @type    method
    @author  Bruno Almeida
    @since   14/05/2026
    @version p12
/*/
Method deleteDataForVehicle() Class RetailAutopartsCatalogVehicleController
    Local oJsonRespo    as Object
    Local oJParametr    as Object
    Local oModel        as Object
    Local lGravouOK     as Logical
    Local lContinua     as Logical
    Local cCode         as Character
    Local aArea         as Array
    Local aErros        as Array

    oJsonRespo  := JsonObject():New()
    oJParametr  := JsonObject():New()
    oModel      := Nil
    lGravouOK   := .F.
    lContinua   := .T.
    cCode       := ""
    aArea       := {}
    aErros      := {}

    oJParametr := oRest:getPathParamsRequest()
    cCode      := IIF(oJParametr['code'] == Nil .Or. Empty(oJParametr['code']), "", oJParametr['code'])
    
    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    aArea := GetArea()
    dbSelectArea('ME6')
    ME6->(dbSetOrder(1)) //ME6_FILIAL+ME6_CODVEI

    If !ME6->(dbSeek(xFilial("ME6") + PadR(cCode, TamSx3("ME6_CODVEI")[1])))
        oRest:setStatusCode(404)
        oJsonRespo['success']  := .F.
        oJsonRespo['message'] := STR0006 + AllTrim(cCode) + STR0007 //"Registro " # " não encontrado"
        lContinua := .F.
    EndIf

    If lContinua
        oModel := FWLoadModel("LOJA650")
        oModel:SetOperation(MODEL_OPERATION_DELETE)
        oModel:Activate()

        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        EndIf

        If lGravouOK
            oRest:setStatusCode(200)
            oJsonRespo['success']  := .T.
            oJsonRespo['message'] := STR0002 + AllTrim(cCode) + STR0010 //"Veículo " # " deletado com sucesso"
        EndIf

        oModel:DeActivate()
    EndIf

    RestArea(aArea)

    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oModel)
    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

Return .T.

/*/{Protheus.doc} FindVehicle
    Consulta veiculos do catalogo de auto pecas
    @type    method
    @author  Bruno Almeida
    @since   14/05/2026
    @version p12
    @param   cName   , Character , filtro pelo nome do veiculo
    @return  array   , Array     , array de itens encontrados
/*/
Method FindVehicle(cName as Character) as Array Class RetailAutopartsCatalogVehicleController
    Local oQueryQry     as Object
    Local jItem         as Object
    Local aItens        as Array
    Local cQry          as Character
    Local cAliasQry     as Character
    Local nSeq          as Numeric
    Local aArea         as Array

    Default cName := ""

    oQueryQry   := Nil
    jItem       := Nil
    nSeq        := 1
    aItens      := {}
    aArea       := GetArea()

    dbSelectArea("ME6")

    cQry := " SELECT ME6.ME6_FILIAL, ME6.ME6_CODVEI, ME0.ME0_NOME, ME6.ME6_CODMON, ME6.ME6_NOME, SX5CH.X5_DESCRI TPCHSS, SX5VE.X5_DESCRI TPVEIC, SX5CL.X5_DESCRI CLASSI "
    cQry += " FROM " + RetSqlName("ME6") + " ME6 "
    cQry += " INNER JOIN " + RetSqlName("ME0") + " ME0 ON ME0.ME0_FILIAL = ? AND ME0.ME0_CODMON = ME6.ME6_CODMON AND ME0.D_E_L_E_T_ = ? "
    cQry += " LEFT JOIN "  + RetSqlName("SX5") + " SX5CH ON SX5CH.X5_TABELA = 'WJ' AND ME6.ME6_TPCHSS = SX5CH.X5_CHAVE AND SX5CH.D_E_L_E_T_ = ? "
    cQry += " LEFT JOIN "  + RetSqlName("SX5") + " SX5VE ON SX5VE.X5_TABELA = 'WK' AND ME6.ME6_TPVEIC = SX5VE.X5_CHAVE AND SX5VE.D_E_L_E_T_ = ? "
    cQry += " LEFT JOIN "  + RetSqlName("SX5") + " SX5CL ON SX5CL.X5_TABELA = 'WL' AND ME6.ME6_CLASSI = SX5CL.X5_CHAVE AND SX5CL.D_E_L_E_T_ = ? "
    cQry += " WHERE "
    cQry += " ME6.ME6_FILIAL = ? "

    If !Empty(cName)
        cQry += " AND ME6.ME6_NOME LIKE ? "
    EndIf

    cQry += " AND ME6.D_E_L_E_T_ = ? "
    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)

    oQueryQry:SetString(nSeq++, xFilial("ME0"))
    oQueryQry:SetString(nSeq++, Space(1))
    oQueryQry:SetString(nSeq++, Space(1))
    oQueryQry:SetString(nSeq++, Space(1))
    oQueryQry:SetString(nSeq++, Space(1))
    oQueryQry:SetString(nSeq++, xFilial("ME6"))

    If !Empty(cName)
        oQueryQry:SetString(nSeq++, "%" + Upper(cName) + "%")
    EndIf

    oQueryQry:SetString(nSeq++, Space(1))

    cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

    While (cAliasQry)->(!EOF())
        jItem := JsonObject():New()
        jItem["branch"]       := AllTrim((cAliasQry)->ME6_FILIAL)
        jItem["code"]         := AllTrim((cAliasQry)->ME6_CODVEI)
        jItem["manufacturer"] := AllTrim((cAliasQry)->ME0_NOME)
        jItem["name"]         := AllTrim((cAliasQry)->ME6_NOME)
        jItem["tpchass"]      := AllTrim((cAliasQry)->TPCHSS)
        jItem["tpveic"]       := AllTrim((cAliasQry)->TPVEIC)
        jItem["classi"]       := AllTrim((cAliasQry)->CLASSI)
        aAdd(aItens, jItem)
        jItem := Nil
        (cAliasQry)->(dbSkip())
    EndDo

    (cAliasQry)->(dbCloseArea())

    RestArea(aArea)

    FreeObj(oQueryQry)

Return(aItens)
