#include "tlpp-core.th"
#include "totvs.ch"
#include "tlpp-rest.th"
#include "fwmvcdef.ch"
#include "retail.autoparts.catalog.systemset.controller.ch"

namespace totvs.protheus.retail.autoparts.catalog.systemset.controller

/*/{Protheus.doc} RetailAutopartsCatalogSystemSetController
    API relacionadas ao cadastro de Conjunto Sistema do catalogo de autopecas
    @type    class
    @author  Bruno Almeida
    @since   22/05/2026
/*/
Class RetailAutopartsCatalogSystemSetController

    private Method FindSystemSet(cDescription as Character) as Array
    private Method CountSystemSet() as Numeric

    public Method New() as Object

    @Get("/api/retail/v1/retailAutopartsCatalogSystemSet/getDataForSystemSet", description="Consulta os conjuntos sistema do catalogo de auto pecas.")
    public Method getDataForSystemSet() as Logical

    @Get("/api/retail/v1/retailAutopartsCatalogSystemSet/getCountDataForSystemSet", description="Consulta a quantidade total de conjuntos sistema do catalogo de auto pecas.")
    public Method getCountDataForSystemSet() as Logical

    @Post("/api/retail/v1/retailAutopartsCatalogSystemSet/postDataForSystemSet", description="Cadastra um novo conjunto sistema para o catalogo de autopecas")
    public Method postDataForSystemSet() as Logical

    @Put("/api/retail/v1/retailAutopartsCatalogSystemSet/putDataForSystemSet", description="Altera um conjunto sistema existente no catalogo de autopecas")
    public Method putDataForSystemSet() as Logical

    @Delete("/api/retail/v1/retailAutopartsCatalogSystemSet/deleteDataForSystemSet/:code", description="Deleta um conjunto sistema do catalogo de autopecas")
    public Method deleteDataForSystemSet() as Logical

EndClass

/*/{Protheus.doc} New
    Metodo construtor
    @type   method
    @author Bruno Almeida
    @since  22/05/2026
    @return object, Objeto instanciado da classe RetailAutopartsCatalogSystemSetController
/*/
Method New() as Object Class RetailAutopartsCatalogSystemSetController
Return Self

/*/{Protheus.doc} getDataForSystemSet
    Retorna os conjuntos sistema do catalogo de auto pecas
    @type    method
    @author  Bruno Almeida
    @since   22/05/2026
    @version p12
    @return  logical, .T. indicando se a execucao foi bem sucedida
/*/
Method getDataForSystemSet() as Logical Class RetailAutopartsCatalogSystemSetController
    Local oJsonRespo    as Object
    Local oJParametr    as Object
    Local aItens        as Array
    Local cDescription  as Character

    oJsonRespo   := JsonObject():New()
    aItens       := {}
    cDescription := ""

    oJParametr := oRest:getQueryRequest()

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    If oJParametr['description'] == Nil .Or. Empty(oJParametr['description'])
        cDescription := ""
    Else
        cDescription := oJParametr['description']
    EndIf

    aItens := Self:FindSystemSet(cDescription)

    If Len(aItens) > 0
        oJsonRespo["items"] := aItens
        oRest:setStatusCode(200)
    Else
        oJsonRespo["items"]   := {}
        oJsonRespo["message"] := STR0001 //"Dados não encontrados para o filtro informado"
        oRest:setStatusCode(404)
    EndIf

    oRest:setResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

Return .T.

/*/{Protheus.doc} getCountDataForSystemSet
    Retorna a quantidade total de conjuntos sistema validos do catalogo de auto pecas
    @type    method
    @author  eduardo.Flima
    @since   01/06/2026
    @version p12
    @return  logical, .T. indicando se a execucao foi bem sucedida
/*/
Method getCountDataForSystemSet() as Logical Class RetailAutopartsCatalogSystemSetController
    Local oJsonRespo    as Object
    Local nTotal        as Numeric

    oJsonRespo := JsonObject():New()
    nTotal     := 0

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    nTotal := Self:CountSystemSet()

    oJsonRespo["total"] := nTotal
    oRest:setStatusCode(200)

    oRest:setResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)

Return .T.

/*/{Protheus.doc} postDataForSystemSet
    Cadastro de conjunto sistema do catalogo de auto pecas
    @type    method
    @author  Bruno Almeida
    @since   22/05/2026
    @version p12
    @return  logical, .T. indicando se a execucao foi bem sucedida
/*/
Method postDataForSystemSet() as Logical Class RetailAutopartsCatalogSystemSetController
    Local oJsBody       as Object
    Local oJsonRespo    as Object
    Local oModel        as Object
    Local oModelMI2     as Object
    Local cDescription  as Character
    Local lGravouOK     as Logical
    Local aErros        as Array

    oJsonRespo  := JsonObject():New()
    oJsBody     := JsonObject():New()
    oModel      := Nil
    oModelMI2   := Nil
    cDescription := ""
    lGravouOK   := .F.
    aErros      := {}

    oJsBody:fromJson(oRest:GetBodyRequest())

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    If oJsBody['description'] == Nil .Or. Empty(oJsBody['description'])
        cDescription := ""
    Else
        cDescription := oJsBody['description']
    EndIf

    oModel := FWLoadModel("LOJA660")
    oModel:SetOperation(MODEL_OPERATION_INSERT)
    oModel:Activate()

    oModelMI2 := oModel:GetModel("MI2MASTER")

    oModelMI2:SetValue("MI2_DESCRI", Upper(cDescription))

    If oModel:VldData()
        lGravouOK := oModel:CommitData()
    EndIf

    If lGravouOK
        oRest:setStatusCode(201)
        oJsonRespo["success"] := .T.
        oJsonRespo["message"] := STR0002 + AllTrim(Upper(cDescription)) + STR0003 //"Conjunto Sistema " # " cadastrado com sucesso"
    Else
        oRest:setStatusCode(400)
        aErros := oModel:GetErrorMessage()

        oJsonRespo["success"] := .F.
        oJsonRespo["message"] := IIF(Len(aErros) >= 6, aErros[6], STR0004) //"Erro ao cadastrar"
    EndIf

    oRest:SetResponse(oJsonRespo:toJson())

    oModelMI2:DeActivate()
    oModel:DeActivate()

    oModelMI2:Destroy()
    oModel:Destroy()

    FreeObj(oJsonRespo)
    FreeObj(oJsBody)

Return .T.

/*/{Protheus.doc} putDataForSystemSet
    Altera o conjunto sistema do catalogo de auto pecas
    @type    method
    @author  Bruno Almeida
    @since   22/05/2026
    @version p12
    @return  logical, .T. indicando se a execucao foi bem sucedida
/*/
Method putDataForSystemSet() as Logical Class RetailAutopartsCatalogSystemSetController
    Local oJsonRespo    as Object
    Local oJsBody       as Object
    Local oModel        as Object
    Local oModelMI2     as Object
    Local lGravouOK     as Logical
    Local lContinua     as Logical
    Local cCode         as Character
    Local cDescription  as Character
    Local aArea         as Array
    Local aErros        as Array

    oJsonRespo   := JsonObject():New()
    oJsBody      := JsonObject():New()
    oModel       := Nil
    oModelMI2    := Nil
    lGravouOK    := .F.
    lContinua    := .T.
    cCode        := ""
    cDescription := ""
    aArea        := {}
    aErros       := {}

    oJsBody:fromJson(oRest:GetBodyRequest())

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    If oJsBody['code'] == Nil .Or. Empty(oJsBody['code'])
        cCode := ""
    Else
        cCode := oJsBody['code']
    EndIf

    If oJsBody['description'] == Nil .Or. Empty(oJsBody['description'])
        cDescription := ""
    Else
        cDescription := oJsBody['description']
    EndIf

    If Empty(cCode)
        oRest:setStatusCode(422)
        oJsonRespo["success"] := .F.
        oJsonRespo["message"] := STR0005 //"Parâmetro 'code' e obrigatorio"
        lContinua := .F.
    EndIf

    If lContinua
        aArea := GetArea()
        dbSelectArea('MI2')
        MI2->(dbSetOrder(1)) //MI2_FILIAL+MI2_CODCON

        If !MI2->(dbSeek(xFilial("MI2") + PadR(cCode, TamSx3("MI2_CODCON")[1])))
            oRest:setStatusCode(404)
            oJsonRespo["success"] := .F.
            oJsonRespo["message"] := STR0008 + AllTrim(cCode) + STR0009 //"Registro " # " não encontrado"
            lContinua := .F.
        EndIf

        If lContinua
            oModel := FWLoadModel("LOJA660")
            oModel:SetOperation(MODEL_OPERATION_UPDATE)
            oModel:Activate()

            oModelMI2 := oModel:GetModel("MI2MASTER")

            oModelMI2:SetValue("MI2_DESCRI", Upper(cDescription))

            If oModel:VldData()
                lGravouOK := oModel:CommitData()
            EndIf

            If lGravouOK
                oRest:setStatusCode(200)
                oJsonRespo["success"] := .T.
                oJsonRespo["message"] := STR0002 + AllTrim(Upper(cDescription)) + STR0006 //"Conjunto Sistema " # " atualizado com sucesso"
            Else
                oRest:setStatusCode(400)
                aErros := oModel:GetErrorMessage()

                oJsonRespo["success"] := .F.
                oJsonRespo["message"] := IIF(Len(aErros) >= 6, aErros[6], STR0007) //"Erro ao atualizar"
            EndIf

            oModelMI2:DeActivate()
            oModel:DeActivate()

            oModelMI2:Destroy()
            oModel:Destroy()
        EndIf

        RestArea(aArea)
    EndIf

    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJsBody)

Return .T.

/*/{Protheus.doc} deleteDataForSystemSet
    Deleta o conjunto sistema do catalogo de auto pecas
    @type    method
    @author  Bruno Almeida
    @since   22/05/2026
    @version p12
    @return  logical, .T. indicando se a execucao foi bem sucedida
/*/
Method deleteDataForSystemSet() as Logical Class RetailAutopartsCatalogSystemSetController
    Local oJsonRespo    as Object
    Local oJParametr    as Object
    Local oModel        as Object
    Local lGravouOK     as Logical
    Local lContinua     as Logical
    Local cCode         as Character
    Local aArea         as Array
    Local aErros        as Array

    oJsonRespo  := JsonObject():New()
    oModel      := Nil
    lGravouOK   := .F.
    lContinua   := .T.
    cCode       := ""
    aArea       := {}
    aErros      := {}

    oJParametr := oRest:getPathParamsRequest()

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    cCode := oJParametr['code']

    aArea := GetArea()
    dbSelectArea('MI2')
    MI2->(dbSetOrder(1)) //MI2_FILIAL+MI2_CODCON

    If !MI2->(dbSeek(xFilial("MI2") + PadR(cCode, TamSx3("MI2_CODCON")[1])))
        oRest:setStatusCode(404)
        oJsonRespo["success"] := .F.
        oJsonRespo["message"] := STR0008 + AllTrim(cCode) + STR0009 //"Registro " # " não encontrado"
        lContinua := .F.
    EndIf

    If lContinua
        oModel := FWLoadModel("LOJA660")
        oModel:SetOperation(MODEL_OPERATION_DELETE)
        oModel:Activate()

        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        EndIf

        If lGravouOK
            oRest:setStatusCode(200)
            oJsonRespo["success"] := .T.
            oJsonRespo["message"] := STR0002 + AllTrim(cCode) + STR0010 //"Conjunto Sistema " # " deletado com sucesso"
        EndIf

        oModel:DeActivate()
        oModel:Destroy()
    EndIf

    RestArea(aArea)

    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

Return .T.

/*/{Protheus.doc} FindSystemSet
    Consulta conjuntos sistema do catalogo de auto pecas
    @type    method
    @author  Bruno Almeida
    @since   22/05/2026
    @version p12
    @param   cDescription , Character , filtro pela descricao do conjunto sistema
    @return  aItens       , Array     , array de itens encontrados
/*/
Method FindSystemSet(cDescription as Character) as Array Class RetailAutopartsCatalogSystemSetController
    Local oQueryQry     as Object
    Local jItem         as Object
    Local aItens        as Array
    Local cQry          as Character
    Local cAliasQry     as Character
    Local nSeq          as Numeric
    Local aArea         as Array

    Default cDescription := ""

    oQueryQry   := Nil
    jItem       := Nil
    nSeq        := 1
    aItens      := {}
    aArea       := GetArea()

    dbSelectArea("MI2")

    cQry := " SELECT MI2.MI2_FILIAL, MI2.MI2_CODCON, MI2.MI2_DESCRI "
    cQry += " FROM " + RetSqlName("MI2") + " MI2 "
    cQry += " WHERE "
    cQry += " MI2.MI2_FILIAL = ? "

    If !Empty(cDescription)
        cQry += " AND MI2.MI2_DESCRI LIKE ? "
    EndIf

    cQry += " AND MI2.D_E_L_E_T_ = ? "
    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)

    oQueryQry:SetString(nSeq++, xFilial("MI2"))

    If !Empty(cDescription)
        oQueryQry:SetString(nSeq++, "%" + Upper(cDescription) + "%")
    EndIf

    oQueryQry:SetString(nSeq++, Space(1))

    cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

    While (cAliasQry)->(!EOF())
        jItem := JsonObject():New()
        jItem["branch"]      := AllTrim((cAliasQry)->MI2_FILIAL)
        jItem["code"]        := AllTrim((cAliasQry)->MI2_CODCON)
        jItem["description"] := AllTrim((cAliasQry)->MI2_DESCRI)
        aAdd(aItens, jItem)
        jItem := Nil
        (cAliasQry)->(dbSkip())
    EndDo

    (cAliasQry)->(dbCloseArea())

    RestArea(aArea)

    oQueryQry:Destroy()

Return(aItens)

/*/{Protheus.doc} CountSystemSet
    Consulta a quantidade total de conjuntos sistema validos
    @type    method
    @author  eduardo.Flima
    @since   01/06/2026
    @version p12
    @return  nTotal      , Numeric   , quantidade total de registros validos
/*/
Method CountSystemSet() as Numeric Class RetailAutopartsCatalogSystemSetController
    Local oQueryQry     as Object
    Local cQry          as Character
    Local nSeq          as Numeric
    Local nTotal        as Numeric
    Local aArea         as Array

    oQueryQry   := Nil
    nSeq        := 1
    nTotal      := 0
    aArea       := GetArea()


    cQry := " SELECT COUNT(1) AS TOTAL "
    cQry += " FROM " + RetSqlName("MI2") + " MI2 "
    cQry += " WHERE "
    cQry += " MI2.MI2_FILIAL = ? "
    cQry += " AND MI2.D_E_L_E_T_ = ? "
    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)

    oQueryQry:SetString(nSeq++, xFilial("MI2"))
    oQueryQry:SetString(nSeq++, Space(1))
    nTotal := Val(cValToChar(oQueryQry:ExecScalar('TOTAL')))//ExecScalar retorna xValue (variant); se o banco retornar Nil (query sem resultado ou erro), a atribuição a nTotal as Numeric pode causar comportamento indefinido na serialização JSON

    RestArea(aArea)

    oQueryQry:Destroy()

Return nTotal
