#include "totvs.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "fwmvcdef.ch"
#include "retail.autoparts.catalog.productmanufacturer.controller.ch"

namespace totvs.protheus.retail.autoparts.catalog.productmanufacturer.controller


/*/{Protheus.doc} RetailAutopartsCatalogProductManufacturerController
    API relacionadas ao cadastro de Produto x Fabricante do catalogo de autopecas
    @author Alberto Deviciente
    @since  24/05/2026
/*/
Class RetailAutopartsCatalogProductManufacturerController

    private Method FindProductManufacturer(cCodProd as Character, cFilFab as Character, cCodFab as Character, cLojaFab as Character) as Array

    public Method New()

    @Get("/api/retail/v1/retailAutopartsCatalogProductManufacturer/getDataForProductManufacturer", description="Consulta os registros de Produto x Fabricante do catalogo de autopecas.")
    public Method getDataForProductManufacturer()

    @Post("/api/retail/v1/retailAutopartsCatalogProductManufacturer/postDataForProductManufacturer", description="Cadastra um novo registro de Produto x Fabricante no catalogo de autopecas.")
    public Method postDataForProductManufacturer()

    @Put("/api/retail/v1/retailAutopartsCatalogProductManufacturer/putDataForProductManufacturer", description="Altera um registro existente de Produto x Fabricante no catalogo de autopecas.")
    public Method putDataForProductManufacturer()

    @Delete("/api/retail/v1/retailAutopartsCatalogProductManufacturer/deleteDataForProductManufacturer/:productCode/:manufacturerCode/:manufacturerStore", description="Deleta um registro de Produto x Fabricante do catalogo de autopecas.")
    public Method deleteDataForProductManufacturer()

EndClass

/*/{Protheus.doc} New
    Metodo construtor
    @type   method
    @author Alberto Deviciente
    @since  24/05/2026
/*/
Method New() Class RetailAutopartsCatalogProductManufacturerController
Return Self

/*/{Protheus.doc} getDataForProductManufacturer
    Retorna os registros de Produto x Fabricante do catalogo de autopecas
    @type    method
    @author  Alberto Deviciente
    @since   24/05/2026
    @version p12
/*/
Method getDataForProductManufacturer() Class RetailAutopartsCatalogProductManufacturerController
    Local oJsonRespo    as Object
    Local oJParametr    as Object
    Local aArea         as Array
    Local aItens        as Array
    Local cCodProd      as Character
    Local cFilFab       as Character
    Local cCodFab       as Character
    Local cLojaFab      as Character

    oJsonRespo  := JsonObject():New()
    oJParametr  := JsonObject():New()
    aArea       := GetArea()
    aItens      := {}
    cCodProd    := ""
    cFilFab     := ""
    cCodFab     := ""
    cLojaFab    := ""
    
    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    oJParametr := oRest:getQueryRequest()

    // Obtém os parâmetros informados na requisição via URL (query param)
  	If oJParametr:hasProperty('productCode')
        cCodProd := oJParametr['productCode']
    EndIf
    If oJParametr:hasProperty('manufacturerBranch')
        cFilFab := oJParametr['manufacturerBranch']
    EndIf
    If oJParametr:hasProperty('manufacturerCode')
        cCodFab := oJParametr['manufacturerCode']
    EndIf
    If oJParametr:hasProperty('manufacturerStore')
        cLojaFab := oJParametr['manufacturerStore']
    EndIf

    aItens := Self:FindProductManufacturer(cCodProd, cFilFab, cCodFab, cLojaFab)

    If Len(aItens) > 0
        oJsonRespo["items"] := aItens
        oRest:setStatusCode(200)  // HTTP 200 = Sucesso
    Else
        oJsonRespo["items"]   := {}
        oJsonRespo["message"] := STR0001 //"Dados nao encontrados para o filtro informado"
        oRest:setStatusCode(404)  // HTTP 404 = Not Found
    EndIf

    RestArea(aArea)

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:setResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)

Return .T.

/*/{Protheus.doc} postDataForProductManufacturer
    Cadastro de Produto x Fabricante no catalogo de autopecas
    @type    method
    @author  Alberto Deviciente
    @since   24/05/2026
    @version p12
/*/
Method postDataForProductManufacturer() Class RetailAutopartsCatalogProductManufacturerController
    Local oJsBody       as Object
    Local oJsonRespo    as Object
    Local oModel        as Object
    Local oModelMG1     as Object
    Local cCodProd      as Character
    Local cCodFab       as Character
    Local cLojaFab      as Character
    Local lGravouOK     as Logical
    Local aErros        as Array

    oJsBody     := JsonObject():New()
    oJsonRespo  := JsonObject():New()
    oModel      := Nil
    oModelMG1   := Nil
    cCodProd    := ""
    cCodFab     := ""
    cLojaFab    := ""
    lGravouOK   := .F.
    aErros      := {}

    dbSelectArea("MG1")

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    oJsBody:fromJson(oRest:GetBodyRequest())

    // Obtém os dados enviados na Requisição (Body)
    If oJsBody:hasProperty('productCode')
        cCodProd := oJsBody['productCode']
    EndIf
    If oJsBody:hasProperty('manufacturerCode')
        cCodFab := oJsBody['manufacturerCode']
    EndIf
    If oJsBody:hasProperty('manufacturerStore')
        cLojaFab := oJsBody['manufacturerStore']
    EndIf

    // ==========================================
    // Carrega o Model MVC
    // ==========================================
    oModel := FWLoadModel("LOJA680")
    oModel:SetOperation(MODEL_OPERATION_INSERT)
    oModel:Activate()

    oModelMG1 := oModel:GetModel("MG1MASTER")

    // ==========================================
    // Alimenta os Campos do Model
    // ==========================================
    oModelMG1:SetValue("MG1_CODPRD", cCodProd)
    oModelMG1:SetValue("MG1_CODFAB", cCodFab)
    oModelMG1:SetValue("MG1_LOJFAB", cLojaFab)

    // ==========================================
    // Valida os dados do Model
    // ==========================================
    If oModel:VldData()
        // ==========================================
        // Grava os dados do Model
        // ==========================================
        lGravouOK := oModel:CommitData()
    EndIf

    If lGravouOK
        oRest:setStatusCode(201)  // HTTP 201 = Created
        oJsonRespo['success'] := .T.
        oJsonRespo['message'] := STR0002 + AllTrim(cCodProd) + STR0003 + AllTrim(cCodFab) + "/" + AllTrim(cLojaFab) + STR0004 //"Produto " ### " x Fabricante/Loja " ### "/" ### " cadastrado com sucesso"
        oJsonRespo['productCode'] := cCodProd
        oJsonRespo['manufacturerCode'] := cCodFab
        oJsonRespo['manufacturerStore'] := cLojaFab  
    Else
        oRest:setStatusCode(400)  // HTTP 400 = Bad Request

        // Captura os erros do Model
        aErros := oModel:GetErrorMessage()

        /*
        Estrutura do Array aErros:
        [1] = Id do formulário de origem
        [2] = Id do campo de origem
        [3] = Id do formulário de erro
        [4] = Id do campo de erro
        [5] = Id do erro
        [6] = Mensagem do erro
        [7] = Mensagem da solução
        [8] = Valor atribuído
        [9] = Valor anterior
        */
        oJsonRespo['success']   := .F.
        oJsonRespo['message']   := IIf(!Empty(aErros[6]), aErros[6], STR0005) //"Erro ao cadastrar"
        oJsonRespo['field']     := iif(!Empty(aErros[4]), aErros[4], "")
        oJsonRespo['errorId']   := iif(!Empty(aErros[5]), aErros[5], "")
        oJsonRespo['solution']  := iif(!Empty(aErros[7]), aErros[7], "")
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    // ==========================================
    // Desativa o modelo de dados
    // ==========================================
    oModelMG1:DeActivate()
    oModel:DeActivate()

    // ==========================================
    // Libera Recursos da Memória
    // ==========================================
    FreeObj(oModelMG1)
    FreeObj(oModel)
    FreeObj(oJsonRespo)
    FreeObj(oJsBody)

Return .T.

/*/{Protheus.doc} putDataForProductManufacturer
    Altera o registro de Produto x Fabricante no catalogo de autopecas
    @type    method
    @author  Alberto Deviciente
    @since   24/05/2026
    @version p12
/*/
Method putDataForProductManufacturer() Class RetailAutopartsCatalogProductManufacturerController
    Local oJsonRespo    as Object
    Local oJsBody       as Object
    Local oModel        as Object
    Local oModelMG1     as Object
    Local lGravouOK     as Logical
    Local lContinua     as Logical
    Local cCodProd      as Character
    Local cCodFab       as Character
    Local cLojaFab      as Character
    Local aArea         as Array
    Local aErros        as Array
    Local cFilMG1       as Character
    Local cFilSA2       as Character
    Local cFilSB1       as Character
    Local nStatusCode   as Numeric
    Local cMsg          as Character

    oJsonRespo  := JsonObject():New()
    oJsBody     := JsonObject():New()
    oModel      := Nil
    oModelMG1   := Nil
    lGravouOK   := .F.
    lContinua   := .T.
    cCodProd    := ""
    cCodFab     := ""
    cLojaFab    := ""
    aArea       := {}
    aErros      := {}

    cFilMG1 := xFilial("MG1")
    cFilSA2 := xFilial("SA2")
    cFilSB1 := xFilial("SB1")

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    oJsBody:fromJson(oRest:GetBodyRequest())

    // Obtém os dados enviados na Requisição (Body)
    If oJsBody:hasProperty('productCode')
        cCodProd := oJsBody['productCode']
    EndIf
    If oJsBody:hasProperty('manufacturerCode')
        cCodFab := oJsBody['manufacturerCode']
    EndIf
    If oJsBody:hasProperty('manufacturerStore')
        cLojaFab := oJsBody['manufacturerStore']
    EndIf

    If Empty(cCodProd) .Or. Empty(cCodFab) .Or. Empty(cLojaFab)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := STR0006 + "'productCode', 'manufacturerCode', 'manufacturerStore'" + STR0007 //"Parametros " ### " sao obrigatorios"
        lContinua := .F.
    EndIf

    If lContinua
        aArea := GetArea()
        dbSelectArea('MG1')
        MG1->(dbSetOrder(1)) //MG1_FILIAL+MG1_FILFAB+MG1_CODFAB+MG1_LOJFAB+MG1_FILPRD+MG1_CODPRD

        If !MG1->(dbSeek(cFilMG1 + cFilSA2 + PadR(cCodFab, TamSx3("MG1_CODFAB")[1]) + PadR(cLojaFab, TamSx3("MG1_LOJFAB")[1]) + cFilSB1 + PadR(cCodProd, TamSx3("MG1_CODPRD")[1])))
            oRest:setStatusCode(404)  // HTTP 404 = Not Found
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0002 + AllTrim(cCodProd) + STR0003 + AllTrim(cCodFab) + "/" + AllTrim(cLojaFab) + STR0009 //"Produto " ### " x Fabricante/Loja " ### "/" ### " nao encontrado"
            lContinua := .F.
        EndIf

        If lContinua
            // ==========================================
            // Carrega o Model MVC para Alteração
            // ==========================================
            oModel := FWLoadModel("LOJA680")
            oModel:SetOperation(MODEL_OPERATION_UPDATE)
            oModel:Activate()

            oModelMG1 := oModel:GetModel("MG1MASTER")

            oModelMG1:SetValue("MG1_CODPRD", cCodProd)
            oModelMG1:SetValue("MG1_CODFAB", cCodFab)
            oModelMG1:SetValue("MG1_LOJFAB", cLojaFab)

            If oModel:VldData()
                lGravouOK := oModel:CommitData()
            EndIf

            nStatusCode := IIf(lGravouOK, 200, 400) // HTTP 200 = OK, HTTP 400 = Bad Request
            cMsg        := IIF(lGravouOK,STR0002 + AllTrim(cCodProd) + STR0003 + AllTrim(cCodFab) + "/" + AllTrim(cLojaFab) + STR0010, STR0011 ) //"Produto " ### " x Fabricante/Loja " ### "/" ### " atualizado com sucesso "### "Erro ao atualizar"
            
            oRest:setStatusCode(nStatusCode)  // HTTP 200 = OK
            oJsonRespo['success'] := lGravouOK
            oJsonRespo['message'] := cMsg
            oJsonRespo['productCode'] := cCodProd
            oJsonRespo['manufacturerCode'] := cCodFab
            oJsonRespo['manufacturerStore'] := cLojaFab  

            oModelMG1:DeActivate()
            oModel:DeActivate()

            // ==========================================
            // Libera Recursos da Memória
            // ==========================================
            FreeObj(oModelMG1)
            FreeObj(oModel)
        EndIf

        RestArea(aArea)
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    // ==========================================
    // Libera Recursos da Memória
    // ==========================================
    FreeObj(oJsonRespo)
    FreeObj(oJsBody)

Return .T.

/*/{Protheus.doc} deleteDataForProductManufacturer
    Deleta o registro de Produto x Fabricante do catalogo de autopecas
    @type    method
    @author  Alberto Deviciente
    @since   24/05/2026
    @version p12
/*/
Method deleteDataForProductManufacturer() Class RetailAutopartsCatalogProductManufacturerController
    Local oJsonRespo    as Object
    Local oJParametr    as Object
    Local oModel        as Object
    Local lGravouOK     as Logical
    Local lContinua     as Logical
    Local cCodProd      as Character
    Local cCodFab       as Character
    Local cLojaFab      as Character
    Local aArea         as Array
    Local aErros        as Array
    Local cFilMG1       as Character
    Local cFilSA2       as Character
    Local cFilSB1       as Character

    oJsonRespo  := JsonObject():New()
    oModel      := Nil
    lGravouOK   := .F.
    lContinua   := .T.
    cCodProd    := ""
    cCodFab     := ""
    cLojaFab    := ""
    aArea       := {}
    aErros      := {}
    cFilMG1     := xFilial("MG1")
    cFilSA2     := xFilial("SA2")
    cFilSB1     := xFilial("SB1")

    oJParametr  := oRest:getPathParamsRequest()

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Obtém os parâmetros informados na requisição
    If oJParametr:hasProperty('productCode')
        cCodProd := oJParametr['productCode']
    EndIf
    If oJParametr:hasProperty('manufacturerCode')
        cCodFab := oJParametr['manufacturerCode']
    EndIf
    If oJParametr:hasProperty('manufacturerStore')
        cLojaFab := oJParametr['manufacturerStore']
    EndIf

    If Empty(cCodProd) .Or. Empty(cCodFab) .Or. Empty(cLojaFab)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := STR0006 + "'productCode', 'manufacturerCode', 'manufacturerStore'" + STR0007 //"Parametros " ### " sao obrigatorios"
        lContinua := .F.
    EndIf

    If lContinua
        aArea := GetArea()
        dbSelectArea('MG1')
        MG1->(dbSetOrder(1)) //MG1_FILIAL+MG1_FILFAB+MG1_CODFAB+MG1_LOJFAB+MG1_FILPRD+MG1_CODPRD

        If !MG1->(dbSeek(cFilMG1 + cFilSA2 + PadR(cCodFab, TamSx3("MG1_CODFAB")[1]) + PadR(cLojaFab, TamSx3("MG1_LOJFAB")[1]) + cFilSB1 + PadR(cCodProd, TamSx3("MG1_CODPRD")[1])))
            oRest:setStatusCode(404)  // HTTP 404 = Not Found
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0002 + AllTrim(cCodProd) + STR0003 + AllTrim(cCodFab) + "/" + AllTrim(cLojaFab) + STR0009 //"Produto " ### " x Fabricante/Loja " ### "/" ### " nao encontrado"
            lContinua := .F.
        EndIf

        If lContinua
            // ==========================================
            // Carrega o Model MVC para Deleção
            // ==========================================
            oModel := FWLoadModel("LOJA680")
            oModel:SetOperation(MODEL_OPERATION_DELETE)
            oModel:Activate()

            If oModel:VldData()
                lGravouOK := oModel:CommitData()
            EndIf

            If lGravouOK
                oRest:setStatusCode(200)  // HTTP 200 = OK
                oJsonRespo['success'] := .T.
                oJsonRespo['message'] := STR0002 + AllTrim(cCodProd) + STR0003 + AllTrim(cCodFab) + "/" + AllTrim(cLojaFab) + STR0012 //"Produto " ### " x Fabricante/Loja " ### "/" ### " deletado com sucesso"
            EndIf

            oModel:DeActivate()
            FreeObj(oModel)
        EndIf

        RestArea(aArea)
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    // ==========================================
    // Libera Recursos da Memoria
    // ==========================================
    FreeObj(oJsonRespo)

Return .T.

/*/{Protheus.doc} FindProductManufacturer
    Consulta registros de Produto x Fabricante do catalogo de autopecas
    @type    method
    @author  Alberto Deviciente
    @since   24/05/2026
    @version p12
    @param   cCodProd  , Character , filtro pelo codigo do produto
    @param   cFilFab   , Character , filtro pela filial do fabricante
    @param   cCodFab   , Character , filtro pelo codigo do fabricante
    @param   cLojaFab  , Character , filtro pela loja do fabricante
    @return  aItens    , Array     , array de itens encontrados
/*/
Method FindProductManufacturer(cCodProd as Character, cFilFab as Character, cCodFab as Character, cLojaFab as Character) as Array Class RetailAutopartsCatalogProductManufacturerController
    Local oQueryQry     as Object
    Local jItem         as Object
    Local nSeq          as Numeric
    Local aItens        as Array
    Local aArea         as Array
    Local cQry          as Character
    Local cAliasQry     as Character

    Default cCodProd  := ""
    Default cFilFab   := ""
    Default cCodFab   := ""
    Default cLojaFab  := ""

    oQueryQry   := Nil
    jItem       := Nil
    nSeq        := 1
    aItens      := {}
    aArea       := GetArea()

    dbSelectArea("MG1")

    cQry := " SELECT MG1.MG1_FILIAL, MG1.MG1_FILFAB, MG1.MG1_CODFAB, MG1.MG1_LOJFAB, MG1.MG1_FILPRD, MG1.MG1_CODPRD, "
    cQry += "        SB1.B1_DESC, SA2.A2_NOME "
    cQry += " FROM " + RetSqlName("MG1") + " MG1 "
    cQry += " LEFT JOIN " + RetSqlName("SB1") + " SB1 ON SB1.B1_FILIAL = MG1.MG1_FILPRD AND SB1.B1_COD = MG1.MG1_CODPRD AND SB1.D_E_L_E_T_ = ' ' "
    cQry += " LEFT JOIN " + RetSqlName("SA2") + " SA2 ON SA2.A2_FILIAL = MG1.MG1_FILFAB AND SA2.A2_COD = MG1.MG1_CODFAB AND SA2.A2_LOJA = MG1.MG1_LOJFAB AND SA2.D_E_L_E_T_ = ' ' "
    cQry += " WHERE "
    cQry += " MG1.MG1_FILIAL = ? "
    If !Empty(cCodProd)
        cQry += " AND MG1.MG1_CODPRD = ? "
    EndIf
    If !Empty(cFilFab)
        cQry += " AND MG1.MG1_FILFAB = ? "
    EndIf
    If !Empty(cCodFab)
        cQry += " AND MG1.MG1_CODFAB = ? "
    EndIf
    If !Empty(cLojaFab)
        cQry += " AND MG1.MG1_LOJFAB = ? "
    EndIf
    cQry += " AND MG1.D_E_L_E_T_ = ? "
    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)

    oQueryQry:SetString(nSeq++, xFilial("MG1"))
    If !Empty(cCodProd)
        oQueryQry:SetString(nSeq++, cCodProd)
    EndIf
    If !Empty(cFilFab)
        oQueryQry:SetString(nSeq++, cFilFab)
    EndIf
    If !Empty(cCodFab)
        oQueryQry:SetString(nSeq++, cCodFab)
    EndIf
    If !Empty(cLojaFab)
        oQueryQry:SetString(nSeq++, cLojaFab)
    EndIf
    oQueryQry:SetString(nSeq++, Space(1))

    cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

    While (cAliasQry)->(!EOF())
        jItem := JsonObject():New()
        jItem["branch"]              := AllTrim((cAliasQry)->MG1_FILIAL)
        jItem["productBranch"]       := AllTrim((cAliasQry)->MG1_FILPRD)
        jItem["productCode"]         := AllTrim((cAliasQry)->MG1_CODPRD)
        jItem["productDescription"]  := AllTrim((cAliasQry)->B1_DESC)
        jItem["manufacturerBranch"]  := AllTrim((cAliasQry)->MG1_FILFAB)
        jItem["manufacturerCode"]    := AllTrim((cAliasQry)->MG1_CODFAB)
        jItem["manufacturerStore"]   := AllTrim((cAliasQry)->MG1_LOJFAB)
        jItem["manufacturerName"]    := AllTrim((cAliasQry)->A2_NOME)
        aAdd(aItens, jItem)
        (cAliasQry)->(dbSkip())
    EndDo

    (cAliasQry)->(dbCloseArea())

    RestArea(aArea)

    // ==========================================
    // Libera Recursos da Memoria
    // ==========================================
    FreeObj(oQueryQry)

Return(aItens)
