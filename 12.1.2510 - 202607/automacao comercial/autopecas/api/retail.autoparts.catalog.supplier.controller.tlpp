#include "totvs.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "retail.autoparts.catalog.supplier.controller.ch"

namespace totvs.protheus.retail.autoparts.catalog.supplier.controller

/*/{Protheus.doc} RetailAutopartsCatalogSupplierController
    API relacionadas a fornecedores do catalogo de autopecas
    @type   class
    @author Bruno Almeida
    @since  04/06/2026
/*/
Class RetailAutopartsCatalogSupplierController

    private Method FindSupplier(cBranch as Character, cCode as Character, cStore as Character, cName as Character) as Array

    public Method New()

    @Get("/api/retail/v1/retailAutopartsCatalogSupplier/getDataForSupplier", description="Consulta os fornecedores do catalogo de auto pecas.")
    public Method getDataForSupplier()

EndClass

/*/{Protheus.doc} New
    Metodo construtor
    @type   method
    @author Bruno Almeida
    @since  04/06/2026
/*/
Method New() Class RetailAutopartsCatalogSupplierController
Return Self

/*/{Protheus.doc} getDataForSupplier
    Retorna os fornecedores do catalogo de auto pecas
    @type    method
    @author  Bruno Almeida
    @since   04/06/2026
    @version p12
    @return  logical, retorno padrão .T.
/*/
Method getDataForSupplier() Class RetailAutopartsCatalogSupplierController
    Local oJsonRespo    as Object
    Local oJParametr    as Object
    Local aItens        as Array
    Local cBranch       as Character
    Local cCode         as Character
    Local cStore        as Character
    Local cName         as Character

    oJsonRespo  := JsonObject():New()
    aItens      := {}
    oJParametr  := oRest:getQueryRequest()

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    If oJParametr['branch'] == Nil .Or. Empty(oJParametr['branch'])
        cBranch := ""
    Else
        cBranch := oJParametr['branch']
    EndIf

    If oJParametr['code'] == Nil .Or. Empty(oJParametr['code'])
        cCode := ""
    Else
        cCode := oJParametr['code']
    EndIf

    If oJParametr['store'] == Nil .Or. Empty(oJParametr['store'])
        cStore := ""
    Else
        cStore := oJParametr['store']
    EndIf

    If oJParametr['name'] == Nil .Or. Empty(oJParametr['name'])
        cName := ""
    Else
        cName := oJParametr['name']
    EndIf

    aItens := Self:FindSupplier(cBranch, cCode, cStore, cName)

    If Len(aItens) > 0
        oJsonRespo["items"] := aItens
        oRest:setStatusCode(200)
    Else
        oJsonRespo["items"]    := {}
        oJsonRespo["message"] := STR0001 //"Dados não encontrados para o filtro informado"
        oRest:setStatusCode(404)
    EndIf

    oRest:setResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

Return .T.


/*/{Protheus.doc} FindSupplier
    Consulta fornecedores do catalogo de auto pecas
    @type    method
    @author  Bruno Almeida
    @since   04/06/2026
    @version p12
    @param   cBranch , Character , filtro pela filial
    @param   cCode   , Character , filtro pelo codigo do fornecedor
    @param   cStore  , Character , filtro pela loja
    @param   cName   , Character , filtro pelo nome do fornecedor
    @return  array   , Array     , array de itens encontrados
/*/
Method FindSupplier(cBranch as Character, cCode as Character, cStore as Character, cName as Character) as Array Class RetailAutopartsCatalogSupplierController
    Local oQueryQry     as Object
    Local jItem         as Object
    Local aItens        as Array
    Local cQry          as Character
    Local cAliasQry     as Character
    Local nSeq          as Numeric
    Local aArea         as Array

    Default cBranch := ""
    Default cCode   := ""
    Default cStore  := ""
    Default cName   := ""

    nSeq        := 1
    aItens      := {}
    aArea       := GetArea()

    cQry := " SELECT A2_FILIAL, A2_COD, A2_LOJA, A2_NOME, A2_NREDUZ "
    cQry += " FROM " + RetSqlName("SA2")
    cQry += " WHERE "

    If !Empty(cCode) .and. !Empty(cStore)
        cQry += " A2_FILIAL = ? AND A2_COD = ? AND A2_LOJA = ? AND "
    ElseIf !Empty(cName)
        cQry += " A2_FILIAL = ? AND (A2_NOME LIKE ? OR A2_NREDUZ LIKE ?) AND "
    Else
        cQry += " A2_FILIAL = ? AND "
    EndIf

    cQry += " D_E_L_E_T_ = ? "
    cQry += " ORDER BY A2_NOME ASC"
    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)

    If !Empty(cCode) .and. !Empty(cStore)
        oQueryQry:SetString(nSeq++, cBranch)
        oQueryQry:SetString(nSeq++, cCode)
        oQueryQry:SetString(nSeq++, cStore)
    ElseIf !Empty(cName)
        
        //-- Ajuste para evitar problemas com acentos na consulta
        cName := DecodeUTF8(cName, "cp1252")

        oQueryQry:SetString(nSeq++, xFilial("SA2"))
        oQueryQry:SetString(nSeq++, "%" + Upper(cName) + "%")
        oQueryQry:SetString(nSeq++, "%" + Upper(cName) + "%")
    Else
        oQueryQry:SetString(nSeq++, xFilial("SA2"))
    EndIf

    oQueryQry:SetString(nSeq++, Space(1))

    cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

    While (cAliasQry)->(!EOF())
        jItem := JsonObject():New()
        jItem["branch"]   := AllTrim((cAliasQry)->A2_FILIAL)
        jItem["code"]     := AllTrim((cAliasQry)->A2_COD)
        jItem["store"]    := AllTrim((cAliasQry)->A2_LOJA)
        jItem["name"]     := AllTrim((cAliasQry)->A2_NOME)
        jItem["shortname"]:= AllTrim((cAliasQry)->A2_NREDUZ)
        aAdd(aItens, jItem)
        jItem := Nil
        (cAliasQry)->(dbSkip())
    EndDo

    (cAliasQry)->(dbCloseArea())

    RestArea(aArea)

    oQueryQry:Destroy()
    oQueryQry := Nil

Return(aItens)
