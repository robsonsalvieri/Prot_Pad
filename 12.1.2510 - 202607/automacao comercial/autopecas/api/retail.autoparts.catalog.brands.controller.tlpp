#include 'PROTHEUS.CH'
#include 'tlpp-core.th'
#include 'tlpp-rest.th'
#include 'FWMVCDEF.CH'
#include 'retail.autoparts.catalog.brands.controller.ch'

namespace totvs.protheus.retail.autoparts.catalog.brands.controller
using namespace totvs.protheus.retail.autoparts.catalog.brands.service

/*/{Protheus.doc} RetailAutopartsCatalogBrandsController
API relacionadas a marcas do catalogo de autopecas
@author Bruno Almeida
@since  13/04/2026   
/*/
Class RetailAutopartsCatalogBrandsController
    
    private Method FindBrands(cName as Character) as Array

    public Method New()

    @Get("/api/retail/v1/retailAutopartsCatalogBrands/getDataForBrands", description="Consulta as marcas do catalogo de auto peças.")
    public Method getDataForBrands()

    @Post("/api/retail/v1/retailAutopartsCatalogBrands/postDataForBrands", description="Cadastra uma nova marca para o catalogo de autopecas")
    public Method postDataForBrands()

    @Put("/api/retail/v1/retailAutopartsCatalogBrands/putDataForBrands", description="Altera uma marca existente no catalogo de autopecas")
    public Method putDataForBrands()

    @Delete("/api/retail/v1/retailAutopartsCatalogBrands/deleteDataForBrands/:codigo", description="Deleta uma marca do catalogo de autopecas")
    public Method deleteDataForBrands()
    
EndClass


/*/{Protheus.doc} New
Metodo construtor
@author Bruno Almeida
@since  13/04/2026
/*/
Method New() Class RetailAutopartsCatalogBrandsController
Return Self

/*/{Protheus.doc} getDataForBrands
    Retorna as marcas do catalogo de auto peças
    @author  Bruno Almeida
    @since   13/04/2026
    @version p12
/*/
Method getDataForBrands() Class RetailAutopartsCatalogBrandsController
    Local oJsonRespo    as Object
    Local oJParametr    as Object
    Local aItens        as Array                  
    Local cName   := ""

    oJsonRespo      := JsonObject():New()    
    oJParametr      := JsonObject():New()  
    aItens          := {}                 
    cName           := ""
    oJParametr      := oRest:getQueryRequest()
    
    //Obtém os filtros enviados na URL (se existirem)
    cName   := iif(oJParametr['nome'] == Nil .Or. Empty(oJParametr['nome']), "", oJParametr['nome'])
    aItens  := Self:FindBrands(cName)
    
    If Len(aItens) > 0
        oJsonRespo["Itens"] := aItens
        oRest:setStatusCode(200)
        oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")
        oRest:setKeyHeaderResponse("Accept-Encoding", "UTF-8")
    Else
        oJsonRespo["Itens"]    := {}
        oJsonRespo["mensagem"] := STR0005 //"Dados não encontrados para o filtro informado"
        oRest:setStatusCode(404)
    EndIf

    oRest:setResponse(EncodeUTF8(oJsonRespo:toJson()))

    freeObj(oJsonRespo)
    freeObj(oJParametr)

Return .T.

/*/{Protheus.doc} postDataForBrands
    Cadastro de marca do catalogo de auto peças
    @author  Bruno Almeida
    @since   13/04/2026
    @version p12
/*/
Method postDataForBrands()  Class RetailAutopartsCatalogBrandsController
    Local oJsBody       AS Object
    Local oJsonRespo    AS Object
    Local oModel        AS Object
    Local oModelMG0     AS Object    
    Local cName         AS Character
    Local lGravouOK     AS Logical
    Local aErros        AS Array
    
    oJsonRespo      := JsonObject():New()   
    oModel          := Nil                  
    oModelMG0       := Nil                  
    lGravouOK       := .F.
    aErros          := {}
    oJsBody         := JsonObject():New() 

    oJsBody:fromJson( oRest:GetBodyRequest())

    cName := iif(oJsBody['nome'] == Nil .Or. Empty(oJsBody['nome']), "", oJsBody['nome'])    
      
    //Carrega o Model MVC
    oModel := FWLoadModel("LOJA640")
    oModel:SetOperation(MODEL_OPERATION_INSERT)
    oModel:Activate()
    
    oModelMG0 := oModel:GetModel("MG0MASTER")

    oModelMG0:SetValue("MG0_NOME", upper(cName))
    
    If oModel:VldData()
        lGravouOK := oModel:CommitData()        
    Else
        //Validação falhou
        lGravouOK := .F.
    EndIf
   
    If lGravouOK

        oRest:setStatusCode(201)
        oJsonRespo['sucesso']   := .T.
        oJsonRespo['mensagem']  := STR0006 + MG0->MG0_CODMAR + STR0007 //"Marca " # " cadastrada com sucesso"
        oJsonRespo['filial']    := allTrim(MG0->MG0_FILIAL)
        oJsonRespo['codigo']    := MG0->MG0_CODMAR
        oJsonRespo['nome']      := allTrim(MG0->MG0_NOME)
        
    Else
        oRest:setStatusCode(400)
        aErros := oModel:GetErrorMessage()
        
        oJsonRespo['sucesso']  := .F.
        oJsonRespo['mensagem'] := IIf(Len(aErros) >= 6, aErros[6], STR0008) //"Erro ao cadastrar"
                
    EndIf
    
    oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")
    oRest:SetResponse(EncodeUTF8(oJsonRespo:toJson()))
    
    oModelMG0:DeActivate()
    oModel:DeActivate()
    
    FreeObj(oModelMG0)
    FreeObj(oModel)
    FreeObj(oJsonRespo)
    FreeObj(oJsBody)

Return .T.


/*/{Protheus.doc} putDataForBrands
    Altera a marca do catlogo de auto peças
    @author  Bruno Almeida
    @since   13/04/2026
    @version p12
/*/
method putDataForBrands()  Class RetailAutopartsCatalogBrandsController
    Local oJsonRespo    AS Object
    Local oJsBody       AS Object
    Local lFound        AS Logical    
    Local cCode         AS Character
    Local cName         AS Character
    Local aArea         AS Array            
    Local oModel        AS Object
    Local oModelMG0     AS Object
    Local lGravouOK     AS Logical
    Local aErros        AS Array
    Local lContinua     AS Logical

    oJsonRespo  := JsonObject():New() 
    cCode       := ""
    cName       := ""
    lFound      := .F.
    aArea       := {}
    oJsBody     := JsonObject():New()     
    oModel      := Nil
    oModelMG0   := Nil
    lGravouOK   := .F.
    aErros      := {}
    lContinua   := .T.

    oJsBody:fromJson( oRest:GetBodyRequest())

    cCode := iif(oJsBody['codigo'] == Nil .Or. Empty(oJsBody['codigo']), "", oJsBody['codigo'])
    cName := iif(oJsBody['nome'] == Nil .Or. Empty(oJsBody['nome']), "", oJsBody['nome'])

    If Empty(cCode)
        oRest:setStatusCode(422)
        oJsonRespo['sucesso']  := .F.
        oJsonRespo['mensagem'] := STR0009 //"Parâmetro 'codigo' é obrigatório"
        lContinua := .F.
    EndIf

    If lContinua
        aArea := GetArea()
        dbSelectArea('MG0')
        dbSetOrder(1)  //MG0_FILIAL+MG0_CODMAR                                                                                                                                           
        
        lFound := MG0->(dbSeek(xFilial("MG0") + padR(cCode, tamSx3("MG0_CODMAR")[1])))
        
        // Se não encontrou retorna erro 404
        If !lFound
            oRest:setStatusCode(404)
            oJsonRespo['sucesso']  := .F.
            oJsonRespo['mensagem'] := STR0010 + AllTrim(cCode) + STR0011 //"Registro " # " não encontrado"
            lContinua := .F.
            RestArea(aArea)
        EndIf
        
        If lContinua
            oModel := FWLoadModel("LOJA640")
            oModel:SetOperation(MODEL_OPERATION_UPDATE)
            oModel:Activate()
            
            oModelMG0 := oModel:GetModel("MG0MASTER")
            oModelMG0:SetValue("MG0_NOME", upper(cName))
            
            If oModel:VldData()
                lGravouOK := oModel:CommitData()               
            Else
                lGravouOK := .F.
            EndIf
            
            If lGravouOK
                oRest:setStatusCode(200)
                oJsonRespo['sucesso']  := .T.
                oJsonRespo['mensagem'] := STR0006 + AllTrim(cCode) + STR0012 //"Marca " # " atualizada com sucesso"
                oJsonRespo['filial']   := allTrim(MG0->MG0_FILIAL)
                oJsonRespo['codigo']   := MG0->MG0_CODMAR
                oJsonRespo['nome']     := allTrim(MG0->MG0_NOME)
                
            Else
                oRest:setStatusCode(400)
                aErros := oModel:GetErrorMessage()
                
                oJsonRespo['sucesso']  := .F.
                oJsonRespo['mensagem'] := iif(Len(aErros) >= 6, aErros[6], STR0013) //"Erro ao atualizar"
                oJsonRespo['solucao']  := iif(Len(aErros) >= 7 .And. !Empty(aErros[7]), aErros[7], "")
                oJsonRespo['campo']    := iif(Len(aErros) >= 4 .And. !Empty(aErros[4]), aErros[4], "")       
            EndIf

            oModelMG0:DeActivate()
            oModel:DeActivate()
            
            FreeObj(oModelMG0)  
            FreeObj(oModel)

        EndIf

    EndIf
    
    oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")
    oRest:SetResponse(EncodeUTF8(oJsonRespo:toJson()))

    FreeObj(oJsonRespo)
    FreeObj(oJsBody)
        
    RestArea(aArea)
    
Return .T.

/*/{Protheus.doc} deleteDataForBrands
    Deleta a marca do catlogo de auto peças
    @author  Bruno Almeida
    @since   13/04/2026
    @version p12
/*/
Method deleteDataForBrands()  Class retailAutopartsCatalogBrandsController
    Local oJsonRespo    AS Object
    Local oJParametr    AS Object
    Local lFound        AS Logical    
    Local cCode         AS Character
    Local aArea         AS Array
    Local oModel        AS Object
    Local lGravouOK     AS Logical
    Local aErros        AS Array
    Local lContinua     AS Logical

    oJsonRespo  := JsonObject():New() 
    oJParametr  := JsonObject():New()  
    cCode       := ""
    lFound      := .F.
    aArea       := {}   
    oJParametr  := oRest:getPathParamsRequest()
    oModel      := Nil
    lGravouOK   := .F.
    aErros      := {}
    cCode       := iif (oJParametr['codigo'] == Nil .Or. Empty(oJParametr['codigo']), "", oJParametr['codigo'])
    lContinua   := .T.

    aArea    := GetArea()
    dbSelectArea('MG0')
    dbSetOrder(1)  //MG0_FILIAL+MG0_CODMOD                                                                                                                                           
    
    lFound := MG0->(dbSeek(xFilial("MG0") + padR(cCode, tamSx3("MG0_CODMAR")[1])))

    // Se não encontrou retorna erro 404
    If !lFound
        oRest:setStatusCode(404)
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := STR0010 + AllTrim(cCode) + STR0011 //"Registro " # " não encontrado "
        lContinua := .F.
        RestArea(aArea)
    EndIf

    If lContinua 
        oModel := FWLoadModel("LOJA640")
        oModel:SetOperation(MODEL_OPERATION_DELETE)
        oModel:Activate()

        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        EndIf		

        If lGravouOK
            oRest:setStatusCode(200)
            oJsonRespo['sucesso'] := .T.
            oJsonRespo['mensagem'] := STR0006 + AllTrim(cCode) + STR0014 //"Marca " # " deletada com sucesso"       
        EndIf
        
        oModel:DeActivate()
        FreeObj(oModel)
    EndIf
    
    oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")
    oRest:SetResponse(EncodeUTF8(oJsonRespo:toJson()))

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)
       
    RestArea(aArea)

Return .T.

/*/{Protheus.doc} FindBrands
    Consulta marca do catlogo de auto peças
    @author  Bruno Almeida
    @since   13/04/2026
    @version p12
    @param   cName   , Character , nome do filtro
    @return  aItens  , Array     , array de itens encontrados
    /*/
Method FindBrands(cName as Character) as Array Class RetailAutopartsCatalogBrandsController
    Local oQueryQry		as Object
    Local jItem         as Object
    Local aItens        as Array
	Local cQry			as Character
	Local nSeq			as Numeric
    Local aArea         as Array
    Local cAliasQry     as Character

    Default cName := ""

	nSeq    := 1    
    aItens  := {}
    aArea   := GetArea()
    
    dbSelectArea("MG0")

	cQry := " SELECT MG0_FILIAL, MG0_CODMAR, MG0_NOME "
	cQry += " FROM "+ RetSqlName("MG0") +" MG0 "
	cQry += " WHERE "
    cQry += " MG0.MG0_FILIAL = ? "

    If !Empty(cName)
        cQry += " AND MG0.MG0_NOME = ? "
    EndIf
    
    cQry += " AND MG0.D_E_L_E_T_ = ? " 
	cQry := ChangeQuery(cQry)

	oQueryQry := FwExecStatement():New(cQry)

	oQueryQry:SetString(nSeq++, xFilial("MG0")) 

    If !Empty(cName)
        oQueryQry:SetString(nSeq++, upper(cName))
    EndIf

    oQueryQry:SetString(nSeq++, Space(1))

	cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

	While (cAliasQry)->( !EOF() )
        jItem := JsonObject():New()
        jItem["filial"]  := allTrim((cAliasQry)->MG0_FILIAL)
        jItem["code"]    := (cAliasQry)->MG0_CODMAR
        jItem["name"]    := allTrim((cAliasQry)->MG0_NOME)          

        aAdd(aItens, jItem)
        (cAliasQry)->(dbSkip())
	EndDo

	(cAliasQry)->(dbCloseArea())

    oQueryQry:Destroy()
    oQueryQry := Nil
    
    FreeObj(jItem)
    FreeObj(oQueryQry)

    RestArea(aArea)

Return(aItens)
