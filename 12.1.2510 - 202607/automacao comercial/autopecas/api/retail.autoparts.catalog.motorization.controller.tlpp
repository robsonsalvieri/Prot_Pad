#include "totvs.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "fwmvcdef.ch"
#include "retail.autoparts.catalog.motorization.controller.ch"

//               Nome do parametro no JSON     , Campo no SX3   , Tipo
Static aFields :=   { ;
                    {"motorizationCode"        , "MEA_CODMOT"   , "C"    },;
                    {"name"                    , "MEA_NOME"     , "C"    },;
                    {"description"             , "MEA_DESCR"    , "C"    },;
                    {"manufacturerBranch"      , "MEA_FILFAB"   , "C"    },;
                    {"manufacturerCode"        , "MEA_CODFAB"   , "C"    },;
                    {"manufacturerStore"       , "MEA_LOJFAB"   , "C"    },;
                    {"fuelType"                , "MEA_COMBUS"   , "C"    },;
                    {"cylinderType"            , "MEA_CILIND"   , "C"    },;
                    {"numberOfCylinders"       , "MEA_NUMCIL"   , "C"    },;
                    {"valvesPerCylinder"       , "MEA_VALCIL"   , "C"    },;
                    {"totalValves"             , "MEA_TOTVAL"   , "N"    },;
                    {"valveCommand"            , "MEA_COMVAL"   , "C"    },;
                    {"displacementLiters"      , "MEA_CILLIT"   , "C"    },;
                    {"displacementCm3"         , "MEA_CILCM3"   , "N"    },;
                    {"power"                   , "MEA_POTENC"   , "N"    },;
                    {"aspirationType"          , "MEA_TPASPI"   , "C"    };
                    } as Array

namespace totvs.protheus.retail.autoparts.catalog.motorization.controller

/*/{Protheus.doc} RetailAutopartsCatalogMotorizationController
    API relacionada a Motorizacao do catalogo de autopecas
    @author eduardo.FLima
    @since  25/05/2026
/*/
Class RetailAutopartsCatalogMotorizationController

    public Method New()

    private Method FindMotorization(cCode as Character, cName as Character) as Array
    private Method GetSX5Desc(cTabela as Character, cChave as Character) as Character

    @Get("/api/retail/v1/retailAutopartsCatalogMotorization/getDataForMotorization", description="Consulta as motorizacoes do catalogo de autopecas, podendo filtrar por codigo (exato) ou nome (aproximado)")
    public Method getDataForMotorization()

    @Post("/api/retail/v1/retailAutopartsCatalogMotorization/postDataForMotorization", description="Cadastra uma nova motorizacao para o catalogo de autopecas")
    public Method postDataForMotorization()

    @Put("/api/retail/v1/retailAutopartsCatalogMotorization/putDataForMotorization", description="Altera uma motorizacao existente no catalogo de autopecas")
    public Method putDataForMotorization()

    @Delete("/api/retail/v1/retailAutopartsCatalogMotorization/deleteDataForMotorization/:code", description="Deleta uma motorizacao do catalogo de autopecas")
    public Method deleteDataForMotorization()

EndClass

/*/{Protheus.doc} New
    Metodo construtor
    @type   method
    @author eduardo.FLima
    @since  25/05/2026
/*/
Method New() Class RetailAutopartsCatalogMotorizationController
Return Self

/*/{Protheus.doc} getDataForMotorization
    Retorna as motorizacoes do catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   25/05/2026
    @version p12
/*/
Method getDataForMotorization() Class RetailAutopartsCatalogMotorizationController
    Local oJsonRespo    := JsonObject():New() as Object
    Local oJParametr    := oRest:getQueryRequest() as Object
    Local aItens        := {} as Array
    Local cCode         := "" as Character
    Local cName         := "" as Character

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Obtem os parametros informados na requisicao via URL (query param)
    If oJParametr:hasProperty('code')
        cCode := oJParametr['code']
    EndIf
    If oJParametr:hasProperty('name')
        cName := oJParametr['name']
    EndIf

    aItens := Self:FindMotorization(cCode, cName)

    If Len(aItens) > 0
        oJsonRespo["items"] := aItens
        oRest:setStatusCode(200)  // HTTP 200 = Sucesso
    Else
        oJsonRespo["items"]   := {}
        oJsonRespo["message"] := STR0001 //"Dados nao encontrados para o filtro informado"
        oRest:setStatusCode(404)  // HTTP 404 = Not Found
    EndIf

    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

Return .T.

/*/{Protheus.doc} postDataForMotorization
    Cadastro de Motorizacao para o catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   25/05/2026
    @version p12
/*/
Method postDataForMotorization() Class RetailAutopartsCatalogMotorizationController
    Local oJsBody       := JsonObject():New() as Object
    Local oJsonRespo    := JsonObject():New() as Object
    Local oModel        := Nil as Object
    Local oModelMEA     := Nil as Object
    Local lGravouOK     := .F. as Logical
    Local aErros        := {} as Array
    Local lDadosOK      := .T. as Logical
    Local cParamName    := "" as Character
    Local cFieldName    := "" as Character
    Local lAnyParInf    := .F. as Logical
    Local nX            := 0 as Numeric

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    oJsBody:fromJson(oRest:GetBodyRequest())

    // ==========================================
    // Carrega o Model MVC
    // ==========================================
    oModel := FWLoadModel("LOJA670")
    oModel:SetOperation(MODEL_OPERATION_INSERT)
    oModel:Activate()

    // ------------------------------------------
    // Obtem o SubModel da Tabela MEA (Motorizacao)
    // ------------------------------------------
    oModelMEA := oModel:GetModel("MEAMASTER")

    // ==========================================
    // Preenche os Campos do Model
    // ==========================================
    For nX := 1 To Len(aFields)
        cParamName := aFields[nX][1]  // Nome do parametro no JSON
        cFieldName := aFields[nX][2]  // Nome do campo no Model

        If oJsBody[cParamName] != Nil
            oModelMEA:SetValue(cFieldName, oJsBody[cParamName])
            lAnyParInf := .T.
        EndIf
    Next nX

    If !lAnyParInf
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['message'] := STR0002 //"Nenhum parametro de motorizacao informado para cadastro"
        lDadosOK := .F.
    EndIf

    If lDadosOK
        // ==========================================
        // Valida e Grava os Dados
        // ==========================================
        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        Else
            lGravouOK := .F.
        EndIf

        If lGravouOK
            oRest:setStatusCode(201)  // HTTP 201 = Created
            oJsonRespo['success'] := .T.
            oJsonRespo['message'] := STR0003 + MEA->MEA_CODMOT + STR0004 //"Motorizacao " ### " cadastrada com sucesso"
            For nX := 1 To Len(aFields)
                cParamName := aFields[nX][1]
                cFieldName := aFields[nX][2]
                If aFields[nX][3] == "C"
                    oJsonRespo[cParamName] := AllTrim(MEA->(FieldGet(FieldPos(cFieldName))))
                Else
                    oJsonRespo[cParamName] := MEA->(FieldGet(FieldPos(cFieldName)))
                EndIf
            Next nX
        Else
            oRest:setStatusCode(400)  // HTTP 400 = Bad Request
            aErros := oModel:GetErrorMessage()

            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := IIf(!Empty(aErros[6]), aErros[6], STR0006) //"Erro ao cadastrar"
            oJsonRespo['field']   := IIf(!Empty(aErros[4]), aErros[4], "")
            oJsonRespo['errorId'] := IIf(!Empty(aErros[5]), aErros[5], "")
            oJsonRespo['solution']:= IIf(!Empty(aErros[7]), aErros[7], "")
        EndIf
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    // ==========================================
    // Libera Recursos da Memoria
    // ==========================================
    oModelMEA:DeActivate()
    oModel:DeActivate()
    FreeObj(oModelMEA)
    FreeObj(oModel)
    FreeObj(oJsBody)
    FreeObj(oJsonRespo)

Return .T.

/*/{Protheus.doc} putDataForMotorization
    Altera cadastro de Motorizacao do catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   25/05/2026
    @version p12
/*/
Method putDataForMotorization() Class RetailAutopartsCatalogMotorizationController
    Local oJsonRespo    := JsonObject():New() as Object
    Local oJsBody       := JsonObject():New() as Object
    Local oJParametr    := oRest:getQueryRequest() as Object
    Local lFound        := .F. as Logical
    Local cBranch       := "" as Character
    Local cCode         := "" as Character
    Local aArea         := GetArea() as Array
    Local oModel        := Nil as Object
    Local oModelMEA     := Nil as Object
    Local lGravouOK     := .F. as Logical
    Local aErros        := {} as Array
    Local nX            := 0 as Numeric
    Local cParamName    := "" as Character
    Local cFieldName    := "" as Character
    Local lAnyParInf    := .F. as Logical
    Local lDadosOK      := .T. as Logical

    DbSelectArea("MEA")

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    oJsBody:fromJson(oRest:GetBodyRequest())

    cBranch := xFilial("MEA")

    // Obtem os parametros informados na requisicao via URL (query param)
    If oJParametr:hasProperty('code')
        cCode := oJParametr['code']
    EndIf

    // ==========================================
    // Validacao codigo Obrigatorio
    // ==========================================
    If Empty(cCode)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['message'] := STR0007 //"Parametro 'code' (codigo) e obrigatorio"
        lDadosOK := .F.
    EndIf

    If lDadosOK
        dbSelectArea('MEA')
        MEA->(dbSetOrder(1)) //MEA_FILIAL+MEA_CODMOT

        lFound := MEA->(dbSeek(cBranch + PadR(cCode, TamSx3("MEA_CODMOT")[1])))

        // ------------------------------------------
        // Se nao encontrou retorna erro 404
        // ------------------------------------------
        If !lFound
            oRest:setStatusCode(404)  // HTTP 404 = Not Found
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0008 + AllTrim(cCode) + STR0009 //"Registro " ### " nao encontrado"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        // ==========================================
        // Carrega o Model MVC para Alteracao
        // ==========================================
        oModel := FWLoadModel("LOJA670")
        oModel:SetOperation(MODEL_OPERATION_UPDATE)
        oModel:Activate()

        // ------------------------------------------
        // Obtem o SubModel da Tabela MEA
        // ------------------------------------------
        oModelMEA := oModel:GetModel("MEAMASTER")

        // ==========================================
        // Preenche os Campos do Model
        // ==========================================
        For nX := 1 To Len(aFields)
            cParamName := aFields[nX][1]
            cFieldName := aFields[nX][2]

            If oJsBody[cParamName] != Nil
                oModelMEA:SetValue(cFieldName, oJsBody[cParamName])
                lAnyParInf := .T.
            EndIf
        Next nX

        If !lAnyParInf
            oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
            oJsonRespo['message'] := STR0010 //"Nenhum parametro de motorizacao informado para alteracao"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        // ==========================================
        // Valida e Grava as Alteracoes
        // ==========================================
        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        Else
            lGravouOK := .F.
        EndIf

        If lGravouOK
            oRest:setStatusCode(200)  // HTTP 200 = OK
            oJsonRespo['success'] := .T.
            oJsonRespo['message'] := STR0003 + AllTrim(cCode) + STR0005 //"Motorizacao " ### " atualizada com sucesso"
            oJsonRespo['code'] := cCode
            For nX := 1 To Len(aFields)
                cParamName := aFields[nX][1]
                cFieldName := aFields[nX][2]
                If aFields[nX][3] == "C"
                    oJsonRespo[cParamName] := AllTrim(MEA->(FieldGet(FieldPos(cFieldName))))
                Else
                    oJsonRespo[cParamName] := MEA->(FieldGet(FieldPos(cFieldName)))
                EndIf
            Next nX
        Else
            oRest:setStatusCode(400)  // HTTP 400 = Bad Request
            aErros := oModel:GetErrorMessage()

            oJsonRespo['success']  := .F.
            oJsonRespo['field']    := IIf(!Empty(aErros[4]), aErros[4], "")
            oJsonRespo['message']  := IIf(!Empty(aErros[6]), aErros[6], STR0011) //"Erro ao atualizar"
            oJsonRespo['solution'] := IIf(!Empty(aErros[7]), aErros[7], "")
        EndIf
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    // ==========================================
    // Libera Recursos da Memoria
    // ==========================================
    If ValType(oModel) <> "U"
        oModelMEA:DeActivate()
        oModel:DeActivate()

        FreeObj(oModelMEA)
        FreeObj(oModel)
    EndIf

    FreeObj(oJsBody)
    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

    RestArea(aArea)

Return .T.

/*/{Protheus.doc} deleteDataForMotorization
    Deleta motorizacao do catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   25/05/2026
    @version p12
/*/
Method deleteDataForMotorization() Class RetailAutopartsCatalogMotorizationController
    Local oJsonRespo    := JsonObject():New() as Object
    Local oJParametr    := oRest:getPathParamsRequest() as Object
    Local lFound        := .F. as Logical
    Local cBranch       := "" as Character
    Local cCode         := "" as Character
    Local aArea         := GetArea() as Array
    Local oModel        := Nil as Object
    Local lGravouOK     := .F. as Logical
    Local lDadosOK      := .T. as Logical
    Local aErros        := {} as Array

    DbSelectArea("MEA")

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    cBranch := xFilial("MEA")

    // Obtem os parametros informados na requisicao via URL (path param)
    If oJParametr:hasProperty('code')
        cCode := oJParametr['code']
    EndIf

    If Empty(cCode)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['message'] := STR0007 //"Parametro 'code' (codigo) e obrigatorio"
        lDadosOK := .F.
    EndIf

    If lDadosOK
        dbSelectArea('MEA')
        MEA->(dbSetOrder(1)) //MEA_FILIAL+MEA_CODMOT

        lFound := MEA->(dbSeek(cBranch + PadR(cCode, TamSx3("MEA_CODMOT")[1])))

        // ------------------------------------------
        // Se nao encontrou retorna erro 404
        // ------------------------------------------
        If !lFound
            oRest:setStatusCode(404)  // HTTP 404 = Not Found
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0008 + AllTrim(cCode) + STR0009 //"Registro " ### " nao encontrado"
            lDadosOK := .F.
        EndIf
    EndIf


    If lDadosOK
        // ==========================================
        // Carrega o Model MVC para Delete
        // ==========================================
        oModel := FWLoadModel("LOJA670")
        oModel:SetOperation(MODEL_OPERATION_DELETE)
        oModel:Activate()

        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        EndIf
       // Resposta default: erro (padrao defensivo)
        oRest:setStatusCode(400)  // HTTP 400 = Bad Request
        oJsonRespo['success'] := .F.
        aErros := oModel:GetErrorMessage()
        oJsonRespo['message']  := IIf(!Empty(aErros[6]), aErros[6], STR0014) //"Erro ao deletar"
        oJsonRespo['field']    := IIf(!Empty(aErros[4]), aErros[4], "")
        oJsonRespo['solution'] := IIf(!Empty(aErros[7]), aErros[7], "")

        If lGravouOK
            oRest:setStatusCode(200)  // HTTP 200 = OK
            oJsonRespo['success'] := .T.
            oJsonRespo['message'] := STR0003 + AllTrim(cCode) + STR0013 //"Motorizacao " ### " deletada com sucesso"
            // Remove campos de erro caso tenha sucesso na delecao
            oJsonRespo:delName("field")
            oJsonRespo:delName("solution")
        EndIf

        // ==========================================
        // Libera Recursos da Memoria
        // ==========================================
        oModel:DeActivate()
        FreeObj(oModel)
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

    RestArea(aArea)

Return .T.

/*/{Protheus.doc} FindMotorization
    Consulta motorizacoes do catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   25/05/2026
    @version p12
    @param   cCode   , Character , filtro pelo codigo da motorizacao (busca exata)
    @param   cName   , Character , filtro pelo nome da motorizacao (busca aproximada LIKE)
    @return  aItens  , Array     , array de itens encontrados
/*/
Method FindMotorization(cCode as Character, cName as Character) as Array Class RetailAutopartsCatalogMotorizationController
    Local oQueryQry     := Nil as Object
    Local jItem         := Nil as Object
    Local aItens        := {} as Array
    Local cQry          := "" as Character
    Local cAliasQry     := "" as Character
    Local nSeq          := 1 as Numeric
    Local aArea         := GetArea() as Array

    Default cCode := ""
    Default cName := ""

    dbSelectArea("MEA")

    cQry := " SELECT MEA.MEA_FILIAL, MEA.MEA_CODMOT, MEA.MEA_NOME, MEA.MEA_DESCR, "
    cQry += " MEA.MEA_FILFAB, MEA.MEA_CODFAB, MEA.MEA_LOJFAB, "
    cQry += " SA2.A2_NOME AS NOMFAB, "
    cQry += " MEA.MEA_COMBUS, MEA.MEA_CILIND, MEA.MEA_NUMCIL, "
    cQry += " MEA.MEA_VALCIL, MEA.MEA_TOTVAL, "
    cQry += " MEA.MEA_COMVAL, MEA.MEA_CILLIT, "
    cQry += " MEA.MEA_CILCM3, MEA.MEA_POTENC, "
    cQry += " MEA.MEA_TPASPI "
    cQry += " FROM " + RetSqlName("MEA") + " MEA "
    cQry += " LEFT JOIN " + RetSqlName("SA2") + " SA2 ON SA2.A2_FILIAL = MEA.MEA_FILFAB AND SA2.A2_COD = MEA.MEA_CODFAB AND SA2.A2_LOJA = MEA.MEA_LOJFAB AND SA2.D_E_L_E_T_ = ? "
    cQry += " WHERE "
    cQry += " MEA.MEA_FILIAL = ? "

    If !Empty(cCode)
        cQry += " AND MEA.MEA_CODMOT = ? "
    EndIf

    If !Empty(cName)
        cQry += " AND UPPER(MEA.MEA_NOME) LIKE ? "
    EndIf

    cQry += " AND MEA.D_E_L_E_T_ = ? "
    cQry += " ORDER BY MEA.MEA_CODMOT "

    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)

    // Parametro do LEFT JOIN (D_E_L_E_T_)
    oQueryQry:SetString(nSeq++, Space(1))  // SA2.D_E_L_E_T_

    // Parametro do WHERE principal
    oQueryQry:SetString(nSeq++, xFilial("MEA"))

    If !Empty(cCode)
        oQueryQry:SetString(nSeq++, PadR(cCode, TamSx3("MEA_CODMOT")[1]))
    EndIf

    If !Empty(cName)
        oQueryQry:SetString(nSeq++, "%" + Upper(cName) + "%")
    EndIf

    oQueryQry:SetString(nSeq++, Space(1))  // MEA.D_E_L_E_T_

    cAliasQry := oQueryQry:OpenAlias(GetNextAlias())


    While (cAliasQry)->(!EOF())
        jItem := JsonObject():New()
        jItem["branch"]                 := AllTrim((cAliasQry)->MEA_FILIAL)
        jItem["code"]                   := AllTrim((cAliasQry)->MEA_CODMOT)
        jItem["name"]                   := AllTrim((cAliasQry)->MEA_NOME)
        jItem["description"]            := AllTrim((cAliasQry)->MEA_DESCR)
        jItem["manufacturerBranch"]     := AllTrim((cAliasQry)->MEA_FILFAB)
        jItem["manufacturerCode"]       := AllTrim((cAliasQry)->MEA_CODFAB)
        jItem["manufacturerStore"]      := AllTrim((cAliasQry)->MEA_LOJFAB)
        jItem["manufacturerName"]       := AllTrim((cAliasQry)->NOMFAB)
        jItem["fuelType"]               := AllTrim((cAliasQry)->MEA_COMBUS)
        jItem["fuelDescription"]        := Self:GetSX5Desc('WP', (cAliasQry)->MEA_COMBUS)
        jItem["cylinderType"]           := AllTrim((cAliasQry)->MEA_CILIND)
        jItem["cylinderDescription"]    := Self:GetSX5Desc('WD', (cAliasQry)->MEA_CILIND)
        jItem["numberOfCylinders"]      := AllTrim((cAliasQry)->MEA_NUMCIL)
        jItem["cylindersDescription"]   := Self:GetSX5Desc('WM', (cAliasQry)->MEA_NUMCIL)
        jItem["valvesPerCylinder"]      := AllTrim((cAliasQry)->MEA_VALCIL)
        jItem["totalValves"]            := (cAliasQry)->MEA_TOTVAL
        jItem["valveCommand"]           := AllTrim((cAliasQry)->MEA_COMVAL)
        jItem["valveCommandDesc"]       := Self:GetSX5Desc('WO', (cAliasQry)->MEA_COMVAL)
        jItem["displacementLiters"]     := AllTrim((cAliasQry)->MEA_CILLIT)
        jItem["displacementLitersDesc"] := Self:GetSX5Desc('WN', (cAliasQry)->MEA_CILLIT)
        jItem["displacementCm3"]        := (cAliasQry)->MEA_CILCM3
        jItem["power"]                  := (cAliasQry)->MEA_POTENC
        jItem["aspirationType"]         := AllTrim((cAliasQry)->MEA_TPASPI)
        jItem["aspirationDescription"]  := Self:GetSX5Desc('WE', (cAliasQry)->MEA_TPASPI)

        aAdd(aItens, jItem)
        jItem := Nil
        (cAliasQry)->(dbSkip())
    EndDo

    (cAliasQry)->(dbCloseArea())
    oQueryQry:Destroy()
    oQueryQry := Nil

    RestArea(aArea)

Return(aItens)

/*/{Protheus.doc} GetSX5Desc
    Retorna a descricao da tabela SX5 conforme idioma corrente
    @type    method
    @author  eduardo.FLima
    @since   27/05/2026
    @param   cTabela , Character , codigo da tabela SX5 (ex: 'WP', 'WD')
    @param   cChave  , Character , chave de busca na tabela SX5
    @return  cRet    , Character , descricao da tabela no idioma corrente
/*/
Method GetSX5Desc(cTabela as Character, cChave as Character) as Character Class RetailAutopartsCatalogMotorizationController
    Local cRet      := "" as Character
    Local aContent  := {} as Array

    aContent := FWGetSX5(cTabela, cChave)

    If Len(aContent) > 0
        cRet := AllTrim(aContent[1][4])
    EndIf

Return cRet
