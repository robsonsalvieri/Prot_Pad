#include "totvs.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "fwmvcdef.ch"
#include "retail.autoparts.catalog.vehiclemodel.controller.ch"

//               Nome do parametro no JSON     , Campo no SX3   , Tipo
Static aFields :=   { ;
                    {"vehicleCode"             , "MEC_CODVEI"   , "C"    },;
                    {"transmissionCode"        , "MEC_CODTRA"   , "C"    },;
                    {"motorizationCode"        , "MEC_CODMOT"   , "C"    },;
                    {"model"                   , "MEC_MODELO"   , "C"    },;
                    {"generation"              , "MEC_GERACA"   , "C"    },;
                    {"manufacturingStart"      , "MEC_FABINI"   , "C"    },;
                    {"manufacturingEnd"        , "MEC_FABFIM"   , "C"    },;
                    {"cabinType"               , "MEC_TIPCAB"   , "C"    },;
                    {"numberOfDoors"           , "MEC_QTDPOR"   , "C"    },;
                    {"axleDistance"             , "MEC_DISTEI"   , "N"    },;
                    {"enginePosition"          , "MEC_POSMOT"   , "C"    },;
                    {"traction"                , "MEC_TRACAO"   , "C"    },;
                    {"steeringType"            , "MEC_TPDIRE"   , "C"    },;
                    {"alternatorAmperage"      , "MEC_ALTAMP"   , "N"    },;
                    {"batteryAmpereHour"       , "MEC_BATAH"    , "N"    },;
                    {"voltage"                 , "MEC_VOLTAG"   , "C"    };
                    } as Array

namespace totvs.protheus.retail.autoparts.catalog.vehiclemodel.controller

/*/{Protheus.doc} RetailAutopartsCatalogVehicleModelController
    API relacionada ao Modelo de Veiculo do catalogo de autopecas
    @type    class
    @author  eduardo.FLima
    @since   01/06/2026
/*/
Class RetailAutopartsCatalogVehicleModelController

    public Method New()

    private Method PositionMECByUuid(cUuid as Character) as Logical
    private Method FindVehicleModel(cUuid as Character, cVehicleCode as Character, cTransCode as Character, cMotorCode as Character, cModel as Character, cGeneration as Character, cMfgStart as Character, cMfgEnd as Character, cCabinType as Character, cDoors as Character) as Array
    private Method CountVehicleModel() as Numeric
    private Method GetSX5Desc(cTabela as Character, cChave as Character) as Character

    @Get("/api/retail/v1/retailAutopartsCatalogVehicleModel/getDataForVehicleModel", description="Consulta os modelos de veiculo do catalogo de autopecas, podendo filtrar por uuid, codigo veiculo, transmissao, motorizacao, modelo, geracao, fabricacao, tipo cabine e portas")
    public Method getDataForVehicleModel()

    @Get("/api/retail/v1/retailAutopartsCatalogVehicleModel/getCountDataForVehicleModel", description="Consulta a quantidade total de modelos de veiculo do catalogo de autopecas")
    public Method getCountDataForVehicleModel()

    @Post("/api/retail/v1/retailAutopartsCatalogVehicleModel/postDataForVehicleModel", description="Cadastra um novo modelo de veiculo para o catalogo de autopecas")
    public Method postDataForVehicleModel()

    @Put("/api/retail/v1/retailAutopartsCatalogVehicleModel/putDataForVehicleModel", description="Altera um modelo de veiculo existente no catalogo de autopecas")
    public Method putDataForVehicleModel()

    @Delete("/api/retail/v1/retailAutopartsCatalogVehicleModel/deleteDataForVehicleModel/:uuid", description="Deleta um modelo de veiculo do catalogo de autopecas")
    public Method deleteDataForVehicleModel()

EndClass

/*/{Protheus.doc} New
    Metodo construtor
    @type   method
    @author eduardo.FLima
    @since  01/06/2026
/*/
Method New() Class RetailAutopartsCatalogVehicleModelController
Return Self

/*/{Protheus.doc} getDataForVehicleModel
    Retorna os modelos de veiculo do catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   01/06/2026
    @version p12
/*/
Method getDataForVehicleModel() Class RetailAutopartsCatalogVehicleModelController
    Local oJsonRespo    := JsonObject():New() as Object
    Local oJParametr    := oRest:getQueryRequest() as Object
    Local aItens        := {} as Array
    Local cUuid         := "" as Character
    Local cVehicleCode  := "" as Character
    Local cTransCode    := "" as Character
    Local cMotorCode    := "" as Character
    Local cModel        := "" as Character
    Local cGeneration   := "" as Character
    Local cMfgStart     := "" as Character
    Local cMfgEnd       := "" as Character
    Local cCabinType    := "" as Character
    Local cDoors        := "" as Character

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Obtem os parametros informados na requisicao via URL (query param)
    If oJParametr:hasProperty('uuid')
        cUuid := oJParametr['uuid']
    EndIf
    If oJParametr:hasProperty('vehicleCode')
        cVehicleCode := oJParametr['vehicleCode']
    EndIf
    If oJParametr:hasProperty('transmissionCode')
        cTransCode := oJParametr['transmissionCode']
    EndIf
    If oJParametr:hasProperty('motorizationCode')
        cMotorCode := oJParametr['motorizationCode']
    EndIf
    If oJParametr:hasProperty('model')
        cModel := oJParametr['model']
    EndIf
    If oJParametr:hasProperty('generation')
        cGeneration := oJParametr['generation']
    EndIf
    If oJParametr:hasProperty('manufacturingStart')
        cMfgStart := oJParametr['manufacturingStart']
    EndIf
    If oJParametr:hasProperty('manufacturingEnd')
        cMfgEnd := oJParametr['manufacturingEnd']
    EndIf
    If oJParametr:hasProperty('cabinType')
        cCabinType := oJParametr['cabinType']
    EndIf
    If oJParametr:hasProperty('numberOfDoors')
        cDoors := oJParametr['numberOfDoors']
    EndIf

    aItens := Self:FindVehicleModel(cUuid, cVehicleCode, cTransCode, cMotorCode, cModel, cGeneration, cMfgStart, cMfgEnd, cCabinType, cDoors)

    If Len(aItens) > 0
        oJsonRespo["items"] := aItens
        oRest:setStatusCode(200)  // HTTP 200 = Sucesso
    Else
        oJsonRespo["items"]   := {}
        oJsonRespo["message"] := STR0001 //"Dados nao encontrados para o filtro informado"
        oRest:setStatusCode(404)  // HTTP 404 = Not Found
    EndIf

    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

Return .T.

/*/{Protheus.doc} getCountDataForVehicleModel
    Retorna a quantidade total de modelos de veiculo validos do catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   01/06/2026
    @version p12
    @return  logical, .T. indicando se a execucao foi bem sucedida
/*/
Method getCountDataForVehicleModel() Class RetailAutopartsCatalogVehicleModelController
    Local oJsonRespo    as Object
    Local nTotal        as Numeric

    oJsonRespo := JsonObject():New()
    nTotal     := 0

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    nTotal := Self:CountVehicleModel()

    oJsonRespo["total"] := nTotal
    oRest:setStatusCode(200)

    oRest:setResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)

Return .T.

/*/{Protheus.doc} postDataForVehicleModel
    Cadastro de Modelo de Veiculo para o catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   01/06/2026
    @version p12
/*/
Method postDataForVehicleModel() Class RetailAutopartsCatalogVehicleModelController
    Local oJsBody       := JsonObject():New() as Object
    Local oJsonRespo    := JsonObject():New() as Object
    Local oModel        := Nil as Object
    Local oModelMEC     := Nil as Object
    Local lGravouOK     := .F. as Logical
    Local aErros        := {} as Array
    Local lDadosOK      := .T. as Logical
    Local cParamName    := "" as Character
    Local cFieldName    := "" as Character
    Local lAnyParInf    := .F. as Logical
    Local nX            := 0 as Numeric

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    oJsBody:fromJson(oRest:GetBodyRequest())

    // ==========================================
    // Carrega o Model MVC
    // ==========================================
    oModel := FWLoadModel("LOJA6000")
    oModel:SetOperation(MODEL_OPERATION_INSERT)
    oModel:Activate()

    // ------------------------------------------
    // Obtem o SubModel da Tabela MEC (Modelo de Veiculo)
    // ------------------------------------------
    oModelMEC := oModel:GetModel("MECMASTER")

    // ==========================================
    // Preenche os Campos do Model
    // ==========================================
    For nX := 1 To Len(aFields)
        cParamName := aFields[nX][1]  // Nome do parametro no JSON
        cFieldName := aFields[nX][2]  // Nome do campo no Model

        If oJsBody[cParamName] != Nil
            oModelMEC:SetValue(cFieldName, oJsBody[cParamName])
            lAnyParInf := .T.
        EndIf
    Next nX

    If !lAnyParInf
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['message'] := STR0002 //"Nenhum parametro de modelo de veiculo informado para cadastro"
        lDadosOK := .F.
    EndIf

    If lDadosOK
        // ==========================================
        // Valida e Grava os Dados
        // ==========================================
        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        Else
            lGravouOK := .F.
        EndIf

        If lGravouOK
            oRest:setStatusCode(201)  // HTTP 201 = Created
            oJsonRespo['success'] := .T.
            oJsonRespo['message'] := STR0003 + AllTrim(MEC->MEC_MSUID) + STR0004 //"Modelo de Veiculo " ### " cadastrado com sucesso"
            oJsonRespo['uuid']    := AllTrim(MEC->MEC_MSUID)
            For nX := 1 To Len(aFields)
                cParamName := aFields[nX][1]
                cFieldName := aFields[nX][2]
                If aFields[nX][3] == "C"
                    oJsonRespo[cParamName] := AllTrim(MEC->(FieldGet(FieldPos(cFieldName))))
                Else
                    oJsonRespo[cParamName] := MEC->(FieldGet(FieldPos(cFieldName)))
                EndIf
            Next nX
        Else
            oRest:setStatusCode(400)  // HTTP 400 = Bad Request
            aErros := oModel:GetErrorMessage()

            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := IIf(!Empty(aErros[6]), aErros[6], STR0006) //"Erro ao cadastrar modelo de veiculo"
            oJsonRespo['field']   := IIf(!Empty(aErros[4]), aErros[4], "")
            oJsonRespo['errorId'] := IIf(!Empty(aErros[5]), aErros[5], "")
            oJsonRespo['solution']:= IIf(!Empty(aErros[7]), aErros[7], "")
        EndIf
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    // ==========================================
    // Libera Recursos da Memoria
    // ==========================================
    oModelMEC:DeActivate()
    oModel:DeActivate()
    FreeObj(oModelMEC)
    FreeObj(oModel)
    FreeObj(oJsBody)
    FreeObj(oJsonRespo)

Return .T.

/*/{Protheus.doc} putDataForVehicleModel
    Altera cadastro de Modelo de Veiculo do catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   01/06/2026
    @version p12
/*/
Method putDataForVehicleModel() Class RetailAutopartsCatalogVehicleModelController
    Local oJsonRespo    := JsonObject():New() as Object
    Local oJsBody       := JsonObject():New() as Object
    Local oJParametr    := oRest:getQueryRequest() as Object
    Local lFound        := .F. as Logical
    Local cUuid         := "" as Character
    Local aArea         := GetArea() as Array
    Local oModel        := Nil as Object
    Local oModelMEC     := Nil as Object
    Local lGravouOK     := .F. as Logical
    Local aErros        := {} as Array
    Local nX            := 0 as Numeric
    Local cParamName    := "" as Character
    Local cFieldName    := "" as Character
    Local lAnyParInf    := .F. as Logical
    Local lDadosOK      := .T. as Logical

    DbSelectArea("MEC")

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    oJsBody:fromJson(oRest:GetBodyRequest())

    // Obtem os parametros informados na requisicao via URL (query param)
    If oJParametr:hasProperty('uuid')
        cUuid := oJParametr['uuid']
    EndIf

    // ==========================================
    // Validacao uuid Obrigatorio
    // ==========================================
    If Empty(cUuid)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['message'] := STR0007 //"Parametro 'uuid' e obrigatorio"
        lDadosOK := .F.
    EndIf

    If lDadosOK
        lFound := Self:PositionMECByUuid(cUuid)

        // ------------------------------------------
        // Se nao encontrou retorna erro 404
        // ------------------------------------------
        If !lFound
            oRest:setStatusCode(404)  // HTTP 404 = Not Found
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0008 + AllTrim(cUuid) + STR0009 //"Registro " ### " nao encontrado"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        // ==========================================
        // Carrega o Model MVC para Alteracao
        // ==========================================
        oModel := FWLoadModel("LOJA6000")
        oModel:SetOperation(MODEL_OPERATION_UPDATE)
        oModel:Activate()

        // ------------------------------------------
        // Obtem o SubModel da Tabela MEC
        // ------------------------------------------
        oModelMEC := oModel:GetModel("MECMASTER")

        // ==========================================
        // Preenche os Campos do Model
        // ==========================================
        For nX := 1 To Len(aFields)
            cParamName := aFields[nX][1]
            cFieldName := aFields[nX][2]

            If oJsBody[cParamName] != Nil
                oModelMEC:SetValue(cFieldName, oJsBody[cParamName])
                lAnyParInf := .T.
            EndIf
        Next nX

        If !lAnyParInf
            oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
            oJsonRespo['message'] := STR0010 //"Nenhum parametro de modelo de veiculo informado para alteracao"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        // ==========================================
        // Valida e Grava as Alteracoes
        // ==========================================
        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        Else
            lGravouOK := .F.
        EndIf

        If lGravouOK
            oRest:setStatusCode(200)  // HTTP 200 = OK
            oJsonRespo['success'] := .T.
            oJsonRespo['message'] := STR0003 + AllTrim(cUuid) + STR0005 //"Modelo de Veiculo " ### " atualizado com sucesso"
            oJsonRespo['uuid']    := cUuid
            For nX := 1 To Len(aFields)
                cParamName := aFields[nX][1]
                cFieldName := aFields[nX][2]
                If aFields[nX][3] == "C"
                    oJsonRespo[cParamName] := AllTrim(MEC->(FieldGet(FieldPos(cFieldName))))
                Else
                    oJsonRespo[cParamName] := MEC->(FieldGet(FieldPos(cFieldName)))
                EndIf
            Next nX
        Else
            oRest:setStatusCode(400)  // HTTP 400 = Bad Request
            aErros := oModel:GetErrorMessage()

            oJsonRespo['success']  := .F.
            oJsonRespo['field']    := IIf(!Empty(aErros[4]), aErros[4], "")
            oJsonRespo['message']  := IIf(!Empty(aErros[6]), aErros[6], STR0011) //"Erro ao atualizar modelo de veiculo"
            oJsonRespo['solution'] := IIf(!Empty(aErros[7]), aErros[7], "")
        EndIf
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    // ==========================================
    // Libera Recursos da Memoria
    // ==========================================
    If ValType(oModel) <> "U"
        oModelMEC:DeActivate()
        oModel:DeActivate()

        FreeObj(oModelMEC)
        FreeObj(oModel)
    EndIf

    FreeObj(oJsBody)
    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

    RestArea(aArea)

Return .T.

/*/{Protheus.doc} deleteDataForVehicleModel
    Deleta modelo de veiculo do catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   01/06/2026
    @version p12
/*/
Method deleteDataForVehicleModel() Class RetailAutopartsCatalogVehicleModelController
    Local oJsonRespo    := JsonObject():New() as Object
    Local oJParametr    := oRest:getPathParamsRequest() as Object
    Local lFound        := .F. as Logical
    Local cUuid         := "" as Character
    Local aArea         := GetArea() as Array
    Local oModel        := Nil as Object
    Local lGravouOK     := .F. as Logical
    Local lDadosOK      := .T. as Logical
    Local aErros        := {} as Array

    DbSelectArea("MEC")

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // Obtem os parametros informados na requisicao via URL (path param)
    If oJParametr:hasProperty('uuid')
        cUuid := oJParametr['uuid']
    EndIf

    If Empty(cUuid)
        oRest:setStatusCode(422)  // HTTP 422 = Unprocessable Entity
        oJsonRespo['message'] := STR0007 //"Parametro 'uuid' e obrigatorio"
        lDadosOK := .F.
    EndIf

    If lDadosOK
        lFound := Self:PositionMECByUuid(cUuid)

        // ------------------------------------------
        // Se nao encontrou retorna erro 404
        // ------------------------------------------
        If !lFound
            oRest:setStatusCode(404)  // HTTP 404 = Not Found
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0008 + AllTrim(cUuid) + STR0009 //"Registro " ### " nao encontrado"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        // ==========================================
        // Carrega o Model MVC para Delete
        // ==========================================
        oModel := FWLoadModel("LOJA6000")
        oModel:SetOperation(MODEL_OPERATION_DELETE)
        oModel:Activate()

        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        EndIf

        // Resposta default: erro (padrao defensivo)
        oRest:setStatusCode(400)  // HTTP 400 = Bad Request
        oJsonRespo['success'] := .F.
        aErros := oModel:GetErrorMessage()
        oJsonRespo['message']  := IIf(!Empty(aErros[6]), aErros[6], STR0012) //"Erro ao deletar modelo de veiculo"
        oJsonRespo['field']    := IIf(!Empty(aErros[4]), aErros[4], "")
        oJsonRespo['solution'] := IIf(!Empty(aErros[7]), aErros[7], "")

        If lGravouOK
            oRest:setStatusCode(200)  // HTTP 200 = OK
            oJsonRespo['success'] := .T.
            oJsonRespo['message'] := STR0003 + AllTrim(cUuid) + STR0013 //"Modelo de Veiculo " ### " deletado com sucesso"
            // Remove campos de erro caso tenha sucesso na delecao
            oJsonRespo:delName("field")
            oJsonRespo:delName("solution")
        EndIf

        // ==========================================
        // Libera Recursos da Memoria
        // ==========================================
        oModel:DeActivate()
        FreeObj(oModel)
    EndIf

    // ==========================================
    // Envia a Resposta
    // ==========================================
    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

    RestArea(aArea)

Return .T.

/*/{Protheus.doc} PositionMECByUuid
    Posiciona a tabela MEC por UUID sem dependencias de indice SIX
    @type    method
    @author  eduardo.FLima
    @since   08/06/2026
    @param   cUuid   , Character , UUID do registro MEC
    @return  lFound  , Logical   , .T. se encontrou e posicionou
/*/
Method PositionMECByUuid(cUuid as Character) as Logical Class RetailAutopartsCatalogVehicleModelController
    Local lFound      := .F. as Logical
    Local oQueryQry   := Nil as Object
    Local cQry        := "" as Character
    Local cAliasQry   := "" as Character
    Local nSeq        := 1 as Numeric
    Local nRecno      := 0 as Numeric

    Default cUuid   := ""

    If !Empty(AllTrim(cUuid))
        cQry := " SELECT MEC.R_E_C_N_O_ AS RECNO "
        cQry += " FROM " + RetSqlName("MEC") + " MEC "
        cQry += " WHERE "
        cQry += " MEC.MEC_MSUID = ? "
        cQry += " AND MEC.D_E_L_E_T_ = ? "
        cQry := ChangeQuery(cQry)

        oQueryQry := FwExecStatement():New(cQry)

        oQueryQry:SetString(nSeq++, PadR(cUuid, TamSx3("MEC_MSUID")[1]))
        oQueryQry:SetString(nSeq++, Space(1))

        cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

        If (cAliasQry)->(!EOF())
            nRecno := (cAliasQry)->RECNO
        EndIf

        (cAliasQry)->(dbCloseArea())
        oQueryQry:Destroy()
        oQueryQry := Nil

        If nRecno > 0
            dbSelectArea("MEC")
            MEC->(dbGoTo(nRecno))
            lFound := !MEC->(EOF()) .And. AllTrim(MEC->MEC_MSUID) == AllTrim(cUuid) .And. nRecno == MEC->(Recno())
        EndIf
    EndIf
Return lFound

/*/{Protheus.doc} FindVehicleModel
    Consulta modelos de veiculo do catalogo de autopecas
    @type    method
    @author  eduardo.FLima
    @since   01/06/2026
    @version p12
    @param   cUuid        , Character , filtro pelo UUID do modelo de veiculo (busca exata)
    @param   cVehicleCode , Character , filtro pelo codigo do veiculo (busca exata)
    @param   cTransCode   , Character , filtro pelo codigo da transmissao (busca exata)
    @param   cMotorCode   , Character , filtro pelo codigo da motorizacao (busca exata)
    @param   cModel       , Character , filtro pelo modelo (busca aproximada LIKE)
    @param   cGeneration  , Character , filtro pela geracao (busca aproximada LIKE)
    @param   cMfgStart    , Character , filtro pelo inicio de fabricacao (busca exata)
    @param   cMfgEnd      , Character , filtro pelo fim de fabricacao (busca exata)
    @param   cCabinType   , Character , filtro pelo tipo de cabine (busca exata)
    @param   cDoors       , Character , filtro pela quantidade de portas (busca exata)
    @return  aItens       , Array     , array de itens encontrados
/*/
Method FindVehicleModel(cUuid as Character, cVehicleCode as Character, cTransCode as Character, cMotorCode as Character, cModel as Character, cGeneration as Character, cMfgStart as Character, cMfgEnd as Character, cCabinType as Character, cDoors as Character) as Array Class RetailAutopartsCatalogVehicleModelController
    Local oQueryQry     := Nil as Object
    Local jItem         := Nil as Object
    Local aItens        := {} as Array
    Local cQry          := "" as Character
    Local cAliasQry     := "" as Character
    Local nSeq          := 1 as Numeric
    Local aArea         := GetArea() as Array

    Default cUuid        := ""
    Default cVehicleCode := ""
    Default cTransCode   := ""
    Default cMotorCode   := ""
    Default cModel       := ""
    Default cGeneration  := ""
    Default cMfgStart    := ""
    Default cMfgEnd      := ""
    Default cCabinType   := ""
    Default cDoors       := ""

    dbSelectArea("MEC")

    cQry := " SELECT MEC.MEC_FILIAL, MEC.MEC_MSUID, MEC.MEC_CODVEI, MEC.MEC_CODTRA, "
    cQry += " MEC.MEC_CODMOT, MEC.MEC_MODELO, MEC.MEC_GERACA, "
    cQry += " MEC.MEC_FABINI, MEC.MEC_FABFIM, MEC.MEC_TIPCAB, "
    cQry += " MEC.MEC_QTDPOR, MEC.MEC_DISTEI, MEC.MEC_POSMOT, "
    cQry += " MEC.MEC_TRACAO, MEC.MEC_TPDIRE, MEC.MEC_ALTAMP, "
    cQry += " MEC.MEC_BATAH, MEC.MEC_VOLTAG, "
    cQry += " ME6.ME6_NOME AS NOMVEI, "
    cQry += " ME9.ME9_DESCRI AS DESTRA, "
    cQry += " MEA.MEA_NOME AS NOMMOT "
    cQry += " FROM " + RetSqlName("MEC") + " MEC "
    cQry += " LEFT JOIN " + RetSqlName("ME6") + " ME6 ON ME6.ME6_FILIAL = ? AND ME6.ME6_CODVEI = MEC.MEC_CODVEI AND ME6.D_E_L_E_T_ = ? "
    cQry += " LEFT JOIN " + RetSqlName("ME9") + " ME9 ON ME9.ME9_FILIAL = ? AND ME9.ME9_CODTRA = MEC.MEC_CODTRA AND ME9.D_E_L_E_T_ = ? "
    cQry += " LEFT JOIN " + RetSqlName("MEA") + " MEA ON MEA.MEA_FILIAL = ? AND MEA.MEA_CODMOT = MEC.MEC_CODMOT AND MEA.D_E_L_E_T_ = ? "
    cQry += " WHERE "
    cQry += " MEC.MEC_FILIAL = ? "

    If !Empty(cUuid)
        cQry += " AND MEC.MEC_MSUID = ? "
    EndIf

    If !Empty(cVehicleCode)
        cQry += " AND MEC.MEC_CODVEI = ? "
    EndIf

    If !Empty(cTransCode)
        cQry += " AND MEC.MEC_CODTRA = ? "
    EndIf

    If !Empty(cMotorCode)
        cQry += " AND MEC.MEC_CODMOT = ? "
    EndIf

    If !Empty(cModel)
        cQry += " AND UPPER(MEC.MEC_MODELO) LIKE ? "
    EndIf

    If !Empty(cGeneration)
        cQry += " AND UPPER(MEC.MEC_GERACA) LIKE ? "
    EndIf

    If !Empty(cMfgStart)
        cQry += " AND MEC.MEC_FABINI = ? "
    EndIf

    If !Empty(cMfgEnd)
        cQry += " AND MEC.MEC_FABFIM = ? "
    EndIf

    If !Empty(cCabinType)
        cQry += " AND MEC.MEC_TIPCAB = ? "
    EndIf

    If !Empty(cDoors)
        cQry += " AND MEC.MEC_QTDPOR = ? "
    EndIf

    cQry += " AND MEC.D_E_L_E_T_ = ? "
    cQry += " ORDER BY MEC.MEC_MODELO "

    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)

    // Parametros dos LEFT JOINs (filial + D_E_L_E_T_)
    oQueryQry:SetString(nSeq++, xFilial("ME6"))  // ME6.ME6_FILIAL
    oQueryQry:SetString(nSeq++, Space(1))         // ME6.D_E_L_E_T_
    oQueryQry:SetString(nSeq++, xFilial("ME9"))  // ME9.ME9_FILIAL
    oQueryQry:SetString(nSeq++, Space(1))         // ME9.D_E_L_E_T_
    oQueryQry:SetString(nSeq++, xFilial("MEA"))  // MEA.MEA_FILIAL
    oQueryQry:SetString(nSeq++, Space(1))         // MEA.D_E_L_E_T_

    // Parametro do WHERE principal
    oQueryQry:SetString(nSeq++, xFilial("MEC"))

    If !Empty(cUuid)
        oQueryQry:SetString(nSeq++, PadR(cUuid, TamSx3("MEC_MSUID")[1]))
    EndIf

    If !Empty(cVehicleCode)
        oQueryQry:SetString(nSeq++, PadR(cVehicleCode, TamSx3("MEC_CODVEI")[1]))
    EndIf

    If !Empty(cTransCode)
        oQueryQry:SetString(nSeq++, PadR(cTransCode, TamSx3("MEC_CODTRA")[1]))
    EndIf

    If !Empty(cMotorCode)
        oQueryQry:SetString(nSeq++, PadR(cMotorCode, TamSx3("MEC_CODMOT")[1]))
    EndIf

    If !Empty(cModel)
        oQueryQry:SetString(nSeq++, "%" + Upper(cModel) + "%")
    EndIf

    If !Empty(cGeneration)
        oQueryQry:SetString(nSeq++, "%" + Upper(cGeneration) + "%")
    EndIf

    If !Empty(cMfgStart)
        oQueryQry:SetString(nSeq++, PadR(cMfgStart, TamSx3("MEC_FABINI")[1]))
    EndIf

    If !Empty(cMfgEnd)
        oQueryQry:SetString(nSeq++, PadR(cMfgEnd, TamSx3("MEC_FABFIM")[1]))
    EndIf

    If !Empty(cCabinType)
        oQueryQry:SetString(nSeq++, PadR(cCabinType, TamSx3("MEC_TIPCAB")[1]))
    EndIf

    If !Empty(cDoors)
        oQueryQry:SetString(nSeq++, PadR(cDoors, TamSx3("MEC_QTDPOR")[1]))
    EndIf

    oQueryQry:SetString(nSeq++, Space(1))  // MEC.D_E_L_E_T_

    cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

    While (cAliasQry)->(!EOF())
        jItem := JsonObject():New()
        jItem["branch"]               := AllTrim((cAliasQry)->MEC_FILIAL)
        jItem["uuid"]                 := AllTrim((cAliasQry)->MEC_MSUID)
        jItem["vehicleCode"]          := AllTrim((cAliasQry)->MEC_CODVEI)
        jItem["vehicleName"]          := AllTrim((cAliasQry)->NOMVEI)
        jItem["transmissionCode"]     := AllTrim((cAliasQry)->MEC_CODTRA)
        jItem["transmissionDesc"]     := AllTrim((cAliasQry)->DESTRA)
        jItem["motorizationCode"]     := AllTrim((cAliasQry)->MEC_CODMOT)
        jItem["motorizationName"]     := AllTrim((cAliasQry)->NOMMOT)
        jItem["model"]                := AllTrim((cAliasQry)->MEC_MODELO)
        jItem["generation"]           := AllTrim((cAliasQry)->MEC_GERACA)
        jItem["manufacturingStart"]   := AllTrim((cAliasQry)->MEC_FABINI)
        jItem["manufacturingEnd"]     := AllTrim((cAliasQry)->MEC_FABFIM)
        jItem["cabinType"]            := AllTrim((cAliasQry)->MEC_TIPCAB)
        jItem["cabinTypeDesc"]        := Self:GetSX5Desc('WQ', (cAliasQry)->MEC_TIPCAB)
        jItem["numberOfDoors"]        := AllTrim((cAliasQry)->MEC_QTDPOR)
        jItem["axleDistance"]         := (cAliasQry)->MEC_DISTEI
        jItem["enginePosition"]       := AllTrim((cAliasQry)->MEC_POSMOT)
        jItem["enginePositionDesc"]   := Self:GetSX5Desc('WR', (cAliasQry)->MEC_POSMOT)
        jItem["traction"]             := AllTrim((cAliasQry)->MEC_TRACAO)
        jItem["tractionDesc"]         := Self:GetSX5Desc('WS', (cAliasQry)->MEC_TRACAO)
        jItem["steeringType"]         := AllTrim((cAliasQry)->MEC_TPDIRE)
        jItem["steeringTypeDesc"]     := Self:GetSX5Desc('WT', (cAliasQry)->MEC_TPDIRE)
        jItem["alternatorAmperage"]   := (cAliasQry)->MEC_ALTAMP
        jItem["batteryAmpereHour"]    := (cAliasQry)->MEC_BATAH
        jItem["voltage"]              := AllTrim((cAliasQry)->MEC_VOLTAG)

        aAdd(aItens, jItem)
        jItem := Nil
        (cAliasQry)->(dbSkip())
    EndDo

    (cAliasQry)->(dbCloseArea())
    oQueryQry:Destroy()
    oQueryQry := Nil

    RestArea(aArea)

Return(aItens)

/*/{Protheus.doc} CountVehicleModel
    Consulta a quantidade total de modelos de veiculo validos
    @type    method
    @author  eduardo.FLima
    @since   01/06/2026
    @version p12
    @return  nTotal      , Numeric   , quantidade total de registros validos
/*/
Method CountVehicleModel() as Numeric Class RetailAutopartsCatalogVehicleModelController
    Local oQueryQry     as Object
    Local cQry          as Character
    Local cAliasQry     as Character
    Local nSeq          as Numeric
    Local nTotal        as Numeric
    Local aArea         as Array

    oQueryQry   := Nil
    nSeq        := 1
    nTotal      := 0
    aArea       := GetArea()

    dbSelectArea("MEC")

    cQry := " SELECT COUNT(1) AS TOTAL "
    cQry += " FROM " + RetSqlName("MEC") + " MEC "
    cQry += " WHERE "
    cQry += " MEC.MEC_FILIAL = ? "
    cQry += " AND MEC.D_E_L_E_T_ = ? "
    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)

    oQueryQry:SetString(nSeq++, xFilial("MEC"))
    oQueryQry:SetString(nSeq++, Space(1))

    cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

    If (cAliasQry)->(!EOF())
        nTotal := (cAliasQry)->TOTAL
    EndIf

    (cAliasQry)->(dbCloseArea())

    RestArea(aArea)

    oQueryQry:Destroy()

Return nTotal

/*/{Protheus.doc} GetSX5Desc
    Retorna a descricao da tabela SX5 conforme idioma corrente
    @type    method
    @author  eduardo.FLima
    @since   01/06/2026
    @param   cTabela , Character , codigo da tabela SX5 (ex: 'WQ', 'WR', 'WS', 'WT')
    @param   cChave  , Character , chave de busca na tabela SX5
    @return  cRet    , Character , descricao da tabela no idioma corrente
/*/
Method GetSX5Desc(cTabela as Character, cChave as Character) as Character Class RetailAutopartsCatalogVehicleModelController
    Local cRet      := "" as Character
    Local aContent  := {} as Array

    aContent := FWGetSX5(cTabela, cChave)

    If Len(aContent) > 0
        cRet := AllTrim(aContent[1][4])
    EndIf

Return cRet
