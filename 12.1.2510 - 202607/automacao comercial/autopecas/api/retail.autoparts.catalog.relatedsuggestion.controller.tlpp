#include "totvs.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "fwmvcdef.ch"
#include "retail.autoparts.catalog.relatedsuggestion.controller.ch"

//             Nome do parametro no JSON  , Campo SX3    , Tipo
Static aFields := { ;
                    {"productBranch"      , "MFZ_FILPRO" , "C"},;
                    {"productCode"        , "MFZ_CODPRO" , "C"},;
                    {"parentProductCode"  , "MFZ_CODPAI" , "C"};
                 } as Array

namespace totvs.protheus.retail.autoparts.catalog.relatedsuggestion.controller

/*/{Protheus.doc} RetailAutopartsCatalogRelatedSuggestionController
    API relacionada ao cadastro de Relacionados/Sugestao de Vendas (MFZ)
    @type    class
    @author  eduardo.FLima
    @since   15/06/2026
    @version P12
/*/
Class RetailAutopartsCatalogRelatedSuggestionController

    public Method New()

    private Method PositionMFZByKey(cBranch as Character, cParentProductCode as Character, cProductCode as Character) as Logical
    private Method FindRelatedSuggestion(cProductBranch as Character, cProductCode as Character, cParentProductCode as Character, cParentProductDesc as Character, cProductDescription as Character) as Array
    private Method CountRelatedSuggestion() as Numeric

    @Get("/api/retail/v1/retailAutopartsCatalogRelatedSuggestion/getDataForRelatedSuggestion", description="Consulta relacionados/sugestao de vendas, podendo filtrar por filial produto, codigo produto, codigo produto pai, descricao produto pai e descricao produto")
    public Method getDataForRelatedSuggestion()

    @Get("/api/retail/v1/retailAutopartsCatalogRelatedSuggestion/getCountDataForRelatedSuggestion", description="Consulta a quantidade total de relacionados/sugestao de vendas")
    public Method getCountDataForRelatedSuggestion()

    @Post("/api/retail/v1/retailAutopartsCatalogRelatedSuggestion/postDataForRelatedSuggestion", description="Cadastra um novo relacionado/sugestao de vendas")
    public Method postDataForRelatedSuggestion()

    @Put("/api/retail/v1/retailAutopartsCatalogRelatedSuggestion/putDataForRelatedSuggestion", description="Altera um relacionado/sugestao de vendas existente")
    public Method putDataForRelatedSuggestion()

    @Delete("/api/retail/v1/retailAutopartsCatalogRelatedSuggestion/deleteDataForRelatedSuggestion/:parentProductCode/:productCode", description="Exclui logicamente um relacionado/sugestao de vendas")
    public Method deleteDataForRelatedSuggestion()

EndClass

/*/{Protheus.doc} New
    Metodo construtor
    @type   method
    @author eduardo.FLima
    @since  15/06/2026
    @version P12
    @return Object, Objeto da classe
/*/
Method New() Class RetailAutopartsCatalogRelatedSuggestionController
Return Self

/*/{Protheus.doc} getDataForRelatedSuggestion
    Retorna os relacionados/sugestao de vendas filtrados
    @type    method
    @author  eduardo.FLima
    @since   15/06/2026
    @version P12
/*/
Method getDataForRelatedSuggestion() Class RetailAutopartsCatalogRelatedSuggestionController
    Local oJsonRespo         := JsonObject():New() as Object
    Local oJParametr         := oRest:getQueryRequest() as Object
    Local aItens             := {} as Array
    Local cProductBranch     := "" as Character
    Local cProductCode       := "" as Character
    Local cParentProductCode := "" as Character
    Local cParentProductDesc := "" as Character
    Local cProductDesc       := "" as Character

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    If oJParametr:hasProperty('productBranch')
        cProductBranch := oJParametr['productBranch']
    EndIf
    If oJParametr:hasProperty('productCode')
        cProductCode := oJParametr['productCode']
    EndIf
    If oJParametr:hasProperty('parentProductCode')
        cParentProductCode := oJParametr['parentProductCode']
    EndIf
    If oJParametr:hasProperty('parentProductDesc')
        cParentProductDesc := oJParametr['parentProductDesc']
    EndIf
    If oJParametr:hasProperty('productDescription')
        cProductDesc := oJParametr['productDescription']
    EndIf

    aItens := Self:FindRelatedSuggestion(cProductBranch, cProductCode, cParentProductCode, cParentProductDesc, cProductDesc)

    If Len(aItens) > 0
        oJsonRespo['items'] := aItens
        oRest:setStatusCode(200)
    Else
        oJsonRespo['items'] := {}
        oJsonRespo['message'] := STR0001 //"Dados não encontrados para o filtro informado"
        oRest:setStatusCode(404)
    EndIf

    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)
    FreeObj(oJParametr)

Return .T.

/*/{Protheus.doc} getCountDataForRelatedSuggestion
    Retorna a quantidade total de relacionados/sugestao de vendas validos
    @type    method
    @author  eduardo.FLima
    @since   15/06/2026
    @version p12
/*/
Method getCountDataForRelatedSuggestion() Class RetailAutopartsCatalogRelatedSuggestionController
    Local oJsonRespo := JsonObject():New() as Object

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    oJsonRespo['total'] := Self:CountRelatedSuggestion()
    oRest:setStatusCode(200)
    oRest:SetResponse(oJsonRespo:toJson())

    FreeObj(oJsonRespo)

Return .T.

/*/{Protheus.doc} postDataForRelatedSuggestion
    Cadastro de Relacionado/Sugestao de Vendas
    @type    method
    @author  eduardo.FLima
    @since   15/06/2026
    @version p12
/*/
Method postDataForRelatedSuggestion() Class RetailAutopartsCatalogRelatedSuggestionController
    Local oJsBody       := JsonObject():New() as Object
    Local oJsonRespo    := JsonObject():New() as Object
    Local oModel        := Nil as Object
    Local oModelMFZ     := Nil as Object
    Local aErros        := {} as Array
    Local lGravouOK     := .F. as Logical
    Local cParamName    := "" as Character
    Local cFieldName    := "" as Character
    Local lAnyParInf    := .F. as Logical
    Local nX            := 0 as Numeric

    oRest:setKeyHeaderResponse("Content-Type", "application/json")
    oJsBody:fromJson(oRest:GetBodyRequest())

    oModel := FWLoadModel('LOJA6030')
    oModel:SetOperation(MODEL_OPERATION_INSERT)
    oModel:Activate()

    oModelMFZ := oModel:GetModel('MFZMASTER')

    // Se productBranch nao informado, assume xFilial
    If oJsBody['productBranch'] == Nil .Or. Empty(oJsBody['productBranch'])
        oModelMFZ:SetValue('MFZ_FILPRO', xFilial('SB1'))
    EndIf

    For nX := 1 To Len(aFields)
        cParamName := aFields[nX][1]
        cFieldName := aFields[nX][2]

        If oJsBody[cParamName] != Nil
            oModelMFZ:SetValue(cFieldName, oJsBody[cParamName])
            lAnyParInf := .T.
        EndIf
    Next nX


    If !lAnyParInf
        oRest:setStatusCode(422)
        oJsonRespo['message'] := STR0002 //"Nenhum parâmetro informado para cadastro"
    Else
        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        EndIf

        If lGravouOK
            oRest:setStatusCode(201)
            oJsonRespo['success']           := .T.
            oJsonRespo['message']           := STR0003 //"Relacionado/sugestão cadastrado com sucesso"
            oJsonRespo['branch']            := AllTrim(MFZ->MFZ_FILIAL)
            oJsonRespo['productBranch']     := AllTrim(MFZ->MFZ_FILPRO)
            oJsonRespo['parentProductCode'] := AllTrim(MFZ->MFZ_CODPAI)
            oJsonRespo['productCode']       := AllTrim(MFZ->MFZ_CODPRO)
        Else
            aErros := oModel:GetErrorMessage()
            oRest:setStatusCode(400)
            oJsonRespo['success']  := .F.
            oJsonRespo['message']  := IIf(!Empty(aErros[6]), aErros[6], STR0004) //"Erro ao cadastrar relacionado/sugestão"
            oJsonRespo['field']    := IIf(!Empty(aErros[4]), aErros[4], "")
            oJsonRespo['errorId']  := IIf(!Empty(aErros[5]), aErros[5], "")
            oJsonRespo['solution'] := IIf(!Empty(aErros[7]), aErros[7], "")
        EndIf
    EndIf

    oRest:SetResponse(oJsonRespo:toJson())

    oModelMFZ:DeActivate()
    oModel:DeActivate()

    FreeObj(oModelMFZ)
    FreeObj(oModel)
    FreeObj(oJsBody)
    FreeObj(oJsonRespo)

Return .T.

/*/{Protheus.doc} putDataForRelatedSuggestion
    Altera Relacionado/Sugestao de Vendas por chave composta
    @type    method
    @author  eduardo.FLima
    @since   15/06/2026
    @version p12
/*/
Method putDataForRelatedSuggestion() Class RetailAutopartsCatalogRelatedSuggestionController
    Local oJsonRespo         := JsonObject():New() as Object
    Local oJsBody            := JsonObject():New() as Object
    Local oJParametr         := oRest:getQueryRequest() as Object
    Local aArea              := GetArea() as Array
    Local oModel             := Nil as Object
    Local oModelMFZ          := Nil as Object
    Local lFound             := .F. as Logical
    Local lGravouOK          := .F. as Logical
    Local aErros             := {} as Array
    Local cBranch            := "" as Character
    Local cProductCode       := "" as Character
    Local cParentProductCode := "" as Character
    Local lAnyParInf         := .F. as Logical
    Local lDadosOK           := .T. as Logical
    Local cParamName         := "" as Character
    Local cFieldName         := "" as Character
    Local nX                 := 0 as Numeric


    DbSelectArea('MFZ')

    oRest:setKeyHeaderResponse("Content-Type", "application/json")
    oJsBody:fromJson(oRest:GetBodyRequest())
    //Por padrão a filial e a filial posicionada 
    cBranch := xFilial('MFZ')
    // Obtem os parametros informados na requisicao via URL (query param)
    // productBranch opcional, default xFilial
    If oJParametr:hasProperty('productBranch') 
        cBranch := oJParametr['productBranch']
    EndIf

    If oJParametr:hasProperty('parentProductCode')
        cParentProductCode := oJParametr['parentProductCode']
    EndIf
    If oJParametr:hasProperty('productCode')
        cProductCode := oJParametr['productCode']
    EndIf

    // Validacao campos obrigatorios
    If Empty(cParentProductCode) .Or. Empty(cProductCode)
        oRest:setStatusCode(422)
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := STR0005 //"Parâmetros de chave para pesquisa são obrigatórios: parentProductCode e productCode"
        lDadosOK := .F.
    EndIf

    If lDadosOK
        lFound := Self:PositionMFZByKey(cBranch, cParentProductCode, cProductCode)

        If !lFound
            oRest:setStatusCode(404)
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0006 //"Registro não encontrado para os parâmetros informados"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        oModel := FWLoadModel('LOJA6030')
        oModel:SetOperation(MODEL_OPERATION_UPDATE)
        oModel:Activate()

        oModelMFZ := oModel:GetModel('MFZMASTER')

        // ==========================================
        // Preenche os Campos do Model
        // ==========================================
        For nX := 1 To Len(aFields)
            cParamName := aFields[nX][1]
            cFieldName := aFields[nX][2]

            If oJsBody[cParamName] != Nil
                oModelMFZ:SetValue(cFieldName, oJsBody[cParamName])
                lAnyParInf := .T.
            EndIf
        Next nX

        If !lAnyParInf
            oRest:setStatusCode(422)
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0007 //"Nenhum parâmetro informado para alteração"
            lDadosOK := .F.
        EndIf
    EndIf

    If lDadosOK
        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        EndIf

        If lGravouOK
            oRest:setStatusCode(200)
            oJsonRespo['success'] := .T.
            oJsonRespo['message'] := STR0008 //"Relacionado/sugestão atualizado com sucesso"
            oJsonRespo['branch']            := AllTrim(MFZ->MFZ_FILIAL)
            For nX := 1 To Len(aFields)
                cParamName := aFields[nX][1]
                cFieldName := aFields[nX][2]
                If aFields[nX][3] == "C"
                    oJsonRespo[cParamName] := AllTrim(MFZ->(FieldGet(FieldPos(cFieldName))))
                EndIf
            Next nX
        Else
            aErros := oModel:GetErrorMessage()
            oRest:setStatusCode(400)
            oJsonRespo['success']  := .F.
            oJsonRespo['message']  := IIf(!Empty(aErros[6]), aErros[6], STR0009) //"Erro ao atualizar relacionado/sugestão"
            oJsonRespo['field']    := IIf(!Empty(aErros[4]), aErros[4], "")
            oJsonRespo['solution'] := IIf(!Empty(aErros[7]), aErros[7], "")
        EndIf
    EndIf

    oRest:SetResponse(oJsonRespo:toJson())

    If ValType(oModel) <> 'U'
        oModelMFZ:DeActivate()
        oModel:DeActivate()
        FreeObj(oModelMFZ)
        FreeObj(oModel)
    EndIf

    FreeObj(oJsonRespo)
    FreeObj(oJsBody)
    FreeObj(oJParametr)

    RestArea(aArea)

Return .T.

/*/{Protheus.doc} deleteDataForRelatedSuggestion
    Exclui logicamente Relacionado/Sugestao de Vendas por chave composta
    @type    method
    @author  eduardo.FLima
    @since   15/06/2026
    @version p12
/*/
Method deleteDataForRelatedSuggestion() Class RetailAutopartsCatalogRelatedSuggestionController
    Local oJsonRespo         := JsonObject():New() as Object
    Local oJPath             := oRest:getPathParamsRequest() as Object
    Local oJParametr         := oRest:getQueryRequest() as Object
    Local aArea              := GetArea() as Array
    Local oModel             := Nil as Object
    Local aErros             := {} as Array
    Local lGravouOK          := .F. as Logical
    Local lFound             := .F. as Logical
    Local lDadosOK           := .T. as Logical
    Local cBranch            := "" as Character
    Local cProductCode       := "" as Character
    Local cParentProductCode := "" as Character

    DbSelectArea('MFZ')

    oRest:setKeyHeaderResponse("Content-Type", "application/json")

    // productBranch opcional via query param, default xFilial
    If oJParametr:hasProperty('productBranch') .And. !Empty(oJParametr['productBranch'])
        cBranch := oJParametr['productBranch']
    Else
        cBranch := xFilial('SB1')
    EndIf

    // Obtem os parametros informados na requisicao via URL (path param)
    If oJPath:hasProperty('parentProductCode')
        cParentProductCode := oJPath['parentProductCode']
    EndIf
    If oJPath:hasProperty('productCode')
        cProductCode := oJPath['productCode']
    EndIf

    // Validacao campos obrigatorios
    If Empty(cParentProductCode) .Or. Empty(cProductCode)
        oRest:setStatusCode(422)
        oJsonRespo['success'] := .F.
        oJsonRespo['message'] := STR0005 //"Parâmetros de chave para pesquisa são obrigatórios: parentProductCode e productCode"
        lDadosOK := .F.
    EndIf

    If lDadosOK
        lFound := Self:PositionMFZByKey(cBranch, cParentProductCode, cProductCode)

        If !lFound
            oRest:setStatusCode(404)
            oJsonRespo['success'] := .F.
            oJsonRespo['message'] := STR0006 //"Registro não encontrado para os parâmetros informados"
            lDadosOK := .F.
        EndIf
    EndIf


    If lDadosOK
        oModel := FWLoadModel('LOJA6030')
        oModel:SetOperation(MODEL_OPERATION_DELETE)
        oModel:Activate()

        If oModel:VldData()
            lGravouOK := oModel:CommitData()
        EndIf

        // Resposta default: erro (padrao defensivo)
        oRest:setStatusCode(400)  // HTTP 400 = Bad Request
        oJsonRespo['success'] := .F.
        aErros := oModel:GetErrorMessage()
        oJsonRespo['message']  := IIf(!Empty(aErros[6]), aErros[6], STR0011) //"Erro ao excluir relacionado/sugestão"
        oJsonRespo['field']    := IIf(!Empty(aErros[4]), aErros[4], "")
        oJsonRespo['solution'] := IIf(!Empty(aErros[7]), aErros[7], "")

        If lGravouOK
            oRest:setStatusCode(200)
            oJsonRespo['success'] := .T.
            oJsonRespo['message'] := STR0010 //"Relacionado/sugestão excluído com sucesso"
            // Remove campos de erro caso tenha sucesso na delecao
            oJsonRespo:delName("field")
            oJsonRespo:delName("solution")
        EndIf
    EndIf

    oRest:SetResponse(oJsonRespo:toJson())

    If ValType(oModel) <> 'U'
        oModel:DeActivate()
        FreeObj(oModel)
    EndIf

    FreeObj(oJsonRespo)
    FreeObj(oJPath)
    FreeObj(oJParametr)

    RestArea(aArea)

Return .T.

/*/{Protheus.doc} PositionMFZByKey
    Posiciona MFZ pelos parametros informados
    @type    method
    @author  eduardo.FLima
    @since   15/06/2026
    @version P12
    @param   cBranch              , Character, Codigo da filial do produto
    @param   cParentProductCode   , Character, Codigo do produto pai
    @param   cProductCode         , Character, Codigo do produto relacionado
    @return  Logical              , .T. se encontrado
/*/
Method PositionMFZByKey(cBranch as Character, cParentProductCode as Character, cProductCode as Character) as Logical Class RetailAutopartsCatalogRelatedSuggestionController
    Local lFound := .F. as Logical

    MFZ->(DbSetOrder(1)) // MFZ_FILIAL+MFZ_FILPRO+MFZ_CODPAI+MFZ_CODPRO

    lFound := MFZ->(DbSeek(PadR(xfilial('MFZ'), TamSx3('MFZ_FILIAL')[1]) + ;
                           PadR(cBranch, TamSx3('MFZ_FILPRO')[1]) + ;
                           PadR(cParentProductCode, TamSx3('MFZ_CODPAI')[1]) + ;
                           PadR(cProductCode, TamSx3('MFZ_CODPRO')[1])))

Return lFound

/*/{Protheus.doc} FindRelatedSuggestion
    Consulta relacionados/sugestao de vendas com filtros opcionais
    @type    method
    @author  eduardo.FLima
    @since   15/06/2026
    @version P12
    @param   cProductBranch       , Character , Filial do produto
    @param   cProductCode         , Character , Codigo do produto relacionado
    @param   cParentProductCode   , Character , Codigo do produto pai
    @param   cParentProductDesc   , Character , Descricao do produto pai (filtro LIKE)
    @param   cProductDescription  , Character , Descricao do produto relacionado (filtro LIKE)
    @return  Array                , Array de objetos com os relacionados/sugestao de vendas encontrados
/*/
Method FindRelatedSuggestion(cProductBranch as Character, cProductCode as Character, cParentProductCode as Character, cParentProductDesc as Character, cProductDescription as Character) as Array Class RetailAutopartsCatalogRelatedSuggestionController
    Local oQueryQry    := Nil as Object
    Local cQry         := "" as Character
    Local cAliasQry    := "" as Character
    Local nSeq         := 1 as Numeric
    Local aItens       := {} as Array
    Local jItem        := Nil as Object
    Local aArea        := GetArea() as Array

    Default cProductBranch     := ""
    Default cProductCode       := ""
    Default cParentProductCode := ""
    Default cParentProductDesc := ""
    Default cProductDescription := ""

    cQry := " SELECT MFZ.MFZ_FILIAL, MFZ.MFZ_FILPRO, MFZ.MFZ_CODPAI, MFZ.MFZ_CODPRO,  "
    cQry += " SB1PAI.B1_DESC AS PARENTPRODDESC, SB1PRO.B1_DESC AS PRODUCTDESC "
    cQry += " FROM " + RetSqlName('MFZ') + " MFZ "
    cQry += " LEFT JOIN " + RetSqlName('SB1') + " SB1PAI ON SB1PAI.B1_FILIAL = ? AND SB1PAI.B1_COD = MFZ.MFZ_CODPAI AND SB1PAI.D_E_L_E_T_ = ? "
    cQry += " LEFT JOIN " + RetSqlName('SB1') + " SB1PRO ON SB1PRO.B1_FILIAL = ? AND SB1PRO.B1_COD = MFZ.MFZ_CODPRO AND SB1PRO.D_E_L_E_T_ = ? "
    cQry += " WHERE MFZ.MFZ_FILIAL = ? "

    If !Empty(cProductBranch)
        cQry += " AND MFZ.MFZ_FILPRO = ? "
    EndIf

    If !Empty(cProductCode)
        cQry += " AND MFZ.MFZ_CODPRO = ? "
    EndIf

    If !Empty(cParentProductCode)
        cQry += " AND MFZ.MFZ_CODPAI = ? "
    EndIf

    If !Empty(cParentProductDesc)
        cQry += " AND UPPER(SB1PAI.B1_DESC) LIKE ? "
    EndIf

    If !Empty(cProductDescription)
        cQry += " AND UPPER(SB1PRO.B1_DESC) LIKE ? "
    EndIf

    cQry += " AND MFZ.D_E_L_E_T_ = ? "
    cQry += " ORDER BY MFZ.MFZ_CODPAI, MFZ.MFZ_CODPRO "

    cQry := ChangeQuery(cQry)
    oQueryQry := FwExecStatement():New(cQry)

    oQueryQry:SetString(nSeq++, xFilial('SB1'))
    oQueryQry:SetString(nSeq++, Space(1))
    oQueryQry:SetString(nSeq++, xFilial('SB1'))
    oQueryQry:SetString(nSeq++, Space(1))
    oQueryQry:SetString(nSeq++, xFilial('MFZ'))

    If !Empty(cProductBranch)
        oQueryQry:SetString(nSeq++, PadR(cProductBranch, TamSx3('MFZ_FILPRO')[1]))
    EndIf

    If !Empty(cProductCode)
        oQueryQry:SetString(nSeq++, PadR(cProductCode, TamSx3('MFZ_CODPRO')[1]))
    EndIf

    If !Empty(cParentProductCode)
        oQueryQry:SetString(nSeq++, PadR(cParentProductCode, TamSx3('MFZ_CODPAI')[1]))
    EndIf

    If !Empty(cParentProductDesc)
        oQueryQry:SetString(nSeq++, "%" + Upper(cParentProductDesc) + "%")
    EndIf

    If !Empty(cProductDescription)
        oQueryQry:SetString(nSeq++, "%" + Upper(cProductDescription) + "%")
    EndIf

    oQueryQry:SetString(nSeq++, Space(1))

    cAliasQry := oQueryQry:OpenAlias(GetNextAlias())

    While (cAliasQry)->(!EOF())
        jItem := JsonObject():New()

        jItem['branch']             := AllTrim((cAliasQry)->MFZ_FILIAL)
        jItem['productBranch']      := AllTrim((cAliasQry)->MFZ_FILPRO)
        jItem['parentProductCode']  := AllTrim((cAliasQry)->MFZ_CODPAI)
        jItem['parentProductDesc']  := AllTrim((cAliasQry)->PARENTPRODDESC)
        jItem['productCode']        := AllTrim((cAliasQry)->MFZ_CODPRO)
        jItem['productDescription'] := AllTrim((cAliasQry)->PRODUCTDESC)

        aAdd(aItens, jItem)

        jItem := Nil
        (cAliasQry)->(DbSkip())
    EndDo

    (cAliasQry)->(DbCloseArea())
    oQueryQry:Destroy()
    oQueryQry := Nil

    RestArea(aArea)

Return aItens


/*/{Protheus.doc} CountRelatedSuggestion
    Retorna quantidade total de registros MFZ validos
    @type    method
    @author  eduardo.FLima
    @since   15/06/2026
    @version P12
    @return  Numeric              , Quantidade total de registros MFZ validos
/*/
Method CountRelatedSuggestion() as Numeric Class RetailAutopartsCatalogRelatedSuggestionController
    Local oQueryQry   := Nil as Object
    Local cQry        := "" as Character
    Local nSeq        := 1 as Numeric
    Local nTotal      := 0 as Numeric
    Local aArea       := GetArea() as Array

    cQry := " SELECT COUNT(1) AS TOTAL "
    cQry += " FROM " + RetSqlName('MFZ') + " MFZ "
    cQry += " WHERE MFZ.MFZ_FILIAL = ? "
    cQry += " AND MFZ.D_E_L_E_T_ = ? "

    cQry := ChangeQuery(cQry)

    oQueryQry := FwExecStatement():New(cQry)
    oQueryQry:SetString(nSeq++, xFilial('MFZ'))
    oQueryQry:SetString(nSeq++, Space(1))
    nTotal := Val(cValToChar(oQueryQry:ExecScalar('TOTAL')))

    RestArea(aArea)

    oQueryQry:Destroy()
    oQueryQry := Nil

Return nTotal


