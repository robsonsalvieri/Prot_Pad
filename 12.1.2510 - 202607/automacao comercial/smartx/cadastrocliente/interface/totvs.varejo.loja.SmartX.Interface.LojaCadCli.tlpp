#include "fw-tlpp-core.th"
#include "protheus.ch"
#include "totvs.framework.structure.Interface.th"

  #DEFINE SSTR0001 'Cadastro de Cliente'
  #DEFINE SSTR0002 'Visualizar Cliente'
  #DEFINE SSTR0003 'Clientes'
  #DEFINE SSTR0004 'Incluir Cliente'
  #DEFINE SSTR0005 'Editar Cliente'
  #DEFINE SSTR0010 'Auto Preenchimento'
  #DEFINE SSTR0006 'Identificação'
  #DEFINE SSTR0007 'Endereço'
  #DEFINE SSTR0008 'Contato'
  #DEFINE SSTR0009 'Informações Fiscais'
  
namespace totvs.varejo.loja.SmartX.Interface

@totvsFrameworkStructureInterface(lookup=.F., country="ALL", description=SSTR0001)
Class LojaCadCli
 
    private data oInterface  as object
    private data oDataNew    as object
    private data oDataEdit   as object
    private data oDataDetail as object
    private data oDataView   as object

    public method new() as object
    public method setInterface()
    public method getContract() as json
    private method buildElements() as array
 
EndClass

method new() as object class LojaCadCli

return self

method setInterface() class LojaCadCli

    Local oAdvplAutPCC       As Object
    Local aElements          As Array

    ::oInterface := totvs.framework.structure.interface.BuildContract():new( "LojaCadCli" )
    ::oInterface:setTitle( SSTR0001 )
    ::oInterface:setModelId( "totvs.varejo.loja.SmartX.Model.LojaCadCli", .F.)
    ::oInterface:setVersion( "2.0" )

    //incluir Cliente
    ::oDataNew := totvs.framework.structure.interface.BuildDataNew():new("LojaCadCliNew", "totvs.varejo.loja.SmartX.Model.LojaCadCli")
    ::oDataNew:setTitle(SSTR0004)
    //editar Cliente
    ::oDataEdit := totvs.framework.structure.interface.BuildDataEdit():new("LojaCadCliEdit", "totvs.varejo.loja.SmartX.Model.LojaCadCli")
    ::oDataEdit:setTitle(SSTR0005)
    //visualizar Cliente
    ::oDataDetail := totvs.framework.structure.interface.BuildDataDetail():new("LojaCadCliDetail", "totvs.varejo.loja.SmartX.Model.LojaCadCli")
    ::oDataDetail:setTitle(SSTR0002)

    oAdvplAutPCC := totvs.framework.structure.interface.BuildAdvplAction():new()
    oAdvplAutPCC:setLabel(SSTR0010)
    oAdvplAutPCC:setIdentifier('ljAtAutPCC')
    oAdvplAutPCC:setRoutine("totvs.varejo.loja.SmartX.Model.LjSmxAtAutPCC")
    oAdvplAutPCC:setHasResponse(.F.)

    ::oDataView := totvs.framework.structure.interface.BuildDataView():new("LojaCadCliView", "totvs.varejo.loja.SmartX.Model.LojaCadCli")
    ::oDataView:setModelId( "totvs.varejo.loja.SmartX.Model.LojaCadCli", .F.)
    ::oDataView:setTitle(SSTR0003)
    ::oDataView:addPageAction(oAdvplAutPCC:getAction())  // Adiciona botão Auto Preenchimento no View

    aElements := ::buildElements()
    ::oDataNew:setElement(aElements)
    ::oDataEdit:setElement(aElements)
    ::oDataDetail:setElement(aElements)

    // A1_MAILDIG e A1_DOMMAIL editáveis em inclusão e alteração (campos virtuais são readOnly por padrão no SmartX)
    ::oDataNew:addProperty("SA1", "A1_MAILDIG", "readOnly", "false")
    ::oDataNew:addProperty("SA1", "A1_DOMMAIL", "readOnly", "false")
    ::oDataEdit:addProperty("SA1", "A1_MAILDIG", "readOnly", "false")
    ::oDataEdit:addProperty("SA1", "A1_DOMMAIL", "readOnly", "false")

    // MV_LJCTPDV = 1: A1_COD e A1_LOJA somente leitura (código gerado automaticamente via STICGCVLD)
    // addProperty deve ser chamado APÓS setElement, pois o framework busca o campo na lista de elementos
    // Obrigatório informar o alias da tabela como primeiro parâmetro (ex: CadastroEstacao usa "SLG", "LG_CAMPO")
    If SuperGetMV("MV_LJCTPDV",,.F.,"2") == "1"
        ::oDataNew:addProperty("SA1", "A1_COD",  "readOnly", "true")
        ::oDataNew:addProperty("SA1", "A1_LOJA", "readOnly", "true")
        ::oDataEdit:addProperty("SA1", "A1_COD",  "readOnly", "true")
        ::oDataEdit:addProperty("SA1", "A1_LOJA", "readOnly", "true")
    EndIf

    ::oInterface:setDataNew(::oDataNew:getDataNew())
    ::oInterface:setDataEdit(::oDataEdit:getDataEdit())
    ::oInterface:setDataDetail(::oDataDetail:getDataDetail())
    ::oInterface:setDataView(::oDataView:getDataView())

return self

/*/{Protheus.doc} buildElements
Monta e retorna o array de elementos com as seções do formulário de cadastro de cliente:
Identificação, Endereço, Contato e Informações Fiscais.
@type  Method
@author caio.okamoto
@since 04/05/2026
@version v1.0
@return aElements, Array, Array de elementos com as seções mescladas para uso em setElement()
/*/
method buildElements() as array class LojaCadCli
    Local oElmIdentificacao  As Object
    Local oElmEndereco       As Object
    Local oElmContato        As Object
    Local oSecIdentificacao  As Object
    Local oSecEndereco       As Object
    Local oSecContato        As Object
    Local aElements          As Array

    // --- Seção: Identificação ---
    oElmIdentificacao := totvs.framework.structure.interface.BuildElementsFromCode():new()
    oElmIdentificacao:addElements({"A1_COD", "A1_LOJA", "A1_TIPO", "A1_PESSOA", "A1_CGC", "A1_RG","A1_INSCR", "A1_NOME", "A1_NREDUZ", "A1_DTNASC"}, .F.)
    oSecIdentificacao := totvs.framework.structure.interface.BuildSectionsFromCode():new()
    oSecIdentificacao:addSections(SSTR0006, oElmIdentificacao:getElements())

    // --- Seção: Endereço ---
    oElmEndereco := totvs.framework.structure.interface.BuildElementsFromCode():new()
    oElmEndereco:addElements({"A1_CEP", "A1_END", "A1_BAIRRO", "A1_COD_MUN", "A1_MUN", "A1_EST", "A1_PAIS", "A1_COMPLEM", "A1_PAISDES", "A1_CNAE"}, .F.)
    oSecEndereco := totvs.framework.structure.interface.BuildSectionsFromCode():new()
    oSecEndereco:addSections(SSTR0007, oElmEndereco:getElements())

    // --- Seção: Contato ---
    oElmContato := totvs.framework.structure.interface.BuildElementsFromCode():new()
    oElmContato:addElements({"A1_DDD", "A1_TEL", "A1_EMAIL", "A1_MAILDIG", "A1_DOMMAIL"}, .F.)
    oSecContato := totvs.framework.structure.interface.BuildSectionsFromCode():new()
    oSecContato:addSections(SSTR0008, oElmContato:getElements())

    // --- Mescla todas as seções ---
    aElements := totvs.framework.structure.interface.BuildElementsFromCode():mergeElements(;
                    {}, ;
                    {oSecIdentificacao:getSections(), oSecEndereco:getSections(), oSecContato:getSections()} )

Return aElements

method getContract() as json class LojaCadCli
return ::oInterface:getContract( )
