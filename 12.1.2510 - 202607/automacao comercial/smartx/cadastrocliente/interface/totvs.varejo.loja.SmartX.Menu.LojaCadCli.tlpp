#include "fw-tlpp-core.th"
#include "protheus.ch"

/*/{Protheus.doc} LjCadcliSMX
    Faz a chamada do aplicativo de cadastro de cliente
    @type  Function
    @author caio.okamoto    
    @since 13/03/2026
    @version 12
    /*/
Function LjCadCliSmX()
local oLauncher as object

oLauncher := totvs.framework.application.smartx.launcher():new()
oLauncher:setInterface("totvs.varejo.loja.SmartX.Interface.LojaCadCli")
oLauncher:open()
    
Return 
