#INCLUDE "TOTVS.CH"
#INCLUDE "FWMVCDEF.CH"
#INCLUDE "PSHCARGAOPERANDOS.CH"

#DEFINE CODIGO          "OPINVD"
#DEFINE DESCRICAO       STR0001     //"OPERANDOS DE INTEGRAÇÃO"
#DEFINE TIPO_OPERACAO   "VI"        //VENDA INTEGRADA
#DEFINE PERFIL_ORI_DES  "000002"    //TODAS AS UFS
#DEFINE DT_INI_VIGENCIA "20251001"
#DEFINE DT_FIM_VIGENCIA "        "
#DEFINE STATUS_REGRA    "2"         //APROVADA

//-------------------------------------------------------------------
/*/{Protheus.doc} pshGrvOperandos
Realiza a carga dos cadastros no configurador de tributos relacionados aos Operandos de Integração

@author  Rafael Tenorio da Costa
@since   23/10/2025
@type    function
@version 12.1.2610
/*/
//-------------------------------------------------------------------
Function pshGrvOperandos()

    local lCfgTrib  := iif(FindFunction("LjCfgTrib"), LjCfgTrib(), .F.)  //Verifica se Configurador de Tributos esta habilitado
    local oCarga    := nil
    local cRetorno  := ""
    local lR2610    := GetRpoRelease() < "12.1.2610"
    
    if lCfgTrib .And. lR2610

        oCarga := PshCargaOperandos():new()

        oCarga:executeLoads(.F.)

        cRetorno := oCarga:getSuccessMsg()
        if !Empty(cRetorno)
            ljxjMsgErr(cRetorno, /*cSolucao*/, /*cRotina*/, /*xVar*/)
        endIf

        oCarga:destroy()

        fwFreeObj(oCarga)
    endIf

Return Nil

//-------------------------------------------------------------------
/*/{Protheus.doc} Classe PshCargaOperandos
Classe responsável pela carga dos cadastros no configurador de tributos relacionados aos Operandos de Integração

https://tdninterno.totvs.com/pages/releaseview.action?pageId=932351237
    
/*/
//-------------------------------------------------------------------
Class PshCargaOperandos from TaxConfiguratorLoader

    protected data aOperacao as array
    protected data aEscrituracao as array
    protected data cErro as character

    public method new() as object

    protected method loadOperacao()  as logical
    protected method saveOperacao()   as logical
    protected method loadEscrituracao() as logical
    protected method saveEscrituracao()  as logical
    protected method setErro() as variant
    protected method getCfops() as array

    //Metodos sobrescritos da classe pai
    public method executeLoads() as variant
    public method getSuccessMsg() as character
    protected method buildBases()  as array
    protected method buildRates()  as array
    protected method buildRules()  as array
    protected method saveRule() as logical
    protected method buildMessage() as character

EndClass

//-------------------------------------------------------------------
/*/{Protheus.doc} new
Instancia da classe PshCargaOperandos

@return  self, objeto PshCargaOperandos
@author  Rafael Tenorio da Costa
@since   20/10/2025
@type    method
@version 12.1.2610
/*/
//-------------------------------------------------------------------
method new() as object class PshCargaOperandos

    _Super:new(cFilAnt)

    self:cErro := ""

return self

//-------------------------------------------------------------------
/*/{Protheus.doc} executeLoads
Realiza as cargas no configurador

@param   lForce, logical, força a gravação das regras de tributos mesmo que já existam
@author  Rafael Tenorio da Costa
@since   20/10/2025
@type    method
@version 12.1.2610
/*/
//-------------------------------------------------------------------
method executeLoads(lForce as logical) as variant class PshCargaOperandos

    local lContinua := .T.

    default lForce := .F.

    begin transaction

        lContinua := self:loadOperacao()

        if lContinua
            lContinua := self:loadEscrituracao()
        endIf
        
        if lContinua
            self:loadParticipants()
            self:loadProducts()
            self:loadBases()
            self:loadRates()
            self:loadRules(lForce)
        else
            disarmTransaction()
        endIf

    end transaction

return nil

//-------------------------------------------------------------------
/*/{Protheus.doc} loadOperacao
Carrega os perfils de operação

@return  lLoad, logical, retorna se a operação foi carregada com sucesso
@author  Rafael Tenorio da Costa
@since   21/10/2025
@type    method
@version 12.1.2610
/*/
//-------------------------------------------------------------------
method loadOperacao() as logical class PshCargaOperandos

    local aCfop := {}
    local lLoad := .T.

    self:aOperacao := {}

    if self:loadExists("F20", 1, CODIGO + "03")  //F20_FILIAL, F20_CODIGO, F20_TIPO, R_E_C_D_E_L_
        
        self:aOperacao := {F20->F20_CODIGO, F20->F20_DESC, /*F26_TIPOPF*/, /*F23_CFOP*/}
    else

        //Retorna CFOPs de Saída
        aCfop := self:getCfops()

        self:aOperacao := {CODIGO, STR0002 + DESCRICAO, TIPO_OPERACAO, aClone(aCfop)}   //"PERFIL DE OPERAÇÃO: "

        lLoad := self:saveOperacao()

        fwFreeArray(aCfop)
    endIf

return lLoad

//-------------------------------------------------------------------
/*/{Protheus.doc} saveOperacao
Método para gravar perfil de operação no configurador

@return  lSave, logical, retorna se a operação foi salva com sucesso
@author  Rafael Tenorio da Costa
@since   21/10/2025
@type    method
@version 12.1.2610
/*/
//-------------------------------------------------------------------
Method saveOperacao() as logical class PshCargaOperandos

    local oModel := nil
    local oCFOP  := nil
    local nX     := 0
    local lSave  := .F.

    oModel := FWLoadModel('FISA165')
    oCFOP  := oModel:GetModel("FISA165CFOP")

    oModel:SetOperation(MODEL_OPERATION_INSERT)
    oModel:Activate()

    //Start FISA165
    oModel:SetValue('FISA165','F20_CODIGO'  , self:aOperacao[1])
    oModel:SetValue('FISA165','F20_DESC'    , self:aOperacao[2])
    oModel:SetValue('FISA165','F20_TIPO'    , "03")

    //Start FISA165CFOP
    For nX := 1 to Len(self:aOperacao[4])
        IF !(nX == 1)
            oCFOP:AddLine()
        Endif

        oModel:SetValue('FISA165CFOP','F23_CODIGO', self:aOperacao[1])
        oModel:SetValue('FISA165CFOP','F23_CFOP'  , self:aOperacao[4][nX])
    Next

    oModel:SetValue('FISA165TPOPER','F26_CODIGO', self:aOperacao[1])
    oModel:SetValue('FISA165TPOPER','F26_TPOPER', self:aOperacao[3])

    If oModel:VldData() .and. oModel:CommitData()
        lSave            := .T.
        self:cMsgSucesso += self:buildMessage("F26", self:aOperacao[1])
    Else
        self:setErro(STR0003, oModel:GetErrorMessage())     //"Não foi possível incluir o perfil de operação: "
    EndIF

    oModel:DeActivate()
    oModel:Destroy()		
    
    fwFreeObj(oCFOP)
    fwFreeObj(oModel)

Return lSave

//-------------------------------------------------------------------
/*/{Protheus.doc} buildBases
Monta as bases de calculos para gravacao de forma automatica no configurador de tributos

@return  aBases, array, retorna bases
@author  Rafael Tenorio da Costa
@since   21/10/2025
@type    method
@version 12.1.2610
/*/
//-------------------------------------------------------------------
method buildBases() as array class PshCargaOperandos

    local aBases := {}

    if self:loadExists("F27", 1, CODIGO + "2")  //F27_FILIAL, F27_CODIGO, F27_ALTERA, F27_ID, R_E_C_N_O_, D_E_L_E_T_
        aAdd(aBases, {F27->F27_CODIGO, F27->F27_DESC, F27->F27_VALORI, F27->F27_REDBAS, /*CIN_FORMUL*/})
    else
        aAdd(aBases, {CODIGO, STR0004 + DESCRICAO, "11", 0, "O:BASE_INTEGRACAO"})   //"BASE DE CÁLCULO: "
    endIf

return aBases

//-------------------------------------------------------------------
/*/{Protheus.doc} buildRates
Monta as aliquotas para gravacao de forma automatica no configurador de tributos

@return  aAliquotas, array, retorna aliquotas
@author  Rafael Tenorio da Costa
@since   21/10/2025
@type    method
@version 12.1.2610
/*/
//-------------------------------------------------------------------
method buildRates() as array class PshCargaOperandos

    local aAliquotas := {}
        
    if self:loadExists("F28", 1, CODIGO + "2")   //F28_FILIAL, F28_CODIGO, F28_ALTERA, F28_ID, R_E_C_N_O_, D_E_L_E_T_
        aAdd(aAliquotas, {F28->F28_CODIGO, F28->F28_DESC, F28->F28_VALORI, F28->F28_ALIQ, F28->F28_TPALIQ, /*CIN_FORMUL*/})
    else
        aAdd(aAliquotas, {CODIGO, STR0005 + DESCRICAO, "06", 0, "1", "O:ALIQUOTA_INTEGRACAO"})  //"REGRA DE ALÍQUOTA: "
    endIf

return aAliquotas

//-------------------------------------------------------------------
/*/{Protheus.doc} loadEscrituracao
Monta os perfils de operação

@return  lLoad, logical, retorna se a operação foi carregada com sucesso
@author  Rafael Tenorio da Costa
@since   21/10/2025
@type    method
@version 12.1.2610
/*/
//-------------------------------------------------------------------
method loadEscrituracao() as logical class PshCargaOperandos

    Local lLoad := .T.
    Local nI    := 0
    Local aIncide  := {{"OPINLE","1"},{CODIGO,"8"}}
    self:aEscrituracao := {}

    For nI := 1 to 2

        if self:loadExists("CJ2", 1, aIncide[nI][1] + "2")   //CJ2_FILIAL, CJ2_CODIGO, CJ2_ALTERA, R_E_C_N_O_, D_E_L_E_T_
            aAdd(self:aEscrituracao, {CJ2->CJ2_CODIGO, CJ2->CJ2_DESCR, CJ2->CJ2_INCIDE})
        else
            aAdd(self:aEscrituracao, {aIncide[nI][1], STR0006 + DESCRICAO, aIncide[nI][2]})   //"REGRA DE ESCRITURAÇÃO: "

            lLoad := self:saveEscrituracao(nI)
        endIf

    Next nI

return lLoad

//-------------------------------------------------------------------
/*/{Protheus.doc} saveEscrituracao
Método para gravar regra de escrituração no configurador

@return  lSave, Logical, retorna se a operação foi salva com sucesso
@author  Rafael Tenorio da Costa
@since   22/10/2025
@type    method
@version 12.1.2610
/*/
//-------------------------------------------------------------------
method saveEscrituracao(nEscrit) as logical class PshCargaOperandos

    local oModel := nil
    local lSave  := .F.

    oModel := FWLoadModel('FISA160J')
    oModel:SetOperation(MODEL_OPERATION_INSERT)
    oModel:Activate()

    oModel:SetValue('FISA160J','CJ2_CODIGO', self:aEscrituracao[nEscrit][1])
    oModel:SetValue('FISA160J','CJ2_DESCR' , self:aEscrituracao[nEscrit][2])
    oModel:SetValue('FISA160J','CJ2_INCIDE', self:aEscrituracao[nEscrit][3])  

    if oModel:VldData() .and. oModel:CommitData()
        lSave            := .T.
        self:cMsgSucesso += self:buildMessage("CJ2", self:aEscrituracao[nEscrit][1])
    else
        self:setErro(STR0007, oModel:GetErrorMessage())   //"Não foi possível incluir a regra de escrituração: "
    endIf

    oModel:DeActivate()
    oModel:Destroy()

    fwFreeObj(oModel)

Return lSave

//-------------------------------------------------------------------
/*/{Protheus.doc} buildRules
Monta as regras de calculo para gravacao de forma automatica no configurador de tributos

@return  aRegras, array, retorna regras
@author  Rafael Tenorio da Costa
@since   22/10/2025
@type    method
@version 12.1.2610
/*/
//-------------------------------------------------------------------
method buildRules() as array class PshCargaOperandos

    local aRegras       := {} as array
    local cCodigo       := ""
    local cDescricao    := STR0008 + DESCRICAO  //"REGRA DE CÁLCULO: "
    local cImposto      := ""
    local aImpostos     := {{"COF",1}, {"COFRET",1}, {"CSL",1}, {"FECPIC",1}, {"ICMS",1}, {"ICMSST",1}, {"IRF",1}, {"PIS",1}, {"PISRET",1}, {"CBSFED",2}, {"IBSEST",2}, {"IBSMUN",2}, {"ISFED",2}}
    local nCont         := 0
    local nTamCodigo    := tamSx3("F2B_REGRA")[1]

    for nCont:= 1 to Len(aImpostos)
        cImposto := aImpostos[nCont][1]
        cCodigo  := padR( subStr(CODIGO, 1, 2) + subStr(cImposto, 1, 4), nTamCodigo )
        if !self:loadExists("F2B", 1, cCodigo + DT_INI_VIGENCIA + DT_FIM_VIGENCIA + "2")    //F2B_FILIAL, F2B_REGRA, F2B_VIGINI, F2B_VIGFIM, F2B_ALTERA, R_E_C_N_O_, D_E_L_E_T_
            aAdd(aRegras, {cCodigo, cDescricao + " - " + cImposto, cImposto, self:aAliquotas[1][1], self:aBases[1][1], self:aEscrituracao[aImpostos[nCont][2]][1], self:aProdutos[1][1], self:aParticipantes[1][1], self:aOperacao[1], PERFIL_ORI_DES, /*cTributoMajorado*/,  DT_INI_VIGENCIA, DT_FIM_VIGENCIA, STATUS_REGRA})
        endIf
    next nCont

return aRegras

//-------------------------------------------------------------------
/*/{Protheus.doc} saveRule
Grava Regra de Calculos de forma automatica no configurador de tributos

@param   cCodRegra, character, codigo da regra de calculo (F2B_REGRA)
@param   cDesc, character, descricao regra de calculo (F2B_DESC)
@param   cTributo, character, codigo do Tributo (F2B_TRIB)
@param   cCodAliquota, character, codigo do cadastro de Aliquota (F28) (F2B_RALIQ)
@param   cCodBase, character, codigo do cadastro da Base de Calculo (F27) (F2B_RBASE)
@param   cCodEscrituracao, character, codigo do cadastro de Escrituracao (CJ2) (F2B_CODESC)
@param   cPerfilProduto, character, codigo do cadastro do Perfil do Produto (F24) (F2B_PERFPR)
@param   cPerfilParticipantes, character, codigo do cadastro do Perfil de Participante (F22) (F2B_PERFPA)
@param   cPerfilOperacao, character, codigo do cadastro do Perfil de Operacao (F23) (F2B_PERFOP)
@param   cPerfilOrigemDestino, character, codigo do cadastro do Perfil de Origem/Destino (F21) (F2B_PEROD)
@param   cTributoMajorado, character, informa tributo majorado (F2B_TRBMAJ)
@param   cVigIni, character, informa vigencia inicial da regra (F2B_VIGINI)
@param   cVigFim, character, informa vigencia final da regra (F2B_VIGFIM)
@param   cStatus, character, informa se a regra esta em teste ou producao (F2B_STATUS)
@return  lSave, logical, retorna se a regra foi salva com sucesso ou já existe uma com as mesmas caracteristicas
@author  Rafael Tenorio da Costa
@since   23/10/2025
@type    method
@version 12.1.2610
/*/
//-------------------------------------------------------------------
method saveRule(cCodRegra as character,cDesc as character,cTributo as character,cCodAliquota as character,cCodBase as character,cCodEscrituracao as character,;
                    cPerfilProduto as character,cPerfilParticipantes as character,cPerfilOperacao as character,cPerfilOrigemDestino as character,cTributoMajorado as character,;
                    cVigIni as character,cVigFim as character,cStatus as character,lForce as logical) as logical class PshCargaOperandos

    local oModel     := nil
    local cChaveSeek := ""
    local cAlias     := "F2B"
    local nOrder     := 8
    local lExiste    := .F.
    local lSave      := .T.

    default cTributoMajorado := ""
    default lForce := .F.

    oModel := FWLoadModel('FISA160')

    oModel:SetOperation(MODEL_OPERATION_INSERT)
    oModel:Activate()

    if empty(cDesc)
        cDesc := self:getDescRule(cTributo, cPerfilProduto, cPerfilParticipantes, cPerfilOperacao, cPerfilOrigemDestino)
    endIf

    oModel:SetValue('FISA160', 'F2B_TRIB'  , cTributo)
    oModel:SetValue('FISA160', 'F2B_DESC'  , cDesc)
    oModel:SetValue('FISA160', 'F2B_VIGINI', STOD(cVigIni))
    oModel:SetValue('FISA160', 'F2B_VIGFIM', STOD(cVigFim))
    oModel:SetValue('FISA160', 'F2B_RBASE' , cCodBase)
    oModel:SetValue('FISA160', 'F2B_RALIQ' , cCodAliquota)
    oModel:SetValue('FISA160', 'F2B_CODESC', cCodEscrituracao)
    oModel:SetValue('FISA160', 'F2B_PEROD' , cPerfilOrigemDestino)
    oModel:SetValue('FISA160', 'F2B_PERFPA', cPerfilParticipantes)
    oModel:SetValue('FISA160', 'F2B_PERFOP', cPerfilOperacao)
    oModel:SetValue('FISA160', 'F2B_PERFPR', cPerfilProduto)

    if !Empty(cTributoMajorado)
        oModel:SetValue('FISA160','F2B_TRBMAJ', cTributoMajorado)
    endIf

    if self:lF2BStatus
        oModel:SetValue('FISA160','F2B_STATUS', cStatus)
    endIf

    cChaveSeek := self:getRuleKey(oModel)
    cChaveSeek := self:generateMD5(cChaveSeek, .F.) + "2"

    lExiste := self:loadExists(cAlias, nOrder, cChaveSeek)

    if !lExiste .or. lForce

        if empty(cCodRegra)
            cCodRegra := self:getRuleCode()
        endIf

        oModel:SetValue('FISA160', 'F2B_REGRA' , cCodRegra)

        //Atualiza formula
        Fsa160Form(/*cCampo*/, "O:VALOR_INTEGRACAO", /*cFormulI*/, /*cFormulO*/)        

        if ( lSave := oModel:VldData() .and. oModel:CommitData() )
            self:cMsgSucesso += self:buildMessage(cAlias, cCodRegra)
        endIf
    endIf

    oModel:DeActivate()
    oModel:Destroy()
    fwFreeObj(oModel)

return lSave

//-------------------------------------------------------------------
/*/{Protheus.doc} setErro
Atualiza a propriedade cErro da classe com a mensagem de erro recebida

@param   cErro, character, descricao do erro ocorrido
@param   aModelErro, array, array com detalhes do erro retornado pelo model
@author  Rafael Tenorio da Costa
@since   23/10/2025
@type    method
@version 12.1.2610
/*/
//-------------------------------------------------------------------
method setErro(cErro as character, aModelErro as array) as variant class PshCargaOperandos

    if valType(aModelErro) == "A"
        cErro += allTrim(aModelErro[4]) + " - " + allTrim(aModelErro[6]) + " [" + allTrim(aModelErro[8]) + "]"
    endIf

    ljxjMsgErr(cErro, /*cSolucao*/, /*cRotina*/, /*xVar*/)

    self:cErro += cErro + CRLF

return nil

//-------------------------------------------------------------------
/*/{Protheus.doc} buildMessage
Monta Msg para ser informada no final do processamento da carga, mostrando todos os cadastros feitos

@param   cTipo, character, Tipo do cadastro (F22, F24, F26, F27, F28, F2B e CJ2)
@param   cCodigo, character, Codigo cadastrado
@author  Rafael Tenorio da Costa
@since   23/10/2025
@type    method
@version 12.1.2610
/*/
//-------------------------------------------------------------------
method buildMessage(cTipo as character, cCodigo as character) as character class PshCargaOperandos

    local cMensagem := ""

    if cTipo == "F26"
        cMensagem := STR0002    //"PERFIL DE OPERAÇÃO: "
    elseIf cTipo == "CJ2"
        cMensagem := STR0006    //"REGRA DE ESCRITURAÇÃO: "
    elseif cTipo == "F22"
        cMensagem := STR0009    //"PERFIL DE PARTICIPANTE: "
    elseIf cTipo == "F24"
        cMensagem := STR0010    //"PERFIL DE PRODUTO: "
    elseIf cTipo == "F27"
        cMensagem := STR0004    //"BASES DE CÁLCULO: "
    elseIf cTipo == "F28"
        cMensagem := STR0005    //"ALÍQUOTA: "
    elseIf cTipo == "F2B"
        cMensagem := STR0011    //"REGRA DE CÁLCULO: "
    endIf

    cMensagem += cCodigo + CRLF

return cMensagem

//-------------------------------------------------------------------
/*/{Protheus.doc} getSuccessMsg
Retorna a Msg para ser informada no final do processamento da carga, mostrando todos os cadastros feitos

@return  self:cMsgSucesso, character, retorna os cadastros incluidos com sucesso
@author  Rafael Tenorio da Costa
@since   23/10/2025
@type    method
@version 12.1.2610
/*/
//-------------------------------------------------------------------
method getSuccessMsg() as character class PshCargaOperandos
return iif( !empty(self:cMsgSucesso), STR0012 + CRLF + self:cMsgSucesso, "" )    //"Operandos de integracao gerados: "

//-------------------------------------------------------------------
/*/{Protheus.doc} getCfops
Retorna todos os CFOPs de Saída

@return  aCfops, array, retorna todos os CFOPs de Saída
@author  Rafael Tenorio da Costa
@since   29/10/2025
@type    method
@version 12.1.2610
/*/
//-------------------------------------------------------------------
method getCfops() as array class PshCargaOperandos

    local cCfop     := ""
    local nX        := 0
    local aDadosSX5 := fwGetSX5("13")
    local aCfops    := {}

    //Posiciono na SX5 a tabela 13 de CFOPs
    For nX := 1 to Len(aDadosSX5)

        cCfop   := alltrim(aDadosSX5[nX][3])
        
        //Somente considera CFOPs com 4 dígitos
        If Len(cCfop) == 4

            //CFOP de saída
            If left(cCfop, 1) $ "5/6/7"
                aAdd(aCfops, cCfop)
            endIf
        endIf
    Next nX

    fwFreeArray(aDadosSX5)

return aCfops
