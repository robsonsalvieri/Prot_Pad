#INCLUDE "TOTVS.CH"
#INCLUDE "TLPP-CORE.TH"
#INCLUDE "TLPP-REST.TH"

namespace totvs.protheus.retail.rmi.api.processoIniciarCargaObj

//-------------------------------------------------------------------
/*/{Protheus.doc} Classe CargaDados
    Classe para tratamento da API de Carga Dados no Varejo
*/
//-------------------------------------------------------------------
Class CargaDados From LojRestObj20

	Public Method New()             as Object
    Public Method setFields()       as Variant
    Public Method getReturn()       as Character
    Public Method GetQtd()          as Integer
    Protected Method Validation()   as Variant
    Public Method IniciarCarga()    as Variant
    Public Method execAuto()        as Variant
    

    Data cpfCnpj     as Character 
    Data ValidaTag   as Logical
    Data cFilComp   as Character
    Data Tipo       as Integer


EndClass

//-------------------------------------------------------------------
/*/{Protheus.doc} new
Método construtor da Classe

@param oWsRestObj - Objeto WSRESTFUL da API

@author  Everson S P Junior
@since   12/12/2023
@version 1.0
*/
//-------------------------------------------------------------------
Method New(oWsRestObj As Object, jParans as Json, cBody as Character) as Object Class CargaDados
    Self:cFilComp := ""
    _Super:New(oWsRestObj, jParans, cBody)
    self:setSelect("MHP")
Return self

//-------------------------------------------------------------------
/*/{Protheus.doc} setFields
Carrega os campos que serão retornados

@author  Everson S P Junior
@since   12/12/2023
@version 1.0
*/
//-------------------------------------------------------------------
Method setFields() as Variant Class CargaDados

   HmAdd(self:oFields, {"PROCESSO"             ,"MHP_CPROCE"    , "MHP_CPROCE"                           , "processo"               , "N"           , ""}               , 1, 3)
   HmAdd(self:oFields, {"QTDREGISTROS"         , ""             , "Self:GetQtd()"                        , "qtdRegistros"           , "C"           , ""}               , 1, 3)  
   HmAdd(self:oFields, {"FILIALDESTINO"        ,""              , "self:jparans['idRetaguardaLoja']"     , "filialDestino"          , "N"           , ""}               , 1, 3) 
   HmAdd(self:oFields, {"COMPARTILHAMENTO"     ,""              , "self:cFilComp"                        , "compartilhamento"       , "N"           , ""}               , 1, 3) 
   HmAdd(self:oFields, {"HORACARGA"            ,""              , "FwTimeStamp(3)"                       , "horacarga"              , "C"           , ""}               , 1, 3) 
   HmAdd(self:oFields, {"TIPO"                 ,""              , "self:Tipo"                            , "tipo"                   , "N"           , ""}               , 1, 3) 


   
Return Nil

//-------------------------------------------------------------------
/*/{Protheus.doc} Validation
Metodo para validações executado no momento do get
1
@author  Everson S P Junior
@since   14/09/2022
@version 1.0
*/
//-------------------------------------------------------------------
Method Validation(cOrigem as Character) as Variant Class CargaDados

    _Super:Validation()
    self:cFil := IIF(Empty(self:jparans['idRetaguardaLoja']),cFilAnt,self:jparans['idRetaguardaLoja'])
    self:ChangeBranch()
    If self:lSuccess

        If cOrigem == "GET"
            self:ValidaTag := .T.
            //Tags obrigatórias
            Do Case

                Case Empty(self:jparans['idRetaguardaLoja'])
                    self:lSuccess   := .F.
                    self:cError     := I18n("Ops! #1 não enviado(s) ou inválido(s).", {"idRetaguardaLoja"} )  //"Ops! #1 não enviado(s) ou inválido(s)."
                    self:ValidaTag  := .F.  
            End Case

            If self:lSuccess
                self:cSelect    := " SELECT MHP_CPROCE, MHP_CONFIG FROM "+ RetSqlName("MHP")
                self:cWhere     += " AND MHP_TIPO = '1'"
                self:cWhere     += " AND MHP_CASSIN = 'PDVSYNC'"
            EndIf
        ElseIf cOrigem == "POST"
            self:IniciarCarga()
        EndIf
    EndIf  

Return Nil

//-------------------------------------------------------------------
/*/{Protheus.doc} GetReturn
Retorna json com resultado da consulta

@author  Everson S P Junior
@since   12/12/2023
@version 1.0
*/
//-------------------------------------------------------------------
Method getReturn() as Character Class CargaDados

    Local jRetorno  as Object 
    Local cRetorno  as Character

    jRetorno:= JsonObject():New()
    jRetorno:FromJson( _Super:GetReturn() )
    
    cRetorno := EncodeUtf8( jRetorno:toJson() )

    LjGrvLog("CargaDados", "Retorno da API de Carga Dados", cRetorno)

    FwFreeObj(jRetorno)

Return cRetorno

//-------------------------------------------------------------------
/*/{Protheus.doc} GetQtd
Retorna a quantidade de registros da consulta

@author  Everson S P Junior
@since   12/12/2023
@version 1.0
*/
//-------------------------------------------------------------------
Method GetQtd() as Integer Class CargaDados
    Local cQuery := ""
    Local cTabela := GetNextAlias()
    Local cCampo  := ""
    Local nRet   := 0  
    Local cFiltro := ""     
    Local cTab    := ""
    Local oJson   := JsonObject():New() 
    
    oJson:FromJson((Self:cAliasQuery)->MHP_CONFIG)
    self:Tipo := Val(oJson["codigotipo"])
    
    Self:cFilComp := ""
    cQuery := "Select MHN_TABELA,MHN_FILTRO from "+retSqlName("MHN")+" MHN "
    cQuery += " Where MHN_COD = '"+(Self:cAliasQuery)->MHP_CPROCE+"'"
    cQuery += " AND MHN.D_E_L_E_T_ = ' ' "
    cQuery += " AND MHN.MHN_TABELA != '"+Space(TAMSX3('MHN_TABELA')[1])+"' "
    DbUseArea(.T., "TOPCONN", TcGenQry( , , cQuery), cTabela, .T., .F.)

    cCampo := IIF( subStr( (cTabela)->MHN_TABELA, 1, 1) == "S", subStr( (cTabela)->MHN_TABELA, 2), (cTabela)->MHN_TABELA ) +"_FILIAL"
    Self:cFilComp     := xFilial((cTabela)->MHN_TABELA,self:jparans['idRetaguardaLoja'])
    cTab        := (cTabela)->MHN_TABELA
    cFiltro := IIF(SubStr((cTabela)->MHN_FILTRO, 1, 1) == "&",&( AllTrim( SubStr((cTabela)->MHN_FILTRO, 2) ) ),(cTabela)->MHN_FILTRO)
    (cTabela)->( DbCloseArea())

    If !Empty(cTab)
        cTabela := GetNextAlias()
        cQuery := "SELECT Count(" + cCampo +") as QTD "
        cQuery += " FROM "+retSqlName(cTab)+" "
        cQuery += " WHERE  "+cCampo+" = '" + Self:cFilComp + "'"
        cQuery += " AND D_E_L_E_T_ = ' ' "
        cQuery += IIF(empty(cFiltro), "" , " AND "+cFiltro)
        DbUseArea(.T., "TOPCONN", TcGenQry( , , cQuery), cTabela, .T., .F.)
        nRet := (cTabela)->QTD
        (cTabela)->( DbCloseArea())
    EndIf

Return nRet
//-------------------------------------------------------------------
/*/{Protheus.doc} IniciarCarga
Inicia o processo de carga de dados

@author  Everson S P Junior
@since   12/12/2023
@version 1.0
*/
//-------------------------------------------------------------------
Method IniciarCarga() as Variant Class CargaDados
Local nx      := 1
Local lExist  := .F.

DbSelectArea("MIN")
MIN->(DbSetOrder(1)) // -- MIN_FILIAL+MIN_CPROCE+MIN_FILPUB

For nX := 1 To Len(self:jBody)
    lExist := MIN->(Dbseek(xFilial("MIN") + PadR(self:jBody[nX]["processo"],TamSX3("MIN_CPROCE")[1]) + PadR(self:jBody[nX]["compartilhamento"],TamSX3("MIN_FILPUB")[1])  ))
    If lExist .AND. MIN->MIN_STATUS == "1"
        self:lSuccess := .F.
        self:cError   += I18n("Processo #1 está em andamento de Carga. Não Pode ser selecionado novamento", {MIN->MIN_CPROCE})+CRLF //"Processo "+MIN->MIN_CPROCE+" já existe e está em andamento."
    EndIf
Next

Return


//
//-------------------------------------------------------------------
/*/{Protheus.doc} execAuto
executa a gravação dos dados de forma automática, 

@author  Everson S P Junior
@since   12/12/2023
@version 1.0
*/
//-------------------------------------------------------------------
Method execAuto() as Variant Class CargaDados
Local lInclui    := .F.
Local nX         := 1
Local aAreas     := GetArea()
Local aAreasMHP  := MHP->(GetArea("MHP"))
Local aAreasMIN  := MIN->(GetArea("MIN"))
Local nMINProce := 0
Local nMINFilpub := 0
Local nMHPCassin := 0
Local nMHPProce := 0
Local cLayfil    := ''


DbSelectArea("MIN")
MIN->(DbSetOrder(1)) // -- MIN_FILIAL+MIN_CPROCE+MIN_FILPUB

DbSelectArea("MHP")
MHP->(DbSetOrder(1))

//Pegar o tamanho antes do loopr
nMINProce := TamSX3("MIN_CPROCE")[1]
nMINFilpub := TamSX3("MIN_FILPUB")[1]
nMHPCassin := TamSX3("MHP_CASSIN")[1]
nMHPProce := TamSX3("MHP_CPROCE")[1]

For nX := 1 To Len(self:jBody)
    lInclui := !MIN->(Dbseek(xFilial("MIN") + PadR(self:jBody[nX]["processo"],nMINProce) + PadR(self:jBody[nX]["compartilhamento"],nMINFilpub)  ))

    RecLock("MIN", lInclui)
        REPLACE MIN->MIN_FILIAL WITH xFilial("MIN")
        REPLACE MIN->MIN_CPROCE WITH self:jBody[nX]["processo"]
        REPLACE MIN->MIN_ULTREC WITH ""
        REPLACE MIN->MIN_ULTPUB WITH ""         
        REPLACE MIN->MIN_FILPUB WITH self:jBody[nX]["compartilhamento"]
        REPLACE MIN->MIN_QTDTOT WITH self:jBody[nX]["qtdRegistros"]
        REPLACE MIN->MIN_LJDEST WITH IIF(Alltrim(self:jBody[nX]["filialDestino"]) == 'COMPARTILHADA',"",self:jBody[nX]["filialDestino"])
        REPLACE MIN->MIN_DTINIC	WITH FwTimeStamp(3)
        REPLACE MIN->MIN_DTFIMC	WITH ""
        REPLACE MIN->MIN_STATUS	WITH "1"
        REPLACE MIN->MIN_TIPO	WITH self:jBody[nX]["tipo"]        
    MIN->(MsUnLock())
    
    If MHP->(Dbseek( xFilial("MHP") + PadR("PDVSYNC",nMHPCassin) + PadR(self:jBody[nX]["processo"],nMHPProce) +"1" ))
        cLayfil := IIF(PadR(MIN->MIN_LJDEST,nMINFilpub)+';' $ MHP->MHP_LAYFIL,MHP->MHP_LAYFIL,Alltrim(MHP->MHP_LAYFIL)+PadR(MIN->MIN_LJDEST,nMINFilpub)+';')
        cLayfil := IIF(!Empty(MHP->MHP_LAYFIL) .AND. Alltrim(self:jBody[nX]["filialDestino"]) == 'COMPARTILHADA',MHP->MHP_LAYFIL,cLayfil)
        RecLock("MHP", .F.)
            REPLACE MHP->MHP_ATIVO WITH '1'
            REPLACE MHP->MHP_LAYFIL WITH cLayfil
        MHP->(MsUnLock())
    EndIf
Next


RestArea(aAreas)
RestArea(aAreasMHP)
RestArea(aAreasMIN)
Return
