#INCLUDE "TOTVS.CH"
#INCLUDE "TLPP-CORE.TH"
#INCLUDE "TLPP-REST.TH"

namespace totvs.protheus.retail.rmi.api.limitecompraclienteObj

//-------------------------------------------------------------------
/*/{Protheus.doc} Classe limiteCompraCliente
    Classe para tratamento da API de Limite de Compra do Cliente no Varejo
*/
//-------------------------------------------------------------------
Class LimiteCompraCliente From LojRestObj20

	Public Method New()             as Object
    Public Method setFields()       as Variant
    Public Method getReturn()       as Character
    Protected Method Validation()   as Variant
    

    Data cpfCnpj     as Character 
    Data ValidaTag   as Logical


EndClass

//-------------------------------------------------------------------
/*/{Protheus.doc} new
Método construtor da Classe

@param oWsRestObj - Objeto WSRESTFUL da API

@author  Everson S P Junior
@since   12/12/2023
@version 1.0
*/
//-------------------------------------------------------------------
Method New(oWsRestObj As Object, jParans as Json) as Object Class LimiteCompraCliente

    _Super:New(oWsRestObj, jParans, '{}')
    self:setSelect("SA1")
    
Return self

//-------------------------------------------------------------------
/*/{Protheus.doc} setFields
Carrega os campos que serão retornados

@author  Everson S P Junior
@since   12/12/2023
@version 1.0
*/
//-------------------------------------------------------------------
Method setFields() as Variant Class LimiteCompraCliente

   HmAdd(self:oFields, {"IDRETAGUARDALIMITECREDITO" , ""   , "Alltrim(A1_CGC)+'-LIMCRED'"        , "idRetaguardaLimiteCredito"                        , "C"           , ""}               , 1, 3)
   HmAdd(self:oFields, {"SALDODISPONIVEL"           , ""   , "A1_SALCRED"          , "saldoDisponivel"                                 , "N"           , ""}               , 1, 3)
   
Return Nil

//-------------------------------------------------------------------
/*/{Protheus.doc} Validation
Metodo para validações executado no momento do get
1
@author  Everson S P Junior
@since   14/09/2022
@version 1.0
*/
//-------------------------------------------------------------------
Method Validation(cOrigem as Character) as Variant Class LimiteCompraCliente

    _Super:Validation()
    self:cFil := IIF(Empty(self:jparans['idRetaguardaLoja']),cFilAnt,self:jparans['idRetaguardaLoja'])
    self:ChangeBranch()
    If self:lSuccess

        If cOrigem == "GET"
            self:ValidaTag := .T.
            //Tags obrigatórias
            Do Case

                Case Empty(self:jparans['idRetaguardaLoja'])
                    self:lSuccess   := .F.
                    self:cError     := I18n("Ops! #1 não enviado(s) ou inválido(s).", {"idRetaguardaLoja"} )  //"Ops! #1 não enviado(s) ou inválido(s)."
                    self:ValidaTag  := .F.  
                Case Empty(self:jparans['cpfCnpj'])
                    self:lSuccess   := .F.
                    self:cError     := I18n("Ops! #1 não enviado(s) ou inválido(s).", {"cpfCnpj"} )  //"Ops! #1 não enviado(s) ou inválido(s)."
                    self:ValidaTag  := .F.
            End Case

            If self:lSuccess
                Self:cpfCnpj := IIF(Valtype(self:jparans['cpfCnpj']) == "N", PADR(str(self:jparans['cpfCnpj']),TAMSX3("A1_CGC")[1]), PADR(self:jparans['cpfCnpj'],TAMSX3("A1_CGC")[1]))
                self:cSelect    := "SELECT A1_CGC, GREATEST(0, SUM(A1_LC) - SUM(A1_SALDUP)) AS A1_SALCRED FROM " + RetSqlName("SA1")
                self:cWhere     += " AND A1_CGC = '" + self:cpfCnpj + "'"
                self:cWhere     += " AND A1_FILIAL = '"+xFilial('SA1')+"'"
                self:cWhere     += " AND D_E_L_E_T_ = ' '"
                self:cGroupBy   := " GROUP BY A1_CGC"
            EndIf
        EndIf
    EndIf

Return Nil

//-------------------------------------------------------------------
/*/{Protheus.doc} GetReturn
Retorna json com resultado da consulta

@author  Everson S P Junior
@since   12/12/2023
@version 1.0
*/
//-------------------------------------------------------------------
Method getReturn() as Character Class LimiteCompraCliente

    Local jRetorno  as Object 
    Local cRetorno  as Character

    jRetorno:= JsonObject():New()
    jRetorno:FromJson( _Super:GetReturn() )
    
    cRetorno := EncodeUtf8( jRetorno:toJson() )

    LjGrvLog("LimiteCompraCliente", "Retorno da API de Limite Compra Cliente", cRetorno)

    FwFreeObj(jRetorno)

Return cRetorno
