#INCLUDE "TOTVS.CH"
#INCLUDE "TLPP-CORE.TH"
#INCLUDE "TLPP-REST.TH"

namespace totvs.protheus.retail.rmi.api.limitecompraclientedetailObj

Static lfunc	:= FindFunction("PSHDtLiCOM") 
//-------------------------------------------------------------------
/*/{Protheus.doc} Classe limiteCompraClientedetail
     Classe para tratamento da API de Detalhamento do Limite de Compra do Cliente no Varejo
    Classe para tratamento da API de Limite de Compra do Cliente no Varejo
*/
//-------------------------------------------------------------------
Class LimiteCompraClientedetail From LojRestObj20

	Public Method New()             as Object
    Public Method setFields()       as Variant
    Public Method getReturn()       as Character
    Protected Method Validation()   as Variant
    Public Method setDetalhe(cFilLoja, cpfCnpj) as Variant
    Public Method getDetalhe(nRet) as Variant
    

    Data cpfCnpj            as Character 
    Data ValidaTag          as Logical
    Data valorTotal         as Numeric
    Data valorUtilizado     as Numeric
    Data saldoDisponivel    as Numeric
    Data oDetalhe           as array


EndClass

//-------------------------------------------------------------------
/*/{Protheus.doc} new
Método construtor da Classe

@param oWsRestObj - Objeto WSRESTFUL da API

@author  Everson S P Junior
@since   12/12/2023
@version 1.0
*/
//-------------------------------------------------------------------
Method New(oWsRestObj As Object, jParans as Json) as Object Class LimiteCompraClientedetail

    _Super:New(oWsRestObj, jParans, '{}')
    self:setSelect("SA1")
    
Return self

//-------------------------------------------------------------------
/*/{Protheus.doc} setFields
Carrega os campos que serão retornados
//{self:saldoDisponivel, self:valorUtilizado, self:valorTotal, oDetalhe}
@author  Everson S P Junior
@since   12/12/2023
@version 1.0
*/
//-------------------------------------------------------------------
Method setFields() as Variant Class LimiteCompraClientedetail
   HmAdd(self:oFields, {"IDRETAGUARDALIMITECREDITO" , ""   , "A1_COD+'-LIMCRED'"                         , "idRetaguardaLimiteCredito"                        , "C"           , ""}               , 1, 3)
   HmAdd(self:oFields, {"SALDODISPONIVEL"           , ""   , "self:getDetalhe(1)"                     , "saldoDisponivel"             , "N"           , ""}               , 1, 3)
   HmAdd(self:oFields, {"VALORUTILIZADO"            , ""   , "Self:getDetalhe(2)"                      , "valorUtilizado"              , "N"           , ""}               , 1, 3)
   HmAdd(self:oFields, {"VALORTOTAL"                , ""   , "self:getDetalhe(3)"                          , "valorTotal"                  , "N"           , ""}               , 1, 3)
   HmAdd(self:oFields, {"DETALHESVALORUTILIZADO"    , ""   , "self:getDetalhe(4)"                                         , "detalhesValorUtilizado"      , "C"           , ""}               , 1, 3) 
   
   
   

Return Nil

//-------------------------------------------------------------------
/*/{Protheus.doc} Validation
Metodo para validações executado no momento do get
1
@author  Everson S P Junior
@since   14/09/2022
@version 1.0
*/
//-------------------------------------------------------------------
Method Validation(cOrigem as Character) as Variant Class LimiteCompraClientedetail

    _Super:Validation()
    self:cFil := IIF(Empty(self:jparans['idRetaguardaLoja']),cFilAnt,self:jparans['idRetaguardaLoja'])
    self:ChangeBranch()
    If self:lSuccess

        If cOrigem == "GET"
            self:ValidaTag := .T.
            //Tags obrigatórias
            Do Case

                Case Empty(self:jparans['idRetaguardaLoja'])
                    self:lSuccess   := .F.
                    self:cError     := I18n("Ops! #1 não enviado(s) ou inválido(s).", {"idRetaguardaLoja"} )  //"Ops! #1 não enviado(s) ou inválido(s)."
                    self:ValidaTag  := .F.  
                Case Empty(self:jparans['cpfCnpj'])
                    self:lSuccess   := .F.
                    self:cError     := I18n("Ops! #1 não enviado(s) ou inválido(s).", {"cpfCnpj"} )  //"Ops! #1 não enviado(s) ou inválido(s)."
                    self:ValidaTag  := .F.
            End Case

            If self:lSuccess
                Self:cpfCnpj := IIF(Valtype(self:jparans['cpfCnpj']) == "N", PADR(str(self:jparans['cpfCnpj']),TAMSX3("A1_CGC")[1]), PADR(self:jparans['cpfCnpj'],TAMSX3("A1_CGC")[1]))
                self:nPageSize  := 1
                self:nPage      := 1
                self:cSelect    := "SELECT A1_COD FROM " + RetSqlName("SA1")
                self:cGroupBy   := "GROUP BY A1_COD"
                self:cWhere     += " AND A1_FILIAL = '"+xFilial('SA1')+"'"
                self:cWhere     += " AND A1_CGC = '" + self:cpfCnpj+"'"
        
            EndIf
        EndIf
    EndIf

Return Nil

//-------------------------------------------------------------------
/*/{Protheus.doc} GetReturn
Retorna json com resultado da consulta

@author  Everson S P Junior
@since   12/12/2023
@version 1.0
*/
//-------------------------------------------------------------------
Method getReturn() as Character Class LimiteCompraClientedetail

    Local jRetorno  as Object 
    Local cRetorno  as Character

    jRetorno:= JsonObject():New()
    jRetorno:FromJson( _Super:GetReturn() )
    
    cRetorno := EncodeUtf8( jRetorno:toJson() )

    LjGrvLog("LimiteCompraClientedetail", "Retorno da API de Limite Compra Cliente", cRetorno)

    FwFreeObj(jRetorno)

Return cRetorno
//-------------------------------------------------------------------
/*/{Protheus.doc} setDetalhe
prepara o campo detalhesValorUtilizado 
para detalhar os valores utilizados do limite de compra do cliente

@author  Everson S P Junior
@since   11/03/2026
@version 1.0
*/
//-------------------------------------------------------------------
Method setDetalhe(cFilLoja, cpfCnpj) as Variant Class LimiteCompraClientedetail
    Local nx       := 1
    Local aDados   := IIF(lfunc, PSHDtLiCOM(cFilLoja, cpfCnpj), {})
    
    self:oDetalhe := {}
    If Len(aDados) > 0 .AND. Len(aDados[1]) >= 3 
        self:saldoDisponivel := aDados[1][1]
        self:valorUtilizado  := aDados[1][2]
        self:valorTotal      := aDados[1][3]
              
        If Len(aDados[1]) == 4 .And. ValType(aDados[1][4]) == "A"
            For nx:=1 To Len(aDados[1][4])
                aadd(self:oDetalhe, JsonObject():New())
                self:oDetalhe[nX]['total']    := aDados[1][4][nX][1]
                self:oDetalhe[nX]['tipo']     := aDados[1][4][nX][2]
            End
        EndIf    
    EndIf 
Return Nil

//-------------------------------------------------------------------
/*/{Protheus.doc} setDetalhe
prepara o campo detalhesValorUtilizado 
para detalhar os valores utilizados do limite de compra do cliente

@author  Everson S P Junior
@since   11/03/2026
@version 1.0
*/
//-------------------------------------------------------------------
Method getDetalhe(nRet) as Variant Class LimiteCompraClientedetail
Local aRet := {"self:saldoDisponivel", "self:valorUtilizado", "self:valorTotal", "self:oDetalhe"}


If &(aRet[nRet]) == Nil
    self:setDetalhe(self:cFil,Self:cpfCnpj)
EndIf    

Return &(aRet[nRet])
