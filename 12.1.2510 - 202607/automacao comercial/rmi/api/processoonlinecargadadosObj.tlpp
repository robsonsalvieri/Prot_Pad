#INCLUDE "TOTVS.CH"
#INCLUDE "TLPP-CORE.TH"
#INCLUDE "TLPP-REST.TH"

namespace totvs.protheus.retail.rmi.api.processoonlinecargadadosObj

//-------------------------------------------------------------------
/*/{Protheus.doc} Classe ProcessoOnlineCargaDados
    Classe para tratamento da API de Processo Online Carga Dados no Varejo
*/
//-------------------------------------------------------------------
Class ProcessoOnlineCargaDados From LojRestObj20

	Public Method New()             as Object
    Public Method setFields()       as Variant
    Public Method getReturn()       as Character
    Protected Method Validation()   as Variant
    

    Data cpfCnpj     as Character 
    Data ValidaTag   as Logical


EndClass

//-------------------------------------------------------------------
/*/{Protheus.doc} new
Método construtor da Classe

@param oWsRestObj - Objeto WSRESTFUL da API

@author  Everson S P Junior
@since   12/12/2023
@version 1.0
*/
//-------------------------------------------------------------------
Method New(oWsRestObj As Object, jParans as Json) as Object Class ProcessoOnlineCargaDados

    _Super:New(oWsRestObj, jParans, '{}')
    self:setSelect("MIN")
    
Return self

//-------------------------------------------------------------------
/*/{Protheus.doc} setFields
Carrega os campos que serão retornados

@author  Everson S P Junior
@since   12/12/2023
@version 1.0
*/
//-------------------------------------------------------------------
Method setFields() as Variant Class ProcessoOnlineCargaDados

   HmAdd(self:oFields, {"TIPO"              ,   "MIN_TIPO"     , "MIN_TIPO"                                   , "tipo"                , "N"           , ""}               , 1, 3)
   HmAdd(self:oFields, {"DATAINICIO"        ,   "MIN_DTINIC"   , "Alltrim(MIN_DTINIC)"                        , "dataInicio"          , "C"           , ""}               , 1, 3)
   HmAdd(self:oFields, {"TOTALREGISTROS"    ,   "MIN_QTDTOT"   , "MIN_QTDTOT"                                 , "totalRegistros"      , "N"           , ""}               , 1, 3)
   
Return Nil

//-------------------------------------------------------------------
/*/{Protheus.doc} Validation
Metodo para validações executado no momento do get
1
@author  Everson S P Junior
@since   14/09/2022
@version 1.0
*/
//-------------------------------------------------------------------
Method Validation(cOrigem as Character) as Variant Class ProcessoOnlineCargaDados

    _Super:Validation()
    self:cFil := IIF(Empty(self:jparans['idRetaguardaLoja']),cFilAnt,self:jparans['idRetaguardaLoja'])
    self:ChangeBranch()
    If self:lSuccess

        If cOrigem == "GET"
            self:ValidaTag := .T.
            //Tags obrigatórias
            Do Case

                Case Empty(self:jparans['idRetaguardaLoja'])
                    self:lSuccess   := .F.
                    self:cError     := I18n("Ops! #1 não enviado(s) ou inválido(s).", {"idRetaguardaLoja"} )  //"Ops! #1 não enviado(s) ou inválido(s)."
                    self:ValidaTag  := .F.  
            End Case

            If self:lSuccess
                self:cWhere     += " AND MIN_LJDEST = '" + self:cFil + "'"
            EndIf
        EndIf
    EndIf

Return Nil

//-------------------------------------------------------------------
/*/{Protheus.doc} GetReturn
Retorna json com resultado da consulta

@author  Everson S P Junior
@since   12/12/2023
@version 1.0
*/
//-------------------------------------------------------------------
Method getReturn() as Character Class ProcessoOnlineCargaDados

    Local jRetorno  as Object 
    Local cRetorno  as Character

    jRetorno:= JsonObject():New()
    jRetorno:FromJson( _Super:GetReturn() )
    
    cRetorno := EncodeUtf8( jRetorno:toJson() )

    LjGrvLog("ProcessoOnlineCargaDados", "Retorno da API de Processo Online Carga Dados", cRetorno)

    FwFreeObj(jRetorno)

Return cRetorno
