#INCLUDE "TLPP-CORE.TH"
#INCLUDE "TLPP-REST.TH"

namespace totvs.protheus.retail.rmi.api.limitecompracliente

using namespace totvs.protheus.retail.rmi.api.limitecompraclienteObj
using namespace totvs.protheus.retail.rmi.api.limitecompraclientedetailObj

//-------------------------------------------------------------------
/*/{Protheus.doc}
    API para consulta de limite de compra do cliente no Varejo 
/*/
//-------------------------------------------------------------------

/* ----------------------------------------- */
@Get("api/retail/v1/limitecompracliente")
Function Pshlimcomcli()
Local jHeader       := oRest:getHeaderRequest()
Local jParams       := oRest:getQueryRequest()
Local olimite       := nil 

jParams['cpfCnpj'] := jHeader['cpfCnpj']

olimite := LimiteCompraCliente():New( oRest, oRest:getQueryRequest())
olimite:Get()

Return oRest:setResponse( olimite:getReturn() )
//-------------------------------------------------------------------
/*/{Protheus.doc}
    API para consulta de limite de compra do cliente no Varejo - Detalhada
/*/
//-------------------------------------------------------------------

/* ----------------------------------------- */
@Get("api/retail/v1/limitecompraclientedetail")
Function PshComdetail()
Local jHeader       := oRest:getHeaderRequest()
Local jParams       := oRest:getQueryRequest()
Local olimite       := nil 

jParams['cpfCnpj'] := jHeader['cpfCnpj']

olimite := LimiteCompraClientedetail():New( oRest, oRest:getQueryRequest())
olimite:Get()

Return oRest:setResponse( olimite:getReturn() )
