#INCLUDE "TLPP-CORE.TH"
#INCLUDE "TLPP-REST.TH"

namespace totvs.protheus.retail.rmi.api.processoIniciarCargaAPI

using namespace totvs.protheus.retail.rmi.api.processoIniciarCargaObj

//-------------------------------------------------------------------
/*/{Protheus.doc}
    API para consulta de processo online de carga de dados no Varejo 
/*/
//-------------------------------------------------------------------

/* ----------------------------------------- */
@Get("api/retail/v1/cargadados/processos")
Function PshApiCargaDados()
Local oGet          := nil 
Local jParams       := oRest:getQueryRequest()

oGet := CargaDados():New( oRest, jParams,'{}')
oGet:Get()

Return oRest:setResponse(oGet:getReturn())

/* ----------------------------------------- */
/*/API para iniciar processo online de carga de dados no Varejo 
/* ----------------------------------------- */
@Post("api/retail/v1/cargadados/iniciarcargadados")
Function PshApiIniciarCarga()
Local oPost          := nil 

oPost := CargaDados():New(oRest, oRest:getQueryRequest(), oRest:getBodyRequest())
oPost:Post()

Return oRest:setResponse(oPost:getReturn())

