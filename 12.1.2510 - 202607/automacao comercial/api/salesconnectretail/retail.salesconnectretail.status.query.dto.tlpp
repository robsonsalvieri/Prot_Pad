#include "totvs.ch"
#include "tlpp-core.th"
#include "retail.salesconnectretail.status.query.dto.ch"

namespace totvs.protheus.retail.salesconnectretail.dto

/*/{Protheus.doc} SalesConnectRetailStatusQueryDto
DTO dos parametros de consulta (query string) para GET /api/retail/v1/SalesConnectRetail/status/.
@author Thalys Augusto Alves Juvenal
@since  09/06/2026
@version 1.0
@type class
/*/
Class SalesConnectRetailStatusQueryDto
    Public Data cBranch         as Character
    Public Data cDocumentNumber as Character
    Public Data cFiscalNumber   as Character
    Public Data cAccessKey      as Character
    Public Data cIssueDate      as Character
    Public Data cOrder          as Character
    Public Data nPage           as Numeric
    Public Data nPageSize       as Numeric

    Public Method New() as Object
    Public Method fromJson(cJson as Character) as Object
    Public Method hasFilter() as Logical
    Protected Method QStr(oJson as Json, cKey as Character) as Character
EndClass

/*/{Protheus.doc} QStr
Le um texto do JsonObject tolerando chave AUSENTE: neste build o GetJsonText
de uma chave inexistente retorna a string "null" — normaliza para "" (+ AllTrim).
Sem isso, filtros opcionais ausentes viram "L1_xxx = 'null'" e nao casam nada.
@param oJson, json,      JsonObject (tipo J - usar 'as Json'; 'as Object' gera mismatch O->J)
@param cKey,  character, chave a ler
@return character, valor (ou "" se ausente / "null")
@type method
@author Thalys Augusto Alves Juvenal
@since  09/06/2026
/*/
Method QStr(oJson as Json, cKey as Character) as Character Class SalesConnectRetailStatusQueryDto
    Local cVal := oJson:GetJsonText(cKey)
    If ValType(cVal) != "C" .Or. cVal == "null"
        cVal := ""
    EndIf
Return AllTrim(cVal)

/*/{Protheus.doc} New
Construtor: inicializa filtros vazios e paginacao default (page 1, pageSize 20).
@type method
@author Thalys Augusto Alves Juvenal
@since  09/06/2026
@return object, Self
/*/
Method New() as Object Class SalesConnectRetailStatusQueryDto
    ::cBranch         := ""
    ::cDocumentNumber := ""
    ::cFiscalNumber   := ""
    ::cAccessKey      := ""
    ::cIssueDate      := ""
    ::cOrder          := ""
    ::nPage           := 1
    ::nPageSize       := 20
Return Self

/*/{Protheus.doc} fromJson
Desserializa a query string (em JSON) preenchendo filtros e paginacao. Lanca
erro (Throw) em JSON invalido, capturavel pelo Try/Catch do chamador
(SalesConnectRetailStatusObj:ParseQuery).
@type method
@author Thalys Augusto Alves Juvenal
@since  09/06/2026
@param cJson, character, query string serializada como JSON
@return object, Self
/*/
Method fromJson(cJson as Character) as Object Class SalesConnectRetailStatusQueryDto
    Local oJson   as Json
    Local cErr    as Character
    Local nVal    as Numeric
    Local oError  as Object

    oJson := JsonObject():New()
    cErr  := oJson:fromJson(cJson)
    If !Empty(cErr)
        oError := ErrorClass():New()
        oError:description := STR0001 + cErr   // "SalesConnectRetailStatusQueryDto: JSON invalido - "
        Throw oError
    EndIf
    ::cBranch         := ::QStr(oJson, "branch")
    ::cDocumentNumber := ::QStr(oJson, "documentNumber")
    ::cFiscalNumber   := ::QStr(oJson, "fiscalNumber")
    ::cAccessKey      := ::QStr(oJson, "accessKey")
    ::cIssueDate      := ::QStr(oJson, "issueDate")
    ::cOrder          := ::QStr(oJson, "order")
    nVal := Val(::QStr(oJson, "page"))
    If nVal > 0
        ::nPage := nVal
    EndIf
    nVal := Val(::QStr(oJson, "pageSize"))
    If nVal > 0
        ::nPageSize := nVal
    EndIf
Return Self

/*/{Protheus.doc} hasFilter
Indica se ao menos um filtro de negocio discriminante foi informado
(documentNumber, fiscalNumber, accessKey ou issueDate). Usado para barrar
consulta sem filtro (full-table scan) -> codigo 0007.
@type   method
@author Thalys Augusto Alves Juvenal
@since  09/06/2026
@return logical, .T. se houver pelo menos um filtro discriminante
/*/
Method hasFilter() as Logical Class SalesConnectRetailStatusQueryDto
    // cBranch e cOrder sao intencionalmente excluidos: cBranch vem do header tenantId (nao e
    // filtro de negocio discriminante) e cOrder e apenas ordenacao. Checar so documentNumber/
    // fiscalNumber/accessKey/issueDate previne full-table scan conforme spec.
Return !Empty(::cDocumentNumber) .Or. !Empty(::cFiscalNumber) .Or. !Empty(::cAccessKey) .Or. !Empty(::cIssueDate)
