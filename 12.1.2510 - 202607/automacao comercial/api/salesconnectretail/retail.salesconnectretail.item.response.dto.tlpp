#include "totvs.ch"
#include "tlpp-core.th"

namespace totvs.protheus.retail.salesconnectretail.dto

/*/{Protheus.doc} SalesConnectRetailItemResponseDto
DTO de status individual de 1 cupom no batch response (CA #19 V2).
Chaves JSON expostas: accessKey, branch, documentNumber, status, message.

@author  Thalys Augusto Alves Juvenal
@since   20/05/2026
@version 2.0
@type class
/*/
Class SalesConnectRetailItemResponseDto
    Public Data cKeyNfce   as Character
    Public Data cCodFil    as Character
    Public Data cNumero    as Character
    Public Data cStatusVda as Character
    Public Data cRetorno   as Character

    Public Method New(cKeyNfce as Character, cCodFil as Character, cNumero as Character, cStatusVda as Character, cRetorno as Character) as Object
    Public Method toJsonObject() as Json
    Public Method toJson() as Character
EndClass

/*/{Protheus.doc} New
Construtor do item de status de 1 cupom. Cada parametro vazio/nao-Character e
normalizado ("" ou "Error" para status).
@type   method
@author Thalys Augusto Alves Juvenal
@since  20/05/2026
@param  cKeyNfce,   character, chave de acesso NFC-e/NF-e (accessKey)
@param  cCodFil,    character, filial gravada (branch)
@param  cNumero,    character, numero do documento (documentNumber)
@param  cStatusVda, character, status do cupom ("Success"/"Error")
@param  cRetorno,   character, mensagem de retorno (message)
@return object, Self
/*/
Method New(cKeyNfce as Character, cCodFil as Character, cNumero as Character, cStatusVda as Character, cRetorno as Character) as Object Class SalesConnectRetailItemResponseDto
    Default cKeyNfce   := ""
    Default cCodFil    := ""
    Default cNumero    := ""
    Default cStatusVda := "Error"
    Default cRetorno   := ""

    ::cKeyNfce   := cKeyNfce
    ::cCodFil    := cCodFil
    ::cNumero    := cNumero
    ::cStatusVda := cStatusVda
    ::cRetorno   := cRetorno
Return Self

/*/{Protheus.doc} toJsonObject
Monta e retorna o JsonObject do item (sem serializar para string), para o
envelope do batch agregar diretamente sem ida-e-volta toJson/fromJson.
@return object, JsonObject com accessKey/branch/documentNumber/status/message
@type method
@author Thalys Augusto Alves Juvenal
@since  20/05/2026
/*/
Method toJsonObject() as Json Class SalesConnectRetailItemResponseDto
    Local oJson as Json
    oJson := JsonObject():New()
    oJson["accessKey"]      := ::cKeyNfce
    oJson["branch"]         := ::cCodFil
    oJson["documentNumber"] := ::cNumero
    oJson["status"]         := ::cStatusVda
    oJson["message"]        := ::cRetorno
Return oJson

/*/{Protheus.doc} toJson
Serializa o item em string JSON (delega ao toJsonObject).
@type   method
@author Thalys Augusto Alves Juvenal
@since  20/05/2026
@return character, JSON { accessKey, branch, documentNumber, status, message }
/*/
Method toJson() as Character Class SalesConnectRetailItemResponseDto
Return ::toJsonObject():toJson()
