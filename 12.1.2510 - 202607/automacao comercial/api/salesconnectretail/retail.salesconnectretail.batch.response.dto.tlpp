#include "totvs.ch"
#include "tlpp-core.th"

namespace totvs.protheus.retail.salesconnectretail.dto

/*/{Protheus.doc} SalesConnectRetailBatchResponseDto
Envelope do response do POST batch (CA #19 V2). Contem um resumo de
contagem (total enviado / sucesso / erro) e o array de
SalesConnectRetailItemResponseDto, um por cupom processado.

Estrutura JSON:
  { "totalReceived": 40,
    "totalSuccess":  38,
    "totalError":    2,
    "results": [
      { "accessKey": "...", "branch": "...", "documentNumber": "...",
        "status": "Success|Error", "message": "..." },
      ...
    ] }

@author  Thalys Augusto Alves Juvenal
@since   20/05/2026
@version 2.1
@type class
/*/
Class SalesConnectRetailBatchResponseDto
    Protected Data aResultados as Array

    Public Method New() as Object
    Public Method addResult(oItem as Object) as Object
    Public Method toJson() as Character
EndClass

/*/{Protheus.doc} New
Construtor do envelope de response do batch. Inicializa o array de resultados vazio.
@type   method
@author Thalys Augusto Alves Juvenal
@since  20/05/2026
@return object, Self
/*/
Method New() as Object Class SalesConnectRetailBatchResponseDto
    ::aResultados := {}
Return Self

/*/{Protheus.doc} addResult
Adiciona um SalesConnectRetailItemResponseDto (resultado de 1 cupom) ao envelope.
@type   method
@author Thalys Augusto Alves Juvenal
@since  20/05/2026
@param  oItem, object, SalesConnectRetailItemResponseDto do cupom processado
@return object, Self
/*/
Method addResult(oItem as Object) as Object Class SalesConnectRetailBatchResponseDto
    AAdd(::aResultados, oItem)
Return Self

/*/{Protheus.doc} toJson
Serializa o envelope em JSON, calculando o resumo de contagem
(totalReceived/totalSuccess/totalError) e agregando os itens em results[].
@type   method
@author Thalys Augusto Alves Juvenal
@since  20/05/2026
@return character, JSON { totalReceived, totalSuccess, totalError, results[] }
/*/
Method toJson() as Character Class SalesConnectRetailBatchResponseDto
    Local oJson       as Object
    Local aJsonArr    as Array
    Local nI          as Numeric
    Local oItem       as Object
    Local nTotal      as Numeric
    Local nSucesso    as Numeric
    Local nErro       as Numeric

    oJson    := JsonObject():New()
    aJsonArr := {}
    nTotal   := Len(::aResultados)
    nSucesso := 0
    nErro    := 0

    For nI := 1 To nTotal
        oItem := ::aResultados[nI]
        // monta o JsonObject direto do item (sem ida-e-volta toJson/fromJson)
        AAdd(aJsonArr, oItem:toJsonObject())

        If Upper(AllTrim(oItem:cStatusVda)) == "SUCCESS"
            nSucesso++
        Else
            nErro++
        EndIf
    Next nI

    // Resumo no topo do envelope para conciliacao imediata pelo IPaaS
    oJson["totalReceived"] := nTotal
    oJson["totalSuccess"]  := nSucesso
    oJson["totalError"]    := nErro
    oJson["results"]       := aJsonArr
Return oJson:toJson()
