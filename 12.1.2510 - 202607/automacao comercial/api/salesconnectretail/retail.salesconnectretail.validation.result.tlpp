#include "totvs.ch"
#include "tlpp-core.th"

namespace totvs.protheus.retail.salesconnectretail.obj

/*/{Protheus.doc} SalesConnectRetailValidationResult
DTO interno de resultados de validacao (bad request ou duplicidade) usado
pelo SalesConnectRetailObj para sinalizar sucesso/falha de validacao com codigo
e mensagem associados.

Campos:
  isValid : .T. = passou; .F. = falhou
  code    : codigo da falha (ex: "0001", "0003", "0005")
  message : mensagem descritiva

@author Thalys Augusto Alves Juvenal
@since  18/05/2026
@version 1.0
@type class
/*/
Class SalesConnectRetailValidationResult
    Public Data isValid as Logical
    Public Data code    as Character
    Public Data message as Character
    Public Method New(lValid as Logical, cCode as Character, cMessage as Character) as Object
EndClass

/*/{Protheus.doc} New
Construtor do resultado de validacao.
@type   method
@author Thalys Augusto Alves Juvenal
@since  18/05/2026
@param  lValid,   logical,   .T. validacao passou; .F. falhou
@param  cCode,    character, codigo da falha (ex: "0001", "0003"); "" quando valido
@param  cMessage, character, mensagem descritiva; "" quando valido
@return object, Self
/*/
Method New(lValid as Logical, cCode as Character, cMessage as Character) as Object Class SalesConnectRetailValidationResult
    ::isValid := lValid
    ::code    := cCode
    ::message := cMessage
Return Self
