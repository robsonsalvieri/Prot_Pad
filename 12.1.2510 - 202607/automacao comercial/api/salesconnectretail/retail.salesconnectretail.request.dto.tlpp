#include "totvs.ch"
#include "tlpp-core.th"
#include "retail.salesconnectretail.request.dto.ch"

namespace totvs.protheus.retail.salesconnectretail.dto

/*/{Protheus.doc} SalesConnectRetailRequestDto
DTO do payload de request (1 cupom) para POST /api/retail/v1/SalesConnectRetail/.
@author Thalys Augusto Alves Juvenal
@since  18/05/2026
@version 1.0
@type class
/*/
Class SalesConnectRetailRequestDto
    Public Data cCodFil            as Character
    Public Data nModeloFiscal      as Numeric
    Public Data cXmlSefazBase64    as Character
    Public Data cCodigoCliente     as Character
    Public Data cLojaCliente       as Character
    Public Data cCpfCnpjConsumidor as Character
    Public Data cVendaData         as Character
    Public Data cSerieNota         as Character
    Public Data cIdCaixa           as Character
    Public Data cChaveAcesso       as Character
    Public Data oOperador          as Object
    Public Data oVendaCustodiaXml  as Object
    Public Data aPagamentos        as Array
    Public Data oAtributosComplementares as Object
    Public Data aAtributosComplementaresItens as Array

    Public Method New() as Object
    Public Method fromJson(cJson as Character) as Object
EndClass

/*/{Protheus.doc} New
Construtor: inicializa as colecoes (pagamentos e atributos de item) vazias.
@type method
@author Thalys Augusto Alves Juvenal
@since  18/05/2026
@return object, Self
/*/
Method New() as Object Class SalesConnectRetailRequestDto
    ::aPagamentos := {}
    ::aAtributosComplementaresItens := {}
Return Self

/*/{Protheus.doc} fromJson
Desserializa o JSON do cupom nos campos do DTO. Lanca erro (Throw) em JSON
invalido, capturavel pelo Try/Catch do chamador (SalesConnectRetailObj:ParseRequest).
@type method
@author Thalys Augusto Alves Juvenal
@since  18/05/2026
@param cJson, character, payload JSON cru do cupom
@return object, Self
/*/
Method fromJson(cJson as Character) as Object Class SalesConnectRetailRequestDto
    Local oJson   as Object
    Local cErr    as Character
    Local oError  as Object

    oJson := JsonObject():New()
    cErr  := oJson:fromJson(cJson)
    If !Empty(cErr)
        oError := ErrorClass():New()
        oError:description := STR0001 + cErr   // "SalesConnectRetailRequestDto: JSON invalido - "
        Throw oError
    EndIf
    // branch NAO e mais lido do body (DVARPV-6451): a filial vem do header
    // tenantId. O campo branch existe apenas no response (results[].branch).
    ::nModeloFiscal      := Val(oJson:GetJsonText("fiscalModel"))
    ::cXmlSefazBase64    := oJson:GetJsonText("xmlSefazBase64")
    ::cCodigoCliente     := oJson:GetJsonText("customerCode")
    ::cLojaCliente       := oJson:GetJsonText("customerStore")
    ::cCpfCnpjConsumidor := oJson:GetJsonText("consumerTaxId")
    ::cVendaData         := oJson:GetJsonText("saleDate")
    ::cSerieNota         := oJson:GetJsonText("documentSeries")
    ::cIdCaixa           := oJson:GetJsonText("posId")
    ::cChaveAcesso       := oJson:GetJsonText("accessKey")
    ::oOperador          := oJson["operator"]
    ::oVendaCustodiaXml  := oJson["authorization"]
    ::aPagamentos        := oJson["payments"]
    ::oAtributosComplementares := oJson["extraAttributes"]
    If ValType(oJson["itemExtraAttributes"]) == "A"
        ::aAtributosComplementaresItens := oJson["itemExtraAttributes"]
    Else
        ::aAtributosComplementaresItens := {}
    EndIf
Return Self
