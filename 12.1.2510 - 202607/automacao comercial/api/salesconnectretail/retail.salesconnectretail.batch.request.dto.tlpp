#include "totvs.ch"
#include "tlpp-core.th"
#include "retail.salesconnectretail.batch.request.dto.ch"

namespace totvs.protheus.retail.salesconnectretail.dto

/*/{Protheus.doc} SalesConnectRetailBatchRequestDto
Envelope do request POST batch (CA #19 V2). Contem array de JSONs
brutos (1 por cupom). A desserializacao individual em
SalesConnectRetailRequestDto acontece dentro de SalesConnectRetailObj para
isolar erros de parse por cupom.

Estrutura JSON:
  { "coupons": [
      { "fiscalModel": 65, "xmlSefazBase64": "...", ... },
      ...
    ] }

@author  Thalys Augusto Alves Juvenal
@since   20/05/2026
@version 2.0
@type class
/*/
Class SalesConnectRetailBatchRequestDto
    Public Data aCupons as Array

    Public Method New() as Object
    Public Method fromJson(cJson as Character) as Object
EndClass

/*/{Protheus.doc} New
Construtor: inicializa o array de cupons vazio.
@type method
@author Thalys Augusto Alves Juvenal
@since  20/05/2026
@return object, Self
/*/
Method New() as Object Class SalesConnectRetailBatchRequestDto
    ::aCupons := {}
Return Self

/*/{Protheus.doc} fromJson
Desserializa o envelope { "coupons": [...] } populando ::aCupons com os JSONs
brutos de cada cupom. Lanca erro (Throw) em JSON invalido ou coupons[] ausente,
capturavel pelo Try/Catch do chamador (SalesConnectRetailBatchObj:ParseEnvelope).
@type method
@author Thalys Augusto Alves Juvenal
@since  20/05/2026
@param cJson, character, payload JSON cru do batch
@return object, Self
/*/
Method fromJson(cJson as Character) as Object Class SalesConnectRetailBatchRequestDto
    Local oJson       as Object
    Local cErr        as Character
    Local oError      as Object

    oJson := JsonObject():New()
    cErr  := oJson:fromJson(cJson)
    If !Empty(cErr)
        oError := ErrorClass():New()
        oError:description := STR0001 + cErr   // "SalesConnectRetailBatchRequestDto: JSON invalido - "
        Throw oError
    EndIf

    If ValType(oJson["coupons"]) != "A"
        oError := ErrorClass():New()
        oError:description := STR0002   // "SalesConnectRetailBatchRequestDto: campo coupons[] ausente ou nao e array"
        Throw oError
    EndIf

    // Atribuicao direta do array de cupons (cada elemento e um JsonObject filho
    // de oJson). NAO destruir oJson aqui: ::aCupons compartilha esses filhos por
    // referencia; o parent e coletado pelo TLPP ao sair do metodo.
    ::aCupons := oJson["coupons"]
Return Self
