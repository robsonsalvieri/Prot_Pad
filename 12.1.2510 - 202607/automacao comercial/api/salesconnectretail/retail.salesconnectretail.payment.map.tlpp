#include "totvs.ch"
#include "tlpp-core.th"

namespace totvs.protheus.retail.salesconnectretail.obj

/*/{Protheus.doc} SalesConnectRetailPaymentMap
DePara entre tPag (SEFAZ Anexo XII) e codigo da forma de pagamento
no Protheus (SX5 Tabela 24). Combina mapeamento PREFERENCIAL hardcoded
com VALIDACAO contra SX5 - se o codigo preferencial nao existir no
ambiente, faz fallback para o proprio tPag SEFAZ (alguns ambientes
cadastram a forma com o codigo numerico da SEFAZ direto).

Mapeamento preferencial (codigos reais da SX5 T24 deste ambiente):
  01 Dinheiro               -> R$
  02 Cheque                 -> CH
  03 Cartao Credito         -> CC
  04 Cartao Debito          -> CD
  05 Credito/Cartao Loja    -> CLJ
  10 Vale Alimentacao       -> VA
  11 Vale Refeicao          -> VA
  12 Vale Presente          -> VP
  13 Vale Combustivel       -> VA
  15 Boleto Bancario        -> BOL
  16 Deposito Bancario      -> DB
  17 PIX                    -> PX
  18 Transferencia/Carteira -> PD
  19 Fidelidade/Cashback    -> FID
  90 Sem pagamento          -> CI
  99 Outros                 -> CR

Fluxo de resolucao:
  1) tenta codigo preferencial (DH/CC/PX/etc) na SX5 T24
  2) se nao existir, tenta o tPag SEFAZ direto ("01","17",etc)
  3) se nem o tPag direto existir, retorna preferencial mesmo
     (vai falhar a validacao do RetailSales.prw com mensagem clara
     pedindo ao admin para cadastrar na SX5)

@author  Thalys Augusto Alves Juvenal
@since   20/05/2026
@version 2.1
@type class
/*/
Class SalesConnectRetailPaymentMap
    Public Method New() as Object
    Public Method tPagToL4Forma(cTpag as Character) as Character
    Public Method saeResolve(cForma as Character, cTpag as Character, cTband as Character) as Array
    Protected Method ExisteNaSX5(cChave as Character) as Logical
    Protected Method mhwCodigo(cTipo as Character, cCdNfce as Character) as Character
EndClass

/*/{Protheus.doc} New
Construtor do DePara de formas de pagamento (sem estado a inicializar).
@type   method
@author Thalys Augusto Alves Juvenal
@since  20/05/2026
@return object, Self
/*/
Method New() as Object Class SalesConnectRetailPaymentMap
Return Self

/*/{Protheus.doc} tPagToL4Forma
Converte o codigo tPag (SEFAZ Anexo XII) na forma de pagamento Protheus
(L4_FORMA / SX5 Tabela 24): tenta o codigo preferencial hardcoded e, se nao
existir na SX5, faz fallback para o proprio tPag SEFAZ.
@type   method
@author Thalys Augusto Alves Juvenal
@since  20/05/2026
@param  cTpag, character, codigo da forma de pagamento SEFAZ (tPag), ex: "01","03","17"
@return character, codigo da forma de pagamento Protheus (SX5 T24), ex: "R$","CC","PX"
/*/
Method tPagToL4Forma(cTpag as Character) as Character Class SalesConnectRetailPaymentMap
    Local cTpagClean as Character
    Local cFormaPref as Character

    If ValType(cTpag) == "C"
        cTpagClean := AllTrim(cTpag)
    Else
        cTpagClean := ""
    EndIf

    // Mapeamento alinhado aos codigos REAIS cadastrados na SX5 Tabela 24
    // deste ambiente (ver tela SX5):
    //   R$=Dinheiro CH=Cheque CC=Cartao Cred. CD=Cartao Deb. CLJ=Cartao Loja
    //   CR=Credito CO=Convenio DB=Dep.Banc. DC=Deb.Conta BOL=Boleto
    //   PX=PIX PE=PIX Estatico PD=Pgto Digital PP=Pgto Posterior FID=Fidelidade
    //   VA=Vales VP=Vale Presente CI=Consumo Interno FI=Financiado FA=A Faturar
    //   RA=Receb.Antecip. CQ=Cred.Quarto
    Do Case
    Case cTpagClean == "01" ; cFormaPref := "R$"   // Dinheiro
    Case cTpagClean == "02" ; cFormaPref := "CH"   // Cheque
    Case cTpagClean == "03" ; cFormaPref := "CC"   // Cartao de Credito
    Case cTpagClean == "04" ; cFormaPref := "CD"   // Cartao de Debito
    Case cTpagClean == "05" ; cFormaPref := "CLJ"  // Credito/Cartao Loja
    Case cTpagClean == "10" ; cFormaPref := "VA"   // Vale Alimentacao -> Vales
    Case cTpagClean == "11" ; cFormaPref := "VA"   // Vale Refeicao    -> Vales
    Case cTpagClean == "12" ; cFormaPref := "VP"   // Vale Presente
    Case cTpagClean == "13" ; cFormaPref := "VA"   // Vale Combustivel -> Vales
    Case cTpagClean == "15" ; cFormaPref := "BOL"  // Boleto Bancario
    Case cTpagClean == "16" ; cFormaPref := "DB"   // Deposito Bancario
    Case cTpagClean == "17" ; cFormaPref := "PX"   // PIX
    Case cTpagClean == "18" ; cFormaPref := "PD"   // Transf./Carteira -> Pgto Digital
    Case cTpagClean == "19" ; cFormaPref := "FID"  // Fidelidade/Cashback
    Case cTpagClean == "90" ; cFormaPref := "CI"   // Sem pagamento -> Consumo Interno
    Case cTpagClean == "99" ; cFormaPref := "CR"   // Outros -> Credito
    Otherwise
        cFormaPref := "CR"
        LjGrvLog("SalesConnectRetailPaymentMap", "tPag desconhecido: '" + cTpagClean + "' mapeado para CR (Credito)")
    EndCase

    // Tenta o codigo preferencial (DH/CC/PX/...)
    If ::ExisteNaSX5(cFormaPref)
        Return cFormaPref
    EndIf

    // Fallback: ambiente pode ter cadastrado a forma com o codigo SEFAZ direto
    If !Empty(cTpagClean) .And. ::ExisteNaSX5(cTpagClean)
        LjGrvLog("SalesConnectRetailPaymentMap", ;
            "Codigo preferencial '" + cFormaPref + "' nao existe na SX5 T24 - " + ;
            "usando tPag SEFAZ '" + cTpagClean + "' como fallback")
        Return cTpagClean
    EndIf

    // Sem cadastro - retorna preferencial (RetailSales.prw vai falhar com
    // mensagem clara pedindo cadastro na SX5)
    LjGrvLog("SalesConnectRetailPaymentMap", ;
        "ATENCAO: nem '" + cFormaPref + "' nem '" + cTpagClean + "' existem na " + ;
        "SX5 Tabela 24 - cadastre a forma de pagamento antes")
Return cFormaPref

/*/{Protheus.doc} ExisteNaSX5
Verifica se um codigo de forma de pagamento existe na SX5 Tabela 24 do ambiente
(via FwGetSX5), respeitando o tamanho de X5_CHAVE.
@type   method
@author Thalys Augusto Alves Juvenal
@since  20/05/2026
@param  cChave, character, codigo da forma de pagamento a validar (ex: "CC","R$")
@return logical, .T. se existe na SX5 T24, .F. caso contrario (ou chave vazia)
/*/
Method ExisteNaSX5(cChave as Character) as Logical Class SalesConnectRetailPaymentMap
    Local cChavePad as Character

    If Empty(cChave)
        Return .F.
    EndIf

    cChavePad := PadR(AllTrim(cChave), TamSx3("X5_CHAVE")[1])
Return Len(FwGetSX5("24", cChavePad)) > 0

/*/{Protheus.doc} mhwCodigo
Converte um codigo SEFAZ (tPag ou tBand) no codigo interno Protheus MHW_CODIGO,
consultando a tabela MHW (Tabelas da SEFAZ). E esse MHW_CODIGO que a SAE guarda
em AE_CDPGSF (forma) e AE_CDBASF (bandeira) - ref. dicionario: MHW_CODIGO -> AE_*.
A MHW nao tem indice por MHW_CDNFCE: a consulta usa FWExecStatement (SQL
parametrizado com cache de query, ExecScalar), filtrando no banco.
Guardas: se a MHW/campos nao existirem ou em erro, retorna "" (Try/Catch fail-open).
@type   method
@author Thalys Augusto Alves Juvenal
@since  20/05/2026
@param  cTipo,   character, tipo SEFAZ na MHW: "PG" (forma de pagamento) ou "BD" (bandeira)
@param  cCdNfce, character, codigo SEFAZ (tPag/tBand); "" -> retorna ""
@return character, MHW_CODIGO correspondente, ou "" se nao achar
/*/
Method mhwCodigo(cTipo as Character, cCdNfce as Character) as Character Class SalesConnectRetailPaymentMap
    Local cRet   as Character
    Local cQuery as Character
    Local oExec  as Object
    Local xVal
    Local oErr   as Object

    cRet := ""

    If !Empty(AllTrim(cValToChar(cCdNfce)))
        Try
            // Filtro no banco (FWExecStatement com cache de query). MHW nao tem
            // indice por MHW_CDNFCE - aqui o WHERE resolve no servidor, sem scan.
            cQuery := "SELECT MHW_CODIGO FROM " + RetSqlName("MHW") + ;
                      " WHERE MHW_FILIAL = ? AND MHW_TIPO = ? AND MHW_CDNFCE = ? AND D_E_L_E_T_ = ? "
            cQuery := ChangeQuery(cQuery)
            oExec  := FWExecStatement():New(cQuery)
            oExec:SetString(1, xFilial("MHW"))
            oExec:SetString(2, AllTrim(cValToChar(cTipo)))
            oExec:SetString(3, AllTrim(cValToChar(cCdNfce)))
            oExec:SetString(4, " ")
            xVal := oExec:ExecScalar("MHW_CODIGO")
            If ValType(xVal) == "C"
                cRet := AllTrim(xVal)
            EndIf
        Catch oErr
            // fail-open: ambiente sem MHW/campos ou erro de query -> "" (fallback)
            LjGrvLog("SalesConnectRetailPaymentMap", "mhwCodigo fallback (erro): " + oErr:Description)
            cRet := ""
        EndTry
    EndIf
Return cRet

/*/{Protheus.doc} saeResolve
Resolve administradora e bandeira do pagamento via cadastro nativo SAE
(Administradora Financeira), casando 3 chaves:
  AE_TIPO   = forma (codigo SX5 T24 ja resolvido pelo PaymentMap) e
  AE_CDPGSF = MHW_CODIGO do tPag  (via mhwCodigo, tipo "PG") e
  AE_CDBASF = MHW_CODIGO do tBand (via mhwCodigo, tipo "BD") -> AE_COD + bandeira.

IMPORTANTE: a SAE guarda em AE_CDPGSF/AE_CDBASF o codigo INTERNO Protheus
(MHW_CODIGO), NAO o tPag/tBand cru da SEFAZ (ref dicionario MHW_CODIGO -> AE_*).
Por isso o tPag/tBand sao convertidos via MHW antes de casar a SAE.

A SAE nao tem indice por esses campos: a consulta usa FWExecStatement (SQL
parametrizado com cache de query, OpenAlias), com o filtro da bandeira condicional
(so entra no WHERE quando ha tBand). Filtra no banco, sem scan em memoria.

Guardas defensivas: se a SAE/MHW ou os campos nao existirem neste ambiente, ou
em qualquer erro, retorna vazio (Try/Catch fail-open -> chamador usa o acquirerCode
do payload). NAO lanca excecao.

@type   method
@author Thalys Augusto Alves Juvenal
@since  20/05/2026
@param  cForma, character, forma de pagamento Protheus (codigo SX5 T24) -> casa AE_TIPO
@param  cTpag,  character, codigo SEFAZ da forma (tPag) -> convertido em MHW_CODIGO p/ casar AE_CDPGSF
@param  cTband, character, codigo SEFAZ da bandeira (tBand) -> MHW_CODIGO p/ AE_CDBASF; "" quando nao houver
@return array, { cAdministradora (AE_COD), cBandeira (AE_CDBASF) } - vazios se nao achar
/*/
Method saeResolve(cForma as Character, cTpag as Character, cTband as Character) as Array Class SalesConnectRetailPaymentMap
    Local aRet   as Array
    Local cFm    as Character
    Local cPg    as Character
    Local cBa    as Character
    Local cQuery as Character
    Local cWhere as Character
    Local oExec  as Object
    Local cAlias as Character
    Local nP     as Numeric
    Local oErr   as Object

    aRet := {"", ""}   // { L4_ADMINIS (AE_COD), L4_BANDEIR (AE_CDBASF) }

    Try
        // tPag/tBand (SEFAZ) -> MHW_CODIGO: e esse codigo interno que a SAE guarda
        // em AE_CDPGSF/AE_CDBASF (ref dicionario MHW_CODIGO -> AE_*). Sem a ponte
        // pela MHW o de-para por tPag direto NAO casa.
        cFm := AllTrim(cValToChar(cForma))
        cPg := ::mhwCodigo("PG", cTpag)
        cBa := ::mhwCodigo("BD", cTband)

        // Sem MHW_CODIGO da forma (cPg) nao ha como casar AE_CDPGSF.
        If !Empty(cPg)
            // WHERE da bandeira condicional (quando nao ha tBand, nao filtra).
            cWhere := " WHERE AE_FILIAL = ? AND AE_TIPO = ? AND AE_CDPGSF = ? "
            If !Empty(cBa)
                cWhere += " AND AE_CDBASF = ? "
            EndIf
            cWhere += " AND D_E_L_E_T_ = ? "

            cQuery := ChangeQuery("SELECT AE_COD, AE_CDBASF FROM " + RetSqlName("SAE") + cWhere)
            oExec  := FWExecStatement():New(cQuery)
            nP := 1
            oExec:SetString(nP++, xFilial("SAE"))
            oExec:SetString(nP++, cFm)
            oExec:SetString(nP++, cPg)
            If !Empty(cBa)
                oExec:SetString(nP++, cBa)
            EndIf
            oExec:SetString(nP++, " ")

            cAlias := oExec:OpenAlias()
            If !Empty(cAlias) .And. Select(cAlias) > 0
                If !(cAlias)->(Eof())
                    aRet[1] := AllTrim((cAlias)->AE_COD)
                    aRet[2] := AllTrim((cAlias)->AE_CDBASF)
                EndIf
                (cAlias)->(DbCloseArea())
            EndIf
        EndIf
    Catch oErr
        // fail-open: ambiente sem SAE/campos ou erro de query -> "" (fallback)
        LjGrvLog("SalesConnectRetailPaymentMap", "saeResolve fallback (erro): " + oErr:Description)
        aRet := {"", ""}
    EndTry
Return aRet
