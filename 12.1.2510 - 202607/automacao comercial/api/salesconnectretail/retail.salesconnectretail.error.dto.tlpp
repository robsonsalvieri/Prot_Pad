#include "totvs.ch"
#include "tlpp-core.th"

namespace totvs.protheus.retail.salesconnectretail.dto

/*/{Protheus.doc} SalesConnectRetailErrorDto
DTO de resposta de erro (HTTP 400/401/409/422/500) para POST /api/retail/v1/SalesConnectRetail/.
Os campos cCodFil e cNumero sao opcionais e so aparecem no JSON quando preenchidos.
@author Thalys Augusto Alves Juvenal
@since  18/05/2026
@version 1.0
@type class
/*/
Class SalesConnectRetailErrorDto
    Public Data cCode    as Character
    Public Data cMessage as Character
    Public Data cCodFil  as Character
    Public Data cNumero  as Character

    Public Method New(cCode as Character, cMessage as Character) as Object
    Public Method toJson() as Character
EndClass

/*/{Protheus.doc} New
Construtor do DTO de erro. cCodFil/cNumero iniciam vazios (so aparecem no JSON
quando preenchidos externamente).
@type   method
@author Thalys Augusto Alves Juvenal
@since  18/05/2026
@param  cCode,    character, codigo de erro (ex: "0001", "0099")
@param  cMessage, character, mensagem descritiva do erro
@return object, Self
/*/
Method New(cCode as Character, cMessage as Character) as Object Class SalesConnectRetailErrorDto
    ::cCode    := cCode
    ::cMessage := cMessage
    ::cCodFil  := ""
    ::cNumero  := ""
Return Self

/*/{Protheus.doc} toJson
Serializa o DTO em string JSON. Inclui branch/documentNumber apenas quando
cCodFil/cNumero estiverem preenchidos.
@type   method
@author Thalys Augusto Alves Juvenal
@since  18/05/2026
@return character, JSON do erro { code, message [, branch, documentNumber] }
/*/
Method toJson() as Character Class SalesConnectRetailErrorDto
    Local oJson := JsonObject():New()
    oJson["code"]    := ::cCode
    oJson["message"] := ::cMessage
    If !Empty(::cCodFil)
        oJson["branch"] := ::cCodFil
    EndIf
    If !Empty(::cNumero)
        oJson["documentNumber"] := ::cNumero
    EndIf
Return oJson:toJson()
