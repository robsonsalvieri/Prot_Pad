#include "totvs.ch"
#include "tlpp-core.th"

namespace totvs.protheus.retail.salesconnectretail.dto

/*/{Protheus.doc} SalesConnectRetailStatusResponseDto
DTO do envelope de resposta (HTTP 200) para GET /api/retail/v1/SalesConnectRetail/status/.
@author Thalys Augusto Alves Juvenal
@since  09/06/2026
@version 1.0
@type class
/*/
Class SalesConnectRetailStatusResponseDto
    Public Data aItems    as Array
    Public Data nTotal    as Numeric
    Public Data nPage     as Numeric
    Public Data nPageSize as Numeric

    Public Method New(aItems as Array, nTotal as Numeric, nPage as Numeric, nPageSize as Numeric) as Object
    Public Method toJson() as Character
EndClass

/*/{Protheus.doc} New
Construtor do envelope de status (GET). aItems nao-Array vira {}.
@type   method
@author Thalys Augusto Alves Juvenal
@since  09/06/2026
@param  aItems,    array,   lista de SalesConnectRetailStatusItemDto
@param  nTotal,    numeric, total de registros que casam o filtro (sem paginacao)
@param  nPage,     numeric, pagina corrente
@param  nPageSize, numeric, itens por pagina
@return object, Self
/*/
Method New(aItems as Array, nTotal as Numeric, nPage as Numeric, nPageSize as Numeric) as Object Class SalesConnectRetailStatusResponseDto
    If ValType(aItems) == "A"
        ::aItems := aItems
    Else
        ::aItems := {}
    EndIf
    ::nTotal    := nTotal
    ::nPage     := nPage
    ::nPageSize := nPageSize
Return Self

/*/{Protheus.doc} toJson
Serializa o envelope em JSON: items[], hasNext (ha mais paginas?),
remainingRecords (quantos faltam) e total.
@type   method
@author Thalys Augusto Alves Juvenal
@since  09/06/2026
@return character, JSON { items[], hasNext, remainingRecords, total }
/*/
Method toJson() as Character Class SalesConnectRetailStatusResponseDto
    Local oJson      as Json
    Local aJsonItems as Array
    Local nI         as Numeric

    oJson      := JsonObject():New()
    aJsonItems := {}
    For nI := 1 To Len(::aItems)
        aAdd(aJsonItems, ::aItems[nI]:toJsonObject())
    Next nI
    oJson["items"]            := aJsonItems
    oJson["hasNext"]          := (::nPage * ::nPageSize) < ::nTotal
    oJson["remainingRecords"] := Max(::nTotal - (::nPage * ::nPageSize), 0)
    oJson["total"]            := ::nTotal
Return oJson:toJson()
