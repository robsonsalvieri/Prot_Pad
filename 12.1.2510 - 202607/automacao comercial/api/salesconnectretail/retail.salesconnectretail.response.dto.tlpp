#include "totvs.ch"
#include "tlpp-core.th"

namespace totvs.protheus.retail.salesconnectretail.dto

/*/{Protheus.doc} SalesConnectRetailResponseDto
DTO de resposta de sucesso (HTTP 200) para POST /api/retail/v1/SalesConnectRetail/.
@author Thalys Augusto Alves Juvenal
@since  18/05/2026
@version 1.0
@type class
/*/
Class SalesConnectRetailResponseDto
    Public Data cCodFil    as Character
    Public Data cNumero    as Character
    Public Data cStatusVda as Character

    Public Method New(cCodFil as Character, cNumero as Character, cStatusVda as Character) as Object
    Public Method toJson() as Character
EndClass

/*/{Protheus.doc} New
Construtor do DTO de resposta de sucesso (HTTP 200).
@type   method
@author Thalys Augusto Alves Juvenal
@since  18/05/2026
@param  cCodFil,    character, codigo da filial gravada (branch)
@param  cNumero,    character, numero do documento gerado (documentNumber)
@param  cStatusVda, character, status da venda (ex: "OK")
@return object, Self
/*/
Method New(cCodFil as Character, cNumero as Character, cStatusVda as Character) as Object Class SalesConnectRetailResponseDto
    ::cCodFil    := cCodFil
    ::cNumero    := cNumero
    ::cStatusVda := cStatusVda
Return Self

/*/{Protheus.doc} toJson
Serializa o DTO em string JSON com chaves em ingles (branch/documentNumber/status).
@type   method
@author Thalys Augusto Alves Juvenal
@since  18/05/2026
@return character, JSON { branch, documentNumber, status }
/*/
Method toJson() as Character Class SalesConnectRetailResponseDto
    Local oJson := JsonObject():New()
    // chaves em ingles, alinhadas a SalesConnectRetailItemResponseDto (branch/documentNumber/status)
    oJson["branch"]         := ::cCodFil
    oJson["documentNumber"] := ::cNumero
    oJson["status"]         := ::cStatusVda
Return oJson:toJson()
