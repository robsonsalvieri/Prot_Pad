namespace totvs.protheus.retail.rmi.api.ljtituloreceberobj

/*/{Protheus.doc} tituloreceberobj
Classe para tratamento da API de titulos a receber  
@type class
@author Carlos Chigres
@since 4/22/2026
/*/
Class tituloreceberobj From LojRestObj20

	Public Method New()                 as Object
    Public Method SetFields()           as Variant
    Public Method Validation()          as Variant
    Public Method setSelect()           as Variant
    Public Method GetReturn()           as Character

    Public Method GetNomeLoja()         as Character
    Public Method BuildTitulo()         as Character
    Public Method BuildIdCli()          as Character     
    Public Method BuildEncargos()       as Numeric
    Public Method SituacaoParcela()     as Numeric
    Public Method DateConverted()       as Character

EndClass

/*/{Protheus.doc} tituloreceberobj::New
Metodo construtor da classe 
@type method
@author Carlos Chigres
@since 4/23/2026
@param oWsRestObj, object,  Objeto WSRESTFUL da API
/*/
Method New(oWsRestObj As Object) as Object Class tituloreceberobj

    _Super:New(oWsRestObj, /*jParans*/, /*cBody*/)    

Return self

/*/{Protheus.doc} tituloreceberobj::SetFields
Carrega os campos que serão retornados
@type method
@author Carlos Chigres
@since 4/22/2026
/*/
Method SetFields() as Variant Class tituloreceberobj

                        //Tag - ID				        Campo                       Expressão que será executada para gerar o retorno   Tag que será utilizada para preencher o objeto de retorno   Tipo do Campo   Expressão de busca
    HmAdd(self:oFields, {"IDRETAGUARDALOJA"		    , "E1_FILORIG"              , "E1_FILORIG"                                      , "idRetaguardaLoja"				                        , "C"           , ""}               , 1, 3)
    HmAdd(self:oFields, {"DESCRICAOLOJA"	        , ""                        , "self:GetNomeLoja()"				                , "descricaoLoja"				                            , "C"           , ""}               , 1, 3)
    HmAdd(self:oFields, {"IDRETAGUARDATITULO"       , ""		        	    , "self:BuildTitulo()"					            , "idRetaguardaTitulo"			                            , "C"           , ""}               , 1, 3)
    HmAdd(self:oFields, {"IDRETAGUARDACLIENTE"	    , ""        	            , "self:BuildIdCli()"					            , "idRetaguardaCliente"					                    , "C"           , ""}               , 1, 3)
    HmAdd(self:oFields, {"NOMECLIENTE"	            , "A1_NOME"      			, "A1_NOME"	    								    , "nomeCliente"				                                , "C"           , ""}               , 1, 3)
    HmAdd(self:oFields, {"CPFCNPJ"                  , "A1_CGC"      		    , "A1_CGC"   								        , "cpfCnpj"				                                    , "C"           , ""}               , 1, 3)
    HmAdd(self:oFields, {"NUMEROTITULO"	            , "E1_NUM"	                , "E1_NUM"  									    , "numeroTitulo"				                            , "C"           , ""}               , 1, 3)
    HmAdd(self:oFields, {"NUMEROPARCELA"            , "E1_PARCELA"	            , "E1_PARCELA"  									, "numeroParcela"				                            , "N"           , ""}               , 1, 3)
    HmAdd(self:oFields, {"DATAVENCIMENTOPARCELA"    , "E1_VENCREA"	            , "self:DateConverted( 2, 'E1_VENCREA' )"			, "dataVencimentoParcela"	    	                        , "D"           , ""}               , 1, 3)
    HmAdd(self:oFields, {"VALORPARCELA"             , "E1_SALDO"	            , "E1_SALDO"  						    			, "valorParcela"				                            , "N"           , ""}               , 1, 3)
    HmAdd(self:oFields, {"VALORTOTALPARCELA"        , "E1_VALLIQ"	            , "E1_VALLIQ"  						    			, "valorTotalParcela"				                        , "N"           , ""}               , 1, 3)
    HmAdd(self:oFields, {"ENCARGOSPARCELA"          , ""	                    , "self:BuildEncargos()"    		    			, "encargosParcela"				                            , "N"           , ""}               , 1, 3)
    HmAdd(self:oFields, {"DESCONTOSPARCELA"         , "E1_DESCONT"              , "E1_DESCONT"   		                			, "descontosParcela"				                        , "N"           , ""}               , 1, 3)
    HmAdd(self:oFields, {"SITUACAOPARCELA"          , ""	                    , "self:SituacaoParcela()"   		    			, "SituacaoParcelaTitulo"                                   , "N"           , ""}               , 1, 3)
    HmAdd(self:oFields, {"DATAPAGAMENTOPARCELA"     , "E1_BAIXA"  			    , "self:DateConverted( 2, 'E1_BAIXA' )"			    , "datapagamentoParcela"				                    , "D"           , ""}               , 1, 3)
    
Return Nil

// Metodo para validações executado no momento do get
Method Validation(cOrigem as Character) as Variant Class tituloreceberobj

    _Super:Validation()

    If self:lSuccess

        SA1->( dbSetOrder( 3 ) ) // A1_FILIAL + A1_CGC

        // Tags obrigatorias
        Do Case

            Case Empty( self:jParans['cpfCnpj'] )
                self:lSuccess   := .F.
                self:cError     := I18n("Ops! #1 não enviado ou inválido.", {"cpfCnpj"} )  

            Case Empty( self:jParans['situacaoParcelaTitulo'] ) .Or. !self:jParans['situacaoParcelaTitulo'] $ "0/1/2"
                self:lSuccess   := .F.
                self:cError     := I18n("Ops! #1 nao enviada ou invalida.", {"situacaoParcelaTitulo"} ) 

            Case Empty( self:jParans['tipoData'] ) .Or. !self:jParans['tipoData'] $ "0/1"
                self:lSuccess   := .F.
                self:cError     := I18n("Ops! #1 nao enviado ou invalido.", {"tipoData"} ) 

            Case Empty( self:jParans['dataInicial'] ) 
                self:lSuccess   := .F.
                self:cError     := I18n("Ops! #1 nao enviada ou invalida.", {"dataInicial"} ) 

            Case Empty( self:jParans['dataFinal'] ) 
                self:lSuccess   := .F.
                self:cError     := I18n("Ops! #1 nao enviada ou invalida.", {"dataFinal"} ) 

            Case !SA1->( dbSeek( xFilial("SA1") + self:jParans['cpfCnpj'] ) )  
                self:lSuccess   := .F.
                self:cError     := "Cliente não encontrado."

        EndCase

        If self:lSuccess
            self:SetSelect()
        EndIf

    EndIf

Return Nil

/*/{Protheus.doc} tituloreceberobj::setSelect
Carrega a query que será executada
@type method
@author Carlos Chigres
@since 4/23/2026
@param cTable, character, alias da tabela 
/*/
Method setSelect(cTable as Character) as Variant Class tituloreceberobj

    Local cWhereIdLoja      := ""
    Local cFiltrSit         := ""
    Local cFiltrData        := ""
    Local cFormasNaoAceitas := "CH|CC|CD|VA|NCC"
    Local cMVLJTPREC	    := AllTrim( SuperGetMV("MV_LJTPREC",,"") )		// Tipo de titulos validos para o recebimento

    //_Super:setSelect(cTable)
    self:cTable := "SE1"

    // Verificando o idRetaguardaLoja 
    If self:jParans:HasProperty("idRetaguardaLoja") .And. !Empty( self:jParans['idRetaguardaLoja'] )
        cWhereIdLoja := " AND E1_FILIAL = '" + self:jParans['idRetaguardaLoja'] + "'"
    EndIf

    // Definindo filtro de 'situacaoParcelaTitulo'
    Do Case
        Case self:jParans['situacaoParcelaTitulo'] == "0" // Em Aberto
            cFiltrSit := " AND E1_SALDO > 0 "

        Case self:jParans['situacaoParcelaTitulo'] == "1" // Baixados
            cFiltrSit := " AND E1_SALDO = 0 "
    EndCase

    // Definindo filtro de 'tipoData'
    Do Case
        Case self:jParans['tipoData'] == "0" // Emissao
            cFiltrData := " AND E1_EMISSAO >= " + self:jParans['dataInicial'] + " AND E1_EMISSAO <= " + self:jParans['dataFinal']

        Case self:jParans['tipoData'] == "1" // Vencimento
            cFiltrData := " AND E1_VENCREA >= " + self:jParans['dataInicial'] + " AND E1_VENCREA <= " + self:jParans['dataFinal']
    EndCase

    self:cSelect    := "SELECT E1_FILORIG, E1_FILIAL, E1_PREFIXO, E1_NUM, E1_PARCELA, E1_TIPO, A1_COD, A1_LOJA, A1_NOME, A1_CGC, " 
    self:cSelect    += "E1_VENCREA, E1_SALDO, E1_VALLIQ, E1_MULTA, E1_JUROS, E1_DESCONT, E1_BAIXA "
    self:cSelect    += "FROM " + RetSqlName("SE1") + " SE1 "
    self:cSelect    += "INNER JOIN " + RetSqlName("SA1") + " SA1 ON "
    self:cSelect    += "E1_CLIENTE = A1_COD AND E1_LOJA = A1_LOJA AND SA1.D_E_L_E_T_ = ' ' "

    self:cWhere     := " WHERE SE1.D_E_L_E_T_ = ' ' "
    self:cWhere     += cWhereIdLoja
    self:cWhere     += " AND A1_CGC = '" + self:jParans['cpfCnpj'] + "' "
    self:cWhere     += " AND E1_TIPO IN " + FormatIN(cMVLJTPREC,",")
    self:cWhere     += " AND E1_TIPO NOT IN " + FormatIN(cFormasNaoAceitas,"|")

    // Filtro de 'situacao'
    If !Empty( cFiltrSit )
        self:cWhere += cFiltrSit
    EndIf 

    // Filtro de 'tipoData'
    If !Empty( cFiltrData )
        self:cWhere += cFiltrData
    EndIf

    self:cOrderBy := "ORDER BY E1_FILIAL,E1_PREFIXO,E1_NUM,E1_PARCELA,E1_TIPO "
    
    LjGrvLog("tituloreceberobj", " lista de orçamentos Query : "+self:cSelect+self:cWhere+self:cOrderBy, self:jParans:toJson())

Return Nil   

/*/{Protheus.doc} tituloreceberobj::GetReturn
Retorna json com resultado da consulta
@type method
@author Carlos Chigres
@since 4/23/2026
/*/
Method GetReturn() as Character Class tituloreceberobj

    Local jRetorno          as Object 
    Local aAuxiliar         as Array
    Local cRetorno          as Character
    Local nTotal            as Integer 
    
    jRetorno:= JsonObject():New()
    jRetorno:FromJson( _Super:GetReturn() )

    nTotal    := Len( jRetorno["data"] )
    aAuxiliar := aClone( jRetorno["data"] )

    jRetorno["data"] := JsonObject():New()    

    If self:lSuccess
        jRetorno["data"] := aAuxiliar
    Else 
        jRetorno["data"] := {}
    EndIf    
   
    jRetorno["errors"]    := nil
    jRetorno["totalTime"] := time()
    jRetorno["quantidadeRegistros"] := nTotal
   
    cRetorno := jRetorno:toJson()
    FwFreeObj(jRetorno)

Return cRetorno

/*/{Protheus.doc} tituloreceberobj::GetNomeLoja
Metodo que retorna o nome da Loja, a partir de SM0
@type method
@author Carlos Chigres
@since 4/22/2026
@return character, nome da loja
/*/
Method GetNomeLoja() as Character Class tituloreceberobj

    Local cNomeLoja   as Character
    Local aEmpresas   as Array
    Local nPosNome    as Numeric 

    cNomeLoja := ' '

    aEmpresas := FWSM0UTIL():GetSM0Data( , (self:cAliasQuery)->E1_FILORIG, { 'M0_NOMECOM' } )  // campo a ser retornado
    nPosNome  := aScan(aEmpresas, {|x| x[1] == "M0_NOMECOM"})
    If nPosNome > 0
        cNomeLoja := aEmpresas[nPosNome][2]
    EndIf

Return cNomeLoja

/*/{Protheus.doc} tituloreceberobj::BuildTitulo
Metodo que realiza a composição da chave identificadora do Titulo
@type method
@author Carlos Chigres
@since 4/22/2026
@return character, chave id do titulo
/*/
Method BuildTitulo() as Character Class tituloreceberobj

    Local cTitulo as Character

    cTitulo := (self:cAliasQuery)->E1_FILIAL
    cTitulo += (self:cAliasQuery)->E1_PREFIXO
    cTitulo += (self:cAliasQuery)->E1_NUM
    cTitulo += (self:cAliasQuery)->E1_PARCELA
    cTitulo += (self:cAliasQuery)->E1_TIPO

Return cTitulo

/*/{Protheus.doc} tituloreceberobj::BuildIdCli
Metodo que constroi o campo idRetaguardaCliente
@type method
@author Carlos Chigres
@since 4/23/2026
@return character, chave id do cliente
/*/
Method BuildIdCli() as Character Class tituloreceberobj

    Local cIdCli as Character

    cIdCli := (self:cAliasQuery)->A1_COD
    cIdCli += (self:cAliasQuery)->A1_LOJA

Return cIdCli

/*/{Protheus.doc} tituloreceberobj::BuildEncargos
Metodo que retorna o calculo para a definição de "encargos"
@type method
@author Carlos Chigres
@since 4/22/2026
@return numeric, multa + juros
/*/
Method BuildEncargos() as Numeric Class tituloreceberobj

    Local nEncargos as Numeric

    nEncargos := (self:cAliasQuery)->E1_MULTA + (self:cAliasQuery)->E1_JUROS 

Return nEncargos

/*/{Protheus.doc} tituloreceberobj::SituacaoParcela
Metodo construido para retornar a situação da parcela, conforme definido
@type method
@author Carlos Chigres
@since 4/22/2026
@return numeric, situacao
/*/
Method SituacaoParcela() as Numeric Class tituloreceberobj

    Local nSituacao as Numeric

    nSituacao := IIf((self:cAliasQuery)->E1_SALDO > 0, 0, 1)     

Return nSituacao

/*/{Protheus.doc} tituloreceberobj::DateConverted
Converte a data para o padrao de integracao Portal x Protheus
@type method
@author Carlos Chigres
@since 21/09/2023
@param nTipo, Numeric,  1=Retorna data;2=Converte data para gravacao
@param cCampo, Character, campo de informação date
@return Character, data convertida
/*/
Method DateConverted(nTipo As Numeric, cCampo As Character) As Character Class tituloreceberobj

    Local cDate          := ""
    Local cDateConverted := ""

    Default nTipo := 1

    cDate := (self:cAliasQuery)->&(cCampo)

    If !Empty( cDate )

        If nTipo == 1
            // cDateConverted := SubStr(cDate,7,2) + "/" + SubStr(cDate,5,2) + "/" + SubStr(cDate,1,4)
        Else
            cDateConverted := SubStr(cDate,1,4) + "-" + SubStr(cDate,5,2) + "-" + SubStr(cDate,7,2)
        EndIf 

    EndIf

Return cDateConverted

