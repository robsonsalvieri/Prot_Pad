#INCLUDE "TOTVS.CH"

namespace totvs.protheus.retail.rmi.api.ljclienteobj

//-------------------------------------------------------------------
/*/{Protheus.doc} Classe ClienteObj
    Classe para tratamento da API de Integração On Line de Cliente
/*/
//-------------------------------------------------------------------
Class ClienteObj From LojRestObj20

	Public Method New()                     as Object
    Public Method getReturn()               as Character
    Public Method ProcessaCliente()         as Array
    Public Method VerificaEndereco()        as Array
    Public Method EnderecoObrigat()         as Array 
    Public Method ValidEndObrigatorios()    as Array
    Public Method execCliente()             as Variant
    Public Method EnderecoComplementar()    as Array

    Protected Method Validation()           as Variant

EndClass
 
//-------------------------------------------------------------------
/*/{Protheus.doc} new
Método construtor da Classe

@param oWsRestObj - Objeto WSRESTFUL da API

@author  Carlos Chigres
@since   11/05/2026
@version 1.0
/*/
//-------------------------------------------------------------------
Method New(oWsRestObj As Object) as Object Class ClienteObj
    
    _Super:New(oWsRestObj, /*jParans*/, /*cBody*/)    

Return self

//-------------------------------------------------------------------
/*/{Protheus.doc} Validation
Metodo para validações executado no momento do get

@author  Carlos Chigres
@since   11/05/2026
@version 1.0
/*/
//-------------------------------------------------------------------
Method Validation(cOrigem as Character) as Variant Class ClienteObj

    Local aRetorno  as Array
    Local lFind     as Logical

    aRetorno := {} 
    lFind    := .F.

    _Super:Validation()

    If self:lSuccess

        If cOrigem == "GET"

            // Validacao do cpfCnpj
            If self:lSuccess .And. ( !self:jBody:hasProperty("cpfCnpj") .Or. Empty( self:jBody["cpfCnpj"] ) )
                self:lSuccess := .F.
                self:cError   := I18n("Ops! A informação contida na tag #1 não foi enviada, ou não é valida.", { "cpfCnpj" } )
            EndIf

            // Validacao do idRetaguarda - mas somente a existencia da tag
            If self:lSuccess .And. !self:jBody:hasProperty("idRetaguarda")
                self:lSuccess := .F.
                self:cError   := I18n("Ops! A informação contida na tag #1 não foi enviada.", { "idRetaguarda" } )
            EndIf

            // Validacao do idRetaguardaLoja 
            If self:lSuccess .And. ( !self:jBody:hasProperty("idRetaguardaLoja") .Or. Empty( self:jBody["idRetaguardaLoja"] ) )
                self:lSuccess := .F.
                self:cError   := I18n("Ops! A informação contida na tag #1 não foi enviada.", { "idRetaguardaLoja" } )
            EndIf

            // Validacao do idInquilino
            If self:lSuccess .And. ( !self:jBody:hasProperty("idInquilino") .Or. Empty( self:jBody["idInquilino"] ) )
                self:lSuccess := .F.
                self:cError   := I18n("Ops! A informação contida na tag #1 não foi enviada, ou não é valida.", { "idInquilino" } )
            EndIf

            // Validacao do nome
            If self:lSuccess .And. ( !self:jBody:hasProperty("nome") .Or. Empty( self:jBody["nome"] ) )
                self:lSuccess := .F.
                self:cError   := I18n("Ops! A informação contida na tag #1 não foi enviada, ou não é valida.", { "nome" } )
            EndIf

            // Validacao do pessoaFisica
            If self:lSuccess .And. ( !self:jBody:hasProperty("pessoaFisica") .Or. Empty( self:jBody["pessoaFisica"] ) )
                self:lSuccess := .F.
                self:cError   := I18n("Ops! A informação contida na tag #1 não foi enviada, ou não é valida.", { "pessoaFisica" } )
            EndIf

            // Validacao do rgInscricao
            If self:lSuccess .And. ( !self:jBody:hasProperty("rgInscricao") .Or. Empty( self:jBody["rgInscricao"] ) )
                self:lSuccess := .F.
                self:cError   := I18n("Ops! A informação contida na tag #1 não foi enviada, ou não é valida.", { "rgInscricao" } )
            EndIf

            // Validacao do Endereço na raiz (fora da lista Enderecos)
            If self:lSuccess 
                aRetorno        := self:ValidEndObrigatorios( 0 )
                self:lSuccess   := aRetorno[ 1 ]
                self:cError     := aRetorno[ 2 ]
            EndIf

            // Validacao do(s) Endereço(s)
            If self:lSuccess 
                If self:jBody:hasProperty("Enderecos") .And. Len( self:jBody["Enderecos"] ) > 0
                    aRetorno        := self:VerificaEndereco()
                    self:lSuccess   := aRetorno[ 1 ]
                    self:cError     := aRetorno[ 2 ]
                EndIf
            EndIf

            // Validacao de consistencia de Cliente (inclusao ou alteracao)
            If self:lSuccess 
                aRetorno        := self:ProcessaCliente()
                self:lSuccess   := aRetorno[ 1 ]
                self:cError     := aRetorno[ 2 ]
            EndIf

            // aciona execauto de Cliente (inclusao ou alteracao)
            If self:lSuccess 
                self:execCliente()
            EndIf

        EndIf

        If self:lSuccess
            LjGrvLog("IntegraCliente", "Requisição na API de estoque", self:jParans:toJson())
        EndIf

    EndIf

Return Nil

/*/{Protheus.doc} ClienteObj::GetReturn
Retorna json com resultado da consulta
@type method
@author Carlos Chigres
@since 4/23/2026
/*/
Method GetReturn() as Character Class ClienteObj

    Local jRetorno          as Object 
    Local aAuxiliar         as Array
    Local cRetorno          as Character
    Local nTotal            as Integer 
    Local cMensagem         as Character
    
    jRetorno:= JsonObject():New()
    jRetorno:FromJson( _Super:GetReturn() )

    nTotal    := Len( jRetorno["data"] )
    aAuxiliar := aClone( jRetorno["data"] )
    cMensagem := jRetorno["message"]

    If Len( aAuxiliar ) > 0 
        aAuxiliar[1]["idRetaguarda"] := self:jBody["idRetaguarda"]
    EndIf

    jRetorno["data"] := JsonObject():New()    
    jRetorno["message"] := ""

    If self:lSuccess
        jRetorno["data"]    := aAuxiliar
        jRetorno["message"] := "Cliente processado com sucesso."
    Else 
        jRetorno["message"] := cMensagem
        jRetorno["data"]    := nil
    EndIf    
   
    jRetorno["errors"]          := nil
    jRetorno["totalTime"]       := If( self:lSuccess, time(), 0 )
    jRetorno["numberOfRecords"] := nTotal
   
    cRetorno := jRetorno:toJson()
    FwFreeObj(jRetorno)
    
Return cRetorno


/*/{Protheus.doc} ClienteObj::ProcessaCliente
Faz as validacoes de Tags Obrigatorias, e a consistencia de valores de baixa.
@type method
@author Carlos Chigres
@since 13/05/2026
@return array, status logico e mensagem 
/*/
Method ProcessaCliente() as Array Class ClienteObj

    Local lRetorno  as Logical
    Local cMensagem as Character
    Local cCgcCpf   as Character
    Local cPessoa   as Character


    lRetorno  := .T.
    cMensagem := " "
    cCgcCpf   := self:jBody["cpfCnpj"]
    cPessoa   := If( self:jBody["pessoaFisica"] == 1 , "F" , "J" )

    // sinaliza Inclusão de Cliente 
    If Empty( self:jBody["idRetaguarda"] )

        // Verificando se o cliente existe na Base 
        SA1->( dbSetOrder( 3 ) )
        lFind := SA1->( dbSeek( xFilial("SA1") + self:jBody["cpfCnpj"] ) ) 

        If lFind
            lRetorno    := .F.
            cMensagem   := I18n("A tag de idRetaguarda está em branco, mas o Cliente existe (cpf/cnpj = " + self:jBody["cpfCnpj"] + ").")
        EndIf 

    // sinaliza Alteração de Cliente 
    Else 

        // Verificando se o cliente existe na Base 
        SA1->( dbSetOrder( 1 ) )
        lFind := SA1->( dbSeek( xFilial("SA1") + self:jBody["idRetaguarda"] ) ) 

        If !lFind
            lRetorno    := .F.
            cMensagem   := I18n("A busca do Cliente pela tag de idRetaguarda não retornou nenhum registro.")
        EndIf 

    EndIf 

    // verifica A1_PESSOA x cCgcCpf
    If lRetorno

        If cPessoa == "F" .And. ( Len( cCgcCpf ) > 11 .Or. Len( cCgcCpf ) < 11 )
            lRetorno    := .F.
            cMensagem   := I18n("A tag pessoaFisica indica Pessoa Física, mas o Cpf informado não tem 11 caracteres.")
        EndIf 

        If cPessoa == "J" .And. ( Len( cCgcCpf ) > 14 .Or. Len( cCgcCpf ) < 14 )
            lRetorno    := .F.
            cMensagem   := I18n("A tag pessoaFisica indica Pessoa Jurídica, mas o Cnpj informado não tem 14 caracteres.")
        EndIf 

    EndIf 

Return { lRetorno, cMensagem }

/*/{Protheus.doc} ClienteObj:EnderecoObrigat
Metodo que retorna os campos obrigatorios da estrutura de endereços
@type method
@author Carlos Chigres
@since 12/05/2026
@param nPos, numeric, posicao do titulo; faz a difeença entre endereço Raiz e Endereços de Lista (Entrega e Cobrança)
@return array, lista de tags obrigatorias
/*/
Method EnderecoObrigat( nPos ) as Array Class ClienteObj 

    Local aCamposObg    as Array
    Local aSA1Struct    as Array
    Local nInd          as Numeric 
    Local nObrig        as Numeric
    Local cCampo        as Character
    Local cAlias        as Character
    Local cTipoEnd      as Character
    Local lVirtual      as Logical  
    Local lRequired     as Logical

    Default nPos := 0

    cAlias       := "SA1"
    lVirtual     := .F.
    lRequired    := .T.
    aCamposObg   := {}
    aSA1Struct   := FwSX3Util():GetListFieldsStruct( cAlias , lVirtual, lRequired ) 

    If nPos == 0
        Aadd( aCamposObg, { "R", "endereco"      , "A1_END"          , .F. } )
        Aadd( aCamposObg, { "R", "bairro"        , "A1_BAIRRO"       , .F. } )
        Aadd( aCamposObg, { "R", "celular"       , "A1_TEL"          , .F. } )  
        Aadd( aCamposObg, { "R", "cep"           , "A1_CEP"          , .F. } )
        Aadd( aCamposObg, { "R", "cidade"        , "A1_MUN"          , .F. } )
        Aadd( aCamposObg, { "R", "estado"        , "A1_EST"          , .F. } )
        Aadd( aCamposObg, { "R", "complemento"   , "A1_COMPLEM"      , .F. } )
    EndIf

    If nPos > 0

        cTipoEnd := self:jBody["Enderecos"][nPos]["tipo"]

        Do Case 

            Case cTipoEnd == "0"  // Entrega
    
                // campos de endereço para o tipo "Entrega"
                Aadd( aCamposObg, { "E", "endereco"      , "A1_ENDENT"       , .F. } )
                Aadd( aCamposObg, { "E", "bairro"        , "A1_BAIRROE"      , .F. } )
                Aadd( aCamposObg, { "E", "cep"           , "A1_CEPE"         , .F. } )
                Aadd( aCamposObg, { "E", "cidade"        , "A1_MUNE"         , .F. } )
                Aadd( aCamposObg, { "E", "estado"        , "A1_ESTE"         , .F. } )
                Aadd( aCamposObg, { "E", "complemento"   , "A1_COMPENT"      , .F. } )

            Case cTipoEnd == "2"  // Cobrança

                // campos de endereço para o tipo "Cobrança"
                Aadd( aCamposObg, { "C", "endereco"      , "A1_ENDCOB"       , .F. } )
                Aadd( aCamposObg, { "C", "bairro"        , "A1_BAIRROC"      , .F. } )
                Aadd( aCamposObg, { "C", "cep"           , "A1_CEPC"         , .F. } )
                Aadd( aCamposObg, { "C", "cidade"        , "A1_MUNC"         , .F. } )
                Aadd( aCamposObg, { "C", "estado"        , "A1_ESTC"         , .F. } )

        EndCase 

    EndIf

    // verifica quais os campos de endereço são obrigatorios
    For nInd := 1 To Len( aCamposObg )

        cCampo := AllTrim( aCamposObg[nInd][3] )
        nObrig := aScan( aSA1Struct, {|x| AllTrim( x[1] ) == cCampo } )

        If nObrig > 0
            aCamposObg[nInd][4] := .T.
        EndIf

    Next nInd

Return aCamposObg

/*/{Protheus.doc} ClienteObj::ValidEndObrigatorios
Metodo construido para realizar as Validações da tag de Endereços.
@type method
@author Carlos Chigres
@since 12/05/2026
@param nInd, numeric, posicao do titulo
@return array, retorno com status logico e mensagem
/*/
Method ValidEndObrigatorios( nPos as Numeric ) as Array Class ClienteObj

    Local lRet          as Logical
    Local nInd          as Numeric
    Local cMensagem     as Character
    Local cPerfil       as Character
    Local aCamposObg    as Array

    Default nPos  := 0

    lRet        := .T.
    nInd        := 1
    cMensagem   := ""
    aCamposObg  := self:EnderecoObrigat( nPos )  // Raiz / entrega / cobrança

    For nInd := 1 To Len( aCamposObg )

        If aCamposObg[nInd][4]  // se o campo for obrigatorio, realiza as validacoes

            // trecho que verifica o conjunto raiz dos campos de endereço
            If nPos == 0 

                // primeira triagem : tag existe e conteudo nao vazio
                If !self:jBody:hasProperty( aCamposObg[nInd][2] ) .Or. ;
                    Empty( self:jBody[ aCamposObg[nInd][2] ] ) 

                    lRet      := .F.
                    cMensagem := I18n("A informação contida na tag #1 não foi enviada, ou não é valida.", { aCamposObg[nInd][2] } ) 
                    Exit

                EndIf

                // segunda triagem : tipo da informação contida na tag
                If lRet 

                    If ValType( self:jBody[ aCamposObg[nInd][2] ] ) <> "C"
                        lRet      := .F.
                        cMensagem := I18n("O tipo da informação contida na tag #1 não é String.", { aCamposObg[nInd][2] } ) 
                        Exit
                    EndIf

                EndIf 

            // trecho para verificar a lista de Endereços 
            Else 

                cPerfil := If( aCamposObg[nInd][1] == "E", "Entrega", "Cobrança" )

                // primeira triagem : tag existe e conteudo nao vazio
                If !self:jBody["Enderecos"][nPos]:hasProperty( aCamposObg[nInd][2] ) .Or. ;
                    Empty( self:jBody["Enderecos"][nPos][ aCamposObg[nInd][2] ] ) 

                    lRet      := .F.
                    cMensagem := I18n("Tipo " + cPerfil + " : a informação contida na tag Enderecos.#1 não foi enviada, ou não é valida.", { aCamposObg[nInd][2] } ) 
                    Exit

                EndIf

                // segunda triagem : tipo da informação contida na tag
                If lRet 

                    If ValType( self:jBody["Enderecos"][nPos][ aCamposObg[nInd][2] ] ) <> "C"
                        lRet      := .F.
                        cMensagem := I18n("Tipo " + cPerfil + " : a informação contida na tag Enderecos.#1 não é String.", { aCamposObg[nInd][2] } ) 
                        Exit
                    EndIf

                EndIf 

            EndIf 

        EndIf

    Next nInd

Return { lRet, cMensagem }

/*/{Protheus.doc} ClienteObj::VerificaEndereco
Metodo construido para realizar as Validações da tag de Endereços.
@type method
@author Carlos Chigres
@since 13/05/2026
@return array, status logico e mensagem 
/*/
Method VerificaEndereco() as Array Class ClienteObj

    Local nInd      as Numeric
    Local lRetorno  as Logical
    Local aRetorno  as Array
    Local cMensagem as Character

    lRetorno  := .T.
    cMensagem := ""

    // verificação de multiplos endereços
    For nInd := 1 To Len( self:jBody["Enderecos"] )

        // Validacao das Tags obrigatorias, dentro de "Enderecos"
        aRetorno    := self:ValidEndObrigatorios( nInd )
        lRetorno    := aRetorno[ 1 ]
        cMensagem   := "Endereço posição nro " + cValToChar( nInd ) + " - " + aRetorno[ 2 ]

        // Atualizacao do array de mensagens 
        If !lRetorno
            Exit
        EndIf

    Next nInd 

Return { lRetorno, cMensagem }

/*/{Protheus.doc} ClienteObj::execCliente
Metodo construido para realizar as operações de Inclusão, ou Alteração, 
do Cadastro de Clientes, via execauto CRMA980.
@type method
@author Carlos Chigres
@since 6/8/2026
@return variant, retorna nil
/*/
Method execCliente() as Variant Class ClienteObj

    Local aCliente      as Array
    Local aDateTime     as Array
    Local aErroAuto     as Array
    Local aErrPontos    as Array
    Local nX            as Numeric
    Local nOpcCli       as Numeric
    Local cCodCli       as Character
    Local cCodLoja      as Character
    Local cIniPad       as Character
    Local cNome         as Character
    Local cErro         as Character
    Local cErroAuto     as Character
    Local cMensagem     as Character
    Local cPessoaFisica as Character
    Local cDataNascime  as Character
    Local cInfDDD       as Character
    Local cInfTEL       as Character
    Local cLogradouro   as Character
    Local cCodMun       as Character

    Private lMsErroAuto     := .F. //Variavel que informa a ocorrência de erros no ExecAuto
    Private lAutoErrNoFile 	:= .T. //força a gravação das informações de erro em array para manipulação da gravação ao invés de gravar direto no arquivo temporário

    aErroAuto       := {}
    aErrPontos      := {"< -- Invalido"}
    aDateTime       := {}
    aCliente        := {}
    cCodCli         := SubStr( self:jBody["idRetaguarda"] , 1, 6 )  
    cCodLoja        := SubStr( self:jBody["idRetaguarda"] , 7, 2 )  
    cIniPad         := GetSx3Cache("A1_COD","X3_RELACAO")   // Inicializador padrao do cliente
    cErro           := ""
    cErroAuto       := ""
    cMensagem       := "Não foi possível completar a operação para o cadastro do cliente. Verifique possíveis campos obrigatório(s) ou inválido(s)."
    nX              := 1
    nOpcCli         := If( Empty( cCodCli ) , 3 , 4 )       // 3-Inclusão, 4-Alteração
    cNome           := Upper( Alltrim( NoAcento( self:jBody["nome"] ) ) )
    cPessoaFisica   := If( self:jBody["pessoaFisica"] == 1 , "F" , "J" )
    cDataNascime    := If( self:jBody:hasProperty("dataNascimento") , self:jBody["dataNascimento"] , "" )
    cCodMun         := Posicione('CC2',4,xFilial('CC2') + self:jBody['estado'] + Upper( PadR( fwNoAccent( self:jBody['cidade'] ), TamSX3('CC2_MUN')[1] ) ),'CC2_CODMUN')

    If !Empty( cDataNascime ) 
        aDateTime := FwDateTimeToLocal( cDataNascime ) // convertendo para data local do Protheus
    EndIf

    If Empty( cCodCli )

        cCodLoja := SuperGetMV('MV_LOJAPAD',.F., '01')

        If Empty( cIniPad )
            Aadd( aCliente , {"A1_COD" , MATI030Num(), Nil } )
        EndIf    
    Else 
        Aadd( aCliente , {"A1_COD" , cCodCli , Nil } )
    EndIf

    // separando DDD do numero telefone / celular
    cInfDDD := SubStr( cValToChar( IIf(!Empty(self:jBody['celular']), self:jBody['celular'], self:jBody['telefone'])),1,2)
    cInfTEL := SubStr( cValToChar( IIf(!Empty(self:jBody['celular']), self:jBody['celular'], self:jBody['telefone'])),3)

    // acomodando a tag "numero" no endereço
    cLogradouro := self:jBody["endereco"]

    If Rat( ',', self:jBody["endereco"] ) == 0
        If self:jBody:hasProperty("numero") .And. !Empty( self:jBody["numero"] )
            cLogradouro := AllTrim( self:jBody["endereco"] ) + " , " + AllTrim( self:jBody["numero"] )
        EndIf
    EndIf

    Aadd(aCliente , {"A1_LOJA"    , cCodLoja                                    , Nil})
    Aadd(aCliente , {"A1_NOME"    , cNome                                       , Nil})
    Aadd(aCliente , {"A1_NREDUZ"  , SubStr(cNome, 1, Tamsx3("A1_NREDUZ")[1])    , Nil})
    Aadd(aCliente , {"A1_CGC"     , self:jBody["cpfCnpj"]                       , Nil})
    Aadd(aCliente , {"A1_DDD"     , cInfDDD                                     , Nil})
    Aadd(aCliente , {"A1_TEL"     , cInfTEL                                     , Nil})
    Aadd(aCliente , {"A1_TIPO"    , "F"                                         , Nil})
    Aadd(aCliente , {"A1_PESSOA"  , cPessoaFisica                               , Nil})  // F=Fisica;J=Juridica 
    Aadd(aCliente , {"A1_END"     , cLogradouro                                 , Nil})
    Aadd(aCliente , {"A1_COMPLEM" , Upper( self:jBody["complemento"] )          , Nil})
    Aadd(aCliente , {"A1_MUN"     , Upper( NoAcento( self:jBody["cidade"] ) )   , Nil})
    Aadd(aCliente , {"A1_BAIRRO"  , Upper( NoAcento( self:jBody["bairro"] ) )   , Nil})
    Aadd(aCliente , {"A1_EST"     , self:jBody["estado"]                        , Nil})
    Aadd(aCliente , {"A1_CEP"     , self:jBody["cep"]                           , Nil})
    Aadd(aCliente , {"A1_EMAIL"   , PadR(self:jBody["email"],TAMSX3("A1_EMAIL")[1]), Nil})
    Aadd(aCliente , {"A1_DTCAD"   , date()                                      , Nil})
    Aadd(aCliente , {"A1_MSBLQL"  , "2"                                         , Nil})
    Aadd(aCliente , {"A1_COD_MUN"  , cCodMun                                    , Nil})

    If self:jBody["pessoaFisica"] == 1  // Fisica
        Aadd(aCliente,{"A1_RG"     , self:jBody["rgInscricao"]                , Nil})
    Else 
        Aadd(aCliente,{"A1_INSCR"  , self:jBody["rgInscricao"]                , Nil})
    EndIf

    If Len( aDateTime ) > 0 
        cDataNascime  := aDateTime[1]  
        Aadd(aCliente,{"A1_DTNASC"  , cDataNascime                , Nil})
    EndIf

    // Adicionando os campos complementares de endereço
    If self:jBody:hasProperty("Enderecos") .And. Len( self:jBody["Enderecos"] ) > 0
        self:EnderecoComplementar( @aCliente ) 
    EndIf

    ljGrvLog("LJClienteObj", "Chamando a execauto CRMA980 para a operação do cliente.", aCliente)

    MsExecAuto( {|a,b| CRMA980(a,b)}, aCliente, nOpcCli )

    If lMsErroAuto

        RollBackSX8()   
        aErroAuto := GetAutoGrLog()

        ljxjMsgErr("Execauto CRMA980 retornou erro na operação do cliente pela api de integração on line.", /*cSolucao*/, "LJClienteObj", {aCliente, aErroAuto})

        //Tratar para pegar apenas a Linha que apresenta o campo com "< -- Invalido"
        For nX := 1 TO Len(aErroAuto)
            If aScan( aErrPontos, {|cTexto| upper(cTexto) $ upper(aErroAuto[nX])} ) > 0
                cErro += aErroAuto[nX] + Chr(10)
            EndIf
            cErroAuto += aErroAuto[nX] + CRLF
        Next nX

        cErro := IIF( empty(cErro), cErroAuto, cErro )

        self:lSuccess   := .F.
        self:cError     := cMensagem + " " + cErro  

    Else

        ConfirmSX8()

        If nOpcCli == 3
            self:jBody["idRetaguarda"] := SA1->A1_COD + SA1->A1_LOJA
        EndIf

    EndIf

Return nil

/*/{Protheus.doc} ClienteObj::EnderecoComplementar
Metodo construido para adicionar ao array do execauto os campos
de Endereço de Entrega e de Endereço de Cobrança
@type method
@author Carlos Chigres
@since 6/8/2026
@param aCliente, array, campos do execauto, enviado por referencia
@return array, array com os campos complementares de endereço para o execauto CRMA980
/*/
Method EnderecoComplementar( aCliente ) as Array Class ClienteObj

    Local nInd            as Numeric
    Local cLogradouro     as Character
    Local cTipoEnd        as Character

    // verificação de multiplos endereços
    For nInd := 1 To Len( self:jBody["Enderecos"] )

        // acomodando a tag "numero" no endereço
        cLogradouro := self:jBody["Enderecos"][nInd]["endereco"]

        If !Empty( cLogradouro )
            If Rat( ',', self:jBody["Enderecos"][nInd]["endereco"] ) == 0
                If self:jBody["Enderecos"][nInd]:hasProperty("numero") .And. !Empty( self:jBody["Enderecos"][nInd]["numero"] )
                    cLogradouro := AllTrim( self:jBody["Enderecos"][nInd]["endereco"] ) + " , " + AllTrim( self:jBody["Enderecos"][nInd]["numero"] )
                EndIf
            EndIf
        EndIf

        cTipoEnd := self:jBody["Enderecos"][nInd]["tipo"]

        If cTipoEnd == "0"  // Entrega
            Aadd(aCliente , {"A1_ENDENT"   , cLogradouro                                                  , Nil})
            Aadd(aCliente , {"A1_COMPENT"  , Upper( self:jBody["Enderecos"][nInd]["complemento"] )        , Nil})
            Aadd(aCliente , {"A1_MUNE"     , Upper( NoAcento( self:jBody["Enderecos"][nInd]["cidade"] ) ) , Nil})
            Aadd(aCliente , {"A1_BAIRROE"  , Upper( NoAcento( self:jBody["Enderecos"][nInd]["bairro"] ) ) , Nil})
            Aadd(aCliente , {"A1_ESTE"     , self:jBody["Enderecos"][nInd]["estado"]                      , Nil})
            Aadd(aCliente , {"A1_CEPE"     , self:jBody["Enderecos"][nInd]["cep"]                         , Nil})
        EndIf

        If cTipoEnd == "2"  // Cobrança
            Aadd(aCliente , {"A1_ENDCOB"   , cLogradouro                                                  , Nil})
            Aadd(aCliente , {"A1_MUNC"     , Upper( NoAcento( self:jBody["Enderecos"][nInd]["cidade"] ) ) , Nil})
            Aadd(aCliente , {"A1_BAIRROC"  , Upper( NoAcento( self:jBody["Enderecos"][nInd]["bairro"] ) ) , Nil})
            Aadd(aCliente , {"A1_ESTC"     , self:jBody["Enderecos"][nInd]["estado"]                      , Nil})
            Aadd(aCliente , {"A1_CEPC"     , self:jBody["Enderecos"][nInd]["cep"]                         , Nil})
        EndIf

    Next nInd 

Return 
