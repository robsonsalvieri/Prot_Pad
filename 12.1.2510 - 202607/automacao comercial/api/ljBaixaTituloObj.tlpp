#INCLUDE "TOTVS.CH"

namespace totvs.protheus.retail.rmi.api.ljBaixaTituloObj

//-------------------------------------------------------------------
/*/{Protheus.doc} Classe BaixaTituloObj
    Classe para tratamento da API de Baixa de Titulos a Receber
/*/
//-------------------------------------------------------------------
Class BaixaTituloObj From LojRestObj20

	Public Method New()                 as Object
    Public Method getReturn()           as Character
    Public Method ProcessaTitulo()      as Array
    Public Method ValidaObrigatorios()  as Array
    Public Method CamposObrigat()       as Array
    Public Method DescTipoCampo()       as Character
    Public Method ConverteMsg()         as Character

    Protected Method Validation()       as Variant

    Private Data aMensagTitulo          as Array

EndClass

//-------------------------------------------------------------------
/*/{Protheus.doc} new
Método construtor da Classe

@param oWsRestObj - Objeto WSRESTFUL da API

@author  Carlos Chigres
@since   11/05/2026
@version 1.0
/*/
//-------------------------------------------------------------------
Method New(oWsRestObj As Object) as Object Class BaixaTituloObj
    
    _Super:New(oWsRestObj, /*jParans*/, /*cBody*/)    

    self:aMensagTitulo := {}

Return self

//-------------------------------------------------------------------
/*/{Protheus.doc} Validation
Metodo para validações executado no momento do get

@author  Carlos Chigres
@since   11/05/2026
@version 1.0
/*/
//-------------------------------------------------------------------
Method Validation(cOrigem as Character) as Variant Class BaixaTituloObj

    Local aRetorno      as Array
    Local lFind         as Logical

    aRetorno := {} 
    lFind    := .F.

    _Super:Validation()

    If self:lSuccess

        If cOrigem == "GET"

            // Validacao da Tag titulos
            If self:lSuccess .And. ( !self:jBody:hasProperty("titulos") .Or. Len( self:jBody["titulos"] ) == 0 )
                self:lSuccess := .F.
                self:cError   := I18n("Ops! A informacao contida na tag #1 não foi enviada, ou não é valida.", { "titulos" } )
            EndIf

            // Validacao do(s) titulo(s)
            If self:lSuccess .And. self:jBody:hasProperty("titulos") .And. Len( self:jBody["titulos"] ) > 0

                aRetorno        := self:ProcessaTitulo()
                self:lSuccess   := If( Len( self:aMensagTitulo ) == 0, .T., .F. )
                self:cError     := aRetorno[2]

            EndIf

        EndIf

        If self:lSuccess
            LjGrvLog("estoqueObj", "Requisição na API de estoque", self:jParans:toJson())
        EndIf

    EndIf

Return Nil

/*/{Protheus.doc} BaixaTituloObj::GetReturn
Retorna json com resultado da consulta
@type method
@author Carlos Chigres
@since 4/23/2026
/*/
Method GetReturn() as Character Class BaixaTituloObj

    Local jRetorno          as Object 
    Local aAuxiliar         as Array
    Local cRetorno          as Character
    Local nTotal            as Integer 
    Local cMensagem         as Character
    
    jRetorno:= JsonObject():New()
    jRetorno:FromJson( _Super:GetReturn() )

    nTotal    := Len( jRetorno["data"] )
    aAuxiliar := aClone( jRetorno["data"] )
    cMensagem := jRetorno["message"]

    jRetorno["data"] := JsonObject():New()    
    jRetorno["message"] := ""

    If self:lSuccess
        jRetorno["data"]    := aAuxiliar
        jRetorno["message"] := "Todos os titulos foram processados com sucesso."
    Else 
        If Empty( self:ConverteMsg() )
            jRetorno["message"] := cMensagem
        Else
            jRetorno["message"] := self:ConverteMsg() 
        EndIf
    EndIf    
   
    jRetorno["errors"]          := nil
    jRetorno["totalTime"]       := time()
    jRetorno["numberOfRecords"] := nTotal
   
    cRetorno := jRetorno:toJson()
    FwFreeObj(jRetorno)
    
Return cRetorno

/*/{Protheus.doc} BaixaTituloObj::ValidaObrigatorios
Metodo construido para realizar as Validações do Payload enviado;
nesse método, os campos obrigatórios estão dentro da tag "titulos".
@type method
@author Carlos Chigres
@since 12/05/2026
@param nInd, numeric, posicao do titulo
@return array, retorno com status logico e mensagem
/*/
Method ValidaObrigatorios( nPos as Numeric ) as Array Class BaixaTituloObj

    Local lRet          as Logical
    Local nInd          as Numeric
    Local cMensagem     as Character
    Local cDateTime     as Character
    Local aDateTime     as Array
    Local aCamposObg    as Array

    lRet        := .T.
    nInd        := 1
    cMensagem   := ""
    cDateTime   := ""
    aDateTime   := {}
    aCamposObg  := self:CamposObrigat()

    For nInd := 1 To Len( aCamposObg )

        // primeira triagem : tag existe e conteudo nao vazio
        If !self:jBody["titulos"][nPos]:hasProperty( aCamposObg[nInd][1] ) .Or. ;
            Empty( self:jBody["titulos"][nPos][ aCamposObg[nInd][1] ] ) 

            lRet := .F.
            cMensagem := I18n("A informacao contida na tag titulos.#1 não foi enviada, ou não é valida.", { aCamposObg[nInd][1] } ) 

            Exit
        EndIf

        // segunda triagem : tipo da informacao contida na tag
        If lRet 

            Do Case 

                Case aCamposObg[nInd][2] == "D"

                    cDateTime := self:jBody["titulos"][nPos][ aCamposObg[nInd][1] ]
                    aDateTime := FwDateTimeToLocal( cDateTime ) 

                    If Len( aDateTime ) > 0 
                        If Empty( aDateTime[1] ) 
                            lRet := .F.
                            cMensagem := I18n("O tipo da informacao contida na tag titulos.#1 não é Data.", { aCamposObg[nInd][1] } ) 
                            Exit
                        Endif
                    Endif

                OtherWise 

                    If ValType( self:jBody["titulos"][nPos][ aCamposObg[nInd][1] ] ) <> aCamposObg[nInd][2] 
                        lRet := .F.
                        cMensagem := I18n("O tipo da informacao contida na tag titulos.#1 não é #2.", { aCamposObg[nInd][1], self:DescTipoCampo( aCamposObg[nInd][2] ) } ) 
                        Exit
                    EndIf

            EndCase 

        EndIf 

    Next nInd

Return { lRet, cMensagem }

/*/{Protheus.doc} BaixaTituloObj::ProcessaTitulo
Faz as validacoes de Tags Obrigatorias, e a consistencia de valores de baixa.
@type method
@author Carlos Chigres
@since 13/05/2026
@return array, status logico e mensagem 
/*/
Method ProcessaTitulo() as Array Class BaixaTituloObj

    Local nInd      as Numeric
    Local lRetorno  as Logical
    Local aRetorno  as Array
    Local cMensagem as Character

    For nInd := 1 To Len( self:jBody["titulos"] )

        // Validacao das Tags obrigatorias, dentro de "titulos"
        aRetorno    := self:ValidaObrigatorios( nInd )
        lRetorno    := aRetorno[1]
        cMensagem   := aRetorno[2]

        // Atualizacao do array de mensagens 
        If !lRetorno
            If ValType( self:jBody["titulos"][nInd]["idRetaguardaTitulo"] ) == "C"
                Aadd( self:aMensagTitulo, { self:jBody["titulos"][nInd]["idRetaguardaTitulo"], cMensagem } )
            Else 
                Aadd( self:aMensagTitulo, { "não identificado - posição nro " + cValToChar( nInd ) , cMensagem } )
            EndIf
        EndIf

        If lRetorno

            // Validacao titulos.vendaPagamentos
            If !self:jBody["titulos"][nInd]:hasProperty("vendaPagamentos") .Or. ;
                Len( self:jBody["titulos"][nInd]["vendaPagamentos"] ) == 0 

                lRetorno    := .F.
                cMensagem   := I18n("Ops! A informacao contida na tag titulos.#1 não foi enviada, ou não é valida.", { "vendaPagamentos" } )

                If !lRetorno
                    Aadd( self:aMensagTitulo, { self:jBody["titulos"][nInd]["idRetaguardaTitulo"], cMensagem } )
                EndIf

            EndIf

        EndIf

        If lRetorno

            // Verificando se o titulo existe na Base 
            SE1->( dbSetOrder( 1 ) )
            lFind := SE1->( dbSeek( self:jBody["titulos"][nInd]["idRetaguardaTitulo"] ) )

            If lFind
                // Verificando se o titulo já se encontra baixado
                If SE1->E1_SALDO == 0
                    lRetorno    := .F.
                    cMensagem   := I18n("Ops! O titulo informado se encontra 100% baixado.")
                    Aadd( self:aMensagTitulo, { self:jBody["titulos"][nInd]["idRetaguardaTitulo"], cMensagem } )
                EndIf
            Else 
                lRetorno    := .F.
                cMensagem   := I18n("Ops! O titulo informado nao foi encontrado na base de dados.")
                Aadd( self:aMensagTitulo, { self:jBody["titulos"][nInd]["idRetaguardaTitulo"], cMensagem } )
            EndIf 

        EndIf

    Next nInd 

Return { lRetorno, cMensagem }

/*/{Protheus.doc} CamposObrigat
Metodo que retorna os campos obrigatorios da tag "titulo" 
@type method
@author Carlos Chigres
@since 12/05/2026
@return array, lista de tags obrigatorias
/*/
Method CamposObrigat() as Array Class BaixaTituloObj

    Local aCamposObg as Array

    aCamposObg := {}

    Aadd( aCamposObg, { "idRetaguardaTitulo", "C" } )
    Aadd( aCamposObg, { "numeroTitulo"      , "C" } )
    Aadd( aCamposObg, { "valorTitulo"       , "N" } )
    Aadd( aCamposObg, { "valorLiquido"      , "N" } )
    Aadd( aCamposObg, { "dataPagamento"     , "D" } )

Return aCamposObg

/*/{Protheus.doc} BaixaTituloObj::DescTipoCampo
Metodo construido para retornar em extenso o tipo do campo
@type method
@author Carlos Chigres
@since 5/28/2026
@param cTipo, character, tipo do campo
@return character, descricao do tipo 
/*/
Method DescTipoCampo( cTipo as Character ) as Character Class BaixaTituloObj

    Local cDescTipo as Character

    cDescTipo := " "

    Do Case 

        Case cTipo == "C"
            cDescTipo := "String"

        Case cTipo == "N"
            cDescTipo := "Numerico"

    EndCase

Return cDescTipo

/*/{Protheus.doc} BaixaTituloObj::ConverteMsg
Metodo construido para detalhar as mensagens de erro, de cada um dos titulos apreciados
@type method
@author Carlos Chigres
@since 14/05/2026
@return object, retorna um objeto json com a estrutura: { titulo: "numero do titulo", mensagens: [ "msg1", "msg2" ] }
/*/
Method ConverteMsg() as Character Class BaixaTituloObj

    Local nI            as Numeric
    Local cTitulo       as Character
    Local cResult       as Character

    nI          := 1
    cTitulo     := ""

    While nI <= Len( self:aMensagTitulo )

        cTitulo := self:aMensagTitulo[nI][1]
        cResult += "Titulo : " + cTitulo + " - mensagens: ["

        While cTitulo == self:aMensagTitulo[nI][1] 

            cResult += self:aMensagTitulo[nI][2] 

            nI ++ 
            If nI > Len( self:aMensagTitulo )
                Exit
            EndIf
        Enddo
        cResult += "] " 

    Enddo

Return cResult
