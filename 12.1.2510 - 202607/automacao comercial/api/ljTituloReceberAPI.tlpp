#INCLUDE "TLPP-CORE.TH"
#INCLUDE "TLPP-REST.TH"

namespace totvs.protheus.retail.rmi.api.ljtituloreceberapi

using namespace totvs.protheus.retail.rmi.api.ljtituloreceberobj


/*/{Protheus.doc} tituloConsulta
API para consulta de Titulos a Receber de um CPF/CNPJ
@type function
@author Carlos Chigres
@since 4/24/2026
/*/
@Get("/api/retail/v1/ljtituloreceber/:idRetaguardaLoja")
Function tituloConsulta()
    Local cReturn           := ""
    Local otituloreceber    := Nil

    otituloreceber := tituloreceberobj():New(oRest)
    
    otituloreceber:Get()    
    cReturn := otituloreceber:getReturn()    
    LjGrvLog("/api/retail/v1/ljtituloreceber/","Return: ",cReturn)

    IIf(Empty(cReturn),Eval({|| oRest:setStatusCode(500), cReturn := "Ops! A consulta não retornou um json válido. Por favor, verifique os logs do Protheus (Console, LogLoja) para analisar o ocorrido."}),) 
        
    oRest:setResponse(cReturn)   
Return
