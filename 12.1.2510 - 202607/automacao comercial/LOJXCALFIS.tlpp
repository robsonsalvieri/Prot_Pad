#include "totvs.ch"
#include "tlpp-core.th"
#include "LOJXCALFIS.ch"

namespace totvs.protheus.retail.calculator

//------------------------------------------------------------------------------
/*/{Protheus.doc} LjCalcFis
Realiza o cálculo fiscal (via motor MATXFIS) considerando os dados de uma venda.

@type    class
@author  Alberto Deviciente
@since   19/05/2026
@version P12
/*/
//------------------------------------------------------------------------------
class LjCalcFis

    Private Data cCliente    as Character
    Private Data cLoja       as Character
    Private Data nDescCab    as Numeric
    Private Data nAcrescCab  as Numeric
    Private Data cTpFrete    as Character
    Private Data nFrete      as Numeric
    Private Data nSeguro     as Numeric
    Private Data nDespesa    as Numeric
    Private Data cTpMov      as Character     //Tipo de movimento ("C" = cliente, "F" = fornecedor)
    Private Data cTpNF       as Character     //Tipo da NF ( "N","D","B","C","P","I" )
    Private Data cTpCli      as Character     //Tipo de cliente (A1_TIPO)
    Private Data lEmiteNF    as Logical       // .T. = NF-e; .F. = cupom fiscal
    Private Data lCalcTG     as Logical
    Private Data nNumItem    as Numeric
    Private Data cMsgError   as Character

    Private Method ValidDataHeader() as Logical
    Private Method ValidDataItem(cProduto as Character, cTES as Character, nRecnoSB1 as Numeric, nRecnoSF4 as Numeric) as Logical
    Private Method GetItemCalculationDetails(nItem as Numeric) as Array

    Public Method New() as Object
    Public Method SetDataHeader(cCliente as Character, cLoja as Character, nDescCab as Numeric, nAcrescCab as Numeric, cTpFrete as Character, nFrete as Numeric, nSeguro as Numeric, nDespesa as Numeric) as Logical
    Public Method SetDataItem(cProduto as Character, nQuant as Numeric, nPrcUni as Numeric, nDescItem as Numeric) as Logical
    Public Method GetDataCalculated() as Array
    Public Method Destroy() as Logical
    Public Method GetMsgError() as Character

endclass

//------------------------------------------------------------------------------
/*/{Protheus.doc} New
Método construtor

@type    method
@author  Alberto Deviciente
@since   19/05/2026
@version P12

@return object, Instância da classe LjCalcFis.
/*/
//------------------------------------------------------------------------------
method New() class LjCalcFis

::cCliente      := ""
::cLoja         := ""
::cTpMov        := "C"      //Tipo de movimento ("C" = cliente, "F" = fornecedor)
::cTpNF         := "N"      //Tipo da NF ( "N","D","B","C","P","I" )
::cTpCli        := ""       //Tipo de cliente (A1_TIPO)
::nFrete        := 0
::nSeguro       := 0
::nDespesa      := 0
::nDescCab      := 0
::nAcrescCab    := 0
::cTpFrete      := ""
::lCalcTG       := FindFunction("LjCfgTrib") .And. LjCfgTrib() //Verifica se o ambiente apto para uso do Configurador de Tributos
::lEmiteNF      := .T.      // .T. = NF-e; .F. = cupom fiscal
::nNumItem      := 0
::cMsgError     := ""

return Self

//------------------------------------------------------------------------------
/*/{Protheus.doc} SetDataHeader
Seta os dados do cabeçalho da venda.

@type    method
@author  Alberto Deviciente
@since   19/05/2026
@version P12

@param cCliente    , caracter, Código do cliente (A1_COD)
@param cLoja       , caracter, Loja do cliente (A1_LOJA)
@param nDescCab    , numérico, Desconto no total
@param nAcrescCab  , numérico, Acréscimo no total
@param cTpFrete    , caracter, Tipo de Frete (C=CIF; F=FOB; T=Por conta terceiros; R=Por conta remetente; D=Por conta destinatário; S=Sem frete)
@param nFrete      , numérico, Valor do Frete
@param nSeguro     , numérico, Valor do Seguro
@param nDespesa    , numérico, Valor de Outras Despesas

@return logical, .T. = dados válidos / .F. = dados inválidos
/*/
//------------------------------------------------------------------------------
method SetDataHeader(cCliente as Character, cLoja as Character, nDescCab as Numeric, nAcrescCab as Numeric, cTpFrete as Character, nFrete as Numeric, nSeguro as Numeric, nDespesa as Numeric) as Logical class LjCalcFis
Local lDadosOk  as Logical

Default nDescCab    := 0
Default nAcrescCab  := 0
Default nFrete      := 0
Default nSeguro     := 0
Default nDespesa    := 0

::cCliente    := AllTrim(cCliente)
::cLoja       := AllTrim(cLoja)
::nDescCab    := nDescCab
::nAcrescCab  := nAcrescCab
::cTpFrete    := AllTrim(cTpFrete)
::nFrete      := nFrete
::nSeguro     := nSeguro
::nDespesa    := nDespesa

//Valida parametros recebidos
lDadosOk := ::ValidDataHeader()

If lDadosOk
    If MaFisFound()
        MaFisEnd()
    EndIf

    // Inicializa a MATXFIS
    MaFisIni(;
        ::cCliente,;        //01-Codigo do Cliente ou Fornecedor
        ::cLoja,;           //02-Loja do Cliente ou Fornecedor
        ::cTpMov,;          //03-C:Cliente , F:Fornecedor
        ::cTpNF,;           //04-Tipo da NF ( "S", "N","D","B","C","P","I" )
        ::cTpCli,;          //05-Tipo do Cliente (A1_TIPO) ou Fornecedor (A2_TIPO)
        Nil,;               //06-Relacao de Impostos que suportados no arquivo
        Nil,;               //07-Tipo de complemento
        Nil,;               //08-Permite Incluir Impostos no Rodape .T./.F.
        Nil,;               //09-Alias do Cadastro de Produtos - ("SBI" P/ Front Loja)
        Nil,;               //10-Nome da rotina que esta utilizando a funcao
        Nil,;               //11-Tipo de documento
        Nil,;               //12-Especie do documento
        Nil,;               //13-Codigo e Loja do Prospect
        Nil,;               //14-Grupo Cliente
        Nil,;               //15-Recolhe ISS
        Nil,;               //16-Codigo do cliente de entrega na nota fiscal de saida
        Nil,;               //17-Loja do cliente de entrega na nota fiscal de saida
        {"", ""},;          //18-Informacoes do transportador [01]-UF,[02]-TPTRANS
        ::lEmiteNF,;        //19-Se esta emitindo nota fiscal ou cupom fiscal (Sigaloja)
        Nil,;               //20-Define se calcula IPI (SIGALOJA)
        Nil,;               //21-Pedido de Venda
        Nil,;               //22-Cliente do faturamento ( cCodCliFor é passado como o cliente de entrega, pois é o considerado na maioria das funções fiscais, exceto ao gravar o clinte nas tabelas do livro)
        Nil,;               //23-Loja do cliente do faturamento
        Nil,;               //24-Total do Pedido
        Nil,;               //25-Data de emissão do documento inicialmente só é diferente de dDataBase nas notas de entrada (MATA103 e MATA910)
        ::cTpFrete,;        //26-Tipo de Frete informado no pedido
        Nil,;               //27-Indica se Calcula (PIS,COFINS,CSLL), independete da TES estar configurada para Gerar Duplicata (F4_DUPLIC)
        Nil,;               //28-Indica se Calcula (INSS), independete da TES estar configurada para Gerar Duplicata (F4_DUPLIC)
        Nil,;               //29-Indica se Calcula (IRRF), independete da TES estar configurada para Gerar Duplicata (F4_DUPLIC)
        Nil,;               //30-Tipo de Complemento
        Nil,;               //31-Cliente de destino de transporte (Notas de entrada de transporte )
        Nil,;               //32-Loja de destino de transporte (Notas de entrada de transporte )
        ::lCalcTG;          //33-Flag para indicar se os tributos genéricos devem ou não ser calculados - deve ser passado como .T. somente após a preparação da rotina para gravação, visualização e exclusão dos tributos genéricos.33
    )
EndIf

Return lDadosOk

//------------------------------------------------------------------------------
/*/{Protheus.doc} SetDataItem
Adiciona um item para cálculo fiscal.

@type    method
@author  Alberto Deviciente
@since   19/05/2026
@version P12

@param cProduto , caracter, Código do produto (SB1->B1_COD)
@param nQuant   , numérico, Quantidade
@param nPrcUni  , numérico, Preço unitário
@param nDescItem, numérico, Desconto do item

@return logical, .T. = dados válidos / .F. = dados inválidos
/*/
//------------------------------------------------------------------------------
method SetDataItem(cProduto as Character, nQuant as Numeric, nPrcUni as Numeric, nDescItem as Numeric) as Logical class LjCalcFis
Local lDadosOk      as Logical
Local aAreaSB1      as Array
Local aAreaSF4      as Array
Local cTES          as Character
Local nValMerc      as Numeric
Local nRecnoSB1     as Numeric
Local nRecnoSF4     as Numeric

Default nDescItem   := 0

aAreaSB1    := SB1->(GetArea())
aAreaSF4    := SF4->(GetArea())
cTES        := ""
nRecnoSB1   := 0
nRecnoSF4   := 0

//Valida parametros recebidos
lDadosOk := ::ValidDataItem(@cProduto, @cTES, @nRecnoSB1, @nRecnoSF4)

If lDadosOk
    nValMerc    := (nQuant * nPrcUni)

    ::nNumItem++

    MaFisIniLoad(	::nNumItem					,;	//Numero do Item
                    {cProduto			        ,;	//IT_PRODUTO
                    cTES						,; 	//IT_TES
                    ""				            ,; 	//IT_CODISS
                    nQuant			            ,;	//IT_QUANT
                    ""							,; 	//IT_NFORI
                    ""							,; 	//IT_SERIORI
                    nRecnoSB1   				,;	//IT_RECNOSB1
                    nRecnoSF4   				,;	//IT_RECNOSF4
                    0  							}) 	//IT_RECORI
    
    MaFisLoad("IT_PRCUNI",   nPrcUni,    ::nNumItem)
    MaFisLoad("IT_VALMERC",  nValMerc,   ::nNumItem)
    MaFisLoad("IT_DESCONTO", nDescItem,  ::nNumItem)
    MaFisRecal("", ::nNumItem)
    MaFisEndLoad(::nNumItem, 2)

EndIf

RestArea(aAreaSB1)
RestArea(aAreaSF4)

Return lDadosOk

//------------------------------------------------------------------------------
/*/{Protheus.doc} GetDataCalculated
Executa o cálculo fiscal via MATXFIS. Retorna um array com o resultado do 
cálculo, totais do cabeçalho, detalhes dos itens e impostos calculados.

@type    method
@author  Alberto Deviciente
@since   19/05/2026
@version P12

@return array, { {lOk, cMsg}, aCabecalho, aItensCalc }
    lOk         : logical, .T. se o cálculo foi realizado com sucesso, .F. caso contrário
    cMsg        : character, mensagem de status ou erro da execução do cálculo fiscal
    aCabecalho  : array de arrays, onde cada sub-array contém as seguintes informações do cabeçalho da venda:
        [1] - NF_VALMERC: Valor Total de Mercadoria
        [2] - NF_DESCTOT: Desconto no Total
        [3] - NF_ACRESCI: Acréscimo no Total
        [4] - NF_DESCONTO: Total de Descontos concedidos nos itens
        [5] - NF_TOTAL: Total da NF
        [6] - NF_TPFRETE: Tipo de Frete
        [7] - NF_FRETE: Valor do Frete
        [8] - NF_SEGURO: Valor do Seguro
        [9] - NF_DESPESA: Valor de Outras Despesas
    aItensCalc  : array de arrays, onde cada sub-array representa um item da venda e contém as seguintes informações:
        [1] - Número do item (numeric)
        [2] - Array de campos do item: { {"IT_PRODUTO", valor}, {"IT_QUANT", valor}, ... }
        [3] - Array de impostos do item (ver aImpCfg)
            aImpCfg  : array de arrays, onde cada sub-array representa os impostos do item da venda. Cada sub-array contém as seguintes informações:
                [1] - Identificação do tributo
                [2] - Código da regra do tributo
                [3] - Alíquota do tributo
                [4] - Base de cálculo do tributo
                [5] - Valor do tributo
                [6] - CST (Código de Situação Tributária)
                [7] - CCT (Código da Classificação Tributária)
                [8] - cclasstrib (Código de Classificação Tributária)
/*/
//------------------------------------------------------------------------------
method GetDataCalculated() as Array class LjCalcFis
Local aRet         as Array
Local aArea        as Array
Local nI           as Numeric
Local aItensCalc   as Array
Local aImpCfgItem  as Array

aRet        := {{.F., "Motor fiscal nao inicializado."}, {}, {}}
aArea       := GetArea()
nI          := 1
aItensCalc  := {}
aImpCfgItem := {}

If MaFisFound()
    // Atualizar totais do cabeçalho
    MaFisAlt("NF_FRETE",    ::nFrete)
    MaFisAlt("NF_SEGURO",   ::nSeguro)
    MaFisAlt("NF_DESPESA",  ::nDespesa)
    MaFisAlt("NF_DESCTOT",  ::nDescCab)
    MaFisAlt("NF_ACRESCI",  ::nAcrescCab)

    While MaFisFound("IT",nI)

        //Retorna os tributos do item que estao estao em memoria na MatxFis
        aImpCfgItem := ::GetItemCalculationDetails(nI)

        aAdd(aItensCalc, {;
            nI,{;
            {"IT_PRODUTO"   , MaFisRet(nI, "IT_PRODUTO")},;
            {"IT_QUANT"     , MaFisRet(nI, "IT_QUANT")},;
            {"IT_PRCUNI"    , MaFisRet(nI, "IT_PRCUNI")},;
            {"IT_VALMERC"   , MaFisRet(nI, "IT_VALMERC")},;
            {"IT_DESCONTO"  , MaFisRet(nI, "IT_DESCONTO")},;
            {"IT_DESCTOT"   , MaFisRet(nI, "IT_DESCTOT")},;
            {"IT_ACRESCI"   , MaFisRet(nI, "IT_ACRESCI")},;
            {"IT_TOTAL"     , MaFisRet(nI, "IT_TOTAL")},;
            {"IT_FRETE"     , MaFisRet(nI, "IT_FRETE")},;
            {"IT_SEGURO"    , MaFisRet(nI, "IT_SEGURO")},;
            {"IT_DESPESA"   , MaFisRet(nI, "IT_DESPESA")},;
            {"IT_CF"        , MaFisRet(nI, "IT_CF")},;              //Código Fiscal de Operações e Prestação (CFOP)
            {"IT_CLASFIS"   , RIGHT(MaFisRet(nI, "IT_CLASFIS"),2)},;//Codigo da Situação Tributaria (CST)
            {"IT_CODISS"    , MaFisRet(nI, "IT_CODISS")};           //Codigo do ISS
            },;
            aImpCfgItem;                                            //Impostos do Item
        })

        nI++
    End

    If Len(aItensCalc) > 0
        aRet[1][1] := .T. //Resultado da execuçao do calculo fiscal
        aRet[1][2] := "Calculo fiscal realizado com sucesso." //Mensagem de status ou erro da execução do caclulo fiscal
        //Dados do cabeçalho da venda
        aRet[2]  := {;
            {"NF_VALMERC",  MaFisRet(, "NF_VALMERC")}   ,;  //Valor Total de Mercadoria
            {"NF_DESCTOT",  MaFisRet(, "NF_DESCTOT")}   ,;  //Desconto no Total
            {"NF_ACRESCI",  MaFisRet(, "NF_ACRESCI")}   ,;  //Acréscimo no Total
            {"NF_DESCONTO", MaFisRet(, "NF_DESCONTO")}  ,;  //Total de Descontos concedidos nos itens
            {"NF_TOTAL",    MaFisRet(, "NF_TOTAL")}     ,;  //Total da NF
            {"NF_TPFRETE",  MaFisRet(, "NF_TPFRETE")}   ,;  //Tipo de Frete
            {"NF_FRETE",    MaFisRet(, "NF_FRETE")}     ,;  //Valor do Frete
            {"NF_SEGURO",   MaFisRet(, "NF_SEGURO")}    ,;  //Valor do Seguro
            {"NF_DESPESA",  MaFisRet(, "NF_DESPESA")}   ,;  //Valor de Outras Despesas
            {"NF_VALICM",   MaFisRet(, "NF_VALICM")}    ,;  //Valor Total do ICMS
            {"NF_VALIPI",   MaFisRet(, "NF_VALIPI")}    ,;  //Valor Total do IPI
            {"NF_VALPIS",   MaFisRet(, "NF_VALPIS")}    ,;  //Valor Total do PIS (retido)
            {"NF_VALPS2",   MaFisRet(, "NF_VALPS2")}    ,;  //Valor Total do PIS (apuração)
            {"NF_VALCOF",   MaFisRet(, "NF_VALCOF")}    ,;  //Valor Total da COFINS (retida)
            {"NF_VALCF2",   MaFisRet(, "NF_VALCF2")}    ,;  //Valor Total da COFINS (apuração)
            {"NF_VALCSL",   MaFisRet(, "NF_VALCSL")}    ,;  //Valor Total da CSLL
            {"NF_VALISS",   MaFisRet(, "NF_VALISS")}    ,;  //Valor Total do ISS
            {"NF_VALSOL",   MaFisRet(, "NF_VALSOL")}    ,;  //Valor Total do ICMS-ST
            {"NF_BASEDUP",  MaFisRet(, "NF_BASEDUP")}    ;  //Base Duplicada
            }

        //Dados dos itens da venda
        aRet[3]   := aClone(aItensCalc)
    EndIf

    //Finaliza o uso das funcoes Fiscais.
    ::Destroy()

    // ==========================================
    // Libera Recursos da Memoria
    // ==========================================
    FwFreeArray(aItensCalc)
    FwFreeArray(aImpCfgItem)

EndIf

RestArea(aArea)

return aRet

//------------------------------------------------------------------------------
/*/{Protheus.doc} Destroy
Finalização do motor de cálculo fiscal. Deve ser chamado ao final do uso da classe para liberar os recursos alocados pela MATXFIS.

@type    method
@author  Alberto Deviciente
@since   19/05/2026
@version P12

@return Logical, Retorna .T.
/*/
//------------------------------------------------------------------------------
method Destroy() as Logical class LjCalcFis
    If MaFisFound()
        MaFisEnd()
    EndIf
Return .T.

//------------------------------------------------------------------------------
/*/{Protheus.doc} GetItemCalculationDetails
Retorna um array com as informações dos impostos calculados para um item específico.

@type    method
@author  Alberto Deviciente
@since   19/05/2026
@version P12

@param nItem, Numeric, Número do item para o qual os impostos serão retornados

@return Array, array de arrays, onde cada sub-array contém as seguintes informações do imposto:
    [1] - Identificação do tributo
    [2] - Código da regra do tributo
    [3] - Alíquota do tributo
    [4] - Base de cálculo do tributo
    [5] - Valor do tributo
    [6] - CST (Código de Situação Tributária)
    [7] - CCT (Código da Classificação Tributária)
    [8] - cclasstrib (Código de Classificação Tributária)
/*/
//------------------------------------------------------------------------------
method GetItemCalculationDetails(nItem as Numeric) as Array class LjCalcFis
Local aRet       as Array
Local oTci       as Object
Local jDadosItem as Object
Local aNItem     as Array
Local aTrib      as Array
Local jDetTrib   as Object
Local nX         as Numeric
Local nY         as Numeric

aRet    := {}
aNItem  := {}
aTrib   := {}

oTci := totvs.protheus.backoffice.fiscal.tciclass.TCIProcessing():New()
oTci:setItems({nItem})
oTci:setDataItems({"detalhe_livro","regras_escrituracao"})
jDadosItem := JsonObject():New()
jDadosItem:FromJson(oTci:GetDataItems())

If !jDadosItem:hasproperty("erro") .And. jDadosItem:hasproperty("dados_itens")
    aNItem := jDadosItem["dados_itens"]:getNames()
    For nX := 1 To Len(aNItem)
        If !jDadosItem["dados_itens"][aNItem[nX]]:hasproperty("Aviso")
            aTrib := jDadosItem["dados_itens"][aNItem[nX]]:getNames()
            //Percorre os tributos do item
            For nY := 1 To Len(aTrib)
                jDetTrib := jDadosItem["dados_itens"][aNItem[nX]][aTrib[nY]]
                If ValType(jDetTrib)=="J"
                    //Documentação da Classe TCIProcessing: https://tdn.totvs.com/pages/viewpage.action?pageId=825302215
                    //Descrição das propriedades contidas em "dados_itens": https://tdn.totvs.com/pages/viewpage.action?pageId=825302215#ClasseTCIProcessingTaxConfiguratorIntegrationProcessing(ProcessamentodeIntegra%C3%A7%C3%A3odoConfiguradorFiscal)-Descri%C3%A7%C3%A3odaspropriedadescontidasemdados_itens
                    aAdd(aRet, { jDetTrib })
                EndIf
            Next nY
        EndIf
    Next nX
EndIf

// ==========================================
// Libera Recursos da Memoria
// ==========================================
FwFreeArray(aNItem)
FwFreeArray(aTrib)
oTci:destroy()
FwFreeObj(oTci)
FwFreeObj(jDadosItem)

Return aRet

//------------------------------------------------------------------------------
/*/{Protheus.doc} ValidDataHeader
Valida os dados do cabeçalho.

@type    method
@author  Alberto Deviciente
@since   19/05/2026
@version P12

@return Logical, .T. se os dados são válidos, .F. caso contrário
/*/
//------------------------------------------------------------------------------
method ValidDataHeader() as Logical class LjCalcFis
Local lRet          as Logical
Local nTamA1COD     as Numeric
Local nTamA1LOJ     as Numeric
Local aAreaSA1      as Array
Local aTiposFrete   as Array

lRet        := .T.
nTamA1COD   := TamSx3("A1_COD")[1]
nTamA1LOJ   := TamSx3("A1_LOJA")[1]
aAreaSA1    := SA1->(GetArea())
aTiposFrete := {;
                "C",; //C=CIF
                "F",; //F=FOB
                "T",; //T=Por conta terceiros
                "R",; //R=Por conta remetente
                "D",; //D=Por conta destinatário
                "S";  //S=Sem frete
                }

//Trata dados com o tamanho padrão
If Len(::cCliente) < nTamA1COD
    ::cCliente := PadR(::cCliente, nTamA1COD)
EndIf
If Len(::cLoja) < nTamA1LOJ
    ::cLoja := PadR(::cLoja, nTamA1LOJ)
EndIf

If Len(::cCliente) > nTamA1COD
    lRet := .F.
    ::cMsgError := STR0001 //"Codigo do Cliente com tamanho maior que o permitido. Verifique os dados informados."
ElseIf Len(::cLoja) > nTamA1LOJ
    lRet := .F.
    ::cMsgError := STR0002 //"Codigo da Loja com tamanho maior que o permitido. Verifique os dados informados."
EndIf

If lRet
    DbSelectArea("SA1")
    SA1->(DbSetOrder(1)) //A1_FILIAL+A1_COD+A1_LOJA
    If !SA1->(DbSeek(xFilial("SA1")+::cCliente+::cLoja))
        lRet := .F.
        ::cMsgError := STR0003 //"Cliente nao encontrado. Verifique o codigo do cliente e loja informado."
    Else
        ::cTpCli := SA1->A1_TIPO  //Tipo de cliente
    EndIf
EndIf

If lRet 
    If Empty(::cTpFrete)
        lRet := .F.
        ::cMsgError := STR0004 //"Tipo de frete nao informado."
    ElseIf aScan(aTiposFrete, ::cTpFrete) == 0
        lRet := .F.
        ::cMsgError := STR0005 //"Tipo de frete invalido. Verifique o tipo de frete informado."
    EndIf
EndIf

RestArea(aAreaSA1)

// ==========================================
// Libera Recursos da Memoria
// ==========================================
FwFreeArray(aTiposFrete)

Return lRet

//------------------------------------------------------------------------------
/*/{Protheus.doc} ValidDataItem
Valida os dados do Item.

@type    method
@author  Alberto Deviciente
@since   19/05/2026
@version P12

@param cProduto    , Character, Código do Produto (B1_COD)
@param cTES        , Character, (Saída) Código da TES do item
@param nRecnoSB1   , Numeric, (Saída) Numero do Recno do produto encontrado na tabela SB1
@param nRecnoSF4   , Numeric, (Saída) Numero do Recno da TES encontrada na tabela SF4

@return Logical, .T. se os dados são válidos, .F. caso contrário
/*/
//------------------------------------------------------------------------------
method ValidDataItem(cProduto as Character, cTES as Character, nRecnoSB1 as Numeric, nRecnoSF4 as Numeric) as Logical class LjCalcFis
Local lRet          as Logical
Local nTamB1COD     as Numeric

lRet        := .T.
nTamB1COD   := TamSx3("B1_COD")[1]

//Trata dados com o tamanho padrão
If Len(cProduto) < nTamB1COD
    cProduto := PadR(cProduto, nTamB1COD)
EndIf

If Len(cProduto) > nTamB1COD
    lRet := .F.
    ::cMsgError := STR0006 //"Codigo do Produto com tamanho maior que o permitido. Verifique os dados informados."
EndIf

If lRet
    dbSelectArea("SB1")
    SB1->(DbSetOrder(1)) //B1_FILIAL+B1_COD
    If !SB1->(MsSeek(xFilial("SB1")+cProduto))
        lRet := .F.
        ::cMsgError := STR0007 + "[" + cProduto + "]" + STR0008 //"Produto "[ ### ]" nao encontrado. Verifique o codigo do produto informado."
    Else
        nRecnoSB1 := SB1->(RecNo())
    EndIf
EndIf

If lRet
    //Usa a mesma regra do PSH para definir a TES do item
    cTES := RmiTesProd(cProduto,::cCliente,::cLoja)

    If !Empty(cTES)
        dbSelectArea("SF4")
        SF4->(DbSetOrder(1)) //F4_FILIAL+F4_CODIGO
        If !SF4->(MsSeek(xFilial("SF4")+cTES))
            lRet := .F.
            ::cMsgError := STR0009 + "[" + cTES + "]" + STR0010 //"TES " [ ### ] " nao encontrada."
        Else
            nRecnoSF4 := SF4->(RecNo())
        EndIf
    Else
        lRet := .F.
        ::cMsgError := STR0011 + "[" + AllTrim(cProduto) + "]" + STR0012 //"A TES para o produto "[ ### ]" está vazia. Verifique o cadastro do produto e o parametro MV_TESSAI."
    EndIf
EndIf

Return lRet

//------------------------------------------------------------------------------
/*/{Protheus.doc} GetMsgError
Retorna a mensagem de erro gerada na validação.

@type    method
@author  Alberto Deviciente
@since   19/05/2026
@version P12

@return Character, Mensagem de erro gerada na validação.
/*/
//------------------------------------------------------------------------------
method GetMsgError() as Character class LjCalcFis
Return ::cMsgError
