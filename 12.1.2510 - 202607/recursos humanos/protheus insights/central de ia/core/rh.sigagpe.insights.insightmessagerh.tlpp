#Include "tlpp-core.th"
#include 'totvs.ch'
#include "rh.sigagpe.insights.insightmessagerh.ch"

NAMESPACE totvs.protheus.rh.sigagpe.insights

Static aSM0 

/*-------------------------------------------------------------------
{Protheus.doc} InsightMessageRh
Classe de inserção da mensagem - Auditoria de Folha de Pagamento

@author	Bruno Costa
@since	20/10/2025
-------------------------------------------------------------------*/
Class InsightMessageRh
    
    Public Data oJsBody As Json

    Public Method New() Constructor
    Public Method getError()
    Public Method InsertMessageRh() as logical
    Public Method fFormatCNPJ() as character
    Private Method getFilial() as array
    Private Method ValidRegra() as character 
    Private Method InputRules()

EndClass

/*-------------------------------------------------------------------
{Protheus.doc} InsightMessageRh::New
Construtor da classe {Protheus.doc} InsightMessageRh::New

@return	Self, objeto do tipo {Protheus.doc} InsightMessageRh::New
@author	Bruno Costa
@since	20/10/2025
-------------------------------------------------------------------*/
Method New() Class InsightMessageRh
Return Self

/*-------------------------------------------------------------------
{Protheus.doc} InsightMessageRh::InsertMessageRh
Método responsável pela inserção da mensagem na tabela RUI

@return	logical
@author	Bruno Costa
@since	20/10/2025
-------------------------------------------------------------------*/
Method InsertMessageRh() as logical Class InsightMessageRh
    
    Local aFilial              as array
    Local aProcessa            := {} as array
    Local aEmpProc             := {} as array
    Local cCodMsn              as character
    Local cCodFil              as character
    Local cGrupo               as character
    Local cNrInscOld           as character
    Local cNrInsc              as character
    Local lMudaEmp             as logical
    Local nI                   as numeric
    Local lSolved              as logical

    lSolved := .F.
    lMudaEmp:= .F.

    If Valtype(::oJsBody["content"]) == "A"        

        For nI := 1 To Len(::oJsBody["content"])

            cCodMsn := self:ValidRegra(::oJsBody["content"][nI]["exceptionClass"])
            cNrInsc := self:fFormatCNPJ(::oJsBody["content"][nI]["employerTaxCode"])

            If cNrInscOld != cNrInsc 
                aFilial    := self:getFilial(cNrInsc)
                cCodFil    := aFilial[1]
                cGrupo     := aFilial[2]
                cNrInscOld := cNrInsc
                lMudaEmp   := If(lMudaEmp,.T.,(!Empty(cGrupo) .And. cGrupo != cEmpAnt))
                If(aScan(aEmpProc,{|x| x[1] == cGrupo}) == 0)
                    aAdd(aEmpProc, {cGrupo, cCodFil})
                EndIf 
            EndIF

            If !Empty(cCodFil) 
                aAdd(aProcessa, {   cGrupo,;
                                    cCodFil,;                                     
                                    cNrInsc,;
                                    cCodMsn,;
                                    ::oJsBody["content"][nI]["employeeRegistration"],;
                                    ::oJsBody["content"][nI]["periodYear"],;
                                    ::oJsBody["content"][nI]["periodMonth"],;                                     
                                    ::oJsBody["content"][nI]["rubricCode"],;
                                    ::oJsBody["content"][nI]["exception"],;
                                    ::oJsBody["content"][nI]["exceptionDescription"],;
                                    ::oJsBody["content"][nI]["computedAt"],;
                                    ::oJsBody["content"][nI]["periodCode"],;
                                    ::oJsBody["content"][nI]["periodLabel"],;
                                    ::oJsBody["content"][nI]["mdmid"],;
                                    ::oJsBody["id"],;
                                    ::oJsBody["product"],;
                                    ::oJsBody["tenantId"],;
                                    ::oJsBody["messageType"];
                                })
            EndIf
        Next nI
    Else    
        Return .F.
    EndIf

    If lMudaEmp .And. Len(aProcessa) > 0
        For nI := 1 to Len(aEmpProc)
            StartJob("totvs.protheus.rh.sigagpe.insights.fGravaRUI", GetEnvServer(), .T., .T., aEmpProc[nI,1], aEmpProc[nI,2], aProcessa)
        Next nI
    ElseIf Len(aProcessa) > 0
        fGravaRUI(.F., , , aProcessa)
    EndIf

Return .T.

Method InputRules(cId) Class InsightMessageRh

    Local cDescRegra as character
    Local cIdRUP     as character

    Do CASE
        Case cId == "001"
            cDescRegra := "Evento duplicado"
        Case cId == "002"
            cDescRegra := "Desconto/Provento indevido"
        Case cId == "003"
            cDescRegra := "Valor fora do padrão histórico"
        Case cId == "004"
            cDescRegra := "Ausência de pagamento/descontos"
    End Case
    
    dbSelectArea("RUP")
    RUP->(dbSetOrder(2)) //RUP_FILIAL+RUP_DESCRI
    If RecLock("RUP", .T.)
        RUP->RUP_FILIAL := xFilial("RUP")
        RUP->RUP_ID     := GETSX8NUM("RUP", "RUP_ID")
        RUP->RUP_CODIGO := cId
        RUP->RUP_DESCRI := AllTrim(cDescRegra)
        cIdRUP := RUP->RUP_ID
        RUP->(MsUnlock())
        ConfirmSx8()
    EndIf 

Return cIdRUP

/*-------------------------------------------------------------------
{Protheus.doc} InsightMessageRh::ValidRegra
Método responsável pela inserção/busca da regra na tabela RUP

@param	cDescRegra character
@return	character
@author	Bruno Costa
@since	20/10/2025
-------------------------------------------------------------------*/
Method ValidRegra(cCodigo as character) as character Class InsightMessageRh

    Local cId as character


    dbSelectArea("RUP")
    //RUP->(dbSetOrder(2)) //RUP_FILIAL+RUP_DESCRI
    RUP->(dbSetOrder(3)) // RUP_FILIAL+RUP_CODIGO
    
    If RUP->(MsSeek(xFilial("RUP") + AllTrim(cCodigo)))
        cId := AllTrim(RUP->RUP_ID)
    Else
        cId := self:InputRules(cCodigo)
    EndIf 

Return cId

/*-------------------------------------------------------------------
{Protheus.doc} InsightMessageRh::getFilial
Método responsável pela busca da filial enviada no content da mensagem

@param	cNrInsc character
@return	array {cCodFil, cGrupo}
@author	Bruno Costa
@since	20/10/2025
-------------------------------------------------------------------*/
method getFilial(cNrInsc as character) as array class InsightMessageRh

    local nPos as numeric
    local cCodFil := "" as character
    local cGrupo := cEmpAnt as character

    DEFAULT aSM0 := FwLoadSM0()

    If (nPos := aScan(aSM0, {|x| x[18] == cNrInsc})) > 0
       cCodFil := aSM0[nPos][2]
       cGrupo  := aSM0[nPos][1]
    EndIf

return {cCodFil, cGrupo}

/*-------------------------------------------------------------------
{Protheus.doc} InsightMessageRh::fFormatCNPJ
Método responsável pela formatação do CNPJ

@param	cJsCnpj character
@return	character
@Version 1
@author	Bruno Costa
@since	20/10/2025
@Version 2
@author	lucas.passos @since	15/11/2025
-------------------------------------------------------------------*/
method fFormatCNPJ(cJsCnpj as character) as character class InsightMessageRh

    Local cFormatCnpj	:= ""

	cFormatCnpj := StrTran(cJsCnpj, ".", "")
	cFormatCnpj := StrTran(cFormatCnpj, "/", "")
	cFormatCnpj := StrTran(cFormatCnpj, "-", "")

return cFormatCnpj

/*-------------------------------------------------------------------
{Protheus.doc} InsightMessageRh::getError
Método responsável pela geração de erros personalizados

@param	nCode numeric, cTitle character, aDescription array
@author	Bruno Costa
@since	20/10/2025
-------------------------------------------------------------------*/
method getError(nCode as numeric, cTitle as character, aDescription as array) class InsightMessageRh
	
    Public oException as object

	Default nCode := -1
	Default cTitle := ""
	Default aDescription := {}

	oException         := ErrorClass():New()
	oException:genCode := nCode

	If Len(aDescription) > 1
		oException:description := cTitle + ": " + I18N(aDescription[1], aDescription[2])   
	Else
		oException:description := cTitle + ": " + aDescription[1]
	EndIf
    
Return 

/*
{Protheus.doc} fGravaRUI
Função responsável pela gravação da tabela RUI
@author	Leandro Drumond
@since	05/03/2026 */

Function fGravaRUI(lStartEmp, cEmpProc, cFilProc, aFuncProc)
Local nX as numeric
Local cChave as character
Local cMes as character
Local cTimeStamp as character
Local cEnvepole as character
Local cCodMsn as character
Local nRecno as numeric
Local lSolved as logical
Local oBulk
Local oBulkRUU

DEFAULT lStartEmp   := .F.
DEFAULT	cEmpProc	:= cEmpAnt
DEFAULT cFilProc	:= cFilAnt

If lStartEmp 
    RPCSetType(3)
	RPCSetEnv(cEmpProc, cFilProc,,,'GPE',,{"RUI","RUU"}) 
    dbSelectArea("RUI")
    RUI->(dbSetOrder(1)) //RUI_FILIAL+RUI_MAT+RUI_COMPET+RUI_PD+RUI_IDREGR
    DbSelectArea("RUU")
EndIf

oBulk := FwBulk():New( RetSQLName("RUI") )
oBulk:SetFields({	{"RUI_FILIAL"   },;
                    {"RUI_MAT"		},;
                    {"RUI_CPF"	    },;
                    {"RUI_NRINSC"	},;
                    {"RUI_COMPET"	},;
                    {"RUI_CODPER"	},;
                    {"RUI_PD"	    },;
                    {"RUI_ROTEIR"	},;
                    {"RUI_PREDIC"	},;
                    {"RUI_IDREGR"	},;
                    {"RUI_STAMP"	},;
                    {"RUI_UIDMSG"	},;
                    {"RUI_PRODUT"	},;
                    {"RUI_TENANT"	},;
                    {"RUI_INSIGT"	},;
                    {"RUI_FEEDBK"	},;
                    {"RUI_TIPO"	    },;
                    {"RUI_MSGRET"   }})

oBulkRUU := FwBulk():New( RetSQLName("RUU") )
oBulkRUU:SetFields({	{"RUU_FILIAL"   },;
                        {"RUU_MAT"		},;
                        {"RUU_CPF"	    },;
                        {"RUU_NRINSC"	},;
                        {"RUU_COMPET"	},;
                        {"RUU_CODPER"	},;
                        {"RUU_PD"	    },;
                        {"RUU_ROTEIR"	},;
                        {"RUU_PREDIC"	},;
                        {"RUU_IDREGR"	},;
                        {"RUU_STAMP"	},;
                        {"RUU_UIDMSG"	},;
                        {"RUU_PRODUT"	},;
                        {"RUU_TENANT"	},;
                        {"RUU_INSIGT"	},;
                        {"RUU_MSGRET"   },;
                        {"RUU_TIPO"     },;
                        {"RUU_STHIST"   }})

BEGIN TRANSACTION

    For nX := 1 To Len(aFuncProc)

        If(aFuncProc[nX,1] <> cEmpProc)  
            Loop 
        EndIf

        If!(getFuncionario(aFuncProc[nX, 2], aFuncProc[nX, 5]) )
            Loop 
        EndIf

        lSolved := .F.
        cCodMsn := aFuncProc[nX, 4]  // cCodMsn
        cMes    := If(aFuncProc[nX, 7] <= 9,'0','') + cValToChar(aFuncProc[nX, 7]) 

        cChave := aFuncProc[nX, 5] + cMes + cValToChar(aFuncProc[nX, 6]) + aFuncProc[nX, 8] + cCodMsn  // employeeRegistration + periodYear + rubricCode

        If !RUI->(MsSeek(aFuncProc[nX, 2] + cChave))

            cTimeStamp := AllTrim(aFuncProc[nX, 11])  // computedAt

            cEnvepole := ""
            If !Empty(aFuncProc[nX, 13])  // periodLabel
                cEnvepole := Upper(SubStr(AllTrim(aFuncProc[nX, 13]),1,3))
                cEnvepole := IIf(Substr(cEnvepole,1,2) == "13","13",cEnvepole)
            EndIf 

            oBulk:AddData({ aFuncProc[nX, 2],;
                            aFuncProc[nX, 5],;  // employeeRegistration
                            SRA->RA_CIC,;
                            aFuncProc[nX, 3],;  // employerTaxCode não usada
                            cMes + cValToChar(aFuncProc[nX, 6]),;  // periodMonth + periodYear
                            aFuncProc[nX, 12],;  // periodCode
                            aFuncProc[nX, 8],;   // rubricCode
                            cEnvepole,;
                            aFuncProc[nX, 9],;  // exception
                            cCodMsn,;
                            Padr(Substr(cTimeStamp,1,10) + " " + Substr(cTimeStamp,12,12),Len(RUI->RUI_STAMP)),;
                            aFuncProc[nX, 14],;  // mdmid
                            aFuncProc[nX, 16],;  // product
                            aFuncProc[nX, 17],;  // tenantId
                            aFuncProc[nX, 18],;  // messageType
                            "0",;
                            "0",;
                            decodeUtf8(aFuncProc[nX, 10])})  // exceptionDescription        

        Else    

            nRecno := RUI->(Recno())

            If nRecno > 0 .And. (RUI->RUI_PREDIC != aFuncProc[nX, 9])  // exception

                If RUI->RUI_PREDIC .and. !aFuncProc[nX, 9]  // exception
                    lSolved := .T.
                EndIf 

                oBulkRUU:AddData({  RUI->RUI_FILIAL,;
                                    RUI->RUI_MAT,;
                                    RUI->RUI_CPF,;
                                    RUI->RUI_NRINSC,;
                                    RUI->RUI_COMPET,;
                                    RUI->RUI_CODPER,;
                                    RUI->RUI_PD,;
                                    RUI->RUI_ROTEIR,;
                                    RUI->RUI_PREDIC,;
                                    RUI->RUI_IDREGR,;
                                    RUI->RUI_STAMP,;
                                    RUI->RUI_UIDMSG,;
                                    RUI->RUI_PRODUT,;
                                    RUI->RUI_TENANT,;
                                    RUI->RUI_INSIGT,;
                                    RUI->RUI_MSGRET,;
                                    IIf(lSolved .and. !aFuncProc[nX, 9], '1', ''),;  // exception
                                    StrZero(Year(Date()),4)+"-"+StrZero(Month(Date()),2)+"-"+StrZero(Day(Date()),2)+" "+SubStr(Time(),1,8)})            

            EndIf 

            cTimeStamp := AllTrim(aFuncProc[nX, 11])  // computedAt
            
            // Atualizar RUI
            RUI->(RecLock("RUI", .F.))
            RUI->RUI_STAMP  := Substr(cTimeStamp,1,10) + " " + Substr(cTimeStamp,12,12) // computedAt
            RUI->RUI_UIDMSG := aFuncProc[nX, 15]  // id
            RUI->RUI_PRODUT := aFuncProc[nX, 16]  // product
            RUI->RUI_PREDIC := aFuncProc[nX, 9]  // exception
            RUI->RUI_TENANT := aFuncProc[nX, 17]  // tenantId
            RUI->RUI_INSIGT := aFuncProc[nX, 18]  // messageType
            If lSolved
                RUI->RUI_TIPO := '1'
            EndIf 
            RUI->(MsUnlock())
            
        EndIf

    Next nX

    oBulk:Close()
    oBulk:Destroy()
    oBulk := nil

    oBulkRUU:Close()
    oBulkRUU:Destroy()
    oBulkRUU := nil

END TRANSACTION

If lStartEmp 
	RpcClearEnv()
EndIf

Return Nil

/*-------------------------------------------------------------------
{Protheus.doc} getFuncionario
Função responsável pela busca do funcionário enviado no content da mensagem

@param	cCodfil character, cMat character
@return	logical
@author	Bruno Costa
@since	30/10/2025
-------------------------------------------------------------------*/
Static Function getFuncionario(cCodFil, cMat)

    dbSelectArea("SRA")
    SRA->(dbSetOrder(1)) //RA_FILIAL+RA_MAT

Return SRA->(MsSeek(cCodFil + cMat))
