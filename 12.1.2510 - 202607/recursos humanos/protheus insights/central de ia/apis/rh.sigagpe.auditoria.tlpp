#DEFINE CodeRespCreated 201
#DEFINE CodeRespBadRequest 400

USING NAMESPACE totvs.protheus.rh.sigagpe.insights 

Static __cWhere
Static __cValidFil
Static __cViewType
Static oInMns
Static aSM0
Static aFilValid

