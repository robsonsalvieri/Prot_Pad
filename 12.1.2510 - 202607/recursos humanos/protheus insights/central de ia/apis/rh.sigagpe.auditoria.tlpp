/*-------------------------------------------------------------------
{Protheus.doc} Get getPeriodos
API de busca dos Períodos para o painel de auditoria

@author	Bruno Costa
@since	21/10/2025
-------------------------------------------------------------------*/
method getPeriodos() class AuditFolhaGPE

	Local oItem			as object
	Local oJsBadResp 	as object
	Local aBranches 	as array
	Local cComp 		as character
	Local cQuery 		as character
    Local cWhere 		as character
    Local nPOrder 		as numeric
	Local jParams 		:= oRest:getQueryRequest() 	as json
	Local oResponse 	:= JsonObject():New() 		as json
	
	Static oStatementPer

    DEFAULT __cWhere  := ""

	oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

	cComp     := IIf(jParams:hasProperty("month"), StrZero(Val(jParams["month"]), 2), "") + IIf(jParams:hasProperty("year"), jParams["year"], "")
    aBranches := IIf(jParams:hasProperty("branchCode"), StrTokArr(jParams['branchCode'], ','), {}) 
	nPOrder   := 1

    If Len(cComp) < 6 
		oJsBadResp := JSonObject():new()
		oJsBadResp['code']    := CodeRespBadRequest
		oJsBadResp['message'] := EncodeUTF8(OemToAnsi(STR0001)) //"Necessário enviar mês e ano para busca dos períodos" 
		oRest:setStatusCode(CodeRespBadRequest)
		oRest:setResponse(oJsBadResp:toJson()) 
		Return
	EndIf

	oResponse["items"] := {} 
	oItem := JsonObject():New()
	oItem["period"] := {}
    
    If Len(aBranches) > 0
        cWhere := self:getWherePar(,,,,,, .T.) 
    EndIf 

	If oStatementPer == Nil .Or. !(__cWhere == cWhere)
		cQuery := "SELECT RUI.RUI_ROTEIR FROM "+RetSqlName("RUI")+" RUI WHERE RUI.RUI_COMPET = ? " 
        
        If !Empty(cWhere)
			cQuery += cWhere    
        EndIf

		cQuery += " AND RUI.D_E_L_E_T_ = ? GROUP BY RUI.RUI_ROTEIR"

        __cWhere  	  := cWhere
		cQuery        := ChangeQuery(cQuery) 
		oStatementPer := FwExecStatement():New(cQuery)
	EndIf

	oStatementPer:SetString(nPOrder++, cComp) //RUI.RUI_COMPET
    If Len(aBranches) > 0
        oStatementPer:SetIn(nPOrder++, aBranches) //RUI.RUI_FILIAL
    EndIf
	oStatementPer:SetString(nPOrder++, " ")   //RUI.D_E_L_E_T_ 

	cAlias := oStatementPer:OpenAlias()

	If (cAlias)->(Eof())
		oJsBadResp := JSonObject():new()
		oJsBadResp['code']    := CodeRespBadRequest
		oJsBadResp['message'] := EncodeUTF8(OemToAnsi("Nenhum dado encontrado para o período, tente outro período")) //"Nenhum dado encontrado para o período, tente outro período"" 
		oRest:setStatusCode(CodeRespBadRequest)
		oRest:setResponse(oJsBadResp:toJson()) 
		Return
	EndIf 

    aAdd(oItem["period"], "Todos") 

	While !(cAlias)->(Eof())

		aAdd(oItem["period"], (cAlias)->RUI_ROTEIR)
		
		(cAlias)->(DbSkip())

	EndDo
	
    If Len(oItem["period"]) == 2
        aDel(oItem["period"], 1)
        aSize(oItem["period"], Len(oItem["period"]) - 1)
    EndIf

	aAdd(oResponse["items"], oItem)

	(cAlias)->(dbCloseArea())

	oRest:setResponse(EncodeUTF8(FwCutOff(oResponse:toJson())))

return

/*/{Protheus.doc} GET getHistory
	'API de informações de historico'
	@lucas.passos
	@since 15/11/2025
/*/
Method getHistory() class AuditFolhaGPE
	Local  cQuery 			as character
	Local  cAlias 			as character
	Local  cComp 			as character
	Local  cRot 			as character
	Local  cId 				as character
    Local  nPageSize 		as numeric
   	Local  nPOrder 			as numeric
	Local  nStart 			as numeric
	Local  nPage 			as numeric
	Local  nEnd 			as numeric
	Local  lHasNext 		as logical
    Local  aBranches 		as array
	Local  cCPF_CNPJ 		as character
	Local  cCpf 			as character
	Local  cCnpj 			as character
	Local  oItem			as object

	Local  jParams 	 := oRest:getQueryRequest() as json
	Local  oResponse := JsonObject():New() 		as json

	Static oStHistory

    DEFAULT oInMns := InsightMessageRh():New()

	//OBRIGATORIO
	cComp     := IIf(jParams:hasProperty("month"), StrZero(Val(jParams["month"]), 2), "") + IIf(jParams:hasProperty("year"), jParams["year"], "")
	cRot  	  := IIf(jParams:hasProperty("period"), If(!jParams["period"] $ "Todos", jParams["period"], ""), "")
	aBranches := IIf(jParams:hasProperty("branchCode"), StrTokArr(jParams['branchCode'], ','), {}) 

	//Filtros
	cId       := IIf(jParams:hasProperty("id"), jParams["id"], "") 
	cCPF_CNPJ := IIf(jParams:hasProperty("cpf_cnpj"), jParams["cpf_cnpj"], "")

	If !Empty(cCPF_CNPJ)
        cCPF_CNPJ := oInMns:fFormatCNPJ(cCPF_CNPJ) 
		If Len(cCPF_CNPJ) == 11
			cCpf := cCPF_CNPJ
		ElseIf Len(cCPF_CNPJ) > 11
			cCnpj := cCPF_CNPJ
		EndIf 
    EndIF

	//Paginação 
	nPage 	  := IIf(jParams:hasProperty("page"), Val(jParams["page"]), 1)
	nPageSize := IIf(jParams:hasProperty("pageSize"), Val(jParams["pageSize"]), 100)
	nPOrder   := 0
	nStart 	  := (nPage - 1) * nPageSize + 1
	nEnd      :=  nPage * nPageSize + 1

	oResponse["items"] := {}

	cQuery := " SELECT * "
	cQuery += " 	FROM ( "
	cQuery += " 		SELECT "
	cQuery += " 			ROW_NUMBER() OVER (ORDER BY RUU.RUU_FILIAL, RUU.RUU_MAT ASC) AS LINHA, "
	cQuery += " 			RUU.RUU_FILIAL, "
	cQuery += " 			RUU.RUU_NRINSC, "
	cQuery += " 			RUU.RUU_IDREGR, "
	cQuery += " 			RUP.RUP_DESCRI    AS DESC_REGRA,  "       
	cQuery += " 			RUP.RUP_CODIGO, "
	cQuery += " 			RUU.RUU_CPF, "
	cQuery += " 			RUU.RUU_MAT, "
	cQuery += " 			SRA.RA_NOME     AS NOME_FUNC,  "       
	cQuery += " 			RUU.RUU_PD, "
	cQuery += " 			SRV.RV_DESC    AS DESC_RUBRICA,  "     
	cQuery += " 			RUU.RUU_TIPO, "
	cQuery += " 			RUU.RUU_FEEDBK, "
	cQuery += " 			RUU.RUU_STHIST, "
	cQuery += " 			RUU.RUU_MSGRET "
	cQuery += " 		FROM "+RetSqlName("RUU")+" RUU " 
	cQuery += " 		INNER JOIN "+RetSqlName("SRA")+" SRA "
	cQuery += " 			ON SRA.RA_FILIAL = RUU.RUU_FILIAL "
	cQuery += " 		AND SRA.RA_MAT = RUU.RUU_MAT " 
	cQuery += " 		AND SRA.RA_CIC = RUU.RUU_CPF " 
	cQuery += " 		AND SRA.D_E_L_E_T_ = ' ' "
	cQuery += " 		INNER JOIN "+RetSqlName("RUP")+" RUP "
	cQuery += " 			ON RUP.RUP_ID = RUU.RUU_IDREGR "
	cQuery += " 		AND RUP.D_E_L_E_T_ = ' ' "
	cQuery += " 		LEFT JOIN "+RetSqlName("SRV")+" SRV "
	cQuery += " 			ON SRV.RV_COD = RUU.RUU_PD "
	cQuery += " 		AND SRV.RV_FILIAL = '" + xFilial("SRV") + "' "
	cQuery += " 		AND SRV.D_E_L_E_T_ = ' ' "
	cQuery += " 		WHERE "
	cQuery += " 		RUU.D_E_L_E_T_ = ' ' "
	If !Empty(cComp)
		cQuery += " 		AND RUU.RUU_COMPET = ? "
	EndIf 
	If !Empty(cId)
		cQuery += " 		AND RUU.RUU_IDREGR = ? "
	EndIf
	If !Empty(cCpf)
		cQuery += " 		AND RUU.RUU_CPF = ? "
	EndIf 
	If !Empty(cCnpj)
		cQuery += " 		AND RUU.RUU_NRINSC = ? "
	EndIf 
	If !Empty(cRot) .And. cRot != 'Todos'
		cQuery += " 		AND RUU.RUU_ROTEIR = ? "
	EndIf 
	If Len(aBranches)  > 0
		cQuery += " AND RUU.RUU_FILIAL IN (?) "
	EndIf 
	cQuery += " 	) TAB "
	cQuery += " WHERE LINHA BETWEEN ? AND ?  "

	cQuery     := ChangeQuery(cQuery) 
	oStHistory := FwExecStatement():New(cQuery)

	If !Empty(cComp)
		oStHistory:SetString(++nPOrder, cComp) 
	EndIf 

	If !Empty(cId)
		oStHistory:SetString(++nPOrder, cId) 
	EndIf 
	If !Empty(cCpf)
		oStHistory:SetString(++nPOrder, cCpf)
	EndIf 

	If !Empty(cCnpj)
		oStHistory:SetString(++nPOrder, cCnpj)
	EndIf 
	If !Empty(cRot) .and. cRot != 'Todos'
		oStHistory:SetString(++nPOrder, cRot) //RUI.RUI_ROTEIR
	EndIf
    If Len(aBranches) > 0
        oStHistory:SetIn(++nPOrder, aBranches) 
    EndIf

    oStHistory:SetString(++nPOrder, cValToChar(nStart))
	oStHistory:SetString(++nPOrder, cValToChar(nEnd))
	cAlias := oStHistory:OpenAlias()

	While !(cAlias)->(Eof())
        If (cAlias)->LINHA > (nEnd - 1)
			lHasNext := .T.
			Exit 
		EndIf   

		oItem := JsonObject():new()

		oItem["branchCode"]  				:= Alltrim((cAlias)->RUU_FILIAL)
		oItem["companyId"]   				:= '' // compatibilidade 
		oItem["cnpj"]        				:= Alltrim((cAlias)->RUU_NRINSC)
		oItem["id"]  	     				:= Alltrim((cAlias)->RUP_CODIGO)
		oItem["description"] 				:= Alltrim(OemToAnsi((cAlias)->DESC_REGRA))
		oItem["cpf"]	     				:= Alltrim((cAlias)->RUU_CPF)
		oItem["employeeId"]  				:= Alltrim((cAlias)->RUU_MAT)
		oItem["nameEmployee"]				:= Alltrim(OemToAnsi((cAlias)->NOME_FUNC))
		oItem["rubricCode"]  				:= Alltrim((cAlias)->RUU_PD)
		oItem["rubricDesc"]  				:= Alltrim(OemToAnsi((cAlias)->DESC_RUBRICA))
        oItem["feedback"]  					:= Alltrim((cAlias)->RUU_FEEDBK )
		oItem["dateIncluded"]  				:= Alltrim((cAlias)->RUU_STHIST)
		oItem["resolved"]  					:= IIF(Alltrim((cAlias)->RUU_TIPO) = '1', '1', '0')
		oItem["exceptionDescription"] 		:= Alltrim((cAlias)->RUU_MSGRET)
		oItem["typeHistory"]  				:= Val(Alltrim((cAlias)->RUU_TIPO))

        aAdd(oResponse["items"], oItem)
		
		(cAlias)->(DbSkip())

	EndDo

	(cAlias)->(dbCloseArea())   
    oResponse["hasNext"] := lHasNext 

	oRest:setResponse(FwCutOff(oResponse:toJson()))
	
Return 

/*/{Protheus.doc} GET getLastUpdate
	'API de busca ultima atualização na tabela RUI'
	@ lucas.passos
	@since 04/11/2025

	@return return_var, return_type, return_description

	@Get(endpoint='/api/rh/v1/painel-auditoria/last-update', description='API de busca ultima atualização na tabela RUI') 
	public method getLastUpdate() as object 
	/*/
Method getLastUpdate() class AuditFolhaGPE
	Local cQuery        as character
	Local cAlias        as character
	Local jParams  		as json
	Local oJsBadResp 	as object
	Local oResponse  	as json

	oResponse 	:= JsonObject():New()
	jParams 	:= oRest:getQueryRequest()

	cQuery := "SELECT MAX(RUI_STAMP) AS RUI_STAMP "
	cQuery += " FROM " +RetSqlName("RUI")+ " "
	cQuery += " WHERE "
	cQuery += " D_E_L_E_T_ = ' ' "
	cQuery += " ORDER BY RUI_STAMP DESC; "

	cQuery        			:= ChangeQuery(cQuery) 
	oStatementLastUpdate	:= FwExecStatement():New(cQuery)

	cAlias := oStatementLastUpdate:OpenAlias()

	If (cAlias)->(Eof()) .Or. Empty((cAlias)->RUI_STAMP)
		oJsBadResp := JSonObject():new()
		oJsBadResp['code']    := CodeRespBadRequest
		oJsBadResp['message'] := EncodeUTF8(OemToAnsi(STR0004)) //"Nenhum registro encontrado" 
		oRest:setStatusCode(CodeRespBadRequest)
		oRest:setResponse(oJsBadResp:toJson()) 
		Return
	Else 
		oResponse["last-update"] := SubStr((cAlias)->RUI_STAMP,1,19)
		oRest:setResponse(EncodeUTF8(FwCutOff(oResponse:toJson())))
	EndIf

	(cAlias)->(dbCloseArea())

Return 

/*-------------------------------------------------------------------
{Protheus.doc} Get getBigNumbers
API de busca dos totais gerais de conformidades para o painel de auditoria

@author	Bruno Costa
@since	21/10/2025
-------------------------------------------------------------------*/
method getBigNumbers() class AuditFolhaGPE

	Local oItem			as object
	Local oJsBadResp 	as object
	Local cComp 		as character
	Local cRot 			as character
	Local cQuery 		as character
	Local cWhere 		as character
	Local cId 			as character
	Local cRubric 		as character
	Local cSearch 		as character
	Local nPOrder 		as numeric
    Local aBranches 	as array
	Local aFeedBack	 	as array
	Local jParams 		:= oRest:getQueryRequest() 	as json
	Local oResponse 	:= JsonObject():New() 		as json

	Static oStatementBig

    DEFAULT __cWhere  	:= ""
	DEFAULT __cValidFil := fValidFil()
	DEFAULT aFilValid 	:= self:getFilVld(StrTokArr(__cValidFil, "/"))
	DEFAULT oInMns 		:= InsightMessageRh():New()
	
	oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

	cComp     := IIf(jParams:hasProperty("month"), StrZero(Val(jParams["month"]), 2), "") + IIf(jParams:hasProperty("year"), jParams["year"], "")
	cRot      := IIf(jParams:hasProperty("period"), If(!jParams["period"] $ "Todos", jParams["period"], ""), "")
	cId       := IIf(jParams:hasProperty("id"), jParams["id"], "")
	cRubric   := IIf(jParams:hasProperty("rubricCode"), jParams["rubricCode"], "")
	cSearch   := IIf(jParams:hasProperty("cpf_cnpj"), jParams["cpf_cnpj"], "")
    aBranches := IIf(jParams:hasProperty("branchCode"), StrTokArr(jParams['branchCode'], ','), {}) 
	aFeedBack := IIf(jParams:hasProperty("feedback"), StrTokArr(jParams["feedback"], ","), {})
	nPOrder   := 1

	If Len(cComp) < 6 
		oJsBadResp := JSonObject():new()
		oJsBadResp['code']    := CodeRespBadRequest
		oJsBadResp['message'] := EncodeUTF8(OemToAnsi(STR0003)) //"Necessário enviar período, mês e ano para busca dos Big Numbers"
		oRest:setStatusCode(CodeRespBadRequest)
		oRest:setResponse(oJsBadResp:toJson()) 
		Return
	EndIf

	oResponse["items"] := {}

	If !Empty(cSearch)
        cSearch := AllTrim(oInMns:fFormatCNPJ(cSearch))
    EndIF
	
	If !Empty(cId)
		cId := Posicione('RUP', 3, xFilial('RUP') + cId, 'RUP_ID')
	EndIF

	If Len(aBranches) > 0 .Or. Len(aFeedBack) > 0 .Or. !Empty(cId) .Or. !Empty(cRubric) .Or. !Empty(cSearch)
		cWhere := self:getWherePar(,, cId,,,, Len(aBranches) > 0, cRubric, Len(aFeedBack) > 0, cSearch)
    EndIf 

	If !Empty(cRot)
		cWhere += "AND RUI.RUI_ROTEIR = ? GROUP BY RUI.RUI_COMPET, RUI.RUI_ROTEIR"
	EndIf 
	
	If oStatementBig == Nil .Or. !(__cWhere == cWhere)
		cQuery := "SELECT  ?, "
		cQuery += "SUM(CASE WHEN RUI_PREDIC = ? THEN 1 ELSE 0 END) AS QtdPredic, SUM(CASE WHEN RUI_TIPO = ? THEN 1 ELSE 0 END) AS QtdResolv " 
		cQuery += "FROM "+RetSqlName("RUI")+" RUI "
		cQuery += "INNER JOIN "+RetSqlName("SRA")+" SRA ON SRA.RA_FILIAL = RUI.RUI_FILIAL AND SRA.RA_MAT = RUI.RUI_MAT AND SRA.D_E_L_E_T_ = ? "
		cQuery += "WHERE RUI.RUI_COMPET = ?  AND RUI.D_E_L_E_T_ = ? "

		If !Empty(aFilValid)
			cQuery += " AND RUI.RUI_FILIAL IN ( ? ) "
		EndIf
		If !Empty(cWhere)
			cQuery += cWhere    
		EndIf 
		If Empty(cRot)
			cQuery += "GROUP BY RUI.RUI_COMPET"
		EndIf

		__cWhere  	  := cWhere
		cQuery        := ChangeQuery(cQuery) 
		oStatementBig := FwExecStatement():New(cQuery)
	EndIf

	oStatementBig:SetNumeric(nPOrder++, If(!Empty(cRot), "RUI.RUI_COMPET, RUI.RUI_ROTEIR", "RUI.RUI_COMPET"))
	oStatementBig:SetString(nPOrder++, "T")
	oStatementBig:SetString(nPOrder++, "1")
	oStatementBig:SetString(nPOrder++, " ")   //SRA.D_E_L_E_T_
	oStatementBig:SetString(nPOrder++, cComp) //RUI.RUI_COMPET
	oStatementBig:SetString(nPOrder++, " ")   //RUI.D_E_L_E_T_ 
	If !Empty(aFilValid)
		oStatementBig:SetIn(nPOrder++, aFilValid) //RUI.RUI_FILIAL
	EndIf
	If !Empty(cId)
		oStatementBig:SetString(nPOrder++, cId) //RUI.RUI_IDREGR
	EndIf 
    If Len(aBranches) > 0
        oStatementBig:SetIn(nPOrder++, aBranches) //RUI.RUI_FILIAL
    EndIf
	If !Empty(cRubric)
        oStatementBig:SetString(nPOrder++, cRubric) //RUI.RUI_PD
    EndIf
	If Len(aFeedBack) > 0
        oStatementBig:SetIn(nPOrder++, aFeedBack) //RUI.RUI_FEEDBK
    EndIf
	If Len(cSearch) > 0
        oStatementBig:SetString(nPOrder++, "%"+cSearch+"%") //SRA.RA_MAT
		oStatementBig:SetString(nPOrder++, "%"+cSearch+"%") //SRA.RA_CIC
		oStatementBig:SetString(nPOrder++, "%"+cSearch+"%") //SRA.RA_NOME
    EndIf
    If !Empty(cRot)
		oStatementBig:SetString(nPOrder++, cRot)  //RUI.RUI_ROTEIR
	EndIf

	cAlias := oStatementBig:OpenAlias()

	If (cAlias)->(Eof())
		oJsBadResp := JSonObject():new()
		oJsBadResp['code']    := CodeRespBadRequest
		oJsBadResp['message'] := EncodeUTF8(OemToAnsi(STR0004)) //"Nenhum registro encontrado" 
		oRest:setStatusCode(CodeRespBadRequest)
		oRest:setResponse(oJsBadResp:toJson()) 
		Return
	Else 
		oItem := JsonObject():new()
		oItem["general-situations"]  := (cAlias)->QtdPredic
		oItem["resolved-situations"] := (cAlias)->QtdResolv
		aAdd(oResponse["items"], oItem)
	EndIf

	(cAlias)->(dbCloseArea())

	oRest:setResponse(EncodeUTF8(FwCutOff(oResponse:toJson())))

return

/*-------------------------------------------------------------------
{Protheus.doc} Get getConformities
API de busca da estrutura da tabela de conformidades utilizada na exibição das regras para o painel de auditoria

@author	Bruno Costa
@since	21/10/2025
-------------------------------------------------------------------*/
method getConformities() class AuditFolhaGPE

	Local oItem			as object
    Local oJsBadResp 	as object
    Local cSearch	 	as character
	Local cQuery 		as character
	Local cWhere 		as character
	Local cAlias 		as character
	Local cComp 		as character
	Local cRot 			as character
	Local cId 			as character
	Local nPageSize 	as numeric
	Local nPOrder 		as numeric
	Local nStart 		as numeric
	Local nPage 		as numeric
	Local nEnd 			as numeric
	Local lHasNext 		as logical
    Local aBranches 	as array
	Local aFeedBack     as array
	Local jParams 		:= oRest:getQueryRequest() 	as json
	Local oResponse 	:= JsonObject():New() 		as json

	Static oStConformities
	
    DEFAULT __cWhere  	:= ""
	DEFAULT __cValidFil := fValidFil()
	DEFAULT aFilValid 	:= self:getFilVld(StrTokArr(__cValidFil, "/"))
    DEFAULT oInMns 		:= InsightMessageRh():New()

	oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

	cComp     := IIf(jParams:hasProperty("month"), StrZero(Val(jParams["month"]), 2), "") + IIf(jParams:hasProperty("year"), jParams["year"], "")
	cRot  	  := IIf(jParams:hasProperty("period"), If(!jParams["period"] $ "Todos", jParams["period"], ""), "")
	nPage 	  := IIf(jParams:hasProperty("page"), Val(jParams["page"]), 1)
	nPageSize := IIf(jParams:hasProperty("pageSize"), Val(jParams["pageSize"]), 100)
	cId       := IIf(jParams:hasProperty("id"), jParams["id"], "")
    cSearch   := IIf(jParams:hasProperty("cpf_cnpj"), jParams["cpf_cnpj"], "")
    aBranches := IIf(jParams:hasProperty("branchCode"), StrTokArr(jParams['branchCode'], ','), {}) 
	aFeedBack := IIf(jParams:hasProperty("feedback"), StrTokArr(jParams["feedback"], ","), {})
	nPOrder   := 1
	nStart 	  := (nPage - 1) * nPageSize + 1
	nEnd      :=  nPage * nPageSize + 1

	If !Empty(cComp) .And. Len(cComp) < 6 
		oJsBadResp := JSonObject():new()
		oJsBadResp['code']    := CodeRespBadRequest
		oJsBadResp['message'] := EncodeUTF8(OemToAnsi(STR0005)) //"Mês/Ano incorretos" 
		oRest:setStatusCode(CodeRespBadRequest)
		oRest:setResponse(oJsBadResp:toJson()) 
		Return
	EndIf

    If !Empty(cSearch)
        cSearch := oInMns:fFormatCNPJ(cSearch)  
    EndIF

    cWhere := self:getWherePar(cComp, cRot, cId,,, cSearch, Len(aBranches) > 0,, Len(aFeedBack)>0) 

	oResponse["items"] := {}

	If oStConformities == Nil .Or. !(__cWhere == cWhere)
		cQuery := "SELECT * FROM ( "
		cQuery += "SELECT ROW_NUMBER() OVER(ORDER BY RUI.RUI_IDREGR ASC) AS LINHA, " 
		cQuery += "RUI.RUI_IDREGR, RUI.RUI_PD, SRV.RV_DESC, RUP.RUP_DESCRI, RUP.RUP_CODIGO, COUNT(*) AS QTD "
		cQuery += "FROM "+RetSqlName("RUI")+" RUI "
		cQuery += "INNER JOIN "+RetSqlName("RUP")+" RUP ON RUP.RUP_ID = RUI.RUI_IDREGR AND RUP.D_E_L_E_T_ = ? "
		cQuery +=	"LEFT JOIN "+RetSqlName("SRV")+" SRV ON SRV.RV_COD = RUI.RUI_PD "
		cQuery +=   "AND " + FwJoinFilial("RUI", "SRV") 
		cQuery +=	" AND SRV.D_E_L_E_T_ = ? "
		cQuery += "WHERE RUI.D_E_L_E_T_ = ? "
		cQuery += "AND RUI.RUI_PREDIC = 'T' "

		If !Empty(aFilValid)
			cQuery += "AND RUI.RUI_FILIAL IN ( ? ) "
		EndIf

		If !Empty(cWhere)
			cQuery += cWhere    
		EndIf

		cQuery += "GROUP BY RUI.RUI_IDREGR, RUI.RUI_PD, SRV.RV_DESC, RUP.RUP_CODIGO, RUP.RUP_DESCRI ) TAB WHERE LINHA BETWEEN ? AND ?"

		__cWhere  	    := cWhere
		cQuery          := ChangeQuery(cQuery) 
		oStConformities := FwExecStatement():New(cQuery)
	EndIf

	oStConformities:SetString(nPOrder++, " ") //RUP.D_E_L_E_T_
	oStConformities:SetString(nPOrder++, " ") //SRV.D_E_L_E_T_
	oStConformities:SetString(nPOrder++, " ") //RUI.D_E_L_E_T_
	If(!Empty(aFilValid))
		oStConformities:SetIn(nPOrder++, aFilValid) //RUI.RUI_FILIAL
	EndIf
	If !Empty(cComp)
		oStConformities:SetString(nPOrder++, cComp) //RUI.RUI_COMPET
	EndIf 
	If !Empty(cRot)
		oStConformities:SetString(nPOrder++, cRot) //RUI.RUI_ROTEIR
	EndIf 
	If !Empty(cId)
		oStConformities:SetString(nPOrder++, cId) //RUI.RUI_IDREGR
	EndIf 
    If !Empty(cSearch)
		oStConformities:SetString(nPOrder++, cSearch) //RUI.RUI_CPF
        oStConformities:SetString(nPOrder++, cSearch) //RUI.RUI_NRINSC
	EndIf 
    If Len(aBranches) > 0
        oStConformities:SetIn(nPOrder++, aBranches) //RUI.RUI_FILIAL
    EndIf
	If Len(aFeedBack) > 0
        oStConformities:SetIn(nPOrder++, aFeedBack) //RUI.RUI_FEEDBK
    EndIf  
	oStConformities:SetString(nPOrder++, cValToChar(nStart))
	oStConformities:SetString(nPOrder++, cValToChar(nEnd))

	cAlias := oStConformities:OpenAlias()

	While !(cAlias)->(Eof())
		If (cAlias)->LINHA > (nEnd - 1)
			lHasNext := .T.
			Exit 
		EndIf   

		oItem := JsonObject():new()
	
		oItem["id"]  	    := RTrim((cAlias)->RUP_CODIGO)
		oItem["descricao"]	:= RTrim((cAlias)->RUP_DESCRI)
		oItem["rubricCode"] := RTrim((cAlias)->RUI_PD)
		oItem["rubricDesc"] := RTrim((cAlias)->RV_DESC)
		oItem["quantidade"] := (cAlias)->QTD 
		oItem["detail"]     := "true"
		
		aAdd(oResponse["items"], oItem)
		
		(cAlias)->(DbSkip())

	EndDo

	(cAlias)->(dbCloseArea())
	oResponse["hasNext"] := lHasNext 

	oRest:setResponse(EncodeUTF8(FwCutOff(oResponse:toJson())))

return

/*-------------------------------------------------------------------
{Protheus.doc} AuditFolhaGPE::getWherePar
Metódo para setar os campos na query

@return cRet character 
@author	Bruno Costa
@since	21/10/2025
-------------------------------------------------------------------*/
method getWherePar(cComp as character, cRot as character, cId as character, cCpf as character, cCnpj as character, cSearch as character, lTemFil as logical, cPd as character, lFeedBack as logical, cSearchSRA as character) as character class AuditFolhaGPE
    
    Local cRet as character

    DEFAULT cComp      := ""
    DEFAULT cRot       := ""
    DEFAULT cId        := ""
    DEFAULT cCpf       := ""
    DEFAULT cCnpj      := ""
    DEFAULT cSearch    := ""
	DEFAULT cPd        := ""
	DEFAULT cSearchSRA := ""
    DEFAULT lTemFil    := .F.
    DEFAULT lFeedBack  := .F.

    If !Empty(cComp)
		cRet += " AND RUI.RUI_COMPET = ? "
	EndIf
    If !Empty(cRot)
		cRet += " AND RUI.RUI_ROTEIR = ? "
	EndIf 
    If !Empty(cId)
		cRet += " AND RUI.RUI_IDREGR = ? "
	EndIf
    If !Empty(cCpf)
		cRet += " AND RUI.RUI_CPF = ? "
	EndIf
    If !Empty(cCnpj)
		cRet += " AND RUI.RUI_NRINSC = ? "
	EndIf
    If !Empty(cSearch)
		cRet += " AND (RUI.RUI_CPF = ? OR RUI.RUI_NRINSC = ?) "
	EndIf
    If lTemFil
	    cRet += " AND RUI.RUI_FILIAL IN (?) "
    EndIf   
	If !Empty(cPd)
	    cRet += " AND RUI.RUI_PD = ? "
    EndIf   
    If lFeedBack
        cRet += " AND RUI.RUI_FEEDBK IN (?) "
    EndIf   
	If !Empty(cSearchSRA)
		cRet += " AND (SRA.RA_MAT LIKE ? OR SRA.RA_CIC LIKE ? OR UPPER(SRA.RA_NOME) LIKE UPPER(?)) "
	EndIf

Return cRet

/*-------------------------------------------------------------------
{Protheus.doc} Get getEmployees
API de busca dos colaboradores com suas informações básicas e situação atual

@author	Bruno Costa
@since	21/10/2025
-------------------------------------------------------------------*/
method getEmployees() class AuditFolhaGPE

	Local oItem			as object
    Local oJsBadResp 	as object
	Local cQuery 		as character
	Local cWhere 		as character
	Local cAlias 		as character
	Local cComp 		as character
	Local cRot 			as character
	Local cId 			as character
	Local cRubric       as character
    Local nPageSize 	as numeric
   	Local nPOrder 		as numeric
	Local nStart 		as numeric
	Local nPage 		as numeric
	Local nEnd 			as numeric
	Local lHasNext 		as logical
    Local aBranches 	as array
	Local jParams 		:= oRest:getQueryRequest() 		as json
	Local oResponse 	:= JsonObject():New() 			as json

	Static oStEmployees
	
    DEFAULT __cWhere  	:= ""
	DEFAULT __cValidFil := fValidFil()
	DEFAULT aFilValid 	:= self:getFilVld(StrTokArr(__cValidFil, "/"))
    DEFAULT oInMns 		:= InsightMessageRh():New()

	oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

	cComp     := IIf(jParams:hasProperty("month"), StrZero(Val(jParams["month"]), 2), "") + IIf(jParams:hasProperty("year"), jParams["year"], "")
	cRot  	  := IIf(jParams:hasProperty("period"), If(!jParams["period"] $ "Todos", jParams["period"], ""), "")
    cCpf      := IIf(jParams:hasProperty("cpf"), jParams["cpf"], "")
    cCnpj     := IIf(jParams:hasProperty("cnpj"), jParams["cnpj"], "")
    cId       := IIf(jParams:hasProperty("id"), jParams["id"], "")
    nPage 	  := IIf(jParams:hasProperty("page"), Val(jParams["page"]), 1)
	nPageSize := IIf(jParams:hasProperty("pageSize"), Val(jParams["pageSize"]), 100)
    aBranches := IIf(jParams:hasProperty("branchCode"), StrTokArr(jParams['branchCode'], ','), {}) 
	cRubric	  := IIf(jParams:hasProperty("rubricCode"), jParams["rubricCode"], "")
	nPOrder   := 1
	nStart 	  := (nPage - 1) * nPageSize + 1
	nEnd      :=  nPage * nPageSize + 1

	If !Empty(cComp) .And. Len(cComp) < 6 
		oJsBadResp := JSonObject():new()
		oJsBadResp['code']    := CodeRespBadRequest
		oJsBadResp['message'] := EncodeUTF8(OemToAnsi(STR0005)) //"Mês/Ano incorretos" 
		oRest:setStatusCode(CodeRespBadRequest)
		oRest:setResponse(oJsBadResp:toJson()) 
		Return
	EndIf

    If !Empty(cCnpj)
        cCnpj := oInMns:fFormatCNPJ(cCnpj)  
    EndIF
	
	If !Empty(cId)
		cId := Posicione('RUP', 3, xFilial('RUP') + cId, 'RUP_ID')
	EndIF				
    
	cWhere := self:getWherePar(cComp, cRot, cId, cCpf, cCnpj, "", Len(aBranches) > 0, cRubric)

	oResponse["items"] := {}

	If oStEmployees == Nil .Or. !(__cWhere == cWhere)
        cQuery := "SELECT * FROM ( "
		cQuery += "SELECT ROW_NUMBER() OVER(ORDER BY RUI.RUI_FILIAL, RUI.RUI_MAT ASC) AS LINHA, " 
		cQuery += "RUI.RUI_FILIAL, RUI.RUI_MAT, RUI.RUI_NRINSC, RUI.RUI_CPF, RUI.RUI_COMPET, RUI.RUI_IDREGR, RUI.RUI_FEEDBK, RUI.RUI_ROTEIR, RUI.RUI_PD, RUI.RUI_MSGRET, RUP.RUP_CODIGO "
		cQuery += "FROM "+RetSqlName("RUI")+" RUI "
		cQuery += "INNER JOIN "+RetSqlName("RUP")+" RUP ON RUP.RUP_ID = RUI.RUI_IDREGR AND RUP.D_E_L_E_T_ = ? "
		cQuery += "WHERE RUI.RUI_PREDIC = ? AND RUI.D_E_L_E_T_ = ? "

		If !Empty(aFilValid)
			cQuery += " AND RUI.RUI_FILIAL IN ( ? ) "
		EndIf

		If !Empty(cWhere)
			cQuery += cWhere    
		EndIf

		cQuery += ") TAB WHERE LINHA BETWEEN ? AND ? "

		__cWhere  	    := cWhere
		cQuery          := ChangeQuery(cQuery) 
		oStEmployees := FwExecStatement():New(cQuery)
	EndIf

    oStEmployees:SetString(nPOrder++, " ") //RUP.D_E_L_E_T_
	oStEmployees:SetString(nPOrder++, "T") //RUI.RUI_PREDIC
	oStEmployees:SetString(nPOrder++, " ") //RUI.D_E_L_E_T_

	If !Empty(aFilValid)
		oStEmployees:SetIn(nPOrder++, aFilValid) //RUI.RUI_FILIAL
	EndIf
	If !Empty(cComp)
		oStEmployees:SetString(nPOrder++, cComp) //RUI.RUI_COMPET
	EndIf 
	If !Empty(cRot)
		oStEmployees:SetString(nPOrder++, cRot) //RUI.RUI_ROTEIR
	EndIf 
	If !Empty(cId)
		oStEmployees:SetString(nPOrder++, cId) //RUI.RUI_IDREGR
	EndIf 
    If !Empty(cCpf)
		oStEmployees:SetString(nPOrder++, cCpf) //RUI.RUI_CPF
	EndIf 
    If !Empty(cCnpj)
		oStEmployees:SetString(nPOrder++, cCnpj) //RUI.RUI_NRINSC
	EndIf 
    If Len(aBranches) > 0
        oStEmployees:SetIn(nPOrder++, aBranches) //RUI.RUI_FILIAL
    EndIf
	If !Empty(cRubric)
        oStEmployees:SetString(nPOrder++, cRubric) //RUI.RUI_PD
    EndIf
	
    oStEmployees:SetString(nPOrder++, cValToChar(nStart))
	oStEmployees:SetString(nPOrder++, cValToChar(nEnd))

	cAlias := oStEmployees:OpenAlias()

	While !(cAlias)->(Eof())
        If (cAlias)->LINHA > (nEnd - 1)
			lHasNext := .T.
			Exit 
		EndIf   

		oItem := JsonObject():new()

		oItem["id"]  	     				 := RTrim((cAlias)->RUP_CODIGO)
        oItem["name"]        				 := Alltrim(fDesc('SRA', (cAlias)->RUI_MAT, 'RA_NOME',, (cAlias)->RUI_FILIAL))
        oItem["branchCode"]  				 := (cAlias)->RUI_FILIAL
        oItem["employeeId"]  			     := (cAlias)->RUI_MAT
		oItem["rubricCode"]  				 := (cAlias)->RUI_PD
		//oItem["rubricDesc"]  := Alltrim(fDesc('SRV', (cAlias)->RUI_PD, 'RV_DESC',, (cAlias)->RUI_FILIAL)) //Provisório, Alterar futuramente a lógica para buscar o código/desc via query
		oItem["cpf"]	     				 := (cAlias)->RUI_CPF
		oItem["cnpj"]        				 := Rtrim((cAlias)->RUI_NRINSC)
		oItem["exceptionDescription"]        := Rtrim((cAlias)->RUI_MSGRET)
		oItem["feedback"]    				 := (cAlias)->RUI_FEEDBK 
		
        aAdd(oResponse["items"], oItem)
		
		(cAlias)->(DbSkip())

	EndDo

	(cAlias)->(dbCloseArea())   
    oResponse["hasNext"] := lHasNext 

	oRest:setResponse(EncodeUTF8(FwCutOff(oResponse:toJson())))

return

/*
{Protheus.doc} Get getConformitiesEmployees
API de busca de funcionários com conformidades agrupadas no período selecionado para o painel de auditoria
@author	Leandro Drumond
@since	09/03/2026
*/
method getConformitiesEmployees() class AuditFolhaGPE

	Local oItem			as object
    Local oJsBadResp 	as object
    Local cSearch	 	as character
	Local cQuery 		as character
	Local cWhere 		as character
	Local cAlias 		as character
	Local cComp 		as character
	Local cRot 			as character
	Local nPageSize 	as numeric
	Local nPOrder 		as numeric
	Local nStart 		as numeric
	Local nPage 		as numeric
	Local nEnd 			as numeric
	Local lHasNext 		as logical
    Local aBranches 	as array
	Local aFeedBack     as array
	Local jParams 		:= oRest:getQueryRequest() 	as json
	Local oResponse 	:= JsonObject():New() 		as json

	Static oStConformitiesEmployees
	
    DEFAULT __cWhere  	:= ""
	DEFAULT __cValidFil := fValidFil()
	DEFAULT aFilValid 	:= self:getFilVld(StrTokArr(__cValidFil, "/"))
    DEFAULT oInMns 		:= InsightMessageRh():New()

	oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

	cComp     := IIf(jParams:hasProperty("month"), StrZero(Val(jParams["month"]), 2), "") + IIf(jParams:hasProperty("year"), jParams["year"], "")
	cRot  	  := IIf(jParams:hasProperty("period"), If(!jParams["period"] $ "Todos", jParams["period"], ""), "")
	nPage 	  := IIf(jParams:hasProperty("page"), Val(jParams["page"]), 1)
	nPageSize := IIf(jParams:hasProperty("pageSize"), Val(jParams["pageSize"]), 100)
    cSearch   := IIf(jParams:hasProperty("cpf_cnpj"), jParams["cpf_cnpj"], "")
	aFeedBack := IIf(jParams:hasProperty("feedback"), StrTokArr(jParams["feedback"], ","), {})
    aBranches := IIf(jParams:hasProperty("branchCode"), StrTokArr(jParams['branchCode'], ','), {}) 
	nPOrder   := 1
	nStart 	  := (nPage - 1) * nPageSize + 1
	nEnd      :=  nPage * nPageSize + 1

	If !Empty(cComp) .And. Len(cComp) < 6 
		oJsBadResp := JSonObject():new()
		oJsBadResp['code']    := CodeRespBadRequest
		oJsBadResp['message'] := EncodeUTF8(OemToAnsi(STR0005)) //"Mês/Ano incorretos" 
		oRest:setStatusCode(CodeRespBadRequest)
		oRest:setResponse(oJsBadResp:toJson()) 
		Return
	EndIf

    If(!Empty(cSearch), cSearch := AllTrim(oInMns:fFormatCNPJ(cSearch)), Nil)

    cWhere := self:getWherePar(cComp, cRot,,,,, Len(aBranches) > 0,, Len(aFeedBack) > 0, cSearch) 

	oResponse["items"] := {}

	If oStConformitiesEmployees == Nil .Or. !(__cWhere == cWhere)
		cQuery := "SELECT * FROM ( "
		cQuery += "SELECT ROW_NUMBER() OVER(ORDER BY RUI.RUI_FILIAL, RUI.RUI_MAT ASC) AS LINHA, " 
		cQuery += "RUI.RUI_FILIAL, RUI.RUI_MAT, SRA.RA_NOME, RUI.RUI_CPF, RUI.RUI_NRINSC, COUNT(*) AS QTD "
		cQuery += "FROM "+RetSqlName("RUI")+" RUI "
		cQuery += "INNER JOIN "+RetSqlName("SRA")+" SRA ON SRA.RA_FILIAL = RUI.RUI_FILIAL AND SRA.RA_MAT = RUI.RUI_MAT AND SRA.D_E_L_E_T_ = ? "
		cQuery += "WHERE RUI.D_E_L_E_T_ = ? "
		cQuery += "AND RUI.RUI_PREDIC = ? "

		If !Empty(aFilValid)
			cQuery += "AND RUI.RUI_FILIAL IN ( ? ) "	
		EndIf

		If !Empty(cWhere)
			cQuery += cWhere    
		EndIf

		cQuery += "GROUP BY RUI.RUI_FILIAL, RUI.RUI_MAT, SRA.RA_NOME, RUI.RUI_CPF, RUI.RUI_NRINSC ) TAB WHERE LINHA BETWEEN ? AND ?"

		__cWhere  	    := cWhere
		cQuery          := ChangeQuery(cQuery) 
		oStConformitiesEmployees := FwExecStatement():New(cQuery)
	EndIf

	oStConformitiesEmployees:SetString(nPOrder++, " ") //SRA.D_E_L_E_T_
	oStConformitiesEmployees:SetString(nPOrder++, " ") //RUI.D_E_L_E_T_
	oStConformitiesEmployees:SetString(nPOrder++, "T") //RUI.RUI_PREDIC
	If !Empty(aFilValid)
		oStConformitiesEmployees:SetIn(nPOrder++, aFilValid) //RUI.RUI_FILIAL
	EndIf			
	If !Empty(cComp)
		oStConformitiesEmployees:SetString(nPOrder++, cComp) //RUI.RUI_COMPET
	EndIf 
	If(!Empty(cRot),oStConformitiesEmployees:SetString(nPOrder++, cRot),Nil) //RUI.RUI_ROTEIR
	
    If(Len(aBranches) > 0, oStConformitiesEmployees:SetIn(nPOrder++, aBranches), Nil) //RUI.RUI_FILIAL
    
	If Len(aFeedBack) > 0
        oStConformitiesEmployees:SetIn(nPOrder++, aFeedBack) //RUI.RUI_FEEDBK
    EndIf    
	If Len(cSearch) > 0
        oStConformitiesEmployees:SetString(nPOrder++, "%"+cSearch+"%") //SRA.RA_MAT
		oStConformitiesEmployees:SetString(nPOrder++, "%"+cSearch+"%") //SRA.RA_CIC
		oStConformitiesEmployees:SetString(nPOrder++, "%"+cSearch+"%") //SRA.RA_NOME
    EndIf

	oStConformitiesEmployees:SetString(nPOrder++, cValToChar(nStart))
	oStConformitiesEmployees:SetString(nPOrder++, cValToChar(nEnd))

	cAlias := oStConformitiesEmployees:OpenAlias()

	While !(cAlias)->(Eof())
		If (cAlias)->LINHA > (nEnd - 1)
			lHasNext := .T.
			Exit 
		EndIf   

		oItem := JsonObject():new()
	
		oItem["cpf"]  	    	:= RTrim((cAlias)->RUI_CPF)
		oItem["name"]			:= RTrim((cAlias)->RA_NOME)
		oItem["employeeId"] 	:= RTrim((cAlias)->RUI_MAT)
		oItem["branchCode"] 	:= RTrim((cAlias)->RUI_FILIAL)
		oItem["cnpj"]     		:= RTrim((cAlias)->RUI_NRINSC)
		oItem["quantity"] 		:= (cAlias)->QTD 
		
		aAdd(oResponse["items"], oItem)
		
		(cAlias)->(DbSkip())

	EndDo

	(cAlias)->(dbCloseArea())
	oResponse["hasNext"] := lHasNext 

	oRest:setResponse(EncodeUTF8(FwCutOff(oResponse:toJson())))

return

/*
{Protheus.doc} Get getConformitiesEmployeeDetails
API de busca dos detalhes de conformidades de um colaborador específico para o painel de auditoria
@author	Leandro Drumond
@since	09/03/2026
*/
method getConformitiesEmployeeDetails() class AuditFolhaGPE

	Local oItem			as object
    Local oJsBadResp 	as object
	Local cQuery 		as character
	Local cWhere 		as character
	Local cAlias 		as character
	Local cComp 		as character
	Local cRot 			as character
	Local cMat 			as character
	Local cFil 			as character
   	Local nPOrder 		as numeric
	Local aFeedBack	 	as array
	Local jParams 		:= oRest:getQueryRequest() 		as json
	Local jMat 			:= oRest:getPathParamsRequest() as json
	Local oResponse 	:= JsonObject():New() 			as json	

	Static oStEmployeesDetails
	
    DEFAULT __cWhere  := ""
    DEFAULT oInMns := InsightMessageRh():New()

	oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

	cMat      := IIf(jMat:hasProperty("employeeId"), jMat["employeeId"], "")
	cFil      := IIf(jParams:hasProperty("branchCode"), jParams["branchCode"], "")
	cComp     := IIf(jParams:hasProperty("month"), StrZero(Val(jParams["month"]), 2), "") + IIf(jParams:hasProperty("year"), jParams["year"], "")
	cRot  	  := IIf(jParams:hasProperty("period"), If(!jParams["period"] $ "Todos", jParams["period"], ""), "")
	aFeedBack := IIf(jParams:hasProperty("feedback"), StrTokArr(jParams["feedback"], ","), {})
	nPOrder   := 1

	If !Empty(cComp) .And. Len(cComp) < 6 
		oJsBadResp := JSonObject():new()
		oJsBadResp['code']    := CodeRespBadRequest
		oJsBadResp['message'] := EncodeUTF8(OemToAnsi(STR0005)) //"Mês/Ano incorretos" 
		oRest:setStatusCode(CodeRespBadRequest)
		oRest:setResponse(oJsBadResp:toJson()) 
		Return
	EndIf

	cWhere := self:getWherePar(cComp, cRot,,,,,,, Len(aFeedBack)>0) 

	oResponse["items"] := {}

	If oStEmployeesDetails == Nil .Or. !(__cWhere == cWhere)
        cQuery := "SELECT * FROM ( "
		cQuery += "SELECT ROW_NUMBER() OVER(ORDER BY RUI.RUI_FILIAL, RUI.RUI_MAT, RUI.RUI_PD ASC) AS LINHA, " 
		cQuery += "RUI.RUI_IDREGR, RUI.RUI_MSGRET, RUI.RUI_FEEDBK, RUI.RUI_PD, SRV.RV_DESC, RUP.RUP_CODIGO, RUP.RUP_DESCRI "
		cQuery += "FROM "+RetSqlName("RUI")+" RUI "
		cQuery += "INNER JOIN "+RetSqlName("RUP")+" RUP ON RUP.RUP_ID = RUI.RUI_IDREGR AND RUP.D_E_L_E_T_ = ? "
		cQuery += "LEFT JOIN "+RetSqlName("SRV")+" SRV ON " + FwJoinFilial("RUI", "SRV") + " AND SRV.RV_COD = RUI.RUI_PD AND SRV.D_E_L_E_T_ = ? "
		cQuery += "WHERE RUI.RUI_PREDIC = ? AND RUI.D_E_L_E_T_ = ? AND RUI.RUI_FILIAL = ? AND RUI.RUI_MAT = ? "

		If !Empty(cWhere)
			cQuery += cWhere    
		EndIf

		cQuery += ") TAB "

		__cWhere  	    := cWhere
		cQuery          := ChangeQuery(cQuery) 
		oStEmployeesDetails := FwExecStatement():New(cQuery)
	EndIf

    oStEmployeesDetails:SetString(nPOrder++, " ") //RUP.D_E_L_E_T_
	oStEmployeesDetails:SetString(nPOrder++, " ") //SRV.D_E_L_E_T_
	oStEmployeesDetails:SetString(nPOrder++, "T") //RUI.RUI_PREDIC
	oStEmployeesDetails:SetString(nPOrder++, " ") //RUI.D_E_L_E_T_
	oStEmployeesDetails:SetString(nPOrder++, cFil) //RUI.D_E_L_E_T_
	oStEmployeesDetails:SetString(nPOrder++, cMat) //RUI.D_E_L_E_T_
	If !Empty(cComp)
		oStEmployeesDetails:SetString(nPOrder++, cComp) //RUI.RUI_COMPET
	EndIf 
	If !Empty(cRot)
		oStEmployeesDetails:SetString(nPOrder++, cRot) //RUI.RUI_ROTEIR
	EndIf

	If Len(aFeedBack) > 0
        oStEmployeesDetails:SetIn(nPOrder++, aFeedBack) //RUI.RUI_FEEDBK
    EndIf     
	
	cAlias := oStEmployeesDetails:OpenAlias()

	While !(cAlias)->(Eof())

		oItem := JsonObject():new()

		oItem["id"]  	     				 := RTrim((cAlias)->RUP_CODIGO)
        oItem["descricao"]  				 := RTrim((cAlias)->RUP_DESCRI)
		oItem["rubricCode"]  				 := (cAlias)->RUI_PD
		oItem["rubricDesc"]  		 		 := Rtrim((cAlias)->RV_DESC)
		oItem["exceptionDescription"]        := Rtrim((cAlias)->RUI_MSGRET)
		oItem["feedback"]    				 := (cAlias)->RUI_FEEDBK 
		
        aAdd(oResponse["items"], oItem)
		
		(cAlias)->(DbSkip())

	EndDo

	(cAlias)->(dbCloseArea())   
    oResponse["hasNext"] := .F.

	oRest:setResponse(EncodeUTF8(FwCutOff(oResponse:toJson())))

return

/*-------------------------------------------------------------------
{Protheus.doc} Post setUpdationSituation
API de atualização da situação de uma conformidade do colaborador

@author	Bruno Costa
@since	23/10/2025
-------------------------------------------------------------------*/
method setUpdateFeedback() class AuditFolhaGPE

	Local cUserResolv 	as character
    Local dDtResolv 	as date
    Local nY 			as numeric
	Local nRecno        as numeric
    Local lRet 			as logical
    Local oJsBadResp 	as object
	Local oJsBody 		:= JsonObject():new() as json

    oJsBody:fromJson(oRest:GetBodyRequest())
    oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

    If Valtype(oJsBody["items"]) != "U" .And. Len(oJsBody["items"]) > 0  
        
        dDtResolv   := Date()
        cUserResolv := RetCodUsr()
        cUserResolv += " - " + UsrRetName(cUserResolv)

        dbSelectArea("RUI")
        RUI->(dbSetOrder(2)) //RUI_FILIAL+RUI_MAT+RUI_COMPET+RUI_IDREGR+RUI_ROTEIR

        For nY := 1 To Len(oJsBody["items"])
            cChave := oJsBody["items"][nY]["branchCode"] + oJsBody["items"][nY]["employeeId"] + StrZero(Val(oJsBody["items"][nY]["month"]), 2) + oJsBody["items"][nY]["year"] +;
			 oJsBody["items"][nY]["id"] + If(oJsBody["items"][nY]["period"] $ "Todos", "", oJsBody["items"][nY]["period"])
			 
            If lRet := RUI->(MsSeek(cChave))

				nRecno := RUI->(Recno())

				If nRecno > 0
				
					RUI->( DBGoTo(nRecno))
					dbSelectArea("RUU")

					RUU->(RecLock("RUU", .T.))
						RUU->RUU_FILIAL :=  RUI->RUI_FILIAL 
						RUU->RUU_MAT    :=  RUI->RUI_MAT      
						RUU->RUU_CPF    :=  RUI->RUI_CPF    
						RUU->RUU_NRINSC :=  RUI->RUI_NRINSC 
						RUU->RUU_COMPET :=  RUI->RUI_COMPET 
						RUU->RUU_CODPER :=  RUI->RUI_CODPER 
						RUU->RUU_PD     :=  RUI->RUI_PD     
						RUU->RUU_ROTEIR :=  RUI->RUI_ROTEIR 
						RUU->RUU_PREDIC :=  RUI->RUI_PREDIC 
						RUU->RUU_IDREGR :=  RUI->RUI_IDREGR 
						RUU->RUU_STAMP  :=  RUI->RUI_STAMP  
						RUU->RUU_UIDMSG :=  RUI->RUI_UIDMSG 
						RUU->RUU_PRODUT :=  RUI->RUI_PRODUT 
						RUU->RUU_TENANT :=  RUI->RUI_TENANT 
						RUU->RUU_INSIGT :=  RUI->RUI_INSIGT 
						RUU->RUU_TIPO   := IIF(Empty(RUI->RUI_FEEDBK),'',IIF(RUI->RUI_FEEDBK == '0' ,'0',IIF(RUI->RUI_FEEDBK = '1', '2', '3')))
						RUU->RUU_STHIST := StrZero(Year(Date()),4)+"-"+StrZero(Month(Date()),2)+"-"+StrZero(Day(Date()),2)+" "+SubStr(Time(),1,8)
						RUU->RUU_FEEDBK := RUI->RUI_FEEDBK  
						RUU->RUU_DTFEED := RUI->RUI_DTFEED
						RUU->RUU_USERRE := RUI->RUI_USERRE
						cTipo := RUU->RUU_TIPO 

					RUU->(MsUnlock())
				EndIf 

			 	RUI->(RecLock("RUI", .F.))
                RUI->RUI_FEEDBK := cValToChar(oJsBody["items"][nY]["feedback"])
                RUI->RUI_DTFEED := dDtResolv
                RUI->RUI_USERRE := cUserResolv
				RUI->RUI_TIPO   := cTipo
                RUI->(MsUnlock())
            EndIf  

        Next nY 

    EndIf

    If !lRet 
        oJsBadResp := JSonObject():new()
		oJsBadResp['code']    := CodeRespBadRequest
		oJsBadResp['message'] := EncodeUTF8(OemToAnsi(STR0006)) //Não foi possível realizar a alteração, pois o registro não foi encontrado
		oRest:setStatusCode(CodeRespBadRequest)
		oRest:setResponse(oJsBadResp:toJson()) 
    EndIf 

	RUI->(dbCloseArea())
	RUU->(dbCloseArea())

return

/*-------------------------------------------------------------------
{Protheus.doc} Get getFiliaisAudit
Serviço para retornar uma lista de filiais da SM0

@author	Bruno Costa
@since	28/10/2025
-------------------------------------------------------------------*/
method getFiliaisAudit() class AuditFolhaGPE
	Local oItem		as Object
	Local cSearch 	as character
	Local nPageSize as numeric
	Local nCount 	as numeric
	Local nStart 	as numeric
	Local nPage 	as numeric
	Local nEnd 		as numeric
	Local nI 		as Numeric
	Local lHasNext 	as logical
	Local jParams 	:= oRest:getQueryRequest() 	as Json
	Local oResponse := JsonObject():New() 		as Json

	DEFAULT aSM0 		:= FwLoadSM0()
	DEFAULT __cValidFil := fValidFil()
	DEFAULT aFilValid 	:= self:getFilVld(StrTokArr(__cValidFil, "/"))

	cSearch   := IIf(jParams:hasProperty("filter"), jParams["filter"], "")
	nPage     := Val(jParams["page"])
	nPageSize := Val(jParams["pageSize"])

	oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

	nStart := (nPage - 1) * nPageSize + 1
	nEnd   :=  nPage * nPageSize

	oResponse["items"] := {}

	For nI := 1 To Len(aSM0)
		If (aSM0[nI][SM0_GRPEMP] != cEmpAnt)
			LOOP
		EndIf

		If (!Empty(cSearch) .And. !(Upper(cSearch) $ Upper(aSM0[nI][SM0_CODFIL])) .And. !(Upper(cSearch) $ Upper(aSM0[nI][SM0_NOMRED])))
			LOOP
		EndIf

		If !Empty(aFilValid) .And. aScan(aFilValid, {|x| x == aSM0[nI][SM0_CODFIL]}) == 0
			LOOP
		EndIf

		nCount++
		If nCount < nStart
			LOOP
		EndIf
		
		If nCount > nEnd .And. Empty(cSearch)
			lHasNext := .T.
			Exit
		EndIf

		oItem := JSonObject():new()
		oItem["branchCode"] := EncodeUTF8(AllTrim(aSM0[nI][SM0_CODFIL]))
		oItem["branchName"] := EncodeUTF8(AllTrim(aSM0[nI][SM0_NOMRED]))
		oItem["branchCNPJ"] := EncodeUTF8(AllTrim(aSM0[nI][SM0_CGC]))

		aadd(oResponse["items"], oItem)

	Next nI

	oResponse["hasNext"] := lHasNext 

	oRest:setResponse(EncodeUTF8(FwCutOff(oResponse:toJson())))

return

/*-------------------------------------------------------------------
{Protheus.doc} Get getFilialAudit
Serviço para retornar uma filial na digitação do lookup

@author	Bruno Costa
@since	29/10/2025
-------------------------------------------------------------------*/
method getFilialAudit() class AuditFolhaGPE
	Local oItem		as Object
	Local cGetFil 	as character
	Local nPos 		as Numeric
	Local jFil      := oRest:getPathParamsRequest() as json
	Local oResponse := JsonObject():New() 			as Json

	DEFAULT aSM0 		:= FwLoadSM0()
	DEFAULT __cValidFil := fValidFil()
	DEFAULT aFilValid 	:= self:getFilVld(StrTokArr(__cValidFil, "/"))

	cGetFil := IIf(jFil:hasProperty("filial"), jFil["filial"], "")

	oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

	oResponse["items"] := {}

	If !Empty(cGetFil)
		If Len(aSM0) > 0
			nPos := aScan( aSM0, { |x| x[1] == cEmpAnt .And. Upper(AllTrim(x[2])) == Upper(AllTrim(cGetFil))} )
			If nPos > 0 .and. (Empty(aFilValid) .Or.  aScan(aFilValid, {|x| x == aSM0[nPos][SM0_CODFIL]}) > 0)
				oItem := JSonObject():new()
				oItem["branchCode"]	:= EncodeUTF8(AllTrim(aSM0[nPos][SM0_CODFIL]))
				oItem["branchName"]	:= EncodeUTF8(AllTrim(aSM0[nPos][SM0_NOMRED]))
				aadd(oResponse["items"], oItem)
			EndIf
		EndIf
	EndIf

	oRest:setResponse(EncodeUTF8(FwCutOff(oResponse:toJson())))

return

/*{Protheus.doc} getFilVld
Retorna array de filiais que usuário possui acesso
@author	Leandro Drumond
@since	12/03/2025
*/
method getFilVld(aVldFil as array) as array class AuditFolhaGPE
local aFiliais := {} as array
local nX as numeric

For nX := 1 to Len(aVldFil)
	If !Empty(aVldFil[nX])
		aAdd(aFiliais, aVldFil[nX])
	EndIf
Next nX

Return aFiliais

/*
{Protheus.doc} Get getExportAnalitico
API para busca de lista unificada e consolidada de conformidades para exportação
@author	Leandro Drumond
@since	18/03/2026
*/
method getExportAnalitico() class AuditFolhaGPE

	Local oItem			as object
    Local oJsBadResp 	as object
	Local cQuery 		as character
	Local cWhere 		as character
	Local cAlias 		as character
	Local cComp 		as character
	Local cRot 			as character
	Local cId 			as character
	Local cRubric       as character
	Local cSearch	 	as character
   	Local nPOrder 		as numeric
	Local lHasNext 		as logical
    Local aBranches 	as array
	Local aFeedBack	 	as array
	Local jParams 		:= oRest:getQueryRequest() 		as json
	Local oResponse 	:= JsonObject():New() 			as json

	Static oStExportAnalitico
	
    DEFAULT __cWhere  	:= ""
	DEFAULT __cValidFil := fValidFil()
	DEFAULT aFilValid 	:= self:getFilVld(StrTokArr(__cValidFil, "/"))
    DEFAULT oInMns 		:= InsightMessageRh():New()

	oRest:updateKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")

	cComp     := IIf(jParams:hasProperty("month"), StrZero(Val(jParams["month"]), 2), "") + IIf(jParams:hasProperty("year"), jParams["year"], "")
	cRot  	  := IIf(jParams:hasProperty("period"), If(!jParams["period"] $ "Todos", jParams["period"], ""), "")
    cSearch   := IIf(jParams:hasProperty("cpf_cnpj"), jParams["cpf_cnpj"], "")
    cId       := IIf(jParams:hasProperty("id"), jParams["id"], "")
    aBranches := IIf(jParams:hasProperty("branchCode"), StrTokArr(jParams['branchCode'], ','), {}) 
	cRubric	  := IIf(jParams:hasProperty("rubricCode"), jParams["rubricCode"], "")
	cViewType := IIf(jParams:hasProperty("viewType"), jParams["viewType"], "Regra")
	aFeedBack := IIf(jParams:hasProperty("feedback"), StrTokArr(jParams["feedback"], ","), {})
	nPOrder   := 1

	If !Empty(cComp) .And. Len(cComp) < 6 
		oJsBadResp := JSonObject():new()
		oJsBadResp['code']    := CodeRespBadRequest
		oJsBadResp['message'] := EncodeUTF8(OemToAnsi(STR0005)) //"Mês/Ano incorretos" 
		oRest:setStatusCode(CodeRespBadRequest)
		oRest:setResponse(oJsBadResp:toJson()) 
		Return
	EndIf

    If(!Empty(cSearch), cSearch := AllTrim(oInMns:fFormatCNPJ(cSearch)), Nil)
	
	If !Empty(cId)
		cId := Posicione('RUP', 3, xFilial('RUP') + cId, 'RUP_ID')
	EndIF				
    
	cWhere := self:getWherePar(cComp, cRot, cId,,,, Len(aBranches) > 0, cRubric, Len(aFeedBack) > 0, cSearch)

	oResponse["items"] := {}

	If oStExportAnalitico == Nil .Or. !(__cWhere == cWhere) .Or. cViewType <> __cViewType
        cQuery := "SELECT * FROM ( "
		If cViewType == "Regra"
			cQuery += "SELECT ROW_NUMBER() OVER(ORDER BY RUP.RUP_CODIGO, RUI.RUI_FILIAL, RUI.RUI_MAT ASC) AS LINHA, "
		Else 
			cQuery += "SELECT ROW_NUMBER() OVER(ORDER BY SRA.RA_NOME ASC) AS LINHA, " 
		EndIf
		cQuery += "RUI.RUI_FILIAL, RUI.RUI_MAT, SRA.RA_NOME, RUI.RUI_NRINSC, RUI.RUI_CPF, RUI.RUI_IDREGR, RUI.RUI_FEEDBK, RUI.RUI_PD, SRV.RV_DESC, RUI.RUI_MSGRET, RUP.RUP_CODIGO, RUP.RUP_DESCRI "
		cQuery += "FROM " + RetSqlName("RUI") + " RUI "
		cQuery += "INNER JOIN "+ RetSqlName("RUP") + " RUP ON RUP.RUP_ID = RUI.RUI_IDREGR AND RUP.D_E_L_E_T_ = ? "
		cQuery += "INNER JOIN "+ RetSqlName("SRA") + " SRA ON SRA.RA_FILIAL = RUI.RUI_FILIAL AND SRA.RA_MAT = RUI.RUI_MAT AND SRA.D_E_L_E_T_ = ? "
		cQuery += "LEFT JOIN "+RetSqlName("SRV")+" SRV ON " + FwJoinFilial("RUI", "SRV") + " AND SRV.RV_COD = RUI.RUI_PD AND SRV.D_E_L_E_T_ = ? "
		cQuery += "WHERE RUI.RUI_PREDIC = ? AND RUI.D_E_L_E_T_ = ? "

		If !Empty(aFilValid)
			cQuery += " AND RUI.RUI_FILIAL IN ( ? ) "
		EndIf

		If !Empty(cWhere)
			cQuery += cWhere    
		EndIf

		cQuery += ") TAB "

		__cWhere  	    := cWhere
		__cViewType		:= cViewType
		cQuery          := ChangeQuery(cQuery) 
		oStExportAnalitico := FwExecStatement():New(cQuery)
	EndIf

    oStExportAnalitico:SetString(nPOrder++, " ") //RUP.D_E_L_E_T_
	oStExportAnalitico:SetString(nPOrder++, " ") //SRA.D_E_L_E_T_
	oStExportAnalitico:SetString(nPOrder++, " ") //SRV.D_E_L_E_T_
	oStExportAnalitico:SetString(nPOrder++, "T") //RUI.RUI_PREDIC
	oStExportAnalitico:SetString(nPOrder++, " ") //RUI.D_E_L_E_T_

	If !Empty(aFilValid)
		oStExportAnalitico:SetIn(nPOrder++, aFilValid) //RUI.RUI_FILIAL
	EndIf
	If !Empty(cComp)
		oStExportAnalitico:SetString(nPOrder++, cComp) //RUI.RUI_COMPET
	EndIf 
	If !Empty(cRot)
		oStExportAnalitico:SetString(nPOrder++, cRot) //RUI.RUI_ROTEIR
	EndIf 
	If !Empty(cId)
		oStExportAnalitico:SetString(nPOrder++, cId) //RUI.RUI_IDREGR
	EndIf 
    If Len(aBranches) > 0
        oStExportAnalitico:SetIn(nPOrder++, aBranches) //RUI.RUI_FILIAL
    EndIf	
	If !Empty(cRubric)
        oStExportAnalitico:SetString(nPOrder++, cRubric) //RUI.RUI_PD
    EndIf
	If Len(aFeedBack) > 0
        oStExportAnalitico:SetIn(nPOrder++, aFeedBack) //RUI.RUI_FEEDBK
    EndIf 
	If Len(cSearch) > 0
        oStExportAnalitico:SetString(nPOrder++, "%"+cSearch+"%") //SRA.RA_MAT
		oStExportAnalitico:SetString(nPOrder++, "%"+cSearch+"%") //SRA.RA_CIC
		oStExportAnalitico:SetString(nPOrder++, "%"+cSearch+"%") //SRA.RA_NOME
    EndIf

	cAlias := oStExportAnalitico:OpenAlias()

	While !(cAlias)->(Eof())

		oItem := JsonObject():new()

		oItem["filial"]	     				 := RTrim((cAlias)->RUI_FILIAL)
        oItem["matricula"]     				 := RTrim((cAlias)->RUI_MAT)
        oItem["nome"]		  				 := RTrim((cAlias)->RA_NOME)
        oItem["cpf"]		  			     := (cAlias)->RUI_CPF
		oItem["cnpj"]		  			     := (cAlias)->RUI_NRINSC
		oItem["idRegra"]	  			     := (cAlias)->RUP_CODIGO
		oItem["descricaoRegra"]			     := RTrim((cAlias)->RUP_DESCRI)
		oItem["codRubrica"]	  				 := (cAlias)->RUI_PD
		oItem["descRubrica"] 				 := RTrim((cAlias)->RV_DESC)
		oItem["excecao"]	   				 := RTrim((cAlias)->RUI_MSGRET)
		oItem["feedback"]    				 := (cAlias)->RUI_FEEDBK 
		
        aAdd(oResponse["items"], oItem)
		
		(cAlias)->(DbSkip())

	EndDo

	(cAlias)->(dbCloseArea())   
    oResponse["hasNext"] := lHasNext 

	oRest:setResponse(EncodeUTF8(FwCutOff(oResponse:toJson())))

return
