IF ( Type("Altera") == "U" )
	_SetOwnerPrvt( "Altera" , .F. )
EndIF
aSvRotSetOpc[3] := { "Altera" , Altera }

/*/
ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
