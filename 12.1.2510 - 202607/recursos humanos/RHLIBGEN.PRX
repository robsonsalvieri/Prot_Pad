IF ( Type("Visual") == "U" )
	_SetOwnerPrvt( "Visual"	, .T. )
EndIF
aSvRotSetOpc[1] := { "Visual" , Visual }

/*/
ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
