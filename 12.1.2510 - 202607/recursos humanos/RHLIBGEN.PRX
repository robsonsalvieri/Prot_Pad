Function lIsSRVDir(cCaminho)

cCaminho := AllTrim(cCaminho)
If Right(cCaminho,1) == "\"
	cCaminho := SubStr(cCaminho,1,Len(cCaminho)-1)
EndIf

Return (Ascan( Directory(cCaminho,"D",1),{|_Vet | "D" $ _Vet[5] } ) > 0)

