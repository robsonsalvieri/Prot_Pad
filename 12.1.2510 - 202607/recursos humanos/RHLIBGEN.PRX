±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß*/
Function fCondExec(cCond,cExec1,cExec2)
Local bCond  := &( "{ || " + cCond  + "}" )
Local bExec1 := &( "{ || " + cExec1 + "}" )
Local bExec2 := &( "{ || " + cExec2 + "}" )

Return If( Eval( bCond ), Eval( bExec1 ), Eval( bExec2 ) )

