Function aRotReSetOpc( aSvRotSetOpc )

Local nOpc
Local nOpcs

nOpcs  := Len( aSvRotSetOpc )
For nOpc := 1 To nOpcs 
	IF ( Type( aSvRotSetOpc[ nOpc , 1 ] ) == "L" )
		&( aSvRotSetOpc[ nOpc , 1 ] ) := aSvRotSetOpc[ nOpc , 2 ]
	EndIF 
Next nOpc

Return( NIL )

/*/
ÚÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄ¿
