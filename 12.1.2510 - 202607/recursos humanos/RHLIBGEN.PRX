Function lFileCreate( acArquivo ) 
	Local nHandle 	:= 0
	Local lCreated  := .F.    
                  
    FErase( acArquivo )        
    nHandle := FCreate( acArquivo )
            
	If !( nHandle == -1 )
		FClose(nHandle) 
		lCreated := .T.
   	EndIf

Return lCreated

