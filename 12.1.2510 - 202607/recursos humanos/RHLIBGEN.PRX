Function aRotSetOpc( cAlias , nReg , nOpc , lPutInEof )

Local aSvRotSetOpc := Array( 4 )

DEFAULT lPutInEof := .T.

/*/
ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
