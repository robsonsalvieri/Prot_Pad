IF ( Type("Inclui") == "U" )
	_SetOwnerPrvt( "Inclui" , .F. )
EndIF
aSvRotSetOpc[2] := { "Inclui" , Inclui }

/*/
ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
