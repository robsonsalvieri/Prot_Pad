±±³ 		   ³		³	   ³ 										  ³±±
±±ÀÄÄÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ±±
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß/*/
Function Sal_Min(Val_SalMin, cAnoMes)

Local cTab		:= "S004"
Local nPosTab	:= 0
Local nPRlq		:= 0
Local dDataRef	:= cTod("//")

If cPaisLoc == "CHI"
	If GXLocRlq( 1, , , @nPRlq )
		Return .T.
	EndIf
EndIf

If Type("cCompl") <> "U" .And. cCompl == "S"
	cAnoMes := AnoMes(dDataDem)
EndIf

// Para o cálculo de deferença de férias
If Type("cTipoRot") <> "U" .And. cTipoRot == "3" .And. lCalcFol
	cAnoMes := cSvSetPer
EndIf

If cPaisLoc == "BOL"
	dDataref := CTOD("01/" + SubStr(cAnoMes,5,2) + "/" + SubStr(cAnoMes,1,4))
	VAL_SALMIN := FTABELA("S005",1,4, dDataRef)
Else
	nPosTab := fPosTab( cTab,cAnoMes,">=",4,cAnoMes,"<=",5)
	If nPosTab > 0
		VAL_SALMIN := fTabela(cTab,nPosTab,6)
	Else 
		VAL_SALMIN := 0
	EndIf
EndIf

If Empty(VAL_SALMIN)
	Set Device To Screen
	If GetRemoteType() == -1
		MsgLogGrid( iif(cPaisLoc=="BOL",STR0215,Ap5GetHelp("SEMSALAMIN")), .F. ) // Retornar string da funcao Help
	Else
		If IsInCallStack( "EXECROT" ) //Se estiver executando roteiro de calculo
			AddLogExecRot( iif(cPaisLoc=="BOL",STR0215,STR0157 ))	// "Tabela de Salário Minimo (Tabela S004) não cadastrada."
		Else
			If cPaisLoc == "BOL"
				Help(" ",1,STR0215)
			Else
				Help(" ",1,"SEMSALAMIN")
			EndIf
		EndIf
	EndIf
	Return ( .F. )
EndIf

If cPaisLoc == "CHI"
	GXLocRlq( 1, .F., { { 'VAL_SALMIN', VAL_SALMIN } }, nPRlq )
EndIf

Return .T.

/*/
ÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜ
