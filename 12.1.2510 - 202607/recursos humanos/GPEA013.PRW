Function GPEA013()
Local cFiltraRh
Local oBrwRFO  
Local oDlg
Local oRadio
Local nRadio
Local nOpca := 1
 
Private nTpVale	:= 2

oBrwRFO := FWmBrowse():New()		
oBrwRFO:SetAlias( 'RFO' )
oBrwRFO:SetDescription( STR0016 )   //"Definicao de Vale Alimentação"
If hasSmartX()
	oBrwRFO:setSmartX( 1, .T. ) // RFO_FILIAL + RFO_TPVALE + RFO_CODIGO - Tipo + Cód. Benef.
Endif		

//Inicializa o filtro utilizando a funcao FilBrowse
cFiltraRh := CHKRH("GPEA013","RFO","1")

If !Empty(cFiltraRh)
	cFiltraRh += " .And. "
EndIf 

cFiltraRh += "RFO_TPVALE == '" +CValtoChar(nTpVale) + "'"

//Filtro padrao do Browse conforme tabela RFO (Definicao de Beneficios)
oBrwRFO:SetFilterDefault(cFiltraRh)
	
oBrwRFO:Activate()    

Return( Nil )

