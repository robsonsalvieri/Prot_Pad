/*
зддддддддддбдддддддддддддддддддбдддддддбдддддддддддддддддддддддбддддддбдддддддддддддддддддддддддддддддддддддддд©
ЁFun┤┘o    Ёpn150MontaGetDados Ё Autor Ё Leandro Drumond       Ё Data Ё24/01/2008							   Ё
цддддддддддедддддддддддддддддддадддддддадддддддддддддддддддддддаддддддадддддддддддддддддддддддддддддддддддддддд╢
ЁDescri┤┘o ЁMontar a GetDados de acordo com o periodo informado             						           Ё
цддддддддддедддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддЁ
ЁSintaxe   Ёpn150MontaGetDados(cAlias, nOpcX, oGet, lPriVez)											       Ё
цддддддддддеддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддд╢
ЁParametrosЁcAlias                                                                               		       Ё
Ё          ЁnOpcX  																							   Ё
Ё          ЁoGet.																							   Ё
Ё          ЁlPriVez																							   Ё
Ё          ЁaAPOCols 																					       Ё
цддддддддддеддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддд╢
ЁRetorno   ЁLogico                                                          								   Ё
цддддддддддеддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддд╢
ЁUso       ЁPONA150                                                            							       Ё
юддддддддддаддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддды*/

Static Function pn150MontaGetDados(cAlias, nOpcX, oGet, lPriVez)

Local lRet			:= .T.
Local aArea			:= GetArea()

dbSelectArea(cAliasP)
dbSetOrder(2)

//Carrega Codigo de Evento Desc.Parte Funcionario com identificador igual a "016A"
cPD		:=	PosSP9("016A",SRA->RA_FILIAL,"P9_CODIGO",2)
//Carrega Codigo de Evento Desc.Parte Empresa com identificador igual a "015A"
cPDEmpr :=	PosSP9("015A",SRA->RA_FILIAL,"P9_CODIGO",2)  

Begin Sequence
	/*/
	здддддддддддддддддддддддддддддддддддддддддддддддддддддд©
	Ё Obtem Periodo de Apontamento conforme o Processo do  Ё
	Ё funcionario										   Ё
	юдддддддддддддддддддддддддддддддддддддддддддддддддддддды/*/ 
	cProcesso			:= SRA->RA_PROCES
	oPeriodo:cProcesso 	:= cProcesso
	oPeriodo:cRoteiro	:= 'PON'
	
    If !(fGetPeriodo( oPeriodo , lPriVez))
    	lRet := .F.
    	lSegue := lRet
    	Break
    EndIf
    
  	cRot	 		:= "PON"
	cPeriodo  		:= oPeriodo:cPeriodo
	cNumPagto 		:= oPeriodo:cNumPagto
	If lPeriodo
		dPerIni    		:= oPeriodo:dDataIni
		dPerFim    		:= oPeriodo:dDataFim
		cDatas			:= ( DTOC(dPerIni) + " - "  + DTOC(dPerFim))
	Else
		dPerIni           := aDatas[1]
		dPerFim			  := aDatas[2]
		dDataIni		  := dPerIni
		dDataFim		  := dPerFim
		dAntIni 		  := oPeriodo:dDataIni
		dAntFim			  := oPeriodo:dDataFim
		oPeriodo:dDataIni := dPerIni
		oPeriodo:dDataFim := dPerFim
	EndIf

	/*/
	зддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддд©
	Ё Carrega o Calendario de Marcacoes do Funcionario            Ё
	юддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддды/*/
	IF !GetMarcacoes(	@aMarcacoes							,;	//01 -> Marcacoes dos Funcionarios
						@aTabCalend							,;	//02 -> Calendario de Marcacoes
						@aTabPadrao							,;	//03 -> Tabela Padrao
						NIL     							,;	//04 -> Turnos de Trabalho
						@dPerIni					 		,;	//05 -> Periodo Inicial
						dPerFim								,;	//06 -> Periodo Final
						SRA->RA_FILIAL						,;	//07 -> Filial
						SRA->RA_MAT							,;	//08 -> Matricula
						SRA->RA_TNOTRAB						,;	//09 -> Turno
						SRA->RA_SEQTURN						,;	//10 -> Sequencia de Turno
						SRA->RA_CC							,;	//11 -> Centro de Custo
						If(cAliasP=="SP5", "SP8", "SPG")	,;	//12 -> Alias para Carga das Marcacoes
						.T.									,;	//13 -> Se carrega Recno em aMarcacoes
						.T.		 							,;	//14 -> Se considera Apenas Ordenadas
						NIL				 	 				,;  //15 -> Verifica as Folgas Automaticas
						NIL  		 						,;  //16 -> Se Grava Evento de Folga Mes Anterior
						NIL	   								,;	//17 -> Se Carrega as Marcacoes Automaticas
						NIL		   						    ,;	//18 -> Registros de Marcacoes Automaticas que deverao ser Deletados						
						NIL				   					,;  //19 -> Bloco para avaliar as Marcacoes Automaticas que deverao ser Desprezadas
						lPona270				   			;   //20 -> Se Considera o Periodo de Apontamento das Marcacoes - Se for acumulado, ira considerar, do contrario nao
					  )
  		oCalendError:ShowErrors()  
		Return( .F. )
	EndIF

	/*/
	зддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддд©
	Ё Limite Periodo Incicial											  Ё
	юддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддды/*/
	uPerIni	:= GetInfoPosTab( CALEND_POS_LIM_MARCACAO , "1E" , dPerIni , aTabCalend )
	uPerIni	:= DataHora2Str( uPerIni[1] , uPerIni[2] )
	/*/
	зддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддд©
	Ё Limite Periodo Final    									  Ё
	юддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддды/*/
	uPerFim	:= GetInfoPosTab( CALEND_POS_LIM_MARCACAO , "__LASTMARC__" , dPerFim , aTabCalend )
	uPerFim	:= DataHora2Str( uPerFim[1] , uPerFim[2] )

	//зддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддд©
	//Ё Gerar o array aCols com os Eventos                          Ё
	//юддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддды
	If !Pn150aCols( A150fIELD , nOpcX )
		lRet := .F.	
		Return(lRet)
	EndIf	                       

If lRet ==  .T.

	//здддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддд©
	//Ё Posiciona ponteiro do arquivo cabeca e inicializa variaveis  Ё
	//юдддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддды
	nOpcA := 0
          	
	If !Empty(RCH->RCH_ROTEIR)
		cRot := RCH->RCH_ROTEIR
	EndIf                      

ElseIf nOpcx != 3 .and. lRet ==  .F.

	aCols   := aClone(aColsAnt)
	cDatas  := cDatasAnt

EndIf	

//Ordena as Linhas de Registros
aSort(aCols,,, bSort )
aColsAnt := aClone(aCols)  

// atualiza a getdados
If !(oGet == nil)  
	oGet:Refresh()
EndIf

End Sequence

RestArea( aArea )

Return (lRet)

/*/   
зддддддддддбддддддддддддддбдддддддбдддддддддддддддддддбддддддбдддддддддд©
ЁFun┤└o    ЁfGetPeriodo   Ё Autor Ё Leandro Drumond   Ё Data Ё23/01/2008Ё
цддддддддддеддддддддддддддадддддддадддддддддддддддддддаддддддадддддддддд╢
ЁDescri┤└o ЁObtem o periodo de apontamento							    Ё
цддддддддддедддддддддддддддддддддддддддддддддддддддддддддддддддддддддддд╢
ЁExemplo   ЁoPeriodo:=RHPERIODO:New()       //Criacao do Obj            Ё
цддддддддддедддддддддддддддддддддддддддддддддддддддддддддддддддддддддддд╢
ЁSintaxe   ЁfGetPeriodo( oPeriodo )										Ё
цддддддддддедддддддддддддддддддддддддддддддддддддддддддддддддддддддддддд╢
ЁUso       ЁGenerico                                                    Ё
юддддддддддадддддддддддддддддддддддддддддддддддддддддддддддддддддддддддды/*/
Static Function fGetPeriodo( oPeriodo, lPriVez)

Local aArea 		:= GetArea()
Local lRet 			:= .T.

DEFAULT lPriVez := .F.

Begin Sequence      
    /*/
	зддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддд©
	ЁObtem Informacoes do Periodo Solicitado					  Ё
	юддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддды/*/
	//Se nЦo for acumulado, irА sempre verificar perМodos vazios
	If !lPona270
		//Obtem o periodo selecionado
		oPeriodo:PerSel()
		/*/
		зддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддд©
		ЁMostra Advertencia de Periodo Fechado p/ Manutencao de Perio Ё
		Ёdos Abertos.												  Ё
		юддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддды/*/	
		//Se lpona270 for .f., somente podera ser visualizado periodos que estejam abertos (rch_dtfecha vazio) 		
		If oPeriodo:lFechado 
			MsgInfo( OemToAnsi( oPeriodo:cMsgClosedPer ) )    //"PerМodo de Apontamento Fechado. Selecione ou informe um PerМodo Aberto."
			lRet		:= .F.
			Break
		EndIf	 
	Else
		If lPriVez
			oPeriodo:PerUltFech()
		Else		
			oPeriodo:GetPer("!EMPTY(RCH_DTFECH)")
		EndIf

		/*/
		зддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддд©
		ЁMostra Advertencia de Periodo Aberto para Manutencao de PerioЁ
		Ёdos Fechados.												  Ё
		юддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддды/*/	
	 	If oPeriodo:lAberto
			MsgInfo( OemToAnsi( oPeriodo:cMsgOpenedPer ) )    //"PerМodo de Apontamento Aberto. Selecione ou informe um PerМodo Fechado."
	 		lRet		:= .F.
	 		Break
	 	EndIf
	EndIf

    /*/
	зддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддд©
	ЁMostra Advertencia para Periodo Nao Encontrado				  Ё
	юддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддды/*/
	If !oPeriodo:lFound
 		lRet		:= .F. 
		MsgInfo( OemToAnsi( oPeriodo:cMsgNotFoundPer ) )	//"PerМodo de Apontamento NЦo Encontrado."
 		Break
	Endif	
	
End Sequence

/*/
зддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддд©
ЁRecupera Valores do Periodo antes da Troca de Periodo 		  Ё
юддддддддддддддддддддддддддддддддддддддддддддддддддддддддддддды/*/	
If !lRet
	oPeriodo:RollBack()
Endif

RestArea( aArea )

Return( lRet )

