Function Pna150Dtp()            

Local cVar := 	&(ReadVar())
Local lRet :=	.T.

//--Alimenta a Descricao do Tipo de Refeicao
aCols[ n , nPosDescRef ] := fDesc("SPM",cVar,"PM_DESCREF",TamSx3(cPrefixo+"DESCREF")[1] )

Return( lRet )

/*
