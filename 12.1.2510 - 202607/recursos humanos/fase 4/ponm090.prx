Static Function fCampos(cAlias, aCpos)

Local cCampos 	:= ""
Local nCpos		:= Len(aCpos)
Local nX

For nX := 1 To nCpos
	cCampos+= aCpos[nX,01]+","
Next nX

cCampos:= cCampos + cAlias + '.R_E_C_N_O_ RECNO '

Return (cCampos) 

