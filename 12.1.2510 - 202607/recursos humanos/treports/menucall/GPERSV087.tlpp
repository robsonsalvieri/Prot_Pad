#Include "TOTVS.ch"

//-------------------------------------------------------------------
/*/{Protheus.doc} GPERSV087

Chamada do objeto de negócios rh.sv.gpe.gper087 e relatório no Smart View pela função totvs.framework.treports.callTReports  
@author  lidio.oliveira
@since   06/02/2026
@version 1.0
/*/
Function GPERSV087()

	local lSuccess As logical
    local oSmartView as object
    
    If GetRpoRelease() > "12.1.2210"

        oSmartView := totvs.framework.smartview.callSmartView():new("rh.sv.gpe.gper087")
        oSmartView:setShowWizard(.T.)
        lSuccess := oSmartView:executeSmartView(.T.)
    
        If !lSuccess
            Conout(oSmartView:getError())
        EndIf  
    
        oSmartView:destroy()

    EndIf

Return
