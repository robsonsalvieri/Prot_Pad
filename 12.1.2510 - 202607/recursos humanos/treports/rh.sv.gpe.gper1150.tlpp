#INCLUDE 'msobject.ch'
#INCLUDE 'totvs.framework.treports.integratedprovider.th'
#INCLUDE 'rh.sv.gpe.gper1150.ch'

namespace totvs.protheus.rh.treportsintegratedprovider

//-------------------------------------------------------------------------------
/*{Protheus.doc} gper1150TReportsBusinessObject

@description Clase para la creación del Objeto de Negocio para TReports
@author oscar.lopez
@since 12/02/2026
@version 1.0
*/
//-------------------------------------------------------------------------------
@totvsFrameworkTReportsIntegratedProvider(active=.T., team='SIGAGPE', tables='SRA, SRC, SRV, SRG', name="Carta Finiquito / Renuncia", country='MEX', initialRelease='12.1.2210', customTables='SRA, SRC, SRV, SRG')
class gper1150TReportsBusinessObject from totvs.framework.treports.integratedprovider.IntegratedProvider

	Public Method new() as object
	Public Method getData() as object
	Public Method getSchema() as object

	Protected data aFields		as array
	Protected data aStruct		as array
	Protected data jItems		as json

endclass

//-------------------------------------------------------------------
/*{Protheus.doc} new
Método de instancia de la Clase

@Return object: self
@author oscar.lopez
@since 12/02/2026
@version 1.0
*/
//-------------------------------------------------------------------
Method new() class gper1150TReportsBusinessObject

	_Super:new()

	//Define o nome do Objeto de Negócio
	self:setDisplayName(STR0001)  // "Carta Finiquito / Renuncia"

	//Define a descrição do Objeto de Negócio
	self:setDescription(STR0001)  // "Carta Finiquito / Renuncia"

	// Define a Área
	self:appendArea(STR0002) // 'Gestión de Personal'

	// Define se as perguntas terao lookup
	self:setIsLookUp(.T.)

	self:aFields := {"RA_MAT"		, "RA_NOMECMP"	, "RA_ADMISSA"	, "RA_FECREI"	, "RG_DATADEM"	, "RA_DTREC"	, "RA_CIC"		, "RA_CURP"		, "RA_RG"		,;
					 "RA_SALMES"	, "RA_SALINT"	, "RA_SALDIA"	}

	self:aStruct := getStrutObj(self:aFields)

Return (self)

//-------------------------------------------------------------------
/*{Protheus.doc} getData
Retorna los datos del objeto de negocio

@param nPage, numérico, indica la pagina actual del relatório
@param oFilter, objeto, contiene el filtro del TReports
@return object: self:oData
@author oscar.lopez
@since 12/02/2026
@version 1.0
*/
//------------------------------------------------------------------- 
Method getData( nPage as numeric, oFilter as object) as object class gper1150TReportsBusinessObject

	// Declaracion de variables locales
	Local oQryEmp		As Object
	Local jParams		As JSON
	Local nParQry		As Numeric
	Local nIteracion	As Numeric
	Local cAlias		As Character
	Local cQuery		As Character
	Local cRotRes		As Character 
	Local cRotApl		As Character
	Local cFilSRJ		As Character
	Local cSucEmp		As Character
	Local aCodFol		As Array
	Local aRoteir		As Array
	Local aCposSuc		As Array
	Local aInfoSuc		As Array
	Local lCodFol		As Logical
	Local lHasNext		As Logical

	// Variables para filtros en query
	Local cSucuIni		As Character
	Local cSucuFin		As Character
	Local cProcIni		As Character
	Local cProcFin		As Character
	Local aSituaci		As Array
	Local cMatrIni		As Character
	Local cMatrFin		As Character
	Local dBajaIni		As Date
	Local dBajaFin		As Date
	Local dGeneIni		As Date
	Local dGeneFin		As Date
	Local cTipCalc		As Character
	Local aTipCalc		As Array

	DbSelectArea("SRJ")
	SRJ->(DbSetOrder(1)) // RJ_FILIAL+RJ_FUNCAO

	// Inicializacion de las variables
	jItems		:= JsonObject():new()
	cSucEmp		:= ""
	lHasNext	:= .F.
	nParQry		:= 1
	aSituaci	:= {}
	aTipCalc	:= {}
	aCposSuc	:= {"M0_NOMECOM", "M0_CGC", "M0_ENDENT", "M0_BAIRENT", "M0_CIDENT"}
	aRoteir		:= {}
	cRotRes		:= fGetCalcRot('4')	//Rescisión
	cRotApl		:= fGetCalcRot('A')	//Aplicación de Rescisión

	If !Empty(cRotRes)
		AADd(aRoteir, cRotRes)
	EndIf

	If !Empty(cRotApl)
		AADd(aRoteir, cRotApl)
	EndIf

	jParams		:= oFilter:getParameters()
	cSucuIni	:= jParams['PAR_FILINI'][1]	// De Filial
	cSucuFin	:= jParams['PAR_FILFIN'][1]	// A Filial
	cProcIni	:= jParams['PAR_PROINI'][1]	// De Proceso
	cProcFin	:= jParams['PAR_PROFIN'][1]	// A Proceso
	For nIteracion := 1 To Len(jParams['PAR_SITUAC'])
		AAdd(aSituaci, SubStr(jParams['PAR_SITUAC'][nIteracion], 1, 1))	// Situaciones
	Next nIteracion
	cMatrIni	:= jParams['PAR_MATINI'][1]	// De Matrícula
	cMatrFin	:= jParams['PAR_MATFIN'][1]	// A Matrícula
	dBajaIni	:= StoD(StrTran(SubStr(jParams['PAR_FBAINI'][1], 1, 10), "-", ""))	// De Fecha Baja
	dBajaFin	:= StoD(StrTran(SubStr(jParams['PAR_FBAFIN'][1], 1, 10), "-", ""))	// A Fecha Baja
	dGeneIni	:= StoD(StrTran(SubStr(jParams['PAR_FGEINI'][1], 1, 10), "-", ""))	// De Fecha Generación
	dGeneFin	:= StoD(StrTran(SubStr(jParams['PAR_FGEFIN'][1], 1, 10), "-", ""))	// A Fecha Generación
	cTipCalc	:= AllTrim((jParams['PAR_TPCALC'][1]))	// ¿Tipo Cálculo?
	If cTipCalc $ "1|3"
		AAdd(aTipCalc, "1")
	EndIf
	If cTipCalc $ "2|3"
		AAdd(aTipCalc, "2")
	EndIf

	cQuery := " SELECT SRA.RA_FILIAL, SRA.RA_MAT, SRA.RA_PROCES, SRA.RA_NOMECMP, SRA.RA_ADMISSA, SRA.RA_FECREI, SRA.RA_CIC, SRA.RA_DTREC "
	cQuery += " , SRA.RA_CURP, SRA.RA_SALMES, SRA.RA_RG, SRA.RA_SALINT, SRA.RA_CODFUNC, SRA.RA_SALDIA, SRG.RG_DATADEM "
	cQuery += " FROM ? SRA "
	cQuery += " INNER JOIN ? SRG "
	cQuery += " ON SRA.RA_FILIAL = SRG.RG_FILIAL "
	cQuery += " AND SRA.RA_MAT = SRG.RG_MAT "
	cQuery += " WHERE SRA.RA_FILIAL BETWEEN ? AND ? "
	cQuery += " AND SRA.RA_PROCES BETWEEN ? AND ? "
	cQuery += " AND SRA.RA_MAT BETWEEN ? AND ? "
	cQuery += " AND SRG.RG_DATADEM BETWEEN ? AND ? "
	cQuery += " AND SRG.RG_DTGERAR BETWEEN ? AND ? "
	cQuery += " AND SRA.RA_SITFOLH IN ( ? ) "
	cQuery += " AND SRG.RG_RESCOMP IN ( ? )"
	cQuery += " AND SRA.D_E_L_E_T_= ? "
	cQuery += " AND SRG.D_E_L_E_T_= ? "
	cQuery += " ORDER BY RA_FILIAL, RA_MAT"

	oQryEmp := FwExecStatement():New(cQuery)

	// Define la consulta de los parámetros
	oQryEmp:SetUnsafe(nParQry++	, RetSqlName("SRA"))
	oQryEmp:SetUnsafe(nParQry++	, RetSqlName("SRG"))
	oQryEmp:SetString(nParQry++	, cSucuIni)
	oQryEmp:SetString(nParQry++	, cSucuFin)
	oQryEmp:SetString(nParQry++	, cProcIni)
	oQryEmp:SetString(nParQry++	, cProcFin)
	oQryEmp:SetString(nParQry++	, cMatrIni)
	oQryEmp:SetString(nParQry++	, cMatrFin)
	oQryEmp:SetDate(nParQry++	, dBajaIni)
	oQryEmp:SetDate(nParQry++	, dBajaFin)
	oQryEmp:SetDate(nParQry++	, dGeneIni)
	oQryEmp:SetDate(nParQry++	, dGeneFin)
	oQryEmp:SetIn(nParQry++		, aSituaci)
	oQryEmp:SetIn(nParQry++		, aTipCalc)
	oQryEmp:SetString(nParQry++	, ' ') // SRA.D_E_L_E_T_
	oQryEmp:SetString(nParQry++	, ' ') // SRG.D_E_L_E_T_

	// Ejecuta query y retorna el alias creado
	cAlias := oQryEmp:OpenAlias()
	DbSelectArea(cAlias)
	(cAlias)->(DbGoTop())

	While (cAlias)->(!Eof())

		If !(cSucEmp == (cAlias)->RA_FILIAL)
			cSucEmp := (cAlias)->RA_FILIAL
			aCodFol := {}
			lCodFol := fP_CodFol(@aCodFol, cSucEmp)
			cFilSRJ := FWxFilial("SRJ", cSucEmp)
			aInfoSuc := FWSM0Util():GetSM0Data(cEmpAnt, cSucEmp, aCposSuc)
		EndIf

		If lCodFol
			self:jItems := JsonObject():new()
			For nIteracion := 1 To Len(self:aStruct)
				If (self:aStruct[nIteracion][3] == 'date')
					self:jItems[self:aStruct[nIteracion][1]] := totvs.framework.treports.date.dateToTimeStamp(StoD((cAlias)->&(self:aStruct[nIteracion][5])))
				Else
					self:jItems[self:aStruct[nIteracion][1]] := (cAlias)->&(self:aStruct[nIteracion][5])
				Endif
			Next nIteracion

			If SRJ->(MsSeek(cFilSRJ+(cAlias)->RA_CODFUNC))
				self:jItems["RJ_DESC"] := Alltrim(SRJ->RJ_DESC)
			EndIf

			// Información Empresa
			self:jItems["EMPRNOM"] := aInfoSuc[1][2]
			self:jItems["EMPRCGC"] := aInfoSuc[2][2]
			self:jItems["EMPRDOM"] := aInfoSuc[3][2]
			self:jItems["EMPRBAR"] := aInfoSuc[4][2]
			self:jItems["EMPRCUI"] := aInfoSuc[5][2]

			// Obtiene conceptos de percepciones y deducciones para cada empleado
			ObtMovEmpl(@self:jItems, (cAlias)->RA_FILIAL, (cAlias)->RA_MAT, (cAlias)->RA_PROCES, aRoteir, aCodfol)

			self:oData:appendData(self:jItems)

			//Si no es el último registro indica que habrá una página siguiente
			self:setHasNext(lHasNext)
		EndIf

		(cAlias)->(DbSkip())

	EndDo

	(cAlias)->(DbCloseArea())

	// Limpa os objetos da memória
	FwFreeObj(oQryEmp)

Return (self:oData)

//-------------------------------------------------------------------
/*{Protheus.doc} getSchema

@description Retorna la estructura de los campos
@return object: self:oSchema
@author oscar.lopez
@since 12/02/2026
@version 1.0
*/
//------------------------------------------------------------------- 
Method getSchema() as object class gper1150TReportsBusinessObject

	// Declaracion de las variables
	Local nIteration	As Numeric
	Local aFields		As Array

	// Adiciona las propiedades de los campos que serán retornados para Smart View
	For nIteration := 1 To Len( self:aStruct )
		self:addProperty(self:aStruct[nIteration][1], self:aStruct[nIteration][2], self:aStruct[nIteration][3], self:aStruct[nIteration][4], self:aStruct[nIteration][5])
	Next nIteration

	// Información adicional
	self:addProperty("RJ_DESC"	, fGetTitDsc(1, 'RJ_DESC')	, "string", fGetTitDsc(2, 'RJ_DESC'), "RJ_DESC")	// "Total Percepciones"
	self:addProperty("TOTPERCEP", STR0003					, "number", STR0003					, "TOTPERCEP")	// "Total Percepciones"
	self:addProperty("TOTDEDUCC", STR0004					, "number", STR0004					, "TOTDEDUCC")	// "Total Deducciones"
	self:addProperty("NETOPAGAR", STR0005					, "number", STR0005					, "NETOPAGAR")	// "Neto a Pagar"

	// Información Empresa
	self:addProperty("EMPRNOM"	, STR0006, "string", STR0006, "EMPRNOM")	// "Empresa Nombre"
	self:addProperty("EMPRCGC"	, STR0007, "string", STR0007, "EMPRCGC")	// "Empresa CNPJ o CPF"
	self:addProperty("EMPRDOM"	, STR0008, "string", STR0008, "EMPRDOM")	// "Empresa Domicilio"
	self:addProperty("EMPRBAR"	, STR0009, "string", STR0009, "EMPRBAR")	// "Empresa Barrio"
	self:addProperty("EMPRCUI"	, STR0010, "string", STR0010, "EMPRCUI")	// "Empresa Cuidad"

	//Perdepciones
	aFields := {}
	aAdd(aFields, {"CODCON"	, fGetTitDsc(1, 'RC_PD')		, "string"	, fGetTitDsc(2, 'RC_PD')		})
	aAdd(aFields, {"DESCRI"	, fGetTitDsc(1, 'RV_DESC')		, "string"	, fGetTitDsc(2, 'RV_DESC')		})
	aAdd(aFields, {"DESDET"	, fGetTitDsc(1, 'RV_DESCDET')	, "string"	, fGetTitDsc(2, 'RV_DESCDET')	})
	aAdd(aFields, {"UNIDAD"	, fGetTitDsc(1, 'RC_HORAS')		, "number"	, fGetTitDsc(2, 'RC_HORAS')		})
	aAdd(aFields, {"IMPORT"	, fGetTitDsc(1, 'RC_VALOR')		, "number"	, fGetTitDsc(2, 'RC_VALOR')		})

	self:addNestedProperty("PERCEP", "PERCEP", "PERCEP", , aFields) // Perdepciones
	self:addNestedProperty("DEDUCC", "DEDUCC", "DEDUCC", , aFields) // Deducciones
	self:addNestedProperty("BASEPER", "BASEPER", "BASEPER", , aFields) // Base Perdepciones
	self:addNestedProperty("BASEDED", "BASEDED", "BASEDED", , aFields) // Base Deducciones

	//Define los parámetros del informe
	self:oSchema:addParameter("PAR_FILINI", STR0011, "string"	, .F.)	// "De Filial"
	self:oSchema:addParameter("PAR_FILFIN", STR0012, "string"	, .F.)	// "A Filial"
	self:oSchema:addParameter("PAR_PROINI", STR0013, "string"	, .F.)	// "De Proceso"
	self:oSchema:addParameter("PAR_PROFIN", STR0014, "string"	, .F.)	// "A Proceso"
	self:oSchema:addParameter("PAR_SITUAC", STR0015, "string"	, .T.)	// "Situaciones"
	self:oSchema:addParameter("PAR_MATINI", STR0016, "string"	, .F.)	// "De Matrícula"
	self:oSchema:addParameter("PAR_MATFIN", STR0017, "string"	, .F.)	// "A Matrícula"
	self:oSchema:addParameter("PAR_FBAINI", STR0018, "date"		, .F.)	// "De Fecha Baja"
	self:oSchema:addParameter("PAR_FBAFIN", STR0019, "date"		, .F.)	// "A Fecha Baja"
	self:oSchema:addParameter("PAR_FGEINI", STR0020, "date"		, .F.)	// "De Fecha Generación"
	self:oSchema:addParameter("PAR_FGEFIN", STR0021, "date"		, .F.)	// "A Fecha Generación"
	self:oSchema:addParameter("PAR_TPCALC", STR0022, "string"	, .F.)	// "¿Tipo Cálculo?"
	self:oSchema:addParameter("PAR_TPDOCU", STR0023, "string"	, .F.)	// "¿Tipo Documento?"
	self:oSchema:addParameter("PAR_NOMRES", STR0024, "string"	, .F.)	// "Nombre Resp. RRHH:"
	self:oSchema:addParameter("PAR_APERES", STR0025, "string"	, .F.)	// "Nombre Resp. RRHH:"

	self:setCustomURL("PAR_FILINI", "/api/rh/smartview/v1/options/GPEParams/getBranches"	, 2)
	self:setCustomURL("PAR_FILFIN", "/api/rh/smartview/v1/options/GPEParams/getBranches"	, 2)
	self:setCustomURL("PAR_PROINI", "/api/framework/v1/genericLookupService/smartview/RCJ"	, 2)
	self:setCustomURL("PAR_PROFIN", "/api/framework/v1/genericLookupService/smartview/RCJ"	, 2)
	self:setCustomURL("PAR_SITUAC", "/api/rh/smartview/v1/options/GPEParams/getSX5/31"		, 2)
	self:setCustomURL("PAR_MATINI", "/api/framework/v1/genericLookupService/smartview/SRA"	, 2)
	self:setCustomURL("PAR_MATFIN", "/api/framework/v1/genericLookupService/smartview/SRA"	, 2)
	self:setCustomURL("PAR_TPCALC", "/api/rh/smartview/v1/options/GPER1150/PAR_TPCALC"		, 1)
	self:setCustomURL("PAR_TPDOCU", "/api/rh/smartview/v1/options/GPER1150/PAR_TPDOCU"		, 1)

Return (self:oSchema)

/*/{Protheus.doc} fGetTitDsc
	Retorna título o descripcion del campo proporcionado
	@author oscar.lopez
	@since 12/02/2026
	@version 1.0
	@param nOpc, numero, Numero de opcion
	@param cCampo, string, Nombre de campo en SX3 a consultar
	@return cRet, string, Título o descripción del campo proporcionado
	/*/
Static Function fGetTitDsc(nOpc, cCampo)

	Local cRet := ""

	Default nOpc	:= 0
	Default cCampo	:= ""

	If nOpc == 1 //Título campo
		cRet := FWSX3Util():GetDescription(cCampo)
	Else //Descripción campo
		cRet := FWX3Titulo(cCampo)
	EndIf

Return cRet

/*/{Protheus.doc} nomeStaticFunction
	Obtiene movimientos de percepciones y deducciones de un empleado para cargar en el reporte
	@type  Static Function
	@author oscar.lopez
	@since 12/02/2026
	@version 1.0
	@param param_name, param_type, param_descr
	@param jItems, character, objeto de negocio
	@param cSucEmp, character, Sucursal empleado
	@param cMatEmp, character, Matrícula empleado
	@param cProEmp, character, Proceso empleado
	@param aRoteir, character, Arreglo con procedimiento de Finiquito y Aplicación de Finiquito
	@param aCodfol, character, Codigo de concepto para excluir de deducciones
	@return Nil
	@example
		ObtMovEmpl(@jItems, cSucEmp, cMatEmp, cProEmp, aRoteir, aCodfol)
/*/
Static Function ObtMovEmpl(jItems, cSucEmp, cMatEmp, cProEmp, aRoteir, aCodfol)

	Local aArea		:= GetArea()
	Local oQryMov	:= Nil
	Local nParQry	:= 1
	Local cQuery	:= ""
	Local cFilSRC	:= ""
	Local cFilSRV	:= ""
	Local cAlias	:= ""

	// Variables para agrupar los movimientos
	Local jInfoMov	:= JsonObject():new()
	Local cCodCon	:= ""
	Local cDescri	:= ""
	Local cDesDet	:= ""
	Local nHoras	:= 0
	Local nValor	:= 0
	Local nTotPerc	:= 0
	Local nTotDedu	:= 0
	Local cTipoCon	:= ""

	Default jItems	:= JsonObject():new()
	Default cSucEmp := ""
	Default cMatEmp := ""
	Default cProEmp := ""
	Default aRoteir := {}
	Default aCodFol := {}

	// Se inicializan variables
	cFilSRC	:= FWxFilial("SRC", cSucEmp)
	cFilSRV := FWxFilial("SRV", cSucEmp)
	jInfoMov["PERCEP"] 	:= {}
	jInfoMov["DEDUCC"] 	:= {}
	jInfoMov["BASEPER"]	:= {}
	jInfoMov["BASEDED"]	:= {}

	cQuery := "	SELECT SRC.RC_PD, SRC.RC_TIPO1, SRC.RC_HORAS, SRC.RC_VALOR, SRV.RV_DESC, SRV.RV_DESCDET, SRV.RV_TIPOCOD " 
	cQuery += " FROM ? SRC " 
	cQuery += " INNER JOIN ? SRV "
	cQuery += " ON SRC.RC_PD = SRV.RV_COD "
	cQuery += "	WHERE SRC.RC_FILIAL = ? "
	cQuery += " AND SRC.RC_MAT = ? "
	cQuery += " AND SRC.RC_PROCES = ? "
	cQuery += " AND SRC.RC_ROTEIR IN ( ? ) "
	cQuery += " AND SRC.RC_VALOR > ? "
	cQuery += " AND SRV.RV_FILIAL = ? "
	cQuery += " AND SRC.D_E_L_E_T_ = ? "
	cQuery += " AND SRV.D_E_L_E_T_ = ? "

	oQryMov := FwExecStatement():New(cQuery)

	// Define la consulta de los parámetros
	oQryMov:SetUnsafe(nParQry++	, RetSqlName("SRC"))
	oQryMov:SetUnsafe(nParQry++	, RetSqlName("SRV"))
	oQryMov:SetString(nParQry++	, cFilSRC)
	oQryMov:SetString(nParQry++	, cMatEmp)
	oQryMov:SetString(nParQry++	, cProEmp)
	oQryMov:SetIn(nParQry++		, aRoteir)
	oQryMov:SetNumeric(nParQry++, 0)
	oQryMov:SetString(nParQry++	, cFilSRV)
	oQryMov:SetString(nParQry++	, ' ') // SRC.D_E_L_E_T_
	oQryMov:SetString(nParQry++	, ' ') // SRV.D_E_L_E_T_

	// Ejecuta query y retorna el alias creado
	cAlias := oQryMov:OpenAlias()

	DbSelectArea(cAlias)
	(cAlias)->(DbGoTop())

	While (cAlias)->(!Eof())
		cTipoCon	:= ""
		cCodCon		:= AllTrim((cAlias)->RC_PD)
		cDescri		:= AllTrim((cAlias)->RV_DESC)
		cDesDet		:= AllTrim((cAlias)->RV_DESCDET)
		nHoras		:= (cAlias)->RC_HORAS
		nValor		:= (cAlias)->RC_VALOR		

		//Verifica el tipo de concepto y carga en el arreglo correspondiente
		If (cAlias)->RV_TIPOCOD == "1" // Percepciones
			cTipoCon := "PERCEP"
			nTotPerc += nValor
		ElseIf (cAlias)->RV_TIPOCOD == "2" .And. !((cAlias)->RC_PD == aCodfol[126,1]) // Deducciones
			cTipoCon := "DEDUCC"
			nTotDedu += nValor
		ElseIf (cAlias)->RV_TIPOCOD == "3"
			cTipoCon := "BASEPER"
		ElseIf (cAlias)->RV_TIPOCOD == "4"
			cTipoCon := "BASEDED"
		EndIf

		If !Empty(cTipoCon)
			AAdd(jInfoMov[cTipoCon], {;
				"CODCON": cCodCon,;
				"DESCRI": cDescri,;
				"DESDET": cDesDet,;
				"UNIDAD": nHoras,;
				"IMPORT": nValor;
				})
		EndIf

		(cAlias)->(DbSkip())

	EndDo

	(cAlias)->(DbCloseArea())

	jItems["PERCEP"]	:= jInfoMov["PERCEP"]
	jItems["DEDUCC"]	:= jInfoMov["DEDUCC"]
	jItems["BASEPER"]	:= jInfoMov["BASEPER"]
	jItems["BASEDED"]	:= jInfoMov["BASEDED"]
	jItems["TOTPERCEP"]	:= nTotPerc
	jItems["TOTDEDUCC"]	:= nTotDedu
	jItems["NETOPAGAR"]	:= nTotPerc - nTotDedu

	FwFreeObj(oQryMov)
	FwRestArea(aArea)

Return Nil
