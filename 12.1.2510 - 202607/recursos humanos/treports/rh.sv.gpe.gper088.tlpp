#Include "totvs.framework.treports.integratedprovider.th"
#Include "tlpp-core.th"
#Include "tlpp-rest.th"
#Include "rh.sv.gpe.gper088.ch"

namespace totvs.protheus.rh.treportsintegratedprovider

/*/{Protheus.doc}
    Classe do objeto de negócio da Conferência S-1200
    @type Class
    @version 12.1.2510
    @author caio.kretzer
    @since 08/06/2026
/*/
@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGAGPE", tables="C91, T14, C9K, C9L, C9M, C8R, C9N, C9O, C9P, C9Q, T3A, C9R", name="Conferência S-1200", customTables="C91", country="BRA", initialRelease="12.1.2310")
Class GPER088TReportsBusinessObject From totvs.framework.treports.integratedprovider.IntegratedProvider
    
    // Define os métodos da classe
    Public Method new()       As Object
    Public Method getData()   As Object
    Public Method getSchema() As Object

EndClass


/*/{Protheus.doc} GPER088TReportsBusinessObject:new()
    Instancia a classe do objeto de negócio.
    @type Method
    @version 12.1.2510
    @author caio.kretzer
    @since 08/06/2026
    @return Object, Instância do objeto de negócio
/*/
Method new() As Object Class GPER088TReportsBusinessObject

    // Chama o construtor da classe super
    _Super:new()

    // Define a área
    self:appendArea(STR0001) // "RH"

    // Define o nome e descrição do objeto de negócio
    self:setDisplayName(STR0002) // "Conferência S-1200"
    self:setDescription(STR0003) // "Este objeto de negócio, retorna as informações do evento S-1200 por funcionário para o todo o ano base informado."

Return self

/*/{Protheus.doc} GPER088TReportsBusinessObject:getData()
    Captura os dados do objeto de negócio.
    @type Method
    @version 12.1.2510
    @author caio.kretzer
    @since 08/06/2026
    @return Object, Dados do objeto de negócio
/*/
method getData(nPage as numeric, oFilter as object) as object class GPER088TReportsBusinessObject
    
    Local jParams       As JSON      // Parâmetros
    Local lObfuscated   As Logical
    Local aPDFields     As Array     // Campos que podem ser exibidos de acordo com a LGPD
    Local aAllFields    As Array     // Estrutura de todos os campos do ON
    Local cFiltro       As Character // Filtro do objeto de negócio
    Local aFil          As Array
    Local cInscrDe      As Character
    Local cInscrAte     As Character
    Local cCPFDe        As Character
    Local cCPFAte       As Character
    Local cCompetDe     As Character
    Local cCompetAte    As Character
    Local cCustomFields As Character
    Local cName         As Character // Nome real do campo
    Local nFields       As Numeric
    Local jData         As JSON 
    Local jLGPD         As JSON
    Local cQuery        As Character
    Local oStatement    As Object
    Local cAlias        As Character
    Local lC9K          As Logical
    Local cMatric       As Character
    Local lC9L          As Logical
    Local lC9M          As Logical
    Local cIDTabRubr    As Character
    Local cFilRub       As Character
    Local cCodRubr      As Character
    Local __aRubrica    As Array
    Local __aRubr       As Array
    Local aRubrica      As Array
    Local nPosRubric    As Numeric
    Local nParamOrder   As Numeric
    Local lCodRub       As Logical
    Local lMV           As Logical
    Local lC9NOld       As Logical
    Local lC9N          As Logical
    Local cChvC9N       As Character
    Local lC9O          As Logical
    Local lC9P          As Logical
    Local lC9Q          As Logical
    Local lGeraC9Q      As Logical
    Local lLaySimplif   As Logical
    Local lC9R          As Logical
    Local lGeraC9R      As Logical
    Local cCodVerb      As Character
    Local cDescVerb     As Character

    //Inicialização das variáveis
    lObfuscated := .F.
    cFiltro     := IIf(oFilter:hasFilter(), " AND " + oFilter:getSQLExpression(), "")
    jParams     := oFilter:getParameters()
    jLGPD       := JSONObject():New()
    aPDFields   := {}
    aAllFields  := {}
    aFil        := {}
    cInscrDe    := ""
    cInscrAte   := ""
    cCPFDe      := ""
    cCPFAte     := ""
    cCompetDe   := ""
    cCompetAte  := ""
    cName       := ""
    cCustomFields := ""
    nFields     := 0
    cQuery      := ""
    oStatement  := NIL
    cAlias      := ""
    cMatric     := ""
    lC9K        := .T.
    lC9L        := .T.
    lC9M        := .T.
    cIDTabRubr  := ""
    cFilRub     := ""
    cCodRubr    := ""
    __aRubrica  := {}
    __aRubr     := {}
    aRubrica    := {}
    nPosRubric  := 0
    nParamOrder := 1
    lCodRub     := .F.
    lMV 	    := .F.
    lC9NOld     := .F.
    lC9N        := .T.
    cChvC9N     := ""
    lC9O        := .T.
    lC9P        := .T.
    lC9Q        := .T.
    lGeraC9Q    := .T.
    lLaySimplif := TafLayESoc()
    lC9R        := .T.
    lGeraC9R    := .F.
    cCodVerb    := ""
    cDescVerb   := ""


    // Captura o valor dos parâmetros
    If (jParams != NIL)
        aFil        := jParams["Filial"]
        cInscrDe    := IIf(jParams:hasProperty("CNPJDe")        .and.   Len(jParams["CNPJDe"]) > 0        .and.   !Empty(jParams["CNPJDe"][1]),     jParams["CNPJDe"][1],       "")
        cInscrAte   := IIf(jParams:hasProperty("CNPJAte")       .and.   Len(jParams["CNPJAte"]) > 0       .and.   !Empty(jParams["CNPJAte"][1]),    jParams["CNPJAte"][1],      Replicate("Z", GetSX3Cache("RJE_INSCR", "X3_TAMANHO")))
        cCPFDe      := IIf(jParams:hasProperty("CPFDe")         .and.   Len(jParams["CPFDe"]) > 0         .and.   !Empty(jParams["CPFDe"][1]),      jParams["CPFDe"][1],        "")
        cCPFAte     := IIf(jParams:hasProperty("CPFAte")        .and.   Len(jParams["CPFAte"]) > 0        .and.   !Empty(jParams["CPFAte"][1]),     jParams["CPFAte"][1],       Replicate("Z", GetSX3Cache("RA_CIC", "X3_TAMANHO")))
        cCompetDe   := IIf(jParams:hasProperty("CompetDe")      .and.   Len(jParams["CompetDe"]) > 0      .and.   !Empty(jParams["CompetDe"][1]),   jParams["CompetDe"][1],     "")
        cCompetAte  := IIf(jParams:hasProperty("CompetAte")     .and.   Len(jParams["CompetAte"]) > 0     .and.   !Empty(jParams["CompetAte"][1]),  jParams["CompetAte"][1],    "999999")
    EndIf

    If Len(aFil) == 0
        self:setErrorStatus(400, STR0004, STR0005) // "Filtro obrigatório" | "O filtro de Filial é obrigatório para execução do relatório"
        FwLogMsg("WARN", NIL, "SmartView", NIL, NIL, NIL, STR0005) // "O filtro de Filial é obrigatório para execução do relatório"
        Return self:oData
    EndIf

	// Verifica se precisa fazer o tratamento para LGPD
    aPDFields   := FwProtectedDataUtil():UsrAccessPDField(__cUserID, self:getArrayFields())
    lObfuscated := Len(aPDFields) != Len(self:getArrayFields())
    aAllFields  := self:getStructFields()

    // Adiciona no JSON todos os campos como atributos e com o conteúdo sendo uma flag que indica se o campo deve ser ofuscado
    For nFields := 1 To Len(aAllFields)
        cName        := Trim(aAllFields[nFields]:getName())
        jLGPD[cName] := AScan(aPDFields, {|x| Trim(x) == cName}) <= 0
    Next nFields

    // Montagem da query de busca
    cQuery += "SELECT C91.C91_FILIAL, C91.C91_ID, C91.C91_VERSAO, C91.C91_CPF, C91.C91_PERAPU, C91.C91_MV, C91.C91_TRABAL, C91.C91_ORIEVE "
    cQuery +=     "? " // 1
    cQuery += "FROM "
    cQuery +=     RetSQLName("C91") + " C91 "
    cQuery += "WHERE "
    cQuery +=     "C91.C91_FILIAL       IN (?) " // 2
    cQuery +=     "AND C91.C91_CPF      BETWEEN ? AND ? " // 3 e 4
    cQuery +=     "AND C91.C91_PERAPU   BETWEEN ? AND ? " // 5 e 6
    cQuery +=     "AND C91.C91_INDAPU   = ? " // 7
    cQuery +=     "? "                        // 8
    cQuery +=     "AND C91.D_E_L_E_T_ = ? " // 9
    cQuery := ChangeQuery(cQuery)

    // Instancia a classe
    oStatement := FwExecStatement():New(cQuery)

    // Captura e define os campos personalizados das tabelas SRA e CTT
    cCustomFields := GPESmartViewUtils():GetCustomFields(self:getCustomFields(), {"C91"})
    oStatement:SetUnsafe(nParamOrder++, IIf(!Empty(cCustomFields), "," + cCustomFields, "")) // 1
    // Define o valor dos bind parameters

    oStatement:SetIN(nParamOrder++, aFil) // 2
    oStatement:SetString(nParamOrder++, cCPFDe) // 3
    oStatement:SetString(nParamOrder++, cCPFAte) // 4
    oStatement:SetString(nParamOrder++, cCompetDe) // 5
    oStatement:SetString(nParamOrder++, cCompetAte) // 6

    oStatement:SetString(nParamOrder++, "1") // 7

    oStatement:SetUnsafe(nParamOrder++, cFiltro) // 8
    oStatement:SetString(nParamOrder++, " ") // 9

    // Executa a query e retorna o alias criado
    cAlias := oStatement:OpenAlias()

    // Percorre todos os registros
    While (!(cAlias)->(EOF()))

        If (cAlias)->C91_MV == "1"
			lMV 	:= .T.
		EndIf

        // Posiciona na T14
        T14->(DbSetOrder(1))
        If T14->(MsSeek((cAlias)->(C91_FILIAL + C91_ID + C91_VERSAO)))

            C87->(DbSetOrder(1))
            C9K->(DbSetOrder(1))

            While !T14->(EOF()) .And. AllTrim((cAlias)->(C91_ID+C91_VERSAO)) == AllTrim(T14->(T14_ID+T14_VERSAO))

                C87->(MsSeek(FwxFilial("C87", (cAlias)->C91_FILIAL) + T14->T14_CODCAT))
                cCodCat := C87->C87_CODIGO
                If C9K->(MsSeek(T14->(T14_FILIAL + T14_ID + T14_VERSAO + T14_IDEDMD)))

                    C9L->(DbSetOrder(3))
                    C9V->(DbSetOrder(1))

                    While lC9K
                        C9L->(MsSeek(FwxFilial("C9L", C9K->C9K_FILIAL) + C9K->(C9K_ID + C9K_VERSAO + C9K_RECIBO + C9K_ESTABE + C9K_LOTACA + C9K_CODLOT + C9K_TPINSC + C9K_NRINSC)))
                        
                        lC9L := !C9L->(Eof())

                        If Empty(C9L->C9L_DTRABA)
                            C9V->(MsSeek(FwxFilial("C9V", (cAlias)->C91_FILIAL) + C9L->C9L_TRABAL))
                            
                            cMatric := IIF(!EMPTY( C9V->C9V_MATRIC ), C9V->C9V_MATRIC, C9V->C9V_MATTSV)
                        Else
                            cMatric := C9L->C9L_DTRABA
                        EndIf

                        While lC9L

                            If !Empty(C9L->C9L_ESTABE) .And. !Empty(C9L->C9L_LOTACA)
                                C9M->(DbSetOrder(1))
                                C9M->(MsSeek(FwxFilial("C9M", (cAlias)->C91_FILIAL) + C9L->(C9L_ID + C9L_VERSAO + C9L_RECIBO + C9L_ESTABE + C9L_LOTACA + C9L_TRABAL)))
                            Else
                                C9M->(DbSetOrder(3))
                                C9M->(MsSeek(FwxFilial("C9M", (cAlias)->C91_FILIAL) + C9L->(C9L_ID + C9L_VERSAO + C9L_RECIBO + C9L_CODLOT + C9L_TPINSC + C9L_NRINSC + C9L_DTRABA)))
                            EndIf

                            While lC9M

                                If !Empty(__aRubrica)
                                    nPosRubric := aScan(__aRubrica, {|x| x[3] == C9M->C9M_FILIAL + C9M->C9M_CODRUB})
                                EndIf

                                If nPosRubric > 0

                                    cIDTabRubr	:= __aRubrica[nPosRubric][1]
                                    cCodRubr	:= __aRubrica[nPosRubric][2]
                                    cCodVerb    := __aRubrica[nPosRubric][4]
                                    cDescVerb   := __aRubrica[nPosRubric][5]

                                Else

                                    C8R->(DbSetOrder(5))
                                    C8R->(MsSeek(FwxFilial("C8R", (cAlias)->C91_FILIAL) + C9M->C9M_CODRUB + "1"))

                                    cIDTabRubr := C8R->C8R_IDTBRU
                                    cCodVerb   := C8R->C8R_CODRUB
                                    cDescVerb  := C8R->C8R_DESRUB

                                    If !Empty(C9M->C9M_CODRUB) .And. !Empty(cIDTabRubr)

                                        cFilRub	 := C9M->C9M_FILIAL
                                        cCodRubr := C9M->C9M_CODRUB
                                        
                                        AAdd(__aRubrica, {cIDTabRubr, cCodRubr, cFilRub + cCodRubr, cCodVerb, cDescVerb})

                                    Else

                                        cCodRubr	:= C9M->C9M_RUBRIC
                                        cIDTabRubr	:= C9M->C9M_IDTABR

                                    EndIf

                                EndIf

                                aRubrica := getRubrica(cCodRubr, cIDTabRubr, (cAlias)->C91_PERAPU, lCodRub, (cAlias)->C91_FILIAL, @__aRubr)

                                jData := {;
                                    "origem": "infoPerApur",;
                                    "competencia": AllTrim((cAlias)->C91_PERAPU),;
                                    "perRef": AllTrim((cAlias)->C91_PERAPU),;
                                    "cpf": AllTrim((cAlias)->C91_CPF),;
                                    "matricula": AllTrim(cMatric),;
                                    "nomeFunc": GatMatC91((cAlias)->C91_FILIAL, (cAlias)->C91_ORIEVE, (cAlias)->C91_TRABAL),;
                                    "categoria": AllTrim(cCodCat),;
                                    "identificador": AllTrim(T14->T14_IDEDMD),;
                                    "codVerba": cCodVerb,;
                                    "idRubrica": C9M->C9M_CODRUB,;
                                    "descricao": cDescVerb,;
                                    "tipo": AllTrim(aRubrica[2]),;
                                    "natureza": AllTrim(aRubrica[1]),;
                                    "valor": C9M->C9M_VLRRUB,;
                                    "incidenciaINSS": AllTrim(aRubrica[3]),;
                                    "incidenciaIRRF": AllTrim(aRubrica[4]),;
                                    "incidenciaFGTS": AllTrim(aRubrica[5]);
                                }

                                // Adiciona os campos customizados no JSON
                                GPESmartViewUtils():SetCustomFields(aAllFields, jData, cAlias, aPDFields, lObfuscated)

                                // Adiciona as informações da linha
                                self:oData:appendData(jData)

                                C9M->(DbSkip())

                                If !lMV
                                    lC9M := !C9M->(Eof()) .And. AllTrim(C9L->(C9L_ID+C9L_VERSAO+C9L_RECIBO+C9L_ESTABE+C9L_LOTACA+C9L_TRABAL)) ==;
                                                                AllTrim(C9M->(C9M_ID+C9M_VERSAO+C9M_RECIBO+C9M_ESTABE+C9M_LOTACA+C9M_TRABAL))
                                Else
                                    lC9M := !C9M->(Eof()) .And. AllTrim(C9L->(C9L_ID+C9L_VERSAO+C9L_RECIBO+C9L_DTRABA+C9L_CODLOT+C9L_TPINSC+C9L_NRINSC)) ==;
                                                                AllTrim(C9M->(C9M_ID+C9M_VERSAO+C9M_RECIBO+C9M_DTRABA+C9M_CODLOT+C9M_TPINSC+C9M_NRINSC))
                                EndIf

                            EndDo

                            lC9M := .T.

                            C9L->(DbSkip())
                            lC9L := !C9L->(Eof()) .And. AllTrim(C9K->(C9K_ID+C9K_VERSAO+C9K_RECIBO+C9K_ESTABE+C9K_LOTACA+C9K_TPINSC+C9K_NRINSC+C9K_CODLOT)) ==;
                                                        AllTrim(C9L->(C9L_ID+C9L_VERSAO+C9L_RECIBO+C9L_ESTABE+C9L_LOTACA+C9L_TPINSC+C9L_NRINSC+C9L_CODLOT))
                        EndDo

                        lC9L := .T.
                        C9K->(DbSkip())
                        lC9K := !C9K->(Eof()) .And. AllTrim(C9K->(C9K_ID+C9K_VERSAO+C9K_RECIBO)) == AllTrim(T14->(T14_ID+T14_VERSAO+T14_IDEDMD))

                    EndDo

                    lC9K := .T.

                EndIf

                /*----------------------------------------------------------
                        Inicio da TAG infoPerAnt
                ----------------------------------------------------------*/

                lC9NOld :=  fTaf250Leg(T14->T14_FILIAL, T14->T14_ID, T14->T14_VERSAO, T14->T14_IDEDMD)

                // Posiciona na C9N
                C9N->(DbSetOrder(1))

                If C9N->(MsSeek(FWxFilial("C9N", (cAlias)->C91_FILIAL) + T14->(T14_ID + T14_VERSAO + T14_IDEDMD)))

                    C9V->(DbSetOrder(1))
                    T3A->(DbSetOrder(1))

                    While lC9N

                        C9O->( DbSetOrder( 1 ) ) 
                        If lC9NOld
                            cChvC9N := C9N->(C9N_ID+C9N_VERSAO+C9N_RECIBO+DTOS(C9N_DTACOR)+C9N_TPACOR+C9N_COMPAC)
                        Else 
                            cChvC9N := C9N->(C9N_ID+C9N_VERSAO+C9N_RECIBO+DTOS(C9N_DTACOR)+C9N_TPACOR+C9N_RELACO)
                        EndIf 
                        C9O->( MsSeek( FWxFilial("C9O", (cAlias)->C91_FILIAL)+cChvC9N))
                        While lC9O

                            C9P->( DbSetOrder( 1 ) ) //C9P_FILIAL, C9P_ID, C9P_VERSAO, C9P_RECIBO, C9P_DTACOR, C9P_TPACOR, C9P_COMPAC, C9P_PERREF, C9P_ESTABE, C9P_LOTACA, R_E_C_N_O_, D_E_L_E_T_
                            C9P->( MsSeek( FWxFilial("C9P", (cAlias)->C91_FILIAL)+C9O->(C9O_ID+C9O_VERSAO+C9O_RECIBO+DTOS(C9O_DTACOR)+C9O_TPACOR+C9O_COMPAC+C9O_PERREF)))
                            
                            While lC9P

                                If lMv
                                    C9Q->( DbSetOrder( 3 ) )                     
                                    C9Q->( MsSeek( FWxFilial("C9Q", (cAlias)->C91_FILIAL)+C9P->C9P_ID+C9P->C9P_VERSAO+C9P->C9P_RECIBO+DTOS(C9P->C9P_DTACOR)+C9P->C9P_TPACOR+C9P->C9P_PERREF+C9P->C9P_ESTABE+C9P->C9P_LOTACA+C9P->C9P_CODLOT))
                                Else
                                    C9Q->( DbSetOrder( 1 ) )
                                    C9Q->( MsSeek( FWxFilial("C9Q", (cAlias)->C91_FILIAL)+C9P->C9P_ID+C9P->C9P_VERSAO+C9P->C9P_RECIBO+DTOS(C9P->C9P_DTACOR)+C9P->C9P_TPACOR+Iif(TAFColumnPos("C9Q_COMPAC"), C9P->C9P_COMPAC, "")+C9P->C9P_PERREF+C9P->C9P_ESTABE+C9P->C9P_LOTACA))
                                EndIf

                                While lC9Q

                                    lGeraC9Q := .F.

                                    // Saída contorno para limitação do tamanho de índice do cTree - Orientação FrameWork
                                    If lMV
                                        If C9Q->( C9Q_CODLOT+C9Q_TPINSC+C9Q_NRINSC ) == C9P->( C9P_CODLOT+C9P_TPINSC+C9P_NRINSC )
                                            lGeraC9Q := .T.
                                        EndIf
                                    Else
                                        lGeraC9Q := .T.
                                    EndIf

                                    If lGeraC9Q	

                                        nTipPer	:= 2	// 1=Período Atual; 2=Período Anterior
                            
                                        If Empty(C9Q->C9Q_MATRIC)
                                            If lLaySimplif .And. C9Q->C9Q_NOMEVE == 'S2190'

                                                T3A->(MsSeek(FWxFilial("T3A", (cAlias)->C91_FILIAL) + C9Q->C9Q_TRABAL))

                                                cMatric := T3A->T3A_MATRIC
                                            Else
                                                C9V->(MsSeek(FWxFilial("C9V", (cAlias)->C91_FILIAL) + C9Q->C9Q_TRABAL))

                                                cMatric := IIF(!EMPTY( C9V->C9V_MATRIC ), C9V->C9V_MATRIC, C9V->C9V_MATTSV)
                                            EndIf
                                        Else
                                            cMatric := C9Q->C9Q_MATRIC
                                        EndIf
                                        
                                        C9R->( DbSetOrder( 1 ) ) //C9R_FILIAL, C9R_ID, C9R_VERSAO, C9R_RECIBO, C9R_DTACOR, C9R_TPACOR, C9R_COMPAC, C9R_PERREF, C9R_ESTABE, C9R_LOTACA, C9R_TRABAL, C9R_CODRUB
                                        C9R->( MsSeek( FWxFilial("C9R", (cAlias)->C91_FILIAL)+C9Q->(C9Q_ID+C9Q_VERSAO+C9Q_RECIBO+DTOS(C9Q_DTACOR)+C9Q_TPACOR+Iif(TAFColumnPos("C9Q_COMPAC"), C9Q_COMPAC, C9P->C9P_COMPAC)+C9Q_PERREF+C9Q_ESTABE+C9Q_LOTACA+C9Q_TRABAL)))

                                        While lC9R

                                            lGeraC9R := .F.

                                            // Saída contorno para limitação do tamanho de índice do cTree - Orientação FrameWork
                                            If lMV
                                                If C9R->( C9R_ESTABE + C9R_CODLOT + C9R_TPINSC + C9R_NRINSC + C9R_MATRIC ) == C9Q->( C9Q_ESTABE + C9Q_CODLOT + C9Q_TPINSC + C9Q_NRINSC + C9Q_DTRABA )
                                                    lGeraC9R := .T.
                                                EndIf
                                            Else
                                                lGeraC9R := .T.
                                            EndIf

                                            If lGeraC9R
                                                cCodVerb    := ""
                                                cDescVerb   := ""

                                                If lMV .And. !Empty(C9R->C9R_RUBRIC)
                                                    cCodRubr	:= C9R->C9R_RUBRIC
                                                    cIDTabRubr	:= C9R->C9R_IDTABR
                                                    lCodRub     := .T.

                                                    C8R->(DbSetOrder(5))
                                                    C8R->(MsSeek(FWxFilial("C8R", (cAlias)->C91_FILIAL) + cCodRubr + "1"))

                                                    If !C8R->(Eof()) .And. C8R->C8R_CODRUB == cCodRubr
                                                        cCodVerb   := C8R->C8R_CODRUB
                                                        cDescVerb  := C8R->C8R_DESRUB
                                                    EndIf
                                                Else
                                                    cCodRubr := C9R->C9R_CODRUB
                                                    lCodRub  := .F.
                                                    cFilRub	 := C9R->C9R_FILIAL

                                                    If !Empty(__aRubrica)
                                                        nPosRubric := aScan(__aRubrica, {|x| x[3] == cFilRub + cCodRubr})
                                                    EndIf
                                                    
                                                    If nPosRubric > 0

                                                        cIDTabRubr	:= __aRubrica[nPosRubric][1]
                                                        cCodRubr	:= __aRubrica[nPosRubric][2]
                                                        cCodVerb    := __aRubrica[nPosRubric][4]
                                                        cDescVerb   := __aRubrica[nPosRubric][5]
                                                    Else

                                                        C8R->(DbSetOrder(5))
                                                        C8R->(MsSeek(FWxFilial("C8R", (cAlias)->C91_FILIAL) + cCodRubr + "1"))

                                                        cIDTabRubr 	:= C8R->C8R_IDTBRU
                                                        cCodVerb    := C8R->C8R_CODRUB
                                                        cDescVerb   := C8R->C8R_DESRUB

                                                        AAdd(__aRubrica, {cIDTabRubr, cCodRubr, cFilRub + cCodRubr, cCodVerb, cDescVerb})

                                                    EndIf

                                                EndIf


                                                aRubrica := getRubrica(cCodRubr, cIDTabRubr, (cAlias)->C91_PERAPU, lCodRub, (cAlias)->C91_FILIAL, @__aRubr)

                                                jData := {;
                                                    "origem": "infoPerAnt",;
                                                    "competencia": AllTrim((cAlias)->C91_PERAPU),;
                                                    "perRef": AllTrim(C9R->C9R_PERREF),;
                                                    "cpf": AllTrim((cAlias)->C91_CPF),;
                                                    "matricula": AllTrim(cMatric),;
                                                    "nomeFunc": GatMatC91((cAlias)->C91_FILIAL, (cAlias)->C91_ORIEVE, (cAlias)->C91_TRABAL),;
                                                    "categoria": AllTrim(cCodCat),;
                                                    "identificador": AllTrim(T14->T14_IDEDMD),;
                                                    "codVerba": cCodVerb,;
                                                    "idRubrica": C9M->C9M_CODRUB,;
                                                    "descricao": cDescVerb,;
                                                    "tipo": AllTrim(aRubrica[2]),;
                                                    "natureza": AllTrim(aRubrica[1]),;
                                                    "valor": C9M->C9M_VLRRUB,;
                                                    "incidenciaINSS": AllTrim(aRubrica[3]),;
                                                    "incidenciaIRRF": AllTrim(aRubrica[4]),;
                                                    "incidenciaFGTS": AllTrim(aRubrica[5]);
                                                }

                                                // Adiciona os campos customizados no JSON
                                                GPESmartViewUtils():SetCustomFields(aAllFields, jData, cAlias, aPDFields, lObfuscated)

                                                // Adiciona as informações da linha
                                                self:oData:appendData(jData)

                                            EndIf

                                            C9R->(DbSkip())

                                            If lMV
                                                lC9R := !C9R->(Eof()) .And. AllTrim(C9Q->(C9Q_ID+C9Q_VERSAO+C9Q_RECIBO+DTOS(C9Q_DTACOR)+C9Q_TPACOR+C9Q_PERREF)) ==;
                                                AllTrim(C9R->(C9R_ID+C9R_VERSAO+C9R_RECIBO+DTOS(C9R_DTACOR)+C9R_TPACOR+C9R_PERREF))
                                            Else 
                                                lC9R := !C9R->(Eof()) .And. AllTrim(C9Q->(C9Q_ID+C9Q_VERSAO+C9Q_RECIBO+DTOS(C9Q_DTACOR)+C9Q_TPACOR+C9Q_PERREF+C9Q_ESTABE+C9Q_LOTACA+C9Q_TRABAL)) == AllTrim(C9R->(C9R_ID+C9R_VERSAO+C9R_RECIBO+DTOS(C9R_DTACOR)+C9R_TPACOR+C9R_PERREF+C9R_ESTABE+C9R_LOTACA+C9R_TRABAL))	
                                            EndIf

                                        EndDo

                                        lC9R := .T.

                                    EndIf

                                    C9Q->(DbSkip())

                                    If !lMV
                                        lC9Q := !C9Q->(Eof()) .And. AllTrim(C9P->(C9P_ID+C9P_VERSAO+C9P_RECIBO+DTOS(C9P_DTACOR)+C9P_TPACOR+C9P_PERREF+C9P_ESTABE+C9P_LOTACA)) == AllTrim(C9Q->(C9Q_ID+C9Q_VERSAO+C9Q_RECIBO+DTOS(C9Q_DTACOR)+C9Q_TPACOR+C9Q_PERREF+C9Q_ESTABE+C9Q_LOTACA))
                                    Else
                                        lC9Q := !C9Q->(Eof()) .And. AllTrim(C9P->(C9P_ID+C9P_VERSAO+C9P_RECIBO+DTOS(C9P_DTACOR)+C9P_TPACOR+C9P_PERREF+C9P_ESTABE+C9P_LOTACA+C9P_CODLOT+C9P_TPINSC+C9P_NRINSC)) ==;
                                        AllTrim(C9Q->(C9Q_ID+C9Q_VERSAO+C9Q_RECIBO+DTOS(C9Q_DTACOR)+C9Q_TPACOR+C9Q_PERREF+C9Q_ESTABE+C9Q_LOTACA+C9Q_CODLOT+C9Q_TPINSC+C9Q_NRINSC))
                                    EndIf

                                EndDo

                                lC9Q := .T.

                                C9P->(DbSkip())

                                lC9P := !C9P->(Eof()) .And. AllTrim(C9O->(C9O_ID+C9O_VERSAO+C9O_RECIBO+DTOS(C9O_DTACOR)+C9O_TPACOR+C9O_PERREF)) == AllTrim(C9P->(C9P_ID+C9P_VERSAO+C9P_RECIBO+DTOS(C9P_DTACOR)+C9P_TPACOR+C9P_PERREF))
                            EndDo

                            lC9P := .T.

                            C9O->(DbSkip())

                            lC9O := !C9O->(Eof()) .And.  AllTrim(cChvC9N) == AllTrim(C9O->(C9O_ID+C9O_VERSAO+C9O_RECIBO+DTOS(C9O_DTACOR)+C9O_TPACOR+C9O_COMPAC))
                        EndDo

                        lC9O := .T.
                        C9N->(Dbskip())
                        lC9N := !C9N->(Eof()) .And. AllTrim(T14->(T14_ID+T14_VERSAO+T14_IDEDMD)) == AllTrim(C9N->(C9N_ID+C9N_VERSAO+C9N_RECIBO))
                    EndDo

                    lC9N := .T.

                EndIf
                
                T14->(DbSkip())
            EndDo

        Endif

        // Pula para o próximo registro
        (cAlias)->(DBSkip())
    End

    // Fecha a área da tabela temporária
    (cAlias)->(DBCloseArea())

    // Limpa os objetos da memória
    jData := NIL
    FwFreeObj(jData)
    FwFreeObj(JParams)
    FwFreeObj(jLGPD)
    FwFreeObj(oStatement)
    FwFreeArray(aAllFields)
    FwFreeArray(aPDFields)

return self:oData

Static Function getRubrica( cCodRubr as Character, cIDTabRubr as Character, cPerApu as Character, lMultVinc as Logical, cFil as Character, __aRubr as Array )

	Local aFilMV     as Array
	Local aInfoSM0   as Array
	Local aRubr      as Array
	Local cCNPJRaiz  as Character
	Local cIncCP     as Character
	Local cIncFGTS   as Character
	Local cIncIRRF   as Character
	Local cNatureza  as Character
	Local cTipo      as Character
	Local lCont      as Logical
	Local nPosRubric as Numeric
	Local nRecnoC8R  as Numeric
    Local nTipPer    as Numeric

	Default cIDTabRubr := ""
	Default cPerApu    := ""
	Default lMultVinc  := .F.
	Default cFil       := ""
	Default __aRubr    := {}

	aFilMV     := {}
	aInfoSM0   := {}
	aRubr      := Array(7)
	cCNPJRaiz  := SubStr(SM0->M0_CGC, 1, 8)
	cIncCP     := ""
	cIncFGTS   := ""
	cIncIRRF   := ""
	cNatureza  := ""
	cTipo      := ""
	lCont      := .F.
	nPosRubric := 0
	nRecnoC8R  := 0
	nTipPer    := 1

	If !Empty(__aRubr)
		nPosRubric := aScan(__aRubr, {|r| r[1] + r[2] + r[3] == cCodRubr + cIDTabRubr + cPerApu .And. r[4] == lMultVinc .And. r[5] == nTipPer})
	EndIf

	If nPosRubric > 0

		aRubr := aClone(__aRubr[nPosRubric][6])

	Else

		If lMultVinc

			aInfoSM0     	:= FWLoadSM0(.F.)
			
			aEval( aInfoSM0, { |x| Iif( SubStr( x[18], 1, 8 ) == cCNPJRaiz .and. x[1] == cEmpAnt, aAdd( aFilMV, x[2] ), Nil ) } )
			nRecnoC8R := MVQueryC8R(cCodRubr, cIDTabRubr, cPerApu, aFilMV, nTipPer)

			If nRecnoC8R > 0

				lCont := .T.
				C8R->( DBGoTo( nRecnoC8R ) )

			EndIf

		Else

            C8R->( DBSetOrder( 5 ) )

            If C8R->( MsSeek( FWxFilial( "C8R", cFil ) + cCodRubr  + "1" ) )
                lCont := .T.
            Else 
                C8R->( DBSetOrder( 3 ) )
                If C8R->( MsSeek( FWxFilial( "C8R", cFil ) + PadR( cCodRubr, TamSx3( "C8R_CODRUB" )[1])  + "1" ) )
                    lCont := .T.
                EndIf
            EndIf

		EndIf

		If lCont

			If C89->( MsSeek( FWxFilial( "C89", cFil ) + C8R->C8R_NATRUB ) )
				cNatureza := AllTrim( C89->C89_CODIGO )
			EndIf

			cTipo := AllTrim( C8R->C8R_INDTRB )

			If C8T->( MsSeek( FWxFilial( "C8T", cFil ) + C8R->C8R_CINTPS ) )
				cIncCP := AllTrim( C8T->C8T_CODIGO )
			EndIf

			If C8U->( MsSeek( FWxFilial( "C8U", cFil ) + C8R->C8R_CINTIR ) )
				cIncIRRF := AllTrim( C8U->C8U_CODIGO )
			EndIf

			cIncFGTS := AllTrim( C8R->C8R_CINTFG )

		EndIf

		aRubr[1] := cNatureza
		aRubr[2] := cTipo
		aRubr[3] := cIncCP
		aRubr[4] := cIncIRRF
		aRubr[5] := cIncFGTS

		AAdd(__aRubr, {cCodRubr, cIDTabRubr, cPerApu, lMultVinc, nTipPer, aRubr})
	EndIf

Return aRubr


Static Function GatMatC91(cCodFil as character, cEvent as character, cIdFunc as character)

	Local cRet 			as character

	Default cCodFil 	:= ""
	Default cIdFunc 	:= ""
	Default cEvent 	    := ""

	cRet	:= ""

    If	cEvent == 'S2190'
        cNome := STR0006
        cRet  := cNome
    ElseIf cEvent == 'S2200'
        cNome := Posicione("T1U", 2, FWxFilial("T1U", cCodFil)  + cIdFunc + "1", "T1U_NOME")
        cRet  := cNome
    Else
        cNome := Posicione("T1V", 2, FWxFilial("T1V", cCodFil)  + cIdFunc + "1", "T1V_NOME")
        cRet  := cNome
    EndIf

    If Empty(cNome)
        cNome := Posicione("C9V", 2, FWxFilial("C9V", cCodFil) + cIdFunc + "1", "C9V_NOME")
        cRet  := cNome
    EndIf

Return cRet

Static Function fTaf250Leg(cFil, cId, cVersao, cRecibo)

	Local lC9NOld   := .F.

	Default cFil    := ""
	Default cId     := ""
	Default cVersao := ""
	Default cRecibo := ""

	If TafColumnPos( "C9N_RELACO" )
		C9N->(dbSetOrder(1))
		If C9N->(MsSeek(cFil + cId + cVersao + cRecibo))
			If Empty(AllTrim(C9N->C9N_RELACO))
                lC9NOld	:= .T.
			EndIf 
		EndIf
	Else
		lC9NOld	:= .T.
	EndIf 

Return lC9NOld


/*/{Protheus.doc} GPER088TReportsBusinessObject:getSchema()
    Define o schema do objeto de negócio.
    @type Method
    @version 12.1.2510
    @author caio.kretzer
    @since 08/06/2026
    @return Object, Schema do objeto de negócio
/*/
Method getSchema() As Object Class GPER088TReportsBusinessObject
    
    // Define os parâmetros do relatório
    self:oSchema:addParameter("Filial",         STR0007, "string", .T., NIL, NIL, NIL, NIL, NIL, STR0008) //  "Filial De" - "Informe uma filial para realização do filtro"
    self:oSchema:addParameter("CPFDe",          STR0009, "string", .F., NIL, NIL, NIL, NIL, NIL, STR0010) //  "CPF De" - "Informe um CPF para a realizaçao de filtro."
    self:oSchema:addParameter("CPFAte",         STR0011, "string", .F., NIL, NIL, NIL, NIL, NIL, STR0010) //  "CPF Até" - "Informe um CPF para a realizaçao de filtro."
    self:oSchema:addParameter("CompetDe",       STR0012, "string", .F., NIL, NIL, NIL, NIL, NIL, STR0013) //  "Competência de" - "Informe uma competência para a realização de filtro."
    self:oSchema:addParameter("CompetAte",      STR0014, "string", .F., NIL, NIL, NIL, NIL, NIL, STR0013) //  "Competência até" - "Informe uma competência para a realização de filtro."

    // Adiciona as propriedades do objeto de negócio
    self:oSchema:addProperty("origem",          "origem",       "string", STR0015, "origem",           NIL, NIL, NIL, .F.) // "Origem"
    self:oSchema:addProperty("competencia",     "competencia",  "string", STR0016, "competencia",      NIL, NIL, NIL, .F.) // "Competência"
    self:oSchema:addProperty("perRef",          "perRef",       "string", STR0017, "perRef",           NIL, NIL, NIL, .F.) // "Período de Referência"
    self:oSchema:addProperty("cpf",             "cpf",          "string", STR0018, "cpf",              NIL, NIL, NIL, .F.) // "CPF do Trabalhador"
    self:oSchema:addProperty("matricula",       "matricula",    "string", STR0019, "matricula",        NIL, NIL, NIL, .F.) // "Matrícula"
    self:oSchema:addProperty("nomeFunc",        "nomeFunc",     "string", STR0020, "nomeFunc",         NIL, NIL, NIL, .F.) // "Nome do Trabalhador"
    self:oSchema:addProperty("categoria",       "categoria",    "string", STR0021, "categoria",        NIL, NIL, NIL, .F.) // "Categoria"
    self:oSchema:addProperty("identificador",   "identif",      "string", STR0022, "identificador",    NIL, NIL, NIL, .F.) // "Identificador do Rendimento"
    self:oSchema:addProperty("codVerba",        "codVerba",     "string", STR0023, "codVerba",         NIL, NIL, NIL, .F.) // "Código da Verba"
    self:oSchema:addProperty("idRubrica",       "idRubrica",    "string", STR0024, "idRubrica",        NIL, NIL, NIL, .F.) // "ID da Rubrica"
    self:oSchema:addProperty("descricao",       "descricao",    "string", STR0025, "descricao",        NIL, NIL, NIL, .F.) // "Descrição"
    self:oSchema:addProperty("tipo",            "tipo",         "string", STR0026, "tipo",             NIL, NIL, NIL, .F.) // "Tipo"
    self:oSchema:addProperty("natureza",        "natureza",     "string", STR0027, "natureza",         NIL, NIL, NIL, .F.) // "Natureza"
    self:oSchema:addProperty("valor",           "valor",        "number", STR0028, "valor",            NIL, NIL, NIL, .F.) // "Valor"
    self:oSchema:addProperty("incidenciaINSS",  "incidINSS",    "string", STR0029, "incidenciaINSS",   NIL, NIL, NIL, .F.) // "Incidência INSS"
    self:oSchema:addProperty("incidenciaIRRF",  "incidIRRF",    "string", STR0030, "incidenciaIRRF",   NIL, NIL, NIL, .F.) // "Incidência IRRF"
    self:oSchema:addProperty("incidenciaFGTS",  "incidFGTS",    "string", STR0031, "incidenciaFGTS",   NIL, NIL, NIL, .F.) // "Incidência FGTS"

    self:setCustomURL("Filial", "api/rh/smartview/v1/options/GPEParams/getBranches", 2)

Return self:oSchema

