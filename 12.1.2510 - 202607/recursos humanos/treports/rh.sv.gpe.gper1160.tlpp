#Include 'msobject.ch'
#Include "tlpp-core.th"
#Include "tlpp-rest.th"
#Include 'totvs.framework.treports.integratedprovider.th'
#Include 'rh.sv.gpe.gper1160.ch'

namespace totvs.protheus.rh.treportsintegratedprovider

//-------------------------------------------------------------------------------
/*{Protheus.doc} gper1160TReportsBusinessObject

	@description Clase para la creación del Objeto de Negocio para TReports
	@author oscar.lopez
	@since 15/04/2026
	@version 1.0
*/
//-------------------------------------------------------------------------------
@totvsFrameworkTReportsIntegratedProvider(active=.T., team='SIGAGPE', tables='SRA, SRC, SRV, RCH, SA6', name="Recibo de Pago", country='ARG', initialRelease='12.1.2410', customTables='SRA, SRC, SRV, RCH, SA6')
class gper1160TReportsBusinessObject from totvs.framework.treports.integratedprovider.IntegratedProvider

	Public Method new() as object
	Public Method getData() as object
	Public Method getSchema() as object

	Protected data aFields		as array
	Protected data aStruct		as array
	Protected data jItems		as json

endclass

//-------------------------------------------------------------------
/*{Protheus.doc} new
	Método de instancia de la Clase

	@Return object: self
	@author oscar.lopez
	@since 15/04/2026
	@version 1.0
*/
//-------------------------------------------------------------------
Method new() class gper1160TReportsBusinessObject

	_Super:new()

	//Define o nome do Objeto de Negócio
	self:setDisplayName(STR0001)  // "Recibo de Pago"

	//Define a descrição do Objeto de Negócio
	self:setDescription(STR0001)  // "Recibo de Pago"

	// Define a Área
	self:appendArea(STR0002) // 'Gestión de Personal'

	// Define se as perguntas terao lookup
	self:setIsLookUp(.T.)

	self:aFields := { "RA_MAT"		, "RA_NOME"		, "RA_CIC"		, "RA_ADMISSA"	, "RA_DEMISSA"	, "RA_MODALID", "RA_SALARIO"	, "RA_CARGO"	, "RA_CC"		,;
					  "RA_BCDEPSA"	, "RA_CTDEPSA"	, "RA_DTREC"	, "RA_CODFUNC"	, "RA_CATFUNC"	, "RA_PRINOME", "RA_SECNOME"	, "RA_PRISOBR"	, "RA_SECSOBR"	,;
					  "RA_CFGOSOC"	,"Q3_DESCSUM"	, "A6_COD"		, "A6_AGENCIA"	, "A6_NOME"		, "CTT_DESC01", "RJ_DESC"		}

	self:aStruct := getStrutObj(self:aFields)

Return (self)

//-------------------------------------------------------------------
/*{Protheus.doc} getData
	Retorna los datos del objeto de negocio

	@param nPage, numérico, indica la pagina actual del relatório
	@param oFilter, objeto, contiene el filtro del TReports
	@return object: self:oData
	@author oscar.lopez
	@since 15/04/2026
	@version 1.0
*/
//------------------------------------------------------------------- 
Method getData( nPage as numeric, oFilter as object) as object class gper1160TReportsBusinessObject

	// Declaracion de variables locales
	Local oQryEmp		As Object
	Local jParams		As JSON
	Local nParQry		As Numeric
	Local nIteracion	As Numeric
	Local cAlias		As Character
	Local cQuery		As Character
	Local aCposSuc		As Array
	Local aInfoSuc		As Array
	Local cTabSR		As Character
	Local cAliasSR		As Character
	Local aColImp		As Array
	Local cFilRCH		As Character
	Local cMatTmp		As Character
	Local dFchpago		As Date
	Local cMesPago		As Character
	Local cAnioPago		As Character
	Local cNomCampo		As Character
	Local nPosCampo		As Numeric
	Local cSubStrSQL	As Character
	Local cMensaje01	As Character
	Local cMensaje02	As Character
	Local cMensaje03	As Character
	Local cTipoCont		As Character
	Local nTotConLiq	As Numeric
	Local nTotConPat	As Numeric
	Local nMaxConLiq	As Numeric
	Local nMaxConPat	As Numeric
	Local nPosArrCon	As Numeric
	Local lConcLiqui	As Logical
	Local cColConLiq	As Character
	Local cAgrupTot		As Character
	Local nSumaResta	As Numeric
	Local nValorCon		As Numeric

	// Variables para filtros en query
	Local cSucursal		As Character
	Local cProceso		As Character
	Local cProcedim		As Character
	Local cPeriodo		As Character
	Local cSemana		As Character
	Local cCCosIni		As Character
	Local cCCosFin		As Character
	Local cMatrIni		As Character
	Local cMatrFin		As Character
	Local cSeqMsj01		As Character
	Local cSeqMsj02		As Character
	Local cSeqMsj03		As Character
	Local cTipoPago		As Character
	Local cOrden		As Character
	Local cOrderBy		As Character

	// Parámetros
	jParams		:= oFilter:getParameters()
	cSucursal	:= jParams["PAR_FILIAL"][1]
	cProceso	:= jParams["PAR_PROCES"][1]
	cProcedim	:= jParams["PAR_PROCED"][1]
	cPeriodo	:= jParams["PAR_PERIOD"][1]
	cSemana		:= jParams["PAR_NUMPAG"][1]
	cCCosIni	:= jParams["PAR_CCOINI"][1]
	cCCosFin	:= jParams["PAR_CCOFIN"][1]
	cMatrIni	:= jParams["PAR_MATINI"][1]
	cMatrFin	:= jParams["PAR_MATFIN"][1]
	cSeqMsj01	:= AllTrim(jParams["PAR_MENS01"][1])
	cSeqMsj02	:= AllTrim(jParams["PAR_MENS02"][1])
	cSeqMsj03	:= AllTrim(jParams["PAR_MENS03"][1])
	cTipoPago	:= AllTrim(jParams["PAR_TPPAGO"][1])
	cOrden		:= AllTrim(jParams["PAR_ORDEN"][1])

	// Si no se informa sucursal, se toma la sucursal actual a partir de tabla SRA (completamente exclusiva)
	If Empty(cSucursal)
		cSucursal := FWxFilial("SRA")
	EndIf

	// Inicializacion de las variables
	self:jItems	:= Nil
	cOrderBy	:= " "
	cTabSR		:= "SRC"
	cAliasSR	:= "RC_"
	aColImp		:= {"1", "2", "3", "4"}
	nParQry		:= 1
	cSubStrSQL	:= "SUBSTR"
	If AllTrim(Upper(TCGetDB())) $ "MSSQL"
		cSubStrSQL := "SUBSTRING"
	EndIf
	nPosArrCon	:= 0
	nMaxConLiq	:= 30 // Cantidad máxima de impresión de conceptos de LIQUIDACIÓN en el recibo de pago
	nMaxConPat	:= 13 // Cantidad máxima de impresión de conceptos de CONTRIBUCIÓN PATRONAL en el recibo de pago

	cMensaje01 := fGetMejRCC(cSeqMsj01, "S052", 04, 05)
	cMensaje02 := fGetMejRCC(cSeqMsj02, "S052", 04, 05)
	cMensaje03 := fGetMejRCC(cSeqMsj03, "S052", 04, 05)

	// Se valida si el periodo es un periodo abierto o cerrado
	cFilRCH := FWxFilial("RCH", cSucursal)
	DbSelectArea("RCH")
	RCH->(DbSetOrder(1)) //RCH_FILIAL+RCH_PROCES+RCH_PER+RCH_NUMPAG+RCH_ROTEIR
	If !Empty(cProceso) .And. !Empty(cPeriodo) .And. !Empty(cSemana) .And. !Empty(cProcedim) .And. RCH->(MsSeek(cFilRCH+cProceso+cPeriodo+cSemana+cProcedim))
		If !Empty(RCH->RCH_DTFECH)
			cTabSR := "SRD"
			cAliasSR := "RD_"
		EndIf
		dFchpago	:= RCH->RCH_DTPAGO
		cMesPago	:= RCH->RCH_MES
		cAnioPago	:= RCH->RCH_ANO

		Do Case
			Case cOrden == "1"
				cOrderBy += " SRA.RA_CC, "
			Case cOrden == "2"
				cOrderBy += " SRA.RA_CC, SRA.RA_NOME, "
			Case cOrden == "4"
				cOrderBy += " SRA.RA_NOME, "
		EndCase
		cOrderBy += " SRA.RA_MAT, SRV.RV_TIPOCOD, SRV.RV_COD "

		aCposSuc := { "M0_NOMECOM", "M0_CGC", "M0_ENDENT", "M0_BAIRENT", "M0_CEPENT", "M0_ESTENT" }
		aInfoSuc := FWSM0Util():GetSM0Data(cEmpAnt, cSucursal, aCposSuc)

		cQuery := " SELECT " + cTabSR + "." + cAliasSR + "HORAS HORAS, " + cTabSR + "." + cAliasSR + "VALOR VALOR "
		cQuery += " , SRA.RA_MAT, SRA.RA_NOME, SRA.RA_CIC, SRA.RA_ADMISSA, SRA.RA_DEMISSA, SRA.RA_SALARIO, SRA.RA_CARGO, SRA.RA_CC, SRA.RA_BCDEPSA, SRA.RA_CTDEPSA "
		cQuery += " , SRA.RA_DTREC, SRA.RA_MODALID, SRA.RA_CODFUNC, SRA.RA_CATFUNC, SRA.RA_PRINOME, SRA.RA_SECNOME, SRA.RA_PRISOBR, SRA.RA_SECSOBR, SRA.RA_CFGOSOC "
		cQuery += " , SRV.RV_COD, SRV.RV_COLIMP, SRV.RV_DESC, SRV.RV_DESCDET, SRV.RV_TIPOCOD, SRV.RV_CLASIF, SRV.RV_CODFOL "
		cQuery += " , SQ3.Q3_DESCSUM, SA6.A6_COD, SA6.A6_AGENCIA, SA6.A6_NOME, CTT.CTT_DESC01, SRJ.RJ_DESC "
		cQuery += " FROM ? " + cTabSR
		// Inner Join SRA - Empleados
		cQuery += " INNER JOIN ? SRA "
		cQuery += " ON " + cTabSR + "." + cAliasSR + "FILIAL = SRA.RA_FILIAL "
		cQuery += " AND " + cTabSR + "." + cAliasSR + "MAT = SRA.RA_MAT "
		cQuery += " AND SRA.D_E_L_E_T_ = ? "
		// Inner Join SRV - Conceptos
		cQuery += " INNER JOIN ? SRV "
		cQuery += " ON " + cTabSR + "." + cAliasSR + "PD = SRV.RV_COD "
		cQuery += " AND SRV.RV_FILIAL = ? "
		cQuery += " AND SRV.D_E_L_E_T_ = ? "
		// LeftJoin SQ3 - Cargos
		cQuery += " LEFT JOIN ? SQ3 "
		cQuery += " ON SQ3.Q3_FILIAL = ? "
		cQuery += " AND SQ3.Q3_CARGO = SRA.RA_CARGO "
		cQuery += " AND SQ3.D_E_L_E_T_ = ? "
		// LeftJoin SA6 - Banco
		cQuery += " LEFT JOIN ? SA6 "
		cQuery += " ON SA6.A6_FILIAL = ? "
		cQuery += " AND SA6.A6_COD = " + cSubStrSQL + "(SRA.RA_BCDEPSA,1,3) "
		cQuery += " AND SA6.A6_AGENCIA = " + cSubStrSQL + "(SRA.RA_BCDEPSA,4,5) "
		cQuery += " AND SA6.D_E_L_E_T_ = ? "
		// LeftJoin CTT - Centro de Costo
		cQuery += " LEFT JOIN ? CTT "
		cQuery += " ON CTT.CTT_FILIAL = ? "
		cQuery += " AND CTT.CTT_CUSTO = SRA.RA_CC "
		cQuery += " AND CTT.D_E_L_E_T_ = ? "
		// LeftJoin SRJ - Funciones
		cQuery += " LEFT JOIN ? SRJ "
		cQuery += " ON SRJ.RJ_FILIAL = ? "
		cQuery += " AND SRJ.RJ_FUNCAO = SRA.RA_CODFUNC "
		cQuery += " AND SRJ.D_E_L_E_T_ = ? "
		// Where
		cQuery += " WHERE " + cTabSR + "." + cAliasSR + "FILIAL = ? "
		cQuery += " AND " + cTabSR + "." + cAliasSR + "PROCES = ? "
		cQuery += " AND " + cTabSR + "." + cAliasSR + "ROTEIR = ? "
		cQuery += " AND " + cTabSR + "." + cAliasSR + "PERIODO = ? "
		cQuery += " AND " + cTabSR + "." + cAliasSR + "SEMANA = ? "
		cQuery += " AND " + cTabSR + "." + cAliasSR + "VALOR <> ? "
		cQuery += " AND SRV.RV_COLIMP IN (?) "
		cQuery += " AND SRA.RA_CC BETWEEN ? AND ? "
		cQuery += " AND " + cTabSR + "." + cAliasSR + "MAT BETWEEN ? AND ? "
		cQuery += " AND " + cTabSR + ".D_E_L_E_T_ = ? "
		cQuery += " ORDER BY " + cOrderBy

		oQryEmp := FwExecStatement():New(cQuery)

		// From SRC/RD
		oQryEmp:SetUnsafe(nParQry++	, RetSqlName(cTabSR))

		// Join SRA
		oQryEmp:SetUnsafe(nParQry++	, RetSqlName("SRA"))
		oQryEmp:SetString(nParQry++	, ' ') // SRA.D_E_L_E_T_

		// Join SRV
		oQryEmp:SetUnsafe(nParQry++	, RetSqlName("SRV"))
		oQryEmp:SetString(nParQry++	, FWxFilial("SRV", cSucursal))
		oQryEmp:SetString(nParQry++	, ' ') // SRV.D_E_L_E_T_

		// Left Join SQ3
		oQryEmp:SetUnsafe(nParQry++	, RetSqlName("SQ3"))
		oQryEmp:SetString(nParQry++	, FWxFilial("SQ3", cSucursal))
		oQryEmp:SetString(nParQry++	, ' ') // SQ3.D_E_L_E_T_

		// Left Join SA6
		oQryEmp:SetUnsafe(nParQry++	, RetSqlName("SA6"))
		oQryEmp:SetString(nParQry++	, FWxFilial("SA6", cSucursal))
		oQryEmp:SetString(nParQry++	, ' ') // SA6.D_E_L_E_T_

		// Left Join CTT
		oQryEmp:SetUnsafe(nParQry++	, RetSqlName("CTT"))
		oQryEmp:SetString(nParQry++	, FWxFilial("CTT", cSucursal))
		oQryEmp:SetString(nParQry++	, ' ') // CTT.D_E_L_E_T_

		// Left Join SRJ
		oQryEmp:SetUnsafe(nParQry++	, RetSqlName("SRJ"))
		oQryEmp:SetString(nParQry++	, FWxFilial("SRJ", cSucursal))
		oQryEmp:SetString(nParQry++	, ' ') // SRJ.D_E_L_E_T_

		// Parámetros Where
		oQryEmp:SetString(nParQry++	, cSucursal	)
		oQryEmp:SetString(nParQry++	, cProceso	)
		oQryEmp:SetString(nParQry++	, cProcedim	)
		oQryEmp:SetString(nParQry++	, cPeriodo	)
		oQryEmp:SetString(nParQry++	, cSemana	)
		oQryEmp:setNumeric(nParQry++, 0			)
		oQryEmp:SetIn(nParQry++		, aColImp	)
		oQryEmp:SetString(nParQry++	, cCCosIni	)
		oQryEmp:SetString(nParQry++	, cCCosFin	)
		oQryEmp:SetString(nParQry++	, cMatrIni	)
		oQryEmp:SetString(nParQry++	, cMatrFin	)
		oQryEmp:SetString(nParQry++	, ' '		) // cTabSR.D_E_L_E_T_

		// Ejecuta query y retorna el alias creado
		cAlias := oQryEmp:OpenAlias()
		DbSelectArea(cAlias)
		(cAlias)->(DbGoTop())

		While (cAlias)->(!Eof())
			self:jItems	:= JsonObject():new()
			nTotConLiq	:= 0
			nTotConPat	:= 0
			cMatTmp		:= (cAlias)->RA_MAT

			For nIteracion := 1 To Len(self:aStruct)
				cNomCampo := self:aStruct[nIteracion][5]
				nPosCampo := (cAlias)->(FieldPos(cNomCampo))
				If nPosCampo > 0
					If (self:aStruct[nIteracion][3] == 'date')
						self:jItems[self:aStruct[nIteracion][1]] := totvs.framework.treports.date.dateToTimeStamp(StoD((cAlias)->(FieldGet(nPosCampo))))
					Else
						self:jItems[self:aStruct[nIteracion][1]] := (cAlias)->(FieldGet(nPosCampo))
					EndIf
				EndIf
			Next nIteracion

			// Informacion Periodo
			self:jItems["FCHPAGO"]	:= totvs.framework.treports.date.dateToTimeStamp(dFchpago)
			self:jItems["MESPAGO"]	:= cMesPago
			self:jItems["ANIOPAGO"]	:= cAnioPago

			// Información Empresa
			self:jItems["EMPRNOM"]	:= aInfoSuc[1][2]
			self:jItems["EMPRCGC"]	:= aInfoSuc[2][2]
			self:jItems["EMPRDOM"]	:= aInfoSuc[3][2]
			self:jItems["EMPRBAR"]	:= aInfoSuc[4][2]
			self:jItems["CEPENT"]	:= aInfoSuc[5][2]
			self:jItems["ESTENT"]	:= aInfoSuc[6][2]

			// Informacion adicional
			self:jItems["MENSAJE01"]:= cMensaje01
			self:jItems["MENSAJE02"]:= cMensaje02
			self:jItems["MENSAJE03"]:= cMensaje03
			self:jItems["DSCMODCON"]:= fGetMejRCC((cAlias)->RA_MODALID, "S008", 04, 07)
			self:jItems["DSCCATFUN"]:= FWGetSX5("28", (cAlias)->RA_CATFUNC)[1][4]
			self:jItems["DSCOBRSOC"]:= fGetMejRCC((cAlias)->RA_CFGOSOC, "S002", 04, 07)
			self:jItems["TOTAPORTE"]:= 0
			self:jItems["TOTEXCENT"]:= 0
			self:jItems["TOTDESCUE"]:= 0
			self:jItems["TOTALNETO"]:= 0

			// Objetos anidados
			self:jItems["CONCEPTOS"] := {}
			self:jItems["CONTRPATR"] := {}

			For nIteracion := 1 To nMaxConLiq
				AAdd(self:jItems["CONCEPTOS"], {;
					"CODCON": '',;
					"TIPCOD": '',;
					"DESCRI": '',;
					"DESDET": '',;
					"CODFOL": '',;
					"CLASIF": '',;
					"COLIMP": '',;
					"HORAS": 0,;
					"VALOR": 0,;
					"APORTE": 0,;
					"EXCENT": 0,;
					"DESCUE": 0;
				})
			Next nIteracion

			For nIteracion := 1 To nMaxConPat
				AAdd(self:jItems["CONTRPATR"], {;
					"CODCON": '',;
					"TIPCOD": '',;
					"DESCRI": '',;
					"DESDET": '',;
					"CODFOL": '',;
					"CLASIF": '',;
					"COLIMP": '',;
					"HORAS": 0,;
					"VALOR": 0;
				})
			Next nIteracion

			While (cAlias)->(!Eof()) .And. (cAlias)->RA_MAT == cMatTmp
				If !((cAlias)->RV_COD == "901")
					lConcLiqui := !((cAlias)->RV_COLIMP == "4") // Concepto de Liquidacion si RV_COLIMP es diferente de 4 (.T.), caso contrario es Contribución Patronal (.F.)

					cColConLiq := ""
					nSumaResta := 1

					If lConcLiqui 
						If (cAlias)->RV_COLIMP $ "1|2" .And. (cAlias)->RV_TIPOCOD == "1"
							If !((cAlias)->RV_CLASIF == "N")
								cColConLiq	:= "APORTE"
								cAgrupTot	:= "TOTAPORTE"
							Else
								cColConLiq	:= "EXCENT"
								cAgrupTot	:= "TOTEXCENT"
							EndIf
						ElseIf (cAlias)->RV_COLIMP == "3" .And. (cAlias)->RV_TIPOCOD == "2"
							cColConLiq	:= "DESCUE"
							cAgrupTot	:= "TOTDESCUE"
							nSumaResta	:= -1
						EndIf
					EndIf

					If (lConcLiqui .And. !Empty(cColConLiq) .And. nTotConLiq <= nMaxConLiq) .Or. (!lConcLiqui .And. nTotConPat <= nMaxConPat)
						If lConcLiqui
							nTotConLiq++
							cTipoCont	:= "CONCEPTOS"
							nPosArrCon	:= nTotConLiq
						Else
							nTotConPat++
							cTipoCont	:= "CONTRPATR"
							nPosArrCon	:= nTotConPat
						EndIf

						self:jItems[cTipoCont][nPosArrCon]["CODCON"]:= (cAlias)->RV_COD
						self:jItems[cTipoCont][nPosArrCon]["TIPCOD"]:= (cAlias)->RV_TIPOCOD
						self:jItems[cTipoCont][nPosArrCon]["DESCRI"]:= (cAlias)->RV_DESC
						self:jItems[cTipoCont][nPosArrCon]["DESDET"]:= (cAlias)->RV_DESCDET
						self:jItems[cTipoCont][nPosArrCon]["CODFOL"]:= (cAlias)->RV_CODFOL
						self:jItems[cTipoCont][nPosArrCon]["CLASIF"]:= (cAlias)->RV_CLASIF
						self:jItems[cTipoCont][nPosArrCon]["COLIMP"]:= (cAlias)->RV_COLIMP
						self:jItems[cTipoCont][nPosArrCon]["HORAS"]	:= (cAlias)->HORAS
						self:jItems[cTipoCont][nPosArrCon]["VALOR"]	:= (cAlias)->VALOR

						// Asigna el valor del concepto como aporte, excento o descuento según corresponda
						nValorCon := (cAlias)->VALOR
						If lConcLiqui
							self:jItems[cAgrupTot] += nValorCon
							self:jItems["TOTALNETO"] += (nValorCon * nSumaResta)
							self:jItems[cTipoCont][nPosArrCon][cColConLiq] := nValorCon
						EndIf

					EndIf
				EndIf
				(cAlias)->(DbSkip())
			EndDo

			self:oData:appendData(self:jItems)
		EndDo
		// Si no es el último registro indica que habrá una página siguiente
		self:setHasNext(.F.)
		(cAlias)->(DbCloseArea())
	EndIf
	// Limpa os objetos da memória
	FwFreeObj(oQryEmp)

Return (self:oData)

//-------------------------------------------------------------------
/*{Protheus.doc} getSchema

@description Retorna la estructura de los campos
@return object: self:oSchema
@author oscar.lopez
@since 15/04/2026
@version 1.0
*/
//------------------------------------------------------------------- 
Method getSchema() as object class gper1160TReportsBusinessObject

	// Declaracion de las variables
	Local nIteration	As Numeric
	Local aFields		As Array

	// Adiciona las propiedades de los campos que serán retornados para Smart View
	For nIteration := 1 To Len( self:aStruct )
		self:addProperty(self:aStruct[nIteration][1], self:aStruct[nIteration][2], self:aStruct[nIteration][3], self:aStruct[nIteration][4], self:aStruct[nIteration][5])
	Next nIteration

	//Información Pago
	self:addProperty("FCHPAGO"	, fGetTitDsc(1, 'RCH_DTPAGO')	, "date"	, fGetTitDsc(2, 'RCH_DTPAGO')	, "FCHPAGO")
	self:addProperty("MESPAGO"	, fGetTitDsc(1, 'RCH_MES')		, "string"	, fGetTitDsc(2, 'RCH_MES')		, "MESPAGO")
	self:addProperty("ANIOPAGO"	, fGetTitDsc(1, 'RCH_ANO')		, "string"	, fGetTitDsc(2, 'RCH_ANO')		, "ANIOPAGO")

	// Información Empresa
	self:addProperty("EMPRNOM"	, STR0003, "string", STR0003, "EMPRNOM")	// "Empresa Nombre"
	self:addProperty("EMPRCGC"	, STR0004, "string", STR0004, "EMPRCGC")	// "Empresa CNPJ o CPF"
	self:addProperty("EMPRDOM"	, STR0005, "string", STR0005, "EMPRDOM")	// "Empresa Domicilio"
	self:addProperty("EMPRBAR"	, STR0006, "string", STR0006, "EMPRBAR")	// "Empresa Barrio"
	self:addProperty("CEPENT"	, STR0007, "string", STR0007, "CEPENT")		// "Empresa Entidad"
	self:addProperty("ESTENT"	, STR0008, "string", STR0008, "ESTENT")		// "Empresa Estado"

	//Informacion Adicional
	self:addProperty("MENSAJE01", STR0018, "string", STR0018, "MENSAJE01") // "Mensaje 1"
	self:addProperty("MENSAJE02", STR0019, "string", STR0019, "MENSAJE02") // "Mensaje 2"
	self:addProperty("MENSAJE03", STR0020, "string", STR0020, "MENSAJE03") // "Mensaje 3"
	self:addProperty("DSCMODCON", STR0023, "string", STR0023, "DSCMODCON") // "Desc. Mod. Contrat."
	self:addProperty("DSCCATFUN", STR0024, "string", STR0024, "DSCCATFUN") // "Desc. Cat. Funciones"
	self:addProperty("DSCOBRSOC", STR0025, "string", STR0025, "DSCOBRSOC") // "Desc. Obra Social"
	self:addProperty("TOTAPORTE", STR0026, "number", STR0026, "TOTAPORTE") // "Total Aportes"
	self:addProperty("TOTEXCENT", STR0027, "number", STR0027, "TOTEXCENT") // "Total Excentos"
	self:addProperty("TOTDESCUE", STR0028, "number", STR0028, "TOTDESCUE") // "Total Descuentos"
	self:addProperty("TOTALNETO", STR0029, "number", STR0029, "TOTALNETO") // "Neto a cobrar"

	//Estructura para Conceptos Liquidados y Contribuciones Patronales
	aFields	:= {}

	// Adiciona las propiedades de los campos que serán retornados para Smart View
	aAdd(aFields, {"CODCON"	, fGetTitDsc(1, 'RC_PD')		, "string"	, fGetTitDsc(2, 'RC_PD')		})
	aAdd(aFields, {"TIPCOD"	, fGetTitDsc(1, 'RV_TIPOCOD')	, "string"	, fGetTitDsc(2, 'RV_TIPOCOD')	})
	aAdd(aFields, {"DESCRI"	, fGetTitDsc(1, 'RV_DESC')		, "string"	, fGetTitDsc(2, 'RV_DESC')		})
	aAdd(aFields, {"DESDET"	, fGetTitDsc(1, 'RV_DESCDET')	, "string"	, fGetTitDsc(2, 'RV_DESCDET')	})
	aAdd(aFields, {"CODFOL"	, fGetTitDsc(1, 'RV_CODFOL')	, "string"	, fGetTitDsc(2, 'RV_CODFOL')	})
	aAdd(aFields, {"CLASIF"	, fGetTitDsc(1, 'RV_CLASIF')	, "string"	, fGetTitDsc(2, 'RV_CLASIF')	})
	aAdd(aFields, {"COLIMP"	, fGetTitDsc(1, 'RV_COLIMP')	, "string"	, fGetTitDsc(2, 'RV_COLIMP')	})
	aAdd(aFields, {"HORAS"	, fGetTitDsc(1, 'RC_HORAS')		, "number"	, fGetTitDsc(2, 'RC_HORAS')		})
	aAdd(aFields, {"VALOR"	, fGetTitDsc(1, 'RC_VALOR')		, "number"	, fGetTitDsc(2, 'RC_VALOR')		})

	// Detalle de conceptos para agrupar contribuciones patronales
	self:addNestedProperty("CONTRPATR"	, "CONTRPATR"	, "CONTRPATR", , aFields)

	aAdd(aFields, {"APORTE"	, STR0030	, "number"	, STR0030	}) // "Remun. Aportes"
	aAdd(aFields, {"EXCENT"	, STR0031	, "number"	, STR0031	}) // "Remun. Excentas"
	aAdd(aFields, {"DESCUE"	, STR0032	, "number"	, STR0032	}) // "Descuentos"

	// Detalle de conceptos para agrupar por Conceptos de Liquidación
	self:addNestedProperty("CONCEPTOS"	, "CONCEPTOS"	, "CONCEPTOS", , aFields)

	//Define los parámetros del informe
	self:oSchema:addParameter("PAR_FILIAL"	, STR0009		, "string"	, .F.) // "Sucursal"
	self:oSchema:addParameter("PAR_PROCES"	, STR0010		, "string"	, .F.) // "Proceso"
	self:oSchema:addParameter("PAR_PROCED"	, STR0011		, "string"	, .F.) // "Tipo Proced."
	self:oSchema:addParameter("PAR_PERIOD"	, STR0012		, "string"	, .F.) // "Periodo"
	self:oSchema:addParameter("PAR_NUMPAG"	, STR0013		, "string"	, .F.) // "Num. de Pago"
	self:oSchema:addParameter("PAR_CCOINI"	, STR0014		, "string"	, .F.) // "C. Costo Ini."
	self:oSchema:addParameter("PAR_CCOFIN"	, STR0015		, "string"	, .F.) // "C. Costo Fin."
	self:oSchema:addParameter("PAR_MATINI"	, STR0016 		, "string"	, .F.) // "Matricula Ini."
	self:oSchema:addParameter("PAR_MATFIN"	, STR0017 		, "string"	, .F.) // "Matricula Fin."
	self:oSchema:addParameter("PAR_MENS01"	, STR0018		, "string"	, .F.) // "Mensaje 1"
	self:oSchema:addParameter("PAR_MENS02"	, STR0019		, "string"	, .F.) // "Mensaje 2"
	self:oSchema:addParameter("PAR_MENS03"	, STR0020		, "string"	, .F.) // "Mensaje 3"
	self:oSchema:addParameter("PAR_TPPAGO"	, STR0021		, "string"	, .F.) // "Tipo Pago"
	self:oSchema:addParameter("PAR_ORDEN"	, STR0022		, "string"	, .F.) // "Orden"

	// Consultas para parámetros
	self:setCustomURL("PAR_FILIAL"	, "/api/rh/smartview/v1/options/GPEParams/getBranches"		, 2)
	self:setCustomURL("PAR_PROCES"	, "/api/framework/v1/genericLookupService/smartview/RCJ"	, 2)
	self:setCustomURL("PAR_PROCED"	, "/api/framework/v1/genericLookupService/smartview/SRY"	, 2)
	self:setCustomURL("PAR_PERIOD"	, "/api/framework/v1/genericQuery?tables=RCH&fields=rch_filial,rhc_proces,rch_per,rch_numpag,rch_roteir&Format=smartview&KeyProperty=rch_per"		, 2)
	self:setCustomURL("PAR_NUMPAG"	, "/api/framework/v1/genericQuery?tables=RCH&fields=rch_filial,rhc_proces,rch_per,rch_numpag,rch_roteir&Format=smartview&KeyProperty=rch_numpag"	, 2)
	self:setCustomURL("PAR_CCOINI"	, "/api/framework/v1/genericLookupService/smartview/CTT"	, 2)
	self:setCustomURL("PAR_CCOFIN"	, "/api/framework/v1/genericLookupService/smartview/CTT"	, 2)
	self:setCustomURL("PAR_MATINI"	, "/api/framework/v1/genericLookupService/smartview/SRA"	, 2)
	self:setCustomURL("PAR_MATFIN"	, "/api/framework/v1/genericLookupService/smartview/SRA"	, 2)
	self:setCustomURL("PAR_MENS01"	, "/api/rh/smartview/v1/options/gper1160/Consulta/RCC"		, 2)
	self:setCustomURL("PAR_MENS02"	, "/api/rh/smartview/v1/options/gper1160/Consulta/RCC"		, 2)
	self:setCustomURL("PAR_MENS03"	, "/api/rh/smartview/v1/options/gper1160/Consulta/RCC"		, 2)
	self:setCustomURL("PAR_TPPAGO"	, "/api/rh/smartview/v1/options/gper1160/PAR_TPPAGO"		, 1)
	self:setCustomURL("PAR_ORDEN"	, "/api/rh/smartview/v1/options/gper1160/PAR_ORDEN"			, 1)

Return (self:oSchema)

/*/{Protheus.doc} fGetTitDsc
	Retorna título o descripcion del campo proporcionado
	@author oscar.lopez
	@since 15/04/2026
	@version 1.0
	@param nOpc, numero, Numero de opcion
	@param cCampo, string, Nombre de campo en SX3 a consultar
	@return cRet, string, Título o descripción del campo proporcionado
	/*/
Static Function fGetTitDsc(nOpc, cCampo)

	Local cRet := ""

	Default nOpc	:= 0
	Default cCampo	:= ""

	If nOpc == 1 //Título campo
		cRet := FWSX3Util():GetDescription(cCampo)
	Else //Descripción campo
		cRet := FWX3Titulo(cCampo)
	EndIf

Return cRet

/*/{Protheus.doc} fGetMejRCC
	Obtiene mensaje de tabla alfanumérica
	@type  Function
	@author oscar.lopez
	@since 15/04/2026
	@version 1.0
	@param cSeqMsj, caracter, Contenido a buscar en tabla alfanumerica
	@param cTabAlfa, caracter, Tabla alfanumérica a ser consultada
	@param cColPesq, caracter, Columna de la tabla alfanumérica donde se realizará la búsqueda
	@param cColRet, caracter, Columna de la tabla alfanumérica de donde se retornará el resultado
	@return cRet, caracter, Mensaje correspondiente a la secuencia ingresada
	@example
		cMensaje := fGetMejRCC(cSeqMsj, cTabAlfa, cColPesq, cColRet)
	/*/
Function fGetMejRCC(cSeqMsj, cTabAlfa, cColPesq, cColRet)

	Local cRet := ""
	Local nPos := 0

	Default cSeqMsj := ""

	If !Empty(cSeqMsj)
		nPos := fPosTab(cTabAlfa, cSeqMsj , "==", cColPesq)
		If nPos > 0
			cRet := AllTrim(fTabela(cTabAlfa, nPos, cColRet))
		EndIf
	EndIf

Return cRet
