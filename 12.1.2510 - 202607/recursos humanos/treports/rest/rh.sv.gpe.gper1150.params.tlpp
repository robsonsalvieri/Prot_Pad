#Include "TLPP-CORE.TH"
#Include "TLPP-REST.TH"
#Include "TOTVS.CH"
#Include 'rh.sv.gpe.gper1150.params.ch'

/*/{Protheus.doc} GPER1150Params
    Define los parametros s de tipo ComboBox del informe
    Carta Finiquito / Renuncia (GPER1150) de Smart View.
    @type Class
    @version 1.0
    @author oscar.lopez
    @since 12/02/2026
/*/
Class GPER1150Params
    // Declaracion de metodos publicos
    Public Method new() As Object

    @Get("/api/rh/smartview/v1/options/GPER1150/:param")
    Public Method getComboBox() As Variant

EndClass

/*/{Protheus.doc} GPER1150Params::new
    Metodo constructor de la clase
    @type Method
    @version 1.0
    @author oscar.lopez
    @since 12/02/2026
    @return Object, Instancia de clase
/*/
Method new() Class GPER1150Params As Object
Return self

/*/{Protheus.doc} GPER1150Params::getComboBox
    Retorna los valores del ComboBox del parametro solicitado.
    @type Method
    @version 1.0
    @author oscar.lopez
    @since 12/02/2026
    @return Variant, Retorna null por defecto 
    @obs Path parameters: param (nombre del parametro solicitado)
/*/
Method getComboBox() As Variant Class GPER1150Params
	// Declaracion de variables locales
	Local jPath		As JSON			// Path parametero solicitado
	Local jResponse	As JSON			// Respuesta de la solicitud
	Local jItem		As JSON			// Item con el valor del parametro
	Local nValues	As Numeric		// Contador de valores del parametro
	Local cParam	As Character	// Parametro solicitado
	Local aValues	As Array		// Valores del parametro

	// Inicializacion de las variables
	jPath		:= oRest:getPathParamsRequest()
	jResponse	:= JSONObject():New()
	jItem		:= NIL
	nValues		:= 0
	cParam		:= ""
	aValues		:= {}

    // Captura del patch los parametross de la solicitud
	If (jPath != NIL)
		cParam := jPath["param"]
	EndIf

	// Crea el atributo y dato del JSON de respuesta
	jResponse["data"]        := {}
	jResponse["nextPageUrl"] := NIL

	// Verifica cual parametro fue solicitado y define las opciones correspondientes
	If cParam == "PAR_TPCALC"
		AAdd(aValues, STR0001) // "Normal"
		AAdd(aValues, STR0002) // "Complementaria"
		AAdd(aValues, STR0003) // "Ambas"
	ElseIf cParam == "PAR_TPDOCU"
		AAdd(aValues, STR0004) // "Carta Finiquito"
		AAdd(aValues, STR0005) // "Documento Renuncia"
		AAdd(aValues, STR0006) // "Ambos"
	EndIf

	If (Len(aValues) > 0)
		// Recorre los calores adicionando cada item al JSON de respuesta
		For nValues := 1 To Len(aValues)
			jItem := {;
				"key":   CValToChar(nValues),;
				"label": aValues[nValues];
			}
			AAdd(jResponse["data"], jItem)
		Next nValues
	EndIf

	// Define la respuesta de la solicitud
	oRest:setResponse(jResponse)
	oRest:setStatusCode(200)
	oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")
	oRest:setKeyHeaderResponse("Accept-Encoding", "UTF-8")

	// Libera los objetos de la memoria
	FwFreeObj(jPath)
	FwFreeObj(jResponse)
	FwFreeObj(jItem)
	FwFreeArray(aValues)

Return NIL
