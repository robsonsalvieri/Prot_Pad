#Include "TLPP-CORE.TH"
#Include "TLPP-REST.TH"
#Include "TOTVS.CH"
#Include 'rh.sv.gpe.gper1160.params.ch'

/*/{Protheus.doc} gper1160Params
	Define los parametros de tipo ComboBox del informe
	Recibo de Pago (gper1160) de Smart View.
	@type Class
	@version 1.0
	@author oscar.lopez
	@since 14/04/2026
/*/
Class gper1160Params
    // Declaracion de metodos publicos
    Public Method new() As Object

    @Get("/api/rh/smartview/v1/options/gper1160/:param")
	Public Method getComboBox() As Variant

	@Get("/api/rh/smartview/v1/options/gper1160/Consulta/RCC")
	Public Method getRCCMsj() As Variant

EndClass

/*/{Protheus.doc} gper1160Params::new
	Metodo constructor de la clase
	@type Method
	@version 1.0
	@author oscar.lopez
	@since 14/04/2026
	@return Object, Instancia de clase
/*/
Method new() Class gper1160Params As Object
Return self

/*/{Protheus.doc} gper1160Params::getComboBox
    Retorna los valores del ComboBox del parametro solicitado.
    @type Method
    @version 1.0
    @author oscar.lopez
    @since 14/04/2026
    @return Variant, Retorna null por defecto 
    @obs Path parameters: param (nombre del parametro solicitado)
/*/
Method getComboBox() As Variant Class gper1160Params

	// Declaracion de variables locales
	Local jPath		As JSON			// Path parametero solicitado
	Local jResponse	As JSON			// Respuesta de la solicitud
	Local jItem		As JSON			// Item con el valor del parametro
	Local nValues	As Numeric		// Contador de valores del parametro
	Local cParam	As Character	// Parametro solicitado
	Local aValues	As Array		// Valores del parametro

	// Inicializacion de las variables
	jPath		:= oRest:getPathParamsRequest()
	jResponse	:= JSONObject():New()
	jItem		:= NIL
	nValues		:= 0
	cParam		:= ""
	aValues		:= {}

    // Captura del patch los parametross de la solicitud
	If (jPath != NIL)
		cParam := jPath["param"]
	EndIf

	// Crea el atributo y dato del JSON de respuesta
	jResponse["data"]			:= {}
	jResponse["nextPageUrl"]	:= NIL

	// Verifica cual parametro fue solicitado y define las opciones correspondientes
	If cParam == "PAR_ORDEN"
		AAdd(aValues, STR0001) // "C. Costo + Mat"
		AAdd(aValues, STR0002) // "C. Costo + Nombre"
		AAdd(aValues, STR0003) // "Mat"
		AAdd(aValues, STR0004) // "Nombre"
	ElseIf cParam == "PAR_TPPAGO"
		AAdd(aValues, STR0005) // "Mensual"
		AAdd(aValues, STR0006) // "SAC"
		AAdd(aValues, STR0007) // "Vacaciones"
		AAdd(aValues, STR0008) // "Bonos/Anticipos"
		AAdd(aValues, STR0009) // "Liq Final"
	EndIf

	If (Len(aValues) > 0)
		// Recorre los calores adicionando cada item al JSON de respuesta
		For nValues := 1 To Len(aValues)
			jItem := {;
				"key":   CValToChar(nValues),;
				"label": aValues[nValues];
			}
			AAdd(jResponse["data"], jItem)
		Next nValues
	EndIf

	// Define la respuesta de la solicitud
	oRest:setResponse(jResponse)
	oRest:setStatusCode(200)
	oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")
	oRest:setKeyHeaderResponse("Accept-Encoding", "UTF-8")

	// Libera los objetos de la memoria
	FwFreeObj(jPath)
	FwFreeObj(jResponse)
	FwFreeObj(jItem)
	FwFreeArray(aValues)

Return NIL

/*/{Protheus.doc} gper1160Params::getS052
    Lookup para a tabela S052.
    @type Method
    @version 12.1.2410
    @author oscar.lopez
    @since 15/04/2026
    @return Variant, Retorno nulo
/*/
Method getRCCMsj() As Variant Class gper1160Params
	// Declaración de variables locales
	Local jQueryParams	As JSON
	Local jResponse		As JSON
	Local jItem			As JSON
	Local nPage			As Numeric
	Local nPageSize		As Numeric
	Local nCount		As Numeric
	Local nTotal		As Numeric
	Local nItem			As Numeric
	Local nStart		As Numeric
	Local aTabRCC		As Array

	// Inicialización de variables
	jQueryParams:= oRest:getQueryRequest()
	jResponse	:= JSONObject():New()
	jItem		:= NIL
	nPage		:= 1
	nPageSize	:= 100
	nCount		:= 1
	nTotal		:= 0
	nItem		:= 0
	nStart		:= 1
	aTabRCC		:= {}

	// Captura parámetros de consulta para paginación
	If (jQueryParams != NIL)
		If jQueryParams:hasProperty("page") .And. Val(jQueryParams["page"]) > 0
			nPage := Val(jQueryParams["page"])
		EndIf

		If jQueryParams:hasProperty("pageSize") .And. Val(jQueryParams["pageSize"]) > 0
			nPageSize := Val(jQueryParams["pageSize"])
		EndIf
	EndIf

	// Crea atributos JSON de respuesta
	jResponse["data"]				:= {}
	jResponse["nextPageUrl"]		:= NIL
	jResponse["remainingRecords"]	:= 0
	jResponse["keyProperty"]		:= "CODIGO"
	jResponse["descriptor"]			:= {;
		"CODIGO": FwHttpEncode(STR0010),;
		"MENSAJE": FwHttpEncode(STR0011);
	}

	// Carga información de tabla alfanumérica S052
	fCarrTab(@aTabRCC, "S052")

	// Pula os registros da(s) página(s) anterior(es)
	nStart := (nPage - 1) * nPageSize
	If nPage <= 1
		nStart := 1
	EndIf

	nTotal	:= Len(aTabRCC)
	nItem	:= nStart

	// Recorre los items de la tabla y los añade al objeto JSON
	While (nItem <= nTotal .and. nCount <= nPageSize)
		jItem := {;
			"CODIGO": FwHttpEncode(AllTrim(aTabRCC[nItem][5])),;
			"MENSAJE": FwHttpEncode(AllTrim(aTabRCC[nItem][6]));
		}
		AAdd(jResponse["data"], jItem)

		// Incrementa contadores
		nCount++
		nItem++
	EndDo

	// Define la cantidad de registros restantes en la URL de la próxima pagina
	jResponse["remainingRecords"] := IIf(nItem > nPageSize .and. nItem < nTotal, nTotal - (nPage * nPageSize), 0)
	jResponse["nextPageUrl"]      := IIf(nItem > nPageSize .and. nItem < nTotal, oRest:getFullURLRequest() + "?page=" + CValToChar(nPage + 1) + IIf(jQueryParams:hasProperty("pageSize"), "&pageSize=" + CValToChar(nPageSize), ""), NIL)

	// Define respuesta
	oRest:setResponse(jResponse)
	oRest:setStatusCode(200)
	oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")
	oRest:setKeyHeaderResponse("Accept-Encoding", "UTF-8")

	// Libera los objetos
	FwFreeObj(jQueryParams)
	FwFreeObj(jResponse)
	FwFreeObj(jItem)

Return NIL
