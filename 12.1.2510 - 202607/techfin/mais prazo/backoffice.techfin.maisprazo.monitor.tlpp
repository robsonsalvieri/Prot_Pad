#include "tlpp-core.th"
#include "totvs.ch"
#include "fwmvcdef.ch"
#include "backoffice.techfin.maisprazo.monitor.ch"

namespace totvs.protheus.backoffice.techfin.maisprazo.monitor
using namespace totvs.protheus.backoffice.techfin.util
using namespace totvs.protheus.backoffice.techfin.smartlink.maisprazopaymentslipcancellationrequestv1

/*/{Protheus.doc} Monitor
    Monitor dos titulos que foram prorrogados com o Mais prazo
    @type Function
    @author Squad Techfin
    @since 24/09/2025
    @version 1.0
/*/
Function extensionMonitor() as Object
    Local oBrowse as Object

    If IsActive("2", .T.)
        oBrowse := FWLoadBrw("totvs.protheus.backoffice.techfin.maisprazo.monitor.extensionMonitor") 
    EndIf

Return oBrowse

/*/{Protheus.doc} BrowseDef
    Definição do browse
    @type  Function
    @author Squad Techfin
    @since 24/09/2025
    @version 1.0
    @return oBrowse, Object, Objeto que referencia a browse que será criada
/*/
Function BrowseDef() as object
    local oBrowse := FWmBrowse():New()  as object

    oBrowse:SetAlias("ARG")
    oBrowse:SetMainProc("extensionMonitor")
    oBrowse:SetDescription(STR0001)//"Consultar prorrogações"
    oBrowse:SetMenuDef("totvs.protheus.backoffice.techfin.maisprazo.monitor.extensionMonitor")
    oBrowse:AddLegend("ARG_STATUS == '1'", "YELLOW", STR0024) //"Aguardando aprovação"
    oBrowse:AddLegend("ARG_STATUS == '2'", "WHITE" , STR0002) //"Em processamento"
    oBrowse:AddLegend("ARG_STATUS == '3'", "BLUE"  , STR0003) //"Agendado"
    oBrowse:AddLegend("ARG_STATUS == '4'", "GREEN" , STR0004) //"Finalizado"
    oBrowse:AddLegend("ARG_STATUS == '5'", "RED"   , STR0005) //"Rejeitado"
    oBrowse:AddLegend("ARG_STATUS == '6'", "ORANGE", STR0030) //"Aguardando aprovação cancelamento"
    oBrowse:AddLegend("ARG_STATUS == '7'", "GRAY"  , STR0031) //"Cancelado"
    oBrowse:Activate()

Return oBrowse

/*/{Protheus.doc} MenuDef
    Definição do menu da aplicação
    @type  Function
    @author Squad Techfin
    @since 05/09/2025
    @version 1.0
    @return aRotina, Array, Array com as opções de menu
/*/
Function MenuDef() as Array
    Local aRotina := {} as Array

    ADD OPTION aRotina Title STR0006 Action "VIEWDEF.totvs.protheus.backoffice.techfin.maisprazo.monitor.extensionMonitor" OPERATION MODEL_OPERATION_VIEW   ACCESS 0//"Visualizar"
    ADD OPTION aRotina Title STR0042 Action "totvs.protheus.backoffice.techfin.maisprazo.monitor.cancellation"             OPERATION MODEL_OPERATION_DELETE ACCESS 0//"Cancelar"

Return aRotina


/*/{Protheus.doc} ModelDef
    Definição do modelo de dados da aplicação
    @type  Function
    @author Squad Techfin
    @since 05/09/2025
    @version 1.0
    @return oModel, Object, Objeto de modelo de dados MPFormModel
/*/
Function ModelDef() as Object
    Local bStatus                               as Codeblock
    Local oModel                                as Object 
    Local oStruARG  := FWFormStruct( 1, 'ARG')  as Object
    Local oStruARH  := FWFormStruct( 1, 'ARH')  as Object
    Local oEvent    := extensionMonitor():New() as Object

    // Status da grid de titulos
    bStatus := {||setStatusPayment(ARH->ARH_STATUS)}
    oStruARH:AddField("Status", "Status", "CPO_STS", "C", 15,,,,,.F., bStatus,,.T.) 
    
    oModel := MPFormModel():New('extensionMonitor')    
    oModel:AddFields('ARGMASTER', /*cOwner*/, oStruARG)
    oModel:SetPrimaryKey({"ARG_NUM"})

    oModel:AddGrid('ARHDETAIL', 'ARGMASTER', oStruARH)    
    oModel:SetRelation('ARHDETAIL', {{'ARH_FILIAL', 'xFilial( "ARH" )'}, {'ARH_NUM', 'ARG_NUM'}}, ARH->(IndexKey( 1 )))    
    
    oModel:SetDescription(STR0007) //"Solicitação de Prorrogação"
    oModel:GetModel('ARGMASTER'):SetDescription(STR0008) //"Dados da Solicitação"
    oModel:GetModel('ARHDETAIL'):SetDescription(STR0009) //"Títulos da Solicitação"

    oModel:InstallEvent("extensionMonitor", /*cOwner*/, oEvent)

Return oModel

/*/{Protheus.doc} ViewDef
    Definição da View
    @type  Function
    @author Squad Techfin
    @since 05/09/2025
    @version 1.0
    @return oView, Object, Objeto que referencia a view que será criada
/*/
Function ViewDef() as Object
    Local oModel                                as Object
    Local oView := FWFormView():New()           as Object
    Local oStruARG := FWFormStruct( 2, "ARG")   as Object
    Local oStruARH := FWFormStruct( 2, "ARH")   as Object

    oModel := FWLoadModel("totvs.protheus.backoffice.techfin.maisprazo.monitor.extensionMonitor")

    oStruARG:RemoveField("ARG_FORPGO")
    oStruARG:RemoveField("ARG_QTDTIT")
    oStruARG:RemoveField("ARG_DTAAGE")
    oStruARG:RemoveField("ARG_VLTOT")
    oStruARG:RemoveField("ARG_CDTRAN")
    oStruARG:RemoveField("ARG_FNCOND")
    oStruARG:RemoveField("ARG_VLSOL")

    oStruARH:RemoveField("ARH_IDDOC")
    oStruARH:RemoveField("ARH_REASON")
    oStruARH:RemoveField("ARH_NUM")
    
    oStruARH:AddField('CPO_STS' ,'01','','',Nil,'GET','@BMP',Nil,Nil,.F.,Nil,Nil,Nil,Nil,Nil,.T.)    

    oView:SetModel( oModel )
    
    oView:AddField( 'VIEW_ARG', oStruARG, 'ARGMASTER' )
    oView:AddGrid(  'VIEW_ARH', oStruARH, 'ARHDETAIL' )
    oView:SetViewProperty("ARHDETAIL", "GRIDDOUBLECLICK", {{|| viewStatus()}})

    oView:addUserButton(STR0010, "", {|oView| downloadProofTransaction()},,, {MODEL_OPERATION_VIEW}, .T.) //"Comprovante da solicitação"
    oView:addUserButton(STR0011, "", {|oView| downloadSlips()},,, {MODEL_OPERATION_VIEW}, .T.) //"Baixar boletos em lote"

    oView:CreateHorizontalBox( 'SUPERIOR', 25 )
    oView:CreateHorizontalBox( 'MEIO'    , 10 )
    oView:CreateHorizontalBox( 'INFERIOR', 65 )
    oView:SetOwnerView( 'VIEW_ARG', 'SUPERIOR' )
    oView:SetOwnerView( 'VIEW_ARH', 'INFERIOR' )
    
    oView:AddOtherObject("bHelp", { |oPanel| TSay():New(2,5,{|| STR0028 }, oPanel,,,,,,.T.) }) //"*Vlr. juros, Vlr. IOF e Vlr.Operacao considerando o valor aprovado"
    oView:SetOwnerView("bHelp", 'MEIO')

    oView:SetViewProperty( 'VIEW_ARH', "GRIDSEEK" )
    
    oView:ShowUpdateMsg(.F.)
    oView:SetCloseOnOk( {|| .T. } )

Return oView

/*/{Protheus.doc} SetStatusPayment
    Configura a legenda que será apresentada na view de acordo com o status
    @type  Function
    @author Squad Techfin
    @since 30/09/2025
    @version 1.0
    @param cStatus, Character, Status que será considerado (ARH_STATUS)
    @return cColor, Character, Cor que será apresentada na coluna de legenda
/*/
Function SetStatusPayment(cStatus as character) as character
    local cColor := "BR_AMARELO"  as character

    Do Case
        Case cStatus == "1"
            cColor := "BR_VERDE"
        Case cStatus == "2"
            cColor := "BR_VERMELHO"
        Case cStatus == "4"
            cColor := "BR_AZUL"
    EndCase

Return cColor

/*/{Protheus.doc} viewStatus
    Ação do duplo click da grid, apresenta detalhes do título
    @type  Function
    @author Squad Techfin
    @since 29/09/2025
    @version 1.0
    @return lRet, Logical, Retorna .T. após exibir os detalhes do título
/*/
Static Function viewStatus() as logical
    Local cReason := ""             as character
    Local cNumberTit := ""          as character
    Local cStatus := ""             as character
    Local cStatusDescription := ""  as character
    Local oModel                    as object
    Local oModal                    as object

    oModel	   := FWModelActive()
    cReason    := oModel:GetValue("ARHDETAIL", "ARH_REASON")
    cStatus    := oModel:GetValue("ARHDETAIL", "ARH_STATUS")
    cNumberTit := oModel:GetValue("ARHDETAIL", "ARH_NUMTIT")
    
    cStatusDescription := STR0014 //"! Em processamento"

    If cStatus == "1"
        cStatusDescription := STR0015 //"! Título pago"
    ElseIf cStatus == "2"
        cStatusDescription := STR0016 //"! Título não pago"
    ElseIf cStatus == "4"
        cStatusDescription := STR0017 //"! Agendado"
    Endif

    oModal := TechfinDialog():new()
    oModal:setTitle(STR0018) //"Detalhes do titulo"
    oModal:setText(10, 10, STR0019 + cNumberTit + "  " + cStatusDescription) //"Situação do Título "

    If !Empty(cReason)
        oModal:setText(20, 10, "<b>"+STR0020+"</b>" + CRLF + cReason) //Motivo da rejeição:
    Endif

    If cStatus == "1"
        oModal:setButton(STR0021, {|| downloadProofPayment(oModel), oModal:DeActivate() }) //"Baixar comprovante do pagamento"
        oModal:setButton(STR0022, {|| oModal:DeActivate() }) //"Fechar"
    Else
        oModal:setButton(STR0023, {|| oModal:DeActivate() }) //"Ok, entendi"
    Endif

    oModal:openInfo(100, 200)
    
Return .T.

/*/{Protheus.doc} prepareMessage
    Formata a mensagem que será enviada para a TECHFIN SMARTLINK.
    Para o correto funcionamento as tabelas ARG e ARH devem estar posicionadas.
    @type  Function
    @author Squad Techfin
    @since 25/09/2025
    @version 1.0
    @param oModel, Object, Objeto de modelo de dados contendo as informações da solicitação
    @return cJson, Character, String JSON com os dados da mensagem formatada
/*/
Function PrepareMessage(oModel as object) as character
    local jData               := JsonObject():new()           as json
    local jPaymentSlips       := JsonObject():new()           as json
    local nY                  := 0                            as numeric
    local nX                  := 0                            as numeric
    local oARG                := oModel:GetModel('ARGMASTER') as object
    local oARH                := oModel:GetModel('ARHDETAIL') as object
    local nTamARH             := oARH:Length()                as numeric
    local aAreaSE2            := SE2->(FwGetArea())           as array
    local aAreaSA2            := SA2->(FwGetArea())           as array
    local cE2_FILORIG         := ""                           as character
    local cE2_PREFIXO         := ""                           as character
    local cE2_NUM             := ""                           as character
    local cE2_PARCELA         := ""                           as character
    local cE2_TIPO            := ""                           as character
    local cE2_FORNECE         := ""                           as character
    local cE2_LOJA            := ""                           as character
    local cFieldInstallment   := ""                           as character
    local cInstallmentDueDate := ""                           as character

    SA2->(DbSetOrder(1)) //A2_FILIAL, A2_COD, A2_LOJA
    SE2->(DbSetOrder(1)) //E2_FILIAL, E2_PREFIXO, E2_NUM, E2_PARCELA, E2_TIPO, E2_FORNECE, E2_LOJA

    jData["requestId"] := oARG:getValue("ARG_NUM") //Código da Solicitação.
    If oARG:getValue("ARG_FORPGO") == "1"
        jData["requestDate"]          := SubSTR(FWTimeStamp(5, oARG:getValue("ARG_DTSOL")), 1, 10)//Data da solicitação. "AAAA-MM-DD"
        jData["totalAmount"]          := oARG:getValue("ARG_VLTOT") //Valor total
        jData["totalAmountRequested"] := oARG:getValue("ARG_VLSOL") //Valor total da solicitação
    Else
        jData["scheduledDate"] := SubSTR(FWTimeStamp(5, oARG:getValue("ARG_DTAAGE")), 1, 10) //Data de agendamento AAAA-MM-DD
    Endif

    jData["paymentSlips"]      := {} //Boletos da solicitação de simulação
    jData["installmentsCount"] := 0
    For nY := 1 To nTamARH
        oARH:GoLine(nY)
        cE2_FILORIG := oARH:getValue("ARH_FILTIT")
        cE2_PREFIXO := oARH:getValue("ARH_PREFIX")
        cE2_NUM     := oARH:getValue("ARH_NUMTIT")
        cE2_PARCELA := oARH:getValue("ARH_PARCEL")
        cE2_TIPO    := oARH:getValue("ARH_TIPO")
        cE2_FORNECE := oARH:getValue("ARH_FORNEC")
        cE2_LOJA    := oARH:getValue("ARH_LOJA")

        jPaymentSlips := JsonObject():new()
        jPaymentSlips["paymentSlipId"]      := Alltrim(oARH:getValue("ARH_IDDOC")) //Id do boleto
        jPaymentSlips["paymentSlipDueDate"] := SubSTR(FWTimeStamp(5, oARH:getValue("ARH_VENCRE")), 1, 10) //Data de vencimento do boleto. "AAAA-MM-DD"
        jPaymentSlips["amount"]             := oARH:getValue("ARH_VLBOL") //Valor do boleto

        If SA2->(MsSeek(FwXFilial("SA2", cE2_FILORIG)+cE2_FORNECE+cE2_LOJA))
            jPaymentSlips["companyDocumentNumber"] := Alltrim(SA2->A2_CGC) //Número do documento do fornecedor
            jPaymentSlips["companyName"]           := Alltrim(SA2->A2_NOME) //Nome do fornecedor
        Endif

        If SE2->(MsSeek(FwXFilial("SE2", cE2_FILORIG)+cE2_PREFIXO+cE2_NUM+cE2_PARCELA+cE2_TIPO+cE2_FORNECE+cE2_LOJA))
            jPaymentSlips["barcode"]       := SE2->E2_CODBAR //Código de barras
            jPaymentSlips["digitableLine"] := SE2->E2_LINDIG //Linha digitável do boleto
        Endif
        jPaymentSlips["financingCondition"] := oARH:getValue("ARH_FNCOND") //Condição de financiamento (uso interno do Supplier)
        jPaymentSlips["simulationCode"]     := oARH:getValue("ARH_SLCODE") //Codigo da Simulação (uso interno do Supplier)
        jPaymentSlips["installments"]       := {}
        for nX := 1 to 03
            cFieldInstallment := "ARH_PARC" + cValToChar(nX)
            If !Empty(oARH:getValue(cFieldInstallment))
                cInstallmentDueDate := SubSTR(FWTimeStamp(5, oARH:getValue(cFieldInstallment)), 1, 10)
                Aadd(jPaymentSlips["installments"], {"installmentDueDate": cInstallmentDueDate, "installmentAmount": oARH:getValue("ARH_VLPARC"), "installmentNumber": nX})
            Endif
        next nX
        jPaymentSlips["installmentsCount"] := Len(jPaymentSlips["installments"])
        
        Aadd(jData["paymentSlips"], jPaymentSlips)
        jData["installmentsCount"] += jPaymentSlips["installmentsCount"]
    next nY
    FwRestArea(aAreaSE2)
    FwRestArea(aAreaSA2)
Return jData:ToJson()

/*/{Protheus.doc} downloadProofTransaction
    Realiza o download do comprovante da transação
    @type  Function
    @author Squad Techfin
    @since 13/10/2025
    @version 1.0
    @return lRet, Logical, Retorna .T. após iniciar o download do comprovante
/*/
Function downloadProofTransaction() as logical
    FWMsgRun(, {|| getDocuments(1,, Alltrim(ARG->ARG_CDTRAN)) }, "", STR0025) //"Baixando comprovante da transação, aguarde"
Return .T.

/*/{Protheus.doc} downloadSlips
    Realiza o download dos boletos para pagamento
    @type  Function
    @author Squad Techfin
    @since 13/10/2025
    @version 1.0
    @return lRet, Logical, Retorna .T. após iniciar o download dos boletos
/*/
Function downloadSlips() as logical
    FWMsgRun(, {|| getDocuments(3,, Alltrim(ARG->ARG_CDTRAN)) }, "", STR0026) //"Baixando boletos para pagamento, aguarde"
Return .T.

/*/{Protheus.doc} downloadProofPayment
    Realiza o download do comprovante de pagamento
    @type  Function
    @author Squad Techfin
    @since 13/10/2025
    @version 1.0
    @param oModel, Object, Objeto de modelo de dados contendo o ID do documento (ARH_IDDOC)
    @return lRet, Logical, Retorna .T. após iniciar o download do comprovante de pagamento
/*/
Function downloadProofPayment(oModel as object) as logical
    FWMsgRun(, {|| getDocuments(2, oModel:GetValue("ARHDETAIL", "ARH_IDDOC")) }, "", STR0027) //"Baixando comprovante de pagamento, aguarde"
Return .T.

/*/{Protheus.doc} getDocuments
    Recupera os documentos em base64 e realiza o processamento do arquivo PDF
    @type  Function
    @author Squad Techfin
    @since 14/10/2025
    @version 1.0
    @param nType, Numeric, Tipo de documento (1-Comprovante de transação; 2-Comprovante de pagamento; 3-Segunda via de boleto)
    @param cIdSlip, Character, ID do boleto 
    @param cTransactionCode, Character, Código da transação (obrigatório para nType == 1 ou 3)
    @return lRet, Logical, Retorna .T. após processar o documento
/*/
Function getDocuments(nType as numeric, cIdSlip as character, cTransactionCode as character) as logical
    local jData := JsonObject():new()                               as json
    local jResponse := JsonObject():new()                           as json
    local cQueue := "MaisPrazoSlipConsultationRequestV1"            as character
    local cResponseQueue := "MaisPrazoSlipConsultationResponseV1"   as character
    local cResponse := ""                                           as character
    local cNameFile := Lower(FwUUIDV4()) + ".pdf"                   as character
    
    DEFAULT nType := 1
    DEFAULT cIdSlip := ""
    DEFAULT cTransactionCode := ""

    If (nType == 1 .or. nType == 3) .and. Empty(cTransactionCode)
        Help( ,,"STATUS",, STR0029, 1, 0 ) //"Não é possível baixar o arquivo porque a solicitação está em aprovação ou foi rejeitada."
        return .T.
    Endif

    jData["transactionType"] := nType
    jData["paymentSlipId"] := cIdSlip
    jData["transactionCode"] := cTransactionCode

    cResponse := awaitSmartLink("2", "SlipConsultation", cQueue, cResponseQueue, jData:ToJson())

    If !Empty(cResponse)
        if Empty(handleMessageError(cResponse)) .and. jResponse:FromJson(cResponse) == NIL .and. jResponse:hasProperty("data") .and. jResponse["data"]:hasProperty("base64")
            processFile(cNameFile, jResponse["data"]["base64"])
        Endif
    Endif
    
Return .T.

/*/{Protheus.doc} extensionMonitor
    Classe responsável por orquestrar os eventos do modelo de dados da rotina de monitor de prorrogações
    @type  Class
    @author Squad Techfin
    @since 24/09/2025
    @version 1.0
/*/
Class extensionMonitor from FWModelEvent
    Public Method new()
    Public Method InTTS(oModel as object)
EndClass

/*/{Protheus.doc} new
    Método construtor da classe extensionMonitor
    @author Squad Techfin
    @since 24/09/2025
    @version 1.0
    @return self, Object, Instância da classe extensionMonitor
/*/
Method new() Class extensionMonitor
Return self

/*/{Protheus.doc} InTTS
    Método chamado pelo MVC durante a gravação do Model, no controle de transação.
    Responsável por enviar a mensagem ao SmartLink para processar a solicitação de prorrogação ou agendamento.
    @type  Method
    @author Squad Techfin
    @since 24/09/2025
    @version 1.0
    @param oModel, Object, Objeto de modelo de dados da rotina
/*/
Method InTTS(oModel as object) Class extensionMonitor
    Local cData    := ""                                            as character
    Local cQueue   := "MaisPrazoDueDateExtensionExecuteRequestV1"   as character
    Local cOperation := "DueDateExtension"                          as character
    Local cMSGID   := ""                                            as character

    If oModel:GetOperation() == MODEL_OPERATION_INSERT
        If ARG->ARG_FORPGO == "2"
            cQueue := "MaisPrazoPaymentSchedulingExecuteRequestV1"
            cOperation := "PaymentScheduling"
        Endif

        cData := prepareMessage(oModel)
        cMSGId := sendSmartLink(cQueue, "2", cOperation, cData, .T., ARG->ARG_MSUID, .F., "ARG")

        If Empty(cMSGID)
            oModel:SetErrorMessage(,,,, "Smartlink", STR0012, STR0013) //"Problema de comunicação com o Smartlink"#"Verifique a configuração do SmartLink e tente novamente mais tarde"
            RollbackDelTran()
        EndIf
    Endif
Return

/*/{Protheus.doc} cancellation
    Realiza o cancelamento da solicitação de prorrogação de títulos
    @type  Function
    @author Squad Techfin
    @since 20/05/2026
    @version 1.0
    @return lLogic, Logical, Retorna .T. após processar o cancelamento
/*/
Function cancellation() as logical
    local oMaisPrazoCancellationRequest := MaisPrazoPaymentSlipCancellationRequestV1():new() as object
    local oModal   := TechfinDialog():new() as object
    local nOpc     := 1                     as numeric
    local aRet     := {.F.,""}              as array
    local cHeader  := ""                    as character
    local cMessage := ""                    as character
    local cJustificativa := ""              as character
    local cVencimento := getFirstSlip(ARG->ARG_NUM) as character

    oMaisPrazoCancellationRequest:goTo(ARG->ARG_NUM)
    oMaisPrazoCancellationRequest:setEligibilityRules()

    If oMaisPrazoCancellationRequest:isValidStatus()
        oModal:setTitle(STR0032 + " +Prazo") //"Cancelar agendamento do"
        oModal:setText(020, 010, STR0033)  //"Ao cancelar, você assume novamente o pagamento dos boletos nas datas de vencimento originais. Essa ação precisa de aprovação."
        oModal:setText(040, 010, "<b>"+STR0034+"</b>")  //"Dados do agendamento:"
        oModal:setText(055, 010, STR0035)  //"Número da solicitação:"
        oModal:setText(070, 010, STR0036)  //"Total de Boletos:"
        oModal:setText(085, 010, STR0053)  //"Valor Total:"
        oModal:setText(100, 010, STR0037)  //"Próximo vencimento:"
        oModal:setText(055, 180, Alltrim(ARG->ARG_NUM))  //"Número da solicitação:"
        oModal:setText(070, 180, Alltrim(Transform(ARG->ARG_QTDTIT,X3Picture("ARG_QTDTIT"))))  //"Total de Boletos:"
        oModal:setText(085, 180, Alltrim(Transform(ARG->ARG_VLTOT,X3Picture("ARG_VLTOT"))))  //"Valor Total:"
        oModal:setText(100, 180, Alltrim(cVencimento))  //"Próximo vencimento:"
        oModal:setButton(STR0040, {|| nOpc := 1, oModal:DeActivate() }) //"Confirmar cancelamento"
        oModal:setButton(STR0038, {|| nOpc := 0, oModal:DeActivate() }) //"Voltar"
        oModal:setButton(STR0039, {|| showJustificativa(@cJustificativa) }) //"Justificar solicitação"
        oModal:openInfo(160, 230)
        
        FwFreeObj(oModal)
        oModal := TechfinDialog():new()

        If nOpc == 1
            aRet := oMaisPrazoCancellationRequest:setCancelation(ARG->ARG_NUM,cJustificativa)
        EndIf
    EndIf

    If aRet[1]
        cHeader  := STR0045 //"Solicitação de cancelamento enviada!"
        cMessage := STR0046 + "+Prazo" + STR0047 //"Solicitação de cancelamento enviada!"#"Você pode acompanhar o status em Techfin > Consultar solicitação"
    Else
        cHeader  := STR0049 //"Não é possível cancelar este agendamento"
        cMessage := STR0050 + "+Prazo" + STR0051 //"Para cancelar o "#" por aqui, o agendamento precisa estar ativo e sem parcelas pagas ou vencidas."
        If aRet[2] == "1" .Or. oMaisPrazoCancellationRequest:getCodError() == "1"
            cHeader  := ""
            cMessage := STR0052 //"Já existe uma solicitação de cancelamento em análise para esta solicitação."
        EndIf
    Endif

    If Empty(cHeader)
        oModal:setText(30, 10, CRLF + cMessage, 30) 
    Else
        oModal:setText(30, 10, "<b>"+cHeader+"</b>" + CRLF + CRLF + cMessage, 30) 
    Endif

    If aRet[1] 
        oModal:setButton(STR0022, {|| oModal:DeActivate() }) //"Fechar"
    Else
        oModal:setButton(STR0023, {|| oModal:DeActivate() }) //"Ok, entendi"
    Endif

    If !(nOpc == 0)
        oModal:openInfo(100, 200)
    EndIf

    FwFreeObj(oModal)
    FwFreeObj(oMaisPrazoCancellationRequest)
    FwFreeArray(aRet)
Return .T.

/*/{Protheus.doc} vldStatusMaisPrazo
    Valida se todos os títulos de uma solicitação possuem o mesmo status
    @type  Function
    @author Squad Techfin
    @since 20/05/2026
    @version 1.0
    @param cSolicitacao, Character, Código da solicitação de prorrogação
    @return lRet, Logical, Indica se todos os títulos possuem o mesmo status
/*/
function vldStatusMaisPrazo(cSolicitacao as Character) as logical
    Local cStatus := "" as Character
    local aAreas  := {} as Array
    local cFilialARH := FwXFilial("ARH") as Character
    local lRet := .T. as Logical
    aAdd(aAreas, ARG->(FwGetArea()))
    aAdd(aAreas, ARH->(FwGetArea()))
    
    ARG->(DbSetOrder(1)) 
    ARH->(DbSetOrder(1))
    
    If ARG->(MsSeek(FwXFilial("ARG") + cSolicitacao)) .And. ARH->(MsSeek(cFilialARH + cSolicitacao))
        While !ARH->(Eof()) .and. ARH->ARH_FILIAL == cFilialARH .and. ARH->ARH_NUM == cSolicitacao
            If Empty(cStatus) 
                cStatus := ARH->ARH_STATUS
            ElseIf !(cStatus == ARH->ARH_STATUS)
                lRet := .F.
                Exit
            EndIf
        
            ARH->(DbSkip())
        EndDo
    EndIf

    aEval(aAreas, {|x| FwRestArea(x) })
    FwFreeArray(aAreas)
Return lRet

/*/{Protheus.doc} getFirstSlip
    Obtém a data de vencimento do primeiro boleto de uma solicitação
    @type  Function
    @author Squad Techfin
    @since 27/05/2026
    @version 1.0
    @param cSolicitacao, Character, Código da solicitação
    @return cVencimento, Character, Data de vencimento do primeiro boleto
/*/
Function getFirstSlip(cSolicitacao as Character) as Character
    local cVencimento := "" as Character
    local cQuery      := "" as Character
    local oExecQuery        as Object
    local nBind       := 1  as Numeric

    cQuery := "SELECT ARH_VENCRE "
    cQuery += " FROM " + RetSqlName("ARH") + " ARH "
    cQuery += " WHERE ARH_FILIAL = ? "
    cQuery += " AND ARH_NUM = ? "
    cQuery += " AND ARH.D_E_L_E_T_ = ?"
    cQuery += " ORDER BY ARH_VENCRE "
    cQuery := ChangeQuery(cQuery)

    oExecQuery := FwExecStatement():New(cQuery)

    oExecQuery:setString(nBind++, FwXFilial("ARH"))
    oExecQuery:setString(nBind++, cSolicitacao)
    oExecQuery:setString(nBind++, " ") 
    cVencimento := DToC(SToD(oExecQuery:execScalar("ARH_VENCRE")))


    FwFreeObj(oExecQuery)
Return cVencimento

/*/{Protheus.doc} showJustificativa
    Exibe diálogo para entrada de justificativa de cancelamento
    @type  Function
    @author Squad Techfin
    @since 27/05/2026
    @version 1.0
    @param cJustificativa, Character, Justificativa de cancelamento (passado por referência)
    @return Nil
/*/
Function showJustificativa(cJustificativa as Character)
    cJustificativa := FWInputBox(STR0043, cJustificativa)
Return 
