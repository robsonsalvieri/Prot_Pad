#Include "tlpp-core.th"
#Include "FwMVCDef.ch"
#Include "Protheus.ch"
#include "backoffice.techfin.maisprazo.eligibility.ch"

NAMESPACE totvs.protheus.backoffice.techfin.maisprazo.eligibility

Static __cPicture :='' as character

/*/{Protheus.doc} EligibilityRules
    Totvs Antecipa 
    Consulta de parâmeros de negociação / elegibilidade

    @type       Function
    @author     Totvs
    @since      27/07/2025
    @version    P12.1.2510
    @param      
    @return     
/*/
Function EligibilityRules()

    Local oDlg                                       as Object
    Local oLayer                                     as Object
    Local oSay1                                      as Object
    Local oSay2                                      as Object
    Local oSay3                                      as Object
    Local oSay4                                      as Object
    Local oBrwStatus                                 as Object
    Local oPanelProc                                 as Object
    Local oPanelTotal                                as Object
    Local oPanelUtilizado                            as Object
    Local oPanelDisponivel                           as Object
    Local oPanelTitulo                               as Object
    Local oPanelStatus                               as Object
    Local oButtonClose                               as Object
    Local nLin         := 0                          as Numeric     
    Local aCoors       := FWGetDialogSize(oMainWnd)  as Array
    Local aAtuArea     := FwGetArea()                as Array
    Local bUpdValues                                 as codeblock
    Private oFont14                                  as Object
    Private oPanelLista                              as Object    
    
    __cPicture := PesqPict("ARA","ARA_LTOTAL") 
    oFont14    := TFont():New(,,-14,,, )
    oBrwStatus := FWMBrowse():New()
    
    bUpdValues := {|| RetValues(@oSay1, @oSay2, @oSay3, @oSay4)}

    DEFINE MSDIALOG oDlg  FROM aCoors[1],aCoors[2] TO aCoors[3],aCoors[4] of oMainWnd PIXEL STYLE nOr(WS_VISIBLE,WS_POPUP)

    oLayer := FWLayer():new()
    oLayer:Init(oDlg,.F.)

    oLayer:AddLine('LIN1',8,.F.)
    oLayer:addCollumn('COL1',95, .F. ,'LIN1')
    oPanelTitulo    := oLayer:getColPanel('COL1','LIN1')
    oPanelTitulo:FreeChildren()
    TSay():New(10,10,{|| STR0001 },oPanelTitulo,,TFont():New(,,-20,.T.),,,,.T.)//'Consulta Parâmetros / Elegibilidade'

    oLayer:addCollumn('COL2',5, .F. ,'LIN1')
    oButtonClose := TButton():New( 10, 10, "x", oLayer:getColPanel('COL2','LIN1'), {||oDlg:End()}, 30,10,,TFont():New(,,-20,.T.),.F.,.T.,.F.,,.F.,,,.F. )
    oButtonClose:setCss("QPushButton{border: none}")

    oLayer:AddLine('LIN2',12,.F.)
    oLayer:AddCollumn('COL1',25, .T. ,'LIN2')
    oLayer:AddCollumn('COL2',25, .T. ,'LIN2')
    oLayer:AddCollumn('COL3',25, .T. ,'LIN2')
    oLayer:AddCollumn('COL4',25, .T. ,'LIN2')
    oLayer:AddWindow('COL1','Win1',STR0009,100,.F.,.T.,/*bClickTitle*/,'LIN2')  //'Limite por empresa raiz'
    oLayer:AddWindow('COL2','Win1',STR0002,100,.F.,.T.,/*bClickTitle*/,'LIN2')  //'Limite Utilizado'
    oLayer:AddWindow('COL3','Win1',STR0008,100,.F.,.T.,/*bClickTitle*/,'LIN2')  //'Limite em processamento'
    oLayer:AddWindow('COL4','Win1',STR0003,100,.F.,.T.,/*bClickTitle*/,'LIN2')  //'Limite Disponivel'
    
    oPanelTotal := oLayer:GetWinPanel('COL1','Win1','LIN2')
    oPanelTotal:FreeChildren()
    oPanelUtilizado := oLayer:GetWinPanel('COL2','Win1','LIN2')
    oPanelUtilizado:FreeChildren()
    oPanelProc  := oLayer:GetWinPanel('COL3','Win1','LIN2')
    oPanelProc:FreeChildren()
    oPanelDisponivel := oLayer:GetWinPanel('COL4','Win1','LIN2')
    oPanelDisponivel:FreeChildren()

    nLin := oPanelUtilizado:nHeight/4 //Altura das janelas superiores 
    oSay1 := TSay():New( nLin, 5,{|| ''}, oPanelTotal,,     oFont14,.F.,.F.,.F.,.T.,,,100,020) 
    oSay2 := TSay():New( nLin, 5,{|| ''}, oPanelUtilizado,, oFont14,.F.,.F.,.F.,.T.,,,100,020) 
    oSay3 := TSay():New( nLin, 5,{|| ''}, oPanelProc,,      oFont14,.F.,.F.,.F.,.T.,,,100,020) 
    oSay4 := TSay():New( nLin, 5,{|| ''}, oPanelDisponivel,,oFont14,.F.,.F.,.F.,.T.,,,100,020) 

    oLayer:AddLine('LIN3',4,.F.)
    oLayer:addCollumn('COL1',100, .T. ,'LIN3')
    TSay():New(1,5,{|| STR0004 },oLayer:getColPanel('COL1','LIN3'),,,,,,.T.) //'Caso a empresa possua mais filiais em outro ambiente esse limite também será compartilhado'

    oLayer:AddLine('LIN4',20,.F.)
    oLayer:addCollumn('COL1',100, .T. ,'LIN4')
    oLayer:AddWindow('COL1','Win1',STR0005, 100, .F., .T., /*bClickTitle*/, 'LIN4') //'Status CNPJ emitente'

    oPanelStatus := oLayer:GetWinPanel('COL1','Win1','LIN4')
    oPanelStatus:FreeChildren()

    oBrwStatus:SetOwner(oPanelStatus)
    oBrwStatus:SetDescription( '' )
    oBrwStatus:SetAlias('ARA')
    oBrwStatus:SetMenuDef('')
    oBrwStatus:SetFilterDefault( "ARA->ARA_PRODTF == '2'" ) //Mais Prazo
    oBrwStatus:AddLegend( "ARA_STATUS == '0'", "GREEN" , STR0010) //"Ativo" 
    oBrwStatus:AddLegend( "ARA_STATUS == '1'", "RED"   , STR0011) //"Bloqueado Crédito" 
    oBrwStatus:AddLegend( "ARA_STATUS == '2'", "ORANGE", STR0012) //"Bloqueado Atraso" 
    oBrwStatus:AddLegend( "ARA_STATUS == '3'", "BROWN" , STR0013) //"Cancelado" 
    oBrwStatus:AddLegend( "ARA_STATUS == '4'", "BLACK" , STR0014) //"Bloqueado Outros" 
    oBrwStatus:DisableReport()
    oBrwStatus:DisableConfig()
    oBrwStatus:DisableLocate()
    oBrwStatus:DisableSaveConfig()
    oBrwStatus:DisableSeek()
    oBrwStatus:DisableFilter()
    oBrwStatus:DisableDetails()
    oBrwStatus:SetChange( bUpdValues )
    oBrwStatus:Activate()
    
    oLayer:AddLine('LIN5',56,.F.)
    oLayer:addCollumn('COL1',100, .T. ,'LIN5')
    oLayer:AddWindow('COL1','Win1',STR0006, 100, .F., .T., /*bClickTitle*/, 'LIN5') //'Parametros / Regras'
    oPanelLista := oLayer:GetWinPanel('COL1','Win1','LIN5')
    oPanelLista:FreeChildren()
        
    ACTIVATE MSDIALOG oDlg CENTERED on Init(Eval(bUpdValues))

    FwRestArea(aAtuArea)
    
    aSize(aCoors,0)
    aSize(aAtuArea,0)
    FwFreeArray(aCoors)
    FwFreeArray(aAtuarea)
    FwFreeObj(oDlg)

Return(Nil)


/*/{Protheus.doc} RetLimValues
    Atualiza dados da empresa/filial posicionada no browse (registro da ARA)
    @author Squad Integrações Techfin
    @since 27/09/2025
    @param oTotal   , object, tSay do limite total
    @param oUtil    , object, tSay do limite utilizado
    @param oPreAut  , object, tSay da limite pre-autorizado
    @param oDisp    , object, tSay da limite disponível
    @version 1.0
/*/
Function RetValues(oTotal as object, oUtil as object, oPreAut as object, oDisp as object)

    Local oSay                              as object
    Local oScroll                           as object
    Local cText      := ''                  as character    
    Local jDataPrint := JsonObject():new()  as json        
    Local nX         := 0                   as numeric
    Local nY         := 0                   as numeric    
    Local nLin       := 0                   as numeric    
    
    //---------------------------------------------------------------------------------------
    //-- Valores dos cards superiors    
     if oTotal <> nil
        oTotal:SetText("R$ "+Transform(ARA->ARA_LTOTAL, __cPicture))
        oTotal:CtrlRefresh()
    endIf
    if oUtil <> nil
        oUtil:SetText("R$ "+Transform(ARA->ARA_LUTIL, __cPicture))
        oUtil:CtrlRefresh()
    endIf
    if oPreAut <> nil
        oPreAut:SetText("R$ "+Transform(ARA->ARA_LRPREA, __cPicture))
        oPreAut:CtrlRefresh()
    endIf
    if oDisp <> nil
        oDisp:SetText("R$ "+Transform(ARA->ARA_LDISP, __cPicture))
        oDisp:CtrlRefresh()
    endIf            
    

    //---------------------------------------------------------------------------------------
    //-- Apresentação dos parametros e regras de elegbilidade
    jDataPrint:fromJson(ARA->ARA_FTXMSG)
    if jDataPrint:hasProperty("message")
        If oPanelLista <> nil
            oPanelLista:FreeChildren()        
            oScroll := TScrollArea():New(oPanelLista)
            oScroll:Align := CONTROL_ALIGN_ALLCLIENT
        

            nLin:=0        
            For nX:=1 to Len(jDataPrint['message'])//Agrupamentos
                cText :=jDataPrint['message'][nX]['category']
                oSay := TSay():New(nLin+=10, 10, {|| ''}, oScroll,,oFont14,,,,.T.,,,500, 20,,,,,, .T.)
                oSay:SetText( cText )
                nLin+=5
                    
                For nY:=1 to Len(jDataPrint['message'][nX]['items'])//Itens do agrupamento
                    cText := jDataPrint['message'][nX]['items'][nY]
                    oSay := TSay():New(nLin+=10, 20, {|| ''}, oScroll,,,,,,.T.,,,500, 20,,,,,, .T.)
                    oSay:SetText( cText )
                Next nY
                nLin+=10
            Next nX                
        EndIf
    Else
        If oPanelLista <> nil
            oPanelLista:FreeChildren()        
            TSay():New(nLin+=10, 10, {|| STR0007+' '+Transform(ARA->ARA_CNPJ,'@!R NN.NNN.NNN/NNNN-99')}, oPanelLista,,oFont14,,,,.T.,,,500, 20,,,,,, .T.)//'Não foi localizada lista de parametros para a Empresa/Filial - CNPJ'
        EndIF
    EndIF

Return(Nil)
