#include "TOTVS.ch"
#include "TBICONN.ch"

/*/{Protheus.doc} MaisPrazoSlipConsultationResponseV1MessageReader
	Classe de Integração Novo Mais Prazo
	Atualiza os dados de log para download dos arquivos
	@type class
	@author Vitor Duca
	@since 14/10/2025
/*/
class MaisPrazoSlipConsultationResponseV1MessageReader
	data jMSGData  	as json
	data jMessage  	as json
	data cMock    	as character
    data lMock    	as logical

	public method new() constructor
	public method read(oLinkMessage as object) as logical
	public method mock()
end class

/*/{Protheus.doc} MaisPrazoSlipConsultationResponseV1MessageReader::New
	Método construtor da classe
	@type method
	@author Vitor Duca
	@since 14/10/2025
/*/
method New() class MaisPrazoSlipConsultationResponseV1MessageReader
	::jMSGData  := JsonObject():new()
	::jMessage  := JsonObject():new()
	::cMock		:= ""
	::lMock		:= .F.
return Self

/*/{Protheus.doc} MaisPrazoSlipConsultationResponseV1MessageReader::mock
    Método para mockar a mensagem recebida para testes
    @type method
    @author Squad TechFin
    @since 14/10/2025
    @param cData, character, dados da mensagem a ser mockada
/*/
method mock(cData as character) class MaisPrazoSlipConsultationResponseV1MessageReader
    ::cMock := cData
    ::lMock := .T.
return

/*/{Protheus.doc} MaisPrazoSlipConsultationResponseV1MessageReader::read
	esponsável pela leitura e processamento da mensagem.
	@type method
	@author Vitor Duca
	@since 14/10/2025
	@param oLinkMessage, object, Instância de FwTotvsLinkMesage da mensagem
	@return logical, sucesso ou falha. Determina se deve ou não retirar a mensagem da fila.
/*/
method read(oLinkMessage as object) as logical class MaisPrazoSlipConsultationResponseV1MessageReader
	local cMessage := ""	as character
	local aIdent := {}		as array
	local cCompany := ""	as character
	local cBranch := ""		as character
	local cIdMsg := ""		as character
	local lSuccess := .T.	as logical
	
	cMessage :=  if(::lMock, ::cMock,  oLinkMessage:RawMessage())

	if ::jMessage:FromJSON(cMessage) == NIL
		::jMSGData  := ::jMessage["data"]
		aIdent := StrTOKArr(::jMSGData["erpRequestId"], "|")//"erpRequestId": "cEmpAnt|cFilAnt|UUID" - conforme mensagem de envio				
		If Len(aIdent) == 3
			cCompany := aIdent[1]
			cBranch	 := aIdent[2]
			cIdMsg	 := aIdent[3]
			
			lSuccess := StartJob("TMPZFiles", GetEnvServer(), .T., cCompany, cBranch, cMessage, cIdMsg)
		EndIf
	endIf

	FwFreeObj(::jMSGData)
	FwFreeObj(::jMessage)

Return lSuccess // .T. apaga a mensagem da fila do smartlink

/*/{Protheus.doc} TMPZFiles
	Gravação do log do retorno dos arquivos de download
	@type function
	@author Vitor Duca
	@since 14/10/2025
	@param cCompany, character, Grupo Empresa
	@param cBranch , character, Filial
	@param cPayload, character, mensagem recebida
	@param cIdMsg, character, Id da requisição
/*/
Function TMPZFiles(cCompany as character, cBranch as character, cPayload as character, cIdMsg as character) as logical
	RPCSetType(3) 
	RPCSetEnv(cCompany, cBranch,,,'FIN')
		BEGIN TRANSACTION
			totvs.protheus.backoffice.techfin.util.logSmartLink(cPayload, "", "", "2", "SlipConsultation", "T", cIdMsg)
		END TRANSACTION
	RpcClearEnv()
Return .T.
