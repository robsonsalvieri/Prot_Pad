#include "TOTVS.ch"
#include "TBICONN.ch"

/*/{Protheus.doc} MaisPrazoDueDateExtensionExecuteResponseV1MessageReader
	Classe de Integração Novo Mais Prazo
	Atualiza os dados no ERP de acordo com o retorno das prorrogações
	@type class
	@author Vitor Duca
	@since 01/10/2025
/*/
class MaisPrazoDueDateExtensionExecuteResponseV1MessageReader
	data jMSGData  	as json
	data jMessage  	as json
	data cMock    	as character
    data lMock    	as logical

	public method new() constructor
	public method read(oLinkMessage as object) as logical
	public method mock()
end class

/*/{Protheus.doc} MaisPrazoDueDateExtensionExecuteResponseV1MessageReader::New
	Método construtor da classe
	@type method
	@author Vitor Duca
	@since 01/10/2025
/*/
method New() class MaisPrazoDueDateExtensionExecuteResponseV1MessageReader
	::jMSGData  := JsonObject():new()
	::jMessage  := JsonObject():new()
	::cMock		:= ""
	::lMock		:= .F.
return Self

/*/{Protheus.doc} MaisPrazoDueDateExtensionExecuteResponseV1MessageReader::mock
    Método para mockar a mensagem recebida para testes
    @type method
    @author Squad TechFin
    @since 01/10/2025
    @param cData, character, dados da mensagem a ser mockada
/*/
method mock(cData as character) class MaisPrazoDueDateExtensionExecuteResponseV1MessageReader
    ::cMock := cData
    ::lMock := .T.
return

/*/{Protheus.doc} MaisPrazoDueDateExtensionExecuteResponseV1MessageReader::read
	esponsável pela leitura e processamento da mensagem.
	@type method
	@author Vitor Duca
	@since 01/10/2025
	@param oLinkMessage, object, Instância de FwTotvsLinkMesage da mensagem
	@return logical, sucesso ou falha. Determina se deve ou não retirar a mensagem da fila.
/*/
method read(oLinkMessage as object) as logical class MaisPrazoDueDateExtensionExecuteResponseV1MessageReader
	local cMessage := ""	as character
	local aIdent := {}		as array
	local cCompany := ""	as character
	local cBranch := ""		as character
	local cUUID := ""		as character
	local cIdMessage := ""	as character
	local lSuccess := .T.	as logical
	
	cMessage :=  if(::lMock, ::cMock,  oLinkMessage:RawMessage())

	if ::jMessage:FromJSON(cMessage) == NIL
		::jMSGData  := ::jMessage["data"]
		aIdent := StrTOKArr(::jMSGData["erpRequestId"], "|")//"erpRequestId": "cEmpAnt|cFilAnt|IDReq|UUID" - conforme mensagem de envio				
		If Len(aIdent) == 4
			cCompany 	:= aIdent[1]
            cBranch  	:= aIdent[2]     
            cIdMessage	:= aIdent[3]     
            cUUID   	:= aIdent[4]
			
			lSuccess := StartJob("totvs.protheus.backoffice.techfin.maisprazo.job.runExtension", GetEnvServer(), .T., cCompany, cBranch, cMessage, cUUID, cIdMessage)
		EndIf
	endIf

	FwFreeObj(::jMSGData)
	FwFreeObj(::jMessage)

Return .T. //Realizar a limpeza da fila do SmartLink para evitar requisições duplicadas acumuladas.
