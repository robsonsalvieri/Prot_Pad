    @param cSolicitacao, character, Número da solicitação a ser definido
/*/
Method setSolicitacao(cSolicitacao as character) class MaisPrazoPaymentSlipCancellationRequestv1
    ::cSolicitacao := cSolicitacao
Return

/*/{Protheus.doc} getSolicitacao
    Retorna o número da solicitação da solicitação de pagamento
    @author Squad Techfin
    @since 20/05/2026
    @version 1.0
    @return cSolicitacao, character, Número da solicitação
/*/
Method getSolicitacao() as character class MaisPrazoPaymentSlipCancellationRequestv1
Return ::cSolicitacao    

/*/{Protheus.doc} send
    Envia a solicitação de cancelamento para o sistema Smartlink via fila
    @author Squad Techfin
    @since 20/05/2026
    @version 1.0
    @return lSuccess, logical, Verdadeiro se a solicitação foi enviada com sucesso
/*/
Method send() as logical class MaisPrazoPaymentSlipCancellationRequestv1
    local cFila      := "MaisPrazoPaymentSlipCancellationRequestV1" as character
    local lSuccess   := .F.                   as logical
    local jData      := jsonObject():new()    as json
    local oSmartUtil := SmartlinkUtil():new() as object
    
    jData["requestId"] := ::getRequestId()
    jData["justificationCancellationDesc"] := ::getJustification()
    jData["paymentSlips"] := ::getPaymentSlips()
    
    If (lSuccess := oSmartUtil:send(cFila, jData:toJson(), .T./*lReqID*/,::getReqKey()/*cReqId*/, .F./*lHelp*/))
        ::updateStatusSolicitacao()
    EndIf

    FwFreeObj(jData)
    FwFreeObj(oSmartUtil)
Return lSuccess

/*/{Protheus.doc} setJustification
    Define a descrição da justificativa para a solicitação de cancelamento
    @author Squad Techfin
    @since 20/05/2026
    @version 1.0
    @param cJustification, character, Descrição da justificativa (não utilizada, padrão é aplicado)
/*/
Method setJustification(cJustification as character) class MaisPrazoPaymentSlipCancellationRequestv1
    ::cJustification := cJustification
Return

/*/{Protheus.doc} getJustification
    Retorna a descrição da justificativa para a solicitação de cancelamento
    @author Squad Techfin
    @since 20/05/2026
    @version 1.0
    @return cJustification, character, Descrição da justificativa
/*/
Method getJustification() as character class MaisPrazoPaymentSlipCancellationRequestv1
Return ::cJustification

/*/{Protheus.doc} setPaymentSlips
    Adiciona o boleto ARH atual à coleção com seu ID
    @author Squad Techfin
    @since 20/05/2026
    @version 1.0
/*/
Method setPaymentSlips() class MaisPrazoPaymentSlipCancellationRequestv1
    local jPaymentSlip   := jsonObject():new() as json
    
    jPaymentSlip["paymentSlipId"] := ARH->ARH_IDDOC
    aAdd(::aPaymentSlips, jPaymentSlip)

Return

