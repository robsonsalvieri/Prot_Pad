#include "tlpp-core.th"
#include "totvs.ch"

using namespace totvs.protheus.backoffice.techfin.util
using namespace totvs.protheus.backoffice.techfin.maisprazo.monitor

static __cProdTF      := "2"   as character//Produto TF - Mais Prazo

/*/{Protheus.doc} MaisPrazoPaymentSlipCancellationResponseV1MessageReader
    
    @type class
    @author squad.techfin 
    @since 02/10/2025
/*/
class MaisPrazoPaymentSlipCancellationResponseV1MessageReader
    data jMSGData           as json
    data jMessage           as json
    data aEmpresaFil        as Array
    data cMock              as character
    data cData              as Character
    data lMock              as logical
    data aItensInvalidos    as Array
    data aItensProcessados  as Array
    data cRequestStatus      as Character
    data aPaymentSlips       as Array

    public method new() constructor
    public method formatMessage()
    public method processMessage() as logical
    public method loadMessage()    as logical
    public method read(oLinkMessage as object) as logical
    
    public method setMock(cData as character) 
    public method setMsgData(jMsgData as json)
    
    private method setEmpFil(cCnpj as Character) as logical
    private method setRequestStatus(cRequestStatus as Character)
    private method setPaymentSlips(aPaymentSlips as Array)
    
    private method getEmpFil() as Array
    private method getRequestStatus() as Character
    private method getPaymentSlips() as Array
    
end class

/*/{Protheus.doc} MaisPrazoPaymentSlipCancellationResponseV1MessageReader::New
	Método construtor da classe
	@type method
	@author squad.techfin
	@since 02/10/2025
    @return object, Instância da classe
/*/
method New() class MaisPrazoPaymentSlipCancellationResponseV1MessageReader 
    ::jMSGData           := jsonObject():new()
    ::jMessage           := jsonObject():new()
    ::aEmpresaFil        := {}
    ::cMock              := ""
    ::cData              := ""
    ::lMock              := .F.
    ::aItensInvalidos    := {}
    ::aItensProcessados  := {}
return Self

/*/{Protheus.doc} MaisPrazoPaymentSlipCancellationResponseV1MessageReader::setMock
    Método para mockar a mensagem recebida para testes
    @type method
    @author Squad TechFin
    @since 02/10/2025
    @param cData, character, dados da mensagem a ser mockada
    @return Nil
/*/
method setMock(cData as character) class MaisPrazoPaymentSlipCancellationResponseV1MessageReader
    ::cMock := cData
    ::lMock := .T. 
return

/*/{Protheus.doc} MaisPrazoPaymentSlipCancellationResponseV1MessageReader::read
	responsável pela leitura e processamento da mensagem.
	@type method
	@author squad.techfin
	@since 02/10/2025
	@param oLinkMessage, object, Instância de FwTotvsLinkMessage da mensagem
	@return logical, sucesso ou falha. Determina se deve ou não retirar a mensagem da fila.
/*/
method read(oLinkMessage as object) as logical class MaisPrazoPaymentSlipCancellationResponseV1MessageReader
    local cMessage := ""   as character

    If ::lMock
        cMessage := ::cMock
    Else
        cMessage := oLinkMessage:RawMessage()
    EndIf

    if ::jMessage:Fromjson(cMessage) == NIL
        ::setMsgData(::jMessage["data"])
        If ::loadMessage()
            ::formatMessage()
            ::processMessage()
        EndIf
    endIf

    FwFreeObj(::jMSGData)
    FwFreeObj(::jMessage)

Return .T.

/*/{Protheus.doc} MaisPrazoPaymentSlipCancellationResponseV1MessageReader::setMsgData
	Define dados da variavel jMSGData
	@type method
	@author squad.techfin
	@since 02/10/2025	
    @param jMsgData, json, dados da mensagem a serem armazenados
    @return Nil
/*/
method setMsgData(jMsgData as json)  class MaisPrazoPaymentSlipCancellationResponseV1MessageReader
    ::jMSGData := jMsgData
Return 

/*/{Protheus.doc} MaisPrazoPaymentSlipCancellationResponseV1MessageReader::loadMessage
	Realiza load (carga de dados).
	@type method
	@author squad.techfin
	@since 02/10/2025
    @return logical, Verdadeiro - quado os dados estão dentro do layout para processsar ou Falso - quando não esta correto.
/*/
method loadMessage() as logical class MaisPrazoPaymentSlipCancellationResponseV1MessageReader
    Local lRet := .F. as logical

    If (lRet := ::jMSGData:hasProperty("requestStatus"))
        
        If (lRet := ::jMSGData:hasProperty("erpRequestId"))
            lRet := ::setEmpFil(::jMSGData["erpRequestId"])
        EndIf
        If lRet .And. (lRet := ::jMSGData:hasProperty("requestStatus"))
            ::setRequestStatus(::jMSGData["requestStatus"])
        EndIf
        If lRet .And. (lRet := ::jMSGData:hasProperty("paymentSlips"))
            ::setPaymentSlips(::jMSGData["paymentSlips"])
        EndIf
    EndIf
Return lRet

/*/{Protheus.doc} MaisPrazoPaymentSlipCancellationResponseV1MessageReader::formatMessage
	Realiza formatação dos dados para processamento.
	@type method
	@author squad.techfin
	@since 02/10/2025	
    @return Nil
/*/
method formatMessage() class MaisPrazoPaymentSlipCancellationResponseV1MessageReader
    local jData       := nil            as json

    jData := jsonObject():New()
    jData["status"]       := ::getRequestStatus()
    jData["paymentSlips"] := ::getPaymentSlips()
    
    ::cData := jData:Tojson()
   
return

/*/{Protheus.doc} MaisPrazoPaymentSlipCancellationResponseV1MessageReader::processMessage
	Inicia o processamento da mensagem enviada pelo Smartlink.
	@type method
	@author squad.techfin
	@since 02/10/2025
	@return logical, Verdadeiro se o processamento foi bem-sucedido, Falso caso contrário
/*/
method processMessage() as logical class MaisPrazoPaymentSlipCancellationResponseV1MessageReader
    local cPayload := ""            as character
    local lSuccess := .T.           as logical
    Local aSM0     := ::getEmpFil() as array

    If Len(aSM0) > 0
        cPayload := ::jMessage:Tojson()
        
        lSuccess := StartJob("TFMPPaymentSlipCancellation", GetEnvServer(), .T., aSM0[Len(aSM0)][1], aSM0[Len(aSM0)][2],aSM0[Len(aSM0)][4], ::cData, cPayload)
    EndIf    

return lSuccess

/*/{Protheus.doc} MaisPrazoPaymentSlipCancellationResponseV1MessageReader::setEmpFil
	Valida dados empresa na SM0
	@type method
	@author squad.techfin
	@since 02/10/2025
	@param cErpRequestId, character, identificador de requisição da empresa
	@return logical, Verdadeiro se os dados da empresa foram validados com sucesso, Falso caso contrário
/*/
method setEmpFil(cErpRequestId as Character) as logical  class MaisPrazoPaymentSlipCancellationResponseV1MessageReader
    Local nPosSM0   := 0                             as numeric 
    Local aSM0      := FWLoadSM0()	                 as array
    Local aErpReqId := StrTOKArr2(cErpRequestId,"|") as array
    Local cPayload  := ::jMessage:Tojson()           as character
    
    If Len(aErpReqId) >= 4 .And. (nPosSM0 := aScan(aSM0, {|x| (Alltrim(x[1]) == Alltrim(aErpReqId[1]) .And. Alltrim(x[2]) == Alltrim(aErpReqId[2]))})) > 0
        aAdd(::aEmpresaFil,{aSM0[nPosSM0][1],aSM0[nPosSM0][2],cErpRequestId,Alltrim(aErpReqId[4])}) 
    EndIf
    If nPosSM0 == 0
        logSmartLink(cPayload, "", /*cUUID*/, __cProdTF, "PaymentSlipCancellation", "T",,formatLog({{"error", cErpRequestId, "RequestId invalido"}}))
    EndIf
 return nPosSM0 > 0

/*/{Protheus.doc} MaisPrazoPaymentSlipCancellationResponseV1MessageReader::getEmpFil
	Retorna dados da empresa SM0.
	@type method
	@author squad.techfin
	@since 02/10/2025
	@return array, Array com dados da empresa e filial
/*/
method getEmpFil() as Array class MaisPrazoPaymentSlipCancellationResponseV1MessageReader
return ::aEmpresaFil

/*/{Protheus.doc} TFMPPaymentSlipCancellation
    
    @type function
    @author squad.techfin 
    @since 02/10/2025
    @param cCompany, character, Identificador do Grupo Empresa
    @param cBranch, character, Identificador da Filial
    @param cIdDoc, character, Identificador do Documento
    @param cData, character, Dados estruturados em json com itens processados e inválidos
    @param cPayload, character, Payload completo da mensagem recebida do SmartLink
    @return logical, Retorna sempre verdadeiro para não gerar retry. Erros são registrados em log para análise posterior
/*/

function TFMPPaymentSlipCancellation(cCompany as character, cBranch as character,cIdDoc as character, cData as character, cPayload as character) as logical
    Local lRet         := .F.                as Logical
    Local cLog         := ""                 as Character
    Local cError       := ""                 as Character
    Local cErrorCode   := ""                 as Character
    Local cStatus      := ""                 as Character
    Local aLogs        := {}                 as Array
    Local aErros       := {}                 as Array
    Local aPaymentSlips:= {}                 as Array
    Local jData        := jsonObject():new() as json
    
    RPCSetType(3)
    RPCSetEnv(cCompany, cBranch,,,'FIN')

    Try
        Begin Transaction
            If setPositionByUUID("ARG", cIdDoc)
            	jData:fromjson(cData)
		
				cStatus       := jData["status"]
				aPaymentSlips := jData["paymentSlips"]
				
				processIdsDoc(aPaymentSlips, @aLogs, @aErros, cStatus)
				
				If len(aErros) > 0
					cLog  := formatLog(aErros)
					logSmartLink(cPayload, "ARG", /*cUUID*/, __cProdTF, "PaymentSlipCancellation", "T",,cLog)//cMessage, cAlias, cUUID, cProduct, cOperation, cOrigin, cIDReq, cLogNeg
				Else
                    lRet := vldStatusMaisPrazo(ARG->ARG_NUM)           
					If lRet .And. ARG->ARG_STATUS < cStatus
                        RecLock("ARG",.F.)
                            ARG->ARG_STATUS := cStatus
                        ARG->(MsUnLock())
                    EndIf
                    logSmartLink(cPayload, "ARG", /*cUUID*/, __cProdTF, "PaymentSlipCancellation", "T",,)//cMessage, cAlias, cUUID, cProduct, cOperation, cOrigin, cIDReq, cLogNeg
				EndIf
			EndIf
			
        End Transaction
	Catch oError 
        DisarmTransaction()
        cErrorCode := "catch"
        cError     := oError:Description
        
		aAdd(aErros, {"error", cErrorCode, cError})
        cLog  := formatLog(aErros)
        
		logSmartLink(cPayload, "", /*cUUID*/, __cProdTF, "PaymentSlipCancellation", "T",,cLog)//cMessage, cAlias, cUUID, cProduct, cOperation, cOrigin, cIDReq, cLogNeg
        FWFreeArray(aErros)
    EndTry

    RpcClearEnv()

    FWFreeArray(aLogs)
    FwFreeArray(aPaymentSlips)
    FwFreeObj(jData)
Return .T. //Retorno sempre verdadeiro para não gerar retry da mensagem. O tratamento de erros é feito via log para análise posterior.

/*/{Protheus.doc} processIdsDoc
    
    @type function
    @author squad.techfin
    @since 08/05/2026
    @param aDados, array, Array contendo objetos com chave 'paymentSlipId' a serem processados
    @param aLogs, array, Array de referência para armazenar registros processados com sucesso
    @param aErros, array, Array de referência para armazenar erros de processamento
    @param cStatus, character, Status a ser gravado no campo ARH_STATUS do registro encontrado
    @return Nil
/*/
static function processIdsDoc(aDados as Array,aLogs as Array,aErros as Array, cStatus as Character) 
    Local nTotal       := 0                          as Numeric
    Local nX           := 0                          as Numeric
    
    ARH->(DbSetOrder(2))//ARH_IDDOC, ARH_STATUS, R_E_C_N_O_, D_E_L_E_T_
    nTotal := Len(aDados)
    For nX := 1 To nTotal
        If ARH->(MsSeek(aDados[nX]["paymentSlipId"]))
			RecLock("ARH",.F.)
				ARH->ARH_STATUS := cStatus
			ARH->(MsUnlock())
            
	        aAdd(aLogs, aDados[nX])
        Else
            aAdd(aErros, {"error", aDados[nX]["paymentSlipId"], "ID de parcela inválido"})
        EndIf
    Next
 
Return

