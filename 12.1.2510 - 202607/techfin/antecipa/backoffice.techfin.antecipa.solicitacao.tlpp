#include "tlpp-core.th"
#Include "FwMVCDef.ch"
#Include "backoffice.techfin.antecipa.solicitacao.ch"

NAMESPACE totvs.protheus.backoffice.techfin.antecipa.solicitacao
Using namespace totvs.protheus.backoffice.ngf.util
Using namespace totvs.protheus.backoffice.techfin.util 

Static __oTitulos                       as object
Static __oTitulosNE                     as object
Static __oQryLimit                      as object
Static __oExecTbl1                      as object
Static __oQryParc                       as object
static __jSimulate                      as json
Static __cError           := ""         as character
Static __cJustific        := ""         as character
Static __lSimulate        := .F.        as logical
Static __cE1VALORPicture  := ""         as character
Static __jColumnsBrowse                 as json

/*/{Protheus.doc} antecipate
Totvs Antecipa
    @type       Function
    @author     Totvs
    @since      18/07/2025
    @version    P12.1.2510
/*/
Function antecipate()
    local nLin      := 0                      as numeric
    local nCol      := 0                      as numeric    
    local aCoors    := {}                     as array
    local aFields   := {}                     as array
    local aCpFiltro := {}                     as array
    local cAlias    := ""                     as character
    local cAliasNE  := ""                     as character
    local cFilBkp   := ""                     as character    
    local nTextW    := 0                      as numeric  
    local nLayerW   := 0                      as numeric  
    local lTssReady := .F.                    as logical
    local oFont18   := TFont():New(,,-18,,, ) as object
    local oDlg                                as object
    local oIofTac                             as object
    local oSayLimite                          as object
    local oSaySolicitado                      as object    
    local oSayCusto                           as object    
    local oSayReceber                         as object
    local oSayTaxa                            as object
    local oPanelVlrCusto                      as object
    local oLayer                              as object
    local oPanelLimite                        as object
    local oPanelVlrSolic                      as object
    local oPanelVlrReceber                    as object
    local oPanelTaxa                          as object
    local oPanelCusto                         as object
    local oPanelFolder                        as object
    local oTFolder                            as object
    local oBtnSimula                          as object
    local oSayConfirm                         as object 
    
    local bPergunte                           as codeblock
    Private oMrkAntecipa                      as Object
    Private oBrwNaoEleg                       as Object
    Private bUpdLimite                        as CodeBlock
    Private bUpdVlSol                         as CodeBlock
    Private bUpdValues                        as CodeBlock

    Private nCET             := 0                  as numeric
    Private nLimDispPar      := 0                  as numeric
    Private nLimUtilizadoPar := 0                  as numeric    
    Private cTextIof         := ""                 as character
    Private cCnpjParceiro    := ""                 as character
    Private cFilParceiro     := ""                 as character
    Private jLimites         := JsonObject():new() as json    

    //-----------------------------------------------------------------------------------
    //-- Verifica se TSS esta acessível
    If !(lTssReady := totvs.protheus.backoffice.techfin.util.TssIsReady())
        MessageTss()
    EndIf

    cFilBkp     := cFilAnt
    aCoors      := FWGetDialogSize(oMainWnd)
    oMrkAntecipa:= FWMarkBrowse():New()
    oBrwNaoEleg := FWMBrowse():New()
    __jSimulate := JsonObject():new()
    __cE1VALORPicture := PesqPict("SE1","E1_VALOR") 

    bUpdLimite := {|x,y,z| UpdCredit(@oSayLimite,@oIofTac,x,y,z)}     //-- Bloco de código de atualização do limite de crédito e taxas de negociação
    bUpdVlSol  := {|x| UpdVlSol(@oSaySolicitado, x)}  //-- Bloco de código de atualização do Valor Solicitado
    bUpdValues := {|x,y,z,w| UpdValues(@oSayCusto, @oSayReceber, @oSayTaxa, x, y, z, w)}
    bPergunte  := {|| If(Pergunte('TFIN001',.T.),;
                    (FWMsgRun(, {|| ( reloadAll(), loadReceivable(aFields,@cAlias,@cAliasNE))}, '', STR0002),; //'Carregando títulos elegíveis para Antecipação...'
                    oMrkAntecipa:Refresh(.T.),oBrwNaoEleg:Refresh(.T.)),Nil)}

    aFields   := {"E1_FILIAL", "E1_PREFIXO", "E1_NUM", "E1_PARCELA", "E1_TIPO", "E1_CLIENTE", "E1_LOJA", "E1_NOMCLI", "E1_VALOR", "E1_SALDO", "E1_EMISSAO", "E1_VENCREA", "E1_HIST"}
    
    AAdd(aCpFiltro, {"E1_PREFIXO" ,"Prefixo"   , "C", TamSX3("E1_PREFIXO")[1], TamSX3("E1_PREFIXO")[2], X3PICTURE("E1_PREFIXO")})
    AAdd(aCpFiltro, {"E1_NUM"     ,"Numero"    , "C", TamSX3("E1_NUM")[1]    , TamSX3("E1_NUM")[2]    , X3PICTURE("E1_NUM")})
    AAdd(aCpFiltro, {"E1_CLIENTE" ,"Cliente"   , "C", TamSX3("E1_CLIENTE")[1], TamSX3("E1_CLIENTE")[2], X3PICTURE("E1_CLIENTE")})
    AAdd(aCpFiltro, {"E1_VENCREA" ,"Vencimento", "D", TamSX3("E1_VENCREA")[1], TamSX3("E1_VENCREA")[2], X3PICTURE("E1_VENCREA")})

    //-- Carrega dados          
   If Pergunte("TFIN001", .T.)

        FWMsgRun(, {|| (reloadAll(), loadReceivable(aFields, @cAlias, @cAliasNE))}, "", STR0002)       //"Carregando títulos elegíveis para Antecipação..."

        DEFINE MSDIALOG oDlg FROM aCoors[1],aCoors[2] TO aCoors[3],aCoors[4] of oMainWnd PIXEL TITLE STR0003 //"Títulos disponíveis para Antecipar"

        oLayer := FWLayer():new()
        oLayer:Init(oDlg,.F.)

        oLayer:AddLine("LIN1", 18, .F.)
        oLayer:addCollumn("COL1", 18, .T., "LIN1")
        oLayer:addCollumn("COL2", 18, .T., "LIN1")
        oLayer:addCollumn("COL3", 18, .T., "LIN1")
        oLayer:addCollumn("COL4", 18, .T., "LIN1")
        oLayer:addCollumn("COL5", 18, .T., "LIN1")
        oLayer:addCollumn("COL6", 10, .T., "LIN1")

        oLayer:AddWindow("COL1", "Win1", STR0004 ,100, .F., .T., /*bClickTitle*/, "LIN1")  //Limite
        oLayer:AddWindow("COL2", "Win1", STR0005 ,100, .F., .T., /*bClickTitle*/, "LIN1")  //Valor Solicitado
        oLayer:AddWindow("COL3", "Win1", STR0006 ,100, .F., .T., /*bClickTitle*/, "LIN1")  //Custo Antecipação
        oLayer:AddWindow("COL4", "Win1", STR0007 ,100, .F., .T., /*bClickTitle*/, "LIN1")  //Valor a Receber
        oLayer:AddWindow("COL5", "Win1", STR0008 ,100, .F., .T., /*bClickTitle*/, "LIN1")  //Taxa de Antecipação
        
        //-- Objetos das janelas
        oPanelLimite    := oLayer:GetWinPanel("COL1","Win1","LIN1")
        oPanelLimite:FreeChildren()
        oPanelVlrSolic  := oLayer:GetWinPanel("COL2","Win1","LIN1")
        oPanelVlrSolic:FreeChildren()
        oPanelVlrCusto  := oLayer:GetWinPanel("COL3","Win1","LIN1")
        oPanelVlrCusto:FreeChildren()
        oPanelVlrReceber:= oLayer:GetWinPanel("COL4","Win1","LIN1")
        oPanelVlrReceber:FreeChildren()
        oPanelTaxa      := oLayer:GetWinPanel("COL5","Win1","LIN1")
        oPanelTaxa:FreeChildren()
        oPanelCusto     := oLayer:getColPanel('COL6','LIN1')
        oPanelCusto:FreeChildren()

        oLayer:AddLine('LIN2',4,.F.)
        oLayer:addCollumn('COL1',100, .T. ,'LIN2')
                        
        nTextW   := GetTextWidth(0,cTextIof)
        nLayerW  := oLayer:getLayerWidth()/2
        oIofTac  := TSay():New(1,nLayerW-nTextW+100,{|| cTextIof },oLayer:getColPanel('COL1','LIN2'),,,,,,.T.) // Mensagem de IOF e TAC
        
        nLin:=oPanelLimite:nHeight/6 //Altura das janelas superiores 
        nCol:=oPanelLimite:nWidth/10 //Largura        
        //-- Camada do Folder
        oLayer:AddLine("LIN3",68,.F.)
        oLayer:addCollumn("COL1",100, .F. ,"LIN3")
        oLayer:AddWindow("COL1","Win1",STR0036,100,.F.,.T.,,"LIN3") //Titulos

        oPanelFolder   := oLayer:GetWinPanel("COL1","Win1","LIN3")
        oPanelFolder:FreeChildren()

        oTFolder := TFolder():New( 0, 0, {STR0037 /*"Títulos elegíveis"*/,STR0038 /*"Títulos não elegíveis"*/}, {STR0037 /*"Títulos elegíveis"*/,STR0038 /*"Títulos não elegíveis"*/}, oPanelFolder,,,,,, 1, 1 )
        oTFolder:Align := CONTROL_ALIGN_ALLCLIENT
        oTFolder:SetOption( 1 )

        //--------------------------------------------------------------------------------------------
        // Cards superiores
        //-- Limite    
        oSayLimite          := TSay():New( nLin, 5,{||""},oPanelLimite,,oFont18,.F.,.F.,.F.,.T.,,,100,020)    
        //-- Valor Solicitado    
        oSaySolicitado      := TSay():New( nLin, 5,{|| "R$ 0.00"},oPanelVlrSolic,,oFont18,.F.,.F.,.F.,.T.,,,100,020)         
        //-- Custo    
        oSayCusto           := TSay():New( nLin, 5,{|| "R$ "+Transform(0, __cE1VALORPicture)},oPanelVlrCusto,,oFont18,.F.,.F.,.F.,.T.,,,100,020)        
        //Valor a Receber
        oSayReceber         := TSay():New( nLin, 5,{|| "R$ 0.00"},oPanelVlrReceber,,oFont18,.F.,.F.,.F.,.T.,,,100,020)
        //Taxa de Antecipação
        oSayTaxa            := TSay():New( nLin, 5,{|| "0%"},oPanelTaxa,,oFont18,.F.,.F.,.F.,.T.,,,100,020)
        //Botão Simular
        oBtnSimula          := tButton():New(nLin+10, 3, STR0009, oPanelCusto, {|| FWMsgRun(, {|| GetCosts(cAlias)}, '', STR0012) },60,15,,,,.T.)//"Estamos processando sua simulação junto a Totvs Techfin. Isso pode levar alguns isntantes..."
        
        If __jColumnsBrowse == NIL
            __jColumnsBrowse := createColumnsBrowse(aFields, "SE1")
        Endif
        
        //-------------------------------------------------------------------------------------------
        //-- Markbrowse        
        oMrkAntecipa:SetFieldMark("MARK")
        oMrkAntecipa:SetMark( "X", cAlias, "MARK" )
        oMrkAntecipa:bMark    := {|| AntUpdMark( cAlias, oMrkAntecipa:Mark())}
        oMrkAntecipa:bValid   := {|| AntVldMark( cAlias, oMrkAntecipa:Mark())}
        oMrkAntecipa:bAllMark := {|| }
        oMrkAntecipa:SetOwner(oTFolder:aDialogs[1])
        oMrkAntecipa:SetAlias(cAlias)
        oMrkAntecipa:SetDescription(STR0014) // "Títulos disponíveis para Antecipação."
        oMrkAntecipa:SetColumns(AClone(__jColumnsBrowse["columns"]))
        oMrkAntecipa:SetMenuDef("")
        oMrkAntecipa:SetTemporary(.T.)
        oMrkAntecipa:SetUseFilter(.T.)
        oMrkAntecipa:SetFieldFilter(aCpFiltro)
        oMrkAntecipa:AddButton(STR0039,{|| If(Pergunte('TFIN001',.T.),;
                                                    (FWMsgRun(, {|| (reloadAll(), loadReceivable(aFields,@cAlias,@cAliasNE))}, '', STR0002),; //Carregando títulos elegíveis para Antecipação...
                                                    oMrkAntecipa:Refresh(.T.),oBrwNaoEleg:Refresh(.T.)),Nil)},,,, .F., 2 )
        oMrkAntecipa:DisableReport("")
        oMrkAntecipa:DisableConfig()
        oMrkAntecipa:Activate()

        oBrwNaoEleg:SetOwner(oTFolder:aDialogs[2])
        oBrwNaoEleg:SetAlias(cAliasNE)
        oBrwNaoEleg:SetDescription(STR0015) // "Títulos indisponíveis para Antecipação"
        oBrwNaoEleg:SetFields(AClone(__jColumnsBrowse["fields"]))
        oBrwNaoEleg:SetMenuDef("")
        oBrwNaoEleg:SetTemporary(.T.)
        oBrwNaoEleg:SetUseFilter(.T.)
        oBrwNaoEleg:SetFieldFilter(aCpFiltro)
        oBrwNaoEleg:AddButton(STR0039,{|| If(Pergunte('TFIN001',.T.),;
                    (FWMsgRun(, {|| (reloadAll(), loadReceivable(aFields, @cAlias, @cAliasNE))}, '', STR0002),; //Carregando títulos elegíveis para Antecipação...
                    oMrkAntecipa:Refresh(.T.),oBrwNaoEleg:Refresh(.T.)),Nil)},,,, .F., 2 )
        oBrwNaoEleg:DisableReport("")
        oBrwNaoEleg:DisableConfig()
        oBrwNaoEleg:DisableDetails()
        oBrwNaoEleg:Activate(oTFolder:aDialogs[2])
        oBrwNaoEleg:bLDblClick := {|| Validate(cAliasNE)}

        ACTIVATE MSDIALOG oDlg CENTERED on init (;
            LoadValues(),;
            EnchoiceBar(oDlg,;
                        {|| FWMsgRun(, {|oSayConfirm,x,y,z,w,q,p| if(sendSolic(oSayConfirm,cAlias, lTssReady, oSaySolicitado, oSayCusto, oSayReceber, oSayTaxa), oDlg:End(), .T.) }, "",  STR0001)},; // Processando solicitação...
                        {|| oDlg:End()}))

    EndIF

    If ValType(__oExecTbl1) <> "U" .And. !(__oExecTbl1 == Nil)
        cAlias := __oExecTbl1:OpenAlias()
        (cAlias)->(DbCloseArea())
        __oExecTbl1:Destroy()
        __oExecTbl1 := Nil
    EndIF
    If ValType(__oQryParc) <> "U" .And. !(__oQryParc == Nil)
        cAlias := __oQryParc:OpenAlias()
        (cAlias)->(DbCloseArea())
        __oQryParc:Destroy()
        __oQryParc := Nil        
    EndIf
        
    cFilAnt     := cFilBkp    
    FWSM0Util():setSM0PositionBycFilAnt()
    FwFreeArray(aFields)
    FwFreeArray(aCpFiltro)
    FwFreeArray(aCoors)
    FwFreeObj(oDlg)
    FwFreeObj(jLimites)

Return

/*/{Protheus.doc} Validate
    Função chamada no duplo clique do browse de não elegíveis para exibir a descrição do erro
    @type function
    @author Squad Techfin
    @since 18/09/2025
    @param oBrw, object, browse de não elegíveis
*/
static Function Validate(cAlias as character)
    local oModal as object
    
    oModal:=totvs.protheus.backoffice.techfin.util.TechfinDialog():new()

    oModal:setTitle(STR0020) //"Motivo da Não Elegibilidade"
    oModal:setScrollArea(.T.)
    oModal:setText(10, 10, STR0021) // "Essa consulta apresenta a situação atual do titulo, podendo ser alterada a qualquer momento devido as condições de limite disponíveis ou regras de elegibilidade"
    oModal:setText(30, 10, STR0022 + ' ' + (cAlias)->E1_NUM ) //"Situação do Título "
    oModal:setText(50, 10, (cAlias)->ARBDESC)
    oModal:setButton(STR0023, {|| oModal:DeActivate() }) //"Ok, entendi"
    oModal:openInfo(150, 250)
Return

/*/{Protheus.doc} loadReceivable
    Carrega títulos a receber conforme parâmetros do usuário e conforme Parâmetros de Elegibilidade da Techfin
    @type function
    @author Squad Techfin
    @since 9/9/2025
    @param aFieldsBRW, array, campos utilizados no browse
    @param cAlias    , character, alias tabela elegiveis
    @param cAliasNE  , character, alias tabela nao elegivei
/*/
function loadReceivable(aFieldsBRW as Array, cAlias as Character, cAliasNE as Character)

    local cAls       := ""                  as character
    local cArqTrab   := ""                  as character
    local cArqTrabNE := ""                  as character
    local nX         := 0                   as numeric
    local aCampos    := {}                  as array
    local aFields    := {}                  as array
    local aFieldsQRY := {}                  as array
    local aRules     := {}                  as array
    local lError     := .F.                 as logical
    local cFields    := ""                  as character
    local aAreaSE1   := SE1->(FwGetArea())  as array
	local aAreaSA1   := SA1->(FwGetArea())  as array
    local aAreaSF2   := SF2->(FwGetArea())  as array
    local nBindParam := 1                   as numeric
    local cMotivoNE  := ""                  as character
    local aIndex     := {}                  as array
    local cArqReclock := ""                 as character
    local aTipos      := {}                 as array
    local cType       := ""                 as character
    local cQuery      := ""                 as character
    local nSaldoAtu    := 0                 as numeric

    Aadd(aCampos, {"MARK", "C" ,1, 0})
    Aadd(aCampos, {"ARBDESC", "C", 100, 0}) 

    for nX:=1 to Len(aFieldsBRW)
        Aadd(aCampos, {aFieldsBRW[nX], FWSX3Util():GetFieldType(aFieldsBRW[nX]), TamSx3(aFieldsBRW[nX])[1], TamSx3(aFieldsBRW[nX])[2]})
        Aadd(aFields, aFieldsBRW[nX])
    next nX     
    // adiciona campos utilizados somente na consulta
    aFieldsQRY := {"A1_CGC", "A1_COD", "A1_LOJA", "F2_CHVNFE", "F2_EMISSAO", "E1_FILORIG", "F2_DOC", "F2_SERIE", "E1_MOEDA", "E1_DESCFIN", "E1_SDACRES", "E1_SDDECRE"}
    for nX:=1 to Len(aFieldsQRY)
        Aadd(aCampos, {aFieldsQRY[nX], FWSX3Util():GetFieldType(aFieldsQRY[nX]), TamSx3(aFieldsQRY[nX])[1], TamSx3(aFieldsQRY[nX])[2]})
        Aadd(aFields, aFieldsQRY[nX])
    next nX 
    cFields := ArrToKStr(aFields, ",")

    Aadd(aIndex, {"E1_FILIAL","E1_CLIENTE","E1_LOJA"})
    Aadd(aIndex, {"E1_FILIAL","E1_VENCREA"})
    Aadd(aIndex, {"E1_FILIAL","E1_EMISSAO"})
    Aadd(aIndex, {"E1_FILIAL","E1_PREFIXO","E1_NUM"})

    createTemporaryTable(@__oTitulos, aCampos, aIndex)
    cArqTrab := __oTitulos:GetAlias()

    createTemporaryTable(@__oTitulosNE, aCampos, aIndex)
    cArqTrabNE := __oTitulosNE:GetAlias()

    if __oExecTbl1 == Nil
        cQuery := " SELECT " + cFields
        cQuery += " ,SE1.R_E_C_N_O_ AS SE1_RECNO , SA1.R_E_C_N_O_ AS SA1_RECNO , SF2.R_E_C_N_O_ AS SF2_RECNO , SF3.R_E_C_N_O_ AS SF3_RECNO "
        
        cQuery += " FROM " + RetSqlName("SE1") + " SE1"

        cQuery += " JOIN " + RetSqlName("SF2") + " SF2 ON"
        cQuery += " SF2.F2_FILIAL = ?"
        cQuery += " AND SF2.F2_DOC = SE1.E1_NUM"
        cQuery += " AND SF2.F2_SERIE = SE1.E1_SERIE"
        cQuery += " AND SF2.F2_CLIENTE = SE1.E1_CLIENTE"
        cQuery += " AND SF2.F2_LOJA = SE1.E1_LOJA"
        cQuery += " AND SF2.F2_PREFIXO = SE1.E1_PREFIXO"
        cQuery += " AND SF2.D_E_L_E_T_ = ?"

        cQuery += " JOIN " + RetSqlName("SF3") + " SF3 ON "
        cQuery += " SF3.F3_FILIAL = SF2.F2_FILIAL"
        cQuery += " AND SF3.F3_NFISCAL = SF2.F2_DOC"
        cQuery += " AND SF3.F3_SERIE = SF2.F2_SERIE"
        cQuery += " AND SF3.F3_CLIEFOR = SF2.F2_CLIENTE"
        cQuery += " AND SF3.F3_LOJA = SF2.F2_LOJA"
        cQuery += " AND SF3.D_E_L_E_T_ = ?"

        cQuery += " JOIN " + RetSqlName("SA1") + " SA1 ON "                
        cQuery += " SA1.A1_FILIAL = ?"
        cQuery += " AND SA1.A1_COD = SE1.E1_CLIENTE"
        cQuery += " AND SA1.A1_LOJA = SE1.E1_LOJA"
        cQuery += " AND SA1.D_E_L_E_T_ = ?"

        cQuery += " WHERE "
        cQuery += " SE1.E1_FILORIG = ? "
        cQuery += " AND SE1.E1_CLIENTE >= ? "
        cQuery += " AND SE1.E1_CLIENTE <= ? "
        cQuery += " AND SE1.E1_VENCREA >= ? "
        cQuery += " AND SE1.E1_VENCREA <= ? "
        cQuery += " AND SE1.E1_SALDO > ? "
        cQuery += " AND SE1.E1_TIPO NOT IN (?) "
        cQuery += " AND SE1.E1_SITUACA = ? "//em carteira
        cQuery += " AND SE1.E1_ORIGEM = ? "//Origem Nota de Saída
        cQuery += " AND SE1.D_E_L_E_T_= ? "
        cQuery += " AND SA1.A1_CGC <> ? " // Desconsiderar A1_CGC vazio
        cQuery += " AND SF3.F3_CODRSEF IN (?) " // Apenas NF-e autorizadas
        cQuery += " AND SF3.F3_CHVNFE <>  ? " // Chave da NF-e não vazia
        cQuery += " AND SF3.F3_IDENTFT = ?" // Identificador SFT

        cQuery += " AND NOT EXISTS (SELECT 1 FROM " + RetSqlName("ARE") + " ARE "
        cQuery += " WHERE ARE.ARE_FILTIT = SE1.E1_FILORIG "
		cQuery += " AND ARE.ARE_PREFIX = SE1.E1_PREFIXO "
        cQuery += " AND ARE.ARE_NUMTIT = SE1.E1_NUM "
        cQuery += " AND ARE.ARE_PARTIT = SE1.E1_PARCELA "
        cQuery += " AND ARE.ARE_TIPTIT = SE1.E1_TIPO "
        cQuery += " AND ARE.ARE_CLITIT = SE1.E1_CLIENTE "
        cQuery += " AND ARE.ARE_LOJTIT = SE1.E1_LOJA "
        cQuery += " AND ARE.D_E_L_E_T_ = ? "
        cQuery += " AND ARE.ARE_STATUS IN (?)) " // Usando binds para status
       __oExecTbl1 := FwExecStatement():New(cQuery)
    endIf

     aTipos      := StrTokArr2(MVABATIM + "|" + MV_CRNEG + "|" + MVPROVIS + "|" + MVRECANT + "|" + MV_CPNEG + "|" + MVTAXA + "|" + MVTXA + "|" + MVINSS + "|", "|")
    __oExecTbl1:SetString(nBindParam++, FwxFilial("SF2", cFilParceiro)) //F2_FILIAL
    __oExecTbl1:SetString(nBindParam++, " ")                            //D_E_L_E_T_
    __oExecTbl1:SetString(nBindParam++, " ")                            //D_E_L_E_T_
    __oExecTbl1:SetString(nBindParam++, FwxFilial("SA1", cFilParceiro)) //A1_FILIAL
    __oExecTbl1:SetString(nBindParam++, " ")                            //D_E_L_E_T_
    __oExecTbl1:SetString(nBindParam++, cFilParceiro)                   //E1_FILORIG
    __oExecTbl1:SetString(nBindParam++, MV_PAR02)                       //E1_CLIENTE de
    __oExecTbl1:SetString(nBindParam++, MV_PAR03)                       //E1_CLIENTE ate
    __oExecTbl1:SetDate(nBindParam++, MV_PAR04)                         //vencimento de
    __oExecTbl1:SetDate(nBindParam++, MV_PAR05)                         //vencimento ate
    __oExecTbl1:SetNumeric(nBindParam++, 0)                             //E1_SALDO
    __oExecTbl1:SetIn(nBindParam++, aTipos)                             //E1_TIPO
    __oExecTbl1:SetString(nBindParam++, "0")                            //E1_SITUACA
    __oExecTbl1:SetString(nBindParam++, "MATA460")                      //E1_ORIGEM
    __oExecTbl1:SetString(nBindParam++, " ")                            //D_E_L_E_T_
    __oExecTbl1:SetString(nBindParam++, " ")                            //A1_CGC    
    __oExecTbl1:SetIn(nBindParam++, {"100", "124", "150"})              //F3_CODRSEF
    __oExecTbl1:SetString(nBindParam++, " ")                            //F3_CHVNFE
    __oExecTbl1:SetString(nBindParam++, StrZero(1,TamSX3("F3_IDENTFT")[1]))//F3_IDENTFT
    __oExecTbl1:SetString(nBindParam++, " ")                            //ARE.D_E_L_E_T_
    __oExecTbl1:SetIn(nBindParam++, {"0", "1"})                         //ARE_STATUS
    cAls := __oExecTbl1:OpenAlias()

    (cArqTrab)->(dbSetOrder(MV_PAR06))
    (cArqTrabNE)->(dbSetOrder(MV_PAR06))

    for nX := 1 to Len(aCampos)
        cType := aCampos[nX][2]
        if cType <> "C" 
            TcSetField(cAls, aCampos[nX][1], cType, aCampos[nX][3], aCampos[nX][4])
        endIf
    next nX

    aRules := totvs.protheus.backoffice.techfin.util.loadEligibilityRules("1",cCnpjParceiro)

    While (cAls)->(!Eof()) .And. !lError
        SE1->(dbGoTo((cAls)->SE1_RECNO))
        SA1->(dbGoTo((cAls)->SA1_RECNO))
        SF2->(dbGoTo((cAls)->SF2_RECNO))

        cMotivoNE := totvs.protheus.backoffice.techfin.util.execEligibilityRules(aRules)

        cArqReclock := cArqTrab

        If !Empty(cMotivoNE)
            cArqReclock := cArqTrabNE
        Endif

        nSaldoAtu := totvs.protheus.backoffice.techfin.util.CalcSaldoAtual(cAls)
        RecLock(cArqReclock, .T.)
            (cArqReclock)->MARK:=" "
            For nX:=1 to Len(aFields)
                (cArqReclock)->&(aFields[nX]):=(cAls)->&(aFields[nX])

                If aFields[nX] == "E1_NOMCLI"
                    (cArqReclock)->&(aFields[nX]) := GetLGPDValue("SE1", aFields[nX])
                Endif
            Next nX
            (cArqReclock)->ARBDESC := cMotivoNE
            (cArqReclock)->E1_SALDO := nSaldoAtu

        (cArqReclock)->(msUnLock())

        (cAls)->(dbSkip())
    EndDo

    (cAls)->(dbCloseArea())

    cAlias   := cArqTrab
    cAliasNE := cArqTrabNE

    FwRestArea(aAreaSE1)
    FwRestArea(aAreaSA1)
    FwRestArea(aAreaSF2)

    FwFreeArray(aCampos)
    FwFreeArray(aFields)
    FwFreeArray(aFieldsQRY)
    FwFreeArray(aRules)
    FwFreeArray(aAreaSE1)
    FwFreeArray(aAreaSA1)
    FwFreeArray(aAreaSF2)

Return

/*/{Protheus.doc} reloadAll
    recarregas as informações default
    @type function
    @author Squad Techfin
    @since 9/9/2025
/*/
Static Function reloadAll()
    local nIOF              := 0 as numeric
    local nTAC              := 0 as numeric
    local nLimiteParceiro   := 0 as numeric
    local aDataParceiro     := {} as array

    // armazena a o cnpj da filial selecionada
    cFilParceiro := MV_PAR01
    Try
        cCnpjParceiro := FWSM0Util():GetSM0Data( cEmpAnt , cFilParceiro, {"M0_CGC"})[1][2]
        cFilAnt       := MV_PAR01
        FWSM0Util():setSM0PositionBycFilAnt()
    Catch oError
        cCnpjParceiro := ""
    EndTry
    // Limite parceiro
    nLimUtilizadoPar := 0
    aDataParceiro    := getLimiteParceiro(cFilParceiro)
    nLimiteParceiro  := aDataParceiro[1] // Limite do parceiro
    nIOF             := aDataParceiro[2] // IOF
    nTAC             := aDataParceiro[3] // TAC
    Eval(bUpdLimite, nLimiteParceiro, nIOF, nTAC)
    // limpa os limites utilizados
    jLimites := JsonObject():new()
    // limpa 
    Eval(bUpdValues, 0, 0, 0, .F.)
return

/*/{Protheus.doc} UpdCredit
    Atualizar o limite de crédito do parceiro
    @type function
    @author Squad Techfin
    @since 9/4/2025
    @param oObjLim, object, obj que contém o limite do parceiro
    @param oIofTac, object, obj que contém dados de IOF e TAC
    @param nLimite, numeric, limite do parceiro
    @param nIOF   , numeric, valor do IOF para o parceiro 
    @param nTAC   , numeric, valor da TAC para o parceiro 
/*/
Static Function UpdCredit(oObjLim as object, oIofTac as object, nLimite as numeric, nIOF as numeric, nTAC as numeric)
    
    nLimDispPar := nLimite    
    If oObjLim<>Nil
        oObjLim:SetText("R$ "+Transform(nLimDispPar, __cE1VALORPicture))
        oObjLim:CtrlRefresh()
    EndIf

    cTextIof := 'IOF: '
    cTextIof += Transform(nIOF,'@E 99.99 %')
    cTextIof += STR0030//" | Tarifa de abertura de crédito: "
    cTextIof += Transform(nTAC,'@E 99.99 %')
    If oIofTac<>Nil
        oIofTac:SetText( cTextIof )
        oIofTac:CtrlRefresh()
    EndIf

Return

/*/{Protheus.doc} UpdVlSol
    Bloco de codigo de atualização do Valor Solicitado
    @type function
    @version  
    @author Squad Techfin
    @since 9/9/2025
    @param oObj    , object , objeto tSay
    @param nValor  , numeric, valor
/*/
Static Function UpdVlSol(oObj as object, nValor as numeric)

    if oObj<>Nil
        oObj:SetText("R$ "+ Transform(nValor, __cE1VALORPicture))
        oObj:CtrlRefresh()
    endIf

Return

/*/{Protheus.doc} LoadValues
    Função executada na inicialização da dialog principal
    @type       Function
    @author     Totvs
    @since      18/07/2025
    @version    P12.1.2510
    @param      
    @return     
/*/
Static Function LoadValues()
    reloadAll()
Return

/*/{Protheus.doc} AntVldMark
    Verificar se o registro pode ser marcado
    @type function
    @author Squad Techfin
    @since 9/9/2025
    @param cAliasMark, character, alias da tabela
    @param cMark, character, mark utilizado para marcação
    @return logical, true se pode ser marcado
/*/
Static Function AntVldMark(cAliasMark as character, cMark as character) as logical
    local nValor := (cAliasMark)->E1_SALDO      as numeric
    local lRet   := .T.                        as logical
    // verificação se não estiver marcando
    if (cAliasMark)->MARK <> cMark
        if nLimDispPar < (nLimUtilizadoPar + nValor)
            Help( ,,"LIMITEPARCEIRO",, STR0016, 1, 0 ) //"Você excedeu seu limite disponível para antecipação."          
            lRet := .F.
        endif
        if lRet .and. !verLimiteSacado((cAliasMark)->A1_CGC, (cAliasMark)->A1_COD,(cAliasMark)->A1_LOJA, nValor, .T., .F.)
            lRet := .F.
        endIf
    endIf
Return lRet

/*/{Protheus.doc} AntUpdMark
    Atualizações após a marcação
    @type function
    @author Squad Techfin
    @since 9/5/2025
    @param cAliasMark, character, alias
    @param cMark, character, mark da tabela
/*/
Static Function AntUpdMark(cAliasMark as character, cMark as character)
    local lAdd   := cMark == (cAliasMark)->MARK as logical 
    local nValor := (cAliasMark)->E1_SALDO      as numeric

    if lAdd
        nLimUtilizadoPar += nValor
    else
        nLimUtilizadoPar -= nValor
    endIf

    verLimiteSacado((cAliasMark)->A1_CGC, (cAliasMark)->A1_COD,(cAliasMark)->A1_LOJA, nValor, lAdd, .T. )
    Eval(bUpdVlSol, nLimUtilizadoPar)
    Eval(bUpdValues, 0, 0, 0, .F.) // remove a simulação
Return

/*/{Protheus.doc} updValues
    Atualizar os valors dos card
    @type function
    @author Squad Techfin
    @since 8/21/2025
    @param oCusto, object, tSay do custo
    @param oReceber, object, tSay do valor a receber
    @param oTaxa, object, tSay da taxa
    @param nCusto, numeric, valor do custo
    @param nReceber, numeric, valor a receber
    @param nTaxa, numeric, valor da taxa
/*/
Function updValues(oCusto as object, oReceber as object, oTaxa as object, nCusto as numeric, nReceber as numeric, nTaxa as numeric, lSimulate as logical)
    Default oCusto := Nil
    Default oReceber := Nil
    Default oTaxa := Nil
    Default nCusto := 0
    Default nReceber := 0
    Default nTaxa := 0
    Default lSimulate := .T.

    if lSimulate
        __lSimulate := .T.
        __jSimulate["cost"] := nCusto
        __jSimulate["rate"] := nTaxa
    else
        __lSimulate := .F.
        __jSimulate["cost"] := 0
        __jSimulate["rate"] := 0
    endIf
    if oCusto <> nil
        oCusto:SetText("R$ "+Transform(nCusto, __cE1VALORPicture))
        oCusto:CtrlRefresh()
    endIf
    if oReceber <> nil
        oReceber:SetText("R$ "+Transform(nReceber, __cE1VALORPicture))
        oReceber:CtrlRefresh()
    endIf
    if oTaxa <> nil
        oTaxa:SetText(cVAlToChar(nTaxa) + "%")
        oTaxa:CtrlRefresh()
    endIf
return

/*/{Protheus.doc} getCosts
    Botão Simulação - Envia a simulação para obter os valores
    @type function
    @author Squad Techfin
    @since 8/21/2025
    @param cAliasMark, character, alias com os títulos
/*/
Function getCosts(cAliasMark as character, lSimulate as logical)
    local lRet       := .F.                                      as logical
    local cFila      := "AntecipaCalculationSimulateRequestV1"   as character
    local cFilaResp  := "AntecipaCalculationSimulateResponseV1"  as character
    local nRec       := (cAliasMark)->(Recno())                  as numeric
    local cResponse  := ""                                       as character
    local jData      := JsonObject():new()                       as json
    local jSimulate  := JsonObject():new()                       as json
    local nReceber   := 0                                        as numeric
    local nTaxa      := 0                                        as numeric
    local nCusto     := 0                                        as numeric
    local oSmartUtil := totvs.protheus.backoffice.techfin.util.SmartlinkUtil():new() as object
    Default lSimulate := .T.
    
    // zera os valores da simulacao
    Eval(bUpdValues, 0, 0, 0, .F.)

    jData := prepareMessage( lSimulate, cAliasMark, "X")

    if len(jData["installments"]) > 0
        cResponse := oSmartUtil:sendAndAwaitResponse(cFila, cFilaResp, jData:toJson(), .T.)
    Else
        Help( ,,"SEMTITULOS",, STR0025, 1, 0 ) //'Selecione ao menos um título para solicitar a Antecipação.'
    endIf

    if !Empty(cResponse)
        jSimulate:FromJson(cResponse)
        If jSimulate:hasProperty("data")
            if jSimulate["data"]["status"] <> 1 // 0=erro;1=Sucesso
                Help( ,,"SimulateErro",, jSimulate["data"]["message"], 1, 0 )
            else
                nReceber := jSimulate["data"]["processingData"]["netAmountToReceive"]
                nCusto   := jSimulate["data"]["processingData"]["estimatedAdvanceCost"]
                nTaxa    := jSimulate["data"]["processingData"]["advanceRate"]
                nCET     := jSimulate["data"]["processingData"]["totalEffectiveCostRate"] //Custo efetivo total para a mensagem de confirmação final.
                Eval(bUpdValues, nCusto, nReceber, nTaxa, .T.)
                lRet := .T.
            endIf
        EndIf
    endif

    (cAliasMark)->(dbGoTo(nRec))

    FwFreeObj(oSmartUtil)
    FwFreeObj(jData)
    FwFreeObj(jSimulate)
return lRet

/*/{Protheus.doc} sendSolic
    botão salvar, envia a solicitação e grava as tabelas ARD e ARE
    @type function
    @author Squad Techfin
    @since 8/26/2025
    @param cAliasMark    , character, alias dos títulos
    @param lTssReady     , logical  , indica se o tss está ativo no ambiente
    @param oSaySolicitado, object, valor solicitado
    @param oSayCusto     ,  object, custo da operação
    @param oSayReceber   ,  object, valor a receber
    @param oSayTaxa      , object, taxa de antecipação
    @return lRet         , logical, indica se teve sucesso
/*/
function sendSolic(oSayConfirm as object,cAliasMark as character, lTssReady as logical, oSaySolicitado as object, oSayCusto as object, oSayReceber as object, oSayTaxa as object) as logical
    local jData           := JsonObject():new()                          as json
    local jLimitGrant     := JsonObject():new()                          as json
    local cNumSolicitacao := ""                                          as character
    local cItem           := ""                                          as character
    local nTitulo         := 0                                           as numeric
    local nQtdTit         := 0                                           as numeric
    local nTotalSol       := 0                                           as numeric
    local nTamItem        := TamSX3("ARE_ITEM")[1]                       as numeric
    local aChaveTitulo    := {}                                          as array
    local lRet            := .F.                                         as logical
    local lProcessa       := .T.                                         as logical
    local oModal                                                         as object
    local oModalFim                                                      as object
	local oModel                                                         as object
    local oModelARD                                                      as object
    local oModelARE                                                      as object

    __cJustific := ""
    if !lTssReady
        MessageTss()        
        lProcessa := .F.
    endIf

    if lProcessa .And. !__lSimulate // Ainda não houve simulação, então pega os valores para a tela de confirmação        
        oSayConfirm:SetText(STR0012) // "Estamos processando sua simulação junto a Totvs Techfin. Isso pode levar alguns isntantes..."
        ProcessMessages()                 
        If !GetCosts(cAliasMark)
            lProcessa := .F.
        EndIf 
    EndIF
    
    If lProcessa
        oSayConfirm:SetText(STR0001) //Processando solicitação
        ProcessMessages() 
        oModal := totvs.protheus.backoffice.techfin.util.TechfinDialog():new()
        oModal:setTitle(STR0018)
        oModal:setDisableCancel(.T.)
        oModal:setText(20, 10, "<b>" + STR0005 + "</b>") //Valor Solicitado
        oModal:setText(30, 10, oSaySolicitado:GetText()) 
        oModal:setText(20, 120, "<b>" + STR0006 + "</b>") //Custo Antecipação
        oModal:setText(30, 120, oSayCusto:GetText()) 
        oModal:setText(50, 10, "<b>" + STR0007 + "</b>") //Valor a Receber
        oModal:setText(60, 10, oSayReceber:GetText()) 
        oModal:setText(50, 120, "<b>" + STR0008 + "</b>") //Taxa de Antecipação
        oModal:setText(60, 120, oSayTaxa:GetText()) 
        oModal:setText(80, 10, "<b>" + STR0029 + "</b>") //Custo efetivo total (% a.m)
        oModal:setText(90, 10, Transform(nCET,'@E 99.99 %')) 
        oModal:setText(120,10, "<b>" + " * " + cTextIof + "</b>") //IOF e TAC
        oModal:setButton(STR0034, {|| oModal:DeActivate() })  //Cancelar 
        oModal:setButton(STR0035, {|| totvs.protheus.backoffice.techfin.antecipa.solicitacao.justificationInput() }) //Justificar Solicitação

        If oModal:openConfirm()    
            jData       := prepareMessage(.F., cAliasMark, oMrkAntecipa:Mark())
            jLimitGrant := prepareMessageLimit(cAliasMark, oMrkAntecipa:Mark())
            oModel    := FWLoadModel("totvs.protheus.backoffice.techfin.antecipa.monitor.AntecipaRequests")
            oModelARD := oModel:GetModel("ARDMASTER")
            oModelARE := oModel:GetModel("AREDETAIL")
            oModel:SetOperation(MODEL_OPERATION_INSERT)
            oModel:Activate()
            
            cNumSolicitacao := oModelARD:getValue("ARD_NUM")
            oModelARD:setValue("ARD_STATUS", "1") //1=Em processamento;2=Cancelado;3=Em Aprovacao;4=Reprovado;5=Em Efetivacao;6=Finalizado
            oModelARD:setValue("ARD_DTSOL" , dDataBase)
            oModelARD:setValue("ARD_VLCUST", __jSimulate["cost"])  // Custo
            oModelARD:setValue("ARD_TXSIM" , __jSimulate["rate"])  // Tx Simulacao
            oModelARD:setValue("ARD_TXLOTE", 0)  // Taxa do Lote
            oModelARD:setValue("ARD_VLPREA", 0)  // Vl. Pre Aut.
            oModelARD:setValue("ARD_VLPGTO", 0)  // Vlr de Pgto.
            if LEN(FWSX3Util():GetFieldStruct( "ARD_JUSTIF" )) > 0
                oModelARD:setValue("ARD_JUSTIF", __cJustific)  // Justificativa.
            EndIf 
            oModelARD:setValue("ARD_USER"  , cUserName)

            nQtdTit := Len(jData["installments"])
            for nTitulo := 1 to nQtdTit
                // E1_FILIAL, E1_PREFIXO, E1_NUM, E1_PARCELA, E1_TIPO, E1_CLIENTE, E1_LOJA
                aChaveTitulo := StrTokArr2(jData["installments"][nTitulo]["erpInstallmentId"], "|", .T.)
                cItem        := StrZero(nTitulo, nTamItem, 0)
                jData["installments"][nTitulo]["erpInstallmentId"] := cItem

                oModelARE:AddLine()
                oModelARE:setValue("ARE_NUM"   , cNumSolicitacao)
                oModelARE:setValue("ARE_STATUS", "0") //0=Em processamento;1=Aprovado;4=Rejeitado
                oModelARE:setValue("ARE_ITEM"  , cItem)
                oModelARE:setValue("ARE_FILTIT", aChaveTitulo[1])
                oModelARE:setValue("ARE_PREFIX", aChaveTitulo[2])
                oModelARE:setValue("ARE_NUMTIT", aChaveTitulo[3])
                oModelARE:setValue("ARE_PARTIT", aChaveTitulo[4])
                oModelARE:setValue("ARE_TIPTIT", aChaveTitulo[5])
                oModelARE:setValue("ARE_CLITIT", aChaveTitulo[6])
                oModelARE:setValue("ARE_LOJTIT", aChaveTitulo[7])
                oModelARE:setValue("ARE_VLSOL" , jData["installments"][nTitulo]["installmentNetAmount"])
                oModelARE:setValue("ARE_VLPREA", 0)
                nTotalSol += jData["installments"][nTitulo]["installmentNetAmount"]
            next nTitulo
            oModelARD:setValue("ARD_QTDTIT", nQtdTit)
            oModelARD:setValue("ARD_VLSOL" , nTotalSol)

            oModelARD:setValue("PreAuthorization", jData:toJson())
            oModelARD:setValue("LimitGrant", jLimitGrant:toJson())

            if !(lRet := oModel:vldData() .and. oModel:commitData() .and. !oModel:HasErrorMessage())
                cError := oModel:GetErrorMsgText(.T.)
                Help( ,,"SOLMODELVALID",,cError, 1, 0 )
            Else
                oModalFim := totvs.protheus.backoffice.techfin.util.TechfinDialog():new()
                oModalFim:setTitle(STR0031) //Solicitação enviada para análise!
                oModalFim:setText(20, 10, STR0032 + ARD->ARD_NUM + " " + STR0033 + "Antecipa Techfin" + STR0043 )  //Sua solicitação número # foi enviada para análise, confira o status e andamento em Totvs Antecipa -> Consultar
                oModalFim:setButton(STR0023, {|| oModalFim:DeActivate() }) //"Ok, entendi" 
                oModalFim:openInfo(100, 250)
            endif
            __cJustific := ""
            oModel:deActivate()
            oModel:destroy()
            oModel := NIL
        endIf
    EndIf
return lRet

/*/{Protheus.doc} prepareMessage
    Prapara a mensagem para o Antecipa
    @type function 
    @author Squad Techfin
    @since 8/22/2025
    @param lSimulate , logical, indica se é uma simulação ou solicitação
    @param cAliasMark, character, alias dos títulos
    @param cMark     , character, mark do títulos selecionados
    @return json     , mensagem formatada
/*/
static function prepareMessage(lSimulate as logical, cAliasMark as character, cMark as character) as json
    local jData         := JsonObject():new()                                    as json
    local jInstallments := JsonObject():new()                                    as json
    local cChaveSE1     := ""                                                    as character
    local cXML          :=  ""                                                   as character
    local nSaldo        := 0                                                     as numeric
    local aArea         := FwGetArea()                                           as array
    DEFAULT lSimulate := .T.
    
    jData["respondTo"] :=  "AntecipaCalculationSimulateResponseV1"
    if !lSimulate
        jData["respondTo"] :=  "AntecipaPreAuthorizationExecuteResponseV1"
        jData["requestReason"]    := __cJustific
    endIf
    jData["installments"] := {}

    dbSelectArea(cAliasMark)
    (cAliasMark)->(dbGoTop())
    while (cAliasMark)->(!Eof())
        if cMark == (cAliasMark)->MARK
            cChaveSE1 := (cAliasMark)->E1_FILORIG + "|" + (cAliasMark)->E1_PREFIXO + "|" + (cAliasMark)->E1_NUM + "|" + (cAliasMark)->E1_PARCELA + "|" + (cAliasMark)->E1_TIPO + "|" + (cAliasMark)->E1_CLIENTE + "|" + (cAliasMark)->E1_LOJA
            nSaldo    := (cAliasMark)->E1_SALDO
            jInstallments := JsonObject():new()
            jInstallments["erpInstallmentId"]       := cChaveSE1
            jInstallments["installmentDueDate"]     := SubSTR(FWTimeStamp(5, (cAliasMark)->E1_VENCREA), 1, 10)
            jInstallments["installmentNetAmount"]   := nSaldo
            jInstallments["installmentNumber"]      := 1 // Padrão, não utilizado            
            jInstallments["documentNumber"]         := cCnpjParceiro
            jInstallments["customerDocumentNumber"] := (cAliasMark)->A1_CGC
            // se for a mensagem de solicitação, adiciona os dados da NFe
            if !lSimulate
                jInstallments["invoiceKey"]       := (cAliasMark)->F2_CHVNFE
                jInstallments["invoiceNumber"]    := (cAliasMark)->F2_DOC
                jInstallments["invoiceIssueDate"] := SubSTR(FWTimeStamp(5, (cAliasMark)->F2_EMISSAO), 1, 10)                
                cXML := totvs.protheus.backoffice.techfin.util.getFiscalDoc( (cAliasMark)->F2_SERIE+(cAliasMark)->F2_DOC )
                if !Empty(cXML)
                    jInstallments["invoiceXml"] := cXML
                endIf                
            endIf
            AADD(jData["installments"], jInstallments)
        endIf
        (cAliasMark)->(dbSkip())
    endDo

    FwRestArea(aArea)
return jData
 
/*/{Protheus.doc} MessageTss
    Mensagem de aviso sobre a conexão com o TSS
    @type  Static Function
    @author Vitor Duca
    @since 03/09/2025
    @version 1.0
/*/
Static Function MessageTss()
    Local oModal        as Object

    oModal := totvs.protheus.backoffice.techfin.util.TechfinDialog():new()
    oModal:setTitle(STR0040) //TSS
    oModal:setSubTitle(STR0026)//"O serviço SPED não está habilitado no seu ambiente."
    oModal:setText(20, 10, STR0027)//"Para solicitar Antecipação é necessário ter o SPED ativo para que o XML da NF-e seja validado pela TOTVS Techfin."
	oModal:setText(40, 10, STR0028)//"Você ainda pode fazer simulações normalmente."
    oModal:setButton(STR0023, {|| oModal:DeActivate() }) //"Ok, entendi"
    oModal:openInfo()
Return


/*/{Protheus.doc} verLimiteSacado
    verifica o limite do sacado
    @type static function
    @author Squad techfin
    @since 9/9/2025
    @param cCGC    , character, A1_CGC do cliente
    @param cCodCli , character, código do cliente
    @param cLoja   , character, loja do cliente
    @param nValor  , numeric  , valor solicitado
    @param lAdd    , logical  , true indica que está marcando, false desmarcando
    @param lUpd    , logical  , true atualiza os limites utilizados
    @return logical, true se a validação do limite passou
/*/
Static Function verLimiteSacado(cCGC as character, cCodCli as character, cLoja as character, nValor as numeric, lAdd as logical, lUpd as logical) as logical

    local cClienteKey := cCGC        as character
    local cNomCli     := ""          as character
    local cMsgHelp    := ""          as character
    local nLimite     := 0           as numeric
    local lRet        := .T.         as logical    
    local aArea       := {}          as array 
    local aAreaSA1    := {}          as array 

    if len(Alltrim(cCGC)) > 11 //pessoa juridica
        cClienteKey := SubStr(Alltrim(cCGC), 1, 8)
    endIf
    
    //controle de lmite por raiz/cliente
    if !jLimites:hasProperty(cClienteKey)
        nLimite := getLimiteSacado(cFilParceiro, cCodCli, cLoja)
        jLimites[cClienteKey] := JsonObject():new()
        jLimites[cClienteKey]["limite"] := nLimite
        jLimites[cClienteKey]["utilizado"]  := 0
    endIf

    //limite e se tem limite cadastrado
    if jLimites[cClienteKey]["limite"] > 0
        if lAdd
            if jLimites[cClienteKey]["utilizado"] + nValor > jLimites[cClienteKey]["limite"]

                aArea    := FwGetArea() 
                aAreaSA1 := SA1->(FwGetArea())                
                cNomCli  := Posicione("SA1", 1, FwxFilial("SA1",cFilParceiro) + cCodCli + cLoja, "A1_NREDUZ")
                cMsgHelp := I18N(STR0017, {Alltrim(Transform(jLimites[cClienteKey]["limite"],__cE1VALORPicture)), Alltrim(cNomCli)})
                Help("",1,"LIMITESACADO",,cMsgHelp,1,0, NIL, NIL, NIL, NIL, NIL, {STR0024 + "Antecipa Techfin" + STR0042})//"Você atingiu o limite de #1 disponível para o cliente #2" - "Selecione outro cliente para continuar ou ajuste os valores em TOTVS Antecipa -> Gereniar Limites"
                lRet := .F.
                FwRestArea(aAreaSA1)
                FwRestArea(aArea)
            elseIf lUpd
                jLimites[cClienteKey]["utilizado"] += nValor
            endIf
        elseIf lUpd
            jLimites[cClienteKey]["utilizado"] -= nValor
        endIf
    endIf
   
    FwFreeArray(aArea)
    FwFreeArray(aAreaSA1)

return lRet

/*/{Protheus.doc} getLimiteParceiro
    Retorno o limite do parceiro
    @type function
    @author squad Techfin
    @since 9/5/2025
    @param cFilPar, character, filial do parceiro
    @return numeric, return_description
/*/
Function getLimiteParceiro(cFilPar as character) as array

    local aDataParc := {} as array
    local cQuery    := "" as character
    local cAlsParc  := "" as character

    If __oQryParc == Nil
        cQuery   := "SELECT ARA_LDISP, ARA_IOFM, ARA_TAC FROM " + RetSQLName("ARA")
        cQuery   += " WHERE ARA_FILSM0 = ?"
        cQuery   += " AND ARA_STATUS = ?"
        cQuery   += " AND ARA_PRODTF = ?"
        cQuery   += " AND D_E_L_E_T_ = ?"
        cQuery   := ChangeQuery(cQuery)    
        __oQryParc := FwExecStatement():New(cQuery)
    EndIF
    __oQryParc:SetString(1, cFilPar )
    __oQryParc:SetString(2, '0' ) // Status
    __oQryParc:SetString(3, '1' ) // Produto Antecipa
    __oQryParc:SetString(4, ' ' ) // D_E_L_E_T_
    cAlsParc := __oQryParc:OpenAlias()   

    aDataParc := {0,0,0}
    If (cAlsParc)->(!EoF())    
        aDataParc[1] := (cAlsParc)->ARA_LDISP
        aDataParc[2] := (cAlsParc)->ARA_IOFM
        aDataParc[3] := (cAlsParc)->ARA_TAC
    EndIF
    (cAlsParc)->(DbCloseArea())

Return aDataParc

/*/{Protheus.doc} getLimiteSacado
    Retorno o limite do sacado
    @type function
    @author Squad Techfin
    @since 9/5/2025
    @param cFilial , character, filial
    @param cCodCli , character, código do cliente
    @param cLoja   , character, loja do cliente
    @return numeric, limite do sacado
/*/
Function getLimiteSacado(cFiliCli as character , cCodCli as character, cLoja as character) as numeric

    local cQuery   := "" as character
    local nLimite  := 0  as numeric
    Local oExec   := Nil As object

    cQuery   := "SELECT AI0_TFLIMD LIMITE FROM " + RetSQLName("AI0")
    cQuery   += " WHERE AI0_FILIAL = ?"
    cQuery   += " AND AI0_CODCLI = ?"
    cQuery   += " AND AI0_LOJA = ?"
    cQuery   += " AND D_E_L_E_T_ = ?"

    oExec := FwExecStatement():New(ChangeQuery(cQuery))
    oExec:SetString(1, FwXFilial("AI0", cFiliCli) )
    oExec:SetString(2, cCodCli )    
    oExec:SetString(3, cLoja )
    oExec:SetString(4, " " ) 

    nLimite := oExec:ExecScalar("LIMITE")
Return nLimite

/*/{Protheus.doc} prepareMessageLimit
    Prepara a mensagem de limite para o Antecipa
    @type function
    @version  
    @author Squad Techfin
    @since 9/26/2025
    @param cAliasMark, character, alias da temporária
    @param cMark, character, mark utilizado
    @return json, mensagem formatada em JSON
/*/
static function prepareMessageLimit(cAliasMark as character, cMark as character) as json
    local jMessage      := JsonObject():new() as json
    local aCustomers    :=  {}                as array
    local cFilCustomer  := xFilial("SA1")     as character

    dbSelectArea(cAliasMark)
    (cAliasMark)->(dbGoTop())
    while (cAliasMark)->(!Eof())
        if cMark == (cAliasMark)->MARK
            aAdd(aCustomers, {cFilCustomer, (cAliasMark)->A1_COD, (cAliasMark)->A1_LOJA, (cAliasMark)->E1_SALDO})
        endIf
        (cAliasMark)->(DbSkip())
    endDo

    jMessage := totvs.protheus.backoffice.techfin.antecipa.limits.prepareMessage(aCustomers)
return jMessage

/*/{Protheus.doc} justificationInput
    Envia a justificativa do motivo da solicitação
    @type function
    @version  
    @author Squad Techfin
    @since 26/11/2025
    @return text, mensagem formatada em text
/*/

Function justificationInput()

    __cJustific :=FWInputBox(STR0041, __cJustific) //"Adicionar jutificativa da Solicitação"

Return
