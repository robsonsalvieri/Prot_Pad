/*/{Protheus.doc} processReturnDoc
    Processa o documento de devolução para verificar se existe antecipação
    @type function
    @author Squad TechFin
    @since 11/23/2025
    @param cDoc, character, número do documento
    @param cSerie, character, serie do documento
    @param cCliente, character, cliente do documento
    @param cLoja, character, loja do documento
/*/
Function processReturnDoc(cDoc as Character, cSerie as Character, cCliente as Character, cLoja as Character)
    Local cQuery    := "" as Character
    Local cQueryNCC := "" as Character
    Local cAlias    := "" as Character
    Local cAliasNCC := "" as Character
    Local cChaveNCC := "" as Character
    Local cIdDocNCC := "" as Character
    Local nValNCC   := 0  as Numeric
    Local cFilTit   := "" as Character
    Local cPrefixo  := "" as Character
    Local cNum      := "" as Character
    Local cParcela  := "" as Character
    Local cTipoTit  := "" as Character
    Local cCartTecF := "" as Character
    Local cDevTecF  := "" as Character
    Local lExisteARF:=.F. as Logical    
    Local aArea     :={}  as Array
        
    cCartTecF:= Padr(SuperGetMv("MV_CARTECF", .F., ""), TamSX3("E1_SITUACA")[1])
    cDevTecF := Padr(SuperGetMv("MV_DEVTECF", .F., ""), TamSX3("E1_SITUACA")[1])
    If Empty(cCartTecF) .or. Empty(cDevTecF)
        Return
    EndIf

    SaveInter()
    aArea := FwGetArea()    
    //Pega o IDDOC da NCC
    If __oExecNCC == NIL
        cQueryNCC := "SELECT SE1.E1_FILIAL, SE1.E1_PREFIXO, SE1.E1_NUM, SE1.E1_PARCELA, SE1.E1_TIPO, SE1.E1_CLIENTE, SE1.E1_LOJA, SE1.E1_FILORIG, SE1.E1_SALDO "
        cQueryNCC += "FROM " + RetSqlName("SE1") + " SE1"
        cQueryNCC += " WHERE SE1.E1_FILIAL = ? "
        cQueryNCC += " AND SE1.E1_NUM = ? "
        cQueryNCC += " AND SE1.E1_SERIE = ? "
        cQueryNCC += " AND SE1.E1_CLIENTE = ? "
        cQueryNCC += " AND SE1.E1_LOJA = ? "
        cQueryNCC += " AND SE1.E1_TIPO = ? "
        cQueryNCC += " AND SE1.E1_SITUACA = ? "
        cQueryNCC += " AND SE1.E1_ORIGEM = ? "
        cQueryNCC += " AND SE1.D_E_L_E_T_ = ? "
        cQueryNCC := ChangeQuery(cQueryNCC)
        __oExecNCC := FWExecStatement():New(cQueryNCC)
    EndIf
    __oExecNCC:setString(1,  FwXFilial("SE1"))
    __oExecNCC:setString(2,  cDoc)
    __oExecNCC:setString(3,  cSerie)
    __oExecNCC:setString(4,  cCliente)
    __oExecNCC:setString(5,  cLoja)
    __oExecNCC:setString(6,  LEFT(MV_CRNEG, TamSX3("E1_TIPO")[1]))
    __oExecNCC:setString(7,  cDevTecF)
    __oExecNCC:setString(8,  "MATA100")
    __oExecNCC:setString(9,  " ")

    cAliasNCC :=__oExecNCC:OpenAlias()
    If (cAliasNCC)->(!EOF())
        nValNCC   := (cAliasNCC)->E1_SALDO
        cChaveNCC := (cAliasNCC)->E1_FILIAL +"|"+ (cAliasNCC)->E1_PREFIXO +"|"+ (cAliasNCC)->E1_NUM +"|"+ (cAliasNCC)->E1_PARCELA +"|"+ (cAliasNCC)->E1_TIPO
        cChaveNCC += "|" + (cAliasNCC)->E1_CLIENTE +"|"+ (cAliasNCC)->E1_LOJA
        cIdDocNCC := FINGRVFK7("SE1", cChaveNCC)

        //Verifica se ja existe NCC registrada no pós-faturamento
        //Cenário onde a consulta Faixa do Sefaz executa novamente a chamada dessa função para uma NF ja registrada
        dbSelectArea('ARF')
        dbSetORder(5)
        If dbSeek(FwxFilial('ARF',(cAliasNCC)->E1_FILORIG) + PadR(cIdDocNCC,TamSX3("ARF_IDMOV")[1]))
            lExisteARF := .T.
        EndIF
    EndIf
    (cAliasNCC)->(DbCloseArea())

    If !lExisteARF .And. !Empty(cIdDocNCC)
        If __oExecDev == NIL
            cQuery := "SELECT DISTINCT SE1.E1_FILORIG, SE1.E1_PREFIXO, SE1.E1_NUM, SE1.E1_PARCELA, SE1.E1_TIPO "
            cQuery += "FROM " + RetSqlName("SE1") + " SE1"
            cQuery += " JOIN " + RetSqlName("SD1") + " SD1 ON SE1.E1_NUM = SD1.D1_NFORI "
            cQuery += " AND SE1.E1_SERIE = SD1.D1_SERIORI "
            cQuery += " AND SE1.E1_CLIENTE = SD1.D1_FORNECE "
            cQuery += " AND SE1.E1_LOJA = SD1.D1_LOJA "
            cQuery += "WHERE "
            cQuery += " SE1.E1_FILIAL = ? "
            cQuery += " AND SD1.D1_FILIAL = ? "
            cQuery += " AND SD1.D1_DOC = ? "
            cQuery += " AND SD1.D1_TIPO = ? "
            cQuery += " AND SD1.D1_SERIE = ? "
            cQuery += " AND SD1.D1_FORNECE = ? "
            cQuery += " AND SD1.D1_LOJA = ? "
            cQuery += " AND SE1.E1_SITUACA = ? "
            cQuery += " AND SE1.E1_SALDO > ? "
            cQuery += " AND SE1.D_E_L_E_T_ = ? "
            cQuery += " AND SD1.D_E_L_E_T_ = ? "
            cQuery := ChangeQuery(cQuery)
            __oExecDev := FWExecStatement():New(cQuery)
        EndIf

        __oExecDev:setString(1,  FwXFilial("SE1"))
        __oExecDev:setString(2,  FwXFilial("SD1"))
        __oExecDev:setString(3,  cDoc)
        __oExecDev:setString(4,  "D")
        __oExecDev:setString(5,  cSerie)
        __oExecDev:setString(6,  cCliente)
        __oExecDev:setString(7,  cLoja)
        __oExecDev:setString(8,  cCartTecF)
        __oExecDev:setNumeric(9, 0)
        __oExecDev:setString(10, " ")
        __oExecDev:setString(11, " ")

        cAlias :=__oExecDev:OpenAlias()
        While (cAlias)->(!EOF())
            cFilTit  := (cAlias)->E1_FILORIG
            cPrefixo := (cAlias)->E1_PREFIXO
            cNum     := (cAlias)->E1_NUM
            cParcela := (cAlias)->E1_PARCELA
            cTipoTit := (cAlias)->E1_TIPO
            processReturnTit(cFilTit, cPrefixo, cNum, cParcela, cTipoTit, cIdDocNCC, nValNCC)
            (cAlias)->(DbSkip())
        EndDo
        (cAlias)->(DbCloseArea())
    EndIf

    RestInter()
    FwRestArea(aArea)
    FwFreeArray(aArea)
Return

/*/{Protheus.doc} processReturnTit
    Processa o título antecipado para devolução na TECHFIN
    @type function
    @author Squad TECHFIN
    @since 11/23/2025
    @param cFilTit, character, filial do título
    @param cPrefixo, character, prefixo do título
    @param cNum, character, número do título
    @param cParcela, character, parcela do título
    @param cTipoTit, character, tipo do título
    @param cIdDocNCC, character, identificador do documento NCC
    @param nValNCC, numeric, valor do NCC
/*/
Function processReturnTit(cFilTit as Character, cPrefixo as Character, cNum as Character, cParcela as Character, cTipoTit as Character, cIdDocNCC as Character, nValNCC as Numeric)
    Local cAlias    := ""  as Character
    Local cQuery    := ""  as Character
    Local oModelARF := NIL as Object
    Local cLogModel := ""  as Character

    If __oExecSol == NIL
        cQuery := "SELECT ARE.ARE_NUM NUMSOL, ARE.ARE_ITEM NUMITEM, ARE.ARE_CLITIT CLITIT, ARE.ARE_LOJTIT LOJTIT "
        cQuery += "FROM " + RetSqlName("ARE") + " ARE "
        cQuery += "WHERE ARE.ARE_FILTIT = ? "
        cQuery += " AND ARE.ARE_PREFIX  = ? "
        cQuery += " AND ARE.ARE_NUMTIT  = ? "
        cQuery += " AND ARE.ARE_PARTIT  = ? "
        cQuery += " AND ARE.ARE_TIPTIT  = ? "
        cQuery += " AND ARE.ARE_STATUS  = ? "
        cQuery += " AND ARE.D_E_L_E_T_  = ? "
        cQuery += " AND ARE.ARE_NUM = (SELECT MAX(ARENUM.ARE_NUM) "
        cQuery += "                   FROM " + RetSqlName("ARE") + " ARENUM "
        cQuery += "                   WHERE ARENUM.ARE_FILTIT = ? "
        cQuery += "                     AND ARENUM.ARE_PREFIX  = ? "
        cQuery += "                     AND ARENUM.ARE_NUMTIT  = ? "
        cQuery += "                     AND ARENUM.ARE_PARTIT  = ? "
        cQuery += "                     AND ARENUM.ARE_TIPTIT  = ? "
        cQuery += "                     AND ARENUM.ARE_STATUS  = ? "
        cQuery += "                     AND ARENUM.D_E_L_E_T_  = ? )"
        cQuery := ChangeQuery(cQuery)
        __oExecSol := FWExecStatement():New(cQuery)
    EndIf

    __oExecSol:setString(1, cFilTit)
    __oExecSol:setString(2, cPrefixo)
    __oExecSol:setString(3, cNum)
    __oExecSol:setString(4, cParcela)
    __oExecSol:setString(5, cTipoTit)
    __oExecSol:setString(6, "3")   // Status aprovado (ajuste conforme regra)
    __oExecSol:setString(7, " ")
    __oExecSol:setString(8,  cFilTit)
    __oExecSol:setString(9,  cPrefixo)
    __oExecSol:setString(10, cNum)
    __oExecSol:setString(11, cParcela)
    __oExecSol:setString(12, cTipoTit)
    __oExecSol:setString(13, "3")
    __oExecSol:setString(14, " ")

    cAlias :=__oExecSol:openAlias()
    If (cAlias)->(!EOF())
        SetEventToModelDef(DEVOLUCAO)
        oModelARF := FWLoadModel("totvs.protheus.backoffice.techfin.antecipa.postbilling.monitorBilling")
        oModelARF:SetOperation(MODEL_OPERATION_INSERT)
        oModelARF:Activate()
        oModelARF:SetValue("ARFMASTER", "ARF_TIPO"  , TPDEVOLUCAO)
        oModelARF:SetValue("ARFMASTER", "ARF_FILTIT", cFilTit)
        oModelARF:SetValue("ARFMASTER", "ARF_PREFIX", cPrefixo)
        oModelARF:SetValue("ARFMASTER", "ARF_NUMTIT", cNum)
        oModelARF:SetValue("ARFMASTER", "ARF_PARTIT", cParcela)
        oModelARF:SetValue("ARFMASTER", "ARF_TIPTIT", cTipoTit)
        oModelARF:SetValue("ARFMASTER", "ARF_NUMSOL", (cAlias)->NUMSOL)
        oModelARF:SetValue("ARFMASTER", "ARF_ITEM"  , (cAlias)->NUMITEM)
        oModelARF:SetValue("ARFMASTER", "ARF_CLITIT", (cAlias)->CLITIT)
        oModelARF:SetValue("ARFMASTER", "ARF_LOJTIT", (cAlias)->LOJTIT)
        oModelARF:SetValue("ARFMASTER", "ARF_STATUS", "0")                 // Aguardando transmissão
        oModelARF:SetValue("ARFMASTER", "ARF_IDMOV" , cIdDocNCC)           // IDDOC da NCC
        oModelARF:SetValue("ARFMASTER", "ARF_VLSOL" , nValNCC)             // Valor da NCC

        If !(oModelARF:VldData() .and. oModelARF:CommitData())
            cLogModel := cValToChar(oModelARF:GetErrorMessage()[4]) + " - "
            cLogModel += cValToChar(oModelARF:GetErrorMessage()[5]) + " - "
            cLogModel += cValToChar(oModelARF:GetErrorMessage()[6])
            FwLogMsg("ERROR",, "TECHFIN", FunName(), "", "01", "Devolução NF: " + cLogModel,  0, 0, {})
        EndIf
        oModelARF:DeActivate()
        oModelARF:Destroy()
    EndIf
    (cAlias)->(DbCloseArea())
Return 

/*/{Protheus.doc} processReturnJob
    Processa os títulos de devolução para envio à TECHFIN
    @type function
    @author Squad TECHFIN
    @param aParams, array, parâmetros de ambiente
    @since 11/24/2025
/*/
Function processReturnJob(aParams as Array)
    Local oExecARF   := NIL     as Object
    Local cQuery     := ""      as Character
    Local cAlias     := ""      as Character
    Local aNCC       := {}      as Array
    Local nX         := 0       as Numeric
    Local cFilBkp    := ""      as Character
    Local jNCCData   := JsonObject():New() as Json
    Local jData      := JsonObject():New() as Json
    Local oSmartUtil := totvs.protheus.backoffice.techfin.util.SmartlinkUtil():new() as object
    Local cLockName  := "Techfin-returnJob"                                          as Character
    Default aParams := {}

    If Len(aParams) > 1
        RpcSetType(3)
        RpcSetEnv(aParams[1], aParams[2])
    EndIf

    If LockByName(cLockName, .T./*lEmpresa*/, .F./*lFilial*/ )     
        cFilBkp  := cFilAnt
        cQuery := "SELECT ARF.ARF_FILTIT, ARF.ARF_IDMOV, ARF.ARF_VLSOL, ARF.R_E_C_N_O_ ARF_RECNO, ARF.ARF_MSUID, ARE.ARE_TRANSC, SA1.A1_CGC "
        cQuery += "FROM " + RetSqlName("ARF") + " ARF "
        cQuery += "JOIN " + RetSqlName("ARE") + " ARE ON "
        cQuery += " ARF.ARF_FILIAL = ARE.ARE_FILIAL "
        cQuery += " AND ARF.ARF_NUMSOL = ARE.ARE_NUM "
        cQuery += " AND ARF.ARF_ITEM   = ARE.ARE_ITEM "
        cQuery += " AND ARF.ARF_FILTIT = ARE.ARE_FILTIT "
        cQuery += "JOIN " + RetSqlName("SA1") + " SA1 ON "
        cQuery += totvs.protheus.backoffice.ngf.util.BranchRelation({"SA1", "A1_FILIAL", "SA1"}, {"ARE", "ARE_FILIAL", "ARE"} )
        cQuery += " AND SA1.A1_COD    = ARE.ARE_CLITIT "
        cQuery += " AND SA1.A1_LOJA   = ARE.ARE_LOJTIT "
        cQuery += "WHERE " 
        cQuery += "  ARF.ARF_TIPO = ? "
        cQuery += "  AND ARF.ARF_STATUS = ? "
        cQuery += "  AND ARF.ARF_IDMOV <> ? "
        cQuery += "  AND ARF.D_E_L_E_T_ = ? "
        cQuery += "  AND ARE.D_E_L_E_T_ = ? "
        cQuery += "  AND SA1.D_E_L_E_T_ = ? "
        cQuery := ChangeQuery(cQuery)
        oExecARF := FWExecStatement():New(cQuery)

        oExecARF:setString(1, TPDEVOLUCAO)
        oExecARF:setString(2, "0")
        oExecARF:setString(3, " ")
        oExecARF:setString(4, " ")
        oExecARF:setString(5, " ")
        oExecARF:setString(6, " ")
        cAlias := oExecARF:openAlias()

        //Agrupa os dados por NCC
        While (cAlias)->(!EOF())
            If !jNCCData:hasProperty((cAlias)->ARF_IDMOV)
                jNCCData[(cAlias)->ARF_IDMOV] := JsonObject():New()
                jNCCData[(cAlias)->ARF_IDMOV]["data"]     :=  {}
                jNCCData[(cAlias)->ARF_IDMOV]["value"]    :=  (cAlias)->ARF_VLSOL
                jNCCData[(cAlias)->ARF_IDMOV]["branch"]   :=  (cAlias)->ARF_FILTIT
                jNCCData[(cAlias)->ARF_IDMOV]["ARFRecno"] :=  {}

            EndIf
            AADD(jNCCData[(cAlias)->ARF_IDMOV]["ARFRecno"], (cAlias)->ARF_RECNO)
            
            AADD(jNCCData[(cAlias)->ARF_IDMOV]["data"], {;
                "erpInstallmentId": (cAlias)->ARF_MSUID,;
                "customerDocumentNumber": (cAlias)->A1_CGC,;
                "transactionCode": Alltrim((cAlias)->ARE_TRANSC);
            })

            (cAlias)->(DbSkip())
        EndDo
        (cAlias)->(DbCloseArea())
        //envia as antecipações por NCC
        aNCC := jNCCData:getNames()

        For nX := 1 To Len(aNCC)
            cFilAnt := jNCCData[aNCC[nX]]["branch"] 
            jData := JsonObject():New()
            jData["respondTo"]     := "AntecipaReturnExecuteResponseV1"
            jData["returnAmount"]  := jNCCData[aNCC[nX]]["value"]
            jData["dataToProcess"] := jNCCData[aNCC[nX]]["data"]
            If oSmartUtil:send("AntecipaReturnExecuteRequestV1", jData:toJson(), .T., aNCC[nX], .F.)
                updateStatus(jNCCData[aNCC[nX]]["ARFRecno"])
            EndIf
        Next nX
        UnLockByName(cLockName, .T./*lEmpresa*/, .F./*lFilial*/ )
        cFilAnt := cFilBkp
    EndIf
    FwFreeObj(oExecARF)
    FwFreeObj(oSmartUtil)
    FwFreeObj(jNCCData)
    FwFreeObj(jData)
    FwFreeArray(aNCC)
Return

/*/{Protheus.doc} updateStatus
    Atualiza o status dos registros ARF após o envio para Techfin
    @type function
    @version  
    @author Squad TechFin
    @since 11/24/2025
    @param aRecnos, array, recnos dos registros a serem atualizados
/*/
Function updateStatus(aRecnos as Array)
    Local nX       := 0                  as Numeric
    Local aArea    := FwGetArea()        as Array
    Local aAreaARF := ARF->(FwGetArea()) as Array

    DbSelectArea("ARF")
    DbSetOrder(1)
    Begin transaction
        For nX := 1 To Len(aRecnos)
            ARF->(DbGoTo(aRecnos[nX]))
            RecLock("ARF", .F.)
            ARF->ARF_STATUS := "1" // Em Processamento
            ARF->(MsUnlock())
        Next nX
    End Transaction
    FwRestArea(aAreaARF)
    FwRestArea(aArea)
Return


/*/{Protheus.doc} MonitorBillingEvent
    Classe responsavel por orquestrar os eventos do 
    modelo de dados da rotina
    @author Squad TechFin
    @since 28/08/2025
    @version 1.0
/*/
Class MonitorBillingEvent from FWModelEvent
    Data cCarTecF   as Character
    Data cQrySituaca as Character
    Public Method new()
    Public Method modelPosVld(oModel as Object) as Logical
    Public Method inTTS(oModel as Object)
EndClass

/*/{Protheus.doc} new
    Metodo construtor da classe
    @author Squad TechFin
    @since 28/08/2025
    @version 1.0
/*/
Method new()  Class MonitorBillingEvent
    ::cCarTecF    := SuperGetMv("MV_CARTECF", .F., "")
    ::cQrySituaca := querySituaca()
Return

/*/{Protheus.doc} ModelPosVld
    Validação no gravação do modelo de dados, permitindo
    adicionar condições complementares a regra de negocio
    @author Squad TechFin
    @since 28/08/2025
    @version 1.0
/*/
Method modelPosVld(oModel as Object) as Logical Class MonitorBillingEvent
    Local lRet        := .T.                                        as Logical
    Local aAreaARF    := ARF->(FwGetArea())                         as Array
    Local cFilTit     := oModel:GetValue("ARFMASTER", "ARF_FILTIT") as Character
    Local cStatus     := oModel:GetValue("ARFMASTER", "ARF_STATUS") as Character
    Local cPrefixo    := oModel:GetValue("ARFMASTER", "ARF_PREFIX") as Character
    Local cNumTit     := oModel:GetValue("ARFMASTER", "ARF_NUMTIT") as Character
    Local cParTit     := oModel:GetValue("ARFMASTER", "ARF_PARTIT") as Character
    Local cTipoTit    := oModel:GetValue("ARFMASTER", "ARF_TIPTIT") as Character
    Local cClienteTit := oModel:GetValue("ARFMASTER", "ARF_CLITIT") as Character
    Local cLojaCliTit := oModel:GetValue("ARFMASTER", "ARF_LOJTIT") as Character
    Local cSituaca    := ""                                         as Character    
    Local cQuery      := ""                                         as Character    
    Local cAlias      := ""                                         as Character    

    If oModel:GetOperation() == MODEL_OPERATION_INSERT .And. (__nFolderActive == PRORROGACAO .Or. __nFolderActive == BONIFICACAO .Or. __nFolderActive == RECOMPRA)
        //-------------------------------------------------------------------
        //-- Valida a existência do item da Solicitação        
        if Empty(__oQryPosVld)
            cQuery := "SELECT R_E_C_N_O_ FROM " + RetSQLName("ARE")
            cQuery += " Where ARE_FILIAL = ? "
            cQuery += " And ARE_NUM = ? "
            cQuery += " And ARE_ITEM = ? "
            cQuery += " And ARE_FILTIT = ? "
            cQuery += " And ARE_PREFIX = ? "
            cQuery += " And ARE_NUMTIT = ? "
            cQuery += " And ARE_PARTIT = ? "
            cQuery += " And ARE_TIPTIT = ? "
            cQuery += " And ARE_CLITIT = ? "
            cQuery += " And ARE_LOJTIT = ? "
            cQuery += " And D_E_L_E_T_ = ?"
            cQuery := ChangeQuery(cQuery)
            __oQryPosVld := FwExecStatement():New(cQuery)
        endIf
        __oQryPosVld:setString(1, FwXFilial("ARE"))
        __oQryPosVld:SetString(2, oModel:GetValue("ARFMASTER", "ARF_NUMSOL")) 
        __oQryPosVld:SetString(3, oModel:GetValue("ARFMASTER", "ARF_ITEM")) 
        __oQryPosVld:SetString(4, cFilTit) 
        __oQryPosVld:SetString(5, cPrefixo) 
        __oQryPosVld:SetString(6, cNumTit) 
        __oQryPosVld:SetString(7, cParTit) 
        __oQryPosVld:SetString(8, cTipoTit) 
        __oQryPosVld:SetString(9, cClienteTit) 
        __oQryPosVld:SetString(10,cLojaCliTit) 
        __oQryPosVld:SetString(11, ' ') 
        cAlias := __oQryPosVld:OpenAlias()   
        If (cAlias)->(EoF())    
            lRet := .F.
            Help("", 1,"POSFATVALID", , STR0052, 1, 0, NIL, NIL, NIL, NIL, NIL, {STR0053})//"Item da Solicitação não localizado." //"Selecione uma Solicitação/Item existente."                
        endIf
        (cAlias)->(DbCloseArea())       

        //-------------------------------------------------------------------
        //-- Não permite nova solicitação para mesmo item ainda pendente 
        If lRet .And. cStatus $ "0|1"//0=Envio pendente;1=Em processamento;2=Aprovado;3=Reprovado
            ARF->(DbSetOrder(2))
            If ARF->(DbSeek(cFilTit+cStatus+cPrefixo+cNumTit+cParTit+cTipoTit+cClienteTit+cLojaCliTit))
                lRet := .F.
                Help("", 1, "SOLPENDENT", , STR0014, 1, 0, NIL, NIL, NIL, NIL, NIL, {STR0015}) //"O titulo em questão possui solicitação de pós faturamento em processamento"#"Aguarde o processamento da solicitação que esta pendente"
            EndIf
        EndIf
        //-------------------------------------------------------------------
        //-- Verifica se titulo esta na carteira Techfin (paramtro MV_CARTECF)
        If lRet
            cSituaca := MpSysExecScalar(::cQrySituaca, "SITUACA", {FwXFilial('SE1',cFilTit), cPrefixo, cNumTit, cParTit, cTipoTit, " "})
            If cSituaca <> ::cCarTecF
                lRet := .F.
                Help("", 1, "SITCTECF", , STR0046, 1, 0, NIL, NIL, NIL, NIL, NIL, {STR0047}) //"O título em questão não está na carteira TECHFIN"#"Verifique a situação do título e tente novamente"
            EndIf
        EndIf
        //-------------------------------------------------------------------
        //-- Faz a simulação para apresentar o resumo da operação
        If lRet .And. !IsBlind()
            lRet := simulation(oModel)
        Endif
        FwRestArea(aAreaARF)        
        FwFreeArray(aAreaARF)   
    EndIf

Return lRet

/*/{Protheus.doc} inTTS
    Método que é chamado pelo MVC durante a gravacao do Model, no controle de transacao
    @author Squad Techfin
    @since 09/09/2025
    @version version
    @param oModel, Objeto, Modelo de dados da rotina
/*/
Method inTTS(oModel as object) Class MonitorBillingEvent
    Local cFila     := "AntecipaPostBillingExecuteRequestV1"   as character
    Local cData     := ""                                      as character
    Local cMSGID    := ""                                      as character
    Local oView     := FwViewActive()                          as object

    If __nOriginEvent == 1 .And. oModel:GetOperation() == MODEL_OPERATION_INSERT .And. (__nFolderActive == PRORROGACAO .Or. __nFolderActive == BONIFICACAO .Or. __nFolderActive == RECOMPRA)
        cData := prepareMessage(.F., oModel:getModel('ARFMASTER'), ARF->ARF_MSUID)
        cMSGID := totvs.protheus.backoffice.techfin.util.sendSmartLink(cFila, "1", "PostBilling", cData, .T.)

        If Empty(cMSGID)
            oModel:SetErrorMessage(,,,, "SMARTLINK", STR0045, STR0042) //Problema de comunicação com o Smartlink //Verifique a configuração do SmartLink e tente novamente mais tarde
            If oView <> NIL .and. oView:IsActive()
                oView:showInsertMsg(.F.)
            Endif
            RollbackDelTran()
        EndIf
    EndIf

    If oModel:GetOperation() == MODEL_OPERATION_INSERT .And. __nFolderActive == DEVOLUCAO 
        totvs.framework.schedule.utils.createTask(, cEmpAnt, cFilAnt, "totvs.protheus.backoffice.techfin.antecipa.postbilling.processReturnJob",;
                                                    6,; 
                                                    RetCodUsr())
    EndIf
Return

/*/{Protheus.doc} querySituaca
    Query que retorna a situação do título
    @type  Function
    @author Squad Techfin
    @since 09/09/2025
    @version version
    @return Character, Query formatada em string
/*/
Function querySituaca() as Character
    Local cQuery := "" as Character
    cQuery := "SELECT SE1.E1_SITUACA SITUACA FROM " + RetSqlName("SE1") + " SE1"
    cQuery += " WHERE SE1.E1_FILIAL = ?"
    cQuery += " AND SE1.E1_PREFIXO = ?"
    cQuery += " AND SE1.E1_NUM = ?"
    cQuery += " AND SE1.E1_PARCELA = ?"
    cQuery += " AND SE1.E1_TIPO = ?"
    cQuery += " AND SE1.D_E_L_E_T_ = ?"
Return cQuery
