#include 'tlpp-core.th'
#Include "FwMVCDef.ch"
#Include "protheus.ch"
#Include "backoffice.techfin.antecipa.postbilling.ch"

#DEFINE PRORROGACAO     1
#DEFINE BONIFICACAO     2
#DEFINE RECOMPRA        3
#DEFINE DEVOLUCAO       4
#DEFINE COOBRIGACAO     5
#DEFINE WALLET_UPDATE   6
#DEFINE CONCILIACAO     7
#DEFINE TPPRORROGACAO   "P"
#DEFINE TPBONIFICACAO   "B"
#DEFINE TPRECOMPRA      "R"
#DEFINE TPDEVOLUCAO     "D"
#DEFINE TPCOOBRIGACAO   "C"

NAMESPACE totvs.protheus.backoffice.techfin.antecipa.postbilling

Static __nFolderActive  := 1   as Numeric
Static __nOriginEvent   := 1   as Numeric
Static __nOptionMVC     := 0   as Numeric
Static __oExecDev       := NIL as Object
Static __oExecNCC       := NIL as Object
Static __oExecSol       := NIL as Object
Static __oQryPosVld     := NIL as Object

/*/{Protheus.doc} monitorBilling
    Realiza a abertura da tela que será responsavel pela funcionalidades 
    do pós faturamento dos titulos que estão integrados com o TOTVS Antecipa.
    @type       Function
    @author     Squad TechFin
    @since      26/08/2025
    @version    1.0
/*/
Function monitorBilling()
    Local oDlg                  as Object
    Local oLayer                as Object
    Local oTFolder              as Object
    Local aCoors                as Array
    Local aFolders              as Array
    Local oPanelTitulo          as Object
    Local oPanelFolder          as Object
    Local oBrowse               as Object
    Local oButtonPanelTitulo    as Object

    aFolders    :=  {;
                        STR0001,;//"Prorrogação"
                        STR0002,;//"Bonificação/Desconto"
                        STR0003,;//"Recompra" 
                        STR0004,;//"Devolução"
                        STR0005;//"Coobrigação"
                    }
    aCoors      := FWGetDialogSize(oMainWnd)

    totvs.framework.schedule.utils.createTask(, cEmpAnt, cFilAnt, "totvs.protheus.backoffice.techfin.antecipa.postbilling.processReturnJob",;
                                                6,; 
                                                RetCodUsr())

    oDlg   := TDialog():New(aCoors[1], aCoors[2], aCoors[3], aCoors[4], "",,,,nOr(WS_VISIBLE,WS_POPUP),,,, oMainWnd, .T.,,,,,,.T.)
    
    oLayer := FWLayer():new()
    oLayer:Init(oDlg,.F.)
    oLayer:AddLine('LIN1',10,.F.)
    oLayer:addCollumn('COL1',95, .F. ,'LIN1')
    oPanelTitulo    := oLayer:getColPanel('COL1','LIN1')
    oPanelTitulo:FreeChildren()
    TSay():New(10,10,{|| STR0006 },oPanelTitulo,,TFont():New(,,-20,.T.),,,,.T.) //"Pós faturamento"

    oLayer:addCollumn('COL2',5, .F. ,'LIN1')
    oButtonPanelTitulo := TButton():New( 10, 10, "x", oLayer:getColPanel('COL2','LIN1'), {||oDlg:End()}, 30,10,,TFont():New(,,-20,.T.),.F.,.T.,.F.,,.F.,,,.F. )
    oButtonPanelTitulo:setCss("QPushButton{border: none}")

    oLayer:AddLine('LIN2',90,.F.)
    oLayer:addCollumn('COL1',100, .F. ,'LIN2')

    oPanelFolder    := oLayer:getColPanel('COL1','LIN2')
    oPanelFolder:FreeChildren()

    oTFolder       := TFolder():New( 0, 0, aFolders, aFolders, oPanelFolder,,,,,, 1, 1 )
    oTFolder:Align := CONTROL_ALIGN_ALLCLIENT
    oTFolder:SetOption( 1 )
    oTFolder:bSetOption := {|nFolder| buildBrowse(nFolder, oTFolder, @oBrowse)  }

    buildBrowse(1, oTFolder, @oBrowse)

    oDlg:Activate(,,,.T.)

Return

/*/{Protheus.doc} buildBrowse
    Realiza a criação da browse nas abas utilizando o conceito de carregamento sobre demanda, ou seja,
    a browse só é carregada quando a aba for acessada, isso garante performance na abertura da tela
    tendo em vista que o sistema não irá aguardar a criação de todas as browser's
    @type  Static Function
    @author Squad TechFin
    @since 26/08/2025
    @version 1.0
    @param nFolder, Numeric, Pasta que foi selecionada
    @param oTFolder, Object, Objeto visual que contem as definições das pastas
    @param oBrowse, Object, Browse que irá conter os titulos que sofreram algum tipo de solicitação
/*/
Static Function buildBrowse(nFolder as Numeric, oTFolder as Object, oBrowse as Object)
    Local cTypeFilter   := ""   as Character
    Local nColumns      := 0    as Numeric
    Local cDelColumns   := ""   as Character

    __nFolderActive := nFolder

    If oBrowse <> NIL
        oBrowse:Destroy()
    Endif

    Do Case
        Case nFolder == PRORROGACAO
            cTypeFilter := TPPRORROGACAO
            cDelColumns := "ARF_DESCON|ARF_RECOMP|ARF_DEBREC"

        Case nFolder == BONIFICACAO
            cTypeFilter := TPBONIFICACAO
            cDelColumns := "ARF_VENATU|ARF_VENNOV|ARF_RECOMP|ARF_DEBREC"

        Case nFolder == RECOMPRA
            cTypeFilter := TPRECOMPRA
            cDelColumns := "ARF_VENATU|ARF_VENNOV|ARF_DESCON"
            
        Case nFolder == DEVOLUCAO
            cTypeFilter := TPDEVOLUCAO
            cDelColumns := "ARF_VENATU|ARF_VENNOV|ARF_DESCON|ARF_RECOMP|ARF_DEBREC"
            
        Case nFolder == COOBRIGACAO
            cTypeFilter := TPCOOBRIGACAO
            cDelColumns := "ARF_VENATU|ARF_VENNOV|ARF_DESCON|ARF_RECOMP|ARF_DEBREC"
    EndCase

    oBrowse := FwMBrowse():New()
    oBrowse:SetOwner(oTFolder:aDialogs[nFolder])
    oBrowse:SetDescription("")
    oBrowse:SetProfileID("ARF"+cTypeFilter)
    oBrowse:SetAlias("ARF")
    oBrowse:SetMenuDef("totvs.protheus.backoffice.techfin.antecipa.postbilling.monitorBilling")    
    If nFolder == COOBRIGACAO
        oBrowse:SetFilterDefault("@ ARF_TIPO = '" + cTypeFilter + "' AND ARF_STATUS = '2'")
        oBrowse:AddLegend("ARF_STATUS=='2'", "ORANGE" , STR0049) //"Coobrigação efetivada"
    Else
        oBrowse:SetFilterDefault("@ ARF_TIPO = '" + cTypeFilter + "' ")
        If nFolder == DEVOLUCAO
            oBrowse:AddLegend("ARF_STATUS=='0'", "WHITE" , STR0051) //"Envio Pendente"
        EndIf
        oBrowse:AddLegend("ARF_STATUS=='1'", "GRAY"	 , STR0007) //"Em processamento"
        oBrowse:AddLegend("ARF_STATUS=='2'", "GREEN" , STR0008) //"Aprovado"
        oBrowse:AddLegend("ARF_STATUS=='3'", "RED"	 , STR0009) //"Reprovado"
    EndIF
    oBrowse:DisableDetails()
    oBrowse:DisableReport()
    oBrowse:Activate()

    For nColumns := 1 to Len(oBrowse:aColumns)
        If Alltrim(oBrowse:aColumns[nColumns]:CREADVAR) $ cDelColumns
            oBrowse:DelColumn(nColumns)
        Endif
    Next nColumns

    oBrowse:UpdateBrowse()
    
Return

/*/{Protheus.doc} MenuDef
    Definição do menu funcional para a rotina
    @type  Function
    @author Squad TechFin
    @since 27/08/2025
    @version 1.0
    @return aRotina, Array, Matriz contendo as opções de menu
/*/
Function MenuDef() as Array
    Local aRotina := {} as Array
    Local cTitle  := "" as Character

    Do Case
        Case __nFolderActive == PRORROGACAO
            cTitle := STR0010 //"Prorrogar"

        Case __nFolderActive == BONIFICACAO
            cTitle := STR0011 //"Descontar"

        Case __nFolderActive == RECOMPRA
            cTitle := STR0012 //"Recomprar"
    EndCase

    ADD OPTION aRotina Title STR0013 Action "totvs.protheus.backoffice.techfin.antecipa.postbilling.operationsDef(1, cTitle)" OPERATION 2 ACCESS 0 //"Visualizar"
    
    If __nFolderActive == PRORROGACAO .or. __nFolderActive == BONIFICACAO .or. __nFolderActive == RECOMPRA
        ADD OPTION aRotina Title cTitle  Action "totvs.protheus.backoffice.techfin.antecipa.postbilling.operationsDef(3, cTitle)" OPERATION 3 ACCESS 0
    Endif

Return aRotina

/*/{Protheus.doc} operationsDef
    Definição das operações no MVC
    @type  Function
    @author Squad TechFin
    @since 02/09/2025
    @version 1.0
    @param nOption, Numeric, Operação que foi executada pelo MenuDef
    @param cTitle, Character, Titulo que será atribuido ao formulario
/*/
Function operationsDef(nOption as Numeric, cTitle as Character)
    Local aButtons  := {}   as Array

    aButtons := {{.F.,Nil},{.F.,Nil},{.F.,Nil},{.T.,Nil},{.T.,Nil},{.T.,Nil},{.T.,STR0018},{.T.,STR0019},{.T.,Nil},{.T.,Nil},{.T.,Nil},{.T.,Nil},{.T.,Nil},{.T.,Nil}}//"Solicitar"#"Cancelar"
    __nOptionMVC := nOption

    FWExecView(cTitle, "totvs.protheus.backoffice.techfin.antecipa.postbilling.monitorBilling", nOption,, { || .T. },,, aButtons)
Return

/*/{Protheus.doc} ModelDef
    Definição do modelo de dados da rotina, respeitando as regras de negocio e dicionario
    @type  Function
    @author Squad TechFin
    @since 27/08/2025
    @version 1.0
    @return oModel, Object, Modelo de dados
/*/
Function ModelDef() as Object
    Local oStruARF  := FWFormStruct(1, 'ARF')               as Object    
    Local oModel    := MPFormModel():New('monitorBilling')  as Object
    Local cDescription := STR0006                           as Character //"Pós faturamento"
    Local cIniPadType  := ""                                as Character
    Local oEvent  := monitorBillingEvent():New()            as Object    
    
    oModel:AddFields( 'ARFMASTER', /*cOwner*/, oStruARF )
    oModel:SetPrimaryKey({"ARF_NUM"})

    Do Case
        Case __nFolderActive == PRORROGACAO
            cIniPadType  := "P"
            oStruARF:SetProperty('ARF_VENATU', MODEL_FIELD_OBRIGAT, .T.)
            oStruARF:SetProperty('ARF_VENNOV', MODEL_FIELD_OBRIGAT, .T.)
            oStruARF:SetProperty("ARF_VENNOV", MODEL_FIELD_VALID, FwBuildFeature(STRUCT_FEATURE_VALID, "M->ARF_VENNOV > M->ARF_VENATU"))

        Case __nFolderActive == BONIFICACAO
            cIniPadType  := "B"
            oStruARF:SetProperty('ARF_DESCON', MODEL_FIELD_OBRIGAT, .T.)
            oStruARF:SetProperty("ARF_DESCON", MODEL_FIELD_VALID, FwBuildFeature(STRUCT_FEATURE_VALID, "POSITIVO(M->ARF_DESCON) .And. M->ARF_DESCON < M->ARF_VLSOL"))

        Case __nFolderActive == RECOMPRA
            cIniPadType  := "R"
            oStruARF:SetProperty('ARF_RECOMP', MODEL_FIELD_OBRIGAT, .T.)
            oStruARF:SetProperty("ARF_RECOMP", MODEL_FIELD_INIT, FWBuildFeature( STRUCT_FEATURE_INIPAD, '"1"'))
            oStruARF:SetProperty('ARF_RECOMP', MODEL_FIELD_WHEN, {||.F.})

        Case __nFolderActive == DEVOLUCAO
            cIniPadType  := "D"
        Case __nFolderActive == COOBRIGACAO
            cIniPadType  := "C"
        Case __nFolderActive == WALLET_UPDATE .Or.  __nFolderActive == CONCILIACAO
            cIniPadType  := ""
    EndCase

    oStruARF:SetProperty("ARF_STATUS", MODEL_FIELD_INIT, FWBuildFeature( STRUCT_FEATURE_INIPAD, '"1"'))
    oStruARF:SetProperty("ARF_TIPO", MODEL_FIELD_INIT, FWBuildFeature( STRUCT_FEATURE_INIPAD, '"'+cIniPadType+'"'))

    oModel:InstallEvent("monitorBillingEvent", /*cOwner*/, oEvent)
    oModel:SetDescription(cDescription)

Return oModel

/*/{Protheus.doc} ViewDef
    Definição da visão de dados da rotina
    
    @type  Function
    @author Squad TechFin
    @since 27/08/2025
    @version 1.0
    @return oView, Object, Visão de dados
/*/
Function ViewDef() as Object
    Local oStruARF  := FWFormStruct(2, 'ARF')  as Object
    Local oModel    := FWLoadModel('totvs.protheus.backoffice.techfin.antecipa.postbilling.monitorBilling') as Object
    Local oView     := FWFormView():New()   as Object

    oView := FWFormView():New()
    oView:SetModel( oModel )

    oStruARF:RemoveField('ARF_TIPO')
    oStruARF:RemoveField('ARF_IDMOV')

    If __nOptionMVC == MODEL_OPERATION_INSERT
        oStruARF:RemoveField('ARF_STATUS')
        oStruARF:RemoveField('ARF_DEBREC')
    Endif

    If __nFolderActive <> PRORROGACAO
        oStruARF:RemoveField('ARF_VENATU')
        oStruARF:RemoveField('ARF_VENNOV')
    Endif

    If __nFolderActive <> BONIFICACAO
        oStruARF:RemoveField('ARF_DESCON')
    Endif

    If __nFolderActive <> RECOMPRA
        oStruARF:RemoveField('ARF_RECOMP')
    Endif

    oView:AddField( 'VIEW_ARF', oStruARF, 'ARFMASTER' )
    oView:CreateHorizontalBox( 'SUPERIOR', 100 )
    oView:SetOwnerView( 'VIEW_ARF', 'SUPERIOR' )

Return oView

/*/{Protheus.doc} confirmRequest
    Tela de confirmação que irá apresentar um resumo da transação 
    que irá acontecer com a TECHFIN, após a confirmação deverá gravar os atributos
    em campos especificos 
    @type  Function
    @author Squad TechFin
    @since 02/09/2025
    @version version
    @param oModel, Object, Modelo de dados ativo que contem as informações do formulario
/*/
Function confirmRequest(oModel as Object, jSimulation as Json) as Logical
	local oModal         := Nil                     as Object
    local lConfirm       := .F.                     as Logical
    local aArea          := FwGetArea()             as Array
    local aAreaSA1       := SA1->(FwGetArea())      as Array
    Local cCustomerCode  := ""                      as Character
    Local cCustomerStore := ""                      as Character
    Local cCustomer      := ""                      as Character
    Local nCusto         := 0                       as Numeric
    Local nTotalDebit    := 0                       as Numeric
    Local nPending       := 0                       as Numeric
    Local nRate          := 0                       as Numeric
    Local cPicture       := "@E 999,999,999,999.99" as Character
    Local cCompanyName   := ""                      as Character
    Local cCompanyCGC    := ""                      as Character
    Local cCompany       := ""                      as Character

    cCompanyCGC    := FWSM0Util():GetSM0Data(cEmpAnt, cFilAnt, { "M0_CGC" })[1][2]
    cCompanyName   := SubStr(FWSM0Util():getSM0FullName(cEmpAnt, cFilAnt), 1, 19)
    cCustomerCode  := oModel:GetValue("ARFMASTER","ARF_CLITIT")
    cCustomerStore := oModel:GetValue("ARFMASTER","ARF_LOJTIT")

    DbSelectArea("SA1")
    SA1->(DbSetOrder(1))
    SA1->(MsSeek(xFilial("SA1") + cCustomerCode + cCustomerStore))
    cCustomer  := Transform(SA1->A1_CGC, Iif(Len(Alltrim(SA1->A1_CGC)) == 11, '@R 999.999.999-99', '@R! NN.NNN.NNN/NNNN-99')) + " - " + SA1->A1_NREDUZ
    cCompany   := Transform(cCompanyCGC, Iif(Len(Alltrim(cCompanyCGC)) == 11, '@R 999.999.999-99', '@R! NN.NNN.NNN/NNNN-99')) + " - " + cCompanyName
    oModal := totvs.protheus.backoffice.techfin.util.TechfinDialog():new() 
    
    Do case
        Case __nFolderActive == PRORROGACAO

            nCusto := jSimulation["data"]["processingData"][1]["installmentFeeDebitedAmount"]
            oModal:setTitle(STR0020) //"Solicitação Prorrogação de Vencimento"
            oModal:setText(20, 10,"<b>" + STR0036 + "</b>") //Título
            oModal:setText(30, 10, oModel:GetValue('ARFMASTER','ARF_NUMTIT')) 
            oModal:setText(20, 130, "<b>" + STR0037 + "</b>") //Emitente
            oModal:setText(30, 130, cCompany)
            oModal:setText(50, 10, "<b>" + STR0032 + "</b>") //Cliente
            oModal:setText(60, 10, cCustomer)
            oModal:setText(80, 10,"<b>" + STR0025+ "</b>") //"Vencimento atual"
            oModal:setText(90, 10,  DTOC(oModel:GetValue('ARFMASTER','ARF_VENATU')))
            oModal:setText(80, 130,"<b>" + STR0026 + "</b>")  //"Novo vencimento solicitado"
            oModal:setText(90, 130,  DTOC(oModel:GetValue('ARFMASTER','ARF_VENNOV')))
            oModal:setText(110, 10, "<b>" + STR0027+ "</b>") //"Custo de prorrogação"
            oModal:setText(120, 10, "R$ " + AllTrim(Transform(nCusto, cPicture)))

        Case __nFolderActive == BONIFICACAO

            nCusto := jSimulation["data"]["processingData"][1]["installmentFeeDebitedAmount"]
            oModal:setTitle(STR0021) //"Solicitação de desconto"
            oModal:setText(20, 10, "<b>" + STR0036 + "</b>") //Título
            oModal:setText(30, 10,  oModel:GetValue('ARFMASTER','ARF_NUMTIT')) 
            oModal:setText(20, 130, "<b>" + STR0037 + "</b>") //Emitente
            oModal:setText(30, 130, cCompany)
            oModal:setText(50, 10,  "<b>" + STR0032 + "</b>") //Cliente
            oModal:setText(60, 10,  cCustomer)
            oModal:setText(50, 130, "<b>" + STR0028 + "</b>") //"Total de desconto solicitado"
            oModal:setText(60, 130, "R$ " + AllTrim(Transform(oModel:GetValue('ARFMASTER','ARF_DESCON'),PesqPict("ARF","ARF_DESCON"))))
            oModal:setText(80, 10,  "<b>" + STR0029+ "</b>") //"Custo do desconto"
            oModal:setText(90, 10,  "R$ " + AllTrim(Transform(nCusto, cPicture)))
            oModal:setText(110, 10, "<b>" +STR0030+ "</b>") //"*Sem atualização por encargos de atraso"

        Case __nFolderActive == RECOMPRA
            
            nPending    := jSimulation["data"]["processingData"][1]["installmentPendingAmount"]
            nRate       := jSimulation["data"]["processingData"][1]["installmentRate"]
            nTotalDebit := jSimulation["data"]["processingData"][1]["installmentTotalDebitAmount"]
            
            oModal:setTitle(STR0022) //"Solicitação de recompra"
            oModal:setText(20, 10,  "<b>" + STR0036 + "</b>") //Título
            oModal:setText(30, 10,  oModel:GetValue('ARFMASTER','ARF_NUMTIT'))  
            oModal:setText(20, 130, "<b>" + STR0037 + "</b>") //Emitente
            oModal:setText(30, 130, cCompany)
            oModal:setText(50, 10,  "<b>" + STR0032 + "</b>") //Cliente
            oModal:setText(60, 10,  cCustomer)
            oModal:setText(50, 130, "<b>" + STR0038 + "</b>") //Valor do título
            oModal:setText(60, 130, AllTrim(Transform(nPending, cPicture)))
            oModal:setText(80, 10,  "<b>" + STR0034 + "</b>") //"Taxa de recompra"
            oModal:setText(90, 10,  AllTrim(Transform(nRate, "@E 999.99")) + "% (%a.m)")
            oModal:setText(80, 130, "<b>" +  STR0035 + "</b>") //"Debito da recompra"
            oModal:setText(90, 130, "R$ " + AllTrim(Transform(nTotalDebit, cPicture)))
    EndCase
            
    lConfirm := oModal:openConfirm()

    If !lConfirm
        Help(,,"CANCELADO",,STR0039,1,0, NIL, NIL, NIL, NIL, NIL, {STR0040}) //"Operação cancelada // Operação cancelada pelo usuário"                
    Else
        if len(FWSX3Util():GetFieldStruct( "ARF_DEBREC" )) > 0 .and. nTotalDebit > 0 
            oModel:SetValue("ARFMASTER","ARF_DEBREC",nTotalDebit)
        EndIF   

        if len(FWSX3Util():GetFieldStruct( "ARF_CUSTO" )) > 0 .and.  nCusto > 0 
            oModel:SetValue("ARFMASTER","ARF_CUSTO",nCusto)
        EndiF
    EndIf
    
    FwRestArea(aAreaSA1)
    FwRestArea(aArea)
Return lConfirm


/*/{Protheus.doc} prepareMessage
    Prepara a mensagem que será enviada para o TOTVS Antecipa
    @type  Function
    @author Squad TechFin
    @since 02/09/2025
    @param lSimulation, Logical, Indica se é uma simulação ou confirmação
    @param oMaster, Object, Modelo de dados ativo que contem as informações do formulario
    @param cMSUID, Character, Identificador unico do titulo no ERP
    @return Character, Mensagem formatada em JSON
/*/
Function prepareMessage(lSimulation as Logical, oMaster as Object, cMSUID as Character) as Character
    Local jData                   := JsonObject():New()             as Json
    Local jProcess                := JsonObject():New()             as Json
    Local cTransactionCode        := ""                             as Character
    Local cCliDocument            := ""                             as Character
    Local aArea                   := FwGetArea()                    as Array
    Local aAreaARE                := ARE->(FwGetArea())             as Array
    Local cErpId                  := ""                             as Character
    Local cTipoOper               := oMaster:GetValue('ARF_TIPO')   as Character
    Local nType                   := 0                              as Numeric

    Default cMSUID := ""
    Default lSimulation := .T.

    Do Case
        Case cTipoOper == TPRECOMPRA
            nType := 0 
        Case cTipoOper == TPPRORROGACAO
            nType := 1
        Case cTipoOper == TPBONIFICACAO
            nType := 2
    EndCase

    DbSelectArea("ARE")
    ARE->(DbSetOrder(1)) //ARE_FILIAL, ARE_NUM, ARE_ITEM,
    If ARE->(DbSeek(FWxFilial("ARE", oMaster:GetValue('ARF_FILTIT')) + oMaster:GetValue('ARF_NUMSOL') + oMaster:GetValue('ARF_ITEM')))
        cTransactionCode := AllTrim(ARE->ARE_TRANSC)
        dbSelectArea("SA1")
        SA1->(DbSetOrder(1))
        If SA1->(DbSeek(FWxFilial("SA1", oMaster:GetValue('ARF_FILTIT'))+ARE->ARE_CLITIT+ARE->ARE_LOJTIT))
            cCliDocument := SA1->A1_CGC
        EndIF
    EndIf

    If lSimulation
        cErpId :=  oMaster:GetValue('ARF_NUMSOL') + "|" + oMaster:GetValue('ARF_ITEM')
    Else
        cErpId := cMSUID
    EndIf

    jData["respondTo"]     := "AntecipaPostBillingExecuteResponseV1"
    jData["requestType"]   := If(lSimulation, 1, 2) //1 - Simulação;2 - Confirmação.
    jData["dataToProcess"] := {}

    jProcess["processingType"]          := nType           //0 - Recompra;1 - Prorrogação de vencimento;2 - Bonificação
    jProcess["transactionCode"]         := cTransactionCode
    jProcess["customerDocumentNumber"]  := cCliDocument
    jProcess["erpInstallmentId"]        := cErpId
    jProcess["installmentNumber"]       := 1
    Do Case
        Case nType == 1
            //jProcess["installmentExtensionDays"] := 0 //Número de dias a prorrogar na parcela desejada
            jProcess["newDueDate"]  := SubSTR(FWTimeStamp(5, oMaster:GetValue('ARF_VENNOV')), 1, 10) //Nova data de vencimento desejada.
        Case nType == 2
            jProcess["bonusAmount"] := oMaster:GetValue('ARF_DESCON') //Valor a ser bonificado na transação
    EndCase

    AADD(jData["dataToProcess"], jProcess)

    FwRestArea(aAreaARE)
    FwRestArea(aArea)
Return jData:toJson()

/*/{Protheus.doc} simulation
    Envia a solicitação de simulação para o TOTVS Antecipa, aguardando o retorno
    com os dados da simulação para que o usuário possa confirmar a solicitação
    @type  Function
    @author Squad TechFin
    @since 02/09/2025
    @param oModel, Object, Modelo de dados ativo que contem as informações do formulario
    @return Logical, true se a simulação foi aprovada, false se não
/*/
Function simulation(oModel as Object) as Logical
    Local cRequest      := ""                                     as Character
    Local cResponse     := ""                                     as Character
    Local lRet          := .F.                                    as Logical
    Local jResponse     := JsonObject():New()                     as Json
    Local cFilaRequest  := "AntecipaPostBillingExecuteRequestV1"  as Character
    Local cFilaResponse := "AntecipaPostBillingExecuteResponseV1" as Character    
    Local bBlockSim                                               as codeblock
    Local oSmartUtil                                              as object
    
    cRequest  := prepareMessage(.T., oModel:getModel('ARFMASTER'))    
    oSmartUtil := totvs.protheus.backoffice.techfin.util.SmartlinkUtil():new()
    bBlockSim:= {|| cResponse := oSmartUtil:sendAndAwaitResponse(cFilaRequest, cFilaResponse, cRequest, .T.) }
    FWMsgRun(, bBlockSim, '', STR0050)//"Estamos processando sua simulação junto a Totvs Techfin. Isso pode levar alguns isntantes..."

    If !Empty(cResponse)
        jResponse:fromJson(cResponse)
        If validateResponse(oModel, jResponse)
            lRet := confirmRequest(oModel, jResponse)
        EndIf
    Else
        Help(,,"CANCELADO",,STR0039,1,0, NIL, NIL, NIL, NIL, NIL, {STR0040}) //"Operação cancelada // Operação cancelada pelo usuário"
    EndIf
Return lRet

/*/{Protheus.doc} validateResponse
    Validação da resposta da simulação, garantindo que os dados retornados
    estão coerentes com a solicitação realizada
    @type function
    @author Squad TechFin
    @since 10/8/2025
    @param oModel, object, model 
    @param jResponse, json, response
    @return logical, true se estiver ok, false se não
/*/
Function validateResponse(oModel as Object, jResponse as Json) as Logical
    Local lRet           := .F.                                        as Logical
    Local cReason        := ""                                         as character
    local cDecoded       := ""                                         as character
    Local cNumSol        := oModel:GetValue("ARFMASTER", "ARF_NUMSOL") as character
    Local cItem          := oModel:GetValue("ARFMASTER", "ARF_ITEM")   as character
    Local cTipoOper      := oModel:GetValue("ARFMASTER", "ARF_TIPO")   as character
    Local aInstallmentId := {}                                         as Array

    If jResponse["data"]["requestType"] == 1 .And. Len(jResponse["data"]["processingData"]) > 0 //requestType: 1=Simulação  
        //hoje só processa 1
        If jResponse["data"]["processingData"][1]["requestStatus"] <> 1 //Diferente de aprovada.
            cReason := jResponse["data"]["processingData"][1]["reason"]
            cDecoded:=DecodeUTF8(cReason)
	        if !Empty(cDecoded)
		        cReason := cDecoded
	        endIf
        Else
            aInstallmentId := StrTokArr2(jResponse["data"]["processingData"][1]["erpInstallmentId"], "|", .T.)
            lRet := cNumSol == aInstallmentId[1] .And. cItem == aInstallmentId[2]
        EndIf
    EndIf
    //validação conforme o tipo de operação
    If lRet
        Do Case
            Case cTipoOper == TPRECOMPRA
                lRet := jResponse["data"]["processingData"][1]["processingType"] == 0; //0 - Recompra;1 - Prorrogação de vencimento;2 - Bonificação.                    
                    .And. jResponse["data"]["processingData"][1]:hasProperty("installmentRate")
            Case cTipoOper == TPPRORROGACAO
                lRet := jResponse["data"]["processingData"][1]["processingType"] == 1;
                    .And. jResponse["data"]["processingData"][1]:hasProperty("installmentFeeDebitedAmount")                    
            Case cTipoOper == TPBONIFICACAO
                lRet := jResponse["data"]["processingData"][1]["processingType"] == 2;
                    .And. jResponse["data"]["processingData"][1]:hasProperty("installmentFeeDebitedAmount")
        EndCase
    EndIf

    If !lRet
        If !Empty(cReason)
            Help(,,"SIMULACAOVALID",, cReason, 1, 0, NIL, NIL, NIL, NIL, NIL, {})            
        Else
            Help(,,"SIMULACAORESP",, STR0043,1,0, NIL, NIL, NIL, NIL, NIL, {STR0044}) //Problema com a simulação //Tente novamente mais tarde
        EndIF
    EndIf
Return lRet

