#include "tlpp-core.th"
#include "fwmvcdef.ch"
#include "totvs.ch"
#include "backoffice.techfin.util.ch"

NAMESPACE totvs.protheus.backoffice.techfin.util

static __oQryRules      := nil as Object
static __aSM0           := {}  as Array
static __aStoredXML     := {}  as Array
static __oQryArlPload   := ""  as character
static __cRegistryURL   := ""  as character
static __oExecActive    := nil as object
static __lTssReady

/*/{Protheus.doc} IsActive
    Verifica se existe integração ativa - CNPJs habilitados
    @type       Function
    @author     Squad TechFin
    @since      28/07/2025
    @version    P12.1.2510
    @param  cProdTF         , chracter, prouto Techfin a ser verificado
    @param  lDisplayMessage , logical , indica se apresenta mensagem
    @return lIsActive, logical, indica se há CNPJs ativos na integração com Antecipa Techfin
/*/
Function IsActive(cProdTF as Character, lDisplayMessage as Logical) as Logical
    Local oModal    := nil         as Object
    Local lIsActive := .F.         as Logical
    Local cQuery    := ""          as Character
    Local cLinkProd := ""          as Character
    Local cMsgProd  := ""          as Character

    Default cProdTF         := "1"
    Default lDisplayMessage := .F.

    If AliasInDic("ARA")
        If __oExecActive == Nil
            cQuery := "SELECT COUNT(ARA_CNPJ) ATIVO FROM " + RetSQLName("ARA")
            cQuery += " WHERE ARA_FILIAL = ? "
            cQuery += " AND ARA_PRODTF =  ? "
            cQuery += " AND ARA_STATUS =  ? "
            cQuery += " AND D_E_L_E_T_ = ? "
            cQuery += " AND ARA_FILSM0 = ? "

            __oExecActive := FwExecStatement():New(ChangeQuery(cQuery))
        EndIf

        __oExecActive:setString(1, FwxFilial("ARA"))
        __oExecActive:setString(2, cProdTF)
        __oExecActive:setString(3, "0")
        __oExecActive:setString(4, " ")
        __oExecActive:setString(5, cFilAnt)
        
        lIsActive := __oExecActive:execScalar("ATIVO") > 0
    EndIf

    If !lIsActive.and. lDisplayMessage
        oModal := totvs.protheus.backoffice.techfin.util.TechfinDialog():new()
        oModal:setTitle("Olá!")
        If cProdTF=='1'
            oModal:setText(15, 10, "Percebemos que você tem interesse em antecipar seus recebíveis com o Antecipa Techfin.")
            cMsgProd  := "Aproveite essa oportunidade para otimizar seu fluxo de caixa e dar mais agilidade ao seu negócio. Clique abaixo para mais informações."
            cLinkProd := FwTotvsAppsRegistry():GetServiceURL( "techfin-antecipa-erpbank-prospect", "1" )
        Else
            oModal:setText(15, 10, "Percebemos que você tem interesse em prorrogar seus pagamentos com o TOTVS Mais Prazo.")
            cMsgProd  := "Aproveite essa oportunidade para ganhar mais flexibilidade e planejamento financeiro para o seu negócio. Clique abaixo para mais informações."
            cLinkProd := FwTotvsAppsRegistry():GetServiceURL( "techfin-maisprazo-erpbank-prospect", "1" )
        EndIf		
        oModal:setText(30, 10, cMsgProd)
        oModal:setButton("Conhecer mais", {|| ShellExecute("open",cLinkProd,"","",1), oModal:DeActivate() })
        oModal:setButton("Cancelar", {|| oModal:DeActivate() })
        oModal:openInfo(100, 250)
    Endif

Return lIsActive

/*/{Protheus.doc} antecipaDependencies
    Verifica se as dependências do Anticipa estão ok
    @type function
    @author Renato Ito
    @since 9/8/2025
    @param lHelp, logical, indica se exibe o help do ambbietne desatualizado
    @return logical, true se as dependências não estão ok
/*/
Function antecipaDependencies(lHelp as logical)
    local lRet   := .F. as logical
    local oModal := Nil as Object

    // Validações de dicionário
    lRet := AliasInDic("ARA") .AND. AliasInDic("ARD") .AND. AliasInDic("ARE") .AND. AliasInDic("ARF") .AND.;
        AI0->(FieldPos("AI0_TFLIMD")) > 0 .AND. ARD->(FieldPos("ARD_MSUID")) > 0 .AND. ARE->(FieldPos("ARE_MSUID")) > 0

    // Validações de dependencias
    if lRet
        lRet := tlpp.ffunc("totvs.protheus.backoffice.techfin.antecipa.solicitacao.Antecipate");
            .and. tlpp.ffunc("totvs.protheus.backoffice.techfin.antecipa.monitor.AntecipaRequests");
            .and. tlpp.ffunc("totvs.protheus.backoffice.techfin.antecipa.limits.AntecipaLimits");
            .and. tlpp.ffunc("totvs.protheus.backoffice.techfin.antecipa.postbilling.monitorBilling");
            .and. tlpp.ffunc( "totvs.protheus.backoffice.techfin.util.IsActive" )
    endIf

    if !lRet .and. lHelp
        //verificar a mensagem que será apresentado quando o ambiente estiver desatualizado.
        Help("", 1, "DESATUALIZADO", , STR0002, 1, 0, NIL, NIL, NIL, NIL, NIL, {STR0002})
    endIf
    // Validação de parametros do sistema
    if lRet
        lRet := !(Empty(SuperGetMv("MV_CARTECF", .F., ""));
        .Or. Empty(SuperGetMv("MV_DEVTECF", .F., ""));
        .Or. Empty(SuperGetMv("MV_BCOTECF", .F., ""));
        .Or. Empty(SuperGetMv("MV_AGETECF", .F., ""));
        .Or. Empty(SuperGetMv("MV_CTNTECF", .F., ""));
        .Or. Empty(SuperGetMv("MV_MOTTECF", .F., "")))
        if !lRet .and. lHelp
            oModal := totvs.protheus.backoffice.techfin.util.TechfinDialog():new()
            oModal:setTitle("Antecipa Techfin - "+ STR0013 ) //Configuração Pendente
            oModal:setText(10, 10, STR0014 ) // "Para utilizar o Antecipa Techfin, é necessário configurar os parâmetros do sistema."
            oModal:setText(30, 10, STR0015) // "Clique no botão abaixo para acessar a documentação e saber como realizar a configuração."
            oModal:setButton(STR0016, {|| ShellExecute("open","https://tdn.totvs.com/pages/viewpage.action?pageId=989575704","","",1) }) //"Documentação"
            oModal:openInfo(100, 230)
        endIf
    endIf

Return lRet

/*/{Protheus.doc} logSmartLink
    Log das mensagens trafegadas via smartlink
    @type       Function
    @author     Squad TechFin
    @since      28/07/2025
    @version    P12.1.2510
    @param cMessage  , character, mensagem recebido do smartlink
    @param cAlias    , character, tabela origem
    @param cUUID     , character, uuiid origem do registro
    @param cProduct  , character, 1=Antecipa;2=Mais Prazo;3=Capital de Giro
    @param cOperation, character, operação que está sendo realizada
    @param cOrigin   , character, Origem do log P=Protheus;T=Techfin
    @param cIDReq    , character, ID da requisicao
	@param cLogNeg   , character, log de regras de negócio envolvidas no processameto da mensagem
/*/
Function logSmartLink(cMessage as character, cAlias as character, cUUID as character, cProduct as character, cOperation as character, cOrigin as character, cIDReq as character, cLogNeg as character)

    totvs.protheus.backoffice.techfin.util.logARL(cMessage, cAlias, cUUID, cProduct, cOperation, cOrigin, cIDReq, cLogNeg)

Return

/*/{Protheus.doc} formatLog
    Formata a mensagem de log para JSON
    @type       Function
    @author     Squad TechFin
    @since      28/07/2025
    @param aLogs  , array    , [1]=Type (info,error), [2]=Message, [3]=DetailedMessage
    @return cLog  , character, mensagem formatada em JSON
/*/
function formatLog(aLogs as array) as character

    local jLogMessage := JsonObject():new() as json
    local nlog        := 0                  as numeric
    Local cType       := ""                 as character //info, error
    Local cLog        := ""                 as character

    jLogMessage['integrationLog'] := {}

    for nlog := 1 to Len(aLogs)
        cType := if(aLogs[nlog][1] == "info", "info", "error")
        AADD(jLogMessage['integrationLog'], {;
            "type": cType,;
            "message": aLogs[nlog][2],;
            "detailedMessage": aLogs[nlog][3];
        })
    next nlog

    cLog := jLogMessage:toJson()
    FwFreeObj(jLogMessage)

return cLog

/*/{Protheus.doc} loadEligibilityRules
    Carrega as regras de elegibilidade do banco de dados
    @type       Function
    @author     Squad TechFin
    @since      28/07/2025
    @version    P12.1.2510
    @param cProduto, character, código do produto (1=Antecipa;2=Mais Prazo;3=Capital de Giro)
    @param cCnpj   , character, CNPJ do emitente da nota fiscal
    @return aRules , array, array com as regras carregadas
/*/

Function loadEligibilityRules(cProduto as character, cCnpj as character) as Array
    Local aRules := {}      as Array
    Local cQuery := ""      as Character
    Local cAlias := ""      as Character
    Local oStatment         as Object
    Local lHasStatus := .F.	as Logical
    Local nCount     := 0	as Numeric

    DEFAULT cProduto := ""
    DEFAULT cCnpj    := ""

    if FWSX3Util():SeekX3File('ARB_STATUS') 
		lHasStatus := .T.	    
    EndIf 
    
    If !Empty(cProduto) .and. !Empty(cCnpj)
        cQuery := "SELECT ARB.ARB_COD, ARB.ARB_DESC, ARB.ARB_REGRA FROM " + RetSQLName("ARB") + " ARB "
        cQuery += " WHERE ARB.ARB_CNPJ = ? "
        cQuery += " AND ARB.ARB_PRODTF = ? "
        cQuery += " AND ARB.ARB_REGRA <> ? "
        If lHasStatus
		    cQuery += " AND ARB.ARB_STATUS In (?) "
        EndIf 
        cQuery += " AND ARB.D_E_L_E_T_ = ? "

        oStatment := FwExecStatement():New(cQuery)

        oStatment:SetString(nCount+=1, cCnpj)
        oStatment:SetString(nCount+=1, cProduto)
        oStatment:SetString(nCount+=1, " ")
        If lHasStatus
            //" " = legado ainda não gravado, "1" = Ativo
            oStatment:SetIn(nCount+=1, {" ","1"})
        EndIF
        oStatment:SetString(nCount+=1, " ")
        cAlias := oStatment:OpenAlias()
        While (cAlias)->(!EoF())
            Aadd(aRules, { (cAlias)->(ARB_COD), (cAlias)->(ARB_REGRA), AllTrim((cAlias)->(ARB_DESC)) })
            (cAlias)->(DbSkip())
        EndDo
        (cAlias)->(DbCloseArea())
        oStatment:destroy()
    Endif
Return(aRules)

/*/{Protheus.doc} execEligibilityRules
    Executa as regras de elegibilidade carregadas em aRules.
    Retorna vazio se todas as regras forem elegíveis ou a mensagem da primeira regra não elegível encontrada.
    As tabelas precisam estar posicionadas corretamente.
    @author Squad TechFin
    @since 9/24/2025
    @param aRules, array, array com as regras carregadas
    @return character, retorna vazio se todas as regras forem elegíveis ou a mensagem da primeira regra não elegível encontrada.
*/
Function execEligibilityRules(aRules as array) as character
    Local nX         := 0 as numeric
    Local cError     := "" as character
    Local oError as object
    Try
        For nX := 1 to Len(aRules)
            If (&(aRules[nX][2]))
                cError += "! " + If( Empty( aRules[nX][3]), STR0017, aRules[nX][3] ) + CRLF //"Motivo não disponível"
            EndIF
        Next nX
    Catch oError
        cError := STR0003 + " " + CRLF +;              //Erro na execução das regras de elegibilidade.
                    STR0004 +": " + oError:Description //Descrição do erro
    EndTry
Return cError

/*/{Protheus.doc} TssIsReady
    Verifica se a conexao com o TSS pode ser estabelecida
    @type       Function
    @author     Squad TechFin
    @since      18/08/2025
    @version    P12.1.2510
    @return logical, sucesso ou falha de conexão com TSS. 
/*/
Function TssIsReady() as Logical
    Local oWS       := nil as Object
    Local cURLTss   := ""  as Character
 
    if __lTssReady == nil
        cURLTss := SuperGetMv("MV_SPEDURL", .F., "")
        //Verifica se o servidor da Totvs esta no ar
        oWs := WsSpedCfgNFe():New()
        oWs:cUserToken := "TOTVS"
        oWS:_URL := AllTrim(cURLTss)+"/SPEDCFGNFe.apw"

        If oWs:CFGCONNECT()
            __lTssReady := .T.
        Else
            __lTssReady := .F.
        EndIf
        FWFreeObj(oWs)
    EndIf

Return __lTssReady


/*/{Protheus.doc} sendSmartLink
  Envia uma mensagem para o Audience do SmartLink da Totvs
    @type function
    @author Squad TechFin
    @since 8/20/2025
    @param cType     , character, tipo de mensagem que está sendo enviada
    @param cProduct  , character, 1=Antecipa;2=Mais Prazo;3=Capital de Giro
    @param cOperation, character, operação que está sendo realizada. Ex: Organization, Simulate
    @param cData     , character, conteúdo do que está sendo enviado
    @param lReqID    , logical  , indica se adiciona erpRequestId no data
    @param cReqKey   , character, chave complementar do erpRequestId
    @param lHelp     , logical, Define se deve ser exibido o help caso aconteça alguma falha com o smartlink
    @param cAlias    , character, identificação da tabela
    @param cMSUID    , character, id do registro
    @return cIdMsg   , character, se a mensagem foi enviada com sucesso, retorna o ID da mensagem, caso contrário retorna vazio
/*/
function sendSmartLink(cType as character,;
                        cProduct as character,;
                        cOperation as character,;
                        cData as character,; 
                        lReqID as logical,; 
                        cReqKey as character,; 
                        lHelp as logical,;
                        cAlias as character,;
                        cMSUID as character) as character

    local cIdMsg     := ""               as character
    local oSmartUtil := totvs.protheus.backoffice.techfin.util.SmartLinkUtil():new() as object
    
    DEFAULT cType := ""
    DEFAULT cData := "{}"
    DEFAULT lReqID := .F.
    DEFAULT cReqKey := ""
    DEFAULT lHelp := .T.
    DEFAULT cAlias := ""
    DEFAULT cMSUID := ""
    
    if !Empty(cAlias)
        oSmartUtil:setAliasMSUID(cAlias, .T., cMSUID)
    EndIf
    if oSmartUtil:send(cType, cData, lReqID, cReqKey, lHelp)
        cIdMsg := oSmartUtil:getMSGID()
    EndIf
    FwFreeObj(oSmartUtil)

return cIdMsg

/*/{Protheus.doc} getPayloadSmartLink
    Retorna o payload do log da mensagem
    @type function
    @author Squad Techfin
    @since 8/21/2025
    @param cProduct, character, produto
    @param cFila, character, fila
    @param cOrigin, character, Origem do log P=Protheus;T=Techfin
    @param cIDReq, character, ID da requisição
    @return cPayload, payload da mensagem
/*/
function getPayloadSmartLink(cProduct as character, cFila as character, cOrigin as character, cIDReq as character) as character
    local cQuery   := ""                                      as character
    local cPayload := ""                                      as character
    local cAlias   := ""                                      as character    

    if Empty(__oQryArlPload)
        cQuery := "SELECT R_E_C_N_O_ FROM " + RetSQLName("ARL")
        cQuery += " WHERE ARL_PRODTF = ?"
        cQuery += " AND ARL_FILA = ?"
        cQuery += " AND ARL_ORIGEM = ?"
        cQuery += " AND ARL_IDREQ = ?"
        cQuery += " AND D_E_L_E_T_ = ?"
        cQuery := ChangeQuery(cQuery)
        __oQryArlPload := FwExecStatement():New(cQuery)
    endIf
    __oQryArlPload:SetString(1, cProduct ) 
    __oQryArlPload:SetString(2, cFila ) 
    __oQryArlPload:SetString(3, cOrigin ) 
    __oQryArlPload:SetString(4, cIDReq ) 
    __oQryArlPload:SetString(5, ' ' ) 
    cAlias := __oQryArlPload:OpenAlias()   
    If (cAlias)->(!EoF())    
        DbSelectArea("ARL")
        ARL->(DbSetOrder(1))
        ARL->(DbGoTo((cAlias)->R_E_C_N_O_))
        cPayload := ARL->ARL_PLOAD
    endIf
    (cAlias)->(DbCloseArea())
return cPayload



/*/{Protheus.doc} setPositionByUUID
    Posiciona no registro pelo MSUID
    @type function
    @author Squad Techfin
    @since 9/12/2025    
    @param cAlias, character, identificação da tabela 
    @param cMSUID, character, UUID do registro
    @return lRet, logical, indica se conseguiu posicionar
/*/
function setPositionByUUID( cAlias as character, cMSUID as character ) as logical
    Local cQuery    := ""               as character
    Local cTypeDB   := ""               as character
    Local lRet      := .F.              as logical
    Local nRecno    := 0                as numeric
    Local aBind     := { cMSUID, " "}   as array
    Local cAliasOri := cAlias           as character    

    cTypeDB := TcGetDB()
    cQuery := "SELECT R_E_C_N_O_ FROM " + RetSQLName(cAlias)

    If !((cAlias)->(FieldPos(cAlias+"_MSUID") > 0))
        cAlias := SubStr(cAlias, 2, Len(cAlias)-1) 
    EndIf

    If cTypeDB == "ORACLE"
        cQuery += " WHERE "+cAlias+"_MSUID = HEXTORAW(?)"
    Else
        cQuery += " WHERE "+cAlias+"_MSUID = ?"
    EndIf

    cQuery += " AND D_E_L_E_T_ = ?"
    cQuery := ChangeQuery(cQuery)

    nRecno := MPSysExecScalar(cQuery, "R_E_C_N_O_", aBind)
    if nRecno > 0
        cAlias := cAliasOri
        DbSelectArea(cAlias)
        (cAlias)->(DbGoTo(nRecno))
        lRet := .T.
    EndIf

Return lRet

/*/{Protheus.doc} getFiscalDoc
    Retorna XML da NFe, convertido em Base64
    @type function
    @author Squad Techfin
    @since 9/172025
    @param cDocument, character, F2_SERIE + F2_DOC    
    @return cRetorno, character, XML da NFe convertido em Base64 (vazio se houve erro)
/*/
function getFiscalDoc( cDocument )
    Local oClient       as object
    Local cURL          as array
    Local aXMLDocuments as array    
    Local cXml          as character
    Local cIdEnt        as character
    Local aArea         as array
    Local nPosXml := 0  as numeric
    Local cErro   := '' as character
    Local cAviso  := '' as character
    Local cVerNfe := '' as character
        
    if (nPosXml:=AScan(__aStoredXML, {|x| x[1]==cFilAnt+cDocument })) > 0
        cXML := __aStoredXML[nPosXml,2]
        Return(cXML)
    EndIf

    aArea  := FwGetArea()    
    cURL   := PadR( GetNewPar( "MV_SPEDURL", "http://" ), 250 )
    cIdEnt := getCfgEntidade()

    oClient := WsNFesBra():New()
    oClient:cUSERTOKEN        := "TOTVS"
    oClient:nDIASPARAEXCLUSAO := 0
    oClient:cID_ENT           := cIdEnt
    oClient:_URL              := AllTrim(cURL) + "/NFeSBRA.apw"
    oClient:oWSNFEID          := NFesBra_NFes2():New()
                               
    oClient:oWSNFEID:oWSNotas := NFesBra_ArrayOfNFesId2():New()                
    AAdd( oClient:oWSNFEID:oWSNotas:oWSNFESID2, Nil )
    ATail( oClient:oWSNFEID:oWSNotas:oWSNFESID2 ) := NFesBra_NFesId2():New()
    ATail( oClient:oWSNFEID:oWSNotas:oWSNFESID2 ):cID := cDocument
                        
    If oClient:RetornaNotas()
        aXMLDocuments := oClient:oWsRetornaNotasResult:OWSNOTAS:oWSNFES3                
        If Len(aXMLDocuments) > 0            
            oXmlExp := XmlParser(aXMLDocuments[1]:oWSNFE:cXML,"_",@cErro,@cAviso)                
            If Type("oXmlExp:_NFE:_INFNFE:_VERSAO:TEXT") <> "U"
                cVerNfe := oXmlExp:_NFE:_INFNFE:_VERSAO:TEXT
            EndIF	
            cXML := '<?xml version="1.0" encoding="UTF-8"?>'    
            cXML += '<nfeProc xmlns="http://www.portalfiscal.inf.br/nfe" versao="' + cVerNfe + '">'        
            cXML += aXMLDocuments[1]:oWSNFE:cXML
            cXML += aXMLDocuments[1]:oWSNFE:cXMLPROT
            cXML += '</nfeProc>'
            cXML := Encode64(cXML)
            Aadd(__aStoredXML, {cFilAnt+cDocument, cXML})
        EndIf
    EndIf    
    FwRestArea(aArea)
    FwFreeArray(aArea)
    FwFreeArray( aXMLDocuments )
    FwFreeObj( oClient )    
    
Return cXml

/*/{Protheus.doc} awaitSmartLink
    Função que realiza o envio de uma mensagem ao smartlink e aguarda a resposta
    @type  Function
    @author Squad TechFin
    @since 16/09/2025
    @version 1.0
    @param cProduct, Character, Codigo do produto (1=Antecipa, 2=Mais Prazo, 3=Capital de giro)
    @param cOperation, Character, Indica qual operação estamos realizando
    @param cFila, Character, Nome da fila de envio
    @param cFilaResp, Character, Nome da fila de resposta
    @param cData, Character, Dados da mensagem de envio, deve seguir o padrão estabelecido pela TECHFIN
    @return cResponse, Character, Resposta da TECHFIN capturada atraves do Log (ARL)
/*/
Function awaitSmartLink(cProduct as character, cOperation as character, cFila as character, cFilaResp  as character, cData as character) as character
    Local cResponse  := ""                                                           as character
    Local oSmartUtil := totvs.protheus.backoffice.techfin.util.SmartlinkUtil():new() as object
    DEFAULT cFila     := ""
    DEFAULT cFilaResp := ""
    DEFAULT cData     := ""
    cResponse := oSmartUtil:sendAndAwaitResponse(cFila, cFilaResp, cData, .T.)
    FwFreeObj(oSmartUtil)
Return cResponse

/*/{Protheus.doc} createColumnsBrowse
    Função que realiza a criação das colunas e campos de uma browse
    de acordo com a matriz passada por parametro
    @type  Function
    @author Squad TechFin
    @since 16/09/2025
    @version 1.0
    @param aFields, Array, Matriz contendo os campos {"E2_FILIAL", "E2_PREFIXO", "E2_NUM"}
    @param cAlias, Character, Alias da tabela em que as colunas serão criadas exemplo - "SE2"
    @return jResultBrowse, Json, json contendo as colunas e os campos formatados para serem usados em componente de Browse
/*/
Function createColumnsBrowse(aFields as array, cAlias as character) as json
    local aColumnsBrowse := {}                  as array
    local aFielsBrowse := {}                    as array
    local jResultBrowse := JsonObject():new()   as json
    local nX := 0                               as numeric
    local aTamSx3 := {}                         as array
    local cTitle := ""                          as character
    local cPicture := ""                        as character
    local cType := ""                           as character
    local aArea := FwGetArea()                  as array

    Default aFields := {}
    Default cAlias := Alias()

    DbSelectArea(cAlias)

    For nX := 1 To Len(aFields)
        If FieldPos(aFields[nX]) > 0
            aTamSx3 := TamSx3(aFields[nX])
            cTitle := Alltrim(RetTitle(aFields[nX]))
            cPicture := X3Picture(aFields[nX])
            cType := GetSX3Cache(aFields[nX], "X3_TIPO")

            AAdd(aColumnsBrowse, FWBrwColumn():New())
            aColumnsBrowse[Len(aColumnsBrowse)]:SetData(&("{||"+aFields[nX]+"}"))
            aColumnsBrowse[Len(aColumnsBrowse)]:SetType(cType)
            aColumnsBrowse[Len(aColumnsBrowse)]:SetTitle(cTitle)
            aColumnsBrowse[Len(aColumnsBrowse)]:SetSize(aTamSx3[1])
            aColumnsBrowse[Len(aColumnsBrowse)]:SetDecimal(aTamSx3[2])
            aColumnsBrowse[Len(aColumnsBrowse)]:SetPicture(cPicture)

            AAdd(aFielsBrowse, {;
                cTitle,; //Titulo do campo
                Alltrim(aFields[nX]),; //Nome do campo
                cType,; //Tipo do campo
                aTamSx3[1],; //Tamanho do campo
                aTamSx3[2],; //Decimais do campo
                cPicture; // Picture do campo
            })
        Endif
    Next nX

    jResultBrowse["columns"] := aColumnsBrowse
    jResultBrowse["fields"] := aFielsBrowse

    FwRestArea(aArea)
return jResultBrowse

/*/{Protheus.doc} createTemporaryTable
    Realiza a criação de uma tabela temporaria de acordo com os parametros
    passados para a função
    @type  Function
    @author Squad TechFin
    @since 22/09/2025
    @version version
    @param oTemporaryTable, Object, Objeto que referencia a FwTemporaryTable
    @param aFields, Array, Matriz contendo os campos
    @param aIndex, Array, Matriz contendo os indices
    @param cSelect, Character, Select que será inserido no comando de INSERT da tabela
/*/
Function createTemporaryTable(oTemporaryTable as object, aFields as array, aIndex as array, cSelect as character)
    local nX := 1               as numeric
    local cFields := ""         as character
    local cTableName := ""      as character
    local aInsertFields := {}   as array

    DEFAULT oTemporaryTable := NIL
    DEFAULT aFields := {}
    DEFAULT aIndex := {}
    DEFAULT cSelect := ""

    If oTemporaryTable == NIL
        oTemporaryTable := FWTemporaryTable():New()
        oTemporaryTable:SetFields(aFields)
        For nX := 1 to len(aIndex)
            oTemporaryTable:AddIndex(cValToChar(nX), aIndex[nX])
        Next nX
        oTemporaryTable:Create()
    Else
        oTemporaryTable:Zap()
    Endif
    
    If !Empty(cSelect)
        For nX := 1 to Len(aFields)
            Aadd(aInsertFields, aFields[nX][1])
        Next nX

        cTableName := oTemporaryTable:getRealName()
        cFields := " (" + ArrToKStr(aInsertFields, ",") + ") "

        cInsert := totvs.protheus.backoffice.fin.functions.FunctionToDb("INSERT", ALLTRIM(tcGetdb()))

        If TcSqlExec(cInsert + " INTO " + cTableName + cFields + "(" + cSelect + ")") < 0
            UserException(TCSQLError())
        Endif
    Endif
Return

/*/{Protheus.doc} maisPrazoDependencies
    Verifica se as dependências do Mais Prazo estão ok
    @type function
    @author Squad TechFin
    @since 24/09/2025
    @param lHelp, logical, indica se exibe o help do ambiente desatualizado
    @return logical, true se as dependências não estão ok
/*/
Function maisPrazoDependencies(lHelp as logical) as logical
    local lRet := .F. as logical

    DEFAULT lHelp := .T.
    
    // Validações de dicionário
    lRet := AliasInDic("ARA") .AND. AliasInDic("ARG") .AND. AliasInDic("ARH") .AND. ARH->(FieldPos("ARH_SLCODE")) > 0
    // Validações de dependencias
    if lRet
        lRet := tlpp.ffunc("totvs.protheus.backoffice.techfin.maisprazo.solicitacao.requestExtension");
                .and. tlpp.ffunc("totvs.protheus.backoffice.techfin.maisprazo.monitor.extensionMonitor");
                .and. tlpp.ffunc("totvs.protheus.backoffice.techfin.maisprazo.eligibility.eligibilityRules");
                .and. tlpp.ffunc("totvs.protheus.backoffice.techfin.maisprazo.suppliers.suppliersMonitor")
    endIf

    if !lRet .and. lHelp
        Help("", 1, "DESATUALIZADO", , STR0002, 1, 0, NIL, NIL, NIL, NIL, NIL, {STR0002}) //Ambiente desatualizado, por favor verifique!"
    endIf
    
Return lRet

/*/{Protheus.doc} processFile
    Realiza o processamento do arquivo atraves do base64 passado pelo
    parametro
    @type  Function
    @author Squad TechFin
    @since 15/10/2025
    @version 1.0
    @param cNameFile, Character, Nome do arquivo que será gerado
    @param cBase64, Character, Arquivo que deve ser gerado codificado em base64
/*/
Function processFile(cNameFile as character, cBase64 as character)
    local lHTML := GetRemoteType() == 5 as logical
    local cDirectory  := "/spool/"      as character

    DEFAULT cNameFile := ""
    DEFAULT cBase64 := ""

    If !IsSrvUnix()
        cDirectory := "\spool\"
    Endif

    If !lHTML .And. !IsBlind()
        cDirectory := cGetFile("", STR0007,, "", .F., nOr(GETF_LOCALHARD, GETF_NETWORKDRIVE), .F.) //Salvar como
    Endif

    Decode64(cBase64, cDirectory + cNameFile)

    If File(cDirectory + cNameFile)
        If lHTML
            CpyS2TW(cDirectory + cNameFile, .T.)
            FErase(cDirectory + cNameFile)
        Else
            ShellExecute("open", cDirectory + cNameFile, "", "", 1)
        Endif
    Endif
Return

/*/{Protheus.doc} approvalDialog
    Mensagem de dialog de aprovações para redirecionamento ao portal de aprovações
    @type  Function
    @author Squad TechFin
    @since 21/10/2025
    @param cProduto, Character, Código do produto (1=Antecipa, 2=Mais Prazo)
/*/
Function approvalDialog(cProduto as character)
    Local oModal      := totvs.protheus.backoffice.techfin.util.TechfinDialog():new() as object
    Local cServiceMP  := "techfin-maisprazo-erpbank-approve"                          as character
    Local cServiceANT := "techfin-antecipa-erpbank-approve"                           as character
    Local bBtnAction  := {|| ShellExecute("open", __cRegistryURL, "", "", 1) }        as codeblock
    Local cBtnLabel   := STR0008                                                      as character
    Local cText       := STR0010                                                      as character
    
    If Empty(__cRegistryURL)
        Do Case 
            Case cProduto == "1" //Antecipa
                __cRegistryURL := FwTotvsAppsRegistry():GetServiceURL(cServiceANT)
            Case cProduto == "2" //Mais Prazo
                __cRegistryURL := FwTotvsAppsRegistry():GetServiceURL(cServiceMP)
        EndCase
        If Empty(__cRegistryURL)
            bBtnAction := {|| oModal:DeActivate()}
            cBtnLabel  := STR0012 //"Ok, entendi"
            cText      := STR0011 //"Não foi possível acessar a página. O endereço não foi encontrado ou pode estar temporariamente indisponível."
        EndIf
    EndIf

    oModal:setButton(cBtnLabel, bBtnAction) // STR0008 Acessar
    oModal:setTitle(STR0009)                // Aprovações
    oModal:setText(10, 10, cText)           // STR0010 Você será direcionado para a plataforma de aprovações, fique tranquilo que sua segurança está garantida.
    oModal:openInfo(100, 230)

Return

/*/{Protheus.doc} CalcSaldoAtual
    Calcula o saldo atual do título, considerando os abatimentos e descontos financeiros
    @type function
    @author Squad TechFin
    @since 24/10/2025
    @param cAls, character, alias do título a ser calculado
    @return numeric, saldo atual do título
*/

Function CalcSaldoAtual(cAls as character) as numeric
    Local nSaldoAtu     := 0 as numeric
    Local nAbatimento   := 0 as numeric

    nAbatimento := SomaAbat((cAls)->E1_PREFIXO, (cAls)->E1_NUM, (cAls)->E1_PARCELA, "R", (cAls)->E1_MOEDA, dDataBase, (cAls)->E1_CLIENTE, (cAls)->E1_LOJA)
    If  ((cAls)->E1_DESCFIN) > 0
        nSaldoAtu :=(((cAls)->E1_SALDO - nAbatimento) * (1 - ((cAls)->E1_DESCFIN)/100)) + (cAls)->E1_SDACRES - (cAls)->E1_SDDECRE
    Else
        nSaldoAtu := ((cAls)->E1_SALDO - nAbatimento) + (cAls)->E1_SDACRES - (cAls)->E1_SDDECRE
    EndIf
Return nSaldoAtu
