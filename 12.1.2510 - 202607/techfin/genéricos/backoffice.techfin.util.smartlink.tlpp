#include "tlpp-core.th"
#include "Totvs.ch"
#include "BACKOFFICE.TECHFIN.UTIL.SMARTLINK.CH"

NAMESPACE totvs.protheus.backoffice.techfin.util

Class SmartlinkUtil
    Data oClient    as Object
    Data cOperation as character
    Data cAudience  as character
    Data cIDMsg     as character
    Data jPayload   as json
    Data jMock      as json
    Data lSuccess   as logical
    Data lAutomato  as logical
    Data cMSUID     as character
    Data cAlias     as character
    Data cType      as character
    Data cProduct   as character
    data aLogs      as array
    Public Method new() as Object
    Public Method setOperation()
    Public Method setAudience()
    Public Method setType()
    Public Method setAliasMSUID()
    Public Method setMSGID()
    Public Method getMSGID()
    Public Method sendAudience()
    Public Method send() as logical
    Public Method getRequestPayload() as json
    Public Method log()
    Public Method logResponse()
    Public Method addLogMSG()
    Public Method getLogs() as character
    Public Method sendProcessingResult() as logical
    Public Method sendAndAwaitResponse() as character
End Class

/*/{Protheus.doc} SmartlinkUtil::new
    construtor da classe
    @type method
    @author Squad TechFin.
    @since 10/30/2025
/*/
Method new() as object class SmartlinkUtil
    ::oClient    := FwTotvsLinkClient():New()
    ::cOperation := ""
    ::cIDMsg     := ""
    ::cAudience  := ""
    ::jPayload   := JsonObject():New()
    ::jMock      := JsonObject():New()
    ::lSuccess   := .F.
    ::cMSUID     := ""
    ::cAlias     := ""
    ::cType      := ""
    ::cProduct   := "" // 1=Antecipa;2=Mais Prazo;3=Capital de Giro;4=Conta Digital
    ::aLogs      := {}
    ::lAutomato  := Type("lSendAuto") == "L" .and. lSendAuto
Return self

/*/{Protheus.doc} SmartlinkUtil::setOperation
    Configura a operação com base no tipo de operação
    @type method
    @author Squad TechFin
    @since 10/30/2025
    @param cType, character, type da mensagem
/*/
Method setOperation(cType as character) class SmartlinkUtil
    local cOperation := cType as character

    cOperation := StrTran(cOperation, "GetResponseV1", "")
    cOperation := StrTran(cOperation, "ExecuteResponseV1", "")
    cOperation := StrTran(cOperation, "ExecuteRequestV1", "")
    cOperation := StrTran(cOperation, "CreateRequestV1", "")
    cOperation := StrTran(cOperation, "CreateResponseV1", "")
    cOperation := StrTran(cOperation, "Antecipa", "")
    cOperation := StrTran(cOperation, "ContaDigital", "")
    cOperation := StrTran(cOperation, "MaisPrazo", "")
    cOperation := StrTran(cOperation, "CapitalDeGiro", "")
    cOperation := StrTran(cOperation, "RequestV1", "")
    cOperation := StrTran(cOperation, "ResponseV1", "")
    ::cOperation := cOperation
Return
/*/{Protheus.doc} SmartlinkUtil::setAudience
    Configura a audiência com base no tipo de operação
    @type method
    @author Squad TechFin
    @since 10/30/2025
    @param cType, character, type da mensagem
/*/
Method setAudience(cType as character) class SmartlinkUtil
    if "Antecipa" $ cType
        ::cAudience := "Antecipa"
        ::cProduct := "1"
    elseIf "MaisPrazo" $ cType
        ::cAudience := "MaisPrazo"
        ::cProduct := "2"
    elseIf "CapitalDeGiro" $ cType
        ::cAudience := "CapitalDeGiro"
        ::cProduct := "3"
    elseIf "ContaDigital" $ cType
        ::cAudience := "ContaDigital"
        ::cProduct := "4"
    Endif
Return
/*/{Protheus.doc} SmartlinkUtil::setType
    Configura o type, operação e audiência com base no tipo de operação
    @type method
    @author Squad TechFin
    @since 10/30/2025
    @param cType, character, type da mensagem
    @param lConfig, logical, indica se deve configurar operação e audiência
/*/
Method setType(cType as character, lConfig as logical) class SmartlinkUtil
    DEFAULT lConfig := .T.
    ::cType := cType
    if lConfig
        ::setOperation(::cType)
        ::setAudience(::cType)
    endIf
Return
/*/{Protheus.doc} SmartlinkUtil::setAliasMSUID
    Configura o MSUID com base no alias informado
    @type method
    @author Squad TechFin
    @since 10/30/2025
    @param cAlias, character, alias do cliente
    @param lVerify, logical, indica se deve verificar o MSUID no alias
    @param cMSUID, character, MSUID configurado
/*/
Method setAliasMSUID(cAlias as character, lVerify as logical, cMSUID as character) class SmartlinkUtil
    Local cAliasAux := "" as character
    DEFAULT cMSUID  := ""
    DEFAULT lVerify := .T.
    DEFAULT cAlias  := ""
    ::cMSUID  := cMSUID
    ::cAlias  := cAlias
    if lVerify .and. Empty(cMSUID)
        cAliasAux := cAlias
        if SubStr(cAlias, 1, 1) == "S"
            cAliasAux := SubStr(cAlias, 2, 2)
        endif
        if (cAlias)->(FieldPos(cAliasAux+"_MSUID")) > 0
            ::cMSUID  := (cAlias)->&(cAliasAux+"_MSUID")
        endIf
    EndIf
Return
/*/{Protheus.doc} SmartlinkUtil::setMSGID
    Configura o MSGID para o envio da mensagem e verifica se está em modo automato
    @type method
    @author Squad TechFin
    @since 10/30/2025
/*/
Method setMSGID() class SmartlinkUtil
    ::cIDMsg := FWUuidV4(.T.)
    if Type("cIDMessageAuto") == "C" .and. !Empty(cIDMessageAuto)
        ::cIDMsg    := cIDMessageAuto
        ::lAutomato := .T.
    endIf
    if !::lAutomato .and. len(::jMock:getNames()) > 0
        ::lAutomato := .T.
        if ::jMock:hasProperty("id")
            ::cIDMsg := ::jMock["id"]
        endIf
    endIf
Return
/*/{Protheus.doc} SmartlinkUtil::getMSGID
    Retorna o MSGID configurado para o envio da mensagem
    @type method
    @author Squad TechFin
    @since 10/30/2025
/*/
Method getMSGID() class SmartlinkUtil
Return ::cIDMsg
/*/{Protheus.doc} SmartlinkUtil::sendAudience
    envia a mensagem ao Smartlink para a audiência informada
    @type method
    @author Squad TechFin
    @since 10/30/2025
    @param cMessage, character, data da mensagem
    @param lHelp, logical, indica se deve ajudar no envio
/*/
Method sendAudience(cMessage as character, lHelp as logical) class SmartlinkUtil
    local cError := '' as character
    DEFAULT lHelp := .T.

    ::lSuccess := ::oClient:SendAudience(::cType, ::cAudience, cMessage)
    if !::lSuccess .and. lHelp .and. !::lAutomato
        Help( '', 1, "SMARTLINK",,STR0001, 1, 0 )//"Problema de comunicação. Verifique a configuração do SmartLink"
    endIf
    if !::lSuccess 
        cError := ::oClient:GetError()
        If !Empty(cError)
            FwLogMsg("ERROR",,"TECHFIN",FunName(),"","SendAudience", "Class SmartlinkUtil Method SendAudience: "+cError)
        EndIF
    EndIf
Return
/*/{Protheus.doc} SmartlinkUtil::send
    envia a mensagem ao Smartlink
    @type method
    @author Squad TechFin
    @since 10/30/2025
    @param cType, character, type da mensagem
    @param cData, character, data da mensagem
    @param lReqID, logical, indica se deve gerar o ERPid da requisição
    @param cReqKey, character, chave adicional na mensagem
    @param lHelp, logical, indica se deve ajudar no envio
/*/
Method send(cType as character, cData as character, lReqID as logical, cReqKey as character, lHelp as logical) as logical class SmartlinkUtil
    local cMessage := "" as character
    local jData    := JsonObject():New()  as json
    local jPayload := JsonObject():New()  as json
    DEFAULT cType   := ""
    DEFAULT cData   := "{}"
    DEFAULT cReqKey := ""
    DEFAULT lHelp   := .T.

    ::lSuccess := .F.
    ::setType(cType, .T.)
    jData:fromJson(cData)
    if jData:hasProperty("mock")
        ::jMock := jData["mock"]
        jData:delName("mock")
    endIf
    jPayload := ::getRequestPayload()
    if lReqID
        jData["erpRequestId"] := cEmpAnt + "|" + cFilAnt + "|" + ::cIdMsg
        if !Empty(cReqKey)
            jData["erpRequestId"] += "|" + cReqKey
        endIf
    endIf
    jPayload["data"] := jData
    cMessage := jPayload:toJson()
    FreeObj(jPayload)
    FreeObj(jData)

    ::sendAudience(cMessage, lHelp)
    if ::lSuccess .or. ::lAutomato
        ::log("P", cMessage)
    endIf
Return ::lSuccess .or. ::lAutomato
/*/{Protheus.doc} SmartlinkUtil::getRequestPayload
    gera o payload padrão para envio ao Smartlink
    @type method
    @author Squad TechFin
    @since 10/30/2025
    @param cData, character, data da mensagem
    @param cType, character, type da mensagem
    @param cReqKey, character, chave adicional na mensagem
    @return character, payload gerado
/*/
Method getRequestPayload() as json class SmartlinkUtil
    ::setMSGID()
    ::jPayload := JsonObject():New()
    ::jPayload["specversion"]     := "1.0"
    ::jPayload["id"]              := ::cIdMsg
    ::jPayload["transactionid"]   := ::cIdMsg
    ::jPayload["source"]          := "/" + ::cOperation
    ::jPayload["time"]            := FWTimeStamp(5)
    ::jPayload["type"]            := ::cType
    ::jPayload["tenantid"]        := ::oClient:GetTenantClient()
    ::jPayload["datacontenttype"] := "application/json"
    ::jPayload["dataschema"]      := "https://schemas.totvs.io/events"
Return ::jPayload
/*/{Protheus.doc} SmartlinkUtil::log
    grava o log da mensagem enviada/recebida
    @type method
    @author Squad TechFin
    @since 10/30/2025
    @param cOrigin, character, origem da mensagem (P=Protheus;T=Techfin)
    @param cMessage, character, mensagem a ser logada
    @param cIDReq, character, id da requisição 
/*/
Method log(cOrigin as character, cMessage as character, cIDReq as character) class SmartlinkUtil
    local cLog := ::getLogs() as character

    logARL(cMessage, ::cAlias, ::cMSUID, ::cProduct, ::cOperation, cOrigin, cIDReq, cLog)

Return
/*/{Protheus.doc} SmartlinkUtil::logResponse
    grava o log da resposta recebida
    @type method
    @author Squad TechFin
    @since 10/30/2025
    @param cPayload, character, payload da resposta
    @param cIDReq, character, id da requisição de origem
/*/
Method logResponse(cPayload as character, cIDReq as character) class SmartlinkUtil
    local jMessage := JsonObject():new() as json
    local cType    := ""                 as character

    jMessage:fromJson(cPayload)
    cType := jMessage["type"]
    ::setType(cType, .T.)
    ::log("T", cPayload, cIDReq)
    FwFreeObj(jMessage)
Return
/*/{Protheus.doc} SmartlinkUtil::addLogMSG
    Adiciona uma mensagem de log ao array de logs
    @type method
    @author Squad TechFin
    @since 10/30/2025
    @param cType, character, tipo da mensagem ("info", "warning", "error")
    @param cMessage, character, mensagem principal
    @param cDetail, character, mensagem detalhada
    /*/
Method addLogMSG(cType as character, cMessage as character, cDetail as character) class SmartlinkUtil
    AAdd(::aLogs, { "type": cType, "message": cMessage, "detailedMessage": cDetail })
Return
/*/{Protheus.doc} SmartlinkUtil::getLogs
    Retorna os logs acumulados em formato JSON
    @type method
    @author Squad TechFin
    @since 10/30/2025
    @return character, logs em formato JSON
/*/
Method getLogs() as character class SmartlinkUtil
    local jLogMessage := JsonObject():new() as json
    Local cLog        := ""                 as character

    if len(::aLogs) > 0
        jLogMessage['integrationLog'] := ::aLogs
        cLog := jLogMessage:toJson()
    endIf
    FwFreeObj(jLogMessage)
Return cLog

/*/{Protheus.doc} SmartlinkUtil::sendProcessingResult
    Envia o resultado do processamento ao Smartlink
    @type method
    @author Squad TechFin
    @since 10/30/2025
    @param cStatus, character, status do processamento (Received, Created, Error)
    @param cType, character, type da mensagem
    @param cRequest, character, payload da Request
    @param cCodeError, character, código do erro (se aplicável)
    @param cErrorMSG, character, mensagem de erro (se aplicável)
    @return character, payload enviado
/*/
Method sendProcessingResult(cStatus as character, cType as character, cRequest as character, cCodeError as character, cErrorMSG as character) as logical class SmartlinkUtil
    local jData           := JsonObject():New() as json
    local jRequest        := JsonObject():New() as json
    local cMessage        := ""                 as character
    local jPayload        := JsonObject():New() as json
    local cIdempotencyKey := ""                 as character
    DEFAULT cType    := ""
    DEFAULT cRequest := ""
    ::setType(cType, .T.)
    
    if jRequest:fromJson(cRequest) == NIL .and. jRequest:hasProperty("data")
        if jRequest["data"]:hasProperty("idempotencyKey")
            cIdempotencyKey := jRequest["data"]["idempotencyKey"]
        endIf
        if jRequest:hasProperty("mock")
            ::jMock := jRequest["mock"]
        endIf
    endIf

    jPayload := ::getRequestPayload()
    jData["tenantId"]        := ::oClient:GetTenantClient()
    jData["id"]              := ::cIdMsg
    jData["idempotencyKey"]  := cIdempotencyKey
    jData["status"]          := cStatus
    jData["responseDetails"] := JsonObject():New()
    if cStatus == "Error"
        jData["responseDetails"]["code"]    := cCodeError
        jData["responseDetails"]["message"] := cErrorMSG
    endIf
    jPayload["data"] := jData
    cMessage := jPayload:toJson()
    FreeObj(jPayload)
    FreeObj(jData)

    ::lSuccess := .F.
    ::sendAudience(cMessage, .F.)
    if ::lSuccess .or. ::lAutomato
        ::cOperation += cStatus
        ::log("P", cMessage, cIdempotencyKey)
    endIf
Return ::lSuccess .or. ::lAutomato


/*/{Protheus.doc} SmartlinkUtil::awaitResponse
    Envia a mensagem ao Smartlink e aguarda a resposta
    @type method
    @author Squad TechFin
    @since 10/30/2025
    @param cType, character, type da mensagem
    @param cTypeResp, character, type da mensagem de resposta
    @param cData, character, data da mensagem
    @return character, payload da resposta
/*/
Method sendAndAwaitResponse(cType as character, cTypeResp as character, cData as character, lReqId as logical)as character class SmartlinkUtil
    local cResponse   := "" as character
    local nSleep      := 0  as numeric
    local jResponse   := JsonObject():new() as json
    DEFAULT cType     := ""
    DEFAULT cTypeResp := ""
    DEFAULT cData     := "{}"
    DEFAULT lReqId    := .F.

    ::send(cType, cData, lReqId)
    if ::lSuccess
        nSleep := 0
        while .T. 
            Sleep(1000)
            nSleep += 1
            cResponse := totvs.protheus.backoffice.techfin.util.getPayloadSmartLink(::cProduct, cTypeResp, "2", ::cIDMsg)

            if !Empty(cResponse)
                If jResponse:FromJson(cResponse) <> NIL 
                    Help( ,,"SMARTRESP",, STR0002, 1, 0 ) //Problema na reposta da TECHFIN! Não foi possível abrir a resposta.
                    cResponse := ""
                Endif
                cResponse := jResponse:toJson()
                exit
            endIf

            if nSleep == 10 
                if !MsgYesNo(STR0003, "") //"Ainda não houve retorno da Totvs Techfin, deseja aguardar?"
                    exit
                else 
                    nSleep := 0
                endIf
            endIf
        endDo
    endIf
    FreeObj(jResponse)
Return cResponse

/*/{Protheus.doc} logARL
    Log das mensagens trafegadas via smartlink
    @type       Function
    @author     Squad TechFin
    @since      28/07/2025
    @version    P12.1.2510
    @param cMessage  , character, mensagem recebido do smartlink
    @param cAlias    , character, tabela origem
    @param cUUID     , character, uuiid origem do registro
    @param cProduct  , character, 1=Antecipa;2=Mais Prazo;3=Capital de Giro
    @param cOperation, character, operação que está sendo realizada
    @param cOrigin   , character, Origem do log P=Protheus;T=Techfin
    @param cIDReq    , character, ID da requisicao
    @param cLogNeg   , character, log de regras de negócio envolvidas no processameto da mensagem
/*/
Function logARL(cMessage as character, cAlias as character, cUUID as character, cProduct as character, cOperation as character, cOrigin as character, cIDReq as character, cLogNeg as character)
    local jMessage := JsonObject():new() as json
    default cIDReq  := ''
    default cLogNeg := ''

    jMessage:fromJson(cMessage)
    dbSelectArea('ARL')

    BEGIN TRANSACTION
        RecLock('ARL',.T.)
            ARL->ARL_FILIAL  := FWxFilial('ARL')
            ARL->ARL_IDMSG   := jMessage['id']
            ARL->ARL_GRPSM0  := cEmpAnt
            ARL->ARL_FILSM0  := cFilAnt
            ARL->ARL_ENV     := GetEnvServer()
            ARL->ARL_TENANT  := jMessage['tenantid']
            ARL->ARL_FILA    := jMessage['type']
            ARL->ARL_IDREQ   :=  if(Empty(cIDReq), jMessage['transactionid'], cIDReq)
            ARL->ARL_USERID  := __cUserID
            ARL->ARL_PRODTF  := cProduct
            ARL->ARL_OPER    := cOperation
            ARL->ARL_ORIGEM  := if(cOrigin == "P", "1", "2")
            ARL->ARL_PLOAD   := cMessage
            ARL->ARL_BLIND   := If(IsBlind(),'1','2')
            ARL->ARL_INGEST  := FWTimeStamp( 6, Date(), Time()) //datetime de ingestão do dado
            ARL->ARL_ALIAS   := cAlias
            ARL->ARL_IDORIG  := cUUID
            ARL->ARL_LOG     := cLogNeg
        ARL->(msUnLock())
    END TRANSACTION
    FwFreeObj(jMessage)
Return

/*/{Protheus.doc} handleMessageError
    Realiza o tratamento de erro nas mensagens da TECHFIN
    @type  Function
    @author Vitor Duca
    @since 06/11/2025
    @version 1.0
    @param cResponse, character, Conteudo da resposta enviada pela TECHFIN
    @return cMessageError, character, Conteudo da mensagem de erro
/*/
Function handleMessageError(cResponse as character) as character
    Local cMessageError := ""               as character
    Local jResponse := JsonObject():new()   as json

    If Empty(jResponse:FromJson(cResponse)) .and. jResponse:hasProperty("data") .and. jResponse["data"]:hasProperty("status") 
        If ValType(jResponse["data"]["status"]) == "N" .and. jResponse["data"]["status"] == 3
            If jResponse["data"]:hasProperty("statusDetails") .and. jResponse["data"]["statusDetails"]:hasProperty("message")
                cMessageError := DecodeUTF8(jResponse["data"]["statusDetails"]["message"])

                If Empty(cMessageError)
                    cMessageError := jResponse["data"]["statusDetails"]["message"]
                Endif

                Help( ,,"TECHFIN_ERRO",,cMessageError, 1, 0 )
            Endif
        Endif
    Endif
Return cMessageError
