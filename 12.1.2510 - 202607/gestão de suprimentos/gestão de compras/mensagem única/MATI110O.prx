#INCLUDE "PROTHEUS.CH"    
#INCLUDE "FWADAPTEREAI.CH"
#INCLUDE "MATI110.ch"

/*
ÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜ
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
±±ÉÍÍÍÍÍÍÍÍÍÍÍÑÍÍÍÍÍÍÍÍÍÍËÍÍÍÍÍÍÍÑÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍËÍÍÍÍÍÍÑÍÍÍÍÍÍÍÍÍÍÍÍ»±±
±±º Function ³ MATI110  º Autor ³ Alex Egydio          º Data ³  27/12/12   º±±
±±ÌÍÍÍÍÍÍÍÍÍÍÍØÍÍÍÍÍÍÍÍÍÍÊÍÍÍÍÍÍÍÏÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÊÍÍÍÍÍÍÏÍÍÍÍÍÍÍÍÍÍÍÍ¹±±
±±º Desc.    ³ Funcao de integracao com o adapter EAI para recebimento e    º±±
±±º          ³ envio de informações da solicitacao de compras (SC1)         º±±
±±º          ³ utilizando o conceito de mensagem unica.                     º±±
±±ÌÍÍÍÍÍÍÍÍÍÍØÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ¹±±
±±º Param.   ³ cXML - Variavel com conteudo xml para envio/recebimento.     º±±
±±º          ³ nTypeTrans - Tipo de transacao. (Envio/Recebimento)          º±±
±±º          ³ cTypeMessage - Tipo de mensagem. (Business Type, WhoIs, etc) º±±
±±ÌÍÍÍÍÍÍÍÍÍÍØÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ¹±±
±±º Retorno  ³ aRet - Array contendo o resultado da execucao e a mensagem   º±±
±±º          ³        Xml de retorno.                                       º±±
±±º          ³ aRet[1] - (boolean) Indica o resultado da execução da função º±±
±±º          ³ aRet[2] - (caracter) Mensagem Xml para envio                 º±±
±±ÌÍÍÍÍÍÍÍÍÍÍØÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ¹±±
±±º Uso      ³ MATA110                                                      º±±
±±ÈÍÍÍÍÍÍÍÍÍÍÏÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ¼±±
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß
*/
Function MATI110O(oEAIObEt, nTypeTrans, cTypeMessage, cVersion, cTransac, lEAIObj, aRecSC1)

Local aArea				:= GetArea()
Local aAreaSC1			:= SC1->(GetArea()) 
Local aErroAuto			:= {}
Local aValInt			:= {}
Local aIntId			:= {}
Local aDePara			:= {}
Local aCab				:= {}
Local aItens			:= {}
Local aItensRat			:= {}
Local aItensPrj			:= {}
Local aAux				:= {}
Local aLinha			:= {}
Local aCentroCusto		:= {}
Local aProjetos			:= {}
Local aRet				:= {}
Local aTemp				:= {}
Local oFwEAIObj 		:= FWEAIobj():NEW()
Local oItemEAI			:= Nil
Local oRtCPEAI			:= Nil
Local oMsgError			:= Nil
Local oObLisOfIt		:= Nil
Local oReqItems			:= Nil
Local oAppoItems		:= Nil
Local cXMLRet			:= ""
Local cItemSC1			:= ""
Local cUsrSC			:= ""
Local cIntIDProd		:= ""
Local cNumSC			:= ""
Local cUmUsuario		:= ""
Local xAux 				:= ""
Local cNumItem			:= ""
Local cFilC1			:= FwxFilial("SC1")
Local cFilB5			:= FwxFilial("SB5")
Local cFilB1			:= FwxFilial("SB1")
Local cFilCT1			:= FwxFilial("CT1")
Local cFilCX			:= FwxFilial("SCX")
Local cSCoVer			:= RTrim(PmsMsgUVer('REQUEST','MATA110')) //Versão da Solicitação de Compra
Local cPrdVer			:= RTrim(PmsMsgUVer('ITEM','MATA010')) //Versão do Produto
Local cCusVer			:= RTrim(PmsMsgUVer('COSTCENTER','CTBA030')) //Versão do Centro de Custo
Local cUndVer			:= RTrim(PmsMsgUVer('UNITOFMEASURE','QIEA030')) //Versão da Unidade de Medida
Local cLocVer			:= RTrim(PmsMsgUVer('WAREHOUSE','AGRA045')) //Versão do Local de Estoque
Local cPrjVer			:= RTrim(PmsMsgUVer('PROJECT','PMSA200')) //Versão do Projeto
Local cTrfVer			:= RTrim(PmsMsgUVer('TASKPROJECT','PMSA203')) //Versão da Tarefa
Local cMoeVer        	:= RTrim(PmsMsgUVer('CURRENCY','CTBA140')) //Versão da Moeda
Local cMarca			:= "" //Armazena a Marca (LOGIX,PROTHEUS,RM...) que enviou o XML
Local cValExt			:= "" //Codigo externo utilizada no De/Para de codigos - Tabela XXF
Local cValInt			:= "" //Codigo interno utilizado no De/Para de codigos - Tabela XXF
Local cAlias			:= "SC1"
Local cCampo			:= "C1_NUM"
Local cEvent			:= "upsert"
Local cAux				:= ""
Local cLogErro 			:= ""
Local cCodPro			:= ""
Local cSolicit			:= ""
Local lMktSndPos		:= FwIsInCallStack("MATA111")
Local lMktPlace			:= SuperGetMv("MV_MKPLACE",.F.,.F.)
Local lB5EnvMkt			:= SB5->(FieldPos("B5_ENVMKT")) > 0 
Local lEnvMkt			:= .F.
Local lRet				:= .T.
Local lIntegTop			:= IsIntegTop()
Local lExtSCX			:= FwAliasIndic("SCX")
Local nTamC1Num			:= TamSx3("C1_NUM")[1]
Local nTamC1Item		:= TamSx3("C1_ITEM")[1]
Local nTamC1Prd			:= TamSX3("C1_PRODUTO")[1]
Local nX				:= 1
Local nI				:= 0
Local nCount			:= 0
Local n1Cnt				:= 0
Local n2Cnt				:= 0
Local nOpcx				:= 0
Local nC1Qtd			:= 0
Local nC1VUnit			:= 0
Local nC1Tot			:= 0
Local dDtEmis			:= dDataBase

Private lMsErroAuto		:= .F.
Private lAutoErrNoFile	:= .T.
Private cNumSCWS       := ""

If ( Type("Inclui") == "U" )
	Private Inclui := .F.
EndIf

If ( Type("Altera") == "U" )
	Private Altera := .F.
EndIf

//Tratamento do recebimento de mensagens
If ( nTypeTrans == TRANS_RECEIVE )
	//-- Recebimento da WhoIs
	If ( cTypeMessage == EAI_MESSAGE_WHOIS )
		ofwEAIObj := '1.000|1.001|1.002|1.003|1.004|1.005|1.008|1.009'
	//-- Recebimento da Response Message
	ElseIf ( cTypeMessage == EAI_MESSAGE_RESPONSE )

		// Se não houve erros na resposta
		If Upper(oEAIObEt:getPropValue("ProcessingInformation"):getPropValue("Status")) == "OK"

			If oEAIObEt:getHeaderValue("ProductName") !=  nil .And. !Empty( oEAIObEt:getHeaderValue("ProductName") )
				cMarca := oEAIObEt:getHeaderValue("ProductName")
			EndIf
			
			oObLisOfIt := oEAIObEt:getPropValue("ReturnContent"):getPropValue("ListOfInternalID"):getPropValue("InternalId")

			if Len( oObLisOfIt ) > 0

				For nI := 1 To Len( oObLisOfIt )
					If oObLisOfIt[nI]:getPropValue('OriginInternalId') != nil .And. !Empty( oObLisOfIt[nI]:getPropValue('OriginInternalId') )
						If !lMktPlace
							aAdd(aIntId, Array(3))
						Endif

						cDePara := oObLisOfIt[nI]:getPropValue('Name')
						cValInt := oObLisOfIt[nI]:getPropValue('OriginInternalId')
						aValInt := Separa(oObLisOfIt[nI]:getPropValue('OriginInternalId'),"|")
						
						If oObLisOfIt[nI]:getPropValue('DestinationInternalId') != nil .And. !Empty( oObLisOfIt[nI]:getPropValue('DestinationInternalId') )
							cValExt := oObLisOfIt[nI]:getPropValue('DestinationInternalId')  
						EndIf

						//Não armazena Rateio
						If !lMktPlace .And. AllTrim(Upper(cDePara)) $ 'REQUEST,REQUESTITEM'
							aIntId[nX,1] := cValInt
							aIntId[nX,2] := cValExt
						EndIf

						If !lMktPlace
							If AllTrim(Upper(cDePara)) $ 'REQUESTITEM'
								aIntId[nX,3] := "C1_ITEM"
							ElseIf AllTrim(Upper(cDePara)) $ 'REQUEST'
								aIntId[nX,3] := cCampo
							EndIf
		
							//Incrementa contador que será utilizado no de/para
							If AllTrim(Upper(cDePara)) $ 'REQUESTITEM'
								nCount++
							EndIf
						Else
							If SC1->(DbSeek(cFilC1 + aValInt[3] + aValInt[4]))
								If RecLock("SC1",.F.)
									SC1->C1_ACCNUM := cValExt
									SC1->(MsUnlock())
								Endif
								cXMLRet := STR0002	//'Mensagem processada'
							EndIf
						Endif
					Endif
				Next nX

			Endif

			If nCount > 0
				cEvent := Upper(AllTrim(oEAIObEt:getPropValue("ReceivedMessage"):getPropValue("Event")))
				 
				For nX := 1 To nCount
					//Insere / Atualiza / Deleta o registro na tabela XXF (de/para)
					CFGA070Mnt(cMarca, cAlias, aIntId[nX][3], aIntId[nX][2], aIntId[nX][1], Iif(cEvent == "UPSERT",.F.,.T.), 1)
				Next n1Cnt
			Endif
		Else
			cLogErro := ""
			If oEAIObEt:getpropvalue('ProcessingInformation') != nil
				oMsgError := oEAIObEt:getpropvalue('ProcessingInformation'):getpropvalue("ListOfMessages")
				For nX := 1 To Len( oMsgError )
					cLogErro += oMsgError[nX]:getpropvalue('Message') + CRLF
				Next nX
			Endif

			lRet := .F.
			ofwEAIObj:Activate()
			ofwEAIObj:setProp("ReturnContent")
			ofwEAIObj:getPropValue("ReturnContent"):setProp("Error", cLogErro )

			FreeObj(oMsgError)
		Endif
	//-- Receipt Message (Aviso de receb. em transmissoes assincronas)
	ElseIf ( cTypeMessage == EAI_MESSAGE_RECEIPT )
		cXMLRet := STR0003	//'Mensagem recebida'
	//-- Recebimento da Business Message
	ElseIf ( cTypeMessage == EAI_MESSAGE_BUSINESS )
		//Ajustado para receber o Type conforme documentacao API Totvs
		//000 – SC
		//001 - SA
		
		Do Case
			Case oEAIObEt:getPropValue("Type") == "000" //SC
				
				// Verifica se a marca foi informada
				If oEAIObEt:getHeaderValue("ProductName") != Nil .And. !Empty(oEAIObEt:getHeaderValue("ProductName"))
					cMarca := AllTrim(oEAIObEt:getHeaderValue("ProductName"))
				EndIf	

				If !Empty(oEAIObEt:getPropValue("InternalId"))
					cValExt := oEAIObEt:getPropValue("InternalId")
				Else
					lRet		:= .F.
					cMsgRet		:= STR0012 //"O InternalId é obrigatório!"
					Return {lRet, cMsgRet}
				EndIf

				cValInt := RTrim(CFGA070INT(cMarca, cAlias, cCampo, cValExt))

				If Upper(oEAIObEt:getHeaderValue('Event')) == 'DELETE'

					dbSelectArea("SC1")
					nOpcx := 5
					SC1->(DbSetOrder(1)) //C1_FILIAL+C1_NUM+C1_ITEM

					If !Empty(cValInt)
						cNumSC := PadR(Separa(cValInt, '|')[3], nTamC1Num)

						aAdd(aCab,	{"C1_FILIAL",	cFilC1,	Nil})
						aAdd(aCab,	{"C1_NUM",		cNumSC,	Nil})
					Else
						lRet		:= .F.
						cXmlRet	:= STR0013 //"Solicitação de compra não encontrada no de/para!"
						Return {lRet, cXmlRet}
					EndIf

					If SC1->(dbSeek(cFilC1 + cNumSC))
						While !SC1->(Eof()) .And. cFilC1 + cNumSC == SC1->C1_FILIAL + SC1->C1_NUM
							aAdd(aLinha,	{"C1_FILIAL",	cFilC1,	Nil})
							aAdd(aLinha,	{"C1_NUM",		cNumSC,				Nil})
							aAdd(aLinha,	{"C1_ITEM",		SC1->C1_ITEM,		Nil})
							aAdd(aItens, aClone(aLinha))
							aLinha := {}

							// Array para armazenar dados do item para manipular o de/para.
							// Estrutura:
							// [n1Cnt][1]: Chave externa
							// [n1Cnt][2]: Chave Interna
							// [n1Cnt][3]: Field do item

							cAux := IntSCoExt(/*cEmpresa*/, SC1->C1_FILIAL, SC1->C1_NUM, SC1->C1_ITEM, cSCoVer)[2]
							aAdd(aLinha,	RTrim(CFGA070Ext(cMarca, cAlias, "C1_ITEM", cAux)))
							aAdd(aLinha,	cAux)
							aAdd(aLinha,	cAlias)
							aAdd(aLinha,	"C1_ITEM")
							aAdd(aDePara, aLinha)
							aLinha := {}

							SC1->(dbSkip())
						EndDo
					EndIf

				Elseif Upper(oEAIObEt:getHeaderValue('Event')) == 'UPSERT'
					If !Empty(cValInt)
						nOpcx	:= 4
						Altera	:= .T.
						cNumSC := PadR(Separa(cValInt, '|')[3], nTamC1Num)
						
						//Número da Solicitação
						aAdd(aCab, {"C1_FILIAL", cFilC1, NIL})
						aAdd(aCab, {"C1_NUM", cNumSC, NIL})
					Else
						cNumSC	:= "cNumSCWS"
						cValInt	:= IntSCoExt(/*cEmpresa*/, /*cFilial*/, cNumSC, /*cItemSC*/, cSCoVer)[2]

						nOpcx	:= 3
						Inclui	:= .T.

						//Verifica se o número da solicitação foi informado
						If oEAIObEt:getPropValue("Number") != NIL .And. !Empty(oEAIObEt:getPropValue("Number"))
							// Verifica se não possui numeração automática
							If Empty(Posicione('SX3', 2, Padr('C1_NUM', 10), 'X3_RELACAO'))
								cNumSC := oEAIObEt:getPropValue("Number")

								//Número da Solicitação
								aAdd(aCab, {"C1_FILIAL", cFilC1, NIL})
								aAdd(aCab, {"C1_NUM", cNumSC, NIL})
							EndIf
						EndIf
					EndIf

					//Data da Solicitação
					If oEAIObEt:getPropValue("RegisterDateTime") != NIL .And. !Empty(oEAIObEt:getPropValue("RegisterDateTime"))
						dDtEmis := Stod(StrTran(oEAIObEt:getPropValue("RegisterDateTime"), "-", ""))
					EndIf
					aAdd(aCab, {"C1_EMISSAO",dDtEmis, NIL})
					
					//Usuário requisitante
					If oEAIObEt:getPropValue("UserRequesterCode") != NIL .And. !Empty(oEAIObEt:getPropValue("UserRequesterCode"))
						
						cUmUsuario := PegaIdUsr(oEAIObEt:getPropValue("UserRequesterCode"), @xAux)
						
						aAdd(aCab, {"C1_USER", cUmUsuario, NIL})
						
						cSolicit := Iif(!Empty(xAux),xAux,Iif(oEAIObEt:getPropValue("UserRequesterName") != NIL .And. !Empty(oEAIObEt:getPropValue("UserRequesterName")),oEAIObEt:getPropValue("UserRequesterName"),"Administrador"))

						aAdd(aCab, {"C1_SOLICIT",cSolicit, NIL})
					Elseif oEAIObEt:getPropValue("UserRequesterName") != NIL .And. !Empty(oEAIObEt:getPropValue("UserRequesterName"))
						cSolicit := oEAIObEt:getPropValue("UserRequesterName")
						aAdd(aCab, {"C1_SOLICIT", cSolicit, NIL})
					Else
						cSolicit := "Administrador"
						aAdd(aCab, {"C1_SOLICIT", cSolicit , NIL})
					EndIf

					If oEAIObEt:getPropValue("ListOfRequestItem") != NIL .And. Len(oEAIObEt:getPropValue("ListOfRequestItem")) > 0
						oReqItems := oEAIObEt:getPropValue('ListOfRequestItem')
					EndIf

					For n1Cnt := 1 to Len(oReqItems)
						If oReqItems[n1Cnt]:getPropValue('Code') != NIL .And. !Empty(oReqItems[n1Cnt]:getPropValue('Code'))
							cItemSC1 := PadL(oReqItems[n1Cnt]:getPropValue('Code'), nTamC1Item, "0")
							aAdd(aLinha, {"C1_ITEM", cItemSC1, Nil})
						Endif

						//Array e contador que serão usados para manipular o de/para
						aAdd(aDePara, Array(4))
						aDePara[n1Cnt][1] := oReqItems[n1Cnt]:getPropValue('InternalId')
						aDePara[n1Cnt][2] := IntSCoExt(/*cEmpresa*/, /*cFilial*/, cNumSC, cItemSC1, cSCoVer)[2]
						aDePara[n1Cnt][3] := cAlias
						aDePara[n1Cnt][4] := 'C1_ITEM'

						//Usuário requisitante
						If !Empty(cSolicit)
							aAdd(aLinha, {"C1_SOLICIT", cSolicit , NIL})
						Endif

						If oReqItems[n1Cnt]:getPropValue('ItemInternalId') != NIL .And. !Empty(oReqItems[n1Cnt]:getPropValue('ItemInternalId'))
							aAux := IntProInt(oReqItems[n1Cnt]:getPropValue('ItemInternalId'), cMarca, cPrdVer) //MATI010
							If !aAux[1]
								lRet	:= aAux[1]
								cMsgRet	:= aAux[2]
								Return {lRet, cMsgRet}
							Else
								cCodPro := PadR(aAux[2][3], nTamC1Prd)
								aAdd(aLinha, {"C1_PRODUTO", cCodPro, Nil})
							EndIf
						ElseIf oReqItems[n1Cnt]:getPropValue('ItemCode') != NIL .And. !Empty(oReqItems[n1Cnt]:getPropValue('ItemCode'))
							cCodPro := PadR(oReqItems[n1Cnt]:getPropValue('ItemCode'), nTamC1Prd)
							aAdd(aLinha, {"C1_PRODUTO", cCodPro, Nil})
						EndIf

						// Quantidade
						If oReqItems[n1Cnt]:getPropValue("Quantity") != NIL .And. !Empty(oReqItems[n1Cnt]:getPropValue("Quantity"))
							nC1Qtd	:= Val(oReqItems[n1Cnt]:getPropValue("Quantity"))
							aAdd(aLinha, {"C1_QUANT", nC1Qtd , Nil})
						EndIf

						// Preço Unitário
						If oReqItems[n1Cnt]:getPropValue("UnitPrice") != NIL .And. !Empty(oReqItems[n1Cnt]:getPropValue("UnitPrice"))
							nC1VUnit := Val(oReqItems[n1Cnt]:getPropValue("UnitPrice"))
							aAdd(aLinha, {"C1_VUNIT", nC1VUnit, Nil})
						EndIf

						// Valor Total
						If oReqItems[n1Cnt]:getPropValue("TotalPrice") != NIL .And. !Empty(oReqItems[n1Cnt]:getPropValue("TotalPrice"))
							aAdd(aLinha, {"C1_TOTAL", Val(oReqItems[n1Cnt]:getPropValue("TotalPrice")), Nil})
						Else
							nC1Tot := Iif(nC1VUnit>0,nC1Qtd*nC1VUnit,0)

							aAdd(aLinha, {"C1_TOTAL", nC1Tot, Nil})
						EndIf						

						//Obtém o código interno da Unidade de Medida
						If oReqItems[n1Cnt]:getPropValue("UnitOfMeasureInternalId") != NIL .And. !Empty(oReqItems[n1Cnt]:getPropValue("UnitOfMeasureInternalId"))
							aAux := IntUndInt(oReqItems[n1Cnt]:getPropValue("UnitOfMeasureInternalId"), cMarca, cUndVer) //QIEI030
							If !aAux[1]
								lRet		:= aAux[1]
								cXmlRet	:= aAux[2]
								Return {lRet, cXmlRet}
							Else
								aAdd(aLinha, {"C1_UM", RTrim(aAux[2][3]), Nil})
							EndIf
						ElseIf oReqItems[n1Cnt]:getPropValue("UnitOfMeasureCode") != NIL .And. !Empty(oReqItems[n1Cnt]:getPropValue("UnitOfMeasureCode"))
							aAdd(aLinha, {"C1_UM", oReqItems[n1Cnt]:getPropValue("UnitOfMeasureCode"), Nil})
						EndIf

						//Obtém o código interno do Local de Estoque
						If oReqItems[n1Cnt]:getPropValue("WarehouseInternalId") != NIL .And. !Empty(oReqItems[n1Cnt]:getPropValue("WarehouseInternalId"))
							aAux := IntLocInt(oReqItems[n1Cnt]:getPropValue("WarehouseInternalId"), cMarca, cLocVer) //AGRI045
							If !aAux[1]
								lRet		:= aAux[1]
								cXmlRet	:= aAux[2]
								Return {lRet, cXmlRet}
							Else
								aAdd(aLinha, {"C1_LOCAL", RTrim(aAux[2][3]), Nil})
							EndIf
						ElseIf oReqItems[n1Cnt]:getPropValue("WarehouseCode") != NIL .And. !Empty(oReqItems[n1Cnt]:getPropValue("WarehouseCode"))
							aAdd(aLinha, {"C1_LOCAL",oReqItems[n1Cnt]:getPropValue("WarehouseCode"), Nil})
						EndIf
						
						//Data da Solicitação
						If oReqItems[n1Cnt]:getPropValue("DeliveryDateTime") != NIL .And. !Empty(oReqItems[n1Cnt]:getPropValue("DeliveryDateTime"))
							aAdd(aLinha, {"C1_DATPRF", Stod(StrTran(oReqItems[n1Cnt]:getPropValue("DeliveryDateTime"), "-", "")), NIL})
						EndIf

						//Obtém o código interno do Centro de Custo do item
						If oReqItems[n1Cnt]:getPropValue("CostCenterInternalId") != NIL .And. !Empty(oReqItems[n1Cnt]:getPropValue("CostCenterInternalId"))
							aCCusto := IntCusInt(oReqItems[n1Cnt]:getPropValue("CostCenterInternalId"), cMarca, cCusVer) //CTBI030
							If !aCCusto[1]
								lRet		:= aCCusto[1]
								cXmlRet	:= aCCusto[2]
								Return {lRet, cXMLRet}
							EndIf

							aAdd(aLinha, {"C1_CC", RTrim(aCCusto[2][3]), Nil})
						ElseIf oReqItems[n1Cnt]:getPropValue("CostCenterCode") != NIL .And. !Empty(oReqItems[n1Cnt]:getPropValue("CostCenterCode"))
							aAdd(aLinha, {"C1_CC", oReqItems[n1Cnt]:getPropValue("CostCenterCode"), Nil})
						EndIf

						//Conta contábil
						If oReqItems[n1Cnt]:getPropValue("AccountantAcountInternalId") != NIL .And. !Empty(oReqItems[n1Cnt]:getPropValue("AccountantAcountInternalId"))
							aAux := CFGA070INT(cMarca, "CT1", "CT1_CONTA", oReqItems[n1Cnt]:getPropValue("AccountantAcountInternalId")) //CTBI020
							If !Empty(aAux)
								lRet		:= .F.
								cXmlRet	:= STR0015 //"Conta contábil não encontrada no de/para."
								Return {lRet, cXmlRet}
							Else
								aAdd(aLinha, {"C1_CONTA", RTrim(Separa(aAux)[3]), Nil})
							EndIf
						ElseIf oReqItems[n1Cnt]:getPropValue("AccountantAcountCode") != NIL .And. !Empty(oReqItems[n1Cnt]:getPropValue("AccountantAcountCode"))
						 	aAdd(aLinha, {"C1_CONTA", oReqItems[n1Cnt]:getPropValue("AccountantAcountCode"), Nil})
						EndIf

						//Ordem de produção
						If oReqItems[n1Cnt]:getPropValue("MainOrderCode") != NIL .And. !Empty(oReqItems[n1Cnt]:getPropValue("MainOrderCode"))
							aAdd(aLinha, {"C1_OP", oReqItems[n1Cnt]:getPropValue("MainOrderCode"), Nil})
						EndIf

						// Observação
						If oReqItems[n1Cnt]:getPropValue("Observation") != NIL .And. !Empty(oReqItems[n1Cnt]:getPropValue("Observation"))
							aAdd(aLinha, {"C1_OBS", oReqItems[n1Cnt]:getPropValue("Observation"), Nil})
						EndIf
						
						//Moeda
						If oReqItems[n1Cnt]:getPropValue("CurrencyId") != NIL .And. !Empty(oReqItems[n1Cnt]:getPropValue("CurrencyId"))
							cMoedaExt	:= oReqItems[n1Cnt]:getPropValue("CurrencyId")
						
							aAux := IntMoeInt(cMoedaExt, cMarca, cMoeVer)
							If !aAux[1]
								lRet := aAux[1]
								cXmlRet := aAux[2]
								Return {lRet, cXmlRet}
							Else
								aAdd(aCab, {"C1_MOEDA", Iif(cMoeVer=="1.000",Val(aAux[2][2]),Val(aAux[2][3])), Nil})
							EndIf
						ElseIf oReqItems[n1Cnt]:getPropValue("CurrencyCode") != NIL .And. !Empty(oReqItems[n1Cnt]:getPropValue("CurrencyCode"))
							aAdd(aCab, {"C1_MOEDA", Val(oReqItems[n1Cnt]:getPropValue("CurrencyCode")), Nil})
						EndIf

						//Tipo de solicitação
						aAdd(aLinha, {"C1_TPSC", "1", Nil})
						
						//Pedido de origem do RM Solum (TOP)
						aAdd(aLinha, {"C1_ORIGEM", Iif(lIntegTop .And. Len(aProjetos) > 0,"SOLUM","MSEAI"), Nil})
						
						//Numero Boletim PIMS
						If oReqItems[n1Cnt]:getPropValue("Code") != NIL .And. !Empty(oReqItems[n1Cnt]:getPropValue("Code"))
							aAdd(aLinha ,{'C1_NRBPIMS' 	,oReqItems[n1Cnt]:getPropValue("Code"),Nil} )
						EndIf

						If oReqItems[n1Cnt]:getPropValue("ListOfApportionRequestItem") != nil .And. Len(oReqItems[n1Cnt]:getPropValue("ListOfApportionRequestItem")) > 0
							oAppoItems := oReqItems[n1Cnt]:getPropValue("ListOfApportionRequestItem")

							For n2Cnt := 1 To Len(oAppoItems)
								
								If oAppoItems[n2Cnt]:getPropValue('Percentual') != nil .And. !Empty(oAppoItems[n2Cnt]:getPropValue('Percentual'))  
									aAux := IntCusInt(oAppoItems[nY]:getPropValue('CostCenterInternalId') , cMarca, cCusVer) //CTBI030
									If !aAux[1]
										lRet		:= .F.
										cMsgRet		:= aAux[2] + STR0016 + AllTrim(oAppoItems[n2Cnt]:getPropValue('Code')) + "." //" Item "
										Return {lRet, cMsgRet}
									EndIf

									aVldCC := IntVldCC(aAux[2][3], Date(), "MATI110")
									// Valida o Centro de custo
									If !aVldCC[1]
										lRet		:= .F.
										cMsgRet		:= aVldCC[2] + STR0016 + AllTrim(oAppoItems[n2Cnt]:getPropValue('Code')) + "." //" Item "
										Return {lRet, cMsgRet}
									EndIf

									nAux := aScan(aCentroCusto, {|x| RTrim(x[3]) == RTrim(aAux[2][3])})

									If nAux > 0
										aCentroCusto[nAux][2] += Val(oAppoItems[n2Cnt]:getPropValue('Percentual'))
									Else
										aAdd(aCentroCusto, {cItemSC1, Val(oAppoItems[n2Cnt]:getPropValue('Percentual')), aAux[2][3], ""})
									EndIf
								Else
									lRet		:= .F.
									cMsgRet		:= STR0017 + AllTrim(oAppoItems[n2Cnt]:getPropValue('Code')) + "." //"Percentual de rateio inválido para o item "
									Return {lRet, cMsgRet}
								EndIf

								// Se possui Centro de Custo Informado
								// Obtém a conta contábil
								If oAppoItems[n2Cnt]:getPropValue('AccountantAcountInternalId') != nil .And. !Empty(oAppoItems[n2Cnt]:getPropValue('AccountantAcountInternalId'))  
									cAux := CFGA070INT(cMarca, "CT1", "CT1_CONTA", oAppoItems[n2Cnt]:getPropValue('AccountantAcountInternalId')) //CTBI020
									If !Empty(cAux)
										aAux := Separa(cAux,"|")

										If Len(aAux) == 3
											aCentroCusto[n2Cnt][4] := aAux[3]
										EndIf
									Else
										lRet		:= .F.
										cMsgRet		:= STR0018 + AllTrim(oAppoItems[n2Cnt]:getPropValue('Code'))//"Conta contábil não encontrada no de/para."
										Return {lRet, cMsgRet}
									EndIf
								EndIf

								If oAppoItems[n2Cnt]:getPropValue('ProjectInternalId') != nil .And. !Empty(oAppoItems[n2Cnt]:getPropValue('ProjectInternalId'))  
									// O projeto possui um código válido?
									aAux := IntPrjInt(oAppoItems[n2Cnt]:getPropValue('ProjectInternalId'), cMarca, cPrjVer) //PMSI200 Retorna: Empresa|Filial|Projeto
									If !aAux[1]
										lRet	:= .F.
										cMsgRet	:= aAux[2] + STR0016 + AllTrim(oAppoItems[n2Cnt]:getPropValue('Code')) + "."
										Return {lRet, cMsgRet}
									Else
										xAux := aAux[2][3]
									EndIf								

									// Possui tarefa informada
									If oAppoItems[n2Cnt]:getPropValue('TaskInternalId') != nil .And. !Empty(oAppoItems[n2Cnt]:getPropValue('TaskInternalId'))  
										// A tarefa possui um código válido?
										aAux := IntTrfInt(oAppoItems[n2Cnt]:getPropValue('TaskInternalId'), cMarca, cTrfVer) //PMSI203 Retorna: Empresa|Filial|Projeto|Revisao|Tarefa
										If !aAux[1]
											lRet		:= .F.
											cMsgRet		:= aAux[2] + STR0016 + AllTrim(oAppoItems[nY]:getPropValue('Code')) + "." //" Item "
											Return {lRet, cMsgRet}
										EndIf
									EndIf								

									// Possui quantidade informada
									If oAppoItems[n2Cnt]:getPropValue('Quantity') != nil .And. !Empty(oAppoItems[n2Cnt]:getPropValue('Quantity'))  
										// Verifica se já existe o projeto e tarefa para o item
										nAux := aScan(aProjetos, {|x| Rtrim(x[1]) == Rtrim(aAux[2][3]) .And. Rtrim(x[3]) == Rtrim(aAux[2][5])})
										// Caso já exista o projeto/tarefa aglutinar a quantidade
										If nAux > 0
											aProjetos[nAux][4] += Val(oAppoItems[n2Cnt]:getPropValue('Quantity'))
										Else
											// Projeto|Revisão|Tarefa|Quantidade|Solicitação|Item Solicitação|Produto
											aAdd(aProjetos, {xAux, aAux[2][4], aAux[2][5], Val(oAppoItems[n2Cnt]:getPropValue('Quantity')), cNumSC, cItemSC1, PadR(cCodPro, nTamC1Prd)})
										EndIf
									Else
										lRet		:= .F.
										cMsgRet		:= STR0020 + AllTrim(oAppoItems[nY]:getPropValue('Code')) + "." //"Quantidade do rateio inválido para o item "
										Return {lRet, cMsgRet}
									EndIf

								Endif
								
							Next n2Cnt

							If Len(aCentroCusto) > 0
								// Monta o array com os itens do rateio de centro de custo agrupados por centro de custo
								aAdd(aItensRat, Array(2))
								aItensRat[n1Cnt][1] := cItemSC1
								aItensRat[n1Cnt][2] := {}

								For nCount := 1 To Len(aCentroCusto)
									aAdd(aTemp,	{"CX_ITEM"		,	PadL(nCount, TamSx3("CX_ITEM")[1], "0"),	Nil})
									aAdd(aTemp,	{"CX_PERC"		,	aCentroCusto[nCount][2],					Nil})
									aAdd(aTemp,	{"CX_CC"		,	aCentroCusto[nCount][3],					Nil})
									aAdd(aTemp,	{"CX_CONTA"		,	aCentroCusto[nCount][4],					Nil})
									aAdd(aTemp,	{"CX_ITEMCTA"	,	""						,					Nil})
									aAdd(aTemp,	{"CX_CLVL"		,	""						,					Nil})
									aAdd(aItensRat[n1Cnt][2], aClone(aTemp))
									aTemp := {}
								Next nCount
							Endif

							If Len(aProjetos) > 0
								// Monta o array com os itens do rateio de projeto agrupados por projeto/tarefa
								For nCount := 1 To Len(aProjetos)
									aAdd(aTemp,	{"AFG_PROJET",	PadR(aProjetos[nCount][1], TamSx3("AFG_PROJET")[1]),	Nil})
									aAdd(aTemp,	{"AFG_REVISA",	aProjetos[nCount][2],	Nil})
									aAdd(aTemp,	{"AFG_TAREFA",	PadR(aProjetos[nCount][3], TamSx3("AFG_TAREFA")[1]),	Nil})
									aAdd(aTemp,	{"AFG_QUANT",	aProjetos[nCount][4],	Nil})
									aAdd(aTemp,	{"AFG_NUMSC",	aProjetos[nCount][5],	Nil})
									aAdd(aTemp,	{"AFG_ITEMSC",	aProjetos[nCount][6],	Nil})
									aAdd(aTemp,	{"AFG_COD",		aProjetos[nCount][7],	Nil})
									aAdd(aItensPrj, aClone(aTemp))
									aTemp := {}
								Next nCount
							Endif

							If Len(aCentroCusto) > 0
								aAdd(aLinha, {"C1_RATEIO","1", Nil})
							Endif	

							aAdd(aItens, aLinha)
							aLinha := {}

							If Len(aCentroCusto) > 0
								//Caso tenha rateio de centro de custo excluir o centro de custo do item para evitar erro
								nCount := aScan(aItens[n1Cnt], {|x| x[1] == "C1_CC"})
								If nCount > 0
									aDel(aItens[n1Cnt], nCount)
									aSize(aItens[n1Cnt], Len(aItens[n1Cnt]) - 1)
								EndIf
							EndIf

							aCentroCusto := {}
							aProjetos := {}
						Else
							aAdd(aItens, aLinha)
							aLinha := {}
							aCentroCusto := {}
							aProjetos := {}
						EndIf

					Next n1Cnt

				Endif 

				If ExistBlock("ITMT110")
					aRetPe := ExecBlock("ITMT110",.F.,.F.,{aCab,aItens,aItensRat,aItensPrj})
					If ValType(aRetPe) == "A" .And. Len(aRetPe) >0
						If ValType(aRetPe[1]) == "A"
							aCab := aClone(aRetPe[1])
						EndIf
						If ValType(aRetPe[2]) == "A" 
							aItens := aClone(aRetPe[2])
						EndIf
						If ValType(aRetPe[3]) == "A" 
							aItensRat := aClone(aRetPe[3])
						EndIf
						If ValType(aRetPe[4]) == "A" 
							aItensPrj := aClone(aRetPe[4])
						EndIf
					EndIf
				EndIf

				If nOpcx == 5
					MSExecAuto({|x,y,z|MATA110(x,y,z)},aCab,,nOpcx)
				Else
					If Len(aItensRat) > 0
						MsExecAuto({|u,v,x,y,z| MATA110(u, v, x, Nil , Nil, y,z)}, aCab, aItens, nOpcx, aItensRat,/*aItensPrj*/)
					Else
						MsExecAuto({|u,v,x,y,z| MATA110(u, v, x, Nil , Nil, y,z)}, aCab, aItens, nOpcx, /*aItensRat*/,/*aItensPrj*/)
					Endif
				EndIf

				If lMsErroAuto
					aErroAuto := GetAutoGRLog()

					cLogErro := ""
					For n1Cnt := 1 To Len(aErroAuto)
						cLogErro += _NoTags(aErroAuto[n1Cnt])
					Next
					
					lRet		:= .F.
					cXMLRet := EncodeUTF8(cLogErro)
					msUnlockAll()
				Else
					If nOpcx != 5
						// Atualiza o número da SC gerado no de/para
						cValInt := StrTran(cValInt, "cNumSCWS", RTrim(cNumSCWS))

						For n1Cnt := 1 To Len(aDePara)
							aDePara[n1Cnt][2] := StrTran(aDePara[n1Cnt][2], "cNumSCWS", RTrim(cNumSCWS))
						Next n1Cnt
						
						// Atualiza o número da SA no rateio de projeto
						For n1Cnt := 1 To Len(aItensPrj)
							If (n2Cnt := aScan(aItensPrj[n1Cnt], {|x| x[1] == "AFG_NUMSC"})) > 0
								aItensPrj[n1Cnt, n2Cnt, 2] := RTrim(cNumSCWS)
							EndIf
						Next n1Cnt
					Else
						If Len(aItensPrj) == 0
							aLinha := {}
							aAdd(aLinha, {"AFG_PROJET","", Nil})
							aAdd(aLinha, {"AFG_TAREFA","", Nil})
							aAdd(aLinha, {"AFG_QUANT",0,Nil})
							aAdd(aLinha, {"AFG_ITEMSC","",Nil})
							aAdd(aLinha, {"AFG_NUMSC",cNumSC,Nil})
							aAdd(aLinha, {"AFG_REVISA","0001",Nil})
							
							aAdd(aItensPrj,aClone(aLinha))
						Endif
					EndIf

					If nOpcx != 5 // Se o evento é diferente de delete
						// Grava o registro na tabela XXF (de/para)
						CFGA070Mnt(cMarca, cAlias, cCampo, cValExt, cValInt, .F., 1)
					Else
						// Exclui o registro na tabela XXF (de/para)
						CFGA070Mnt(cMarca, cAlias, cCampo, cValExt, cValInt, .T., 1)
					EndIf
					
					If Len(aItensPrj) > 0
						// Grava Projeto/Tarefa utilizando função do WS
						pmsWsSC(cValToChar(nOpcx), aItensPrj)
					EndIf

					ofwEAIObj:Activate()
					ofwEAIObj:setProp("ReturnContent")
					
					If oEAIObEt:getHeaderValue("Transaction") !=  nil
						cName := oEAIObEt:getHeaderValue("Transaction")
					Endif		

					ofwEAIObj:getPropValue("ReturnContent"):setprop('ListOfInternalId', {})
					oFwEAIObj:getPropValue("ReturnContent"):getPropValue("ListOfInternalId")[1]:setprop("Name", cName,,.T.)
					oFwEAIObj:getPropValue("ReturnContent"):getPropValue("ListOfInternalId")[1]:setprop("Origin", cValExt,,.T.)
					oFwEAIObj:getPropValue("ReturnContent"):getPropValue("ListOfInternalId")[1]:setprop("Destination",cValInt,,.T.)
					
					//Loop para manipular os Itens na tabela XXF (de/para)
					For n1Cnt := 1 to Len(aDePara)
						If nOpcx != 5 // Se o evento é diferente de delete
							// Grava o registro na tabela XXF (de/para)
							CFGA070Mnt(cMarca, aDePara[n1Cnt][3], aDePara[n1Cnt][4], aDePara[n1Cnt][1], aDePara[n1Cnt][2], .F., 1)
						Else
							// Exclui o registro na tabela XXF (de/para)
							CFGA070Mnt(cMarca, aDePara[n1Cnt][3], aDePara[n1Cnt][4], aDePara[n1Cnt][1], aDePara[n1Cnt][2], .T., 1)
						EndIf

						ofwEAIObj:getPropValue("ReturnContent"):setprop('ListOfInternalId', {})
						oFwEAIObj:getPropValue("ReturnContent"):getPropValue("ListOfInternalId")[n1Cnt+1]:setprop("Name", cName,,.T.)
						oFwEAIObj:getPropValue("ReturnContent"):getPropValue("ListOfInternalId")[n1Cnt+1]:setprop("Origin", aDePara[n1Cnt][1],,.T.)
						oFwEAIObj:getPropValue("ReturnContent"):getPropValue("ListOfInternalId")[n1Cnt+1]:setprop("Destination",aDePara[n1Cnt][2],,.T.)
					Next n1Cnt

					MsUnlockAll()
				EndIf

			Case oEAIObEt:getPropValue("Type") == "001" //SA
				aAdd(aRet, FWIntegDef("MATA105", cTypeMessage, nTypeTrans, oEAIObEt))
					
				If ValType(aRet) == "A"
					If !Empty(aRet)
						lRet := aRet[1][1]
						cLogErro := aRet[1][2]
					EndIf
				Endif
		Endcase
	EndIf
//Tratamento do envio de mensagens
ElseIf nTypeTrans == TRANS_SEND

	DbSelectArea("SY1")
	
	cNumSC		:= SC1->C1_NUM
	cNumItem	:= SC1->C1_ITEM

	cUsrSC		:= Iif(lMktPlace,GetCompUser(),SC1->C1_USER)

	//-- Inclusao ou Alteracao
	If Inclui .Or. Altera
		/*Escrita do objeto json*/
		oFwEAIObj:Activate()

		/*BusinessEvent*/
		oFwEAIObj:setEvent(cEvent)
		oFwEAIObj:setHeader("Entity","Request")

		/*BusinessContent*/		
		oFwEAIObj:setprop("CompanyId",cEmpAnt)		
		oFwEAIObj:setprop("BranchId", cFilC1)
		oFwEAIObj:setprop("CompanyInternalId", cEmpAnt + '|' + cFilC1)
		oFwEAIObj:setprop("InternalId", IntSCoExt(/*cEmpresa*/, /*cFilial*/, cNumSC, /*cItemSC*/, cSCoVer)[2] )
		oFwEAIObj:setprop("Number", RTrim(cNumSC))
		oFwEAIObj:setprop("Type", "000")
		oFwEAIObj:setprop("UserRequesterCode",cUsrSC)
		oFwEAIObj:setprop("UserRequesterInternalId",GetCompUser())
		oFwEAIObj:setprop("UserRequesterName", RTrim(SC1->C1_SOLICIT))
		oFwEAIObj:setprop("RegisterDateTime", INTDTANO(SC1->C1_EMISSAO))
		oFwEAIObj:setprop("PaymentConditionCode", Iif(!Empty(SC1->C1_CONDPAG),RTrim(SC1->C1_CONDPAG),""))
		oFwEAIObj:setprop("PaymentConditionInternalId", Iif(!Empty(SC1->C1_CONDPAG),IntConExt(/*cEmpresa*/, /*cFilial*/, SC1->C1_CONDPAG)[2],"") )
	
		SC1->(DbSetOrder(1))

		If SC1->(DbSeek(cFilC1+cNumSC))
			While SC1->(!Eof()) .And. SC1->C1_FILIAL + SC1->C1_NUM == cFilC1+cNumSC
				If lMktPlace .And. lB5EnvMkt	
					lEnvMkt:=.F.
					If SB5->(DbSeek( cFilB5 + SC1->C1_PRODUTO))
						If SB5->B5_ENVMKT == "1" .Or. (lMktSndPos .And. SB5->B5_ENVMKT $ "12")
							lEnvMkt:=.T.
						EndIf
					EndIf
				EndIf 
				
				If !lMktPlace .Or. (lMktPlace .And. lEnvMkt)

					If (SC1->C1_APROV $ " ,L" .Or. (ValType(aRecSC1) == "A" .And. Ascan(aRecSC1,SC1->(Recno())) > 0))
						oItemEAI := oFwEAIObj:setprop("ListOfRequestItem", {}, 'RequestItem', , .T. )

						oItemEAI[Len(oItemEAI)]:setprop("Code",   SC1->C1_ITEM ,,.T.)
						oItemEAI[Len(oItemEAI)]:setprop("InternalId",   IntSCoExt(/*cEmpresa*/, /*cFilial*/, cNumSC, SC1->C1_ITEM, cSCoVer)[2] ,,.T.)
						oItemEAI[Len(oItemEAI)]:setprop("ItemCode",   RTrim(SC1->C1_PRODUTO) ,,.T.)
						
						cIntIDProd := Iif(lMktPlace,cEmpAnt + '|' + RTrim(cFilB1)+ "|" + RTrim(SC1->C1_PRODUTO), IntProExt(/*cEmpresa*/, /*cFilial*/, SC1->C1_PRODUTO, cPrdVer)[2] )

						oItemEAI[Len(oItemEAI)]:setprop("ItemInternalId",   cIntIDProd ,,.T.)
						oItemEAI[Len(oItemEAI)]:setprop("Application",   "1" ,,.T.)
						oItemEAI[Len(oItemEAI)]:setprop("UnitPrice",   AllTrim(cValToChar(SC1->C1_VUNIT)) ,,.T.)
						oItemEAI[Len(oItemEAI)]:setprop("TotalPrice",   AllTrim(cValToChar(SC1->C1_VUNIT * SC1->C1_QUANT)) ,,.T.)
						oItemEAI[Len(oItemEAI)]:setprop("Quantity",   AllTrim(cValToChar(SC1->C1_QUANT)) ,,.T.)
						oItemEAI[Len(oItemEAI)]:setprop("QuantityReached",   AllTrim(cValToChar(SC1->C1_QUJE)) ,,.T.)
						oItemEAI[Len(oItemEAI)]:setprop("UnitOfMeasureCode",   SC1->C1_UM ,,.T.)
						oItemEAI[Len(oItemEAI)]:setprop("UnitOfMeasureInternalId",   IntUndExt(/*cEmpresa*/, /*cFilial*/, SC1->C1_UM, cUndVer)[2] ,,.T.)
						oItemEAI[Len(oItemEAI)]:setprop("WarehouseCode",   RTrim(SC1->C1_LOCAL) ,,.T.)
						oItemEAI[Len(oItemEAI)]:setprop("WarehouseInternalId",   IntLocExt(/*cEmpresa*/, /*cFilial*/, SC1->C1_LOCAL, cLocVer)[2] ,,.T.)
						oItemEAI[Len(oItemEAI)]:setprop("DeliveryDateTime",   INTDTANO(SC1->C1_DATPRF) ,,.T.)
						oItemEAI[Len(oItemEAI)]:setprop("CostCenterCode",   AllTrim(SC1->C1_CC) ,,.T.)
						oItemEAI[Len(oItemEAI)]:setprop("CostCenterInternalId", Iif(!Empty(SC1->C1_CC),IntCusExt(/*cEmpresa*/, /*cFilial*/, SC1->C1_CC, cCusVer)[2],"")   ,,.T.)
						oItemEAI[Len(oItemEAI)]:setprop("AccountantAcountCode", RTrim(SC1->C1_CONTA) ,,.T.)
						oItemEAI[Len(oItemEAI)]:setprop("MainOrderCode",   Rtrim(SC1->C1_OP) ,,.T.)
						oItemEAI[Len(oItemEAI)]:setprop("Observation",   RTrim(SC1->C1_OBS) ,,.T.)

						If lMktPlace
							EntFRUN(@oItemEAI,Len(oItemEAI))
						EndIf
						
						If lIntegTop //Possui integração com o RM Solum
							aItensRat := RatSC(PadR(cNumSC, nTamC1Num), PadR(SC1->C1_ITEM, nTamC1Item))

							oRtCPEAI := oItemEAI[Len(oItemEAI)]:setprop("ListOfApportionRequestItem", {}, 'ApportionRequestItem', , .T. )

							For n1Cnt := 1 To Len(aItensRat)
								nQtdRat := Iif(ValType(aItensRat[n1Cnt][8])=="C",Val(aItensRat[n1Cnt][8]),aItensRat[n1Cnt][8])
								oRtCPEAI[Len(oRtCPEAI)]:setprop("InternalId",   IntSCoExt(/*cEmpresa*/, /*cFilial*/, cNumSC, SC1->C1_ITEM, cSCoVer)[2] + '|' + PadL(n1Cnt, 2, "0") ,,.T.)
								oRtCPEAI[Len(oRtCPEAI)]:setprop("DepartamentCode",   "" ,,.T.)
								oRtCPEAI[Len(oRtCPEAI)]:setprop("DepartamentInternalId",   "" ,,.T.)
								oRtCPEAI[Len(oRtCPEAI)]:setprop("CostCenterInternalId", Iif(!Empty(aItensRat[n1Cnt][1]),IntCusExt(/*cEmpresa*/, /*cFilial*/, aItensRat[n1Cnt][1], cCusVer)[2],""),,.T.)
								oRtCPEAI[Len(oRtCPEAI)]:setprop("AccountantAcountInternalId", Iif(!Empty(aItensRat[n1Cnt][2]),cEmpAnt + "|" + cFilCT1 + "|" + AllTrim(aItensRat[n1Cnt][2]),""),,.T.)
								oRtCPEAI[Len(oRtCPEAI)]:setprop("ProjectInternalId", Iif(!Empty(aItensRat[n1Cnt][6]),IntPrjExt(/*cEmpresa*/, /*cFilial*/, aItensRat[n1Cnt][6], cPrjVer)[2],""),,.T.)
								oRtCPEAI[Len(oRtCPEAI)]:setprop("SubProjectInternalId",   "" ,,.T.)
								oRtCPEAI[Len(oRtCPEAI)]:setprop("TaskInternalId",Iif(!Empty(aItensRat[n1Cnt][7]),IntTrfExt(/*cEmpresa*/, /*cFilial*/, aItensRat[n1Cnt][6], '0001', aItensRat[n1Cnt][7], cTrfVer)[2],""),,.T.)
								oRtCPEAI[Len(oRtCPEAI)]:setprop("Value", AllTrim(cValToChar(nQtdRat * SC1->C1_PRECO)) ,,.T.)
								oRtCPEAI[Len(oRtCPEAI)]:setprop("Percentual", AllTrim(cValToChar(aItensRat[n1Cnt][5])) ,,.T.)
								oRtCPEAI[Len(oRtCPEAI)]:setprop("Quantity", AllTrim(cValToChar(nQtdRat)) ,,.T.)
								oRtCPEAI[Len(oRtCPEAI)]:setprop("Observation",   "" ,,.T.)
								oRtCPEAI[Len(oRtCPEAI)]:setprop("Event", "upsert" ,,.T.)
							Next n1Cnt
	
						Else
							//-- Rateio por Centro de Custo
							If lExtSCX
								SCX->(DbSetOrder(1))
	
								If SCX->(DbSeek(cFilCX+cNumSC+SC1->C1_ITEM))
									oRtCPEAI := oItemEAI[Len(oItemEAI)]:setprop("ListOfApportionRequestItem", {}, 'ApportionRequestItem', , .T. )

									While SCX->( !Eof() .And. SCX->CX_FILIAL + SCX->CX_SOLICIT + SCX->CX_ITEMSOL == cFilCX+cNumSC+SC1->C1_ITEM )
										oRtCPEAI[Len(oRtCPEAI)]:setprop("InternalId",   cEmpAnt + '|' + cFilCX + '|' + SCX->CX_SOLICIT + '|' + SCX->CX_ITEMSOL + '|' + SCX->CX_ITEM ,,.T.)
										oRtCPEAI[Len(oRtCPEAI)]:setprop("CostCenterInternalId",  IntCusExt(/*cEmpresa*/, /*cFilial*/, SCX->CX_CC, cCusVer)[2],,.T.)
										oRtCPEAI[Len(oRtCPEAI)]:setprop("AccountantAcountInternalId", Iif(!Empty(SCX->CX_CONTA),cEmpAnt + "|" + cFilCT1 + "|" + AllTrim(SCX->CX_CONTA),""),,.T.)
										oRtCPEAI[Len(oRtCPEAI)]:setprop("Percentual", cValToChar(SCX->CX_PERC) ,,.T.)
										
										SCX->(DbSkip())
									EndDo
								EndIf
							EndIf
						EndIf
	
						If lMktPlace
							//Bloqueia solicitação de compra.
							If RecLock("SC1",.F.)
								SC1->C1_ACCPROC := "1"
								SC1->(MsUnlock())
							Endif
						Endif
					EndIf
				EndIf
				
				SC1->(DbSkip())
			EndDo
		EndIf

	//-- Exclusao
	Else
		cNumSC := cA110Num
		cEvent := 'delete'
		CFGA070Mnt(,"SC1","C1_NUM",,IntSCoExt(/*cEmpresa*/, /*cFilial*/, cNumSC, /*cItemSC*/, cSCoVer)[2],.T.)

		/*Escrita do objeto json*/
		oFwEAIObj:Activate()

		/*BusinessEvent*/
		oFwEAIObj:setEvent(cEvent)
		oFwEAIObj:setHeader("Entity","Request")
		
		/*BusinessContent*/		
		oFwEAIObj:setprop("CompanyId",cEmpAnt)		
		oFwEAIObj:setprop("BranchId", cFilC1)
		oFwEAIObj:setprop("CompanyInternalId", cEmpAnt + '|' + cFilC1)
		oFwEAIObj:setprop("InternalId", IntSCoExt(/*cEmpresa*/, /*cFilial*/, cNumSC, /*cItemSC*/, cSCoVer)[2] )
		oFwEAIObj:setprop("Number", RTrim(cNumSC))
		oFwEAIObj:setprop("Type", "000")

		dbSelectArea("SC1")
		SC1->(DbSetOrder(1))

		If SC1->(DbSeek(cFilC1 + cNumSC))
			While SC1->(!EOF()) .And. cFilC1 + SC1->C1_NUM == cFilC1 + cNumSC
				oItemEAI := oFwEAIObj:setprop("ListOfRequestItem", {}, 'RequestItem', , .T. )

				oItemEAI[Len(oItemEAI)]:setprop("Code",   RTrim(SC1->C1_ITEM) ,,.T.)
				oItemEAI[Len(oItemEAI)]:setprop("InternalId",   IntSCoExt(/*Empresa*/, /*Filial*/, SC1->C1_NUM, SC1->C1_ITEM)[2] ,,.T.)
				oItemEAI[Len(oItemEAI)]:setprop("ItemCode",   RTrim(SC1->C1_PRODUTO) ,,.T.)
				oItemEAI[Len(oItemEAI)]:setprop("ItemInternalId",   IntProExt(,,SC1->C1_PRODUTO)[2] ,,.T.)

				SC1->(DbSkip())
			EndDo
		EndIf
	EndIf
EndIf

RestArea(aAreaSC1)
RestArea(aArea)

Return { lRet, ofwEAIObj, "REQUEST" } 

//-------------------------------------------------------------------
/*/{Protheus.doc} EntFRUN
Retorna Fonte de Recurso e Unidade de negócio
@author Raphael Augustos
@since 10/06/2013
/*/
//-------------------------------------------------------------------

Static Function EntFRUN(oItemEAI,nLin)

Local cDescri    := ""
Local cPipe      := "|"
Local cIntId     := cEmpAnt + "|" +xFilial("CV0")
Local lFonteRec  := !Empty(SC1->C1_ITEMCTA)
Local lUniNegoc  := !Empty(SC1->C1_CLVL)
Local lCodAtivi  := SC1->(FieldPos("C1_EC05DB")) > 0 .And. !Empty(SC1->C1_EC05DB)
Local lDespesa   := SC1->(FieldPos("C1_EC06DB")) > 0 .And. !Empty(SC1->C1_EC06DB)
Local oOutItEAI	 := Nil
Local oAddField  := Nil

If lFonteRec .Or. lUniNegoc .Or. lCodAtivi .Or. lDespesa
	oOutItEAI := oItemEAI[nLin]:setprop("OTHER", {}, 'ADDFIELDS', , .T. )

	If lFonteRec
		cDescri    :=  Posicione ("CTD",1,xFilial("CTD")+SC1->C1_ITEMCTA,"CTD_DESC01")
		oAddField := oOutItEAI[Len(oOutItEAI)]:setprop("ADDFIELDS", {}, 'ADDFIELD', , .T. )
		oAddField[Len(oAddField)]:setprop("field",  "AccountingItem"   ,,.T.)
		oAddField[Len(oAddField)]:setprop("value",  cEmpAnt + cPipe + xFilial("CTD") + cPipe + SC1->C1_ITEMCTA + cPipe + AllTrim(cDescri)  ,,.T.)
	Endif

	If lUniNegoc
		cDescri    :=  Posicione ("CTH",1,xFilial("CTH")+SC1->C1_CLVL,"CTH_DESC01")
		oAddField := oOutItEAI[Len(oOutItEAI)]:setprop("ADDFIELDS", {}, 'ADDFIELD', , .T. )
		oAddField[Len(oAddField)]:setprop("field",  "ClassValue"   ,,.T.)
		oAddField[Len(oAddField)]:setprop("value",  cEmpAnt + cPipe + xFilial("CTH") + cPipe  + SC1->C1_CLVL + cPipe + AllTrim(cDescri)  ,,.T.)
	Endif	

	//Codigo Atividade
	If lCodAtivi
		cDescri    :=  Posicione ("CV0",1,xFilial("CV0")+"05"+SC1->C1_EC05DB,"CV0_DESC")
		oAddField := oOutItEAI[Len(oOutItEAI)]:setprop("ADDFIELDS", {}, 'ADDFIELD', , .T. )
		oAddField[Len(oAddField)]:setprop("field",  "CodigoAtividade"   ,,.T.)
		oAddField[Len(oAddField)]:setprop("value",  cIntId + cPipe + "05" + cPipe + SC1->C1_EC05DB + cPipe + AllTrim(cDescri)  ,,.T.)
	EndIf

	//Despesa
	If lDespesa
		cDescri    :=  Posicione ("CV0",2,xFilial("CV0")+"06"+SC1->C1_EC06DB,"CV0_DESC")
		oAddField := oOutItEAI[Len(oOutItEAI)]:setprop("ADDFIELDS", {}, 'ADDFIELD', , .T. )
		oAddField[Len(oAddField)]:setprop("field",  "Despesa"   ,,.T.)
		oAddField[Len(oAddField)]:setprop("value",  cIntId + cPipe + "06" + cPipe + SC1->C1_EC06DB + cPipe + AllTrim(cDescri)  ,,.T.)
	EndIf
EndIf

Return
