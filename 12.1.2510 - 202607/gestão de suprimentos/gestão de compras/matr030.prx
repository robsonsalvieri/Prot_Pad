Function Matr030()

Local cReport	:= "MATR030"	//Nome do Programa
Local cAlias	:= "SA2"		//Alias da tabela
Local cTitle	:= STR0016      //"Listagem de Fornecedores"
Local cDesc		:= STR0017      //"Este relatório apresenta uma relação dos Fornecedores cadastrados."
Local lInd		:= .T.			//Retorna Indice SIX

//Validação de aviso/bloqueio do relatório em Release 12.1.2510 e superiores
if ExistFunc("VldDescRel")
	if !VldDescRel()
		Return
	endIf
endIf

	MPReport(cReport,cAlias,cTitle,cDesc,,lInd)	

Return