#include 'totvs.ch'

/*/{Protheus.doc} OFPMMDATA
	Tabela para gravar e recuperar dados de historico de PMM
	Hoje temos apenas alguns totais, no caos custo, vendas e inventario
	
	@type class
	@author Vinicius Gati
	@since 12/03/2026
/*/
Class OFPMMDATA
	data oSqlHlp
	data cTableName

	Public Method New() CONSTRUCTOR
	Public Method Inserir(cDealerCode, cCompetencia, nTotVendas, nTotCusto, nTotInventario)
	Public Method GetTotVendas(cDealerCode, cCompetencia)
	Public Method GetTotCusto(cDealerCode, cCompetencia)
	Public Method GetTotInventario(cDealerCode, cCompetencia)
	Public Method SetCusto(cDealerCode, cCompetencia, nValor)
	Public Method SetVendas(cDealerCode, cCompetencia, nValor)
	Public Method SetInventario(cDealerCode, cCompetencia, nValor)
	Public Method TemCusto(cDealerCode, cCompetencia)
	Public Method TemVendas(cDealerCode, cCompetencia)
	Public Method TemInventario(cDealerCode, cCompetencia)
EndClass

/*/{Protheus.doc} New
	Construtor que cria a tabela de auth do dms 
	@type method
	@since 12/03/2026
/*/
Method New() Class OFPMMDATA
Return SELF

/*/{Protheus.doc} Inserir
	Insere um registro na tabela de dados de historico para PMM

	Sempre deletamos registros ja existentes do mesmo dealer e competencia, sa podemos manter 1 e sempre o ultimo importado

	@type method
	@since 12/03/2026
/*/
Method Inserir(cDealerCode, cCompetencia, nTotVendas, nTotCusto, nTotInventario) Class OFPMMDATA
	Local cSql := ""

	// validacao dos dados
	If Empty(cDealerCode)
		return .T.
	EndIf

	If Empty(cCompetencia)
		return .T.
	EndIf

	// removendo registro pre existente caso exista (devemos ter apenas 1 registro apenas para cada dealer code e competencia)
	// assim fica ok para quando usuario importar mais de um arquivo e nao acumular valores, vale sempre o ultimo importado
	cSql := "DELETE FROM "+RetSqlName("VL1")+" WHERE VL1_FILIAL = ? AND VL1_DLRCOD = ? AND VL1_COMPET = ? AND D_E_L_E_T_ = ' ' "
	oStatement := FwExecStatement():new(cSql)
	oStatement:setString(1, xFilial('VL1'))
	oStatement:setString(2, cDealerCode)
	oStatement:setString(3, cCompetencia + "01")
	cSql := oStatement:getFixQuery()
	If TcSqlExec(cSql) < 0 .or. ExistBlock('PMMDATA1')
		Return .F.
	EndIf


	reclock("VL1", .T.)
	VL1->VL1_FILIAL := xFilial('VL1')
	VL1->VL1_CODIGO := GetSxeNum("VL1", 'VL1_CODIGO')
	VL1->VL1_DLRCOD := cDealerCode
	VL1->VL1_COMPET := cCompetencia + "01"
	VL1->VL1_CUSMES := nTotCusto
	VL1->VL1_VDAMES := nTotVendas
	VL1->VL1_INVMES := nTotInventario
	VL1->VL1_TIPREG := '2' // manual é absoluto, nunca regrava
	msUnlock()
	ConfirmSx8()
Return .T.

/*/{Protheus.doc} GetTotVendas
	Retorna o total de vendas do dealer code e competencia informados

	@type method
	@since 12/03/2026
/*/
Method GetTotVendas(cDealerCode, cCompetencia) Class OFPMMDATA
	Local cSql := ""

	If Empty(cDealerCode)
		return 0
	EndIf

	If Empty(cCompetencia)
		return 0
	EndIf

	cSql := "SELECT VL1_VDAMES FROM "+RetSqlName("VL1")+" WHERE VL1_FILIAL = ? AND VL1_DLRCOD = ? AND VL1_COMPET = ? AND D_E_L_E_T_ = ' ' "
	oStatement := FwExecStatement():new(cSql)
	oStatement:setString(1, xFilial('VL1'))
	oStatement:setString(2, cDealerCode)
	oStatement:setString(3, cCompetencia)
	cSql := oStatement:getFixQuery()
return FM_SQL(cSql)

