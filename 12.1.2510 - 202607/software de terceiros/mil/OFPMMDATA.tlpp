/*/{Protheus.doc} TemCusto
	Retorna se existe dados para o dealer code e competencia informados

	@type method
	@author Vinicius Gati
	@since 16/03/2026
/*/
Method TemCusto(cDealerCode, cCompetencia) Class OFPMMDATA
	Local cSql := ""

	If Empty(cDealerCode)
		return .F.
	EndIf

	If Empty(cCompetencia)
		return .F.
	EndIf

	cSql := "SELECT count(*) FROM "+RetSqlName("VL1")+" WHERE VL1_FILIAL = ? AND VL1_DLRCOD = ? AND VL1_COMPET = ? AND VL1_CUSMES > 0 AND D_E_L_E_T_ = ' ' "
	oStatement := FwExecStatement():new(cSql)
	oStatement:setString(1, xFilial('VL1'))
	oStatement:setString(2, cDealerCode)
	oStatement:setString(3, cCompetencia)
	cSql := oStatement:getFixQuery()
return FM_SQL(cSql) > 0

