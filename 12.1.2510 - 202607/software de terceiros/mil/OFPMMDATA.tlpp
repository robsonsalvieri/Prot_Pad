/*/{Protheus.doc} SetCusto
	Grava o custo do dealer code e competencia informados

	@type method
	@author Vinicius Gati
	@since 16/03/2026
/*/
Method SetCusto(cDealerCode, cCompetencia, nCusto) Class OFPMMDATA
	If Empty(cDealerCode)
		return .F.
	EndIf

	If Empty(cCompetencia)
		return .F.
	EndIf

	if nCusto <= 0
		return .F.
	EndIf

	dbSelectArea("VL1")
	dbSetOrder(2)
	
	if dbSeek(xFilial("VL1") + cDealerCode + cCompetencia)
		reclock("VL1", .F.)
		VL1->VL1_CUSMES := nCusto
		msUnlock()
	else
		reclock("VL1", .T.)
		VL1->VL1_FILIAL := xFilial("VL1")
		VL1->VL1_CODIGO := GetSxeNum("VL1", 'VL1_CODIGO')
		VL1->VL1_DLRCOD := cDealerCode
		VL1->VL1_COMPET := cCompetencia
		VL1->VL1_CUSMES := nCusto
		VL1->VL1_VDAMES := 0
		VL1->VL1_INVMES := 0
		msUnlock()
	EndIf	
return .t.

