#include 'protheus.ch'

/*/{Protheus.doc} OFLogRotativo
    Log em arquivo normal porem com limite de tamanho do conteudo
	Só atenção a diferença que essa sempre grava o timestamp nos logs

	@type function
	@author Vinicius Gati
	@since  11/02/2026
/*/
Class OFLogRotativo
	Data cLogFileName
	Data cLogDir
	Data nTamMax

	Public Method New() constructor
	Public Method Log()
	Public Method GetFile()	
EndClass

/*/{Protheus.doc} New
	Construtor Simples

	@type function
	@author Vinicius Gati
	@since  11/02/2026
/*/
Method New(cFileName, cFileDir, nTamRot) class OFLogRotativo
	Local nX
	Local cLogFolder := ""
	Default cFilename := "GERAL.LOG"
	Default cFileDir := ""
    Default nTamRot := 1024 * 1024

	If Empty(cFileDir)
		cLogFolder := "logsmil"
		makeDir(curdir() + cLogFolder)
		::cLogDir := curdir()
	Else
		aFolders := StrTokArr(cFileDir , "\")
		For nX := 1 to Len(aFolders)
			cLogFolder += "\" + AllTrim(aFolders[nX])
			makeDir(cLogFolder)
		Next
		::cLogDir := ""
	EndIf
	::cLogFileName := cLogFolder + ALLTRIM(" \ ") + cFileName

	::nTamMax := nTamRot
Return self

/*/{Protheus.doc} Log
	Loga verificando tamanho maximo e rotaciona se necessario porem apenas uma vez sobrescrevendo

	@type function
	@author Vinicius Gati
	@since  11/02/2026
/*/
Method Log(aLines) Class OFLogRotativo
	Local nIdx       := 0
	Local oArquivo   := Nil
	Local cPulaLinha := Chr(13) + Chr(10)
	Local nSize      := 0
	Local cMainFile  := ::cLogDir + ::cLogFileName
	Local cBakFile   := cMainFile + "001"

	// Abre o arquivo
	oArquivo := Self:GetFile()

	// Tamanho atual
	nSize := FSEEK(oArquivo, 0, 2)

	// Verifica limite
	If nSize >= ::nTamMax

		// Fecha arquivo atual
		FCLOSE(oArquivo)

		// Remove backup antigo
		If File(cBakFile)
			FERASE(cBakFile)
		EndIf

		// Renomeia atual para .001
		If File(cMainFile)
			FRENAME(cMainFile, cBakFile)
		EndIf

		// Cria novo arquivo
		oArquivo := FCREATE(cMainFile)

	EndIf

	// Grava linhas
	For nIdx := 1 To Len(aLines)

		// pra ficar compativel com o logger antigo
		if aLines[nIdx] == "TIMESTAMP"
			loop
		endif

		FWRITE(oArquivo, DTOS(Date()) + " " + Time() + ":" + Left(CValToChar(Seconds()), 8) + " ")
		FWRITE(oArquivo, aLines[nIdx] + cPulaLinha)

		If FERROR() <> 0
			ConOut("Erro gravando log: " + CValToChar(FERROR()))
			Exit
		EndIf

	Next

	FCLOSE(oArquivo)
Return


/*/{Protheus.doc} GetFile
	Cria/Abre arquivo e retorna o mesmo

	@author Vinicius Gati
	@since  11/02/2026
/*/
Method GetFile() Class OFLogRotativo
	Local cFullFilePath := ::cLogDir + ::cLogFileName
	Local oFileStream   := Nil
	If FILE(cFullFilePath)
		oFileStream := FOPEN( cFullFilePath, 1 ) // 1 = write FO_WRITE
	Else
		oFileStream := FCREATE( cFullFilePath )
	EndIf
	nFinalPos := FSEEK(oFileStream,0,2)
	FSEEK(oFileStream, nFinalPos)
Return oFileStream
