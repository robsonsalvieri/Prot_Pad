#include "tlpp-core.th"
#include "totvs.ch"
#INCLUDE "FWMVCDEF.CH"

//static lDebug := .f.

/*/{Protheus.doc} OFSoFranchise
	Classe com os dados de Franchise para comunicação com o Blackbird

	@type function
	@author Rubens Takahashi
	@since 10/01/2022
/*/
class OFSoFranchise from VERegistroSql
	Public Method New()
	Public Method ToJsonApi()
	Public Method ToJson()
	Public Method GetRefId()
	Public Method Fill()
	Public Method FindByRecnoDel()
	Public Method FindByGroup()
	Public Method DocVersion()
	Private Method checkForeignKey()
	
end class


/*/{Protheus.doc} New 
	Construtor basico

	@type function
	@author Rubens Takahashi
	@since 13/01/2022
/*/
method New() class OFSoFranchise
	_Super:New('VKB')

	::AddFields({"R_E_C_N_O_", "VKB_NOME","VKB_DESCRI", "VKB_TYPE" , "VKB_REFID", "VKB_GRUPO" })

	::SetPKField("VKB_REFID")

	//if lDebug
	//	Conout(" ")
	//	Conout( "OFSoFranchise:NEW " + Str(Procline(1),5) + " - " + ProcName(1) )
	//	Conout(" ")
	//endif

return self


/*/{Protheus.doc} FindByRecnoDel
	Busca pelo recno

	@type function
	@author Rubens Takahashi
	@since 13/01/2022
/*/
Method FindByRecnoDel(nRecno) Class OFSoFranchise
	self:Select();
		:_From(self:cAlias);
		:AndEq('R_E_C_N_O_', nRecno)

	// busca primeiro registro
	oReg := self:First()

	// limpa a query interna
	self:Clear()
Return oReg

/*/{Protheus.doc} FindByGroup
	Busca pelo grupo

	@type function
	@author Iury Soares Azevedo
	@since 31/07/2025
/*/
Method FindByGroup(cGroup) Class OFSoFranchise
	self:Select();
		:_From(self:cAlias);
		:AndEq('VKB_GRUPO', cGroup)

	// busca primeiro registro
	oReg := self:First()

	// limpa a query interna
	self:Clear()
Return oReg

/*/{Protheus.doc} GetRefId
	Retorna o reference id para usar no SO

	@type function
	@author Rubens Takahashi
	@since 13/01/2022
/*/
Method GetRefId() Class OFSoFranchise
Return self:Get("VKB_REFID")

/*/{Protheus.doc} ToJson
	retorna um json object

	@type method
	@author Rubens Takahashi
	@since 02/07/2021
/*/
Method ToJson(cOperation) Class OFSoFranchise
Return self:ToJsonApi(cOperation)

/*/{Protheus.doc} ToJsonApi
	Retorna um JSON para enviar a API

	@type function
	@author Rubens Takahashi
	@since 13/01/2022
/*/
Method ToJsonApi(cOperation) Class OFSoFranchise
	local jJson := JsonObject():New()
	local jJsonFranchise := JsonObject():New()

	//self:checkForeignKey(self:Get("VE1_RECNO"))

	//jJson["category"]        := NIL
	//jJson["description"]     := FGX_SetVlJson( self:Get("VV2_DESMOD"), .f. )
	//jJson["makeReferenceId"] := FGX_SetVlJson( "EK-" + self:Get("VE1.VE1_BBRFID"), .f. )
	//jJson["name"]            := FGX_SetVlJson( self:Get("VV2_MODVEI"), .f. )
	//jJson["referenceId"]     := FGX_SetVlJson( "EM-" + self:Get("VV2_BBRFID"), .f.)

	//if lDebug
	//	
	//	Conout( "-----------------------------------------------------------------------")
	//	// Conout( "OFSoFranchise toJsonApi " + Str(Procline(1),5) + " - " + ProcName(1))
	//
	//	nCont := 2
	//	While !Empty(ProcName(nCont))
	//		// Conout( "                       " + Str(Procline(nCont),5) + " - " + ProcName(nCont) )
	//		nCont++
	//	EndDo
	//	Conout( "-----------------------------------------------------------------------")
	//	Conout(" ")
	//
	//endif

	// referenceId  | required | string <= 100 characters         | A unique identifier that can be passed between systems.
	// name         | required | string <= 100 characters         | The name of the franchise.
	// description  |          | string or null <= 500 characters | A description for the franchise.
	// type         | required | string <= 100 characters         | Enum: "Parts" "Equipment" "Both" The type of franchise.

	jJsonFranchise["referenceId"] := OFXFA0084_WithPrefix("FR-", self:GetRefId())
	if cOperation == 'added' .or. cOperation == 'modified'
		jJsonFranchise["name"]        := FGX_SetVlJson( self:Get("VKB_NOME"), .f. )
		jJsonFranchise["description"] := FGX_SetVlJson( self:Get("VKB_DESCRI"), .f. )
		//jJsonFranchise["type"]        := FGX_SetVlJson( self:Get("VKB_TYPE"), .f. )
		do case
		case self:Get("VKB_TYPE") == "1"; jJsonFranchise["type"]:= "Parts"
		case self:Get("VKB_TYPE") == "2"; jJsonFranchise["type"]:= "Equipment"
		case self:Get("VKB_TYPE") == "3"; jJsonFranchise["type"]:= "Both"
		otherwise; jJsonFranchise["type"]:= nil
		endcase
	endif
	jJson[cOperation] := {}
	AADD( jJson[cOperation] , jJsonFranchise )

Return jJson



