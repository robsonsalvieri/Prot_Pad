#include "tlpp-core.th"
#include 'totvs.ch'

/*/{Protheus.doc} OFSoFranchiseRefDataChangedInDbsMessage
	Classe que representa uma mensagem da entidade Franchise mensagem ChangedInDbs
	
	@type class
	@author Vinicius Gati
	@since 09/08/2021
/*/
Class OFSoFranchiseRefDataChangedInDbsMessage
	public data cName
	public data oSoRequest
	data oSoFranchise
	data cMessageId
	data cMsgVX5
	data cOriId
	data cOperation

	public Method New() CONSTRUCTOR
	public Method GetMessageId()
	public Method SetFranchise()
	public Method SetOperation()
	public Method Send()
	public Method GetBody()
	public Method GetHeader()
	public Method Delay()
EndClass

/*/{Protheus.doc} New
	Construtor Simples

	@type method
	@author Vinicius Gati
	@since 09/08/2021
/*/
Method New(oFranchise) Class OFSoFranchiseRefDataChangedInDbsMessage
	::cName := "FranchiseRefDataChangedInDbs"
	::oSoRequest := OFSoRequest():New(self)

	::oSoRequest:Set("VK5_ORITAB", "VKB")
	::oSoRequest:Set("VK5_MESSAG", "28")

	::cOperation := 'added'

	if valtype(oFranchise) != "U"
		::SetFranchise(oFranchise)
	endif
Return SELF

/*/{Protheus.doc} SetFranchise
	Seta o Franchise que gerará o body da mensagem

	@type method
	@author Vinicius Gati
	@since 10/08/2021
/*/
Method SetFranchise(oSoFranchise) Class OFSoFranchiseRefDataChangedInDbsMessage
	self:oSoFranchise := oSoFranchise
	self:oSoRequest:SetBody(self:GetBody())

	self:oSoRequest:Set("VK5_ORIKEY", self:oSoFranchise:GetRefId())

Return .t.

/*/{Protheus.doc} SetOperation
	Controla a operacao que será realizada.
		- added
		- updated
		- deleted
	
	As API's RefData tem essa particularidade de ter o mesmo endpoint para todas as operações.
		Por isso, é necessário informar a operação que será realizada.

	@type method
	@author Rubens Takahashi
	@since 12/05/2025
/*/
Method SetOperation(cOperation) Class OFSoFranchiseRefDataChangedInDbsMessage

	self:cOperation := cOperation

Return .T.

/*/{Protheus.doc} GetMessageId
	Retorna o nome da mensagem para ser enviada ao SO onde necessário

	@type method
	@author Vinicius Gati
	@since 09/08/2021
/*/
Method GetMessageId() Class OFSoFranchiseRefDataChangedInDbsMessage
	if valtype(self:cMessageId) == "U"
		self:cMessageId := "franchise-" + FWUUIDV4(.t.)
	endif
return self:cMessageId

/*/{Protheus.doc} GetBody
	Retorna o body para a mensagem

	@type method
	@author Vinicius Gati
	@since 12/08/2021
/*/
Method GetBody() Class OFSoFranchiseRefDataChangedInDbsMessage
	oReqBody := OFSoRequestBody():New()
	oReqBody:SetData(self:oSoFranchise:toJson(self:cOperation))
	oReqBody:SetName(self:cName)
Return oReqBody

/*/{Protheus.doc} GetHeader
	Retorna o header da mensagem

	@type method
	@author Vinicius Gati
	@since 12/08/2021
/*/
Method GetHeader() Class OFSoFranchiseRefDataChangedInDbsMessage
Return self:oSoRequest:GetHeader()

/*/{Protheus.doc} Send
	Envia mensagem para SO

	@type method
	@author Vinicius Gati
	@since 12/08/2021
/*/
Method Send() Class OFSoFranchiseRefDataChangedInDbsMessage
	local oComm := OFSoCommunication():New()
	self:oSoRequest:SetBody(self:GetBody())
	self:oSoRequest:Save()

	jResp := oComm:SendMessage(self, self:oSoRequest)
	//if jResp["code"] == oComm:nCodigoFalhaComunicacao
	//	self:Delay() // atrasa para tentar mais tarde
	//endif
Return 

/*/{Protheus.doc} Delay
	atrasa a mensagem por falha de comunicação

	@type method
	@author Vinicius Gati
	@since 19/10/2021
/*/
Method Delay() Class OFSoFranchiseRefDataChangedInDbsMessage
	Local oMsg := OFDMSExitMessage():New()
	local oJson := JsonObject():New()
	self:oSoRequest:Save()
	oJson['header'] := self:oSoRequest:GetHeader():ToJson()
	oJson['body'] := self:oSoRequest:GetBody():ToJson()
	oMsg:Set("VK6_PAYLOA", oJson:toJson())
	oMsg:Set("VK6_MSGNAM", OFDMSMessageConstants():FranchiseRefDataChangedInDbsMessageName())
	oMsg:Set("VK6_CODVK5", self:oSoRequest:GetId())
	oMsg:SetAtrasada()
Return oMsg:Save()
