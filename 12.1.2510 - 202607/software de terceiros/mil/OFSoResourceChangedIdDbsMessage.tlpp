#include "tlpp-core.th"
#include 'totvs.ch'

/*/{Protheus.doc} OFSoResourceChangedInDbsMessage
	Classe que representa uma mensagem da entidade Resource mensagem ChangedInDbs
	
	@type class
	@author Guilherme Vieira
	@since 09/08/2021
/*/
Class OFSoResourceChangedInDbsMessage

	public data cName
	public data oSoRequest
	data oSoResource
	data cMessageId
	data cMsgVX5
	data cOriId
	data cOperation

	public Method New() CONSTRUCTOR
	public Method GetMessageId()
	public Method SetResource()
	public Method Send()
	public Method GetBody()
	public Method GetHeader()
	public Method Delay()

	public Method SetOperation()

EndClass

/*/{Protheus.doc} New
	Construtor Simples

	@type method
	@author Guilherme Vieira
	@since 09/08/2021
/*/
Method New(oResource, cOperation) Class OFSoResourceChangedInDbsMessage

	::cName := "ResourceRefDataChangedInDbs"
	::oSoRequest := OFSoRequest():New(self)

	::oSoRequest:Set("VK5_ORITAB", "VAI")
	::oSoRequest:Set("VK5_MESSAG", "27")

	if ! empty(cOperation)
		::SetOperation(cOperation)
	endif


	if valtype(oResource) != "U"
		::SetResource(oResource)
	endif

Return SELF

/*/{Protheus.doc} SetResource
	Seta o Resource que gerará o body da mensagem

	@type method
	@author Guilherme Vieira
	@since 10/08/2021
/*/
Method SetResource(oSoResource) Class OFSoResourceChangedInDbsMessage

	self:oSoResource := oSoResource
	self:oSoRequest:SetBody(self:GetBody())

	self:oSoRequest:Set("VK5_ORIKEY", self:oSoResource:GetRefId())

Return .T.

/*/{Protheus.doc} SetOperation
	Controla a operacao que será realizada.
		- added
		- updated
		- deleted
	
	As API's RefData tem essa particularidade de ter o mesmo endpoint para todas as operações.
		Por isso, é necessário informar a operação que será realizada.

	@type method
	@author Rubens Takahashi
	@since 12/05/2025
/*/
Method SetOperation(cOperation) Class OFSoResourceChangedInDbsMessage

	self:cOperation := cOperation

Return .T.

/*/{Protheus.doc} GetMessageId
	Retorna o nome da mensagem para ser enviada ao SO onde necessário

	@type method
	@author Guilherme Vieira
	@since 09/08/2021
/*/
Method GetMessageId() Class OFSoResourceChangedInDbsMessage

	if valtype(self:cMessageId) == "U"
		self:cMessageId := "resource-" + FWUUIDV4(.T.)
	endif

return self:cMessageId

/*/{Protheus.doc} GetBody
	Retorna o body para a mensagem

	@type method
	@author Guilherme Vieira
	@since 12/08/2021
/*/
Method GetBody() Class OFSoResourceChangedInDbsMessage

	oReqBody := OFSoRequestBody():New()
	oReqBody:SetData(self:oSoResource:toJson(self:cOperation))
	oReqBody:SetName(self:cName)

Return oReqBody

/*/{Protheus.doc} GetHeader
	Retorna o header da mensagem

	@type method
	@author Guilherme Vieira
	@since 12/08/2021
/*/
Method GetHeader() Class OFSoResourceChangedInDbsMessage
Return self:oSoRequest:GetHeader()

/*/{Protheus.doc} Send
	Envia mensagem para SO

	@type method
	@author Guilherme Vieira
	@since 12/08/2021
/*/
Method Send() Class OFSoResourceChangedInDbsMessage

	local oComm := OFSoCommunication():New()

	self:oSoRequest:SetBody(self:GetBody())
	self:oSoRequest:Save() 

	jResp := oComm:SendMessage(self, self:oSoRequest)
	//if jResp["code"] == oComm:nCodigoFalhaComunicacao
	//	self:Delay() // atrasa para tentar mais tarde
	//endif

Return 

/*/{Protheus.doc} Delay
	atrasa a mensagem por falha de comunicação

	@type method
	@author Guilherme Vieira
	@since 19/10/2021
/*/
Method Delay() Class OFSoResourceChangedInDbsMessage

	Local oMsg := OFDMSExitMessage():New()
	local oJson := JsonObject():New()

	self:oSoRequest:Save()

	oJson['header'] := self:oSoRequest:GetHeader():ToJson()
	oJson['body'] := self:oSoRequest:GetBody():ToJson()

	oMsg:Set("VK6_PAYLOA", oJson:toJson())
	oMsg:Set("VK6_MSGNAM", OFDMSMessageConstants():ResourceChangedInDbsMessageName())
	oMsg:Set("VK6_CODVK5", self:oSoRequest:GetId())

	oMsg:SetAtrasada()

Return oMsg:Save()
