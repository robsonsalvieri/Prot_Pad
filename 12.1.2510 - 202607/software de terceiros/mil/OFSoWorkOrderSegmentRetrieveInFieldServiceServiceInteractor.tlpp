#include 'totvs.ch'
#Include "FWMVCDEF.CH"
#include "OFIXDEF.ch"
//#include "OFSoWorkOrderSegmentRetrieveInFieldServiceServiceInteractor.ch"

#DEFINE STR0001 "Invalid body data, work order does not exist."
#DEFINE STR0002 "Invalid body data, work order segment does not exist."


/*/{Protheus.doc} OFSworkOrderSegmentRetrieveInFieldServiceInteractor
	Classe que vai tratar a criacao de modelos no field service
	
	@type class
	@author Iury Soares Azevedo
	@since 12/06/2025
/*/
Class OFSworkOrderSegmentRetrieveInFieldServiceInteractor
	public data OFSoWorkOrder as object
	Public Method New() CONSTRUCTOR
	Public Method Process()
EndClass

/*/{Protheus.doc} New
	Construtor Simples

	@type method
	@author Iury Soares Azevedo
	@since 13/06/2025
/*/
Method New() Class OFSworkOrderSegmentRetrieveInFieldServiceInteractor
	self:OFSoWorkOrder := OFSoWorkOrder():New()
Return SELF

/*/{Protheus.doc} Process
	processa a criacao
	@type method
	@author Iury Soares Azevedo
	@since 30/06/2025
/*/
Method Process(jSoRequestBody) Class OFSworkOrderSegmentRetrieveInFieldServiceInteractor
	local jBody := jSoRequestBody:jBody as Json
	local cReferenceID := "" as character
	local cSegmReferenceID := "" as character
	local jRet as json
	local cNumOSV := "" as character


	if jBody:HasProperty("data")
		cReferenceID := iif(jBody["data"]:HasProperty("woHeaderReferenceId"),jBody["data"]["woHeaderReferenceId"],"")
		cSegmReferenceID := iif(jBody["data"]:HasProperty("referenceId"),jBody["data"]["referenceId"],"")
	endif


	if empty(cReferenceID) .OR. ;
		! self:OFSoWorkOrder:existsWorkOrder(cReferenceID)
		
		jRet :=  OFSoRestErrorResponse():BadRequest("WorkOrderSegmentRetrieveInFieldService", 0, STR0001, "")	// "Invalid body data, work order does not exist."
		return jret
	endif

	if empty(cSegmReferenceID) .OR. ;
		! self:OFSoWorkOrder:existsWorkOrderSegment(cSegmReferenceID)
		
		jRet :=  OFSoRestErrorResponse():BadRequest("WorkOrderSegmentRetrieveInFieldService", 0, STR0002, "")	// "Invalid body data, work order segment does not exist."
		return jret
	endif

	cNumOSV := self:OFSoWorkOrder:getNumOSV()
	
	SB2->(dbSelectArea("SB2"))
	SB2->(dbSetOrder(1))

	//Pergunta usada para trazer parametros de busca de estoque
	Pergunte("MTA260",.F.)

	jRet := JsonObject():New()
	jRet["referenceId"] := jBody["data"]["referenceId"]
	jRet["salesOrderNumber"] := jBody["data"]["salesOrderNumber"]
	jRet["salesOrderReferenceId"] := jBody["data"]["salesOrderReferenceId"]
	jRet["woHeaderNumber"] := jBody["data"]["woHeaderNumber"]
	jRet["woHeaderReferenceId"] := jBody["data"]["woHeaderReferenceId"]
	jRet["woSegmentNumber"] := jBody["data"]["woSegmentNumber"]
	jRet["parts"] := GetParts(cNumOSV,self:OFSoWorkOrder:getSeqInc())
	jRet := OFSoResponseBody():New(200, jSoRequestBody, jRet)
	
	
return jRet


/*/{Protheus.doc} GetParts
	Efetua a busca das pecas e monta o retorno
	@type method
	@author Iury Soares Azevedo
	@since 30/06/2025
/*/
Static Function GetParts(cNumOSV,cSeqInc)
	Local aRet := {} as array
	Local cAlias := GetNextAlias() as character
	Local nBinQtd as numeric
	Local nQtdReq as numeric
	Local nQtdIni as numeric
	Local cBinLocal as character
	Local cFranchise as character
	Local oFSoFranchise := oFSoFranchise():New() as object
	//Precisa agrupoar por BRRFID, ja que pela regra atual na VSJ nao e possivel atualizar linha
	//sendo assim quando enviada uma nova solicitacao de update vai ser gerada novas linhas com mesmo BBRFID
	BeginSql Alias cAlias
		SELECT
			VSJ_BBRFID, VSJ_CODITE, B1_LOCPAD, B1_DESC, B1_CODBAR, B1_GRUPO, SB2.R_E_C_N_O_ B2_RECNO, 
			MAX(VSJ_VALCUS) VSJ_VALCUS, MAX(VSJ_VALPEC) VSJ_VALPEC,
			SUM(VSJ_QTDINI) VSJ_QTDINI, SUM(VSJ_QTDREQ) VSJ_QTDREQ, SUM(VSJ_QTDDEV) VSJ_QTDDEV
		FROM
			%Table:VSJ% VSJ
		JOIN
			%Table:SB1% SB1
		ON
			SB1.%notDel%
			AND B1_FILIAL = %xFiliaL:SB1%
			AND B1_COD = VSJ_CODITE
		LEFT JOIN
			%Table:SB2% SB2
		ON
			SB2.%notDel%
			AND B2_FILIAL = %xFiliaL:SB2%
			AND B2_COD = B1_COD
			AND B2_LOCAL = B1_LOCPAD
		WHERE
			VSJ.%notDel%
			AND VSJ_NUMOSV = %Exp:cNumOSV%
			AND VSJ_SEQINC = %Exp:cSeqInc%
		GROUP BY
			VSJ_BBRFID, VSJ_CODITE, B1_LOCPAD, B1_DESC, B1_CODBAR, B1_GRUPO, SB2.R_E_C_N_O_
	EndSql
	
	While (cAlias)->(!EOF())
		If (cAlias)->B2_RECNO > 0 
			SB2->(DbGoTo((cAlias)->B2_RECNO))
			nBinQtd := SaldoMov(nil, nil, nil, If(mv_par03 == 1, .F., Nil), nil, nil, nil, nil)
			cBinLocal := (cAlias)->B1_LOCPAD
		Else
			nBinQtd := 0
			cBinLocal := ""
		EndIf

		jPart := JsonObject():New()
		jPart["referenceId"] := FGX_SetVlJson((cAlias)->VSJ_BBRFID)
		jPart["partNumber"] := FGX_SetVlJson((cAlias)->VSJ_CODITE)
		jPart["partItemType"] := "Part"
		jPart["partType"] := "RegularPart"
		jPart["locationReferenceId"] :=  cEmpAnt + "-" + cFilAnt

		oFSoFranchise := oFSoFranchise:FindByGroup((cAlias)->B1_GRUPO)
		If !Empty(oFSoFranchise) .AND. !Empty(oFSoFranchise:Get('VKB_REFID'))
			cFranchise :=  "FR-" + oFSoFranchise:Get('VKB_REFID')		
		EndIf
		
		jPart["franchiseReferenceId"] := cFranchise

		nQtdReq := (cAlias)->VSJ_QTDREQ - (cAlias)->VSJ_QTDDEV
		nQtdIni := (cAlias)->VSJ_QTDINI - (cAlias)->VSJ_QTDDEV

		jPart["requestedQuantity"] := nQtdIni
		jPart["suppliedQuantity"] := nQtdReq
		jPart["binQuantity"] := nBinQtd
		jPart["binLocation"] := cBinLocal
		jPart["taxCategory"] := "Taxable"
		jPart["taxRegionReferenceId"] := nil
		jPart["regulatoryUnitsReferenceId"] := nil
		jPart["satCodeReferenceId"] := nil
		jPart["unitCost"] := (cAlias)->VSJ_VALCUS
		jPart["unitPrice"] := (cAlias)->VSJ_VALPEC
		jPart["lineTotal"] := nQtdIni * (cAlias)->VSJ_VALPEC
		jPart["priceLevel"] := nil
		jPart["description"] :=  FGX_SetVlJson((cAlias)->B1_DESC)
		jPart["serialNumber"] :=  FGX_SetVlJson((cAlias)->B1_CODBAR)
		jPart["invoiceNote"] := ""
		
		aadd(aRet,jPart)

		(cAlias)->(dbSkip())
	EndDo
	
	(cAlias)->(dbCloseArea())

Return aRet
