//--------------------------------------------------------------------------------
/*/{Protheus.doc} fExecSTQ
Função para colocar na tela os dados da STQ (Checklists)

@param cOrderCode, String, Código da O.S.

@author	Cauê Girardi Petri
@since  20/10/2023
/*/
//--------------------------------------------------------------------------------
Static Function fExecSTQ(cOrderCode)

    Local nCount := 0

    DbSelectArea( 'STQ' )
    DbSetOrder( 1 )
    If DbSeek( FwxFilial('STQ') + cOrderCode )

        oRest:SetResponse( ',"checklists":[' ) 

        While STJ->TJ_FILIAL == STQ->TQ_FILIAL .AND. STJ->TJ_PLANO == STQ->TQ_PLANO;
            .AND. STJ->TJ_ORDEM == STQ->TQ_ORDEM

            If nCount >= 1

                oRest:SetResponse(',')

            EndIf

            oRest:SetResponse('{')

            oRest:SetResponse( '"fields":{' )

            fLoadField('STQ')

            oRest:SetResponse( '}' ) 

            //Procura e escreve as repostas do checklist
            fExecTPQ(cOrderCode)

            STQ->( DbSkip() )

            oRest:SetResponse('}')

            nCount++

        End

        oRest:SetResponse( ']' )

    EndIf

Return

//--------------------------------------------------------------------------------
/*/{Protheus.doc} fExecTPQ
Função para colocar na tela os dados da TPQ (Resposta das checklists)

@param cOrderCode, String, Código da O.S.

@author	Cauê Girardi Petri
@since  20/10/2023
/*/
//--------------------------------------------------------------------------------
Static Function fExecTPQ(cOrderCode)

    Local nCount := 0

    DbSelectArea( 'TPQ' )
    DbSetOrder( 1 )
    If DbSeek( FwxFilial('TPQ') + cOrderCode )

        oRest:SetResponse( ',"answers":[' )
        
        While STQ->TQ_FILIAL == TPQ->TPQ_FILIAL .AND. STQ->TQ_PLANO == TPQ->TPQ_PLANO;
            .AND. STQ->TQ_ORDEM == TPQ->TPQ_ORDEM .AND. STQ->TQ_ETAPA == TPQ->TPQ_ETAPA

            If nCount >= 1

                oRest:SetResponse(',')

            EndIf

            oRest:SetResponse( '{' )

            fLoadField( 'TPQ' )

            oRest:SetResponse('}')

            TPQ->( DbSkip() )

            nCount++

        End

        oRest:SetResponse( ']' )

    EndIf

Return

//--------------------------------------------------------------------------------
/*/{Protheus.doc} fExecTPL
Função para colocar na tela os dados da TPL (Motivo de Atraso)

@param cOrderCode, String, Código da O.S.

@author	Cauê Girardi Petri
@since  20/10/2023
/*/
//--------------------------------------------------------------------------------
Static Function fExecTPL(cOrderCode)

    Local nCount := 0

    DbSelectArea( 'TPL' )
    DbSetOrder( 1 )
    If DbSeek( FwxFilial('TPL') + cOrderCode )

        oRest:SetResponse( ',"reasonsForDelay":[' ) 

        While STJ->TJ_FILIAL == TPL->TPL_FILIAL .AND. STJ->TJ_ORDEM == TPL->TPL_ORDEM
            
        If nCount >= 1

            oRest:SetResponse(',')

        EndIf

            oRest:SetResponse( '{' )

            fLoadField( 'TPL' )

            oRest:SetResponse('}' )

            TPL->( DbSkip() )

            nCount++

        End

        oRest:SetResponse( ']' )

    EndIf

Return

//--------------------------------------------------------------------------------
/*/{Protheus.doc} fLoadField
Função para carregar os campos de cada tabela

@param cAliasTab , String, Alias atual

@author	Cauê Girardi Petri
@since  20/10/2023
/*/
//--------------------------------------------------------------------------------
Static Function fLoadField( cAliasTab )

    Local aCampos   := {}
    Local ni        := 0
    Local cResult   := ''

    RegToMemory( cAliasTab, .F. )
    aCampos := NGHeader( cAliasTab, , .F. )

    For ni := 1 to Len(aCampos)


        If aCampos[ ni,10 ] <> 'V'

            If aCampos[ni][8] == 'C' .OR. aCampos[ni][8] == 'M'

                cResult := '"' + &( cAliasTab + '->' + aCampos[ni][2]) + '"'

            ElseIf aCampos[ni][8] == 'D'

                cResult := '"' + DtoS( &( cAliasTab + '->' +  aCampos[ni][2] ) ) + '"'

            Else

                cResult := cValToChar( &( cAliasTab + '->' +  aCampos[ni][2] ) )

            EndIf

        Else

            cResult := '"' + AllTrim( &( Posicione("SX3",2,aCampos[ni,2],"X3_RELACAO") ) ) + '"'

        EndIf

        If !Empty( cResult )

            If ni > 1

                oRest:SetResponse( ', ' ) 

            EndIf

            oRest:SetResponse( '"'+ aCampos[ni][2] + '"' + ': ' + cResult )

        EndIf

    Next ni

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} fGerOs
Gera a OS com os parametros enviados
@type  static function

@author Cauê Girardi Petri
@since	16/03/2023

@param oJson, Objeto, Objeto com Json enviado
@param cMsg, String, Mensagem vinda dos requests
 
@return	String, Se gerar, retorna erro do NgGeraOS
/*/
//---------------------------------------------------------------------

Static Function fGerOs( oJson )

    Local aRetornoOs:= {{'S', '', ''}}
    Local aReturn   := { 200, '' }
    Local aCont     := {}
    Local aCampsSTJ:= {}
    Local aNames    := oJson:GetNames()
    Local dDtOrigi  := StoD( '' )
    Local dDtPrIni  := StoD( '' )
    Local cHoPrIni  := ''
    Local dMvUlmes  := SuperGetMv("MV_ULMES",.F.,Stod(""))
    Local nPosCont  := 0
    Local nPosCont2 := 0
    Local nI        := 0
    Local cHoraCo1  := ''
    Local cHoraCo2  := ''
    Local cCodBem   := ''   
    Local cServic   := ''
    Local cSituac   := ''
    Local cSeqRela  := ''
    Local cTipoOS   := ''
    Local cTipManu  := ''
    Local cFieldSTJ := ''
    Local lTerceir  := .F.
    Local oJsonOS   := JsonObject():New()

    oJsonOS := oJson['order']

    If oJsonOS:hasProperty('TJ_DTORIGI')
        dDtOrigi := StoD( oJsonOS['TJ_DTORIGI'] )
    EndIf
    If oJsonOS:hasProperty('TJ_CODBEM')
        cCodBem := PadR( oJsonOS['TJ_CODBEM'], TAMSX3( 'TJ_CODBEM' )[1] )
    EndIf
    If oJsonOS:hasProperty('TJ_SERVICO')
        cServic := PadR( oJsonOS['TJ_SERVICO'], TAMSX3( 'TJ_SERVICO' )[1] )
    EndIf
    If oJsonOS:hasProperty('TJ_POSCONT')
        nPosCont := oJsonOS['TJ_POSCONT']
        If oJsonOS:hasProperty('TJ_HORACO1')
            cHoraCo1 := oJsonOS['TJ_HORACO1']
        EndIf
    EndIf
    If oJsonOS:hasProperty('TJ_POSCON2')
        nPosCont2 := oJsonOS['TJ_POSCON2']
        If oJsonOS:hasProperty('TJ_HORACO2')
            cHoraCo2 := oJsonOS['TJ_HORACO2']
        EndIf
    EndIf
    If oJsonOS:hasProperty('TJ_SITUACA') .And. !Empty( oJsonOS['TJ_SITUACA'] )
        cSituac := oJsonOS['TJ_SITUACA']
    EndIf
    If oJsonOS:hasProperty('TJ_TERCEIR')
        If oJsonOS['TJ_TERCEIR'] == 1
            lTerceir := .F.
        ElseIf oJsonOS['TJ_TERCEIR'] == 2
            lTerceir := .T.
        Else
            aReturn := {400, STR021} //"O campo TJ_TERCEIR deve ser preenchido apenas com 1 ou 2"
        EndIf
    EndIf
    If oJsonOS:hasProperty('TJ_SEQRELA')
        cSeqRela := oJsonOS['TJ_SEQRELA']
    EndIf
    If oJsonOS:hasProperty('TJ_TIPOOS')
       cTipoOS := oJsonOS['TJ_TIPOOS']
    EndIf
    If oJsonOS:hasProperty('TJ_DTPRINI')
       dDtPrIni := Stod( oJsonOS['TJ_DTPRINI'] )
        If oJsonOS:hasProperty('TJ_HOPRINI')
            cHoPrIni := oJsonOS['TJ_HOPRINI']
        EndIf
    EndIf
    If oJsonOS:hasProperty('TJ_OBSERVA')
       aAdd( aCampsSTJ, { 'TJ_OBSERVA', oJsonOS['TJ_OBSERVA'] } )
    EndIf
    
    cTipManu := NgSeek( 'STE', NgSeek( 'ST4',cServic, 1, 'T4_TIPOMAN' ), 1, 'TE_CARACTE')

    If !Empty( nPosCont )

        aAdd(aCont, { nPosCont, cHoraCo1 } )

        If !Empty( nPosCont2 )

            aAdd(aCont, { nPosCont2, cHoraCo2 })

        EndIf
        
    EndIf

    DbSelectArea( 'STJ' )

    For nI := 1 TO FCount()
        cFieldSTJ := FieldName(nI)
        If AllTrim(Posicione("SX3",2,cFieldSTJ,"X3_PROPRI")) == "U"

            If Valtype( oJsonOS[ cFieldSTJ ] ) != 'U'

                Aadd( aCampsSTJ, { cFieldSTJ, oJsonOS[ cFieldSTJ ] } )

            EndIf
            
        EndIf
        
    Next nI

    If aReturn[1] == 200 .And. aScan(aNames, {|x| Alltrim(x) == 'symptom'})

        aReturn := fValidSymptoms( oJson )

    EndIf

    If SuperGetMv("MV_NGMNTES",.F.,"N") == "S" .And. dDtOrigi <= dMvUlmes
		aReturn := { 400, STR022 + Dtoc( dMvUlmes )  }//"A data da ordem de serviço não pode ser menor ou igual a data do último fechamento do estoque "
	EndIf

    If !Empty( cSituac ) .And. !( cSituac $ 'L/P/C' )

        aReturn := { 400, STR047 } //'Valor do campo TJ_SITUACA inválido'

    EndIf

    If aReturn[1] == 200

        If cTipManu = 'P'

            aRetornoOs := NGGERAOS(cTipManu, dDtOrigi, cCodBem, cServic, cSeqRela, 'S', 'S', 'S', , cSituac, .F., .F., aCampsSTJ, cTipoOS, , dDtPrIni, cHoPrIni, dDtOrigi, , ,aCont, .F. )

        Else

            aRetornoOs := NGGERAOS(cTipManu, dDtOrigi, cCodBem, cServic, cSeqRela, 'N', 'N', 'N', , cSituac, .F., .F., aCampsSTJ, cTipoOS, , dDtPrIni, cHoPrIni, dDtOrigi, , ,aCont, .F. )

        EndIf

        If aRetornoOs[1][1] == 'S'
        
            If aScan(aNames, {|x| Alltrim(x) == 'symptom'})

                fSaveSymptoms( oJson, aRetornoOs[1][3] )

            EndIf

            If aReturn[1] == 200 .And. aScan(aNames, {|x| Alltrim(x) == 'inputs'})

                DbSelectArea('STJ')
                DbSetOrder(1)
                //Posiciona na OS recém cadastrada
                DbGoTo(LastRec())

                aReturn := fCreateIns( oJson, aRetornoOs[1][3], cTipManu, 3 )

            EndIf

            If aReturn[1] == 200 .And. aScan(aNames, {|x| Alltrim(x) == 'occurrences'})

                aReturn := fCreateOcu( oJson, aRetornoOs[1][3] )

            EndIf

            If aReturn[1] == 200 .And. aScan(aNames, {|x| Alltrim(x) == 'checklists'})

                DbSelectArea('STJ')
                DbSetOrder(1)
                If MsSeek( FwxFilial( 'STJ' ) + aRetornoOs[1][3] )

                    aReturn := fChecklists( oJson, aRetornoOs[1][3], STJ->TJ_PLANO, cTipManu, 3 )

                EndIf

            EndIf

        Else

            aReturn := { 400, aRetornoOs[1][2] }

        EndIf

    EndIf

    If aReturn[1] == 200

        aReturn[2] := STR008 + aRetornoOs[1][3] + STR009 //"Ordem de Serviço " ## " incluida com sucesso"

        ConfirmSX8()

    Else

        RollBackSX8()

    EndIf

Return aReturn

//--------------------------------------------------------------------------------
/*/{Protheus.doc} fExecute
Função para chamar a função do ExecAuto e adicionar uma mensagem
@type static funtion

@author	Cauê Girardi Petri
@since  08/11/2023

@param oWs, Objeto, referência ao webservice

@return Lógico, Retorna .F. caso o processo retorne com erro, e .T. caso sucesso
/*/
//--------------------------------------------------------------------------------
Static Function fExecute( oWs )

    Local aReturn   := {}
    Local lRet      := .F.
    Local oJson     := JsonObject():New()
    Local cBody     := oWs:getBodyRequest()

    cError  := oJson:FromJson( cBody )

    If Valtype( cError ) == 'C' 

        printf( STR007 + STR006 + cError ) //'Erro: '##'Json inválido'
        oWs:SetStatusCode( 500 )
        oWs:SetFault( cError )
 
    Else

        Begin Transaction

            aReturn := fGerOs( oJson )

            If aReturn[1] != 200

                printf( STR007 + aReturn[2] ) //'Erro: '

                Disarmtransaction()

                oRest:SetStatusCode(aReturn[1])
                oRest:SetResponse(aReturn[2])

            Else

                lRet  := .T.

                printf( aReturn[2] )

                oWs:SetStatusCode( aReturn[1] )
	            oWs:SetResponse( aReturn[2] )

            EndIf

        End Transaction

    EndIf  

Return lRet

//--------------------------------------------------------------------------------
/*/{Protheus.doc} fValidSymptoms
Função para validar os sintomas recebidos via JSON antes da gravação

@param  oJson,  Objeto,    JSON com dados da OS e sintomas

@return aReturn, Array, { <nCode>, <cMsg> }
        nCode = Código HTTP (200 = OK, 400 = Erro)
        cMsg  = Mensagem de retorno da validação

@author	Cauê Girardi Petri
@since  09/09/2025
/*/
//--------------------------------------------------------------------------------
Static Function fValidSymptoms( oJson )
    Local aJson     := {}
    Local aReturn   := { 200, '' }
    Local nI        := 0
    Local oJsonSymp := JsonObject():New()
    Local cCdSimp   := ''

    aJson := oJson['symptom']

    For nI := 1 To Len( aJson )
        oJsonSymp := aJson[nI]

        If oJsonSymp:hasProperty('TTC_CDSINT')
            cCdSimp := oJsonSymp['TTC_CDSINT']
        Else
            Return { 400, STR020 } //"Código do sintoma não enviado"
        EndIf

        If !ExistCPO( 'TTB', cCdSimp )
            Return { 400, STR017 + cCdSimp + STR018 } //"Sintoma "##" não encontrado"
        EndIf

    Next nI

Return aReturn

//--------------------------------------------------------------------------------
/*/{Protheus.doc} fSaveSymptoms
Função para gravar os sintomas validados no banco de dados

@param  oJson,  Objeto,    JSON com dados da OS e sintomas
@param  cNumOS, String,    Número da OS

@return aReturn, Array, { <nCode>, <cMsg> }
        nCode = Código HTTP (200 = OK)
        cMsg  = Mensagem de retorno da gravação

@author	Cauê Girardi Petri
@since  09/09/2025
/*/
//--------------------------------------------------------------------------------
Static Function fSaveSymptoms( oJson, cNumOS )
    Local aJson     := {}
    Local nI        := 0
    Local nX        := 0
    Local oJsonSymp := JsonObject():New()
    Local cCdSimp   := ''

    aJson := oJson['symptom']

    For nI := 1 To Len( aJson )
        oJsonSymp := aJson[nI]
        cCdSimp   := oJsonSymp['TTC_CDSINT']

        DbSelectArea( 'TTC' )
        dbSetOrder(1) //TTC_FILIAL+TTC_ORDEM+TTC_PLANO+TTC_CDSINT

        If !MsSeek( FwxFilial("TTC") + cNumOS + "000000" + cCdSimp )
            RecLock( "TTC", .T. )

                TTC->TTC_FILIAL := FwxFilial("TTC")
                TTC->TTC_CODBEM := oJson['order', 'TJ_CODBEM']
                TTC->TTC_ORDEM  := cNumOS
                TTC->TTC_PLANO  := "000000"
                TTC->TTC_DATA   := StoD( oJson['order', 'TJ_DTORIGI'] )
                TTC->TTC_CDSINT := cCdSimp

                // Grava campos de usuário
                For nX := 1 TO FCount()
                    cFieldTTC := FieldName(nX)
                    If AllTrim(Posicione("SX3",2,cFieldTTC,"X3_PROPRI")) == "U"
                        If oJsonSymp:hasProperty( cFieldTTC )
                            &( 'TTC->' + cFieldTTC ) := oJsonSymp[ cFieldTTC ]
                        EndIf
                    EndIf
                Next nX

            TTC->(MsUnLock())
        EndIf
    Next nI

Return

//--------------------------------------------------------------------------------
/*/{Protheus.doc} fOsCancel
Função para cancelar OSs via API

@param oRest, Objeto, Objeto atual

@return nCode, int,    Código HTTP retornado 
@return cMsg,  String, Mensagem para ser exibida no final do processo

@author	Cauê Girardi Petri
@since  06/05/2024
/*/
//--------------------------------------------------------------------------------
Static Function fOsCancel( oRest )

    Local cOrderCode    := ''
    Local cOrderPlan    := ''
    Local cOrderObs     := ''
    Local cMsg          := ''
    Local nCode         := 500
    Local cBody         := oRest:getBodyRequest()
    Local oJson         := JsonObject():New()

    cMsg := oJson:FromJson( cBody )

    oJson := oJson['order']

    If Empty( cMsg )

        If ValType( ( oJson['TJ_ORDEM'] ) ) != 'U'
            cOrderCode := PadR( oJson['TJ_ORDEM'], TAMSX3( 'TJ_ORDEM' )[1] )
        EndIf

        If ValType( ( oJson['TJ_PLANO'] ) ) != 'U'
            cOrderPlan := PadR( oJson['TJ_PLANO'], TAMSX3( 'TJ_PLANO' )[1] )
        EndIf

        If ValType( ( oJson['TJ_OBSERVA'] ) ) != 'U'
            cOrderObs := DecodeUTF8( oJson['TJ_OBSERVA'] )
        EndIf

        DbSelectArea('STJ')
        DbSetOrder(1)
        If MsSeek( FwxFilial('STJ') + cOrderCode + cOrderPlan )

            If STJ->TJ_SITUACA == 'C'

				cMsg  := STR034 + cOrderCode //"Ordem de serviço já cancelada: "
                nCode := 400 

			ElseIf STJ->TJ_TERMINO == 'S'

				cMsg  := STR035 + cOrderCode //"Ordem de serviço já finalizada: "
                nCode := 400 

			EndIf
			
        Else

            cMsg  := STR005 //'Ordem de Serviço não encontrada'
            nCode := 400 

        EndIf

        DbSelectArea('STQ')
        DbSetOrder(1)
        If MsSeek( FwxFilial('STQ') + cOrderCode + cOrderPlan )

            While Empty( cMsg ) .And. STQ->(!Eof())

                If !Empty(STQ->TQ_OK)
	    				//Verifica se foi gerada OS para esta etapa, e a OS gerada nao esta cancelada
	    				If !MNT400OSG( STQ->TQ_ORDEM , STQ->TQ_PLANO , STQ->TQ_TAREFA , STQ->TQ_ETAPA , .F. , .T. )
    
                            //'Existem OSs que foram geradas a partir de uma das etapas a serem excluidas,
                            // portanto primeiro cancele as OSs impeditivas'
                            cMsg  := STR036
                            nCode := 400               

	    				ElseIf !MNT400SSG( STQ->TQ_ORDEM, STQ->TQ_PLANO, STQ->TQ_TAREFA, STQ->TQ_ETAPA, .F., .T. )
    
                            // 'Existem SSs que foram geradas a partir de uma das etapas a serem excluidas,
                            //  portanto primeiro exclua as SSs impeditivas'
                            cMsg := STR037
                            nCode := 400

	    				EndIf

	    			EndIf

	    		STQ->(dbSkip())

            End

        EndIf

        If Empty( cMsg )

            dbSelectArea("STL")
		    dbSetOrder(01)
		    MsSeek( FwxFilial('STL') + cOrderCode + cOrderPlan )
		    While !EoF() .and. STL->TL_FILIAL == FwxFilial('STL') .And.;
		    		STL->TL_ORDEM == cOrderCode .And. STL->TL_PLANO == cOrderPlan

                If Val( STL->TL_SEQRELA ) <> 0 .And. Empty( cMsg )
    
                    cMsg  := STR038 //'Cancelamento não permitido. Esta Ordem de Serviço já tem insumo reportado.'
                    nCode := 400

                EndIf

                STL->( dbSkip() )

		    End While

        EndIf

        If Empty( cMsg )

            DbSelectArea('STJ')
            DbSetOrder(1)
            If DbSeek( FwxFilial('STJ') + cOrderCode + cOrderPlan ) .And. Empty( cMsg )

                //Checa se existe SA com Pre-Requisicao
                If !NGCHKSAPR( STJ->TJ_ORDEM , STJ->TJ_PLANO, , .F., .F. )

                    cMsg := STR039 //'Cancelamento da O.S. não permitido pois existe Solicitação ao Armazém com Pré-Requisição.'
                    nCode := 400

                EndIf

                //Valida cotação de solicitação de compras
                aReturn := NGGERCOTAC(STJ->TJ_ORDEM,.F.)

                If nCode == 500 .And. !aReturn[1]

                    cMsg  := aReturn[2]
                    nCode := 400

                EndIf

                If nCode == 500 .And. ExistBlock("NGTERMOT")

                    If !ExecBlock("NGTERMOT",.F.,.F.)

                        cMsg := STR040 //'Bloqueio de cancelamento pelo PE NGTERMOT'
                        nCode := 400

                    EndIf

                EndIf


                If nCode == 500 .And. aReturn[1]

                    aReturn := NGDELETOS( STJ->TJ_ORDEM,STJ->TJ_PLANO,cOrderObs,.T.)

                    If aReturn[1]

                        //Deleta o historico do contador 1 e 2 se tiver registro relacionado a OS
                        If STJ->TJ_POSCONT > 0 .And. !Empty(STJ->TJ_HORACO1)
                            MNT470EXCO(STJ->TJ_CODBEM,STJ->TJ_DTORIGI,STJ->TJ_HORACO1,1)
                        EndIf

                        If STJ->TJ_POSCON2 > 0 .And. !Empty(STJ->TJ_HORACO2)
                            MNT470EXCO(STJ->TJ_CODBEM,STJ->TJ_DTORIGI,STJ->TJ_HORACO2,2)
                        EndIf

                        nCode   := 200
                        cMsg    := STR008 + cOrderCode + STR041 //'Ordem de Serviço '##' cancelada com sucesso'

                    EndIf

                EndIf

            EndIf

        EndIf

    Else

        nCode := 400

    EndIf

Return { nCode, cMsg }

//--------------------------------------------------------------------------------
/*/{Protheus.doc} fOsReOpen
Função para reabrir OSs via API

@param oRest, Objeto, Objeto atual

@return nCode, int,    Código HTTP retornado 
@return cMsg,  String, Mensagem para ser exibida no final do processo

@author	Cauê Girardi Petri
@since  21/08/2024
/*/
//--------------------------------------------------------------------------------
Static Function fOsReOpen( oRest )

    Local cBody     := oRest:getBodyRequest()
    Local oJson     := JsonObject():New()
    Local cOrderCode:= ''
    Local cMsg      := ''
    Local nCode     := 500
    Local aReturn   := { .T., ' '}

    cMsg := oJson:FromJson( cBody )

    oJson := oJson['order']

    If Empty( cMsg ) .And. oJson:hasProperty('TJ_ORDEM')

        If !Empty( oJson['TJ_ORDEM'] )

            cOrderCode := PadR( oJson['TJ_ORDEM'], FwTamSX3( 'TJ_ORDEM' )[1] )

            aReturn := MNTA880( cOrderCode ) 

            If aReturn[1]

                cMsg  := STR008 + cOrderCode + STR044 //"Ordem de Serviço "##' reaberta com sucesso'
                nCode := 200

            Else

                cMsg  := aReturn[2]
                nCode := 400 

            EndIf
        
        Else

            cMsg  := STR045 //'Ordem de Serviço não informada'
            nCode := 400

        EndIf

    EndIf

    FWFreeArray( aReturn )

Return { nCode, cMsg }

//--------------------------------------------------------------------------------
/*/{Protheus.doc} fOsFinish
Função para finalizar OSs via API

@param oRest, Objeto, Objeto atual

@return nCode, int,    Código HTTP retornado 
@return cMsg,  String, Mensagem para ser exibida no final do processo 

@author	Cauê Girardi Petri
@since  15/07/2024
/*/
//--------------------------------------------------------------------------------
Static Function fOsFinish( oRest )

    Local cOrderCode    := ''
    Local cOrderPlan    := ''
    Local cCodIrregu    := ''
    Local cOrderObs     := ''
    Local cDtMrINI      := ''
    Local cDtMrFIM      := ''
    Local cHoMrINI      := ''
    Local cHoMrFIM      := ''
    Local nPosCont      := 0
    Local cHoraCo1      := ''
    Local nPosCont2     := 0
    Local cHoraCo2      := ''
    Local cMsg          := ''
    Local nCode         := 500
    Local cBody         := oRest:getBodyRequest()
    Local oJson         := JsonObject():New()
    Local oObjOs
    Local aReturn       := {}
    Local aCounter      := {}

    cMsg := oJson:FromJson( cBody )

    oJson := oJson['order']

    If Empty( cMsg )

        If ValType( ( oJson['TJ_ORDEM'] ) ) != 'U'
            cOrderCode := PadR( oJson['TJ_ORDEM'], TAMSX3( 'TJ_ORDEM' )[1] )
        EndIf

        If ValType( ( oJson['TJ_PLANO'] ) ) != 'U'
            cOrderPlan := PadR( oJson['TJ_PLANO'], TAMSX3( 'TJ_PLANO' )[1] )
        EndIf

        If ValType( ( oJson['TJ_IRREGU'] ) ) != 'U'
            cCodIrregu := PadR( oJson['TJ_IRREGU'], TAMSX3( 'TJ_IRREGU' )[1] )
        EndIf

        If ValType( ( oJson['TJ_OBSERVA'] ) ) != 'U'
            cOrderObs := DecodeUTF8( oJson['TJ_OBSERVA'] )
        EndIf

        If ValType( ( oJson['TJ_DTMRINI'] ) ) != 'U'
            cDtMrINI := oJson['TJ_DTMRINI']
        EndIf

        If ValType( ( oJson['TJ_HOMRINI'] ) ) != 'U'
            cHoMrINI := PadR( oJson['TJ_HOMRINI'], TAMSX3( 'TJ_HOMRINI' )[1] )
        EndIf

        If ValType( ( oJson['TJ_DTMRFIM'] ) ) != 'U'
            cDtMrFIM := oJson['TJ_DTMRFIM']
        EndIf

        If ValType( ( oJson['TJ_HOMRFIM'] ) ) != 'U'
            cHoMrFIM := PadR( oJson['TJ_HOMRFIM'], TAMSX3( 'TJ_HOMRFIM' )[1] )
        EndIf

        If ValType( ( oJson['TJ_POSCONT'] ) ) != 'U'
            nPosCont := oJson['TJ_POSCONT']
            If ValType( ( oJson['TJ_HORACO1'] ) ) != 'U'
                cHoraCo1 := oJson['TJ_HORACO1']
            EndIf
        EndIf

        If ValType( ( oJson['TJ_POSCON2'] ) ) != 'U'
            nPosCont2 := oJson['TJ_POSCON2']
            If ValType( ( oJson['TJ_HORACO2'] ) ) != 'U'
                cHoraCo2 := oJson['TJ_HORACO2']
            EndIf
        EndIf

    EndIf

    DbSelectArea('STJ')
    DbSetOrder(1)
    If MsSeek( FwxFilial('STJ') + cOrderCode + cOrderPlan )

        oObjOs := JsonObject():New()
        oObjOs['plan']          := cOrderPlan
        oObjOs['order']         := cOrderCode
        oObjOs['fault']         := cCodIrregu
        oObjOs['observation']   := cOrderObs
        oObjOS['startDate']     := cDtMrINI + ' ' + cHoMrINI
        oObjOs['endDate']       := cDtMrFIM + ' ' + cHoMrFIM
        oObjOs['json']          := ''

        If nPosCont > 0

            oObjCont := JsonObject():New()
            oObjCont['value'] := nPosCont
            oObjCont['time']  := cHoraCo1

            aAdd( aCounter, oObjCont )

            If nPosCont2 > 0

                oObjCont2 := JsonObject():New()
                oObjCont2['value'] := nPosCont2
                oObjCont2['time']  := cHoraCo2

                aAdd( aCounter, oObjCont2 )

            EndIf

            oObjOs['counter'] := aCounter

        EndIf

        aReturn := MNTNGFim( oRest, FWJsonSerialize( oObjOs ) )

        If !aReturn[1]

            cMsg := aReturn[2]
            nCode := 400

        Else

            cMsg  := STR008 + cOrderCode + STR046 //'Ordem de Serviço '##' finalizada com sucesso'
            nCode := 200

        EndIf

    Else

        cMsg  := STR005 //"Ordem de Serviço não encontrada"
        nCode := 400

    EndIf

Return { nCode, cMsg }

//--------------------------------------------------------------------------------
/*/{Protheus.doc} fChangeIns
Função para alterar insumos da OS via API

@param oJson , Objeto, Objeto atual
@param cOrder, String, Código da OS atual
@param cPlan , String, Código do plano da OS

@return aReturn, array, retorna o código http e mensagem de erro caso tenha
[1] - Codigo HTTP
[2] - Mensagem de erro

@author	Cauê Girardi Petri
@since  03/09/2025
/*/
//--------------------------------------------------------------------------------
Static Function fChangeIns( oJson, cOrder, cPlan )

    Local aReturn   := { 200, '' }
    Local cError    := ''
    Local cTipoManu := ''

    If Empty( cError )

        DbSelectArea( 'STJ' )
        DbSetOrder( 1 )
        If MsSeek( FwxFilial( 'STJ' ) + cOrder + cPlan )

            cTipoManu := NgSeek( 'STE', NgSeek( 'ST4', STJ->TJ_SERVICO , 1, 'T4_TIPOMAN' ), 1, 'TE_CARACTE')

            aReturn := fCreateIns( oJson, cOrder, cTipoManu, 4 )

        Else

            cError := STR025  + cOrder + STR026 //'Ordem de serviço '##' não encontrada'

        EndIf

    EndIf

    If aReturn[1] == 200

        If !Empty( cError )

            aReturn := { 400, cError }

        Else

            aReturn := { 200, STR025 + cOrder + STR027 } //"Ordem de serviço "##' atualizada com sucesso'

        EndIf

    EndIf

Return aReturn
//--------------------------------------------------------------------------------
/*/{Protheus.doc} fCreateIns
Função para cadastrar insumos da OS via API

@param oJson   , Objeto, Objeto atual
@param cOrdem  , String, Numero da OS recem cadastrada
@param cTipManu, String, Tipo da manutenção (C = corretiva, P = preventiva)
@param nOpc    , int   , Operação: 3=inclui O.S, 4=altera O.S, 5=cancela O.S

@return aReturn, array, retorna o código http e mensagem de erro caso tenha
[1] - Codigo HTTP
[2] - Mensagem de erro

@author	Cauê Girardi Petri
@since  08/07/2024
/*/
//--------------------------------------------------------------------------------
Static Function fCreateIns( oJson, cOrder, cTipManu, nOpc )

    Local oInputs := JsonObject():New()
    Local aInputs := { { {}, {}, {} }, { {}, {}, {} } }
    Local aReturn := { 200, '' }
    Local cError  := ''

    //Variavel private que é preenchida dentro do fArrayIns que irá ser utilizada
    //dentro da função DeleteRelation do MntNg
    Private aGetIns := {}

    oInputs := oJson['inputs']

    cError := fArrayIns(oInputs, cOrder, STJ->TJ_PLANO, oJson['order']['TJ_CODBEM'], @aInputs)

    If Empty( cError )

        cError := NGValidIns( cOrder, STJ->TJ_PLANO , nOpc, aInputs )

    EndIf

    If Empty( cError )

        If nOpc == 3

            cError := NGInputPre( cOrder, cTipManu, .F., ,aInputs )

        Else

            cError := NGInputPre( cOrder, cTipManu, .T., ,aInputs )

        EndIf

    EndIf

    If Empty( cError )

       cError := NGInputRea( cOrder, cTipManu, aInputs )

    EndIf

    //Atualiza as datas previstas da OS
    If Empty( cError )

        If oJson['order']:hasProperty( 'TJ_DTORIGI' )

            NGUpdDatesStj( cOrder,;
                        STJ->TJ_PLANO,;
                        STOD(oJson['order']['TJ_DTORIGI']),;
                        Substr(Time(),1,5),;
                        STOD(oJson['order']['TJ_DTORIGI']),;
                        Substr(Time(),1,5) )

        Else

            NGUpdDatesStj( cOrder,;
                        STJ->TJ_PLANO,;
                        STJ->TJ_DTORIGI,;
                        Substr(Time(),1,5),;
                        STJ->TJ_DTORIGI,;
                        Substr(Time(),1,5) )

        EndIf
    
    EndIf

    If !Empty( cError )

        aReturn := { 400, cError }

    EndIf

    FwFreeArray( aInputs )

Return aReturn

//--------------------------------------------------------------------------------
/*/{Protheus.doc} fChecklists
Função para cadastrar etapas da OS via API

@param oJson   , Objeto, Objeto atual
@param cOrdem  , String, Numero da OS recem cadastrada
@param cPlan   , String, Código do Plano
@param cTipManu, String, Tipo da manutenção (C = corretiva, P = preventiva)
@param cOpc    , int   , Operação: 3=inclui O.S, 4=altera O.S, 5=cancela O.S

@return aReturn, array, retorna o código http e mensagem de erro caso tenha
[1] - Codigo HTTP
[2] - Mensagem de erro

@author	Cauê Girardi Petri
@since  20/08/2024
/*/
//--------------------------------------------------------------------------------
Static Function fChecklists( oJson, cOrder, cPlan, cTipManu, nOpc )

    Local oChecklist := JsonObject():New()
    Local aChecklist := { {},{}, {} }
    Local aReturn := { 200, '' }
    Local cError  := ''

    oChecklist := oJson['checklists']

    DbSelectArea('STJ')
    DbSetOrder(1)
    If MsSeek( FwxFilial( 'STJ' ) + cOrder + cPlan )

        cError := fArrayCheck(oChecklist, cOrder, cPlan, cTipManu, STJ->TJ_CODBEM, STJ->TJ_SERVICO, STJ->TJ_SEQRELA, @aChecklist)

        If Empty( cError )

            cError := NGInputSTQ(Padr(cOrder,TamSx3("TJ_ORDEM")[1]), Padr(STJ->TJ_PLANO,TamSx3("TJ_PLANO")[1]), aChecklist)[1]

        EndIf

        If !Empty( cError )

            aReturn := { 400, cError }

        EndIf

    EndIf

    FwFreeArray( aChecklist )

Return aReturn

//--------------------------------------------------------------------------------
/*/{Protheus.doc} fArrayIns
Função para criar o array que será mandado para criar os insumos

@param oJson  , Objeto, Objeto atual
@param cOrder , String, Numero da OS recem cadastrada
@param cPlan  , string , código do plano da ordem de serviço
@param cEquip , string , código do bem
@param aInputs, array  , array com os insumos

@return cError, String, String com o erro caso ocorrer

@author	Cauê Girardi Petri
@since  13/08/2025
/*/
//--------------------------------------------------------------------------------
Static Function fArrayIns( oJson, cOrder, cPlan, cEquip, aInputs )

    Local nIndex     := 0
	Local nOpcX      := 0
	Local nStatus    := 0
    Local nX         := 0
	Local aInputTemp := {}
	Local aTask      := {}
	Local cDefUnity  := SuperGetMV("MV_NGUNIDT",.F.,"S")
	Local cError     := ''
	Local lIsDone    := .F.
	Local nSizeUN    := FWTamSX3( 'B1_UM' )[1]
	Local cBranchSB1 := FwxFilial( 'SB1' )
	Local lHasFlut   := SuperGetMV( 'MV_NGFLUT' , .F., 'N' ) == 'S'
	Local cOperation := 'C'
	Local cCalend    := ''
	Local cUnity     := ''
    Local cFieldSTL  := ''
    Local cCalFlu    := ''
    
    aInputs := { { {}, {}, {} }, { {}, {}, {} } }

	For nIndex := 1 To Len( oJson )

		aInputTemp := Array( 35 )

		// Define se o insumo e Realizado ou Previsto
        If oJson[nIndex]:hasProperty('ISDONE')
            lIsDone := oJson[nIndex]:ISDONE
        Else
            lIsDone := .F.
        EndIf

        If oJson[nIndex]:hasProperty('OPERATION')
            cOperation := oJson[nIndex]:OPERATION
        EndIf

        // TL_CODIGO
        If oJson[nIndex]:hasProperty('TL_CODIGO')
            aInputTemp[_CODE_] := PadR( oJson[nIndex]:TL_CODIGO, Len( STL->TL_CODIGO ) )
        Else
            cError := STR048 //"Para criação de insumos o campo TL_CODIGO é obrigatório"
            Exit
        EndIf

        // Backup TL_CODIGO_BKP
        If oJson[nIndex]:hasProperty('TL_CODIGO_BKP')
            aInputTemp[_KEYCODE_] := PadR( oJson[nIndex]:TL_CODIGO_BKP, Len( STL->TL_CODIGO ) )
        ElseIf cOperation == 'D'
            aInputTemp[_KEYCODE_] := aInputTemp[_CODE_]
        Else
            aInputTemp[_KEYCODE_] := PadR( '', Len( STL->TL_CODIGO ) )
        EndIf

        // TL_DESTINO
        If oJson[nIndex]:hasProperty('TL_DESTINO')
            If Upper( oJson[nIndex]:TL_TIPOREG ) == 'P'
                If oJson[nIndex]:TL_DESTINO $ 'A/S/T'
                    aInputTemp[_DESTINY_] := oJson[nIndex]:TL_DESTINO
                Else
                    cError := STR012 + oJson[nIndex]:TL_CODIGO +  STR013 //"Destino informado no insumo "##" inválido! Favor verificar o campo TL_DESTINO."
                    Exit
                EndIf
            Else
                aInputTemp[_DESTINY_] := oJson[nIndex]:TL_DESTINO
            EndIf
        ElseIf Upper( oJson[nIndex]:TL_TIPOREG ) == 'P'
            cError := STR028 //'Para insumo do tipo produto é obrigatório informar o campo TL_DESTINO'
            Exit
        EndIf

        // TL_TIPOREG
        If oJson[nIndex]:hasProperty('TL_TIPOREG')
            aInputTemp[_TYPE_] := oJson[nIndex]:TL_TIPOREG
        EndIf

        // TL_PERMDOE
        If oJson[nIndex]:hasProperty('TL_PERMDOE')
            aInputTemp[_PERCENT_] := oJson[nIndex]:TL_PERMDOE
        Else
            aInputTemp[_PERCENT_] := 0
        EndIf

        // TL_OBSERVA
        If oJson[nIndex]:hasProperty('TL_OBSERVA')
            aInputTemp[_INPUTNOTE_] := Trim( oJson[nIndex]:TL_OBSERVA )
        Else
            aInputTemp[_INPUTNOTE_] := ''
        EndIf

        // TL_QUANREC
        If oJson[nIndex]:hasProperty('TL_QUANREC')
            aInputTemp[_RESOURCEAMOUNT_] := oJson[nIndex]:TL_QUANREC
        Else
            aInputTemp[_RESOURCEAMOUNT_] := 0
        EndIf

        // TL_QUANTID
        If oJson[nIndex]:hasProperty('TL_QUANTID') .And. oJson[nIndex]:TL_QUANTID != 0
            aInputTemp[_AMOUNT_] := oJson[nIndex]:TL_QUANTID
        Else
            cError := STR029 //'É obrigatório enviar o campo TL_QUANTID com um valor diferente de 0'
            Exit
        EndIf

        If aInputTemp[_TYPE_] == 'P' .And. Len( cValtoChar(oJson[nIndex]:TL_QUANTID ) ) > 9
            cError := STR014 + CRLF + STR015 + NGSEEK( "SB1", oJson[nIndex]:TL_CODIGO, 1, "B1_DESC") //"O campo quantidade está incorreto." ## "Produto: "
            Exit
        EndIf

        // TL_DTVALID
        aInputTemp[_DATELOT_] := cToD( '' )

        // TL_USACALE
        If oJson[nIndex]:hasProperty('TL_USACALE')
            aInputTemp[_USECALE_] := oJson[nIndex]:TL_USACALE
        Else
            aInputTemp[_USECALE_] := 'N'			
        EndIf

        // TL_CUSTO
        aInputTemp[_COST_] := 0

        // TL_TIPOHOR
        If oJson[nIndex]:hasProperty('TL_TIPOHOR')
            If Empty( oJson[nIndex]:TL_TIPOHOR )
                aInputTemp[_HOURUNITY_] := cDefUnity
            Else
                aInputTemp[_HOURUNITY_] := oJson[nIndex]:TL_TIPOHOR
            EndIf
        Else
            aInputTemp[_HOURUNITY_] := cDefUnity
        EndIf

        // TL_LOCAL
        If oJson[nIndex]:hasProperty('TL_LOCAL')
            aInputTemp[_WAREHOUSE_] := PadR( oJson[nIndex]:TL_LOCAL, Len( STL->TL_LOCAL ) )
        Else
            If aInputTemp[_TYPE_] == 'T'
                aInputTemp[_WAREHOUSE_] := PadR( SuperGetMV( 'MV_NGLOCPA', .F., '01' ), Len( STL->TL_LOCAL ) )
            Else
                aInputTemp[_WAREHOUSE_] := PadR( '', Len( STL->TL_LOCAL ) )
            EndIf
        EndIf

        // TL_TAREFA
        If SuperGetMv("MV_NGTARGE") == '1' .And. oJson[nIndex]:hasProperty('TL_TAREFA')
            aInputTemp[_TASK_] := PadR( oJson[nIndex]:TL_TAREFA, Len( STL->TL_TAREFA ) )
        Else
            aInputTemp[_TASK_] := PadR( '0', Len( STL->TL_TAREFA ) )
        EndIf

        // Backup TL_TAREFA_BKP
        If oJson[nIndex]:hasProperty('TL_TAREFA_BKP')
            aInputTemp[_KEYTASK_] := PadR( oJson[nIndex]:TL_TAREFA_BKP, Len( STL->TL_TAREFA ) )
        ElseIf cOperation == 'D'
            aInputTemp[_KEYTASK_] := aInputTemp[_TASK_]
        Else
            aInputTemp[_KEYTASK_] := PadR( '', Len( STL->TL_TAREFA ) )
        EndIf

        // TL_UNIDADE
        If oJson[nIndex]:TL_TIPOREG == 'P'
            cUnity := AllTrim( Upper( Posicione( 'SB1', 1, cBranchSB1 + oJson[nIndex]:TL_CODIGO, 'B1_UM' ) ) )
        ElseIf oJson[nIndex]:hasProperty('TL_UNIDADE')
            cUnity := oJson[nIndex]:TL_UNIDADE
        Else
            cUnity := 'H'
        EndIf

        aInputTemp[_UNITY_] := PadR( cUnity, nSizeUN )

        // TL_SEQRELA
        If oJson[nIndex]:hasProperty('TL_SEQRELA')
            aInputTemp[_SEQUENCE_] := PadR( oJson[nIndex]:TL_SEQRELA, Len( STL->TL_SEQRELA ) )
        Else
            aInputTemp[_SEQUENCE_] := PadR( '0', Len( STL->TL_SEQRELA ) )
        EndIf

        // TL_SEQTARE
        If oJson[nIndex]:hasProperty('TL_SEQTARE')
            aInputTemp[_SEQTASK_] := PadR( oJson[nIndex]:TL_SEQTARE, Len( STL->TL_SEQTARE ) )
        Else
            aInputTemp[_SEQTASK_] := PadR( '', Len( STL->TL_SEQTARE ) )
        EndIf

        // TL_LOCALIZ
        If oJson[nIndex]:hasProperty('TL_LOCALIZ')
            aInputTemp[_LOCATION_] := Upper( PadR( oJson[nIndex]:TL_LOCALIZ, Len( STL->TL_LOCALIZ ) ) )
        Else
            aInputTemp[_LOCATION_] := ''
        EndIf

        // TL_NUMSERI
        If oJson[nIndex]:hasProperty('TL_NUMSERI')
            aInputTemp[_SERIALNUMBER_] := Upper( PadR( oJson[nIndex]:TL_NUMSERI, Len( STL->TL_NUMSERI ) ) )
        Else
            aInputTemp[_SERIALNUMBER_] := ''
        EndIf

        // TL_NUMSA
        If oJson[nIndex]:hasProperty('TL_NUMSA')
            aInputTemp[_WHREQUEST_] := PadR( oJson[nIndex]:TL_NUMSA, Len( STL->TL_NUMSA ) )
        Else
            aInputTemp[_WHREQUEST_] := ''
        EndIf

        // TL_ITEMSA
        If oJson[nIndex]:hasProperty('TL_ITEMSA')
            aInputTemp[_WHITEM_] := PadR( oJson[nIndex]:TL_ITEMSA, Len( STL->TL_ITEMSA ) )
        Else
            aInputTemp[_WHITEM_] := ''
        EndIf

        // TL_LOTECTL
        If oJson[nIndex]:hasProperty('TL_LOTECTL')
            aInputTemp[_LOT_] := PadR( oJson[nIndex]:TL_LOTECTL, Len( STL->TL_LOTECTL ) )
        Else
            aInputTemp[_LOT_] := ''
        EndIf

        // TL_NUMLOTE
        If oJson[nIndex]:hasProperty('TL_NUMLOTE')
            aInputTemp[_SUBLOT_] := PadR( oJson[nIndex]:TL_NUMLOTE, Len( STL->TL_NUMLOTE ) )
        Else
            aInputTemp[_SUBLOT_] := ''
        EndIf

        // TL_DTINICI
        If oJson[nIndex]:hasProperty('TL_DTINICI')
            aInputTemp[_STARTDATE_] := StoD( oJson[nIndex]:TL_DTINICI )
        ElseIf aInputTemp[_TYPE_] == 'M'
            cError := STR030 //'Para insumos do tipo mão de obra é necessário preencher data e hora, inicio e fim'
        Else
            aInputTemp[_STARTDATE_] := dDataBase
        EndIf

        // TL_HOINICI
        If oJson[nIndex]:hasProperty('TL_HOINICI')
            aInputTemp[_STARTHOUR_] := oJson[nIndex]:TL_HOINICI
        ElseIf aInputTemp[_TYPE_] == 'M'
            cError := STR030 //'Para insumos do tipo mão de obra é necessário preencher data e hora, inicio e fim'
        Else
            aInputTemp[_STARTHOUR_] := Substr(Time(),1,5)
        EndIf

        // TL_DTFIM
        If oJson[nIndex]:hasProperty('TL_DTFIM')
            aInputTemp[_ENDDATE_] := StoD( oJson[nIndex]:TL_DTFIM )
        ElseIf aInputTemp[_TYPE_] == 'M'
            cError := STR030 //'Para insumos do tipo mão de obra é necessário preencher data e hora, inicio e fim'
        Else
            aInputTemp[_ENDDATE_] := dDataBase
        EndIf

        //TL_HOFIM
        If oJson[nIndex]:hasProperty('TL_HOFIM')
            aInputTemp[_ENDHOUR_] := oJson[nIndex]:TL_HOFIM
        ElseIf aInputTemp[_TYPE_] == 'M'
            cError := STR030 //'Para insumos do tipo mão de obra é necessário preencher data e hora, inicio e fim'
        Else
            aInputTemp[_ENDHOUR_] := Substr(Time(),1,5)
        EndIf

        If aInputTemp[_TYPE_] == 'T' .And. oJson[nIndex]:hasProperty('TL_LOJA')

            // TL_FORNEC
            aInputTemp[_SUPPLIER_] := aInputTemp[_CODE_]

            // TL_LOJA
            aInputTemp[_STORE_] := oJson[nIndex]:TL_LOJA

            If STL->( FieldPos('TL_TPROD') ) > 0 .And. STL->( FieldPos('TL_TLOCAL') ) > 0 .And.;
				STG->( FieldPos('TG_TPROD') ) > 0 .And. STG->( FieldPos('TG_TLOCAL') ) > 0 .And.;
                oJson[nIndex]:hasProperty('TL_TPROD') .And. oJson[nIndex]:hasProperty('TL_TLOCAL')
				// TL_TPROD
				aInputTemp[_TPROD_]  := Padr( oJson[nIndex]:TL_TPROD, TamSx3("TL_CODIGO")[1])
				// TL_TLOCAL
				aInputTemp[_TLOCAL_] := Padr( oJson[nIndex]:TL_TLOCAL, TamSx3("TL_LOCAL")[1])
			Else

				aInputTemp[_TPROD_]  := ''
				aInputTemp[_TLOCAL_] := ''

			EndIf

        Else

            aInputTemp[_SUPPLIER_] := ''
            aInputTemp[_STORE_] := ''

        EndIf

        If oJson[nIndex]:hasProperty('TL_NUMSC') .And. oJson[nIndex]:hasProperty('TL_ITEMSC')
            aInputTemp[_SCNUM_]  := oJson[nIndex]:TL_NUMSC
            aInputTemp[_SCITEM_] := oJson[nIndex]:TL_ITEMSC
        Else
            aInputTemp[_SCNUM_]  := ''
            aInputTemp[_SCITEM_] := ''
        EndIf

        // Ocorrências
        If oJson[nIndex]:hasProperty('occurrences')

            /*
                Preenche uma matriz contendo a indetificação do insumo e a listagem de ocorrências relacionadas para o
                controle de gravação.
            */
            aInputTemp[_OCCURRENCES_] := aClone( GetOccurrences( oJson[nIndex]['occurrences'] ) )

        Else

            aInputTemp[_OCCURRENCES_] := { {}, {}, {} }

        EndIf

        If aInputTemp[_USECALE_] == 'S' .And. aInputTemp[_TYPE_] == 'M' .And. cOperation != 'D'

            cCalend := NGSEEK( 'ST1', Substr( aInputTemp[_CODE_], 1, 6 ), 1, 'T1_TURNO' )
            If lHasFlut //Utiliza turno flutuante
                cCalFlu := MNTCALFLU( Substr( aInputTemp[_CODE_], 1, 6 ), aInputTemp[_STARTDATE_], aInputTemp[_ENDDATE_] )
                If !Empty( cCalFlu ) //Se o funcionário não estiver relacionado à uma equipe de manutenção
                    cCalend := cCalFlu
                EndIf
            EndIf

            /*-----------------------------+
            | Carrega quantidade de horas  |
            -------------------------------*/
            aInputTemp[_AMOUNT_] := NGQUANTIHOR( 'M',, ;
                                    aInputTemp[_STARTDATE_], ;
                                    aInputTemp[_STARTHOUR_], ;
                                    aInputTemp[_ENDDATE_], ;
                                    aInputTemp[_ENDHOUR_], ;
                                    'S', ;
                                    cCalend,; 
                                    cDefUnity)

            /*-----------------------------+
            | Validação hora inicial       |
            -------------------------------*/
            cError := NGVldCal( cCalend, aInputTemp[_STARTDATE_], aInputTemp[_STARTHOUR_], 'I' )
            If Empty( cError )
                /*-----------------------------+
                | Validação hora final         |
                -------------------------------*/
                cError := NGVldCal( cCalend, aInputTemp[_ENDDATE_], aInputTemp[_ENDHOUR_], 'F' )
            EndIf

        ElseIf aInputTemp[_TYPE_] != 'P' .And. Trim( aInputTemp[_UNITY_] ) == 'H' .And. cDefUnity != 'D'
            aInputTemp[_AMOUNT_] := NGRHODSEXN( aInputTemp[_AMOUNT_], 'D' ) //Converte um valor em decimal para horas (numérico)
        EndIf

        If !Empty( cError )
            Exit
        EndIf

        If lIsDone
            nStatus := _REALIZED_
        Else
            nStatus := _FORESEEN_
        EndIf

        // Separa os insumos por operação as quais foram acionados.
        Do Case

            Case oJson[nIndex]:OPERATION == 'C'

                //Armazena campos de usuário
                For nX := 1 TO FCount()
                    cFieldSTL := FieldName(nX)
                    If AllTrim(Posicione("SX3",2,cFieldSTL,"X3_PROPRI")) == "U"

                        If oJson[nIndex]:hasProperty( cFieldSTL )

                            aAdd( aInputTemp, { cFieldSTL, oJson[nIndex][ cFieldSTL ] }  )

                        EndIf

                    EndIf

                Next nX

                aAdd( aInputs[nStatus,_INSERT_], aInputTemp )

            Case oJson[nIndex]:OPERATION == 'U'

                // Valida e carrega detalhes da S.A. relacionada ao insumo no arrary aInputs.
                cError := NGCheckSA( cOrder, cPlan, @aInputTemp, 'U' )

                If Empty( cError )

                    DbSelectArea('STL')

                    //Armazena campos de usuário
                    For nX := 1 TO FCount()
                        cFieldSTL := FieldName(nX)
                        If AllTrim(Posicione("SX3",2,cFieldSTL,"X3_PROPRI")) == "U"

                            If oJson[nIndex]:hasProperty( cFieldSTL )

                                aAdd( aInputTemp, { cFieldSTL, oJson[nIndex][ cFieldSTL ] }  )

                            EndIf

                        EndIf

                    Next nX

                    aAdd( aInputs[nStatus,_UPDATE_], aInputTemp )

                Else

                    Exit

                EndIf

            Case oJson[nIndex]:OPERATION == 'D'

                // Valida S.A. relacionada ao insumo.
                cError := NGCheckSA( cOrder, cPlan, aInputTemp, 'D' )

                If Empty( cError )

                    aAdd( aInputs[nStatus,_DELETE_], aInputTemp )

                Else

                    Exit

                EndIf

        EndCase

        dbSelectArea( 'STL' )
        dbSetOrder( 1 ) // TL_FILIAL + TL_ORDEM + TL_PLANO + TL_TAREFA + TL_TIPOREG + TL_CODIGO + TL_SEQRELA + TL_SEQTARE
        msSeek( FwxFilial( 'STL' ) + cOrder + cPlan + aInputTemp[_KEYTASK_] + aInputTemp[_TYPE_] + aInputTemp[_KEYCODE_] +;
            aInputTemp[_SEQUENCE_] + aInputTemp[_SEQTASK_] )

        aAdd( aGetIns, { aInputTemp[_KEYTASK_], aInputTemp[_TYPE_], aInputTemp[_KEYCODE_], '', aInputTemp[_USECALE_], aInputTemp[_RESOURCEAMOUNT_],;
            aInputTemp[_AMOUNT_], aInputTemp[_UNITY_], aInputTemp[_DESTINY_], aInputTemp[_STARTDATE_], aInputTemp[_STARTHOUR_], aInputTemp[_WAREHOUSE_],;
            aInputTemp[_INPUTNOTE_], lIsDone, STL->( RecNo() ), IIf( oJson[nIndex]:OPERATION == 'D', .T., .F. ) } )

        aInputTemp := {}


	Next nIndex

    // Tratamento exclusivo para inclusão e alteração dos insumos previstos.
	If Empty( cError ) .And. !Empty( aInputs[_FORESEEN_,_UPDATE_] ) .Or. !Empty( aInputs[_FORESEEN_,_INSERT_] )

		/*
			Loop executado três vezes para que possa abranger insumos previstos dos processo de inclusão/alteração.
		*/
		For nOpcX := 1 To 2

			If !Empty( aInputs[_FORESEEN_,nOpcX] )

				aTask := aClone( aInputs[_FORESEEN_,nOpcX] )

				// Processo de verificação do Produto Alternativo.
				If FindFunction( 'NGALTPROD' ) .And. Trim( SuperGetMv( 'MV_MNTPRAL', .F., '2' ) ) == '1' .And.;
					Trim( SuperGetMv( 'MV_NGGERSA', .F., 'N' ) ) == 'N' .And. Trim( SuperGetMv( 'MV_NGMNTES', .F., 'N' ) ) == 'S'

					aTask := NGALTPROD( aTask, , cEquip, 'TL', 'MNTNG', { _TYPE_, _CODE_, _AMOUNT_, _TASK_, _WAREHOUSE_,;
						_DESTINY_, _COST_ } )

				EndIf

			EndIf

		Next nOpcX

	EndIf

    FwFreeArray( aInputTemp )
    FwFreeArray( aTask )

Return cError

//----------------------------------------------------------------------------------
/*/{Protheus.doc} GetOccurrences
Recupera uma lista com as ocorrências recebidas do app.
Obs: Cópia da função de mesmo nome do mntng
@type function

@author	Cauê Petri
@since 18/08/2025

@param oParser, Object , Objeto JSON contendo a lista de ocorrências enviadas.
@return Array , Matriz contendo três lista de ocorrências, separadas pelas operações de
inclusão, alteração e exclusão. Cada lista comporta pelas posições:
					[1] - Problema
					[2] - Causa
					[3] - Backup Causa
					[4] - Solução
					[5] - Backup Solução
					[6] - Observação
/*/
//----------------------------------------------------------------------------------
Static Function GetOccurrences( oParser )

	Local nIndex       := 0
	Local aOccurrTemp  := {}
	Local aOccurrences := { {}, {}, {} }

	For nIndex := 1 To Len( oParser )

		aOccurrTemp := Array( 8 )

        // TN_CODOCOR - Problema
        If oParser[nIndex]:HasProperty('TN_CODOCOR')
            aOccurrTemp[_PROBLEM_] := oParser[nIndex]:TN_CODOCOR
        Else
            aOccurrTemp[_PROBLEM_] := Space( FwTamSX3( 'TN_CODOCOR' )[1] )
        EndIf

        // Backup TN_CODOCOR
        If oParser[nIndex]:HasProperty('TN_CODOCOR_BKP')
            aOccurrTemp[_KEYPROB_] := oParser[nIndex]:TN_CODOCOR_BKP
        Else
            aOccurrTemp[_KEYPROB_] := Space( FwTamSX3( 'TN_CODOCOR' )[1] )
        EndIf

        // TN_CAUSA - Causa
        If oParser[nIndex]:HasProperty('TN_CAUSA')
            aOccurrTemp[_CAUSE_] := oParser[nIndex]:TN_CAUSA
        Else
            aOccurrTemp[_CAUSE_] := Space( FwTamSX3( 'TN_CAUSA' )[1] )
        EndIf

        // Backup TN_CAUSA
        If oParser[nIndex]:HasProperty('TN_CAUSA_BKP')
            aOccurrTemp[_KEYCAUSE_] := oParser[nIndex]:TN_CAUSA_BKP
        Else
            aOccurrTemp[_KEYCAUSE_] := Space( FwTamSX3( 'TN_CAUSA' )[1] )
        EndIf

        // TN_SOLUCAO - Solução
        If oParser[nIndex]:HasProperty('TN_SOLUCAO')
            aOccurrTemp[_SOLUTION_] := oParser[nIndex]:TN_SOLUCAO
        Else
            aOccurrTemp[_SOLUTION_] := Space( FwTamSX3( 'TN_SOLUCAO' )[1] )
        EndIf

        // Backup TN_SOLUCAO
        If oParser[nIndex]:HasProperty('TN_SOLUCAO_BKP')
            aOccurrTemp[_KEYSOLUTION_] := oParser[nIndex]:TN_SOLUCAO_BKP
        Else
            aOccurrTemp[_KEYSOLUTION_] := Space( FwTamSX3( 'TN_SOLUCAO' )[1] )
        EndIf

        // Observação
        If oParser[nIndex]:HasProperty('TN_DESCRIC')
            aOccurrTemp[_OCCURNOTE_] := oParser[nIndex]:TN_DESCRIC
        Else
            aOccurrTemp[_OCCURNOTE_] := ''
        EndIf

        // TN_TAREFA - Tarefa
        If oParser[nIndex]:HasProperty('TN_TAREFA')
            aOccurrTemp[_OCUTASK_] := oParser[nIndex]:TN_TAREFA
        Else
            aOccurrTemp[_OCUTASK_] := PadR( '0', TAMSX3( 'TN_TAREFA' )[1] )
        EndIf

		// Separa as ocorrências por operação as quais foram acionados.
		Do Case

			// Inclusão
			Case oParser[nIndex]:OPERATION == 'C'

				aAdd( aOccurrences[_INSERT_], aOccurrTemp )

			// Alteração
			Case oParser[nIndex]:OPERATION == 'U'

				aAdd( aOccurrences[_UPDATE_], aOccurrTemp )

			// Exclusão
			Case oParser[nIndex]:OPERATION == 'D'

				aAdd( aOccurrences[_DELETE_], aOccurrTemp )

		EndCase

	Next nIndex

Return aOccurrences

//--------------------------------------------------------------------------------
/*/{Protheus.doc} fArrayCheck
Função para criar o array que será mandado para criar as etapas

@param oJson     , Objeto, Objeto atual
@param cOrder    , String, Numero da OS recem cadastrada
@param cPlan     , String, código do plano da ordem de serviço
@param cType     , String, Tipo da OS (P = Preventiva C = Corretiva)
@param cEquip    , String, código do bem
@param cService  , string, código do serviço
@param cSequence , string, sequencia da manutenção
@param aChecklist, Array , array com as etapas

@return cError   , String, Retorna erro caso acontecer 

@author	Cauê Girardi Petri
@since  20/08/2025
/*/
//--------------------------------------------------------------------------------
Static Function fArrayCheck( oJson, cOrder, cPlan, cType, cEquip, cService, cSequence, aChecklist )

    Local aCheckTemp:= {}
    Local aAnswers  := {}
    Local aConvert  := {}
    Local aAux      := {}
    Local cConteudo := ''
    Local cError    := ''
    Local cTask     := ''
    Local cStep     := ''
    Local cWorker   := ''
    Local cOk       := ''
    Local cRespos   := ''
    Local cObs      := ''
    Local cMarca    := GetMark()
    Local cTaskDef  := Padr( '0', TamSx3( 'TQ_TAREFA' )[1] )
    Local cSeqStep  := Space( TamSx3('TQ_SEQETA')[1] )
    Local cSeqTask  := Space( TamSx3("TQ_SEQTARE")[1] )
    Local nI        := 1
    Local nX        := 0
    Local cKeyManut := ''
    Local cOperat   := 'C'
    Local lVerManut := .F.
    Local lUpdate   := .F.

    If cType == 'P'
        cKeyManut := FwxFilial('STF') + cEquip + cService + cSequence
    EndIf

    For nI := 1 To Len( oJson )

        aCheckTemp := Array(8)
        aAnswers   := {}

        If oJson[nI]:HasProperty('TQ_TAREFA')
            cTask := Padr( oJson[nI]:TQ_TAREFA, TamSx3( 'TQ_TAREFA' )[1] )
        Else
            cTask := cTaskDef
        EndIf

        If oJson[nI]:HasProperty('TQ_ETAPA')
            cStep := Padr( oJson[nI]:TQ_ETAPA, TamSx3( 'TQ_ETAPA' )[1] )
        EndIf

        If oJson[nI]:HasProperty('ISDONE') .And. oJson[nI]:ISDONE
            cOk := cMarca
        Else
            cOk := ''
        EndIf

        If oJson[nI]:HasProperty('TQ_OBSERVA')
            cObs := oJson[nI]:TQ_OBSERVA
        Else
            cObs := NIL
        EndIf

        If oJson[nI]:HasProperty('TQ_CODFUNC')
            cWorker := Padr( oJson[nI]:TQ_CODFUNC, TamSx3( 'TQ_CODFUNC' )[1] )
        Else
            cWorker := ''
        EndIf

        cSeqStep := Space( TamSx3('TQ_SEQETA')[1] )
        cSeqTask := Space( TamSx3("TQ_SEQTARE")[1] )

        lVerManut := .T.
        lUpdate   := .F.

        //-----------------------------------------------
        // Busca sequencia da etapa já gravada no banco
        //-----------------------------------------------

        dbSelectArea('STQ')
        dbSetOrder(1)
        If dbSeek( FwxFilial('STQ') +  cOrder + cPlan + cTask + cStep )

            cSeqStep := STQ->TQ_SEQETA
            cSeqTask := STQ->TQ_SEQTARE

            lVerManut := .F.
            lUpdate   := .T.

        EndIf
        
        //--------------------------------------------------------
        // Busca sequencia das etapas pelo cadastro da manutenção
        //--------------------------------------------------------
        If cType == 'P' .And. lVerManut

            dbSelectArea('ST5')
            dbSetOrder(1)
            If dbSeek( cKeyManut + cTask )
                cSeqTask := CValToChar( ST5->T5_SEQUENC )
            EndIf

            dbSelectArea('STH')
            dbSetOrder(1)
            If dbSeek( cKeyManut + cTask + cStep )
                cSeqStep := STH->TH_SEQETA
            EndIf

        EndIf

        If oJson[nI]:HasProperty('TQ_SEQETA')
            cSeqStep := Padr(oJson[nI]:TQ_SEQETA, TamSx3('TQ_SEQETA')[1])
        EndIf

        cOperat := oJson[nI]:OPERATION

        //-------------------------------------
        // Respostas das etapas
        //-------------------------------------
        If oJson[nI]:HasProperty('ANSWERS') .And. cOperat != 'D' .And. !Empty(cOk)

            aAux:= oJson[nI]:ANSWERS

            For nX := 1 to Len(aAux)

                If aAux[nX]:HasProperty('TPQ_RESPOS')
                    cRespos := Padr( aAux[nX]:TPQ_RESPOS, TamSx3( 'TPQ_RESPOS' )[1] )
                Else
                    cRespos := ''
                EndIf

                aConvert := NGToString(oJson[nI]:TQ_ETAPA,aAux[nX]:TPQ_OPCAO,cRespos)
                cConteudo := aConvert[2]

                If !aConvert[1]
                    cError := cConteudo
                    Exit
                EndIf

                aadd(aAnswers, { Padr(aAux[nX]:TPQ_OPCAO,TamSx3("TPQ_OPCAO")[1]),Padr(cConteudo, TamSx3("TPQ_RESPOS")[1])})
            Next
            If !Empty(cError)
                Exit
            EndIf
        EndIf

        aCheckTemp[_TAREFA_]  := cTask
        aCheckTemp[_ETAPA_]   := cStep
        aCheckTemp[_SEQETA_]  := cSeqStep
        aCheckTemp[_SEQTARE_] := cSeqTask
        aCheckTemp[_CODFUNC_] := cWorker
        aCheckTemp[_OK_]      := cOk
        aCheckTemp[_DESCRI_]  := cObs
        aCheckTemp[_ANSWERS_] := aAnswers

        Do Case
            Case cOperat == 'C'
                aAdd(aChecklist[_INSERT_], aClone( aCheckTemp ) )
            Case cOperat == 'U'
                aAdd(aChecklist[_UPDATE_], aClone( aCheckTemp) )
            Otherwise
                aAdd(aChecklist[_DELETE_], aClone( aCheckTemp) )
        EndCase

    Next nI

    FwFreeArray( aCheckTemp )
    FwFreeArray( aAnswers )
    FwFreeArray( aConvert )
    FwFreeArray( aAux )

Return cError

//--------------------------------------------------------------------------------
/*/{Protheus.doc} fCreateOcu
Função para criar as ocorrencias não vinculadas a insumo 

@param oJson      , Objeto, Objeto atual
@param cOrder     , String, Numero da OS recem cadastrada

@return aReturn   , array, array com erro caso acontecer 

@author	Cauê Girardi Petri
@since  20/08/2025
/*/
//--------------------------------------------------------------------------------
Static Function fCreateOcu(oJson, cOrder)

    Local aReturn      := { 200, '' }
    Local aOccurrences := {}
    Local oOccurrences := JsonObject():New()
    Local aSTN         := { {}, {}, {} }
    Local cError       := ''
    Local cTask        := ''
    Local nX           := 1
    Local nI           := 1

    oOccurrences := oJson['occurrences']

    DbSelectArea('STJ')
    DbSetOrder(1)
    //Posiciona na OS recém cadastrada
    DbGoTo(LastRec())

    aOccurrences := aClone( GetOccurrences( oOccurrences ) )

    While .T.

        //Passa pela inclusão, alteração e deleção
        For nX := 1 To 3

            //Passa por todas as ocorrencias daquela operação
            For nI := 1 To Len( aOccurrences[nX] )

                If Empty(cTask)

                    cTask := aOccurrences[nX][nI][_OCUTASK_]

                EndIf

                If aOccurrences[nX][nI][_OCUTASK_] == cTask

                    aAdd( aSTN[nX], aOccurrences[nX][nI] )

                    aDel( aOccurrences[nX], nI )
                    aSize( aOccurrences[nX], Len( aOccurrences[nX] ) - 1 )

                EndIf
                
            Next

        Next

        cError := NGInputSTN( FwxFilial( 'STN' ), cOrder, STJ->TJ_PLANO, cTask, PadR( '0', TAMSX3( 'TN_SEQRELA' )[1] ), aSTN )

        cTask := ''

        If Empty(cError)

            If Empty( aOccurrences[_INSERT_] ) .And. Empty( aOccurrences[_UPDATE_] ) .And. Empty( aOccurrences[_DELETE_] )

                Exit

            EndIf

        Else

            Exit

        EndIf

    End

    If !Empty( cError )

        aReturn := { 400, cError }

    EndIf
    
Return aReturn

//--------------------------------------------------------------------------------
/*/{Protheus.doc} fChangeOcc
Função para alterar as ocorrencias da OS 

@param oJson   , Objeto, Objeto atual
@param cOrder  , String, Código da OS atual
@param cPlan   , String, Código do plano da OS

@return aReturn, array, array com erro caso acontecer 

@author	Cauê Girardi Petri
@since  20/08/2025
/*/
//--------------------------------------------------------------------------------
Static Function fChangeOcc( oJson, cOrder, cPlan )

    Local aReturn      := { 200, '' }
    Local aOccurrences := {}
    Local aSTN         := { {}, {}, {} }
    Local cError       := ''
    Local cTask        := ''
    Local nX           := 1
    Local nI           := 1
    Local oOccurrences := JsonObject():New()

    oOccurrences := oJson['occurrences']

    If Empty( cError )

        DbSelectArea( 'STJ' )
        DbSetOrder( 1 )
        If MsSeek( FwxFilial( 'STJ' ) + cOrder + cPlan )

            aOccurrences := aClone( GetOccurrences( oOccurrences ) )

            While .T.

                //Passa pela inclusão, alteração e deleção
                For nX := 1 To 3

                    //Passa por todas as ocorrencias daquela operação
                    For nI := 1 To Len( aOccurrences[nX] )

                        If Empty(cTask)

                            cTask := aOccurrences[nX][1][_OCUTASK_]

                        EndIf

                        If aOccurrences[nX][1][_OCUTASK_] == cTask

                            aAdd( aSTN[nX], aOccurrences[nX][1] )

                            aDel( aOccurrences[nX], 1 )
		                    aSize( aOccurrences[nX], Len( aOccurrences[nX] ) - 1 )

                        EndIf
                        
                    Next

                Next

                cError := NGInputSTN( FwxFilial( 'STN' ), cOrder, cPlan, cTask, PadR( '0', TAMSX3( 'TN_SEQRELA' )[1] ), aSTN )

                cTask := ''

                If Empty(cError)

                    If Empty( aOccurrences[_INSERT_] ) .And. Empty( aOccurrences[_UPDATE_] ) .And. Empty( aOccurrences[_DELETE_] )

                        Exit

                    EndIf

                Else

                    Exit

                EndIf

            End

        Else

            cError := STR025 + cOrder + STR026 //'Ordem de serviço ## não encontrada'

        EndIf

    EndIf

    If !Empty( cError )

        aReturn := { 400, cError }

    EndIf

Return aReturn
//--------------------------------------------------------------------------------
/*/{Protheus.doc} fOsUpdate
Função para alterar OSs via API

@param oRest    , Objeto, Objeto atual

@return aReturn , array , array com erro caso acontecer 

@author	Cauê Girardi Petri
@since  01/07/2024
/*/
//--------------------------------------------------------------------------------
Static Function fOsUpdate( oRest )

    Local aReturn := { 200, '' }
    Local cBody  := oRest:getBodyRequest()
    Local oJson  := JsonObject():New()
    Local aNames := {}
    Local nI     := 0
    Local cOrder := ''
    Local cPlan  := ''
    Local cMsg   := ''

    cMsg := oJson:FromJson( cBody )

    If Empty( cMsg )

        If oJson['order']:hasProperty('TJ_ORDEM')

            cOrder := PadR( oJson['order']['TJ_ORDEM'], TAMSX3( 'TJ_ORDEM' )[1] )

        Else

            aReturn := { 400, STR023 } //'O campo TJ_ORDEM é obrigatório'

        EndIf

        If oJson['order']:hasProperty('TJ_PLANO')

            cPlan := PadR( oJson['order']['TJ_PLANO'], TAMSX3( 'TJ_PLANO' )[1] )

        Else

            aReturn := { 400, STR024 } //'O campo TJ_PLANO é obrigatório'

        EndIf

        aNames := oJson:GetNames()
        
        For nI := 1 To Len( aNames )

            If aReturn[1] == 200

                Do Case

                    Case aNames[ nI ] == 'chgorder'
                        aReturn := fChangeOrd( oJson, cOrder, cPlan )

                    Case aNames[ nI ] == 'inputs'
                        aReturn := fChangeIns( oJson, cOrder, cPlan )
                    
                    Case aNames[ nI ] == 'occurrences'
                        aReturn := fChangeOcc( oJson, cOrder, cPlan )

                    Case aNames[ nI ] == 'checklists'
                        aReturn := fChangeChk( oJson, cOrder, cPlan )
                    
                    Case aNames[ nI ] == 'reasonsForDelay'
                        aReturn := fChangeDelay( oJson )

                    Case aNames[ nI ] == 'symptom'
                        aReturn := fChangeSymp( oJson )

                EndCase

            Else

                Exit

            EndIf

        Next nI

    EndIf

    If aReturn[1] == 200

        aReturn[2] := STR008 + oJson['order','TJ_ORDEM'] + STR016 //"Ordem de Serviço "##" alterada com sucesso"

    EndIf

Return aReturn

//---------------------------------------------------------------------
/*/{Protheus.doc} fChangeChk
Função para alterar os checklists da Ordem de Serviço via API.

@param oJson , Objeto, Objeto JSON com os dados da OS e checklists
@param cOrder, String, Código da OS atual
@param cPlan , String, Código do plano da OS

@return aReturn, Array, retorna o código HTTP e mensagem de erro caso tenha
        [1] - Código HTTP
        [2] - Mensagem de erro

@author Cauê Girardi Petri
@since 26/09/2025
/*/
//---------------------------------------------------------------------
Static Function fChangeChk( oJson, cOrder, cPlan )

    Local aReturn  := { 200, '' }
    Local cTipManu := ''

    cTipManu := NgSeek( 'STE', NgSeek( 'ST4', NgSeek( 'STJ', cOrder + cPlan, 1, 'TJ_SERVICO' ) , 1, 'T4_TIPOMAN' ), 1, 'TE_CARACTE')

    aReturn := fChecklists( oJson, cOrder, cPlan, cTipManu, 4 )

Return aReturn

//---------------------------------------------------------------------
/*/{Protheus.doc} fChangeOrd
Função para alterar a Ordem de Serviço via API.

@param oJson , Objeto, Objeto JSON com os dados da OS e suas alterações
@param cOrder, String, Código da OS atual
@param cPlan , String, Código do plano da OS

@return aReturn, Array, retorna o código HTTP e mensagem de erro caso tenha
        [1] - Código HTTP
        [2] - Mensagem de erro

@author Cauê Girardi Petri
@since 27/09/2025
/*/
//---------------------------------------------------------------------
Static Function fChangeOrd( oJson, cOrder, cPlan )

    Local aReturn      := { 200, '' }
    Local aRet         := {}
    Local cDtPrini     := ''
    Local cHoPrini     := ''
    Local cError       := ''
    Local lData        := .F.
    Local oJsonChg     := JsonObject():New()
    Local oJsonOrd     := JsonObject():New()

    oJsonOrd := oJson['order']
    oJsonChg := oJson['chgorder']

    If Empty( cError )

        DbSelectArea( 'STJ' )
        DbSetOrder( 1 )
        If MsSeek( FwxFilial( 'STJ' ) + cOrder + cPlan )

            If oJsonChg:hasProperty('TJ_DTPRINI')

                cDtPrini := oJsonChg['TJ_DTPRINI']

                If oJsonChg:hasProperty('TJ_HOPRINI')

                    cHoPrini := oJsonChg['TJ_HOPRINI']

                EndIf

            EndIf

            If oJsonChg:hasProperty( 'TJ_TERCEIR' ) .And. !( oJsonChg['TJ_TERCEIR'] $ '1/2' )

                aReturn := { 400, STR032 } //"Código de terceiro inválido"

            EndIf

            If aReturn[1] == 200 .And. !Empty( cDtPrini )
            
                aRet := NGStrIsDat( cDtPrini, 'S', .T. )

                If aRet[1]

                    If NGVALHORA(cHoPrini, .F., .T.)

                        lData := .T.

                    Else

                        aReturn := { 400, STR033 } //"Hora inválida"

                    EndIf
                
                Else

                    aReturn := { 400, aRet[2,1] }

                EndIf

            EndIf

            If aReturn[1] == 200

                RecLock( 'STJ', .F. )

                    If lData

                        STJ->TJ_DTPRINI := StoD( cDtPrini )
                        STJ->TJ_HOPRINI := cHoPrini

                    EndIf

                    If oJsonChg:hasProperty('TJ_OBSERVA')

                        STJ->TJ_OBSERVA := oJsonChg['TJ_OBSERVA']

                    EndIf

                    If oJsonChg:hasProperty('TJ_TERCEIR')

                        STJ->TJ_TERCEIR := oJsonChg['TJ_TERCEIR']

                    EndIf

                ('STJ')->(MsUnLock())

            EndIf

        Else

            cError := STR025 + cOrder + STR026 //'Ordem de serviço ' ## ' não encontrada'

        EndIf

    EndIf

    If !Empty( cError )

        aReturn := { 400, cError }

    EndIf

Return aReturn

//--------------------------------------------------------------------------------
/*/{Protheus.doc} fChangeDelay
Função para alterar os motivos de atraso da OS via API

@param oJson    , Objeto, Objeto JSON com os motivos de atraso e dados da OS

@return aReturn , array , array com erro caso acontecer

@author	Cauê Girardi Petri
@since  23/09/2025
/*/
//--------------------------------------------------------------------------------
Static Function fChangeDelay( oJson )

    Local cMotivo    := ''
    Local cDtInic    := ''
    Local cHoInic    := ''
    Local cDtFim     := ''
    Local cHoFim     := ''
    Local cMotivoBkp := ''
    Local cDtInicBkp := ''
    Local cHoInicBkp := ''
    Local cDtFimBkp  := ''
    Local cHoFimBkp  := ''
    Local cOperation := ''
    Local cError     := ''
    Local aReturn    := { 200, '' }
    Local aRetCamps  := {}
    Local aDelayTemp := Array( 10 )
    Local aDelay     := { {},{},{} }
    Local nI         := 0
    Local nX         := 0
    Local oJsonOS    := JsonObject():New()
    Local oJsonDR    := JsonObject():New()
    Local lRec       := .T.

    oJsonOS := oJson['order']
    oJsonDR := oJson['reasonsForDelay']

    For nI := 1 To Len(oJsonDR)

        If oJsonDR[nI]:hasProperty('OPERATION')
            cOperation := oJsonDR[nI]['OPERATION']
        EndIf
        If oJsonDR[nI]:hasProperty('TPL_CODMOT')
            cMotivo := PadR( oJsonDR[nI]['TPL_CODMOT'], TAMSX3( 'TPL_CODMOT' )[1] )
        EndIf
        If oJsonDR[nI]:hasProperty('TPL_DTINIC')
            cDtInic := oJsonDR[nI]['TPL_DTINIC']
        EndIf
        If oJsonDR[nI]:hasProperty('TPL_HOINIC')
            cHoInic := oJsonDR[nI]['TPL_HOINIC']
        EndIf
        If oJsonDR[nI]:hasProperty('TPL_DTFIM')
            cDtFim := oJsonDR[nI]['TPL_DTFIM']
        EndIf
        If oJsonDR[nI]:hasProperty('TPL_HOFIM')
            cHoFim := oJsonDR[nI]['TPL_HOFIM']
        EndIf
        If oJsonDR[nI]:hasProperty('TPL_CODMOT_BKP')
            cMotivoBkp := PadR( oJsonDR[nI]['TPL_CODMOT_BKP'], TAMSX3( 'TPL_CODMOT' )[1] )
        Else
            cMotivoBkp := cMotivo
        EndIf
        If oJsonDR[nI]:hasProperty('TPL_DTINIC_BKP')
            cDtInicBkp := oJsonDR[nI]['TPL_DTINIC_BKP']
        Else
            cDtInicBkp := cDtInic
        EndIf
        If oJsonDR[nI]:hasProperty('TPL_HOINIC_BKP')
            cHoInicBkp := oJsonDR[nI]['TPL_HOINIC_BKP']
        Else
            cHoInicBkp := cHoInic
        EndIf
        If oJsonDR[nI]:hasProperty('TPL_DTFIM_BKP')
            cDtFimBkp := oJsonDR[nI]['TPL_DTFIM_BKP']
        Else
            cDtFimBkp := cDtFim
        EndIf
        If oJsonDR[nI]:hasProperty('TPL_HOFIM_BKP')
            cHoFimBkp := oJsonDR[nI]['TPL_HOFIM_BKP']
        Else
            cHoFimBkp := cHoFim
        EndIf

		aRetCamps := NGStrIsDat( cDtInic, 'S', .T. )

	    If aRetCamps[1]

		    aRetCamps := NGStrIsDat( cDtFim, 'S', .T. )

	    EndIf

        If aRetCamps[1]

            Do Case

                Case cOperation == 'C'

                    //Valida campos para inclusão
                    aRetCamps := NGCKINTDAT( oJsonOS['TJ_ORDEM'], cMotivo, StoD( cDtInic ), cHoInic, StoD( cDtFim ), cHoFim, .F., TPL->(Recno()), 3 )

                    cError := aRetCamps[2]

                    lRec := .T.

                Case cOperation $ 'U/D'

                    DbSelectArea('TPL')
                    dbSetOrder(1)
                    If MsSeek( FwxFilial( 'TPL' ) + oJsonOS['TJ_ORDEM'] + cMotivoBkp + cDtInicBkp + cHoInicBkp + cDtFimBkp + cHoFimBkp )

                        aRetCamps := NGCKINTDAT( oJsonOS['TJ_ORDEM'], cMotivo, StoD( cDtInic ), cHoInic, StoD( cDtFim ), cHoFim, .F., TPL->(Recno()), 4 )

                        cError := aRetCamps[2]

                        lRec := .F.

                    Else

                        aReturn := { 400, STR031 + cMotivoBkp + STR018 }//'Motivo de Atraso '##' não encontrado'

                        Exit

                    EndIf

                Otherwise

                    aReturn := { 400, STR010 } //'Operação inválida'

                    Exit

            EndCase

        Else

            cError := aRetCamps[2,1]

        EndIf

        If aRetCamps[1]

            aDelayTemp[_REASON_]       := cMotivo
            aDelayTemp[_DATEIN_]       := cDtInic
            aDelayTemp[_HOINI_]        := cHoInic
            aDelayTemp[_DATEFIM_]      := cDtFim
            aDelayTemp[_HOFIM_]        := cHoFim
            aDelayTemp[_KEYREASON_]    := cMotivoBkp
            aDelayTemp[_KEYDATEIN_]    := cDtInicBkp
            aDelayTemp[_KEYHOINI_]     := cHoInicBkp
            aDelayTemp[_KEYDATEFIM_]   := cDtFimBkp
            aDelayTemp[_KEYHOFIM_]     := cHoFimBkp

            Do Case
                Case cOperation == 'C'
                    aAdd(aDelay[_INSERT_], aClone( aDelayTemp ) )
                Case cOperation == 'U'
                    aAdd(aDelay[_UPDATE_], aClone( aDelayTemp ) )
                Otherwise
                    aAdd(aDelay[_DELETE_], aClone( aDelayTemp ) )
            EndCase

        Else

            aReturn := { 400, cError }

            Exit
        
        EndIf

    Next nI

    If aReturn[1] == 200

        For nI := 1 To 3

            For nX := 1 To Len( aDelay[nI] )

                //Posiciona no registro para alterar/deletar
                If nI != _INSERT_

                    DbSelectArea('TPL')
                    DbSetOrder(1)
                    MsSeek( FwxFilial( 'TPL' ) + oJsonOS['TJ_ORDEM'] + aDelay[nI,nX,_KEYREASON_] + aDelay[nI,nX,_KEYDATEIN_] + aDelay[nI,nX,_KEYHOINI_] + aDelay[nI,nX,_KEYDATEFIM_] + aDelay[nI,nX,_KEYHOFIM_] )

                EndIf

                RecLock( 'TPL', nI == _INSERT_ )

                If nI == _DELETE_

                    //Realiza exclusão
                    TPL->(dbDelete())
                    TPL->(MsUnlock())

                Else

                    //Realiza inclusão ou alteração
                    TPL_FILIAL := FwxFilial('TPL')
                    TPL_ORDEM  := oJsonOS['TJ_ORDEM']
                    TPL_CODMOT := aDelay[nI,nX,_REASON_]
                    TPL_DTINIC := StoD( aDelay[nI,nX,_DATEIN_] )
                    TPL_HOINIC := aDelay[nI,nX,_HOINI_]
                    TPL_DTFIM  := StoD( aDelay[nI,nX,_DATEFIM_] )
                    TPL_HOFIM  := aDelay[nI,nX,_HOFIM_]
                    TPL->( MsUnlock() )

                EndIf

            Next

        Next

    EndIf

Return aReturn

//--------------------------------------------------------------------------------
/*/{Protheus.doc} fChangeSymp
Função para alterar os sintomas da OS via API
@param oJson    , Objeto, Objeto JSON com os sintomas e dados da OS
@return aReturn , array , array com erro caso acontecer
@author	Cauê Girardi Petri
@since  08/10/2025
/*/
//--------------------------------------------------------------------------------
Static Function fChangeSymp( oJson )

    Local cCdSimp     := ''
    Local cCdSimpBkp  := ''
    Local cOperation  := ''
    Local aReturn     := { 200, '' }
    Local aSympTemp   := Array(2)
    Local aSymptom    := { {},{},{} }
    Local nI          := 0
    Local nX          := 0
    Local oJsonOS     := JsonObject():New()
    Local oJsonSymp   := JsonObject():New()

    oJsonOS   := oJson['order']
    oJsonSymp := oJson['symptom']

    For nI := 1 To Len(oJsonSymp)
        If oJsonSymp[nI]:hasProperty('OPERATION')
            cOperation := oJsonSymp[nI]['OPERATION']
        EndIf
        If oJsonSymp[nI]:hasProperty('TTC_CDSINT')
            cCdSimp := PadR( oJsonSymp[nI]['TTC_CDSINT'], TAMSX3( 'TTC_CDSINT' )[1] )
        EndIf
        If oJsonSymp[nI]:hasProperty('TTC_CDSINT_BKP')
            cCdSimpBkp := PadR( oJsonSymp[nI]['TTC_CDSINT_BKP'], TAMSX3( 'TTC_CDSINT' )[1] )
        Else
            cCdSimpBkp := cCdSimp
        EndIf

        // Validação do sintoma
        If !ExistCPO( 'TTB', cCdSimp )
            aReturn := { 400, STR017 + cCdSimp + STR018 } //"Sintoma "##" não encontrado"
            Exit
        EndIf

        Do Case

            Case cOperation == 'C'

                //Valida se já existe o sintoma na OS
                DbSelectArea('TTC')
                dbSetOrder(1)
                If MsSeek( FwxFilial("TTC") + oJsonOS['TJ_ORDEM'] + "000000" + cCdSimp )

                    aReturn := { 400, STR017 + cCdSimp + STR019 + oJsonOS['TJ_ORDEM'] } //"Sintoma "##" já cadastrado na OS "
                    Exit
                    
                EndIf

            Case cOperation == 'U'

                DbSelectArea('TTC')
                dbSetOrder(1)
                If MsSeek( FwxFilial("TTC") + oJsonOS['TJ_ORDEM'] + "000000" + cCdSimp )

                    aReturn := { 400, STR017 + cCdSimp + STR019 + oJsonOS['TJ_ORDEM'] } //"Sintoma "##" já cadastrado na OS "
                    Exit

                EndIf

                If !MsSeek( FwxFilial("TTC") + oJsonOS['TJ_ORDEM'] + "000000" + cCdSimpBkp )

                    aReturn := { 400, STR017 + cCdSimpBkp + STR018 } //'Sintoma '##' não encontrado'
                    Exit

                EndIf

            Case cOperation == 'D'

                DbSelectArea('TTC')
                dbSetOrder(1)
                If !MsSeek( FwxFilial("TTC") + oJsonOS['TJ_ORDEM'] + "000000" + cCdSimpBkp )

                    Loop

                EndIf

            Otherwise

                aReturn := { 400, STR010 } //'Operação inválida'
                Exit

        EndCase

        aSympTemp[_SYMPTOM_]    := cCdSimp
        aSympTemp[_KEYSYMPTOM_] := cCdSimpBkp

        Do Case
            Case cOperation == 'C'
                aAdd(aSymptom[_INSERT_], aClone( aSympTemp ) )
            Case cOperation == 'U'
                aAdd(aSymptom[_UPDATE_], aClone( aSympTemp) )
            Otherwise
                aAdd(aSymptom[_DELETE_], aClone( aSympTemp) )
        EndCase

    Next nI

    If aReturn[1] == 200

        For nI := 1 To 3

            For nX := 1 To Len( aSymptom[nI] )

                //Posiciona no registro para alterar/deletar
                If nI != _INSERT_

                    DbSelectArea('TTC')
                    DbSetOrder(1)
                    MsSeek( FwxFilial("TTC") + oJsonOS['TJ_ORDEM'] + "000000" + aSymptom[nI,nX,_KEYSYMPTOM_] )

                EndIf

                RecLock( 'TTC', nI == _INSERT_ )

                If nI == _DELETE_

                    //Realiza exclusão
                    TTC->(dbDelete())
                    TTC->(MsUnlock())

                Else

                    //Realiza inclusão ou alteração
                    TTC->TTC_FILIAL := FwxFilial("TTC")
                    TTC->TTC_CODBEM := NgSeek( 'STJ', oJsonOS['TJ_ORDEM'], 1, 'TJ_CODBEM')
                    TTC->TTC_ORDEM  := oJsonOS['TJ_ORDEM']
                    TTC->TTC_PLANO  := "000000"
                    TTC->TTC_DATA   := NgSeek( 'STJ', oJsonOS['TJ_ORDEM'], 1, 'TJ_DTORIGI')
                    TTC->TTC_CDSINT := aSymptom[nI,nX,_SYMPTOM_]
                    TTC->( MsUnlock() )

                EndIf

            Next

        Next

    EndIf

Return aReturn
