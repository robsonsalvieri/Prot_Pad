#INCLUDE "mntc040.ch"
#INCLUDE "PROTHEUS.CH"

//-------------------------------------------------------------------
/*/{Protheus.doc} MNTC040
Ordens de serviço por OS ou por serviço  
@author  Inacio Luiz Kolling
@since   02/08/97
@version P12
/*/
//-------------------------------------------------------------------
Function MNTC040(cORDEM)

	Local aNGBEGINPRM := NGBEGINPRM()

	Local olddetalhe
	Local cFilter
	Local cOldFun := FunName()
	Local nrecno  := ST4->(Recno())
	Local aRotina := MenuDef()

	Private cCadastro := OemtoAnsi(STR0001) //"Ordem de Servico"
	Private lCORRET   := .F.

	If IsInCallStack("MNTA040") .And. INCLUI
		MsgInfo(STR0016,STR0015)  //"Serviço não cadastrado." ## "ATENÇÃO"
		Return .F.
	EndIf

	If cORDEM == Nil .OR. FunName() == "QNCA040"
		olddetalhe := aCLONE(aROTINA)
	EndIf

	If FunName() != "MNTC040"

		SetFunName( "MNTC040" )

	EndIf

	M->T4_SERVICO := ST4->T4_SERVICO

	If cORDEM == Nil
		DbSelectArea("STJ")
		DbSetOrder(04)

		cKey := M->T4_SERVICO

		bWHILE := {|| !Eof() .And. STJ->TJ_SERVICO == M->T4_SERVICO }
		bFOR   := {|| TJ_FILIAL == xFilial("STJ") }
	Else
		M->TJ_ORDEM := Space(Len(STJ->TJ_ORDEM))
		M->TJ_ORDEM := cORDEM

		DbSelectArea("STJ")
		DbSetOrder(01)

		cKey := M->TJ_ORDEM

		bWHILE := {|| !Eof() .And. STJ->TJ_ORDEM == M->TJ_ORDEM}
		bFOR   := {|| TJ_FILIAL  == xFilial("STJ") }

	EndIf

	If ExistBlock("MNTC0401")
		cFilter := ExecBlock("MNTC0401",.F.,.F.)
		If ValType(cFilter) <> "C"
			cFilter := Nil
		EndIf
	EndIf

	NGCONSULTA("TRBJ", cKEY, bWHILE, bFOR, aRotina,{},,,,,,If( ValType( cFilter ) == "C" , cFilter , Nil ) )

	SetFunName( cOldFun )

	aRotina := aCLONE(olddetalhe)
	DbSelectArea("ST4")
	DbSetOrder(01)
	DbGoto(nrecno)

	NGRETURNPRM(aNGBEGINPRM)

Return .T.

//-------------------------------------------------------------------
/*/{Protheus.doc} NGATRASOS
Monta um browse dos Motivos de Atraso da O.S

@author Maria Elisandra de Paula
@since 19/05/21
/*/
//-------------------------------------------------------------------
Function NGATRASOS()

	MNTC040A()

Return .T.

//-------------------------------------------------------------------
/*/{Protheus.doc} NGATRASOS2
Monta um browse dos Motivos de Atraso da O.S

@author Inacio Luiz Kolling
@since 02/08/97
/*/
//-------------------------------------------------------------------
Function NGATRASOS2( aMenu )

	Local oBrowse
	Local cTrb     := IIf( Type( '_cTrb' ) <> 'U', _cTrb, '' )
	Local aArea    := GetArea()
	Local cFilter  := ''
	Local cTable   := ''
	Local nOrdem   := 0

	Default aMenu  := {}

	Private cCadastro := OemtoAnsi(STR0014) //"Motivo Atraso"

	aRotina := aMenu

	If Alias() $ "STS" .And. !Empty( STS->TS_ORDEM )

		RegToMemory( 'STS', .F. )

		cTable := 'TQ6'
		nOrdem := 2

		DbSelectArea( "TQ6" )
		DbSetOrder( 02 )

		cFilter := ' TQ6->TQ6_FILIAL == FWxFilial("TQ6") .And. TQ6->TQ6_ORDEM == M->TS_ORDEM'

	ElseIf !Empty(STJ->TJ_ORDEM) .And. Empty(cTrb)

		RegToMemory( 'STJ', .F. )

		cTable := 'TPL'
		nOrdem := 1

		DbSelectArea("TPL")
		DbSetOrder(1)

		cFilter := ' TPL->TPL_FILIAL == FWxFilial("TPL") .And. TPL->TPL_ORDEM == M->TJ_ORDEM'

	ElseIf !Empty((_cTrb)->TJ_ORDEM)

		M->TJ_ORDEM := (_cTrb)->TJ_ORDEM
		cTable := 'TPL'
		nOrdem := 1

		DbSelectArea("TPL")
		DbSetOrder(1)

		cFilter := ' TPL->TPL_FILIAL == FWxFilial("TPL") .And. TPL->TPL_ORDEM == M->TJ_ORDEM'

	EndIf

	oBrowse:= FWMBrowse():New()
	oBrowse:SetAlias( cTable )		  // Alias da tabela utilizada
	oBrowse:SetDescription( STR0014 ) //"Motivo Atraso"
	oBrowse:SetFilterDefault( cFilter )
	oBrowse:Activate()

	DbSelectArea( cTable )
	DbSetOrder( nOrdem )

	RestArea( aArea )

Return .T.

Static Function MenuDef()

	Local aRet := {{STR0002,"AXPesqui"  , 0, 1},;                  //"Pesquisar"
					{STR0003,"NGVISUAL(,,, 'NGCAD01' )"  , 0, 2},; //"Visual."
					{STR0004,"MNTCOSDE"  , 0, 3, 0},;              //"Detalhes"
					{STR0005,"MNTCOCOR"  , 0, 4, 0},;              //"Ocorren."
					{STR0006,"MNTC550A", 0, 4, 0},;                //"proBlemas"
					{STR0014,"NGATRASOS" , 0, 4, 0},;              //"Motivo Atraso"
					{STR0007,"MNTC550B"  , 0, 4}}                  //"Etapas"

Return aRet
