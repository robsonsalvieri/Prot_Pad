#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "mntinsightsi21change.ch"

//------------------------------------------------------------------------------
/*/{Protheus.doc} mntInsightsI21Change
Função executada pela rota "mnt-insight/i21-change/:equipment/:service/:sequence"
Realiza a alteração do status de um Paylod

@type Function

@author João Ricardo Santini Zandoná
@since 22/10/2025

@return Nil  
/*/ 
//------------------------------------------------------------------------------
@Put ( endpoint = 'mnt-insight/i21-change/:equipment/:service/:sequence' )
function mntInsightsI21Change()

    Local oError
	Local bLastError
    Local aResponse  := { Nil ,200 }
    Local jRespJson  := JsonObject():New()
    Local jPathParam := oRest:getPathParamsRequest()

	bLastError := ErrorBlock( { | oError | MntWSError( oError ), .F., Break( oError ) } )

    Begin Sequence

        If jPathParam:HasProperty( 'equipment' ) .And. jPathParam:HasProperty( 'service' ) .And. jPathParam:HasProperty( 'sequence' );
        .And. ValType( jPathParam[ 'equipment' ] ) == 'C' .And. ValType( jPathParam[ 'service' ] ) == 'C' .And. ValType( jPathParam[ 'sequence' ] ) == 'C';
        .And. !Empty( jPathParam[ 'equipment' ] ) .And. !Empty( jPathParam[ 'service' ] ) .And. !Empty( jPathParam[ 'sequence' ] )

            aResponse := mntChangeStatusI21( jPathParam[ 'equipment' ], jPathParam[ 'service' ], jPathParam[ 'sequence' ] )

        Else

            aResponse[1] := STR0001 // "O equipamento o campo e o serviço devem ser informados!"
            aResponse[2] := 400
            
        EndIf

        jRespJson['message'] := aResponse[ 1 ]

        oRest:SetStatusCode( aResponse[ 2 ] )
        oRest:SetResponse( jRespJson )

	End Sequence
    
    ErrorBlock( bLastError )

return

//------------------------------------------------------------------------------
/*/{Protheus.doc} mntChangeStatusI21
Realiza a alteração do registro na I21

@type Function

@author João Ricardo Santini Zandoná
@since 22/10/2025
@param cBem,  caractere,     carrega o código do bem
@param cService, caractere,  carrega o código do serviço que deve ser ajustado
@param cSequence, caractere, carrega a sequência do registro
@param cNewValue, caractere, novo valor do campo status

@return array, retorna na primeira posição a String que deve ser retornada pela API e na segunda o código do retorno  
/*/ 
//------------------------------------------------------------------------------
function mntChangeStatusI21( cBem, cService, cSequence, cNewValue )

    Local oPaylod   := JsonObject():New()
    Local cQuery    := ''
    Local cAliasQry := ''
    Local nI        := 1
    Local aRet      := { STR0002, 400 } // "Não foi possível realizar o ajuste."

    Default cNewValue := 'inactive'

    cAliasQry := GetNextAlias()

    cQuery := 'SELECT '
    cQuery +=   'I21.R_E_C_N_O_ AS REC '
    cQuery += 'FROM ' + RetSqlName( 'I21' ) + ' I21 '
    cQuery += 'WHERE '
    cQuery +=   'I21.I21_KEY = ' + ValToSQL( cEmpAnt + '|' + AllTrim( FWxFilial( 'ST9' ) ) + '|' + cBem ) + ' '
    cQuery +=   "AND I21.I21_INSIGT = 'SuggestPreventives' "
    cQuery +=   "AND I21.D_E_L_E_T_ = ' ' "
    cQuery += 'ORDER BY I21.I21_DTPROC DESC '

    cQuery := ChangeQuery( cQuery )

    dbUseArea( .T.,'TOPCONN',TcGenQry( , , cQuery ), cAliasQry, .T., .T. )

    dbSelectArea( cAliasQry )
    dbGoTop()
    If (cAliasQry)->( !Eof() )

        dbSelectArea( 'I21' )
        dbGoTo( (cAliasQry)->REC )

        oPaylod:FromJson( StrTran( SubStr( I21->I21_PAYLOD, 2, ( Len( I21->I21_PAYLOD ) - 2 ) ), '\','' ) )

        If len( oPaylod ) > 0

            For nI := 1 To Len( oPaylod )

                If AllTrim( oPaylod[ nI, 'service' ] ) == AllTrim( cService )

                    oPaylod[ nI, 'status' ] := cNewValue

                    Exit

                EndIf

            Next nI

            RecLock( 'I21', .F. )
            I21_PAYLOD := '[' + oPaylod:ToJSON() + ']'
            I21->( MsUnLock() )
            aRet := { STR0003, 200 } // "Ajuste realizado com sucesso!"

        EndIf

    EndIf

    (cAliasQry)->(DbCloseArea())

return aRet
