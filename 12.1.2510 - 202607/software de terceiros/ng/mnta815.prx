Function MNTA815IMP()
Local nI, l1Problema := .t., lDocGerado := .t.
Private cRODATXT := ""
Private nCNTIMPR := 0
Private li := 80 ,m_pag := 1

nTIPO  := IIf(aReturn[4]==1,15,18)

CABEC1 := STR0024 //"Veículo"
If lIntFin
	CABEC2 := STR0031    //"   Documento   Nome                                       Parcela        Valor   Dt. Emissão   Vencimento   N. Título"
Else
	CABEC2 := STR0025    //"   Documento   Nome                                       Parcela        Valor   Dt. Emissão   Vencimento"
Endif

/*
          1         2         3         4         5         6         7         8         9         0         1
012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456
*********************************************************************************************************************
                             Relatorio de Geracao de Documentos
*********************************************************************************************************************
xxxxxxxxxxxxxxxx - xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
   Documento   Nome                                       Parcela        Valor   Dt. Emissão   Vencimento   N. Título
   xxxxxx      xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx         x   999.999,22      99/99/99     99/99/99   xxxxxxxxx
*/
cVeiAntigo := ''
SetRegua(Len(aRelatorio))
For nI := 1 to Len(aRelatorio)
	IncRegua()
	If aRelatorio[nI][1] == '1'
		If l1Problema
			l1Problema := .f.
			NgSomaLi(58)
			@ Li,000	 Psay "**********   " + STR0032 + "   **********" // "PARA O(S) DOCUMENTO(S) ABAIXO, O CAMPO 'COND. PAGTO' DEVERÁ SER AVALIADO, NO CADASTRO DE DOCUMENTOS."
			NgSomaLi(58)
			@ Li,000	 Psay "**************   " + STR0033 + "   **************" // "NÃO FOI POSSÍVEL REALIZAR A GERAçÂO DAS PARCELAS CONFORME A CONDIÇÃO DE PAGAMENTO INFORMADA."
			NgSomaLi(58)
		Endif
		NgSomaLi(58)
		@ Li,000		 Psay AllTrim(aRelatorio[nI][2]) + ' - ' + AllTrim(aRelatorio[nI][3])
	Else
		If lDocGerado .AND. lIntFin
			lDocGerado := .f.
			NgSomaLi(58)
			NgSomaLi(58)
			@ Li,000	 Psay "***************************************************   " + STR0034 + "   ***************************************************" // "DOCUMENTOS GERADOS:"
			NgSomaLi(58)
		Endif
		NgSomaLi(58)
		@ Li,000 	 Psay AllTrim(aRelatorio[nI][2]) + ' - ' + AllTrim(aRelatorio[nI][3])
		NgSomaLi(58)
		@ Li,003 	 Psay aRelatorio[nI][4]
		@ Li,015 	 Psay aRelatorio[nI][5]
		@ Li,064 	 Psay aRelatorio[nI][6]
		@ Li,068 	 Psay PADL(Transform(aRelatorio[nI][7],'@E 999,999.99'),10)
		@ Li,081 	 Psay aRelatorio[nI][8]
		@ Li,095 	 Psay aRelatorio[nI][9]
		If lIntFin
			@ Li,108 	 Psay aRelatorio[nI][10]
		Endif
	Endif
Next

RODA(nCNTIMPR,cRODATXT,TAMANHO)

RetIndex('ST9')
Set Filter To
Set Device To Screen
If aReturn[5] == 1
   Set Printer To
   dbCommitAll()
   OurSpool(WNREL)
EndIf
MS_FLUSH()

Return Nil
