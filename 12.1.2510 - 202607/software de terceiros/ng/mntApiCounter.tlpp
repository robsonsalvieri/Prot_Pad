#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "mntapicounter.ch"

//------------------------------------------------------------------------
/*/{Protheus.doc} MntCounterPost
Método post para realizar as ações sobre o contador

@author Cauê Girardi Petri
@since	05/11/2025
@return	Lógico, True
/*/
//------------------------------------------------------------------------

@Post ( endpoint = 'mntCounter/:action' )
function MntCounterPost()

    Local oError
    Local oJson       := JsonObject():New()
	Local bLastError
    Local cAction     := oRest:URN
    Local aReturn     := { '' ,400 }
    Local cTpCodBem   := ""
    Local nTpPosCont  := 0
    Local cTpDtLei    := ""
    Local cTpHora     := ""
    Local cTppCodBem  := ""
    Local nTppPosCont := 0
    Local cTppDtLei   := ""
    Local cTppHora    := ""
    Local lRet        := .T.

    //Variavel responsavel de realizar as ações relacionadas a contador
    Private oSTP

    oJson:FromJson( oRest:getBodyRequest() )

	bLastError := ErrorBlock( { |oError| MntWSError( oError ),.F., Break(oError) } )
    
    Begin Transaction

        If oJson:hasProperty('TP_CODBEM')
            cTpCodBem := PadR( oJson:TP_CODBEM, FwTamSX3('TP_CODBEM')[1] )
        EndIf

        If oJson:hasProperty('TP_POSCONT')
            nTpPosCont := oJson:TP_POSCONT
        EndIf

        If oJson:hasProperty('TP_DTLEITU')
            cTpDtLei := oJson:TP_DTLEITU
        EndIf

        If oJson:hasProperty('TP_HORA')
            cTpHora := PadR( oJson:TP_HORA, FwTamSX3('TP_HORA')[1] )
        EndIf

        If oJson:hasProperty('TPP_CODBEM')
            cTppCodBem := PadR( oJson:TPP_CODBEM, FwTamSX3('TPP_CODBEM')[1] )
        EndIf

        If oJson:hasProperty('TPP_POSCON')
            nTppPosCont := oJson:TPP_POSCON
        EndIf

        If oJson:hasProperty('TPP_DTLEIT')
            cTppDtLei := oJson:TPP_DTLEIT
        EndIf

        If oJson:hasProperty('TPP_HORA')
            cTppHora := PadR( oJson:TPP_HORA, FwTamSX3('TPP_HORA')[1] )
        EndIf

        oSTP:= MNTCounter():New()
        oSTP:setOperation(3)
    
        oSTP:setValue("TP_CODBEM" , cTpCodBem)
        oSTP:setValue("TP_POSCONT", nTpPosCont)
        oSTP:setValue("TP_DTLEITU", StoD( cTpDtLei ) )
        oSTP:setValue("TP_HORA"   , cTpHora)
    
        oSTP:setValue("TPP_CODBEM", cTppCodBem)
        oSTP:setValue("TPP_POSCON", nTppPosCont)
        oSTP:setValue("TPP_DTLEIT", StoD( cTppDtLei ) )
        oSTP:setValue("TPP_HORA"  , cTppHora)

        Do Case
            Case 'break' $ cAction
                lRet := oSTP:BreakCounter()
                cMsg := STR0001 //'Quebra de contador(es) realizada com sucesso'
            Case 'turn' $ cAction
                lRet := oSTP:Turn()
                cMsg := STR0002 //'Virada de contador(es) realizada com sucesso'
            Case 'inform' $ cAction
                lRet := oSTP:Inform()
                cMsg := STR0003 //'Contador(es) informado(s) com sucesso'
            Otherwise
                aReturn := { 400, STR0004 } //"URL inválida"
                Disarmtransaction()
        EndCase

		If lRet
            aReturn := { 200, cMsg }
        Else
			aReturn := { 400, oSTP:getErrorList()[1] }
            Disarmtransaction()
		EndIf

	End Transaction

    oRest:SetStatusCode(aReturn[1])
    oRest:SetResponse(aReturn[2])
    
    ErrorBlock(bLastError)

    FWFreeArray( aReturn )

Return .T.
