#include "tlpp-core.th"
#include "tlpp-rest.th"
 
//------------------------------------------------------------------------------
/*/{Protheus.doc} MntInsightsEquipments
Função executada pela rota "rest/mnt_insight/list_equipment"
Valida os parâmetros enviados e realiza o envio dos dados para o
gráfico de banheira
 
@type Function
 
@author João Ricardo Santini Zandoná
@since 01/07/2025
 
@return Nil  
/*/ 
//------------------------------------------------------------------------------
@Get ( endpoint = 'mnt-insight/list-equipment' )    
function MntInsightsEquipments()
 
    Local oError
	Local bLastError
    Local aResponse  := { Nil ,200 }
 
	bLastError := ErrorBlock( { | oError | MntWSError( oError ), .F., Break( oError ) } )
 
    Begin Sequence
 
        aResponse := fBens( oRest )
 
        oRest:SetStatusCode( aResponse[ 2 ] )
        oRest:SetResponse( aResponse[ 1 ] )
 
	End Sequence
    ErrorBlock( bLastError )
 
return
 
//------------------------------------------------------------------------------
/*/{Protheus.doc} fBens
Função responsável por montar o JSON da carga de bens
 
@type Function
 
@author João Ricardo Santini Zandoná
@since 01/07/2025
@params oRest, objeto, que contém os parâmetros da requisição
 
@return array, retorna na primeira posição o objeto Json com a carga de bens
                e na segunda posição o código de status HTTP
/*/ 
//------------------------------------------------------------------------------
static function fBens( oRest )
 
    Local oResponse := JsonObject():New()
    Local oJson
    Local aResponse := {}
    Local nI        := 1
    Local cQuery    := ''
    Local cBanco    := AllTrim( TCGetDB() )
    Local cAliasQry := GetNextAlias()
    Local cInsights := ''
    Local cServRef  := Alltrim( SuperGetMv( 'MV_NGSEREF', .F., '' ) )
    Local cServCon  := Alltrim( SuperGetMv( 'MV_NGSECON', .F., '' ) )
    Local cServPn   := Alltrim( SuperGetMv( 'MV_NGSERPN', .F., '' ) )
    Local cServRod  := Alltrim( SuperGetMv( 'MV_NGRODIZ', .F., '' ) )
    Local cServCa   := Alltrim( SuperGetMv( 'MV_NGSERCA', .F., '' ) )
 
    cCTE := 'With INSI21 AS ( '
 
    cCTE += 'SELECT '
    cCTE +=   'I21.I21_KEY, '
    cCTE +=   'CASE '
    cCTE +=     'WHEN ' 
    cCTE +=       "COUNT(CASE WHEN I21.I21_INSIGT = 'BathtubCurve' THEN 1 END) > 0 "
    cCTE +=       "AND COUNT(CASE WHEN I21.I21_INSIGT = 'SuggestPreventives' THEN 1 END) > 0 "
    cCTE +=     "THEN 'BathtubCurve,SuggestPreventives' "
    cCTE +=     'WHEN '
    cCTE +=       "COUNT(CASE WHEN I21.I21_INSIGT = 'BathtubCurve' THEN 1 END) > 0 "
    cCTE +=     "THEN 'BathtubCurve' "
    cCTE +=     'WHEN '
    cCTE +=       "COUNT(CASE WHEN I21.I21_INSIGT = 'SuggestPreventives' THEN 1 END) > 0 "
    cCTE +=     "THEN 'SuggestPreventives' "
    cCTE +=     "ELSE ' ' "
    cCTE +=   'END AS INSIGHTS, '
    cCTE +=   'MAX( '
    cCTE +=     'CASE '
    cCTE +=         'WHEN '
    cCTE +=           "I21.I21_INSIGT = 'SuggestPreventives' THEN I21.R_E_C_N_O_ "
    cCTE +=     'ELSE '
    cCTE +=         'NULL '
    cCTE +=     'END) AS I21RECNO '
    cCTE += 'FROM ' + RetSqlName( 'I21' ) + ' I21 '
    cCTE += 'WHERE '
    cCTE +=   "I21.I21_INSIGT IN ('BathtubCurve', 'SuggestPreventives') "
    cCTE +=   "AND D_E_L_E_T_ = ' ' "
    cCTE += 'GROUP BY I21.I21_KEY '
    cCTE +=   '), '
    cCTE += 'STJ_STATUS AS ( '
    cCTE +=     'SELECT '
    cCTE +=         'TJ_CODBEM,'
    cCTE +=         'CASE '
    cCTE +=             'WHEN SUM( '
    cCTE +=                 'CASE '
    cCTE +=                     "WHEN TJ_DTPRINI <> ' ' AND TJ_DTPRFIM = ' ' "
    cCTE +=                 'THEN 1 '
    cCTE +=                 'ELSE 0 '
    cCTE +=                 'END ) > 0 '
    cCTE +=              "THEN 'STOPPED' "
    cCTE +=             'WHEN SUM( '
    cCTE +=                 'CASE '
    cCTE +=                     "WHEN TJ_DTPRINI = ' ' AND TJ_DTPRFIM = ' ' "
    cCTE +=                 'THEN 1 '
    cCTE +=                 'ELSE 0 '
    cCTE +=                 'END ) > 0 '
    cCTE +=              "THEN 'MAINTENANCE' "
    cCTE +=              "ELSE 'AVAILABLE' "
    cCTE +=           'END AS SITUATION '
    cCTE +=     'FROM ' + RetSqlName( 'STJ' ) + ' STJ '
    cCTE +=     'WHERE '
    cCTE +=         'TJ_FILIAL = ' + ValToSQL( FWxFilial( 'STJ', cFilAnt ) ) + ' '
    cCTE +=         "AND TJ_TERMINO = 'N' "
    cCTE +=         "AND TJ_SITUACA = 'L' "
    cCTE +=         "AND D_E_L_E_T_ = ' ' "
    cCTE +=     'GROUP BY TJ_CODBEM '
    cCTE +=     ') '
    cQuery += 'SELECT '
    cQuery += 'ST9.T9_CODBEM, '
    cQuery += 'ST9.T9_NOME, '
    cQuery += 'ST9.T9_TIPMOD, '
    cQuery += 'TQR.TQR_DESMOD, '
    cQuery += 'ST9.T9_CODFAMI, '
    cQuery += 'ST6.T6_NOME, '
    cQuery += 'ST9.T9_VALCPA, '
    cQuery += 'ST9.T9_CCUSTO, '
    cQuery += 'CTT.CTT_DESC01, '
    cQuery += 'ST9.T9_CENTRAB, '
    cQuery += 'SHB.HB_NOME,'
    cQuery += 'CTEI21.I21RECNO AS REC, '
 
    If cBanco == 'ORACLE'
		cQuery += 'NVL'
	ElseIf cBanco == 'POSTGRES'
		cQuery += 'COALESCE'
	Else
		cQuery += 'ISNULL'
	EndIf
 
    cQuery += "(CTEI21.INSIGHTS, ' ') AS INSIGHTS, "
 
    If cBanco == 'ORACLE'
		cQuery += 'NVL'
	ElseIf cBanco == 'POSTGRES'
		cQuery += 'COALESCE'
	Else
		cQuery += 'ISNULL'
	EndIf
    cQuery += "(STJ_STATUS.SITUATION, 'AVAILABLE') AS SITUATION "
 
    cQuery += 'FROM ' + RetSqlName( 'ST9' ) + ' ST9 '
    cQuery += 'INNER JOIN ' + RetSqlName( 'TQR' ) + ' TQR ON '
    cQuery +=   'TQR.TQR_FILIAL = ' + ValToSQL( FWxFilial( 'TQR', cFilAnt ) ) + ' '
    cQuery +=   'AND TQR.TQR_TIPMOD = ST9.T9_TIPMOD '
    cQuery +=   "AND TQR.D_E_L_E_T_ = ' ' "
    cQuery += 'INNER JOIN ' + RetSqlName( 'ST6' ) + ' ST6 ON '
    cQuery +=   'ST6.T6_FILIAL = ' + ValToSQL( FWxFilial( 'ST6', cFilAnt ) ) + ' '
    cQuery +=   'AND ST6.T6_CODFAMI = ST9.T9_CODFAMI '
    cQuery +=   "AND ST6.D_E_L_E_T_ = ' ' "
    cQuery += 'INNER JOIN ' + RetSqlName( 'CTT' ) + ' CTT ON '
    cQuery +=   'CTT.CTT_FILIAL = ' + ValToSQL( FWxFilial( 'CTT', cFilAnt ) ) + ' '
    cQuery +=   'AND CTT.CTT_CUSTO = ST9.T9_CCUSTO '
    cQuery +=   "AND CTT.D_E_L_E_T_ = ' ' "
    cQuery += 'LEFT JOIN ' + RetSqlName( 'SHB' ) + ' SHB ON '
    cQuery +=   'SHB.HB_FILIAL = ' + ValToSQL( FWxFilial( 'SHB', cFilAnt ) ) + ' '
    cQuery +=   'AND SHB.HB_COD = ST9.T9_CENTRAB '
    cQuery +=   "AND SHB.D_E_L_E_T_ = ' ' "
    cQuery += 'LEFT JOIN INSI21 CTEI21 ON '
    cQuery +=   'CTEI21.I21_KEY = ' + ValToSQL( cEmpAnt + '|' + AllTrim( FWxFilial( 'ST9' ) ) + '|' ) + ' ' 
    
     If cBanco == 'ORACLE'
     
        cQuery +=   '|| ST9.T9_CODBEM '
	
    Else
	
    	cQuery +=   '|| RTRIM(ST9.T9_CODBEM) '
	
    EndIf

    cQuery += 'LEFT JOIN STJ_STATUS ON '
    cQuery +=   'STJ_STATUS.TJ_CODBEM = ST9.T9_CODBEM '
    cQuery += 'WHERE '
    cQuery +=   "ST9.T9_SITBEM = 'A' "
    cQuery +=   "AND ST9.D_E_L_E_T_ = ' ' "
    cQuery +=   "AND CTEI21.INSIGHTS <> ' ' "
    cQuery += 'ORDER BY ST9.T9_CODBEM '
 
    cQuery := ChangeQuery( cQuery )
    cQuery := cCTE + cQuery
 
    dbUseArea( .T.,'TOPCONN',TcGenQry( , , cQuery ), cAliasQry, .T., .T. )
 
    While (cAliasQry)->(!Eof())
 
        cInsights := ''

        If 'BathtubCurve' $ AllTrim( (cAliasQry)->INSIGHTS )

            cInsights += 'BathtubCurve,'

        EndIf

        If 'SuggestPreventives' $ AllTrim( (cAliasQry)->INSIGHTS )
            
            DbSelectArea( 'I21' )
            DbGoTo( (cAliasQry)->REC )

            oJson := JsonObject():New()

            oJson:FromJson( StrTran( SubStr( I21->I21_PAYLOD, 2, ( Len( I21->I21_PAYLOD ) - 2 ) ), '\','' ) )

            For nI := 1 To Len( oJson )

                If ValType( oJson[ nI, 'prediction_type' ] ) == 'C' .And. oJson[ nI, 'prediction_type' ] $ 'new_preventive_from_corrective/suggest_executing_preventive/update_existing_preventive' .And. ValType( oJson[ nI, 'message' ] ) == 'C' .And.;
                AllTrim( oJson[ nI, 'service' ] ) != cServRef .And. AllTrim( oJson[ nI, 'service' ] ) != cServCon .And. AllTrim( oJson[ nI, 'service' ] ) != cServPn .And.;
                AllTrim( oJson[ nI, 'service' ] ) != cServRod .And. AllTrim( oJson[ nI, 'service' ] ) != cServCa

                    cInsights += 'SuggestPreventives,'
                    Exit

                EndIf

            Next nI

        EndIf

        If !Empty( cInsights )

            aAdd( aResponse, JsonObject():new() )
    
            aResponse[ len( aResponse ), 'equipment' ]        := AllTrim( (cAliasQry)->T9_CODBEM  )
            aResponse[ len( aResponse ), 'equipment_desc' ]   := AllTrim( (cAliasQry)->T9_NOME    )
            aResponse[ len( aResponse ), 'model' ]            := AllTrim( (cAliasQry)->T9_TIPMOD  )
            aResponse[ len( aResponse ), 'model_desc' ]       := AllTrim( (cAliasQry)->TQR_DESMOD )
            aResponse[ len( aResponse ), 'family' ]           := AllTrim( (cAliasQry)->T9_CODFAMI )
            aResponse[ len( aResponse ), 'family_desc' ]      := AllTrim( (cAliasQry)->T6_NOME    )
            aResponse[ len( aResponse ), 'cost_center' ]      := AllTrim( (cAliasQry)->T9_CCUSTO  )
            aResponse[ len( aResponse ), 'cost_center_desc' ] := AllTrim( (cAliasQry)->CTT_DESC01 )
            aResponse[ len( aResponse ), 'work_center' ]      := AllTrim( (cAliasQry)->T9_CENTRAB  )
            aResponse[ len( aResponse ), 'work_center_desc' ] := AllTrim( (cAliasQry)->HB_NOME )
            aResponse[ len( aResponse ), 'situation' ]        := AllTrim( (cAliasQry)->SITUATION  )
            aResponse[ len( aResponse ), 'insights' ]         := StrTokArr( AllTrim( cInsights ), ',' )
 
        EndIf

        ( cAliasQry )->( dbSkip() )
 
    End
 
    ( cAliasQry )->( dbCloseArea() )
 
    oResponse[ 'equipments' ] := aResponse
 
return { oResponse, 200 }
