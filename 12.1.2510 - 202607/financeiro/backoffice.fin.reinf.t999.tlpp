#include "msobject.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#Include "TOTVS.CH"

#define CODE_MOVEMENT_MIT '1'
#define CODE_MOVEMENT_REINF '2'

namespace totvs.protheus.backoffice.fin.taf.smartschedule

//-------------------------------------------------------------------
/*/{Protheus.doc} DataBlockT999
    Classe responsável por selecionar e montar Json do Bloco T999 (Registo de Exclusão)
    @author guilhermed.santos@totvs.com.br
    @since 08/05/2025
    @version 12.1.2410
*/
//-------------------------------------------------------------------
class DataBlockT999
    protected data cIdDoc as character
    protected data cIdFk2 as character
    protected data cMovType as character
    protected data cAliasFkh as character
    protected data jBlockT999 as json
    protected data lHasDataBlock as logical
    protected data oStatement as object

    public method new(cIdDoc as character, cIdFk2 as character, cMovType as character) as object
    public method loadT999Block()
    public method getHasDataBlock() as logical
    public method getT999Block() as json
    protected method setIdDoc(cIdDoc as character)
    protected method setIdFk2(cIdFk2 as character)
    protected method setMovType(cMovType as character)
    protected method getT999Data() as json
    protected method setHasDataBlock(lHasDataBlock as logical)
    protected method loadFkhStatement()
    protected method getChargebackId() as character
endClass


//-------------------------------------------------------------------
/*{Protheus.doc} new
    Construtor
    @return object: self
    @author guilhermed.santos
    @since 08/05/2025
    @version 12.1.2410
*/
//-------------------------------------------------------------------
method new(cIdDoc as character, cIdFk2 as character, cMovType as character) as object class DataBlockT999
        self:setIdDoc(cIdDoc)
        self:setIdFk2(cIdFk2)
        self:setMovType(cMovType)
        self:jBlockT999 := jsonObject():new()
        self:setHasDataBlock(.F.)
        self:oStatement := Nil
return self

//-------------------------------------------------------------------
/*{Protheus.doc} setIdDoc
    @description Define o conteúdo da propriedade cIdDoc.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 08/05/2025
    @return
*/
//-------------------------------------------------------------------
method setIdDoc(cIdDoc as character) class DataBlockT999
    self:cIdDoc := cIdDoc
return

//-------------------------------------------------------------------
/*{Protheus.doc} setIdFk2
    @description Define o conteúdo da propriedade cIdFk2.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 28/06/2025
    @return
*/
//-------------------------------------------------------------------
method setIdFk2(cIdFk2 as character) class DataBlockT999
    default cIdFk2 := ""    

    self:cIdFk2 := cIdFk2
return

//-------------------------------------------------------------------
/*{Protheus.doc} setMovType
    @description Define o conteúdo da propriedade cMovType.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 16/07/2025
    @return
*/
//-------------------------------------------------------------------
method setMovType(cMovType as character) class DataBlockT999
    default cMovType := ""    

    self:cMovType := cMovType
return

//-------------------------------------------------------------------
/*{Protheus.doc} loadT999Block
    @description Responsável por acionar os métodos de buscas de registros e montar o json na propriedade self:jBlockT999.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 08/05/2025
    @return
*/
//-------------------------------------------------------------------
method loadT999Block() class DataBlockT999
    self:jBlockT999 := self:getT999Data()
return

//-------------------------------------------------------------------
/*{Protheus.doc} getT999Block
    @description Retorna a propriedade self:jBlockT999.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 08/05/2025
    @return
*/
//-------------------------------------------------------------------
method getT999Block() as json class DataBlockT999
return self:jBlockT999

//-------------------------------------------------------------------
/*{Protheus.doc} getT999Data
    @description Montagem do Json do bloco T999.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 08/05/2025
    @return
*/
//-------------------------------------------------------------------
method getT999Data() as json class DataBlockT999
    local aBlockT999 := {} as array
    local aFkhId     := {} as array
    local jT999      := jsonObject():new() as json

    self:loadFkhStatement()

    while !(self:cAliasFkh)->(eof())
        aadd(aBlockT999, (self:cAliasFkh)->FKH_MSGTAF)
        aadd(aFkhId, {"LAYOUT":(self:cAliasFkh)->FKH_LAYOUT,;
                       "ID":(self:cAliasFkh)->FKH_ID})
        
        (self:cAliasFkh)->(dbSkip())
    endDo

    (self:cAliasFkh)->(DbCloseArea())
        
    if len(aBlockT999) > 0
        jT999["REG_CHV"] := aBlockT999
        jT999["FKH_ID"]  := aFkhId
        self:setHasDataBlock(.T.)
    elseIf self:cMovType == CODE_MOVEMENT_MIT .and. !empty(self:cIdDoc)
        aadd(aFkhId, {"LAYOUT":'T999  ',;
                       "ID":self:cIdDoc})
                       
        jT999["REG_CHV"] := {'MIT|' + self:cIdDoc}
        jT999["FKH_ID"]  := aFkhId
        self:setHasDataBlock(.T.)
    endIf

return jT999

//-------------------------------------------------------------------
/*{Protheus.doc} setHasDataBlock
    @description Define o conteúdo da propriedade self:lHasDataBlock.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 08/05/2025
    @return
*/
//-------------------------------------------------------------------
method setHasDataBlock(lHasDataBlock) class DataBlockT999
    self:lHasDataBlock := lHasDataBlock
return

//-------------------------------------------------------------------
/*{Protheus.doc} getHasDataBlock
    @description Retorna o conteúdo da propriedade self:lHasDataBlock.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 08/05/2025
    @return
*/
//-------------------------------------------------------------------
method getHasDataBlock() as logical class DataBlockT999
return self:lHasDataBlock

//-------------------------------------------------------------------
/*{Protheus.doc} loadFkhStatement
    @description Monta e executa query da FKH.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 08/05/2025
    @return
*/
//-------------------------------------------------------------------
method loadFkhStatement()class DataBlockT999
    local aTabOri       := {} as array
	local cQuery	    := "" as character
    local cBDname	    := "" as character
    local nParamOrder   := 1  as numeric
    local cIdMov        := self:cIdDoc as character

    if !empty(self:cIdFk2)
        cIdMov := self:getChargebackId()
    endIf

    cBDname := upper(tcGetDb())
    aTabOri := {'SE1','SE2','FK1','FK2'}

    if self:oStatement == NIL
        cQuery	:= " SELECT "
        if cBDname $ "ORACLE"
			cQuery	+= " CAST( FKH.FKH_MSGTAF AS VARCHAR2(100) ) FKH_MSGTAF "
		elseIf cBDname $ "POSTGRES"
			cQuery	+= " LEFT(ENCODE(FKH.FKH_MSGTAF, 'ESCAPE'),-4) FKH_MSGTAF "
		else
			cQuery	+= " CONVERT(VARCHAR(100), FKH.FKH_MSGTAF) FKH_MSGTAF "
		endIf
        cQuery	+= " , FKH_LAYOUT, FKH_ID "
        cQuery	+= " FROM " + retSqlName("FKH") + " FKH "
        cQuery	+= " WHERE FKH.FKH_FILIAL = ? "
        cQuery	+= "    AND FKH.FKH_TABORI IN (?) "
        cQuery	+= "    AND FKH.FKH_IDMOV = ? "
        cQuery	+= "    AND FKH.FKH_LAYOUT = ? "
        cQuery	+= "    AND FKH.D_E_L_E_T_ = ?  "

        cQuery := ChangeQuery(cQuery)
        self:oStatement := FWExecStatement():New(cQuery)
    endIf

    self:oStatement:SetString( nParamOrder++, xFilial("FKH"))
    self:oStatement:SetIn( nParamOrder++, aTabOri)
    self:oStatement:setString( nParamOrder++, cIdMov )
    self:oStatement:setString( nParamOrder++, "T999  " )
    self:oStatement:setString( nParamOrder++, " " )    

    self:cAliasFkh := self:oStatement:openAlias()
return


//-------------------------------------------------------------------
/*{Protheus.doc} getChargebackId
    @description Busca o IDFK2 do estorno, partindo do IDFK2 da baixa.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 28/06/2025
    @return
*/
//-------------------------------------------------------------------
method getChargebackId() as character class DataBlockT999
    local cQuery	    := "" as character
    local cChargebackId := "" as character
    local nParamOrder   := 1  as numeric
    local oStatement    := Nil as object


    cQuery	:= " SELECT FK2EST.FK2_IDFK2 CHARGEBACK_ID FROM " + retSqlName("FK2") + " FK2BX "
    cQuery	+= "     INNER JOIN " + retSqlName("FK2") + " FK2EST "
    cQuery	+= "         ON FK2EST.FK2_FILIAL = FK2BX.FK2_FILIAL "
    cQuery	+= "         AND FK2EST.FK2_IDDOC = FK2BX.FK2_IDDOC "
    cQuery	+= "         AND FK2EST.FK2_SEQ = FK2BX.FK2_SEQ "
    cQuery	+= "         AND FK2EST.FK2_TPDOC = ? "
    cQuery	+= "         AND FK2EST.D_E_L_E_T_ = ? "
    cQuery	+= " WHERE FK2BX.FK2_FILIAL = ? "
    cQuery	+= " AND FK2BX.FK2_IDFK2 = ? "
    cQuery	+= " AND FK2BX.FK2_IDDOC = ? "
    cQuery	+= " AND FK2BX.D_E_L_E_T_ = ? "
    
    
    cQuery := ChangeQuery(cQuery)
    oStatement := FWExecStatement():New(cQuery)

    oStatement:setString( nParamOrder++, "ES" )
    oStatement:setString( nParamOrder++, " " )
    oStatement:SetString( nParamOrder++, xFilial("FK2"))
    oStatement:setString( nParamOrder++, self:cIdFk2 )
    oStatement:setString( nParamOrder++, self:cIdDoc )
    oStatement:setString( nParamOrder++, " " )

    cChargebackId := oStatement:execScalar("CHARGEBACK_ID")

return cChargebackId
