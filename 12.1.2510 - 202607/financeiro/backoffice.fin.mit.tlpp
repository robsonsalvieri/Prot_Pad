#include "msobject.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#Include "TOTVS.CH"

namespace totvs.protheus.backoffice.fin.taf.smartschedule

//-------------------------------------------------------------------
/*/{Protheus.doc} DataBlockMIT
    Classe responsável por selecionar e montar Json do Bloco MIT (Registo de Exclusão)
    @author guilhermed.santos@totvs.com.br
    @since 04/06/2025
    @version 12.1.2410
*/
//-------------------------------------------------------------------
class DataBlockMIT
    protected data cIdDoc           as character
    protected data cTaxIdDoc           as character
    protected data cAliasQuery      as character
    protected data cAliasFKG        as character
    protected data cAliasCCF        as character
    protected data jBlockMIT        as json
    protected data lHasDataBlock    as logical
    protected data oStatement       as object
    protected data oStatementFKG    as object
    protected data oStatementCCF    as object
    protected data oParentTitle     as object

    public method new(cIdDoc as character, cTaxIdDoc as character) as object
    public method loadMITBlock()
    public method getHasDataBlock() as logical
    public method getMITBlock() as json
    protected method setIdDoc(cIdDoc as character)
    protected method setTaxIdDoc(cIdDoc as character)
    protected method getMITData() as json
    protected method setHasDataBlock(lHasDataBlock as logical)
    protected method loadMitStatement()
    protected method loadFKGStatement()
    protected method loadCCFStatement(cProcessNumber as character, cProcessType as character)
    protected method getTaxCode() as character
    protected method isGroupedPccTax() as logical
    protected method loadParentTitleStatement()
    protected method isIrGeneratedOnPayment() as logical
endClass


//-------------------------------------------------------------------
/*{Protheus.doc} new
    Construtor
    @return object: self
    @author guilhermed.santos
    @since 04/06/2025
    @version 12.1.2410
*/
//-------------------------------------------------------------------
method new(cIdDoc as character, cTaxIdDoc as character) as object class DataBlockMIT
        self:setIdDoc(cIdDoc)
        self:setTaxIdDoc(cTaxIdDoc)
        self:setHasDataBlock(.F.)
        self:jBlockMIT      := jsonObject():new()
        self:oStatement     := Nil
        self:oStatementFKG  := Nil
        self:oStatementCCF  := Nil
        self:cAliasQuery    := ""
        self:cAliasFKG      := ""
        self:cAliasCCF      := ""        
return self

//-------------------------------------------------------------------
/*{Protheus.doc} setIdDoc
    @description Define o conteúdo da propriedade cIdDoc.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 04/06/2025
    @return
*/
//-------------------------------------------------------------------
method setIdDoc(cIdDoc as character) class DataBlockMIT
    self:cIdDoc := cIdDoc
return

//-------------------------------------------------------------------
/*{Protheus.doc} setTaxIdDoc
    @description Define o conteúdo da propriedade self:cTaxIdDoc.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 09/06/2025
    @return
*/
//-------------------------------------------------------------------
method setTaxIdDoc(cIdDoc as character) class DataBlockMIT
    self:cTaxIdDoc := cIdDoc
return

//-------------------------------------------------------------------
/*{Protheus.doc} loadMITBlock
    @description Responsável por acionar os métodos de buscas de registros e montar o json na propriedade self:jBlockMIT.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 04/06/2025
    @return
*/
//-------------------------------------------------------------------
method loadMITBlock() class DataBlockMIT
    self:jBlockMIT := self:getMITData()
return


//-------------------------------------------------------------------
/*{Protheus.doc} getMITBlock
    @description Retorna a propriedade self:jBlockMIT.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 04/06/2025
    @return
*/
//-------------------------------------------------------------------
method getMITBlock() as json class DataBlockMIT
return self:jBlockMIT

//-------------------------------------------------------------------
/*{Protheus.doc} getMITData
    @description Montagem do Json do bloco MIT.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 04/06/2025
    @return
*/
//-------------------------------------------------------------------
method getMITData() as json class DataBlockMIT
    local aJudicialSuspension   := {} as array
    local jMITDataBlock         := jsonObject():new() as json
    local jAuxiliaryJson        := jsonObject():new() as json
    local dIssueDate            := date() as date
    local cCalculationPeriod    := "" as character
    local cTaxCode              := "" as character

    self:loadMitStatement()

    if !(self:cAliasQuery)->(eof())
        if !empty((self:cAliasQuery)->E2_EMISSAO)
            dIssueDate := sToD((self:cAliasQuery)->E2_EMISSAO)
        endIf

        cTaxCode := self:getTaxCode()

        cCalculationPeriod := strZero(month(dIssueDate),2) + strZero(year(dIssueDate),4)

        jAuxiliaryJson["IDTRIB"]   :=  cTaxCode
        jAuxiliaryJson["UF"]       :=  (self:cAliasQuery)->A2_EST
        jAuxiliaryJson["CNPINC"]   :=  (self:cAliasQuery)->FKF_CGCSCP
        jAuxiliaryJson["FILORIG"]  :=  (self:cAliasQuery)->E2_FILIAL
        jAuxiliaryJson["PERAPU"]   :=  cCalculationPeriod
        jAuxiliaryJson["CODREC"]   :=  (self:cAliasQuery)->(E2_CODRET) + alltrim(str((self:cAliasQuery)->(E2_VARIAC)))
        jAuxiliaryJson["CODMUN"]   :=  (self:cAliasQuery)->A2_COD_MUN
        jAuxiliaryJson["PERIOD"]   :=  (self:cAliasQuery)->E2_PERIOD
        jAuxiliaryJson["VALTRIB"]  :=  (self:cAliasQuery)->E2_VALOR
        jAuxiliaryJson["DTDEBITO"] :=  dIssueDate

        self:loadFKGStatement()

        while !(self:cAliasFKG)->(eof())
            self:loadCCFStatement((self:cAliasFKG)->FKG_NUMPRO,(self:cAliasFKG)->FKG_TPPROC)

            if !(self:cAliasCCF)->(eof())
                aadd(aJudicialSuspension,{"IDSUSP"  : (self:cAliasFKG)->FKG_CODSUS,;
                                            "IDPROC"    : (self:cAliasCCF)->CCF_NUMERO,;
                                            "TERCEIR"   : (self:cAliasCCF)->CCF_INDAUT,;
                                            "VALSUS"    : (self:cAliasFKG)->FKG_VALOR})
            endIf

            (self:cAliasFKG)->(dbSkip())
        endDo

        if len(aJudicialSuspension) > 0
            jAuxiliaryJson["SUSPJUD"] := aJudicialSuspension
            aJudicialSuspension := {}
        endIf
    endif
    
    if len(jAuxiliaryJson:getNames()) > 0
        jMITDataBlock["T1A"] := jAuxiliaryJson
        self:setHasDataBlock(.T.)
    endIf

return jMITDataBlock

//-------------------------------------------------------------------
/*{Protheus.doc} setHasDataBlock
    @description Define o conteúdo da propriedade self:lHasDataBlock.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 04/06/2025
    @return
*/
//-------------------------------------------------------------------
method setHasDataBlock(lHasDataBlock) class DataBlockMIT
    self:lHasDataBlock := lHasDataBlock
return

//-------------------------------------------------------------------
/*{Protheus.doc} getHasDataBlock
