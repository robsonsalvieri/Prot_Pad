    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 04/06/2025
    @return
*/
//-------------------------------------------------------------------
method getHasDataBlock() as logical class DataBlockMIT
return self:lHasDataBlock

//-------------------------------------------------------------------
/*{Protheus.doc} loadMitStatement
    @description Monta e executa query para buscar dados da FK7, SE2, SA2, FKF a partir do IDDOC.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 04/06/2025
    @return
*/
//-------------------------------------------------------------------
method loadMitStatement() class DataBlockMIT
    local cQuery := "" as character
    local nParamOrder   := 1  as numeric

    if self:oStatement == Nil
        cQuery := " SELECT E2_FILIAL, E2_EMISSAO, E2_VALOR, E2_CODRET, E2_VARIAC, E2_PERIOD, E2_NATUREZ, "
        cQuery += " A2_EST, A2_COD_MUN, A2_CALCIRF, "
        cQuery += " FKF_CGCSCP "
        cQuery += " FROM " + retSqlName("FK7") + " FK7 "
        cQuery += "     INNER JOIN " + retSqlName("SE2") + " SE2 "
        cQuery += "         ON " + FWJoinFilial("SE2", "FK7")
        cQuery += "         AND SE2.E2_PREFIXO = FK7.FK7_PREFIX "
        cQuery += "         AND SE2.E2_NUM = FK7.FK7_NUM "
        cQuery += "         AND SE2.E2_PARCELA = FK7.FK7_PARCEL "
        cQuery += "         AND SE2.E2_TIPO = FK7.FK7_TIPO "
        cQuery += "         AND SE2.E2_FORNECE = FK7.FK7_CLIFOR "
        cQuery += "         AND SE2.E2_LOJA = FK7.FK7_LOJA "
        cQuery += "         AND SE2.D_E_L_E_T_ = ? "
        cQuery += "     INNER JOIN " + retSqlName("SA2") + " SA2 "
        cQuery += "         ON A2_FILIAL = ? "
        cQuery += "         AND SA2.A2_COD = SE2.E2_FORNECE "
        cQuery += "         AND SA2.A2_LOJA = SE2.E2_LOJA "
        cQuery += "         AND SA2.D_E_L_E_T_ = ? "
        cQuery += "     LEFT JOIN " + retSqlName("FKF") + " FKF "
        cQuery += "         ON " + FWJoinFilial("FKF", "FK7")
        cQuery += "         AND FKF.FKF_IDDOC = ? "
        cQuery += "         AND FKF.D_E_L_E_T_ = ? "
        cQuery += " WHERE FK7.FK7_IDDOC = ? "
        cQuery += " AND FK7.FK7_ALIAS = ? "
        cQuery += " AND FK7.D_E_L_E_T_ = ? "

        cQuery := ChangeQuery(cQuery)

        self:oStatement := FWExecStatement():New(cQuery)
    endIf

    self:oStatement:setString( nParamOrder++, " " )
    self:oStatement:setString( nParamOrder++, xFilial("SA2") )
    self:oStatement:setString( nParamOrder++, " " )
    self:oStatement:setString( nParamOrder++, self:cIdDoc )
    self:oStatement:setString( nParamOrder++, " " )
    self:oStatement:setString( nParamOrder++, self:cTaxIdDoc )
    self:oStatement:setString( nParamOrder++, "SE2" )
    self:oStatement:setString( nParamOrder++, " " )

    self:cAliasQuery := self:oStatement:openAlias()
return


//-------------------------------------------------------------------
/*{Protheus.doc} loadFKGStatement
    @description Monta e executa query para buscar os registros na FKG relacionado com o IDDOC.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 04/06/2025
    @return
*/
//-------------------------------------------------------------------
method loadFKGStatement() class DataBlockMIT
    local cQuery        := "" as character
    local nParamOrder   := 1  as numeric

    if self:oStatementFKG == Nil
        cQuery := "SELECT FKG_NUMPRO, FKG_TPPROC, FKG_CODSUS, FKG_VALOR FROM " + retSqlName("FKG") + " FKG "
        cQuery += " WHERE FKG_FILIAL = ? "
        cQuery += " AND FKG_IDDOC = ? "
        cQuery += " AND FKG_TPIMP IN (?) "
        cQuery += " AND FKG_TPATRB = ? "
        cQuery += " AND D_E_L_E_T_ = ? "
        cQuery += " GROUP BY FKG_NUMPRO, FKG_TPPROC, FKG_CODSUS, FKG_VALOR "

        cQuery := ChangeQuery(cQuery)

        self:oStatementFKG := FWExecStatement():New(cQuery)
    endIf

    self:oStatementFKG:setString( nParamOrder++, xFilial("FKG") )
    self:oStatementFKG:setString( nParamOrder++, self:cIdDoc )
    self:oStatementFKG:SetIn( nParamOrder++, {"INSS","IRF","PIS","COF","CSL"} )
    self:oStatementFKG:setString( nParamOrder++, '004' )
    self:oStatementFKG:setString( nParamOrder++, " " )

    self:cAliasFKG := self:oStatementFKG:openAlias()
return


//-------------------------------------------------------------------
/*{Protheus.doc} loadCCFStatement
    @description Monta e executa a query para buscar os registros na CCF relacionado ao número e tipo de processo encontrado na FKG.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 04/06/2025
    @return
*/
//-------------------------------------------------------------------
method loadCCFStatement(cProcessNumber as character, cProcessType as character) class DataBlockMIT
    local cQuery        := "" as character
    local nParamOrder   := 1  as numeric

    if self:oStatementCCF == Nil
        cQuery := "SELECT CCF_NUMERO, CCF_INDAUT FROM " + retSqlName("CCF") + " CCF "
        cQuery += " WHERE CCF_FILIAL = ? "
        cQuery += " AND CCF_NUMERO = ? "
        cQuery += " AND CCF_TIPO = ? "
        cQuery += " AND D_E_L_E_T_ = ? "

        cQuery := ChangeQuery(cQuery)

        self:oStatementCCF := FWExecStatement():New(cQuery)
    endIf

    self:oStatementCCF:setString( nParamOrder++, xFilial("CCF") )
    self:oStatementCCF:setString( nParamOrder++, cProcessNumber)
    self:oStatementCCF:setString( nParamOrder++, cProcessType)
    self:oStatementCCF:setString( nParamOrder++, " " )

    self:cAliasCCF := self:oStatementCCF:openAlias()
return

//-------------------------------------------------------------------
/*{Protheus.doc} getTaxCode
    @description Retorna o código do imposto utilizado pelo TAF (tabela C3S) de acordo com o título de imposto posicionado.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 09/06/2025
    @return
*/
//-------------------------------------------------------------------
method getTaxCode() as character class DataBlockMIT
    local cPisTax    := alltrim(superGetMv("MV_PISNAT", .F., "PIS"))    as character
    local cCofinsTax := alltrim(superGetMv("MV_COFINS", .F., "COFINS")) as character
    local cCsllTax   := alltrim(superGetMv("MV_CSLL", .F., "CSLL"))     as character
    local cIrfTax   := alltrim(superGetMv("MV_IRF", .F., "IRF"))     as character
    local cCideTax   := alltrim(superGetMv("MV_CIDE", .F., "CIDE"))     as character
    local cClassCode := alltrim((self:cAliasQuery)->E2_NATUREZ) as character
    local cTaxCode   := "" as character

    do case
        case cClassCode $ cPisTax
            cTaxCode := "10"
            if self:isGroupedPccTax()
                cTaxCode := "29"
            endIf
        case cClassCode $ cCofinsTax
            cTaxCode := "11"
        case cClassCode $ cCsllTax
            cTaxCode := "18"
        case cClassCode $ cIrfTax
                cTaxCode := "12"
            if self:isIrGeneratedOnPayment()
                cTaxCode := "28"
            endIf
        case cClassCode $ cCideTax
            cTaxCode := "99"
    endCase

return cTaxCode

//-------------------------------------------------------------------
/*{Protheus.doc} isGroupedPccTax
    @description Verifica se houve agrupamento de PCC do título pai
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 10/06/2025
    @return
*/
//-------------------------------------------------------------------
method isGroupedPccTax() as logical class DataBlockMIT
    local lGroupedPccTax := .F. as logical
    local cParentAlias   := "" as character
    local lX6Ag10925     := superGetMv("MV_AG10925", .F., "2") == "1"

    self:loadParentTitleStatement()
    cParentAlias := self:oParentTitle:openAlias()
    
    lGroupedPccTax := lX6Ag10925 .and. (self:cAliasQuery)->E2_CODRET == "5952" .and. (cParentAlias)->E2_PIS > 0 .and. (cParentAlias)->E2_COFINS > 0 .and. (cParentAlias)->E2_CSLL > 0

return lGroupedPccTax

//-------------------------------------------------------------------
/*{Protheus.doc} loadParentTitleStatement
    @description Monta e executa query para buscar dados da SE2 do título pai a partir do IDDOC.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 04/06/2025
    @return
*/
//-------------------------------------------------------------------
method loadParentTitleStatement() class DataBlockMIT
    local cQuery := "" as character
    local nParamOrder   := 1  as numeric

    if self:oParentTitle == Nil
        cQuery := " SELECT E2_CODRET, E2_PIS, E2_COFINS, E2_CSLL "
        cQuery += " FROM " + retSqlName("FK7") + " FK7 "
        cQuery += "     INNER JOIN " + retSqlName("SE2") + " SE2 "
        cQuery += "         ON " + FWJoinFilial("SE2", "FK7")
        cQuery += "         AND SE2.E2_PREFIXO = FK7.FK7_PREFIX "
        cQuery += "         AND SE2.E2_NUM = FK7.FK7_NUM "
        cQuery += "         AND SE2.E2_PARCELA = FK7.FK7_PARCEL "
        cQuery += "         AND SE2.E2_TIPO = FK7.FK7_TIPO "
        cQuery += "         AND SE2.E2_FORNECE = FK7.FK7_CLIFOR "
        cQuery += "         AND SE2.E2_LOJA = FK7.FK7_LOJA "
        cQuery += "         AND SE2.D_E_L_E_T_ = ? "
        cQuery += " WHERE FK7.FK7_IDDOC = ? "
        cQuery += " AND FK7.FK7_ALIAS = ? "
        cQuery += " AND FK7.D_E_L_E_T_ = ? "

        cQuery := ChangeQuery(cQuery)

        self:oParentTitle := FWExecStatement():New(cQuery)
    endIf

    self:oParentTitle:setString( nParamOrder++, " " )
    self:oParentTitle:setString( nParamOrder++, self:cIdDoc )
    self:oParentTitle:setString( nParamOrder++, "SE2" )
    self:oParentTitle:setString( nParamOrder++, " " )
return

//-------------------------------------------------------------------
/*{Protheus.doc} isIrGeneratedOnPayment
    @description Verifica se o IR é gerado no pagamento do título.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 20/08/2025
    @return
*/
//-------------------------------------------------------------------
method isIrGeneratedOnPayment() as logical class DataBlockMIT
    local aArea     := {} as array
    local aAreaFK7  := {} as array
    local aAreaSA2  := {} as array
    local lIrGeneratedOnPayment := .F. as logical

    aArea    := FwGetArea()
    aAreaFK7 := FK7->(FwGetArea())

    dbSelectArea('FK7')
    dbSetOrder(5) //FK7_IDDOC
    if FK7->(dbSeek(self:cIdDoc))
        aAreaSA2 := SA2->(FwGetArea())
        dbSelectArea('SA2')
        dbSetOrder(1) //A2_FILIAL+A2_COD+A2_LOJA
        if SA2->(dbSeek(xfilial("SA2") + FK7->FK7_CLIFOR + FK7->FK7_LOJA))
            lIrGeneratedOnPayment := SA2->A2_CALCIRF == '2'
        endIf
        FwRestArea(aAreaSA2)
        FwFreeArray(aAreaSA2)
    endIf
        
    FwRestArea(aAreaFK7)
    FwRestArea(aArea)
    FwFreeArray(aAreaFK7)
    FwFreeArray(aArea)

return lIrGeneratedOnPayment
