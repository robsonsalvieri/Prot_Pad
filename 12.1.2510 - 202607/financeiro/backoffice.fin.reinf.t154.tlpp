#include "msobject.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "totvs.ch"

#define PAYABLE_PORTFOLIO_CODE 1
#define RECEIVABLE_PORTFOLIO_CODE 2
#define CLASS_PAYABLE '0'
#define CLASS_RECEIVABLE '1'
#define ACCOUNTING_DATE '1'
#define ISSUE_DATE '2'
#define WRITE_OFF_DATE '2'
#define DATE_OF_AVAILABILITY '3'
#define APPLICATION_ON_BASE '1'
#define APPLICATION_ON_VALUE '2'
#define DEDUCTION '1'

#define MATERIAL '001'
#define FOOD '002'
#define TRANSPORT '003'
#define LEGAL_PROCESS '004'
#define SUBCONTRACTOR '005'
#define SPECIAL_RETIREMENT_15_YEARS '007'
#define SPECIAL_RETIREMENT_20_YEARS '008'
#define SPECIAL_RETIREMENT_25_YEARS '009'
#define NORMAL_RETIREMENT '1'
#define SPECIAL_RETIREMENT '2'
#define INSS_TAX_CODE '13'

#define PRIVATE_PENSION '010'
#define FAPI '011'
#define FUNPRESP '012'
#define ALIMONY '013'
#define DEPENDENTS '024'

#define OTHERS '006'
#define TAX_EXEMPT_AGE_65_PLUS '015'
#define TRAVEL_ALLOWANCE '016'
#define CONTRACT_TERMINATION_COMPENSATION '017'
#define CASH_BONUS '018'
#define PAYMENT_TO_MICROENTERPRISE_PARTNER '019'
#define RETIREMENT_DUE_TO_SERIOUS_ILLNESS '020'
#define PENSION_SUPPLEMENT_CONTRIBUTIONS '021'
#define EXPENSE_ALLOWANCE '022'
#define LATE_PAYMENT_INTEREST '025'
#define PENSION_WITHDRAWAL_SERIOUS_ILLNESS '026'
#define OTHERS_TECHIICAL_NOTE '027'

#define TITLE_FROM_INVOICE '1'
#define STANDALONE_TITLE '3'

namespace totvs.protheus.backoffice.fin.taf.smartschedule

//-------------------------------------------------------------------
/*/{Protheus.doc} DataBlockT154
    Classe responsável por selecionar e montar Json do Bloco T154 (Cadastro de Participantes (Fornecedores e Clientes))
    @author guilhermed.santos@totvs.com.br
    @since 15/04/2025
    @version 12.1.2410
*/
//-------------------------------------------------------------------
class DataBlockT154
    protected data cIdDoc as character
    protected data jBlockT154 as json
    protected data lHasDataBlock as logical
    protected data oDHTStatement as object
    protected data oIRSimpStatement as object
    protected data oFKWStatement as object
    protected data oFirstDedStatement as object
    protected data cPortfolioAlias as character
    protected data cInstallmentAlias as character
    protected data cT154ACAlias as character
    protected data jFKGData as json
    protected data lRetentionSuspension as logical
    protected data jDeductionType as json
    protected data jExemptionsType as json
    protected data cSupplierID as character
    protected data lIssinPayment as logical
    protected data lPCCinPayment as logical
    protected data lCpfFkj  as logical
    protected data lHasT154AC  as logical
    protected data aT154ACBlock  as array
    protected data lBillsReceivable as logical
    protected data lIRTaxInPayment as logical
    protected data lIRTaxAggregated as logical
    protected data cSettlementDisplayMode as character
    protected data cIssueDateParameter as character
    protected data aInstallmentsId as array
    protected data nIrTaxPercentage as numeric
    protected data lPccMR   as logical
    protected data lIrfMR   as logical
    protected data lIssMR   as logical
    protected data lIrfBxMR as logical
    protected data lPccBxMR as logical
    protected data lIssBxMR as logical

    public method new(cIdDoc as character) as object
    public method loadT154Block()
    public method getHasDataBlock() as logical
    public method getT154Block() as json
    protected method setIdDoc(cIdDoc as character)
    protected method getT154Data() as json
    protected method getReceivablesPortfolioData() as json
    protected method getPayablesPortfolioData() as json
    protected method setHasDataBlock(lHasDataBlock as logical)
    protected method getHasT154ACData(cIdDocParc as character) as logical
    protected method loadFKGData()
    protected method getT154AFBlock(aLegalProcess as array, lRetentionSusp as logical) as array
    protected method getT154ABBlock(nInstallmentValue as numeric) as array
    protected method loadReceivableStatement()
    protected method loadPayableStatement()
    protected method validateTaxReliefs(aDedDetail as array, aExemptionDetail as array, dGenerationDate as date, lSusp as logical, nSimpDed as numeric, lSimpDed as logical)
    protected method loadTaxReliefs()
    protected method loadDependentsOnAlimony(cTipDed as character, lSusp as logical) as array
    protected method loadIRSimplified(dInitDate as date, dFinalDate as date) as numeric
    protected method isFirstDeduction(dData as date) as logical
    protected method getDepDedussionValue(dData as date, nNumOfDep as numeric) as numeric
    protected method isTaxesOnEmission(aT154Trb as array, lIndividualSupp as logical, dEmisDate as date, lSusp as logical, nSimpDed as numeric, lSimpDed as logical ) as logical
    protected method validateWithoutTaxes(cIncomeNature as character) as logical
    protected method loadSupplierID()
    protected method getInstallmentValue() as numeric
    protected method loadT154ACData(cIdDocParc as character)
    protected method loadT154ACPayableStatement(cIdDocParc as character)
    protected method loadT154ACReceivableStatement()
    protected method getT154ACBlock() as array
    protected method loadParameters()
    protected method loadPayableInstallments()
    protected method loadReceivableInstallments()
    protected method destroyStatementObjects()
    protected method destroyAliasTemporary()
    protected method loadIRTaxInPayment()
	protected method getTaxesFromIdDoc() as json
    protected method loadTaxesConfigurations()
endClass

//-------------------------------------------------------------------
/*{Protheus.doc} new
    Construtor
    @return object: self
    @author guilhermed.santos
    @since 15/04/2025
    @version 12.1.2410
*/
//-------------------------------------------------------------------
method new(cIdDoc as character) as object class DataBlockT154
        self:setIdDoc(cIdDoc)
        self:jBlockT154 := jsonObject():new()
        self:jFKGData   := jsonObject():new()
        self:jDeductionType := jsonObject():new()
        self:jExemptionsType := jsonObject():new()
        self:cPortfolioAlias := ""
        self:cInstallmentAlias := ""
        self:cT154ACAlias := ""
        self:lRetentionSuspension := .F.
        self:oDHTStatement := Nil
        self:oIRSimpStatement := Nil
        self:oFKWStatement := Nil
        self:oFirstDedStatement := Nil
        self:loadTaxReliefs()
        self:setHasDataBlock(.F.)
        self:cSupplierID := ""
        self:lIssinPayment := IsIssBx("P")
        self:lPCCinPayment := SuperGetMv("MV_BX10925",.F.,"2") == "1"
        self:lCpfFkj := .F.
        self:lHasT154AC := .F.
        self:aT154ACBlock := {}
        self:aInstallmentsId := {}
        self:lBillsReceivable := .F.
        self:lIRTaxInPayment := .F.
        self:lIRTaxAggregated := .F.
        self:cSettlementDisplayMode := "1"
        self:cIssueDateParameter := "1"
        self:nIrTaxPercentage := 1
return self

//-------------------------------------------------------------------
/*{Protheus.doc} setIdDoc
    @description Define o conteúdo da propriedade cIdDoc.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 17/04/2025
    @return
*/
//-------------------------------------------------------------------
method setIdDoc(cIdDoc as character) class DataBlockT154
    self:cIdDoc := cIdDoc
return

//-------------------------------------------------------------------
/*{Protheus.doc} loadT154Block
    @description Responsável por acionar os métodos de buscas de registros e montar o json na propriedade self:jBlockT154.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 10/04/2025
    @return
*/
//-------------------------------------------------------------------
method loadT154Block() class DataBlockT154
    local aArea         := {} as array
    local aAreaFK7      := {} as array

    aArea    := getArea()
    aAreaFK7 := FK7->(getArea())
    
    dbSelectArea('FK7')
    FK7->(dbSetOrder(5)) //FK7_IDDOC
    if FK7->(dbSeek(self:cIdDoc))
        self:lBillsReceivable := FK7->FK7_ALIAS == 'SE1'
        self:loadFKGData()
        self:jBlockT154 := self:getT154Data()
    endIf
    
    if self:jBlockT154:hasProperty("T154")
        self:setHasDataBlock(.T.)
    endIf

    self:destroyStatementObjects()
    self:destroyAliasTemporary()

    restArea(aAreaFK7)
    restArea(aArea)
    fwFreeArray(aAreaFK7)
    fwFreeArray(aArea)
return

//-------------------------------------------------------------------
/*{Protheus.doc} getT154Block
    @description Retorna a propriedade self:jBlockT154.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 10/04/2025
    @return
*/
//-------------------------------------------------------------------
method getT154Block() as json class DataBlockT154
return self:jBlockT154

//-------------------------------------------------------------------
/*{Protheus.doc} getT154Data
    @description Montagem do Json do bloco T154.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 10/04/2025
    @return
*/
//-------------------------------------------------------------------
method getT154Data() as json class DataBlockT154
    local jT154 := jsonObject():new() as json

    self:loadParameters()

    if self:lBillsReceivable        
        jT154 := self:getReceivablesPortfolioData()
    else
        jT154 := self:getPayablesPortfolioData()
    endIf
    
return jT154

//-------------------------------------------------------------------
/*{Protheus.doc} getReceivablesPortfolioData
    @description Seleciona e retorna dados do Contas a Receber para compor o bloco T154.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 10/04/2025
    @return
*/
//-------------------------------------------------------------------
method getReceivablesPortfolioData() as json class DataBlockT154
    local jReceivablesPortfolio := jsonObject():new() as json
    local aArea             := {} as array
    local aBlockT154        := {} as array
    local aBlockT154AA      := {} as array
    local aBlockT154AB      := {} as array
    local aBlockT154AF      := {} as array
    local aLegalProcess     := {} as array
    local cBillNumber       := "" as character
    local cInvoiceNumber    := "" as character
    local cInvoiceSeries    := "" as character
    local cCustomer         := "" as character
    local cUnit             := "" as character
    local cInvoiceType      := "" as character
    local cTransferType     := "" as character
    local cServiceType      := "" as character
    local cTransferDescr    := "" as character
    local cReceiptType      := STANDALONE_TITLE as character
    local dIssueDate        := dDataBase as date
    local nGrossAmount      := 0 as numeric
    local nTransfGrsAmt     := 0 as numeric
    local nTransfRetAmt     := 0 as numeric
    local nRetentionAmount  := 0 as numeric
    local nINSSBaseValue    := 0 as numeric
    local nInstallmentValue := 0 as numeric
    local nCounter          := 1 as numeric
    local nFTSerieSize      := tamSx3("FT_SERIE")[1] as numeric
    local nFTDocSize        := tamSx3("FT_NFISCAL")[1] as numeric

    aLegalProcess := self:jFKGData['LEGAL_PROCESS']
    
    aArea    := getArea()

    self:loadReceivableStatement()

    if (self:cPortfolioAlias)->(eof())
        return jReceivablesPortfolio
    endIf
        
    if !empty((self:cPortfolioAlias)->FKF_TPREPA)
        cTransferType := (self:cPortfolioAlias)->FKF_TPREPA
    endIf
    
    if !empty((self:cPortfolioAlias)->FKF_TPSERV)
        cServiceType  := "1" + padl((self:cPortfolioAlias)->FKF_TPSERV, 8 ,"0")
    endIf

    cCustomer       := alltrim((self:cPortfolioAlias)->E1_CLIENTE)
    cUnit           := alltrim((self:cPortfolioAlias)->E1_LOJA)
    cBillNumber     := alltrim((self:cPortfolioAlias)->E1_NUM)

    if self:cIssueDateParameter == ACCOUNTING_DATE
        dIssueDate  := stod((self:cPortfolioAlias)->E1_EMIS1)
    else
        dIssueDate  := stod((self:cPortfolioAlias)->E1_EMISSAO)
    endIf

    if alltrim((self:cPortfolioAlias)->E1_ORIGEM) $ "MATA461|MATA460|MATA103|MATA100"
        cInvoiceNumber  := padr(alltrim((self:cPortfolioAlias)->E1_NUM), nFTDocSize)
        cInvoiceSeries  := padr(alltrim((self:cPortfolioAlias)->E1_SERIE), nFTSerieSize)


        if FTemSFT(RECEIVABLE_PORTFOLIO_CODE, cInvoiceNumber, @cInvoiceSeries, cCustomer, cUnit)

            cInvoiceType := AModNot( SFT->FT_ESPECIE )

            if empty(cInvoiceType)
                cInvoiceType := "01"
            endIf

            cReceiptType := TITLE_FROM_INVOICE
            dIssueDate := SFT->FT_EMISSAO            
            nGrossAmount := 0
            
            while SFT->(!Eof()) .and. SFT->(FT_FILIAL+FT_TIPOMOV+FT_SERIE+FT_NFISCAL+FT_CLIEFOR+FT_LOJA) ==  (xFilial("SFT") + "S" +  cInvoiceSeries + cInvoiceNumber + (self:cPortfolioAlias)->E1_CLIENTE + (self:cPortfolioAlias)->E1_LOJA)
                nGrossAmount += SFT->FT_VALCONT
                SFT->(dbSkip())
            endDo
        else
            return jReceivablesPortfolio           
        endIf
    else
        if !empty((self:cPortfolioAlias)->E1_PARCELA)
            cBillNumber += "-" + alltrim((self:cPortfolioAlias)->E1_PARCELA)
        endIf	
    endIf

    nINSSBaseValue := (self:cPortfolioAlias)->E1_BASEINS - self:jFKGData['MATERIAL_VALUE'] - self:jFKGData['FOOD_VALUE'] - self:jFKGData['TRANSPORT_VALUE']

    nInstallmentValue := (self:cPortfolioAlias)->E1_VLCRUZ
	if empty(cInvoiceNumber)
		nGrossAmount := nInstallmentValue
	endIf

    aadd(aBlockT154,{"NUMERO"           : cBillNumber,;
                    "SERIE"             : (self:cPortfolioAlias)->E1_PREFIXO,;
                    "COD_PARTICIPANTE"  : "C"+cCustomer+cUnit,;
                    "EMISSAO"           : dIssueDate,;
                    "NATUREZ"           : CLASS_RECEIVABLE,;
                    "OBSERVACAO"        : (self:cPortfolioAlias)->E1_HIST,;
                    "CODMOD_DOC"        : cInvoiceType,;
                    "NUM_DOC"           : cInvoiceNumber,;
                    "SER_DOC"           : cInvoiceSeries,;
                    "SUBSER_DOC"        : "",;
                    "VLR_BRUTO"         : nGrossAmount,;
                    "TIPO_RECIBO_FATURA": cReceiptType,;
                    "COD_SERV_MUN"      : "",;
                    "LOC_PRESTACAO"     : "",;
                    "TIPDOC"            : "",;
                    "NR_INSC_ESTAB"     : (self:cPortfolioAlias)->ON_CNO,;
                    "TP_INSCRICAO"      : (self:cPortfolioAlias)->ON_TPINSCR,;
                    "UNQ_INT"           : "",;
                    "INDISE"            : "",;
                    "VLRCP"             : 0,;
                    "VLRGIL"            : 0,;
                    "VLRSEN"            : 0,;
                    "NDJUD"             : "",;
                    "INDFCISCP"         : "",;
                    "DTESCRCONT"        : ctod(''),;
                    "DT_CONTABIL"       : ctod('')})

    if !empty(cServiceType) .or. !empty(cTransferType)
        if ((self:cPortfolioAlias)->ED_CALCINS == "S" .and. (self:cPortfolioAlias)->A1_RECINSS == "S") .and. (self:jFKGData['MATERIAL_VALUE'] + self:jFKGData['FOOD_VALUE'] + self:jFKGData['TRANSPORT_VALUE'] <= 0)            
            nRetentionAmount := (self:cPortfolioAlias)->FKF_ORIINS
        else	
            nRetentionAmount := (self:cPortfolioAlias)->E1_INSS
        endIf

        if !empty(cTransferType)
            cTransferDescr := posicione("SX5",1,xFilial("SX5") + "0G" + cTransferType, "X5_DESCRI")
            nTransfGrsAmt  := nGrossAmount
            nTransfRetAmt  := nRetentionAmount
        endIf

        aadd(aBlockT154AA, {"TIP_SERV":                     cServiceType,;
                            "VLR_BASE_CALCULO_INSS":        nINSSBaseValue,;
                            "VALOR_TRIBUTO_INSS":           nRetentionAmount,;
                            "VLR_RET_SERV_SUBCONTRAT_INSS": self:jFKGData['SUBCONTRACTOR'],;
                            "VLR_RET_PRIN_N_EFET_INSS":     self:jFKGData['NORMAL_RETIREMENT'],;
                            "VLR_SER_15_ANOS":              self:jFKGData['RETIREMENT_15'],;
                            "VLR_SER_20_ANOS":              self:jFKGData['RETIREMENT_20'],;
                            "VLR_SER_25_ANOSS":             self:jFKGData['RETIREMENT_25'],;
                            "VLR_ADICIONAL":                self:jFKGData['ADDITIONAL_VALUE'],;
                            "VLR_RET_ADV_N_EFET_INSS":      self:jFKGData['SPECIAL_RETIREMENT'],;
                            "TPREPASSE":                    cTransferType,;
                            "DESCRECURSO":                  cTransferDescr,;
                            "VLRBRUTO":                     nTransfGrsAmt,;
                            "VLRRETAPUR":                   nTransfRetAmt} )
	endIf

    aBlockT154AB := self:getT154ABBlock(nInstallmentValue)

    aBlockT154AF := self:getT154AFBlock(aLegalProcess, .F.)

    if len(aBlockT154AA) > 0
        aBlockT154[nCounter]["T154AA"] := aClone(aBlockT154AA)
        fwFreeArray(aBlockT154AA)
    endIf

    if len(aBlockT154AB) > 0
        aBlockT154[nCounter]["T154AB"] := aClone(aBlockT154AB)
        fwFreeArray(aBlockT154AB)
    endIf

    if len(aBlockT154AF) > 0
        aBlockT154[nCounter]["T154AF"] := aClone(aBlockT154AF)
        fwFreeArray(aBlockT154AF)
    endIf
    
    if len(aBlockT154) > 0
        jReceivablesPortfolio["T154"] := aClone(aBlockT154)
        fwFreeArray(aBlockT154)
    endIf

    if len(aLegalProcess) > 0
        fwFreeArray(aLegalProcess)
    endIf

    restArea(aArea)
    fwFreeArray(aArea)

return jReceivablesPortfolio

//-------------------------------------------------------------------
/*{Protheus.doc} getPayablesPortfolioData
    @description Seleciona e retorna dados do Contas a Pagar para compor o bloco T154.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 10/04/2025
    @return
*/
//-------------------------------------------------------------------
method getPayablesPortfolioData() as json class DataBlockT154
    local jPayablesPortfolio := jsonObject():new() as json
    local aArea             := {} as array
    local aLegalProcess     := {} as array
    local aBlockT154        := {} as array
    local aBlockT154AA      := {} as array
    local aBlockT154AB      := {} as array
    local aBlockT154AF      := {} as array
    local aBlockT154AG      := {} as array
    local aBlockT154AH      := {} as array
    local aBlockT154AI      := {} as array
    local aBlockT154AJ      := {} as array
    local aBlockT154AK      := {} as array
    local aBlockT154AL      := {} as array
    local aBlockT154AM      := {} as array
    local aExemptionDetail  := {} as array
    local aDedDetail        := {} as array
    local aT154Trb          := {} as array
    local aT154AL           := {} as array
    local cBillNumber       := "" as character
    local cInvoiceNumber    := "" as character
    local cInvoiceSeries    := "" as character
    local cSupplier         := "" as character
    local cUnit             := "" as character
    local cInvoiceType      := "" as character
    local cReceiptType      := STANDALONE_TITLE as character
    local cTransferType     := "" as character
    local cServiceType      := "" as character
    local cTransferDescr    := "" as character
    local cCnpjSocietyPart  := "" as character
    local cOldNatRen        := "" as character
    local cIndScp           := "" as character
    local cParticipantCode  := "" as character
    local dTypingDate       := ctod('') as date
    local dDtEscCon         := ctod('') as date
    local dIssueDate        := dDataBase as date
    local lIndividualSupp   := .F. as logical
    local lHasFkw           := .F. as logical
    local lCtbIRPF          := .F. as logical
    local lCtbIRPJ          := .F. as logical
    local lSimpDed          := .F. as logical
    local lF989DtCtb        := .F. as logical
    local lTribFKW          := .F. as logical
    local nSimpDed          := 0 as numeric
    local nTransfGrsAmt     := 0 as numeric
    local nTransfRetAmt     := 0 as numeric
    local nRetentionAmount  := 0 as numeric
    local nINSSBaseValue    := 0 as numeric
    local nInstallmentValue := 0 as numeric
    local nGrossAmount      := 0 as numeric
    local nForT154AI        := 1 as numeric
    local nForT154AJ        := 1 as numeric
    local nForT154AK        := 1 as numeric
    local nForT154AL        := 1 as numeric
    local nForT154AM        := 1 as numeric
    local nForT154Trb       := 1 as numeric
    local nCounter          := 0 as numeric
    local nFTSerieSize      := tamSx3("FT_SERIE")[1] as numeric
    local nFTDocSize        := tamSx3("FT_NFISCAL")[1] as numeric

    lCtbIRPF          := SuperGetMv("MV_VCTIRPF",.F.,"V") == "C"
    lCtbIRPJ          := SuperGetMv("MV_VENCIRF",.F.,"V") == "C"    

    aLegalProcess := self:jFKGData['LEGAL_PROCESS']
    
    aArea := getArea()

    self:loadPayableStatement()

    self:loadIRTaxInPayment()

    if existBlock("F989DtCtb")
        lF989DtCtb := .T.
    endIf

    while !(self:cPortfolioAlias)->(eof())
        aBlockT154AA := {}
        aBlockT154AB := {}
        aBlockT154AF := {}
        aBlockT154AG := {}
        aDedDetail := {}
        aExemptionDetail := {}
        aT154Trb := {}
        aBlockT154AL := {}
        aT154AL := {}

        self:loadSupplierID()
        nCounter++

        lIndividualSupp   := (self:cPortfolioAlias)->A2_TIPO == "F" .or. ((self:cPortfolioAlias)->A2_TIPO == "J" .and. (self:cPortfolioAlias)->A2_IRPROG == "1")

        self:loadTaxesConfigurations()

        self:lPCCinPayment    := (self:lPccMR .and. self:lPccBxMR) .or. (!self:lPccMR .and. self:lPCCinPayment)
        self:lIssinPayment    := (self:lIssMR .and. self:lIssBxMR) .or. (!self:lIssMR .and. self:lIssinPayment)
        self:lIRTaxInPayment := (self:lIrfMR .and. self:lIrfBxMR) .or. (!self:lIrfMR .and. (self:cPortfolioAlias)->A2_CALCIRF == "2")
        
        if !empty((self:cPortfolioAlias)->FKF_TPREPA)
            cTransferType := (self:cPortfolioAlias)->FKF_TPREPA
        endIf
        
        if !empty((self:cPortfolioAlias)->FKF_TPSERV)
            cServiceType  := "1" + padl((self:cPortfolioAlias)->FKF_TPSERV, 8 ,"0")
        endIf
        
        dDtEscCon	:= stod((self:cPortfolioAlias)->FKF_DTECON)

        if (lIndividualSupp .And. lCtbIRPF) .Or. (!lIndividualSupp .And. lCtbIRPJ)
            dTypingDate   := STOD((self:cPortfolioAlias)->E2_EMIS1)
        endIf

        lHasFkw := FTemFKW(self:cIdDoc)

        cSupplier       := alltrim((self:cPortfolioAlias)->E2_FORNECE)
        cUnit           := alltrim((self:cPortfolioAlias)->E2_LOJA)
        cBillNumber     := alltrim((self:cPortfolioAlias)->E2_NUM)

        if self:cIssueDateParameter == ACCOUNTING_DATE
            dIssueDate  := stod((self:cPortfolioAlias)->E2_EMIS1)
        else
            dIssueDate  := stod((self:cPortfolioAlias)->E2_EMISSAO)
        endIf

        if alltrim((self:cPortfolioAlias)->E2_ORIGEM) $ "MATA461|MATA460|MATA103|MATA100"
            cInvoiceNumber  := padr(alltrim((self:cPortfolioAlias)->E2_NUM), nFTDocSize)
            cInvoiceSeries  := padr(alltrim((self:cPortfolioAlias)->E2_PREFIXO), nFTSerieSize)


            if FTemSFT(PAYABLE_PORTFOLIO_CODE, cInvoiceNumber, @cInvoiceSeries, cSupplier, cUnit)

                cInvoiceType := AModNot( SFT->FT_ESPECIE )

                if empty(cInvoiceType)
                    cInvoiceType := "01"
                endIf

                cReceiptType := TITLE_FROM_INVOICE
                dIssueDate := SFT->FT_EMISSAO
                nGrossAmount := 0
                
                while SFT->(!Eof()) .and. SFT->(FT_FILIAL+FT_TIPOMOV+FT_SERIE+FT_NFISCAL+FT_CLIEFOR+FT_LOJA) ==  (xFilial("SFT") + "E" +  cInvoiceSeries + cInvoiceNumber + (self:cPortfolioAlias)->E2_FORNECE + (self:cPortfolioAlias)->E2_LOJA)
                    nGrossAmount += SFT->FT_VALCONT
                    SFT->(dbSkip())
                endDo
            elseIf !lHasFkw
                (self:cPortfolioAlias)->(dbSkip())
                loop
            else
                cInvoiceNumber  := ""
                cInvoiceSeries  := ""
                cInvoiceType  := ""
                if !empty((self:cPortfolioAlias)->E2_PARCELA)
                    cBillNumber += "-" + alltrim((self:cPortfolioAlias)->E2_PARCELA)
                endIf
            endIf
        else
            if !empty((self:cPortfolioAlias)->E2_PARCELA)
                cBillNumber += "-" + alltrim((self:cPortfolioAlias)->E2_PARCELA)
            endIf
        endIf

        nINSSBaseValue := (self:cPortfolioAlias)->E2_BASEINS - self:jFKGData['MATERIAL_VALUE'] - self:jFKGData['FOOD_VALUE'] - self:jFKGData['TRANSPORT_VALUE']
        
        nInstallmentValue := self:getInstallmentValue()

        if empty(cInvoiceNumber)
            nGrossAmount := nInstallmentValue
        endIf
        
        if self:lCpfFkj
            self:nIrTaxPercentage := (self:cPortfolioAlias)->FKJ_PERCEN / 100
            cParticipantCode := (self:cPortfolioAlias)->FKJ_CPF            
            nGrossAmount := ( nGrossAmount * self:nIrTaxPercentage )
            nInstallmentValue := nGrossAmount
        else
            cParticipantCode := cSupplier + cUnit
        endIf

        if !empty((self:cPortfolioAlias)->FKF_CGCSCP) .and. lHasFkw
            cIndScp  := "2"
        endIf

        if lF989DtCtb
            dTypingDate := ExecBlock("F989DtCtb",.F.,.F.,{(self:cPortfolioAlias)->RECNO,dTypingDate})
        endIf

        aadd(aBlockT154,{"NUMERO"           : cBillNumber,;
                        "SERIE"             :(self:cPortfolioAlias)->E2_PREFIXO,;
                        "COD_PARTICIPANTE"  :"F" + cParticipantCode,;
                        "EMISSAO"           :dIssueDate,;
                        "NATUREZ"           :CLASS_PAYABLE,;
                        "OBSERVACAO"        :(self:cPortfolioAlias)->E2_HIST,;
                        "CODMOD_DOC"        :cInvoiceType,;
                        "NUM_DOC"           :cInvoiceNumber,;
                        "SER_DOC"           :cInvoiceSeries,;
                        "SUBSER_DOC"        :"",;
                        "VLR_BRUTO"         :nGrossAmount,;
                        "TIPO_RECIBO_FATURA":cReceiptType,;
                        "COD_SERV_MUN"      :"",;
                        "LOC_PRESTACAO"     :"",;
                        "TIPDOC"            :"",;
                        "NR_INSC_ESTAB"     :(self:cPortfolioAlias)->ON_CNO,;
                        "TP_INSCRICAO"      :(self:cPortfolioAlias)->ON_TPINSCR,;
                        "UNQ_INT"           :"",;
                        "INDISE"            :"",;
                        "VLRCP"             :0,;
                        "VLRGIL"            :0,;
                        "VLRSEN"            :0,;
                        "NDJUD"             :"",;
                        "INDFCISCP"         :cIndScp,;
                        "DTESCRCONT"        :dDtEscCon,;
                        "DT_CONTABIL"       :dTypingDate})

        if !empty(cServiceType) .or. !empty(cTransferType)
            if ((self:cPortfolioAlias)->ED_CALCINS == "S" .and. (self:cPortfolioAlias)->A2_RECINSS == "S") .and. (self:jFKGData['MATERIAL_VALUE'] + self:jFKGData['FOOD_VALUE'] + self:jFKGData['TRANSPORT_VALUE'] <= 0)            
                nRetentionAmount := (self:cPortfolioAlias)->FKF_ORIINS
            else	
                nRetentionAmount := (self:cPortfolioAlias)->E2_INSS
            endIf

            if !empty(cTransferType)
                cTransferDescr := posicione("SX5",1,xFilial("SX5") + "0G" + cTransferType, "X5_DESCRI")
                nTransfGrsAmt  := nGrossAmount
                nTransfRetAmt  := nRetentionAmount
            endIf

             aadd(aBlockT154AA, {"TIP_SERV":                     cServiceType,;
                                 "VLR_BASE_CALCULO_INSS":        nINSSBaseValue,;
                                 "VALOR_TRIBUTO_INSS":           nRetentionAmount,;
                                 "VLR_RET_SERV_SUBCONTRAT_INSS": self:jFKGData['SUBCONTRACTOR'],;
                                 "VLR_RET_PRIN_N_EFET_INSS":     self:jFKGData['NORMAL_RETIREMENT'],;
                                 "VLR_SER_15_ANOS":              self:jFKGData['RETIREMENT_15'],;
                                 "VLR_SER_20_ANOS":              self:jFKGData['RETIREMENT_20'],;
                                 "VLR_SER_25_ANOSS":             self:jFKGData['RETIREMENT_25'],;
                                 "VLR_ADICIONAL":                self:jFKGData['ADDITIONAL_VALUE'],;
                                 "VLR_RET_ADV_N_EFET_INSS":      self:jFKGData['SPECIAL_RETIREMENT'],;
                                 "TPREPASSE":                    cTransferType,;
                                 "DESCRECURSO":                  cTransferDescr,;
                                 "VLRBRUTO":                     nTransfGrsAmt,;
                                 "VLRRETAPUR":                   nTransfRetAmt})
        endIf

        aBlockT154AB := self:getT154ABBlock(nInstallmentValue)

        aBlockT154AF := self:getT154AFBlock(aLegalProcess,(lHasFkw .and. !self:lIRTaxInPayment))

        if lHasFkw .and. !self:lIRTaxInPayment

            if self:lRetentionSuspension
                self:validateTaxReliefs(@aT154AL,,dIssueDate,.T.)

                if len(aT154AL) > 0
                    for nForT154AL := 1 to len(aT154AL)
                        aBlockT154AM := {}
                        aadd(aBlockT154AL,{'IND_TP_DEDUCAO' : aT154AL[nForT154AL][1],;
                                            'VAL_DEDUCAO' : aT154AL[nForT154AL][3]})

                        if len(aT154AL[nForT154AL][5]) > 0
                            for nForT154AM := 1 to len(aT154AL[nForT154AL][5])
                                aadd(aBlockT154AM,{'CPF' : aT154AL[nForT154AL][5][nForT154AM][2],;
                                                    'VAL_DEDUCAO_SUSPENSO' : aT154AL[nForT154AL][5][nForT154AM][3]})
                            next nForT154AM
                        endIf
                        if len(aBlockT154AM) > 0
                            aBlockT154AL[nForT154AL]["T154AM"] := aClone(aBlockT154AM)
                            fwFreeArray(aBlockT154AM)
                        endIf
                    next nForT154AL                
                    fwFreeArray(aT154AL)
                endIf
                if len(aBlockT154AL) > 0
                    aBlockT154AF[Len(aBlockT154AF)]["T154AL"] := aClone(aBlockT154AL)
                    fwFreeArray(aBlockT154AL)
                endIf
            endIf

            if lIndividualSupp .and. !self:lRetentionSuspension
                self:validateTaxReliefs(@aDedDetail, @aExemptionDetail, dIssueDate, , @nSimpDed, @lSimpDed)
            endIf

            lTribFKW := self:isTaxesOnEmission( @aT154Trb, lIndividualSupp, dIssueDate, self:lRetentionSuspension, nSimpDed, lSimpDed)

            if lTribFKW .and. Len(aT154Trb) > 0
                for nForT154Trb := 1 To Len(aT154Trb)
                    aBlockT154AH := {}
                    aBlockT154AI := {}
                    aBlockT154AJ := {}
                    aBlockT154AK := {}

                    if !empty((self:cPortfolioAlias)->FKF_CGCSCP)
                        cCnpjSocietyPart := (self:cPortfolioAlias)->FKF_CGCSCP 
                    endIf

                    if (!self:lCpfFkj .and. aT154Trb[nForT154Trb][2] <> cOldNatRen) .or. (self:lCpfFkj .and. (cParticipantCode == aT154Trb[nForT154Trb][6] .or. empty(aT154Trb[nForT154Trb][6])))
                        aadd(aBlockT154AG,{'NATUREZA_RENDIMENTO': aT154Trb[nForT154Trb][2],;
                                            'IND_DEC_TERC': (self:cPortfolioAlias)->FKF_INDDEC,;
                                            'VLR_PGTO': aT154Trb[nForT154Trb][3],;
                                            'NR_INSC_FCI_SCP': cCnpjSocietyPart,;
                                            'INDRRA':'',;
                                            'TPPROCRRA':'',;
                                            'NRPROC':'',;
                                            'COMPFP':''})
                    endIf

                    cOldNatRen := aT154Trb[nForT154Trb][2]

                    if aT154Trb[nForT154Trb][1] == "12"
                        if !self:lCpfFkj .or. (self:lCpfFkj .and. (cParticipantCode == aT154Trb[nForT154Trb][6] .or. empty(aT154Trb[nForT154Trb][6])))
                            aadd(aBlockT154AH,{'TRIBUTO': aT154Trb[nForT154Trb][1],;
                                                'BASE_CALCULO': aT154Trb[nForT154Trb][4],;
                                                'VLR_TRIBUTO': aT154Trb[nForT154Trb][5],;
                                                'ALIQUOTA': 0})
                        endIf

                        for nForT154AI := 1 To Len( aDedDetail )
                            aadd(aBlockT154AI,{'TIPO_DEDUCAO' : aDedDetail[nForT154AI][1],;
                                                'VAL_DEDUCAO' : aDedDetail[nForT154AI][2],;
                                                'VAL_DEDUCAO_SUSP' : aDedDetail[nForT154AI][3],;
                                                'NUM_PREVIDENCIA' : aDedDetail[nForT154AI][4],;
                                                'INFO_ENTIDADE' : aDedDetail[nForT154AI][6]})

                            if Len(aDedDetail[nForT154AI][5]) > 0
                                for nForT154AK := 1 to Len(aDedDetail[nForT154AI][5])
                                    aadd(aBlockT154AK,{'CPF' : aDedDetail[nForT154AI][5][nForT154AK][2],;
                                                        'VAL_DEDUCAO' : aDedDetail[nForT154AI][5][nForT154AK][3]})
                                next nForT154AK
                            endIf

                            if len(aBlockT154AK) > 0
                                aBlockT154AI[nForT154AI]["T154AK"] := aClone(aBlockT154AK)
                                fwFreeArray(aBlockT154AK)
                            endIf
                        next nForT154AI

                        
                        for nForT154AJ := 1 To Len( aExemptionDetail )
                            aadd(aBlockT154AJ,{'TIPO_ISENCAO' : aExemptionDetail[nForT154AJ][1],;
                                                'VAL_ISENTO' : aExemptionDetail[nForT154AJ][2],;
                                                'DESC_RENDIMENTO' : aExemptionDetail[nForT154AJ][3]})
                        next nForT154AJ

                        if len(aBlockT154AH) > 0
                            if len(aBlockT154AI) > 0
                                aBlockT154AH[1]["T154AI"] := aClone(aBlockT154AI)
                                fwFreeArray(aBlockT154AI)
                            endif

                            if len(aBlockT154AJ) > 0
                                aBlockT154AH[1]["T154AJ"] := aClone(aBlockT154AJ)
                                fwFreeArray(aBlockT154AJ)
                            endif

                            if len(aBlockT154AG) > 0
                                aBlockT154AG[Len(aBlockT154AG)]["T154AH"] := aClone(aBlockT154AH)
                            endIf
                            fwFreeArray(aBlockT154AH)
                        endif
                    endIf
                next nForT154Trb
            endIf
            
            if len(aDedDetail) > 0
                fwFreeArray(aDedDetail)
            endIf

            if len(aExemptionDetail) > 0
                fwFreeArray(aExemptionDetail)
            endIf

            if len(aT154Trb) > 0
                fwFreeArray(aT154Trb)
            endIf

            cOldNatRen := ""
        endIf

        if len(aBlockT154AA) > 0
            aBlockT154[nCounter]["T154AA"] := aClone(aBlockT154AA)
            fwFreeArray(aBlockT154AA)
        endIf

        if len(aBlockT154AB) > 0
            aBlockT154[nCounter]["T154AB"] := aClone(aBlockT154AB)
            fwFreeArray(aBlockT154AB)
        endIf
        
        if len(aBlockT154AF) > 0
            aBlockT154[nCounter]["T154AF"] := aClone(aBlockT154AF)
            fwFreeArray(aBlockT154AF)
        endIf

        if len(aBlockT154AG) > 0
            aBlockT154[nCounter]["T154AG"] := aClone(aBlockT154AG)
            fwFreeArray(aBlockT154AG)
        endIf

        (self:cPortfolioAlias)->(dbSkip())
    endDo

    if len(aBlockT154) > 0
        jPayablesPortfolio["T154"] := aClone(aBlockT154)
        fwFreeArray(aBlockT154)
    endIf

    if len(aLegalProcess) > 0
        fwFreeArray(aLegalProcess)
    endIf

    restArea(aArea)
    fwFreeArray(aArea)

return jPayablesPortfolio

//-------------------------------------------------------------------
/*{Protheus.doc} setHasDataBlock
    @description Define o conteúdo da propriedade self:lHasDataBlock.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 17/04/2025
    @return
*/
//-------------------------------------------------------------------
method setHasDataBlock(lHasDataBlock) class DataBlockT154
    self:lHasDataBlock := lHasDataBlock
return

//-------------------------------------------------------------------
/*{Protheus.doc} getHasDataBlock
    @description Retorna o conteúdo da propriedade self:lHasDataBlock.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 17/04/2025
    @return
*/
//-------------------------------------------------------------------
method getHasDataBlock() as logical class DataBlockT154
return self:lHasDataBlock

//-------------------------------------------------------------------
/*{Protheus.doc} getHasT154ACData
    @description Retorna o conteúdo da propriedade self:lHasT154AC.
    @type Method
    @param cIdDocParc, Character, ID da FK7 da parcela
    @version 12.1.2410
    @author guilhermed.santos
    @since 24/07/2025
    @return
*/
//-------------------------------------------------------------------
method getHasT154ACData(cIdDocParc as character) as logical class DataBlockT154
    default cIdDocParc := self:cIdDoc
    if self:cSettlementDisplayMode $ (WRITE_OFF_DATE + '/' + DATE_OF_AVAILABILITY) // .and. !self:lExecutedLoadT154AC
        self:loadT154ACData(cIdDocParc)
    endIf
return self:lHasT154AC

//-------------------------------------------------------------------
/*{Protheus.doc} loadFKGData
    @description Verifica se o titulo tem complemento de imposto na tabela FKG para o INSS (legado).
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 02/05/2025
    @return
*/
//-------------------------------------------------------------------
method loadFKGData() class DataBlockT154
    local aArea         := {} as array
    local aAreaFKG      := {} as array
    local aAreaCCF      := {} as array
    local nCCFNumSize   := TAMSX3("CCF_NUMERO")[1] as numeric
    local aLegalProcess := {} as array
    local cTypeOfTaxAct := "" as character

    self:jFKGData['MATERIAL_VALUE']      := 0
    self:jFKGData['FOOD_VALUE']          := 0
    self:jFKGData['TRANSPORT_VALUE']     := 0
    self:jFKGData['NORMAL_RETIREMENT']   := 0
    self:jFKGData['SPECIAL_RETIREMENT']  := 0
    self:jFKGData['SUBCONTRACTOR']       := 0
    self:jFKGData['RETIREMENT_15']       := 0
    self:jFKGData['RETIREMENT_20']       := 0
    self:jFKGData['RETIREMENT_25']       := 0
    self:jFKGData['ADDITIONAL_VALUE']    := 0

    aArea    := getArea()
    aAreaFKG := FKG->(getArea())
    aAreaCCF := CCF->(getArea())

    dbSelectArea('FKG')
    FKG->(dbSetOrder(1)) //FKG_FILIAL+FKG_IDDOC+FKG_ITEM
    if FKG->( dbSeek( xFilial("FKG") + self:cIdDoc ) )

        while FKG->( !Eof() ) .And. alltrim( FKG->( FKG_FILIAL + FKG_IDDOC ) ) == alltrim( xFilial("FKG") + self:cIdDoc )

            cTypeOfTaxAct := alltrim( FKG->FKG_TPATRB )

            if alltrim(FKG->FKG_TPIMP) == 'INSS'
                if FKG->FKG_APLICA == APPLICATION_ON_BASE .and. FKG->FKG_DEDACR == DEDUCTION
                    if cTypeOfTaxAct == MATERIAL
                        self:jFKGData['MATERIAL_VALUE'] += FKG->FKG_VALOR
                    elseIf cTypeOfTaxAct == FOOD
                        self:jFKGData['FOOD_VALUE'] += FKG->FKG_VALOR
                    elseIf cTypeOfTaxAct == TRANSPORT
                        self:jFKGData['TRANSPORT_VALUE'] += FKG->FKG_VALOR
                    endIf

                elseIf FKG->FKG_APLICA == APPLICATION_ON_VALUE .and. FKG->FKG_DEDACR == DEDUCTION
                        
                    if cTypeOfTaxAct == LEGAL_PROCESS
                        dbSelectArea('CCF')
                        CCF->(dbSetOrder(1)) //CCF_FILIAL+CCF_NUMERO+CCF_TIPO+CCF_INDAUT+CCF_IDITEM
                        if CCF->(dbSeek(xFilial("CCF") + padr(FKG->FKG_NUMPRO, nCCFNumSize) +  FKG->FKG_TPPROC))
                            
                            while CCF->(!Eof()) .and. CCF->(CCF_FILIAL + CCF_NUMERO + CCF_TIPO ) == xFilial("CCF") + padr(FKG->FKG_NUMPRO, nCCFNumSize) +  FKG->FKG_TPPROC
                                if empty(FKG->FKG_CODSUS) .or. alltrim(CCF->CCF_INDSUS) == alltrim(FKG->FKG_CODSUS)
                                    aadd(aLegalProcess,{CCF_TRIB, CCF->CCF_TIPO, FKG->FKG_VALOR, FKG->FKG_NUMPRO,INSS_TAX_CODE, FKG->FKG_CODSUS})
                                    if CCF->CCF_TRIB == NORMAL_RETIREMENT
                                        self:jFKGData['NORMAL_RETIREMENT'] += FKG->FKG_VALOR
                                    elseIf CCF->CCF_TRIB == SPECIAL_RETIREMENT
                                        self:jFKGData['SPECIAL_RETIREMENT'] += FKG->FKG_VALOR
                                    endIf
                                endIf
                                CCF->(dbSkip())
                            endDo
                        endIf                        
                    elseIf cTypeOfTaxAct == SUBCONTRACTOR
                        self:jFKGData['SUBCONTRACTOR'] += FKG->FKG_VALOR
                    endIf
                endIf
            
                if FKG->FKG_APLICA == APPLICATION_ON_VALUE .and. FKG->FKG_DEDACR != DEDUCTION
                    if cTypeOfTaxAct == SPECIAL_RETIREMENT_15_YEARS
                        self:jFKGData['RETIREMENT_15'] += FKG->FKG_BASECA
                    elseIf cTypeOfTaxAct == SPECIAL_RETIREMENT_20_YEARS
                        self:jFKGData['RETIREMENT_20'] += FKG->FKG_BASECA
                    elseIf cTypeOfTaxAct == SPECIAL_RETIREMENT_25_YEARS
                        self:jFKGData['RETIREMENT_25'] += FKG->FKG_BASECA
                    endIf

                    self:jFKGData['ADDITIONAL_VALUE'] += FKG->FKG_VALOR
                endIf
            endIf		
            
            FKG->( dbSkip() )
        endDo
    endIf

    self:jFKGData['LEGAL_PROCESS'] := aLegalProcess

    restArea(aAreaCCF)
    restArea(aAreaFKG)
    restArea(aArea)

return

//-------------------------------------------------------------------
/*{Protheus.doc} getT154AFBlock
    @description Monta e retorna o subbloco T154AF.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 02/05/2025
    @return
*/
//-------------------------------------------------------------------
method getT154AFBlock(aLegalProcess as array, lRetentionSusp as logical) as array class DataBlockT154
    local aT154AFBlock := {} as array
    local nX           := 1 as numeric
    local nFKWImpSize	   := 0 as numeric
    Local cIRTax       := "" as character
    local aArea        := {} as array
    local aAreaFKW     := {} as array
    
    default lRetentionSusp := .F.

    for nX := 1 to len(aLegalProcess)

        if aLegalProcess[nX][5] $ INSS_TAX_CODE
            aadd(aT154AFBlock,{'TP_PROC' : aLegalProcess[nX][1],;
                                'NUM_PROC' : aLegalProcess[nX][4],;
                                'IND_PROC' : aLegalProcess[nX][2],;
                                'COD_SUS' : aLegalProcess[nX][6],;
                                'VAL_SUS' : aLegalProcess[nX][3],;
                                'COD_TRIB' : aLegalProcess[nX][5],;
                                'NATUREZA_RENDIMENTO' : "",;
                                'BASE_SUSPENSA' : 0,;
                                'VLR_COMP_ANO_CALENDARIO' : 0,;
                                'VLR_COMP_ANO_ANT' : 0})
        endIf
			
	next nX
    
    if lRetentionSusp
        nFKWImpSize	 := TAMSX3("FKW_TPIMP")[1]
        aArea    := getArea()
        aAreaFKW := FKW->(getArea())

        cIRTax	:= padR( 'IRF', nFKWImpSize )

        DbSelectArea("FKW")
        FKW->(DBSetOrder(2)) //FKW_FILIAL, FKW_IDDOC, FKW_CARTEI, FKW_NATREN, FKW_TPIMP
        FKW->(DbGotop())	
        FKW->(MsSeek( xFilial("FKW") + self:cIdDoc + "1"))

        while FKW->( !Eof() ) .and. FKW->FKW_IDDOC == self:cIdDoc .and. FKW->FKW_CARTEI == "1"
            if FKW->FKW_TPIMP == cIRTax .and. !empty(FKW->FKW_NUMPRO)
                self:lRetentionSuspension := .T.

                aadd(aT154AFBlock,{'TP_PROC' : "",;
                                    'NUM_PROC' : FKW->FKW_NUMPRO,;
                                    'IND_PROC' : FKW->FKW_TPPROC,;
                                    'COD_SUS' : FKW->FKW_CODSUS,;
                                    'VAL_SUS' : FKW->FKW_VLIMPN,;
                                    'COD_TRIB' : '12',;
                                    'NATUREZA_RENDIMENTO' : FKW->FKW_NATREN,;
                                    'BASE_SUSPENSA' : FKW->FKW_BASENR,;
                                    'VLR_COMP_ANO_CALENDARIO' : 0,;
                                    'VLR_COMP_ANO_ANT' : 0})
            endIf

            FKW->( dbSkip() )
        endDo

        restArea(aAreaFKW)
        restArea(aArea)
    endIf

return aT154AFBlock

//-------------------------------------------------------------------
/*{Protheus.doc} getT154ABBlock
    @description Monta e retorna o subbloco T154AB.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 02/05/2025
    @return
*/
//-------------------------------------------------------------------
method getT154ABBlock(nInstallmentValue as numeric) as array class DataBlockT154
    local aT154ABBlock := {} as array
    local cInstallment := "" as character

    default cInstallment := ""

    (self:cInstallmentAlias)->(dbGotop())

    while (self:cInstallmentAlias)->(!eof())
        cInstallment := alltrim((self:cInstallmentAlias)->PARCELA)
        aadd(self:aInstallmentsId,(self:cInstallmentAlias)->IDDOC)

        if empty(cInstallment)
            cInstallment := "1"
        endIf

        aadd(aT154ABBlock,{'NUM_PARC': cInstallment,;
                            'VLR_PARC': nInstallmentValue})

        if self:getHasT154ACData((self:cInstallmentAlias)->IDDOC)
            aT154ABBlock[Len(aT154ABBlock)]["T154AC"] := self:getT154ACBlock()
        endIf

        (self:cInstallmentAlias)->(dbSkip())
    endDo
return aT154ABBlock

//-------------------------------------------------------------------
/*{Protheus.doc} loadReceivableStatement
    @description Monta e executa query para buscar dados da SE1, SA1, SED, FKF e SON a partir do IDDOC.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 06/05/2025
    @return
*/
//-------------------------------------------------------------------
method loadReceivableStatement() class DataBlockT154
    local cQuery := "" as character
    local nParamOrder   := 1  as numeric
    local oPortfolioStatement := Nil as object

    cQuery := " SELECT E1_FILIAL, E1_CLIENTE, E1_LOJA, E1_NUM, E1_EMIS1, E1_EMISSAO, E1_ORIGEM, E1_NUM, E1_SERIE, E1_PARCELA, E1_VLCRUZ, E1_BASEINS, E1_INSS, E1_PREFIXO, E1_HIST, E1_TIPO, "
    cQuery += " A1_RECINSS, ED_CALCINS, FKF_TPREPA, FKF_TPSERV, FKF_ORIINS, FKF_REINF, ON_CNO, ON_TPINSCR "
    cQuery += " FROM " + retSqlName("FK7") + " FK7 "
    cQuery += "     INNER JOIN " + retSqlName("SE1") + " SE1 "
    cQuery += "         ON SE1.E1_FILIAL = ? "
    cQuery += "         AND SE1.E1_CLIENTE = FK7.FK7_CLIFOR "
    cQuery += "         AND SE1.E1_LOJA = FK7.FK7_LOJA "
    cQuery += "         AND SE1.E1_PREFIXO = FK7.FK7_PREFIX "
    cQuery += "         AND SE1.E1_NUM = FK7.FK7_NUM "
    cQuery += "         AND SE1.E1_PARCELA = FK7.FK7_PARCEL "
    cQuery += "         AND SE1.E1_TIPO = FK7.FK7_TIPO "
    cQuery += "         AND SE1.E1_INSS > ? "
    cQuery += "         AND SE1.D_E_L_E_T_ = ? "
    cQuery += "     INNER JOIN " + retSqlName("SA1") + " SA1 "
    cQuery += "         ON " + FWJoinFilial("SA1", "SE1")
    cQuery += "         AND SA1.A1_COD = SE1.E1_CLIENTE "
    cQuery += "         AND SA1.A1_LOJA = SE1.E1_LOJA "
    cQuery += "         AND SA1.A1_RECINSS = ? "
    cQuery += "         AND SA1.D_E_L_E_T_ = ? "
    cQuery += "     INNER JOIN " + retSqlName("SED") + " SED "
    cQuery += "         ON " + FWJoinFilial("SED", "SE1")
    cQuery += "         AND SED.ED_CODIGO = SE1.E1_NATUREZ "
    cQuery += "         AND SED.ED_CALCINS = ? "
    cQuery += "         AND SED.D_E_L_E_T_ = ? "
    cQuery += "     INNER JOIN " + retSqlName("FKF") + " FKF "
    cQuery += "         ON FKF.FKF_FILIAL = ? "
    cQuery += "         AND FKF.FKF_IDDOC = FK7.FK7_IDDOC "
    cQuery += "         AND (FKF.FKF_TPSERV != ? OR FKF.FKF_TPREPA != ? "
    cQuery += "              OR SE1.E1_ORIGEM IN (?) "
    cQuery += "             ) "
    cQuery += "         AND FKF.D_E_L_E_T_ = ? "
    cQuery += "     LEFT JOIN " + retSqlName("SON") + " SON "
    cQuery += "         ON " + FWJoinFilial("SON", "FKF")
    cQuery += "         AND  SON.ON_CODIGO = FKF.FKF_CNO "
    cQuery += "         AND SON.D_E_L_E_T_ = ? "
    cQuery += " WHERE  FK7.FK7_IDDOC = ? "
    cQuery += " AND FK7.D_E_L_E_T_ = ? "

    cQuery := ChangeQuery(cQuery)

    oPortfolioStatement := FWExecStatement():New(cQuery)

    oPortfolioStatement:setString( nParamOrder++, xFilial("SE1") )
    oPortfolioStatement:setNumeric( nParamOrder++, 0 )
    oPortfolioStatement:setString( nParamOrder++, " " )
    oPortfolioStatement:setString( nParamOrder++, "S" )
    oPortfolioStatement:setString( nParamOrder++, " " )
    oPortfolioStatement:setString( nParamOrder++, "S" )
    oPortfolioStatement:setString( nParamOrder++, " " )
    oPortfolioStatement:setString( nParamOrder++, xFilial("FKF") )
    oPortfolioStatement:setString( nParamOrder++, " " )
    oPortfolioStatement:setString( nParamOrder++, " " )
    oPortfolioStatement:Setin(nParamOrder++,{'MATA461','MATA460','MATA103','MATA100'})
    oPortfolioStatement:setString( nParamOrder++, " " )
    oPortfolioStatement:setString( nParamOrder++, " " )
    oPortfolioStatement:setString( nParamOrder++, self:cIdDoc)
    oPortfolioStatement:setString( nParamOrder++, " " )

    self:cPortfolioAlias := oPortfolioStatement:openAlias()

    if !(self:cPortfolioAlias)->(eof())
        self:loadReceivableInstallments()
    endIf
    oPortfolioStatement:destroy()
return

//-------------------------------------------------------------------
/*{Protheus.doc} loadPayableStatement
    @description Monta e executa query para buscar dados da SE2, SA2, SED, FKF e SON a partir do IDDOC.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 06/05/2025
    @return
*/
//-------------------------------------------------------------------
method loadPayableStatement() class DataBlockT154
    local cQuery := "" as character
    local nParamOrder   := 1  as numeric
    local oPortfolioStatement := Nil as object

    cQuery := " SELECT E2_FILIAL, E2_FORNECE, E2_LOJA, E2_NUM, E2_NATUREZ, E2_EMISSAO, E2_ORIGEM, E2_NUM, E2_PARCELA, E2_VLCRUZ, E2_BASEINS, E2_INSS, E2_PREFIXO, E2_HIST,  E2_CODRET, "
    cQuery += " E2_IRRF, SE2.R_E_C_N_O_ RECNO, E2_PIS, E2_COFINS, E2_CSLL, E2_SEST, E2_ISS, E2_EMIS1, E2_TIPO, "
    cQuery += " A2_RECINSS, A2_TIPO, A2_CALCIRF, A2_NUMDEP, A2_CGC, A2_CPFIRP, A2_IRPROG, "        
    cQuery += " ED_CALCINS, FKF_TPREPA, FKF_TPSERV, FKF_ORIINS, FKF_REINF, FKF_DTECON, FKF_CGCSCP, FKF_INDDEC, ON_CNO, ON_TPINSCR, FKJ_CPF, FKJ_PERCEN "
    cQuery += " FROM " + retSqlName("FK7") + " FK7 "
    cQuery += "     INNER JOIN " + retSqlName("SE2") + " SE2 "
    cQuery += "         ON SE2.E2_FILIAL = ? "
    cQuery += "         AND SE2.E2_FORNECE = FK7.FK7_CLIFOR "
    cQuery += "         AND SE2.E2_LOJA = FK7.FK7_LOJA "
    cQuery += "         AND SE2.E2_PREFIXO = FK7.FK7_PREFIX "
    cQuery += "         AND SE2.E2_NUM = FK7.FK7_NUM "
    cQuery += "         AND SE2.E2_PARCELA = FK7.FK7_PARCEL "
    cQuery += "         AND SE2.E2_TIPO = FK7.FK7_TIPO "
    cQuery += "         AND SE2.D_E_L_E_T_ = ? "
    cQuery += "     INNER JOIN " + retSqlName("SA2") + " SA2 "
    cQuery += "         ON " + FWJoinFilial("SA2", "SE2")
    cQuery += "         AND SA2.A2_COD = SE2.E2_FORNECE "
    cQuery += "         AND SA2.A2_LOJA = SE2.E2_LOJA "
    cQuery += "         AND SA2.D_E_L_E_T_ = ? "
    cQuery += "     LEFT JOIN " + retSqlName("FKJ") + " FKJ "
    cQuery += "         ON " + FWJoinFilial("FKJ", "SA2")
    cQuery += "         AND FKJ.FKJ_COD = SA2.A2_COD "
    cQuery += "         AND FKJ.FKJ_LOJA = SA2.A2_LOJA "
    cQuery += "         AND FKJ.D_E_L_E_T_ = ? "
    cQuery += "     INNER JOIN " + retSqlName("SED") + " SED "
    cQuery += "         ON " + FWJoinFilial("SED", "SE2")
    cQuery += "         AND SED.ED_CODIGO = SE2.E2_NATUREZ "
    cQuery += "         AND SED.D_E_L_E_T_ = ? "
    cQuery += "     LEFT JOIN " + retSqlName("FKF") + " FKF "
    cQuery += "         ON FKF.FKF_FILIAL = ? "
    cQuery += "         AND FKF.FKF_IDDOC = FK7.FK7_IDDOC "
    cQuery += "         AND FKF.D_E_L_E_T_ = ? "
    cQuery += "     LEFT JOIN " + retSqlName("SON") + " SON "
    cQuery += "         ON " + FWJoinFilial("SON", "FKF")
    cQuery += "         AND  SON.ON_CODIGO = FKF.FKF_CNO "
    cQuery += "         AND SON.D_E_L_E_T_ = ? "
    cQuery += " WHERE  FK7.FK7_IDDOC = ? "
    cQuery += " AND FK7.D_E_L_E_T_ = ? "

    cQuery := ChangeQuery(cQuery)

    oPortfolioStatement := FWExecStatement():New(cQuery)

    oPortfolioStatement:setString( nParamOrder++, xFilial("SE2") )
    oPortfolioStatement:setString( nParamOrder++, " " )
    oPortfolioStatement:setString( nParamOrder++, " " )
    oPortfolioStatement:setString( nParamOrder++, " " )
    oPortfolioStatement:setString( nParamOrder++, " " )
    oPortfolioStatement:setString( nParamOrder++, xFilial("FKF") )
    oPortfolioStatement:setString( nParamOrder++, " " )
    oPortfolioStatement:setString( nParamOrder++, " " )
    oPortfolioStatement:setString( nParamOrder++, self:cIdDoc)
    oPortfolioStatement:setString( nParamOrder++, " " )

    self:cPortfolioAlias := oPortfolioStatement:openAlias()

    if !(self:cPortfolioAlias)->(eof())
        self:loadPayableInstallments()
    endIf
    oPortfolioStatement:destroy()
return

//-------------------------------------------------------------------
/*/{Protheus.doc} validateTaxReliefs 
Verifica se há dedução ou isenção para o tributo IR pessoa fisica:
- No "complemento de título x imposto" (tabela FKG), para dedução e isenção;
- No legado para as deduções INSS e dependentes;

@param aDedDetail - Array que armazenara as deduções
@param aExemptionDetail - Informa .T. se o fornecedor do titulo é pessoa fisica
@param dGenerationDate   - Data do fato gerador do IR
@param lSusp  - Suspensão de IRRF
@param nSimpDed  - Valor de dedução IRPF Simplificado
@param lSimpDed  - Indica se houve calculo de dedução IRPF Simplificado

@return nil

@author fabio.casagrande
@since 05/01/2023
@version P12
/*/
//-------------------------------------------------------------------
method validateTaxReliefs(aDedDetail as array, aExemptionDetail as array, dGenerationDate as date, lSusp as logical, nSimpDed as numeric, lSimpDed as logical) class DataBlockT154
    local aDepPen         := {} as array
    local aArea           := {} as array
    local cTpAtrb         := "" as character
    local cDedussion      := "" as character
    local cInsPre         := "" as character
    local cIsen           := "" as character
    local cIncomeDescr    := "" as character
    local cTemInPre       := "" as character
    local cRet            := "" as character
    local cIdDocDep	      := "" as character
    local lDedPen         := .F. as logical
    local lIRPF           := .F. as logical
    local lDedIns         := .F. as logical
    local nBaseDedVal     := 0  as numeric
    local nBaseDedSus     := 0  as numeric
    local nExemptionVal   := 0  as numeric
    local nAlimonyDed     := 0  as numeric
    local nAlimonySus     := 0  as numeric
    local nInssVal        := 0  as numeric
    local nIrfVal         := 0  as numeric
    local nNumOfDep       := 0  as numeric

    Default aDedDetail := {}
    Default aExemptionDetail := {}
    Default dGenerationDate   := CTOD("  /  /    ")
    Default lSusp   := .F.
    Default nSimpDed:= 0
    Default lSimpDed:= .F.
    
    aDepPen := {}
    nAlimonyDed := 0
    nAlimonySus := 0
    nBaseDedVal := 0
    nBaseDedSus := 0
    lDedPen := .F.
    nInssVal := (self:cPortfolioAlias)->E2_INSS
    nIrfVal := (self:cPortfolioAlias)->E2_IRRF
    nNumOfDep := (self:cPortfolioAlias)->A2_NUMDEP
    cRet	:= ""
    lIRPF := ((self:cPortfolioAlias)->A2_TIPO == "F" .OR. ((self:cPortfolioAlias)->A2_TIPO == "J" .AND. (self:cPortfolioAlias)->A2_IRPROG == "1")) 
    lDedIns         := SuperGetMv("MV_INSIRF",.F.,"2") == "1"
    cIdDocDep	:= ''

    aArea    := getArea()
    aAreaFKG := FKG->(getArea())

    DbSelectArea("FKG")
    FKG->(DBSetOrder(2)) //FKG_FILIAL+FKG_IDDOC+FKG_TPIMP
    if FKG->( MsSeek( xFilial("FKG") + self:cIdDoc ) )
        while FKG->( !Eof() ) .And. alltrim( FKG->( FKG_FILIAL + FKG_IDDOC ) ) == alltrim( xFilial("FKG") + self:cIdDoc )

            cTpAtrb := alltrim( FKG->FKG_TPATRB )

            if cTpAtrb $ (PRIVATE_PENSION + FAPI + FUNPRESP)
                cDedussion 		:= self:jDeductionType[cTpAtrb]
                cInsPre 	:= FKG->FKG_INSPRE
                
                if empty(cInsPre)
                    cTemInPre := "2"
                else
                    cTemInPre := "1"
                endIf

                if lSusp
                    nBaseDedSus := FKG->FKG_VALOR
                else
                    nBaseDedVal:= FKG->FKG_VALOR
                endIf

                if self:lCpfFkj
                    nBaseDedVal := nBaseDedVal * self:nIrTaxPercentage
                    nBaseDedSus := nBaseDedSus * self:nIrTaxPercentage
                endIf

				aadd( aDedDetail, { cDedussion, nBaseDedVal, nBaseDedSus, cInsPre, {}, cTemInPre } )
            elseIf cTpAtrb $ ALIMONY

                if lSusp
                    nAlimonySus += FKG->FKG_VALOR
                else
                    nAlimonyDed += FKG->FKG_VALOR
                endIf

                lDedPen := .T.				
            elseIf cTpAtrb $ (OTHERS + TAX_EXEMPT_AGE_65_PLUS + TRAVEL_ALLOWANCE + CONTRACT_TERMINATION_COMPENSATION + CASH_BONUS + PAYMENT_TO_MICROENTERPRISE_PARTNER + RETIREMENT_DUE_TO_SERIOUS_ILLNESS + ;
                                    PENSION_SUPPLEMENT_CONTRIBUTIONS + EXPENSE_ALLOWANCE + LATE_PAYMENT_INTEREST + PENSION_WITHDRAWAL_SERIOUS_ILLNESS + OTHERS_TECHIICAL_NOTE)
                nExemptionVal	:= FKG->FKG_VALOR
                cIsen := self:jExemptionsType[cTpAtrb]

				if cTpAtrb == OTHERS_TECHIICAL_NOTE
                    cIncomeDescr	:= FKG->FKG_DESCR
                endIf

                if self:lCpfFkj
                    nExemptionVal := nExemptionVal * self:nIrTaxPercentage
                endIf
                
                aadd( aExemptionDetail, { cIsen, nExemptionVal, cIncomeDescr } )
            endIf

            cDedussion	 := ""
            nBaseDedVal	 := 0
            nBaseDedSus	 := 0
            cInsPre		 := ""
            cIsen		 := ""
            nExemptionVal	 := 0
            cIncomeDescr := ""

            FKG->( dbSkip() )
        endDo
    endIf

    if lDedPen
        cDedussion := self:jDeductionType[ALIMONY]
        aDepPen := self:loadDependentsOnAlimony("1", lSusp)

        if self:lCpfFkj
            nAlimonyDed := nAlimonyDed * self:nIrTaxPercentage
            nAlimonySus := nAlimonySus * self:nIrTaxPercentage
        endIf

        aadd( aDedDetail, { cDedussion, nAlimonyDed, nAlimonySus, "", aClone(aDepPen), "" } )
        fwFreeArray(aDepPen)
        aDepPen	:= {}
    endIf

    if nIrfVal > 0 .or. lSusp
        if lIRPF
            nSimpDed:= self:loadIRSimplified(Firstday(dGenerationDate), Lastday(dGenerationDate))
            lSimpDed := nSimpDed > 0
            if lSimpDed 
                if self:isFirstDeduction(dGenerationDate)
                    cDedussion := "8"
                    if self:lCpfFkj
                        nSimpDed := nSimpDed * self:nIrTaxPercentage
                    endIf
                    aadd( aDedDetail, { cDedussion, nSimpDed, 0, "", {}, "" } )
                else
                    nSimpDed := 0
                endIf
            endIf
        endIf
        if !lSimpDed
            if nInssVal > 0 .and. lDedIns
                cDedussion := "1"
                if lSusp
                    nBaseDedSus := nInssVal
                else
                    nBaseDedVal := nInssVal
                endIf

                if self:lCpfFkj
                    nBaseDedVal := nBaseDedVal * self:nIrTaxPercentage
                    nBaseDedSus := nBaseDedSus * self:nIrTaxPercentage
                endIf

                aadd( aDedDetail, { cDedussion, nBaseDedVal, nBaseDedSus, "", {}, "" } )
            endIf

            if nNumOfDep > 0
                nDepValue := self:getDepDedussionValue(dGenerationDate, nNumOfDep)
                if nDepValue > 0
                    cDedussion := "7"
                    if lSusp
                        nBaseDedSus := nDepValue
                    else
                        nBaseDedVal := nDepValue
                    endIf
                    aDepPen := self:loadDependentsOnAlimony("2", lSusp)

                    if self:lCpfFkj
                        nBaseDedVal := nBaseDedVal * self:nIrTaxPercentage
                        nBaseDedSus := nBaseDedSus * self:nIrTaxPercentage
                    endIf
                    
                    aadd( aDedDetail, { cDedussion, nBaseDedVal, nBaseDedSus, "", aDepPen, "" } )
                endIf
            endIf
        endIf
    endIf

    aDepPen := {}

    restArea(aAreaFKG)
    restArea(aArea)

return


//-------------------------------------------------------------------
/*{Protheus.doc} loadTaxReliefs
    @description Carrega os jsons com os códigos das ações dos tipos de deduções e isenções do REINF 
                    utilizando as chaves de deduções e isenções do Protheus
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 06/04/2025
    @return
*/
//-------------------------------------------------------------------
method loadTaxReliefs() class DataBlockT154
    
    self:jDeductionType[PRIVATE_PENSION] := '2'
    self:jDeductionType[FAPI] := "3"
    self:jDeductionType[FUNPRESP] := "4"
    self:jDeductionType[ALIMONY] := "5"
    self:jDeductionType[DEPENDENTS] := "7"

    self:jExemptionsType[OTHERS] := "99"
    self:jExemptionsType[TAX_EXEMPT_AGE_65_PLUS] := "1"
    self:jExemptionsType[TRAVEL_ALLOWANCE] := "2"
    self:jExemptionsType[CONTRACT_TERMINATION_COMPENSATION] := "3"
    self:jExemptionsType[CASH_BONUS] := "4"
    self:jExemptionsType[PAYMENT_TO_MICROENTERPRISE_PARTNER] := "5"
    self:jExemptionsType[RETIREMENT_DUE_TO_SERIOUS_ILLNESS] := "6"
    self:jExemptionsType[PENSION_SUPPLEMENT_CONTRIBUTIONS] := "7"
    self:jExemptionsType[EXPENSE_ALLOWANCE] := "8"
    self:jExemptionsType[LATE_PAYMENT_INTEREST] := "10"
    self:jExemptionsType[PENSION_WITHDRAWAL_SERIOUS_ILLNESS] := "11"
    self:jExemptionsType[OTHERS_TECHIICAL_NOTE] := "99"

return

//-------------------------------------------------------------------
/*/{Protheus.doc} isFirstDeduction
Verifica se a Dedução do fornecedor é a primeira do período

@param dGenerationDate  , Date, Data do fato gerador do IRPF

@return lRet - retorna .T. se o CPF é de outro participante

@author Rodrigo Oliveira
@since 31/01/2023
@version P12
/*/
//-------------------------------------------------------------------
method isFirstDeduction(dGenerationDate as date) as logical class DataBlockT154
	local lRet		    := .F. as Logical
	local cQuery		:= ""  as character
	local cAliasQry	    := ""  as character
	local cSupplier     := ""  as character
	local cUnit         := ""  as character
    local nParamOrder   := 1   as numeric
	
	cSupplier   := (self:cPortfolioAlias)->E2_FORNECE
	cUnit       := (self:cPortfolioAlias)->E2_LOJA

	Default dGenerationDate	:= CTOD("  /  /  ")

	if !empty(cSupplier+cUnit) .And. !empty(dGenerationDate)
        
        if self:oFirstDedStatement == Nil
            cQuery  := " SELECT E2_NUM NUM "
            cQuery  += " FROM " + retSqlName("SE2") + " SE2 "
            cQuery  += " INNER JOIN " + retSqlName("SA2") + " SA2 "
            cQuery  += "    ON " + FWJoinFilial("SA2", "SE2")
            cQuery  += "    AND E2_FORNECE = A2_COD "
            cQuery  += "    AND E2_LOJA = A2_LOJA "
            cQuery  += "    AND ( ( ( A2_CALCIRF = ? AND E2_IRRF > ? ) OR ( A2_CALCIRF = ? AND E2_BAIXA < ?) ) "
            if self:cIssueDateParameter == ACCOUNTING_DATE
                cQuery  += " AND E2_EMIS1 < ? AND SUBSTRING(E2_EMIS1,1,6) = ? ) "
            else
                cQuery  += " AND E2_EMISSAO < ? AND SUBSTRING(E2_EMISSAO,1,6) = ? ) "
            endIf
            cQuery  += "    AND SA2.D_E_L_E_T_ = ? "
            cQuery  += " INNER JOIN " + retSqlName("SED") + " SED "
            cQuery  += "    ON " + FWJoinFilial("SED", "SE2")
            cQuery  += "    AND ED_CODIGO = E2_NATUREZ "
            cQuery  += "    AND ED_CALCIRF = ? "
            cQuery  += "    AND ED_PERCIRF > ? "
            cQuery  += "    AND SED.D_E_L_E_T_ = ? "
            cQuery  += " WHERE E2_FILIAL = ? "
            cQuery  += " AND E2_FORNECE = ? "
            cQuery  += " AND E2_LOJA = ? "
            cQuery  += " AND SE2.D_E_L_E_T_ = ? "

            cQuery  += " UNION"

            cQuery  += " SELECT E2_NUM NUM "
            cQuery  += " FROM " + retSqlName("SE2") + " SE2 "
            cQuery  += " INNER JOIN " + retSqlName("SA2") + " SA2 "
            cQuery  += "    ON " + FWJoinFilial("SA2", "SE2")
            cQuery  += "    AND E2_FORNECE = A2_COD "
            cQuery  += "    AND E2_LOJA = A2_LOJA "
            cQuery  += "    AND ( ( ( A2_CALCIRF = ? AND E2_IRRF > ? ) OR ( A2_CALCIRF = ? AND E2_BAIXA < ?) ) "
            if self:cIssueDateParameter == ACCOUNTING_DATE
                cQuery  += " AND E2_EMIS1 < ? AND SUBSTRING(E2_EMIS1,1,6) = ? ) "
            else
                cQuery  += " AND E2_EMISSAO < ? AND SUBSTRING(E2_EMISSAO,1,6) = ? ) "
            endIf
            cQuery  += "    AND SA2.D_E_L_E_T_ = ? "
            cQuery  += " INNER JOIN " + retSqlName("FK7") + " FK7 "
            cQuery  += "   ON FK7.FK7_ALIAS = ? "
            cQuery  += "    AND FK7.FK7_FILTIT = SE2.E2_FILIAL "
            cQuery  += "    AND FK7.FK7_PREFIX = SE2.E2_PREFIXO "
            cQuery  += "    AND FK7.FK7_NUM = SE2.E2_NUM "
            cQuery  += "    AND FK7.FK7_PARCEL = SE2.E2_PARCELA "
            cQuery  += "    AND FK7.FK7_TIPO = SE2.E2_TIPO "
            cQuery  += "    AND FK7.FK7_CLIFOR = SE2.E2_FORNECE "
            cQuery  += "    AND FK7.FK7_LOJA = SE2.E2_LOJA "
            cQuery  += "    AND FK7.D_E_L_E_T_ = ? "
            cQuery  += " RIGHT JOIN " + retSqlName("FKF") + " FKF "
            cQuery  += "    ON FKF.FKF_FILIAL = ? "
            cQuery  += "    AND FKF_IDDOC = FK7_IDDOC "
            cQuery  += "    AND FKF_REINF = ? "
            cQuery  += "    AND FKF.D_E_L_E_T_ = ? "
            cQuery  += " INNER JOIN " + retSqlName("SED") + " SED "
            cQuery  += "    ON " + FWJoinFilial("SED", "SE2")
            cQuery  += "    AND ED_CODIGO = E2_NATUREZ "
            cQuery  += "    AND ED_CALCIRF = ? "
            cQuery  += "    AND ED_PERCIRF > ? "
            cQuery  += "    AND SED.D_E_L_E_T_ = ? "
            cQuery  += " WHERE E2_FILIAL = ? "
            cQuery  += " AND E2_FORNECE = ? "
            cQuery  += " AND E2_LOJA = ? "
            cQuery  += " AND SE2.D_E_L_E_T_ = ? "

            self:oFirstDedStatement	:= FwExecStatement():New(cQuery)
        endIf
        
        self:oFirstDedStatement:setString( nParamOrder++, '1')
        self:oFirstDedStatement:setNumeric( nParamOrder++, 0)
        self:oFirstDedStatement:setString( nParamOrder++, '2')
        self:oFirstDedStatement:setDate( nParamOrder++, dGenerationDate)
        self:oFirstDedStatement:setDate( nParamOrder++, dGenerationDate)
        self:oFirstDedStatement:setString( nParamOrder++, subStr(Dtos(dGenerationDate), 1, 6))
        self:oFirstDedStatement:setString( nParamOrder++, ' ')
        self:oFirstDedStatement:setString( nParamOrder++, 'S')
        self:oFirstDedStatement:setNumeric( nParamOrder++, 0)
        self:oFirstDedStatement:setString( nParamOrder++, ' ')
        self:oFirstDedStatement:setString( nParamOrder++, xFilial("SE2"))
        self:oFirstDedStatement:setString( nParamOrder++, cSupplier)
        self:oFirstDedStatement:setString( nParamOrder++, cUnit )
        self:oFirstDedStatement:setString( nParamOrder++, ' ')
        self:oFirstDedStatement:setString( nParamOrder++, '1')
        self:oFirstDedStatement:setNumeric( nParamOrder++, 0)
        self:oFirstDedStatement:setString( nParamOrder++, '2')
        self:oFirstDedStatement:setDate( nParamOrder++, dGenerationDate)
        self:oFirstDedStatement:setDate( nParamOrder++, dGenerationDate)
        self:oFirstDedStatement:setString( nParamOrder++, subStr(Dtos(dGenerationDate), 1, 6))
        self:oFirstDedStatement:setString( nParamOrder++, ' ')
        self:oFirstDedStatement:setString( nParamOrder++, 'SE2')
        self:oFirstDedStatement:setString( nParamOrder++, ' ')
        self:oFirstDedStatement:setString( nParamOrder++, xFilial("FKF") )
        self:oFirstDedStatement:setString( nParamOrder++, '1')
        self:oFirstDedStatement:setString( nParamOrder++, ' ')
        self:oFirstDedStatement:setString( nParamOrder++, 'S')
        self:oFirstDedStatement:setNumeric( nParamOrder++, 0)
        self:oFirstDedStatement:setString( nParamOrder++, ' ')
        self:oFirstDedStatement:setString( nParamOrder++, xFilial("SE2"))
        self:oFirstDedStatement:setString( nParamOrder++, cSupplier)
        self:oFirstDedStatement:setString( nParamOrder++, cUnit )
        self:oFirstDedStatement:setString( nParamOrder++, ' ')
            
        cAliasQry := self:oFirstDedStatement:openAlias()
        
        if empty((cAliasQry)->NUM)
            lRet	:= .T.
        endIf
        (cAliasQry)->(DbCloseArea())
	endIf

return lRet



//-------------------------------------------------------------------
/*/{Protheus.doc} loadDependentsOnAlimony
Quando houver dedução do IRPF por dependentes ou pensão alimenticia,
essa função retornará o detalhamento das deduções para cada dependente

@param cTipDed - Tipo da dedução: 1=Pensão Alimenticia / 2=Dependente
@param lSusp   - Indentifica se dedução foi suspensa por um processo adm/juridico

@return Nil

@author fabio.casagrande
@since 15/03/2023
/*/
//-------------------------------------------------------------------
method loadDependentsOnAlimony(cTipDed as character, lSusp as logical) as array class DataBlockT154
	local aArea         := {} as array
	local aAreaFKG      := {} as array
	local aDepPen       := {} as array
	local cQuery        := "" as character
	local cDepCPF       := "" as character
	local cLayout       := "" as character
    local nParamOrder   := 1 as numeric

	Default cTipDed	:= "1"
	Default lSusp := .F.

	if lSusp
		cLayout := "T154AM"
	else
		cLayout := "T154AK"
	endIf

    aArea    := getArea()
	aAreaFKG := FKG->( GetArea() )

	DbSelectArea("FKG")
	FKG->(DBSetOrder(2)) //FKG_FILIAL+FKG_IDDOC+FKG_TPIMP
	if FKG->( MsSeek( xFilial("FKG") + self:cIdDoc ) )
		while FKG->( !Eof() ) .And. alltrim( FKG->( FKG_FILIAL + FKG_IDDOC ) ) == alltrim( xFilial("FKG") + self:cIdDoc )
			if !empty(FKG->FKG_CODDEP) .And. ((cTipDed == "1" .And. FKG->FKG_TPATRB $ "013   ") .Or. (cTipDed == "2" .And. FKG->FKG_TPATRB $ "024   "))
				
				if self:oDHTStatement == NIL
					cQuery	:= " SELECT DHT_CPF "
					cQuery	+= " FROM " + retSqlName("DHT") + " DHT "
					cQuery	+= " WHERE DHT.DHT_FILIAL = ? "
					cQuery	+= " AND DHT.DHT_FORN = ? "
					cQuery	+= " AND DHT.DHT_LOJA = ? "
					cQuery	+= " AND DHT.DHT_COD = ? "
					cQuery	+= " AND DHT.D_E_L_E_T_ = ? "

					cQuery := ChangeQuery( cQuery )

					self:oDHTStatement := FWExecStatement():New( cQuery )
				endIf

				self:oDHTStatement:SetString( nParamOrder++, xFilial("DHT"))
				self:oDHTStatement:SetString( nParamOrder++, (self:cPortfolioAlias)->E2_FORNECE)
				self:oDHTStatement:SetString( nParamOrder++, (self:cPortfolioAlias)->E2_LOJA)
				self:oDHTStatement:SetString( nParamOrder++, FKG->FKG_CODDEP )
                self:oDHTStatement:setString( nParamOrder++, " " )
                
				cDepCPF := self:oDHTStatement:execScalar("DHT_CPF")
                
                nParamOrder := 1

				if !empty(cDepCPF)
					aadd( aDepPen, { cLayout, cDepCPF, FKG->FKG_VALOR } )	
				endIf
			endIf
			FKG->( dbSkip() )
		endDo
	endIf

	restArea(aAreaFKG)
    restArea(aArea)

Return aDepPen


//-------------------------------------------------------------------
/*/{Protheus.doc} loadIRSimplified
Função que retorna valor de dedução do IR Simplificado, caso ocorra.

@param dInitDate , Date, Data inicial de processamento
@param dFinalDate , Date, Data final de processamento

@return nSimpDed - Numeric, com o valor de dedução, caso seja 0, 
a ultima retenção o calculo foi realizado via tabela. (FK4_DEDIRS)

@author Pâmela Bernardo
@since 04/01/2023
@version P12
/*/
//-------------------------------------------------------------------
method loadIRSimplified(dInitDate as date, dFinalDate as date) as numeric class DataBlockT154
	local aArea         := {} as array
	local aAreaFKW	    := {} as array
	local cQuery	    := "" as character
	local cTaxType	    := "" as character
	local lValidCPF	    := .T. as logical
	local nSimpDed	    := 0 as numeric
    local nParamOrder   := 1 as numeric
	local nTamTPIMP	    := 0 as numeric
	
	default dInitDate := DDataBase
	default dFinalDate := DDataBase

    nTamTPIMP := tamSX3("FKW_TPIMP")[1]
    cTaxType	  := "IRF"+Space(nTamTPIMP-3)

	aArea		:= GetArea()
	aAreaFKW	:= FKW->(GetArea())
    
    dbSelectArea('FKW')
	FKW->(DbSetOrder(3)) //FKW_FILIAL+FKW_IDDOC+FKW_TPIMP+FKW_CGC
	if FKW->(MsSeek(xFilial("FKW")+self:cIdDoc+cTaxType))
		if !empty(FKW->FKW_CGC)
			 lValidCPF := FKW->(MsSeek(xFilial("FKW")+self:cIdDoc+cTaxType+self:cSupplierID))
		endIf
		if !self:lIRTaxInPayment
			 lValidCPF := FKW->FKW_VLIMP > 0
		endIf
		if lValidCPF
			if self:oIRSimpStatement == NIL 
				cQuery := "SELECT FK4_DEDIRS "
				cQuery += " FROM " + retSqlName("FK4") + " FK4 "
				cQuery += " WHERE FK4.FK4_CGC = ? "
				cQuery += " AND FK4.FK4_IMPOS = ? "
				cQuery += " AND FK4.FK4_DATA BETWEEN ? AND ? "
				cQuery += " AND FK4.FK4_CODRET = ? "
				cQuery += " AND FK4.FK4_RECPAG = ? "
				cQuery += " AND FK4.FK4_STATUS = ? "
				cQuery += " AND FK4.D_E_L_E_T_ = ? "
				cQuery += " AND EXISTS ( "
				cQuery += " 	SELECT FK3_IDRET "
				cQuery += " 	FROM " + retSqlName("FK3") + " FK3 "
				cQuery += " 	WHERE " + FWJoinFilial("FK3", "FK4")
				cQuery += " 	AND FK3.FK3_IDORIG = FK4.FK4_IDORIG "
				cQuery += " 	AND FK3.FK3_IDRET = FK4.FK4_IDFK4 "
				cQuery += " 	AND FK3.D_E_L_E_T_ = ? ) "
				cQuery += " ORDER BY R_E_C_N_O_ DESC "

				cQuery	:= ChangeQuery(cQuery)				

				self:oIRSimpStatement	:= FWExecStatement():New(cQuery)
			endIf

			self:oIRSimpStatement:SetString( nParamOrder++, self:cSupplierID)
			self:oIRSimpStatement:SetString( nParamOrder++, 'IRF')
			self:oIRSimpStatement:SetString( nParamOrder++, Dtos(dInitDate))
			self:oIRSimpStatement:SetString( nParamOrder++, Dtos(dFinalDate))
			self:oIRSimpStatement:SetString( nParamOrder++, (self:cPortfolioAlias)->E2_CODRET)
			self:oIRSimpStatement:SetString( nParamOrder++, 'P')
			self:oIRSimpStatement:SetString( nParamOrder++, '1')
			self:oIRSimpStatement:SetString( nParamOrder++, ' ')
			self:oIRSimpStatement:SetString( nParamOrder++, ' ')
            
			nSimpDed := self:oIRSimpStatement:execScalar("FK4_DEDIRS")
		endIf
	endIf
	RestArea(aAreaFKW)
	RestArea(aArea)
return nSimpDed


//-----------------------------------------------------------------------------------------------
/*/{Protheus.doc} getDepDedussionValue
Função para retornar o valor da deducao da base do IRPF pelo numero total de dependentes

@param dGenerationDate  , Date, Data do fato gerador do IRPF
@param nNumOfDep, Numeric, Quantidade de depenentes do fornecedor (A2_NUMDEP)
@param cIdDoc, Character, ID do título

@return nDepDedValue, Numeric, valor da deducao de dependentes da base do IRPF 

@author fabio.casagrande
@since 27/12/2022
/*/
//-----------------------------------------------------------------------------------------------
method getDepDedussionValue(dGenerationDate as date, nNumOfDep as numeric) as numeric class DataBlockT154
	Local cMonth	    := "" as character
	Local cYear	        := "" as character
	Local nDepDedValue  := 0  as numeric
	Local nDepValue     := 0  as numeric 

	Default dGenerationDate 	:= CTOD("  /  /    ")
	Default nNumOfDep := 0
	
	if !empty(dGenerationDate)
		cMonth := STRZERO(MONTH(dGenerationDate),2)
		cYear := STRZERO(YEAR(dGenerationDate),4)
	endIf

	nDepValue := F992RetVal(cMonth, cYear)
	nDepDedValue := 0

	if nDepValue > 0 .And. self:isFirstDeduction(dGenerationDate)
		nDepDedValue := nDepValue * nNumOfDep
	endIf

Return nDepDedValue



//-------------------------------------------------------------------
/*/{Protheus.doc} isTaxesOnEmission
Propositos:
1) Verifica se há retenção/suspenção/isenção/dedução para o IRF com o 
fato gerador na emissão e vinculado com natureza(s) de rendimento.
2) Verifica se há vinculo do titulo com a natureza de rendimento 
e não possui calculo de IR/PCC e se será gerado pela emissão (T154).

Objetivo:
Atribuir os dados para o array "aT154Trb", responsavel por gerar os dados
para os registros T154AG e T154AH.

@param	aT154Trb  - Array com os dados do IRRF
@param	lIndividualSupp   - Informa .T. se o fornecedor do titulo é pessoa fisica
@param	dEmisDate   - Data emissao do titulo
@param  lSusp     - Informa .T. se o título tem suspenção de IR
@param  nSimpDed  - Valor de dedução IR SIMPLifICADO
@param  lSimpDed  - Indica se houve dedução simplificada

@return lRet - Retorna .T. se encontrou dados para gerar o T154AG/T154AH

@author fabio.casagrande
@since 13/01/2023
@version P12
/*/
//-------------------------------------------------------------------
method isTaxesOnEmission(aT154Trb as array, lIndividualSupp as logical, dEmisDate as date, lSusp as logical, nSimpDed as numeric, lSimpDed as logical ) as logical class DataBlockT154
	local aTaxes            := {}   as array
	local cAliasFKW         := ""   as character
	local cQuery            := ""   as character
	local cTaxCode          := ""   as character
	local cIRTax            := ""   as character
	local cWithoutTax       := ""   as character
	local cTax              := ""   as character
	local lRet	            := .F.  as logical
	local lWithoutTax       := .F.  as logical
	local nDepDed           := 0    as numeric
	local nGrossIncome      := 0    as numeric
	local nTaxableIncome    := 0    as numeric
	local nTaxesValue       := 0    as numeric
	local nNumOfDep         := 0    as numeric
    local nFKWImpSize       := 0    as numeric
	local nFKWProcSize 		:= 1    as numeric
    local nParamOrder       := 1    as numeric

	Default aT154Trb  := {}
	Default lIndividualSupp   := .F.
	Default dEmisDate   := CTOD("  /  /    ")
	Default lSusp     := .F.
	Default nSimpDed  := 0
	Default lSimpDed  := .F.
    
    nFKWImpSize  := tamSX3("FKW_TPIMP")[1]
	nFKWProcSize := TamSx3("FKW_NUMPRO")[1]
	cIRTax	 := PadR( 'IRF', nFKWImpSize )
	cWithoutTax	 := PadR( 'SEMIMP', nFKWImpSize )
	cTax   := cIRTax + "|" + cWithoutTax
	aTaxes   := StrtoKarr2( cTax, "|", .F.)

	if self:oFKWStatement == Nil 
		cQuery := "SELECT FKW_NATREN, FKW_CGC CPF, FKW_TPIMP, "
		cQuery += "ISNULL(SUM(FKW_BASETR),0) FKW_BASETR, "
		cQuery += "ISNULL(SUM(FKW_VLIMP),0) FKW_VLIMP, "
		cQuery += "ISNULL(SUM(FKW_BASENR),0) FKW_BASENR, "
		cQuery += "ISNULL(SUM(FKW_VLIMPN),0) FKW_VLIMPN, "
        cQuery += "ISNULL(SUM(FKW_VLBRUT),0) FKW_VLBRUT "  
		cQuery += "FROM " + retSqlName("FKW") + " FKW "
		cQuery += "WHERE FKW_FILIAL = ? "
		cQuery += " AND FKW_IDDOC IN ( ? )  "
		cQuery += " AND FKW_CARTEI = ? "
		cQuery += " AND FKW_TPIMP IN ( ? ) "
		cQuery += " AND FKW.D_E_L_E_T_ = ? "
		cQuery += "GROUP BY FKW_NATREN, FKW_CGC, FKW_TPIMP "
		
        cQuery := ChangeQuery(cQuery)
        
        self:oFKWStatement := FwExecStatement():New(cQuery)
	endIf

	self:oFKWStatement:SetString(nParamOrder++, xFilial("FKW") )
	self:oFKWStatement:SetIn(nParamOrder++, self:aInstallmentsId )
	self:oFKWStatement:SetString(nParamOrder++, "1")
	self:oFKWStatement:SetIn(nParamOrder++, aTaxes)
	self:oFKWStatement:SetString(nParamOrder++, ' ')

	cAliasFKW := self:oFKWStatement:OpenAlias()

	while !(cAliasFKW)->(eof())
		if (cAliasFKW)->FKW_TPIMP == cIRTax
            if self:lIRTaxAggregated .and. agregTrib((cAliasFKW)->FKW_NATREN, "2", "1", {self:cIdDoc}, nFKWImpSize, nFKWProcSize)
                (cAliasFKW)->(dbSkip())
                loop
            endIf
			cTaxCode := "12"
		elseIf (cAliasFKW)->FKW_TPIMP  == cWithoutTax .And. self:validateWithoutTaxes((cAliasFKW)->FKW_NATREN)
			cTaxCode := "SEMIMP"
			lWithoutTax := .T.
		else
			(cAliasFKW)->( DbSkip())
			Loop
		endIf

		if (cAliasFKW)->FKW_VLBRUT > 0
			nGrossIncome := (cAliasFKW)->FKW_VLBRUT
		else
			nGrossIncome := (cAliasFKW)->FKW_BASETR+(cAliasFKW)->FKW_BASENR
		endIf

		nTaxableIncome := (cAliasFKW)->FKW_BASETR
		nTaxesValue := (cAliasFKW)->FKW_VLIMP

		if lSusp .And. !lWithoutTax
			nTaxableIncome := (cAliasFKW)->FKW_BASETR+(cAliasFKW)->FKW_BASENR
			nTaxesValue := (cAliasFKW)->FKW_VLIMP+(cAliasFKW)->FKW_VLIMPN
		endIf

		if lIndividualSupp .and. !lSusp .And. !lWithoutTax
			if lSimpDed
				nTaxableIncome += (cAliasFKW)->FKW_BASENR
				if Alltrim((self:cPortfolioAlias)->E2_ORIGEM) $ "MATA461|MATA460|MATA103|MATA100"
					nGrossIncome += nSimpDed
				else
					nTaxableIncome -= nSimpDed
				endIf
			else	
				nNumOfDep  := (self:cPortfolioAlias)->A2_NUMDEP
				nDepDed  := self:getDepDedussionValue(dEmisDate, nNumOfDep)
				nTaxableIncome -= nDepDed 
			endIf
		endIf


		if nGrossIncome > 0
            if self:lCpfFkj .and. empty((cAliasFKW)->CPF)
                nGrossIncome := nGrossIncome * self:nIrTaxPercentage
                nTaxesValue := nTaxesValue * self:nIrTaxPercentage
                nTaxableIncome := nTaxableIncome * self:nIrTaxPercentage
            endIf
			lRet := .T.
			AAdd( aT154Trb,{cTaxCode,(cAliasFKW)->FKW_NATREN, nGrossIncome, nTaxableIncome, nTaxesValue, alltrim((cAliasFKW)->CPF)})
		endIf

		(cAliasFKW)->( DbSkip() )
	endDo

	(cAliasFKW)->(dbCloseArea())

	FWFreeArray(aTaxes)
	aIdDoc := {}
	aTaxes := {}

Return lRet


//-------------------------------------------------------------------------
/*/{Protheus.doc} validateWithoutTaxes
Quando o rendimento não possui os tributos do bloco 40 (IR e PCC),
verifica se pode ser gerado para o fato gerador Emissão (T154AG).

@param cIncomeNature, Char, Natureza de Rendimento

@return lRet, Logical, Verdadeiro se o rendimento pode ser enviado

@author Fabio Casagrande Lima
@since  22/09/2023
/*/
//-------------------------------------------------------------------------
method validateWithoutTaxes(cIncomeNature as character) as logical class DataBlockT154
	Local lRet := .F. as logical

	Default cIncomeNature := ""

	if (Substr(cIncomeNature,1,2) == "20" .And. !self:lIRTaxInPayment)
		lRet := .T.
	endIf

Return lRet

//-------------------------------------------------------------------
/*{Protheus.doc} loadSupplierID
    @description Carrega o conteúdo da propriedade cSupplierID de acordo com a regra de negócio.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 19/05/2025
    @return
*/
//-------------------------------------------------------------------
method loadSupplierID() class DataBlockT154
    self:lCpfFkj := .F.
    if !empty((self:cPortfolioAlias)->FKJ_CPF)
        self:cSupplierID := (self:cPortfolioAlias)->FKJ_CPF
        self:lCpfFkj := .T.
    elseIf (self:cPortfolioAlias)->A2_TIPO == "J" .And. (self:cPortfolioAlias)->A2_IRPROG == "1"
        self:cSupplierID := (self:cPortfolioAlias)->A2_CPFIRP
    else
        self:cSupplierID := (self:cPortfolioAlias)->A2_CGC 
    endIf
return

//-------------------------------------------------------------------
/*{Protheus.doc} getInstallmentValue
    @description Retorna valor da parcela do título.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 20/05/2025
    @return
*/
//-------------------------------------------------------------------
method getInstallmentValue() as numeric class DataBlockT154
    local nInstallmentValue := 0 as numeric

    nInstallmentValue := (self:cPortfolioAlias)->E2_VLCRUZ + (self:cPortfolioAlias)->E2_INSS + (self:cPortfolioAlias)->E2_SEST
        
    if !self:lIRTaxInPayment
        nInstallmentValue += (self:cPortfolioAlias)->E2_IRRF
    endIf	
    
    if !self:lIssinPayment
        nInstallmentValue += (self:cPortfolioAlias)->E2_ISS
    endIf

    if !self:lPCCinPayment
        nInstallmentValue += (self:cPortfolioAlias)->E2_PIS + (self:cPortfolioAlias)->E2_COFINS + (self:cPortfolioAlias)->E2_CSLL
    endIf
return nInstallmentValue

//-------------------------------------------------------------------
/*{Protheus.doc} loadT154ACData
    @description Retorna valor da parcela do título.
    @type Method
    @param cIdDocParc, Character, ID da FK7 da parcela
    @version 12.1.2410
    @author guilhermed.santos
    @since 20/05/2025
    @return
*/
//-------------------------------------------------------------------
method loadT154ACData(cIdDocParc as character) class DataBlockT154
    local aArea         := {} as array
    local aAreaFK7      := {} as array
    
    default cIdDocParc := self:cIdDoc

    aArea    := getArea()
    aAreaFK7 := FK7->(getArea())
    
    dbSelectArea('FK7')
    FK7->(dbSetOrder(5)) //FK7_IDDOC
    if FK7->(dbSeek(cIdDocParc))
        if FK7->FK7_ALIAS == 'SE1'
            self:loadT154ACReceivableStatement()
        else
            self:loadT154ACPayableStatement()
        endIf
    endIf

    if !(self:cT154ACAlias)->(eof())
        self:lHasT154AC := .T.
    endIf

    restArea(aAreaFK7)
    restArea(aArea)
return

//-------------------------------------------------------------------
/*{Protheus.doc} loadT154ACPayableStatement
    @description Carrega a consulta do T154AC para o Contas a Pagar.
    @type Method
    @param cIdDocParc, Character, ID da FK7 da parcela
    @version 12.1.2410
    @author guilhermed.santos
    @since 24/07/2025
    @return
*/
//-------------------------------------------------------------------
method loadT154ACPayableStatement(cIdDocParc as character) class DataBlockT154
    local cQuery := "" as character
    local nParamOrder := 1 as numeric
    local oT154ACStatement := Nil as object

    default cIdDocParc := self:cIdDoc

    cQuery := " SELECT FK2_IDFK2 IDFK, "
    if self:cSettlementDisplayMode == WRITE_OFF_DATE
        cQuery += "     FK2_DATA DATABX "
    else
        cQuery += "     FK2_DTDISP DATABX "
    endIf
    cQuery += "     , FK2.FK2_VALOR VALOR, FK2_SEQ SEQ, E2_SALDO SALDO, "
    cQuery += "     E2_INSS INSS, E2_COFINS COFINS, E2_CSLL CSLL, E2_PIS PIS, E2_IRRF IRRF, E2_ISS ISS, "
    cQuery += "     E2_DECRESC DECRESC, E2_JUROS JUROS, E2_ACRESC ACRESC, E2_MULTA MULTA "
    cQuery += " FROM " + retSqlName("FK7") + " FK7 "
    cQuery += "    INNER JOIN " + retSqlName("SE2") + " SE2 "
    cQuery += "         ON SE2.E2_FILIAL = FK7.FK7_FILTIT "
    cQuery += "         AND SE2.E2_PREFIXO = FK7.FK7_PREFIX "
    cQuery += "         AND SE2.E2_NUM = FK7.FK7_NUM "
    cQuery += "         AND SE2.E2_PARCELA = FK7.FK7_PARCEL "
    cQuery += "         AND SE2.E2_TIPO = FK7.FK7_TIPO "
    cQuery += "         AND SE2.E2_FORNECE = FK7.FK7_CLIFOR "
    cQuery += "         AND SE2.E2_LOJA = FK7.FK7_LOJA "
    cQuery += "         AND SE2.D_E_L_E_T_ = ? "
    cQuery += "     INNER JOIN " + retSqlName("SED") + " SED "
    cQuery += "         ON " + FWJoinFilial("SED", "SE2")
    cQuery += "         AND SED.ED_CODIGO = SE2.E2_NATUREZ "
    cQuery += "         AND SED.D_E_L_E_T_ = ? "
    cQuery += "     INNER JOIN " + retSqlName("FK2") + " FK2 "
    cQuery += "         ON FK2.FK2_IDDOC = FK7.FK7_IDDOC "
    cQuery += "         AND FK2.FK2_RECPAG = ? "
    cQuery += "         AND FK2.FK2_TPDOC NOT IN ( ? ) "
    cQuery += "         AND FK2.FK2_MOTBX NOT IN ( ? ) "
    cQuery += "         AND FK2.D_E_L_E_T_ = ? "
    cQuery += "         AND NOT EXISTS (SELECT FK2EST.FK2_IDDOC "
    cQuery += "                         FROM " + retSqlName("FK2") + " FK2EST "
    cQuery += "                         WHERE FK2EST.FK2_FILIAL = FK2.FK2_FILIAL "
    cQuery += "                             AND FK2EST.FK2_IDDOC = FK2.FK2_IDDOC "
    cQuery += "                             AND FK2EST.FK2_SEQ = FK2.FK2_SEQ "
    cQuery += "                             AND FK2EST.FK2_TPDOC = ? "
    cQuery += "                             AND FK2EST.D_E_L_E_T_ = ? ) "
    cQuery += "     INNER JOIN " + retSqlName("SA2") + " SA2 "
    cQuery += "         ON " + FWJoinFilial("SA2", "SE2")
    cQuery += "         AND SA2.A2_COD = SE2.E2_FORNECE "
    cQuery += "         AND SA2.A2_LOJA = SE2.E2_LOJA "
    cQuery += "         AND SA2.D_E_L_E_T_ = ? "
    cQuery += "     INNER JOIN " + retSqlName("FKF") + " FKF "
    cQuery += "         ON " + FWJoinFilial("FKF", "FK2")
    cQuery += "         AND FKF.FKF_IDDOC = FK2.FK2_IDDOC "
    cQuery += "         AND FKF.D_E_L_E_T_ = ? "
    cQuery += " WHERE FK7_IDDOC = ? "
    cQuery += " AND FK7.FK7_TIPO NOT IN ? "
    cQuery += " AND SA2.A2_RECINSS = ? "
    cQuery += " AND SED.ED_CALCINS = ? "
    cQuery += " AND SE2.E2_INSS > ? "
    cQuery += " AND (FKF.FKF_TPSERV != ? OR FKF.FKF_TPREPA != ?) "
    cQuery += " AND FK7.D_E_L_E_T_ = ? "

    cQuery := ChangeQuery(cQuery)
        
    oT154ACStatement := FwExecStatement():New(cQuery)

	oT154ACStatement:setString(nParamOrder++, ' ')
	oT154ACStatement:setString(nParamOrder++, ' ')
	oT154ACStatement:setString(nParamOrder++, 'P')
	oT154ACStatement:setIn(nParamOrder++, {'DC', 'D2', 'JR', 'J2', 'TL', 'MT', 'M2', 'CM', 'C2', 'TR', 'TE', 'E2', 'CH', 'ES'})
	oT154ACStatement:setIn(nParamOrder++, {'FAT', 'LIQ', 'DEV', 'CMP'})
	oT154ACStatement:setString(nParamOrder++, ' ')
	oT154ACStatement:setString(nParamOrder++, 'ES')
	oT154ACStatement:setString(nParamOrder++, ' ')
	oT154ACStatement:setString(nParamOrder++, ' ')
	oT154ACStatement:setString(nParamOrder++, ' ')
	oT154ACStatement:setString(nParamOrder++, cIdDocParc)
	oT154ACStatement:setUnsafe(nParamOrder++, formatIn(MVABATIM+"|"+MVPROVIS+"|"+MV_CPNEG+"|"+MVIRABT+"|"+MVCSABT+"|"+MVCFABT+"|"+MVPIABT+"|"+MVISS+"|"+ MVTAXA+"|"+MVTXA+"|"+MVINSS+"|"+"SES","|"))
	oT154ACStatement:setString(nParamOrder++, 'S')
	oT154ACStatement:setString(nParamOrder++, 'S')
	oT154ACStatement:setNumeric(nParamOrder++, 0)
	oT154ACStatement:setString(nParamOrder++, ' ')
	oT154ACStatement:setString(nParamOrder++, ' ')
	oT154ACStatement:setString(nParamOrder++, ' ')

    self:cT154ACAlias := oT154ACStatement:OpenAlias()

    oT154ACStatement:destroy()
return

//-------------------------------------------------------------------
/*{Protheus.doc} loadT154ACReceivableStatement
    @description Carrega a consulta do T154AC para o Contas a Receber.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 24/07/2025
    @return
*/
//-------------------------------------------------------------------
method loadT154ACReceivableStatement() class DataBlockT154
    local cQuery := "" as character
    local nParamOrder := 1 as numeric
    local oT154ACStatement := Nil as object

    cQuery := " SELECT FK1_IDFK1 IDFK, "
    if self:cSettlementDisplayMode == WRITE_OFF_DATE
        cQuery += "     FK1_DATA DATABX "
    else
        cQuery += "     FK1_DTDISP DATABX "
    endIf
    cQuery += "     , FK1.FK1_VALOR VALOR, FK1_SEQ SEQ, E1_SALDO SALDO,  "
    cQuery += "     E1_INSS INSS, E1_COFINS COFINS, E1_CSLL CSLL, E1_PIS PIS, E1_IRRF IRRF, E1_ISS ISS,  "
    cQuery += "     E1_DECRESC DECRESC, E1_JUROS JUROS, E1_ACRESC ACRESC, E1_MULTA MULTA "
    cQuery += " FROM " + retSqlName("FK7") + " FK7 "
    cQuery += "     INNER JOIN " + retSqlName("SE1") + " SE1 "
    cQuery += "         ON SE1.E1_FILIAL = FK7.FK7_FILTIT "
    cQuery += "         AND SE1.E1_PREFIXO = FK7.FK7_PREFIX "
    cQuery += "         AND SE1.E1_NUM = FK7.FK7_NUM "
    cQuery += "         AND SE1.E1_PARCELA = FK7.FK7_PARCEL "
    cQuery += "         AND SE1.E1_TIPO = FK7.FK7_TIPO "
    cQuery += "         AND SE1.E1_CLIENTE = FK7.FK7_CLIFOR "
    cQuery += "         AND SE1.E1_LOJA = FK7.FK7_LOJA "
    cQuery += "         AND SE1.E1_TIPO NOT IN ? "
    cQuery += "         AND SE1.E1_FATURA NOT IN ( ? ) "
    cQuery += "         AND SE1.E1_NUMLIQ = ? "
    cQuery += "         AND SE1.D_E_L_E_T_ = ? "
    cQuery += "     INNER JOIN " + retSqlName("SED") + " SED "
    cQuery += "         ON " + FWJoinFilial("SED", "SE1")
    cQuery += "         AND SED.ED_CODIGO = SE1.E1_NATUREZ "
    cQuery += "         AND SED.D_E_L_E_T_ = ? "
    cQuery += "     INNER JOIN " + retSqlName("FK1") + " FK1 "
    cQuery += "         ON FK1.FK1_IDDOC = FK7.FK7_IDDOC "
    cQuery += "         AND FK1.FK1_RECPAG = ? "
    cQuery += "         AND FK1.FK1_TPDOC NOT IN ( ? ) "
    cQuery += "         AND FK1.FK1_MOTBX NOT IN ( ? ) "
    cQuery += "         AND FK1.D_E_L_E_T_ = ? "
    cQuery += "         AND NOT EXISTS "
    cQuery += "         (SELECT FK1EST.FK1_IDDOC "
    cQuery += "             FROM " + retSqlName("FK1") + " FK1EST "
    cQuery += "             WHERE FK1EST.FK1_FILIAL = FK1.FK1_FILIAL "
    cQuery += "                 AND FK1EST.FK1_IDDOC = FK1.FK1_IDDOC "
    cQuery += "                 AND FK1EST.FK1_SEQ = FK1.FK1_SEQ "
    cQuery += "                 AND FK1EST.FK1_TPDOC = ? "
    cQuery += "                 AND FK1EST.D_E_L_E_T_ = ? ) "
    cQuery += "     INNER JOIN " + retSqlName("SA1") + " SA1 "
    cQuery += "         ON " + FWJoinFilial("SA1", "SE1")
    cQuery += "         AND SA1.A1_COD = FK7.FK7_CLIFOR "
    cQuery += "         AND SA1.A1_LOJA = FK7.FK7_LOJA "
    cQuery += "         AND SA1.A1_PESSOA = ? "
    cQuery += "         AND SA1.D_E_L_E_T_ = ? "
    cQuery += "     INNER JOIN " + retSqlName("FKF") + " FKF "
    cQuery += "         ON FKF.FKF_FILIAL = FK1.FK1_FILIAL "
    cQuery += "         AND FKF.FKF_IDDOC = FK1.FK1_IDDOC "
    cQuery += "         AND FKF.D_E_L_E_T_ = ? "
    cQuery += " WHERE FK7_IDDOC = ? "
    cQuery += " AND ((SA1.A1_RECINSS = ? AND SED.ED_CALCINS = ?) OR SE1.E1_INSS > ?) "
    cQuery += " AND (FKF.FKF_TPSERV != ? OR FKF.FKF_TPREPA != ?) "
    cQuery += " AND FK7.D_E_L_E_T_ = ? "

    cQuery := ChangeQuery(cQuery)
        
    oT154ACStatement := FwExecStatement():New(cQuery)

	oT154ACStatement:setUnsafe(nParamOrder++, formatIn(MVABATIM+"|"+MV_CRNEG +"|" +MVPROVIS+"|"+MVRECANT+"|"+MV_CPNEG+ "|"+ MVTAXA+"|"+MVTXA+"|"+MVINSS+"|"+"SES","|"))
	oT154ACStatement:setIn(nParamOrder++, {'NOTFAT'})
	oT154ACStatement:setString(nParamOrder++, ' ')
	oT154ACStatement:setString(nParamOrder++, ' ')
	oT154ACStatement:setString(nParamOrder++, ' ')
    oT154ACStatement:setString(nParamOrder++, 'R')
	oT154ACStatement:setIn(nParamOrder++, {'DC','D2','JR','J2','TL','MT','M2','CM','C2','TR','TE','E1','CH','ES'})
	oT154ACStatement:setIn(nParamOrder++, {'FAT','LIQ','DEV', 'CMP'})
	oT154ACStatement:setString(nParamOrder++, ' ')
	oT154ACStatement:setString(nParamOrder++, 'ES')
	oT154ACStatement:setString(nParamOrder++, ' ')
	oT154ACStatement:setString(nParamOrder++, 'J')
	oT154ACStatement:setString(nParamOrder++, ' ')
	oT154ACStatement:setString(nParamOrder++, ' ')
	oT154ACStatement:setString(nParamOrder++, self:cIdDoc)
	oT154ACStatement:setString(nParamOrder++, 'S')
	oT154ACStatement:setString(nParamOrder++, 'S')
	oT154ACStatement:setNumeric(nParamOrder++, 0)
	oT154ACStatement:setString(nParamOrder++, ' ')
	oT154ACStatement:setString(nParamOrder++, ' ')
	oT154ACStatement:setString(nParamOrder++, ' ')

    self:cT154ACAlias := oT154ACStatement:OpenAlias()

    oT154ACStatement:destroy()
return

//-------------------------------------------------------------------
/*{Protheus.doc} getT154ACBlock
    @description Monta e retorna o subbloco T154AC.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 02/05/2025
    @return
*/
//-------------------------------------------------------------------
method getT154ACBlock() as array class DataBlockT154
    local nDecrease := 0 as numeric
    local nIncrease := 0 as numeric

    if len(self:aT154ACBlock) == 0
        if (self:cT154ACAlias)->SALDO == 0
            nDecrease := (self:cT154ACAlias)->INSS + (self:cT154ACAlias)->COFINS + (self:cT154ACAlias)->CSLL +;
            (self:cT154ACAlias)->PIS + (self:cT154ACAlias)->ISS + (self:cT154ACAlias)->IRRF + (self:cT154ACAlias)->DECRESC
            nIncrease := (self:cT154ACAlias)->JUROS + (self:cT154ACAlias)->ACRESC + (self:cT154ACAlias)->MULTA
        endIf
        while !(self:cT154ACAlias)->(eof())
            aadd(self:aT154ACBlock, { "DATA_DA_BAIXA" : stod((self:cT154ACAlias)->DATABX),;
                                    "VALOR_DA_BAIXA": (self:cT154ACAlias)->VALOR})
            (self:cT154ACAlias)->(dbSkip())
        endDo
        self:aT154ACBlock[len(self:aT154ACBlock)]["VALOR_DA_BAIXA"] += (nDecrease - nIncrease)
    endIf
    
return self:aT154ACBlock

//-------------------------------------------------------------------
/*{Protheus.doc} loadParameters
    @description Monta e retorna o subbloco T154AC.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 02/05/2025
    @return
*/
//-------------------------------------------------------------------
method loadParameters() class DataBlockT154
    if self:lBillsReceivable
        self:cIssueDateParameter    := allTrim(superGetMv("MV_FINTAF1",.F., "1"))
        self:cSettlementDisplayMode := allTrim(superGetMv("MV_FINTAF3",.F., "1"))
    else
        self:cIssueDateParameter    := allTrim(superGetMv("MV_FINTAF2",.F., "1"))
        self:cSettlementDisplayMode := allTrim(superGetMv("MV_FINTAF4",.F., "1"))
    endIf
return

//-------------------------------------------------------------------
/*{Protheus.doc} loadPayableInstallments
    @description Monta e executa query para buscar as parcelas do título do Contas a Pagar.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 06/05/2025
    @return
*/
//-------------------------------------------------------------------
method loadPayableInstallments() class DataBlockT154
    local cQuery := "" as character
    local nParamOrder   := 1  as numeric
    local oPortfolioInstallment := Nil as object

    cQuery += " SELECT E2_PARCELA PARCELA, FK7.FK7_IDDOC IDDOC "
    cQuery += " FROM " + retSqlName("SE2") + " SE2 "
    cQuery += "     INNER JOIN " + retSqlName("FK7") + " FK7 "
    cQuery += "         ON FK7.FK7_ALIAS = ? "
    cQuery += "         AND FK7.FK7_FILTIT = SE2.E2_FILIAL "
    cQuery += "         AND FK7.FK7_PREFIX = SE2.E2_PREFIXO "
    cQuery += "         AND FK7.FK7_NUM = SE2.E2_NUM "
    cQuery += "         AND FK7.FK7_PARCEL = SE2.E2_PARCELA "
    cQuery += "         AND FK7.FK7_TIPO = SE2.E2_TIPO "
    cQuery += "         AND FK7.FK7_CLIFOR = SE2.E2_FORNECE "
    cQuery += "         AND FK7.FK7_LOJA = SE2.E2_LOJA "
    cQuery += "         AND FK7.D_E_L_E_T_ = ? "
    cQuery += " WHERE SE2.E2_FILIAL = ? "
    cQuery += "     AND SE2.E2_PREFIXO = ? "
    cQuery += "     AND SE2.E2_NUM = ? "
    cQuery += "     AND SE2.E2_TIPO = ? "
    cQuery += "     AND SE2.E2_FORNECE = ? "
    cQuery += "     AND SE2.E2_LOJA = ? "
    cQuery += "     AND SE2.E2_EMISSAO = ? "
    cQuery += "     AND SE2.D_E_L_E_T_ = ? "

    cQuery := ChangeQuery(cQuery)

    oPortfolioInstallment := FWExecStatement():New(cQuery)
   
    oPortfolioInstallment:setString( nParamOrder++, "SE2" )
    oPortfolioInstallment:setString( nParamOrder++, " " )
    oPortfolioInstallment:setString( nParamOrder++, (self:cPortfolioAlias)->E2_FILIAL )
    oPortfolioInstallment:setString( nParamOrder++, (self:cPortfolioAlias)->E2_PREFIXO )
    oPortfolioInstallment:setString( nParamOrder++, (self:cPortfolioAlias)->E2_NUM )
    oPortfolioInstallment:setString( nParamOrder++, (self:cPortfolioAlias)->E2_TIPO )
    oPortfolioInstallment:setString( nParamOrder++, (self:cPortfolioAlias)->E2_FORNECE )
    oPortfolioInstallment:setString( nParamOrder++, (self:cPortfolioAlias)->E2_LOJA )
    oPortfolioInstallment:setString( nParamOrder++, (self:cPortfolioAlias)->E2_EMISSAO )
    oPortfolioInstallment:setString( nParamOrder++, " " )

    self:cInstallmentAlias := oPortfolioInstallment:openAlias()

    oPortfolioInstallment:destroy()
return

//-------------------------------------------------------------------
/*{Protheus.doc} loadReceivableInstallments
    @description Monta e executa query para buscar as parcelas do título do Contas a Receber.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 06/05/2025
    @return
*/
//-------------------------------------------------------------------
method loadReceivableInstallments() class DataBlockT154
    local cQuery := "" as character
    local nParamOrder   := 1  as numeric
    local oPortfolioInstallment := Nil as object

    cQuery += " SELECT SE1.E1_PARCELA PARCELA, FK7.FK7_IDDOC IDDOC "
    cQuery += " FROM " + retSqlName("SE1") + " SE1 "
    cQuery += "     INNER JOIN " + retSqlName("FK7") + " FK7 "
    cQuery += "         ON FK7.FK7_ALIAS = ? "
    cQuery += "         AND FK7.FK7_FILTIT = SE1.E1_FILIAL "
    cQuery += "         AND FK7.FK7_PREFIX = SE1.E1_PREFIXO "
    cQuery += "         AND FK7.FK7_NUM = SE1.E1_NUM "
    cQuery += "         AND FK7.FK7_PARCEL = SE1.E1_PARCELA "
    cQuery += "         AND FK7.FK7_TIPO = SE1.E1_TIPO "
    cQuery += "         AND FK7.FK7_CLIFOR = SE1.E1_CLIENTE "
    cQuery += "         AND FK7.FK7_LOJA = SE1.E1_LOJA "
    cQuery += "         AND FK7.D_E_L_E_T_ = ? "
    cQuery += " WHERE SE1.E1_FILIAL = ? "
    cQuery += "     AND SE1.E1_PREFIXO = ? "
    cQuery += "     AND SE1.E1_NUM = ? "
    cQuery += "     AND SE1.E1_TIPO = ? "
    cQuery += "     AND SE1.E1_CLIENTE = ? "
    cQuery += "     AND SE1.E1_LOJA = ? "
    cQuery += "     AND SE1.E1_EMISSAO = ? "
    cQuery += "     AND SE1.D_E_L_E_T_ = ? "

    cQuery := ChangeQuery(cQuery)

    oPortfolioInstallment := FWExecStatement():New(cQuery)   

    oPortfolioInstallment:setString( nParamOrder++, "SE1" )
    oPortfolioInstallment:setString( nParamOrder++, " " )
    oPortfolioInstallment:setString( nParamOrder++, (self:cPortfolioAlias)->E1_FILIAL )
    oPortfolioInstallment:setString( nParamOrder++, (self:cPortfolioAlias)->E1_PREFIXO )
    oPortfolioInstallment:setString( nParamOrder++, (self:cPortfolioAlias)->E1_NUM )
    oPortfolioInstallment:setString( nParamOrder++, (self:cPortfolioAlias)->E1_TIPO )
    oPortfolioInstallment:setString( nParamOrder++, (self:cPortfolioAlias)->E1_CLIENTE )
    oPortfolioInstallment:setString( nParamOrder++, (self:cPortfolioAlias)->E1_LOJA )
    oPortfolioInstallment:setString( nParamOrder++, (self:cPortfolioAlias)->E1_EMISSAO )
    oPortfolioInstallment:setString( nParamOrder++, " " )

    self:cInstallmentAlias := oPortfolioInstallment:openAlias()

    oPortfolioInstallment:destroy()

return

//-------------------------------------------------------------------
/*{Protheus.doc} destroyStatementObjects
    @description Destrói os objetos utilizados com FWExecStatement.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 20/08/2025
    @return
*/
//-------------------------------------------------------------------
method destroyStatementObjects() class DataBlockT154        
    if self:oDHTStatement != Nil
        self:oDHTStatement:destroy()
    endIf

    if self:oIRSimpStatement != Nil
        self:oIRSimpStatement:destroy()
    endIf

    if self:oFKWStatement != Nil
        self:oFKWStatement:destroy()
    endIf

    if self:oFirstDedStatement != Nil
        self:oFirstDedStatement:destroy()
    endIf
return

//-------------------------------------------------------------------
/*{Protheus.doc} destroyAliasTemporary
    @description Destrói os alias que foram abertos durante a execução
    @type Method
    @version 1.0
    @author Vitor Duca
    @since 18/06/2026
    @return
*/
//-------------------------------------------------------------------
method destroyAliasTemporary() class DataBlockT154
    local aAliasTemporary := {} as array
    local nAlias := 0           as numeric

    Aadd(aAliasTemporary, self:cT154ACAlias)
    Aadd(aAliasTemporary, self:cPortfolioAlias)
    Aadd(aAliasTemporary, self:cInstallmentAlias)

    for nAlias := 1 to len(aAliasTemporary)
        If !Empty(aAliasTemporary[nAlias]) .and. Select(aAliasTemporary[nAlias]) > 0
            (aAliasTemporary[nAlias])->(DbCloseArea())
        Endif
    next nAlias
return

//-------------------------------------------------------------------
/*/{Protheus.doc} loadIRTaxInPayment
    @description Define o conteúdo da propriedade self:lIRTaxInPayment.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 22/09/2025
    @return
/*/
//-------------------------------------------------------------------
method loadIRTaxInPayment() class DataBlockT154
    local cIrfTax	:= strTran(alltrim(superGetMv("MV_IRF", .F., "IRF")), '"', '') as character
	local jTitFilho := {} as json
	local nIRTaxValue := 0 as numeric
	local nPCCTaxValue := 0 as numeric

	self:lIRTaxInPayment := (self:cPortfolioAlias)->A2_CALCIRF == "2"

	nIRTaxValue := (self:cPortfolioAlias)->(E2_IRRF)
	nPCCTaxValue := (self:cPortfolioAlias)->(E2_PIS + E2_COFINS + E2_CSLL)
	
	jTitFilho := self:getTaxesFromIdDoc()

	if jTitFilho:hasProperty(cIrfTax)
		self:lIRTaxAggregated := nPCCTaxValue > 0 .and. jTitFilho[cIrfTax] == (nPCCTaxValue + nIRTaxValue)
	endIf

return

//-------------------------------------------------------------------
/*/{Protheus.doc} getTaxesFromIdDoc
    @description método para retornar os títulos filhos do título pai informado em cIdDoc.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 22/09/2025
    @return aTaxes - Retorna array com os títulos filhos do título pai informado em cIdDoc.
/*/
//-------------------------------------------------------------------
method getTaxesFromIdDoc() as json class DataBlockT154
	local aArea	:= {} as array
	local aAreaSE2 := {} as array
    local cTaxParentBill := "" as character
    local json := JsonObject():New() as json
    local jTitFilho := JsonObject():New() as json
    local lUseClass := .F. as logical
    local nI := 0 as numeric
    local oBillRelated := Nil as object

    cTaxParentBill := (self:cPortfolioAlias)->(E2_FILIAL + E2_PREFIXO + E2_NUM + E2_PARCELA + E2_TIPO + E2_FORNECE + E2_LOJA)
    lUseClass := FindClass('totvs.protheus.backoffice.fin.bills.related.BillRelated')

	aArea	:= getArea()
	aAreaSE2 := SE2->(getArea())
  
    SE2->(dbSetOrder(1)) // E2_FILIAL+E2_PREFIXO+E2_NUM+E2_PARCELA+E2_TIPO+E2_FORNECE+E2_LOJA
    if SE2->(DbSeek(cTaxParentBill))
 
        if lUseClass
            oBillRelated := totvs.protheus.backoffice.fin.bills.related.BillRelated():New()
            if lUseClass := oBillRelated:canUseRelatedBill()
                json := oBillRelated:getRelatedBills('SE2', .F.)
                if !Empty(json['document']) .And. Len(json['document']) > 0
                    for nI := 1 to len(json['document'])
                        if json['document'][nI]['FK7_TIPO'] == 'TX '
                            jTitFilho[alltrim(json['document'][nI]['E2_NATUREZ'])] := json['document'][nI]['E2_VLCRUZ']
                        endif
                    next
                endif
            endif
        endif
 
        if !lUseClass
            SE2->(dbSetOrder(17)) // E2_FILIAL+E2_TITPAI
            SE2->(dbGotop())
            if SE2->(DbSeek(cTaxParentBill)) 
                while SE2->(!Eof()) .And. AllTrim(SE2->(E2_FILIAL+E2_TITPAI)) == AllTrim(cTaxParentBill)
                    jTitFilho[alltrim(SE2->E2_NATUREZ)] := SE2->E2_VLCRUZ
                    SE2->(dbSkip())
                enddo
            endif
        endif             
    endif

	restArea(aAreaSE2)
	restArea(aArea)
  
return jTitFilho

/*/{Protheus.doc} loadTaxesConfigurations
Função para verificação dos impostos configurados via Motor de Retenção

@return aImpConf - Retencoes configuradas no Motor para Natureza/Fornecedor

@author fabio.casagrande
@since 25/09/2025
@version P12
/*/
method loadTaxesConfigurations() class DataBlockT154
	local aImpConf       := {} as array
	local nZ             := 0 as numeric
    local cPortfolioCode := str(PAYABLE_PORTFOLIO_CODE) as character
    local cSupplier      := alltrim((self:cPortfolioAlias)->E2_FORNECE) as character
    local cUnit          := alltrim((self:cPortfolioAlias)->E2_LOJA) as character
    local cClass         := alltrim((self:cPortfolioAlias)->E2_NATUREZ) as character
    local dIssueDate     := stod((self:cPortfolioAlias)->E2_EMISSAO)  as date

	self:lPccMR   := .F.
	self:lIrfMR   := .F.
	self:lIssMR   := .F.
	self:lPccBxMR := .F.
	self:lIrfBxMR := .F.
	self:lIssBxMR := .F.

	aImpConf := FinImpConf(cPortfolioCode, cFilAnt, cSupplier, cUnit, cClass, self:cIdDoc, dIssueDate)

	For nZ := 1 to Len(aImpConf)
		Do Case
			Case aImpConf[nZ,1] $ "PIS|COF|CSL"
				self:lPccMR := .T.
				self:lPccBxMR := aImpConf[nZ,2] == "2"				
			Case aImpConf[nZ,1] == "IRF"
				self:lIrfMR := .T.
				self:lIrfBxMR := aImpConf[nZ,2] == "2"
			Case aImpConf[nZ,1] == "ISS"
				self:lIssMR := .T.
				self:lIssBxMR := aImpConf[nZ,2] == "2"				
		End Case
	Next

	FwFreeArray(aImpConf)
return
