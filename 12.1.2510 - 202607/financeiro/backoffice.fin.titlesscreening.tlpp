#include "msobject.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "TOTVS.CH"

#define INSERT_OPERATION '1'
#define UPDATE_OPERATION  '2'
#define DELETE_OPERATION '3'
#define POST_OPERATION   '4'
#define CANCEL_POST_OPERATION '5'
#define CODE_MOVEMENT_MIT '1'
#define CODE_MOVEMENT_REINF '2'
#define WRITE_OFF_DATE '2'
#define DATE_OF_AVAILABILITY '3'
#define PAYABLE_PORTFOLIO_CODE 1
#define RECEIVABLE_PORTFOLIO_CODE 2
#define LEM_INTEGRATION_STATUS_COMPLETED '5'
#define V3U_INTEGRATION_STATUS_COMPLETED '4'

namespace totvs.protheus.backoffice.fin.taf.smartschedule

class TitlesScreening
    protected data cIdDoc           as character
    protected data cOperation       as character
    protected data cMovType         as character
    protected data jTaxesIdDoc      as json
    protected data jPreUpdate       as json
    protected data jPosUpdate       as json
    protected data lIntegrate       as logical
    protected data lBillsReceivable as logical
    protected data lFkfIsLoaded     as logical
    protected data lFkgIsModified   as logical
    protected data lDeleteMitData   as logical
    protected data lInvoice         as logical
    protected data lAdvancePayment  as logical
    protected data nTamParticip     as numeric
    protected data nTamParcela      as numeric
    protected data oStatement       as object
    protected data oTaxesStatement  as object
    protected data oSE1Statement    as object
    protected data oSE2Statement    as object

    public method new(cPortifolio as character, nOperation as numeric) as object
    public method setOperation(nOperation as numeric)
    public method setIdDoc(cIdDoc as character)
    public method setIntegrationByInvoice(lInvoice as logical)
    public method getIntegrationByInvoice() as logical
    public method screening()
    public method mitBillsPayable()
    public method fieldsContentCapture()
    public method integratePost(cIdDoc as character, cMovType as character)
    public method validIntegPostMit(cIdfK2 as character, cIdDoc as character) as logical
    public method updateIntegrateStatus(cIdFk7 as character, cPortfolioAlias as character)
    public method loadFkfFields()
    public method fkgIsModified(lIsModified as logical)
    public method integrateCancelledPost(cIdDoc as character)
    public method setIdToTaxesId(cIdFk7 as character, cMovType as character)
    static method canUseClass() as logical
    protected method integrateFromInvoice() as logical
    protected method integrateToTaf()
    protected method reinfBillsReceivable()
    protected method reinfBillsPayable()
    protected method compareChanges()
    protected method getFieldsToCompare()
    protected method loadMitStatement()
    protected method checkIdInV3U(lIntegrationStatusCompleted as logical) as logical
    protected method checkIdInLEM(lIntegrationStatusCompleted as logical) as logical
    protected method integrateFromParentTitle()
    protected method findTXFromIdDoc(cOriginTable as character, lIntegrationStatusCompleted as logical)
    protected method loadTaxesId()
    protected method validateUpdateOperation()
    protected method validateDeleteOperation() as logical
    protected method checkTaxesIdInLEM() as logical
    protected method deleteMitData()
    protected method getFk7Data() as json
    protected method getSE1Data() as json
    protected method getSE2Data() as json
endClass


//-------------------------------------------------------------------
/*{Protheus.doc} new
    Construtor
    @return object: self
    @author guilhermed.santos
    @since 19/03/2025
    @version 12.1.2410
*/
//-------------------------------------------------------------------
method new(cPortifolio as character, nOperation as numeric) as object class TitlesScreening
    default nOperation := 3
    self:lBillsReceivable := cPortifolio  == "SE1"
    self:setOperation(nOperation)
    self:setIntegrationByInvoice(.F.)
    self:lIntegrate     := .T.
    self:lFKGIsModified := .F.
    self:lFkfIsLoaded   := .F.
    self:lDeleteMitData := .F.
    self:lAdvancePayment := .F.
    self:cIdDoc         := ""
    self:cMovType       := ""
    self:nTamParticip   := TAMSX3("FK7_CLIFOR")[1]
    self:nTamParcela    := TAMSX3("FK7_PARCEL")[1]
    self:jTaxesIdDoc    := jsonObject():new()
    self:jPreUpdate     := jsonObject():new()
    self:jPosUpdate     := jsonObject():new()
return self

//-------------------------------------------------------------------
/*{Protheus.doc} canUseClass
    @description Verifica se a classe pode ser utilizada de acordo com o ambiente.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 30/03/2026
    @return
*/
//-------------------------------------------------------------------
method canUseClass() as logical class TitlesScreening
    local lCanUseIt := .F. as logical
    local lTafIsch  := .F. as logical

    if findFunction("TafUsaISCH")
        lTafIsch := TafUsaISCH()
    endIf

    if lTafIsch .and. cPaisLoc == "BRA" .and. GetRpoRelease() >= "12.1.2410" .and. FWSIXUtil():ExistIndex( "LEM" , "8" ) .and. FWSIXUtil():ExistIndex( "V3U" , "4" ) .and. FWSIXUtil():ExistIndex( "FK7" , "5" )
        lCanUseIt := .T.
    endIf
    
return lCanUseIt

//-------------------------------------------------------------------
/*{Protheus.doc} setOperation
    @description Converte o número da operação do CP ou CR para o caracter correspondente à integração do TAF.
        3 - Inclusão - Passa a ser "1"
        4 - Alteração - Passa a ser "2"
        5 - Exclusão - Passa a ser "3"
        6 - Baixa - Passa a ser "4"
        7 - Canc. Baixa - Passa a ser "5"
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 19/03/2025
    @return
*/
//-------------------------------------------------------------------
method setOperation(nOperation as numeric) class TitlesScreening
    if nOperation == 0
        nOperation := 3
    endIf
    self:cOperation := allTrim(str(nOperation - 2))
return

//-------------------------------------------------------------------
/*{Protheus.doc} setIdDoc
    @description Atribui valor à propriedade cIdDoc.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 08/08/2025
    @return
*/
//-------------------------------------------------------------------
method setIdDoc(cIdDoc as character) class TitlesScreening
    self:cIdDoc := cIdDoc
return

//-------------------------------------------------------------------
/*{Protheus.doc} setIntegrationByInvoice
    @description Atribui valor à propriedade lInvoice.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 08/08/2025
    @return
*/
//-------------------------------------------------------------------
method setIntegrationByInvoice(lInvoice as logical) class TitlesScreening
    self:lInvoice := lInvoice
return

//-------------------------------------------------------------------
/*{Protheus.doc} getIntegrationByInvoice
    @description Retorna o valor da propriedade lInvoice.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 08/08/2025
    @return
*/
//-------------------------------------------------------------------
method getIntegrationByInvoice() as logical class TitlesScreening    
return self:lInvoice

//-------------------------------------------------------------------
/*{Protheus.doc} screening
    @description Chama os métodos que irão realizar a triagem do título.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 19/03/2025
    @return
*/
//-------------------------------------------------------------------
method screening() class TitlesScreening
    local aArea     := {} as array
    local aAreaFK7  := {} as array

    aArea    := getArea()
    aAreaFK7 := FK7->(getArea())

    if empty(self:cIdDoc)
        self:setIdDoc(FK7->FK7_IDDOC)
    else
        dbSelectArea('FK7')
        dbSetOrder(5)
        FK7->(dbSeek(self:cIdDoc))
    endIf

    if (self:cOperation > POST_OPERATION) .or. (self:cOperation == DELETE_OPERATION .and. !self:validateDeleteOperation())
        return
    endIf
    
    if self:cOperation == UPDATE_OPERATION
        self:validateUpdateOperation()
    endIf

    if self:lIntegrate
        if self:lBillsReceivable
            self:reinfBillsReceivable()
        else
            self:reinfBillsPayable()
        endIf
        
        if self:lIntegrate
            if self:lAdvancePayment
                if self:cOperation == INSERT_OPERATION
                    self:cOperation := POST_OPERATION
                    self:integratePost(self:cIdDoc, self:cMovType)
                else
                    self:cOperation := CANCEL_POST_OPERATION
                    self:integrateCancelledPost(self:cIdDoc)
                endIf
            else
                self:integrateToTaf()
                if self:lDeleteMitData
                    self:deleteMitData()
                endIf
            endIf
        elseIf !self:lBillsReceivable
            self:mitBillsPayable()
        endIf
    endIf
    
    restArea(aAreaFK7)
    restArea(aArea)
return

//-------------------------------------------------------------------
/*{Protheus.doc} integrateToTaf    
    @description Aciona função do TAF para receber a integração do financeiro.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 09/04/2025
    @return
*/
//-------------------------------------------------------------------
method integrateToTaf() class TitlesScreening
    local lIntegrate := .T. as logical
    local jFk7Data   := jsonObject():new() as json
    local aArea      := getArea() as array

    if existBlock("RNFINTEG")
        jFk7Data := self:getFk7Data()
        lIntegrate := ExecBlock("RNFINTEG",.F.,.F.,{jFk7Data, self:cIdDoc,self:cOperation, self:cMovType})
    endIf

    if self:lIntegrate .And. FindFunction('totvs.protheus.fiscal.taf.financialintegration.TAFstartsintegrationfinance') .and. lIntegrate

        totvs.protheus.fiscal.taf.financialintegration.TAFstartsintegrationfinance(self:cIdDoc,self:cOperation,self:cMovType)
    endIf
    restArea(aArea)
return

//-------------------------------------------------------------------
/*{Protheus.doc} reinfBillsReceivable    
    @description Realiza triagem do título no Contas a Receber - REINF
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 19/03/2025
    @return
*/
//-------------------------------------------------------------------
method reinfBillsReceivable() class TitlesScreening
    local aArea     := {} as array
    local aAreaFKW  := {} as array
    local jSE1Data  := jsonObject():new() as json

    aArea    := getArea()
    aAreaFKW := FKW->(getArea())

    self:cMovType := CODE_MOVEMENT_REINF

    jSE1Data := self:getSE1Data()

    if jSE1Data['FOUND']

        if (jSE1Data['E1_TIPO'] $ (MVABATIM+"|"+MV_CRNEG +"|" +MVPROVIS+"|"+MVRECANT+"|"+MV_CPNEG+ "|"+ MVTAXA+"|"+MVTXA+"|"+MVINSS+"|"+"SES"))
            self:lIntegrate := .F.
        endIf

        if alltrim(jSE1Data['E1_FATURA']) == 'NOTFAT'
            self:lIntegrate := .F.
        endIF

        if !empty(jSE1Data['E1_NUMLIQ'])
            self:lIntegrate := .F.
        endIf

        if !((jSE1Data['FKF_TPSERV'] != ' ' .or. jSE1Data['FKF_TPREPA'] != ' ' .or. jSE1Data['E1_ORIGEM'] $ ('MATA461/MATA460/MATA103/MATA100')) .and. ((jSE1Data['A1_RECINSS'] = 'S' .and. jSE1Data['ED_CALCINS'] = 'S') .or. jSE1Data['E1_INSS'] > 0))
            dbSelectArea('FKW')
            dbSetOrder(2)
            if !dbSeek(FK7->FK7_FILTIT+FK7->FK7_IDDOC+'2')
                self:lIntegrate := .F.
            endIf
        endIf

        if !self:lIntegrate .and. self:lInvoice
            self:lIntegrate := self:integrateFromInvoice()
        endIf
    else
        self:lIntegrate := .F.
    endIf
    restArea(aAreaFKW)
    restArea(aArea)
Return

//-------------------------------------------------------------------
/*{Protheus.doc} reinfBillsPayable    
    @description Realiza triagem do título no Contas a Pagar - REINF
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 19/03/2025
    @return
*/
//-------------------------------------------------------------------
method reinfBillsPayable() class TitlesScreening
    local aArea     := {} as array
    local aAreaFKW  := {} as array
    local jSE2Data  := jsonObject():new() as json

    aArea    := getArea()
    aAreaFKW := FKW->(getArea())

    self:cMovType := CODE_MOVEMENT_REINF

    jSE2Data := self:getSE2Data()

    if jSE2Data['FOUND']

        self:lAdvancePayment := jSE2Data['E2_TIPO'] $ MVPAGANT

        if (jSE2Data['E2_TIPO'] $ (MVABATIM+"|"+MVPROVIS+"|"+MV_CPNEG+"|"+MVIRABT+"|"+MVCSABT+"|"+MVCFABT+"|"+MVPIABT+"|"+MVISS+"|"+ MVTAXA+"|"+MVTXA+"|"+MVINSS+"|"+"SES"))
            self:lIntegrate := .F.
        endIf

        if !(jSE2Data['A2_TIPO'] <> 'F' .and. (jSE2Data['FKF_TPSERV'] != ' ' .or. jSE2Data['FKF_TPREPA'] != ' ' .or. jSE2Data['E2_ORIGEM'] $ 'MATA103/MATA100') .and. jSE2Data['A2_RECINSS'] == 'S' .and. jSE2Data['ED_CALCINS'] == 'S' .and. jSE2Data['FKF_ORIINS'] > 0)
            dbSelectArea('FKW')
            dbSetOrder(2)
            if !dbSeek(FK7->FK7_FILTIT+FK7->FK7_IDDOC+'1')
                self:lIntegrate := .F.
            endIf
        endIf

        if !self:lIntegrate .and. self:lInvoice
            self:lIntegrate := self:integrateFromInvoice()
        endIf
    else
        self:lIntegrate := .F.
    endIf
    restArea(aAreaFKW)
    restArea(aArea)
Return

//-------------------------------------------------------------------
/*{Protheus.doc} mitBillsPayable    
    @description Realiza triagem do título no Contas a Pagar - MIT
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 19/03/2025
    @return
*/
//-------------------------------------------------------------------
method mitBillsPayable() class TitlesScreening
    local cAliasMit     := "" as character
    local cUniao        := PADR(superGetMv("MV_UNIAO",,"UNIAO "),self:nTamParticip) as character
    local cCide         := PADR(superGetMv("MV_FORCIDE",,"CIDE  "),self:nTamParticip) as character
    local cPisTax       := alltrim(superGetMv("MV_PISNAT", .F., "PIS")) as character
    local cCofinsTax    := alltrim(superGetMv("MV_COFINS", .F., "COFINS")) as character
    local cCsllTax      := alltrim(superGetMv("MV_CSLL", .F., "CSLL")) as character
    local cIrfTax       := alltrim(superGetMv("MV_IRF", .F., "IRF")) as character
    local cCideTax      := alltrim(superGetMv("MV_CIDE", .F., "CIDE")) as character
    local jSE2Data      := jsonObject():new() as json

    if self:lIntegrate
        return
    endIf

	if FK7->FK7_IDDOC != self:cIdDoc
        dbSelectArea('FK7')
        FK7->(dbSetOrder(5)) //FK7_IDDOC
        FK7->(dbSeek(self:cIdDoc))
    endIf

    jSE2Data := self:getSE2Data()

    if jSE2Data['FOUND']

        self:cMovType := CODE_MOVEMENT_MIT
        self:lIntegrate := .T.

        if (jSE2Data['E2_FORNECE'] == cUniao .and. alltrim(jSE2Data['E2_NATUREZ']) $ cPisTax + "|" + cCofinsTax + "|" + cCsllTax + "|" + cIrfTax) .or.;
            (jSE2Data['E2_FORNECE'] == cCide .and. alltrim(jSE2Data['E2_NATUREZ']) == cCideTax)
            self:integrateToTaf()
            return
        endIf

        if self:cOperation == DELETE_OPERATION
            self:findTXFromIdDoc("FK7", .T.)
            cAliasMit := self:oTaxesStatement:openAlias()
        else
            self:loadMitStatement()
            cAliasMit := self:oStatement:openAlias()
        endIf

        if (cAliasMit)->(eof())
            self:lIntegrate := .F.
            (cAliasMit)->(dbCloseArea())
            return
        endIf

        while !(cAliasMit)->(eof())
            self:setIdDoc((cAliasMit)->IDDOC)
            self:integrateToTaf()
            (cAliasMit)->(dbSkip())
        endDo
        (cAliasMit)->(dbCloseArea())
    else
        self:lIntegrate := .F.
    endIf
return

//-------------------------------------------------------------------
/*{Protheus.doc} compareChanges
    @description Compara se houve alteração nos campos referentes à integração com TAF
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 24/03/2025
    @return
*/
//-------------------------------------------------------------------
method compareChanges() class TitlesScreening
    local aKeys    := {} as array
    local nX       := 1 as numeric

    self:fieldsContentCapture(2)

    aKeys := self:jPreUpdate:GetNames()

    self:lIntegrate := .F.

    for nX := 1 to len(aKeys)
        if !(self:jPreUpdate[aKeys[nX]] == self:jPosUpdate[aKeys[nX]])
            self:lIntegrate := .T.
            exit
        endIf
    next nX
return

//-------------------------------------------------------------------
/*{Protheus.doc} fieldsContentCapture
    @description Chama o método que faz a captura do conteúdo atual dos campos importantes para a integração com o TAF.
                    Deixando separado nas propriedades jPreUpdate e jPosUpdate para comparação posteriormente.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 24/03/2025
    @return
*/
//-------------------------------------------------------------------
method fieldsContentCapture(nStage) class TitlesScreening
    local jFields := jsonObject():new() as json

    jFields := self:getFieldsToCompare()

    if nStage == 1
        self:jPreUpdate := jFields
    else
        self:jPosUpdate := jFields
    endIf
return

//-------------------------------------------------------------------
/*{Protheus.doc} getFieldsToCompare
    @description Método responsável por resgatar o conteúdo atual dos campos importantes para a integração com o TAF.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 24/03/2025
    @return
*/
//-------------------------------------------------------------------
method getFieldsToCompare() class TitlesScreening
    local jRetField := jsonObject():new() as object

    if self:lBillsReceivable
        jRetField['E1_NATUREZ'] := SE1->E1_NATUREZ
        jRetField['E1_VALOR']   := SE1->E1_VALOR
        jRetField['E1_IRRF']    := SE1->E1_IRRF
        jRetField['E1_INSS']    := SE1->E1_INSS
    else
        jRetField['E2_NATUREZ'] := SE2->E2_NATUREZ
        jRetField['E2_VALOR']   := SE2->E2_VALOR
        jRetField['E2_IRRF']    := SE2->E2_IRRF
        jRetField['E2_INSS']    := SE2->E2_INSS
    endIf
    
    if self:lFkfIsLoaded
        jRetField['FKF_CPRB']   := FKF->FKF_CPRB
        jRetField['FKF_CNAE']   := FKF->FKF_CNAE
        jRetField['FKF_TPREPA'] := FKF->FKF_TPREPA
        jRetField['FKF_TPSERV'] := FKF->FKF_TPSERV
        jRetField['FKF_CNO']    := FKF->FKF_CNO
        jRetField['FKF_NATREN'] := FKF->FKF_NATREN
        jRetField['FKF_CGCSCP'] := FKF->FKF_CGCSCP
        jRetField['FKF_INDSUS'] := FKF->FKF_INDSUS
        jRetField['FKF_INDDEC'] := FKF->FKF_INDDEC
    endIf

return jRetField

