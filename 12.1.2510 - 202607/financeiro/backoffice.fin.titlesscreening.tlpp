//-------------------------------------------------------------------
/*{Protheus.doc} loadMitStatement
    @description Monta query que busca títulos de impostos a partir do título original, utilizado para integrar MIT com o TAF.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 31/03/2025
    @return
*/
//-------------------------------------------------------------------
method loadMitStatement() class TitlesScreening
    local cQuery            := "" as character
    local nParameterOrder   := 1  as numeric
    local cUniao            := PADR(superGetMv("MV_UNIAO",,"UNIAO "),self:nTamParticip) as character
    local cCide             := PADR(superGetMv("MV_FORCIDE",,"CIDE  "),self:nTamParticip) as character    
    local aSuppliers        := {cUniao,cCide} as array
    local cInstallment      := Space(self:nTamParcela) as character

    if self:oStatement == Nil
        cQuery := "SELECT SE2.E2_FILIAL, SE2.E2_PREFIXO, SE2.E2_NUM, SE2.E2_PARCELA, SE2.E2_TIPO, "
        cQuery += " SE2.E2_NATUREZ, SE2.E2_FORNECE, SE2.E2_LOJA, FK7.FK7_IDDOC as IDDOC "
        cQuery += " FROM " + retSqlName("SE2") + " SE2  "
        cQuery += " INNER JOIN " + retSqlName("FK7") + " FK7 "
        cQuery += "     ON FK7.FK7_ALIAS = ? "
        cQuery += "     AND FK7.FK7_FILTIT = SE2.E2_FILIAL "
        cQuery += "     AND FK7.FK7_PREFIX = SE2.E2_PREFIXO "
        cQuery += "     AND FK7.FK7_NUM = SE2.E2_NUM "
        cQuery += "     AND FK7.FK7_PARCEL = SE2.E2_PARCELA "
        cQuery += "     AND FK7.FK7_TIPO = SE2.E2_TIPO "
        cQuery += "     AND FK7.FK7_CLIFOR = SE2.E2_FORNECE "
        cQuery += "     AND FK7.FK7_LOJA = SE2.E2_LOJA "
        cQuery += "     AND FK7.D_E_L_E_T_ = ? "
        cQuery += " WHERE SE2.E2_FILIAL = ? "
        cQuery += " AND SE2.E2_PREFIXO = ? "
        cQuery += " AND SE2.E2_NUM = ? "
        cQuery += " AND SE2.E2_PARCELA <> ? "
        cQuery += " AND SE2.E2_FORNECE IN (?) "
        cQuery += " AND SE2.E2_ORIGEM NOT IN (?) "
        cQuery += " AND SE2.D_E_L_E_T_ = ? "

        cQuery := ChangeQuery(cQuery)

        self:oStatement := FWExecStatement():New(cQuery)
    endIf
    
    self:oStatement:setString( nParameterOrder++, "SE2" )
    self:oStatement:setString( nParameterOrder++, " " )
    self:oStatement:setString( nParameterOrder++, FK7->FK7_FILTIT )
    self:oStatement:setString( nParameterOrder++, FK7->FK7_PREFIX )
    self:oStatement:setString( nParameterOrder++, FK7->FK7_NUM )
    self:oStatement:setString( nParameterOrder++, cInstallment )
    self:oStatement:SetIn( nParameterOrder++, aSuppliers )
    self:oStatement:SetIn( nParameterOrder++, {'FINA381','FINA378','FINA376'} )
    self:oStatement:setString( nParameterOrder++, " " )
return

//-------------------------------------------------------------------
/*{Protheus.doc} integratePost
    @description Atualiza propriedades de acordo com os parâmetros recebidos e envia para a integração.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 01/04/2025
    @return
*/
//-------------------------------------------------------------------
method integratePost(cIdDoc as character, cMovType as character) class TitlesScreening
    self:setIdDoc(cIdDoc)
    self:cMovType := cMovType

    self:integrateToTaf()
return

//-------------------------------------------------------------------
/*{Protheus.doc} validIntegPostMit
    @description Valida se deve enviar MIT na baixa de títulos para a integração.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 01/04/2025
    @return
*/
//-------------------------------------------------------------------
method validIntegPostMit(cIdfK2 as character, cIdDoc as character) as logical class TitlesScreening
    local lRet      := .F. as logical
    local aArea     := {} as array
    local aAreaV3U  := {} as array
    local aAreaLEM  := {} as array

    aArea    := getArea()
    aAreaV3U := V3U->(getArea())
    aAreaLEM := LEM->(getArea())
    
    self:setIdDoc(cIdfK2)
    
    if self:cOperation $ POST_OPERATION + INSERT_OPERATION .and. !self:checkIdInV3U()
        self:setIdDoc(cIdDoc)
        lRet := !self:checkIdInLEM()
    endIf

    restArea(aAreaLEM)
    restArea(aAreaV3U)
    restArea(aArea)
return lRet

//-------------------------------------------------------------------
/*{Protheus.doc} checkIdInV3U
    @description Procura pelo IdDoc na tabela V3U
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 01/04/2025
    @return
*/
//-------------------------------------------------------------------
method checkIdInV3U(lIntegrationStatusCompleted as logical) as logical class TitlesScreening
    local lRet      := .F. as logical

    default lIntegrationStatusCompleted := .F.
    
    dbSelectArea("V3U")
    V3U->(dbSetOrder(4)) //V3U_FILIAL+V3U_IDBAIX
    if V3U->(dbSeek(xFilial('V3U')+self:cIdDoc))
        lRet := .T.
        if lIntegrationStatusCompleted
            lRet := V3U->V3U_INTEGR == V3U_INTEGRATION_STATUS_COMPLETED
        endIf
    endIf

return lRet

//-------------------------------------------------------------------
/*{Protheus.doc} checkIdInLEM
    @description Procura pelo IdDoc na tabela LEM
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 23/06/2025
    @return
*/
//-------------------------------------------------------------------
method checkIdInLEM(lIntegrationStatusCompleted as logical) as logical class TitlesScreening
    local lRet      := .F. as logical

    default lIntegrationStatusCompleted := .F.
    
    dbSelectArea("LEM")
    LEM->(dbSetOrder(8)) //LEM_FILIAL+LEM_IDDOC
    if LEM->(dbSeek(xFilial('LEM')+self:cIdDoc))
        lRet := .T.
        if lIntegrationStatusCompleted
            lRet := LEM->LEM_INTEGR == LEM_INTEGRATION_STATUS_COMPLETED
        endIf
    endIf

return lRet

//-------------------------------------------------------------------
/*{Protheus.doc} integrateCancelledPost
    @description Caso o Id Doc exista na V3U, aciona a integração com o TAF. Caso contrário, irá acionar métodos de buscas pelo título pai.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 01/04/2025
    @return
*/
//-------------------------------------------------------------------
method integrateCancelledPost(cIdDoc as character) class TitlesScreening
    local aArea     := {} as array
    local aAreaV3U  := {} as array

    default cIdDoc := ""
    
    if empty(cIdDoc)
        return
    else
        self:setIdDoc(cIdDoc)
    endIf
    
    aArea    := getArea()
    aAreaV3U := V3U->(getArea())

    if self:checkIdInV3U()
        self:cMovType := V3U->V3U_MOVFIN
        self:integrateToTaf()
    else
        self:cMovType := CODE_MOVEMENT_MIT
        self:setOperation(val(CANCEL_POST_OPERATION))
        self:integrateFromParentTitle()
    endIf

    restArea(aAreaV3U)
    restArea(aArea)
return

//-------------------------------------------------------------------
/*{Protheus.doc} integrateFromParentTitle
    @description Atualiza propriedades de acordo com os parâmetros recebidos e envia para a integração.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 01/04/2025
    @return
*/
//-------------------------------------------------------------------
method integrateFromParentTitle() class TitlesScreening
    local nTaxesId := 1 as numeric

    if !self:jTaxesIdDoc:hasProperty("TAXES_ID")
        self:loadTaxesId()
    endIf

    if self:jTaxesIdDoc:hasProperty("TAXES_ID")
        for nTaxesId := 1 to len(self:jTaxesIdDoc["TAXES_ID"])
            self:setIdDoc(self:jTaxesIdDoc["TAXES_ID"][nTaxesId]["IDDOC"])
            if !empty(self:cIdDoc) .and. self:checkIdInLEM()
                self:integrateToTaf()
            endIf
        next
    endIf
return

//-------------------------------------------------------------------
/*{Protheus.doc} findTXFromIdDoc
    @description Monta query que busca títulos de impostos na FK7 x LEM a partir do IDFK2 do título pai.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 31/03/2025
    @return
*/
//-------------------------------------------------------------------
method findTXFromIdDoc(cOriginTable as character, lIntegrationStatusCompleted as logical) class TitlesScreening
    local cQuery            := "" as character
    local nParameterOrder   := 1  as numeric
    local cUniao            := PADR(superGetMv("MV_UNIAO",,"UNIAO "),self:nTamParticip) as character
    local cCide             := PADR(superGetMv("MV_FORCIDE",,"CIDE  "),self:nTamParticip) as character    
    local aSuppliers        := {cUniao,cCide} as array
    local cInstallment      := Space(self:nTamParcela) as character

    default lIntegrationStatusCompleted := .F.

    if cOriginTable == "FK2"
        if self:oTaxesStatement == Nil
            cQuery := "SELECT FK7TX.FK7_IDDOC AS IDDOC, LEM.LEM_MOVFIN MOVTYPE"
            cQuery += " FROM " + retSqlName("FK2") + " FK2 "
            cQuery += " INNER JOIN " + retSqlName("FK7") + " FK7PAI "
            cQuery += "     ON FK7PAI.FK7_IDDOC = FK2.FK2_IDDOC "
            cQuery += "     AND FK7PAI.D_E_L_E_T_ = ? "
            cQuery += " INNER JOIN " + retSqlName("FK7") + " FK7TX "
            cQuery += "     ON FK7TX.FK7_ALIAS = FK7PAI.FK7_ALIAS "
            cQuery += "     AND FK7TX.FK7_FILTIT = FK7PAI.FK7_FILTIT "
            cQuery += "     AND FK7TX.FK7_PREFIX = FK7PAI.FK7_PREFIX "
            cQuery += "     AND FK7TX.FK7_NUM = FK7PAI.FK7_NUM "
            cQuery += "     AND FK7TX.FK7_PARCEL <> ? "
            cQuery += "     AND FK7TX.FK7_CLIFOR IN (?)  "
            cQuery += "     AND FK7TX.D_E_L_E_T_ = ? "
            cQuery += " INNER JOIN " + retSqlName("LEM") + " LEM "
            cQuery += "     ON LEM.LEM_IDDOC = FK7TX.FK7_IDDOC "
            cQuery += "     AND LEM.D_E_L_E_T_ = ? "        
            cQuery += " WHERE FK2.FK2_FILIAL = ? "
            cQuery += " AND FK2.FK2_IDFK2 = ? "
            cQuery += " AND FK2.D_E_L_E_T_ = ? "

            cQuery := ChangeQuery(cQuery)

            self:oTaxesStatement := FWExecStatement():New(cQuery)
        endIf
        
        self:oTaxesStatement:setString( nParameterOrder++, " " )
        self:oTaxesStatement:setString( nParameterOrder++, cInstallment )
        self:oTaxesStatement:SetIn( nParameterOrder++, aSuppliers )
        self:oTaxesStatement:setString( nParameterOrder++, " " )
        self:oTaxesStatement:setString( nParameterOrder++, " " )
        self:oTaxesStatement:setString( nParameterOrder++, xFilial('FK2') )
        self:oTaxesStatement:setString( nParameterOrder++, self:cIdDoc)
        self:oTaxesStatement:setString( nParameterOrder++, " " )
    else
        if self:oTaxesStatement == Nil
            cQuery := " SELECT FK7TX.FK7_IDDOC AS IDDOC, LEM.LEM_MOVFIN MOVTYPE "
            cQuery += " FROM " + retSqlName("FK7") + " FK7PAI "
            cQuery += "     INNER JOIN " + retSqlName("FK7") + " FK7TX "
            cQuery += "         ON FK7TX.FK7_ALIAS = FK7PAI.FK7_ALIAS "
            cQuery += "         AND FK7TX.FK7_FILTIT = FK7PAI.FK7_FILTIT "
            cQuery += "         AND FK7TX.FK7_PREFIX = FK7PAI.FK7_PREFIX "
            cQuery += "         AND FK7TX.FK7_NUM = FK7PAI.FK7_NUM "
            cQuery += "         AND FK7TX.FK7_PARCEL <> ? "
            cQuery += "         AND FK7TX.FK7_CLIFOR IN (?) "
            cQuery += "         AND FK7TX.D_E_L_E_T_ = ? "
            cQuery += "     INNER JOIN " + retSqlName("LEM") + " LEM "
            cQuery += "         ON LEM.LEM_IDDOC = FK7TX.FK7_IDDOC "
            if lIntegrationStatusCompleted
                cQuery += "         AND LEM.LEM_INTEGR = ? "
            endIf
            cQuery += "         AND LEM.D_E_L_E_T_ = ? "
            cQuery += " WHERE FK7PAI.FK7_IDDOC = ? "
            cQuery += " AND FK7PAI.D_E_L_E_T_ = ? "

            cQuery := ChangeQuery(cQuery)

            self:oTaxesStatement := FWExecStatement():New(cQuery)
        endIf
        
        self:oTaxesStatement:setString( nParameterOrder++, cInstallment )
        self:oTaxesStatement:SetIn( nParameterOrder++, aSuppliers )
        self:oTaxesStatement:setString( nParameterOrder++, " " )
        if lIntegrationStatusCompleted
            self:oTaxesStatement:setString( nParameterOrder++, LEM_INTEGRATION_STATUS_COMPLETED )
        endIf
        self:oTaxesStatement:setString( nParameterOrder++, " " )
        self:oTaxesStatement:setString( nParameterOrder++, self:cIdDoc)
        self:oTaxesStatement:setString( nParameterOrder++, " " )
    endIf
return

//-------------------------------------------------------------------
/*{Protheus.doc} setIdToTaxesId
    @description Adiciona valores na chave TAXES_ID da propriedade jTaxesIdDoc.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 23/06/2025
    @return
*/
//-------------------------------------------------------------------
method setIdToTaxesId(cIdFk7 as character, cMovType as character) class TitlesScreening
    local jTaxesIdDoc := jsonObject():new() as json

    default cIdFk7 := ""
    default cMovType := ""

    jTaxesIdDoc["IDDOC"] := cIdFk7
    jTaxesIdDoc["MOVTYPE"] := cMovType

    if self:jTaxesIdDoc:hasProperty("TAXES_ID")
        aadd(self:jTaxesIdDoc["TAXES_ID"],jTaxesIdDoc)
    else
        self:jTaxesIdDoc["TAXES_ID"] := {jTaxesIdDoc}
    endIf
return

//-------------------------------------------------------------------
/*{Protheus.doc} loadTaxesId
    @description Método responsável por selecionar os títulos TX a partir do título pai.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 23/06/2025
    @return
*/
//-------------------------------------------------------------------
method loadTaxesId() class TitlesScreening
    local cAliasMit := "" as character
    local cOriginTable := "" as character

    if self:cOperation == DELETE_OPERATION
        cOriginTable := "FK2"
    else
        cOriginTable := "FK7"
    endIf

    self:findTXFromIdDoc(cOriginTable)

    cAliasMit := self:oTaxesStatement:openAlias()

    while !(cAliasMit)->(eof())
        self:setIdToTaxesId((cAliasMit)->IDDOC,(cAliasMit)->MOVTYPE)        
        (cAliasMit)->(dbSkip())
    endDo
    (cAliasMit)->(dbCloseArea())
return

//-------------------------------------------------------------------
/*{Protheus.doc} validateUpdateOperation
    @description Realiza validações quando a operação for Alteração.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 15/07/2025
    @return
*/
//-------------------------------------------------------------------
method validateUpdateOperation() class TitlesScreening
    if !self:lFkgIsModified
        self:compareChanges()
    endIf

    if self:lIntegrate .and. !self:checkIdInLEM()
        self:lDeleteMitData := self:checkTaxesIdInLEM()
    endIf
return

//-------------------------------------------------------------------
/*{Protheus.doc} validateDeleteOperation
    @description Realiza validações quando a operação for Exclusão.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 15/08/2025
    @return
*/
//-------------------------------------------------------------------
method validateDeleteOperation() as logical class TitlesScreening
    local cAliasMit := "" as character
    local lRet      := .F. as logical
    
    if self:checkIdInLEM(.T.)
        lRet := .T.
    elseIf FK7->FK7_TIPO == MVPAGANT
        lRet := self:checkIdInV3U()
    else
        self:findTXFromIdDoc("FK7", .T.)
        cAliasMit := self:oTaxesStatement:openAlias()
        lRet := !(cAliasMit)->(eof())
        (cAliasMit)->(dbCloseArea())
    endIf

return lRet

//-------------------------------------------------------------------
/*{Protheus.doc} checkTaxesIdInLEM
    @description Valida se o Id dos títulos de impostos existem na tabela LEM.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 15/07/2025
    @return
*/
//-------------------------------------------------------------------
method checkTaxesIdInLEM() as logical class TitlesScreening

    self:loadTaxesId()

return self:jTaxesIdDoc:hasProperty("TAXES_ID")

//-------------------------------------------------------------------
/*{Protheus.doc} deleteMitData
    @description Realiza a integração de dados do MIT como exclusão.
        Utilizado quando já houve integração do título como MIT, mas após alteração o mesmo passou a ser integrado como REINF.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 16/07/2025
    @return
*/
//-------------------------------------------------------------------
method deleteMitData() class TitlesScreening
    local nTaxesId := 1 as numeric

    self:cOperation := DELETE_OPERATION

    for nTaxesId := 1 to len(self:jTaxesIdDoc["TAXES_ID"])
        self:setIdDoc(self:jTaxesIdDoc["TAXES_ID"][nTaxesId]["IDDOC"])
        self:cMovType   := self:jTaxesIdDoc["TAXES_ID"][nTaxesId]["MOVTYPE"]
        
        self:integrateToTaf()
    next
return

//-------------------------------------------------------------------
/*{Protheus.doc} updateIntegrateStatus
    @description Valida se o título tem os requisitos para ser integrado como REINF. Caso positivo, chama o método de integração com o TAF como alteração.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 25/07/2025
    @return
*/
//-------------------------------------------------------------------
method updateIntegrateStatus(cIdFk7 as character, cPortfolioAlias as character) class TitlesScreening
    local aArea     := {} as array
    local aAreaFKF  := {} as array
    local cSettlementDisplayMode := "" as character
    

    default cIdFk7 := ""
    default cPortfolioAlias := "SE1"

    if empty(cIdFk7)
        return
    endIf

    if cPortfolioAlias == "SE1"
        cSettlementDisplayMode := superGetMv("MV_FINTAF3",.F., "1")
    else
        cSettlementDisplayMode := superGetMv("MV_FINTAF4",.F., "1")
    endIf

    if cSettlementDisplayMode $ (WRITE_OFF_DATE + '/' + DATE_OF_AVAILABILITY)
        self:setIdDoc(cIdFk7)
        self:cOperation := UPDATE_OPERATION

        aArea    := getArea()
        aAreaFKF := FKF->(getArea())
        
        dbSelectArea('FKF')
        dbSetOrder(1) //FKF_FILIAL+FKF_IDDOC
        FKF->(dbSeek(xFilial('FKF')+self:cIdDoc))

        if cPortfolioAlias == "SE1"
            self:reinfBillsReceivable()
        else
            self:reinfBillsPayable()
        endIf

        if self:lIntegrate
            self:integrateToTaf()        
        endIf

        restArea(aAreaFKF)
        restArea(aArea)
    endIf
return

//-------------------------------------------------------------------
/*{Protheus.doc} integrateFromInvoice
    @description Método responsável por identificar se deve integrar o título a partir do documento de entrada ou saída.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 09/08/2025
    @return
*/
method integrateFromInvoice() as logical class TitlesScreening
    local aArea          := {} as array
    local aAreaFK7       := {} as array
    local aAreaSFT       := {} as array
    local cFk7Num        := "" as character
    local cFk7Prefixo    := "" as character
    local lRet           := .F. as logical
    local nFTDocSize     := tamSx3("FT_NFISCAL")[1] as numeric
    local nFTSerieSize   := tamSx3("FT_SERIE")[1] as numeric
    local nPortfolioCode := PAYABLE_PORTFOLIO_CODE as numeric

    if self:lBillsReceivable
        nPortfolioCode := RECEIVABLE_PORTFOLIO_CODE
    endIf

    aArea    := getArea()
    aAreaFK7 := FK7->(getArea())
    aAreaSFT := SFT->(getArea())

    dbSelectArea('FK7')
    FK7->(dbSetOrder(5)) //FK7_IDDOC
    if FK7->(dbSeek(self:cIdDoc))
        cFk7Num     := padR(alltrim(FK7->FK7_NUM),nFTDocSize)
        cFk7Prefixo := padR(alltrim(FK7->FK7_PREFIX),nFTSerieSize)

        if FTemSFT(nPortfolioCode, cFk7Num, cFk7Prefixo, FK7->FK7_CLIFOR, FK7->FK7_LOJA)
            lRet := (SFT->FT_CODISS != ' ' .and. SFT->FT_TIPO == 'S')
        endIf
    endIf

    restArea(aAreaSFT)
    restArea(aAreaFK7)
    restArea(aArea)
return lRet

//-------------------------------------------------------------------
/*{Protheus.doc} getFk7Data
    @description Método responsável por buscar dados da FK7 a partir do idDoc.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 25/09/2025
    @return
*/
method getFk7Data() as json class TitlesScreening
    local jFk7Data      := jsonObject():new() as json
    local aArea         := {} as array
    local aAreaFK7      := {} as array
    local aAreaFK2      := {} as array
    local lPositioned   := .F. as logical

    jFk7Data['TABELA'] := ''
    jFk7Data['CHAVE'] := ''
    jFk7Data['IDDOC'] := ''

    if isInCallStack('integratePost') .or. isInCallStack('screening')
        jFk7Data['TABELA'] := FK7->FK7_ALIAS
        jFk7Data['CHAVE'] := FK7->FK7_CHAVE
        jFk7Data['IDDOC'] := FK7->FK7_IDDOC
        return jFk7Data
    endIf

    aArea    := getArea()
    aAreaFK7 := FK7->(getArea())
    aAreaFK2 := FK2->(getArea())

    dbSelectArea('FK7')
    FK7->(dbSetOrder(5)) //FK7_IDDOC
    if FK7->(dbSeek(self:cIdDoc))
        lPositioned := .T.
    else
        dbSelectArea('FK2')
        FK2->(dbSetOrder(1)) //FK2_FILIAL+FK2_IDFK2
        if FK2->(dbSeek(xFilial('FK2')+self:cIdDoc))
            FK7->(dbGoTop())
            if FK7->(dbSeek(FK2->FK2_IDDOC))
                lPositioned := .T.
            endIf        
        endIf
    endIf

    if lPositioned
        jFk7Data['TABELA'] := FK7->FK7_ALIAS
        jFk7Data['CHAVE'] := FK7->FK7_CHAVE
        jFk7Data['IDDOC'] := FK7->FK7_IDDOC
    endIf

    restArea(aAreaFK2)
    restArea(aAreaFK7)
    restArea(aArea)
return jFk7Data

//-------------------------------------------------------------------
/*{Protheus.doc} getSE1Data
    @description Busca via query os campos do título SE1 correspondente ao registro
                    atual da FK7, evitando o posicionamento direto na área de trabalho.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 27/05/2026
    @return json: objeto com os campos do SE1 e a chave FOUND indicando se o registro foi encontrado.
*/
//-------------------------------------------------------------------
method getSE1Data() as json class TitlesScreening
    local jSE1Data          := jsonObject():new() as json
    local cQuery            := "" as character
    local nParameterOrder   := 1  as numeric
    local cAlias            := "" as character
    local aFields           := {} as array

    aadd(aFields, FWSX3Util():GetFieldStruct("E1_INSS"))

    jSE1Data['FOUND'] := .F.

    if self:oSE1Statement == Nil
        cQuery := " SELECT SE1.E1_TIPO, SE1.E1_FATURA, SE1.E1_NUMLIQ, SE1.E1_ORIGEM, SE1.E1_INSS, "
        cQuery += "        COALESCE(FKF.FKF_TPSERV, ' ') AS FKF_TPSERV, "
        cQuery += "        COALESCE(FKF.FKF_TPREPA, ' ') AS FKF_TPREPA, "
        cQuery += "        COALESCE(SA1.A1_RECINSS, ' ') AS A1_RECINSS, "
        cQuery += "        COALESCE(SED.ED_CALCINS, ' ') AS ED_CALCINS "
        cQuery += " FROM " + retSqlName("SE1") + " SE1 "
        cQuery += " LEFT JOIN " + retSqlName("FKF") + " FKF "
        cQuery += "     ON FKF.FKF_IDDOC  = ? "
        cQuery += "     AND FKF.FKF_FILIAL = ? "
        cQuery += "     AND FKF.D_E_L_E_T_ = ? "
        cQuery += " LEFT JOIN " + retSqlName("SA1") + " SA1 "
        cQuery += "     ON " + FWJoinFilial("SA1", "SE1")
        cQuery += "     AND SA1.A1_COD      = SE1.E1_CLIENTE "
        cQuery += "     AND SA1.A1_LOJA    = SE1.E1_LOJA "
        cQuery += "     AND SA1.D_E_L_E_T_ = ? "
        cQuery += " LEFT JOIN " + retSqlName("SED") + " SED "
        cQuery += "     ON " + FWJoinFilial("SED", "SE1")
        cQuery += "     AND SED.ED_CODIGO   = SE1.E1_NATUREZ "
        cQuery += "     AND SED.D_E_L_E_T_ = ? "
        cQuery += " WHERE SE1.E1_FILIAL  = ? "
        cQuery += " AND SE1.E1_CLIENTE   = ? "
        cQuery += " AND SE1.E1_LOJA      = ? "
        cQuery += " AND SE1.E1_PREFIXO   = ? "
        cQuery += " AND SE1.E1_NUM       = ? "
        cQuery += " AND SE1.E1_PARCELA   = ? "
        cQuery += " AND SE1.E1_TIPO      = ? "
        cQuery += " AND SE1.D_E_L_E_T_   = ? "

        cQuery := ChangeQuery(cQuery)

        self:oSE1Statement := FWExecStatement():New(cQuery)
    endIf

    // Parâmetros dos LEFT JOINs
    self:oSE1Statement:setString( nParameterOrder++, FK7->FK7_IDDOC  ) // FKF.FKF_IDDOC
    self:oSE1Statement:setString( nParameterOrder++, xFilial('FKF')  ) // FKF.FKF_FILIAL
    self:oSE1Statement:setString( nParameterOrder++, " "             ) // FKF.D_E_L_E_T_
    self:oSE1Statement:setString( nParameterOrder++, " "             ) // SA1.D_E_L_E_T_
    self:oSE1Statement:setString( nParameterOrder++, " "             ) // SED.D_E_L_E_T_
    // Parâmetros do WHERE
    self:oSE1Statement:setString( nParameterOrder++, FK7->FK7_FILTIT )
    self:oSE1Statement:setString( nParameterOrder++, FK7->FK7_CLIFOR )
    self:oSE1Statement:setString( nParameterOrder++, FK7->FK7_LOJA   )
    self:oSE1Statement:setString( nParameterOrder++, FK7->FK7_PREFIX )
    self:oSE1Statement:setString( nParameterOrder++, FK7->FK7_NUM    )
    self:oSE1Statement:setString( nParameterOrder++, FK7->FK7_PARCEL )
    self:oSE1Statement:setString( nParameterOrder++, FK7->FK7_TIPO   )
    self:oSE1Statement:setString( nParameterOrder++, " "             )

    self:oSE1Statement:SetFields(aFields)

    cAlias := self:oSE1Statement:openAlias()

    if !(cAlias)->(eof())
        jSE1Data['E1_TIPO']    := (cAlias)->E1_TIPO
        jSE1Data['E1_FATURA']  := (cAlias)->E1_FATURA
        jSE1Data['E1_NUMLIQ']  := (cAlias)->E1_NUMLIQ
        jSE1Data['E1_ORIGEM']  := (cAlias)->E1_ORIGEM
        jSE1Data['E1_INSS']    := (cAlias)->E1_INSS
        jSE1Data['FKF_TPSERV'] := (cAlias)->FKF_TPSERV
        jSE1Data['FKF_TPREPA'] := (cAlias)->FKF_TPREPA
        jSE1Data['A1_RECINSS'] := (cAlias)->A1_RECINSS
        jSE1Data['ED_CALCINS'] := (cAlias)->ED_CALCINS
        jSE1Data['FOUND']      := .T.
    endIf

    (cAlias)->(dbCloseArea())
return jSE1Data

//-------------------------------------------------------------------
/*{Protheus.doc} getSE2Data
    @description Busca via query os campos do título SE2 correspondente ao registro
                    atual da FK7, evitando o posicionamento direto na área de trabalho.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 27/05/2026
    @return json: objeto com os campos do SE2 e a chave FOUND indicando se o registro foi encontrado.
*/
//-------------------------------------------------------------------
method getSE2Data() as json class TitlesScreening
    local jSE2Data          := jsonObject():new() as json
    local cQuery            := "" as character
    local nParameterOrder   := 1  as numeric
    local cAlias            := "" as character
    local aFields           := {} as array

    aadd(aFields,FWSX3Util():GetFieldStruct("FKF_ORIINS"))

    jSE2Data['FOUND'] := .F.

    if self:oSE2Statement == Nil
        cQuery := " SELECT SE2.E2_TIPO, SE2.E2_ORIGEM, SE2.E2_FORNECE, SE2.E2_NATUREZ, "
        cQuery += "        COALESCE(FKF.FKF_TPSERV, ' ') AS FKF_TPSERV, "
        cQuery += "        COALESCE(FKF.FKF_TPREPA, ' ') AS FKF_TPREPA, "
        cQuery += "        COALESCE(FKF.FKF_ORIINS,  0)  AS FKF_ORIINS, "
        cQuery += "        COALESCE(SA2.A2_TIPO,    ' ') AS A2_TIPO, "
        cQuery += "        COALESCE(SA2.A2_RECINSS, ' ') AS A2_RECINSS, "
        cQuery += "        COALESCE(SED.ED_CALCINS, ' ') AS ED_CALCINS "
        cQuery += " FROM " + retSqlName("SE2") + " SE2 "
        cQuery += " LEFT JOIN " + retSqlName("FKF") + " FKF "
        cQuery += "     ON FKF.FKF_IDDOC  = ? "
        cQuery += "     AND FKF.FKF_FILIAL = ? "
        cQuery += "     AND FKF.D_E_L_E_T_ = ? "
        cQuery += " LEFT JOIN " + retSqlName("SA2") + " SA2 "
        cQuery += "     ON " + FWJoinFilial("SA2", "SE2")
        cQuery += "     AND SA2.A2_COD      = SE2.E2_FORNECE "
        cQuery += "     AND SA2.A2_LOJA    = SE2.E2_LOJA "
        cQuery += "     AND SA2.D_E_L_E_T_ = ? "
        cQuery += " LEFT JOIN " + retSqlName("SED") + " SED "
        cQuery += "     ON " + FWJoinFilial("SED", "SE2")
        cQuery += "     AND SED.ED_CODIGO   = SE2.E2_NATUREZ "
        cQuery += "     AND SED.D_E_L_E_T_ = ? "
        cQuery += " WHERE SE2.E2_FILIAL  = ? "
        cQuery += " AND SE2.E2_PREFIXO   = ? "
        cQuery += " AND SE2.E2_NUM       = ? "
        cQuery += " AND SE2.E2_PARCELA   = ? "
        cQuery += " AND SE2.E2_TIPO      = ? "
        cQuery += " AND SE2.E2_FORNECE   = ? "
        cQuery += " AND SE2.E2_LOJA      = ? "
        cQuery += " AND SE2.D_E_L_E_T_   = ? "

        cQuery := ChangeQuery(cQuery)

        self:oSE2Statement := FWExecStatement():New(cQuery)
    endIf

    // Parâmetros dos LEFT JOINs
    self:oSE2Statement:setString( nParameterOrder++, FK7->FK7_IDDOC  ) // FKF.FKF_IDDOC
    self:oSE2Statement:setString( nParameterOrder++, xFilial('FKF')  ) // FKF.FKF_FILIAL
    self:oSE2Statement:setString( nParameterOrder++, " "             ) // FKF.D_E_L_E_T_
    self:oSE2Statement:setString( nParameterOrder++, " "             ) // SA2.D_E_L_E_T_
    self:oSE2Statement:setString( nParameterOrder++, " "             ) // SED.D_E_L_E_T_
    // Parâmetros do WHERE
    self:oSE2Statement:setString( nParameterOrder++, FK7->FK7_FILTIT )
    self:oSE2Statement:setString( nParameterOrder++, FK7->FK7_PREFIX )
    self:oSE2Statement:setString( nParameterOrder++, FK7->FK7_NUM    )
    self:oSE2Statement:setString( nParameterOrder++, FK7->FK7_PARCEL )
    self:oSE2Statement:setString( nParameterOrder++, FK7->FK7_TIPO   )
    self:oSE2Statement:setString( nParameterOrder++, FK7->FK7_CLIFOR )
    self:oSE2Statement:setString( nParameterOrder++, FK7->FK7_LOJA   )
    self:oSE2Statement:setString( nParameterOrder++, " "             )

    self:oSE2Statement:SetFields(aFields)

    cAlias := self:oSE2Statement:openAlias()

    if !(cAlias)->(eof())
        jSE2Data['E2_TIPO']    := (cAlias)->E2_TIPO
        jSE2Data['E2_ORIGEM']  := (cAlias)->E2_ORIGEM
        jSE2Data['E2_FORNECE'] := (cAlias)->E2_FORNECE
        jSE2Data['E2_NATUREZ'] := (cAlias)->E2_NATUREZ
        jSE2Data['FKF_TPSERV'] := (cAlias)->FKF_TPSERV
        jSE2Data['FKF_TPREPA'] := (cAlias)->FKF_TPREPA
        jSE2Data['FKF_ORIINS'] := (cAlias)->FKF_ORIINS
        jSE2Data['A2_TIPO']    := (cAlias)->A2_TIPO
        jSE2Data['A2_RECINSS'] := (cAlias)->A2_RECINSS
        jSE2Data['ED_CALCINS'] := (cAlias)->ED_CALCINS
        jSE2Data['FOUND']      := .T.
    endIf

    (cAlias)->(dbCloseArea())
return jSE2Data
