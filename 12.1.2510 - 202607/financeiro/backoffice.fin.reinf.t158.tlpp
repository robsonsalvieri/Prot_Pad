#include "msobject.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#Include "TOTVS.CH"

#define PAYABLE_PORTFOLIO_CODE '1'
#define PRIVATE_PENSION '010'
#define FAPI '011'
#define FUNPRESP '012'
#define ALIMONY '013'
#define DEPENDENTS '024'
#define OTHERS '006'
#define TAX_EXEMPT_AGE_65_PLUS '015'
#define TRAVEL_ALLOWANCE '016'
#define CONTRACT_TERMINATION_COMPENSATION '017'
#define CASH_BONUS '018'
#define PAYMENT_TO_MICROENTERPRISE_PARTNER '019'
#define RETIREMENT_DUE_TO_SERIOUS_ILLNESS '020'
#define PENSION_SUPPLEMENT_CONTRIBUTIONS '021'
#define EXPENSE_ALLOWANCE '022'
#define LATE_PAYMENT_INTEREST '025'
#define PENSION_WITHDRAWAL_SERIOUS_ILLNESS '026'
#define OTHERS_TECHINICAL_NOTE '027'

namespace totvs.protheus.backoffice.fin.taf.smartschedule

//-------------------------------------------------------------------
/*/{Protheus.doc} DataBlockT158
    Classe responsável por selecionar e montar Json do Bloco T158 ()
    @author guilhermed.santos@totvs.com.br
    @since 15/05/2025
    @version 12.1.2410
*/
//-------------------------------------------------------------------
class DataBlockT158
    protected data cIdDoc 				as character
    protected data cIdMov 				as character
    protected data cAliasQry 			as character
    protected data cAliasAux 			as character
	protected data cSupplierID 			as character
    protected data jBlockT158 			as json
	protected data jDeductionType 		as json
    protected data jExemptionsType 		as json
	protected data lCpfFkj  			as logical
    protected data lPCCinPayment 		as logical
    protected data lHasDataBlock 		as logical
	protected data lIssinPayment 		as logical
	protected data lIRTaxInPayment 		as logical
	protected data lIRTaxAggregated		as logical
	protected data lPccMR   			as logical
    protected data lIrfMR   			as logical
    protected data lIssMR   			as logical
    protected data lIrfBxMR 			as logical
    protected data lPccBxMR 			as logical
    protected data lIssBxMR 			as logical
    protected data oStatement 			as object
    protected data oDHTStatement		as object
    protected data oTaxBordStatement 	as object
    protected data oWriteOffStatement 	as object
    protected data oFactorStatement 	as object
    protected data oFkyStatement 		as object
    protected data oIRSimpStatement 	as object
    protected data oAdvancePaymentStatement as object
    protected data oIncomeNatureStatement	as object
    protected data oFirstDedStatement	as object
	protected data oQryFk3Statement 	as object

    public method new(cIdDoc as character, cIdMov as character) as object
    public method loadT158Block()
    public method getHasDataBlock() as logical
    public method getT158Block() as json
    protected method setIdDoc(cIdDoc as character)
    protected method setIdMov(cIdMov as character)
    protected method getT158Data() as json
    protected method setHasDataBlock(lHasDataBlock as logical)
    protected method loadStatement()
    protected method loadAdvancePaymentStatement()
    protected method loadWriteOffStatement()
    protected method getTaxBordereaux() as array
	protected method loadTaxReliefs()
	protected method loadSupplierID()
    protected method calculateProportionalPCCOnWriteOff(aT158Trb as array, lIndividualSupp as logical, dDataPg as date, lIsento as logical, lRatIrrf as logical) as logical
    protected method checkIncomeNatureFky(aT158Trb as array, lIndividualSupp as logical, dDataPg as date, lIsento as logical, lRatIrrf as logical, nSimpDed as numeric, lSimpDed as logical) as logical
    protected method getTafTaxCode(cNatRen as character) as character
	protected method newCpf(cIdOrig as character, cTabOri as character) as logical
	protected method validateIncomeNature(cNatRen as character) as logical
	protected method getNumberOfDependents() as numeric
	protected method getDepDedussionValue(dData as date, nNumOfDep as numeric) as numeric
	protected method isFirstDeduction(dGenerationDate as date) as logical
	protected method validateTaxReliefs(aDedDetail as array, aExemptionDetail as array, lIsento as logical, dGenerationDate as date, lSusp as logical, nSimpDed as numeric, lSimpDed as logical)
	protected method loadDependentsOnAlimony(cTipDed as character, lSusp as logical) as array
	protected method loadIRSimplified(dInitDate as date, dFinalDate as date) as numeric
	protected method getTaxCode(lCSRF as logical, cTaxType as character, cNatren as character, lCOSIRF as logical) as character
	protected method checkAdvPayIncomeNature(aT158Trb as array, lIndividualSupp as logical, dDataPg as date, lIsento as logical, nSimpDed as numeric, lSimpDed as logical) as logical
	protected method FKWSusp() as logical
    protected method loadIRTaxInPayment()
	protected method getTaxesFromIdDoc() as json
	protected method loadTaxesConfigurations()
	protected method validateTaxBorderaux(cIdFk2 as character, cFilOri as character) as logical
endClass


//-------------------------------------------------------------------
/*{Protheus.doc} new
    Construtor
    @return object: self
    @author guilhermed.santos
    @since 15/05/2025
    @version 12.1.2410
*/
//-------------------------------------------------------------------
method new(cIdDoc as character, cIdMov as character) as object class DataBlockT158
        
		self:jBlockT158 := jsonObject():new()
		self:jDeductionType := jsonObject():new()
        self:jExemptionsType := jsonObject():new()
		self:lPCCinPayment := superGetMv("MV_BX10925",.F.,"2") == "1"
		self:lIssinPayment := IsIssBx("P")
		self:lCpfFkj := .F.
		self:lIRTaxInPayment := .F.
		self:lIRTaxAggregated := .F.
		self:cSupplierID := ""
		self:cAliasQry := ""
		self:setIdDoc(cIdDoc)
		self:setIdMov(cIdMov)
		self:loadTaxReliefs()
        self:setHasDataBlock(.F.)
        self:oStatement := Nil
        self:oDHTStatement := Nil
        self:oTaxBordStatement := Nil
        self:oWriteOffStatement := Nil
        self:oFactorStatement := Nil
        self:oFkyStatement := Nil
        self:oIncomeNatureStatement := Nil
        self:oFirstDedStatement := Nil
        self:oIRSimpStatement := Nil
        self:oAdvancePaymentStatement := Nil
        self:oQryFk3Statement := Nil
return self

//-------------------------------------------------------------------
/*{Protheus.doc} setIdDoc
    @description Define o conteúdo da propriedade cIdDoc.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 15/05/2025
    @return
*/
//-------------------------------------------------------------------
method setIdDoc(cIdDoc as character) class DataBlockT158
    self:cIdDoc := cIdDoc
return

//-------------------------------------------------------------------
/*{Protheus.doc} setIdMov
    @description Define o conteúdo da propriedade cIdMov.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 27/06/2025
    @return
*/
//-------------------------------------------------------------------
method setIdMov(cIdMov as character) class DataBlockT158
    self:cIdMov := cIdMov
return

//-------------------------------------------------------------------
/*{Protheus.doc} loadT158Block
    @description Responsável por acionar os métodos de buscas de registros e montar o json na propriedade self:jBlockT158.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 15/05/2025
    @return
*/
//-------------------------------------------------------------------
method loadT158Block() class DataBlockT158
	local aArea         := {} as array
    local aAreaFK7      := {} as array

    aArea    := getArea()
    aAreaFK7 := FK7->(getArea())
    
    dbSelectArea('FK7')
    FK7->(dbSetOrder(5)) //FK7_IDDOC
    if FK7->(dbSeek(self:cIdDoc))
		self:jBlockT158 := self:getT158Data()
    endIf
    
    if self:jBlockT158:hasProperty("T158")
        self:setHasDataBlock(.T.)
    endIf

    restArea(aAreaFK7)
    restArea(aArea)
return


//-------------------------------------------------------------------
/*{Protheus.doc} getT158Block
    @description Retorna a propriedade self:jBlockT158.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 15/05/2025
    @return
*/
//-------------------------------------------------------------------
method getT158Block() as json class DataBlockT158
return self:jBlockT158

//-------------------------------------------------------------------
/*{Protheus.doc} getT158Data
    @description Montagem do Json do bloco T158.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 15/05/2025
    @return
*/
//-------------------------------------------------------------------
method getT158Data() as json class DataBlockT158
    local aDedDetail 		:= {} as array
	local aT158Trb 	 		:= {} as array
	local aT158AG 	 		:= {} as array
	local aAuxT158 	 		:= {} as array
	local aBlockT158 		:= {} as array
	local aBlockT158AA 		:= {} as array
	local aBlockT158AB 		:= {} as array
	local aBlockT158AC 		:= {} as array
	local aBlockT158AD 		:= {} as array
	local aBlockT158AE 		:= {} as array
	local aBlockT158AF 		:= {} as array
	local aBlockT158AG 		:= {} as array
	local aBlockT158AH 		:= {} as array
	local aExemptionDetail 	:= {}	as array
	local lTitPA 	 		:= .F. as logical
	local lTemNatR 	 		:= .F. as logical
	local lNatRenBx  		:= .F. as logical
	local lIsento 	 		:= .F. as logical
	local lSuspFKW 	 		:= .F. as logical
	local lRatIrrf 	 		:= .F. as logical
	local lSimpDed	 		:= .F. as logical
	local lPET158  	 		:= .F. as logical
	local lIndividualSupp 	:= .F. as logical
	local cImpIR 	 		:= "" as character
	local cImpPis 	 		:= "" as character
	local cImpCof 	 		:= "" as character
	local cImpCSL 	 		:= "" as character
	local cNrProc 	 		:= "" as character
	local cCNPJSCP 	 		:= "" as character
	local cIndScp 	 		:= "" as character
	local cOldNatRen 		:= "" as character
	local cCodPart 	 		:= "" as character
	local cCdReRat	 		:= "" as character
	local dDtEmis	 		:= dDatabase as date
	local dDataPg 	 		:= dDataBase as date
	local dDtesccon  		:= dDataBase as date
	local nForT158trb		:= 0 as numeric
	local nForT158AD 		:= 0 as numeric
	local nForT158AE 		:= 0 as numeric
	local nForT158AF 		:= 0 as numeric
	local nForT158AG 		:= 0 as numeric
	local nForT158AH 		:= 0 as numeric
	local nSimpDed	 		:= 0 as numeric
	local nFkgImp	 		:= 0 as numeric
	local nTamFTSer  		:= 0 as numeric
	local nTamFTDoc  		:= 0 as numeric
	local nCounter	 		:= 0 as numeric
	local nCart 	 		:= 1 as numeric
    local jT158				:= jsonObject():new() as json

	self:loadStatement()

	lPET158  	 	:= ExistBlock("F989T158")
	nTamFTSer  		:= TamSx3("FT_SERIE")[1]	
	nTamFTDoc  		:= TamSx3("FT_NFISCAL")[1] 
	nFkgImp	 		:= tamSx3("FKG_TPIMP")[1]
	cImpIR	  		:= PadR( 'IRF', nFkgImp )
	cImpPis	  		:= PadR( 'PIS', nFkgImp )
	cImpCof	  		:= PadR( 'COF', nFkgImp )
	cImpCSL	  		:= PadR( 'CSL', nFkgImp )
	dDtEmis			:= CTOD("  /  /    ")
	dDataPg   		:= CTOD("  /  /    ")
	dDtesccon		:= CTOD("  /  /    ")
	lTitPA    		:= (self:cAliasQry)->E2_TIPO $ MVPAGANT
	cCodPart  		:= (self:cAliasQry)->A2_COD + (self:cAliasQry)->A2_LOJA
	lIndividualSupp := (self:cAliasQry)->A2_TIPO == "F" .or. ((self:cAliasQry)->A2_TIPO == "J" .and. (self:cAliasQry)->A2_IRPROG == "1")

	cCdReRat 	:= superGetMv("MV_RETIRRT",.F.,"3208")
	self:loadIRTaxInPayment()

	self:loadTaxesConfigurations()

	self:lPCCinPayment   := (self:lPccMR .and. self:lPccBxMR) .or. (!self:lPccMR .and. self:lPCCinPayment)
	self:lIssinPayment   := (self:lIssMR .and. self:lIssBxMR) .or. (!self:lIssMR .and. self:lIssinPayment)
	self:lIRTaxInPayment := (self:lIrfMR .and. self:lIrfBxMR) .or. (!self:lIrfMR .and. (self:cAliasQry)->A2_CALCIRF == "2")
        
	
	if !self:lPCCinPayment .or. lTitPA
		lTemNatR := FTemFKW(self:cIdDoc)
	else
		lTemNatR := FTemFKY(self:cIdDoc)
	endIf

	if lTemNatR
		if lTitPA
			self:loadAdvancePaymentStatement()
		else	
			self:loadWriteOffStatement()
		endIf
		
		dDtesccon	:= STOD((self:cAliasQry)->FKF_DTECON)

		if empty(dDtEscCon)
			dDtEscCon	:= alltrim(Dtos(dDtEscCon))
		endIf
	
		while (self:cAliasAux)->(!eof())
			self:loadSupplierID()

			dDtEmis := STOD((self:cAliasQry)->E2_EMISSAO)
			dDataPg := STOD((self:cAliasAux)->DATAFG)

			if !empty((self:cAliasQry)->FKF_CGCSCP)
				cIndScp  := "2"
			endIf

			if lIndividualSupp
				if self:lCpfFkj .and. alltrim((self:cAliasQry)->E2_CODRET) $ cCdReRat
					if !empty((self:cAliasAux)->CPF) .and. (self:cAliasQry)->A2_IRPROG == '1'
						cCodPart := (self:cAliasAux)->CPF
						lRatIrrf := .T.
					endIf
				endIf
				if self:lIRTaxInPayment
					self:validateTaxReliefs(@aDedDetail, @aExemptionDetail, @lIsento, dDataPg,, @nSimpDed, @lSimpDed)
				endIf
			endIf

			cSerie  := padr(alltrim((self:cAliasQry)->E2_PREFIXO), nTamFTSer)
			cNumNF  := padr(alltrim((self:cAliasQry)->E2_NUM), nTamFTDoc)
			
			if FTemSFT(nCart, cNumNF, @cSerie, (self:cAliasQry)->A2_COD, (self:cAliasQry)->A2_LOJA, nTamFTSer)
				cNumTit   := alltrim((self:cAliasQry)->E2_NUM)
			else
				cParcela   := alltrim((self:cAliasQry)->E2_PARCELA)
				if !empty(cParcela)
					cNumTit  := alltrim((self:cAliasQry)->E2_NUM) + "-" + cParcela
				else
					cNumTit  := alltrim((self:cAliasQry)->E2_NUM) 
				endIf		
			endIf

			aadd( aBlockT158, { "NUMERO":cNumTit,;
								"SERIE":(self:cAliasQry)->E2_PREFIXO,;
								"COD_PARTICIPANTE":"F" + cCodPart,;
								"EMISSAO":dDtEmis,;
								"NATUREZ":"0",;
								"NUM_PARC":(self:cAliasQry)->E2_PARCELA,;
								"DT_PGTO":dDataPg,;
								"SEQUENCIAL":(self:cAliasAux)->SEQ,;
								"INDFCISCP":cIndScp,;
								"DTESCRCONT":dDtesccon,;
								"OBSERVACAO":"",;
								"PERAPUR":""} )
	
			nCounter++
			if lTitPA
				lNatRenBx := self:checkAdvPayIncomeNature(@aT158Trb, lIndividualSupp, dDataPg, lIsento, nSimpDed, lSimpDed)
			elseIf !self:lPCCinPayment
				lNatRenBx := self:calculateProportionalPCCOnWriteOff(@aT158Trb, lIndividualSupp, dDataPg, lIsento, lRatIrrf, nSimpDed, lSimpDed)
			else
				lNatRenBx := self:checkIncomeNatureFky(@aT158Trb, lIndividualSupp, dDataPg, lIsento, lRatIrrf, nSimpDed, lSimpDed)
			endIf

			if lPET158
				aAuxT158 := ExecBlock("F989T158" ,.F.,.F.,{(self:cAliasAux)->IDDOC,(self:cAliasAux)->IDMOV,aT158Trb})
				if ValType(aAuxT158) == "A" .and. Len(aT158Trb) > 0
					lNatRenBx := .T.
					aT158Trb := aClone(aAuxT158)
					aAuxT158 := {} 
				endIf
			endIf

			if lNatRenBx .and. Len(aT158Trb) > 0

				For nForT158trb := 1 To Len(aT158Trb)
					if !empty((self:cAliasQry)->FKF_CGCSCP)
						cCNPJSCP := (self:cAliasQry)->FKF_CGCSCP 
					endIf

					if aT158Trb[nForT158trb][2] <> cOldNatRen

						AAdd(aBlockT158AA, {"NATUREZA_RENDIMENTO": aT158Trb[nForT158trb][2],;
											"VLR_PGTO": aT158Trb[nForT158trb][3],;
											"IND_DEC_TERC": (self:cAliasQry)->FKF_INDDEC,;
											"NR_INSC_FCI_SCP": cCNPJSCP,;
											"INDRRA": "" ,;
											"TPPROCRRA": "" ,;
											"NRPROC": cNrProc ,;
											"COMPFP": "" } )
					endIf

					if alltrim(aT158Trb[nForT158trb][1]) $ "10|11|18|28|29|30"

						AAdd(aBlockT158AB, {"TRIBUTO": aT158Trb[nForT158trb][1],;
											"BASE_CALCULO": aT158Trb[nForT158trb][4],;
											"VLR_TRIBUTO": aT158Trb[nForT158trb][5],;
											"ALIQUOTA": 0 } )
											
						if !empty(aT158Trb[nForT158trb][6])

							AAdd(aBlockT158AC, {"NUM_PROC": aT158Trb[nForT158trb][6],;
												"IND_PROC": aT158Trb[nForT158trb][7],;
												"COD_SUS": aT158Trb[nForT158trb][8],;
												"COD_TRIB": aT158Trb[nForT158trb][1],;
												"VAL_SUS": aT158Trb[nForT158trb][09],;
												"BASE_SUSPENSA": aT158Trb[nForT158trb][10],;
												"VLR_COMP_ANO_CALENDARIO": 0 ,;
												"VLR_COMP_ANO_ANT": 0 } )

							if (self:cAliasAux)->SEQ == (self:cAliasAux)->SEQMAX .and. (self:cAliasQry)->E2_SALDO == 0

								lSuspFKW := self:FKWSusp()

								self:validateTaxReliefs(@aT158AG,,, dDataPg, lSuspFKW)

								if Len(aT158AG) > 0
									For nForT158AG := 1 to Len(aT158AG)
										
										AAdd(aBlockT158AG, {"IND_TP_DEDUCAO": aT158AG[nForT158AG][1],;
															"VAL_DEDUCAO": aT158AG[nForT158AG][3]} )
										if Len(aT158AG[nForT158AG][5]) > 0
											For nForT158AH := 1 to Len(aT158AG[nForT158AG][5])
												
												AAdd(aBlockT158AH, {"CPF": aT158AG[nForT158AG][5][nForT158AH][2],;
																	"VAL_DEDUCAO_SUSPENSO": aT158AG[nForT158AG][5][nForT158AH][3],;
																	"IND_TP_DEDUCAO": aT158AG[nForT158AG][1]} )
											Next nForT158AH
										endIf

										if Len(aBlockT158AH) > 0
											aBlockT158AG[nForT158AG]["T158AH"] := aClone(aBlockT158AH)
											aBlockT158AH := {}
										endIf

									Next nForT158AG
									if Len(aBlockT158AG) > 0
										aBlockT158AC[Len(aBlockT158AC)]["T158AG"] := aClone(aBlockT158AG)
										aBlockT158AG := {}
									endIf
								endIf
								aT158AG  := {}
							endIf
						endIf

						if (self:cAliasAux)->SEQ == (self:cAliasAux)->SEQMAX .and. ((self:cAliasQry)->E2_SALDO == 0 .or. lTitPA)
							For nForT158AD := 1 To Len( aDedDetail )

								AAdd(aBlockT158AD, {"TIPO_DEDUCAO": aDedDetail[nForT158AD][1],;
													"VAL_DEDUCAO": aDedDetail[nForT158AD][2],;
													"VAL_DEDUCAO_SUSP": aDedDetail[nForT158AD][3],;
													"NUM_PREVIDENCIA": aDedDetail[nForT158AD][4],;
													"INFO_ENTIDADE": aDedDetail[nForT158AD][6] })

								if Len(aDedDetail[nForT158AD][5]) > 0
									For nForT158AF := 1 to Len(aDedDetail[nForT158AD][5])

										AAdd(aBlockT158AF, {"CPF": aDedDetail[nForT158AD][5][nForT158AF][2],;
															"VAL_DEDUCAO": aDedDetail[nForT158AD][5][nForT158AF][3]} )
									Next nForT158AF
								endIf
								if len(aBlockT158AF) > 0
									aBlockT158AD[nForT158AD]["T158AF"] := aClone(aBlockT158AF)
									aBlockT158AF := {}
								endIf
							Next nForT158AD
						endIf

						For nForT158AE := 1 To Len( aExemptionDetail )

							AAdd(aBlockT158AE, {"TIPO_ISENCAO": aExemptionDetail[nForT158AE][1],;
												"VAL_ISENTO": aExemptionDetail[nForT158AE][2],;
												"DESC_RENDIMENTO": aExemptionDetail[nForT158AE][3] } )
						Next nForT158AE
						
						if len(aBlockT158AD) > 0
							aBlockT158AB[Len(aBlockT158AB)]["T158AD"] := aClone(aBlockT158AD)
							aBlockT158AD := {}
						endIf

						if len(aBlockT158AE) > 0
							aBlockT158AB[Len(aBlockT158AB)]["T158AE"] := aClone(aBlockT158AE)
							aBlockT158AE := {}
						endIf
					endIf

					cOldNatRen := aT158Trb[nForT158trb][2]

					if nForT158trb == Len(aT158Trb) .Or. (nForT158trb+1 <= Len(aT158Trb) .And. aT158Trb[nForT158trb+1][2] <> cOldNatRen)
						if len(aBlockT158AB) > 0
							aBlockT158AA[Len(aBlockT158AA)]["T158AB"] := aClone(aBlockT158AB)
							aBlockT158AB := {}
						endIf

						if len(aBlockT158AC) > 0
							aBlockT158AA[Len(aBlockT158AA)]["T158AC"] := aClone(aBlockT158AC)
							aBlockT158AC := {}
						endIf
					endIf

				Next nForT158trb
			endIf

			if len(aBlockT158AA) > 0
				aBlockT158[nCounter]["T158AA"] := aBlockT158AA
				aBlockT158AA := {}
			endIf

			aT158Trb := {}
			aDedDetail := {}
			aExemptionDetail := {}
			lIsento := .F.
			cOldNatRen := ""
			lRatIrrf := .F.

			(self:cAliasAux)->( DbSkip() )
		endDo
	endIf

	if len(aBlockT158) > 0
        jT158["T158"] := aBlockT158
    endIf

	FwFreeArray(aT158Trb)
	FwFreeArray(aAuxT158)
	FwFreeArray(aDedDetail)
	FwFreeArray(aExemptionDetail)

return jT158

//-------------------------------------------------------------------
/*{Protheus.doc} setHasDataBlock
    @description Define o conteúdo da propriedade self:lHasDataBlock.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 15/05/2025
    @return
*/
//-------------------------------------------------------------------
method setHasDataBlock(lHasDataBlock) class DataBlockT158
    self:lHasDataBlock := lHasDataBlock
return

//-------------------------------------------------------------------
/*{Protheus.doc} getHasDataBlock
    @description Retorna o conteúdo da propriedade self:lHasDataBlock.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 15/05/2025
    @return
*/
//-------------------------------------------------------------------
method getHasDataBlock() as logical class DataBlockT158
return self:lHasDataBlock

//-------------------------------------------------------------------
/*{Protheus.doc} loadStatement
    @description Monta e executa query principal do bloco T158.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 15/05/2025
    @return
*/
//-------------------------------------------------------------------
method loadStatement() class DataBlockT158
	local cQuery	    := "" as character
    local nParamOrder   := 1  as numeric
	local lFKJNDep 		:= FKJ->(FieldPos("FKJ_NUMDEP")) > 0

    if self:oStatement == NIL
        cQuery	:= " SELECT FKF_DTECON, FKF_CGCSCP, FKF_INDDEC, "
		cQuery	+= " E2_FILIAL, E2_PREFIXO, E2_NUM, E2_PARCELA, E2_TIPO, E2_FORNECE, E2_LOJA, E2_NATUREZ, E2_CODRET, E2_EMISSAO, "
		cQuery	+= " E2_SALDO, E2_NUMBOR, E2_INSS, E2_BAIXA, E2_IRRF, E2_PIS, E2_COFINS, E2_CSLL, "
        cQuery	+= " A2_CALCIRF, A2_IRPROG, A2_FILIAL, A2_COD, A2_LOJA, A2_TIPO, A2_CGC, A2_CPFIRP, A2_NUMDEP, "
        cQuery	+= " FKJ_CPF, FKJ_PERCEN, FK7_IDDOC "
		if lFKJNDep
			cQuery	+= ", FKJ_NUMDEP "
		endIf
        cQuery	+= " FROM " + retSqlName("FK7") + " FK7 "
        cQuery	+= " 	INNER JOIN " + retSqlName("SE2") + " SE2 "
        cQuery	+= " 		ON  SE2.E2_FILIAL = FK7.FK7_FILTIT "
        cQuery	+= " 		AND SE2.E2_PREFIXO = FK7.FK7_PREFIX "
        cQuery	+= " 		AND SE2.E2_NUM = FK7.FK7_NUM "
        cQuery	+= " 		AND SE2.E2_PARCELA = FK7.FK7_PARCEL "
        cQuery	+= " 		AND SE2.E2_TIPO = FK7.FK7_TIPO "
        cQuery	+= " 		AND SE2.E2_FORNECE = FK7.FK7_CLIFOR "
        cQuery	+= " 		AND SE2.E2_LOJA = FK7.FK7_LOJA "
        cQuery	+= " 		AND SE2.D_E_L_E_T_ = ? "
        cQuery	+= " 	INNER JOIN " + retSqlName("SA2") + " SA2 "
        cQuery	+= " 		ON " + FWJoinFilial("SA2", "SE2")
        cQuery	+= " 		AND SA2.A2_COD = SE2.E2_FORNECE "
        cQuery	+= " 		AND SA2.A2_LOJA = SE2.E2_LOJA "
        cQuery	+= " 		AND SA2.D_E_L_E_T_ = ? "
        cQuery	+= " 	INNER JOIN " + retSqlName("FKF") + " FKF "
        cQuery	+= " 		ON " + FWJoinFilial("FKF", "FK7")
        cQuery	+= " 		AND FKF.FKF_IDDOC = FK7.FK7_IDDOC "
        cQuery	+= " 		AND FKF.D_E_L_E_T_ = ? "
        cQuery	+= " 	LEFT JOIN " + retSqlName("FKJ") + " FKJ "
        cQuery	+= " 		ON " + FWJoinFilial("FKJ", "SA2")
        cQuery	+= " 		AND FKJ.FKJ_COD = SA2.A2_COD "
        cQuery	+= " 		AND FKJ.FKJ_LOJA = SA2.A2_LOJA "
        cQuery	+= " 		AND FKJ.D_E_L_E_T_ = ? "
        cQuery	+= " WHERE FK7.FK7_IDDOC = ? "
		cQuery	+= " AND FK7.FK7_ALIAS = ? "
        cQuery	+= " AND FK7.D_E_L_E_T_ = ? "

        cQuery := ChangeQuery(cQuery)
        self:oStatement := FWExecStatement():New(cQuery)
    endIf

    self:oStatement:setString( nParamOrder++, " " )
    self:oStatement:setString( nParamOrder++, " " )
    self:oStatement:setString( nParamOrder++, " " )
    self:oStatement:setString( nParamOrder++, " " )
    self:oStatement:setString( nParamOrder++, self:cIdDoc )
    self:oStatement:setString( nParamOrder++, "SE2" )
    self:oStatement:setString( nParamOrder++, " " )

    self:cAliasQry := self:oStatement:openAlias()
return

//-------------------------------------------------------------------
/*{Protheus.doc} loadDependentsOnAlimony
    @description Quando houver dedução do IRPF por dependentes ou pensão alimenticia,
					essa função retornará o detalhamento das deduções para cada dependente
	@param cTipDed - Tipo da dedução: 1=Pensão Alimenticia / 2=Dependente
	@param lSusp   - Indentifica se dedução foi suspensa por um processo adm/juridico
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 04/06/2025
    @return
*/
//-------------------------------------------------------------------

//-------------------------------------------------------------------
/*/{Protheus.doc} loadAdvancePaymentStatement
Função para verificar se o PA deve ser considerado na extração, nas
seguintes situações:
	- PA possui TX gerado para o imposto
	- PA possui suspencao judicial para o imposto

@return nil

@author Fabio Casagrande Lima
@since 15/10/2019
@version P12
/*/
//-------------------------------------------------------------------
method loadAdvancePaymentStatement() class DataBlockT158
	local aCpoNum    	:= {} as array
	local aTamSX3Cpo 	:= {} as array
	local cQuery     	:= "" as character
	local nLoop      	:= 1 as numeric
	local nParamOrder 	:= 1 as numeric

	aCpoNum	   := {{'VALOR',"E2_VLCRUZ"},{'VALIRF',"E2_IRRF"},{'BASIRF',"E2_BASEIRF"}}

	//Busca a movimentação para o titulo PA
	if self:oAdvancePaymentStatement == Nil	
		cQuery := " SELECT SE2.E2_FILIAL FILIAL,FK7.FK7_IDDOC IDMOV, FK7.FK7_IDDOC IDDOC, FK5.FK5_DATA DATAFG,  " 
		cQuery += " SE2.E2_NUMBOR DOC, 0 SEQ, SE2.E2_VLCRUZ VALOR, ISNULL(SE2.E2_IRRF,0) VALIRF, "
		cQuery += " ISNULL(SE2.E2_BASEIRF,0) BASIRF,' ' AS CPF, 0 SEQMAX, SE2.E2_FILORIG FILORIG " 	
		
		cQuery += " FROM " + RetSqlName("SE2") + " SE2 "
		cQuery += " INNER JOIN " + RetSqlName("SA2") + " SA2 "
		cQuery += " 	ON " + FWJoinFilial("SA2", "SE2")
		cQuery += "   	AND SA2.A2_COD = SE2.E2_FORNECE "
		cQuery += "   	AND SA2.A2_LOJA = SE2.E2_LOJA "
		cQuery += "   	AND SA2.D_E_L_E_T_ = ?  "
		cQuery += " INNER JOIN " + RetSqlName("SED") + " SED "
		cQuery += " 	ON " + FWJoinFilial("SED", "SE2")
		cQuery += "   	AND SED.ED_CODIGO = SE2.E2_NATUREZ "
		cQuery += "   	AND SED.D_E_L_E_T_ = ?  "
		cQuery += " INNER JOIN " + RetSqlName("FK7") + " FK7 "
		cQuery += "  	ON  FK7.FK7_ALIAS = ? "
		cQuery += "   	AND FK7.FK7_FILTIT = SE2.E2_FILIAL "
		cQuery += "   	AND FK7.FK7_PREFIX = SE2.E2_PREFIXO "
		cQuery += "   	AND FK7.FK7_NUM = SE2.E2_NUM "	 		
		cQuery += "   	AND FK7.FK7_PARCEL = SE2.E2_PARCELA "	
		cQuery += "   	AND FK7.FK7_TIPO = SE2.E2_TIPO "		
		cQuery += "   	AND FK7.FK7_CLIFOR = SE2.E2_FORNECE "	
		cQuery += "   	AND FK7.FK7_LOJA = SE2.E2_LOJA "			
		cQuery += "   	AND FK7.FK7_IDDOC = ? "
		cQuery += "   	AND FK7.D_E_L_E_T_ = ? "
		cQuery += " INNER JOIN " + RetSqlName("FKF") + " FKF "
		cQuery += " 	ON " + FWJoinFilial("FKF", "FK7")
		cQuery += "   	AND FKF.FKF_IDDOC = FK7.FK7_IDDOC "
		cQuery += "   	AND FKF.D_E_L_E_T_ = ? "
		cQuery += " INNER JOIN " + RetSqlName("FK5") + " FK5 "
		cQuery += "   	ON FK5.FK5_IDDOC = FK7.FK7_IDDOC "
		cQuery += "	  	AND FK5.D_E_L_E_T_ = ? "
		cQuery += " WHERE SE2.E2_FILIAL = ? "
		cQuery += " 	AND SE2.E2_TIPO = ? "
		cQuery += "   	AND SE2.D_E_L_E_T_ = ? "	
		cQuery += "   	AND FKF.FKF_REINF IN (?) "
		cQuery += "   	AND FKF.FKF_NATREN != ? "

		cQuery := ChangeQuery( cQuery )
        self:oAdvancePaymentStatement := FwExecStatement():New(cQuery)
	endIf

	self:oAdvancePaymentStatement:setString(nParamOrder++, " ")
	self:oAdvancePaymentStatement:setString(nParamOrder++, " ")
	self:oAdvancePaymentStatement:setString(nParamOrder++, "SE2")
	self:oAdvancePaymentStatement:setString(nParamOrder++, self:cIdDoc)
	self:oAdvancePaymentStatement:setString(nParamOrder++, " ")
	self:oAdvancePaymentStatement:setString(nParamOrder++, " ")
	self:oAdvancePaymentStatement:setString(nParamOrder++, " ")
	self:oAdvancePaymentStatement:setString(nParamOrder++, xFilial("SE2"))
	self:oAdvancePaymentStatement:setString(nParamOrder++, "PA")
	self:oAdvancePaymentStatement:setString(nParamOrder++, " ")
	self:oAdvancePaymentStatement:setIn(nParamOrder++, {'2',' '})
	self:oAdvancePaymentStatement:setString(nParamOrder++, " ")

	self:cAliasAux := self:oAdvancePaymentStatement:openAlias()

	For nLoop := 1 To Len( aCpoNum )
		aTamSX3Cpo := TamSX3(aCpoNum[nLoop][2])
		TcSetField( self:cAliasAux, aCpoNum[nLoop][1], "N",aTamSX3Cpo[1],aTamSX3Cpo[2])
	Next nLoop

	FwFreeArray(aCpoNum)
	FwFreeArray(aTamSX3Cpo)

Return


//-------------------------------------------------------------------
/*/{Protheus.doc} loadWriteOffStatement
	@description Consulta se o título possui baixa(s) no período de extração.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 02/06/2025
    @return Nil
/*/
//-------------------------------------------------------------------
method loadWriteOffStatement() class DataBlockT158
	local aCpoNum    	:= {} as array
	local aTamSX3Cpo 	:= {} as array
	local aMotBx	 	:= {} as array
	local aIdMovs    	:= {} as array
	local cQuery     	:= "" as character
	local nLoop      	:= 1  as numeric
	local nParamOrder	:= 1  as numeric
	local dBaixa		:= StoD((self:cAliasQry)->E2_BAIXA) as date

	aCpoNum		:= {{'VALOR',"FK2_VALOR"}}

	if self:lPCCinPayment 
		aMotBx     := {'FAT','LIQ','DEV','PCC','IRF','ISS','IMR'}
	else
		aMotBx     := {'PCC','IRF','ISS','IMR'}
	endIf

	if !empty((self:cAliasQry)->E2_NUMBOR) 
		aIdMovs := self:getTaxBordereaux()
	endIf

	if empty(aIdMovs)
		aIdMovs := {' '}
	endIf

	if self:oWriteOffStatement == Nil	
		cQuery := " SELECT FK2.FK2_FILIAL FILIAL, FK2.FK2_IDFK2 IDMOV, FK2.FK2_IDDOC IDDOC, FK2.FK2_DATA DATAFG, "
		cQuery += " FK2.FK2_DOC DOC, FK2.FK2_SEQ SEQ, FK2.FK2_VALOR VALOR,FK2.FK2_FILORI FILORIG, FK2_MOTBX MOTBX, "
		cQuery += " 	ISNULL(FK3IRF.FK3_VALOR,0) VALIRF, ISNULL(FK3IRF.FK3_BASIMP,0) BASIRF, "
		cQuery += " 	ISNULL(FK3IRF.FK3_CGC,' ') CPF, "
		cQuery += " 	(SELECT	MAX(FK2SEQ.FK2_SEQ) SEQMAX "
		cQuery += " 		FROM " + RetSqlName("FK2") + " FK2SEQ "
		cQuery += " 		WHERE FK2SEQ.FK2_FILIAL = FK2.FK2_FILIAL "
		cQuery += " 		AND FK2SEQ.FK2_IDDOC = FK2.FK2_IDDOC "
		cQuery += " 		AND FK2SEQ.FK2_RECPAG = ? "
		cQuery += " 		AND FK2SEQ.D_E_L_E_T_ = ?  ) SEQMAX "
		cQuery += " FROM " + RetSqlName("FK2") + " FK2 "
		cQuery += " LEFT JOIN " + RetSqlName("FK3") + " FK3IRF "
		cQuery += "		ON FK3IRF.FK3_FILIAL = FK2.FK2_FILIAL "
		cQuery += " 	AND (FK3IRF.FK3_IDORIG = FK2.FK2_IDFK2 OR FK3IRF.FK3_IDORIG IN ( ? ) ) "
		cQuery += " 	AND FK3IRF.FK3_RECPAG = ? "
		cQuery += " 	AND FK3IRF.FK3_IMPOS = ? "
		cQuery += " 	AND FK3IRF.D_E_L_E_T_ = ? "
		cQuery += " WHERE FK2.FK2_FILORI = ? "
		cQuery += " 	AND FK2.FK2_DATA <= ? "
		cQuery += " 	AND FK2.FK2_RECPAG = ? "
		cQuery += " 	AND FK2.FK2_TPDOC NOT IN (?) "
		cQuery += " 	AND FK2.FK2_IDFK2 = ? "
		cQuery += " 	AND FK2.FK2_REINF IN (?) "
		cQuery += " 	AND FK2.FK2_MOTBX NOT IN ( ? )  "
		cQuery += " 	AND NOT EXISTS (SELECT FK2EST.FK2_IDDOC "
		cQuery += " 						FROM " + RetSqlName("FK2") + " FK2EST "
		cQuery += " 						WHERE FK2EST.FK2_FILIAL = FK2.FK2_FILIAL "
		cQuery += " 						AND FK2EST.FK2_IDDOC = FK2.FK2_IDDOC "
		cQuery += " 						AND FK2EST.FK2_SEQ = FK2.FK2_SEQ "
		cQuery += " 						AND FK2EST.FK2_TPDOC = ? ) "
		cQuery += "		AND FK2.D_E_L_E_T_ = ? "
		
		cQuery := changeQuery( cQuery )
        self:oWriteOffStatement := FwExecStatement():New(cQuery)
	endIf

	self:oWriteOffStatement:setString(nParamOrder++, 'P' )
	self:oWriteOffStatement:setString(nParamOrder++, ' ' )
	self:oWriteOffStatement:setIn(nParamOrder++, aIdMovs )
	self:oWriteOffStatement:setString(nParamOrder++, 'P' )
	self:oWriteOffStatement:setString(nParamOrder++, 'IRF' )
	self:oWriteOffStatement:setString(nParamOrder++, ' ' )
	self:oWriteOffStatement:setString(nParamOrder++, xFilial('FK2'))
	self:oWriteOffStatement:setDate(nParamOrder++, dBaixa)
	self:oWriteOffStatement:setString(nParamOrder++, 'P' )
	self:oWriteOffStatement:setIn(nParamOrder++, {'DC','D2','JR','J2','TL','MT','M2','CM','C2','TR','TE','E2','CH','ES'} )
	self:oWriteOffStatement:setString(nParamOrder++, self:cIdMov)
	self:oWriteOffStatement:setIn(nParamOrder++, {'2',' '} )
	self:oWriteOffStatement:setIn(nParamOrder++, aMotBx )
	self:oWriteOffStatement:setString(nParamOrder++, 'ES' )
	self:oWriteOffStatement:setString(nParamOrder++, ' ' )


	self:cAliasAux := self:oWriteOffStatement:openAlias()

	for nLoop := 1 To Len( aCpoNum )
		aTamSX3Cpo := TamSX3(aCpoNum[nLoop][2])
		TcSetField( self:cAliasAux, aCpoNum[nLoop][1], "N",aTamSX3Cpo[1],aTamSX3Cpo[2])
	next nLoop

	FwFreeArray(aCpoNum)
	FwFreeArray(aTamSX3Cpo)
	FwFreeArray(aMotBx)
return

//-------------------------------------------------------------------
/*/{Protheus.doc} getTaxBordereaux
	@description Verifica se o imposto foi baixado pela inclusão em borderô
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 02/06/2025
    @return aIdMovs - array contendo (ou não) os IDs da baixa por borderô
/*/
//-------------------------------------------------------------------
method getTaxBordereaux() as array class DataBlockT158
	local aIdMovs 		:= {} as array
	local cAliasTaxBord := "" as character
	local cQuery 		:= "" as character
	local nParamOrder   := 1  as numeric

	if self:oTaxBordStatement == NIL
		cQuery	:= "SELECT FK2_IDFK2 IDFK2, FK2_MOTBX MOTBX, FK2_FILORI FILORI "
		cQuery	+= " FROM " + retSqlName("FK2") + " FK2 "
		cQuery	+= " JOIN " + retSqlName("SEA") + " SEA "
		cQuery	+= " 	ON SEA.EA_FILIAL = ? "
		cQuery	+= " 	AND SEA.EA_NUMBOR = FK2.FK2_DOC "
		cQuery 	+= " 	AND SEA.EA_PREFIXO = ? "
		cQuery 	+= " 	AND SEA.EA_NUM = ? "
		cQuery 	+= " 	AND SEA.EA_PARCELA = ? "
		cQuery 	+= " 	AND SEA.EA_TIPO = ? "
		cQuery 	+= " 	AND SEA.EA_FORNECE = ? "
		cQuery 	+= " 	AND SEA.EA_LOJA = ? "
		cQuery 	+= " 	AND SEA.EA_ORIGEM IN (?) "
		cQuery 	+= " 	AND SEA.EA_CART = ? "
		cQuery 	+= " 	AND SEA.D_E_L_E_T_ = ? "
		cQuery	+= " WHERE FK2.FK2_IDDOC = ? "
		cQuery	+= " AND FK2.FK2_MOTBX IN (?) "
		cQuery	+= " AND FK2.D_E_L_E_T_ = ? "
		cQuery 	+= " AND NOT EXISTS( "
		cQuery 	+= " 	SELECT FK2EST.FK2_IDDOC FROM " + RetSqlName("FK2") + " FK2EST "
		cQuery 	+= " 		WHERE FK2EST.FK2_FILIAL = FK2.FK2_FILIAL "
		cQuery 	+= " 		AND FK2EST.FK2_IDDOC = FK2.FK2_IDDOC "
		cQuery 	+= " 		AND FK2EST.FK2_SEQ = FK2.FK2_SEQ "
		cQuery 	+= " 		AND FK2EST.FK2_TPDOC = ? "
		cQuery 	+= " 		AND FK2EST.D_E_L_E_T_ = ?) " 
		
		cQuery := changeQuery(cQuery)
        self:oTaxBordStatement := FWExecStatement():New(cQuery)
	endIf
	
	self:oTaxBordStatement:setString(nParamOrder++, (self:cAliasQry)->E2_FILIAL)
	self:oTaxBordStatement:setString(nParamOrder++, (self:cAliasQry)->E2_PREFIXO)
	self:oTaxBordStatement:setString(nParamOrder++, (self:cAliasQry)->E2_NUM)
	self:oTaxBordStatement:setString(nParamOrder++, (self:cAliasQry)->E2_PARCELA)
	self:oTaxBordStatement:setString(nParamOrder++, (self:cAliasQry)->E2_TIPO)
	self:oTaxBordStatement:setString(nParamOrder++, (self:cAliasQry)->E2_FORNECE)
	self:oTaxBordStatement:setString(nParamOrder++, (self:cAliasQry)->E2_LOJA)
	self:oTaxBordStatement:setIn(nParamOrder++, {'FINA241', 'FINA590I', 'FINA590S'})
	self:oTaxBordStatement:setString(nParamOrder++, 'P' )
	self:oTaxBordStatement:setString(nParamOrder++, ' ' )
	self:oTaxBordStatement:setString(nParamOrder++, self:cIdDoc )
	self:oTaxBordStatement:setIn(nParamOrder++, {'PCC', 'IRF', 'IMR'})
	self:oTaxBordStatement:setString(nParamOrder++, ' ' )
	self:oTaxBordStatement:setString(nParamOrder++, 'ES' )
	self:oTaxBordStatement:setString(nParamOrder++, ' ' )

	cAliasTaxBord := self:oTaxBordStatement:openAlias()

	if !empty((cAliasTaxBord)->IDFK2)
		while (cAliasTaxBord)->(!eof())
			if (cAliasTaxBord)->MOTBX $ "PCC|IRF" .or. ((cAliasTaxBord)->MOTBX == "IMR" .and. self:validateTaxBorderaux((cAliasTaxBord)->IDFK2,(cAliasTaxBord)->FILORI))
				aAdd(aIdMovs, (cAliasTaxBord)->IDFK2)
			endIf
			(cAliasTaxBord)->(dbSkip())
		endDo
	else
		aAdd(aIdMovs, self:cIdDoc)
	endIf
	
return aIdMovs

//-------------------------------------------------------------------
/*{Protheus.doc} calculateProportionalPCCOnWriteOff
    @description Busca dados das baixas quando o PCC estiver na emissao (MV_BX10925=2), 
					proporcionalizado o PCC de acordo com o valor da baixa (referencia tabela FKW).
					Para o IR na baixa considera os dados da tabela FKY.
	
	@param aT158Trb  - Array com os dados de retencao
	@param lIndividualSupp   - Informa .T. se o fornecedor do titulo é pessoa fisica
	@param dDtEmis   - Data emissao do titulo
	@param lIsento   - Informa .T. se o titulo tem isencao de IRPF 
	@param lRatIrrf  - Identifica se título possui rateio de CPF's no IRPF
	@param nSimpDed  - Valor de dedução IR SIMPLifICADO
	@param lSimpDed  - Identifica se deve ou não deduzir o IR SIMPLifICADO
    
	@type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 04/06/2025
    @return lRet - Retorna .T. se encontrou retenções
*/
//-------------------------------------------------------------------
method calculateProportionalPCCOnWriteOff(aT158Trb as array, lIndividualSupp as logical, dDataPg as date, lIsento as logical, lRatIrrf as logical, nSimpDed as numeric, lSimpDed as logical) as logical class DataBlockT158
	local aImpProp 		:= {} as array
	local aImposto 		:= {} as array
	local aIdMovs 		:= {} as array
	local cQry1			:= "" as character
	local cQry2			:= "" as character
	local cAliasPCC 	:= "" as character
	local cFator 		:= "" as character
	local cAlsFator		:= "" as character
	local cNumPro 		:= "" as character
	local cTpProc 		:= "" as character
	local cCodSus 		:= "" as character
	local cImpIR 		:= "" as character
	local cImpPis 		:= "" as character
	local cImpCof 		:= "" as character
	local cImpCSL 		:= "" as character
	local cSemImp 		:= "" as character
	local cFilFk2 		:= "" as character
	local cFilOrig 		:= "" as character
	local cIdFK7 		:= "" as character
	local cIdFK2 		:= "" as character
	local cTrib 		:= "" as character
	local cSomaImp 		:= "" as character
	local cAntNatR 		:= "" as character
	local cSoimp 		:= "" as character
	local lRet 			:= .F. as logical
	local lSusp 		:= .F. as logical
	local lCSRF 		:= .F. as logical
	local lCOSIRF 		:= .F. as logical
	local nDedDep 		:= 0 as numeric
	local nRenBrut 		:= 0 as numeric
	local nRenTrib 		:= 0 as numeric
	local nValTrib 		:= 0 as numeric
	local nVlImpNR 		:= 0 as numeric
	local nBaseNR 		:= 0 as numeric
	local nNumOfDep 	:= 0 as numeric
	local nPosicao 		:= 0 as numeric
	local nParamOrder 	:= 1  as numeric
	local nFkwImp 		:= 1  as numeric
	local nTamProc 		:= 1  as numeric
	
	Default aT158Trb  := {}
	Default lIndividualSupp   := .F.
	Default dDataPg   := CTOD("  /  /    ")
	Default lIsento   := .F.
	Default lRatIrrf  := .F.
	Default nSimpDed  := 0
	Default lSimpDed  := .F.

	nFkwImp	 := TAMSX3("FKW_TPIMP")[1]
	nTamProc := TamSx3("FKW_NUMPRO")[1]
	cImpIR	 := PadR( 'IRF', nFkwImp )
	cImpPis	 := PadR( 'PIS', nFkwImp )
	cImpCof	 := PadR( 'COF', nFkwImp )
	cImpCSL	 := PadR( 'CSL', nFkwImp )
	cSemImp	 := PadR( 'SEMIMP', nFkwImp )
	cFilOrig := (self:cAliasAux)->FILORIG
	cFilFk2  := (self:cAliasAux)->FILIAL
	cIdFK7   := (self:cAliasQry)->FK7_IDDOC
	cIdFK2   := (self:cAliasAux)->IDMOV
	aImpProp := {cImpPis,cImpCof,cImpCSL}
	aImposto := {cImpPis,cImpCof,cImpCSL,cImpIR,cSemImp}
	cSoimp 	 := "(E2_VRETPIS+E2_VRETCOF+E2_VRETCSL+E2_VRETINS+E2_VRETIRF+E2_VRETISS)"

	if self:lIRTaxAggregated
		aadd(aImpProp, cImpIR)
	endIf

	cSomaImp := "(E2_VALOR+E2_VRETPIS+E2_VRETCOF+E2_VRETCSL+E2_VRETINS"
	if !self:lIssinPayment
		cSomaImp	+="+E2_VRETISS"
	endIf
	if !self:lIRTaxInPayment
		cSomaImp	+="+E2_VRETIRF"
	endIf
	cSomaImp	+=")"
	
	if self:oFactorStatement == Nil
		cQry1 	:= " SELECT DISTINCT FKW_NATREN NATREN, "
		cQry1 	+= "	CASE WHEN E2_SALDO > 0 THEN FK2_VALOR / " + cSomaImp
		cQry1 	+= " 		WHEN ISNULL((SELECT SUM(FK2_VALOR) FROM " + RetSqlName("FK2") + " FK2 "
		cQry1 	+= " 					WHERE FK2_IDDOC = ? "
		cQry1 	+= " 					AND FK2_IDFK2 != ? "
		cQry1 	+= " 					AND NOT EXISTS(SELECT FK2EST.FK2_IDDOC FROM " + RetSqlName("FK2") + " FK2EST "
		cQry1 	+= " 									WHERE FK2EST.FK2_FILIAL = FK2.FK2_FILIAL "
		cQry1 	+= " 									AND FK2EST.FK2_IDDOC = FK2.FK2_IDDOC "
		cQry1 	+= " 									AND FK2EST.FK2_SEQ = FK2.FK2_SEQ "
		cQry1 	+= " 									AND FK2EST.FK2_TPDOC = ? "
		cQry1 	+= " 									AND FK2EST.D_E_L_E_T_ = ?) "
		cQry1 	+= " 					AND FK2.D_E_L_E_T_ = ?),0) = 0 THEN 1 "

		cQry1 	+= " 		WHEN FK2_SEQ != (SELECT MAX(A.FK2_SEQ) SEQMAX FROM " + RetSqlName("FK2") + " A "
		cQry1 	+= " 						  WHERE	A.FK2_FILIAL = FK2.FK2_FILIAL "
		cQry1 	+= " 						  AND A.FK2_RECPAG = ? "
		cQry1 	+= " 						  AND A.FK2_IDDOC = FK2.FK2_IDDOC "
		cQry1 	+= " 						  AND NOT EXISTS(SELECT FK2EST.FK2_IDDOC FROM " + RetSqlName("FK2") + " FK2EST "
		cQry1 	+= " 										 WHERE FK2EST.FK2_FILIAL = A.FK2_FILIAL "
		cQry1 	+= " 										 AND FK2EST.FK2_IDDOC = A.FK2_IDDOC "
		cQry1 	+= " 										 AND FK2EST.FK2_SEQ = A.FK2_SEQ "
		cQry1 	+= " 										 AND FK2EST.FK2_TPDOC = ? "
		cQry1 	+= " 										 AND FK2EST.D_E_L_E_T_ = ? ) "
		cQry1 	+= " 						 AND A.D_E_L_E_T_ = ? ) THEN FK2_VALOR / " + cSomaImp

		cQry1 	+= "		else (((SELECT SUM(FK2_VALOR) FROM " + RetSqlName("FK2") + " FK2 "
		cQry1 	+= " 				WHERE FK2_IDDOC = ? AND FK2_IDFK2 = ? "
		cQry1 	+= " 				AND NOT EXISTS( SELECT FK2EST.FK2_IDDOC FROM " + RetSqlName("FK2") + " FK2EST "
		cQry1 	+= " 								WHERE FK2EST.FK2_FILIAL = FK2.FK2_FILIAL"
		cQry1 	+= " 								AND FK2EST.FK2_IDDOC = FK2.FK2_IDDOC "
		cQry1 	+= " 								AND FK2EST.FK2_SEQ = FK2.FK2_SEQ "
		cQry1 	+= " 								AND FK2EST.FK2_TPDOC = ? "
		cQry1 	+= " 								AND FK2EST.D_E_L_E_T_ = ? ) "
		cQry1 	+= " 				AND FK2.D_E_L_E_T_ = ? ) + " + cSoimp + " ) / " + cSomaImp + " ) "
		cQry1 	+= " 		END FATOR "

		cQry1 	+= " FROM " + RetSqlName("FK2") + " FK2 "
		cQry1 	+= " INNER JOIN " + RetSqlName("FKW") + " FKW "
		cQry1 	+= " 	ON " + FWJoinFilial("FKW", "FK2")
		cQry1 	+= " 	AND FKW_IDDOC = FK2_IDDOC "
		cQry1 	+= " 	AND FKW_TPIMP IN ( ? ) "
		cQry1 	+= " 	AND FKW_CARTEI = ? "
		cQry1 	+= " 	AND FKW.D_E_L_E_T_ = ? "
		cQry1 	+= " INNER JOIN " + RetSqlName("FK7") + " FK7 "
		cQry1 	+= " 	ON FK7_ALIAS = ? "
		cQry1 	+= " 	AND FK7_FILTIT = ? "
		cQry1 	+= " 	AND FK7_IDDOC = FK2_IDDOC "
		cQry1 	+= " 	AND FK7.D_E_L_E_T_ = ? "
		cQry1 	+= " INNER JOIN " + RetSqlName("SE2") + " SE2 "
		cQry1 	+= " 	ON E2_FILIAL = FK7_FILTIT "
		cQry1 	+= " 	AND E2_PREFIXO = FK7_PREFIX "
		cQry1 	+= " 	AND E2_NUM = FK7_NUM "
		cQry1 	+= " 	AND E2_PARCELA = FK7_PARCEL "
		cQry1 	+= " 	AND E2_TIPO = FK7_TIPO "
		cQry1 	+= " 	AND E2_FORNECE = FK7_CLIFOR "
		cQry1 	+= " 	AND E2_LOJA = FK7_LOJA "
		cQry1 	+= " 	AND SE2.D_E_L_E_T_ = ? "
		cQry1 	+= " WHERE FK2_FILORI = ? "
		cQry1 	+= " AND FK2_IDFK2 = ? "
		cQry1 	+= " AND FK2_IDDOC = ? "
		cQry1 	+= " AND FK2.D_E_L_E_T_ = ? "

		cQry1 	:= ChangeQuery(cQry1)
        self:oFactorStatement := FwExecStatement():New(cQry1)
	endIf
	
	self:oFactorStatement:SetString(nParamOrder++, cIdFK7)
	self:oFactorStatement:SetString(nParamOrder++, cIdFK2)
	self:oFactorStatement:SetString(nParamOrder++, 'ES')
	self:oFactorStatement:SetString(nParamOrder++, ' ')
	self:oFactorStatement:SetString(nParamOrder++, ' ')
	self:oFactorStatement:SetString(nParamOrder++, 'P')
	self:oFactorStatement:SetString(nParamOrder++, 'ES')
	self:oFactorStatement:SetString(nParamOrder++, ' ')
	self:oFactorStatement:SetString(nParamOrder++, ' ')
	self:oFactorStatement:SetString(nParamOrder++, cIdFK7)
	self:oFactorStatement:SetString(nParamOrder++, cIdFK2)
	self:oFactorStatement:SetString(nParamOrder++, 'ES')
	self:oFactorStatement:SetString(nParamOrder++, ' ')
	self:oFactorStatement:SetString(nParamOrder++, ' ')
	self:oFactorStatement:SetIn(nParamOrder++, aImposto)
	self:oFactorStatement:SetString(nParamOrder++, '1')
	self:oFactorStatement:SetString(nParamOrder++, ' ')
	self:oFactorStatement:SetString(nParamOrder++, 'SE2')
	self:oFactorStatement:SetString(nParamOrder++, FWxFilial("SE2", cFilOrig))
	self:oFactorStatement:SetString(nParamOrder++, ' ')
	self:oFactorStatement:SetString(nParamOrder++, ' ')
	self:oFactorStatement:SetString(nParamOrder++, cFilOrig)
	self:oFactorStatement:SetString(nParamOrder++, cIdFK2)
	self:oFactorStatement:SetString(nParamOrder++, cIdFK7)
	self:oFactorStatement:SetString(nParamOrder++, ' ')

	cAlsFator := self:oFactorStatement:OpenAlias()

	if !empty((self:cAliasAux)->DOC) 
		aIdMovs := self:getTaxBordereaux()
	endIf

	if empty(aIdMovs)
		aAdd(aIdMovs, cIdFK2)
	endIf

	while !(cAlsFator)->(Eof())
		nParamOrder := 1
		cFator := AllTrim(STR((cAlsFator)->FATOR))
		if self:oIncomeNatureStatement == Nil 
			cQry2 := " SELECT FKW_IDDOC ID, FKW_NATREN NATREN, FKW_TPIMP TPIMP,  "
			cQry2 += " ROUND(FKW_BASETR * " + cFator + ", 2) BASETR, ROUND(FKW_VLIMP * " + cFator + ", 2) VLIMP, "
			cQry2 += " ROUND(FKW_BASENR * " + cFator + ", 2) BASENR, ROUND(FKW_VLIMPN * " + cFator + ", 2) VLIMPN, "
			cQry2 += " FKW_NUMPRO NUMPRO, FKW_TPPROC TPPROC, FKW_CODSUS CODSUS "
			cQry2 += " ,''  IDORIG,''  TABORI , ROUND(FKW_VLBRUT * " + cFator + ", 2) VLBRUT "
			cQry2 += " FROM " + RetSqlName("FKW") + " PROPFKW "
			cQry2 += " WHERE FKW_FILIAL = ? "
			cQry2 += " AND FKW_IDDOC = ? "
			cQry2 += " AND FKW_TPIMP IN ( ? ) "
			cQry2 += " AND FKW_CARTEI = ? "
			cQry2 += " AND FKW_NATREN = ? "
			cQry2 += " AND D_E_L_E_T_ = ? "
			cQry2 += "UNION ALL "		
			cQry2 += " SELECT FKY_IDFK2 ID, FKY_NATREN NATREN, FKY_TPIMP TPIMP, "
			cQry2 += " FKY_BASETR BASETR, FKY_VLIMP VLIMP, FKY_BASENR BASENR, "
			cQry2 += " FKY_VLIMPN VLIMPN, FKY_NUMPRO NUMPRO, FKY_TPPROC TPPROC, 
			cQry2 += " FKY_CODSUS CODSUS, FKY_IDORIG IDORIG, FKY_TABORI TABORI, FKY_VLBRUT VLBRUT  "
			cQry2 += " FROM " + RetSqlName("FKY")
			cQry2 += " WHERE FKY_FILIAL = ? "
			cQry2 += " AND FKY_IDDOC = ? "
			cQry2 += " AND FKY_IDFK2 IN ( ? ) "
			cQry2 += " AND FKY_TPIMP IN (?) "
			cQry2 += " AND D_E_L_E_T_ = ? "
			cQry2 += " ORDER BY ID, NATREN, TPIMP

			cQry2 := ChangeQuery(cQry2)
			self:oIncomeNatureStatement := FwExecStatement():New(cQry2)
		endIf

		self:oIncomeNatureStatement:SetString(nParamOrder++,FWxFilial("FKW", cFilOrig))
		self:oIncomeNatureStatement:SetString(nParamOrder++,cIdFK7)
		self:oIncomeNatureStatement:SetIn(nParamOrder++, aImpProp)
		self:oIncomeNatureStatement:SetString(nParamOrder++, '1')
		self:oIncomeNatureStatement:SetString(nParamOrder++,(cAlsFator)->NATREN)
		self:oIncomeNatureStatement:SetString(nParamOrder++, ' ')
		self:oIncomeNatureStatement:SetString(nParamOrder++,cFilFK2)
		self:oIncomeNatureStatement:SetString(nParamOrder++,cIdFK7)
		self:oIncomeNatureStatement:SetIn(nParamOrder++, aIdMovs )
		self:oIncomeNatureStatement:SetIn(nParamOrder++, {cImpIR,cSemImp} )
		self:oIncomeNatureStatement:SetString(nParamOrder++, ' ')

		cAliasPCC := self:oIncomeNatureStatement:OpenAlias()

		while (cAliasPCC)->( !EOF() )

			//Tratamento para Rateio de CPF's do IR sobre Aluguel
			if lRatIrrf .and. !Empty((self:cAliasAux)->CPF) .and. !self:newCpf((cAliasPCC)->IDORIG, (cAliasPCC)->TABORI)
				(cAliasPCC)->( DbSkip())
				Loop
			endIf

			if (self:lIRTaxInPayment .or. self:lIRTaxAggregated) .and. AgregTrib((cAliasPCC)->NATREN, "2", "1", {cIdFK7}, nFkwImp, nTamProc)
				lCOSIRF := .T.
			elseIf AgregTrib((cAliasPCC)->NATREN, "1", "1", {cIdFK7}, nFkwImp, nTamProc)  
				lCSRF := .T.
			endIf

			cTrib := self:getTaxCode(lCSRF, (cAliasPCC)->TPIMP, (cAliasPCC)->NATREN, lCOSIRF)
		
			if cTrib == "LOOP"
				(cAliasPCC)->(DbSkip())
				Loop
			endIf

			lRet := .T.

			if (cAliasPCC)->VLBRUT > 0
				nRenBrut := (cAliasPCC)->VLBRUT
			else
				nRenBrut := (cAliasPCC)->BASETR+(cAliasPCC)->BASENR
			endIf

			nRenTrib := (cAliasPCC)->BASETR //Base tributavel
			nValTrib := NoRound((cAliasPCC)->VLIMP,2)  //Valor Tributo

			if !Empty((cAliasPCC)->NUMPRO) //Verifica se houve retenção que deixou de ser efetuada em função de um processo adm/jud
				lSusp    := .T.
				nRenTrib := (cAliasPCC)->BASETR+(cAliasPCC)->BASENR
				nValTrib := NoRound((cAliasPCC)->VLIMP,2)+NoRound((cAliasPCC)->VLIMPN,2)
				cNumPro  := (cAliasPCC)->NUMPRO
				cTpProc  := (cAliasPCC)->TPPROC
				cCodSus  := (cAliasPCC)->CODSUS
				nVlImpNR := NoRound((cAliasPCC)->VLIMPN,2)
				nBaseNR  := (cAliasPCC)->BASENR
			endIf

			if lIndividualSupp
				if lIsento
					nBaseNR := (cAliasPCC)->BASENR
				elseIf !lSusp
					If lSimpDed
						nRenTrib -= nSimpDed
						nRenTrib += (cAliasPCC)->BASENR
					Else
						nNumOfDep  := self:getNumberOfDependents()
						nDedDep  := self:getDepDedussionValue(dDataPg, nNumOfDep)
						nRenTrib -= nDedDep
					endIf
				endIf
			endIf

			nPosicao := ASCAN(aT158Trb,{|aX| aX[1]==cTrib .And. aX[2] == (cAliasPCC)->NATREN})
			if !Empty(aT158Trb) .And. cTrib$"29|30" .And. (cAliasPCC)->NATREN == cAntNatR .And. nPosicao > 0
				aT158Trb[nPosicao][5]  += nValTrib
				aT158Trb[nPosicao][9]  += nVlImpNR
			else
				AAdd( aT158Trb,{cTrib ,;
								(cAliasPCC)->NATREN,;
								nRenBrut,;
								nRenTrib,;
								nValTrib,;
								cNumPro,;
								cTpProc,;
								cCodSus,;
								nVlImpNR,;
								nBaseNR })
			endIf
			lSusp := .F.
			cNumPro  := ""
			cTpProc  := ""
			cCodSus  := ""
			nVlImpNR := 0
			nBaseNR  := 0
			cAntNatR := (cAliasPCC)->NATREN
			(cAliasPCC)->( dbSkip() )
		endDo
	
		if Select(cAliasPCC) > 0
			(cAliasPCC)->(dbCloseArea())
		endIf

		(cAlsFator)->(DbSkip())
	endDo

	if Select(cAlsFator) > 0
		(cAlsFator)->(dbCloseArea())
	endIf

	FwFreeArray(aImpProp)
	FWFreeArray(aIdMovs)

Return lRet

//-------------------------------------------------------------------
/*{Protheus.doc} checkIncomeNatureFky
    @description Verifica se há retenção, suspenção ou isenção para o tributo com natureza(s) 
					de rendimento e com o fato gerador na baixa.

	@param aT158Trb  - Array com os dados de retencao
	@param lIndividualSupp   - Informa .T. se o fornecedor do titulo é pessoa fisica
	@param dDtEmis   - Data emissao do titulo
	@param lIsento   - Informa .T. se o titulo tem isencao de IRPF
	@param lRatIrrf  - Identifica se título possui rateio de CPF's no IRPF
	@param nSimpDed  - Valor de dedução IR SIMPLifICADO
	@param lSimpDed  - Identifica se deve ou não deduzir o IR SIMPLifICADO

    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 04/06/2025
    @return lRet - Retorna .T. se encontrou retenções
*/
//-------------------------------------------------------------------
method checkIncomeNatureFky(aT158Trb as array, lIndividualSupp as logical, dDataPg as date, lIsento as logical, lRatIrrf as logical, nSimpDed as numeric, lSimpDed as logical) as logical class DataBlockT158
	local aIdMovs  		:= {} as array
	local cTrib	   		:= "" as character
	local cNumPro  		:= "" as character
	local cTpProc  		:= "" as character
	local cCodSus  		:= "" as character
	local cAlsFky  		:= "" as character
	local cQry     		:= "" as character
	local lRet	   		:= .F. as logical
	local lSusp	   		:= .F. as logical
	local lCSRF    		:= .F. as logical
	local lCOSIRF  		:= .F. as logical
	local nDedDep  		:= 0 as numeric
	local nRenBrut 		:= 0 as numeric
	local nRenTrib 		:= 0 as numeric
	local nValTrib 		:= 0 as numeric
	local nVlImpNR 		:= 0 as numeric
	local nBaseNR  		:= 0 as numeric
	local nNumOfDep 	:= 0 as numeric
	local nPosicao 		:= 0 as numeric
	local nFkwImp  		:= 0 as numeric
	local nTamProc 		:= 0 as numeric
	local nParamOrder 	:= 1 as numeric

	Default aT158Trb  := {}
	Default lIndividualSupp   := .F.
	Default dDataPg   := CTOD("  /  /    ")
	Default lIsento   := .F.
	Default lRatIrrf  := .F.
	Default nSimpDed  := 0
	Default lSimpDed  := .F.

	nFkwImp	 := TAMSX3("FKW_TPIMP")[1]
	nTamProc := TamSx3("FKW_NUMPRO")[1]

	if !empty((self:cAliasAux)->DOC) .and. (self:cAliasAux)->MOTBX <> "CMP"
		aIdMovs := self:getTaxBordereaux()
	endIf

	if Empty(aIdMovs)
		aAdd(aIdMovs, (self:cAliasAux)->IDMOV)
	endIf

	if self:oFkyStatement == Nil
		cQry := " SELECT FKY_IDFK2, FKY_TPIMP, FKY_NATREN, FKY_BASETR, FKY_VLIMP, FKY_BASENR, "
		cQry += " FKY_VLIMPN, FKY_NUMPRO, FKY_TPPROC, FKY_CODSUS, FKY_IDORIG, FKY_TABORI, FKY_VLBRUT "
		cQry += " FROM " + RetSqlName("FKY")
		cQry += " WHERE	FKY_IDDOC = ? "
		cQry += " AND FKY_IDFK2 IN ( ? ) "
		cQry += " AND D_E_L_E_T_ = ? "
		cQry += " ORDER BY FKY_FILIAL, FKY_NATREN, FKY_TPIMP, FKY_IDFK2 "
		
		cQry 	:= ChangeQuery(cQry)
		self:oFkyStatement := FwExecStatement():New(cQry)
	endIf

	self:oFkyStatement:SetString(nParamOrder++, (self:cAliasAux)->IDDOC)
	self:oFkyStatement:SetIn(nParamOrder++, aIdMovs )
	self:oFkyStatement:SetString(nParamOrder++, " " )

	cAlsFky := self:oFkyStatement:OpenAlias()

	while (cAlsFky)->( !Eof() )

		if lRatIrrf .And. !Empty((self:cAliasAux)->CPF) .And. !self:newCpf((cAlsFky)->FKY_IDORIG, (cAlsFky)->FKY_TABORI)
			(cAlsFky)->( DbSkip())
			Loop
		endIf

		if AgregTrib((cAlsFky)->FKY_NATREN, "2", "2", aIdMovs, nFkwImp, nTamProc) 
			lCOSIRF := .T.
		elseIf AgregTrib((cAlsFky)->FKY_NATREN, "1", "2", aIdMovs, nFkwImp, nTamProc)  
			lCSRF := .T.
		endIf

		cTrib := self:getTaxCode(lCSRF, (cAlsFky)->FKY_TPIMP, (cAlsFky)->FKY_NATREN, lCOSIRF)
		
		if cTrib == "LOOP"
			(cAlsFky)->(DbSkip())
			Loop
		endIf

		lRet    := .T.

		if (cAlsFky)->FKY_VLBRUT > 0
			nRenBrut := (cAlsFky)->FKY_VLBRUT
		else
			nRenBrut := (cAlsFky)->FKY_BASETR+(cAlsFky)->FKY_BASENR
		endIf

		nRenTrib := (cAlsFky)->FKY_BASETR
		nValTrib := (cAlsFky)->FKY_VLIMP
		lSusp    := .F.
		cNumPro  := ""
		cTpProc  := ""
		cCodSus  := ""
		nVlImpNR := 0
		nBaseNR  := 0
		
		if !Empty((cAlsFky)->FKY_NUMPRO) 
			lSusp    := .T.
			nRenTrib := (cAlsFky)->FKY_BASETR+(cAlsFky)->FKY_BASENR
			nValTrib := (cAlsFky)->FKY_VLIMP+(cAlsFky)->FKY_VLIMPN
			cNumPro  := (cAlsFky)->FKY_NUMPRO
			cTpProc  := (cAlsFky)->FKY_TPPROC
			cCodSus  := (cAlsFky)->FKY_CODSUS
			nVlImpNR := (cAlsFky)->FKY_VLIMPN
			nBaseNR  := (cAlsFky)->FKY_BASENR
		endIf

		if lIndividualSupp
			if lIsento
				nBaseNR := (cAlsFky)->FKY_BASENR
			elseIf !lSusp
				if lSimpDed
					nRenTrib -= nSimpDed
					nRenTrib += (cAlsFky)->FKY_BASENR 
				else
					nNumOfDep  := self:getNumberOfDependents()
					nDedDep  := self:getDepDedussionValue(dDataPg, nNumOfDep)
					nRenTrib -= nDedDep 
				endIf
			endIf
		endIf

		if nRenBrut > 0
			nPosicao := ASCAN(aT158Trb,{|aX| aX[1]==cTrib .And. aX[2] == (cAlsFky)->FKY_NATREN})
			if !Empty(aT158Trb) .And. cTrib$"29|30" .And. nPosicao > 0 .And. (cAlsFky)->FKY_NATREN == aT158Trb[nPosicao][2]
				aT158Trb[nPosicao][5]  += nValTrib
				aT158Trb[nPosicao][9]  += nVlImpNR
			else
				AAdd( aT158Trb,{cTrib ,;
								(cAlsFky)->FKY_NATREN,;
								nRenBrut,;
								nRenTrib,;
								nValTrib,;
								cNumPro,;
								cTpProc,;
								cCodSus,;
								nVlImpNR,;
								nBaseNR })
			endIf
		endIf
		(cAlsFky)->( DbSkip() )
	endDo


	if Select(cAlsFky) > 0
		(cAlsFky)->(dbCloseArea() )
	endIf

	FWFreeArray(aIdMovs)

Return lRet

//-------------------------------------------------------------------
/*{Protheus.doc} getTafTaxCode
    @description Função que retorna codigo do tributo (TAF) diferente para associação
	@param cNatRen , Character, Código da natureza de rentenção	
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 04/06/2025
    @return cTrib - Character, codigo do tributo no LayOut TAF
*/
//-------------------------------------------------------------------
method getTafTaxCode(cNatRen as character) as character class DataBlockT158
	local cRet as character

	cRet := "29"

	if (self:cAliasQry)->E2_CODRET  == '8863' .And. cNatRen $ '17025'
		cRet := "30"
	endIf

Return cRet

//-------------------------------------------------------------------
/*{Protheus.doc} newCpf
    @description Verifica se a retenção do IR é de um CPF diferente do já tratado
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 04/06/2025
    @return lRet - retorna se o CPF é de outro participante
*/
//-------------------------------------------------------------------
method newCpf(cIdOrig as character, cTabOri as character) as logical class DataBlockT158
	local lRet 		as logical
	local cCpf		as character

	Default cIdOrig	 := ""
	Default cTabOri	 := ""
	
	lRet	:= .F.

	if cTabOri == "FK4"
		cCpf	:= AllTrim(GetAdvFVal("FK4", "FK4_CGC", xFilial("FK4") + cIdOrig, 1))
	endIf

	if cTabOri == "FK3"
		cCpf	:= AllTrim(GetAdvFVal("FK3", "FK3_CGC", xFilial("FK3") + cIdOrig, 1))
	endIf

	lRet	:= ( !Empty(AllTrim(cCpf)) .And. !Empty(AllTrim((self:cAliasAux)->CPF)) .And. cCpf == AllTrim((self:cAliasAux)->CPF) )

Return lRet

//-------------------------------------------------------------------
/*{Protheus.doc} validateIncomeNature
    @description Quando o rendimento não possui os tributos do bloco 40 (IR e PCC), verifica se pode ser gerado para o pagamento (T158AA).
	
	@param cNatRen, Char, Natureza de Rendimento
    
	@type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 04/06/2025
    @return lRet, Logical, Verdadeiro se o rendimento pode ser enviado
*/
//-------------------------------------------------------------------
method validateIncomeNature(cNatRen as character) as logical class DataBlockT158
	local lRet := .F.

	Default cNatRen := ""

	if (Substr(cNatRen,1,2) == "20" .And. self:lIRTaxInPayment) .or. !Substr(cNatRen,1,2) == "20"
		lRet := .T.
	endIf

Return lRet

//-------------------------------------------------------------------
/*{Protheus.doc} getNumberOfDependents
    @description Retorna quantidade de dependentes

    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 04/06/2025
    @return nNumOfDep - Character, codigo do tributo no LayOut TAF
*/
//-------------------------------------------------------------------
method getNumberOfDependents() as numeric class DataBlockT158
	local nNumOfDep := 0 as numeric
	local lFKJNDep  := FKJ->(FieldPos("FKJ_NUMDEP")) > 0

	nNumOfDep  := (self:cAliasQry)->A2_NUMDEP
	if lFKJNDep .And. self:lCpfFkj
		nNumOfDep := (self:cAliasQry)->FKJ_NUMDEP
		if (self:cAliasQry)->FKJ_NUMDEP == 0 .And. (self:cAliasQry)->A2_NUMDEP > 0 .And. (self:cAliasQry)->FKJ_PERCEN == 100
			nNumOfDep  := (self:cAliasQry)->A2_NUMDEP
		endIf
	endIf

Return nNumOfDep

//-------------------------------------------------------------------
/*{Protheus.doc} getDepDedussionValue
    @description Função para retornar o valor da deducao da base do IRPF pelo numero total de dependentes
	
	@param dData  , Date, Data do fato gerador do IRPF
	@param nNumOfDep, Numeric, Quantidade de depenentes do fornecedor (A2_NUMDEP)
    
	@type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 04/06/2025
    @return nVrRet, Numeric, valor da deducao de dependentes da base do IRPF 
*/
//-------------------------------------------------------------------
method getDepDedussionValue(dData as date, nNumOfDep as numeric) as numeric class DataBlockT158
	local nVrRet as numeric
	local nDepValue as numeric 
	local cMes	 as character
	local cAno	 as character

	Default dData 	:= CTOD("  /  /    ")
	Default nNumOfDep := 0
	
	if !Empty(dData)
		cMes := STRZERO(MONTH(dData),2)
		cAno := STRZERO(YEAR(dData),4)
	endIf

	nDepValue := F992RetVal(cMes, cAno) //Retorna valor de deducao por depende (via tabela FKI ou MV_TMSVDEP)
	nVrRet := 0

	if nDepValue > 0 .And. self:isFirstDeduction(dData)
		nVrRet := nDepValue * nNumOfDep
	endIf

Return nVrRet

//-------------------------------------------------------------------
/*{Protheus.doc} isFirstDeduction
    @description Verifica se a Dedução do fornecedor é a primeira do período
	@param dGenerationDate  , Date, Data do fato gerador do IRPF
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 04/06/2025
    @return lRet - retorna .T. se o CPF é de outro participante
*/
//-------------------------------------------------------------------
method isFirstDeduction(dGenerationDate as date) as logical class DataBlockT158
	local cQuery		:= "" as character	
	local cAlsDed		:= "" as character
	local cSupplier		:= "" as character
	local cUnit			:= "" as character
	local lRet			:= .F. as logical
	local nParamOrder	:= 1 as numeric

	Default dGenerationDate	:= CTOD("  /  /  ")
	
	cSupplier	:= (self:cAliasQry)->E2_FORNECE
	cUnit	:= (self:cAliasQry)->E2_LOJA

	if !Empty(cSupplier+cUnit) .And. !Empty(dGenerationDate)
		if self:oFirstDedStatement == Nil
            cQuery  := " SELECT E2_NUM NUM "
            cQuery  += " FROM " + RetSqlName("SE2") + " SE2 "
            cQuery  += " INNER JOIN " + retSqlName("SA2") + " SA2 "
            cQuery  += " 	ON " + FWJoinFilial("SA2", "SE2")
            cQuery  += "    AND E2_FORNECE = A2_COD "
            cQuery  += "    AND E2_LOJA = A2_LOJA "
            cQuery  += "    AND ( ( ( A2_CALCIRF = ? AND E2_IRRF > ? ) OR ( A2_CALCIRF = ? AND E2_BAIXA < ?) ) "
            cQuery  += "        AND E2_EMISSAO < ? "
            cQuery  += "        AND SUBSTRING(E2_EMISSAO,1,6) = ? ) "
            cQuery  += "    AND SA2.D_E_L_E_T_ = ? "
            cQuery  += " INNER JOIN " + retSqlName("SED") + " SED "
            cQuery  += " 	ON " + FWJoinFilial("SED", "SE2")
            cQuery  += "    AND ED_CODIGO = E2_NATUREZ "
            cQuery  += "    AND ED_CALCIRF = ? "
            cQuery  += "    AND ED_PERCIRF > ? "
            cQuery  += "    AND SED.D_E_L_E_T_ = ? "
            cQuery  += " WHERE E2_FILIAL = ? "
            cQuery  += " AND E2_FORNECE = ? "
            cQuery  += " AND E2_LOJA = ? "
            cQuery  += " AND SE2.D_E_L_E_T_ = ? "

            cQuery  += " UNION"

            cQuery  += " SELECT E2_NUM NUM "
            cQuery  += " FROM " + RetSqlName("SE2") + " SE2 "
            cQuery  += " INNER JOIN " + retSqlName("SA2") + " SA2 "
            cQuery  += " 	ON " + FWJoinFilial("SA2", "SE2")
            cQuery  += "    AND E2_FORNECE = A2_COD "
            cQuery  += "    AND E2_LOJA = A2_LOJA "
            cQuery  += "    AND ( ( ( A2_CALCIRF = ? AND E2_IRRF > ? ) OR ( A2_CALCIRF = ? AND E2_BAIXA < ?) ) "
            cQuery  += "        AND SUBSTRING(E2_EMISSAO,1,6) = ? ) "
            cQuery  += "    AND SA2.D_E_L_E_T_ = ? "
            cQuery  += " INNER JOIN " + retSqlName("FK7") + " FK7 "
            cQuery  += "   ON FK7.FK7_ALIAS = ? "
            cQuery  += "    AND FK7.FK7_FILTIT = SE2.E2_FILIAL "
            cQuery  += "    AND FK7.FK7_PREFIX = SE2.E2_PREFIXO "
            cQuery  += "    AND FK7.FK7_NUM = SE2.E2_NUM "
            cQuery  += "    AND FK7.FK7_PARCEL = SE2.E2_PARCELA "
            cQuery  += "    AND FK7.FK7_TIPO = SE2.E2_TIPO "
            cQuery  += "    AND FK7.FK7_CLIFOR = SE2.E2_FORNECE "
            cQuery  += "    AND FK7.FK7_LOJA = SE2.E2_LOJA "
            cQuery  += "    AND FK7.D_E_L_E_T_ = ? "
            cQuery  += " RIGHT JOIN " + retSqlName("FKF") + " FKF "
            cQuery  += " 	ON " + FWJoinFilial("FKF", "FK7")
            cQuery  += "    AND FKF_IDDOC = FK7_IDDOC "
            cQuery  += "    AND FKF_REINF = ? "
            cQuery  += "    AND FKF.D_E_L_E_T_ = ? "
            cQuery  += " INNER JOIN " + retSqlName("SED") + " SED "
            cQuery  += " 	ON " + FWJoinFilial("SED", "SE2")
            cQuery  += "    AND ED_CODIGO = E2_NATUREZ "
            cQuery  += "    AND ED_CALCIRF = ? "
            cQuery  += "    AND ED_PERCIRF > ? "
            cQuery  += "    AND SED.D_E_L_E_T_ = ? "
            cQuery  += " WHERE E2_FILIAL = ? "
            cQuery  += " AND E2_FORNECE = ? "
            cQuery  += " AND E2_LOJA = ? "
            cQuery  += " AND SE2.D_E_L_E_T_ = ? "

            self:oFirstDedStatement	:= FwExecStatement():New(cQuery)
        endIf
		
        self:oFirstDedStatement:setString( nParamOrder++, '1')
        self:oFirstDedStatement:setNumeric( nParamOrder++, 0)
        self:oFirstDedStatement:setString( nParamOrder++, '2')
        self:oFirstDedStatement:setDate( nParamOrder++, dGenerationDate)
        self:oFirstDedStatement:setDate( nParamOrder++, dGenerationDate)
        self:oFirstDedStatement:setString( nParamOrder++, subStr(Dtos(dGenerationDate), 1, 6))
        self:oFirstDedStatement:setString( nParamOrder++, ' ')
        self:oFirstDedStatement:setString( nParamOrder++, 'S')
        self:oFirstDedStatement:setNumeric( nParamOrder++, 0)
        self:oFirstDedStatement:setString( nParamOrder++, ' ')
        self:oFirstDedStatement:setString( nParamOrder++, xFilial("SE2"))
        self:oFirstDedStatement:setString( nParamOrder++, cSupplier)
        self:oFirstDedStatement:setString( nParamOrder++, cUnit )
        self:oFirstDedStatement:setString( nParamOrder++, ' ')
        self:oFirstDedStatement:setString( nParamOrder++, '1')
        self:oFirstDedStatement:setNumeric( nParamOrder++, 0)
        self:oFirstDedStatement:setString( nParamOrder++, '2')
        self:oFirstDedStatement:setDate( nParamOrder++, dGenerationDate)
        self:oFirstDedStatement:setString( nParamOrder++, subStr(Dtos(dGenerationDate), 1, 6))
        self:oFirstDedStatement:setString( nParamOrder++, ' ')
        self:oFirstDedStatement:setString( nParamOrder++, 'SE2')
        self:oFirstDedStatement:setString( nParamOrder++, ' ')
        self:oFirstDedStatement:setString( nParamOrder++, '1')
        self:oFirstDedStatement:setString( nParamOrder++, ' ')
        self:oFirstDedStatement:setString( nParamOrder++, 'S')
        self:oFirstDedStatement:setNumeric( nParamOrder++, 0)
        self:oFirstDedStatement:setString( nParamOrder++, ' ')
        self:oFirstDedStatement:setString( nParamOrder++, xFilial("SE2"))
        self:oFirstDedStatement:setString( nParamOrder++, cSupplier)
        self:oFirstDedStatement:setString( nParamOrder++, cUnit )
        self:oFirstDedStatement:setString( nParamOrder++, ' ')
			
		cAlsDed := self:oFirstDedStatement:OpenAlias()
		
		if Empty((cAlsDed)->NUM)
			lRet	:= .T.
		endIf
		(cAlsDed)->(DbCloseArea())
	endIf

Return lRet

//-------------------------------------------------------------------
/*{Protheus.doc} validateTaxReliefs
    @description Verifica se há dedução ou isenção para o tributo IR pessoa fisica:
					- No "complemento de título x imposto" (tabela FKG), para dedução e isenção;
					- No legado para as deduções INSS e dependentes;
	
	@param aDedDetail - Array que armazenara as deduções
		[1] Tipo da dedução
		[2] Valor da dedução de base
		[3] Valor da dedução de base suspensa
		[4] Nr de inscrição do plano de previdencia
		[5]	Array contendo os dependentes da dedução	
	@param aExemptionDetail - Informa .T. se o fornecedor do titulo é pessoa fisica
	@param lIsento - Informa .T. se o titulo tem isencao de IRPF
	@param dData   - Data do fato gerador do IR
	@param lSusp  - Suspensão de IRRF
	@param nSimpDed  - Valor de dedução IRPF Simplificado
	@param lSimpDed  - Indica se houve calculo de dedução IRPF Simplificado

    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 04/06/2025
    @return Nil
*/
//-------------------------------------------------------------------
method validateTaxReliefs(aDedDetail as array, aExemptionDetail as array, lIsento as logical, dGenerationDate as date, lSusp as logical, nSimpDed as numeric, lSimpDed as logical) class DataBlockT158
	local aDepPen 			:= {} as array
	local aArea 			:= {} as array
	local aAreaFKG			:= {} as array
	local cTpAtrb  			:= "" as character
	local cDedussion 		:= "" as character
	local cInsPre 			:= "" as character
	local cIsen 			:= "" as character
	local cIncomeDescr 		:= "" as character
	local cSupplier 			:= "" as character
	local cUnit 			:= "" as character
	local cTemInPre 		:= "" as character
	local cIdDoc  			:= "" as character
	local nBaseDedVal 		:= 0 as numeric
	local nBaseDedSus 		:= 0 as numeric
	local nExemptionVal 	:= 0 as numeric
	local nAlimonyDed 		:= 0 as numeric
	local nAlimonySus 		:= 0 as numeric
	local nInssVal 			:= 0 as numeric
	local nNumOfDep 		:= 0 as numeric
	local nVrIrf 			:= 0 as numeric
	local lDedPen 			:= .F. as logical
	local lIRPF 			:= .F. as logical
	local lDedIns 			:= .F. as logical

	Default aDedDetail 		 := {}
	Default aExemptionDetail := {}
	Default lIsento 		 := .F.
	Default dGenerationDate  := CTOD("  /  /    ")
	Default nVrIrf  		 := 0
	Default lSusp   		 := .F.
	Default nSimpDed		 := 0
	Default lSimpDed		 := .F.

	cIdDoc 	:= self:cIdDoc
	nInssVal := (self:cAliasQry)->E2_INSS
	nNumOfDep := self:getNumberOfDependents()
	cSupplier := (self:cAliasQry)->E2_FORNECE
	cUnit   := (self:cAliasQry)->E2_LOJA
	lIRPF 	:= ((self:cAliasQry)->A2_TIPO == "F" .OR. ((self:cAliasQry)->A2_TIPO == "J" .AND. (self:cAliasQry)->A2_IRPROG == "1")) 
	nVrIrf	:= (self:cAliasAux)->VALIRF
	lDedIns := SuperGetMv("MV_INSIRF",.F.,"2") == "1"

	lDicSimpl := (AliasInDic("DKE") .And. DKE->(FieldPos("DKE_IRSIMP")) > 0) .And. FK4->(FieldPos("FK4_DEDIRS")) > 0

	aArea    := getArea()
    aAreaFKG := FKG->(getArea())

	DbSelectArea("FKG")
	FKG->(DBSetOrder(2)) //FKG_FILIAL+FKG_IDDOC+FKG_TPIMP
	if FKG->( MsSeek( xFilial("FKG") + cIdDoc ) )
		while FKG->( !Eof() ) .And. Alltrim( FKG->( FKG_FILIAL + FKG_IDDOC ) ) == Alltrim( xFilial("FKG") + cIdDoc )

			cTpAtrb := AllTrim( FKG->FKG_TPATRB )

			if cTpAtrb $ (PRIVATE_PENSION + FAPI + FUNPRESP)
				cDedussion 		:= self:jDeductionType[cTpAtrb]
				cInsPre 	:= FKG->FKG_INSPRE

				if empty(cInsPre)
                    cTemInPre := "2"
                else
				    cTemInPre := "1"
                endIf

				if lSusp
					nBaseDedSus := FKG->FKG_VALOR
				else
					nBaseDedVal:= FKG->FKG_VALOR
				endIf
				AAdd( aDedDetail, { cDedussion, nBaseDedVal, nBaseDedSus, cInsPre, {}, cTemInPre } )
			elseIf cTpAtrb $ ALIMONY
				if lSusp
					nAlimonySus += FKG->FKG_VALOR 
				else
					nAlimonyDed += FKG->FKG_VALOR	
				endIf
				lDedPen := .T.				
			elseIf cTpAtrb $ (OTHERS + TAX_EXEMPT_AGE_65_PLUS + TRAVEL_ALLOWANCE + CONTRACT_TERMINATION_COMPENSATION + CASH_BONUS + PAYMENT_TO_MICROENTERPRISE_PARTNER + RETIREMENT_DUE_TO_SERIOUS_ILLNESS + ;
                                    PENSION_SUPPLEMENT_CONTRIBUTIONS + EXPENSE_ALLOWANCE + LATE_PAYMENT_INTEREST + PENSION_WITHDRAWAL_SERIOUS_ILLNESS + OTHERS_TECHINICAL_NOTE)
				nExemptionVal	:= FKG->FKG_VALOR					
				cIsen := self:jExemptionsType[cTpAtrb]
				
				if cTpAtrb == OTHERS_TECHINICAL_NOTE
					cIncomeDescr	:= FKG->FKG_DESCR
				endIf
				
				if nExemptionVal > 0
					AAdd( aExemptionDetail, { cIsen, nExemptionVal, cIncomeDescr } )
					lIsento     := .T.
				endIf

			endIf

			cDedussion		:= ""
			nBaseDedVal		:= 0
			nBaseDedSus		:= 0
			cInsPre			:= ""
			cIsen			:= ""
			nExemptionVal	:= 0
			cIncomeDescr	:= ""

			FKG->( DBSkip() )
		endDo
	endIf

	if lDedPen
		cDedussion := self:jDeductionType[ALIMONY]
		aDepPen := self:loadDependentsOnAlimony("1", lSusp)
		AAdd( aDedDetail, { cDedussion, nAlimonyDed, nAlimonySus, "", aClone(aDepPen), "" } )
		FWFreeArray(aDepPen)
		aDepPen	:= {}
	endIf

	if nVrIrf > 0 .or. lSusp
		if lDicSimpl .And. lIRPF
			nSimpDed:= self:loadIRSimplified(Firstday(dGenerationDate), Lastday(dGenerationDate))
			lSimpDed := nSimpDed > 0
			if lSimpDed 
				if self:isFirstDeduction( dGenerationDate)
					cDedussion := "8"
					AAdd( aDedDetail, { cDedussion, nSimpDed, 0, "", {}, "" } )
				else
					nSimpDed := 0
				endIf
			endIf
		endIf
		if !lSimpDed
			if nInssVal > 0 .and. lDedIns
				cDedussion := "1"
				if lSusp
					nBaseDedSus := nInssVal
				else
					nBaseDedVal := nInssVal
				endIf
				AAdd( aDedDetail, { cDedussion, nBaseDedVal, nBaseDedSus, "", {}, "" } )
			endIf
	
			if nNumOfDep > 0
				nDepValue := self:getDepDedussionValue(dGenerationDate, nNumOfDep)
				if nDepValue > 0
					cDedussion := "7"
					if lSusp
						nBaseDedSus := nDepValue
					else
						nBaseDedVal := nDepValue
					endIf
					aDepPen := self:loadDependentsOnAlimony("2", lSusp)
					AAdd( aDedDetail, { cDedussion, nBaseDedVal, nBaseDedSus, "", aDepPen, "" } )
				endIf
			endIf
		endIf
	endIf

	aDepPen := {}

	restArea(aAreaFKG)
    restArea(aArea)

Return

//-------------------------------------------------------------------
/*{Protheus.doc} loadIRSimplified
    @description Função que retorna valor de dedução do IR Simplificado, caso ocorra.
	
	@param dInitDate , Date, Data inicial de processamento
	@param dFinalDate , Date, Data final de processamento

    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 04/06/2025
    @return nSimpDed - Numeric, com o valor de dedução, caso seja 0, a ultima retenção o calculo foi realizado via tabela. (FK4_DEDIRS)
*/
//-------------------------------------------------------------------
method loadIRSimplified(dInitDate as date, dFinalDate as date) as numeric class DataBlockT158
	local aArea     	:= {} as array
	local aAreaFKW		:= {} as array
	local cQry			:= "" as character
	local cTaxType		:= "" as character
	local lValidCPF		:= .T. as logical
	local nSimpDed		:= 0 as numeric
	local nTamTPIMP		:= 0 as numeric
	local nParamOrder 	:= 1  as numeric
	
	Default dInitDate := DDataBase
	Default dFinalDate := DDataBase

	nTamTPIMP	:= TamSX3("FKW_TPIMP")[1]
	cTaxType	:= "IRF"+Space(nTamTPIMP-3)
	aArea		:= GetArea()
	aAreaFKW	:= FKW->(GetArea())

	FKW->(DbSetOrder(3)) //FKW_FILIAL+FKW_IDDOC+FKW_TPIMP+FKW_CGC
	if FKW->(MsSeek(xFilial("FKW")+self:cIdDoc+cTaxType))
		if !Empty(FKW->FKW_CGC)
			lValidCPF := FKW->(MsSeek(xFilial("FKW")+self:cIdDoc+cTaxType+self:cSupplierID))
		endIf
		if !self:lIRTaxInPayment
			lValidCPF := FKW->FKW_VLIMP > 0
		endIf
		if lValidCPF
			if self:oIRSimpStatement == NIL 
				cQry := "SELECT FK4_DEDIRS "
				cQry += " FROM " + RetSqlName("FK4") + " FK4"
				cQry += " WHERE FK4.FK4_CGC = ? "
				cQry += " AND FK4.FK4_IMPOS = ? "
				cQry += " AND FK4.FK4_DATA BETWEEN ? AND ? "
				cQry += " AND FK4.FK4_CODRET = ? "
				cQry += " AND FK4.FK4_RECPAG = ? "
				cQry += " AND FK4.FK4_STATUS = ? "
				cQry += " AND FK4.D_E_L_E_T_ = ? "
				cQry += " AND EXISTS ("
				cQry += " 	SELECT FK3_IDRET"
				cQry += " 	FROM " + RetSqlName("FK3") + " FK3 "
				cQry += " 	WHERE FK3.FK3_FILIAL = FK4.FK4_FILIAL "
				cQry += " 	AND FK3.FK3_IDORIG = FK4.FK4_IDORIG "
				cQry += " 	AND FK3.FK3_IDRET = FK4.FK4_IDFK4 "
				cQry += " 	AND FK3.D_E_L_E_T_ = ? ) "
				cQry += " ORDER BY R_E_C_N_O_ DESC "

				cQry	:= ChangeQuery(cQry)				
				self:oIRSimpStatement	:= FWExecStatement():New(cQry)
			endIf

			self:oIRSimpStatement:SetString(nParamOrder++, self:cSupplierID)
			self:oIRSimpStatement:SetString(nParamOrder++, 'IRF')
			self:oIRSimpStatement:SetString(nParamOrder++, Dtos(dInitDate))
			self:oIRSimpStatement:SetString(nParamOrder++, Dtos(dFinalDate))
			self:oIRSimpStatement:SetString(nParamOrder++, (self:cAliasQry)->E2_CODRET)
			self:oIRSimpStatement:SetString(nParamOrder++, 'P')
			self:oIRSimpStatement:SetString(nParamOrder++, '1')
			self:oIRSimpStatement:SetString(nParamOrder++, ' ')
			self:oIRSimpStatement:SetString(nParamOrder++, ' ')

			nSimpDed := self:oIRSimpStatement:execScalar("FK4_DEDIRS")
		endIf
	endIf
	RestArea(aAreaFKW)
	RestArea(aArea)
Return nSimpDed

//-------------------------------------------------------------------
/*{Protheus.doc} checkAdvPayIncomeNature
    @description Verifica se há retenção, suspencao ou isenção para o tributo com natureza(s) 
					de rendimento no título de adiantamento a pagar (tipo PA)

	@param aT158Trb  - Array com os dados de retencao
	@param lIndividualSupp   - Informa .T. se o fornecedor do titulo é pessoa fisica
	@param dDataPg   - Data do pagamento do titulo
	@param lIsento   - Informa .T. se o titulo tem isencao de IRPF
	@param nSimpDed   - Valor de dedução do IRPF Simplificado
	@param lSimpDed   - Identifica se houve calculo de IRPF Simplificado

    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 04/06/2025
    @return
*/
//-------------------------------------------------------------------
method checkAdvPayIncomeNature(aT158Trb as array, lIndividualSupp as logical, dDataPg as date, lIsento as logical, nSimpDed as numeric, lSimpDed as logical) as logical class DataBlockT158
	local cTrib    	:= "" as character
	local cNumPro  	:= "" as character
	local cTpProc  	:= "" as character
	local cCodSus  	:= "" as character
	local cAntNatR 	:= "" as character
	local lRet	   	:= .F. as logical
	local lSusp    	:= .F. as logical
	local lCSRF    	:= .F. as logical
	local lCOSIRF  	:= .F. as logical
	local nDedDep  	:= 0 as numeric
	local nRenBrut 	:= 0 as numeric
	local nRenTrib 	:= 0 as numeric
	local nValTrib 	:= 0 as numeric
	local nNumOfDep := 0 as numeric
	local nVlImpNR 	:= 0 as numeric
	local nBaseNR  	:= 0 as numeric
	local nPosicao 	:= 0 as numeric
	local nFkwImp  	:= 0 as numeric
	local nTamProc 	:= 0 as numeric

	Default aT158Trb  		:= {}
	Default lIndividualSupp := .F.
	Default dDataPg   		:= CTOD("  /  /    ")
	Default lIsento   		:= .F.
	Default nSimpDed  		:= 0
	Default lSimpDed  		:= .F.

	nFkwImp	 := TAMSX3("FKW_TPIMP")[1]
	nTamProc := TamSx3("FKW_NUMPRO")[1]

	DbSelectArea("FKW")
	FKW->(DBSetOrder(2)) //FKW_FILIAL, FKW_IDDOC, FKW_CARTEI, FKW_NATREN, FKW_TPIMP
	FKW->(DbGotop())	
	FKW->(MsSeek( xFilial("FKW") + self:cIdDoc + "1" ))

	while FKW->( !Eof() ) .and. FKW->FKW_IDDOC == self:cIdDoc .and. FKW->FKW_CARTEI == "1"

		if AgregTrib(FKW->FKW_NATREN, "2", "1", {self:cIdDoc}, nFkwImp, nTamProc)   
			lCOSIRF := .T.
		elseIf AgregTrib(FKW->FKW_NATREN, "1", "1", {self:cIdDoc}, nFkwImp, nTamProc)   
			lCSRF := .T.
		endIf	

		cTrib := self:getTaxCode(lCSRF, FKW->FKW_TPIMP, FKW->FKW_NATREN, lCOSIRF)
		
		if cTrib == "LOOP"
			FKW->(DbSkip())
			Loop
		endIf

		lRet := .T.

		if FKW->FKW_VLBRUT > 0
			nRenBrut := FKW->FKW_VLBRUT
		else
			nRenBrut := FKW->FKW_BASETR+FKW->FKW_BASENR
		endIf

		nRenTrib := FKW->FKW_BASETR
		nValTrib := FKW->FKW_VLIMP

		if !Empty(FKW->FKW_NUMPRO)
			lSusp    := .T.
			nRenTrib := FKW->FKW_BASETR+FKW->FKW_BASENR
			nValTrib := FKW->FKW_VLIMP+FKW->FKW_VLIMPN
			cNumPro  := FKW->FKW_NUMPRO
			cTpProc  := FKW->FKW_TPPROC
			cCodSus  := FKW->FKW_CODSUS
			nVlImpNR := FKW->FKW_VLIMPN
			nBaseNR  := FKW->FKW_BASENR
		endIf

		if lIndividualSupp
			if lIsento
				nBaseNR := FKW->FKW_BASENR
			elseIf !lSusp

				if lSimpDed
					nRenTrib -= nSimpDed
				else
					nNumOfDep  := self:getNumberOfDependents()
					nDedDep  := self:getDepDedussionValue(dDataPg, nNumOfDep)
					nRenTrib -= nDedDep 
				endIf
			endIf
		endIf

		if nRenBrut > 0
			nPosicao := ASCAN(aT158Trb,{|aX| aX[1]==cTrib .And. aX[2] == FKW->FKW_NATREN})

			if !Empty(aT158Trb) .And. cTrib$"29|30" .And. FKW->FKW_NATREN == cAntNatR .And. nPosicao > 0
				aT158Trb[nPosicao][5]  += nValTrib
				aT158Trb[nPosicao][9]  += nVlImpNR
			else
				AAdd( aT158Trb,{cTrib ,;
								FKW->FKW_NATREN,;
								nRenBrut,;
								nRenTrib,;
								nValTrib,;
								cNumPro,;
								cTpProc,;
								cCodSus,;
								nVlImpNR,;
								nBaseNR })
			endIf
			cAntNatR := FKW->FKW_NATREN
		endIf
		FKW->( DbSkip() )
	endDo

Return lRet

//-------------------------------------------------------------------
/*{Protheus.doc} getTaxCode
    @description Retorna o código do imposto utilizado pelo TAF.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 04/06/2025
    @return
*/
//-------------------------------------------------------------------
method getTaxCode(lCSRF as logical, cTaxType as character, cNatren as character, lCOSIRF as logical) as character class DataBlockT158
	local cTaxCode := "" as character
	local cImpIR   := "" as character
	local cImpPis  := "" as character
	local cImpCof  := "" as character
	local cImpCSL  := "" as character
	local cSemImp  := "" as character
	local nFkwImp  := 0 as numeric
	local nTamProc := 0 as numeric

	default lCSRF 			:= .F.
	default cTaxType 		:= ""
	default cNatren 		:= ""
	default lCOSIRF 		:= .F.

	nFkwImp	 := TAMSX3("FKW_TPIMP")[1]
	nTamProc := TamSx3("FKW_NUMPRO")[1]
	cImpIR	 := PadR( 'IRF', nFkwImp )
	cImpPis	 := PadR( 'PIS', nFkwImp )
	cImpCof	 := PadR( 'COF', nFkwImp )
	cImpCSL	 := PadR( 'CSL', nFkwImp )
	cSemImp	 := PadR( 'SEMIMP', nFkwImp )

	if lCSRF .And. cTaxType <> cImpIR .And. cTaxType <> cSemImp 
		cTaxCode := self:getTafTaxCode(cNatren)
	elseIf lCOSIRF .And. cTaxType <> cSemImp 
		cTaxCode := "30"
	elseIf cTaxType == cImpIR 
		cTaxCode := "28"
	elseIf cTaxType == cImpPis 
		cTaxCode := "10"
	elseIf cTaxType == cImpCof 
		cTaxCode := "11"
	elseIf cTaxType == cImpCSL 
		cTaxCode := "18"
	elseIf cTaxType == cSemImp .And. self:validateIncomeNature(cNatren)
		cTaxCode := "SEMIMP"
	else
		cTaxCode := "LOOP"
	endIf
return cTaxCode

//-------------------------------------------------------------------
/*{Protheus.doc} loadTaxReliefs
    @description Carrega os jsons com os códigos das ações dos tipos de deduções e isenções do REINF 
                    utilizando as chaves de deduções e isenções do Protheus
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 04/06/2025
    @return
*/
//-------------------------------------------------------------------
method loadTaxReliefs() class DataBlockT158
    
	self:jDeductionType[PRIVATE_PENSION] := '2'
    self:jDeductionType[FAPI] := "3"
    self:jDeductionType[FUNPRESP] := "4"
    self:jDeductionType[ALIMONY] := "5"
    self:jDeductionType[DEPENDENTS] := "7"

    self:jExemptionsType[OTHERS] := "99"
    self:jExemptionsType[TAX_EXEMPT_AGE_65_PLUS] := "1"
    self:jExemptionsType[TRAVEL_ALLOWANCE] := "2"
    self:jExemptionsType[CONTRACT_TERMINATION_COMPENSATION] := "3"
    self:jExemptionsType[CASH_BONUS] := "4"
    self:jExemptionsType[PAYMENT_TO_MICROENTERPRISE_PARTNER] := "5"
    self:jExemptionsType[RETIREMENT_DUE_TO_SERIOUS_ILLNESS] := "6"
    self:jExemptionsType[PENSION_SUPPLEMENT_CONTRIBUTIONS] := "7"
    self:jExemptionsType[EXPENSE_ALLOWANCE] := "8"
    self:jExemptionsType[LATE_PAYMENT_INTEREST] := "10"
    self:jExemptionsType[PENSION_WITHDRAWAL_SERIOUS_ILLNESS] := "11"
    self:jExemptionsType[OTHERS_TECHINICAL_NOTE] := "99"

return

//-------------------------------------------------------------------
/*{Protheus.doc} loadDependentsOnAlimony
    @description Quando houver dedução do IRPF por dependentes ou pensão alimenticia,
					essa função retornará o detalhamento das deduções para cada dependente
	@param cTipDed - Tipo da dedução: 1=Pensão Alimenticia / 2=Dependente
	@param lSusp   - Indentifica se dedução foi suspensa por um processo adm/juridico
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 04/06/2025
    @return
*/
//-------------------------------------------------------------------
method loadDependentsOnAlimony(cTipDed as character, lSusp as logical) as array class DataBlockT158
	local aArea         := {} as array
	local aAreaFKG      := {} as array
	local aDepPen       := {} as array
	local cQuery        := "" as character
	local cDepCPF       := "" as character
	local cLayout       := "" as character
    local nParamOrder   := 1 as numeric

	Default cTipDed	:= "1"
	Default lSusp 	:= .F.

	if lSusp
		cLayout := "T158AM"
	else
		cLayout := "T158AK"
	endIf

    aArea    := getArea()
	aAreaFKG := FKG->( GetArea() )

	DbSelectArea("FKG")
	FKG->(DBSetOrder(2)) //FKG_FILIAL+FKG_IDDOC+FKG_TPIMP
	if FKG->( MsSeek( xFilial("FKG") + self:cIdDoc ) )
		while FKG->( !Eof() ) .And. alltrim( FKG->( FKG_FILIAL + FKG_IDDOC ) ) == alltrim( xFilial("FKG") + self:cIdDoc )
			if !empty(FKG->FKG_CODDEP) .And. ((cTipDed == "1" .And. FKG->FKG_TPATRB $ "013   ") .Or. (cTipDed == "2" .And. FKG->FKG_TPATRB $ "024   "))
				
				if self:oDHTStatement == NIL
					cQuery	:= " SELECT DHT_CPF "
					cQuery	+= " FROM " + RetSqlName("DHT") + " DHT "
					cQuery	+= " WHERE DHT.DHT_FILIAL = ? "
					cQuery	+= " AND DHT.DHT_FORN = ? "
					cQuery	+= " AND DHT.DHT_LOJA = ? "
					cQuery	+= " AND DHT.DHT_COD = ? "
					cQuery	+= " AND DHT.D_E_L_E_T_ = ? "

					cQuery := ChangeQuery( cQuery )

					self:oDHTStatement := FWExecStatement():New( cQuery )
				endIf

				self:oDHTStatement:SetString( nParamOrder++, xFilial("DHT"))
				self:oDHTStatement:SetString( nParamOrder++, (self:cAliasQry)->E2_FORNECE)
				self:oDHTStatement:SetString( nParamOrder++, (self:cAliasQry)->E2_LOJA)
				self:oDHTStatement:SetString( nParamOrder++, FKG->FKG_CODDEP )
                self:oDHTStatement:setString( nParamOrder++, " " )
                
				cDepCPF := self:oDHTStatement:execScalar("DHT_CPF")
                
                nParamOrder := 1

				if !empty(cDepCPF)
					aadd( aDepPen, { cLayout, cDepCPF, FKG->FKG_VALOR } )	
				endIf
			endIf
			FKG->( dbSkip() )
		endDo
	endIf

	restArea(aAreaFKG)
    restArea(aArea)

Return aDepPen

//-------------------------------------------------------------------
/*{Protheus.doc} loadSupplierID
    @description Carrega o conteúdo da propriedade cSupplierID de acordo com a regra de negócio.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 19/05/2025
    @return
*/
//-------------------------------------------------------------------
method loadSupplierID() class DataBlockT158
	local cCdReRat := superGetMv("MV_RETIRRT",.F.,"3208") as character

    self:lCpfFkj := .F.
    if !empty((self:cAliasQry)->FKJ_CPF) .and. alltrim((self:cAliasQry)->E2_CODRET) $ cCdReRat
        self:cSupplierID := (self:cAliasQry)->FKJ_CPF
        self:lCpfFkj := .T.
    elseIf (self:cAliasQry)->A2_TIPO == "J" .And. (self:cAliasQry)->A2_IRPROG == "1"
        self:cSupplierID := (self:cAliasQry)->A2_CPFIRP
    else
        self:cSupplierID := (self:cAliasQry)->A2_CGC 
    endIf
return

//-------------------------------------------------------------------
/*/{Protheus.doc} FKWSusp
    @description Função para verificar se há suspenção da retenção por processo 
					judicial/administrativo para o tributo com natureza(s) de rendimento
					e com fato gerador na emissão.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 28/06/2025
    @return lRet - Retorna .T. se encontrou suspensões.
/*/
//-------------------------------------------------------------------
method FKWSusp() as logical class DataBlockT158
	local nFkwImp 	:= tamSx3("FKW_TPIMP")[1] as numeric
	local cImpIR  	:= padR( 'IRF', nFkwImp ) as Character
	local lRet	  	:= .F. as logical
	local aArea   	:= {} as array
	local aAreaFKW  := {} as array

	aArea    := getArea()
	aAreaFKW := FKW->(getArea())

	dbSelectArea("FKW")
	FKW->(dbSetOrder(2)) //FKW_FILIAL+FKW_IDDOC+FKW_CARTEI+FKW_NATREN+FKW_TPIMP
	FKW->(dbGotop())	
	FKW->(MsSeek( xFilial("FKW") + self:cIdDoc + "1"))

	while FKW->( !eof() ) .and. FKW->FKW_IDDOC == self:cIdDoc .and. FKW->FKW_CARTEI == "1"
		if FKW->FKW_TPIMP == cImpIR .and. !empty(FKW->FKW_NUMPRO)
			lRet := .T.
			exit			
		endIf
		FKW->(dbSkip())
	endDo

	restArea(aAreaFKW)
    restArea(aArea)
return lRet

//-------------------------------------------------------------------
/*/{Protheus.doc} loadIRTaxInPayment
    @description Define o conteúdo da propriedade self:lIRTaxInPayment.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 22/09/2025
    @return
/*/
//-------------------------------------------------------------------
method loadIRTaxInPayment() class DataBlockT158
    local cIrfTax	:= strTran(alltrim(superGetMv("MV_IRF", .F., "IRF")), '"', '') as character
	local jTitFilho := {} as json
	local nIRTaxValue := 0 as numeric
	local nPCCTaxValue := 0 as numeric

	self:lIRTaxInPayment := (self:cAliasQry)->A2_CALCIRF == "2"

	nIRTaxValue := (self:cAliasQry)->(E2_IRRF)
	nPCCTaxValue := (self:cAliasQry)->(E2_PIS + E2_COFINS + E2_CSLL)
	
	jTitFilho := self:getTaxesFromIdDoc()

	if jTitFilho:hasProperty(cIrfTax)
		self:lIRTaxAggregated := nPCCTaxValue > 0 .and. jTitFilho[cIrfTax] == (nPCCTaxValue + nIRTaxValue)
	endIf

return

//-------------------------------------------------------------------
/*/{Protheus.doc} getTaxesFromIdDoc
    @description método para retornar os títulos filhos do título pai informado em cIdDoc.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 22/09/2025
    @return aTaxes - Retorna array com os títulos filhos do título pai informado em cIdDoc.
/*/
//-------------------------------------------------------------------
method getTaxesFromIdDoc() as json class DataBlockT158
	local aArea	:= {} as array
	local aAreaSE2 := {} as array
    local cTaxParentBill := "" as character
    local json := JsonObject():New() as json
    local jTitFilho := JsonObject():New() as json
    local lUseClass := .F. as logical
    local nI := 0 as numeric
    local oBillRelated := Nil as object

    cTaxParentBill := (self:cAliasQry)->(E2_FILIAL + E2_PREFIXO + E2_NUM + E2_PARCELA + E2_TIPO + E2_FORNECE + E2_LOJA)
    lUseClass := FindClass('totvs.protheus.backoffice.fin.bills.related.BillRelated')

	aArea	:= getArea()
	aAreaSE2 := SE2->(getArea())
  
    SE2->(dbSetOrder(1)) // E2_FILIAL+E2_PREFIXO+E2_NUM+E2_PARCELA+E2_TIPO+E2_FORNECE+E2_LOJA
    if SE2->(DbSeek(cTaxParentBill))
 
        if lUseClass
            oBillRelated := totvs.protheus.backoffice.fin.bills.related.BillRelated():New()
            if lUseClass := oBillRelated:canUseRelatedBill()
                json := oBillRelated:getRelatedBills('SE2', .F.)
                if !Empty(json['document']) .And. Len(json['document']) > 0
                    for nI := 1 to len(json['document'])
                        if json['document'][nI]['FK7_TIPO'] == 'TX '
                            jTitFilho[alltrim(json['document'][nI]['E2_NATUREZ'])] := json['document'][nI]['E2_VLCRUZ']
                        endif
                    next
                endif
            endif
        endif
 
        if !lUseClass
            SE2->(dbSetOrder(17)) // E2_FILIAL+E2_TITPAI
            SE2->(dbGotop())
            if SE2->(DbSeek(cTaxParentBill)) 
                while SE2->(!Eof()) .And. AllTrim(SE2->(E2_FILIAL+E2_TITPAI)) == AllTrim(cTaxParentBill)
                    jTitFilho[alltrim(SE2->E2_NATUREZ)] := SE2->E2_VLCRUZ
                    SE2->(dbSkip())
                enddo
            endif
        endif             
    endif

	restArea(aAreaSE2)
	restArea(aArea)
  
return jTitFilho

//-------------------------------------------------------------------
/*/{Protheus.doc} loadTaxesConfigurations
    @description Método para verificação dos impostos configurados via Motor de Retenção
    @type Method
    @version 12.1.2410
    @author fabio.casagrande
    @since 22/09/2025
    @return aImpConf - Retencoes configuradas no Motor para Natureza/Fornecedor
/*/
//-------------------------------------------------------------------
method loadTaxesConfigurations() class DataBlockT158
	local aImpConf       := {} as array
	local nZ             := 0 as numeric
    local cPortfolioCode := PAYABLE_PORTFOLIO_CODE as character
    local cSupplier      := alltrim((self:cAliasQry)->E2_FORNECE) as character
    local cUnit          := alltrim((self:cAliasQry)->E2_LOJA) as character
    local cClass         := alltrim((self:cAliasQry)->E2_NATUREZ) as character
    local dIssueDate     := stod((self:cAliasQry)->E2_EMISSAO)  as date

	self:lPccMR   := .F.
	self:lIrfMR   := .F.
	self:lIssMR   := .F.
	self:lPccBxMR := .F.
	self:lIrfBxMR := .F.
	self:lIssBxMR := .F.

	aImpConf := FinImpConf(cPortfolioCode, cFilAnt, cSupplier, cUnit, cClass, self:cIdDoc, dIssueDate)

	For nZ := 1 to Len(aImpConf)
		Do Case
			Case aImpConf[nZ,1] $ "PIS|COF|CSL"
				self:lPccMR := .T.
				self:lPccBxMR := aImpConf[nZ,2] == "2"				
			Case aImpConf[nZ,1] == "IRF"
				self:lIrfMR := .T.
				self:lIrfBxMR := aImpConf[nZ,2] == "2"
			Case aImpConf[nZ,1] == "ISS"
				self:lIssMR := .T.
				self:lIssBxMR := aImpConf[nZ,2] == "2"				
		End Case
	Next

	FwFreeArray(aImpConf)
return

//-------------------------------------------------------------------
/*/{Protheus.doc} validateTaxBorderaux
    @description Método para validar se o tributo gerado pelo borderô (FINA241 ou FINA590), e que foi cadastrado pelo 
					Configurador de Tributos, se trata de um dos impostos do bloco 40 (PIS, COFINS, CSLL e/ou IRRF), já que 
					na movimentação gerada pelo bordero (FK2) não há a identificação do tributo.
    @type Method
    @version 12.1.2410
    @author fabio.casagrande
    @since 28/09/2025
    @return .T. se é um tributo do bloco 40.
/*/
//-------------------------------------------------------------------
method validateTaxBorderaux(cIdFk2 as character, cFilOri as character) as logical class DataBlockT158
	Local lRet As Logical
	Local cQuery As Character
	Local cAlsFk3 As Character
	local nParamOrder   := 1 as numeric

	Default cIdFk2 := ""
	Default cFilOri := cFilAnt

	lRet := .F.

	If self:oQryFk3Statement == Nil
		cQuery := " SELECT FK3_IMPOS FROM " + RetSqlName("FK3")
		cQuery += " WHERE FK3_FILORI = ? "
		cQuery += " AND FK3_TABORI = ? "
		cQuery += " AND FK3_IDORIG = ? "
		cQuery += " AND FK3_IMPOS IN (?)"
		cQuery += " AND FK3_RECPAG = ? "
		cQuery += " AND FK3_STATUS = ? "
		cQuery += " AND D_E_L_E_T_ = ? "
		self:oQryFk3Statement := FWExecStatement():New(cQuery)
	EndIf
	
	self:oQryFk3Statement:SetString(nParamOrder++, cFilOri)
	self:oQryFk3Statement:SetString(nParamOrder++, 'FK2')
	self:oQryFk3Statement:SetString(nParamOrder++, cIdFk2)
	self:oQryFk3Statement:SetIn(nParamOrder++, {'IRF','PIS','COF','CSL','PISRET','COFRET'})
	self:oQryFk3Statement:SetString(nParamOrder++, 'P')
	self:oQryFk3Statement:SetString(nParamOrder++, '1')
	self:oQryFk3Statement:SetString(nParamOrder++,  ' ')

	cAlsFk3 := self:oQryFk3Statement:OpenAlias()

	if (cAlsFk3)->(!eof())
		lRet := .T.
	endIf	

	(cAlsFk3)->(DbCloseArea())

return lRet
