namespace totvs.protheus.backoffice.fin.taf.smartschedule

//-------------------------------------------------------------------
/*/{Protheus.doc} DataBlockT159
    Classe responsável por selecionar e montar Json do Bloco T159 (Cadastro de Obras)
    @author guilhermed.santos@totvs.com.br
    @since 08/05/2025
    @version 12.1.2410
*/
//-------------------------------------------------------------------
class DataBlockT159
    protected data cIdDoc as character
    protected data jBlockT159 as json
    protected data lHasDataBlock as logical
    protected data oStatement as object
    protected data cAliasFod as character
    protected data aT159inT003 as array
    protected data lHasT003 as logical

    public method new(cIdDoc as character) as object
    public method loadT159Block()
    public method getHasDataBlock() as logical
    public method getT159Block() as json
    public method getHasT003() as logical
    public method validParticipants(jDataBlocks as json)
    public method getT159InT003() as array
    protected method setIdDoc(cIdDoc as character)
    protected method getT159Data() as json
    protected method setHasDataBlock(lHasDataBlock as logical)
    protected method setHasT003(lHasT003 as logical)
    protected method loadFodStatement()
    protected method loadT003Data(aSupplierData as array)
endClass

//-------------------------------------------------------------------
/*{Protheus.doc} new
    Construtor
    @return object: self
    @author guilhermed.santos
    @since 08/05/2025
    @version 12.1.2410
*/
//-------------------------------------------------------------------
method new(cIdDoc as character) as object class DataBlockT159
        self:setIdDoc(cIdDoc)
        self:jBlockT159 := jsonObject():new()
        self:setHasDataBlock(.F.)
        self:setHasT003(.F.)
        self:oStatement := Nil
        self:aT159inT003 := {}
return self

//-------------------------------------------------------------------
/*{Protheus.doc} setIdDoc
    @description Define o conteúdo da propriedade cIdDoc.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 08/05/2025
    @return
*/
//-------------------------------------------------------------------
method setIdDoc(cIdDoc as character) class DataBlockT159
    self:cIdDoc := cIdDoc
return

//-------------------------------------------------------------------
/*{Protheus.doc} loadT159Block
    @description Responsável por acionar os métodos de buscas de registros e montar o json na propriedade self:jBlockT159.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 08/05/2025
    @return
*/
//-------------------------------------------------------------------
method loadT159Block() class DataBlockT159
    self:jBlockT159 := self:getT159Data()
return

//-------------------------------------------------------------------
/*{Protheus.doc} getT159Block
    @description Retorna a propriedade self:jBlockT159.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 08/05/2025
    @return
*/
//-------------------------------------------------------------------
method getT159Block() as json class DataBlockT159
return self:jBlockT159

//-------------------------------------------------------------------
/*{Protheus.doc} getT159InT003
    @description Retorna a propriedade self:jBlockT159.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 23/05/2025
    @return
*/
//-------------------------------------------------------------------
method getT159InT003() as array class DataBlockT159
return self:aT159inT003

//-------------------------------------------------------------------
/*{Protheus.doc} getT159Data
    @description Montagem do Json do bloco T159.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 08/05/2025
    @return
*/
//-------------------------------------------------------------------
method getT159Data() as json class DataBlockT159
    local aBlockT159AA  := {} as array
    local aSupplierData := {} as array
	local cInitialDate  := "" as character
	local cFinalDate    := "" as character
    local jT159         := jsonObject():new() as json

    self:loadFodStatement()

    if !(self:cAliasFOD)->(eof())
        cInitialDate  := (self:cAliasFOD)->FOD_INIVIG
        cInitialDate  := subStr(cInitialDate,4,4)+subStr(cInitialDate,1,2)

        if !empty((self:cAliasFOD)->FOD_FIMVIG)
            cFinalDate  := (self:cAliasFOD)->FOD_FIMVIG
            cFinalDate  := subStr(cFinalDate,4,4)+subStr(cFinalDate,1,2)
        endIf

        jT159['CNPJ'] := (self:cAliasFOD)->FOD_CGCSCP
        jT159['NOME'] := ""
        jT159['INIVALID'] := cInitialDate
        jT159['FIMVALID'] := cFinalDate
        jT159['TPENTLIG'] := "4"

        self:setHasDataBlock(.T.)

        while !(self:cAliasFOD)->(eof())
            aadd(aBlockT159AA, {'COD_PARTICIPANTE': "F" + (self:cAliasFOD)->A2_COD + (self:cAliasFOD)->A2_LOJA,;
                                'PERCENTUAL_PARTICIPACAO': (self:cAliasFOD)->FOD_PERCEN })

            aadd(aSupplierData,{(self:cAliasFOD)->A2_COD,(self:cAliasFOD)->A2_LOJA})

            (self:cAliasFOD)->(dbSkip())
        endDo
    endIf

    if len(aBlockT159AA) > 0
        jT159["T159AA"] := aBlockT159AA
        self:loadT003Data(aSupplierData)
    endIf

return jT159

