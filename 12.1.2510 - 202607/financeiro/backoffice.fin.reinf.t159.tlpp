//-------------------------------------------------------------------
/*{Protheus.doc} loadFodStatement
    @description Monta e executa query da FOD com join na FK7, FKF e SA2.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 08/05/2025
    @return
*/
//-------------------------------------------------------------------
method loadFodStatement()class DataBlockT159
	local cQuery	    := "" as character
    local nParamOrder   := 1  as numeric

    if self:oStatement == NIL
        cQuery	:= " SELECT FOD.FOD_FILIAL, FOD.FOD_FILSCP, FOD.FOD_FILSOC, FOD.FOD_CGCSCP,  "
        cQuery	+= "   FOD.FOD_PERCEN, FOD.FOD_INIVIG, FOD.FOD_FIMVIG,  "
        cQuery	+= "   SA2.A2_COD, SA2.A2_LOJA  "
        cQuery	+= " FROM " + retSqlName("FOD") + " FOD "
        cQuery	+= " INNER JOIN " + retSqlName("SA2") + " SA2 "
        cQuery	+= "   ON SA2.A2_FILIAL = ? "
        cQuery	+= "   AND SA2.A2_CGC = FOD.FOD_CGCCPF  "
        cQuery	+= "   AND SA2.D_E_L_E_T_ = ?  "
        cQuery	+= " WHERE FOD.FOD_FILIAL = ? "
        cQuery	+= "   AND FOD.FOD_FILSCP IN (  "
        cQuery	+= "        SELECT FOD2.FOD_FILSCP  "
        cQuery	+= "        FROM " + retSqlName("FK7") + " FK7 "
        cQuery	+= " 	    INNER JOIN " + retSqlName("SA2") + " SA22 "
        cQuery	+= " 	        ON " + fwJoinFilial("SA2", "FK7","SA22")
        cQuery	+= " 		    AND SA22.A2_COD = FK7.FK7_CLIFOR "
        cQuery	+= " 		    AND SA22.A2_LOJA = FK7.FK7_LOJA "
        cQuery	+= " 		    AND SA22.A2_CGC <> ? "
        cQuery	+= " 		    AND SA22.D_E_L_E_T_ = ? "
        cQuery	+= " 	    INNER JOIN " + retSqlName("FKF") + " FKF "
        cQuery	+= " 	        ON " + fwJoinFilial("FKF", "FK7")    
        cQuery	+= " 	    	AND FKF.FKF_IDDOC = FK7.FK7_IDDOC "
        cQuery	+= " 	    	AND FKF.FKF_CGCSCP <> ? "
        cQuery	+= " 	    	AND FKF.D_E_L_E_T_ = ? "
        cQuery	+= " 	    INNER JOIN " + retSqlName("FOD") + " FOD2 "
        cQuery	+= " 	        ON " + fwJoinFilial("FOD", "SA2",'FOD2','SA22') 
        cQuery	+= " 	    	AND FOD2.FOD_CGCCPF = SA22.A2_CGC "
        cQuery	+= " 	    	AND FOD2.D_E_L_E_T_ = ? "
        cQuery	+= "         WHERE FK7.FK7_FILTIT = ? "
        cQuery	+= " 	    AND FK7_ALIAS = ? "
        cQuery	+= " 	    AND FK7_IDDOC = ? "
        cQuery	+= " 	    AND FK7.D_E_L_E_T_ = ? ) "
        cQuery	+= "   AND FOD.FOD_INIVIG <> ?  "
        cQuery	+= "   AND FOD.D_E_L_E_T_ = ?  "
        cQuery	+= " ORDER BY FOD.FOD_FILIAL, FOD.FOD_FILSCP, FOD.FOD_FILSOC "

        cQuery := ChangeQuery(cQuery)
        self:oStatement := FWExecStatement():New(cQuery)
    endIf

    self:oStatement:SetString( nParamOrder++, xFilial("SA2"))
    self:oStatement:setString( nParamOrder++, " " )
    self:oStatement:SetString( nParamOrder++, xFilial("FOD"))
    self:oStatement:setString( nParamOrder++, " " )
    self:oStatement:setString( nParamOrder++, " " )
    self:oStatement:setString( nParamOrder++, " " )
    self:oStatement:setString( nParamOrder++, " " )
    self:oStatement:setString( nParamOrder++, " " )
    self:oStatement:setString( nParamOrder++, xFilial("SE2"))
    self:oStatement:setString( nParamOrder++, "SE2" )
    self:oStatement:setString( nParamOrder++, self:cIdDoc )
    self:oStatement:setString( nParamOrder++, " " )
    self:oStatement:setString( nParamOrder++, " " )
    self:oStatement:setString( nParamOrder++, " " )

    self:cAliasFOD := self:oStatement:openAlias()
return

//-------------------------------------------------------------------
/*{Protheus.doc} loadT003Data
    @description Inicia e carrega o objeto DataBlockT003 com os dados do participante do bloco T159AA
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 23/05/2025
    @return
*/
//-------------------------------------------------------------------
method loadT003Data(aSupplierData as array) class DataBlockT159
    local oBlockT003 := Nil as object
    local nX := 0 as numeric

    oBlockT003 := DataBlockT003():new(self:cIdDoc)

    for nX := 1 to len(aSupplierData)
        oBlockT003:setParticipantData(aSupplierData[nX][1],aSupplierData[nX][2])
        jT159InT003 := oBlockT003:getSupplierData()
        if jT159inT003:hasProperty("T003")
            self:setHasT003(.T.)
            aadd(self:aT159inT003,{jT159InT003["T003"][1],.T.})
        endIf
    next
return


//-------------------------------------------------------------------
/*{Protheus.doc} validParticipants
    @description Valida se o código do participante do bloco T159AA já está presente no bloco T003, se estiver, marca o registro como .F. para não reintegrar no bloco T003
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 23/05/2025
    @return
*/
//-------------------------------------------------------------------
method validParticipants(jDataBlocks as json) class DataBlockT159
    local nT159Total    := 0 as numeric
    local nT003Total    := 0 as numeric
    local nCounterT159  := 0 as numeric
    local nCounterT003  := 0 as numeric

    nT159Total := len(self:aT159inT003)
    nT003Total := len(jDataBlocks["T003"]["T003"])

    for nCounterT159 := 1 to nT159Total
        for nCounterT003 := 1 to nT003Total
            if self:aT159inT003[nCounterT159][1]["COD_PART"] == jDataBlocks["T003"]["T003"][nCounterT003]["COD_PART"]
                self:aT159inT003[nCounterT159][2] := .F.
                exit
            endIf
        next
    next
return
