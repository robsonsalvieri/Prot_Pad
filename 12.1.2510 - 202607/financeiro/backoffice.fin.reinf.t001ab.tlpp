#include "msobject.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#Include "TOTVS.CH"

#define FULL_AMOUNT_YES '1'

namespace totvs.protheus.backoffice.fin.taf.smartschedule

//-------------------------------------------------------------------
/*/{Protheus.doc} DataBlockT001AB
    Classe responsável por selecionar e montar Json do Bloco T001AB (Processos Referenciados)
    @author guilhermed.santos@totvs.com.br
    @since 15/04/2025
    @version 12.1.2410
*/
//-------------------------------------------------------------------
class DataBlockT001AB
    protected data cIdDoc        as character
    protected data cAliasFKG     as character
    protected data cAliasCCF     as character
    protected data jBlockT001AB  as json
    protected data lHasDataBlock as logical
    protected data oStatementFKG as object
    protected data oStatementCCF as object

    public method new(cIdDoc as character) as object
    public method loadT001ABBlock()
    public method getHasDataBlock() as logical
    public method getT001ABBlock() as json
    protected method setIdDoc(cIdDoc as character)
    protected method getT001ABData() as json
    protected method loadFKGStatement()
    protected method loadCCFStatement()
    protected method setHasDataBlock(lHasDataBlock as logical)
endClass


//-------------------------------------------------------------------
/*{Protheus.doc} new
    Construtor
    @return object: self
    @author guilhermed.santos
    @since 10/04/2025
    @version 12.1.2410
*/
//-------------------------------------------------------------------
method new(cIdDoc as character) as object class DataBlockT001AB
        self:setIdDoc(cIdDoc)
        self:jBlockT001AB := jsonObject():new()
        self:cAliasFKG := ""
        self:cAliasCCF := ""
        self:oStatementFKG := Nil
        self:oStatementCCF := Nil
        self:setHasDataBlock(.F.)
return self

//-------------------------------------------------------------------
/*{Protheus.doc} setIdDoc
    @description Define o conteúdo da propriedade cIdDoc.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 17/04/2025
    @return
*/
//-------------------------------------------------------------------
method setIdDoc(cIdDoc as character) class DataBlockT001AB
    self:cIdDoc := cIdDoc
return

//-------------------------------------------------------------------
/*{Protheus.doc} loadT001ABBlock
    @description Responsável por acionar os métodos de buscas de registros e montar o json na propriedade self:jBlockT001AB.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 10/04/2025
    @return
*/
//-------------------------------------------------------------------
method loadT001ABBlock() class DataBlockT001AB
    local aBlockT001AB := {} as array

    self:loadFKGStatement()

    while !(self:cAliasFKG)->(eof())
        self:loadCCFStatement((self:cAliasFKG)->FKG_NUMPRO,(self:cAliasFKG)->FKG_TPPROC)

        if !(self:cAliasCCF)->(eof())
            aadd(aBlockT001AB,self:getT001ABData())
        endIf

        (self:cAliasFKG)->(dbSkip())
    endDo
    
    if len(aBlockT001AB) > 0
        self:jBlockT001AB["T001AB"] := aBlockT001AB
        self:setHasDataBlock(.T.)
    endIf
return

//-------------------------------------------------------------------
/*{Protheus.doc} getT001ABBlock
    @description Retorna a propriedade self:jBlockT001AB.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 10/04/2025
    @return
*/
//-------------------------------------------------------------------
method getT001ABBlock() as json class DataBlockT001AB
return self:jBlockT001AB

//-------------------------------------------------------------------
/*{Protheus.doc} loadFKGStatement
    @description Monta e executa query para buscar os registros na FKG relacionado com o IDDOC.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 14/04/2025
    @return
*/
//-------------------------------------------------------------------
method loadFKGStatement() class DataBlockT001AB
    local cQuery        := "" as character
    local nParamOrder   := 1  as numeric

    if self:oStatementFKG == Nil
        cQuery := "SELECT FKG_NUMPRO, FKG_TPPROC FROM " + retSqlName("FKG") + " FKG "
        cQuery += " WHERE FKG_FILIAL = ? "
        cQuery += " AND FKG_IDDOC = ? "
        cQuery += " AND FKG_TPIMP IN (?) "
        cQuery += " AND FKG_TPATRB = ? "
        cQuery += " AND D_E_L_E_T_ = ? "
        cQuery += " GROUP BY FKG_NUMPRO, FKG_TPPROC "

        cQuery := ChangeQuery(cQuery)

        self:oStatementFKG := FWExecStatement():New(cQuery)
    endIf

    self:oStatementFKG:setString( nParamOrder++, xFilial("FKG") )
    self:oStatementFKG:setString( nParamOrder++, self:cIdDoc )
    self:oStatementFKG:SetIn( nParamOrder++, {"INSS","IRF","PIS","COF","CSL"} )
    self:oStatementFKG:setString( nParamOrder++, '004' )
    self:oStatementFKG:setString( nParamOrder++, " " )

    self:cAliasFKG := self:oStatementFKG:openAlias()
return

//-------------------------------------------------------------------
/*{Protheus.doc} loadCCFStatement
    @description Monta e executa a query para buscar os registros na CCF relacionado ao número e tipo de processo encontrado na FKG.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 10/04/2025
    @return
*/
//-------------------------------------------------------------------
method loadCCFStatement(cProcessNumber as character, cProcessType as character) class DataBlockT001AB
    local cQuery        := "" as character
    local nParamOrder   := 1  as numeric

    if self:oStatementCCF == Nil
        cQuery := "SELECT CCF_NUMERO, CCF_TIPO, CCF_DESCJU, CCF_IDSEJU, CCF_IDVARA, CCF_NATJU, "
        cQuery += " CCF_DESCJU, CCF_DTSENT, CCF_NATAC, CCF_DTADM, CCF_TPCOMP, CCF_INDAUT, CCF_UF, CCF_CODMUN, "
        cQuery += " CCF_DTINI, CCF_DTFIN, CCF_MONINT, CCF_INDSUS, CCF_SUSEXI FROM " + retSqlName("CCF") + " CCF "
        cQuery += " WHERE CCF_FILIAL = ? "
        cQuery += " AND CCF_NUMERO = ? "
        cQuery += " AND CCF_TIPO = ? "
        cQuery += " AND D_E_L_E_T_ = ? "

        cQuery := ChangeQuery(cQuery)

        self:oStatementCCF := FWExecStatement():New(cQuery)
    endIf

    self:oStatementCCF:setString( nParamOrder++, xFilial("CCF") )
    self:oStatementCCF:setString( nParamOrder++, cProcessNumber)
    self:oStatementCCF:setString( nParamOrder++, cProcessType)
    self:oStatementCCF:setString( nParamOrder++, " " )

    self:cAliasCCF := self:oStatementCCF:openAlias()
return

//-------------------------------------------------------------------
/*{Protheus.doc} getT001ABData
    @description Montagem do Json do bloco T001AB.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 10/04/2025
    @return
*/
//-------------------------------------------------------------------
method getT001ABData() as json class DataBlockT001AB
    local cInitDate  := ""  as character
    local cFinalDate := ""  as character
    local dInitDate  := sToD('') as date
    local dFinalDate := sToD('') as date
    local jT001AB    := jsonObject():new() as json
    local aT001AO    := {} as array
    local cCCFMonint := "N" as character


    If !Empty((self:cAliasCCF)->CCF_DTINI)
        dInitDate := sToD((self:cAliasCCF)->CCF_DTINI)
        cInitDate := STRZERO(MONTH(dInitDate),2)+STRZERO(YEAR(dInitDate),4) 
    EndIf

    if !Empty((self:cAliasCCF)->CCF_DTFIN)
        dFinalDate := sToD((self:cAliasCCF)->CCF_DTFIN)
        cFinalDate := STRZERO(MONTH(dFinalDate),2)+STRZERO(YEAR(dFinalDate),4) 
    EndIf

    if (self:cAliasCCF)->CCF_MONINT == FULL_AMOUNT_YES
        cCCFMonint := "S"
    endIf

    jT001AB["NUM_PROC"]             := (self:cAliasCCF)->CCF_NUMERO
	jT001AB["IND_PROC"]             := (self:cAliasCCF)->CCF_TIPO
	jT001AB["DESCRI_RESUMIDA"]      := (self:cAliasCCF)->CCF_DESCJU
	jT001AB["ID_SEC_JUD"]           := (self:cAliasCCF)->CCF_IDSEJU
	jT001AB["ID_VARA"]              := (self:cAliasCCF)->CCF_IDVARA
	jT001AB["IND_NAT_ACAO_JUSTICA"] := (self:cAliasCCF)->CCF_NATJU
	jT001AB["DESC_DEC_JUD"]         := (self:cAliasCCF)->CCF_DESCJU
	jT001AB["DT_SENT_JUD"]          := (self:cAliasCCF)->CCF_DTSENT
	jT001AB["IND_NAT_ACAO_RECEITA"] := (self:cAliasCCF)->CCF_NATAC
	jT001AB["DT_DEC_ADM"]           := (self:cAliasCCF)->CCF_DTADM
	jT001AB["TP_PROC"]              := (self:cAliasCCF)->CCF_TPCOMP
	jT001AB["INDAUTORIA"]           := (self:cAliasCCF)->CCF_INDAUT
	jT001AB["UFVARA"]               := (self:cAliasCCF)->CCF_UF
	jT001AB["CODMUNIC"]             := (self:cAliasCCF)->CCF_CODMUN
	jT001AB["INIVALID"]             := cInitDate
	jT001AB["FIMVALID"]             := cFinalDate

    while !(self:cAliasCCF)->(eof())
        aadd(aT001AO,{"COD_SUSP"  : (self:cAliasCCF)->CCF_INDSUS;
                    ,"IND_SUSP"   : (self:cAliasCCF)->CCF_SUSEXI;
                    ,"DT_DECISAO" : (self:cAliasCCF)->CCF_DTADM;
                    ,"IND_DEPOSITO": cCCFMonint})

        (self:cAliasCCF)->(dbSkip())
    endDo

    jT001AB["T001AO"] := aT001AO
    

return jT001AB

//-------------------------------------------------------------------
/*{Protheus.doc} setHasDataBlock
    @description Define o conteúdo da propriedade self:lHasDataBlock.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 17/04/2025
    @return
*/
//-------------------------------------------------------------------
method setHasDataBlock(lHasDataBlock) class DataBlockT001AB
    self:lHasDataBlock := lHasDataBlock
return

//-------------------------------------------------------------------
/*{Protheus.doc} getHasDataBlock
    @description Retorna o conteúdo da propriedade self:lHasDataBlock.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 17/04/2025
    @return
*/
//-------------------------------------------------------------------
method getHasDataBlock() as logical class DataBlockT001AB
return self:lHasDataBlock
