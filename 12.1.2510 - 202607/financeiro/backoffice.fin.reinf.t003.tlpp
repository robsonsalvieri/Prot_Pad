#include "msobject.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#Include "TOTVS.CH"

#define INDPAA_YES '1'
#define INDPAA_NO '0'
#define CPRB_TAX_YES '1'
#define SPORTS_ASSOC_YES '1'
#define EXEMPTED_FROM_NIF '1'
#define COUNTRY_DOESNT_DEMAND_NIF '2'
#define NOT_EXEMPT '1'

namespace totvs.protheus.backoffice.fin.taf.smartschedule

//-------------------------------------------------------------------
/*/{Protheus.doc} DataBlockT003
    Classe responsável por selecionar e montar Json do Bloco T003 (Cadastro de Participantes (Fornecedores e Clientes))
    @author guilhermed.santos@totvs.com.br
    @since 15/04/2025
    @version 12.1.2410
*/
//-------------------------------------------------------------------
class DataBlockT003
    protected data cIdDoc as character
    protected data cBusinessPartnerAlias as character
    protected data cSupplierDependentsAlias as character
    protected data jBlockT003 as json
    protected data lHasDataBlock as logical
    protected data oBusinessPartnerStatement as object
    protected data oSupplierDependentsStatement as object
    protected data cMvUniao as character
    protected data cParticipantCode as character
    protected data cParticipantUnit as character

    public method new(cIdDoc as character) as object
    public method loadT003Block()
    public method getHasDataBlock() as logical
    public method getT003Block() as json
    public method setParticipantData(cParticipantCode as character, cParticipantUnit as character)
    public method getSupplierData() as json
    protected method setIdDoc(cIdDoc as character)
    protected method loadSupplierDependentsStatement()
    protected method getT003Data(cAliasFK7 as character) as json
    protected method getCustomerData() as json
    protected method getAddressNumber(cAddress as character, cState as character) as array
    protected method setHasDataBlock(lHasDataBlock as logical)
    protected method getFkjParticipant(aT003 as array) as array
endClass


//-------------------------------------------------------------------
/*{Protheus.doc} new
    Construtor
    @return object: self
    @author guilhermed.santos
    @since 15/04/2025
    @version 12.1.2410
*/
//-------------------------------------------------------------------
method new(cIdDoc as character) as object class DataBlockT003
        self:setIdDoc(cIdDoc)
        self:jBlockT003 := jsonObject():new()
        self:cBusinessPartnerAlias := ""
        self:cSupplierDependentsAlias := ""
        self:oSupplierDependentsStatement := Nil
        self:cMvUniao := superGetMv("MV_UNIAO",.F.,"UNIAO")
        self:setHasDataBlock(.F.)
        self:cParticipantCode := ""
        self:cParticipantUnit := ""
return self

//-------------------------------------------------------------------
/*{Protheus.doc} setIdDoc
    @description Define o conteúdo da propriedade cIdDoc.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 17/04/2025
    @return
*/
//-------------------------------------------------------------------
method setIdDoc(cIdDoc as character) class DataBlockT003
    self:cIdDoc := cIdDoc
return

//-------------------------------------------------------------------
/*{Protheus.doc} setParticipantData
    @description Define o conteúdo da propriedade cParticipantCode e cParticipantUnit.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 23/05/2025
    @return
*/
//-------------------------------------------------------------------
method setParticipantData(cParticipantCode as character, cParticipantUnit as character) class DataBlockT003
    default cParticipantCode := ""
    default cParticipantUnit := ""

    self:cParticipantCode := cParticipantCode
    self:cParticipantUnit := cParticipantUnit
return

//-------------------------------------------------------------------
/*{Protheus.doc} loadT003Block
    @description Responsável por acionar os métodos de buscas de registros e montar o json na propriedade self:jBlockT003.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 10/04/2025
    @return
*/
//-------------------------------------------------------------------
method loadT003Block() class DataBlockT003
    local aArea      := {} as array
    local aAreaFK7   := {} as array

    aArea    := getArea()
    aAreaFK7 := FK7->(getArea())

    dbSelectArea('FK7')
    FK7->(dbSetOrder(5)) //FK7_IDDOC
    if FK7->(dbSeek(self:cIdDoc))
        self:setParticipantData(FK7->FK7_CLIFOR,FK7->FK7_LOJA)
        self:jBlockT003 := self:getT003Data(FK7->FK7_ALIAS)
    endIf

    if self:jBlockT003:hasProperty("T003")
        self:setHasDataBlock(.T.)
    endIf

    restArea(aAreaFK7)
    restArea(aArea)
return


//-------------------------------------------------------------------
/*{Protheus.doc} getT003Block
    @description Retorna a propriedade self:jBlockT003.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 10/04/2025
    @return
*/
//-------------------------------------------------------------------
method getT003Block() as json class DataBlockT003
return self:jBlockT003

//-------------------------------------------------------------------
/*{Protheus.doc} loadSupplierDependentsStatement
    @description Monta e executa query para buscar os dados de dependentes (DHT).
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 14/04/2025
    @return
*/
//-------------------------------------------------------------------
method loadSupplierDependentsStatement() class DataBlockT003
    local cQuery        := "" as character
    local nParamOrder   := 1  as numeric

    if self:oSupplierDependentsStatement == Nil
        cQuery := "SELECT DHT_COD, DHT_NOME, DHT_CPF, DHT_RELACA "
        cQuery += " FROM " + retSqlName("DHT") + " DHT "
        cQuery += " WHERE DHT.DHT_FILIAL = ? "
        cQuery += " AND DHT.DHT_FORN = ? "
        cQuery += " AND DHT.DHT_LOJA = ? "
        cQuery += " AND DHT.D_E_L_E_T_ = ? "

        cQuery := ChangeQuery(cQuery)

        self:oSupplierDependentsStatement := FWExecStatement():New(cQuery)
    endIf

    self:oSupplierDependentsStatement:setString( nParamOrder++, xFilial("DHT") )
    self:oSupplierDependentsStatement:setString( nParamOrder++, SA2->A2_COD )
    self:oSupplierDependentsStatement:setString( nParamOrder++, SA2->A2_LOJA )
    self:oSupplierDependentsStatement:setString( nParamOrder++, " " )

    self:cSupplierDependentsAlias := self:oSupplierDependentsStatement:openAlias()
return


//-------------------------------------------------------------------
/*{Protheus.doc} getT003Data
    @description Montagem do Json do bloco T003.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 10/04/2025
    @return
*/
//-------------------------------------------------------------------
method getT003Data(cAliasFK7 as character) as json class DataBlockT003
    local jT003 := jsonObject():new() as json

    if cAliasFK7 == 'SE1'
        jT003["T003"] := {self:getCustomerData()}
    else
        jT003 := self:getSupplierData()
    endIf

return jT003

//-------------------------------------------------------------------
/*{Protheus.doc} getCustomerData
    @description Monta o Json com dados do Cliente.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 23/04/2025
    @return
*/
//-------------------------------------------------------------------
method getCustomerData() as json class DataBlockT003
    local jCustomerData := jsonObject():new() as json
    local aArea         := {} as array
    local aAreaSA1      := {} as array
    local aAreaAI0      := {} as array
    local aGetAddress   := {} as array
    local cEmpty        := "" as character
    local cCountryCode  := "" as character
    local cCnpj         := "" as character
    local cCpf          := "" as character
    local cTypePerson   := "" as character
    local cCityCode     := "" as character
    local cAddress      := "" as character
    local cAddressNum   := "" as character
    local cExecPAA      := "" as character

    aArea    := getArea()
    aAreaSA1 := SA1->(getArea())
    aAreaAI0 := AI0->(getArea())

    dbSelectArea('SA1')
    SA1->(dbSetOrder(1)) //A1_FILIAL+A1_COD+A1_LOJA
    if SA1->(dbSeek(xFilial('SA1') + self:cParticipantCode + self:cParticipantUnit))
        if alltrim(SA1->A1_COD) == alltrim(self:cMvUniao)
            return jCustomerData
        endIf
        if empty(SA1->A1_CODPAIS)
            cCountryCode := ''
        else
            cCountryCode := padl(allTrim(SA1->A1_CODPAIS),5,"0")
        endIf

        If SA1->A1_PESSOA == "F"
            cCpf := SA1->A1_CGC 
            cTypePerson := "1"
        ElseIf SA1->A1_PESSOA == "J" 
            cCnpj := SA1->A1_CGC
            cTypePerson := "2"
        EndIf

        if SA1->A1_EST == "EX"
            cCityCode := "99999"
        else
            cCityCode := SA1->A1_COD_MUN
        endIf

        aGetAddress := self:getAddressNumber( SA1->A1_END, SA1->A1_EST )

        cAddress        := aGetAddress[1]
        cAddressNum  := aGetAddress[2]

        cExecPAA := Posicione("AI0",1, SA1->(A1_FILIAL + A1_COD + A1_LOJA), "AI0_INDPAA")
        
        if !(cExecPAA == INDPAA_YES)
            cExecPAA := INDPAA_NO
        endIf

        jCustomerData["COD_PART"]           := "C"+ allTrim(SA1->(A1_COD + A1_LOJA))
        jCustomerData["NOME"]               := SA1->A1_NOME
        jCustomerData["COD_PAIS"]           := cCountryCode
        jCustomerData["CNPJ"]               := cCnpj
        jCustomerData["CPF"]                := cCpf
        jCustomerData["IE"]                 := SA1->A1_INSCR
        jCustomerData["COD_MUN"]            := cCityCode
        jCustomerData["SUFRAMA"]            := SA1->A1_SUFRAMA
        jCustomerData["TP_LOGR"]            := cEmpty
        jCustomerData["ENDERECO"]           := cAddress
        jCustomerData["NUM"]                := cAddressNum
        jCustomerData["COMPLEM_END"]        := SA1->A1_COMPLEM
        jCustomerData["TP_BAIRRO"]          := cEmpty
        jCustomerData["BAIRRO"]             := SA1->A1_BAIRRO
        jCustomerData["UF"]                 := SA1->A1_EST
        jCustomerData["CEP"]                := SA1->A1_CEP
        jCustomerData["DDD"]                := SA1->A1_DDD
        jCustomerData["FONE"]               := SA1->A1_TEL
        jCustomerData["DDD"]                := SA1->A1_DDD
        jCustomerData["FAX"]                := SA1->A1_FAX
        jCustomerData["EMAIL"]              := SA1->A1_EMAIL
        jCustomerData["DT_INCLUSAO"]        := SA1->A1_DTCAD
        jCustomerData["TP_PESSOA"]          := cTypePerson
        jCustomerData["RAMO_ATIV"]          := cEmpty
        jCustomerData["COD_INST_ANP"]       := cEmpty
        jCustomerData["COD_ATIV"]           := cEmpty
        jCustomerData["COD_PAIS_EXT"]       := cEmpty
        jCustomerData["LOGRAD_EXT"]         := cEmpty
        jCustomerData["NR_LOGRAD_EXT"]      := cEmpty
        jCustomerData["COMPLEM_EXT"]        := cEmpty
        jCustomerData["BAIRRO_EXT"]         := cEmpty
        jCustomerData["NOME_CIDADE_EXT"]    := cEmpty
        jCustomerData["COD_POSTAL_EXT"]     := cEmpty
        jCustomerData["DT_LAUDO_MOLEST_GRAVE"]  := cEmpty
        jCustomerData["REL_FONTE_PAG_RESID_EXTERIOR"]   := cEmpty
        jCustomerData["INSCR_MUNICIPAL"]    := SA1->A1_INSCRM
        jCustomerData["SIMPLES_NACIONAL"]   := cEmpty
        jCustomerData["ENQUADRAMENTO"]      := cEmpty
        jCustomerData["OBSOLETO"]           := cEmpty
        jCustomerData["INDCPRB"]            := cEmpty
        jCustomerData["CODTRI"]             := cEmpty
        jCustomerData["EXECPAA"]            := cExecPAA
        jCustomerData["IND_ASSOC_DESPORT"]  := cEmpty
        jCustomerData["CONTRIBUINTE"]       := cEmpty
        jCustomerData["INDOPCCP"]           := cEmpty
        jCustomerData["ISENCAO_IMUNIDADE"]  := cEmpty
        jCustomerData["ESTADO_EXT"]         := cEmpty
        jCustomerData["TELEFONE_EXT"]       := cEmpty
        jCustomerData["INDICATIVO_NIF"]     := cEmpty
        jCustomerData["NIF"]                := cEmpty
        jCustomerData["FORMA_TRIBUTACAO"]   := cEmpty
        jCustomerData["TIPO_PESSOA_EXT"]    := cEmpty
        jCustomerData["T003AB"] := {}
    endIf
    restArea(aAreaAI0)
    restArea(aAreaSA1)
    restArea(aArea)

return jCustomerData

//-------------------------------------------------------------------
/*{Protheus.doc} getSupplierData
    @description Monta o Json com dados do Fornecedor.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 23/04/2025
    @return
*/
//-------------------------------------------------------------------
method getSupplierData() as json class DataBlockT003
    local jSupplierData := jsonObject():new() as json
    local aT003         := {} as array
    local aT003AB       := {} as array
    local aArea         := {} as array
    local aAreaSA2      := {} as array
    local aAreaDKE      := {} as array
    local aGetAddress   := {} as array
    local aFkjDataBlock := {} as array
    local cEmpty        := "" as character
    local cCountryCode  := "" as character
    local cCnpj         := "" as character
    local cCpf          := "" as character
    local cTypePerson   := "" as character
    local cCityCode     := "" as character
    local cAddress      := "" as character
    local cAddressNum   := "" as character
    local cTypePersonEx := "" as character
    local cCprbTax      := "0" as character
    local cSportsAssoc  := "2" as character
    local cNifIndicator := "" as character
    local cExemptImmun  := "" as character
    local nCounter      := 0 as numeric

    aArea    := getArea()
    aAreaSA2 := SA2->(getArea())
    aAreaDKE := DKE->(getArea())

    dbSelectArea('SA2')
    SA2->(dbSetOrder(1)) //A2_FILIAL+A2_COD+A2_LOJA
    if SA2->(dbSeek(xFilial('SA2') + self:cParticipantCode + self:cParticipantUnit))
        if alltrim(SA2->A2_COD) == alltrim(self:cMvUniao)
            return jSupplierData
        endIf
        
        self:loadSupplierDependentsStatement()

        while !(self:cSupplierDependentsAlias)->(eof())
            aadd(aT003AB,{"COD_DEPENDENTE"  : (self:cSupplierDependentsAlias)->DHT_COD;
                            ,"CPF"   : (self:cSupplierDependentsAlias)->DHT_CPF;
                            ,"NOME" : (self:cSupplierDependentsAlias)->DHT_NOME;
                            ,"REL_DEPENDENCIA": (self:cSupplierDependentsAlias)->DHT_RELACA})

            (self:cSupplierDependentsAlias)->(dbSkip())
        endDo

        if empty(SA2->A2_CODPAIS)
            cCountryCode := ''
        else
            cCountryCode := padl(allTrim(SA2->A2_CODPAIS),5,"0")
        endIf

        If SA2->A2_TIPO == "F"
            cCpf := SA2->A2_CGC 
            cTypePerson := "1"
        ElseIf SA2->A2_TIPO == "J" .And. SA2->A2_IRPROG == "1"
            cCpf := SA2->A2_CPFIRP 
            cTypePerson := "1"			
        ElseIf SA2->A2_TIPO == "J"
            cCnpj := SA2->A2_CGC
            cTypePerson := "2"
        Else
            cCpf := ""
            cCnpj := ""
            cTypePerson := "3"
        EndIf

        if SA2->A2_EST == "EX"
            cCityCode := "99999"
        else
            cCityCode := SA2->A2_COD_MUN
        endIf

        aGetAddress := self:getAddressNumber( SA2->A2_END, SA2->A2_EST )

        cAddress    := aGetAddress[1]
        cAddressNum := aGetAddress[2]

        if SA2->A2_CPRB == CPRB_TAX_YES
            cCprbTax := SA2->A2_CPRB
        endIf

        if SA2->A2_DESPORT == SPORTS_ASSOC_YES
            cSportsAssoc := SA2->A2_DESPORT
        endIf

        if !Empty(SA2->A2_NIFEX)
            cNifIndicator := "1"
        elseIf SA2->A2_MOTNIF == EXEMPTED_FROM_NIF
            cNifIndicator := '2'
        elseIf SA2->A2_MOTNIF == COUNTRY_DOESNT_DEMAND_NIF
            cNifIndicator := '3'
        else
            cNifIndicator := SA2->A2_MOTNIF
        endIf

        DbSelectArea("DKE") 
        DKE->(DBSetOrder(1)) //DKE_FILIAL+DKE_COD+DKE_LOJA
        if DKE->(dbSeek( SA2->(A2_FILIAL + A2_COD + A2_LOJA)))
            cExemptImmun    := DKE->DKE_ISEIMU
            if cTypePerson == "3"
                cTypePersonEx   := DKE->DKE_PEEXTE
            endIf
        Endif
        If cExemptImmun == NOT_EXEMPT
            cExemptImmun := ""
        EndIf

        aadd(aT003,{"COD_PART"          : "F"+ allTrim(SA2->(A2_COD + A2_LOJA)),;
                    "NOME"              : SA2->A2_NOME,;
                    "COD_PAIS"          : cCountryCode,;
                    "CNPJ"              : cCnpj,;
                    "CPF"               : cCpf,;
                    "IE"                : SA2->A2_INSCR,;
                    "COD_MUN"           : cCityCode,;
                    "SUFRAMA"           : cEmpty,;
                    "TP_LOGR"           : cEmpty,;
                    "ENDERECO"          : cAddress,;
                    "NUM"               : cAddressNum,;
                    "COMPLEM_END"       : SA2->A2_COMPLEM,;
                    "TP_BAIRRO"         : cEmpty,;
                    "BAIRRO"            : SA2->A2_BAIRRO,;
                    "UF"                : SA2->A2_EST,;
                    "CEP"               : SA2->A2_CEP,;
                    "DDD"               : SA2->A2_DDD,;
                    "FONE"              : SA2->A2_TEL,;
                    "DDD"               : SA2->A2_DDD,;
                    "FAX"               : SA2->A2_FAX,;
                    "EMAIL"             : SA2->A2_EMAIL,;
                    "DT_INCLUSAO"       : cEmpty,;
                    "TP_PESSOA"         : cTypePerson,;
                    "RAMO_ATIV"         : cEmpty,;
                    "COD_INST_ANP"      : cEmpty,;
                    "COD_ATIV"          : cEmpty,;
                    "COD_PAIS_EXT"      : SA2->A2_PAISEX,;
                    "LOGRAD_EXT"        : SA2->A2_LOGEX,;
                    "NR_LOGRAD_EXT"     : SA2->A2_NUMEX,;
                    "COMPLEM_EXT"       : SA2->A2_COMPLR,;
                    "BAIRRO_EXT"        : SA2->A2_BAIEX,;
                    "NOME_CIDADE_EXT"   : SA2->A2_CIDEX,;
                    "COD_POSTAL_EXT"    : SA2->A2_POSEX,;
                    "DT_LAUDO_MOLEST_GRAVE" : cEmpty,;
                    "REL_FONTE_PAG_RESID_EXTERIOR"  : SA2->A2_BREEX,;
                    "INSCR_MUNICIPAL"   : SA2->A2_INSCRM,;
                    "SIMPLES_NACIONAL"  : cEmpty,;
                    "ENQUADRAMENTO"     : cEmpty,;
                    "OBSOLETO"          : cEmpty,;
                    "INDCPRB"           : cCprbTax,;
                    "CODTRI"            : cEmpty,;
                    "EXECPAA"           : cEmpty,;
                    "IND_ASSOC_DESPORT" : cSportsAssoc,;
                    "CONTRIBUINTE"      : SA2->A2_CONTRIB,;
                    "INDOPCCP"          : SA2->A2_INDCP,;
                    "ISENCAO_IMUNIDADE" : cExemptImmun,;
                    "ESTADO_EXT"        : SA2->A2_ESTEX,;
                    "TELEFONE_EXT"      : SA2->A2_TELRE,;
                    "INDICATIVO_NIF"    : cNifIndicator,;
                    "NIF"               : SA2->A2_NIFEX,;
                    "FORMA_TRIBUTACAO"  : SA2->A2_TRBEX,;
                    "TIPO_PESSOA_EXT"   : cTypePersonEx})

        aFkjDataBlock := self:getFkjParticipant(aT003)

        for nCounter := 1 to len(aFkjDataBlock)
            aadd(aT003,aFkjDataBlock[nCounter])
        next

        if len(aT003AB) > 0
            aT003[1]["T003AB"] := aT003AB
        endIf

        jSupplierData["T003"] := aT003
    endIf
    restArea(aAreaDKE)
    restArea(aAreaSA2)
    restArea(aArea)
return jSupplierData

//-------------------------------------------------------------------
/*{Protheus.doc} getAddressNumber
    @description Utiliza a função FisGetEnd do Fiscal para separar o endereço, e retorna o endereço e o número.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 23/04/2025
    @return
*/
//-------------------------------------------------------------------
method getAddressNumber(cAddress as character, cState as character) as array class DataBlockT003
    local aGetAddress   := {} as array
    local cAddressNumber := "SN" as character
    local aAddress := {} as array

    default cAddress := ""
    default cState   := ""

    aGetAddress := FisGetEnd( cAddress, cState )

    aadd(aAddress,aGetAddress[1])

    if !empty( aGetAddress[2])
        cAddressNumber := aGetAddress[3]
    endIf

    aadd(aAddress,cAddressNumber)

return aAddress

//-------------------------------------------------------------------
/*{Protheus.doc} setHasDataBlock
    @description Define o conteúdo da propriedade self:lHasDataBlock.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 17/04/2025
    @return
*/
//-------------------------------------------------------------------
method setHasDataBlock(lHasDataBlock as logical) class DataBlockT003
    self:lHasDataBlock := lHasDataBlock
return

//-------------------------------------------------------------------
/*{Protheus.doc} getHasDataBlock
    @description Retorna o conteúdo da propriedade self:lHasDataBlock.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 17/04/2025
    @return
*/
//-------------------------------------------------------------------
method getHasDataBlock() as logical class DataBlockT003
return self:lHasDataBlock

//-------------------------------------------------------------------
/*{Protheus.doc} getFkjParticipant
    @description Retorna o bloco T003 com os dados da FKJ em cenários onde o código do fornecedor tem cadastro de IR Progressivo.
    @type Method
    @version 12.1.2410
    @author guilhermed.santos
    @since 17/04/2025
    @return
*/
//-------------------------------------------------------------------
method getFkjParticipant(aT003DataBlock as array) as array class DataBlockT003
    local aArea         := {} as array
    local aAreaFkj      := {} as array
    local aFkjDataBlock := {} as array
    local jFkjDataBlock := Nil as json
    
    default aT003DataBlock := {}    
    
    aArea := getArea()
    aAreaFkj := FKJ->(getArea())
    
    dbSelectArea("FKJ")
    FKJ->(dbSetOrder(1)) //FKJ_FILIAL+FKJ_COD+FKJ_LOJA+FKJ_CPF
    if FKJ->(dbSeek(xFilial("FKJ")+SA2->(A2_COD+A2_LOJA)))
        while !FKJ->(eof()) .and. FKJ->(FKJ_COD+FKJ_LOJA) == SA2->(A2_COD+A2_LOJA)
            jFkjDataBlock := jsonObject():new()
            jFkjDataBlock:fromJson(aT003DataBlock[1]:tojson())

            jFkjDataBlock["COD_PART"] := "F" + FKJ->FKJ_CPF
            jFkjDataBlock["NOME"]     := FKJ->FKJ_NOME
            jFkjDataBlock["CNPJ"]     := ""
            jFkjDataBlock["CPF"]      := FKJ->FKJ_CPF
            
            aadd(aFkjDataBlock, jFkjDataBlock)

            FKJ->(dbSkip())
        endDo
    endIf
    
    restArea(aAreaFkj)
    restArea(aArea)
return aFkjDataBlock
