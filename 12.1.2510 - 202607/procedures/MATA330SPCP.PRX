#INCLUDE "TBICONN.CH"
#INCLUDE "FILEIO.CH"
#INCLUDE "FWEVENTVIEWCONSTS.CH"
#INCLUDE "Fwlibversion.ch"
#INCLUDE "MATA330.CH"
#INCLUDE "PROTHEUS.CH"

/*/{Protheus.doc} M330INC2CP NOVO MAT061
	Função auxiliar para montagem da variável cBuffer, durante a
	execução da função EngOn19Compile
@type  Function
@author SQUAD ENTRADAS
@since 28/10/2025
/*/
Function P330INC2CP(cProcesso as character, cEmpresa as character, cProcName as character, cBuffer as character, cError as character)

Local aParte	:= {}	as array
Local cAux		:= ""	as character
Local nParte	:= 0	as numeric
Local nMoeda	:= 0	as numeric
Local cOldPE 	:= ""   as character
Local lProcCP   := SuperGetMV('MV_M330SPC',.F.,.F.) .or. GetRpoRelease() >= '12.1.2610'

if HasMA330CP()
	If lProcCP
		aParte := ExecBlock('MA330CP')
		cAux := "declare @cFil_SC2     Char("+cvaltochar(LEN(fwxfilial('SC2')))+")" + CRLF
		cAux += "declare @nMaxRecnoSC2 Integer" + CRLF
		cAux += "declare @nRec         Integer" + CRLF
		cAux += "begin" + CRLF
		cAux += "exec XFILIAL_19_"+cEmpAnt+" 'SC2' , @IN_FILIALCOR , @cFil_SC2 output" + CRLF
		cAux += "select @nMaxRecnoSC2 = coalesce ( max ( R_E_C_N_O_ ), 0 )" + CRLF
		cAux += "from SC2###" + CRLF
		cAux += "where C2_FILIAL = @cFil_SC2 and D_E_L_E_T_ = ' '" + CRLF	
		cAux += "select @nRec = coalesce ( min ( R_E_C_N_O_ ), 0 )" + CRLF	
		cAux += "from SC2###" + CRLF
		cAux += "where C2_FILIAL = @cFil_SC2 and D_E_L_E_T_ = ' '" + CRLF
		cAux += "while @nRec <= @nMaxRecnoSC2" + CRLF
		cAux += "begin" + CRLF
		cAux += "update SC2###" + CRLF
		cAux += "  set "		
		for nParte := 1 To Len(aParte) + 1
			If nParte > 1
				cAux += "," + CRLF
			EndIf
			for nMoeda := 1 To 5
				cAux += "C2_CPF" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " = C2_CPI" + StrZero(nParte, 2) + StrZero(nMoeda, 2)+","
                cAux += "C2_APF" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " = C2_API" + StrZero(nParte, 2) + StrZero(nMoeda, 2)				
				if nParte <= Len(aParte) +1 .and. nMoeda < 5
					cAux += ',' + CRLF
				endif
			next nMoeda
		next nParte
		cAux += CRLF
		cAux += "where R_E_C_N_O_ >= @nRec and R_E_C_N_O_ < @nRec + 1024 and " + CRLF
		cAux += "C2_FILIAL = @cFil_SC2 and D_E_L_E_T_ = ' ' and " + CRLF
		cAux += "(C2_DATRF = ' ' or C2_DATRF >= @IN_DINICIO) " + CRLF
		cAux += "select @nRec = @nRec + 1024" + CRLF
		cAux += "end" + CRLF
		cAux += "end" + CRLF
		cBuffer := StrTran(cBuffer, '##BODY##', cAux)
	Else
		cOldPE := "declare @nRec Integer" + CRLF
		cOldPE += "begin" + CRLF
		cOldPE += "select @nRec  = 0" + CRLF
		cOldPE += "end" + CRLF
		cBuffer := StrTran(cBuffer, '##BODY##', cOldPE)
	EndIf 
Else
	cOldPE := "declare @nRec Integer" + CRLF
	cOldPE += "begin" + CRLF
	cOldPE += "select @nRec  = 0" + CRLF
	cOldPE += "end" + CRLF
	cBuffer := StrTran(cBuffer, '##BODY##', cOldPE)
EndIf


FwFreeArray(aParte)

return cBuffer


/*/{Protheus.doc} M330INB2CP NOVO MAT062
	Função auxiliar para montagem da variável cBuffer, durante a
	execução da função EngOn19Compile
@type  Function
@author SQUAD ENTRADAS
@since 28/10/2025
/*/
Function P330INB2CP(cProcesso as character, cEmpresa as character, cProcName as character, cBuffer as character, cError as character)

Local aParte	:= {}	as array
Local cAux		:= ""	as character
Local nParte	:= 0	as numeric
Local nMoeda	:= 0	as numeric
Local cOldPE 	:= ""   as character
Local lProcCP   := SuperGetMV('MV_M330SPC',.F.,.F.) .or. GetRpoRelease() >= '12.1.2610'

if HasMA330CP()
	If lProcCP
		aParte := ExecBlock('MA330CP')
		for nMoeda := 1 To 5
			cAux += "DECLARE @nB2_VFIM" + cvaltochar(nMoeda) + "	FLOAT " + CRLF
		next nMoeda
		for nParte := 1 To Len(aParte) + 1
			for nMoeda := 1 To 5
				cAux += "DECLARE @nB9_CP" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " FLOAT " + CRLF
			next nMoeda
		next nParte
		for nParte := 1 To Len(aParte) + 1
			for nMoeda := 1 To 5
				cAux += "DECLARE @nB9_CPM" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " FLOAT " + CRLF
			next nMoeda
		next nParte
		cAux += "declare @nQtd       Float" + CRLF
		cAux += "declare @cFil_SB9     Char("+cvaltochar(LEN(fwxfilial('SB9')))+")" + CRLF
		cAux += "declare @iRecnoTRT    Integer" + CRLF
		cAux += "declare @cFilAux      Char("+cvaltochar(LEN(fwxfilial('SB9')))+")" + CRLF
		cAux += "begin" + CRLF
		cAux += "  exec XFILIAL_19_"+cEmpAnt+" 'SB9' , @IN_FILIALCOR , @cFil_SB9 output" + CRLF
		cAux += "  update TR2"+cEmpAnt+"SP " + CRLF
		cAux += "  set " + CRLF
		for nParte := 1 To Len(aParte) + 1
			If nParte > 1
				cAux += "," + CRLF
			EndIf
			for nMoeda := 1 To 5
				cAux += "	B2_CPF" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " = 0, "
				cAux += "B2_CP" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " = 0 "
				if nParte <= Len(aParte) +1 .and. nMoeda < 5
					cAux += ","
				endif
			next nMoeda
		next nParte	
		cAux += CRLF	
		cAux += "  where R_E_C_N_O_ = @IN_RECNOSB2" + CRLF	
		cAux += "  select " + CRLF		
		for nParte := 1 To Len(aParte) + 1
			If nParte > 1
				cAux += ", " + CRLF
			EndIf
			for nMoeda := 1 To 5
				cAux += "	@nB9_CP" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " = Coalesce (B9_CP"+ StrZero(nParte, 2) + StrZero(nMoeda, 2)+",0), " + CRLF
				cAux += " @nB9_CPM" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " = Coalesce (B9_CPM"+ StrZero(nParte, 2) + StrZero(nMoeda, 2)+",0)"
				if nParte <= Len(aParte) +1 .and. nMoeda < 5
					cAux += ', ' + CRLF
				endif
			next nMoeda
		next nParte	
		cAux += "from SB9### " + CRLF
		cAux += "where B9_FILIAL = @cFil_SB9 and B9_COD = @IN_COD and B9_LOCAL = @IN_LOCAL and" + CRLF
		cAux += "  B9_DATA = ( SELECT MAX(B9_DATA) FROM SB9###" + CRLF
 		cAux += "  			   WHERE B9_FILIAL = @cFil_SB9 and B9_COD = @IN_COD and" + CRLF
 		cAux += "  			   B9_LOCAL = @IN_LOCAL and B9_DATA <= @IN_DINICIO and D_E_L_E_T_ = ' ')" + CRLF
		cAux += "  AND D_E_L_E_T_ = ' '" + CRLF
		for nParte := 1 To Len(aParte) + 1
			for nMoeda := 1 To 5
				cAux += "select @nB9_CP" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " = Coalesce (@nB9_CP"+ StrZero(nParte, 2) + StrZero(nMoeda, 2)+",0) " + CRLF
				cAux += "select @nB9_CPM" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " = Coalesce (@nB9_CPM"+ StrZero(nParte, 2) + StrZero(nMoeda, 2)+",0) " + CRLF
			next nMoeda
		next nParte
		cAux += "IF @IN_CUSUNIF = '1' or @IN_CUSUNIF = '2'" + CRLF
		cAux += "  begin" + CRLF
		cAux += "     IF @IN_CUSUNIF = '1'" + CRLF
		cAux += "		begin" + CRLF
		cAux += "    		select @cFilAux = @IN_FILIALCOR" + CRLF
		cAux += "		end" + CRLF
		cAux += "	else" + CRLF
		cAux += "		begin" + CRLF
		cAux += "			select @cFilAux = '"+SPACE(len(fwxfilial('SB9')))+"'" + CRLF
		cAux += "		end" + CRLF
		cAux += "		begin" + CRLF
		cAux += "  			select @iRecnoTRT = coalesce(MAX(R_E_C_N_O_), 0)" + CRLF
		cAux += "  			from TRT"+cEmpANT+"SP" + CRLF
		cAux += "  			where TRB_FILIAL = @cFilAux" + CRLF
		cAux += "  			and TRB_COD = @IN_COD" + CRLF
		cAux += "  			if @iRecnoTRT = 0" + CRLF
		cAux += "    			begin" + CRLF
		cAux += "      				select @iRecnoTRT = coalesce (MAX(R_E_C_N_O_), 0)" + CRLF
 		cAux += "      				FROM TRT"+cEmpANT+"SP" + CRLF
 		cAux += "      				select @iRecnoTRT = @iRecnoTRT + 1" + CRLF
 		cAux += "      				insert into TRT"+cEmpANT+"SP (TRB_FILIAL, TRB_COD, R_E_C_N_O_)" + CRLF
 		cAux += "      				values (@cFilAux, @IN_COD, @iRecnoTRT)" + CRLF
 		cAux += "    			end" + CRLF
 		cAux += "  				select @nQtd = coalesce (TRB_QFIM, 0) " + CRLF
 		cAux += "  				from TRT"+cEmpANT+"SP" + CRLF
 		cAux += "  				WHERE R_E_C_N_O_ = @iRecnoTRT" + CRLF
 		cAux += "  				IF @nQtd = 0" + CRLF
 		cAux += "    				begin" + CRLF
 		cAux += "        				select @nQtd = 1" + CRLF
 		cAux += "     				end" + CRLF
 		cAux += "  				update TRT"+cEmpANT+"SP" + CRLF
 		cAux += "  				set "
		for nParte := 1 To Len(aParte) + 1
			If nParte > 1
				cAux += "," + CRLF
			EndIf
			for nMoeda := 1 To 5
				cAux += "TRB_VF" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " = TRB_VF" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " + @nB9_CP" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + ", " + CRLF
				cAux += "TRB_CP" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " = (TRB_VF" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " + @nB9_CP" + StrZero(nParte, 2) + StrZero(nMoeda, 2)+") / @nQtd "
				if nParte <= Len(aParte) +1 .and. nMoeda < 5
					cAux += "," + CRLF
				endif
			next nMoeda
		next nParte		
		cAux += "   where R_E_C_N_O_ = @iRecnoTRT" + CRLF
		cAux += "			end" + CRLF
		cAux += "		end" + CRLF
		cAux += "  update TR2"+cEmpAnt+"SP " + CRLF
		cAux += "  set "
		for nParte := 1 To Len(aParte) + 1
			If nParte > 1
				cAux += "," + CRLF
			EndIf
			for nMoeda := 1 To 5
				cAux += "B2_CPF" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " = @nB9_CP" + StrZero(nParte, 2) + StrZero(nMoeda, 2) 
				if nParte <= Len(aParte) +1 .and. nMoeda < 5
					cAux += "," + CRLF
				endif
			next nMoeda
		next nParte		
		cAux += "   where R_E_C_N_O_ = @IN_RECNOSB2" + CRLF
		cAux += "   select @nQtd = coalesce(B2_QFIM, 0)" + CRLF
		cAux += "   FROM TR2"+cEmpAnt+"SP " + CRLF
		cAux += "   where R_E_C_N_O_ = @IN_RECNOSB2" + CRLF
		cAux += "   IF @nQtd = 0" + CRLF
		cAux += "      BEGIN" + CRLF
		cAux += "      UPDATE TR2"+cEmpAnt+"SP " + CRLF
		cAux += "      SET   " 
		for nParte := 1 To Len(aParte) + 1
			If nParte > 1
				cAux += "," + CRLF
			EndIf
			for nMoeda := 1 To 5
				cAux += "		B2_CP" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " = @nB9_CPM" + StrZero(nParte, 2) + StrZero(nMoeda, 2)
				if nParte <= Len(aParte) +1 .and. nMoeda < 5
					cAux += "," + CRLF
				endif
			next nMoeda
		next nParte	
		cAux += CRLF
		cAux += "      WHERE R_E_C_N_O_ = @IN_RECNOSB2" + CRLF
		cAux += "	end" + CRLF
		cAux += "else" + CRLF
		cAux += "	begin" + CRLF
		cAux += "		update TR2"+cEmpAnt+"SP " + CRLF
		cAux += "    	set "
		for nParte := 1 To Len(aParte) + 1
			If nParte > 1
				cAux += "," + CRLF
			EndIf
			for nMoeda := 1 To 5
				cAux += "B2_CP" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " = @nB9_CP" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " / @nQtd"
				if nParte <= Len(aParte) +1 .and. nMoeda < 5
					cAux += "," + CRLF
				endif
			next nMoeda
		next nParte		
		cAux += "   where R_E_C_N_O_ = @IN_RECNOSB2" + CRLF
		cAux += "  end" + CRLF
		cAux += "end" + CRLF
		cBuffer := StrTran(cBuffer, '##BODY##', cAux)
	Else
		cOldPE := "declare @iRecnoTRT     integer" + CRLF
		cOldPE += "begin" + CRLF
		cOldPE += "select @iRecnoTRT = 0" + CRLF
		cOldPE += "end" + CRLF
		cBuffer := StrTran(cBuffer, '##BODY##', cOldPE)
	EndIf
Else
	cOldPE := "declare @iRecnoTRT     integer" + CRLF
	cOldPE += "begin" + CRLF
	cOldPE += "select @iRecnoTRT = 0" + CRLF
	cOldPE += "end" + CRLF
	cBuffer := StrTran(cBuffer, '##BODY##', cOldPE)
endif

FwFreeArray(aParte)

Return cBuffer

/*/{Protheus.doc} HasMA330CP
    Retorna se o ponto de entrada MA330CP está compilado, possui regras válidas
    e se os campos existem no dicionário
    @type Function
    @author Squad Entradas
    @since 23/10/2025
    @version 12.1.2510
/*/
Static Function HasMA330CP()

Local aRegraPE	:= {}						as array
Local lMA330CP	:= ExistBlock('MA330CP')	as logical
Local lRet		:= .F.						as logical

    //Avalia se utiliza o ponto de entrada MA330CP
    if lMA330CP
        aRegraPE := ExecBlock("MA330CP",.F.,.F.)
        if valType(aRegraPE) <> "A" .or. Len(aRegraPE) = 0 
            aRegraPE := {}
        endif
		if Len(aRegraPE) > 0
			lRet := MA330AvlCp(aRegraPE,{})
		endif
		If !lret 
			Msgalert (OemToAnsi(STR0280))
		EndIf 
	EndIf
	FwFreeArray(aRegraPE)

Return lRet
