#include "msobject.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#Include "TOTVS.CH"

namespace totvs.protheus.backoffice.fin.gesplan

//-------------------------------------------------------------------
/*/{Protheus.doc} FinGesplanProcedure
    @description Classe que incorpora as necessidades para intalação e 
    execução das procedures do pacote 33 do SPManager (Integração Gesplan). 
    Será a Super classe das Procedures do Financeiro Gesplan.
    @author fabioh.andrade@totvs.com.br
    @since 09/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
class FinGesplanProcedure

    protected data cBuffer as character
    protected data cDBMS as character
    protected data cEnterPointType as character
    protected data cOriginFlexFields as character
    protected data cTableFlexFields as character
    protected data cEnterpriseCode as character
    protected data jParseGeneralPre as json
    protected data jParseGeneralPos as json
    protected data jParseDatabase as json
    protected data jSintaxDictionary as json
    protected data lF7OIsInDic as logical
    protected data lIsOnCompile as logical
    protected data lIsPosCompile as logical
    protected data lIsExecProced as logical
    protected data aTablesList as array
    protected data aTableSizes as array

    public method new(cBuffer as character, cEnterPointType as character, cEnterpriseCode as character) as object
    protected method setBuffer(cBuffer as character)
    protected method getBuffer() as character
    protected method verifyF7OInDic()
    protected method parseGeneral()
    protected method parseOracle()
    protected method parseSQLServer() 
    protected method parsePostgres()
    protected method execParse() as character
    protected method parseFlexFields()
    protected method loadSintaxes()
    protected method loadParsers()
    protected method loadParserGeneralPre()
    protected method loadParserGeneralPos()
    protected method loadParserOracle()
    protected method loadParserSQLServer()
    protected method loadParserPostgres()
    protected method loadTableSizes()

endClass


//-------------------------------------------------------------------
/*/{Protheus.doc} new
    @author fabioh.andrade@totvs.com.br
    @since 09/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method new(cBuffer as character, cEnterPointType as character, cEnterpriseCode as character) as object class FinGesplanProcedure
    self:setBuffer(cBuffer)
    self:verifyF7OInDic()
    self:cDBMS := UPPER(TcGetDb())
    self:cOriginFlexFields := ""
    self:cTableFlexFields := ""
    self:lIsOnCompile := (cEnterPointType == "ONCOMPILE")
    self:lIsPosCompile := (cEnterPointType == "POSCOMPILE")
    self:lIsExecProced := (cEnterPointType == "EXECPROCED")
    self:cEnterPointType := cEnterPointType
    self:cEnterpriseCode := cEnterpriseCode
    self:jParseGeneralPre := JSONObject():new()
    self:jParseGeneralPos := JSONObject():new()
    self:jParseDatabase := JSONObject():new()
    self:jSintaxDictionary := JSONObject():new()

    if self:lIsOnCompile .Or. self:lIsPosCompile
        self:loadSintaxes()
        self:loadParsers()
    endIf

return self


//-------------------------------------------------------------------
/*/{Protheus.doc} setBuffer
    @author fabioh.andrade@totvs.com.br
    @since 09/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method setBuffer(cBuffer as character) class FinGesplanProcedure
    self:cBuffer := cBuffer
return 

//-------------------------------------------------------------------
/*/{Protheus.doc} getBuffer
    @author fabioh.andrade@totvs.com.br
    @since 14/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method getBuffer() as character class FinGesplanProcedure
return self:cBuffer

//-------------------------------------------------------------------
/*/{Protheus.doc} verifyF7OInDic
    @author fabioh.andrade@totvs.com.br
    @since 09/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method verifyF7OInDic() class FinGesplanProcedure
    self:lF7OIsInDic := AliasIndic("F7O")
return 

//-------------------------------------------------------------------
/*/{Protheus.doc} loadParsers
    @author fabioh.andrade@totvs.com.br
    @since 09/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method loadParsers() class FinGesplanProcedure
    self:loadParserGeneralPre()
    if self:cDBMS == "ORACLE"
        self:loadParserOracle()
    elseIf self:cDBMS == "POSGRES"
        self:loadParserPostgres()
    else
        self:loadParserSQLServer()
    endIf
    self:loadParserGeneralPos()
return 

//-------------------------------------------------------------------
/*/{Protheus.doc} loadParserOracle
    @author fabioh.andrade@totvs.com.br
    @since 09/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method loadParserOracle() class FinGesplanProcedure
    self:jParseDatabase[self:cEnterPointType] := {}
    if self:lIsPosCompile
        aAdd( self:jParseDatabase[self:cEnterPointType], { "left join CT2###  ON CT2_FILIAL  = ' '", " " } )
    endIf
return 

/*/{Protheus.doc} loadParserPostgres
    @author fabioh.andrade@totvs.com.br
    @since 09/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method loadParserPostgres() class FinGesplanProcedure
    self:jParseDatabase[self:cEnterPointType] := {}
    if self:lIsPosCompile
        aAdd( self:jParseDatabase[self:cEnterPointType], { "left join CT2###  ON CT2_FILIAL  = ' '", " " } )
    endIf
return 

/*/{Protheus.doc} loadParserSQLServer
    @author fabioh.andrade@totvs.com.br
    @since 09/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method loadParserSQLServer() class FinGesplanProcedure
    self:jParseDatabase[self:cEnterPointType] := {}
    if self:lIsPosCompile
        aAdd( self:jParseDatabase[self:cEnterPointType], { "left join CT2###  ON CT2_FILIAL  = ' '" , " WITH (READCOMMITTED) "} )
    endIf
return 

/*/{Protheus.doc} execParse
    @author fabioh.andrade@totvs.com.br
    @since 09/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method execParse() class FinGesplanProcedure
    local nX := 1 as numeric
    local nKeyText := 1 as numeric
    local nChangeText := 2 as numeric

    //Executa Parse Geral - Pre
    for nX := 1 to Len(self:jParseGeneralPre[self:cEnterPointType])
        self:cBuffer := StrTran(self:cBuffer,self:jParseGeneralPre[self:cEnterPointType][nX][nKeyText], self:jParseGeneralPre[self:cEnterPointType][nX][nChangeText])
    next nX

    if self:lIsOnCompile .and. self:lF7OIsInDic
        self:parseFlexFields()
    endIf

    //Executa Parse por banco
    if Len(self:jParseDatabase[self:cEnterPointType]) > 0
        for nX := 1 to Len(self:jParseDatabase[self:cEnterPointType])
            self:cBuffer := StrTran(self:cBuffer,self:jParseDatabase[self:cEnterPointType][nX][nKeyText], self:jParseDatabase[self:cEnterPointType][nX][nChangeText])
        next nX
    endIf

    //Executa Parse do dicionário de funções específicas
    for nX := 1 to Len(self:jSintaxDictionary[self:cDBMS])
        self:cBuffer := StrTran(self:cBuffer,self:jSintaxDictionary[self:cDBMS][nX][nKeyText], self:jSintaxDictionary[self:cDBMS][nX][nChangeText])
    next nX

    //Executa Parse Geral - Pos
    for nX := 1 to Len(self:jParseGeneralPos[self:cEnterPointType])
        self:cBuffer := StrTran(self:cBuffer,self:jParseGeneralPos[self:cEnterPointType][nX][nKeyText], self:jParseGeneralPos[self:cEnterPointType][nX][nChangeText])
    next nX

return


/*/{Protheus.doc} execParse
    @author fabioh.andrade@totvs.com.br
    @since 09/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method loadSintaxes() class FinGesplanProcedure
    self:jSintaxDictionary["ORACLE"] := {}
    self:jSintaxDictionary["POSTGRES"] := {}
    self:jSintaxDictionary["MSSQL"] := {}

    if self:cDBMS == "MSSQL"
        aAdd(self:jSintaxDictionary["MSSQL"], {"$VARCHAR","VARCHAR"})
        aAdd(self:jSintaxDictionary["MSSQL"], {"$Substring", "Substring"})
        aAdd(self:jSintaxDictionary["MSSQL"], {"$Replicate","Replicate"})
        aAdd(self:jSintaxDictionary["MSSQL"], {"$Concat","+"})
        aAdd(self:jSintaxDictionary["MSSQL"], {"$VariableIn","@"})
        aAdd(self:jSintaxDictionary["MSSQL"], {"$Variable","@"})
    endIf

    if self:cDBMS $ "ORACLE|POSTGRES"
        if self:cDBMS == "ORACLE"
            aAdd(self:jSintaxDictionary[self:cDBMS], {"$VARCHAR","VARCHAR2(10)"})
        elseIf self:cDBMS == "POSTGRES"
            aAdd(self:jSintaxDictionary[self:cDBMS], {"$VARCHAR","VARCHAR"})
        endIf
        aAdd(self:jSintaxDictionary[self:cDBMS], {"$Substring", "Substr"})
        aAdd(self:jSintaxDictionary[self:cDBMS], {"$Replicate","RPAD"})
        aAdd(self:jSintaxDictionary[self:cDBMS], {"$Concat"," || "})
        aAdd(self:jSintaxDictionary[self:cDBMS], {"$VariableIn","v"})
        aAdd(self:jSintaxDictionary[self:cDBMS], {"$Variable",""})
    endIf

return 


/*/{Protheus.doc} loadParserSQLServer
    @author fabioh.andrade@totvs.com.br
    @since 09/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method loadParserGeneralPre() class FinGesplanProcedure
    local aSM0 := FWLoadSM0()  as Array 
    local nX := 1 as Numeric
    local nTamSM0 := Len(aSM0) as Numeric
    local nGrupEmp := 20 as Numeric
    local nCompani := 20 as Numeric
    local nCodUnid  := 20 as Numeric
    local nCodFil  := 20 as Numeric

    for nX:= 1 to nTamSM0            
        if Trim(aSM0[nX,1]) == Trim(self:cEnterpriseCode)
            nGrupEmp  := Len(aSM0[nX,1])  //Grupo de empresa ex "T1"
            nCompani  := Len(aSM0[nX,3])  //Compania ex  "D "
            nCodUnid  := Len(aSM0[nX,4])  //Cod. Empresa ex "MG"
            nCodFil   := Len(aSM0[nX,5])  //Cod. Filial  ex "01"
            exit
        endIf
    Next nX

    if ( nCompani < 1 ) 
        nCompani := 1
    endIf
    
    if ( nCodUnid < 1 ) 
        nCodUnid := 1
    endIf

    self:jParseGeneralPre["ONCOMPILE"]  := {}
    self:jParseGeneralPre["POSCOMPILE"] := {}

    //ONCOMPILE
    if self:lIsOnCompile
        aAdd(self:jParseGeneralPre["ONCOMPILE"], { "'##GROUPEMPRESA'",  cValTochar(nGrupEmp) } )
        aAdd(self:jParseGeneralPre["ONCOMPILE"], { "'##COMPANIA'"    ,  cValTochar(nCompani) } )
        aAdd(self:jParseGeneralPre["ONCOMPILE"], { "'##COD_UNID'"    ,  cValTochar(nCodUnid) } )
        aAdd(self:jParseGeneralPre["ONCOMPILE"], { "'##COD_FIL'"     ,  cValTochar(nCodFil) } )
        aAdd(self:jParseGeneralPre["ONCOMPILE"], { "'F7I_DSCMDA'"    ,  cValTochar(LEN(X6Conteud())) } )
        aAdd(self:jParseGeneralPre["ONCOMPILE"], { "'F7I_DSCMDB'"    ,  cValTochar(LEN(X6Conteud())) } )
    EndIf

    if self:lIsPosCompile
        aAdd(self:jParseGeneralPre["POSCOMPILE"], { "121", '127' } )
        //CTE Filial
        aAdd(self:jParseGeneralPre["POSCOMPILE"], { "SELECT '##CTE_FILIAL ", " WITH MAP_FILIAL AS (" + CRLF + "XXMAPFILIAL" } )
        aAdd(self:jParseGeneralPre["POSCOMPILE"], { "XXMAPFILIAL", " SELECT map_sm0.M0_CODFIL AS MAP_FILORIG " + CRLF + "PPMAPFILIAL" + CRLF + "XXMAPFILIAL" } )
        aAdd(self:jParseGeneralPre["POSCOMPILE"], { "XXMAPFILIAL", "  FROM SYS_COMPANY map_sm0 " + CRLF + "XXMAPFILIAL" } )
        aAdd(self:jParseGeneralPre["POSCOMPILE"], { "XXMAPFILIAL", "  WHERE map_sm0.M0_CODIGO = $VariableInIN_GROUPEMPRESA " + CRLF + "XXMAPFILIAL" } )
        aAdd(self:jParseGeneralPre["POSCOMPILE"], { "XXMAPFILIAL", "        AND map_sm0.D_E_L_E_T_ = ' ' " + CRLF + "XXMAPFILIAL" } )
        aAdd(self:jParseGeneralPre["POSCOMPILE"], { "XXMAPFILIAL", "), " + CRLF })  
        //CTE Moeda
        aAdd(self:jParseGeneralPre["POSCOMPILE"], { "##MAP_MOEDA'", " MAP_MOEDA AS (" + CRLF + "XXMAP_MOEDA" } )
        aAdd(self:jParseGeneralPre["POSCOMPILE"], { "XXMAP_MOEDA", " SELECT Cast($Substring(SX6.X6_VAR,9,2) as Float) SX6_MOEDA, " + CRLF + "XXMAP_MOEDA" } )
        aAdd(self:jParseGeneralPre["POSCOMPILE"], { "XXMAP_MOEDA", "        X6_CONTEUD AS DESC_MOEDA " + CRLF + "XXMAP_MOEDA" } )
        aAdd(self:jParseGeneralPre["POSCOMPILE"], { "XXMAP_MOEDA", " FROM "+  RetSqlName("SX6") + " SX6 " + CRLF + "XXMAP_MOEDA" } )
        aAdd(self:jParseGeneralPre["POSCOMPILE"], { "XXMAP_MOEDA", " WHERE SX6.X6_VAR like 'MV_MOEDA%' " + CRLF + "XXMAP_MOEDA" } )        
        aAdd(self:jParseGeneralPre["POSCOMPILE"], { "XXMAP_MOEDA", "      AND $Substring(SX6.X6_VAR,9,1) <= '99'" + CRLF + "XXMAP_MOEDA" } )
        aAdd(self:jParseGeneralPre["POSCOMPILE"], { "XXMAP_MOEDA", "      AND SX6.D_E_L_E_T_ = ' ' " + CRLF + "XXMAP_MOEDA" } )
    endIf

return 

/*/{Protheus.doc} loadParserGeneralPos
    @author fabioh.andrade@totvs.com.br
    @since 15/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method loadParserGeneralPos() class FinGesplanProcedure
    self:jParseGeneralPos["ONCOMPILE"] := {}
    self:jParseGeneralPos["POSCOMPILE"] := {}

    //POSCOMPILE
    if self:lIsPosCompile
        aAdd(self:jParseGeneralPos["POSCOMPILE"], {  "SX6###", RetSqlName("SX6") } ) 
    endIf
return 

/*/{Protheus.doc} parseFlexFields
    @author fabioh.andrade@totvs.com.br
    @since 09/10/2025
    @version 12.1.2510
*/
//-------------------------------------------------------------------
method parseFlexFields() class FinGesplanProcedure

    local aArea	     := GetArea() as array
    Local cDeclare   := "" as character
    Local cSelCursor := "" as character
    Local cField     := "" as character
    Local cCursor    := "" as character
    Local cVariables := "" as character
    Local cInsert    := "" as character
    Local cPrincipal := "" as character

    dbSelectArea("F7O")

    F7O->(dbSetOrder(1)) 
    //F7O_FILIAL, F7O_ORIGEM, F7O_TABELA, F7O_COLUNA, R_E_C_N_O_, D_E_L_E_T_
    
    If F7O->(dbSeek(xFilial("F7O")+self:cOriginFlexFields))
        Do While F7O->(!Eof()) .And. F7O->F7O_ORIGEM == self:cOriginFlexFields
            cDeclare += ' declare @F' + F7O->F7O_COLUNA + ' char(' +  IIF(val(F7O->F7O_FLEX)>10,'100)','30)') + CRLF
            cSelCursor += ' , '+ F7O->F7O_COLUNA + ' as F7I_FLXF'+ F7O->F7O_FLEX
            If AT( '.'+ RTrim(F7O->F7O_COLUNA) , self:cBuffer ) == 0 
                If 'E2_'$ F7O->F7O_COLUNA .or. 'E1_' $ F7O->F7O_COLUNA
                    cPrincipal +=  ' , ' +  F7O->F7O_COLUNA //Lower(F7O->F7O_TABELA) +'.'+
                Else
                    cField +=  ' , ' +  F7O->F7O_COLUNA //Lower(F7O->F7O_TABELA) +'.'+
                EndIf
            EndIf 
            cCursor +=  ' , ' +'@F' + F7O->F7O_COLUNA
            cVariables +=  " , IsNull(" +'@F' + F7O->F7O_COLUNA +", ' ') "
            cInsert +=  ' ,  ' + self:cTableFlexFields + '_FLXF' + F7O->F7O_FLEX
            // usar o cCursor cVariables +=
            F7O->(dbSkip())
        EndDo
        self:cBuffer := StrTran( self:cBuffer, "--#cursorflex",  cCursor )
        self:cBuffer := StrTran( self:cBuffer, "--#insertflex",  cInsert )
        self:cBuffer := StrTran( self:cBuffer, "--#variaveisflex",  cVariables )
    EndIf
    self:cBuffer := StrTran( self:cBuffer, ",'#selectcursorflex' as cursorflex",  cSelCursor )
    self:cBuffer := StrTran( self:cBuffer, ",'#campoflex' as campoflex", cPrincipal + cField )
    self:cBuffer := StrTran( self:cBuffer, ",'#campoflexprincipal' as campoflexprincipal", cPrincipal  )
    self:cBuffer := StrTran( self:cBuffer, "declare flex char(1)",  cDeclare )

    RestArea(aArea)
    FwFreeArray(aArea)

Return

/*/{Protheus.doc} loadTableSizes
    método dinâmico para calcular o tamanho de cada unidade de negócio para N tabelas.
    @author  victor.azevedo@totvs.com.br
    10/10/2025
    @version 12.1.2510
/*/
method loadTableSizes() class FinGesplanProcedure
    local nEnterpriseSize := 0 as numeric
    local nUnitSize := 0 as numeric
    local nBranchSize := 0 as numeric
    local nTotalSize := 0 as numeric
    local cTable := "" as character
    local nI := 0 as numeric

    If !Empty(self:aTablesList)
        For nI := 1 To Len(self:aTablesList)
            cTable := self:aTablesList[nI]

            nEnterpriseSize  := Len(FWCompany(cTable))
            nUnitSize := Len(FWUnitBusiness(cTable))
            nBranchSize  := Len(FWFilial(cTable))

            nTotalSize := 0

            // Verifica os modos de acesso e soma os tamanhos
            If FWModeAccess(cTable, 1) == "E"
                nTotalSize += nEnterpriseSize
            EndIf

            If FWModeAccess(cTable, 2) == "E"
                nTotalSize += nUnitSize
            EndIf

            If FWModeAccess(cTable, 3) == "E"
                nTotalSize += nBranchSize
            EndIf

            AAdd( self:aTableSizes, {cTable, nTotalSize, nEnterpriseSize, nUnitSize, nBranchSize})
        Next
    EndIf

Return 
