#INCLUDE "TBICONN.CH"
#INCLUDE "FILEIO.CH"
#INCLUDE "FWEVENTVIEWCONSTS.CH"
#INCLUDE "Fwlibversion.ch"
#INCLUDE "MATA330.CH"
#INCLUDE "PROTHEUS.CH"

/*/{Protheus.doc} MA280INC2CP NOVO MAT064
	Função auxiliar para montagem da variável cBuffer, durante a
	execução da função  EngOn17Compile
@type  Function
/*/
Function P280INC2CP(cProcesso as character, cEmpresa as character, cProcName as character, cBuffer as character, cError as character)

Local aParte	:= {}	as array
Local cAux		:= ""	as character
Local nParte	:= 0	as numeric
Local nMoeda	:= 0	as numeric
Local cOldPE 	:= ""   as character
Local lProcCP   := SuperGetMV('MV_M330SPC',.F.,.F.) .or. GetRpoRelease() >= '12.1.2610'

if HasMA280CP()
	If lProcCP
		aParte := ExecBlock('MA330CP')
		cAux := "begin" + CRLF
		cAux += "update SC2### set "		
		for nParte := 1 To Len(aParte) + 1
			If nParte > 1
				cAux += "," + CRLF
			EndIf
			for nMoeda := 1 To 5
				cAux += "C2_CPI" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " = C2_CPF" + StrZero(nParte, 2) + StrZero(nMoeda, 2)+","
                cAux += "C2_API" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " = C2_APF" + StrZero(nParte, 2) + StrZero(nMoeda, 2)				
				if nParte <= Len(aParte) +1 .and. nMoeda < 5
					cAux += ',' + CRLF
				endif
			next nMoeda
		next nParte
		cAux += CRLF
		cAux += "where R_E_C_N_O_ = @IN_RECNOSC2" + CRLF
		cAux += "end" + CRLF
		cBuffer := StrTran(cBuffer, '##BODY##', cAux)
	Else
		cOldPE := "declare @nRec Integer" + CRLF
		cOldPE += "begin" + CRLF
		cOldPE += "select @nRec  = 0" + CRLF
		cOldPE += "end" + CRLF
		cBuffer := StrTran(cBuffer, '##BODY##', cOldPE ) 
	EndIf
Else
	cOldPE := "declare @nRec Integer" + CRLF
	cOldPE += "begin" + CRLF
	cOldPE += "select @nRec  = 0" + CRLF
	cOldPE += "end" + CRLF
	cBuffer := StrTran(cBuffer, '##BODY##', cOldPE)
endif

FwFreeArray(aParte)

return cBuffer


/*/{Protheus.doc} MA280INB9CP NOVO MAT063
	Função auxiliar para montagem da variável cBuffer, durante a
	execução da função EngOn17Compile
@type  Function
/*/
Function P280INB9CP(cProcesso as character, cEmpresa as character, cProcName as character, cBuffer as character, cError as character)

Local aParte	:= {}	as array
Local cAux		:= ""	as character
Local nParte	:= 0	as numeric
Local nMoeda	:= 0	as numeric
Local cOldPE 	:= ""   as character
Local lProcCP   := SuperGetMV('MV_M330SPC',.F.,.F.) .or. GetRpoRelease() >= '12.1.2610'

if HasMA280CP()
	If lProcCP
		aParte := ExecBlock('MA330CP')
		for nParte := 1 To Len(aParte) + 1
			for nMoeda := 1 To 5
				cAux += "DECLARE @nCP" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " FLOAT " + CRLF
			next nMoeda
		next nParte
		for nParte := 1 To Len(aParte) + 1
			for nMoeda := 1 To 5
				cAux += "DECLARE @nCPM" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " FLOAT " + CRLF
			next nMoeda
		next nParte
		for nMoeda := 1 To 5
				cAux += "DECLARE @nRESTO" + cvaltochar(nMoeda) + "	FLOAT " + CRLF
		next nMoeda
		cAux += "DECLARE @nB9_QINI Float " + CRLF

		cAux += "begin" + CRLF
		cAux += "  SELECT @nB9_QINI = COALESCE (B9_QINI,0), "			
		for nMoeda := 1 To 5
			cAux += " @nRESTO" + cvaltochar(nMoeda) + " = COALESCE (B9_VINI"+ cvaltochar(nMoeda) +",0)"
			if nMoeda < 5
				cAux += ","
			endif
		next nMoeda
		cAux += "  from SB9### " + CRLF
		cAux += "  WHERE R_E_C_N_O_ = @IN_RECNOSB9" + CRLF

		cAux += "  select " + CRLF		
		for nParte := 1 To Len(aParte) + 1
			If nParte > 1
				cAux += ", " + CRLF
			EndIf
			for nMoeda := 1 To 5
				cAux += "	@nCP" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " = Coalesce (B2_CPF"+ StrZero(nParte, 2) + StrZero(nMoeda, 2)+",0), "
				cAux += " @nCPM" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " = Coalesce (B2_CP"+ StrZero(nParte, 2) + StrZero(nMoeda, 2)+",0)"
				if nParte <= Len(aParte) +1 .and. nMoeda < 5
					cAux += ', ' + CRLF
				endif
			next nMoeda
		next nParte	
		cAux += "  from SB2### " + CRLF
		cAux += "  WHERE R_E_C_N_O_ = @IN_RECNOSB2" + CRLF

		for nParte := 1 To Len(aParte)
			for nMoeda := 1 To 5
				cAux += "  IF @nB9_QINI <= 0 OR @nCP" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " < 0" + CRLF
				cAux += "     BEGIN" + CRLF 
				cAux += "        IF @IN_MV_CUSZERO = 'S'"  + CRLF
				cAux += "           BEGIN"  + CRLF
				cAux += "           	SELECT @nCP" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " = 0 "  + CRLF
				cAux += "           END"  + CRLF
				cAux += "        ELSE"  + CRLF
				cAux += "           BEGIN"  + CRLF
				cAux += "               SELECT @nCP" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " = @nCPM" + StrZero(nParte, 2) + StrZero(nMoeda, 2)  + CRLF
				cAux += "           END"  + CRLF
				cAux += "     END"  + CRLF
				cAux += "  ELSE"  + CRLF
				cAux += "     BEGIN"  + CRLF
				cAux += "        SELECT @nCP" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " = @nCP" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " / @nB9_QINI" + CRLF
				cAux += "     END"  + CRLF
				cAux += "  BEGIN"  + CRLF
				cAux += "     SELECT @nCP" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " = @nCP" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " * @nB9_QINI"  + CRLF
				cAux += "     SELECT @nRESTO" + cvaltochar(nMoeda) + " = @nRESTO" + cvaltochar(nMoeda) + " - @nCP" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + CRLF
				cAux += "  END"  + CRLF
			next nMoeda	
		next nParte
		nParte := Len(aParte) + 1
		for nMoeda := 1 To 5
			cAux += "  BEGIN SELECT @nCP" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " = @nRESTO" + cvaltochar(nMoeda) + " END" + CRLF
		next nMoeda	
		cAux += "  UPDATE SB9### set " 
		for nParte := 1 To Len(aParte) + 1
			If nParte > 1
				cAux += "," + CRLF
			EndIf
			for nMoeda := 1 To 5
				cAux += "B9_CP" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " = @nCP" + StrZero(nParte, 2) + StrZero(nMoeda, 2)+","
                cAux += "B9_CPM" + StrZero(nParte, 2) + StrZero(nMoeda, 2) + " = @nCPM" + StrZero(nParte, 2) + StrZero(nMoeda, 2)				
				if nParte <= Len(aParte) +1 .and. nMoeda < 5
					cAux += ',' + CRLF
				endif
			next nMoeda
		next nParte
		cAux += CRLF
		cAux += "   where R_E_C_N_O_ = @IN_RECNOSB9" + CRLF
		cAux += " end" + CRLF
		cBuffer := StrTran(cBuffer, '##BODY##', cAux)		
	Else
		cOldPE := "declare @iRecnoTRT     integer" + CRLF
		cOldPE += "begin" + CRLF
		cOldPE += "select @iRecnoTRT = 0" + CRLF
		cOldPE += "end" + CRLF
		cBuffer := StrTran(cBuffer, '##BODY##', cOldPE)
	EndIf
Else
	cOldPE := "declare @iRecnoTRT     integer" + CRLF
	cOldPE += "begin" + CRLF
	cOldPE += "select @iRecnoTRT = 0" + CRLF
	cOldPE += "end" + CRLF
	cBuffer := StrTran(cBuffer, '##BODY##', cOldPE)
endif

FwFreeArray(aParte)

Return cBuffer

/*/{Protheus.doc} HasMA280CP
    Retorna se o ponto de entrada MA330CP está compilado, possui regras válidas
    e se os campos existem no dicionário
    @type Function
/*/
Static Function HasMA280CP()

Local aRegraPE	:= {}						as array
Local lMA330CP	:= ExistBlock('MA330CP')	as logical
Local lRet		:= .F.						as logical

    //Avalia se utiliza o ponto de entrada MA330CP
    if lMA330CP
        aRegraPE := ExecBlock("MA330CP",.F.,.F.)
        if valType(aRegraPE) <> "A" .or. Len(aRegraPE) = 0 
            aRegraPE := {}
        endif
		if Len(aRegraPE) > 0
			lRet := MA330AvlCp(aRegraPE,{})
		endif
		If !lret 
			Msgalert (OemToAnsi(STR0280))
		EndIf 
	EndIf
	FwFreeArray(aRegraPE)

Return lRet
