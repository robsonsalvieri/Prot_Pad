#Include "tlpp-core.th"

namespace totvs.protheus.backoffice.categories.importcategories

//------------------------------------------------------------------------------
/*/{Protheus.doc} ImportCategoriesService
	Disponibiliza o serviço de importação de Categorias de produtos
	@type       Class
	@author     Paulo Dias Oliveira / Squad Retail
	@since      16/11/2025
	@version    P12
/*/
//------------------------------------------------------------------------------
Class ImportCategoriesService
	Data oData as Object

	Public Method new() as Object
	Public Method getTemplate() as Json
	Public Method postImport(cBody as Character) as Json
EndClass

//------------------------------------------------------------------------------
/*/{Protheus.doc} ImportCategoriesService::new() as Object
	Obtém uma nova instancia da classe ImportCategoriesService
	@type       method
	@return     object, retorna uma nova instancia da classe
	@author     Paulo Dias Oliveira / Squad Retail
	@since      16/11/2025
	@version    P12
/*/
//------------------------------------------------------------------------------
Method new() as Object Class ImportCategoriesService
	::oData := ImportCategoriesProtheusData():New()
Return Self

//------------------------------------------------------------------------------
/*/{Protheus.doc} ImportCategoriesService::new() as Json
	Obtém o template de importação de categorias em formato JSON, contendo o arquivo CSV codificado em Base64
	@type       method
	@return     json, retorna um objeto Json contendo o nome do arquivo e o conteúdo em Base64 do template CSV
	@author     Paulo Dias Oliveira / Squad Retail
	@since      16/11/2025
	@version    P12
/*/
//------------------------------------------------------------------------------
Method getTemplate() as Json Class ImportCategoriesService
Return ::oData:getTemplate()

//------------------------------------------------------------------------------
/*/{Protheus.doc} ImportCategoriesService::new() as Json
	Realiza a importação das categorias utilizando o MILE do Protheus, a partir de um arquivo CSV enviado via API e codificado em Base64 no corpo da requisição
	@type       method
	@return     json, retorna um objeto Json indicando o sucesso ou falha da operação, e mensagens de erro quando aplicável
	@author     Paulo Dias Oliveira / Squad Retail
	@since      16/11/2025
	@version    P12
/*/
//------------------------------------------------------------------------------
Method postImport(cBody as Character) as Json Class ImportCategoriesService
Default cBody := ""
Return ::oData:postImport(cBody)
