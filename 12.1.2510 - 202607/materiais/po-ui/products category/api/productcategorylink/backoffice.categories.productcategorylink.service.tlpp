/*/{Protheus.doc} productCategoryLinkService:getAvailableGrids()
	Lista grades disponiveis para vinculacao
	@type       method
	@param      cCategoryCode, Character, Código da categoria para filtro de grades
	@param      cGroupSearch , Character, Código do grupo para filtro de grades
	@param      nPage        , Numeric  , Número da página que será retornada
