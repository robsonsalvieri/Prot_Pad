/*/{Protheus.doc} productCategoryLinkService:getAvailableProducts()
	Lista produtos disponiveis para vinculacao
	@type       method
	@param      cCategoryCode, Character, Código da categoria para filtro de produtos
	@param      cGroupSearch , Character, Código do grupo para filtro de produtos
	@param      nPage        , Numeric  , Número da página que será retornada
	@param      nPageSize    , Numeric  , Quantidade de registros por página
	@return     Json com a lista de produtos disponíveis para vinculo
	@author     cruz.rafael / Squad Retail
	@since      18/12/2025
/*/
//------------------------------------------------------------------------------
Method getAvailableProducts(cCategoryCode as Character, cGroupSearch as Character, nPage as Numeric, nPageSize as Numeric) as Json Class productCategoryLinkService
	Local oData as Object

	Default cCategoryCode := ""
	Default cGroupSearch  := ""
	Default nPage         := 1
	Default nPageSize     := 10

	oData := ::getData("GET")
	::jResponse := oData:getAvailableProducts(cCategoryCode, cGroupSearch, nPage, nPageSize)

	oData:DeActivate()
	FwFreeObj(oData)

Return ::jResponse

