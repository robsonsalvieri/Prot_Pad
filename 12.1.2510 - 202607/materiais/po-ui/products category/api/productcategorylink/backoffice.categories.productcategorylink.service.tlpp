//------------------------------------------------------------------------------
/*/{Protheus.doc} productCategoryLinkService:delLink()
	Inclui múltiplas amarrações categoria x grupo/produto em lote
	@type       method
	@author     cruz.rafael / Squad Retail
	@since      17/12/2025
/*/
//------------------------------------------------------------------------------
Method delLink(jBody as Json) as Json Class productCategoryLinkService
	Local oData      as Object

	Default jBody := JsonObject():New()

	// Cria nova instância do data layer com o body do(s) item(s) a excluir.
	oData := ::getData("DELETE")
	::jResponse := oData:handleProductCategoryLink(4, jBody)
	oData:DeActivate()
	FreeObj(oData)

Return ::jResponse
