	@author     cruz.rafael / Squad Retail
	@since      12/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getInstance() as Object Class productCategoryLinkService
	If (__oInstance == Nil)
		__oInstance := productCategoryLinkService():New()
	EndIf

Return __oInstance

//------------------------------------------------------------------------------
/*/{Protheus.doc} getData
	Retorna o tipo de objeto utilizado para consulta.
