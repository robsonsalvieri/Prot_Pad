	@author     cruz.rafael / Squad Retail
	@since      12/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getData(cVerb as Character) as Object class productCategoryLinkService
	If __oActiveData == Nil
		__oActiveData := ProductCategoryLinkProtheusData():new(cVerb)
	EndIf

Return __oActiveData

//------------------------------------------------------------------------------
/*/{Protheus.doc} getProductCategoryLink
	Efetua a consulta de Amarrações Categoria x Grupo/Produto

	@type       method
	@sample     oService:getProductCategoryLink(1, 10, {}, 'code, description', '-code')
	@param      nPage       , Numeric  , Número da página que será retornada
	@param      nPageSize   , Numeric  , Quantidade de registros por página
	@param      aURLFilter  , Array    , Lista de Filtros no padrão do FWAdapterBaseV2
	@param      cFields     , Character, Lista de campos que devem ser retornados
	@param      cSort       , Character, Ordernação do Response
	@param      cCategory   , Character, Código da categoria
	@param      cProduct    , Character, Código do produto
	@param      cGroup      , Character, Código do grupo
	@param      cGridRefer  , Character, Código da grade/referência
	@author     cruz.rafael / Squad Retail
	@since      12/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getProductCategoryLink(nPage as Numeric, nPageSize as Numeric, aURLFilter as Array, cFields as Character,;
 cSort as Character, cCategory as Character, cProduct as Character, cGroup as Character, cGridRefer as Character) as Json Class productCategoryLinkService
	Local oProductCategoryLink as object

	Default nPage      := 1
	Default nPageSize  := 10
	Default cCategory  := ""
	Default cProduct   := ""
	Default cGroup     := ""
	Default cGridRefer := ""

	oProductCategoryLink := ::getData("GET")
	oProductCategoryLink:Get(nPage, nPageSize, aURLFilter, cFields, cSort, cCategory, cProduct, cGroup, cGridRefer)

	::jResponse := oProductCategoryLink:getJsonResponse()

	oProductCategoryLink:DeActivate()
	FwFreeObj(oProductCategoryLink)

Return ::jResponse

//------------------------------------------------------------------------------
/*/{Protheus.doc} productCategoryLinkService:postBatch()
	Inclui múltiplas amarrações categoria x grupo/produto em lote

	@type       method
	@author     cruz.rafael / Squad Retail
	@since      17/12/2025
	@param      jBody, Json, Json com a lista de amarrações a serem incluídas.
	@return     Json com o resultado da operação
/*/
//------------------------------------------------------------------------------
Method postBatch(jBody as Json) as Json Class productCategoryLinkService
	Local oData      as Object

	Default jBody := JsonObject():New()

	// Cria nova instância do data layer para cada item
	oData := ::getData("POST")
	::jResponse := oData:handleProductCategoryLink(3, jBody, "")
	oData:DeActivate()
	FreeObj(oData)

Return ::jResponse

//------------------------------------------------------------------------------
/*/{Protheus.doc} productCategoryLinkService:delete()
	Exclui uma amarração categoria x grupo/produto
	@type       method
	@author     cruz.rafael / Squad Retail
	@since      12/12/2025
/*/
//------------------------------------------------------------------------------
Method delete(nOperation as Numeric, cInternalId as Character) as Json Class productCategoryLinkService
	Local oData     as Object

	Default nOperation  := 5
	Default cInternalId := ""

	oData := ::getData("DELETE")
	::jResponse := oData:handleProductCategoryLink(nOperation,, cInternalId)
	oData:DeActivate()
	FwFreeObj(oData)

Return ::jResponse

