namespace totvs.protheus.backoffice.categories.productcategories
using namespace totvs.protheus.backoffice.categories.util

Static __aPrepared := {} as Array

#DEFINE LABEL 1
#DEFINE VALUE 2

//------------------------------------------------------------------------------
/*/{Protheus.doc} CategoriesProtheusData
	Efetua a consulta de categorias de produtos do Protheus.

	@type       Class
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Class CategoriesProtheusData from FWAdapterBaseV2

	Public Method new() as Object
	Public Method getCategories()
	Public Method getInactivatedCategories()
	Public Method getChildCategories()
	Public Method postActivateCategories()
	Public Method rowToJson()

EndClass

//------------------------------------------------------------------------------
/*/{Protheus.doc} new
	Construtor da classe CategoriesProtheusData

	@sample     CategoriesProtheusData():New("GET", .T.)
	@type       method
	@param      cVerbo, Character, Verbo que será utilizado na requisição
	@param      lList , Logical  , Se irá listar o Json
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method new() as Object Class CategoriesProtheusData
	_Super:New("GET", .T.)
Return Self

//------------------------------------------------------------------------------
/*/{Protheus.doc} GetCategories
	Efetua a consulta de Categorias de Produtos.

	@sample     oCategoryData:Get(1, 10, {}, 'code, description', '-code', Nil)
	@type       method
	@param      nPage       , Numeric   , Número da página que será retornada
	@param      nPageSize   , Numeric   , Quantidade de registros por página
	@param      aURLFilter  , Array     , Lista de Filtros no padrão do FWAdapterBaseV2
	@param      cFields     , Character , Lista de campos que devem ser retornados
	@param      cSort       , Character , Ordernação do Response
	@param      cSearchText , Character , Texto de pesquisa
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getCategories(nPage as Numeric, nPageSize as Numeric, aURLFilter as Array, cFields as Character, cSort as Character,;
 cSearchText as Character) class CategoriesProtheusData
	Local aArea := GetArea() as Array
	Local lCodPad as Logical

	Default nPage       := 1
	Default nPageSize   := 10
	Default aURLFilter  := {}
	Default cFields     := ""
	Default cSort       := ""
	Default cSearchText := ""

	lCodPad := SuperGetMV("MV_PADCOD", .F., .F.) // Indica se a função de padronização de códigos pela categoria está ativa ou não.

	::setPage( nPage ) // Define a página atual
	::setPageSize( nPageSize ) // Define o tamanho da página
	::setQuery( GetQueryACU()) // Define a query utilizada
	::setWhere( GetFilterACU( cSearchText, .T.)) // Define o filtro utilizado
	If lCodPad .And. ACU->(ColumnPos("ACU_CDPROD")) > 0 // Verifica se o campo de código para produto existe
		::setOrder( "ACU_CDPROD" ) // Define a ordenação padrão
	Else
		::setOrder( "ACU_FILIAL, ACU_CODPAI, ACU_DESC" ) // Define a ordenação padrão
	EndIf

	::setIsCaseSensitive(.T.) // Define a consulta como case sensitive, para que o filtro de pesquisa funcione corretamente

	AddMapFieldsACU( self )

	If !Empty( aURLFilter ) .And. Len( aURLFilter ) > 0
		::SetUrlFilter( aURLFilter ) // Define o filtro da URL
	Endif

	If !Empty( cSort )
		::SetOrderQuery( cSort ) // Define a ordenação personalizada
	EndIf

	If !Empty( cFields )
		::SetFields( cFields ) // Define os campos que serão retornados
	Endif

	If ::Execute()
		::FillGetResponse() // Preenche o response com os dados retornados
	EndIf

	RestArea( aArea )
	aSize( aArea, 0 )
Return Nil

//------------------------------------------------------------------------------
/*/{Protheus.doc} GetInactivatedCategories
	Efetua a consulta de Categorias de Produtos Inativadas.

	@sample     oCategoryData:Get(1, 10, {}, 'code, description', '-code', Nil)
	@type       method
	@param      nPage       , Numeric   , Número da página que será retornada
	@param      nPageSize   , Numeric   , Quantidade de registros por página
	@param      aURLFilter  , Array     , Lista de Filtros no padrão do FWAdapterBaseV2
	@param      cFields     , Character , Lista de campos que devem ser retornados
	@param      cSort       , Character , Ordernação do Response
	@param      cSearchText , Character , Texto de pesquisa
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getInactivatedCategories(nPage as Numeric, nPageSize as Numeric, aURLFilter as Array, cFields as Character, cSort as Character,;
 cSearchText as Character) class CategoriesProtheusData
	Local aArea := GetArea() as Array

	Default nPage       := 1
	Default nPageSize   := 10
	Default aURLFilter  := {}
	Default cFields     := ""
	Default cSort       := ""
	Default cSearchText := ""

	::setPage( nPage ) // Define a página atual
	::setPageSize( nPageSize ) // Define o tamanho da página
	::setQuery( GetQueryACU()) // Define a query utilizada
	::setWhere( GetFilterACU( cSearchText, .F.)) // Define o filtro utilizado
	::setOrder( "ACU_FILIAL, ACU_CODPAI, ACU_DESC" ) // Define a ordenação padrão

	::setIsCaseSensitive(.T.) // Define a consulta como case sensitive, para que o filtro de pesquisa funcione corretamente

	AddMapFieldsInat( self )

	If !Empty( aURLFilter ) .And. Len( aURLFilter ) > 0
		::SetUrlFilter( aURLFilter ) // Define o filtro da URL
	Endif

	If !Empty( cSort )
		::SetOrderQuery( cSort ) // Define a ordenação personalizada
	EndIf

	If !Empty( cFields )
		::SetFields( cFields ) // Define os campos que serão retornados
	Endif

	If ::Execute()
		::FillGetResponse() // Preenche o response com os dados retornados
	EndIf

	RestArea( aArea )
	aSize( aArea, 0 )
Return Nil

//------------------------------------------------------------------------------
/*/{Protheus.doc} getChildCategories
	Busca as categorias filhas de uma categoria informada.

	@sample     oCategoryData:GetChildCategories('CAT001')
	@type       method
	@param      cCategory   , Character , Código da categoria a ser ativada
	@author     Jorge Martins / Squad Retail
	@since      16/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method getChildCategories(cCategory as Character, lActivated as Logical, lInactivated as Logical) class CategoriesProtheusData
	Local aArea       := FwGetArea() as Array
	Local aAreaACU    := ACU->(FwGetArea()) as Array
	Local lContinue   := .T. as Logical
	Local cMsgError   := ""  as Character
	Local jResponse   := JsonObject():new() as Json

	Default cCategory    := ""
	Default lActivated   := .T.
	Default lInactivated := .F.

	DbSelectArea("ACU")
	ACU->(DbSetOrder(1))
	If Empty(cCategory) .Or. !ACU->(DbSeek(FwXFilial('ACU') + cCategory))
		cMsgError   := STR0001 // "Categoria não localizada"
		lContinue   := .F.
		jResponse["error"] := FWHttpEncode(cMsgError)
	EndIf

	If lContinue
		aCategories := GetChildCat(FwXFilial("ACU"), cCategory, lActivated, lInactivated, .T.)
		If Len(aCategories) > 0
			jResponse := GetResponseCategory(aCategories)
		Else
			cMsgError   := STR0002 // "Nenhuma categoria filha localizada"
			lContinue   := .F.
			jResponse["error"] := FWHttpEncode(cMsgError)
		EndIf
	Endif

	FwRestArea(aAreaACU)
	FwRestArea(aArea)
	aSize(aAreaACU, 0)
	aSize(aArea, 0)
	
Return jResponse

//------------------------------------------------------------------------------
/*/{Protheus.doc} PostActivateCategories
	Ativa as categorias de produtos.

	@sample     oCategoryData:PostActivateCategories('CAT001', .T.)
	@type       method
	@param      cCategory   , Character , Código da categoria a ser ativada
	@param      lActivateSup, Logical   , Indica se as categorias superiores também devem ser ativadas
	@author     Jorge Martins / Squad Retail
	@since      16/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Method postActivateCategories(cCategory as Character, lActivateSup as Logical) class CategoriesProtheusData
	Local aArea       := FwGetArea() as Array
	Local aAreaACU    := ACU->(FwGetArea()) as Array
	Local lContinue   := .T. as Logical
	Local cMsgError   := ""  as Character
	Local aCategories := {}  as Array
	Local cMessage    := ""  as Character
	Local jResponse   := JsonObject():new() as Json

	Default cCategory    := ""
	Default lActivateSup := .F.

	DbSelectArea("ACU")
	ACU->(DbSetOrder(1))
	If Empty(cCategory) .Or. !ACU->(DbSeek( FwXFilial('ACU') + cCategory))
		cMsgError   := STR0001 // "Categoria não localizada"
		lContinue   := .F.
		jResponse["error"] := FWHttpEncode(cMsgError)
	EndIf

	If lContinue
		aCategories := ActivateCat(cCategory, lActivateSup, @cMsgError)
		If Empty(cMsgError) // Se não houver erro na ativação das categorias
			cMessage := FwHttpEncode(STR0003) // "Categoria ativada com sucesso"
			jResponse := GetResponseCategory(aCategories, cMessage)
		Else
			lContinue := .F.
			jResponse["error"] := FWHttpEncode(cMsgError)
		Endif
	Endif

	FwRestArea( aAreaACU )
	FwRestArea( aArea )
	aSize( aAreaACU, 0)
	aSize( aArea, 0)
	FwFreeArray(aCategories)
	
Return jResponse

//------------------------------------------------------------------------------
/*/{Protheus.doc} RowToJson
	Converte o retorno da consulta SQL em JSON

	@sample     oCategoryData:RowToJson( cAlias, aFields, .F.)
	@type       method
	@param      cAlias , Character, Alias da Consulta
	@param      aFields, Array    , Campos (MapFields)
	@param      lEmpty , Logical  , Vazio.
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
METHOD rowToJson(cAlias as Character, aFields as Array , lEmpty as Logical) CLASS CategoriesProtheusData
	Local nLoop    as Integer
	Local cContent as Character

	Default cAlias  := ""
	Default aFields := {}
	Default lEmpty  := .F.

	If !Empty(cAlias) .And. Len(aFields) > 0
		If !Empty((cAlias)->internalid)
			Self:oJsonObj:setProp('key', Encode64((cAlias)->internalid), .F.) // Adiciona o campo key codificado em base64 no Json
		
			If FwIsInCallStack("getInactivatedCategories") .Or.FwIsInCallStack("getCategoriesbySearch")
				Self:oJsonObj:setProp('product', GetQtdProd((cAlias)->ACU_FILIAL, (cAlias)->ACU_COD), .F.) // Adiciona a quantidade de produtos vinculados no Json
				Self:oJsonObj:setProp('path'   , GetPath((cAlias)->ACU_FILIAL, (cAlias)->ACU_COD, (cAlias)->ACU_DESC), .F.) // Adiciona o caminho completo da categoria no Json
			EndIf
		EndIf
		For nLoop := 1 to Len( aFields )
			cContent := ''
			If !lEmpty
				cContent := ::ValueToJson( aFields[nLoop, LABEL], (cAlias)->( &(aFields[nLoop, VALUE]) )  )
			EndIf
			Self:oJsonObj:setProp( aFields[nLoop, LABEL], cContent, lEmpty )
		Next
	EndIf
Return Nil

//------------------------------------------------------------------------------
/*/{Protheus.doc} AddMapFieldsACU
	Cria o Mapa de campos Protheus x API para as categorias.

	@sample     AddMapFieldsACU( self )
	@type       Function
	@param      oSelf, Object, Objeto com herança da classe FWAdapterBaseV2
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Static Function AddMapFieldsACU(oSelf as Object)
	Local aInternalId := GetInternalId( { "ACU_FILIAL", "ACU_COD" } )

	oSelf:AddMapFields("internalId"  , "internalId", .T., .T., { "internalId", 'C', aInternalId[1], 0 }, aInternalId[2])
	oSelf:AddMapFields("branchId"    , "ACU_FILIAL", .T., .T., { "ACU_FILIAL", 'C', GetFieldLength("ACU_FILIAL"), 0 }, "ACU.ACU_FILIAL")
	oSelf:AddMapFields("code"        , "ACU_COD"   , .T., .T., { "ACU_COD"   , 'C', GetFieldLength("ACU_COD")   , 0 }, "ACU.ACU_COD")
	oSelf:AddMapFields("description" , "ACU_DESC"  , .T., .T., { "ACU_DESC"  , 'C', GetFieldLength("ACU_DESC")  , 0 })
	oSelf:AddMapFields("parent"      , "ACU_CODPAI", .T., .F., { "ACU_CODPAI", 'C', GetFieldLength("ACU_CODPAI"), 0 })
	oSelf:AddMapFields("status"      , "ACU_MSBLQL", .T., .F., { "ACU_MSBLQL", 'C', GetFieldLength("ACU_MSBLQL"), 0 })
	If ACU->(ColumnPos("ACU_CDPROD")) > 0 // Verifica se o campo de código para produto existe
		oSelf:AddMapFields("productCode" , "ACU_CDPROD", .T., .F., { "ACU_CDPROD", 'C', GetFieldLength("ACU_CDPROD"), 0 })
	EndIf
Return Nil

//------------------------------------------------------------------------------
/*/{Protheus.doc} AddMapFieldsInat
	Cria o Mapa de campos Protheus x API para as categorias inativas.

	@sample     AddMapFieldsInat( self )
	@type       Function
	@param      oSelf, Object, Objeto com herança da classe FWAdapterBaseV2
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Static Function AddMapFieldsInat(oSelf as Object)
	Local aInternalId := GetInternalId( { "ACU_FILIAL", "ACU_COD" } )

	oSelf:AddMapFields("internalId"       , "internalId", .T., .T., { "internalId", 'C', aInternalId[1], 0 }, aInternalId[2])
	oSelf:AddMapFields("branchId"         , "ACU_FILIAL", .T., .T., { "ACU_FILIAL", 'C', GetFieldLength("ACU_FILIAL"), 0 }, "ACU.ACU_FILIAL")
	oSelf:AddMapFields("code"             , "ACU_COD"   , .T., .T., { "ACU_COD"   , 'C', GetFieldLength("ACU_COD")   , 0 }, "ACU.ACU_COD")
	oSelf:AddMapFields("description"      , "ACU_DESC"  , .T., .T., { "ACU_DESC"  , 'C', GetFieldLength("ACU_DESC")  , 0 })
	If ACU->(ColumnPos("ACU_DTINAT")) > 0 .And. ACU->(ColumnPos("ACU_USINAT")) > 0 // Verifica se os campos de inativação existem
		oSelf:AddMapFields("deactivationDate" , "ACU_DTINAT", .T., .F., { "ACU_DTINAT", 'D', GetFieldLength("ACU_DTINAT"), 0 })
		oSelf:AddMapFields("deactivationUser" , "ACU_USINAT", .T., .F., { "ACU_USINAT", 'C', GetFieldLength("ACU_USINAT"), 0 })
	EndIf
	oSelf:AddMapFields("parent"           , "ACU_CODPAI", .T., .F., { "ACU_CODPAI", 'C', GetFieldLength("ACU_CODPAI"), 0 })
	oSelf:AddMapFields("status"           , "ACU_MSBLQL", .T., .F., { "ACU_MSBLQL", 'C', GetFieldLength("ACU_MSBLQL"), 0 })
	If ACU->(ColumnPos("ACU_CDPROD")) > 0 // Verifica se o campo de código para produto existe
		oSelf:AddMapFields("productCode" , "ACU_CDPROD", .T., .F., { "ACU_CDPROD", 'C', GetFieldLength("ACU_CDPROD"), 0 })
	EndIf

Return Nil

//------------------------------------------------------------------------------
/*/{Protheus.doc} GetQueryACU
	Obtém a Query utilizada para buscar as categorias de produtos

	@sample     GetQueryACU()
	@type       Function
	@return     cQuery, character, expressão SQL
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Static Function GetQueryACU()
	Local cQuery as character
	Local nParam as Numeric
	Local oMainExec as Object

	nParam := 1

	cQuery := " SELECT ?"
	cQuery +=   " FROM " + RetSqlName('ACU') + " ACU "
	cQuery +=  " WHERE ?"

	oMainExec := GetQuery(cQuery)

	oMainExec:setUnsafe(nParam++, "#QueryFields#")
	oMainExec:setUnsafe(nParam++, "#QueryWhere#")

	cQuery := oMainExec:getFixQuery()

Return cQuery

//------------------------------------------------------------------------------
/*/{Protheus.doc} getFilterACU
	Obtem o filtro da ACU utilizada no TOTVS Gestão de Vendas

	@sample     getFilterACU()
	@type       Function
	@param      cSearchText , Character, Texto de pesquisa
	@param      lAtivas     , Logical  , Se deve buscar apenas as categorias ativas
	@return     cWhere      , Character, Expressão utilizada na consulta
	@author     Jorge Martins / Squad Retail
	@since      17/11/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Static Function GetFilterACU(cSearchText as Character, lAtivas as Logical) as Character
	Local cWhere as Character

	Default cSearchText := ""
	Default lAtivas     := .T.

	cWhere :=     " ACU.ACU_FILIAL = '" + FwXFilial("ACU") + "'"
	If lAtivas // Apenas Ativas
		cWhere += " AND ACU.ACU_MSBLQL = '2' "
	Else // Apenas Inativas
		cWhere += " AND ACU.ACU_MSBLQL <> '2' "
	EndIf
	cWhere += " AND ACU.D_E_L_E_T_ = ' ' "
	If !Empty(cSearchText)
		cSearchText := Upper(AllTrim(cSearchText))
		cWhere += " AND (UPPER(ACU.ACU_COD) LIKE '%" + cSearchText + "%' OR UPPER(ACU.ACU_DESC) LIKE '%" + cSearchText + "%')"
	EndIf

return cWhere

//-------------------------------------------------------------------
/*/{Protheus.doc} GetQtdProd
	Obtem a quantidade de produtos vinculados a uma categoria

	@sample     GetQtdProd()
	@type       Function
	@param      cFilialACU  , Character, Filial da categoria
	@param      cCategory   , Character, Código da categoria
	@return     nQtdProd    , Numeric  , Quantidade de produtos vinculados
	@author     Jorge Martins / Squad Retail
	@since      12/12/2025
	@version    12.1.2610
/*/
//-------------------------------------------------------------------
Static Function GetQtdProd(cFilialACU as Character, cCategory as Character) as Numeric
Local nQtdProd    as numeric
Local nParam      as numeric
Local cQuery      as character
Local cAliasProd  as character
Local aCategories as array
Local oQueryProd  as object

Default cFilialACU := FwXFilial("ACU")
Default cCategory  := ""

	aCategories := GetChildCat(cFilialACU, cCategory) // Categorias filhas

	aAdd(aCategories, cCategory) // Adiciona a própria categoria

	cQuery := " SELECT COUNT(1) QTDPROD FROM " + RetSqlName('ACV') + " ACV "
	cQuery +=  " INNER JOIN " + RetSqlName('ACU') + " ACU "
	cQuery +=     " ON ACU.ACU_FILIAL = ACV.ACV_FILIAL"
	cQuery +=    " AND ACU.ACU_COD    = ACV.ACV_CATEGO"
	cQuery +=    " AND ACU.D_E_L_E_T_ = ?" // #1
	cQuery +=  " WHERE ACV.ACV_FILIAL = ?" // #2
	cQuery +=    " AND ACV.ACV_CATEGO IN (?)" // #3
	cQuery +=    " AND ACV.D_E_L_E_T_ = ? " // #4

	oQueryProd := GetQuery(cQuery)

	nParam := 1
	oQueryProd:SetString(nParam++, Space(1)) // #1
	oQueryProd:SetString(nParam++, cFilialACU) // #2
	oQueryProd:SetIn(nParam++, aCategories) // #3
	oQueryProd:SetString(nParam++, Space(1)) // #4

	cAliasProd := GetNextAlias()
	oQueryProd:OpenAlias(cAliasProd)

	nQtdProd := 0
	If !(cAliasProd)->(EOF()) // Se retornou algum registro
		nQtdProd := (cAliasProd)->QTDPROD
	EndIf

	(cAliasProd)->(DBCloseArea())

	FwFreeArray(aCategories)

Return nQtdProd

//-------------------------------------------------------------------
/*/{Protheus.doc} GetPath
	Obtem o caminho completo da categoria

	@sample     GetPath(xFilial("ACU"), cCategory, cDescCateg)
	@type       Function
	@param      cFilialACU  , Character, Filial da categoria
	@param      cCategory   , Character, Código da categoria
	@param      cDescCateg  , Character, Descrição da categoria
	@return     cPath       , Character, Caminho completo da categoria
	@author     Jorge Martins / Squad Retail
	@since      12/12/2025
	@version    12.1.2610
/*/
//-------------------------------------------------------------------
Static Function GetPath(cFilialACU as Character, cCategory as Character, cDescCateg as Character) as Character
Local cPath       as character
Local nC          as numeric
Local lInactives  as logical
Local aArea       as array
Local aAreaACU    as array
Local aCategories as array

Default cFilialACU := FwXFilial("ACU")
Default cCategory  := ""
Default cDescCateg := ""

	aArea    := FwGetArea()
	aAreaACU := ACU->(FwGetArea())

	lInactives := .T. // Considera categorias inativas

	aCategories := GetSupCat(cFilialACU, cCategory, lInactives) // Categorias superiores

	For nC := Len(aCategories) To 1 Step -1
		If !Empty(aCategories[nC]) // Ignora categoria raiz vazia
			cPath += AllTrim(Posicione("ACU", 1, xFilial("ACU") + aCategories[nC], "ACU_DESC"))
			cPath += " > "
		EndIf
	Next

	cPath += AllTrim(cDescCateg)

	FwRestArea(aAreaACU)
	FwRestArea(aArea)
	aSize(aAreaACU, 0)
	aSize(aArea, 0)
	FwFreeArray(aCategories)

Return cPath

//------------------------------------------------------------------------------
/*/{Protheus.doc} GetResponseCategory
	Cria o Json de resposta com código e nome das categorias.

	@sample     GetResponseCategory( aCategories )
	@type       Function
	@param      aCategories, Array, Lista de categorias ativadas
	@param      cMessage   , Character, Mensagem de sucesso
	@return     jResponse  , Json , Objeto Json de resposta
	@author     Jorge Martins / Squad Retail
	@since      16/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Static Function GetResponseCategory(aCategories as array, cMessage as character) as json
	Local jResponse := JsonObject():New() as json
	Local nCat      := 0                  as Numeric
	Local cStatus   := ""                 as Character

	Default aCategories := {}
	Default cMessage    := ""

	jResponse['status'] := "OK"
	jResponse['items']  := {}
	If Len(aCategories) > 0
		For nCat := 1 To Len(aCategories)
			If aCategories[nCat][3] == "1"
				cStatus := STR0004 // "Inativo"
			Else
				cStatus := STR0005 // "Ativo"
			EndIf

			Aadd(jResponse['items'], JsonObject():New())
			jResponse['items'][nCat]['code']   := aCategories[nCat][1]
			jResponse['items'][nCat]['name']   := aCategories[nCat][2]
			jResponse['items'][nCat]['status'] := cStatus
			If !Empty(cMessage)
				jResponse['items'][nCat]['message'] := cMessage
			EndIf
		Next
	EndIf

Return jResponse

//------------------------------------------------------------------------------
/*/{Protheus.doc} ActivateCat
	Ativa a categoria informada e suas categorias superiores, se necessário.

	@sample     ActivateCat('CAT001', .T., @cMsgError)
	@type       Function
	@param      cCategory   , Character, Código da categoria a ser ativada
	@param      lActivateSup, Logical  , Indica se as categorias superiores também devem ser ativadas
	@param      cMsgError   , Character, Mensagem de erro retornada em caso de falha
	@return     aCatActive  , Array    , Lista de categorias ativadas
	@author     Jorge Martins / Squad Retail
	@since      16/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Static Function ActivateCat(cCategory as Character, lActivateSup as Logical, cMsgError as Character) as array
	Local aMsgErro    := {}   as array
	Local lContinue   := .T.  as logical
	Local nC          := 0    as numeric
	Local aCategories := {}   as array
	Local aCatActive  := {}   as array
	Local oModel      := FWLoadModel('FATA140') as object
	Local oModelACU   as object

	Default cCategory    := ""
	Default lActivateSup := .F.
	Default cMsgError    := ""

	If lActivateSup
		aCategories := GetSupCat(xFilial("ACU"), cCategory, .T.) // Categorias superiores
	EndIf
	aAdd(aCategories, cCategory)

	For nC := 1 To Len(aCategories)
		If !Empty(AllTrim(aCategories[nC])) .And. ACU->(DbSeek(FwXFilial('ACU') + aCategories[nC])) .And. ACU->ACU_MSBLQL <> "2"
			oModel:SetOperation(MODEL_OPERATION_UPDATE)
			If oModel:Activate()
				If oModel:IsActive()
					oModelACU := oModel:GetModel("ACUMASTER")
					oModelACU:SetValue("ACU_MSBLQL", "2") // Ativa a categoria

					If !(oModel:VldData() .And. oModel:CommitData())
						lContinue := .F.
						aMsgErro := oModel:GetErrorMessage()
						If Len(aMsgErro) >= 6 .And. ValType(aMsgErro[6]) == "C" .and. !Empty(aMsgErro[6])
							cMsgError += FWHttpEncode(aMsgErro[6])
						EndIf
						aSize(aMsgErro, 0)
					Else
						aAdd(aCatActive, {oModelACU:GetValue("ACU_COD"), AllTrim(oModelACU:GetValue("ACU_DESC")), AllTrim(oModelACU:GetValue("ACU_MSBLQL"))})
					Endif
				EndIf
				oModel:DeActivate()
			EndIf
		EndIf
	Next
	oModel:Destroy()
	FwFreeObj(oModel)
	FwFreeObj(oModelACU)
	FwFreeArray(aMsgErro)
	FwFreeArray(aCategories)

Return aCatActive

//-------------------------------------------------------------------
/*/{Protheus.doc} GetChildCat
	Obtém as categorias filhas.

	@sample     GetChildCat('CAT001')
	@type       Function
	@param      cFilialACU  , Character, Filial da tabela ACU
	@param      cCategory   , Character, Código da categoria atual
	@param      lActivated  , Logical  , Inclui categorias ativas na busca
	@param      lInactivated, Logical  , Inclui categorias inativas na busca
	@param      lComplement , Logical  , Inclui descrição da categoria no array
	@return     aCategories , Array    , Array com as categorias filhas
	@author     Jorge Martins / Squad Retail
	@since      17/12/2025
	@version    12.1.2610
/*/
//-------------------------------------------------------------------
Static Function GetChildCat(cFilialACU as Character, cCategory as Character, lActivated as Logical, lInactivated as Logical, lComplement as Logical) as Array
Local aCategories As Array

Default cFilialACU   := FwxFilial("ACU")
Default cCategory    := ""
Default lActivated   := .T.
Default lInactivated := .F.
Default lComplement  := .F.

	aCategories := {}

	If !Empty(cCategory) // Se a categoria atual não for vazia
		// Busca recursivamente todas as categorias descendentes
		AddChildCat(cFilialACU, cCategory, @aCategories, lActivated, lInactivated, lComplement)
	EndIf

Return aCategories

//-------------------------------------------------------------------
/*/{Protheus.doc} AddChildCat
	Busca o código da categoria filha

	@type       Function
	@param      cFilialACU  , Character, Filial da tabela ACU
	@param      cCategory   , Character, Código da categoria atual
	@param      aCategories , Array    , Array com as categorias filhas
	@param      lActivated  , Logical  , Inclui categorias ativas na busca
	@param      lInactivated, Logical  , Inclui categorias inativas na busca
	@param      lComplement , Logical  , Inclui complementos da categoria no array
	@author     Jorge Martins / Squad Retail
	@since      17/12/2025
	@version    12.1.2610
/*/
//-------------------------------------------------------------------
Static Function AddChildCat(cFilialACU as Character, cCategory as Character, aCategories as Array, lActivated as Logical, lInactivated as Logical, lComplement as Logical)
Local cQuery     As Character
Local oQuery     As Object
Local nParam     As Numeric
Local cAliasChil As Character
Local cMsBlql    As Character

Default cFilialACU   := FwxFilial("ACU")
Default cCategory    := ""
Default aCategories  := {}
Default lActivated   := .T.
Default lInactivated := .F.
Default lComplement  := .F.

	// Define o filtro de status da categoria
	If lActivated .And. !lInactivated
		cMsBlql := "2" // Apenas Ativas
	ElseIf !lActivated .And. lInactivated
		cMsBlql := "1" // Apenas Inativas
	Else
		cMsBlql := ""  // Todas
	EndIf

	cQuery :=   "SELECT ACU.ACU_COD, ACU.ACU_DESC, ACU.ACU_MSBLQL"
	cQuery +=    " FROM " + RetSqlName("ACU") + " ACU"
	cQuery +=   " WHERE ACU.ACU_FILIAL = ?"  // #1
	cQuery +=     " AND ACU.ACU_CODPAI = ?"  // #2
	If !Empty(cMsBlql) // Se houver filtro de status
		cQuery += " AND ACU.ACU_MSBLQL = ?"  // #3
	EndIf
	cQuery +=     " AND ACU.D_E_L_E_T_ = ?"  // #4

	oQuery := GetQuery(cQuery)

	nParam := 1
	oQuery:SetString(nParam++, cFilialACU)  // #1
	oQuery:SetString(nParam++, cCategory)   // #2
	If !Empty(cMsBlql) // Se houver filtro de status
		oQuery:SetString(nParam++, cMsBlql) // #3
	EndIf
	oQuery:SetString(nParam++, Space(1))    // #4
	
	cAliasChil := GetNextAlias()
	oQuery:OpenAlias(cAliasChil)

	While !(cAliasChil)->(EOF())

		If lComplement
			aAdd(aCategories, {(cAliasChil)->ACU_COD, AllTrim((cAliasChil)->ACU_DESC), AllTrim((cAliasChil)->ACU_MSBLQL)})
		Else
			aAdd(aCategories, (cAliasChil)->ACU_COD)
		EndIf

		// Busca filhos dessa categoria (recursão)
		AddChildCat(cFilialACU, (cAliasChil)->ACU_COD, @aCategories, lActivated, lInactivated, lComplement)

		(cAliasChil)->(DBSkip())

	EndDo

	(cAliasChil)->(DBCloseArea())

Return Nil

//-------------------------------------------------------------------
/*/{Protheus.doc} GetSupCat
	Obtém as categorias superiores de uma categoria.

	@sample     GetSupCat('CAT001')
	@type       Function
	@param      cFilialACU  , Character, Filial da tabela ACU
	@param      cCategory   , Character, Código da categoria atual
	@param      lInactives  , Logical  , Inclui categorias inativas na busca
	@return     aCategories , Array    , Array com as categorias superiores
	@author     Jorge Martins / Squad Retail
	@since      17/12/2025
	@version    12.1.2610
/*/
//-------------------------------------------------------------------
Static Function GetSupCat(cFilialACU as Character, cCategory as Character, lInactives as Logical) as Array
Local aCategories As Array
Local lRaiz       As Logical

Default cFilialACU := FwxFilial("ACU")
Default cCategory  := ""
Default lInactives := .F.

	lRaiz       := .F.
	aCategories := {}

	If !Empty(cCategory) // Se a categoria atual não for vazia busca as categorias superiores
		While !lRaiz
			// Busca o código pai da categoria atual
			cCategory := AddSupCat(cFilialACU, cCategory, lInactives)

			aAdd(aCategories, cCategory) // Adiciona a categoria atual ao array
			
			lRaiz := Empty(cCategory) // Verifica se chegou na categoria raiz
		EndDo
	EndIf

Return aCategories

//------------------------------------------------------------------------------
/*/{Protheus.doc} AddSupCat
	Obtém o código da categoria pai.

	@sample     AddSupCat(cFilialACU, cCategory, lInactives)
	@type       Function
	@param      cFilialACU , Character, Filial da tabela ACU
	@param      cCategory  , Character, Código da categoria atual
	@param      lInactives , Logical  , Inclui categorias inativas na busca
	@return     cSupCat    , Character, Código da categoria pai
	@author     Jorge Martins / Squad Retail
	@since      17/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Function AddSupCat(cFilialACU as Character, cCategory as Character, lInactives as Logical) as Character
Local cSupCat   As Character
Local cQuery    As Character
Local nParam    As Numeric
Local cAliasSup As Character
Local oQuery    As Object

Default cFilialACU := FwxFilial("ACU")
Default cCategory  := ""
Default lInactives := .F.

	cSupCat   := ""
	cAliasSup := GetNextAlias()

	cQuery :=   " SELECT ACU.ACU_CODPAI"
	cQuery +=     " FROM " + RetSqlName("ACU") + " ACU"
	cQuery +=    " WHERE ACU.ACU_FILIAL = ?"  // #1
	cQuery +=      " AND ACU.ACU_COD = ?"     // #2
	If !lInactives // Se não for para incluir inativas
		cQuery +=  " AND ACU.ACU_MSBLQL <> ?" // #3
	EndIf
	cQuery +=      " AND ACU.D_E_L_E_T_ = ?"  // #4

	oQuery := GetQuery(cQuery)

	nParam := 1
	oQuery:SetString(nParam++, cFilialACU)  // #1
	oQuery:SetString(nParam++, cCategory)   // #2
	If !lInactives // Se não for para incluir inativas
		oQuery:SetString(nParam++, "1")     // #3
	EndIf
	oQuery:SetString(nParam++, Space(1))    // #4
	
	oQuery:OpenAlias(cAliasSup)

	If !(cAliasSup)->(EOF())
		cSupCat := (cAliasSup)->ACU_CODPAI
	EndIf

	(cAliasSup)->(DBCloseArea())

Return cSupCat

//------------------------------------------------------------------------------
/*/{Protheus.doc} GetQuery
	Obtém a query preparada para execução.

	@sample     GetQuery(cQuery)
	@type       Function
	@param      cQuery, Character, Expressão SQL
	@return     oPrepared, Object, Objeto de query preparada
	@author     Jorge Martins / Squad Retail
	@since      17/12/2025
	@version    12.1.2610
/*/
//------------------------------------------------------------------------------
Static Function GetQuery(cQuery as Character) as Object
	Local oPrepared    as Object
	Local nPosPrepared as Numeric
	Local cMD5         as Character
	
	Default cQuery := ""

	cMD5 := MD5(cQuery)
	If (nPosPrepared := Ascan(__aPrepared,{|x| x[2] == cMD5})) == 0
		cQuery := ChangeQuery(cQuery)
		Aadd(__aPrepared,{FwExecStatement():New(cQuery), cMD5})
		nPosPrepared := Len(__aPrepared)
	Endif

	oPrepared := __aPrepared[nPosPrepared][1]

Return oPrepared
