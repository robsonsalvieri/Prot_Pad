#INCLUDE "PROTHEUS.CH"
#INCLUDE "PARMTYPE.CH"
#INCLUDE "FWBROWSE.CH"
#INCLUDE "FWMVCDEF.CH"
#INCLUDE "FATDOCREF.CH"

Static __cTpVinc := "1" // 1 =  Vinculo de documento // 2 = Vinculo de item de documento
Static __lCsdXML := SuperGetMV( 'MV_CSDXML', .F., .F. ) .and. FWSX3Util():GetFieldType( "D1_ITXML" ) == "C" .and. ChkFile("DKA") .and. ChkFile("DKB") .and. ChkFile("DKC") .and. ChkFile("D3Q")
Static jFld600   := Nil
Static __lTPCPL3 := .F.
#DEFINE OP_VINC_NF "1" //   Vinculo de documento
#DEFINE OP_VINC_ITEM "2" //  Vinculo de item de documento

//-------------------------------------------------------------------
/*/{Protheus.doc} FATDOCREF
Interface responsável pelo vínculo de documentos de referência
em notas de crédito e débito no MATA600.

A interface pode vincular itens por NF ou por Item a depender
da variável __cTpVinc definida na função FATDOCREFSetVinc.

É acionada no menu de outras ações do documento de saída.

@author CRM/Faturamento
@since 10/2025
@version 1.0
/*/
//-------------------------------------------------------------------
Function FATDOCREF()
Return

//-------------------------------------------------------------------
/*/{Protheus.doc} ModelDef
Model da tela

@Return oModel
@author CRM/Faturamento
@since 10/2025
/*/
//-------------------------------------------------------------------
Static Function ModelDef() As Object
	Local oStrCab	As Object
	Local oStrIte	As Object
	Local oStrFil	As Object
	Local oStrSel	As Object
	Local oModel	As Object

	jFld600 := GetJfld600()
	__lTPCPL3 := IIF(jFld600 <> Nil .And. jFld600:hasproperty('F2_TPCOMPL'), jFld600["F2_TPCOMPL"] == "3", .F.)

	oStrCab	:= DOCREFSTRM(1)
	oStrIte	:= DOCREFSTRM(3)
	oStrFil	:= DOCREFSTRM(2,2)
	oStrSel	:= DOCREFSTRM(2,3)
	oModel  := MPFormModel():New('FATDOCREF',/*bPreVld*/, /*{|oModel| PosValid(oModel)}*/, {|oModel| FATDOCREFCommit(oModel)}) 

	oModel:SetDescription(STR0001) //Documentos de origem

	oModel:AddFields( 'CABMASTER', , oStrCab,,, )
	oModel:GetModel( 'CABMASTER' ):SetDescription(STR0002) //Cabeçalho

	If __cTpVinc == OP_VINC_ITEM .Or. __lTPCPL3
		oModel:AddGrid( 'ITENSDETAIL', 'CABMASTER', oStrIte, /*bLinPre*/, /*bLinPos*/ ,,, )
		oModel:GetModel( 'ITENSDETAIL' ):SetDescription(STR0003) //Itens

		oModel:AddGrid( 'SELECTDETAIL', 'ITENSDETAIL', oStrSel, /*bLinPre*/, /*bLinPos*/ ,,, )
		oModel:GetModel( 'SELECTDETAIL' ):SetDescription(STR0004) //Documentos Selecionados
		oModel:SetRelation('ITENSDETAIL', { { 'D2_FILIAL', 'FWxFilial("SF2")' },{ 'D2_TIPO', 'F2_TIPO' } , { 'D2_DOC', 'F2_DOC' }, { 'D2_SERIE', 'F2_SERIE' }, { 'D2_CLIENTE', 'F2_CLIENTE' }, { 'D2_LOJA', 'F2_LOJA' } }, SD2->(IndexKey(1)) ) // D2_FILIAL, D2_TIPO, D2_DOC, D2_SERIE, D2_CLIENTE, D2_LOJA
	Else 
		oModel:AddGrid( 'SELECTDETAIL', 'CABMASTER', oStrSel, /*bLinPre*/, /*bLinPos*/ ,,, )
		oModel:GetModel( 'SELECTDETAIL' ):SetDescription(STR0005) //Documentos Vinculados
	EndIf

	oModel:GetModel( 'SELECTDETAIL' ):SetOptional(.T.)
	
	oModel:AddGrid( 'FILTDETAIL', 'CABMASTER', oStrFil, /*bLinPre*/, /*bLinPos*/ ,,, )
	oModel:GetModel( 'FILTDETAIL' ):SetDescription(STR0006) //Resultado do Filtro
	oModel:GetModel('FILTDETAIL'):SetNoInsertLine(.T.)
	oModel:GetModel('FILTDETAIL'):SetNoDeleteLine(.T.)
	oModel:GetModel( 'FILTDETAIL' ):SetOptional(.T.)

	oStrIte:SetProperty( "*" , MODEL_FIELD_OBRIGAT, .F. )
	oStrFil:SetProperty( "*" , MODEL_FIELD_OBRIGAT, .F. )
	oStrSel:SetProperty( "*" , MODEL_FIELD_OBRIGAT, .F. )
	oModel:SetPrimaryKey({'F2_DOC', 'F2_SERIE','F2_CLIENTE','F2_LOJA'})

	If __cTpVinc == OP_VINC_ITEM
		oModel:GetModel('ITENSDETAIL'):SetNoInsertLine(.T.)
		oModel:GetModel('ITENSDETAIL' ):SetOnlyView(.T.)  
	EndIf

	oModel:SetVldActivate( {|| .T. } )

	//--------------------------------------
	//		Realiza carga dos grids antes da exibicao
	//--------------------------------------
	oModel:SetActivate( { |oModel| DOCREFGetData( oModel ) } )

Return oModel

//-------------------------------------------------------------------
/*/{Protheus.doc} ViewDef
Interface com usuário

@Return oView
@author CRM/Faturamento
@since 10/2025
/*/
//-------------------------------------------------------------------
Static Function ViewDef() As Object
	Local oModel  As Object
	Local oView   As Object
	Local oStrCab As Object
	Local oStrIte As Object
	Local oStrFil As Object
	Local oStrSel As Object

	oModel  := FWLoadModel("FATDOCREF")
	oView   := FWFormView():New()
	oStrCab := DOCREFSTRV(1)
	oStrIte := DOCREFSTRV(3)
	oStrFil := DOCREFSTRV(2,2)
	oStrSel := DOCREFSTRV(2,3)

	oStrCab:SetProperty("F2_CLIENTE",MVC_VIEW_CANCHANGE, .T.)
	oStrCab:SetProperty("F2_LOJA",MVC_VIEW_CANCHANGE, .T.)
	oStrIte:SetProperty("*",MVC_VIEW_CANCHANGE, .F.)
	oStrFil:SetProperty("*",MVC_VIEW_CANCHANGE, .F.)
	oStrSel:SetProperty("*",MVC_VIEW_CANCHANGE, .F.)

	oStrFil:SetProperty("D2_YOK",MVC_VIEW_CANCHANGE, .T.)
	oStrSel:SetProperty("D2_YOK",MVC_VIEW_CANCHANGE, .T.)

	oView:SetModel(oModel)
	oView:AddField('VIEW_CAB'	, oStrCab, 'CABMASTER')

	oView:AddGrid( 'VIEW_FILT' , oStrFil, 'FILTDETAIL' )

	oView:AddGrid( 'VIEW_SELECT' , oStrSel, 'SELECTDETAIL' )

	If __cTpVinc == OP_VINC_ITEM .Or. __lTPCPL3

		oView:CreateHorizontalBox( 'SUPERIOR'   , 030 )   
		oView:CreateHorizontalBox( 'INFERIOR'   , 030 )
		oView:CreateHorizontalBox( 'INFERIOR2'   , 040 )

		oView:AddGrid( 'VIEW_ITENS' , oStrIte, 'ITENSDETAIL' )
		oView:SetOwnerView( 'VIEW_ITENS', 'INFERIOR')
		oView:EnableTitleView('VIEW_ITENS', STR0003) //Itens

		oView:SetViewProperty('VIEW_ITENS', 'CHANGELINE', {{ |oView| changeItLin(oView) }})
	Else
		oView:CreateHorizontalBox( 'SUPERIOR'   , 030 )   
		oView:CreateHorizontalBox( 'INFERIOR2'   , 070 )
	EndIf

	oView:CreateVerticalBox( 'EMCIMAESQ', 90, 'SUPERIOR' )
	oView:CreateVerticalBox( 'EMCIMADIR', 10, 'SUPERIOR' )

	oView:SetOwnerView( 'VIEW_CAB', 'EMCIMAESQ') 

	oView:CreateVerticalBox("FILTRO", 50,'INFERIOR2')
	oView:CreateVerticalBox("SELECT", 50, 'INFERIOR2')

	oView:SetOwnerView( 'VIEW_FILT', 'FILTRO')

	oView:SetOwnerView( 'VIEW_SELECT', 'SELECT') 

	oView:AddOtherObject("PANEL1", {|oPanel| BuscaDoc(oPanel)}) //Buscas Documentos
	oView:SetOwnerView("PANEL1",'EMCIMADIR')

	oView:EnableTitleView('VIEW_SELECT', STR0004) //Documentos selecionados
	oView:EnableTitleView('VIEW_FILT', STR0006) //Resultado do filtro

	oStrCab:AddGroup( 'GRP_FATDOCREF_001', STR0007, '', 2 )

	oStrCab:SetProperty( '*'  , MVC_VIEW_GROUP_NUMBER, 'GRP_FATDOCREF_001' )

	oView:showInsertMsg(.F.) // -- Desativa a mensagem registro inserido.
	oView:SetViewAction('ASKONCANCELSHOW', {|oView| .F.}) // -- Desativa mensagem de "há alterações não salvas"

Return oView

//-------------------------------------------------------------------
/*/{Protheus.doc} DOCREFSTRM
Campos do modelo

@Param nOpc, numeric, Código referente a estrutura do modelo
@Param nGrid, numeric, Código referente a grid dos itens filtrados e vinculados

@Return oStructMn
@author CRM/Faturamento
@since 10/2025
/*/
//-------------------------------------------------------------------
Static Function DOCREFSTRM(nOpc As Numeric, nGrid As Numeric) As Object

	Local aTamSX3	As Array
	Local cTitle 	As Character
	Local oMdlSF2	As Object
	Local oStructMn	As Object

	Default nOpc := 1
	Default nGrid := 2

	aTamSX3		:= {}
	cTitle 		:= ""
	oMdlSF2		:= Nil
	oStructMn 	:= FWFormModelStruct():New()

	If nOpc == 1 //-- Estrutura do Modelo - CABEÇALHO 

		aTamSX3	:= TamSX3("F2_CLIENTE")
		cTitle := GetSX3Cache('F2_CLIENTE', 'X3_TITULO')
		oStructMn:AddField(cTitle, cTitle, 'F2_CLIENTE', 'C', aTamSX3[1], aTamSX3[2], /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .F., , .F., .T., .T.) 

		aTamSX3	:= TamSX3("F2_LOJA")
		cTitle := GetSX3Cache('F2_LOJA', 'X3_TITULO')
		oStructMn:AddField(cTitle, cTitle, 'F2_LOJA', 'C', aTamSX3[1], aTamSX3[2], /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .F., , .F., .T., .T.)

		aTamSX3	:= TamSX3("F2_DOC")
		cTitle := GetSX3Cache('F2_DOC', 'X3_TITULO')
		oStructMn:AddField(cTitle , cTitle , 'F2_DOC'  , 'C', aTamSX3[1], aTamSX3[2], /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .F., , .F., .T., .T.)
		oStructMn:AddTrigger("F2_DOC"  , "F2_SERIE",{|| .T. },{||TriDocSeri() })

		aTamSX3	:= TamSX3("F2_SERIE")
		cTitle := GetSX3Cache('F2_SERIE', 'X3_TITULO')
		oStructMn:AddField(cTitle , cTitle , 'F2_SERIE' , 'C', aTamSX3[1], aTamSX3[2], /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .F., , .F., .T., .T.)

		aTamSX3	:= TamSX3("F2_EMISSAO")
		oStructMn:AddField(STR0010, STR0010, 'F2_DTDE', 'D', aTamSX3[1], aTamSX3[2], /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .F., , .F., .T., .T.) //Emissão Inicial

		aTamSX3	:= TamSX3("F2_EMISSAO")
		oStructMn:AddField(STR0011, STR0011, 'F2_DTATE', 'D', aTamSX3[1], aTamSX3[2], /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .F., , .F., .T., .T.) //Emissão Final
		
		aTamSX3	:= TamSX3("F2_CHVNFE")
		oStructMn:AddField(STR0019, STR0019, 'F2_CHVNFE', 'C', aTamSX3[1], aTamSX3[2], /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .F., , .F., .T., .T.) //Chave NF

	ElseIf nOpc == 2 //-- Estrutura do Modelo - ITENS 

		If nGrid == 2 // -- Grid de filtro
			aTamSX3	:= TamSX3("AL_DOCAE")
			oStructMn:AddField(STR0008, STR0008, 'D2_YOK'  , 'L', aTamSX3[1], aTamSX3[2]    , {|| setVinc()}, {|| .T.}, {}, .T., , .F., .T., .T.) //Selecionar
		ElseIf nGrid == 3  // -- Grid de Documentos vinculados
			aTamSX3	:= TamSX3("AL_DOCAE")
			oStructMn:AddField(STR0009, STR0009, 'D2_YOK'  , 'L', aTamSX3[1], aTamSX3[2]    , {|| delVinc()}, {|| .T.}, {}, .T., , .F., .T., .T.) //Remover
		EndIf

		If __cTpVinc == OP_VINC_ITEM

			oMdlSF2	:= oModelNCND:GetModel("CABMASTER")

			If oMdlSF2:GetValue("F2_TIPO") == "6" .And. oMdlSF2:GetValue("F2_TPCOMPL") == "7"
				aTamSX3	:= TamSX3("D1_ITEM")
			Else
				aTamSX3	:= TamSX3("D2_ITEM")
			EndIf

			cTitle := GetSX3Cache('D2_ITEM', 'X3_TITULO')
			oStructMn:AddField(cTitle , cTitle , 'D2_ITEM'  , 'C', aTamSX3[1]    , aTamSX3[2]    , /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .T., , .F., .T., .T.) 

			aTamSX3	:= TamSX3("D1_ITXML")
			cTitle := GetSX3Cache('D1_ITXML', 'X3_TITULO')
			oStructMn:AddField(cTitle , cTitle , 'D1_ITXML'  , 'C', aTamSX3[1]    , aTamSX3[2]    , /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .T., , .F., .T., .T.) 

			aTamSX3	:= TamSX3("D2_DOC")
			cTitle := GetSX3Cache('D2_DOC', 'X3_TITULO')
			oStructMn:AddField(cTitle , cTitle , 'D2_DOC'  , 'C', aTamSX3[1]    , aTamSX3[2]    , /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .T., , .F., .T., .T.) 

			aTamSX3	:= TamSX3("D2_SERIE")
			cTitle := GetSX3Cache('D2_SERIE', 'X3_TITULO')
			oStructMn:AddField(cTitle , cTitle , 'D2_SERIE'  , 'C', aTamSX3[1]    , aTamSX3[2]    , /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .T., , .F., .T., .T.) 

			aTamSX3	:= TamSX3("D2_CLIENTE")
			cTitle := GetSX3Cache('D2_CLIENTE', 'X3_TITULO')
			oStructMn:AddField(cTitle , cTitle , 'D2_CLIENTE'  , 'C', aTamSX3[1]    , aTamSX3[2]    , /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .T., , .F., .T., .T.) 

			aTamSX3	:= TamSX3("D2_LOJA")
			cTitle := GetSX3Cache('D2_LOJA', 'X3_TITULO')
			oStructMn:AddField(cTitle , cTitle , 'D2_LOJA'  , 'C', aTamSX3[1]    , aTamSX3[2]    , /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .T., , .F., .T., .T.) 

			aTamSX3	:= TamSX3("A1_NREDUZ")
			cTitle := GetSX3Cache('A1_NREDUZ', 'X3_TITULO')
			oStructMn:AddField(cTitle , cTitle , 'D2_CLIDES'  , 'C', aTamSX3[1]    , aTamSX3[2]    , /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .T., , .F., .T., .T.) 

			aTamSX3	:= TamSX3("D2_COD")
			cTitle := GetSX3Cache('D2_COD', 'X3_TITULO')
			oStructMn:AddField(cTitle , cTitle , 'D2_COD' , 'C', aTamSX3[1], aTamSX3[2], /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .T., , .F., .T., .T.)

			aTamSX3	:= TamSX3("D2_QUANT")
			cTitle := GetSX3Cache('D2_QUANT', 'X3_TITULO')
			oStructMn:AddField(cTitle , cTitle , 'D2_QUANT' , 'N', aTamSX3[1], aTamSX3[2], /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .T., , .F., .T., .T.)

			aTamSX3	:= TamSX3("D2_PRCVEN")
			cTitle := GetSX3Cache('D2_PRCVEN', 'X3_TITULO')
			oStructMn:AddField(cTitle, cTitle, 'D2_PRCVEN', 'N', aTamSX3[1]  , aTamSX3[2]  , /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .T., , .F., .T., .T.) 

			aTamSX3	:= TamSX3("D2_TOTAL")
			cTitle := GetSX3Cache('D2_TOTAL', 'X3_TITULO')
			oStructMn:AddField(cTitle, cTitle, 'D2_TOTAL', 'N', aTamSX3[1]  , aTamSX3[2]  , /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .T., , .F., .T., .T.)

			aTamSX3	:= TamSX3("D2_EMISSAO")
			cTitle := GetSX3Cache('D2_EMISSAO', 'X3_TITULO')
			oStructMn:AddField(cTitle, cTitle, 'D2_EMISSAO', 'D', aTamSX3[1]  , aTamSX3[2]  , /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .T., , .F., .T., .T.)
		
			aTamSX3	:= TamSX3("F2_CHVNFE")
			cTitle := GetSX3Cache('F2_CHVNFE', 'X3_TITULO')
			oStructMn:AddField(cTitle , cTitle , 'F2_CHVNFE'  , 'C', aTamSX3[1]    , aTamSX3[2]    , /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .T., , .F., .T., .T.) 

			aTamSX3	:= TamSX3("F2_CODNFE")
			cTitle := GetSX3Cache('F2_CODNFE', 'X3_TITULO')
			oStructMn:AddField(cTitle , cTitle , 'F2_CODNFE'  , 'C', aTamSX3[1]    , aTamSX3[2]    , /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .T., , .F., .T., .T.) 
		Else
			aTamSX3	:= TamSX3("F2_DOC")
			cTitle := GetSX3Cache('F2_DOC', 'X3_TITULO')
			oStructMn:AddField(cTitle , cTitle , 'F2_DOC'  , 'C', aTamSX3[1]    , aTamSX3[2]    , /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .T., , .F., .T., .T.) 

			aTamSX3	:= TamSX3("F2_SERIE")
			cTitle := GetSX3Cache('F2_SERIE', 'X3_TITULO')
			oStructMn:AddField(cTitle , cTitle , 'F2_SERIE'  , 'C', aTamSX3[1]    , aTamSX3[2]    , /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .T., , .F., .T., .T.) 

			aTamSX3	:= TamSX3("F2_EMISSAO")
			cTitle := GetSX3Cache('F2_EMISSAO', 'X3_TITULO')
			oStructMn:AddField(cTitle , cTitle , 'F2_EMISSAO'  , 'D', aTamSX3[1]    , aTamSX3[2]    , /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .T., , .F., .T., .T.) 

			aTamSX3	:= TamSX3("F2_EST")
			cTitle := GetSX3Cache('F2_EST', 'X3_TITULO')
			oStructMn:AddField(cTitle , cTitle , 'F2_EST'  , 'C', aTamSX3[1]    , aTamSX3[2]    , /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .T., , .F., .T., .T.) 

			aTamSX3	:= TamSX3("F2_VALMERC")
			cTitle := GetSX3Cache('F2_VALMERC', 'X3_TITULO')
			oStructMn:AddField(cTitle , cTitle , 'F2_VALMERC'  , 'N', aTamSX3[1]    , aTamSX3[2]    , /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .T., , .F., .T., .T.) 

			aTamSX3	:= TamSX3("F2_CHVNFE")
			cTitle := GetSX3Cache('F2_CHVNFE', 'X3_TITULO')
			oStructMn:AddField(cTitle , cTitle , 'F2_CHVNFE'  , 'C', aTamSX3[1]    , aTamSX3[2]    , /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .T., , .F., .T., .T.) 

			aTamSX3	:= TamSX3("F2_CODNFE")
			cTitle := GetSX3Cache('F2_CODNFE', 'X3_TITULO')
			oStructMn:AddField(cTitle , cTitle , 'F2_CODNFE'  , 'C', aTamSX3[1]    , aTamSX3[2]    , /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .T., , .F., .T., .T.) 

			aTamSX3	:= TamSX3("F2_CLIENTE")
			cTitle := GetSX3Cache('F2_CLIENTE', 'X3_TITULO')
			oStructMn:AddField(cTitle , cTitle , 'F2_CLIENTE'  , 'C', aTamSX3[1]    , aTamSX3[2]    , /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .T., , .F., .T., .T.) 

			aTamSX3	:= TamSX3("F2_LOJA")
			cTitle := GetSX3Cache('F2_LOJA', 'X3_TITULO')
			oStructMn:AddField(cTitle , cTitle , 'F2_LOJA'  , 'C', aTamSX3[1]    , aTamSX3[2]    , /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .T., , .F., .T., .T.) 

			If __lTPCPL3
				
				cTitle := GetSX3Cache('D2_ITEM', 'X3_TITULO')
				oStructMn:AddField(cTitle , cTitle , 'D2_ITEM'  , 'C', aTamSX3[1]    , aTamSX3[2]    , /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .T., , .F., .T., .T.) 

				aTamSX3	:= TamSX3("D2_COD")
				cTitle := GetSX3Cache('D2_COD', 'X3_TITULO')
				oStructMn:AddField(cTitle , cTitle , 'D2_COD' , 'C', aTamSX3[1], aTamSX3[2], /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .T., , .F., .T., .T.)
			EndIF
		
		EndIf
	ElseIf nOpc == 3 // -- Grid de itens

		aTamSX3	:= TamSX3("D2_ITEM")
		cTitle := GetSX3Cache('D2_ITEM', 'X3_TITULO')
		oStructMn:AddField(cTitle , cTitle , 'D2_ITEM'  , 'C', aTamSX3[1]    , aTamSX3[2]    , /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .T., , .F., .T., .T.) 

		aTamSX3	:= TamSX3("D2_COD")
		cTitle := GetSX3Cache('D2_COD', 'X3_TITULO')
		oStructMn:AddField(cTitle , cTitle , 'D2_COD'  , 'C', aTamSX3[1]    , aTamSX3[2]    , /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .T., , .F., .T., .T.) 

		aTamSX3	:= TamSX3("B1_DESC")
		cTitle := GetSX3Cache('B1_DESC', 'X3_TITULO')
		oStructMn:AddField(cTitle , cTitle , 'D2_PRODESC'  , 'C', aTamSX3[1]    , aTamSX3[2]    , /*{|a,b,c,d| VldFields(a,b,c,d)}*/, {|| .T.}, {}, .T., , .F., .T., .T.) 
	EndIf

	FwFreeArray(aTamSX3)
Return oStructMn

//-------------------------------------------------------------------
/*/{Protheus.doc} DOCREFSTRV
Campos da View

@Param nOpc, numeric, Código referente a estrutura da view
@Param nGrid, numeric, Código referente a grid dos itens filtrados e vinculados

@Return oStructMn
@author CRM/Faturamento
@since 10/2025
/*/
//-------------------------------------------------------------------
Static Function DOCREFSTRV(nOpc As Numeric, nGrid As Numeric) As Object
	Local cTitle 	 As Character
	Local oStructMn	 As Object
	Local cConsuCli	 As Character
	Local cConsuDoc	 As Character
	Local cTitleCli	 As Character
	Local cTitleDesc As Character

	Default nOpc  := 1
	Default nGrid := 2

	cTitle 		:= ""
	cTitleCli	:= ""
	cTitleDesc  := STR0020 // -- Descr Cli
	cConsuCli	:= "SA1"
	cConsuDoc	:= "SF2"
	oStructMn	:= FWFormViewStruct():New()

	If nOpc == 1 // -- Estrutura da VIEW - Cabeçalho 

		cTitleCli := GetSX3Cache('F2_CLIENTE', 'X3_TITULO')
		If oModelNCND:GetModel("CABMASTER"):GetValue("F2_TPCOMPL") $ "1257"
			cTitleCli := GetSX3Cache('F1_FORNECE', 'X3_TITULO')
			cConsuCli := "SA2"
			cConsuDoc := "SF1"
		EndIf

		cTitle := GetSX3Cache('F2_DOC', 'X3_TITULO')
		oStructMn:AddField('F2_DOC'  , '01', cTitle , cTitle ,, 'C' , PesqPict("SF2","F2_DOC") , , cConsuDoc , .T., , , , , , .T., , ) 

		cTitle := GetSX3Cache('F2_SERIE', 'X3_TITULO')
		oStructMn:AddField('F2_SERIE' , '02', cTitle , cTitle ,, 'C' , PesqPict("SF2","F2_SERIE") , , '' , .T., , , , , , .T., , ) 

		oStructMn:AddField('F2_CLIENTE', '03', cTitleCli, cTitleCli,, 'C' , PesqPict("SF2","F2_CLIENTE") , , cConsuCli , .T., , , , , , .T., , ) 

		cTitle := GetSX3Cache('F2_LOJA', 'X3_TITULO')
		oStructMn:AddField('F2_LOJA'  , '04', cTitle , cTitle ,, 'C' , PesqPict("SF2","F2_LOJA") , , '' , .T., , , , , , .T., , )

		oStructMn:AddField('F2_DTDE'  , '05', STR0010, STR0010,, 'D' , PesqPict("SF2","F2_EMISSAO") , , '' , .T., , , , , , .T., , )

		oStructMn:AddField('F2_DTATE' , '06', STR0011, STR0011,, 'D' , PesqPict("SF2","F2_EMISSAO") , , '' , .T., , , , , , .T., , )

		cTitle := GetSX3Cache('F2_CHVNFE', 'X3_TITULO')
		oStructMn:AddField('F2_CHVNFE' , '07', cTitle , cTitle ,, 'C' , PesqPict("SF2","F2_CHVNFE"   ) , , '' , .T., , , , , , .T., , ) 
	ElseIf nOpc == 2 // Estrutura da VIEW - Filtro

		If nGrid == 2 // -- Grid de filtro
			oStructMn:AddField('D2_YOK'  , '01',STR0008, STR0008,, 'L' , PesqPict("SAL","AL_DOCAE") , , '' , .T., , , , , , .T., , ) // -- Selecionar
		ElseIf nGrid == 3 // -- Grid de Documentos vinculados 
			oStructMn:AddField('D2_YOK'  , '01',STR0009, STR0009,, 'L' , PesqPict("SAL","AL_DOCAE") , , '' , .T., , , , , , .T., , ) // -- Remover
		EndIf

		If __cTpVinc == OP_VINC_ITEM //-- Quando o vínculo For por item
			
			cTitleCli := GetSX3Cache('F2_CLIENTE', 'X3_TITULO')
			If oModelNCND:GetModel("CABMASTER"):GetValue("F2_TPCOMPL") == "7"
				cTitleCli := GetSX3Cache('F1_FORNECE', 'X3_TITULO')
				cTitleDesc := STR0023 // -- Descr Forn
			EndIf

			cTitle := GetSX3Cache('D2_ITEM', 'X3_TITULO')
			oStructMn:AddField('D2_ITEM'  , '02', cTitle , cTitle ,, 'C' , PesqPict("SD2","D2_ITEM") , , '' , .T., , , , , , .T., , )

			cTitle := GetSX3Cache('D1_ITXML', 'X3_TITULO')
			oStructMn:AddField('D1_ITXML'  , '03', cTitle , cTitle ,, 'C' , PesqPict("SD1","D1_ITXML") , , '' , .T., , , , , , .T., , )

			cTitle := GetSX3Cache('D2_DOC', 'X3_TITULO')
			oStructMn:AddField('D2_DOC'  , '04', cTitle , cTitle ,, 'C' , PesqPict("SD2","D2_DOC") , , '' , .T., , , , , , .T., , ) 

			cTitle := GetSX3Cache('D2_SERIE', 'X3_TITULO')
			oStructMn:AddField('D2_SERIE'  , '05', cTitle , cTitle ,, 'C' , PesqPict("SD2","D2_SERIE") , , '' , .T., , , , , , .T., , ) 

			cTitle := GetSX3Cache('D2_CLIENTE', 'X3_TITULO')
			oStructMn:AddField('D2_CLIENTE'  , '06', cTitleCli , cTitleCli ,, 'C' , PesqPict("SD2","D2_CLIENTE") , , '' , .T., , , , , , .T., , ) 

			cTitle := GetSX3Cache('D2_LOJA', 'X3_TITULO')
			oStructMn:AddField('D2_LOJA'  , '07', cTitle , cTitle ,, 'C' , PesqPict("SD2","D2_LOJA") , , '' , .T., , , , , , .T., , ) 

			oStructMn:AddField('D2_CLIDES'  , '08', cTitleDesc, cTitleDesc,, 'C' , PesqPict("SA1","A1_NREDUZ") , , '' , .T., , , , , , .T., , ) 

			cTitle := GetSX3Cache('D2_COD', 'X3_TITULO')
			oStructMn:AddField('D2_COD'  , '09', cTitle , cTitle ,, 'C' , PesqPict("SD2","D2_COD") , , '' , .T., , , , , , .T., , ) 

			cTitle := GetSX3Cache('D2_QUANT', 'X3_TITULO')
			oStructMn:AddField('D2_QUANT' , '10', cTitle , cTitle ,, 'N' , PesqPict("SD2","D2_QUANT") , , '' , .T., , , , , , .T., , )

			cTitle := GetSX3Cache('D2_PRCVEN', 'X3_TITULO')
			oStructMn:AddField('D2_PRCVEN'  , '11', cTitle , cTitle ,, 'N' , PesqPict("SD2","D2_PRCVEN") , , '' , .T., , , , , , .T., , )  

			cTitle := GetSX3Cache('D2_TOTAL', 'X3_TITULO')
			oStructMn:AddField('D2_TOTAL', '12', cTitle, cTitle,, 'N' , PesqPict("SD2","D2_TOTAL") , ,       , .T., , , , , , .T., , ) 

			cTitle := GetSX3Cache('D2_EMISSAO', 'X3_TITULO')
			oStructMn:AddField('D2_EMISSAO', '13', cTitle, cTitle,, 'D' , PesqPict("SD2","D2_EMISSAO") , ,       , .T., , , , , , .T., , ) 
		
			cTitle := GetSX3Cache('F2_CHVNFE', 'X3_TITULO')
			oStructMn:AddField('F2_CHVNFE' , '14', cTitle , cTitle ,, 'C' , PesqPict("SF2","F2_CHVNFE"   ) , , '' , .T., , , , , , .T., , ) 

			cTitle := GetSX3Cache('F2_CODNFE', 'X3_TITULO')
			oStructMn:AddField('F2_CODNFE' , '15', cTitle , cTitle ,, 'C' , PesqPict("SF2","F2_CODNFE"   ) , , '' , .T., , , , , , .T., , ) 
		Else
			cTitle := GetSX3Cache('F2_DOC', 'X3_TITULO')
			oStructMn:AddField('F2_DOC'  , '02', cTitle , cTitle ,, 'C' , PesqPict("SF2","F2_DOC"    ) , , 'SF2' , .T., , , , , , .T., , ) 

			cTitle := GetSX3Cache('F2_SERIE', 'X3_TITULO')
			oStructMn:AddField('F2_SERIE' , '03', cTitle , cTitle ,, 'C' , PesqPict("SF2","F2_SERIE"   ) , , '' , .T., , , , , , .T., , )

			cTitle := GetSX3Cache('F2_EMISSAO', 'X3_TITULO')
			oStructMn:AddField('F2_EMISSAO', '04', cTitle, cTitle,, 'D' , PesqPict("SF2","F2_EMISSAO") , ,       , .T., , , , , , .T., , ) 

			cTitle := GetSX3Cache('F2_EST', 'X3_TITULO')
			oStructMn:AddField('F2_EST', '05', cTitle, cTitle,, 'C' , PesqPict("SF2","F2_EST") , ,       , .T., , , , , , .T., , )

			cTitle := GetSX3Cache('F2_VALMERC', 'X3_TITULO')
			oStructMn:AddField('F2_VALMERC', '06', cTitle, cTitle,, 'N' , PesqPict("SF2","F2_VALMERC") , ,       , .T., , , , , , .T., , )

			cTitle := GetSX3Cache('F2_CHVNFE', 'X3_TITULO')
			oStructMn:AddField('F2_CHVNFE' , '07', cTitle , cTitle ,, 'C' , PesqPict("SF2","F2_CHVNFE"   ) , , '' , .T., , , , , , .T., , ) 

			cTitle := GetSX3Cache('F2_CLIENTE', 'X3_TITULO')
			oStructMn:AddField('F2_CLIENTE'  , '08', cTitle , cTitle ,, 'C' , PesqPict("SF2","F2_CLIENTE") , , '' , .T., , , , , , .T., , ) 
			
			cTitle := GetSX3Cache('F2_LOJA', 'X3_TITULO')
			oStructMn:AddField('F2_LOJA'  , '09', cTitle , cTitle ,, 'C' , PesqPict("SF2","F2_LOJA") , , '' , .T., , , , , , .T., , ) 

			cTitle := GetSX3Cache('F2_CODNFE', 'X3_TITULO')
			oStructMn:AddField('F2_CODNFE' , '12', cTitle , cTitle ,, 'C' , PesqPict("SF2","F2_CODNFE"   ) , , '' , .T., , , , , , .T., , ) 

			If __lTPCPL3		
			    cTitle := GetSX3Cache('D2_ITEM', 'X3_TITULO')
			    oStructMn:AddField('D2_ITEM'  , '10', cTitle , cTitle ,, 'C' , PesqPict("SD2","D2_ITEM") , , '' , .T., , , , , , .T., , )
				cTitle := GetSX3Cache('D2_COD', 'X3_TITULO')
				oStructMn:AddField('D2_COD'  , '11', cTitle , cTitle ,, 'C' , PesqPict("SD2","D2_COD") , , '' , .T., , , , , , .T., , ) 
			EndIf
		EndIf 
	ElseIf nOpc == 3 // -- Grid de itens

		cTitle := GetSX3Cache('D2_ITEM', 'X3_TITULO')
		oStructMn:AddField('D2_ITEM'  , '02', cTitle , cTitle ,, 'C' , PesqPict("SD2","D2_ITEM"    ) , , '' , .T., , , , , , .T., , )

		cTitle := GetSX3Cache('D2_COD', 'X3_TITULO')
		oStructMn:AddField('D2_COD'  , '03', cTitle , cTitle ,, 'C' , PesqPict("SD2","D2_COD"    ) , , '' , .T., , , , , , .T., , ) 

		cTitle := GetSX3Cache('B1_DESC', 'X3_TITULO')
		oStructMn:AddField('D2_PRODESC'  , '04', cTitle , cTitle ,, 'C' , PesqPict("SB1","B1_DESC"    ) , , '' , .T., , , , , , .T., , ) 
	EndIf
Return oStructMn

//--------------------------------------------------------------------
/*/{Protheus.doc} DOCREFGetData()
Realiza a carga de dados de acordo com a operação

@Param oModel, objeto, Modelo de Dados

@Return .T.
@author CRM/Faturamento
@since 10/2025
/*/
//--------------------------------------------------------------------
Static Function DOCREFGetData(oModel As Object) As Array
	Local aDados  	 As Array
	Local aItVinc    As Array
	Local aAreaSF2	 As Array
	Local aAreaSD2 	 As Array
	Local cFilSB1	 As Character
	Local cFilSF2	 As Character
	Local cFilSD2	 As Character
	Local cFilDKN	 As Character
	Local nX 		 As Numeric
	Local nZ 		 As Numeric
	Local nPos 		 As Numeric
	Local oMdlCab    As Object
	Local oMdlItens  As Object
	Local oMdlSel 	 As Object
	Local oMdlSF2 	 As Object
	Local oMdlSD2 	 As Object

	Default oModel := FwModelActive()

	aDados    := {}
	aItVinc   := {}
	aAreaSF2  := SF2->(GetArea())
	aAreaSD2  := SD2->(GetArea())
	cFilSB1	  := FWxFilial("SB1")
	cFilSF2	  := FWxFilial("SF2")
	cFilSD2	  := FWxFilial("SD2")
	cFilDKN	  := FWxFilial("DKN")
	nX 		  := 1
	nZ 		  := 1
	nPos 	  := 1
	oMdlCab   := nil
	oMdlItens := nil
	oMdlSel   := nil

	oMdlCab := oModel:GetModel('CABMASTER')
	oMdlSel := oModel:GetModel('SELECTDETAIL')

	oMdlCab:GetStruct():SetProperty("F2_CLIENTE",MVC_VIEW_CANCHANGE, .T.)
	oMdlCab:GetStruct():SetProperty("F2_LOJA",MVC_VIEW_CANCHANGE, .T.)

	oMdlCab:SetValue('F2_CLIENTE', Alltrim(jFld600["A1_COD"]))
	oMdlCab:SetValue('F2_LOJA', Alltrim(jFld600["A1_LOJA"]))

	If jFld600["F2_TPCOMPL"] $ "125"
		oMdlCab:SetValue('F2_CLIENTE', Space(TamSx3("F2_CLIENTE")[1]))
		oMdlCab:SetValue('F2_LOJA', Space(TamSx3("F2_LOJA")[1]))
	EndIf

	oMdlCab:GetStruct():SetProperty("F2_CLIENTE",MVC_VIEW_CANCHANGE, .F.)
	oMdlCab:GetStruct():SetProperty("F2_LOJA",MVC_VIEW_CANCHANGE, .F.)

	If __cTpVinc == OP_VINC_ITEM .Or. __lTPCPL3

		oMdlItens  := oModel:GetModel("ITENSDETAIL")

		oMdlItens:SetNoInsertLine(.F.)

		oMdlSF2	:= oModelNCND:GetModel("CABMASTER")
		oMdlSD2	:= oModelNCND:GetModel("ITENSDETAIL")

		For nX := 1 To oMdlSD2:Length()

			oMdlSD2:GoLine(nX)
			If !oMdlSD2:IsDeleted(nX)
				If nX > 1
					oMdlItens:AddLine()
				EndIf
				oMdlItens:LoadValue('D2_ITEM', oMdlSD2:GetValue("D2_ITEM"))
				oMdlItens:LoadValue('D2_COD',  oMdlSD2:GetValue("D2_COD"))
				oMdlItens:LoadValue('D2_PRODESC', Alltrim(getAdvFval("SB1","B1_DESC",cFilSB1 + oMdlSD2:GetValue("D2_COD"),1)))

				// -- Reabertura de tela, o Json já tem dados vinculados.
				If jDocRef <> nil .and. jDocRef:hasproperty('itens') .and.  len(jDocRef['itens']) > 0
					aDados := jDocRef["itens"]
					nPos := aScan(aDados, {|x| x['item'] + alltrim(x['produto'])  == oMdlSD2:GetValue("D2_ITEM") + Alltrim(oMdlSD2:GetValue("D2_COD")) })
					If nPos > 0
						aItVinc := jDocRef["itens"][nPos]['documentos']
						For nZ := 1 To len(aItVinc)

							If nZ > 1
								oMdlSel:AddLine()
							EndIf
							oMdlSel:LoadValue("D2_YOK", .F.)
							oMdlSel:LoadValue("D2_ITEM", 		aItVinc[nZ]['item'])

							If  __lTPCPL3
								oMdlSel:LoadValue("F2_DOC", aItVinc[nZ]['documento'])
								oMdlSel:LoadValue("F2_SERIE", aItVinc[nZ]['serie'])
								oMdlSel:LoadValue("F2_CHVNFE", aItVinc[nZ]['chave'])
								oMdlSel:LoadValue("F2_CODNFE", aItVinc[nZ]['codnfe'])
								oMdlSel:LoadValue("F2_VALMERC", aItVinc[nZ]['valor'])
								oMdlSel:LoadValue("F2_EST", aItVinc[nZ]['estado'])			
								oMdlSel:LoadValue("F2_EMISSAO", aItVinc[nZ]['emissao'])
							Else
								If oMdlSF2:GetValue("F2_TIPO") == "6" .And. oMdlSF2:GetValue("F2_TPCOMPL") $ "47"
									oMdlSel:LoadValue("D1_ITXML", 		aItVinc[nZ]['itemxml'])
								EndIf
								oMdlSel:LoadValue("D2_COD", 		alltrim(jDocRef["itens"][nPos]['produto']))
								oMdlSel:LoadValue("D2_DOC", 		aItVinc[nZ]['documento'])
								oMdlSel:LoadValue("D2_SERIE", 		aItVinc[nZ]['serie'])
								oMdlSel:LoadValue("D2_CLIENTE", 	aItVinc[nZ]['cliente'])
								oMdlSel:LoadValue("D2_LOJA", 		aItVinc[nZ]['loja'])
								oMdlSel:LoadValue("D2_CLIDES", 		aItVinc[nZ]['nomefor'])			
								oMdlSel:LoadValue("D2_PRCVEN", 		aItVinc[nZ]['valorunit'])
								oMdlSel:LoadValue("D2_QUANT", 		aItVinc[nZ]['quantidade'])
								oMdlSel:LoadValue("D2_TOTAL", 		aItVinc[nZ]['valortotal'])
								oMdlSel:LoadValue("D2_EMISSAO", 	aItVinc[nZ]['emissao'])
								oMdlSel:LoadValue("F2_CHVNFE", 		aItVinc[nZ]['chave'])
								oMdlSel:LoadValue("F2_CODNFE", 		aItVinc[nZ]['codnfe'])
							EndIf
						Next nZ
					EndIf
				EndIf
			EndIf
		Next nX

		oMdlItens:GoLine(1)
		oMdlItens:SetNoInsertLine(.T.)
	Else 
		// -- Reabertura de tela, o Json já tem dados vinculados.
		If jDocRef <> nil .and. jDocRef:hasproperty('documentos') .and.  len(jDocRef['documentos']) > 0
			aDados := jDocRef["documentos"]
			For nX := 1 To len(jDocRef["documentos"])

				If nX > 1
					oMdlSel:AddLine()
				EndIf

				oMdlSel:LoadValue("F2_DOC", aDados[nX]['documento'])
				oMdlSel:LoadValue("F2_SERIE", aDados[nX]['serie'])
				oMdlSel:LoadValue("F2_CHVNFE", aDados[nX]['chave'])
				oMdlSel:LoadValue("F2_CODNFE", aDados[nX]['codnfe'])
				oMdlSel:LoadValue("F2_VALMERC", aDados[nX]['valor'])
				oMdlSel:LoadValue("F2_EST", aDados[nX]['estado'])			
				oMdlSel:LoadValue("F2_EMISSAO", aDados[nX]['emissao'])
			Next nX
		EndIf
	EndIf

	SD2->(RestArea(aAreaSD2))
	SF2->(RestArea(aAreaSF2))
	FwFreeArray(aAreaSF2)
	FwFreeArray(aAreaSD2)

Return .T.

//-------------------------------------------------------------------
/*/{Protheus.doc} FATDOCREFCommit
Função de commit do modelo

@Param oModel, objeto, Modelo de Dados

@Return .T. 
@author CRM/Faturamento
@since 10/2025
/*/
//-------------------------------------------------------------------
Function FATDOCREFCommit(oModel As Object) As Logical
	Local aDocVinc 	As Array
	Local aItemVinc	As Array
	Local nX 		As Numeric
	Local nZ 		As Numeric

	Local oMdlCab   As Object
	Local oMdlIte   As Object
	Local oMdlSel   As Object
		
	aDocVinc 	:= {}
	aItemVinc	:= {}
	nX 			:= 1
	nZ 			:= 1

	oMdlCab  	:= Nil
	oMdlIte  	:= Nil
	oMdlSel  	:= Nil

	jDocRef := JsonObject():New()

	oMdlCab  := oModel:GetModel("CABMASTER")
	oMdlSel  := oModel:GetModel("SELECTDETAIL")
	oMdlIte  := oModel:GetModel("ITENSDETAIL")

	If __cTpVinc == OP_VINC_NF

		jDocRef['numero'] 	:= Alltrim(jFld600["F2_DOC"])
		jDocRef['serie'] 		:= Alltrim(jFld600["F2_SERIE"])
		jDocRef['cliente'] := oMdlCab:GetValue("F2_CLIENTE")
		jDocRef['loja'] 		:= oMdlCab:GetValue("F2_LOJA")
	
		If __lTPCPL3
			jDocRef['itens'] 	:= {}
			For nZ := 1 To oMdlIte:Length()

				oMdlIte:GoLine(nZ)
				oMdlSel:GoLine(1)
				
			 	If !Empty(oMdlSel:GetValue('F2_DOC', 1)) //-- Se tiver ao menos um vinculo.

					aAdd(aItemVinc, JsonObject():New())
					aItemVinc[len(aItemVinc)]["item"]   	:= oMdlIte:GetValue('D2_ITEM',nZ)
					aItemVinc[len(aItemVinc)]["produto"]   	:= oMdlIte:GetValue('D2_COD',nZ)
					For nX := 1 To oMdlSel:Length()
						oMdlSel:GoLine(nX)
						If !oMdlSel:IsDeleted()
							aAdd(aDocVinc, JsonObject():New())
							aDocVinc[len(aDocVinc)]["item"]	:=      ""
							aDocVinc[len(aDocVinc)]["documento"]   := oMdlSel:GetValue("F2_DOC", nX)
							aDocVinc[len(aDocVinc)]["serie"]   	:= oMdlSel:GetValue("F2_SERIE", nX)
							aDocVinc[len(aDocVinc)]["chave"]   	:= oMdlSel:GetValue('F2_CHVNFE', nX)
							aDocVinc[len(aDocVinc)]["codnfe"]	:= oMdlSel:GetValue('F2_CODNFE', nX)
							aDocVinc[len(aDocVinc)]["valor"]   	:= oMdlSel:GetValue('F2_VALMERC', nX)
							aDocVinc[len(aDocVinc)]["estado"]  	:= oMdlSel:GetValue('F2_EST', nX)
							aDocVinc[len(aDocVinc)]["emissao"] 	:= oMdlSel:GetValue('F2_EMISSAO', nX)
							aDocVinc[len(aDocVinc)]["cliente"] 	:= oMdlSel:GetValue('F2_CLIENTE', nX)
							aDocVinc[len(aDocVinc)]["loja"] 	:= oMdlSel:GetValue('F2_LOJA', nX)
						EndIf
					Next nX
					aItemVinc[len(aItemVinc)]["documentos"] := aClone(aDocVinc)
					aDocVinc  := {}
				EndIf
			Next nZ
			jDocRef['itens'] := aClone(aItemVinc)
		Else
			jDocRef['documentos'] := {}
			For nX := 1 To oMdlSel:Length()

				If !oMdlSel:IsDeleted()
					aAdd(aDocVinc, JsonObject():New())
					aDocVinc[len(aDocVinc)]["documento"]   := oMdlSel:GetValue("F2_DOC", nX)
					aDocVinc[len(aDocVinc)]["serie"]   	:= oMdlSel:GetValue("F2_SERIE", nX)
					aDocVinc[len(aDocVinc)]["chave"]   	:= oMdlSel:GetValue('F2_CHVNFE', nX)
					aDocVinc[len(aDocVinc)]["codnfe"]  	:= oMdlSel:GetValue('F2_CODNFE', nX)
					aDocVinc[len(aDocVinc)]["valor"]   	:= oMdlSel:GetValue('F2_VALMERC', nX)
					aDocVinc[len(aDocVinc)]["estado"]  	:= oMdlSel:GetValue('F2_EST', nX)
					aDocVinc[len(aDocVinc)]["emissao"] 	:= oMdlSel:GetValue('F2_EMISSAO', nX)
					aDocVinc[len(aDocVinc)]["cliente"] 	:= oMdlSel:GetValue('F2_CLIENTE', nX)
					aDocVinc[len(aDocVinc)]["loja"] 	:= oMdlSel:GetValue('F2_LOJA', nX)
				EndIf
			Next nX

			jDocRef['documentos'] := aClone(aDocVinc)
		EndIf
	Else
		jDocRef['numero'] 	:= Alltrim(jFld600["F2_DOC"])
		jDocRef['serie'] 	:= Alltrim(jFld600["F2_SERIE"])
		jDocRef['cliente'] 	:= oMdlCab:GetValue("F2_CLIENTE")
		jDocRef['loja'] 	:= oMdlCab:GetValue("F2_LOJA")
		jDocRef['itens'] 	:= {}

		For nZ := 1 To oMdlIte:Length()
			oMdlIte:GoLine(nZ)

			oMdlSel:GoLine(1)
			If !empty(oMdlSel:GetValue('D2_DOC')) //-- Se tiver ao menos um vinculo.

				aAdd(aItemVinc, JsonObject():New())
				aItemVinc[len(aItemVinc)]["item"]   	:= oMdlIte:GetValue('D2_ITEM')
				aItemVinc[len(aItemVinc)]["produto"]   	:= oMdlIte:GetValue('D2_COD')

				For nX := 1 To oMdlSel:Length()
					oMdlSel:GoLine(nX)

					If !oMdlSel:IsDeleted()
						aAdd(aDocVinc, JsonObject():New())
						aDocVinc[len(aDocVinc)]["item"]	:= oMdlSel:GetValue('D2_ITEM')
						If jFld600["F2_TPCOMPL"] == "4"
							aDocVinc[len(aDocVinc)]["itemxml"] 	:= oMdlSel:GetValue('D2_ITEM')
						Else
							aDocVinc[len(aDocVinc)]["itemxml"]	:= oMdlSel:GetValue('D1_ITXML')
						EndIf
						aDocVinc[len(aDocVinc)]["documento"]	:= oMdlSel:GetValue('D2_DOC')
						aDocVinc[len(aDocVinc)]["serie"]   		:= oMdlSel:GetValue('D2_SERIE')
						aDocVinc[len(aDocVinc)]["cliente"]  	:= oMdlSel:GetValue('D2_CLIENTE')
						aDocVinc[len(aDocVinc)]["loja"]   		:= oMdlSel:GetValue('D2_LOJA')
						aDocVinc[len(aDocVinc)]["nomefor"]  	:= oMdlSel:GetValue('D2_CLIDES')
						aDocVinc[len(aDocVinc)]["valorunit"]  	:= oMdlSel:GetValue('D2_PRCVEN')
						aDocVinc[len(aDocVinc)]["quantidade"]  	:= oMdlSel:GetValue('D2_QUANT')
						aDocVinc[len(aDocVinc)]["valortotal"]  	:= oMdlSel:GetValue('D2_TOTAL')
						aDocVinc[len(aDocVinc)]["emissao"]  	:= oMdlSel:GetValue('D2_EMISSAO')
						aDocVinc[len(aDocVinc)]["chave"]  		:= oMdlSel:GetValue('F2_CHVNFE')
						aDocVinc[len(aDocVinc)]["codnfe"]  		:= oMdlSel:GetValue('F2_CODNFE')
					EndIf
				Next nX

				aItemVinc[len(aItemVinc)]["documentos"] := aClone(aDocVinc)
				aDocVinc  := {}
			EndIf
		Next nZ

		jDocRef['itens'] := aClone(aItemVinc)
	EndIf

	FwFreeArray(aItemVinc)
	FwFreeArray(aDocVinc)
    
Return .T.

//-------------------------------------------------------------------
/*/{Protheus.doc} DOCREFORIG
Função de filtro para preenchimento da grid de documentos.

@Return .T. 
@author CRM/Faturamento
@since 10/2025
/*/
//-------------------------------------------------------------------
Static Function DOCREFORIG() As Logical
	Local cAliasTmp As Character
	Local cQuery  	As Character
	Local cFilSA2	As Character
	Local cFilSA1   As Character
	Local cDoc 		As Character
	Local cSerie    As Character
	Local cCliForn  As Character
	Local cLoja 	As Character
	Local dIniEmi  	As Character
	Local dFimEmi  	As Character
	Local cCodProd 	As Character
	Local cChvNFE	As Character
	Local nX 		As Numeric
	Local oQuery  	As Object
	Local oMdlCab   As Object
	Local oMdlIte   As Object
	Local oMdlFil   As Object
	Local oModel 	As Object
	Local oView  	As Object
	Local lFiltraSF1 As Logical
	Local cFilSF1SF2 As Character


	oModel 		:= FWModelActive()
	oView  		:= FWViewActive()
	oMdlCab  	:= oModel:GetModel("CABMASTER")
	oMdlFil   	:= oModel:GetModel("FILTDETAIL")
	cAliasTmp	:= ""
	cQuery  	:= ""
	cFilSA1		:= ""
	cFilSA2		:= ""
	cDoc 	 	:= oMdlCab:GetValue("F2_DOC")
	cSerie   	:= oMdlCab:GetValue("F2_SERIE")
	cCliForn    := oMdlCab:GetValue("F2_CLIENTE")
	cLoja 	 	:= oMdlCab:GetValue("F2_LOJA")
	dIniEmi  	:= DtoS(oMdlCab:GetValue("F2_DTDE"))
	dFimEmi  	:= DtoS(oMdlCab:GetValue("F2_DTATE"))
	cChvNFE  	:= oMdlCab:GetValue("F2_CHVNFE")
	cCodProd 	:= ""
	nX 			:= 1
	oQuery  	:= Nil
	oMdlIte   	:= Nil
	lFiltraSF1	:= jFld600["F2_TPCOMPL"] $ "1257"


	oMdlFil:clearData()
	oMdlFil:SetNoInsertLine(.F.)

	If __cTpVinc == OP_VINC_NF	

		If lFiltraSF1
			cFilSF1SF2 := FWxFilial('SF1')
			cQuery := "SELECT * FROM ( "
			cQuery += "SELECT F1_FILIAL, F1_DOC, F1_SERIE, F1_CHVNFE, F1_EST, F1_VALMERC, F1_EMISSAO, F1_FORNECE, F1_LOJA, F1_CODNFE, ROW_NUMBER() OVER (ORDER BY SF1.F1_EMISSAO DESC) As LINHA "
			cQuery += "FROM " + RetSQLName("SF1") + " SF1 "
			cQuery += "WHERE SF1.F1_FILIAL = ? "
			cQuery += "AND SF1.F1_TIPO = 'N' "

			If !empty(cDoc)
				cQuery += "AND SF1.F1_DOC = ? "
			EndIf
			If !empty(cSerie)
				cQuery += "AND SF1.F1_SERIE = ? "
			EndIf
			If !empty(cCliForn)
				cQuery += "AND SF1.F1_FORNECE = ? "
			EndIf
			If !empty(cLoja)
				cQuery += "AND SF1.F1_LOJA = ? "
			EndIf
			If !empty(dIniEmi)
				cQuery += "AND SF1.F1_EMISSAO >= ? "
			EndIf
			If !empty(dFimEmi)
				cQuery += "AND SF1.F1_EMISSAO <= ? "
			EndIf
			If !empty(cChvNFE)
				cQuery += "AND SF1.F1_CHVNFE = ? "
			EndIf
			cQuery += "AND SF1.D_E_L_E_T_ = ' ' "
			cQuery += ") T "
			cQuery += "WHERE LINHA >= 1 AND LINHA <= 300 " //-- limita o resultado devido a performance e filtros disponíveis.
		Else
			cFilSF1SF2 := FWxFilial('SF2')
			cQuery := "SELECT * FROM ( "
			cQuery += "SELECT F2_FILIAL, F2_DOC, F2_SERIE, F2_CHVNFE, F2_CODNFE, F2_EST, F2_VALMERC, F2_EMISSAO,F2_CLIENTE, F2_LOJA, ROW_NUMBER() OVER (ORDER BY SF2.F2_EMISSAO DESC) As LINHA "
			cQuery += "FROM " + RetSQLName("SF2") + " SF2 "
			cQuery += "WHERE SF2.F2_FILIAL = ? "
			cQuery += "AND SF2.F2_TIPO = 'N' "

			If !empty(cDoc)
				cQuery += "AND SF2.F2_DOC = ? "
			EndIf
			If !empty(cSerie)
				cQuery += "AND SF2.F2_SERIE = ? "
			EndIf
			If !empty(cCliForn)
				cQuery += "AND SF2.F2_CLIENTE = ? "
			EndIf
			If !empty(cLoja)
				cQuery += "AND SF2.F2_LOJA = ? "
			EndIf
			If !empty(dIniEmi)
				cQuery += "AND SF2.F2_EMISSAO >= ? "
			EndIf
			If !empty(dFimEmi)
				cQuery += "AND SF2.F2_EMISSAO <= ? "
			EndIf
			If !empty(cChvNFE)
				cQuery += "AND SF2.F2_CHVNFE = ? "
			EndIf
			cQuery += "AND SF2.D_E_L_E_T_ = ' ' "
			cQuery += ") T "
			cQuery += "WHERE LINHA >= 1 AND LINHA <= 300 " //-- limita o resultado devido a performance e filtros disponíveis.
		EndIf

		oQuery := FWPreparedStatement():New(cQuery)
		oQuery:SetString(nX++, cFilSF1SF2)

		If !empty(cDoc)
			oQuery:SetString(nX++, cDoc)
		EndIf
		If !empty(cSerie)
			oQuery:SetString(nX++, cSerie)	
		EndIf
		If !empty(cCliForn)
			oQuery:SetString(nX++, cCliForn)
		EndIf
		If !empty(cLoja)
			oQuery:SetString(nX++, cLoja)
		EndIf
		If !empty(dIniEmi)
			oQuery:SetString(nX++, dIniEmi)
		EndIf
		If !empty(dFimEmi)
			oQuery:SetString(nX++, dFimEmi)
		EndIf
		If !empty(cChvNFE)
			oQuery:SetString(nX++, cChvNFE)
		EndIf

		cAliasTmp := GetNextAlias()
		cAliasTmp := MpSysOpenQuery(oQuery:getFixQuery(), cAliasTmp)
		nX := 1
		While !(cAliasTmp)->(Eof())

			If nX > 1
				oMdlFil:AddLine()
			EndIf
			
			If lFiltraSF1
				oMdlFil:LoadValue("F2_DOC", (cAliasTmp)->F1_DOC)
				oMdlFil:LoadValue("F2_SERIE", (cAliasTmp)->F1_SERIE)
				oMdlFil:LoadValue("F2_CHVNFE", (cAliasTmp)->F1_CHVNFE)
				oMdlFil:LoadValue("F2_CODNFE", (cAliasTmp)->F1_CODNFE)
				oMdlFil:LoadValue("F2_VALMERC", (cAliasTmp)->F1_VALMERC)
				oMdlFil:LoadValue("F2_EST", (cAliasTmp)->F1_EST)			
				oMdlFil:LoadValue("F2_EMISSAO", StoD((cAliasTmp)->F1_EMISSAO))
				oMdlFil:LoadValue("F2_CLIENTE", (cAliasTmp)->F1_FORNECE)
				oMdlFil:LoadValue("F2_LOJA", (cAliasTmp)->F1_LOJA)
			Else
				oMdlFil:LoadValue("F2_DOC", (cAliasTmp)->F2_DOC)
				oMdlFil:LoadValue("F2_SERIE", (cAliasTmp)->F2_SERIE)
				oMdlFil:LoadValue("F2_CHVNFE", (cAliasTmp)->F2_CHVNFE)
				oMdlFil:LoadValue("F2_CODNFE", (cAliasTmp)->F2_CODNFE)
				oMdlFil:LoadValue("F2_VALMERC", (cAliasTmp)->F2_VALMERC)
				oMdlFil:LoadValue("F2_EST", (cAliasTmp)->F2_EST)			
				oMdlFil:LoadValue("F2_EMISSAO", StoD((cAliasTmp)->F2_EMISSAO))
				oMdlFil:LoadValue("F2_CLIENTE", (cAliasTmp)->F2_CLIENTE)
				oMdlFil:LoadValue("F2_LOJA", (cAliasTmp)->F2_LOJA)
			EndIf

			If __lTPCPL3
				oMdlFil:LoadValue("D2_ITEM", oModel:GetModel("ITENSDETAIL"):GetValue('D2_ITEM') )
				oMdlFil:LoadValue("D2_COD", oModel:GetModel("ITENSDETAIL"):GetValue('D2_COD') )
			EndIf
			nX++
			(cAliasTmp)->(DbSkip())
		EndDo
		(cAliasTmp)->(DbCloseArea())
	ElseIf lFiltraSF1

		oMdlIte  := oModel:GetModel("ITENSDETAIL")
		cCodProd := oMdlIte:GetValue('D2_COD')
		cFilSA2	 := FWxFilial("SA2")

		cQuery := "SELECT * FROM ( "
		cQuery += "SELECT SD1.D1_FILIAL, SD1.D1_DOC, SD1.D1_SERIE, SD1.D1_FORNECE, SD1.D1_LOJA, SD1.D1_COD, SD1.D1_VUNIT, SD1.D1_ITEM, SF1.F1_EMISSAO, SF1.F1_CHVNFE, SF1.F1_CODNFE, "

		If __lCsdXML
			cQuery += "DKC.DKC_ITXML,  DKA.DKA_QUANT, DKA.DKA_VLRTOT, "
		Else 
			cQuery += "SD1.D1_QUANT,  SD1.D1_TOTAL, SD1.D1_ITXML, "
		EndIf
			
		cQuery += "ROW_NUMBER() OVER ( ORDER BY SF1.F1_EMISSAO desc) As LINHA "
		cQuery += "FROM " + RetSQLName("SD1") + " SD1 "

		If __lCsdXML
			cQuery += "JOIN " + RetSQLName("DKC") + " DKC "
			cQuery += "ON DKC.DKC_FILIAL = ? "
			cQuery += "AND DKC.DKC_DOC = SD1.D1_DOC "
			cQuery += "AND DKC.DKC_SERIE = SD1.D1_SERIE "
			cQuery += "AND DKC.DKC_FORNEC = SD1.D1_FORNECE "
			cQuery += "AND DKC.DKC_LOJA = SD1.D1_LOJA "
			cQuery += "AND DKC.DKC_ITEMNF = SD1.D1_ITEM "
			cQuery += "AND DKC.D_E_L_E_T_ = ' ' "
			cQuery += "JOIN " + RetSQLName("DKA") + " DKA "
			cQuery += "ON DKA.DKA_FILIAL = ? "
			cQuery += "AND DKA.DKA_DOC = DKC.DKC_DOC "
			cQuery += "AND DKA.DKA_SERIE = DKC.DKC_SERIE "
			cQuery += "AND DKA.DKA_FORNEC = DKC.DKC_FORNEC "
			cQuery += "AND DKA.DKA_LOJA = DKC.DKC_LOJA "
			cQuery += "AND DKA.DKA_ITXML = DKC.DKC_ITXML "
			cQuery += "AND DKA.D_E_L_E_T_ = ' ' "
		EndIf
		cQuery += "JOIN " + RetSQLName("SF1") + " SF1 "
		cQuery += "ON SF1.F1_FILIAL = ? "
		cQuery += "AND SF1.F1_DOC = SD1.D1_DOC "
		cQuery += "AND SF1.F1_SERIE = SD1.D1_SERIE "
		cQuery += "AND SF1.F1_FORNECE = SD1.D1_FORNECE "
		cQuery += "AND SF1.D_E_L_E_T_ = ' ' "
		cQuery += "WHERE SD1.D1_FILIAL = ? "
		cQuery += "AND SD1.D1_TIPO = 'N' "

		If !empty(cDoc)
			cQuery += "AND SD1.D1_DOC = ? "
		EndIf
		If !empty(cSerie)
			cQuery += "AND SD1.D1_SERIE = ? "
		EndIf
		If !empty(cCliForn)
			cQuery += "AND SD1.D1_FORNECE = ? "
		EndIf
		If !empty(cLoja)
			cQuery += "AND SD1.D1_LOJA = ? "
		EndIf
		If !empty(cCodProd)
			cQuery += "AND SD1.D1_COD = ? "
		EndIf
		If !empty(dIniEmi)
			cQuery += "AND SF1.F1_EMISSAO >= ? "
		EndIf
		If !empty(dFimEmi)
			cQuery += "AND SF1.F1_EMISSAO <= ? "
		EndIf
		If !empty(cChvNFE)
			cQuery += "AND SF1.F1_CHVNFE = ? "
		EndIf
		
		cQuery += "AND SD1.D_E_L_E_T_ = ' ' "
		cQuery += ") T "
 		cQuery += "WHERE LINHA >= 1 AND LINHA <= 300 " //-- limita o resultado devido a performance e filtros disponíveis.

		oQuery := FWPreparedStatement():New(cQuery)

		If __lCsdXML
			oQuery:SetString(nX++, FWxFilial('DKC'))
			oQuery:SetString(nX++, FWxFilial('DKA'))
		EndIf
		oQuery:SetString(nX++, FWxFilial('SF1'))
		oQuery:SetString(nX++, FWxFilial('SD1'))
		
		If !empty(cDoc)
			oQuery:SetString(nX++, cDoc)
		EndIf
		If !empty(cSerie)
			oQuery:SetString(nX++, cSerie)	
		EndIf
		If !empty(cCliForn)
			oQuery:SetString(nX++, cCliForn)
		EndIf
		If !empty(cLoja)
			oQuery:SetString(nX++, cLoja)
		EndIf
		If !empty(cCodProd)
			oQuery:SetString(nX++, cCodProd)
		EndIf
		If !empty(dIniEmi)
			oQuery:SetString(nX++, dIniEmi)
		EndIf
		If !empty(dFimEmi)
			oQuery:SetString(nX++, dFimEmi)
		EndIf
		If !empty(cChvNFE)
			oQuery:SetString(nX++, cChvNFE)
		EndIf

		cAliasTmp := GetNextAlias()
		cAliasTmp := MpSysOpenQuery(oQuery:getFixQuery(), cAliasTmp)
		nX := 1
		While !(cAliasTmp)->(Eof())

			If nX > 1
				oMdlFil:AddLine()
			EndIf
			
			oMdlFil:LoadValue("D2_ITEM", (cAliasTmp)->D1_ITEM)
			If __lCsdXML
				oMdlFil:LoadValue("D1_ITXML", (cAliasTmp)->DKC_ITXML)
				oMdlFil:LoadValue("D2_QUANT", (cAliasTmp)->DKA_QUANT)
				oMdlFil:LoadValue("D2_TOTAL", (cAliasTmp)->DKA_VLRTOT)
			Else 
				oMdlFil:LoadValue("D2_QUANT", (cAliasTmp)->D1_QUANT)
				oMdlFil:LoadValue("D2_TOTAL", (cAliasTmp)->D1_TOTAL)
				oMdlFil:LoadValue("D1_ITXML", (cAliasTmp)->D1_ITXML)
			EndIf
			oMdlFil:LoadValue("D2_COD", (cAliasTmp)->D1_COD)
			oMdlFil:LoadValue("D2_DOC", (cAliasTmp)->D1_DOC)
			oMdlFil:LoadValue("D2_SERIE", (cAliasTmp)->D1_SERIE)
			oMdlFil:LoadValue("D2_CLIENTE", (cAliasTmp)->D1_FORNECE)
			oMdlFil:LoadValue("D2_LOJA", (cAliasTmp)->D1_LOJA)
			oMdlFil:LoadValue("D2_CLIDES", getAdvFval("SA2","A2_NREDUZ",cFilSA2 + (cAliasTmp)->D1_FORNECE + (cAliasTmp)->D1_LOJA,1))
			oMdlFil:LoadValue("D2_PRCVEN",(cAliasTmp)->D1_VUNIT)
			oMdlFil:LoadValue("D2_EMISSAO", StoD((cAliasTmp)->F1_EMISSAO))
			oMdlFil:LoadValue("F2_CHVNFE", (cAliasTmp)->F1_CHVNFE)
			oMdlFil:LoadValue("F2_CODNFE", (cAliasTmp)->F1_CODNFE)

			nX++
			(cAliasTmp)->(DbSkip())
		EndDo
		(cAliasTmp)->(DbCloseArea())
	Else
		oMdlIte  := oModel:GetModel("ITENSDETAIL")
		cCodProd := oMdlIte:GetValue('D2_COD')
		cFilSA1	 := FWxFilial("SA1")

		cQuery := "SELECT * FROM ( "
		cQuery += "SELECT SD2.D2_FILIAL, SD2.D2_DOC, SD2.D2_SERIE, SD2.D2_CLIENTE, SD2.D2_LOJA, SD2.D2_COD, SD2.D2_PRCVEN, SD2.D2_QUANT, SD2.D2_ITEM, SD2.D2_TOTAL, SF2.F2_EMISSAO, SF2.F2_CODNFE, SF2.F2_CHVNFE,  "
		cQuery += "ROW_NUMBER() OVER ( ORDER BY SF2.F2_EMISSAO desc) As LINHA "
		cQuery += "FROM " + RetSQLName("SD2") + " SD2 "
		cQuery += "JOIN " + RetSQLName("SF2") + " SF2 "
		cQuery += "ON SF2.F2_FILIAL = ? "
		cQuery += "AND SF2.F2_DOC = SD2.D2_DOC "
		cQuery += "AND SF2.F2_SERIE = SD2.D2_SERIE "
		cQuery += "AND SF2.F2_CLIENTE = SD2.D2_CLIENTE "
		cQuery += "AND SF2.D_E_L_E_T_ = ' ' "
		cQuery += "WHERE SD2.D2_FILIAL = ? "
		cQuery += "AND SD2.D2_TIPO = 'N' "

		If !empty(cDoc)
			cQuery += "AND SD2.D2_DOC = ? "
		EndIf
		If !empty(cSerie)
			cQuery += "AND SD2.D2_SERIE = ? "
		EndIf
		If !empty(cCliForn)
			cQuery += "AND SD2.D2_CLIENTE = ? "
		EndIf
		If !empty(cLoja)
			cQuery += "AND SD2.D2_LOJA = ? "
		EndIf
		If !empty(cCodProd)
			cQuery += "AND SD2.D2_COD = ? "
		EndIf
		If !empty(dIniEmi)
			cQuery += "AND SF2.F2_EMISSAO >= ? "
		EndIf
		If !empty(dFimEmi)
			cQuery += "AND SF2.F2_EMISSAO <= ? "
		EndIf
		If !empty(cChvNFE)
			cQuery += "AND SF2.F2_CHVNFE = ? "
		EndIf
		
		cQuery += "AND SD2.D_E_L_E_T_ = ' ' "
		cQuery += ") T "
 		cQuery += "WHERE LINHA >= 1 AND LINHA <= 300 " //-- limita o resultado devido a performance e filtros disponíveis.

		oQuery := FWPreparedStatement():New(cQuery)

		oQuery:SetString(nX++, FWxFilial('SF2'))
		oQuery:SetString(nX++, FWxFilial('SD2'))
		
		If !empty(cDoc)
			oQuery:SetString(nX++, cDoc)
		EndIf
		If !empty(cSerie)
			oQuery:SetString(nX++, cSerie)	
		EndIf
		If !empty(cCliForn)
			oQuery:SetString(nX++, cCliForn)
		EndIf
		If !empty(cLoja)
			oQuery:SetString(nX++, cLoja)
		EndIf
		If !empty(cCodProd)
			oQuery:SetString(nX++, cCodProd)
		EndIf
		If !empty(dIniEmi)
			oQuery:SetString(nX++, dIniEmi)
		EndIf
		If !empty(dFimEmi)
			oQuery:SetString(nX++, dFimEmi)
		EndIf
		If !empty(cChvNFE)
			oQuery:SetString(nX++, cChvNFE)
		EndIf

		cAliasTmp := GetNextAlias()
		cAliasTmp := MpSysOpenQuery(oQuery:getFixQuery(), cAliasTmp)
		nX := 1
		While !(cAliasTmp)->(Eof())

			If nX > 1
				oMdlFil:AddLine()
			EndIf

			oMdlFil:LoadValue("D2_ITEM", (cAliasTmp)->D2_ITEM)
			oMdlFil:LoadValue("D1_ITXML", (cAliasTmp)->D2_ITEM)
			oMdlFil:LoadValue("D2_QUANT", (cAliasTmp)->D2_QUANT)
			oMdlFil:LoadValue("D2_TOTAL", (cAliasTmp)->D2_TOTAL)
			oMdlFil:LoadValue("D2_COD", (cAliasTmp)->D2_COD)
			oMdlFil:LoadValue("D2_DOC", (cAliasTmp)->D2_DOC)
			oMdlFil:LoadValue("D2_SERIE", (cAliasTmp)->D2_SERIE)
			oMdlFil:LoadValue("D2_CLIENTE", (cAliasTmp)->D2_CLIENTE)
			oMdlFil:LoadValue("D2_LOJA", (cAliasTmp)->D2_LOJA)
			oMdlFil:LoadValue("D2_CLIDES", getAdvFval("SA1","A1_NREDUZ",cFilSA1 + (cAliasTmp)->D2_CLIENTE + (cAliasTmp)->D2_LOJA,1))
			oMdlFil:LoadValue("D2_PRCVEN",(cAliasTmp)->D2_PRCVEN)
			oMdlFil:LoadValue("D2_EMISSAO", StoD((cAliasTmp)->F2_EMISSAO))
			oMdlFil:LoadValue("F2_CHVNFE", (cAliasTmp)->F2_CHVNFE)
			oMdlFil:LoadValue("F2_CODNFE", (cAliasTmp)->F2_CODNFE)

			nX++
			(cAliasTmp)->(DbSkip())
		EndDo
		(cAliasTmp)->(DbCloseArea())
	EndIf

	oMdlFil:SetNoInsertLine(.T.)
	oMdlFil:GoLine(1)
	oQuery:Destroy()
    FreeObj(oQuery)

	oView:Refresh("VIEW_CAB")
	oView:Refresh("VIEW_FILT")

Return .T.

//-------------------------------------------------------------------
/*/{Protheus.doc} setVinc
Função para trazer o documento selecionado para os documentos vinculados.

@Return .T. 
@author CRM/Faturamento
@since 10/2025
/*/
//-------------------------------------------------------------------
Static Function setVinc() As Array
	Local oModel     As Object
	Local oMdlVinc   As Object
	Local oMdlFil    As Object
	Local oMdlIte    As Object

	Local nQtdReg	 As Numeric
	Local nX		 As Numeric
	Local nLinPos	 As Numeric
	Local lContinua	 As Logical

	oModel 	  := FwModelActive()

	oMdlVinc  := oModel:GetModel("SELECTDETAIL")
	oMdlFil   := oModel:GetModel("FILTDETAIL")
	oMdlIte   := oModel:GetModel("ITENSDETAIL")

	oModel:GetModel('SELECTDETAIL'):SetNoDeleteLine(.F.)
	oMdlVinc:SetNoInsertLine(.F.)

	If jFld600['F2_TPCOMPL'] $ '347'
		nLinPos := oMdlIte:GetLine()
	EndIf

	If __cTpVinc == OP_VINC_NF

		If !(oMdlVinc:SeekLine({{"F2_DOC",oMdlFil:GetValue("F2_DOC")},{"F2_SERIE",oMdlFil:GetValue("F2_SERIE")}}) )

			lContinua := .T.

			// Nota com F2_TPCOMPL = 3 devem permitir a seleção de apenas um documento de referencia
			If __lTPCPL3
				nQtdReg := oMdlVinc:Length()

				If nQtdReg >= 1 .And. !Empty(oMdlVinc:GetValue("F2_DOC"))
					For nX := 1 To nQtdReg
						oMdlVinc:GoLine(nX)
						If !oMdlVinc:IsDeleted(nX)
							Help(NIL, NIL, "DOCREFVINC", NIL, STR0024, 1, 0, NIL, NIL, NIL, NIL, NIL, {STR0025}) //"Este tipo de documento permite que seja vinculado apenas um documento de referência por item."##"Desmarque a nota vinculada para conseguir vincular outro item."
							lContinua := .F.
							If (oMdlFil:SeekLine({{"F2_DOC",oMdlFil:GetValue("F2_DOC")},{"F2_SERIE",oMdlFil:GetValue("F2_SERIE")}}))
								oMdlFil:LoadValue('D2_YOK', .F.)// -- Encontra o documento que foi removido (se o filtro ainda existir) e restaura para não selecionado.
							EndIf
						EndIf
					Next
				EndIf
			EndIf

			//Verifica se o mesmo documento foi selecionado por algum outro item
			If lContinua .And. __lTPCPL3
				lContinua := ValidItSel(lContinua, oMdlIte, oMdlFil, oMdlVinc, nLinPos)
			EndIf

			If lContinua
				If __lTPCPL3
					oMdlIte:GoLine(nLinPos)
				EndIf
				oMdlVinc:GoLine(1)
				If !empty(oMdlVinc:GetValue("F2_DOC"))
					oMdlVinc:AddLine()
				EndIf

				oMdlVinc:LoadValue("D2_YOK", .F.)
				oMdlVinc:LoadValue("F2_DOC", 		oMdlFil:GetValue("F2_DOC"))
				oMdlVinc:LoadValue("F2_SERIE", 		oMdlFil:GetValue("F2_SERIE"))
				oMdlVinc:LoadValue("F2_CHVNFE", 	oMdlFil:GetValue("F2_CHVNFE"))
				oMdlVinc:LoadValue("F2_CODNFE", 	oMdlFil:GetValue("F2_CODNFE"))
				oMdlVinc:LoadValue("F2_VALMERC", 	oMdlFil:GetValue("F2_VALMERC"))
				oMdlVinc:LoadValue("F2_EST", 		oMdlFil:GetValue("F2_EST"))			
				oMdlVinc:LoadValue("F2_EMISSAO", 	oMdlFil:GetValue("F2_EMISSAO"))
				oMdlVinc:LoadValue("F2_CLIENTE", 	oMdlFil:GetValue("F2_CLIENTE"))
				oMdlVinc:LoadValue("F2_LOJA", 	    oMdlFil:GetValue("F2_LOJA"))
				If __lTPCPL3
					oMdlVinc:LoadValue("D2_ITEM", 		oMdlFil:GetValue("D2_ITEM"))
					oMdlVinc:LoadValue("D2_COD", 		oMdlFil:GetValue("D2_COD"))
				EndIf
			EndIf
		Else 
			oMdlFil:LoadValue('D2_YOK', .T.)
			Help(NIL, NIL, "DOCREFDUPLIC", NIL, STR0012, 1, 0, NIL, NIL, NIL, NIL, NIL, {STR0013}) //Este documento já se encontra vinculado.   Selecione outro documento para vínculo.
		EndIf
	Else //Tratamento somente para o tipo de documento 4 e 7
		If !(oMdlVinc:SeekLine({{"D2_DOC",oMdlFil:GetValue("D2_DOC")},{"D2_SERIE",oMdlFil:GetValue("D2_SERIE")},;
								{"D2_CLIENTE",oMdlFil:GetValue("D2_CLIENTE")},{"D2_LOJA",oMdlFil:GetValue("D2_LOJA")},;
								{"D2_COD",oMdlFil:GetValue("D2_COD")}}))

			lContinua := .T.

			//Verifica se o mesmo item de documento foi selecionado por algum outro item
			lContinua := ValidItSel(lContinua, oMdlIte, oMdlFil, oMdlVinc, nLinPos)

			If lContinua
				
				oMdlIte:GoLine(nLinPos)
				oMdlVinc:GoLine(1)

				If !empty(oMdlVinc:GetValue("D2_DOC"))
					oMdlVinc:AddLine()
				EndIf

				oMdlVinc:LoadValue("D2_YOK", .F.)
				oMdlVinc:LoadValue("D2_ITEM", 		oMdlFil:GetValue("D2_ITEM"))
				oMdlVinc:LoadValue("D1_ITXML", 		oMdlFil:GetValue("D1_ITXML"))
				oMdlVinc:LoadValue("D2_COD", 		oMdlFil:GetValue("D2_COD"))
				oMdlVinc:LoadValue("D2_DOC", 		oMdlFil:GetValue("D2_DOC"))
				oMdlVinc:LoadValue("D2_SERIE", 		oMdlFil:GetValue("D2_SERIE"))
				oMdlVinc:LoadValue("D2_CLIENTE", 	oMdlFil:GetValue("D2_CLIENTE"))
				oMdlVinc:LoadValue("D2_LOJA", 		oMdlFil:GetValue("D2_LOJA"))
				oMdlVinc:LoadValue("D2_CLIDES", 	oMdlFil:GetValue("D2_CLIDES"))			
				oMdlVinc:LoadValue("D2_PRCVEN", 	oMdlFil:GetValue("D2_PRCVEN"))
				oMdlVinc:LoadValue("D2_QUANT", 		oMdlFil:GetValue("D2_QUANT"))
				oMdlVinc:LoadValue("D2_TOTAL", 		oMdlFil:GetValue("D2_TOTAL"))
				oMdlVinc:LoadValue("D2_EMISSAO", 	oMdlFil:GetValue("D2_EMISSAO"))
				oMdlVinc:LoadValue("F2_CHVNFE", 	oMdlFil:GetValue("F2_CHVNFE"))
				oMdlVinc:LoadValue("F2_CODNFE", 	oMdlFil:GetValue("F2_CODNFE"))
			EndIf
		Else 
			If oMdlVinc:SeekLine({{"D2_DOC",oMdlFil:GetValue("D2_DOC")},{"D2_SERIE",oMdlFil:GetValue("D2_SERIE")},;
								{"D2_CLIENTE",oMdlFil:GetValue("D2_CLIENTE")},{"D2_LOJA",oMdlFil:GetValue("D2_LOJA")},;
								{"D2_COD",oMdlFil:GetValue("D2_COD")},{"D2_ITEM",oMdlFil:GetValue("D2_ITEM")}})
				oMdlFil:LoadValue('D2_YOK', .T.)
			Else
				oMdlFil:LoadValue('D2_YOK', .F.)
			EndIf
			
			Help(NIL, NIL, "DOCREFDUPLIC", NIL, STR0012, 1, 0, NIL, NIL, NIL, NIL, NIL, {STR0013}) //Este documento já se encontra vinculado.   Selecione outro documento para vínculo.
		EndIf
	EndIf

	oMdlVinc:SetNoInsertLine(.T.)
	oModel:GetModel('SELECTDETAIL'):SetNoDeleteLine(.T.)

	If jFld600['F2_TPCOMPL'] $ '347'
		oMdlIte:GoLine(nLinPos)
	EndIf

	oMdlVinc:GoLine(1)

Return .T.

//-------------------------------------------------------------------
/*/{Protheus.doc} ValidItSel
Função para validar se o mesmo documento/item de documento foi 
selecionado por outro item

@Return .T. 
@author CRM/Faturamento
@since 04/2026
/*/
//-------------------------------------------------------------------
Static Function ValidItSel(lContinua, oMdlIte, oMdlFil, oMdlVinc, nLinPos) As Logical

	Local nX As Numeric
	Local nZ As Numeric

	Default lContinua	:= .T.
	Default oMdlIte		:= oModel:GetModel("ITENSDETAIL")
	Default oMdlFil		:= oModel:GetModel("FILTDETAIL")
	Default oMdlVinc	:= oModel:GetModel("SELECTDETAIL")
	Default nLinPos		:= oMdlIte:GetLine()

	For nZ := 1 To oMdlIte:Length()
		oMdlIte:GoLine(nZ)
		oMdlVinc:GoLine(1)	
		For nX := 1 To oMdlVinc:Length()
			oMdlVinc:GoLine(nX)
			If !oMdlVinc:IsDeleted()
				If nLinPos <> nZ 
					If __lTPCPL3
						If oMdlVinc:GetValue("F2_DOC", nX) == oMdlFil:GetValue("F2_DOC") .And. oMdlVinc:GetValue("F2_SERIE", nX) == oMdlFil:GetValue("F2_SERIE")
							lContinua := .F.
							Exit
						EndIf
					Else
						If oMdlVinc:GetValue("D2_ITEM", nX) == oMdlFil:GetValue("D2_ITEM") .And. oMdlVinc:GetValue("D2_DOC", nX) == oMdlFil:GetValue("D2_DOC");
						 .And. oMdlVinc:GetValue("D2_SERIE", nX) == oMdlFil:GetValue("D2_SERIE")
							lContinua := .F.
							Exit
						EndIf
					EndIf
				EndIf
			EndIf
		Next nX
		If !lContinua 
			Exit
		EndIf
	Next nZ	

	If !lContinua
		Help(Nil, Nil, "VINCDUPLI", Nil, STR0026, 1, 0, Nil, Nil, Nil, Nil, Nil, {STR0027})//"Este documento já foi selecionado"/"Selecione outro documento"
		oMdlFil:LoadValue('D2_YOK', .F.)
	EndIf

Return lContinua

//-------------------------------------------------------------------
/*/{Protheus.doc} delVinc
Função para deletar a linha do vínculo ao documento/item

@Return .T. 
@author CRM/Faturamento
@since 10/2025
/*/
//-------------------------------------------------------------------
Static Function delVinc() As Logical
	Local oModel     As Object
	Local oMdlVinc   As Object
	Local oMdlFil    As Object
	Local oView      As Object
	Local lRefresh 	 As Logical
	
	oModel 	  := FwModelActive()
	oMdlVinc  := oModel:GetModel("SELECTDETAIL")
	oMdlFil   := oModel:GetModel("FILTDETAIL")
	oView	  := Nil
	lRefresh  := .F.

	oModel:GetModel('SELECTDETAIL'):SetNoDeleteLine(.F.)

	If __cTpVinc == OP_VINC_NF		

		If (oMdlVinc:SeekLine({{"F2_DOC",oMdlVinc:GetValue("F2_DOC")},{"F2_SERIE",oMdlVinc:GetValue("F2_SERIE")}}))
			oMdlVinc:DeleteLine(.T.)

			If (oMdlFil:SeekLine({{"F2_DOC",oMdlVinc:GetValue("F2_DOC")},{"F2_SERIE",oMdlVinc:GetValue("F2_SERIE")}}))
				oMdlFil:LoadValue('D2_YOK', .F.)// -- Encontra o documento que foi removido (se o filtro ainda existir) e restaura para não selecionado.

				lRefresh := .T.
			EndIf
		EndIf
	Else 
		If oMdlVinc:SeekLine({{"D2_DOC",oMdlVinc:GetValue("D2_DOC")},{"D2_SERIE",oMdlVinc:GetValue("D2_SERIE")},;
							{"D2_CLIENTE",oMdlVinc:GetValue("D2_CLIENTE")},{"D2_LOJA",oMdlVinc:GetValue("D2_LOJA")},;
							{"D2_COD",oMdlVinc:GetValue("D2_COD")}})

			oMdlVinc:DeleteLine(.T.)

			If oMdlFil:SeekLine({{"D2_DOC",oMdlVinc:GetValue("D2_DOC")},{"D2_SERIE",oMdlVinc:GetValue("D2_SERIE")},;
								{"D2_CLIENTE",oMdlVinc:GetValue("D2_CLIENTE")},{"D2_LOJA",oMdlVinc:GetValue("D2_LOJA")},;
								{"D2_COD",oMdlVinc:GetValue("D2_COD")},{"D2_ITEM",oMdlVinc:GetValue("D2_ITEM")}})
				oMdlFil:LoadValue('D2_YOK', .F.) // -- Encontra o documento que foi removido (se o filtro ainda existir) e restaura para não selecionado.

				lRefresh := .T.
			EndIf
		EndIf
	EndIf

	If lRefresh
		oView := FwViewActive()
		oMdlFil:GoLine(1)
		oView:Refresh('VIEW_FILT')
	EndIf

	oModel:GetModel('SELECTDETAIL'):SetNoDeleteLine(.T.)

Return .T.

//--------------------------------------------------------------------
/*/{Protheus.doc} FATDOCREFSetVinc()
Determina o tipo de vínculo para abertura da tela através da 
variável static 
__cTpVinc = 1 -> Vinculo por NF
__cTpVinc = 2 -> Vinculo por Item

@Param cId, caractere, tipo de vínculo para abertura da tela

@Return .T.
@author CRM/Faturamento
@since 10/2025
/*/
//--------------------------------------------------------------------
Function FATDOCREFSetVinc(cId) As Logical

	Default cId := "1"

	__cTpVinc	:= cId

Return .T.

//--------------------------------------------------------------------
/*/{Protheus.doc} changeItLin()
Realiza a limpeza do filtro carregado quando o usuário
trocar a linha do item/produto posicionado.

Essa limpeza do filtro previne que o usuario vincule um item + documento
posicionado no produto errado.
@Param oView, objeto, view ativa

@Return .T.
@author CRM/Faturamento
@since 10/2025
/*/
//--------------------------------------------------------------------
Static Function changeItLin(oView) As Logical
	Local oModel  As Object
	Local oMdlFil As Object

	Default oView 		:= FwViewActive()

	oModel  := FwModelActive()
	oMdlFil := Nil

	oMdlFil := oModel:GetModel('FILTDETAIL')

	If ValType(oView) == "O" .And. oView:IsActive()
		oMdlFil:ClearData()
		oView:Refresh('VIEW_FILT')
	EndIf

Return .T.

//--------------------------------------------------------------------
/*/{Protheus.doc} BuscaDoc()
Adiciona o botão Buscar para efetuar o filtro dos documentos
@Param oPanel, objeto, painel que será carregado o botão Buscar

@Return Nil
@author CRM/Faturamento
@since 10/2025
/*/
//--------------------------------------------------------------------
Static Function BuscaDoc(oPanel As Object) As Logical

	Default oPanel := Nil

	@ 30, 10 Button STR0015 Size 36, 13 Message STR0022 Pixel Action FWMsgRun(, {|| DOCREFORIG()}, STR0016, STR0017) of oPanel //Buscar    //Buscar Documentos

Return .T.

//------------------------------------------------------------------------------------------------
/*/{Protheus.doc} TriDocSeri
Executa o preenchimento da serie após a consulta padrao do documento for selecionada 

@sample 	TriDocSeri()

@return	    cRet, Character, a série referente ao documento selecionado pela consulta padrão SF2
@author 	CRM/Faturamento
@since 		11/2025
/*/
//------------------------------------------------------------------------------------------------
Static Function TriDocSeri() as Logical
	Local oModel		:= FWModelActive()
	Local oMdlSF2		:= oModel:GetModel("CABMASTER")
	Local cRet          := ""

	if !SF2->(EOF()) .And. xFilial("SF2") == SF2->F2_FILIAL .And. oMdlSF2:GetValue("F2_DOC") == SF2->F2_DOC
		cRet := SF2->F2_SERIE
	EndIf
Return cRet
