#include "tlpp-core.th"
#include "tlpp-object.th"
#include "backoffice.fat.facturaautomatica.calculos.ch"

Static jConfigTES as Json
Static jImpuestos as Json

/*/{Protheus.doc} CalcImpsNF
Función para calcular los impuestos de la factura utilizando la función CalImpxMod.
@type function
@version 12.1.2510
@author luis.samaniego
@since 23/04/2026
@param jFactura, json, Json con la información de la factura (encabezado e ítems).
@param jCpoH, json, Json con la posición de los campos del encabezado de la factura.
@param aHeaderA, array, Array con los campos que forman los ítems de la factura.
@return json, Json con la información de los impuestos calculados para la factura.
/*/
Function CalcImpsNF(jFactura as Json, jCpoH as Json, aHeaderA as Array, aCpsImps as Array) as Json
Local aColsA     as Array
Local aCposHead  as Array
Local cAliasProd as Character
Local cCliFor    as Character
Local cCodICA    as Character
Local cCodMun    as Character
Local cEspeci    as Character
Local cLoja      as Character
Local cSerie     as Character
Local cTipo      as Character
Local cTipoCF    as Character
Local cTipoDoc   as Character
Local dFechaIni  as Date
Local jFiscal    as Json
Local lCalcImp   as Logical
Local nDescuento as Numeric
Local nFlete     as Numeric
Local nGastos    as Numeric
Local nNFMoeda   as Numeric
Local nSeguro    as Numeric
Local nTxMoeda   as Numeric

Default jCpoH := JsonObject():new()
Default aHeaderA := {}

    aCposHead := aClone(jFactura['Encabezado'])
    aColsA    := aClone(jFactura['Items'])

    cTipoCF    := 'C'
    cAliasProd := "SB1"
    cCliFor    := aCposHead[jCpoH['F2_CLIENTE']]
    cEspeci    := aCposHead[jCpoH['F2_ESPECIE']]
    cLoja      := aCposHead[jCpoH['F2_LOJA']]
    cSerie     := aCposHead[jCpoH['F2_SERIE']]
    cTipo      := aCposHead[jCpoH['F2_TIPO']]
    cTipoDoc   := aCposHead[jCpoH['F2_TIPODOC']]
    dFechaIni  := aCposHead[jCpoH['F2_EMISSAO']]
    nNFMoeda   := aCposHead[jCpoH['F2_MOEDA']]
    nTxMoeda   := aCposHead[jCpoH['F2_TXMOEDA']]
    nDescuento := aCposHead[jCpoH['F2_DESCONT']]
    nFlete     := aCposHead[jCpoH['F2_FRETE']]
    nGastos    := aCposHead[jCpoH['F2_DESPESA']]
    nSeguro    := aCposHead[jCpoH['F2_SEGURO']]
    If jCpoH:HasProperty('F2_TPACTIV')
        cCodICA    := aCposHead[jCpoH['F2_TPACTIV']]
    EndIf
    cCodMun    := ""
    If jCpoH:HasProperty('F2_CODMUN')
        cCodMun    := aCposHead[jCpoH['F2_CODMUN']]
    EndIf
    lCalcImp   := .T.

    jFiscal := CalImpxMod(cCliFor, cLoja, cTipoCF, cTipo, cAliasProd, cTipoDoc, cEspeci, cSerie, nNFMoeda, nTxMoeda, aHeaderA, aColsA, lCalcImp, nFlete, nGastos, nSeguro, nDescuento, dFechaIni, cCodICA, cCodMun, aCpsImps, .F.)

    fwFreeArray(aCposHead)
    fwFreeArray(aColsA)

Return jFiscal

/*/{Protheus.doc} UpdValoresCab
Función para actualizar los valores del encabezado de la factura con los valores calculados en la función CalcImpsNF.
@type function
@version 12.1.2510
@author luis.samaniego
@since 23/04/2026
@param aCpoCab, array, Array con los campos del encabezado de la factura.
@param jFiscal, json, Json con la información de los impuestos calculados para la factura.
@param jCampos, json, Json con la posición de los campos del encabezado de la factura.
/*/
Function UpdValoresCab(aCpoCab as Array, jFiscal as Json, jCampos as Json)
Local aBasImp  as Array
Local aValImp  as Array
Local cFBasImp as Character
Local cFValImp as Character

Default aCpoCab := {}
Default jFiscal := JsonObject():new()
Default jCampos := JsonObject():new()

    If jFiscal:HasProperty("NF_TOTAL")
        aCpoCab[jCampos['F2_VALBRUT']] := jFiscal['NF_TOTAL']
    EndIf
    If jFiscal:HasProperty("NF_TOTAL")
        aCpoCab[jCampos['F2_VALFAT']]  := jFiscal['NF_TOTAL']
    EndIf
    If jFiscal:HasProperty("NF_VALMERC")
        aCpoCab[jCampos['F2_VALMERC']] := jFiscal['NF_VALMERC']
    EndIf
    If jFiscal:HasProperty("NF_DESCONTO")
        aCpoCab[jCampos['F2_DESCONT']] := jFiscal['NF_DESCONTO']
    EndIf
    If jFiscal:HasProperty("NF_FRETE")
        aCpoCab[jCampos['F2_FRETE']]   := jFiscal['NF_FRETE']
    EndIf
    If jFiscal:HasProperty("NF_DESPESA")
        aCpoCab[jCampos['F2_DESPESA']] := jFiscal['NF_DESPESA']
    EndIf
    If jFiscal:HasProperty("NF_SEGURO")
        aCpoCab[jCampos['F2_SEGURO']]  := jFiscal['NF_SEGURO']
    EndIf

    aBasImp  := {}
    aValImp  := {}
    cFBasImp := "F2_BASIMP"
    cFValImp := "F2_VALIMP"

    If jFiscal:HasProperty("NF_BASEIMP")
        aBasImp := jFiscal["NF_BASEIMP"]
    EndIf
    If jFiscal:HasProperty("NF_VALIMP")
        aValImp := jFiscal["NF_VALIMP"]
    EndIf

    If Len(aBasImp) > 0
        UpdCampoImp(@aCpoCab, aBasImp, cFBasImp, jCampos)
    EndIf
    If Len(aValImp) > 0
        UpdCampoImp(@aCpoCab, aValImp, cFValImp, jCampos)
    EndIf

    fwFreeArray(aBasImp)
    fwFreeArray(aValImp)

Return

/*/{Protheus.doc} UpdImpsItm
Función para actualizar los valores de los ítems de la factura con los valores calculados en la función CalcImpsNF.
@type function
@version 12.1.2510
@author luis.samaniego
@since 23/04/2026
@param aItems, array, Array con los campos de los ítems de la factura.
@param jFiscal, json, Json con la información de los impuestos calculados para la factura.
@param jCampos, json, Json con la posición de los campos de los ítems de la factura.
@param aImps, array, Array con la información de los impuestos configurados para cada ítem de la factura.
/*/
Function UpdImpsItm(aItems as Array, jFiscal as Json, jCampos as Json, aImps as Array)
Local aAlqImp as Array
Local aBasImp as Array
Local aValImp as Array
Local cTES    as Character
Local nItem   as Numeric

Default aItems  := {}
Default jFiscal := JsonObject():new()
Default jCampos := JsonObject():new()
Default aImps := {}

    If jImpuestos == Nil
        jImpuestos := fImpVariables()
    EndIf
    If jConfigTES == Nil
        jConfigTES := JsonObject():New()
    EndIf

    If jFiscal:HasProperty("ITEMS")
        For nItem := 1 To Len(aItems)

            aBasImp := {}
            aAlqImp := {}
            aValImp := {}

            If jFiscal["ITEMS"][nItem]:HasProperty("IT_BASEIMP")
                aBasImp := jFiscal["ITEMS"][nItem]["IT_BASEIMP"]
            EndIf
            If jFiscal["ITEMS"][nItem]:HasProperty("IT_ALIQIMP")
                aAlqImp := jFiscal["ITEMS"][nItem]["IT_ALIQIMP"]
            EndIf
            If jFiscal["ITEMS"][nItem]:HasProperty("IT_VALIMP")
                aValImp := jFiscal["ITEMS"][nItem]["IT_VALIMP"]
            EndIf

            cTES := aItems[nItem][jCampos['D2_TES']]
            If !jConfigTES:HasProperty(cTES)
                jConfigTES[cTES] := JsonObject():New()
                jConfigTES[cTES]['Impuestos'] := fImpuestoTES(cTES)
            EndIf
            
            UpdValorImp(@aItems[nItem], aBasImp, aAlqImp, aValImp, jCampos, @aImps, nItem)
        
        Next
    EndIf

    fwFreeArray(aAlqImp)
    fwFreeArray(aBasImp)
    fwFreeArray(aValImp)

Return

/*/{Protheus.doc} UpdCampoImp
Función para actualizar los valores de los campos de impuestos en el encabezado y los ítems de la factura con los valores calculados en la función CalcImpsNF. La función recibe el array del encabezado o ítem, el array con los valores de impuestos, el prefijo del campo a actualizar y el json con la posición de los campos del encabezado o ítems de la factura. La función actualiza los campos de impuestos correspondientes según la cantidad de impuestos calculados.
@type function
@version 12.1.2510
@author luis.samaniego
@since 23/04/2026
@param aCpoCab, array, Array con los campos del encabezado o ítem de la factura a actualizar.
@param aVlrImp, array, Array con los valores de impuestos calculados para el encabezado o ítem de la factura.
@param cCampo, character, Prefijo del campo a actualizar (ejemplo: "F2_BASIMP" para el encabezado, "D2_BASIMP" para los ítems).
@param jCampos, json, Json con la posición de los campos del encabezado o ítems de la factura.
/*/
Function UpdCampoImp(aCpoCab as Array, aVlrImp as Array, cCampo as Character, jCampos as Json)
Local cCampoAux as Character
Local nX        as Numeric

Default aCpoCab := {}
Default aVlrImp := {}
Default cCampo  := ""
Default jCampos := JsonObject():new()

    For nX := 1 To Len(aVlrImp)
        cCampoAux := cCampo + NumCpoImpVar(nX)
        If jCampos:HasProperty(cCampoAux)
            aCpoCab[jCampos[cCampoAux]] := aVlrImp[nX]
        EndIf
    Next

Return

/*/{Protheus.doc} fImpuestoTES
Función para obtener los impuestos configurados para un determinado código de TES. 
La función consulta la tabla de configuración de impuestos por TES (SFC) y obtiene el código del impuesto, si el impuesto se suma o resta en la factura.
@type function
@version 12.1.2510
@author luis.samaniego
@since 23/04/2026
@param cTES, character, Código de TES para el cual se desean obtener los impuestos configurados.
@return array, Array con la información de los impuestos configurados para el código de TES especificado.
/*/
Static Function fImpuestoTES(cTES as Character) as Array
Local aImpuestos as Array
Local cQuery     as Character
Local cTmpAlias  as Character
Local jImpuesto  as Json
Local nOrd       as Numeric
Local oQryExec   as Object

Default cTES    := ""

	cQuery := " SELECT FC_TES, FC_IMPOSTO, FC_INCDUPL, FC_INCNOTA, FC_CREDITA, FC_LIQUIDO, FC_INCIMP, FC_CALCULO, FC_PROV "
	cQuery += " FROM " + RetSqlName("SFC")
	cQuery += " WHERE FC_FILIAL = ? "
	cQuery += " AND FC_TES = ? "
	cQuery += " AND D_E_L_E_T_ = ? "

    nOrd     := 1
	cQuery   := ChangeQuery(cQuery)
    oQryExec := FwExecStatement():New(cQuery)
	oQryExec:SetString(nOrd++, xFilial("SFC")) //Filial
	oQryExec:SetString(nOrd++, cTES) //Código de TES
	oQryExec:SetString(nOrd++, ' ' ) //Registro activo

	aImpuestos := {}
    cTmpAlias := oQryExec:OpenAlias()
	(cTmpAlias)->(dbGoTop())
	While !(cTmpAlias)->(Eof())
		jImpuesto := JsonObject():New()
		jImpuesto['FC_TES'] := (cTmpAlias)->FC_TES
        jImpuesto['FC_IMPOSTO'] := (cTmpAlias)->FC_IMPOSTO
		jImpuesto['FC_INCDUPL'] := (cTmpAlias)->FC_INCDUPL
        jImpuesto['FC_INCNOTA'] := (cTmpAlias)->FC_INCNOTA
        jImpuesto['FC_CREDITA'] := (cTmpAlias)->FC_CREDITA
        jImpuesto['FC_LIQUIDO'] := (cTmpAlias)->FC_LIQUIDO
        jImpuesto['FC_INCIMP'] := (cTmpAlias)->FC_INCIMP
        jImpuesto['FC_CALCULO'] := (cTmpAlias)->FC_CALCULO
        jImpuesto['FC_PROV'] := (cTmpAlias)->FC_PROV
		aAdd(aImpuestos, jImpuesto)
		(cTmpAlias)->(DbSkip())
	EndDo

    FreeObj(jImpuesto)
    (cTmpAlias)->(dbCloseArea())
	oQryExec:Destroy()
    oQryExec := Nil

Return aClone(aImpuestos)

/*/{Protheus.doc} fImpVariables
Función para obtener los impuestos configurados en el sistema.
La función consulta la tabla de impuestos (SFB) y obtiene el código del impuesto y el campo libro correspondiente.
@type function
@version 12.1.2510
@author luis.samaniego
@since 23/04/2026
@return json, Json con la información de los impuestos configurados en el sistema.
/*/
Static Function fImpVariables() as Json
Local cQuery     as Character
Local cTmpAlias  as Character
Local jImpuestos as Json
Local nOrd       as Numeric
Local oQryExec   as Object

	cQuery := " SELECT FB_CODIGO, FB_CPOLVRO "
	cQuery += " FROM " + RetSqlName("SFB")
	cQuery += " WHERE FB_FILIAL = ? "
	cQuery += " AND D_E_L_E_T_ = ? "
    
    nOrd     := 1
	cQuery   := ChangeQuery(cQuery)
    oQryExec := FwExecStatement():New(cQuery)
	oQryExec:SetString(nOrd++, xFilial("SFB")) //Filial
	oQryExec:SetString(nOrd++, ' ' ) //Registro activo

    jImpuestos := JsonObject():New()
	cTmpAlias := oQryExec:OpenAlias()
	(cTmpAlias)->(dbGoTop())
	While !(cTmpAlias)->(Eof())
		If !jImpuestos:HasProperty((cTmpAlias)->FB_CODIGO)
			jImpuestos[(cTmpAlias)->FB_CODIGO] := JsonObject():New()
			jImpuestos[(cTmpAlias)->FB_CODIGO]['FB_CPOLVRO'] := (cTmpAlias)->FB_CPOLVRO
		EndIf
		(cTmpAlias)->(DbSkip())
	EndDo
	
	(cTmpAlias)->(dbCloseArea())
    oQryExec:Destroy()
    oQryExec := Nil

Return jImpuestos

/*/{Protheus.doc} UpdValorImp
Función para actualizar los valores de los impuestos en los ítems de la factura con los valores calculados en la función CalcImpsNF.
@type function
@version 12.1.2510
@author luis.samaniego
@since 23/04/2026
@param aItem, array, Array con los campos del ítem de la factura a actualizar.
@param aBasImp, array, Array con los valores de la base imponible calculados para el ítem de la factura.
@param aAlqImp, array, Array con los valores de la alícuota calculados para el ítem de la factura.
@param aValImp, array, Array con los valores del impuesto calculados para el ítem de la factura.
@param jCampos, json, Json con la posición de los campos de los ítems de la factura.
@param aImps, array, Array con la información de los impuestos configurados para cada ítem de la factura.
@param nItem, numeric, Número del ítem de la factura a actualizar.
/*/
Static Function UpdValorImp(aItem as Array, aBasImp as Array, aAlqImp as Array, aValImp as Array, jCampos as Json, aImps as Array, nItem as Numeric)
Local aImpuesto      as Array
Local cCodImp        as Character
Local cCpoLiv        as Character
Local cDAlqImp       as Character
Local cDBasImp       as Character
Local cDValImp       as Character
Local cTES           as Character
Local nCampo         as Numeric
Local nImp           as Numeric
Local nValorAlicuota as Numeric
Local nValorBase     as Numeric
Local nValorImpuesto as Numeric

Default aItem    := {}
Default aBasImp  := {}
Default aAlqImp  := {}
Default aValImp  := {}
Default jCampos  := JsonObject():New()
Default aImps    := {}
Default nItem    := 0

    cDAlqImp  := "D2_ALQIMP"
    cDBasImp  := "D2_BASIMP"
    cDValImp  := "D2_VALIMP"
    cTES      := aItem[jCampos['D2_TES']]

    If jConfigTES:HasProperty(cTES)
        For nImp := 1 To Len(jConfigTES[cTES]['Impuestos'])

            aImpuesto      := {}
            nValorBase     := 0
            nValorAlicuota := 0
            nValorImpuesto := 0

            cCodImp := jConfigTES[cTES]['Impuestos'][nImp]['FC_IMPOSTO'] //Código impuesto

            If jImpuestos:HasProperty(cCodImp)
                cCpoLiv := jImpuestos[cCodImp]['FB_CPOLVRO'] //Campo libro
                nCampo   := NumCpoImpVar(cCpoLiv) //Número del campo de impuesto según el campo libro

                If nCampo <= Len(aBasImp) //Base imponible
                    nValorBase := aBasImp[nCampo]
                    If jCampos:HasProperty(cDBasImp + cCpoLiv)
                        aItem[jCampos[cDBasImp + cCpoLiv]] := nValorBase
                    EndIf
                EndIf

                If nCampo <= Len(aAlqImp) //Alícuota
                    nValorAlicuota := aAlqImp[nCampo]
                    If jCampos:HasProperty(cDAlqImp + cCpoLiv)
                        aItem[jCampos[cDAlqImp + cCpoLiv]] := nValorAlicuota
                    EndIf
                EndIf

                If nCampo <= Len(aValImp) //Valor del impuesto
                    nValorImpuesto := aValImp[nCampo]
                    If jCampos:HasProperty(cDValImp + cCpoLiv)
                        aItem[jCampos[ cDValImp + cCpoLiv ]] := nValorImpuesto
                    EndIf
                EndIf

                aImpuesto := ConfImpuesto(cCodImp, cCpoLiv, jConfigTES[cTES]['Impuestos'][nImp], aItem[jCampos['D2_COD']], nValorBase, nValorAlicuota, nValorImpuesto, aItem[jCampos['D2_DESCON']])
                If Len(aImps) >= nItem
                    aAdd(aImps[nItem][6], aClone(aImpuesto))
                EndIf
            EndIf
        Next
    EndIf
    fwFreeArray(aImpuesto)

Return

/*/{Protheus.doc} ConfImpuesto
Función para configurar el array de impuestos de cada ítem de la factura con la información del impuesto calculado y la configuración del impuesto para el código de TES correspondiente. 
@type function
@version 12.1.2510
@author luis.samaniego
@since 04/05/2026
@param cCodImp, character, Código del impuesto.
@param cCpoLiv, character, Campo libro del impuesto.
@param jImpTES, json, Configuración de impuestos en la TES.
@param cProducto, character, Código del producto del ítem de la factura.
@param nValorBase, numeric, Valor de la base imponible calculada para el ítem de la factura.
@param nValorAlicuota, numeric, Valor de la alícuota calculada para el ítem de la factura.
@param nValorImpuesto, numeric, Valor del impuesto calculado para el ítem de la factura.
@param nDescuento, numeric, Valor del descuento aplicado en el ítem de la factura.
@return array, Array con la información del impuesto configurada para el ítem de la factura.
/*/
Function ConfImpuesto(cCodImp as Character, cCpoLiv as Character, jImpTES as Json, cProducto as Character, nValorBase as Numeric, nValorAlicuota as Numeric, nValorImpuesto as Numeric, nDescuento as Numeric) as Array
Local aImpuesto as Array

Default cCodImp        := ""
Default cCpoLiv        := ""
Default jImpTES        := JsonObject():New()
Default cProducto      := ""
Default nValorBase     := 0
Default nValorAlicuota := 0
Default nValorImpuesto := 0
Default nDescuento     := 0

    aImpuesto := {}
    aAdd(aImpuesto, cCodImp)
    aAdd(aImpuesto, nValorAlicuota) 
    aAdd(aImpuesto, nValorBase)
    aAdd(aImpuesto, nValorImpuesto)
    aAdd(aImpuesto,  jImpTES['FC_INCDUPL'] + jImpTES['FC_INCNOTA'] + jImpTES['FC_CREDITA'] + jImpTES['FC_LIQUIDO'])
    aAdd(aImpuesto, "D2_VALIMP" + cCpoLiv)
    aAdd(aImpuesto, "D2_BASIMP" + cCpoLiv)
    aAdd(aImpuesto, "F2_VALIMP" + cCpoLiv)
    aAdd(aImpuesto, "F2_BASIMP" + cCpoLiv)
    aAdd(aImpuesto, jImpTES['FC_INCIMP'])
    aAdd(aImpuesto, 0.00)
    aAdd(aImpuesto, 0.00)
    aAdd(aImpuesto, 0.00)
    aAdd(aImpuesto, 0.00)
    aAdd(aImpuesto, jImpTES['FC_CALCULO'])
    aAdd(aImpuesto, cProducto)
    aAdd(aImpuesto, cCpoLiv)
    aAdd(aImpuesto, nDescuento)
    aAdd(aImpuesto, {1, -1, 0})
    aAdd(aImpuesto, jImpTES['FC_PROV'])
    aAdd(aImpuesto, 0.00)
    
Return aClone(aImpuesto)

/*/{Protheus.doc} DestroyVar
Función para liberar los objetos Json utilizados para almacenar la configuración de impuestos y la TES.
@type function
@version 12.1.2510
@author luis.samaniego
@since 04/05/2026
/*/
Function DestroyVar()
    If jImpuestos != Nil
        FreeObj(jImpuestos)
        jImpuestos := Nil
    EndIf
    If jConfigTES != Nil
        FreeObj(jConfigTES)
        jConfigTES := Nil
    EndIf
	MaFisClrMs()
Return

/*/{Protheus.doc} RecalcImps
Función para recalcular los impuestos de la factura en caso de que se realicen cambios en los campos que afectan el cálculo de los impuestos.
@type function
@version 12.1.2510
@author luis.samaniego
@since 12/05/2026
@param cSerie, character, Serie de la factura para la cual se desean recalcular los impuestos.
@param jFactura, json, Json con la información de la factura.
@param nNotaFis, numeric, Posición del documento en aMaster (Matxfis).
@param aHeaderA, array, Array con los campos de items.
@param jCposH, json, Json con la posición de los campos del encabezado de la factura.
@return json, Json con la información de los impuestos recalculados para la factura.
@Nota Variables de tipo private usadas en rutinas de cálculo de impuestos, si no existen puede provocar error log.
/*/
Function RecalcImps(cSerie as Character, jFactura as Json, nNotaFis as Numeric, aHeaderA as Array, jCposH as Json) as Json
Local ojson  as Json

Private aImpCCO   := {}
Private aImpSFC   := {}
Private aImpSFF   := {}
Private aImpSFH   := {}
Private aImpLivr  := {}
Private aImpIB2   := {}
Private aTesMXF   := {}
Private aHeader   := {}
Private aCols     := {}
Private nMoedaNf  := 1
Private nTaxa     := 1
Private cEspecie  := ""
Private nMoedaCor := 1
Private dDEmissao := dDataBase

Default cSerie   := ""
Default jFactura := JsonObject():New()
Default nNotaFis := 0
Default aHeaderA := {}
Default jCposH   := JsonObject():New()

    If jFactura:HasProperty("Encabezado")
        If jCposH:HasProperty('F2_TXMOEDA')
            nTaxa := jFactura["Encabezado"][jCposH['F2_TXMOEDA']]
        EndIf
        If jCposH:HasProperty('F2_EMISSAO')
            dDEmissao := jFactura["Encabezado"][jCposH['F2_EMISSAO']]
        EndIf
        If jCposH:HasProperty('F2_ESPECIE')
            cEspecie := jFactura["Encabezado"][jCposH['F2_ESPECIE']]
        EndIf
        If jCposH:HasProperty('F2_MOEDA')
            nMoedaNf  := jFactura["Encabezado"][jCposH['F2_MOEDA']]
            nMoedaCor := jFactura["Encabezado"][jCposH['F2_MOEDA']]
        EndIf
    EndIf

    If jFactura:HasProperty("Items")
        aCols := aClone(jFactura["Items"])
    EndIf

    ojson := JsonObject():New()
    If !Empty(cSerie) .And. Len(aCols) > 0
        aHeader := aClone(aHeaderA[1])
        MaFisAlt("NF_SERIENF", cSerie)
        MaFsSaveMI(nNotaFis)
        ojson := GetCalxFis(aCols, .T.)
        MaFisEnd()
    EndIf

    fwFreeArray(aImpCCO)
    fwFreeArray(aImpSFC)
    fwFreeArray(aImpSFF)
    fwFreeArray(aImpSFH)
    fwFreeArray(aImpLivr)
    fwFreeArray(aImpIB2)
    fwFreeArray(aTesMXF)
    fwFreeArray(aHeader)
    fwFreeArray(aCols)

Return ojson

/*/{Protheus.doc} VlFsRestor
Función para restaurar la información de la factura en caso de que se realicen cambios en los campos que afectan el cálculo de los impuestos y se desee volver a la información original antes de los cambios.
@type function
@version 12.1.2510
@author luis.samaniego
@since 12/05/2026
@param oNotas, json, Json con la información de las facturas.
@param aNFs, array, Array con la información de los documentos a generar.
@param nNotaFis, numeric, Posición del documento en oNotas:aFacturas y aNFs.
@return logical, Valor lógico indicando si la restauración fue exitosa o no.
/*/
Function VlFsRestor(oNotas as Object, aNFs as Array, nNotaFis as Numeric) as Logical
Local lRestorFis as Logical
Local nAuxNotaFis as Numeric

Default oNotas := JsonObject():New()
Default aNFs := {}
Default nNotaFis := 0
    
    lRestorFis  := .F.
    nAuxNotaFis := 0
    
    If (nNotaFis > 0) .And. (Len(oNotas:aFacturas) >= nNotaFis) .And. (Len(aNFs) >= nNotaFis)
        If (oNotas:aFacturas[nNotaFis]['Clave'] == aNFs[nNotaFis][1])
            lRestorFis := MaFisRestore(nNotaFis)
        Else
            nAuxNotaFis := M468NClave(oNotas:aFacturas, aNFs[nNotaFis][1])
            If nAuxNotaFis > 0
                lRestorFis := MaFisRestore(nAuxNotaFis)
            EndIf
        EndIf
    EndIf
    If !lRestorFis .And. (Len(aNFs) >= nNotaFis)
        Help(" ", 1, "RestoreError", , STR0001, 2, 0,,,,,, {STR0002 + aNFs[nNotaFis][3] + " / " + aNFs[nNotaFis][4]}) //"Error al restaurar los valores de impuestos y libros fiscales" "Revise que los documentos fueron generados correctamente"
    EndIf

Return lRestorFis

/*/{Protheus.doc} M468NClave
Obtiene la posición de la factura a generar dentro del arreglo de facturas a generar, a partir de la clave del documento (compuesta por serie+numero).
@type function
@param aFacturas, array, arreglo de facturas a generar
@param cClave, character, clave del documento (serie+numero)
@author luis.samaniego
@since 30/Abril/2021
@version 1.0
@return numeric, posición de la factura dentro del arreglo de facturas a generar
/*/
Function M468NClave(aFacturas as Array, cClave as Character) as Numeric
Local nI   := 0
Local nPos := 0

Default aFacturas := {}
Default cClave    := ""
	
	If !Empty(cClave)
		For nI := 1 To Len(aFacturas)
			If aFacturas[nI]['Clave'] == cClave
				nPos := nI
				Exit
			EndIf
		Next
	EndIf

Return nPos

/*/{Protheus.doc} fVlrBonusP
Calcula el valor de la bonificación por ítem para pedidos de venta, considerando las reglas de cada país.
@type function
@version 12.1.2410
@author luis.samaniego
@since 19/05/2026
@param nC6_VALOR, numeric, Valor total del ítem (SC6->C6_VALOR).
@param nC6_QTDVEN, numeric, Cantidad vendida del ítem (SC6->C6_QTDVEN).
@param nC9_QTDLIB, numeric, Cantidad a facturar del ítem (SC9->C9_QTDLIB).
@param nPrcVen, numeric, Precio de venta del ítem.
@return numeric, Valor del bonus por ítem.
/*/
Function fVlrBonusP(nC6_VALOR as Numeric, nC6_QTDVEN as Numeric, nC9_QTDLIB as Numeric, nPrcVen as Numeric) as Numeric
Local nVlrItBon as Numeric

Default nC6_VALOR  := 0
Default nC6_QTDVEN := 0
Default nC9_QTDLIB := 0
Default nPrcVen    := 0

    nVlrItBon := 0

    If nC6_QTDVEN == 0
        nC6_QTDVEN := 1
    EndIf

	If !(cPaisLoc $ "ARG|PAR|MEX|BOL|COL")
		nVlrItBon := (nC6_VALOR * nC9_QTDLIB)/nC6_QTDVEN
	Else
		nVlrItBon := nC9_QTDLIB * nPrcVen
	EndIf

	A410Arred(nVlrItBon, "D2_TOTAL")

Return nVlrItBon

/*/{Protheus.doc} fVlrBonusR
Calcula el valor de la bonificación por ítem para remisiones, considerando las reglas de cada país.
@type function
@version 12.1.2410
@author luis.samaniego
@since 19/05/2026
@param nD2_QTDAFAT, numeric, Cantidad a facturar del ítem (D2_QTDAFAT).
@param nD2_TOTAL, numeric, Valor total del ítem (D2_TOTAL).
@param nD2_QUANT, numeric, Cantidad vendida del ítem (D2_QUANT).
@param nPrcVen, numeric, Precio de venta del ítem.
@return numeric, Valor del bonus por ítem.
/*/
Function fVlrBonusR(nD2_QTDAFAT as Numeric, nD2_TOTAL as Numeric, nD2_QUANT as Numeric, nPrcVen as Numeric) as Numeric
Local nVlrItBon as Numeric

Default nD2_QTDAFAT := 0
Default nD2_TOTAL   := 0
Default nD2_QUANT   := 0
Default nPrcVen     := 0

    nVlrItBon := 0
    If nD2_QUANT == 0
        nD2_QUANT := 1
    EndIF

	If !(cPaisLoc $ "MEX|COL|PER|EQU")
		nVlrItBon := nPrcVen * nD2_QTDAFAT
	Else
		nVlrItBon := nD2_QTDAFAT * (nD2_TOTAL / nD2_QUANT)
	EndIf

	A410Arred(nVlrItBon, "D2_TOTAL")

Return nVlrItBon
