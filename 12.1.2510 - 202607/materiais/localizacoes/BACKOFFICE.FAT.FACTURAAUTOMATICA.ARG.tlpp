#include "tlpp-core.th"
#include "tlpp-object.th"
#include "backoffice.fat.facturaautomatica.arg.ch"

namespace backoffice.fat.facturaautomatica.arg

#Define	Fact_Auto_ARG "backoffice.fat.facturaautomatica.arg"

/*/{Protheus.doc} FacturaVenta
Clase para la generación de facturas automaticas de venta.
@type class
@version 12.1.2510
@author luis.samaniego
@since 17/04/2026
/*/
Class FacturaVenta From FacturaSalida

    Public Data cPuntoVenta as Character

    Public Method New() Constructor
    Public Method DatosPedidoAFactura()
    Public Method DatosItemPedidoAFactura()
    Public Method DatosRemitoAFactura()
    Public Method DatosItemRemitoAFactura()
    Public Method CposCntrolFolios()
    Public Method CposRG3668()

End Class

/*/{Protheus.doc} FacturaVenta::New
Inicializa la clase FacturaVenta
@type method
@version 12.1.2510
@author luis.samaniego
@since 17/04/2026
@param cPais, character, País
@return object, Objeto de la clase FacturaVenta
/*/
Method New(cPais as Character) Class FacturaVenta

Default cPais := "ARG"

    _Super:New(cPais)

Return Self

/*/{Protheus.doc} FacturaVenta::DatosPedidoAFactura
Asigna los valores del pedido de venta a la factura.
@type method
@version 12.1.2510
@author luis.samaniego
@since 17/04/2026
@param cPedido, character, Numero de pedido
@param cCliente, character, Código de cliente
@param cLoja, character, Tienda de cliente
@param cSerieNF, character, Serie de la factura
@return array, Datos del encabezado de la factura
/*/
Method DatosPedidoAFactura(cPedido as Character, cCliente as Character, cLoja as Character, cSerieNF as Character) Class FacturaVenta
Local aArea       as Array
Local aDatosNf    as Array
Local cPuntoVenta as Character
Local jCpos       as Json

Default cPedido  := ""
Default cCliente := ""
Default cLoja    := ""
Default cSerieNF := ""

    jCpos := Self:jCamposEncabezado
    cPuntoVenta := self:cPuntoVenta

    aDatosNf := Self:PedidoAFactura(cPedido, cCliente, cLoja, cSerieNF)

    aArea := GetArea()

    SC5->(dbSetOrder(1))
    If SC5->( MsSeek(xFilial("SC5")+ cPedido) )
        aDatosNf[jCpos['F2_CANJE']] := SC5->C5_CANJE
        aDatosNf[jCpos['F2_INCOTER']] := SC5->C5_INCOTER
        aDatosNf[jCpos['F2_IDIOMA']] := SC5->C5_IDIOMA
        aDatosNf[jCpos['F2_PAISENT']] := SC5->C5_PAISENT
        aDatosNf[jCpos['F2_PROVENT']] := SC5->C5_PROVENT
        aDatosNf[jCpos['F2_TPVENT']] := SC5->C5_TPVENT
        aDatosNf[jCpos['F2_FECDSE']] := SC5->C5_FECDSE
        aDatosNf[jCpos['F2_FECHSE']] := SC5->C5_FECHSE

        aDatosNf[jCpos['F2_PV']] := cPuntoVenta
        aDatosNf[jCpos['F2_RG1415']] := LxNFRG1415("SF2", aDatosNf[jCpos['F2_SERIE']], aDatosNf[jCpos['F2_ESPECIE']],cPuntoVenta,aDatosNf[jCpos['F2_SERIE']])
        self:CposCntrolFolios(@aDatosNf, jCpos, cSerieNF,cPuntoVenta)
        self:CposRG3668(@aDatosNf, jCpos, cCliente, cLoja)
    EndIf

    RestArea(aArea)
    fwFreeArray(aArea)
    FreeObj(jCpos)

Return aClone(aDatosNf)

/*/{Protheus.doc} FacturaVenta::DatosItemPedidoAFactura
Asigna los valores de los ítems del pedido de venta a la factura.
@type method
@version 12.1.2510
@author luis.samaniego
@since 17/04/2026
@param nItem, numeric, Numero de item de la factura
@param nRecnoItem, numeric, Recno del ítem del pedido
@param cSerieNF, character, Serie de la factura
@return array, Item de la factura
/*/
Method DatosItemPedidoAFactura(nItem as Numeric, nRecnoItem as Numeric, cSerieNF as Character) Class FacturaVenta
Local aArea as Array
Local aItem as Array
Local jCpos as Json

Default nItem := 1
Default nRecnoItem := 0
Default cSerieNF   := ""

    jCpos := self:jCamposItem

    aArea := GetArea()
    aItem := {}
    SC9->(MsGoTo(nRecnoItem))
    If SC6->( MsSeek(xFilial("SC6")+ SC9->C9_PEDIDO+SC9->C9_ITEM+SC9->C9_PRODUTO) )

        aItem := Self:ItemPedidoAFactura(nItem, nRecnoItem, cSerieNF)

        If jCpos:HasProperty('D2_PROVENT')
            aItem[jCpos['D2_PROVENT']] := SC6->C6_PROVENT
        Endif
    EndIf

    RestArea(aArea)
    fwFreeArray(aArea)
    FreeObj(jCpos)

Return aClone(aItem)


/*/{Protheus.doc} FacturaVenta::DatosRemitoAFactura
Asigna los valores del Remito de venta a la factura.
@type method
@version 12.1.2510
@author raul.medina
@since 22/04/2026
@param cRemito, character, Numero de Remito
@param cSerie, character, Numero de Remito
@param cCliente, character, Código de cliente
@param cLoja, character, Tienda de cliente
@param cSerieNF, character, Serie de la factura
@return array, Datos del encabezado de la factura
/*/
Method DatosRemitoAFactura(cRemito as Character, cSerie as Character, cCliente as Character, cLoja as Character, cSerieNF as Character) Class FacturaVenta
Local aArea       as Array
Local aDatosNf    as Array
Local cPuntoVenta as Character
Local jCpos       as Json

Default cRemito     := ""
Default cSerie      := ""
Default cCliente    := ""
Default cLoja       := ""
Default cSerieNF      := ""

    jCpos := Self:jCamposEncabezado
    cPuntoVenta := self:cPuntoVenta

    aDatosNf := Self:RemitoAFactura(cRemito, cSerie, cCliente, cLoja, cSerieNF)

    aArea := GetArea()

    SF2->(dbSetOrder(1)) //F2_FILIAL+F2_DOC+F2_SERIE+F2_CLIENTE+F2_LOJA+F2_FORMUL+F2_TIPO
    If SF2->( MsSeek(xFilial("SF2")+ cRemito + cSerie + cCliente + cLoja) )
        aDatosNf[jCpos['F2_CANJE']] := SF2->F2_CANJE
        aDatosNf[jCpos['F2_INCOTER']] := SF2->F2_INCOTER
        aDatosNf[jCpos['F2_IDIOMA']] := SF2->F2_IDIOMA
        aDatosNf[jCpos['F2_PAISENT']] := SF2->F2_PAISENT
        aDatosNf[jCpos['F2_PROVENT']] := SF2->F2_PROVENT
        aDatosNf[jCpos['F2_TPVENT']] := SF2->F2_TPVENT
        aDatosNf[jCpos['F2_FECDSE']] := SF2->F2_FECDSE
        aDatosNf[jCpos['F2_FECHSE']] := SF2->F2_FECHSE

        aDatosNf[jCpos['F2_PV']] := cPuntoVenta
        aDatosNf[jCpos['F2_RG1415']] := LxNFRG1415("SF2", aDatosNf[jCpos['F2_SERIE']], aDatosNf[jCpos['F2_ESPECIE']],cPuntoVenta,aDatosNf[jCpos['F2_SERIE']])
        self:CposCntrolFolios(@aDatosNf, jCpos, cSerieNF,cPuntoVenta)
        self:CposRG3668(@aDatosNf, jCpos, cCliente, cLoja)
    EndIf

    RestArea(aArea)
    fwFreeArray(aArea)
    FreeObj(jCpos)

Return aClone(aDatosNf)

/*/{Protheus.doc} FacturaVenta::DatosItemRemitoAFactura
Asigna los valores de los ítems del pedido de venta a la factura.
@type method
@version 12.1.2510
@author raul.medina
@since 22/04/2026
@param nItem, numeric, Numero de item de la factura
@param nRecnoItem, numeric, Recno del ítem del pedido
@param cSerieNF, character, Serie de la factura
@return array, Item de la factura
/*/
Method DatosItemRemitoAFactura(nItem as Numeric, nRecnoItem as Numeric, cSerieNF as Character) Class FacturaVenta
Local aArea as Array
Local aItem as Array
Local jCpos as Json

Default nItem := 1
Default nRecnoItem := 0
Default cSerieNF    := ""

    jCpos := self:jCamposItem

    aArea := GetArea()

    
    aItem := Self:ItemRemitoAFactura(nItem, nRecnoItem, cSerieNF)
    
    SD2->(MsGoTo(nRecnoItem))
    If jCpos:HasProperty('D2_PROVENT')
        aItem[jCpos['D2_PROVENT']] := SD2->D2_PROVENT
    Endif

    RestArea(aArea)
    fwFreeArray(aArea)
    FreeObj(jCpos)

Return aClone(aItem)

/*/{Protheus.doc} FacturaVenta::CposCntrolFolios
Asigna los valores de control de folios a la factura.
@type method
@version 12.1.2510
@author raul.medina
@since 26/04/2026
@param aDatosNf, array, Datos del encabezado de la factura
@param jCpos, json, Posiciones de los campos del encabezado de la factura
@param cSerieNF, character, Serie de la factura
@param cPuntoVenta, character, Punto de venta de la factura
/*/
Method CposCntrolFolios(aDatosNf as array, jCpos as json, cSerieNF as character, cPuntoVenta as character) Class FacturaVenta
Local aArea as Array

Default aDatosNf    := aClone(self:aCamposEncabezado[2])
Default jCpos       := self:jCamposEncabezado
Default cSerieNF    := ""
Default cPuntoVenta := ""

    If self:lContrFol
        aArea := GetArea()
        DbSelectArea("SFP")
        SFP->(DbSetOrder(5)) //FP_FILIAL+FP_FILUSO+FP_SERIE+FP_ESPECIE+FP_PV
        If (SFP->(DbSeek(xFilial("SFP") + cFilAnt + cSerieNF+'1'+cPuntoVenta)))
            aDatosNf[jCpos['F2_CAI']] := SFP->FP_CAI
            aDatosNf[jCpos['F2_VENCAI']] := SFP->FP_DTAVAL
        EndIf

        RestArea(aArea)
        fwFreeArray(aArea)
    EndIf

Return

/*/{Protheus.doc} FacturaVenta::CposRG3668
Asigna los valores de RG3668 a la factura.
@type method
@version 12.1.2510
@author raul.medina
@since 26/04/2026
@param aDatosNf, array, Datos del encabezado de la factura
@param jCpos, json, Posiciones de los campos del encabezado de la factura
@param cCliente, character, Código de cliente
@param cLoja, character, Tienda de cliente
/*/
Method CposRG3668(aDatosNf as array, jCpos as json, cCliente as character, cLoja as character) Class FacturaVenta
Local aArea as Array 

Default aDatosNf    := aClone(self:aCamposEncabezado[2])
Default jCpos       := self:jCamposEncabezado
Default cCliente    := ""
Default cLoja       := ""

    If AI0->(ColumnPos("AI0_ADIC5")) > 0  .and. SF2->(ColumnPos("F2_ADIC5")) > 0
        aArea := GetArea()
        DbSelectArea("AI0")
        AI0->(DbSetOrder(1)) //AI0_FILIAL+AI0_CODCLI+AI0_LOJA 
        If AI0->(MsSeek(xFilial("AI0") + cCliente + cLoja))
            If !Empty(AI0->AI0_ADIC5) .And. !Empty(AI0->AI0_ADIC61) .And. !Empty(AI0->AI0_ADIC62) .And. !Empty(AI0->AI0_ADIC7) .and.;
                (ddatabase >= AI0->AI0_DESDE .and. ddatabase <= AI0->AI0_HASTA) ;
                .and. Empty(SF2->F2_ADIC5)
                aDatosNf[jCpos['F2_ADIC5']] := AI0->AI0_ADIC5
                aDatosNf[jCpos['F2_ADIC61']] := AI0->AI0_ADIC61
                aDatosNf[jCpos['F2_ADIC62']] := AI0->AI0_ADIC62
                aDatosNf[jCpos['F2_ADIC7']] := AI0->AI0_ADIC7
            EndIf
        EndIf
        RestArea(aArea)
        fwFreeArray(aArea)
	EndIf
Return

