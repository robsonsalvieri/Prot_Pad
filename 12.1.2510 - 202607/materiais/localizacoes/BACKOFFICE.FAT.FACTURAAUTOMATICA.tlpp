/*/{Protheus.doc} FacturaSalida
Función para inicializar la clase FacturaSalida por localización (país).
@type function
@version 12.1.2510
@author luis.samaniego
@since 17/04/2026
@param cPais, character, Pais
@return object, Objeto de la clase FacturaVenta/FacturaSalida
/*/
Function FacturaVenta(cPais as Character) as Object
Local cClasFacVent as Character
Local oFactura     as Object

Default cPais := ""

    cClasFacVent := "FacturaSalida():New(cPais)"
    If FindClass("backoffice.fat.facturaautomatica." + LOWER(cPais) + ".FacturaVenta")
        cClasFacVent := "backoffice.fat.facturaautomatica." + LOWER(cPais) + ".FacturaVenta():New(cPais)"
    EndIf
    oFactura := &(cClasFacVent)

Return oFactura

/*/{Protheus.doc} MonedaFactura
Función para definir la moneda a utilizar en la factura dependiendo de la configuración seleccionada. 
@type function
@version 12.1.2510
@author luis.samaniego
@since 23/04/2026
@param nMonedaFact, numeric, Factura con la moneda: 1-Moneda pedido; 2-Moneda seleccionada.
@param nMonedaPed, numeric, Moneda del pedido.
@param nMonedaSel, numeric, Moneda seleccionada para la generación de la factura.
@return numeric, Código de la moneda a utilizar en la factura.
/*/
Function MonedaFactura(nMonedaFact as Numeric, nMonedaPed as Numeric, nMonedaSel as Numeric) as Numeric
Local nMoneda As Numeric

Default nMonedaFact := 1
Default nMonedaPed := 1
Default nMonedaSel := 1

    If nMonedaFact == 1
        nMoneda := nMonedaPed
    Else
        nMoneda := nMonedaSel
    EndIf

Return nMoneda

/*/{Protheus.doc} IniFacAuto
Función para inicializar la clase FacturaVenta con los parámetros necesarios para la generación de las facturas. Esta función es llamada en la rutina MATA468N.
@type function
@version 12.1.2510
@author luis.samaniego
@since 17/04/2026
@param nMonedaFact, numeric, Factura con la moneda: 1-Moneda pedido; 2-Moneda seleccionada.
@param nMonedaSelec, numeric, Moneda seleccionada para la generación de la factura.
@param cPuntoVenta, character, Punto de venta (solo para Argentina).
@return object, Objeto de la clase FacturaVenta inicializado con la configuración para la generación de las facturas.
/*/
Function IniFacAuto(nMonedaFact as Numeric, nMonedaSelec as Numeric, cPuntoVenta as Character) as Object
Local oNotas as Object

Default nMonedaFact  := 1
Default nMonedaSelec := 1
Default cPuntoVenta  := ""

    oNotas := FacturaVenta(cPaisLoc)

    oNotas:nMonedaFact  := nMonedaFact
    oNotas:nMonedaSelec := nMonedaSelec

    If cPaisLoc == "ARG"
        oNotas:cPuntoVenta := cPuntoVenta
    EndIf

Return oNotas

/*/{Protheus.doc} VlNFMaxFis
Función para validar si la rutina de factura automática puede ser ejecutada dependiendo de la configuración del país y la rutina que se esté ejecutando.
@type function
@version 12.1.2510
@author luis.samaniego
@since 31/05/2026
@return logical, Retorna .T. si la rutina puede ser ejecutada, de lo contrario retorna .F.
/*/
Function VlNFMaxFis() as Logical
Local lValido as Logical

    lValido := (GetSrvProfString("M468XFIS", "1") == "1" .Or. GetRPORelease() >= "12.1.2610") .And. cPaisLoc $ "ARG|BOL|CHI|COL|MEX|PAR|PER"

    If lValido
        lValido := lValido .And. FindFunction("IniFacAuto")
        lValido := lValido .And. FindFunction("CalcImpsNF")
        lValido := lValido .And. FindFunction("UpdImpsItm")
        lValido := lValido .And. FindFunction("DestroyVar")
        lValido := lValido .And. FindFunction("MaFisClrMs")
        lValido := lValido .And. FindFunction("MaFsSaveMI")
    EndIf

Return lValido
