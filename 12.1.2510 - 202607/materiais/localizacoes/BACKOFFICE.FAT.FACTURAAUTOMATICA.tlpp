#include "totvs.ch"
#include "tlpp-core.th"
#include "tlpp-object.th"
#include "backoffice.fat.facturaautomatica.ch"

/*/{Protheus.doc} FacturaSalida
Clase para la generación de facturas automaticas de venta.
@type class
@version 12.1.2510
@author luis.samaniego
@since 17/04/2026
/*/
Class FacturaSalida

    Public Data aCamposEncabezado as Array
    Public Data aCamposItem       as Array
    Public Data aFacturas         as Array
    Public Data cEspecie          as Character
    Public Data cFormul           as Character
    Public Data cPais             as Character
    Public Data cTipoDoc          as Character
    Public Data jCamposEncabezado as Json
    Public Data jCamposItem       as Json
    Public Data lContrFol         as Logical
    Public Data nMonedaFact       as Numeric
    Public Data nMonedaSelec      as Numeric
    Public Data aCposImps         as Array

    Public Method New() Constructor
    Public Method CrearFactura() //Crea estrutura para factura

    Protected Method ObtenerCamposEncabezado() //Estrutura de campos de encabezado
    Protected Method ObtenerCamposItem() //Estrutura de campos de ítem

    Protected Method PedidoAFactura() //Datos del encabezado de la factura a partir de un pedido
    Protected Method ItemPedidoAFactura() //Datos de los items de la factura a partir de un pedido

    Protected Method RemitoAFactura() //Datos del encabezado de la factura a partir de un Remito
    Protected Method ItemRemitoAFactura() //Datos de los items de la factura a partir de un Remito

    Protected Method DatosEncabezadoAFactura() //Datos del encabezado de la factura a partir de un pedido o remito
    Protected Method DatosItemAFactura() //Datos de los items de la factura a partir de un pedido o remito

    Public Method DatosPedidoAFactura()
    Public Method DatosItemPedidoAFactura()
    Public Method DatosRemitoAFactura()
    Public Method DatosItemRemitoAFactura()

End Class

/*/{Protheus.doc} FacturaSalida::New
Inicializa la clase FacturaSalida
@type method
@version 12.1.2510
@author luis.samaniego
@since 17/04/2026
@param cPais, character, País
@return object, Objeto de la clase FacturaSalida
/*/
Method New(cPais as Character) Class FacturaSalida
Default cPais := SuperGetMV("MV_PAISLOC", , "")

    self:aFacturas := {}
    self:cEspecie  := MVNOTAFIS
    self:cFormul   := "S"
    self:cPais     := cPais
    self:cTipoDoc  := "01"
    self:lContrFol := SuperGetMV("MV_CTRLFOL", , .F.)
    self:aCposImps := {}

    self:ObtenerCamposItem()
    self:ObtenerCamposEncabezado()

Return Self

/*/{Protheus.doc} FacturaSalida::CrearFactura
Crea la estrutura del objeto json para los datos de la factura.
@type method
@version 12.1.2510
@author luis.samaniego
@since 17/04/2026
@param cClaveNF, character, Clave de la factura
@return json, Objeto json con la estrutura de la factura
/*/
Method CrearFactura(cClaveNF as Character) Class FacturaSalida
Local jFactura As Json

    jFactura               := JsonObject():New()
    jFactura['Clave']      := cClaveNF
    jFactura['Encabezado'] := {}
    jFactura['Items']      := {}

Return jFactura

/*/{Protheus.doc} FacturaSalida::ObtenerCamposEncabezado
Inicializa array con los campos del encabezado de la factura.
@type method
@version 12.1.2510
@author luis.samaniego
@since 17/04/2026
/*/
Method ObtenerCamposEncabezado() Class FacturaSalida
Local aCpoSX3   as Array
Local cX3_CAMPO as Character
Local nCpo      as Numeric
Local cX3_VALID  as Character

    self:aCamposEncabezado := Array(2)
    self:aCamposEncabezado[1] := {} //Campos
    self:aCamposEncabezado[2] := {} //Valores
    self:jCamposEncabezado := JsonObject():New()

    aCpoSX3 := FWSX3Util():GetAllFields("SF2" , .T.)
	For nCpo := 1 to Len(aCpoSX3)

        cX3_CAMPO := aCpoSX3[nCpo]
        cX3_VALID := GetSx3Cache(cX3_CAMPO,"X3_VALID")

        aAdd(self:aCamposEncabezado[1], cX3_CAMPO)
        aAdd(self:aCamposEncabezado[2], CriaVar(cX3_CAMPO))
        self:jCamposEncabezado[cX3_CAMPO] := Len(self:aCamposEncabezado[1])

        If (Substr(cX3_CAMPO,4,6) $ "BASIMP|VALIMP|ALQIMP") .And. ("MAFISREF" $ Alltrim(Upper(cX3_VALID)))
            aadd( self:aCposImps , { "SF2" , cX3_CAMPO , xFisGetRF(cX3_VALID)[1] } )
        EndIf
	Next nCpo

    fwFreeArray(aCpoSX3)

Return

/*/{Protheus.doc} FacturaSalida::ObtenerCamposItem
Inicializa array con los datos para los ítems de la factura.
@type method
@version 12.1.2510
@author luis.samaniego
@since 17/04/2026
/*/
Method ObtenerCamposItem() Class FacturaSalida
Local aCpoSX3     as Array
Local cTabla      as Character
Local cX3_ARQUIVO as Character
Local cX3_CAMPO   as Character
Local cX3_CONTEXT as Character
Local cX3_DECIMAL as Character
Local cX3_PICTURE as Character
Local cX3_TAMANHO as Character
Local cX3_TIPO    as Character
Local cX3_TITULO  as Character
Local cX3_USADO   as Character
Local cX3_VALID   as Character
Local nCpo        as Numeric
Local nTotalCpos  as Numeric
Local lInit       as Logical

    cTabla           := "SD2"
	self:jCamposItem := JsonObject():New()
    self:aCamposItem := Array(2)
    self:aCamposItem[1] := {}
    self:aCamposItem[2] := {}

	aCpoSX3 := FWSX3Util():GetAllFields(cTabla , .T.)

    nTotalCpos := Len(aCpoSX3)
    self:aCamposItem[2] := Array(nTotalCpos + 1)
    lInit := .T.

    For nCpo := 1 to nTotalCpos

        cX3_CAMPO := aCpoSX3[nCpo]
        cX3_TITULO  := TRIM(FWX3TITULO(cX3_CAMPO))
        cX3_PICTURE := GetSX3Cache(cX3_CAMPO, "X3_PICTURE")
        cX3_TAMANHO := GetSX3Cache(cX3_CAMPO, "X3_TAMANHO")
        cX3_DECIMAL := GetSX3Cache(cX3_CAMPO, "X3_DECIMAL")
        cX3_VALID   := GetSX3Cache(cX3_CAMPO, "X3_VALID")
        cX3_USADO   := GetSX3Cache(cX3_CAMPO, "X3_USADO")
        cX3_TIPO    := GetSX3Cache(cX3_CAMPO, "X3_TIPO")
        cX3_ARQUIVO := GetSX3Cache(cX3_CAMPO, "X3_ARQUIVO")
        cX3_CONTEXT := GetSX3Cache(cX3_CAMPO, "X3_CONTEXT")

        aAdd(self:aCamposItem[1],{cX3_TITULO,;
                    cX3_CAMPO,;
                    cX3_PICTURE,;
                    cX3_TAMANHO,;
                    cX3_DECIMAL,; 
                    cX3_VALID,;
                    cX3_USADO,;
                    cX3_TIPO,;
                    cX3_ARQUIVO,;
                    cX3_CONTEXT,;
                    ""})

        If self:cPais == "COL" 
            lInit := .T.
            If cX3_CAMPO == 'D2_TPACTIV' .OR. cX3_CAMPO == 'D2_CODMUN'
                lInit := .F.
            EndIf
        EndIf

        self:aCamposItem[2][nCpo]   := CriaVar(cX3_CAMPO, lInit)
        self:jCamposItem[cX3_CAMPO] := Len(self:aCamposItem[1])

        If (Substr(cX3_CAMPO,4,6) $ "BASIMP|VALIMP|ALQIMP") .And. ("MAFISREF" $ Alltrim(Upper(cX3_VALID)))
            aadd( self:aCposImps , { "SD2" , cX3_CAMPO , xFisGetRF(cX3_VALID)[1] } )
        EndIf

	Next nCpo

	self:aCamposItem[2][Len(self:aCamposItem[2])] := .F.

    fwFreeArray(aCpoSX3)

Return

/*/{Protheus.doc} FacturaSalida::PedidoAFactura
Asigna los valores del pedido de venta a la factura.
@type method
@version 12.1.2510
@author luis.samaniego
@since 17/04/2026
@param cPedido, character, Numero de pedido
@param cCliente, character, Código de cliente
@param cLoja, character, Tienda de cliente
@param cSerieNF, character, Serie de la factura
@return array, Datos del encabezado de la factura
/*/
Method PedidoAFactura(cPedido as Character, cCliente as Character, cLoja as Character, cSerieNF as Character) Class FacturaSalida
Local aArea    as Array
Local aDatosNf as Array
Local jCpos    as Json

Default cPedido  := ""
Default cCliente := ""
Default cLoja    := ""
Default cSerieNF := ""

    jCpos    := Self:jCamposEncabezado
    aDatosNf := aClone(self:aCamposEncabezado[2])

    aArea := GetArea()
    SC5->(dbSetOrder(1)) //C5_FILIAL+C5_NUM
    If SC5->( MsSeek(xFilial("SC5")+ cPedido) )

        self:DatosEncabezadoAFactura(@aDatosNf, jCpos, SC5->C5_CLIENTE, SC5->C5_LOJACLI, SC5->C5_MOEDA, SC5->C5_TIPO, cSerieNF)
        aDatosNf[jCpos['F2_TIPO']] := SC5->C5_TIPO
        aDatosNf[jCpos['F2_CLIENTE']] := SC5->C5_CLIENTE
        aDatosNf[jCpos['F2_LOJA']] := SC5->C5_LOJACLI
        aDatosNf[jCpos['F2_COND']] := SC5->C5_CONDPAG
        aDatosNf[jCpos['F2_TIPOCLI']] := SC5->C5_TIPOCLI
        aDatosNf[jCpos['F2_TRANSP']] := SC5->C5_TRANSP
        aDatosNf[jCpos['F2_REDESP']] := SC5->C5_REDESP
        aDatosNf[jCpos['F2_TABELA']] := SC5->C5_TABELA
        aDatosNf[jCpos['F2_NATUREZ']] := SC5->C5_NATUREZ
        aDatosNf[jCpos['F2_TPFRETE']] := SC5->C5_TPFRETE
        aDatosNf[jCpos['F2_LIQPROD']] := SC5->C5_LIQPROD

    EndIf

    RestArea(aArea)
    fwFreeArray(aArea)
    FreeObj(jCpos)

Return aClone(aDatosNf)

/*/{Protheus.doc} FacturaSalida::ItemPedidoAFactura
Asigna los valores de los ítems del pedido de venta a la factura.
@type method
@version 12.1.2510
@author luis.samaniego
@since 17/04/2026
@param nItem, numeric, Numero de item de la factura
@param nRecnoItem, numeric, Recno del ítem del pedido
@param cSerieNF, character, Serie de la factura
@return array, Item de la factura
/*/
Method ItemPedidoAFactura(nItem as Numeric, nRecnoItem as Numeric, cSerieNF as Character) Class FacturaSalida
Local aArea      as Array
Local aItem      as Array
Local jCpos      as Json
Local lC6_CC     as Logical
Local lC6_CCUSTO as Logical
Local lArreFat    as Logical
Local nDecimal    as Numeric
Local lAcresDup   as Logical
Local nMoneda     as Numeric
Local cMV_BonusTS as Character

Default nItem     := 1
Default nRecnoItem := 0
Default cSerieNF      := ""

    aItem      := aClone(self:aCamposItem[2])
    jCpos      := self:jCamposItem

    lArreFat    := SuperGetMV("MV_ARREFAT", , "N") == "S"
    lAcresDup   := SuperGetMv("MV_ACRSDUP", , .F.)
    cMV_BonusTS := SuperGetMV("MV_BONUSTS")
    nDecimal    := TamSx3("D2_PRCVEN")[2]
    lC6_CC      := SC6->(ColumnPos("C6_CC")) > 0
    lC6_CCUSTO  := SC6->(ColumnPos("C6_CCUSTO")) > 0
    
    aArea := GetArea()

    SC9->(MsGoTo(nRecnoItem))
    SC5->(dbSetOrder(1)) //C5_FILIAL+C5_NUM
    SC6->(dbSetOrder(1)) //C6_FILIAL+C6_NUM+C6_ITEM+C6_PRODUTO
    If SC5->( MsSeek(xFilial("SC5")+ SC9->C9_PEDIDO) )
        If SC6->( MsSeek(xFilial("SC6")+ SC9->C9_PEDIDO+SC9->C9_ITEM+SC9->C9_PRODUTO) )
            self:DatosItemAFactura(nItem, @aItem, jCpos , SC6->C6_PRODUTO, SC6->C6_CLI, SC6->C6_LOJA, SC5->C5_TIPO, cSerieNF)

            aItem[jCpos['D2_COD']] := SC6->C6_PRODUTO
            aItem[jCpos['D2_UM']] := SC6->C6_UM
            aItem[jCpos['D2_SEGUM']] := SC6->C6_SEGUM
            aItem[jCpos['D2_DESC']] := SC6->C6_DESCONT
            aItem[jCpos['D2_TES']] := SC6->C6_TES
            aItem[jCpos['D2_CF']] := SC6->C6_CF
            aItem[jCpos['D2_CLIENTE']] := SC6->C6_CLI
            aItem[jCpos['D2_LOJA']] := SC6->C6_LOJA
            aItem[jCpos['D2_NUMSERI']] := SC6->C6_NUMSERI
            aItem[jCpos['D2_LOCALIZ']] := SC6->C6_LOCALIZ
            aItem[jCpos['D2_PROJPMS']] := SC6->C6_PROJPMS
            aItem[jCpos['D2_EDTPMS']] := SC6->C6_EDTPMS
            aItem[jCpos['D2_TASKPMS']] := SC6->C6_TASKPMS
            aItem[jCpos['D2_CODFAB']] := SC6->C6_CODFAB
            aItem[jCpos['D2_LOJAFA']] := SC6->C6_LOJAFA
            aItem[jCpos['D2_PEDIDO']] := SC6->C6_NUM
            aItem[jCpos['D2_ITEMPV']] := SC6->C6_ITEM
            aItem[jCpos['D2_LOCAL']] := SC6->C6_LOCAL
            aItem[jCpos['D2_IDENTB6']] := SC9->C9_IDENTB6
            aItem[jCpos['D2_GRADE']] := SC6->C6_GRADE
            aItem[jCpos['D2_LOTECTL']] := SC9->C9_LOTECTL
            aItem[jCpos['D2_NUMLOTE']] := SC9->C9_NUMLOTE
            aItem[jCpos['D2_DTVALID']] := SC9->C9_DTVALID

            If lC6_CC .And. !Empty(SC6->C6_CC)
                aItem[jCpos['D2_CCUSTO']] := SC6->C6_CC
            Elseif lC6_CCUSTO
                aItem[jCpos['D2_CCUSTO']] := SC6->C6_CCUSTO
            Endif

            aItem[jCpos['D2_TIPO']] := SC5->C5_TIPO
            aItem[jCpos['D2_QUANT']] := SC9->C9_QTDLIB

            nMoneda := MonedaFactura(self:nMonedaFact, SC5->C5_MOEDA, self:nMonedaSelec)

        EndIf
    EndIf

    RestArea(aArea)
    fwFreeArray(aArea)
    FreeObj(jCpos)

Return aClone(aItem)


/*/{Protheus.doc} FacturaSalida::RemitoAFactura
Asigna los valores del remito de venta a la factura.
@type method
@version 12.1.2510
@author raul.medina
@since 21/04/2026
@param cRemito, character, Numero de Remito
@param cSerie, character, Numero de Remito
@param cCliente, character, Código de cliente
@param cLoja, character, Tienda de cliente
@param cSerieNF, character, Serie de la factura
@return array, Datos del encabezado de la factura
/*/
Method RemitoAFactura(cRemito as Character, cSerie as Character, cCliente as Character, cLoja as Character, cSerieNF as Character) Class FacturaSalida
Local aArea    as Array
Local aDatosNf as Array
Local jCpos    as Json

Default cRemito     := ""
Default cSerie      := ""
Default cCliente    := ""
Default cLoja       := ""
Default cSerieNF   := ""

    jCpos    := Self:jCamposEncabezado
    aDatosNf := aClone(self:aCamposEncabezado[2])

    aArea := GetArea()

    SF2->(dbSetOrder(1)) //F2_FILIAL+F2_DOC+F2_SERIE+F2_CLIENTE+F2_LOJA+F2_FORMUL+F2_TIPO
    If SF2->( MsSeek(xFilial("SF2")+ cRemito + cSerie + cCliente + cLoja) )

        self:DatosEncabezadoAFactura(@aDatosNf, jCpos, SF2->F2_CLIENTE, SF2->F2_LOJA, SF2->F2_MOEDA, SF2->F2_TIPO, cSerieNF)
        aDatosNf[jCpos['F2_TIPO']] := SF2->F2_TIPO
        aDatosNf[jCpos['F2_CLIENTE']] := SF2->F2_CLIENTE
        aDatosNf[jCpos['F2_LOJA']] := SF2->F2_LOJA
        aDatosNf[jCpos['F2_COND']] := SF2->F2_COND
        aDatosNf[jCpos['F2_TIPOCLI']] := SF2->F2_TIPOCLI
        aDatosNf[jCpos['F2_TRANSP']] := SF2->F2_TRANSP
        aDatosNf[jCpos['F2_REDESP']] := SF2->F2_REDESP
        aDatosNf[jCpos['F2_TABELA']] := SF2->F2_TABELA
        aDatosNf[jCpos['F2_NATUREZ']] := SF2->F2_NATUREZ
        aDatosNf[jCpos['F2_TPFRETE']] := SF2->F2_TPFRETE
        aDatosNf[jCpos['F2_LIQPROD']] := SF2->F2_LIQPROD

    EndIf

    RestArea(aArea)
    fwFreeArray(aArea)
    FreeObj(jCpos)

Return aClone(aDatosNf)

/*/{Protheus.doc} FacturaSalida::ItemRemitoAFactura
Asigna los valores de los ítems del remito de venta a la factura.
@type method
@version 12.1.2510
@author raul.medina
@since 21/04/2026
@param nItem, numeric, Numero de item de la factura
@param nRecnoItem, numeric, Recno del ítem del pedido
@param cSerieNF, character, Serie de la factura
@return array, Item de la factura
/*/
Method ItemRemitoAFactura(nItem as Numeric, nRecnoItem as Numeric, cSerieNF as Character) Class FacturaSalida
Local aArea      as Array
Local aItem      as Array
Local jCpos      as Json

Default nItem     := 1
Default nRecnoItem := 0
Default cSerieNF      := ""

    aItem      := aClone(self:aCamposItem[2])
    jCpos      := self:jCamposItem
    
    aArea := GetArea()

    SD2->(MsGoTo(nRecnoItem))

    self:DatosItemAFactura(nItem, @aItem, jCpos , SD2->D2_COD, SD2->D2_CLIENTE, SD2->D2_LOJA, SD2->D2_TIPO, cSerieNF)

    aItem[jCpos['D2_COD']] := SD2->D2_COD
    aItem[jCpos['D2_UM']] := SD2->D2_UM
    aItem[jCpos['D2_SEGUM']] := SD2->D2_SEGUM
    aItem[jCpos['D2_DESC']] := SD2->D2_DESC
    aItem[jCpos['D2_TES']] := SD2->D2_TES
    aItem[jCpos['D2_CF']] := SD2->D2_CF
    aItem[jCpos['D2_CLIENTE']] := SD2->D2_CLIENTE
    aItem[jCpos['D2_LOJA']] := SD2->D2_LOJA
    aItem[jCpos['D2_NUMSERI']] := SD2->D2_NUMSERI
    aItem[jCpos['D2_LOCALIZ']] := SD2->D2_LOCALIZ
    aItem[jCpos['D2_PROJPMS']] := SD2->D2_PROJPMS
    aItem[jCpos['D2_EDTPMS']] := SD2->D2_EDTPMS
    aItem[jCpos['D2_TASKPMS']] := SD2->D2_TASKPMS
    aItem[jCpos['D2_CODFAB']] := SD2->D2_CODFAB
    aItem[jCpos['D2_LOJAFA']] := SD2->D2_LOJAFA
    aItem[jCpos['D2_PEDIDO']] := SD2->D2_PEDIDO
    aItem[jCpos['D2_ITEMPV']] := SD2->D2_ITEMPV
    aItem[jCpos['D2_LOCAL']] := SD2->D2_LOCAL
    aItem[jCpos['D2_IDENTB6']] := SD2->D2_IDENTB6
    aItem[jCpos['D2_GRADE']] := SD2->D2_GRADE
    aItem[jCpos['D2_LOTECTL']] := SD2->D2_LOTECTL
    aItem[jCpos['D2_NUMLOTE']] := SD2->D2_NUMLOTE
    aItem[jCpos['D2_DTVALID']] := SD2->D2_DTVALID
    aItem[jCpos['D2_CCUSTO']] := SD2->D2_CCUSTO

    If jCpos:HasProperty('D2_DESCRI')
        aItem[jCpos['D2_DESCRI']] := SD2->D2_DESCRI
    Endif

    aItem[jCpos['D2_TIPO']] := SD2->D2_TIPO

    RestArea(aArea)
    fwFreeArray(aArea)
    FreeObj(jCpos)

Return aClone(aItem)

/*/{Protheus.doc} FacturaSalida::DatosEncabezadoAFactura
Asigna los valores del pedido o remito de venta a la factura.
@type method
@version 12.1.2510
@author raul.medina
@since 24/04/2026
@param aDatosNf, array, Array con los campos del encabezado de la factura
@param jCpos, json, Json con la posición de los campos del encabezado de la factura
@param cCliente, character, Código de cliente
@param cLoja, character, Tienda de cliente
@param nMonedaPed, numeric, Moneda del pedido o remito
@param cTipo, character, Tipo del pedido o remito (B - Beneficio, otro valor - Normal)
@param cSerieNF, character, Serie de la factura
/*/
Method DatosEncabezadoAFactura(aDatosNf as array, jCpos as json, cCliente as Character, cLoja as Character, nMonedaPed as Numeric, cTipo as Character, cSerieNF as Character) Class FacturaSalida
Local aArea         as Array
Local nMoneda       as Numeric
Local nMonedaFact   as Numeric
Local nMonedaSelec  as Numeric
Local lTpPedBenf    as Logical

Default aDatosNf    := aClone(self:aCamposEncabezado[2])
Default jCpos       := self:jCamposEncabezado
Default cCliente    := " "
Default cLoja       := " "
Default nMonedaPed  := 1
Default cTipo       := " "
Default cSerieNF    := " "

    nMonedaFact := self:nMonedaFact
    nMonedaSelec := self:nMonedaSelec
    lTpPedBenf := cTipo == "B"

    aDatosNf[jCpos['F2_FILIAL']] :=  xFilial("SF2")
    If lTpPedBenf
        aDatosNf[jCpos['F2_TIPODOC']] := "11"
    Else
        aDatosNf[jCpos['F2_TIPODOC']] := self:cTipoDoc
    EndIf
    aDatosNf[jCpos['F2_SERIE']] := cSerieNF
    aDatosNf[jCpos['F2_PREFIXO']] := cSerieNF //Si no genera título financiero dejar en blanco?
    aDatosNf[jCpos['F2_FORMUL']] := self:cFormul
    aDatosNf[jCpos['F2_ESPECIE']] := self:cEspecie
    aDatosNf[jCpos['F2_HORA']] := Substr(GetRmtTime(), 1, 8) //Debe de ser actualizada al grabar?
    aDatosNf[jCpos['F2_EMISSAO']] := dDataBase
    aDatosNf[jCpos['F2_DTDIGIT']] := dDataBase

    aArea := GetArea()
    SA1->(dbSetOrder(1)) //A1_FILIAL+A1_COD+A1_LOJA
    If SA1->( MsSeek(xFilial("SA1")+ cCliente + cLoja) )
        If lTpPedBenf
            aDatosNf[jCpos['F2_EST']] := SA1->A1_EST
        EndIf
        aDatosNf[jCpos['F2_REGIAO']] := SA1->A1_REGIAO
    EndIf

    If lTpPedBenf
        SA2->(dbSetOrder(1)) //A2_FILIAL+A2_COD+A2_LOJA
        If SA2->( MsSeek(xFilial("SA2")+ cCliente + cLoja) )
            aDatosNf[jCpos['F2_EST']] := SA2->A2_EST
        EndIf
    EndIf

    nMoneda := MonedaFactura(nMonedaFact, nMonedaPed, nMonedaSelec)

    aDatosNf[jCpos['F2_MOEDA']] := nMoneda

    RestArea(aArea)
    fwFreeArray(aArea)

Return

/*/{Protheus.doc} FacturaSalida::DatosItemAFactura
Asigna los valores del pedido o remito de venta a los ítems de la factura.
@type method
@version 12.1.2510
@author raul.medina
@since 24/04/2026
@param nItem, numeric, Numero de item de la factura
@param aItem, array, Array con los campos del item de la factura
@param jCpos, json, Json con la posición de los campos del encabezado de la factura
@param cCliente, character, Código de cliente
@param cLoja, character, Tienda de cliente
@param cTipo, character, Tipo del pedido o remito (B - Beneficio, otro valor - Normal)
@param cSerieNF, character, Serie de la factura
/*/
Method DatosItemAFactura(nItem as Numeric, aItem as array, jCpos as Json, cCodProd as Character, cCliente as Character, cLoja as Character, cTipo as Character, cSerieNF as Character) Class FacturaSalida
Local cItemD2       as Character
Local aArea         as Array
Local lTpPedBenf    as Logical

Default nItem       := 1
Default aItem       := aClone(self:aCamposItem[2])
Default jCpos       := self:jCamposItem 
Default cCodProd    := "" 
Default cCliente    := ""
Default cLoja       := ""
Default cTipo       := ""
Default cSerieNF    := ""

    cItemD2    := Strzero(nItem, GetSX3Cache("D2_ITEM", "X3_TAMANHO"))
    lTpPedBenf := cTipo == "B"

    aItem[jCpos['D2_FILIAL']] := xFilial("SD2")
    aItem[jCpos['D2_ITEM']] := cItemD2
    aItem[jCpos['D2_SERIE']] := cSerieNF

    aArea := GetArea()
    SB1->(dbSetOrder(1)) //B1_FILIAL+B1_COD
    If SB1->( MsSeek(xFilial("SB1")+cCodProd) )
        aItem[jCpos['D2_PESO']] := SB1->B1_PESO
        aItem[jCpos['D2_GRUPO']] := SB1->B1_GRUPO
        aItem[jCpos['D2_TP']] := SB1->B1_TIPO
        aItem[jCpos['D2_CONTA']] := SB1->B1_CONTA
    EndIf

    SA1->(dbSetOrder(1)) //A1_FILIAL+A1_COD+A1_LOJA
    If SA1->(MsSeek(xFilial("SA1")+ cCliente+cLoja))
        aItem[jCpos['D2_EST']] := SA1->A1_EST
    EndIf

    aItem[jCpos['D2_EMISSAO']] := dDataBase
    aItem[jCpos['D2_DTDIGIT']] := dDataBase
    If lTpPedBenf
        aItem[jCpos['D2_TIPODOC']] := "11"
    Else
        aItem[jCpos['D2_TIPODOC']] := self:cTipoDoc
    EndIf
    aItem[jCpos['D2_GERANF']] :=  "N"
    aItem[jCpos['D2_FORMUL']] := self:cFormul
    aItem[jCpos['D2_ESPECIE']] := self:cEspecie

    RestArea(aArea)
    fwFreeArray(aArea)

Return

/*/{Protheus.doc} FacturaSalida::DatosPedidoAFactura
Asigna los valores del pedido de venta a la factura.
@type method
@version 12.1.2510
