#Include 'tlpp-core.th'
#Include 'pc.invoices.mi.service.ch'

namespace portal.cliente.invoicesMI
using namespace gfin.util
using namespace portal.cliente.util

Static __instance	 As Object

Class InvoicesServiceMI

	Data cPais as Character
	Data cMV_CFDDOCS as Character

	Public Method New()
	Public Method checkDoc() as Json
	Public Method getXMLPDFMI() as Json
	Public Method getResponseZip() as Json
	Public Method generatePDF() as Json
	Public Method getAttachmentZip() as Character
	Static Method getInstance() As Object
	Public Method getFileName() as Character
EndClass

Method New() Class InvoicesServiceMI

	self:cPais 			:= cPaisLoc
	self:cMV_CFDDOCS 	:= &(SuperGetMv("MV_CFDDOCS",	.F., ''))

Return

/*/{Protheus.doc} getXMLPDFMI
	Genera el XML y PDF de Documento Fiscal
	@author raul.medina
	@since 04/2026
	@version 1.0
	@param cSerie, Character, Numero de serie da nota fiscal
	@param cNumber, Character, Numero de la nota fiscal
	@param cCliente, Character, Codigo de cliente
	@param cLoja, Character, Codigo de loja
	@param cEspecie, Character, Especie de documento
	@param cTipoDoc, Character, Tipo de documento
	@return jResponse, Json, Resposta que será enviada para a API
/*/
Method getXMLPDFMI(cSerie As Character, cNumber As Character, cCliente as Character, cLoja as Character, cEspecie As Character, cTipoDoc As Character) as Json Class InvoicesServiceMI
Local jResponse 	:= JsonObject():new()		as Json
Local jDocInfo		:= JsonObject():new()		as Json
Local cFile			:= ""						as Character
Local lExistPDF		:= .F.						as Logical
Local lExistXML		:= .F.						as Logical

Default cSerie 	 := ""
Default cNumber  := ""
Default cCliente := ""
Default cLoja    := ""
Default cEspecie := ""
Default cTipoDoc := ""

	cSerie := UPPER(cSerie)
	cNumber := UPPER(cNumber)
	cCliente := UPPER(cCliente)
	cLoja := UPPER(cLoja)
	cEspecie := UPPER(cEspecie)
	cTipoDoc := UPPER(cTipoDoc)

	jDocInfo := self:checkDoc(cSerie, cNumber, cCliente, cLoja, cEspecie, cTipoDoc)

	If !jDocInfo['Exist'] //El documento no existe en el sistema
		jResponse := answerFormat(.T., 201, STR0001 + cSerie + "-" +cNumber + STR0002) //"El documento " " no existe en el sistema."
	Else
		If !jDocInfo['IsTimb'] //El documento no está timbrado, por lo tanto no se puede descargar el PDF y XML
			jResponse := answerFormat(.T., 202, STR0003 + cSerie + "-" +cNumber + STR0004) //"El PDF\XML del documento " " no pueden ser descargados. No se encuentra timbrado el documento."
		Else
			cFile := self:getFileName(cEspecie, cSerie, cNumber)

			lExistPDF := File(self:cMV_CFDDOCS +cFile+".pdf")
			lExistXML := File(self:cMV_CFDDOCS +cFile+".xml")

			If lExistXML .and. !lExistPDF
				self:generatePDF(cEspecie, cSerie, cNumber, cTipoDoc, cCliente, cLoja)
				lExistPDF := File(self:cMV_CFDDOCS +cFile+".pdf")
			EndIf

			If !lExistXML
				jResponse := answerFormat(.T., 203, STR0005 + cSerie + "-" +cNumber + STR0007 +  self:cMV_CFDDOCS ) //"El XML de la Factura " " no puede ser descargado. No se encuentra el archivo en la ruta: "
			ElseIf !lExistPDF
				jResponse := answerFormat(.T., 203, STR0006 + cSerie + "-" +cNumber + STR0007 +  self:cMV_CFDDOCS ) //"El PDF de la Factura " " no puede ser descargado. No se encuentra el archivo en la ruta: "
			else
				jResponse := self:getResponseZip(cFile)
			EndIf
		EndIf
	EndIf

	FwFreeObj(jDocInfo)

Return jResponse

/*/{Protheus.doc} checkDoc
	Verifica si el documento existe en el sistema y si se encuentra timbrado
	@author raul.medina
	@since 04/2026
	@version 1.0
	@param cSerie, Character, Numero de serie da nota fiscal
	@param cNumber, Character, Numero de la nota fiscal
	@param cCliente, Character, Codigo de cliente
	@param cLoja, Character, Codigo de loja
	@param cEspecie, Character, Especie de documento
	@param cTipoDoc, Character, Tipo de documento
	@return jResponse, Json, Resposta que será enviada para a API
/*/
Method checkDoc(cSerie As Character, cNumber As Character, cCliente as Character, cLoja as Character, cEspecie As Character, cTipoDoc As Character) as Json Class InvoicesServiceMI
Local jResponse 	:= JsonObject():new()	as Json
Local oDataDoc								as Object

Default cSerie 	 := ""
Default cNumber  := ""
Default cCliente := ""
Default cLoja    := ""
Default cEspecie := ""
Default cTipoDoc := ""


	oDataDoc := InvoicesDataMI():new()

	If cTipoDoc == '04' .or.  cEspecie == 'NCC'
		jResponse := oDataDoc:getDataInvoiceSF1(cSerie, cNumber, cCliente, cLoja, cEspecie)
	Else
		jResponse := oDataDoc:getDataInvoiceSF2(cSerie, cNumber, cCliente, cLoja, cEspecie)
	EndIf

	FwFreeObj(oDataDoc)


Return jResponse

/*/{Protheus.doc} getFileName
	Genera el nombre del archivo a descargar de acuerdo a la configuración del país
	@author raul.medina
	@since 04/2026
	@version 1.0
	@param cEspecie, Character, Especie de documento
	@param cSerie, Character, Numero de serie da nota fiscal
	@param cNumber, Character, Numero de la nota fiscal
	@return cFileName, Character, Nombre del archivo a descargar sin extensión
/*/
Method getFileName(cEspecie as Character, cSerie as Character, cNumber as Character ) as Character Class InvoicesServiceMI
Local cFileName as Character

Default cEspecie := ""
Default cSerie := ""
Default cNumber := ""

	If self:cPais == "MEX"
		cFileName := Lower( Alltrim(cEspecie) + "_" + Alltrim(cSerie) + "_" + Alltrim(cNumber) )
	EndIf

Return cFileName

/*/{Protheus.doc} generatePDF
	Genera el PDF de Documento Fiscal
	@author raul.medina
	@since 04/2026
	@version 1.0
	@param cEspecie, Character, Especie de documento
	@param cSerie, Character, Numero de serie da nota fiscal
	@param cNumDoc, Character, Numero de la nota fiscal
	@param cTipoDoc, Character, Tipo de documento
	@param cCliente, Character, Codigo de cliente
	@param cLoja, Character, Codigo de loja
	
	
	@return jResponse, Json, Resposta que será enviada para a API
/*/
Method generatePDF(cEspecie as Character, cSerie as Character, cNumDoc as Character, cTipoDoc as Character, cCliente as Character, cLoja as Character) As Json Class InvoicesServiceMI
Local aArea			:= GetArea()			as array
Local lGenDoc		:= .F.					as logical

Default cEspecie	:= ""
Default cSerie		:= ""
Default cNumDoc 	:= ""
Default cTipoDoc	:= ""
Default cCliente	:= ""
Default cLoja		:= ""

	aArea := GetArea()
	If cTipoDoc == '04' .or.  cEspecie == 'NCC'
		dbSelectArea("SF1")
		SF1->(dbSetOrder(1))
		If SF1->(MsSeek(xFilial("SF1") + PADR(cNumDoc, GetSX3Cache("F1_DOC","X3_TAMANHO")) + PADR(cSerie, GetSX3Cache("F1_SERIE","X3_TAMANHO")) + PADR(cCliente, GetSX3Cache("F1_FORNECE","X3_TAMANHO")) + PADR(cLoja, GetSX3Cache("F1_LOJA","X3_TAMANHO"))))
			lGenDoc := .T.
		EndIf
	Else
		dbSelectArea("SF2")
		SF2->(dbSetOrder(1))
		If SF2->(MsSeek(xFilial("SF2") + PADR(cNumDoc, GetSX3Cache("F2_DOC","X3_TAMANHO")) + PADR(cSerie, GetSX3Cache("F2_SERIE","X3_TAMANHO")) + PADR(cCliente, GetSX3Cache("F2_CLIENTE","X3_TAMANHO")) + PADR(cLoja, GetSX3Cache("F2_LOJA","X3_TAMANHO"))))
			lGenDoc	:= .T.
		EndIf
	EndIf
	
	If lGenDoc
		If self:cPais == "MEX"
			MATR475Gen(cEspecie, cSerie, cNumDoc, cTipoDoc, cCliente, cLoja, .F.)
		EndIf
	EndIf

	RestArea(aArea)
	FwFreeArray(aArea)

Return 

/*/{Protheus.doc} getResponseZip
	Genera el archivo zip con el PDF y XML del documento fiscal
	@author raul.medina
	@since 04/2026
	@version 1.0
	@param cFileDoc, Character, Nombre del archivo sin extensión que se desea generar el zip (Ejemplo: NFE_001_SERIE_123)	
	@return jResponse, Json, Resposta que será enviada para la API
/*/
Method getResponseZip(cFileDoc) As Json Class InvoicesServiceMI
Local jResponse := JsonObject():new() As Json
Local cFile := "" As Character

Default cFileDoc := ""

	cFile := ::getAttachmentZip(cFileDoc)

	If !Empty(cFile)
		jResponse["filename"] := cFileDoc + ".zip"
		jResponse["file"] := cFile
	EndIf
	
Return jResponse


/*/{Protheus.doc} getAttachmentZip
	Genera el archivo zip con el PDF y XML del documento fiscal
	@author raul.medina
	@since 04/2026
	@version 1.0
	@param cFileDoc, Character, Nombre del archivo sin extensión que se desea generar el zip (Ejemplo: NFE_001_SERIE_123)	
	@return cFile, Character, Archivo en formato base64 del zip generado con el PDF y XML del documento fiscal
/*/
Method getAttachmentZip(cFileDoc) As Character Class InvoicesServiceMI
Local oAttach     := Nil As Object
Local cNameZip    := ""  As Character
Local cFile       := ""  As Character
Local aAttachResp := {}  As Array
Local aAttachList := {}  As Array
Local nCount      := 1   As Numeric
Local nZipArc     := -1  As Numeric
Local cStartPath  := GetSrvProfString("Startpath","") As Character

Default cFileDoc := ""

	aAttachList := {{self:cMV_CFDDOCS ,cFileDoc+".xml"}, {self:cMV_CFDDOCS ,cFileDoc+".pdf"}}

	For nCount := 1 to Len(aAttachList)
		COPY FILE (aAttachList[nCount][1] + aAttachList[nCount][2]) TO (cStartPath + aAttachList[nCount][2])
		oAttach := FwFileReader():New(cStartPath + aAttachList[nCount][2])

		If (oAttach:Open())
			Aadd(aAttachResp, cStartPath + aAttachList[nCount][2])
		Endif

		oAttach:Close()
	Next nCount

	If Len(aAttachResp) > 0
		cNameZip := cFileDoc + ".zip"
		nZipArc  := FZip(cStartPath+cNameZip, aAttachResp)
	EndIf

	If nZipArc == 0
		oAttach := FwFileReader():New(cStartPath + cNameZip)

		If (oAttach:Open())
			cFile := Encode64(oAttach:FullRead())
		Endif

		oAttach:Close()
		For nCount := 1 to Len(aAttachResp)
			FErase(aAttachResp[nCount])
		Next nCount
		FErase(cStartPath + cNameZip)
	Endif
	FwFreeObj(oAttach)
	FwFreeArray(aAttachResp)
	FwFreeArray(aAttachList)

Return cFile

//-------------------------------------------------------------------
/*/{Protheus.doc }getInstance
Returna la instancia activa, si no existe se creará una nueva.

@author raul.medina
@since 04/2026
@return __instance, object, Instancia activa del servicio de facturas de mercado internacional
/*/
//-------------------------------------------------------------------
Method getInstance() Class InvoicesServiceMI
	If (__instance == nil)
		__instance := InvoicesServiceMI():new()
	EndIf
Return	__instance
