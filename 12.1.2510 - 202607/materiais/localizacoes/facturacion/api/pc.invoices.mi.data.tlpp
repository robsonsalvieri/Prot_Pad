#include 'tlpp-core.th'

namespace portal.cliente.invoicesMI

Class InvoicesDataMI

	Public Method New()
	Public Method getDataInvoiceSF1() As Json
    Public Method getDataInvoiceSF2() As Json

EndClass

Method new() Class InvoicesDataMI

Return Self

/*/{Protheus.doc} getDataInvoiceSF1
	Verifica la existencia del documento fiscal en la tabla SF1 y si el mismo está timbrado.
	@author raul.medina
	@since 04/2026
	@version 1.0
	@param cSerie, Character, Numero de serie da nota fiscal
	@param cNumber, Character, Numero de la nota fiscal
	@param cCliente, Character, Codigo de cliente
	@param cLoja, Character, Codigo de loja
	@param cEspecie, Character, Especie de documento
	@return response, Json, información sobre la existencia del documento y su estado de timbrado
/*/
Method getDataInvoiceSF1(cSerie As Character, cNumber As Character, cCliente as Character, cLoja as Character, cEspecie As Character) as Json Class InvoicesDataMI
Local response          as Json
Local cQuery    := ""   as Character
Local cDoc      := ""   as Character
Local cStatus   := ""   as Character
Local oQryExec  := Nil  as Object
Local nParam    := 1    as numeric

Default cSerie 	 := ""
Default cNumber  := ""
Default cCliente := ""
Default cLoja    := ""
Default cEspecie := ""

    response := JsonObject():new()
    response['Exist'] := .F.
    response['IsTimb'] := .F.

    cQuery := "SELECT F1_DOC, F1_FLFTEX "
    cQuery += "FROM " + RetSqlName("SF1") + " SF1 "
    cQuery += "WHERE SF1.F1_FILIAL  = ? "
    cQuery += " AND SF1.F1_DOC      = ? "
    cQuery += " AND SF1.F1_SERIE    = ? "
    cQuery += " AND SF1.F1_FORNECE  = ? "
    cQuery += " AND SF1.F1_LOJA     = ? "
    cQuery += " AND SF1.F1_ESPECIE  = ? "
    cQuery += " AND SF1.D_E_L_E_T_  = ? "

    cQuery := ChangeQuery(cQuery)
	oQryExec := FwExecStatement():New(cQuery)

    nParam := 1

    oQryExec:SetString(nParam++, xFilial("SF1"))
    oQryExec:SetString(nParam++, cNumber)
    oQryExec:SetString(nParam++, cSerie)
    oQryExec:SetString(nParam++, cCliente)
    oQryExec:SetString(nParam++, cLoja)
    oQryExec:SetString(nParam++, cEspecie)
    oQryExec:SetString(nParam++, Space(1))
	
    cDoc := oQryExec:ExecScalar("F1_DOC")
    cStatus := oQryExec:ExecScalar("F1_FLFTEX")
    If !Empty(cDoc)
        response['Exist'] := .T.
        If cStatus == '6'
            response['IsTimb'] := .T.
        EndIf
    EndIf

    oQryExec:Destroy()
	oQryExec := nil
        

Return response

/*/{Protheus.doc} getDataInvoiceSF2
	Verifica la existencia del documento fiscal en la tabla SF2 y si el mismo está timbrado.
	@author raul.medina
	@since 04/2026
	@version 1.0
	@param cSerie, Character, Numero de serie da nota fiscal
	@param cNumber, Character, Numero de la nota fiscal
	@param cCliente, Character, Codigo de cliente
	@param cLoja, Character, Codigo de loja
	@param cEspecie, Character, Especie de documento
	@return response, Json, información sobre la existencia del documento y su estado de timbrado
/*/
Method getDataInvoiceSF2(cSerie As Character, cNumber As Character, cCliente as Character, cLoja as Character, cEspecie As Character) as Json Class InvoicesDataMI
Local response          as Json
Local cQuery    := ""   as Character
Local cDoc      := ""   as Character
Local cStatus   := ""   as Character
Local oQryExec  := Nil  as Object
Local nParam    := 1    as numeric

Default cSerie 	 := ""
Default cNumber  := ""
Default cCliente := ""
Default cLoja    := ""
Default cEspecie := ""

    response := JsonObject():new()
    response['Exist'] := .F.
    response['IsTimb'] := .F.

    cQuery := "SELECT  F2_DOC, F2_FLFTEX "
    cQuery += "FROM " + RetSqlName("SF2") + " SF2 "
    cQuery += "WHERE SF2.F2_FILIAL  = ? "
    cQuery += " AND SF2.F2_DOC      = ? "
    cQuery += " AND SF2.F2_SERIE    = ? "
    cQuery += " AND SF2.F2_CLIENTE  = ? "
    cQuery += " AND SF2.F2_LOJA     = ? "
    cQuery += " AND SF2.F2_ESPECIE  = ? "
    cQuery += " AND SF2.D_E_L_E_T_  = ? "

    cQuery := ChangeQuery(cQuery)
	oQryExec := FwExecStatement():New(cQuery)

    nParam := 1

    oQryExec:SetString(nParam++, xFilial("SF2"))
    oQryExec:SetString(nParam++, cNumber)
    oQryExec:SetString(nParam++, cSerie)
    oQryExec:SetString(nParam++, cCliente)
    oQryExec:SetString(nParam++, cLoja)
    oQryExec:SetString(nParam++, cEspecie)
    oQryExec:SetString(nParam++, Space(1))

    cDoc := oQryExec:ExecScalar("F2_DOC")
    cStatus := oQryExec:ExecScalar("F2_FLFTEX")
    
    If !Empty(cDoc)
        response['Exist'] := .T.
        If cStatus == '6'
            response['IsTimb'] := .T.
        EndIf
    EndIf

    oQryExec:Destroy()
	oQryExec := nil
        

Return response
