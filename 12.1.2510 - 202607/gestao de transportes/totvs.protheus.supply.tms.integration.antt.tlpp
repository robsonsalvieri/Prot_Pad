#Include 'TOTVS.ch'
#Include "fileio.ch"
#Include 'totvs.protheus.supply.tms.integration.antt.ch'

namespace totvs.protheus.supply.tms.integration.antt

Static lTMSANTT1 := ExistBlock("TMSANTT1")
Static lTMSANTT2 := ExistBlock("TMSANTT2")

/*{Protheus.doc} TMSANTTInt()
Classe para integração SIGATMS + ANTT
@author Carlos Alberto Gomes Junior
@since 23/05/2026
*/
CLASS TMSANTTInt

	PRIVATE DATA cURL AS CHARACTER
	PRIVATE DATA cKeyPEM AS CHARACTER
	PRIVATE DATA cCertPEM AS CHARACTER
	PRIVATE DATA cPASS AS CHARACTER
	PRIVATE DATA cNPJFor AS CHARACTER
	PRIVATE DATA cRNTRC AS CHARACTER
	
	PUBLIC DATA lDEGOk AS LOGICAL
	PUBLIC DATA oDadosCIOT AS JSON
	PUBLIC DATA cResult AS CHARACTER
	PUBLIC DATA oResult AS JSON
	PUBLIC DATA lAPIOk AS LOGICAL
	PUBLIC DATA cHttpCode AS CHARACTER

	PUBLIC METHOD New() Constructor
    PUBLIC METHOD PostComPE()
    PUBLIC METHOD ConsultarSituacaoTransportador()
    PUBLIC METHOD GerarNumeroCIOT()
    PUBLIC METHOD DeclaracaoOperacaoTransporte()
    PUBLIC METHOD CancelamentoOperacaoTransporte()
    PUBLIC METHOD EncerramentoOperacaoTransporte()

END CLASS

/*{Protheus.doc} New()
Método construtor do objeto
@author Carlos Alberto Gomes Junior
@since 23/05/2026
*/
METHOD New() CLASS TMSANTTInt
	Local aCertif := {} As Array

	::cResult := ""
	::oResult := JsonObject():New()
	::oDadosCIOT := JsonObject():New()
	::lAPIOk := .F.
	::lDEGOk := .F.
	::cHttpCode := ""
	If APamCertDig("04", @aCertif )
		::cCertPEM := aCertif[1]
		::cKeyPEM := aCertif[2]
		::cPASS := aCertif[3]
		::cURL := aCertif[4]
		::cNPJFor := aCertif[5]
		::cRNTRC := aCertif[6]
		::lDEGOk := .T.
	EndIf

Return

/*{Protheus.doc} PostComPE()
Método de acionamento da API por Post com pontos de entrada
@author Carlos Alberto Gomes Junior
@since 23/05/2026
*/
METHOD PostComPE( cUrlComApi, cBody ) CLASS TMSANTTInt
	Local xRetPE
	Local cPostRet As Character
	Local cHeaderRet := "" As Character
	Local nLog := 0 As Numeric
	Local cPilha := "" As Character
	Local nPilha := 0 As Numeric

	If lTMSANTT1
		xRetPE := ExecBlock("TMSANTT1",.F.,.F.,{cUrlComApi, cBody})
		If ValType(xRetPE) == "A" .And. Len(xRetPE) == 2
			If !Empty(xRetPE[1])
				cUrlComApi := xRetPE[1]
			EndIf
			If !Empty(xRetPE[2])
				cBody := xRetPE[2]
			EndIf
		EndIf
	EndIf

	cPostRet := HTTPSPost( cUrlComApi, ::cCertPEM, ::cKeyPEM, ::cPASS, ,;
			EncodeUTF8(cBody), 120, {'Content-Type: application/json'},  @cHeaderRet )
	If ValType( cPostRet ) == "C"
		::cResult := DecodeUTF8( cPostRet )
	EndIf
	::cHttpCode := CValToChar( HttpGetStatus( @cHeaderRet ) )

	If SuperGetMV("MV_ANTTLOG",,.F.)
	 	If !File( "\antt" )
			MakeDir("\antt")
		EndIf
		If ( nLog := FOpen("\antt\"+Left(FWTimeStamp(3), 10) + "-antt.log", FO_READWRITE + FO_SHARED )) < 0
			nLog := FCreate("\antt\"+Left(FWTimeStamp(3), 10) + "-antt.log", FO_READWRITE + FO_SHARED )
		EndIf
		If nLog > 0			
			FSeek( nLog, 0, FS_END) // Posiciona no fim do arquivo
			FWrite( nLog, FWTimeStamp( 3 ) + " - " + ProcName(1) + ": " + CValToChar(ProcLine(1)) + CRLF)
			For nPilha := 2 To 5
				cPilha += ProcName(nPilha) + ": " + CValToChar(ProcLine(nPilha)) + Iif( nPilha == 5 , " " ,"," )
			Next
			FWrite( nLog, "Pilha: " + cPilha + CRLF)
			FWrite( nLog, "Url+Api: " + cUrlComApi + CRLF)
			FWrite( nLog, "Body: " + cBody  + CRLF )
			FWrite( nLog, "Retorno: ["+::cHttpCode+"]" + ::cResult  + CRLF)
			FWrite( nLog, Replicate("=",60)  + CRLF)
			FClose(nLog)
		EndIf
	EndIf

	If lTMSANTT2
		xRetPE := ExecBlock("TMSANTT2",.F.,.F.,{ cUrlComApi, ::cResult })
		If ValType(xRetPE) == "C" .And. !Empty(xRetPE)
			::cResult := xRetPE
		EndIf
	EndIf

Return

/*{Protheus.doc} ConsultarSituacaoTransportador()
Método de acionamento da API de consulta do certificado e configurações
@author Carlos Alberto Gomes Junior
@since 23/05/2026
*/
METHOD ConsultarSituacaoTransportador( ) CLASS TMSANTTInt
	Local cApi := "pefServices/api/ConsultarSituacaoTransportador" As Character
	Local oBody As Object

	::lAPIOk := .F.
	If ::lDEGOk
		oBody := JsonObject():New()
		oBody["CpfCnpjInteressado"] := ::cNPJFor
		oBody["CpfCnpjTransportador"] := ::cNPJFor
		oBody["RNTRCTransportador"] := ::cRNTRC

		::PostComPE( ::cURL+cApi, oBody:toJson() )

		If !Empty(::cResult) 
			::oResult:FromJson(::cResult)
			If ::oResult:hasProperty("Codigo")
				::lAPIOk := ( ::oResult["Codigo"] == "111" )
			EndIf
		EndIf
	EndIf

Return ::lAPIOk

/*{Protheus.doc} GerarNumeroCIOT()
Método de acionamento da API de Geração de Numero de CIOT
Endereço consguido descompilando a DLL não documentado na ANTT
@author Carlos Alberto Gomes Junior
@since 23/05/2026
*/
METHOD GerarNumeroCIOT( ) CLASS TMSANTTInt
	Local cApi := "pefServices/Gerar" As Character
	Local oBody As Object

	::lAPIOk := .F.
	If ::lDEGOk

		oBody := JsonObject():New()
		oBody["cpfCnpj"] := ::cNPJFor
		//Se URL Produção (não homologação) substitui pela URL da TOTVS
		//alteração provisória solicitada pelo P.O. Felipe Barbiere
		If !( "hml" $ ::cURL )
			oBody["ambiente"] := "PRODUCAO"
			cApi := "https://ciot-antt.azurewebsites.net/api/ciot/gerar?code=i5WT-3ZhJ0Pzs4t0xrkIQsHTDveOWCWzKSS6K8a0MHnXAzFuApx1lg%3D%3D"

			::PostComPE( cApi, oBody:toJson() )

			If !Empty(::cResult) 
				::oResult:FromJson(::cResult)
				If ::oResult:hasProperty("sucesso")
					If ( ::lAPIOk := ::oResult["sucesso"] )
						::oDadosCIOT := JsonObject():New()
						::oDadosCIOT["CIOT"] := ::oResult["dados"]
					EndIf
				EndIf
			EndIf

		Else

			::PostComPE( ::cURL+cApi, oBody:toJson() )

			If !Empty(::cResult) 
				::oResult:FromJson(::cResult)
				If ::oResult:hasProperty("Sucesso")
					If ( ::lAPIOk := ::oResult["Sucesso"] )
						::oDadosCIOT := ::oResult["Dados"]
					EndIf
				EndIf
			EndIf

		EndIf
		
	EndIf

Return ::lAPIOk

/*{Protheus.doc} DeclaracaoOperacaoTransporte()
Método de acionamento da API de Envio dos dados do CIOT
@author Carlos Alberto Gomes Junior
@since 23/05/2026
*/
METHOD DeclaracaoOperacaoTransporte( cFilOri, cViagem, lContin ) CLASS TMSANTTInt
	Local cApi := "pefServices/api/DeclaracaoOperacaoTransporte" As Character
	Local oBody As Object
	Local aAreas := { DUN->(GetArea()), DA8->(GetArea()), DLO->(GetArea()), DUY->(GetArea()), DTQ->(GetArea()), GetArea() }
	Local oDetVia As Object

	Default lContin := .F.

	::lAPIOk := .F.
	If ::lDEGOk
		DTQ->( DbSetOrder( 2 ) )
		DTQ->( MsSeek( FWxFilial("DTQ") + cFilOri + cViagem ) )
		oDetVia := RetDetVia( cFilOri, cViagem )

		oBody := JsonObject():New()
		oBody["IdOperacaoTransporte"] := ::oDadosCIOT["CIOT"]
		oBody["TipoOperacao"] := Iif( Len(oDetVia["CGCDev"]) == 1, 1, 2 )  //1 - Lotação, 2 - Fracionada ou 3 - TAG Agregado
		::oDadosCIOT["TipoOperacao"] := oBody["TipoOperacao"]
		oBody["CpfCnpjContratado"] := ::cNPJFor //Por ser Frota Propria envia o mesmo da Contratante
		oBody["RNTRCContratado"] := ::cRNTRC //Por ser Frota Propria envia o mesmo da Contratante
		oBody["CpfCnpjContratante"] := ::cNPJFor
		oBody["RNTRCContratante"] := ::cRNTRC
		oBody["CpfCnpjDestinatario"] := Iif( Len(oDetVia["CGCDev"]) == 0, ::cNPJFor, oDetVia["CGCDes"][Len(oDetVia["CGCDes"])] )
		oBody["ValorFrete"] := oDetVia["ValFre"]
		oBody["DataDeclaracao"] := FWTimeStamp( 3, Iif( lContin, DTQ->DTQ_DATGER, ) )
		If ( oBody["IndContingencia"] := lContin )
			oBody["JustificativaContingencia"] := ::oDadosCIOT["JustificativaContingencia"]
		EndIf
		oBody["DataInicioViagem"] := Left( FWTimeStamp( 3, Iif( lContin, DTQ->DTQ_DATGER, ) ), 10 )
		oBody["DataFimViagem"] := Left( FWTimeStamp( 3, Iif( lContin, DTQ->DTQ_DATGER, dDataBase ) + SuperGetMV("MV_FIMCONT",,30) ), 10 )
		oBody["Veiculos"] := oDetVia["Veiculos"]

		//Vetor de posição unica de origens e destinos
		oBody["OrigemDestino"] := { JsonObject():New() } //Origem Filial e Destino Somente a ultima entrega
		oBody["OrigemDestino"][1]["Origem"] := JsonObject():New()
		oBody["OrigemDestino"][1]["Origem"]["CodigoMunicipioOrigem"] := oDetVia["MunOri"]
		//oBody["OrigemDestino"][1]["Origem"]["CepOrigem"]
		oBody["OrigemDestino"][1]["Destino"] := JsonObject():New()
		oBody["OrigemDestino"][1]["Destino"]["CodigoMunicipioDestino"] := oDetVia["MunDes"]
		//oBody["OrigemDestino"][1]["Destino"]["CepDestino"]
		If oDetVia["Coords"]["Encontrou"]
			oBody["OrigemDestino"][1]["Origem"]["LatitudeOrigem"] := oDetVia["Coords"]["LatitudeOri"]
			oBody["OrigemDestino"][1]["Origem"]["LongitudeOrigem"] := oDetVia["Coords"]["LongitudeOri"]
			oBody["OrigemDestino"][1]["Destino"]["LatitudeDestino"] := oDetVia["Coords"]["LatitudeDes"]
			oBody["OrigemDestino"][1]["Destino"]["LongitudeDestino"] := oDetVia["Coords"]["LongitudeDes"]
		Endif
		oBody["OrigemDestino"][1]["DistanciaPercorrida"] := Round( oDetVia["KM"] , 0 )

		oBody["DadosCarga"] := JsonObject():New()
		oBody["DadosCarga"]["CodigoNaturezaCarga"] := Val( Left( oDetVia["NCM"], 4 ) )
		oBody["DadosCarga"]["PesoCarga"] := Round( oDetVia["Peso"], 2 )
		oBody["DadosCarga"]["CodigoTipoCarga"] := Val( Posicione( 'DLO', 1, FwxFilial('DLO') + DTQ->DTQ_TPOPVG, 'DLO_CODTPC' ) )
		If oBody["TipoOperacao"] == 2
			oBody["DadosCarga"]["ContratantesCargFrac"] := Iif( Len(oDetVia["CGCDev"]) == 0, { ::cNPJFor }, oDetVia["CGCDes"] )
		EndIf
		oBody["InfPagamento"] := {}
		//oBody["InfPagamento"][1] := JsonObject():New()
		//oBody["InfPagamento"][1]["TipoPagamento"] := 5
		//oBody["InfPagamento"][1]["CodigoInstituicaoFinanceira"] := 1
		//oBody["InfPagamento"][1]["NumeroAgencia"] := ""
		//oBody["InfPagamento"][1]["NumeroConta"] := ""
		//oBody["InfPagamento"][1]["ChavePix"] := ""
		//oBody["InfPagamento"][1]["CpfCnpjCreditado"] := ""
		//oBody["InfPagamento"][1]["CodigoPagamento"] := ""
		//oBody["InfPagamento"][1]["IdentificadorPix"] := ""
		//oBody["InfPagamento"][1]["IndPagamento"] := 0
		//oBody["InfPagamento"][1]["NumeroParcela"] := 1
		//oBody["InfPagamento"][1]["DataVencimento"] := Left( FWTimeStamp( 3 ), 10 )
		//oBody["InfPagamento"][1]["ValorParcela"] := 0

		oBody["InfIndicadoresOperacionais"] := JsonObject():New()
		oBody["InfIndicadoresOperacionais"]["IndAltoDesempenho"] := DTQ->( Iif( ColumnPos( "DTQ_ALTDES" ) > 0, DTQ_ALTDES == "1", .F. ) )
		//Retorno vazio somente se eixos de ida e de volta informados e um menos o outro for maior que zero (eixo suspenso)
		oBody["InfIndicadoresOperacionais"]["IndRetornoVazio"] := ( oDetVia["EixoIda"] != 0 .And. oDetVia["EixoVolta"] != 0 .And. (oDetVia["EixoIda"] - oDetVia["EixoVolta"]) > 0 )
		oBody["InfIndicadoresOperacionais"]["ComposicaoVeicular"] := ( Len(oDetVia["VeiFor"]) > 1 .And. oDetVia["VeiFor"][2]["Frota"] != '1' .And. oDetVia["VeiFor"][1]["Fornecedor"] != oDetVia["VeiFor"][2]["Fornecedor"])

		::PostComPE( ::cURL+cApi, oBody:toJson() )

		If !Empty(::cResult) 
			::oResult:FromJson(::cResult)
			If ::oResult:hasProperty("Codigo")
				If ( ::lAPIOk := ( ::oResult["Codigo"] == "110" ) )
					::oDadosCIOT["CIOT"] := ::oResult["Protocolo"]
				EndIf
			EndIf			
		EndIf

	EndIf

	AEval( aAreas, { |aArea| RestArea(aArea) } )
	FWFreeArray(aAreas)

Return ::lAPIOk

/*{Protheus.doc} CancelamentoOperacaoTransporte()
Método de acionamento da API de Cancelamento do CIOT
@author Carlos Alberto Gomes Junior
@since 23/05/2026
*/
METHOD CancelamentoOperacaoTransporte( cFilOri, cViagem ) CLASS TMSANTTInt
	Local cApi := "pefServices/api/CancelamentoOperacaoTransporte" As Character
	Local oBody As Object

	::lAPIOk := .F.
	If ::lDEGOk
		oBody := JsonObject():New()
		oBody["CodigoIdentificacaoOperacao"] := AllTrim(::oDadosCIOT["CIOT"])
		oBody["MotivoCancelamento"] := STR0007 + cFilOri + "/" + cViagem + STR0008 + AllTrim(cUserName) //-- "Estorno do fechamento da Viagem: [" //-- "] no TOTVS Protheus TMS pelo usuário: "

		::PostComPE( ::cURL+cApi, oBody:toJson() )

		If !Empty(::cResult) 
			::oResult:FromJson(::cResult)
			If ::oResult:hasProperty("Codigo")
				::lAPIOk := ( ::oResult["Codigo"] == "110" )
			EndIf
		EndIf
	EndIf

Return ::lAPIOk

/*{Protheus.doc} EncerramentoOperacaoTransporte()
Método de acionamento da API de Encerramento do CIOT
@author Carlos Alberto Gomes Junior
@since 23/05/2026
*/
METHOD EncerramentoOperacaoTransporte( cFilOri, cViagem ) CLASS TMSANTTInt
	Local cApi := "pefServices/api/EncerramentoOperacaoTransporte" As Character
	Local oBody As Object
	Local oDetVia As Object

	::lAPIOk := .F.
	If ::lDEGOk
		oBody := JsonObject():New()
		oBody["CodigoIdentificacaoOperacao"] := AllTrim(::oDadosCIOT["CIOT"])
		If ::oDadosCIOT["TipoOperacao"] == 1 //Apenas para lotação.
			oDetVia := RetDetVia( cFilOri, cViagem )
			oBody["DadosCarga"] := JsonObject():New()
			oBody["DadosCarga"]["PesoTotalCarga"] := Round(oDetVia["Peso"], 2)
		EndIf
		::PostComPE( ::cURL+cApi, oBody:toJson() )

		If !Empty(::cResult) 
			::oResult:FromJson(::cResult)
			If ::oResult:hasProperty("Codigo")
				::lAPIOk := ( ::oResult["Codigo"] == "110" .Or. ::oResult["Codigo"] == "251" )
			EndIf
		EndIf
	EndIf

Return ::lAPIOk

/*{Protheus.doc} RetDetVia()
Busca informações da viagem e monta objeto json com elas
@author Carlos Alberto Gomes Junior
@since 23/05/2026
*/
Function RetDetVia( cFilOri, cViagem )
	Local aAreas := { SB1->(GetArea()), DUM->(GetArea()), DTC->(GetArea()), DUN->(GetArea()), DUY->(GetArea()), GetArea() } As Array
	Local oDetVia := JsonObject():New() As Object
	Local cQuery As Character
	Local cAliasQry As Character
	Local lDesDoc := .T. As Logical
	Local nPosProd As Numeric

	oDetVia["CGCDev"] := {}
	oDetVia["CGCDes"] := {}
	oDetVia["Peso"] := 0
	oDetVia["QtdDoc"] := 0
	oDetVia["ValFre"] := 0
	oDetVia["CDROri"] := ""
	oDetVia["MunOri"] := ""
	oDetVia["CDRDes"] := ""
	oDetVia["MunDes"] := ""
	oDetVia["Coords"] := JsonObject():New()
	oDetVia["KM"] := 0
	oDetVia["SerTMS"] := "3"
	oDetVia["Produtos"] := {}
	oDetVia["NCM"] := ""

	cQuery := "SELECT "
	cQuery += "DTQ.DTQ_ROTA, DTQ.DTQ_SERTMS, DTQ.DTQ_KMVGE,"
	cQuery += "DTQ.DTQ_CDRORI, DUYORI.DUY_CODMUN MUNORI, DUYORI.DUY_EST ESTORI,"
	cQuery += "DA8.DA8_CDRORI, DUYRORI.DUY_CODMUN MUNRORI, DUYRORI.DUY_EST ESTRORI,"
	cQuery += "DTQ.DTQ_CDRDES, DUYDES.DUY_CODMUN MUNDES, DUYDES.DUY_EST ESTDES"
	cQuery += "FROM " + RetSQLName("DTQ") + " DTQ "
	cQuery += "LEFT OUTER JOIN " + RetSQLName("DUY") + " DUYORI "
	cQuery +=   "ON DUYORI.DUY_FILIAL = ? "
	cQuery +=   "AND DUYORI.DUY_GRPVEN = DTQ.DTQ_CDRORI "
	cQuery +=   "AND DUYORI.D_E_L_E_T_ = ' ' "
	cQuery += "LEFT OUTER JOIN " + RetSQLName("DUY") + " DUYDES "
	cQuery +=   "ON DUYDES.DUY_FILIAL = ? "
	cQuery +=   "AND DUYDES.DUY_GRPVEN = DTQ.DTQ_CDRDES "
	cQuery +=   "AND DUYDES.D_E_L_E_T_ = ' ' "
	cQuery += "LEFT OUTER JOIN " + RetSQLName("DA8") + " DA8 "
	cQuery +=   "ON DA8.DA8_FILIAL = ? "
	cQuery +=   "AND DA8.DA8_COD = DTQ.DTQ_ROTA "
	cQuery +=   "AND DA8.D_E_L_E_T_ = ' ' "
	cQuery += "LEFT OUTER JOIN " + RetSQLName("DUY") + " DUYRORI "
	cQuery +=   "ON DUYRORI.DUY_FILIAL = ? "
	cQuery +=   "AND DUYRORI.DUY_GRPVEN = DA8.DA8_CDRORI "
	cQuery +=   "AND DUYRORI.D_E_L_E_T_ = ' ' "
	cQuery += "WHERE "
	cQuery +=   "DTQ.DTQ_FILIAL = ? "
	cQuery +=   "AND DTQ.DTQ_FILORI = ? "
	cQuery +=   "AND DTQ.DTQ_VIAGEM = ? "
	cQuery +=   "AND DTQ.D_E_L_E_T_ = ' '"

	cQuery := ChangeQuery( cQuery )
	oQry := FwExecStatement():New( cQuery )
	oQry:SetString( 1, FWxFilial("DUY") )
	oQry:SetString( 2, FWxFilial("DUY") )
	oQry:SetString( 3, FWxFilial("DA8") )
	oQry:SetString( 4, FWxFilial("DUY") )
	oQry:SetString( 5, FWxFilial("DTQ") )
	oQry:SetString( 6, cFilOri )
	oQry:SetString( 7, cViagem )

	cAliasQry := oQry:OpenAlias()
	If !(cAliasQry)->(Eof())
		oDetVia["KM"] := (cAliasQry)->DTQ_KMVGE
		oDetVia["SerTMS"] := (cAliasQry)->DTQ_SERTMS
		//Origem 
		//Informado na viagem
		If !Empty((cAliasQry)->DTQ_CDRORI) .And. !Empty((cAliasQry)->ESTORI) .And. !Empty((cAliasQry)->MUNORI)
			oDetVia["CDROri"] := (cAliasQry)->DTQ_CDRORI
			oDetVia["MunOri"] := TMS120CdUf( (cAliasQry)->ESTORI ,"1") + (cAliasQry)->MUNORI
		//Origem da rota
		ElseIf !Empty((cAliasQry)->DA8_CDRORI) .And. !Empty((cAliasQry)->ESTRORI) .And. !Empty((cAliasQry)->MUNRORI)
			oDetVia["CDROri"] := (cAliasQry)->DA8_CDRORI
			oDetVia["MunOri"] := TMS120CdUf( (cAliasQry)->ESTRORI ,"1") + (cAliasQry)->MUNRORI
		//Parâmetro da Filial
		Else
			oDetVia["CDROri"] := SuperGetMV("MV_CDRORI",,"")
			oDetVia["MunOri"] := TMS120CdUf( Posicione( "DUY", 1, FWxFilial("DUY") + oDetVia["CDROri"], "DUY_EST" ) ,"1") + DUY->DUY_CODMUN
		EndIf

		//Destino
		//Informado na Viagem
		If !Empty((cAliasQry)->DTQ_CDRDES) .And. !Empty((cAliasQry)->ESTDES) .And. !Empty((cAliasQry)->MUNDES)
			oDetVia["CDRDes"] := (cAliasQry)->DTQ_CDRDES
			oDetVia["MunDes"] := TMS120CdUf( (cAliasQry)->ESTDES ,"1") + (cAliasQry)->MUNDES
			lDesDoc := .F.
		Else
			//Se transferencia
			If (cAliasQry)->DTQ_SERTMS == "2"
				DUN->( DbSetOrder( 2 ) )
				DUN->( MsSeek( FWxFilial("DUN") + (cAliasQry)->DTQ_ROTA ))
				Do While !DUN->(Eof()) .And. DUN->(DUN_FILIAL+DUN_ROTEIR) == FWxFilial("DUN") + DTQ->DTQ_ROTA
					oDetVia["CDRDes"] := SuperGetMV( "MV_CDRORI",, "", DUN->DUN_FILDES )
					DUN->(DbSkip())
				EndDo
				oDetVia["MunDes"] := TMS120CdUf( Posicione( "DUY", 1, FWxFilial("DUY") + oDetVia["CDRDes"], "DUY_EST" ) ,"1") + DUY->DUY_CODMUN
				lDesDoc := Empty(DUY->DUY_CODMUN)
			EndIf
		EndIf
	EndIf
	(cAliasQry)->( DbCloseArea() )

	cQuery := "SELECT "
	cQuery +=     "DUD.DUD_SEQUEN, "
	cQuery +=     "SA1DEV.A1_CGC CGCDEV, "
	cQuery +=     "SA1DES.A1_CGC CGCDES, "
	cQuery +=     "DUY.DUY_EST, DUY.DUY_CODMUN, "
	cQuery +=     "DT6.DT6_PESO, DT6.DT6_SERTMS, DT6.DT6_VALFRE, "
	cQuery +=     "DT6.DT6_FILDOC, DT6.DT6_DOC, DT6.DT6_SERIE, "
	cQuery +=     "DT6.DT6_FILDCO, DT6.DT6_DOCDCO, DT6.DT6_SERDCO, "
	cQuery +=     "CASE WHEN DT6.DT6_SERTMS = '1' "
	cQuery +=          "THEN DT6.DT6_CDRDES "
	cQuery +=          "ELSE DT6.DT6_CDRCAL "
	cQuery +=          "END AS CDRDES "
	cQuery += "FROM " + RetSQLName("DUD") + " DUD "
	cQuery += "INNER JOIN " + RetSQLName("DT6") + " DT6 "
	cQuery +=     "ON DT6.DT6_FILIAL = ? "
	cQuery +=     "AND DT6.DT6_FILDOC = DUD.DUD_FILDOC "
	cQuery +=     "AND DT6.DT6_DOC = DUD.DUD_DOC "
	cQuery +=     "AND DT6.DT6_SERIE = DUD.DUD_SERIE "
	cQuery +=     "AND DT6.D_E_L_E_T_ = ' ' "
	cQuery += "LEFT OUTER JOIN " + RetSQLName("DUY") + " DUY "
	cQuery +=     "ON DUY.DUY_FILIAL = ? "
	cQuery +=     "AND DUY.DUY_GRPVEN = CASE WHEN DT6.DT6_SERTMS = '1' "
	cQuery +=                               "THEN DT6.DT6_CDRDES "
	cQuery +=                               "ELSE DT6.DT6_CDRCAL END "
	cQuery +=     "AND DUY.D_E_L_E_T_ = ' '  "
	cQuery += "LEFT OUTER JOIN " + RetSQLName("SA1") + " SA1DEV "
	cQuery +=     "ON SA1DEV.A1_FILIAL = ? "
	cQuery +=     "AND SA1DEV.A1_COD = DT6.DT6_CLIDEV "
	cQuery +=     "AND SA1DEV.A1_LOJA = DT6.DT6_LOJDEV "
	cQuery +=     "AND SA1DEV.D_E_L_E_T_ = ' '  "
	cQuery += "LEFT OUTER JOIN " + RetSQLName("SA1") + " SA1DES "
	cQuery +=     "ON SA1DES.A1_FILIAL = ? "
	cQuery +=     "AND SA1DES.A1_COD = DT6.DT6_CLIDEV "
	cQuery +=     "AND SA1DES.A1_LOJA = DT6.DT6_LOJDEV "
	cQuery +=     "AND SA1DES.D_E_L_E_T_ = ' ' "
	cQuery += "WHERE DUD.DUD_FILIAL = ? "
	cQuery +=     "AND DUD.DUD_FILORI = ? "
	cQuery +=     "AND DUD.DUD_VIAGEM = ? "
	cQuery +=     "AND DUD.D_E_L_E_T_ = ' ' "
	cQuery += "ORDER BY DUD.DUD_SEQUEN"

	DTC->( DbSetOrder(3) )
	DUM->( DbSetOrder(1) )
	SB1->( DbSetOrder(1) )

	cQuery := ChangeQuery( cQuery )
	oQry := FwExecStatement():New( cQuery )
	oQry:SetString( 1, FWxFilial("DT6") )
	oQry:SetString( 2, FWxFilial("DUY") )
	oQry:SetString( 3, FWxFilial("SA1") )
	oQry:SetString( 4, FWxFilial("SA1") )
	oQry:SetString( 5, FWxFilial("DUD") )
	oQry:SetString( 6, cFilOri )
	oQry:SetString( 7, cViagem )
	//oQry:getFixQuery()
	cAliasQry := oQry:OpenAlias()
	Do While !(cAliasQry)->(Eof())
		oDetVia["QtdDoc"]++
		oDetVia["Peso"] += (cAliasQry)->DT6_PESO
		oDetVia["ValFre"] += (cAliasQry)->DT6_VALFRE
		If lDesDoc .And. !Empty((cAliasQry)->CDRDES)
			oDetVia["CDRDes"] := (cAliasQry)->CDRDES
			oDetVia["MunDes"] := (cAliasQry)->( TMS120CdUf( DUY_EST ,"1") + DUY_CODMUN )
		EndIf
		If !Empty( (cAliasQry)->CGCDEV ) .And. AScan( oDetVia["CGCDev"], {|x| x == (cAliasQry)->CGCDEV } ) == 0
			AAdd( oDetVia["CGCDev"], AllTrim( (cAliasQry)->CGCDEV ) )
		EndIf
		If !Empty( (cAliasQry)->CGCDES ) .And. AScan( oDetVia["CGCDes"], {|x| x == (cAliasQry)->CGCDES } ) == 0
			AAdd( oDetVia["CGCDes"], AllTrim( (cAliasQry)->CGCDES ) )
		EndIf
		If (cAliasQry)->DT6_SERTMS != "1"
			If (cAliasQry)->( !Empty(DT6_FILDCO) .And. !Empty(DT6_DOCDCO) .And. !Empty(DT6_SERDCO) )
				DTC->( MsSeek( FWxFilial("DTC") + (cAliasQry)->(DT6_FILDCO+DT6_DOCDCO+DT6_SERDCO) ) )
				Do While !DTC->(Eof()) .And. DTC->(DTC_FILIAL+DTC_FILDOC+DTC_DOC+DTC_SERIE) == FWxFilial("DTC")+(cAliasQry)->(DT6_FILDCO+DT6_DOCDCO+DT6_SERDCO)
					If ( nPosProd := AScan( oDetVia["Produtos"], {|x| x[1] == DTC->DTC_CODPRO } ) ) == 0
						IF SB1->( MsSeek( FWxFilial("SB1") + DTC->DTC_CODPRO ) )
							DTC->( AAdd( oDetVia["Produtos"], { DTC_CODPRO,SB1->B1_POSIPI,DTC_VALOR,Iif(!Empty(SB1->B1_POSIPI),DTC_VALOR,0) } ) )
						EndIF
					Else
						oDetVia["Produtos"][nPosProd][3] += DTC->DTC_VALOR
						If !Empty(oDetVia["Produtos"][nPosProd][2])
							oDetVia["Produtos"][nPosProd][4] += DTC->DTC_VALOR
						EndIf
					EndIf
					DTC->(DbSkip())
				EndDo
			ElseIf DTC->( MsSeek( FWxFilial("DTC") + (cAliasQry)->(DT6_FILDOC+DT6_DOC+DT6_SERIE) ) )
				Do While !DTC->(Eof()) .And. DTC->(DTC_FILIAL+DTC_FILDOC+DTC_DOC+DTC_SERIE) == FWxFilial("DTC")+(cAliasQry)->(DT6_FILDOC+DT6_DOC+DT6_SERIE)
					If ( nPosProd := AScan( oDetVia["Produtos"], {|x| x[1] == DTC->DTC_CODPRO } ) ) == 0
						IF SB1->( MsSeek( FWxFilial("SB1") + DTC->DTC_CODPRO ) )
							DTC->( AAdd( oDetVia["Produtos"], { DTC_CODPRO,SB1->B1_POSIPI,DTC_VALOR,Iif(!Empty(SB1->B1_POSIPI),DTC_VALOR,0) } ) )
						EndIF
					Else
						oDetVia["Produtos"][nPosProd][3] += DTC->DTC_VALOR
						If !Empty(oDetVia["Produtos"][nPosProd][2])
							oDetVia["Produtos"][nPosProd][4] += DTC->DTC_VALOR
						EndIf
					EndIf
					DTC->(DbSkip())
				EndDo
			EndIf
		ElseIf DUM->( MsSeek( FWxFilial("DUM") + (cAliasQry)->(DT6_FILDOC+DT6_DOC) ) )
			Do While !DUM->(Eof()) .And. DUM->(DUM_FILIAL+DUM_FILORI+DUM_NUMSOL) == FWxFilial("DUM")+(cAliasQry)->(DT6_FILDOC+DT6_DOC)
				If ( nPosProd := AScan( oDetVia["Produtos"], {|x| x[1] == DTC->DTC_CODPRO } ) ) == 0
					IF SB1->( MsSeek( FWxFilial("SB1") + DUM->DUM_CODPRO ) )
						DUM->( AAdd( oDetVia["Produtos"], { DUM_CODPRO,SB1->B1_POSIPI,DUM_VALMER,Iif(!Empty(SB1->B1_POSIPI),DUM_VALMER,0) } ) )
					EndIF
				Else
					oDetVia["Produtos"][nPosProd][3] += DUM->DUM_VALMER
					If !Empty(oDetVia["Produtos"][nPosProd][2])
						oDetVia["Produtos"][nPosProd][4] += DUM->DUM_VALMER
					EndIf
				EndIf
				DUM->(DbSkip())
			EndDo
		EndIf
		(cAliasQry)->( DbSkip() )
	EndDo
	(cAliasQry)->( DbCloseArea() )

	If Len(oDetVia["Produtos"]) > 0
		oDetVia["Produtos"] := ASort(oDetVia["Produtos"],,,{|x,y| x[4] > y[4] })
		If !Empty(oDetVia["Produtos"][1][2])
			oDetVia["NCM"] := AllTrim( oDetVia["Produtos"][1][2] )
		EndIf
	EndIf
	If Empty(oDetVia["NCM"])
		IF SB1->( MsSeek( FWxFilial("SB1") + SuperGetMV("MV_PROGEN") ) )
			oDetVia["NCM"] := SB1->B1_POSIPI
		Endif
	EndIf

	oDetVia["Peso"] := Iif( oDetVia["Peso"] == 0, 0.01, Round( oDetVia["Peso"], 2 ) )

	If oDetVia["KM"] == 0
		oDetVia["KM"] := TmsTotDis(,,oDetVia["CDROri"],oDetVia["CDRDes"],"1",)
	EndIf
	oDetVia["KM"] := Round( oDetVia["KM"], 0 )
	oDetVia["Coords"] := BuscaCoord( oDetVia["CDROri"], oDetVia["CDRDes"] )

	cQuery := "SELECT "
	cQuery +=   "DA3V.DA3_PLACA PLCAV, DA3V.DA3_QTDEIX EIXOV,DA3V.DA3_CODFOR CODFORV,DA3V.DA3_LOJFOR LOJFORV,DA3V.DA3_FROVEI FROVEIV,"
	cQuery +=   "DA31.DA3_PLACA PLCA1, DA31.DA3_QTDEIX EIXO1,DA31.DA3_CODFOR CODFOR1,DA31.DA3_LOJFOR LOJFOR1,DA31.DA3_FROVEI FROVEI1,"
	cQuery +=   "DA32.DA3_PLACA PLCA2, DA32.DA3_QTDEIX EIXO2,DA32.DA3_CODFOR CODFOR2,DA32.DA3_LOJFOR LOJFOR2,DA32.DA3_FROVEI FROVEI2,"
	cQuery +=   "DA33.DA3_PLACA PLCA3, DA33.DA3_QTDEIX EIXO3,DA33.DA3_CODFOR CODFOR3,DA33.DA3_LOJFOR LOJFOR3,DA33.DA3_FROVEI FROVEI3,"
	cQuery +=   "DTR_QTDEIX, DTR.DTR_QTEIXV, DTR.DTR_VALFRE "
	cQuery += "FROM " + RetSQLName("DTR") + " DTR "
	cQuery += "INNER JOIN " + RetSQLName("DA3") + " DA3V "
	cQuery +=   "ON DA3V.DA3_FILIAL = ? "
	cQuery +=   "AND DA3V.DA3_COD = DTR_CODVEI "
	cQuery +=   "AND DA3V.D_E_L_E_T_ = ' ' "
	cQuery += "LEFT OUTER JOIN " + RetSQLName("DA3") + " DA31 "
	cQuery +=   "ON DA31.DA3_FILIAL = ? "
	cQuery +=   "AND DA31.DA3_COD = DTR_CODRB1 "
	cQuery +=   "AND DA31.D_E_L_E_T_ = ' ' "
	cQuery += "LEFT OUTER JOIN " + RetSQLName("DA3") + " DA32 "
	cQuery +=   "ON DA32.DA3_FILIAL = ? "
	cQuery +=   "AND DA32.DA3_COD = DTR_CODRB2 "
	cQuery +=   "AND DA32.D_E_L_E_T_ = ' ' "
	cQuery += "LEFT OUTER JOIN " + RetSQLName("DA3") + " DA33 "
	cQuery +=   "ON DA33.DA3_FILIAL = ? "
	cQuery +=   "AND DA33.DA3_COD = DTR_CODRB3 "
	cQuery +=   "AND DA33.D_E_L_E_T_ = ' ' "
	cQuery += "WHERE DTR.DTR_FILIAL = ? "
	cQuery +=   "AND DTR.DTR_FILORI = ? "
	cQuery +=   "AND DTR.DTR_VIAGEM = ? "
	cQuery +=   "AND DTR.D_E_L_E_T_ = ' '"

	cQuery := ChangeQuery( cQuery )
	oQry := FwExecStatement():New( cQuery )
	oQry:SetString( 1, FWxFilial("DA3") )
	oQry:SetString( 2, FWxFilial("DA3") )
	oQry:SetString( 3, FWxFilial("DA3") )
	oQry:SetString( 4, FWxFilial("DA3") )
	oQry:SetString( 5, FWxFilial("DTR") )
	oQry:SetString( 6, cFilOri )
	oQry:SetString( 7, cViagem )

	cAliasQry := oQry:OpenAlias()
	If !(cAliasQry)->(Eof())
		If (cAliasQry)->DTR_VALFRE != 0
			oDetVia["ValFre"] := (cAliasQry)->DTR_VALFRE
		Endif
		oDetVia["EixoIda"] := (cAliasQry)->DTR_QTDEIX
		oDetVia["EixoVolta"] := (cAliasQry)->DTR_QTEIXV
		oDetVia["Veiculos"] := {}
		oDetVia["VeiFor"] := {}
		AAdd( oDetVia["Veiculos"], JsonObject():New() )
		oDetVia["Veiculos"][1]["Placa"] := AllTrim((cAliasQry)->PLCAV)
		oDetVia["Veiculos"][1]["NumeroEixos"] := (cAliasQry)->EIXOV
		AAdd( oDetVia["VeiFor"], JsonObject():New() )
		oDetVia["VeiFor"][1]["Frota"] := (cAliasQry)->FROVEIV
		oDetVia["VeiFor"][1]["Fornecedor"] := (cAliasQry)->(CODFORV+LOJFORV)
		If !Empty((cAliasQry)->PLCA1)
			AAdd( oDetVia["Veiculos"], JsonObject():New() )
			oDetVia["Veiculos"][2]["Placa"] := AllTrim((cAliasQry)->PLCA1)
			oDetVia["Veiculos"][2]["NumeroEixos"] := (cAliasQry)->EIXO1
			AAdd( oDetVia["VeiFor"], JsonObject():New() )
			oDetVia["VeiFor"][2]["Frota"] := (cAliasQry)->FROVEI1
			oDetVia["VeiFor"][2]["Fornecedor"] := (cAliasQry)->(CODFOR1+LOJFOR1)
			If !Empty((cAliasQry)->PLCA2)
				AAdd( oDetVia["Veiculos"], JsonObject():New() )
				oDetVia["Veiculos"][3]["Placa"] := AllTrim((cAliasQry)->PLCA2)
				oDetVia["Veiculos"][3]["NumeroEixos"] := (cAliasQry)->EIXO2
				AAdd( oDetVia["VeiFor"], JsonObject():New() )
				oDetVia["VeiFor"][3]["Frota"] := (cAliasQry)->FROVEI2
				oDetVia["VeiFor"][3]["Fornecedor"] := (cAliasQry)->(CODFOR2+LOJFOR2)
				If !Empty((cAliasQry)->PLCA3)
					AAdd( oDetVia["Veiculos"], JsonObject():New() )
					oDetVia["Veiculos"][4]["Placa"] := AllTrim((cAliasQry)->PLCA3)
					oDetVia["Veiculos"][4]["NumeroEixos"] := (cAliasQry)->EIXO3
					AAdd( oDetVia["VeiFor"], JsonObject():New() )
					oDetVia["VeiFor"][4]["Frota"] := (cAliasQry)->FROVEI3
					oDetVia["VeiFor"][4]["Fornecedor"] := (cAliasQry)->(CODFOR3+LOJFOR3)
				EndIf
			EndIf
		EndIf
	EndIf
	(cAliasQry)->( DbCloseArea() )

	AEval( aAreas, { |aArea| RestArea( aArea ) } )
	FWFreeArray( aAreas )

Return oDetVia

/*{Protheus.doc} TesteANTT()
Executa o teste de comunicação com certificado e configurações.
@author Carlos Alberto Gomes Junior
@since 23/05/2026
*/
Function TesteANTT()
	Local oANTT := TMSANTTInt():New()
	
	If oANTT:ConsultarSituacaoTransportador( )
		MsgInfo(oANTT:oResult["Mensagem"],"Comunicação Ok")
	Else
		Help(,, STR0001,, StrTran(oANTT:cResult,CRLF,""), 1, 0,,,,,, {STR0002}) //-- "CIOT/ANTT - Problemas na Comunicação" //-- "Verifique as configurações e o certificado."
	EndIf
Return

/*{Protheus.doc} DeclaraCIOT()
Executa a Geração e Envio do CIOT
@author Carlos Alberto Gomes Junior
@since 23/05/2026
*/
Function DeclaraCIOT( cFilOri, cViagem )
	Local oANTT := TMSANTTInt():New()
	Local aAreas := { DTQ->(GetArea()), DTR->(GetArea()), GetArea() }
	Local lRet := .F.
	Local cJust As Character

	DTR->( DbSetOrder( 1 ) )
	If DTR->( MsSeek( FWxFilial("DTR") + cFilOri + cViagem ) )
		If Empty( DTR->DTR_CIOT )
			oANTT:GerarNumeroCIOT()
			If Empty(oANTT:oDadosCIOT["CIOT"])
				Help(,, STR0004,, StrTran(oANTT:cResult,CRLF,""), 1, 0,,,,,, {STR0002}) //-- "CIOT/ANTT - Problemas na Geração do número do CIOT" //--"Verifique as configurações e o certificado."
			EndIf
		ElseIf Len( AllTrim( DTR->DTR_CIOT ) ) == 12
			oANTT:oDadosCIOT["CIOT"] := AllTrim( DTR->DTR_CIOT )
		ElseIf Len( AllTrim( DTR->DTR_CIOT ) ) == 16 .And. Upper( Right( AllTrim( DTR->DTR_CIOT ), 4 ) ) == "XXXX"
			oANTT:oDadosCIOT["CIOT"] := Left( DTR->DTR_CIOT, 12 )
		Else
			Help(,, STR0009 + " [" + DTR->DTR_CIOT + "]",,; //--"Número de CIOT com formato inválido."
				 StrTran(oANTT:cResult,CRLF,""), 1, 0,,,,,, { STR0010, STR0011 } ) //--"O numero do CIOT deve estar em branco, ou gerado pelo excutável da ANTT," //--"tendo 12 caracteres ou em caso de contingência ser completado com XXXX."
		EndIf

		If !Empty(oANTT:oDadosCIOT["CIOT"]) .And. Len(oANTT:oDadosCIOT["CIOT"]) == 12
			If ( lRet := oANTT:DeclaracaoOperacaoTransporte( cFilOri, cViagem ) )
				RecLock("DTR",.F.)
				DTR->DTR_CIOT := oANTT:oDadosCIOT["CIOT"]
				DTR->DTR_TPCIOT := "1"
				DTR->DTR_DTFMCI := StoD("")
				DTR->DTR_TIPCRG := AllTrim(CValToChar(oANTT:oDadosCIOT["TipoOperacao"]))
				MsUnLock()
			Else
				//ANTT com erro ou fora do AR Grava CIOT para contingencia
				If oANTT:cHttpCode $ "400/403/404/500/503"
					Help(,, STR0012,,STR0013 + " ["+oANTT:cHttpCode+"]", 1, 0,,,,,, { STR0014, STR0015 }) //--"Sistema ANTT em contingência." //--"Sugerimos verificar se o problema não é local ou meramente uma instabiliade e se necessário estorne o processo." //--"Confirme também se o Job de Contingência está corretamente agendado e ativo."
					RecLock("DTR",.F.)
					DTR->DTR_CIOT := oANTT:oDadosCIOT["CIOT"] + "XXXX"
					DTR->DTR_TPCIOT := "1"
					DTR->DTR_DTFMCI := StoD("")
					DTR->DTR_TIPCRG := AllTrim(CValToChar(oANTT:oDadosCIOT["TipoOperacao"]))
					MsUnLock()
					DTQ->( DbSetOrder( 2 ) )
					If DTQ->(MsSeek( FWxFilial('DTQ') + cFilOri + cViagem ))
						cJust := Justificativa( MsMM(DTQ->DTQ_CODOBS), 1, oANTT:oDadosCIOT["CIOT"] )
						MSMM(DTQ->DTQ_CODOBS,,,cJust,1,,,"DTQ","DTQ_CODOBS")
					EndIf
					lRet := .T.
				Else
					Help(,, STR0003,, StrTran(oANTT:cResult,CRLF,""), 1, 0,,,,,, {STR0002}) //-- "CIOT/ANTT - Problemas na Declaração de Operação de Transporte" //--"Verifique as configurações e o certificado."
				EndIf
			EndIf
		EndIf

	EndIf

	AEval( aAreas, { |aArea| RestArea(aArea) } )
	FWFreeArray(aAreas)

Return lRet

/*{Protheus.doc} CancelaCIOT()
Executa a Cancelamento do CIOT
@author Carlos Alberto Gomes Junior
@since 23/05/2026
*/
Function CancelaCIOT( cFilOri, cViagem )
	Local oANTT := TMSANTTInt():New()
	Local aAreas := { DTQ->(GetArea()), DTR->(GetArea()), GetArea() }
	Local lRet := .F.
	Local cObs As Character

	DTR->( DbSetOrder( 1 ) )
	If DTR->( MsSeek( FWxFilial("DTR") + cFilOri + cViagem ) )
		oANTT:oDadosCIOT["CIOT"] := AllTrim( DTR->DTR_CIOT )
		If Len( oANTT:oDadosCIOT["CIOT"] ) == 16
			If ( lRet := ( Right( oANTT:oDadosCIOT["CIOT"], 4 ) == "XXXX" .Or. oANTT:CancelamentoOperacaoTransporte( cFilOri, cViagem ) ) )
				RecLock("DTR",.F.)
				DTR->DTR_CIOT := ""
				MsUnLock()
				If DTQ->(MsSeek( FWxFilial('DTQ') + cFilOri + cViagem ))
					cObs := Justificativa( MsMM(DTQ->DTQ_CODOBS), 3 )
					MSMM(DTQ->DTQ_CODOBS,,,cObs,1,,,"DTQ","DTQ_CODOBS")
				EndIf
			Else
				Help(,, STR0005,, StrTran(oANTT:cResult,CRLF,""), 1, 0,,,,,, {STR0002}) //-- "CIOT/ANTT - Problemas no CANCELAMENTO da Operação de Transporte." //--"Verifique as configurações e o certificado."
			EndIf
		EndIf
	EndIf

	AEval( aAreas, { |aArea| RestArea(aArea) } )
	FWFreeArray(aAreas)

Return lRet

/*{Protheus.doc} EncerraCIOT()
Executa a Encerramento do CIOT
@author Carlos Alberto Gomes Junior
@since 23/05/2026
*/
Function EncerraCIOT( cFilOri, cViagem, cCIOT, cTpOpera )
	Local oANTT := TMSANTTInt():New()
	Local aAreas := { DTR->(GetArea()), GetArea() }
	Local lRet := .F.

	DTR->( DbSetOrder( 1 ) )
	If DTR->( MsSeek( FWxFilial("DTR") + cFilOri + cViagem ) )
		oANTT:oDadosCIOT["CIOT"] := AllTrim( cCIOT )
		oANTT:oDadosCIOT["TipoOperacao"] := Val( cTpOpera )
		If Len( oANTT:oDadosCIOT["CIOT"] ) == 16
			If Right( oANTT:oDadosCIOT["CIOT"], 4 ) == "XXXX"
				lRet := .T.
			ElseIf oANTT:EncerramentoOperacaoTransporte( cFilOri, cViagem )
				lRet := .T.
				If oANTT:oResult["Codigo"] == "110"
					RecLock("DTR",.F.)
					DTR->DTR_DTFMCI := dDataBase
					MsUnLock()
				EndIf
			Else
				Help(,, STR0006,, StrTran(oANTT:cResult,CRLF,""), 1, 0,,,,,, {STR0002}) //-- "CIOT/ANTT - Problemas no ENCERRAMENTO da Operação de Transporte." //--"Verifique as configurações e o certificado."
			EndIf
		EndIf
	EndIf

	AEval( aAreas, { |aArea| RestArea(aArea) } )
	FWFreeArray(aAreas)

Return lRet

/*{Protheus.doc} JobContingencia()
Job de Contingencia
@author Carlos Alberto Gomes Junior
@since 26/05/2026
*/
Function JobContingencia()
	Local cQuery As Character
	Local oANTT := TMSANTTInt():New()
	Local aErrCiot := {} As Array
	
	cQuery := "SELECT "
	cQuery +=   "DTQ.R_E_C_N_O_ DTQREC, "
	cQuery +=   "DTR.R_E_C_N_O_ DTRREC "
 	cQuery += "FROM " + RetSQLName("DTQ") + " DTQ "
	cQuery += "INNER JOIN " + RetSQLName("DTR") + " DTR "
	cQuery +=    "ON DTR.DTR_FILIAL = ? "
	cQuery +=   "AND DTR.DTR_FILORI = DTQ.DTQ_FILORI "
	cQuery +=   "AND DTR.DTR_VIAGEM = DTQ.DTQ_VIAGEM "
	cQuery +=   "AND DTR.DTR_CODOPE IN ( ' ', '04' ) "
	cQuery +=   "AND SUBSTRING( DTR.DTR_CIOT,13,4 ) = 'XXXX' "
	cQuery +=   "AND DTR.D_E_L_E_T_ = ' ' "
	cQuery += "WHERE "
	cQuery +=   "DTQ.DTQ_FILIAL = ? "
	cQuery +=   "AND DTQ.D_E_L_E_T_ = ' ' "

	cQuery := ChangeQuery( cQuery )
	oQry := FwExecStatement():New( cQuery )
	oQry:SetString( 1, FWxFilial("DTR") )
	oQry:SetString( 2, FWxFilial("DTQ") )
	cAliasQry := oQry:OpenAlias()
	
	Do While !(cAliasQry)->(Eof())
		DTQ->( DbGoTo( (cAliasQry)->DTQREC ) )
		DTR->( DbGoTo( (cAliasQry)->DTRREC ) )
		oANTT:oDadosCIOT["CIOT"] := Left( DTR->DTR_CIOT, 12 )
		oANTT:oDadosCIOT["JustificativaContingencia"] := Justificativa( MsMM(DTQ->DTQ_CODOBS), 2 )
		If DTQ->( oANTT:DeclaracaoOperacaoTransporte( DTQ_FILORI, DTQ_VIAGEM, .T. ) )
			DTR->( DbGoTo( (cAliasQry)->DTRREC ) )
			RecLock("DTR",.F.)
			DTR->DTR_CIOT := oANTT:oDadosCIOT["CIOT"]
			DTR->DTR_TPCIOT := "1"
			DTR->DTR_DTFMCI := StoD("")
			DTR->DTR_TIPCRG := AllTrim(CValToChar(oANTT:oDadosCIOT["TipoOperacao"]))
			MsUnLock()
			If DTQ->DTQ_STATUS == '3'
				DTQ->( EncerraCIOT( DTQ_FILORI, DTQ_VIAGEM, DTR->DTR_CIOT, DTR->DTR_TIPCRG ) )
			EndIf
		Else
			AAdd(aErrCiot, {AllTrim(DTQ->DTQ_FILORI) + "/" + DTQ->DTQ_VIAGEM + " - ["+oANTT:cHttpCode+"]" + AllTrim(StrTran(oANTT:cResult,CRLF,"")) , '00', ''})
		EndIf
		(cAliasQry)->(DbSkip())
	EndDo
	(cAliasQry)->(DbCloseArea())

Return aErrCiot

/*{Protheus.doc} Justificativa()
Trata justificativa de CIOT em Contingencia
@author Carlos Alberto Gomes Junior
@since 26/05/2026
*/
Static Function Justificativa( cObs, nOpc, cCIOT )
	Local cRet := "" As Character
	Local nIni As Numeric
	Local nFim As Numeric
	Local cMarca := "CONTCIOT"
	Local nTam   := Len(cMarca) + 2

	Default cObs := ""
	Default nOpc := 0
	Default cCIOT := ""
	
	Do Case
	Case nOpc == 1 //Insere Nova Justificativa
		cRet := "#"+cMarca+"-" + STR0016 + cCIOT //--"CIOT número "
		cRet += STR0017 + DToC(dDataBase) + "-" + Time() //--" gerado em contingência em "
		cRet += STR0018 //--", devido à indisponibilidade técnica no sistema da ANTT. "
		cRet += STR0019 + AllTrim(cUserName) + "-"+cMarca+"#" //--"Usuário: "
		cRet += cObs
	Case nOpc == 2 //Busca Ultima Justificativa
		nIni := At( "#"+cMarca+"-", cObs )
		nFim := At( "-"+cMarca+"#", cObs )
		cRet := Substr( cObs, nIni+nTam, nFim-nIni-nTam )
	Case nOpc == 3 //Remove Justificativa
		nFim := At( "-"+cMarca+"#", cObs )
		cRet := Substr( cObs, nFim + nTam + 1)
	EndCase	

Return cRet

/*{Protheus.doc} BuscaCoord()
Busca coordenadas para a região origem e destino.
@author Carlos Alberto Gomes Junior
@since 26/05/2026
*/
Function BuscaCoord( cCDROri, cCDRDes )
	Local aAreas := { DAR->( GetArea() ), GetArea() }
	Local oCoords := JsonObject():New()

	Default cCDROri := ""
	Default cCDRDes := ""
	oCoords["Encontrou"] := .F.
	oCoords["LatitudeOri"] := 0
	oCoords["LongitudeOri"] := 0
	oCoords["LatitudeDes"] := 0
	oCoords["LongitudeDes"] := 0

	If !Empty(cCDROri) .And. !Empty(cCDROri)
		DAR->( DbSetOrder(1) )
		If DAR->( MsSeek( FWxFilial("DAR") + FWxFilial("DUY") + "DUY" + cCDROri ) )
			oCoords["LatitudeOri"] := Round( Val( DAR->DAR_LATITU ), 6 ) - 0.000001
			oCoords["LongitudeOri"] := Round( Val( DAR->DAR_LONGIT ), 6 )
			If DAR->( MsSeek( FWxFilial("DAR") + FWxFilial("DUY") + "DUY" + cCDRDes ) )
				oCoords["Encontrou"] :=.T.
				oCoords["LatitudeDes"] := Round( Val( DAR->DAR_LATITU ), 6 )
				oCoords["LongitudeDes"] := Round( Val( DAR->DAR_LONGIT ), 6 ) - 0.000001
			Else
				oCoords["LatitudeOri"] := 0
				oCoords["LongitudeOri"] := 0
			EndIf
		EndIf
	EndIf
	
	AEval( aAreas, { |aArea| RestArea(aArea) } )
	FWFreeArray(aAreas)

Return oCoords
