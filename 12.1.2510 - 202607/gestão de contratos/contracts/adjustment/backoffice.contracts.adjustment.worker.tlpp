#include "totvs.ch"
#include "tlpp-core.th"

namespace totvs.protheus.backoffice.contracts.adjustment

//-------------------------------------------------------------------
/*/{Protheus.doc} ContractAdjustmentWorker
    @description Processa uma unidade isolada de reajuste consumindo apenas contexto, adapter e resultado.
    @type class
    @author guilherme.sordi@totvs.com.br
    @since 11/05/2026
    @version 12.1.2510
*/
//-------------------------------------------------------------------
class ContractAdjustmentWorker
	private data oLegacyAdapter as object

	public method new(oLegacyAdapter as object) as object
	public method execute(oContext as object) as object

	private method ensureLegacyAdapter() as object
	private method buildInfrastructureError(oContext as object, cErrorCode as character, cErrorMessage as character) as object
endClass

/*/{Protheus.doc} new
    @description Inicializa o worker com um adapter legado opcional para injecao controlada.
    @author guilherme.sordi@totvs.com.br
    @since 11/05/2026
    @version 12.1.2510
/*/
method new(oLegacyAdapter as object) as object class ContractAdjustmentWorker
	self:oLegacyAdapter := oLegacyAdapter
return self

/*/{Protheus.doc} execute
    @description Executa uma unidade de reajuste delegando toda integracao legada ao adapter.
    @author guilherme.sordi@totvs.com.br
    @since 11/05/2026
    @version 12.1.2510
/*/
method execute(oContext as object) as object class ContractAdjustmentWorker
	local oAdapter as object
	local oResult as object

	oAdapter := self:ensureLegacyAdapter()
	oResult := oAdapter:execute(oContext)

	if oResult == NIL
		oResult := self:buildInfrastructureError(oContext, "WRK002", "Contract adjustment worker did not receive a result from the legacy adapter")
	endIf
return oResult

/*/{Protheus.doc} ensureLegacyAdapter
    @description Retorna o adapter legado configurado ou cria a instancia padrao do worker.
    @author guilherme.sordi@totvs.com.br
    @since 11/05/2026
    @version 12.1.2510
/*/
method ensureLegacyAdapter() as object class ContractAdjustmentWorker
	if self:oLegacyAdapter == NIL
		self:oLegacyAdapter := ContractAdjustmentLegacyAdapter():New()
	endIf
return self:oLegacyAdapter

/*/{Protheus.doc} buildInfrastructureError
    @description Monta um resultado padronizado para falhas internas do worker.
    @author guilherme.sordi@totvs.com.br
    @since 11/05/2026
    @version 12.1.2510
/*/
method buildInfrastructureError(oContext as object, cErrorCode as character, cErrorMessage as character) as object class ContractAdjustmentWorker
	local oResult := ContractAdjustmentResult():New() as object

	oResult:copyTraceFromContext(oContext)
	oResult:markError(cErrorCode, cErrorMessage)
return oResult
