#include "totvs.ch"
#include "tlpp-core.th"
#include "PROTHEUS.CH"
#include "FWBROWSE.CH"
#include "FWMVCDEF.CH"
#include "GCTXDEF.CH"
#include "backoffice.contracts.adjustment.cnta311.ch"

namespace totvs.protheus.backoffice.contracts.adjustment

// PUBLISH MODEL REST NAME CNTA311 SOURCE totvs.protheus.backoffice.contracts.adjustment.CNTA311

//-------------------------------------------------------------------
/*/{Protheus.doc} cnta311()
    Reajuste automático de contratos.

    @author Barbara Reis
    @since  07/08/2015
    @version 1.0
    @return nil
*/
//-------------------------------------------------------------------
function cnta311()
	local oBrowse  := Nil as object
	local oOrchestrator := Nil as object

	if !validateLegacyAdjustmentCompatibility()
		return
	endIf

	if !IsBlind()
		oBrowse := FWMBrowse():New()
		oBrowse:SetAlias("CXK")                                          
		oBrowse:SetDescription(STR0001) //Reajuste Automático de Contratos
		
		oBrowse:addLegend("Alltrim(CXK->CXK_SITUAC) == 'P'", "BLUE", "Pendente")
		oBrowse:addLegend("Alltrim(CXK->CXK_SITUAC) == 'C'", "GREEN", "Concluído")
		oBrowse:addLegend("Alltrim(CXK->CXK_SITUAC) == 'CF'", "ORANGE", "Concluído com falhas")

		if findFunction('hasSmartX') .and. hasSmartX()
			oBrowse:setSmartX()
		endif
		oBrowse:Activate()
	else
		oOrchestrator := ContractAdjustmentOrchestrator():New()
		oOrchestrator:promptAndExecute()
		FwFreeObj(oOrchestrator)
	endif
return

//-------------------------------------------------------------------
/*/{Protheus.doc} validateLegacyAdjustmentCompatibility()
    Valida requisitos de compatibilidade do CNTA311 para releases legados.

    @author guilherme.sordi@totvs.com.br
    @since  20/05/2026
    @version 12.1.2510
    @return logical
*/
//-------------------------------------------------------------------
static function validateLegacyAdjustmentCompatibility()
	local aArea := {} as array
	local cRelease := GetRpoRelease() as character
	local lHasRequiredFields := .T. as logical

	if cRelease > "12.1.2510"
		return .T.
	endIf

	aArea := FWGetArea()
	DbSelectArea("CXK")
	lHasRequiredFields := CXK->(FieldPos("CXK_DTREF")) > 0
	lHasRequiredFields := lHasRequiredFields .And. CXK->(FieldPos("CXK_DTAPL")) > 0
	lHasRequiredFields := lHasRequiredFields .And. CXK->(FieldPos("CXK_TPREV")) > 0
	FWRestArea(aArea)

	if !lHasRequiredFields
		if !IsBlind()
			Aviso("CNTA311", STR0002 + CRLF + STR0003, {"OK"}, 2) //"A rotina não pode ser executada porque os campos CXK_DTREF, CXK_DTAPL e CXK_TPREV precisam existir no dicionário." "Atualize o ambiente conforme o último pacote de expedição contínua do módulo Gestão de Contratos disponível no Portal do Cliente."
		endIf
		return .F.
	endIf
return .T.

//-------------------------------------------------------------------
/*/{Protheus.doc} schedDef()
    Prepara rotinas automáticas por Schedule.

    @author Israel.Escorizza
    @since 01/02/2018
    @version 1.0
    @return array
*/
//-------------------------------------------------------------------
function schedDef()
	local aReturn := { "P"     		,;  //1 - Tipo R para relatorio P para processo as array
				"CN310"		,;  //2 - Pergunte do relatorio, caso nao use passar ParamDef
								,;  //3 - Alias
								,;  //4 - Array de ordens
								,;  //5 - Titulo
								,; 	//6 - Nome do relatório (parametro 1 do metodo new da classe TReport)
					.F.     	,;	//7 - Indica se permite que o agendamento pode ser cadastrado como sempre ativo
					.T.	}    		//8 - Indica que o agendamento pode definir filiais de execução.
					
return aReturn

//-------------------------------------------------------------------
/*/{Protheus.doc} menuDef()
    Define as ações disponíveis no menu.

    @author Bárbara Reis
    @since 07/08/2015
    @version 1.0
    @return array com opções do menu
*/
//-------------------------------------------------------------------
function menudef()
	local aRotina as array
	
	aRotina := {}
	
	aAdd(aRotina, { "Visualizar", "ViewDef.totvs.protheus.backoffice.contracts.adjustment.cnta311", 0, 2 })
	aAdd(aRotina, { "Incluir", "totvs.protheus.backoffice.contracts.adjustment.promptAndExecute", 0, 3 })
	
return aRotina

//-------------------------------------------------------------------
/*/{Protheus.doc} modelDef()
    Define a estrutura do modelo.

    @author Barbara Reis
    @since  07/08/2015
    @version 1.0
    @return object modelo MVC
*/
//-------------------------------------------------------------------
function modelDef()
	local oStruCab	:= FWFormStruct(1,"CXK") as object
	local oStruGrid	:= FWFormStruct(1,"CXL") as object
	local oModel   	:= Nil as object

	oModel:= MPFormModel():New("totvs.protheus.backoffice.contracts.adjustment.cnta311", /*Pre-Validacao*/,/*Pos-Validacao*/,/*Commit*/,/*Cancel*/)

	oModel:AddFields("CXKMASTER", /*cOwner*/, oStruCab)
	oModel:AddGrid("CXLDETAIL", "CXKMASTER", oStruGrid)
	oModel:SetPrimaryKey( {} ) 

	oModel:SetRelation("CXLDETAIL",{{"CXL_FILIAL",'xFilial("CXL")'},{"CXL_NUMRJ","CXK_NUMERO"}},CXL->(IndexKey(1)))
	oModel:GetModel("CXLDETAIL"):SetUniqueLine({"CXL_ITEM"})
	oModel:GetModel("CXLDETAIL"):SetMaxLine(99999)	
return oModel

//--------------------------------------------------------------------
/*/{Protheus.doc} viewDef()
    Define a apresentação da view.

    @author Barbara Reis
    @since  07/08/2015
    @version 1.0
    @return object view MVC
*/
//--------------------------------------------------------------------
function viewDef()  

	local oModel	:= FWLoadModel( "totvs.protheus.backoffice.contracts.adjustment.cnta311" ) as object
	local oMasterStruct	:= FWFormStruct(2,"CXK") as object
	local oDetailStruct	:= FWFormStruct(2,"CXL") as object
	local oView		:= FWFormView():New() as object

	oView:SetModel(oModel)

	oView:AddField("VIEW_CXK", oMasterStruct, "CXKMASTER")
	oView:AddGrid("VIEW_CXL", oDetailStruct, "CXLDETAIL") 

	oView:CreateHorizontalBox("MASTERBOX",25)
	oView:CreateHorizontalBox("DETAILBOX",75)

	oView:SetOwnerView("VIEW_CXK","MASTERBOX")
	oView:SetOwnerView("VIEW_CXL","DETAILBOX")

return oView	 

//--------------------------------------------------------------------
/*/{Protheus.doc} promptAndExecute()
    Wrapper público que inicializa o fluxo de perguntas.

    @author miguel.santos
    @since  13/08/2015
    @version 1.0
    @return logical resultado da execução
*/
//--------------------------------------------------------------------
function promptAndExecute()
	local oOrchestrator := ContractAdjustmentOrchestrator():New() as object
	local lRet := oOrchestrator:promptAndExecute() as logical

	FwFreeObj(oOrchestrator)
return lRet

