/*/
method adjustmentRevisionCode() as character class ContractAdjustmentLegacyAdapter
return "2"

/*/{Protheus.doc} revisionStatusInReviewCode
	@description Retorna o codigo de status correspondente a revisao em andamento.
	@author guilherme.sordi@totvs.com.br
	@since 11/05/2026
	@version 12.1.2510
/*/
method revisionStatusInReviewCode() as character class ContractAdjustmentLegacyAdapter
return "09"

/*/{Protheus.doc} defaultAdjustmentJustification
	@description Retorna a justificativa padrao utilizada na revisao automatica.
	@author guilherme.sordi@totvs.com.br
	@since 11/05/2026
	@version 12.1.2510
/*/
method defaultAdjustmentJustification() as character class ContractAdjustmentLegacyAdapter
return "Automatic contract adjustment"

/*/{Protheus.doc} finalizeLegacyState
	@description Finaliza o modelo legado e limpa o estado estatico residual da execucao.
	@author guilherme.sordi@totvs.com.br
	@since 11/05/2026
	@version 12.1.2510
/*/
method finalizeLegacyState() class ContractAdjustmentLegacyAdapter
	if self:oModel != NIL
		self:oModel:Deactivate()
		FwFreeObj(self:oModel)
		self:oModel := NIL
	endIf

	Cn300Clear()
return
