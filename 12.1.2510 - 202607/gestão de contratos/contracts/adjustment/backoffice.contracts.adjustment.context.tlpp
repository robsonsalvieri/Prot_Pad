#include "totvs.ch"
#include "msobject.ch"
#include "tlpp-core.th"

namespace totvs.protheus.backoffice.contracts.adjustment

//-------------------------------------------------------------------
/*/{Protheus.doc} ContractAdjustmentContext
	Explicit input contract for a single contract adjustment execution.
	The caller must resolve UI and Pergunte data before creating this object.
	    @since 11/05/2026
*/
//-------------------------------------------------------------------
class ContractAdjustmentContext
	public data cBranch as character
	public data cContract as character
	public data cRevision as character
	public data cContractSpecies as character
	public data cContractType as character
	public data cAdjustmentRevisionTypeCode as character
	public data dReferenceDate as date
	public data dAdjustmentDate as date
	public data lRunRetroactive as logical
	public data lApproveAfterAdjustment as logical
	public data cExecutionId as character
	public data cWorkerId as character
	public data cAdjustmentNumber as character
	public data cJustification as character

	public method new(jContext as json) as object
	public method fromJson(jContext as json) as object
	public method toJson() as character
	public method isValid() as logical
	public method validationMessage() as character

	private method applyDefaults() as object
	private method readCharacter(jSource as json, cProperty as character, cDefault as character) as character
	private method readDate(jSource as json, cProperty as character, dDefault as date) as date
	private method readLogical(jSource as json, cProperty as character, lDefault as logical) as logical
	private method hasJsonProperty(jSource as json, cProperty as character) as logical
	private method dateFromCharacter(cValue as character, dDefault as date) as date
endClass

/*/{Protheus.doc} new
	@description Inicializa o contexto de reajuste com valores padrao e JSON opcional de entrada.
	@author guilherme.sordi@totvs.com.br
	@since 11/05/2026
	@version 12.1.2510
/*/
method new(jContext as json) as object class ContractAdjustmentContext
	self:applyDefaults()

	if jContext != NIL
		self:fromJson(jContext)
	endIf
return self

/*/{Protheus.doc} fromJson
	@description Carrega os dados do contexto a partir de um objeto JSON explicito.
	@author guilherme.sordi@totvs.com.br
	@since 11/05/2026
	@version 12.1.2510
/*/
method fromJson(jContext as json) as object class ContractAdjustmentContext
	if jContext == NIL
		return self
	endIf

	self:cBranch := self:readCharacter(jContext, "branch", self:cBranch)
	self:cContract := self:readCharacter(jContext, "contract", self:cContract)
	self:cRevision := self:readCharacter(jContext, "revision", self:cRevision)
	self:cContractSpecies := self:readCharacter(jContext, "contractSpecies", self:cContractSpecies)
	self:cContractType := self:readCharacter(jContext, "contractType", self:cContractType)
	self:cAdjustmentRevisionTypeCode := self:readCharacter(jContext, "adjustmentRevisionTypeCode", self:cAdjustmentRevisionTypeCode)

	if Empty(self:cAdjustmentRevisionTypeCode)
		self:cAdjustmentRevisionTypeCode := self:readCharacter(jContext, "revisionType", self:cAdjustmentRevisionTypeCode)
	endIf

	self:dReferenceDate := self:readDate(jContext, "referenceDate", self:dReferenceDate)
	self:dAdjustmentDate := self:readDate(jContext, "adjustmentDate", self:dAdjustmentDate)
	self:lRunRetroactive := self:readLogical(jContext, "runRetroactive", self:lRunRetroactive)
	self:lApproveAfterAdjustment := self:readLogical(jContext, "approveAfterAdjustment", self:lApproveAfterAdjustment)
	self:cExecutionId := self:readCharacter(jContext, "executionId", self:cExecutionId)
	self:cWorkerId := self:readCharacter(jContext, "workerId", self:cWorkerId)
	self:cAdjustmentNumber := self:readCharacter(jContext, "adjustmentNumber", self:cAdjustmentNumber)
	self:cJustification := self:readCharacter(jContext, "justification", self:cJustification)
return self

/*/{Protheus.doc} toJson
	@description Serializa o contexto atual para um objeto JSON de transporte.
	@author guilherme.sordi@totvs.com.br
	@since 11/05/2026
	@version 12.1.2510
/*/
method toJson() as character class ContractAdjustmentContext
	local jContext := JsonObject():New() as json

	jContext["branch"] := self:cBranch
	jContext["contract"] := self:cContract
	jContext["revision"] := self:cRevision
	jContext["contractSpecies"] := self:cContractSpecies
	jContext["contractType"] := self:cContractType
	jContext["adjustmentRevisionTypeCode"] := self:cAdjustmentRevisionTypeCode
	jContext["referenceDate"] := self:dReferenceDate
	jContext["adjustmentDate"] := self:dAdjustmentDate
	jContext["runRetroactive"] := self:lRunRetroactive
	jContext["approveAfterAdjustment"] := self:lApproveAfterAdjustment
	jContext["executionId"] := self:cExecutionId
	jContext["workerId"] := self:cWorkerId
	jContext["adjustmentNumber"] := self:cAdjustmentNumber
	jContext["justification"] := self:cJustification
return jContext:toJson()

/*/{Protheus.doc} isValid
	@description Informa se o contexto contem todos os dados obrigatorios da execucao.
	@author guilherme.sordi@totvs.com.br
	@since 11/05/2026
	@version 12.1.2510
/*/
method isValid() as logical class ContractAdjustmentContext
return Empty(self:validationMessage())

/*/{Protheus.doc} validationMessage
	@description Retorna a mensagem de validacao do primeiro campo obrigatorio ausente.
	@author guilherme.sordi@totvs.com.br
	@since 11/05/2026
	@version 12.1.2510
/*/
method validationMessage() as character class ContractAdjustmentContext
	local cMessage := "" as character

	if Empty(self:cBranch)
		cMessage := "Contract branch was not informed"
	elseif Empty(self:cContract)
		cMessage := "Contract code was not informed"
	// elseif Empty(self:cRevision)
	// 	cMessage := "Contract revision was not informed"
	elseif Empty(self:cContractSpecies)
		cMessage := "Contract species was not informed"
	elseif Empty(self:cAdjustmentRevisionTypeCode)
		cMessage := "Adjustment revision type code was not informed"
	elseif Empty(self:dReferenceDate)
		cMessage := "Reference date was not informed"
	elseif Empty(self:dAdjustmentDate)
		cMessage := "Adjustment date was not informed"
	elseif Empty(self:cExecutionId)
		cMessage := "Execution id was not informed"
	endIf
return cMessage

/*/{Protheus.doc} applyDefaults
	@description Aplica os valores padrao utilizados na construcao do contexto.
	@author guilherme.sordi@totvs.com.br
	@since 11/05/2026
	@version 12.1.2510
/*/
method applyDefaults() as object class ContractAdjustmentContext
	self:cBranch := ""
	self:cContract := ""
	self:cRevision := ""
	self:cContractSpecies := ""
	self:cContractType := ""
	self:cAdjustmentRevisionTypeCode := ""
	self:dReferenceDate := CtoD("")
	self:dAdjustmentDate := CtoD("")
	self:lRunRetroactive := .F.
	self:lApproveAfterAdjustment := .F.
	self:cExecutionId := ""
	self:cWorkerId := ""
	self:cAdjustmentNumber := ""
	self:cJustification := ""
return self

/*/{Protheus.doc} readCharacter
	@description Le um valor caractere do JSON de origem com tratamento de padrao.
	@author guilherme.sordi@totvs.com.br
	@since 11/05/2026
	@version 12.1.2510
/*/
method readCharacter(jSource as json, cProperty as character, cDefault as character) as character class ContractAdjustmentContext
	local cValue := cDefault as character

	if self:hasJsonProperty(jSource, cProperty) .And. jSource[cProperty] != NIL
		cValue := cValToChar(jSource[cProperty])
	endIf
return cValue

/*/{Protheus.doc} readDate
	@description Le um valor data do JSON de origem aceitando data nativa ou texto.
	@author guilherme.sordi@totvs.com.br
	@since 11/05/2026
	@version 12.1.2510
/*/
method readDate(jSource as json, cProperty as character, dDefault as date) as date class ContractAdjustmentContext
	local dValue := dDefault as date
	local xValue as variant

	if self:hasJsonProperty(jSource, cProperty) .And. jSource[cProperty] != NIL
		xValue := jSource[cProperty]

		if ValType(xValue) == "D"
			dValue := xValue
		elseif ValType(xValue) == "C"
			dValue := self:dateFromCharacter(xValue, dDefault)
		endIf
	endIf
return dValue

/*/{Protheus.doc} readLogical
	@description Le um valor logico do JSON de origem com conversao de formatos usuais.
	@author guilherme.sordi@totvs.com.br
	@since 11/05/2026
	@version 12.1.2510
/*/
method readLogical(jSource as json, cProperty as character, lDefault as logical) as logical class ContractAdjustmentContext
	local lValue := lDefault as logical
	local cValue := "" as character
	local xValue as variant

	if self:hasJsonProperty(jSource, cProperty) .And. jSource[cProperty] != NIL
		xValue := jSource[cProperty]

		if ValType(xValue) == "L"
			lValue := xValue
		elseif ValType(xValue) == "N"
			lValue := (xValue != 0)
		elseif ValType(xValue) == "C"
			cValue := Upper(AllTrim(xValue))
			lValue := (cValue == "1" .Or. cValue == "T" .Or. cValue == ".T." .Or. cValue == "TRUE")
		endIf
	endIf
return lValue

/*/{Protheus.doc} hasJsonProperty
	@description Verifica se a propriedade existe no JSON informado.
	@author guilherme.sordi@totvs.com.br
	@since 11/05/2026
	@version 12.1.2510
/*/
method hasJsonProperty(jSource as json, cProperty as character) as logical class ContractAdjustmentContext
	local lHasProperty := .F. as logical

	if jSource != NIL
		lHasProperty := jSource:hasProperty(cProperty)
	endIf
return lHasProperty

/*/{Protheus.doc} dateFromCharacter
	@description Converte texto de data para o tipo date respeitando um valor padrao.
	@author guilherme.sordi@totvs.com.br
	@since 11/05/2026
	@version 12.1.2510
/*/
method dateFromCharacter(cValue as character, dDefault as date) as date class ContractAdjustmentContext
	local cDate := AllTrim(cValue) as character
	local dDate := dDefault as date

	if Len(cDate) == 8 .And. Val(cDate) > 0
		dDate := StoD(cDate)
	elseif !Empty(cDate)
		dDate := CtoD(cDate)
	endIf
return dDate
