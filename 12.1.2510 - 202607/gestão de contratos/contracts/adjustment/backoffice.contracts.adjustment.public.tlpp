#include "totvs.ch"
#include "tlpp-core.th"

using namespace totvs.protheus.backoffice.contracts.adjustment

//--------------------------------------------------------------------
/*/{Protheus.doc} cnta311ThreadJob()
    Wrapper público para execução do reajuste automático em uma thread de job.

    @author guilherme.sordi@totvs.com.br
    @since  20/05/2026
    @version 12.1.2510
    @return logical resultado do lote da thread
*/
//--------------------------------------------------------------------
function CNTA311JOB(cCompany as character, cBranch as character, nId as numeric, cAdjustment as character, cFromContract as character, cToContract as character)
	local oOrchestrator := ContractAdjustmentOrchestrator():New() as object

    rpcSetType(3)
    rpcSetEnv(cCompany, cBranch,,,"GCT")
	
    oOrchestrator:processThreadBatch(nId, cAdjustment, cFromContract, cToContract)
    
    rpcClearEnv()
	fwFreeObj(oOrchestrator)
return
