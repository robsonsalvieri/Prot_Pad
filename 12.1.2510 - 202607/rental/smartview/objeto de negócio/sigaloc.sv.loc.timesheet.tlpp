#include "msobject.ch"
#include "TOTVS.ch"
#include "totvs.framework.treports.integratedprovider.th"

/*/{PROTHEUS.DOC} sigaloc.sv.loc.timesheet.tlpp
ITUP BUSINESS - TOTVS RENTAL
Relatório de Disponibilidade por status
@AUTHOR LEONARDO PACHECO FUGA
@SINCE 21/11/2025
