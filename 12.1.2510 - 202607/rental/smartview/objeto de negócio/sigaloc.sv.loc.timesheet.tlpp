namespace totvs.protheus.rental.manutencao.integratedprovider

@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGALOC", tables="FPQ,SX5,FPU,CTT,SRA", name="Rental", country="ALL", initialRelease="12.1.2210")
class timesheet from totvs.framework.treports.integratedprovider.integratedprovider
public method new() as object
public method getData() as object
public method getSchema() as object 
endclass

/*/{PROTHEUS.DOC} Timesheet
ITUP BUSINESS - TOTVS RENTAL
Declaração das classes
@AUTHOR LEONARDO PACHECO FUGA
@SINCE 21/11/2025
/*/

method new() class timesheet
	_Super:new()
	//Define a Área
	self:appendArea("Rental")

	//Define o nome do Objeto de Negócio
	self:setDisplayName("Relatorio de Timesheet")

	//Define a descrição do Objeto de Negócio
	self:setDescription("Relatorio de Timesheet")
return self

/*/{PROTHEUS.DOC} getData
ITUP BUSINESS - TOTVS RENTAL
Processamento do relatório
@AUTHOR LEONARDO PACHECO FUGA
@SINCE 21/11/2025
/*/

method getData(nPage as numeric, oFilter as object) as object class timesheet
local cQuery as character
Local aBind       := {}

	//Define a quantidade máxima por página (Default 100)
	self:setPageSize(20)

	jParams := oFilter:getParameters() //metodo para retorno do json dos parâmetros

	If type("jParams['01'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['01'][1] := space(TamSx3("FPQ_PROJET")[1])
	EndIf
	If empty(jParams['01'][1])
		jParams['01'][1] := space(TamSx3("FPQ_PROJET")[1])
	EndIf

	If type("jParams['02'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['02'][1] := space(TamSx3("FPQ_PROJET")[1])
	EndIf
	If empty(jParams['02'][1])
		jParams['02'][1] := space(TamSx3("FPQ_PROJET")[1])
	EndIf

	If type("jParams['03'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['03'][1] := space(TamSx3("FPQ_OBRA")[1])
	EndIf
	If empty(jParams['03'][1])
		jParams['03'][1] := space(TamSx3("FPQ_OBRA")[1])
	EndIf

	If type("jParams['04'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['04'][1] := space(TamSx3("FPQ_OBRA")[1])
	EndIf
	If empty(jParams['04'][1])
		jParams['04'][1] := space(TamSx3("FPQ_OBRA")[1])
	EndIf

	If type("jParams['05'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['05'][1] := space(TamSx3("RA_MAT")[1])
	EndIf
	If empty(jParams['05'][1])
		jParams['05'][1] := space(TamSx3("RA_MAT")[1])
	EndIf

	If type("jParams['06'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['06'][1] := space(TamSx3("RA_MAT")[1])
	EndIf
	If empty(jParams['06'][1])
		jParams['06'][1] := space(TamSx3("RA_MAT")[1])
	EndIf

	jParams['07'][1] := StrTran(SubStr(jParams["07"][1],1,10),"-","") // "20000101"
	If empty(jParams['07'][1])
		jParams['07'][1] := space(8)
	EndIf

	jParams['08'][1] := StrTran(SubStr(jParams["08"][1],1,10),"-","") // "20000101"
	If empty(jParams['08'][1])
		jParams['08'][1] := space(8)
	EndIf

//------------------------------------------------------------------------------------------------------
	cQuery := " SELECT "
	cQuery += " COALESCE(SRA.RA_CC, 'SEM CENTRO DE CUSTO') RA_CC, "
	cQuery += " COALESCE(CTT.CTT_DESC01,'SEM CENTRO DE CUSTO') CTT_DESC01, "
	cQuery += " SRA.RA_MAT, SRA.RA_NOME, FPQ.FPQ_MAT, FPQ.FPQ_DATA, "
	cQuery += " CASE "
	cQuery += " WHEN FPQ.FPQ_AGENDA = '1' THEN 'PREVISTO' "
	cQuery += " WHEN FPQ.FPQ_AGENDA = '2' THEN 'EFETIVO' "
	cQuery += " ELSE ' ' "
	cQuery += " END FPQ_AGENDA, "
	cQuery += " FPQ.FPQ_STATUS, "
	cQuery += " SX5.X5_DESCRI, "
	cQuery += " CASE "
	cQuery += " WHEN FPQ.FPQ_VT = 'S' THEN 'SIM' "
	cQuery += " WHEN FPQ.FPQ_VT = 'N' THEN 'NAO' "
	cQuery += " ELSE ' ' "
	cQuery += " END FPQ_VT, "
	cQuery += " FPQ.FPQ_AS, FPQ.FPQ_PROJET, FPQ.FPQ_OBRA, FPQ.FPQ_SERVIC, FPQ.FPQ_DESC, FPQ.FPQ_HORAS, FPQ.FPQ_OBS, FPQ.FPQ_HRINI, " 
	cQuery += " FPQ.FPQ_HRFIN, FPQ.FPQ_FILMAT, "
	cQuery += " CASE "
	cQuery += " WHEN FPQ.FPQ_TIPINC = 'M' THEN 'MANUAL' "
	cQuery += " WHEN FPQ.FPQ_TIPINC = 'A' THEN 'AUTOMATICO' "
	cQuery += " ELSE ' ' "
	cQuery += " END FPQ_TIPINC, "
	cQuery += " FPQ.FPQ_CONTRO, FPQ.FPQ_CRACHA, FPQ.FPQ_FUNCAO, FPQ.FPQ_XHINIR, FPQ.FPQ_XHFIMR, "
	cQuery += " COALESCE(FPU.FPU_DTINI, ' ') FPU_DTINI, "
	cQuery += " COALESCE(FPU.FPU_DTFIN, ' ') FPU_DTFIN "

	cQuery += " FROM "+RetSqlName("FPQ")+" FPQ "

	cQuery += " INNER JOIN "+RetSqlName("SRA")+" SRA ON "
	cQuery += " SRA.RA_FILIAL = '"+xFilial("SRA")+ "' AND "
	cQuery += " SRA.RA_MAT = FPQ.FPQ_MAT AND "
	cQuery += " SRA.RA_MAT >= ? AND "
	AAdd(aBind, {jParams['05'][1], "S"})
	cQuery += " SRA.RA_MAT <= ? AND "
	AAdd(aBind, {jParams['06'][1], "S"})
	cQuery += " SRA.D_E_L_E_T_ = ' ' "

	cQuery += " LEFT JOIN "+RetSqlName("CTT")+" CTT ON "
	cQuery += " CTT.CTT_FILIAL = '"+xFilial("CTT")+ "' AND "
	cQuery += " CTT.CTT_CUSTO = SRA.RA_CC AND "
	cQuery += " CTT.D_E_L_E_T_ = ' ' "

	cQuery += " LEFT JOIN "+RetSqlName("SX5")+" SX5 ON "
	cQuery += " SX5.X5_FILIAL = '"+xFilial("SX5")+ "' AND "
	cQuery += " SX5.X5_TABELA = 'QV' AND "
	cQuery += " SX5.X5_CHAVE = FPQ.FPQ_STATUS AND "
	cQuery += " SX5.D_E_L_E_T_ = ' ' "

	cQuery += " LEFT JOIN "+RetSqlName("FPU")+" FPU ON "
	cQuery += " FPU.FPU_FILIAL = '"+xFilial("FPU")+ "' AND "
	cQuery += " FPU.FPU_MAT = FPQ.FPQ_MAT AND "
	cQuery += " FPU.FPU_DTINI <= FPQ.FPQ_DATA AND "
	cQuery += " FPU.FPU_DTFIN >= FPQ.FPQ_DATA AND "
	cQuery += " FPU.D_E_L_E_T_ = ' ' "
	cQuery += " WHERE
	cQuery += " FPQ.FPQ_PROJET >= ? AND "
	AAdd(aBind, {jParams['01'][1], "S"})
	cQuery += " FPQ.FPQ_PROJET <= ? AND "
	AAdd(aBind, {jParams['02'][1], "S"})
	cQuery += " FPQ.FPQ_OBRA >= ? AND "
	AAdd(aBind, {jParams['03'][1], "S"})
	cQuery += " FPQ.FPQ_OBRA <= ? AND "
	AAdd(aBind, {jParams['04'][1], "S"})
	cQuery += " FPQ.FPQ_DATA >= ? AND "
	AAdd(aBind, {jParams['07'][1], "S"})
	cQuery += " FPQ.FPQ_DATA <= ? AND "
	AAdd(aBind, {jParams['08'][1], "S"})
	
	

	cQuery += " FPQ.D_E_L_E_T_ = ' ' "		  
	cQuery := CHANGEQUERY(cQuery)
	cQuery := JurTRepBin(cQuery, aBind)
	self:setOrder("FPQ.FPQ_PROJET, FPQ.FPQ_DATA")
	self:setQuery(cQuery)

return self:oData

/*/{PROTHEUS.DOC} getShema
ITUP BUSINESS - TOTVS RENTAL
Declaração dos parâmetros
@AUTHOR LEONARDO PACHECO FUGA
@SINCE 21/11/2025
/*/

method getSchema() as object class timesheet
 
	self:addProperty("FilMatricul", "Fil Matricul",        "string", "Fil Matricul",        "FPQ_FILMAT")
	self:addProperty("Matricula",   "Matricula",           "string", "Matricula",           "RA_MAT")
	self:addProperty("NomeFunc",    "Nome do funcionario", "string", "Nome do funcionario", "RA_NOME")
	self:addProperty("CCusto",      "C. Custo",            "string", "C. Custo",            "RA_CC")
	self:addProperty("DescCCusto",  "Desc. C. Custo",      "string", "Desc. C. Custo",      "CTT_DESC01")
	self:addProperty("DtLocacao",   "Data Locacao",        "date",   "Data Locacao",        "FPQ_DATA")
	self:addProperty("Agendamento", "Agendamento",         "string", "Agendamento",         "FPQ_AGENDA")
	self:addProperty("Status",      "Status",              "string", "Status",              "FPQ_STATUS")
	self:addProperty("DescStatus",  "Desc. Status",        "string", "Desc. Status",        "X5_DESCRI")
	self:addProperty("VT",          "VT",                  "string", "VT",                  "FPQ_VT")
	self:addProperty("NrAS",        "Nr. A.S.",            "string", "Nr. A.S.",            "FPQ_AS")
	self:addProperty("Projeto",     "Projeto",             "string", "Projeto",             "FPQ_PROJET")
	self:addProperty("Obra",        "Obra",                "string", "Obra",                "FPQ_OBRA")
	self:addProperty("Servico",     "Servico",             "string", "Servico",             "FPQ_SERVIC")
	self:addProperty("NomeCliente", "Nome Cliente",        "string", "Nome Cliente",        "FPQ_DESC")
	self:addProperty("Horas",       "Horas",               "number", "Horas",               "FPQ_HORAS")
	self:addProperty("Observacao",  "Observacao",          "string", "Observacao",          "FPQ_OBS")
	self:addProperty("HoraIni",     "Hora Inicial",        "string", "Hora Inicial",        "FPQ_HRINI")
	self:addProperty("HoraFinal",   "Hora Final",          "string", "Hora Final",          "FPQ_HRFIN")
	self:addProperty("TpInclusao",  "Tp. Inclusao",        "string", "Tp. Inclusao",        "FPQ_TIPINC")
	self:addProperty("Controle",    "Controle",            "string", "Controle",            "FPQ_CONTRO")
	self:addProperty("CrachaAtivo", "Cracha Ativo",        "string", "Cracha Ativo",        "FPQ_CRACHA")
	self:addProperty("Funcao",      "Funcao",              "string", "Funcao",              "FPQ_FUNCAO")
	self:addProperty("Horainicial", "Hora inicial",        "string", "Hora inicial",        "FPQ_XHINIR")
	self:addProperty("Hrfinal",     "Hora final",          "string", "Hora final",          "FPQ_XHFIMR")
	self:addProperty("DtIntegraIni","Dt. Integracao Ini.", "date",   "Dt. Integracao Ini.", "FPU_DTINI")
	self:addProperty("DtIntegraFim","Dt. Integracao Fim.", "date",   "Dt. Integracao Fim.", "FPU_DTFIN")

	self:addParameter("01", "Projeto de",         "string", .F., "", .F., .T., "FP0", "MV_PAR01")
	self:addParameter("02", "Projeto até",        "string", .F., "", .F., .T., "FP0", "MV_PAR02")
	self:addParameter("03", "Obra de",            "string", .F., "", .F., .F., ""   , "MV_PAR03")
	self:addParameter("04", "Obra até",           "string", .F., "", .F., .F., ""   , "MV_PAR04")
	self:addParameter("05", "Matricula de",       "string", .F., "", .F., .T., "SRA", "MV_PAR05")
	self:addParameter("06", "Matricula até",      "string", .F., "", .F., .T., "SRA", "MV_PAR06")
	self:addParameter("07", "Data de",            "date"  , .F., "", .F., .F., ""   , "MV_PAR07")
	self:addParameter("08", "Data até",           "date"  , .F., "", .F., .F., ""   , "MV_PAR08")

return self:oSchema
