namespace totvs.protheus.rental.manutencao.integratedprovider

@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGALOC", tables="FP0,FPF,ST9", name="Rental", country="ALL", initialRelease="12.1.2210")
class minutasrental from totvs.framework.treports.integratedprovider.integratedprovider
public method new() as object
public method getData() as object
public method getSchema() as object 
endclass

/*/{PROTHEUS.DOC} Minutas
ITUP BUSINESS - TOTVS RENTAL
Declaração das classes
@AUTHOR LEONARDO PACHECO FUGA
@SINCE 31/10/2025
/*/

method new() class minutasrental
	_Super:new()
	//Define a Área
	self:appendArea("Rental")

	//Define o nome do Objeto de Negócio
	self:setDisplayName("Minutas RENTAL")

	//Define a descrição do Objeto de Negócio
	self:setDescription("Minutas RENTAL")
return self

/*/{PROTHEUS.DOC} getData
ITUP BUSINESS - TOTVS RENTAL
Processamento do relatório
@AUTHOR LEONARDO PACHECO FUGA
@SINCE 31/10/2025
/*/

method getData(nPage as numeric, oFilter as object) as object class minutasrental
local cQuery as character
Local aBind       := {}

	//Define a quantidade máxima por página (Default 100)
	self:setPageSize(20)

	jParams := oFilter:getParameters() //metodo para retorno do json dos parâmetros

	If type("jParams['01'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['01'][1] := space(TamSx3("FP0_CLI")[1])
	EndIf
	If empty(jParams['01'][1])
		jParams['01'][1] := space(TamSx3("FP0_CLI")[1])
	EndIf

	If type("jParams['02'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['02'][1] := space(TamSx3("FP0_CLI")[1])
	EndIf
	If empty(jParams['02'][1])
		jParams['02'][1] := space(TamSx3("FP0_CLI")[1])
	EndIf

	If type("jParams['03'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['03'][1] := space(TamSx3("FP0_LOJA")[1])
	EndIf
	If empty(jParams['03'][1])
		jParams['03'][1] := space(TamSx3("FP0_LOJA")[1])
	EndIf

	If type("jParams['04'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['04'][1] := space(TamSx3("FP0_LOJA")[1])
	EndIf
	If empty(jParams['04'][1])
		jParams['04'][1] := space(TamSx3("FP0_LOJA")[1])
	EndIf

	If type("jParams['05'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['05'][1] := space(TamSx3("T9_CODBEM")[1])
	EndIf
	If empty(jParams['05'][1])
		jParams['05'][1] := space(TamSx3("T9_CODBEM")[1])
	EndIf

	If type("jParams['06'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['06'][1] := space(TamSx3("T9_CODBEM")[1])
	EndIf
	If empty(jParams['06'][1])
		jParams['06'][1] := space(TamSx3("T9_CODBEM")[1])
	EndIf

	If type("jParams['07'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['07'][1] := space(TamSx3("FPF_PROJET")[1])
	EndIf
	If empty(jParams['07'][1])
		jParams['07'][1] := space(TamSx3("FPF_PROJET")[1])
	EndIf

	If type("jParams['08'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['08'][1] := space(TamSx3("FPF_PROJET")[1])
	EndIf
	If empty(jParams['08'][1])
		jParams['08'][1] := space(TamSx3("FPF_PROJET")[1])
	EndIf

	If type("jParams['09'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['09'][1] := space(TamSx3("FPF_OBRA")[1])
	EndIf
	If empty(jParams['09'][1])
		jParams['09'][1] := space(TamSx3("FPF_OBRA")[1])
	EndIf

	If type("jParams['10'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['10'][1] := space(TamSx3("FPF_OBRA")[1])
	EndIf
	If empty(jParams['10'][1])
		jParams['10'][1] := space(TamSx3("FPF_OBRA")[1])
	EndIf

	If type("jParams['11'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['11'][1] := space(TamSx3("FPF_AS")[1])
	EndIf
	If empty(jParams['11'][1])
		jParams['11'][1] := space(TamSx3("FPF_AS")[1])
	EndIf

	If type("jParams['12'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['12'][1] := space(TamSx3("FPA_GRUA")[1])
	EndIf
	If empty(jParams['12'][1])
		jParams['12'][1] := space(TamSx3("FPA_GRUA")[1])
	EndIf

	jParams['13'][1] := StrTran(SubStr(jParams["13"][1],1,10),"-","") // "20000101"
	If empty(jParams['13'][1])
		jParams['13'][1] := space(8)
	EndIf

	jParams['14'][1] := StrTran(SubStr(jParams["14"][1],1,10),"-","") // "20000101"
	If empty(jParams['14'][1])
		jParams['14'][1] := space(8)
	EndIf

	If type("jParams['15'][1]") <> "C" .or. file("\SYSTEM\LOCSV014.TXT")
		jParams['15'][1] := space(TamSx3("FPF_STATUS")[1])
	EndIf
	If empty(jParams['15'][1])
		jParams['15'][1] := "1"
	EndIf

//inicio da query
	cQuery := "SELECT "
	cQuery += " FP0.FP0_CLI, FP0.FP0_LOJA, FP0.FP0_CLINOM, "
	cQuery += " FPF.FPF_COD, FPF.FPF_DESC, "
	cQuery += " COALESCE(ST9.T9_CODBEM, ' ') T9_CODBEM,"
	cQuery += " COALESCE(ST9.T9_NOME, ' ') T9_NOME, "
	cQuery += " FPF.FPF_AS, FPF.FPF_DATA, FPF.FPF_MINUTA, FPF.FPF_PROJET, FPF.FPF_OBRA, FPF.FPF_MINUTM, FPF.FPF_NROMED, FPF.FPF_HORAI, "
	cQuery += " FPF.FPF_HORAF, FPF.FPF_HRPARA, FPF.FPF_MOTIVO, FPF.FPF_MOTCAN, "
	cQuery += " CASE "
	cQuery += " WHEN FPF.FPF_STATUS = '1' THEN 'PREVISTA' "
	cQuery += " WHEN FPF.FPF_STATUS = '2' THEN 'CONFIRMADA' "
	cQuery += " WHEN FPF.FPF_STATUS = '3' THEN 'BAIXADA' "
	cQuery += " WHEN FPF.FPF_STATUS = '4' THEN 'ENCERRADA' "
	cQuery += " WHEN FPF.FPF_STATUS = '5' THEN 'CANCELADA' "
	cQuery += " WHEN FPF.FPF_STATUS = '6' THEN 'MEDIDA' "
	cQuery += " ELSE ' ' "
	cQuery += " END FPF_STATUS, "
	cQuery += " CASE "
	cQuery += " WHEN FPF.FPF_TIPOSE = 'T' THEN 'TRANSPORTE' "
	cQuery += " WHEN FPF.FPF_TIPOSE = 'L' THEN 'LOCACAO' "
	cQuery += " WHEN FPF.FPF_TIPOSE = 'M' THEN 'MAO DE OBRA' "
	cQuery += " WHEN FPF.FPF_TIPOSE = 'O' THEN 'OUTROS' "
	cQuery += " WHEN FPF.FPF_TIPOSE = 'E' THEN 'EQUIPAMENTO' "
	cQuery += " ELSE '' "
	cQuery += " END FPF_TIPOSE, "
	cQuery += " FPF.FPF_BXJANI, FPF.FPF_BXJANF, FPF.FPF_BXALMI, FPF.FPF_BXALMF, FPF.FPF_HREALI, FPF.FPF_HREALF, "
	cQuery += " FPF.FPF_EMISSA, FPF.FPF_DTOCOR, FPF.FPF_HTB, FPF.FPF_HTR, FPF.FPF_MINDIA, FPF.FPF_TURNO, FPF.FPF_FILTRO, FPF.FPF_MEDSEQ "
	cQuery += " FROM "+RetSqlName("FPF")+" FPF "
	cQuery += " INNER JOIN " + RetSQLName("FP0") + " FP0 ON "
	cQuery += " FP0.FP0_FILIAL = '"+xFilial("FP0")+ "' AND "
	cQuery += " FP0.FP0_PROJET = FPF.FPF_PROJET AND "
	cQuery += " FP0.FP0_CLI >= ? AND "
	AAdd(aBind, {jParams['01'][1], "S"})
	cQuery += " FP0.FP0_CLI <= ? AND "
	AAdd(aBind, {jParams['02'][1], "S"})
	cQuery += " FP0.FP0_LOJA >= ? AND "
	AAdd(aBind, {jParams['03'][1], "S"})
	cQuery += " FP0.FP0_LOJA <= ? AND "
	AAdd(aBind, {jParams['04'][1], "S"})
	cQuery += " FP0.D_E_L_E_T_ = ' ' "

	cQuery += " LEFT JOIN "+RetSQLName("ST9")+" ST9 ON "
	cQuery += " ST9.T9_FILIAL = '"+xFilial("ST9")+ "' AND "
	cQuery += " ST9.T9_CODBEM = FPF_FROTA AND "
	cQuery += " ST9.T9_CODBEM >= ? AND "
	AAdd(aBind, {jParams['05'][1], "S"})
	cQuery += " ST9.T9_CODBEM <= ? AND "
	AAdd(aBind, {jParams['06'][1], "S"})
	cQuery += " ST9.D_E_L_E_T_ = ' ' "

	cQuery += " WHERE FPF.FPF_PROJET <> ' ' AND "
	cQuery += " FPF.FPF_PROJET >= ? AND "
	AAdd(aBind, {jParams['01'][1], "S"})
	cQuery += " FPF.FPF_PROJET <= ? AND "
	AAdd(aBind, {jParams['02'][1], "S"})
	cQuery += " FPF.FPF_OBRA >= ? AND "
	AAdd(aBind, {jParams['09'][1], "S"})
	cQuery += " FPF.FPF_OBRA <= ? AND "
	AAdd(aBind, {jParams['10'][1], "S"})
	cQuery += " FPF.FPF_AS >= ? AND "
	AAdd(aBind, {jParams['11'][1], "S"})
	cQuery += " FPF.FPF_AS <= ? AND "
	AAdd(aBind, {jParams['12'][1], "S"})
	cQuery += " FPF.FPF_DATA >= ? AND "
	AAdd(aBind, {jParams['13'][1], "S"})
	cQuery += " FPF.FPF_DATA <= ? AND "
	AAdd(aBind, {jParams['14'][1], "S"})

	Do Case
		Case jParams['15'][1] == "1"
			cQuery += " FPF.FPF_STATUS = 1 AND "
		Case jParams['15'][1] == "2"
			cQuery += " FPF.FPF_STATUS = 2 AND "
		Case jParams['15'][1] == "3"
			cQuery += " FPF.FPF_STATUS = 3 AND "
		Case jParams['15'][1] == "4"
			cQuery += " FPF.FPF_STATUS = 4 AND "
		Case jParams['15'][1] == "5"
			cQuery += " FPF.FPF_STATUS = 5 AND "
		Case jParams['15'][1] == "6"
			cQuery += " FPF.FPF_STATUS = 6 AND "
		Case jParams['15'][1] == "7"
			cQuery += " FPF.FPF_STATUS <> '' AND "
	EndCase
	
	cQuery += " FPF.D_E_L_E_T_ = ' ' "
	
	cQuery := CHANGEQUERY(cQuery)
	cQuery := JurTRepBin(cQuery, aBind)
	self:setOrder("FPF.FPF_PROJET")
	self:setQuery(cQuery)
	

return self:oData

/*/{PROTHEUS.DOC} getShema
ITUP BUSINESS - TOTVS RENTAL
Declaração dos parâmetros
