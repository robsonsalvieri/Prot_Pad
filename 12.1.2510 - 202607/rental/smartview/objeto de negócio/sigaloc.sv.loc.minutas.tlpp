method getSchema() as object class minutasrental
 
	self:addProperty("Cliente",         "Cliente",           "string", "Cliente",           "FP0_CLI")
	self:addProperty("NomeCliente",     "Nome Cliente",      "string", "Nome Cliente",      "FP0_CLINOM")
	self:addProperty("Loja",            "Loja",              "string", "Loja",              "FP0_LOJA")
	self:addProperty("Codigo",          "Codigo",            "string", "Codigo",            "FPF_COD")
	self:addProperty("Descricao",       "Descricao",         "string", "Descricao",         "FPF_DESC")
	self:addProperty("Equipamento",     "Equipamento",       "string", "Equipamento",       "T9_CODBEM")
	self:addProperty("DescEquipamento", "Desc. Equipamento", "string", "Desc. Equipamento", "T9_NOME")
	self:addProperty("DtMinuta",        "Dt. Minuta",        "date",   "Dt. Minuta",        "FPF_DATA")
	self:addProperty("NrMinuta",        "Nr. Minuta",        "string", "Nr. Minuta",        "FPF_MINUTA")
	self:addProperty("Projeto",         "Projeto",           "string", "Projeto",           "FPF_PROJET ")
	self:addProperty("Obra",            "Obra",              "string", "Obra",              "FPF_OBRA")
	self:addProperty("NrAS",            "Nr. A.S.",          "string", "Nr. A.S.",          "FPF_AS")
	self:addProperty("MinutaManual",    "Minuta Manual",     "string", "Minuta Manual",     "FPF_MINUTM")
	self:addProperty("NroMedicao ",     "Nro. Medicao ",     "string", "Nro. Medicao ",     "FPF_NROMED")
	self:addProperty("HoraInicial",     "Hora Inicial",      "string", "Hora Inicial",      "FPF_HORAI")
	self:addProperty("HoraFinal",       "Hora Final",        "string", "Hora Final",        "FPF_HORAF")
	self:addProperty("HoraParada",      "Hora Parada",       "string", "Hora Parada",       "FPF_HRPARA")
	self:addProperty("MotParada",       "Mot. Parada",       "string", "Mot. Parada",       "FPF_MOTIVO")
	self:addProperty("MotivoCanc",      "Motivo Canc.",      "string", "Motivo Canc.",      "FPF_MOTCAN")
	self:addProperty("Status",          "Status",            "string", "Status",            "FPF_STATUS")
	self:addProperty("TipoBem",         "Tipo Bem",          "string", "Tipo Bem",          "FPF_TIPOSE")
	self:addProperty("JantarIni",       "Jantar Ini",        "string", "Jantar Ini",        "FPF_BXJANI")
	self:addProperty("JantarFim",       "Jantar Fim",        "string", "Jantar Fim",        "FPF_BXJANF")
	self:addProperty("AlmocoIni",       "Almoco Ini",        "string", "Almoco Ini",        "FPF_BXALMI")
	self:addProperty("AlmocoFim",       "Almoco Fim",        "string", "Almoco Fim",        "FPF_BXALMF")
	self:addProperty("RealIni",         "Real Ini",          "string", "Real Ini",          "FPF_HREALI")
	self:addProperty("RealFim",         "Real Fim",          "string", "Real Fim",          "FPF_HREALF")
	self:addProperty("Emissao",         "Emissao",           "date",   "Emissao",           "FPF_EMISSA")
	self:addProperty("DtOcorrenci",     "Dt Ocorrencia",     "date",   "Dt Ocorrencia",     "FPF_DTOCOR")
	self:addProperty("HTotBaixad",      "H.Tot.Baixad",      "string", "H.Tot.Baixad",      "FPF_HTB")
	self:addProperty("HTotRealiz",      "H.Tot.Realiz",      "string", "H.Tot.Realiz",      "FPF_HTR")
	self:addProperty("MinDia",          "Min.Dia",           "number", "Min.Dia",           "FPF_MINDIA")
	self:addProperty("Turno",           "Turno",             "string", "Turno",             "FPF_TURNO")
	self:addProperty("Filtro",          "Filtro",            "string", "Filtro",            "FPF_FILTRO")
	self:addProperty("SeqMedicao",      "Seq.Medicao",       "string", "Seq.Medicao",       "FPF_MEDSEQ")

	self:addParameter("01", "Cliente de",          "string", .F., "", .F., .T., "SA1", "MV_PAR01")
	self:addParameter("02", "Cliente até",         "string", .F., "", .F., .T., "SA1", "MV_PAR02")
	self:addParameter("03", "Loja de",             "string", .F., "", .F., .F., "",    "MV_PAR03")
	self:addParameter("04", "Loja até",            "string", .F., "", .F., .F., "",    "MV_PAR04")
	self:addParameter("05", "Equipamento de",      "string", .F., "", .F., .T., "ST9", "MV_PAR05")
	self:addParameter("06", "Equipamento até",     "string", .F., "", .F., .T., "ST9", "MV_PAR06")
	self:addParameter("07", "Projeto de",          "string", .F., "", .F., .T., "FP0", "MV_PAR07")
	self:addParameter("08", "Projeto até",         "string", .F., "", .F., .T., "FP0", "MV_PAR08")
	self:addParameter("09", "Obra de",             "string", .F., "", .F., .F., "",    "MV_PAR09")
	self:addParameter("10", "Obra até",            "string", .F., "", .F., .F., "",    "MV_PAR10")
	self:addParameter("11", "Nr AS de",            "string", .F., "", .F., .F., "",    "MV_PAR11")
	self:addParameter("12", "Nr AS até",           "string", .F., "", .F., .F., "",    "MV_PAR12")
	self:addParameter("13", "Dt Minuta de",        "date",   .F., "", .F., .F., "",    "MV_PAR13")
	self:addParameter("14", "Dt Minuta até",       "date",   .F., "", .F., .F., "",    "MV_PAR14")
	self:addParameter("15", "Status da Minuta",    "string", .F., "", .F., .F., "",    "MV_PAR15", "1=Prevista, 2=Confirmada, 3=Baixada, 4=Encerrada, 5=Cancelada, 6=Medida, 7=Todos", .F., {"7"})

return self:oSchema
