//16.04.2026 Alteracao para ADVPR de design do relatorio

method new() class imprimemedicao

	_Super:new()

	self:appendArea("Rental")

	self:setDisplayName("Impressao da Medicao")

	self:setDescription("Impressao da Medicao")
return self

/*/{PROTHEUS.DOC} getData
ITUP BUSINESS - TOTVS RENTAL
Processamento do relatório
@AUTHOR LEONARDO PACHECO FUGA
@SINCE 23/06/2025
/*/

method getData(nPage as numeric, oFilter as object) as object class imprimemedicao
Local cQuery as character
Local aBind := {}

	self:setPageSize(20)

	jParams := oFilter:getParameters() //metodo para retorno do json dos parâmetros

	If type("jParams['01'][1]") <> "C" .or. file("\SYSTEM\LOCSV009.TXT")
		jParams['01'][1] := space(TamSx3("FQK_COD")[1])
	EndIf
	If empty(jParams['01'][1])
		jParams['01'][1] := space(TamSx3("FQK_COD")[1])
	EndIf

	cQuery := " SELECT "
	cQuery += " FQL.FQL_ITEM, FQL.FQL_ORDEM, FQL.FQL_AS, FQL.FQL_DTMEDI, FQL.FQL_DTSAID, FQL.FQL_DTENT, FQL.FQL_MINDIA, FQL.FQL_HRPARA, "
	cQuery += " CASE "
	cQuery += " WHEN FQL.FQL_BASE = 'H' THEN 'HORA' "
	cQuery += " WHEN FQL.FQL_BASE = 'D' THEN 'DIA' "
	cQuery += " WHEN FQL.FQL_BASE = 'C' THEN 'CONTADOR' "
	cQuery += " WHEN FQL.FQL_BASE = 'O' THEN 'OUTROS' "
	cQuery += " ELSE '' "
	cQuery += " END FQL_BASE, "
	cQuery += " FQL.FQL_GRPMD, "
	cQuery += " CASE "
	cQuery += "	WHEN FQL.FQL_BFRANQ = 'D' THEN 'DIARIA' "
	cQuery += "	WHEN FQL.FQL_BFRANQ = 'M' THEN 'MENSAL' "
	cQuery += "	ELSE '' "
	cQuery += " END FQL_BFRANQ, "
	cQuery += " FQL.FQL_FRKM, FQL.FQL_KMINI, FQL.FQL_KMFIM, FQL.FQL_COMPLE, FQL.FQL_QTDKM, FQL.FQL_DUBASE, FQL.FQL_VLRFRA, "
	cQuery += " FQL.FQL_HORTOT, FQL.FQL_VALHOR, FQL.FQL_QTDHR, FQL.FQL_QTDHR2, FQL.FQL_VLTOHR, FQL.FQL_VLRTOT, "
	cQuery += " FQL.FQL_PERD, FQL.FQL_DESC, FQL.FQL_PERA, FQL.FQL_ACRES, FQL.FQL_VLRMOB, FQL.FQL_VLRDES, FQL.FQL_TIPO, "
	cQuery += " FQL.FQL_PERSEG, FQL.FQL_VLBSEG, FQL.FQL_VALSEG, FQL.FQL_TPISS, FQL.FQL_PERISS, FQL.FQL_VALISS, "
	cQuery += " FQL.FQL_PERMO, FQL.FQL_VLTOTM, FQL.FQL_TRSPES, FQL.FQL_ANCORA, FQL.FQL_TELESC, FQL.FQL_MONTAG, "
	cQuery += " FQL.FQL_DESMON, FQL.FQL_ACESSO, FQL.FQL_CCUSTO, FQL.FQL_PERMAQ, FQL.FQL_VLMAQ, FQL.FQL_OBRA, "
	cQuery += " FQL.FQL_TURNO, FQL.FQL_COD, FQL.FQL_XTIPOH, FQL.FQL_PERHAD, "
	cQuery += " CASE "
	cQuery += " WHEN FQL.FQL_TPAS = 'L' THEN 'LOCACAO' "
	cQuery += " WHEN FQL.FQL_TPAS = 'M' THEN 'MAO DE OBRA' "
	cQuery += " ELSE '' "
	cQuery += " END FQL_TPAS, "
	cQuery += " FQL.FQL_TPCONT, FQL.FQL_PROD, FQL.FQL_BEMRES, FQL.FQL_TPMEDI, FQL.FQL_OS, FQL.FQL_MINUTA, FQL.FQL_LIBER, "
	cQuery += " CASE "
	cQuery += " WHEN FQK.FQK_TPMED = 'G' THEN 'GRUPO' "
	cQuery += " WHEN FQK.FQK_TPMED = 'A' THEN 'A.S.' "
	cQuery += " ELSE '' "
	cQuery += " END FQK_TPMED, "
	cQuery += " FQK.FQK_PROJET, FQK.FQK_GRPMD, FQK.FQK_PMEDI, FQK.FQK_COD, FQK.FQK_MEDSEQ, FQK.FQK_DTINIC, FQK.FQK_DTFIM, " 
	cQuery += " FQK.FQK_CLIENT, FQK.FQK_LOJA, SA1.A1_NOME, FQK.FQK_CONDPA, "
	cQuery += " CASE "
	cQuery += " WHEN FQK.FQK_SITUAC = '1' THEN 'DIGITADO' "
	cQuery += " WHEN FQK.FQK_SITUAC = '2' THEN 'CONFIRMADO' "
	cQuery += " WHEN FQK.FQK_SITUAC = '5' THEN 'NAO APROVADO' "
	cQuery += " WHEN FQK.FQK_SITUAC = '6' THEN 'CANCELADO' "
	cQuery += " ELSE '' "
	cQuery += " END FQK_SITUAC, "
	cQuery += " FQK.FQK_NATUR, "
	cQuery += " CASE "
	cQuery += " WHEN FQK.FQK_TIPO = 'N' THEN 'NORMAL' "
	cQuery += " WHEN FQK.FQK_TIPO = 'C' THEN 'COMPLEMENTAR' "
	cQuery += " WHEN FQK.FQK_TIPO = 'F' THEN 'FINAL' "
	cQuery += " ELSE '' "
	cQuery += " END FQK_TIPO, "
	cQuery += " CASE "
	cQuery += " WHEN FQK.FQK_INTCON = 'S' THEN 'SIM' "
	cQuery += " WHEN FQK.FQK_INTCON = 'N' THEN 'NAO' "
	cQuery += " ELSE '' "
	cQuery += " END FQK_INTCON, "
	cQuery += " CASE "
	cQuery += " WHEN FQK.FQK_TPFRAN = 'I' THEN 'INDIVIDUAL' "
	cQuery += " WHEN FQK.FQK_TPFRAN = 'G' THEN 'COMPARTILHADA' "
	cQuery += " ELSE '' "
	cQuery += " END FQK_TPFRAN, "
	cQuery += " FQK.FQK_NUMPV, FQK.FQK_VALTOT, FQK.FQK_VLRTOT, FQK.FQK_VLRACR, FQK.FQK_VLRMOB, FQK.FQK_VALSEG, "
	cQuery += " FQK.FQK_VLAISS, FQK.FQK_VLTOTM, FQK.FQK_VREXTR, SA1.A1_INSCR, SA1.A1_CGC, ST9.T9_NOME, ST9.T9_CODBEM "

	cQuery += " FROM "+RetSqlName("FQK")+" FQK "

	cQuery += " INNER JOIN "+RetSqlName("FQL")+" FQL ON "
	cQuery += " FQL.FQL_FILIAL = '"+xFilial("FQL")+"' AND "
	cQuery += " FQL.FQL_COD = FQK.FQK_COD AND "
	cQuery += " FQL.D_E_L_E_T_ = ' ' "

	cQuery += " LEFT JOIN "+RetSqlName("ST9")+" ST9 ON "
	cQuery += " ST9.T9_FILIAL = '"+xFilial("ST9")+"' AND "
	cQuery += " ST9.T9_CODBEM = FQL.FQL_FROTA AND "
	cQuery += " ST9.D_E_L_E_T_ = ' ' "

	cQuery += " LEFT JOIN "+RetSqlName("SA1")+" SA1 ON "
	cQuery += " SA1.A1_FILIAL = '"+xFilial("SA1")+"' AND "
	cQuery += " SA1.A1_COD = FQK.FQK_CLIENT AND "
	cQuery += " SA1.A1_LOJA = FQK.FQK_LOJA AND "
	cQuery += " SA1.D_E_L_E_T_ = ' ' "

	cQuery += " WHERE FQK.FQK_FILIAL = '"+xFilial("FQK")+"' AND "
	cQuery += " FQK.FQK_PROJET <> ' ' AND "
	cQuery += " FQK.FQK_COD = ? "
	AAdd(aBind, {jParams['01'][1], "S"})
	cQuery += " AND FQK.D_E_L_E_T_ = ' ' "

	cQuery := ChangeQuery(cQuery)
	cQuery := JurTRepBin(cQuery, aBind)
	self:setOrder("FQK.FQK_PROJET")
	self:setQuery(cQuery)

return self:oData

