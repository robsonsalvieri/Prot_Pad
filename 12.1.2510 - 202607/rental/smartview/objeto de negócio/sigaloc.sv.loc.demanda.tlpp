namespace totvs.protheus.rental.manutencao.integratedprovider

@totvsFrameworkTReportsIntegratedProvider(active=.T., team="SIGALOC", tables="FQT,FQ5,SB1,SA1,ST9", name="Rental", country="ALL", initialRelease="12.1.2210")
class demanda from totvs.framework.treports.integratedprovider.integratedprovider

public method new() as object
public method getData() as object
public method getSchema() as object 
public method printDemanda() as logical

endclass

/*/{PROTHEUS.DOC} demanda
ITUP BUSINESS - TOTVS RENTAL
Declaração dos métodos
@AUTHOR LEONARDO PACHECO FUGA
@SINCE 15/05/2026
/*/

method new() class demanda
	_Super:new()

	self:appendArea("Rental")

	self:setDisplayName("gestao demanda")

	self:setDescription("gestao demanda")
return self

/*/{PROTHEUS.DOC} getData
ITUP BUSINESS - TOTVS RENTAL
Processamento do relatório
@AUTHOR LEONARDO PACHECO FUGA
@SINCE 15/05/2026
/*/

method getData(nPage as numeric, oFilter as object) as object class demanda
Local cQuery as character
Local aBind := {}

	self:setPageSize(20)

	jParams := oFilter:getParameters() //metodo para retorno do json dos parâmetros

	If type("jParams['01'][1]") <> "C" .or. file("\SYSTEM\LOCSV030.TXT")
		jParams['01'][1] := space(TamSx3("FQT_DEMAND")[1])
	EndIf
	If empty(jParams['01'][1])
		jParams['01'][1] := space(TamSx3("FQT_DEMAND")[1])
	EndIf

	If type("jParams['02'][1]") <> "C" .or. file("\SYSTEM\LOCSV030.TXT")
		jParams['02'][1] := space(TamSx3("FQ5_STDEMA")[1])
	EndIf
	If empty(jParams['02'][1])
		jParams['02'][1] := space(TamSx3("FQ5_STDEMA")[1])
	EndIf

	cQuery := " SELECT "
	cQuery += " FQT.FQT_FILIAL, FQT.FQT_DEMAND, FQT.FQT_PROJET, FQT.FQT_CLIPRO, FQT.FQT_LOJPRO, SA1.A1_NOME, FQT.FQT_OBRA, "
	cQuery += " SA1.A1_END, SA1.A1_MUN, SA1.A1_CEP, "
	cQuery += " COALESCE(FQ5.FQ5_FILORI,' ') FQ5_FILORI, COALESCE(FQ5.FQ5_VIAGEM, ' ') FQ5_VIAGEM, COALESCE(FQ5.FQ5_XPROD, ' ') FQ5_XPROD, COALESCE(SB1.B1_DESC, ' ') B1_DESC, COALESCE(SB1.B1_LOCPAD, ' ') B1_LOCPAD, COALESCE(SB1.B1_UM, ' ') B1_UM, COALESCE(SB1.B1_SEGUM, ' ') B1_SEGUM, COALESCE(FQ5.FQ5_XQTD, ' ') FQ5_XQTD, "  
	cQuery += " COALESCE(FQ5.FQ5_HORGER, ' ') FQ5_HORGER, COALESCE(FQ5.FQ5_AS, ' ') FQ5_AS, COALESCE(FQ5.FQ5_OBRA, ' ') FQ5_OBRA, COALESCE(FQ5.FQ5_DESTIN, ' ') FQ5_DESTIN, COALESCE(FQ5.FQ5_STATUS, ' ') FQ5_STATUS, COALESCE(FQ5.FQ5_DATINI, ' ') FQ5_DATINI, COALESCE(FQ5.FQ5_HORINI, ' ') FQ5_HORINI, COALESCE(FQ5.FQ5_DATFIM, ' ') FQ5_DATFIM, "
	cQuery += " COALESCE(FQ5.FQ5_HORFIM, ' ') FQ5_HORFIM, COALESCE(FQ5.FQ5_EQUIP, ' ') FQ5_EQUIP,COALESCE(ST9.T9_NOME, ' ') T9_NOME, COALESCE(FQ5.FQ5_TES, ' ') FQ5_TES, COALESCE(FQ5.FQ5_TPSERV, ' ') FQ5_TPSERV, COALESCE(FQ5.FQ5_CODCLI, ' ') FQ5_CODCLI, COALESCE(FQ5.FQ5_LOJA, ' ') FQ5_LOJA, COALESCE(FQ5.FQ5_XROMAN, ' ') FQ5_XROMAN, COALESCE(FQ5.FQ5_DEMAND, ' ') FQ5_DEMAND, "
	cQuery += " CASE "
	cQuery += " WHEN COALESCE(FQ5.FQ5_STDEMA, ' ') = '1' THEN 'Pendente' " 
	cQuery += " WHEN COALESCE(FQ5.FQ5_STDEMA, ' ') = '2' THEN 'Separada' " 
	cQuery += " WHEN COALESCE(FQ5.FQ5_STDEMA, ' ') = '3' THEN 'Conferida' "
	cQuery += " WHEN COALESCE(FQ5.FQ5_STDEMA, ' ') = '4' THEN 'Embarcada' "
	cQuery += " WHEN COALESCE(FQ5.FQ5_STDEMA, ' ') = '5' THEN 'NF Emitida' "
	cQuery += " ELSE ' ' "
	cQuery += " END FQ5_STDEMA, "
	cQuery += " COALESCE(FQ5.FQ5_QTD2, ' ') FQ5_QTD2, COALESCE(FQ5.FQ5_PESLIQ, ' ') FQ5_PESLIQ, COALESCE(FQ5.FQ5_PESBRU, ' ') FQ5_PESBRU "

	cQuery += " FROM "+RetSqlName("FQT")+" FQT "
	
	cQuery += " INNER JOIN "+RetSqlName("SA1")+" SA1 ON "
	cQuery += " SA1.A1_FILIAL = '"+xFilial("SA1")+ "' AND "
	cQuery += " SA1.A1_COD = FQT.FQT_CLIPRO AND "
	cQuery += " SA1.A1_LOJA = FQT.FQT_LOJPRO AND "
	cQuery += " SA1.D_E_L_E_T_ = ' ' "

	cQuery += " LEFT JOIN "+RetSqlName("FQ5")+" FQ5 ON "
	cQuery += " FQ5.FQ5_FILIAL = '"+xFilial("FQ5")+ "' AND "
	cQuery += " FQ5.FQ5_DEMAND = FQT.FQT_DEMAND AND "
/*
	Do Case
		Case jParams['02'][1] == "1"
			cQuery += " FQ5.FQ5_STDEMA = 1 AND "
		Case jParams['02'][1] == "2"
			cQuery += " FQ5.FQ5_STDEMA = 2 AND "
		Case jParams['02'][1] == "3"
			cQuery += " FQ5.FQ5_STDEMA = 3 AND "
		Case jParams['02'][1] == "4"
			cQuery += " FQ5.FQ5_STDEMA = 4 AND "
		Case jParams['02'][1] == "5"
			cQuery += " FQ5.FQ5_STDEMA = 5 AND "
		Case jParams['02'][1] == "6"
			cQuery += " (FQ5.FQ5_STDEMA = ' ' OR FQ5.FQ5_STDEMA <> ' ') AND "
	EndCase
*/
	cQuery += " FQ5.D_E_L_E_T_ = ' ' "
 
	cQuery += " LEFT JOIN "+RetSqlName("SB1")+" SB1 ON "
	cQuery += " SB1.B1_FILIAL = '"+xFilial("SB1")+ "' AND "
	cQuery += " SB1.B1_COD = FQ5.FQ5_XPROD AND "
	cQuery += " SB1.D_E_L_E_T_ = ' ' "

	cQuery += " LEFT JOIN "+RetSqlName("ST9")+" ST9 ON "
	cQuery += " ST9.T9_FILIAL = '"+xFilial("ST9")+ "' AND "
	cQuery += " ST9.T9_CODBEM = FQ5.FQ5_EQUIP AND "
	cQuery += " ST9.D_E_L_E_T_ = ' ' "

	cQuery += " WHERE FQT.FQT_FILIAL = '"+xFilial("FQT")+ "' AND "
	cQuery += " FQT.FQT_DEMAND = ? AND "
	AAdd(aBind, {jParams['01'][1], "S"})

	cQuery += " FQT.D_E_L_E_T_ = ' ' "

	cQuery := CHANGEQUERY(cQuery)
	cQuery := JurTRepBin(cQuery, aBind)
	self:setOrder("FQT.FQT_DEMAND")
	self:setQuery(cQuery)

return self:oData

/*/{PROTHEUS.DOC} getSchema()
ITUP BUSINESS - TOTVS RENTAL
Declaração dos parâmetros
@AUTHOR LEONARDO PACHECO FUGA
@SINCE 15/05/2026
/*/

method getSchema() as object class demanda

	self:addProperty("Filial",      "Filial",           "string", "Filial",           "FQT_FILIAL")
	self:addProperty("Demanda",     "Demanda",          "string", "Demanda",          "FQT_DEMAND")
	self:addProperty("Projeto",     "Projeto",          "string", "Projeto",          "FQT_PROJET")
	self:addProperty("Cliente",     "Cliente",          "string", "Cliente",          "FQT_CLIPRO")
	self:addProperty("Loja",        "Loja",             "string", "Loja",             "FQT_LOJPRO")
	self:addProperty("DescCli",     "Desc. Cliente",    "string", "Desc. Cliente",    "A1_NOME")
	self:addProperty("Endereco",    "Endereco",         "string", "Endereco",         "A1_END")
	self:addProperty("CEP",         "CEP",              "string", "CEP",              "A1_CEP")
	self:addProperty("Municipio",   "Municipio",        "string", "Municipio",        "A1_MUN")
	self:addProperty("Obra",        "Obra",             "string", "Obra",             "FQT_OBRA")
	self:addProperty("Viagem",      "Viagem",           "string", "Viagem",           "FQ5_VIAGEM")
	self:addProperty("Produto",     "Produto",          "string", "Produto",          "FQ5_XPROD")
	self:addProperty("DescProd",    "Desc. Produto",    "string", "Desc. Produto",    "B1_DESC")
	self:addProperty("Armazem",     "Armazem",          "string", "Armazem",          "B1_LOCPAD")
	self:addProperty("UniMed",      "Uni. Medida",      "string", "Uni. Medida",      "B1_UM")
	self:addProperty("SegUN",       "Seg. Uni. Medida", "string", "Seg. Uni. Medida", "B1_SEGUM")
	self:addProperty("Quantidade",  "Quantidade",       "number", "Quantidade",       "FQ5_XQTD")
	self:addProperty("HrGeracao",   "Hora Geracao",     "string", "Hora Geracao",     "FQ5_HORGER")
	self:addProperty("NrAs",        "Nr. A.S.",         "string", "Nr. A.S.",         "FQ5_AS")
	self:addProperty("Destino",     "Destino",          "string", "Destino",          "FQ5_DESTIN")
	self:addProperty("Status",      "Status",           "string", "Status",           "FQ5_STATUS")
	self:addProperty("DtInicio",    "Dt. Inicio",       "date",   "Dt. Inicio",       "FQ5_DATINI")
	self:addProperty("HrInicio",    "Hr. Inicio",       "string", "Hr. Inicio",       "FQ5_HORINI")
	self:addProperty("DtFim",       "Dt. Fim",          "date",   "Dt. Fim",          "FQ5_DATFIM")
	self:addProperty("HrFim",       "Hr. Fim",          "string", "Hr. Fim",          "FQ5_HORFIM")
	self:addProperty("Bem",         "Bem",              "string", "Bem",              "FQ5_EQUIP")
	self:addProperty("DescBem",     "Desc. Bem",        "string", "Desc. Bem",        "T9_NOME")
	self:addProperty("TES",         "TES",              "string", "TES",              "FQ5_TES")
	self:addProperty("TpServico",   "Tp. Servico",      "string", "Tp. Servico",      "FQ5_TPSERV")
	self:addProperty("Romaneio",    "Romaneio",         "string", "Romaneio",         "FQ5_XROMAN")
	self:addProperty("StatDemanda", "Status Demanda",   "string", "Status Demanda",   "FQ5_STDEMA")
	self:addProperty("QtdSegUN",    "Qtd. Seg. UN",     "number", "Qtd. Seg. UN",     "FQ5_QTD2")
	self:addProperty("PesLiq",      "Peso Liquido",     "number", "Peso Liquido",     "FQ5_PESLIQ")
	self:addProperty("PesBru",      "Peso Bruto",       "number", "Peso Bruto",       "FQ5_PESBRU")

	self:addParameter("01", "Demanda",           "string", .F., "", .F., .F., "", "MV_PAR01")
	self:addParameter("02", "Status da Demanda", "string", .F., "", .F., .F., "", "MV_PAR02", "1=Pendente, 2=Separada, 3=Conferida, 4=Embarcada, 5=NF Emitida, 6=Todos", .F., {"6"})
return self:oSchema


/*/{Protheus.doc} printReceipt
Gera a impressão da Demanda Posicionado 
@author Alexandre Circenis
@since 15/05/2026
@version 25.10
*/
method printDemanda(cDemanda as character) as logical class demanda
Local lSuccess := .F. as logical
Local jPrintInfo as json
Local cSmartViewId := "sigaloc.sv.loc.demanda.default.rep"
Local aReportType := {"report", "data-grid", "pivot-table"} as array
Local cDefaultPath := GetTempPath() as character
Local oSmartView As Object
Local cMsg := "" As Character
  
    jPrintInfo := JsonObject():New() 
    jPrintInfo['name'] := "Demanda_" + FwTimeStamp()
    jPrintInfo['extension'] := "pdf"
    jPrintInfo['path'] := cDefaultPath
    
    oSmartView := totvs.framework.smartview.callSmartView():new(cSmartViewId,aReportType[1])
	oSmartView:setOpenFile(.T.)
    oSmartView:setNoInterface(.F.)
    oSmartView:setParam("01", cDemanda, "Disabled")
    oSmartView:setForceParams(.T.)
    oSmartView:setPrintInfo(jPrintInfo)
    lSuccess := oSmartView:executeSmartView(.T.)

    If !lSuccess .or. file("\SYSTEM\LOCSV029.TXT")
        cMsg := oSmartView:getError()
    EndIf

    oSmartView:Destroy()

    If oSmartView != Nil   
        FreeObj(oSmartView)
    EndIf

return lSuccess
