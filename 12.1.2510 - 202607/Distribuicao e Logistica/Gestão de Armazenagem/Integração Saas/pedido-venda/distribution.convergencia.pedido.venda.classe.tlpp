/*/{Protheus.doc} validaSeparacao
    (Valida se o pedido pode ser separado e enviado para o ERP)
    @author Equipe WMS
    @since 09/10/2024
    @param jSeparacaoProdutoLote, json, produtos e lotes agrupados
    {;
                        "produto"        : AllTrim(aProdutos[item]['produto']['codigo']),;
                        "lote"           : AllTrim(jLote['valor']),;
                        "quantidade"     : aReservas[reserva]['quantidade'],;
                        "tipoEstoque"    : AllTrim(aReservas[reserva]['tipoEstoque'])}
    @param cIdDBZ, character, id DBZ
    @param cMsg, character, mensagem que pode ser retornada para o SaaS
    @return lRet, numeric, pedido foi faturado
    /*/
Method validaSeparacao(aSeparacaoProdutoLote as array) Class WMSSaasPedidoVenda
Local nQtdEmpLoteC9 := 0
Local nQtdSeparada  := 0
Local cLocalEstoque := ""
Local nValorSegUnid := 0
Local lUsaVenc      := SuperGetMv('MV_LOTVENC')=='S'
Local cProduto      := ""
Local item          := 0
Local cAliasSC9
Local cLoteCtl      := ""
Local cIdDBZ        := self:id
    
	For item := 1 to Len(aSeparacaoProdutoLote)
		nQtdSeparada := 0
		cProduto := PadR(aSeparacaoProdutoLote[item]['produto'],nTamC9Prod)
		cLoteCtl := PadR(aSeparacaoProdutoLote[item]['lote'],nTamC9Lote)   
		If Rastro(cProduto,"L") 

			cAliasSC9 := GetNextAlias()

			BeginSql Alias cAliasSC9
				SELECT CASE 
					WHEN 
						Sum(SC9.C9_QTDLIB) IS NULL THEN 0
					ELSE
						Sum(SC9.C9_QTDLIB) END
					AS QTDEMPC9LOTE
				  FROM %Table:SC9% SC9
				 INNER JOIN %Table:DBZ% DBZ
					ON (DBZ.%NotDel%
				   AND DBZ.DBZ_FILIAL = %xFilial:DBZ%
				   AND DBZ.DBZ_NUMDOC = SC9.C9_PEDIDO
				   AND DBZ.DBZ_ID = %Exp:cIdDBZ%)
				 INNER JOIN %Table:DBY% DBY 
					ON (DBY.DBY_FILIAL = %xFilial:DBY%
				   AND DBY.DBY_ITEM = SC9.C9_ITEM
				   AND DBY.DBY_SEQUEN = SC9.C9_SEQUEN
				   AND DBY.DBY_PRODUT = SC9.C9_PRODUTO 
				   AND DBZ.DBZ_ID = DBY.DBY_ID)
				 WHERE DBY.%NotDel%
				   AND SC9.C9_PRODUTO = %Exp:cProduto%
				   AND (SC9.C9_LOTECTL <> %Exp:Space(nTamC9Lote)% AND SC9.C9_LOTECTL = %Exp:cLoteCtl%)
				   AND SC9.C9_FILIAL  = %xFilial:SC9% 
				   AND SC9.%NotDel%
			EndSql
			If (cAliasSC9)->(!Eof())
				nQtdEmpLoteC9 := (cAliasSC9)->QTDEMPC9LOTE
			EndIf
			(cAliasSC9)->(DbCloseArea())

			nQtdSeparada  := aSeparacaoProdutoLote[item]['quantidade']
			cLocalEstoque := aSeparacaoProdutoLote[item]['tipoEstoque']
			nValorSegUnid := ConvUM(cProduto, nQtdSeparada, 0, 2)

			aSaldos := SldPorLote(cProduto,cLocalEstoque,nQtdSeparada,nValorSegUnid,cLoteCtl,NIL,NIL,NIL,NIL,.F.,NIL,lUsaVenc,nil,nil,dDataBase)
            //Se nao existir saldos por lote retorna ERRO
			If !Empty(aSaldos) .And. aSaldos[LOTE][PRODUTO] > 0
				If (aSaldos[LOTE][PRODUTO] + nQtdEmpLoteC9) < nQtdSeparada
					self:setMensagemIntegracao(STR0001 + STR0002 + AllTrim(cProduto)+ STR0003 +AllTrim(cLoteCtl)+ STR0004) //"Não foi possivel confirmar a separação! ""Não existe saldo para o produto "" e lote "
					Return .F. 
				EndIf
			Else
				If nQtdEmpLoteC9 < nQtdSeparada
					self:setMensagemIntegracao(STR0001 + STR0002 + AllTrim(cProduto)+ STR0003 +AllTrim(cLoteCtl)+ STR0004) //"Não foi possivel confirmar a separação! ""Não existe saldo para o produto "" e lote "" no ERP."
					Return .F.
				EndIf
			EndIf
		EndIf
	Next item
Return .T.

/*/{Protheus.doc} setQuantidadeVolumes
    (long_description)
    @author user
    @since 23/09/2024
    @version version
    @param param_name, param_type, param_descr
    @return nQuantVol, numeric - quantidade de volumes para atualizacao do campos C5_VOLUME1
    /*/
Method setQuantidadeVolumes(nQuantVol as numeric) Class WMSSaasPedidoVenda
   Self:quantidadeVolumes := nQuantVol
return 

/*/{Protheus.doc} saveQuantidadeVolumes
    @ Methodo para efetuar a gravação da quantidade de volumes no campo C5_VOLUME1
    @author Equipe WMS Protheus
    @since 25/07/2024
    @version version
    @return
    /*/
Method saveQuantidadeVolumes() Class WMSSaasPedidoVenda
Local cAliasSC5     := NIl
Local aAreaSC5      := SC5->(GetArea())
Local lWMSSASV     := SuperGetMV("MV_WMSSASV",.F.,.F.)

    If Self:quantidadeVolumes > 0 .AND. lWMSSASV
        cAliasSC5 := GetNextAlias()
        BeginSql Alias cAliasSC5
		    SELECT SC5.R_E_C_N_O_ RECNOSC5
		      FROM %Table:SC5% SC5
		     WHERE SC5.C5_FILIAL = %xFilial:SC5%
		       AND SC5.C5_NUM = %Exp:Self:numeroDocumento%
		       AND SC5.%NotDel%
	    EndSql
		If (cAliasSC5)->(!Eof())
			SC5->(dbGoTo((cAliasSC5)->RECNOSC5)) //-- Posiciona no registro do SC5 correspondente
            RecLock("SC5", .F.)
		        SC5->C5_VOLUME1  := Self:quantidadeVolumes
			SC5->(MsUnlock())
		EndIf
        (cAliasSC5)->(DbCloseArea())

    EndIF

    RestArea(aAreaSC5)
Return 

/*/{Protheus.doc} updateQuantidade
    @ Efetua alteracao das quantidades do pedido quando houver separacao a maior no WMS SAAS
    @author Fagner Ferraz
    @since 05/01/2025
    @version version
    @return
    /*/
Method updateQuantidade(aFinalizados as array) Class WMSSaasPedidoVenda
Local cAliasSC9             := GetNextAlias()
Local aAreaSC6              := SC6->(GetArea())
Local aAreaSC9              := SC9->(GetArea())
Local aItens                := {}
Local itemFinalizado        := 0
Local item                  := 0
Local aSequenciasAlteradas  := {}
Local cItem                 := ""
Local cProduto              := ""
Local cLote                 := ""
Local dDataValidade         := CtoD('  /  /  ') 
Local nQtde                 := 0
Local cSequenc              := ""
Local cPedido               := ""
Local nPosItem              := 0
Local aLocaliz              := {}
Local nQtdMaior             := 0
Local cAliasSUM             := ""

    Conout("updateQuantidade - Inicio")

    //--Agrupa itens devido a possibilidade de separacao parcial no WMS SAAS
    For itemFinalizado := 1 to Len(aFinalizados)
        cItem           := aFinalizados[itemFinalizado]['item']
        cProduto        := aFinalizados[itemFinalizado]['produto']
        cLote           := aFinalizados[itemFinalizado]['lote']
        dDataValidade   := aFinalizados[itemFinalizado]['dataValidade']  
        nQtde           := aFinalizados[itemFinalizado]['quantidade']
        cSequenc        := aFinalizados[itemFinalizado]['sequencia']
        cPedido         := Self:numeroDocumento

        cAliasSC9  := GetNextAlias()
        BeginSql Alias cAliasSC9
            SELECT SC9.C9_LOTECTL,
                    SC9.C9_LOCAL,
                    SC9.C9_NUMLOTE,
                    SC9.C9_QTDLIB
            FROM %Table:SC9% SC9
            WHERE SC9.C9_FILIAL = %xFilial:SC9%
            AND SC9.C9_PEDIDO = %Exp:cPedido%
            AND SC9.C9_ITEM = %Exp:cItem%
            AND SC9.C9_PRODUTO = %Exp:cProduto%
            AND SC9.C9_SEQUEN = %Exp:cSequenc%            
            AND SC9.%NotDel%
        EndSql
        dbSelectArea(cAliasSC9)
        dbGoTop()
        If (cAliasSC9)->(!Eof())
            If Empty((cAliasSC9)->C9_LOTECTL)
                nPosItem := aScan(aItens,{|x|AllTrim(x[1]) == AllTrim(cItem) .And.;
                                                AllTrim(x[2]) == AllTrim(cProduto) .And.;
                                                AllTrim(x[3]) == "" .And.;
                                                AllTrim(x[5]) == AllTrim(cSequenc) })
                If nPosItem == 0
                    Aadd(aItens,{cItem, cProduto, " ", nQtde, cSequenc, (cAliasSC9)->C9_LOCAL, dDataValidade})
                Else
                    aItens[nPosItem][4] += nQtde
                EndIf
            Else
                If AllTrim((cAliasSC9)->C9_LOTECTL) == AllTrim(cLote)
                    nPosItem := aScan(aItens,{|x|AllTrim(x[1]) == AllTrim(cItem) .And.;
                                                    AllTrim(x[2]) == AllTrim(cProduto) .And.;
                                                    AllTrim(x[3]) == AllTrim(cLote) .And.;
                                                    AllTrim(x[5]) == AllTrim(cSequenc) })
                    If nPosItem == 0
                        Aadd(aItens,{cItem, cProduto, cLote, nQtde, cSequenc, (cAliasSC9)->C9_LOCAL, dDataValidade})
                    Else
                        aItens[nPosItem][4] += nQtde
                    EndIf
                EndIf
            EndIf
        EndIf
        (cAliasSC9)->(DbCloseArea())
    Next itemFinalizado

    Conout("updateQuantidade - ANTES DO FOR")

    For item := 1 to Len(aItens)
        cItem           := aItens[item][1]
        cProduto        := aItens[item][2]
        cLote           := aItens[item][3]
        nQtde           := aItens[item][4]
        cSequenc        := aItens[item][5]
        cLocal          := aItens[item][6]
        dDataValidade   := StoD(Replace(aItens[item][7],"-",""))
        cPedido         := Self:numeroDocumento

        cAliasSC9  := GetNextAlias()
        BeginSql Alias cAliasSC9
            SELECT SC9.C9_SEQUEN,
                    SC9.R_E_C_N_O_ RECNOSC9
            FROM %Table:SC9% SC9
            WHERE SC9.C9_FILIAL = %xFilial:SC9%
            AND SC9.C9_PEDIDO = %Exp:cPedido%
            AND SC9.C9_ITEM = %Exp:cItem%
            AND SC9.C9_PRODUTO = %Exp:cProduto%
            AND SC9.C9_LOTECTL = %Exp:cLote%
            AND SC9.C9_SEQUEN  = %Exp:cSequenc%
            AND SC9.C9_NFISCAL = ' '
            AND SC9.%NotDel%
            ORDER BY C9_SEQUEN
        EndSql

        Conout("<<<<|updateQuantidade|>>>> Query: "+getlastquery()[2])
        dbSelectArea(cAliasSC9)
        dbGoTop()
        If !(cAliasSC9)->(Eof())

            Conout("updateQuantidade - WHILE")
            If QtdComp(nQtde) > 0
                Conout("updateQuantidade - dentro while")
                SC9->(DbGoTo((cAliasSC9)->RECNOSC9))

                nQtdOrig    := SC9->C9_QTDLIB
                nQtdMaior   := nQtde - nQtdOrig
                
                // Se nao ha quantidade a maior, pula o registro
                If nQtdMaior <= 0
                    Loop
                EndIf

                If !WMSSVldSld(cProduto, cLocal, nQtdMaior)
                    Conout("updateQuantidade - Nao encontrou saldo para separacao a maior")
                    (cAliasSC9)->(DbCloseArea())
                    self:setMensagemIntegracao(STR0001 + STR0002 + AllTrim(cProduto)+ STR0003 +AllTrim(cLote)+ STR0004) //"Não foi possivel confirmar a separação! ""Não existe saldo para o produto "" e lote "" no ERP."
                    Return .F.
                EndIf

                // Itens Pedidos de Vendas
                SC6->(DbSetOrder(1))
                SC6->(MsSeek(xFilial("SC6")+SC9->C9_PEDIDO+SC9->C9_ITEM))
                
                // 2.Estorno do SC9 / Estorno da Liberacao de 6.Estoque/4.Credito do SC9 / WMS
                aLocaliz := {{ "","","","",SC9->C9_QTDLIB,,Ctod(""),"","","",SC9->C9_LOCAL,0}}
                MaAvalSC9("SC9",2,aLocaliz,Nil,Nil,Nil,Nil,Nil,Nil,,.F.,,.F.)
                
                //-- Atualiza quantidade liberada
                RecLock("SC9",.F.)
                SC9->C9_BLEST   := " "
                SC9->C9_BLCRED  := " "
                SC9->C9_QTDLIB  += nQtdMaior
                SC9->C9_BLWMS   := "01"
                SC9->C9_DATALIB := dDataBase
                SC9->C9_QTDLIB2 := ConvUm(SC9->C9_PRODUTO,SC9->C9_QTDLIB,0,2)
                SC9->C9_LOTECTL := cLote
                SC9->C9_DTVALID := dDataValidade
                SC9->(MsUnlock())
                SC9->(DbCommit())

                If WMSSaasPedidoVenda():IsItemInConvergencia(SC9->C9_PEDIDO, SC9->C9_ITEM, SC9->C9_PRODUTO, SC9->C9_SEQUEN)
                    aAdd(aSequenciasAlteradas, {;
                        "produto": cProduto,;
                        "item": cItem,;
                        "sequencia": Alltrim(SC9->C9_SEQUEN),;
                        "tipoEstoque": cLocal,;
                        "quantidade":SC9->C9_QTDLIB,;
                        "lote":cLote,;
                        "dataValidade":dDataValidade;
                        })                    
                EndIf

                RecLock("SC6",.F.)
                
                // Atualiza item do pedido de venda
                SC6->C6_QTDLIB  := SC9->C9_QTDLIB
                SC6->C6_QTDLIB2 := SC9->C9_QTDLIB2
                SC6->C6_LOTECTL := cLote
                SC6->C6_DTVALID := dDataValidade
                
                // Deve calcular tudo o que ja possui liberado do pedido de venda
                cAliasSUM  := GetNextAlias()
                BeginSql Alias cAliasSUM
                        SELECT SUM(SC9.C9_QTDLIB) SUM_QTDLIB
                        FROM %Table:SC9% SC9
                        WHERE SC9.C9_FILIAL = %xFilial:SC9%
                        AND SC9.C9_PEDIDO = %Exp:SC9->C9_PEDIDO%
                        AND SC9.C9_ITEM = %Exp:SC9->C9_ITEM%
                        AND SC9.%NotDel%
                EndSql
                If QtdComp((cAliasSUM)->SUM_QTDLIB) > QtdComp(SC6->C6_QTDVEN)
                    SC6->C6_QTDVEN := (cAliasSUM)->SUM_QTDLIB
                    SC6->C6_UNSVEN := ConvUM(SC6->C6_PRODUTO,SC6->C6_QTDVEN,0,2)
                EndIf
                (cAliasSUM)->(DbCloseArea())
                SC6->C6_VALOR   := SC6->C6_QTDVEN * SC6->C6_PRCVEN
                SC6->(MsUnlock())
                SC6->(DbCommit())

                //-- Atualiza Credito
                aLocaliz := {{ "","","","",SC9->C9_QTDLIB,,Ctod(""),"","","",SC9->C9_LOCAL,0}}
                MaAvalSC9("SC9",1,aLocaliz,Nil,Nil,Nil,Nil,Nil,Nil,,.F.,,.F.)

                // Atualiza DBY com novas quantidades, lotes e data de validade
                Self:updateSequences(aSequenciasAlteradas)
                aSequenciasAlteradas := {}
                
            EndIf
        EndIf
        (cAliasSC9)->(DbCloseArea())
    Next item

    RestArea(aAreaSC6)
    RestArea(aAreaSC9)

    Conout("updateQuantidade - Fim")
Return .T.

/*/{Protheus.doc} updateQuantidadeZero
    @ Efetua a remocao dos itens cancelados no WMS SAAS - Itens zerados
    @author Fagner Ferraz
    @since 29/04/2025
    @version version
    @return
    /*/
Method updateQuantidadeZero(aFinalizados as array) Class WMSSaasPedidoVenda
Local itemFinalizado    := 0
Local nQtde             := 0
Local aZerados          := {}
Local nItem             := 0

    Conout("updateQuantidadeZero - Inicio")

    // Faz varredura do array aFinalizados e pega a posicao dos itens zerados
    For itemFinalizado := 1 to Len(aFinalizados)
        nQtde   := aFinalizados[itemFinalizado]['quantidade']

        If QtdComp(nQtde) <> 0
            Loop
        EndIf

        Aadd( aZerados, itemFinalizado)
        Conout("updateQuantidadeZero - aZerados qtd: " + cvaltochar(Len(aZerados)))

    Next itemFinalizado   

    // Remove do array aFinalizados todos os itens zerados
    If Len(aZerados) > 0
        For nItem := Len(aZerados) To 1 Step -1
            aDel(aFinalizados, aZerados[nItem]); aSize(aFinalizados, Len(aFinalizados)-1)
        Next nItem
    EndIf

    Conout("updateQuantidadeZero - Fim")
Return Len(aZerados) > 0
