namespace totvs.protheus.manufacturing.processinspection

/*/{Protheus.doc} TestEvents
Classe de eventos do Cadastro de Ensaios
@author rafael.kleestadt
@since 16/04/2026
@version P12
/*/
Class TestEvents
    Public Method new() as object

    @beforeCreateInTransaction()
    Public Method beforeCreateInTransaction(oData, oModel, oError) as logical
    
    @beforeUpdateInTransaction()
    Public Method beforeUpdateInTransaction(oData, oModel, oError) as logical

    @Post("retornaDadosNaoConformidadeQip/:cod")
    Public Method retornaDadosNaoConformidadeQip() as logical

    @Post("retornaDescricaoClasseNaoConformidadeQip/:cod")
    Public Method retornaDescricaoClasseNaoConformidadeQip() as logical

    Public Method validaPermissaoAlteracao(oData as object, oModel as object, oError as object) as logical
    Public Method validaNaoConformidades(oData as object, oModel as object, oError as object) as logical
    Public Method retornaDescricaoEClasseNaoConformidade(cCodNC as character) as json
    Public Method gatilhaDadosNaoConformidade(oModel as object) as object
    Public Method gatilhaDescricaoClasseNaoConformidade(oModel as object) as object

EndClass

/*/ {Protheus.doc} new
Instancia da Classe 
@type Method
@Return object, objeto da Classe
@author Rafael.Kleestadt
@since 16/04/2026
/*/
Method new() as object Class TestEvents
Return Self

/*/{Protheus.doc} gatilhaDadosNaoConformidade
Método que cria o gatilho para obter a descrição, Classe e descrição da Classe da não conformidade
ao alterar o campo QP2_NAOCON no grid de não conformidades dos ensaios.
Utiliza uma chamada à API interna para buscar a descrição com base no código informado.
@author rafael.kleestadt
@since 16/04/2026
@version P12
@param oModel, object, objeto do modelo para acessar os dados e estrutura
/*/
Method gatilhaDadosNaoConformidade(oModel as object) as object Class TestEvents

    Local oApiCall               as object
    Local oEvents                as object
    Local oSetFields             as object
    Local oStructFieldClassNC    as object
    Local oStructFieldDesClassNC as object
    Local oStructFieldDesNC      as object

    // --- Chamada à API interna que retorna a descrição da não conformidade --- //
    oApiCall := totvs.framework.structure.interface.BuildApiCallAction():new()
    oApiCall:setLabel("retornaDadosNaoConformidadeQip")
    oApiCall:setIdentifier("retornaDadosNaoConformidadeQip")
    oApiCall:setHTTPMethod("POST")

    // Endpoint que retorna a descrição, Classe e descrição da Classe da não conformidade, com base no código informado
    // Aqui você pode implementar um endpoint REST (Ex: /naoconf/{{QP2_NAOCON}})
    // ou usar uma função ADVPL/TL++ que consulta diretamente a SAG
    oApiCall:setEndpoint("../../../retornaDadosNaoConformidadeQip/{{$selectedRow.QP2_NAOCON}}")

    // --- Monta a ação de atualização de campo --- //
    oSetFields := totvs.framework.structure.interface.BuildSetFieldsAction():new()
    oSetFields:setLabel("defineDadoscaoNaoConformidade")
    oSetFields:setIdentifier("defineDadoscaoNaoConformidade")

    // --- Define o campo alvo (QP2_DESNCO) e o valor retornado --- //
    oStructFieldDesNC := totvs.framework.structure.interface.BuildTargetFieldStructure():new()
    oStructFieldDesNC:setIdentifier("QP2.QP2_DESNCO")
    oStructFieldDesNC:setValue("{{$response.AG_DESCPO}}") // valor retornado pela API
    oStructFieldDesNC:setProperty("readOnly", .t.)
    oSetFields:addTargetField(oStructFieldDesNC:getStructure())

    // --- Define o campo alvo (QP2_CLASSE) e o valor retornado --- //
    oStructFieldClassNC := totvs.framework.structure.interface.BuildTargetFieldStructure():new()
    oStructFieldClassNC:setIdentifier("QP2.QP2_CLASSE")
    oStructFieldClassNC:setValue("{{$response.AG_CLASSE}}") // valor retornado pela API
    oSetFields:addTargetField(oStructFieldClassNC:getStructure())

    // --- Define o campo alvo (QP2_DESCLA) e o valor retornado --- //
    oStructFieldDesClassNC := totvs.framework.structure.interface.BuildTargetFieldStructure():new()
    oStructFieldDesClassNC:setIdentifier("QP2.QP2_DESCLA")
    oStructFieldDesClassNC:setValue("{{$response.QEE_DESCPO}}") // valor retornado pela API
    oStructFieldDesClassNC:setProperty("readOnly", .t.)
    oSetFields:addTargetField(oStructFieldDesClassNC:getStructure())

    // --- Define que a ação será executada ao alterar QP2_NAOCON --- //
    oApiCall:setActionSuccess(oSetFields:getAction())

    // Configuração do evento para disparar a chamada à API ao alterar o campo QP2_NAOCON
    oEvents := totvs.framework.structure.interface.BuildEvents():new()
    oEvents:addOnChange({"dataView", "dataNew", "dataEdit"}, {"QP2.QP2_NAOCON"}, oApiCall:getAction())

    oModel:addTriggers(oEvents:getEvents())

Return

/*/{Protheus.doc} gatilhaDescricaoClasseNaoConformidade
Método que cria o gatilho para obter a descrição da não conformidade
ao alterar o campo QP2_NAOCON no grid de não conformidades dos ensaios.
Utiliza uma chamada à API interna para buscar a descrição com base no código informado.
@author rafael.kleestadt
@since 16/04/2026
@version P12
@param oModel, object, objeto do modelo para acessar os dados e estrutura
/*/
Method gatilhaDescricaoClasseNaoConformidade(oModel as object) as object Class TestEvents

    Local oApiCall     as object
    Local oEvents      as object
    Local oSetFields   as object
    Local oStructField as object

    // --- Chamada à API interna que retorna a descrição da não conformidade --- //
    oApiCall := totvs.framework.structure.interface.BuildApiCallAction():new()
    oApiCall:setLabel("retornaDescricaoClasseNaoConformidadeQip")
    oApiCall:setIdentifier("retornaDescricaoClasseNaoConformidadeQip")
    oApiCall:setHTTPMethod("POST")

    // Endpoint que retorna a descrição com base no código informado
    // Aqui você pode implementar um endpoint REST (Ex: /naoconf/{{QP2_CLASSE}})
    // ou usar uma função ADVPL/TL++ que consulta diretamente a SAG
    oApiCall:setEndpoint("../../../retornaDescricaoClasseNaoConformidadeQip/{{$selectedRow.QP2_CLASSE}}")

    // --- Define o campo alvo (QP2_DESNCO) e o valor retornado --- //
    oStructField := totvs.framework.structure.interface.BuildTargetFieldStructure():new()
    oStructField:setIdentifier("QP2.QP2_DESCLA")
    oStructField:setValue("{{$response.QEE_DESCPO}}") // valor retornado pela API
    oStructField:setProperty("readOnly", .t.)

    // --- Monta a ação de atualização de campo --- //
    oSetFields := totvs.framework.structure.interface.BuildSetFieldsAction():new()
    oSetFields:setLabel("defineDescricaoClasseNaoConformidade")
    oSetFields:setIdentifier("defineDescricaoClasseNaoConformidade")
    oSetFields:addTargetField(oStructField:getStructure())

    // --- Define que a ação será executada ao alterar QP2_CLASSE --- //
    oApiCall:setActionSuccess(oSetFields:getAction())

    // Configuração do evento para disparar a chamada à API ao alterar o campo QP2_CLASSE
    oEvents := totvs.framework.structure.interface.BuildEvents():new()
    oEvents:addOnChange({"dataView", "dataNew", "dataEdit"}, {"QP2.QP2_CLASSE"}, oApiCall:getAction())

    oModel:addTriggers(oEvents:getEvents())

Return

/*/{Protheus.doc} beforeCreateInTransaction
Método disparado antes da inclusão do registro, gatilha campos de chave
@author rafael.kleestadt
@since 16/04/2026
@version P12
@param oData object, objeto de dados do modelo
@param oModel object, objeto do modelo
@param oError object, objeto de erro para capturar mensagens
@Return lRetorno, logical, .T. para continuar a operação, .F. para cancelar
/*/
Method beforeCreateInTransaction(oData as object, oModel as object, oError as object) as logical Class TestEvents

    Local aTexto   := {} as array
    Local cChave   := "" as character
    Local lRetorno := self:validaNaoConformidades(oData, oModel, oError) as logical

    If lRetorno .And. !Empty(oData:getFieldValue("QP1", "QA2TEXTO"))

        cChave := QA_CvKey(xFilial("QP1")+oData:getFieldValue("QP1", "QP1_ENSAIO"),"QP1",2)

        oData:setFieldValue("QP1", "QP1_CHAVE",,cChave)

        AADD(aTexto,{1,oData:getFieldValue("QP1", "QA2TEXTO")})

        QA_GrvTxt(cChave,"QIPA020",1,aTexto)

    EndIf

Return lRetorno

/*/{Protheus.doc} beforeUpdateInTransaction
valida se pode alterar o ensaio
@author rafael.kleestadt
@since 16/04/2026
@version P12
@param oData object, objeto de dados do modelo
@param oModel object, objeto do modelo
@param oError object, objeto de erro para capturar mensagens
@Return lPermAlt, logical, .T. para continuar a operação, .F. para cancelar
/*/
Method beforeUpdateInTransaction(oData as object, oModel as object, oError as object) as logical Class TestEvents
    Local aTexto   := {} as array
    Local cChave   := oData:getFieldValue("QP1", "QP1_CHAVE") as character
    Local cEspec   := Padr("QIPA020", TamSx3("QA2_ESPEC")[1]) as character
    Local lPermAlt := self:validaPermissaoAlteracao(oData, oModel, oError) .And.;
                      self:validaNaoConformidades(oData, oModel, oError) as logical

    If lPermAlt

        If Empty(cChave)
            cChave := QA_CvKey(xFilial("QP1")+oData:getFieldValue("QP1", "QP1_ENSAIO"),"QP1",2)
        EndIf
        
        AADD(aTexto,{1,oData:getFieldValue("QP1", "QA2TEXTO")})

        QA_GrvTxt(cChave,cEspec,1,aTexto)

        oData:setFieldValue("QP1", "QP1_CHAVE",,cChave)

    EndIf

Return lPermAlt

/*/{Protheus.doc} retornaDadosNaoConformidadeQip
Método que retorna a descrição, Classe e descrição da Classe da não conformidade
@author rafael.kleestadt
@since 16/04/2026
@version P12
@param cod, character, código da não conformidade recebido via path param da rota `/:cod`
@Return lRetorno, logical, .T. para continuar a operação, .F. para cancelar
/*/
Method retornaDadosNaoConformidadeQip() as logical Class TestEvents

    Local jDescClassNC := Nil as json
    Local jCaminho     := oRest:getPathParamsRequest() as json
    Local jResposta    := jsonObject():New() as json

    jDescClassNC := self:retornaDescricaoEClasseNaoConformidade(jCaminho["cod"])
    
    jResposta["AG_DESCPO"]  := jDescClassNC["AG_DESCPO"]
    jResposta["AG_CLASSE"]  := jDescClassNC["AG_CLASSE"]
    jResposta["QEE_DESCPO"] := A010DCla(jDescClassNC["AG_CLASSE"])

    oRest:setKeyHeaderResponse("Content-Type", "application/json")
    oRest:setResponse( jResposta:ToJson() )

Return .T.

/*/{Protheus.doc} retornaDescricaoEClasseNaoConformidade
Retorna a descrição e a Classe da não conformidade
@author rafael.kleestadt
@since 16/04/2026
@version P12
@param cCodNC, character, código da não conformidade
@Return jResposta, json, objeto JSON contendo a descrição e a Classe da não conformidade
/*/
Method retornaDescricaoEClasseNaoConformidade(cCodNC as character) as json Class TestEvents

    Local jResposta := jsonObject():New() as json

    jResposta["AG_DESCPO"] := Posicione("SAG",1,xFilial("SAG")+cCodNC,"AG_DESCPO")
    jResposta["AG_CLASSE"] := Posicione("SAG",1,xFilial("SAG")+cCodNC,"AG_CLASSE")
    
Return jResposta

/*/{Protheus.doc} retornaDescricaoClasseNaoConformidadeQip
Método que retorna a descrição da Classe de não conformidade
@author rafael.kleestadt
@since 16/04/2026
@version P12
@param cod, character, código da não conformidade recebido via path param da rota `/:cod`
@Return lRetorno, logical, .T. para continuar a operação, .F. para cancelar
/*/
Method retornaDescricaoClasseNaoConformidadeQip() as logical Class TestEvents
    
    Local jCaminho  := oRest:getPathParamsRequest() as json
    Local jResposta := jsonObject():New() as json
    
    jResposta["QEE_DESCPO"] := A010DCla(jCaminho["cod"])

    oRest:setKeyHeaderResponse("Content-Type", "application/json")
    oRest:setResponse( jResposta:ToJson() )

Return .T.

/*/{Protheus.doc} validaPermissaoAlteracao
valida se pode alterar o ensaio
@author rafael.kleestadt
@since 16/04/2026
@version P12
@param oData object, objeto de dados do modelo
@param oModel object, objeto do modelo
@param oError object, objeto de erro para capturar mensagens
@Return lRetorno, logical, .T. para continuar a operação, .F. para cancelar
/*/
Method validaPermissaoAlteracao(oData as object, oModel as object, oError as object) as logical Class TestEvents
    Local aAreaAnt   := {} as array
    Local cEnsaioQP1 := oData:getFieldValue("QP1", "QP1_ENSAIO") as character
    Local cFilQP1    := oData:getFieldValue("QP1", "QP1_FILIAL") as character
    Local lRetorno   := .T. as logical

    DbSelectArea("QP1")
    QP1->( DBSetOrder( 1 ) )//QP1_FILIAL+QP1_ENSAIO		
	If QP1->( DBSeek(cFilQP1+cEnsaioQP1) )

        aAreaAnt := GetArea()
        DbSelectArea("QPR")
        QPR->(dbSetOrder(2)) //QPR_FILIAL+QPR_ENSAIO
        If QPR->(dbSeek(xFilial("QPR")+QP1->QP1_ENSAIO))
            //STR0001 - "Validação de alteração"
            //STR0002 - "Alteração não permitida, ensaio apresenta medições cadastradas."
            oError:set(400, STR0001, STR0002)
            lRetorno := .F.
        EndIf
        RestArea(aAreaAnt)

    EndIf

Return lRetorno

/*/{Protheus.doc} validaNaoConformidades
valida duplicidade de não conformidades do grid de ensaios
@author rafael.kleestadt
@since 16/04/2026
@version P12
@param oData object, objeto de dados do modelo
@param oModel object, objeto do modelo
@param oError object, objeto de erro para capturar mensagens
@Return lRetorno, logical, .T. para continuar a operação, .F. para cancelar
/*/
Method validaNaoConformidades(oData as object, oModel as object, oError as object) as logical Class TestEvents

    Local aNCsGrid  := {} as array
    Local aQP2      := oData:GetData():QP2 as array
    Local cCodNC    := "" as character
    Local jLinhaQP2 := Nil as json
    Local lRetorno  := .T. as logical
    Local nIndice   := 0 as numeric

    If ValType(aQP2) == "A" .And. Len(aQP2) > 0
        For nIndice := 1 To Len(aQP2)
            jLinhaQP2 := aQP2[nIndice]

            If !jLinhaQP2:hasProperty("lDeleted")
                cCodNC := Upper(AllTrim(jLinhaQP2["QP2_NAOCON"]))

                If AScan(aNCsGrid, cCodNC) > 0
                    //STR0005 - "Validação de não conformidade"
                    //STR0006 - "Não Conformidade "
                    //STR0007 - " duplicada no ensaio."
                    oError:set(400, STR0005, STR0006 + cCodNC + STR0007)
                    lRetorno := .F.
                    Exit
                EndIf
            
                AAdd(aNCsGrid, cCodNC)
            EndIf

        Next nIndice
    EndIf

Return lRetorno
