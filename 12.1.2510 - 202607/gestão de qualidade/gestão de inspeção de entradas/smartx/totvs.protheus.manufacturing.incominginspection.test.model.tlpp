#include "fw-tlpp-core.th"
#include "totvs.ch"
#include "totvs.framework.structure.model.th"
 
/*/-----------------------------------------------------------
{Protheus.doc} totvs.framework.model.TestModel
Classe do modelo
@type class
@author rafael.kleestadt
@version P12
-----------------------------------------------------------/*/

namespace totvs.protheus.manufacturing.incominginspection
 
@totvsFrameworkStructureModel(lookup=.F., country="ALL")

/*/{Protheus.doc} TestModel
Classe do modelo de dados do cadastro de ensaios
@author rafael.kleestadt
@since 08/04/2026
@version P12
/*/
Class TestModel From totvs.framework.structure.model.data
    Public Method new() as object
    Public Method setModel()
EndClass
 
/*/{Protheus.doc} new
Instância do objeto da classe
@type Method
@author rafael.kleestadt
@version P12
/*/
Method new() as object Class TestModel
    _Super:new(,,.T.)
Return self
 
/*/{Protheus.doc} setModel
Definição do modelo de dados
@type Method
@author rafael.kleestadt
@version P12
/*/
Method setModel() Class TestModel

    Local cEspec := Padr("QIEA020", TamSx3("QA2_ESPEC")[1]) as character
    Local oEvents as object
    Local oField  as object
    Local oHeader as object
    Local oQE2    as object

    //Ensaios - Cabeçalho
    oHeader := totvs.framework.structure.object.ObjectFromMetadata():new( "QE1",, {"QE1_FILIAL", "QE1_ENSAIO"}, , {"QE1_CHAVE"} )
    self:setObject(oHeader:getObject(), "QE1")

    // Grid Não Conformidades dos Ensaios 
    oQE2 := totvs.framework.structure.object.ObjectFromMetadata():new( "QE2",, {"QE2_FILIAL", "QE2_ENSAIO", "QE2_NAOCON"} )
    self:addArray( oQE2:getObject(), "QE2", {"QE2_FILIAL", "QE2_ENSAIO"}, {"QE1_FILIAL", "QE1_ENSAIO"}, "QE1",, AllTrim(FWX2Nome("QE2")))
    
    // Campo de chave para o cadastro de ensaios, não é exibido na interface, utilizado para armazenar um valor único do texto do método do ensaio, que é gravado e recuperado da QA2, para facilitar a identificação do registro e garantir a integridade dos dados relacionados ao método do ensaio.
    self:setProperty("QE1_CHAVE", "hidden", .T., "QE1")
    
    // Campo para exibir o texto método gravado e recuperado da QA2
    oField := totvs.framework.structure.object.BuildFieldProperties():new( "QA2TEXTO" )
    oField:setType("C")
    oField:setTitle(" ")
    oField:setSize(500000000)
    oField:setOrder(100)
    oField:setDefault( "QA_RecTxt( QE1->QE1_CHAVE, '" + cEspec + "' )" )
    oField:setInUse(.T.)

    // Adiciona o campo de texto do método do ensaio ao objeto de cabeçalho dos ensaios, para que seja possível exibir e armazenar o texto relacionado ao método do ensaio, utilizando a chave gerada a partir do conteúdo do texto.
    oHeader:addAdditionalField(oField:getFieldProperties())

    oEvents := totvs.protheus.manufacturing.incominginspection.TestEvents():new()
    self:setEvents(oEvents)
    oEvents:gatilhaDadosNaoConformidade(self)
    oEvents:gatilhaDescricaoClasseNaoConformidade(self)
    
    FwFreeObj(oHeader)
    FwFreeObj(oQE2)
Return
