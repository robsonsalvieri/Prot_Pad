/*/
Function CloseDll32

Local 	cPath	:= GetRemoteIniName()
Private	nRet32	:= 0

Do While Right(cPath,1) <> "\"
	If Right(cPath,1) <> "\"
		cPath := Stuff(cPath,Len(cPath),1,"")
	Endif
Enddo

If File(cPath+"MsChart.DLL",2)
	nRet32 := ExecInDLLOpen("MsChart.DLL")
Else
	nRet32 := ExecInDLLOpen("QaChart.DLL")
Endif

ExecInDLLClose(nRet32)

Return(Nil)


