ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß
*/
Function GeraTxt32( aDados , cFile , cDir )
Local lOk		:= .T.
Local nHandle	:= 0
Local nSec		:= 0

Default cFile	:= "QACHART.SPC"
Default aDados := { }

cDir := Alltrim(cDir)
if !(Right(cDir,1) == "\")
	cDir += "\"
Endif

//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
//³											³
//³	 Formato do array a ser passado		    ³
//³											³
//³ Array de uma coluna contendo uma string ³
//³											³
//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
If File( cDir+cFile )
	If FErase(cDir+cFile) == 0
		lOk := .T.
	else
		nSec := Seconds()
		While FErase(cDir+cFile) <> 0
			if Seconds() > nSec + 5
				lOk := .F.
				Exit
			Endif
		EndDo
		if !lOk
			MsgStop(STR0024,STR0021) //"Outro usu rio utilizando o arquivo. Tente novamente" ### "Atenção"
		Endif
	Endif
Endif
If lOk
	IF (nHandle := FCREATE(cDir+cFile, FC_NORMAL)) == -1
		lOk := .F.
		If FError()=3											// Path Not Found
			MsgStop(STR0026,STR0021) //"O Diretório/Pasta informado no parâmetro 'MV_QDIRGRA' não existe. O gráfico não poderá ser gerado." ### "Atenção"
		Else
			MsgStop( STR0025 + cDir+cFile,STR0021  )	//"Não foi possível criar o arquivo para o gráfico " ### "Atenção"
		EndIf
	Endif
Endif
If lOk
	aEval( aDados, { |cTexto,nX| FWrite( nHandle, cTexto + Chr(13)+Chr(10) ), Len(cTexto) } )
	FClose(nHandle)
Endif
Return lOk

