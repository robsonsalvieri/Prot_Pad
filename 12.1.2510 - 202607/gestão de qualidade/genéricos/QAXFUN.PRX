/*/

Function ConSX3(cCampo)
Local aAreaAtu 	:= GetArea()
Local cF3		:= ""

If !Empty(GetSx3Cache(cCampo,"X3_CAMPO"))
	cF3 := GetSx3Cache(cCampo,"X3_F3")
Endif

RestArea(aAreaAtu)
Return cF3

/*ÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜ
