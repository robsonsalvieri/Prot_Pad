±±³Fun‡ao    ³QA_USUARIO³ Autor ³ Aldo Marini Junior       ³ Data ³ 09/08/01 ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄ´±±
±±³Descri‡ao ³Retorna um array com dados do Usuario Logado                   ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ´±±
±±³Sintaxe   ³QA_USUARIO()                                                   ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ´±±
±±³Parametro ³Nenhum                                                         ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ´±±
±±³Uso       ³SIGAQNC - Generico                                             ³±±
±±ÀÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ±±
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß*/
Function QA_USUARIO()

Local aArray 	:= {.F.,"","","","",""}
Local aAreaAnt 	:= GetArea()
Local aAreaQAA	:= QAA->(GetArea())

DbSelectArea("QAA")
DbSetOrder(6)

If QAA->(DbSeek(TRIM(UPPER(cUsername))))
   aArray[1]:= .T.
   aArray[2]:= QAA->QAA_FILIAL
   aArray[3]:= QAA->QAA_MAT
   aArray[4]:= QAA->QAA_CC
   If !Empty(AllTrim(QAA->QAA_EMAIL))
	   aArray[5]:= QAA->QAA_EMAIL
	Else
		If !Empty(UsrRetMail(__CUSERID))
			aArray[5] := AllTrim(UsrRetMail(__CUSERID))
		Else
			aArray[5] := "SIGA"+cModulo
		EndIf
	Endif
	aArray[6]:= QAA->QAA_NOME
EndIf

RestArea(aAreaQAA)
RestArea(aAreaAnt)

Return aArray
/*
ÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜ
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
±±ÉÍÍÍÍÍÍÍÍÍÍÑÍÍÍÍÍÍÍÍÍÍËÍÍÍÍÍÍÍÑÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍËÍÍÍÍÍÍÑÍÍÍÍÍÍÍÍÍÍÍÍÍ»±±
±±ºPrograma  ³MSRPortQM2ºAutor  ³Fernandes/Denis     º Data ³  01/22/02   º±±
±±ÌÍÍÍÍÍÍÍÍÍÍØÍÍÍÍÍÍÍÍÍÍÊÍÍÍÍÍÍÍÏÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÊÍÍÍÍÍÍÏÍÍÍÍÍÍÍÍÍÍÍÍÍ¹±±
±±ºDesc.     ³Funcao responsavel pela leitura dos dados do instrumento    º±±
±±º          ³conectado a uma porta.                                      º±±
±±ÌÍÍÍÍÍÍÍÍÍÍØÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ¹±±
±±³Retorno	 ³ExpL1 : Timer 				                      		  º±±
±±º          ³ExpL2 : Porta que esta conectado o instrumento              º±±
±±º          ³ExpL3 : Bits por Segundo                                    º±±
±±º          ³ExpL4 : Valor                                               º±±
±±º          ³ExpL5 : Bit Dados                                           º±±
±±º          ³ExpL6 : Bit Stop                                            º±±
±±º          ³ExpL7 : TimeOut                                             º±±
±±º          ³ExpL8 : Casa(s) Decimal(is) a ser(em) considerada(s)		  º±±
±±ÌÍÍÍÍÍÍÍÍÍÍØÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ¹±±
±±ºUso       ³ QMTA140/141/142                                            º±±
±±ÈÍÍÍÍÍÍÍÍÍÍÏÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ¼±±
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß
*/
Function MSRPortQM2( oTmr,cPorta, cBaudRate, nTeste, cData, nStop,cTimeout, nTam )
Local cBufferVar := Space(100)
Local nHandle := -1
Local nLen	:= 1
Default lOnline := .T.
Default nTam:= 2

If lOnline //Flag para identificar que o instrumento esta ativado a porta
	//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
	//³Desativa o timer para nao chamar novamente a funcao enquanto esta lendo³
	//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
	oTmr:DeActivate()
	//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
	//³Realiza abertura da Porta³
	//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
	If MyOpenQM2( @nHandle, cPorta, cBaudRate, nTeste, cData, nStop, cTimeout)
		//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
		//³Aguarda 1 segundo para conseguir ler³
		//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
		inkey(1)
		nBytes := FRead(nHandle, @cBufferVar, Len(cBufferVar))
		cBufferVar := SubStr(StrTran(cBufferVar,".",","),nLen,Len(cBufferVar))
		If SubStr(cBufferVar,1,1) == "+"
			nLen := 3
		Endif
		cBufferVar := SubStr(StrTran(cBufferVar,".",","),nLen,(Len(cBufferVar)-1))
		cBufferVar := StrTran(Str(SuperVal(cBufferVar),10,nTam),".",",")
		FClose( nHandle )
	EndIf
	//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
	//³Ativa o timer novamente, para chamar a funcao "n" vezes³
	//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
	oTmr:Activate()
Endif
Return cBufferVar
/*
ÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜ
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
±±ÉÍÍÍÍÍÍÍÍÍÍÑÍÍÍÍÍÍÍÍÍÍËÍÍÍÍÍÍÍÑÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍËÍÍÍÍÍÍÑÍÍÍÍÍÍÍÍÍÍÍÍÍ»±±
±±ºPrograma  ³MyOpenQM2 ºAutor  ³Fernandes/Denis     º Data ³  01/22/02   º±±
±±ÌÍÍÍÍÍÍÍÍÍÍØÍÍÍÍÍÍÍÍÍÍÊÍÍÍÍÍÍÍÏÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÊÍÍÍÍÍÍÏÍÍÍÍÍÍÍÍÍÍÍÍÍ¹±±
±±ºDesc.     ³Funcao responsavel pela abertura da porta a qual o instru-  º±±
±±º          ³mento esta conectado.                                       º±±
±±ÌÍÍÍÍÍÍÍÍÍÍØÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ¹±±
±±³Retorno	 ³ExpL1 : Handle(status da porta)			         		  º±±
±±º          ³ExpL2 : Porta que esta conectado o instrumento              º±±
±±º          ³ExpL3 : Bits por Segundo                                    º±±
±±º          ³ExpL4 : Valor                                               º±±
±±º          ³ExpL5 : Bit Dados                                           º±±
±±º          ³ExpL6 : Bit Stop                                            º±±
±±º          ³ExpL7 : TimeOut                                             º±±
±±ÌÍÍÍÍÍÍÍÍÍÍØÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ¹±±
±±ºUso       ³ QMTA140/141/142                                            º±±
±±ÈÍÍÍÍÍÍÍÍÍÍÏÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍÍ¼±±
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß
*/
Function MyOpenQM2( nHandle, cPorta, cBaudRate, nTeste, cData, nStop, cTimeout )
Local lRet := .T.
Local cSettings := cBaudRate + "," +;
						 Alltrim(Str(nTeste))+","+;
						 cData+","+;
						 Alltrim(Str(nStop)+","+;
						 Alltrim(cTimeOut))
If nAmbiente == 1
	cPorta := "SERVER"+cPorta
Endif
//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
//³O parametros aSettings dever ter o seguinte formato:               ³
//³aSettings := cBaudRate + "," + cParity + "," + cData + "," + cStop ³
//³Onde:                                                              ³
//³     cBaudRate pode ser qualquer valor das constantes de velocidade³
//³     cParity pode ser qualquer valor das contantes de paridade     ³
//³     cData pode ser qualquer valor entre 4 e 8                     ³
//³     cStop pode ser qualquer valor das contantes de Stopbits       ³
//³                                                                   ³
//³OBS: Sempre separados por virgula (,) e sem espacos                ³
//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ

nHandle := fopenPort(cPorta,cSettings)

If nHandle == -1
	MsgStop(OemToAnsi(STR0047)+Alltrim(cPorta)+OemToAnsi(STR0048)) //"Nao foi possivel abrir a porta: " - ". Verifique as configuracoes: "
	lRet := .F.
Endif

Return lRet

/*ÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜ
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
±±ÚÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄ¿±±
±±³Fun‡…o	 ³ QA_NFUNC ³ Autor ³ Eduardo de Souza      ³ Data ³ 23/03/02 ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄ´±±
±±³Descri‡…o ³ Gatilho para preencher a descricao da Funcao/Cargo 		  ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ´±±
±±³Sintaxe	 ³ QA_NFUNC(ExpC1,ExpL1)									  ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ´±±
±±³Parametros³ ExpC1 = Codigo da Funcao/Cargo							  ³±±
±±³			 ³ ExpL1 = Indica se e' gatilho                               ³±±
±±³			 ³ ExpC2 = Filial da Funcao                                   ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ´±±
±±³ Uso		 ³ Generico - Cham. no X3_RELACAO,X3_INIBRW e gatilhos        ³±±
±±ÀÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ±±
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß*/
Function QA_NFUNC(cCodDe,lGatilho,cFilCod)

Local cDesc:= ""

Default lGatilho:= .T.
Default cFilCod := xFilial("QAC")

If Type("INCLUI") <> "L"
	Inclui:= .F.
EndIf

cDesc:= Space(Len(QAC->QAC_DESC))

If !Inclui .Or. lGatilho	// Se Inic. Padrao ou gatilho a partir do cod. Depart.
	If QAC->(DbSeek(cFilCod + cCodDe))
		cDesc:= QAC->QAC_DESC
	Endif
EndIf

Return cDesc

/*ÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜ
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
±±ÚÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÂÄÄÄÄÄÄÂÄÄÄÄÄÄÄÄÄÄ¿±±
±±³Fun‡ao	 ³QA010VrCfg³ Autor ³Newton R. Ghiraldelli  ³ Data ³ 09/12/99 ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄ´±±
±±³Descri‡ao ³Verifica a existencia de apelido no configurador            ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ´±±
±±³Sintaxe	 ³QA010VrCfg()                                                ³±±
±±ÃÄÄÄÄÄÄÄÄÄÄÅÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ´±±
±±³ Uso      ³ QAXA010 - Siga Quality (Generico)                          ³±±
±±ÀÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ±±
±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß*/
Function QA010VrCfg(lTudoOk)

Local lContinua := .T.
Local nOrdQAA   := QAA->(IndexOrd())
Local nPosQAA   := QAA->(Recno())
Local nTamLogin := TAMSX3("QAA_LOGIN")[1]

DEFAULT lTudoOk := .F.

If ! lTudoOk .And. Empty(M->QAA_APELID)
	M->QAA_APELID := M->QAA_LOGIN
ElseIf lTudoOk .And. Empty(M->QAA_APELID)
	// STR0065 - "Confirma o preenchimento do nome reduzido utilizando o login ?"
	// STR0007 - "Atenção"
	If MsgYesNo(STR0065,STR0007)
		M->QAA_APELID := M->QAA_LOGIN
	Else
		// STR0066 - "O nome reduzido do usuário está em branco."
		// STR0103 - "Informe o nome reduzido do usuário."
		Help("",1,"QX10INFNOMRED",,STR0066,1,0,,,,,,{STR0103})
		Return .F.
	Endif
Endif
M->QAA_LOGIN := PADR(Upper(M->QAA_LOGIN),nTamLogin)
If !Empty(M->QAA_LOGIN)
	PswUpper(.T.)
	PswOrder(2)
	If PswSeek(M->QAA_LOGIN)
		If INCLUI .Or. PADR(M->QAA_LOGIN,nTamLogin) <> PADR(QAA->QAA_LOGIN,nTamLogin)
			// Busca direta: se encontrar outro registro com mesmo login e que não seja
			// o registro atual (filial+matricula diferente) -> erro
			QAA->(DbSetOrder(6))
			If QAA->(MsSeek(PADR(M->QAA_LOGIN,nTamLogin)))
				If !(M->QAA_MAT == QAA->QAA_MAT)
					// STR0050 - "Já existe um usuário cadastrado com este login."
					// STR0102 - "Informe outro Login para o usuário."
					Help("",1,"QX10USREXIST",,STR0050,1,0,,,,,,{STR0102})
					lContinua := .F.
				Endif
			Endif
		Endif
		
		If lTudoOk .And. M->QAA_RECMAI = "1" .And. Empty(M->QAA_EMAIL)
			// STR0057 - "O email do usuário está em branco."
			// STR0104 - "Informe o email do usuário."
			Help("",1,"QX10INFEMAIL",,STR0057,1,0,,,,,,{STR0104})
			lContinua := .F.
		Endif
	Else
		// STR0052 - "Não foi encontrado a ocorrência deste login no configurador."
		// STR0102 - "Informe outro login para o usuário."
		Help("",1,"QX10USRNEXIST",,STR0052,1,0,,,,,,{STR0102})
		lContinua := .F.
	Endif

	PswUpper(.F.)
Endif

QAA->(DbSetOrder(nOrdQAA))
QAA->(DbGoto(nPosQAA))

Return lContinua


