Function QX10VDtFim()

If !Empty(M->QAA_FIM) .And. M->QAA_FIM < M->QAA_INICIO
	Help(" ",1,"QXDTFIM") // "A Data Final nao pode ser menor que a Data de Inicio."
	Return .F.
EndIf

Return .T.

/*ÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜ
