#include "protheus.ch"
#include "tlpp-core.th"
#include "tlpp-object.th"

namespace totvs.protheus.fiscal.taf.event

//-------------------------------------------------------------------
/*/{Protheus.doc} SchemaXMLEventBase
Classe principal para montar XML base para os eventos

@type class
@author Misael Ramos
@since 29/10/2025
@version 1.0
/*/
//-------------------------------------------------------------------
Class SchemaXMLEventBase

    public data cOrgaoAutor as character
    public data cTpAutor as character
    public data cTpEvento as character
    public data cChNFe as character

    public method New() as object
    public method SchemaXmlEventHeader() as character
    public method SchemaXmlEventFooter() as character

EndClass

//-------------------------------------------------------------------
/*/{Protheus.doc} New
Construtor da classe SchemaXMLEventBase

@type method
@author Misael Ramos
@since 29/10/2025
@version 1.0
/*/
//-------------------------------------------------------------------
Method New() as object Class SchemaXMLEventBase
Return Self

//-------------------------------------------------------------------
/*/{Protheus.doc} SchemaXmlEventHeader
Metodo para montar a string com o Cabeçalho do XML base para os eventos

@type class
@author Misael Ramos
@since 29/10/2025
@version 1.0
/*/
//-------------------------------------------------------------------
Method SchemaXmlEventHeader() as character Class SchemaXMLEventBase

    Local cXmlHeader := "" as character

    cXmlHeader := "<envEvento>"
    cXmlHeader += "<eventos>"
    cXmlHeader += "<detEvento>"
    cXmlHeader += "<cOrgaoAutor>"+::cOrgaoAutor+"</cOrgaoAutor>"
    cXmlHeader += "<tpAutor>"+::cTpAutor+"</tpAutor>"

Return cXmlHeader

//-------------------------------------------------------------------
/*/{Protheus.doc} SchemaXmlEventFooter
Metodo para montar a string com o Rodapé do XML base para os eventos

@type class
@author Misael Ramos
@since 29/10/2025
@version 1.0
/*/
//-------------------------------------------------------------------
Method SchemaXmlEventFooter() as character Class SchemaXMLEventBase

    Local cXmlFooter := "" as character

    cXmlFooter := "<tpEvento>"+::cTpEvento+"</tpEvento>"
    cXmlFooter += "<chNFe>"+::cChNFe+"</chNFe>"
    cXmlFooter += "</detEvento>"
    cXmlFooter += "</eventos>"
    cXmlFooter += "</envEvento>"

Return cXmlFooter
