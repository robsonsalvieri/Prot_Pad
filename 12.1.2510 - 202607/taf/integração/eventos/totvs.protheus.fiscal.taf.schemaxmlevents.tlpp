#include "protheus.ch"
#include "tlpp-core.th"
#include "tlpp-object.th"

namespace totvs.protheus.fiscal.taf.event

//-------------------------------------------------------------------
/*/{Protheus.doc} SchemaXMLEvents
Classe que herda SchemaXMLEventBase com o Cabeçalho e Rodapé para montar XML dos eventos

@type class
@author Misael Ramos
@since 29/10/2025
@version 1.0

/*/
//-------------------------------------------------------------------
Class SchemaXMLEvents From SchemaXMLEventBase

	public data cXml as character

	public method New() as object
	public method XmlEvent110001() as character
	public method XmlEvent112110() as character
	public method XmlEvent112120() as character
	public method XmlEvent112130() as character
	public method XmlEvent112140() as character
	public method XmlEvent112150() as character
	public method XmlEvent211110() as character
	public method XmlEvent211120() as character
	public method XmlEvent211124() as character
	public method XmlEvent211128() as character
	public method XmlEvent211130() as character
	public method XmlEvent211140() as character
	public method XmlEvent211150() as character
	public method XmlEvent212110() as character
	public method XmlEvent212120() as character

EndClass

//-------------------------------------------------------------------
/*/{Protheus.doc} SchemaXMLEvents::New
Método de instância da classe

@type method
@version 1.0 
@author Misael Ramos
@since 29/10/2025
@param cOrgaoAutor, character, Código do Órgão Autor do Evento. Informar o Código da UF para este Evento
@param cTpAutor, character, Valores: 1=Empresa Emitente, 2=Empresa destinatária; 3=Empresa; 5=Fisco; 6=RFB; 9=Outros Órgãos
@param cTpEvento, character, Código do Evento
@param cChNFe, character, Chave de Acesso da NFe
@return object, Retorna o objeto com os atributos atualizados
/*/
//-------------------------------------------------------------------
Method New(cOrgaoAutor as character, cTpAutor as character, cTpEvento as character, cChNFe as character) as Object Class SchemaXMLEvents

	_Super:New()
	::cOrgaoAutor := cOrgaoAutor
	::cTpAutor := cTpAutor
	::cTpEvento := cTpEvento
	::cChNFe := cChNFe

Return Self

//-------------------------------------------------------------------
/*/{Protheus.doc} SchemaXMLEvents::XmlEvent110001
Método para montar a string do XML do Evento 110001
Evento: Cancelamento de Evento

@type method
@version 1.0
@author Misael Ramos
@since 29/10/2025
@param cTpEventoAut, character, Código do evento autorizado a ser cancelado
@param cNProtEvento, character, Informar o número do Protocolo de Autorização do Evento a ser cancelado
@return character, Retorna a string do XML do Evento 110001
/*/
//-------------------------------------------------------------------
Method XmlEvent110001(cTpEventoAut as character, cNProtEvento as character) as character Class SchemaXMLEvents

	::cXml += "<tpEventoAut>"+cTpEventoAut+"</tpEventoAut>"
	::cXml += "<nProtEvento>"+cNProtEvento+"</nProtEvento>"

Return ::cXml

//-------------------------------------------------------------------
/*/{Protheus.doc} SchemaXMLEvents::XmlEvent112110
Método para montar a string do XML do Evento 112110
Evento: Informação de efetivo pagamento integral para liberar crédito presumido do adquirente

@type method
@version 1.0
@author Misael Ramos
@since 29/10/2025
@param cIndQuitacao, character, Indicador de efetiva quitação do pagamento integral referente a NFe referenciada. Valor deve ser igual a "1"
@return character, Retorna a string do XML do Evento 112110
/*/
//-------------------------------------------------------------------
Method XmlEvent112110(cIndQuitacao as character) as character Class SchemaXMLEvents

	::cXml += "<indQuitacao>"+cIndQuitacao+"</indQuitacao>"

Return ::cXml

//-------------------------------------------------------------------
/*/{Protheus.doc} SchemaXMLEvents::XmlEvent112120
Método para montar a string do XML do Evento 112120
Evento: Importação em ALC/ZFM não convertida em isenção

@type method
@version 1.0
@author Misael Ramos
@since 29/10/2025
@param cItem, character, Corresponde ao atributo "nItem" do elemento "det" da NF-e de importação
@param cIBS, character, Valor do IBS correspondente à quantidade que não atendeu aos requisitos para a conversão em isenção
@param cCBS, character, Valor do CBS correspondente à quantidade que não atendeu aos requisitos para a conversão em isenção
@param cQtde, character, Informar a quantidade que não atendeu os requisitos para a conversão em isenção
@param cUnidade, character, Informar a unidade relativa ao campo gConsumo
@return character, Retorna a string do XML do Evento 112120
/*/
//-------------------------------------------------------------------
Method XmlEvent112120(cItem as character, cIBS as character, cCBS as character, cQtde as character, cUnidade as character) as character Class SchemaXMLEvents

	::cXml := ''

	::cXml += '<gConsumo nItem="'+cItem+'">'
	::cXml += "<vIBS>"+cIBS+"</vIBS>"
	::cXml += "<vCBS>"+cCBS+"</vCBS>"
	::cXml += "<gControleEstoque>"
	::cXml += "<qtde>"+cQtde+"</qtde>"
	::cXml += "<unidade>"+cUnidade+"</unidade>"
	::cXml += "</gControleEstoque>"
	::cXml += "</gConsumo>"

Return ::cXml

//-------------------------------------------------------------------
/*/{Protheus.doc} SchemaXMLEvents::XmlEvent112130
Método para montar a string do XML do Evento 112130
Evento: Perecimento, perda, roubo ou furto durante o transporte contratado pelo fornecedor

@type method
@version 1.0
@author Misael Ramos
@since 29/10/2025
@param cItem, character, Corresponde ao atributo "nItem" do elemento "det" na nota de fornecimento
@param cIBS, character, Valor do IBS na Nota de Fornecimento correspondente à quantidade que foi objeto de roubo, perda, furto ou perecimento
@param cCBS, character, Valor da CBS na Nota de Fornecimento correspondente à quantidade que foi objeto de roubo, perda, furto ou perecimento
@param cQPerecimento, character, Informar a quantidade que foi objeto de roubo, perda, furto ou perecimento
@param cUPerecimento, character, Informar a unidade relativa ao campo qPerecimento
@param cIBSOrig, character, Valor do IBS total da nota de aquisição
@param cCBSOrig, character, Valor da CBS total da nota de aquisição
@return character, Retorna a string do XML do Evento 112130
/*/
//-------------------------------------------------------------------
Method XmlEvent112130(cItem as character, cIBS as character, cCBS as character, cQPerecimento as character, cUPerecimento as character, cIBSOrig as character, cCBSOrig as character) as character Class SchemaXMLEvents

	::cXml := ''

	::cXml += '<gPerecimento nItem="'+cItem+'">'
	::cXml += "<vIBS>"+cIBSOrig+"</vIBS>"
	::cXml += "<vCBS>"+cCBSOrig+"</vCBS>"
	::cXml += "<gControleEstoque>"
	::cXml += "<qPerecimento>"+cQPerecimento+"</qPerecimento>"
	::cXml += "<uPerecimento>"+cUPerecimento+"</uPerecimento>"
	::cXml += "<vIBS>"+cIBS+"</vIBS>"
	::cXml += "<vCBS>"+cCBS+"</vCBS>"
	::cXml += "</gControleEstoque>"
	::cXml += "</gPerecimento>"

Return ::cXml

//-------------------------------------------------------------------
/*/{Protheus.doc} SchemaXMLEvents::XmlEvent112140
Método para montar a string do XML do Evento 112140
Evento: Fornecimento não realizado com pagamento antecipado

@type method
@version 1.0
@author Misael Ramos
@since 29/10/2025
@param cItem, character, Corresponde ao atributo "nItem" do elemento "det" do documento referenciado
@param cVIBS, character, Valor do IBS na nota de débito de pagamento antecipado correspondente à quantidade que não foi fornecida
@param cVCBS, character, Valor da CBS na nota de débito de pagamento antecipado correspondente à quantidade que não foi fornecida
@param cQNaoFornecida, character, Informar a quantidade que não foi fornecida e teve o imposto antecipado
@param cUNaoFornecida, character, Informar a unidade relativa ao campo qNaoFornecida
@return character, Retorna a string do XML do Evento 112140
/*/
//-------------------------------------------------------------------
Method XmlEvent112140(cItem as character, cVIBS as character, cVCBS as character, cQNaoFornecida as character, cUNaoFornecida as character) as character Class SchemaXMLEvents
	
	::cXml := ''

	::cXml += '<gItemNaoFornecido nItem="'+cItem+'">'
	::cXml += "<vIBS>"+cVIBS+"</vIBS>"
	::cXml += "<vCBS>"+cVCBS+"</vCBS>"
	::cXml += "<gControleEstoque>"
	::cXml += "<qNaoFornecida>"+cQNaoFornecida+"</qNaoFornecida>"
	::cXml += "<uNaoFornecida>"+cUNaoFornecida+"</uNaoFornecida>"
	::cXml += "</gControleEstoque>"
	::cXml += "</gItemNaoFornecido>"

Return ::cXml

//-------------------------------------------------------------------
/*/{Protheus.doc} SchemaXMLEvents::XmlEvent112150
Método para montar a string do XML do Evento 112150
Evento: Atualização da data de previsão de entrega

@type method
@version 1.0
@author Misael Ramos
@since 29/10/2025
@param cDPrevEntrega, character, Data da previsão de entrega ou disponibilização do bem. Formato: "AAAA-MM-DD"
@return character, Retorna a string do XML do Evento 112150
/*/
//-------------------------------------------------------------------
Method XmlEvent112150(cDPrevEntrega as character) as character Class SchemaXMLEvents

	::cXml += "<dPrevEntrega>"+cDPrevEntrega+"</dPrevEntrega>"

Return ::cXml

//-------------------------------------------------------------------
/*/{Protheus.doc} SchemaXMLEvents::XmlEvent211110
Método para montar a string do XML do Evento 211110
Evento: Solicitação de apropriação de crédito presumido

@type method
@version 1.0
@author Misael Ramos
@since 29/10/2025
@param cItem, character, Corresponde ao atributo "nItem" do elemento "det" do documento referenciado
@param cVBC, character, Valor do base de cálculo do item
@param cCCredPresIBS, character, Usar tabela Cred Presumido, para o emitente da nota
@param cPCredPresIBS, character, Percentual do Crédito Presumido
@param cVCredPresIBS, character, Valor do Crédito Presumido
@param cCCredPresCBS, character, Usar tabela Cred Presumido, para o emitente da nota
@param cPCredPresCBS, character, Percentual do Crédito Presumido
@param cVCredPresCBS, character, Valor do Crédito Presumido
@return character, Retorna a string do XML do Evento 211110
/*/
//-------------------------------------------------------------------
Method XmlEvent211110(cItem as character, cVBC as character, cCCredPresIBS as character, cPCredPresIBS as character, cVCredPresIBS as character, cCCredPresCBS as character, cPCredPresCBS as character, cVCredPresCBS as character) as character Class SchemaXMLEvents

	::cXml := '' 

	::cXml += '<gCredPres nItem="'+cItem+'">'
	::cXml += "<vBC>"+cVBC+"</vBC>"
	::cXml += "<gIBS>"
	::cXml += "<cCredPres>"+IIF(Len(Alltrim(cCCredPresIBS)) == 1, "0" + cCCredPresIBS, cCCredPresIBS)+"</cCredPres>"
	::cXml += "<pCredPres>"+cPCredPresIBS+"</pCredPres>"
	::cXml += "<vCredPres>"+cVCredPresIBS+"</vCredPres>"
	::cXml += "</gIBS>"
	::cXml += "<gCBS>"
	::cXml += "<cCredPres>"+IIF(Len(Alltrim(cCCredPresCBS)) == 1, "0" + cCCredPresCBS, cCCredPresCBS)+"</cCredPres>"
	::cXml += "<pCredPres>"+cPCredPresCBS+"</pCredPres>"
	::cXml += "<vCredPres>"+cVCredPresCBS+"</vCredPres>"
	::cXml += "</gCBS>"
	::cXml += "</gCredPres>"

Return ::cXml

//-------------------------------------------------------------------
/*/{Protheus.doc} SchemaXMLEvents::XmlEvent211120
Método para montar a string do XML do Evento 211120
Evento: Destinação de item para consumo pessoal

@type method
@version 1.0
@author Misael Ramos
@since 29/10/2025
@param cItem, character, Corresponde ao atributo "nItem" do elemento "det" do documento referenciado
@param cVIBS, character, Valor do IBS na nota de aquisição correspondente à quantidade destinada a uso e consumo pessoal
@param cVCBS, character, Valor da CBS na nota de aquisição correspondente à quantidade destinada a uso e consumo pessoal
@param cQConsumo, character, Informar a quantidade para consumo de pessoa física
@param cUConsumo, character, Informar a unidade relativa ao campo gConsumo
@param cChaveAcesso, character, Informar a chave da nota (NFe ou NFCe) emitida para o fornecimento nos casos em que a legislação obriga a emissão de documento fiscal
@param cNItemRef, character, Corresponde ao atributo "nItem" do elemento "det" do documento referenciado
@return character, Retorna a string do XML do Evento 211120
/*/
//-------------------------------------------------------------------
Method XmlEvent211120(cItem as character, cVIBS as character, cVCBS as character, cQConsumo as character, cUConsumo as character, cChaveAcesso as character, cNItemRef as character) as character Class SchemaXMLEvents

	::cXml := ''

	::cXml += '<gConsumo nItem="'+cItem+'">'
	::cXml += "<vIBS>"+cVIBS+"</vIBS>"
	::cXml += "<vCBS>"+cVCBS+"</vCBS>"
	::cXml += "<gControleEstoque>"
	::cXml += "<qConsumo>"+cQConsumo+"</qConsumo>"
	::cXml += "<uConsumo>"+cUConsumo+"</uConsumo>"
	::cXml += "</gControleEstoque>"
	::cXml += "<DFeReferenciado>"
	::cXml += "<chaveAcesso>"+cChaveAcesso+"</chaveAcesso>"
	::cXml += "<nItem>"+ LTrim(Str(Val(cNItemRef))) +"</nItem>"
	::cXml += "</DFeReferenciado>"
	::cXml += "</gConsumo>"

Return ::cXml

//-------------------------------------------------------------------
