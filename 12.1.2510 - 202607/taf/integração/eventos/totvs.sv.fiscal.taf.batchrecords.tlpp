#include "msobject.ch"
#include "totvs.framework.treports.integratedprovider.th"
#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "totvs.sv.fiscal.taf.batchrecords.ch"

namespace totvs.protheus.fiscal.taf.treportsintegratedprovider
@totvsFrameworkTReportsIntegratedProvider(active=.T.,team="SIGATAF", tables="T7I, T7A, T7D, T7E, C20, C1H, C35", name="TafBatchEventRecordsSmartViewBusinessObject", country="BRA", initialRelease="12.1.2410")

//-------------------------------------------------------------------
/*{Protheus.doc}  TafBatchEventRecordsSmartViewBusinessObject
Classe para criacao do objeto de negocio Smart View de registros de eventos por lote
@author Evandro Italo
@since 27/05/2026
*/
//-------------------------------------------------------------------
class TafBatchEventRecordsSmartViewBusinessObject from totvs.framework.treports.integratedprovider.IntegratedProvider

	public method new() as object
	public method getData() as object
	public method getSchema() as object

endclass

//-------------------------------------------------------------------
/*{Protheus.doc} new
Metodo de instancia da classe
@return object: self
@author Evandro Italo
@since 27/05/2026
*/
//-------------------------------------------------------------------
method new() as object class TafBatchEventRecordsSmartViewBusinessObject

	_Super:new()

	self:appendArea(STR0001) //"TAF Fiscal"
	self:setDisplayName(STR0002) //"Registros de eventos por lote"
	self:setDescription(STR0003) //"Objeto de negocio Smart View para consulta de registros de eventos por lote"

return self

//-------------------------------------------------------------------
/*{Protheus.doc} getData
Retorna os dados do objeto de negocio
@param nPage, numerico, indica a pagina atual do relatorio
@param oFilter, objeto, contem o filtro do Smart View
@return object: self:oData
@author Evandro Italo
@since 27/05/2026
*/
//-------------------------------------------------------------------
method getData(nPage as numeric, oFilter as object) as object class TafBatchEventRecordsSmartViewBusinessObject

	Local cQuery       := ""  as Character
	Local aCbsCodes    := {"000031", "000032", "000033"} as Array
	Local aIbsCodes    := {"000042", "000043", "000044", "000045", "000046", "000047", "000048", "000049"} as Array
	Local cBatchDate   := ""  as Character
	Local cEventCode   := ""  as Character
	Local cSequence    := ""  as Character
	Local jParams      := Nil as Json
	Local oPrepare     := Nil as Object
	Local nParam       := 1   as Numeric

	self:setPageSize(200)
	self:setOrder("C20.C20_TPDOC, C20.C20_NUMDOC")
	jParams := oFilter:getParameters()

	If jParams <> Nil
		If !Empty(jParams["01"][1])
			cEventCode := AllTrim(cValToChar(jParams["01"][1]))
		EndIf

		If !Empty(jParams["02"][1])
			cBatchDate := AllTrim(cValToChar(jParams["02"][1]))
		EndIf

		If !Empty(jParams["03"][1])
			cSequence := AllTrim(cValToChar(jParams["03"][1]))
		EndIf
	EndIf

	cQuery += " SELECT C20.C20_TPDOC TIPO_DOCUMENTO, "
	cQuery += "        C20.C20_NUMDOC NUMERO_DOCUMENTO, "
	cQuery += "        C20.C20_SERIE SERIE_DOCUMENTO, "
	cQuery += "        COALESCE(C1H.C1H_CNPJ, C1H.C1H_CPF) CNPJ_CPF, "
	cQuery += "        C1H.C1H_NOME RAZAO_SOCIAL, "
	cQuery += "        T7A.T7A_TPEVEN TPEVENTO, "
	cQuery += "        T7E.T7E_DESCRI DESCRICAO_EVENTO, "
	cQuery += "        T7A.T7A_DTEMIS DATA_ENVIO, "
	cQuery += "        T7A.T7A_TPAUT TIPO_AUTOR, "
	cQuery += "        T7I.T7I_USRINC USUARIO, "
	cQuery += "        T7I.T7I_STATUS STATUS_LOTE, "
	cQuery += "        T7D.T7D_DATA DATA_RETORNO, "
	cQuery += "        CBSQ.CBS CBS, "
	cQuery += "        IBSQ.IBS IBS "
	cQuery += " FROM " + RetSqlName('C20') + " C20 "
	cQuery += " LEFT JOIN ( "
	cQuery += "        SELECT C35.C35_FILIAL C35_FILIAL, "
	cQuery += "               C35.C35_CHVNF C35_CHVNF, "
	cQuery += "               SUM(C35.C35_VALOR) CBS "
	cQuery += "          FROM " + RetSqlName('C35') + " C35 "
	cQuery += "         WHERE C35.C35_CODTRI IN (?) "
	cQuery += "           AND C35.D_E_L_E_T_ = ? "
	cQuery += "         GROUP BY C35.C35_FILIAL, C35.C35_CHVNF "
	cQuery += " ) CBSQ ON CBSQ.C35_FILIAL = C20.C20_FILIAL "
	cQuery += "       AND CBSQ.C35_CHVNF = C20.C20_CHVNF "
	cQuery += " LEFT JOIN ( "
	cQuery += "        SELECT C35.C35_FILIAL C35_FILIAL, "
	cQuery += "               C35.C35_CHVNF C35_CHVNF, "
	cQuery += "               SUM(C35.C35_VALOR) IBS "
	cQuery += "          FROM " + RetSqlName('C35') + " C35 "
	cQuery += "         WHERE C35.C35_CODTRI IN (?) "
	cQuery += "           AND C35.D_E_L_E_T_ = ? "
	cQuery += "         GROUP BY C35.C35_FILIAL, C35.C35_CHVNF "
	cQuery += " ) IBSQ ON IBSQ.C35_FILIAL = C20.C20_FILIAL "
	cQuery += "       AND IBSQ.C35_CHVNF = C20.C20_CHVNF "
	cQuery += " INNER JOIN " + RetSqlName('C1H') + " C1H ON " + FwJoinFilial('C1H', 'C20') + " "
	cQuery += "    AND C1H.C1H_ID = C20.C20_CODPAR "
	cQuery += "    AND C1H.D_E_L_E_T_ = ? "
	cQuery += " INNER JOIN " + RetSqlName('T7A') + " T7A ON " + FwJoinFilial('T7A', 'C20') + " "
	cQuery += "    AND T7A.T7A_CHVNF = C20.C20_CHVNF "
	cQuery += "    AND T7A.D_E_L_E_T_ = ? "
	cQuery += " INNER JOIN " + RetSqlName('T7I') + " T7I ON " + FwJoinFilial('T7I', 'T7A') + " "
	cQuery += "    AND T7I.T7I_EVENTO = T7A.T7A_TPEVEN "
	cQuery += "    AND T7I.T7I_DTINC = T7A.T7A_DTEMIS "
	cQuery += "    AND T7I.T7I_SEQUEN = T7A.T7A_SEQLOT "
	cQuery += "    AND T7I.D_E_L_E_T_ = ? "
	cQuery += " LEFT JOIN " + RetSqlName('T7D') + " T7D ON " + FwJoinFilial('T7D', 'T7A') + " "
	cQuery += "    AND T7D.T7D_IDENT = T7A.T7A_IDENT "
	cQuery += "    AND T7D.D_E_L_E_T_ = ? "
	cQuery += " LEFT JOIN " + RetSqlName('T7E') + " T7E ON T7A.T7A_TPEVEN = T7E.T7E_EVENTO "
	cQuery += "    AND T7E.D_E_L_E_T_ = ? "
	cQuery += " WHERE C20.D_E_L_E_T_ = ? "
	cQuery += "   AND T7A.T7A_FILIAL = ? "
	cQuery += "   AND T7A.T7A_TPEVEN = ? "
	cQuery += "   AND T7A.T7A_DTEMIS = ? "
	cQuery += "   AND T7A.T7A_SEQLOT = ? "

	oPrepare := FWPreparedStatement():New(ChangeQuery(cQuery))

	oPrepare:SetIn(nParam++, aCbsCodes)
	oPrepare:SetString(nParam++, Space(1))
	oPrepare:SetIn(nParam++, aIbsCodes)
	oPrepare:SetString(nParam++, Space(1))
	oPrepare:SetString(nParam++, Space(1))
	oPrepare:SetString(nParam++, Space(1))
	oPrepare:SetString(nParam++, Space(1))
	oPrepare:SetString(nParam++, Space(1))
	oPrepare:SetString(nParam++, Space(1))
	oPrepare:SetString(nParam++, Space(1))
	oPrepare:SetString(nParam++, FWxFilial('T7A'))
	oPrepare:SetString(nParam++, cEventCode)
	oPrepare:SetString(nParam++, cBatchDate)
	oPrepare:SetString(nParam++, cSequence)

	cQuery := oPrepare:GetFixQuery()

	self:setQuery(cQuery)

	FwFreeObj(oPrepare)

return self:oData

//-------------------------------------------------------------------
/*{Protheus.doc} getSchema
Retorna a estrutura dos campos
@return object: self:oSchema
@author Evandro Italo
@since 27/05/2026
*/
//-------------------------------------------------------------------
method getSchema() as object class TafBatchEventRecordsSmartViewBusinessObject

	self:addProperty("TIPO_DOCUMENTO"   , STR0004    , "string" , STR0004    , "TIPO_DOCUMENTO"   )	// "Tipo Documento"
	self:addProperty("NUMERO_DOCUMENTO" , STR0005    , "string" , STR0005    , "NUMERO_DOCUMENTO" )	// "Numero Documento"
	self:addProperty("SERIE_DOCUMENTO"  , STR0006    , "string" , STR0006    , "SERIE_DOCUMENTO"  )	// "Serie Documento"
	self:addProperty("CNPJ_CPF"         , "CNPJ/CPF" , "string" , "CNPJ/CPF" , "CNPJ_CPF"         )	//
	self:addProperty("RAZAO_SOCIAL"     , STR0007    , "string" , STR0007    , "RAZAO_SOCIAL"     )	// "Razao Social"
	self:addProperty("TPEVENTO"         , STR0008    , "string" , STR0008    , "TPEVENTO"         )	//"Evento"
	self:addProperty("DESCRICAO_EVENTO" , STR0009    , "string" , STR0009    , "DESCRICAO_EVENTO" )	//"Descricao Evento"
	self:addProperty("DATA_ENVIO"       , STR0010    , "date"   , STR0010    , "DATA_ENVIO"       )	//"Data Envio"
	self:addProperty("TIPO_AUTOR"       , STR0011    , "string" , STR0011    , "TIPO_AUTOR"       )	//"Tipo Autor"
	self:addProperty("USUARIO"          , STR0012    , "string" , STR0012    , "USUARIO"          )	//"Usuario"
	self:addProperty("STATUS_LOTE"      , STR0013    , "string" , STR0013    , "STATUS_LOTE"      )	//"Status Lote"
	self:addProperty("DATA_RETORNO"     , STR0014    , "date"   , STR0014    , "DATA_RETORNO"     )	//"Data Retorno"
	self:addProperty("CBS"              , "CBS"      , "number" , "CBS"      , "CBS"              )	//
	self:addProperty("IBS"              , "IBS"      , "number" , "IBS"      , "IBS"              )	//

	self:addParameter("01", "Evento", "string", .F., "", .F., .F., "", "event") //"Evento     	:",,,,,.F.
	self:addParameter("02", "Data"	, "string", .F., "", .F., .F., "", "dateEvent") //"Data     	:"
	self:addParameter("03", "Lote"  , "string", .F., "", .F., .F., "", "batchEvent") //"Lote     	:"

return self:oSchema
