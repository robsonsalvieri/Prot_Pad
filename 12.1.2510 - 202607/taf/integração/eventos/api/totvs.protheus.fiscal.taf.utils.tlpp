#include 'totvs.protheus.fiscal.taf.utils.ch'

namespace totvs.protheus.fiscal.taf.event

/*/{Protheus.doc} Utils
	Classe de utilidades
@author juan.felipe
@since 03/10/2025
/*/
Class Utils
    public Method New()
    public Method getPageAndPageSize()
    public Method getQueryParam()
    public Method queryRequestToArray()
    public Method validateRequirements()
    public Method setAPIResponse()
    public Method setClassResponse()
    public Method validateQueryParams()
	public Method getFieldLength() as numeric
    public Method getFieldDecimal() as numeric
    public Method formatItemsSQL() as character
	public Method getTabIbs() as character
    public Method getTabCbs() as character
    public Method validateRequestBody() As Logical
    public Method getSafeProperty() As Variant
EndClass

/*/{Protheus.doc} New
	Método construtor
@author juan.felipe
@since 03/10/2025
/*/
Method New() Class Utils
Return Self

//----------------------------------------------------------------------------
/*/{Protheus.doc} getPageAndPageSize
    Retorna o valor dos Parametros Page e PageSize.
@author juan.felipe
@since 03/10/2025
@param nPage, numeric, numero da Pagina.
@param nPageSize, numeric, quantidade de registro na pagina.
@return Nil, nulo.
/*/
//---------------------------------------------------------------------------
Method getPageAndPageSize(nPage, nPageSize) Class Utils
    nPage := 1
    nPageSize := 10

	If (oRest:getQueryRequest():GetJsonText('pageSize') != 'null')
		nPageSize := Val(oRest:getQueryRequest():GetJsonText('pageSize'))
	EndIf

	If (oRest:getQueryRequest():GetJsonText('page') != 'null')
		nPage := Val(oRest:getQueryRequest():GetJsonText('page'))
	Endif
Return Nil

//----------------------------------------------------------------------------
/*/{Protheus.doc} getFields
    Retorna o valor do Query Param.
@author juan.felipe
@since 03/10/2025
@return cFields, character, campos a serem retornados
/*/
//---------------------------------------------------------------------------
Method getQueryParam(cParamName) Class Utils
    Local cParamText As Character
    
    cParamText := ""

    If (oRest:getQueryRequest():GetJsonText(cParamName) != 'null')
		cParamText := oRest:getQueryRequest():GetJsonText(cParamName)
	EndIf
Return cParamText

//----------------------------------------------------------------------------
/*/{Protheus.doc} getPageAndPageSize
    Converte Json getQueryRequest da classe oRest, para um array compatível
com o método SetUrlFilter da classe FWAdapterBaseV2
@author juan.felipe
@since 03/10/2025
@param oJsonQuery, json, json queryRequest.
@return aJsonArray, array, json convertido em array.
/*/
//---------------------------------------------------------------------------
Method queryRequestToArray(oJsonQuery) Class Utils
    Local aJsonNames As Array 
    Local aJsonArray As Array 
    Local cName      As Character
    Local cFilter    As Character
    Local nX         As Numeric

    aJsonNames := oJsonQuery:GetNames()
    aJsonArray := {}

    If ValType(aJsonNames) == "A" .And. ValType(oJsonQuery) == "J"
        For nX := 1 To Len(aJsonNames)
            cName := Lower(aJsonNames[nX])
            If !cName $ 'pagesize|page' .And. !Empty(oJsonQuery[aJsonNames[nX]])
                If cName == 'filter' .Or. cPaisLoc == 'RUS'
                    cFilter := FWURIDecode(oJsonQuery[aJsonNames[nX]])
                    Aadd(aJsonArray, {aJsonNames[nX], DecodeUTF8(cFilter)})
                Else
                    Aadd(aJsonArray, {aJsonNames[nX], oJsonQuery[aJsonNames[nX]]})
                EndIf
            EndIf
        Next nX
    EndIf
Return aJsonArray

/*/{Protheus.doc} validateRequirements
	Valida requisitos mínimos para executar as APIs.
@author juan.felipe
@since 04/10/2025
@param oJsonResponse, object, response de validação do body (retorno por referência).
@return lOk, logical, body convertido com sucesso.
/*/
Method validateRequirements(oJsonResponse) Class Utils
    Local lOk As Logical
    Default oJsonResponse := JsonObject():New()

    oJsonResponse := JsonObject():New()
    lOk := .T.

    If !FwAliasInDic('T7A') .Or. !FwAliasInDic('T7B') .Or. !FwAliasInDic('T7C') .Or. !FwAliasInDic('T7D') .Or. !FwAliasInDic('T7E')
        oJsonResponse := Self:setClassResponse(400, STR0001) //-- Para execução correta do Monitor de Eventos, é necessário que seja aplicada a última expedição contínua disponível no portal.
        lOk := .F.
    EndIf
Return lOk

/*/{Protheus.doc} setAPIResponse
	Seta resposta da API.
@author juan.felipe
@since 03/10/2025
@param oRest, object, objeto rest do TLPP.
@param xJsonResponse, json or character, resposta a ser retornada pela API.
@param lOk, logical, retorna erro ou respota ok.
@param nCode, numeric, código de erro.
@param cErrorMessage, character, retorna erro ou respota ok.
@return Nil, nulo.
/*/
Method setAPIResponse(oRest, xJsonResponse, lOk, nCode) Class Utils
    Local cJsonResponse As Character
    
    Default oRest := Nil
    Default xJsonResponse := Nil
    Default lOk := .F.
    Default nCode := 0

    If oRest <> Nil .And. xJsonResponse <> Nil
        oRest:setKeyHeaderResponse("Content-Type", "application/json")

        cJsonResponse := Iif(ValType(xJsonResponse) == 'J', xJsonResponse:ToJson(), xJsonResponse)

        If lOk
            oRest:SetResponse(cJsonResponse)
        Else
            oRest:SetStatusCode(nCode)
            oRest:SetResponse(cJsonResponse)
        EndIf
    EndIf
Return Nil

/*/{Protheus.doc} setClassResponse
	Seta resposta da classe.
@author juan.felipe
@since 03/10/2025
@param nCode, numeric, código da resposta.
@param cMessage, character, mensagem da resposta.
@param oModel, object, modelo de dados.
@return oJsonResponse, object, json de resposta.
/*/
Method setClassResponse(nCode, cMessage, cMessageDetail) Class Utils
    Local oJsonResponse As Object
    Default nCode := 0
    Default cMessage := ''
    Default cMessageDetail := ''

    oJsonResponse := JsonObject():New()
    
    oJsonResponse['code'] := nCode
    oJsonResponse['message'] := FWHttpEncode(cMessage)
    oJsonResponse['detailedMessage'] := FWHttpEncode(cMessageDetail)
Return oJsonResponse

/*/{Protheus.doc} validateQueryParams
	Valida query params da API
@author juan.felipe
@since 10/11/2025
@param oJsonResponse, object, json da resposta.
@param oJsonQuery, object, json dos query params.
@param cRequiredNames, character, nomes dos parâmetros obrigatórios separados por vírgula.
@return lOk, logical, parâmetros válidos.
/*/
Method validateQueryParams(oJsonResponse, oJsonQuery, cRequiredNames) Class Utils
    Local lOk As Logical
    Local cMessage As Character
    Local cMessageDetail As Character
    Local nCode As Numeric
    Local nX As Numeric
    Local aNames As Array
    Default oJsonResponse := JsonObject():New()
    Default oJsonQuery := JsonObject():New()
    Default cRequiredNames := ''

    lOk := .T.
    nCode := 200

    If !Empty(cRequiredNames)
        aNames := StrTokArr(cRequiredNames, ',')

        For nX := 1 To Len(aNames)
            If ValType(oJsonQuery:GetJsonObject(aNames[nX])) == "U"
                cMessage := STR0002 + aNames[nX] + STR0003 //-- O parâmetro XXXX é obrigatório e não foi informado.
                cMessageDetail := STR0004 + aNames[nX] //-- Informar.
                nCode := 400
                lOk := .F.
                Exit
            EndIf
        Next nX

        oJsonResponse := Self:setClassResponse(nCode, cMessage, cMessageDetail)//-- Parâmetros de consulta inválidos. Verifique a documentação da API para mais detalhes.
        FwFreeArray(aNames)
    EndIf
Return lOk

//-----------------------------------------------------------------------
/*/{Protheus.doc} GetFieldLength
Funcao que obtem o tamanho do campo a partir do cache SX3

@type function
@version 1.0
@author Misael Ramos
@since 14/11/2025
@param cField, character, Nome do campo
@return numeric, Tamanho do campo
/*/
//-----------------------------------------------------------------------
Method getFieldLength(cField as character) as numeric Class Utils

    Local nLength as Numeric

    nLength := FWSX3Util():GetFieldStruct(cField)[3]

Return nLength

//-----------------------------------------------------------------------
/*/{Protheus.doc} GetFieldDecimal
Funcao que obtem a quantidade de casas decimais do campo a partir do cache SX3

@type function
@version 1.0
@author Misael Ramos
@since 14/11/2025
@param cField, character, Nome do campo
@return numeric, Quantidade de casas decimais do campo
/*/
//-----------------------------------------------------------------------
Method getFieldDecimal(cField as character) as numeric Class Utils

    Local nDecimal as Numeric

    nDecimal := FWSX3Util():GetFieldStruct(cField)[4]

Return nDecimal



//------------------------------------------------------------------------------
/*/{Protheus.doc} formatItems
Funcao responsavel por formatar os items para uso em clausula SQL IN

@type method
@version 1.0
@author Misael Ramos
@since 14/11/2025
@param cItems, character, items separados por virgula (ex: "A1002,A1001,A1003")
@return character, retorna os items formatados com aspas simples (ex: "'A1002', 'A1001', 'A1003'")
/*/
//------------------------------------------------------------------------------
Method formatItemsSQL(cItems as character) as character Class Utils

	Local cFormattedItems := "" as character
	Local aItems := {} as array
	Local nI := 0 as numeric

    Default cItems := ""

	If !Empty(cItems)
        // Remove espaços e divide a string pelos separadores
        aItems := StrTokArr(AllTrim(cItems), ",")

        // Formata cada item com aspas simples
        For nI := 1 To Len(aItems)
            aItems[nI] := "'" + AllTrim(aItems[nI]) + "'"
        Next nI

        // Junta os items formatados com virgula e espaço
        cFormattedItems := Alltrim(aItems[1])
        For nI := 2 To Len(aItems)
            cFormattedItems += ", " + AllTrim(aItems[nI])
        Next nI
    EndIf

Return cFormattedItems

/*/{Protheus.doc} getTabIbs
	Monta a subquery para retornar os inner join com C35 ref ao IBS
@author Pâmela Bernardo
@since 20/11/2025
@param cChvnf, chave da NFE
@param cLisCodTri, Lista de C35_CODTRI deve ser considerada na busca
@return cQueryTributo, character, query que retorna inner join em uma tabela temporária de IBS.
/*/
Method getTabIbs(cChvnf as character, cLisCodTri as character) as character Class Utils
    Local cQueryTributo As Character
    Default cChvnf := ''
    Default cLisCodTri := "'000042', '000043', '000044', '000045', '000046', '000047', '000048', '000049'"

    cQueryTributo := "LEFT JOIN (SELECT C35.C35_VALOR IBS_VALOR, C35.C35_CHVNF IBS_CHVNF, "
    cQueryTributo += " C35.C35_FILIAL IBS_FILIAL, C35.C35_NUMITE IBS_NUMITE, C35.C35_CODTRI IBS_CODTRI, C35_BASE IBS_BASE "
    cQueryTributo += " FROM " + RetSqlName('C35') + " C35 "
    cQueryTributo += " WHERE C35.C35_FILIAL = '"+xFilial("C35")+"' AND "
    cQueryTributo += " C35.C35_CODTRI IN ("+cLisCodTri+") AND "
    cQueryTributo += " C35.C35_CHVNF = '"+cChvnf+"' AND "
    cQueryTributo += " C35.D_E_L_E_T_ = ' ' ) TABIBS ON "
	cQueryTributo += " TABIBS.IBS_FILIAL = C30.C30_FILIAL AND "
	cQueryTributo += " TABIBS.IBS_CHVNF = C30.C30_CHVNF AND "
	cQueryTributo += " TABIBS.IBS_NUMITE  = C30.C30_NUMITE "
    
Return cQueryTributo

/*/{Protheus.doc} getTabCbs
	Monta a subquery para retornar os inner join com C35 ref ao CBS
@author Pâmela Bernardo
@since 20/11/2025
@param cChvnf, chave da NFE
@param cLisCodTri, Lista de C35_CODTRI deve ser considerada na busca
@return cQueryTributo, character, query que retorna inner join em uma tabela temporária de CBS.
/*/
Method getTabCbs(cChvnf as character, cLisCodTri as character) as character Class Utils
    Local cQueryTributo As Character
    Default cChvnf := ''
    Default cLisCodTri := "'000031', '000032', '000033', '000039', '000040'"

    cQueryTributo := "LEFT JOIN (SELECT C35.C35_VALOR CBS_VALOR, C35.C35_CHVNF CBS_CHVNF,"
    cQueryTributo += " C35.C35_FILIAL CBS_FILIAL, C35.C35_NUMITE CBS_NUMITE, C35.C35_CODTRI CBS_CODTRI, C35_BASE CBS_BASE "
    cQueryTributo += " FROM " + RetSqlName('C35') + " C35 "
    cQueryTributo += " WHERE C35.C35_FILIAL = '"+xFilial("C35")+"' AND "
    cQueryTributo += " C35.C35_CODTRI IN ("+cLisCodTri+") AND "
    cQueryTributo += " C35.C35_CHVNF = '"+cChvnf+"' AND "
    cQueryTributo += " C35.D_E_L_E_T_ = ' ' ) TABCBS ON "
	cQueryTributo += " TABCBS.CBS_FILIAL = C30.C30_FILIAL AND "
	cQueryTributo += " TABCBS.CBS_CHVNF = C30.C30_CHVNF AND "
	cQueryTributo += " TABCBS.CBS_NUMITE  = C30.C30_NUMITE "

Return cQueryTributo

/*/{Protheus.doc} validateRequestBody
	Valida e converte para json o body da requisição.
@author juan.felipe
@since 18/11/2025
@param cBody, character, body da requisição.
@param jBody, object, body convertido em json (retorno por referência).
@param jResponse, object, response de validação do body (retorno por referência).
@return lOk, logical, body convertido com sucesso.
/*/
Method validateRequestBody(cBody As Character, jBody As Json, jResponse As Json) As Logical Class Utils
    Local lOk As Logical
    Local lConverted As Logical
    
    Default cBody := ''
    Default jBody := JsonObject():New()
    Default jResponse := JsonObject():New()

    lOk := .T.

    If !Empty(cBody) .And. cBody != '{}'
        cBody := DecodeUTF8(cBody)
        
        lConverted := jBody:FromJSON(cBody) == Nil

        If !lConverted
            jResponse := Self:setClassResponse(400, STR0005, STR0006) //-- Erro ao realizar conversão do json da requisição. Informe um json válido para realizar a requisição.
            lOk := .F.
        EndIf
    Else
        jResponse := Self:setClassResponse(400, STR0007, STR0006) //-- Json da requisição vazio. Informe um json válido para realizar a requisição.
        lOk := .F.
    EndIf
Return lOk

/*/{Protheus.doc} getSafeProperty
	Obtém uma propriedade de um json, retornando um valor padrão caso a propriedade não exista.
@author juan.felipe
@since 24/11/2025
@param jValues, object, json de onde a propriedade será obtida.
@param cProperty, character, nome da propriedade a ser obtida.
@param xDefault, variant, valor padrão caso a propriedade não exista.
@return xValue, variant, valor da propriedade ou valor padrão caso a propriedade não exista.

/*/
Method getSafeProperty(jValues As Json, cProperty As Character, xDefault As Variant) As Variant Class Utils
    Local xValue As Variant
    Default jValues := JsonObject():New()
    Default cProperty := ''
    Default xDefault := Nil

    xValue := xDefault

    If jValues:HasProperty(cProperty)
        xValue := jValues[cProperty]
    EndIf
Return xValue
