#include "protheus.ch"
#include "tlpp-core.th"
#include "tlpp-object.th"

namespace totvs.protheus.fiscal.taf.event

//-----------------------------------------------------------------------
/*/{Protheus.doc} EventsItemsProtheusData
Classe responsavel por gerenciar a obtencao dos items dos eventos de documentos fiscais

@type class
@version 1.0
@author Misael Ramos
@since 14/11/2025
/*/
//-----------------------------------------------------------------------
Class EventsItemsProtheusData From FWAdapterBaseV2

	protected data cCodTribCbs as character
	protected data cCodTribIbs as character
	protected data cCodCredCbs as character
	protected data cCodCredIbs as character
	protected data cUFEmitente as character
	protected data oUtil       as object

    public method new() as object
	public method setMapFields()
	public method getEventsItems()
	private Method getQuery() as character

EndClass

//-----------------------------------------------------------------------
/*/{Protheus.doc} EventsItemsProtheusData::New
Metodo responsavel por criar uma nova instancia da classe EventsItemsProtheusData

@type method
@version 1.0
@author Misael Ramos
@since 14/11/2025
@param cVerb, character, verbo da operacao
@return object, retorna a instancia da classe
/*/
//-----------------------------------------------------------------------
Method New(cVerb as character) as object Class EventsItemsProtheusData

	_Super:New(cVerb, .T.)

	::oUtil := totvs.protheus.fiscal.taf.event.Utils():New()

	::cCodTribCbs := "'000031', '000032', '000039', '000040'"
	::cCodTribIbs := "'000042', '000044', '000045', '000047', '000048', '000049'"
	::cCodCredCbs := "'000033'"
	::cCodCredIbs := "'000046'"
	::cUFEmitente := Alltrim(FWSM0Util():GetSM0Data(cEmpAnt,cFilAnt,{ "M0_ESTENT" })[1][2])

Return Self

//-----------------------------------------------------------------------
/*/{Protheus.doc} EventsItemsProtheusData::setMapFields
Metodo responsavel por chamar todos os mapeamentos de campos de acordo com a propriedade

@type method
@version 1.0
@author Misael Ramos
@since 14/11/2025
@param cTypeEvent, character, tipo do evento para definir os campos do Json a serem mapeados
@return Nil
/*/
//-----------------------------------------------------------------------
Method setMapFields(cTypeEvent as character) Class EventsItemsProtheusData

	Do Case
		Case cTypeEvent == "EVENT_MODEL_1"
			Self:AddMapFields("stateAuthor", 		"C09_UF", 	 	.T., .T., { "C09_UF",	  'C', ::oUtil:GetFieldLength('C09_UF'), 		0 })
			Self:AddMapFields("authorType", 		"T7E_AUTOR", 	.T., .T., { "T7E_AUTOR",  'C', ::oUtil:GetFieldLength('T7E_AUTOR'), 	0 }, " CASE WHEN T7E_AUTOR = '4' THEN '1' ELSE T7E_AUTOR END ")
		Case cTypeEvent == "EVENT_MODEL_2"
			Self:AddMapFields("item", 	   			"C30_ITEXML", 	.T., .T., { "C30_ITEXML", 'C', ::oUtil:GetFieldLength('C30_ITEXML'),  	0 })
			Self:AddMapFields("stateAuthor", 	   	"C09_UF", 		.T., .T., { "C09_UF", 	  'C', ::oUtil:GetFieldLength('C09_UF'),  	 	0 })
			Self:AddMapFields("taxValueCbs", 	  	"TAX_CBS", 		.T., .T., { "TAX_CBS", 	  'N', ::oUtil:GetFieldLength('C35_VALOR'),  	::oUtil:GetFieldDecimal('C35_VALOR') }," Coalesce(CBS_VALOR,0) ")
			Self:AddMapFields("taxValueIbs", 		"TAX_IBS", 		.T., .T., { "TAX_IBS", 	  'N', ::oUtil:GetFieldLength('C35_VALOR'),  	::oUtil:GetFieldDecimal('C35_VALOR') }, " Coalesce(IBS_VALOR,0) ")
			Self:AddMapFields("quantity", 		  	"C30_QTDXML ", 	.T., .T., { "C30_QTDXML ",'N', ::oUtil:GetFieldLength('C30_QTDXML'),	::oUtil:GetFieldDecimal('C30_QTDXML') })
			Self:AddMapFields("unit", 			  	"C1J_CODIGO",  	.T., .T., { "C1J_CODIGO", 'C', ::oUtil:GetFieldLength('C1J_CODIGO'), 	0 })
			Self:AddMapFields("authorType",			"T7E_AUTOR", 	.T., .T., { "T7E_AUTOR",  'C', ::oUtil:GetFieldLength('T7E_AUTOR'),  	0 }, " CASE WHEN T7E_AUTOR = '4' THEN '1' ELSE T7E_AUTOR END ")
			Self:AddMapFields("codTriCbs",			"CODTRICBS", 	.T., .T., { "CODTRICBS", 'C', ::oUtil:GetFieldLength('C35_CODTRI'), 	0 }, " Coalesce(CBS_CODTRI,' ') ")
			Self:AddMapFields("codTriIbs",			"CODTRIIBS", 	.T., .T., { "CODTRIIBS", 'C', ::oUtil:GetFieldLength('C35_CODTRI'), 	0 }, " coalesce(IBS_CODTRI,' ') ")
		Case cTypeEvent == "EVENT_MODEL_3"
			Self:AddMapFields("stateAuthor", 		"C09_UF",   	.T., .T., { "C09_UF",     'C', ::oUtil:GetFieldLength('C09_UF'), 	 	0 })
			Self:AddMapFields("authorType",			"T7E_AUTOR",  	.T., .T., { "T7E_AUTOR",  'C', ::oUtil:GetFieldLength('T7E_AUTOR'),  	0 })
		Case cTypeEvent == "EVENT_MODEL_4"
			Self:AddMapFields("item", 	   			"C30_ITEXML", 	.T., .T., { "C30_ITEXML", 'C', ::oUtil:GetFieldLength('C30_ITEXML'),  	0 })
			Self:AddMapFields("stateAuthor", 		"C09_UF",   	.T., .T., { "C09_UF",     'C', ::oUtil:GetFieldLength('C09_UF'), 	 	0 })
			Self:AddMapFields("taxValueCbs", 	  	"TAX_CBS", 		.T., .T., { "TAX_CBS", 	  'N', ::oUtil:GetFieldLength('C35_VALOR'),  	::oUtil:GetFieldDecimal('C35_VALOR') }," Coalesce(CBS_VALOR,0) ")
			Self:AddMapFields("taxValueIbs", 		"TAX_IBS", 		.T., .T., { "TAX_IBS", 	  'N', ::oUtil:GetFieldLength('C35_VALOR'),  	::oUtil:GetFieldDecimal('C35_VALOR') }, " Coalesce(IBS_VALOR,0) ")
			Self:AddMapFields("authorType",			"T7E_AUTOR",  	.T., .T., { "T7E_AUTOR",  'C', ::oUtil:GetFieldLength('T7E_AUTOR'),  	0 }, " CASE WHEN T7E_AUTOR = '4' THEN '1' ELSE T7E_AUTOR END ")
			Self:AddMapFields("codTriCbs",			"CODTRICBS", 	.T., .T., { "CODTRICBS", 'C', ::oUtil:GetFieldLength('C35_CODTRI'), 	0 }, " Coalesce(CBS_CODTRI,' ') ")
			Self:AddMapFields("codTriIbs",			"CODTRIIBS", 	.T., .T., { "CODTRIIBS", 'C', ::oUtil:GetFieldLength('C35_CODTRI'), 	0 }, " coalesce(IBS_CODTRI,' ') ")
		Case cTypeEvent == "EVENT_MODEL_5"
			Self:AddMapFields("item", 	   			"C30_ITEXML", 	.T., .T., { "C30_ITEXML", 'C', ::oUtil:GetFieldLength('C30_ITEXML'),  	0 })
			Self:AddMapFields("stateAuthor", 		"C09_UF",   	.T., .T., { "C09_UF",     'C', ::oUtil:GetFieldLength('C09_UF'), 	 	0 })
			Self:AddMapFields("creditValueIbs",		"CRED_IBS",  	.T., .T., { "CRED_IBS",   'N', ::oUtil:GetFieldLength('C35_VALOR'),  	::oUtil:GetFieldDecimal('C35_VALOR') }, " Coalesce(IBS_VALOR,0) ")
			Self:AddMapFields("creditValueCbs",		"CRED_CBS",  	.T., .T., { "CRED_CBS",   'N', ::oUtil:GetFieldLength('C35_VALOR'),  	::oUtil:GetFieldDecimal('C35_VALOR') }, " Coalesce(CBS_VALOR,0) ")
			Self:AddMapFields("baseCreditPresumed",	"C35_BASE",  	.T., .T., { "C35_BASE",   'N', ::oUtil:GetFieldLength('C35_BASE'), 	 	::oUtil:GetFieldDecimal('C35_BASE')  }, GetValorTrib())
			Self:AddMapFields("authorType",			"T7E_AUTOR",  	.T., .T., { "T7E_AUTOR",  'C', ::oUtil:GetFieldLength('T7E_AUTOR'),  	0 }, " CASE WHEN T7E_AUTOR = '4' THEN '1' ELSE T7E_AUTOR END ")
			Self:AddMapFields("codTriCbs",			"CODTRICBS", 	.T., .T., { "CODTRICBS", 'C', ::oUtil:GetFieldLength('C35_CODTRI'), 	0 }, " Coalesce(CBS_CODTRI,' ') ")
			Self:AddMapFields("codTriIbs",			"CODTRIIBS", 	.T., .T., { "CODTRIIBS", 'C', ::oUtil:GetFieldLength('C35_CODTRI'), 	0 }, " coalesce(IBS_CODTRI,' ') ")
		Case cTypeEvent == "EVENT_MODEL_6"
			Self:AddMapFields("stateAuthor", 		"C09_UF",   	.T., .T., { "C09_UF",     'C', ::oUtil:GetFieldLength('C09_UF'), 	 	0 }, " '" + ::cUFEmitente + "' ")
			Self:AddMapFields("deliveryDate",		"C20_PRVENT",  	.T., .T., { "C20_PRVENT", 'D', ::oUtil:GetFieldLength('C20_PRVENT'), 	0 })
			Self:AddMapFields("authorType",			"T7E_AUTOR",  	.T., .T., { "T7E_AUTOR",  'C', ::oUtil:GetFieldLength('T7E_AUTOR'),  	0 }, " CASE WHEN T7E_AUTOR = '4' THEN '1' ELSE T7E_AUTOR END ")
	EndCase

Return Nil

//-----------------------------------------------------------------------
/*/{Protheus.doc} EventsItemsProtheusData::getEventsItems
Metodo responsavel por obter os items de eventos de documentos fiscais

@type method
@version 1.0
@author Misael Ramos
@since 14/11/2025
@param cTypeEvent, character, tipo do evento para montagem da query e mapear os campos do Json
@param cEvent, character, codigo do evento do documento fiscal
@param cChvnf, character, chave do documento fiscal
@param cItems, character, items do documento fiscal
@param cBranch, character, filial do evento
/*/
//-----------------------------------------------------------------------
Method getEventsItems(cTypeEvent as character, cEvent as character, cChvnf as character, cItems as character) Class EventsItemsProtheusData

	Local aArea		  	:= GetArea() as array
	Local cQuery 	  	:= "" as character
	Local cWhere 	  	:= "" as character
	Local cOrderQuery 	:= "" as character
	Local cFormatItems 	:= "" as character

	Default cItems := ""

	If !Empty(cItems)
		cFormatItems := Self:oUtil:FormatItemsSQL(cItems)
	EndIf

	cQuery := Self:getQuery(cTypeEvent, cEvent, cChvnf)
	cWhere := getFilterEventsDocuments(cChvnf, cFormatItems)
	cOrderQuery := getOrderEventsDocuments()

	Self:setMapFields(cTypeEvent)
	Self:setPage(1)
	Self:setPageSize(1000)
	Self:SetQuery(cQuery)
	Self:SetWhere(cWhere)
	Self:SetOrder(cOrderQuery)
	Self:SetIsCaseSensitive(.T.)
	Self:SetUseSpaces(.T.)

	If Self:Execute()
		Self:FillGetResponse()
	EndIf

	RestArea(aArea)
	FWFreeObj(aArea)

Return Nil

//-----------------------------------------------------------------------
/*/{Protheus.doc} getQuery
Funcao que constroi a query SQL para obtencao dos eventos de documentos fiscais

@type function
@version 1.0
@author Misael Ramos
@since 06/11/2025
@param cTypeEvent, character, tipo do evento para montagem da query
@param cEvent, character, codigo do evento para filtro na T7E
@param cChvnf, chave da NF
@return character, Retorna a query SQL
/*/
//-----------------------------------------------------------------------
Method getQuery(cTypeEvent as character, cEvent as character, cChvnf as character) as character Class EventsItemsProtheusData

	Local cQuery := "" as character

	Do Case
		Case cTypeEvent == "EVENT_MODEL_1"
			cQuery := "SELECT #QueryFields# "
			cQuery += " FROM " + RetSqlName("C20") + " C20 "
			cQuery += "INNER JOIN " + RetSqlName("C09") + " C09 "
			cQuery += " ON  C09.C09_FILIAL = '" + FwXFilial("C09") + "'"
			cQuery += " AND C09.C09_ID	   = C20.C20_UF "
			cQuery += "	AND C09.D_E_L_E_T_ = ' ' "
			cQuery += "INNER JOIN " + RetSqlName("T7E") + " T7E "
			cQuery += " ON  T7E.T7E_FILIAL = '" + FwXFilial("T7E") + "'"
			cQuery += " AND T7E.T7E_EVENTO = '" + cEvent + "'"
			cQuery += " AND T7E.D_E_L_E_T_ = ' ' "
			cQuery += "WHERE #QueryWhere# "
		Case cTypeEvent == "EVENT_MODEL_2"
			cQuery := "SELECT #QueryFields# "
			cQuery += " FROM " 	+ RetSqlName("C20") + " C20 "
			cQuery += "INNER JOIN " + RetSqlName("C09") + " C09 "
			cQuery += " ON  C09.C09_FILIAL = '" + FwXFilial("C09") + "'" 
			cQuery += " AND C09.C09_ID	   = C20.C20_UF "
			cQuery += "	AND C09.D_E_L_E_T_ = ' ' "
			cQuery += "INNER JOIN " + RetSqlName("C30") + " C30 "
			cQuery += " ON  C30.C30_FILIAL = '" + FwXFilial("C30") + "'"
			cQuery += " AND C30.C30_CHVNF  = C20.C20_CHVNF "
			cQuery += "	AND C30.D_E_L_E_T_ = ' ' "
			cQuery += "INNER JOIN "  + RetSqlName("C1J") + " C1J "
			cQuery += "	ON  C1J.C1J_FILIAL = '" + FwXFilial("C1J") + "'"
			cQuery += "	AND C1J.C1J_ID     = C30.C30_UMXML "
			cQuery += "	AND C1J.D_E_L_E_T_ = ' ' "
			cQuery += "INNER JOIN " + RetSqlName("T7E") + " T7E "
			cQuery += " ON  T7E.T7E_FILIAL = '" + FwXFilial("T7E") + "'"
			cQuery += " AND T7E.T7E_EVENTO = '" + cEvent + "'"
			cQuery += " AND T7E.D_E_L_E_T_ = ' ' "
			cQuery += SELF:oUtil:getTabIbs(cChvnf, ::cCodTribIbs )
        	cQuery += SELF:oUtil:getTabCbs(cChvnf, ::cCodTribCbs)
			cQuery += "WHERE #QueryWhere# "
		Case cTypeEvent == "EVENT_MODEL_3"
			cQuery := "SELECT #QueryFields# "
			cQuery += " FROM " + RetSqlName("C20") + " C20 "
			cQuery += "INNER JOIN " + RetSqlName("C09") + " C09 "
			cQuery += " ON  C09.C09_FILIAL = '" + FwXFilial("C09") + "'"
			cQuery += " AND C09.C09_ID	   = C20.C20_UF "
			cQuery += "	AND C09.D_E_L_E_T_ = ' ' "
			cQuery += "INNER JOIN " + RetSqlName("T7E") + " T7E "
			cQuery += " ON  T7E.T7E_FILIAL = '" + FwXFilial("T7E") + "'"
			cQuery += " AND T7E.T7E_EVENTO = '" + cEvent + "'"
			cQuery += " AND T7E.D_E_L_E_T_ = ' ' "
			cQuery += "WHERE #QueryWhere# "
		Case cTypeEvent == "EVENT_MODEL_4"
			cQuery := "SELECT #QueryFields# "
			cQuery += " FROM " 	+ RetSqlName("C20") + " C20 "
			cQuery += "INNER JOIN " + RetSqlName("C09") + " C09 "
			cQuery += " ON  C09.C09_FILIAL = '" + FwXFilial("C09") + "'"
			cQuery += " AND C09.C09_ID	   = C20.C20_UF "
			cQuery += "	AND C09.D_E_L_E_T_ = ' ' "
			cQuery += "INNER JOIN " + RetSqlName("C30") + " C30 "
			cQuery += " ON  C30.C30_FILIAL = '" + FwXFilial("C30") + "'"
			cQuery += " AND C30.C30_CHVNF  = C20.C20_CHVNF "
			cQuery += "	AND C30.D_E_L_E_T_ = ' ' "
			cQuery += "INNER JOIN " + RetSqlName("T7E") + " T7E "
			cQuery += " ON  T7E.T7E_FILIAL = '" + FwXFilial("T7E") + "'"
			cQuery += " AND T7E.T7E_EVENTO = '" + cEvent + "'"
			cQuery += " AND T7E.D_E_L_E_T_ = ' ' "
			cQuery += SELF:oUtil:getTabIbs(cChvnf, ::cCodTribIbs )
        	cQuery += SELF:oUtil:getTabCbs(cChvnf, ::cCodTribCbs)
			cQuery += "WHERE #QueryWhere# "
		Case cTypeEvent == "EVENT_MODEL_5"
			cQuery := "SELECT #QueryFields# "
			cQuery += " FROM " 	+ RetSqlName("C20") + " C20 "
			cQuery += "INNER JOIN " + RetSqlName("C09") + " C09 "
			cQuery += " ON  C09.C09_FILIAL = '" + FwXFilial("C09") + "'"
			cQuery += " AND C09.C09_ID	   = C20.C20_UF "
			cQuery += "	AND C09.D_E_L_E_T_ = ' ' "
			cQuery += "INNER JOIN " + RetSqlName("C30") + " C30 "
			cQuery += " ON  C30.C30_FILIAL = '" + FwXFilial("C30") + "'"
			cQuery += " AND C30.C30_CHVNF  = C20.C20_CHVNF "
			cQuery += "	AND C30.D_E_L_E_T_ = ' ' "
			cQuery += "INNER JOIN " + RetSqlName("T7E") + " T7E "
			cQuery += " ON  T7E.T7E_FILIAL = '" + FwXFilial("T7E") + "'"
			cQuery += " AND T7E.T7E_EVENTO = '" + cEvent + "'"
			cQuery += " AND T7E.D_E_L_E_T_ = ' ' "
			cQuery += SELF:oUtil:getTabIbs(cChvnf, ::cCodCredIbs )
        	cQuery += SELF:oUtil:getTabCbs(cChvnf, ::cCodCredCbs)
			cQuery += "WHERE #QueryWhere# "
		Case cTypeEvent == "EVENT_MODEL_6"
			cQuery := "SELECT #QueryFields# "
			cQuery += " FROM " + RetSqlName("C20") + " C20 "
			cQuery += "INNER JOIN " + RetSqlName("T7E") + " T7E "
			cQuery += " ON  T7E.T7E_FILIAL = '" + FwXFilial("T7E") + "'"
			cQuery += " AND T7E.T7E_EVENTO = '" + cEvent + "'"
			cQuery += " AND T7E.D_E_L_E_T_ = ' ' "
			cQuery += "WHERE #QueryWhere# "
	EndCase

Return cQuery

//-----------------------------------------------------------------------
/*/{Protheus.doc} GetValorTrib
Retorna string que ira definir o campo Valor do Tributo

@type function
@version 1.0
@author Misael Ramos
@since 14/11/2025
@return character, Retorna a string que define o campo Valor do Tributo
/*/
//-----------------------------------------------------------------------
Static Function GetValorTrib() as character

	Local cValorTrib := "" as character

	cValorTrib := " CASE "
	cValorTrib += "		WHEN CBS_BASE > 0 "
	cValorTrib += "			THEN CBS_BASE "
	cValorTrib += "		WHEN IBS_BASE > 0 "
	cValorTrib += "			THEN IBS_BASE "
	cValorTrib += "			ELSE 0 "
	cValorTrib += " END "

Return cValorTrib

//-----------------------------------------------------------------------
/*/{Protheus.doc} getFilterEventsDocuments
Funcao que construi a clausula WHERE para filtragem dos eventos de documentos fiscais

@type function
@version 1.0
@author Misael Ramos
@since 14/11/2025
@param cProperty, character, nome da propriedade do Json a ser mapeada
@param cIdEvento, character, identificador do evento
@param cBranch, character, filial do evento
@return character, Retorna a clausula WHERE para filtragem
/*/
//-----------------------------------------------------------------------
Static Function getFilterEventsDocuments(cChvnf as character, cItems as character) as character

	Local cWhere := "" as character

	cWhere := " C20.C20_FILIAL     = '" + FwXFilial("C20") + "'"
	cWhere += " AND C20.C20_CHVNF  = '" + cChvnf + "'"
	
	If !Empty(cItems)
		cWhere += " AND C30.C30_ITEXML IN (" + cItems + ") "
	EndIf

	cWhere += " AND C20.D_E_L_E_T_ = ' ' "

Return cWhere

//-----------------------------------------------------------------------
/*/{Protheus.doc} getOrderEventsDocuments
Funcao que retorna a ordenacao dos dados para a query

@type function
@version 1.0
@author Misael Ramos
@since 14/11/2025
@return character, Retorna a ordenacao dos dados para a query
/*/
//-----------------------------------------------------------------------
Static Function getOrderEventsDocuments() as character

	Local cOrder := "" as character

	cOrder := " C20_FILIAL, C20_CHVNF "

Return cOrder
