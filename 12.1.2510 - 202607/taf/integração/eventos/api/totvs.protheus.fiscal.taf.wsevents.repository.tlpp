		Self:AddMapFields("stateAuthor", 			"C09_UF",   	.T., .T., { "C09_UF",     'C', ::oUtil:GetFieldLength('C09_UF'), 	 	0 })
		Self:AddMapFields("creditClassificationIbs","CRED_IBS",  	.T., .T., { "CRED_IBS",   'N', ::oUtil:GetFieldLength('T7B_CODCRE'), 	::oUtil:GetFieldDecimal('T7B_CODCRE')}, GetValorTrib(::cCodPresumi, ::cCodCredIbs, 'T7B_CODCRE'))
		Self:AddMapFields("creditClassificationCbs","CRED_CBS",  	.T., .T., { "CRED_CBS",   'N', ::oUtil:GetFieldLength('T7B_CODCRE'), 	::oUtil:GetFieldDecimal('T7B_CODCRE')}, GetValorTrib(::cCodPresumi, ::cCodCredCbs, 'T7B_CODCRE'))
		Self:AddMapFields("creditPercentageIbs",	"PERC_IBS",  	.T., .T., { "PERC_IBS",   'N', ::oUtil:GetFieldLength('T7B_PERC'), 	 	::oUtil:GetFieldDecimal('T7B_PERC')  }, GetValorTrib(::cCodPresumi, ::cCodCredIbs, 'T7B_PERC'))
		Self:AddMapFields("creditPercentageCbs",	"PERC_CBS",  	.T., .T., { "PERC_CBS",   'N', ::oUtil:GetFieldLength('T7B_PERC'),   	::oUtil:GetFieldDecimal('T7B_PERC')  }, GetValorTrib(::cCodPresumi, ::cCodCredCbs, 'T7B_PERC'))
		Self:AddMapFields("creditValueIbs",			"VAL_CREDIBS", 	.T., .T., { "VAL_CREDIBS",'N', ::oUtil:GetFieldLength('T7B_VALOR'),  	::oUtil:GetFieldDecimal('T7B_VALOR') }, GetValorTrib(::cCodPresumi, ::cCodCredIbs, 'T7B_VALOR'))
		Self:AddMapFields("creditValueCbs",			"VAL_CREDCBS", 	.T., .T., { "VAL_CREDCBS",'N', ::oUtil:GetFieldLength('T7B_VALOR'),  	::oUtil:GetFieldDecimal('T7B_VALOR') }, GetValorTrib(::cCodPresumi, ::cCodCredCbs, 'T7B_VALOR'))
		Self:AddMapFields("baseCreditPresumed",		"T7B_VLBASE", 	.T., .T., { "T7B_VLBASE", 'N', ::oUtil:GetFieldLength('T7B_VLBASE'), 	::oUtil:GetFieldDecimal('T7B_VLBASE')})
		Self:AddMapFields("authorType",				"T7E_AUTOR", 	.T., .T., { "T7E_AUTOR",  'C', ::oUtil:GetFieldLength('T7E_AUTOR'),  	0 })
		Self:AddMapFields("codTriCbs",				"COD_TRICBS", 	.T., .T., { "COD_TRICBS", 'C', ::oUtil:GetFieldLength('T7B_CODTRI'), 	0 }, GetValorTrib(::cCodPresumi, ::cCodCredCbs, 'T7B_CODTRI'))
		Self:AddMapFields("codTriIbs",				"COD_TRIIBS", 	.T., .T., { "COD_TRIIBS", 'C', ::oUtil:GetFieldLength('T7B_CODTRI'), 	0 }, GetValorTrib(::cCodPresumi, ::cCodCredIbs, 'T7B_CODTRI'))
	Case cTypeEvent == "EVENT_MODEL_6"
		Self:AddMapFields("stateAuthor",  			"C09_UF",   	.T., .T., { "C09_UF",     'C', ::oUtil:GetFieldLength('C09_UF'), 		0 })
		Self:AddMapFields("deliveryDate", 			"T7A_DTPREV", 	.T., .T., { "T7A_DTPREV", 'D', ::oUtil:GetFieldLength('T7A_DTPREV'),	0 })
		Self:AddMapFields("authorType",	  			"T7A_TPAUT",  	.T., .T., { "T7A_TPAUT",  'C', ::oUtil:GetFieldLength('T7A_TPAUT'), 	0 })
	Case cTypeEvent == "EVENT_CODE"
		Self:AddMapFields("event",  				"T7A_TPEVEN",  	.T., .T., { "T7A_TPEVEN", 'C', ::oUtil:GetFieldLength('T7A_TPEVEN'), 	0 })
		Self:AddMapFields("chvnf",  				"T7A_CHVNF",  	.T., .T., { "T7A_CHVNF",  'C', ::oUtil:GetFieldLength('T7A_CHVNF'), 	0 })
	EndCase
Return Nil

/*/{Protheus.doc} getQuery
	Monta a expressão SQL para consulta dos dados.
@author juan.felipe
@since 03/11/2025
@param nOption, numeric, opção de consulta.
@param cChvnf, chave da NF
@return cQuery, string, expressão where para consulta dos dados.
/*/
Method getQuery(nOption as numeric, cChvnf as character) Class WSEventsRepository
	Local cQuery As Character
	Local oUtils As Object

	Default nOption    := 0

	oUtils := Utils():New()

	If nOption == 1
		cQuery := " SELECT #QueryFields#"
		cQuery += " FROM " + RetSqlName( 'T7E' ) + " T7E "
		cQuery += " WHERE #QueryWhere#"
	ElseIf nOption == 2
		cQuery := " SELECT #QueryFields#"
		cQuery += " FROM " + RetSqlName( 'C20' ) + " C20 "
		cQuery += " INNER JOIN " + RetSqlName( 'C35' )
		cQuery += "     C35 ON C35.C35_FILIAL = C20.C20_FILIAL AND "
		cQuery += "     C35.C35_CHVNF = C20.C20_CHVNF "
		cQuery += " INNER JOIN " + RetSqlName( 'C1H' )
		cQuery += "     C1H ON " + FwJoinFilial("C1H","C20") + " AND "
		cQuery += "     C1H.C1H_ID = C20.C20_CODPAR "
		cQuery += " WHERE #QueryWhere#"
		cQuery += " GROUP BY "
		cQuery += "     C20_FILIAL, "
		cQuery += "     C20_CODPAR, "
		cQuery += "     C20_CODMOD, "
		cQuery += "     C20_INDOPE, "
		cQuery += "     C20_SERIE, "
		cQuery += "     C20_NUMDOC, "
		cQuery += "     C20_CHVNF, "
		cQuery += "     C1H_NOME, "
		cQuery += "     C1H_CNPJ, "
		cQuery += "     C1H_CPF "
	ElseIf nOption == 3
		cQuery := " SELECT #QueryFields# "
		cQuery += " FROM " + RetSqlName('C20') + " C20 "
		cQuery += " INNER JOIN " + RetSqlName('C30') + " C30 ON "
		cQuery += "     C30.C30_FILIAL = C20.C20_FILIAL AND "
		cQuery += "     C30.C30_CHVNF = C20.C20_CHVNF "
		cQuery += " INNER JOIN " + RetSqlName('C1L') + " C1L ON "
		cQuery +=  FwJoinFilial("C1L","C30") + " AND "
		cQuery += "     C1L.C1L_ID = C30.C30_CODITE "
		cQuery += " LEFT JOIN " + RetSqlName('C0A') + " C0A ON "
		cQuery += FwJoinFilial("C0A","C1L") + " AND "
		cQuery += "     C0A.C0A_ID = C1L.C1L_CODNCM AND "
		cQuery += "     C0A.D_E_L_E_T_ = ' ' "
		cQuery += oUtils:getTabIbs(cChvnf)
		cQuery += oUtils:getTabCbs(cChvnf)
		cQuery += " WHERE #QueryWhere#"
	EndIf
Return cQuery

/*/{Protheus.doc} GetWhere
	Monta a expressão SQL WHERE para consulta dos dados.
@author juan.felipe
@since 03/11/2025
@param nOption, numeric, opção de consulta.
@param jQuery, json, parâmetros da requisição.
@return cQuery, string, expressão where para consulta dos dados.
/*/
Method getWhere(nOption, jQuery) Class WSEventsRepository
	Local cWhere As Character
	Local cTypeDoc As Character
	Local cSpeciesDocument As Character
	Local cDateStart As Character
	Local cDateEnd As Character
	Local cChvNf As Character
	Local cParticipant As Character
	Local cNcm As Character
	Local cCfop As Character
	Local cCst As Character
	Local cPurpose As Character
	Local cFormattedParticipant As Character
	Local cFormattedNcm As Character
	Local cFormattedCfop As Character
	Local cFormattedCst As Character
	Local cPurposeDocType As Character
	Local aPurpose As Array
	Local nX As Numeric
	Local cEvento as character

	Default nOption := 0

	Default jQuery := JsonObject():New()

	cWhere := ''

	If nOption == 1
		cWhere += " D_E_L_E_T_ = ' ' "
	ElseIf nOption == 2
		cChvNf := AllTrim(jQuery:GetJsonObject('chvnf'))

		If !Empty(cChvNf)
            cWhere += " C20.C20_FILIAL = '" + FWxFilial('C20') + "' AND "
            cWhere += " C20.C20_CHVNF = '"+ cChvNf + "' AND "
        Else
			cParticipant := AllTrim(jQuery:GetJsonObject('participant'))
			cNcm := AllTrim(jQuery:GetJsonObject('ncm'))
			cCfop := AllTrim(jQuery:GetJsonObject('cfop'))
			cCst := AllTrim(jQuery:GetJsonObject('cst'))
			cPurpose := AllTrim(jQuery:GetJsonObject('purpose'))
			cFormattedParticipant := ::oUtil:formatItemsSQL(cParticipant)
			cFormattedNcm := ::oUtil:formatItemsSQL(cNcm)
			cFormattedCfop := ::oUtil:formatItemsSQL(cCfop)
			cFormattedCst := ::oUtil:formatItemsSQL(cCst)
			cPurposeDocType := ''
			aPurpose := {}
			cTypeDoc := AllTrim(jQuery:GetJsonObject('typeDocument'))
			cDateStart := StrTran(jQuery:GetJsonObject('dateStart'), '-', '')
			cDateEnd := StrTran(jQuery:GetJsonObject('dateEnd'), '-', '')
			cSpeciesDocument := Self:getSpeciesDocument(jQuery:GetJsonObject('speciesDocument'))

			Do Case
			Case cTypeDoc == '1'
				cTypeDoc := "'0'"
			Case cTypeDoc == '2'
				cTypeDoc := "'1'"
			Otherwise
				cTypeDoc := "'0','1'"
			EndCase

			cWhere += " C20.C20_FILIAL = '" + FWxFilial('C20') + "' AND "
			cWhere += " C20.C20_INDOPE IN (" + cTypeDoc + ") AND "
			cWhere += " C20.C20_CODMOD = '" + cSpeciesDocument + "' AND "
			cWhere += " C20.C20_CHVELE <> ' ' AND "
			cWhere += " C20.C20_DTDOC BETWEEN '" + cDateStart + "' AND '" + cDateEnd + "' AND "

			If !Empty(cFormattedParticipant)
				cWhere += " C1H.C1H_CODPAR IN (" + cFormattedParticipant + ") AND "
			EndIf
			If !Empty(cFormattedNcm)
				cWhere += " EXISTS ( SELECT 1 FROM " + RetSqlName('C30') + " C30NCM "
				cWhere += " INNER JOIN " + RetSqlName('C1L') + " C1LNCM ON " + FwJoinFilial('C1L','C30NCM') + " AND "
				cWhere += " C1LNCM.C1L_ID = C30NCM.C30_CODITE "
				cWhere += " INNER JOIN " + RetSqlName('C0A') + " C0ANCM ON " + FwJoinFilial('C0A','C1LNCM') + " AND "
				cWhere += " C0ANCM.C0A_ID = C1LNCM.C1L_CODNCM "
				cWhere += " WHERE C30NCM.C30_FILIAL = C20.C20_FILIAL AND "
				cWhere += " C30NCM.C30_CHVNF = C20.C20_CHVNF AND "
				cWhere += " C0ANCM.C0A_CODIGO IN (" + cFormattedNcm + ") AND "
				cWhere += " C30NCM.D_E_L_E_T_ = ' ' AND "
				cWhere += " C1LNCM.D_E_L_E_T_ = ' ' AND "
				cWhere += " C0ANCM.D_E_L_E_T_ = ' ' ) AND "
			EndIf
			If !Empty(cFormattedCfop)
				cWhere += " EXISTS ( SELECT 1 FROM " + RetSqlName('C30') + " C30CFOP "
				cWhere += " INNER JOIN " + RetSqlName('C0Y') + " C0YCFOP ON "
				cWhere += " C0YCFOP.C0Y_FILIAL = '" + xFilial('C0Y') + "' AND "
				cWhere += " C0YCFOP.C0Y_ID = C30CFOP.C30_CFOP "
				cWhere += " WHERE C30CFOP.C30_FILIAL = C20.C20_FILIAL AND "
				cWhere += " C30CFOP.C30_CHVNF = C20.C20_CHVNF AND "
				cWhere += " C0YCFOP.C0Y_CODIGO IN (" + cFormattedCfop + ") AND "
				cWhere += " C30CFOP.D_E_L_E_T_ = ' ' AND "
				cWhere += " C0YCFOP.D_E_L_E_T_ = ' ' ) AND "
			EndIf
			If !Empty(cFormattedCst)
				cWhere += " EXISTS ( SELECT 1 FROM " + RetSqlName('C35') + " C35CST "
				cWhere += " INNER JOIN " + RetSqlName('T5R') + " T5RCST ON "
				cWhere += " T5RCST.T5R_FILIAL = '" + xFilial('T5R') + "' AND "
				cWhere += " T5RCST.T5R_ID = C35CST.C35_CST "
				cWhere += " WHERE C35CST.C35_FILIAL = C20.C20_FILIAL AND "
				cWhere += " C35CST.C35_CHVNF = C20.C20_CHVNF AND "
				cWhere += " T5RCST.T5R_CCLATR IN (" + cFormattedCst + ") AND "
				cWhere += " C35CST.D_E_L_E_T_ = ' ' AND "
				cWhere += " T5RCST.D_E_L_E_T_ = ' ' ) AND "
			EndIf
			If !Empty(cPurpose)
				aPurpose := StrTokArr(cPurpose, ',')
				For nX := 1 To Len(aPurpose)
					Do Case
					Case AllTrim(aPurpose[nX]) == '0'
						cPurposeDocType += Iif(Empty(cPurposeDocType), "'000001'", ", '000001'")
					Case AllTrim(aPurpose[nX]) == '1'
						cPurposeDocType += Iif(Empty(cPurposeDocType), "'000009'", ", '000009'")
					Case AllTrim(aPurpose[nX]) == '2'
						cPurposeDocType += Iif(Empty(cPurposeDocType), "'000008'", ", '000008'")
					EndCase
				Next nX

				If !Empty(cPurposeDocType)
					cWhere += " C20.C20_TPDOC IN (" + cPurposeDocType + ") AND "
				EndIf
			EndIf
		EndIf
		cEvento := jQuery:GetJsonObject('event')
		If !Empty(cEvento)
			If cEvento == "211110"
				cWhere += " C35.C35_CODTRI IN ('000033', '000046') AND "
			Else
				cWhere += " C35.C35_CODTRI IN ('000031', '000032', '000039', '000040', '000042', '000044', '000045', '000047', '000048', '000049') AND "
			EndIf
		EndIf

		cWhere += " C20.C20_CODSIT NOT IN('000003','000004','000005','000006') AND "
		cWhere += " C20.D_E_L_E_T_ = ' ' AND "
		cWhere += " C35.D_E_L_E_T_ = ' ' AND "
		cWhere += " C1H.D_E_L_E_T_ = ' ' "
	ElseIf nOption == 3
		cWhere += " C20.C20_FILIAL = '" + FWxFilial('C20') + "' AND "
		cWhere += " C20.C20_CHVNF = '" + jQuery:GetJsonObject('chvnf') + "' AND "
		cWhere += " C30.D_E_L_E_T_ = ' ' AND "
		cWhere += " C1L.D_E_L_E_T_ = ' ' "
	EndIf
Return cWhere

/*/{Protheus.doc} getSpeciesDocument
	Obtém a espécie do documento fiscal conforme código informado.
@author juan.felipe
@since 14/11/2025
@param cCode, character, código da espécie do documento.
@return cSpecie, character, espécie do documento.
/*/
Method getSpeciesDocument(cCode) As Character Class WSEventsRepository
	Local cSpecie As Character
	Local jTypes As Json

	Default cCode := ''

	jTypes := JsonObject():New()
	jTypes['1'] := '000029' //-- Adicione outros tipos de documentos neste json se necessário.

	cSpecie := jTypes[cCode]
	cSpecie := Iif(ValType(cSpecie) == "U", '1', cSpecie)

	FreeObj(jTypes)
Return cSpecie

/*/{Protheus.doc} postSaveEvents
	Salva evento para os documentos fiscais selecionados.
@author juan.felipe
@since 17/11/2025
@param jRequest, json, json da requisição.
@return jResponse, json, json de resposta.
/*/
Method postSaveEvents(jRequest As Json) As Json Class WSEventsRepository
	Local oBulkT7A         As Object
	Local oBulkT7B         As Object
	Local oBulkT7C         As Object
	Local oBulkT7I         As Object
	Local oUtils           As Object
	Local jResponse        As Json
	Local jEvent           As Json
	Local jFields          As Json
	Local jBatch           As Json
	Local oXmlMonitorEvent As Object
	Local aItems           As Array
	Local aBulks := {}     As Array
	Local aT7AFields       As Array
	Local aT7BFields       As Array
	Local aT7CFields       As Array
	Local aT7IFields       As Array
	Local aT7AData         As Array
	Local cIdent           As Character
	Local cChvNf           As Character
	Local cCodEvent        As Character
	Local cFilT7B          As Character
	Local cFilT7C          As Character
	Local cSequenciaLote   As Character
	Local lHasFields       As Logical
	Local lProcessLote	   As Logical
	Local lCreditoPresumido As Logical
	Local nTmChvEle        As Numeric
	Local nX               As Numeric
	Local nTotalNotas      As Numeric
	Local aChvNf           As Array
	Local lExisteT7I	   As Logical
	Local lFronteDicAtualiazado := .T.	   As Logical

	Default jRequest := JsonObject():New()
	

	nTmChvEle := FWSX3Util():GetFieldStruct("T7A_CHVELE")[3]

	C20->(DbSetOrder(4)) //-- C20_FILIAL+C20_CHVNF
	T7A->(DbSetOrder(1)) //-- T7A_FILIAL+T7A_IDENT
	lExisteT7I := TAFColumnPos( "T7I_CANC" )
	oUtils := Utils():New()
	Self:nCode := 200
	jResponse        := JsonObject():New()
	
	If Valtype(jRequest['chvnf']) == "A"
		aChvNf := jRequest['chvnf']
		lFronteDicAtualiazado := lExisteT7I
	Else
		aChvNf := {jRequest['chvnf']}
	EndIf
	If lFronteDicAtualiazado
		
		jEvent           := jRequest['event']
		jFields          := jEvent['fields']
		If ValType(jEvent['batchFields']) <> "U"
			jBatch := jEvent['batchFields']
		EndIf
		aItems           := jEvent['items']
		cCodEvent        := jEvent['event']
		If cCodEvent == "211110"
			lCreditoPresumido := .T.//-- Variável para controle de crédito presumido, caso necessário para algum evento específico
		EndIf
		nTotalNotas := Len(aChvNf)
		oBulkT7A         := FWBulk():New(RetSQLName("T7A"))
		oBulkT7B         := FWBulk():New(RetSQLName("T7B"))
		oBulkT7C         := FWBulk():New(RetSQLName("T7C"))
		oXmlMonitorEvent := TAFXmlMonitorEvent():New()
		cFilT7B          := FWxFilial("T7B")
		cFilT7C          := FWxFilial("T7C")
		lHasFields       := Len(jFields:GetNames()) > 0 .And. Len(aItems) == 0
		aT7AData         := {}
		aT7AFields       := {{"T7A_FILIAL"}, {"T7A_IDENT"} , {"T7A_TPEVEN"}, {"T7A_CHVNF"} , {"T7A_CHVELE"}, {"T7A_EST"}, {"T7A_TPAUT"}, {"T7A_PGTO"}, {"T7A_INDACE"}, {'T7A_DTPREV'}, {"T7A_SERIE"}, {"T7A_NUMDOC"}, {"T7A_CODPAR"}, {"T7A_ESPECI"}, {"T7A_STATUS"}, {"T7A_DTEMIS"}}
		aT7BFields       := {{"T7B_FILIAL"}, {"T7B_IDENT"} , {"T7B_ITEM"}, {"T7B_CODTRI"}, {"T7B_VLBASE"}, {"T7B_CODCRE"}, {"T7B_PERC"}, {"T7B_VALOR"}}
		aT7CFields       := {{"T7C_FILIAL"}, {"T7C_IDENT"} , {"T7C_ITEM"}, {"T7C_CODTRI"}, {"T7C_QUANT"}, {"T7C_UM"}, {"T7C_VALOR"}}
		aT7IFields       := {}
		If ValType(jRequest['inclType']) == "N"
			lProcessLote := jRequest['inclType'] == 2 .And. lExisteT7I
		EndIf

		If lProcessLote
			oBulkT7I         := FWBulk():New(RetSQLName("T7I"))
			aT7IFields       := {{"T7I_FILIAL"}, {"T7I_DTINC"}, {"T7I_USRINC"}, {"T7I_SEQUEN"}, {"T7I_EVENTO"}, {"T7I_STATUS"}, {"T7I_TOTLOT"}, {"T7I_CANC"}}
			oBulkT7I:SetFields(aT7IFields)
			aAdd(aT7AFields, {"T7A_SEQLOT"})
			cSequenciaLote := Self:getNextLoteSequence(cCodEvent)
		EndIf

		//-- Definição dos campos para gravação em lote
		oBulkT7A:SetFields(aT7AFields)
		oBulkT7B:SetFields(aT7BFields)
		oBulkT7C:SetFields(aT7CFields)
		
		For nX := 1 To nTotalNotas
			cChvNf := aChvNf[nX]
			aT7AData := {}

			If Self:lOk := C20->(MsSeek(FWxFilial('C20') + cChvNf))
				cIdent           := FwUUIDv4(.T.)
				aT7AData := Self:buildT7AHeaderData(cIdent, cCodEvent, cChvNf, nTmChvEle, lProcessLote, cSequenciaLote)

				If lProcessLote .And. !lHasFields
					aItems := Self:getItemsByChvNf(cChvNf,jBatch,lCreditoPresumido)
					Self:applyHeaderFieldsFromJson(@aT7AData, aT7AFields, jBatch, oUtils)
				EndIf
				
				If lHasFields
					Self:applyHeaderFieldsFromJson(@aT7AData, aT7AFields, jFields, oUtils)
				EndIf

				If Len(aItems) > 0 //-- Definição de itens - (T7B para evento 211110, T7C para demais)
					If lCreditoPresumido
						Self:addItemsEvent211110(oBulkT7B, cFilT7B, cIdent, aItems, oUtils)
					Else
						Self:addItemsGenericEvent(oBulkT7C, cFilT7C, cIdent, aItems, oUtils,lProcessLote)
					EndIf
					If !lProcessLote
						Self:applyHeaderFieldsFromItem(@aT7AData, aT7AFields, aItems, oUtils)
					EndIf
				EndIf

				oBulkT7A:AddData(aT7AData) //-- Adiciona dados do cabeçalho

			Else
				Self:nCode := 401
				jResponse := oUtils:setClassResponse(Self:nCode, STR0006, STR0007) //-- O documento fiscal não foi localizado na base dados. Informe um código de documento válido.
				Exit
			EndIf
		Next nX

		If Self:lOk

			If lProcessLote
				cIdent := Self:addLoteData(oBulkT7I, cSequenciaLote, cCodEvent, nTotalNotas)
				AAdd(aBulks, oBulkT7I)
			EndIf

			AAdd(aBulks, oBulkT7A)
			AAdd(aBulks, oBulkT7B)
			AAdd(aBulks, oBulkT7C)
			jResponse := Self:flushEventBulks(aBulks, oUtils)
			oXmlMonitorEvent:TAFScheduleXmlMonitorEvent()

			//-- Monta o retorno da API
			jResponse["id"] := cIdent
			jResponse["chvnf"] := cChvNf
			jResponse["event"] := JsonObject():New()
			jResponse["event"]["event"]  := cCodEvent
			jResponse["event"]["fields"] := jFields
			jResponse["event"]["items"]  := jEvent['items']
			If ValType(jBatch) <> "U"
				jResponse["event"]["batchFields"]  := jBatch
			EndIf
			jResponse["hasNext"] := .F.

		EndIf

		FreeObj(oXmlMonitorEvent)
		FreeObj(jRequest)
		FreeObj(jFields)
		FwFreeArray(aBulks)
		FwFreeArray(aItems)
		FwFreeArray(aT7AFields)
		FwFreeArray(aT7BFields)
		FwFreeArray(aT7CFields)
		FwFreeArray(aT7IFields)
		FwFreeArray(aT7AData)
		If ::oItemsByChvNf != Nil
			::oItemsByChvNf:Destroy()
			FreeObj(::oItemsByChvNf)
			::oItemsByChvNf := Nil
		EndIf
	
	Else
		Self:lOk := .F.
		Self:nCode := 400
		jResponse := oUtils:setClassResponse(Self:nCode, STR0025, STR0026) //"Lote de eventos nao foi incluso"-- "Dicionario de dados desatualizado, contate o administrador do sistema".
	EndIf

	FreeObj(oUtils)

Return jResponse

/*/{Protheus.doc} buildT7AHeaderData
	Monta os dados do cabecalho para inclusao na tabela T7A.
@author Pâmela Bernardo
@since 19/05/2026
@param cIdent, character, identificador do evento.
@param cCodEvent, character, codigo do evento.
@param cChvNf, character, chave da NFe.
@param nTmChvEle, numeric, tamanho do campo T7A_CHVELE.
@param lProcessLote, logical, indica se a inclusao sera em lote.
@param cSequenciaLote, character, sequencia do lote quando aplicavel.
@return aT7AData, array, dados do cabecalho para gravacao.
/*/
Method buildT7AHeaderData(cIdent As Character, cCodEvent As Character, cChvNf As Character, nTmChvEle As Numeric, lProcessLote As Logical, cSequenciaLote As Character) As Array Class WSEventsRepository
	Local aT7AData As Array

	aT7AData := {}
	AAdd(aT7AData, FWxFilial("T7A") ) //T7A_FILIAL
	AAdd(aT7AData, cIdent ) //T7A_IDENT
	AAdd(aT7AData, cCodEvent ) //T7A_TPEVEN
	AAdd(aT7AData, cChvNf ) //T7A_CHVNF 
	AAdd(aT7AData, Padr(Alltrim(C20->C20_CHVELE), nTmChvEle) ) //T7A_CHVELE
	AAdd(aT7AData, '' ) //T7A_EST 
	AAdd(aT7AData, '' ) //T7A_TPAUT
	AAdd(aT7AData, '' )//T7A_PGTO
	AAdd(aT7AData, '' ) //T7A_INDACE
	AAdd(aT7AData, SToD('')) //T7A_DTPREV
	AAdd(aT7AData, C20->C20_SERIE ) //T7A_SERIE 
	AAdd(aT7AData, C20->C20_NUMDOC ) //T7A_NUMDOC
	AAdd(aT7AData, C20->C20_CODPAR ) //T7A_CODPAR
	AAdd(aT7AData, C20->C20_ESPECI ) //T7A_ESPECI
	AAdd(aT7AData, '1' ) //T7A_STATUS
	AAdd(aT7AData, dDataBase ) //T7A_DTEMIS

	If lProcessLote
		AAdd(aT7AData, cSequenciaLote) //T7A_SEQLOT
	EndIf

Return aT7AData

/*/{Protheus.doc} applyHeaderFieldsFromJson
	Aplica os campos de cabecalho no array da T7A a partir do JSON de fields.
@author Pâmela Bernardo
@since 19/05/2026
@param aT7AData, array, dados do cabecalho da T7A.
@param aT7AFields, array, metadata dos campos da T7A.
@param jFields, json, fields enviados na requisicao.
@param oUtils, object, objeto utilitario para leitura segura de propriedades.
@return Nil, nulo.
/*/
Method applyHeaderFieldsFromJson(aT7AData As Array, aT7AFields As Array, jFields As Json, oUtils As Object) Class WSEventsRepository
	aT7AData[aScan(aT7AFields, {|x| x[1] == 'T7A_EST'   })] := GetAdvFVal("C09", "C09_ID", FWxFilial("C09") + oUtils:getSafeProperty(jFields, 'stateAuthor', ''), 1)
	aT7AData[aScan(aT7AFields, {|x| x[1] == 'T7A_TPAUT' })] := oUtils:getSafeProperty(jFields, 'authorType', '')
	aT7AData[aScan(aT7AFields, {|x| x[1] == 'T7A_PGTO'  })] := oUtils:getSafeProperty(jFields, 'dischargeIndicator', '')
	aT7AData[aScan(aT7AFields, {|x| x[1] == 'T7A_INDACE'})] := oUtils:getSafeProperty(jFields, 'acceptanceIndicator', '')
	aT7AData[aScan(aT7AFields, {|x| x[1] == 'T7A_DTPREV'})] := SToD(StrTran(oUtils:getSafeProperty(jFields, 'deliveryDate', ''), '-', ''))
Return

/*/{Protheus.doc} applyHeaderFieldsFromItem
	Aplica os campos de cabecalho no array da T7A a partir do primeiro item informado.
@author Pâmela Bernardo
@since 19/05/2026
@param aT7AData, array, dados do cabecalho da T7A.
@param aT7AFields, array, metadata dos campos da T7A.
@param aItems, array, itens do evento.
@param oUtils, object, objeto utilitario para leitura segura de propriedades.
@return Nil, nulo.
/*/
Method applyHeaderFieldsFromItem(aT7AData As Array, aT7AFields As Array, aItems As Array, oUtils As Object) Class WSEventsRepository
	If Len(aItems) > 0
		aT7AData[aScan(aT7AFields, {|x| x[1] == 'T7A_EST'   })] := GetAdvFVal("C09", "C09_ID", FWxFilial("C09") + oUtils:getSafeProperty(aItems[1], 'stateAuthor', ''), 1)
		aT7AData[aScan(aT7AFields, {|x| x[1] == 'T7A_TPAUT' })] := oUtils:getSafeProperty(aItems[1], 'authorType', '')
		aT7AData[aScan(aT7AFields, {|x| x[1] == 'T7A_PGTO'  })] := oUtils:getSafeProperty(aItems[1], 'dischargeIndicator', '')
		aT7AData[aScan(aT7AFields, {|x| x[1] == 'T7A_INDACE'})] := oUtils:getSafeProperty(aItems[1], 'acceptanceIndicator', '')
		aT7AData[aScan(aT7AFields, {|x| x[1] == 'T7A_DTPREV'})] := SToD(StrTran(oUtils:getSafeProperty(aItems[1], 'deliveryDate', ''), '-', ''))
	EndIf
Return



/*/{Protheus.doc} addItemsEvent211110
	Monta e adiciona os dados dos itens na tabela T7B para o evento 211110.
@author Pâmela Bernardo
@since 19/05/2026
@param oBulkT7B, object, objeto de gravacao em lote da T7B.
@param cFilT7B, character, filial da tabela T7B.
@param cIdent, character, identificador do evento.
@param aItems, array, itens do evento.
@param oUtils, object, objeto utilitario para leitura segura de propriedades.
@return Nil, nulo.
/*/
Method addItemsEvent211110(oBulkT7B As Object, cFilT7B As Character, cIdent As Character, aItems As Array, oUtils As Object) Class WSEventsRepository
	Local aT7BData       As Array
	Local cCodTri        As Character
	Local cCodCre        As Character
	Local cPerc          As Character
	Local cValue         As Character
	Local lIsCBS         As Logical
	Local lIsIBS         As Logical
	Local lDuplicateLine As Logical
	Local nI             As Numeric
	Local nJ             As Numeric

	For nI := 1 To Len(aItems)
		lIsCBS := !Empty(aItems[nI]["codTriCbs"])
		lIsIBS := !Empty(aItems[nI]["codTriIbs"])
		lDuplicateLine := lIsCBS .And. lIsIBS

		For nJ := 1 To 2
			aT7BData := {}

			If lIsCBS .Or. lIsIBS
				cCodTri := Iif((lDuplicateLine .And. nJ == 1) .Or. (lIsCBS .And. nJ != 2), aItems[nI]["codTriCbs"], aItems[nI]["codTriIbs"])
				AAdd(aT7BData, cFilT7B )  // T7B_FILIAL
				AAdd(aT7BData, cIdent )  // T7B_IDENT
				AAdd(aT7BData, aItems[nI]["item"] ) // T7B_ITEM
				AAdd(aT7BData, cCodTri ) // T7B_CODTRI
				AAdd(aT7BData, oUtils:getSafeProperty(aItems[nI], 'baseCreditPresumed', '') ) // T7B_VLBASE

				cCodCre := IIf((lDuplicateLine .And. nJ == 1) .Or. (lIsCBS .And. nJ != 2), "creditClassificationCbs", "creditClassificationIbs")
				cPerc   := IIf((lDuplicateLine .And. nJ == 1) .Or. (lIsCBS .And. nJ != 2), "creditPercentageCbs", "creditPercentageIbs")
				cValue  := IIf((lDuplicateLine .And. nJ == 1) .Or. (lIsCBS .And. nJ != 2), "creditValueCbs", "creditValueIbs")

				AAdd(aT7BData, oUtils:getSafeProperty(aItems[nI], cCodCre, '')) // T7B_CODCRE
				AAdd(aT7BData, oUtils:getSafeProperty(aItems[nI], cPerc  , 0 )) // T7B_PERC
				AAdd(aT7BData, oUtils:getSafeProperty(aItems[nI], cValue , 0 ))	// T7B_VALOR

			EndIf

			If Len(aT7BData) > 0
				oBulkT7B:AddData(aClone(aT7BData))
			EndIf

			If !lDuplicateLine
				Exit
			EndIf
		Next nJ
	Next nI

Return

/*/{Protheus.doc} addItemsGenericEvent
	Monta e adiciona os dados dos itens na tabela T7C para eventos diferentes de 211110.
@author Pâmela Bernardo
@since 19/05/2026
@param oBulkT7C, object, objeto de gravacao em lote da T7C.
@param cFilT7C, character, filial da tabela T7C.
@param cIdent, character, identificador do evento.
@param aItems, array, itens do evento.
@param oUtils, object, objeto utilitario para leitura segura de propriedades.
@param lProcessLote, logical, indica se a inclusao sera em lote para definir a unidade de medida.
@return Nil, nulo.
/*/
Method addItemsGenericEvent(oBulkT7C As Object, cFilT7C As Character, cIdent As Character, aItems As Array, oUtils As Object, lProcessLote As Logical) Class WSEventsRepository
	Local aT7CData       As Array
	Local cCodTri        As Character
	Local cValue         As Character
	Local lIsCBS         As Logical
	Local lIsIBS         As Logical
	Local lDuplicateLine As Logical
	Local nI             As Numeric
	Local nJ             As Numeric

	For nI := 1 To Len(aItems)
		lIsCBS := !Empty(aItems[nI]["codTriCbs"])
		lIsIBS := !Empty(aItems[nI]["codTriIbs"])
		lDuplicateLine := lIsCBS .And. lIsIBS

		For nJ := 1 To 2
			aT7CData := {}

			If lIsCBS .Or. lIsIBS
				cCodTri := Iif((lDuplicateLine .And. nJ == 1) .Or. (lIsCBS .And. nJ != 2), aItems[nI]["codTriCbs"], aItems[nI]["codTriIbs"])
				AAdd(aT7CData, cFilT7C ) //T7C_FILIAL
				AAdd(aT7CData, cIdent ) //T7C_IDENT 
				AAdd(aT7CData, aItems[nI]["item"] ) //T7C_ITEM  
				AAdd(aT7CData, cCodTri ) //T7C_CODTRI

				cValue := Iif((lDuplicateLine .And. nJ == 1) .Or. (lIsCBS .And. nJ != 2), "taxValueCbs", "taxValueIbs")

				AAdd(aT7CData, oUtils:getSafeProperty(aItems[nI], 'quantity', 0 )) //T7C_QUANT
				If !lProcessLote
					AAdd(aT7CData, Posicione("C1J", 1, FWxFilial("C1J") + AllTrim(aItems[nI]["unit"]), "C1J_ID")) //T7C_UM
				Else
					AAdd(aT7CData, aItems[nI]["unit"]) //T7C_UM
				EndIf
				AAdd(aT7CData, oUtils:getSafeProperty(aItems[nI], cValue    , 0 )) //T7C_VALOR
			EndIf

			If Len(aT7CData) > 0
				oBulkT7C:AddData(aClone(aT7CData))
			EndIf

			If !lDuplicateLine
				Exit
			EndIf
		Next nJ
	Next nI

Return

/*/{Protheus.doc} addLoteData
	Monta os dados de controle de lote e adiciona no bulk da tabela T7I.
@author Pâmela Bernardo
@since 19/05/2026
@param oBulkT7I, object, objeto de gravacao em lote da T7I.
@param cSequenciaLote, character, sequencia do lote.
@param cCodEvent, character, codigo do evento.
@param nTotalNotas, numeric, quantidade total de notas processadas.
@return cIdent, character, identificador do lote gerado.
/*/
Method addLoteData(oBulkT7I As Object, cSequenciaLote As Character, cCodEvent As Character, nTotalNotas As Numeric) As Character Class WSEventsRepository
	Local aT7IData As Array
	Local cIdent   As Character

	aT7IData := {}
	AAdd(aT7IData, FWxFilial("T7I")) //"T7I_FILIAL"
	AAdd(aT7IData, dDataBase) //"T7I_DTINC"
	AAdd(aT7IData, RetCodUsr()) //"T7I_USRINC"
	AAdd(aT7IData, cSequenciaLote) //"T7I_SEQUEN"
	AAdd(aT7IData, cCodEvent) //"T7I_EVENTO"
	AAdd(aT7IData, '1') //"T7I_STATUS"
	AAdd(aT7IData, nTotalNotas) //"T7I_TOTLOT"
	AAdd(aT7IData, '2') //"T7I_CANC"

	oBulkT7I:AddData(aT7IData)
	cIdent := dTos(dDataBase) + cCodEvent + cSequenciaLote

	FwFreeArray(aT7IData)
Return cIdent

/*/{Protheus.doc} flushEventBulks
	Executa a persistencia em lote dos objetos de bulk dentro de transacao.
@author Pâmela Bernardo
@since 19/05/2026
@param aBulks, array, lista de objetos de bulk a serem gravados.
@param oUtils, object, objeto utilitario para montagem da resposta de erro.
@return jResponse, json, resposta com erro de gravacao quando houver.
/*/
Method flushEventBulks(aBulks As Array, oUtils As Object) As Json Class WSEventsRepository
	Local jResponse As Json
	Local nI        As Numeric

	jResponse := JsonObject():New()

	Begin Transaction
		For nI := 1 To Len(aBulks)
			If Self:lOk .And. aBulks[nI]:nCount > 0 .And. !aBulks[nI]:Flush()
				Self:nCode := 401
				Self:lOk := .F.
				jResponse := oUtils:setClassResponse(Self:nCode, STR0019, aBulks[nI]:GetError())
			EndIf

			aBulks[nI]:Close()
			aBulks[nI]:Destroy()
			FreeObj(aBulks[nI])
		Next nI

		If !Self:lOk
			DisarmTransaction()
		EndIf
	End Transaction

Return jResponse

/*/{Protheus.doc} getNextLoteSequence
	Retorna a proxima sequencia de lote por dia e evento na tabela T7I.
@author Pâmela Bernardo
@since 15/05/2026
@param cCodEvent, character, codigo do evento para o lote.
@return cSequence, character, proxima sequencia para o dia/evento.
/*/
Method getNextLoteSequence(cCodEvent As Character) As Character Class WSEventsRepository
	Local cSequence      As Character
	Local cQuery         As Character
	Local cAliasQuery    As Character
	Local cFilT7I        As Character
	Local oStmt          As Object
	Local nNextSequence  As Numeric
	Local nSizeSequence  As Numeric

	Default cCodEvent := ''

	cFilT7I       := FWxFilial("T7I")
	nSizeSequence := TamSX3("T7I_SEQUEN")[1]
	nNextSequence := 1
	cSequence     := StrZero(nNextSequence, nSizeSequence)

	cQuery  := " SELECT MAX(T7I_SEQUEN) AS MAXSEQUEN "
	cQuery += " FROM " + RetSqlName("T7I") + " T7I "
	cQuery += " WHERE T7I.T7I_FILIAL = ? "
	cQuery += "   AND T7I.T7I_DTINC  = ? "
	cQuery += "   AND T7I.T7I_EVENTO = ? "
	cQuery += "   AND T7I.D_E_L_E_T_ = ? "

	oStmt := FwExecStatement():New(ChangeQuery(cQuery))
	oStmt:SetString(1, cFilT7I)
	oStmt:SetString(2, DToS(dDataBase))
	oStmt:SetString(3, cCodEvent)
	oStmt:SetString(4, " ")

	cAliasQuery := oStmt:OpenAlias()

	If !Empty(cAliasQuery)
		nNextSequence := Val(AllTrim((cAliasQuery)->MAXSEQUEN)) + 1
		(cAliasQuery)->(DbCloseArea())
	EndIf

	oStmt:Destroy()
	FreeObj(oStmt)
	cSequence := StrZero(nNextSequence, nSizeSequence)

Return cSequence

/*/{Protheus.doc} putSaveEvents
	Atualiza eventos para os documentos fiscais selecionados.
@author juan.felipe
@since 21/11/2025
@param cIdent, character, identificador do evento.
@param jRequest, json, parâmetros da requisição.
@return jResponse, json, objeto json com os dados da requisição.
/*/
Method putSaveEvents(cIdent As Character, jRequest As Json) As Json Class WSEventsRepository
	Local oUtils           As Object
	Local jResponse        As Json
	Local jEvent           As Json
	Local jFields          As Json
	Local oXmlMonitorEvent As Object
	Local aItems           As Array
	Local cChvNf           As Character
	Local cCodEvent        As Character
	Local cMessage         As Character
	Local cDetailMessage   As Character
	Local lHasFields       As Logical
	Local lRecLock         As Logical
	Local nI               As Numeric
	Local nJ               As Numeric
	Local cItem            As Character
	Local lIsCBS           As Logical
	Local lIsIBS           As Logical
	Local lDuplicateLine   As Logical
	Local cCodTri          As Character
	Local iItem	 := GetSX3Cache("T7C_ITEM"	, "X3_TAMANHO") as integer

	Default cIdent := ''
	Default jRequest := JsonObject():New()

	oUtils := Utils():New()

	C20->(DbSetOrder(4)) // C20_FILIAL + C20_CHVNF
	T7A->(DbSetOrder(2)) // T7A_FILIAL+T7A_CHVNF+T7A_IDENT
	T7B->(DbSetOrder(1)) // T7B_FILIAL + T7B_IDENT + T7B_ITEM + T7B_CODTRI
	T7C->(DbSetOrder(1)) // T7C_FILIAL + T7C_IDENT + T7C_ITEM + T7C_CODTRI

	If Valtype(jRequest['chvnf']) == "A"
		cChvNf := jRequest['chvnf'][1]
	Else
		cChvNf := jRequest["chvnf"]
	EndIf
	
	Self:lOk := .T.

	If !C20->(MsSeek(FWxFilial("C20") + cChvNf))
		Self:lOk := .F.
		Self:nCode := 401
		jResponse := oUtils:setClassResponse(Self:nCode, STR0008, STR0009) //-- Documento não encontrado para o evento. Selecione um documento válido.
		FreeObj(oUtils)
		Return jResponse
	EndIf

	If !T7A->(MsSeek(FWxFilial("T7A") + cChvNf + cIdent))
		Self:lOk := .F.
		Self:nCode := 401
		jResponse := oUtils:setClassResponse(Self:nCode, STR0010, STR0011) //-- Evento não encontrado para atualização. Selecione um evento válido.
		FreeObj(oUtils)
		Return jResponse
	EndIf

	jResponse    := JsonObject():New()
	oXmlMonitorEvent := TAFXmlMonitorEvent():New()
	jEvent           := jRequest["event"]
	jFields          := jEvent["fields"]
	aItems           := jEvent["items"]
	cCodEvent        := jEvent["event"]
	lHasFields       := Len(jFields:GetNames()) > 0
	nI               := 0
	cItem            := ""
	cCodTri          := ""
	lIsCBS           := .F.
	lRecLock         := .T.


	Begin Transaction
		If lRecLock := RecLock('T7A', .F.) //-- Update T7A
			If lHasFields
				T7A->T7A_EST    := GetAdvFVal("C09","C09_ID", FWxFilial("C09") + oUtils:getSafeProperty(jFields, 'stateAuthor', ''), 1)
				T7A->T7A_TPAUT  := oUtils:getSafeProperty(jFields, 'authorType', '')
				T7A->T7A_PGTO   := oUtils:getSafeProperty(jFields, 'dischargeIndicator', '')
				T7A->T7A_INDACE := oUtils:getSafeProperty(jFields, 'acceptanceIndicator', '')
				T7A->T7A_DTPREV := SToD(StrTran(oUtils:getSafeProperty(jFields, 'deliveryDate', ''), '-', ''))
			EndIf
			T7A->(MsUnlock())
		EndIf

		For nI := 1 To Len(aItems)
			cItem := PadR(aItems[nI]["item"],iItem)
			lIsCBS := !Empty(aItems[nI]["codTriCbs"])
			lIsIBS := !Empty(aItems[nI]["codTriIbs"])
			lDuplicateLine := lIsCBS .And. lIsIBS

			For nJ := 1 To 2
				// Determina o tributo correto (CBS ou IBS)
				cCodTri := Iif( (lDuplicateLine .And. nJ == 1) .Or. (lIsCBS .And. nJ != 2), aItems[nI]["codTriCbs"], aItems[nI]["codTriIbs"] )

				If cCodEvent == "211110"
					// ==== UPDATE T7B (evento 211110) ====
					If Self:lOk := T7B->(MsSeek(FWxFilial("T7B") + cIdent + cItem + cCodTri))
						If lRecLock := RecLock("T7B", .F.)
							T7B->T7B_VLBASE := aItems[nI]["baseCreditPresumed"]
							T7B->T7B_CODCRE := aItems[nI][ IIf( (lDuplicateLine .And. nJ == 1) .Or. (lIsCBS .And. nJ != 2), "creditClassificationCbs", "creditClassificationIbs") ]
							T7B->T7B_PERC   := aItems[nI][ IIf( (lDuplicateLine .And. nJ == 1) .Or. (lIsCBS .And. nJ != 2), "creditPercentageCbs", "creditPercentageIbs") ]
							T7B->T7B_VALOR  := aItems[nI][ IIf( (lDuplicateLine .And. nJ == 1) .Or. (lIsCBS .And. nJ != 2), "creditValueCbs", "creditValueIbs") ]
							T7B->(MsUnlock())
						EndIf
					Else
						cMessage := STR0012 //-- Erro ao atualizar evento. Item não encontrado na base.
						cDetailMessage := STR0013 + " " + cItem + " " + STR0014 + " " + cCodTri //-- Item: xxxx - Código do tributo: xxxx
						Exit
					EndIf
				Else
					// ==== UPDATE T7C (demais eventos) ====
					If Self:lOk := T7C->(MsSeek(FWxFilial("T7C") + cIdent + cItem + cCodTri))
						If lRecLock := RecLock("T7C", .F.)
							T7C->T7C_QUANT := aItems[nI]["quantity"]
							T7C->T7C_UM    := Posicione("C1J", 1, FWxFilial("C1J") + AllTrim(aItems[nI]["unit"]), "C1J_ID")
							T7C->T7C_VALOR := aItems[nI][ IIf( (lDuplicateLine .And. nJ == 1) .Or. (lIsCBS .And. nJ != 2), "taxValueCbs", "taxValueIbs") ]
							T7C->(MsUnlock())
						EndIf
					Else
						cMessage := STR0015 //-- Erro ao atualizar evento. Item não encontrado na base.
						cDetailMessage := STR0013 + " " + cItem + " " + STR0014 + " " + cCodTri
						Exit
					EndIf
				EndIf

				// Se não existe duplicidade CBS/IBS para o item, grava apenas 1 vez
				If !lDuplicateLine
					Exit
				EndIf
			Next nJ
		Next nI

		If !Self:lOk .Or. !lRecLock
			cMessage := Iif(!lRecLock, STR0016 /*Os registros se encontram em uso por outro usuário.*/, cMessage)
			cDetailMessage := Iif(!lRecLock, STR0017 /*Aguarde alguns minutos para tentar novamente.*/, cDetailMessage)

			DisarmTransaction()
			Self:nCode := 401
			jResponse := oUtils:setClassResponse(Self:nCode, cMessage, cDetailMessage)
		EndIf
	End Transaction

	If Self:lOk
		oXmlMonitorEvent:TafScheduleXmlMonitorEvent()
		jResponse := oUtils:setClassResponse(Self:nCode, STR0018) //-- Evento atualizado com sucesso.
		jResponse["id"] := cIdent
	EndIf

	FwFreeArray(aItems)
	FreeObj(jRequest)
	FreeObj(jEvent)
	FreeObj(jFields)
	FreeObj(oXmlMonitorEvent)
	FreeObj(oUtils)
Return jResponse

//-----------------------------------------------------------------------
/*/{Protheus.doc} getQueryEvents
Funcao que constroi a query SQL para obtencao dos eventos

@type function
@version 1.0
@author Misael Ramos
@since 19/11/2025
@param cIdEvent, character, codigo do evento
@return character, Retorna a query SQL
/*/
//-----------------------------------------------------------------------
Method getQueryEvents(cTypeEvent as character) as character Class WSEventsRepository

	Local cQuery := "" as character

	Do Case
	Case cTypeEvent == "EVENT_MODEL_1"
		cQuery := "SELECT #QueryFields# "
		cQuery += " FROM " + RetSqlName("T7A") + " T7A "
		cQuery += "INNER JOIN " + RetSqlName("C09") + " C09 "
		cQuery += " ON  C09.C09_FILIAL = '" + FwXFilial("C09") + "'"
		cQuery += " AND C09.C09_ID	   = T7A.T7A_EST "
		cQuery += "	AND C09.D_E_L_E_T_ = ' ' "
		cQuery += "WHERE #QueryWhere# "
	Case cTypeEvent == "EVENT_MODEL_2"
		cQuery := "SELECT #QueryFields# "
		cQuery += " FROM " + RetSqlName("T7A") + " T7A "
		cQuery += "LEFT JOIN " + RetSqlName("T7B") + " T7B "
		cQuery += " ON  T7B.T7B_FILIAL = '" + FwXFilial("T7B") + "'"
		cQuery += " AND T7B.T7B_IDENT  = T7A.T7A_IDENT "
		cQuery += " AND T7B.D_E_L_E_T_ = ' ' "
		cQuery += "INNER JOIN " + RetSqlName("T7C") + " T7C "
		cQuery += " ON  T7C.T7C_FILIAL = '" + FwXFilial("T7C") + "'"
		cQuery += " AND T7C.T7C_IDENT  = T7A.T7A_IDENT "
		cQuery += " AND T7C.D_E_L_E_T_ = ' ' "
		cQuery += "INNER JOIN " + RetSqlName("C09") + " C09 "
		cQuery += " ON  C09.C09_FILIAL = '" + FwXFilial("C09") + "'"
		cQuery += " AND C09.C09_ID	   = T7A.T7A_EST "
		cQuery += "	AND C09.D_E_L_E_T_ = ' ' "
		cQuery += "INNER JOIN "  + RetSqlName("C1J") + " C1J "
		cQuery += "	ON  C1J.C1J_FILIAL = '" + FwXFilial("C1J") + "'"
		cQuery += "	AND C1J.C1J_ID     = T7C.T7C_UM "
		cQuery += "	AND C1J.D_E_L_E_T_ = ' ' "
		cQuery += "WHERE #QueryWhere# "
		cQuery += " GROUP BY T7A_FILIAL, T7A_TPEVEN, T7C_ITEM, C09_UF, T7A_TPAUT, C1J_CODIGO, T7C_QUANT "
	Case cTypeEvent == "EVENT_MODEL_3"
		cQuery := "SELECT #QueryFields# "
		cQuery += " FROM " + RetSqlName("T7A") + " T7A "
		cQuery += "INNER JOIN " + RetSqlName("C09") + " C09 "
		cQuery += " ON  C09.C09_FILIAL = '" + FwXFilial("C09") + "'"
		cQuery += " AND C09.C09_ID	   = T7A.T7A_EST "
		cQuery += "	AND C09.D_E_L_E_T_ = ' ' "
		cQuery += "WHERE #QueryWhere# "
	Case cTypeEvent == "EVENT_MODEL_4"
		cQuery := "SELECT #QueryFields# "
		cQuery += " FROM " + RetSqlName("T7A") + " T7A "
		cQuery += "LEFT JOIN " + RetSqlName("T7B") + " T7B "
		cQuery += " ON  T7B.T7B_FILIAL = '" + FwXFilial("T7B") + "'"
		cQuery += " AND T7B.T7B_IDENT  = T7A.T7A_IDENT "
		cQuery += " AND T7B.D_E_L_E_T_ = ' ' "
		cQuery += "INNER JOIN " + RetSqlName("T7C") + " T7C "
		cQuery += " ON  T7C.T7C_FILIAL = '" + FwXFilial("T7C") + "'"
		cQuery += " AND T7C.T7C_IDENT  = T7A.T7A_IDENT "
		cQuery += " AND T7C.D_E_L_E_T_ = ' ' "
		cQuery += "INNER JOIN " + RetSqlName("C09") + " C09 "
		cQuery += " ON  C09.C09_FILIAL = '" + FwXFilial("C09") + "'"
		cQuery += " AND C09.C09_ID	   = T7A.T7A_EST "
		cQuery += "	AND C09.D_E_L_E_T_ = ' ' "
		cQuery += "WHERE #QueryWhere# "
		cQuery += "GROUP BY T7A_FILIAL, T7A_TPEVEN, T7C_ITEM, C09_UF, T7A_TPAUT "
	Case cTypeEvent == "EVENT_MODEL_5"
		cQuery := "SELECT #QueryFields# "
		cQuery += " FROM " + RetSqlName("T7A") + " T7A "
		cQuery += "INNER JOIN " + RetSqlName("T7B") + " T7B "
		cQuery += " ON  T7B.T7B_FILIAL = '" + FwXFilial("T7B") + "'"
		cQuery += " AND T7B.T7B_IDENT  = T7A.T7A_IDENT "
		cQuery += " AND T7B.D_E_L_E_T_ = ' ' "
		cQuery += "LEFT JOIN " + RetSqlName("T7C") + " T7C "
		cQuery += " ON  T7C.T7C_FILIAL = '" + FwXFilial("T7C") + "'"
		cQuery += " AND T7C.T7C_IDENT  = T7A.T7A_IDENT "
		cQuery += " AND T7C.D_E_L_E_T_ = ' ' "
		cQuery += "INNER JOIN " + RetSqlName("C09") + " C09 "
		cQuery += " ON  C09.C09_FILIAL = '" + FwXFilial("C09") + "'"
		cQuery += " AND C09.C09_ID	   = T7A.T7A_EST "
		cQuery += "	AND C09.D_E_L_E_T_ = ' ' "
		cQuery += "INNER JOIN " + RetSqlName("T7E") + " T7E "
		cQuery += " ON  T7E.T7E_FILIAL = '" + FwXFilial("T7E") + "'"
		cQuery += " AND T7E.T7E_EVENTO = T7A.T7A_TPEVEN "
		cQuery += " AND T7E.D_E_L_E_T_ = ' ' "
		cQuery += "WHERE #QueryWhere# "
		cQuery += "GROUP BY T7A_FILIAL, T7A_TPEVEN, T7B_ITEM, C09_UF, T7B_VLBASE, T7E_AUTOR "
	Case cTypeEvent == "EVENT_MODEL_6"
		cQuery := "SELECT #QueryFields# "
		cQuery += " FROM " + RetSqlName("T7A") + " T7A "
		cQuery += "INNER JOIN " + RetSqlName("C09") + " C09 "
		cQuery += " ON  C09.C09_FILIAL = '" + FwXFilial("C09") + "'"
		cQuery += " AND C09.C09_ID	   = T7A.T7A_EST "
		cQuery += "	AND C09.D_E_L_E_T_ = ' ' "
		cQuery += "WHERE #QueryWhere# "
	Case cTypeEvent == "EVENT_CODE"
		cQuery := "SELECT #QueryFields# "
		cQuery += " FROM " + RetSqlName("T7A") + " T7A "
		cQuery += "WHERE #QueryWhere# "
	EndCase

Return cQuery


//-----------------------------------------------------------------------
/*/{Protheus.doc} GetValorTrib
Retorna string que irá definir o campo Valor do Tributo

@type function
@version 1.0
@author Misael Ramos
@since 20/11/2025
@param cCodPresumido, character, Código presumido do tributo
@param cCodTrib, character, Códigos dos tributos
@return character, Retorna a string que define o campo Valor do Tributo
/*/
//-----------------------------------------------------------------------
Static Function GetValorTrib(cCodPresumido as character, cCodTrib as character, cCampoQry as character) as character

	Local cRetValue   := "" as character
	Local cValueEmpty := "" as character

	If cCampoQry == 'T7B_CODTRI' .Or. cCampoQry == 'T7C_CODTRI'
		cValueEmpty := "''"
	Else
		cValueEmpty := "0"
	EndIf

	cRetValue := " MAX( "
	cRetValue += " CASE "
	cRetValue += " 	WHEN T7A_TPEVEN = '" + cCodPresumido + "' THEN "
	cRetValue += " 		CASE WHEN T7B_CODTRI IN (" + cCodTrib + ") "
	cRetValue += "			THEN " + cCampoQry + " ELSE " + cValueEmpty + " END "
	cRetValue += " 	ELSE "
	cRetValue += " 		CASE WHEN T7C_CODTRI IN (" + cCodTrib + ") "
	cRetValue += "			THEN " + cCampoQry + " ELSE " + cValueEmpty + " END "
	cRetValue += " END "
	cRetValue += " ) "

Return cRetValue

//-----------------------------------------------------------------------
/*/{Protheus.doc} getFilterEvent
Funcao que construi a clausula WHERE para filtragem do evento

@type function
@version 1.0
@author Misael Ramos
@since 20/11/2025
@param cIdEvent, character, codigo do evento
@return character, Retorna a clausula WHERE para filtragem
/*/
//-----------------------------------------------------------------------
Static Function getFilterEvent(cIdEvent as character) as character

	Local cWhere := "" as character

	cWhere := " T7A.T7A_FILIAL = '" + FwXFilial("T7A") + "'"
	cWhere += " AND T7A.T7A_IDENT = '" + cIdEvent + "'"
	cWhere += " AND T7A.D_E_L_E_T_ = ' ' "

Return cWhere

//-----------------------------------------------------------------------
/*/{Protheus.doc} getOrderEvent
Funcao que retorna a ordenacao dos dados para a query

@type function
@version 1.0
@author Misael Ramos
@since 20/11/2025
@return character, Retorna a ordenacao dos dados para a query
/*/
//-----------------------------------------------------------------------
Static Function getOrderEvent() as character

	Local cOrder := "" as character

	cOrder := " T7A_FILIAL,	T7A_TPEVEN "

Return cOrder

//-----------------------------------------------------------------------
/*/{Protheus.doc} WSEventsRepository::putEventRelay
Metodo responsavel por transmitir um evento pelo ID

@type method
@version 1.0
@author Misael Ramos
@since 20/11/2025
@param cIdEvent, character, codigo do evento
@return json, retorna a resposta em formato JSON
/*/
//-----------------------------------------------------------------------
Method putEventRelay(cIdEvent as character) as json Class WSEventsRepository

	Local aArea	 := GetArea() as array
	Local jRet   := Nil as json
	Local oEvent := Nil as object

	DbSelectArea("T7A")
	T7A->(DbSetOrder(1))

	jRet := JsonObject():New()

	If T7A->(MsSeek(FwXFilial("T7A") + cIdEvent))

		If RecLock("T7A", .F.)

			T7A->T7A_STATUS	:= "1"
			T7A->(MsUnLock())

			jRet["lOk"] := .T.
			jRet["message"] := STR0004 //"Evento retransmitido com sucesso."

			oEvent := totvs.protheus.fiscal.taf.event.TAFXmlMonitorEvent():New()
			oEvent:TafScheduleXmlMonitorEvent()

		EndIf

	Else

		jRet["lOk"] := .F.
		jRet["errorCode"] := 404
		jRet["errorMessage"] := STR0005 //"Evento não encontrado."

	EndIf

	RestArea(aArea)
	FwFreeArray(aArea)
	FWFreeObj(oEvent)

Return jRet

//-----------------------------------------------------------------------
/*/{Protheus.doc} WSEventsRepository::putEventCancel
Metodo responsavel por cancelar um evento pelo ID

@type method
@version 1.1
@author Misael Ramos
@since 19/11/2025
@param cIdEvent, character, codigo do evento
@return json, retorna a resposta em formato JSON
/*/
//-----------------------------------------------------------------------
Method putEventCancel(cIdEvent as character) as json Class WSEventsRepository

	Local aArea	    := GetArea() 				   as array
	Local jRet      := Nil       				   as json
	Local oEvent    := Nil       				   as object

	DbSelectArea("T7A")
	T7A->(DbSetOrder(1))

	jRet := JsonObject():New()

	If MsSeek(FwXFilial("T7A") + cIdEvent)
		If RecLock("T7A", .F.)
			T7A->T7A_CANC   := "1"

			If T7A->T7A_STATUS == "1" .or. T7A->T7A_STATUS == "5"
				T7A->T7A_STATUS	:= "4"
			Else
				T7A->T7A_STATUS	:= "3"

				oEvent := totvs.protheus.fiscal.taf.event.TAFXmlMonitorEvent():New()
				oEvent:TafScheduleXmlMonitorEvent()
			EndIf

			jRet["lOk"]     := .T.
			jRet["message"] := STR0003 //"Evento cancelado com sucesso."
			T7A->(MsUnLock())
		EndIf
	Else

		jRet["lOk"] := .F.
		jRet["errorCode"] := 404
		jRet["errorMessage"] := STR0005 //"Evento não encontrado."

	EndIf

	RestArea(aArea)
	FwFreeArray(aArea)
	FWFreeObj(oEvent)

Return jRet

//-----------------------------------------------------------------------
/*/{Protheus.doc} WSEventsRepository::getEventById
Metodo responsavel por consultar um evento pelo ID

@type method
@version 1.0
@author Misael Ramos
@since 19/11/2025
@param cIdEvent, character, codigo do evento
@return json, retorna a resposta em formato JSON
/*/
//-----------------------------------------------------------------------
Method getEventById(cTypeEvent as character, cIdEvent as character) Class WSEventsRepository

	Local aArea	 := GetArea() as array
	Local cQuery := "" as character
	Local cWhere := "" as character
	Local cOrder := "" as character

	cQuery := ::getQueryEvents(cTypeEvent)
	cWhere := getFilterEvent(cIdEvent)
	cOrder := getOrderEvent()

	::setMapFieldsEvents(cTypeEvent)
	::setPage(1)
	::setPageSize(1000)
	::SetQuery(cQuery)
	::SetWhere(cWhere)
	::SetOrder(cOrder)
	::SetIsCaseSensitive(.T.)

	If ::Execute()
		::FillGetResponse()
	EndIf

	RestArea(aArea)
	FwFreeArray(aArea)

Return
/*/{Protheus.doc} postInsertEvents
	Insere evento para os documentos fiscais.
@author Pâmela Bernardo
@since 28/01/2025
@param jRequest, json, json da requisição.
@return jResponse, json, json de resposta.
/*/
Method postInsertEvents(jRequest As Json) As Json Class WSEventsRepository
	Local oUtils           As Object
	Local jResponse        As Json
	Local jEvent           As Json
	Local cChvNfe          As Character
	Local cTabelaorigem    As Character
	Local cRotinaorigem    As Character
	Local cXml             As Character
	Local cCodEvent        As Character
	Local oScheduleProcessing As Object
	Local lIncluiFila         As Logical
	Local oXml				 As Json


	Default jRequest := JsonObject():New()

	cChvNfe := jRequest['chvnfe']
	cTabelaorigem := jRequest['originTable']
	cRotinaorigem := jRequest['originRoutine']
	oUtils := Utils():New()
	Self:nCode := 200

	oXml := JsonObject():new()
	jResponse        := JsonObject():New()
	jEvent           := jRequest['event']
	cCodEvent        := jEvent["event"]
	cXml             := jRequest:ToJson()

	lIncluiFila     := FindClass('totvs.protheus.fiscal.taf.event.Processingqueue') .And. TAFAlsInDic("T7S")

	If lIncluiFila .And.!Empty(cChvNfe) .And. !Empty(cTabelaorigem) .And. !Empty(cRotinaorigem) .And. !Empty(cCodEvent)
		RecLock("T7S",.T.)
		T7S->T7S_FILIAL  := FWxFilial("T7S")
		T7S->T7S_IDPROC  := FWUUIDv4(.T.)
		T7S->T7S_ORIGEM  := jRequest['originRoutine']
		T7S->T7S_TABELA  := jRequest['originTable']
		T7S->T7S_CHVNFE  := jRequest['chvnfe']
		T7S->T7S_XML     := cXml
		T7S->T7S_EVENTO  := cCodEvent
		T7S->(MsUnLock())

		oScheduleProcessing := totvs.protheus.fiscal.taf.event.Processingqueue():New()
		oScheduleProcessing:TafScheduleProcessingqueue()

		jResponse := oUtils:setClassResponse(Self:nCode, STR0020)//"Evento adicionado a fila de processamento"
	Else
		Self:nCode := 401
		jResponse := oUtils:setClassResponse(Self:nCode,STR0021 ,STR0022 )//"Parâmetros inválidos"###"Informe os parâmetros chvnfe, originTable, originRoutine e event corretamente."
	EndIf
	FreeObj(oUtils)
	FreeObj(oScheduleProcessing)
Return jResponse

/*/{Protheus.doc} getItemsByChvNf
	Obtém os itens de uma NFE com base na chave da NFE.
@author Pâmela Bernardo
@since 07/05/2026
@param cChvNf, character, chave da NFE.
@param jBatch, json, lote de eventos para atualização dos itens.
@param lCreditoPresumido, logical, indica se o crédito presumido deve ser considerado.
@return aItems, array, lista de itens da NFE.
*/
Method getItemsByChvNf(cChvNf As Character,jBatch as Json,lCreditoPresumido As Logical) As Array Class WSEventsRepository
    Local aItems      As Array
    Local cAliasQuery As Character
    Local cFilC30     As Character
    Local cQuery      As Character
    Local jItem       As Json
    

    Default cChvNf := ''

    aItems      := {}
    cAliasQuery := ''
    cFilC30     := FWxFilial('C30')

    If !Empty(cChvNf)
		If ::oItemsByChvNf == Nil

			cQuery  := " SELECT "
			cQuery += "     C30.C30_ITEXML ITEM, "
			cQuery += "     C30.C30_QTDXML QUANTITY, "
			cQuery += "     C30.C30_UMXML UNIT, "
			cQuery += "     MAX(CASE WHEN C35.C35_CODTRI IN ('000031', '000032', '000033', '000039', '000040') THEN C35.C35_CODTRI ELSE '' END) CODTRICBS, "
			cQuery += "     MAX(CASE WHEN C35.C35_CODTRI IN ('000042', '000043', '000044', '000045', '000046', '000047', '000048', '000049') THEN C35.C35_CODTRI ELSE '' END) CODTRIIBS, "
			cQuery += "     MAX(CASE WHEN C35.C35_CODTRI IN ('000031', '000032', '000033', '000039', '000040') THEN C35.C35_VALOR ELSE 0 END) TAXVALUECBS, "
			cQuery += "     MAX(CASE WHEN C35.C35_CODTRI IN ('000042', '000043', '000044', '000045', '000046', '000047', '000048', '000049') THEN C35.C35_VALOR ELSE 0 END) TAXVALUEIBS, "
			cQuery += "     MAX(CASE WHEN C35.C35_CODTRI IN ('000031', '000032', '000033', '000039', '000040', '000042', '000043', '000044', '000045', '000046', '000047', '000048', '000049') THEN C35.C35_BASE ELSE 0 END) BASECREDITPRESUMED "
			cQuery += " FROM " + RetSqlName('C30') + " C30 "
			cQuery += " LEFT JOIN " + RetSqlName('C35') + " C35 ON "
			cQuery += "     C35.C35_FILIAL = C30.C30_FILIAL AND "
			cQuery += "     C35.C35_CHVNF  = C30.C30_CHVNF  AND "
			cQuery += "     C35.C35_NUMITE = C30.C30_NUMITE AND "
			cQuery += "     C35.C35_CODTRI IN ('000031', '000032', '000033', '000039', '000040', '000042', '000043', '000044', '000045', '000046', '000047', '000048', '000049') AND "
			cQuery += "     C35.D_E_L_E_T_ = ' ' "
			cQuery += " WHERE C30.C30_FILIAL = ? "
			cQuery += "   AND C30.C30_CHVNF  = ? "
			cQuery += "   AND C30.D_E_L_E_T_ = ' ' "
			cQuery += " GROUP BY C30.C30_ITEXML, C30.C30_QTDXML, C30.C30_UMXML "
			cQuery += " ORDER BY C30.C30_ITEXML "

			::oItemsByChvNf := FwExecStatement():New(ChangeQuery(cQuery))
		EndIf
		::oItemsByChvNf:SetString(1, cFilC30)
		::oItemsByChvNf:SetString(2, cChvNf)
		cAliasQuery := ::oItemsByChvNf:OpenAlias()

		While (cAliasQuery)->(!EoF())
			jItem := JsonObject():New()
			jItem['item']               := (cAliasQuery)->ITEM
			jItem['codTriCbs']          := AllTrim((cAliasQuery)->CODTRICBS)
			jItem['codTriIbs']          := AllTrim((cAliasQuery)->CODTRIIBS)
			jItem['taxValueCbs']        := (cAliasQuery)->TAXVALUECBS
			jItem['taxValueIbs']        := (cAliasQuery)->TAXVALUEIBS
			jItem['quantity']           := (cAliasQuery)->QUANTITY
			jItem['unit']               := (cAliasQuery)->UNIT
			jItem['baseCreditPresumed'] := (cAliasQuery)->BASECREDITPRESUMED
			jItem['creditValueCbs']     := (cAliasQuery)->TAXVALUECBS
			jItem['creditValueIbs']     := (cAliasQuery)->TAXVALUEIBS

			If lCreditoPresumido
				jItem['creditClassificationCbs']     := jBatch['creditClassification']
				jItem['creditClassificationIbs']     := jBatch['creditClassification']
				jItem['creditPercentageCbs']         := jBatch['creditPercentageCbs']
				jItem['creditPercentageIbs']         := jBatch['creditPercentageIbs']
			EndIf

			AAdd(aItems, jItem)
			(cAliasQuery)->(DbSkip())
		EndDo

		If !Empty(cAliasQuery)
			(cAliasQuery)->(DbCloseArea())
		EndIf
	EndIf
    
Return aItems


/*/{Protheus.doc} putBatchCancel
	Realiza o cancelamento do lote de eventos
	Atualiza campos em T7A e T7I de acordo com as regras de negócio
	@author Caique Carlos
	@since 22/05/2026
	@version 1.0
	@param cIdEvent, character, ID do evento [T7I_EVENTO|T7I_DTINC|T7I_SEQUEN]
	@return jResponse, Json, Resultado da operação
/*/
Method putBatchCancel(cIdEvent as character) as Json Class WSEventsRepository
	Local aArea	    := GetArea() 		        as array
	Local aIdLote   := StrTokArr(cIdEvent, "|") as array
	Local jResponse := JsonObject():New()       as json
	Local jReturn   := JsonObject():New() 		as json
	Local lContinue := .T. 						as logical
	Local lExisteT7I := TAFColumnPos( "T7I_CANC" ) as logical

	If lExisteT7I
		DbSelectArea("T7A")
		T7A->(DbSetOrder(3)) // T7A_FILIAL+T7A_TPEVEN+DTOS(T7A_DTEMIS)+T7A_SEQLOT
		If T7A->(MsSeek(FwXFilial("T7A") + aIdLote[1] + aIdLote[2] + aIdLote[3]))
			While  (T7A->T7A_FILIAL == FwXFilial("T7A") .and. T7A->T7A_TPEVEN == aIdLote[1]  .and. ;
					T7A->T7A_DTEMIS == SToD(aIdLote[2]) .and. T7A->T7A_SEQLOT == aIdLote[3]) .and. ;
					lContinue
				jReturn   := ::putEventCancel(T7A->T7A_IDENT)
				lContinue := jReturn["lOk"]
				T7A->(DbSkip())
			EndDo
		EndIf

		DbSelectArea("T7I")
		T7I->(DbSetOrder(1)) // T7I_FILIAL+T7I_EVENTO+DTOS(T7I_DTINC)+T7I_SEQUEN

		If lContinue .and. T7I->(MsSeek(FwXFilial("T7I") + aIdLote[1] + aIdLote[2] + aIdLote[3]))
			If RecLock("T7I", .F.) 
				T7I->T7I_CANC   := "1"

				If T7I->T7I_STATUS == "1" .or. T7I->T7I_STATUS == "5"
					T7I->T7I_STATUS := "4"
				Else
					T7I->T7I_STATUS := "3"
				EndIf

				T7I->(MsUnLock())

				jResponse["lOk"]     := .T.
				jResponse["id"] 	 := cIdEvent
				jResponse["message"] := STR0023 //"Lote cancelado com sucesso"
			EndIf
		Else 
			jResponse["lOk"]          := .F.
			jResponse["errorCode"]    := 404
			jResponse["errorMessage"] := STR0024 //"Lote e/ou evento não encontrado"
		EndIf
	EndIf
	RestArea(aArea)
	FwFreeArray(aArea)
	FwFreeArray(aIdLote)
	FWFreeObj(jReturn)

Return jResponse

/*/{Protheus.doc} putBatchRelay
	Realiza a retransmissão do lote de eventos
	Atualiza campos em T7A e T7I de acordo com as regras de negócio
	@author Caique Carlos
	@since 22/05/2026
	@version 1.0
	@param cIdEvent, character, ID do evento [T7I_EVENTO|T7I_DTINC|T7I_SEQUEN]
	@return jResponse, Json, Resultado da operação
/*/
Method putBatchRelay(cIdEvent as character) as Json Class WSEventsRepository
	Local aArea	    := GetArea() 		        as array
	Local aIdLote   := StrTokArr(cIdEvent, "|") as array
	Local jResponse := JsonObject():New()       as json
	Local jReturn   := JsonObject():New() 		as json
	Local lContinue := .T. 						as logical
	Local lExisteT7I := TAFColumnPos( "T7I_CANC" ) as logical

	If lExisteT7I
		DbSelectArea("T7A")
		T7A->(DbSetOrder(3)) // T7A_FILIAL+T7A_TPEVEN+DTOS(T7A_DTEMIS)+T7A_SEQLOT
	
		If T7A->(MsSeek(FwXFilial("T7A") + aIdLote[1] + aIdLote[2] + aIdLote[3]))
			While  T7A->T7A_FILIAL == FwXFilial("T7A") .and. T7A->T7A_TPEVEN == aIdLote[1]  .and. ;
					T7A->T7A_DTEMIS == SToD(aIdLote[2]) .and. T7A->T7A_SEQLOT == aIdLote[3] .and. ;
					lContinue 
				If !(T7A->T7A_STATUS $ "2|4")
					jReturn   := ::putEventRelay(T7A->T7A_IDENT)
					lContinue := jReturn["lOk"]
				EndIf
				T7A->(DbSkip())
			EndDo
		EndIf

		DbSelectArea("T7I")
		T7I->(DbSetOrder(1)) // T7I_FILIAL+T7I_EVENTO+DTOS(T7I_DTINC)+T7I_SEQUEN

		If lContinue .and. T7I->(MsSeek(FwXFilial("T7I") + aIdLote[1] + aIdLote[2] + aIdLote[3]))
			If RecLock("T7I", .F.) 
					T7I->T7I_STATUS := "1"
				T7I->(MsUnLock())

				jResponse["lOk"]     := .T.
				jResponse["id"] 	 := cIdEvent
				jResponse["message"] := STR0027//"Lote retransmitido com sucesso"
			EndIf
		Else 
			jResponse["lOk"]          := .F.
			jResponse["errorCode"]    := 404
			jResponse["errorMessage"] := STR0024 //"Lote e/ou evento não encontrado"
		EndIf
	EndIf
	RestArea(aArea)
	FwFreeArray(aArea)
	FwFreeArray(aIdLote)
	FWFreeObj(jReturn)

Return jResponse

