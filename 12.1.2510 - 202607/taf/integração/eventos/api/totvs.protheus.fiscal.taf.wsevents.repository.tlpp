#include 'tlpp-core.th'
#include 'tlpp-rest.th'
#include "totvs.protheus.fiscal.taf.wsevents.ch"

namespace totvs.protheus.fiscal.taf.event

/*/{Protheus.doc} WSEventsRepository
	Classe Adapter para o serviço de eventos
@author juan.felipe
@since 03/11/2025
/*/
Class WSEventsRepository FROM FWAdapterBaseV2
	protected data cCodPresumi as character
	protected data oUtil       as object
	public data cCodTribCbs as character
	public data cCodTribIbs as character
	public data cCodCredCbs as character
	public data cCodCredIbs as character
	public data oItemsByChvNf as object

	public Method New()
	public Method Get()
	private Method getQuery()
	private Method getWhere()
	private Method getQueryEvents()    As Character
	private Method addFields()
	public Method getSpeciesDocument() As Character
	public Method getTabIbs() as character
	public Method getTabCbs() as character
	private Method setMapFieldsEvents()
	private Method getNextLoteSequence() As Character
	private Method buildT7AHeaderData()  As Array
	private Method applyHeaderFieldsFromJson()
	private Method applyHeaderFieldsFromItem()
	private Method addItemsEvent211110()
	private Method addItemsGenericEvent()
	private Method addLoteData() 	 As Character
	private Method flushEventBulks() As Json
	public Method postinsertEvents() As Json
	public Method postSaveEvents()   As Json
	public Method putSaveEvents()    As Json
	public Method getEventById()
	public Method putEventRelay()  	 As Json
	public Method putEventCancel() 	 As Json
	public Method getItemsByChvNf()  As array
	public Method putBatchCancel()   As Json
	public Method putBatchRelay()   As Json
EndClass


/*/{Protheus.doc} New
	Método construtor
@author juan.felipe
@since 03/11/2025
/*/
Method New(cVerb) Class WSEventsRepository
	_Super:New(cVerb, .T.)
	::oUtil := Utils():New()

	::cCodPresumi := "211110"
	::cCodCredCbs := "'000033'"
	::cCodCredIbs := "'000046'"
	::cCodTribCbs := "'000031', '000032', '000039', '000040'"
	::cCodTribIbs := "'000042', '000044', '000045', '000047', '000048', '000049'"
	::oItemsByChvNf := Nil
Return Self

/*/{Protheus.doc} Get
	Consulta Eventos
@author juan.felipe
@since 03/11/2025
@param nPage, numeric, número da pagina.
@param nPageSize, numeric, tamanho da página.
@param nOption, numeric, opção de consulta.
@param jQuery, json, parâmetros da requisição.
@return Nil, nulo.
/*/
Method Get(nPage, nPageSize, nOption, jQuery) class WSEventsRepository
	Local aArea As Array
	Local aQueryRequest As Array
	Local cWhere As Character
	Local oUtils As Object

	Default nPage := 1
	Default nPageSize := 10
	Default nOption := 0
	Default jQuery := JsonObject():New()

	If Self:lOk
		DbSelectArea('T7E')
		aArea := FwGetArea()
		aQueryRequest := {}
		cWhere := Self:getWhere(nOption, jQuery)
		oUtils := Utils():New()

		If nOption == 1 .And. nPageSize < 30
			nPageSize := 30 //-- Paginação fixa para listagem de eventos caso tenha o tamanho da página menor que 30
		EndIf

		Self:addFields(nOption)

		Self:setPage(nPage)
		Self:setPageSize(nPageSize)
		Self:setIsCaseSensitive(.T.)
		Self:SetQuery(Self:getQuery(nOption,jQuery:GetJsonObject('chvnf') ))
		Self:SetWhere(cWhere)
		Self:SetUseSpaces(.T.)

		If nOption == 1
			Self:SetOrder(SqlOrder(T7E->(IndexKey(1))))
		EndIf

		aQueryRequest := oUtils:queryRequestToArray(oRest:getQueryRequest())

		If Len(aQueryRequest) > 0 .And. nOption != 2 .And. nOption != 3
			Self:SetUrlFilter(aQueryRequest)
		EndIf

		Self:SetFields(oUtils:getQueryParam('FIELDS'))
		Self:SetOrderQuery(oUtils:getQueryParam('ORDER'))

		If Self:Execute()
			Self:FillGetResponse()
		EndIf

		FwRestArea(aArea)
		FwFreeArray(aArea)
		FwFreeArray(aQueryRequest)
		FreeObj(oUtils)
	EndIf
Return Nil

/*/{Protheus.doc} addFields
	Cria o Mapa de campos Protheus x API.
@author juan.felipe
@since 03/11/2025
@param Self:, object, Objeto - Objeto com herança da classe FWAdapterBaseV2.
@param nOption, numeric, opção de consulta.
@return Nil, nulo.
/*/
Method addFields(nOption as numeric) Class WSEventsRepository
	Default nOption := 1

	If nOption == 1
		Self:AddMapFields('id'         , 'T7E_EVENTO', .T., .F., {'T7E_EVENTO', 'C', TamSX3('T7E_EVENTO')[1], 0})
		Self:AddMapFields('description', 'T7E_DESCRI', .T., .T., {'T7E_DESCRI', 'C', TamSX3('T7E_DESCRI')[1], 0})
		Self:AddMapFields('haveItem'   , 'T7E_TEMITE', .T., .T., {'T7E_TEMITE', 'C', TamSX3('T7E_TEMITE')[1], 0})
	ElseIf nOption == 2
		Self:AddMapFields('branch'       , 'C20_FILIAL', .F., .T., {'C20_FILIAL', 'C', TamSX3('C20_FILIAL')[1], 0})
		Self:AddMapFields('docType'      , 'C20_CODMOD', .T., .T., {'C20_CODMOD', 'C', TamSX3('C20_CODMOD')[1], 0}, " CASE WHEN C20_CODMOD = '000029' THEN 'NF-e' ELSE ' ' END ")
		Self:AddMapFields('nfType'       , 'C20_INDOPE', .T., .T., {'C20_INDOPE', 'C', TamSX3('C20_INDOPE')[1], 0}, " CASE WHEN C20_INDOPE = '0' THEN 'Entrada' ELSE 'Saída' END ")
		Self:AddMapFields('invoiceNumber', 'C20_NUMDOC', .T., .T., {'C20_NUMDOC', 'C', TamSX3('C20_NUMDOC')[1], 0})
		Self:AddMapFields('serie'        , 'C20_SERIE' , .T., .T., {'C20_SERIE' , 'C', TamSX3('C20_SERIE' )[1], 0})
		Self:AddMapFields('cnpjSupplier' , 'DOCNUM'    , .T., .T., {'DOCNUM'    , 'C', TamSX3('C1H_CNPJ'  )[1], 0}, " CASE WHEN C1H_CNPJ = ' ' THEN C1H_CPF ELSE C1H_CNPJ END ")
		Self:AddMapFields('supplier'     , 'C1H_NOME'  , .T., .T., {'C1H_NOME'  , 'C', TamSX3('C1H_NOME'  )[1], 0})
		Self:AddMapFields('chvnf'        , 'C20_CHVNF' , .T., .T., {'C20_CHVNF' , 'C', TamSX3('C20_CHVNF' )[1], 0})
	ElseIf nOption == 3
		Self:AddMapFields('codItem'    , 'C30_ITEXML', .T., .T., {'C30_ITEXML', 'C', TamSX3('C30_ITEXML')[1], 0})
		Self:AddMapFields('description', 'C1L_DESCRI', .T., .T., {'C1L_DESCRI', 'C', TamSX3('C1L_DESCRI')[1], 0})
		Self:AddMapFields('ncm'        , 'C0A_CODIGO', .T., .T., {'C0A_CODIGO', 'C', TamSX3('C0A_CODIGO')[1], 0}, " Coalesce(C0A_CODIGO,'') ")
		Self:AddMapFields('ibs'        , 'IBS'       , .T., .T., {'IBS'       , 'N', TamSX3('C35_VALOR' )[1], 0}, " Coalesce(IBS_VALOR,0) ")
		Self:AddMapFields('cbs'        , 'CBS'       , .T., .T., {'CBS'       , 'N', TamSX3('C35_VALOR' )[1], 0}, " Coalesce(CBS_VALOR,0) ")
		Self:AddMapFields('amount'     , 'C30_QTDXML', .T., .T., {'C30_QTDXML', 'N', TamSX3('C30_QTDXML')[1], 0})
		Self:AddMapFields('valueTotal' , 'C30_TOTAL' , .T., .T., {'C30_TOTAL' , 'N', TamSX3('C30_TOTAL' )[1], 0})
	EndIf
Return Nil

//-----------------------------------------------------------------------
/*/{Protheus.doc} WSEventsRepository::setMapFields
Metodo responsavel por chamar todos os mapeamentos de campos

@type method
@version 1.0
@author Misael Ramos
@since 19/11/2025
@param cTypeEvent, character, tipo do modelo de evento que sera mapeado
/*/
//-----------------------------------------------------------------------
Method setMapFieldsEvents(cTypeEvent as character) Class WSEventsRepository
	Do Case
	Case cTypeEvent == "EVENT_MODEL_1"
		Self:AddMapFields("stateAuthor", 			"C09_UF", 	 	.T., .T., { "C09_UF",	  'C', ::oUtil:GetFieldLength('C09_UF'), 		0 })
		Self:AddMapFields("dischargeIndicator", 	"T7A_PGTO", 	.T., .T., { "T7A_PGTO",   'C', ::oUtil:GetFieldLength('T7A_PGTO'), 		0 })
		Self:AddMapFields("authorType", 			"T7A_TPAUT", 	.T., .T., { "T7A_TPAUT",  'C', ::oUtil:GetFieldLength('T7A_TPAUT'), 	0 })
	Case cTypeEvent == "EVENT_MODEL_2"
		Self:AddMapFields("item", 	   				"T7C_ITEM", 	.T., .T., { "T7C_ITEM",   'C', ::oUtil:GetFieldLength('T7C_ITEM'),  	0 })
		Self:AddMapFields("stateAuthor", 	   		"C09_UF", 		.T., .T., { "C09_UF", 	  'C', ::oUtil:GetFieldLength('C09_UF'),  	 	0 })
		Self:AddMapFields("taxValueCbs", 	  		"TAX_CBS", 		.T., .T., { "TAX_CBS", 	  'N', ::oUtil:GetFieldLength('T7C_VALOR'),  	::oUtil:GetFieldDecimal('T7C_VALOR') }, GetValorTrib(::cCodPresumi, ::cCodTribCbs, 'T7C_VALOR'))
		Self:AddMapFields("taxValueIbs", 			"TAX_IBS", 		.T., .T., { "TAX_IBS", 	  'N', ::oUtil:GetFieldLength('T7C_VALOR'),  	::oUtil:GetFieldDecimal('T7C_VALOR') }, GetValorTrib(::cCodPresumi, ::cCodTribIbs, 'T7C_VALOR'))
		Self:AddMapFields("quantity", 		  		"T7C_QUANT", 	.T., .T., { "T7C_QUANT",  'N', ::oUtil:GetFieldLength('T7C_QUANT'),	    ::oUtil:GetFieldDecimal('T7C_QUANT') })
		Self:AddMapFields("unit", 			  		"C1J_CODIGO",  	.T., .T., { "C1J_CODIGO", 'C', ::oUtil:GetFieldLength('C1J_CODIGO'), 	0 })
		Self:AddMapFields("authorType",				"T7A_TPAUT", 	.T., .T., { "T7A_TPAUT",  'C', ::oUtil:GetFieldLength('T7A_TPAUT'),  	0 })
		Self:AddMapFields("codTriCbs",				"COD_TRICBS", 	.T., .T., { "COD_TRICBS", 'C', ::oUtil:GetFieldLength('T7C_CODTRI'), 	0 }, GetValorTrib(::cCodPresumi, ::cCodTribCbs, 'T7C_CODTRI'))
		Self:AddMapFields("codTriIbs",				"COD_TRIIBS", 	.T., .T., { "COD_TRIIBS", 'C', ::oUtil:GetFieldLength('T7C_CODTRI'), 	0 }, GetValorTrib(::cCodPresumi, ::cCodTribIbs, 'T7C_CODTRI'))
	Case cTypeEvent == "EVENT_MODEL_3"
		Self:AddMapFields("stateAuthor", 			"C09_UF",   	.T., .T., { "C09_UF",     'C', ::oUtil:GetFieldLength('C09_UF'), 	 	0 })
		Self:AddMapFields("acceptanceIndicator",	"T7A_INDACE",  	.T., .T., { "T7A_INDACE", 'C', ::oUtil:GetFieldLength('T7A_INDACE'),  	0 })
		Self:AddMapFields("authorType",				"T7A_TPAUT",  	.T., .T., { "T7A_TPAUT",  'C', ::oUtil:GetFieldLength('T7A_TPAUT'),  	0 })
	Case cTypeEvent == "EVENT_MODEL_4"
		Self:AddMapFields("item", 	   				"T7C_ITEM", 	.T., .T., { "T7C_ITEM",   'C', ::oUtil:GetFieldLength('T7C_ITEM'),  	0 })
		Self:AddMapFields("stateAuthor", 			"C09_UF",   	.T., .T., { "C09_UF",     'C', ::oUtil:GetFieldLength('C09_UF'), 	 	0 })
		Self:AddMapFields("taxValueCbs", 	  		"TAX_CBS", 		.T., .T., { "TAX_CBS", 	  'N', ::oUtil:GetFieldLength('T7C_VALOR'),  	::oUtil:GetFieldDecimal('T7C_VALOR') }, GetValorTrib(::cCodPresumi, ::cCodTribCbs, 'T7C_VALOR'))
		Self:AddMapFields("taxValueIbs", 			"TAX_IBS", 		.T., .T., { "TAX_IBS", 	  'N', ::oUtil:GetFieldLength('T7C_VALOR'),  	::oUtil:GetFieldDecimal('T7C_VALOR') }, GetValorTrib(::cCodPresumi, ::cCodTribIbs, 'T7C_VALOR'))
		Self:AddMapFields("authorType",				"T7A_TPAUT",  	.T., .T., { "T7A_TPAUT",  'C', ::oUtil:GetFieldLength('T7A_TPAUT'),  	0 })
		Self:AddMapFields("codTriCbs",				"COD_TRICBS", 	.T., .T., { "COD_TRICBS", 'C', ::oUtil:GetFieldLength('T7C_CODTRI'), 	0 }, GetValorTrib(::cCodPresumi, ::cCodTribCbs, 'T7C_CODTRI'))
		Self:AddMapFields("codTriIbs",				"COD_TRIIBS", 	.T., .T., { "COD_TRIIBS", 'C', ::oUtil:GetFieldLength('T7C_CODTRI'), 	0 }, GetValorTrib(::cCodPresumi, ::cCodTribIbs, 'T7C_CODTRI'))
	Case cTypeEvent == "EVENT_MODEL_5"
