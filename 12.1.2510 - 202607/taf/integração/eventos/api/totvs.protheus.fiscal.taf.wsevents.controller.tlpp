#include 'tlpp-core.th'
#include 'tlpp-rest.th'

namespace totvs.protheus.fiscal.taf.event

/*/{Protheus.doc} WSEventsController
	API de Eventos
@author juan.felipe
@since 31/10/2025
/*/
Class WSEventsController
	public Data nPage     As Integer
	public Data nPageSize As Integer

	public Method New()
	private Method setAnswer()

	@Get("/api/taf/fiscal/v1/listEvents")
	public Method getListEvents()

	@Get("/api/taf/fiscal/v1/documents")
	public Method getDocuments()

	@Get("/api/taf/fiscal/v1/items")
	public Method getItems()

	@Post("/api/taf/fiscal/v1/InsertEvents")
	public Method postInsertEvents()


	@Post("/api/taf/fiscal/v1/saveEvents")
	public Method postSaveEvents()

	@Put("/api/taf/fiscal/v1/saveEvents/:id")
	public Method putSaveEvents()

	@Get("/api/taf/fiscal/v1/saveEvents/:id")
	public method getEventById()

	@Put("/api/taf/fiscal/v1/relay")
	public method putRelayEvent()

	@Put("/api/taf/fiscal/v1/cancelEvent")
	public method putCancelEvent()

	@Get("/api/taf/fiscal/v1/statusEnvironment")
	public method getStatusEnvironment()
EndClass

/*/{Protheus.doc} New
	Método construtor
@author juan.felipe
@since 31/10/2025
/*/
Method New() Class WSEventsController
Return Self

/*/{Protheus.doc} getListEvents
	Consulta lista de eventos
@author juan.felipe
@since 31/10/2025
/*/
Method getListEvents() Class WSEventsController
	Self:setAnswer(1)
Return

/*/{Protheus.doc} getDocuments
	Consulta obtém lista de documentos fiscais elegíveis para seleção de eventos.
@author juan.felipe
@since 10/11/2025
/*/
Method getDocuments() Class WSEventsController
	Self:setAnswer(2, 'page,pageSize,typeDocument,speciesDocument,dateStart,dateEnd,event')
Return

/*/{Protheus.doc} getItems
	Obtém lista de itens dos documentos fiscais elegíveis para seleção de eventos.
@author juan.felipe
@since 13/11/2025
/*/
Method getItems() Class WSEventsController
	Self:setAnswer(3, 'chvnf')
Return

/*/{Protheus.doc} postSaveEvents
    Salva eventos para os documentos fiscais selecionados.
@author juan.felipe
@since 10/11/2025
/*/
Method postSaveEvents() Class WSEventsController
	Local oEventsService As Object
	Local oUtils As Object
	Local jRequest As Json
	Local jResponse As Json
	Local nCode As Numeric
	Local cBody As Character
	Local cRequiredNames As Character
	Local lOk As Logical

	oEventsService := WSEventsService():New()
	oUtils := Utils():New()
	jResponse := JsonObject():New()
	cRequiredNames := 'chvnf,event'
	cBody := oRest:getBodyRequest()

	If lOk := oUtils:validateRequirements(@jResponse) .And.;
			oUtils:validateRequestBody(cBody, @jRequest, @jResponse) .And.;
			oUtils:validateQueryParams(@jResponse, jRequest, cRequiredNames)

		jResponse := oEventsService:postSaveEvents(jRequest)

		lOk := oEventsService:lOk
		nCode := oEventsService:nCode
	EndIf

	oUtils:setAPIResponse(oRest, jResponse, lOk, nCode)

	FreeObj(jRequest)
	FreeObj(jResponse)
	FreeObj(oEventsService)
	FreeObj(oUtils)
Return

/*/{Protheus.doc} putSaveEvents
    Atualiza eventos para os documentos fiscais selecionados.
@author juan.felipe
@since 21/11/2025
/*/
Method putSaveEvents() Class WSEventsController
	Local oEventsService As Object
	Local oUtils As Object
	Local jRequest As Json
	Local jResponse As Json
	Local nCode As Numeric
	Local cBody As Character
	Local cId As Character
	Local cRequiredNames As Character
	Local lOk As Logical

	oEventsService := WSEventsService():New()
	oUtils := Utils():New()
	jResponse := JsonObject():New()
	cRequiredNames := 'chvnf,event'
	cBody := oRest:getBodyRequest()
	cId := ""

	If oRest:getPathParamsRequest():HasProperty("id")
		cId := oRest:getPathParamsRequest()["id"]
	EndIf

	If lOk := oUtils:validateRequirements(@jResponse) .And.;
			oUtils:validateRequestBody(cBody, @jRequest, @jResponse) .And.;
			oUtils:validateQueryParams(@jResponse, jRequest, cRequiredNames)

		jResponse := oEventsService:putSaveEvents(cId, jRequest)

		lOk := oEventsService:lOk
		nCode := oEventsService:nCode
	EndIf

	oUtils:setAPIResponse(oRest, jResponse, lOk, nCode)

	FreeObj(jRequest)
	FreeObj(jResponse)
	FreeObj(oEventsService)
	FreeObj(oUtils)
Return

/*/{Protheus.doc} setAnswer
	Monta resposta JSON para o retorno dos eventos
@author juan.felipe
@since 31/10/2025
@param nOption, numeric, opção de consulta.
/*/
Method setAnswer(nOption As Numeric, cRequiredNames As Character) Class WSEventsController
	Local oEventsService As Object
	Local oUtils As Object
	Local xResponse As Variant
	Local nCode As Numeric
	Local lOk As Logical

	Default nOption := 0
	Default cRequiredNames := ''

	oEventsService := WSEventsService():New()
	oUtils := Utils():New()

	If lOk := oUtils:validateRequirements(@xResponse) .And. oUtils:validateQueryParams(@xResponse, oRest:getQueryRequest(), cRequiredNames)
		oUtils:getPageAndPageSize(@Self:nPage, @Self:nPageSize)
		oEventsService:getQueryResponse(Self:nPage, Self:nPageSize, nOption, oRest:getQueryRequest())

		lOk := oEventsService:lOk
		nCode := oEventsService:nCode
		xResponse := oEventsService:jResponse
	EndIf

	oUtils:setAPIResponse(oRest, xResponse, lOk, nCode)

	FreeObj(oEventsService)
	FreeObj(oUtils)
Return

//------------------------------------------------------------------------------
/*/{Protheus.doc} WSEventsController::getEventById
Metodo responsavel cancelar os eventos de documentos fiscais

@type method
@version 1.0
@author Misael Ramos
@since 20/11/2025
@return json, retorna a resposta em formato JSON
/*/
//------------------------------------------------------------------------------
Method GetEventById() Class WSEventsController
	Local lOk As Logical
	Local nCode As Numeric
	Local jParam As Json
	Local oService := WSEventsService():New() as object
	Local oUtils := Utils():New() as object
	Local jResponse := JsonObject():New() as json

	jParam := oRest:getPathParamsRequest()
	nCode := 401

	If lOk := oUtils:validateQueryParams(@jResponse, jParam, 'id')
		jResponse := oService:getEventById(jParam['id'])
		nCode := oService:nCode
	EndIf

	oUtils:setAPIResponse(oRest, jResponse, lOk, nCode)

	FreeObj(jParam)
	FreeObj(jResponse)
	FreeObj(oService)
	FreeObj(oUtils)
Return

//------------------------------------------------------------------------------
/*/{Protheus.doc} WSEventsController::putRelayEvent
Metodo responsavel por retransmitir o evento

@type method
@version 1.0
@author Misael Ramos
@since 20/11/2025
@return json, retorna a resposta em formato JSON
/*/
//------------------------------------------------------------------------------
Method putRelayEvent() Class WSEventsController
	Local oEventsService As Object
	Local oUtils As Object
	Local jRequest As Json
	Local jResponse As Json
	Local nCode As Numeric
	Local cBody As Character
	Local cId As Character
	Local cRequiredNames As Character
	Local lOk As Logical
	Local cType:= "1" As Character

	oEventsService := WSEventsService():New()
	oUtils := Utils():New()
	cRequiredNames := 'id'
	cBody := oRest:getBodyRequest()
	cId := ""

	If lOk := oUtils:validateRequirements(@jResponse) .And.;
			oUtils:validateRequestBody(cBody, @jRequest, @jResponse) .And.;
			oUtils:validateQueryParams(@jResponse, jRequest, cRequiredNames)
		cId := jRequest['id']
		If ValType(jRequest['type']) == "N"
			cType := cValToChar(jRequest['type'])
		EndIf
		jResponse := oEventsService:putEventRelay(cId, cType)

		lOk := oEventsService:lOk
		nCode := oEventsService:nCode
	EndIf

	oUtils:setAPIResponse(oRest, jResponse, lOk, nCode)

	FreeObj(jRequest)
	FreeObj(oEventsService)
	FreeObj(oUtils)
Return

//------------------------------------------------------------------------------
/*/{Protheus.doc} WSEventsController::putCancelEvent
Metodo responsavel por cancelar os eventos

@type method
@version 1.1
@author Misael Ramos
@since 19/11/2025
@return json, retorna a resposta em formato JSON
/*/
//------------------------------------------------------------------------------
Method putCancelEvent() Class WSEventsController
	Local oEventsService As Object
	Local oUtils As Object
	Local jRequest As Json
	Local jResponse As Json
	Local nCode As Numeric
	Local cBody As Character
	Local cId As Character
	Local cRequiredNames As Character
	Local lOk As Logical
	Local cType:= "1" As Character

	oEventsService := WSEventsService():New()
	oUtils := Utils():New()
	cRequiredNames := "id"
	cBody := oRest:getBodyRequest()
	cId := ""

	If lOk := oUtils:validateRequirements(@jResponse) .And.;
			oUtils:validateRequestBody(cBody, @jRequest, @jResponse) .And.;
			oUtils:validateQueryParams(@jResponse, jRequest, cRequiredNames)

		cId := jRequest['id']
		If ValType(jRequest['type']) == "N"
			cType := cValToChar(jRequest['type'])
		EndIf
		jResponse := oEventsService:putEventCancel(cId, cType)

		lOk := oEventsService:lOk
		nCode := oEventsService:nCode
	EndIf

	oUtils:setAPIResponse(oRest, jResponse, lOk, nCode)

	FreeObj(jRequest)
	FreeObj(oEventsService)
	FreeObj(oUtils)
Return

//------------------------------------------------------------------------------
/*/{Protheus.doc} getStatusEnvironment
Metodo responsável por repassar para o front o Status do TSS e do Smart Schedule

@type method
@version 1.1
@author Carla Bianca Santos Latorre
@since 06/01/2026
/*/
//------------------------------------------------------------------------------
Method getStatusEnvironment() Class WSEventsController
	Local oEventsService As Object
	Local oUtils         As Object
	Local lOk            As Logical
	Local nCode          As Numeric
	Local jResponse      As Json

	oEventsService := WSEventsService():New()
	oUtils := Utils():New()
	jResponse := JsonObject():New()
	nCode := 400

	If lOk := oUtils:validateRequirements(@jResponse)
		jResponse := oEventsService:getStatusEnvironment()

		If ValType(oEventsService:nCode) == "N" .And. oEventsService:nCode > 0
			nCode := oEventsService:nCode
		EndIf
		If ValType(oEventsService:lOk) == "L"
			lOk := oEventsService:lOk
		EndIf
	endIf
	oUtils:setAPIResponse(oRest, jResponse, lOk, nCode)

	FreeObj(jResponse)
	FreeObj(oEventsService)
	FreeObj(oUtils)

Return
/*/{Protheus.doc} postInsertEvents
    Inclui eventos para os documentos fiscais.
@author Pâmela Bernardo
@since 26/01/2026
/*/
Method postInsertEvents() Class WSEventsController
	Local oEventsService As Object
	Local oUtils As Object
	Local jRequest As Json
	Local jResponse As Json
	Local nCode As Numeric
	Local cBody As Character
	Local cRequiredNames As Character
	Local lOk As Logical

	oEventsService := WSEventsService():New()
	oUtils := Utils():New()
	jResponse := JsonObject():New()
	cRequiredNames := 'chvnfe,event'
	cBody := oRest:getBodyRequest()

	If lOk := oUtils:validateRequirements(@jResponse) .And.;
			oUtils:validateRequestBody(cBody, @jRequest, @jResponse) .And.;
			oUtils:validateQueryParams(@jResponse, jRequest, cRequiredNames)

		jResponse := oEventsService:postInsertEvents(jRequest)

		lOk := oEventsService:lOk
		nCode := oEventsService:nCode
	EndIf

	oUtils:setAPIResponse(oRest, jResponse, lOk, nCode)

	FreeObj(jRequest)
	FreeObj(jResponse)
	FreeObj(oEventsService)
	FreeObj(oUtils)
Return
