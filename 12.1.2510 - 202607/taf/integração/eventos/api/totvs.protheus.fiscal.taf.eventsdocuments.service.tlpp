#include "protheus.ch"
#include "tlpp-core.th"
#include "tlpp-object.th"

namespace totvs.protheus.fiscal.taf.event

//-------------------------------------------------------------------------------------------
/*/{Protheus.doc} eventsDocumentsService
Classe responsavel por gerenciar a logica de negocio dos endpoints de eventos de documentos fiscais

@type class
@version 1.0
@author Misael Ramos
@since 05/11/2025
*/
//------------------------------------------------------------------------------
Class eventsDocumentsService

	public data jResponse as json

	public method New() as object
	public method getEventsDocService() as json

EndClass

//------------------------------------------------------------------------------
/*/{Protheus.doc} eventsDocumentsService::New
Obtem uma nova instancia da classe eventsDocumentsService

@type method
@version 1.0
@author Misael Ramos
@since 05/11/2025
@return object, retorna uma nova instancia da classe
/*/
//------------------------------------------------------------------------------
Method New() as Object Class eventsDocumentsService

	::jResponse := JsonObject():New()

Return Self

//------------------------------------------------------------------------------
/*/{Protheus.doc} eventsDocumentsService::getEventsDocService
Metodo responsavel por obter os dados de eventos de documentos fiscais

@type method
@version 1.0
@author Misael Ramos
@since 05/11/2025
@param nPage, numeric, numero da pagina
@param nPageSize, numeric, numero da pagina
@param cStatus, character, status do evento
@param cStartPeriod, character, periodo de inicio
@param cEndPeriod, character, periodo de termino
@param cEvents, character, eventos
@return json, retorna a resposta em formato JSON
/*/
//------------------------------------------------------------------------------
Method getEventsDocService(nPage as numeric, nPageSize as numeric, cStatus as character, cStartPeriod as character, cEndPeriod as character, cEvents as character) as Json Class eventsDocumentsService

	Local oDataItems 		  := Nil as object
	Local oDataDetailItems 	  := Nil as object
	Local oDataSubDetailItems := Nil as object
	Local jItems 			  := Nil as json
	Local jDetailItems 		  := Nil as json
	Local jSubDetailItems 	  := Nil as json
	Local cItems 			  := "" as character
	Local cDetailItems 		  := "" as character
	Local cSubDetailItems 	  := "" as character
	Local cNumDoc 			  := "" as character
	Local cIdEvent			  := "" as character
	Local cDateIni 			  := "" as character
	Local cDateEnd 			  := "" as character
	Local aItems 			  := {} as array
	Local aDetailItems 		  := {} as array
	Local aSubDetailItems 	  := {} as array
	Local nItem   	 		  := 0 as numeric
	Local nDetail 	 		  := 0 as numeric

	If !Empty(cStartPeriod)
		cDateIni := StrTran(cStartPeriod, "-", "")
	EndIf

	If !Empty(cEndPeriod)
		cDateEnd := StrTran(cEndPeriod, "-", "")
	EndIf

	oDataItems := eventsDocumentsProtheusData():New("GET")
	oDataItems:setMapFields("items")
	oDataItems:getEventsDocItems(nPage, nPageSize, cStatus, cDateIni, cDateEnd, cEvents, "items")

	If oDataItems:lOk
		
		cItems := oDataItems:GetJSONResponse()
		jItems := JsonObject():New()
		jItems:FromJson(cItems)
		aItems := jItems:GetJSonObject('items')

		::jResponse := JsonObject():New()
		::jResponse["items"] := {}

		For nItem := 1 to Len(aItems)

			cNumDoc := aItems[nItem]:GetJsonObject("noteNumber")
			cTypAut := aItems[nItem]:GetJsonObject("typeOfAuthor")

			oDataDetailItems := eventsDocumentsProtheusData():New("GET")
			oDataDetailItems:setMapFields("detailItems")
			oDataDetailItems:getEventsDocItems(,,cStatus,,,cEvents, "detailItems",, cNumDoc, cTypAut)

			If oDataDetailItems:lOk

				cDetailItems := oDataDetailItems:GetJSONResponse()
				jDetailItems := JsonObject():New()
				jDetailItems:FromJson(cDetailItems)
				aDetailItems := jDetailItems:GetJSonObject("items")

				aItems[nItem]["detailItems"] := {}

				For nDetail := 1 to Len(aDetailItems)

					cIdEvent := aDetailItems[nDetail]:GetJsonObject("id")

					oDataSubDetailItems := eventsDocumentsProtheusData():New("GET")
					oDataSubDetailItems:setMapFields("subDetailItems")
					oDataSubDetailItems:getEventsDocItems(,,,,,, "subDetailItems", cIdEvent)

					If oDataSubDetailItems:lOk
						cSubDetailItems := oDataSubDetailItems:GetJSONResponse()
						jSubDetailItems := JsonObject():New()
						jSubDetailItems:FromJson(cSubDetailItems)
						aSubDetailItems := jSubDetailItems:GetJSonObject("items")

						aDetailItems[nDetail]["subDetailItems"] := aSubDetailItems
					EndIf

					oDataSubDetailItems:DeActivate()
					FreeObj(oDataSubDetailItems)

				Next

				aItems[nItem]["detailItems"] := aDetailItems
			EndIf

			oDataDetailItems:DeActivate()
			FreeObj(oDataDetailItems)

		Next

		::jResponse["items"] := aItems
		::jResponse["hasNext"] := .F.

	EndIf

	oDataItems:DeActivate()
	FreeObj(oDataItems)

Return ::jResponse
