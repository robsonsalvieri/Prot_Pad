#include "protheus.ch"
#include "tlpp-core.th"
#include "tlpp-object.th"
#include "totvs.protheus.fiscal.taf.xmlmonitorevent.ch"

namespace totvs.protheus.fiscal.taf.event

Static __oQueryC35 as object

/*-------------------------------------------------------------------------------
{Protheus.doc} TAFXmlMonitorEvent
Classe responsável por gerar e enviar os XMLs dos eventos da reforma tributária

@type class
@author Evandro Italo
@since 29/10/2025
@version 1.0
-------------------------------------------------------------------------------*/
Class TAFXmlMonitorEvent

    public method New() 							as object
    public method TAFGetXmlMonitorEvent() 			as object
	public method TAFScheduleXmlMonitorEvent() 	    as object
    private method TAFEventsEnabledForSubmission() 	as character
    private method TafAssemblingXmlEvent() 			as character
    private method TAFEventWithoutItems() 			as character
    private method TAFEventItems() 					as character
    private method TAFEventItemsCredPresumido() 	as character
	private method TAFSaveLogsMonitorEvents()		
	private method SyncBatchHeaderByEvent(cIdEvento as character, cStatusBefore as character, cStatusAfter as character)	as logical
	private method GetBatchContextByEvent(cIdEvento as character)	as json
	private method GetBatchDelta(cStatusBefore as character, cStatusAfter as character, lCancelRequested as logical)	as json
	private method ApplyBatchDelta(jBatch as json, jDelta as json)	as json
	private method GetBatchSnapshot(jBatch as json)			as json
	private method ResolveBatchResult(jBatch as json, jSnap as json)	as json
	private method PersistPendingBatchStatus(jBatch as json, cPendingStatus as character)	as logical
	private method PersistBatchHeader(jBatch as json, jResult as json)	as logical
	protected method TafStatusMonitorEvents()		as character		
	protected method Conv2Dec(nNum as numeric)		as character
	protected method TafGetTaxNFe(cChNFe as character, cCodTrib as character, cCurItem as character)	as numeric

EndClass
/*-------------------------------------------------------------------------------
{Protheus.doc} New()
Método de instância da classe

@type method
@author Evandro Italo
@since 29/10/2025
@version 1.0
-------------------------------------------------------------------------------*/
method New() as object class TAFXmlMonitorEvent  
return Self
/*-------------------------------------------------------------------------------
{Protheus.doc} TafScheduleXmlMonitorEvent()
Metodo responsável por agendar a execução do monitor de eventos via Smart Schedule

@type method
@author Evandro Italo
@since 29/10/2025
@version 1.0
-------------------------------------------------------------------------------*/
method TafScheduleXmlMonitorEvent() as object class TAFXmlMonitorEvent
    Local cAmbiente:= "" as character

	TAFConout(STR0002,,, STR0001) 
	cAmbiente:= TafContScd()
	//As validações referente ao Smart Schedule devem ser retiradas assim que estiver confirmado que todas as suas funcionalidades estarão disponíveis
	//no rpo do ARTE para teste. Nesse momento esta em uso somente para controle interno.
	If !Empty(cAmbiente)
		If totvs.framework.schedule.utils.createTask(cAmbiente, /*cEmpAnt*/, /*cFilAnt*/, 'TAFA621EVT', 84, __cUserID, '', {}, .T.) != Nil
			TAFConout(STR0004,,, STR0001)
		EndIf
	Else
		TAFConout(STR0005,,, STR0001)	
	EndIf

return Self
/*-------------------------------------------------------------------------------
{Protheus.doc} TafScheduleXmlMonitorEvent()
Metodo responsável por verificar os eventos habilitados para envio e gerar o 
XML para cada um deles

@Parametro MV_TAFSURL - URL do serviço do TSS para envio dos eventos (TAF)

@type method
@author Evandro Italo
@since 29/10/2025
@version 1.0
-------------------------------------------------------------------------------*/
method TAFGetXmlMonitorEvent() as object class TAFXmlMonitorEvent
	Local aRetTss 		as array
    Local cAliasQry   	as character
	Local cXmlCreated 	as character
	Local cIdEvento   	as character
	Local cEventCode  	as character
	Local cChNFe      	as character
	Local cChNFOrig     as character
	Local cOrgaoAutor 	as character
	Local cTpAutor    	as character
	Local cIdEnti		as character
	Local lEventCancel 	as logical
	Local lHasItems   	as logical
	Local cUrl          as character
	Local cMsg      	as character
	Local cError    	as character
	Local cIdProcessamento  	as character
	local cRet       	as character

	//Variáveis para envio na função do TSS
	cIdEnti	:= RetIdEnti()
	cUrl   := SuperGetMv("MV_SPEDURL",.F.,"")

	cAliasQry := ::TAFEventsEnabledForSubmission()
	If !Empty(cAliasQry)	
		While (cAliasQry)->(!eof()) 

			// mapeia campos retornados pela query
            cIdEvento  	:= (cAliasQry)->T7A_IDENT
            cEventCode 	:= (cAliasQry)->T7A_TPEVEN
            cChNFe     	:= alltrim((cAliasQry)->T7A_CHVELE)
			cTpAutor	:= AllTrim((cAliasQry)->T7A_TPAUT)
            cOrgaoAutor	:= Posicione("C09",3,xFilial("C09")+AllTrim((cAliasQry)->T7A_EST),"ALLTRIM(C09_CODIGO)")
			cChNFOrig 	:= AllTrim((cAliasQry)->T7A_CHVNF)

			//Log inicial
			TAFConout( STR0006 + cEventCode + STR0007,,, STR0001) 
			
			//Conferindo se é um evento de cancelamento
			if (cAliasQry)->T7A_CANC == "1"
				lEventCancel  	:= .T.
			Else
				lEventCancel  	:= .F.
			Endif
			If cTpAutor == "3"
				cTpAutor := "8" //Sucessora
			Endif

			//Conferindo se o evento tem itens.
			If (cAliasQry)->T7E_TEMITE == "1"
            	lHasItems  	:= .T.
			Else
				lHasItems  	:= .F.	
			Endif

            // chama TafAssemblingXmlEvent e captura o XML gerado 
            cXmlCreated := ::TafAssemblingXmlEvent( cIdEvento, cEventCode, cOrgaoAutor, cTpAutor, cChNFe, lHasItems, lEventCancel, cChNFOrig )

			If !Empty(cXmlCreated)
				TAFConout(STR0008,,, STR0001) 
				TafConout(cXmlCreated)
				TafConout(STR0009,,, STR0001)

				// envia o XML para o TSS, (função TSSEnvEven)   
				aRetTss := TSSEnvEven(@cError, cUrl, cIdEnti, cXmlCreated, @cMsg)

    			If Len(aRetTss) > 0
					cIdProcessamento := aRetTss[1]
				EndIf
				
				cRet :=::TafStatusMonitorEvents(cUrl, cIdEnti, cChNFe, cIdProcessamento, lEventCancel, cIdEvento)
				::TafSaveLogsMonitorEvents(cError, cRet, cMsg, cIdEvento, cXmlCreated)
				TAFConout(STR0010,,, STR0001)
				TAFConout(STR0013 + cChNFe + "-" + cRet,,, STR0001)
            Else
                TAFConout(STR0014 + cEventCode + STR0015,,, STR0001)
            Endif

			(cAliasQry)->(DbSkip())
		enddo
	Endif

return Self

/*-------------------------------------------------------------------------------

{Protheus.doc} TAFEventsEnabledForSubmission()
Metodo responsável por brucar os eventos habilitados para envio no TAF.

Os eventos habilitados para o envio são aqueles que estão com 
T7A.T7A_STATUS "1 - Solicitado" ou "3 - Sol. de cancelamento".


@type method
@author Evandro Italo
@since 29/10/2025
@version 1.0
-------------------------------------------------------------------------------*/
method TAFEventsEnabledForSubmission() as character class TAFXmlMonitorEvent
    Local cQueryEvents as character
	Local oQryEnabledEvents as object
	Local cAliasEvent as character

	cQueryEvents += " SELECT T7A.T7A_IDENT, T7A.T7A_TPEVEN, T7A.T7A_CHVELE, T7A.T7A_EST, T7A.T7A_TPAUT, T7A.T7A_CANC, T7E.T7E_TEMITE, T7A.T7A_CHVNF " 
	cQueryEvents += " FROM " + RetSqlName('T7A') + " T7A "
	cQueryEvents += " LEFT JOIN " + RetSqlName('T7E') + " T7E ON "
	cQueryEvents +=  FwJoinFilial("T7A","T7E") + " AND T7A.T7A_TPEVEN = T7E.T7E_EVENTO "
	cQueryEvents += " AND T7E.D_E_L_E_T_ = ? "
	cQueryEvents += " WHERE T7A.T7A_FILIAL = ? " 
	cQueryEvents += " AND T7A.T7A_STATUS IN (?) " 
	cQueryEvents += " AND T7A.D_E_L_E_T_ = ? "
	cQueryEvents := ChangeQuery(cQueryEvents)

	oQryEnabledEvents := FwExecStatement():New(cQueryEvents)

	oQryEnabledEvents:SetString(1, ' ')
	oQryEnabledEvents:SetString(2, xFilial('T7A'))
	oQryEnabledEvents:SetIn(3, {'1', '3'})
	oQryEnabledEvents:SetString(4, ' ')
	cAliasEvent := oQryEnabledEvents:OpenAlias() 
	
return cAliasEvent

/*-------------------------------------------------------------------------------
{Protheus.doc} TafAssemblingXmlEvent()
Metodo responsável por montar o XML do evento conforme os dados informados.

@param cIdEvento - Identificador único do evento (UUID)
@param cEventCode - Código do evento
@param cOrgaoAutor - Código do órgão autorizador
@param cTpAutor - Tipo do autor do evento
@param cChNFe - Chave de acesso da NF-e
@param lHasItems - Indica se o evento possui itens
@param lEventCancel - Indica se o evento é de cancelamento
@param cChNFOrig - Chave de acesso da NF-e original
@type method
@author Evandro Italo
@since 29/10/2025
@version 1.0
-------------------------------------------------------------------------------*/
method TafAssemblingXmlEvent(cIdEvento as character, cEventCode as character, cOrgaoAutor as character,;
							 cTpAutor as character, cChNFe as character, lHasItems as logical, lEventCancel as logical, cChNFOrig as character) as character class TAFXmlMonitorEvent
								 
	Local cXmlDone                 as character
	Local cItemsXml                as character
	Local cEventWithoutItems       as character
	Local cEventItemsCredPresumido as character
	Local cQtde                    as character
	Local cUnidade                 as character
	Local cVIBS                    as character
	Local cVCBS                    as character
	Local cVIBSOrig                as character
	Local cVCBSOrig                as character
	Local cVBC                     as character
	Local cItemCredPres            as character
	Local cCCredPresIBS            as character
	Local cPCredPresIBS            as character
	Local cVCredPresIBS            as character
	Local cCCredPresCBS            as character
	Local cPCredPresCBS            as character
	Local cVCredPresCBS            as character
	Local cEventCancel			   as character
	Local cIndQuitacao             as character
	Local cIndAceitacao            as character
	Local cDPrevEntrega            as character
	Local cNProtEvento             as character
	Local cCurItem				   as character	
	Local cCodTri				   as character
	Local aCodTriIBS		   	   :=  {"000042", "000043", "000044", "000045", "000047", "000048","000049"}  as array
	Local aCodTribCBS	   	   	   := {"000031", "000032", "000039", "000040" , "000041"} as array
	Local oXmlEvent                as object
	Local lXmlDone                 as logical
	Local nTaxed			   	   as numeric

	cEventCancel := "110001" // Código do evento de cancelamento

	//Verifica se é cancelamento de evento para alterar o modo de envio das informações para o XML
	if lEventCancel
		oXmlEvent := SchemaXMLEvents():New(cOrgaoAutor, cTpAutor, cEventCancel, cChNFe)
	else
		oXmlEvent := SchemaXMLEvents():New(cOrgaoAutor, cTpAutor, cEventCode, cChNFe)
	endif

	//Monta o Header
	cXmlDone := oXmlEvent:SchemaXmlEventHeader()

	//Verifica é um evento que contem itens.
	If lHasItems .and. !lEventCancel
        // caso crédito presumido (T7B) - mantém lógica atual
        If cEventCode == "211110"
            cEventItemsCredPresumido := ::TAFEventItemsCredPresumido(cIdEvento)
			// percorre agrupando por T7B_ITEM â€” cada grupo/chave é um item que pode ter IBS e CBS
			While !(cEventItemsCredPresumido)->(Eof())
				// inÃ­cio do grupo do item
				
            	cItemCredPres := AllTrim((cEventItemsCredPresumido)->T7B_ITEM)
				cVBC := Alltrim(::Conv2Dec((cEventItemsCredPresumido)->T7B_VLBASE))
            	While (cEventItemsCredPresumido)->(!Eof()) .And. AllTrim((cEventItemsCredPresumido)->T7B_ITEM) == cItemCredPres
            	    cCodTri := AllTrim((cEventItemsCredPresumido)->T7B_CODTRI)
            	    If cCodTri == "000046"
            	        cCCredPresIBS := AllTrim(cValToChar((cEventItemsCredPresumido)->T7B_CODCRE))
            	        cPCredPresIBS := AllTrim(cValToChar((cEventItemsCredPresumido)->T7B_PERC))
						cVCredPresIBS := Alltrim(::Conv2Dec((cEventItemsCredPresumido)->T7B_VALOR))
            	    elseif cCodTri == "000033"
            	        cCCredPresCBS := AllTrim(cValToChar((cEventItemsCredPresumido)->T7B_CODCRE))
            	        cPCredPresCBS := AllTrim(cValToChar((cEventItemsCredPresumido)->T7B_PERC))
					    cVCredPresCBS := Alltrim(::Conv2Dec((cEventItemsCredPresumido)->T7B_VALOR))
            	    Endif
            	    (cEventItemsCredPresumido)->(DbSkip())
            	Enddo
            	// monta bloco único para crédito presumido
            	cXmlDone += oXmlEvent:XmlEvent211110(cItemCredPres, cVBC, cCCredPresIBS, cPCredPresIBS, cVCredPresIBS, cCCredPresCBS, cPCredPresCBS, cVCredPresCBS)
            	lXmlDone := .T.
			Enddo
        Else
            // demais eventos com itens: obtém alias de itens (T7C)
            cItemsXml := ::TAFEventItems(cIdEvento)
            If !Empty(cItemsXml)
                // percorre agrupando por T7C_ITEM a cada grupo/chave é um item que pode ter IBS e CBS
                While !(cItemsXml)->(Eof())
                    // inÃ­cio do grupo do item
                    cCurItem := AllTrim((cItemsXml)->T7C_ITEM)
                    cVIBS := ""
                    cVCBS := ""
                    cQtde := ""
                    cUnidade := ""

                    // agrupa todas as linhas do item atual
                    While !(cItemsXml)->(Eof()) .And. AllTrim((cItemsXml)->T7C_ITEM) == cCurItem
                        cCodTri := AllTrim((cItemsXml)->T7C_CODTRI)
                        If AScan(aCodTriIBS, cCodTri) > 0
							cVIBS := Alltrim(::Conv2Dec((cItemsXml)->T7C_VALOR))
                        Elseif AScan(aCodTribCBS, cCodTri) > 0
							cVCBS := Alltrim(::Conv2Dec((cItemsXml)->T7C_VALOR))
                        Endif
						If cEventCode == "112130"
							nTaxed := ::TafGetTaxNFe(cChNFOrig, cCodTri, cCurItem)
							If AScan(aCodTriIBS, cCodTri) > 0
								cVIBSOrig := Alltrim(::Conv2Dec(nTaxed))
							Elseif AScan(aCodTribCBS, cCodTri) > 0
								cVCBSOrig := Alltrim(::Conv2Dec(nTaxed))
							Endif
						EndIf
                        // quantidade/unidade podem repetir nas duas linhas, sobrescreve com o último lido
                        cQtde := AllTrim(cValToChar((cItemsXml)->T7C_QUANT))
                        cUnidade := Posicione("C1J",3,xFilial("C1J")+ALLTRIM((cItemsXml)->T7C_UM),"ALLTRIM(C1J_CODIGO)")
                        (cItemsXml)->(DbSkip())
                    Enddo

                    // chama método do evento UMA vez por item (fragmento)
                    Do case
                        Case cEventCode == "112120"
                            cXmlDone += oXmlEvent:XmlEvent112120(cCurItem, cVIBS, cVCBS, cQtde, cUnidade)
                            lXmlDone := .T.
                        Case cEventCode == "112130"
                            cXmlDone += oXmlEvent:XmlEvent112130(cCurItem, cVIBS, cVCBS, cQtde, cUnidade, cVIBSOrig, cVCBSOrig)
                            lXmlDone := .T.
                        Case cEventCode == "112140"
                            cXmlDone += oXmlEvent:XmlEvent112140(cCurItem, cVIBS, cVCBS, cQtde, cUnidade)
                            lXmlDone := .T.
                        Case cEventCode == "211120"
                            cXmlDone += oXmlEvent:XmlEvent211120(cCurItem, cVIBS, cVCBS, cQtde, cUnidade, cChNFe, cCurItem)
                            lXmlDone := .T.
                        Case cEventCode == "211124"
                            cXmlDone += oXmlEvent:XmlEvent211124(cCurItem, cVIBS, cVCBS, cQtde, cUnidade)
                            lXmlDone := .T.
                        Case cEventCode == "211130"
                            cXmlDone += oXmlEvent:XmlEvent211130(cCurItem, cVIBS, cVCBS, cQtde, cUnidade)
                            lXmlDone := .T.
                        Case cEventCode == "211140"
                            cXmlDone += oXmlEvent:XmlEvent211140(cCurItem, cVIBS, cVCBS, cQtde, cUnidade)
                            lXmlDone := .T.
                        Case cEventCode == "211150"
                            cXmlDone += oXmlEvent:XmlEvent211150(cCurItem, cVIBS, cVCBS)
                            lXmlDone := .T.
                    Endcase
                Enddo
			Endif
		Endif
	Else
		//Eventos que não contem item.
		cEventWithoutItems := ::TAFEventWithoutItems(cIdEvento)
		If !Empty(cEventWithoutItems)
			// mapeia campos retornados pela query
			cIndQuitacao  	:= (cEventWithoutItems)->T7A_PGTO
			cIndAceitacao 	:= Iif((cEventWithoutItems)->T7A_INDACE == "2","0","1")
			cDPrevEntrega 	:=  SubStr((cEventWithoutItems)->T7A_DTPREV, 1, 4) + "-" + ;
    							SubStr((cEventWithoutItems)->T7A_DTPREV, 5, 2) + "-" + ;
    							SubStr((cEventWithoutItems)->T7A_DTPREV, 7, 2)
			cNProtEvento    := AllTrim((cEventWithoutItems)->T7A_PROT)

			If lEventCancel
					cXmlDone += oXmlEvent:XmlEvent110001(cEventCode, cNProtEvento)
					lXmlDone := .T.		
			Else	
				Do Case
					Case cEventCode == "112110"
						cXmlDone += oXmlEvent:XmlEvent112110(cIndQuitacao)
						lXmlDone := .T.
					Case cEventCode == "112150"
						cXmlDone += oXmlEvent:XmlEvent112150(cDPrevEntrega)
						lXmlDone := .T.
					Case cEventCode == "211128"
						cXmlDone += oXmlEvent:XmlEvent211128(cIndAceitacao)
						lXmlDone := .T.
					Case cEventCode == "212110"
						cXmlDone += oXmlEvent:XmlEvent212110(cIndAceitacao)
						lXmlDone := .T.
					Case cEventCode == "212120"
						cXmlDone += oXmlEvent:XmlEvent212120(cIndAceitacao)
						lXmlDone := .T.
					Otherwise
						TAFConout(STR0011 + cEventCode,,, STR0001)
						lXmlDone := .F. 
						cXmlDone := ""
				Endcase
			endif
		Endif
	Endif

	If lXmlDone
		cXmlDone += oXmlEvent:SchemaXmlEventFooter()
	Endif

return cXmlDone

/*-------------------------------------------------------------------------------
{Protheus.doc} TAFEventWithoutItems()
Metodo responsável por buscar os dados do evento que não possui itens.

@param cIdEvento - Identificador único do evento (UUID)

@type method
@author Evandro Italo
@since 29/10/2025
@version 1.0
-------------------------------------------------------------------------------*/
method TAFEventWithoutItems(cIdEvent as character) as character class TAFXmlMonitorEvent
    Local cQueryEventWithoutItems as character
	Local oQryEventWithoutItems as object
	Local cAliasEventWithoutItems as character

	cQueryEventWithoutItems += " SELECT T7A.T7A_PGTO, T7A.T7A_INDACE, T7A.T7A_DTPREV, T7A.T7A_PROT " 
	cQueryEventWithoutItems += " FROM " + RetSqlName('T7A') + " T7A "
	cQueryEventWithoutItems += " WHERE T7A.T7A_FILIAL = ? " 
	cQueryEventWithoutItems += " AND T7A.D_E_L_E_T_  = ? " 
	cQueryEventWithoutItems += " AND T7A.T7A_IDENT = ? "
	cQueryEventWithoutItems := ChangeQuery(cQueryEventWithoutItems)

	oQryEventWithoutItems := FwExecStatement():New(cQueryEventWithoutItems)

	oQryEventWithoutItems:SetString(1, xFilial('T7A'))
	oQryEventWithoutItems:SetString(2, '')
	oQryEventWithoutItems:SetString(3, cIdEvent)
	cAliasEventWithoutItems := oQryEventWithoutItems:OpenAlias()

return cAliasEventWithoutItems

/*-------------------------------------------------------------------------------
{Protheus.doc} TAFEventItems()
Metodo responsável por buscar os dados do evento que possui itens.

@param cIdEvento - Identificador único do evento (UUID)

@type method
@author Evandro Italo
@since 29/10/2025
@version 1.0
-------------------------------------------------------------------------------*/
method TAFEventItems(cIdEvent as character) as character class TAFXmlMonitorEvent
    Local cQueryEventsItems as character
	Local oQryEventsItems as object
	Local cAliasEventItems as character

	cQueryEventsItems += " SELECT  T7C.T7C_ITEM, T7C.T7C_CODTRI, T7C.T7C_QUANT, T7C.T7C_UM, T7C.T7C_VALOR, T7A.T7A_CHVELE " 
	cQueryEventsItems += " FROM " + RetSqlName('T7C') + " T7C "
	cQueryEventsItems += " LEFT JOIN " + RetSqlName('T7A') + " T7A ON T7A.T7A_FILIAL = T7C.T7C_FILIAL AND T7A.T7A_IDENT = T7C.T7C_IDENT "
	cQueryEventsItems += " WHERE T7C.T7C_FILIAL = ? " 
	cQueryEventsItems += " AND T7C.D_E_L_E_T_ = ? "
	cQueryEventsItems += " AND T7C.T7C_IDENT =  ? " 
	cQueryEventsItems := ChangeQuery(cQueryEventsItems)

	oQryEventsItems := FwExecStatement():New(cQueryEventsItems)

	oQryEventsItems:SetString(1, xFilial('T7A'))
	oQryEventsItems:SetString(2, '')
	oQryEventsItems:SetString(3, cIdEvent)
	cAliasEventItems := oQryEventsItems:OpenAlias()

return cAliasEventItems

/*-------------------------------------------------------------------------------
{Protheus.doc} TAFEventItems()
Metodo responsável por buscar os dados dos itens do evento de crédito presumido.

@param cIdEvento - Identificador único do evento (UUID)

@type method
@author Evandro Italo
@since 29/10/2025
@version 1.0
-------------------------------------------------------------------------------*/
method TAFEventItemsCredPresumido(cIdEvent as character) as character class TAFXmlMonitorEvent
    Local cQueryEventsCredPresumido as character
	Local oQryEventsCredPresumido as object
	Local cAliasEventCredPresumido as character

	cQueryEventsCredPresumido += " SELECT T7B.T7B_ITEM, T7B.T7B_CODTRI, T7B.T7B_VLBASE, T7B.T7B_CODCRE, T7B.T7B_PERC, T7B.T7B_VALOR " 
	cQueryEventsCredPresumido += " FROM " + RetSqlName('T7B') + " T7B "
	cQueryEventsCredPresumido += " WHERE T7B.T7B_FILIAL = ? "  
	cQueryEventsCredPresumido += " AND T7B.D_E_L_E_T_ = ? "
	cQueryEventsCredPresumido += " AND T7B.T7B_IDENT = ? "
	cQueryEventsCredPresumido := ChangeQuery(cQueryEventsCredPresumido)

	oQryEventsCredPresumido := FwExecStatement():New(cQueryEventsCredPresumido)

	oQryEventsCredPresumido:SetString(1, xFilial('T7B'))
	oQryEventsCredPresumido:SetString(2, '')
	oQryEventsCredPresumido:SetString(3, cIdEvent)
	cAliasEventCredPresumido := oQryEventsCredPresumido:OpenAlias()

return cAliasEventCredPresumido

/*-------------------------------------------------------------------------------
{Protheus.doc} TafStatusMonitorEvents()

@param cUrl - Url usada para comunicação com o TSS
@param cIdEnti - Id da entidade para comunicação com o TSS
@param cChNFe - Chave da nota fiscal
@param cIdProcessamento - Id do processamento retornado pelo TSS
@param lEventCancel - Indica se o evento é de cancelamento
@param cIdEvento - Identificador único do evento (UUID)

@type method
@author Pâmela Bernardo
@since 19/11/2025
@version 1.0
-------------------------------------------------------------------------------*/
method TafStatusMonitorEvents(cUrl as character, cIdEnti as character, cChNFe as character, ;
							cIdProcessamento as character, lEventCancel as logical, ;
							cIdEvento as character) as character class TAFXmlMonitorEvent
	Local oWS 				as object
	Local lRetorno	:= .F. 	as logical
	Local lContinua	:= .T. 	as logical
	Local aRetorno 	:= {} 	as array
	Local nX 		:= 0 	as numeric
	Local nTentativas:= 0 	as numeric
	Local cStatus 	:= "5" 	as character
	Local cStatusBefore:= "" 	as character
	Local cRetorno 	:= "" 	as character
	Local cProtocolo:= "" 	as character

	If !Empty(cIdProcessamento)
		While lContinua .And. nTentativas <=3000
			oWS:= WSNFeSBRA():New()
			oWS:cUSERTOKEN	:= "TOTVS"
			oWS:cID_ENT		:= cIdEnti
			oWS:_URL		:= AllTrim(cURL)+"/NFeSBRA.apw"
			oWS:cEvenChvNFE	:= cChNFe
			lRetorno := oWS:NFERETORNAEVENTO() .And. Valtype("oWS:oWsNfeRetornaEventoResult") <> "U" .And.Valtype("oWS:oWsNfeRetornaEventoResult:oWsNfeRetornaEvento") <> "U"
			If lRetorno
				aRetorno := oWS:oWsNfeRetornaEventoResult:oWsNfeRetornaEvento
				For nX :=1 to Len(aRetorno)
					If Alltrim(aRetorno[nX]["CID_EVENTO"]) == Alltrim(cIdProcessamento) .And. ;
						(!Empty(aRetorno[nX]["CXMOTIVO"]) .Or. !Empty(aRetorno[nX]["CXMOTIVOEVEN"]))
				
						lContinua := .F.
						cRetorno := Alltrim(aRetorno[nX]["CXMOTIVO"])
						cRetorno += " - "+Alltrim(aRetorno[nX]["CXMOTIVOEVEN"])
						cRetorno += " - "+cIdProcessamento 
						cRetorno += " - "+Alltrim(aRetorno[nX]["CXML_RET"])
						If aRetorno[nX]["NSTATUS"] == 6
							If lEventCancel
								cStatus := "4"
							Else
								cStatus := "2"
							EndIf
							cProtocolo:= cValToChar(aRetorno[nX]["NPROT"])						 
						EndIf
					EndIf
				Next nX
				FreeObj(oWS)
			EndIf
			nTentativas++
		EndDo
	Else
		cRetorno := STR0020 //"Falha de conexão com o TSS - Id de processamento não retornado."
	EndIf

	If lContinua .and. nTentativas >=3000
		cRetorno := STR0023 //"Falha de conexão com o TSS - número máximo de tentativas atingido."
	EndIf
	DbSelectArea("T7A")
	T7A->(DbSetOrder(1))
	T7A->(DbGoTop())
	IF T7A->(MsSeek( FWxFilial("T7A") + cIdEvento ))
		cStatusBefore := T7A->T7A_STATUS
		If RecLock("T7A", .F.)
			T7A->T7A_STATUS := cStatus
			IF !Empty(cProtocolo)
				T7A->T7A_PROT := cProtocolo
			Endif
			T7A->(MsUnLock())
			::SyncBatchHeaderByEvent(cIdEvento, cStatusBefore, cStatus)
		EndIf
	Endif

Return cRetorno

/*-------------------------------------------------------------------------------
{Protheus.doc} SyncBatchHeaderByEvent()

@param cIdEvento - Identificador único do evento (UUID)
@param cStatusBefore - Status anterior do evento na T7A.
@param cStatusAfter - Status final do evento na T7A.
@return lUpdated, indica se houve tentativa de sincronização da capa do lote.
@type method
@author Evandro Italo
@since 12/06/2026
@version 1.0
-------------------------------------------------------------------------------*/
method SyncBatchHeaderByEvent(cIdEvento as character, cStatusBefore as character, cStatusAfter as character) as logical class TAFXmlMonitorEvent
	Local jBatch 		:= JsonObject():New() as json
	Local jDelta 		:= JsonObject():New() as json
	Local jState 		:= JsonObject():New() as json
	Local jSnap  		:= JsonObject():New() as json
	Local jResult 		:= JsonObject():New() as json
	Local cPendingStatus := "" 	as character

	If Empty(cIdEvento) .Or. !TAFAlsInDic("T7I") .Or. !TAFColumnPos("T7A_SEQLOT")
		Return .F.
	EndIf

	jBatch := ::GetBatchContextByEvent(cIdEvento)
	If !jBatch["found"]
		Return .F.
	EndIf

	If jBatch["cancelRequested"]
		jSnap := ::GetBatchSnapshot(jBatch)
		If jSnap["total"] <= 0
			Return .F.
		EndIf

		If jSnap["pending"] > 0
			jResult["status"] := "3"
			jResult["totalSuccess"] := jSnap["canceled"]
			jResult["totalFailure"] := jSnap["failed"]
			jResult["totalLot"] := jSnap["total"]
			Return ::PersistBatchHeader(jBatch, jResult)
		EndIf

		jResult := ::ResolveBatchResult(jBatch, jSnap)
		Return ::PersistBatchHeader(jBatch, jResult)
	EndIf

	If TAFColumnPos("T7I_TOTSUC") .And. TAFColumnPos("T7I_TOTFAL")
		jDelta := ::GetBatchDelta(cStatusBefore, cStatusAfter, jBatch["cancelRequested"])
		jState := ::ApplyBatchDelta(jBatch, jDelta)
		If !jState["found"]
			Return .F.
		EndIf
		If jState["pending"] > 0
			Return .T.
		EndIf
	Else
		jSnap := ::GetBatchSnapshot(jBatch)
		If jSnap["total"] <= 0
			Return .F.
		EndIf

		If jSnap["pending"] > 0
			cPendingStatus := IIf(jBatch["cancelRequested"], "3", "1")
			Return ::PersistPendingBatchStatus(jBatch, cPendingStatus)
		EndIf
	EndIf

	jSnap := ::GetBatchSnapshot(jBatch)
	If jSnap["total"] <= 0
		Return .F.
	EndIf

	jResult := ::ResolveBatchResult(jBatch, jSnap)

Return ::PersistBatchHeader(jBatch, jResult)

/*-------------------------------------------------------------------------------
{Protheus.doc} GetBatchContextByEvent()

@param cIdEvento - Identificador único do evento (UUID)
@return jBatch, contexto do lote associado ao evento.
@type method
@author Evandro Italo
@since 12/06/2026
@version 1.0
-------------------------------------------------------------------------------*/
method GetBatchContextByEvent(cIdEvento as character) as json class TAFXmlMonitorEvent
	Local aArea 	 := GetArea() 			as array
	Local jBatch 	 := JsonObject():New() 	as json
	Local cEventCode := "" 				as character
	Local cBatchDate := "" 				as character
	Local cSequence 	:= "" 				as character

	jBatch["found"] := .F.
	jBatch["eventCode"] := ""
	jBatch["batchDate"] := ""
	jBatch["sequence"] := ""
	jBatch["cancelFlag"] := "2"
	jBatch["currentStatus"] := ""
	jBatch["cancelRequested"] := .F.
	jBatch["totalLot"] := 0
	jBatch["totalSuccess"] := 0
	jBatch["totalFailure"] := 0

	DbSelectArea("T7A")
	T7A->(DbSetOrder(1))

	If T7A->(MsSeek(FWxFilial("T7A") + cIdEvento))
		cSequence := AllTrim(T7A->T7A_SEQLOT)
		If !Empty(cSequence)
			cEventCode := AllTrim(T7A->T7A_TPEVEN)
			cBatchDate := DToS(T7A->T7A_DTEMIS)

			DbSelectArea("T7I")
			T7I->(DbSetOrder(1))

			If T7I->(MsSeek(FWxFilial("T7I") + cEventCode + cBatchDate + cSequence))
				jBatch["found"] := .T.
				jBatch["eventCode"] := cEventCode
				jBatch["batchDate"] := cBatchDate
				jBatch["sequence"] := cSequence
				jBatch["cancelFlag"] := T7I->T7I_CANC
				jBatch["currentStatus"] := T7I->T7I_STATUS
				jBatch["cancelRequested"] := T7I->T7I_CANC == "1" .Or. T7I->T7I_STATUS == "3"
				jBatch["totalLot"] := T7I->T7I_TOTLOT
				If TAFColumnPos("T7I_TOTSUC")
					jBatch["totalSuccess"] := T7I->T7I_TOTSUC
				EndIf
				If TAFColumnPos("T7I_TOTFAL")
					jBatch["totalFailure"] := T7I->T7I_TOTFAL
				EndIf
			EndIf
		EndIf
	EndIf

	RestArea(aArea)
	FwFreeArray(aArea)

Return jBatch

/*-------------------------------------------------------------------------------
{Protheus.doc} GetBatchDelta()

@param cStatusBefore - Status anterior do evento na T7A.
@param cStatusAfter - Status final do evento na T7A.
@param lCancelRequested - Indica se o lote está em fluxo de cancelamento.
@return jDelta, variação de contadores do lote.
@type method
@author Evandro Italo
@since 17/06/2026
@version 1.0
-------------------------------------------------------------------------------*/
method GetBatchDelta(cStatusBefore as character, cStatusAfter as character, lCancelRequested as logical) as json class TAFXmlMonitorEvent
	Local jDelta 		:= JsonObject():New() 	as json
	Local lOldSuccess := .F. 			as logical
	Local lNewSuccess := .F. 			as logical
	Local lOldFailure := .F. 			as logical
	Local lNewFailure := .F. 			as logical
	Local nSuccessDelta := 0 			as numeric
	Local nFailureDelta := 0 			as numeric

	lOldSuccess := IIf(lCancelRequested, cStatusBefore == "4", cStatusBefore == "2")
	lNewSuccess := IIf(lCancelRequested, cStatusAfter == "4", cStatusAfter == "2")
	lOldFailure := cStatusBefore == "5"
	lNewFailure := cStatusAfter == "5"

	If lNewSuccess .And. !lOldSuccess
		nSuccessDelta++
	ElseIf lOldSuccess .And. !lNewSuccess
		nSuccessDelta--
	EndIf

	If lNewFailure .And. !lOldFailure
		nFailureDelta++
	ElseIf lOldFailure .And. !lNewFailure
		nFailureDelta--
	EndIf

	jDelta["successDelta"] := nSuccessDelta
	jDelta["failureDelta"] := nFailureDelta
	jDelta["shouldUpdate"] := nSuccessDelta != 0 .Or. nFailureDelta != 0

Return jDelta

/*-------------------------------------------------------------------------------
{Protheus.doc} ApplyBatchDelta()

@param jBatch - Contexto do lote associado ao evento.
@param jDelta - Variação calculada para os contadores do lote.
@return jState, estado do lote após aplicar o delta.
@type method
@author Evandro Italo
@since 17/06/2026
@version 1.0
-------------------------------------------------------------------------------*/
method ApplyBatchDelta(jBatch as json, jDelta as json) as json class TAFXmlMonitorEvent
	Local aArea 		:= GetArea() 			as array
	Local jState 		:= JsonObject():New() 	as json
	Local cSeek 		:= "" 				as character
	Local cPendingStatus := "" 				as character
	Local nTotalLot 	:= 0 				as numeric
	Local nSuccess 		:= 0 				as numeric
	Local nFailure 		:= 0 				as numeric
	Local nPending 		:= 0 				as numeric

	jState["found"] := .F.
	jState["pending"] := 0
	jState["totalLot"] := 0
	jState["totalSuccess"] := 0
	jState["totalFailure"] := 0

	If !jBatch["found"]
		Return jState
	EndIf

	cSeek := FWxFilial("T7I") + jBatch["eventCode"] + jBatch["batchDate"] + jBatch["sequence"]

	DbSelectArea("T7I")
	T7I->(DbSetOrder(1))

	If T7I->(MsSeek(cSeek)) .And. RecLock("T7I", .F.)
		jState["found"] := .T.
		nTotalLot := T7I->T7I_TOTLOT
		nSuccess := IIf(TAFColumnPos("T7I_TOTSUC"), T7I->T7I_TOTSUC, 0)
		nFailure := IIf(TAFColumnPos("T7I_TOTFAL"), T7I->T7I_TOTFAL, 0)

		nSuccess += jDelta["successDelta"]
		nFailure += jDelta["failureDelta"]

		If nSuccess < 0
			nSuccess := 0
		EndIf

		If nFailure < 0
			nFailure := 0
		EndIf

		If TAFColumnPos("T7I_TOTSUC")
			T7I->T7I_TOTSUC := nSuccess
		EndIf

		If TAFColumnPos("T7I_TOTFAL")
			T7I->T7I_TOTFAL := nFailure
		EndIf

		nPending := nTotalLot - nSuccess - nFailure
		If nPending < 0
			nPending := 0
		EndIf

		If nPending > 0
			cPendingStatus := IIf(jBatch["cancelRequested"], "3", "1")
			If T7I->T7I_STATUS != cPendingStatus
				T7I->T7I_STATUS := cPendingStatus
			EndIf
		EndIf

		T7I->(MsUnLock())

		jState["pending"] := nPending
		jState["totalLot"] := nTotalLot
		jState["totalSuccess"] := nSuccess
		jState["totalFailure"] := nFailure
	EndIf

	RestArea(aArea)
	FwFreeArray(aArea)

Return jState

/*-------------------------------------------------------------------------------
{Protheus.doc} GetBatchSnapshot()

@param jBatch - Contexto do lote associado ao evento.
@return jSnap, snapshot agregado do lote em T7A.
@type method
@author Evandro Italo
@since 12/06/2026
@version 1.0
-------------------------------------------------------------------------------*/
method GetBatchSnapshot(jBatch as json) as json class TAFXmlMonitorEvent
	Local jSnap 		:= JsonObject():New() 	as json
	Local cQuery 		:= "" 				as character
	Local cAliasQuery 	:= "" 				as character
	Local oStmt 		:= Nil 				as object

	jSnap["total"] := 0
	jSnap["pending"] := 0
	jSnap["sent"] := 0
	jSnap["canceled"] := 0
	jSnap["failed"] := 0

	If !jBatch["found"]
		Return jSnap
	EndIf

	cQuery += " SELECT COUNT(*) TOTAL, "
	cQuery += "        COALESCE(SUM(CASE WHEN T7A.T7A_STATUS IN ('1','3') THEN 1 ELSE 0 END), 0) PENDING, "
	cQuery += "        COALESCE(SUM(CASE WHEN T7A.T7A_STATUS = '2' THEN 1 ELSE 0 END), 0) SENT, "
	cQuery += "        COALESCE(SUM(CASE WHEN T7A.T7A_STATUS = '4' THEN 1 ELSE 0 END), 0) CANCELED, "
	cQuery += "        COALESCE(SUM(CASE WHEN T7A.T7A_STATUS = '5' THEN 1 ELSE 0 END), 0) FAILED "
	cQuery += " FROM " + RetSqlName("T7A") + " T7A "
	cQuery += " WHERE T7A.T7A_FILIAL = ? "
	cQuery += "   AND T7A.T7A_TPEVEN = ? "
	cQuery += "   AND T7A.T7A_DTEMIS = ? "
	cQuery += "   AND T7A.T7A_SEQLOT = ? "
	cQuery += "   AND T7A.D_E_L_E_T_ = ? "
	cQuery := ChangeQuery(cQuery)

	oStmt := FwExecStatement():New(cQuery)
	oStmt:SetString(1, FWxFilial("T7A"))
	oStmt:SetString(2, jBatch["eventCode"])
	oStmt:SetString(3, jBatch["batchDate"])
	oStmt:SetString(4, jBatch["sequence"])
	oStmt:SetString(5, " ")
	cAliasQuery := oStmt:OpenAlias()

	If !Empty(cAliasQuery)
		jSnap["total"] := Val(AllTrim(cValToChar((cAliasQuery)->TOTAL)))
		jSnap["pending"] := Val(AllTrim(cValToChar((cAliasQuery)->PENDING)))
		jSnap["sent"] := Val(AllTrim(cValToChar((cAliasQuery)->SENT)))
		jSnap["canceled"] := Val(AllTrim(cValToChar((cAliasQuery)->CANCELED)))
		jSnap["failed"] := Val(AllTrim(cValToChar((cAliasQuery)->FAILED)))
		(cAliasQuery)->(DbCloseArea())
	EndIf

	If oStmt != Nil
		oStmt:Destroy()
		FreeObj(oStmt)
	EndIf

Return jSnap

/*-------------------------------------------------------------------------------
{Protheus.doc} ResolveBatchResult()

@param jBatch - Contexto do lote associado ao evento.
@param jSnap - Snapshot agregado do lote em T7A.
@return jResult, resultado consolidado para gravação na T7I.
@type method
@author Evandro Italo
@since 12/06/2026
@version 1.0
-------------------------------------------------------------------------------*/
method ResolveBatchResult(jBatch as json, jSnap as json) as json class TAFXmlMonitorEvent
	Local jResult 			 := JsonObject():New() 	as json
	Local lCancelRequested := .F. 				as logical
	Local nSuccess 			 := 0 				as numeric
	Local nFailure 			 := 0 				as numeric
	Local nTotal 			 := 0 				as numeric
	Local cStatus 			 := jBatch["currentStatus"] 	as character

	lCancelRequested := jBatch["cancelRequested"]
	nFailure := jSnap["failed"]
	nTotal := jSnap["total"]

	If lCancelRequested
		nSuccess := jSnap["canceled"]
		If nFailure >= nTotal .And. nTotal > 0
			cStatus := "5"
		ElseIf nSuccess >= nTotal .And. nTotal > 0
			cStatus := "4"
		Else
			cStatus := "6"
		EndIf
	Else
		nSuccess := jSnap["sent"]
		If nFailure >= nTotal .And. nTotal > 0
			cStatus := "5"
		ElseIf nSuccess >= nTotal .And. nTotal > 0
			cStatus := "2"
		Else
			cStatus := "6"
		EndIf
	EndIf

	jResult["status"] := cStatus
	jResult["totalSuccess"] := nSuccess
	jResult["totalFailure"] := nFailure
	jResult["totalLot"] := nTotal

Return jResult

/*-------------------------------------------------------------------------------
{Protheus.doc} PersistPendingBatchStatus()

@param jBatch - Contexto do lote associado ao evento.
@param cPendingStatus - Status transitório a ser mantido na capa.
@return lUpdated, indica se a capa foi localizada para atualização.
@type method
@author Evandro Italo
@since 12/06/2026
@version 1.0
-------------------------------------------------------------------------------*/
method PersistPendingBatchStatus(jBatch as json, cPendingStatus as character) as logical class TAFXmlMonitorEvent
	Local aArea 	:= GetArea() 	as array
	Local lUpdated := .F. 		as logical
	Local cSeek 	:= "" 		as character

	If !jBatch["found"] .Or. Empty(cPendingStatus)
		Return .F.
	EndIf

	cSeek := FWxFilial("T7I") + jBatch["eventCode"] + jBatch["batchDate"] + jBatch["sequence"]

	DbSelectArea("T7I")
	T7I->(DbSetOrder(1))

	If T7I->(MsSeek(cSeek))
		lUpdated := .T.
		If T7I->T7I_STATUS != cPendingStatus .And. RecLock("T7I", .F.)
			T7I->T7I_STATUS := cPendingStatus
			T7I->(MsUnLock())
		EndIf
	EndIf

	RestArea(aArea)
	FwFreeArray(aArea)

Return lUpdated

/*-------------------------------------------------------------------------------
{Protheus.doc} PersistBatchHeader()

@param jBatch - Contexto do lote associado ao evento.
@param jResult - Resultado consolidado para gravação na T7I.
@return lUpdated, indica se a capa foi localizada para atualização.
@type method
@author Evandro Italo
@since 12/06/2026
@version 1.0
-------------------------------------------------------------------------------*/
method PersistBatchHeader(jBatch as json, jResult as json) as logical class TAFXmlMonitorEvent
	Local aArea 	:= GetArea() 	as array
	Local lUpdated := .F. 		as logical
	Local cSeek 	:= "" 		as character

	If !jBatch["found"]
		Return .F.
	EndIf

	cSeek := FWxFilial("T7I") + jBatch["eventCode"] + jBatch["batchDate"] + jBatch["sequence"]

	DbSelectArea("T7I")
	T7I->(DbSetOrder(1))

	If T7I->(MsSeek(cSeek)) .And. RecLock("T7I", .F.)
		lUpdated := .T.
		T7I->T7I_STATUS := jResult["status"]
		If TAFColumnPos("T7I_TOTSUC")
			T7I->T7I_TOTSUC := jResult["totalSuccess"]
		EndIf
		If TAFColumnPos("T7I_TOTFAL")
			T7I->T7I_TOTFAL := jResult["totalFailure"]
		EndIf
		If TAFColumnPos("T7I_TOTLOT")
			T7I->T7I_TOTLOT := jResult["totalLot"]
		EndIf
		T7I->(MsUnLock())
	EndIf

	RestArea(aArea)
	FwFreeArray(aArea)

Return lUpdated

/*-------------------------------------------------------------------------------
{Protheus.doc} TafSaveLogsMonitorEvents()

@param cError - Mensagem de erro retornada pelo TSS
@param cResultadoProcessamento - Mensagem de retorno do processamento
@param cMsg - Mensagem completa retornada pelo TSS
@param cIdEvento - Identificador único do evento (UUID)
@param cXmlCreated - XML do evento enviado ao TSS
@type method
@author Evandro Italo
@since 29/10/2025
@version 1.0
-------------------------------------------------------------------------------*/
method TafSaveLogsMonitorEvents(cError as character, cResultadoProcessamento as character , cMsg as character,;
								 cIdEvento as character, cXmlCreated as character) class TAFXmlMonitorEvent

	Local dSendDate := Date()  as date
	Local cSendTime := Time()  as character	
	Local cDadoslog := " " as character	

	cDadoslog:= STR0021+IIF(!EMPTY(cError), STR0016 + cError + " - " + ; //"Retorno do Processamento: "
				cMsg, cResultadoProcessamento)

	DbSelectArea("T7D")
	//Grava log na tabela T7D
	IF RecLock("T7D", .T.)
		T7D->T7D_FILIAL	:= xFilial("T7D")
		T7D->T7D_IDLOG	:= FwUUIDv4(.T.)
		T7D->T7D_IDENT	:= cIdEvento
		T7D->T7D_DATA	:= dSendDate
		T7D->T7D_HORA	:= cSendTime
		T7D->T7D_XMSG	:= cDadoslog
		If TAFColumnPos("T7D_SNDXML")
			T7D->T7D_SNDXML	:= cXmlCreated
		EndIf
		T7D->(MsUnLock())
	ENDIF
Return 

/*-------------------------------------------------------------------------------
{Protheus.doc} Conv2Dec()

@param nNum - Valor que será convertido conforme manual da Sefaz

@type method
@author Carla Bianca
@since 21/11/2025
@version 1.0
-------------------------------------------------------------------------------*/

Method Conv2Dec(nNum as numeric) as character class TAFXmlMonitorEvent
    Local cNumFormat as character

    cNumFormat := Alltrim(Str(nNum, 15, 2))
    cNumFormat := StrTran(cNumFormat, ",", ".")

Return cNumFormat
/*-------------------------------------------------------------------------------
{Protheus.doc} TafGetTaxNFe()

@param cChNFOrig - chave da nota fiscal eletrônica
@param cCodTrib - código do tributo
@param cCurItem - código do item
@return nVlrTributed, retorna o valor total do tributo.
@type method
@author Pâmela Bernardo
@since 16/01/2026
@version 1.0
-------------------------------------------------------------------------------*/

method TafGetTaxNFe(cChNFOrig as character, cCodTrib as character, cCurItem as character)	as numeric class TAFXmlMonitorEvent
	Local nVlrTributed 	as numeric
	Local cQueryC35		as character

	If __oQueryC35 == Nil
		cQueryC35 += " SELECT SUM(C35.C35_VALOR) VALOR "
		cQueryC35 += " FROM " + RetSqlName('C35') + " C35 "
		cQueryC35 += " INNER JOIN " + RetSqlName("C30") + " C30 "
		cQueryC35 += " ON  C30.C30_FILIAL = C35.C35_FILIAL "
		cQueryC35 += " AND C30.C30_CHVNF  = C35.C35_CHVNF "
		cQueryC35 += " AND C30.C30_NUMITE = C35.C35_NUMITE"
		cQueryC35 += " AND C30.C30_ITEXML  =  ?
		cQueryC35 += " AND C30.D_E_L_E_T_ = ? "
		cQueryC35 += " WHERE C35.C35_CHVNF  = ? "
		cQueryC35 += " AND C35.C35_CODTRI = ? "
		cQueryC35 += " AND C35.D_E_L_E_T_ = ? "
		cQueryC35 := ChangeQuery(cQueryC35)

		__oQueryC35 := FwExecStatement():New(cQueryC35)
	EndIf
	__oQueryC35:SetString(1, cCurItem)
	__oQueryC35:SetString(2, ' ')
	__oQueryC35:SetString(3, cChNFOrig)
	__oQueryC35:SetString(4, cCodTrib)
	__oQueryC35:SetString(5, ' ')

	nVlrTributed	:= __oQueryC35:ExecScalar("VALOR")

Return nVlrTributed
