Return oHashT7R

//---------------------------------------------------------------------
/*/{Protheus.doc} GetIDCache
@type			static function
@description	Busca o _ID de cada consulta F3 no cache da tabela e caso não encontre, 
				pesquisa diretamente na tabela e alimenta o cache para uma próxima busca.
@author			Carlos Pister
@since			07/03/2025
@version		1.0
@param          cAlias - Alias da tabela
@param          cChave - Chave da tabela
@param          nIndex - Indice da tabela
@param          oHash - Hash do alias
@return			cRet
/*/
//---------------------------------------------------------------------
Function GetIDCache( cAlias, cChave, nIndex, oHash )
	Local   cRet := ''
	Default cAlias := ''
	Default cChave := ''
	Default nIndex := 0

	If ValType(oHash) == "O"
		HMGet( oHash, cChave, @cRet )
		If Empty(cRet)
			cRet := GetTafId( cAlias, cChave, nIndex, oHash )
			SetHashKey(oHash, cChave, cRet)
		Endif
	EndIf

Return cRet

//---------------------------------------------------------------------
/*/{Protheus.doc} ValCodMod
@type			static function
@description	Retorna o código do modelo 
@author			Carlos Pister
@since			07/03/2025
@version		1.0
@param          cCodMod - Código do modelo
@return			cCodMod
/*/
//---------------------------------------------------------------------
static function ValCodMod(cCodMod)
	Default cCodMod := ''
	If empty(cCodMod)
		cCodMod := '000001'
	EndIf
return cCodMod

//---------------------------------------------------------------------
/*/{Protheus.doc} ValCodCst
@type			static function
@description	Ajusta o codigo do cst
@author			Carlos Pister
@since			07/03/2025
@version		1.0
@param          cCodCst - Código CST; cIDTrib - Id do Tributo
@return			Nil
/*/
//---------------------------------------------------------------------
static function ValCodCst(cCodCst,cIDTrib)

	Local cAliasCst := "" as character

	Default cCodCst := ""
	Default cIDTrib := ""

	If !empty(cIDTrib)
		cAliasCst	:= XFUNChgF3(,,,cIdTrib) //Consulta tabela específica conforme o tributo.
	EndIf

	If cCodCst == "0  " //mantem o mesmo mecanismo do extrator fiscal
		cCodCst := '00 '
	EndIf
	If !Empty(cAliasCst)
		cCodCst := alltrim(Posicione( cAliasCst , 1 , xFilial( cAliasCst ) + cCodCst , cAliasCst+'_ID' ))
	EndIf

return cCodCst

//---------------------------------------------------------------------
/*/{Protheus.doc} KeyIndex
@type			Monta o indice da C20
@description	Ajusta o codigo do cst
@author			Carlos Pister
@since			07/03/2025
@version		1.0
@return			Nil
/*/
//---------------------------------------------------------------------
static function KeyIndex(jData as json, oHashC1H as object)

	Local cKey := "" as character

	Default jData := {}

	cKey := padr(jData['operationType'],_nTmINDOPE)
	cKey += ValCodMod(padr(GetIDCache('C01',jData['modelIdentificationCode'],1,oHashC01),_nTmCODMOD))
	cKey += padr(jData['taxDocumentSeries'],_nTmSERIE)
	cKey += padr('',_nTmSUBSER)
	cKey += padr(jData['taxDocumentNumber'],_nTmNUMDOC)
	cKey += padr(DTOS(CTOD(jData['fiscalDocumentDate'])),_nTmDTDOC)
	cKey += padr(GetIDCache('C1H',jData['participatingCode'],1,oHashC1H),_nTmCODPAR)

return cKey

//---------------------------------------------------------------------
/*/{Protheus.doc} KeyLogs
@type			Monta as chaves 
@description	Ajusta o codigo do cst
@author			Carlos Pister
@since			07/03/2025
@version		1.0
@return			Nil
/*/
//---------------------------------------------------------------------
static function KeyLogs(jData as json, oHash as object, cKeyERP as character, cKeyV5r as character)

	Default cKeyERP := ""
	Default cKeyV5r := ""
	Default jData := {}

	cKeyERP := jData['operationType'] + '|'
	cKeyERP += padr(DTOS(CTOD(jData['fiscalDocumentDate'])),_nTmDTDOC) + '|'
	cKeyERP += padr(jData['taxDocumentSeries'],_nTmSERIE) + '|'
	cKeyERP += padr(jData['taxDocumentNumber'],_nTmNUMDOC) + '|'
	cKeyERP += SubStr(LTrim(jData['participatingCode']), 2, _nTmCliFor) + '|'
	cKeyERP += Right(RTrim(jData['participatingCode']), _nTmLoja)

	cKeyV5r := padr(jData['modelIdentificationCode'],_nTmCODMOD)
	cKeyV5r += padr(jData['operationType'],_nTmINDOPE)
	cKeyV5r += padr(jData['documentType'], GetSx3Cache( 'C20_TPDOC','X3_TAMANHO'))
	cKeyV5r += padr(jData['taxDocumentIssuer'], GetSx3Cache( 'C20_INDEMI','X3_TAMANHO'))
	cKeyV5r += padr(jData['participatingCode'], _nTmCODPAR)
	cKeyV5r += padr(jData['identificationSituation'], GetSx3Cache( 'C20_CODSIT','X3_TAMANHO'))
	cKeyV5r += padr(jData['taxDocumentSeries'],_nTmSERIE)
	cKeyV5r += padr('',_nTmSUBSER)
	cKeyV5r += padr(jData['taxDocumentNumber'],_nTmNUMDOC)
	cKeyV5r += padr(DTOS(CTOD(jData['fiscalDocumentDate'])),_nTmDTDOC)
	cKeyV5r += padr(DTOS(CTOD(jData['taxDocumentEntryAndExitDate'])), GetSx3Cache( 'C20_DTES','X3_TAMANHO'))

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} ValidNFRef
@type			
@description	Valida notas referenciadas as notas de débito/crédito
@author			Rafael Leme / Carlos Pister / José Felipe
@since			25/11/2025
@version		1.0
@return			Nil
/*/
//---------------------------------------------------------------------
Static Function ValidNFRef(jData)

	Local oPrepare   as object
	Local oNFOri     as object
	Local aBind      as array
	Local aAreaC20   as array
	Local aAreaC30   as array
	Local aAreaSFT   as array
	Local aNFOri     as array
	Local lOk        as logical
	Local nX         as numeric
	Local nY         as numeric
	Local nLen       as numeric
	Local nTamChvEle as numeric
	Local nTamIteC30 as numeric
	Local cQuery     as character
	Local cAliasDKN  as character
	Local cChave     as character
	Local cTpMov	 as character
	
	Default jData := Nil

	oPrepare   := Nil
	oNFOri     := Nil
	aBind      := {}
	aNFOri     := {}
	aAreaC20   := C20->(GetArea())
	aAreaC30   := C30->(GetArea())
	aAreaSFT   := SFT->(GetArea())
	lOk        := .F.
	nX         := 0
	nY         := 0
	nLen       := 0
	nTamChvEle := FWSX3Util():GetFieldStruct("C20_CHVELE")[3]
	nTamIteC30 := FWSX3Util():GetFieldStruct("C30_ITEXML")[3]
	cQuery     := ''
	cAliasDKN  := ''
	cChave     := ''
	cTpMov	   := ''

	cQuery := "SELECT "
	cQuery += "DKN.DKN_FILIAL, DKN.DKN_ITEMNF, DKN.DKN_CHVNFE, DKN.DKN_ITXML, DKN.DKN_ITNFRE, DKN.DKN_DOC, "
	cQuery += "DKN.DKN_TPMOV, DKN.DKN_SERREF, DKN.DKN_CLIFOR, DKN.DKN_DOCREF, DKN.DKN_SERIE, DKN.DKN_LOJA "
	cQuery += "FROM " + RetSqlName("DKN") + " DKN "
	cQuery += "WHERE "
	cQuery += "DKN.DKN_FILIAL = ?  AND "
	cQuery += "DKN.DKN_SERIE  = ?  AND "
	
	If !jData["typeOfTaxSupplement"] = "6"
		cQuery += "DKN.DKN_DOC    = ?  AND "
	Else
		cQuery += "DKN.DKN_DOCREF    = ?  AND "
	EndIf
	
	cQuery += "DKN.DKN_CLIFOR = ?  AND "
	cQuery += "DKN.DKN_LOJA   = ?  AND "
	cQuery += "DKN.DKN_CHVNFE <> ? AND "
	cQuery += "DKN.D_E_L_E_T_ = ? "

	aAdd(aBind, xFilial("C20"))
	aAdd(aBind, jData["taxDocumentSeries"])
	aAdd(aBind, jData["taxDocumentNumber"])
	aAdd(aBind, jData["clieFor"])
	aAdd(aBind, jData["loja"])
	aAdd(aBind, Space(1))
	aAdd(aBind, Space(1))

	oPrepare := FwExecStatement():New(ChangeQuery(cQuery)) 

	For nX := 1 to Len(aBind) 
		oPrepare:setString(nX, aBind[nX])
	Next nX

	cAliasDKN := oPrepare:OpenAlias() 

	DBSelectArea("C20")
	C20->(DBSetOrder(3))

	DBSelectArea("C30")
	C30->(DBSetOrder(5))

	DBSelectArea("SFT")
	SFT->(DBSetOrder(1))

	If !(cAliasDKN)->(EoF())
		lOk := .T.
		jData[DOCUMENTOS_COMPLEMENTARES] := {}
		While !(cAliasDKN)->(EoF()) .and. lOk
			lOk := .F.
			If !jData["typeOfTaxSupplement"] = "6"
				cChave := (cAliasDKN)->DKN_FILIAL + PadR((cAliasDKN)->DKN_CHVNFE,nTamChvEle)
			EndIf
			If C20->(MsSeek(cChave)) .AND. !Empty(cChave)
				_aNFxDKN[NF_COMUM] := .T.
				If (jData["operationType"] == "0" .and. jData["documentType"] == "07" .and. jData["typeOfTaxSupplement"] == "3") .or.;
				   (jData["operationType"] == "0" .and. jData["documentType"] == "08" .and. jData["typeOfTaxSupplement"] == "4") .or.;
				   (jData["operationType"] == "1" .and. jData["documentType"] == "08" .and. jData["typeOfTaxSupplement"] == "7")
					
					If jData["operationType"] == "0" .and. jData["documentType"] == "07" .and. jData["typeOfTaxSupplement"] == "3"
						cChave := (cAliasDKN)->DKN_FILIAL + C20->C20_CHVNF + PadR((cAliasDKN)->DKN_ITNFRE, nTamIteC30)
					Else
						cChave := ''
						If !Empty((cAliasDKN)->DKN_ITXML)
							cChave := (cAliasDKN)->DKN_FILIAL + C20->C20_CHVNF + PadR((cAliasDKN)->DKN_ITXML, nTamIteC30)
						EndIf
					EndIf
					
					If !Empty(cChave) .and. C30->(MsSeek(cChave))
						aAdd(aNFOri, {(cAliasDKN)->DKN_ITEMNF, C20->C20_CHVNF, C30->C30_NUMITE, C30->C30_ITEXML, (cAliasDKN)->DKN_TPMOV})	
						lOK := .T.					
					EndIf
				Else
					AAdd(jData[DOCUMENTOS_COMPLEMENTARES], JsonObject():New())
					nLen := Len(jData[DOCUMENTOS_COMPLEMENTARES])
					jData[DOCUMENTOS_COMPLEMENTARES][nLen]["operationType"]                := jData["operationType"]
					jData[DOCUMENTOS_COMPLEMENTARES][nLen]["supplementTaxDocumentKey"]     := C20->C20_CHVNF
					jData[DOCUMENTOS_COMPLEMENTARES][nLen]["supplementTaxDocumentItemKey"] := ''
					jData[DOCUMENTOS_COMPLEMENTARES][nLen]["xmlItem"]                      := ''
					jData[DOCUMENTOS_COMPLEMENTARES][nLen]["supplementTypeMovement"]       := C20->C20_INDOPE

					lOK := .T.
				EndIf
			ElseIf jData["typeOfTaxSupplement"] = "6" .and. (jData["documentType"] == "07" .or. jData["documentType"] == "08")

				cTpMov := IIF((cAliasDKN)->DKN_TPMOV == "1",'E','S')
				cChave := (cAliasDKN)->DKN_FILIAL + cTpMov + (cAliasDKN)->DKN_SERIE + (cAliasDKN)->DKN_DOC + (cAliasDKN)->DKN_CLIFOR + (cAliasDKN)->DKN_LOJA
				If SFT->(MsSeek(cChave))
					If !Empty(SFT->FT_CHVNFE)
						cChave := (cAliasDKN)->DKN_FILIAL + PadR(SFT->FT_CHVNFE,nTamChvEle)
						If C20->(MsSeek(cChave))
							_aNFxDKN[NF_DEB_CRED] := .T.

							AAdd(jData[DOCUMENTOS_COMPLEMENTARES], JsonObject():New())
							nLen := Len(jData[DOCUMENTOS_COMPLEMENTARES])
							jData[DOCUMENTOS_COMPLEMENTARES][nLen]["operationType"]                := jData["operationType"]
							jData[DOCUMENTOS_COMPLEMENTARES][nLen]["supplementTaxDocumentKey"]     := C20->C20_CHVNF
							jData[DOCUMENTOS_COMPLEMENTARES][nLen]["supplementTaxDocumentItemKey"] := ''
							jData[DOCUMENTOS_COMPLEMENTARES][nLen]["xmlItem"]                      := ''
							jData[DOCUMENTOS_COMPLEMENTARES][nLen]["supplementTypeMovement"]       := C20->C20_INDOPE

						EndIf
					EndIf
				EndIf
			EndIf

			(cAliasDKN)->(DbSkip())
		EndDo
	EndIf

	If lOk .and. Len(aNFOri) > 0
		oNFOri := AToHM(aNFOri, 1, 0)
		For nX := 1 to Len(jData[ITENS])
			jData[ITENS][nX][ITENS_DOCUMENTOS_COMPLEMENTARES] := {}
			aNFOri := {}
			HMGet(oNFOri,jData[ITENS][nX]["sftItem"], aNFOri)
			For nY := 1 to Len(aNFOri)
				AAdd(jData[ITENS][nX][ITENS_DOCUMENTOS_COMPLEMENTARES], JsonObject():New())
				nLen := Len(jData[ITENS][nX][ITENS_DOCUMENTOS_COMPLEMENTARES])
				jData[ITENS][nX][ITENS_DOCUMENTOS_COMPLEMENTARES][nLen]["operationType"]                := jData["operationType"]
				jData[ITENS][nX][ITENS_DOCUMENTOS_COMPLEMENTARES][nLen]["supplementTaxDocumentKey"]     := aNFOri[nY][2]
				jData[ITENS][nX][ITENS_DOCUMENTOS_COMPLEMENTARES][nLen]["supplementTaxDocumentItemKey"] := aNFOri[nY][3]
				jData[ITENS][nX][ITENS_DOCUMENTOS_COMPLEMENTARES][nLen]["xmlItem"]                      := aNFOri[nY][4]
				jData[ITENS][nX][ITENS_DOCUMENTOS_COMPLEMENTARES][nLen]["supplementTypeMovement"]       := Iif(aNFOri[nX][5] == '1','0','1')
			Next nY
		Next nX
	EndIf

	(cAliasDKN)->(DBCloseArea())
	oPrepare:Destroy()
	oNFOri := Nil
	aNFOri := {}
	aBind  := {}

	RestArea(aAreaC20)
	RestArea(aAreaC30)
	RestArea(aAreaSFT)

Return lOk

//---------------------------------------------------------------------
/*/{Protheus.doc} AtualizaChaveEventos
@type			function
@description	Atualiza o campo T7A_CHVNF nos eventos de NF-e
@author			Pâmela Bernardo
@since			16/12/2025
@version		1.0
@param          cChvNF - Chave da NF integrada
@param          cChvEletronica - Chave eletrônica da nota fiscal
@return			lRet - Verdadeiro se atualizar com sucesso, falso caso contrário.
/*/
//---------------------------------------------------------------------
Static Function AtualizaChaveEventos(cChvNF as character, cChvEletronica as character) as logical

	Local cQuery    := ''  as character
	Local lTemT7A   := FwAliasInDic('T7A') as logical
	Local cError	:= "" as character
	Local lRet	  	:= .T. as logical

	Default cChvNF := ''
	Default cChvEletronica := ''

	If lTemT7A .And. !Empty(cChvNF) .And. !Empty(cChvEletronica)
		If __oUpdateT7A == Nil
			
			cQuery := "UPDATE " + RetSqlName("T7A") + " SET T7A_CHVNF = ? "
			cQuery += "WHERE T7A_FILIAL = ? AND T7A_CHVELE = ? AND D_E_L_E_T_ = ? "
			
			__oUpdateT7A := FwExecStatement():New(cQuery)
		EndIf

		__oUpdateT7A:setString(1, cChvNF)
		__oUpdateT7A:setString(2, xFilial("T7A"))
		__oUpdateT7A:setString(3, cChvEletronica)
		__oUpdateT7A:setString(4, Space(1))

		cQuery := __oUpdateT7A:GetFixQuery()
		If !TAFExecQuery(cQuery, .F., @cError)
			TAFConOut(cError, 3,, STR0001)//"Erro ao atualizar chave NF nos eventos T7A."
			lRet := .F.
		EndIf
	EndIf
Return lRet
