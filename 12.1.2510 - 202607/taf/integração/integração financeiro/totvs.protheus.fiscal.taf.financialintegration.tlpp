Return .T.

/*/{Protheus.doc} Buscafilialcentralizadora
@type			Function
@description	Função para buscar a filial centralizada onde ocorrerá a integração
@author			Pâmela Bernardo
@since			02/07/2025
@version		1.0
/*/
Static Function Buscafilialcentralizadora()

	Local cFilRet := "" as character
	Local cQuery  := "" as character
	Local lCentraliza  := SuperGetMV("MV_TAFCSCP", .F., "2")=="1" as logical

	If lCentraliza
	
		If __oQueryC1E == Nil
			cQuery := " SELECT C1E_FILTAF FILIAL "
			cQuery += " FROM "+RetSQLName("C1E")+" C1E "
			cQuery += " WHERE "
			cQuery += " C1E_FILIAL = ? AND "
			cQuery += " C1E_CODFIL = ? AND "
			cQuery += " C1E_ATIVO = ? AND "
			cQuery += " C1E.D_E_L_E_T_ = ? "
			cQuery := ChangeQuery(cQuery)
			__oQueryC1E := FwExecStatement():New(cQuery)
		EndIf

		If __oQueryC1E!=Nil
			__oQueryC1E:setString(1, xFilial("C1E") )
			__oQueryC1E:setString(2, cEmpAnt+cFilAnt )
			__oQueryC1E:setString(3, "1" )
			__oQueryC1E:setString(4, ' ' )
			cQuery := __oQueryC1E:GetFixQuery()
			cFilRet := MPSysExecScalar(cQuery, 'FILIAL')

		EndIf

		If Empty(cFilRet)
			If __oQueryCR9 == Nil
				cQuery := " SELECT C1E_FILTAF FILIAL "
				cQuery += " FROM "+RetSQLName("C1E")+" C1E "
				cQuery += " INNER JOIN "+RetSQLName("CR9")+" CR9 ON "
				cQuery += " CR9.CR9_FILIAL = C1E.C1E_FILIAL AND "
				cQuery += " CR9.CR9_ID = C1E.C1E_ID AND "
				cQuery += " CR9_CODFIL = ? AND "
				cQuery += " CR9_ATIVO = ? AND "
				cQuery += " CR9.D_E_L_E_T_ = ? "
				cQuery += " WHERE "
				cQuery += " C1E_FILIAL = ? AND "
				cQuery += " C1E_ATIVO = ? AND "
				cQuery += " C1E.D_E_L_E_T_ = ? "
				cQuery := ChangeQuery(cQuery)
				__oQueryCR9 := FwExecStatement():New(cQuery)
			EndIf

			If __oQueryCR9 != Nil
				__oQueryCR9:setString(1, cEmpAnt+cFilAnt )
				__oQueryCR9:setString(2, "1" )
				__oQueryCR9:setString(3, ' ' )
				__oQueryCR9:setString(4, xFilial("C1E") )
				__oQueryCR9:setString(5, "1" )
				__oQueryCR9:setString(6, ' ' )
				cQuery := __oQueryCR9:GetFixQuery()
				cFilRet := MPSysExecScalar(cQuery, 'FILIAL')
				If Empty(cFilRet)
					cFilRet:= cFilant
				EndIf
			EndIf
		EndIf
	Else
		cFilRet:= cFilant
	EndIf
Return cFilRet
