#INCLUDE "TLPP-CORE.TH"
#INCLUDE "PROTHEUS.CH"
#INCLUDE "TAFXFIN.CH"
#INCLUDE "FWMVCDEF.CH"

namespace totvs.protheus.fiscal.taf.financialintegration

/*/{Protheus.doc} GravaT158
@type			Function
@description	Função para complementar a tabela V3U, com os dados dos registros T158
@author			Pâmela Bernardo
@since			17/03/2025
@version		1.0
/*/
Function GravaT158(jRetornoT158 as json, aDadosLog as array, cAliasTemp as character) as logical
	Local lGravadados 	:= .T. as Logical
	Local nOperacao	  	:= MODEL_OPERATION_UPDATE as Numeric
	Local nTotalJson  	:= 0 as Numeric
	Local nTotalSubJsonT158AA := 0 as Numeric
	Local nTotalSubJsonT158AB := 0 as Numeric
	Local nTotalSubJsonT158AC := 0 as Numeric
	Local nTotalSubJsonT158AD := 0 as Numeric
	Local nTotalSubJsonT158AE := 0 as Numeric
	Local nTotalSubJsonT158AF := 0 as Numeric
	Local nTotalSubJsonT158AG := 0 as Numeric
	Local nTotalSubJsonT158AH := 0 as Numeric
	Local nX  		  	:= 0 as Numeric
	Local nY  		  	:= 0 as Numeric
	Local nZ  		  	:= 0 as Numeric
	Local nA  		  	:= 0 as Numeric
	Local nB  		  	:= 0 as Numeric
	Local cLog			:= "" as character
	Local cCodigoParticipante:= "" as character
	Local cIdParticipante	:= "" as character
	Local cIdProcesso	:= "" as character
	Local cNumeroProcesso	:= "" as character
	Local cIdSuspensao	:= "" as character
	Local cCodigoSuspensao	:= "" as character
	Local cVersaoSuspensao	 := "" as character
	Local cCodigoDependente	:= "" as character
	Local cTipoIsencao	:= "" as character
	Local cIDNaturezaRendimento := "" as character
	Local cIDTributo := "" as character
	Local cIDLEM := "" as character
	Local cFCISCP	:= "" as character
	Local oModel535		as object
	Local oMODEL_V3U 	as object
	Local oMODEL_V3V	as object
	Local oMODEL_V46 	as object
	Local oModel_V4H 	as object
	Local oModel_V4I 	as object
	Local oModel_V4J 	as object
	Local oModel_V85	as object
	Local oModel_V95 	as object
	Local oModel_V90 	as object
	Local iPrefixo	 := GetSX3Cache("LEM_PREFIX"	, "X3_TAMANHO") as integer
	Local iNumero	 := GetSX3Cache("LEM_NUMERO"	, "X3_TAMANHO") as integer
	Local iVersao	 := GetSX3Cache("C1G_VERSAO"	, "X3_TAMANHO") as integer
	Local lContinua	 := .T. as Logical

	If Valtype(jRetornoT158) == "J" .And. Valtype(jRetornoT158["T158"]) == "A"
		nTotalJson := Len(jRetornoT158["T158"])

		For nX:=1 to nTotalJson
			cIDLEM := ""
			cCodigoParticipante := ""
			cIdParticipante := ""
			lContinua	 := .T.
			If lGravadados
				V14->(DbSetOrder(5))
				If V14->(DbSeek(xFilial("V14")+Alltrim(jRetornoT158["T158"][nX]["COD_PARTICIPANTE"])))
					cCodigoParticipante := V14->V14_CODPAR
					cIdParticipante:= V14->V14_IDC1H
				EndIf
				If nX > 1 .And. (cAliasTemp)->TMP_INTEGR == "1"
					nOperacao :=  MODEL_OPERATION_INSERT
				Else
					V3U->(DbSetOrder(4))//V3U_FILIAL+V3U_IDBAIX
					lContinua	 := V3U->(DbSeek(xFilial("V3U")+(cAliasTemp)->TMP_IDMOV))
				EndIf
				If lContinua
					oModel535  := FWLoadModel("TAFA535")
					oModel535:SetOperation( nOperacao ) //Alteração
					oModel535:Activate()

					LEM->(dbSetOrder(2))//LEM_FILIAL+LEM_PREFIX+LEM_NUMERO+LEM_IDPART+DTOS(LEM_DTEMIS)
					If LEM->(DbSeek(xFilial("LEM")+PadR(jRetornoT158["T158"][nX]["SERIE"],iPrefixo)+;
							PadR(jRetornoT158["T158"][nX]["NUMERO"],iNumero)+cIdParticipante))
						cIDLEM := LEM->LEM_ID
					EndIf

					oMODEL_V3U:=oModel535:GetModel("MODEL_V3U")
					oMODEL_V3U:LoadValue( "V3U_NUMERO", Alltrim(jRetornoT158["T158"][nX]["NUMERO"] ))
					oMODEL_V3U:LoadValue( "V3U_SERIE", Alltrim(jRetornoT158["T158"][nX]["SERIE"]))
					oMODEL_V3U:LoadValue( "V3U_CODPAR", cCodigoParticipante)
					oMODEL_V3U:LoadValue( "V3U_IDPART", cIdParticipante)
					oMODEL_V3U:LoadValue( "V3U_DTEMIS", jRetornoT158["T158"][nX]["EMISSAO"])
					oMODEL_V3U:LoadValue( "V3U_NATTIT", Alltrim(jRetornoT158["T158"][nX]["NATUREZ"]))
					oMODEL_V3U:LoadValue( "V3U_PARCEL", Alltrim(jRetornoT158["T158"][nX]["NUM_PARC"]))
					oMODEL_V3U:SetValue( "V3U_DTPAGT", jRetornoT158["T158"][nX]["DT_PGTO"])
					oMODEL_V3U:LoadValue( "V3U_SEQUEN", Alltrim(jRetornoT158["T158"][nX]["SEQUENCIAL"]))
					oMODEL_V3U:SetValue( "V3U_IDFTPC", Alltrim(cIDLEM))
					oMODEL_V3U:SetValue( "V3U_FCISCP", Alltrim(jRetornoT158["T158"][nX]["INDFCISCP"]))
					If !Empty(jRetornoT158["T158"][nX]["DTESCRCONT"])
						oMODEL_V3U:SetValue( "V3U_DTESCO", jRetornoT158["T158"][nX]["DTESCRCONT"])
					Endif
					oMODEL_V3U:SetValue( "V3U_OBSERV", Alltrim(jRetornoT158["T158"][nX]["OBSERVACAO"]))
					oMODEL_V3U:LoadValue( "V3U_PERAPU", Alltrim(jRetornoT158["T158"][nX]["PERAPUR"]))
					oMODEL_V3U:SetValue( "V3U_INTEGR",  "3")
					oMODEL_V3U:SetValue( "V3U_FILORI", (cAliasTemp)->TMP_FILORI)
					oMODEL_V3U:SetValue( "V3U_IDBAIX",  (cAliasTemp)->TMP_IDMOV)
					oMODEL_V3U:SetValue( "V3U_MOVFIN",  (cAliasTemp)->TMP_MOVFIN)

					If Valtype(jRetornoT158["T158"][nX]["T158AA"]) == "A" //Natureza de Rendimento
						oMODEL_V3V:=oModel535:GetModel("MODEL_V3V")
						nTotalSubJsonT158AA := Len(jRetornoT158["T158"][nX]["T158AA"])
						For nY:=1 to nTotalSubJsonT158AA
							cFCISCP := ""
							cIDNaturezaRendimento := Posicione("V3O",1,xFilial("V3O")+Alltrim(jRetornoT158["T158"][nX]["T158AA"][nY]["NATUREZA_RENDIMENTO"]),"ALLTRIM(V3O_ID)")
							If !Empty(jRetornoT158["T158"][nX]["T158AA"][nY]["NR_INSC_FCI_SCP"])
								cFCISCP := Posicione("V3X",2,xFilial("V3X")+Alltrim(jRetornoT158["T158"][nX]["T158AA"][nY]["NR_INSC_FCI_SCP"]),"ALLTRIM(V3X_ID)")
							EndIf
							If !oMODEL_V3V:IsEmpty()
								If !oMODEL_V3V:SeekLine( { {"V3V_CNATRE", cIDNaturezaRendimento } } )
									oMODEL_V3V:AddLine()
									oMODEL_V3V:GoLine( oMODEL_V3V:Length() )
								EndIf
							EndIf
							oMODEL_V3V:SetValue( "V3V_CNATRE", cIDNaturezaRendimento)
							oMODEL_V3V:SetValue( "V3V_VALOR", jRetornoT158["T158"][nX]["T158AA"][nY]["VLR_PGTO"])
							oMODEL_V3V:SetValue( "V3V_DECTER", Alltrim(jRetornoT158["T158"][nX]["T158AA"][nY]["IND_DEC_TERC"]))
							oMODEL_V3V:SetValue( "V3V_IFCISC", cFCISCP)
							//V3V_IDPROC RECEBE DO MODELO V4F_ID
							oMODEL_V3V:SetValue( "V3V_COMPFP", Alltrim(jRetornoT158["T158"][nX]["T158AA"][nY]["COMPFP"]))
							If Valtype(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AB"]) == "A" //Tributos do pagamento
								oMODEL_V46:=oModel535:GetModel("MODEL_V46")
								nTotalSubJsonT158AB := Len(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AB"])
								For nZ:=1 to nTotalSubJsonT158AB
									cIDTributo := Posicione("C3S",1,xFilial("C3S")+Alltrim(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AB"][nZ]["TRIBUTO"]),"ALLTRIM(C3S_ID)" )
									If !oMODEL_V46:IsEmpty()
										If !oMODEL_V46:SeekLine( { {"V46_IDTRIB", cIDTributo } } )
											oMODEL_V46:AddLine()
											oMODEL_V46:GoLine( oMODEL_V46:Length() )
										EndIf
									EndIf
									oMODEL_V46:SetValue( "V46_IDTRIB", cIDTributo)
									oMODEL_V46:SetValue( "V46_BASE", jRetornoT158["T158"][nX]["T158AA"][nY]["T158AB"][nZ]["BASE_CALCULO"])
									oMODEL_V46:SetValue( "V46_VALOR", jRetornoT158["T158"][nX]["T158AA"][nY]["T158AB"][nZ]["VLR_TRIBUTO"])
									oMODEL_V46:SetValue( "V46_ALIQ", jRetornoT158["T158"][nX]["T158AA"][nY]["T158AB"][nZ]["ALIQUOTA"])

									If Valtype(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AB"][nZ]["T158AD"]) == "A"//Detalhamento das deduções
										oModel_V4I:=oModel535:GetModel("MODEL_V4I")
										nTotalSubJsonT158AD := Len(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AB"][nZ]["T158AD"])
										For nA:=1 to nTotalSubJsonT158AD
											If !oModel_V4I:IsEmpty()
												If !oModel_V4I:SeekLine( { {"V4I_TPDEDU", Alltrim(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AB"][nZ]["T158AD"][nA]["TIPO_DEDUCAO"])} } )
													oModel_V4I:AddLine()
													oModel_V4I:GoLine( oModel_V4I:Length() )
												EndIf
											EndIf
											oModel_V4I:SetValue( "V4I_TPDEDU", Alltrim(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AB"][nZ]["T158AD"][nA]["TIPO_DEDUCAO"]))
											oModel_V4I:SetValue( "V4I_VLRDED", jRetornoT158["T158"][nX]["T158AA"][nY]["T158AB"][nZ]["T158AD"][nA]["VAL_DEDUCAO"])
											oModel_V4I:SetValue( "V4I_VLDEDS", jRetornoT158["T158"][nX]["T158AA"][nY]["T158AB"][nZ]["T158AD"][nA]["VAL_DEDUCAO_SUSP"])
											oModel_V4I:SetValue( "V4I_NUMPRE", Alltrim(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AB"][nZ]["T158AD"][nA]["NUM_PREVIDENCIA"]))
											oModel_V4I:SetValue( "V4I_IENTID", Alltrim(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AB"][nZ]["T158AD"][nA]["INFO_ENTIDADE"]))
											oModel_V4I:SetValue( "V4I_VLFPRE", jRetornoT158["T158"][nX]["T158AA"][nY]["T158AB"][nZ]["T158AD"][nA]["VLR_PATROC_FUNPRESP"])
											If Valtype(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AB"][nZ]["T158AD"][nA]["T158AF"]) == "A" //Beneficiários da Pensão Alimentícia
												oModel_V85:=oModel535:GetModel("MODEL_V85")
												nTotalSubJsonT158AF := Len(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AB"][nZ]["T158AD"][nA]["T158AF"])
												For nB:=1 to nTotalSubJsonT158AF
													cCodigoDependente:=Posicione("V3R",3,xFilial("V3R")+Alltrim(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AB"][nZ]["T158AD"][nA]["T158AF"][nB]["CPF"]),"ALLTRIM(V3R_CODIGO)")
													If !oModel_V85:IsEmpty()
														If !oModel_V85:SeekLine( { {"V85_CODDEP", cCodigoDependente} } )
															oModel_V85:AddLine()
															oModel_V85:GoLine( oModel_V85:Length() )
														EndIf
													EndIf
													oModel_V85:SetValue( "V85_CPFDEP", Alltrim(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AB"][nZ]["T158AD"][nA]["T158AF"][nB]["CPF"]))
													oModel_V85:SetValue( "V85_CODDEP", cCodigoDependente)
													oModel_V85:SetValue( "V85_VALDED", jRetornoT158["T158"][nX]["T158AA"][nY]["T158AB"][nZ]["T158AD"][nA]["T158AF"][nB]["VAL_DEDUCAO"])
												Next nB
											EndIf
										Next nA
									EndIf
									If Valtype(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AB"][nZ]["T158AE"]) == "A" //Detalhamento das isenções
										oModel_V4J:=oModel535:GetModel("MODEL_V4J")
										nTotalSubJsonT158AE := Len(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AB"][nZ]["T158AE"])
										For nA:=1 to nTotalSubJsonT158AE
											cTipoIsencao :=  Posicione("V4E",2,xFilial("V4E")+Alltrim(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AB"][nZ]["T158AE"][nA]["TIPO_ISENCAO"]),"ALLTRIM(V4E_ID)")
											If !oModel_V4J:IsEmpty()
												If !oModel_V4J:SeekLine( { {"V4J_IDTPIS", cTipoIsencao} } )
													oModel_V4J:AddLine()
													oModel_V4J:GoLine( oModel_V4J:Length() )
												EndIf
											EndIf
											oModel_V4J:SetValue( "V4J_IDTPIS", cTipoIsencao)
											oModel_V4J:SetValue( "V4J_CDTPIS", Posicione("V4E",1,XFILIAL("V4E")+cTipoIsencao,"V4E_CODIGO"))
											oModel_V4J:SetValue( "V4J_VLRISE", jRetornoT158["T158"][nX]["T158AA"][nY]["T158AB"][nZ]["T158AE"][nA]["VAL_ISENTO"])
											oModel_V4J:SetValue( "V4J_DRENDI", Alltrim(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AB"][nZ]["T158AE"][nA]["DESC_RENDIMENTO"]))
										Next nA
									EndIf

								Next nZ
							EndIf

							If Valtype(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AC"]) == "A" //Suspensão de exigibilidade de tributo
								oModel_V4H:=oModel535:GetModel("MODEL_V4H")
								nTotalSubJsonT158AC := Len(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AC"])
								For nZ:=1 to nTotalSubJsonT158AC
									cNumeroProcesso := Alltrim(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AC"][nZ]["NUM_PROC"])
									cIdProcesso := Posicione("C1G",1,xFilial("C1G")+cNumeroProcesso,"ALLTRIM(C1G_ID)" )
									cIdSuspensao := Posicione("T5L",2,xFilial("T5L")+ Alltrim(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AC"][nZ]["COD_SUS"]),"ALLTRIM(T5L_ID)" )
									cVersaoSuspensao := Posicione("T5L",2,xFilial("T5L")+ jRetornoT158["T158"][nX]["T158AA"][nY]["T158AC"][nZ]["COD_SUS"],"T5L_VERSAO")
									cIDTributo := Posicione("C3S",1,xFilial("C3S")+Alltrim(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AC"][nZ]["COD_TRIB"]),"ALLTRIM(C3S_ID)" )
									cCodigoSuspensao := cIdSuspensao +PadR(cVersaoSuspensao,iVersao)+jRetornoT158["T158"][nX]["T158AA"][nY]["T158AC"][nZ]["COD_SUS"]
									If !oModel_V4H:IsEmpty()
										If!oModel_V4H:SeekLine( { {"V4H_IDPROC", cIdProcesso}, {"V4H_IDSUSP", cCodigoSuspensao}, {"V4H_IDTRIB", cIDTributo}} )
											oModel_V4H:AddLine()
											oModel_V4H:GoLine( oModel_V4H:Length() )
										EndIf
									EndIf
									oModel_V4H:SetValue( "V4H_IDPROC",  cIdProcesso)
									oModel_V4H:SetValue( "V4H_IDSUSP",  cCodigoSuspensao)
									oModel_V4H:SetValue( "V4H_IDTRIB",  cIDTributo )
									oModel_V4H:SetValue( "V4H_VALSUS",  jRetornoT158["T158"][nX]["T158AA"][nY]["T158AC"][nZ]["VAL_SUS"])
									oModel_V4H:SetValue( "V4H_VBASSU",  jRetornoT158["T158"][nX]["T158AA"][nY]["T158AC"][nZ]["BASE_SUSPENSA"])
									oModel_V4H:SetValue( "V4H_VLRANO",  jRetornoT158["T158"][nX]["T158AA"][nY]["T158AC"][nZ]["VLR_COMP_ANO_CALENDARIO"])
									oModel_V4H:SetValue( "V4H_VLRANA",  jRetornoT158["T158"][nX]["T158AA"][nY]["T158AC"][nZ]["VLR_COMP_ANO_ANT"])
									If Valtype(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AC"][nZ]["T158AG"]) == "A" //Detalhamento das deduções com exigibilidade suspensa.
										oModel_V90:=oModel535:GetModel("MODEL_V90")
										nTotalSubJsonT158AG := Len(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AC"][nZ]["T158AG"])
										For nA:=1 to nTotalSubJsonT158AG
											If !oModel_V90:IsEmpty()
												If !oModel_V90:SeekLine( { {"V90_TPDEDU", Alltrim(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AC"][nZ]["T158AG"][nA]["IND_TP_DEDUCAO"])} } )
													oModel_V90:AddLine()
													oModel_V90:GoLine( oModel_V90:Length() )
												EndIf
											EndIf
											oModel_V90:SetValue( "V90_TPDEDU", Alltrim(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AC"][nZ]["T158AG"][nA]["IND_TP_DEDUCAO"]))
											oModel_V90:SetValue( "V90_VALDED", jRetornoT158["T158"][nX]["T158AA"][nY]["T158AC"][nZ]["T158AG"][nA]["VAL_DEDUCAO"])
											If Valtype(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AC"][nZ]["T158AG"][nA]["T158AH"]) == "A" //Informação das deduções suspensas por dependentes e beneficiários da pensão alimentícia.
												oModel_V95:=oModel535:GetModel("MODEL_V95")
												nTotalSubJsonT158AH := Len(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AC"][nZ]["T158AG"][nA]["T158AH"])
												For nB:=1 to nTotalSubJsonT158AH
													cCodigoDependente:=Posicione("V3R",3,xFilial("V3R")+Alltrim(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AC"][nZ]["T158AG"][nA]["T158AH"][nB]["CPF"]),"ALLTRIM(V3R_CODIGO)")
													oModel_V90:SeekLine( { {"V90_TPDEDU", Alltrim(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AC"][nZ]["T158AG"][nA]["T158AH"][nB]["IND_TP_DEDUCAO"])} } )
													If !oModel_V95:IsEmpty()
														If !oModel_V95:SeekLine( { {"V95_CODDEP", cCodigoDependente} } )
															oModel_V95:AddLine()
															oModel_V95:GoLine( oModel_V95:Length() )
														EndIf
													EndIf
													oModel_V95:SetValue( "V95_CPF", Alltrim(jRetornoT158["T158"][nX]["T158AA"][nY]["T158AC"][nZ]["T158AG"][nA]["T158AH"][nB]["CPF"]))
													oModel_V95:SetValue( "V95_CODDEP", cCodigoDependente)
													oModel_V95:SetValue( "V95_VDEDSU", jRetornoT158["T158"][nX]["T158AA"][nY]["T158AC"][nZ]["T158AG"][nA]["T158AH"][nB]["VAL_DEDUCAO_SUSPENSO"])
												Next nB
											EndIf
										Next nA
									EndIf
								Next nZ
							EndIf	
						Next nY
					EndIf
					If oModel535:VldData()
						lGravadados:= oModel535:CommitData()
					Else
						lGravadados := .F.
						cLog := cValToChar(oModel535:GetErrorMessage()[4]) + ' - '
						cLog += cValToChar(oModel535:GetErrorMessage()[5]) + ' - '
						cLog += cValToChar(oModel535:GetErrorMessage()[6])
						aDadosLog := {(cAliasTemp)->TMP_MOVORI, (cAliasTemp)->TMP_ID, FwX2Nome('V3U'), cLog, .T., '' }
						TAFConout(cLog,,, STR0002)
					Endif
				EndIf //lContinua
			EndIf
		Next nX
	EndIf


Return lGravadados
