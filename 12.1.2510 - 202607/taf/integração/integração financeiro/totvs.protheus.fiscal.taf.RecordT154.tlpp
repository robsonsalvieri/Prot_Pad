#INCLUDE "TLPP-CORE.TH"
#INCLUDE "PROTHEUS.CH"
#INCLUDE "TAFXFIN.CH"
#INCLUDE "FWMVCDEF.CH"

namespace totvs.protheus.fiscal.taf.financialintegration

Static __oQueryC20 as Object

/*/{Protheus.doc} GravaT154
@type			Function
@description	Função para complementar a tabela LEM, com os dados dos registros T154
@author			Pâmela Bernardo
@since			17/03/2025
@version		1.0
/*/
Function GravaT154(jRetornoT154 as json, aDadosLog as array, cAliasTemp as character) as logical

	Local lGravadados 	:= .T. as Logical
	Local lContinua 		:= .T. as Logical
	Local nTotalJson  	:= 0 as Numeric
	Local nTotalSubJsonT154AA := 0 as Numeric
	Local nTotalSubJsonT154AB := 0 as Numeric
	Local nTotalSubJsonT154AC := 0 as Numeric
	Local nTotalSubJsonT154AF := 0 as Numeric
	Local nTotalSubJsonT154AG := 0 as Numeric
	Local nTotalSubJsonT154AH := 0 as Numeric
	Local nTotalSubJsonT154AI := 0 as Numeric
	Local nTotalSubJsonT154AJ := 0 as Numeric
	Local nTotalSubJsonT154AK := 0 as Numeric
	Local nTotalSubJsonT154AL := 0 as Numeric
	Local nTotalSubJsonT154AM := 0 as Numeric
	Local nX  		  	:= 0 as Numeric
	Local nY  		  	:= 0 as Numeric
	Local nz  		  	:= 0 as Numeric
	Local nA  		  	:= 0 as Numeric
	Local nB  		  	:= 0 as Numeric
	Local nOperacao	  	:= MODEL_OPERATION_UPDATE as Numeric
	Local cLog			:= "" as character
	Local cTipoServico	:= "" as character
	Local cIdProcesso	:= "" as character
	Local cCodigoParticipante:= "" as character
	Local cIdParticipante	 := "" as character
	Local cNumeroProcesso	 := "" as character
	Local cIdSuspensao		 := "" as character
	Local cVersaoSuspensao	 := "" as character
	Local cCodigoSuspensao 	 := "" as character
	Local cCodigoDependente	 := "" as character
	Local cTipoIsencao		 := "" as character
	Local cIDNaturezaRendimento := "" as character
	Local cIDTributo 		:= "" as character
	Local cFCISCP 			:= "" as character
	Local oModel448		as object
	Local oMODEL_LEM 	as object
	Local oMODEL_T5M	as object
	Local oMODEL_T51 	as object
	Local oMODEL_T5P 	as object
	Local oMODEL_T9E 	as object
	Local oMODEL_V3S 	as object
	Local oMODEL_V47 	as object
	Local oMODEL_V83 	as object
	Local oMODEL_V89 	as object
	Local oMODEL_V4M 	as object
	Local oMODEL_V96 	as object
	Local oModel_V4L 	as object
	Local iPrefixo	 := GetSX3Cache("LEM_PREFIX"	, "X3_TAMANHO") as integer
	Local iNumero	 := GetSX3Cache("LEM_NUMERO"	, "X3_TAMANHO") as integer
	Local iVersao	 := GetSX3Cache("C1G_VERSAO"	, "X3_TAMANHO") as integer
	Local cChaveNF	 := "" as character
	Local nTamT5MDESCRI := TamSX3( "T5M_DESCRI" )[1] as numeric

	If Valtype(jRetornoT154) == "J" .And. Valtype(jRetornoT154["T154"]) == "A"
	
		nTotalJson := Len(jRetornoT154["T154"])
		For nX:=1 to nTotalJson
			If lGravadados
				V14->(DbSetOrder(5))
				If V14->(DbSeek(xFilial("V14")+jRetornoT154["T154"][nX]["COD_PARTICIPANTE"]))
					cCodigoParticipante := V14->V14_CODPAR
					cIdParticipante:= V14->V14_IDC1H
				EndIf
				cChaveNF := Buscachavenotafiscal(jRetornoT154["T154"][nX]["NUM_DOC"], jRetornoT154["T154"][nX]["SER_DOC"], jRetornoT154["T154"][nX]["CODMOD_DOC"],;
									 cIdParticipante, jRetornoT154["T154"][nX]["NATUREZ"],(cAliasTemp)->TMP_FILORI)
				If (cAliasTemp)->TMP_INTEGR == "1"
					If nX > 1
						nOperacao :=  MODEL_OPERATION_INSERT
						lContinua := .T.
					Else
						nOperacao :=  MODEL_OPERATION_UPDATE
						LEM->(dbSetOrder(1))//LEM_FILIAL+LEM_ID
						lContinua:= LEM->(DbSeek(xFilial("LEM")+(cAliasTemp)->TMP_ID))
					EndIf
				Else
					LEM->(dbSetOrder(2))//LEM_FILIAL+LEM_PREFIX+LEM_NUMERO+LEM_IDPART+DTOS(LEM_DTEMIS)
					lContinua:= LEM->(DbSeek(xFilial("LEM")+PadR(jRetornoT154["T154"][nX]["SERIE"],iPrefixo)+;
						   PadR(jRetornoT154["T154"][nX]["NUMERO"],iNumero)+cIdParticipante))
					If !lContinua
						LEM->(dbSetOrder(1))//LEM_FILIAL+LEM_ID
						lContinua:= LEM->(DbSeek(xFilial("LEM")+(cAliasTemp)->TMP_ID))
					EndIf
					nOperacao :=  MODEL_OPERATION_UPDATE
				EndIf
				If lContinua
					oModel448:= FWLoadModel("TAFA448")
					oModel448:SetOperation( nOperacao ) //Alteração
					oModel448:Activate()

					oModel_LEM:=oModel448:GetModel("MODEL_LEM")
					oModel_LEM:SetValue( "LEM_NUMERO", Alltrim(jRetornoT154["T154"][nX]["NUMERO"] ))
					oModel_LEM:SetValue( "LEM_PREFIX", Alltrim(jRetornoT154["T154"][nX]["SERIE"]))
					oModel_LEM:SetValue( "LEM_IDPART", Alltrim(cIdParticipante) )
					oModel_LEM:SetValue( "LEM_PARTIC", Alltrim(cCodigoParticipante))
					oModel_LEM:SetValue( "LEM_DTEMIS", jRetornoT154["T154"][nX]["EMISSAO"])
					oModel_LEM:SetValue( "LEM_NATTIT", Alltrim(jRetornoT154["T154"][nX]["NATUREZ"]))
					oModel_LEM:SetValue( "LEM_OBSERV", Alltrim(jRetornoT154["T154"][nX]["OBSERVACAO"]))
					oModel_LEM:SetValue( "LEM_VLBRUT", jRetornoT154["T154"][nX]["VLR_BRUTO"])
					oModel_LEM:SetValue( "LEM_TPRECF", Alltrim(jRetornoT154["T154"][nX]["TIPO_RECIBO_FATURA"]))
					oModel_LEM:SetValue( "LEM_SRVMUN", Alltrim(jRetornoT154["T154"][nX]["COD_SERV_MUN"]))
					oModel_LEM:SetValue( "LEM_CODLOC", Alltrim(jRetornoT154["T154"][nX]["LOC_PRESTACAO"]))
					oModel_LEM:SetValue( "LEM_TIPDOC", Alltrim(jRetornoT154["T154"][nX]["TIPDOC"]))
					If !Empty(Alltrim(jRetornoT154["T154"][nX]["NR_INSC_ESTAB"]))
						oModel_LEM:SetValue( "LEM_IDOBRA", Posicione("T9C",2,xFilial("T9C")+Alltrim(jRetornoT154["T154"][nX]["NR_INSC_ESTAB"]),"ALLTRIM(T9C_ID)")) //T9C 
					EndIf
					oModel_LEM:SetValue( "LEM_UNQINT", Alltrim(jRetornoT154["T154"][nX]["UNQ_INT"]))
					oModel_LEM:SetValue( "LEM_INDISE", Alltrim(jRetornoT154["T154"][nX]["INDISE"]))
					oModel_LEM:SetValue( "LEM_VLRCP ", jRetornoT154["T154"][nX]["VLRCP"])
					oModel_LEM:SetValue( "LEM_VLRGIL", jRetornoT154["T154"][nX]["VLRGIL"])
					oModel_LEM:SetValue( "LEM_VLRSEN", jRetornoT154["T154"][nX]["VLRSEN"])
					oModel_LEM:SetValue( "LEM_INDJUD", jRetornoT154["T154"][nX]["INDJUD"])
					oModel_LEM:SetValue( "LEM_FCISCP", Alltrim(jRetornoT154["T154"][nX]["INDFCISCP"]))
					oModel_LEM:SetValue( "LEM_DTESCO", jRetornoT154["T154"][nX]["DTESCRCONT"])
					oModel_LEM:SetValue( "LEM_DTCONT", jRetornoT154["T154"][nX]["DT_CONTABIL"])
					oModel_LEM:SetValue( "LEM_INTEGR",  "5")
					oModel_LEM:SetValue( "LEM_IDDOC",  (cAliasTemp)->TMP_IDMOV)
					oModel_LEM:SetValue( "LEM_MOVFIN",  (cAliasTemp)->TMP_MOVFIN)
					If !Empty(Alltrim(cChaveNF))
						oModel_LEM:SetValue( "LEM_DOCORI", Alltrim(cChaveNF))
					EndIf
					oModel_LEM:SetValue( "LEM_FILORI", (cAliasTemp)->TMP_FILORI)
					
					If Valtype(jRetornoT154["T154"][nX]["T154AA"]) == "A"
						oModel_T5M:=oModel448:GetModel("MODEL_T5M")
						nTotalSubJsonT154AA := Len(jRetornoT154["T154"][nX]["T154AA"])
						If nOperacao ==  MODEL_OPERATION_UPDATE
							If !oModel_T5M:IsEmpty()
								For nY:=1 to oModel_T5M:Length()
									oModel_T5M:GoLine( nY )
									oModel_T5M:DeleteLine()
								Next
							EndIf
						EndIf
						For nY:=1 to nTotalSubJsonT154AA
							cTipoServico := Posicione("C8C",4,xFilial("C8C")+Alltrim(jRetornoT154["T154"][nX]["T154AA"][nY]["TIP_SERV"]),"ALLTRIM(C8C_ID)" )
							If !oModel_T5M:IsEmpty()
								If !oModel_T5M:SeekLine( { {"T5M_IDTSER", cTipoServico } } )
									oModel_T5M:AddLine()
									oModel_T5M:GoLine( oModel_T5M:Length() )
								EndIf
							EndIf
							oModel_T5M:SetValue( "T5M_IDTSER", cTipoServico)
							oModel_T5M:SetValue( "T5M_BSINSS", jRetornoT154["T154"][nX]["T154AA"][nY]["VLR_BASE_CALCULO_INSS"])
							oModel_T5M:SetValue( "T5M_VLINSS", jRetornoT154["T154"][nX]["T154AA"][nY]["VALOR_TRIBUTO_INSS"])
							oModel_T5M:SetValue( "T5M_VLRETS", jRetornoT154["T154"][nX]["T154AA"][nY]["VLR_RET_SERV_SUBCONTRAT_INSS"])
							oModel_T5M:SetValue( "T5M_VLRETP", jRetornoT154["T154"][nX]["T154AA"][nY]["VLR_RET_PRIN_N_EFET_INSS"])
							oModel_T5M:SetValue( "T5M_VLSV15", jRetornoT154["T154"][nX]["T154AA"][nY]["VLR_SER_15_ANOS"])
							oModel_T5M:SetValue( "T5M_VLSV20", jRetornoT154["T154"][nX]["T154AA"][nY]["VLR_SER_20_ANOS"])
							oModel_T5M:SetValue( "T5M_VLSV25", jRetornoT154["T154"][nX]["T154AA"][nY]["VLR_SER_25_ANOSS"])
							If jRetornoT154["T154"][nX]["T154AA"][nY]["VLR_ADICIONAL"] > 0
								oModel_T5M:SetValue( "T5M_VLADIC",jRetornoT154["T154"][nX]["T154AA"][nY]["VLR_ADICIONAL"])
							EndIf
							oModel_T5M:SetValue( "T5M_VLADNE", jRetornoT154["T154"][nX]["T154AA"][nY]["VLR_RET_ADV_N_EFET_INSS"])
							oModel_T5M:SetValue( "T5M_TPREPA", Alltrim(jRetornoT154["T154"][nX]["T154AA"][nY]["TPREPASSE"]))
							oModel_T5M:SetValue( "T5M_DESCRI", Alltrim(Substr(jRetornoT154["T154"][nX]["T154AA"][nY]["DESCRECURSO"],1,nTamT5MDESCRI)))
							oModel_T5M:SetValue( "T5M_VLBRUT", jRetornoT154["T154"][nX]["T154AA"][nY]["VLRBRUTO"])
							oModel_T5M:SetValue( "T5M_VLREAP", jRetornoT154["T154"][nX]["T154AA"][nY]["VLRRETAPUR"])
						Next nY
					EndIf
					If Valtype(jRetornoT154["T154"][nX]["T154AB"]) == "A"
						oModel_T51:=oModel448:GetModel("MODEL_T51")
						nTotalSubJsonT154AB := Len(jRetornoT154["T154"][nX]["T154AB"])
						For nY:=1 to nTotalSubJsonT154AB
							If !oModel_T51:IsEmpty()
								If !oModel_T51:SeekLine( { {"T51_NUMPAR", Alltrim(jRetornoT154["T154"][nX]["T154AB"][nY]["NUM_PARC"]) } } )
									oModel_T51:AddLine()
									oModel_T51:GoLine( oModel_T51:Length() )
								EndIf
							EndIf
							oModel_T51:SetValue( "T51_NUMPAR", Alltrim(jRetornoT154["T154"][nX]["T154AB"][nY]["NUM_PARC"]))
							oModel_T51:SetValue( "T51_VLRPAR", jRetornoT154["T154"][nX]["T154AB"][nY]["VLR_PARC"])

							If Valtype(jRetornoT154["T154"][nX]["T154AB"][nY]["T154AC"]) == "A"
								oModel_T5P:=oModel448:GetModel("MODEL_T5P")
								nTotalSubJsonT154AC := Len(jRetornoT154["T154"][nX]["T154AB"][nY]["T154AC"])
								For nz:=1 to nTotalSubJsonT154AC
									If !oModel_T5P:IsEmpty()
										If !oModel_T5P:SeekLine( {{"T5P_DTPGTO", jRetornoT154["T154"][nX]["T154AB"][nY]["T154AC"][nz]["DATA_DA_BAIXA"] } } )
											oModel_T5P:AddLine()
											oModel_T5P:GoLine( oModel_T5P:Length() )
										EndIf
									EndIf
									oModel_T5P:SetValue( "T5P_DTPGTO", jRetornoT154["T154"][nX]["T154AB"][nY]["T154AC"][nz]["DATA_DA_BAIXA"])
									oModel_T5P:SetValue( "T5P_VLPGTO", jRetornoT154["T154"][nX]["T154AB"][nY]["T154AC"][nz]["VALOR_DA_BAIXA"])
								Next nY
							EndIf
						Next nY
					EndIf
					If Valtype(jRetornoT154["T154"][nX]["T154AF"]) == "A" //Indicativo de Suspensão para os processos Administrativos e Judiciais - T9E
						oModel_T9E:=oModel448:GetModel("MODEL_T9E")
						oModel_T9E:GetStruct():SetProperty("T9E_BSSUSP",MODEL_FIELD_OBRIGAT,.F.)
						nTotalSubJsonT154AF := Len(jRetornoT154["T154"][nX]["T154AF"])
						For nY:=1 to nTotalSubJsonT154AF
							cIdSuspensao := Posicione("T5L",2,xFilial("T5L")+Alltrim(jRetornoT154["T154"][nX]["T154AF"][nY]["COD_SUS"]),"ALLTRIM(T5L_ID)" )
							cNumeroProcesso := Alltrim(jRetornoT154["T154"][nX]["T154AF"][nY]["NUM_PROC"])
							cVersaoSuspensao := Posicione("T5L",2,xFilial("T5L")+ jRetornoT154["T154"][nX]["T154AF"][nY]["COD_SUS"],"ALLTRIM(T5L_VERSAO)" )
							cCodigoSuspensao := cIdSuspensao +PadR(cVersaoSuspensao,iVersao)+jRetornoT154["T154"][nX]["T154AF"][nY]["COD_SUS"]
							cIdProcesso := Posicione("C1G",1,xFilial("C1G")+cNumeroProcesso,"ALLTRIM(C1G_ID)" )
							cIDNaturezaRendimento := Posicione("V3O",1,xFilial("V3O")+Alltrim(jRetornoT154["T154"][nX]["T154AF"][nY]["NATUREZA_RENDIMENTO"]),"ALLTRIM(V3O_ID)")
							cIDTributo := Posicione("C3S",1,xFilial("C3S")+Alltrim(jRetornoT154["T154"][nX]["T154AF"][nY]["COD_TRIB"]),"ALLTRIM(C3S_ID)" )

							oModel_T9E:SetValue( "T9E_TPPROC",  Alltrim(jRetornoT154["T154"][nX]["T154AF"][nY]["TP_PROC"]))
							oModel_T9E:SetValue( "T9E_IDSUSP",  cCodigoSuspensao)
							oModel_T9E:SetValue( "T9E_VALSUS",  jRetornoT154["T154"][nX]["T154AF"][nY]["VAL_SUS"])
							oModel_T9E:SetValue( "T9E_CODTRI",  cIDTributo)
							oModel_T9E:SetValue( "T9E_CNATRE",  cIDNaturezaRendimento)
							oModel_T9E:SetValue( "T9E_BSSUSP",  jRetornoT154["T154"][nX]["T154AF"][nY]["BASE_SUSPENSA"])
							oModel_T9E:SetValue( "T9E_VLRANO",  jRetornoT154["T154"][nX]["T154AF"][nY]["VLR_COMP_ANO_CALENDARIO"])
							oModel_T9E:SetValue( "T9E_VLRANA",  jRetornoT154["T154"][nX]["T154AF"][nY]["VLR_COMP_ANO_ANT"])
							oModel_T9E:SetValue( "T9E_NUMPRO",  cIdProcesso)

							If Valtype(jRetornoT154["T154"][nX]["T154AF"][nY]["T154AL"]) == "A" //Detalhamento das deduções com exigibilidade suspensa. - V89
								oModel_V89:=oModel448:GetModel("MODEL_V89")
								nTotalSubJsonT154AL := Len(jRetornoT154["T154"][nX]["T154AF"][nY]["T154AL"])
								For nA:=1 to nTotalSubJsonT154AL
									If !oModel_V89:IsEmpty()
										If !oModel_V89:SeekLine( { {"V89_TPDEDU", Alltrim(jRetornoT154["T154"][nX]["T154AF"][nY]["T154AL"][nA]["IND_TP_DEDUCAO"])} } )
											oModel_V89:AddLine()
											oModel_V89:GoLine( oModel_V89:Length() )
										EndIf
									EndIf
									oModel_V89:SetValue( "V89_TPDEDU", Alltrim(jRetornoT154["T154"][nX]["T154AF"][nY]["T154AL"][nA]["IND_TP_DEDUCAO"]))
									oModel_V89:SetValue( "V89_VALDED", jRetornoT154["T154"][nX]["T154AF"][nY]["T154AL"][nA]["VAL_DEDUCAO"])

									If Valtype(jRetornoT154["T154"][nX]["T154AF"][nY]["T154AL"][nA]["T154AM"]) == "A" //Informação das deduções suspensas por dependentes e beneficiários da pensão alimentícia. - V96
										oModel_V96:=oModel448:GetModel("MODEL_V96")
										nTotalSubJsonT154AM := Len(jRetornoT154["T154"][nX]["T154AF"][nY]["T154AL"][nA]["T154AM"])
										For nB:=1 to nTotalSubJsonT154AM
											cCodigoDependente:=Posicione("V3R",3,xFilial("V3R")+Alltrim(jRetornoT154["T154"][nX]["T154AF"][nY]["T154AL"][nA]["T154AM"][nB]["CPF"]),"ALLTRIM(V3R_CODIGO)")
											If !oModel_V96:IsEmpty()
												If !oModel_V96:SeekLine( { {"V96_CPF", Alltrim(jRetornoT154["T154"][nX]["T154AF"][nY]["T154AL"][nA]["T154AM"][nB]["CPF"])} } )
													oModel_V96:AddLine()
													oModel_V96:GoLine( oModel_V96:Length() )
												EndIf
											EndIf
											oModel_V96:SetValue( "V96_CPF", Alltrim(jRetornoT154["T154"][nX]["T154AF"][nY]["T154AL"][nA]["T154AM"][nB]["CPF"]))
											oModel_V96:SetValue( "V96_CODDEP", cCodigoDependente)
											oModel_V96:SetValue( "V96_VDEDSU", jRetornoT154["T154"][nX]["T154AF"][nY]["T154AL"][nA]["T154AM"][nB]["VAL_DEDUCAO_SUSPENSO"])
										Next nB
									EndIf
								Next nA	
							EndIf
						Next nY
					EndIf
					If Valtype(jRetornoT154["T154"][nX]["T154AG"]) == "A"//Natureza de Rendimento - V3S
						oModel_V3S:=oModel448:GetModel("MODEL_V3S")
						nTotalSubJsonT154AG := Len(jRetornoT154["T154"][nX]["T154AG"])
						If nOperacao ==  MODEL_OPERATION_UPDATE
							If !oModel_V3S:IsEmpty()
								For nY:=1 to oModel_V3S:Length()
									oModel_V3S:GoLine( nY )
									oModel_V3S:DeleteLine()
								Next
							EndIf
						EndIf
						For nY:=1 to nTotalSubJsonT154AG
							cFCISCP:= ""
							cIDNaturezaRendimento := Posicione("V3O",1,xFilial("V3O")+Alltrim(jRetornoT154["T154"][nX]["T154AG"][nY]["NATUREZA_RENDIMENTO"]),"ALLTRIM(V3O_ID)")
							If !Empty(Alltrim(jRetornoT154["T154"][nX]["T154AG"][nY]["NR_INSC_FCI_SCP"]))
								cFCISCP := Posicione("V3X",2,xFilial("V3X")+Alltrim(jRetornoT154["T154"][nX]["T154AG"][nY]["NR_INSC_FCI_SCP"]),"ALLTRIM(V3X_ID)")
							EndIf
							If !oModel_V3S:IsEmpty()
								If !oModel_V3S:SeekLine( { {"V3S_IDNATR", cIDNaturezaRendimento} } )
									oModel_V3S:AddLine()
									oModel_V3S:GoLine( oModel_V3S:Length() )
								EndIf
							EndIf
							oModel_V3S:SetValue( "V3S_IDNATR", cIDNaturezaRendimento)
							oModel_V3S:SetValue( "V3S_DECTER", Alltrim(jRetornoT154["T154"][nX]["T154AG"][nY]["IND_DEC_TERC"]))
							oModel_V3S:SetValue( "V3S_VALOR",  jRetornoT154["T154"][nX]["T154AG"][nY]["VLR_PGTO"])
							oModel_V3S:SetValue( "V3S_IFCISC", cFCISCP)
							oModel_V3S:SetValue( "V3S_IDPROC", Alltrim(jRetornoT154["T154"][nX]["T154AG"][nY]["NRPROC"]))
							oModel_V3S:SetValue( "V3S_COMPFP", Alltrim(jRetornoT154["T154"][nX]["T154AG"][nY]["COMPFP"]))
							If Valtype(jRetornoT154["T154"][nX]["T154AG"][ny]["T154AH"]) == "A" //Tributos do pagamento - V47
								oModel_V47:=oModel448:GetModel("MODEL_V47")
								nTotalSubJsonT154AH := Len(jRetornoT154["T154"][nX]["T154AG"][ny]["T154AH"])
								For nz:=1 to nTotalSubJsonT154AH
									cIDTributo := Posicione("C3S",1,xFilial("C3S")+Alltrim(jRetornoT154["T154"][nX]["T154AG"][ny]["T154AH"][nz]["TRIBUTO"]),"ALLTRIM(C3S_ID)" )
									oModel_V47:SetValue( "V47_IDNATR", cIDNaturezaRendimento)
									oModel_V47:SetValue( "V47_IDTRIB", cIDTributo)
									oModel_V47:SetValue( "V47_BASECA", jRetornoT154["T154"][nX]["T154AG"][ny]["T154AH"][nz]["BASE_CALCULO"])
									oModel_V47:SetValue( "V47_VLTRIB", jRetornoT154["T154"][nX]["T154AG"][ny]["T154AH"][nz]["VLR_TRIBUTO"])
									oModel_V47:SetValue( "V47_ALIQ",   jRetornoT154["T154"][nX]["T154AG"][ny]["T154AH"][nz]["ALIQUOTA"])
									If Valtype(jRetornoT154["T154"][nX]["T154AG"][ny]["T154AH"][nz]["T154AI"]) == "A" //Detalhamento das deduções - V4L
										oModel_V4L:=oModel448:GetModel("MODEL_V4L")
										nTotalSubJsonT154AI := Len(jRetornoT154["T154"][nX]["T154AG"][ny]["T154AH"][nz]["T154AI"])
										For nA:=1 to nTotalSubJsonT154AI
											If !oModel_V4L:IsEmpty()
												If !oModel_V4L:SeekLine({{"V4L_TPDEDU", Alltrim(jRetornoT154["T154"][nX]["T154AG"][nY]["T154AH"][nz]["T154AI"][nA]["TIPO_DEDUCAO"])} } )
													oModel_V4L:AddLine()
													oModel_V4L:GoLine( oModel_V4L:Length() )
												EndIf
											EndIf
											oModel_V4L:SetValue( "V4L_TPDEDU", Alltrim(jRetornoT154["T154"][nX]["T154AG"][ny]["T154AH"][nz]["T154AI"][nA]["TIPO_DEDUCAO"]))
											oModel_V4L:SetValue( "V4L_VLRDED", jRetornoT154["T154"][nX]["T154AG"][ny]["T154AH"][nz]["T154AI"][nA]["VAL_DEDUCAO"])
											oModel_V4L:SetValue( "V4L_VLDEDS", jRetornoT154["T154"][nX]["T154AG"][ny]["T154AH"][nz]["T154AI"][nA]["VAL_DEDUCAO_SUSP"])
											oModel_V4L:SetValue( "V4L_NUMPRE", Alltrim(jRetornoT154["T154"][nX]["T154AG"][ny]["T154AH"][nz]["T154AI"][nA]["NUM_PREVIDENCIA"]))
											oModel_V4L:SetValue( "V4L_IENTID", Alltrim(jRetornoT154["T154"][nX]["T154AG"][ny]["T154AH"][nz]["T154AI"][nA]["INFO_ENTIDADE"]))
											oModel_V4L:SetValue( "V4L_VLFPRE", jRetornoT154["T154"][nX]["T154AG"][ny]["T154AH"][nz]["T154AI"][nA]["VLR_PATROC_FUNPRESP"])

											If Valtype(jRetornoT154["T154"][nX]["T154AG"][ny]["T154AH"][nz]["T154AI"][nA]["T154AK"]) == "A" //Beneficiários da Pensão Alimentícia - V83
												oModel_V83:=oModel448:GetModel("MODEL_V83")
												nTotalSubJsonT154AK := Len(jRetornoT154["T154"][nX]["T154AG"][ny]["T154AH"][nz]["T154AI"][nA]["T154AK"])
												For nB:=1 to nTotalSubJsonT154AK
													cCodigoDependente:=Posicione("V3R",3,xFilial("V3R")+Alltrim(jRetornoT154["T154"][nX]["T154AG"][ny]["T154AH"][nz]["T154AI"][nA]["T154AK"][nB]["CPF"]),"ALLTRIM(V3R_CODIGO)")
													If !oModel_V83:IsEmpty()
														If !oModel_V83:SeekLine( { {"V83_TPDEDU", Alltrim(jRetornoT154["T154"][nX]["T154AG"][ny]["T154AH"][nz]["T154AI"][nA]["TIPO_DEDUCAO"])},;
																				   {"V83_CODDEP", cCodigoDependente} } )
															oModel_V83:AddLine()
															oModel_V83:GoLine( oModel_V83:Length() )
														EndIf
													EndIf
													oModel_V83:SetValue( "V83_CPFDEP", Alltrim(jRetornoT154["T154"][nX]["T154AG"][ny]["T154AH"][nz]["T154AI"][nA]["T154AK"][nB]["CPF"]))
													oModel_V83:SetValue( "V83_VALDED", jRetornoT154["T154"][nX]["T154AG"][ny]["T154AH"][nz]["T154AI"][nA]["T154AK"][nB]["VAL_DEDUCAO"])
													oModel_V83:SetValue( "V83_CODDEP", cCodigoDependente)
												Next nB
											EndIf
										Next nA
									EndIf
									If Valtype(jRetornoT154["T154"][nX]["T154AG"][ny]["T154AH"][nz]["T154AJ"]) == "A" //Detalhamento das isenções - V4M
										oModel_V4M:=oModel448:GetModel("MODEL_V4M")
										nTotalSubJsonT154AJ := Len(jRetornoT154["T154"][nX]["T154AG"][ny]["T154AH"][nz]["T154AJ"])
										For nA:=1 to nTotalSubJsonT154AJ
											cTipoIsencao := ""
											If !Empty(Alltrim(jRetornoT154["T154"][nX]["T154AG"][ny]["T154AH"][nz]["T154AJ"][nA]["TIPO_ISENCAO"]))
												cTipoIsencao :=  Posicione("V4E",2,xFilial("V4E")+Alltrim(jRetornoT154["T154"][nX]["T154AG"][ny]["T154AH"][nz]["T154AJ"][nA]["TIPO_ISENCAO"]),"ALLTRIM(V4E_ID)")
											EndIf
											If !oModel_V4M:IsEmpty()
												If !oModel_V4M:SeekLine( { {"V4M_IDTPIS", cTipoIsencao} } )
													oModel_V4M:AddLine()
													oModel_V4M:GoLine( oModel_V4M:Length() )
												EndIf
											EndIf
											oModel_V4M:SetValue( "V4M_CTPISE", Alltrim(jRetornoT154["T154"][nX]["T154AG"][ny]["T154AH"][nz]["T154AJ"][nA]["TIPO_ISENCAO"]))
											oModel_V4M:SetValue( "V4M_VLRISE", jRetornoT154["T154"][nX]["T154AG"][ny]["T154AH"][nz]["T154AJ"][nA]["VAL_ISENTO"])
											oModel_V4M:SetValue( "V4M_DRENDI", Alltrim(jRetornoT154["T154"][nX]["T154AG"][ny]["T154AH"][nz]["T154AJ"][nA]["DESC_RENDIMENTO"]))
											oModel_V4M:SetValue( "V4M_IDTPIS", cTipoIsencao)
										Next nA
									EndIf
								Next nz
							EndIf
							
						Next nY
					EndIf
					If oModel448:VldData()
						If oModel448:CommitData()
							lGravadados := .T.
						Else
							//Trecho necessário devido as valições que ocorrem direto no commit do TAFA448
							cLog := cValToChar(oModel448:GetErrorMessage()[5]) + ' - '
							cLog += cValToChar(oModel448:GetErrorMessage()[6])
							aDadosLog := {(cAliasTemp)->TMP_MOVORI, (cAliasTemp)->TMP_ID, FwX2Nome('LEM'), cLog, .T., '' }
							TAFConout(cLog,,, STR0002)
							lGravadados := .F.
						EndIf
					Else
						lGravadados := .F.
						cLog := cValToChar(oModel448:GetErrorMessage()[4]) + ' - '
						cLog += cValToChar(oModel448:GetErrorMessage()[5]) + ' - '
						cLog += cValToChar(oModel448:GetErrorMessage()[6])
						aDadosLog := {(cAliasTemp)->TMP_MOVORI, (cAliasTemp)->TMP_ID, FwX2Nome('LEM'), cLog, .T., '' }
						TAFConout(cLog,,, STR0002)
					Endif
				EndIf
			EndIf
		Next nX
	EndIf

Return lGravadados

/*/{Protheus.doc} Buscachavenotafiscal
@type			Function
@description	busca o campo C20_CHVNF para amarração com a tabela LEM
@author			Pâmela Bernardo
@since			17/03/2025
@version		1.0
/*/
Static Function Buscachavenotafiscal(cNumeroNota as character, cSerieNota as character, cOperacao as character,;
									 cCodigoParticipante as character, cNatureza as character, cFilOrigem as character)
	Local cChaveC20 := "" as character
	Local cQuery 	:= "" as character
	Local iBind 	:= 1 		as integer

	If __oQueryC20 == Nil
		cQuery:="SELECT C20_CHVNF CHVNF"
		cQuery+= "FROM "+RetSQLName("C20") + " C20 "
		cQuery+= "WHERE C20_FILIAL = ? "
		cQuery+= " AND C20.C20_SERIE = ? "
		cQuery+= " AND C20.C20_NUMDOC = ? "
		cQuery+= " AND (C20.C20_CODPAR = ? OR C20.C20_CODPAR = ?)"
		cQuery+= " AND C20.D_E_L_E_T_ = ? "

		cQuery := ChangeQuery(cQuery)
		__oQueryC20 := FwExecStatement():New(cQuery)
	EndIf
	If __oQueryC20 != Nil
		__oQueryC20:SetString(iBind++, xFilial("C20",cFilOrigem))
		__oQueryC20:SetString(iBind++, cSerieNota)
		__oQueryC20:SetString(iBind++, cNumeroNota)
		__oQueryC20:SetString(iBind++, cCodigoParticipante)
		__oQueryC20:SetString(iBind++, ' ')
		__oQueryC20:SetString(iBind++, ' ')
		
		cQuery := __oQueryC20:GetFixQuery()
		cChaveC20:= MPSysExecScalar(cQuery,'CHVNF')	
	EndIf

Return cChaveC20
