#INCLUDE "TLPP-CORE.TH"
#INCLUDE "PROTHEUS.CH"
#INCLUDE "TAFXFIN.CH"
#INCLUDE "FWMVCDEF.CH"

namespace totvs.protheus.fiscal.taf.financialintegration

/*/{Protheus.doc} GravaT999
@type			Function
@description	Função de deleção dos registros importados.
@author			Pâmela Bernardo
@since			17/03/2025
@version		1.0
/*/
Function GravaT999(jRetornoT999 as json,aDadosLog as array, cAliasTemp as character) as logical
	Local lGravadados := .T. as logical
	Local cLog := "" as character
	Local cIDNaturezaRendimento := "" as character
	Local cIdParticipante	:= "" as character
	Local cModelo:= "" as character
	Local cTabela := "" as character
	Local nTamanhoCoddoc:= TAMSX3("V4K_CODDOC")[1] as numeric
	Local nTamanhospace := 0 as numeric
	Local nTotalJson := 0 as numeric
	Local nX := 0 as numeric
	Local aArrayAux := {} as array
	Local oModel as object
	Local lDeletaLem := .F. as logical
	
	nTotalJson := Len(jRetornoT999["REG_CHV"])

	For nX:=1 to nTotalJson
		aArrayAux:= StrTokArr2( jRetornoT999["REG_CHV"][nX] , "|" ,.T.)
		cModelo := ""
		lDeletaLem := .F.
		Do Case
			Case aArrayAux[1] == "T154" .and. lGravadados
				LEM->(DbSetOrder(1))
				If LEM->(dbSeek(xFilial("LEM")+(cAliasTemp)->TMP_ID))
					cModelo := "TAFA448"
					cTabela:= "LEM"
				EndIf
			Case aArrayAux[1] == "T158" .and. lGravadados
				V3U->(DbSetOrder(1))
				If V3U->(dbSeek(xFilial("LEM")+(cAliasTemp)->TMP_ID))
					cModelo := "TAFA535"
					cTabela:= "V3U"
				EndIf
			Case aArrayAux[1] == "T162" .and. lGravadados
				cIDNaturezaRendimento := Posicione("V3O",1,xFilial("V3O")+aArrayAux[3],"ALLTRIM(V3O_ID)")

				V14->(DbSetOrder(5))
				If V14->(DbSeek(xFilial("V14")+AllTrim(aArrayAux[11])))
					cIdParticipante:= V14->V14_IDC1H
				EndIf
				nTamanhospace := nTamanhoCoddoc - LEN(aArrayAux[2])
				V4K->(dbSetOrder(2)) //V4K_FILIAL+V4K_INDNAT+V4K_IDNATR+V4K_CODDOC+V4K_IDPART+DTOS(V4K_DTPAG)
				If V4K->(DbSeek(xFilial("V4K")+aArrayAux[10]+cIDNaturezaRendimento+aArrayAux[2]+Space(nTamanhospace)+cIdParticipante))
					cModelo :="TAFA542"	
					cTabela := "V4K"
					lDeletaLem := .T.
				EndIf
			Case aArrayAux[1] == "MIT" .and. lGravadados
				T1A->(dbSetOrder(3))
				If T1A->(DbSeek(xFilial("T1A")+(cAliasTemp)->TMP_IDMOV))
					cModelo :="TAFA632"	
					cTabela := "T1A"
					lDeletaLem := .T.
				EndIf
		EndCase
		If !Empty(cModelo)
			oModel  := FWLoadModel(cModelo)
			oModel:SetOperation(MODEL_OPERATION_DELETE) 
			oModel:Activate()

			If oModel:VldData()
				lGravadados := oModel:CommitData()
				If lGravadados .And. lDeletaLem
					LEM->(DbSetOrder(1))
					If LEM->(dbSeek(xFilial("LEM")+(cAliasTemp)->TMP_ID))
						RecLock("LEM", .F.)
							LEM->(DbDelete())
						LEM->(MsUnlock())
					EndIf
				EndIf
			Else
				lGravadados := .F.
				cLog := cValToChar(oModel:GetErrorMessage()[4]) + ' - '
				cLog += cValToChar(oModel:GetErrorMessage()[5]) + ' - '
				cLog += cValToChar(oModel:GetErrorMessage()[6])
				aDadosLog := {(cAliasTemp)->TMP_MOVORI, (cAliasTemp)->TMP_ID, FwX2Nome(cTabela), cLog, .T., '' }
				TAFConout(cLog,,, STR0002)
			Endif
			oModel:DeActivate()
		EndIf

	Next nX
Return lGravadados
