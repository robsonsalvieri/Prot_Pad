//---------------------------------------------------------------------
/*/{Protheus.doc} employeesByRevenueCode
@type           method
@description    Método GET para listar funcionários por código de receita.
                Paginação Infinita com limite de página.

@author         Alexandre Lima Santos / Denis R. de Oliveira
@since          26/11/2025

@param          revenueCode (Query) - Código da Receita.
@param          companyId   (Query) - ID da Empresa/Filial.
@param          requestId   (Query) - ID da Requisição.
@param          page        (Query) - Paginação.
@param          pageSize    (Query) - Tamanho da Página.
@return         lRet                - Sucesso.
/*/
//---------------------------------------------------------------------
Method employeesByRevenueCode() Class IrrfRevenueCodes

    //-------------------------------------------------------------------------
    // Declaração de Variáveis
    //-------------------------------------------------------------------------
    Local aJson     as Array
    Local cCodRec   as Character
    Local cIdPad    as Character
    Local cKeyBase  as Character
    Local cKeySeek  as Character
    Local cLevel    as Character
    Local jItem     as Json
    Local jQuery    as Json
    Local jResponse as Json
    Local lHasNext  as Logical
    Local lDiverg   as Logical
    Local nCount    as Numeric
    Local nPage     as Numeric
    Local nPageSize as Numeric
    Local nSkip     as Numeric
    Local oService  as Object

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    aJson     := {}
    cCodRec   := ""
    cIdPad    := ""
    cKeyBase  := ""
    cKeySeek  := ""
    cLevel    := "2"
    jItem     := Nil
    jQuery    := Nil
    jResponse := Nil
    lHasNext  := .F.
    nCount    := 0
    nPage     := 1
    nPageSize := 200
    nSkip     := 0
    oService  := TafGenericServices():New()

    //-------------------------------------------------------------------------
    // Carga de Dados da Requisição
    //-------------------------------------------------------------------------
    jQuery    := oRest:getQueryRequest()
    cCodRec   := IIf( jQuery["revenueCode"] <> Nil, jQuery["revenueCode"], "" )
    lDiverg   := IIF(jQuery['differencesOnly'] <> Nil , jQuery['differencesOnly'] == "true", .F. ) 

    // Controle de Paginação (Default: Página 1, 200 Registros)
    nPage     := IIf( jQuery["page"]     <> Nil, Val(jQuery["page"]), 1 )
    nPageSize := IIf( jQuery["pageSize"] <> Nil, Val(jQuery["pageSize"]), 200 )
    
    If nPage < 1; nPage := 1; EndIf
    If nPageSize < 1; nPageSize := 200; EndIf

    //-------------------------------------------------------------------------
    // Validação do ambiente
    //-------------------------------------------------------------------------
    If !oService:validateAndPrepare( jQuery, .T. )
        Return
    EndIf

    //-------------------------------------------------------------------------
    // Busca Paginada das informações no Banco de Dados
    //-------------------------------------------------------------------------
    DBSelectArea("V45")
    V45->( DbSetOrder(4) ) 
    
    // cIdPad garante o tamanho exato do RequestID.
    cIdPad   := Padr( oService:cRequestId , Tamsx3( 'V45_ID' )[1] )
    
    // cKeySeek é usado para o ponteiro pular direto para o primeiro registro do CodRec.
    cKeySeek := xFilial("V45") + cIdPad + cLevel + cCodRec
    
    // cKeyBase é a base engessada (Filial + ID + Level) para o laço While.
    cKeyBase := xFilial("V45") + cIdPad + cLevel
    
    jResponse := JsonObject():New()

    If V45->( DBSeek( cKeySeek ) )
        
        // 1. MOTOR DE OFFSET (Pula as páginas anteriores)
        nSkip := (nPage - 1) * nPageSize
        While nSkip > 0 .And. !V45->( Eof() ) .And. V45->( V45_FILIAL + V45_ID + V45_LEVEL ) == cKeyBase .And. AllTrim(V45->V45_CODREC) == cCodRec
            V45->( DbSkip() )
            nSkip--
        EndDo

        // 2. MOTOR DE FETCH (Coleta apenas os registros da página atual)
        nCount   := 0
        lHasNext := .F.
        
        While !V45->( Eof() ) .And. V45->( V45_FILIAL + V45_ID + V45_LEVEL ) == cKeyBase .And. AllTrim(V45->V45_CODREC) == cCodRec .And. nCount < nPageSize
            
            If !Empty(V45->V45_RESP)
                
                jItem := JsonObject():New()
                
                If lDiverg

                    If V45->V45_DIVERG == '1' 
                        jItem:FromJson( EncodeUTF8( V45->V45_RESP ) )
                        aAdd( aJson, jItem )
                        nCount++
                    Endif

                Else
                    // O EncodeUTF8 atua na string individual pequena (~200 bytes)
                    jItem:FromJson( EncodeUTF8( V45->V45_RESP ) )
                    aAdd( aJson, jItem )
                    nCount++
                EndIf 
                
                
            EndIf

            V45->( DbSkip() )
        EndDo
        
        // 3. Verifica se existe uma próxima página para avisar o Front-end
        If !V45->( Eof() ) .And. V45->( V45_FILIAL + V45_ID + V45_LEVEL ) == cKeyBase .And. AllTrim(V45->V45_CODREC) == cCodRec
            lHasNext := .T.
        EndIf
        
        // 4. Monta a resposta final
        jResponse["hasNext"]  := lHasNext
        jResponse["items"]    := aJson
        jResponse["page"]     := nPage
        jResponse["pageSize"] := nPageSize
        
        oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")
        oRest:SetResponse( jResponse:ToJson() )
        
    Else
        // Fallback: Nenhum registro encontrado
        jResponse["hasNext"]  := .F.
        jResponse["items"]    := {}
        jResponse["page"]     := nPage
        jResponse["pageSize"] := nPageSize
        
        oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")
        oRest:SetResponse( jResponse:ToJson() )
    EndIf

    FreeObj( jResponse )
    jResponse := Nil

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} employeeDetails
@type           method
@description    Método GET para consultar detalhes de um funcionário.
@author         Alexandre Lima Santos / Fábio Mendonça
@since          
@param          revenueCode (Query) - Código da Receita.
@param          cpf (Query)         - CPF.
@param          companyId (Query)   - ID da Empresa/Filial.
@param          requestId (Query)   - ID da Requisição.
@return         lRet                - Sucesso.
/*/
//---------------------------------------------------------------------
Method employeeDetails() Class IrrfRevenueCodes

    Local aJson     as Array
    Local cCodRec   as Character
    Local cCpf      as Character
    Local cLevel    as Character
    Local cSeekKey  as Character
    Local jJson     as Object
    Local jQuery    as Json
    Local jResponse as Json
    Local lDiverg   as Logical
    Local oService  as Object

    aJson     := {}
    cLevel    := "3"
    cSeekKey  := ""
    jQuery    := oRest:getQueryRequest()
    jResponse := JsonObject()        :New()
    oService  := TafGenericServices():New()

    cCodRec     := IIF(jQuery["revenueCode"] <> Nil, jQuery["revenueCode"] , "") 
    cCpf        := IIF(jQuery["cpf"]         <> Nil, jQuery["cpf"] , "")  
    lDiverg   := IIF(jQuery['differencesOnly'] <> Nil , jQuery['differencesOnly'] == "true", .F. ) 

    If !oService:validateAndPrepare( jQuery, .T. )
        Return
    EndIf

    // PADRÃO DE RESPOSTA (Evita a "piscada" de tela ou erro no Front-end se não achar nada)
    jResponse["hasNext"] := .F.
    jResponse["items"]   := {}

    If !Empty(cCodRec) .And. !Empty(cCpf) 
        // V45 Order 4: V45_FILIAL + V45_ID + V45_LEVEL + V45_CODREC + V45_CPF
        DbSelectArea("V45")
        V45->( DbSetOrder(4) )

        cSeekKey := xFilial("V45") + Padr( oService:cRequestId , Tamsx3( 'V45_ID' )[1] ) + cLevel + Padr( cCodRec, Tamsx3('V45_CODREC')[1] ) + cCpf
        
        If V45->( DBSeek( cSeekKey ) ) 
            jJson := JsonObject():New()

            If lDiverg
                If V45->V45_DIVERG == '1' 
                    jJson:FromJson( EncodeUTF8( V45->V45_RESP ) )
                    AAdd( aJson, jJson ) 
                EndIf 
            Else
                jJson:FromJson( EncodeUTF8( V45->V45_RESP ) )
                AAdd( aJson, jJson ) 
            EndIf 
            
            jResponse["items"] := aJson
        EndIf
    EndIf

    // Finaliza a resposta
    oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")
    oRest:SetResponse( jResponse:ToJson() )
    
    FreeObj( jResponse )
    jResponse := Nil

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} getStatus
@type           method
@description    Método GET para consultar o percentual de execução do relatório.
@author         Felipe C. Seolin / Denis R. de Oliveira
@since          30/08/2019
@param          companyId (Query) - ID da Empresa/Filial.
@param          requestId (Query) - ID da Requisição.
@return         lRet              - Sucesso.
/*/
//---------------------------------------------------------------------
Method getStatus() Class IrrfRevenueCodes

    Local jQuery    as Json
    Local jResponse as Json
    Local lIsLegacy as Logical
    Local oService  as Object

    jQuery    := oRest:getQueryRequest()
    jResponse := Nil
    lIsLegacy := .F.
    oService  := TafGenericServices():New()

    If !oService:validateAndPrepare( jQuery, .T. )
        Return
    EndIf

    lIsLegacy := TAFAlsInDic( "V5H" ) .and. !Empty( AllTrim( GetNewPar( "MV_TAFRHUR", "" ) ) )

    If ValidID( oService:cRequestId )
        GetPercent( @jResponse, oService:cRequestId )
        
        oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")
        oRest:SetResponse( jResponse:ToJson() )
    Else
        oRest:setStatusCode(400)
        oRest:SetResponse( EncodeUTF8( "A Identificação da Requisição '" + oService:cRequestId + "' informada não existe." ) )
    EndIf

    FreeObj( jResponse )
    DelClassIntF()

Return 

//---------------------------------------------------------------------
/*/{Protheus.doc} exportEmployeeDetails
@type           method
@description    Exporta em formato Excel os detalhes com paginação.
@author         Rodrigo Nicolino
@since          2025/12/14
@param          companyId (Query) - ID da Empresa/Filial.
@param          requestId (Query) - ID da Requisição.
@param          page (Query)      - Paginação.
@return         lRet              - Sucesso.
/*/
//---------------------------------------------------------------------
Method exportEmployeeDetails() Class IrrfRevenueCodes

    Local aJson     as Array
    Local cIdPad    as Character
    Local cKey      as Character
    Local cLevel    as Character
    Local jJson     as Object
    Local jQuery    as Json
    Local jResponse as Object
    Local lRet      as Logical
    Local oService  as Object
    
    // Controle de Paginação
    Local lHasNext  as Logical
    Local lDiverg   as Logical
    Local nCount    as Numeric
    Local nPage     as Numeric
    Local nPageSize as Numeric
    Local nSkip     as Numeric

    aJson     := {}
    cLevel    := "3"
    jQuery    := oRest:getQueryRequest()
    jResponse := JsonObject():New()
    lRet      := .T.
    oService  := TafGenericServices():New()

    // Paginação
    nPage       := IIF(jQuery["page"]     <> Nil, Val(jQuery["page"]), 1)
    nPageSize   := IIF(jQuery["pageSize"] <> Nil, Val(jQuery["pageSize"]), 200)
    lDiverg   := IIF(jQuery['differencesOnly'] <> Nil , jQuery['differencesOnly'] == "true", .F. ) 
    
    If nPage < 1; nPage := 1; EndIf
    If nPageSize < 1; nPageSize := 200; EndIf

    // DRY: Valida e Prepara Ambiente
    If !oService:validateAndPrepare( jQuery, .T. )
        Return 
    EndIf

    cIdPad := Padr( oService:cRequestId , Tamsx3( 'V45_ID' )[1] )
    cKey   := xFilial("V45") + cIdPad + cLevel

    DbSelectArea("V45")
    V45->( DbSetOrder(4) ) 

    If V45->( DBSeek( cKey ) )
        
        // OFFSET
        nSkip := (nPage - 1) * nPageSize
        
        While nSkip > 0 .And. !V45->( Eof() ) .And. V45->( V45_FILIAL + V45_ID + V45_LEVEL ) == cKey
            V45->( DbSkip() )
            nSkip--
        EndDo

        // FETCH
        nCount   := 0
        lHasNext := .F.

        While !V45->( Eof() ) .And. V45->( V45_FILIAL + V45_ID + V45_LEVEL ) == cKey .And. nCount < nPageSize
            
            If !Empty(V45->V45_RESP)

                jJson := JsonObject():New()

                If lDiverg

                    If V45->V45_DIVERG == '1' 
                        jJson:FromJson( EncodeUTF8( V45->V45_RESP ) )
                        AAdd( aJson, jJson )
                        nCount++
                    EndIf

                Else
                    jJson:FromJson( EncodeUTF8( V45->V45_RESP ) )
                    AAdd( aJson, jJson )
                    nCount++
                EndIf
        
            EndIf

            V45->( DbSkip() )
        EndDo
        
        If !V45->( Eof() ) .And. V45->( V45_FILIAL + V45_ID + V45_LEVEL ) == cKey
            lHasNext := .T.
        EndIf
        
        jResponse["hasNext"]  := lHasNext
        jResponse["items"]    := aJson
        jResponse["page"]     := nPage
        jResponse["pageSize"] := nPageSize
        
        oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")
        oRest:SetResponse( jResponse:ToJson() )
    Else
        jResponse["hasNext"] := .F.
        jResponse["items"]   := {}
        
        oRest:setKeyHeaderResponse("Content-Type", "application/json; charset=utf-8")
        oRest:SetResponse( jResponse:ToJson() )
    EndIf

    FreeObj(jResponse)

Return lRet

//---------------------------------------------------------------------
/*/{Protheus.doc} ValidID
@type			function
@description	Verifica se o Identificador da Requisição é válido.
@author			Alexandre de Lima Santos
@since			03/08/2021
@param			cRequestID	-	Identificador da Requisição
@return			lRet		-	Indica se o Identificador da Requisição é válido
/*/
//---------------------------------------------------------------------
Static Function ValidID( cRequestID as character )

	Local lRet	as logical

    Default cRequestID := ""

	lRet	:=	.F.

	DBSelectArea( "V3J" )
	V3J->( DBSetOrder( 1 ) )
	lRet := V3J->( MsSeek( xFilial( "V3J" ) + PadR( cRequestID, GetSX3Cache("V3J_ID", "X3_TAMANHO") ) ) )

Return( lRet )
