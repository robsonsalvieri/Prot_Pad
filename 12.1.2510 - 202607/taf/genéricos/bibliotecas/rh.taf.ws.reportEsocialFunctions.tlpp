#Define BAR_JSON2_END                   99  // Fim JSON nivel 3
#Define BAR_FINAL                      100  // Conclusao

#Define BAR_CONT_START                  26  // Suavizacao em contingencia (pos integracao)
#Define BAR_CONT_END                    29
#Define BAR_UI_SLEEP_MS                250  // >= polling do front
#Define BAR_TOT_QRY_START               26  // Totalizador: inicio SQL (dentro de 25% a 30%)
