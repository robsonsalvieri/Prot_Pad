#Define BAR_COD_LOOP_START              31  // Cod. Receita: inicio loop detalhado
#Define BAR_COD_LOOP_END                34  // Cod. Receita: fim loop detalhado

//---------------------------------------------------------------------
/*/{Protheus.doc} GetIrrfTotalizer
@type           function
@description    Executa a consulta do resultado do relatório de conferência (Totalizador).

@author         Denis R de Oliveira
@since          27/11/2025
@version        1.0

@param          jResponse (Json)    - Objeto JSON de retorno (passado por referência).
@param          cRequestID (Char)   - Identificador da Requisição.
@return         jResponse (Json)    - Retorna o objeto manipulado.
/*/
//---------------------------------------------------------------------
Function GetIrrfTotalizer( jResponse as Json, cRequestID as Character, lDiverg as Logical )

    Local cLevel    As Character
    Local jJsonFull As Json

    Default jResponse  := JsonObject():New() 
    Default cRequestID := ""
    Default lDiverg := .F.

    cLevel    := "1"
    jJsonFull := JsonObject():New()

    // Inicializa vazio para garantir que retorna objeto, evitando erro 500
    jResponse := JsonObject():New() 

    DBSelectArea("V45")
    V45->( DbSetOrder(4) )
    
    // V45_FILIAL + V45_ID + V45_LEVEL
    If V45->( DBSeek( xFilial("V45") + PadR( cRequestID, TamSX3("V45_ID")[1] ) + cLevel ) )

        jJsonFull:FromJson( EncodeUTF8( V45->V45_RESP ) )

        If jJsonFull:HasProperty("totalIRRFCompany")
            jResponse:FromJson( jJsonFull["totalIRRFCompany"]:ToJson() )
        EndIf

    EndIf

    // Limpa a memória do JSON
    FreeObj( jJsonFull )
    jJsonFull := Nil

Return jResponse

//---------------------------------------------------------------------
/*/{Protheus.doc} GetIrrfRevenueCodes
@type           function
@description    Executa a consulta dos códigos de receita do relatório.

@author         Denis R de Oliveira
@since          27/11/2025
@version        1.0

@param          jResponse (Json)    - Objeto JSON de retorno (passado por referência).
@param          cRequestID (Char)   - Identificador da Requisição.
@return         jResponse (Json)    - Retorna o objeto manipulado.
/*/
//---------------------------------------------------------------------
Function GetIrrfRevenueCodes( jResponse as Json, cRequestID as Character, lDiverg as Logical )
    
    Local cLevel    As Character
    Local jJsonFull As Json
    Local jEvenue   As Json
    Local jItem     As Json

    Default jResponse  := JsonObject():New()
    Default cRequestID := ""
    Default lDiverg := .F.

    cLevel    := "1"
    jJsonFull := JsonObject():New()
    jEvenue   := JsonObject():New()
    jItem     := JsonObject():New()

    DBSelectArea("V45")
    V45->( DbSetOrder(4) )
    
    If V45->( DBSeek( xFilial("V45") + PadR( cRequestID, TamSX3("V45_ID")[1] ) + cLevel ) )

        If lDiverg

            If V45->V45_DIVERG == '1' 
                jJsonFull:FromJson( EncodeUTF8( V45->V45_RESP ) )
            Else
                jResponse := JsonObject():New()
                jResponse["totalIRRFCompany"] := JsonObject():New()
                jResponse["totalIRRFCompany"]["items"] := {}

                jItem := JsonObject():New()
                jItem["totalIRRFCompany"] := JsonObject():New()
                jItem["totalIRRFCompany"]["totalIrrfTaf"] := 0
                jItem["totalIRRFCompany"]["totalIrrfErp"] := 0
                jItem["totalIRRFCompany"]["totalIrrfRet"] := 0
                jItem["totalIRRFCompany"]["divergent"]    := .F.
                aAdd(jResponse["totalIRRFCompany"]["items"], jItem)

                jResponse["revenueCodes"] := JsonObject():New()
                jResponse["revenueCodes"]["items"] := {}
                jEvenue["evenue"] := {}
                aAdd(jResponse["revenueCodes"]["items"], jEvenue ) 
                jJsonFull := jResponse
            EndIf
            
        Else
            jJsonFull:FromJson( EncodeUTF8( V45->V45_RESP ) )  
        EndIf 

        If jJsonFull:HasProperty("revenueCodes") .And. Len( jJsonFull["revenueCodes"]["items"] ) > 0
            jResponse:FromJson( jJsonFull["revenueCodes"]:ToJson() )
        EndIf

    EndIf
    
    // Limpa a memória do JSON
    FreeObj( jJsonFull )
    jJsonFull := Nil

Return jResponse

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFPOSTDIRF
@type           Function
@description    Função de entrada (RPC) para processamento do relatório.
                Gerencia o fluxo Nativo (Prioritário) e Legado (Opcional/Híbrido).
                Controla a UX da barra de progresso para polling de 5 segundos.

@author         Alexandre de Lima Santos / Denis R. de Oliveira
@since          28/10/2025
@version        1.0

@param          cEmpRequest, Character, Empresa da requisição.
@param          cFilRequest, Character, Filial da requisição.
@param          cTicket,     Character, Ticket (ID) da requisição.

@return         lRet,        Logical,   Sucesso (.T.) ou falha (.F.) no processamento.
/*/
//---------------------------------------------------------------------
Function TAFPOSTDIRF( cEmpRequest As Character, cFilRequest As Character, cTicket As Character )

    //-------------------------------------------------------------------------
    // Declaração de Variáveis
    //-------------------------------------------------------------------------
    Local aHeaderLg     As Array
    Local cFilRHLg      As Character
    Local cPayPerLg     As Character
    Local jRequest      As Json
    Local jRequestLg    As Json
    Local lIsLegacy     As Logical
    Local lRet          As Logical
    Local lApiSuccess   As Logical
    Local nP            As Numeric
    Local nTamIdV3J     As Numeric
    Local nTotalRegs    As Numeric
    Local cFiltroPer    As Character
    Local cFiltroRev    As Character
    Local cFiltroCpf    As Character
    Local cFiltroNome   As Character

    private lDivergente := .F.

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default cEmpRequest := ""
    Default cFilRequest := ""
    Default cTicket     := ""

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    jRequest     := Nil
    jRequestLg   := Nil
    aHeaderLg    := {}
    cFilRHLg     := ""
    cPayPerLg    := ""
    lIsLegacy    := .F.
    lRet         := .F.
    lApiSuccess  := .F.
    nP           := 0
    nTamIdV3J    := 0
    nTotalRegs   := 0
    cFiltroPer   := ""
    cFiltroRev   := ""
    cFiltroCpf   := ""
    cFiltroNome  := ""

    //-------------------------------------------------------------------------
    // Configuração de Ambiente
    //-------------------------------------------------------------------------
    RPCSetType( 3 )
    RPCSetEnv( cEmpRequest, cFilRequest, , , "TAF", "TAFPOSTDIRF" )

    jRequest := JsonObject():New()

    //-------------------------------------------------------------------------
    // Carga da Requisição (V3J)
    //-------------------------------------------------------------------------
    nTamIdV3J := GetSX3Cache( "V3J_ID", "X3_TAMANHO" )

    DBSelectArea( "V3J" )
    V3J->( DbSetOrder( 1 ) )

    If V3J->( MsSeek( xFilial( "V3J" ) + PadR( cTicket, nTamIdV3J ) ) )

        //-------------------------------------------------------------------
        // FASE 1: Inicialização (1% - 5%)
        //-------------------------------------------------------------------
        setProgress( cTicket, BAR_INIT, 100, .T., BAR_INIT ) // 1%
        Sleep( 5000 ) // Estabilização

        // Carrega parâmetros
        jRequest:FromJson( V3J->V3J_PARAMS )

        cFiltroPer  := StrTran( cValToChar( jRequest["period"] ), "-", "" )
        cFiltroRev  := cValToChar( jRequest["revenueCode"] )
        cFiltroCpf  := StrTran( StrTran( StrTran( cValToChar( jRequest["cpf"] ), ".", "" ), "-", "" ), "/", "" )
        cFiltroNome := cValToChar( jRequest["name"] )

        // Contagem Inicial (Necessária para Nativos e Contingência)
        nTotalRegs  := TAFCountRecordsDirf( FilMatriz(), cFiltroPer, cFiltroRev, cFiltroCpf, cFiltroNome )
        
        setProgress( cTicket, BAR_COUNT_DONE, 100, .T., BAR_COUNT_DONE ) // 5%
        Sleep( 5000 )  // Estabilização

        // Definição do Cenário: É legado se tiver URL configurada
        lIsLegacy := !Empty( AllTrim( cValToChar( GetNewPar( "MV_TAFRHUR", "" ) ) ) )

        //-------------------------------------------------------------------
        // FASE 2: Tentativa de Integração (Cenários 2 e 3)
        //-------------------------------------------------------------------
        If lIsLegacy

            setProgress( cTicket, BAR_API_START, 100, .T., BAR_API_START ) // 5%

            If !Empty( AllTrim( cValToChar( GetNewPar( "MV_TAFRHLG", "" ) ) ) )
                aHeaderLg := GetHeader()
            Else
                aHeaderLg := {}
            EndIf
            
            cFilRHLg := GetFilRH( aHeaderLg )

            If !Empty( cFilRHLg )
                
                TAFConOut( "[TAFPOSTDIRF] Executando Integracao Legado (API)..." )

                jRequestLg := jRequest
                cPayPerLg  := cValToChar( jRequestLg["period"] )

                // A função GetRHValuesDirf consome o tempo real da requisição (Polling RH).
                If GetRHValuesDirf( jRequestLg, cPayPerLg, .T., V3J->V3J_ID, cFilRHLg, aHeaderLg, BAR_API_START, BAR_API_END )
                    
                    lApiSuccess := .T.
                    
                    // RE-CONTAGEM CRÍTICA: 
                    // Se a API trouxe dados novos, o nTotalRegs mudou. Atualizamos aqui.
                    nTotalRegs := TAFCountRecordsDirf( FilMatriz(), cFiltroPer, cFiltroRev, cFiltroCpf, cFiltroNome )

                EndIf

            Else
                TAFConOut( "[TAFPOSTDIRF] [AVISO] API Indisponivel (Configuracao). Usando dados T8R locais." )
                // Cenário 4: Configuração incompleta -> lApiSuccess continua .F.
            EndIf

        EndIf

        //-------------------------------------------------------------------
        // FASE 3: UX para Nativos (Cenário 1) ou Contingência (Cenário 4)
        //-------------------------------------------------------------------
        // Se NÃO houve sucesso na API (ou porque é Nativo, ou porque a API falhou),
        If !lApiSuccess
            
            // Loop Visual: 6% até 24%
            For nP := ( BAR_COUNT_DONE + 1 ) To ( BAR_API_END - 1 )
                setProgress( cTicket, nP, 100, .T., nP )
                Sleep( 300 ) 
            Next nP

            // Desliga a chave de Legado. Impede que o sistema 
            // compare os valores TAF com a Folha (que estaria zerada) para clientes GPE.
            lIsLegacy := .F.

        EndIf
        
        // Marco de 25%: Fim da fase de Carga/Preparo
        setProgress( cTicket, BAR_API_END, 100, .T., BAR_API_END )

        //---------------------------------------------------------------------
        // FASE 4: Core Processing (Geração do Relatório) - 25% a 99%
        //---------------------------------------------------------------------
        If GetDirfVal( jRequest, cTicket, lIsLegacy, nTotalRegs )
            
            //-----------------------------------------------------------------
            // FASE 5: Finalização UX (Polling 5s)
            //-----------------------------------------------------------------      
            // 1. Força o estado 99% visualmente na tabela
            setProgress( cTicket, BAR_JSON2_END, 100, .T., BAR_JSON2_END ) 
            
            // 2. Trava de Segurança UX:
            Sleep( BAR_UI_SLEEP_MS )

            // 3. Gravação Final (100% e Status 2)
            DBSelectArea( "V3J" )
            V3J->( DbSetOrder( 1 ) )
            
            If V3J->( MsSeek( xFilial( "V3J" ) + PadR( cTicket, nTamIdV3J ) ) )
                RecLock( "V3J", .F. )
                V3J->V3J_PERC   := BAR_FINAL
                V3J->V3J_STATUS := "2" // 2 = Finalizado
                V3J->( MsUnlock() )
            EndIf

            // Garante o envio do 100% visual caso o RecLock falhe por concorrência
            setProgress( cTicket, BAR_FINAL, 100, .T., BAR_FINAL )
            lRet := .T.

        EndIf

    EndIf

    //-------------------------------------------------------------------------
    // Limpeza de Memória
    //-------------------------------------------------------------------------
    FreeObj( jRequest )
    jRequest := Nil

Return lRet

//---------------------------------------------------------------------
/*/{Protheus.doc} GetDirfVal
@type           Function
@description    Orquestrador para levantamento dos valores da DIRF/IRRF.
                Distribui o peso da barra de progresso entre as sub-etapas de geração.

@author         Alexandre de Lima Santos / Denis R. de Oliveira
@since          28/10/2025
@version        1.0

@param          jRequest,   Json,      Parâmetros da requisição.
@param          cTicket,    Character, Ticket da requisição.
@param          lIsLegacy,  Logical,   Flag de legado.
@param          nTotalRegs, Numeric,   Quantidade total de registros.
@return         Logical,    Verdadeiro.
/*/
//---------------------------------------------------------------------
Function GetDirfVal( jRequest As Json, cTicket As Character, lIsLegacy As Logical, nTotalRegs As Numeric ) As Logical

    //-------------------------------------------------------------------------
    // Declaração de Variáveis Locais
    //-------------------------------------------------------------------------
    Local aEmployeCod As Array
    Local aFils       As Array
    Local aForms      As Array
    Local aTotalizer  As Array
    
    Local cCpf        As Character
    Local cFil        As Character
    Local cName       As Character
    Local cPeriodo    As Character
    Local cRevCode    As Character

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default cTicket   := ""
    Default jRequest  := Nil
    Default lIsLegacy := .F.
    Default nTotalRegs:= 0 

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    aEmployeCod := {}
    aFils       := {}
    aForms      := {}
    aTotalizer  := {}
    
    cCpf        := ""
    cFil        := ""
    cName       := ""
    cPeriodo    := ""
    cRevCode    := ""

    //-------------------------------------------------------------------------
    // Carga de Dados do Request
    //-------------------------------------------------------------------------
    cCpf     := cValToChar( jRequest["cpf"] )
    cCpf     := StrTran( StrTran( StrTran( cCpf, ".", "" ), "-", "" ), "/", "" )

    cFil     := cValToChar( jRequest["companyId"] )
    cName    := cValToChar( jRequest["name"] )

    cPeriodo := cValToChar( jRequest["period"] )
    cPeriodo := StrTran( cPeriodo, "-", "" )  

    cRevCode := cValToChar( jRequest["revenueCode"] )
    
    // FASE 2: Totalizadores (25% a 30%)
    TAFTotalizer( cFil, cPeriodo, cRevCode, cCpf, cName, @aTotalizer, @aFils, cTicket )
    setProgress( cTicket, BAR_TOT_END, 100, .T., BAR_TOT_END )
    
    // FASE 3: Códigos de Receita (30% a 35%)
    TAFCodReceita( aFils, cPeriodo, cRevCode, cCpf, cName, @aTotalizer, @aEmployeCod, cTicket )
    setProgress( cTicket, BAR_COD_END, 100, .T., BAR_COD_END )

    // FASE 4: Formulários - O PROCESSAMENTO PESADO (35% a 75%)
    TAFFormEmployes( aFils, cPeriodo, cRevCode, cCpf, cName, @aTotalizer, @aForms, cTicket, lIsLegacy, nTotalRegs )
    setProgress( cTicket, BAR_FORM_END, 100, .T., BAR_FORM_END )

    // FASE 5: Gravação dos JSONs (75% a 99%)
    TAFJsonTotDirf( aTotalizer, cTicket, lIsLegacy )
    setProgress( cTicket, BAR_JSON_TOT_END, 100, .T., BAR_JSON_TOT_END )
    
    TAFJsonMod1Dirf( aEmployeCod, cTicket, lIsLegacy, aForms )
    setProgress( cTicket, BAR_JSON1_END, 100, .T., BAR_JSON1_END )
    
    // Entrega o restante até 99%
    TAFJsonMod2Dirf( aForms, cTicket, lIsLegacy )
    setProgress( cTicket, BAR_JSON2_END, 100, .T., BAR_JSON2_END )

Return .T.

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFTotalizer
@type           Function
@description    Realiza a consulta SQL agrupada para totalizadores (T8R).
                Retorna os valores consolidados por Código de Receita e Origem.

@author         Alexandre de Lima Santos / Denis R. de Oliveira
@since          28/10/2025
@version        1.0

@param          cFil,       Character, Filial base.
@param          cPeriodo,   Character, Período de apuração (AAAAMM).
@param          cRevCode,   Character, Código de Receita para filtro.
@param          cCpf,       Character, CPF para filtro.
@param          cName,      Character, Nome para filtro.
@param          aTotalizer, Array,     Array de retorno (Referência) com os totalizadores.
@param          aFils,      Array,     Array de retorno (Referência) com as filiais.
@param          cTicket,    Character, Ticket para progresso.

@return         Nil
/*/
//---------------------------------------------------------------------
Function TAFTotalizer( cFil As Character, cPeriodo As Character, cRevCode As Character, cCpf As Character, cName As Character, aTotalizer As Array, aFils As Array, cTicket As Character )

    //-------------------------------------------------------------------------
    // Declaração de Variáveis
    //-------------------------------------------------------------------------
    Local cAliasQry As Character
    Local cQuery    As Character
    Local nCount    As Numeric
    Local oStmt     As Object

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default aFils      := {}
    Default aTotalizer := {}
    Default cCpf       := ""
    Default cName      := ""
    Default cRevCode   := ""
    
    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    cAliasQry := GetNextAlias()
    cQuery    := ""
    nCount    := 0
    oStmt     := Nil

    // Garante filial se vier vazio
    If Empty( aFils )
        aFils := FilMatriz()
    EndIf

    //-------------------------------------------------------------------------
    // Montagem da Query
    //-------------------------------------------------------------------------
    cQuery := " SELECT T8R_CODREC, T8R_ORIGEM, "
    cQuery += " SUM( T8R_VLRTRI ) AS VLRTRI, SUM( T8R_VRTR13 ) AS VRTR13, "
    cQuery += " SUM( T8R_VLRPRE ) AS VLRPRE, SUM( T8R_VPRE13 ) AS VPRE13, "
    cQuery += " SUM( T8R_VLIRRF ) AS VLIRRF, SUM( T8R_IRRF13 ) AS IRRF13, "
    cQuery += " SUM( T8R_VLRISE ) AS VLRISE, SUM( T8R_VLRI13 ) AS VLRI13, "
    cQuery += " SUM( T8R_VLRDIA ) AS VLRDIA, SUM( T8R_VLRAJU ) AS VLRAJU, "
    cQuery += " SUM( T8R_VLRRSC ) AS VLRRSC, SUM( T8R_VLRABN ) AS VLRABN, "
    cQuery += " SUM( T8R_VLRMLG ) AS VLRMLG, SUM( T8R_VMLG13 ) AS VMLG13, "
    cQuery += " SUM( T8R_VLRAXM ) AS VLRAXM, SUM( T8R_VLBMED ) AS VLBMED, "
    cQuery += " SUM( T8R_BMED13 ) AS BMED13, SUM( T8R_VLRMOR ) AS VLRMOR, "
    cQuery += " SUM( T8R_VLRISO ) AS VLRISO "
    cQuery += " FROM " + RetSqlName( "T8R" ) + " T8R "
    
    cQuery += " WHERE T8R_FILIAL IN (?) " 
    cQuery += " AND T8R_PERAPU = ? "

    // Filtros Opcionais
    If !Empty( cRevCode )
        cQuery += " AND T8R_CODREC LIKE ? "
    EndIf
    
    If !Empty( cCpf )
        cQuery += " AND T8R_CPF = ? "
    EndIf

    If !Empty( cName )
        cQuery += " AND T8R_NOME = ? "
    EndIf

    // Filtros Fixos (Abas válidas e registros ativos)
    cQuery += " AND ( T8R_FORABA = 'TRIBUT' OR T8R_FORABA = 'DEDDEP' OR T8R_FORABA = 'PENALI' OR T8R_FORABA = 'PREVCL' OR T8R_FORABA = 'PROCRE' ) "
    cQuery += " AND T8R.D_E_L_E_T_ = '' "
    
    // Agrupamento Obrigatório
    cQuery += " GROUP BY T8R_ORIGEM, T8R_CODREC "

    // Sinaliza início da query (26%)
    setProgress( cTicket, BAR_TOT_QRY_START, 100, .T., BAR_TOT_QRY_START )
    
    //-------------------------------------------------------------------------
    // Preparação e Execução do Statement
    //-------------------------------------------------------------------------
    oStmt := FWExecStatement():New( ChangeQuery( cQuery ) )

    // Bind: Filiais
    nCount++
    oStmt:setIn( nCount, aFils )

    // Bind: Período
    nCount++
    oStmt:SetString( nCount, cPeriodo )

    // Bind: Filtros Opcionais
    If !Empty( cRevCode )
        nCount++
        oStmt:SetString( nCount, "%" + cRevCode + "%" )
    EndIf

    If !Empty( cCpf )
        nCount++
        oStmt:SetString( nCount, cCpf )
    EndIf

    If !Empty( cName )
        nCount++
        oStmt:SetString( nCount, cName )
    EndIf

    // Execução
    cAliasQry := oStmt:OpenAlias()

    // Sinaliza fim da query (28%)
    setProgress( cTicket, BAR_TOT_QRY_END, 100, .T., BAR_TOT_QRY_END )
    
    //-------------------------------------------------------------------------
    // Processamento do Resultado
    //-------------------------------------------------------------------------
    ( cAliasQry )->( DbGoTop() )

    If ( cAliasQry )->( !Eof() )
        TAFCodTotais( cAliasQry, @aTotalizer )
    EndIf
    
    ( cAliasQry )->( DbCloseArea() )

    //-------------------------------------------------------------------------
    // Limpeza de Memória
    //-------------------------------------------------------------------------
    If oStmt != Nil
        oStmt:Destroy()
        oStmt := Nil
    EndIf

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFCodReceita
@type           Function
@description    Consulta analítica por código de receita.

@author         Alexandre de Lima Santos / Denis R. de Oliveira
@since          28/10/2025
@version        1.0

@param          aFils (Array)           - Filiais.
@param          cPeriodo (Char)         - Período.
@param          cRevCode (Char)         - Código Receita.
@param          cCpf (Char)             - CPF.
@param          cName (Char)            - Nome.
@param          aTotalizer (Ref Array)  - Dados totalizados.
@param          aEmployeCod (Ref Array) - Retorno com dados por empregado.
@param          cTicket (Char)          - Ticket para progresso.
/*/
//---------------------------------------------------------------------
Function TAFCodReceita( aFils as Array, cPeriodo as Character, cRevCode as Character, cCpf as Character, cName as Character, aTotalizer as Array, aEmployeCod as Array, cTicket as Character )

    //-------------------------------------------------------------------------
    // Declaração de Variáveis Locais
    //-------------------------------------------------------------------------
    Local cAliasQry   as Character
    Local cQuery      as Character
    Local cTabT8R     as Character
    Local nCount      as Numeric
    Local oStmt       as Object

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default aEmployeCod := {}
    Default aFils       := FilMatriz()
    Default aTotalizer  := {}
    Default cCpf        := ""
    Default cName       := ""
    Default cRevCode    := ""
    Default cTicket     := ""
      
    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    cAliasQry   := GetNextAlias()
    cQuery      := ""
    cTabT8R     := RetSqlName( "T8R" )
    nCount      := 0
    oStmt       := Nil

    //-------------------------------------------------------------------------
    // Preparação da Query
    //-------------------------------------------------------------------------
    cQuery := " SELECT T8R_CODREC, T8R_NOME AS NOME, T8R_CPF AS CPF, T8R_ORIGEM AS ORIGEM, SUM( T8R_VLIRRF ) AS VLIRRF "
    cQuery += " FROM " + cTabT8R + " T8R "
    cQuery += " WHERE T8R_FILIAL IN (?) " 
    cQuery += " AND T8R_PERAPU = ? "

    // Filtro opcional: Cdigo de Receita (somente se usurio informou)
    If !Empty( cRevCode )
        cQuery += " AND T8R_CODREC LIKE ? "
    EndIf
    
    If !Empty(cCpf)
        cQuery += " AND T8R_CPF = ? "
    EndIf

    If !Empty(cName)
        cQuery += " AND T8R_NOME = ? "
    EndIf

    cQuery += " AND T8R.D_E_L_E_T_ = '' "
    cQuery += " AND ( T8R_FORABA = 'TRIBUT' OR T8R_FORABA = 'DEDDEP' OR T8R_FORABA = 'PENALI' OR T8R_FORABA = 'PREVCL' OR T8R_FORABA = 'PROCRE' ) "
    cQuery += " GROUP BY T8R_ORIGEM, T8R_CODREC, T8R_NOME, T8R_CPF "

    // Sinaliza início (31%)
    setProgress( cTicket, BAR_COD_QRY_START, 100, .T., BAR_COD_QRY_START )

    // Instancia o statement uma única vez (Hard Parse)
    oStmt := FWExecStatement():New( ChangeQuery(cQuery) )

    nCount := 0

    // Parâmetro: Filiais (Cláusula IN)
    nCount++
    oStmt:setIn( nCount, aFils )

    // Parâmetro: Período
    nCount++
    oStmt:SetString( nCount, cPeriodo )

    // Filtro condicional: Código de Receita (Parcial)
    If !Empty( cRevCode )
        nCount++
        oStmt:SetString( nCount, "%" + cRevCode + "%" )
    EndIf

    // Filtro condicional: CPF
    If !Empty(cCpf)
        nCount++
        oStmt:SetString( nCount, cCpf )
    EndIf

    // Filtro condicional: Nome
    If !Empty(cName)
        nCount++
        oStmt:SetString( nCount, cName )
    EndIf

    // Gera alias temporário e executa a instrução SQL
    cAliasQry := oStmt:OpenAlias()

    // Sinaliza execução (34%)
    setProgress( cTicket, BAR_COD_QRY_EXEC, 100, .T., BAR_COD_QRY_EXEC )

    // Processa resultados
    If ( cAliasQry )->( !Eof() )
        TAFCodIRRF( cAliasQry, @aEmployeCod, cTicket )
    EndIf

    (cAliasQry)->(DbCloseArea())

    //-------------------------------------------------------------------------
    // Limpeza de Memória
    //-------------------------------------------------------------------------
    If oStmt != Nil
        oStmt:Destroy()
        oStmt := Nil
    EndIf

Return

//-----------------------------------------------------------------------------
/*/{Protheus.doc} TAFFormEmployes
@type           Function
@description    Motor O(N) de performance (Streaming).
                Agrupa as informações em memória por CPF eliminando loops de banco.

@author         Alexandre de Lima Santos / Denis R. de Oliveira
@since          28/10/2025
@version        1.0

@param          aFils       , Array     , Lista de filiais a serem processadas.
@param          cPeriodo    , Character , Período de apuração (AAAAMM).
@param          cRevCode    , Character , Código de receita para filtro (opcional).
@param          cCpf        , Character , CPF para filtro (opcional).
@param          cName       , Character , Nome para filtro (opcional).
@param          aTotalizer  , Array     , Array com dados totalizados.
@param          aForms      , Array     , Array de retorno com os formulários (Passado por referência).
@param          cTicket     , Character , Ticket de identificação da requisição para progresso.
@param          lIsLegacy   , Logical   , Flag indicando uso da rotina legada.
@param          nTotalCpfs  , Numeric   , Quantidade total de CPFs únicos para cálculo da barra.
@return         Nil
/*/
//-----------------------------------------------------------------------------
Function TAFFormEmployes( aFils As Array, cPeriodo As Character, cRevCode As Character, cCpf As Character, cName As Character, aTotalizer As Array, aForms As Array, cTicket As Character, lIsLegacy As Logical, nTotalCpfs As Numeric )

    //-------------------------------------------------------------------------
    // Declaração de Variáveis
    //-------------------------------------------------------------------------
    Local aOrigens      As Array
    Local aRevenueCodes As Array
    Local aCodesTemp    As Array

    Local cAliasQry     As Character
    Local cQuery        As Character
    Local cTabela       As Character
    Local cCodRec       As Character
    Local cLastCPF      As Character
    Local cLastNome     As Character
    Local cOrigem       As Character
    Local cAba          As Character
    Local cOri          As Character
    Local cAuxCodRec    As Character
    Local cCleanCod     As Character

    Local nProcessed    As Numeric
    Local nPercent      As Numeric
    Local nLastPerc     As Numeric
    Local nCount        As Numeric
    Local nX            As Numeric
    Local nJ            As Numeric
    Local nO            As Numeric

    Local jFormIdx      As Json
    Local jReg          As Json
    Local jBuckets      As Json
    Local oStmt         As Object

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default aFils       := {}
    Default cPeriodo    := ""
    Default cRevCode    := ""
    Default cCpf        := ""
    Default cName       := ""
    Default aTotalizer  := {}
    Default aForms      := {}
    Default cTicket     := ""
    Default lIsLegacy   := .F.
    Default nTotalCpfs  := 1

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    aOrigens      := {}
    aRevenueCodes := {}
    aCodesTemp    := {}

    cAliasQry     := ""
    cQuery        := ""
    cTabela       := RetSqlName( "T8R" )
    cCodRec       := ""
    cLastCPF      := ""
    cLastNome     := ""
    cOrigem       := ""
    cAba          := ""
    cOri          := ""
    cAuxCodRec    := ""
    cCleanCod     := ""

    nProcessed    := 0
    nPercent      := BAR_COD_END
    nLastPerc     := BAR_COD_END
    nCount        := 0
    nX            := 0
    nJ            := 0
    nO            := 0

    jFormIdx      := JsonObject():New()
    jReg          := Nil
    jBuckets      := Nil
    oStmt         := Nil

    // Se o totalizador vier vazio, aborta
    If Len( aTotalizer ) == 0
        Return
    EndIf
    
    // Validação de Segurança
    If nTotalCpfs <= 0; nTotalCpfs := 1; EndIf

    // ========================================================================
    // QUERY SEQUENCIAL
    // ========================================================================
    cQuery := " SELECT T8R_ORIGEM, T8R_FORABA, T8R_CODREC, T8R_PERAPU, T8R_CPF, T8R_NOME, T8R_RELACO, T8R_FILIAL, "
    cQuery += " T8R_TPREND, T8R_CPFDEP, T8R_VLRDED, T8R_TPRPAL, T8R_CPFDPA, T8R_VLRPAL, T8R_TPPREV, T8R_CNPJPC, "
    cQuery += " T8R_VLDEPC, T8R_VLPC13, T8R_VLPCSP, T8R_PCVP13, T8R_TPPROC, T8R_NRPROC, T8R_CODSUP, T8R_INDAPU, "
    cQuery += " T8R_VLRRTC, T8R_DEPJUD, T8R_CANOCA, T8R_CANOAN, T8R_RENDSU, T8R_INDDED, T8R_CNPJEC, T8R_DEDSUS, "
    cQuery += " T8R_VLCONT, T8R_CPFSUS, T8R_DEPSUS, T8R_VLRTRI, T8R_VRTR13, T8R_VLRPRE, T8R_VPRE13, T8R_VLIRRF, "
    cQuery += " T8R_IRRF13, T8R_VLRISE, T8R_VLRI13, T8R_VLRDIA, T8R_VLRAJU, T8R_VLRRSC, T8R_VLRABN, T8R_VLRMLG, "
    cQuery += " T8R_VMLG13, T8R_VLRAXM, T8R_VLBMED, T8R_BMED13, T8R_VLRMOR, T8R_VLRISO, T8R_VLRPLS, T8R_CNPJOP, "
    cQuery += " T8R_REGANS, T8R_VLRDPS, T8R_CPFDPS, T8R_ORIREE, T8R_CNPJPS, T8R_ANSRRE, T8R_INSCRE, T8R_NRPSRE, "
    cQuery += " T8R_VLREEM, T8R_VLRANT, T8R_CPFRED, T8R_DINSCR, T8R_DNRPSR, T8R_SEQUEN, T8R_DVLRRE, T8R_DVLRAN "
    cQuery += " FROM " + cTabela + " T8R "
    cQuery += " WHERE T8R_FILIAL IN (?) "
    cQuery += " AND T8R_PERAPU = ? "
    cQuery += " AND T8R.D_E_L_E_T_ = '' "
    cQuery += " AND T8R_ORIGEM IN ('1','2','3') "

    If !Empty( cRevCode )
        cQuery += " AND ( T8R_CODREC LIKE ? OR T8R_CODREC = ' ' OR T8R_CODREC = '' ) "
    EndIf
    If !Empty( cCpf )
        cQuery += " AND T8R_CPF = ? "
    EndIf
    If !Empty( cName )
        cQuery += " AND T8R_NOME = ? "
    EndIf

    // Ordem para agrupamento em memória
    cQuery += " ORDER BY T8R_CPF, T8R_ORIGEM "

    oStmt := FWExecStatement():New( ChangeQuery( cQuery ) )

    nCount := 0

    nCount++
    oStmt:setIn( nCount, aFils )

    nCount++
    oStmt:SetString( nCount, cPeriodo )

    If !Empty( cRevCode )
        nCount++
        oStmt:SetString( nCount, "%" + cRevCode + "%" )
    EndIf

    If !Empty( cCpf )
        nCount++
        oStmt:SetString( nCount, cCpf )
    EndIf

    If !Empty( cName )
        nCount++
        oStmt:SetString( nCount, cName )
    EndIf

    cAliasQry := oStmt:OpenAlias()

    // ========================================================================
    // PROCESSAMENTO EM MEMÓRIA (Streaming O(N))
    // ========================================================================
    If ( cAliasQry )->( !Eof() )

        While !( cAliasQry )->( Eof() )

            cLastCPF  := ( cAliasQry )->T8R_CPF
            cLastNome := AllTrim( ( cAliasQry )->T8R_NOME )
            
            aOrigens      := {}
            aRevenueCodes := {}
            jBuckets      := JsonObject():New()

            // Carrega TODAS as linhas do CPF atual para a RAM
            While !( cAliasQry )->( Eof() ) .And. ( cAliasQry )->T8R_CPF == cLastCPF

                jReg := JsonObject():New()

                jReg["T8R_ORIGEM"]  := AllTrim( ( cAliasQry )->T8R_ORIGEM )
                jReg["T8R_FORABA"]  := AllTrim( ( cAliasQry )->T8R_FORABA )
                jReg["T8R_CODREC"]  := AllTrim( ( cAliasQry )->T8R_CODREC )
                jReg["T8R_PERAPU"]  := AllTrim( ( cAliasQry )->T8R_PERAPU )
                jReg["T8R_CPF"]     := AllTrim( ( cAliasQry )->T8R_CPF )
                jReg["T8R_NOME"]    := AllTrim( ( cAliasQry )->T8R_NOME )
                jReg["T8R_RELACO"]  := AllTrim( ( cAliasQry )->T8R_RELACO )
                jReg["T8R_FILIAL"]  := AllTrim( ( cAliasQry )->T8R_FILIAL )

                jReg["T8R_TPREND"]  := AllTrim( ( cAliasQry )->T8R_TPREND )
                jReg["T8R_CPFDEP"]  := AllTrim( ( cAliasQry )->T8R_CPFDEP )
                jReg["T8R_VLRDED"]  := IIf( ValType( ( cAliasQry )->T8R_VLRDED ) == "N", ( cAliasQry )->T8R_VLRDED, 0 )

                jReg["T8R_TPRPAL"]  := AllTrim( ( cAliasQry )->T8R_TPRPAL )
                jReg["T8R_CPFDPA"]  := AllTrim( ( cAliasQry )->T8R_CPFDPA )
                jReg["T8R_VLRPAL"]  := IIf( ValType( ( cAliasQry )->T8R_VLRPAL ) == "N", ( cAliasQry )->T8R_VLRPAL, 0 )

                jReg["T8R_TPPREV"]  := AllTrim( ( cAliasQry )->T8R_TPPREV )
                jReg["T8R_CNPJPC"]  := AllTrim( ( cAliasQry )->T8R_CNPJPC )
                jReg["T8R_VLDEPC"]  := IIf( ValType( ( cAliasQry )->T8R_VLDEPC ) == "N", ( cAliasQry )->T8R_VLDEPC, 0 )
                jReg["T8R_VLPC13"]  := IIf( ValType( ( cAliasQry )->T8R_VLPC13 ) == "N", ( cAliasQry )->T8R_VLPC13, 0 )
                jReg["T8R_VLPCSP"]  := IIf( ValType( ( cAliasQry )->T8R_VLPCSP ) == "N", ( cAliasQry )->T8R_VLPCSP, 0 )
                jReg["T8R_PCVP13"]  := IIf( ValType( ( cAliasQry )->T8R_PCVP13 ) == "N", ( cAliasQry )->T8R_PCVP13, 0 )

                jReg["T8R_TPPROC"]  := AllTrim( ( cAliasQry )->T8R_TPPROC )
                jReg["T8R_NRPROC"]  := AllTrim( ( cAliasQry )->T8R_NRPROC )
                jReg["T8R_CODSUP"]  := AllTrim( ( cAliasQry )->T8R_CODSUP )
                jReg["T8R_INDAPU"]  := AllTrim( ( cAliasQry )->T8R_INDAPU )
                jReg["T8R_VLRRTC"]  := IIf( ValType( ( cAliasQry )->T8R_VLRRTC ) == "N", ( cAliasQry )->T8R_VLRRTC, 0 )
                jReg["T8R_DEPJUD"]  := IIf( ValType( ( cAliasQry )->T8R_DEPJUD ) == "N", ( cAliasQry )->T8R_DEPJUD, 0 )
                jReg["T8R_CANOCA"]  := IIf( ValType( ( cAliasQry )->T8R_CANOCA ) == "N", ( cAliasQry )->T8R_CANOCA, 0 )
                jReg["T8R_CANOAN"]  := IIf( ValType( ( cAliasQry )->T8R_CANOAN ) == "N", ( cAliasQry )->T8R_CANOAN, 0 )
                jReg["T8R_RENDSU"]  := IIf( ValType( ( cAliasQry )->T8R_RENDSU ) == "N", ( cAliasQry )->T8R_RENDSU, 0 )

                jReg["T8R_INDDED"]  := AllTrim( ( cAliasQry )->T8R_INDDED )
                jReg["T8R_CNPJEC"]  := AllTrim( ( cAliasQry )->T8R_CNPJEC )
                jReg["T8R_DEDSUS"]  := IIf( ValType( ( cAliasQry )->T8R_DEDSUS ) == "N", ( cAliasQry )->T8R_DEDSUS, 0 )
                jReg["T8R_VLCONT"]  := IIf( ValType( ( cAliasQry )->T8R_VLCONT ) == "N", ( cAliasQry )->T8R_VLCONT, 0 )

                jReg["T8R_CPFSUS"]  := AllTrim( ( cAliasQry )->T8R_CPFSUS )
                jReg["T8R_DEPSUS"]  := IIf( ValType( ( cAliasQry )->T8R_DEPSUS ) == "N", ( cAliasQry )->T8R_DEPSUS, 0 )

                jReg["T8R_VLRTRI"]  := IIf( ValType( ( cAliasQry )->T8R_VLRTRI ) == "N", ( cAliasQry )->T8R_VLRTRI, 0 )
                jReg["T8R_VRTR13"]  := IIf( ValType( ( cAliasQry )->T8R_VRTR13 ) == "N", ( cAliasQry )->T8R_VRTR13, 0 )
                jReg["T8R_VLRPRE"]  := IIf( ValType( ( cAliasQry )->T8R_VLRPRE ) == "N", ( cAliasQry )->T8R_VLRPRE, 0 )
                jReg["T8R_VPRE13"]  := IIf( ValType( ( cAliasQry )->T8R_VPRE13 ) == "N", ( cAliasQry )->T8R_VPRE13, 0 )
                jReg["T8R_VLIRRF"]  := IIf( ValType( ( cAliasQry )->T8R_VLIRRF ) == "N", ( cAliasQry )->T8R_VLIRRF, 0 )
                jReg["T8R_IRRF13"]  := IIf( ValType( ( cAliasQry )->T8R_IRRF13 ) == "N", ( cAliasQry )->T8R_IRRF13, 0 )
                jReg["T8R_VLRISE"]  := IIf( ValType( ( cAliasQry )->T8R_VLRISE ) == "N", ( cAliasQry )->T8R_VLRISE, 0 )
                jReg["T8R_VLRI13"]  := IIf( ValType( ( cAliasQry )->T8R_VLRI13 ) == "N", ( cAliasQry )->T8R_VLRI13, 0 )
                jReg["T8R_VLRDIA"]  := IIf( ValType( ( cAliasQry )->T8R_VLRDIA ) == "N", ( cAliasQry )->T8R_VLRDIA, 0 )
                jReg["T8R_VLRAJU"]  := IIf( ValType( ( cAliasQry )->T8R_VLRAJU ) == "N", ( cAliasQry )->T8R_VLRAJU, 0 )
                jReg["T8R_VLRRSC"]  := IIf( ValType( ( cAliasQry )->T8R_VLRRSC ) == "N", ( cAliasQry )->T8R_VLRRSC, 0 )
                jReg["T8R_VLRABN"]  := IIf( ValType( ( cAliasQry )->T8R_VLRABN ) == "N", ( cAliasQry )->T8R_VLRABN, 0 )
                jReg["T8R_VLRMLG"]  := IIf( ValType( ( cAliasQry )->T8R_VLRMLG ) == "N", ( cAliasQry )->T8R_VLRMLG, 0 )
                jReg["T8R_VMLG13"]  := IIf( ValType( ( cAliasQry )->T8R_VMLG13 ) == "N", ( cAliasQry )->T8R_VMLG13, 0 )
                jReg["T8R_VLRAXM"]  := IIf( ValType( ( cAliasQry )->T8R_VLRAXM ) == "N", ( cAliasQry )->T8R_VLRAXM, 0 )
                jReg["T8R_VLBMED"]  := IIf( ValType( ( cAliasQry )->T8R_VLBMED ) == "N", ( cAliasQry )->T8R_VLBMED, 0 )
                jReg["T8R_BMED13"]  := IIf( ValType( ( cAliasQry )->T8R_BMED13 ) == "N", ( cAliasQry )->T8R_BMED13, 0 )
                jReg["T8R_VLRMOR"]  := IIf( ValType( ( cAliasQry )->T8R_VLRMOR ) == "N", ( cAliasQry )->T8R_VLRMOR, 0 )
                jReg["T8R_VLRISO"]  := IIf( ValType( ( cAliasQry )->T8R_VLRISO ) == "N", ( cAliasQry )->T8R_VLRISO, 0 )

                jReg["T8R_VLRPLS"]  := IIf( ValType( ( cAliasQry )->T8R_VLRPLS ) == "N", ( cAliasQry )->T8R_VLRPLS, 0 )
                jReg["T8R_CNPJOP"]  := AllTrim( ( cAliasQry )->T8R_CNPJOP )
                jReg["T8R_REGANS"]  := AllTrim( ( cAliasQry )->T8R_REGANS )

                jReg["T8R_VLRDPS"]  := IIf( ValType( ( cAliasQry )->T8R_VLRDPS ) == "N", ( cAliasQry )->T8R_VLRDPS, 0 )
                jReg["T8R_CPFDPS"]  := AllTrim( ( cAliasQry )->T8R_CPFDPS )

                jReg["T8R_ORIREE"]  := AllTrim( ( cAliasQry )->T8R_ORIREE )
                jReg["T8R_CNPJPS"]  := AllTrim( ( cAliasQry )->T8R_CNPJPS )
                jReg["T8R_ANSRRE"]  := AllTrim( ( cAliasQry )->T8R_ANSRRE )

                jReg["T8R_INSCRE"]  := AllTrim( ( cAliasQry )->T8R_INSCRE )
                jReg["T8R_NRPSRE"]  := AllTrim( ( cAliasQry )->T8R_NRPSRE )
                jReg["T8R_VLREEM"]  := IIf( ValType( ( cAliasQry )->T8R_VLREEM ) == "N", ( cAliasQry )->T8R_VLREEM, 0 )
                jReg["T8R_VLRANT"]  := IIf( ValType( ( cAliasQry )->T8R_VLRANT ) == "N", ( cAliasQry )->T8R_VLRANT, 0 )
                jReg["T8R_CPFRED"]  := AllTrim( ( cAliasQry )->T8R_CPFRED )
                jReg["T8R_DINSCR"]  := AllTrim( ( cAliasQry )->T8R_DINSCR )
                jReg["T8R_DNRPSR"]  := AllTrim( ( cAliasQry )->T8R_DNRPSR )
                jReg["T8R_SEQUEN"]  := AllTrim( ( cAliasQry )->T8R_SEQUEN )
                jReg["T8R_DVLRRE"]  := IIf( ValType( ( cAliasQry )->T8R_DVLRRE ) == "N", ( cAliasQry )->T8R_DVLRRE, 0 )
                jReg["T8R_DVLRAN"]  := IIf( ValType( ( cAliasQry )->T8R_DVLRAN ) == "N", ( cAliasQry )->T8R_DVLRAN, 0 )

                cAba := AllTrim( Upper( jReg["T8R_FORABA"] ) )
                cOri := jReg["T8R_ORIGEM"]

                // Aloca o registro dentro da Arvore
                If !jBuckets:HasProperty( cAba )
                    jBuckets[cAba] := JsonObject():New()
                EndIf
                If !jBuckets[cAba]:HasProperty( cOri )
                    jBuckets[cAba][cOri] := {}
                EndIf
                
                AAdd( jBuckets[cAba][cOri], jReg )

                jReg := Nil // Liberacao local do ponteiro

                If aScan( aOrigens, {|x| x == cOri} ) == 0
                    AAdd( aOrigens, cOri )
                EndIf

                cAuxCodRec := AllTrim( ( cAliasQry )->T8R_CODREC )
                
                If cOri $ "1|2|3" .And. !Empty( cAuxCodRec )
                    aCodesTemp := StrTokArr( cAuxCodRec, "|" )
                    For nJ := 1 To Len( aCodesTemp )
                        cCleanCod := AllTrim( aCodesTemp[nJ] )
                        If !Empty( cCleanCod ) .And. aScan( aRevenueCodes, {|x| x == cCleanCod } ) == 0
                            AAdd( aRevenueCodes, cCleanCod )
                        EndIf
                    Next nJ
                EndIf

                ( cAliasQry )->( DbSkip() )
            EndDo

            // ========================================================================
            // Despacha as regras de negocio de forma isolada
            // estritamente pelas receitas do proprio CPF (aRevenueCodes)
            // ========================================================================
            If Len( aRevenueCodes ) > 0

                For nX := 1 To Len( aRevenueCodes )
                    cCodRec := AllTrim( aRevenueCodes[nX] )

                    For nO := 1 To Len( aOrigens )
                        cOrigem := aOrigens[nO]
                        TAFFormCod( cLastCPF, cLastNome, cOrigem, @aForms, aFils, cPeriodo, cCodRec, jBuckets, aRevenueCodes, jFormIdx, lIsLegacy )
                    Next nO
                Next nX

            Else

                // Empregado sem codigo de receita (Ex: apenas Plano de Saude ou Reembolso)
                For nO := 1 To Len( aOrigens )
                    cOrigem := aOrigens[nO]
                    TAFFormCod( cLastCPF, cLastNome, cOrigem, @aForms, aFils, cPeriodo, "", jBuckets, aRevenueCodes, jFormIdx, lIsLegacy )
                Next nO

            EndIf

            FreeBucketTree( jBuckets )

            // Controle da barra de progresso
            nProcessed++
            nPercent := BAR_COD_END + Round( ( nProcessed / nTotalCpfs ) * ( BAR_FORM_END - BAR_COD_END ), 0 )

            If nPercent <= BAR_FORM_END .And. !Empty( cTicket ) .And. Int( nPercent ) > Int( nLastPerc )
                setProgress( cTicket, nPercent, 100, .T., nPercent )
                nLastPerc := nPercent
                Sleep( 10 )
            EndIf

        EndDo    

    EndIf

    If !Empty( cAliasQry ) .And. Select( cAliasQry ) > 0
        ( cAliasQry )->( DbCloseArea() )
    EndIf

    //-------------------------------------------------------------------------
    // Limpeza de memória
    //-------------------------------------------------------------------------
    If oStmt != Nil
        oStmt:Destroy()
        oStmt := Nil
    EndIf

    FreeObj( jFormIdx )
    jFormIdx := Nil

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} GetPercent
Consulta o percentual de processamento da requisição na tabela V3J.

@type    function
@author  Felipe C. Seolin / Denis R. de Oliveira
@since   30/08/2019
@version 1.0

@param   jResponse,  Json,      Objeto JSON de retorno (Referência).
@param   cRequestID, Character, Identificador da Requisição.
@return  Nil
/*/
//---------------------------------------------------------------------
Function GetPercent( jResponse as Json, cRequestID as Character )

    Static nTamIdV3J as Numeric
    
    Default jResponse   := JsonObject():New()
    Default cRequestID  := ""

    // Defaults para nunca devolver JSON sem percent/finished
    jResponse["percent"]   := 0
    jResponse["finished"]  := .F.

    DBSelectArea( "V3J" )
    V3J->( DBSetOrder( 1 ) )

    nTamIdV3J := GetSX3Cache( "V3J_ID", "X3_TAMANHO" )

    If V3J->( DBSeek( xFilial( "V3J" ) + PadR( cRequestID, nTamIdV3J ) ) )

        jResponse["percent"] := V3J->V3J_PERC

            If V3J->V3J_STATUS == "2"
                jResponse["finished"] := .T.
                jResponse["percent"]  := 100
            Else
                jResponse["finished"] := .F.
            EndIf

    EndIf

    TAFConOut( ProcName() + " " + jResponse:ToJson() + ' ' +  V3J->V3J_STATUS + ' ' + cValToChar(V3J->V3J_PERC) )

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} setProgress
@type           function
@description    Atualiza o percentual de processamento na tabela V3J.

@author         Robson Santos / Denis R. de Oliveira
@since          04/02/2026
@version        1.0

@param          cTicket,   Character, ID da Requisição.
@param          nItem,     Numeric,   Item atual (progresso).
@param          nQtdRegs,  Numeric,   Total de itens para cálculo.
@param          lPercRH,   Logical,   Flag para uso de percentual direto do RH.
@param          nPercRH,   Numeric,   Valor do percentual vindo da API.
@param          lIsLegacy, Logical,   Indica modo de compatibilidade legado.

@return         Logical, .T. se atualizou com sucesso.
/*/
//---------------------------------------------------------------------
Function setProgress( cTicket as Character, nItem as Numeric, nQtdRegs as Numeric, lPercRH as Logical, nPercRH as Numeric, lIsLegacy as Logical )

    Local aArea     as Array
    Local lRet      as Logical
    Local nDif      as Numeric
    Local nPerc     as Numeric
    Local nPeso     as Numeric
    Local cKeySeek  as Character

    Default lIsLegacy := .F.
    Default lPercRH   := .F.
    Default nPercRH   := 0
    Default nItem     := 0
    Default nQtdRegs  := 0

    aArea := GetArea()
    lRet  := .F.
    nDif  := 0
    nPerc := 0
    nPeso := 50

    // Mantém o padrão do original e compatibilidade com GetPercent antigo / WSTAF010
    cKeySeek := xFilial( "V3J" ) + PadR( cTicket, TamSX3( "V3J_ID" )[1] )

    DBSelectArea( "V3J" )
    V3J->( DBSetOrder( 1 ) )

    If V3J->( MsSeek( cKeySeek ) )

        If !lPercRH

            // Evita divisão por zero
            If nQtdRegs > 0
                // Calcula proporcionalidade baseada no peso (50%)
                nPerc := ( Int( ( nItem / nQtdRegs ) * 100 ) * ( nPeso / 100 ) )
            Else
                nPerc := 0
            EndIf

            If lIsLegacy
                nDif := ( ( V3J->V3J_PERC + nPerc ) - V3J->V3J_PERC )
            Else
                nDif := ( nPerc - V3J->V3J_PERC )
            EndIf

        Else
            nPerc := nPercRH
        EndIf

        If nPerc > 0

            If !lPercRH
                If V3J->V3J_PERC >= nPeso
                    nPerc := ( nPeso + nPerc )
                Else
                    nPerc := ( V3J->V3J_PERC + nDif )
                EndIf
            EndIf

            If nPerc > 100
                nPerc := 100
            EndIf

            // Só faz Lock se o valor novo for maior que o gravado
            If Int(nPerc) > V3J->V3J_PERC
                
                If RecLock( "V3J", .F. )

                    // Grava o percentual calculado
                    V3J->V3J_PERC := Int( nPerc )
                    If nPerc == 100
                        V3J->V3J_STATUS := "2"
                    EndIf 

                    V3J->( MsUnlock() )

                EndIf

            EndIf

        EndIf

        lRet := .T.

    EndIf

    RestArea( aArea )

Return lRet

//-------------------------------------------------------------------
/*/{Protheus.doc} FilMatriz
@type           function
@description    Retorna todas as filiais associadas à matriz logada ou grupo de empresas.
@author         Alexandre de Lima
@since          24/11/2025
@return         aFiliais (Array) - Lista de filiais.
/*/
//-------------------------------------------------------------------
Function FilMatriz()

    Local aFiliais := {}

    C1E->(DBSetOrder(3)) // Filial + ID
    
    If C1E->(MsSeek(xFilial("C1E") + PadR(cFilAnt, GetSX3Cache("C1E_FILTAF", "X3_TAMANHO")) + "1"))

        If C1E->C1E_MATRIZ
            aFiliais := LoadSM0BaseCNPJ()
        EndIf

    EndIf

    If Empty(aFiliais)
        aAdd(aFiliais, cFilAnt)
    EndIf

Return aFiliais

//---------------------------------------------------------------------
/*/{Protheus.doc} LoadSM0BaseCNPJ
@type           function
@description    Busca as Filiais com a mesma Raiz de CNPJ da filial logada.
@author         Alexandre de Lima
@since          24/11/2025
@return         aFilial (Array) - Lista de códigos de filiais.
/*/
//---------------------------------------------------------------------
Function LoadSM0BaseCNPJ()

    Local aFilial   := {}
    Local aSM0      := FWLoadSM0( .T.,,.T. )
    Local cBaseCNPJ := Left( AllTrim( Posicione( "SM0", 1, cEmpAnt + cFilAnt, "M0_CGC" ) ), 8 )
    Local nI        := 0

    For nI := 1 to Len( aSM0 )

        If cBaseCNPJ == AllTrim( Left( aSM0[nI][SM0_CGC], 8 ) )

            aAdd( aFilial, aSM0[nI][SM0_CODFIL] )

        EndIf

    Next nI

Return( aFilial )

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFCodTotais
@description    Processa o resultado da query de totais e preenche o array analítico.
@author         Alexandre de Lima Santos.
@since          28/10/2025
@param          cAliasQry (Char)        - Alias da query aberta.
@param          aAnalitico (Ref Array)  - Array onde os dados serão armazenados.
/*/
//---------------------------------------------------------------------
Function TAFCodTotais( cAliasQry as Character, aAnalitico as Array )

    Local aCodRec     as Array
    Local cCodRec     as Character
    Local nPosValores as Numeric
    Local nX          as Numeric
    Local nPos        as Numeric

    Default aAnalitico  := {}

    aCodRec     := {}
    cCodRec     := ""
    nPosValores := 0
    nX          := 0

    ( cAliasQry )->( DbGoTop() )

    While !(cAliasQry)->(EoF())

        If ( cAliasQry )->T8R_ORIGEM == "1" // TAF (Origem 1)

            aCodRec := StrTokArr( ( cAliasQry )->T8R_CODREC, "|" )

            For nX := 1 to Len( aCodRec )

                cCodRec := Alltrim(aCodRec[nX])

                If !Empty( cCodRec )

                    nPos := aScan(aAnalitico, {|x| AllTrim(Upper(x[1])) == cCodRec })

                    If nPos > 0
                        nPosValores := nPos
                    Else
                        aAdd(aAnalitico, Array(58))
                        nPosValores := Len(aAnalitico)
                        TAFInitArray( aAnalitico, nPosValores )
                    EndIf

                    aAnalitico[nPosValores][ANALITICO_CODRECEITA] := cCodRec

                    If cCodRec $ "056107|056108|056111|058806|061001|356201|188901|353301|188901"   
                        aAnalitico[nPosValores][ANALITICO_VLRRENDTRIB]  += ( cAliasQry )->VLRTRI
                    EndIf

                    If cCodRec $ "056107|056109|056110|056112|056113|058806|353301"   
                        aAnalitico[nPosValores][ANALITICO_VLRRENDTRIB13] += ( cAliasQry )->VRTR13
                        aAnalitico[nPosValores][ANALITICO_VLRPREVOFICIAL13] += ( cAliasQry )->VPRE13
                    EndIf

                    If cCodRec $ "056107|056108|056111|058806|061001|188901|353301|188901"   
                        aAnalitico[nPosValores][ANALITICO_VLRPREVOFICIAL]   += ( cAliasQry )->VLRPRE
                    EndIf

                    If cCodRec $ "056107|056108|056111|058806|061001|356201|188901|353301|188901"   
                        aAnalitico[nPosValores][ANALITICO_VLRCRMEN]         += ( cAliasQry )->VLIRRF
                    EndIf

                    If cCodRec $ "056107|056109|056110|056112|056113|356201|058806|353301"   
                        aAnalitico[nPosValores][ANALITICO_VLRCRMEN13]       += ( cAliasQry )->IRRF13
                    EndIf

                    If cCodRec $ "188901|353301|188901"   
                        aAnalitico[nPosValores][ANALITICO_VLRPARC65]        += ( cAliasQry )->VLRISE
                    EndIf

                    If cCodRec == "353301"   
                        aAnalitico[nPosValores][ANALITICO_VLRPARC6513]      += ( cAliasQry )->VLRI13
                    EndIf

                    If  cCodRec $ "056107|056108|056111|058806"   
                        aAnalitico[nPosValores][ANALITICO_VLRDIARIAS]       += ( cAliasQry )->VLRDIA
                        aAnalitico[nPosValores][ANALITICO_VLRAJDCUSTO]      += ( cAliasQry )->VLRAJU
                        aAnalitico[nPosValores][ANALITICO_VLRINDRESCTR]     += ( cAliasQry )->VLRRSC
                        aAnalitico[nPosValores][ANALITICO_VLRABONOPEC]      += ( cAliasQry )->VLRABN
                        aAnalitico[nPosValores][ANALITICO_VLRAUXMOR]        += ( cAliasQry )->VLRAXM
                    EndIf

                    If  cCodRec $ "188901|353301"   
                        aAnalitico[nPosValores][ANALITICO_VLRRENMOLGRV]     += ( cAliasQry )->VLRMLG
                        aAnalitico[nPosValores][ANALITICO_VLRRENMOLGRV13]   += ( cAliasQry )->VMLG13
                    EndIf

                    If  cCodRec == "056107"   
                        aAnalitico[nPosValores][ANALITICO_VLRBOLMEDIC]      += ( cAliasQry )->VLBMED
                        aAnalitico[nPosValores][ANALITICO_VLRBOLMEDIC13]    += ( cAliasQry )->BMED13
                    EndIf

                    If cCodRec == "188901"
                        aAnalitico[nPosValores][ANALITICO_VLRJUROSMORA]     += ( cAliasQry )->VLRMOR
                    EndIf
                    
                    If  cCodRec $ "056107|056108|056111|058806|353301"   
                        aAnalitico[nPosValores][ANALITICO_VLRINSEOUTROS]    += ( cAliasQry )->VLRISO
                    EndIf

                EndIf

            Next nX

        Else // Governo/Retorno (Origem Diferente de 1)

            cCodRec := Alltrim(( cAliasQry )->T8R_CODREC)

            nPos := aScan(aAnalitico, {|x| AllTrim(Upper(x[1])) == cCodRec })

            If nPos > 0
                nPosValores := nPos
            Else
                aAdd(aAnalitico, Array(58))
                nPosValores := Len(aAnalitico)
                TAFInitArray( aAnalitico, nPosValores )
            EndIf

            aAnalitico[nPosValores][ANALITICO_CODRECEITA] := cCodRec

            If cCodRec $ "056107|056108|056111|058806|061001|356201|188901|353301|188901"   
                IIf(( cAliasQry )->T8R_ORIGEM == '3', aAnalitico[nPosValores][ANALITICO_VLRRENDTRIBGOV] := ( cAliasQry )->VLRTRI, aAnalitico[nPosValores][ANALITICO_VLRRENDTRIBFOLHA]   := ( cAliasQry )->VLRTRI )
            EndIf

            If cCodRec $ "056107|056109|056110|056112|056113|058806|353301"   
            
                If ( cAliasQry )->T8R_ORIGEM == '3'
                    aAnalitico[nPosValores][ANALITICO_VLRRENDTRIB13GOV]     := ( cAliasQry )->VRTR13
                    aAnalitico[nPosValores][ANALITICO_VLRPREVOFICIAL13GOV]  := ( cAliasQry )->VPRE13
                Else
                    aAnalitico[nPosValores][ANALITICO_VLRRENDTRIB13FOLHA]     := ( cAliasQry )->VRTR13
                    aAnalitico[nPosValores][ANALITICO_VLRPREVOFICIAL13FOLHA]  := ( cAliasQry )->VPRE13
                EndIf

            EndIf

            If cCodRec $ "056107|056108|056111|058806|061001|188901|353301|188901"   
                IIf(( cAliasQry )->T8R_ORIGEM == '3', aAnalitico[nPosValores][ANALITICO_VLRPREVOFICIALGOV] := ( cAliasQry )->VLRPRE, aAnalitico[nPosValores][ANALITICO_VLRPREVOFICIALFOLHA]    := ( cAliasQry )->VLRPRE )
            EndIf

            If cCodRec $ "056107|056108|056111|058806|061001|356201|188901|353301|188901"   
                IIf(( cAliasQry )->T8R_ORIGEM == '3', aAnalitico[nPosValores][ANALITICO_VLRCRMENGOV] := ( cAliasQry )->VLIRRF, aAnalitico[nPosValores][ANALITICO_VLRCRMENFOLHA] := ( cAliasQry )->VLIRRF )
            EndIf

            If cCodRec $ "056107|056109|056110|056112|056113|356201|058806|353301"   
                IIf(( cAliasQry )->T8R_ORIGEM == '3', aAnalitico[nPosValores][ANALITICO_VLRCRMEN13GOV] := ( cAliasQry )->IRRF13, aAnalitico[nPosValores][ANALITICO_VLRCRMEN13FOLHA]:= ( cAliasQry )->IRRF13 )
            EndIf

            If cCodRec $ "188901|353301|188901"   
                IIf(( cAliasQry )->T8R_ORIGEM == '3', aAnalitico[nPosValores][ANALITICO_VLRPARC65GOV] := ( cAliasQry )->VLRISE, aAnalitico[nPosValores][ANALITICO_VLRPARC65FOLHA] := ( cAliasQry )->VLRISE )
            EndIf

            If cCodRec == "353301"   
                IIf(( cAliasQry )->T8R_ORIGEM == '3', aAnalitico[nPosValores][ANALITICO_VLRPARC6513GOV] := ( cAliasQry )->VLRI13, aAnalitico[nPosValores][ANALITICO_VLRPARC6513FOLHA] := ( cAliasQry )->VLRI13 )
            EndIf

            If  cCodRec $ "056107|056108|056111|058806"   
                
                If ( cAliasQry )->T8R_ORIGEM == '3'
                    aAnalitico[nPosValores][ANALITICO_VLRDIARIASGOV]    := ( cAliasQry )->VLRDIA
                    aAnalitico[nPosValores][ANALITICO_VLRAJDCUSTOGOV]   := ( cAliasQry )->VLRAJU
                    aAnalitico[nPosValores][ANALITICO_VLRINDRESCTRGOV]  := ( cAliasQry )->VLRRSC
                    aAnalitico[nPosValores][ANALITICO_VLRABONOPECGOV]   := ( cAliasQry )->VLRABN
                    aAnalitico[nPosValores][ANALITICO_VLRAUXMORGOV]     := ( cAliasQry )->VLRAXM
                Else
                    aAnalitico[nPosValores][ANALITICO_VLRDIARIASFOLHA]    := ( cAliasQry )->VLRDIA
                    aAnalitico[nPosValores][ANALITICO_VLRAJDCUSTOFOLHA]   := ( cAliasQry )->VLRAJU
                    aAnalitico[nPosValores][ANALITICO_VLRINDRESCTRFOLHA]  := ( cAliasQry )->VLRRSC
                    aAnalitico[nPosValores][ANALITICO_VLRABONOPECFOLHA]   := ( cAliasQry )->VLRABN
                    aAnalitico[nPosValores][ANALITICO_VLRAUXMORFOLHA]     := ( cAliasQry )->VLRAXM
                EndIf

            EndIf

            If  cCodRec $ "188901|353301"  

                If ( cAliasQry )->T8R_ORIGEM == '3'

                    aAnalitico[nPosValores][ANALITICO_VLRRENMOLGRVGOV]      := ( cAliasQry )->VLRMLG
                    aAnalitico[nPosValores][ANALITICO_VLRRENMOLGRV13GOV]    := ( cAliasQry )->VMLG13

                Else

                    aAnalitico[nPosValores][ANALITICO_VLRRENMOLGRVFOLHA]      := ( cAliasQry )->VLRMLG
                    aAnalitico[nPosValores][ANALITICO_VLRRENMOLGRV13FOLHA]    := ( cAliasQry )->VMLG13

                EndIf

            EndIf

            If  cCodRec == "056107"   

                If ( cAliasQry )->T8R_ORIGEM == '3'

                    aAnalitico[nPosValores][ANALITICO_VLRBOLMEDICGOV]       := ( cAliasQry )->VLBMED
                    aAnalitico[nPosValores][ANALITICO_VLRBOLMEDIC13GOV]     := ( cAliasQry )->BMED13

                Else

                    aAnalitico[nPosValores][ANALITICO_VLRBOLMEDICFOLHA]       := ( cAliasQry )->VLBMED
                    aAnalitico[nPosValores][ANALITICO_VLRBOLMEDIC13FOLHA]     := ( cAliasQry )->BMED13

                EndIf
            EndIf

            If cCodRec == "188901"
                IIf( ( cAliasQry )->T8R_ORIGEM == '3', aAnalitico[nPosValores][ANALITICO_VLRJUROSMORAGOV] := ( cAliasQry )->VLRMOR, aAnalitico[nPosValores][ANALITICO_VLRJUROSMORAFOLHA] := ( cAliasQry )->VLRMOR )
            EndIf
            
            If  cCodRec $ "056107|056108|056111|058806|353301"   
                IIf( ( cAliasQry )->T8R_ORIGEM == '3', aAnalitico[nPosValores][ANALITICO_VLRINSEOUTROSGOV] := ( cAliasQry )->VLRISO, aAnalitico[nPosValores][ANALITICO_VLRINSEOUTROSFOLHA] := ( cAliasQry )->VLRISO )
            EndIf

        EndIf

        (cAliasQry)->(DbSkip())

    EndDo

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFCodIRRF
@type           Function
@description    Processa os detalhes analíticos de IRRF por empregado.
                Itera sobre o alias fornecido, agrupa os valores por Código de Receita e CPF,
                populando o array de retorno.
                Realiza a atualização da barra de progresso (V3J)

@author         Alexandre de Lima Santos / Denis R. de Oliveira
@since          28/10/2025
@version        1.0

@param          cAliasQry,   Character, Alias da query.
@param          aEmployeCod, Array,     Array de retorno.
@param          cTicket,     Character, Ticket para progresso.

@return         aEmployeCod, Array,     Array atualizado.
/*/
//---------------------------------------------------------------------
Function TAFCodIRRF( cAliasQry as Character, aEmployeCod as Array, cTicket as Character )

    Local aCodRec       as Array
    Local cCodRec       as Character
    Local nPosValores   as Numeric
    Local nX            as Numeric

    Local jIdx          as Json
    Local cKey          as Character

    Local nProc         as Numeric
    Local nTot          as Numeric
    Local nStep         as Numeric

    Default aEmployeCod := {}
    Default cAliasQry   := ""
    Default cTicket     := ""

    aCodRec     := {}
    cCodRec     := ""
    nPosValores := 0
    nX          := 0

    jIdx        := JsonObject():New()
    cKey        := ""

    nProc       := 0
    nTot        := 0
    nStep       := 100

    //-------------------------------------------------------------------------
    // Cálculo do Total para Barra de Progresso
    //-------------------------------------------------------------------------
    // 1. Tentativa Otimizada (O(1)): Metadados do Driver
    nTot := ( cAliasQry )->( RecCount() )

    // 2. Fallback Seguro: Se o driver não retornou total
    // utiliza contagem manual nativa (Count To)
    If nTot <= 0
        ( cAliasQry )->( DbGoTop() )
        nTot := 0
        
        // Atualiza barra durante contagem
        While ( cAliasQry )->( !Eof() )
            nTot++
            ( cAliasQry )->( DbSkip() )
        EndDo
        ( cAliasQry )->( DbGoTop() )
    EndIf

    // Sinaliza início (21%)
    setProgress( cTicket, BAR_COD_LOOP_START, 100, .T., BAR_COD_LOOP_START )

    // Garante posicionamento no topo
    ( cAliasQry )->( DbGoTop() )

    //-------------------------------------------------------------------------
    // Loop de Processamento
    //-------------------------------------------------------------------------
    While !( cAliasQry )->( EoF() )

        If ( cAliasQry )->ORIGEM == "1" // Origem TAF

            // Trata códigos de receita múltiplos (separados por pipe)
            aCodRec := StrTokArr( ( cAliasQry )->T8R_CODREC, "|" )

            For nX := 1 to Len( aCodRec )

                cCodRec := AllTrim( aCodRec[nX] )

                If !Empty( cCodRec )

                    // Chave única composta: CODREC + CPF
                    cKey := Upper( AllTrim( cCodRec ) ) + "|" + AllTrim( ( cAliasQry )->CPF )

                    // Busca posição no Hash Map (Json)
                    If jIdx:HasProperty( cKey )
                        nPosValores := jIdx[ cKey ]
                    Else
                        // Novo registro: Inicializa array e adiciona ao índice
                        aAdd( aEmployeCod, Array(6) )
                        nPosValores := Len( aEmployeCod )
                        TafIniIRRF( aEmployeCod, nPosValores )

                        jIdx[ cKey ] := nPosValores
                    EndIf

                    // Preenchimento dos dados
                    aEmployeCod[nPosValores][CODRECEITA_CODRECEITA] := cCodRec
                    aEmployeCod[nPosValores][CODRECEITA_NOME]       := ( cAliasQry )->NOME
                    aEmployeCod[nPosValores][CODRECEITA_CPF]        := ( cAliasQry )->CPF

                    // Acumula valores se o código estiver na lista de permitidos
                    If cCodRec $ "056107|056108|056111|058806|061001|356201|188901|353301|188901"   
                        aEmployeCod[nPosValores][CODRECEITA_VLRIRRF] += ( cAliasQry )->VLIRRF
                    EndIf

                EndIf

            Next nX

        Else // Outras Origens (2=Folha, 3=Governo)

            cCodRec := AllTrim( ( cAliasQry )->T8R_CODREC )

            cKey := Upper( AllTrim( cCodRec ) ) + "|" + AllTrim( ( cAliasQry )->CPF )

            If jIdx:HasProperty( cKey )
                nPosValores := jIdx[ cKey ]
            Else
                aAdd( aEmployeCod, Array(6) )
                nPosValores := Len( aEmployeCod )
                TafIniIRRF( aEmployeCod, nPosValores )

                jIdx[ cKey ] := nPosValores
            EndIf

            aEmployeCod[nPosValores][CODRECEITA_CODRECEITA] := cCodRec
            aEmployeCod[nPosValores][CODRECEITA_NOME]       := ( cAliasQry )->NOME
            aEmployeCod[nPosValores][CODRECEITA_CPF]        := ( cAliasQry )->CPF

            If cCodRec $ "056107|056108|056111|058806|061001|356201|188901|353301|188901"
                
                IIf( ( cAliasQry )->ORIGEM == "2",;
                     aEmployeCod[nPosValores][CODRECEITA_VLRIRRFFOLHA] += ( cAliasQry )->VLIRRF,;
                     aEmployeCod[nPosValores][CODRECEITA_VLRIRRFGOV]   += ( cAliasQry )->VLIRRF )
                
            EndIf

        EndIf

        //---------------------------------------------------------------------
        // Atualização de Progresso (Throttling)
        // Faixa: 31% a 34% (7 pontos percentuais)
        //---------------------------------------------------------------------
        nProc++

        If !Empty( cTicket ) .And. ( Mod( nProc, nStep ) == 0 .Or. nProc == nTot )
            // Calcula percentual proporcional: 21 + (nProc / nTot) * 7
            setProgress( cTicket, BAR_COD_LOOP_START + Round( ( nProc / nTot ) * ( BAR_COD_LOOP_END - BAR_COD_LOOP_START ), 0 ), 100, .T., ;
                                  BAR_COD_LOOP_START + Round( ( nProc / nTot ) * ( BAR_COD_LOOP_END - BAR_COD_LOOP_START ), 0 ) )
        EndIf

        ( cAliasQry )->( DbSkip() )

    EndDo

    // Garante 28% ao finalizar
    setProgress( cTicket, BAR_COD_LOOP_END, 100, .T., BAR_COD_LOOP_END )

    //-------------------------------------------------------------------------
    // Limpeza de Memória
    //-------------------------------------------------------------------------
    FreeObj( jIdx )
    jIdx := Nil


Return aEmployeCod

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFInitArray
@type           Static Function
@description    Inicializa o array de analítico com valores zerados.
@author         Alexandre de Lima Santos.
@since          28/10/2025
@param          aAnalitico (Ref Array) - Array a ser inicializado.
@param          nPosValores (Num)      - Posição a ser inicializada.
/*/
//---------------------------------------------------------------------
Static Function TAFInitArray( aAnalitico as Array, nPosValores as Numeric )

    Local nI as Numeric
    
    Default aAnalitico  := {}
    Default nPosValores := 0

    // Loop para inicializar do índice 2 ao 39
    aAnalitico[nPosValores][1]  := ""

    For nI := 2 to 58
        aAnalitico[nPosValores][nI] := 0
    Next nI

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} TafIniIRRF
@type           Function
@description    Inicializa o array de IRRF por empregado.
@author         Alexandre de Lima Santos.
@since          28/10/2025
@param          aAnalitico (Ref Array) - Array a ser inicializado.
@param          nPosValores (Num)      - Posição a ser inicializada.
/*/
//---------------------------------------------------------------------
Function TafIniIRRF( aAnalitico as Array, nPosValores as Numeric )

    Default aAnalitico  := {}
    Default nPosValores := 0

    aAnalitico[nPosValores][1]  := ""
    aAnalitico[nPosValores][2]  := ""
    aAnalitico[nPosValores][3]  := ""
    aAnalitico[nPosValores][4]  := 0
    aAnalitico[nPosValores][5]  := 0
    aAnalitico[nPosValores][6]  := 0

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} tafGeraTic
@type           function
@description    Cria e armazena o ticket para a requisição na tabela V3J.
@author         Robson Santos
@since          05/09/2019
@param          jRequest, Json,      Objeto da requisição.
@param          cBody,    Character, Corpo da requisição com os parâmetros.
@param          cTribute, Character, Código do tipo de tributo.
@return         Character, ID gerado.
/*/
//---------------------------------------------------------------------
Function tafGeraTic( jRequest as Json, cBody as Character, cTribute as character ) as Character

    Local cServ     As Character
    Local cTicket   As Character
    Local oModelV3J As Object
    
    Default jRequest := JsonObject():New()
    Default cBody    := ""
    Default cTribute := ""

    cServ     := ""
    cTicket   := FWuuId( "WSTAF010" )
    oModelV3J := FWLoadModel( "TAFA531" )

    // Mapeamento de serviços para Log
    If jRequest["tribute"] == "1"

        cServ := "reportEsocialBaseConfer/InssRetValues"
        APILogAccess("ReportEsocialBaseConfer", "INSS")

    ElseIf jRequest["tribute"] == "2"

        cServ := "reportEsocialBaseConfer/FgtsValues"
        APILogAccess("ReportEsocialBaseConfer", "FGTS")

    ElseIf jRequest["tribute"] == "3"

        cServ := "reportEsocialBaseConfer/IrrfRetValues"
        APILogAccess("ReportEsocialBaseConfer", "IRRF")

    ElseIf cTribute == "4"

        cServ := "/api/rh/esocial/v1/reportEsocialIrrfRevenueCodes/totalizers"
        APILogAccess("ReportEsocialBaseConfer", "IRRF")

    EndIf

    oModelV3J:SetOperation( MODEL_OPERATION_INSERT )
    oModelV3J:Activate()
    oModelV3J:LoadValue( "MODEL_V3J", "V3J_ID"      , cTicket                       )
    oModelV3J:LoadValue( "MODEL_V3J", "V3J_SERVIC"  , cServ                         )
    oModelV3J:LoadValue( "MODEL_V3J", "V3J_METODO"  , "POST"                        )
    oModelV3J:LoadValue( "MODEL_V3J", "V3J_DTREQ"   , Date()                        )
    oModelV3J:LoadValue( "MODEL_V3J", "V3J_HRREQ"   , StrTran( Time(), ":", "" )    )
    oModelV3J:LoadValue( "MODEL_V3J", "V3J_STATUS"  , "1"                           )
    oModelV3J:LoadValue( "MODEL_V3J", "V3J_PARAMS"  , cBody                         )

    FWFormCommit( oModelV3J )

    oModelV3J:DeActivate()
    oModelV3J:Destroy()

Return cTicket

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFFormCod
@type           Function
@description    Processa os registros em memória (jBuckets) para montar a estrutura
                de formulários do JSON (aForms), operando com algoritmos O(1).

@author         Alexandre de Lima Santos / Denis R. de Oliveira
@since          03/12/2025
@version        1.0

@param          cCpf, Character, CPF do trabalhador processado.
@param          cNome, Character, Nome do trabalhador.
@param          cOrigem, Character, Origem do processamento (1=TAF, 2=Folha, 3=Gov).
@param          aForms, Array, Array de formulários a ser populado (passado por referência).
@param          aFils, Array, Lista de filiais processadas.
@param          cPeriodo, Character, Período de apuração da DIRF/IRRF.
@param          cCodRec, Character, Código da receita a ser pesquisado.
@param          jBuckets, Json, Cache de registros do T8R em memória para acesso O(1).
@param          aRevenueCodes, Array, Cache em memória dos RevenueCodes do CPF processado.
@param          jFormIdx, Json, Índice em Hash Map (CPF|CodRec) -> Posição no array aForms.
@param          lIsLegacy, Logical, Flag de processamento legado.
@return         Nil
/*/
//-----------------------------------------------------------------------------
Function TAFFormCod( cCpf As Character, cNome As Character, cOrigem As Character, aForms As Array, aFils As Array, cPeriodo As Character, cCodRec As Character, jBuckets As Json, aRevenueCodes As Array, jFormIdx As Json, lIsLegacy As Logical )
    
    //-------------------------------------------------------------------------
    // Declaração de Variáveis
    //-------------------------------------------------------------------------
    Local aPlan01     As Array 
    Local aPlan02     As Array 
    Local aPlan03     As Array 
    Local aPlan04     As Array 
    Local aPlan05     As Array 
    Local aPlan06     As Array

    Local cKeyForm    As Character
    
    Local lNewForm    As Logical
    Local lProcess    As Logical
    
    Local nPosValores As Numeric

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default cCpf          := ""
    Default cNome         := ""
    Default cOrigem       := ""
    Default aForms        := {}
    Default aFils         := {}
    Default cPeriodo      := ""
    Default cCodRec       := ""
    Default jBuckets      := Nil
    Default aRevenueCodes := {}
    Default jFormIdx      := Nil
    Default lIsLegacy     := .F.

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    aPlan01     := {}
    aPlan02     := {}
    aPlan03     := {}
    aPlan04     := {}
    aPlan05     := {}
    aPlan06     := {}

    cKeyForm    := ""
    lNewForm    := .F.
    lProcess    := .F.
    nPosValores := 0

    //-------------------------------------------------------------------------
    // 1. Controle de Índice do Formulário via Hash Map (O(1))
    //-------------------------------------------------------------------------
    cKeyForm := "CPF_" + AllTrim( cCpf ) + "|REC_" + AllTrim( cCodRec )

    If jFormIdx:HasProperty( cKeyForm )
        nPosValores := jFormIdx[ cKeyForm ]
        lNewForm    := .F.
    Else
        AAdd( aForms, Array(23) )
        nPosValores := Len( aForms )
        TAFIniFormDirf( @aForms, nPosValores )

        jFormIdx[ cKeyForm ] := nPosValores
        lNewForm             := .T.
    EndIf

    aForms[nPosValores][FORM_PERIODO]       := cPeriodo
    aForms[nPosValores][FORM_NOME]          := cNome
    aForms[nPosValores][FORM_CPF]           := cCpf
    aForms[nPosValores][FORM_REVENUECODE]   := AllTrim( cCodRec )

    // Valida e Popula Lista de Códigos de Receita
    If Empty( aForms[nPosValores][FORM_REVENUESCODES] )
        If !Empty( aRevenueCodes )
            aForms[nPosValores][FORM_REVENUESCODES] := aRevenueCodes
        Else
            aForms[nPosValores][FORM_REVENUESCODES] := TAFCodesDirf( cCpf, cPeriodo, aFils )
        EndIf
    EndIf

    //-------------------------------------------------------------------------
    // 2. Extração Geral (Somente em Formulários Novos)
    //-------------------------------------------------------------------------
    If Empty( aForms[nPosValores][FORM_PLSAUDE] ) .Or. Empty( aForms[nPosValores][FORM_CONSOLID] )

        If lNewForm
            // Origem 1 (TAF)
            TAFNoRecDirf( jBuckets, cCpf, cPeriodo, "PLASAU", '1', @aPlan01, lIsLegacy )
            TAFNoRecDirf( jBuckets, cCpf, cPeriodo, "DEPSAU", '1', @aPlan02, lIsLegacy )
            TAFNoRecDirf( jBuckets, cCpf, cPeriodo, "REMMED", '1', @aPlan03, lIsLegacy )
            TAFNoRecDirf( jBuckets, cCpf, cPeriodo, "REMTID", '1', @aPlan04, lIsLegacy )
            TAFNoRecDirf( jBuckets, cCpf, cPeriodo, "REMDEP", '1', @aPlan05, lIsLegacy )
            TAFNoRecDirf( jBuckets, cCpf, cPeriodo, "DETDEP", '1', @aPlan06, lIsLegacy )

            // Origem 2 (Folha)
            TAFNoRecDirf( jBuckets, cCpf, cPeriodo, "PLASAU", '2', @aPlan01, lIsLegacy )
            TAFNoRecDirf( jBuckets, cCpf, cPeriodo, "DEPSAU", '2', @aPlan02, lIsLegacy )
            TAFNoRecDirf( jBuckets, cCpf, cPeriodo, "REMMED", '2', @aPlan03, lIsLegacy )
            TAFNoRecDirf( jBuckets, cCpf, cPeriodo, "REMTID", '2', @aPlan04, lIsLegacy )
            TAFNoRecDirf( jBuckets, cCpf, cPeriodo, "REMDEP", '2', @aPlan05, lIsLegacy )
            TAFNoRecDirf( jBuckets, cCpf, cPeriodo, "DETDEP", '2', @aPlan06, lIsLegacy )

            // Origem 3 (Governo)
            TAFNoRecDirf( jBuckets, cCpf, cPeriodo, "PLASAU", '3', @aPlan01, lIsLegacy )
            TAFNoRecDirf( jBuckets, cCpf, cPeriodo, "DEPSAU", '3', @aPlan02, lIsLegacy )
            TAFNoRecDirf( jBuckets, cCpf, cPeriodo, "REMMED", '3', @aPlan03, lIsLegacy )
            TAFNoRecDirf( jBuckets, cCpf, cPeriodo, "REMTID", '3', @aPlan04, lIsLegacy )
            TAFNoRecDirf( jBuckets, cCpf, cPeriodo, "REMDEP", '3', @aPlan05, lIsLegacy )
            TAFNoRecDirf( jBuckets, cCpf, cPeriodo, "DETDEP", '3', @aPlan06, lIsLegacy )

            aForms[nPosValores][FORM_PLSAUDE]   := aPlan01
            aForms[nPosValores][FORM_PLSAUDE02] := aPlan02
            aForms[nPosValores][FORM_REBMED]    := aPlan03
            aForms[nPosValores][FORM_REBMED02]  := aPlan04
            aForms[nPosValores][FORM_REBMED03]  := aPlan05
            aForms[nPosValores][FORM_REBMED04]  := aPlan06

            // Consolidação Direta com a Memória (Bucket)
            aForms[nPosValores][FORM_CONSOLID] := TAFLidDirf( jBuckets, cCodRec, cCpf, cPeriodo, "TRIBUT", '1', @aForms[nPosValores][FORM_CONSOLID], lIsLegacy )
            aForms[nPosValores][FORM_CONSOLID] := TAFLidDirf( jBuckets, cCodRec, cCpf, cPeriodo, "TRIBUT", '2', @aForms[nPosValores][FORM_CONSOLID], lIsLegacy )
            aForms[nPosValores][FORM_CONSOLID] := TAFLidDirf( jBuckets, cCodRec, cCpf, cPeriodo, "TRIBUT", '3', @aForms[nPosValores][FORM_CONSOLID], lIsLegacy )
        EndIf

    EndIf

    //-------------------------------------------------------------------------
    // 3. Extração por Origem Específica (Processamento Detalhado)
    //-------------------------------------------------------------------------
    If AllTrim(cOrigem) $ "1|2|3"

        // Verifica qual Origem precisa de gravação
        If cOrigem == "1" .And. aForms[nPosValores][FORM_TAFPROCESS]
            lProcess := .T.
        ElseIf cOrigem == "2" .And. aForms[nPosValores][FORM_FOLHAPROCESS]
            lProcess := .T.
        ElseIf cOrigem == "3" .And. aForms[nPosValores][FORM_GOVPROCESS]
            lProcess := .T.
        EndIf

        If lProcess
            aForms[nPosValores][FORM_PERIODO] := cPeriodo
            aForms[nPosValores][FORM_NOME]    := cNome
            aForms[nPosValores][FORM_CPF]     := cCpf

            aForms[nPosValores][FORM_DEPDEDUCTION]   := TAFGridRecDirf( jBuckets, cCodRec, cCpf, cPeriodo, "DEDDEP", cOrigem, @aForms[nPosValores][FORM_DEPDEDUCTION],   lIsLegacy   )
            aForms[nPosValores][FORM_ALIMONY]        := TAFGridRecDirf( jBuckets, cCodRec, cCpf, cPeriodo, "PENALI", cOrigem, @aForms[nPosValores][FORM_ALIMONY],        lIsLegacy   )
            aForms[nPosValores][FORM_PRIVAPENSION]   := TAFGridRecDirf( jBuckets, cCodRec, cCpf, cPeriodo, "PREVCL", cOrigem, @aForms[nPosValores][FORM_PRIVAPENSION],   lIsLegacy   )
            aForms[nPosValores][FORM_LEGALPROCESS]   := TAFGridRecDirf( jBuckets, cCodRec, cCpf, cPeriodo, "PROCRE", cOrigem, @aForms[nPosValores][FORM_LEGALPROCESS],   lIsLegacy   )
            aForms[nPosValores][FORM_LEGALPROCESSA1] := TAFGridRecDirf( jBuckets, cCodRec, cCpf, cPeriodo, "PRCVAL", cOrigem, @aForms[nPosValores][FORM_LEGALPROCESSA1], lIsLegacy   )
            aForms[nPosValores][FORM_LEGALPROCESSA2] := TAFGridRecDirf( jBuckets, cCodRec, cCpf, cPeriodo, "PRCDED", cOrigem, @aForms[nPosValores][FORM_LEGALPROCESSA2], lIsLegacy   )
            aForms[nPosValores][FORM_LEGALPROCESSA3] := TAFGridRecDirf( jBuckets, cCodRec, cCpf, cPeriodo, "PRCBEN", cOrigem, @aForms[nPosValores][FORM_LEGALPROCESSA3], lIsLegacy   )
            
            // Avalia divergencias estruturais uma unica vez na construcao - Apenas na origem 3 pq o aforms estara completo
            If !aForms[nPosValores][23] .and. cOrigem == "3"
                aForms[nPosValores][23] := EvalFormDivergence( aForms[nPosValores] )
            EndIf
            
            // Aponta a gravação atual como concluída para evitar recálculos
            If cOrigem == "1"
                aForms[nPosValores][FORM_TAFPROCESS]   := .F.
            ElseIf cOrigem == "2"
                aForms[nPosValores][FORM_FOLHAPROCESS] := .F.
            Else
                aForms[nPosValores][FORM_GOVPROCESS]   := .F.
            EndIf

        EndIf

    EndIf

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFIniFormDirf
@type           Function
@description    Inicializa o array do formulário de empregados.
@author         Alexandre de Lima Santos.
@since          28/10/2025
@param          aForms (Ref Array)      - Array de formulários.
@param          nPosValores (Num)       - Posição a inicializar.
/*/
//---------------------------------------------------------------------
Function TAFIniFormDirf( aForms as Array, nPosValores as Numeric )

    Local nI as Numeric

    Default aForms      := {}
    Default nPosValores := 0

    // Campos Texto
    For nI := 1 to 3
        aForms[nPosValores][nI] := ""
    Next nI

    aForms[nPosValores][5] := ""

    // Campos Array
    aForms[nPosValores][4] := {}

    For nI := 6 to 19
        aForms[nPosValores][nI] := {}
    Next nI

    // Flags de Controle
    aForms[nPosValores][20] := .T.
    aForms[nPosValores][21] := .T.
    aForms[nPosValores][22] := .T.
    aForms[nPosValores][23] := .F.

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFCodesDirf
@type           Function
@description    Busca lista distinta de Códigos de Receita para um CPF.
                Processa códigos compostos (separados por pipe) e garante unicidade.

@author         Alexandre de Lima Santos
@since          03/12/2025
@version        1.0

@param          cCpf,     Character, CPF do trabalhador.
@param          cPeriodo, Character, Período de apuração (AAAAMM).
@param          aFils,    Array,     Lista de filiais para filtro.

@return         aCode,    Array,     Lista de códigos de receita únicos encontrados.
/*/
//---------------------------------------------------------------------
Function TAFCodesDirf( cCpf As Character, cPeriodo As Character, aFils As Array )

    //-------------------------------------------------------------------------
    // Declaração de Variáveis
    //-------------------------------------------------------------------------
    Local aCode     As Array
    Local aCodRec   As Array
    Local cAliasQry As Character
    Local cCodRec   As Character            
    Local cQuery    As Character
    Local nPos      As Numeric
    Local nX        As Numeric
    Local oStmt     As Object

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default cCpf     := ""
    Default cPeriodo := ""
    Default aFils    := {} // Se não passado, assume vazio (tratado abaixo)

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    aCode     := {}
    aCodRec   := {}
    cAliasQry := GetNextAlias()
    cCodRec   := ""
    cQuery    := ""
    nPos      := 0
    nX        := 0
    oStmt     := Nil

    //-------------------------------------------------------------------------
    // Montagem e Execução da Query
    //-------------------------------------------------------------------------
    cQuery := " SELECT T8R_CODREC FROM " + RetSqlName( "T8R" ) + " T8R "
    cQuery += " WHERE T8R_FILIAL IN (?) " 
    cQuery += " AND T8R_PERAPU = ? "
    cQuery += " AND T8R_CPF = ? "
    cQuery += " AND T8R_ORIGEM IN ('1', '2') " // Apenas TAF e Folha (Governo não define receita base)
    cQuery += " AND T8R_CODREC <> '' "
    cQuery += " AND T8R.D_E_L_E_T_ = '' "
    cQuery += " GROUP BY T8R_CODREC "

    oStmt := FWExecStatement():New( ChangeQuery( cQuery ) )
    
    // Bind de Parâmetros
    oStmt:setIn( 1, aFils )
    oStmt:SetString( 2, cPeriodo )
    oStmt:SetString( 3, cCpf )
    
    cAliasQry := oStmt:OpenAlias()
    
    //-------------------------------------------------------------------------
    // Processamento dos Resultados
    //-------------------------------------------------------------------------
    ( cAliasQry )->( DbGoTop() )

    While ( cAliasQry )->( !Eof() )

        // Verifica se é código composto (ex: "0561|0588")
        If "|" $ ( cAliasQry )->T8R_CODREC 

            aCodRec := StrTokArr( AllTrim( ( cAliasQry )->T8R_CODREC ), "|" )

            If !Empty( aCodRec )

                For nX := 1 To Len( aCodRec )
                    
                    cCodRec := AllTrim( aCodRec[nX] )
                    
                    If !Empty( cCodRec )
                        nPos := aScan( aCode, {|x| AllTrim(x) == cCodRec } )

                        If nPos == 0
                            aAdd( aCode, cCodRec )   
                        EndIf   
                    EndIf

                Next nX

            EndIf

        Else

            cCodRec := AllTrim( ( cAliasQry )->T8R_CODREC )
            
            If !Empty( cCodRec )
                nPos := aScan( aCode, {|x| AllTrim(x) == cCodRec } )

                If nPos == 0
                    aAdd( aCode, cCodRec ) 
                EndIf
            EndIf
            
        EndIf
        
        ( cAliasQry )->( DbSkip() )

    EndDo

    ( cAliasQry )->( DbCloseArea() )

    //-------------------------------------------------------------------------
    // Limpeza de Memória
    //-------------------------------------------------------------------------
    If oStmt != Nil
        oStmt:Destroy()
        oStmt := Nil
    EndIf

Return aCode

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFGridRecDirf
@type           Function
@description    Busca dados detalhados (Deduções, Pensão, Processos) para preencher as grids.

@param          jBuckets,  Json,      Cache de dados do T8R (Substitui query).
@param          cCodRec,   Character, Código Receita.
@param          cCpf,      Character, CPF.
@param          cPeriodo,  Character, Período.
@param          cAba,      Character, Identificador da Aba (ex: DEDDEP, PENALI).
@param          cOrigem,   Character, Origem (1=TAF, 3=Gov).
@param          aInfos,    Array,     Array de informações acumulado (Referência).
@param          lIsLegacy, Logical,   Flag indicando uso da rotina legada.
@return         Array,     Array de informações atualizado.

@author         Alexandre de Lima Santos / Denis R. de Oliveira
@since          03/12/2025
@version        1.0
/*/
//---------------------------------------------------------------------
Function TAFGridRecDirf( jBuckets As Json, cCodRec as Character, cCpf as Character, cPeriodo as Character, cAba as Character, cOrigem as Character, aInfos as Array, lIsLegacy as logical )

    //-------------------------------------------------------------------------
    // Declaração de Variáveis
    //-------------------------------------------------------------------------
    Local aItems    as Array
    
    Local cFil      as Character
    Local cRelaco   as Character
    Local cForAba   as Character
    Local cRegAba   as Character
    Local cRegCod   as Character
    Local cRegCpf   as Character
    Local cRegDel   as Character
    Local cRegOri   as Character
    Local cRegPer   as Character
    Local cMask     as Character
    Local cSemKey   as Character

    Local jReg      as Json

    Local nFolha1   as Numeric
    Local nFolha2   as Numeric
    Local nFolha3   as Numeric
    Local nFolha4   as Numeric
    Local nFolha5   as Numeric
    Local nGov1     as Numeric
    Local nGov2     as Numeric
    Local nGov3     as Numeric
    Local nGov4     as Numeric
    Local nGov5     as Numeric
    Local nTaf1     as Numeric
    Local nTaf2     as Numeric
    Local nTaf3     as Numeric
    Local nTaf4     as Numeric
    Local nTaf5     as Numeric

    Local nX        as Numeric
    Local nPos      as Numeric

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default jBuckets  := Nil
    Default aInfos    := {}
    Default cCodRec   := ""
    Default cCpf      := ""
    Default cPeriodo  := ""
    Default cAba      := ""
    Default cOrigem   := ""
    Default lIsLegacy := .F.

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    aItems  := {}

    cFil    := ""
    cRelaco := ""
    cForAba := ""

    cRegAba := ""
    cRegCod := ""
    cRegCpf := ""
    cRegDel := ""
    cRegOri := ""
    cRegPer := ""
    cMask   := ""
    cSemKey := ""

    jReg    := Nil

    // Inicialização de variáveis numéricas
    nFolha1 := 0; nFolha2 := 0; nFolha3 := 0; nFolha4 := 0; nFolha5 := 0
    nGov1   := 0; nGov2   := 0; nGov3   := 0; nGov4   := 0; nGov5   := 0
    nTaf1   := 0; nTaf2   := 0; nTaf3   := 0; nTaf4   := 0; nTaf5   := 0

    nX      := 0
    nPos    := 0

    // Blindagem de Memória: AllTrim e Upper garantem o match independente do banco
    cOrigem := AllTrim( cOrigem )
    cAba    := AllTrim( Upper( cAba ) )
    cCodRec := AllTrim( cCodRec )
    cCpf    := AllTrim( cCpf )
    cPeriodo:= AllTrim( cPeriodo )

    //-------------------------------------------------------------------------
    // Processamento em Memória (Loop no Cache)
    //-------------------------------------------------------------------------
    If !( ValType( jBuckets ) $ "J|O" ) .Or. !jBuckets:HasProperty( cAba ) .Or. !jBuckets[cAba]:HasProperty( cOrigem )
        Return aInfos
    EndIf

    aItems := jBuckets[cAba][cOrigem] // Pega apenas o array reduzido
    
    For nX := 1 To Len( aItems )
        jReg    := aItems[nX]
        cRelaco := ""

        // Lê apenas os nós cruciais e ignora o resto rapidamente
        cRegOri := jReg["T8R_ORIGEM"]

        If ValType(cRegOri) != "C" .Or. AllTrim(cRegOri) != cOrigem
            Loop
        EndIf

        cRegAba := jReg["T8R_FORABA"]
        If ValType(cRegAba) != "C" .Or. AllTrim(Upper(cRegAba)) != cAba
            Loop
        EndIf

        cRegCod := AllTrim( IIf( ValType(jReg["T8R_CODREC"]) == "C", jReg["T8R_CODREC"], "" ) )
        
        // Se NÃO bater com o código atual E NÃO for vazio, então ignora (Loop)
        If !MatchCodRecDirf( cRegCod, cCodRec ) .And. !Empty( cRegCod )
            Loop
        EndIf
        
        cRegPer := Iif( ValType( jReg["T8R_PERAPU"] ) == "C", AllTrim( jReg["T8R_PERAPU"] ), "" )
        cRegCpf := Iif( ValType( jReg["T8R_CPF"   ] ) == "C", AllTrim( jReg["T8R_CPF"   ] ), "" )
        cRegDel := Iif( ValType( jReg["D_E_L_E_T_"] ) == "C", AllTrim( jReg["D_E_L_E_T_"] ), "" )

        If cRegPer == cPeriodo .And. cRegCpf == cCpf .And. Empty( cRegDel )

            cForAba := AllTrim(Upper(cRegAba))

            // Campos auxiliares (usados em abas específicas)
            cRelaco := Iif( ValType( jReg["T8R_RELACO"] ) == "C", jReg["T8R_RELACO"], "" )
            cFil    := Iif( ValType( jReg["T8R_FILIAL"] ) == "C", jReg["T8R_FILIAL"], "" )

            //-----------------------------------------------------------------
            // Bloco DEDDEP: Dedução de Dependentes
            //-----------------------------------------------------------------
            If cForAba == "DEDDEP"

                // Reset local por registro (evita “vazamento” se a chamada mudar no futuro)
                nTaf1   := 0
                nGov1   := 0
                nFolha1 := 0

                If cOrigem == '1'
                    cRelaco := Iif( ValType( jReg["T8R_RELACO"] ) == "C", jReg["T8R_RELACO"], "" )
                    cFil    := Iif( ValType( jReg["T8R_FILIAL"] ) == "C", jReg["T8R_FILIAL"], "" )
                    nTaf1   := Iif( ValType( jReg["T8R_VLRDED"] ) == "N", jReg["T8R_VLRDED"], 0 )
                ElseIf cOrigem == '2'
                    cRelaco := Iif( ValType( jReg["T8R_RELACO"] ) == "C", jReg["T8R_RELACO"], "" )
                    cFil    := Iif( ValType( jReg["T8R_FILIAL"] ) == "C", jReg["T8R_FILIAL"], "" )
                    nFolha1 := Iif( ValType( jReg["T8R_VLRDED"] ) == "N", jReg["T8R_VLRDED"], 0 )
                ElseIf cOrigem == '3'
                    nGov1   := Iif( ValType( jReg["T8R_VLRDED"] ) == "N", jReg["T8R_VLRDED"], 0 )
                EndIf

                nPos := aScan( aInfos, { |x| AllTrim( x[1] ) == AllTrim( Iif( ValType( jReg["T8R_TPREND"] ) == "C", jReg["T8R_TPREND"], "" ) ) .And. ;
                                             AllTrim( x[2] ) == AllTrim( Iif( ValType( jReg["T8R_CPFDEP"] ) == "C", jReg["T8R_CPFDEP"], "" ) ) } )

                If nPos > 0

                    If cOrigem == '1'
                        aInfos[nPos][3] := nTaf1
                        aInfos[nPos][6] := cRelaco
                        aInfos[nPos][7] := cFil
                    ElseIf cOrigem == '2'
                        aInfos[nPos][5] := nFolha1
                        aInfos[nPos][6] := cRelaco
                        aInfos[nPos][7] := cFil
                    ElseIf cOrigem == '3'
                        aInfos[nPos][4] := nGov1
                    EndIf

                Else
                    AADD( aInfos, { ;
                        Iif( ValType( jReg["T8R_TPREND"] ) == "C", jReg["T8R_TPREND"], "" ), ;
                        Iif( ValType( jReg["T8R_CPFDEP"] ) == "C", jReg["T8R_CPFDEP"], "" ), ;
                        nTaf1, nGov1, nFolha1, cRelaco, cFil, .T. ;
                    } )
                EndIf

            //-----------------------------------------------------------------
            // Bloco PENALI: Pensão Alimentícia
            //-----------------------------------------------------------------
            ElseIf cForAba == "PENALI"

                nTaf1   := 0
                nGov1   := 0
                nFolha1 := 0

                If cOrigem == '1'
                    cRelaco := Iif( ValType( jReg["T8R_RELACO"] ) == "C", jReg["T8R_RELACO"], "" )
                    cFil    := Iif( ValType( jReg["T8R_FILIAL"] ) == "C", jReg["T8R_FILIAL"], "" )
                    nTaf1   := Iif( ValType( jReg["T8R_VLRPAL"] ) == "N", jReg["T8R_VLRPAL"], 0 )
                ElseIf cOrigem == '2'
                    cRelaco := Iif( ValType( jReg["T8R_RELACO"] ) == "C", jReg["T8R_RELACO"], "" )
                    cFil    := Iif( ValType( jReg["T8R_FILIAL"] ) == "C", jReg["T8R_FILIAL"], "" )
                    nFolha1 := Iif( ValType( jReg["T8R_VLRPAL"] ) == "N", jReg["T8R_VLRPAL"], 0 )
                ElseIf cOrigem == '3'
                    nGov1   := Iif( ValType( jReg["T8R_VLRPAL"] ) == "N", jReg["T8R_VLRPAL"], 0 )
                EndIf

                nPos := aScan( aInfos, { |x| AllTrim( x[1] ) == AllTrim( Iif( ValType( jReg["T8R_TPRPAL"] ) == "C", jReg["T8R_TPRPAL"], "" ) ) .And. ;
                                             AllTrim( x[2] ) == AllTrim( Iif( ValType( jReg["T8R_CPFDPA"] ) == "C", jReg["T8R_CPFDPA"], "" ) ) } )

                If nPos > 0

                    If cOrigem == '1'
                        aInfos[nPos][3] := nTaf1
                        aInfos[nPos][6] := cRelaco
                        aInfos[nPos][7] := cFil
                    ElseIf cOrigem == '2'
                        aInfos[nPos][5] := nFolha1
                        aInfos[nPos][6] := cRelaco
                        aInfos[nPos][7] := cFil
                    ElseIf cOrigem == '3'
                        aInfos[nPos][4] := nGov1
                    EndIf

                Else
                    AADD( aInfos, { ;
                        Iif( ValType( jReg["T8R_TPRPAL"] ) == "C", jReg["T8R_TPRPAL"], "" ), ;
                        Iif( ValType( jReg["T8R_CPFDPA"] ) == "C", jReg["T8R_CPFDPA"], "" ), ;
                        nTaf1, nGov1, nFolha1, cRelaco, cFil, .T. ;
                    } )
                EndIf

            //-----------------------------------------------------------------
            // Bloco PREVCL: Previdência Complementar
            //-----------------------------------------------------------------
            ElseIf cForAba == "PREVCL"

                nTaf1 := 0; nTaf2 := 0; nTaf3 := 0; nTaf4 := 0
                nGov1 := 0; nGov2 := 0; nGov3 := 0; nGov4 := 0
                nFolha1 := 0; nFolha2 := 0; nFolha3 := 0; nFolha4 := 0

                If cOrigem == '1'
                    cRelaco := Iif( ValType( jReg["T8R_RELACO"] ) == "C", jReg["T8R_RELACO"], "" )
                    nTaf1   := Iif( ValType( jReg["T8R_VLDEPC"] ) == "N", jReg["T8R_VLDEPC"], 0 )
                    nTaf2   := Iif( ValType( jReg["T8R_VLPC13"] ) == "N", jReg["T8R_VLPC13"], 0 )
                    nTaf3   := Iif( ValType( jReg["T8R_VLPCSP"] ) == "N", jReg["T8R_VLPCSP"], 0 )
                    nTaf4   := Iif( ValType( jReg["T8R_PCVP13"] ) == "N", jReg["T8R_PCVP13"], 0 )
                ElseIf cOrigem == '2'
                    cRelaco := Iif( ValType( jReg["T8R_RELACO"] ) == "C", jReg["T8R_RELACO"], "" )
                    nFolha1 := Iif( ValType( jReg["T8R_VLDEPC"] ) == "N", jReg["T8R_VLDEPC"], 0 )
                    nFolha2 := Iif( ValType( jReg["T8R_VLPC13"] ) == "N", jReg["T8R_VLPC13"], 0 )
                    nFolha3 := Iif( ValType( jReg["T8R_VLPCSP"] ) == "N", jReg["T8R_VLPCSP"], 0 )
                    nFolha4 := Iif( ValType( jReg["T8R_PCVP13"] ) == "N", jReg["T8R_PCVP13"], 0 )
                ElseIf cOrigem == '3'
                    nGov1   := Iif( ValType( jReg["T8R_VLDEPC"] ) == "N", jReg["T8R_VLDEPC"], 0 )
                    nGov2   := Iif( ValType( jReg["T8R_VLPC13"] ) == "N", jReg["T8R_VLPC13"], 0 )
                    nGov3   := Iif( ValType( jReg["T8R_VLPCSP"] ) == "N", jReg["T8R_VLPCSP"], 0 )
                    nGov4   := Iif( ValType( jReg["T8R_PCVP13"] ) == "N", jReg["T8R_PCVP13"], 0 )
                EndIf

                nPos := aScan( aInfos, { |x| AllTrim( x[1] ) == AllTrim( Iif( ValType( jReg["T8R_TPPREV"] ) == "C", jReg["T8R_TPPREV"], "" ) ) .And. ;
                                             AllTrim( x[2] ) == AllTrim( Iif( ValType( jReg["T8R_CNPJPC"] ) == "C", jReg["T8R_CNPJPC"], "" ) ) } )

                If nPos > 0

                    If cOrigem == '1'
                        aInfos[nPos][3]  := nTaf1
                        aInfos[nPos][4]  := nTaf2
                        aInfos[nPos][5]  := nTaf3
                        aInfos[nPos][6]  := nTaf4
                        aInfos[nPos][15] := cRelaco
                    ElseIf cOrigem == '2'
                        aInfos[nPos][11] := nFolha1
                        aInfos[nPos][12] := nFolha2
                        aInfos[nPos][13] := nFolha3
                        aInfos[nPos][14] := nFolha4
                        aInfos[nPos][15] := cRelaco
                    ElseIf cOrigem == '3'
                        aInfos[nPos][7]  := nGov1
                        aInfos[nPos][8]  := nGov2
                        aInfos[nPos][9]  := nGov3
                        aInfos[nPos][10] := nGov4
                    EndIf

                Else
                    AADD( aInfos, { ;
                        Iif( ValType( jReg["T8R_TPPREV"] ) == "C", jReg["T8R_TPPREV"], "" ), ;
                        Iif( ValType( jReg["T8R_CNPJPC"] ) == "C", jReg["T8R_CNPJPC"], "" ), ;
                        nTaf1, nTaf2, nTaf3, nTaf4, ;
                        nGov1, nGov2, nGov3, nGov4, ;
                        nFolha1, nFolha2, nFolha3, nFolha4, ;
                        cRelaco, .T. ;
                    } )
                EndIf

            //-----------------------------------------------------------------
            // Bloco PROCRE: Processos
            //-----------------------------------------------------------------
            ElseIf cForAba == "PROCRE"

                cRelaco := Iif( ValType( jReg["T8R_RELACO"] ) == "C", jReg["T8R_RELACO"], "" )

                nPos := aScan( aInfos, { |x| AllTrim( x[1] ) == AllTrim( Iif( ValType( jReg["T8R_TPPROC"] ) == "C", jReg["T8R_TPPROC"], "" ) ) .And. ;
                                            AllTrim( x[2] ) == AllTrim( Iif( ValType( jReg["T8R_NRPROC"] ) == "C", jReg["T8R_NRPROC"], "" ) ) .And. ;
                                            AllTrim( x[3] ) == AllTrim( Iif( ValType( jReg["T8R_CODSUP"] ) == "C", jReg["T8R_CODSUP"], "" ) ) } )

                If nPos > 0
                    aInfos[nPos][4] := cRelaco
                Else
                    AADD( aInfos, { ;
                        AllTrim( Iif( ValType( jReg["T8R_TPPROC"] ) == "C", jReg["T8R_TPPROC"], "" ) ), ;
                        AllTrim( Iif( ValType( jReg["T8R_NRPROC"] ) == "C", jReg["T8R_NRPROC"], "" ) ), ;
                        AllTrim( Iif( ValType( jReg["T8R_CODSUP"] ) == "C", jReg["T8R_CODSUP"], "" ) ), ;
                        cRelaco ;
                    } )
                EndIf

            //-----------------------------------------------------------------
            // Bloco PRCVAL: Valores do Processo
            //-----------------------------------------------------------------
            ElseIf cForAba == "PRCVAL"

                nTaf1 := 0; nTaf2 := 0; nTaf3 := 0; nTaf4 := 0; nTaf5 := 0
                nGov1 := 0; nGov2 := 0; nGov3 := 0; nGov4 := 0; nGov5 := 0
                nFolha1 := 0; nFolha2 := 0; nFolha3 := 0; nFolha4 := 0; nFolha5 := 0
                cMask := ""

                If cOrigem == '1'
                    cRelaco := Iif( ValType( jReg["T8R_RELACO"] ) == "C", jReg["T8R_RELACO"], "" )
                    nTaf1   := Iif( ValType( jReg["T8R_VLRRTC"] ) == "N", jReg["T8R_VLRRTC"], 0 )
                    nTaf2   := Iif( ValType( jReg["T8R_DEPJUD"] ) == "N", jReg["T8R_DEPJUD"], 0 )
                    nTaf3   := Iif( ValType( jReg["T8R_CANOCA"] ) == "N", jReg["T8R_CANOCA"], 0 )
                    nTaf4   := Iif( ValType( jReg["T8R_CANOAN"] ) == "N", jReg["T8R_CANOAN"], 0 )
                    nTaf5   := Iif( ValType( jReg["T8R_RENDSU"] ) == "N", jReg["T8R_RENDSU"], 0 )
                ElseIf cOrigem == '2'
                    cRelaco := Iif( ValType( jReg["T8R_RELACO"] ) == "C", jReg["T8R_RELACO"], "" )
                    nFolha1 := Iif( ValType( jReg["T8R_VLRRTC"] ) == "N", jReg["T8R_VLRRTC"], 0 )
                    nFolha2 := Iif( ValType( jReg["T8R_DEPJUD"] ) == "N", jReg["T8R_DEPJUD"], 0 )
                    nFolha3 := Iif( ValType( jReg["T8R_CANOCA"] ) == "N", jReg["T8R_CANOCA"], 0 )
                    nFolha4 := Iif( ValType( jReg["T8R_CANOAN"] ) == "N", jReg["T8R_CANOAN"], 0 )
                    nFolha5 := Iif( ValType( jReg["T8R_RENDSU"] ) == "N", jReg["T8R_RENDSU"], 0 )
                ElseIf cOrigem == '3'
                    cRelaco := Iif( ValType( jReg["T8R_RELACO"] ) == "C", jReg["T8R_RELACO"], "" )
                    nGov1   := Iif( ValType( jReg["T8R_VLRRTC"] ) == "N", jReg["T8R_VLRRTC"], 0 )
                    nGov2   := Iif( ValType( jReg["T8R_DEPJUD"] ) == "N", jReg["T8R_DEPJUD"], 0 )
                    nGov3   := Iif( ValType( jReg["T8R_CANOCA"] ) == "N", jReg["T8R_CANOCA"], 0 )
                    nGov4   := Iif( ValType( jReg["T8R_CANOAN"] ) == "N", jReg["T8R_CANOAN"], 0 )
                    nGov5   := Iif( ValType( jReg["T8R_RENDSU"] ) == "N", jReg["T8R_RENDSU"], 0 )
                EndIf

                cSemKey := TAFProcSemanticKey( cForAba, cCodRec, jReg )
                nPos    := TAFProcFindPos( aInfos, cSemKey, cOrigem, 19, 20 )

                If nPos > 0

                    If cOrigem == '1'
                        aInfos[nPos][2]  := nTaf1
                        aInfos[nPos][3]  := nTaf2
                        aInfos[nPos][4]  := nTaf3
                        aInfos[nPos][5]  := nTaf4
                        aInfos[nPos][6]  := nTaf5
                        aInfos[nPos][17] := cRelaco
                    ElseIf cOrigem == '2'
                        aInfos[nPos][12] := nFolha1
                        aInfos[nPos][13] := nFolha2
                        aInfos[nPos][14] := nFolha3
                        aInfos[nPos][15] := nFolha4
                        aInfos[nPos][16] := nFolha5
                        aInfos[nPos][17] := cRelaco
                    ElseIf cOrigem == '3'
                        aInfos[nPos][7]  := nGov1
                        aInfos[nPos][8]  := nGov2
                        aInfos[nPos][9]  := nGov3
                        aInfos[nPos][10] := nGov4
                        aInfos[nPos][11] := nGov5
                        aInfos[nPos][17] := cRelaco
                    EndIf

                    cMask := IIf( Len( aInfos[nPos] ) >= 20 .And. ValType( aInfos[nPos][20] ) == "C", aInfos[nPos][20], "" )
                    aInfos[nPos][20] := TAFOrigMaskAdd( cMask, cOrigem )
                Else
                    AADD( aInfos, { ;
                        Iif( ValType( jReg["T8R_INDAPU"] ) == "C", jReg["T8R_INDAPU"], "" ), ;
                        nTaf1, nTaf2, nTaf3, nTaf4, nTaf5, ;
                        nGov1, nGov2, nGov3, nGov4, nGov5, ;
                        nFolha1, nFolha2, nFolha3, nFolha4, nFolha5, ;
                        cRelaco, .T., cSemKey, cOrigem ;
                    } )
                EndIf

            //-----------------------------------------------------------------
            // Bloco PRCDED: Deduções do Processo
            //-----------------------------------------------------------------
            ElseIf cForAba == "PRCDED"

                nTaf1 := 0; nTaf2 := 0
                nGov1 := 0; nGov2 := 0
                nFolha1 := 0; nFolha2 := 0
                cMask := ""

                If cOrigem == '1'
                    cRelaco := Iif( ValType( jReg["T8R_RELACO"] ) == "C", jReg["T8R_RELACO"], "" )
                    nTaf1   := Iif( ValType( jReg["T8R_DEDSUS"] ) == "N", jReg["T8R_DEDSUS"], 0 )
                    nTaf2   := Iif( ValType( jReg["T8R_VLCONT"] ) == "N", jReg["T8R_VLCONT"], 0 )
                ElseIf cOrigem == '2'
                    cRelaco := Iif( ValType( jReg["T8R_RELACO"] ) == "C", jReg["T8R_RELACO"], "" )
                    nFolha1 := Iif( ValType( jReg["T8R_DEDSUS"] ) == "N", jReg["T8R_DEDSUS"], 0 )
                    nFolha2 := Iif( ValType( jReg["T8R_VLCONT"] ) == "N", jReg["T8R_VLCONT"], 0 )
                ElseIf cOrigem == '3'
                    cRelaco := Iif( ValType( jReg["T8R_RELACO"] ) == "C", jReg["T8R_RELACO"], "" )
                    nGov1   := Iif( ValType( jReg["T8R_DEDSUS"] ) == "N", jReg["T8R_DEDSUS"], 0 )
                    nGov2   := Iif( ValType( jReg["T8R_VLCONT"] ) == "N", jReg["T8R_VLCONT"], 0 )
                EndIf

                cSemKey := TAFProcSemanticKey( cForAba, cCodRec, jReg )
                nPos    := TAFProcFindPos( aInfos, cSemKey, cOrigem, 11, 12 )

                If nPos > 0

                    If cOrigem == '1'
                        aInfos[nPos][3] := nTaf1
                        aInfos[nPos][4] := nTaf2
                        aInfos[nPos][9] := cRelaco
                    ElseIf cOrigem == '2'
                        aInfos[nPos][7] := nFolha1
                        aInfos[nPos][8] := nFolha2
                        aInfos[nPos][9] := cRelaco
                    ElseIf cOrigem == '3'
                        aInfos[nPos][5] := nGov1
                        aInfos[nPos][6] := nGov2
                        aInfos[nPos][9] := cRelaco
                    EndIf

                    cMask := IIf( Len( aInfos[nPos] ) >= 12 .And. ValType( aInfos[nPos][12] ) == "C", aInfos[nPos][12], "" )
                    aInfos[nPos][12] := TAFOrigMaskAdd( cMask, cOrigem )
                Else
                    AADD( aInfos, { ;
                        AllTrim( Iif( ValType( jReg["T8R_INDDED"] ) == "C", jReg["T8R_INDDED"], "" ) ), ;
                        AllTrim( Iif( ValType( jReg["T8R_CNPJEC"] ) == "C", jReg["T8R_CNPJEC"], "" ) ), ;
                        nTaf1, nTaf2, nGov1, nGov2, nFolha1, nFolha2, cRelaco, .T., cSemKey, cOrigem ;
                    } )
                EndIf

            //-----------------------------------------------------------------
            // Bloco PRCBEN: Beneficiários do Processo
            //-----------------------------------------------------------------
            ElseIf cForAba == "PRCBEN"

                nTaf1   := 0
                nGov1   := 0
                nFolha1 := 0
                cMask   := ""

                If cOrigem == '1'
                    nTaf1   := Iif( ValType( jReg["T8R_DEPSUS"] ) == "N", jReg["T8R_DEPSUS"], 0 )
                    cRelaco := Iif( ValType( jReg["T8R_RELACO"] ) == "C", jReg["T8R_RELACO"], "" )
                ElseIf cOrigem == '2'
                    cRelaco := Iif( ValType( jReg["T8R_RELACO"] ) == "C", jReg["T8R_RELACO"], "" )
                    nFolha1 := Iif( ValType( jReg["T8R_DEPSUS"] ) == "N", jReg["T8R_DEPSUS"], 0 )
                ElseIf cOrigem == '3'
                    cRelaco := Iif( ValType( jReg["T8R_RELACO"] ) == "C", jReg["T8R_RELACO"], "" )
                    nGov1   := Iif( ValType( jReg["T8R_DEPSUS"] ) == "N", jReg["T8R_DEPSUS"], 0 )
                EndIf

                cSemKey := TAFProcSemanticKey( cForAba, cCodRec, jReg )
                nPos    := TAFProcFindPos( aInfos, cSemKey, cOrigem, 7, 8 )

                If nPos > 0

                    If cOrigem == '1'
                        aInfos[nPos][2] := nTaf1
                        aInfos[nPos][5] := cRelaco
                    ElseIf cOrigem == '2'
                        aInfos[nPos][4] := nFolha1
                        aInfos[nPos][5] := cRelaco
                    ElseIf cOrigem == '3'
                        aInfos[nPos][3] := nGov1
                        aInfos[nPos][5] := cRelaco
                    EndIf

                    cMask := IIf( Len( aInfos[nPos] ) >= 8 .And. ValType( aInfos[nPos][8] ) == "C", aInfos[nPos][8], "" )
                    aInfos[nPos][8] := TAFOrigMaskAdd( cMask, cOrigem )
                Else
                    AADD( aInfos, { ;
                        Iif( ValType( jReg["T8R_CPFSUS"] ) == "C", jReg["T8R_CPFSUS"], "" ), ;
                        nTaf1, nGov1, nFolha1, cRelaco, .T., cSemKey, cOrigem ;
                    } )
                EndIf

            EndIf

        EndIf

    Next nX

    //----------------------------------------------------
    // Validação de Divergências
    //----------------------------------------------------
    For nX := 1 to Len( aInfos )
        
        If cAba == "DEDDEP" .Or. cAba == "PENALI"
            aInfos[nX][8] := aInfos[nX][3] != aInfos[nX][4]
            If lIsLegacy .AND. !aInfos[nX][8]
                aInfos[nX][8] := aInfos[nX][3] != aInfos[nX][5] .OR. aInfos[nX][5] != aInfos[nX][4]
            EndIf

        ElseIf cAba == "PREVCL"
            aInfos[nX][16] := aInfos[nX][3] != aInfos[nX][7] .OR. aInfos[nX][4] != aInfos[nX][8] .OR. aInfos[nX][5] != aInfos[nX][9] .OR. aInfos[nX][6] != aInfos[nX][10]
            If lIsLegacy .AND. !aInfos[nX][16]
                aInfos[nX][16] := aInfos[nX][3] != aInfos[nX][11] .OR. aInfos[nX][4] != aInfos[nX][12] .OR. aInfos[nX][5] != aInfos[nX][13] .OR. aInfos[nX][6] != aInfos[nX][14] .OR. aInfos[nX][7] != aInfos[nX][11] .OR. aInfos[nX][8] != aInfos[nX][12] .OR. aInfos[nX][9] != aInfos[nX][13] .OR. aInfos[nX][10] != aInfos[nX][14]
            EndIf

        ElseIf cAba == "PRCVAL"
            aInfos[nX][18] := aInfos[nX][2] != aInfos[nX][7] .OR. aInfos[nX][3] != aInfos[nX][8] .OR. aInfos[nX][4] != aInfos[nX][9] .OR. aInfos[nX][5] != aInfos[nX][10] .OR. aInfos[nX][6] != aInfos[nX][11]
            If lIsLegacy .AND. !aInfos[nX][18]
                aInfos[nX][18] := aInfos[nX][2] != aInfos[nX][12] .OR. aInfos[nX][3] != aInfos[nX][13] .OR. aInfos[nX][4] != aInfos[nX][14] .OR. aInfos[nX][5] != aInfos[nX][15] .OR. aInfos[nX][6] != aInfos[nX][16] .OR. aInfos[nX][7] != aInfos[nX][12] .OR. aInfos[nX][8] != aInfos[nX][13] .OR. aInfos[nX][9] != aInfos[nX][14] .OR. aInfos[nX][10] != aInfos[nX][15] .OR. aInfos[nX][11] != aInfos[nX][16]
            EndIf

        ElseIf cAba == "PRCDED"
            aInfos[nX][10] := aInfos[nX][3] != aInfos[nX][5] .OR. aInfos[nX][4] != aInfos[nX][6]
            If lIsLegacy .AND. !aInfos[nX][10]
                aInfos[nX][10] := aInfos[nX][3] != aInfos[nX][7] .OR. aInfos[nX][4] != aInfos[nX][8] .OR. aInfos[nX][5] != aInfos[nX][7] .OR. aInfos[nX][6] != aInfos[nX][8]
            EndIf

        ElseIf cAba == "PRCBEN"
            aInfos[nX][6] := aInfos[nX][2] != aInfos[nX][3]
            If lIsLegacy .AND. !aInfos[nX][6]
                aInfos[nX][6] := aInfos[nX][2] != aInfos[nX][4] .OR. aInfos[nX][4] != aInfos[nX][3]
            EndIf
        EndIf

    Next nX

Return aInfos

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFLidDirf
@type           Function
@description    Consolida as informações tributárias (Aba TRIBUT) comparando TAF, Governo e Folha.
                A lógica de acumulação (SUM) é realizada manualmente no loop.

@param          jBuckets, Json,      Cache de dados do T8R (Substitui query).
@param          cCodRec,  Character, Código Receita.
@param          cCpf,     Character, CPF.
@param          cPeriodo, Character, Período.
@param          cAba,     Character, Identificador da Aba (ex: TRIBUT).
@param          cOrigem,  Character, Origem (1=TAF, 3=Gov).
@param          aInfos,   Array,     Array de informações acumulado (Referência).

@return         aInfos,   Array,     Array atualizado.

@author         Alexandre de Lima Santos / Denis R. de Oliveira
@since          03/12/2025
@version        1.0
/*/
//---------------------------------------------------------------------  
Function TAFLidDirf( jBuckets As Json, cCodRec As Character, cCpf As Character, cPeriodo As Character, cAba As Character, cOrigem As Character, aInfos As Array, lIsLegacy As Logical )

    //-----------------------------------------------------------------------
    // Declaracao de Variaveis
    //-----------------------------------------------------------------------  
    Local aCodRec  As Array
    Local aItems   As Array
    Local cRegAba  As Character
    Local cRegCod  As Character
    Local cRegOri  As Character
    Local jReg     As Json
    Local nPos     As Numeric
    Local nX       As Numeric
    Local nY       As Numeric

    // Cache de Posição
    Static cLastKey := ""
    Static nLastPos := 0

    //-----------------------------------------------------------------------
    // Inicializacao
    //-----------------------------------------------------------------------
    Default jBuckets  := Nil
    Default aInfos    := {}
    Default cAba      := ""
    Default cCodRec   := ""
    Default cCpf      := ""
    Default cOrigem   := ""
    Default cPeriodo  := ""
    Default lIsLegacy := .F.

    aCodRec := {}
    aItems  := {}
    nPos    := 0
    nX      := 0
    nY      := 0

    cOrigem := AllTrim( cOrigem )
    cAba    := AllTrim( Upper( cAba ) )

    //-----------------------------------------------------------------------
    // Acesso Direto O(1) ao Bucket
    //-----------------------------------------------------------------------
    If !( ValType( jBuckets ) $ "J|O" ) .Or. !jBuckets:HasProperty( cAba ) .Or. !jBuckets[cAba]:HasProperty( cOrigem )
        Return aInfos
    EndIf

    aItems := jBuckets[cAba][cOrigem]

    For nY := 1 To Len( aItems )

        jReg := aItems[nY]

        cRegOri := jReg["T8R_ORIGEM"]
        If ValType( cRegOri ) != "C" .Or. AllTrim( cRegOri ) != cOrigem
            Loop
        EndIf

        cRegAba := jReg["T8R_FORABA"]
        If ValType( cRegAba ) != "C" .Or. AllTrim( cRegAba ) != "TRIBUT"
            Loop
        EndIf

        cRegCod := AllTrim( IIf( ValType( jReg["T8R_CODREC"] ) == "C", jReg["T8R_CODREC"], "" ) )
        If !( "|" + AllTrim(cCodRec) + "|" $ "|" + cRegCod + "|" )
            Loop
        EndIf

        //-------------------------------------------------------------------
        // Busca Otimizada com Cache de Posição
        //-------------------------------------------------------------------
        If cLastKey == ( cCodRec + cCpf )
            nPos := nLastPos
        Else
            nPos := aScan( aInfos, {|x| AllTrim(x[1]) == cCodRec .And. AllTrim(x[2]) == cCpf } )
            cLastKey := cCodRec + cCpf
            nLastPos := nPos
        EndIf

        //-------------------------------------------------------------------
        // Origem 1: TAF
        //-------------------------------------------------------------------
        If cOrigem == '1'

            aCodRec := StrTokArr( cRegCod, "|" )
            If Empty( aCodRec ); AADD( aCodRec, cCodRec ); EndIf

            For nX := 1 To Len( aCodRec )
                If cCodRec == AllTrim( aCodRec[nX] )

                    If nPos > 0
                        aInfos[nPos][3]  += IIf( ValType(jReg["T8R_VLRTRI"]) == "N", jReg["T8R_VLRTRI"], 0 )
                        aInfos[nPos][4]  += IIf( ValType(jReg["T8R_VRTR13"]) == "N", jReg["T8R_VRTR13"], 0 )
                        aInfos[nPos][5]  += IIf( ValType(jReg["T8R_VLRPRE"]) == "N", jReg["T8R_VLRPRE"], 0 )
                        aInfos[nPos][6]  += IIf( ValType(jReg["T8R_VPRE13"]) == "N", jReg["T8R_VPRE13"], 0 )
                        aInfos[nPos][7]  += IIf( ValType(jReg["T8R_VLIRRF"]) == "N", jReg["T8R_VLIRRF"], 0 )
                        aInfos[nPos][8]  += IIf( ValType(jReg["T8R_IRRF13"]) == "N", jReg["T8R_IRRF13"], 0 )
                        aInfos[nPos][9]  += IIf( ValType(jReg["T8R_VLRISE"]) == "N", jReg["T8R_VLRISE"], 0 )
                        aInfos[nPos][10] += IIf( ValType(jReg["T8R_VLRI13"]) == "N", jReg["T8R_VLRI13"], 0 )
                        aInfos[nPos][11] += IIf( ValType(jReg["T8R_VLRDIA"]) == "N", jReg["T8R_VLRDIA"], 0 )
                        aInfos[nPos][12] += IIf( ValType(jReg["T8R_VLRAJU"]) == "N", jReg["T8R_VLRAJU"], 0 )
                        aInfos[nPos][13] += IIf( ValType(jReg["T8R_VLRRSC"]) == "N", jReg["T8R_VLRRSC"], 0 )
                        aInfos[nPos][14] += IIf( ValType(jReg["T8R_VLRABN"]) == "N", jReg["T8R_VLRABN"], 0 )
                        aInfos[nPos][15] += IIf( ValType(jReg["T8R_VLRMLG"]) == "N", jReg["T8R_VLRMLG"], 0 )
                        aInfos[nPos][16] += IIf( ValType(jReg["T8R_VMLG13"]) == "N", jReg["T8R_VMLG13"], 0 )
                        aInfos[nPos][17] += IIf( ValType(jReg["T8R_VLRAXM"]) == "N", jReg["T8R_VLRAXM"], 0 )
                        aInfos[nPos][18] += IIf( ValType(jReg["T8R_VLBMED"]) == "N", jReg["T8R_VLBMED"], 0 )
                        aInfos[nPos][19] += IIf( ValType(jReg["T8R_BMED13"]) == "N", jReg["T8R_BMED13"], 0 )
                        aInfos[nPos][20] += IIf( ValType(jReg["T8R_VLRMOR"]) == "N", jReg["T8R_VLRMOR"], 0 )
                        aInfos[nPos][21] += IIf( ValType(jReg["T8R_VLRISO"]) == "N", jReg["T8R_VLRISO"], 0 )
                    Else
                        // Inicialização Enxuta e Rápida do Array Base (60 Posições Fixas)
                        AAdd( aInfos, Array(60) )
                        nPos := Len(aInfos)
                        AFill( aInfos[nPos], 0 )
                        
                        aInfos[nPos][1] := cCodRec
                        aInfos[nPos][2] := cCpf
                        aInfos[nPos][60] := .T. // Flag base
                        
                        // Atualiza as variaveis iniciais
                        aInfos[nPos][3]  := IIf( ValType(jReg["T8R_VLRTRI"]) == "N", jReg["T8R_VLRTRI"], 0 )
                        aInfos[nPos][4]  := IIf( ValType(jReg["T8R_VRTR13"]) == "N", jReg["T8R_VRTR13"], 0 )
                        aInfos[nPos][5]  := IIf( ValType(jReg["T8R_VLRPRE"]) == "N", jReg["T8R_VLRPRE"], 0 )
                        aInfos[nPos][6]  := IIf( ValType(jReg["T8R_VPRE13"]) == "N", jReg["T8R_VPRE13"], 0 )
                        aInfos[nPos][7]  := IIf( ValType(jReg["T8R_VLIRRF"]) == "N", jReg["T8R_VLIRRF"], 0 )
                        aInfos[nPos][8]  := IIf( ValType(jReg["T8R_IRRF13"]) == "N", jReg["T8R_IRRF13"], 0 )
                        aInfos[nPos][9]  := IIf( ValType(jReg["T8R_VLRISE"]) == "N", jReg["T8R_VLRISE"], 0 )
                        aInfos[nPos][10] := IIf( ValType(jReg["T8R_VLRI13"]) == "N", jReg["T8R_VLRI13"], 0 )
                        aInfos[nPos][11] := IIf( ValType(jReg["T8R_VLRDIA"]) == "N", jReg["T8R_VLRDIA"], 0 )
                        aInfos[nPos][12] := IIf( ValType(jReg["T8R_VLRAJU"]) == "N", jReg["T8R_VLRAJU"], 0 )
                        aInfos[nPos][13] := IIf( ValType(jReg["T8R_VLRRSC"]) == "N", jReg["T8R_VLRRSC"], 0 )
                        aInfos[nPos][14] := IIf( ValType(jReg["T8R_VLRABN"]) == "N", jReg["T8R_VLRABN"], 0 )
                        aInfos[nPos][15] := IIf( ValType(jReg["T8R_VLRMLG"]) == "N", jReg["T8R_VLRMLG"], 0 )
                        aInfos[nPos][16] := IIf( ValType(jReg["T8R_VMLG13"]) == "N", jReg["T8R_VMLG13"], 0 )
                        aInfos[nPos][17] := IIf( ValType(jReg["T8R_VLRAXM"]) == "N", jReg["T8R_VLRAXM"], 0 )
                        aInfos[nPos][18] := IIf( ValType(jReg["T8R_VLBMED"]) == "N", jReg["T8R_VLBMED"], 0 )
                        aInfos[nPos][19] := IIf( ValType(jReg["T8R_BMED13"]) == "N", jReg["T8R_BMED13"], 0 )
                        aInfos[nPos][20] := IIf( ValType(jReg["T8R_VLRMOR"]) == "N", jReg["T8R_VLRMOR"], 0 )
                        aInfos[nPos][21] := IIf( ValType(jReg["T8R_VLRISO"]) == "N", jReg["T8R_VLRISO"], 0 )
                        
                        nLastPos := nPos
                    EndIf
                    Exit
                EndIf
            Next nX
        EndIf

        //-------------------------------------------------------------------
        // Origem 2: Folha de Pagamento (RM/Datasul)
        //-------------------------------------------------------------------
        If cOrigem == '2'

            If nPos > 0
                aInfos[nPos][41] += IIf( ValType(jReg["T8R_VLRTRI"]) == "N", jReg["T8R_VLRTRI"], 0 )
                aInfos[nPos][42] += IIf( ValType(jReg["T8R_VRTR13"]) == "N", jReg["T8R_VRTR13"], 0 )
                aInfos[nPos][43] += IIf( ValType(jReg["T8R_VLRPRE"]) == "N", jReg["T8R_VLRPRE"], 0 )
                aInfos[nPos][44] += IIf( ValType(jReg["T8R_VPRE13"]) == "N", jReg["T8R_VPRE13"], 0 )
                aInfos[nPos][45] += IIf( ValType(jReg["T8R_VLIRRF"]) == "N", jReg["T8R_VLIRRF"], 0 )
                aInfos[nPos][46] += IIf( ValType(jReg["T8R_IRRF13"]) == "N", jReg["T8R_IRRF13"], 0 )
                aInfos[nPos][47] += IIf( ValType(jReg["T8R_VLRISE"]) == "N", jReg["T8R_VLRISE"], 0 )
                aInfos[nPos][48] += IIf( ValType(jReg["T8R_VLRI13"]) == "N", jReg["T8R_VLRI13"], 0 )
                aInfos[nPos][49] += IIf( ValType(jReg["T8R_VLRDIA"]) == "N", jReg["T8R_VLRDIA"], 0 )
                aInfos[nPos][50] += IIf( ValType(jReg["T8R_VLRAJU"]) == "N", jReg["T8R_VLRAJU"], 0 )
                aInfos[nPos][51] += IIf( ValType(jReg["T8R_VLRRSC"]) == "N", jReg["T8R_VLRRSC"], 0 )
                aInfos[nPos][52] += IIf( ValType(jReg["T8R_VLRABN"]) == "N", jReg["T8R_VLRABN"], 0 )
                aInfos[nPos][53] += IIf( ValType(jReg["T8R_VLRMLG"]) == "N", jReg["T8R_VLRMLG"], 0 )
                aInfos[nPos][54] += IIf( ValType(jReg["T8R_VMLG13"]) == "N", jReg["T8R_VMLG13"], 0 )
                aInfos[nPos][55] += IIf( ValType(jReg["T8R_VLRAXM"]) == "N", jReg["T8R_VLRAXM"], 0 )
                aInfos[nPos][56] += IIf( ValType(jReg["T8R_VLBMED"]) == "N", jReg["T8R_VLBMED"], 0 )
                aInfos[nPos][57] += IIf( ValType(jReg["T8R_BMED13"]) == "N", jReg["T8R_BMED13"], 0 )
                aInfos[nPos][58] += IIf( ValType(jReg["T8R_VLRMOR"]) == "N", jReg["T8R_VLRMOR"], 0 )
                aInfos[nPos][59] += IIf( ValType(jReg["T8R_VLRISO"]) == "N", jReg["T8R_VLRISO"], 0 )
            Else
                AAdd( aInfos, Array(60) )
                nPos := Len(aInfos)
                AFill( aInfos[nPos], 0 )
                
                aInfos[nPos][1] := cCodRec
                aInfos[nPos][2] := cCpf
                aInfos[nPos][60] := .T.
                
                aInfos[nPos][41] := IIf( ValType(jReg["T8R_VLRTRI"]) == "N", jReg["T8R_VLRTRI"], 0 )
                aInfos[nPos][42] := IIf( ValType(jReg["T8R_VRTR13"]) == "N", jReg["T8R_VRTR13"], 0 )
                aInfos[nPos][43] := IIf( ValType(jReg["T8R_VLRPRE"]) == "N", jReg["T8R_VLRPRE"], 0 )
                aInfos[nPos][44] := IIf( ValType(jReg["T8R_VPRE13"]) == "N", jReg["T8R_VPRE13"], 0 )
                aInfos[nPos][45] := IIf( ValType(jReg["T8R_VLIRRF"]) == "N", jReg["T8R_VLIRRF"], 0 )
                aInfos[nPos][46] := IIf( ValType(jReg["T8R_IRRF13"]) == "N", jReg["T8R_IRRF13"], 0 )
                aInfos[nPos][47] := IIf( ValType(jReg["T8R_VLRISE"]) == "N", jReg["T8R_VLRISE"], 0 )
                aInfos[nPos][48] := IIf( ValType(jReg["T8R_VLRI13"]) == "N", jReg["T8R_VLRI13"], 0 )
                aInfos[nPos][49] := IIf( ValType(jReg["T8R_VLRDIA"]) == "N", jReg["T8R_VLRDIA"], 0 )
                aInfos[nPos][50] := IIf( ValType(jReg["T8R_VLRAJU"]) == "N", jReg["T8R_VLRAJU"], 0 )
                aInfos[nPos][51] := IIf( ValType(jReg["T8R_VLRRSC"]) == "N", jReg["T8R_VLRRSC"], 0 )
                aInfos[nPos][52] := IIf( ValType(jReg["T8R_VLRABN"]) == "N", jReg["T8R_VLRABN"], 0 )
                aInfos[nPos][53] := IIf( ValType(jReg["T8R_VLRMLG"]) == "N", jReg["T8R_VLRMLG"], 0 )
                aInfos[nPos][54] := IIf( ValType(jReg["T8R_VMLG13"]) == "N", jReg["T8R_VMLG13"], 0 )
                aInfos[nPos][55] := IIf( ValType(jReg["T8R_VLRAXM"]) == "N", jReg["T8R_VLRAXM"], 0 )
                aInfos[nPos][56] := IIf( ValType(jReg["T8R_VLBMED"]) == "N", jReg["T8R_VLBMED"], 0 )
                aInfos[nPos][57] := IIf( ValType(jReg["T8R_BMED13"]) == "N", jReg["T8R_BMED13"], 0 )
                aInfos[nPos][58] := IIf( ValType(jReg["T8R_VLRMOR"]) == "N", jReg["T8R_VLRMOR"], 0 )
                aInfos[nPos][59] := IIf( ValType(jReg["T8R_VLRISO"]) == "N", jReg["T8R_VLRISO"], 0 )
                
                nLastPos := nPos
            EndIf

        EndIf

        //-------------------------------------------------------------------
        // Origem 3: Governo (RET)
        //-------------------------------------------------------------------
        If cOrigem == '3'

            If nPos > 0
                aInfos[nPos][22] += IIf( ValType(jReg["T8R_VLRTRI"]) == "N", jReg["T8R_VLRTRI"], 0 )
                aInfos[nPos][23] += IIf( ValType(jReg["T8R_VRTR13"]) == "N", jReg["T8R_VRTR13"], 0 )
                aInfos[nPos][24] += IIf( ValType(jReg["T8R_VLRPRE"]) == "N", jReg["T8R_VLRPRE"], 0 )
                aInfos[nPos][25] += IIf( ValType(jReg["T8R_VPRE13"]) == "N", jReg["T8R_VPRE13"], 0 )
                aInfos[nPos][26] += IIf( ValType(jReg["T8R_VLIRRF"]) == "N", jReg["T8R_VLIRRF"], 0 )
                aInfos[nPos][27] += IIf( ValType(jReg["T8R_IRRF13"]) == "N", jReg["T8R_IRRF13"], 0 )
                aInfos[nPos][28] += IIf( ValType(jReg["T8R_VLRISE"]) == "N", jReg["T8R_VLRISE"], 0 )
                aInfos[nPos][29] += IIf( ValType(jReg["T8R_VLRI13"]) == "N", jReg["T8R_VLRI13"], 0 )
                aInfos[nPos][30] += IIf( ValType(jReg["T8R_VLRDIA"]) == "N", jReg["T8R_VLRDIA"], 0 )
                aInfos[nPos][31] += IIf( ValType(jReg["T8R_VLRAJU"]) == "N", jReg["T8R_VLRAJU"], 0 )
                aInfos[nPos][32] += IIf( ValType(jReg["T8R_VLRRSC"]) == "N", jReg["T8R_VLRRSC"], 0 )
                aInfos[nPos][33] += IIf( ValType(jReg["T8R_VLRABN"]) == "N", jReg["T8R_VLRABN"], 0 )
                aInfos[nPos][34] += IIf( ValType(jReg["T8R_VLRMLG"]) == "N", jReg["T8R_VLRMLG"], 0 )
                aInfos[nPos][35] += IIf( ValType(jReg["T8R_VMLG13"]) == "N", jReg["T8R_VMLG13"], 0 )
                aInfos[nPos][36] += IIf( ValType(jReg["T8R_VLRAXM"]) == "N", jReg["T8R_VLRAXM"], 0 )
                aInfos[nPos][37] += IIf( ValType(jReg["T8R_VLBMED"]) == "N", jReg["T8R_VLBMED"], 0 )
                aInfos[nPos][38] += IIf( ValType(jReg["T8R_BMED13"]) == "N", jReg["T8R_BMED13"], 0 )
                aInfos[nPos][39] += IIf( ValType(jReg["T8R_VLRMOR"]) == "N", jReg["T8R_VLRMOR"], 0 )
                aInfos[nPos][40] += IIf( ValType(jReg["T8R_VLRISO"]) == "N", jReg["T8R_VLRISO"], 0 )
            Else
                AAdd( aInfos, Array(60) )
                nPos := Len(aInfos)
                AFill( aInfos[nPos], 0 )
                
                aInfos[nPos][1] := cCodRec
                aInfos[nPos][2] := cCpf
                aInfos[nPos][60] := .T.
                
                aInfos[nPos][22] := IIf( ValType(jReg["T8R_VLRTRI"]) == "N", jReg["T8R_VLRTRI"], 0 )
                aInfos[nPos][23] := IIf( ValType(jReg["T8R_VRTR13"]) == "N", jReg["T8R_VRTR13"], 0 )
                aInfos[nPos][24] := IIf( ValType(jReg["T8R_VLRPRE"]) == "N", jReg["T8R_VLRPRE"], 0 )
                aInfos[nPos][25] := IIf( ValType(jReg["T8R_VPRE13"]) == "N", jReg["T8R_VPRE13"], 0 )
                aInfos[nPos][26] := IIf( ValType(jReg["T8R_VLIRRF"]) == "N", jReg["T8R_VLIRRF"], 0 )
                aInfos[nPos][27] := IIf( ValType(jReg["T8R_IRRF13"]) == "N", jReg["T8R_IRRF13"], 0 )
                aInfos[nPos][28] := IIf( ValType(jReg["T8R_VLRISE"]) == "N", jReg["T8R_VLRISE"], 0 )
                aInfos[nPos][29] := IIf( ValType(jReg["T8R_VLRI13"]) == "N", jReg["T8R_VLRI13"], 0 )
                aInfos[nPos][30] := IIf( ValType(jReg["T8R_VLRDIA"]) == "N", jReg["T8R_VLRDIA"], 0 )
                aInfos[nPos][31] := IIf( ValType(jReg["T8R_VLRAJU"]) == "N", jReg["T8R_VLRAJU"], 0 )
                aInfos[nPos][32] := IIf( ValType(jReg["T8R_VLRRSC"]) == "N", jReg["T8R_VLRRSC"], 0 )
                aInfos[nPos][33] := IIf( ValType(jReg["T8R_VLRABN"]) == "N", jReg["T8R_VLRABN"], 0 )
                aInfos[nPos][34] := IIf( ValType(jReg["T8R_VLRMLG"]) == "N", jReg["T8R_VLRMLG"], 0 )
                aInfos[nPos][35] := IIf( ValType(jReg["T8R_VMLG13"]) == "N", jReg["T8R_VMLG13"], 0 )
                aInfos[nPos][36] := IIf( ValType(jReg["T8R_VLRAXM"]) == "N", jReg["T8R_VLRAXM"], 0 )
                aInfos[nPos][37] := IIf( ValType(jReg["T8R_VLBMED"]) == "N", jReg["T8R_VLBMED"], 0 )
                aInfos[nPos][38] := IIf( ValType(jReg["T8R_BMED13"]) == "N", jReg["T8R_BMED13"], 0 )
                aInfos[nPos][39] := IIf( ValType(jReg["T8R_VLRMOR"]) == "N", jReg["T8R_VLRMOR"], 0 )
                aInfos[nPos][40] := IIf( ValType(jReg["T8R_VLRISO"]) == "N", jReg["T8R_VLRISO"], 0 )
                
                nLastPos := nPos
            EndIf

        EndIf
    
    Next nY

    //-----------------------------------------------------------------------
    // Validação de Divergências
    //-----------------------------------------------------------------------
    For nX := 1 to Len( aInfos )
        modalValid( @aInfos[nX], lIsLegacy )
    Next nX

Return aInfos

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFNoRecDirf
@type           Function
@description    Busca informações complementares (não grid) como planos de saúde e reembolsos.

@param          jBuckets,  Json,      Cache de dados do T8R (Substitui query).
@param          cCpf,      Character, CPF.
@param          cPeriodo,  Character, Período.
@param          cAba,      Character, Identificador da Aba (ex: PLASAU).
@param          cOrigem,   Character, Origem (1=TAF, 3=Gov).
@param          aInfos,    Array,     Array de informações acumulado (Referência).
@param          lIsLegacy, Logical,   Flag indicando uso da rotina legada.
@return         Array,     Array de informações atualizado.

@author         Alexandre de Lima Santos / Denis R. de Oliveira
@since          03/12/2025
@version        1.0
/*/ 
//--------------------------------------------------------------------- 
Function TAFNoRecDirf( jBuckets as Json, cCpf as Character, cPeriodo as Character, cAba as Character, cOrigem as Character, aInfos as Array, lIsLegacy as logical ) as Array

    //-----------------------------------------------------------------------
    // Declaracao de Variaveis
    //-----------------------------------------------------------------------
    Local aItems    As Array

    Local cMask     As Character
    Local cRegAba   As Character
    Local cRegOri   As Character
    Local cRelaco   As Character
    Local cSemKey   As Character

    Local jReg      As Json

    Local nFolha1   As Numeric
    Local nFolha2   As Numeric
    Local nGov1     As Numeric
    Local nGov2     As Numeric
    Local nPos      As Numeric
    Local nTaf1     As Numeric
    Local nTaf2     As Numeric
    Local nX        As Numeric

    //-----------------------------------------------------------------------
    // Inicializacao de Parametros (Defaults)
    //-----------------------------------------------------------------------
    Default jBuckets  := Nil
    Default aInfos    := {}
    Default cAba      := ""
    Default cCpf      := ""
    Default cOrigem   := ""
    Default cPeriodo  := ""
    Default lIsLegacy := .F.

    //-----------------------------------------------------------------------
    // Inicializacao de Variaveis
    //-----------------------------------------------------------------------
    aItems  := {}

    cMask   := ""
    cRegAba := ""
    cRegOri := ""
    cRelaco := ""
    cSemKey := ""

    jReg    := Nil

    nFolha1 := 0
    nFolha2 := 0
    nGov1   := 0
    nGov2   := 0
    nPos    := 0
    nTaf1   := 0
    nTaf2   := 0
    nX      := 0

    //-----------------------------------------------------------------------
    // Processamento de Dados Complementares em Memoria
    //-----------------------------------------------------------------------
    If ValType( jBuckets ) == "J" .Or. ValType( jBuckets ) == "O"

        cAba    := AllTrim( Upper( cAba ) )
        cOrigem := AllTrim( cOrigem )

        If !jBuckets:HasProperty( cAba ) .Or. !jBuckets[cAba]:HasProperty( cOrigem )
            Return aInfos
        EndIf

        aItems := jBuckets[cAba][cOrigem]

        If Len( aItems ) > 1
            TAFNoRecSortItems( cAba, @aItems )
        EndIf

        For nX := 1 To Len( aItems )

            jReg := aItems[nX]

            //----------------------------------------------------------------
            // Filtros fail-fast
            //----------------------------------------------------------------
            cRegOri := jReg["T8R_ORIGEM"]
            If ValType( cRegOri ) != "C" .Or. AllTrim( cRegOri ) != cOrigem
                Loop
            EndIf

            cRegAba := jReg["T8R_FORABA"]
            If ValType( cRegAba ) != "C" .Or. AllTrim( cRegAba ) != cAba
                Loop
            EndIf

            //----------------------------------------------------------------
            // Limpeza de buffer por iteracao
            //----------------------------------------------------------------
            cMask   := ""
            cRelaco := IIf( ValType( jReg["T8R_RELACO"] ) == "C", jReg["T8R_RELACO"], "" )
            cSemKey := TAFNoRecSemanticKey( cAba, cRelaco )
            nFolha1 := 0
            nFolha2 := 0
            nGov1   := 0
            nGov2   := 0
            nPos    := 0
            nTaf1   := 0
            nTaf2   := 0

            //---------------------------------------------------------------
            // Plano de Saude (Titular)
            //---------------------------------------------------------------
            If cAba == "PLASAU"

                If cOrigem == "1"
                    nTaf1   := IIf( ValType( jReg["T8R_VLRPLS"] ) == "N", jReg["T8R_VLRPLS"], 0 )
                ElseIf cOrigem == "2"
                    nFolha1 := IIf( ValType( jReg["T8R_VLRPLS"] ) == "N", jReg["T8R_VLRPLS"], 0 )
                ElseIf cOrigem == "3"
                    nGov1   := IIf( ValType( jReg["T8R_VLRPLS"] ) == "N", jReg["T8R_VLRPLS"], 0 )
                EndIf

                nPos := TAFNoRecFindPos( aInfos, cAba, cSemKey, cOrigem )

                If nPos > 0
                    If cOrigem == "1"
                        aInfos[nPos][4] := nTaf1
                    ElseIf cOrigem == "2"
                        aInfos[nPos][6] := nFolha1
                    ElseIf cOrigem == "3"
                        aInfos[nPos][5] := nGov1
                    EndIf

                    cMask := IIf( Len( aInfos[nPos] ) >= 10 .And. ValType( aInfos[nPos][10] ) == "C", aInfos[nPos][10], "" )
                    aInfos[nPos][10] := TAFOrigMaskAdd( cMask, cOrigem )
                Else
                    AAdd( aInfos, { jReg["T8R_CPF"], ;
                                    jReg["T8R_CNPJOP"], ;
                                    jReg["T8R_REGANS"], ;
                                    nTaf1, ;
                                    nGov1, ;
                                    nFolha1, ;
                                    cRelaco, ;
                                    .T., ;
                                    cSemKey, ;
                                    cOrigem } )
                EndIf

            //---------------------------------------------------------------
            // Plano de Saude (Dependentes)
            //---------------------------------------------------------------
            ElseIf cAba == "DEPSAU"

                If cOrigem == "1"
                    nTaf1   := IIf( ValType( jReg["T8R_VLRDPS"] ) == "N", jReg["T8R_VLRDPS"], 0 )
                ElseIf cOrigem == "2"
                    nFolha1 := IIf( ValType( jReg["T8R_VLRDPS"] ) == "N", jReg["T8R_VLRDPS"], 0 )
                ElseIf cOrigem == "3"
                    nGov1   := IIf( ValType( jReg["T8R_VLRDPS"] ) == "N", jReg["T8R_VLRDPS"], 0 )
                EndIf

                nPos := TAFNoRecFindPos( aInfos, cAba, cSemKey, cOrigem )

                If nPos > 0
                    If cOrigem == "1"
                        aInfos[nPos][3] := nTaf1
                    ElseIf cOrigem == "2"
                        aInfos[nPos][5] := nFolha1
                    ElseIf cOrigem == "3"
                        aInfos[nPos][4] := nGov1
                    EndIf

                    cMask := IIf( Len( aInfos[nPos] ) >= 9 .And. ValType( aInfos[nPos][9] ) == "C", aInfos[nPos][9], "" )
                    aInfos[nPos][9] := TAFOrigMaskAdd( cMask, cOrigem )
                Else
                    AAdd( aInfos, { jReg["T8R_CPFDPS"], ;
                                    jReg["T8R_RELACO"], ;
                                    nTaf1, ;
                                    nGov1, ;
                                    nFolha1, ;
                                    cRelaco, ;
                                    .T., ;
                                    cSemKey, ;
                                    cOrigem } )
                EndIf

            //---------------------------------------------------------------
            // Reembolso Medico (Cabecalho)
            //---------------------------------------------------------------
            ElseIf cAba == "REMMED"

                nPos := TAFNoRecFindPos( aInfos, cAba, cSemKey, cOrigem )

                If nPos > 0
                    cMask := IIf( Len( aInfos[nPos] ) >= 6 .And. ValType( aInfos[nPos][6] ) == "C", aInfos[nPos][6], "" )
                    aInfos[nPos][6] := TAFOrigMaskAdd( cMask, cOrigem )
                Else
                    AAdd( aInfos, { jReg["T8R_ORIREE"], ;
                                    jReg["T8R_CNPJPS"], ;
                                    jReg["T8R_ANSRRE"], ;
                                    cRelaco, ;
                                    cSemKey, ;
                                    cOrigem } )
                EndIf

            //---------------------------------------------------------------
            // Reembolso Medico (Titular)
            //---------------------------------------------------------------
            ElseIf cAba == "REMTID"

                If cOrigem == "1"
                    nTaf1   := IIf( ValType( jReg["T8R_VLREEM"] ) == "N", jReg["T8R_VLREEM"], 0 )
                    nTaf2   := IIf( ValType( jReg["T8R_VLRANT"] ) == "N", jReg["T8R_VLRANT"], 0 )
                ElseIf cOrigem == "2"
                    nFolha1 := IIf( ValType( jReg["T8R_VLREEM"] ) == "N", jReg["T8R_VLREEM"], 0 )
                    nFolha2 := IIf( ValType( jReg["T8R_VLRANT"] ) == "N", jReg["T8R_VLRANT"], 0 )
                ElseIf cOrigem == "3"
                    nGov1   := IIf( ValType( jReg["T8R_VLREEM"] ) == "N", jReg["T8R_VLREEM"], 0 )
                    nGov2   := IIf( ValType( jReg["T8R_VLRANT"] ) == "N", jReg["T8R_VLRANT"], 0 )
                EndIf

                nPos := TAFNoRecFindPos( aInfos, cAba, cSemKey, cOrigem )

                If nPos > 0
                    If cOrigem == "1"
                        aInfos[nPos][3] := nTaf1
                        aInfos[nPos][4] := nTaf2
                    ElseIf cOrigem == "2"
                        aInfos[nPos][7] := nFolha1
                        aInfos[nPos][8] := nFolha2
                    ElseIf cOrigem == "3"
                        aInfos[nPos][5] := nGov1
                        aInfos[nPos][6] := nGov2
                    EndIf

                    cMask := IIf( Len( aInfos[nPos] ) >= 12 .And. ValType( aInfos[nPos][12] ) == "C", aInfos[nPos][12], "" )
                    aInfos[nPos][12] := TAFOrigMaskAdd( cMask, cOrigem )
                Else
                    AAdd( aInfos, { jReg["T8R_INSCRE"], ;
                                    jReg["T8R_NRPSRE"], ;
                                    nTaf1, ;
                                    nTaf2, ;
                                    nGov1, ;
                                    nGov2, ;
                                    nFolha1, ;
                                    nFolha2, ;
                                    cRelaco, ;
                                    .T., ;
                                    cSemKey, ;
                                    cOrigem } )
                EndIf

            //---------------------------------------------------------------
            // Reembolso Medico (Dependentes - Relacao)
            //---------------------------------------------------------------
            ElseIf cAba == "REMDEP"

                nPos := TAFNoRecFindPos( aInfos, cAba, cSemKey, cOrigem )

                If nPos > 0
                    cMask := IIf( Len( aInfos[nPos] ) >= 4 .And. ValType( aInfos[nPos][4] ) == "C", aInfos[nPos][4], "" )
                    aInfos[nPos][4] := TAFOrigMaskAdd( cMask, cOrigem )
                Else
                    AAdd( aInfos, { jReg["T8R_CPFRED"], ;
                                    cRelaco, ;
                                    cSemKey, ;
                                    cOrigem } )
                EndIf

            //---------------------------------------------------------------
            // Reembolso Medico (Dependentes - Valores)
            //---------------------------------------------------------------
            ElseIf cAba == "DETDEP"

                If cOrigem == "1"
                    nTaf1   := IIf( ValType( jReg["T8R_DVLRRE"] ) == "N", jReg["T8R_DVLRRE"], 0 )
                    nTaf2   := IIf( ValType( jReg["T8R_DVLRAN"] ) == "N", jReg["T8R_DVLRAN"], 0 )
                ElseIf cOrigem == "2"
                    nFolha1 := IIf( ValType( jReg["T8R_DVLRRE"] ) == "N", jReg["T8R_DVLRRE"], 0 )
                    nFolha2 := IIf( ValType( jReg["T8R_DVLRAN"] ) == "N", jReg["T8R_DVLRAN"], 0 )
                ElseIf cOrigem == "3"
                    nGov1   := IIf( ValType( jReg["T8R_DVLRRE"] ) == "N", jReg["T8R_DVLRRE"], 0 )
                    nGov2   := IIf( ValType( jReg["T8R_DVLRAN"] ) == "N", jReg["T8R_DVLRAN"], 0 )
                EndIf

                nPos := TAFNoRecFindPos( aInfos, cAba, cSemKey, cOrigem )

                If nPos > 0
                    If cOrigem == "1"
                        aInfos[nPos][3] := nTaf1
                        aInfos[nPos][4] := nTaf2
                    ElseIf cOrigem == "2"
                        aInfos[nPos][7] := nFolha1
                        aInfos[nPos][8] := nFolha2
                    ElseIf cOrigem == "3"
                        aInfos[nPos][5] := nGov1
                        aInfos[nPos][6] := nGov2
                    EndIf

                    cMask := IIf( Len( aInfos[nPos] ) >= 12 .And. ValType( aInfos[nPos][12] ) == "C", aInfos[nPos][12], "" )
                    aInfos[nPos][12] := TAFOrigMaskAdd( cMask, cOrigem )
                Else
                    AAdd( aInfos, { jReg["T8R_DINSCR"], ;
                                    jReg["T8R_DNRPSR"], ;
                                    nTaf1, ;
                                    nTaf2, ;
                                    nGov1, ;
                                    nGov2, ;
                                    nFolha1, ;
                                    nFolha2, ;
                                    cRelaco, ;
                                    .T., ;
                                    cSemKey, ;
                                    cOrigem } )
                EndIf

            EndIf

        Next nX

    EndIf

    //-----------------------------------------------------------------------
    // Validacao de Divergencias
    //-----------------------------------------------------------------------
    For nX := 1 To Len( aInfos )

        If cAba == "PLASAU"

            aInfos[nX][8] := aInfos[nX][4] != aInfos[nX][5]

            If lIsLegacy .And. !aInfos[nX][8]
                aInfos[nX][8] := aInfos[nX][4] != aInfos[nX][6] .Or. ;
                                 aInfos[nX][6] != aInfos[nX][5]
            EndIf

        ElseIf cAba == "DEPSAU"

            aInfos[nX][7] := aInfos[nX][3] != aInfos[nX][4]

            If lIsLegacy .And. !aInfos[nX][7]
                aInfos[nX][7] := aInfos[nX][3] != aInfos[nX][5] .Or. ;
                                 aInfos[nX][5] != aInfos[nX][4]
            EndIf

        ElseIf cAba == "REMTID"

            aInfos[nX][10] := aInfos[nX][3] != aInfos[nX][5] .Or. ;
                              aInfos[nX][4] != aInfos[nX][6]

            If lIsLegacy .And. !aInfos[nX][10]
                aInfos[nX][10] := aInfos[nX][7] != aInfos[nX][3] .Or. ;
                                  aInfos[nX][8] != aInfos[nX][4] .Or. ;
                                  aInfos[nX][7] != aInfos[nX][5] .Or. ;
                                  aInfos[nX][8] != aInfos[nX][6]
            EndIf

        ElseIf cAba == "DETDEP"

            aInfos[nX][10] := aInfos[nX][3] != aInfos[nX][5] .Or. ;
                              aInfos[nX][4] != aInfos[nX][6]

            If lIsLegacy .And. !aInfos[nX][10]
                aInfos[nX][10] := aInfos[nX][7] != aInfos[nX][3] .Or. ;
                                  aInfos[nX][8] != aInfos[nX][4] .Or. ;
                                  aInfos[nX][7] != aInfos[nX][5] .Or. ;
                                  aInfos[nX][8] != aInfos[nX][6]
            EndIf

        EndIf

    Next nX

Return aInfos

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFJsonTotDirf
@type           Function
@description    Gera o JSON Nível 1 (Totalizador Geral).
@author         Alexandre de Lima Santos
@since          03/12/2025
/*/
//---------------------------------------------------------------------
Function TAFJsonTotDirf( aInfo as Array, cTicket as character, lIsLegacy as logical )

    Local cFilV45   as Character
    Local cLevel    as Character

    Local nRet      as Numeric 
    Local nTaf      as Numeric
    Local nFolha    as Numeric 
    Local nX        as Numeric
    Local nTotTaf   as Numeric
    Local nTotRet   as Numeric
    Local nTotErp   as Numeric

    Local jEvenue   as Json
    Local jInfos    as Json
    Local jItem     as Json
    Local jResponse as Json

    Default aInfo     := {} 
    Default cTicket   := ""
    Default lIsLegacy := .F.
    
    cFilV45     := xFilial( "V45" )
    cLevel      := "1"

    nRet        := 0
    nTaf        := 0 
    nFolha      := 0
    nX          := 0
    nTotTaf     := 0
    nTotRet     := 0
    nTotErp     := 0

    jEvenue     := Nil
    jInfos      := Nil
    jItem       := Nil
    jResponse   := Nil

    // Soma totais
    For nX := 1 to Len( aInfo )
        nTaf   += aInfo[nX][6] + aInfo[nX][7]
        nRet   += aInfo[nX][25] + aInfo[nX][26]
        nFolha += aInfo[nX][44] + aInfo[nX][45]
    next nX

    jResponse := JsonObject():New()
    jResponse["totalIRRFCompany"] := JsonObject():New()
    jResponse["totalIRRFCompany"]["items"] := {}

    jItem := JsonObject():New()
    jItem["totalIRRFCompany"] := JsonObject():New()
    jItem["totalIRRFCompany"]["totalIrrfTaf"] := nTaf
    jItem["totalIRRFCompany"]["totalIrrfErp"] := nFolha
    jItem["totalIRRFCompany"]["totalIrrfRet"] := nRet

    // Controle explícito de divergência (Verde/Vermelho) apenas para os Cards Principais
    If lIsLegacy
        jItem["totalIRRFCompany"]["divergent"] := ( nTaf != nRet ) .OR. ( nRet != nFolha ) .OR. ( nTaf != nFolha )
    Else
        jItem["totalIRRFCompany"]["divergent"] := ( nTaf != nRet )
    EndIf

    aAdd(jResponse["totalIRRFCompany"]["items"], jItem)

    // Estrutura de Revenue Codes no Nível 1
    jResponse["revenueCodes"] := JsonObject():New()
    jResponse["revenueCodes"]["items"] := {}

    jEvenue := JsonObject():New()
    jEvenue["evenue"] := {} 
    
    For nX := 1 to Len( aInfo )

        jInfos := JsonObject():New()
        jInfos["revenueCode"] := aInfo[nX][1]

        // Armazenamos a soma bruta 
        nTotTaf := aInfo[nX][6] + aInfo[nX][7]
        nTotRet := aInfo[nX][25] + aInfo[nX][26]
        nTotErp := aInfo[nX][44] + aInfo[nX][45]

        jInfos["totalIrrf"] := JsonObject():New()
        jInfos["totalIrrf"]["tafValue"] := nTotTaf
        jInfos["totalIrrf"]["retValue"] := nTotRet
        jInfos["totalIrrf"]["erpValue"] := nTotErp

        // Arredondamento apenas para definir o status da flag de divergência
        If lIsLegacy
            jInfos["totalIrrf"]["divergent"] := nTotTaf != nTotRet .OR. ;
                                                nTotRet != nTotErp .OR. ;
                                                nTotTaf != nTotErp
        Else  
            jInfos["totalIrrf"]["divergent"] := nTotTaf != nTotRet                                                
        EndIf

        AddJsonBlock(jInfos, "taxableIncome",         aInfo[nX][2],  aInfo[nX][21], aInfo[nX][40], lIsLegacy )
        AddJsonBlock(jInfos, "taxableIncome13",       aInfo[nX][3],  aInfo[nX][22], aInfo[nX][41], lIsLegacy )
        AddJsonBlock(jInfos, "officialPension",       aInfo[nX][4],  aInfo[nX][23], aInfo[nX][42], lIsLegacy )
        AddJsonBlock(jInfos, "officialPension13",     aInfo[nX][5],  aInfo[nX][24], aInfo[nX][43], lIsLegacy )
        AddJsonBlock(jInfos, "withheldIncomeTax",     aInfo[nX][6],  aInfo[nX][25], aInfo[nX][44], lIsLegacy )
        AddJsonBlock(jInfos, "withheldIncomeTax13",   aInfo[nX][7],  aInfo[nX][26], aInfo[nX][45], lIsLegacy )
        AddJsonBlock(jInfos, "exemptPortionOver65",   aInfo[nX][8],  aInfo[nX][27], aInfo[nX][46], lIsLegacy )
        AddJsonBlock(jInfos, "exemptPortionOver6513", aInfo[nX][9],  aInfo[nX][28], aInfo[nX][47], lIsLegacy )
        AddJsonBlock(jInfos, "dailyAllowances",       aInfo[nX][10], aInfo[nX][29], aInfo[nX][48], lIsLegacy )
        AddJsonBlock(jInfos, "costAid",               aInfo[nX][11], aInfo[nX][30], aInfo[nX][49], lIsLegacy )
        AddJsonBlock(jInfos, "terminationIndemnity",  aInfo[nX][12], aInfo[nX][31], aInfo[nX][50], lIsLegacy )
        AddJsonBlock(jInfos, "vacationBonus",         aInfo[nX][13], aInfo[nX][32], aInfo[nX][51], lIsLegacy )
        AddJsonBlock(jInfos, "seriousIllness",        aInfo[nX][14], aInfo[nX][33], aInfo[nX][52], lIsLegacy )
        AddJsonBlock(jInfos, "seriousIllness13",      aInfo[nX][15], aInfo[nX][34], aInfo[nX][53], lIsLegacy )
        AddJsonBlock(jInfos, "housingAllowance",      aInfo[nX][16], aInfo[nX][35], aInfo[nX][54], lIsLegacy )
        AddJsonBlock(jInfos, "doctorScholarship",     aInfo[nX][17], aInfo[nX][36], aInfo[nX][55], lIsLegacy )
        AddJsonBlock(jInfos, "doctorScholarship13",   aInfo[nX][18], aInfo[nX][37], aInfo[nX][56], lIsLegacy )
        AddJsonBlock(jInfos, "interestOnLatePayment", aInfo[nX][19], aInfo[nX][38], aInfo[nX][57], lIsLegacy )
        AddJsonBlock(jInfos, "taxExempt",             aInfo[nX][20], aInfo[nX][39], aInfo[nX][58], lIsLegacy )

        jInfos["divergent"] := jInfos["totalIrrf"]["divergent"] .OR. jInfos["taxableIncome"]["divergent"] .OR. jInfos["taxableIncome13"]["divergent"] .OR. jInfos["officialPension"]["divergent"] .OR. jInfos["officialPension13"]["divergent"] .OR.;
                               jInfos["withheldIncomeTax"]["divergent"] .OR. jInfos["withheldIncomeTax13"]["divergent"] .OR. jInfos["exemptPortionOver65"]["divergent"] .OR. jInfos["exemptPortionOver6513"]["divergent"] .OR. jInfos["dailyAllowances"]["divergent"] .OR.;
                               jInfos["costAid"]["divergent"] .OR. jInfos["terminationIndemnity"]["divergent"] .OR. jInfos["vacationBonus"]["divergent"] .OR. jInfos["seriousIllness"]["divergent"] .OR. jInfos["seriousIllness13"]["divergent"] .OR. jInfos["housingAllowance"]["divergent"] .OR.;
                               jInfos["doctorScholarship"]["divergent"] .OR. jInfos["doctorScholarship13"]["divergent"] .OR. jInfos["interestOnLatePayment"]["divergent"] .OR. jInfos["taxExempt"]["divergent"]

        aAdd(jEvenue["evenue"], jInfos)

        If !lDivergente .And. jInfos["divergent"]
            lDivergente := .T.
        EndIf

    Next nX

    // Adiciona ao pai APENAS APÓS o loop popular tudo
    aAdd(jResponse["revenueCodes"]["items"], jEvenue ) 

    // Gravação no banco
    GrvItRes( cTicket, jResponse:ToJson() , cLevel, "", "", cFilV45,,lDivergente )

    // Destruição do JSON Raiz
    FreeObj( jResponse )
    jResponse := Nil
    jEvenue   := Nil
    jInfos    := Nil
    lDivergente := .F.
    
Return 

//---------------------------------------------------------------------
/*/{Protheus.doc} AddJsonBlock
@type           Static Function
@description    Função auxiliar local para construção de blocos JSON padronizados,
                evitando repetição de código (DRY) e garantindo a lógica de divergência.
@author         Rodrigo Nicolino / Denis R. de Oliveira
@since          14/12/2025

@param          oJson,     Json,      Objeto pai que receberá o novo bloco.
@param          cKey,      Character, Chave do nó JSON a ser criado.
@param          nTaf,      Numeric,   Valor apurado no TAF.
@param          nRet,      Numeric,   Valor retornado pelo Governo.
@param          nFolha,    Numeric,   Valor apurado na Folha (Legado).
@param          lIsLegacy, Logical,   Flag que define se a divergência inclui a Folha.
@param          cLevel,    Character, Nível hierárquico para controle de gravação (ex: "1", "2", etc).
@return         Nil
/*/
//---------------------------------------------------------------------
Static Function AddJsonBlock(oJson as Json, cKey as Character, nTaf as Numeric, nRet as Numeric, nFolha as Numeric, lIsLegacy as Logical, cLevel as Character)

    Local jBlock      As Json

    Default oJson     := JsonObject():New()
    Default cKey      := ""
    Default nTaf      := 0
    Default nRet      := 0
    Default nFolha    := 0
    Default lIsLegacy := .F.
    Default cLevel    := ""

    jBlock            := JsonObject():New()

    jBlock["tafValue"]  := nTaf 
    jBlock["retValue"]  := nRet
    jBlock["erpValue"]  := nFolha
    jBlock["divergent"] := IIf( lIsLegacy, nTaf != nRet .OR. nRet != nFolha .OR. nTaf != nFolha, nTaf != nRet )

    oJson[cKey] := jBlock

    If cLevel == "3" .And. jBlock["divergent"]
        lDivergente := .T.
    EndIf

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFJsonMod1Dirf
@type           Function
@description    Gera o JSON Nível 2 (Lista de Códigos de Receita).
@author         Alexandre de Lima Santos / Denis R. de Oliveira
@since          03/12/2025
@version        1.0

@param          aInfo (Array)       - Array com as informações consolidadas.
@param          cTicket (Char)      - Ticket da requisição (ID).
@param          lIsLegacy (Log)     - Indica se deve validar divergência no modo legado.
@param          aForms (Array)      - Array com as informações de formulários.
@return         Nil
/*/
//---------------------------------------------------------------------
Function TAFJsonMod1Dirf( aInfo As Array, cTicket As Character, lIsLegacy As Logical, aForms As Array )

    //-------------------------------------------------------------------------
    // Declaração de Variáveis 
    //-------------------------------------------------------------------------
    Local aFldsV45      As Array

    Local cFilV45       As Character
    Local cLevel        As Character
    Local cKey          As Character

    Local jFormIdx      As Json
    Local jItems        As Json

    Local lDiver        As Logical

    Local nChunkIdx     As Numeric
    Local nChunkSize    As Numeric
    Local nCurrentPerc  As Numeric
    Local nLastPerc     As Numeric
    Local nLimit        As Numeric
    Local nPercEnd      As Numeric
    Local nPercRange    As Numeric
    Local nPercStart    As Numeric
    Local nTotalItems   As Numeric
    Local nTotErp       As Numeric
    Local nTotRet       As Numeric
    Local nTotTaf       As Numeric
    Local nX            As Numeric
    Local nY            As Numeric

    Local oBulkV45      As Object

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default aInfo     := {} 
    Default cTicket   := ""
    Default lIsLegacy := .F.
    Default aForms    := {}

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    aFldsV45 := { {"V45_FILIAL"}, {"V45_ID"}, {"V45_LEVEL"}, {"V45_CODREC"}, {"V45_CPF"}, {"V45_RESP"}, {"V45_DIVERG"} }

    cFilV45       := xFilial( "V45" )
    cLevel        := "2"
    cKey          := ""

    jFormIdx      := JsonObject():New()
    jItems        := Nil

    lDiver        := .F.

    nChunkIdx     := 0
    nChunkSize    := 100
    nCurrentPerc  := 0
    nLastPerc     := BAR_JSON_TOT_END
    nLimit        := 0
    nPercEnd      := BAR_JSON1_END
    nPercRange    := BAR_JSON1_END - BAR_JSON_TOT_END
    nPercStart    := BAR_JSON_TOT_END
    nTotalItems   := Len( aInfo )
    nTotErp       := 0
    nTotRet       := 0
    nTotTaf       := 0
    nX            := 0
    nY            := 0

    oBulkV45      := FWBulk():New( RetSQLName( "V45" ) )

    // Define a estrutura do Bulk
    oBulkV45:SetFields( aFldsV45 )

    //-------------------------------------------------------------------------
    // 1. Mapeamento Hash do aForms O(1)
    //-------------------------------------------------------------------------
    For nY := 1 To Len( aForms )
        cKey := "K_" + AllTrim( aForms[nY][5] ) + "_" + AllTrim( aForms[nY][3] )
        jFormIdx[ cKey ] := nY
    Next nY

    //-------------------------------------------------------------------------
    // 2. Loop Único de Processamento e Gravação
    //-------------------------------------------------------------------------
    For nChunkIdx := 1 To nTotalItems Step nChunkSize

        nLimit := Min( nChunkIdx + nChunkSize - 1, nTotalItems )

        For nX := nChunkIdx To nLimit
            
            cKey   := "K_" + AllTrim( aInfo[nX][1] ) + "_" + AllTrim( aInfo[nX][3] )
            lDiver := .F.

            // Busca a divergência pré-calculada em O(1)
            If jFormIdx:HasProperty( cKey )
                lDiver := aForms[ jFormIdx[ cKey ] ][23]
            EndIf

            // Montagem do Item JSON individual esperado pelo Front-End
            jItems := JsonObject():New()
            jItems["name"] := aInfo[nX][2]
            jItems["cpf"]  := aInfo[nX][3]

            nTotTaf := aInfo[nX][4]
            nTotRet := aInfo[nX][5]
            nTotErp := aInfo[nX][6]

            jItems["divergent"] := ( nTotTaf != nTotRet ) .Or. lDiver

            If lIsLegacy .And. !jItems["divergent"]
                jItems["divergent"] := ( nTotTaf != nTotErp ) .Or. ( nTotRet != nTotErp )
            EndIf

            jItems["totalIr"]               := JsonObject():New() 
            jItems["totalIr"]["totalIrTaf"] := nTotTaf
            jItems["totalIr"]["totalIrRet"] := nTotRet 
            jItems["totalIr"]["totalIrErp"] := nTotErp
            
            //-------------------------------------------------------------
            // Gravação do JSON em Banco
            //-------------------------------------------------------------
            GrvItRes( cTicket, jItems:ToJson(), cLevel, aInfo[nX][1], aInfo[nX][3], cFilV45, oBulkV45, jItems["divergent"] )

            FreeObj( jItems )
            jItems := Nil

            // Limpeza Incremental
            ASize( aInfo[nX], 0 )
            aInfo[nX] := Nil

        Next nX

        // Dispara o buffer para o banco de dados
        oBulkV45:Flush()

        // Atualização da Barra de Progresso
        nCurrentPerc := nPercStart + ( ( nLimit / nTotalItems ) * nPercRange )
        If !Empty( cTicket ) .And. Int( nCurrentPerc ) > Int( nLastPerc )
            setProgress( cTicket, nCurrentPerc, 100, .T., nCurrentPerc )
            nLastPerc := nCurrentPerc
            Sleep( 10 )
        EndIf

    Next nChunkIdx

    //-------------------------------------------------------------------------
    // Finalização e Limpeza de Caches
    //-------------------------------------------------------------------------
    If ValType( oBulkV45 ) == "O"
        oBulkV45:Close()
        oBulkV45:Destroy()
        FreeObj( oBulkV45 )
        oBulkV45 := Nil
    EndIf

    FreeObj( jFormIdx )
    jFormIdx := Nil

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFJsonMod2Dirf
@type           Function
@description    Gera o JSON Nível 3 (Detalhes do Empregado) e grava os resultados 
                na tabela de resposta (V45), gerenciando a barra de progresso.

@author         Alexandre de Lima Santos / Denis R. de Oliveira
@since          09/12/2025
@version        1.0

@param          aInfo,     Array,     Dados consolidados dos funcionários.
@param          cTicket,   Character, ID da requisição.
@param          lIsLegacy, Logical,   Flag de compatibilidade legado.

@return         Logical,   Sucesso da operação.
/*/
//---------------------------------------------------------------------
Function TAFJsonMod2Dirf( aInfo As Array, cTicket As Character, lIsLegacy As Logical ) As Logical

    //-------------------------------------------------------------------------
    // Declaração de Variáveis
    //-------------------------------------------------------------------------
    Local aAlimony          As Array
    Local aDepDeduc         As Array
    Local aDepDetail        As Array
    Local aDepReimb         As Array
    Local aDeps             As Array
    Local aFldsV45          As Array
    Local aHolderDetail     As Array
    Local aHolders          As Array
    Local aInfoBenefPen     As Array
    Local aInfoDedSusp      As Array
    Local aInfoValores      As Array
    Local aLegalProcessInfo As Array
    Local aPosTemp1         As Array
    Local aPosTemp2         As Array
    Local aPosTemp3         As Array
    Local aPrivatePension   As Array
    Local aReimbursements   As Array
    Local aTemp             As Array
    Local aTemp1            As Array
    Local aTemp2            As Array
    Local aTemp3            As Array

    Local cFilV45           As Character
    Local cKeyIdx           As Character
    Local cKeyIdxDep        As Character
    Local cKeyIdxDepEx      As Character
    Local cKeyIdxEx         As Character
    Local cLevel            As Character

    Local jBenefPen         As Json
    Local jDep              As Json
    Local jDepDet           As Json
    Local jDepR             As Json
    Local jHolder           As Json
    Local jHolderDet        As Json
    Local jInfoDedSusp      As Json
    Local jInfoValores      As Json
    Local jItems            As Json
    Local jMonthlySummary   As Json
    Local jPrivPens         As Json
    Local jProc             As Json
    Local jReimbursement    As Json

    Local nChunkIdx         As Numeric
    Local nChunkSize        As Numeric
    Local nCurrentPerc      As Numeric
    Local nLastPerc         As Numeric
    Local nLimit            As Numeric
    Local nPercEnd          As Numeric
    Local nPercRange        As Numeric
    Local nPercStart        As Numeric
    Local nPosY1            As Numeric
    Local nPosY2            As Numeric
    Local nPosY3            As Numeric
    Local nTotalItems       As Numeric
    Local nX                As Numeric
    Local nY                As Numeric
    Local nY1               As Numeric
    Local nY2               As Numeric
    Local nY3               As Numeric

    Local hFindNameCache    As Object
    Local oIdxProcTemp1     As Object
    Local oIdxProcTemp2     As Object
    Local oIdxProcTemp3     As Object
    Local oIdxReimbTemp1    As Object
    Local oIdxReimbTemp1Ex  As Object
    Local oIdxReimbTemp2    As Object
    Local oIdxReimbTemp2Ex  As Object
    Local oIdxReimbTemp3    As Object
    Local oIdxReimbTemp3Ex  As Object
    Local oIdxReimbUsed1    As Object
    Local oIdxReimbUsed2    As Object
    Local oIdxReimbUsed3    As Object
    Local oIdxPlaTemp1      As Object
    Local oIdxPlaTemp1Ex    As Object
    Local oIdxPlaUsed       As Object
    Local oBulkV45          As Object


    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default aInfo           := {}
    Default cTicket         := ""
    Default lIsLegacy       := .F.

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    aAlimony          := {}
    aDepDeduc         := {}
    aDepDetail        := {}
    aDepReimb         := {}
    aDeps             := {}
    aFldsV45          := { {"V45_FILIAL"}, {"V45_ID"}, {"V45_LEVEL"}, {"V45_CODREC"}, {"V45_CPF"}, {"V45_RESP"} , {"V45_DIVERG"} }
    aHolderDetail     := {}
    aHolders          := {}
    aInfoBenefPen     := {}
    aInfoDedSusp      := {}
    aInfoValores      := {}
    aLegalProcessInfo := {}
    aPosTemp1         := {}
    aPosTemp2         := {}
    aPosTemp3         := {}
    aPrivatePension   := {}
    aReimbursements   := {}
    aTemp             := {}
    aTemp1            := {}
    aTemp2            := {}
    aTemp3            := {}

    cFilV45           := xFilial( "V45" )
    cKeyIdx           := ""
    cKeyIdxDep        := ""
    cKeyIdxDepEx      := ""
    cKeyIdxEx         := ""
    cLevel            := "3"

    jBenefPen         := Nil
    jDep              := Nil
    jDepDet           := Nil
    jDepR             := Nil
    jHolder           := Nil
    jHolderDet        := Nil
    jInfoDedSusp      := Nil
    jInfoValores      := Nil
    jItems            := Nil
    jMonthlySummary   := Nil
    jPrivPens         := Nil
    jProc             := Nil
    jReimbursement    := Nil

    nChunkIdx         := 0
    nChunkSize        := 100
    nCurrentPerc      := 0
    nLastPerc         := BAR_JSON2_START
    nLimit            := 0
    nPercEnd          := BAR_JSON2_END
    nPercRange        := nPercEnd - BAR_JSON2_START
    nPercStart        := BAR_JSON2_START
    nPosY1            := 0
    nPosY2            := 0
    nPosY3            := 0
    nTotalItems       := Len( aInfo )
    nX                := 0
    nY                := 0
    nY1               := 0
    nY2               := 0
    nY3               := 0

    hFindNameCache    := THashMap():New()
    oIdxProcTemp1     := Nil
    oIdxProcTemp2     := Nil
    oIdxProcTemp3     := Nil
    oIdxReimbTemp1    := Nil
    oIdxReimbTemp1Ex  := Nil
    oIdxReimbTemp2    := Nil
    oIdxReimbTemp2Ex  := Nil
    oIdxReimbTemp3    := Nil
    oIdxReimbTemp3Ex  := Nil
    oIdxReimbUsed1    := Nil
    oIdxReimbUsed2    := Nil
    oIdxReimbUsed3    := Nil
    oIdxPlaTemp1      := Nil
    oIdxPlaTemp1Ex    := Nil
    oIdxPlaUsed       := Nil
    oBulkV45          := FWBulk():New( RetSQLName( "V45" ) )   

    // Define a estrutura do Bulk 
    oBulkV45:SetFields( aFldsV45 )

    // Sinaliza o início na barra de progresso imediatamente
    If !Empty( cTicket )
        setProgress( cTicket, nPercStart, 100, .T., nPercStart )
    EndIf

    //-------------------------------------------------------------------------
    // Loop Principal: Processamento Paginado (Chunking)
    //-------------------------------------------------------------------------
    For nChunkIdx := 1 To nTotalItems Step nChunkSize
        
        nLimit := Min( nChunkIdx + nChunkSize - 1, nTotalItems )

        For nX := nChunkIdx To nLimit
            
            jItems := JsonObject():New()
            
            jItems["period"]       := aInfo[nX][1]
            jItems["name"]         := aInfo[nX][2]
            jItems["cpf"]          := aInfo[nX][3]
            jItems["divergent"]    := .T.
            jItems["revenueCodes"] := aClone( aInfo[nX][4] ) 

            jItems["infoComplemNoContract"]                         := JsonObject():New()
            jItems["infoComplemNoContract"]["healthPlan"]           := JsonObject():New()
            jItems["infoComplemNoContract"]["medicalReimbursement"] := JsonObject():New()

            jItems["infoComplem"]                := JsonObject():New()
            jItems["infoComplem"]["revenueCode"] := aInfo[nX][5]
            
            // 1. Dedução de Dependentes
            aTemp     := aInfo[nX][6]
            aDepDeduc := {}
            For nY := 1 To Len( aTemp )
                aAdd( aDepDeduc, BuildObjVal( AllTrim( aTemp[nY][1] ), aTemp[nY][2], aTemp[nY][7], aTemp[nY][3], aTemp[nY][4], aTemp[nY][5], lIsLegacy, hFindNameCache ) )
            Next nY
            jItems["infoComplem"]["dependentDeductions"] := aDepDeduc

            // 2. Pensão Alimentícia
            aTemp    := aInfo[nX][7]
            aAlimony := {}
            For nY := 1 To Len( aTemp )
                aAdd( aAlimony, BuildObjVal( AllTrim( aTemp[nY][1] ), aTemp[nY][2], aTemp[nY][7], aTemp[nY][3], aTemp[nY][4], aTemp[nY][5], lIsLegacy, hFindNameCache ) )
            Next nY 
            jItems["infoComplem"]["alimony"] := aAlimony

            // 3. Previdência Privada
            aTemp           := aInfo[nX][8]
            aPrivatePension := {}
            For nY := 1 To Len( aTemp )
                jPrivPens := JsonObject():New() 
                jPrivPens["pensionType"] := AllTrim( aTemp[nY][1] )
                jPrivPens["cnpj"]        := AllTrim( aTemp[nY][2] )
                
                AddJsonBlock( jPrivPens, "values",               aTemp[nY][3], aTemp[nY][7],  aTemp[nY][11], lIsLegacy, cLevel )
                AddJsonBlock( jPrivPens, "values13",             aTemp[nY][4], aTemp[nY][8],  aTemp[nY][12], lIsLegacy, cLevel )
                AddJsonBlock( jPrivPens, "publicServantValue",   aTemp[nY][5], aTemp[nY][9],  aTemp[nY][13], lIsLegacy, cLevel )
                AddJsonBlock( jPrivPens, "publicServantValue13", aTemp[nY][6], aTemp[nY][10], aTemp[nY][14], lIsLegacy, cLevel )
                
                aAdd( aPrivatePension, jPrivPens )
            Next nY
            jItems["infoComplem"]["privatePension"] := aPrivatePension

            // ============================================================
            // 4. Processos Legais (Otimizado O(1))
            // ============================================================
            aLegalProcessInfo := {}
            aTemp             := aInfo[nX][9]
            aTemp1            := aInfo[nX][10]
            aTemp2            := aInfo[nX][11]
            aTemp3            := aInfo[nX][12]

            oIdxProcTemp1 := THashMap():New()
            oIdxProcTemp2 := THashMap():New()
            oIdxProcTemp3 := THashMap():New()

            For nY1 := 1 To Len( aTemp1 )
                cKeyIdx := TAFProcHdrParentKey( aTemp1[nY1][17] )
                If !Empty( cKeyIdx )
                    MapAddPos( oIdxProcTemp1, cKeyIdx, nY1 )
                EndIf
            Next nY1

            For nY2 := 1 To Len( aTemp2 )
                cKeyIdx := TAFProcValParentKey( aTemp2[nY2][9] )
                If !Empty( cKeyIdx )
                    MapAddPos( oIdxProcTemp2, cKeyIdx, nY2 )
                EndIf
            Next nY2

            For nY3 := 1 To Len( aTemp3 )
                cKeyIdx := TAFProcDedParentKey( aTemp3[nY3][5] )
                If !Empty( cKeyIdx )
                    MapAddPos( oIdxProcTemp3, cKeyIdx, nY3 )
                EndIf
            Next nY3

            For nY := 1 To Len( aTemp )
                jProc := JsonObject():New()
                jProc["processType"]    := AllTrim( aTemp[nY][1] )
                jProc["processNumber"]  := AllTrim( aTemp[nY][2] )
                jProc["suspensionCode"] := AllTrim( aTemp[nY][3] )

                aInfoValores := {}
                aPosTemp1    := MapGetPos( oIdxProcTemp1, aTemp[nY][4] )

                For nPosY1 := 1 To Len( aPosTemp1 )
                    nY1 := aPosTemp1[nPosY1]

                    jInfoValores := JsonObject():New()
                    jInfoValores["taxPeriodIndicator"] := AllTrim( aTemp1[nY1][1] )
                    AddJsonBlock( jInfoValores, "withholdingValue",               aTemp1[nY1][2], aTemp1[nY1][7],  aTemp1[nY1][12], lIsLegacy, cLevel )
                    AddJsonBlock( jInfoValores, "judicialDepositValue",           aTemp1[nY1][3], aTemp1[nY1][8],  aTemp1[nY1][13], lIsLegacy, cLevel )
                    AddJsonBlock( jInfoValores, "calendarYearCompensationValue",  aTemp1[nY1][4], aTemp1[nY1][9],  aTemp1[nY1][14], lIsLegacy, cLevel )
                    AddJsonBlock( jInfoValores, "previousYearsCompensationValue", aTemp1[nY1][5], aTemp1[nY1][10], aTemp1[nY1][15], lIsLegacy, cLevel )
                    AddJsonBlock( jInfoValores, "suspendedIncomeValue",           aTemp1[nY1][6], aTemp1[nY1][11], aTemp1[nY1][16], lIsLegacy, cLevel )

                    aInfoDedSusp := {}
                    aPosTemp2    := MapGetPos( oIdxProcTemp2, AllTrim( aTemp1[nY1][17] ) )

                    For nPosY2 := 1 To Len( aPosTemp2 )
                        nY2 := aPosTemp2[nPosY2]

                        jInfoDedSusp := JsonObject():New()
                        jInfoDedSusp["deductionIndicative"] := AllTrim( aTemp2[nY2][1] )
                        jInfoDedSusp["cnpj"]                := AllTrim( aTemp2[nY2][2] )
                        AddJsonBlock( jInfoDedSusp, "deductionValue",  aTemp2[nY2][3], aTemp2[nY2][5], aTemp2[nY2][7], lIsLegacy, cLevel )
                        AddJsonBlock( jInfoDedSusp, "contribFunpresp", aTemp2[nY2][4], aTemp2[nY2][6], aTemp2[nY2][8], lIsLegacy, cLevel )

                        aInfoBenefPen := {}
                        aPosTemp3     := MapGetPos( oIdxProcTemp3, AllTrim( aTemp2[nY2][9] ) )

                        For nPosY3 := 1 To Len( aPosTemp3 )
                            nY3 := aPosTemp3[nPosY3]

                            jBenefPen := JsonObject():New()
                            jBenefPen["cpf"] := AllTrim( aTemp3[nY3][1] )
                            AddJsonBlock( jBenefPen, "vlrDepenSusp", aTemp3[nY3][2], aTemp3[nY3][3], aTemp3[nY3][4], lIsLegacy, cLevel )
                            aAdd( aInfoBenefPen, jBenefPen )
                        Next nPosY3

                        jInfoDedSusp["infoBenefPen"] := aInfoBenefPen
                        aAdd( aInfoDedSusp, jInfoDedSusp )
                    Next nPosY2

                    jInfoValores["infoDedSusp"] := aInfoDedSusp
                    aAdd( aInfoValores, jInfoValores )
                Next nPosY1

                jProc["infoValores"] := aInfoValores
                aAdd( aLegalProcessInfo, jProc )
            Next nY

            jItems["infoComplem"]["legalProcessInfo"] := aLegalProcessInfo

            // Liberação imediata dos mapas do bloco 4
            If ValType( oIdxProcTemp1 ) == "O"; FreeObj(oIdxProcTemp1); oIdxProcTemp1 := Nil; EndIf
            If ValType( oIdxProcTemp2 ) == "O"; FreeObj(oIdxProcTemp2); oIdxProcTemp2 := Nil; EndIf
            If ValType( oIdxProcTemp3 ) == "O"; FreeObj(oIdxProcTemp3); oIdxProcTemp3 := Nil; EndIf

            // ============================================================
            // 5. Plano de Saúde
            // ============================================================
            aHolders := {}
            aTemp    := aInfo[nX][13] // PLASAU
            aTemp1   := aInfo[nX][14] // DEPSAU
            
            oIdxPlaTemp1    := THashMap():New()
            oIdxPlaTemp1Ex  := THashMap():New()
            oIdxPlaUsed     := THashMap():New()
            
            // 5.1 Indexa Dependentes (DEPSAU)
            For nY1 := 1 To Len( aTemp1 )
                cKeyIdx := TAFRelHealthHolderKey( aTemp1[nY1][6] )
                If !Empty( cKeyIdx )
                    MapAddPos( oIdxPlaTemp1, cKeyIdx, nY1 )
                EndIf

                cKeyIdxEx := TAFRelHealthHolderKeyEx( aTemp1[nY1][6] )
                If !Empty( cKeyIdxEx )
                    MapAddPos( oIdxPlaTemp1Ex, cKeyIdxEx, nY1 )
                EndIf
            Next nY1

            // 5.2 Processa Titulares (PLASAU)
            For nY := 1 To Len( aTemp )
                jHolder := JsonObject():New() 
                jHolder["cpf"]     := AllTrim( aTemp[nY][1] )
                jHolder["cnpj"]    := AllTrim( aTemp[nY][2] )
                jHolder["ansCode"] := AllTrim( aTemp[nY][3] )
                AddJsonBlock( jHolder, "values", aTemp[nY][4], aTemp[nY][5], aTemp[nY][6], lIsLegacy, cLevel )
                
                aDeps := {}

                cKeyIdx   := TAFRelHealthHolderKey( aTemp[nY][7] )
                cKeyIdxEx := TAFRelHealthHolderKeyEx( aTemp[nY][7] )
                aPosTemp1 := TAFMapGetAvailPos( oIdxPlaTemp1Ex, cKeyIdxEx, oIdxPlaTemp1, cKeyIdx, oIdxPlaUsed )

                For nPosY1 := 1 To Len( aPosTemp1 )
                    nY1 := aPosTemp1[nPosY1]
                    jDep := JsonObject():New() 
                    jDep["cpf"] := AllTrim( aTemp1[nY1][1] )
                    AddJsonBlock( jDep, "values", aTemp1[nY1][3], aTemp1[nY1][4], aTemp1[nY1][5], lIsLegacy, cLevel )
                    aAdd( aDeps, jDep )
                Next nPosY1

                TAFMapMarkUsedPos( oIdxPlaUsed, aPosTemp1 )
                jHolder["dependents"] := aDeps
                aAdd( aHolders, jHolder )
            Next nY
            
            jItems["infoComplemNoContract"]["healthPlan"]["holders"] := aHolders
            
            If ValType( oIdxPlaTemp1 ) == "O";   oIdxPlaTemp1:Clean();   FreeObj(oIdxPlaTemp1);   oIdxPlaTemp1   := Nil; EndIf
            If ValType( oIdxPlaTemp1Ex ) == "O"; oIdxPlaTemp1Ex:Clean(); FreeObj(oIdxPlaTemp1Ex); oIdxPlaTemp1Ex := Nil; EndIf
            If ValType( oIdxPlaUsed ) == "O";    oIdxPlaUsed:Clean();    FreeObj(oIdxPlaUsed);    oIdxPlaUsed    := Nil; EndIf

            // ============================================================
            // 6. Reembolsos
            // ============================================================
            aReimbursements := {}
            aTemp           := aInfo[nX][15] // REMMED
            aTemp1          := aInfo[nX][16] // REMTID
            aTemp2          := aInfo[nX][17] // REMDEP
            aTemp3          := aInfo[nX][18] // DETDEP

            oIdxReimbTemp1    := THashMap():New()
            oIdxReimbTemp1Ex  := THashMap():New()
            oIdxReimbTemp2    := THashMap():New()
            oIdxReimbTemp2Ex  := THashMap():New()
            oIdxReimbTemp3    := THashMap():New()
            oIdxReimbTemp3Ex  := THashMap():New()
            oIdxReimbUsed1    := THashMap():New()
            oIdxReimbUsed2    := THashMap():New()
            oIdxReimbUsed3    := THashMap():New()

            // 6.1 Indexa Detalhes do Titular (REMTID)
            For nY1 := 1 To Len( aTemp1 )
                cKeyIdx := TAFRelReimbHeaderKey( aTemp1[nY1][9] )
                If !Empty( cKeyIdx )
                    MapAddPos( oIdxReimbTemp1, cKeyIdx, nY1 )
                EndIf

                cKeyIdxEx := TAFRelReimbHeaderKeyEx( aTemp1[nY1][9] )
                If !Empty( cKeyIdxEx )
                    MapAddPos( oIdxReimbTemp1Ex, cKeyIdxEx, nY1 )
                EndIf
            Next nY1

            // 6.2 Indexa Cabecalho do Dependente (REMDEP) pela chave do Cabecalho
            For nY2 := 1 To Len( aTemp2 )
                cKeyIdx := TAFRelReimbHeaderKey( aTemp2[nY2][2] )
                If !Empty( cKeyIdx )
                    MapAddPos( oIdxReimbTemp2, cKeyIdx, nY2 )
                EndIf

                cKeyIdxEx := TAFRelReimbHeaderKeyEx( aTemp2[nY2][2] )
                If !Empty( cKeyIdxEx )
                    MapAddPos( oIdxReimbTemp2Ex, cKeyIdxEx, nY2 )
                EndIf
            Next nY2

            // 6.3 Indexa Detalhes do Dependente (DETDEP) pela chave do Dependente
            For nY3 := 1 To Len( aTemp3 )
                cKeyIdx := TAFRelReimbDepKey( aTemp3[nY3][9] )
                If !Empty( cKeyIdx )
                    MapAddPos( oIdxReimbTemp3, cKeyIdx, nY3 )
                EndIf

                cKeyIdxEx := TAFRelReimbDepKeyEx( aTemp3[nY3][9] )
                If !Empty( cKeyIdxEx )
                    MapAddPos( oIdxReimbTemp3Ex, cKeyIdxEx, nY3 )
                EndIf
            Next nY3

            // 6.4 Processa Cabeçalhos de Reembolso (REMMED)
            For nY := 1 To Len( aTemp )
                jReimbursement := JsonObject():New()
                jReimbursement["originOfRefund"]     := AllTrim( aTemp[nY][1] )
                jReimbursement["registrationNumber"] := AllTrim( aTemp[nY][2] )
                jReimbursement["ansCode"]            := AllTrim( aTemp[nY][3] )

                cKeyIdx   := TAFRelReimbHeaderKey( aTemp[nY][4] )
                cKeyIdxEx := TAFRelReimbHeaderKeyEx( aTemp[nY][4] )

                // Detalhes do Titular
                aHolderDetail := {}
                aPosTemp1 := TAFMapGetAvailPos( oIdxReimbTemp1Ex, cKeyIdxEx, oIdxReimbTemp1, cKeyIdx, oIdxReimbUsed1 )
                For nPosY1 := 1 To Len( aPosTemp1 )
                    nY1 := aPosTemp1[nPosY1]
                    jHolderDet := JsonObject():New()
                    jHolderDet["registrationType"]   := AllTrim( aTemp1[nY1][1] )
                    jHolderDet["registrationNumber"] := AllTrim( aTemp1[nY1][2] )
                    AddJsonBlock( jHolderDet, "values",         aTemp1[nY1][3], aTemp1[nY1][5], aTemp1[nY1][7], lIsLegacy, cLevel )
                    AddJsonBlock( jHolderDet, "previousValues", aTemp1[nY1][4], aTemp1[nY1][6], aTemp1[nY1][8], lIsLegacy, cLevel )
                    aAdd( aHolderDetail, jHolderDet )
                Next nPosY1
                TAFMapMarkUsedPos( oIdxReimbUsed1, aPosTemp1 )
                jReimbursement["holderDetail"] := aHolderDetail

                // Reembolso de Dependentes
                aDepReimb := {}
                aPosTemp2 := TAFMapGetAvailPos( oIdxReimbTemp2Ex, cKeyIdxEx, oIdxReimbTemp2, cKeyIdx, oIdxReimbUsed2 )
                For nPosY2 := 1 To Len( aPosTemp2 )
                    nY2 := aPosTemp2[nPosY2]
                    jDepR := JsonObject():New()
                    jDepR["cpf"] := AllTrim( aTemp2[nY2][1] )

                    cKeyIdxDep   := TAFRelReimbDepKey( aTemp2[nY2][2] )
                    cKeyIdxDepEx := TAFRelReimbDepKeyEx( aTemp2[nY2][2] )

                    aDepDetail := {}
                    aPosTemp3  := TAFMapGetAvailPos( oIdxReimbTemp3Ex, cKeyIdxDepEx, oIdxReimbTemp3, cKeyIdxDep, oIdxReimbUsed3 )
                    For nPosY3 := 1 To Len( aPosTemp3 )
                        nY3 := aPosTemp3[nPosY3]
                        jDepDet := JsonObject():New()
                        jDepDet["registrationType"]   := AllTrim( aTemp3[nY3][1] )
                        jDepDet["registrationNumber"] := AllTrim( aTemp3[nY3][2] )
                        AddJsonBlock( jDepDet, "values",         aTemp3[nY3][3], aTemp3[nY3][5], aTemp3[nY3][7], lIsLegacy, cLevel )
                        AddJsonBlock( jDepDet, "previousValues", aTemp3[nY3][4], aTemp3[nY3][6], aTemp3[nY3][8], lIsLegacy, cLevel )
                        aAdd( aDepDetail, jDepDet )
                    Next nPosY3
                    TAFMapMarkUsedPos( oIdxReimbUsed3, aPosTemp3 )

                    jDepR["dependentDetail"] := aDepDetail
                    aAdd( aDepReimb, jDepR )
                Next nPosY2
                TAFMapMarkUsedPos( oIdxReimbUsed2, aPosTemp2 )

                jReimbursement["reimbursementDependent"] := aDepReimb
                aAdd( aReimbursements, jReimbursement )
            Next nY

            jItems["infoComplemNoContract"]["medicalReimbursement"]["reimbursements"] := aReimbursements

            // Liberação imediata dos mapas do bloco 6
            If ValType( oIdxReimbTemp1 ) == "O"; oIdxReimbTemp1:Clean(); FreeObj(oIdxReimbTemp1); oIdxReimbTemp1 := Nil; EndIf
            If ValType( oIdxReimbTemp2 ) == "O"; oIdxReimbTemp2:Clean(); FreeObj(oIdxReimbTemp2); oIdxReimbTemp2 := Nil; EndIf
            If ValType( oIdxReimbTemp3 ) == "O"; oIdxReimbTemp3:Clean(); FreeObj(oIdxReimbTemp3); oIdxReimbTemp3 := Nil; EndIf
            If ValType( oIdxReimbTemp1Ex ) == "O"; oIdxReimbTemp1Ex:Clean(); FreeObj(oIdxReimbTemp1Ex); oIdxReimbTemp1Ex := Nil; EndIf
            If ValType( oIdxReimbTemp2Ex ) == "O"; oIdxReimbTemp2Ex:Clean(); FreeObj(oIdxReimbTemp2Ex); oIdxReimbTemp2Ex := Nil; EndIf
            If ValType( oIdxReimbTemp3Ex ) == "O"; oIdxReimbTemp3Ex:Clean(); FreeObj(oIdxReimbTemp3Ex); oIdxReimbTemp3Ex := Nil; EndIf
            If ValType( oIdxReimbUsed1 ) == "O";   oIdxReimbUsed1:Clean();   FreeObj(oIdxReimbUsed1);   oIdxReimbUsed1   := Nil; EndIf
            If ValType( oIdxReimbUsed2 ) == "O";   oIdxReimbUsed2:Clean();   FreeObj(oIdxReimbUsed2);   oIdxReimbUsed2   := Nil; EndIf
            If ValType( oIdxReimbUsed3 ) == "O";   oIdxReimbUsed3:Clean();   FreeObj(oIdxReimbUsed3);   oIdxReimbUsed3   := Nil; EndIf
            
            // ============================================================
            // 7. Monthly Summary
            // ============================================================
            aTemp := aInfo[nX][19]
            
            For nY := 1 To Len( aTemp )
                
                jMonthlySummary := JsonObject():New() 
                
                AddJsonBlock( jMonthlySummary, "taxableIncome",         aTemp[nY][3],  aTemp[nY][22], aTemp[nY][41], lIsLegacy, cLevel )
                AddJsonBlock( jMonthlySummary, "taxableIncome13",       aTemp[nY][4],  aTemp[nY][23], aTemp[nY][42], lIsLegacy, cLevel )
                AddJsonBlock( jMonthlySummary, "officialPension",       aTemp[nY][5],  aTemp[nY][24], aTemp[nY][43], lIsLegacy, cLevel )
                AddJsonBlock( jMonthlySummary, "officialPension13",     aTemp[nY][6],  aTemp[nY][25], aTemp[nY][44], lIsLegacy, cLevel )
                AddJsonBlock( jMonthlySummary, "withheldIncomeTax",     aTemp[nY][7],  aTemp[nY][26], aTemp[nY][45], lIsLegacy, cLevel )
                AddJsonBlock( jMonthlySummary, "withheldIncomeTax13",   aTemp[nY][8],  aTemp[nY][27], aTemp[nY][46], lIsLegacy, cLevel )
                AddJsonBlock( jMonthlySummary, "exemptPortionOver65",   aTemp[nY][9],  aTemp[nY][28], aTemp[nY][47], lIsLegacy, cLevel )
                AddJsonBlock( jMonthlySummary, "exemptPortionOver6513", aTemp[nY][10], aTemp[nY][29], aTemp[nY][48], lIsLegacy, cLevel )
                AddJsonBlock( jMonthlySummary, "dailyAllowances",       aTemp[nY][11], aTemp[nY][30], aTemp[nY][49], lIsLegacy, cLevel )
                AddJsonBlock( jMonthlySummary, "costAid",               aTemp[nY][12], aTemp[nY][31], aTemp[nY][50], lIsLegacy, cLevel )
                AddJsonBlock( jMonthlySummary, "terminationIndemnity",  aTemp[nY][13], aTemp[nY][32], aTemp[nY][51], lIsLegacy, cLevel )
                AddJsonBlock( jMonthlySummary, "vacationBonus",         aTemp[nY][14], aTemp[nY][33], aTemp[nY][52], lIsLegacy, cLevel )
                AddJsonBlock( jMonthlySummary, "seriousIllness",        aTemp[nY][15], aTemp[nY][34], aTemp[nY][53], lIsLegacy, cLevel )
                AddJsonBlock( jMonthlySummary, "seriousIllness13",      aTemp[nY][16], aTemp[nY][35], aTemp[nY][54], lIsLegacy, cLevel )
                AddJsonBlock( jMonthlySummary, "housingAllowance",      aTemp[nY][17], aTemp[nY][36], aTemp[nY][55], lIsLegacy, cLevel )
                AddJsonBlock( jMonthlySummary, "doctorScholarship",     aTemp[nY][18], aTemp[nY][37], aTemp[nY][56], lIsLegacy, cLevel )
                AddJsonBlock( jMonthlySummary, "doctorScholarship13",   aTemp[nY][19], aTemp[nY][38], aTemp[nY][57], lIsLegacy, cLevel )
                AddJsonBlock( jMonthlySummary, "interestOnLatePayment", aTemp[nY][20], aTemp[nY][39], aTemp[nY][58], lIsLegacy, cLevel )
                AddJsonBlock( jMonthlySummary, "taxExempt",             aTemp[nY][21], aTemp[nY][40], aTemp[nY][59], lIsLegacy, cLevel )
                
                jItems["infoComplemNoContract"]["monthlySummary"] := jMonthlySummary

            Next nY

            //-------------------------------------------------------------
            // Gravação do JSON em Banco
            //-------------------------------------------------------------
            GrvItRes( cTicket, jItems:ToJson(), cLevel, aInfo[nX][5], aInfo[nX][3], cFilV45, oBulkV45, lDivergente )

            lDivergente := .F.

            FreeObj( jItems )
            jItems := Nil

            // Limpeza Incremental
            ASize( aInfo[nX], 0 )
            aInfo[nX] := Nil

        Next nX

        // Dispara o buffer para o banco de dados
        oBulkV45:Flush()

        //-------------------------------------------------------------
        // Atualização da Barra de Progresso
        //-------------------------------------------------------------
        nCurrentPerc := nPercStart + ( ( nLimit / nTotalItems ) * nPercRange )
        If !Empty( cTicket ) .And. Int( nCurrentPerc ) > Int( nLastPerc )
            setProgress( cTicket, nCurrentPerc, 100, .T., nCurrentPerc )
            nLastPerc := nCurrentPerc
            Sleep( 10 )
        EndIf

    Next nChunkIdx

    //-------------------------------------------------------------------------
    // Finalização e Limpeza de Caches
    //-------------------------------------------------------------------------
    If ValType( oBulkV45 ) == "O"
        oBulkV45:Close()
        oBulkV45:Destroy()
        FreeObj( oBulkV45 )
        oBulkV45 := Nil
    EndIf

    If ValType( hFindNameCache ) == "O"
        hFindNameCache:Clean()
        FreeObj( hFindNameCache )
    EndIf

Return .T.

//---------------------------------------------------------------------
/*/{Protheus.doc} BuildObjVal
@type           Static function
@description    Helper para construir objetos repetitivos em TAFJsonMod2
@author         Rodrigo Nicolino
@since          14/12/2025

@param          cIncType,       Character, Tipo de rendimento.
@param          cCpf,           Character, CPF do funcionário/dependente.
@param          cFil,           Character, Filial de processamento.
@param          nTaf,           Numeric,   Valor apurado pelo TAF.
@param          nRet,           Numeric,   Valor do retorno (Governo).
@param          nFolha,         Numeric,   Valor da folha de pagamento.
@param          lIsLegacy,      Logical,   Flag indicando uso da rotina legada.
@param          hFindNameCache, Object,    Objeto Hash para cache de nomes.
@return         Json,           Objeto JSON construído.
/*/
//---------------------------------------------------------------------
Static Function BuildObjVal( cIncType As Character, cCpf As Character, cFil As Character, nTaf As Numeric, nRet As Numeric, nFolha As Numeric, lIsLegacy As Logical, hFindNameCache As Object )

    Local oObj As Json

    Default cIncType        := ""
    Default cCpf            := ""
    Default cFil            := ""
    Default nTaf            := 0
    Default nRet            := 0
    Default nFolha          := 0
    Default lIsLegacy       := .F.
    Default hFindNameCache  := Nil

    oObj := JsonObject():New()

    oObj["incomeType"]  := cIncType
    oObj["name"]        := AllTrim( TAFFindNameCache( cCpf, cFil, hFindNameCache ) )
    oObj["cpf"]         := cCpf

    AddJsonBlock( oObj, "values", nTaf, nRet, nFolha, lIsLegacy )

Return oObj

//---------------------------------------------------------------------
/*/{Protheus.doc} GrvItRes
Grava o resultado do processamento na tabela V45 (Cache de Resposta).

@type    static function
@author  Alexandre de Lima Santos / Denis R. de Oliveira
@since   09/12/2025
@version 1.0

@param   cTicket, Character, Ticket da requisição.
@param   cResp,   Character, Conteúdo JSON da resposta.
@param   cLevel,  Character, Nível do JSON (1, 2 ou 3).
@param   cCodRec, Character, Código de Receita (Opcional).
@param   cCpf,    Character, CPF do funcionário (Opcional).
@param   oBulkV45,Objeto   , Objeto do Bulk 
/*/
//---------------------------------------------------------------------
Static Function GrvItRes( cTicket as Character, cResp as Character, cLevel as Character, cCodRec as Character, cCpf as Character, cFilV45 as Character, oBulkV45 as Object, lDiverg as Logical )

    Local oJson    as object
    Local lChanged as Logical
    Local nI       as Numeric
    Local nJ       as Numeric

    Default cTicket  := ""
    Default cResp    := ""
    Default cLevel   := ""
    Default cCodRec  := ""
    Default cCpf     := ""
    Default cFilV45  := ""
    Default lDiverg  := .F.
    Default oBulkV45 := Nil

    oJson    := JsonObject():New()
    lChanged := .F.
    nI       := 0
    nJ       := 0
  
    // Se recebeu o objeto FWBulk, joga pra memória
    If ValType( oBulkV45 ) == "O"
        // A ordem dos campos DEVE ser igual a do SetFields criado na Mod2
        oBulkV45:AddData( { cFilV45, cTicket, cLevel, cCodRec, cCpf, cResp, IIF( lDiverg, "1", "2" ) } )
    Else
        // Fallback: Gravação normal
        RecLock( "V45", .T. ) 
        V45->V45_FILIAL := cFilV45
        V45->V45_ID     := cTicket
        V45->V45_LEVEL  := cLevel
        V45->V45_CODREC := cCodRec
        V45->V45_CPF    := cCpf
        V45->V45_RESP   := cResp
        V45->V45_DIVERG := IIF( lDiverg, "1", "2" )
        V45->( MsUnlock() )
    EndIf

    If cLevel == "3" .And. lDiverg
        V45->( DbSetOrder(4) )

        If V45->( DBSeek( cFilV45 + cTicket + "1" ) )

            oJson:FromJson( V45->V45_RESP )
            If oJson:HasProperty("revenueCodes") .And. ValType(oJson["revenueCodes"]["items"]) == "A"
                
                For nI := 1 To Len(oJson["revenueCodes"]["items"])
                    If ValType(oJson["revenueCodes"]["items"][nI]["evenue"]) == "A"
                        
                        For nJ := 1 To Len(oJson["revenueCodes"]["items"][nI]["evenue"])

                            If oJson["revenueCodes"]["items"][nI]["evenue"][nJ]["revenueCode"] == cCodRec
                                oJson["revenueCodes"]["items"][nI]["evenue"][nJ]["divergent"] := .T.
                                lChanged := .T.
                            EndIf
                            
                        Next nJ
                    EndIf
                Next nI
            EndIf

            If lChanged

                RecLock( "V45", .F. ) 
                V45->V45_RESP   := oJson:ToJson()
                V45->V45_DIVERG := "1" 
                V45->( MsUnlock() )
                
            EndIf
            
            FreeObj(oJson)
            oJson := Nil

        EndIf 
    EndIf
Return

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFFindName
@type           Static Function
@description    Busca o nome do dependente em diversas tabelas do sistema.
@author         Alexandre lima
@since          03/12/2025
/*/  
//---------------------------------------------------------------------  
Static Function TAFFindName( cCpf as Character, cFil as Character )

    Local cName as Character

    Default cCpf := ""
    Default cFil := ""

    cName := Posicione( "V7S", 3, PadR((xFilial("V7S", cFil)),FWSizeFilial()) + cCpf, "V7S_NMDEP" )

    If Empty( Alltrim( cName ) )
        cName := Posicione( "C9Y", 3, Padr(xFilial("C9Y", cFil),FWSizeFilial()) + cCpf, "C9Y_NOMDEP" )
    EndIf

    If Empty( Alltrim( cName ) )
        cName := Posicione( "T3T", 2, Padr(xFilial("T3T", cFil),FWSizeFilial()) + cCpf, "T3T_NOMDEP" )
    EndIf

    If Empty( Alltrim( cName ) )
        cName := Posicione( "T2F", 3, Padr(xFilial("T2F", cFil),FWSizeFilial()) + cCpf, "T2F_NOMDEP" )
    EndIf

    If Empty( Alltrim( cName ) )
        cName := Posicione( "V74", 3, Padr(xFilial("V74", cFil),FWSizeFilial()) + cCpf, "V74_NMDEP" )
    EndIf

Return Alltrim( cName )

//---------------------------------------------------------------------
/*/{Protheus.doc} GetFilRH
@type           Function
@description    Realiza o de-para das filiais do TAF com as coligadas do RH.
                Consome API REST para buscar o ID da companhia (CompanyID).

@author         Matheus Prada / Denis R. de Oliveira
@since          23/09/2020
@version        1.0

@param          aHeader, Array, Cabeçalhos da requisição HTTP (Authorization, etc).
@return         xResponse, Variant, Retorna o ID da empresa (Char) ou Vazio ("") em caso de falha.
/*/
//---------------------------------------------------------------------
Function GetFilRH(aHeader as array)

    //-------------------------------------------------------------------------
    // Declaração de Variáveis
    //-------------------------------------------------------------------------
	Local aInfoFilial 	as array
	Local cAPI			as character
	Local cURLErp		as character
	Local oRest			as object
	Local oResponse		as object
	Local xResponse		as variant

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default aHeader     := {}

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    aInfoFilial := TAFGFilMatriz()
	cAPI		:= "/api/rh/esocial/v1/reportEsocialBaseConfer/company/"
	cURLErp		:= GetNewPar("MV_TAFRHUR")
	oRest		:= Nil
	oResponse	:= Nil
	xResponse	:= Nil

    //-------------------------------------------------------------------------
    // Construção da Requisição
    //-------------------------------------------------------------------------
    TAFConOut( "[GetFilRH] Iniciando requisicao HTTP (Get CompanyID)..." )

	oRest := FWRest():New(cURLErp)
	
	If Len(aInfoFilial) == 8
		oRest:SetPath(cAPI + StrTran(aInfoFilial[8], " ", "%20"))
	Else
		oRest:SetPath(cAPI + StrTran(cEmpAnt, " ", "%20") + StrTran(cFilAnt, " ", "%20"))
	EndIf

	//-------------------------------------------------------------------------
    // Execução (GET)
    //-------------------------------------------------------------------------
	If oRest:Get(aHeader)

		oResponse := JsonObject():New()

		oResponse:FromJSON(oRest:GetResult())

		xResponse := oResponse["companyId"]

	Else

		TAFConOut("[" + ProcName() + "] " + oRest:GetLastError() + ": Falha na conexão com a API do software de RH. API indisponível: " + cURLErp + cAPI)

		/*If ProcName(1) == "GET_LEGACYSTATUS"
			xResponse := "(ERRO " +  oRest:GetLastError() + ") Mensagem: " + IIF(oRest:GetResult() == Nil,"undefined", oRest:GetResult())
		EndIf*/

	EndIf

    //-------------------------------------------------------------------------
    // Limpeza de Memória
    //-------------------------------------------------------------------------
    FreeObj( oResponse )
    FreeObj( oRest )

Return xResponse

//---------------------------------------------------------------------
/*/{Protheus.doc} GetRHValuesDirf
@type           Function
@description    Orquestra a integração da DIRF/IRRF com o RH.
                Realiza o fluxo completo de comunicação assíncrona:
                1. Solicitação de Cálculo (POST)
                2. Aguarda processamento (Polling/GET Status) com Timeout de segurança.
                3. Busca resultados paginados (GET)
                4. Despacha para gravação (ProcessaIrrfRh)

@param          oJson,      Json,      Objeto contendo filtros e parâmetros da requisição.
@param          cPeriod,    Character, Período de apuração (AAAAMM).
@param          lGrvRH,     Logical,   Indica se deve gravar os dados nas tabelas do TAF (.T.).
@param          cIDV3J,     Character, ID da requisição na tabela de controle V3J.
@param          cCompanyID, Character, ID da empresa no software de RH.
@param          aHeader,    Array,     Cabeçalhos HTTP para autenticação e controle.
@param          nPercMin,   Numeric,   Percentual inicial da barra nesta fase.
@param          nPercMax,   Numeric,   Percentual final da barra nesta fase.
@return         Logical,    Verdadeiro caso a operação flua corretamente.

@author         Denis R. de Oliveira
@since          26/01/2026
@version        1.0
/*/
//---------------------------------------------------------------------
Function GetRHValuesDirf( oJson as Json, cPeriod as Character, lGrvRH as Logical, cIDV3J as Character, cCompanyID as Character, aHeader as Array, nPercMin as Numeric, nPercMax as Numeric ) as Logical

    //-------------------------------------------------------------------------
    // Declaração de Variáveis
    //-------------------------------------------------------------------------
    Local lIsFinish     as Logical
    Local lHasNext      as Logical
    Local nPage         as Numeric
    
    Local cTicket       as Character
    Local cError        as Character
    
    Local cPath         as Character
    Local cURLErp       as Character
    Local cEndpoint     as Character
    Local cCodRec       as Character
    Local cCpf          as Character
    
    Local jResponse     as Json

    Local nVirtualTotal as Numeric
    Local nPercAbs      as Numeric
    Local nPercRange    as Numeric
    Local nCurrent      as Numeric

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default oJson       := JsonObject():New()
    Default cPeriod     := ""
    Default lGrvRH      := .F.
    Default cIDV3J      := ""
    Default cCompanyID  := ""
    Default aHeader     := {}
    Default nPercMin    := 5
    Default nPercMax    := 25

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis Locais
    //-------------------------------------------------------------------------
    lIsFinish       := .F.
    lHasNext        := .T.
    nPage           := 0

    cTicket         := ""
    cError          := ""
    
    cPath           := "/api/rh/esocial/v1/reportEsocialIrrfRevenueCodes"
    cURLErp         := GetNewPar( "MV_TAFRHUR", "" )
    cEndpoint       := "exportEmployeeDetails" // Endpoint de busca de detalhes
    cCodRec         := ""
    cCpf            := ""

    jResponse       := Nil

    nVirtualTotal   := 10
    nPercAbs        := 0
    nPercRange      := nPercMax - nPercMin
    nCurrent        := 0

    //-------------------------------------------------------------------------
    // 1. Solicitação de Cálculo (POST Inicial)
    //-------------------------------------------------------------------------
    // Envia cTribute="3" fixo para garantir que o RH calcule IRRF.
    cTicket := CallInitDirf( cURLErp, cPath, cCompanyID, cPeriod, @cCodRec, @cCPF, @cError, aHeader )
    
    If !Empty( cTicket )
        
        //---------------------------------------------------------------------
        // 3. Polling (Espera Ativa com Timeout)
        //---------------------------------------------------------------------
        // Polling consome a faixa de 5% a 8%
        lIsFinish := IsFinishedDirf( cURLErp, cPath, cTicket, cIDV3J, aHeader, nPercMin, nPercMax, @lGrvRH )
        While !lIsFinish
            lIsFinish := IsFinishedDirf( cURLErp, cPath, cTicket, cIDV3J, aHeader, nPercMin, nPercMax, @lGrvRH  )
        EndDo
        //---------------------------------------------------------------------
        // 4. Busca dos Resultados e Gravação (Paginação)
        //---------------------------------------------------------------------
        If lGrvRH

            While lHasNext
                
                nPage++
                
                // Busca página atual de resultados
                jResponse := GetResultDirf( cURLErp, cPath, cCompanyID, cTicket, cPeriod, cCodRec, cCpf, nPage, aHeader, cEndpoint )

                // Valida se a resposta é um Objeto/JSON válido antes de prosseguir
                If ( ValType( jResponse ) == "J" .Or. ValType( jResponse ) == "O" )
                    
                    // Verifica se contém itens para processar
                    If jResponse:HasProperty( "items" ) .And. ValType( jResponse["items"] ) == "A" .And. Len( jResponse["items"] ) > 0
                        
                        //---------------------------------------------------------
                        // Processamento do Lote (Persistência na T8R)
                        //---------------------------------------------------------
                        ProcessaIrrfRh( jResponse, cIDV3J )
                        
                    EndIf

                    //-------------------------------------------------------------
                    // Controle de Paginação
                    //-------------------------------------------------------------
                    If jResponse:HasProperty( "hasNext" )
                        lHasNext := jResponse["hasNext"]
                    Else
                        lHasNext := .F.
                    EndIf

                EndIf

                // --- Cálculo Dinâmico da Barra (Download da API) ---
                // Se a API retornar totalPages, usamos. Se não, estimamos.
                If jResponse:HasProperty("totalPages") .And. Val(cValToChar(jResponse["totalPages"])) > 0
                     nVirtualTotal := Val(cValToChar(jResponse["totalPages"]))
                Else
                     If nPage >= nVirtualTotal; nVirtualTotal := nPage + 2; EndIf
                EndIf

                // Proporção dentro do Range
                nCurrent := ( nPage / nVirtualTotal ) * nPercRange
                nPercAbs := nPercMin + nCurrent
                
                If nPercAbs > nPercMax; nPercAbs := nPercMax; EndIf
                
                setProgress( cIDV3J, nPercAbs, 100, .T., nPercAbs )
                
                FreeObj( jResponse )
                jResponse := Nil

            EndDo

        EndIf

    EndIf

Return .T.

//---------------------------------------------------------------------
/*/{Protheus.doc} CallInitDirf
@type           Function
@description    Realiza a requisição inicial (POST) para solicitar o cálculo dos dados no RH.
                Especializada para o contexto DIRF/IRRF (Tributo 3).
                Monta o JSON com os filtros e envia para a API.

@param          cURLErp,    Character, URL base do ERP (RM/Datasul).
@param          cPath,      Character, Caminho base da API.
@param          cCompanyID, Character, ID da Empresa no RH.
@param          cPeriod,    Character, Período de apuração (AAAAMM).
@param          cCodRec     Character, Lista de Código de Receita (Filtro Opcional).
@param          cCPF,       Character, Lista de CPFs (Filtro Opcional).
@param          cError,     Character, Variável de referência para retorno de mensagem de erro.
@param          aHeader,    Array,     Cabeçalhos da requisição HTTP.

@return         Character,  Ticket (RequestID) gerado pelo RH ou vazio em caso de erro.

@author         Denis R. de Oliveira
@since          26/01/2026
@version        1.0
/*/
//---------------------------------------------------------------------
Function CallInitDirf( cURLErp as Character, cPath as Character, cCompanyID as Character, cPeriod as Character, cCodRec as Character, cCPF as Character, cError as Character, aHeader as Array )

    //-------------------------------------------------------------------------
    // Declaração de Variáveis
    //-------------------------------------------------------------------------
    Local cTicket   as Character
    Local oRest     as Object
    Local oRequest  as Json
    Local jResponse as Json

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default cURLErp     := ""
    Default cPath       := ""
    Default cCompanyID  := ""
    Default cPeriod     := ""
    Default cCodRec     := ""
    Default cCPF        := ""
    Default cError      := ""
    Default aHeader     := {}

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    cTicket   := ""
    oRest     := FWRest():New( cURLErp )

    oRequest  := JsonObject():New()
    jResponse := JsonObject():New()

    // Configuração do Endpoint
    oRest:SetPath( cPath )
    
    //-------------------------------------------------------------------------
    // Montagem do Payload (Body)
    //-------------------------------------------------------------------------
    // Parâmetros Obrigatórios
    oRequest["companyId"]     := cCompanyID
    oRequest["period"] := StrTran( cPeriod, "-", "" )

    // Parâmetros Opcionais (Filtros) - Só adiciona se tiver conteúdo
    If ValType(cCodRec) <> "U" .And. ValType(cCodRec) == "C"
		oRequest["revenueCodes"] := cCodRec
	EndIf

	If ValType(cCPF) <> "U" .And. ValType(cCPF) == "C"
		oRequest["cpf"] := cCPF
	EndIf

    // Log para Debug e Rastreabilidade
    TafConOut( "[CallInitDirf] URL: " + cURLErp + cPath )
    TafConOut( "[CallInitDirf] Body Request: " + oRequest:ToJson() )

    //-------------------------------------------------------------------------
    // Execução da Requisição (POST)
    //-------------------------------------------------------------------------
    oRest:SetPostParams( oRequest:ToJson() )

    If oRest:Post( aHeader )
        
        jResponse:FromJson( oRest:GetResult() )
        cTicket := jResponse["requestId"]
        
    EndIf

    //-------------------------------------------------------------------------
    // Limpeza de Memória
    //-------------------------------------------------------------------------
    FreeObj( oRest )
    oRest := Nil

    FreeObj( oRequest )
    oRequest := Nil

    FreeObj( jResponse )
    jResponse := Nil

Return cTicket

//---------------------------------------------------------------------
/*/{Protheus.doc} IsFinishedDirf
@type			function
@description	Retorna por referência o objeto serializado, contendo os valores de RH
@author			Victor A. Barbosa / Denis R. de Oliveira
@since			22/11/2019

@param          cURLErp,    Character, URL do ERP.
@param          cPath,      Character, Path principal para o Endpoint.
@param          cTicket,    Character, Ticket a ser consultado o percentual.
@param          cTicketV3J, Character, ID da requisição na tabela V3J.
@param          aHeader,    Array,     Cabeçalho da requisição.
@param          nPercMin,   Numeric,   Percentual mínimo da barra para esta fase.
@param          nPercMax,   Numeric,   Percentual máximo da barra para esta fase.
@param          lGrvRH,     Logical,   Flag passada por referência indicando sucesso na conexão.
@return         Logical,    Indica se a API retornou que o cálculo foi concluído.
/*/
//---------------------------------------------------------------------
Function IsFinishedDirf( cURLErp as Character, cPath as Character, cTicket as Character, cTicketV3J as Character, aHeader as Array, nPercMin as Numeric, nPercMax as Numeric, lGrvRH as logical )

	Local lRet          as Logical
	Local oRest         as object
	Local oResponse     as object
	Local cEndPoint     as Character
	Local nPercent      as Numeric
    Local nPercRH       as Numeric
    Local nPercRange    as Numeric

    Default cURLErp     := ""
    Default cPath       := ""
    Default cTicket     := ""   
    Default cTicketV3J  := ""  
    Default aHeader     := {}
    Default nPercMin    := 5
    Default nPercMax    := 25
    Default lGrvRH      := .T.

    lRet        := .F.
	oRest       := FWRest()    :New(cURLErp)
	oResponse   := JsonObject():New()
	nPercent    := 0
    nPercRH     := 0
    nPercRange  := 0

    cEndPoint   := "/api/rh/esocial/v1/reportEsocialBaseConfer/Status/" + AllTrim(cTicket)
    
	oRest:SetPath(cEndPoint)

    If oRest:Get(aHeader)

        oResponse:FromJson(oRest:GetResult())
        lRet     := oResponse["finished"]
        
        nPercRH := Val( cValToChar( oResponse["percent"] ) )

        If nPercMax > nPercMin
            nPercRange := ( nPercMax - nPercMin )
            nPercent   := nPercMin + ( ( nPercRH / 100 ) * nPercRange )
        EndIf

        setProgress( cTicketV3J,,, .T., nPercent, .T. )

    Else
        TAFConOut("[" + ProcName() + "] " + oRest:GetLastError() + ": Falha na conexão com a API do software de RH. API indisponível:" )
        lRet := .T. 
        lGrvRH := .F.
    EndIf 

	FreeObj(oRest)
	FreeObj(oResponse)

Return(lRet)

//---------------------------------------------------------------------
/*/{Protheus.doc} GetResultDirf
@type           Function
@description    Realiza a requisição GET paginada para obter os dados do RH.
                Especializada para o contexto DIRF/IRRF.

@param          cURLErp,      Character, URL base do ERP (RM/Datasul).
@param          cPath,        Character, Caminho base da API.
@param          cCompanyID,   Character, ID da Empresa no RH.
@param          cTicket,      Character, Ticket da requisição (ID do processamento).
@param          cPeriod,      Character, Período de apuração.
@param          cRevenueCode, Character, Código de receita para filtro.
@param          cCpf,         Character, CPF para filtro.
@param          nPage,        Numeric,   Número da página a ser buscada.
@param          aHeader,      Array,     Cabeçalhos da requisição HTTP.
@param          cReportName,  Character, (Opcional) Nome específico do endpoint de relatório.
@return         Json,         Objeto JSON com a resposta da API (items + hasNext).

@author         Denis R. de Oliveira
@since          26/01/2026
@version        1.0
/*/
//---------------------------------------------------------------------
Function GetResultDirf( cURLErp as Character, cPath as Character, cCompanyID as Character, cTicket as Character, cPeriod as Character, cRevenueCode as Character, cCpf as Character, nPage as Numeric, aHeader as Array, cReportName as Character ) as Json
                                                                                            
    //-------------------------------------------------------------------------
    // Declaração de Variáveis
    //-------------------------------------------------------------------------
    Local oRest     as Object
    Local jResponse as Json
    Local cEndPoint as Character
    Local cReport   as Character

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default cURLErp     := ""
    Default cPath       := ""
    Default cCompanyID  := ""
    Default cTicket     := ""
    Default cPeriod     := ""
    Default cRevenueCode:= ""
    Default cCpf        := ""
    Default nPage       := 1
    Default aHeader     := {}
    Default cReportName := ""

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    oRest     := FWRest():New( cURLErp )
    jResponse := JsonObject():New()
    cEndPoint := ""
    cReport   := ""

    //-------------------------------------------------------------------------
    // Definição do Relatório (Endpoint)
    //-------------------------------------------------------------------------
    If !Empty( cReportName )
        cReport := cReportName
    EndIf

    //-------------------------------------------------------------------------
    // Montagem do Endpoint
    //-------------------------------------------------------------------------
    // Nota: EncodeUTF8 é recomendado para valores de QueryString se houver caracteres especiais
    cEndPoint := cPath + "/" + cReport
    cEndPoint += "?companyId="  + cCompanyID 
    cEndPoint += "&requestId="  + AllTrim( cTicket )
    cEndPoint += "&period="     + AllTrim( cPeriod )
    cEndPoint += "&revenueCode="+ AllTrim( cRevenueCode )
    cEndPoint += "&cpf="        + AllTrim( cCpf )
    cEndPoint += "&page="       + cValToChar( nPage )
    cEndPoint += "&pageSize=50" 

    //-------------------------------------------------------------------------
    // Execução da Requisição
    //-------------------------------------------------------------------------
    oRest:SetPath( cEndPoint )

    If oRest:Get( aHeader )

        jResponse:FromJson( oRest:GetResult() )
        
    EndIf

    FreeObj( oRest )
    oRest := Nil

Return jResponse

//-----------------------------------------------------------------------------
/*/{Protheus.doc} GetHeader
@type           Function
@description    Monta e retorna o cabeçalho (Header) para as requisições HTTP de integração.
                Utiliza os parâmetros MV_TAFRHLG (Usuário) e MV_TAFRHPW (Senha) para Basic Auth.

@author         Victor A. Barbosa / Denis R. de Oliveira
@since          22/11/2019
@version        1.0

@return         aHeader, Array, Lista contendo as propriedades do Header (Content-Type e Authorization).
/*/
//-----------------------------------------------------------------------------
Function GetHeader() As Array

    //-------------------------------------------------------------------------
    // Declaração de Variáveis
    //-------------------------------------------------------------------------
    Local aHeader As Array
    Local cUser   As Character
    Local cPass   As Character

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    aHeader := {}
    cUser   := GetNewPar("MV_TAFRHLG", "")
    cPass   := GetNewPar("MV_TAFRHPW", "")

    // Definição do Tipo de Conteúdo
    aAdd(aHeader, "Content-Type: application/json; charset=UTF-8")

    // Montagem da Autenticação (Basic Auth)
    // Verifica se existe usuário configurado antes de codificar
    If !Empty(cUser)
        aAdd(aHeader, "Authorization: Basic " + Encode64(cUser + ":" + cPass))
    EndIf

Return aHeader

//---------------------------------------------------------------------
/*/{Protheus.doc} MatchCodRecDirf
@type           Function
@description    Verifica se um código de receita corresponde ao valor do campo.
                Trata tanto códigos únicos quanto códigos compostos (separados por |).

@param          xFieldValue, Variant,   Valor do campo T8R_CODREC (pode conter "|").
@param          cCodRec,     Character, Código de receita a ser buscado.
@return         Logical,     .T. se encontrou correspondência exata.

@author         Denis R. de Oliveira
@since          29/01/2026
@version        1.0
/*/
//---------------------------------------------------------------------
Function MatchCodRecDirf( xFieldValue As Variant, cCodRec As Character ) As Logical

    //-------------------------------------------------------------------------
    // Declaração de Variáveis
    //-------------------------------------------------------------------------
    Local cCode   As Character
    Local cValStr As Character
    Local lRet    As Logical

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default cCodRec     := ""
    Default xFieldValue := ""

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    cCode   := AllTrim( cCodRec )
    cValStr := AllTrim( cValToChar( xFieldValue ) )
    lRet    := .F.

    //-------------------------------------------------------------------------
    // Processamento O(1)
    // Compara os blocos com o delimitador virtual garantindo exatidão.
    // Ex: "|0561|" está contido em "|0588|0561|3562|" -> Retorna .T.
    //-------------------------------------------------------------------------
    lRet := ( "|" + cCode + "|" $ "|" + cValStr + "|" )

Return lRet

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFCountRecordsDirf
Realiza a contagem rápida (COUNT) de registros na tabela T8R com base
nos filtros fornecidos. Utilizada para calibrar a barra de progresso.

@param aFils    Array       Lista de filiais para filtro (IN).
@param cPeriodo Character   Período de apuração (AAAAMM).
@param cRevCode Character   (Opcional) Código de Receita (LIKE).
@param cCpf     Character   (Opcional) CPF do trabalhador.
@param cName    Character   (Opcional) Nome do trabalhador.

@return Numeric Quantidade total de registros encontrados.

@author  Denis R. de Oliveira
@since   05/02/2026
@version 1.0
/*/
//---------------------------------------------------------------------
Function TAFCountRecordsDirf( aFils As Array, cPeriodo As Character, cRevCode As Character, cCpf As Character, cName As Character ) As Numeric

    //-------------------------------------------------------------------------
    // Declaração de Variáveis
    //-------------------------------------------------------------------------
    Local cAliasQry As Character
    Local cQuery    As Character
    Local cTabT8R   As Character
    Local nCount    As Numeric
    Local nTotal    As Numeric
    Local oStmt     As Object

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default aFils    := FilMatriz()
    Default cPeriodo := ""
    Default cRevCode := ""
    Default cCpf     := ""
    Default cName    := ""

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    cAliasQry := GetNextAlias()
    cQuery    := ""
    cTabT8R   := RetSqlName( "T8R" )
    nCount    := 0
    nTotal    := 0
    oStmt     := Nil

    //-------------------------------------------------------------------------
    // Montagem da Query
    // Utiliza COUNT(*) para performance (evita tráfego de dados na rede)
    //-------------------------------------------------------------------------
    cQuery := " SELECT COUNT(DISTINCT T8R_CPF) AS TOTAL "
    cQuery += " FROM " + cTabT8R + " T8R "
    cQuery += " WHERE T8R_FILIAL IN (?) "
    cQuery += " AND T8R_PERAPU = ? "
    
    // Filtros Opcionais
    If !Empty( cRevCode )
        cQuery += " AND T8R_CODREC LIKE ? "
    EndIf

    If !Empty( cCpf )
        cQuery += " AND T8R_CPF = ? "
    EndIf

    If !Empty( cName )
        cQuery += " AND T8R_NOME = ? "
    EndIf

    cQuery += " AND T8R.D_E_L_E_T_ = '' "

    //-------------------------------------------------------------------------
    // Preparação do Statement
    // O ChangeQuery traduz o SQL padrão para o banco específico
    //-------------------------------------------------------------------------
    oStmt := FWExecStatement():New( ChangeQuery( cQuery ) )

    //-------------------------------------------------------------------------
    // Definição dos Parâmetros (Bind)
    //-------------------------------------------------------------------------
    nCount++
    oStmt:setIn( nCount, aFils )

    nCount++
    oStmt:SetString( nCount, cPeriodo )
    
    If !Empty( cRevCode )
        nCount++
        oStmt:SetString( nCount, "%" + cRevCode + "%" )
    EndIf

    If !Empty( cCpf )
        nCount++
        oStmt:SetString( nCount, cCpf )
    EndIf

    If !Empty( cName )
        nCount++
        oStmt:SetString( nCount, cName )
    EndIf

    //-------------------------------------------------------------------------
    // Execução e Leitura
    //-------------------------------------------------------------------------
    cAliasQry := oStmt:OpenAlias()

    If ( cAliasQry )->( !Eof() )
        nTotal := ( cAliasQry )->TOTAL
    EndIf

    //-------------------------------------------------------------------------
    // Encerramento e Limpeza
    //-------------------------------------------------------------------------
    ( cAliasQry )->( DbCloseArea() )
    
    If oStmt != Nil
        oStmt:Destroy()
        oStmt := Nil
    EndIf

Return nTotal

//---------------------------------------------------------------------
/*/{Protheus.doc} modalValid
@type           Function
@description    Valida divergências para a tela da modal referente ao form nos totais por trabalhador.
@author         Alexandre lima
@since          23/02/2026
@version        1.0

@param          aInfos,    Array,   Estrutura contendo os totais e flags.
@param          lIsLegacy, Logical, Flag indicando o uso da rotina legada.
@return         Nil
/*/
//---------------------------------------------------------------------
Function modalValid( aInfos As Array, lIsLegacy As Logical )

    Default aInfos    := {}
    Default lIsLegacy := .F.

    // Comparação TAF x GOVERNO
    aInfos[60] :=   aInfos[3] != aInfos[22] .Or. ;
                    aInfos[4] != aInfos[23] .Or. ;
                    aInfos[5] != aInfos[24] .Or. ;
                    aInfos[6] != aInfos[25] .Or. ;
                    aInfos[7] != aInfos[26] .Or. ;
                    aInfos[8] != aInfos[27] .Or. ;
                    aInfos[9] != aInfos[28] .Or. ;
                    aInfos[10] != aInfos[29] .Or. ;
                    aInfos[11] != aInfos[30] .Or. ;
                    aInfos[12] != aInfos[31] .Or. ;
                    aInfos[13] != aInfos[32] .Or. ;
                    aInfos[14] != aInfos[33] .Or. ;
                    aInfos[15] != aInfos[34] .Or. ;
                    aInfos[16] != aInfos[35] .Or. ;
                    aInfos[17] != aInfos[36] .Or. ;
                    aInfos[18] != aInfos[37] .Or. ;
                    aInfos[19] != aInfos[38] .Or. ;
                    aInfos[20] != aInfos[39] .Or. ;
                    aInfos[21] != aInfos[40] 

    // Comparação com a FOLHA (Legado) com blindagem de centavos
    If lIsLegacy .And. !aInfos[60]

        aInfos[60] :=   aInfos[3] != aInfos[41] .Or. ;
                        aInfos[4] != aInfos[42] .Or. ;
                        aInfos[5] != aInfos[43] .Or. ;
                        aInfos[6] != aInfos[44] .Or. ;
                        aInfos[7] != aInfos[45] .Or. ;
                        aInfos[8] != aInfos[46] .Or. ;
                        aInfos[9] != aInfos[47] .Or. ;
                        aInfos[10] != aInfos[48] .Or. ;
                        aInfos[11] != aInfos[49] .Or. ;
                        aInfos[12] != aInfos[50] .Or. ;
                        aInfos[13] != aInfos[51] .Or. ;
                        aInfos[14] != aInfos[52] .Or. ;
                        aInfos[15] != aInfos[53] .Or. ;
                        aInfos[16] != aInfos[54] .Or. ;
                        aInfos[17] != aInfos[55] .Or. ;
                        aInfos[18] != aInfos[56] .Or. ;
                        aInfos[19] != aInfos[57] .Or. ;
                        aInfos[20] != aInfos[58] .Or. ;
                        aInfos[21] != aInfos[59] .Or. ;
                        aInfos[22] != aInfos[41] .Or. ;
                        aInfos[23] != aInfos[42] .Or. ;
                        aInfos[24] != aInfos[43] .Or. ;
                        aInfos[25] != aInfos[44] .Or. ;
                        aInfos[26] != aInfos[45] .Or. ;
                        aInfos[27] != aInfos[46] .Or. ;
                        aInfos[28] != aInfos[47] .Or. ;
                        aInfos[29] != aInfos[48] .Or. ;
                        aInfos[30] != aInfos[49] .Or. ;
                        aInfos[31] != aInfos[50] .Or. ;
                        aInfos[32] != aInfos[51] .Or. ;
                        aInfos[33] != aInfos[52] .Or. ;
                        aInfos[34] != aInfos[53] .Or. ;
                        aInfos[35] != aInfos[54] .Or. ;
                        aInfos[36] != aInfos[55] .Or. ;
                        aInfos[37] != aInfos[56] .Or. ;
                        aInfos[38] != aInfos[57] .Or. ;
                        aInfos[39] != aInfos[58] .Or. ;
                        aInfos[40] != aInfos[59] 
    EndIf

Return

//-----------------------------------------------------------------------------
/*/{Protheus.doc} FreeBucketTree
@type           Static Function
@description    Limpa a árvore de JSONs do Bucket atual, para evitar Memory Leak.

@author         Denis R de Oliveira
@since          05/03/2026
@version        1.0

@param          jBuckets, Json, Objeto JSON com a árvore de buckets a ser destruída.
@return         Nil
/*/
//-----------------------------------------------------------------------------
Static Function FreeBucketTree( jBuckets As Json )

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default jBuckets := Nil

    //-------------------------------------------------------------------------
    // Inicialização da Limpeza
    //-------------------------------------------------------------------------
    If ValType( jBuckets ) == "J" .Or. ValType( jBuckets ) == "O"
        FreeObj( jBuckets )
        jBuckets := Nil
    EndIf

Return

//-----------------------------------------------------------------------------
/*/{Protheus.doc} TAFFindNameCache
@type           Static Function
@description    Cache local para busca de nome por filial + CPF, preservando
                integralmente a regra de negócio da TAFFindName, porém com
                acesso O(1) via THashMap para ganho de performance.

@author         Denis R. de Oliveira
@since          05/03/2026
@version        1.0

@param          cCpf, Character, CPF do dependente/beneficiário.
@param          cFil, Character, Filial do registro.
@param          oFindNameCache, Object, Objeto THashMap instanciado para cache.
@return         cName, Character, Nome localizado.
/*/
//-----------------------------------------------------------------------------
Static Function TAFFindNameCache( cCpf As Character, cFil As Character, oFindNameCache As Object )

    //-------------------------------------------------------------------------
    // Declaração de Variáveis
    //-------------------------------------------------------------------------
    Local cKey  As Character
    Local cName As Character

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default cCpf           := ""
    Default cFil           := ""
    Default oFindNameCache := Nil

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    cKey  := AllTrim( cFil ) + "|" + AllTrim( cCpf )
    cName := ""

    //-------------------------------------------------------------------------
    // 1. Busca no Cache (Acesso em Memória O(1))
    //-------------------------------------------------------------------------
    If ValType( oFindNameCache ) == "O"
        // No THashMap padrão Protheus, o Get retorna .T. se a chave existe
        // e atribui o conteúdo à variável passada por referência (@cName)
        If oFindNameCache:Get( cKey, @cName )
            Return cName
        EndIf
    EndIf

    //-------------------------------------------------------------------------
    // 2. Busca no Banco
    //-------------------------------------------------------------------------
    cName := TAFFindName( cCpf, cFil )

    //-------------------------------------------------------------------------
    // 3. Alimenta o Cache para as próximas iterações
    //-------------------------------------------------------------------------
    If ValType( oFindNameCache ) == "O"
        oFindNameCache:Set( cKey, cName )
    EndIf

Return cName

//-----------------------------------------------------------------------------
/*/{Protheus.doc} EvalFormDivergence
@type           Function
@description    Avalia divergências nos grids do formulário de forma otimizada,
                eliminando loops aninhados na geração do JSON final.
@author         Alexandre lima / Denis R. de Oliveira
@since          05/03/2026
@version        1.0

@param          aForm, Array, Array contendo os dados do formulário processado.
@return         lHasDivergence, Logical, Retorna .T. se houver divergência, caso contrário .F.
/*/
//-----------------------------------------------------------------------------
Function EvalFormDivergence( aForm As Array ) As Logical

    Local aGrids         As Array
    Local lHasDivergence As Logical
    Local nI             As Numeric
    Local nIdx           As Numeric

    Default aForm := {}

    // Utilizando as constantes mapeadas no cabecalho do fonte
    aGrids         := { FORM_DEPDEDUCTION, FORM_ALIMONY, FORM_PRIVAPENSION, FORM_LEGALPROCESSA1, FORM_LEGALPROCESSA2, FORM_LEGALPROCESSA3, FORM_PLSAUDE, FORM_PLSAUDE02, FORM_REBMED02, FORM_REBMED04, FORM_CONSOLID }
    lHasDivergence := .F.
    nI             := 0
    nIdx           := 0

    For nI := 1 To Len( aGrids )

        nIdx := aGrids[nI]

        // Blindagem: Garante que a posicao existe e eh um array com dados
        If Len( aForm ) >= nIdx .And. ValType( aForm[nIdx] ) == "A" .And. Len( aForm[nIdx] ) > 0

            lHasDivergence := IIf( nIdx == FORM_DEPDEDUCTION .Or. nIdx == FORM_ALIMONY .Or. nIdx == FORM_PLSAUDE, ( aScan( aForm[nIdx], {|x| Len(x) >= 8 .And. x[8]  == .T.} ) > 0 ), lHasDivergence )
            lHasDivergence := IIf( nIdx == FORM_PRIVAPENSION,   ( aScan( aForm[nIdx], {|x| Len(x) >= 16 .And. x[16] == .T.} ) > 0 ), lHasDivergence )
            lHasDivergence := IIf( nIdx == FORM_LEGALPROCESSA1, ( aScan( aForm[nIdx], {|x| Len(x) >= 18 .And. x[18] == .T.} ) > 0 ), lHasDivergence )
            lHasDivergence := IIf( nIdx == FORM_LEGALPROCESSA2 .Or. nIdx == FORM_REBMED02 .Or. nIdx == FORM_REBMED04, ( aScan( aForm[nIdx], {|x| Len(x) >= 10 .And. x[10] == .T.} ) > 0 ), lHasDivergence )
            lHasDivergence := IIf( nIdx == FORM_LEGALPROCESSA3, ( aScan( aForm[nIdx], {|x| Len(x) >= 6  .And. x[6]  == .T.} ) > 0 ), lHasDivergence )
            lHasDivergence := IIf( nIdx == FORM_PLSAUDE02,      ( aScan( aForm[nIdx], {|x| Len(x) >= 7  .And. x[7]  == .T.} ) > 0 ), lHasDivergence )
            lHasDivergence := IIf( nIdx == FORM_CONSOLID,       ( aScan( aForm[nIdx], {|x| Len(x) >= 60 .And. x[60] == .T.} ) > 0 ), lHasDivergence )

            // Fail-Fast
            If lHasDivergence; Exit; EndIf

        EndIf

    Next nI

Return lHasDivergence

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFCtxPaiSemanticKey
@type           Function
@description    Normaliza o contexto do pai para comparacao semantica
                entre origens, removendo apenas o sufixo tecnico da
                ocorrencia (_Sxxx / _Ixxxx...), sem alterar a competencia.

@author         Denis R. de Oliveira
@since          25/03/2026
@version        1.0

@param          cCtxPai, Character, Contexto completo do pai.
@return         cKey,    Character, Contexto semantico.
 /*/
//---------------------------------------------------------------------
Function TAFCtxPaiSemanticKey( cCtxPai As Character ) As Character

    //-------------------------------------------------------------------------
    // Declaracao de Variaveis
    //-------------------------------------------------------------------------
    Local aTokens As Array
    Local cKey    As Character

    //-------------------------------------------------------------------------
    // Inicializacao de Parametros (Defaults)
    //-------------------------------------------------------------------------
    Default cCtxPai := ""

    //-------------------------------------------------------------------------
    // Inicializacao de Variaveis
    //-------------------------------------------------------------------------
    aTokens := {}
    cKey    := AllTrim( cCtxPai )

    //-------------------------------------------------------------------------
    // Processamento
    //-------------------------------------------------------------------------
    aTokens := StrTokArr( cKey, "_" )

    If Len( aTokens ) >= 2 .And. ;
       ( Upper( AllTrim( aTokens[1] ) ) == "ATU" .Or. Upper( AllTrim( aTokens[1] ) ) == "ANT" )

        cKey := Upper( AllTrim( aTokens[1] ) ) + "_" + Left( AllTrim( aTokens[2] ), 6 )

    EndIf

Return cKey

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFOrigMaskHas
@type           Function
@description    Verifica se a origem atual ja foi gravada na linha
                consolidada em memoria.

@author         Denis R. de Oliveira
@since          25/03/2026
@version        1.0

@param          cMask,   Character, Mascara de origens gravadas.
@param          cOrigem, Character, Origem atual.
@return         lRet,    Logical,   Indica se a origem ja existe.
/*/
//---------------------------------------------------------------------
Function TAFOrigMaskHas( cMask As Character, cOrigem As Character ) As Logical

    //-------------------------------------------------------------------------
    // Inicializacao de Parametros (Defaults)
    //-------------------------------------------------------------------------
    Default cMask   := ""
    Default cOrigem := ""

Return AllTrim( cOrigem ) $ AllTrim( cMask )

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFNoRecValueKey
@type           Static Function
@description    Gera uma chave textual fixa para ordenacao deterministica
                de valores numericos em memoria.

@author         Denis R. de Oliveira
@since          25/03/2026
@version        1.0

@param          nVal, Character/Numeric, Valor numerico da linha.
@return         cKey, Character, Chave de ordenacao.
/*/
//---------------------------------------------------------------------
Static Function TAFNoRecValueKey( nVal ) As Character

    //-------------------------------------------------------------------------
    // Declaracao de Variaveis
    //-------------------------------------------------------------------------
    Local cKey As Character
    Local nNum As Numeric

    //-------------------------------------------------------------------------
    // Inicializacao de Parametros (Defaults)
    //-------------------------------------------------------------------------
    Default nVal := 0

    //-------------------------------------------------------------------------
    // Inicializacao de Variaveis
    //-------------------------------------------------------------------------
    cKey := ""
    nNum := IIf( ValType( nVal ) == "N", Round( nVal, 2 ), 0 )

    // Previne quebra de ASort no AdvPL por ASCII
    // Padroniza sinal (+ ou -) no inicio + 17 posicoes de tamanho fixo
    cKey := IIf( nNum >= 0, "+", "-" ) + StrZero( Abs( nNum ), 17, 2 )

Return cKey

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFNoRecSortKey
@type           Function
@description    Retorna uma chave estavel de ordenacao para reduzir a
                ambiguidade de pareamento entre origens nas abas de
                saude e reembolso.

@author         Denis R. de Oliveira
@since          25/03/2026
@version        1.0

@param          cAba, Character, Identificador da aba.
@param          jReg, Variant  , Registro da bucketizacao.
@return         cKey, Character, Chave de ordenacao.
/*/
//---------------------------------------------------------------------
Function TAFNoRecSortKey( cAba As Character, jReg ) As Character

    //-------------------------------------------------------------------------
    // Declaracao de Variaveis
    //-------------------------------------------------------------------------
    Local cKey    As Character
    Local cRelaco As Character
    Local cSemKey As Character

    //-------------------------------------------------------------------------
    // Inicializacao de Parametros (Defaults)
    //-------------------------------------------------------------------------
    Default cAba := ""
    Default jReg := Nil

    //-------------------------------------------------------------------------
    // Inicializacao de Variaveis
    //-------------------------------------------------------------------------
    cKey    := ""
    cRelaco := ""
    cSemKey := ""

    //-------------------------------------------------------------------------
    // Processamento
    //-------------------------------------------------------------------------
    If ValType( jReg ) != "J" .And. ValType( jReg ) != "O"
        Return ""
    EndIf

    cRelaco := IIf( ValType( jReg["T8R_RELACO"] ) == "C", jReg["T8R_RELACO"], "" )
    cSemKey := TAFNoRecSemanticKey( cAba, cRelaco )
    cAba    := AllTrim( Upper( cAba ) )

    Do Case
        Case cAba == "PLASAU"
            cKey := cSemKey + "|" + ;
                    IIf( ValType( jReg["T8R_CPF"] ) == "C", AllTrim( jReg["T8R_CPF"] ), "" ) + "|" + ;
                    IIf( ValType( jReg["T8R_CNPJOP"] ) == "C", AllTrim( jReg["T8R_CNPJOP"] ), "" ) + "|" + ;
                    IIf( ValType( jReg["T8R_REGANS"] ) == "C", AllTrim( jReg["T8R_REGANS"] ), "" ) + "|" + ;
                    TAFNoRecValueKey( jReg["T8R_VLRPLS"] )

        Case cAba == "DEPSAU"
            cKey := cSemKey + "|" + ;
                    IIf( ValType( jReg["T8R_CPFDPS"] ) == "C", AllTrim( jReg["T8R_CPFDPS"] ), "" ) + "|" + ;
                    TAFNoRecValueKey( jReg["T8R_VLRDPS"] )

        Case cAba == "REMMED"
            cKey := cSemKey + "|" + ;
                    IIf( ValType( jReg["T8R_ORIREE"] ) == "C", AllTrim( jReg["T8R_ORIREE"] ), "" ) + "|" + ;
                    IIf( ValType( jReg["T8R_CNPJPS"] ) == "C", AllTrim( jReg["T8R_CNPJPS"] ), "" ) + "|" + ;
                    IIf( ValType( jReg["T8R_ANSRRE"] ) == "C", AllTrim( jReg["T8R_ANSRRE"] ), "" )

        Case cAba == "REMTID"
            cKey := cSemKey + "|" + ;
                    IIf( ValType( jReg["T8R_INSCRE"] ) == "C", AllTrim( jReg["T8R_INSCRE"] ), "" ) + "|" + ;
                    IIf( ValType( jReg["T8R_NRPSRE"] ) == "C", AllTrim( jReg["T8R_NRPSRE"] ), "" ) + "|" + ;
                    TAFNoRecValueKey( jReg["T8R_VLREEM"] ) + "|" + ;
                    TAFNoRecValueKey( jReg["T8R_VLRANT"] )

        Case cAba == "REMDEP"
            cKey := cSemKey + "|" + ;
                    IIf( ValType( jReg["T8R_CPFRED"] ) == "C", AllTrim( jReg["T8R_CPFRED"] ), "" )

        Case cAba == "DETDEP"
            cKey := cSemKey + "|" + ;
                    IIf( ValType( jReg["T8R_DINSCR"] ) == "C", AllTrim( jReg["T8R_DINSCR"] ), "" ) + "|" + ;
                    IIf( ValType( jReg["T8R_DNRPSR"] ) == "C", AllTrim( jReg["T8R_DNRPSR"] ), "" ) + "|" + ;
                    TAFNoRecValueKey( jReg["T8R_DVLRRE"] ) + "|" + ;
                    TAFNoRecValueKey( jReg["T8R_DVLRAN"] )

        Otherwise
            cKey := cSemKey + "|" + cRelaco
    EndCase

Return cKey

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFNoRecSortItems
@type           Function
@description    Ordena deterministicamente os buckets das abas de saude e
                reembolso para reduzir ambiguidade de pareamento na tela.

@author         Denis R. de Oliveira
@since          25/03/2026
@version        1.0

@param          cAba, Character, Identificador da aba.
@param          aItems, Array,     Bucket da origem atual (referencia).
/*/
//---------------------------------------------------------------------
Function TAFNoRecSortItems( cAba As Character, aItems As Array )

    //-------------------------------------------------------------------------
    // Inicializacao de Parametros (Defaults)
    //-------------------------------------------------------------------------
    Default cAba   := ""
    Default aItems := {}

    //-------------------------------------------------------------------------
    // Processamento
    //-------------------------------------------------------------------------
    cAba := AllTrim( Upper( cAba ) )

    If Len( aItems ) <= 1
        Return
    EndIf

    If cAba $ "PLASAU|DEPSAU|REMMED|REMTID|REMDEP|DETDEP"
        ASort( aItems,,, {|x, y| TAFNoRecSortKey( cAba, x ) < TAFNoRecSortKey( cAba, y ) } )
    EndIf

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFOrigMaskAdd
@type           Static Function
@description    Adiciona a origem atual na mascara de controle em memoria,
                sem duplicar caracteres.

@author         Denis R. de Oliveira
@since          25/03/2026
@version        1.0

@param          cMask,   Character, Mascara de origens gravadas.
@param          cOrigem, Character, Origem atual.
@return         cMask,   Character, Mascara atualizada.
/*/
//---------------------------------------------------------------------
Static Function TAFOrigMaskAdd( cMask As Character, cOrigem As Character ) As Character

    //-------------------------------------------------------------------------
    // Inicializacao de Parametros (Defaults)
    //-------------------------------------------------------------------------
    Default cMask   := ""
    Default cOrigem := ""

    cMask   := AllTrim( cMask )
    cOrigem := AllTrim( cOrigem )

    If !Empty( cOrigem ) .And. !( cOrigem $ cMask ); cMask += cOrigem; EndIf

Return cMask

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFProcSemanticKey
@type           Function
@description    Retorna a chave semantica forte das abas de processo,
                alinhando a consolidacao da tela com a identidade
                canonica gravada na T8R.

@author         Denis R. de Oliveira
@since          26/03/2026
@version        1.0

@param          cAba,    Character, Identificador da aba.
@param          cCodRec, Character, Codigo de receita em contexto.
@param          jReg,    Json,      Registro corrente da T8R.
@return         cKey,    Character, Chave semantica da linha.
/*/
//---------------------------------------------------------------------
Function TAFProcSemanticKey( cAba As Character, cCodRec As Character, jReg As Json ) As Character

    //-------------------------------------------------------------------------
    // Declaracao de Variaveis
    //-------------------------------------------------------------------------
    Local cCnpjEc    As Character
    Local cCpfSus    As Character
    Local cIndApu    As Character
    Local cIndDed    As Character
    Local cNrProc    As Character
    Local cRelaco    As Character
    Local cTpProc    As Character
    Local cCodSup    As Character
    Local cKey       As Character

    //-------------------------------------------------------------------------
    // Inicializacao de Parametros (Defaults)
    //-------------------------------------------------------------------------
    Default cAba    := ""
    Default cCodRec := ""
    Default jReg    := Nil

    //-------------------------------------------------------------------------
    // Inicializacao de Variaveis
    //-------------------------------------------------------------------------
    cCnpjEc    := ""
    cCpfSus    := ""
    cIndApu    := ""
    cIndDed    := ""
    cNrProc    := ""
    cRelaco    := ""
    cTpProc    := ""
    cCodSup    := ""
    cKey       := ""

    //-------------------------------------------------------------------------
    // Processamento
    //-------------------------------------------------------------------------
    cAba := AllTrim( Upper( cAba ) )

    If ValType( jReg ) != "J" .And. ValType( jReg ) != "O"
        Return cKey
    EndIf

    cTpProc := AllTrim( IIf( ValType( jReg["T8R_TPPROC"] ) == "C", jReg["T8R_TPPROC"], "" ) )
    cNrProc := AllTrim( IIf( ValType( jReg["T8R_NRPROC"] ) == "C", jReg["T8R_NRPROC"], "" ) )
    cCodSup := AllTrim( IIf( ValType( jReg["T8R_CODSUP"] ) == "C", jReg["T8R_CODSUP"], "" ) )
    cRelaco := AllTrim( IIf( ValType( jReg["T8R_RELACO"] ) == "C", jReg["T8R_RELACO"], "" ) )
    cIndApu := AllTrim( IIf( ValType( jReg["T8R_INDAPU"] ) == "C", jReg["T8R_INDAPU"], "" ) )
    cIndDed := AllTrim( IIf( ValType( jReg["T8R_INDDED"] ) == "C", jReg["T8R_INDDED"], "" ) )
    cCnpjEc := AllTrim( IIf( ValType( jReg["T8R_CNPJEC"] ) == "C", jReg["T8R_CNPJEC"], "" ) )
    cCpfSus := AllTrim( IIf( ValType( jReg["T8R_CPFSUS"] ) == "C", jReg["T8R_CPFSUS"], "" ) )

    Do Case
        Case cAba == "PROCRE"
            If !Empty( cRelaco )
                cKey := TAFProcHdrParentKey( cRelaco )
            Else
                cKey := cTpProc + "|" + cNrProc + "|" + cCodSup
            EndIf

        Case cAba == "PRCVAL"
            If !Empty( cRelaco )
                cKey := TAFProcValParentKey( cRelaco )
            Else
                cKey := cTpProc + "|" + cNrProc + "|" + cCodSup + "|" + cIndApu
            EndIf

        Case cAba == "PRCDED"
            If !Empty( cRelaco )
                cKey := TAFProcValParentKey( cRelaco ) + "|" + cIndDed + "|" + cCnpjEc
            Else
                cKey := cTpProc + "|" + cNrProc + "|" + cCodSup + "|" + cIndApu + "|" + cIndDed + "|" + cCnpjEc
            EndIf

        Case cAba == "PRCBEN"
            If !Empty( cRelaco )
                cKey := TAFProcDedParentKey( cRelaco ) + "|" + cCpfSus
            Else
                cKey := cTpProc + "|" + cNrProc + "|" + cCodSup + "|" + cIndApu + "|" + cIndDed + "|" + cCnpjEc + "|" + cCpfSus
            EndIf
    EndCase

Return cKey

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFProcHdrParentKey
@type           Function
@description    Deriva a chave pai de PROCRE a partir da relacao do filho.
@author         Denis R. de Oliveira
@since          26/03/2026
@version        1.0

@param          cRelaco, Character, Relacao corrente da T8R.
@return         cKey,    Character, Chave canonica do pai PROCRE.
/*/
//---------------------------------------------------------------------
Function TAFProcHdrParentKey( cRelaco As Character ) As Character

    //-------------------------------------------------------------------------
    // Declaracao de Variaveis
    //-------------------------------------------------------------------------
    Local aChave As Array
    Local cKey   As Character

    //-------------------------------------------------------------------------
    // Inicializacao de Parametros (Defaults)
    //-------------------------------------------------------------------------
    Default cRelaco := ""

    //-------------------------------------------------------------------------
    // Inicializacao de Variaveis
    //-------------------------------------------------------------------------
    aChave := {}
    cKey   := ""

    //-------------------------------------------------------------------------
    // Processamento
    //-------------------------------------------------------------------------
    cRelaco := AllTrim( cRelaco )

    If Empty( cRelaco )
        Return cKey
    EndIf

    aChave := StrTokArr( cRelaco, "|" )

    If Len( aChave ) >= 3
        cKey := AllTrim( aChave[1] + "|" + aChave[2] + "|" + aChave[3] )
    EndIf

Return cKey

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFProcValParentKey
@type           Function
@description    Deriva a chave pai de PRCVAL a partir da relacao do filho.
@author         Denis R. de Oliveira
@since          26/03/2026
@version        1.0

@param          cRelaco, Character, Relacao corrente da T8R.
@return         cKey,    Character, Chave canonica do pai PRCVAL.
/*/
//---------------------------------------------------------------------
Function TAFProcValParentKey( cRelaco As Character ) As Character

    //-------------------------------------------------------------------------
    // Declaracao de Variaveis
    //-------------------------------------------------------------------------
    Local aChave As Array
    Local cKey   As Character

    //-------------------------------------------------------------------------
    // Inicializacao de Parametros (Defaults)
    //-------------------------------------------------------------------------
    Default cRelaco := ""

    //-------------------------------------------------------------------------
    // Inicializacao de Variaveis
    //-------------------------------------------------------------------------
    aChave := {}
    cKey   := ""

    //-------------------------------------------------------------------------
    // Processamento
    //-------------------------------------------------------------------------
    cRelaco := AllTrim( cRelaco )

    If Empty( cRelaco )
        Return cKey
    EndIf

    aChave := StrTokArr( cRelaco, "|" )

    If Len( aChave ) >= 4
        cKey := AllTrim( aChave[1] + "|" + aChave[2] + "|" + aChave[3] + "|" + aChave[4] )
    EndIf

Return cKey

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFProcDedParentKey
@type           Function
@description    Deriva a chave pai de PRCDED a partir da relacao do filho.
@author         Denis R. de Oliveira
@since          26/03/2026
@version        1.0

@param          cRelaco, Character, Relacao corrente da T8R.
@return         cKey,    Character, Chave canonica do pai PRCDED.
/*/
//---------------------------------------------------------------------
Function TAFProcDedParentKey( cRelaco As Character ) As Character

    //-------------------------------------------------------------------------
    // Declaracao de Variaveis
    //-------------------------------------------------------------------------
    Local aChave As Array
    Local cKey   As Character

    //-------------------------------------------------------------------------
    // Inicializacao de Parametros (Defaults)
    //-------------------------------------------------------------------------
    Default cRelaco := ""

    //-------------------------------------------------------------------------
    // Inicializacao de Variaveis
    //-------------------------------------------------------------------------
    aChave := {}
    cKey   := ""

    //-------------------------------------------------------------------------
    // Processamento
    //-------------------------------------------------------------------------
    cRelaco := AllTrim( cRelaco )

    If Empty( cRelaco )
        Return cKey
    EndIf

    aChave := StrTokArr2( cRelaco, "|", .T. )

    If Len( aChave ) >= 6

        cKey := AllTrim( aChave[1] + "|" + aChave[2] + "|" + aChave[3] + "|" + aChave[4] + "|" + aChave[5] + "|" + aChave[6] )
    EndIf

Return cKey

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFProcFindPos
@type           Function
@description    Procura a linha consolidada da aba de processo usando a
                chave semantica forte e impedindo reuso da mesma origem
                na mesma linha.

@author         Denis R. de Oliveira
@since          26/03/2026
@version        1.0

@param          aInfos,   Array,     Estrutura consolidada da aba.
@param          cSemKey,  Character, Chave semantica forte da linha.
@param          cOrigem,  Character, Origem atual.
@param          nIdxKey,  Numeric,   Coluna oculta da chave.
@param          nIdxMask, Numeric,   Coluna oculta da mascara de origem.
@return         nPos,     Numeric,   Posicao da linha livre para a origem.
/*/
//---------------------------------------------------------------------
Function TAFProcFindPos( aInfos As Array, cSemKey As Character, cOrigem As Character, nIdxKey As Numeric, nIdxMask As Numeric ) As Numeric

    //-------------------------------------------------------------------------
    // Declaracao de Variaveis
    //-------------------------------------------------------------------------
    Local cMask As Character
    Local nPos  As Numeric
    Local nRet  As Numeric

    //-------------------------------------------------------------------------
    // Inicializacao de Parametros (Defaults)
    //-------------------------------------------------------------------------
    Default aInfos   := {}
    Default cSemKey  := ""
    Default cOrigem  := ""
    Default nIdxKey  := 0
    Default nIdxMask := 0

    //-------------------------------------------------------------------------
    // Inicializacao de Variaveis
    //-------------------------------------------------------------------------
    cMask := ""
    nPos  := 0
    nRet  := 0

    //-------------------------------------------------------------------------
    // Processamento
    //-------------------------------------------------------------------------
    nPos := aScan( aInfos, { |x| Len( x ) >= nIdxKey .And. ValType( x[nIdxKey] ) == "C" .And. x[nIdxKey] == cSemKey } )

    Do While nPos > 0

        cMask := IIf( Len( aInfos[nPos] ) >= nIdxMask .And. ValType( aInfos[nPos][nIdxMask] ) == "C", aInfos[nPos][nIdxMask], "" )

        If At( cOrigem, cMask ) == 0
            nRet := nPos
            Exit
        EndIf

        nPos := aScan( aInfos, { |x| Len( x ) >= nIdxKey .And. ValType( x[nIdxKey] ) == "C" .And. x[nIdxKey] == cSemKey }, nPos + 1 )

    EndDo

Return nRet

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFNoRecSemanticKey
@type           Function
@description    Retorna a chave semantica de tela para saude/reembolso,
                preservando a integridade da relacao fisica gravada.

@author         Denis R. de Oliveira
@since          25/03/2026
@version        1.0

@param          cAba,    Character, Identificador da aba.
@param          cRelaco, Character, Conteudo do campo relacao.
@return         cKey,    Character, Chave semantica da linha.
/*/
//---------------------------------------------------------------------
Function TAFNoRecSemanticKey( cAba As Character, cRelaco As Character ) As Character

    //-------------------------------------------------------------------------
    // Declaracao de Variaveis
    //-------------------------------------------------------------------------
    Local cKey As Character

    //-------------------------------------------------------------------------
    // Inicializacao de Parametros (Defaults)
    //-------------------------------------------------------------------------
    Default cAba    := ""
    Default cRelaco := ""

    //-------------------------------------------------------------------------
    // Inicializacao de Variaveis
    //-------------------------------------------------------------------------
    cKey := ""

    //-------------------------------------------------------------------------
    // Processamento
    //-------------------------------------------------------------------------
    cAba := AllTrim( Upper( cAba ) )

    Do Case
        Case cAba == "PLASAU"
            cKey := TAFRelHealthHolderKey( cRelaco )

        Case cAba == "DEPSAU"
            cKey := TAFRelHealthDepKey( cRelaco )

        Case cAba == "REMMED"
            cKey := TAFRelReimbHeaderKey( cRelaco )

        Case cAba == "REMTID"
            cKey := TAFRelReimbTitKey( cRelaco )

        Case cAba == "REMDEP"
            cKey := TAFRelReimbDepKey( cRelaco )

        Case cAba == "DETDEP"
            cKey := TAFRelReimbDepDetKey( cRelaco )
    EndCase

Return cKey

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFNoRecFindPos
@type           Function
@description    Procura a linha consolidada da aba usando a chave semantica
                da tela e garantindo que a mesma origem nao seja reutilizada
                duas vezes na mesma linha.

@author         Denis R. de Oliveira
@since          25/03/2026
@version        1.0

@param          aInfos,   Array,     Estrutura consolidada da aba.
@param          cAba,     Character, Identificador da aba.
@param          cSemKey,  Character, Chave semantica da linha.
@param          cOrigem,  Character, Origem atual.
@return         nPos,     Numeric,   Posicao da linha livre para a origem.
/*/
//---------------------------------------------------------------------
Function TAFNoRecFindPos( aInfos As Array, cAba As Character, cSemKey As Character, cOrigem As Character ) As Numeric

    //-------------------------------------------------------------------------
    // Declaracao de Variaveis
    //-------------------------------------------------------------------------
    Local cMask   As Character
    Local nIdxKey As Numeric
    Local nIdxOri As Numeric
    Local nPos    As Numeric

    //-------------------------------------------------------------------------
    // Inicializacao de Parametros (Defaults)
    //-------------------------------------------------------------------------
    Default aInfos  := {}
    Default cAba    := ""
    Default cSemKey := ""
    Default cOrigem := ""

    //-------------------------------------------------------------------------
    // Inicializacao de Variaveis
    //-------------------------------------------------------------------------
    cMask   := ""
    nIdxKey := 0
    nIdxOri := 0
    nPos    := 0

    //-------------------------------------------------------------------------
    // Processamento
    //-------------------------------------------------------------------------
    cAba := AllTrim( Upper( cAba ) )

    Do Case
        Case cAba == "PLASAU"
            nIdxKey := 9
            nIdxOri := 10

        Case cAba == "DEPSAU"
            nIdxKey := 8
            nIdxOri := 9

        Case cAba == "REMMED"
            nIdxKey := 5
            nIdxOri := 6

        Case cAba == "REMTID"
            nIdxKey := 11
            nIdxOri := 12

        Case cAba == "REMDEP"
            nIdxKey := 3
            nIdxOri := 4

        Case cAba == "DETDEP"
            nIdxKey := 11
            nIdxOri := 12
    EndCase

    If Empty( cSemKey ) .Or. nIdxKey == 0 .Or. nIdxOri == 0
        Return 0
    EndIf

    For nPos := 1 To Len( aInfos )
        If Len( aInfos[nPos] ) >= nIdxOri .And. ;
           ValType( aInfos[nPos][nIdxKey] ) == "C" .And. ;
           AllTrim( aInfos[nPos][nIdxKey] ) == AllTrim( cSemKey )

            cMask := IIf( ValType( aInfos[nPos][nIdxOri] ) == "C", aInfos[nPos][nIdxOri], "" )

            If !TAFOrigMaskHas( cMask, cOrigem )
                Return nPos
            EndIf
        EndIf
    Next nPos

Return 0

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFMapGetAvailPos
@type           Function
@description    Retorna as posicoes disponiveis para um relacionamento,
                priorizando o match exato e usando a chave semantica apenas
                como fallback quando necessario.

@author         Denis R. de Oliveira
@since          25/03/2026
@version        1.0

@param          oMapExact, Object,    Mapa de chave exata.
@param          cKeyExact, Character, Chave exata.
@param          oMapSem,   Object,    Mapa de chave semantica.
@param          cKeySem,   Character, Chave semantica.
@param          oUsed,     Object,    Controle de posicoes ja consumidas.
@return         aRet,      Array,     Posicoes disponiveis.
/*/
//---------------------------------------------------------------------
Function TAFMapGetAvailPos( oMapExact As Object, cKeyExact As Character, oMapSem As Object, cKeySem As Character, oUsed As Object ) As Array

    //-------------------------------------------------------------------------
    // Declaracao de Variaveis
    //-------------------------------------------------------------------------
    Local aBase         As Array
    Local aRet          As Array
    Local cPos          As Character
    Local nI            As Numeric
    Local lExiste       As Logical 
    Local lUsado        As Logical 

    //-------------------------------------------------------------------------
    // Inicializacao de Parametros (Defaults)
    //-------------------------------------------------------------------------
    Default oMapExact   := Nil
    Default cKeyExact   := ""
    Default oMapSem     := Nil
    Default cKeySem     := ""
    Default oUsed       := Nil

    //-------------------------------------------------------------------------
    // Inicializacao de Variaveis
    //-------------------------------------------------------------------------
    aBase       := {}
    aRet        := {}
    cPos        := ""
    nI          := 0

    //-------------------------------------------------------------------------
    // Resolucao do Array Base via IIf (Exato -> Fallback Semantico)
    //-------------------------------------------------------------------------
    // 1. Tenta carregar o array exato primeiro
    aBase := IIf( !Empty( cKeyExact ), MapGetPos( oMapExact, cKeyExact ), {} )

    // 2. Fallback: Se o exato for vazio, tenta o semantico
    aBase := IIf( Len( aBase ) == 0 .And. !Empty( cKeySem ), MapGetPos( oMapSem, cKeySem ), aBase )

    //-------------------------------------------------------------------------
    // Loop de processamento
    //-------------------------------------------------------------------------
    For nI := 1 To Len( aBase )

        cPos    := AllTrim( Str( aBase[nI] ) )
        lExiste := .F.
        lUsado  := .F.

        // Valida objeto e executa a busca
        lExiste := IIf( ValType( oUsed ) == "O", oUsed:Get( cPos, @lUsado ), .F. )

        // Grava no retorno
        If !lExiste .Or. !lUsado; AAdd( aRet, aBase[nI] ); EndIf

    Next nI

Return aRet

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFMapMarkUsedPos
@type           Static Function
@description    Marca as posicoes consumidas no relacionamento em memoria.

@author         Denis R. de Oliveira
@since          25/03/2026
@version        1.0

@param          oUsed, Object, Controle de posicoes consumidas.
@param          aPos,  Array,  Posicoes a serem marcadas.
/*/
//---------------------------------------------------------------------
Static Function TAFMapMarkUsedPos( oUsed As Object, aPos As Array )

    //-------------------------------------------------------------------------
    // Declaracao de Variaveis
    //-------------------------------------------------------------------------
    Local cPos As Character
    Local nI   As Numeric

    //-------------------------------------------------------------------------
    // Inicializacao de Parametros (Defaults)
    //-------------------------------------------------------------------------
    Default oUsed := Nil
    Default aPos  := {}

    //-------------------------------------------------------------------------
    // Inicializacao de Variaveis
    //-------------------------------------------------------------------------
    cPos := ""
    nI   := 0

    //-------------------------------------------------------------------------
    // Processamento
    //-------------------------------------------------------------------------
    If ValType( oUsed ) != "O"; Return; EndIf

    For nI := 1 To Len( aPos )
        cPos := AllTrim( Str( aPos[nI] ) )
        oUsed:Set( cPos, .T. )
    Next nI

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFRelHealthHolderKey
@type           Function
@description    Retorna a chave semantica do titular de plano de saude,
                preservando compatibilidade com os formatos antigo
                (TIT|CNPJ|ANS) e novo (P|CTXPAI|TIT|CNPJ|ANS).

@author         Denis R. de Oliveira
@since          25/03/2026
@version        1.0

@param          cRelaco, Character, Conteudo do campo relacao.
@return         cKey,    Character, Chave semantica do titular.
 /*/
//---------------------------------------------------------------------
Function TAFRelHealthHolderKey( cRelaco As Character ) As Character

    //-------------------------------------------------------------------------
    // Declaracao de Variaveis
    //-------------------------------------------------------------------------
    Local aTokens As Array
    Local cCtxPai As Character
    Local cKey    As Character

    //-------------------------------------------------------------------------
    // Inicializacao de Parametros (Defaults)
    //-------------------------------------------------------------------------
    Default cRelaco := ""

    //-------------------------------------------------------------------------
    // Inicializacao de Variaveis
    //-------------------------------------------------------------------------
    aTokens := {}
    cCtxPai := ""
    cKey    := ""

    //-------------------------------------------------------------------------
    // Processamento
    //-------------------------------------------------------------------------
    aTokens := StrTokArr( AllTrim( cRelaco ), "|" )

    If Len( aTokens ) >= 5 .And. ;
       AllTrim( aTokens[1] ) == "P" .And. ;
       AllTrim( aTokens[3] ) == "TIT"

        cCtxPai := TAFCtxPaiSemanticKey( aTokens[2] )

        cKey := AllTrim( aTokens[1] ) + "|" + ;
                cCtxPai + "|" + ;
                AllTrim( aTokens[3] ) + "|" + ;
                AllTrim( aTokens[4] ) + "|" + ;
                AllTrim( aTokens[5] )

        If Len( aTokens ) >= 7 .And. AllTrim( aTokens[6] ) == "ORPH"
            cKey += "|ORPH|" + AllTrim( aTokens[7] )
        EndIf

    ElseIf Len( aTokens ) >= 3 .And. AllTrim( aTokens[1] ) == "TIT"

        cKey := AllTrim( aTokens[1] ) + "|" + ;
                AllTrim( aTokens[2] ) + "|" + ;
                AllTrim( aTokens[3] )

        If Len( aTokens ) >= 5 .And. AllTrim( aTokens[4] ) == "ORPH"
            cKey += "|ORPH|" + AllTrim( aTokens[5] )
        EndIf

    EndIf

Return cKey

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFRelHealthHolderKeyEx
@type           Function
@description    Retorna a chave exata do titular de plano de saude,
                preservando o contexto completo da ocorrencia.

@author         Denis R. de Oliveira
@since          25/03/2026
@version        1.0

@param          cRelaco, Character, Conteudo do campo relacao.
@return         cKey,    Character, Chave exata do titular.
 /*/
//---------------------------------------------------------------------
Function TAFRelHealthHolderKeyEx( cRelaco As Character ) As Character

    //-------------------------------------------------------------------------
    // Declaracao de Variaveis
    //-------------------------------------------------------------------------
    Local aTokens As Array
    Local cKey    As Character

    //-------------------------------------------------------------------------
    // Inicializacao de Parametros (Defaults)
    //-------------------------------------------------------------------------
    Default cRelaco := ""

    //-------------------------------------------------------------------------
    // Inicializacao de Variaveis
    //-------------------------------------------------------------------------
    aTokens := {}
    cKey    := ""

    //-------------------------------------------------------------------------
    // Processamento
    //-------------------------------------------------------------------------
    aTokens := StrTokArr( AllTrim( cRelaco ), "|" )

    If Len( aTokens ) >= 5 .And. ;
       AllTrim( aTokens[1] ) == "P" .And. ;
       AllTrim( aTokens[3] ) == "TIT"

        cKey := AllTrim( aTokens[1] ) + "|" + ;
                AllTrim( aTokens[2] ) + "|" + ;
                AllTrim( aTokens[3] ) + "|" + ;
                AllTrim( aTokens[4] ) + "|" + ;
                AllTrim( aTokens[5] )

        If Len( aTokens ) >= 7 .And. AllTrim( aTokens[6] ) == "ORPH"
            cKey += "|ORPH|" + AllTrim( aTokens[7] )
        EndIf

    ElseIf Len( aTokens ) >= 3 .And. AllTrim( aTokens[1] ) == "TIT"

        cKey := AllTrim( aTokens[1] ) + "|" + ;
                AllTrim( aTokens[2] ) + "|" + ;
                AllTrim( aTokens[3] )

        If Len( aTokens ) >= 5 .And. AllTrim( aTokens[4] ) == "ORPH"
            cKey += "|ORPH|" + AllTrim( aTokens[5] )
        EndIf

    EndIf

Return cKey

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFRelHealthDepKey
@type           Function
@description    Retorna a chave semantica do dependente de plano de saude,
                preservando o CPF do dependente e removendo apenas o sufixo
                tecnico do contexto do pai.

@author         Denis R. de Oliveira
@since          25/03/2026
@version        1.0

@param          cRelaco, Character, Conteudo do campo relacao.
@return         cKey,    Character, Chave semantica do dependente.
 /*/
//---------------------------------------------------------------------
Function TAFRelHealthDepKey( cRelaco As Character ) As Character

    //-------------------------------------------------------------------------
    // Declaracao de Variaveis
    //-------------------------------------------------------------------------
    Local aTokens As Array
    Local cCtxPai As Character
    Local cKey    As Character
    Local lIsOrph As Logical
    Local lIsDep  As Logical
    Local nBase   As Numeric

    //-------------------------------------------------------------------------
    // Inicializacao de Parametros (Defaults)
    //-------------------------------------------------------------------------
    Default cRelaco := ""

    //-------------------------------------------------------------------------
    // Inicializacao de Variaveis
    //-------------------------------------------------------------------------
    aTokens := {}
    cCtxPai := ""
    cKey    := ""
    lIsOrph := .F.
    lIsDep  := .F.
    nBase   := 0

    //-------------------------------------------------------------------------
    // Processamento
    //-------------------------------------------------------------------------
    aTokens := StrTokArr( AllTrim( cRelaco ), "|" )

    If Len( aTokens ) >= 5 .And. ;
       AllTrim( aTokens[1] ) == "P" .And. ;
       AllTrim( aTokens[3] ) == "TIT"

        cCtxPai := TAFCtxPaiSemanticKey( aTokens[2] )

        cKey := AllTrim( aTokens[1] ) + "|" + ;
                cCtxPai + "|" + ;
                AllTrim( aTokens[3] ) + "|" + ;
                AllTrim( aTokens[4] ) + "|" + ;
                AllTrim( aTokens[5] )

        nBase   := 6
        lIsOrph := ( Len( aTokens ) >= 7 .And. AllTrim( aTokens[6] ) == "ORPH" )
        
        // Se for orfao, concatena e muda a base
        cKey  += IIf( lIsOrph, "|ORPH|" + AllTrim( aTokens[7] ), "" )
        nBase := IIf( lIsOrph, 8, nBase )

        lIsDep := ( Len( aTokens ) >= ( nBase + 1 ) .And. AllTrim( aTokens[nBase] ) == "DEP" )
        
        // Concatena dependente se existir
        cKey += IIf( lIsDep, "|DEP|" + AllTrim( aTokens[nBase + 1] ), "" )

    ElseIf Len( aTokens ) >= 3 .And. AllTrim( aTokens[1] ) == "TIT"

        cKey := AllTrim( aTokens[1] ) + "|" + ;
                AllTrim( aTokens[2] ) + "|" + ;
                AllTrim( aTokens[3] )

        nBase := 4

        If Len( aTokens ) >= 5 .And. AllTrim( aTokens[4] ) == "ORPH"
            cKey += "|ORPH|" + AllTrim( aTokens[5] )
            nBase := 6
        EndIf

        If Len( aTokens ) >= ( nBase + 1 ) .And. AllTrim( aTokens[nBase] ) == "DEP"
            cKey += "|DEP|" + AllTrim( aTokens[nBase + 1] )
        EndIf

    EndIf

Return cKey

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFRelReimbHeaderKey
@type           Function
@description    Retorna a chave semantica do cabecalho de reembolso,
                preservando compatibilidade com os formatos antigo
                (CAB|INDREM|CNPJ|ANS) e novo (P|CTXPAI|CAB|INDREM|CNPJ|ANS).

@author         Denis R. de Oliveira
@since          25/03/2026
@version        1.0

@param          cRelaco, Character, Conteudo do campo relacao.
@return         cKey,    Character, Chave semantica do cabecalho.
 /*/
//---------------------------------------------------------------------
Function TAFRelReimbHeaderKey( cRelaco As Character ) As Character

    //-------------------------------------------------------------------------
    // Declaracao de Variaveis
    //-------------------------------------------------------------------------
    Local aTokens As Array
    Local cCtxPai As Character
    Local cKey    As Character

    //-------------------------------------------------------------------------
    // Inicializacao de Parametros (Defaults)
    //-------------------------------------------------------------------------
    Default cRelaco := ""

    //-------------------------------------------------------------------------
    // Inicializacao de Variaveis
    //-------------------------------------------------------------------------
    aTokens := {}
    cCtxPai := ""
    cKey    := ""

    //-------------------------------------------------------------------------
    // Processamento
    //-------------------------------------------------------------------------
    aTokens := StrTokArr( AllTrim( cRelaco ), "|" )

    If Len( aTokens ) >= 6 .And. ;
       AllTrim( aTokens[1] ) == "P" .And. ;
       AllTrim( aTokens[3] ) == "CAB"

        cCtxPai := TAFCtxPaiSemanticKey( aTokens[2] )

        cKey := AllTrim( aTokens[1] ) + "|" + ;
                cCtxPai + "|" + ;
                AllTrim( aTokens[3] ) + "|" + ;
                AllTrim( aTokens[4] ) + "|" + ;
                AllTrim( aTokens[5] ) + "|" + ;
                AllTrim( aTokens[6] )

        If Len( aTokens ) >= 8 .And. AllTrim( aTokens[7] ) == "ORPH"
            cKey += "|ORPH|" + AllTrim( aTokens[8] )
        EndIf

    ElseIf Len( aTokens ) >= 4 .And. AllTrim( aTokens[1] ) == "CAB"

        cKey := AllTrim( aTokens[1] ) + "|" + ;
                AllTrim( aTokens[2] ) + "|" + ;
                AllTrim( aTokens[3] ) + "|" + ;
                AllTrim( aTokens[4] )

        If Len( aTokens ) >= 6 .And. AllTrim( aTokens[5] ) == "ORPH"
            cKey += "|ORPH|" + AllTrim( aTokens[6] )
        EndIf

    EndIf

Return cKey

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFRelReimbHeaderKeyEx
@type           Function
@description    Retorna a chave exata do cabecalho de reembolso,
                preservando o contexto completo da ocorrencia.

@author         Denis R. de Oliveira
@since          25/03/2026
@version        1.0

@param          cRelaco, Character, Conteudo do campo relacao.
@return         cKey,    Character, Chave exata do cabecalho.
 /*/
//---------------------------------------------------------------------
Function TAFRelReimbHeaderKeyEx( cRelaco As Character ) As Character

    //-------------------------------------------------------------------------
    // Declaracao de Variaveis
    //-------------------------------------------------------------------------
    Local aTokens As Array
    Local cKey    As Character

    //-------------------------------------------------------------------------
    // Inicializacao de Parametros (Defaults)
    //-------------------------------------------------------------------------
    Default cRelaco := ""

    //-------------------------------------------------------------------------
    // Inicializacao de Variaveis
    //-------------------------------------------------------------------------
    aTokens := {}
    cKey    := ""

    //-------------------------------------------------------------------------
    // Processamento
    //-------------------------------------------------------------------------
    aTokens := StrTokArr( AllTrim( cRelaco ), "|" )

    If Len( aTokens ) >= 6 .And. ;
       AllTrim( aTokens[1] ) == "P" .And. ;
       AllTrim( aTokens[3] ) == "CAB"

        cKey := AllTrim( aTokens[1] ) + "|" + ;
                AllTrim( aTokens[2] ) + "|" + ;
                AllTrim( aTokens[3] ) + "|" + ;
                AllTrim( aTokens[4] ) + "|" + ;
                AllTrim( aTokens[5] ) + "|" + ;
                AllTrim( aTokens[6] )

        If Len( aTokens ) >= 8 .And. AllTrim( aTokens[7] ) == "ORPH"
            cKey += "|ORPH|" + AllTrim( aTokens[8] )
        ElseIf Len( aTokens ) >= 7
            cKey += "|" + AllTrim( aTokens[7] )
        EndIf

    ElseIf Len( aTokens ) >= 4 .And. AllTrim( aTokens[1] ) == "CAB"

        cKey := AllTrim( aTokens[1] ) + "|" + ;
                AllTrim( aTokens[2] ) + "|" + ;
                AllTrim( aTokens[3] ) + "|" + ;
                AllTrim( aTokens[4] )

        If Len( aTokens ) >= 6 .And. AllTrim( aTokens[5] ) == "ORPH"
            cKey += "|ORPH|" + AllTrim( aTokens[6] )
        ElseIf Len( aTokens ) >= 5
            cKey += "|" + AllTrim( aTokens[5] )
        EndIf

    EndIf

Return cKey

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFRelReimbTitKey
@type           Function
@description    Retorna a chave semantica do detalhe do titular de
                reembolso, preservando inscricao e numero do prestador.

@author         Denis R. de Oliveira
@since          25/03/2026
@version        1.0

@param          cRelaco, Character, Conteudo do campo relacao.
@return         cKey,    Character, Chave semantica do detalhe do titular.
 /*/
//---------------------------------------------------------------------
Function TAFRelReimbTitKey( cRelaco As Character ) As Character

    //-------------------------------------------------------------------------
    // Declaracao de Variaveis
    //-------------------------------------------------------------------------
    Local aTokens As Array
    Local cCtxPai As Character
    Local cKey    As Character
    Local nBase   As Numeric

    //-------------------------------------------------------------------------
    // Inicializacao de Parametros (Defaults)
    //-------------------------------------------------------------------------
    Default cRelaco := ""

    //-------------------------------------------------------------------------
    // Inicializacao de Variaveis
    //-------------------------------------------------------------------------
    aTokens := {}
    cCtxPai := ""
    cKey    := ""
    nBase   := 0

    //-------------------------------------------------------------------------
    // Processamento
    //-------------------------------------------------------------------------
    aTokens := StrTokArr( AllTrim( cRelaco ), "|" )

    If Len( aTokens ) >= 6 .And. ;
       AllTrim( aTokens[1] ) == "P" .And. ;
       AllTrim( aTokens[3] ) == "CAB"

        cCtxPai := TAFCtxPaiSemanticKey( aTokens[2] )

        cKey := AllTrim( aTokens[1] ) + "|" + ;
                cCtxPai + "|" + ;
                AllTrim( aTokens[3] ) + "|" + ;
                AllTrim( aTokens[4] ) + "|" + ;
                AllTrim( aTokens[5] ) + "|" + ;
                AllTrim( aTokens[6] )

        nBase := 7

        If Len( aTokens ) >= 8 .And. AllTrim( aTokens[7] ) == "ORPH"
            cKey += "|ORPH|" + AllTrim( aTokens[8] )
            nBase := 9
        ElseIf Len( aTokens ) >= 7 .And. AllTrim( aTokens[7] ) != "TIT"
            nBase := 8
        EndIf

        If Len( aTokens ) >= ( nBase + 2 ) .And. AllTrim( aTokens[nBase] ) == "TIT"
            cKey += "|TIT|" + AllTrim( aTokens[nBase + 1] ) + "|" + AllTrim( aTokens[nBase + 2] )
        EndIf

    ElseIf Len( aTokens ) >= 4 .And. AllTrim( aTokens[1] ) == "CAB"

        cKey := AllTrim( aTokens[1] ) + "|" + ;
                AllTrim( aTokens[2] ) + "|" + ;
                AllTrim( aTokens[3] ) + "|" + ;
                AllTrim( aTokens[4] )

        nBase := 5

        If Len( aTokens ) >= 6 .And. AllTrim( aTokens[5] ) == "ORPH"
            cKey += "|ORPH|" + AllTrim( aTokens[6] )
            nBase := 7
        ElseIf Len( aTokens ) >= 5 .And. AllTrim( aTokens[5] ) != "TIT"
            nBase := 6
        EndIf

        If Len( aTokens ) >= ( nBase + 2 ) .And. AllTrim( aTokens[nBase] ) == "TIT"
            cKey += "|TIT|" + AllTrim( aTokens[nBase + 1] ) + "|" + AllTrim( aTokens[nBase + 2] )
        EndIf

    EndIf

Return cKey

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFRelReimbDepKey
@type           Function
@description    Retorna a chave semantica do dependente de reembolso,
                preservando compatibilidade com os formatos antigo
                (CAB|INDREM|CNPJ|ANS|D|CPF) e novo
                (P|CTXPAI|CAB|INDREM|CNPJ|ANS|D|CPF).

@author         Denis R. de Oliveira
@since          25/03/2026
@version        1.0

@param          cRelaco, Character, Conteudo do campo relacao.
@return         cKey,    Character, Chave semantica do dependente.
 /*/
//---------------------------------------------------------------------
Function TAFRelReimbDepKey( cRelaco As Character ) As Character

    //-------------------------------------------------------------------------
    // Declaracao de Variaveis
    //-------------------------------------------------------------------------
    Local aTokens As Array
    Local cCtxPai As Character
    Local cKey    As Character
    Local nBase   As Numeric

    //-------------------------------------------------------------------------
    // Inicializacao de Parametros (Defaults)
    //-------------------------------------------------------------------------
    Default cRelaco := ""

    //-------------------------------------------------------------------------
    // Inicializacao de Variaveis
    //-------------------------------------------------------------------------
    aTokens := {}
    cCtxPai := ""
    cKey    := ""
    nBase   := 0

    //-------------------------------------------------------------------------
    // Processamento
    //-------------------------------------------------------------------------
    aTokens := StrTokArr( AllTrim( cRelaco ), "|" )

    If Len( aTokens ) >= 6 .And. ;
       AllTrim( aTokens[1] ) == "P" .And. ;
       AllTrim( aTokens[3] ) == "CAB"

        cCtxPai := TAFCtxPaiSemanticKey( aTokens[2] )

        cKey := AllTrim( aTokens[1] ) + "|" + ;
                cCtxPai + "|" + ;
                AllTrim( aTokens[3] ) + "|" + ;
                AllTrim( aTokens[4] ) + "|" + ;
                AllTrim( aTokens[5] ) + "|" + ;
                AllTrim( aTokens[6] )

        nBase := 7

        If Len( aTokens ) >= 8 .And. AllTrim( aTokens[7] ) == "ORPH"
            cKey += "|ORPH|" + AllTrim( aTokens[8] )
            nBase := 9
        ElseIf Len( aTokens ) >= 7 .And. AllTrim( aTokens[7] ) != "D"
            nBase := 8
        EndIf

        If Len( aTokens ) >= ( nBase + 1 ) .And. AllTrim( aTokens[nBase] ) == "D"
            cKey += "|D|" + AllTrim( aTokens[nBase + 1] )
        EndIf

    ElseIf Len( aTokens ) >= 4 .And. AllTrim( aTokens[1] ) == "CAB"

        cKey := AllTrim( aTokens[1] ) + "|" + ;
                AllTrim( aTokens[2] ) + "|" + ;
                AllTrim( aTokens[3] ) + "|" + ;
                AllTrim( aTokens[4] )

        nBase := 5

        If Len( aTokens ) >= 6 .And. AllTrim( aTokens[5] ) == "ORPH"
            cKey += "|ORPH|" + AllTrim( aTokens[6] )
            nBase := 7
        ElseIf Len( aTokens ) >= 5 .And. AllTrim( aTokens[5] ) != "D"
            nBase := 6
        EndIf

        If Len( aTokens ) >= ( nBase + 1 ) .And. AllTrim( aTokens[nBase] ) == "D"
            cKey += "|D|" + AllTrim( aTokens[nBase + 1] )
        EndIf

    EndIf

Return cKey

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFRelReimbDepKeyEx
@type           Function
@description    Retorna a chave exata do dependente de reembolso,
                preservando o contexto completo da ocorrencia.

@author         Denis R. de Oliveira
@since          25/03/2026
@version        1.0

@param          cRelaco, Character, Conteudo do campo relacao.
@return         cKey,    Character, Chave exata do dependente.
 /*/
//---------------------------------------------------------------------
Function TAFRelReimbDepKeyEx( cRelaco As Character ) As Character

    //-------------------------------------------------------------------------
    // Declaracao de Variaveis
    //-------------------------------------------------------------------------
    Local aTokens As Array
    Local cKey    As Character
    Local nBase   As Numeric

    //-------------------------------------------------------------------------
    // Inicializacao de Parametros (Defaults)
    //-------------------------------------------------------------------------
    Default cRelaco := ""

    //-------------------------------------------------------------------------
    // Inicializacao de Variaveis
    //-------------------------------------------------------------------------
    aTokens := {}
    cKey    := ""
    nBase   := 0

    //-------------------------------------------------------------------------
    // Processamento
    //-------------------------------------------------------------------------
    aTokens := StrTokArr( AllTrim( cRelaco ), "|" )

    If Len( aTokens ) >= 6 .And. ;
       AllTrim( aTokens[1] ) == "P" .And. ;
       AllTrim( aTokens[3] ) == "CAB"

        cKey := AllTrim( aTokens[1] ) + "|" + ;
                AllTrim( aTokens[2] ) + "|" + ;
                AllTrim( aTokens[3] ) + "|" + ;
                AllTrim( aTokens[4] ) + "|" + ;
                AllTrim( aTokens[5] ) + "|" + ;
                AllTrim( aTokens[6] )

        nBase := 7

        If Len( aTokens ) >= 8 .And. AllTrim( aTokens[7] ) == "ORPH"
            cKey += "|ORPH|" + AllTrim( aTokens[8] )
            nBase := 9
        ElseIf Len( aTokens ) >= 7 .And. AllTrim( aTokens[7] ) != "D"
            cKey += "|" + AllTrim( aTokens[7] )
            nBase := 8
        EndIf

        If Len( aTokens ) >= ( nBase + 1 ) .And. AllTrim( aTokens[nBase] ) == "D"
            cKey += "|D|" + AllTrim( aTokens[nBase + 1] )
        EndIf

    ElseIf Len( aTokens ) >= 4 .And. AllTrim( aTokens[1] ) == "CAB"

        cKey := AllTrim( aTokens[1] ) + "|" + ;
                AllTrim( aTokens[2] ) + "|" + ;
                AllTrim( aTokens[3] ) + "|" + ;
                AllTrim( aTokens[4] )

        nBase := 5

        If Len( aTokens ) >= 6 .And. AllTrim( aTokens[5] ) == "ORPH"
            cKey += "|ORPH|" + AllTrim( aTokens[6] )
            nBase := 7
        ElseIf Len( aTokens ) >= 5 .And. AllTrim( aTokens[5] ) != "D"
            nBase := 6
        EndIf

        If Len( aTokens ) >= ( nBase + 1 ) .And. AllTrim( aTokens[nBase] ) == "D"
            cKey += "|D|" + AllTrim( aTokens[nBase + 1] )
        EndIf

    EndIf

Return cKey

//---------------------------------------------------------------------
/*/{Protheus.doc} TAFRelReimbDepDetKey
@type           Function
@description    Retorna a chave semantica do detalhe do dependente de
                reembolso, preservando inscricao e numero do prestador.

@author         Denis R. de Oliveira
@since          25/03/2026
@version        1.0

@param          cRelaco, Character, Conteudo do campo relacao.
@return         cKey,    Character, Chave semantica do detalhe.
 /*/
//---------------------------------------------------------------------
Function TAFRelReimbDepDetKey( cRelaco As Character ) As Character

    //-------------------------------------------------------------------------
    // Declaracao de Variaveis
    //-------------------------------------------------------------------------
    Local aTokens As Array
    Local cCtxPai As Character
    Local cKey    As Character
    Local nBase   As Numeric

    //-------------------------------------------------------------------------
    // Inicializacao de Parametros (Defaults)
    //-------------------------------------------------------------------------
    Default cRelaco := ""

    //-------------------------------------------------------------------------
    // Inicializacao de Variaveis
    //-------------------------------------------------------------------------
    aTokens := {}
    cCtxPai := ""
    cKey    := ""
    nBase   := 0

    //-------------------------------------------------------------------------
    // Processamento
    //-------------------------------------------------------------------------
    aTokens := StrTokArr( AllTrim( cRelaco ), "|" )

    If Len( aTokens ) >= 6 .And. ;
       AllTrim( aTokens[1] ) == "P" .And. ;
       AllTrim( aTokens[3] ) == "CAB"

        cCtxPai := TAFCtxPaiSemanticKey( aTokens[2] )

        cKey := AllTrim( aTokens[1] ) + "|" + ;
                cCtxPai + "|" + ;
                AllTrim( aTokens[3] ) + "|" + ;
                AllTrim( aTokens[4] ) + "|" + ;
                AllTrim( aTokens[5] ) + "|" + ;
                AllTrim( aTokens[6] )

        nBase := 7

        If Len( aTokens ) >= 8 .And. AllTrim( aTokens[7] ) == "ORPH"
            cKey += "|ORPH|" + AllTrim( aTokens[8] )
            nBase := 9
        ElseIf Len( aTokens ) >= 7 .And. AllTrim( aTokens[7] ) != "D"
            nBase := 8
        EndIf

        If Len( aTokens ) >= ( nBase + 4 ) .And. ;
           AllTrim( aTokens[nBase] ) == "D" .And. ;
           AllTrim( aTokens[nBase + 2] ) == "T"

            cKey += "|D|" + AllTrim( aTokens[nBase + 1] ) + ;
                    "|T|" + AllTrim( aTokens[nBase + 3] ) + "|" + AllTrim( aTokens[nBase + 4] )
        EndIf

    ElseIf Len( aTokens ) >= 4 .And. AllTrim( aTokens[1] ) == "CAB"

        cKey := AllTrim( aTokens[1] ) + "|" + ;
                AllTrim( aTokens[2] ) + "|" + ;
                AllTrim( aTokens[3] ) + "|" + ;
                AllTrim( aTokens[4] )

        nBase := 5

        If Len( aTokens ) >= 6 .And. AllTrim( aTokens[5] ) == "ORPH"
            cKey += "|ORPH|" + AllTrim( aTokens[6] )
            nBase := 7
        ElseIf Len( aTokens ) >= 5 .And. AllTrim( aTokens[5] ) != "D"
            nBase := 6
        EndIf

        If Len( aTokens ) >= ( nBase + 4 ) .And. ;
           AllTrim( aTokens[nBase] ) == "D" .And. ;
           AllTrim( aTokens[nBase + 2] ) == "T"

            cKey += "|D|" + AllTrim( aTokens[nBase + 1] ) + ;
                    "|T|" + AllTrim( aTokens[nBase + 3] ) + "|" + AllTrim( aTokens[nBase + 4] )
        EndIf

    EndIf

Return cKey

//---------------------------------------------------------------------
/*/{Protheus.doc} MapAddPos
@type           Static Function
@description    Adiciona uma posição numérica a um índice em THashMap,
                preservando a ordem original do array.
@author         Denis R. de Oliveira
@since          05/03/2026

@param          oMap, Object, Instância de THashMap.
@param          cKey, Character, Chave de indexação.
@param          nPos, Numeric, Posição do array a ser guardada.
 /*/
//---------------------------------------------------------------------
Static Function MapAddPos( oMap As Object, cKey As Character, nPos As Numeric )

    //-------------------------------------------------------------------------
    // Declaração de Variáveis
    //-------------------------------------------------------------------------
    Local aPos As Array

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default oMap := Nil
    Default cKey := ""
    Default nPos := 0

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    aPos := {}

    //-------------------------------------------------------------------------
    // Adição no THashMap
    //-------------------------------------------------------------------------
    If ValType( oMap ) == "O" .And. !Empty( cKey )
        If oMap:Get( cKey, @aPos )
            aAdd( aPos, nPos )
        Else
            aPos := { nPos }
        EndIf

        oMap:Set( cKey, aPos )
    EndIf

Return

//---------------------------------------------------------------------
/*/{Protheus.doc} MapGetPos
@type           Static Function
@description    Retorna a lista de posições previamente indexadas para
                uma chave. Se não existir, retorna array vazio.
@author         Denis R. de Oliveira
@since          05/03/2026

@param          oMap, Object, Instância de THashMap preenchida.
@param          cKey, Character, Chave de busca.
@return         Array, Lista de posições cadastradas.
/*/
//---------------------------------------------------------------------
Static Function MapGetPos( oMap As Object, cKey As Character ) As Array

    //-------------------------------------------------------------------------
    // Declaração de Variáveis
    //-------------------------------------------------------------------------
    Local aPos As Array

    //-------------------------------------------------------------------------
    // Inicialização de Parâmetros (Defaults)
    //-------------------------------------------------------------------------
    Default oMap := Nil
    Default cKey := ""

    //-------------------------------------------------------------------------
    // Inicialização de Variáveis
    //-------------------------------------------------------------------------
    aPos := {}

    //-------------------------------------------------------------------------
    // Retorna as posições
    //-------------------------------------------------------------------------
    If ValType( oMap ) == "O" .And. !Empty( cKey )
        If oMap:Get( cKey, @aPos )
            Return aPos
        EndIf
    EndIf

Return {}
