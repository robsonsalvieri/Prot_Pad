#include 'tlpp-core.th'
#include 'tlpp-rest.th'
#include 'TOTVS.CH'
#DEFINE PATH_URL '/api/agd/v2/configuracao-campos/:dominio'



namespace totvs.protheus.agrobusiness.agd  /*nameSpace - para ser importado em shortcurt*/


/*/{Protheus.doc} ConfigFieldsController
Controller de Negócios Barter
@type class
@version 12
@author jean.schulze
@since 13/01/2025
/*/
class ConfigFieldsController
	public Data nPage     As Integer
	public Data nPageSize As Integer

	public method new()

	@Get(PATH_URL)
	public method listarCampos() as logical

endClass

/*/{Protheus.doc} new
Constructor
@type method
@version 12
@author jean.schulze
@since 13/01/2025
@return variant, inst ncia
/*/
method new() class ConfigFieldsController
return self

/*/{Protheus.doc} listar
Recurso REST para listar Neg cios Barter
@type method
@version 12
@author jean.schulze
@since 13/01/2025
@return logical, true
/*/
method listarCampos() as logical class ConfigFieldsController
	Local oRestService As Object
	Local ConfigFieldsService As Object
	Local cDominio as Character
	Local oJsonPath

	oRestService := RestService():New()

	oJsonPath := oRest:getPathParamsRequest()

	If ValType(oJsonPath) == "J" .And. oJsonPath:hasProperty("dominio")
		cDominio := oJsonPath["dominio"]
	EndIf

	ConfigFieldsService := ConfigFieldsService():new()
	ConfigFieldsService:getFields(cDominio)

	oRestService:setAPIResponse(oRest, ConfigFieldsService)

	FreeObj(ConfigFieldsService)
	FreeObj(oRestService)
return .T.

