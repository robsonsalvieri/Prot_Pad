#include 'tlpp-core.th'
#include 'tlpp-rest.th'
#include 'TOTVS.CH'
#DEFINE PATH_URL '/api/agd/v2/contratos-compra'
#DEFINE PATH_URL_DESVINCULAR '/api/agd/v2/contratos-compra/desvincular/:idContrato/:codigoContrato/:itemContrato'
#DEFINE PATH_URL_VINCULAR '/api/agd/v2/contratos-compra/vincular/:codigoNegociacao/:versao/:codigoContratoExt'
#DEFINE PATH_URL_OG '/api/agd/v2/contratos-compra/contratos-og-disponiveis/:codigoNegociacao/:versao'
#DEFINE PATH_URL_OG_ID '/api/agd/v2/contratos-compra/contratos-og-disponiveis/:codigoNegociacao/:versao/:codigoContratoExt'
#DEFINE PATH_URL_LISTAR_CONTRATOS_VINCULADOS '/api/agd/v2/contratos-compra/:codigoNegociacao/:versao/contratos-compra-vinculados'
#DEFINE PATH_URL_VINCULAR_NUM_NEGOCIO '/api/agd/v2/contratos-compra/vincular-negociacao/:codigoNegociacao/:itemContrato/:item'
#DEFINE PATH_URL_ERRO_INTEGRACAO '/api/agd/v2/contratos-compra/:codigoNegociacao/:itemContrato/:item/erro-integracao'
namespace totvs.protheus.agrobusiness.agd  /*nameSpace - para ser importado em shortcurt*/


/*/{Protheus.doc} PurchaseContractController
Controller de Contratos de Compra
@type class
@version 12
@author jean.schulze
@since 13/01/2025
/*/
class PurchaseContractController
	public Data nPage     As Integer
	public Data nPageSize As Integer

	public method new()

	@Get(PATH_URL)
	public method listar() as logical

	@Get(PATH_URL_OG)
	public method listarContratosOG() as logical

	@Get(PATH_URL_OG_ID)
	public method listarContratosOgID() as logical

	@Get(PATH_URL_LISTAR_CONTRATOS_VINCULADOS)
	public method listarContratosVinculados() as logical

	@PUT( PATH_URL_DESVINCULAR)
	public method desvincular() as logical

	@POST( PATH_URL_VINCULAR)
	public method vincularcontrato() as logical

	@PUT( PATH_URL_VINCULAR_NUM_NEGOCIO)
	public method updateNEFBusiness() as logical

	@PUT( PATH_URL_ERRO_INTEGRACAO)
	public method informarErroIntegracao() as logical

endClass

/*/{Protheus.doc} new
Constructor
@type method
@version 12
@author jean.schulze
@since 13/01/2025
@return variant, instância
/*/
method new() class PurchaseContractController
return self

/*/{Protheus.doc} listar
Recurso REST para listar Contratos de Comrpa
@type method
@version 12
@author jean.schulze
@since 13/01/2025
@return logical, true
/*/
method listar() as logical class PurchaseContractController
	Local oService As Object
	Local oRestService As Object

	oRestService := RestService():New()
	oService := ContractACLViewService():New()

	oRestService:getPageAndPageSize(@Self:nPage, @Self:nPageSize)

	oService:listar(Self:nPage, Self:nPageSize, oRestService:getQueryParams())

	oRestService:setAPIResponse(oRest, oService)

	FreeObj(oService)
	FreeObj(oRestService)
return .T.

/*/{Protheus.doc} PurchaseContractController::desvincular
API Rest para desvincular contrato de compra OG
@type method
@version p12
@author scheronlini.martins
@since 07/08/2025
@return logical, return_true
/*/
method desvincular() as logical class PurchaseContractController
	Local oService As Object
	Local oRestService As Object
	Local cMsgOBS as Character
	local jMensagem As Object
	Local lTela:= .F.

	oRestService := RestService():New()
	jMensagem := oRestService:getRequestBody()

	cIdcontrato     :=oRestService:getIDWithPathParams({{'idContrato','NEF_IDCTR'}, ;
		{'codigoContrato','NEF_CODBRT'}, ;
		{'itemContrato','NEF_ITECTR'} })

	if !Empty(cIdContrato)
		cIdContrato:=  xfilial("NEF") + cIdContrato
		if ValType(jMensagem) == "J" .And. jMensagem:hasProperty("motivo") .and. ValType(jMensagem["motivo"]) == "C"
			cMsgOBS := cValtoChar(jMensagem['motivo'] )
		EndIf
		oService := ContractACLBindService():New(cIdContrato)
		oService:desvincularContrato(lTela,cMsgOBS)
	EndIf

	oRestService:setAPIResponse(oRest, oService)

	FreeObj(oService)
	FreeObj(oRestService)
return .T.


/*/{Protheus.doc} PurchaseContractController::vincularcontrato
metodo para vincular o contrato OG
@type method
@version P12
@author scheronlini.martins
@since 15/08/2025
@return logical, return_true
/*/
method vincularcontrato()  as logical class PurchaseContractController
	Local cCodigoNegociacao
	Local cVersao
	Local cCodigoContratoext
	Local oRestService As Object
	Local oCtrAclServ := ContractACLBindService():New()

	oRestService := RestService():New()

	cCodigoNegociacao  :=oRestService:getIDWithPathParams({{'codigoNegociacao','NEA_CODIGO'}})
	cVersao            :=oRestService:getIDWithPathParams({{'versao','NEA_VERSAO'}})
	cCodigoContratoext  :=oRestService:getIDWithPathParams({{'codigoContratoExt','NEF_CTREXT'}})

	IF !Empty(cCodigoNegociacao) .AND. !Empty(cVersao) .AND. !Empty(cCodigoContratoext)
		oCtrAclServ:vincular(cCodigoNegociacao,cVersao,cCodigoContratoext)
	EndIf

	oRestService:setAPIResponse(oRest, oCtrAclServ)

	FreeObj(oCtrAclServ)
	FreeObj(oRestService)

Return .t.

/*/{Protheus.doc} PurchaseContractController::listarContratosOG
Lista contratos OG disponiveis para vinculo
@type method
@version P12
@author scheronlini.martins
@since 19/08/2025
@return logical, return .t.
/*/
method listarContratosOG() as logical class PurchaseContractController
	Local oRestService As Object
	Local oCtrAclServ := ContractACLBindService():New()
	Local oJsonQryParam As Object
	Local cCodigoNegociacao
	Local cVersao   
	
	oRestService := RestService():New()
	oJsonQryParam := oRestService:getQueryParams()

	cCodigoNegociacao  :=oRestService:getIDWithPathParams({{'codigoNegociacao','NEA_CODIGO'}})
	cVersao            :=oRestService:getIDWithPathParams({{'versao','NEA_VERSAO'}})

	oRestService:getPageAndPageSize(@Self:nPage, @Self:nPageSize)
	

	oCtrAclServ:listar(Self:nPage, Self:nPageSize,oJsonQryParam,cCodigoNegociacao,cVersao)

	oRestService:setAPIResponse(oRest, oCtrAclServ)

	FreeObj(oCtrAclServ)
	FreeObj(oRestService)
	
return .T.

/*/{Protheus.doc} PurchaseContractController::listarContratosOgID
Lista dados contrato OG disponiveis para vinculo por numero de contrato
@type method
@version P12
@author scheronlini.martins
@since 20/08/2025
@return logical, return .t.
/*/
method listarContratosOgID() as logical class PurchaseContractController
	Local oRestService As Object
	Local oCtrAclServ := ContractACLBindService():New()
	Local oJsonQryParam As Object
	Local cCodigoNegociacao
	Local cVersao   
	Local cCodContratoExt
	
	oRestService := RestService():New()
	oJsonQryParam := oRestService:getQueryParams()

	cCodigoNegociacao  :=oRestService:getIDWithPathParams({{'codigoNegociacao','NEA_CODIGO'}})
	cVersao            :=oRestService:getIDWithPathParams({{'versao','NEA_VERSAO'}})
	cCodContratoExt    :=oRestService:getIDWithPathParams({{'codigoContratoExt','NEF_CTREXT'}})

	oRestService:getPageAndPageSize(@Self:nPage, @Self:nPageSize)
	

	oCtrAclServ:listar(Self:nPage, Self:nPageSize,oJsonQryParam,cCodigoNegociacao,cVersao,cCodContratoExt)

	oRestService:setAPIResponse(oRest, oCtrAclServ)

	FreeObj(oCtrAclServ)
	FreeObj(oRestService)
	
return .T.

/*/{Protheus.doc} PurchaseContractController::listarContratosVinculados
Lista contratos OG vinculados numa negociacao
@type method
@version P12
@author carlos.augusto
@since 25/08/2025
@return logical, return .t.
/*/
method listarContratosVinculados() as logical class PurchaseContractController
	Local oRestService As Object
	Local oCtrProtheus := ContractOriginationProtheusService():New()
	Local oJsonQryParam As Object
	Local cCodigoNegociacao
	Local cVersao   
	
	oRestService := RestService():New()
	oJsonQryParam := oRestService:getQueryParams()

	cCodigoNegociacao  := oRestService:getIDWithPathParams({{'codigoNegociacao','NEA_CODIGO'}})
	cVersao            := oRestService:getIDWithPathParams({{'versao','NEA_VERSAO'}})

	If !Empty(cCodigoNegociacao) .And. !Empty(cVersao)
		oRestService:getPageAndPageSize(@Self:nPage, @Self:nPageSize)
		oCtrProtheus:listarContratosVinculados(Self:nPage, Self:nPageSize,oJsonQryParam,cCodigoNegociacao,cVersao)
		oRestService:setAPIResponse(oRest, oCtrProtheus)
	Endif

	FreeObj(oCtrProtheus)
	FreeObj(oRestService)
	
return .T.

/*/{Protheus.doc} updateNEFBusiness
API Rest para atualizar numero do negocio no contrato barter
@type method
@version p12
@author gilson.venturi
@since 19/03/2025
@return logical, return_true
/*/
method updateNEFBusiness() as logical class PurchaseContractController
	Local oService     As Object
	Local oRestService As Object
	Local jCmdBody     As Object

	oRestService := RestService():New()

	if oRestService:isFilialInformado()
		jCmdBody			:= oRestService:getRequestBody() 
		cChaveIDRepository	:= Padr(FWxFilial("NEF"),TamSx3("NEF_FILIAL")[1]);
							 + oRestService:getIDWithPathParams({{'codigoNegociacao','NEF_CODBRT'}, ;
								{'itemContrato','NEF_ITECTR'}, ;
								{'item','NEF_ITEM'} })

		If !Empty(cChaveIDRepository)
			oService := ContractACLBindService():New()
			oService:updateNEFBusiness(cChaveIDRepository, jCmdBody)
			oRestService:setAPIResponse(oRest, oService)
		EndIf
	EndIf

	FreeObj(oService)
	FreeObj(oRestService)

return .T.


/*/{Protheus.doc} informarErroIntegracao
API Rest para atualizar numero do negocio no contrato barter
@type method
@version p12
@author jean.schulze
@since 19/03/2025
@return logical, return_true
/*/
method informarErroIntegracao() as logical class PurchaseContractController
	Local oService     As Object
	Local oRestService As Object

	oRestService := RestService():New()

	cChaveIDRepository	:= oRestService:getIDWithPathParams({{'codigoNegociacao','NEF_CODBRT'}, ;
													     	 {'itemContrato','NEF_ITECTR'}, ;
															 {'item','NEF_ITEM'} })

	If !Empty(cChaveIDRepository)
		oService := ContractACLBindService():New(FWxFilial("NEF")+cChaveIDRepository)
		oService:informarErroIntegracao()
		oRestService:setAPIResponse(oRest, oService)
	EndIf

	FreeObj(oService)
	FreeObj(oRestService)

return .T.

