#include 'tlpp-core.th'
#include 'tlpp-rest.th'
#include 'TOTVS.CH'
#DEFINE PATH_URL '/api/agd/v2/contratos-compra-movimentos/'

namespace totvs.protheus.agrobusiness.agd /*nameSpace - para ser importado em shortcurt*/


/*/{Protheus.doc} PurchaseContractMovimentController
Controller de Contratos de Compra
@type class
@version 12
@author jean.schulze
@since 13/01/2025
/*/
class PurchaseContractMovimentController
	public Data nPage     As Integer
	public Data nPageSize As Integer

	public method new()

	@Get(PATH_URL)
	public method listar() as logical

	@Post(PATH_URL)
	public method insertContractMovement() as logical

	@Delete(PATH_URL)
	public method excluir() as logical

endClass

/*/{Protheus.doc} new
Constructor
@type method
@version 12
@author jean.schulze
@since 13/01/2025
@return variant, instância
/*/
method new() class PurchaseContractMovimentController
return self

/*/{Protheus.doc} listar
Recurso REST para listar Contratos de Comrpa
@type method
@version 12
@author jean.schulze
@since 13/01/2025
@return logical, true
/*/
method listar() as logical class PurchaseContractMovimentController
	Local oService As Object
	Local oRestService As Object

	oRestService := RestService():New()
	oService := ContractACLViewService():New()

	oRestService:getPageAndPageSize(@Self:nPage, @Self:nPageSize)

	oService:listarMovimentos(Self:nPage, Self:nPageSize, oRestService:getQueryParams())

	oRestService:setAPIResponse(oRest, oService)

	FreeObj(oService)
	FreeObj(oRestService)
return .T.

/*/{Protheus.doc} insertContractMovement
API REST para gravar movimento de contrato de compra.
Recebe o corpo da requisição e delega o processamento ao service.
@type method
@version 1.0
@author rodrigo.nsoledade
@since 01/04/2026
@return logical, true
/*/
method insertContractMovement() as logical class PurchaseContractMovimentController
	Local oService      As Object
	Local oRestService  As Object
	Local jBody         As Json

	oRestService := RestService():New()
	oService     := ContractACLMovimentService():New()

	jBody := oRestService:getRequestBody()

	oService:insertContractMovement(jBody)

	oRestService:setAPIResponse(oRest, oService)

	FreeObj(oService)
	FreeObj(oRestService)
return .T.

/*/{Protheus.doc} excluir
Recurso REST para excluir movimentos do Contrato de Comrpa
@type method
@version 12
@author gilson.venturi
@since 09/04/2025
@return logical, true
/*/
method excluir() as logical class PurchaseContractMovimentController
	Local oService     As Object
	Local oRestService As Object

	oRestService := RestService():New()

	if ValType(jPath := oRestService:getQueryParams()) == "J";
			.And. jPath:hasProperty("idMovimento")
		cChave := jPath["idMovimento"]
	endIf

	oService := ContractACLMovimentService():New()
	oService:deleteByIdMovto(cChave)
	
	oRestService:setAPIResponse(oRest, oService)

	FreeObj(oService)
	FreeObj(oRestService)
return .T.
