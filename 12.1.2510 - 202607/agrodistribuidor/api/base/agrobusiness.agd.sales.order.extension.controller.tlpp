#include 'tlpp-core.th'
#include 'tlpp-rest.th'
#include 'TOTVS.CH'

#DEFINE PATH_URL '/api/agd/v2/pedido-de-venda/ext'
#DEFINE PATH_URL_ID '/api/agd/v2/pedido-de-venda/ext/:numPedido'
#DEFINE PATH_INFORMAR_INTEG_EXTERNA '/api/agd/v2/pedido-de-venda/ext/:numPedido/informar-integracao-externa'

namespace totvs.protheus.agrobusiness.agd 

/*/{Protheus.doc} SalesOrderExtensionController
Controller de dados da tabela de extensão do Pedidos de Venda(NEQ) do Agrodistribuidor.
@type class
@version 12
@author claudineia.reinert
@since 04/05/2026
/*/
class SalesOrderExtensionController
	public Data nPage     As Integer
	public Data nPageSize As Integer

	public method new()

	@Post(PATH_URL)
	public method registrar() as logical

	@Get(PATH_URL)
	public method listar() as logical

	@Put(PATH_INFORMAR_INTEG_EXTERNA)
	public method informarIntegracaoExterna() as logical

endClass

/*/{Protheus.doc} new
Constructor
@type class
@version 12
@author claudineia.reinert
@since 04/05/2026
/*/
method new() class SalesOrderExtensionController
return self

/*/{Protheus.doc} listar
Recurso REST GET para listar registros na tabela de extensão do pedido de venda(NEQ) do agro distribuidor
@type method
@version 12
@author claudineia.reinert
@since 13/05/2026
@return logical, true
/*/
method listar() as logical class SalesOrderExtensionController
	Local oSOEService As Object
	Local oRestService As Object
	Local oJsonQryParam := Nil

	oRestService := RestService():New()
	oSOEService := SalesOrderExtensionService():New()

	oRestService:getPageAndPageSize(@Self:nPage, @Self:nPageSize)
	oJsonQryParam := oRestService:getQueryParams()

	oSOEService:listar(Self:nPage, Self:nPageSize, oJsonQryParam)

	oRestService:setAPIResponse(oRest, oSOEService)

	FreeObj(oSOEService)
	FreeObj(oRestService)
return .T.

/*/{Protheus.doc} registrar
Recurso REST POST para inserir registro na tabela de extensão do pedido de venda(NEQ) do agro distribuidor
@type method
@version 12
@author claudineia.reinert
@since 04/05/2026
@return logical, true
/*/
method registrar() as logical class SalesOrderExtensionController
	Local oSOEService As Object
	Local oRestService As Object
	Local jCmdRegistrar as Json

	oRestService := RestService():New()
	oSOEService := SalesOrderExtensionService():New()

	jCmdRegistrar := oRestService:getRequestBody()

	oSOEService:registrar(jCmdRegistrar)
	oRestService:setAPIResponse(oRest, oSOEService)

	FreeObj(oSOEService)
	FreeObj(oRestService)
	FreeObj(jCmdRegistrar)
return .T.

/*/{Protheus.doc} SalesOrderExtensionController::informarIntegracaoExterna
Informa que o pedido na tabela de extensão do pedido de venda do agrodistribuidor foi gerado via integração externa 
@type method
@version P12
@author claudineia.reinert
@since 30/04/2026
@return logical, true
/*/
method informarIntegracaoExterna() as logical class SalesOrderExtensionController
	local oSOEService 		as object
	local oRestService		as object
	local oJsonPath			as object
    Local cIdRepository		As Character
    Local cNumPedido		As Character

	oRestService := RestService():New()

	oJsonPath := oRest:getPathParamsRequest()	
    cNumPedido := oRestService:getIDWithPathParams({{"numPedido", "NEQ_NUM"}})
	If !Empty(cNumPedido)
		cIdRepository := xFilial("NEQ") + cNumPedido
		oSOEService := SalesOrderExtensionService():New()
		oSOEService:informarIntegracaoExterna(cIdRepository)
		oRestService:setAPIResponse(oRest, oSOEService)
	Endif
	FreeObj(oSOEService)
	FreeObj(oRestService)
return .t.
