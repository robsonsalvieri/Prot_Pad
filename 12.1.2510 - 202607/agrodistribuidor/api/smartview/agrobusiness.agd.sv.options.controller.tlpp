#include "tlpp-core.th"
#include "tlpp-rest.th"
#include "totvs.ch"
#DEFINE URL_AGDA010_STATUS '/api/agd/v1/smartview/option/AGDA010/status'
#DEFINE URL_AGDA010_STATUSAUT '/api/agd/v1/smartview/option/AGDA010/statusAutorizacao'

namespace totvs.protheus.agrobusiness.agd //.sv.negociacao.options

/*/{Protheus.doc} OptionsBusinessController
API REST para estrutura de combobox
@type class
@version 1.0
@author lindembergson.pacheco
@since 03/03/2026
/*/
class OptionsBusinessController
	public Data nPage     as numeric
	public Data nPageSize as numeric

	public method New() constructor

	@Get(URL_AGDA010_STATUS)
	public method getStatus() as logical

	@Get(URL_AGDA010_STATUSAUT)
	public method getStatusAut() as logical
endclass

method New() class OptionsBusinessController
return Self

/*/{Protheus.doc} getStatus
Endpoint para listar status da negociacao
@type method
@version 1.0
@author lindembergson.pacheco
@since 03/03/2026
@return logical
/*/
method getStatus() as logical class OptionsBusinessController

	Local oRestService  as object
	Local oJson         as object
	Local oJsonCB        as object
	Local aCBox         as Array
	Local aJson         as Array
	Local nX            := 0

	oRestService := RestService():New()
	oJson := JsonObject():New()

	aCBox := x3CboxToArray("NEA_STATUS")

	aJson := {}
	oJsonCB := JsonObject():New()
	oJsonCB["key"] :=  "-1"
	oJsonCB["label"] := "Todos"
	aAdd(aJson, oJsonCB)
	For nX := 1 to Len(aCBox[2])
		oJsonCB := JsonObject():New()
		oJsonCB["key"] :=  aCBox[2][nX]
		oJsonCB["label"] := alltrim(aCBox[1][nX])
		aAdd(aJson, oJsonCB)
	Next
	oJson["data"] := aJson

	oRestService:setSuccess(oRest,oJson) 

	FreeObj(oRestService)
return .T.


/*/{Protheus.doc} getStatusAut
Endpoint para listar status de autorizacao da negociacao
@type method
@version 1.0
@author lindembergson.pacheco
@since 03/03/2026
@return logical
/*/
method getStatusAut() as logical class OptionsBusinessController
	Local oRestService  as object
	Local oJson         as object
	Local oJsonCB        as object
	Local aCBox         as Array
	Local aJson         as Array
	Local nX            := 0

	oRestService := RestService():New()
	oJson := JsonObject():New()

	aCBox := x3CboxToArray("NEA_STSAUT")

	aJson := {}
	oJsonCB := JsonObject():New()
	oJsonCB["key"] :=  "-1"
	oJsonCB["label"] := "Todos"
	aAdd(aJson, oJsonCB)
	For nX := 1 to Len(aCBox[2])
		oJsonCB := JsonObject():New()
		oJsonCB["key"] :=  aCBox[2][nX]
		oJsonCB["label"] := alltrim(aCBox[1][nX])
		aAdd(aJson, oJsonCB)

	Next
	oJson["data"] := aJson
	
	oRestService:setSuccess(oRest,oJson) 

	FreeObj(oRestService)

return .T.
