#include 'tlpp-core.th'
#include 'tlpp-rest.th'
#include 'TOTVS.CH'

#DEFINE PATH_URL '/api/agd/v2/receituario'
#DEFINE PATH_URL_DISPONIVEIS '/api/agd/v2/receituario/disponiveis'
#DEFINE PATH_URL_ID_ITENS '/api/agd/v2/receituario/:id/itens'
#DEFINE PATH_URL_SOLICITACAO '/api/agd/v2/receituario/solicitacao'
#DEFINE PATH_URL_CANCELAR '/api/agd/v2/receituario/:idExterno/cancelar'
#DEFINE PATH_URL_DADOS_NOTA_SAIDA '/api/agd/v2/receituario/dados-nota-saida'
#DEFINE PATH_URL_DADOS_NOTAS_ENTRADA '/api/agd/v2/receituario/dados-nota-entrada'

namespace totvs.protheus.agrobusiness.agd   /*nameSpace - para ser importado em shortcurt*/


/*/{Protheus.doc} RecipeController
Controller de Receitas Agronômicas Geradas
@type class
@version 12
@author jean.schulze
@since 26/11/2025
/*/
class RecipeController
	public Data nPage     As Integer
	public Data nPageSize As Integer

	public method new()

	@Get(PATH_URL)
	public method listar() as logical

	@Get(PATH_URL_DISPONIVEIS)
	public method getReceitasDisponiveis() as logical

	@Get(PATH_URL_ID_ITENS)
	public method getIDReceitaItens() as logical

	@Post(PATH_URL_SOLICITACAO)
	public method criarReceitaPorSolicitacao() as logical

	@Put(PATH_URL_CANCELAR)
	public method cancelarReceita() as logical

	@Get(PATH_URL_DADOS_NOTA_SAIDA)
	public method getDadosNotaSaida() as logical

	@Get(PATH_URL_DADOS_NOTAS_ENTRADA)
	public method getPurchaseInvoiceData() as logical

	@Post(PATH_URL_DADOS_NOTA_SAIDA)
	public method saveDadosNotaSaida() as logical

	@Post(PATH_URL_DADOS_NOTAS_ENTRADA)
	public method saveDadosNotaEntrada() as logical

endClass

/*/{Protheus.doc} new
Constructor
@type method
@version 12
@author jean.schulze
@since 26/11/2025
@return variant, self
/*/
method new() class RecipeController
return self

/*/{Protheus.doc} listar
Listagem de Receitas Agronômicas
@type method
@version 12
@author jean.schulze
@since 26/11/2025
@return logical, nil
/*/
method listar() as logical class RecipeController
	Local oService As Object
	Local oRestService As Object
	Local oJsonQryParam := Nil

	oRestService := RestService():New()
	oService := RecipeService():New()

	oRestService:getPageAndPageSize(@Self:nPage, @Self:nPageSize)
	oJsonQryParam := oRestService:getQueryParams()

	oService:listar(Self:nPage, Self:nPageSize, oJsonQryParam)

	oRestService:setAPIResponse(oRest, oService)

	FreeObj(oService)
	FreeObj(oRestService)
return .T.

/*/{Protheus.doc} getReceitasDisponiveis
Busca os registros de receituarios disponíveis para reaproveitamento
@type method
@version P12 
@author claudineia.reinert
@since 27/11/2025
/*/
method getReceitasDisponiveis() class RecipeController
	Local oService As Object
	Local oRestService As Object
	Local oJsonQryParam := Nil

	oRestService := RestService():New()
	oService := RecipeService():New()

	oRestService:getPageAndPageSize(@Self:nPage, @Self:nPageSize)
	oJsonQryParam := oRestService:getQueryParams()

	oService:listarReceitasDisponiveis(Self:nPage, Self:nPageSize, oJsonQryParam)

	oRestService:setAPIResponse(oRest, oService)

	FreeObj(oService)
	FreeObj(oRestService)
return .T.

/*/{Protheus.doc} getItensIDReceita
API rest para listar os itens da receita
@type method
@version  P12
@author claudineia.reinert
@since 27/11/2025
/*/
method getIDReceitaItens() class RecipeController
	Local oRestService  As Object
	Local oServiceItens As Object
	Local oJsonQryParam As Object
	Local oJsonPath     As Object
	Local cId           As Character

	oRestService := RestService():New()
	oServiceItens := RecipeItemService():New()

	oRestService:getPageAndPageSize(@Self:nPage, @Self:nPageSize)
	oJsonQryParam := oRestService:getQueryParams()
	oJsonPath := oRest:getPathParamsRequest()

	If ValType(oJsonPath) == "J" .And. oJsonPath:hasProperty("id")
		cId := oJsonPath["id"]
	EndIf

	oServiceItens:listarItensPorIdReceita(cId, Self:nPage, Self:nPageSize, oJsonQryParam)

	oRestService:setAPIResponse(oRest, oServiceItens)

	FreeObj(oServiceItens)
	FreeObj(oRestService)
return .T.

/*/{Protheus.doc} getPurchaseInvoiceData
API rest para listar Dados das notas de entrada
@type method
@version  P12
@author gilson.venturi
@since 30/03/2026
/*/
method getPurchaseInvoiceData() class RecipeController
	Local oService     as object
	Local oRestService as object

	oRestService := RestService():New()
	oService     := RecipeService():New()

	// Obtém paginação da requisição
	oRestService:getPageAndPageSize(@Self:nPage, @Self:nPageSize)

	// Executa consulta com filtros da query string
	oService:listPurchaseInvoiceData(Self:nPage, Self:nPageSize, oRestService:getQueryParams())

	// Monta resposta da API
	oRestService:setAPIResponse(oRest, oService)

	FreeObj(oService)
	FreeObj(oRestService)

return .T.

/*/{Protheus.doc} criarReceitaPorSolicitacao
API Rest para gerar Receita Agronômica a ser vinculada a Solicitação de Receita
@type method
@version P12
@author Gilson.Venturi
@since 18/11/2025
@return logical, return_true
/*/
method criarReceitaPorSolicitacao() as logical class RecipeController
	local oRestService as object
	local oService      as object
	Local jBody         as json

	oRestService := RestService():New()

	jBody      := oRestService:getRequestBody()
	oService   := RecipeService():New()

	oService:createReceitaBySolitacao(jBody)
	oRestService:setAPIResponse( oRest, oService)

	FWFreeObj(oRestService)
return .T.

/*/{Protheus.doc} cancelarReceita
Recurso Rest para cancelar uma receita agronômica
@type method
@version 12
@author Gilson.Venturi
@since 05/12/2025
@return logical, true
/*/
method cancelarReceita() as logical class RecipeController
	Local oService     as Object
	Local oRestService as Object
	Local oJsonPath    as Json

	oRestService := RestService():New()
	oJsonPath := oRest:getPathParamsRequest()

	If ValType(oJsonPath) == "J" .And. oJsonPath:hasProperty("idExterno")

		oService := RecipeService():New()
		oService:cancelarReceita(oJsonPath["idExterno"])

		oRestService:setAPIResponse(oRest, oService)
	EndIf

	FreeObj(oService)
	FreeObj(oRestService)
	FreeObj(oJsonPath)

return .T.

/*/{Protheus.doc} getDadosNotaSaida
API Rest para buscar os dados da nota de saída vinculada ao receituário,
com suporte à paginação e filtros por query string.
@type method
@version 1.0
@author rodrigo.nsoledade
@since 19/03/2026
@return logical, .T.
 /*/
method getDadosNotaSaida() as logical class RecipeController
	Local oService     as object
	Local oRestService as object

	oRestService := RestService():New()
	oService     := RecipeService():New()

	// Obtém paginação da requisição
	oRestService:getPageAndPageSize(@Self:nPage, @Self:nPageSize)

	// Executa consulta com filtros da query string
	oService:getDadosNotaSaida(Self:nPage, Self:nPageSize, oRestService:getQueryParams())

	// Monta resposta da API
	oRestService:setAPIResponse(oRest, oService)

	FreeObj(oService)
	FreeObj(oRestService)

return .T.

