#include "totvs.ch"
#include "tlpp-core.th"
#include "agrobusiness.agd.environment.version.service.ch"

namespace totvs.protheus.agrobusiness.agd 


/*/{Protheus.doc} EnvironmentVersionService
Servico para buscar a versão do RPO ou algum fonte enviado via path param
@type class
@version 12
@author carlos.augusto
@since 30/01/2026
/*/ 
class EnvironmentVersionService FROM UtilsService
    public method New()
    public method getVersaoRPO()
    public method getVersaoFonte() 
endclass


/*/{Protheus.doc} New
Cria referencia
@type class
@version 12
@author carlos.augusto
@since 30/01/2026
/*/ 
method New() class EnvironmentVersionService
    _Super:New()
return Self


/*/{Protheus.doc} getVersaoRPO
Retorna a versao do RPO
@type class
@version 12
@author carlos.augusto
@since 30/01/2026
/*/ 
method getVersaoRPO() class EnvironmentVersionService
    Local oJson   := JsonObject():New()

    oJson["rpoVersion"]    := GetRpoRelease()
    Self:setSuccess(oJson)
    FreeObj(oJson)
   
return nil


/*/{Protheus.doc} New
Retorna a versao de um fonte enviado
@type class
@version 12
@author carlos.augusto
@since 30/01/2026
/*/ 
method getVersaoFonte(cFonte as character) class EnvironmentVersionService
    Local oJson       := JsonObject():New()
    Local aInfoSource := {}
    Local cDataFonte  := ""

    aInfoSource := GetApoInfo(cFonte)
    If !Empty(aInfoSource) .And. !Empty(aInfoSource[4])
        cDataFonte := aInfoSource[4]
        oJson["sourceVersionDate"] := FWDateTo8601(aInfoSource[4])
        oJson["sourceVersionTime"] := aInfoSource[5]
        oJson["rpoVersion"]    := GetRpoRelease()
        Self:setSuccess(oJson)
    Else
        Self:setError(STR0001, 400) //"Fonte não encontrado no RPO."
    EndIf
    FreeObj(oJson)
Return 
