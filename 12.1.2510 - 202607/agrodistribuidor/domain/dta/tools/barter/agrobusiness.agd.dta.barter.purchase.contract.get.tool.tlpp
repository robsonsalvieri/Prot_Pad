#include 'tlpp-core.th'
#include 'totvs.ch'
#include 'agrobusiness.agd.dta.barter.purchase.contract.get.tool.ch'

#define MAX_LIST_ITEMS 20

namespace totvs.protheus.agrobusiness.agd  

/*/{Protheus.doc} DTABarterContractGetTool
Tool do DTA para contratos com origem da negociação de barter
@type class
@version 12
@author gilson.venturi
@since 18/05/2026
/*/
class DTABarterContractGetTool
	static method getSetup()            as json
	static method getParameters()       as json
	static method getRules()            as character
	static method getDescription()      as character
	static method getDescriptionShort() as character
	static method getExamples()         as array
	static method getGlossary()         as array
	static method apply()               as array
endclass

/*/{Protheus.doc} getSetup
Retorna as configurações da tool
@type method
@version 12
@author gilson.venturi
@since 18/05/2026
@return json, setup
/*/
method getSetup() as json class DTABarterContractGetTool
	local oDTAToolsBuilder            as object
	local cName := 'BContratosGET'    as character
	local jSetup                      as json

	oDTAToolsBuilder := DTAToolsBuilder():new()

	oDTAToolsBuilder:setName(cName)
	oDTAToolsBuilder:setDescription(DTABarterContractGetTool():getDescription())
	oDTAToolsBuilder:setShortDescription(DTABarterContractGetTool():getDescriptionShort())

	jSetup := oDTAToolsBuilder:build()

	FreeObj(oDTAToolsBuilder)
return jSetup

/*/{Protheus.doc} getDescription
Retorna a descrição completa da tool
@type method
@version 12
@author gilson.venturi
@since 18/05/2026
@return character, descrição completa
/*/
method getDescription() as character  class DTABarterContractGetTool
return STR0001 //"O resumo de dados tem a lista de contratos, e suas entregas bem como as notas fiscais. O resumo tem as informações dos contratos de compra gerados por uma negociação de barter, como seus itens, quantidades, valores, cliente, condições de pagamento, status, além das entregas realizadas (romaneios) e notas fiscais vinculadas a esses contratos."


/*/{Protheus.doc} getDescriptionShort
Retorna a descrição curta da tool
@type method
@version 12
@author gilson.venturi
@since 18/05/2026
@return character, descrição curta
/*/
method getDescriptionShort() as character class DTABarterContractGetTool
return STR0002 //'Busca os contratos de compra gerados pelo negócio/negociação barter.'

/*/{Protheus.doc} getRules
Retorna as regras da tool
@type method
@version 12
@author gilson.venturi
@since 18/05/2026
@return character, regras
/*/
method getRules() as character class DTABarterContractGetTool
return I18N(STR0003, {'barter_code', 'contract_code'})  //"O argumento '#1[ARG_NAME]#' ou '#2[ARG_NAME]#' precisam ser informados, solicite a informação antes de realizar a pesquisa."

/*/{Protheus.doc} getParameters
Retorna os parâmetros disponíveis para a tool
@type method
@version 12
@author gilson.venturi
@since 18/05/2026
@return json, parâmetros
/*/
method getParameters() as json class DTABarterContractGetTool
	local oDTAToolsBuilder as object
	local jDTATool         as json
	local jParameters      as json

	oDTAToolsBuilder := DTAToolsBuilder():new()

	oDTAToolsBuilder:addParameter('barter_code', 'string', STR0004, .F.) //'Código Negócio/negociação barter'
	oDTAToolsBuilder:addParameter('contract_code', 'string', STR0005, .F.) //'Código Contrato de compra'

	jDTATool    := oDTAToolsBuilder:build()
	jParameters := jDTATool['parameters']

	FreeObj(oDTAToolsBuilder)
	FreeObj(jDTATool)
return jParameters

/*/{Protheus.doc} getExamples
Retorna exemplos de perguntas para a tool
@type method
@version 12
@author gilson.venturi
@since 18/05/2026
@return array, exemplos
/*/
method getExamples() as array class DTABarterContractGetTool
	local oDTAToolsBuilder as object
	local jDTATool         as json
	local aExamples        as array

	oDTAToolsBuilder := DTAToolsBuilder():new()

	oDTAToolsBuilder:addExample(I18N(STR0006, {'barter_code'}))   //"Quais os contratos de compra grãos ligados a negociação '#1[barter_code]#' ?"
	oDTAToolsBuilder:addExample(I18N(STR0007, {'contract_code'})) //"Quais os itens desse contrato de Compra grãos '#1[contract_code]#' ?"
	oDTAToolsBuilder:addExample(I18N(STR0008, {'contract_code'})) //"Qual a quantidade do item '#1[contract_code]#' ?"
	oDTAToolsBuilder:addExample(I18N(STR0009, {'contract_code'})) //"Contrato de Compra de Grãos '#1[contract_code]#' já teve entregas ?"
	oDTAToolsBuilder:addExample(I18N(STR0010, {'contract_code'})) //"Qual o número da nota fiscal vinculada ao Contrato de Compra Grãos '#1[contract_code]#' ?"
	oDTAToolsBuilder:addExample(I18N(STR0011, {'barter_code'}))   //"Qual o status do contrato de compra grãos vinculado a negociação '#1[barter_code]#' ?"

	jDTATool  := oDTAToolsBuilder:build()
	aExamples := jDTATool['examples']

	FreeObj(oDTAToolsBuilder)
return aExamples

/*/{Protheus.doc} getGlossary
Retorna o glossário das informações utilizadas pela tool
@type method
@version 12
@author gilson.venturi
@since 18/05/2026
@return array, glossário
/*/
method getGlossary() as array class DTABarterContractGetTool
	local oDTAToolsBuilder as object
	local jDTATool         as json
	local aGlossary        as array

	oDTAToolsBuilder := DTAToolsBuilder():new()

	oDTAToolsBuilder:addGlossary('contract_list'              , STR0020) //"Lista de contratos de compra"
	oDTAToolsBuilder:addGlossary('contract_moviment'          , STR0043) //"Lista de movimentações do contrato"

	oDTAToolsBuilder:addGlossary('contract_code'              , STR0021) //"Código do contrato"
	oDTAToolsBuilder:addGlossary('contract_type'              , STR0022) //"Tipo do contrato"
	oDTAToolsBuilder:addGlossary('contract_status'            , STR0023) //"Status do contrato"
	oDTAToolsBuilder:addGlossary('contract_customer_code'     , STR0024) //"Código do cliente do contrato"
  	oDTAToolsBuilder:addGlossary('contract_customer_name'     , STR0025) //"Nome do cliente do contrato"
  	oDTAToolsBuilder:addGlossary('contract_payment_method'    , STR0026) //"Condição de pagamento do contrato"
	oDTAToolsBuilder:addGlossary('contract_harvest'           , STR0027) //"Safra do contrato"
	

	oDTAToolsBuilder:addGlossary('contract_sequence'          , STR0028) //"Sequencial do contrato"
	oDTAToolsBuilder:addGlossary('contract_product_code'      , STR0029) //"Código do produto do contrato"
	oDTAToolsBuilder:addGlossary('contract_description'       , STR0030) //"Descrição do contrato"
	oDTAToolsBuilder:addGlossary('contract_total_quantity'    , STR0031) //"Quantidade total do contrato"
	oDTAToolsBuilder:addGlossary('contract_unit_of_measure'   , STR0042) //"Unidade de medida do contrato"

	
	oDTAToolsBuilder:addGlossary('contract_freight'           , STR0032) //"Tipo de frete do contrato"
	oDTAToolsBuilder:addGlossary('contract_unit_price'        , STR0033) //"Valor unitário do contrato"

	oDTAToolsBuilder:addGlossary('delivery_movement_docto'        , STR0034) //"Número do documento"
	oDTAToolsBuilder:addGlossary('delivery_movement_series'       , STR0035) //"Série do documento"
	oDTAToolsBuilder:addGlossary('delivery_movement_sequence'     , STR0036) //"Código do fornecedor"
	oDTAToolsBuilder:addGlossary('delivery_movement_name'         , STR0037) //"Nome do fornecedor"
	oDTAToolsBuilder:addGlossary('delivery_movement_unit_value'   , STR0038) //"Valor unitário do documento"
	oDTAToolsBuilder:addGlossary('delivery_movement_quantity'     , STR0039) //"Quantidade"	
	oDTAToolsBuilder:addGlossary('delivery_movement_total_value'  , STR0040) //"Valor total do documento"
	oDTAToolsBuilder:addGlossary('delivery_movement_date'         , STR0041) //"Data do documento"

	jDTATool  := oDTAToolsBuilder:build()
	aGlossary := jDTATool['glossary']

	FWFreeObj(oDTAToolsBuilder)
return aGlossary

/*/{Protheus.doc} apply
Método utilizado pelo DTA para obter os dados
@type method
@version 12
@author gilson.venturi
@since 18/05/2026
@param jFilters, json, filtros
@return array, dados retornados
/*/
method apply(jFilters as json) as array class DTABarterContractGetTool
	local lExistBarterCode   as logical
	local lExistContractCode as logical
	local aReturn            as array

	lExistBarterCode   := jFilters:HasProperty('barter_code') .And. ! Empty(jFilters['barter_code'])
	lExistContractCode := jFilters:HasProperty('contract_code') .And. ! Empty(jFilters['contract_code'])

	if !lExistBarterCode .and. !lExistContractCode
		return DTAUtilsService():setToolError(400, I18N(STR0012, {'barter_code', 'contract_code'})) //"Para realizar a busca de contratos, o parâmetro '#1[PARAM]#' ou '#2[PARAM]#' deve ser informado."
	endIf

	if lExistBarterCode
		aReturn := getDataByBarterCode(jFilters)
	else //lExistContractCode
		if SUPERGETMV("MV_AGDCTOG", .f., .f.) .and. SUPERGETMV("MV_SIGAAGR", .f., .f.) .and. SUPERGETMV("MV_AGRORI", .f., .f.)
			aReturn := getDataByContractCode(jFilters)
		endIf
	endIf
return aReturn

/*/{Protheus.doc} getDataByBarterCode
Retorna os dados de acordo com o código da negociação barter
@type function
@version 12
@author gilson.venturi
@since 18/05/2026
@param jFilters, json, filtros utilizados
@return array, dados da consulta
/*/
static function getDataByBarterCode(jFilters as json) as array
	local oNegocioRepository As object
	local oJsonReturn        As object
	local cContext           As character
	local jData              As json
	local aSuggestions       As array
	Local nX    		     As numeric

	oNegocioRepository := BusinessRepository():new()
	if !oNegocioRepository:existsByCode(jFilters['barter_code'])
		FWFreeObj(oNegocioRepository)
		return DTAUtilsService():setToolError(400, STR0013) //"O negócio/negociação barter não existe."
	endIf
	FWFreeObj(oNegocioRepository)

	oNegocioService := BusinessService():New()
	cUltVersao := oNegocioService:buscarVersaoAtualValida(jFilters['barter_code'])
	FWFreeObj(oNegocioService)

	oDadosContratosNegocioRepository := BusinessDataContractRepository():New()
	oJsonReturn  := JsonObject():new()
	oJsonReturn['codigo'] := jFilters['barter_code']
	oJsonReturn['versao'] := cUltVersao
	oDadosContratosNegocioRepository:find(1, 9999,oJsonReturn)
	aContratosGerados := oDadosContratosNegocioRepository:getResponse()['items']
	FWFreeObj(oDadosContratosNegocioRepository)

	if empty(aContratosGerados)
		return DTAUtilsService():setToolError(400, STR0014) //"O negócio/negociação barter não possui contratos de compra."
	endIf

	jData  := JsonObject():New()
	jData["contract_list"] := {}
	For nX:= 1 to Len(aContratosGerados)
		cContrato   := posicione('NEF', 3, FWxFilial("NEF") + aContratosGerados[nX]['codigo'] + aContratosGerados[nX]['item'], "NEF->NEF_CTREXT")
		aadd(jData["contract_list"], getContractByList(rTrim(cContrato)))
	Next

	cContext := I18N(STR0015 /*"Todos os contratos de compra do negócio/negociação barter com código #1[barter_code]#"*/, {jFilters['barter_code']})

return {.t., {'context': cContext, 'data': jData, 'suggestions': aSuggestions},	200}

/*/{Protheus.doc} getDataByContractCode
Retorna os dados de acordo com o código do contrato
@type function
@version 12
@author gilson.venturi
@since 18/05/2026
@param jFilters, json, filtros
@return array, dados da consulta
/*/
static function getDataByContractCode(jFilters as json) as array
	local jData               as json
	local cContext            as character
	local aSuggestions        as array

	jFilters['barter_code'] := posicione('NEF', 2, FWxFilial("NEF") + jFilters['contract_code'], "NEF->NEF_CODBRT")
	if empty(jFilters['barter_code'])
		return DTAUtilsService():setToolError(400, STR0018) //"O contrato informado não faz parte de um negócio barter."
	endif

	jData  := JsonObject():New()
	jData["contract_list"] := {}
	aadd(jData["contract_list"], getContractByList( jFilters['contract_code'] ))

	cContext := I18N(STR0019, {jFilters['contract_code'], jFilters['barter_code'], cValToChar(MAX_LIST_ITEMS)}) //"Informações do contrato de compra com código #1[contract_code]# gerado pela negociação barter com código #2[BARTER_CODE]#."

	aSuggestions := {;
		{"label": I18N(STR0016 /*"Quais os itens do contrato de compra #1[CONTRACT_CODE]# ?"*/, {jFilters['contract_code']})},;
		{"label": I18N(STR0017 /*"Contrato de Compra #1[CONTRACT_CODE]# já teve entregas? "*/ , {jFilters['contract_code']})},;
		}
return {.t., {'context': cContext, 'data': jData, 'suggestions': aSuggestions},	200}

/*/{Protheus.doc} getContractByList
Retorna contrato de compra originação formatado para consumo do DTA
@type function
@version 12
@author gilson.venturi
@since 18/05/2026
@param cContrato, character, código do contrato de compra
@return json, contrato formatado
/*/
static function getContractByList(cContrato as character) as json
	local oCtrRepository		as object
	local oJsonReturn			as json
	local jContrato				as json
	local jDataLine				as json
	local aContratos			as array
	local nX					as numeric
	
	oCtrRepository := PurchaseContractRepository():New()
	oJsonReturn  := JsonObject():new()
	oJsonReturn['codigoContrato'] := cContrato
	oCtrRepository:find(1, 9999,oJsonReturn)
	aContratos := oCtrRepository:getResponse()['items']
	FWFreeObj(oCtrRepository)

	jContrato  := JsonObject():New()
	jContrato := {}
	For nX:= 1 to Len(aContratos)
		jDataLine  := JsonObject():New()
		jDataLine  := { 'customer_code'				: aContratos[nX]['codigoContrato'],;
						'contract_status'           : X3Combo( "NJR_STATUS", aContratos[nX]['status'] ),;
						'contract_customer_code'    : aContratos[nX]['codigoEntidade'],;
						'contract_customer_name'    : aContratos[nX]['nomeEntidade'],;
						'contract_payment_method'   : aContratos[nX]['descricaoCondPagamento'],;
						'contract_product_code'     : aContratos[nX]['codProduto'],;
						'contract_description'      : aContratos[nX]['descricaoProduto'],;
						'contract_total_quantity'   : aContratos[nX]['quantidade'],;
						'contract_harvest'	        : aContratos[nX]['safra'],;
						'contract_freight'	        : X3Combo( "NEE_TPFRET", aContratos[nX]['tipoFrete']),;
						'contract_unit_price'       : aContratos[nX]['valorUnitario'],;
						'contract_moviment'		    : getMovimentForDTA(aContratos[nX]['codigoContrato']);
		}
	next nX

	aadd(jContrato, jDataLine)

return jContrato

/*{Protheus.doc} getMovimentForDTA
Retorna Movimentos/Entregas do contrato de compra originação formatado para consumo do DTA
@type function
@version 12
@author gilson.venturi
@since 18/05/2026
@param jMoviment, json, contrato de compra
@return json, contrato formatado
*/
static function getMovimentForDTA(cContrato as character) as json
	local oMovCtrRepository	    as object
	local jDataMovto		    as json
	local jDataLine				as json
	local nX					as numeric

	oMovCtrRepository := ShippingContractRepository():New()
	oJsonReturn  := JsonObject():new()
	oJsonReturn['codigoContrato'] := cContrato
	oMovCtrRepository:find(1, 9999,oJsonReturn)
	aMovContratos := oMovCtrRepository:getResponse()['items']
	FWFreeObj(oMovCtrRepository)

	jDataMovto  := JsonObject():New()
	jDataMovto := {}
	For nX:= 1 to Len(aMovContratos)
		jDataLine   := JsonObject():New()
		jDataLine   := {'delivery_movement_sequence'     : rTrim(aMovContratos[nX]['numeroRomaneio']),;
						'delivery_movement_name'         : aMovContratos[nX]['nome'],;
						'delivery_movement_docto'        : aMovContratos[nX]['numeroDocumento'],;
						'delivery_movement_series'       : aMovContratos[nX]['serieDocumento'],;
						'delivery_movement_date'         : aMovContratos[nX]['dataEmissao'],;
						'delivery_movement_quantity'     : aMovContratos[nX]['quantidade'],;
						'delivery_movement_unit_value'   : aMovContratos[nX]['valorUnitario'],;
						'delivery_movement_total_value'  : aMovContratos[nX]['valorTotal'];
		}
		aadd(jDataMovto, jDataLine)
	next nX
		
return jDataMovto
