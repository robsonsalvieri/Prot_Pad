#Include "agrobusiness.agd.dta.barter.business.get.tool.ch"
#Include "TLPP-CORE.TH"
#Include "TOTVS.CH"

namespace totvs.protheus.agrobusiness.agd  

/*/{Protheus.doc} DTABarterBusinessGetTool
ToolTool do DTA para Negócios do Barter
@type class
@version 12
@author jean.schulze
@since 13/11/2025
/*/
Class DTABarterBusinessGetTool
	Static Method getSetup() as Json
	Static Method getParameters() as Json
	Static Method getRules() as Character 
	Static Method getDescription() as Character
	Static Method getDescriptionShort() as Character
	Static Method getExamples() as Array
	Static Method getGlossary() as Array

	Static Method apply(jFilters as Json) as Array
EndClass

/*/{Protheus.doc} getSetup
Dados para configuração da Tool
@type method
@version 12
@author jean.schulze
@since 13/11/2025
@return json, dados de configuracao
/*/
Method getSetup() as Json Class DTABarterBusinessGetTool
	Local cName         := ""  as Character
	Local oLoadTool     := Nil as Object

	cName             := "BNegocioGET"

	oLoadTool := DTAToolsBuilder():New()
	oLoadTool:setName(cName)
	oLoadTool:setDescription(DTABarterBusinessGetTool():getDescription())
	oLoadTool:setShortDescription(DTABarterBusinessGetTool():getDescriptionShort()) 

	jReturn := oLoadTool:build()
	FreeObj(oLoadTool)
Return jReturn


/*/{Protheus.doc} getDescription
Retorna a descrição completa da Tool
@type method
@version 12
@author jean.schulze
@since 12/12/2025
@return character, descricao
/*/
method getDescription()  as Character  Class DTABarterBusinessGetTool
return STR0026 //"Consulta negociações barter, retornando informações do cabeçalho da negociação, cliente, situação, status, datas, valores e produto/commodity de troca."

/*/{Protheus.doc} getDescriptionShort
Retorna a descrição curta da Tool
@type method
@version 12
@author jean.schulze
@since 12/12/2025
@return character, descricao
/*/
Method getDescriptionShort() as Character Class DTABarterBusinessGetTool 
return STR0027 //"Busca as negociações barter"

/*/{Protheus.doc} getRules
Retorna as regras de uso da Tool
@type method
@version 12
@author jean.schulze
@since 12/12/2025
@return character, descricao
/*/
Method getRules()  as Character Class DTABarterBusinessGetTool
return STR0028 //"Use esta tool para consultar informações gerais da negociação barter, como cliente, status, datas, unidade medida, valores e a commodity negociada. O produto retornado por essa tool representa a commodity de troca da negociação (ex.: soja, milho ou trigo) e não os produtos ou insumos negociados. Quando a solicitação envolver insumos como: defensivos, fertilizantes, sementes e produtos vinculados aos itens da negociação, utilize a ferramenta BNegocioItensGET."

/*/{Protheus.doc} getParameters
Retorna os parâmetros de uso da Tool
@type method
@version 12
@author jean.schulze
@since 12/12/2025
@return json, params
/*/
Method getParameters() as Json Class DTABarterBusinessGetTool
	oLoadTool := DTAToolsBuilder():New()

	oLoadTool:addParameter("customer"                , "string", STR0004 + ". \n " + STR0005, .T.)  //"Código/Nome do Cliente"
	oLoadTool:addParameter("business"                , "string", STR0029, .T.) //"Código da negociação barter"
	oLoadTool:addParameter("start_date_transmission" , "string", STR0006, .F.)  //"Data Inicial para buscar os Negócios"
	oLoadTool:addParameter("end_date_transmission"   , "string", STR0007, .F.)  //"Data Final para buscar os Negócios"
	oLoadTool:addParameter("header_product"          , "string", STR0030, .F.) //"Codigo ou descricao do produto/commodity negociado."
	//oLoadTool:addParameter("latest"                  , "logical", "Quando informado como true, retorna as últimas negociações ordenadas por data de emissão e código.", .F.)
	
	jReturn := oLoadTool:build()
	FreeObj(oLoadTool)
return jReturn["parameters"]

/*/{Protheus.doc} getExamples
Retorna os exemplos de uso da Tool
@type method
@version 12
@author jean.schulze
@since 12/12/2025
@return array, exemplos
/*/
Method getExamples() as Array Class DTABarterBusinessGetTool
	oLoadTool := DTAToolsBuilder():New()

	oLoadTool:addExample(I18N(STR0015, {"customer"}))  //"Quais são as negociações do cliente '#1[customer]#'?"
	oLoadTool:addExample(I18N(STR0016, {"customer"}))  //"O cliente '#1[customer]#' possui negociações?"
	oLoadTool:addExample(I18N(STR0031, {"business"}))  //"Informe os dados da negociação '#1[business]#'"

	jReturn := oLoadTool:build()
	FreeObj(oLoadTool)

return jReturn['examples']

/*/{Protheus.doc} getGlossary
Retorna o glossário de termos da Tool
@type method
@version 12
@author jean.schulze
@since 12/12/2025
@return array, glossario
/*/
Method getGlossary() as Array Class DTABarterBusinessGetTool
	oLoadTool := DTAToolsBuilder():New()

	oLoadTool:addGlossary("customer_code" , STR0008)  //"Código do Cliente"
	oLoadTool:addGlossary("customer_name"  , STR0009) //"Nome do Cliente"
	oLoadTool:addGlossary("business_code", STR0010)  //"Código da Negociação"
	oLoadTool:addGlossary("business_version", STR0032) //"Versão da negociação"
	oLoadTool:addGlossary("business_situation", STR0011)  //"Situação da Negociação"
	oLoadTool:addGlossary("product_code", STR0033)  //"Código do produto/commodity de troca"
	oLoadTool:addGlossary("product_description", STR0034)  //"Descrição do produto/commodity de troca"
	oLoadTool:addGlossary("quantity", STR0013)  //"Quantidade de Commoditie"
	oLoadTool:addGlossary("business_list", STR0014)  //"Lista de Negócios"
	oLoadTool:addGlossary("authorization_status", STR0035) // "Status da Autorização"
	oLoadTool:addGlossary("issue_date", STR0036) // "Data de emissão da negociação"
	oLoadTool:addGlossary("safra_code", STR0037) // "Código da Safra"
	oLoadTool:addGlossary("negotiated_quantity", STR0038) //"Quantidade total negociada da commodity"
	oLoadTool:addGlossary("converted_quantity", STR0039) //"Quantidade convertida na unidade do produto"
	oLoadTool:addGlossary("total_business", STR0040) //"Total de negócios encontrados"
	oLoadTool:addGlossary("shipping_status", STR0041) //"Status de expedição/faturamento"
	oLoadTool:addGlossary("receipt_status", STR0042) //"Status de recebimento"
	oLoadTool:addGlossary("measurement_unit", STR0043) //"Unidade de medida do produto/commodity de troca"

	jReturn := oLoadTool:build()
	FreeObj(oLoadTool)

return jReturn['glossary']


/*/{Protheus.doc} apply
Metodo de Execução pelo DTA para retorno de dados
@type method
@version 12
@author jean.schulze
@since 13/11/2025
@param jFilters, json, filter
@return array, dados
/*/
Method apply(jFilters as Json) as Array Class DTABarterBusinessGetTool
	Local aReturn        := {}  as Array
	Local aSuggestions   := {}  as Array
	Local cContext       := ""  as Character
	Local jData          := Nil as Json
	Local nX

	if jFilters:HasProperty('customer') .and. !Empty(jFilters["customer"])
		listClientes := DTAUtilsService():getCodCliente(Upper(jFilters["customer"]))
		if len(listClientes) == 0
			Return DTAUtilsService():setToolError(400, I18N(STR0018, {RTrim(jFilters["customer"]) }))  //"O cliente #1[customer]# não foi encontrado na base de dados."
		endif

		if len(listClientes) > 1
			Return DTAUtilsService():setToolError(400, I18N(STR0020+listClientes[1]+","+listClientes[2]+STR0019, {RTrim(jFilters["customer"]) }))  //", etc). É possível ser mais específico?"
		endif	
		
		jFilters["codigoCliente"] := listClientes[1]
	endif

	if jFilters:HasProperty('business') .and. !Empty(jFilters["business"])
		jFilters["filter"] := "codigo eq '" + jFilters["business"]+"'"
	endif

	if jFilters:HasProperty('start_date_transmission') .and. !Empty(jFilters["start_date_transmission"])
		jFilters["filter"] := "dataEmissao ge '" + StrTran(AllTrim(jFilters["start_date_transmission"]), "-", "") +"'"  
	endif

	if jFilters:HasProperty('end_date_transmission') .and. !Empty(jFilters["end_date_transmission"])
		if jFilters:HasProperty('filter') .and. !Empty(jFilters["filter"])
			cFilter := jFilters["filter"] + " and "  
		endif
		jFilters["filter"] := cFilter + "dataEmissao le '" + StrTran(AllTrim(jFilters["end_date_transmission"]), "-", "")+"'" 
	endif

	//Vamos buscar os negocios com o codigo de cliente informado
	oNegocioRepository := BusinessRepository():New()
	oNegocioRepository:find(1, 20, jFilters)

	jData  := JsonObject():New()
	jData["business_list"] := {}
	listaNegocios := oNegocioRepository:getResponse()['items']
	
	For nX:= 1 to Len(listaNegocios)
		
		oNegocioService := BusinessService():New()
		oNegocioService:getStatusNegocio(listaNegocios[nX]['codigo'], listaNegocios[nX]['versao'])
		If Empty(cStatusRec := oNegocioService:getResponse()["statusRecebimento"])
			cStatusRec := oNegocioService:buscarStatusRecebimento(FWxFilial("NEA") + listaNegocios[nX]['codigo'] + listaNegocios[nX]['versao'])
			cStatusRec := X3Combo("NEA_STSREC", cStatusRec)
		Endif
		If Empty(cStatusExp := oNegocioService:getResponse()["statusExpedicao"])
			cStatusExp := oNegocioService:getStExpedBarter(FWxFilial("NEA") + listaNegocios[nX]['codigo'] + listaNegocios[nX]['versao'])
			cStatusExp := X3Combo("NEA_STSEXP", cStatusExp)
		Endif
		cUnidMed := POSICIONE('SAH',1,XFILIAL('SAH')+listaNegocios[nX]['unidadeMedidaPreco'],'AH_UMRES')

		FreeObj(oNegocioService)
		aadd(jData["business_list"], {  'customer_code': listaNegocios[nX]['codigoCliente'],;
										'customer_name': listaNegocios[nX]['descricaoCliente'],;
										'business_code': listaNegocios[nX]['codigo'],;
										'business_version':listaNegocios[nX]['versao'],;
										'business_situation':X3Combo( "NEA_STATUS", listaNegocios[nX]['status'] ),;
										'authorization_status':X3Combo( "NEA_STSAUT", listaNegocios[nX]['statusAutorizacao'] ),;
										'issue_date': listaNegocios[nX]['dataEmissao'],;
										'safra_code': listaNegocios[nX]['codigoSafra'],;
										'product_code':listaNegocios[nX]['codigoProduto'],;
										'product_description': listaNegocios[nX]['descricaoProduto'],;
										'negotiated_quantity': listaNegocios[nX]['quantidadeNegociada'],;
										'quantity': listaNegocios[nX]['quantidadeNegociada'],;
										'converted_quantity': listaNegocios[nX]['quantidadeConvertUM'],;
										'measurement_unit': cUnidMed,;
										'shipping_status': cStatusExp,;
										'receipt_status': cStatusRec})
	Next

	If Len(listaNegocios) > 0

		jData["total_business"] := oNegocioRepository:getResponse()['total']

		aAdd(aSuggestions, {"label": STR0021})  //"Quais desses negócios tem pendência de fechamento?"
		aAdd(aSuggestions, {"label": STR0022})  //"Quais desses negócios já foram faturados?"
		aAdd(aSuggestions, {"label": STR0023})  //"Algum desses negócios está com recebimento atrasado?"
		cContext := I18N(STR0024, {"business_list"})  //"Os dados contidos em '#1[ARG_CODE]#' é uma lista dos ultimos 20 negócios do cliente informado."
		aReturn := {.T., {"context": cContext, "data": jData, "suggestions": aSuggestions}, 200}
	Else
		aReturn := DTAUtilsService():setToolError(400, I18N(STR0025, {RTrim(jFilters["customer"])})) //"O recurso #1[CODIGO]# não possui recursos alternativos."
	EndIf
	aSuggestions := Nil
	jData        := Nil
Return aReturn
