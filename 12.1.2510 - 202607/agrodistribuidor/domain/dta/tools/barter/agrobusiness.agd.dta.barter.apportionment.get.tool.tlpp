#Include "agrobusiness.agd.dta.barter.apportionment.get.tool.ch"
#Include "TLPP-CORE.TH"
#Include "TOTVS.CH"

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} DTABarterApportionmentGetTool
Tool do DTA para consulta dos rateios de entrega da negociação barter.
@type class
@version 12
@author rodrigo.nsoledade
@since 08/06/2026
/*/
Class DTABarterApportionmentGetTool
	Static Method getSetup() as Json
	Static Method getParameters() as Json
	Static Method getRules() as Character
	Static Method getDescription() as Character
	Static Method getDescriptionShort() as Character
	Static Method getExamples() as Array
	Static Method getGlossary() as Array
	Static Method apply(jFilters as Json) as Array
EndClass

/*/{Protheus.doc} getSetup
Dados para configuração da Tool.
@type method
@version 12
@author rodrigo.nsoledade
@since 08/06/2026
@return json, dados de configuração
/*/
Method getSetup() as Json Class DTABarterApportionmentGetTool
	Local cName     := "BRateioGET" as Character
	Local oLoadTool := Nil          as Object
	Local jReturn   := Nil          as Json

	oLoadTool := DTAToolsBuilder():New()
	oLoadTool:setName(cName)
	oLoadTool:setDescription(DTABarterApportionmentGetTool():getDescription())
	oLoadTool:setShortDescription(DTABarterApportionmentGetTool():getDescriptionShort())

	jReturn := oLoadTool:build()

	FreeObj(oLoadTool)

Return jReturn

/*/{Protheus.doc} getDescription
Retorna a descrição completa da Tool.
@type method
@version 12
@author rodrigo.nsoledade
@since 08/06/2026
@return character, descrição
/*/
Method getDescription() as Character Class DTABarterApportionmentGetTool
Return STR0001 //"Consulta os rateios de entrega de um item/insumo da negociação barter, retornando produto, quantidade e datas previstas de entrega."

/*/{Protheus.doc} getDescriptionShort
Retorna a descrição curta da Tool.
@type method
@version 12
@author rodrigo.nsoledade
@since 08/06/2026
@return character, descrição curta
/*/
Method getDescriptionShort() as Character Class DTABarterApportionmentGetTool
Return STR0002 //"Busca rateios de entrega da negociação barter"

/*/{Protheus.doc} getRules
Retorna as regras de uso da Tool.
@type method
@version 12
@author rodrigo.nsoledade
@since 08/06/2026
@return character, regras de uso
/*/
Method getRules() as Character Class DTABarterApportionmentGetTool
Return STR0003 //"Use esta ferramenta para consultar os rateios de entrega de um item/insumo específico da negociação barter. O rateio representa a distribuição da quantidade do item em uma ou mais datas de entrega. Para usar esta ferramenta, informe o código da negociação e o item do insumo. Quando a pergunta for sobre os itens/insumos da negociação, consulte primeiro a ferramenta BNegocioItensGET para identificar o item correto."

/*/{Protheus.doc} getParameters
Retorna os parâmetros de uso da Tool.
@type method
@version 12
@author rodrigo.nsoledade
@since 08/06/2026
@return json, parâmetros
/*/
Method getParameters() as Json Class DTABarterApportionmentGetTool
	Local oLoadTool := Nil as Object
	Local jReturn   := Nil as Json

	oLoadTool := DTAToolsBuilder():New()

	oLoadTool:addParameter("business",     "string", STR0004 , .F.) //"Código da negociação barter."
	oLoadTool:addParameter("item",         "string", STR0005 , .F.) //"Item do insumo/produto da negociação para consultar o rateio de entregas."
	oLoadTool:addParameter("product_code", "string", STR0024 , .F.) //"Codigo do produto/insumo"

	jReturn := oLoadTool:build()

	FreeObj(oLoadTool)

Return jReturn["parameters"]

/*/{Protheus.doc} getExamples
Retorna os exemplos de uso da Tool.
@type method
@version 12
@author rodrigo.nsoledade
@since 08/06/2026
@return array, exemplos
/*/
Method getExamples() as Array Class DTABarterApportionmentGetTool
	Local oLoadTool := Nil as Object
	Local jReturn   := Nil as Json

	oLoadTool := DTAToolsBuilder():New()
	oLoadTool:addExample(I18N(STR0020, {"business"})) //"Quais são os rateios de entrega para a negociação barter #1[business]#?"
	oLoadTool:addExample(I18N(STR0021, {"business"})) //"Quais são os próximos itens a serem entregues na negociação barter #1[business]#?"
	oLoadTool:addExample(I18N(STR0022, {"business", "item"})) //"Quais são os rateios de entrega para o item #2[item]# da negociação barter #1[business]#?"
	oLoadTool:addExample(I18N(STR0023, {"business", "item"})) //"Houve atraso na entrega do item #2[item]# da negociação barter #1[business]#?"

	jReturn := oLoadTool:build()

	FreeObj(oLoadTool)

Return jReturn["examples"]

/*/{Protheus.doc} getGlossary
Retorna o glossário de termos da Tool.
@type method
@version 12
@author rodrigo.nsoledade
@since 08/06/2026
@return array, glossário
/*/
Method getGlossary() as Array Class DTABarterApportionmentGetTool
	Local oLoadTool := Nil as Object
	Local jReturn   := Nil as Json

	oLoadTool := DTAToolsBuilder():New()

	oLoadTool:addGlossary("business_code", STR0006) //"Código da negociação barter."
	oLoadTool:addGlossary("item", STR0007) //"Item do insumo/produto da negociação."
	oLoadTool:addGlossary("product_code", STR0008) //"Código do produto/insumo relacionado ao item da negociação."
	oLoadTool:addGlossary("quantity", STR0009) //"Quantidade rateada para entrega."
	oLoadTool:addGlossary("delivery_date", STR0010) //"Data prevista para entrega do rateio."
	oLoadTool:addGlossary("apportionment_list", STR0011) //"Lista de rateios de entrega encontrados."
	oLoadTool:addGlossary("total_apportionments", STR0012) //"Total de rateios encontrados."

	jReturn := oLoadTool:build()

	FreeObj(oLoadTool)

Return jReturn["glossary"]

/*/{Protheus.doc} apply
Executa a consulta dos rateios de entrega pelo DTA.
@type method
@version 12
@author rodrigo.nsoledade
@since 08/06/2026
@param jFilters, json, filtros enviados pela LLM
@return array, dados da ferramenta
/*/
Method apply(jFilters as Json) as Array Class DTABarterApportionmentGetTool
	Local aReturn       := {} as Array
	Local aSuggestions  := {} as Array
	Local cContext      := "" as Character
	Local jData         := Nil as Json
	Local jQueryParam   := Nil as Json
	Local aRateios      := {} as Array
	Local oRepository   := Nil as Object
	Local nX            := 0  as Numeric

	// Monta os filtros conforme os campos esperados pela API/repository
	jQueryParam := JsonObject():New()

	// Valida os parâmetros mínimos para consulta do rateio
	If jFilters:HasProperty("business") .And. !Empty(AllTrim(jFilters["business"]))
		jQueryParam["codigoNegocio"] := AllTrim(jFilters["business"])
	EndIf

	If jFilters:HasProperty("item") .And. !Empty(AllTrim(jFilters["item"]))
		jQueryParam["item"] := AllTrim(jFilters["item"])
	EndIf

	If jFilters:HasProperty("product_code") .And. !Empty(AllTrim(jFilters["product_code"]))
		jQueryParam["codigoProduto"] := AllTrim(jFilters["product_code"])
	EndIf

	oRepository := BusinessApportionmentRepository():New()
	oRepository:find(1, 20, jQueryParam)

	jData := JsonObject():New()
	jData["apportionment_list"] := {}

	aRateios := oRepository:getResponse()["items"]

	For nX := 1 To Len(aRateios)
		AAdd(jData["apportionment_list"], {;
			"business_code" : aRateios[nX]["codigoNegocio"],;
			"item"          : aRateios[nX]["item"],;
			"product_code"  : aRateios[nX]["codigoProduto"],;
			"quantity"      : aRateios[nX]["quantidade"],;
			"delivery_date" : aRateios[nX]["dataEntrega"];
		})
	Next nX

	If Len(aRateios) > 0
		jData["total_apportionments"] := oRepository:getResponse()["total"]

		AAdd(aSuggestions, {"label": STR0015}) //"Quais são os próximos itens a serem entregues nessa negociação?"
		AAdd(aSuggestions, {"label": STR0016}) //"Houve atraso na entrega de algum item dessa negociação?"

		cContext := STR0017 //"Os dados contidos em 'apportionment_list' representam os rateios de entrega do item informado na negociação barter."
		aReturn  := {.T., {"context": cContext, "data": jData, "suggestions": aSuggestions}, 200}
	Else
		aReturn := DTAUtilsService():setToolError(400, STR0018) //"Nenhum rateio de entrega foi encontrado para a negociação e item informados."
	EndIf

	FreeObj(oRepository)

	jData        := Nil
	jQueryParam  := Nil
	aSuggestions := Nil

Return aReturn
