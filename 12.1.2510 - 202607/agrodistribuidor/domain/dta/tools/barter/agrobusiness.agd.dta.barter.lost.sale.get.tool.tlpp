#include 'tlpp-core.th'
#include 'totvs.ch'
#include 'agrobusiness.agd.dta.barter.lost.sale.get.tool.ch'

#define MAX_LIST_ITEMS 10

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} DTABarterLostSaleGetTool
Tool do DTA/LYNN para Venda Perdida gerada pela negociação barter
@type class
@version 12
@author jc.maldonado
@since 17/06/2026
/*/
class DTABarterLostSaleGetTool
	static method getSetup()            as json
	static method getParameters()       as json
	static method getRules()            as character
	static method getDescription()      as character
	static method getDescriptionShort() as character
	static method getExamples()         as array
	static method getGlossary()         as array
	static method apply()               as array
endclass

/*/{Protheus.doc} DTABarterLostSaleGetTool::getSetup
Retorna as configurações da tool
@type method
@version 12
@author jc.maldonado
@since 17/06/2026
@return json, setup
/*/
method getSetup() as json class DTABarterLostSaleGetTool
	local oDTAToolsBuilder            as object
	local cName := 'BVendaPerdidaGET' as character
	local jSetup                      as json

	oDTAToolsBuilder := DTAToolsBuilder():new()

	oDTAToolsBuilder:setName(cName)
	oDTAToolsBuilder:setDescription(DTABarterLostSaleGetTool():getDescription())
	oDTAToolsBuilder:setShortDescription(DTABarterLostSaleGetTool():getDescriptionShort())

	jSetup := oDTAToolsBuilder:build()

	FreeObj(oDTAToolsBuilder)
return jSetup

/*/{Protheus.doc} DTABarterLostSaleGetTool::getDescription
Retorna a descrição completa da tool
@type method
@version 12
@author jc.maldonado
@since 17/06/2026
@return character, descrição completa
/*/
method getDescription() as character  class DTABarterLostSaleGetTool
return STR0001 //"Fornece um resumo de informações sobre as vendas perdidas geradas pelo negociação barter. O resumo de dados tem suas informações como código da negociação barter, código do produto, descrição do produto, quantidade perdida, motivo da venda perdida, data da venda perdida"

/*/{Protheus.doc} DTABarterLostSaleGetTool::getDescriptionShort
Retorna a descrição curta da tool
@type method
@version 12
@author jc.maldonado
@since 17/06/2026
@return character, descrição curta
/*/
method getDescriptionShort() as character class DTABarterLostSaleGetTool
return STR0002 //"Busca informações sobre venda perdida gerada pela negociação barter."

/*/{Protheus.doc} DTABarterLostSaleGetTool::getRules
Retorna as regras da tool
@type method
@version 12
@author jc.maldonado
@since 17/06/2026
@return character, regras
/*/
method getRules() as character class DTABarterLostSaleGetTool
return STR0003 //"Um dos parametros barter_code, product_code, start_date ou end_date precisam existir para realizar a busca, solicite ao usuário se necessário."

/*/{Protheus.doc} DTABarterLostSaleGetTool::getParameters
Retorna os parâmetros disponíveis para a tool
@type method
@version 12
@author jc.maldonado
@since 17/06/2026
@return json, parâmetros
/*/
method getParameters() as json class DTABarterLostSaleGetTool
	local oDTAToolsBuilder as object
	local jDTATool         as json
	local jParameters      as json

	oDTAToolsBuilder := DTAToolsBuilder():new()

	oDTAToolsBuilder:addParameter('page_number', 'string', STR0004, .f.) //"Número da página atual para consulta, valor padrão: 1"
	oDTAToolsBuilder:addParameter('order'      , 'string', STR0005, .f.) //"Ordenação para consulta, padrão: data,hora. Campos disponíveis: data, hora e codigoNegocio. Para ordenação decrescente adicionar sinal -, exemplo: -data"

	oDTAToolsBuilder:addParameter('barter_code' , 'string', STR0006, .f.) //"Código identificador da negociação barter"
	oDTAToolsBuilder:addParameter('product_code', 'string', STR0007, .f.) //"Código SKU do produto"
	oDTAToolsBuilder:addParameter('start_date'  , 'string', STR0008, .f.) //"Data de início para o período de perda (YYYY-MM-DD)"
	oDTAToolsBuilder:addParameter('end_date'    , 'string', STR0009, .f.) //"Data de fim para o período de perda (YYYY-MM-DD)"

	jDTATool    := oDTAToolsBuilder:build()
	jParameters := jDTATool['parameters']

	FreeObj(oDTAToolsBuilder)
	FreeObj(jDTATool)
return jParameters

/*/{Protheus.doc} DTABarterLostSaleGetTool::getExamples
Retorna exemplos de perguntas para a tool
@type method
@version 12
@author jc.maldonado
@since 17/06/2026
@return array, exemplos
/*/
method getExamples() as array class DTABarterLostSaleGetTool
	local oDTAToolsBuilder as object
	local jDTATool         as json
	local aExamples        as array

	oDTAToolsBuilder := DTAToolsBuilder():new()

	oDTAToolsBuilder:addExample(STR0010) //"A negociação com código 123456 possui venda perdida?"
	oDTAToolsBuilder:addExample(STR0011) //"Quantas vendas perdidas totais eu tive neste mês?"
	oDTAToolsBuilder:addExample(STR0012) //"Qual a quantidade de venda perdida que eu tive para o produto com código 123456 no mês passado?"

	jDTATool  := oDTAToolsBuilder:build()
	aExamples := jDTATool['examples']

	FreeObj(oDTAToolsBuilder)
	FreeObj(jDTATool)
return aExamples

/*/{Protheus.doc} DTABarterLostSaleGetTool::getGlossary
Retorna o glossário das informações utilizadas pela tool
@type method
@version 12
@author jc.maldonado
@since 17/06/2026
@return array, glossário
/*/
method getGlossary() as array class DTABarterLostSaleGetTool
	local oDTAToolsBuilder as object
	local jDTATool         as json
	local aGlossary        as array

	oDTAToolsBuilder := DTAToolsBuilder():new()

	oDTAToolsBuilder:addGlossary('product_lost_list'    , STR0013) //"Lista de produtos com venda perdida do negocio barter"
	oDTAToolsBuilder:addGlossary('product_barter_code'  , STR0006) //"Código identificador da negociação barter"
	oDTAToolsBuilder:addGlossary('product_item_barter'  , STR0014) //"Identificador sequencial do item dentro do negócio barter"
	oDTAToolsBuilder:addGlossary('product_code'         , STR0015) //"Código identificador único do produto (SKU)"
	oDTAToolsBuilder:addGlossary('product_description'  , STR0016) //"Descrição do produto"
	oDTAToolsBuilder:addGlossary('product_quantity_lost', STR0017) //"Quantidade do produto que deixou de ser vendida"
	oDTAToolsBuilder:addGlossary('product_reason_lost'  , STR0018) //"Justificativa ou motivo pelo qual a venda foi marcada como perdida"
	oDTAToolsBuilder:addGlossary('product_date_lost'    , STR0019) //"Data em que o registro de venda perdida foi efetuado"

	oDTAToolsBuilder:addGlossary('page_size'          , STR0020) //"O número máximo de itens que podem ser retornados em uma única requisição para evitar sobrecarga."
	oDTAToolsBuilder:addGlossary('page_number'        , STR0021) //"Número da página atual utilizada na requisição."
	oDTAToolsBuilder:addGlossary('total_records_found', STR0022) //"Número total de registros de vendas perdidas que correspondem aos critérios de busca, independentemente do limite de itens retornados."
	oDTAToolsBuilder:addGlossary('remaining_records'  , STR0023) //"Indica se existem mais resultados a serem mostrados"
	oDTAToolsBuilder:addGlossary('has_more_results'   , STR0024) //"Indica se existem mais resultados de vendas perdidas disponíveis além dos que foram retornados na lista atual (verdadeiro/falso)."

	jDTATool  := oDTAToolsBuilder:build()
	aGlossary := jDTATool['glossary']

	FreeObj(oDTAToolsBuilder)
	FreeObj(jDTATool)
return aGlossary

/*/{Protheus.doc} DTABarterLostSaleGetTool::apply
Método utilizado pelo LYNN para obter os dados
@type method
@version 12
@author jc.maldonado
@since 17/06/2026
@param jFilters, json, filtros
@return array, Dados retornados
/*/
method apply(jFilters as json) as array class DTABarterLostSaleGetTool
return getData(jFilters)

/*/{Protheus.doc} getData
Retorna o resultado da consulta de acordo com os filtros informados
@type function
@version 12
@author jc.maldonado
@since 17/06/2026
@param jLYNNfilters, json, filtros originais da requisição para contexto
@return array, Resultado da consulta
/*/
static function getData(jLYNNfilters as json) as array
	local nPageNumber := 1                          as integer
	local jRepositoryFilters                        as json
	local oLostSaleRepository                       as object
	local jResponseLostSales                        as json
	local aReturn := {.t., JsonObject():New(), 200} as array

	if ! Empty(jLYNNfilters['page_number'])
		nPageNumber := Int(Val(jLYNNfilters['page_number']))
	endIf

	jRepositoryFilters := buildSearchFilter(jLYNNfilters)

	oLostSaleRepository := LostSaleRepository():new(.t. /*lIncludeOtherFields*/)
	oLostSaleRepository:find(nPageNumber, MAX_LIST_ITEMS, jRepositoryFilters)
	FreeObj(jRepositoryFilters)

	jResponseLostSales := oLostSaleRepository:getResponse()

	if Empty(jResponseLostSales['items'])
		aReturn[2] := {'context': STR0025, 'total_records_found': 0} //"Nenhuma venda perdida foi encontrada para os critérios informados."
		return aReturn
	endIf

	aReturn[2] := {'context': getContextMsg(jLYNNfilters), 'data': getFormattedDataList(jResponseLostSales, nPageNumber)}
	FreeObj(jResponseLostSales)
return aReturn

/*/{Protheus.doc} buildSearchFilter
Analisa os filtros recebidos, valida as regras de negócio e constrói o filtro de busca
@type method
@version 12
@author jc.maldonado
@since 17/06/2026
@param jLYNNFilters, json, filtros utilizados
@return json, filtro de busca para o repositorio de vendas perdidas
/*/
static function buildSearchFilter(jLYNNFilters as json) as json
	local jRepositoryFilters := JSONObject():New() as json

	if ! Empty(jLYNNFilters['barter_code'])
		jRepositoryFilters['codigoNegocio'] := jLYNNFilters['barter_code']
	endIf

	if ! Empty(jLYNNFilters['product_code'])
		jRepositoryFilters['produto'] := jLYNNFilters['product_code']
	endIf

	if ! Empty(jLYNNFilters['start_date']) .or. ! Empty(jLYNNFilters['end_date'])
		prepareDateFilter(jLYNNFilters, jRepositoryFilters)
	endif

	if Empty(jLYNNFilters['order'])
		jRepositoryFilters['order'] := "data,hora"
	else
		jRepositoryFilters['order'] := jLYNNFilters['order']
	endif
return jRepositoryFilters

/*/{Protheus.doc} prepareDateFilter
Prepara e valida o filtro de data para a busca
@type function
@version 12
@author jc.maldonado
@since 17/06/2026
@param jLYNNfilters, json, filtros recebidos do chat DTA/LYNN
@param jRepositoryFilters, json, filtros do repositorio de vendas perdidas
/*/
static function prepareDateFilter(jLYNNfilters as json, jRepositoryFilters as json)
	local cStartDate as character
	local cEndDate   as character

	if ! Empty(jLYNNfilters['start_date'])
		cStartDate := jLYNNfilters['start_date']
	endIf

	if Empty(jLYNNfilters['end_date'])
		cEndDate := FWDateTo8601(Date())
	else
		cEndDate := jLYNNfilters['end_date']
	endif

	jRepositoryFilters['filter'] := "data ge '" + cStartDate + "' and data le '" + cEndDate + "'"
return

/*/{Protheus.doc} getContextMsg
Retorna o contexto de acordo com os filtros utilizados via chat LYNN
@type function
@version 12
@author jc.maldonado
@since 17/06/2026
@param jLYNNfilters, json, parametros utilizados no chat LYNN
@return character, contexto
/*/
static function getContextMsg(jLYNNfilters as json) as character
	local cContext := STR0026 as character //"Vendas perdidas encontradas"

	if ! Empty(jLYNNfilters['barter_code'])
		cContext += I18N(STR0027, {jLYNNfilters['barter_code']}) //" na negociação #1[CODIGO_BARTER]#"
	endif

	if ! Empty(jLYNNfilters['product_code'])
		cContext += I18N(STR0028, {jLYNNfilters['product_code']}) //" para o produto #1[CODIGO_PRODUTO]#"
	endif

	if ! Empty(jLYNNfilters['start_date']) .or. ! Empty(jLYNNfilters['end_date'])
		cContext += STR0029 //" no período solicitado"
	endif
return cContext

/*/{Protheus.doc} getFormattedDataList
Retorna um json formatado para o LYNN
@type function
@version 12
@author jc.maldonado
@since 17/06/2026
@param jResponseLostSales, json, resultado da consulta no repositorio de vendas perdidas
@param nPageNumber, json, numero da pagina atual da consulta
@return json, resultado formatado para o LYNN
/*/
static function getFormattedDataList(jResponseLostSales as json, nPageNumber as integer) as json
	local jProductList as json

	jProductList := {;
		'product_lost_list'  : array(0)                              ,;
		'page_number'        : nPageNumber                           ,;
		'page_size'          : MAX_LIST_ITEMS                        ,;
		'has_more_results'   : jResponseLostSales['hasNext']         ,;
		'total_records_found': jResponseLostSales['total']           ,;
		'remaining_records'  : jResponseLostSales['remainingRecords'] ;
		}

	aEval(jResponseLostSales['items'], {|xIt| aAdd(jProductList['product_lost_list'], getFormattedProduct(xIt))})
return jProductList

/*/{Protheus.doc} getFormattedProduct
Retorna o produto formatado para o LYNN
@type function
@version 12
@author jc.maldonado
@since 17/06/2026
@param jProductLostSale, json, Produto com venda perdida
@return json, Produto formatado para o LYNN
/*/
static function getFormattedProduct(jProductLostSale as json) as json
	local jProduct as json

	jProduct := {;
		'product_barter_code'  : jProductLostSale['codigoNegocio']   ,;
		'product_item_barter'  : jProductLostSale['itemInsumo']      ,;
		'product_code'         : jProductLostSale['produto']         ,;
		'product_description'  : jProductLostSale['descricaoProduto'],;
		'product_reason_lost'  : jProductLostSale['motivo']          ,;
		'product_quantity_lost': jProductLostSale['quantidade']      ,;
		'product_date_lost'    : jProductLostSale['data']             ;
		}
return jProduct
