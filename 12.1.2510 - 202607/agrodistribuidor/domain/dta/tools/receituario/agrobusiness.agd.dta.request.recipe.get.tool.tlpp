/*/{Protheus.doc} apply
Metodo de Execução pelo DTA para retorno de dados
@type method
@version 12
@author lindembergson.pacheco
@since 18/05/2026
@param jFilters, json, filter
@return array, dados
/*/
method apply(jFilters as json) as array class DTARequestRecipeGetTool
	local lExistCustomer as logical
	local lExistOrderCode  as logical
	local lExistRequest as logical
	local lExistRecipe  as logical
	local aReturn          as array

	lExistCustomer := jFilters:HasProperty('customer_code') .And. !Empty(jFilters['customer_code'])
	lExistOrderCode  := jFilters:HasProperty('order_code' ) .And. !Empty(jFilters['order_code'] )

	lExistRequest  := jFilters:HasProperty('request_code' ) .And. !Empty(jFilters['request_code'] )
	lExistRecipe  := jFilters:HasProperty('recipe_code' ) .And. !Empty(jFilters['recipe_code'] )

	if lExistCustomer .or. lExistRecipe
		aReturn := getDataRecipe(jFilters)
	else
		aReturn := getDataRequestRecipe(jFilters)
	endIf

return aReturn

/*/{Protheus.doc} getDataRequestRecipe
Retorna os dados de acordo com o pedido de venda ou numero de solicitação de receita
@type function
@version 12
@author lindembergson.pacheco
@since 21/05/2026
@param jFilters, json, filtros utilizados
@return array, dados da consulta
/*/
static function getDataRequestRecipe(jFilters as json) as array

	local oRepository		as object
	local oItemRepository	as object
	local jData				as json
	local jDataLine			as json
	local cContext			as character
	Local aList				as array
	Local aItens			as array
	local aSuggestions		as array
	Local nX
	Local nY
	Local cPedido
	Local cSolicitacao

	If  jFilters:HasProperty('order_code') .and. !Empty(jFilters["order_code"])
		cPedido := posicione('NET', 2, FWxFilial("NET") + jFilters['order_code'], "NET->NET_NUMPED")
		if empty(cPedido)
			return DTAUtilsService():setToolError(400, STR0036) //"O pedido de venda não possui solicitação de receita."
		endif
		jFilters["numeroPedido"] := cPedido
	endif

	if jFilters:HasProperty('request_code') .and. !Empty(jFilters["request_code"])
		jFilters["idSolicitacao"] := Upper(jFilters["request_code"])
	endif

	oRepository := RequestRecipeRepository():New()
	oRepository:find(1, MAX_LIST_ITEMS, jFilters)

	jData  := JsonObject():New()
	jData["request_list"] := {}
	aList := oRepository:getResponse()['items']

	For nX:= 1 to Len(aList)

		oItemRepository := RequestRecipeItemRepository():New()
		oItemRepository:find(1, MAX_LIST_ITEMS, jFilters)
		aItens := oItemRepository:getResponse()['items']

		cSolicitacao := aList[nX]['idSolicitacao']
		jDataLine  := JsonObject():New()
		jDataLine  := {'customer_code': aList[nX]['codigoCliente'],;
			'custome_name': aList[nX]['descricaoCliente'],;
			'request_code': aList[nX]['idSolicitacao'],;
			'enginer_code': aList[nX]['codigoEngenheiro'],;
			'enginer_name': aList[nX]['descricaoEngenheiro'],;
			'order_code':aList[nX]['numeroPedido'],;
			'request_date':aList[nX]['dataEmissao'],;
			'culture':aList[nX]['cultura'],;
			'invoice_number':aList[nX]['numeroNotaFiscal'],;
			'invoice_series':aList[nX]['serieNotaFiscal'],;
			'status_request':aList[nX]['statusSolicitacao'],;
			'status_recipe':aList[nX]['statusReceita'],;
			'dispose_packaging':aList[nX]['localDescarteEmbalagem'],;
			'dispose_packaging_name':aList[nX]['descricaoLocalDescarte'],;
			'recipe_url':aList[nX]['urlReceita'],;
			'recipe_code':aList[nX]['numeroReceituario'] }

		jDataLine['request_items'] := {}

		For nY:= 1 to Len(aItens)
			aadd(jDataLine['request_items'],;
				{ 'product_code':aItens[nY]['codigoProduto'],;
				'product_name': aItens[nY]['descricaoProduto'],;
				'map_code':aItens[nY]['codigoMapa'],;
				'unit_measurement':aItens[nY]['unidadeMedida'],;
				'quantity':aItens[nY]['quantidade']})
		Next

		aadd(jData["request_list"], jDataLine)
	Next

	If Len(aList) > 0

		aSuggestions := {;
			{"label": I18N(STR0037 /*"Quais as Solicitações de Receituário ligados ao pedido de venda #1[ORDER_CODE]# ?"*/               , {cPedido})},;
			{"label": I18N(STR0038 /*"Quais os itens da Solicitação #1[REQUEST_CODE]# ?"*/ , {cSolicitacao})},;
			{"label": I18N(STR0039 /*"Existe receita Gerada para a solicitação #1[REQUEST_CODE]# ?"*/ , {cSolicitacao})},;
			{"label": I18N(STR0040 /*"Quem é o engenheiro Agrônomo Responsável por gerar a receita para a solicitação #1[REQUEST_CODE]# ?"*/ , {cSolicitacao})};
			}
		cContext := I18N(STR0041, {"request_list"})  //"Os dados contidos em '#1[ARG_CODE]#' é uma lista dos ultimos 20 solicitações de receita."
		aReturn := {.T., {"context": cContext, "data": jData, "suggestions": aSuggestions}, 200}
	Else
		aReturn := DTAUtilsService():setToolError(400, STR0045) //"Dados não encontrados, pesquise por pedido de venda ou número de solicitação."
	EndIf

	aSuggestions := Nil
	jData        := Nil

Return aReturn

/*/{Protheus.doc} getDataRecipe
Retorna os dados de acordo com o numero de receita ou codigo de cliente
@type function
@version 12
@author lindembergson.pacheco
@since 21/05/2026
@param jFilters, json, filtros
@return array, dados da consulta
/*/
static function getDataRecipe(jFilters as json) as array

	local oRepository		as object
	local jData				as json
	local jDataLine			as json
	local cContext			as character
	Local aList				as array
	local aSuggestions		as array
	Local nX
	Local cReceita
	Local cCliente

	If  jFilters:HasProperty('recipe_code') .and. !Empty(jFilters["recipe_code"])
		jFilters["numeroReceita"] := Upper(jFilters["recipe_code"])
		cReceita := Upper(jFilters["recipe_code"])
	endif

	if jFilters:HasProperty('customer_code') .and. !Empty(jFilters["customer_code"])
		jFilters["cliente"] := Upper(jFilters["customer_code"])
		cCliente:= Upper(jFilters["customer_code"])
	endif

	oRepository := RecipeRepository():New()
	oRepository:find(1, MAX_LIST_ITEMS, jFilters)

	jData  := JsonObject():New()
	jData["recipe_list"] := {}
	aList := oRepository:getResponse()['items']

	For nX:= 1 to Len(aList)

		jDataLine  := JsonObject():New()
		jDataLine  := {'customer_code': aList[nX]['cliente'],;
			'custome_name': aList[nX]['clienteNome'],;
			'recipe_code': aList[nX]['numeroReceita'],;
			'culture':aList[nX]['cultura'],;
			'invoice_number':aList[nX]['numeroNotaFiscal'],;
			'invoice_series':aList[nX]['serieNotaFiscal'],;
			'order_code':aList[nX]['numeroPedido'],;
			'enginer_code': aList[nX]['engenheiro'],;
			'enginer_name': aList[nX]['nomeEngenheiro'],;
			'date_recipe':aList[nX]['dataEmissao'],;
			'recipe_url':aList[nX]['urlReceita'],;
			'status_recipe':aList[nX]['status'] }

		aadd(jData["recipe_list"], jDataLine)
	Next

	If Len(aList) > 0

		aSuggestions := {;
			{"label": I18N(STR0042 /*"Qual a nota fiscal vinculada a Receita #1[RECIPE_CODE]# ?"*/		, {cReceita})},;
			{"label": I18N(STR0043 /*"Quais as receitas geradas para o Cliente #1[CUSTUMER_CODE]# ?"*/	, {cCliente})},;
			}
		cContext := I18N(STR0044, {"recipe_list"})  //"Os dados contidos em '#1[ARG_CODE]#' é uma lista dos ultimos 20 receitas."
		aReturn := {.T., {"context": cContext, "data": jData, "suggestions": aSuggestions}, 200}

	Else
		aReturn :=  DTAUtilsService():setToolError(400, STR0046) //"Dados não encontrados, pesquise por código de cliente ou número de receita."
	EndIf

	aSuggestions := Nil
	jData        := Nil

Return aReturn
