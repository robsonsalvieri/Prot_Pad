#Include "agrobusiness.agd.dta.request.recipe.get.tool.ch"
#Include "TLPP-CORE.TH"
#Include "TOTVS.CH"

#define MAX_LIST_ITEMS 20
namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} DTARequestRecipeGetTool
Tool do DTA para Receituario Agronomico
@type class
@version 12
@author lindembergson.pacheco
@since 18/05/2026
/*/
Class DTARequestRecipeGetTool
	Static Method getSetup() as Json
	Static Method getParameters() as Json
	Static Method getRules() as Character
	Static Method getDescription() as Character
	Static Method getDescriptionShort() as Character
	Static Method getExamples() as Array
	Static Method getGlossary() as Array

	Static Method apply(jFilters as Json) as Array
EndClass

/*/{Protheus.doc} getSetup
Dados para configuração da Tool
@type method
@version 12
@author lindembergson.pacheco
@since 18/05/2026
@return json, dados de configuracao
/*/
Method getSetup() as Json Class DTARequestRecipeGetTool
	Local cName         := ""  as Character
	Local oLoadTool     := Nil as Object

	cName             := "BReceituarioGET"

	oLoadTool := DTAToolsBuilder():New()
	oLoadTool:setName(cName)
	oLoadTool:setDescription(DTARequestRecipeGetTool():getDescription())
	oLoadTool:setShortDescription(DTARequestRecipeGetTool():getDescriptionShort())


	jReturn := oLoadTool:build()
	FreeObj(oLoadTool)
Return jReturn

/*/{Protheus.doc} getDescription
Retorna a descrição completa da Tool
@type method
@version 12
@author lindembergson.pacheco
@since 18/05/2026
@return character, descricao
/*/
method getDescription()  as Character  Class DTARequestRecipeGetTool
return STR0001 //"Fornece um resumo de informações sobre solicitações de receitas e receitas agronômicas. O resumo de dados tem a lista de receitas e lista de solicitaçõs."

/*/{Protheus.doc} getDescriptionShort
Retorna a descrição curta da Tool
@type method
@version 12
@author lindembergson.pacheco
@since 18/05/2026
@return character, descricao
/*/
Method getDescriptionShort() as Character Class DTARequestRecipeGetTool
return STR0002 //"Busca lista com informações de solicitações ou receitas relacionadas a um pedido de venda."

/*/{Protheus.doc} getRules
Retorna as regras de uso da Tool
@type method
@version 12
@author lindembergson.pacheco
@since 18/05/2026
@return character, descricao
/*/
Method getRules()  as Character Class DTARequestRecipeGetTool
Return STR0003 //"Use esta tool quando a pergunta envolver código de cliente, pedido de venda, número de receita, código de solicitação de receita, itens de solicitação, engenheiro agronômico, nota fiscal vinculada a receita ou solicitação."

/*/{Protheus.doc} getParameters
Retorna os parâmetros de uso da Tool
@type method
@version 12
@author lindembergson.pacheco
@since 18/05/2026
@return json, params
/*/
Method getParameters() as Json Class DTARequestRecipeGetTool
	oLoadTool := DTAToolsBuilder():New()

	oLoadTool:addParameter("customer_code"	, "string"  , STR0004, .T.) //"O código/nome do cliente pode conter somente letras, somente números ou a combinação de caracteres, podendo ou não ter caracteres especiais. Exemplo: 'R001', 'INJET', '000001', 'TORNO1', 'JOAO', 'ANDRE SILVA'."
	oLoadTool:addParameter("request_code"	, "string"	, STR0005, .T.) //"O código da solicitação de receita."
	oLoadTool:addParameter("order_code"		, "string"	, STR0006, .F.) //"Código Pedido de Venda."
	oLoadTool:addParameter("recipe_code"	, "string"	, STR0007, .F.) //"Número da receita."

	jReturn := oLoadTool:build()
	FreeObj(oLoadTool)

return jReturn["parameters"]

/*/{Protheus.doc} getExamples
Retorna os exemplos de uso da Tool
@type method
@version 12
@author lindembergson.pacheco
@since 18/05/2026
@return array, exemplos
/*/
Method getExamples() as Array Class DTARequestRecipeGetTool
	oLoadTool := DTAToolsBuilder():New()

	oLoadTool:addExample(I18N(STR0008, {'order_code'})) //"Quais as Solicitações de Receituário ligados ao pedido de venda '#1[order_code]#' ?"
	oLoadTool:addExample(I18N(STR0009, {'request_code'})) //"Quais os itens da solicitação '#1[request_code]#' ?"
	oLoadTool:addExample(I18N(STR0010, {'request_code'})) //"Existe receita Gerada para a solicitação '#1[request_code]#' ?"
	oLoadTool:addExample(I18N(STR0011, {'recipe_code'})) //"Qual a nota fiscal vinculada a receita '#1[recipe_code]#' ?"
	oLoadTool:addExample(I18N(STR0012, {'recipe_code'})) //"Quem é o engenheiro Agrônomo Responsável por gerar a receita para a solicitação '#1[recipe_code]#' ?"
	oLoadTool:addExample(I18N(STR0013, {"customer_code"}))  //"Quais as receitas geradas para o cliente '#1[customer]#'?"

	jReturn := oLoadTool:build()
	FreeObj(oLoadTool)

return jReturn['examples']

