#Include "TLPP-CORE.TH"
#Include "TOTVS.CH"

namespace totvs.protheus.agrobusiness.agd  

/*/{Protheus.doc} DTAToolsEnum
Classe para Listar as Tools Disponiveis no produto para uso
@type class
@version 12
@author jean.schulze
@since 13/11/2025
/*/
Class DTAToolsEnum
	Static Method enums() as Array
    Static Method getById() as Character
EndClass

/*/{Protheus.doc} enums
Lista fixa das Tools
@type method
@version 12
@author jean.schulze
@since 13/11/2025
@return array, dados
/*/
Method enums() as Array Class DTAToolsEnum
return valuesEnums()

/*/{Protheus.doc} getById
Retorna a tool conforme o id
@type method
@version 12
@author jean.schulze
@since 13/11/2025
@param id, variant, identificao
@return character, classe da tool
/*/
Method getById(cId) as Character Class DTAToolsEnum
	Local ret as Character

    nPos := AScan(valuesEnums(),{|x| x[1] == Alltrim(cId) })
    if nPos > 0 
        ret := valuesEnums()[nPos][2]
    end

return ret

/*/{Protheus.doc} valuesEnums
Lista com valores do Enum
@type function
@version 12
@author jean.schulze
@since 14/11/2025
@return array, {{cCodigoTool, cClasseTool}, ...}
/*/
Static Function valuesEnums() as array
	Local aEnums := {} as array

	AAdd(aEnums, {'BFechamentoGET'  , "DTABarterFinancialClosingGetTool()"})
	AAdd(aEnums, {'BNegocioGET'     , "DTABarterBusinessGetTool()"     })
	AAdd(aEnums, {'BNegocioItensGET', "DTABarterBusinessItemGetTool()" })
	AAdd(aEnums, {'BInstrucaoGET'   , "DTABarterBoardingInstructionGetTool()"  })
	AAdd(aEnums, {'BPedidosVendaGET', "DTABarterOrderGetTool()"        })
	AAdd(aEnums, {'BContratosGET'   , "DTABarterContractGetTool()"     })
	AAdd(aEnums, {'BRateioGET'      , "DTABarterApportionmentGetTool()" })
	AAdd(aEnums, {'BReceituarioGET' , "DTARequestRecipeGetTool()"  })
	AAdd(aEnums, {'BVendaPerdidaGET', "DTABarterLostSaleGetTool()"  })
	AAdd(aEnums, {'BReceituarioAgronomicoGET', "DTABarterAgronomicRecipeGetTool()"  })

return aEnums
