#include 'tlpp-core.th'
#include 'totvs.ch'

namespace totvs.protheus.agrobusiness.agd  
 
/*/{Protheus.doc} SalesOrderExtensionRepository
Repositório da tabela de extensão do pedido de venda do agro distribuidor
@type class
@version 12
@author claudineia.reinert
@since 30/04/2026
/*/
class SalesOrderExtensionRepository from UtilsRepository
	public Data cChaveIDRepository As Object //chave unica para updates
	public method new()	
	public method getFilterById() 		  as array
	public Method save()
	public Method informarIntegracaoExterna()
	public Method modelDelete()
	
	private method getFields()            as array
	private method getJoins()             as array

	static method isIntegracaoExterna()   as logical
endclass

/*/{Protheus.doc} SalesOrderExtensionRepository::new
Construtor
@type method
@version 12
@author claudineia.reinert
@since 30/04/2026
@return object, Instância da classe
/*/
method New(pcChaveIDRepository as character) class SalesOrderExtensionRepository
	Self:cChaveIDRepository := pcChaveIDRepository
	_Super:New('NEQ', self:getFields(), self:getJoins())
return Self

/*/{Protheus.doc} getFilterById
Obtem o filtro para getById
@type method
@version 12
@author claudineia.reinert
@since 30/04/2026
@param cNumPedido, character, numero do pedido
@return array, lista de filtro
/*/
Method getFilterById(cNumPedido) as Array Class SalesOrderExtensionRepository
	Local aFilterId := {}

	AAdd(aFilterId, {'NEQ_NUM', cNumPedido})

return aFilterId

/*/{Protheus.doc} save
Salva um novo registro na tabela de extensão do pedido de venda do agro distribuidor
@type method
@version 12
@author claudineia.reinert
@since 30/04/2026
@param jCmdRegistrar, json, json com os dados para registro
@return variant, nil
/*/
Method save(jCmdRegistrar)  Class SalesOrderExtensionRepository
	Local aNELFields    as Array
	Local nField		as Numeric
	Local oModel 		as object

	if !self:existsField("NEQ_INTEXT") //ja trata o erro caso o campo de integração externa não exista
		Return NIL
	EndIf

	oModel := FwLoadModel("AGDX040")
	oModel:SetOperation(3) //Insert
	oModel:Activate()

	aNELFields := self:jsonToArrayFields(jCmdRegistrar, self:getFields())

	For nField := 1 to len(aNELFields)
		if  oModel:HasField("AGDX040_NEQ", aNELFields[nField][1] )
			oModel:SetValue("AGDX040_NEQ", aNELFields[nField][1], aNELFields[nField][2])
		endif
	Next

	If oModel:VldData() .And. oModel:CommitData()
		Self:setSuccess(oModel:GetValue("AGDX040_NEQ", "NEQ_NUM"))
	Else
		Self:setErrorByErrorMessageModel(oModel, 400)
	EndIf

	oModel:DeActivate()
	oModel:Destroy()
	oModel := NIL
	FreeObj(oModel)
Return nil

/*/{Protheus.doc} update
Atualiza o campo de integração externa para informar que o pedido foi gerado via integração externa
@type method
@version 12
@author claudineia.reinert
@since 06/05/2026
/*/
method informarIntegracaoExterna() Class SalesOrderExtensionRepository
	if ::existsField("NEQ_INTEXT")
		::updateRepository({{"NEQ_INTEXT", "1"}}, ::cChaveIDRepository)
	endIf
return nil

/*/{Protheus.doc} SalesOrderExtensionRepository::getFields
Obtem os campos do repositório
@type method
@version 12
@author claudineia.reinert
@since 30/04/2026
@return array, {{cCampoJson, cCampoProtheus, cTipoCampo, lMostraCampoConsulta}, ...}
/*/
method getFields() as array class SalesOrderExtensionRepository
	Local aFields := {}

	aAdd(aFields, {'filial'					, 'NEQ_FILIAL' , 'C', .F.})
	aAdd(aFields, {'numeroPedido'			, 'NEQ_NUM'    , 'C', .T.})
	aAdd(aFields, {'filialEngenheiro'		, 'NEQ_FILENG' , 'C', .T.})
	aAdd(aFields, {'codigoEngenheiro'		, 'NEQ_CODENG' , 'C', .T.})
	aAdd(aFields, {'filialLocalDescarte'	, 'NEQ_FILDES' , 'C', .T.})
	aAdd(aFields, {'codigoLocalDescarte'	, 'NEQ_CODDES' , 'C', .T.})
	if NEQ->(FieldPos("NEQ_INTEXT")) > 0
		aAdd(aFields, {'integracaoExterna'		, 'NEQ_INTEXT' , 'C', .T.})
	endif	
	aAdd(aFields, {'nomeEngenheiro'			, 'NP8_NOME'  , 'C', .T.})
	aAdd(aFields, {'nomeLocalDescarte'		, 'NEO_NOME'  , 'C', .T.})
return aFields

/*/{Protheus.doc} SalesOrderExtensionRepository::getJoins
Obtem os joins do repositório
@type method
@version 12
@author claudineia.reinert
@since 30/04/2026
@return array, {{cTipoJoin, cTabela, cWhere}, ...}
/*/
method getJoins() as array class SalesOrderExtensionRepository
	local aJoins := {} as array

	aAdd(aJoins, {'LEFT OUTER', 'NP8' , Self:getWhereDefault('NP8.NP8_FILIAL = NEQ.NEQ_FILENG AND NP8.NP8_CODIGO = NEQ.NEQ_CODENG', 'NP8')})
	aAdd(aJoins, {'LEFT OUTER', 'NEO' , Self:getWhereDefault('NEO.NEO_FILIAL = NEQ.NEQ_FILDES AND NEO.NEO_CODIGO = NEQ.NEQ_CODDES', 'NEO')})
return aJoins

/*/{Protheus.doc} SalesOrderExtensionRepository::isIntegracaoExterna
Verifica se o pedido de venda é de integração externa
@type method
@version 12
@author jc.maldonado
@since 06/05/2026
@param cCodigoPedido, character, Código do pedido de venda
@return logical, resultado da verificação
/*/
method isIntegracaoExterna(cCodigoPedido as character) as logical class SalesOrderExtensionRepository
    local aArea       as array
    local lIntegracao as logical
	
	aArea       := FWGetArea()
    lIntegracao := Posicione("NEQ", 1, FwXFilial("NEQ") + cCodigoPedido, "NEQ_INTEXT") == '1' //'1'=Sim
	FwRestArea(aArea)
return lIntegracao


/*/{Protheus.doc} SalesOrderExtensionRepository::modelDelete
Realiza a exclusão do registro através do modelo MVC.
@type method
@version 12
@author lindembergson.pacheco
@since 03/06/2026
@param cChaveId, character, Composicao do id da chave primaria da tabela
@param cModelName, character, (Opcional) Se não informado utiliza o modelo padrao definido no repositório
/*/
Method modelDelete(cChaveId as character, cModelo as character)  Class SalesOrderExtensionRepository

	self:buildModelDelete(cChaveId, "AGDX040")
	If ! self:isSuccess()
		self:setError(self:getMessageError()) 
	EndIf

Return nil
