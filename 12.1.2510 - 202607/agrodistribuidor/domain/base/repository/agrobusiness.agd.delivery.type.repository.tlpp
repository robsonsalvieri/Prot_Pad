#include 'totvs.ch'
#include 'tlpp-core.th'
#include 'fwmvcdef.ch'
#include 'agrobusiness.agd.delivery.type.repository.ch'

#DEFINE TCO_TBDCDTO             totvs.protheus.agrobusiness.agd.TCOTBDCDTO
#DEFINE TCODEPARA_SERVICE       totvs.protheus.agrobusiness.agd.TCOFromtoService
namespace totvs.protheus.agrobusiness.agd  

/*/{Protheus.doc} DeliveryTypeRepository
Repositorio de Tipo de Entrega 
@type class
@version 12
@author carlos.augusto
@since 11/05/2026
/*/
class DeliveryTypeRepository from UtilsRepository
	public method new()
	public method getDeliveryType()
endclass

/*/{Protheus.doc} DeliveryTypeRepository::New
Construtor
@type method
@version 12
@author carlos.augusto
@since 11/05/2026
@return object, self
/*/
method new() class DeliveryTypeRepository
	_Super:New()
return self


/*/{Protheus.doc} getDeliveryType
Retorna os dados de tipo de entrega
@type method
@version 12
@author carlos.augusto
@since 11/05/2026
@return object, self
/*/
Method getDeliveryType(cExtCodFilial as character, cExtCodProp as character) Class DeliveryTypeRepository
	Local oJson          := JsonObject():New()
    Local oTCO_TBDCDTO   := TCO_TBDCDTO():New()
    Local cCodeInteg     := oTCO_TBDCDTO:getIdentificaoIntegracao()
    Local oTCODEPARAServ := TCODEPARA_SERVICE():New()
	Local cInternaIdCli  := RTRIM(oTCODEPARAServ:getInternalID(cCodeInteg, "NEP", "NEP_CODCLI", cExtCodProp))
	Local cInternaIdFil  := RTRIM(oTCODEPARAServ:getInternalID(cCodeInteg, "XX8", "XX8_CODIGO", cExtCodFilial))
	Local aPropr		 := {}
	Local aFilialDePara  := {}
	Local aSM0Dados		 := {}
	Local cFilProp       := ''
	Local cCodProp	     := ''
	Local cLojaProp	     := ''

	If !Empty(cInternaIdCli)
 		aPropr := StrTokArr2(cInternaIdCli, "|") 
		cFilProp  := Padr(AllTrim(aPropr[2]), TamSX3("A1_FILIAL")[1])
		cCodProp  := Padr(AllTrim(aPropr[3]), TamSX3("A1_COD")[1])
		cLojaProp := Padr(AllTrim(aPropr[4]), TamSX3("A1_LOJA")[1])

		NEP->(dbSetOrder(1))
		If NEP->(dbSeek(cFilProp+cCodProp+cLojaProp))  
			SA1->(dbSetOrder(1))
			If SA1->(dbSeek(FwXFilial('SA1')+NEP->NEP_CODCLI+NEP->NEP_LOJCLI))  //Dados da Propriedade
				oJson['codigoPropriedade'] := SA1->A1_COD
				oJson['lojaPropriedade']   := SA1->A1_LOJA
				oJson['estadoPropriedade'] := SA1->A1_EST
			EndIf
			If SA1->(dbSeek(FwXFilial('SA1')+NEP->NEP_CLIPRO+NEP->NEP_LOJPRO))  //Cliente da Propriedade
				oJson['codigoCliente']     := SA1->A1_COD
				oJson['lojaCliente']       := SA1->A1_LOJA
				oJson['estadoCliente']     := SA1->A1_EST
			EndIf
		EndIf
	Else
		Self:setError(STR0001 + cValToChar(cExtCodProp), 400) //"Nenhum cliente encontrado com o código "
		return nil
	EndIf

	If !Empty(cInternaIdFil)
 		aFilialDePara := StrTokArr2(cInternaIdFil, "|") 
		If Len(aFilialDePara) = 3
			aSM0Dados := FWSM0Util():GetSM0Data( aFilialDePara[1] , aFilialDePara[2] , { "M0_ESTENT" } )
			If Len(aSM0Dados) > 0
				oJson['codigoFilial']      := aFilialDePara[2]
				oJson['estadoFilial']      := AllTrim(aSM0Dados[1][2])
			Else
				Self:setError(STR0002 + cValToChar(cExtCodFilial), 400) //"Nenhuma filial encontrada no Protheus com o código "
				return nil
			EndIf
		Else
			Self:setError(STR0003 + cValToChar(cExtCodFilial), 400) //"Verifique o DE/PARA da filial "
			return nil
		EndIf
	Else
		Self:setError(STR0004 + cValToChar(cExtCodFilial), 400) //"Nenhuma filial encontrada no DE/PARA com o código "
		return nil
	EndIf

	If oJson['estadoPropriedade'] <> oJson['estadoFilial']
		oJson['interestadual'] := .T.
	Else 
		oJson['interestadual'] := .F.
	EndIf

	Self:setSuccess(oJson)

Return oJson

