#include 'totvs.ch'
#include 'tlpp-core.th'
#include 'fwmvcdef.ch'
#include 'agrobusiness.agd.product.repository.ch'

namespace totvs.protheus.agrobusiness.agd  

/*/{Protheus.doc} ProductRepository
Repository do cadastro de produtos MATA010
@type class
@version 12
@author carlos.augusto
@since 21/10/2025
/*/
class ProductRepository from UtilsRepository
	public Data cChaveIDRepository As Object //chave unica para updates
	public method new()
	public method convertToFields()
	public method updateRepository()
	public method validaEntradaPrincipioAtivo()
	public method isItemControlaReceituario()
	public method produtosByMapa() 

	private method getFields() as array
endclass

/*/{Protheus.doc} new
Inicializa com de/para atributo e campo Protheus
@type class
@version 12
@author carlos.augusto
@since 21/10/2025
/*/
method New(pcChaveIDRepository as character) class ProductRepository
	Self:cChaveIDRepository := pcChaveIDRepository
	_Super:New('SB1', self:getFields())
return Self

/*/{Protheus.doc} getFields
De/para atributo e campo Protheus
@type class
@version 12
@author carlos.augusto
@since 21/10/2025
/*/
method getFields() as array class ProductRepository
	local aFields as array

	aFields := {;
		{'codigoProduto'  , 'B1_COD',     'C', .T.},;
		{'principioAtivo' , 'NCR_PRATIV', 'C', .T.},;
		{'observacaoMapa' , 'NCR_OBSMAP', 'C', .T.};
		}
return aFields


/*/{Protheus.doc} convertToFields
De/para Campo Protheus e valor enviado da api
@type class
@version 12
@author carlos.augusto
@since 22/10/2025
/*/
method convertToFields(jBodyProduto) Class ProductRepository
	Local aFieldsCommit := {}

	If jBodyProduto:hasProperty("principioAtivo") .Or. !Empty(jBodyProduto:GetJsonObject("principioAtivo"))
		AAdd(aFieldsCommit, {'NCR_PRATIV', jBodyProduto:GetJsonObject("principioAtivo")})
	EndIf

	If jBodyProduto:hasProperty("observacaoMapa") .Or. !Empty(jBodyProduto:GetJsonObject("observacaoMapa"))
		AAdd(aFieldsCommit, {'NCR_OBSMAP', jBodyProduto:GetJsonObject("observacaoMapa")})
	EndIf

Return aFieldsCommit

/*/{Protheus.doc} updateRepository
Atualização do Repositório
@type method
@version 12
@author jean.schulze
@since 13/01/2025
@param aFieldsSaveComand, array, lista de campos a serem salvos
@return variant, nil
/*/
method updateRepository(aFieldsSaveComand as Array) Class ProductRepository
	Local nField		as Numeric

	dbSelectArea('NCR')
	NCR->(dbSetOrder(1)) 
	If NCR->(dbSeek(Self:cChaveIDRepository))
		RecLock("NCR",.f.)
		For nField := 1 to len(aFieldsSaveComand)
			NCR->( &(aFieldsSaveComand[nField][1]) ) :=  aFieldsSaveComand[nField][2]
		Next
		NCR->(MsUnlock())
	endif

return nil


/*/{Protheus.doc} validaEntradaPrincipioAtivo
Validacao previa dos dados enviados pela api
@type class
@version 12
@author carlos.augusto
@since 21/10/2025
/*/
method validaEntradaPrincipioAtivo(jBodyProduto as json) class ProductRepository
	Local lRet := .T.
	Local lProdAgro := "AGRO" $ SUPERGETMV("MV_CADPROD", .F., "")

	If !Self:existsById(Self:cChaveIDRepository)
		Return .F.
	EndIf

	If !lProdAgro
		Self:SetError(STR0002, 400) //"O parâmetro MV_CADPROD não contém AGRO."
		Return .F.
	EndIf

Return lRet


/*/{Protheus.doc} isItemControlaReceituario
Retorna se produto controla receituario
@type class
@version 12
@author carlos.augusto
@since 30/12/2025
/*/
Method isItemControlaReceituario(cFilialSC9, cPedido, cItem, cSeqLib) class ProductRepository
	Local lRet       := .F.
	Local oRepoSolic := RequestRecipeRepository():New()
	Local aAreaSC9   := SC9->(GetArea())
	Local aAreaSC6   := SC6->(GetArea())

	SC9->(DbSetOrder(1))
	If SC9->(DbSeek(cFilialSC9 + cPedido + cItem + cSeqLib))
		SC6->(DbSetOrder(1))                                                                                                                              
		If SC6->(DbSeek(FwXFilial("SC6") + SC9->C9_PEDIDO + SC9->C9_ITEM + SC9->C9_PRODUTO))
			If oRepoSolic:isGeraReceita(SC9->C9_PRODUTO) .And.;
				oRepoSolic:isPropriedadeRural(SC9->C9_CLIENTE, SC9->C9_LOJA) .And.;
				oRepoSolic:isRegraReceita(SC6->C6_NUM, SC6->C6_TES, SC6->C6_CLI, SC6->C6_LOJA)
				lRet := .T.
			EndIf
		EndIf
	EndIf
	
	RestArea(aAreaSC9)
	RestArea(aAreaSC6)

Return lRet


/*/{Protheus.doc} produtosByMapa
Retorna todos os produtos que emitem receituario de um mapa
@type class
@version 12
@author carlos.augusto
@since 22/04/2026
/*/
Method produtosByMapa(cMapa) class ProductRepository
    Local oItem   := JsonObject():New()
	Local cQuery  := ""
	Local cAliNCR := GetNextAlias()
	Local aItems  := {}

	cQuery := " SELECT NCR.NCR_PROD, NCR.NCR_PRATIV, SB1.B1_DESC "
	cQuery += 	  " FROM " + RetSqlName("NCR") + " NCR "
	cQuery += 		" INNER JOIN " + RetSqlName("SB1") + " SB1 "
	cQuery += 			" ON ( SB1.B1_FILIAL = ? "
	cQuery += 				" AND SB1.B1_COD   = NCR.NCR_PROD "
	cQuery += 				" AND SB1.D_E_L_E_T_ = ' ' ) "
	cQuery += 		" WHERE NCR.NCR_FILIAL = ? "
	cQuery += 			" AND NCR.NCR_MAPA = ? "
	cQuery += 	        " AND NCR.NCR_EMREC = '1'"
	cQuery += 			" AND NCR.D_E_L_E_T_ = ' ' "

	cQuery := ChangeQuery(cQuery)
	oFwPrepS := FWPreparedStatement():New()
	oFwPrepS:SetQuery(cQuery)
	oFwPrepS:SetString(1, FWxFilial('SB1'))
	oFwPrepS:SetString(2, FWxFilial('NCR'))
	oFwPrepS:SetString(3, cMapa)

	cQuery := oFwPrepS:GetFixQuery()
            
	DbUseArea(.T., "TOPCONN", TCGenQry(,,cQuery), cAliNCR, .F., .T.)
	While (cAliNCR)->(!Eof())
		oItem := JsonObject():New()
		oItem["codigo"]         := AllTrim((cAliNCR)->NCR_PROD)
		oItem["descricao"]      := AllTrim((cAliNCR)->B1_DESC)
		oItem["principioAtivo"] := AllTrim((cAliNCR)->NCR_PRATIV)
		AAdd(aItems, oItem)
		(cAliNCR)->(dbSkip())
	EndDo

	(cAliNCR)->(DbCloseArea())
	oFwPrepS := Nil
	
Return aItems
