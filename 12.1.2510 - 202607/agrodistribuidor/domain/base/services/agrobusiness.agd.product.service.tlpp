
#include "totvs.ch"
#include 'tlpp-core.th'
#include 'agrobusiness.agd.product.service.ch'

namespace totvs.protheus.agrobusiness.agd  

/*/{Protheus.doc} ProductService
Servico para cadastro de produtos
@type class
@version 12
@author carlos.augusto
@since 21/10/2025
/*/
class ProductService FROM UtilsService

	public method new()
	public method setPrincipioAtivo()
	public method produtosByMapa() 

endclass

/*/{Protheus.doc} new
Constructor da Classe
@type class
@version 12
@author carlos.augusto
@since 21/10/2025
/*/
method new() class ProductService
	_Super:New()
return Self

/*/{Protheus.doc} setProduto
Altera o cadastro de produtos
@type class
@version 12
@author carlos.augusto
@since 21/10/2025
/*/
method setPrincipioAtivo(jBodyProduto, cProduto) class ProductService
	Local oProdutoRepository As Object
	Local aFieldsSaveComand  As Array
	Default cProduto         := ""

	oProdutoRepository := ProductRepository():New(cProduto)

	If oProdutoRepository:validaEntradaPrincipioAtivo(jBodyProduto)
		aFieldsSaveComand := oProdutoRepository:convertToFields(jBodyProduto)
		oProdutoRepository:updateRepository(aFieldsSaveComand)
		if oProdutoRepository:isSuccess()
			oProdutoRepository:setSuccess(STR0001)//"Produto atualizado com sucesso."
		EndIf
	EndIf

	Self:setFullResponse(oProdutoRepository)
	oProdutoRepository:DeActivate()
	FreeObj(oProdutoRepository)

return nil


/*/{Protheus.doc} produtosByMapa
Obtem os produtos por mapa
@type class
@version 12
@author carlos.augusto
@since 22/04/2025
/*/
method produtosByMapa(cMapa) class ProductService
	Local oProdutoRepository As Object
	Local aProducts          := Nil
	Default cMapa            := ""

	oProdutoRepository := ProductRepository():New()
	aProducts := oProdutoRepository:produtosByMapa(cMapa)

	oProdutoRepository:DeActivate()
	FreeObj(oProdutoRepository)

return aProducts
