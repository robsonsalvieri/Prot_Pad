#include "totvs.ch"
#include "tlpp-core.th"
#include "fwmvcdef.ch"
#include "agrobusiness.agd.request.recipe.service.ch"

namespace totvs.protheus.agrobusiness.agd  


/*/{Protheus.doc} RequestRecipeService
Serviço para gerenciamento de Solicitação de Receita (NET/NEU)
@type class
@version 12
@author lindembergson.pacheco
@since 06/10/2025
/*/
class RequestRecipeService FROM UtilsService

	public method New()
	public method gerarSolicitacaoReceita()
	public method listar()
	public method getTotalizadores()
	public method inativarSolicitacoesAnteriores()
	public method getSolicPedidos() as ARRAY
	public method confirmarSolicitacao()
	public method vincularReceita()
	public method removeSolicitacoesPendentesPedido()
	public method gravarErroSolicitacaoReceita()

endclass

/*/{Protheus.doc} New
Constructor
@type method
@version 12
@author lindembergson.pacheco
@since 06/10/2025
@return variant, this
/*/
method New() class RequestRecipeService
	_Super:New()
return Self


/*/{Protheus.doc} gerarSolicitacaoReceita
Gerar Solicitação de Receita (NET/NEU)
@type method
@version 12
@author lindembergson.pacheco
@since 06/10/2025
@return logical, true
/*/
method gerarSolicitacaoReceita(cPedido, cStatusSol) class RequestRecipeService
	Local cReceitas		:= ""
	Local oRepository	As Object
	Local cMensagem		:= ""

	oRepository := RequestRecipeRepository():New()
	oRepository:gerarSolicitacao(cPedido, cStatusSol)
	if !oRepository:isSuccess()
		If ( Upper(FunName()) == "AGDA040" .or. IsInCallStack( "AGDI043M" ) ) .and. !IsBlind()
			AGDHELP(STR0001, oRepository:getMessageError(), oRepository:getSolutionError() ) //#"Atenção!"
		else
			Self:setError(oRepository:getMessageError(), 404, oRepository:getSolutionError())
		endif
	else
		cReceitas := CenArr2Str(oRepository:getResponse(), ", ")
		cMensagem := STRTRAN(STR0002, "*", cReceitas) // #"Receitas " + cReceitas + " geradas com sucesso."
		
		oRepository:cancelarSolicitacoesComErroPorPedido(cPedido) //verifica se existe alguma solicitação com erro para o pedido e cancela.	

		If ( Upper(FunName()) == "AGDA040" .or. IsInCallStack( "AGDI043M" ) ) .and. !IsBlind()
			FWAlertSuccess(cMensagem )
		else
			Self:setSuccess( cMensagem )
		endif
	endif
	FreeObj(oRepository)

Return nil


/*/{Protheus.doc} listar
Busca as Solicitações de Receita
@type method
@version 12
@author carlos.augusto
@since 04/11/2025
@param nPage, numeric, pagina
@param nPageSize, numeric, tamanho
@param oJsonQryParam, object, param
@return variant, this
/*/
method listar(nPage, nPageSize, oJsonQryParam) class RequestRecipeService
	Local oRepository As Object
	Default nPage     := 1
	Default nPageSize := 10
	Default oJsonQryParam := nil

	oRepository := RequestRecipeRepository():New()
	oRepository:find(nPage, nPageSize, oJsonQryParam)

	Self:setFullResponse(oRepository)

	oRepository:DeActivate()
	FreeObj(oRepository)
Return nil

/*/{Protheus.doc} getTotalizadores
Retorna os totalizadores das solicitacoes
@type method
@version 12
@author jean.schulze
@since 10/02/2026
@param oJsonQryParam, object, query param
@return variant, totalizadores
/*/
method getTotalizadores(oJsonQryParam) class RequestRecipeService
	Local oRepository As Object
	Default oJsonQryParam := nil

	oRepository := RequestRecipeRepository():New()

	Self:setSuccess(oRepository:getTotalizadores(oJsonQryParam))

	oRepository:DeActivate()
	FreeObj(oRepository)
Return nil


/*/{Protheus.doc} inativarSolicitacoesAnteriores
Atualiza Status da Solicitação
@type Method
@version P12
@author scheronlini.martins
@since 03/12/2025
@param cSolic, character, Código da solicitação (NET_CODIGO)
@param cStatusSol, character, Status da Solicitação 0=Pendente; 1=Confirmada; 2=Cancelada; 3=Invalida; 4=Incompleta; 5=Com Erro
@param cStatusRec, character, Status da Receita 0=Pendente; 1=Emitida; 2=Cancelada
/*/
method inativarSolicitacoesAnteriores(cSolic as Character, cStatusSol as Character, cStatusRec as Character) class RequestRecipeService
	Local oRepository As Object
	Local cNewStatus  As Character

	oRepository := RequestRecipeRepository():New(FWxFilial('NET') + cSolic)

	if cStatusSol == "1"; // 1=Confirmada
		.and. cStatusRec == "1"; // 1=Emitida
		.and. ! oRepository:hasProdutoFaturado(cSolic)
		
		cNewStatus := "3"
	
	elseif cStatusSol $ "1|4"/*Confirmada|Incompleta*/;
			.and. (cStatusRec == "0"/*Pendente*/ .or. cStatusRec == "2"/*Cancelada*/.or. empty(cStatusRec))
		
		cNewStatus := "2"
	
	elseif cStatusSol == "0"/*Pendente*/ .and. empty(cStatusRec)
		
		cNewStatus := "3"
	elseif cStatusSol == "5"/*Com Erro*/
		
		cNewStatus := "2" //Cancelada
	endif

	if ! Empty(cNewStatus)
		oRepository:atualizaStatus(cNewStatus)
		Self:setFullResponse(oRepository)
	endif

	oRepository:DeActivate()
	FreeObj(oRepository)
return


/*/{Protheus.doc} confirmarSolicitacao
Confirma uma solicitação de receita alterando seu status para "Confirmado"
@type method
@version 12
@author beatriz.dantas
@since 10/12/2025
@param cCodigo, character, Código da solicitação (NET_CODIGO)
@return nil
/*/
method confirmarSolicitacao(cCodigo) class RequestRecipeService
	Local oRepository As Object
	
	oRepository := RequestRecipeRepository():New(FWxFilial('NET')+cCodigo)
	oRepository:confirmarSolicitacao()
	
	If oRepository:isSuccess()
		Self:setSuccess(oRepository:getResponse())
	Else
		Self:setError(oRepository:getMessageError(), 404,oRepository:getSolutionError())
	EndIf
	
	FreeObj(oRepository)
Return nil


/*/{Protheus.doc} vincularReceita
Confirma uma solicitação de receita alterando seu status para "Confirmado"
@type method
@version 12
@author carlos.augusto
@since 23/12/2025
@param cIdSolicitacao, character, Código da solicitação (NET_CODIGO)
@param jPayload, json, receita para vinculo
@return nil
/*/
method vincularReceita(cIdSolicitacao as character, jPayload as json) class RequestRecipeService
	Local oRepository As Object

	oRepository := RequestRecipeRepository():New(cIdSolicitacao)
	oRepository:vincularReceita(jPayload, .T.)
	Self:setFullResponse(oRepository)
	oRepository:DeActivate()
	FreeObj(oRepository)

Return nil

/*/{Protheus.doc} RequestRecipeService::removeSolicitacoesPendentesPedido
Remove as solicitações de receita com status solicitação Pendente (NET_STSSOL='0') do pedido de venda informado.
@type method
@version 12
@author jc.maldonado
@since 23/01/2026
@param cPedido, character, código do pedido de venda
/*/
method removeSolicitacoesPendentesPedido(cPedido as character) class RequestRecipeService
	local aArea      := FWgetArea()      as array
	local cFilialNET := FWxFilial('NET') as character
	local oModelNET                      as object

	DBSelectArea('NET')
	DBSetOrder(retOrder('NET', 'NET_FILIAL+NET_NUMPED'))
	if ! NET->(DBSeek(cFilialNET + cPedido))
		FwRestArea(aArea)
		::setSuccess(I18N(STR0003, {cPedido})) //"Nenhuma solicitação encontrada para o pedido #1[CODIGO_PEDIDO]"
		return
	endIf

	Begin Transaction
		While NET->(!EOF())                         ;
				.And. NET->NET_FILIAL == cFilialNET ;
				.And. NET->NET_NUMPED == cPedido

			if NET->NET_STSSOL == "0" //0=Pendente
				oModelNET := FWLoadModel('AGDA040')
				oModelNET:SetOperation(MODEL_OPERATION_DELETE)

				If ! oModelNET:Activate()             ;
						.or. ! oModelNET:VldData()    ;
						.or. ! oModelNET:CommitData()

					::setErrorByErrorMessageModel(oModelNET)
					disarmTransaction()
					break
				EndIf

				oModelNET:DeActivate()
				oModelNET:Destroy()
				FWFreeObj(oModelNET)
			endIf

			NET->(DBSkip())
		EndDo

		::setSuccess(STR0004) //"Solicitações removidas com sucesso"
	End Transaction

	FwRestArea(aArea)
return


/*/{Protheus.doc} gravarErroSolicitacaoReceita
Grava erro na geração de receita
@type method
@version 12
@author carlos.augusto
@since 30/03/2026
@param cIdSolicitacao, character, chave da solicitação
@param jPayload, json, body da requisição
/*/
method gravarErroSolicitacaoReceita(cIdSolicitacao as character, jPayload as json) class RequestRecipeService
	Local oRepository As Object

	oRepository := RequestRecipeRepository():New(cIdSolicitacao)
	oRepository:gravarErroSolicitacaoReceita(cIdSolicitacao, jPayload)
	Self:setFullResponse(oRepository)
	oRepository:DeActivate()
	FreeObj(oRepository)

Return
