#include "totvs.ch"
#include "tlpp-core.th"

namespace totvs.protheus.agrobusiness.agd  


/*/{Protheus.doc} RequestRecipeItemService
Serviço para gerenciamento de Solicitação de Receita (NET/NEU)
@type class
@version 12
@author lindembergson.pacheco
@since 06/10/2025
/*/
class RequestRecipeItemService FROM UtilsService

	public method New()
	public method listar()
	public method desvinculaReceita()

endclass

/*/{Protheus.doc} New
Constructor
@type method
@version 12
@author lindembergson.pacheco
@since 06/10/2025
@return variant, this
/*/
method New() class RequestRecipeItemService
	_Super:New()
return Self


/*/{Protheus.doc} listar
Busca as os itens de Solicitações de Receita
@type method
@version 12
@author carlos.augusto
@since 04/11/2025
@param nPage, numeric, pagina
@param nPageSize, numeric, tamanho
@param oJsonQryParam, object, param
@return variant, this
/*/
method listar(nPage, nPageSize, oJsonQryParam) class RequestRecipeItemService
	Local oRepository As Object
	Default nPage     := 1
	Default nPageSize := 10
	Default oJsonQryParam := nil

	oRepository := RequestRecipeItemRepository():New()
	oRepository:find(nPage, nPageSize, oJsonQryParam)

	Self:setFullResponse(oRepository)

	oRepository:DeActivate()
	FreeObj(oRepository)
Return nil

/*/{Protheus.doc} RecipeService::desvinculaReceita
Apaga o vincula da tabela NEU com a tabela NE6
@type method
@version P12
@author scheronlini.martins
@since 19/12/2025
@param cChaveID, character, ChaveId da tabela NEU
/*/
method desvinculaReceita(cChaveID as character) class RequestRecipeItemService
	Local oRepository       := RequestRecipeItemRepository():New() as object
	Local aFieldsSaveComand := {}                                  as array

	aadd(aFieldsSaveComand, {"NEU_CODREC", ""})
	aadd(aFieldsSaveComand, {"NEU_SEQREC", ""})

	oRepository:update(aFieldsSaveComand, cChaveID)
	freeObj(oRepository)
return 
