/*/{Protheus.doc} vincularNotaReceita
Vincular Nota Fiscal ao Receituário
@type method
@version P12.1.2610
@author Gilson.Venturi
@since 26/12/2025
@param cCodReceita, character, código da receita vinculada aos itens de pedido de venda(SC9) faturados na NF de saída
@param cNotaFisc, character, número da nota fiscal
@param cSerie, character, série da nota fiscal
@return variant, this
/*/
method vincularNotaReceita(cCodReceita, cNotaFisc, cSerie) class RecipeService
	Local oModel120     as object
	Local oStatement	as object
	Local cCodReceita	AS character
	Local cPedido		AS character
	Local cNumSol   	AS character
	Local cQueryNEU		AS character
	Local cAliQryNEU	AS character

	If TableInDic('NE6')
		DBSelectArea("NE6")
		NE6->(DBSetOrder(1)) //NE6_FILIAL+NE6_CODREC
		NE6->(DBGoTop())
		NE6->(dbSeek(FWxFilial('NE6') + cCodReceita))
		While !NE6->(Eof()) .And. (NE6->(NE6_FILIAL) + NE6_CODREC) == (FWxFilial("NE6") + cCodReceita)

			// Carrega o Model da rotina AGDA120 - Receita Agronômica
			oModel120 := FwLoadModel("AGDA120")
			oModel120:SetOperation(4) //MODEL_OPERATION_UPDATE
			oModel120:Activate()

			oNE6 := oModel120:GetModel("AGDA120_NE6")
			cCodReceita := oNE6:GetValue("NE6_CODREC")
			cPedido     := oNE6:GetValue("NE6_PEDORI")
			oNE6:SetValue("NE6_DOC"  , cNotaFisc)
			oNE6:SetValue("NE6_SERIE", cSerie)
			oNE6:SetValue("NE6_STSNF", '2') //2 - Vinculada

			oModel120:VldData()
			oModel120:CommitData()
			oModel120:DeActivate()
			oModel120:Destroy()
			oModel120 := NIL

			NE6->(DBSkip())
		Enddo
	Endif

	If TableInDic('NEU')
		cAliQryNEU := GetNextAlias()
		cQueryNEU	 := "   SELECT NEU_CODIGO
		cQueryNEU	 += "   FROM " + RetSqlName("NEU") + " NEU "
		cQueryNEU	 += "   WHERE NEU_FILIAL = ? "
		cQueryNEU	 += "   AND NEU_CODREC= ? "
		cQueryNEU	 += "   AND NEU.D_E_L_E_T_ = ' ' "
		cQueryNEU	 := ChangeQuery(cQueryNEU)

		oStatement := FWPreparedStatement():New()
		oStatement:SetQuery(cQueryNEU)
		oStatement := FWPreparedStatement():New()
		oStatement:SetQuery(cQueryNEU)
		oStatement:SetString(1, FWxFilial("NEU"))
		oStatement:SetString(2, cCodReceita)
		cQueryNEU := oStatement:GetFixQuery()

		dbUseArea(.T., "TOPCONN", TCGenQry(,,cQueryNEU), cAliQryNEU, .T., .T.)

		If !(cAliQryNEU)->(EoF())
			cNumSol:= (cAliQryNEU)->NEU_CODIGO
			AGDGRAVAHIS(STR0003,"NET",FwXFilial("NET") + cPedido + cNumSol , STR0004 +cNotaFisc ,.F.,STR0004 +cNotaFisc) //"NF gerada" //"NF Gerada numero " //"NF Gerada numero "
		ENDIF
		(cAliQryNEU)->(DbCloseArea())
	Endif


return nil

/*/{Protheus.doc} desvincularNotaReceita
Desvincular Nota Fiscal do Receituário
@type method
@version P12.1.2610
@author Gilson.Venturi
@since 23/12/2025
@param cNotaFisc, character, número da nota fiscal
@param cSerie, character, série da nota fiscal
@param cCodCli, character, código do cliente
@param cLojCli, character, loja do cliente
@return variant, this
/*/
method desvincularNotaReceita(cNotaFisc, cSerie, cCodCli, cLojCli) class RecipeService
	Local oModel120		as object
	Local oNE6        	as object
	Local oStatement	as object
	Local cQuery		AS character
	Local cAliQryNE6	AS character
	Local cCodReceita	AS character
	Local cPedido		AS character
	Local cNumSol   	AS character
	Local cQueryNEU		AS character
	Local cAliQryNEU	AS character

	If TableInDic('NE6')
		cAliQryNE6 := GetNextAlias()
		cQuery := "   SELECT R_E_C_N_O_ AS NE6_RECNO
		cQuery += "   FROM " + RetSqlName("NE6") + " NE6 "
		cQuery += "   WHERE NE6_FILIAL = ? "
		cQuery += "   AND NE6_DOC = ? "
		cQuery += "   AND NE6_SERIE = ? "
		cQuery += "   AND NE6_CLIENT = ? "
		cQuery += "   AND NE6_LOJA = ? "
		cQuery += "   AND NE6.D_E_L_E_T_ = ' ' "
		cQuery := ChangeQuery(cQuery)

		oStatement := FWPreparedStatement():New()
		oStatement:SetQuery(cQuery)
		oStatement := FWPreparedStatement():New()
		oStatement:SetQuery(cQuery)
		oStatement:SetString(1, FWxFilial("NE6"))
		oStatement:SetString(2, cNotaFisc)
		oStatement:SetString(3, cSerie)
		oStatement:SetString(4, cCodCli)
		oStatement:SetString(5, cLojCli)
		cQuery := oStatement:GetFixQuery()

		dbUseArea(.T., "TOPCONN", TCGenQry(,,cQuery), cAliQryNE6, .T., .T.)

		While !(cAliQryNE6)->(EoF())
			DBSelectArea("NE6")
			NE6->(dbGoTo( (cAliQryNE6)->NE6_RECNO ))
			If NE6->(!EoF()) .AND. NE6->(Recno()) == (cAliQryNE6)->NE6_RECNO
				// Carrega o Model da rotina AGDA120 - Receita Agronômica
				oModel120 := FwLoadModel("AGDA120")
				oModel120:SetOperation(4) //MODEL_OPERATION_UPDATE
				oModel120:Activate()

				oNE6 := oModel120:GetModel("AGDA120_NE6")
				oNE6:SetValue("NE6_DOC"  , '')
				oNE6:SetValue("NE6_SERIE", '')
				oNE6:SetValue("NE6_STSNF", '3') //3 - Desvinculada
				cCodReceita := oNE6:GetValue("NE6_CODREC")
				cPedido     := oNE6:GetValue("NE6_PEDORI")
				If oModel120:VldData()
					oModel120:CommitData()
				EndIf
				oModel120:DeActivate()
				oModel120:Destroy()
				oModel120 := NIL

			EndIf
			(cAliQryNE6)->(DbSkip())
		EndDo
		(cAliQryNE6)->(DbCloseArea())
	Endif

	If TableInDic('NEU')
		cAliQryNEU := GetNextAlias()
		cQueryNEU	 := "   SELECT NEU_CODIGO
		cQueryNEU	 += "   FROM " + RetSqlName("NEU") + " NEU "
		cQueryNEU	 += "   WHERE NEU_FILIAL = ? "
		cQueryNEU	 += "   AND NEU_CODREC= ? "
		cQueryNEU	 += "   AND NEU.D_E_L_E_T_ = ' ' "
		cQueryNEU	 := ChangeQuery(cQueryNEU)

		oStatement := FWPreparedStatement():New()
		oStatement:SetQuery(cQueryNEU)
		oStatement := FWPreparedStatement():New()
		oStatement:SetQuery(cQueryNEU)
		oStatement:SetString(1, FWxFilial("NEU"))
		oStatement:SetString(2, cCodReceita)
		cQueryNEU := oStatement:GetFixQuery()

		dbUseArea(.T., "TOPCONN", TCGenQry(,,cQueryNEU), cAliQryNEU, .T., .T.)

		If !(cAliQryNEU)->(EoF())
			cNumSol:= (cAliQryNEU)->NEU_CODIGO
			AGDGRAVAHIS(STR0005,"NET",FwXFilial("NET") + cPedido + cNumSol  , STR0006 +cNotaFisc ,.F.,STR0006 +cNotaFisc) //"NF Desvinculada" //"NF desvinculada numero " //"NF desvinculada numero
		ENDIF
		(cAliQryNEU)->(DbCloseArea())
	Endif

return nil

