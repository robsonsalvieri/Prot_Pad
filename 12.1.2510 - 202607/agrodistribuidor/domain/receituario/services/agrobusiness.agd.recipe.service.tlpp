/*/{Protheus.doc} RecipeService::GetReceitasByPedidosNF
Retorna array com o codigo da receita e CPF do engenheiro conforme os itens do pedido de venda (SC9) vinculados a nota fiscal de saída
@type method
@version p12
@author scheronlini.martins
@since 31/10/2025
@param nRecnoSF2, numeric, recno da Nota Fiscal de saida
@return array, lista de codigo da receita e CPF do engenheiro
/*/
Method GetReceitasByPedidosNF(nRecnoSF2) Class RecipeService
	Local cAliQry    	:= GetNextAlias()
	Local cQuery     	:= ""
	Local oStatement 	:= nil
	Local aDadosReceita	:= {}
	Local aParamsQry   	:= {}
	Local nX 			:= 0
	Local aAreaSF2  	:= SF2->(GetArea())

	DbSelectArea("SF2")
	DbGoTo(nRecnoSF2) //posiciona no registro da nota fiscal

	If EoF()
		Return {}
	EndIf

	// ------------------------------------------------------------------
	// 3. Monta query para buscar dados da receita
	// ------------------------------------------------------------------
	cQuery := ""
	cQuery += " SELECT DISTINCT "
	cQuery += "   NE6.NE6_NUMREC, "
	cQuery += "   NP8.NP8_CPF, "
	cQuery += "   NE6.NE6_CODREC "
	cQuery += " FROM " + RetSqlName("SC9") + " SC9 "
	cQuery += " INNER JOIN " + RetSqlName("NEU") + " NEU "
	cQuery += "   ON NEU.NEU_FILIAL = ? " ; aAdd(aParamsQry, FwXFilial("NEU"))
	cQuery += "  AND NEU.NEU_NUMPED = SC9.C9_PEDIDO "
	cQuery += "  AND NEU.NEU_ITEMPE = SC9.C9_ITEM "
	cQuery += "  AND NEU.NEU_SEQLIB = SC9.C9_SEQUEN "
	cQuery += "  AND NEU.NEU_PRODUT = SC9.C9_PRODUTO "
	cQuery += "  AND NEU.D_E_L_E_T_ = ' ' "
	cQuery += " INNER JOIN " + RetSqlName("NET") + " NET "
	cQuery += "   ON NET.NET_FILIAL = ? " ; aAdd(aParamsQry, FwXFilial("NET"))
	cQuery += "  AND NET.NET_NUMPED = SC9.C9_PEDIDO "
	cQuery += "  AND NET.NET_CLIENT = SC9.C9_CLIENTE "
	cQuery += "  AND NET.NET_LOJA = SC9.C9_LOJA "
	cQuery += "  AND NET.NET_CODIGO = NEU.NEU_CODIGO "
	cQuery += "  AND NET.D_E_L_E_T_ = ' ' "
	cQuery += " INNER JOIN " + RetSqlName("NP8") + " NP8 "
	cQuery += "   ON NP8.NP8_FILIAL = ? " ; aAdd(aParamsQry, FwXFilial("NP8"))
	cQuery += "  AND NP8.NP8_CODIGO = NET.NET_CODENG "
	cQuery += "  AND NP8.D_E_L_E_T_ = ' ' "
	cQuery += " INNER JOIN " + RetSqlName("NE6") + " NE6 "
	cQuery += "   ON NE6.NE6_FILIAL = ? " ; aAdd(aParamsQry, FwXFilial("NE6"))
	cQuery += "  AND NE6.NE6_CODREC = NEU.NEU_CODREC "
	cQuery += "  AND NE6.NE6_PEDORI = NEU.NEU_NUMPED "
	cQuery += "  AND NE6.D_E_L_E_T_ = ' ' "
	cQuery += " WHERE SC9.C9_FILIAL = ? " ; aAdd(aParamsQry, FwXFilial("SC9"))
	cQuery += "   AND SC9.C9_NFISCAL = ? " ; aAdd(aParamsQry, SF2->F2_DOC)
	cQuery += "   AND SC9.C9_SERIENF = ? " ; aAdd(aParamsQry, SF2->F2_SERIE)
	cQuery += "   AND SC9.C9_CLIENTE = ? " ; aAdd(aParamsQry, SF2->F2_CLIENTE)
	cQuery += "   AND SC9.C9_LOJA = ? " 	; aAdd(aParamsQry, SF2->F2_LOJA)
	cQuery += "   AND SC9.D_E_L_E_T_ = ' ' "
	cQuery := ChangeQuery(cQuery)

	oStatement := FWPreparedStatement():New()
	oStatement:SetQuery(cQuery)
	aEval(aParamsQry, {|cValue| (nX++, oStatement:SetString(nX, cValue))})
	cQuery := oStatement:GetFixQuery()

	dbUseArea(.T., "TOPCONN", TCGenQry(,,cQuery), cAliQry, .T., .T.)

	// ------------------------------------------------------------------
	// 4. Monta array de retorno com número da receita + CPF do engenheiro + codigo da receita
	// ------------------------------------------------------------------
	While !(cAliQry)->(EoF())
		AAdd(aDadosReceita, { AllTrim((cAliQry)->NE6_NUMREC), AllTrim((cAliQry)->NP8_CPF), AllTrim((cAliQry)->NE6_CODREC) })
		(cAliQry)->(DbSkip())
	EndDo
	(cAliQry)->(DbCloseArea())

	RestArea(aAreaSF2)

Return aDadosReceita

/*/{Protheus.doc} RecipeService::insertReceita
Insere dados da Receita na tabela NES
@type method
@version P12
@author scheronlini.martins
@since 04/11/2025
@param nRecnoSF2, numeric, recno da Nota de saida
@return variant, return_.t.
/*/
Method insertReceita(nRecnoSF2) Class RecipeService
	Local aDadosReceita := Self:GetReceitasByPedidosNF(nRecnoSF2)
	Local oRepository   := RecipeRepository():New()
	Local oJson         := Nil
	Local aItems        := {}
	Local n             := 1

	oJson   := JsonObject():New()

	For n := 1 To Len(aDadosReceita)
		AAdd(aItems, JsonObject():New())
		aItems[n]["tipoVinculo"]   := '1'
		aItems[n]["item"]          := StrZero(n, TamSX3("NES_ITEM")[1])
		aItems[n]["numReceita"]    := aDadosReceita[n][1]
		aItems[n]["cpfEngenheiro"] := aDadosReceita[n][2]
	Next

	oJson["filial"]    := FwXFilial("NES")
	oJson["documento"] := SF2->F2_DOC
	oJson["serie"]     := SF2->F2_SERIE
	oJson["cliente"]   := SF2->F2_CLIENTE
	oJson["loja"]      := SF2->F2_LOJA
	oJson["items"]     := aItems

	oRepository:saveDadosReceitas(oJson)

return .T.

