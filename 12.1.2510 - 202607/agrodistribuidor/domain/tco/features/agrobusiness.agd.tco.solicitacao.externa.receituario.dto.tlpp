/*/{Protheus.doc} getAdapter
Lista de Adapters
@type method
@version 12
@author Gilson.Venturi
@since 10/10/2025
@return variant, retorno
/*/
Method getAdapter() Class TCOSolicitacaoExternaReceituarioDTO
	Local arrayReturn := {}

	AAdd(arrayReturn, FeatUtilsService():buildAdapters("AGDP010", "AGDP010", "", "1", "01 - Local de Descarte de Embalagem")) 
	AAdd(arrayReturn, FeatUtilsService():buildAdapters("AGDP060", "AGDP060", "", "2", "02 - Produtor e Fazenda" )) 
	AAdd(arrayReturn, FeatUtilsService():buildAdapters("CRMA980", "CUSTOMERVENDOR", "AGDXREC()", "3", "03 - Produtor e Fazenda via Cadastro de Clientes", "2.000"))
	AAdd(arrayReturn, FeatUtilsService():buildAdapters("AGRA830", "AGRA830", "", "4", "04 - Responsável Técnico")) 
	AAdd(arrayReturn, FeatUtilsService():buildAdapters("MATA010", "ITEM"   , "NCR->NCR_EMREC = '1' .AND. !EMPTY(NCR->NCR_MAPA) .AND. EMPTY(NCR->NCR_PRATIV)", "5", "05 - Produtos" , "4.013")) 
	AAdd(arrayReturn, FeatUtilsService():buildAdapters("AGDA040", "AGDA040", "AGDXREC()", "6", "06 - Solicitação de Receita")) 
	AAdd(arrayReturn, FeatUtilsService():buildAdapters("AGDA120", "AGDA120", "AGDXREC()", "7", "07 - Nota Fiscal")) 

Return arrayReturn

/*/{Protheus.doc} getCheckAtivacao
Checagem de Ativação da Feature - Uso na seleção do WIZARD
@type method
@version 12
@author jean.schulze
@since 12/19/2025
@return variant, Array com os Erros/Impedimentos da Feature
/*/
Method getCheckAtivacao() Class TCOSolicitacaoExternaReceituarioDTO
Return {}

/*/{Protheus.doc} getCheckFinalizacao
Checagem de Finalização da Feature - Uso no finalizar da Configuração
@type method
@version 12
@author jean.schulze
@since 12/19/2025
@return variant, 5
@return variant, Array com os Erros/Impedimentos da Feature
/*/
Method getCheckFinalizacao() Class TCOSolicitacaoExternaReceituarioDTO
	Local aErros :={} as array

	// Valida se existe produto configurado para emitir receita
	If !Self:hasProdutoReceita()
		aadd(aErros, FeatUtilsService():setError(STR0002, "MODULO")) //"É necessário possuir ao menos 1 produto configurado para emitir receita."
	EndIf

	// Valida se existe responsável técnico cadastrado
	If !Self:hasRespTecnico()
		aadd(aErros, FeatUtilsService():setError(STR0003, "MODULO")) //"É necessário possuir ao menos 1 responsável técnico cadastrado."
	EndIf

	// Valida se existe ao menos um registro no configurador de receita
	If !Self:checkConfigReceita()
		aadd(aErros, FeatUtilsService():setError(STR0004, "MODULO")) //"É necessário possuir ao menos 1 registro no configurador de receita."
	EndIf

Return aErros

/*/{Protheus.doc} hasProdutoReceita
Valida se existe ao menos um produto configurado para emitir receita.
@type  method
@version 1.0
@author rodrigo.nsoledade
@since  16/03/2026
@return logical, indica se existe produto configurado para emitir receita
/*/
Method hasProdutoReceita() Class TCOSolicitacaoExternaReceituarioDTO
	Local cQueryNCR   as character
	Local oStatement  as object
	Local nQtde       as numeric

	cQueryNCR := " SELECT COUNT(*) AS QTDE "
	cQueryNCR += " FROM " + RetSQLName("NCR") + " NCR "
	cQueryNCR += " WHERE " + RetSqlCond("NCR")
	cQueryNCR += " AND NCR_EMREC = '1' "
	cQueryNCR += " AND NCR_MAPA <> '' "

	cQueryNCR := ChangeQuery(cQueryNCR)

	oStatement := FWPreparedStatement():New()
	oStatement:SetQuery(cQueryNCR)
	cQueryNCR := oStatement:GetFixQuery()

	nQtde := MpSysExecScalar(cQueryNCR, "QTDE")

Return (nQtde > 0)

/*/{Protheus.doc} hasRespTecnico
Valida se existe ao menos um responsável técnico cadastrado.
@type  method
@version 1.0
@author rodrigo.nsoledade
@since  16/03/2026
@return logical, indica se existe responsável técnico cadastrado
/*/
Method hasRespTecnico() Class TCOSolicitacaoExternaReceituarioDTO
	Local cQueryNP8   as character
	Local oStatement  as object
	Local nQtde       as numeric

	cQueryNP8 := " SELECT COUNT(*) AS QTDE "
	cQueryNP8 += " FROM " + RetSQLName("NP8") + " NP8 "
	cQueryNP8 += " WHERE " + RetSqlCond("NP8")

	cQueryNP8 := ChangeQuery(cQueryNP8)

	oStatement := FWPreparedStatement():New()
	oStatement:SetQuery(cQueryNP8)
	cQueryNP8 := oStatement:GetFixQuery()

	nQtde := MpSysExecScalar(cQueryNP8, "QTDE")

Return (nQtde > 0)

/*/{Protheus.doc} checkConfigReceita
Valida se existe ao menos um registro no configurador de receita (NEY).
@type  method
@version 1.0
@author rodrigo.nsoledade
@since  16/03/2026
@return logical, indica se existe configuração de receita cadastrada
/*/
Method checkConfigReceita() Class TCOSolicitacaoExternaReceituarioDTO
	Local cQueryNEY   as character
	Local oStatement  as object
	Local nQtde       as numeric

	// Monta query
	cQueryNEY := " SELECT COUNT(*) AS QTDE "
	cQueryNEY += " FROM " + RetSQLName("NEY") + " NEY "
	cQueryNEY += " WHERE " + RetSqlCond("NEY")

	cQueryNEY := ChangeQuery(cQueryNEY)

	oStatement := FWPreparedStatement():New()
	oStatement:SetQuery(cQueryNEY)
	cQueryNEY := oStatement:GetFixQuery()

	nQtde := MpSysExecScalar(cQueryNEY, "QTDE")

Return (nQtde > 0)


/*/{Protheus.doc} getAllExternalIds
Retorna todas as listas de Ids Externos para o De-Para disponíveis para a feature.
@type method
@version 12
@author  felipe.savelar
@since 23/03/2026
@return json, listas de Ids Externos para o De-Para.
*/
Method getAllExternalIds() as json Class TCOSolicitacaoExternaReceituarioDTO
	local jListExternalIds := JsonObject():New() as json
	jListExternalIds['TES'] := ::getExternalIdTES()
Return jListExternalIds



/*/{Protheus.doc} getExternalIdTES
Retorna a lista de Ids Externos de "De-Para" para Tipos de Entrada e Saída (TES).
@type method
@version 12
@author  felipe.savelar
@since 23/03/2026
@return json, lista ids externos 
*/
Method getExternalIdTES() as json Class TCOSolicitacaoExternaReceituarioDTO
	Local externalIdTES as json

	externalIdTES := {;
		{"chave": "AS"                , "valor": STR0005 /*"Ajuste de Saldo "*/  },;
		{"chave": "CO"                , "valor": STR0006 /*"Compra"*/            },;
		{"chave": "TR"                , "valor": STR0007 /*"Transferência "*/    },;
		{"chave": "DE"                , "valor": STR0008 /*"Devolução"*/         },;
		{"chave": "CE"                , "valor": STR0009 /*"Correção Estoque "*/ },;
		{"chave": "VE"                , "valor": STR0010 /*"Venda "*/            },;
		{"chave": "US"                , "valor": STR0011 /*"Uso"*/               };
		}

Return externalIdTES
