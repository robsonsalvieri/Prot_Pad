/*/{Protheus.doc} getTabelasDePara
Retorna a Lista de Tabelas e Campos disponiveis para realizar o de-para
@type method
@version 12
@author jean.schulze
@since 31/10/2025
@return array, lista de tabela e campo
/*/
Method getTabelasDePara() as array Class TCOSolicitacaoExternaReceituarioDTO
	Local arrayReturn := {} /*2 Posicoes: 1-Tabela, 2-Campo*/
	
    AAdd(arrayReturn, FeatUtilsService():buildTabelaDePara('NEO', 'NEO_CODIGO'))
    AAdd(arrayReturn, FeatUtilsService():buildTabelaDePara('SA1', 'A1_COD'))
    AAdd(arrayReturn, FeatUtilsService():buildTabelaDePara('NEP', 'NEP_CODCLI', STR0012))
    AAdd(arrayReturn, FeatUtilsService():buildTabelaDePara('NP8', 'NP8_CODIGO'))
	AAdd(arrayReturn, FeatUtilsService():buildTabelaDePara('SB1', 'B1_COD', STR0013))
	AAdd(arrayReturn, FeatUtilsService():buildTabelaDePara('NP3', 'NP3_CODIGO'))
	AAdd(arrayReturn, FeatUtilsService():buildTabelaDePara('NET', 'NET_CODIGO'))
	AAdd(arrayReturn, FeatUtilsService():buildTabelaDePara('SF4', 'F4_CODIGO'))

return arrayReturn 

