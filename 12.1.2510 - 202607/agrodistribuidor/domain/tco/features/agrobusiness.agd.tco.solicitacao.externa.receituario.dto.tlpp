/*/{Protheus.doc} getParametros
Lista de Parâmetros
@type method
@version 12
@author jean.schulze
@since 26/09/2025
@return variant, retorno
/*/
Method getParametros() Class TCOSolicitacaoExternaReceituarioDTO
	Local arrayReturn := {}

	// Reaproveita receita
	AAdd(arrayReturn, FeatUtilsService():buildParametros("MV_AGD0006", {;
		FeatUtilsService():buildOptions(".T.", "Sim"),;
		FeatUtilsService():buildOptions(".F.", "Não") }))

	// Permite marcar todos os itens para gerar receitas no MATA460A
	AAdd(arrayReturn, FeatUtilsService():buildParametros("MV_AGD0007", {;
		FeatUtilsService():buildOptions(".T.", "Sim"),;
		FeatUtilsService():buildOptions(".F.", "Não") }))
	
Return arrayReturn

