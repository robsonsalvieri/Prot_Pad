#Include "TLPP-CORE.TH"
#Include "TOTVS.CH"

namespace totvs.protheus.agrobusiness.agd  

/*/{Protheus.doc} FeatureTCOEnum
Classe para Listar as Features do TCO no produto
@type class
@version 12
@author jean.schulze
@since 13/11/2025
/*/
Class FeatureTCOEnum
	Static Method enums() as Array
    Static Method getById() as Character
EndClass

/*/{Protheus.doc} enums
Lista fixa das Tools
@type method
@version 12
@author jean.schulze
@since 13/11/2025
@return array, dados
/*/
Method enums() as Array Class FeatureTCOEnum
return valuesEnums()

/*/{Protheus.doc} getById
Retorna a tool conforme o id
@type method
@version 12
@author jean.schulze
@since 13/11/2025
@param id, variant, identificao
@return character, classe da tool
/*/
Method getById(cId) as Character Class FeatureTCOEnum
	Local ret as Character

    nPos := AScan(valuesEnums(),{|x| x[1] == Upper(Alltrim(cId)) })
    if nPos > 0 
        ret := valuesEnums()[nPos][2]
    end

return ret

/*/{Protheus.doc} valuesEnums
Lista com valores do Enum
@type function
@version 12
@author jean.schulze
@since 14/11/2025
@return array, {{cCodigoTool, cClasseTool}, ...}
/*/
Static Function valuesEnums() as array
	Local aEnums := {} as array

	AAdd(aEnums, {"BARTER"                        , "TCOBarterDTO()"                       })
	AAdd(aEnums, {"ORIGINACAO_PROTHEUS"           , "TCOOriginacaoProtheusDTO()"           })
	AAdd(aEnums, {"RECEITUARIO"                   , "TCOReceituarioDTO()"                  })
	AAdd(aEnums, {"INTEGRACAO_COMERCIALIZACAO_TACC", "TCOComercializacaoTACDTO()"           })
	AAdd(aEnums, {"DTA"                           , "TCODTADTO()"                          })
	AAdd(aEnums, {"INTEGRACAO_RECEITUARIO"        , "TCOSolicitacaoExternaReceituarioDTO()"})
	AAdd(aEnums, {"INTEGRACAO_TBDC"               , "TCOTBDCDTO()"})

return aEnums
