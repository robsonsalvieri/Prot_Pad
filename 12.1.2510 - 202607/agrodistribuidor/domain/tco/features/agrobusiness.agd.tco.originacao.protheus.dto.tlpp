/*/{Protheus.doc} getCheckAtivacao
Checagem de Ativação da Feature - Uso na seleção do WIZARD
@type method
@version 12
@author jean.schulze
@since 12/19/2025
@return variant, Array com os Erros/Impedimentos da Feature
/*/
Method getCheckAtivacao() Class TCOOriginacaoProtheusDTO
Return {}

/*/{Protheus.doc} getCheckFinalizacao
Checagem de Finalização da Feature - Uso no finalizar da Configuração
@type method
@version 12
@author jean.schulze
@since 12/19/2025
@return variant, 5
@return variant, Array com os Erros/Impedimentos da Feature
/*/
Method getCheckFinalizacao() Class TCOOriginacaoProtheusDTO
	Local aErros := {}
	Local oTcoRepo := nil
	
	//Verifica se o barter está ativo
	oTcoRepo := TCORepository():new()
	if !oTcoRepo:isFeatureActive("BARTER")
		aadd(aErros, FeatUtilsService():setError(STR0012, "MODULO"))
	endif

	FreeObj(oTcoRepo)
Return aErros
