/*/{Protheus.doc} getParametros
Lista de Parâmetros
@type method
@version 12
@author jean.schulze
@since 26/09/2025
@return variant, {{cCodigoParam, xConteudoEsperado, arrJsonValoresPossiveis}, ...}
/*/
Method getParametros() as array Class TCOBarterDTO
	Local aParams := {}
		
	aadd(aParams, FeatUtilsService():buildParametros("MV_AGD0001", {;
				FeatUtilsService():buildOptions("1", STR0004),; // "Médio"
				FeatUtilsService():buildOptions("2", STR0005),; // "Unit FIFO"
				FeatUtilsService():buildOptions("3", STR0006),; // "Reposição"
				FeatUtilsService():buildOptions("4", STR0007)  })) // "Standard"

	aadd(aParams, FeatUtilsService():buildParametros("MV_AGD0002", {;
				FeatUtilsService():buildOptions("1", STR0008),; // "Nenhuma Ação" 
				FeatUtilsService():buildOptions("2", STR0009)  })) // "Força Lib. Crédito"
	
	// Acao de como proceder quando o Pedido de Venda estiver bloqueado
	aadd(aParams, FeatUtilsService():buildParametros("MV_AGDCTCC", {; 
				FeatUtilsService():buildOptions(".T.", STR0014),; // "Obrigatória"
				FeatUtilsService():buildOptions(".F.", STR0015)  })) // "Opcional"		

	aadd(aParams, FeatUtilsService():buildParametros("MV_AGD0003",  {;
				FeatUtilsService():buildOptions("1", STR0010),; // "Não Arredonda"
				FeatUtilsService():buildOptions("2", STR0011),; // "p/Cima"
				FeatUtilsService():buildOptions("3", STR0012),; // "p/Baixo"
				FeatUtilsService():buildOptions("4", STR0013)  })) // "Aritmético"	

	// Utiliza o Módulo SIGAAGR para Gestão de Contratos do Módulo SIGAAGD                                 
	aadd(aParams, FeatUtilsService():buildParametros("MV_AGDCTOG",{;                  
			FeatUtilsService():buildOptions(".T.", STR0016 ),; // "Sim"
			FeatUtilsService():buildOptions(".F.", STR0017 )}, "", .T., .F.)) // "Não"	

	// Determina os cadastros complementares que serão apresentados no cadastro de produto        
	aadd(aParams, FeatUtilsService():buildParametros("MV_CADPROD", {}, "AGRO", .T., .F.)) // "Complemento Produtos Agronegócio"
	
Return aParams

/*/{Protheus.doc} getCadastrosBasicos
Lista de Cadastros Básicos
@type method
@version 12
@author jean.schulze
@since 26/09/2025
@return array, {{cCodigoRotina, cTabelaBase}, ...}
/*/
Method getCadastrosBasicos() as array Class TCOBarterDTO
	Local arrayReturn := {}

	AAdd(arrayReturn, FeatUtilsService():buildCadastros("CRMA980",  "SA1" ))  // Clientes               
	AAdd(arrayReturn, FeatUtilsService():buildCadastros("MATA020",  "SA2" ))  // Fornecedores           
	AAdd(arrayReturn, FeatUtilsService():buildCadastros("MATA010",  "SB1" ))  // Produtos               
	AAdd(arrayReturn, FeatUtilsService():buildCadastros("MATA050",  "SA4" ))  // Transportadoras        
	AAdd(arrayReturn, FeatUtilsService():buildCadastros("MATA360",  "SE4" ))  // Condição de pagamento  
	AAdd(arrayReturn, FeatUtilsService():buildCadastros("FINA010",  "SED" ))  // Naturezas              
	AAdd(arrayReturn, FeatUtilsService():buildCadastros("MATA090",  "SM2" ))  // Moedas                 
	AAdd(arrayReturn, FeatUtilsService():buildCadastros("OMSA010",  "DA0" ))  // Tabela de preço                 
	AAdd(arrayReturn, FeatUtilsService():buildCadastros("QIEA030",  "SAH" ))  // Unidade de Medidas      
	AAdd(arrayReturn, FeatUtilsService():buildCadastros("ESTA0001", "D3Q" ))  // Conversao de Medidas      
	AAdd(arrayReturn, FeatUtilsService():buildCadastros("MATA080",  "SF4" ))  // Tes      
	AAdd(arrayReturn, FeatUtilsService():buildCadastros("MATA089",  "SFM" ))  // Tes Inteligente     
	AAdd(arrayReturn, FeatUtilsService():buildCadastros("MATA040",  "SA3" ))  // Vendedores       
	AAdd(arrayReturn, FeatUtilsService():buildCadastros("MATA035",  "SBM" ))  // Grupo de Produtos    
	AAdd(arrayReturn, FeatUtilsService():buildCadastros("OGA100" ,  "NJU" ))  // Safra   
	AAdd(arrayReturn, FeatUtilsService():buildCadastros("OGA010",   "NJ0" ))  // Entidades    
	AAdd(arrayReturn, FeatUtilsService():buildCadastros("AGDP040",  "NEG" ))  // Programa de Paridade
	AAdd(arrayReturn, FeatUtilsService():buildCadastros("OMSA060",  "DA3" ))  // Veiculos      
	AAdd(arrayReturn, FeatUtilsService():buildCadastros("AGRA800",  "NP3" ))  // Cultura     
	AAdd(arrayReturn, FeatUtilsService():buildCadastros("CFGX019",  "SM4" ))  // Formulas   
	AAdd(arrayReturn, FeatUtilsService():buildCadastros("AGRA045",  "NNR" ))  // Local (Armazem)

Return arrayReturn

/*/{Protheus.doc} getCompartilhamentoTabela
Lista de Compartilhamento de tabelas
@type method
@version 12
@author jean.schulze
@since 26/09/2025
@return variant, retorno
/*/
Method getCompartilhamentoTabela() Class TCOBarterDTO
	Local arrayReturn := {}
	Local cCompart:= FWModeAccess("NEA")

    AAdd(arrayReturn, {'NEA', cCompart}) //Negociação
	AAdd(arrayReturn, {'NEB', cCompart}) //Insumos da Negociacao         
	AAdd(arrayReturn, {'NEE', cCompart}) // Dados Contrato da Negociação
	AAdd(arrayReturn, {'NEF', cCompart}) // Negociação Contratos Compra
	AAdd(arrayReturn, {'NEG', cCompart}) // Programa de Paridade
	AAdd(arrayReturn, {'NEH', cCompart}) // Itens Programa de Paridade
	AAdd(arrayReturn, {'NEI', cCompart}) // Movimentos Contrato Compra
	AAdd(arrayReturn, {'NEJ', cCompart}) // Fechamento Financeiro Negociação
	AAdd(arrayReturn, {'NEK', cCompart}) // Itens Fechamento Financeiro
	AAdd(arrayReturn, {'NEL', cCompart}) // Venda Perdida da Negociação
	AAdd(arrayReturn, {'NEM', cCompart}) // Rateio de Entregas Negociação
	AAdd(arrayReturn, {'NEO', cCompart}) // Descarte de Embalagens
	AAdd(arrayReturn, {'NEP', cCompart}) // Propriedade Rural
	AAdd(arrayReturn, {'NEQ', cCompart}) // Pedido X Agrodistribuidor
	AAdd(arrayReturn, {'NEV', cCompart}) // Grupo Familiar
	AAdd(arrayReturn, {'NEX', cCompart}) // Clientes do Grupo Familiar
	AAdd(arrayReturn, {'NEN', cCompart}) // Impostos Retidos e Recolhidos

	AAdd(arrayReturn, {'NED', 'E'}) // Itens da Instrução de Embarque
	AAdd(arrayReturn, {'NEC', 'E'}) //Instrução de Embarque         
	

Return arrayReturn

