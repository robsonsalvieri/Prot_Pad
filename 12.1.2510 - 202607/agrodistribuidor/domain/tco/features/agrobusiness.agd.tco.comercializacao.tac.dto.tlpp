/*/{Protheus.doc} getAdapter
Lista de Adapters - Tabela XX4
@type method
@version 12
@author Gilson.Venturi
@since 10/10/2025
@return array, {{cRotina, cModelo}, ...}
/*/
Method getAdapter() as array Class TCOComercializacaoTACDTO
	Local arrayReturn := {}
		
	AAdd(arrayReturn, FeatUtilsService():buildAdapters("APCFG230", "BRANCH", "", "1", "01 - Unidade Organizacional (Filial)", "2.003"))
	AAdd(arrayReturn, FeatUtilsService():buildAdapters("AGRA045", "WAREHOUSE", "", "2", "02 - Armazém (Local de Estoque)", "1.002"))
	AAdd(arrayReturn, FeatUtilsService():buildAdapters("MATA035" , "FAMILY", "", "3", "03 - Família (Grupo de Produtos)", "2.002"))
	AAdd(arrayReturn, FeatUtilsService():buildAdapters("MATA010", "ITEM", "", "4", "04 - Produto", "4.013"))
	AAdd(arrayReturn, FeatUtilsService():buildAdapters("CRMA980" , "CUSTOMERVENDOR", "", "5", "05 - Cliente / Fornecedor", "2.005"))
	AAdd(arrayReturn, FeatUtilsService():buildAdapters("MATA020" , "CUSTOMERVENDOR", "", "5", "05 - Cliente / Fornecedor", "2.003"))
	AAdd(arrayReturn, FeatUtilsService():buildAdapters("MATA050" , "CARRIERS", "", "6", "06 - Transportadora"))
	AAdd(arrayReturn, FeatUtilsService():buildAdapters("MATA103B", "INVOICE", "AGDXTACC('DOC_ENTRADA')", "7", "07 - Documento Recebimento", "4.000"))
	AAdd(arrayReturn, FeatUtilsService():buildAdapters("MATA461", "MATA461", "AGDXTACC('DOC_SAIDA')", "8", "08 - Documento Expedição", "4.001"))
	AAdd(arrayReturn, FeatUtilsService():buildAdapters("AGDA030", "AGDA030", "", "9", "09 - Barter - Negociação de Compra"))

Return arrayReturn


