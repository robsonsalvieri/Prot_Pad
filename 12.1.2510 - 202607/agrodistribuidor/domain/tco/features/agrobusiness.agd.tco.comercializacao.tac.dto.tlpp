/*/{Protheus.doc} getTabelasDePara
Retorna a Lista de Tabelas e Campos disponiveis para realizar o de-para
@type method
@version 12
@author jean.schulze
@since 31/10/2025
@return array, lista de tabela e campo {{cTabela, cCampo}, ...}
/*/
Method getTabelasDePara() as array Class TCOComercializacaoTACDTO
	Local aTabelasDePara as array

	aTabelasDePara := {;
		FeatUtilsService():buildTabelaDePara("SA1", "A1_COD"    ),; // Clientes
		FeatUtilsService():buildTabelaDePara("SA2", "A2_COD"    ),; // Fornecedores
		FeatUtilsService():buildTabelaDePara("SB1", "B1_COD", STR0021 ),; // Descrição Genérica do Produto
		FeatUtilsService():buildTabelaDePara("SBM", "BM_GRUPO"  ),; // Grupo de Produto
		FeatUtilsService():buildTabelaDePara("SF4", "F4_CODIGO" ),; // Tipos de Entrada e Saida
		FeatUtilsService():buildTabelaDePara("SA4", "A4_COD"    ),; // Transportadoras
		FeatUtilsService():buildTabelaDePara("NNR", "NNR_CODIGO") ; // Armazens Estoques
		}

return aTabelasDePara

