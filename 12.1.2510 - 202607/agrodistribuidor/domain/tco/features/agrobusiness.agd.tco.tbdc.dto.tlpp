/*/{Protheus.doc} getAdapter
Lista de Adapters
@type method
@version 12
@author Gilson.Venturi
@since 10/10/2025
@return variant, retorno
/*/
Method getAdapter() Class TCOTBDCDTO
	Local arrayReturn := {}
		

	AAdd(arrayReturn, FeatUtilsService():buildAdapters("AGRA045", "WAREHOUSE", "AGDXTBDC()", "1", "01 - Local de Estoque", "1.002"))
	AAdd(arrayReturn, FeatUtilsService():buildAdapters("MATA360", "PAYMENTCONDITION", "", "2", "02 - Condição de Pagamento", "2.000"))
	AAdd(arrayReturn, FeatUtilsService():buildAdapters("MATA010", "ITEM" , "AGDXTBDC()", "3", "03 - Produtos", "4.000"))
	AAdd(arrayReturn, FeatUtilsService():buildAdapters("MATA225", "STOCKLEVEL", "AGDXTBDC()", "4", "04 - Saldo de Estoque", "3.003"))
	AAdd(arrayReturn, FeatUtilsService():buildAdapters("QIEA030", "UNITOFMEASURE", "", "5", "05 - Unidade de Medida", "2.002"))
	AAdd(arrayReturn, FeatUtilsService():buildAdapters("AGRA800", "AGRICULTURALCULTURE", "", "6", "06 - Cultura", "2.000"))
	AAdd(arrayReturn, FeatUtilsService():buildAdapters("MATA035", "FAMILY", "", "7", "07 - Grupo de Produto", "2.002"))
	AAdd(arrayReturn, FeatUtilsService():buildAdapters("AGDP060", "AGDP060", "AGDXTBDC()", "8", "08 - Cliente e Fazenda"))
	AAdd(arrayReturn, FeatUtilsService():buildAdapters("OGA100" , "AGRICULTURALYEAR", "AGDXTBDC()", "9", "09 - Safra", "1.002"))
	AAdd(arrayReturn, FeatUtilsService():buildAdapters("AGDP110", "AGDP110", "", "10", "10 - Tabela de Preço"))
	AAdd(arrayReturn, FeatUtilsService():buildAdapters("OMSA010", "PRICELISTHEADERITEM", "AGDXTBDC()", "10", "10 - Tabela de Preço", "2.001"))
	AAdd(arrayReturn, FeatUtilsService():buildAdapters("CRMA980", "CUSTOMERVENDOR", "AGDXTBDC()", "11", "11 - Cliente", "2.000"))
	AAdd(arrayReturn, FeatUtilsService():buildAdapters("APCFG230", "BRANCH", "", "12", "12 - Filial", "2.003"))
	AAdd(arrayReturn, FeatUtilsService():buildAdapters("MATA410B", "DOCUMENTTRACEABILITYORDER", "RTRIM(SC5->C5_ORIGEM) = 'MSGEAI'", "14", "14 - Status Pedido de Vendas"))

Return arrayReturn

