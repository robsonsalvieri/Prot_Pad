/*/{Protheus.doc} getTabelasDePara
Retorna a Lista de Tabelas e Campos disponiveis para realizar o de-para
@type method
@version 12
@author jean.schulze
@since 31/10/2025
@return array, lista de tabela e campo
/*/
Method getTabelasDePara() as array Class TCOTBDCDTO
	Local arrayReturn := {} /*2 Posicoes: 1-Tabela, 2-Campo*/

    AAdd(arrayReturn, FeatUtilsService():buildTabelaDePara('SA1', 'A1_COD'))
    AAdd(arrayReturn, FeatUtilsService():buildTabelaDePara('NEP', 'NEP_CODCLI', STR0002))
	AAdd(arrayReturn, FeatUtilsService():buildTabelaDePara('SB1', 'B1_COD', STR0003))
	AAdd(arrayReturn, FeatUtilsService():buildTabelaDePara('NP3', 'NP3_CODIGO'))
	AAdd(arrayReturn, FeatUtilsService():buildTabelaDePara('NJU', 'NJU_CODSAF'))
	AAdd(arrayReturn, FeatUtilsService():buildTabelaDePara('SE4', 'E4_CODIGO'))
	AAdd(arrayReturn, FeatUtilsService():buildTabelaDePara('SBM', 'BM_GRUPO'))
	AAdd(arrayReturn, FeatUtilsService():buildTabelaDePara('DA0', 'DA0_CODTAB', STR0004))
	AAdd(arrayReturn, FeatUtilsService():buildTabelaDePara('SAH', 'AH_UNIMED'))
	AAdd(arrayReturn, FeatUtilsService():buildTabelaDePara('NNR', 'NNR_CODIGO'))
	AAdd(arrayReturn, FeatUtilsService():buildTabelaDePara('SB2', 'B2_LOCAL'))
	AAdd(arrayReturn, FeatUtilsService():buildTabelaDePara('SB5', 'B5_COD', STR0005))
	AAdd(arrayReturn, FeatUtilsService():buildTabelaDePara('DA1', 'DA1_CODTAB', STR0006))
	AAdd(arrayReturn, FeatUtilsService():buildTabelaDePara('XX8', 'XX8_CODIGO', STR0007))
return arrayReturn 

