#include 'totvs.ch'
#include 'tlpp-core.th'
#include 'fwmvcdef.ch'

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} TCOFromtoStorageRepository
Repositorio do TCO de-para para Armazem
@type class
@version 12
@author lindembergson.pacheco
@since 24/04/2026
/*/
class TCOFromtoStorageRepository from UtilsRepository
	public data cChaveIDRepository as character

	public method new()
	public method getFields()		as array

	public method findStorage()     as array

endclass

/*/{Protheus.doc} TCOFromtoStorageRepository::new
Constructor
@type method
@version 12
@author lindembergson.pacheco
@since 24/04/2026
@param pcChaveIDRepository, character, chave
@return object, instancia da classe
/*/
method new(pcChaveIDRepository as character) class TCOFromtoStorageRepository
	::cChaveIDRepository := pcChaveIDRepository
	_Super:New("NNR", ::getFields())
return self

/*/{Protheus.doc} TCOFromtoStorageRepository::getFields
Retorna os campos do repositorio
@type method
@version 12
@author lindembergson.pacheco
@since 24/04/2026
@return array, {{campoJson, campoProtheus, tipoCampo, lShowField}, ...}
/*/
method getFields() as array class TCOFromtoStorageRepository
	local aFields as array

	aFields := {;
		{'filial'  		, 'NNR_FILIAL', 'C', .T.},;
		{'codigo'  		, 'NNR_CODIGO', 'C', .T.},;
		{'descricao'    , 'NNR_DESCRI', 'C', .T.},;
		{'bloqueado'	, 'NNR_MSBLQL', 'C', .T.}}
return aFields


/*/{Protheus.doc} findStorage
Busca registros de De-Para para Armazem
@type method
@version 12
@author lindembergson.pacheco
@since 24/04/2026
@param cCodigoFeature, character, Código da feature
@param jFilial , character, Filial
/*/
method findStorage(cCodigoFeature as character, jFilial as character) as array class TCOFromtoStorageRepository

	local cQuery                as character
	local cAlias                as character
	local aResult               as array
	Local cInternalID           as character
	Local cExternalId           as character
	Local oTCOFromtoService     as object
	Local oRepository           as object
	Local oClass                as object
	Local oJson                 := JsonObject():New()
	Local oItem                 := JsonObject():New()

	cQuery := "SELECT "
	cQuery += "    NNR.NNR_FILIAL, "
	cQuery += "    NNR.NNR_CODIGO, "
	cQuery += "    NNR.NNR_DESCRI, "
	cQuery += "    NNR.NNR_MSBLQL "
	cQuery += "FROM " + RetSQLName("NNR") + " NNR "
	cQuery += "WHERE NNR.D_E_L_E_T_ = ' ' "
	cQuery += "AND  NNR.NNR_MSBLQL <> '1' "
	IF !Empty(jFilial)
		cQuery += " AND   NNR.NNR_FILIAL LIKE '"+jFilial+"%' "
	ENDIF
	cQuery += "ORDER BY NNR.NNR_FILIAL, NNR_CODIGO"

	cQuery := ChangeQuery(cQuery)
	cAlias := MPSysOpenQuery(cQuery)

	aResult := {}
	oTCOFromtoService   := TCOFromtoService():new()
	oRepository         := TCORepository():New()
	oClass              := oRepository:getFeatureClassById(AllTrim(cCodigoFeature))
	cCodProduto         := oClass:getIdentificaoIntegracao()

	if valType(oClass) != "U" .and. !empty(cCodProduto)

		While (cAlias)->(!EOF())

			cInternalID := ""
			cExternalId := ""

			cInternalID := oTCOFromtoService:formatInternalIdLocalDeEstoque((cAlias)->NNR_CODIGO)
			cExternalId := oTCOFromtoService:getExternalID(cCodProduto, "NNR", "NNR_CODIGO", cInternalID)

			IF !Empty(cExternalId)
				oItem 				:= JsonObject():New()
				oItem['filial'] 	:= AllTrim((cAlias)->NNR_FILIAL)
				oItem['codigo'] 	:= AllTrim((cAlias)->NNR_CODIGO)
				oItem['descricao']	:= AllTrim((cAlias)->NNR_DESCRI)
				oItem['bloqueado'] 	:= AllTrim((cAlias)->NNR_MSBLQL)
				oItem['valexterno'] := AllTrim(cExternalId)
				aadd(aResult,oItem)
			ENDIF

			(cAlias)->(DbSkip())

		End

		(cAlias)->(DbCloseArea())

	endif

	oJson['items'] := aResult

	Self:setSuccess(oJson)

	FwFreeObj(oTCOFromtoService)
    FwFreeObj(oRepository)

return nil
