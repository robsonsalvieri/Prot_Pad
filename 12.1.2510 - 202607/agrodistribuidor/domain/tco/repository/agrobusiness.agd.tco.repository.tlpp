/*/{Protheus.doc} isSIGAAGDactive
Retorna se o modulo sigaagd está ativo
@type method
@version 12
@author jc.maldonado
@since 23/09/2025
@return logical, .T. ativo, .F. inativo
/*/
method isSIGAAGDactive() as logical class TCORepository 
return SUPERGETMV("MV_SIGAAGD", .f., .f.) .and. POSICIONE("NE1",1,XFILIAL("NE1")+"TCO","NE1_STATUS") == "2" //Finalizado

/*/{Protheus.doc} getConfigPercentage
Retorna a porcentagem de features configuradas
@type method
@version 12
@author jc.maldonado
@since 23/09/2025
@return numeric, Porcentagem configurada
/*/
method getConfigPercentage() as double class TCORepository 
	local cSQL            as character
    local cAlias          as character
    local aBindParams     as array
    local nPercent        as double
    local nActiveFeatures as numeric

    aBindParams := {}
	cSQL := "SELECT COUNT(NE1_CODIGO) AS TOTAL"
	cSQL += " FROM " + retSqlName("NE1")
	cSQL += " WHERE NE1_FILIAL = ? " ; aAdd(aBindParams, FWxFilial("NE1"))
	cSQL += " AND NE1_ATIVO = ?"     ; aAdd(aBindParams, '1') //'1'=ativo
	cSQL += " AND NE1_STATUS = ?"    ; aAdd(aBindParams, '2') //'2'=finalizado
	cSQL += " AND D_E_L_E_T_ != '*'"
	cSQL := changeQuery(cSQL)
    
	cAlias := GetNextAlias()
	dbUseArea(.T., "TOPCONN", TcGenQry2(,, cSQL, aBindParams), cAlias, .F., .T.)
	nConfiguredFeatures := (cAlias)->TOTAL
    (cAlias)->(DBcloseArea())

    nActiveFeatures := ::getTotalActiveFeatures()

    nPercent := Round((nConfiguredFeatures / nActiveFeatures) * 100, 2)
return nPercent

/*/{Protheus.doc} getTotalActiveFeatures
Retorna o total de features ativas
@type method
@version 12
@author jc.maldonado
@since 23/09/2025
@return numeric, Total features ativas
/*/
method getTotalActiveFeatures() as integer class TCORepository 
	local cSQL        as character
	local aBindParams as array
	local cAlias      as character
	local nTotal      as integer

	aBindParams := {}

	cSQL := "SELECT COUNT(NE1_CODIGO) AS TOTAL"
	cSQL += " FROM " + retSqlName("NE1")
	cSQL += " WHERE NE1_FILIAL = ? " ; aAdd(aBindParams, FWxFilial("NE1"))
	cSQL += " AND NE1_ATIVO = ? "    ; aAdd(aBindParams, '1') //'1'=ativo
	cSQL += " AND D_E_L_E_T_ != '*'"
	cSQL := changeQuery(cSQL)

	cAlias := GetNextAlias()
	dbUseArea(.T., "TOPCONN", TcGenQry2(,, cSQL, aBindParams), cAlias, .F., .T.)

	nTotal := (cAlias)->TOTAL

	(cAlias)->(DBcloseArea())
return nTotal

/*/{Protheus.doc} getTotalRegistrations
Retorna o total de registros cadastrados para o alias informado
@type method
@version 12
@author jc.maldonado
@since 23/09/2025
@param cAliasTab, character, alias da tabela
@return numeric, Total registros cadastrados
/*/
method getTotalRegistrations(cAliasTab as character) as integer Class TCORepository 
	local cSQL      as character
	local cNewAlias as character
	local nTotal    as integer

	default cAliasTab := ""

	if !empty(cAliasTab) .And. FWAliasInDic(cAliasTab)
		cSQL := "SELECT COUNT(*) AS TOTAL"
		cSQL += " FROM " + retSqlName(cAliasTab)
		cSQL += " WHERE D_E_L_E_T_ != '*'"
		cSQL := changeQuery(cSQL)

		cNewAlias := GetNextAlias()
		dbUseArea(.T., "TOPCONN", TcGenQry2(,, cSQL, {}), cNewAlias, .F., .T.)

		nTotal := (cNewAlias)->TOTAL

		(cNewAlias)->(DBcloseArea())
	endif
return nTotal

/*/{Protheus.doc} findActiveFeatures
Retorna a lista de Features ativas na tabela NE1
@type method
@version 12
@author scheronlini
@since 08/10/2025
@return array, Lista de códigos de features ativas
/*/
method findActiveFeatures() class TCORepository
	Local aRet    := {}
	Local cSQL    := ""
	Local aParams := {}
	Local cAlias  := GetNextAlias()

	cSQL := "SELECT NE1_CODIGO, NE1_FILIAL FROM " + RetSqlName("NE1")
	cSQL += " WHERE NE1_ATIVO = ? " ; AAdd(aParams, "1")
	cSQL += " AND D_E_L_E_T_ = ' '"
	cSQL := ChangeQuery(cSQL)

	dbUseArea(.T., "TOPCONN", TcGenQry2(,,cSQL,aParams), cAlias, .F., .T.)
	dbSelectArea(cAlias)
	dbGoTop()

	While !(cAlias)->(EoF())
		AAdd(aRet, {AllTrim((cAlias)->NE1_CODIGO), (cAlias)->NE1_FILIAL})
		(cAlias)->(DbSkip())
	EndDo

	(cAlias)->(DbCloseArea())

Return aRet

/*/{Protheus.doc} getFeatureStatus
Retorna o status atual de uma feature específica
@type method
@version 12
@author scheronlini
@since 08/10/2025
@param cCodigo, character, código da feature
@return character, status atual da feature
/*/
method getFeatureStatus(cCodigo) class TCORepository
	Local cSQL    := ""
	Local aParams := {}
	Local cAlias  := GetNextAlias()
	Local cStatus := ""

	cSQL := "SELECT NE1_STATUS FROM " + RetSqlName("NE1") + " WHERE NE1_FILIAL = ? " ; AAdd(aParams, FWxFilial("NE1"))
	cSQL += " AND NE1_CODIGO = ? "    ; AAdd(aParams, cCodigo)
	cSQL += " AND D_E_L_E_T_ != '*'"
	cSQL := ChangeQuery(cSQL)

	dbUseArea(.T., "TOPCONN", TcGenQry2(,,cSQL,aParams), cAlias, .F., .T.)
	dbSelectArea(cAlias)
	dbGoTop()

	If !(cAlias)->(EoF())
		cStatus := AllTrim((cAlias)->NE1_STATUS)
	EndIf

	(cAlias)->(DbCloseArea())

Return cStatus


/*/{Protheus.doc} updateFeatureStatus
Atualiza o status e a data de finalização da Feature na NE1
@type method
@version 12
@author scheronlini
@since 08/10/2025
@param cCodigo, character, código da feature
@param cStatus, character, novo status (ex: '3')
@param dData, date, data de finalização
@return logical, .T. se atualizou, .F. caso contrário
/*/
method updateFeatureStatus(cCodigo , cStatus , dData, cHora ) class TCORepository
	Local lOk := .F.

	dbSelectArea("NE1")
	If dbSeek(xFilial("NE1") + cCodigo)
		RecLock("NE1", .F.)
		NE1->NE1_STATUS := cStatus
		If !Empty(dData)
			NE1->NE1_DTFINA := dData
		EndIf
			If !Empty(cHora)
			NE1->NE1_HRFINA := cHora
		EndIf
		NE1->(MsUnLock())
		lOk := .T.
	EndIf

Return lOk

/*/{Protheus.doc} findFeaturesRotas
Retorna a rotas da features
@type method
@version 12
@author Gilson.Venturi
@since 15/10/2025
@return array, array das rotas
/*/
Method findFeaturesRotas(cCodFeature) Class TCORepository
	Local jValue           As Json
	Local oFeatureClass    As object
	Local cCodProduto      As character
	Local aRotasAdapter    As array
	Local nPos             as integer 

	oTCOrepository  := TCORepository():New()
	oFeatureClass   := oTCOrepository:getFeatureClassById(cCodFeature)
	cCodProduto     := oFeatureClass:getIdentificaoIntegracao()

	jValue := JsonObject():New()
	jValue["identificador"] := cCodFeature
	jValue["feature"] := cCodProduto
	jValue["source"] := oFeatureClass:getDescricao()
	jValue["url"] := ""
	jValue["featureDescription"] := ""
	jValue['tdn'] := oFeatureClass:getDocumentacaoTDN()

	aRotasAdapter := Self:getRotasAdapter(cCodProduto)
	jValue["items"] := aRotasAdapter

	nPos := AScan(aRotasAdapter, {|jItem| AllTrim(jItem["produto"]) == AllTrim(cCodProduto)})
	If nPos > 0
		jValue["url"] := aRotasAdapter[nPos]["url"]
		jValue["featureDescription"] := aRotasAdapter[nPos]["source"]
	EndIf

	FWFreeObj(oTCOrepository)
	FWFreeObj(oFeatureClass)


Return jValue

/*/{Protheus.doc} getRotasAdapter
Retorna as rotas de integração por prefixo do produto
@type method
@version 12
@author GitHub Copilot
@since 26/05/2026
@param cCodProduto, character, Expressão inicial do produto para busca
@return array, Lista de itens com produto, source e url
/*/
method getRotasAdapter(cCodProduto) as Array class TCORepository
	Local cQuery    as Character
	Local oStmt     as object
	Local cAliasXB9 as character
	Local aItens    as array
	Local jItem     as Json

	aItens := {}
	cAliasXB9 := GetNextAlias()
	
	cQuery := " SELECT XB9_PROD, XB9_SOURCE, XAI_URL"
	cQuery += "  FROM XB9"
	cQuery += " INNER JOIN XAI ON XAI_APPID = XB9_APPID"
	cQuery += "   AND XAI.D_E_L_E_T_ = ''"
	cQuery += " WHERE XB9.XB9_FILIAL = ?"
	cQuery += "   AND XB9.XB9_PROD   LIKE ?"
	cQuery += "   AND XB9.D_E_L_E_T_ = ''"
	cQuery := ChangeQuery(cQuery)
	
	/*Garante que existe a tabela*/
	Try
		// Prepara os parâmetros
		oStmt:= FWPreparedStatement():New()
		oStmt:SetQuery(cQuery)
		oStmt:SetString(1, xFilial("XB9"))
		oStmt:SetString(2, AllTrim(cCodProduto) + "%")
		cQuery := oStmt:GetFixQuery()
		FWFreeObj(oStmt)

		// Executa a query e percorre os resultados
		MPSysOpenQuery(cQuery, cAliasXB9)

		While !(cAliasXB9)->(EoF())
			jItem := JsonObject():New()
			jItem["produto"] := AllTrim((cAliasXB9)->XB9_PROD)
			jItem["source"]  := AllTrim((cAliasXB9)->XB9_SOURCE)
			jItem["url"]     := AllTrim((cAliasXB9)->XAI_URL)
			AAdd(aItens, jItem)

			(cAliasXB9)->(DbSkip())
		EndDo

		(cAliasXB9)->(DbCloseArea())

	Catch oError
		Self:setError(oError:Description, 401)
	EndTry

return aItens

/*/{Protheus.doc} findFeaturesAdapter
Retorna os adapters da features
@type method
@version 12
@author Gilson.Venturi
@since 15/10/2025
@param cCodFeature, character, codigo da feature
@return variant, nil
/*/
Method findFeaturesAdapter(cCodFeature) class TCORepository
	local oTCOrepository as object
	local oFeatureClass  as object
	local jResponse	     as json
	local aCadastros     as array
	local aItems         as array
	local nX             as integer

	oTCOrepository := TCORepository():New()
	oFeatureClass  := oTCOrepository:getFeatureClassById(cCodFeature)

	if oFeatureClass == nil
		Self:setError(STR0009, 404) //"Feature não encontrada"	
		return nil
	endif	

	aCadastros     := oFeatureClass:getAdapter()
	aItems := {}
	for nX := 1 to Len(aCadastros)
		aAdapter := FwAdapterInfo(aCadastros[nX]['rotina'], aCadastros[nX]['mensagem'])
		
		aadd(aItems, JsonObject():New())
		aItems[nX]['rotina']    := aCadastros[nX]['rotina']
		aItems[nX]['mensagem']  := aCadastros[nX]['mensagem']
		aItems[nX]['version']   := aCadastros[nX]['versao']
		aItems[nX]['rotas']     := Self:getRotaAdapter(aCadastros[nX]['rotina'], aCadastros[nX]['mensagem'])
		aItems[nX]['condicao']  := aCadastros[nX]['condicao']
		aItems[nX]['detalhe']   := ""

		aRotaAdapter := Self:hasRotaAdapter(aItems[nX]['rotas'], oFeatureClass:getIdentificaoIntegracao(), aCadastros[nX]['rota'], aCadastros[nX]['condicao'])	
		aItems[nX]['detalheRota']  := aRotaAdapter
		
		//valida adapter
		if empty(aAdapter) 
			aItems[nX]['detalhe']  := STR0001 //Adapter não está cadastrado
		elseif aAdapter[3] != .t. 
			aItems[nX]['detalhe']  := STR0002 //Não está configurado para envio ou recebimento
		else
			if !aRotaAdapter[1]
				if aRotaAdapter[3] //codição nao presente
					aItems[nX]['detalhe']   := STR0010 + "("+ aCadastros[nX]['condicao'] + ")."
				elseif aRotaAdapter[2]  //sender nao configurado para envio
					aItems[nX]['detalhe']   := STR0011 //A rota não está configurada para enviar dados
				else //aItems[nX]['detalhe']  não presente
					aItems[nX]['detalhe']   := STR0012 //A rota do adapter não está configurada.
				endif	
			endif			
		Endif		

		aItems[nX]['status']    := iif(empty(aItems[nX]['detalhe']), STR0003, STR0004)
		aItems[nX]['valido']    := iif(empty(aItems[nX]['detalhe']), "1", "0")
		
	next nX

	jResponse  := JsonObject():New()
	jResponse['items']   := aItems
	jResponse['hasNext'] := .F.

	Self:setSuccess(jResponse) 

	FWFreeArray(aCadastros)
	FWFreeObj(oTCOrepository)
return nil

/*/{Protheus.doc} hasRotaAdapter
Retorna dados da configuração de rota do adapter
@type method
@version 12
@author jean.schulze
@since 5/26/2026
@param cRotina, character, param_description
@param cMensagem, character, param_description
@param cProduto, character, param_description
@param cRota, character, param_description
@param cCondition, character, param_description
@return array, situacao da rota do adapter
/*/
method getRotaAdapter(cRotina, cMensagem) as array  class TCORepository
	local cSQL      as character
	local cAliasXB0 as character
	local nX		as integer
	local aListaRotas as array

	default cRotina    := ""
	default cMensagem  := ""


	cAliasXB0 = GetNextAlias()
	aListaRotas := {}

	cSQL := "SELECT XB0_PROD, XB0_SENDER, XB0_COND, XB0_SOURCE"
	cSQL += " FROM " + RetSqlName("XB0")
	cSQL += " WHERE XB0_FILIAL = ? "
	cSQL += " AND XB0_ROTINA = ? "   
	cSQL += " AND XB0_MODEL  = ? "   
	cSQL += " AND D_E_L_E_T_ != '*'"

	oStmt:= FWPreparedStatement():New()
	oStmt:SetQuery(cSQL)
	oStmt:SetString(1, xFilial("XB0"))
	oStmt:SetString(2, AllTrim(cRotina) )
	oStmt:SetString(3, AllTrim(cMensagem) )
	cQuery := oStmt:GetFixQuery()
	FWFreeObj(oStmt)

	// Executa a query e percorre os resultados
	MPSysOpenQuery(cQuery, cAliasXB0)

	While !(cAliasXB0)->(EoF()) 
		nX++
		aadd(aListaRotas, JsonObject():New())
		aListaRotas[nX]["produto"]   := AllTrim((cAliasXB0)->XB0_PROD)
		aListaRotas[nX]["source"]    := AllTrim((cAliasXB0)->XB0_SOURCE)
		aListaRotas[nX]["sender"]    := AllTrim((cAliasXB0)->XB0_SENDER)
		aListaRotas[nX]["condicao"]  := AllTrim((cAliasXB0)->XB0_COND)
		(cAliasXB0)->(DbSkip())
	EndDo

	(cAliasXB0)->(DbCloseArea())
return aListaRotas

/*/{Protheus.doc} hasRotaAdapter
description
@type method
@version 12
@author jean.schulze
@since 5/27/2026
@param aRotas, array, param_description
@return array, return_description
/*/
method hasRotaAdapter(aRotas, cProduto, cRota, cCondition) as array  class TCORepository
	local nX as integer

	default aRotas     := {}
	default cProduto   := ""
	default cRota      := ""
	default cCondition := ""

	lHasRota      := .F.
	lHasProd      := .F.
	lHasProdEnvia := .F.
	cProdutoRota  := ""

	for nX := 1 to Len(aRotas)
		if  !lHasRota .and. ((AllTrim(aRotas[nX]["produto"]) == AllTrim(cProduto) .or. AllTrim(aRotas[nX]["produto"]) == AllTrim(cProduto+"-"+cRota)))

			lHasProd      := .T.
			cProdutoRota  := aRotas[nX]["produto"]

			If AllTrim(aRotas[nX]["sender"]) == "1"
				lHasProdEnvia := .T.

				If Empty(cCondition) .Or. (AllTrim(cCondition) ) $ (AllTrim(aRotas[nX]["condicao"]))
					lHasRota := .T.
				EndIf
			EndIf
		endif
	next 
return {lHasRota, lHasProd, lHasProdEnvia, cProdutoRota} 	

/*/{Protheus.doc} getAllClassFeaturesAtivas
Retorna as features ativas instanciando os respectivos DTOs.
@type method
@version 12
@author jean.schulze
@since 30/10/2025
@return array, lista de DTOs das features
/*/
method getAllClassFeaturesAtivas() as array class TCORepository
	Local aFeatures := {}
	Local aCodigos  := Self:findActiveFeatures()
	Local nI

	// Percorre as features ativas na NE1
	For nI := 1 To Len(aCodigos)
		cCodigo := FeatureTCOEnum():getById(aCodigos[nI][1])
		if !empty(cCodigo)
			AAdd(aFeatures, { &(cCodigo + ":new()") , aCodigos[nI][2] })
		endif
	Next nI

Return aFeatures

/*/{Protheus.doc} isFeatureActive
description
@type method
@version 12
@author jean.schulze
@since 12/22/2025
@param cFeature, character, param_description
@return logical, return_description
/*/
method isFeatureActive(cFeature as character) as logical class TCORepository
	Local lAtivo := .F.

	dbSelectArea("NE1")
	If dbSeek(xFilial("NE1") + cFeature)
		If NE1->NE1_ATIVO == '1'
			lAtivo := .T.
		EndIf
	EndIf

Return lAtivo
