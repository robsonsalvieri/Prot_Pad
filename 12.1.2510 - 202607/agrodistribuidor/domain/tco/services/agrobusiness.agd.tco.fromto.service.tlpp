#include "totvs.ch"
#include 'tlpp-core.th'

namespace totvs.protheus.agrobusiness.agd

/*/{Protheus.doc} TCOFromtoService
Classe de serviços do TCO de-para
@type class
@version 12
@author Gilson.Venturi
@since 15/10/2025
/*/
class TCOFromtoService FROM UtilsService
	public method new()
	public method findByFeature()
	public method formatInternalIDcliente()         as character
	public method formatInternalIDfornecedor()      as character
	public method formatInternalIDdocEntradaItem()  as character
	public method formatInternalIDdocSaidaItem()    as character
	public method formatInternalIdProduto()         as character
	public method formatInternalIdSolReceita()	    as character
	public method formatInternalIdPropriedade()	    as character
	public method formatInternalIdCultura()		    as character
	public method formatInternalIdRespTecnico()	    as character
	public method formatInternalIdDescarte()	    as character
	public method formatInternalIdTabelaPreco()	    as character
	public method formatInternalIdItemTabelaPreco()	as character
	public method formatInternalIdTES()             as character
	public method formatInternalIdLocalDeEstoque()	as character
	public method formatInternalIdSafra()	        as character

	public method getExternalID()				    as character
	public method getInternalID()				    as character
	private method setInternalID()				    as character
endClass

/*/{Protheus.doc} new
Construtor
@type method
@version 12
@author Gilson.Venturi
@since 15/10/2025
@return object, Instancia da classe
/*/
method new() class TCOFromtoService
	_Super:New()
return Self


/*/{Protheus.doc} findByFeature
Buscar Por Id Unico
@type method
@version 12
@author Gilson.Venturi
@since 15/10/2025
@param cCodigo, character, id unico
@return variant, nil
/*/
method findByFeature(cCodigo, jQueryParam, nPage, nPageSize) class TCOFromtoService
	Local oRepository		As object
	Local oResponseMerge	As object
	Default nPage     := 1
	Default nPageSize := 10

	oRepository := TCOFromtoRepository():New()
	oRepository:findByFeature(cCodigo, jQueryParam, nPage, nPageSize)

	oResponseMerge := oRepository:getResponse()

	Self:setFullResponse(oRepository)

	oRepository:DeActivate()
	FreeObj(oRepository)
return nil

/*/{Protheus.doc} TCOFromtoService::formatInternalIDcliente
Formata o codigo do cliente no padrao utilizado pelo EAI
@type method
@version 12
@author jc.maldonado
@since 17/11/2025
@param cEmpresa, character, empresa
@param cFil, character, filial
@param cCliente, character, cliente
@param cLoja, character, loja
@return character, valor formatado
/*/
method formatInternalIDcliente(cEmpresa as character, cFil as character, cCliente as character, cLoja as character) as character class TCOFromtoService
return IntCliExt(cEmpresa, cFil, cCliente, cLoja)[2]

/*/{Protheus.doc} TCOFromtoService::formatInternalIDfornecedor
Formata o codigo do fornecedor no padrao utilizado pelo EAI
@type method
@version 12
@author jc.maldonado
@since 17/11/2025
@param cEmpresa, character, empresa
@param cFil, character, filial
@param cFornecedor, character, fornecedor
@param cLoja, character, loja
@return character, valor formatado
/*/
method formatInternalIDfornecedor(cEmpresa as character, cFil as character, cFornecedor as character, cLoja as character) as character class TCOFromtoService
return IntForExt(cEmpresa, cFil, cFornecedor, cLoja)[2]

/*/{Protheus.doc} TCOFromtoService::formatInternalIdProduto
Formata o codigo do produto no padrao utilizado pelo EAI
@type method
@version 12
@author jc.maldonado
@since 17/11/2025
@param cEmpresa, character, empresa
@param cFilialSB1, character, filial
@param cCodigoProduto, character, produto
@return character, valor formatado
/*/
method formatInternalIdProduto(cEmpresa as character, cFilialSB1 as character, cCodigoProduto as character) as character class TCOFromtoService
