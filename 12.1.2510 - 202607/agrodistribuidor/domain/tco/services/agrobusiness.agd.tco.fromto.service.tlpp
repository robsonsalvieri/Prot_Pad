/*/{Protheus.doc} TCOFromtoService::setInternalID
Formata a chave para gravacao de internalId pelo EAI
@type method
@version 12
@author lindembergson.pacheco
@since 19/11/2025
@param aDados, Array, dados para geracao de chave EAI
//dados obrigatorios para geracao de chave 
	cEmpAnt
	cFilAnt
	demais campos
@return character, valor formatado
/*/
method setInternalID(aDados as Array) as character class TCOFromtoService
	Local cId	:= ""
	AEval( aDados, { |x| cId += x + "|" } )
	cId := SubStr(cId,1, LEN(cId) -1)
return cId

/*/{Protheus.doc} TCOFromtoService::getExternalID
Recupera External ID pelo EAI
@type method
@version 12
@author lindembergson.pacheco
@since 24/11/2025
@param cCodeInteg, Character, Codigo da Integracao EAI
@param cAlias, Character, Alias da Tabela
@param cField, Character, Campo da Tabela
@param cIdInter, Character, internalId do registro
@return character, valor formatado
/*/
method getExternalID(cCodeInteg, cAlias, cField, cIdInter) as character class TCOFromtoService
	Local cExternalId := CFGA070Ext(cCodeInteg, cAlias, cField, cIdInter)
return AllTrim(cExternalId)


/*/{Protheus.doc} TCOFromtoService::getInternalID
Recupera Internal ID pelo EAI
@type method
@version 12
@author carlos.augusto
@since 11/05/2026
@param cCodeInteg, Character, Codigo da Integracao EAI
@param cAlias, Character, Alias da Tabela
@param cField, Character, Campo da Tabela
@param cIdInter, Character, internalId do registro
@return character, valor formatado
/*/
method getInternalID(cCodeInteg, cAlias, cField, cIdExter) as character class TCOFromtoService
	Local cInternalId := CFGA070Int(cCodeInteg, cAlias, cField, cIdExter)
return AllTrim(cInternalId)
